{
  "name": "grace17",
  "version": "1.0.0",
  "description": "A proof assistant for mathematics based on set theory.",
  "license": "Apache-2.0",
  "homepage": "https://grace17.org",
  "repository": {
    "type": "git",
    "url": "https://github.com/grace17-prover/grace17.git"
  },
  "private": true,
  "type": "module",
  "bin": {
    "g17": "bin/g17.ts"
  },
  "scripts": {
    "test": "npm run check:headers && npm run build:browser && node --disable-warning=ExperimentalWarning scripts/run-tests.ts",
    "test:parallel": "npm run check:headers && npm run build:browser && node --disable-warning=ExperimentalWarning --test tests/*.test.ts",
    "demo": "node --disable-warning=ExperimentalWarning examples/demo.ts",
    "proofs": "node --disable-warning=ExperimentalWarning examples/proofs.ts",
    "machine": "node --disable-warning=ExperimentalWarning examples/machine-smoke.ts",
    "check:python": "python3 checkers/python/g17check.py examples/Grace.Core.g17m --environment examples/Grace.Core.g17env",
    "conformance:generate": "node --disable-warning=ExperimentalWarning scripts/generate-conformance.ts",
    "conformance": "node --disable-warning=ExperimentalWarning scripts/check-conformance.ts",
    "conformance:python": "python3 checkers/python/check_conformance.py",
    "compile:cumulus": "node --disable-warning=ExperimentalWarning scripts/export-cumulus-g17c.ts",
    "check:g17c:python": "python3 checkers/python/g17c_check.py build/compiled/Cumulus.g17c --foundation ZFG --dependency build/compiled/Bootstrap.g17c",
    "compute": "node --disable-warning=ExperimentalWarning examples/computation.ts",
    "bench:machine": "node --disable-warning=ExperimentalWarning examples/machine.ts",
    "bench:cumulus": "node --disable-warning=ExperimentalWarning scripts/benchmark-cumulus.ts",
    "bench:workbench": "node --disable-warning=ExperimentalWarning scripts/benchmark-workbench.ts",
    "bench:files": "node --disable-warning=ExperimentalWarning scripts/audit-file-performance.ts",
    "bench:elimination": "node --disable-warning=ExperimentalWarning scripts/benchmark-elimination.ts && node --disable-warning=ExperimentalWarning scripts/benchmark-exact-rational.ts",
    "arithmetic": "node --disable-warning=ExperimentalWarning examples/arithmetic.ts",
    "scaling": "node --disable-warning=ExperimentalWarning examples/scaling.ts",
    "surface": "node --disable-warning=ExperimentalWarning examples/surface.ts",
    "build:browser": "node --disable-warning=ExperimentalWarning scripts/build-browser.ts",
    "workbench": "npm run build:browser && node --disable-warning=ExperimentalWarning bin/workbench.ts",
    "check:g17": "node --disable-warning=ExperimentalWarning bin/g17.ts check --module-root lib examples/Arithmetic.g17 examples/Sets.g17 examples/Unicode.g17 examples/Hierarchy.g17 lib/Grace/Core.g17 examples/Compute.g17",
    "check:cumulus": "node --disable-warning=ExperimentalWarning bin/g17.ts check --module-root lib lib/Grace/Cumulus.g17",
    "build:modules": "node --disable-warning=ExperimentalWarning bin/g17.ts build --module-root lib --artifacts build/modules lib/Grace/Cumulus.g17",
    "proof:view": "node --disable-warning=ExperimentalWarning bin/g17.ts view examples/Sets.g17 --theorem pair.left --out examples/pair-left-judgments.html",
    "bench:proof-execution": "node --disable-warning=ExperimentalWarning scripts/profile-proof-execution.ts build/proof-execution --no-profile --suite",
    "build:ocaml": "bash checkers/ocaml/build.sh",
    "conformance:ocaml": "python3 checkers/ocaml/check_conformance.py",
    "test:ocaml": "npm run build:ocaml && node --disable-warning=ExperimentalWarning scripts/generate-ocaml-fixtures.ts && npm run conformance:ocaml && python3 checkers/ocaml/check_complete.py",
    "test:ocaml:cumulus": "npm run test:ocaml && node --disable-warning=ExperimentalWarning bin/g17.ts compile --module-root lib lib/Grace/Cumulus.g17 --out build/Cumulus.g17m --environment build/Cumulus.g17env && npm run compile:cumulus && python3 checkers/ocaml/check_complete.py --cumulus",
    "check:g17c:ocaml": "build/ocaml/g17c_check build/compiled/Cumulus.g17c --foundation ZFG --dependency build/compiled/Bootstrap.g17c --json",
    "format:ocaml": "bash checkers/ocaml/format.sh",
    "format:ocaml:check": "bash checkers/ocaml/format.sh check",
    "build:rust": "bash checkers/rust/build.sh",
    "conformance:rust": "python3 checkers/rust/check_conformance.py",
    "check:rust": "build/rust/g17check examples/Grace.Core.g17m --environment examples/Grace.Core.g17env",
    "check:g17c:rust": "build/rust/g17c_check build/compiled/Cumulus.g17c --foundation ZFG --dependency build/compiled/Bootstrap.g17c",
    "test:rust": "npm run build:rust && npm run conformance:rust && npm run check:rust",
    "docs:top100": "node --disable-warning=ExperimentalWarning scripts/update-top-100.ts",
    "readme:code": "node --disable-warning=ExperimentalWarning scripts/render-readme-code.ts",
    "docs:top100:check": "node --disable-warning=ExperimentalWarning scripts/update-top-100.ts --check",
    "docs:tactics": "node --disable-warning=ExperimentalWarning scripts/update-tactics-doc.ts",
    "docs:tactics:check": "node --disable-warning=ExperimentalWarning scripts/update-tactics-doc.ts --check",
    "compile:integers:zf": "node --disable-warning=ExperimentalWarning scripts/export-integers-zf.ts",
    "compile:zf-library": "node --disable-warning=ExperimentalWarning scripts/export-zf-library.ts",
    "check:headers": "node --disable-warning=ExperimentalWarning scripts/check-library-headers.ts",
    "check:external-projects": "node --disable-warning=ExperimentalWarning scripts/check-external-projects.ts",
    "docs:introduction:check": "python3 scripts/check-introduction-excerpts.py",
    "build:site": "npm run build:browser && node --disable-warning=ExperimentalWarning scripts/build-site.ts",
    "check:site": "node --disable-warning=ExperimentalWarning scripts/check-site.ts",
    "serve:site": "node --disable-warning=ExperimentalWarning scripts/serve-site.ts",
    "blueprint:status": "node --disable-warning=ExperimentalWarning scripts/blueprint-status.ts blueprints/CycleDoubleCover",
    "blueprint:check": "node --disable-warning=ExperimentalWarning bin/g17.ts check --continue --quiet --module-root blueprints --module-root lib blueprints/CycleDoubleCover/DoubleCover/Theorem.g17 blueprints/CycleDoubleCover/TreePacking/Corollaries.g17"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "monaco-editor": "0.56.0"
  },
  "devDependencies": {
    "marked": "14.0.0"
  }
}
