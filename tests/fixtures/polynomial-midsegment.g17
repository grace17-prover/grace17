module PolynomialRegression
namespace PolynomialRegression
import Grace.Cumulus.Geometry.Lines
theorem original_midsegment_length (a b c m n : Euclidean.Point)
  requires first : Euclidean.Midpoint(m, c, a)
  requires second : Euclidean.Midpoint(n, c, b)
  shows Euclidean.distanceSquared(a, b) =
    Euclidean.distanceSquared(m, n) + Euclidean.distanceSquared(m, n) +
    Euclidean.distanceSquared(m, n) + Euclidean.distanceSquared(m, n)
proof
  have direction := Euclidean.midsegment.direction at a, b, c, m, n with
    assumption, assumption, assumption, assumption, assumption, first, second
  rcases direction with ⟨horizontal, vertical⟩
  have ax := Euclidean.x.real at a with assumption
  have ay := Euclidean.y.real at a with assumption
  have bx := Euclidean.x.real at b with assumption
  have byReal := Euclidean.y.real at b with assumption
  have mx := Euclidean.x.real at m with assumption
  have my := Euclidean.y.real at m with assumption
  have nx := Euclidean.x.real at n with assumption
  have ny := Euclidean.y.real at n with assumption
  have base := Euclidean.distanceSquared.coordinates at a, b with assumption, assumption
  have segment := Euclidean.distanceSquared.coordinates at m, n with assumption, assumption
  rw base
  rw segment
  linear_combination -(Euclidean.x(b) - Euclidean.x(a) + (Euclidean.x(n) - Euclidean.x(m)) + (Euclidean.x(n) - Euclidean.x(m))) * horizontal - (Euclidean.y(b) - Euclidean.y(a) + (Euclidean.y(n) - Euclidean.y(m)) + (Euclidean.y(n) - Euclidean.y(m))) * vertical

end PolynomialRegression
