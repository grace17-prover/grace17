module Grace.Core.Syntax
namespace Grace.Core.Syntax
import Grace.Core.Nat
open Grace.Core.Nat.Rec

-- Kernel-facing syntax is set-theoretic data.  Names are Sets;
-- recursive syntax positions are checked by the generated inductive class.
datatype TermSyntax
  | variable(name : Set)
  | application(function : Set, argument : self)

datatype FormulaSyntax
  | atom(relation left right : Set)
  | implication(left right : self)
  | universal(variable : Set, body : self)

datatype GoalSyntax
  | goal(context target : Set)

-- This is a small executable language for compiled tactic plans.  An
-- interpreter can later map these constructors to checked proof-producing
-- primitives; the datatype itself never extends the trusted kernel.
datatype TacticSyntax
  | exactStep(theoremName : Set)
  | introStep(name : Set, continuation : self)
  | sequence(first second : self)
  | choice(first second : self)
  | repeatStep(body : self)

namespace Formula

def size (formula : FormulaSyntax) -> Nat
  | FormulaSyntax.atom(relation, left, right) => 1
  | FormulaSyntax.implication(left, right) => succ(add(size(left), size(right)))
  | FormulaSyntax.universal(variable, body) => succ(size(body))

theorem size.atom
  shows size(FormulaSyntax.atom(1, 2, 3)) = 1
proof
  compute

end Formula

namespace Tactic

def cost (tactic : TacticSyntax) -> Nat
  | TacticSyntax.exactStep(theoremName) => 1
  | TacticSyntax.introStep(name, continuation) => succ(cost(continuation))
  | TacticSyntax.sequence(first, second) => add(cost(first), cost(second))
  | TacticSyntax.choice(first, second) => add(cost(first), cost(second))
  | TacticSyntax.repeatStep(body) => succ(cost(body))

theorem cost.example
  shows cost(TacticSyntax.sequence(TacticSyntax.exactStep(1), TacticSyntax.introStep(2, TacticSyntax.exactStep(3)))) = 3
proof
  compute

end Tactic

eval Formula.size(FormulaSyntax.implication(FormulaSyntax.atom(1, 2, 3), FormulaSyntax.universal(4, FormulaSyntax.atom(5, 6, 7))))
eval Tactic.cost(TacticSyntax.sequence(TacticSyntax.exactStep(1), TacticSyntax.introStep(2, TacticSyntax.exactStep(3))))

end Grace.Core.Syntax
