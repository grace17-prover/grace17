-- Authors: Grant Passmore

theorem nat.zero
  shows zero = ∅
proof
  settle with zero

theorem nat.succ (n : Set)
  requires hn : Nat(n)
  shows succ(n) = ⋃({n, {n, n}})
proof
  settle with succ

theorem nat.omega (n : Set)
  shows Nat(n) ↔ n ∈ ℕ
proof
  settle with Nat

theorem Naturals.constructor.zero
  shows Nat(zero)
proof
  have infinity := set.infinity
  unfold Nat
  rw nat.zero
  exact infinity.left

theorem Naturals.constructor.succ (n : Set)
  requires hn : Nat(n)
  shows Nat(succ(n))
proof
  have infinity := set.infinity
  unfold Nat at hn
  unfold Nat
  rw nat.succ
  exact infinity.right with n, hn

theorem bootstrap.singleton.membership (x a : Set)
  shows x ∈ {a} ↔ x = a
proof
  settle with singleton, pair.membership

theorem bootstrap.union2.membership (x A B : Set)
  shows x ∈ A ∪ B ↔ (x ∈ A ∨ x ∈ B)
proof
  settle with union2, set.union, pair.membership

theorem bootstrap.succ.membership (x n : Set)
  shows x ∈ succ(n) ↔ (x ∈ n ∨ x = n)
proof
  constructor
  . intro h
    simp [succ, set.union, pair.membership] at h
    obtain ⟨y, hyPair, hxy⟩ := h
    simp [pair.membership] at hyPair
    cases hyPair with hyn | hynPair
    . left
      rw hyn at hxy
      exact hxy
    . right
      rw hynPair at hxy
      simp [pair.membership] at hxy
      cases hxy with hxn | hxn
      . exact hxn
      . exact hxn
  . intro h
    unfold succ
    apply set.union.backward at {n, {n, n}}, x
    cases h with hMember | hEqual
    . witness n
      constructor
      . settle with pair.membership
      . exact hMember
    . witness {n, n}
      constructor
      . settle with pair.membership
      . rw hEqual
        settle with pair.membership

theorem bootstrap.succ.self (n : Set)
  shows n ∈ succ(n)
proof
  settle with bootstrap.succ.membership

theorem Naturals.disjoint.zero.succ (n : Set)
  shows zero ≠ succ(n)
proof
  intro h
  have self := bootstrap.succ.self at n
  rw ← h at self
  settle with zero, set.empty

theorem bootstrap.pair.left (x y : Set)
  shows x ∈ {x, y}
proof
  settle with pair.membership

theorem bootstrap.pair.right (x y : Set)
  shows y ∈ {x, y}
proof
  settle with pair.membership

theorem bootstrap.pair.nonempty (a b : Set)
  shows {a, b} ≠ ∅
proof
  intro h
  have member := bootstrap.pair.left at a, b
  rw h at member
  settle with set.empty

theorem bootstrap.membership.asymmetric (a b : Set)
  requires hab : a ∈ b
  shows b ∉ a
proof
  intro hba
  have nonempty := bootstrap.pair.nonempty at a, b
  obtain ⟨m, hmPair, minimal⟩ := foundation at {a, b} with nonempty
  simp [pair.membership] at hmPair
  cases hmPair with hma | hmb
  . rw ← hma at hba
    exact minimal with b, hba, (bootstrap.pair.right at a, b)
  . rw ← hmb at hab
    exact minimal with a, hab, (bootstrap.pair.left at a, b)

theorem Naturals.injective.succ (a b : Set)
  requires h : succ(a) = succ(b)
  shows a = b
proof
  have aSelf := bootstrap.succ.self at a
  rw h at aSelf
  have aCases := bootstrap.succ.membership.forward at a, b with aSelf
  cases aCases with hab | equal
  . have bSelf := bootstrap.succ.self at b
    rw ← h at bSelf
    have bCases := bootstrap.succ.membership.forward at b, a with bSelf
    cases bCases with hba | equalReverse
    . exfalso
      exact bootstrap.membership.asymmetric at a, b with hab, hba
    . rw equalReverse
      rfl
  . exact equal
