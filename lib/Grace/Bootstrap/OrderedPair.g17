-- Authors: Grant Passmore

theorem bootstrap.pair.cancel_left (a b c : Set)
  requires h : {a, b} = {a, c}
  shows b = c
proof
  have hb : b = a ∨ b = c by rw ← pair.membership; rw ← h; simp
  have hc : c = a ∨ c = b by rw ← pair.membership; rw h; simp
  rcases hb with hba | hbc
  . rcases hc with hca | hcb
    . cc
    . cc
  . exact hbc

theorem bootstrap.orderedPair.first (a b c d : Set)
  requires h : (a, b) = (c, d)
  shows a = c
proof
  simp [orderedPair] at h
  have hC : pair(c, c) ∈ {pair(a, a), {a, b}} by rw h; simp
  simp [pair.membership] at hC
  have ha : a ∈ pair(c, c)
    rcases hC with hC | hC
    . simp [hC]
    . simp [hC]
  simp [pair.membership] at ha
  tauto

theorem bootstrap.orderedPair.injective (a b c d : Set)
  requires h : (a, b) = (c, d)
  shows a = c ∧ b = d
proof
  have first := bootstrap.orderedPair.first at a, b, c, d with h
  rw first at h
  simp [orderedPair] at h
  have outer := bootstrap.pair.cancel_left at pair(c, c), {c, b}, {c, d} with h
  exact ⟨first, (bootstrap.pair.cancel_left at c, b, d with outer)⟩

theorem bootstrap.orderedPair.bounded (x y A B : Set)
  requires hx : x ∈ A
  requires hy : y ∈ B
  shows (x, y) ∈ 𝒫(𝒫(A ∪ B))
proof
  apply powerset.membership.backward at (x, y), 𝒫(A ∪ B)
  intros z hz
  simp [orderedPair, pair.membership] at hz
  rcases hz with hz | hz
  . simp [hz, powerset.membership, bootstrap.union2.membership]
  . simp [hz, powerset.membership, bootstrap.union2.membership]
