-- Authors: Grant Passmore

theorem bootstrap.pair.cancel_left (a b c : Set)
  requires h : {a, b} = {a, c}
  shows b = c
proof
  have hb := bootstrap.pair.right at a, b
  rw h at hb
  simp [pair.membership] at hb
  cases hb with hba | hbc
  . have hc := bootstrap.pair.right at a, c
    rw ← h at hc
    simp [pair.membership] at hc
    cases hc with hca | hcb
    . settle
    . settle
  . exact hbc

theorem bootstrap.orderedPair.first (a b c d : Set)
  requires h : (a, b) = (c, d)
  shows a = c
proof
  simp [orderedPair] at h
  have firstA := bootstrap.pair.left at {a, a}, {a, b}
  rw h at firstA
  simp [pair.membership] at firstA
  cases firstA with haa | hab
  . have cMember := bootstrap.pair.left at c, c
    rw ← haa at cMember
    simp [pair.membership] at cMember
    cases cMember with hca | hca
    . settle
    . settle
  . have cMember := bootstrap.pair.left at c, d
    rw ← hab at cMember
    simp [pair.membership] at cMember
    cases cMember with hca | hca
    . settle
    . settle

theorem bootstrap.orderedPair.injective (a b c d : Set)
  requires h : (a, b) = (c, d)
  shows a = c ∧ b = d
proof
  have first := bootstrap.orderedPair.first at a, b, c, d with h
  constructor
  . exact first
  . rw first at h
    simp [orderedPair] at h
    have outer := bootstrap.pair.cancel_left at {c, c}, {c, b}, {c, d} with h
    exact bootstrap.pair.cancel_left at c, b, d with outer

theorem bootstrap.orderedPair.bounded (x y A B : Set)
  requires hx : x ∈ A
  requires hy : y ∈ B
  shows (x, y) ∈ 𝒫(𝒫(A ∪ B))
proof
  apply powerset.membership.backward at (x, y), 𝒫(A ∪ B)
  intros z hz
  apply powerset.membership.backward at z, A ∪ B
  intros w hw
  simp [orderedPair, pair.membership] at hz
  cases hz with hsingle | hpair
  . rw hsingle at hw
    simp [pair.membership] at hw
    cases hw with hwx | hwx
    . rw hwx
      settle with union2, set.union, pair.membership
    . rw hwx
      settle with union2, set.union, pair.membership
  . rw hpair at hw
    simp [pair.membership] at hw
    cases hw with hwx | hwy
    . rw hwx
      settle with union2, set.union, pair.membership
    . rw hwy
      settle with union2, set.union, pair.membership
