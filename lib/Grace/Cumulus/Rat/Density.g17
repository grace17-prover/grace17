module Grace.Cumulus.Rat.Density
import Operations

-- Every rational has a strictly smaller rational.  On a displayed fraction
-- (a-b)/m, increasing the negative numerator by one gives (a-(b+1))/m.
theorem rationalLess.exists_below (q : Set)
  requires qRational : Rational(q)
  shows ∃ p ∈ ℚ, p < q
proof
  obtain ⟨a, aNat, b, bNat, m, mNat, mNonzero, qShape⟩ := Rational.coordinates with qRational
  have bSuccNat : Nat(succ(b)) by exact Naturals.constructor.succ at b with bNat
  have bLess : b < succ(b)
    apply Less.of_membership
    . exact membership.self_successor at b with bNat
  have scaled := Less.mul_left with mNonzero, bLess
  have maNat : Nat(m * a) by typecheck
  have leftReflexive := LessEqual.reflexive with maNat
  have cross := LessEqual.add_Less with leftReflexive, scaled
  have belowRational := rationalClass.rational with aNat, bSuccNat, mNat, mNonzero
  have crossNormalized : m * a + m * b < m * a + m * succ(b)
    ring_nf at cross
    ring_nf
    exact cross
  have below := rationalLess.of_representatives with mNonzero, mNonzero, crossNormalized
  witness rationalClass(a, succ(b), m)
  constructor
    exact belowRational
  . unfold rationalClass at qShape
    rw qShape
    unfold rationalClass
    exact below

-- Between two displayed fractions we use their midpoint.  The proof
-- below exposes the two positive scaling certificates: density
-- is arithmetic, while descent to quotient classes is handled by the existing
-- rational-order boundary theorem.
theorem rationalLess.dense (q r : Set)
  requires qRational : Rational(q)
  requires rRational : Rational(r)
  requires less : relates(rationalLess, q, r)
  shows ∃ s ∈ ℚ, q < s ∧ s < r
proof
  obtain ⟨a, aNat, b, bNat, m, mNat, mNonzero, qShape⟩ := Rational.coordinates with qRational
  obtain ⟨c, cNat, d, dNat, n, nNat, nNonzero, rShape⟩ := Rational.coordinates with rRational
  have displayedLess : relates(
      rationalLess, rationalClass(a, b, m), rationalClass(c, d, n))
    simpa [qShape, rShape] using less
  have crossLess := rationalLess.classes.forward with mNonzero, nNonzero, displayedLess

  have twoNonzero : 2 ≠ 0
    intro twoZero
    arith
  have mnNonzero := mul.nonzero with mNonzero, nNonzero
  have mnNat : Nat(m * n) by typecheck
  have denominatorShape := mul.two_left with mnNat
  have denominatorNonzero := mul.nonzero with twoNonzero, mnNonzero
  have midpointRational := rationalClass.rational at
    n * a + m * c, n * b + m * d,
    2 * (m * n) with denominatorNonzero

  have scaledLeft := Less.mul_left with mNonzero, crossLess
  have leftCommonNat : Nat((m * n) * a + (m * n) * b) by typecheck
  have leftCommonReflexive := LessEqual.reflexive with leftCommonNat
  have augmentedLeft := Less.add_LessEqual with scaledLeft, leftCommonReflexive
  have leftCross : (2 * (m * n)) * a + m * (n * b + m * d) < m * (n * a + m * c) + (2 * (m * n)) * b
    ring_nf at augmentedLeft
    rw denominatorShape
    ring_nf
    exact augmentedLeft
  have qMid := rationalLess.of_representatives with mNonzero, denominatorNonzero, leftCross

  have scaledRight := Less.mul_left with nNonzero, crossLess
  have rightCommonNat : Nat((m * n) * c + (m * n) * d) by typecheck
  have rightCommonReflexive := LessEqual.reflexive with rightCommonNat
  have augmentedRight := Less.add_LessEqual with scaledRight, rightCommonReflexive
  have rightCross : n * (n * a + m * c) + (2 * (m * n)) * d < (2 * (m * n)) * c + n * (n * b + m * d)
    ring_nf at augmentedRight
    rw denominatorShape
    ring_nf
    exact augmentedRight
  have midR := rationalLess.of_representatives with denominatorNonzero, nNonzero, rightCross

  witness rationalClass(n * a + m * c,
    n * b + m * d, 2 * (m * n))
  constructor
    exact midpointRational
  . constructor
    . unfold rationalClass at qShape
      rw qShape
      unfold rationalClass
      exact qMid
    . unfold rationalClass at rShape
      rw rShape
      unfold rationalClass
      exact midR
