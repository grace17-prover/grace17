module Grace.Cumulus.Relation.QuotientMap
import QuotientOperations

predicate Respects (f A r : Set) :=
  ∀ x ∈ A, ∀ y ∈ A, relates(r, x, y) → f(x) = f(y)

defunique quotientMapValue (f A B r X : Set) (y ∈ B) :=
  ∃ x ∈ A, X = ⟦x⟧[A, r] ∧ y = f(x)
requires function : f : A → B
requires equivalence : Equivalence(A, r)
requires respects : Respects(f, A, r)
requires member : X ∈ (A ⧸ r)
proof
  obtain ⟨x, hx, shape⟩ := quotient.representative at A, r, X with member
  have valueIn := FunctionBetween.apply_closed at f, A, B, x with *
  refine ⟨f(x), valueIn, x, hx, shape, rfl⟩
uniqueness
  intros y hy py z hz pz
  obtain ⟨x, hx, sx, vx⟩ := py
  obtain ⟨u, hu, su, vu⟩ := pz
  have equal : ⟦x⟧[A, r] = ⟦u⟧[A, r]
    cc
  have related := equivalenceClass.related_of_eq at A, r, x, u with *
  unfold Respects at respects
  have images := respects with x, hx, u, hu, related
  cc

defgraph quotientMap (f A B r : Set) (X ∈ (A ⧸ r)) : B := quotientMapValue(f, A, B, r, X)
requires function : f : A → B
requires equivalence : Equivalence(A, r)
requires respects : Respects(f, A, r)
proof
  have selected := quotientMapValue.selected at f, A, B, r, X with *
  exact selected.left

theorem quotientMap.class (f A B r x : Set)
  requires function : f : A → B
  requires equivalence : Equivalence(A, r)
  requires respects : Respects(f, A, r)
  requires hx : x ∈ A
  shows quotientMap(f, A, B, r)(⟦x⟧[A, r]) = f(x)
proof
  have member := quotient.contains_class with *
  have value := quotientMap.value at f, A, B, r, ⟦x⟧[A, r] with *
  have selected := quotientMapValue.selected at f, A, B, r, ⟦x⟧[A, r] with *
  obtain ⟨u, hu, shape, output⟩ := selected.right
  have related := equivalenceClass.related_of_eq with *
  have images := respects with x, hx, u, hu, related
  cc

theorem quotientMap.injective (f A B r : Set)
  requires function : f : A → B
  requires equivalence : Equivalence(A, r)
  requires respects : Respects(f, A, r)
  requires reflects : ∀ x ∈ A, ∀ y ∈ A, f(x) = f(y) → relates(r, x, y)
  shows InjectiveBetween(quotientMap(f, A, B, r), (A ⧸ r), B)
proof
  have mapped := quotientMap.function at f, A, B, r with *
  unfold InjectiveBetween
  refine ⟨mapped, ?_⟩
  intros X hX Y hY z hz left right
  obtain ⟨x, hx, sx⟩ := quotient.representative with hX
  obtain ⟨y, hy, sy⟩ := quotient.representative with hY
  have vx := quotientMap.class with hx
  have vy := quotientMap.class with hy
  have ex := FunctionBetween.apply_value at quotientMap(f, A, B, r), (A ⧸ r), B, X, z with *
  have ey := FunctionBetween.apply_value at quotientMap(f, A, B, r), (A ⧸ r), B, Y, z with *
  have images : f(x) = f(y) by cc
  have related := reflects with x, hx, y, hy, images
  have classes := equivalenceClass.eq with *
  cc

theorem quotientMap.surjective (f A B r : Set)
  requires function : f : A → B
  requires equivalence : Equivalence(A, r)
  requires respects : Respects(f, A, r)
  requires onto : SurjectiveBetween(f, A, B)
  shows SurjectiveBetween(quotientMap(f, A, B, r), (A ⧸ r), B)
proof
  have mapped := quotientMap.function at f, A, B, r with *
  unfold SurjectiveBetween
  refine ⟨mapped, ?_⟩
  intros y hy
  obtain ⟨x, hx, edge⟩ := onto.right with y, hy
  have member := quotient.contains_class with *
  have value := quotientMap.class with *
  have original := FunctionBetween.apply_value with *
  have image := FunctionBetween.relates_apply at quotientMap(f, A, B, r), (A ⧸ r), B, ⟦x⟧[A, r] with *
  refine ⟨⟦x⟧[A, r], member, ?_⟩
  cc

-- The factorization equation determines the descended function uniquely.
theorem quotientMap.unique (f g A B r : Set)
  requires function : f : A → B
  requires equivalence : Equivalence(A, r)
  requires respects : Respects(f, A, r)
  requires candidate : g : (A ⧸ r) → B
  requires factors : ∀ x ∈ A, g(⟦x⟧[A, r]) = f(x)
  shows g = quotientMap(f, A, B, r)
proof
  have mapped := quotientMap.function at f, A, B, r with *
  apply FunctionBetween.ext with candidate, mapped
  intros X hX
  obtain ⟨x, hx, shape⟩ := quotient.representative with hX
  have given := factors with x, hx
  have canonical := quotientMap.class with *
  cc

theorem quotientMap.factorization (f A B r : Set)
  requires function : f : A → B
  requires equivalence : Equivalence(A, r)
  requires respects : Respects(f, A, r)
  shows compose(quotientMap(f, A, B, r), quotientProjection(A, r), A, (A ⧸ r), B) = f
proof
  have projection := quotientProjection.function at A, r with *
  have mapped := quotientMap.function at f, A, B, r with *
  have composed := compose.function at quotientMap(f, A, B, r), quotientProjection(A, r), A, (A ⧸ r), B with *
  apply FunctionBetween.ext with composed, function
  intros x hx
  have composition := compose.apply at quotientMap(f, A, B, r), quotientProjection(A, r), A, (A ⧸ r), B, x with *
  have projected := quotientProjection.value at A, r, x with *
  have evaluated := quotientMap.class with *
  cc

theorem quotientMap.binary (f A B r op target X Y : Set)
  requires function : f : A → B
  requires equivalence : Equivalence(A, r)
  requires respects : Respects(f, A, r)
  requires closed : IsMagma(A, op)
  requires compatible : CompatibleBinary(A, r, op)
  requires preserves : ∀ x ∈ A, ∀ y ∈ A, f(op(x, y)) = target(f(x), f(y))
  requires hX : X ∈ (A ⧸ r)
  requires hY : Y ∈ (A ⧸ r)
  shows quotientMap(f, A, B, r)((quotientBinary(A, r, op))(X, Y)) =
    target(quotientMap(f, A, B, r)(X), quotientMap(f, A, B, r)(Y))
proof
  obtain ⟨x, hx, sx⟩ := quotient.representative with hX
  obtain ⟨y, hy, sy⟩ := quotient.representative with hY
  have operation := quotientBinary.classes at A, r, op, x, y with *
  have output := quotientMap.class at f, A, B, r, op(x, y) with *
  have vx := quotientMap.class at f, A, B, r, x with *
  have vy := quotientMap.class at f, A, B, r, y with *
  have original := preserves with x, hx, y, hy
  cc

theorem quotientMap.unary (f A B r op target X : Set)
  requires function : f : A → B
  requires equivalence : Equivalence(A, r)
  requires respects : Respects(f, A, r)
  requires closed : op : A → A
  requires compatible : CompatibleUnary(A, r, op)
  requires preserves : ∀ x ∈ A, f(op(x)) = target(f(x))
  requires hX : X ∈ (A ⧸ r)
  shows quotientMap(f, A, B, r)((quotientUnary(A, r, op))(X)) =
    target(quotientMap(f, A, B, r)(X))
proof
  obtain ⟨x, hx, sx⟩ := quotient.representative with hX
  have operation := quotientUnary.classes at A, r, op, x with *
  have outputIn : op(x) ∈ A
    exact FunctionBetween.apply_closed at op, A, A, x with *
  have output := quotientMap.class at f, A, B, r, op(x) with *
  have vx := quotientMap.class at f, A, B, r, x with *
  have original := preserves with x, hx
  cc
