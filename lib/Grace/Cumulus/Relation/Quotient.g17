module Grace.Cumulus.Relation.Quotient
import Relation
import Set

-- Equivalence classes and quotients are sets.  Both comprehensions
-- are bounded, so these definitions use only Separation and Power Set.
def equivalenceClass (A r x : Set) : Set := { y ∈ A | relates(r, x, y) }
def quotient (A r : Set) : Set := { C ∈ 𝒫(A) | ∃ x ∈ A, C = ⟦x⟧[A, r] }
notation infixl 70 "⧸" => quotient

theorem equivalenceClass.subset (A r x : Set)
  shows (⟦x⟧[A, r] ⊆ A)
proof
  simp

theorem equivalenceClass.self (A r x : Set)
  requires equivalence : Equivalence(A, r)
  requires hx : x ∈ A
  shows x ∈ ⟦x⟧[A, r]
proof
  apply equivalenceClass.membership.backward
  constructor
  exact hx
  exact Equivalence.reflexive with equivalence, x, hx

theorem equivalenceClass.eq (A r x y : Set)
  requires equivalence : Equivalence(A, r)
  requires hx : x ∈ A
  requires hy : y ∈ A
  requires hxy : relates(r, x, y)
  shows ⟦x⟧[A, r] = ⟦y⟧[A, r]
proof
  ext z
  constructor
  intro hzx
  apply equivalenceClass.membership.backward
  simp [equivalenceClass.membership] at hzx
  rcases hzx with ⟨hzA, hxz⟩
  constructor
  exact hzA
  have symmetric := Equivalence.symmetric with equivalence, x, hx, y, hy, hxy
  exact Equivalence.transitive with equivalence, y, hy, x, hx, z, hzA, symmetric, hxz
  intro hzy
  apply equivalenceClass.membership.backward
  simp [equivalenceClass.membership] at hzy
  rcases hzy with ⟨hzA, hyz⟩
  constructor
  exact hzA
  exact Equivalence.transitive with equivalence, x, hx, y, hy, z, hzA, hxy, hyz

theorem equivalenceClass.members_related (A r x y z : Set)
  requires equivalence : Equivalence(A, r)
  requires hx : x ∈ A
  requires hy : y ∈ ⟦x⟧[A, r]
  requires hz : z ∈ ⟦x⟧[A, r]
  shows relates(r, y, z)
proof
  obtain ⟨hyA, hxy⟩ := equivalenceClass.membership.forward with hy
  obtain ⟨hzA, hxz⟩ := equivalenceClass.membership.forward with hz
  have symmetric := Equivalence.symmetric with equivalence, x, hx, y, hyA, hxy
  exact Equivalence.transitive with equivalence, y, hyA, x, hx, z, hzA, symmetric, hxz

theorem equivalenceClass.related_of_eq (A r x y : Set)
  requires equivalence : Equivalence(A, r)
  requires hx : x ∈ A
  requires hy : y ∈ A
  requires same : ⟦x⟧[A, r] = ⟦y⟧[A, r]
  shows relates(r, x, y)
proof
  have xSelf := equivalenceClass.self with equivalence, hx
  have ySelf := equivalenceClass.self with equivalence, hy
  rw ← same at ySelf
  exact equivalenceClass.members_related with equivalence, hx, xSelf, ySelf

theorem quotient.contains_class (A r x : Set)
  requires equivalence : Equivalence(A, r)
  requires hx : x ∈ A
  shows ⟦x⟧[A, r] ∈ (A ⧸ r)
proof
  apply quotient.membership.backward
  constructor
  apply set.powerset.backward
  exact equivalenceClass.subset at A, r, x
  refine ⟨x, hx, rfl⟩

theorem quotient.subset_powerset (A r : Set)
  shows ((A ⧸ r) ⊆ 𝒫(A))
proof
  simp with Subset

theorem quotient.member_nonempty (C A r : Set)
  requires equivalence : Equivalence(A, r)
  requires hC : C ∈ (A ⧸ r)
  shows Nonempty(C)
proof
  simp [quotient.membership] at hC
  rcases hC with ⟨hCPower, x, hxA, hClass⟩
  witness x
  rw hClass
  exact equivalenceClass.self with equivalence, hxA

theorem quotient.members_related (C A r y z : Set)
  requires equivalence : Equivalence(A, r)
  requires hC : C ∈ (A ⧸ r)
  requires hy : y ∈ C
  requires hz : z ∈ C
  shows relates(r, y, z)
proof
  obtain ⟨powerC, x, hxA, classShape⟩ := quotient.membership.forward with hC
  rw classShape at hy
  rw classShape at hz
  exact equivalenceClass.members_related with equivalence, hxA, hy, hz

theorem quotient.class_of_member (C A r x : Set)
  requires equivalence : Equivalence(A, r)
  requires hC : C ∈ (A ⧸ r)
  requires hx : x ∈ C
  shows C = ⟦x⟧[A, r]
proof
  obtain ⟨powerC, y, hyA, classShape⟩ := quotient.membership.forward with hC
  rw classShape at hx
  obtain ⟨hxA, related⟩ := equivalenceClass.membership.forward with hx
  have classes := equivalenceClass.eq with equivalence, hyA, hxA, related
  rwa classShape
