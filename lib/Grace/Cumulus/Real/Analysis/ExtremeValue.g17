module Grace.Cumulus.Real.Analysis.ExtremeValue
import Set.Choice
import SequentialCompactness

-- Section: ShrinkingRadii
def realFunctionImage (f S : Set) : Set := { f(X) | X ∈ S }

theorem realFunctionImage.membership (f S Y : Set)
  shows Y ∈ realFunctionImage(f, S) ↔ ∃ X ∈ S, f(X) = Y
proof
  simp

theorem realFunctionImage.subset_reals (f S : Set)
  requires function : f : ℝ → ℝ
  requires subset : S ⊆ ℝ
  shows realFunctionImage(f, S) ⊆ ℝ
proof
  intros Y member
  obtain ⟨X, inS, value⟩ := realFunctionImage.membership.forward with member
  have realX := subset with X, inS
  have realY := FunctionBetween.apply_closed with function, realX
  rwa value at realY

defchoose imagePreimage (f S u : Set, n : Nat) (X ∈ ℝ) :=
  X ∈ S ∧ f(X) = u[n]
requires subset : S ⊆ ℝ
requires terms : TermsIn(u, realFunctionImage(f, S))
proof
  have naturalN := nat.omega.forward at n with assumption
  have member := terms with n, naturalN
  obtain ⟨X, inS, value⟩ := realFunctionImage.membership.forward at
    f, S, u[n] with member
  have realX := subset with X, inS
  witness X
  refine ⟨realX, inS, value⟩

defgraph imagePreimages (f S u : Set) (n ∈ ℕ) : ℝ :=
  imagePreimage(f, S, u, n)
requires subset : S ⊆ ℝ
requires terms : TermsIn(u, realFunctionImage(f, S))
proof
  obtain ⟨realX, inS, value⟩ := imagePreimage.selected with subset, terms
  exact realX

theorem imagePreimages.terms (f S u : Set)
  requires subset : S ⊆ ℝ
  requires terms : TermsIn(u, realFunctionImage(f, S))
  shows TermsIn(imagePreimages(f, S, u), S)
proof
  intros n naturalN
  have typedN := nat.omega.backward with naturalN
  have value := imagePreimages.value with subset, terms
  obtain ⟨realX, inS, equation⟩ := imagePreimage.selected with subset, terms
  rwa value

theorem imagePreimages.maps (f S u : Set, n : Nat)
  requires subset : S ⊆ ℝ
  requires terms : TermsIn(u, realFunctionImage(f, S))
  shows f(imagePreimages(f, S, u)[n]) = u[n]
proof
  have value := imagePreimages.value with subset, terms
  obtain ⟨realX, inS, equation⟩ := imagePreimage.selected with subset, terms
  rwa value

-- CompactImage
theorem ConvergesTo.of_equal_terms (u v : Set) (L : Real)
  requires sequence : RealSequence(u)
  requires converges : ConvergesTo(v, L)
  requires equal : ∀ n ∈ ℕ, u[n] = v[n]
  shows ConvergesTo(u, L)
proof
  constructor
  . exact sequence
  . intros E realE positive
    obtain ⟨N, naturalN, close⟩ := ConvergesTo.eventually with converges, positive
    witness N
    constructor
    . exact naturalN
    . intros n naturalIndex after
      have same := equal with n, naturalIndex
      rw same
      exact close with n, naturalIndex, after

theorem realFunctionImage.sequentially_compact (f S : Set)
  requires continuous : ContinuousOn(f, S)
  requires compact : SequentiallyCompact(S)
  shows SequentiallyCompact(realFunctionImage(f, S))
proof
  rcases continuous with ⟨function, subset, atPoints⟩
  have continuousAgain : ContinuousOn(f, S) by refine ⟨function, subset, atPoints⟩
  constructor
  . exact realFunctionImage.subset_reals with function, subset
  . intros u sequence terms
    have preimages := imagePreimages.terms with subset, terms
    have preimageSequence : RealSequence(imagePreimages(f, S, u))
      unfold RealSequence
      exact imagePreimages.function with subset, terms
    obtain ⟨k, increasing, L, realL, member, mapped⟩ := ContinuousOn.compact_subsequence with
      continuousAgain, compact, preimageSequence, preimages
    have selectedSequence := subsequence.sequence with sequence, increasing
    have mappedConverges : ConvergesTo(subsequence(u, k), f(L))
      apply ConvergesTo.of_equal_terms with selectedSequence, mapped
      intros n naturalN
      have typedN := nat.omega.backward with naturalN
      have selector := StrictlyIncreasingNat.function with increasing
      have selectedNatural := FunctionBetween.apply_closed with selector, naturalN
      have typedSelected := nat.omega.backward with selectedNatural
      have imageValue := imagePreimages.maps at f, S, u, k[n] with
        subset, terms
      have selectedInput := subsequence.value at
        imagePreimages(f, S, u), k, n with preimageSequence, increasing
      have selectedOutput := subsequence.value at u, k, n with
        sequence, increasing
      have inputSequence := subsequence.sequence with preimageSequence, increasing
      have inputFunction : subsequence(imagePreimages(f, S, u), k) : ℕ → ℝ by exact inputSequence
      have composed := compose.apply with inputFunction, function, naturalN
      rw [composed, selectedInput, selectedOutput, imageValue]
      rfl
    have imageMember : f(L) ∈ realFunctionImage(f, S)
      apply realFunctionImage.membership.backward
      witness L
      refine ⟨member, rfl⟩
    witness k
    constructor
    . exact increasing
    . witness f(L)
      have realLValue := FunctionBetween.apply_closed with function, realL
      refine ⟨realLValue, imageMember, mappedConverges⟩

theorem closedInterval.continuous_image_compact (f : Set) (A B : Real)
  requires continuous : ContinuousOn(f, closedInterval(A, B))
  shows SequentiallyCompact(realFunctionImage(f, closedInterval(A, B)))
proof
  have compact := closedInterval.sequentially_compact at A, B with
    *{2}
  exact realFunctionImage.sequentially_compact with continuous, compact

-- NearbySequences
predicate AsymptoticallyClose (u v : Set) :=
  RealSequence(u) ∧ RealSequence(v) ∧
  (∀ E ∈ ℝ, 0 < E →
    ∃ N ∈ ℕ, ∀ n ∈ ℕ, N ≤ n →
      vₙ ∈ openBall(uₙ, E))

theorem AsymptoticallyClose.eventually (u v : Set) (E : Real)
  requires close : AsymptoticallyClose(u, v)
  requires positive : 0 < E
  shows ∃ N ∈ ℕ, ∀ n ∈ ℕ, N ≤ n →
    vₙ ∈ openBall(uₙ, E)
proof
  rcases close with ⟨sequenceU, sequenceV, eventual⟩
  exact eventual with E, positive

theorem AsymptoticallyClose.symmetric (u v : Set)
  requires close : AsymptoticallyClose(u, v)
  shows AsymptoticallyClose(v, u)
proof
  rcases close with ⟨sequenceU, sequenceV, eventual⟩
  unfold AsymptoticallyClose
  refine ⟨sequenceV, sequenceU, _⟩
  intros E realE positive
  obtain ⟨N, naturalN, near⟩ := eventual with E, realE, positive
  witness N
  constructor
  . exact naturalN
  . intros n littleNatural afterN
    have typedN : Nat(n) by exact nat.omega.backward at n with littleNatural
    have realU := RealSequence.value with sequenceU
    have realV := RealSequence.value with sequenceV
    have nearVU := near with n, littleNatural, afterN
    exact openBall.symmetric.forward with realV, realU, nearVU

theorem ConvergesTo.of_asymptotically_close (u v : Set) (L : Real)
  requires converges : ConvergesTo(u, L)
  requires close : AsymptoticallyClose(u, v)
  shows ConvergesTo(v, L)
proof
  rcases close with ⟨sequenceU, sequenceV, closeness⟩
  constructor
  . exact sequenceV
  . intros E realE positive
    have typedE : Real(E) by exact realE
    have halfReal := half.real with typedE
    have halfPositive := half.positive with positive
    obtain ⟨N, nNatural, nearL⟩ := ConvergesTo.eventually with converges, halfPositive
    obtain ⟨M, mNatural, nearU⟩ :=
      closeness with half(E), halfPositive
    have typedN : Nat(N) by exact nat.omega.backward at N with nNatural
    have typedM : Nat(M) by exact nat.omega.backward at M with mNatural
    have comparison := Less.trichotomy with typedN, typedM
    cases comparison with nLessM | rest
    . have nLeM := Less.implies_LessEqual at N, M with
        typedN, typedM, nLessM
      witness M
      constructor
      . exact mNatural
      . intros n naturalN mLeN
        have nLeLittleN := LessEqual.transitive with nLeM, mLeN
        have closeL := nearL with n, naturalN, nLeLittleN
        have closeU := nearU with n, naturalN, mLeN
        have realU := RealSequence.value at u, n with sequenceU
        have realV := RealSequence.value at v, n with sequenceV
        have double := openBall.triangle at
          vₙ, uₙ, L, half(E), half(E) with
            realV, realU, assumption, halfReal, halfReal, closeU, closeL
        have halves := half.add_self with typedE
        rwa halves at double
    . cases rest with equal | mLessN
      . witness N
        constructor
        . exact nNatural
        . intros n naturalN nLeLittleN
          have mLeLittleN : M ≤ n by rwa ← equal
          have closeL := nearL with n, naturalN, nLeLittleN
          have closeU := nearU with n, naturalN, mLeLittleN
          have realU := RealSequence.value at u, n with sequenceU
          have realV := RealSequence.value at v, n with sequenceV
          have double := openBall.triangle at
            vₙ, uₙ, L, half(E), half(E) with
              realV, realU, assumption, halfReal, halfReal, closeU, closeL
          have halves := half.add_self with typedE
          rwa halves at double
      . have mLeN := Less.implies_LessEqual at M, N with
          typedM, typedN, mLessN
        witness N
        constructor
        . exact nNatural
        . intros n naturalN nLeLittleN
          have mLeLittleN := LessEqual.transitive with mLeN, nLeLittleN
          have closeL := nearL with n, naturalN, nLeLittleN
          have closeU := nearU with n, naturalN, mLeLittleN
          have realU := RealSequence.value at u, n with sequenceU
          have realV := RealSequence.value at v, n with sequenceV
          have double := openBall.triangle at
            vₙ, uₙ, L, half(E), half(E) with
              realV, realU, assumption, halfReal, halfReal, closeU, closeL
          have halves := half.add_self with typedE
          rwa halves at double

theorem AsymptoticallyClose.subsequence (u v k : Set)
  requires close : AsymptoticallyClose(u, v)
  requires increasing : StrictlyIncreasingNat(k)
  shows AsymptoticallyClose(subsequence(u, k), subsequence(v, k))
proof
  rcases close with ⟨sequenceU, sequenceV, eventually⟩
  constructor
  . exact subsequence.sequence with sequenceU, increasing
  . constructor
    . exact subsequence.sequence with sequenceV, increasing
    . intros E realE positive
      obtain ⟨N, nNatural, near⟩ := eventually with E, realE, positive
      witness N
      constructor
      . exact nNatural
      . intros n littleNatural afterN
        have typedN : Nat(n) by exact nat.omega.backward at n with littleNatural
        have typedThreshold : Nat(N) by exact nat.omega.backward at N with nNatural
        have selectedNatural := FunctionBetween.apply_closed at
          k, ℕ, ℕ, n with
            StrictlyIncreasingNat.function at k with increasing,
            littleNatural
        have typedSelected : Nat(kₙ) by exact nat.omega.backward at kₙ with selectedNatural
        have aboveIndex := StrictlyIncreasingNat.index_le_value at
          k, n with increasing
        have aboveThreshold := LessEqual.transitive with
          typedThreshold, typedN, typedSelected, afterN, aboveIndex
        have selectedNear := near with kₙ, selectedNatural, aboveThreshold
        have uValue := subsequence.value at u, k, n with
          sequenceU, increasing
        have vValue := subsequence.value at v, k, n with
          sequenceV, increasing
        rwa [vValue, uValue]

-- In a sequentially compact set, one extracted subsequence of u makes
-- both u and every asymptotically close companion v converge to its limit.
theorem SequentiallyCompact.nearby_subsequences (S u v : Set)
  requires compact : SequentiallyCompact(S)
  requires sequence : RealSequence(u)
  requires terms : TermsIn(u, S)
  requires close : AsymptoticallyClose(u, v)
  shows ∃ k, StrictlyIncreasingNat(k) ∧
    ∃ L ∈ ℝ, L ∈ S ∧
      ConvergesTo(subsequence(u, k), L) ∧
      ConvergesTo(subsequence(v, k), L)
proof
  rcases compact with ⟨subset, extract⟩
  obtain ⟨k, increasing, L, realL, member, converges⟩ :=
    extract with u, sequence, terms
  have selectedClose := AsymptoticallyClose.subsequence with close, increasing
  have companion := ConvergesTo.of_asymptotically_close with converges, selectedClose
  witness k
  constructor
  . exact increasing
  . witness L
    refine ⟨realL, member, converges, companion⟩

theorem ContinuousOn.nearby_compact_images (f S u v : Set)
  requires continuous : ContinuousOn(f, S)
  requires compact : SequentiallyCompact(S)
  requires sequence : RealSequence(u)
  requires termsU : TermsIn(u, S)
  requires termsV : TermsIn(v, S)
  requires close : AsymptoticallyClose(u, v)
  shows ∃ k, StrictlyIncreasingNat(k) ∧
    ∃ L ∈ ℝ, L ∈ S ∧
      ConvergesTo(compose(f, subsequence(u, k), ℕ, ℝ, ℝ), f(L)) ∧
      ConvergesTo(compose(f, subsequence(v, k), ℕ, ℝ, ℝ), f(L))
proof
  obtain ⟨k, increasing, L, realL, member, convergesU, convergesV⟩ := SequentiallyCompact.nearby_subsequences with
    compact, sequence, termsU, close
  have selectedU := TermsIn.subsequence with sequence, termsU, increasing
  obtain ⟨uSequence, vSequence, eventually⟩ := close
  have selectedV := TermsIn.subsequence with vSequence, termsV, increasing
  have mappedU := ContinuousOn.converges_in with continuous, member, convergesU, selectedU
  have mappedV := ContinuousOn.converges_in with continuous, member, convergesV, selectedV
  witness k
  constructor
  . exact increasing
  . witness L
    refine ⟨realL, member, mappedU, mappedV⟩

-- Images that share a limit cannot remain a fixed positive distance apart.
theorem ConvergesTo.eventually_near_each_other (u v : Set) (L E : Real)
  requires convergesU : ConvergesTo(u, L)
  requires convergesV : ConvergesTo(v, L)
  requires positive : 0 < E
  shows ∃ N ∈ ℕ, ∀ n ∈ ℕ, N ≤ n →
    vₙ ∈ openBall(uₙ, E)
proof
  have halfReal := half.real at E
  have halfPositive := half.positive with positive
  obtain ⟨N, naturalN, both⟩ := ConvergesTo.common_eventually with
    convergesU, convergesV, halfPositive, halfPositive
  witness N
  constructor
  . exact naturalN
  . intros n littleNatural afterN
    have typedN : Nat(n) by exact nat.omega.backward at n with littleNatural
    obtain ⟨nearU, nearV⟩ := both with n, littleNatural, afterN
    have sequenceU := ConvergesTo.sequence with convergesU
    have realU := RealSequence.value with sequenceU
    have sequenceV := ConvergesTo.sequence with convergesV
    have realV := RealSequence.value with sequenceV
    have fromLimit := openBall.symmetric.forward at
      uₙ, L, half(E) with realU, assumption, halfReal, nearU
    have together := openBall.triangle at
      vₙ, L, uₙ, half(E), half(E) with
        realV, assumption, realU, halfReal, halfReal, nearV, fromLimit
    have halves := half.add_self at E
    rwa halves at together

-- UniformFailure
predicate UniformFailurePair (f S : Set) (E D : Real, X Y : Real) :=
  X ∈ S ∧ Y ∈ S ∧
  X ∈ openBall(Y, D) ∧
  ¬(f(X) ∈ openBall(f(Y), E))

-- Under the function and carrier assumptions supplied by continuity,
-- negating uniform continuity fixes one output tolerance once and for all.
theorem ContinuousOn.nonuniform_tolerance (f S : Set)
  requires continuous : ContinuousOn(f, S)
  requires notUniform : ¬UniformContinuousOn(f, S)
  shows ∃ E ∈ ℝ, (0 < E ∧
    ∀ D ∈ ℝ, (0 < D →
      ¬(∀ X ∈ ℝ, (X ∈ S →
        ∀ Y ∈ ℝ, (Y ∈ S →
          (X ∈ openBall(Y, D) →
            f(X) ∈ openBall(f(Y), E)))))))
proof
  rcases continuous with ⟨function, subset, atPoints⟩
  by_contra noTolerance
  apply notUniform
  constructor
  . exact function
  . constructor
    . exact subset
    . intros E realE positive
      have radiusExists : ∃ D ∈ ℝ, (0 < D ∧
          ∀ X ∈ ℝ, (X ∈ S →
            ∀ Y ∈ ℝ, (Y ∈ S →
              (X ∈ openBall(Y, D) →
                f(X) ∈ openBall(f(Y), E)))))
        by_contra noRadius
        apply noTolerance
        witness E
        constructor
        . exact realE
        . constructor
          . exact positive
          . intros D realD positiveD maps
            apply noRadius
            witness D
            refine ⟨realD, positiveD, maps⟩
      exact radiusExists

-- This is the textbook epsilon that defeats every delta, with the real
-- witnesses and interval membership written out.
theorem ContinuousOn.nonuniform_pairs (f S : Set)
  requires continuous : ContinuousOn(f, S)
  requires notUniform : ¬UniformContinuousOn(f, S)
  shows ∃ E ∈ ℝ, (0 < E ∧
    ∀ D ∈ ℝ, (0 < D →
      ∃ X ∈ ℝ, ∃ Y ∈ ℝ, UniformFailurePair(f, S, E, D, X, Y)))
proof
  obtain ⟨E, realE, positiveE, noRadius⟩ := ContinuousOn.nonuniform_tolerance with continuous, notUniform
  witness E
  constructor
  . exact realE
  . constructor
    . exact positiveE
    . intros D realD positiveD
      have noMaps := noRadius with D, realD, positiveD
      have bad : ∃ X ∈ ℝ, ∃ Y ∈ ℝ, (
          X ∈ S ∧ Y ∈ S ∧ X ∈ openBall(Y, D) ∧
            ¬(f(X) ∈ openBall(f(Y), E)))
        by_contra noBad
        apply noMaps
        intros P realP memberP Q realQ memberQ near
        by_contra notNear
        apply noBad
        witness P
        constructor
        . exact realP
        . witness Q
          refine ⟨realQ, memberP, memberQ, near, notNear⟩
      obtain ⟨X, realX, Y, realY, memberX, memberY, near, far⟩ := bad
      witness X
      constructor
      . exact realX
      . witness Y
        constructor
        . exact realY
        . unfold UniformFailurePair
          refine ⟨memberX, memberY, near, far⟩

-- ShrinkingRadii
def dyadicRadius (n : Nat) → Real
  | 0 => realOne
  | succ(n) => half(dyadicRadius(n))

theorem dyadicRadius.real (n : Nat)
  shows Real(dyadicRadius(n))
proof
  induction n
  | zero =>
    rw dyadicRadius
    exact realOne.real
  | succ(j) using ih =>
    rw dyadicRadius
    exact half.real with ih

theorem dyadicRadius.positive (n : Nat)
  shows 0 < dyadicRadius(n)
proof
  induction n
  | zero =>
    rw dyadicRadius
    exact realZero.lt_one
  | succ(j) using ih =>
    rw dyadicRadius
    exact half.positive with ih

theorem dyadicRadius.strictly_decreasing (n : Nat)
  shows dyadicRadius(succ(n)) < dyadicRadius(n)
proof
  have positive := dyadicRadius.positive at n
  rw dyadicRadius
  exact half.lt_self with positive

-- Replacement constructs the bounded graph; defgraph checks its real-valued
-- closure and derives its function, relation, and application laws.
defgraph dyadicRadii (n : Nat) : Real := dyadicRadius(n)

theorem dyadicRadii.sequence
  shows RealSequence(dyadicRadii)
proof
  exact dyadicRadii.function

theorem dyadicRadii.nonincreasing
  shows Nonincreasing(dyadicRadii)
proof
  have step : StepwiseNonincreasing(dyadicRadii)
    intros n naturalN
    have typedN : Nat(n) by exact nat.omega.backward at n with naturalN
    have typedNext := Naturals.constructor.succ with typedN
    have less := dyadicRadius.strictly_decreasing with typedN
    have weak := realLess.implies_le with less
    have valueN := dyadicRadii.value with typedN
    have valueNext := dyadicRadii.value with typedNext
    rw [valueNext, valueN]
    exact realLe.characterization.forward with weak
  exact StepwiseNonincreasing.nonincreasing with dyadicRadii.sequence, step

theorem dyadicRadii.bounded_below
  shows BoundedBelowBy(dyadicRadii, realZero)
proof
  intros n naturalN
  have typedN : Nat(n) by exact nat.omega.backward at n with naturalN
  have positive := dyadicRadius.positive with typedN
  have weak := realLess.implies_le with positive
  have value := dyadicRadii.value with typedN
  rw value
  exact realLe.characterization.forward with weak

theorem dyadicRadii.has_limit
  shows ∃ L ∈ ℝ, ConvergesTo(dyadicRadii, L)
proof
  exact Nonincreasing.has_limit with
    dyadicRadii.sequence, dyadicRadii.nonincreasing, dyadicRadii.bounded_below

-- A positive limiting value L is impossible: eventually a radius r lies
-- below L + L, while the next radius is r/2 and must still lie above L.
theorem dyadicRadii.limit_zero
  shows realSequenceInfimum(dyadicRadii) = realZero
proof
  have converges := Nonincreasing.converges_to_infimum with
    dyadicRadii.sequence, dyadicRadii.nonincreasing, dyadicRadii.bounded_below
  have limitReal : Real(realSequenceInfimum(dyadicRadii))
    exact realSequenceInfimum.real with dyadicRadii.sequence, dyadicRadii.bounded_below
  have nonnegative := ConvergesTo.ge_constant with converges, dyadicRadii.bounded_below
  have nonpositive : realSequenceInfimum(dyadicRadii) ≤ realZero
    by_contra notLe
    have positive := realLess.of_not_le with notLe
    obtain ⟨N, naturalN, eventually⟩ := ConvergesTo.eventually with converges, positive
    have typedN : Nat(N) by exact nat.omega.backward at N with naturalN
    have typedNext := Naturals.constructor.succ with typedN
    have reflexive := LessEqual.reflexive with typedN
    have near := eventually with N, naturalN, reflexive
    have lower := Nonincreasing.infimum_le_term at
      dyadicRadii, realZero, succ(N) with
        dyadicRadii.sequence, dyadicRadii.bounded_below
    have valueN := dyadicRadii.value with typedN
    have valueNext := dyadicRadii.value with typedNext
    rw [valueNext, dyadicRadius] at lower
    have radiusReal := dyadicRadius.real with typedN
    have doubled := realLe.add with lower, lower
    have halves := half.add_self with radiusReal
    rw halves at doubled
    rw valueN at near
    obtain ⟨lowerNear, upperNear⟩ := openBall.order_characterization.forward with near
    have impossible := realLe.transitive_less with doubled, upperNear
    exact IsOrderedField.irreflexive with reals.ordered_field, impossible
  have lowerView := realLe.characterization.forward with nonnegative
  have upperView := realLe.characterization.forward with nonpositive
  exact RealLe.antisymmetric with upperView, lowerView

theorem dyadicRadii.converges_zero
  shows ConvergesTo(dyadicRadii, realZero)
proof
  have converges := Nonincreasing.converges_to_infimum with
    dyadicRadii.sequence, dyadicRadii.nonincreasing, dyadicRadii.bounded_below
  rwa dyadicRadii.limit_zero at converges

theorem dyadicRadii.eventually_below (E : Real)
  requires positive : 0 < E
  shows ∃ N ∈ ℕ, ∀ n ∈ ℕ, N ≤ n → dyadicRadius(n) < E
proof
  obtain ⟨N, naturalN, close⟩ := ConvergesTo.eventually with dyadicRadii.converges_zero, positive
  witness N
  constructor
  . exact naturalN
  . intros n littleNatural afterN
    have typedN : Nat(n) by exact nat.omega.backward at n with littleNatural
    have near := close with n, littleNatural, afterN
    have value := dyadicRadii.value with typedN
    rw value at near
    obtain ⟨lower, upper⟩ := openBall.order_characterization.forward with near
    have zero := realAddValue.zero_left at E
    rwa zero at upper

-- Section: ExtremeValue
defchoose nearSupremumPoint (S : Set, U : Real, n : Nat) (X ∈ ℝ) :=
  X ∈ S ∧ U - dyadicRadius(n) < X
requires least : RealLeastUpperBound(S, U)
proof
  have radius := dyadicRadius.positive at n
  obtain ⟨X, inS, near⟩ := RealLeastUpperBound.approached with least, radius
  have upper : RealUpperBound(S, U)
    rcases least with ⟨bound, minimal⟩
    exact bound
  rcases upper with ⟨realU, subset, bounds⟩
  have realX := subset with X, inS
  witness X
  refine ⟨realX, inS, near⟩

defgraph nearSupremumSequence (S : Set, U : Real) (n ∈ ℕ) : ℝ :=
  nearSupremumPoint(S, U, n)
requires least : RealLeastUpperBound(S, U)
proof
  obtain ⟨realX, inS, near⟩ := nearSupremumPoint.selected with least
  exact realX

theorem nearSupremumSequence.terms (S : Set) (U : Real)
  requires least : RealLeastUpperBound(S, U)
  shows TermsIn(nearSupremumSequence(S, U), S)
proof
  intros n naturalN
  have typedN := nat.omega.backward with naturalN
  have value := nearSupremumSequence.value with least
  obtain ⟨realX, member, near⟩ := nearSupremumPoint.selected with least
  rwa value

theorem nearSupremumSequence.bounds (S : Set) (U : Real, n : Nat)
  requires least : RealLeastUpperBound(S, U)
  shows U - dyadicRadii[n] < nearSupremumSequence(S, U)[n] ∧
    nearSupremumSequence(S, U)[n] ≤ U
proof
  have value := nearSupremumSequence.value with least
  have radius := dyadicRadii.value at n
  obtain ⟨realX, member, near⟩ := nearSupremumPoint.selected with least
  have upper : RealUpperBound(S, U)
    rcases least with ⟨bound, minimal⟩
    exact bound
  rcases upper with ⟨realU, subset, bounds⟩
  have bound := bounds with nearSupremumPoint(S, U, n), member
  have realPoint : Real(nearSupremumPoint(S, U, n)) by exact realX
  have weak := realLe.of_subset with realPoint, realU, bound
  constructor
  . rw [value, radius]
    exact near
  . rw value
    exact weak

theorem nearSupremumSequence.converges (S : Set) (U : Real)
  requires least : RealLeastUpperBound(S, U)
  shows ConvergesTo(nearSupremumSequence(S, U), U)
proof
  have upperConverges := constantSequence.converges at U
  have lowerConverges := ConvergesTo.sub with upperConverges, dyadicRadii.converges_zero
  have zero : U - realZero = U by ring
  rw zero at lowerConverges
  have upperSequence := ConvergesTo.sequence with upperConverges
  have lowerSequence := ConvergesTo.sequence with lowerConverges
  have nearSequence : RealSequence(nearSupremumSequence(S, U))
    unfold RealSequence
    exact nearSupremumSequence.function with least
  have lower : PointwiseLE(subSequence(constantSequence(U), dyadicRadii),
      nearSupremumSequence(S, U))
    intros n naturalN
    have typedN := nat.omega.backward with naturalN
    obtain ⟨strict, weak⟩ := nearSupremumSequence.bounds with least
    have constantValue := constantSequence.value at U, n
    have radiusValue := dyadicRadii.value at n
    have realConstant := RealSequence.value with upperSequence
    have realRadius := RealSequence.value with dyadicRadii.sequence
    have lowerAtN := subSequence.value with upperSequence, dyadicRadii.sequence, realConstant, realRadius
    rw constantValue at lowerAtN
    rw lowerAtN
    have lowerWeak := realLess.implies_le with strict
    exact realLe.characterization.forward with lowerWeak
  have upper : PointwiseLE(nearSupremumSequence(S, U), constantSequence(U))
    intros j naturalJ
    have typedJ := nat.omega.backward with naturalJ
    obtain ⟨strict, weak⟩ := nearSupremumSequence.bounds with least
    have constantValue := constantSequence.value at U, j
    rw constantValue
    exact realLe.characterization.forward with weak
  exact ConvergesTo.squeeze with lowerConverges, nearSequence, upperConverges, lower, upper

-- CompactExtrema
theorem SequentiallyCompact.contains_supremum (S : Set) (U : Real)
  requires compact : SequentiallyCompact(S)
  requires least : RealLeastUpperBound(S, U)
  shows U ∈ S
proof
  have sequence : RealSequence(nearSupremumSequence(S, U))
    unfold RealSequence
    exact nearSupremumSequence.function with least
  have terms := nearSupremumSequence.terms with least
  rcases compact with ⟨subset, extract⟩
  obtain ⟨k, increasing, L, realL, member, converges⟩ :=
    extract with nearSupremumSequence(S, U), sequence, terms
  have limit := nearSupremumSequence.converges with least
  have selected := ConvergesTo.subsequence with limit, increasing
  have same := ConvergesTo.unique with converges, selected
  rwa ← same

theorem SequentiallyCompact.has_maximum_of_upper_bound (S : Set) (B : Real)
  requires compact : SequentiallyCompact(S)
  requires inhabited : Nonempty(S)
  requires upper : RealUpperBound(S, B)
  shows ∃ U ∈ S, ∀ X ∈ S, (X:R) ≤ (U:R)
proof
  have least := realSup.least_upper_bound with inhabited, upper
  have typedSup : Real(realSup(S))
    rcases least with ⟨bound, minimal⟩
    rcases bound with ⟨realSupremum, reals, below⟩
    exact realSupremum
  have member := SequentiallyCompact.contains_supremum with compact, least
  witness realSup(S)
  constructor
  . exact member
  . intros X inS
    rcases least with ⟨bound, minimal⟩
    rcases bound with ⟨realSupremum, reals, below⟩
    have included := below with X, inS
    have realX := reals with X, inS
    exact realLe.of_subset with realSupremum, included

theorem ContinuousOn.closed_interval_maximum_of_upper_bound (f : Set) (A B M : Real)
  requires ordered : A ≤ B
  requires continuous : ContinuousOn(f, closedInterval(A, B))
  requires upper : RealUpperBound(realFunctionImage(f, closedInterval(A, B)), M)
  shows ∃ T ∈ closedInterval(A, B),
    ∀ X ∈ closedInterval(A, B),
      (f(X):R) ≤ (f(T):R)
proof
  have compact := closedInterval.continuous_image_compact with continuous
  have left := closedInterval.left_mem with ordered
  have function : f : ℝ → ℝ
    rcases continuous with ⟨graph, subset, points⟩
    exact graph
  have imageLeft : f(A) ∈ realFunctionImage(f, closedInterval(A, B))
    apply realFunctionImage.membership.backward
    witness A
    refine ⟨left, rfl⟩
  have inhabited : Nonempty(realFunctionImage(f, closedInterval(A, B))) := ⟨f(A), imageLeft⟩
  obtain ⟨V, inImage, greatest⟩ := SequentiallyCompact.has_maximum_of_upper_bound with
    compact, inhabited, upper
  obtain ⟨T, inInterval, value⟩ := realFunctionImage.membership.forward with inImage
  witness T
  constructor
  . exact inInterval
  . intros X inIntervalX
    have imageX : f(X) ∈ realFunctionImage(f, closedInterval(A, B))
      apply realFunctionImage.membership.backward
      witness X
      refine ⟨inIntervalX, rfl⟩
    have bound := greatest with f(X), imageX
    rwa value

-- EscapingSequence
predicate UnboundedAbove (S : Set) :=
  ∀ B ∈ ℝ, ∃ X ∈ S, (B:R) < (X:R)

defchoose nextAbove (S : Set, B : Real) (X ∈ ℝ) :=
  X ∈ S ∧ B + 1 < X
requires subset : S ⊆ ℝ
requires unbounded : UnboundedAbove(S)
proof
  have threshold := realAddValue.real at B, realOne with
    assumption, realOne.real
  have memberThreshold : B + 1 ∈ ℝ
    unfold Real at threshold
    exact threshold
  unfold UnboundedAbove at unbounded
  obtain ⟨X, inS, above⟩ := unbounded with B + 1, memberThreshold
  unfold Subset at subset
  have realX := subset with X, inS
  witness X
  refine ⟨realX, inS, above⟩

def escapingPoint (S : Set, A : Real, n : Nat) → Set
  | S, A, zero => A
  | S, A, succ(k) => nextAbove(S, escapingPoint(S, A, k))

theorem escapingPoint.real (S : Set) (A : Real, n : Nat)
  requires subset : S ⊆ ℝ
  requires unbounded : UnboundedAbove(S)
  shows Real(escapingPoint(S, A, n))
proof
  induction n
  | zero =>
    rwa escapingPoint
  | succ(k) using ih =>
    rw escapingPoint
    have selected := nextAbove.selected at
      S, escapingPoint(S, A, k) with subset, unbounded
    rcases selected with ⟨realX, inS, above⟩
    exact realX

defgraph escapingSequence (S : Set, A : Real) (n ∈ ℕ) : ℝ :=
  escapingPoint(S, A, n)
requires subset : S ⊆ ℝ
requires unbounded : UnboundedAbove(S)
proof
  exact escapingPoint.real with subset, unbounded

theorem escapingPoint.member (S : Set) (A : Real, n : Nat)
  requires subset : S ⊆ ℝ
  requires unbounded : UnboundedAbove(S)
  requires start : A ∈ S
  shows escapingPoint(S, A, n) ∈ S
proof
  induction n
  | zero =>
    rwa escapingPoint
  | succ(k) using ih =>
    rw escapingPoint
    have selected := nextAbove.selected at
      S, escapingPoint(S, A, k) with subset, unbounded
    rcases selected with ⟨realX, inS, above⟩
    exact inS

theorem escapingSequence.terms (S : Set) (A : Real)
  requires subset : S ⊆ ℝ
  requires unbounded : UnboundedAbove(S)
  requires start : A ∈ S
  shows TermsIn(escapingSequence(S, A), S)
proof
  intros n naturalN
  have typedN := nat.omega.backward with naturalN
  have value := escapingSequence.value with subset, unbounded
  rw value
  exact escapingPoint.member with subset, unbounded, start

theorem escapingSequence.step (S : Set) (A : Real, n : Nat)
  requires subset : S ⊆ ℝ
  requires unbounded : UnboundedAbove(S)
  shows escapingSequence(S, A)[n] + 1 < escapingSequence(S, A)[succ(n)]
proof
  have selected := nextAbove.selected at
    S, escapingPoint(S, A, n) with subset, unbounded
  rcases selected with ⟨realX, inS, above⟩
  have atN := escapingSequence.value with subset, unbounded
  have atNext := escapingSequence.value at S, A, succ(n) with
    subset, unbounded
  rw escapingPoint at atNext
  rwa [atN, atNext]

theorem escapingSequence.nondecreasing (S : Set) (A : Real)
  requires subset : S ⊆ ℝ
  requires unbounded : UnboundedAbove(S)
  shows Nondecreasing(escapingSequence(S, A))
proof
  have sequence : RealSequence(escapingSequence(S, A))
    unfold RealSequence
    exact escapingSequence.function with subset, unbounded
  have stepwise : StepwiseNondecreasing(escapingSequence(S, A))
    intros n naturalN
    have typedN := nat.omega.backward with naturalN
    have step := escapingSequence.step with subset, unbounded
    have realN := RealSequence.value with sequence
    have realNext := RealSequence.value at escapingSequence(S, A), succ(n) with sequence
    have positive := realLess.add_left with realZero.real, realOne.real, realN, realZero.lt_one
    have zero := realAddValue.zero_right with realN
    rw zero at positive
    have realPlus := realAddValue.real with realN, realOne.real
    have strict : escapingSequence(S, A)[n] < escapingSequence(S, A)[succ(n)]
      exact realLess.transitive with realN, realPlus, realNext, positive, step
    have weak := realLess.implies_le with strict
    exact realLe.characterization.forward with weak
  exact StepwiseNondecreasing.nondecreasing with sequence, stepwise

theorem escapingSequence.gap (S : Set) (A : Real, i j : Nat)
  requires subset : S ⊆ ℝ
  requires unbounded : UnboundedAbove(S)
  requires before : i < j
  shows escapingSequence(S, A)[i] + 1 < escapingSequence(S, A)[j]
proof
  have sequence : RealSequence(escapingSequence(S, A))
    unfold RealSequence
    exact escapingSequence.function with subset, unbounded
  have increasing := escapingSequence.nondecreasing with subset, unbounded
  have naturalNext := nat.omega.forward at succ(i) with
    Naturals.constructor.succ at i with assumption
  have naturalJ := nat.omega.forward at j with assumption
  have after := increasing with succ(i), naturalNext, j, naturalJ, before
  have weak := realLe.characterization.backward with after
  have step := escapingSequence.step at S, A, i with subset, unbounded
  have realI := RealSequence.value at escapingSequence(S, A), i with sequence
  have realNext := RealSequence.value at escapingSequence(S, A), succ(i) with sequence
  have realJ := RealSequence.value at escapingSequence(S, A), j with sequence
  exact realLess.transitive_le with realNext, realJ, step, weak

-- CompactBounded
theorem SequentiallyCompact.not_unbounded_above (S : Set)
  requires compact : SequentiallyCompact(S)
  requires inhabited : Nonempty(S)
  shows ¬UnboundedAbove(S)
proof
  intro unbounded
  obtain ⟨A, start⟩ := inhabited
  rcases compact with ⟨subset, extract⟩
  have realA : Real(A)
    unfold Real
    have subsetView := subset
    exact subsetView with A, start
  have sequence : RealSequence(escapingSequence(S, A))
    unfold RealSequence
    exact escapingSequence.function with subset, unbounded
  have terms := escapingSequence.terms with subset, unbounded, start
  obtain ⟨k, increasing, L, realL, member, converges⟩ :=
    extract with escapingSequence(S, A), sequence, terms
  have halfReal := half.real with realOne.real
  have halfPositive := half.positive with realOne.real, realZero.lt_one
  obtain ⟨N, naturalN, close⟩ := ConvergesTo.eventually with converges, halfPositive
  have typedN := nat.omega.backward with naturalN
  have nextN := Naturals.constructor.succ with typedN
  have nextNatural := nat.omega.forward with nextN
  have order : N ≤ succ(N) by exact LessEqual.successor at N with typedN
  have orderNext := LessEqual.reflexive with nextN
  have nearFirst := close with N, naturalN,
    LessEqual.reflexive with typedN
  have nearSecond := close with succ(N), nextNatural, order
  have selector := StrictlyIncreasingNat.function with increasing
  have indexFirst := FunctionBetween.apply_closed with selector, naturalN
  have indexSecond := FunctionBetween.apply_closed with selector, nextNatural
  have typedFirst := nat.omega.backward with indexFirst
  have typedSecond := nat.omega.backward with indexSecond
  have increasingAgain := increasing
  rcases increasing with ⟨selectorAgain, strict⟩
  have beforeNext : N < succ(N)
    unfold Less
    exact LessEqual.reflexive with nextN
  have firstBeforeSecond := strict with
    N, naturalN, succ(N), nextNatural, beforeNext
  have gap := escapingSequence.gap at S, A, k[N], k[succ(N)] with
    subset, unbounded, firstBeforeSecond
  have firstValue := subsequence.value at escapingSequence(S, A), k, N with
    sequence, increasingAgain
  have secondValue := subsequence.value at escapingSequence(S, A), k, succ(N) with
    sequence, increasingAgain
  rw firstValue at nearFirst
  rw secondValue at nearSecond
  have firstReal := RealSequence.value at escapingSequence(S, A), k[N] with sequence
  have secondReal := RealSequence.value at escapingSequence(S, A), k[succ(N)] with sequence
  have symmetric := openBall.symmetric.forward at
    escapingSequence(S, A)[k[N]], L, half(realOne) with
      firstReal, assumption, halfReal, nearFirst
  have across := openBall.triangle at
    escapingSequence(S, A)[k[succ(N)]], L,
    escapingSequence(S, A)[k[N]], half(realOne), half(realOne) with
      secondReal, assumption, firstReal, halfReal, halfReal,
      nearSecond, symmetric
  have doubled := half.add_self with realOne.real
  rw doubled at across
  obtain ⟨lower, upper⟩ := openBall.order_characterization.forward with across
  have cycle := realLess.transitive with gap, upper
  have impossible := realLess.characterization.forward with cycle
  exact RealLess.irreflexive with impossible

theorem SequentiallyCompact.bounded_above (S : Set)
  requires compact : SequentiallyCompact(S)
  requires inhabited : Nonempty(S)
  shows ∃ B ∈ ℝ, RealUpperBound(S, B)
proof
  have notUnbounded := SequentiallyCompact.not_unbounded_above with compact, inhabited
  by_contra noBound
  have unbounded : UnboundedAbove(S)
    intros B realB
    by_contra noAbove
    have upper : RealUpperBound(S, B)
      constructor
        exact realB
      . constructor
        . rcases compact with ⟨subset, extract⟩
          exact subset
        . intros X inS
          have realX : Real(X)
            rcases compact with ⟨subset, extract⟩
            unfold Real
            exact subset with X, inS
          have typedB : Real(B) by exact realB
          have weak : X ≤ B
            by_contra notWeak
            have strict := realLess.of_not_le with notWeak
            apply noAbove
            witness X
            refine ⟨inS, strict⟩
          have view := realLe.characterization.forward with weak
          rcases view with ⟨typedX, typedB, included⟩
          exact included
    apply noBound
    witness B
    refine ⟨realB, upper⟩
  exact notUnbounded with unbounded

-- ExtremeValue
theorem ContinuousOn.closed_interval_maximum (f : Set) (A B : Real)
  requires ordered : A ≤ B
  requires continuous : ContinuousOn(f, closedInterval(A, B))
  shows ∃ T ∈ closedInterval(A, B),
    ∀ X ∈ closedInterval(A, B),
      (f(X):R) ≤ (f(T):R)
proof
  have compact := closedInterval.continuous_image_compact with continuous
  have left := closedInterval.left_mem with ordered
  have imageLeft : f(A) ∈ realFunctionImage(f, closedInterval(A, B))
    apply realFunctionImage.membership.backward
    witness A
    refine ⟨left, rfl⟩
  have inhabited : Nonempty(realFunctionImage(f, closedInterval(A, B))) := ⟨f(A), imageLeft⟩
  obtain ⟨M, realM, upper⟩ := SequentiallyCompact.bounded_above with compact, inhabited
  exact ContinuousOn.closed_interval_maximum_of_upper_bound with ordered, continuous, upper

theorem SequentiallyCompact.has_minimum (S : Set)
  requires compact : SequentiallyCompact(S)
  requires inhabited : Nonempty(S)
  shows ∃ U ∈ S, ∀ X ∈ S, (U:R) ≤ (X:R)
proof
  rcases compact with ⟨subset, extract⟩
  have compactAgain : SequentiallyCompact(S) by refine ⟨subset, extract⟩
  have continuous := Continuous.continuous_on with realNeg.continuous, subset
  have negativeCompact := realFunctionImage.sequentially_compact with continuous, compactAgain
  obtain ⟨A, memberA⟩ := inhabited
  have negativeA : realNeg(A) ∈ realFunctionImage(realNeg, S)
    apply realFunctionImage.membership.backward
    witness A
    refine ⟨memberA, rfl⟩
  have negativeInhabited : Nonempty(realFunctionImage(realNeg, S)) := ⟨realNeg(A), negativeA⟩
  obtain ⟨B, realB, upper⟩ := SequentiallyCompact.bounded_above with negativeCompact, negativeInhabited
  obtain ⟨V, negativeMember, greatest⟩ := SequentiallyCompact.has_maximum_of_upper_bound with
    negativeCompact, negativeInhabited, upper
  obtain ⟨U, memberU, valueU⟩ := realFunctionImage.membership.forward with negativeMember
  witness U
  constructor
  . exact memberU
  . intros X memberX
    have negativeX : realNeg(X) ∈ realFunctionImage(realNeg, S)
      apply realFunctionImage.membership.backward
      witness X
      refine ⟨memberX, rfl⟩
    have bound := greatest with realNeg(X), negativeX
    have subsetView := subset
    have realU : Real(U)
      unfold Real
      exact subsetView with U, memberU
    have realX : Real(X)
      unfold Real
      exact subsetView with X, memberX
    have boundApplied : (realNeg(X):R) ≤ (realNeg(U):R) by rwa valueU
    have negView : -X ≤ -U
      exact boundApplied
    have reversed := realLe.neg_reverse at -X, -U with
      realNegValue.real at X with realX,
      realNegValue.real at U with realU,
      negView
    have involutiveU := realNegValue.involutive with realU
    have involutiveX := realNegValue.involutive with realX
    rwa [involutiveU, involutiveX] at reversed

theorem ContinuousOn.closed_interval_minimum (f : Set) (A B : Real)
  requires ordered : A ≤ B
  requires continuous : ContinuousOn(f, closedInterval(A, B))
  shows ∃ T ∈ closedInterval(A, B),
    ∀ X ∈ closedInterval(A, B),
      (f(T):R) ≤ (f(X):R)
proof
  have compact := closedInterval.continuous_image_compact with continuous
  have left := closedInterval.left_mem with ordered
  have imageLeft : f(A) ∈ realFunctionImage(f, closedInterval(A, B))
    apply realFunctionImage.membership.backward
    witness A
    refine ⟨left, rfl⟩
  have inhabited : Nonempty(realFunctionImage(f, closedInterval(A, B))) := ⟨f(A), imageLeft⟩
  obtain ⟨V, inImage, least⟩ := SequentiallyCompact.has_minimum with compact, inhabited
  obtain ⟨T, inInterval, value⟩ := realFunctionImage.membership.forward with inImage
  witness T
  constructor
  . exact inInterval
  . intros X inIntervalX
    have imageX : f(X) ∈ realFunctionImage(f, closedInterval(A, B))
      apply realFunctionImage.membership.backward
      witness X
      refine ⟨inIntervalX, rfl⟩
    have bound := least with f(X), imageX
    rwa value
