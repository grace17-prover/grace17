module Grace.Cumulus.Real.Analysis.CauchyMeanValue
import Derivative
import MeanValueIntegration

-- Section: Preparations
theorem ContinuousOn.of_differentiable (f S : Set)
  requires function : f : ℝ → ℝ
  requires subset : S ⊆ ℝ
  requires differentiable : ∀ X ∈ S, DifferentiableAt(f, X)
  shows ContinuousOn(f, S)
proof
  constructor
  . exact function
  . constructor
    . exact subset
    . intros X memberX
      have realX := subset with X, memberX
      have typedX : Real(X) by exact realX
      have differentiableAt := differentiable with X, memberX
      have hasDerivative := derivative.has_derivative_at with differentiableAt
      have continuousAt := HasDerivativeAt.continuous_at with hasDerivative
      exact ContinuousAt.continuous_within_at with continuousAt, subset

theorem DifferentiableAt.function (f : Set) (X : Real)
  requires differentiable : DifferentiableAt(f, X)
  shows f : ℝ → ℝ
proof
  obtain ⟨D, realD, hasDerivative⟩ := differentiable
  exact HasDerivativeAt.function with hasDerivative

-- Section: CauchyCombination
-- The function (g(B) - g(A)) f + (f(A) - f(B)) g takes the same value at A
-- and at B; Rolle's theorem applied to it is the Cauchy mean value theorem.
def cauchyCombination (f g : Set) (A B : Real) : Set :=
  pointwiseAdd(
    pointwiseMul(constantRealFunction(realSubValue(g(B), g(A))), f),
    pointwiseMul(constantRealFunction(realSubValue(f(A), f(B))), g))

theorem cauchyCombination.value (f g : Set) (A B X : Real)
  requires fFunction : f : ℝ → ℝ
  requires gFunction : g : ℝ → ℝ
  shows cauchyCombination(f, g, A, B)(X) =
    (g(B) - g(A)) * f(X) + (f(A) - f(B)) * g(X)
proof
  have realA : A ∈ ℝ by simp [Real]
  have realB : B ∈ ℝ by simp [Real]
  have realX : X ∈ ℝ by simp [Real]
  have typedFA : Real(f(A))
    exact FunctionBetween.apply_closed with fFunction, realA
  have typedFB : Real(f(B))
    exact FunctionBetween.apply_closed with fFunction, realB
  have typedFX : Real(f(X))
    exact FunctionBetween.apply_closed with fFunction, realX
  have typedGA : Real(g(A))
    exact FunctionBetween.apply_closed with gFunction, realA
  have typedGB : Real(g(B))
    exact FunctionBetween.apply_closed with gFunction, realB
  have typedGX : Real(g(X))
    exact FunctionBetween.apply_closed with gFunction, realX
  have typedWidthG := realSubValue.real with typedGB, typedGA
  have typedWidthF := realSubValue.real with typedFA, typedFB
  have widthGFunction := constantRealFunction.function with typedWidthG
  have widthFFunction := constantRealFunction.function with typedWidthF
  have leftFunction := pointwiseMul.function with widthGFunction, fFunction
  have rightFunction := pointwiseMul.function with widthFFunction, gFunction
  have typedWidthGX : Real(constantRealFunction(g(B) - g(A))(X))
    exact FunctionBetween.apply_closed with widthGFunction, realX
  have typedWidthFX : Real(constantRealFunction(f(A) - f(B))(X))
    exact FunctionBetween.apply_closed with widthFFunction, realX
  have leftValue := pointwiseMul.value at
    constantRealFunction(g(B) - g(A)), f, X with
      assumption, widthGFunction, fFunction, typedWidthGX, typedFX
  have rightValue := pointwiseMul.value at
    constantRealFunction(f(A) - f(B)), g, X with
      assumption, widthFFunction, gFunction, typedWidthFX, typedGX
  have typedLeft : Real(pointwiseMul(constantRealFunction(g(B) - g(A)), f)(X))
    exact FunctionBetween.apply_closed with leftFunction, realX
  have typedRight : Real(pointwiseMul(constantRealFunction(f(A) - f(B)), g)(X))
    exact FunctionBetween.apply_closed with rightFunction, realX
  have sum := pointwiseAdd.value at
    pointwiseMul(constantRealFunction(g(B) - g(A)), f),
    pointwiseMul(constantRealFunction(f(A) - f(B)), g),
    X with assumption, leftFunction, rightFunction, typedLeft, typedRight
  have widthGValue := constantRealFunction.value at g(B) - g(A), X with
    typedWidthG, assumption
  have widthFValue := constantRealFunction.value at f(A) - f(B), X with
    typedWidthF, assumption
  have equality : cauchyCombination(f, g, A, B)(X) =
      pointwiseMul(constantRealFunction(g(B) - g(A)), f)(X) +
        pointwiseMul(constantRealFunction(f(A) - f(B)), g)(X)
    simp [cauchyCombination]
  rwa [leftValue, rightValue, widthGValue, widthFValue] at equality

theorem cauchyCombination.endpoints (f g : Set) (A B : Real)
  requires fFunction : f : ℝ → ℝ
  requires gFunction : g : ℝ → ℝ
  shows cauchyCombination(f, g, A, B)(A) = cauchyCombination(f, g, A, B)(B)
proof
  have atA := cauchyCombination.value at f, g, A, B, A with fFunction, gFunction
  have atB := cauchyCombination.value at f, g, A, B, B with fFunction, gFunction
  have realA : A ∈ ℝ by simp [Real]
  have realB : B ∈ ℝ by simp [Real]
  have fA := FunctionBetween.apply_closed with fFunction, realA
  have fB := FunctionBetween.apply_closed with fFunction, realB
  have gA := FunctionBetween.apply_closed with gFunction, realA
  have gB := FunctionBetween.apply_closed with gFunction, realB
  rw [atA, atB]
  ring

theorem cauchyCombination.continuous_on (f g : Set) (A B : Real)
  requires continuousF : ContinuousOn(f, closedInterval(A, B))
  requires continuousG : ContinuousOn(g, closedInterval(A, B))
  shows ContinuousOn(cauchyCombination(f, g, A, B), closedInterval(A, B))
proof
  have fFunction : f : ℝ → ℝ
    rcases continuousF with ⟨graph, subset, everywhere⟩
    exact graph
  have gFunction : g : ℝ → ℝ
    rcases continuousG with ⟨graph, subset, everywhere⟩
    exact graph
  have realA : A ∈ ℝ by simp [Real]
  have realB : B ∈ ℝ by simp [Real]
  have typedFA : Real(f(A))
    exact FunctionBetween.apply_closed with fFunction, realA
  have typedFB : Real(f(B))
    exact FunctionBetween.apply_closed with fFunction, realB
  have typedGA : Real(g(A))
    exact FunctionBetween.apply_closed with gFunction, realA
  have typedGB : Real(g(B))
    exact FunctionBetween.apply_closed with gFunction, realB
  have typedWidthG := realSubValue.real with typedGB, typedGA
  have typedWidthF := realSubValue.real with typedFA, typedFB
  have subset := closedInterval.subset_reals at A, B with *
  have widthGContinuous := Continuous.continuous_on at
    constantRealFunction(g(B) - g(A)), closedInterval(A, B) with
      constantRealFunction.continuous at g(B) - g(A) with typedWidthG, subset
  have widthFContinuous := Continuous.continuous_on at
    constantRealFunction(f(A) - f(B)), closedInterval(A, B) with
      constantRealFunction.continuous at f(A) - f(B) with typedWidthF, subset
  have first := ContinuousOn.mul with widthGContinuous, continuousF
  have second := ContinuousOn.mul with widthFContinuous, continuousG
  unfold cauchyCombination
  exact ContinuousOn.add with first, second

theorem cauchyCombination.derivative (f g : Set) (A B C D E : Real)
  requires derivativeF : HasDerivativeAt(f, D, C)
  requires derivativeG : HasDerivativeAt(g, E, C)
  shows HasDerivativeAt(cauchyCombination(f, g, A, B),
    ((g(B):R) - (g(A):R)) * D + ((f(A):R) - (f(B):R)) * E, C)
proof
  have fFunction := HasDerivativeAt.function with derivativeF
  have gFunction := HasDerivativeAt.function with derivativeG
  have realA : A ∈ ℝ by simp [Real]
  have realB : B ∈ ℝ by simp [Real]
  have typedFA : Real(f(A))
    exact FunctionBetween.apply_closed with fFunction, realA
  have typedFB : Real(f(B))
    exact FunctionBetween.apply_closed with fFunction, realB
  have typedGA : Real(g(A))
    exact FunctionBetween.apply_closed with gFunction, realA
  have typedGB : Real(g(B))
    exact FunctionBetween.apply_closed with gFunction, realB
  have typedWidthG := realSubValue.real with typedGB, typedGA
  have typedWidthF := realSubValue.real with typedFA, typedFB
  have first := HasDerivativeAt.scale at f, g(B) - g(A), D, C with
    typedWidthG, derivativeF
  have second := HasDerivativeAt.scale at g, f(A) - f(B), E, C with
    typedWidthF, derivativeG
  unfold cauchyCombination
  exact HasDerivativeAt.add with first, second

-- Section: CauchyMeanValue
-- The Cauchy mean value theorem: for f and g continuous on [A, B] and
-- differentiable inside, some C between A and B has
-- f′(C) (g(B) − g(A)) = g′(C) (f(B) − f(A)).
theorem CauchyMeanValue.theorem (f g : ℝ → ℝ) (A B : Real)
  requires ordered : A < B
  requires continuousF : ContinuousOn(f, closedInterval(A, B))
  requires continuousG : ContinuousOn(g, closedInterval(A, B))
  requires differentiableF : ∀ C ∈ ℝ, A < C → C < B → DifferentiableAt(f, C)
  requires differentiableG : ∀ C ∈ ℝ, A < C → C < B → DifferentiableAt(g, C)
  shows ∃ C ∈ ℝ, A < C ∧ C < B ∧
    f′(C) * (g(B) - g(A)) = g′(C) * (f(B) - f(A))
proof
  have fFunction : f : ℝ → ℝ by assumption
  have gFunction : g : ℝ → ℝ by assumption
  have realA : A ∈ ℝ by simp [Real]
  have realB : B ∈ ℝ by simp [Real]
  have typedFA : Real(f(A))
    exact FunctionBetween.apply_closed with fFunction, realA
  have typedFB : Real(f(B))
    exact FunctionBetween.apply_closed with fFunction, realB
  have typedGA : Real(g(A))
    exact FunctionBetween.apply_closed with gFunction, realA
  have typedGB : Real(g(B))
    exact FunctionBetween.apply_closed with gFunction, realB
  have continuous := cauchyCombination.continuous_on with
    continuousF, continuousG
  have endpoints := cauchyCombination.endpoints at f, g, A, B with
    fFunction, gFunction
  have differentiable : ∀ C ∈ ℝ, A < C → C < B →
      ∃ D ∈ ℝ, HasDerivativeAt(cauchyCombination(f, g, A, B), D, C)
    intros C realC left right
    have typedC : Real(C) by exact realC
    have differentiableAtF := differentiableF with C, realC, left, right
    have differentiableAtG := differentiableG with C, realC, left, right
    have derivativeF := derivative.has_derivative_at with differentiableAtF
    have derivativeG := derivative.has_derivative_at with differentiableAtG
    have typedF := derivative.real at f, C
    have typedG := derivative.real at g, C
    have combined := cauchyCombination.derivative at
      f, g, A, B, C, derivative(f)(C), derivative(g)(C) with
        typedF, typedG, derivativeF, derivativeG
    have typedValue : Real((g(B) - g(A)) * derivative(f)(C) +
        (f(A) - f(B)) * derivative(g)(C))
      typecheck
    witness (g(B) - g(A)) * derivative(f)(C) + (f(A) - f(B)) * derivative(g)(C)
    refine ⟨typedValue, combined⟩
  obtain ⟨T, realT, left, right, zeroDerivative⟩ := Rolle.theorem with
    ordered, continuous, endpoints, differentiable
  have typedT : Real(T) by exact realT
  have differentiableAtF := differentiableF with T, realT, left, right
  have differentiableAtG := differentiableG with T, realT, left, right
  have derivativeF := derivative.has_derivative_at with differentiableAtF
  have derivativeG := derivative.has_derivative_at with differentiableAtG
  have typedF := derivative.real at f, T
  have typedG := derivative.real at g, T
  have combined := cauchyCombination.derivative at
    f, g, A, B, T, derivative(f)(T), derivative(g)(T) with
      typedF, typedG, derivativeF, derivativeG
  have vanishes := HasDerivativeAt.unique with combined, zeroDerivative
  witness T
  refine ⟨realT, left, right, _⟩
  linear_combination vanishes

-- The mean value theorem and Rolle's theorem in terms of the derivative.
theorem MeanValue.derivative (f : ℝ → ℝ) (A B : Real)
  requires ordered : A < B
  requires continuous : ContinuousOn(f, closedInterval(A, B))
  requires differentiable : ∀ C ∈ ℝ, A < C → C < B → DifferentiableAt(f, C)
  shows ∃ C ∈ ℝ, A < C ∧ C < B ∧ f′(C) * (B - A) = f(B) - f(A)
proof
  have unfolded : ∀ C ∈ ℝ, A < C → C < B → ∃ D ∈ ℝ, HasDerivativeAt(f, D, C)
    intros C realC left right
    have differentiableAt := differentiable with C, realC, left, right
    unfold DifferentiableAt at differentiableAt
    exact differentiableAt
  obtain ⟨T, realT, left, right, D, realD, hasDerivative, equation⟩ :=
    MeanValue.theorem with ordered, continuous, unfolded
  have value := derivative.of_has_derivative with hasDerivative
  witness T
  refine ⟨realT, left, right, _⟩
  rwa value
