module Grace.Cumulus.Real.Analysis.IntermediateValue
import Intervals

-- The points of the interval where f stays below the target value.
def belowPoints (f : Set) (A B V : Real) : Set :=
  { X ∈ closedInterval(A, B) | (f(X):R) < V }

theorem belowPoints.membership (f X : Set) (A B V : Real)
  shows X ∈ belowPoints(f, A, B, V) ↔ (X ∈ closedInterval(A, B) ∧ (f(X):R) < V)
proof
  simp

-- A continuous function on [A, B] that starts below V and ends above it takes
-- the value V. The point is the supremum C of the set where f < V: if f(C)
-- were below V, continuity would put a point to the right of C into that set;
-- if f(C) were above V, every point of the set would sit below C minus some
-- positive margin, so C would not be the least upper bound.
theorem closedInterval.intermediate_value (f : Set) (A B V : Real)
  requires ordered : A ≤ B
  requires continuous : ContinuousOn(f, closedInterval(A, B))
  requires below : (f(A):R) < V
  requires above : V < (f(B):R)
  shows ∃ C ∈ closedInterval(A, B), f(C) = V
proof
  rcases continuous with ⟨function, subset, pointwise⟩
  have leftMember := closedInterval.left_mem with *
  have rightMember := closedInterval.right_mem with *
  have aData : A ∈ closedInterval(A, B) ∧ (f(A):R) < V
    constructor
    . exact leftMember
    . exact below
  have aIn : A ∈ belowPoints(f, A, B, V)
    exact belowPoints.membership.backward with *
  have inhabited : Nonempty(belowPoints(f, A, B, V)) := ⟨A, aIn⟩
  have pointsReal : belowPoints(f, A, B, V) ⊆ ℝ
    intros X member
    obtain ⟨inInterval, negative⟩ := belowPoints.membership.forward with member
    obtain ⟨realX, lowerX, upperX⟩ := closedInterval.membership.forward with inInterval
    exact realX
  have upper : RealUpperBound(belowPoints(f, A, B, V), B)
    unfold RealUpperBound
    have typedB : Real(B) by assumption
    refine ⟨typedB, pointsReal, _⟩
    intros X member
    obtain ⟨inInterval, negative⟩ := belowPoints.membership.forward with member
    obtain ⟨realX, lowerX, upperX⟩ := closedInterval.membership.forward with inInterval
    exact realLe.subset with *
  have bounded : ∃ D, RealUpperBound(belowPoints(f, A, B, V), D) := ⟨B, upper⟩
  obtain ⟨C, lubC⟩ := Real.least_upper_bound_property at belowPoints(f, A, B, V) with *
  rcases lubC with ⟨⟨typedC, pointsSubset, boundsC⟩, leastC⟩
  have realC : C ∈ ℝ by exact typedC
  have aSubset := boundsC with A, aIn
  have aLe := realLe.of_subset at A, C with *
  have cSubset := leastC with B, upper
  have cLe := realLe.of_subset at C, B with *
  have cData : C ∈ ℝ ∧ A ≤ C ∧ C ≤ B by refine ⟨realC, aLe, cLe⟩
  have cIn : C ∈ closedInterval(A, B)
    exact closedInterval.membership.backward with *
  have within := pointwise with C, cIn
  witness C
  constructor
  . exact cIn
  . have split : (f(C):R) < V ∨ ¬((f(C):R) < V)
      tauto
    cases split with lowC | notLow
    . exfalso
      have gap : 0 < V - (f(C):R) by linarith
      obtain ⟨D, realD, positiveD, maps⟩ :=
        ContinuousWithinAt.maps_ball with *
      have halfPositive := half.positive at D with *
      have halfLess := half.lt_self at D with *
      have reach : C + half(D) ≤ B ∨ ¬(C + half(D) ≤ B) by tauto
      cases reach with inside | outside
      . have xReal := realAddValue.real at C, half(D) with *
        have xMember : C + half(D) ∈ ℝ by exact xReal
        have xData : C + half(D) ∈ ℝ ∧ A ≤ C + half(D) ∧ C + half(D) ≤ B
          refine ⟨xMember, _, inside⟩
          linarith
        have xIn : C + half(D) ∈ closedInterval(A, B)
          exact closedInterval.membership.backward with *
        have nearData : C - D < C + half(D) ∧ C + half(D) < C + D
          constructor
          . linarith
          . linarith
        have near : C + half(D) ∈ openBall(C, D)
          exact openBall.order_characterization.backward with *
        have mapped := maps with C + half(D), xIn, near
        obtain ⟨lowerBound, upperBound⟩ := openBall.order_characterization.forward with mapped
        have xLow : (f(C + half(D)):R) < V by linarith
        have xPointData : C + half(D) ∈ closedInterval(A, B) ∧ (f(C + half(D)):R) < V
          constructor
          . exact xIn
          . exact xLow
        have xInPoints : C + half(D) ∈ belowPoints(f, A, B, V)
          exact belowPoints.membership.backward with *
        have xSubset := boundsC with C + half(D), xInPoints
        have xLe := realLe.of_subset at C + half(D), C with *
        linarith
      . have bLess := realLess.of_not_le with *
        have nearData : C - D < B ∧ B < C + D
          constructor
          . linarith
          . linarith
        have near : B ∈ openBall(C, D)
          exact openBall.order_characterization.backward with *
        have mapped := maps with B, rightMember, near
        obtain ⟨lowerBound, upperBound⟩ := openBall.order_characterization.forward with mapped
        linarith
    . have notBelow := realLe.of_not_less with *
      have split2 : V < (f(C):R) ∨ ¬(V < (f(C):R)) by tauto
      cases split2 with highC | notHigh
      . exfalso
        have gap : 0 < (f(C):R) - V by linarith
        obtain ⟨D, realD, positiveD, maps⟩ :=
          ContinuousWithinAt.maps_ball with *
        have halfPositive := half.positive at D with *
        have halfLess := half.lt_self at D with *
        have marginReal := realSubValue.real at C, half(D) with *
        have smallerUpper : RealUpperBound(belowPoints(f, A, B, V), C - half(D))
          unfold RealUpperBound
          refine ⟨marginReal, pointsReal, _⟩
          intros X member
          obtain ⟨xIn, xLow⟩ := belowPoints.membership.forward with member
          obtain ⟨xMember, lowerX, upperX⟩ := closedInterval.membership.forward with xIn
          have xSubsetC := boundsC with X, member
          have xLeC := realLe.of_subset at X, C with *
          have xLe : X ≤ C - half(D)
            by_contra notLe
            have far := realLess.of_not_le with *
            have nearData : C - D < X ∧ X < C + D
              constructor
              . linarith
              . linarith
            have near : X ∈ openBall(C, D)
              exact openBall.order_characterization.backward with *
            have mapped := maps with X, xIn, near
            obtain ⟨lowerBound, upperBound⟩ := openBall.order_characterization.forward with mapped
            linarith
          exact realLe.subset with *
        have cSubsetSmaller := leastC with C - half(D), smallerUpper
        have cLeSmaller := realLe.of_subset at C, C - half(D) with *
        linarith
      . have notAbove := realLe.of_not_less at f(C), V with *
        exact realLe.antisymmetric with *

-- The usual statement with weak inequalities at the endpoints.
theorem closedInterval.intermediate_value_le (f : Set) (A B V : Real)
  requires ordered : A ≤ B
  requires continuous : ContinuousOn(f, closedInterval(A, B))
  requires below : (f(A):R) ≤ V
  requires above : V ≤ (f(B):R)
  shows ∃ C ∈ closedInterval(A, B), f(C) = V
proof
  have leftMember := closedInterval.left_mem at A, B with *
  have rightMember := closedInterval.right_mem at A, B with *
  have function : f : ℝ → ℝ
    rcases continuous with ⟨function, subset, pointwise⟩
    exact function
  have leftCase : (f(A):R) = V ∨ ¬((f(A):R) = V) by tauto
  cases leftCase with leftEqual | leftDifferent
  . refine ⟨A, leftMember, leftEqual⟩
  . have rightCase : (f(B):R) = V ∨ ¬((f(B):R) = V)
      tauto
    cases rightCase with rightEqual | rightDifferent
    . refine ⟨B, rightMember, rightEqual⟩
    . have strictBelow : (f(A):R) < V
        have notLe : ¬(V ≤ (f(A):R))
          intro le
          have equal := realLe.antisymmetric at f(A), V with *
          exact leftDifferent with equal
        exact realLess.of_not_le with *
      have strictAbove : V < (f(B):R)
        have notLe : ¬((f(B):R) ≤ V)
          intro le
          have equal := realLe.antisymmetric at f(B), V with *
          exact rightDifferent with equal
        exact realLess.of_not_le with *
      exact closedInterval.intermediate_value with *

-- A continuous function that changes sign on [A, B] has a zero there.
theorem closedInterval.zero_of_sign_change (f : Set) (A B : Real)
  requires ordered : A ≤ B
  requires continuous : ContinuousOn(f, closedInterval(A, B))
  requires negative : (f(A):R) < 0
  requires positive : 0 < (f(B):R)
  shows ∃ C ∈ closedInterval(A, B), f(C) = (0:R)
proof
  exact closedInterval.intermediate_value with *
