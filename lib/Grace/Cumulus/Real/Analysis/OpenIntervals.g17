-- Open and half-open intervals of the real line, with their membership laws,
-- their inclusion in the closed interval with the same endpoints, and the
-- open balls inside an open interval
-- Part of Cumulus, the Grace17 mathematics library.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module Grace.Cumulus.Real.Analysis.OpenIntervals
import Intervals

def openInterval (A B : Real) : Set := { X ∈ ℝ | A < X ∧ X < B }
def leftOpenInterval (A B : Real) : Set := { X ∈ ℝ | A < X ∧ X ≤ B }
def rightOpenInterval (A B : Real) : Set := { X ∈ ℝ | A ≤ X ∧ X < B }

theorem openInterval.membership (X : Set) (A B : Real)
  shows X ∈ openInterval(A, B) ↔ (X ∈ ℝ ∧ A < X ∧ X < B)
proof
  simp [openInterval]

theorem leftOpenInterval.membership (X : Set) (A B : Real)
  shows X ∈ leftOpenInterval(A, B) ↔ (X ∈ ℝ ∧ A < X ∧ X ≤ B)
proof
  simp [leftOpenInterval]

theorem rightOpenInterval.membership (X : Set) (A B : Real)
  shows X ∈ rightOpenInterval(A, B) ↔ (X ∈ ℝ ∧ A ≤ X ∧ X < B)
proof
  simp [rightOpenInterval]

theorem openInterval.subset_closed (A B : Real)
  shows openInterval(A, B) ⊆ closedInterval(A, B)
proof
  intros X hX
  obtain ⟨real, lower, upper⟩ := openInterval.membership.forward with hX
  apply closedInterval.membership.backward
  exact ⟨real, ⟨realLess.implies_le with lower, realLess.implies_le with upper⟩⟩

theorem leftOpenInterval.subset_closed (A B : Real)
  shows leftOpenInterval(A, B) ⊆ closedInterval(A, B)
proof
  intros X hX
  obtain ⟨real, lower, upper⟩ := leftOpenInterval.membership.forward with hX
  apply closedInterval.membership.backward
  exact ⟨real, ⟨realLess.implies_le with lower, upper⟩⟩

theorem rightOpenInterval.subset_closed (A B : Real)
  shows rightOpenInterval(A, B) ⊆ closedInterval(A, B)
proof
  intros X hX
  obtain ⟨real, lower, upper⟩ := rightOpenInterval.membership.forward with hX
  apply closedInterval.membership.backward
  exact ⟨real, ⟨lower, realLess.implies_le with upper⟩⟩

theorem openInterval.subset_left_open (A B : Real)
  shows openInterval(A, B) ⊆ leftOpenInterval(A, B)
proof
  intros X hX
  obtain ⟨real, lower, upper⟩ := openInterval.membership.forward with hX
  apply leftOpenInterval.membership.backward
  exact ⟨real, ⟨lower, realLess.implies_le with upper⟩⟩

theorem openInterval.subset_right_open (A B : Real)
  shows openInterval(A, B) ⊆ rightOpenInterval(A, B)
proof
  intros X hX
  obtain ⟨real, lower, upper⟩ := openInterval.membership.forward with hX
  apply rightOpenInterval.membership.backward
  exact ⟨real, ⟨realLess.implies_le with lower, upper⟩⟩

theorem openInterval.empty_of_le (A B : Real)
  requires le : B ≤ A
  shows openInterval(A, B) = ∅
proof
  ext X
  constructor
  . intro hX
    obtain ⟨real, lower, upper⟩ := openInterval.membership.forward with hX
    exfalso
    linarith
  . intro hX
    exfalso
    simpa using hX

theorem openInterval.subset_reals (A B : Real)
  shows openInterval(A, B) ⊆ ℝ
proof
  intros X hX
  obtain ⟨real, lower, upper⟩ := openInterval.membership.forward with hX
  exact real

-- A ball that stays between the endpoints lies in the interval.
theorem openInterval.ball_subset (A B X E : Real)
  requires lower : A ≤ X - E
  requires upper : X + E ≤ B
  shows openBall(X, E) ⊆ openInterval(A, B)
proof
  intros Y hY
  obtain ⟨realY, near⟩ := openBall.membership.forward with hY
  obtain ⟨lowerY, upperY⟩ := openBall.order_characterization.forward with hY
  apply openInterval.membership.backward
  refine ⟨realY, ?_, ?_⟩
  . linarith
  . linarith
