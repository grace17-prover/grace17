-- Riemann integrals of bounded functions pieced together: changing a
-- function at the endpoints keeps its integral, integrals over adjacent
-- intervals add, and a bounded function continuous on the open cells of a
-- partition is integrable, with the fundamental theorem cell by cell.
-- Part of Cumulus, the Grace17 mathematics library.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module Grace.Cumulus.Real.Analysis.Integration.Piecewise
import FTCFirst

-- Changing a function at the endpoints

-- Before the last cell, a tagged sum of f − g picks up at most the first
-- cell when f = g strictly inside (A, B) and f − g ≤ K on [A, B].
theorem riemannSum.interior_prefix (f g p t : Set) (A B K D : Real, N n : Nat)
  requires functionF : f : ℝ → ℝ
  requires functionG : g : ℝ → ℝ
  requires tagged : TaggedPartition(p, t, A, B, N)
  requires fine : FinePartition(p, A, B, N, D)
  requires bound : ∀ x ∈ closedInterval(A, B), f(x) - g(x) ≤ K
  requires nonnegative : 0 ≤ K
  requires agree : ∀ x ∈ ℝ, A < x → x < B → f(x) = g(x)
  shows n < N → riemannSum(f, p, t, n) - riemannSum(g, p, t, n) ≤ K * D
proof
  induction n
  | zero =>
    intro before
    obtain ⟨_, dPositive, _⟩ := fine
    rw [riemannSum.zero, riemannSum.zero]
    have zeroLe : (0:R) ≤ D by linarith
    have product := realLe.mul_left_of_nonnegative at (0:R), D, K
      with zeroLe, nonnegative
    have zeroProduct : K * (0:R) = (0:R) by ring
    have zeroDifference : (0:R) - (0:R) = (0:R) by ring
    rw zeroDifference
    linarith
  | succ(m) using ih =>
    intro before
    obtain ⟨partition, tags, cells⟩ := tagged
    obtain ⟨points, start, finish, increasing⟩ := partition
    obtain ⟨_, dPositive, widths⟩ := fine
    have mBefore : m < N by arith
    have previous := ih with mBefore
    have sumF := riemannSum.real at f, p, t, m with functionF, points, tags
    have sumG := riemannSum.real at g, p, t, m with functionG, points, tags
    have stepF := riemannSum.succ at f, p, t, m with functionF, points, tags
    have stepG := riemannSum.succ at g, p, t, m with functionG, points, tags
    have mMember : m ∈ ℕ by typecheck
    have tagReal := RealSequence.value at t, m with tags
    have tagMember : t[m] ∈ ℝ by exact tagReal
    have fTag := FunctionBetween.apply_closed with functionF, tagMember
    have gTag := FunctionBetween.apply_closed with functionG, tagMember
    have fTagReal : Real(f(t[m])) by exact fTag
    have gTagReal : Real(g(t[m])) by exact gTag
    have left := RealSequence.value at p, m with points
    have right := RealSequence.value at p, succ(m) with points
    have width := widths with m, mMember, mBefore
    have positiveWidth := increasing with m, mMember, mBefore
    obtain ⟨tagLower, tagUpper⟩ := TaggedPartition.tag_bounds at p, t, A, B, N,
      m with ⟨⟨points, start, finish, increasing⟩, tags, cells⟩, mBefore
    rw [stepF, stepG]
    have alternatives := natural.zero_or_successor at m
    cases alternatives with zero | successor
    . -- the first cell
      have mLe : m ≤ N by arith
      have succLe : succ(m) ≤ N by arith
      obtain ⟨atLeast, _⟩ := IntervalPartition.point_bounds at p, A, B, N, m
        with ⟨points, start, finish, increasing⟩, mLe
      obtain ⟨_, atMost⟩ := IntervalPartition.point_bounds at p, A, B, N,
        succ(m) with ⟨points, start, finish, increasing⟩, succLe
      have inside : t[m] ∈ closedInterval(A, B)
        apply closedInterval.membership.backward
        refine ⟨tagMember, ?_, ?_⟩
        . linarith
        . linarith
      have difference := bound with t[m], inside
      have widthNonnegative : (0:R) ≤ p[succ(m)] - p[m] by linarith
      have scaled := realLe.mul_right_of_nonnegative
        at f(t[m]) - g(t[m]), K, p[succ(m)] - p[m]
        with difference, widthNonnegative
      have widthLe : p[succ(m)] - p[m] ≤ D by linarith
      have capped := realLe.mul_left_of_nonnegative
        at p[succ(m)] - p[m], D, K with widthLe, nonnegative
      have expand : realAddValue(riemannSum(f, p, t, m),
          realMulValue(f(t[m]), realSubValue(p[succ(m)], p[m]))) -
          realAddValue(riemannSum(g, p, t, m),
          realMulValue(g(t[m]), realSubValue(p[succ(m)], p[m]))) =
          riemannSum(f, p, t, m) - riemannSum(g, p, t, m) +
            (f(t[m]) - g(t[m])) * (p[succ(m)] - p[m])
        ring
      rw [expand, zero, riemannSum.zero, riemannSum.zero]
      rw zero at scaled, capped
      linarith
    . -- a middle cell: the tag lies strictly inside (A, B)
      obtain ⟨k, kNat, shape⟩ := successor
      have zeroBefore : 0 < m by arith
      have succBound : succ(m) ≤ N by arith
      have nBound : N ≤ N by arith
      have mLe : m ≤ N by arith
      have afterStart := IntervalPartition.strict_indices at p, A, B, N, 0, m
        with ⟨points, start, finish, increasing⟩, zeroBefore, mLe
      have beforeEnd := IntervalPartition.strict_indices at p, A, B, N,
        succ(m), N with ⟨points, start, finish, increasing⟩, before, nBound
      rw [start] at afterStart
      rw [finish] at beforeEnd
      have tagAbove : A < t[m] by linarith
      have tagBelow : t[m] < B by linarith
      have same := agree with t[m], tagMember, tagAbove, tagBelow
      have expand : realAddValue(riemannSum(f, p, t, m),
          realMulValue(f(t[m]), realSubValue(p[succ(m)], p[m]))) -
          realAddValue(riemannSum(g, p, t, m),
          realMulValue(g(t[m]), realSubValue(p[succ(m)], p[m]))) =
          riemannSum(f, p, t, m) - riemannSum(g, p, t, m) +
            (f(t[m]) - g(t[m])) * (p[succ(m)] - p[m])
        ring
      rw [expand, same]
      have vanish : (g(t[m]) - g(t[m])) * (p[succ(m)] - p[m]) = (0:R)
        by ring
      rw vanish
      linarith

-- On a δ-fine tagged partition, the tagged sums of f and g differ by at most
-- 2Kδ when f = g strictly inside (A, B) and f − g ≤ K on [A, B].
theorem riemannSum.interior_difference (f g p t : Set) (A B K D : Real, N : Nat)
  requires functionF : f : ℝ → ℝ
  requires functionG : g : ℝ → ℝ
  requires tagged : TaggedPartition(p, t, A, B, N)
  requires fine : FinePartition(p, A, B, N, D)
  requires bound : ∀ x ∈ closedInterval(A, B), f(x) - g(x) ≤ K
  requires nonnegative : 0 ≤ K
  requires agree : ∀ x ∈ ℝ, A < x → x < B → f(x) = g(x)
  shows riemannSum(f, p, t, N) - riemannSum(g, p, t, N) ≤ K * D + K * D
proof
  have taggedCopy := tagged
  have fineCopy := fine
  obtain ⟨partition, tags, cells⟩ := tagged
  obtain ⟨points, start, finish, increasing⟩ := partition
  obtain ⟨_, dPositive, widths⟩ := fine
  have zeroLe : (0:R) ≤ D by linarith
  have product := realLe.mul_left_of_nonnegative at (0:R), D, K
    with zeroLe, nonnegative
  have zeroProduct : K * (0:R) = (0:R) by ring
  have alternatives := natural.zero_or_successor at N
  cases alternatives with zero | successor
  . rw [zero, riemannSum.zero, riemannSum.zero]
    have zeroDifference : (0:R) - (0:R) = (0:R) by ring
    rw zeroDifference
    linarith
  obtain ⟨M, mNat, shape⟩ := successor
  have before : M < N by arith
  have prefix := riemannSum.interior_prefix at f, g, p, t, A, B, K, D, N, M
    with functionF, functionG, taggedCopy, fineCopy, bound, nonnegative, agree
  have earlier := prefix with before
  have sumF := riemannSum.real at f, p, t, M with functionF, points, tags
  have sumG := riemannSum.real at g, p, t, M with functionG, points, tags
  have stepF := riemannSum.succ at f, p, t, M with functionF, points, tags
  have stepG := riemannSum.succ at g, p, t, M with functionG, points, tags
  have mMember : M ∈ ℕ by typecheck
  have tagReal := RealSequence.value at t, M with tags
  have tagMember : t[M] ∈ ℝ by exact tagReal
  have fTag := FunctionBetween.apply_closed with functionF, tagMember
  have gTag := FunctionBetween.apply_closed with functionG, tagMember
  have fTagReal : Real(f(t[M])) by exact fTag
  have gTagReal : Real(g(t[M])) by exact gTag
  have left := RealSequence.value at p, M with points
  have right := RealSequence.value at p, succ(M) with points
  have width := widths with M, mMember, before
  have positiveWidth := increasing with M, mMember, before
  obtain ⟨tagLower, tagUpper⟩ := TaggedPartition.tag_bounds at p, t, A, B, N,
    M with ⟨⟨points, start, finish, increasing⟩, tags, cells⟩, before
  have mLe : M ≤ N by arith
  have succLe : succ(M) ≤ N by arith
  obtain ⟨atLeast, _⟩ := IntervalPartition.point_bounds at p, A, B, N, M
    with ⟨points, start, finish, increasing⟩, mLe
  obtain ⟨_, atMost⟩ := IntervalPartition.point_bounds at p, A, B, N,
    succ(M) with ⟨points, start, finish, increasing⟩, succLe
  have inside : t[M] ∈ closedInterval(A, B)
    apply closedInterval.membership.backward
    refine ⟨tagMember, ?_, ?_⟩
    . linarith
    . linarith
  have difference := bound with t[M], inside
  have widthNonnegative : (0:R) ≤ p[succ(M)] - p[M] by linarith
  have scaled := realLe.mul_right_of_nonnegative
    at f(t[M]) - g(t[M]), K, p[succ(M)] - p[M]
    with difference, widthNonnegative
  have widthLe : p[succ(M)] - p[M] ≤ D by linarith
  have capped := realLe.mul_left_of_nonnegative
    at p[succ(M)] - p[M], D, K with widthLe, nonnegative
  have expand : realAddValue(riemannSum(f, p, t, M),
      realMulValue(f(t[M]), realSubValue(p[succ(M)], p[M]))) -
      realAddValue(riemannSum(g, p, t, M),
      realMulValue(g(t[M]), realSubValue(p[succ(M)], p[M]))) =
      riemannSum(f, p, t, M) - riemannSum(g, p, t, M) +
        (f(t[M]) - g(t[M])) * (p[succ(M)] - p[M])
    ring
  rw [shape, stepF, stepG, expand]
  linarith

theorem HasRiemannIntegral.congr_interior (f g : Set) (A B I : Real)
  requires integral : HasRiemannIntegral(g, A, B, I)
  requires function : f : ℝ → ℝ
  requires agree : ∀ x ∈ ℝ, A < x → x < B → f(x) = g(x)
  shows HasRiemannIntegral(f, A, B, I)
proof
  obtain ⟨functionG, ordered, control⟩ := integral
  have aMember : A ∈ ℝ by typecheck
  have bMember : B ∈ ℝ by typecheck
  have fA := FunctionBetween.apply_closed with function, aMember
  have gA := FunctionBetween.apply_closed with functionG, aMember
  have fB := FunctionBetween.apply_closed with function, bMember
  have gB := FunctionBetween.apply_closed with functionG, bMember
  have fAReal : Real(f(A)) by exact fA
  have gAReal : Real(g(A)) by exact gA
  have fBReal : Real(f(B)) by exact fB
  have gBReal : Real(g(B)) by exact gB
  have absA := abs.nonnegative at f(A) - g(A)
  have absB := abs.nonnegative at f(B) - g(B)
  have upperA := abs.upper at f(A) - g(A)
  have upperB := abs.upper at f(B) - g(B)
  have lowerA := abs.upper_neg at f(A) - g(A)
  have lowerB := abs.upper_neg at f(B) - g(B)
  have absAReal := abs.real at f(A) - g(A)
  have absBReal := abs.real at f(B) - g(B)
  have nonnegative : 0 ≤ abs(f(A) - g(A)) + abs(f(B) - g(B)) by linarith
  -- On [A, B], f − g is 0 inside and bounded by K at the endpoints.
  have cases : ∀ x ∈ closedInterval(A, B), x = A ∨ x = B ∨ f(x) = g(x)
    intros x inside
    obtain ⟨xMember, lower, upper⟩ := closedInterval.membership.forward
      with inside
    have xReal : Real(x) by exact xMember
    have first := realLess.trichotomy at A, x
    rcases first with above | same | below
    . have second := realLess.trichotomy at x, B
      rcases second with inner | atB | beyond
      . right
        right
        exact agree with x, xMember, above, inner
      . right
        left
        exact atB
      . exfalso
        linarith
    . left
      rw same
    . exfalso
      linarith
  have boundFG : ∀ x ∈ closedInterval(A, B),
      f(x) - g(x) ≤ abs(f(A) - g(A)) + abs(f(B) - g(B))
    intros x inside
    have alternatives := cases with x, inside
    rcases alternatives with atA | atB | inner
    . rw atA
      linarith
    . rw atB
      linarith
    . rw inner
      obtain ⟨xMember, _, _⟩ := closedInterval.membership.forward with inside
      have gX := FunctionBetween.apply_closed with functionG, xMember
      have gXReal : Real(g(x)) by exact gX
      linarith
  have boundGF : ∀ x ∈ closedInterval(A, B),
      g(x) - f(x) ≤ abs(f(A) - g(A)) + abs(f(B) - g(B))
    intros x inside
    have alternatives := cases with x, inside
    rcases alternatives with atA | atB | inner
    . rw atA
      linarith
    . rw atB
      linarith
    . rw inner
      obtain ⟨xMember, _, _⟩ := closedInterval.membership.forward with inside
      have gX := FunctionBetween.apply_closed with functionG, xMember
      have gXReal : Real(g(x)) by exact gX
      linarith
  have agreeBack : ∀ x ∈ ℝ, A < x → x < B → g(x) = f(x)
    intros x xMember lower upper
    have value := agree with x, xMember, lower, upper
    rw value
  refine ⟨function, ordered, ?_⟩
  intros E eMember positive
  have eReal : Real(E) by exact eMember
  have halfPositive := half.positive with positive
  have halfReal := half.real at E
  have quarterReal := half.real at half(E)
  have halves := half.add_self at E
  have quarters := half.add_self at half(E)
  obtain ⟨R, rMember, rPositive, estimate⟩ := control with half(E),
    halfReal, halfPositive
  have shifted : 0 < abs(f(A) - g(A)) + abs(f(B) - g(B)) + 1 by linarith
  have radius := scaledRadius.real at half(E),
    abs(f(A) - g(A)) + abs(f(B) - g(B)) + 1
  have radiusPositive := scaledRadius.positive with halfPositive, shifted
  have cancel := scaledRadius.cancel at half(E),
    abs(f(A) - g(A)) + abs(f(B) - g(B)) + 1 with shifted
  have rReal : Real(R) by exact rMember
  obtain ⟨D, dMember, dPositive, dR, dRadius⟩ := positiveRadius.common
    with rPositive, radiusPositive
  have dReal : Real(D) by exact dMember
  refine ⟨D, dMember, dPositive, ?_⟩
  intros p t N nMember tagged fine
  have nNat := nat.omega.backward with nMember
  have fineR := FinePartition.weaken with fine, dR
  have near := estimate with p, t, N, nMember, tagged, fineR
  have above := riemannSum.interior_difference with function, functionG,
    tagged, fine, boundFG, nonnegative, agree
  have below := riemannSum.interior_difference with functionG, function,
    tagged, fine, boundGF, nonnegative, agreeBack
  obtain ⟨⟨points, _, _, _⟩, tags, _⟩ := tagged
  have sumF := riemannSum.real at f, p, t, N with function, points, tags
  have sumG := riemannSum.real at g, p, t, N with functionG, points, tags
  unfold dist at near
  have nearUpper := abs.upper at riemannSum(g, p, t, N) - I
  have nearLower := abs.upper_neg at riemannSum(g, p, t, N) - I
  have distanceReal := abs.real at riemannSum(g, p, t, N) - I
  have smaller := realLe.mul_left_of_nonnegative at D,
    scaledRadius(half(E), abs(f(A) - g(A)) + abs(f(B) - g(B)) + 1),
    abs(f(A) - g(A)) + abs(f(B) - g(B)) with dRadius, nonnegative
  have radiusNonnegative : (0:R) ≤ scaledRadius(half(E),
      abs(f(A) - g(A)) + abs(f(B) - g(B)) + 1) by linarith
  have unit : abs(f(A) - g(A)) + abs(f(B) - g(B)) ≤
      abs(f(A) - g(A)) + abs(f(B) - g(B)) + 1 by linarith
  have larger := realLe.mul_right_of_nonnegative
    at abs(f(A) - g(A)) + abs(f(B) - g(B)),
      abs(f(A) - g(A)) + abs(f(B) - g(B)) + 1,
      scaledRadius(half(E), abs(f(A) - g(A)) + abs(f(B) - g(B)) + 1)
    with unit, radiusNonnegative
  apply dist.lt_of_two_sided_error at riemannSum(f, p, t, N), I,
    abs(riemannSum(g, p, t, N) - I) +
      ((abs(f(A) - g(A)) + abs(f(B) - g(B))) * D +
        (abs(f(A) - g(A)) + abs(f(B) - g(B))) * D), E
  . linarith
  . linarith
  . linarith

-- Integrals over adjacent intervals add

-- The real sequence following u before index k and v from k on.
defunique switchValue (u v : Set, k n : Nat) (X ∈ ℝ) :=
  (n < k ∧ X = u[n]) ∨ (k ≤ n ∧ X = v[n])
requires first : RealSequence(u)
requires second : RealSequence(v)
proof
  have alternatives := Less.or_LessEqual at n, k
  cases alternatives with before | after
  . have value := RealSequence.value at u, n with first
    have member : u[n] ∈ ℝ by exact value
    refine ⟨u[n], member, ?_⟩
    left
    refine ⟨before, rfl⟩
  . have value := RealSequence.value at v, n with second
    have member : v[n] ∈ ℝ by exact value
    refine ⟨v[n], member, ?_⟩
    right
    refine ⟨after, rfl⟩
uniqueness
  intros X xMember xProperty Y yMember yProperty
  rcases xProperty with ⟨xBefore, xValue⟩ | ⟨xAfter, xValue⟩
  . rcases yProperty with ⟨yBefore, yValue⟩ | ⟨yAfter, yValue⟩
    . rw [xValue, yValue]
    . exfalso
      arith
  . rcases yProperty with ⟨yBefore, yValue⟩ | ⟨yAfter, yValue⟩
    . exfalso
      arith
    . rw [xValue, yValue]

defgraph switchSequence (u v : Set, k : Nat) (n ∈ ℕ) : ℝ := switchValue(u, v, k, n)
requires sequenceU : RealSequence(u)
requires sequenceV : RealSequence(v)
proof
  have nNat := nat.omega.backward with member
  have selected := switchValue.selected at u, v, k, n with sequenceU, sequenceV
  exact selected.left

theorem switchSequence.before (u v : Set, k n : Nat)
  requires sequenceU : RealSequence(u)
  requires sequenceV : RealSequence(v)
  requires earlier : n < k
  shows switchSequence(u, v, k)[n] = u[n]
proof
  have value := switchSequence.value at u, v, k, n with sequenceU, sequenceV
  obtain ⟨_, property⟩ := switchValue.selected at u, v, k, n with sequenceU, sequenceV
  rcases property with ⟨_, equal⟩ | ⟨later, _⟩
  . rw [value, equal]
  . exfalso
    arith

theorem switchSequence.after (u v : Set, k n : Nat)
  requires sequenceU : RealSequence(u)
  requires sequenceV : RealSequence(v)
  requires later : k ≤ n
  shows switchSequence(u, v, k)[n] = v[n]
proof
  have value := switchSequence.value at u, v, k, n with sequenceU, sequenceV
  obtain ⟨_, property⟩ := switchValue.selected at u, v, k, n with sequenceU, sequenceV
  rcases property with ⟨earlier, _⟩ | ⟨_, equal⟩
  . exfalso
    arith
  . rw [value, equal]

theorem switchSequence.sequence (u v : Set, k : Nat)
  requires sequenceU : RealSequence(u)
  requires sequenceV : RealSequence(v)
  shows RealSequence(switchSequence(u, v, k))
proof
  unfold RealSequence
  exact switchSequence.function with sequenceU, sequenceV

-- Splitting a tagged partition at a point C inside its cell k: the cells
-- left of C keep their tags and the new cell [pₖ, C] is tagged by C.
theorem TaggedPartition.insert_left (p t : Set) (A B C D : Real, k L : Nat)
  requires tagged : TaggedPartition(p, t, A, B, succ(add(k, L)))
  requires fine : FinePartition(p, A, B, succ(add(k, L)), D)
  requires left : (p[k]:R) < C
  requires right : C < (p[succ(k)]:R)
  shows TaggedPartition(indexedInsertedPoints(p, C, k),
    switchSequence(t, constantSequence(C), k), A, C, succ(k))
proof
  have identityFunction := identity.function at ℝ
  obtain ⟨fineLeft, _⟩ := FinePartition.insert_indexed_split
    at identity(ℝ), p, A, B, C, D, k, L with identityFunction, fine, left,
    right
  obtain ⟨partition, _, _⟩ := fineLeft
  obtain ⟨⟨points, _, _, _⟩, tags, cells⟩ := tagged
  have constant := constantSequence.sequence at C
  have switched := switchSequence.sequence at t, constantSequence(C), k
    with tags, constant
  refine ⟨partition, switched, ?_⟩
  intros i iMember before
  have iNat := nat.omega.backward with iMember
  have atMost : i ≤ k by arith
  have lower := indexedInsertedPoints.before at p, C, k, i with points, atMost
  have alternatives := Less.or_LessEqual at i, k
  cases alternatives with earlier | later
  . have next : succ(i) ≤ k by arith
    have upper := indexedInsertedPoints.before at p, C, k, succ(i)
      with points, next
    have tag := switchSequence.before at t, constantSequence(C), k, i
      with tags, constant, earlier
    have inside : i < succ(add(k, L)) by arith
    have cell := cells with i, iMember, inside
    rw [lower, upper, tag]
    exact cell
  . have same : i = k by arith
    have tag := switchSequence.after at t, constantSequence(C), k, i
      with tags, constant, later
    have value := constantSequence.value at C, i
    have upper := indexedInsertedPoints.inserted at p, C, k with points
    have cReal : Real(C) by typecheck
    have cMember : C ∈ ℝ by typecheck
    have pReal := RealSequence.value at p, k with points
    have below : (p[k]:R) ≤ C by linarith
    have reflexive := realLe.reflexive at C
    rw [lower, tag, value, same, upper]
    exact closedInterval.membership.backward with ⟨cMember, below, reflexive⟩

-- The cells right of C keep their tags and the new cell [C, pₖ₊₁] is
-- tagged by C.
theorem TaggedPartition.insert_right (p t : Set) (A B C D : Real, k L : Nat)
  requires tagged : TaggedPartition(p, t, A, B, succ(add(k, L)))
  requires fine : FinePartition(p, A, B, succ(add(k, L)), D)
  requires left : (p[k]:R) < C
  requires right : C < (p[succ(k)]:R)
  shows TaggedPartition(
    shiftedRealSequence(indexedInsertedPoints(p, C, k), succ(k)),
    shiftedRealSequence(switchSequence(constantSequence(C), t, succ(k)), k),
    C, B, succ(L))
proof
  have identityFunction := identity.function at ℝ
  obtain ⟨_, fineRight, _⟩ := FinePartition.insert_indexed_split
    at identity(ℝ), p, A, B, C, D, k, L with identityFunction, fine, left,
    right
  obtain ⟨partition, _, _⟩ := fineRight
  obtain ⟨⟨points, _, _, _⟩, tags, cells⟩ := tagged
  have constant := constantSequence.sequence at C
  have switched := switchSequence.sequence at constantSequence(C), t,
    succ(k) with constant, tags
  have shifted := shiftedRealSequence.sequence
    at switchSequence(constantSequence(C), t, succ(k)), k with switched
  have inserted := indexedInsertedPoints.sequence at p, C, k with points
  refine ⟨partition, shifted, ?_⟩
  intros j jMember before
  have jNat := nat.omega.backward with jMember
  have tag := shiftedRealSequence.value
    at switchSequence(constantSequence(C), t, succ(k)), k, j with switched
  have lower := shiftedRealSequence.value
    at indexedInsertedPoints(p, C, k), succ(k), j with inserted
  have upper := shiftedRealSequence.value
    at indexedInsertedPoints(p, C, k), succ(k), succ(j) with inserted
  rw [tag, lower, upper]
  have alternatives := natural.zero_or_successor at j
  cases alternatives with zero | successor
  . -- the new cell [C, pₖ₊₁]
    have first : add(k, j) < succ(k) by arith
    have value := switchSequence.before at constantSequence(C), t, succ(k),
      add(k, j) with constant, tags, first
    have constantValue := constantSequence.value at C, add(k, j)
    have atStart : add(succ(k), j) = succ(k) by arith
    have atNext : add(succ(k), succ(j)) = succ(succ(add(k, 0))) by arith
    have startValue := indexedInsertedPoints.inserted at p, C, k with points
    have nextValue := indexedInsertedPoints.after at p, C, k, 0 with points
    have shape : succ(add(k, 0)) = succ(k) by arith
    rw [value, constantValue, atStart, atNext, startValue, nextValue, shape]
    have cReal : Real(C) by typecheck
    have cMember : C ∈ ℝ by typecheck
    have pReal := RealSequence.value at p, succ(k) with points
    have above : C ≤ (p[succ(k)]:R) by linarith
    have reflexive := realLe.reflexive at C
    exact closedInterval.membership.backward with ⟨cMember, reflexive, above⟩
  . -- an old cell, shifted by one
    obtain ⟨i, iNat, shape⟩ := successor
    have later : succ(k) ≤ add(k, j) by arith
    have value := switchSequence.after at constantSequence(C), t, succ(k),
      add(k, j) with constant, tags, later
    have atStart : add(succ(k), j) = succ(succ(add(k, i))) by arith
    have atNext : add(succ(k), succ(j)) = succ(succ(add(k, j))) by arith
    have startValue := indexedInsertedPoints.after at p, C, k, i with points
    have nextValue := indexedInsertedPoints.after at p, C, k, j with points
    have index : succ(add(k, i)) = add(k, j) by arith
    rw [value, atStart, atNext, startValue, nextValue, index]
    have inside : add(k, j) < succ(add(k, L)) by arith
    have member : add(k, j) ∈ ℕ by typecheck
    exact cells with add(k, j), member, inside

-- The tagged sum over [A, B] is the sum of the two sums above, up to the
-- change of tag in cell k.
theorem riemannSum.insert_split (f p t : Set) (A B C : Real, k L : Nat)
  requires function : f : ℝ → ℝ
  requires tagged : TaggedPartition(p, t, A, B, succ(add(k, L)))
  shows riemannSum(f, p, t, succ(add(k, L))) =
    riemannSum(f, indexedInsertedPoints(p, C, k),
      switchSequence(t, constantSequence(C), k), succ(k)) +
    riemannSum(f, shiftedRealSequence(indexedInsertedPoints(p, C, k), succ(k)),
      shiftedRealSequence(switchSequence(constantSequence(C), t, succ(k)), k),
      succ(L)) +
    (f(t[k]) - f(C)) * (p[succ(k)] - p[k])
proof
  obtain ⟨⟨points, _, _, _⟩, tags, _⟩ := tagged
  have cReal : Real(C) by typecheck
  have cMember : C ∈ ℝ by typecheck
  have constant := constantSequence.sequence at C
  have inserted := indexedInsertedPoints.sequence at p, C, k with points
  have leftTags := switchSequence.sequence at t, constantSequence(C), k
    with tags, constant
  have switched := switchSequence.sequence at constantSequence(C), t,
    succ(k) with constant, tags
  have rightPoints := shiftedRealSequence.sequence
    at indexedInsertedPoints(p, C, k), succ(k) with inserted
  have rightTags := shiftedRealSequence.sequence
    at switchSequence(constantSequence(C), t, succ(k)), k with switched
  -- The sum over p splits after cell k.
  have whole := riemannSum.split_at at f, p, t, succ(k), L
    with function, points, tags
  have count : add(succ(k), L) = succ(add(k, L)) by arith
  rw count at whole
  have firstK := riemannSum.succ at f, p, t, k with function, points, tags
  -- The left sum: the first k cells agree, then the cell [pₖ, C].
  have cellsLeft : ∀ i ∈ ℕ, i < k →
      indexedInsertedPoints(p, C, k)[i] = p[i] ∧
      indexedInsertedPoints(p, C, k)[succ(i)] = p[succ(i)] ∧
      switchSequence(t, constantSequence(C), k)[i] = t[i]
    intros i iMember before
    have iNat := nat.omega.backward with iMember
    have atMost : i ≤ k by arith
    have next : succ(i) ≤ k by arith
    have lower := indexedInsertedPoints.before at p, C, k, i with points, atMost
    have upper := indexedInsertedPoints.before at p, C, k, succ(i)
      with points, next
    have tag := switchSequence.before at t, constantSequence(C), k, i
      with tags, constant, before
    refine ⟨lower, upper, tag⟩
  have prefixSame := riemannSum.congr_cells
    at f, indexedInsertedPoints(p, C, k), switchSequence(t, constantSequence(C),
      k), p, t, k with function, inserted, points, leftTags, tags, cellsLeft
  have leftStep := riemannSum.succ at f, indexedInsertedPoints(p, C, k),
    switchSequence(t, constantSequence(C), k), k with function, inserted,
    leftTags
  have reflexive : k ≤ k by arith
  have leftTag := switchSequence.after at t, constantSequence(C), k, k
    with tags, constant, reflexive
  have constantK := constantSequence.value at C, k
  have leftEnd := indexedInsertedPoints.inserted at p, C, k with points
  have leftStart := indexedInsertedPoints.before at p, C, k, k
    with points, reflexive
  rw [leftTag, constantK, leftEnd, leftStart, prefixSame] at leftStep
  -- The right sum: the cell [C, pₖ₊₁], then the later cells of p.
  have rightSplit := riemannSum.split_at at f,
    shiftedRealSequence(indexedInsertedPoints(p, C, k), succ(k)),
    shiftedRealSequence(switchSequence(constantSequence(C), t, succ(k)), k),
    succ(0), L with function, rightPoints, rightTags
  have rightCount : add(succ(0), L) = succ(L) by arith
  rw rightCount at rightSplit
  have rightFirst := riemannSum.succ at f,
    shiftedRealSequence(indexedInsertedPoints(p, C, k), succ(k)),
    shiftedRealSequence(switchSequence(constantSequence(C), t, succ(k)), k), 0
    with function, rightPoints, rightTags
  have tagZero := shiftedRealSequence.value
    at switchSequence(constantSequence(C), t, succ(k)), k, 0 with switched
  have firstIndex : add(k, 0) < succ(k) by arith
  have switchZero := switchSequence.before at constantSequence(C), t, succ(k),
    add(k, 0) with constant, tags, firstIndex
  have constantZero := constantSequence.value at C, add(k, 0)
  have pointZero := shiftedRealSequence.value
    at indexedInsertedPoints(p, C, k), succ(k), 0 with inserted
  have pointOne := shiftedRealSequence.value
    at indexedInsertedPoints(p, C, k), succ(k), succ(0) with inserted
  have zeroIndex : add(succ(k), 0) = succ(k) by arith
  have oneIndex : add(succ(k), succ(0)) = succ(succ(add(k, 0))) by arith
  have nextValue := indexedInsertedPoints.after at p, C, k, 0 with points
  have shape : succ(add(k, 0)) = succ(k) by arith
  rw [tagZero, switchZero, constantZero, pointZero, pointOne, zeroIndex,
    oneIndex, nextValue, shape, leftEnd, riemannSum.zero] at rightFirst
  have cellsRight : ∀ i ∈ ℕ, i < L →
      shiftedRealSequence(shiftedRealSequence(indexedInsertedPoints(p, C, k),
        succ(k)), succ(0))[i] = shiftedRealSequence(p, succ(k))[i] ∧
      shiftedRealSequence(shiftedRealSequence(indexedInsertedPoints(p, C, k),
        succ(k)), succ(0))[succ(i)] =
        shiftedRealSequence(p, succ(k))[succ(i)] ∧
      shiftedRealSequence(shiftedRealSequence(switchSequence(
        constantSequence(C), t, succ(k)), k), succ(0))[i] =
        shiftedRealSequence(t, succ(k))[i]
    intros i iMember before
    have iNat := nat.omega.backward with iMember
    have outerLower := shiftedRealSequence.value
      at shiftedRealSequence(indexedInsertedPoints(p, C, k), succ(k)),
        succ(0), i with rightPoints
    have outerUpper := shiftedRealSequence.value
      at shiftedRealSequence(indexedInsertedPoints(p, C, k), succ(k)),
        succ(0), succ(i) with rightPoints
    have innerLower := shiftedRealSequence.value
      at indexedInsertedPoints(p, C, k), succ(k), add(succ(0), i) with inserted
    have innerUpper := shiftedRealSequence.value
      at indexedInsertedPoints(p, C, k), succ(k), add(succ(0), succ(i))
      with inserted
    have lowerIndex : add(succ(k), add(succ(0), i)) = succ(succ(add(k, i)))
      by arith
    have upperIndex : add(succ(k), add(succ(0), succ(i))) =
      succ(succ(add(k, succ(i)))) by arith
    have lowerValue := indexedInsertedPoints.after at p, C, k, i with points
    have upperValue := indexedInsertedPoints.after at p, C, k, succ(i)
      with points
    have pLower := shiftedRealSequence.value at p, succ(k), i with points
    have pUpper := shiftedRealSequence.value at p, succ(k), succ(i)
      with points
    have pLowerIndex : add(succ(k), i) = succ(add(k, i)) by arith
    have pUpperIndex : add(succ(k), succ(i)) = succ(add(k, succ(i))) by arith
    have outerTag := shiftedRealSequence.value
      at shiftedRealSequence(switchSequence(constantSequence(C), t, succ(k)),
        k), succ(0), i with rightTags
    have innerTag := shiftedRealSequence.value
      at switchSequence(constantSequence(C), t, succ(k)), k, add(succ(0), i)
      with switched
    have later : succ(k) ≤ add(k, add(succ(0), i)) by arith
    have switchTag := switchSequence.after at constantSequence(C), t, succ(k),
      add(k, add(succ(0), i)) with constant, tags, later
    have tTag := shiftedRealSequence.value at t, succ(k), i with tags
    have tagIndex : add(k, add(succ(0), i)) = add(succ(k), i) by arith
    rw [outerLower, outerUpper, innerLower, innerUpper, lowerIndex, upperIndex,
      lowerValue, upperValue, pLower, pUpper, pLowerIndex, pUpperIndex,
      outerTag, innerTag, switchTag, tTag, tagIndex]
    refine ⟨rfl, rfl, rfl⟩
  have pShift := shiftedRealSequence.sequence at p, succ(k) with points
  have tShift := shiftedRealSequence.sequence at t, succ(k) with tags
  have rightShiftPoints := shiftedRealSequence.sequence
    at shiftedRealSequence(indexedInsertedPoints(p, C, k), succ(k)), succ(0)
    with rightPoints
  have rightShiftTags := shiftedRealSequence.sequence
    at shiftedRealSequence(switchSequence(constantSequence(C), t, succ(k)), k),
      succ(0) with rightTags
  have tailSame := riemannSum.congr_cells at f,
    shiftedRealSequence(shiftedRealSequence(indexedInsertedPoints(p, C, k),
      succ(k)), succ(0)),
    shiftedRealSequence(shiftedRealSequence(switchSequence(
      constantSequence(C), t, succ(k)), k), succ(0)),
    shiftedRealSequence(p, succ(k)), shiftedRealSequence(t, succ(k)), L
    with function, rightShiftPoints, pShift, rightShiftTags, tShift, cellsRight
  rw [tailSame, rightFirst] at rightSplit
  -- Collect the pieces.
  have tagReal := RealSequence.value at t, k with tags
  have tagMember : t[k] ∈ ℝ by exact tagReal
  have fTag := FunctionBetween.apply_closed with function, tagMember
  have fTagReal : Real(f(t[k])) by exact fTag
  have fC := FunctionBetween.apply_closed with function, cMember
  have fCReal : Real(f(C)) by exact fC
  have pK := RealSequence.value at p, k with points
  have pNext := RealSequence.value at p, succ(k) with points
  have prefixReal := riemannSum.real at f, p, t, k with function, points, tags
  have tailReal := riemannSum.real at f, shiftedRealSequence(p, succ(k)),
    shiftedRealSequence(t, succ(k)), L with function, pShift, tShift
  rw [whole, firstK, leftStep, rightSplit]
  ring

-- A δ-fine tagged partition of [A, B] gives δ-fine tagged partitions of
-- [A, C] and [C, B] whose sums add up to its sum within 2Mδ, for f
-- bounded by M on [A, B].
theorem TaggedPartition.split_bounded (f p t : Set) (A C B M D : Real, N : Nat)
  requires function : f : ℝ → ℝ
  requires tagged : TaggedPartition(p, t, A, B, N)
  requires fine : FinePartition(p, A, B, N, D)
  requires left : A ≤ C
  requires right : C ≤ B
  requires bounded : ∀ x ∈ closedInterval(A, B), abs(f(x)) ≤ M
  shows ∃ q, ∃ s, ∃ K ∈ ℕ, ∃ u, ∃ v, ∃ J ∈ ℕ,
    TaggedPartition(q, s, A, C, K) ∧ FinePartition(q, A, C, K, D) ∧
    TaggedPartition(u, v, C, B, J) ∧ FinePartition(u, C, B, J, D) ∧
    riemannSum(f, p, t, N) - riemannSum(f, q, s, K) -
      riemannSum(f, u, v, J) ≤ (M + M) * D ∧
    -((M + M) * D) ≤ riemannSum(f, p, t, N) - riemannSum(f, q, s, K) -
      riemannSum(f, u, v, J)
proof
  have taggedCopy := tagged
  have fineCopy := fine
  obtain ⟨partition, tags, cells⟩ := tagged
  obtain ⟨points, start, finish, increasing⟩ := partition
  obtain ⟨_, dPositive, widths⟩ := fine
  have ordered : A ≤ B by linarith
  have aMember : A ∈ ℝ by typecheck
  have reflexiveA := realLe.reflexive at A
  have aInside := closedInterval.membership.backward
    with ⟨aMember, reflexiveA, ordered⟩
  have atA := bounded with A, aInside
  have fA := FunctionBetween.apply_closed with function, aMember
  have fAReal : Real(f(A)) by exact fA
  have absNonnegative := abs.nonnegative at f(A)
  have mNonnegative : 0 ≤ M by linarith
  have doubleNonnegative : 0 ≤ M + M by linarith
  have dNonnegative : (0:R) ≤ D by linarith
  have zeroProduct := realLe.mul_left_of_nonnegative at (0:R), D, M + M
    with dNonnegative, doubleNonnegative
  have zeroValue : (M + M) * (0:R) = (0:R) by ring
  have location : (∃ i ∈ ℕ, i ≤ N ∧ p[i] = C) ∨
      (∃ k ∈ ℕ, k < N ∧ (p[k]:R) < C ∧ C < (p[succ(k)]:R))
    have first := realLess.trichotomy at A, C
    rcases first with inner | same | outer
    . have second := realLess.trichotomy at C, B
      rcases second with inside | atB | beyond
      . exact IntervalPartition.locate_interior
          with ⟨points, start, finish, increasing⟩, inner, inside
      . left
        have nMember : N ∈ ℕ by typecheck
        have reflexive : N ≤ N by arith
        rw atB
        refine ⟨N, nMember, reflexive, finish⟩
      . exfalso
        linarith
    . left
      have zeroMember : 0 ∈ ℕ by typecheck
      have zeroLe : 0 ≤ N by arith
      rw ← same
      refine ⟨0, zeroMember, zeroLe, start⟩
    . exfalso
      linarith
  cases location with vertex | interior
  . obtain ⟨i, iMember, bound, value⟩ := vertex
    have iNat := nat.omega.backward with iMember
    obtain ⟨j, jMember, _, fineL, fineR, taggedL, taggedR, sum⟩ :=
      FinePartition.split_at_vertex with function, fineCopy, taggedCopy, bound,
        value
    have shiftedPoints := shiftedRealSequence.sequence at p, i with points
    have shiftedTags := shiftedRealSequence.sequence at t, i with tags
    have jNat := nat.omega.backward with jMember
    have sumL := riemannSum.real at f, p, t, i with function, points, tags
    have sumR := riemannSum.real at f, shiftedRealSequence(p, i),
      shiftedRealSequence(t, i), j with function, shiftedPoints, shiftedTags
    refine ⟨p, t, i, iMember, shiftedRealSequence(p, i),
      shiftedRealSequence(t, i), j, jMember, taggedL, fineL, taggedR, fineR,
      ?_, ?_⟩
    . rw sum
      linarith
    . rw sum
      linarith
  obtain ⟨k, kMember, before, lower, upper⟩ := interior
  have kNat := nat.omega.backward with kMember
  obtain ⟨L, lNat, length⟩ := before
  have shape : N = succ(add(k, L)) by arith
  rw shape at taggedCopy, fineCopy
  have taggedL := TaggedPartition.insert_left with taggedCopy, fineCopy, lower,
    upper
  have taggedR := TaggedPartition.insert_right with taggedCopy, fineCopy,
    lower, upper
  obtain ⟨fineL, fineR, _⟩ := FinePartition.insert_indexed_split
    with function, fineCopy, lower, upper
  have sum := riemannSum.insert_split at f, p, t, A, B, C, k, L
    with function, taggedCopy
  have kSucc : succ(k) ∈ ℕ by typecheck
  have lSucc : succ(L) ∈ ℕ by typecheck
  have cReal : Real(C) by typecheck
  have constant := constantSequence.sequence at C
  have inserted := indexedInsertedPoints.sequence at p, C, k with points
  have leftTags := switchSequence.sequence at t, constantSequence(C), k
    with tags, constant
  have switched := switchSequence.sequence at constantSequence(C), t,
    succ(k) with constant, tags
  have rightPoints := shiftedRealSequence.sequence
    at indexedInsertedPoints(p, C, k), succ(k) with inserted
  have rightTags := shiftedRealSequence.sequence
    at switchSequence(constantSequence(C), t, succ(k)), k with switched
  have sumL := riemannSum.real at f, indexedInsertedPoints(p, C, k),
    switchSequence(t, constantSequence(C), k), succ(k)
    with function, inserted, leftTags
  have sumR := riemannSum.real at f,
    shiftedRealSequence(indexedInsertedPoints(p, C, k), succ(k)),
    shiftedRealSequence(switchSequence(constantSequence(C), t, succ(k)), k),
    succ(L) with function, rightPoints, rightTags
  refine ⟨indexedInsertedPoints(p, C, k),
    switchSequence(t, constantSequence(C), k), succ(k), kSucc,
    shiftedRealSequence(indexedInsertedPoints(p, C, k), succ(k)),
    shiftedRealSequence(switchSequence(constantSequence(C), t, succ(k)), k),
    succ(L), lSucc, taggedL, fineL, taggedR, fineR, ?_⟩
  -- The change of tag in cell k costs at most 2M times its width.
  have kBefore : k < N by arith
  have kLe : k ≤ N by arith
  have succLe : succ(k) ≤ N by arith
  obtain ⟨tagLower, tagUpper⟩ := TaggedPartition.tag_bounds at p, t, A, B, N,
    k with ⟨⟨points, start, finish, increasing⟩, tags, cells⟩, kBefore
  obtain ⟨atLeast, _⟩ := IntervalPartition.point_bounds at p, A, B, N, k
    with ⟨points, start, finish, increasing⟩, kLe
  obtain ⟨_, atMost⟩ := IntervalPartition.point_bounds at p, A, B, N,
    succ(k) with ⟨points, start, finish, increasing⟩, succLe
  have tagReal := RealSequence.value at t, k with tags
  have tagMember : t[k] ∈ ℝ by exact tagReal
  have cMember : C ∈ ℝ by typecheck
  have pK := RealSequence.value at p, k with points
  have pNext := RealSequence.value at p, succ(k) with points
  have tagInside : t[k] ∈ closedInterval(A, B)
    apply closedInterval.membership.backward
    refine ⟨tagMember, ?_, ?_⟩
    . linarith
    . linarith
  have cInside : C ∈ closedInterval(A, B)
    apply closedInterval.membership.backward
    refine ⟨cMember, ?_, ?_⟩
    . linarith
    . linarith
  have tagBound := bounded with t[k], tagInside
  have cBound := bounded with C, cInside
  have fTag := FunctionBetween.apply_closed with function, tagMember
  have fTagReal : Real(f(t[k])) by exact fTag
  have fC := FunctionBetween.apply_closed with function, cMember
  have fCReal : Real(f(C)) by exact fC
  have tagUpperValue := abs.upper at f(t[k])
  have tagLowerValue := abs.upper_neg at f(t[k])
  have cUpperValue := abs.upper at f(C)
  have cLowerValue := abs.upper_neg at f(C)
  have width := widths with k, kMember, kBefore
  have widthNonnegative : (0:R) ≤ p[succ(k)] - p[k] by linarith
  have widthLe : p[succ(k)] - p[k] ≤ D by linarith
  have gapUpper : f(t[k]) - f(C) ≤ M + M by linarith
  have gapLower : -(M + M) ≤ f(t[k]) - f(C) by linarith
  have scaledUpper := realLe.mul_right_of_nonnegative
    at f(t[k]) - f(C), M + M, p[succ(k)] - p[k]
    with gapUpper, widthNonnegative
  have scaledLower := realLe.mul_right_of_nonnegative
    at -(M + M), f(t[k]) - f(C), p[succ(k)] - p[k]
    with gapLower, widthNonnegative
  have capped := realLe.mul_left_of_nonnegative
    at p[succ(k)] - p[k], D, M + M with widthLe, doubleNonnegative
  have flip : -(M + M) * (p[succ(k)] - p[k]) =
    -((M + M) * (p[succ(k)] - p[k])) by ring
  rw flip at scaledLower
  rw shape
  rw sum
  constructor
  . linarith
  . linarith

-- Integrals of a bounded function over adjacent intervals add.
theorem HasRiemannIntegral.add_adjacent (f : Set) (A C B IL IR M : Real)
  requires integralL : HasRiemannIntegral(f, A, C, IL)
  requires integralR : HasRiemannIntegral(f, C, B, IR)
  requires bounded : ∀ x ∈ closedInterval(A, B), abs(f(x)) ≤ M
  shows HasRiemannIntegral(f, A, B, IL + IR)
proof
  obtain ⟨function, left, controlL⟩ := integralL
  obtain ⟨_, right, controlR⟩ := integralR
  have ordered : A ≤ B by linarith
  have aMember : A ∈ ℝ by typecheck
  have reflexiveA := realLe.reflexive at A
  have aInside := closedInterval.membership.backward
    with ⟨aMember, reflexiveA, ordered⟩
  have atA := bounded with A, aInside
  have fA := FunctionBetween.apply_closed with function, aMember
  have fAReal : Real(f(A)) by exact fA
  have absNonnegative := abs.nonnegative at f(A)
  have doubleNonnegative : 0 ≤ M + M by linarith
  refine ⟨function, ordered, ?_⟩
  intros E eMember positive
  have eReal : Real(E) by exact eMember
  have halfPositive := half.positive with positive
  have halfReal := half.real at E
  have quarterPositive := half.positive with halfPositive
  have quarterReal := half.real at half(E)
  have quarterMember : half(half(E)) ∈ ℝ by typecheck
  have halves := half.add_self at E
  have quarters := half.add_self at half(E)
  obtain ⟨DL, dlMember, dlPositive, estimateL⟩ := controlL with half(half(E)),
    quarterMember, quarterPositive
  obtain ⟨DR, drMember, drPositive, estimateR⟩ := controlR with half(half(E)),
    quarterMember, quarterPositive
  have shifted : 0 < M + M + 1 by linarith
  have radius := scaledRadius.real at half(E), M + M + 1
  have radiusPositive := scaledRadius.positive with halfPositive, shifted
  have cancel := scaledRadius.cancel at half(E), M + M + 1 with shifted
  obtain ⟨D, dMember, dPositive, dL, dR, dRadius⟩ := positiveMesh.common_three
    with dlPositive, drPositive, radiusPositive
  have dReal : Real(D) by exact dMember
  refine ⟨D, dMember, dPositive, ?_⟩
  intros p t N nMember tagged fine
  obtain ⟨q, s, K, kMember, u, v, J, jMember, taggedL, fineL, taggedR, fineR,
    upper, lower⟩ := TaggedPartition.split_bounded with function, tagged, fine,
    left, right, bounded
  have fineLocalL := FinePartition.weaken with fineL, dL
  have fineLocalR := FinePartition.weaken with fineR, dR
  have nearL := estimateL with q, s, K, kMember, taggedL, fineLocalL
  have nearR := estimateR with u, v, J, jMember, taggedR, fineLocalR
  have nNat := nat.omega.backward with nMember
  have kNat := nat.omega.backward with kMember
  have jNat := nat.omega.backward with jMember
  obtain ⟨⟨points, _, _, _⟩, tags, _⟩ := tagged
  obtain ⟨⟨pointsL, _, _, _⟩, tagsL, _⟩ := taggedL
  obtain ⟨⟨pointsR, _, _, _⟩, tagsR, _⟩ := taggedR
  have sum := riemannSum.real at f, p, t, N with function, points, tags
  have sumL := riemannSum.real at f, q, s, K with function, pointsL, tagsL
  have sumR := riemannSum.real at f, u, v, J with function, pointsR, tagsR
  unfold dist at nearL, nearR
  have upperL := abs.upper at riemannSum(f, q, s, K) - IL
  have lowerL := abs.upper_neg at riemannSum(f, q, s, K) - IL
  have upperR := abs.upper at riemannSum(f, u, v, J) - IR
  have lowerR := abs.upper_neg at riemannSum(f, u, v, J) - IR
  have absL := abs.real at riemannSum(f, q, s, K) - IL
  have absR := abs.real at riemannSum(f, u, v, J) - IR
  have smaller := realLe.mul_left_of_nonnegative at D,
    scaledRadius(half(E), M + M + 1), M + M with dRadius, doubleNonnegative
  have radiusNonnegative : (0:R) ≤ scaledRadius(half(E), M + M + 1)
    by linarith
  have unit : M + M ≤ M + M + 1 by linarith
  have larger := realLe.mul_right_of_nonnegative
    at M + M, M + M + 1, scaledRadius(half(E), M + M + 1)
    with unit, radiusNonnegative
  apply dist.lt_of_two_sided_error at riemannSum(f, p, t, N), IL + IR,
    abs(riemannSum(f, q, s, K) - IL) + abs(riemannSum(f, u, v, J) - IR) +
      (M + M) * D, E
  . linarith
  . linarith
  . linarith

theorem RiemannIntegrable.add_adjacent (f : Set) (A C B M : Real)
  requires integrableL : RiemannIntegrable(f, A, C)
  requires integrableR : RiemannIntegrable(f, C, B)
  requires bounded : ∀ x ∈ closedInterval(A, B), abs(f(x)) ≤ M
  shows RiemannIntegrable(f, A, B)
proof
  obtain ⟨IL, lMember, integralL⟩ := integrableL
  obtain ⟨IR, rMember, integralR⟩ := integrableR
  have lReal : Real(IL) by exact lMember
  have rReal : Real(IR) by exact rMember
  have sum := HasRiemannIntegral.add_adjacent with integralL, integralR,
    bounded
  have member : IL + IR ∈ ℝ by typecheck
  exact ⟨IL + IR, member, sum⟩

-- Functions continuous on the open cells of a partition

-- A function that agrees inside (A, B) with a function continuous on
-- [A, B] has the same integral.
theorem HasRiemannIntegral.of_continuous_interior (f g : Set) (A B : Real)
  requires function : f : ℝ → ℝ
  requires ordered : A ≤ B
  requires continuous : ContinuousOn(g, closedInterval(A, B))
  requires agree : ∀ x ∈ ℝ, A < x → x < B → f(x) = g(x)
  shows HasRiemannIntegral(f, A, B, riemannIntegral(g, A, B))
proof
  have integrable := ContinuousOn.integrable_interval with ordered, continuous
  have integral := riemannIntegral.integral with integrable
  exact HasRiemannIntegral.congr_interior with integral, function, agree

-- Integrals over the cells of a partition of [A, B] add up to the integral
-- over [A, B], for a function bounded on [A, B]: the prefix form.
theorem HasRiemannIntegral.partition_prefix (f p I : Set) (A B M : Real, N n : Nat)
  requires function : f : ℝ → ℝ
  requires partition : IntervalPartition(p, A, B, N)
  requires values : RealSequence(I)
  requires bounded : ∀ x ∈ closedInterval(A, B), abs(f(x)) ≤ M
  requires cells : ∀ i ∈ ℕ, i < N → HasRiemannIntegral(f, p[i], p[succ(i)], I[i])
  shows n ≤ N → HasRiemannIntegral(f, A, p[n], ∑ i < n, I(i))
proof
  induction n
  | zero =>
    intro bound
    obtain ⟨_, start, _, _⟩ := partition
    have point := HasRiemannIntegral.point at f, A with function
    rw [start, realPartialSum.zero]
    exact point
  | succ(m) using ih =>
    intro bound
    have mLe : m ≤ N by arith
    have before : m < N by arith
    have previous := ih with mLe
    have mMember : m ∈ ℕ by typecheck
    have cell := cells with m, mMember, before
    obtain ⟨_, atMost⟩ := IntervalPartition.point_bounds at p, A, B, N,
      succ(m) with partition, bound
    obtain ⟨points, _, _, _⟩ := partition
    have pNext := RealSequence.value at p, succ(m) with points
    have aReal : Real(A) by typecheck
    have reflexive := realLe.reflexive at A
    have nested := closedInterval.nested at A, p[succ(m)], A, B
      with reflexive, atMost
    have smaller : ∀ x ∈ closedInterval(A, p[succ(m)]), abs(f(x)) ≤ M
      intros x inside
      have wider := nested with x, inside
      exact bounded with x, wider
    have sum := HasRiemannIntegral.add_adjacent with previous, cell, smaller
    have prefixReal := realPartialSum.real at I, m with values
    have term := RealSequence.value at I, m with values
    have bridge : realAddValue(∑ i < m, I(i), I(m)) = (∑ i < m, I(i)) + I(m)
      by ring
    rw [realPartialSum.succ, bridge]
    exact sum

-- Integrals over the cells of a partition add up, for a bounded function.
theorem HasRiemannIntegral.of_partition (f p I : Set) (A B M : Real, N : Nat)
  requires function : f : ℝ → ℝ
  requires partition : IntervalPartition(p, A, B, N)
  requires values : RealSequence(I)
  requires bounded : ∀ x ∈ closedInterval(A, B), abs(f(x)) ≤ M
  requires cells : ∀ i ∈ ℕ, i < N → HasRiemannIntegral(f, p[i], p[succ(i)], I[i])
  shows HasRiemannIntegral(f, A, B, ∑ i < N, I(i))
proof
  have prefix := HasRiemannIntegral.partition_prefix at f, p, I, A, B, M, N, N
    with function, partition, values, bounded, cells
  have reflexive : N ≤ N by arith
  have whole := prefix with reflexive
  obtain ⟨_, _, finish, _⟩ := partition
  rwa finish at whole

-- The integrals over the cells of a partition.
defgraph cellIntegrals (f p : Set) (i ∈ ℕ) : ℝ :=
  riemannIntegral(f, p[i], p[succ(i)])
requires points : RealSequence(p)
proof
  have iNat := nat.omega.backward with member
  have left := RealSequence.value at p, i with points
  have right := RealSequence.value at p, succ(i) with points
  have selected := riemannIntegral.selected at f, p[i], p[succ(i)]
  exact selected.left

-- A bounded function integrable on each cell of a partition is integrable.
theorem RiemannIntegrable.of_partition (f p : Set) (A B M : Real, N : Nat)
  requires function : f : ℝ → ℝ
  requires partition : IntervalPartition(p, A, B, N)
  requires bounded : ∀ x ∈ closedInterval(A, B), abs(f(x)) ≤ M
  requires cells : ∀ i ∈ ℕ, i < N → RiemannIntegrable(f, p[i], p[succ(i)])
  shows RiemannIntegrable(f, A, B)
proof
  have points : RealSequence(p)
    obtain ⟨points, _, _, _⟩ := partition
    exact points
  have values : RealSequence(cellIntegrals(f, p))
    unfold RealSequence
    exact cellIntegrals.function with points
  have integrals : ∀ i ∈ ℕ, i < N →
      HasRiemannIntegral(f, p[i], p[succ(i)], cellIntegrals(f, p)[i])
    intros i iMember before
    have iNat := nat.omega.backward with iMember
    have left := RealSequence.value at p, i with points
    have right := RealSequence.value at p, succ(i) with points
    have value := cellIntegrals.value at f, p, i with points
    have integrable := cells with i, iMember, before
    rw value
    exact riemannIntegral.integral with integrable
  have whole := HasRiemannIntegral.of_partition with function, partition,
    values, bounded, integrals
  have sum := realPartialSum.real at cellIntegrals(f, p), N with values
  have member : (∑ i < N, cellIntegrals(f, p)(i)) ∈ ℝ by exact sum
  exact ⟨∑ i < N, cellIntegrals(f, p)(i), member, whole⟩

-- A bounded function that agrees, inside each cell of a partition, with a
-- function continuous on the closed cell is integrable.
theorem RiemannIntegrable.of_piecewise_continuous (f p : Set) (A B M : Real, N : Nat)
  requires function : f : ℝ → ℝ
  requires partition : IntervalPartition(p, A, B, N)
  requires bounded : ∀ x ∈ closedInterval(A, B), abs(f(x)) ≤ M
  requires cells : ∀ i ∈ ℕ, i < N → ∃ g,
    ContinuousOn(g, closedInterval(p[i], p[succ(i)])) ∧
    (∀ x ∈ ℝ, p[i] < x → x < p[succ(i)] → f(x) = g(x))
  shows RiemannIntegrable(f, A, B)
proof
  have integrable : ∀ i ∈ ℕ, i < N → RiemannIntegrable(f, p[i], p[succ(i)])
    intros i iMember before
    obtain ⟨g, continuous, agree⟩ := cells with i, iMember, before
    obtain ⟨points, _, _, increasing⟩ := partition
    have strict := increasing with i, iMember, before
    have ordered : p[i] ≤ p[succ(i)] by linarith
    have integral := HasRiemannIntegral.of_continuous_interior
      with function, ordered, continuous, agree
    have left := RealSequence.value at p, i with points
    have right := RealSequence.value at p, succ(i) with points
    obtain ⟨member, _⟩ := riemannIntegral.selected at g, p[i], p[succ(i)]
    exact ⟨riemannIntegral(g, p[i], p[succ(i)]), member, integral⟩
  exact RiemannIntegrable.of_partition with function, partition, bounded,
    integrable
