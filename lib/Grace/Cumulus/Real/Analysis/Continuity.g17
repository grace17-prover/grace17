module Grace.Cumulus.Real.Analysis.Continuity
import Sequences

-- Section: Continuity
predicate ContinuousAt (f : Set) (A : Real) :=
  FunctionBetween(f, ℝ, ℝ) ∧
  (∀ e ∈ ℝ, 0 < e →
    ∃ d ∈ ℝ, 0 < d ∧
      ∀ x ∈ ℝ, (x ∈ openBall(A, d) →
        f(x) ∈ openBall(f(A), e)))

predicate Continuous (f : Set) :=
  FunctionBetween(f, ℝ, ℝ) ∧
  (∀ a ∈ ℝ, ContinuousAt(f, a))

predicate Nonzero (A : Real) := A ≠ 0

def pointwiseNeg (f : Set) : Set :=
  compose(realNeg, f, ℝ, ℝ, ℝ)

def pointwiseAdd (f g : Set) : Set :=
  compose(realAdd, pairFunctions(f, g, ℝ, ℝ, ℝ),
    ℝ, ℝ × ℝ, ℝ)

def pointwiseSub (f g : Set) : Set :=
  pointwiseAdd(f, pointwiseNeg(g))

def pointwiseMul (f g : Set) : Set :=
  compose(realMul, pairFunctions(f, g, ℝ, ℝ, ℝ),
    ℝ, ℝ × ℝ, ℝ)

def pointwiseInv (f : Set) : Set :=
  compose(realInv, f, ℝ, ℝ, ℝ)

def pointwiseDiv (f g : Set) : Set :=
  pointwiseMul(f, pointwiseInv(g))

theorem pointwiseNeg.function (f : Set)
  requires function : f : ℝ → ℝ
  shows pointwiseNeg(f) : ℝ → ℝ
proof
  unfold pointwiseNeg
  exact compose.function with function, realNeg.function

theorem pointwiseNeg.value (f : Set) (X : Real)
  requires function : f : ℝ → ℝ
  requires valueReal : Real(f(X))
  shows pointwiseNeg(f)(X) = -f(X)
proof
  have realX : X ∈ ℝ by simp [Real]
  have value := compose.apply with function, realNeg.function, realX
  simp [pointwiseNeg]

theorem pointwiseAdd.function (f g : Set)
  requires fFunction : f : ℝ → ℝ
  requires gFunction : g : ℝ → ℝ
  shows pointwiseAdd(f, g) : ℝ → ℝ
proof
  have paired := pairFunctions.function with fFunction, gFunction
  unfold pointwiseAdd
  exact compose.function with paired, realAdd.function

theorem pointwiseAdd.value (f g : Set) (X : Real)
  requires fFunction : f : ℝ → ℝ
  requires gFunction : g : ℝ → ℝ
  requires fValueReal : Real(f(X))
  requires gValueReal : Real(g(X))
  shows pointwiseAdd(f, g)(X) = f(X) + g(X)
proof
  have realX : X ∈ ℝ by simp [Real]
  have paired := pairFunctions.function with fFunction, gFunction
  have pairValue := pairFunctions.apply with fFunction, gFunction, realX
  have sumValue := compose.apply with paired, realAdd.function, realX
  unfold pointwiseAdd
  rw pairValue at sumValue
  simp [call2]

theorem pointwiseMul.function (f g : Set)
  requires fFunction : f : ℝ → ℝ
  requires gFunction : g : ℝ → ℝ
  shows pointwiseMul(f, g) : ℝ → ℝ
proof
  have paired := pairFunctions.function with fFunction, gFunction
  unfold pointwiseMul
  exact compose.function with paired, realMul.function

theorem pointwiseMul.value (f g : Set) (X : Real)
  requires fFunction : f : ℝ → ℝ
  requires gFunction : g : ℝ → ℝ
  requires fValueReal : Real(f(X))
  requires gValueReal : Real(g(X))
  shows pointwiseMul(f, g)(X) = f(X) * g(X)
proof
  have realX : X ∈ ℝ by simp [Real]
  have paired := pairFunctions.function with fFunction, gFunction
  have pairValue := pairFunctions.apply with fFunction, gFunction, realX
  have productValue := compose.apply with paired, realMul.function, realX
  unfold pointwiseMul
  rw pairValue at productValue
  simp [call2]

theorem pointwiseInv.function (f : Set)
  requires function : f : ℝ → ℝ
  shows pointwiseInv(f) : ℝ → ℝ
proof
  unfold pointwiseInv
  exact compose.function with function, realInv.function

theorem pointwiseInv.value (f : Set) (X : Real)
  requires function : f : ℝ → ℝ
  requires valueReal : Real(f(X))
  shows pointwiseInv(f)(X) = realInvValue(f(X))
proof
  have realX : X ∈ ℝ by simp [Real]
  have value := compose.apply with function, realInv.function, realX
  simp [pointwiseInv, realInvValue]

-- Any two positive radii have a positive common refinement.
theorem positiveRadius.common (D R : Real)
  requires positiveD : 0 < D
  requires positiveR : 0 < R
  shows ∃ S ∈ ℝ, 0 < S ∧ S ≤ D ∧ S ≤ R
proof
  have realD : D ∈ ℝ by simp [Real]
  have realR : R ∈ ℝ by simp [Real]
  have equalityCases : D = R ∨ D ≠ R by tauto
  cases equalityCases with equal | distinct
  . witness D
    constructor
    . exact realD
    . constructor
      . exact positiveD
      . constructor
        . exact realLe.reflexive at D
        . rw ← equal
          exact realLe.reflexive with assumption
  . have comparison := realLess.connected_on with D, R, distinct
    cases comparison with dLessR | rLessD
    . witness D
      constructor
      . exact realD
      . constructor
        . exact positiveD
        . constructor
          . exact realLe.reflexive at D
          . exact realLess.implies_le at D, R with
              *{2}, dLessR
    . witness R
      constructor
      . exact realR
      . constructor
        . exact positiveR
        . constructor
          . exact realLess.implies_le at R, D with
              *{2}, rLessD
          . exact realLe.reflexive at R

-- The standard local estimate for multiplication, packaged at the metric
-- level so continuity proofs can focus on choosing radii.
theorem openBall.mul_control (A B C D E : Real)
  requires positiveE : 0 < E
  requires nearA : A ∈ openBall(C, scaledRadius(E, limitScale(D)))
  requires nearB : B ∈ openBall(D,
    scaledRadius(E, scaledRadius(E, limitScale(D)) + abs(C)))
  shows A * B ∈ openBall(C * D, E)
proof
  have scaleDReal := limitScale.real at D with assumption
  have scaleDPositive := limitScale.positive at D with assumption
  have radiusAReal := scaledRadius.real at E, limitScale(D) with
    assumption, scaleDReal
  have radiusAPositive := scaledRadius.positive at E, limitScale(D) with
    assumption, scaleDReal, positiveE, scaleDPositive
  have absCReal := abs.real at C with assumption
  have boundReal := realAddValue.real at
    scaledRadius(E, limitScale(D)), abs(C) with radiusAReal, absCReal
  have radiusAboveAbsC := realLess.add_right at
    realZero, scaledRadius(E, limitScale(D)), abs(C) with
      realZero.real, radiusAReal, absCReal, radiusAPositive
  have zeroPlusAbsC := realAddValue.zero_left with absCReal
  rw zeroPlusAbsC at radiusAboveAbsC
  have boundPositive := realLe.transitive_less at
    realZero, abs(C), scaledRadius(E, limitScale(D)) + abs(C) with
      realZero.real, absCReal, boundReal,
      abs.nonnegative at C with assumption, radiusAboveAbsC
  have radiusBReal := scaledRadius.real at
    E, scaledRadius(E, limitScale(D)) + abs(C) with assumption, boundReal
  have dataA := openBall.membership.forward at
    C, scaledRadius(E, limitScale(D)), A with nearA
  have dataB := openBall.membership.forward at
    D, scaledRadius(E, scaledRadius(E, limitScale(D)) + abs(C)), B with nearB
  rcases dataA with ⟨realA, closeA⟩
  rcases dataB with ⟨realB, closeB⟩

  have absAReal := abs.real at A with assumption
  have distACReal := dist.real at A, C with *
  have distBDReal := dist.real at B, D with *
  have absABound := abs.le_dist_add_abs at A, C with
    *{2}
  have closeAWithAbsC := realLess.add_right at
    dist(A, C), scaledRadius(E, limitScale(D)), abs(C) with
      distACReal, radiusAReal, absCReal, closeA
  have distPlusAbsReal := realAddValue.real at dist(A, C), abs(C) with
    distACReal, absCReal
  have aBounded := realLe.transitive_less at
    abs(A), dist(A, C) + abs(C),
    scaledRadius(E, limitScale(D)) + abs(C) with
      absAReal, distPlusAbsReal, boundReal,
      absABound, closeAWithAbsC

  have aBoundedLe := realLess.implies_le at
    abs(A), scaledRadius(E, limitScale(D)) + abs(C) with
      absAReal, boundReal, aBounded
  have distBDNonnegative := dist.nonnegative at B, D with
    *{2}
  have firstWeak := realLe.mul_right_of_nonnegative at
    abs(A), scaledRadius(E, limitScale(D)) + abs(C), dist(B, D) with
      absAReal, boundReal, distBDReal, aBoundedLe, distBDNonnegative
  have firstStrict := realLess.mul_left_of_positive at
    dist(B, D),
    scaledRadius(E, scaledRadius(E, limitScale(D)) + abs(C)),
    scaledRadius(E, limitScale(D)) + abs(C) with
      distBDReal, radiusBReal, boundReal, closeB, boundPositive
  have firstTermReal := realMulValue.real at
    abs(A), dist(B, D) with absAReal, distBDReal
  have firstMiddleReal := realMulValue.real at
    scaledRadius(E, limitScale(D)) + abs(C), dist(B, D) with
      boundReal, distBDReal
  have firstUpperReal := realMulValue.real at
    scaledRadius(E, limitScale(D)) + abs(C),
    scaledRadius(E, scaledRadius(E, limitScale(D)) + abs(C)) with
      boundReal, radiusBReal
  have firstBelow := realLe.transitive_less at
    abs(A) * dist(B, D),
    (scaledRadius(E, limitScale(D)) + abs(C)) * dist(B, D),
    (scaledRadius(E, limitScale(D)) + abs(C)) *
      scaledRadius(E, scaledRadius(E, limitScale(D)) + abs(C)) with
      firstTermReal, firstMiddleReal, firstUpperReal,
      firstWeak, firstStrict
  have firstCancellation := scaledRadius.cancel at
    E, scaledRadius(E, limitScale(D)) + abs(C) with
      assumption, boundReal, boundPositive
  rw firstCancellation at firstBelow

  have absDReal := abs.real at D with assumption
  have absDLess := abs.lt_limitScale at D with assumption
  have absDLe := realLess.implies_le at abs(D), limitScale(D) with
    absDReal, scaleDReal, absDLess
  have distACNonnegative := dist.nonnegative at A, C with
    *{2}
  have secondWeak := realLe.mul_right_of_nonnegative at
    abs(D), limitScale(D), dist(A, C) with
      absDReal, scaleDReal, distACReal, absDLe, distACNonnegative
  have secondStrict := realLess.mul_left_of_positive at
    dist(A, C), scaledRadius(E, limitScale(D)), limitScale(D) with
      distACReal, radiusAReal, scaleDReal, closeA, scaleDPositive
  have secondTermReal := realMulValue.real at
    abs(D), dist(A, C) with absDReal, distACReal
  have secondMiddleReal := realMulValue.real at
    limitScale(D), dist(A, C) with scaleDReal, distACReal
  have secondUpperReal := realMulValue.real at
    limitScale(D), scaledRadius(E, limitScale(D)) with
      scaleDReal, radiusAReal
  have secondBelow := realLe.transitive_less at
    abs(D) * dist(A, C),
    limitScale(D) * dist(A, C),
    limitScale(D) * scaledRadius(E, limitScale(D)) with
      secondTermReal, secondMiddleReal, secondUpperReal,
      secondWeak, secondStrict
  have secondCancellation := scaledRadius.cancel at
    E, limitScale(D) with assumption, scaleDReal, scaleDPositive
  rw secondCancellation at secondBelow

  have estimate := dist.mul_mul at A, B, C, D with
    *{4}
  have halfReal := half.real at E with assumption
  have sumBelow := realLess.add at
    abs(A) * dist(B, D), half(E),
    abs(D) * dist(A, C), half(E) with
      firstTermReal, halfReal, secondTermReal, halfReal,
      firstBelow, secondBelow
  have doubled := half.add_self at E with assumption
  rw doubled at sumBelow
  have productReal := realMulValue.real at A, B with *
  have centerReal := realMulValue.real at C, D with *
  have totalDistanceReal := dist.real at A * B, C * D with
    productReal, centerReal
  have estimateSumReal := realAddValue.real at
    abs(A) * dist(B, D), abs(D) * dist(A, C) with
      firstTermReal, secondTermReal
  have within := realLe.transitive_less at
    dist(A * B, C * D),
    abs(A) * dist(B, D) + abs(D) * dist(A, C), E with
      totalDistanceReal, estimateSumReal, assumption,
      estimate, sumBelow
  apply openBall.membership.backward at C * D, E, A * B
  constructor
    exact productReal
  . exact within

-- The textbook reciprocal estimate near a nonzero center.
theorem openBall.inv_control (A B E : Real)
  requires nonzeroB : B ≠ 0
  requires positiveE : 0 < E
  requires awayFromZero : A ∈ openBall(B, half(abs(B)))
  requires epsilonClose : A ∈ openBall(B, scaledRadius(E, inverseScale(B)))
  shows realInvValue(A) ∈ openBall(realInvValue(B), E)
proof
  have absBReal := abs.real at B with assumption
  have absBPositive := abs.positive_of_ne with assumption, nonzeroB
  have halfAbsBReal := half.real with absBReal
  have halfAbsBPositive := half.positive with absBReal, absBPositive
  have scaleReal := inverseScale.real at B with assumption
  have scalePositive := inverseScale.positive with assumption, nonzeroB
  have radiusReal := scaledRadius.real at E, inverseScale(B) with
    assumption, scaleReal
  have awayData := openBall.membership.forward at
    B, half(abs(B)), A with awayFromZero
  have epsilonData := openBall.membership.forward at
    B, scaledRadius(E, inverseScale(B)), A with epsilonClose
  rcases awayData with ⟨realA, closeZero⟩
  rcases epsilonData with ⟨realAAgain, closeE⟩

  have lower := abs.half_lt_of_dist_lt_half with *{2}, nonzeroB, closeZero
  have nonzeroA : A ≠ 0
    intro equal
    have absoluteZero := abs.zero
    rw [equal, absoluteZero] at lower
    have zeroInReals : realZero ∈ ℝ
      exact realZero.real
    have irreflexive := realLess.irreflexive_on
    have cycle := realLess.transitive with realZero.real, halfAbsBReal, realZero.real, halfAbsBPositive, lower
    exact irreflexive with realZero, zeroInReals, cycle

  have absAReal := abs.real at A with assumption
  have inverseBound := realInvValue.antitone_positive with halfAbsBReal, absAReal, halfAbsBPositive, lower
  have absInverseA := abs.inv with assumption, nonzeroA
  rw ← absInverseA at inverseBound

  have inverseBReal := realInvValue.real at B with assumption
  have inverseBNonzero := realInvValue.nonzero with assumption, nonzeroB
  have absInverseBReal := abs.real with inverseBReal
  have absInverseBPositive := abs.positive_of_ne with inverseBReal, inverseBNonzero
  have factorBound := realLess.mul_right_of_positive at
    abs(realInvValue(A)), realInvValue(half(abs(B))),
    abs(realInvValue(B)) with
      abs.real at realInvValue(A) with realInvValue.real at A with assumption,
      realInvValue.real at half(abs(B)) with halfAbsBReal,
      absInverseBReal, inverseBound, absInverseBPositive
  have factorBoundScale : abs(realInvValue(A)) *
      abs(realInvValue(B)) < inverseScale(B)
    unfold inverseScale
    exact factorBound

  have distanceReal := dist.real at A, B with *
  have factorReal := realMulValue.real at
    abs(realInvValue(A)), abs(realInvValue(B)) with
      abs.real at realInvValue(A) with realInvValue.real at A with assumption,
      absInverseBReal
  have distanceNonnegative := dist.nonnegative at A, B with
    *{2}
  have factorLe := realLess.implies_le with factorReal, scaleReal, factorBoundScale
  have weakProduct := realLe.mul_left_of_nonnegative with
    factorReal, scaleReal, distanceReal, factorLe, distanceNonnegative
  have strictProduct := realLess.mul_right_of_positive with
    distanceReal, radiusReal, scaleReal, closeE, scalePositive
  have lowerProductReal := realMulValue.real with distanceReal, factorReal
  have middleProductReal := realMulValue.real with distanceReal, scaleReal
  have upperProductReal := realMulValue.real with radiusReal, scaleReal
  have productBelow := realLe.transitive_less with
    lowerProductReal, middleProductReal, upperProductReal, weakProduct, strictProduct
  have cancellation := scaledRadius.cancel at
    E, inverseScale(B) with assumption, scaleReal, scalePositive
  have commute := realMulValue.commutative with radiusReal, scaleReal
  rw [commute, cancellation] at productBelow
  have halfBelowE := half.lt_self with assumption, positiveE
  have halfReal := half.real at E with assumption
  have productBelowE := realLess.transitive with
    lowerProductReal, halfReal, assumption, productBelow, halfBelowE
  have inverseDistance := dist.inv_inv with *{2}, nonzeroA, nonzeroB
  rw ← inverseDistance at productBelowE
  apply openBall.membership.backward
  constructor
  . have inverseAReal := realInvValue.real at A with assumption
    exact inverseAReal
  . exact productBelowE

theorem ContinuousAt.function (f : Set) (A : Real)
  requires continuous : ContinuousAt(f, A)
  shows f : ℝ → ℝ
proof
  simp [ContinuousAt]

-- Once a graph is known to map reals to reals, every application receives
-- its output type, so notation can infer the carrier of f(x) from the
-- function and the typed argument without ad hoc lemmas.
instance realFunction.value_type (f : Set) (X : Real)
  requires function : f : ℝ → ℝ
  shows Real(f(X))
proof
  have realX : X ∈ ℝ by simp [Real]
  unfold Real
  exact FunctionBetween.apply_closed with function, realX

theorem Continuous.function (f : Set)
  requires continuous : Continuous(f)
  shows f : ℝ → ℝ
proof
  simp [Continuous]

theorem ContinuousAt.maps_ball (f : Set) (A E : Real)
  requires continuous : ContinuousAt(f, A)
  requires positive : 0 < E
  shows ∃ D ∈ ℝ, 0 < D ∧
    ∀ x ∈ ℝ, (x ∈ openBall(A, D) →
      f(x) ∈ openBall(f(A), E))
proof
  rcases continuous with ⟨function, local⟩
  exact local with E, positive

theorem Continuous.at (f : Set) (A : Real)
  requires continuous : Continuous(f)
  shows ContinuousAt(f, A)
proof
  rcases continuous with ⟨function, everywhere⟩
  have realA : A ∈ ℝ by simp [Real]
  exact everywhere with A, realA

instance ContinuousAt.value_type (f : Set) (A : Real)
  requires continuous : ContinuousAt(f, A)
  shows Real(f(A))
proof
  have function := ContinuousAt.function with continuous
  have realA : A ∈ ℝ by simp [Real]
  unfold Real
  exact FunctionBetween.apply_closed with function, realA

instance Continuous.value_type (f : Set) (A : Real)
  requires continuous : Continuous(f)
  shows Real(f(A))
proof
  have continuousAt := Continuous.at with continuous
  exact ContinuousAt.value_type with continuousAt

theorem identity.continuous_at (A : Real)
  shows ContinuousAt(identity(ℝ), A)
proof
  have function := identity.function at ℝ
  have realA : A ∈ ℝ by simp [Real]
  have mappedA := identity.relates with realA
  have valueA := FunctionBetween.apply_value with function, mappedA
  constructor
  . exact function
  . intros E realE positive
    witness E
    constructor
    . exact realE
    . constructor
      . exact positive
      . intros X realX near
        have mappedX := identity.relates with realX
        have valueX := FunctionBetween.apply_value with function, realX, mappedX
        rwa [valueX, valueA]

theorem identity.continuous
  shows Continuous(identity(ℝ))
proof
  constructor
  . exact identity.function at ℝ
  . intros A realA
    have typedA : Real(A) by exact realA
    exact identity.continuous_at with typedA

-- Continuity is extensional: replacing a real function pointwise by an
-- equal graph does not change continuity at a point.
theorem ContinuousAt.congr (f g : Set) (A : Real)
  requires continuous : ContinuousAt(f, A)
  requires gFunction : g : ℝ → ℝ
  requires equal : ∀ x ∈ ℝ, f(x) = g(x)
  shows ContinuousAt(g, A)
proof
  constructor
  . exact gFunction
  . intros E realE positive
    obtain ⟨D, realD, positiveD, maps⟩ := ContinuousAt.maps_ball with continuous, positive
    witness D
    constructor
    . exact realD
    . constructor
      . exact positiveD
      . intros X realX near
        have realA : A ∈ ℝ by simp [Real]
        have equalX := equal with X, realX
        have equalA := equal with A
        rw [← equalX, ← equalA]
        exact maps with X, realX, near

-- Continuity composes exactly as open balls do: first choose a radius for g,
-- then choose one for f which lands inside it.
theorem ContinuousAt.comp (g f : Set) (A : Real)
  requires continuousF : ContinuousAt(f, A)
  requires continuousG : ContinuousAt(g, f(A))
  shows ContinuousAt(compose(g, f, ℝ, ℝ, ℝ), A)
proof
  have fFunction := ContinuousAt.function with continuousF
  have realA : A ∈ ℝ by simp [Real]
  have fAReal := FunctionBetween.apply_closed with fFunction, realA
  have typedFA : Real(f(A)) by exact fAReal
  have gFunction := ContinuousAt.function with continuousG
  constructor
  . exact compose.function at g, f, ℝ, ℝ, ℝ with
      fFunction, gFunction
  . intros E realE positive
    obtain ⟨D, realD, positiveD, gMaps⟩ := ContinuousAt.maps_ball with continuousG, positive
    obtain ⟨R, realR, positiveR, fMaps⟩ := ContinuousAt.maps_ball with continuousF, positiveD
    witness R
    constructor
    . exact realR
    . constructor
      . exact positiveR
      . intros X realX near
        have fXReal := FunctionBetween.apply_closed with fFunction, realX
        have mappedF := fMaps with X, realX, near
        have mappedG := gMaps with f(X), fXReal, mappedF
        have atX := compose.apply with fFunction, gFunction, realX
        have atA := compose.apply with fFunction, gFunction, realA
        rwa [atX, atA]

theorem ContinuousAt.add (f g : Set) (A : Real)
  requires continuousF : ContinuousAt(f, A)
  requires continuousG : ContinuousAt(g, A)
  shows ContinuousAt(pointwiseAdd(f, g), A)
proof
  have fFunction := ContinuousAt.function with continuousF
  have gFunction := ContinuousAt.function with continuousG
  have realA : A ∈ ℝ by simp [Real]
  constructor
  . exact pointwiseAdd.function with fFunction, gFunction
  . intros E realE positive
    have typedE : Real(E) by exact realE
    have radiusPositive := half.positive with positive
    obtain ⟨D, realD, positiveD, mapsF⟩ := ContinuousAt.maps_ball with continuousF, radiusPositive
    obtain ⟨R, realR, positiveR, mapsG⟩ := ContinuousAt.maps_ball with continuousG, radiusPositive
    have typedD : Real(D) by exact realD
    have typedR : Real(R) by exact realR
    obtain ⟨S, realS, positiveS, sLeD, sLeR⟩ := positiveRadius.common with
      typedD, typedR, positiveD, positiveR
    have typedS : Real(S) by exact realS
    witness S
    constructor
    . exact realS
    . constructor
      . exact positiveS
      . intros X realX near
        have typedX : Real(X) by exact realX
        have nearF := openBall.mono at X, A, S, D with
          typedX, assumption, typedS, typedD, near, sLeD
        have nearG := openBall.mono at X, A, S, R with
          typedX, assumption, typedS, typedR, near, sLeR
        have mappedF := mapsF with X, realX, nearF
        have mappedG := mapsG with X, realX, nearG
        have fXReal := FunctionBetween.apply_closed with fFunction, realX
        have gXReal := FunctionBetween.apply_closed with gFunction, realX
        have fAReal := FunctionBetween.apply_closed with fFunction, realA
        have gAReal := FunctionBetween.apply_closed with gFunction, realA
        have typedFX : Real(f(X)) by exact fXReal
        have typedGX : Real(g(X)) by exact gXReal
        have typedFA : Real(f(A)) by exact fAReal
        have typedGA : Real(g(A)) by exact gAReal
        have sumNear := openBall.add with mappedF, mappedG
        have doubled := half.add_self with typedE
        rw doubled at sumNear
        have valueX := pointwiseAdd.value with typedX, fFunction, gFunction, typedFX, typedGX
        have valueA := pointwiseAdd.value at f, g, A with
          assumption, fFunction, gFunction, typedFA, typedGA
        rwa [valueX, valueA]

theorem ContinuousAt.mul (f g : Set) (A : Real)
  requires continuousF : ContinuousAt(f, A)
  requires continuousG : ContinuousAt(g, A)
  shows ContinuousAt(pointwiseMul(f, g), A)
proof
  have fFunction := ContinuousAt.function with continuousF
  have gFunction := ContinuousAt.function with continuousG
  have realA : A ∈ ℝ by simp [Real]
  have fAReal := FunctionBetween.apply_closed with fFunction, realA
  have gAReal := FunctionBetween.apply_closed with gFunction, realA
  have typedFA : Real(f(A)) by exact fAReal
  have typedGA : Real(g(A)) by exact gAReal
  constructor
  . exact pointwiseMul.function at f, g with fFunction, gFunction
  . intros E realE positiveE
    have typedE : Real(E) by exact realE
    have scaleGReal := limitScale.real with typedGA
    have scaleGPositive := limitScale.positive with typedGA
    have radiusFReal := scaledRadius.real with typedE, scaleGReal
    have radiusFPositive := scaledRadius.positive with positiveE, scaleGPositive
    have absFAReal := abs.real with typedFA
    have boundReal := realAddValue.real with radiusFReal, absFAReal
    have radiusAboveAbs := realLess.add_right with realZero.real, radiusFReal, absFAReal, radiusFPositive
    have zeroPlusAbs := realAddValue.zero_left with absFAReal
    rw zeroPlusAbs at radiusAboveAbs
    have boundPositive := realLe.transitive_less at
      realZero, abs(f(A)),
      scaledRadius(E, limitScale(g(A))) + abs(f(A)) with
        realZero.real, absFAReal, boundReal,
        abs.nonnegative at f(A) with typedFA, radiusAboveAbs
    have radiusGPositive := scaledRadius.positive with positiveE, boundPositive
    obtain ⟨D, realD, positiveD, mapsF⟩ := ContinuousAt.maps_ball with continuousF, radiusFPositive
    obtain ⟨R, realR, positiveR, mapsG⟩ := ContinuousAt.maps_ball with continuousG, radiusGPositive
    have typedD : Real(D) by exact realD
    have typedR : Real(R) by exact realR
    obtain ⟨S, realS, positiveS, sLeD, sLeR⟩ := positiveRadius.common with
      typedD, typedR, positiveD, positiveR
    have typedS : Real(S) by exact realS
    witness S
    constructor
    . exact realS
    . constructor
      . exact positiveS
      . intros X realX near
        have typedX : Real(X) by exact realX
        have nearF := openBall.mono at X, A, S, D with
          typedX, assumption, typedS, typedD, near, sLeD
        have nearG := openBall.mono at X, A, S, R with
          typedX, assumption, typedS, typedR, near, sLeR
        have mappedF := mapsF with X, realX, nearF
        have mappedG := mapsG with X, realX, nearG
        have fXReal := FunctionBetween.apply_closed with fFunction, realX
        have gXReal := FunctionBetween.apply_closed with gFunction, realX
        have typedFX : Real(f(X)) by exact fXReal
        have typedGX : Real(g(X)) by exact gXReal
        have productNear := openBall.mul_control with positiveE, mappedF, mappedG
        have valueX := pointwiseMul.value with typedX, fFunction, gFunction, typedFX, typedGX
        have valueA := pointwiseMul.value at f, g, A with
          assumption, fFunction, gFunction, typedFA, typedGA
        rwa [valueX, valueA]

theorem ContinuousAt.inv (f : Set) (A : Real)
  requires continuous : ContinuousAt(f, A)
  requires nonzero : Nonzero(f(A))
  shows ContinuousAt(pointwiseInv(f), A)
proof
  unfold Nonzero at nonzero
  have function := ContinuousAt.function with continuous
  have realA : A ∈ ℝ by simp [Real]
  have fAReal := FunctionBetween.apply_closed with function, realA
  have typedFA : Real(f(A)) by exact fAReal
  constructor
  . exact pointwiseInv.function at f with function
  . intros E realE positiveE
    have absFAPositive := abs.positive_of_ne with nonzero
    have awayRadiusPositive := half.positive with absFAPositive
    have scalePositive := inverseScale.positive with nonzero
    have epsilonRadiusPositive := scaledRadius.positive with positiveE, scalePositive
    obtain ⟨D, realD, positiveD, mapsAway⟩ := ContinuousAt.maps_ball with continuous, awayRadiusPositive
    obtain ⟨R, realR, positiveR, mapsEpsilon⟩ := ContinuousAt.maps_ball with continuous, epsilonRadiusPositive
    have typedD : Real(D) by exact realD
    have typedR : Real(R) by exact realR
    obtain ⟨S, realS, positiveS, sLeD, sLeR⟩ := positiveRadius.common with
      typedD, typedR, positiveD, positiveR
    have typedS : Real(S) by exact realS
    witness S
    constructor
    . exact realS
    . constructor
      . exact positiveS
      . intros X realX near
        have typedX : Real(X) by exact realX
        have nearAway := openBall.mono at X, A, S, D with
          typedX, assumption, typedS, typedD, near, sLeD
        have nearEpsilon := openBall.mono at X, A, S, R with
          typedX, assumption, typedS, typedR, near, sLeR
        have mappedAway := mapsAway with X, realX, nearAway
        have mappedEpsilon := mapsEpsilon with X, realX, nearEpsilon
        have fXReal := FunctionBetween.apply_closed with function, realX
        have typedFX : Real(f(X)) by exact fXReal
        have inverseNear := openBall.inv_control with nonzero, positiveE, mappedAway, mappedEpsilon
        have valueX := pointwiseInv.value with typedX, function, typedFX
        have valueA := pointwiseInv.value at f, A with
          assumption, function, typedFA
        rwa [valueX, valueA]

-- An epsilon-delta continuous function sends a convergent sequence to a
-- convergent sequence. This is the first bridge between the two viewpoints.
theorem ContinuousAt.converges (f u : Set) (L : Real)
  requires continuous : ContinuousAt(f, L)
  requires converges : ConvergesTo(u, L)
  shows ConvergesTo(
    compose(f, u, ℕ, ℝ, ℝ), f(L))
proof
  have fFunction := ContinuousAt.function with continuous
  have sequence := ConvergesTo.sequence with converges
  unfold RealSequence at sequence
  have realL : L ∈ ℝ by simp [Real]
  have fLReal := FunctionBetween.apply_closed with fFunction
  constructor
  . unfold RealSequence
    exact compose.function with sequence, fFunction
  . intros E realE positive
    obtain ⟨D, realD, positiveD, maps⟩ := ContinuousAt.maps_ball with continuous, positive
    obtain ⟨N, naturalN, close⟩ := ConvergesTo.eventually with converges, positiveD
    witness N
    constructor
    . exact naturalN
    . intros n indexNatural nAfterN
      have unReal := FunctionBetween.apply_closed with sequence, indexNatural
      have near := close with n, indexNatural, nAfterN
      have mapped := maps with u(n), unReal, near
      have value := compose.apply with sequence, fFunction, indexNatural
      rwa value

theorem realNeg.continuous_at (A : Real)
  shows ContinuousAt(realNeg, A)
proof
  constructor
  . exact realNeg.function
  . intros E realE positive
    have typedE : Real(E) by exact realE
    witness E
    constructor
    . exact realE
    . constructor
      . exact positive
      . intros X realX near
        have typedX : Real(X) by exact realX
        have nearData := openBall.membership.forward at A, E, X with near
        rcases nearData with ⟨_, within⟩
        have symmetry := dist.neg at X, A with typedX, assumption
        have negAReal := realNegValue.real at A
        apply openBall.membership.backward
        constructor
        . have negXReal := realNegValue.real with typedX
          exact negXReal
        . rw ← symmetry at within
          exact within

theorem realNeg.continuous
  shows Continuous(realNeg)
proof
  constructor
  . exact realNeg.function
  . intros A realA
    have typedA : Real(A) by exact realA
    exact realNeg.continuous_at with typedA

theorem ContinuousAt.neg (f : Set) (A : Real)
  requires continuous : ContinuousAt(f, A)
  shows ContinuousAt(pointwiseNeg(f), A)
proof
  have function := ContinuousAt.function with continuous
  have realA : A ∈ ℝ by simp [Real]
  have fAReal := FunctionBetween.apply_closed with function, realA
  have typedFA : Real(f(A)) by exact fAReal
  unfold pointwiseNeg
  exact ContinuousAt.comp at realNeg, f, A with
    continuous, realNeg.continuous_at at f(A) with typedFA

theorem pointwiseSub.function (f g : Set)
  requires fFunction : f : ℝ → ℝ
  requires gFunction : g : ℝ → ℝ
  shows pointwiseSub(f, g) : ℝ → ℝ
proof
  have negFunction := pointwiseNeg.function with gFunction
  unfold pointwiseSub
  exact pointwiseAdd.function with fFunction, negFunction

theorem pointwiseSub.value (f g : Set) (X : Real)
  requires fFunction : f : ℝ → ℝ
  requires gFunction : g : ℝ → ℝ
  requires fValueReal : Real(f(X))
  requires gValueReal : Real(g(X))
  shows pointwiseSub(f, g)(X) = f(X) - g(X)
proof
  have negFunction := pointwiseNeg.function with gFunction
  have negValueReal := realNegValue.real with gValueReal
  have negValue := pointwiseNeg.value at g, X with
    assumption, gFunction, gValueReal
  have pointNegReal : Real(pointwiseNeg(g)(X)) by rwa negValue
  have sumValue := pointwiseAdd.value at f, pointwiseNeg(g), X with
    assumption, fFunction, negFunction, fValueReal, pointNegReal
  unfold pointwiseSub
  rw negValue at sumValue
  simp [realSubValue]

theorem pointwiseDiv.function (f g : Set)
  requires fFunction : f : ℝ → ℝ
  requires gFunction : g : ℝ → ℝ
  shows pointwiseDiv(f, g) : ℝ → ℝ
proof
  have inverseFunction := pointwiseInv.function with gFunction
  unfold pointwiseDiv
  exact pointwiseMul.function with fFunction, inverseFunction

theorem pointwiseDiv.value (f g : Set) (X : Real)
  requires fFunction : f : ℝ → ℝ
  requires gFunction : g : ℝ → ℝ
  requires fValueReal : Real(f(X))
  requires gValueReal : Real(g(X))
  shows pointwiseDiv(f, g)(X) = f(X) / g(X)
proof
  have inverseFunction := pointwiseInv.function with gFunction
  have inverseValueReal := realInvValue.real with gValueReal
  have inverseValue := pointwiseInv.value at g, X with
    assumption, gFunction, gValueReal
  have pointInverseReal : Real(pointwiseInv(g)(X)) by rwa inverseValue
  have productValue := pointwiseMul.value at f, pointwiseInv(g), X with
    assumption, fFunction, inverseFunction,
    fValueReal, pointInverseReal
  have division := realDiv.eq_mul_inv with fValueReal, gValueReal
  unfold pointwiseDiv
  rw inverseValue at productValue
  rw division
  exact productValue

theorem ContinuousAt.sub (f g : Set) (A : Real)
  requires continuousF : ContinuousAt(f, A)
  requires continuousG : ContinuousAt(g, A)
  shows ContinuousAt(pointwiseSub(f, g), A)
proof
  have negContinuous := ContinuousAt.neg with continuousG
  unfold pointwiseSub
  exact ContinuousAt.add with continuousF, negContinuous

theorem ContinuousAt.div (f g : Set) (A : Real)
  requires continuousF : ContinuousAt(f, A)
  requires continuousG : ContinuousAt(g, A)
  requires nonzero : Nonzero(g(A))
  shows ContinuousAt(pointwiseDiv(f, g), A)
proof
  have inverseContinuous := ContinuousAt.inv with continuousG, nonzero
  unfold pointwiseDiv
  exact ContinuousAt.mul with continuousF, inverseContinuous

theorem Continuous.neg (f : Set)
  requires continuous : Continuous(f)
  shows Continuous(pointwiseNeg(f))
proof
  rcases continuous with ⟨function, everywhere⟩
  constructor
  . exact pointwiseNeg.function with function
  . intros A realA
    have continuousAt := everywhere with A, realA
    exact ContinuousAt.neg with continuousAt

theorem Continuous.add (f g : Set)
  requires continuousF : Continuous(f)
  requires continuousG : Continuous(g)
  shows Continuous(pointwiseAdd(f, g))
proof
  rcases continuousF with ⟨fFunction, fEverywhere⟩
  rcases continuousG with ⟨gFunction, gEverywhere⟩
  constructor
  . exact pointwiseAdd.function with fFunction, gFunction
  . intros A realA
    have continuousFA := fEverywhere with A, realA
    have continuousGA := gEverywhere with A, realA
    exact ContinuousAt.add with continuousFA, continuousGA

theorem Continuous.sub (f g : Set)
  requires continuousF : Continuous(f)
  requires continuousG : Continuous(g)
  shows Continuous(pointwiseSub(f, g))
proof
  unfold pointwiseSub
  exact Continuous.add at f, pointwiseNeg(g) with
    continuousF, Continuous.neg at g with continuousG

theorem Continuous.mul (f g : Set)
  requires continuousF : Continuous(f)
  requires continuousG : Continuous(g)
  shows Continuous(pointwiseMul(f, g))
proof
  rcases continuousF with ⟨fFunction, fEverywhere⟩
  rcases continuousG with ⟨gFunction, gEverywhere⟩
  constructor
  . exact pointwiseMul.function with fFunction, gFunction
  . intros A realA
    have continuousFA := fEverywhere with A, realA
    have continuousGA := gEverywhere with A, realA
    exact ContinuousAt.mul with continuousFA, continuousGA

theorem Continuous.inv (f : Set)
  requires continuous : Continuous(f)
  requires nonzero : ∀ A ∈ ℝ, Nonzero(f(A))
  shows Continuous(pointwiseInv(f))
proof
  rcases continuous with ⟨function, everywhere⟩
  constructor
  . exact pointwiseInv.function with function
  . intros A realA
    have continuousAt := everywhere with A, realA
    have nonzeroAt := nonzero with A, realA
    exact ContinuousAt.inv with continuousAt, nonzeroAt

theorem Continuous.div (f g : Set)
  requires continuousF : Continuous(f)
  requires continuousG : Continuous(g)
  requires nonzero : ∀ A ∈ ℝ, Nonzero(g(A))
  shows Continuous(pointwiseDiv(f, g))
proof
  have inverseContinuous := Continuous.inv with continuousG, nonzero
  unfold pointwiseDiv
  exact Continuous.mul with continuousF, inverseContinuous

-- Section: LocalOrder
predicate TendsToAt (f : Set) (L A : Real) :=
  FunctionBetween(f, ℝ, ℝ) ∧
  (∀ e ∈ ℝ, 0 < e →
    ∃ d ∈ ℝ, 0 < d ∧
      ∀ x ∈ ℝ, (x ≠ A → x ∈ openBall(A, d) →
        f(x) ∈ openBall(L, e)))

theorem TendsToAt.function (f : Set) (L A : Real)
  requires limit : TendsToAt(f, L, A)
  shows f : ℝ → ℝ
proof
  simp [TendsToAt]

theorem TendsToAt.eventually (f : Set) (L A E : Real)
  requires limit : TendsToAt(f, L, A)
  requires positive : 0 < E
  shows ∃ D ∈ ℝ, 0 < D ∧
    ∀ x ∈ ℝ, (x ≠ A → x ∈ openBall(A, D) →
      f(x) ∈ openBall(L, E))
proof
  rcases limit with ⟨function, local⟩
  exact local with E, positive

-- Continuity supplies a limit after forgetting the value at the center.
theorem ContinuousAt.tends_to (f : Set) (A : Real)
  requires continuous : ContinuousAt(f, A)
  shows TendsToAt(f, f(A), A)
proof
  have function := ContinuousAt.function with continuous
  constructor
  . exact function
  . intros E realE positive
    obtain ⟨D, realD, positiveD, maps⟩ := ContinuousAt.maps_ball with continuous, positive
    witness D
    constructor
    . exact realD
    . constructor
      . exact positiveD
      . intros X realX distinct near
        exact maps with X, realX, near

theorem identity.tends_to_at (A : Real)
  shows TendsToAt(identity(ℝ), A, A)
proof
  have continuous := identity.continuous_at at A
  have limit := ContinuousAt.tends_to with continuous
  have realA : A ∈ ℝ by simp [Real]
  have mapped := identity.relates with realA
  have value := FunctionBetween.apply_value at
    identity(ℝ), ℝ, ℝ, A, A with
      identity.function at ℝ, realA, mapped
  rwa value at limit

-- A punctured limit becomes continuity exactly when the center has the
-- limiting value.  The proof isolates the center as the sole extra case.
theorem TendsToAt.continuous_at (f : Set) (L A : Real)
  requires limit : TendsToAt(f, L, A)
  requires value : f(A) = L
  shows ContinuousAt(f, A)
proof
  have function := TendsToAt.function with limit
  have realA : A ∈ ℝ by simp [Real]
  have fAReal := FunctionBetween.apply_closed with function
  constructor
  . exact function
  . intros E realE positive
    obtain ⟨D, realD, positiveD, maps⟩ := TendsToAt.eventually with limit, positive
    witness D
    constructor
    . exact realD
    . constructor
      . exact positiveD
      . intros X realX near
        have equalityCases : X = A ∨ X ≠ A by tauto
        cases equalityCases with equal | distinct
        . rw equal
          exact openBall.center with positive
        . have mapped := maps with X, realX, distinct, near
          rwa value

-- Limits ignore any change at the center and, more generally, any pointwise
-- replacement away from the center by an equal value.
theorem TendsToAt.congr (f g : Set) (L A : Real)
  requires limit : TendsToAt(f, L, A)
  requires gFunction : g : ℝ → ℝ
  requires equalAway : ∀ x ∈ ℝ, (x ≠ A → g(x) = f(x))
  shows TendsToAt(g, L, A)
proof
  constructor
  . exact gFunction
  . intros E realE positive
    obtain ⟨D, realD, positiveD, maps⟩ := TendsToAt.eventually with limit, positive
    witness D
    constructor
    . exact realD
    . constructor
      . exact positiveD
      . intros X realX distinct near
        have equal := equalAway with X, realX, distinct
        rw equal
        exact maps with X, realX, distinct, near

theorem TendsToAt.neg (f : Set) (L A : Real)
  requires limit : TendsToAt(f, L, A)
  shows TendsToAt(pointwiseNeg(f), -L, A)
proof
  have function := TendsToAt.function with limit
  have negLReal := realNegValue.real at L
  constructor
  . exact pointwiseNeg.function with function
  . intros E realE positive
    have typedE : Real(E) by exact realE
    obtain ⟨D, realD, positiveD, maps⟩ := TendsToAt.eventually with limit, positive
    witness D
    constructor
    . exact realD
    . constructor
      . exact positiveD
      . intros X realX distinct near
        have mapped := maps with X, realX, distinct, near
        have fXInReals := FunctionBetween.apply_closed with function, realX
        have typedFX : Real(f(X)) by exact fXInReals
        have value := pointwiseNeg.value with function
        have negDistance := dist.neg at f(X), L with
          typedFX, assumption
        apply openBall.membership.backward
        have mappedData := openBall.membership.forward at
          L, E, f(X) with mapped
        rcases mappedData with ⟨realFX, within⟩
        constructor
        . rw value
          exact realNegValue.real with typedFX
        . rw [value, negDistance]
          exact within

theorem TendsToAt.add (f g : Set) (L M A : Real)
  requires limitF : TendsToAt(f, L, A)
  requires limitG : TendsToAt(g, M, A)
  shows TendsToAt(pointwiseAdd(f, g), L + M, A)
proof
  have fFunction := TendsToAt.function with limitF
  have gFunction := TendsToAt.function with limitG
  constructor
  . exact pointwiseAdd.function with fFunction, gFunction
  . intros E realE positive
    have typedE : Real(E) by exact realE
    have radiusPositive := half.positive with positive
    obtain ⟨D, realD, positiveD, mapsF⟩ := TendsToAt.eventually with limitF, radiusPositive
    obtain ⟨R, realR, positiveR, mapsG⟩ := TendsToAt.eventually with limitG, radiusPositive
    have typedD : Real(D) by exact realD
    have typedR : Real(R) by exact realR
    obtain ⟨S, realS, positiveS, sLeD, sLeR⟩ := positiveRadius.common with
      typedD, typedR, positiveD, positiveR
    have typedS : Real(S) by exact realS
    witness S
    constructor
    . exact realS
    . constructor
      . exact positiveS
      . intros X realX distinct near
        have typedX : Real(X) by exact realX
        have nearF := openBall.mono at X, A, S, D with
          typedX, assumption, typedS, typedD, near, sLeD
        have nearG := openBall.mono at X, A, S, R with
          typedX, assumption, typedS, typedR, near, sLeR
        have mappedF := mapsF with X, realX, distinct, nearF
        have mappedG := mapsG with X, realX, distinct, nearG
        have fXInReals := FunctionBetween.apply_closed with fFunction, realX
        have gXInReals := FunctionBetween.apply_closed with gFunction, realX
        have typedGX : Real(g(X)) by exact gXInReals
        have sumNear := openBall.add with mappedF, mappedG
        have doubled := half.add_self with typedE
        rw doubled at sumNear
        have value := pointwiseAdd.value with fFunction, gFunction
        rwa value

-- Products of convergent real functions converge to the product.  The
-- asymmetric radii are the familiar textbook estimate: first control f,
-- then use that control to bound the coefficient multiplying g - M.
theorem TendsToAt.mul (f g : Set) (L M A : Real)
  requires limitF : TendsToAt(f, L, A)
  requires limitG : TendsToAt(g, M, A)
  shows TendsToAt(pointwiseMul(f, g), L * M, A)
proof
  have fFunction := TendsToAt.function with limitF
  have gFunction := TendsToAt.function with limitG
  constructor
  . exact pointwiseMul.function with fFunction, gFunction
  . intros E realE positiveE
    have typedE : Real(E) by exact realE
    have scaleMReal := limitScale.real at M
    have scaleMPositive := limitScale.positive at M
    have radiusFReal := scaledRadius.real with typedE, scaleMReal
    have radiusFPositive := scaledRadius.positive with positiveE, scaleMPositive
    have absLReal := abs.real at L
    have boundReal := realAddValue.real with radiusFReal, absLReal
    have radiusAboveAbs := realLess.add_right with realZero.real, radiusFReal, absLReal, radiusFPositive
    have zeroPlusAbs := realAddValue.zero_left with absLReal
    rw zeroPlusAbs at radiusAboveAbs
    have boundPositive := realLe.transitive_less at
      realZero, abs(L), scaledRadius(E, limitScale(M)) + abs(L) with
        realZero.real, absLReal, boundReal,
        abs.nonnegative at L with assumption, radiusAboveAbs
    have radiusGPositive := scaledRadius.positive with positiveE, boundPositive
    obtain ⟨D, realD, positiveD, mapsF⟩ := TendsToAt.eventually with limitF, radiusFPositive
    obtain ⟨R, realR, positiveR, mapsG⟩ := TendsToAt.eventually with limitG, radiusGPositive
    have typedD : Real(D) by exact realD
    have typedR : Real(R) by exact realR
    obtain ⟨S, realS, positiveS, sLeD, sLeR⟩ := positiveRadius.common with
      typedD, typedR, positiveD, positiveR
    have typedS : Real(S) by exact realS
    witness S
    constructor
    . exact realS
    . constructor
      . exact positiveS
      . intros X realX distinct near
        have typedX : Real(X) by exact realX
        have nearF := openBall.mono at X, A, S, D with
          typedX, assumption, typedS, typedD, near, sLeD
        have nearG := openBall.mono at X, A, S, R with
          typedX, assumption, typedS, typedR, near, sLeR
        have mappedF := mapsF with X, realX, distinct, nearF
        have mappedG := mapsG with X, realX, distinct, nearG
        have fXReal := FunctionBetween.apply_closed with fFunction, realX
        have gXReal := FunctionBetween.apply_closed with gFunction, realX
        have typedGX : Real(g(X)) by exact gXReal
        have productNear := openBall.mul_control with positiveE, mappedF, mappedG
        have value := pointwiseMul.value with fFunction, gFunction
        rwa value

theorem TendsToAt.sub (f g : Set) (L M A : Real)
  requires limitF : TendsToAt(f, L, A)
  requires limitG : TendsToAt(g, M, A)
  shows TendsToAt(pointwiseSub(f, g), L - M, A)
proof
  have negLimit := TendsToAt.neg with limitG
  have sumLimit := TendsToAt.add with limitF, negLimit
  unfold pointwiseSub
  unfold realSubValue
  exact sumLimit

-- Every positive ball around a real point contains a different point.
theorem openBall.punctured_real (A R : Real)
  requires positive : 0 < R
  shows ∃ X ∈ ℝ, X ≠ A ∧ X ∈ openBall(A, R)
proof
  have halfReal := half.real at R
  have halfPositive := half.positive with positive
  have halfLess := half.lt_self with positive
  have xReal := realAddValue.real at A, half(R) with assumption, halfReal
  have realX : A + half(R) ∈ ℝ by exact xReal
  have offset : (A + half(R)) - A = half(R) by ring
  have distinct : A + half(R) ≠ A
    intro equal
    rw equal at offset
    have self := realSubValue.self at A
    rw self at offset
    rw ← offset at halfPositive
    exact IsOrderedField.irreflexive with reals.ordered_field, halfPositive
  have halfNonnegative := realLess.implies_le with halfPositive
  have absHalf := abs.of_nonnegative with halfNonnegative
  have near : A + half(R) ∈ openBall(A, R)
    have distanceLess : dist(A + half(R), A) < R
      unfold dist
      rwa [offset, absHalf]
    have data : A + half(R) ∈ ℝ ∧ dist(A + half(R), A) < R
      constructor
      . exact realX
      . exact distanceLess
    exact openBall.membership.backward with data
  witness A + half(R)
  refine ⟨realX, distinct, near⟩

theorem TendsToAt.unique (f : Set) (L M A : Real)
  requires first : TendsToAt(f, L, A)
  requires second : TendsToAt(f, M, A)
  shows L = M
proof
  by_contra unequal
  have positiveDistance := dist.positive_of_ne with unequal
  have radiusPositive := half.positive with positiveDistance
  obtain ⟨D, realD, positiveD, mapsL⟩ := TendsToAt.eventually with first, radiusPositive
  obtain ⟨E, realE, positiveE, mapsM⟩ := TendsToAt.eventually with second, radiusPositive
  have typedD : Real(D) by exact realD
  have typedE : Real(E) by exact realE
  obtain ⟨R, realR, positiveR, rLeD, rLeE⟩ := positiveRadius.common with positiveD, positiveE
  have typedR : Real(R) by exact realR
  obtain ⟨X, realX, distinct, near⟩ := openBall.punctured_real at A, R with
    positiveR
  have typedX : Real(X) by exact realX
  have nearD := openBall.mono at X, A, R, D with
    typedX, assumption, typedR, typedD, near, rLeD
  have nearE := openBall.mono at X, A, R, E with
    typedX, assumption, typedR, typedE, near, rLeE
  have nearL := mapsL with X, realX, distinct, nearD
  have nearM := mapsM with X, realX, distinct, nearE
  have function := TendsToAt.function with first
  have valueReal := FunctionBetween.apply_closed with function, realX
  have equal := openBall.half_radius_unique with nearL, nearM
  exact unequal with equal

-- LocalOrder
predicate Positive (A : Real) := 0 < A
predicate Negative (A : Real) := A < 0
predicate Below (A B : Real) := A < B

theorem Positive.characterization (A : Real)
  shows Positive(A) ↔ 0 < A
proof
  simp [Positive]

theorem Negative.characterization (A : Real)
  shows Negative(A) ↔ A < 0
proof
  simp [Negative]

theorem Below.characterization (A B : Real)
  shows Below(A, B) ↔ A < B
proof
  simp [Below]

-- A continuous function which is positive at a point remains positive on a
-- whole neighborhood.  Taking f(A) itself as epsilon makes the lower endpoint
-- of the target interval exactly zero.
theorem ContinuousAt.eventually_positive (f : Set) (A : Real)
  requires continuous : ContinuousAt(f, A)
  requires positive : Positive(f(A))
  shows ∃ D ∈ ℝ, 0 < D ∧
    ∀ x ∈ ℝ, (x ∈ openBall(A, D) → Positive(f(x)))
proof
  unfold Positive at positive
  have function := ContinuousAt.function with continuous
  have valueReal := ContinuousAt.value_type with continuous
  obtain ⟨D, realD, positiveD, maps⟩ := ContinuousAt.maps_ball with continuous, positive
  witness D
  constructor
  . exact realD
  . constructor
    . exact positiveD
    . intros X realX near
      unfold Positive
      have fXReal := FunctionBetween.apply_closed with function, realX
      have mapped := maps with X, realX, near
      obtain ⟨lower, upper⟩ := openBall.order_characterization.forward with mapped
      have selfDifference := realSubValue.self with valueReal
      rwa selfDifference at lower

theorem ContinuousAt.eventually_negative (f : Set) (A : Real)
  requires continuous : ContinuousAt(f, A)
  requires negative : Negative(f(A))
  shows ∃ D ∈ ℝ, 0 < D ∧
    ∀ x ∈ ℝ, (x ∈ openBall(A, D) → Negative(f(x)))
proof
  unfold Negative at negative
  have function := ContinuousAt.function with continuous
  have valueReal := ContinuousAt.value_type with continuous
  have negativeView := realLess.characterization.forward with negative
  have reversedView := RealLess.neg_reverse with negativeView
  have reversed := realLess.characterization.backward with reversedView
  have negZero := realNegValue.zero
  rw negZero at reversed
  obtain ⟨D, realD, positiveD, maps⟩ := ContinuousAt.maps_ball with continuous, reversed
  witness D
  constructor
  . exact realD
  . constructor
    . exact positiveD
    . intros X realX near
      unfold Negative
      have fXReal := FunctionBetween.apply_closed with function, realX
      have mapped := maps with X, realX, near
      obtain ⟨lower, upper⟩ := openBall.order_characterization.forward with mapped
      have inverse := realAddValue.neg_right with valueReal
      rwa inverse at upper

-- Nonvanishing is the sign-free form used for reciprocal and quotient
-- arguments.  Connectedness of the real order chooses the relevant sign.
theorem ContinuousAt.eventually_nonzero (f : Set) (A : Real)
  requires continuous : ContinuousAt(f, A)
  requires nonzero : Nonzero(f(A))
  shows ∃ D ∈ ℝ, 0 < D ∧
    ∀ x ∈ ℝ, (x ∈ openBall(A, D) → Nonzero(f(x)))
proof
  have function := ContinuousAt.function with continuous
  have valueReal := ContinuousAt.value_type with continuous
  have valueInReals : f(A) ∈ ℝ by exact valueReal
  have zeroInReals : realZero ∈ ℝ by exact realZero.real
  have comparison := realLess.connected_on
  specialize comparison with
    f(A), valueInReals, realZero, zeroInReals, nonzero
  cases comparison with negative | positive
  . have negativeAt := Negative.characterization.backward at
      f(A) with negative
    obtain ⟨D, realD, positiveD, staysNegative⟩ := ContinuousAt.eventually_negative with
      continuous, negativeAt
    witness D
    constructor
    . exact realD
    . constructor
      . exact positiveD
      . intros X realX near
        unfold Nonzero
        have below := staysNegative with X, realX, near
        unfold Negative at below
        have fXReal := FunctionBetween.apply_closed with function, realX
        exact IsOrderedField.ne_of_less with reals.ordered_field, fXReal, below
  . have positiveAt := Positive.characterization.backward at
      f(A) with positive
    obtain ⟨R, realR, positiveR, staysPositive⟩ := ContinuousAt.eventually_positive with
      continuous, positiveAt
    witness R
    constructor
    . exact realR
    . constructor
      . exact positiveR
      . intros X realX near
        unfold Nonzero
        have above := staysPositive with X, realX, near
        unfold Positive at above
        intro equal
        rw equal at above
        exact IsOrderedField.irreflexive with reals.ordered_field, above

-- Strict inequalities between continuous functions persist locally.  The
-- proof is the handwritten one: g - f is continuous and positive at A.
theorem ContinuousAt.eventually_lt (f g : Set) (A : Real)
  requires continuousF : ContinuousAt(f, A)
  requires continuousG : ContinuousAt(g, A)
  requires less : Below(f(A), g(A))
  shows ∃ D ∈ ℝ, 0 < D ∧
    ∀ x ∈ ℝ, (x ∈ openBall(A, D) → Below(f(x), g(x)))
proof
  unfold Below at less
  have fFunction := ContinuousAt.function with continuousF
  have gFunction := ContinuousAt.function with continuousG
  have fAReal := ContinuousAt.value_type with continuousF
  have gAReal := ContinuousAt.value_type with continuousG
  have differenceContinuous := ContinuousAt.sub with continuousG, continuousF
  have valueAtA := pointwiseSub.value at g, f, A with
    assumption, gFunction, fFunction, gAReal, fAReal
  have positiveDifference := realLess.iff_pos_sub.forward with fAReal, gAReal, less
  rw ← valueAtA at positiveDifference
  have differencePositive := Positive.characterization.backward with positiveDifference
  obtain ⟨D, realD, positiveD, staysPositive⟩ := ContinuousAt.eventually_positive with
    differenceContinuous, differencePositive
  witness D
  constructor
  . exact realD
  . constructor
    . exact positiveD
    . intros X realX near
      unfold Below
      have typedX : Real(X) by exact realX
      have fXReal := FunctionBetween.apply_closed with fFunction, realX
      have gXReal := FunctionBetween.apply_closed with gFunction, realX
      have typedFX : Real(f(X)) by exact fXReal
      have typedGX : Real(g(X)) by exact gXReal
      have positiveAtX := staysPositive with X, realX, near
      unfold Positive at positiveAtX
      have valueAtX := pointwiseSub.value with typedX, gFunction, fFunction, typedGX, typedFX
      rw valueAtX at positiveAtX
      exact realLess.iff_pos_sub.backward with positiveAtX
