module Grace.Cumulus.Real.Analysis.Intervals
import Continuity

-- Section: Intervals
def closedInterval (A B : Real) : Set :=
  { X ∈ ℝ | A ≤ X ∧ X ≤ B }

theorem closedInterval.membership (X : Set) (A B : Real)
  shows X ∈ closedInterval(A, B) ↔
    (X ∈ ℝ ∧ A ≤ X ∧ X ≤ B)
proof
  simp

theorem closedInterval.subset_reals (A B : Real)
  shows closedInterval(A, B) ⊆ ℝ
proof
  intros X member
  obtain ⟨realX, lower, upper⟩ := closedInterval.membership.forward with member
  exact realX

theorem closedInterval.left_mem (A B : Real)
  requires ordered : A ≤ B
  shows A ∈ closedInterval(A, B)
proof
  have realA : A ∈ ℝ by simp [Real]
  have reflexive := realLe.reflexive at A
  have data : A ∈ ℝ ∧ A ≤ A ∧ A ≤ B
    constructor
    . exact realA
    . constructor
      . exact reflexive
      . exact ordered
  exact closedInterval.membership.backward with data

theorem closedInterval.right_mem (A B : Real)
  requires ordered : A ≤ B
  shows B ∈ closedInterval(A, B)
proof
  have realB : B ∈ ℝ by simp [Real]
  have reflexive := realLe.reflexive at B
  have data : B ∈ ℝ ∧ A ≤ B ∧ B ≤ B
    constructor
    . exact realB
    . constructor
      . exact ordered
      . exact reflexive
  exact closedInterval.membership.backward with data

theorem closedInterval.nonempty_iff (A B : Real)
  shows (∃ X, X ∈ closedInterval(A, B)) ↔ A ≤ B
proof
  constructor
  . intro inhabited
    obtain ⟨X, member⟩ := inhabited
    obtain ⟨realX, lower, upper⟩ := closedInterval.membership.forward with member
    exact realLe.transitive with lower, upper
  . intro ordered
    witness A
    exact closedInterval.left_mem with ordered

theorem closedInterval.nested (A B C D : Real)
  requires left : C ≤ A
  requires right : B ≤ D
  shows closedInterval(A, B) ⊆ closedInterval(C, D)
proof
  intros X member
  obtain ⟨realX, lower, upper⟩ := closedInterval.membership.forward with member
  have typedX : Real(X) by exact realX
  have lowerBound := realLe.transitive at C, A, X with
    *{2}, typedX, left, lower
  have upperBound := realLe.transitive with upper, right
  have result : X ∈ ℝ ∧ C ≤ X ∧ X ≤ D
    constructor
    . exact realX
    . constructor
      . exact lowerBound
      . exact upperBound
  exact closedInterval.membership.backward with result

-- Continuity within S only asks about arguments of S near A. This is the
-- natural endpoint notion for functions on a closed interval.
predicate ContinuousWithinAt (f S : Set) (A : Real) :=
  FunctionBetween(f, ℝ, ℝ) ∧ S ⊆ ℝ ∧
  (∀ E ∈ ℝ, 0 < E →
    ∃ D ∈ ℝ, 0 < D ∧
      ∀ X ∈ ℝ, (X ∈ S → (X ∈ openBall(A, D) →
        f(X) ∈ openBall(f(A), E))))

predicate ContinuousOn (f S : Set) :=
  FunctionBetween(f, ℝ, ℝ) ∧ S ⊆ ℝ ∧
  (∀ A ∈ S, ContinuousWithinAt(f, S, A))

-- Uniform continuity chooses one input radius for every pair of points of S.
predicate UniformContinuousOn (f S : Set) :=
  FunctionBetween(f, ℝ, ℝ) ∧ S ⊆ ℝ ∧
  (∀ E ∈ ℝ, 0 < E →
    ∃ D ∈ ℝ, 0 < D ∧
      ∀ X ∈ ℝ, (X ∈ S →
        ∀ Y ∈ ℝ, (Y ∈ S → (X ∈ openBall(Y, D) →
          f(X) ∈ openBall(f(Y), E)))))

theorem ContinuousAt.continuous_within_at (f S : Set) (A : Real)
  requires continuous : ContinuousAt(f, A)
  requires subset : S ⊆ ℝ
  shows ContinuousWithinAt(f, S, A)
proof
  constructor
  . exact ContinuousAt.function with continuous
  . constructor
    . exact subset
    . intros E realE positive
      obtain ⟨D, realD, positiveD, maps⟩ := ContinuousAt.maps_ball with continuous, positive
      witness D
      constructor
      . exact realD
      . constructor
        . exact positiveD
        . intros X realX member near
          exact maps with X, realX, near

theorem Continuous.continuous_on (f S : Set)
  requires continuous : Continuous(f)
  requires subset : S ⊆ ℝ
  shows ContinuousOn(f, S)
proof
  constructor
  . exact Continuous.function with continuous
  . constructor
    . exact subset
    . intros A member
      have subsetLaw := subset
      have realA := subsetLaw with A, member
      have typedA : Real(A)
        unfold Real
        exact realA
      have atA := Continuous.at with continuous
      exact ContinuousAt.continuous_within_at with atA, subset

theorem UniformContinuousOn.continuous_on (f S : Set)
  requires uniform : UniformContinuousOn(f, S)
  shows ContinuousOn(f, S)
proof
  rcases uniform with ⟨function, subset, control⟩
  constructor
  . exact function
  . constructor
    . exact subset
    . intros A member
      have subsetLaw := subset
      have realA := subsetLaw with A, member
      constructor
      . exact function
      . constructor
        . exact subset
        . intros E realE positive
          obtain ⟨D, realD, positiveD, maps⟩ :=
            control with E, realE, positive
          witness D
          constructor
          . exact realD
          . constructor
            . exact positiveD
            . intros X realX xMember near
              exact maps with X, realX, xMember, A, realA, member, near

theorem identity.uniform_continuous_on (S : Set)
  requires subset : S ⊆ ℝ
  shows UniformContinuousOn(identity(ℝ), S)
proof
  have function := identity.function at ℝ
  constructor
  . exact function
  . constructor
    . exact subset
    . intros E realE positive
      witness E
      constructor
      . exact realE
      . constructor
        . exact positive
        . intros X realX xMember Y realY yMember near
          have mappedX := identity.relates with realX
          have valueX := FunctionBetween.apply_value with function, realX, mappedX
          have mappedY := identity.relates with realY
          have valueY := FunctionBetween.apply_value with function, realY, mappedY
          rwa [valueX, valueY]

theorem constantFunction.uniform_continuous_on (S : Set) (L : Real)
  requires subset : S ⊆ ℝ
  shows UniformContinuousOn(constantFunction(ℝ, ℝ, L), S)
proof
  have realL : L ∈ ℝ by simp [Real]
  have function := constantFunction.function at ℝ, ℝ, L with realL
  constructor
  . exact function
  . constructor
    . exact subset
    . intros E realE positive
      witness E
      constructor
      . exact realE
      . constructor
        . exact positive
        . intros X realX xMember Y realY yMember near
          have valueX := constantFunction.apply with realX, realL
          have valueY := constantFunction.apply with realY, realL
          rw [valueX, valueY]
          exact openBall.center with positive

-- On a closed interval the identity is continuous at both endpoints in the
-- relative sense used by integration.
theorem closedInterval.identity_continuous (A B : Real)
  shows ContinuousOn(identity(ℝ), closedInterval(A, B))
proof
  have subset := closedInterval.subset_reals at A, B with
    *{2}
  have uniform := identity.uniform_continuous_on with subset
  exact UniformContinuousOn.continuous_on with uniform

-- Relative continuity has the same arithmetic closure as global continuity.
-- Keeping the set membership guard inside the epsilon-delta argument makes
-- these rules valid at interval endpoints.
theorem ContinuousWithinAt.maps_ball (f S : Set) (A E : Real)
  requires continuous : ContinuousWithinAt(f, S, A)
  requires positive : 0 < E
  shows ∃ D ∈ ℝ, 0 < D ∧ (∀ X ∈ ℝ, X ∈ S → X ∈ openBall(A, D) → f(X) ∈ openBall(f(A), E))
proof
  rcases continuous with ⟨function, subset, maps⟩
  exact maps with E, positive

theorem ContinuousWithinAt.function (f S : Set) (A : Real)
  requires continuous : ContinuousWithinAt(f, S, A)
  shows f : ℝ → ℝ
proof
  rcases continuous with ⟨function, subset, maps⟩
  exact function

theorem ContinuousWithinAt.add (f g S : Set) (A : Real)
  requires continuousF : ContinuousWithinAt(f, S, A)
  requires continuousG : ContinuousWithinAt(g, S, A)
  shows ContinuousWithinAt(pointwiseAdd(f, g), S, A)
proof
  have fFunction := ContinuousWithinAt.function with continuousF
  have gFunction := ContinuousWithinAt.function with continuousG
  have realA : A ∈ ℝ by simp [Real]
  have subset : S ⊆ ℝ
    rcases continuousF with ⟨graph, subsetF, maps⟩
    exact subsetF
  constructor
  . exact pointwiseAdd.function with fFunction, gFunction
  . constructor
    . exact subset
    . intros E realE positive
      have typedE : Real(E) by exact realE
      have radiusPositive := half.positive with positive
      obtain ⟨D, realD, positiveD, mapsF⟩ := ContinuousWithinAt.maps_ball with continuousF, radiusPositive
      obtain ⟨R, realR, positiveR, mapsG⟩ := ContinuousWithinAt.maps_ball with continuousG, radiusPositive
      have typedD : Real(D) by exact realD
      have typedR : Real(R) by exact realR
      obtain ⟨Q, realS, positiveS, sLeD, sLeR⟩ := positiveRadius.common with
        typedD, typedR, positiveD, positiveR
      have typedS : Real(Q) by exact realS
      witness Q
      constructor
      . exact realS
      . constructor
        . exact positiveS
        . intros X realX member near
          have typedX : Real(X) by exact realX
          have nearF := openBall.mono at X, A, Q, D with
            typedX, assumption, typedS, typedD, near, sLeD
          have nearG := openBall.mono at X, A, Q, R with
            typedX, assumption, typedS, typedR, near, sLeR
          have mappedF := mapsF with X, realX, member, nearF
          have mappedG := mapsG with X, realX, member, nearG
          have fXReal := FunctionBetween.apply_closed with fFunction, realX
          have gXReal := FunctionBetween.apply_closed with gFunction, realX
          have fAReal := FunctionBetween.apply_closed with fFunction, realA
          have gAReal := FunctionBetween.apply_closed with gFunction, realA
          have typedFX : Real(f(X)) by exact fXReal
          have typedGX : Real(g(X)) by exact gXReal
          have typedFA : Real(f(A)) by exact fAReal
          have typedGA : Real(g(A)) by exact gAReal
          have sumNear := openBall.add with mappedF, mappedG
          have doubled := half.add_self with typedE
          rw doubled at sumNear
          have valueX := pointwiseAdd.value with typedX, fFunction, gFunction, typedFX, typedGX
          have valueA := pointwiseAdd.value at f, g, A with
            assumption, fFunction, gFunction, typedFA, typedGA
          rwa [valueX, valueA]

theorem ContinuousWithinAt.mul (f g S : Set) (A : Real)
  requires continuousF : ContinuousWithinAt(f, S, A)
  requires continuousG : ContinuousWithinAt(g, S, A)
  shows ContinuousWithinAt(pointwiseMul(f, g), S, A)
proof
  have fFunction := ContinuousWithinAt.function with continuousF
  have gFunction := ContinuousWithinAt.function with continuousG
  have realA : A ∈ ℝ by simp [Real]
  have fAReal := FunctionBetween.apply_closed with fFunction, realA
  have gAReal := FunctionBetween.apply_closed with gFunction, realA
  have typedFA : Real(f(A)) by exact fAReal
  have typedGA : Real(g(A)) by exact gAReal
  have subset : S ⊆ ℝ
    rcases continuousF with ⟨graph, subsetF, maps⟩
    exact subsetF
  constructor
  . exact pointwiseMul.function at f, g with fFunction, gFunction
  . constructor
    . exact subset
    . intros E realE positiveE
      have typedE : Real(E) by exact realE
      have scaleGReal := limitScale.real with typedGA
      have scaleGPositive := limitScale.positive with typedGA
      have radiusFReal := scaledRadius.real with typedE, scaleGReal
      have radiusFPositive := scaledRadius.positive with positiveE, scaleGPositive
      have absFAReal := abs.real with typedFA
      have boundReal := realAddValue.real with radiusFReal, absFAReal
      have radiusAboveAbs := realLess.add_right with realZero.real, radiusFReal, absFAReal, radiusFPositive
      have zeroPlusAbs := realAddValue.zero_left with absFAReal
      rw zeroPlusAbs at radiusAboveAbs
      have boundPositive := realLe.transitive_less at
        realZero, abs(f(A)),
        scaledRadius(E, limitScale(g(A))) + abs(f(A)) with
          realZero.real, absFAReal, boundReal,
          abs.nonnegative at f(A) with typedFA, radiusAboveAbs
      have radiusGPositive := scaledRadius.positive with positiveE, boundPositive
      obtain ⟨D, realD, positiveD, mapsF⟩ := ContinuousWithinAt.maps_ball with continuousF, radiusFPositive
      obtain ⟨R, realR, positiveR, mapsG⟩ := ContinuousWithinAt.maps_ball with continuousG, radiusGPositive
      have typedD : Real(D) by exact realD
      have typedR : Real(R) by exact realR
      obtain ⟨Q, realS, positiveS, sLeD, sLeR⟩ := positiveRadius.common with
        typedD, typedR, positiveD, positiveR
      have typedS : Real(Q) by exact realS
      witness Q
      constructor
      . exact realS
      . constructor
        . exact positiveS
        . intros X realX member near
          have typedX : Real(X) by exact realX
          have nearF := openBall.mono at X, A, Q, D with
            typedX, assumption, typedS, typedD, near, sLeD
          have nearG := openBall.mono at X, A, Q, R with
            typedX, assumption, typedS, typedR, near, sLeR
          have mappedF := mapsF with X, realX, member, nearF
          have mappedG := mapsG with X, realX, member, nearG
          have fXReal := FunctionBetween.apply_closed with fFunction, realX
          have gXReal := FunctionBetween.apply_closed with gFunction, realX
          have typedFX : Real(f(X)) by exact fXReal
          have typedGX : Real(g(X)) by exact gXReal
          have productNear := openBall.mul_control with positiveE, mappedF, mappedG
          have valueX := pointwiseMul.value with typedX, fFunction, gFunction, typedFX, typedGX
          have valueA := pointwiseMul.value at f, g, A with
            assumption, fFunction, gFunction, typedFA, typedGA
          rw valueX
        rwa valueA

theorem ContinuousOn.add (f g S : Set)
  requires continuousF : ContinuousOn(f, S)
  requires continuousG : ContinuousOn(g, S)
  shows ContinuousOn(pointwiseAdd(f, g), S)
proof
  rcases continuousF with ⟨fFunction, subset, fEverywhere⟩
  rcases continuousG with ⟨gFunction, gSubset, gEverywhere⟩
  constructor
  . exact pointwiseAdd.function with fFunction, gFunction
  . constructor
    . exact subset
    . intros A member
      have realA : A ∈ ℝ by exact subset with A, member
      have atF := fEverywhere with A, member
      have atG := gEverywhere with A, member
      exact ContinuousWithinAt.add with atF, atG

theorem ContinuousOn.mul (f g S : Set)
  requires continuousF : ContinuousOn(f, S)
  requires continuousG : ContinuousOn(g, S)
  shows ContinuousOn(pointwiseMul(f, g), S)
proof
  rcases continuousF with ⟨fFunction, subset, fEverywhere⟩
  rcases continuousG with ⟨gFunction, gSubset, gEverywhere⟩
  constructor
  . exact pointwiseMul.function with fFunction, gFunction
  . constructor
    . exact subset
    . intros A member
      have realA : A ∈ ℝ by exact subset with A, member
      have atF := fEverywhere with A, member
      have atG := gEverywhere with A, member
      exact ContinuousWithinAt.mul with atF, atG
