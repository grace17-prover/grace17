module Grace.Cumulus.Real.Analysis.TriangularSeries
import ArchimedeanLimits

-- The partial sums 2n/(n + 1) are twice the successor ratios.
theorem triangularSeries.partial_sums (n : Nat)
  shows prefixSums(triangularReciprocals)[n] =
    mulSequence(constantSequence((2:R)), successorRatios)[n]
proof
  have sequence := triangularReciprocals.sequence
  have ratios := successorRatios.sequence
  have constants := constantSequence.sequence at (2:R)
  have constantReal := RealSequence.value at constantSequence((2:R)), n with
    constants
  have ratioReal := RealSequence.value at successorRatios, n with ratios
  have product := mulSequence.value at
    constantSequence((2:R)), successorRatios, n with
      constants, ratios, constantReal, ratioReal
  have constant := constantSequence.value at (2:R), n with *
  have ratio := successorRatios.value at n
  have value := prefixSums.value at triangularReciprocals, n with sequence
  have formula := realPartialSum.triangular_reciprocals at n
  have countReal := realNat.real at n
  have numeratorReal : (2:R) * (realNat(n):R) ∈ ℝ by typecheck
  have denominatorReal : (realNat(n):R) + 1 ∈ ℝ by typecheck
  have inverseReal := realInvValue.real at (realNat(n):R) + 1
  have regroup : (2:R) * (realNat(n):R) / ((realNat(n):R) + 1) =
      (2:R) * ((realNat(n):R) / ((realNat(n):R) + 1))
    have first := realDiv.eq_mul_inv at
      (2:R) * (realNat(n):R), (realNat(n):R) + 1 with *
    have second := realDiv.eq_mul_inv at
      (realNat(n):R), (realNat(n):R) + 1 with *
    rw [first, second]
    ring
  rw [value, formula, product, constant, ratio, regroup]
  rfl

-- Σ_{k=1}^{∞} 1/T_k = 2, where T_k = k(k + 1)/2.
theorem triangularReciprocals.sums_to
  shows SumsTo(triangularReciprocals, (2:R))
proof
  have sequence := triangularReciprocals.sequence
  have prefixes := prefixSums.sequence with sequence
  have constants := constantSequence.converges at (2:R)
  have limit := ConvergesTo.mul with constants, successorRatios.converges_one
  have one := realMulValue.one_right at (2:R)
  rw one at limit
  have equal : ∀ n ∈ ℕ, prefixSums(triangularReciprocals)[n] =
      mulSequence(constantSequence((2:R)), successorRatios)[n]
    intros n naturalN
    have typedN : Nat(n) by exact nat.omega.backward at n with naturalN
    exact triangularSeries.partial_sums at n
  have converges := ConvergesTo.of_equal_terms with prefixes, limit, equal
  exact SumsTo.of_converges with sequence, converges
