module Grace.Cumulus.Real.Multiplication
import Negation

-- The multiplicative unit is the rational cut at one, with its
-- overloaded numeral available as soon as the real carrier is known.
def realOne : Real := rationalCut(rationalOne)

theorem realOne.real
  shows Real(realOne)
proof
  unfold realOne
  exact rationalCut.real with rationalOne.rational

instance realOne.of_nat
  shows OfNat(ℝ, 1, realOne)
proof
  constructor
  . typecheck
  . exact realOne.real

notation numeral "1" via OfNat(ℝ, 1, _) for Real

theorem realZero.lt_one
  shows 0 < realOne
proof
  have rationalPositive := rationalLess.positive_natural_successor with Naturals.constructor.zero
  have zeroLessOne : rationalZero < rationalOne by simpa [rationalOne] using rationalPositive
  have strict := rationalCut.strict_mono with rationalZero.rational, rationalOne.rational, zeroLessOne
  apply realLess.characterization.backward
  unfold realZero
  unfold realOne
  exact strict

theorem realZero.ne_one
  shows realZero ≠ realOne
proof
  intro equal
  have positive := realZero.lt_one
  rw equal at positive
  have impossible := realLess.irreflexive_on
  exact impossible with realOne, positive

-- For nonnegative cuts A and B, their product contains every negative
-- rational and every rational strictly below a product of positive members.
-- The explicit rational bounds on a and b make all arithmetic notation
-- independently readable and resolvable.
def realPosMulCut (A B : Set) : Set :=
  { q ∈ ℚ |
    q < rationalZero ∨
    ∃ a ∈ ℚ, a ∈ A ∧ ∃ b ∈ ℚ, b ∈ B ∧
      rationalZero < a ∧ rationalZero < b ∧ q < a * b }

theorem realPosMulCut.membership (A B q : Set)
  shows q ∈ realPosMulCut(A, B) ↔
    (q ∈ ℚ ∧
      (q < rationalZero ∨
       ∃ a ∈ ℚ, a ∈ A ∧ ∃ b ∈ ℚ, b ∈ B ∧
         rationalZero < a ∧ rationalZero < b ∧ q < a * b))
proof
  simp

-- Every cut omits a positive rational.  Starting from any omitted rational,
-- move above it to the next displayed natural; downward closure shows that
-- this larger rational remains outside the cut.
theorem DedekindCut.exists_positive_upper (A : Set)
  requires cut : DedekindCut(A)
  shows ∃ u ∈ ℚ, rationalZero < u ∧ ¬(u ∈ A)
proof
  have proper := DedekindCut.proper with cut
  obtain ⟨r, rInQ, rMissing⟩ := ProperSubset.missing with proper
  have rRational : Rational(r) by typecheck
  obtain ⟨n, nNatural, rBelowN⟩ := Rational.below_natural with rRational
  have oneNonzero : 1 ≠ 0
    intro oneZero
    arith
  have nRational := rationalClass.rational at n, 0, 1 with oneNonzero
  have nBelowSucc := rationalLess.natural_successor with nNatural
  have uRational := rationalClass.rational at succ(n), 0, 1 with oneNonzero
  have rBelowU : r < rationalClass(succ(n), 0, 1)
    calc
      r < rationalClass(n, 0, 1) := rBelowN
      _ < rationalClass(succ(n), 0, 1) := nBelowSucc
  witness rationalClass(succ(n), 0, 1)
  constructor
    exact uRational
  constructor
  . exact rationalLess.positive_natural_successor at n with nNatural
  . intro uInA
    have rInA := DedekindCut.downward with cut, uInA, rInQ, rBelowU
    exact rMissing with rInA

theorem realPosMulCut.subset_rationals (A B : Set)
  shows realPosMulCut(A, B) ⊆ ℚ
proof
  simp

theorem realPosMulCut.nonempty (A B : Set)
  shows Nonempty(realPosMulCut(A, B))
proof
  obtain ⟨q, qInQ, qNegative⟩ := rationalLess.exists_below with rationalZero.rational
  witness q
  apply realPosMulCut.membership.backward
  refine ⟨qInQ, _⟩
  left
  exact qNegative

theorem realPosMulCut.nonnegative (A B : Set)
  shows realZero ⊆ realPosMulCut(A, B)
proof
  intros q qInZero
  unfold realZero at qInZero
  obtain ⟨qInQ, qNegative⟩ := rationalCut.membership.forward with qInZero
  apply realPosMulCut.membership.backward
  refine ⟨qInQ, _⟩
  left
  exact qNegative

theorem realPosMulCut.downward (A B p q : Set)
  requires qInProduct : q ∈ realPosMulCut(A, B)
  requires pInQ : p ∈ ℚ
  requires pLessQ : relates(rationalLess, p, q)
  shows p ∈ realPosMulCut(A, B)
proof
  obtain ⟨qInQ, rest⟩ := realPosMulCut.membership.forward with qInProduct
  cases rest with negative | product
  . have pNegative := rationalLess.transitive at p, q, rationalZero with
      pLessQ, negative
    apply realPosMulCut.membership.backward
    refine ⟨pInQ, _⟩
    left
    exact pNegative
  . rcases product with
      ⟨a, aInQ, aInA, b, bInQ, bInB, positiveA, positiveB, qLessProduct⟩
    have pLessProduct := rationalLess.transitive with pLessQ, qLessProduct
    apply realPosMulCut.membership.backward
    refine ⟨pInQ, _⟩
    right
    refine ⟨a, aInQ, aInA, b, bInQ, bInB,
      positiveA, positiveB, pLessProduct⟩

theorem realPosMulCut.no_greatest (A B q : Set)
  requires qInProduct : q ∈ realPosMulCut(A, B)
  shows ∃ s ∈ realPosMulCut(A, B), relates(rationalLess, q, s)
proof
  obtain ⟨qInQ, rest⟩ := realPosMulCut.membership.forward with qInProduct
  have qRational : Rational(q) by typecheck
  cases rest with negative | product
  . obtain ⟨t, tInQ, qLessT, tNegative⟩ :=
      rationalLess.dense at q, rationalZero with
        qRational, rationalZero.rational, negative
    refine ⟨t, _, qLessT⟩
    apply realPosMulCut.membership.backward
    refine ⟨tInQ, _⟩
    left
    exact tNegative
  . rcases product with
      ⟨a, aInQ, aInA, b, bInQ, bInB, positiveA, positiveB, qLessProduct⟩
    obtain ⟨s2, s2InQ, qLessS2, s2LessProduct⟩ := rationalLess.dense with qLessProduct
    refine ⟨s2, _, qLessS2⟩
    apply realPosMulCut.membership.backward
    refine ⟨s2InQ, _⟩
    right
    refine ⟨a, aInQ, aInA, b, bInQ, bInB,
      positiveA, positiveB, s2LessProduct⟩

theorem realPosMulCut.proper (A B : Real)
  shows realPosMulCut(A, B) ≠ ℚ
proof
  have cutA := Real.characterization.forward at A with assumption
  have cutB := Real.characterization.forward at B with assumption
  obtain ⟨u, uInQ, positiveU, uMissing⟩ := DedekindCut.exists_positive_upper with cutA
  obtain ⟨v, vInQ, positiveV, vMissing⟩ := DedekindCut.exists_positive_upper with cutB
  have uRational : Rational(u) by typecheck
  have vRational : Rational(v) by typecheck
  have uvRational := rationalMulValue.rational with uRational, vRational
  have positiveUV := rationalLess.mul_positive with positiveU, positiveV
  intro allRationals
  have uvInProduct : u * v ∈ realPosMulCut(A, B)
    rw allRationals
    exact uvRational
  obtain ⟨uvInQ, rest⟩ := realPosMulCut.membership.forward with uvInProduct
  cases rest with negative | product
  . have cycle := rationalLess.transitive at
      rationalZero, u * v, rationalZero with positiveUV, negative
    have impossible := rationalLess.irreflexive_on
    exact impossible with rationalZero, cycle
  . rcases product with
      ⟨a, aInQ, aInA, b, bInQ, bInB, positiveA, positiveB, uvLessAB⟩
    have aLessU := DedekindCut.lt_missing with cutA, aInA, uInQ, uMissing
    have bLessV := DedekindCut.lt_missing with cutB, bInB, vInQ, vMissing
    have abLessUB := rationalLess.mul_right with positiveB, aLessU
    have ubLessUV := rationalLess.mul_left with positiveU, bLessV
    have abLessUV : a * b < u * v
      calc
        a * b < u * b := abLessUB
        _ < u * v := ubLessUV
    have cycle : u * v < u * v
      calc
        u * v < a * b := uvLessAB
        _ < u * v := abLessUV
    have impossible := rationalLess.irreflexive_on
    exact impossible with u * v, uvInQ, cycle

theorem realPosMulCut.cut (A B : Real)
  shows DedekindCut(realPosMulCut(A, B))
proof
  have subset := realPosMulCut.subset_rationals at A, B
  have inhabited := realPosMulCut.nonempty at A, B
  have proper := realPosMulCut.proper at A, B with *
  unfold DedekindCut
  refine ⟨subset, inhabited, proper, _, _⟩
  . intros q qInProduct p pInQ pLessQ
    exact realPosMulCut.downward with qInProduct, pInQ, pLessQ
  . intros q qInProduct
    exact realPosMulCut.no_greatest with qInProduct

theorem realPosMulCut.real (A B : Real)
  shows Real(realPosMulCut(A, B))
proof
  apply Real.characterization.backward
  exact realPosMulCut.cut with *

theorem realPosMulCut.commutative (A B : Real)
  shows realPosMulCut(A, B) = realPosMulCut(B, A)
proof
  ext q
  constructor
  . intro qInProduct
    obtain ⟨qInQ, rest⟩ := realPosMulCut.membership.forward with qInProduct
    cases rest with negative | product
    . apply realPosMulCut.membership.backward at B, A, q
      refine ⟨qInQ, _⟩
      left
      exact negative
    . rcases product with
        ⟨a, aInQ, aInA, b, bInQ, bInB, positiveA, positiveB, below⟩
      have aRational : Rational(a) by typecheck
      have bRational : Rational(b) by typecheck
      have commutative := rationalMulValue.commutative with aRational, bRational
      rw commutative at below
      apply realPosMulCut.membership.backward
      refine ⟨qInQ, _⟩
      right
      refine ⟨b, bInQ, bInB, a, aInQ, aInA,
        positiveB, positiveA, below⟩
  . intro qInProduct
    obtain ⟨qInQ, rest⟩ := realPosMulCut.membership.forward with qInProduct
    cases rest with negative | product
    . apply realPosMulCut.membership.backward at A, B, q
      refine ⟨qInQ, _⟩
      left
      exact negative
    . rcases product with
        ⟨b2, b2InQ, b2InB, a2, a2InQ, a2InA, positiveB2, positiveA2, below2⟩
      have a2Rational : Rational(a2) by typecheck
      have b2Rational : Rational(b2) by typecheck
      have commutative2 := rationalMulValue.commutative with b2Rational, a2Rational
      rw commutative2 at below2
      apply realPosMulCut.membership.backward
      refine ⟨qInQ, _⟩
      right
      refine ⟨a2, a2InQ, a2InA, b2, b2InQ, b2InB,
        positiveA2, positiveB2, below2⟩

-- The one-sided associativity argument records the only approximation needed
-- for open products. A boundary product b*c is moved slightly inward by a
-- positive factor t<1; rational associativity preserves the outer bound.
theorem realPosMulCut.assoc_subset (A B C : Real)
  shows realPosMulCut(realPosMulCut(A, B), C) ⊆
    realPosMulCut(A, realPosMulCut(B, C))
proof
  intros q qInLeft
  obtain ⟨qInQ, rest⟩ := realPosMulCut.membership.forward with qInLeft
  apply realPosMulCut.membership.backward
  refine ⟨qInQ, _⟩
  cases rest with qNegative | product
  . left
    exact qNegative
  . rcases product with
      ⟨x, xInQ, xInAB, c, cInQ, cInC, positiveX, positiveC, qBelowXC⟩
    have cRational : Rational(c) by typecheck
    obtain ⟨xInQAgain, innerRest⟩ := realPosMulCut.membership.forward with xInAB
    cases innerRest with xNegative | factors
    . have cycle := rationalLess.transitive at
        rationalZero, x, rationalZero with positiveX, xNegative
      have impossible := rationalLess.irreflexive_on
      exfalso
      exact impossible with rationalZero, cycle
    . rcases factors with
        ⟨a, aInQ, aInA, b, bInQ, bInB,
          positiveA, positiveB, xBelowAB⟩
      have aRational : Rational(a) by typecheck
      have bRational : Rational(b) by typecheck
      have bcRational := rationalMulValue.rational with bRational, cRational
      have abcRational := rationalMulValue.rational with aRational, bcRational
      have positiveBC := rationalLess.mul_positive with positiveB, positiveC
      have positiveABC := rationalLess.mul_positive with positiveA, positiveBC
      have scaledX := rationalLess.mul_right with positiveC, xBelowAB
      have qBelowGrouped : q < (a * b) * c
        calc
          q < x * c := qBelowXC
          _ < (a * b) * c := scaledX
      have associative := rationalMulValue.associative with aRational, bRational, cRational
      have qBelowABC : q < a * (b * c) by rwa ← associative
      obtain ⟨t, tInQ, positiveT, tBelowOne, qBelowScaled⟩ :=
        rationalLess.exists_scale_below_one at q, a * (b * c) with
          abcRational, positiveABC, qBelowABC
      have tRational : Rational(t) by typecheck
      have yRational := rationalMulValue.rational with bcRational, tRational
      have positiveY := rationalLess.mul_positive with positiveBC, positiveT
      have yBelowOneScaled := rationalLess.mul_left with positiveBC, tBelowOne
      have oneProduct := rationalMulValue.one_right with bcRational
      rw oneProduct at yBelowOneScaled
      have scaledAssociative := rationalMulValue.associative with aRational, bcRational, tRational
      rw scaledAssociative at qBelowScaled
      have yInBC : (b * c) * t ∈ realPosMulCut(B, C)
        apply realPosMulCut.membership.backward
        refine ⟨yRational, _⟩
        right
        refine ⟨b, bInQ, bInB, c, cInQ, cInC,
          positiveB, positiveC, yBelowOneScaled⟩
      right
      refine ⟨a, aInQ, aInA, (b * c) * t, yRational, yInBC,
        positiveA, positiveY, qBelowScaled⟩

theorem realPosMulCut.associative (A B C : Real)
  shows realPosMulCut(realPosMulCut(A, B), C) =
    realPosMulCut(A, realPosMulCut(B, C))
proof
  apply Subset.antisymmetric
  . exact realPosMulCut.assoc_subset at A, B, C with
      *{3}
  . have reverse := realPosMulCut.assoc_subset at C, B, A with
      *{3}
    have cb := realPosMulCut.commutative at C, B with *
    have ba := realPosMulCut.commutative at B, A with *
    rw [cb, ba] at reverse
    have bcReal := realPosMulCut.real at B, C with *
    have abReal := realPosMulCut.real at A, B with *
    have outerLeft := realPosMulCut.commutative at
      realPosMulCut(B, C), A with bcReal, assumption
    have outerRight := realPosMulCut.commutative at
      C, realPosMulCut(A, B) with assumption, abReal
    rwa [outerLeft, outerRight] at reverse

theorem realPosMulCut.zero_left (B : Real)
  shows realPosMulCut(realZero, B) = realZero
proof
  ext q
  constructor
  . intro qInProduct
    obtain ⟨qInQ, rest⟩ := realPosMulCut.membership.forward with qInProduct
    cases rest with negative | product
    . unfold realZero
      apply rationalCut.membership.backward
      constructor
      . exact qInQ
      . exact negative
    . rcases product with
        ⟨a, aInQ, aInZero, b, bInQ, bInB, positiveA, positiveB, below⟩
      unfold realZero at aInZero
      obtain ⟨aAgain, negativeA⟩ := rationalCut.membership.forward with aInZero
      have cycle : rationalZero < rationalZero
        calc
          rationalZero < a := positiveA
          _ < rationalZero := negativeA
      have impossible := rationalLess.irreflexive_on
      exfalso
      exact impossible with rationalZero, cycle
  . intro qInZero
    unfold realZero at qInZero
    obtain ⟨qInQ, negative⟩ := rationalCut.membership.forward with qInZero
    apply realPosMulCut.membership.backward
    refine ⟨qInQ, _⟩
    left
    exact negative

theorem realPosMulCut.zero_right (A : Real)
  shows realPosMulCut(A, realZero) = realZero
proof
  calc
    realPosMulCut(A, realZero) = realPosMulCut(realZero, A) :=
      realPosMulCut.commutative with realZero.real
    _ = realZero := realPosMulCut.zero_left at A with assumption

-- The positive-cut product has the expected right unit on nonnegative cuts.
-- The reverse inclusion is the open-cut step: after moving from q to a larger
-- positive member a, rational approximation chooses 0 < b < 1 with q < a*b.
theorem realPosMulCut.one_right (A : Real)
  requires nonnegative : realZero ⊆ A
  shows realPosMulCut(A, realOne) = A
proof
  have cutA := Real.characterization.forward with assumption
  have subsetA := DedekindCut.subset_rationals with cutA
  ext q
  constructor
  . intro qInProduct
    obtain ⟨qInQ, rest⟩ := realPosMulCut.membership.forward with qInProduct
    cases rest with negative | product
      apply nonnegative with q
      unfold realZero
      exact rationalCut.membership.backward with ⟨qInQ, negative⟩
    . rcases product with
        ⟨a, aInQ, aInA, b, bInQ, bInOne,
          positiveA, positiveB, qBelowProduct⟩
      have aRational : Rational(a) by typecheck
      unfold realOne at bInOne
      obtain ⟨bAgain, bBelowOne⟩ := rationalCut.membership.forward with bInOne
      have scaled := rationalLess.mul_left with positiveA, bBelowOne
      have oneProduct := rationalMulValue.one_right with aRational
      rw oneProduct at scaled
      have qBelowA := rationalLess.transitive with qBelowProduct, scaled
      exact DedekindCut.downward with cutA, aInA, qInQ, qBelowA
  . intro qInA
    by_contra qMissingProduct
    have qInQ := subsetA with q, qInA
    have qRational : Rational(q) by typecheck
    obtain ⟨c, cInA, qBelowC⟩ := DedekindCut.no_greatest with cutA, qInA
    have cInQ := subsetA with c, cInA
    have cRational : Rational(c) by typecheck
    have distinct : rationalZero ≠ c
      intro zeroC
      have qNegative := qBelowC
      rw ← zeroC at qNegative
      apply qMissingProduct
      apply realPosMulCut.membership.backward
      refine ⟨qInQ, _⟩
      left
      exact qNegative
    have connected := rationalLess.connected_on
    have zeroInQ := rationalZero.rational
    have comparison := connected with
      rationalZero, zeroInQ, c, cInQ, distinct
    cases comparison with positiveC | cNegative
    . obtain ⟨d, dInQ, positiveD, dBelowOne, qBelowProduct⟩ :=
        rationalLess.exists_scale_below_one at q, c with
          qRational, cRational, positiveC, qBelowC
      have dInOne : d ∈ realOne
        unfold realOne
        exact rationalCut.membership.backward with ⟨dInQ, dBelowOne⟩
      apply qMissingProduct
      apply realPosMulCut.membership.backward
      refine ⟨qInQ, _⟩
      right
      refine ⟨c, cInQ, cInA, d, dInQ, dInOne,
        positiveC, positiveD, qBelowProduct⟩
    . have qNegative := rationalLess.transitive at
        q, c, rationalZero with qBelowC, cNegative
      apply qMissingProduct
      apply realPosMulCut.membership.backward
      refine ⟨qInQ, _⟩
      left
      exact qNegative

theorem realPosMulCut.one_left (A : Real)
  requires nonnegative : realZero ⊆ A
  shows realPosMulCut(realOne, A) = A
proof
  calc
    realPosMulCut(realOne, A) = realPosMulCut(A, realOne) :=
      realPosMulCut.commutative with realOne.real
    _ = A := realPosMulCut.one_right at A with nonnegative

-- The positive and negative parts are joins with zero.  This definition is
-- canonical for lower cuts and avoids making multiplication depend on an
-- arbitrary sign-case presentation.
def realPositivePart (A : Set) : Set := A ∪ realZero

theorem realPositivePart.real (A : Real)
  shows Real(realPositivePart(A))
proof
  have cutA := Real.characterization.forward with assumption
  have cutZero := Real.characterization.forward with realZero.real
  have comparable := DedekindCut.comparable with cutA, cutZero
  cases comparable with subsetAZero | subsetZeroA
  . have unionSubset := union2.subset at A, realZero, realZero with
      subsetAZero, Subset.reflexive at realZero
    have zeroSubset := union2.subset_right at A, realZero
    have equal := Subset.antisymmetric with unionSubset, zeroSubset
    unfold realPositivePart
    rw equal
    exact realZero.real
  . have unionSubset := union2.subset at A, realZero, A with
      Subset.reflexive at A, subsetZeroA
    have aSubset := union2.subset_left at A, realZero
    have equal := Subset.antisymmetric with unionSubset, aSubset
    unfold realPositivePart
    rwa equal

theorem realPositivePart.zero
  shows realPositivePart(realZero) = realZero
proof
  unfold realPositivePart
  exact union2.idempotent

theorem realPositivePart.eq_of_nonnegative (A : Real)
  requires nonnegative : realZero ⊆ A
  shows realPositivePart(A) = A
proof
  unfold realPositivePart
  have unionSubset := union2.subset at A, realZero, A with
    Subset.reflexive at A, nonnegative
  have leftSubset := union2.subset_left at A, realZero
  exact Subset.antisymmetric with unionSubset, leftSubset

theorem realPositivePart.nonnegative (A : Set)
  shows realZero ⊆ realPositivePart(A)
proof
  unfold realPositivePart
  exact union2.subset_right

theorem realPositivePart.eq_zero_of_nonpositive (A : Real)
  requires nonpositive : A ⊆ realZero
  shows realPositivePart(A) = realZero
proof
  unfold realPositivePart
  have unionSubset := union2.subset at A, realZero, realZero with
    nonpositive, Subset.reflexive at realZero
  have zeroSubset := union2.subset_right at A, realZero
  exact Subset.antisymmetric with unionSubset, zeroSubset

def realNegativePart (A : Set) : Set := realPositivePart(realNegCut(A))

theorem realNegativePart.real (A : Real)
  shows Real(realNegativePart(A))
proof
  unfold realNegativePart
  have negative := realNegCut.real at A
  exact realPositivePart.real with negative

theorem realNegativePart.zero
  shows realNegativePart(realZero) = realZero
proof
  unfold realNegativePart
  rw realNegCut.zero
  exact realPositivePart.zero

theorem realNegativePart.eq_zero_of_nonnegative (A : Real)
  requires nonnegative : realZero ⊆ A
  shows realNegativePart(A) = realZero
proof
  have reversed := realNegCut.subset_reverse with realZero.real, nonnegative
  rw realNegCut.zero at reversed
  unfold realNegativePart
  unfold realPositivePart
  have unionSubset := union2.subset at realNegCut(A), realZero, realZero with
    reversed, Subset.reflexive at realZero
  have zeroSubset := union2.subset_right at realNegCut(A), realZero
  exact Subset.antisymmetric with unionSubset, zeroSubset

theorem realNegativePart.nonnegative (A : Set)
  shows realZero ⊆ realNegativePart(A)
proof
  unfold realNegativePart
  exact realPositivePart.nonnegative

theorem realNegativePart.eq_neg_of_nonpositive (A : Real)
  requires nonpositive : A ⊆ realZero
  shows realNegativePart(A) = realNegCut(A)
proof
  have reversed := realNegCut.subset_reverse at A, realZero with
    assumption, realZero.real, nonpositive
  rw realNegCut.zero at reversed
  unfold realNegativePart
  exact realPositivePart.eq_of_nonnegative with reversed

-- Every real is its positive part minus its negative part.  Comparable cuts
-- make this the two-case sign argument, but the resulting identity
-- is canonical and can be used without further case splits.
theorem realParts.decomposition (A : Real)
  shows realAddCut(realPositivePart(A), realNegCut(realNegativePart(A))) = A
proof
  have cutA := Real.characterization.forward with assumption
  have cutZero := Real.characterization.forward with realZero.real
  have comparable := DedekindCut.comparable with cutA, cutZero
  cases comparable with nonpositive | nonnegative
  . have positive := realPositivePart.eq_zero_of_nonpositive with nonpositive
    have negative := realNegativePart.eq_neg_of_nonpositive with nonpositive
    simp [positive, negative, realNegCut.involutive,
      realAddCut.zero_left]
  . have positive := realPositivePart.eq_of_nonnegative with nonnegative
    have negative := realNegativePart.eq_zero_of_nonnegative with nonnegative
    simp [positive, negative, realNegCut.zero, realAddCut.zero_right]

-- Canonical signed product: A⁺B⁺ + A⁻B⁻ - A⁺B⁻ - A⁻B⁺.  It is expressed
-- entirely through already checked cut constructors, so totality is immediate
-- and later ring laws can reason algebraically instead of splitting on signs.
def realMulCut (A B : Set) : Set :=
  realAddCut(
    realAddCut(
      realPosMulCut(realPositivePart(A), realPositivePart(B)),
      realPosMulCut(realNegativePart(A), realNegativePart(B))),
    realNegCut(
      realAddCut(
        realPosMulCut(realPositivePart(A), realNegativePart(B)),
        realPosMulCut(realNegativePart(A), realPositivePart(B)))))

theorem realMulCut.real (A B : Real)
  shows Real(realMulCut(A, B))
proof
  have positiveA := realPositivePart.real at A
  have positiveB := realPositivePart.real at B
  have negativeA := realNegativePart.real at A
  have negativeB := realNegativePart.real at B
  have pp := realPosMulCut.real with positiveA, positiveB
  have nn := realPosMulCut.real with negativeA, negativeB
  have pn := realPosMulCut.real with positiveA, negativeB
  have np := realPosMulCut.real with negativeA, positiveB
  have positiveSum := realAddCut.real with pp, nn
  have negativeSum := realAddCut.real with pn, np
  have negatedNegativeSum := realNegCut.real at
    realAddCut(
      realPosMulCut(realPositivePart(A), realNegativePart(B)),
      realPosMulCut(realNegativePart(A), realPositivePart(B))) with negativeSum
  unfold realMulCut
  exact realAddCut.real at
    realAddCut(
      realPosMulCut(realPositivePart(A), realPositivePart(B)),
      realPosMulCut(realNegativePart(A), realNegativePart(B))),
    realNegCut(
      realAddCut(
        realPosMulCut(realPositivePart(A), realNegativePart(B)),
        realPosMulCut(realNegativePart(A), realPositivePart(B)))) with
    positiveSum, negatedNegativeSum

theorem realMulCut.of_nonnegative (A B : Real)
  requires nonnegativeA : realZero ⊆ A
  requires nonnegativeB : realZero ⊆ B
  shows realMulCut(A, B) = realPosMulCut(A, B)
proof
  have positiveA := realPositivePart.eq_of_nonnegative with nonnegativeA
  have positiveB := realPositivePart.eq_of_nonnegative with nonnegativeB
  have negativeA := realNegativePart.eq_zero_of_nonnegative with nonnegativeA
  have negativeB := realNegativePart.eq_zero_of_nonnegative with nonnegativeB
  simp [realMulCut, positiveA, positiveB, negativeA, negativeB,
    realPosMulCut.zero_left, realPosMulCut.zero_right,
    realAddCut.zero_left, realAddCut.zero_right, realNegCut.zero]

theorem realMulCut.zero_left (B : Real)
  shows realMulCut(realZero, B) = realZero
proof
  simp [realMulCut, realPositivePart.zero, realNegativePart.zero,
    realPosMulCut.zero_left, realPosMulCut.zero_right,
    realAddCut.zero_left, realAddCut.zero_right, realNegCut.zero]

theorem realMulCut.commutative (A B : Real)
  shows realMulCut(A, B) = realMulCut(B, A)
proof
  have positiveA := realPositivePart.real at A
  have positiveB := realPositivePart.real at B
  have negativeA := realNegativePart.real at A
  have negativeB := realNegativePart.real at B
  have pp := realPosMulCut.commutative with positiveA, positiveB
  have nn := realPosMulCut.commutative with negativeA, negativeB
  have pn := realPosMulCut.commutative with positiveA, negativeB
  have np := realPosMulCut.commutative with negativeA, positiveB
  have crossLeft := realPosMulCut.real with negativeB, positiveA
  have crossRight := realPosMulCut.real with positiveB, negativeA
  have cross := realAddCut.commutative with crossLeft, crossRight
  simp [realMulCut, pp, nn, pn, np, cross]

theorem realMulCut.zero_right (A : Real)
  shows realMulCut(A, realZero) = realZero
proof
  calc
    realMulCut(A, realZero) = realMulCut(realZero, A) :=
      realMulCut.commutative with realZero.real
    _ = realZero := realMulCut.zero_left at A with assumption

theorem realMulCut.one_right (A : Real)
  shows realMulCut(A, realOne) = A
proof
  have positiveA := realPositivePart.real at A
  have negativeA := realNegativePart.real at A
  obtain ⟨zeroReal, oneReal, properOne⟩ := realLess.characterization.forward with realZero.lt_one
  have nonnegativeOne := ProperSubset.subset with properOne
  have positiveOne := realPositivePart.eq_of_nonnegative with nonnegativeOne
  have negativeOne := realNegativePart.eq_zero_of_nonnegative with nonnegativeOne
  have positiveProduct := realPosMulCut.one_right with positiveA, realPositivePart.nonnegative at A
  have negativeProduct := realPosMulCut.one_right with negativeA, realNegativePart.nonnegative at A
  simp [realMulCut, positiveOne, negativeOne, positiveProduct, negativeProduct,
    realPosMulCut.zero_left, realPosMulCut.zero_right,
    realAddCut.zero_left, realAddCut.zero_right, realParts.decomposition]

theorem realMulCut.one_left (A : Real)
  shows realMulCut(realOne, A) = A
proof
  calc
    realMulCut(realOne, A) = realMulCut(A, realOne) :=
      realMulCut.commutative with realOne.real
    _ = A := realMulCut.one_right at A with assumption

theorem realMulCut.associative_of_nonnegative (A B C : Real)
  requires nonnegativeA : realZero ⊆ A
  requires nonnegativeB : realZero ⊆ B
  requires nonnegativeC : realZero ⊆ C
  shows realMulCut(realMulCut(A, B), C) =
    realMulCut(A, realMulCut(B, C))
proof
  have abReduction := realMulCut.of_nonnegative with nonnegativeA, nonnegativeB
  have bcReduction := realMulCut.of_nonnegative with nonnegativeB, nonnegativeC
  have nonnegativeAB := realPosMulCut.nonnegative at A, B
  have nonnegativeBC := realPosMulCut.nonnegative at B, C
  have leftReduction := realMulCut.of_nonnegative with nonnegativeAB, nonnegativeC
  have rightReduction := realMulCut.of_nonnegative with nonnegativeA, nonnegativeBC
  have reverseRight : realPosMulCut(A, realPosMulCut(B, C)) =
      realMulCut(A, realPosMulCut(B, C))
    rw rightReduction
    rfl
  calc
    realMulCut(realMulCut(A, B), C) =
        realMulCut(realPosMulCut(A, B), C) := by simp [abReduction]
    _ = realPosMulCut(realPosMulCut(A, B), C) := leftReduction
    _ = realPosMulCut(A, realPosMulCut(B, C)) :=
      realPosMulCut.associative at A, B, C with
        *{3}
    _ = realMulCut(A, realPosMulCut(B, C)) := reverseRight
    _ = realMulCut(A, realMulCut(B, C)) := by simp [bcReduction]

-- Total real multiplication as a set-valued function graph.
def realMul : Set :=
  { p ∈ ((ℝ × ℝ) × ℝ) |
    ∃ A ∈ ℝ, ∃ B ∈ ℝ,
      p = ((A, B) ↦ realMulCut(A, B)) }

def realMulValue (A B : Real) : Real := realMul((A, B))

theorem realMul.membership (p : Set)
  shows p ∈ realMul ↔
    (p ∈ ((ℝ × ℝ) × ℝ) ∧
      ∃ A ∈ ℝ, ∃ B ∈ ℝ,
        p = ((A, B) ↦ realMulCut(A, B)))
proof
  simp

theorem realMul.relates (A B : Real)
  shows relates(realMul, (A, B), realMulCut(A, B))
proof
  have realA : A ∈ ℝ by simp [Real]
  have realB : B ∈ ℝ by simp [Real]
  unfold relates
  apply realMul.membership.backward
  constructor
  . apply product.pair at (A, B), realMulCut(A, B), ℝ × ℝ, ℝ
    . exact product.pair with realA, realB
    . exact realMulCut.real at A, B with *{2}
  . refine ⟨A, realA, B, realB, rfl⟩

theorem realMul.factors (input output : Set)
  requires mapped : relates(realMul, input, output)
  shows ∃ A ∈ ℝ, ∃ B ∈ ℝ,
    input = (A, B) ∧ output = realMulCut(A, B)
proof
  unfold relates at mapped
  simp [realMul.membership] at mapped
  rcases mapped with ⟨bounded, A, realA, B, realB, shape⟩
  obtain ⟨inputShape, outputShape⟩ := orderedPair.injective with shape
  refine ⟨A, realA, B, realB, inputShape, outputShape⟩

theorem realMul.total
  shows TotalBetween(realMul, ℝ × ℝ, ℝ)
proof
  intros input inputInProduct
  obtain ⟨bounded, A, realA, B, realB, inputShape⟩ := product.membership.forward with inputInProduct
  have typedA : Real(A) by exact realA
  have typedB : Real(B) by exact realB
  witness realMulCut(A, B)
  constructor
  . exact realMulCut.real with typedA, typedB
  . rw inputShape
    exact realMul.relates with typedA, typedB

theorem realMul.functional
  shows Functional(realMul)
proof
  intros input y inputY z inputZ
  obtain ⟨A, realA, B, realB, inputFirst, outputFirst⟩ := realMul.factors with inputY
  obtain ⟨C, realC, D, realD, inputSecond, outputSecond⟩ := realMul.factors with inputZ
  rw inputFirst at inputSecond
  obtain ⟨sameLeft, sameRight⟩ := orderedPair.injective with inputSecond
  rw [outputFirst, outputSecond, sameLeft, sameRight]
  rfl

theorem realMul.function
  shows realMul : ℝ × ℝ → ℝ
proof
  constructor
    intros p hp
    simp [realMul.membership] at hp
    rcases hp with ⟨bounded, witnesses⟩
    exact bounded
  . refine ⟨realMul.functional, _⟩
    exact realMul.total

instance realMul.operation
  shows MulOperation(ℝ, realMul)
proof
  exact realMul.function

notation infixl 70 "*" => call2 via MulOperation(ℝ, _) for Real

theorem realMulValue.real (A B : Real)
  shows Real(A * B)
proof
  have realA : A ∈ ℝ by simp [Real]
  have realB : B ∈ ℝ by simp [Real]
  have input := product.pair with realA, realB
  obtain ⟨C, realC, mapped⟩ := FunctionBetween.exists_value with realMul.function, input
  have applied := FunctionBetween.apply_value with realMul.function, input, mapped
  unfold call2
  rw applied
  exact realC

theorem realMulValue.cut (A B : Real)
  shows A * B = realMulCut(A, B)
proof
  have realA : A ∈ ℝ by simp [Real]
  have realB : B ∈ ℝ by simp [Real]
  have input := product.pair with realA, realB
  have mapped := realMul.relates at A, B with *
  unfold call2
  exact FunctionBetween.apply_value with realMul.function, input, mapped

theorem realMulValue.commutative (A B : Real)
  shows A * B = B * A
proof
  rw [realMulValue.cut, realMulValue.cut]
  exact realMulCut.commutative with *

theorem realMulValue.zero_left (A : Real)
  shows 0 * A = 0
proof
  calc
    realZero * A = realMulCut(realZero, A) :=
      realMulValue.cut with realZero.real
    _ = realZero := realMulCut.zero_left at A with assumption

theorem realMulValue.zero_right (A : Real)
  shows A * 0 = 0
proof
  calc
    A * realZero = realZero * A :=
      realMulValue.commutative with realZero.real
    _ = realZero := realMulValue.zero_left at A with assumption

theorem realMulValue.one_right_of_nonnegative (A : Real)
  requires nonnegative : realZero ⊆ A
  shows A * 1 = A
proof
  obtain ⟨zeroReal, oneReal, properOne⟩ := realLess.characterization.forward with realZero.lt_one
  have nonnegativeOne := ProperSubset.subset with properOne
  calc
    A * realOne = realMulCut(A, realOne) :=
      realMulValue.cut with realOne.real
    _ = realPosMulCut(A, realOne) :=
      realMulCut.of_nonnegative at A, realOne with
        assumption, realOne.real, nonnegative, nonnegativeOne
    _ = A := realPosMulCut.one_right at A with nonnegative

theorem realMulValue.one_left_of_nonnegative (A : Real)
  requires nonnegative : realZero ⊆ A
  shows 1 * A = A
proof
  calc
    realOne * A = A * realOne :=
      realMulValue.commutative with realOne.real
    _ = A := realMulValue.one_right_of_nonnegative at A with
      assumption, nonnegative

theorem realMulValue.one_right (A : Real)
  shows A * 1 = A
proof
  calc
    A * realOne = realMulCut(A, realOne) :=
      realMulValue.cut with realOne.real
    _ = A := realMulCut.one_right at A with assumption

theorem realMulValue.one_left (A : Real)
  shows 1 * A = A
proof
  calc
    realOne * A = A * realOne :=
      realMulValue.commutative with realOne.real
    _ = A := realMulValue.one_right at A with assumption

theorem realMulValue.associative_of_nonnegative (A B C : Real)
  requires nonnegativeA : realZero ⊆ A
  requires nonnegativeB : realZero ⊆ B
  requires nonnegativeC : realZero ⊆ C
  shows (A * B) * C = A * (B * C)
proof
  have abReal := realMulValue.real at A, B with *
  have bcReal := realMulValue.real at B, C with *
  have abCut := realMulValue.cut at A, B with *
  have bcCut := realMulValue.cut at B, C with *
  have leftCut := realMulValue.cut at A * B, C with abReal, assumption
  have rightCut := realMulValue.cut at A, B * C with assumption, bcReal
  have leftInner : realMulCut(A * B, C) =
      realMulCut(realMulCut(A, B), C)
    rw abCut
    rfl
  have rightInner : realMulCut(A, realMulCut(B, C)) =
      realMulCut(A, B * C)
    rw bcCut
    rfl
  have reverseRight : realMulCut(A, B * C) = A * (B * C)
    rw rightCut
    rfl
  calc
    (A * B) * C = realMulCut(A * B, C) := leftCut
    _ = realMulCut(realMulCut(A, B), C) := leftInner
    _ = realMulCut(A, realMulCut(B, C)) :=
      realMulCut.associative_of_nonnegative at A, B, C with
        nonnegativeA, nonnegativeB, nonnegativeC
    _ = realMulCut(A, B * C) := rightInner
    _ = A * (B * C) := reverseRight

instance realMul.identity
  shows Identity(ℝ, realMul, realOne)
proof
  constructor
  . exact realOne.real
  . intros A realA
    have typedA : Real(A) by exact realA
    constructor
    . exact realMulValue.one_left with typedA
    . exact realMulValue.one_right with typedA

-- A real strictly above zero contains a strictly positive rational.  This is
-- the witness form of positivity used by multiplication: proper inclusion
-- supplies a new member, roundedness moves above it, and connectedness rules
-- out the larger member being nonpositive.
theorem RealLess.exists_positive_member (A : Real)
  requires positive : 0 < A
  shows ∃ a ∈ A, rationalZero < a
proof
  obtain ⟨zeroReal, realA, proper⟩ := realLess.characterization.forward with positive
  obtain ⟨q, qInA, qMissingZero⟩ := ProperSubset.missing with proper
  have cutA := Real.characterization.forward at A with assumption
  obtain ⟨a, aInA, qLessA⟩ := DedekindCut.no_greatest with cutA, qInA
  have subsetA := DedekindCut.subset_rationals with cutA
  have qInQ := subsetA with q, qInA
  have aInQ := subsetA with a, aInA
  have zeroInQ := rationalZero.rational
  have distinct : rationalZero ≠ a
    intro equal
    have qNegative : q < rationalZero by rwa equal
    apply qMissingZero
    unfold realZero
    apply rationalCut.membership.backward
    constructor
    . exact qInQ
    . exact qNegative
  have connected := rationalLess.connected_on
  have comparison := connected with
    rationalZero, zeroInQ, a, aInQ, distinct
  cases comparison with positiveA | aNegative
  . refine ⟨a, aInA, positiveA⟩
  . have qNegative := rationalLess.transitive at q, a, rationalZero with
      qLessA, aNegative
    exfalso
    apply qMissingZero
    unfold realZero
    apply rationalCut.membership.backward
    constructor
    . exact qInQ
    . exact qNegative

-- The positive-cut product of two positive reals is positive.  The proof
-- exposes the familiar mathematical witnesses a > 0 and b > 0, then uses
-- rational density to put a member of the product above zero.
theorem realPosMulCut.positive (A B : Real)
  requires positiveA : 0 < A
  requires positiveB : 0 < B
  shows realZero < realPosMulCut(A, B)
proof
  have productReal := realPosMulCut.real at A, B with *
  have zeroSubset : realZero ⊆ realPosMulCut(A, B)
    intros q qInZero
    unfold realZero at qInZero
    obtain ⟨qInQ, qNegative⟩ := rationalCut.membership.forward with qInZero
    apply realPosMulCut.membership.backward
    refine ⟨qInQ, _⟩
    left
    exact qNegative
  obtain ⟨a, aInA, positiveRationalA⟩ := RealLess.exists_positive_member with positiveA
  obtain ⟨b, bInB, positiveRationalB⟩ := RealLess.exists_positive_member with positiveB
  have cutA := Real.characterization.forward at A with assumption
  have cutB := Real.characterization.forward at B with assumption
  have subsetA := DedekindCut.subset_rationals with cutA
  have subsetB := DedekindCut.subset_rationals with cutB
  have aInQ := subsetA with a, aInA
  have bInQ := subsetB with b, bInB
  have aRational : Rational(a) by typecheck
  have bRational : Rational(b) by typecheck
  have productPositive := rationalLess.mul_positive with positiveRationalA, positiveRationalB
  have productRational := rationalMulValue.rational with aRational, bRational
  obtain ⟨s, sInQ, sPositive, sBelowProduct⟩ := rationalLess.dense with
    rationalZero.rational, productRational, productPositive
  have sInProduct : s ∈ realPosMulCut(A, B)
    apply realPosMulCut.membership.backward
    refine ⟨sInQ, _⟩
    right
    refine ⟨a, aInQ, aInA, b, bInQ, bInB,
      positiveRationalA, positiveRationalB, sBelowProduct⟩
  have sMissingZero : ¬(s ∈ realZero)
    intro sInZero
    unfold realZero at sInZero
    obtain ⟨sAgain, sNegative⟩ := rationalCut.membership.forward with sInZero
    have cycle := rationalLess.transitive with sPositive, sNegative
    have impossible := rationalLess.irreflexive_on
    exact impossible with rationalZero, cycle
  have unequal : realZero ≠ realPosMulCut(A, B)
    intro equal
    apply sMissingZero
    rwa equal
  have proper : realZero ⊂ realPosMulCut(A, B)
    constructor
    . exact zeroSubset
    . exact unequal
  apply realLess.characterization.backward
  unfold RealLess
  refine ⟨realZero.real, productReal, proper⟩

-- Positivity for the public, signed multiplication operation.  Strict
-- positivity supplies the two nonnegative inclusions, so the canonical sign
-- decomposition reduces definitionally to the positive-cut product.
theorem realMulValue.positive (A B : Real)
  requires positiveA : 0 < A
  requires positiveB : 0 < B
  shows 0 < A * B
proof
  have orderA := realLess.characterization.forward with positiveA
  have orderB := realLess.characterization.forward with positiveB
  rcases orderA with ⟨zeroRealA, realA, properA⟩
  rcases orderB with ⟨zeroRealB, realB, properB⟩
  have nonnegativeA := ProperSubset.subset with properA
  have nonnegativeB := ProperSubset.subset with properB
  have cutPositive := realPosMulCut.positive with positiveA, positiveB
  have valueCut := realMulValue.cut at A, B with *
  have reduction := realMulCut.of_nonnegative with nonnegativeA, nonnegativeB
  rwa [valueCut, reduction]

instance realMul.positive
  shows MulPositive(ℝ, realMul, realZero, realLess)
proof
  intros A realA B realB positiveA positiveB
  exact realMulValue.positive with positiveA, positiveB

instance realMul.magma
  shows IsMagma(ℝ, realMul)
proof
  exact realMul.function

instance realMul.commutative
  shows Commutative(ℝ, realMul)
proof
  intros A realA B realB
  have typedA : Real(A) by typecheck
  have typedB : Real(B) by typecheck
  exact realMulValue.commutative with typedA, typedB

theorem reals.nontrivial
  shows Nontrivial(ℝ, realZero, realOne)
proof
  constructor
  . exact realZero.real
  constructor
  . exact realOne.real
  . exact realZero.ne_one

theorem realMulValue.type (A B : Real)
  shows Real(realMulValue(A, B))
proof
  have closed := realMulValue.real at A, B with *
  unfold realMulValue
  unfold call2 at closed
  exact closed
