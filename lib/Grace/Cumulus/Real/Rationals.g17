module Grace.Cumulus.Real.Rationals
import RootTwoRational

-- The image of the rationals under the cut embedding; ℚ itself is the set
-- of rationals.
def rationalReals : Set := { rationalCut(q) | q ∈ ℚ }

theorem sqrtTwo.not_rational
  shows √2 ∉ rationalReals
proof
  intro member
  obtain ⟨q, qInQ, equal⟩ := rationalReals.membership.forward with member
  symm at equal
  exact sqrtTwo.ne_rationalCut with *, equal

-- A real number is irrational when it is not the image of any rational
-- under the embedding of ℚ into ℝ: the textbook √2 ∉ ℚ, with ℚ read as its
-- copy inside ℝ.
predicate Irrational (x : Real) := ¬(∃ q ∈ ℚ, rationalCut(q) = x)

theorem sqrtTwo.irrational
  shows Irrational(√2)
proof
  unfold Irrational
  constructor
  . have one := realZero.lt_one
    have twoLe : (0:R) ≤ (2:R) by linarith
    have twoNonnegative := NonnegativeReal.of_le with *
    exact sqrt.real with *
  . intro rational
    obtain ⟨q, qInQ, equal⟩ := rational
    have distinct := sqrtTwo.ne_rationalCut at q with *
    symm at equal
    exact distinct with equal
