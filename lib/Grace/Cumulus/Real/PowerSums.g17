-- Sums of powers: closed forms for the sums of the first n squares and cubes,
-- and the sum of cubes as the square of the sum of the first n naturals
-- Part of Cumulus, the Grace17 mathematics library.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module Grace.Cumulus.Real.PowerSums
import ArithmeticSeries

-- The squares and cubes of the naturals, as real sequences.
defgraph squareTerms (n ∈ ℕ) : ℝ := (realNat(n):R) * (realNat(n):R)
proof
  have typedN := nat.omega.backward at n with member
  have count := realNat.real at n with typedN
  exact realMulValue.real at realNat(n), realNat(n)

defgraph cubeTerms (n ∈ ℕ) : ℝ := (realNat(n):R) * (realNat(n):R) * (realNat(n):R)
proof
  have typedN := nat.omega.backward at n with member
  have count := realNat.real at n with typedN
  have square := realMulValue.real at realNat(n), realNat(n)
  exact realMulValue.real at (realNat(n):R) * (realNat(n):R), realNat(n)

theorem squareTerms.sequence
  shows RealSequence(squareTerms)
proof
  exact squareTerms.function

theorem cubeTerms.sequence
  shows RealSequence(cubeTerms)
proof
  exact cubeTerms.function

-- 6·(0² + 1² + ⋯ + (n−1)²) = n(n − 1)(2n − 1).
theorem powerSum.squares (n : Nat)
  shows (6:R) * (∑ i < n, squareTerms(i):R) =
    (realNat(n):R) * ((realNat(n):R) - (1:R)) * ((2:R) * (realNat(n):R) - (1:R))
proof
  induction n
  | zero =>
    rw [realPartialSum.zero, realNat.zero]
    ring
  | succ(k) using ih =>
    have sequence := squareTerms.sequence
    have count := realNat.real at k
    have value := squareTerms.value at k with *
    rw [realPartialSum.succ, value, realNat.succ]
    linear_combination ih

-- 6·(1² + ⋯ + n²) = n(n + 1)(2n + 1).
theorem powerSum.squares_inclusive (n : Nat)
  shows (6:R) * (∑ i < n + 1, squareTerms(i):R) =
    (realNat(n):R) * ((realNat(n):R) + (1:R)) * ((2:R) * (realNat(n):R) + (1:R))
proof
  have bound : n + 1 = succ(n) := add.right_one at n
  rw bound
  have all := powerSum.squares at succ(n)
  rw realNat.succ at all
  linear_combination all

-- 4·(0³ + 1³ + ⋯ + (n−1)³) = n²(n − 1)².
theorem powerSum.cubes (n : Nat)
  shows (4:R) * (∑ i < n, cubeTerms(i):R) =
    (realNat(n):R) * (realNat(n):R) * ((realNat(n):R) - (1:R)) * ((realNat(n):R) - (1:R))
proof
  induction n
  | zero =>
    rw [realPartialSum.zero, realNat.zero]
    ring
  | succ(k) using ih =>
    have sequence := cubeTerms.sequence
    have count := realNat.real at k
    have value := cubeTerms.value at k with *
    rw [realPartialSum.succ, value, realNat.succ]
    linear_combination ih

-- 4·(1³ + ⋯ + n³) = n²(n + 1)².
theorem powerSum.cubes_inclusive (n : Nat)
  shows (4:R) * (∑ i < n + 1, cubeTerms(i):R) =
    (realNat(n):R) * (realNat(n):R) * ((realNat(n):R) + (1:R)) * ((realNat(n):R) + (1:R))
proof
  have bound : n + 1 = succ(n) := add.right_one at n
  rw bound
  have all := powerSum.cubes at succ(n)
  rw realNat.succ at all
  linear_combination all

-- Nicomachus: 1³ + ⋯ + n³ = (1 + ⋯ + n)².
theorem powerSum.cubes_eq_square_of_sum (n : Nat)
  shows ∑ i < n + 1, cubeTerms(i) =
    (∑ i < n + 1, arithmeticTerms(realZero, realOne)(i):R) *
      (∑ i < n + 1, arithmeticTerms(realZero, realOne)(i):R)
proof
  have bound : n + 1 = succ(n) := add.right_one at n
  rw bound
  have cubes := powerSum.cubes_inclusive at n
  rw bound at cubes
  have gauss := arithmeticSeries.gauss at n
  rw bound at gauss
  have scaled : (4:R) * ((∑ i < succ(n), cubeTerms(i):R) - (∑ i < succ(n), arithmeticTerms(realZero, realOne)(i):R) * (∑ i < succ(n), arithmeticTerms(realZero, realOne)(i):R)) = (0:R)
    linear_combination cubes - ((2:R) * (∑ i < succ(n), arithmeticTerms(realZero, realOne)(i):R) + (realNat(n):R) * ((realNat(n):R) + (1:R))) * gauss
  have fourPositive : (0:R) < (4:R) by linarith
  have fourNonzero : (4:R) ≠ (0:R)
    intro zero
    rw zero at fourPositive
    linarith
  have cancel := realInvValue.mul_left with fourNonzero
  have identity : (∑ i < succ(n), cubeTerms(i):R) - (∑ i < succ(n), arithmeticTerms(realZero, realOne)(i):R) * (∑ i < succ(n), arithmeticTerms(realZero, realOne)(i):R) = realInvValue((4:R)) * ((4:R) * ((∑ i < succ(n), cubeTerms(i):R) - (∑ i < succ(n), arithmeticTerms(realZero, realOne)(i):R) * (∑ i < succ(n), arithmeticTerms(realZero, realOne)(i):R)))
    have rearrange : realInvValue((4:R)) * ((4:R) * ((∑ i < succ(n), cubeTerms(i):R) - (∑ i < succ(n), arithmeticTerms(realZero, realOne)(i):R) * (∑ i < succ(n), arithmeticTerms(realZero, realOne)(i):R))) = (realInvValue((4:R)) * (4:R)) * ((∑ i < succ(n), cubeTerms(i):R) - (∑ i < succ(n), arithmeticTerms(realZero, realOne)(i):R) * (∑ i < succ(n), arithmeticTerms(realZero, realOne)(i):R))
      ring
    have one := realMulValue.one_left at (∑ i < succ(n), cubeTerms(i):R) - (∑ i < succ(n), arithmeticTerms(realZero, realOne)(i):R) * (∑ i < succ(n), arithmeticTerms(realZero, realOne)(i):R)
    rw [rearrange, cancel, one]
    rfl
  rw scaled at identity
  have zero := realMulValue.zero_right at realInvValue((4:R))
  rw zero at identity
  linear_combination identity
