module Grace.Cumulus.Real.Order
import Core

-- Non-strict order on lower cuts is inclusion. Keeping it proposition-valued
-- makes the mathematical content visible while the graph interface matures.
predicate RealLe (A B : Set) := Real(A) ∧ Real(B) ∧ (A ⊆ B)

-- Non-strict real order as a set-valued relation graph.  Its
-- proposition-level view remains RealLe; the graph supports typed ≤ notation
-- and the same inspectable elaboration boundary as realLess.
def realLe : Set :=
  { p ∈ ℝ × ℝ | ∃ A ∈ ℝ, ∃ B ∈ ℝ, p = (A, B) ∧ (A ⊆ B) }

theorem realLe.membership (p : Set)
  shows p ∈ realLe ↔
    (p ∈ ℝ × ℝ ∧ ∃ A ∈ ℝ, ∃ B ∈ ℝ, p = (A, B) ∧ (A ⊆ B))
proof
  simp

theorem realLe.characterization (A B : Set)
  shows relates(realLe, A, B) ↔ RealLe(A, B)
proof
  constructor
  . intro le
    unfold relates at le
    simp [realLe.membership] at le
    rcases le with ⟨_, X, realX, Y, realY, pairShape, subset⟩
    obtain ⟨equalA, equalB⟩ := orderedPair.injective with pairShape
    constructor
    . unfold Real
      rwa equalA
    . constructor
      . unfold Real
        rwa equalB
      . rw [equalA, equalB]
        exact subset
  . intro le
    rcases le with ⟨realA, realB, subset⟩
    unfold relates
    apply realLe.membership.backward
    constructor
    . apply product.pair at A, B, ℝ, ℝ
        exact realA
        exact realB
    . witness A
      constructor
        exact realA
      . witness B
        constructor
          exact realB
        refine ⟨rfl, subset⟩

theorem realLe.relation
  shows RelationBetween(realLe, ℝ, ℝ)
proof
  intros p hp
  obtain ⟨bounded, witnesses⟩ := realLe.membership.forward with hp
  exact bounded

instance realLe.operation
  shows LessEqualOperation(ℝ, realLe)
proof
  exact realLe.relation

notation infix 50 "≤" => relates via LessEqualOperation(ℝ, _) for Real

theorem realLe.subset (A B : Real)
  requires le : A ≤ B
  shows A ⊆ B
proof
  have proposition := realLe.characterization.forward with le
  unfold RealLe at proposition
  simp

theorem realLe.of_subset (A B : Real)
  requires subset : A ⊆ B
  shows A ≤ B
proof
  apply realLe.characterization.backward
  unfold RealLe
  tauto

predicate RealUpperBound (S B : Set) :=
  Real(B) ∧ (S ⊆ ℝ) ∧ (∀ A ∈ S, (A ⊆ B))

predicate RealLeastUpperBound (S U : Set) :=
  RealUpperBound(S, U) ∧
  (∀ B, RealUpperBound(S, B) → (U ⊆ B))

-- The union of a family of lower cuts is its candidate supremum.
def realSup (S : Set) : Set := ⋃(S)

theorem RealLe.reflexive (A : Set)
  requires realA : Real(A)
  shows RealLe(A, A)
proof
  refine ⟨realA, realA, Subset.reflexive at A⟩

theorem RealLe.transitive (A B C : Set)
  requires hAB : RealLe(A, B)
  requires hBC : RealLe(B, C)
  shows RealLe(A, C)
proof
  rcases hAB with ⟨realA, realB, subsetAB⟩
  rcases hBC with ⟨realBAgain, realC, subsetBC⟩
  constructor
  exact realA
  constructor
  exact realC
  exact Subset.transitive with subsetAB, subsetBC

theorem RealLe.antisymmetric (A B : Set)
  requires hAB : RealLe(A, B)
  requires hBA : RealLe(B, A)
  shows A = B
proof
  rcases hAB with ⟨realA, realB, subsetAB⟩
  rcases hBA with ⟨realBAgain, realAAgain, subsetBA⟩
  exact Subset.antisymmetric with subsetAB, subsetBA

theorem realSup.subset_upper (S B : Set)
  requires upper : RealUpperBound(S, B)
  shows (realSup(S) ⊆ B)
proof
  rcases upper with ⟨realB, reals, bounds⟩
  unfold realSup
  exact union.subset with bounds

theorem realSup.cut (S B : Set)
  requires inhabited : Nonempty(S)
  requires upper : RealUpperBound(S, B)
  shows DedekindCut(realSup(S))
proof
  rcases upper with ⟨realB, reals, bounds⟩
  have cutB := Real.characterization.forward with realB
  constructor
    intros q0 hq0
    unfold realSup at hq0
    simp [set.union] at hq0
    obtain ⟨A, hAS, hq0A⟩ := hq0
    specialize reals with A, hAS
    obtain ⟨powerA, cutA⟩ := Grace.Cumulus.Real.Defs.reals.membership.forward with reals
    have subsetA := DedekindCut.subset_rationals with cutA
    exact subsetA with q0, hq0A
  . constructor
    . obtain ⟨A0, hA0S⟩ := inhabited
      specialize reals with A0, hA0S
      obtain ⟨powerA, cutA⟩ := Grace.Cumulus.Real.Defs.reals.membership.forward with reals
      obtain ⟨q1, hq1A⟩ := DedekindCut.nonempty with cutA
      witness q1
      unfold realSup
      exact union.contains with hA0S, hq1A
    . constructor
      . intro equalQ
        unfold realSup at equalQ
        have unionBound := union.subset with bounds
        rw equalQ at unionBound
        have subsetB := DedekindCut.subset_rationals with cutB
        have equalB := Subset.antisymmetric with subsetB, unionBound
        have properB := DedekindCut.proper with cutB
        exact ProperSubset.ne with properB, equalB
      . constructor
        . intros q2 hq2 p2 hp2 less2
          unfold realSup at hq2
          simp [set.union] at hq2
          obtain ⟨A1, hA1S, hq2A1⟩ := hq2
          specialize reals with A1, hA1S
          obtain ⟨powerA, cutA⟩ := Grace.Cumulus.Real.Defs.reals.membership.forward with reals
          have downward := DedekindCut.downward with cutA, hq2A1, hp2, less2
          unfold realSup
          exact union.contains with hA1S, downward
        . intros q3 hq3
          unfold realSup at hq3
          simp [set.union] at hq3
          obtain ⟨A2, hA2S, hq3A2⟩ := hq3
          specialize reals with A2, hA2S
          obtain ⟨powerA, cutA⟩ := Grace.Cumulus.Real.Defs.reals.membership.forward with reals
          obtain ⟨r3, hr3A2, less3⟩ := DedekindCut.no_greatest with cutA, hq3A2
          witness r3
          constructor
          . unfold realSup
            exact union.contains with hA2S, hr3A2
          . exact less3

theorem realSup.least_upper_bound (S B : Set)
  requires inhabited : Nonempty(S)
  requires upper : RealUpperBound(S, B)
  shows RealLeastUpperBound(S, realSup(S))
proof
  constructor
    constructor
    . apply Real.characterization.backward at realSup(S)
      exact realSup.cut with inhabited, upper
    . rcases upper with ⟨realB, reals, bounds⟩
      constructor
      . exact reals
      . intros A hAS q hqA
        unfold realSup
        exact union.contains with hAS, hqA
  . intros C upperC
    exact realSup.subset_upper with upperC

-- Every inhabited family of reals with a real upper bound has a least one.
-- This is the least-upper-bound property used by real analysis.
theorem Real.least_upper_bound_property (S : Set)
  requires inhabited : Nonempty(S)
  requires bounded : ∃ B, RealUpperBound(S, B)
  shows ∃ U, RealLeastUpperBound(S, U)
proof
  obtain ⟨B, upper⟩ := bounded
  witness realSup(S)
  exact realSup.least_upper_bound with inhabited, upper
