module Grace.Cumulus.Real.Uncountable.Separation
import TailMargin

theorem cantorApprox.offset_weak (X : Set, n k : Nat)
  shows cantorApprox(X, n) = cantorApprox(X, add(k, n)) ∨
    relates(rationalLess, cantorApprox(X, n), cantorApprox(X, add(k, n)))
proof
  induction k
  | zero =>
    left
    have shape := add.left_unit at n
    rw shape
    rfl
  | succ(j) using ih =>
    have indexShape : add(succ(j), n) = succ(add(j, n))
      settle with add
    rw indexShape
    have step : cantorApprox(X, add(j, n)) = cantorApprox(X, succ(add(j, n))) ∨ relates(rationalLess, cantorApprox(X, add(j, n)), cantorApprox(X, succ(add(j, n))))
      apply cantorApprox.step_weak at X, add(j, n)
    cases ih with sameStart | lessStart
    . cases step with sameStep | lessStep
      . left
        rw sameStart
        exact sameStep
      . right
        rw sameStart
        exact lessStep
    . cases step with sameStep | lessStep
      . right
        rw ← sameStep
        exact lessStart
      . right
        have startRational : Rational(cantorApprox(X, n))
          apply cantorApprox.rational at X, n
        have middleRational : Rational(cantorApprox(X, add(j, n)))
          apply cantorApprox.rational at X, add(j, n)
        exact rationalLess.transitive at
          cantorApprox(X, n), cantorApprox(X, add(j, n)),
          cantorApprox(X, succ(add(j, n))) with lessStart, lessStep

def cantorMid (X n : Set) : Set :=
  rationalClass(4 * cantorPrefix(X, n) + 1, 0, 4 ^ succ(n))

theorem cantorMid.rational (X : Set, n : Nat)
  shows Rational(cantorMid(X, n))
proof
  unfold cantorMid
  have successorNatural : Nat(succ(n)) by typecheck
  apply rationalClass.rational
  . exact pow.four_nonzero with successorNatural

theorem cantorMid.below_next_of_member (X : Set, n : Nat)
  requires member : n ∈ X
  shows relates(rationalLess, cantorMid(X, n), cantorApprox(X, succ(n)))
proof
  unfold cantorMid
  unfold cantorApprox
  have prefixShape := cantorPrefix.succ at X, n
  have digitOne := binaryDigit.one with member
  rw [prefixShape, digitOne]
  have productOne := mul.right_unit at 2
  rw productOne
  have successorNatural : Nat(succ(n)) by typecheck
  have denominatorNonzero : 4 ^ succ(n) ≠ 0 by exact pow.four_nonzero at succ(n) with successorNatural
  apply rationalLess.classes.backward with denominatorNonzero, denominatorNonzero
  have numeratorGap : 4 * cantorPrefix(X, n) + 1 < 4 * cantorPrefix(X, n) + 2 by arith
  have scaled := Less.mul_left with denominatorNonzero, numeratorGap
  ring_nf at scaled
  ring_nf
  exact scaled

theorem cantorApprox.before_mid (X : Set, n : Nat)
  shows relates(rationalLess, cantorApprox(X, n), cantorMid(X, n))
proof
  unfold cantorApprox
  unfold cantorMid
  have powerShape := pow.succ at 4, n
  rw powerShape
  have oldNonzero := pow.four_nonzero at n with assumption
  have nextNonzero := mul.nonzero at 4, 4 ^ n with
    natural.four_nonzero, oldNonzero
  apply rationalLess.classes.backward at
    cantorPrefix(X, n), 0, 4 ^ n,
    4 * cantorPrefix(X, n) + 1, 0, 4 * (4 ^ n) with
      oldNonzero, nextNonzero
  have remainderNonzero : 4 ^ n ≠ 0 by exact oldNonzero
  have gap := Less.add_positive at
    cantorPrefix(X, n) * ((4 ^ n) * 4), 4 ^ n with remainderNonzero
  ring_nf at gap
  ring_nf
  exact gap

theorem cantorMid.not_mem_of_missing (X : Set, n : Nat)
  requires missing : ¬(n ∈ X)
  shows ¬(cantorMid(X, n) ∈ cantorReal(X))
proof
  intro inCut
  have shape := cantorReal.membership at X, cantorMid(X, n)
  obtain ⟨midInQ, m, mInOmega, midBelowEndpoint⟩ :=
    shape.forward with inCut
  have mNatural := nat.omega.backward with mInOmega
  have comparison := Less.trichotomy at m, n with mNatural
  cases comparison with mLessN | rest
  . have mLeN := Less.implies_LessEqual with mNatural, mLessN
    obtain ⟨k, kNatural, indexShape⟩ := mLeN
    have commute := add.commutative at k, m with kNatural
    rw commute at indexShape
    have weak : cantorApprox(X, m) = cantorApprox(X, add(k, m)) ∨ relates(rationalLess, cantorApprox(X, m), cantorApprox(X, add(k, m)))
      apply cantorApprox.offset_weak
    rw indexShape at weak
    have endpointBeforeMid : relates(rationalLess, cantorApprox(X, n), cantorMid(X, n))
      apply cantorApprox.before_mid
    cases weak with same | less
    . rw same at midBelowEndpoint
      have cycle := rationalLess.transitive with midBelowEndpoint, endpointBeforeMid
      have irreflexive := rationalLess.irreflexive_on
      exact irreflexive with cantorMid(X, n), midInQ, cycle
    . have midBelowN := rationalLess.transitive at
        cantorMid(X, n), cantorApprox(X, m), cantorApprox(X, n) with
          midBelowEndpoint, less
      have cycle := rationalLess.transitive with midBelowN, endpointBeforeMid
      have irreflexive := rationalLess.irreflexive_on
      exact irreflexive with cantorMid(X, n), midInQ, cycle
  . cases rest with equal | nLessM
    . rw equal at midBelowEndpoint
      have endpointBeforeMid : relates(rationalLess, cantorApprox(X, n), cantorMid(X, n))
        apply cantorApprox.before_mid
      have cycle := rationalLess.transitive with midBelowEndpoint, endpointBeforeMid
      have irreflexive := rationalLess.irreflexive_on
      exact irreflexive with cantorMid(X, n), midInQ, cycle
      obtain ⟨j, jNatural, tailIndexShape⟩ := nLessM
      have commute := add.commutative at j, succ(n) with jNatural
      rw commute at tailIndexShape
      have margin : (4 ^ succ(n)) * cantorPrefix(X, add(j, succ(n))) + 4 ^ succ(n) ≤ (4 ^ add(j, succ(n))) * (4 * cantorPrefix(X, n) + 1)
        apply cantorPrefix.zero_tail_margin
        . exact missing
      rw tailIndexShape at margin
      have successorNatural : Nat(succ(n)) by typecheck
      have midNonzero := pow.four_nonzero with successorNatural
      have endpointNonzero := pow.four_nonzero with mNatural
      unfold cantorMid at midBelowEndpoint
      unfold cantorApprox at midBelowEndpoint
      have cross := rationalLess.classes.forward with midNonzero, endpointNonzero, midBelowEndpoint
      ring_nf at cross
      have crossClean : (4 ^ m) * (4 * cantorPrefix(X, n) + 1) < (4 ^ succ(n)) * cantorPrefix(X, m)
        ring_nf
        exact cross
      have baseLeMargin : (4 ^ succ(n)) * cantorPrefix(X, m) ≤ (4 ^ succ(n)) * cantorPrefix(X, m) + 4 ^ succ(n)
        apply LessEqual.add_right
      have weakMargin := LessEqual.transitive with baseLeMargin, margin
      have reverseStrict := Less.transitive_LessEqual with crossClean, weakMargin
      exact Less.irreflexive with reverseStrict

theorem cantorReal.bit (X : Set, n : Nat)
  shows n ∈ X ↔ cantorMid(X, n) ∈ cantorReal(X)
proof
  constructor
  . intro member
    have midRational : Rational(cantorMid(X, n)) by apply cantorMid.rational at X, n
    have belowNext : relates(rationalLess, cantorMid(X, n), cantorApprox(X, succ(n)))
      apply cantorMid.below_next_of_member
      . exact member
    have successorNatural : Nat(succ(n)) by typecheck
    have successorInOmega := nat.omega.forward with successorNatural
    have shape := cantorReal.membership at X, cantorMid(X, n)
    apply shape.backward
    constructor
      exact midRational
    . refine ⟨succ(n), successorInOmega, belowNext⟩
  . intro midpointMember
    by_contra missing
    exact cantorMid.not_mem_of_missing with missing, midpointMember
