module Grace.Cumulus.Real.ArithmeticSeries
import Natural
import FiniteSum

defgraph arithmeticTerms (A D : Real) (n ∈ ℕ) : ℝ := A + (realNat(n):R) * D
proof
  have typedN := nat.omega.backward at n with member
  have count := realNat.real at n with typedN
  have term : Real((A:R) + (realNat(n):R) * (D:R))
    typecheck
  unfold Real at term
  exact term

theorem arithmeticTerms.sequence (A D : Real)
  shows RealSequence(arithmeticTerms(A, D))
proof
  unfold RealSequence
  exact arithmeticTerms.function at A, D with *

-- The first n terms, including the empty prefix when n = 0.
theorem arithmeticSeries.doubled (A D : Real, n : Nat)
  shows (2:R) * (∑ i < n, arithmeticTerms(A, D)(i):R) =
    (realNat(n):R) * ((2:R) * A + ((realNat(n):R) - (1:R)) * D)
proof
  induction n
  | zero =>
    rw [realPartialSum.zero, realNat.zero]
    ring
  | succ(k) using ih =>
    have sequence := arithmeticTerms.sequence at A, D with *
    have value := arithmeticTerms.value at A, D, k with *
    rw [realPartialSum.succ, value, realNat.succ]
    linear_combination ih

-- Inclusive indexing matches a + (a+d) + ... + (a+n*d).
theorem arithmeticSeries.inclusive (A D : Real, n : Nat)
  shows (2:R) * (∑ i < n + 1, arithmeticTerms(A, D)(i):R) =
    ((realNat(n):R) + (1:R)) * ((2:R) * A + (realNat(n):R) * D)
proof
  have bound : n + 1 = succ(n) := add.right_one at n
  rw bound
  have sequence := arithmeticTerms.sequence at A, D with *
  have doubled := arithmeticSeries.doubled at A, D, succ(n) with *
  rw realNat.succ at doubled
  linear_combination doubled

theorem arithmeticSeries.first_last (A D : Real, n : Nat)
  shows (2:R) * (∑ i < n + 1, arithmeticTerms(A, D)(i):R) =
    ((realNat(n):R) + (1:R)) * (A + (arithmeticTerms(A, D)[n]:R))
proof
  have bound : n + 1 = succ(n) := add.right_one at n
  rw bound
  have sequence := arithmeticTerms.sequence at A, D with *
  have value := arithmeticTerms.value at A, D, n with *
  have inclusive := arithmeticSeries.inclusive at A, D, n with *
  rw bound at inclusive
  rw value
  linear_combination inclusive

theorem arithmeticSeries.gauss (n : Nat)
  shows (2:R) * (∑ i < n + 1, arithmeticTerms(realZero, realOne)(i):R) =
    (realNat(n):R) * ((realNat(n):R) + (1:R))
proof
  have bound : n + 1 = succ(n) := add.right_one at n
  rw bound
  have sequence := arithmeticTerms.sequence at realZero, realOne with *
  have inclusive := arithmeticSeries.inclusive at realZero, realOne, n with *
  rw bound at inclusive
  linear_combination inclusive

theorem arithmeticSeries.odd_sum (n : Nat)
  shows ∑ k < n, arithmeticTerms(realOne, (2:R))(k) =
    (realNat(n):R) * (realNat(n):R)
proof
  have sequence := arithmeticTerms.sequence at realOne, (2:R) with *
  have prefix := realPartialSum.real with sequence
  have doubled := arithmeticSeries.doubled at realOne, (2:R), n with *
  apply realAddValue.double_cancel with prefix
  linear_combination doubled

theorem arithmeticSeries.quotient (A D : Real, n : Nat)
  shows ∑ i < n + 1, arithmeticTerms(A, D)(i) =
    (((realNat(n):R) + (1:R)) * ((2:R) * A + (realNat(n):R) * D)) /
      (2:R)
proof
  have bound : n + 1 = succ(n) := add.right_one at n
  rw bound
  have sequence := arithmeticTerms.sequence at A, D with *
  have prefix := realPartialSum.real at arithmeticTerms(A, D), succ(n) with sequence
  have numerator : Real(((realNat(n):R) + (1:R)) * ((2:R) * A + (realNat(n):R) * D))
    typecheck
  have inclusive := arithmeticSeries.inclusive at A, D, n with *
  rw bound at inclusive
  apply realDiv.of_double_eq at ∑ i < succ(n), arithmeticTerms(A, D)(i),
    ((realNat(n):R) + (1:R)) * ((2:R) * A + (realNat(n):R) * D) with prefix, numerator
  linear_combination inclusive
