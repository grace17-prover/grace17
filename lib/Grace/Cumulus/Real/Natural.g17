module Grace.Cumulus.Real.Natural
import Ring
import Algebra.Ring.Numeral

def realNat (n : Nat) → Set
  | zero => realZero
  | succ(k) => realAddValue(realNat(k), realOne)

theorem realNat.zero
  shows realNat(0) = (0:R)
proof
  simp

theorem realNat.succ (n : Nat)
  shows realNat(succ(n)) = realAddValue(realNat(n), realOne)
proof
  rw realNat
  rfl

theorem realNat.real (n : Nat)
  shows Real(realNat(n))
proof
  induction n
  | zero =>
    rw realNat
    exact realZero.real
  | succ(k) using ih =>
    rw realNat
    have typed := realAddValue.real with ih, realOne.real
    unfold call2 at typed
    unfold realAddValue
    exact typed

theorem realNat.one
  shows realNat(1) = (1:R)
proof
  rw [realNat.succ, realNat.zero]
  have zero := realAddValue.zero_left with realOne.real
  unfold call2 at zero
  unfold realAddValue
  rfl

theorem realNat.numeral (n : Nat)
  shows realNat(n) = ringNat(realAdd, realZero, realOne, n)
proof
  induction n
  | zero =>
    rw [realNat.zero, ringNat.zero]
    rfl
  | succ(k) using ih =>
    rw [realNat.succ, ringNat.succ, ih]
    unfold realAddValue
    unfold call2
    rfl

-- The real numeral: every literal above one elaborates to realNumeral(n), a
-- name of its own so that rewriting zero, one, or realNat leaves numerals
-- intact. The bridge to ringNat lets ring read it as the n-fold sum of one.
def realNumeral (n : Nat) : Set := realNat(n)

theorem realNumeral.nat (n : Nat)
  shows realNumeral(n) = realNat(n)
proof
  unfold realNumeral
  rfl

theorem realNumeral.real (n : Nat)
  shows Real(realNumeral(n))
proof
  rw realNumeral.nat
  exact realNat.real

theorem realNumeral.numeral (n : Nat)
  shows realNumeral(n) = ringNat(realAdd, realZero, realOne, n)
proof
  rw [realNumeral.nat, realNat.numeral]
  rfl

notation numeral _ => realNumeral(_) for Real

-- A natural number in a real position, an operand of a real operation or
-- comparison or one side of a real equation, is read as realNat(n) and
-- prints without the cast: n! * X is realNat(n!) * X.
notation coercion realNat for Nat, Real

theorem realNumeral.zero
  shows (0:R) = realZero
proof
  rfl

theorem realNumeral.succ (k : Nat)
  shows realNumeral(succ(k)) = realNumeral(k) + (1:R)
proof
  rw [realNumeral.numeral, ringNat.succ, realNumeral.numeral]
  rfl

theorem realNat.add (m n : Nat)
  shows realNat(add(m, n)) = (realNat(m):R) + (realNat(n):R)
proof
  induction m
  | zero =>
    rw [add, realNat.zero]
    ring
  | succ(k) using ih =>
    rw [add, realNat.succ, ih, realNat.succ]
    ring

theorem realNat.mul (m n : Nat)
  shows realNat(mul(m, n)) = (realNat(m):R) * (realNat(n):R)
proof
  induction m
  | zero =>
    rw [mul, realNat.zero]
    ring
  | succ(k) using ih =>
    rw [mul, realNat.add, ih, realNat.succ]
    ring
