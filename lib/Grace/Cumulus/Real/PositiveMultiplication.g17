module Grace.Cumulus.Real.PositiveMultiplication
import Multiplication

-- Two points of a lower cut have a common point strictly above both.  This is
-- the elementary directedness fact used whenever two open-cut witnesses must
-- be represented with a common factor.
theorem DedekindCut.exists_above_pair (A a b : Set)
  requires cut : DedekindCut(A)
  requires aInA : a ∈ A
  requires bInA : b ∈ A
  shows ∃ c ∈ A,
    relates(rationalLess, a, c) ∧ relates(rationalLess, b, c)
proof
  obtain ⟨u, uInA, aLessU⟩ := DedekindCut.no_greatest with cut, aInA
  by_contra noCommonUpper
  have subset := DedekindCut.subset_rationals with cut
  have uInQ := subset with u, uInA
  have bInQ := subset with b, bInA
  have aInQ := subset with a, aInA
  have aRational : Rational(a) by exact aInQ
  have uRational : Rational(u) by exact uInQ
  have distinct : u ≠ b
    intro equal
    obtain ⟨v, vInA, uLessV⟩ := DedekindCut.no_greatest with cut, uInA
    have vInQ := subset with v, vInA
    have vRational : Rational(v) by exact vInQ
    apply noCommonUpper
    refine ⟨v, vInA, _, _⟩
    . exact rationalLess.transitive at a, u, v with
        aRational, uRational, vRational, aLessU, uLessV
    . rw ← equal
      exact uLessV
  have connected := rationalLess.connected_on
  have comparison := connected with u, uInQ, b, bInQ, distinct
  cases comparison with uLessB | bLessU
  . obtain ⟨w, wInA, bLessW⟩ :=
      DedekindCut.no_greatest with cut, bInA
    have wInQ := subset with w, wInA
    have uLessW := rationalLess.transitive with uLessB, bLessW
    apply noCommonUpper
    refine ⟨w, wInA, _, bLessW⟩
    exact rationalLess.transitive with aLessU, uLessW
  . apply noCommonUpper
    refine ⟨u, uInA, aLessU, bLessU⟩

-- In a positive real cut, every chosen member can be replaced by a strictly
-- larger positive member.  Thus later product arguments may work entirely
-- with the familiar positive witnesses.
theorem RealLess.exists_positive_member_above (A : Real) (b : Rational)
  requires positive : 0 < A
  requires bInA : b ∈ A
  shows ∃ c ∈ A, b < c ∧ rationalZero < c
proof
  obtain ⟨a, aInA, positiveA⟩ := RealLess.exists_positive_member with positive
  have cutA := Real.characterization.forward with assumption
  obtain ⟨c, cInA, bLessC, aLessC⟩ := DedekindCut.exists_above_pair with cutA, bInA, aInA
  have subsetA := DedekindCut.subset_rationals with cutA
  have aRational : Rational(a)
    unfold Rational
    exact subsetA with a, aInA
  have cRational : Rational(c)
    unfold Rational
    exact subsetA with c, cInA
  refine ⟨c, cInA, bLessC, _⟩
  exact rationalLess.transitive with rationalZero.rational, aRational, cRational, positiveA, aLessC

-- A member of the positive-cut product of two positive reals always admits
-- positive factor witnesses, including when membership originally
-- came from the product's negative lower tail.
theorem realPosMulCut.positive_factors (A B : Real) (q : Rational)
  requires positiveA : 0 < A
  requires positiveB : 0 < B
  requires qInProduct : q ∈ realPosMulCut(A, B)
  shows ∃ a ∈ ℚ, a ∈ A ∧ ∃ b ∈ ℚ, b ∈ B ∧
    rationalZero < a ∧ rationalZero < b ∧ q < a * b
proof
  obtain ⟨qInQ, rest⟩ := realPosMulCut.membership.forward with qInProduct
  cases rest with qNegative | product
  . obtain ⟨a, aInA, aPositive⟩ :=
      RealLess.exists_positive_member with positiveA
    obtain ⟨b, bInB, bPositive⟩ := RealLess.exists_positive_member with positiveB
    have cutA := Real.characterization.forward at A with assumption
    have cutB := Real.characterization.forward at B with assumption
    have subsetA := DedekindCut.subset_rationals with cutA
    have subsetB := DedekindCut.subset_rationals with cutB
    have aInQ := subsetA with a, aInA
    have bInQ := subsetB with b, bInB
    have aRational : Rational(a) by exact aInQ
    have bRational : Rational(b) by exact bInQ
    have productPositive := rationalLess.mul_positive with aRational, bRational, aPositive, bPositive
    have productRational := rationalMulValue.rational with aRational, bRational
    have qRational : Rational(q) by typecheck
    refine ⟨a, aInQ, aInA, b, bInQ, bInB,
      aPositive, bPositive, _⟩
    exact rationalLess.transitive with
      qRational, rationalZero.rational, productRational, qNegative, productPositive
  . rcases product with
      ⟨a2, a2InQ, a2InA, b2, b2InQ, b2InB,
        a2Positive, b2Positive, qBelow⟩
    refine ⟨a2, a2InQ, a2InA, b2, b2InQ, b2InB,
      a2Positive, b2Positive, qBelow⟩

-- Monotonicity in the second summand, derived by commutativity so that the
-- public API supports the two-sided monotonicity argument.
theorem realAddCut.subset_right (A B C : Real)
  requires subset : A ⊆ B
  shows realAddCut(C, A) ⊆ realAddCut(C, B)
proof
  have left := realAddCut.subset_left at A, B, C with
    *{3}, subset
  have ca := realAddCut.commutative at C, A with *
  have cb := realAddCut.commutative at C, B with *
  rwa [ca, cb]

theorem realAddCut.nonnegative (A B : Real)
  requires nonnegativeA : realZero ⊆ A
  requires nonnegativeB : realZero ⊆ B
  shows realZero ⊆ realAddCut(A, B)
proof
  have first := realAddCut.subset_left at realZero, A, realZero with
    realZero.real, assumption, realZero.real, nonnegativeA
  have second := realAddCut.subset_right at realZero, B, A with
    realZero.real, *{2}, nonnegativeB
  have zeroSum := realAddCut.zero_left with realZero.real
  rw zeroSum at first
  exact Subset.transitive with first, second

theorem realAddValue.positive (A B : Real)
  requires positiveA : 0 < A
  requires positiveB : 0 < B
  shows 0 < A + B
proof
  have aboveB := realLess.add_right at realZero, A, B with
    realZero.real, *{2}, positiveA
  have zeroLeft := realAddValue.zero_left at B
  rw zeroLeft at aboveB
  have sumReal := realAddValue.real at A, B with *
  exact realLess.transitive at realZero, B, A + B with
    realZero.real, assumption, sumReal,
    positiveB, aboveB

-- The positive product is monotone in each cut argument.  This proof
-- transports the displayed factor witness; no arithmetic search is involved.
theorem realPosMulCut.subset_left (A B C : Real)
  requires subset : A ⊆ B
  shows realPosMulCut(A, C) ⊆ realPosMulCut(B, C)
proof
  intros q qInProduct
  obtain ⟨qInQ, rest⟩ := realPosMulCut.membership.forward with qInProduct
  apply realPosMulCut.membership.backward
  refine ⟨qInQ, _⟩
  cases rest with negative | product
  . left
    exact negative
  . rcases product with
      ⟨a, aInQ, aInA, c, cInQ, cInC,
        positiveA, positiveC, qBelow⟩
    have aInB : a ∈ B by exact subset with a, aInA
    right
    refine ⟨a, aInQ, aInB, c, cInQ, cInC,
      positiveA, positiveC, qBelow⟩

theorem realPosMulCut.subset_right (A B C : Real)
  requires subset : A ⊆ B
  shows realPosMulCut(C, A) ⊆ realPosMulCut(C, B)
proof
  have left := realPosMulCut.subset_left at A, B, C with
    *{3}, subset
  have ca := realPosMulCut.commutative at C, A with *
  have cb := realPosMulCut.commutative at C, B with *
  rwa [ca, cb]

-- A nonnegative real is either zero or strictly positive.  This is the
-- linear-order dichotomy, stated in the subset language used by
-- Dedekind cuts.
theorem Real.nonnegative_cases (A : Real)
  requires nonnegative : realZero ⊆ A
  shows A = realZero ∨ 0 < A
proof
  by_contra neither
  have notZero : ¬(A = realZero)
    intro equal
    apply neither
    left
    exact equal
  have notPositive : ¬(0 < A)
    intro positive
    apply neither
    right
    exact positive
  apply notPositive
  apply realLess.characterization.backward
  unfold RealLess
  refine ⟨realZero.real, assumption, _⟩
  unfold ProperSubset
  refine ⟨nonnegative, _⟩
  intro equal
  apply notZero
  rw equal
  rfl

-- One direction of distributivity for three positive cuts.  Starting from
-- q < a*x with x < b+c, we move b, c, and then a slightly inward.  The
-- resulting boundary products are members of A*B and A*C, while
-- rational distributivity supplies their sum.
theorem realPosMulCut.distrib_subset (A B C : Real)
  requires positiveA : 0 < A
  requires positiveB : 0 < B
  requires positiveC : 0 < C
  shows realPosMulCut(A, realAddCut(B, C)) ⊆
    realAddCut(realPosMulCut(A, B), realPosMulCut(A, C))
proof
  intros q qInLeft
  have qData := realPosMulCut.membership.forward with qInLeft
  rcases qData with ⟨qInQ, qRest⟩
  have qRational : Rational(q) by exact qInQ
  have sumReal := realAddCut.real at B, C with *
  have sumPositiveValue := realAddValue.positive with *{2}, positiveB, positiveC
  have sumCut := realAddValue.cut at B, C with *
  have sumPositive : realZero < realAddCut(B, C)
    rwa ← sumCut
  obtain ⟨a, aInQ, aInA, x, xInQ, xInSum,
      positiveRA, positiveX, qBelowAX⟩ :=
    realPosMulCut.positive_factors at A, realAddCut(B, C), q with
      assumption, sumReal, qRational,
      positiveA, sumPositive, qInLeft
  have aRational : Rational(a) by exact aInQ
  have xRational : Rational(x) by exact xInQ
  obtain ⟨xAgain, b, bInB, c, cInC, xBelowSum⟩ := realAddCut.membership_value.forward with xInSum
  rw ← rationalAddValue.notation at xBelowSum
  have cutB := Real.characterization.forward at B with assumption
  have cutC := Real.characterization.forward at C with assumption
  have subsetB := DedekindCut.subset_rationals with cutB
  have subsetC := DedekindCut.subset_rationals with cutC
  have bInQ := subsetB with b, bInB
  have cInQ := subsetC with c, cInC
  have bRational : Rational(b) by exact bInQ
  have cRational : Rational(c) by exact cInQ
  obtain ⟨b2, b2InB, bLessB2, positiveB2⟩ := RealLess.exists_positive_member_above with
    assumption, bRational, positiveB, bInB
  obtain ⟨c2, c2InC, cLessC2, positiveC2⟩ := RealLess.exists_positive_member_above with
    assumption, cRational, positiveC, cInC
  have b2InQ := subsetB with b2, b2InB
  have c2InQ := subsetC with c2, c2InC
  have b2Rational : Rational(b2) by exact b2InQ
  have c2Rational : Rational(c2) by exact c2InQ
  have firstGrowth := rationalLess.add_right with bRational, b2Rational, cRational, bLessB2
  have secondGrowth := rationalLess.add_left with cRational, c2Rational, b2Rational, cLessC2
  have enlargedSumRational := rationalAddValue.rational with b2Rational, c2Rational
  have xBelowEnlarged : x < b2 + c2
    calc
      x < b + c := xBelowSum
      _ < b2 + c := firstGrowth
      _ < b2 + c2 := secondGrowth
  have scaled := rationalLess.mul_left with
    xRational, enlargedSumRational, aRational, positiveRA, xBelowEnlarged
  have axRational := rationalMulValue.rational with aRational, xRational
  have enlargedProductRational := rationalMulValue.rational with aRational, enlargedSumRational
  have qBelowExpanded : q < a * (b2 + c2)
    exact rationalLess.transitive with qRational, axRational, enlargedProductRational, qBelowAX, scaled
  have distributed := rationalMulValue.distributive_left with aRational, b2Rational, c2Rational
  have qBelowProducts : q < a * b2 + a * c2
    rwa ← distributed
  obtain ⟨a2, a2InA, aLessA2, positiveA2⟩ := RealLess.exists_positive_member_above with
    assumption, aRational, positiveA, aInA
  have cutA := Real.characterization.forward at A with assumption
  have subsetA := DedekindCut.subset_rationals with cutA
  have a2InQ := subsetA with a2, a2InA
  have a2Rational : Rational(a2) by exact a2InQ
  have leftBoundary := rationalLess.mul_right with aRational, a2Rational, b2Rational, positiveB2, aLessA2
  have rightBoundary := rationalLess.mul_right with aRational, a2Rational, c2Rational, positiveC2, aLessA2
  have leftRational := rationalMulValue.rational with aRational, b2Rational
  have rightRational := rationalMulValue.rational with aRational, c2Rational
  have leftInProduct : a * b2 ∈ realPosMulCut(A, B)
    apply realPosMulCut.membership.backward
    refine ⟨leftRational, _⟩
    right
    refine ⟨a2, a2InQ, a2InA, b2, b2InQ, b2InB,
      positiveA2, positiveB2, leftBoundary⟩
  have rightInProduct : a * c2 ∈ realPosMulCut(A, C)
    apply realPosMulCut.membership.backward
    refine ⟨rightRational, _⟩
    right
    refine ⟨a2, a2InQ, a2InA, c2, c2InQ, c2InC,
      positiveA2, positiveC2, rightBoundary⟩
  rw rationalAddValue.notation at qBelowProducts
  apply realAddCut.membership_value.backward
  refine ⟨qInQ, a * b2, leftInProduct,
    a * c2, rightInProduct, qBelowProducts⟩

-- The reverse inclusion uses a common factor from A above the two displayed
-- product witnesses.  Rounding b and c upward makes b+c a member of
-- the sum cut, after which rational distributivity closes the estimate.
theorem realPosMulCut.distrib_reverse_subset (A B C : Real)
  requires positiveA : 0 < A
  requires positiveB : 0 < B
  requires positiveC : 0 < C
  shows realAddCut(realPosMulCut(A, B), realPosMulCut(A, C)) ⊆
    realPosMulCut(A, realAddCut(B, C))
proof
  intros q qInRight
  obtain ⟨qInQ, x, xInAB, y, yInAC, qBelowXY⟩ := realAddCut.membership_value.forward with qInRight
  rw ← rationalAddValue.notation at qBelowXY
  have subsetAB := realPosMulCut.subset_rationals at A, B
  have subsetAC := realPosMulCut.subset_rationals at A, C
  have xInQ := subsetAB with x, xInAB
  have yInQ := subsetAC with y, yInAC
  have xRational : Rational(x) by exact xInQ
  have yRational : Rational(y) by exact yInQ
  obtain ⟨a, aInQ, aInA, b, bInQ, bInB, positiveRA, positiveBFactor, xBelowAB⟩ := realPosMulCut.positive_factors with
    *{2}, xRational, positiveA, positiveB, xInAB
  obtain ⟨c, cInQ, cInA, d, dInQ, dInC, positiveRC, positiveDFactor, yBelowCD⟩ := realPosMulCut.positive_factors with
    *{2}, yRational, positiveA, positiveC, yInAC
  have aRational : Rational(a) by exact aInQ
  have bRational : Rational(b) by exact bInQ
  have cRational : Rational(c) by exact cInQ
  have dRational : Rational(d) by exact dInQ
  have cutA := Real.characterization.forward at A with assumption
  obtain ⟨e, eInA, aLessE, cLessE⟩ := DedekindCut.exists_above_pair with cutA, aInA, cInA
  have subsetA := DedekindCut.subset_rationals with cutA
  have eInQ := subsetA with e, eInA
  have eRational : Rational(e) by exact eInQ
  have positiveE := rationalLess.transitive with
    rationalZero.rational, aRational, eRational, positiveRA, aLessE
  have abRational := rationalMulValue.rational with aRational, bRational
  have cdRational := rationalMulValue.rational with cRational, dRational
  have ebRational := rationalMulValue.rational with eRational, bRational
  have edRational := rationalMulValue.rational with eRational, dRational
  have xGrowth := rationalLess.add_right with xRational, abRational, yRational, xBelowAB
  have yGrowth := rationalLess.add_left with yRational, cdRational, abRational, yBelowCD
  have abGrowth := rationalLess.mul_right with positiveBFactor, aLessE
  have cdGrowth := rationalLess.mul_right with positiveDFactor, cLessE
  have firstProductGrowth := rationalLess.add_right with abRational, ebRational, cdRational, abGrowth
  have secondProductGrowth := rationalLess.add_left with cdRational, edRational, ebRational, cdGrowth
  have qBelowCommonSum : q < e * b + e * d
    calc
      q < x + y := qBelowXY
      _ < a * b + y := xGrowth
      _ < a * b + c * d := yGrowth
      _ < e * b + c * d := firstProductGrowth
      _ < e * b + e * d := secondProductGrowth
  have distributed := rationalMulValue.distributive_left with eRational, bRational, dRational
  have qBelowFactored : q < e * (b + d) by rwa distributed
  have cutB := Real.characterization.forward at B with assumption
  have cutC := Real.characterization.forward at C with assumption
  have subsetB := DedekindCut.subset_rationals with cutB
  have subsetC := DedekindCut.subset_rationals with cutC
  obtain ⟨b2, b2InB, bLessB2, positiveB2⟩ := RealLess.exists_positive_member_above with
    assumption, bRational, positiveB, bInB
  obtain ⟨d2, d2InC, dLessD2, positiveD2⟩ := RealLess.exists_positive_member_above with
    assumption, dRational, positiveC, dInC
  have b2InQ := subsetB with b2, b2InB
  have d2InQ := subsetC with d2, d2InC
  have b2Rational : Rational(b2) by exact b2InQ
  have d2Rational : Rational(d2) by exact d2InQ
  have bGrowth := rationalLess.add_right with bRational, b2Rational, dRational, bLessB2
  have dGrowth := rationalLess.add_left with dRational, d2Rational, b2Rational, dLessD2
  have sumBelowRounded : b + d < b2 + d2
    calc
      b + d < b2 + d := bGrowth
      _ < b2 + d2 := dGrowth
  have bdRational := rationalAddValue.rational with bRational, dRational
  have zeroPlusD := rationalAddValue.zero_left with dRational
  have dBelowSum := rationalLess.add_right with rationalZero.rational, bRational, dRational, positiveBFactor
  rw zeroPlusD at dBelowSum
  have positiveSum := rationalLess.transitive with
    rationalZero.rational, dRational, bdRational, positiveDFactor, dBelowSum
  have sumInCut : b + d ∈ realAddCut(B, C)
    apply realAddCut.membership_value.backward
    refine ⟨bdRational, b2, b2InB, d2, d2InC, _⟩
    rwa ← rationalAddValue.notation
  apply realPosMulCut.membership.backward
  refine ⟨qInQ, _⟩
  right
  refine ⟨e, eInQ, eInA, b + d, _, sumInCut,
    positiveE, positiveSum, qBelowFactored⟩
  exact bdRational

theorem realPosMulCut.distributive_of_positive (A B C : Real)
  requires positiveA : 0 < A
  requires positiveB : 0 < B
  requires positiveC : 0 < C
  shows realPosMulCut(A, realAddCut(B, C)) =
    realAddCut(realPosMulCut(A, B), realPosMulCut(A, C))
proof
  apply Subset.antisymmetric
  . exact realPosMulCut.distrib_subset at A, B, C with
      *{3},
      positiveA, positiveB, positiveC
  . exact realPosMulCut.distrib_reverse_subset at A, B, C with
      *{3},
      positiveA, positiveB, positiveC
