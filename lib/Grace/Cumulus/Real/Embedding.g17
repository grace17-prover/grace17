-- The rational embedding into the Dedekind reals: the cut map is strictly
-- monotone and injective, reflects the order, and ℚ is dense in ℝ
-- Part of Cumulus, the Grace17 mathematics library.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module Grace.Cumulus.Real.Embedding
import Order

-- The canonical map q ↦ { p ∈ ℚ | p < q } as a set-valued graph.
def rationalEmbedding : Set :=
  { p ∈ ℚ × ℝ |
    ∃ q ∈ ℚ, p = (q ↦ rationalCut(q)) }

theorem rationalEmbedding.membership (p : Set)
  shows p ∈ rationalEmbedding ↔
    (p ∈ ℚ × ℝ ∧ ∃ q ∈ ℚ, p = (q ↦ rationalCut(q)))
proof
  simp

theorem rationalEmbedding.relates (q x : Set)
  shows relates(rationalEmbedding, q, x) ↔
    (q ∈ ℚ ∧ x = rationalCut(q))
proof
  constructor
  . intro related
    unfold relates at related
    simp [rationalEmbedding.membership] at related
    rcases related with ⟨bounded, r, rRational, shape⟩
    obtain ⟨qShape, xShape⟩ := orderedPair.injective with shape
    constructor
    . rw qShape
      exact rRational
    . rw qShape
      exact xShape
  . intro data
    rcases data with ⟨qRational, rfl⟩
    have qTyped : Rational(q) by exact qRational
    unfold relates
    apply rationalEmbedding.membership.backward
    constructor
    . apply product.pair at q, rationalCut(q), ℚ, ℝ
      . exact qRational
      . exact rationalCut.real with qTyped
    . refine ⟨q, qRational, rfl⟩

theorem rationalEmbedding.total
  shows TotalBetween(rationalEmbedding, ℚ, ℝ)
proof
  intros q qRational
  have qTyped : Rational(q) by exact qRational
  witness rationalCut(q)
  constructor
  . exact rationalCut.real with qTyped
  . apply rationalEmbedding.relates.backward at q, rationalCut(q)
    refine ⟨qRational, rfl⟩

theorem rationalEmbedding.functional
  shows Functional(rationalEmbedding)
proof
  intros q x qx y qy
  have xData := rationalEmbedding.relates.forward with qx
  have yData := rationalEmbedding.relates.forward with qy
  rcases xData with ⟨_, xShape⟩
  rcases yData with ⟨_, yShape⟩
  rw [xShape, yShape]
  rfl

theorem rationalEmbedding.function
  shows rationalEmbedding : ℚ → ℝ
proof
  constructor
    intros p hp
    simp [rationalEmbedding.membership] at hp
    rcases hp with ⟨bounded, witnesses⟩
    exact bounded
  . constructor
    . exact rationalEmbedding.functional
    . exact rationalEmbedding.total

theorem rationalEmbedding.value (q : Set)
  requires qRational : Rational(q)
  shows rationalEmbedding(q) = rationalCut(q)
proof
  apply FunctionBetween.apply_value at rationalEmbedding, ℚ, ℝ, q, rationalCut(q)
  . exact rationalEmbedding.function
    exact qRational
  . apply rationalEmbedding.relates.backward at q, rationalCut(q)
    constructor
      exact qRational
    . rfl

-- Equality of lower cuts reflects equality of rationals.  Connectedness of
-- the rational order leaves only the two strict cases, and strict monotonicity
-- makes either case incompatible with equal cuts.
theorem rationalCut.injective (q r : Set)
  requires qRational : Rational(q)
  requires rRational : Rational(r)
  requires equalCuts : rationalCut(q) = rationalCut(r)
  shows q = r
proof
  by_contra distinct
  have qInQ := qRational
  have rInQ := rRational
  have connected := rationalLess.connected_on
  have comparison := connected with q, qInQ, r, rInQ, distinct
  rcases comparison with qLessR | rLessQ
  . have strict := rationalCut.strict_mono at q, r with
      qRational, rRational, qLessR
    rcases strict with ⟨_, _, proper⟩
    have unequal := ProperSubset.ne with proper
    exact unequal with equalCuts
  . have strict := rationalCut.strict_mono at r, q with
      rRational, qRational, rLessQ
    rcases strict with ⟨_, _, proper⟩
    have unequal := ProperSubset.ne with proper
    apply unequal
    rw equalCuts
    rfl

theorem rationalEmbedding.injective
  shows InjectiveBetween(rationalEmbedding, ℚ, ℝ)
proof
  constructor
  . exact rationalEmbedding.function
  . intros q qInQ r rInQ x xInR qx rx
    have qData := rationalEmbedding.relates.forward with qx
    have rData := rationalEmbedding.relates.forward with rx
    rcases qData with ⟨_, qShape⟩
    rcases rData with ⟨_, rShape⟩
    have equalCuts : rationalCut(q) = rationalCut(r) by rwa ← qShape
    exact rationalCut.injective with equalCuts

-- The cut embedding reflects the order.
theorem rationalCut.lt_of_cut_lt (p q : Rational)
  requires less : RealLess(rationalCut(p), rationalCut(q))
  shows p < q
proof
  have order := rationalLess.trichotomy at p, q
  cases order with below | rest
  . exact below
  . exfalso
    cases rest with equal | above
    . rw equal at less
      exact RealLess.irreflexive with less
    . have reversed := rationalCut.strict_mono with above
      have cycle := RealLess.transitive with less, reversed
      exact RealLess.irreflexive with cycle

-- The rationals are dense in the reals: between two reals lies a rational
-- cut. A real is a lower cut; a rational of y missing from x, pushed up
-- once inside y, has a cut strictly between the two.
theorem rationalCut.between (x y : Real)
  requires less : x < y
  shows ∃ q ∈ ℚ, x < rationalCut(q) ∧ rationalCut(q) < y
proof
  obtain ⟨typedX, typedY, inclusion⟩ :=
    realLess.characterization.forward with less
  have cutX := Real.characterization.forward with typedX
  have cutY := Real.characterization.forward with typedY
  obtain ⟨r, rInY, rMissing⟩ := ProperSubset.missing with inclusion
  obtain ⟨s, sInY, rLessS⟩ := DedekindCut.no_greatest with cutY, rInY
  have rationalsX := DedekindCut.subset_rationals with cutX
  have rationalsY := DedekindCut.subset_rationals with cutY
  have rInQ := rationalsY with r, rInY
  have sInQ := rationalsY with s, sInY
  have cutS := rationalCut.real at s with sInQ
  have transitive := rationalLess.transitive_on
  witness s
  refine ⟨sInQ, ?_, ?_⟩
  . apply realLess.characterization.backward
    refine ⟨typedX, cutS, ?_⟩
    constructor
    . intros p pInX
      have pInQ := rationalsX with p, pInX
      have pLessR := DedekindCut.lt_missing with cutX, pInX, rInQ, rMissing
      have pLessS := transitive with
        p, pInQ, r, rInQ, s, sInQ, pLessR, rLessS
      exact rationalCut.membership.backward with ⟨pInQ, pLessS⟩
    . intro same
      apply rMissing
      rw same
      exact rationalCut.membership.backward with ⟨rInQ, rLessS⟩
  . apply realLess.characterization.backward
    refine ⟨cutS, typedY, ?_⟩
    constructor
    . intros p pInCut
      obtain ⟨pInQ, pLessS⟩ := rationalCut.membership.forward with pInCut
      exact DedekindCut.downward with cutY, sInY, pInQ, pLessS
    . intro same
      have sInCut : s ∈ rationalCut(s)
        rw same
        exact sInY
      obtain ⟨_, selfLess⟩ := rationalCut.membership.forward with sInCut
      have irreflexive := rationalLess.irreflexive_on
      exact irreflexive with s, sInQ, selfLess
