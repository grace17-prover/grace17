-- Authors: Grant Passmore

module Grace.Cumulus.Real.RationalQuotients
import Grace.Cumulus.Real.Rationals
import Grace.Cumulus.Real.Integer

-- Integers and naturals inside the reals

-- A nonzero integer has a nonzero real image.
theorem realInt.nonzero (q : Integer)
  requires nonzero : q ≠ 0
  shows realInt(q) ≠ (0:R)
proof
  intro zero
  rw ← realInt.zero at zero
  have same := realInt.injective at q, integerZero with zero
  exact nonzero with same

-- Between a natural and a larger one lies a nonzero natural gap.
theorem realNat.gap (d c : Nat)
  requires less : d < c
  shows ∃ m, Nat(m) ∧ m ≠ 0 ∧
    (realNat(c):R) = (realNat(d):R) + realNat(m)
proof
  obtain ⟨k, kNat, equation⟩ := less
  have succNat := Naturals.constructor.succ with kNat
  have nonzero : succ(k) ≠ 0
    intro zero
    have disjoint := Naturals.disjoint.zero.succ at k
    symm at zero
    exact disjoint with zero
  refine ⟨succ(k), succNat, nonzero, ?_⟩
  rw [← equation, realNat.add, realNat.successor, realNat.successor]
  ring

-- Rationals as quotients

-- A real that scales by a nonzero natural to a difference of naturals is
-- the cut of the class (a, b, m).
theorem rationalReals.of_scaled (x : Real) (a b m : Nat)
  requires nonzero : m ≠ 0
  requires scaled : x * realNat(m) = (realNat(a):R) - (realNat(b):R)
  shows x ∈ rationalReals
proof
  have rational := rationalClass.rational at a, b, m with nonzero
  have cut := rationalCut.scaled at a, b, m with nonzero
  have mNonzero := realNat.nonzero with nonzero
  have unit := realInvValue.mul_right with mNonzero
  have same : rationalCut(rationalClass(a, b, m)) = x
    linear_combination realInvValue(realNat(m)) * cut -
      realInvValue(realNat(m)) * scaled +
      (x - rationalCut(rationalClass(a, b, m))) * unit
  apply rationalReals.membership.backward
  exact ⟨rationalClass(a, b, m), rational, same⟩

-- Forward: Rational.coordinates writes the rational as a class (a, b, m),
-- and rationalCut.scaled, realInt.class, realInt.nat give the quotient.
-- Backward: Integer.representatives writes p and q as differences of
-- naturals, and rationalReals.of_scaled applies after the sign cases of q.
theorem rationalReals.quotient (x : Real)
  shows x ∈ rationalReals ↔
    ∃ p ∈ ℤ, ∃ q ∈ ℤ, q ≠ 0 ∧ x * realInt(q) = realInt(p)
proof
  constructor
  . intro member
    obtain ⟨r, rInQ, shape⟩ := rationalReals.membership.forward with member
    obtain ⟨a, aNat, b, bNat, m, mNat, mNonzero, class⟩ :=
      Rational.coordinates at r with rInQ
    have scaled := rationalCut.scaled at a, b, m with mNonzero
    have numerator := realInt.class at a, b with aNat, bNat
    have denominator := realInt.nat at m with mNat
    have pInt := integerClass.integer at a, b with aNat, bNat
    have qInt := integerOfNat.integer at m with mNat
    have qNonzero : integerOfNat(m) ≠ 0
      intro zero
      have zeroIff := integerOfNat.eq_zero_iff at m with mNat
      have mZero := zeroIff.forward with zero
      exact mNonzero with mZero
    refine ⟨integerClass(a, b), pInt, integerOfNat(m), qInt, qNonzero, ?_⟩
    rw [numerator, denominator, ← shape, class]
    exact scaled
  . intro quotient
    obtain ⟨p, pInt, q, qInt, qNonzero, equation⟩ := quotient
    obtain ⟨a, aNat, b, bNat, pShape⟩ :=
      Integer.representatives at p with pInt
    obtain ⟨c, cNat, d, dNat, qShape⟩ :=
      Integer.representatives at q with qInt
    have numerator := realInt.class at a, b with aNat, bNat
    have denominator := realInt.class at c, d with cNat, dNat
    have qNonzeroReal := realInt.nonzero at q with qNonzero
    rw [pShape, numerator] at equation
    rw [qShape, denominator] at equation
    rw [qShape, denominator] at qNonzeroReal
    rcases Less.trichotomy at c, d with cNat, dNat with less | same | greater
    . obtain ⟨m, mNat, mNonzero, gap⟩ := realNat.gap at c, d with less
      have scaled : x * realNat(m) = (realNat(b):R) - (realNat(a):R)
        rw gap at equation
        linear_combination (-1) * equation
      exact rationalReals.of_scaled at x, b, a, m with mNonzero, scaled
    . exfalso
      apply qNonzeroReal
      rw same
      ring
    . obtain ⟨m, mNat, mNonzero, gap⟩ := realNat.gap at d, c with greater
      have scaled : x * realNat(m) = (realNat(a):R) - (realNat(b):R)
        rw gap at equation
        linear_combination equation
      exact rationalReals.of_scaled at x, a, b, m with mNonzero, scaled

-- The backward direction, for `exact`.
theorem rationalReals.of_quotient (x : Real) (p q : Integer)
  requires nonzero : q ≠ 0
  requires scaled : x * realInt(q) = realInt(p)
  shows x ∈ rationalReals
proof
  have quotient := rationalReals.quotient at x
  apply quotient.backward
  refine ⟨p, ?_, q, ?_, nonzero, scaled⟩
  . typecheck
  . typecheck

theorem rationalReals.real (x : Set)
  requires member : x ∈ rationalReals
  shows Real(x)
proof
  obtain ⟨q, qInQ, shape⟩ := rationalReals.membership.forward with member
  rw ← shape
  exact rationalCut.real with qInQ

-- The closure laws

theorem rationalReals.int_mem (z : Integer)
  shows realInt(z) ∈ rationalReals
proof
  have scaled : realInt(z) * realInt(integerOne) = realInt(z)
    rw realInt.one
    ring
  exact rationalReals.of_quotient at realInt(z), z, integerOne with
    integerOne.ne_zero, scaled

theorem rationalReals.zero_mem
  shows (0:R) ∈ rationalReals
proof
  rw ← realInt.zero
  exact rationalReals.int_mem at integerZero

theorem rationalReals.one_mem
  shows (1:R) ∈ rationalReals
proof
  rw ← realInt.one
  exact rationalReals.int_mem at integerOne

theorem rationalReals.nat_mem (n : Nat)
  shows realNat(n) ∈ rationalReals
proof
  rw ← realInt.nat
  exact rationalReals.int_mem at integerOfNat(n)

-- p/q + r/s = (ps + rq)/(qs).
theorem rationalReals.add_mem (x y : Real)
  requires xIn : x ∈ rationalReals
  requires yIn : y ∈ rationalReals
  shows x + y ∈ rationalReals
proof
  have xQuotient := rationalReals.quotient at x
  have yQuotient := rationalReals.quotient at y
  obtain ⟨p, pInt, q, qInt, qNonzero, xScaled⟩ := xQuotient.forward with xIn
  obtain ⟨r, rInt, s, sInt, sNonzero, yScaled⟩ := yQuotient.forward with yIn
  have nonzero := integerMulValue.nonzero at q, s with qNonzero, sNonzero
  have scaled : (x + y) * realInt(q * s) = realInt(p * s + r * q)
    rw [realInt.mul, realInt.add, realInt.mul, realInt.mul]
    linear_combination realInt(s) * xScaled + realInt(q) * yScaled
  exact rationalReals.of_quotient at x + y, p * s + r * q, q * s with
    nonzero, scaled

theorem rationalReals.neg_mem (x : Real)
  requires xIn : x ∈ rationalReals
  shows -x ∈ rationalReals
proof
  have xQuotient := rationalReals.quotient at x
  obtain ⟨p, pInt, q, qInt, qNonzero, xScaled⟩ := xQuotient.forward with xIn
  have scaled : -x * realInt(q) = realInt(-p)
    rw realInt.neg
    linear_combination (-1) * xScaled
  exact rationalReals.of_quotient at -x, -p, q with qNonzero, scaled

theorem rationalReals.sub_mem (x y : Real)
  requires xIn : x ∈ rationalReals
  requires yIn : y ∈ rationalReals
  shows x - y ∈ rationalReals
proof
  have negative := rationalReals.neg_mem at y with yIn
  have same : x - y = x + -y by ring
  rw same
  exact rationalReals.add_mem with xIn, negative

-- (p/q)(r/s) = (pr)/(qs).
theorem rationalReals.mul_mem (x y : Real)
  requires xIn : x ∈ rationalReals
  requires yIn : y ∈ rationalReals
  shows x * y ∈ rationalReals
proof
  have xQuotient := rationalReals.quotient at x
  have yQuotient := rationalReals.quotient at y
  obtain ⟨p, pInt, q, qInt, qNonzero, xScaled⟩ := xQuotient.forward with xIn
  obtain ⟨r, rInt, s, sInt, sNonzero, yScaled⟩ := yQuotient.forward with yIn
  have nonzero := integerMulValue.nonzero at q, s with qNonzero, sNonzero
  have scaled : (x * y) * realInt(q * s) = realInt(p * r)
    rw [realInt.mul, realInt.mul]
    linear_combination (y * realInt(s)) * xScaled + realInt(p) * yScaled
  exact rationalReals.of_quotient at x * y, p * r, q * s with nonzero, scaled

-- The inverse of p/q is q/p: the quotient form needs no inverse on ℚ.
theorem rationalReals.inv_mem (x : Real)
  requires xIn : x ∈ rationalReals
  requires nonzero : x ≠ 0
  shows realInvValue(x) ∈ rationalReals
proof
  have xQuotient := rationalReals.quotient at x
  obtain ⟨p, pInt, q, qInt, qNonzero, xScaled⟩ := xQuotient.forward with xIn
  have unit := realInvValue.mul_right with nonzero
  have qNonzeroReal := realInt.nonzero at q with qNonzero
  have qUnit := realInvValue.mul_right with qNonzeroReal
  have pNonzero : p ≠ 0
    intro pZero
    rw [pZero, realInt.zero] at xScaled
    apply nonzero
    linear_combination realInvValue(realInt(q)) * xScaled - x * qUnit
  have scaled : realInvValue(x) * realInt(p) = realInt(q)
    linear_combination realInt(q) * unit - realInvValue(x) * xScaled
  exact rationalReals.of_quotient at realInvValue(x), q, p with pNonzero, scaled

theorem rationalReals.div_mem (x y : Real)
  requires xIn : x ∈ rationalReals
  requires yIn : y ∈ rationalReals
  requires nonzero : y ≠ 0
  shows x / y ∈ rationalReals
proof
  have inverse := rationalReals.inv_mem at y with yIn, nonzero
  rw realDiv.eq_mul_inv
  exact rationalReals.mul_mem with xIn, inverse

theorem rationalReals.div_int (p q : Integer)
  requires nonzero : q ≠ 0
  shows realInt(p) / realInt(q) ∈ rationalReals
proof
  have pIn := rationalReals.int_mem at p
  have qIn := rationalReals.int_mem at q
  have qNonzero := realInt.nonzero at q with nonzero
  exact rationalReals.div_mem at realInt(p), realInt(q) with pIn, qIn, qNonzero
