module Grace.Cumulus.Real.PositiveInverse
import Ring

-- For a positive cut A, this is the usual lower cut of 1/A.  The extra
-- rational s records openness: q belongs when q < s and some
-- positive r outside A still satisfies s*r < 1.
def positiveRealInvCut (A : Set) : Set :=
  { q ∈ ℚ |
    ¬(rationalZero < q) ∨
    ∃ s ∈ ℚ, q < s ∧
      ∃ r ∈ ℚ, ¬(r ∈ A) ∧ rationalZero < r ∧
        rationalMulValue(s, r) < rationalOne }

theorem positiveRealInvCut.membership (A q : Set)
  shows q ∈ positiveRealInvCut(A) ↔
    (q ∈ ℚ ∧
      (¬(rationalZero < q) ∨
        ∃ s ∈ ℚ, q < s ∧
          ∃ r ∈ ℚ, ¬(r ∈ A) ∧ rationalZero < r ∧
            rationalMulValue(s, r) < rationalOne))
proof
  simp

theorem positiveRealInvCut.subset_rationals (A : Set)
  shows positiveRealInvCut(A) ⊆ ℚ
proof
  intros q member
  obtain ⟨qInQ, condition⟩ := positiveRealInvCut.membership.forward with member
  exact qInQ

theorem positiveRealInvCut.of_nonpositive (A q : Set)
  requires qRational : Rational(q)
  requires nonpositive : ¬(rationalZero < q)
  shows q ∈ positiveRealInvCut(A)
proof
  apply positiveRealInvCut.membership.backward
  constructor
  . exact qRational
  . left
    exact nonpositive

theorem positiveRealInvCut.of_witness (A : Set, q s r : Rational)
  requires below : q < s
  requires outside : ¬(r ∈ A)
  requires positive : rationalZero < r
  requires productBelowOne : rationalMulValue(s, r) < rationalOne
  shows q ∈ positiveRealInvCut(A)
proof
  apply positiveRealInvCut.membership.backward
  have qInQ : q ∈ ℚ by simp [Rational]
  have sInQ : s ∈ ℚ by simp [Rational]
  have rInQ : r ∈ ℚ by simp [Rational]
  constructor
  . exact qInQ
  . right
    witness s
    refine ⟨sInQ, below, r, rInQ, outside, positive, productBelowOne⟩

theorem positiveRealInvCut.zero_mem (A : Set)
  shows rationalZero ∈ positiveRealInvCut(A)
proof
  apply positiveRealInvCut.of_nonpositive with rationalZero.rational
  intro zeroLessZero
  have irreflexive := rationalLess.irreflexive_on
  exact irreflexive with rationalZero, zeroLessZero

theorem positiveRealInvCut.nonempty (A : Set)
  shows Nonempty(positiveRealInvCut(A))
proof
  witness rationalZero
  exact positiveRealInvCut.zero_mem

theorem positiveRealInvCut.downward (A : Set, p q : Rational)
  requires qMember : q ∈ positiveRealInvCut(A)
  requires less : p < q
  shows p ∈ positiveRealInvCut(A)
proof
  obtain ⟨qInQ, condition⟩ := positiveRealInvCut.membership.forward with qMember
  cases condition with qNonpositive | witness
  . apply positiveRealInvCut.of_nonpositive at A, p
    intro pPositive
    have qPositive := rationalLess.transitive with rationalZero.rational, pPositive, less
    exact qNonpositive with qPositive
  . obtain ⟨s, sInQ, qLessS, r, rInQ, outside, positiveR,
      productBelowOne⟩ := witness
    have sRational : Rational(s) by exact sInQ
    have rRational : Rational(r) by exact rInQ
    have pLessS := rationalLess.transitive at p, q, s with
      *{2}, sRational, less, qLessS
    exact positiveRealInvCut.of_witness with
      assumption, sRational, rRational, pLessS, outside, positiveR, productBelowOne

theorem rationalZero.lt_one
  shows rationalZero < rationalOne
proof
  have positive := rationalLess.positive_natural_successor with Naturals.constructor.zero
  simpa [rationalOne] using positive

-- A positive displayed fraction (a-b)/m has the positive reciprocal
-- m/(a-b).  We expose only the field statement; coordinates are
-- confined to this proof so later analysis can reason entirely with *.
theorem rationalMulValue.exists_positive_inverse (x : Rational)
  requires positive : rationalZero < x
  shows ∃ y ∈ ℚ, rationalZero < y ∧ x * y = rationalOne
proof
  obtain ⟨a, aNatural, b, bNatural, m, mNatural, mNonzero, xShape⟩ :=
    Rational.coordinates with assumption
  have oneNonzero : 1 ≠ 0
    intro oneZero
    arith
  have displayedPositive := positive
  rw xShape at displayedPositive
  unfold rationalZero at displayedPositive
  have bLessA : b < a
    have cross := rationalLess.classes.forward with oneNonzero, mNonzero, displayedPositive
    simpa [mul.left_zero, mul.right_zero, mul.left_unit,
      mul.right_unit, add.left_unit, add.right_unit] using cross
  obtain ⟨k, kNatural, aShape⟩ := bLessA
  have gapNonzero : succ(k) ≠ 0
    intro gapZero
    have zeroNotGap := Naturals.disjoint.zero.succ at k
    apply zeroNotGap
    rw gapZero
    rfl
  have inverseRational := rationalClass.rational at m, 0, succ(k) with
    gapNonzero
  have inversePositive : rationalZero < rationalClass(m, 0, succ(k))
    unfold rationalZero
    apply rationalLess.classes.backward with oneNonzero, gapNonzero
    ring_nf
    have mPositive := Less.add_positive at 0, m with mNonzero
    simpa [add.left_unit] using mPositive
  have productOne : rationalMulValue(rationalClass(a, b, m), rationalClass(m, 0, succ(k))) = rationalOne
    rw rationalMulValue.classes
    unfold rationalClassMul
    unfold rationalOne
    apply rationalClass.eq
    . exact mul.nonzero with mNonzero, gapNonzero
    . exact oneNonzero
    . rw ← aShape
      ring
  witness rationalClass(m, 0, succ(k))
  refine ⟨_, inversePositive, _⟩
    exact inverseRational
  . rw [rationalMulValue.notation, xShape]
    exact productOne

-- Strictly separate two reciprocal bounds.  This is the approximation move
-- used by the real inverse proof: from q*r<a we choose b<s with q<a*b and
-- s*r<1.  The statement is coordinate-free and reads as plain algebra.
theorem rationalLess.exists_reciprocal_interval (q a r : Rational)
  requires positiveQ : rationalZero < q
  requires positiveA : rationalZero < a
  requires positiveR : rationalZero < r
  requires below : q * r < a
  shows ∃ b ∈ ℚ, ∃ s ∈ ℚ,
    rationalZero < b ∧ q < a * b ∧ b < s ∧ s * r < rationalOne
proof
  obtain ⟨u, uInQ, positiveU, auOne⟩ := rationalMulValue.exists_positive_inverse with positiveA
  obtain ⟨v, vInQ, positiveV, rvOne⟩ := rationalMulValue.exists_positive_inverse with positiveR
  have uRational : Rational(u) by exact uInQ
  have vRational : Rational(v) by exact vInQ
  have scaledBelow := rationalLess.mul_right at q * r, a, u with
    *{2}, uRational, positiveU, below
  rw auOne at scaledBelow
  have rquAssociative := rationalMulValue.associative at r, q, u with
    *{2}, uRational
  have rqCommutative := rationalMulValue.commutative at r, q with
    *{2}
  have productReassociate : r * (q * u) = (q * r) * u
    rw [← rqCommutative, rquAssociative]
    rfl
  rw ← productReassociate at scaledBelow
  have quBelowV : q * u < v
    apply rationalLess.of_mul_left with positiveR
    rwa rvOne
  obtain ⟨b, bInQ, quBelowB, bBelowV⟩ := rationalLess.dense at q * u, v with
    assumption, vRational, quBelowV
  have bRational : Rational(b) by exact bInQ
  have quPositive := rationalLess.mul_positive with positiveQ, positiveU
  have bPositive := rationalLess.transitive at rationalZero, q * u, b with
    rationalZero.rational, assumption, bRational, quPositive, quBelowB
  obtain ⟨s, sInQ, bBelowS, sBelowV⟩ := rationalLess.dense with bBelowV
  have qBelowABScaled := rationalLess.mul_left at q * u, b, a with
    assumption, bRational, assumption, positiveA, quBelowB
  have aquAssociative := rationalMulValue.associative at a, q, u with
    *{2}, uRational
  have aqCommutative := rationalMulValue.commutative at a, q with
    *{2}
  have qauAssociative := rationalMulValue.associative at q, a, u with
    *{2}, uRational
  have aqUShape : a * (q * u) = q
    rw [← aquAssociative, aqCommutative, qauAssociative, auOne]
    exact rationalMulValue.one_right with assumption
  rw aqUShape at qBelowABScaled
  have srBelowVR := rationalLess.mul_right with positiveR, sBelowV
  have vrOne : v * r = rationalOne
    have commutative := rationalMulValue.commutative at v, r with
      vRational, assumption
    rwa commutative
  rw vrOne at srBelowVR
  witness b
  refine ⟨bInQ, s, sInQ, bPositive, qBelowABScaled, bBelowS, srBelowVR⟩

-- A positive cut can be crossed by positive rationals a<r so tightly that
-- q*r<a, for any fixed 0<q<1.  This is the multiplicative form of the
-- Archimedean boundary approximation theorem.
theorem RealLess.exists_multiplicative_boundary (A : Real) (q : Rational)
  requires positiveA : 0 < A
  requires positiveQ : rationalZero < q
  requires qBelowOne : q < rationalOne
  shows ∃ a ∈ ℚ, a ∈ A ∧ rationalZero < a ∧
    ∃ r ∈ ℚ, ¬(r ∈ A) ∧ rationalZero < r ∧ q * r < a
proof
  have cutA := Real.characterization.forward with assumption
  obtain ⟨c, cInA, cPositive⟩ := RealLess.exists_positive_member with positiveA
  have subsetA := DedekindCut.subset_rationals with cutA
  have cInQ := subsetA with c, cInA
  have cRational : Rational(c) by exact cInQ
  have gapRational := rationalSubValue.rational at rationalOne, q with
    rationalOne.rational, assumption
  have gapPositive := rationalLess.sub_positive with qBelowOne
  have gapTimesCPositive := rationalLess.mul_positive with gapPositive, cPositive
  obtain ⟨epsilon, epsilonInQ, epsilonPositive, epsilonSmall⟩ := rationalLess.dense with
    rationalZero.rational, assumption, gapTimesCPositive
  have epsilonRational : Rational(epsilon) by exact epsilonInQ
  obtain ⟨p, pRational, pInA, shiftedOutside⟩ := DedekindCut.exists_boundary_within with cutA, epsilonPositive
  rw ← rationalAddValue.notation at shiftedOutside
  have shiftedRational := rationalAddValue.rational with pRational, epsilonRational
  have pInQ : p ∈ ℚ by simp [Rational]
  have shiftedInQ : p + epsilon ∈ ℚ by simp [Rational]
  have cDistinctShifted : c ≠ p + epsilon
    intro equal
    rw equal at cInA
    exact shiftedOutside with cInA
  have connected := rationalLess.connected_on
  have comparison := connected with
    c, cInQ, p + epsilon, shiftedInQ, cDistinctShifted
  have cBelowShifted : c < p + epsilon
    cases comparison with below | shiftedBelowC
    . exact below
    . have shiftedInA := DedekindCut.downward at A, p + epsilon, c with
        cutA, cInA, shiftedInQ, shiftedBelowC
      exfalso
      exact shiftedOutside with shiftedInA
  have gapBelowOne : rationalOne - q < rationalOne
    have translated := rationalLess.add_right at
      rationalZero, q, rationalOne - q with
        rationalZero.rational, assumption, gapRational, positiveQ
    have zeroPlusGap := rationalAddValue.zero_left with gapRational
    have gapCloses := rationalAddValue.add_sub_cancel_left at
      q, rationalOne with assumption, rationalOne.rational
    rwa [zeroPlusGap, gapCloses] at translated
  have gapCBelowC := rationalLess.mul_right with
    gapRational, rationalOne.rational, cRational, cPositive, gapBelowOne
  have oneTimesC := rationalMulValue.one_left with cRational
  rw oneTimesC at gapCBelowC
  have epsilonBelowC := rationalLess.transitive at
    epsilon, (rationalOne - q) * c, c with
      epsilonRational, assumption, cRational, epsilonSmall, gapCBelowC
  have cMinusEpsilonPositive := rationalLess.sub_positive with epsilonBelowC
  have shiftedCommutative := rationalAddValue.commutative with pRational, epsilonRational
  have cBelowEpsilonPlusP := cBelowShifted
  rw shiftedCommutative at cBelowEpsilonPlusP
  have cMinusEpsilonBelowP := rationalLess.sub_left with cBelowEpsilonPlusP
  have pPositive := rationalLess.transitive at
    rationalZero, c - epsilon, p with
      rationalZero.rational, assumption, pRational,
      cMinusEpsilonPositive, cMinusEpsilonBelowP
  have gapCBelowGapShifted := rationalLess.mul_left with
    cRational, shiftedRational, gapRational, gapPositive, cBelowShifted
  have epsilonBelowGapShifted := rationalLess.transitive with
    epsilonRational, *{2}, epsilonSmall, gapCBelowGapShifted
  have translatedProduct := rationalLess.add_left at
    epsilon, (rationalOne - q) * (p + epsilon), q * (p + epsilon) with
      epsilonRational, *{2}, epsilonBelowGapShifted
  have gapCloses := rationalAddValue.add_sub_cancel_left at
    q, rationalOne with assumption, rationalOne.rational
  have combinedProduct : q * (p + epsilon) +
      (rationalOne - q) * (p + epsilon) = p + epsilon
    have distributed := rationalMulValue.distributive_right at
      q, rationalOne - q, p + epsilon with
        assumption, gapRational, shiftedRational
    rw [← distributed, gapCloses]
    have oneTimesShifted := rationalMulValue.one_left with shiftedRational
    rw oneTimesShifted
    rfl
  rw combinedProduct at translatedProduct
  have productBelowP := rationalLess.of_add_right with translatedProduct
  witness p
  refine ⟨pInQ, pInA, pPositive, p + epsilon, shiftedInQ,
    shiftedOutside, _, productBelowP⟩
  exact rationalLess.transitive with
    rationalZero.rational, cRational, shiftedRational, cPositive, cBelowShifted

theorem rationalLess.exists_large_positive_multiplier (a : Rational)
  requires positive : rationalZero < a
  shows ∃ q ∈ ℚ, rationalZero < q ∧ rationalOne < q * a
proof
  obtain ⟨D, dNatural, dNonzero, unitPositive, unitBelowA⟩ := rationalLess.exists_positive_unit_fraction with
    positive
  have oneNonzero : 1 ≠ 0
    intro oneZero
    arith
  have qRational := rationalClass.rational at D, 0, 1 with oneNonzero
  have qPositivePlain : rationalZero < rationalClass(D, 0, 1)
    have dPositive := Less.add_positive at 0, D with dNonzero
    simp [add.left_unit] at dPositive
    unfold rationalZero
    apply rationalLess.classes.backward with oneNonzero, oneNonzero
    ring_nf
    exact dPositive
  have productShape : rationalMulValue(
      rationalClass(D, 0, 1), rationalClass(1, 0, D)) = rationalOne
    rw rationalMulValue.classes
    unfold rationalClassMul
    unfold rationalOne
    apply rationalClass.eq
    . exact mul.nonzero at 1, D with oneNonzero, dNonzero
    . exact oneNonzero
    . ring
  have unitRational := rationalClass.rational at 1, 0, D with dNonzero
  have scaled := rationalLess.mul_left at
    rationalClass(1, 0, D), a, rationalClass(D, 0, 1) with
      unitRational, assumption, qRational, qPositivePlain, unitBelowA
  rw [rationalMulValue.notation, productShape] at scaled
  witness rationalClass(D, 0, 1)
  refine ⟨_, qPositivePlain, scaled⟩
  exact qRational

theorem positiveRealInvCut.no_greatest (A : Set, q : Rational)
  requires cut : DedekindCut(A)
  requires member : q ∈ positiveRealInvCut(A)
  shows ∃ t ∈ positiveRealInvCut(A), q < t
proof
  obtain ⟨qInQ, condition⟩ := positiveRealInvCut.membership.forward with member
  cases condition with qNonpositive | witness
  . obtain ⟨r, rInQ, positiveR, outside⟩ :=
      DedekindCut.exists_positive_upper with cut
    have rRational : Rational(r) by exact rInQ
    obtain ⟨delta, deltaInQ, deltaPositive, deltaBelowOne, productSmall⟩ := rationalLess.exists_small_positive_multiplier with
      rRational, rationalOne.rational, positiveR, rationalZero.lt_one
    have deltaRational : Rational(delta) by exact deltaInQ
    have productCommutative := rationalMulValue.commutative with deltaRational, rRational
    rw [← productCommutative, rationalMulValue.notation] at productSmall
    obtain ⟨t, tInQ, zeroLessT, tLessDelta⟩ := rationalLess.dense with
      rationalZero.rational, deltaRational, deltaPositive
    have tRational : Rational(t) by exact tInQ
    have tMember := positiveRealInvCut.of_witness with
      tRational, deltaRational, rRational, tLessDelta, outside, positiveR, productSmall
    have distinct : q ≠ t
      intro equal
      rw ← equal at zeroLessT
      exact qNonpositive with zeroLessT
    have connected := rationalLess.connected_on
    have comparison := connected with q, qInQ, t, tInQ, distinct
    cases comparison with qLessT | tLessQ
    . refine ⟨t, tMember, qLessT⟩
    . have qPositive := rationalLess.transitive at rationalZero, t, q with
        rationalZero.rational, tRational, assumption, zeroLessT, tLessQ
      exfalso
      exact qNonpositive with qPositive
  . obtain ⟨s2, s2InQ, qLessS2, r2, r2InQ, outside2, positiveR2,
      productBelowOne2⟩ := witness
    have s2Rational : Rational(s2) by exact s2InQ
    have r2Rational : Rational(r2) by exact r2InQ
    obtain ⟨t2, t2InQ, qLessT2, tLessS2⟩ := rationalLess.dense at q, s2 with
      assumption, s2Rational, qLessS2
    have t2Rational : Rational(t2) by exact t2InQ
    have t2Member := positiveRealInvCut.of_witness with
      t2Rational, s2Rational, r2Rational, tLessS2, outside2, positiveR2, productBelowOne2
    refine ⟨t2, t2Member, qLessT2⟩

theorem positiveRealInvCut.proper (A : Real)
  requires positive : 0 < A
  shows positiveRealInvCut(A) ≠ ℚ
proof
  obtain ⟨zeroReal, realA, properA⟩ := realLess.characterization.forward with positive
  obtain ⟨a, aInA, aMissingZero⟩ := ProperSubset.missing with properA
  have cutA := Real.characterization.forward at A with assumption
  have subsetQ := DedekindCut.subset_rationals with cutA
  have aInQ := subsetQ with a, aInA
  have aRational : Rational(a) by exact aInQ
  obtain ⟨b, bInA, aLessB⟩ := DedekindCut.no_greatest with cutA, aInA
  have bInQ := subsetQ with b, bInA
  have bRational : Rational(b) by exact bInQ
  have bDistinctZero : b ≠ rationalZero
    intro equal
    have aLessZero := aLessB
    rw equal at aLessZero
    have aInZeroCut : a ∈ rationalCut(rationalZero) := rationalCut.membership.backward with ⟨aInQ, aLessZero⟩
    unfold realZero at aMissingZero
    exact aMissingZero with aInZeroCut
  have connected := rationalLess.connected_on
  have zeroInQ := rationalZero.rational
  have zeroDistinctB : rationalZero ≠ b
    intro equal
    apply bDistinctZero
    rw equal
    rfl
  have signB := connected with
    rationalZero, zeroInQ, b, bInQ,
    zeroDistinctB
  have positiveB : rationalZero < b
    cases signB with zeroLessB | bLessZero
    . exact zeroLessB
    . have aLessZero := rationalLess.transitive at a, b, rationalZero with
        aRational, bRational, rationalZero.rational, aLessB, bLessZero
      have aInZeroCut : a ∈ rationalCut(rationalZero) := rationalCut.membership.backward with ⟨aInQ, aLessZero⟩
      exfalso
      unfold realZero at aMissingZero
      exact aMissingZero with aInZeroCut
  obtain ⟨q, qInQ, positiveQ, oneBelowProduct⟩ := rationalLess.exists_large_positive_multiplier with
    bRational, positiveB
  rw rationalMulValue.notation at oneBelowProduct
  have qRational : Rational(q) by exact qInQ
  intro equalAll
  have qMember : q ∈ positiveRealInvCut(A) by rwa equalAll
  obtain ⟨qInQAgain, condition⟩ := positiveRealInvCut.membership.forward with qMember
  cases condition with qNonpositive | witness
  . exact qNonpositive with positiveQ
  . obtain ⟨s, sInQ, qLessS, r, rInQ, outside, positiveR,
      productBelowOne⟩ := witness
    have sRational : Rational(s) by exact sInQ
    have rRational : Rational(r) by exact rInQ
    have bDistinctR : b ≠ r
      intro equal
      rw ← equal at outside
      exact outside with bInA
    have comparison := connected with b, bInQ, r, rInQ, bDistinctR
    have bLessR : b < r
      cases comparison with below | rLessB
      . exact below
      . have rInA := DedekindCut.downward at A, r, b with
          cutA, bInA, rInQ, rLessB
        exfalso
        exact outside with rInA
    have qbLessQr := rationalLess.mul_left with positiveQ, bLessR
    have qrLessSr := rationalLess.mul_right with positiveR, qLessS
    rw [rationalMulValue.notation, rationalMulValue.notation] at qbLessQr
    rw [rationalMulValue.notation, rationalMulValue.notation] at qrLessSr
    have qbRational := rationalMulValue.rational_raw with qRational, bRational
    have qrRational := rationalMulValue.rational_raw with qRational, rRational
    have srRational := rationalMulValue.rational_raw with sRational, rRational
    have oneBelowQr := rationalLess.transitive with
      rationalOne.rational, qbRational, qrRational, oneBelowProduct, qbLessQr
    have oneBelowSr := rationalLess.transitive with
      rationalOne.rational, qrRational, srRational, oneBelowQr, qrLessSr
    have cycle := rationalLess.transitive with
      rationalOne.rational, srRational, rationalOne.rational, oneBelowSr, productBelowOne
    have irreflexive := rationalLess.irreflexive_on
    exact irreflexive with rationalOne, cycle

theorem positiveRealInvCut.cut (A : Real)
  requires positive : 0 < A
  shows DedekindCut(positiveRealInvCut(A))
proof
  have cutA := Real.characterization.forward with assumption
  constructor
  . exact positiveRealInvCut.subset_rationals at A
  constructor
  . exact positiveRealInvCut.nonempty at A
  constructor
  . exact positiveRealInvCut.proper with positive
  constructor
  . intros q qMember p pInQ pLessQ
    have qInQ := positiveRealInvCut.subset_rationals at A with q, qMember
    have qRational : Rational(q) by exact qInQ
    exact positiveRealInvCut.downward with qMember, pLessQ
  . intros q qMember
    have qInQ := positiveRealInvCut.subset_rationals at A with q, qMember
    exact positiveRealInvCut.no_greatest with cutA, qMember

theorem positiveRealInvCut.real (A : Real)
  requires positive : 0 < A
  shows Real(positiveRealInvCut(A))
proof
  apply Real.characterization.backward
  exact positiveRealInvCut.cut with positive

theorem positiveRealInvCut.positive (A : Real)
  requires positive : 0 < A
  shows realZero < positiveRealInvCut(A)
proof
  have inverseReal := positiveRealInvCut.real with positive
  have zeroSubset : realZero ⊆ positiveRealInvCut(A)
    intros q qInZero
    unfold realZero at qInZero
    obtain ⟨qInQ, qNegative⟩ := rationalCut.membership.forward with qInZero
    have qRational : Rational(q) by exact qInQ
    apply positiveRealInvCut.of_nonpositive with qRational
    intro qPositive
    have cycle := rationalLess.transitive with
      rationalZero.rational, qRational, rationalZero.rational, qPositive, qNegative
    have irreflexive := rationalLess.irreflexive_on
    exact irreflexive with rationalZero, cycle
  obtain ⟨t, tInInverse, zeroLessT⟩ :=
    positiveRealInvCut.no_greatest at A, rationalZero with
      Real.characterization.forward at A with assumption,
      positiveRealInvCut.zero_mem at A
  have tMissingZero : ¬(t ∈ realZero)
    intro tInZero
    unfold realZero at tInZero
    obtain ⟨tInQ, tNegative⟩ := rationalCut.membership.forward with tInZero
    have tRational : Rational(t) by exact tInQ
    have cycle := rationalLess.transitive with
      rationalZero.rational, tRational, rationalZero.rational, zeroLessT, tNegative
    have irreflexive := rationalLess.irreflexive_on
    exact irreflexive with rationalZero, cycle
  have unequal : realZero ≠ positiveRealInvCut(A)
    intro equal
    apply tMissingZero
    rwa equal
  apply realLess.characterization.backward
  unfold RealLess
  refine ⟨realZero.real, inverseReal, _⟩
  constructor
  . exact zeroSubset
  . exact unequal

theorem positiveRealInvCut.product_subset_one (A : Real)
  requires positive : 0 < A
  shows realPosMulCut(A, positiveRealInvCut(A)) ⊆ realOne
proof
  have cutA := Real.characterization.forward with assumption
  have subsetA := DedekindCut.subset_rationals with cutA
  intros q qInProduct
  obtain ⟨qInQ, condition⟩ := realPosMulCut.membership.forward with qInProduct
  have qRational : Rational(q) by exact qInQ
  unfold realOne
  apply rationalCut.membership.backward
  constructor
  . exact qInQ
  . cases condition with qNegative | product
    . exact rationalLess.transitive at q, rationalZero, rationalOne with
        qRational, rationalZero.rational, rationalOne.rational,
        qNegative, rationalZero.lt_one
    . obtain ⟨a, aInQ, aInA, b, bInQ, bInInverse,
        positiveA, positiveB, qLessProduct⟩ := product
      have aRational : Rational(a) by exact aInQ
      have bRational : Rational(b) by exact bInQ
      obtain ⟨bInQAgain, inverseCondition⟩ := positiveRealInvCut.membership.forward with bInInverse
      cases inverseCondition with bNonpositive | witness
      . exfalso
        exact bNonpositive with positiveB
      . obtain ⟨s, sInQ, bLessS, r, rInQ, outside, positiveR,
          productBelowOne⟩ := witness
        have sRational : Rational(s) by exact sInQ
        have rRational : Rational(r) by exact rInQ
        have distinct : a ≠ r
          intro equal
          rw ← equal at outside
          exact outside with aInA
        have connected := rationalLess.connected_on
        have comparison := connected with a, aInQ, r, rInQ, distinct
        have aLessR : a < r
          cases comparison with below | rLessA
          . exact below
          . have rInA := DedekindCut.downward at A, r, a with
              cutA, aInA, rInQ, rLessA
            exfalso
            exact outside with rInA
        have abLessRb := rationalLess.mul_right with positiveB, aLessR
        have rbLessRs := rationalLess.mul_left with positiveR, bLessS
        rw rationalMulValue.notation at qLessProduct
        rw [rationalMulValue.notation, rationalMulValue.notation] at abLessRb
        rw [rationalMulValue.notation, rationalMulValue.notation] at rbLessRs
        have abRational := rationalMulValue.rational_raw with aRational, bRational
        have rbRational := rationalMulValue.rational_raw with rRational, bRational
        have rsRational := rationalMulValue.rational_raw with rRational, sRational
        have qLessRb := rationalLess.transitive with qRational, abRational, rbRational, qLessProduct, abLessRb
        have qLessRs := rationalLess.transitive with qRational, rbRational, rsRational, qLessRb, rbLessRs
        have productCommutative := rationalMulValue.commutative with rRational, sRational
        rw [rationalMulValue.notation, rationalMulValue.notation] at productCommutative
        rw ← productCommutative at productBelowOne
        exact rationalLess.transitive with
          qRational, rsRational, rationalOne.rational, qLessRs, productBelowOne

theorem positiveRealInvCut.one_subset_product (A : Real)
  requires positive : 0 < A
  shows realOne ⊆ realPosMulCut(A, positiveRealInvCut(A))
proof
  have inverseReal := positiveRealInvCut.real with positive
  have inversePositive := positiveRealInvCut.positive with positive
  intros q qInOne
  unfold realOne at qInOne
  obtain ⟨qInQ, qBelowOne⟩ := rationalCut.membership.forward with qInOne
  apply realPosMulCut.membership.backward
  constructor
  . exact qInQ
  . by_contra noCondition
    have noNegative : ¬(q < rationalZero)
      intro qNegative
      apply noCondition
      left
      exact qNegative
    have noProduct : ¬(∃ a ∈ ℚ, a ∈ A ∧
        ∃ b ∈ ℚ, b ∈ positiveRealInvCut(A) ∧
          rationalZero < a ∧ rationalZero < b ∧ q < a * b)
      intro product
      apply noCondition
      right
      exact product
    have qPositive : rationalZero < q
      by_contra notPositive
      have qEqualZero : q = rationalZero
        by_contra qNotZero
        have qDistinctZero : q ≠ rationalZero by exact qNotZero
        have connected := rationalLess.connected_on
        have zeroInQ := rationalZero.rational
        have comparison := connected with
          q, qInQ, rationalZero, zeroInQ, qDistinctZero
        cases comparison with qBelowZero | zeroBelowQ
        . exact noNegative with qBelowZero
        . exact notPositive with zeroBelowQ
      obtain ⟨a0, a0InA, a0Positive⟩ := RealLess.exists_positive_member with positive
      obtain ⟨b0, b0InInverse, b0Positive⟩ := RealLess.exists_positive_member with
        inverseReal, inversePositive
      have cutA := Real.characterization.forward at A with assumption
      have cutInverse := Real.characterization.forward with inverseReal
      have subsetA := DedekindCut.subset_rationals with cutA
      have subsetInverse := DedekindCut.subset_rationals with cutInverse
      have a0InQ := subsetA with a0, a0InA
      have b0InQ := subsetInverse with b0, b0InInverse
      have productPositive := rationalLess.mul_positive with a0Positive, b0Positive
      rw ← qEqualZero at productPositive
      apply noProduct
      refine ⟨a0, a0InQ, a0InA, b0, b0InQ, b0InInverse,
        a0Positive, b0Positive, productPositive⟩
    obtain ⟨a, aInQ, aInA, aPositive, r, rInQ, rOutside, rPositive, qrBelowA⟩ := RealLess.exists_multiplicative_boundary with
      positive, qPositive, qBelowOne
    have rRational : Rational(r) by exact rInQ
    obtain ⟨b, bInQ, s, sInQ, bPositive, qBelowAB, bBelowS, srBelowOne⟩ := rationalLess.exists_reciprocal_interval with
      qPositive, aPositive, rPositive, qrBelowA
    have bRational : Rational(b) by exact bInQ
    have sRational : Rational(s) by exact sInQ
    rw rationalMulValue.notation at srBelowOne
    have bInInverse := positiveRealInvCut.of_witness with
      bRational, sRational, rRational, bBelowS, rOutside, rPositive, srBelowOne
    apply noProduct
    refine ⟨a, aInQ, aInA, b, bInQ, bInInverse,
      aPositive, bPositive, qBelowAB⟩

theorem positiveRealInvCut.product_eq_one (A : Real)
  requires positive : 0 < A
  shows realPosMulCut(A, positiveRealInvCut(A)) = realOne
proof
  apply Subset.antisymmetric
  . exact positiveRealInvCut.product_subset_one with positive
  . exact positiveRealInvCut.one_subset_product with positive

theorem positiveRealInvCut.mul_eq_one (A : Real)
  requires positive : 0 < A
  shows realMulValue(A, positiveRealInvCut(A)) = realOne
proof
  obtain ⟨zeroReal, realA, properA⟩ := realLess.characterization.forward with positive
  have nonnegativeA := ProperSubset.subset with properA
  have inversePositive := positiveRealInvCut.positive with positive
  obtain ⟨zeroRealAgain, inverseReal, properInverse⟩ := realLess.characterization.forward with inversePositive
  have nonnegativeInverse := ProperSubset.subset with properInverse
  have computed := realMulValue.cut at A, positiveRealInvCut(A) with
    assumption, inverseReal
  unfold call2 at computed
  have reduction := realMulCut.of_nonnegative at
    A, positiveRealInvCut(A) with
      assumption, inverseReal, nonnegativeA, nonnegativeInverse
  have productOne := positiveRealInvCut.product_eq_one with positive
  unfold realMulValue
  rfl
