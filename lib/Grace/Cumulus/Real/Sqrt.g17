module Grace.Cumulus.Real.Sqrt
import Squares
import Order

-- Section: Squares and order

theorem realMulValue.square_le_of_le (A B : Real)
  requires nonnegativeA : 0 ≤ A
  requires le : A ≤ B
  shows A * A ≤ B * B
proof
  have nonnegativeB : 0 ≤ B
    exact realLe.transitive with *
  have first := realLe.mul_right_of_nonnegative with le, nonnegativeA
  have second := realLe.mul_left_of_nonnegative with le, nonnegativeB
  exact realLe.transitive with *

theorem realMulValue.square_lt_of_lt (A B : Real)
  requires nonnegativeA : 0 ≤ A
  requires lt : A < B
  shows A * A < B * B
proof
  have positiveB : 0 < B
    exact realLe.transitive_less with *
  have le := realLess.implies_le at A, B with *
  have first := realLe.mul_right_of_nonnegative with le, nonnegativeA
  have second := realLess.mul_left_of_positive with lt, positiveB
  exact realLe.transitive_less with *

theorem realMulValue.le_of_square_le (A B : Real)
  requires nonnegativeA : 0 ≤ A
  requires nonnegativeB : 0 ≤ B
  requires squares : A * A ≤ B * B
  shows A ≤ B
proof
  have notLess : ¬(B < A)
    intro less
    have strict := realMulValue.square_lt_of_lt with nonnegativeB, less
    exact realLe.not_less with squares, strict
  exact realLe.of_not_less with *

theorem realMulValue.eq_of_square_eq (A B : Real)
  requires nonnegativeA : 0 ≤ A
  requires nonnegativeB : 0 ≤ B
  requires squares : A * A = B * B
  shows A = B
proof
  have le : A * A ≤ B * B
    rw squares
    exact realLe.reflexive with *
  have ge : B * B ≤ A * A
    rw squares
    exact realLe.reflexive with *
  have ab := realMulValue.le_of_square_le at A, B with *
  have ba := realMulValue.le_of_square_le at B, A with *
  exact realLe.antisymmetric with *

-- Section: Candidates below the square root

-- The nonnegative reals whose square does not exceed X.
def sqrtCandidates (X : Real) : Set :=
  { T ∈ ℝ | (0:R) ≤ (T:R) ∧ (T:R) * (T:R) ≤ X }

theorem sqrtCandidates.membership (T : Set) (X : Real)
  shows T ∈ sqrtCandidates(X) ↔ (T ∈ ℝ ∧ (0:R) ≤ (T:R) ∧ (T:R) * (T:R) ≤ X)
proof
  simp

theorem sqrtCandidates.subset_reals (X : Real)
  shows sqrtCandidates(X) ⊆ ℝ
proof
  intros T member
  obtain ⟨inReals, _, _⟩ := sqrtCandidates.membership.forward with member
  exact inReals

theorem sqrtCandidates.zero (X : Real)
  requires nonnegative : 0 ≤ X
  shows realZero ∈ sqrtCandidates(X)
proof
  have zeroIn : realZero ∈ ℝ by typecheck
  have zeroLe := realLe.reflexive with realZero.real
  have square := realMulValue.zero_left with realZero.real
  have squareLe : realZero * realZero ≤ X by rwa square
  have conjunction : realZero ∈ ℝ ∧ 0 ≤ realZero ∧ realZero * realZero ≤ X by refine ⟨zeroIn, zeroLe, squareLe⟩
  exact sqrtCandidates.membership.backward with conjunction

theorem sqrtCandidates.nonempty (X : Real)
  requires nonnegative : 0 ≤ X
  shows Nonempty(sqrtCandidates(X))
proof
  witness realZero
  exact sqrtCandidates.zero with *

-- Every candidate is at most X + 1: a larger T would satisfy T < T * T.
theorem sqrtCandidates.bounded (X : Real)
  requires nonnegative : 0 ≤ X
  shows RealUpperBound(sqrtCandidates(X), X + 1)
proof
  have boundReal : Real(X + 1) by typecheck
  have subset := sqrtCandidates.subset_reals at X
  unfold RealUpperBound
  refine ⟨boundReal, subset, _⟩
  intros T member
  obtain ⟨inReals, nonnegativeT, squareLe⟩ := sqrtCandidates.membership.forward with member
  have realT : Real(T) by exact inReals
  have notLess : ¬(X + 1 < T)
    intro less
    have one := realZero.lt_one
    have oneLess : 1 < T by linarith
    have positiveT : 0 < T by linarith
    have grow : T * 1 < T * T
      exact realLess.mul_left_of_positive with *
    have unit := realMulValue.one_right with realT
    rw unit at grow
    linarith
  have le := realLe.of_not_less with *
  exact realLe.subset with le

-- Section: Existence

-- The supremum of the candidates squares to X: if its square fell short, a
-- slightly larger candidate would exist; if it exceeded X, a slightly smaller
-- upper bound would.
theorem realSqrt.existence (X : Real)
  requires nonnegative : 0 ≤ X
  shows ∃ T ∈ ℝ, (0:R) ≤ (T:R) ∧ (T:R) * (T:R) = X
proof
  have inhabited := sqrtCandidates.nonempty with *
  have bounded : ∃ B, RealUpperBound(sqrtCandidates(X), B) := ⟨X + 1, sqrtCandidates.bounded at X with *⟩
  obtain ⟨U, least⟩ := Real.least_upper_bound_property with inhabited, bounded
  have upper : RealUpperBound(sqrtCandidates(X), U)
    rcases least with ⟨bound, _⟩
    exact bound
  have minimal : ∀ B, RealUpperBound(sqrtCandidates(X), B) → U ⊆ B
    rcases least with ⟨_, minimal⟩
    exact minimal
  rcases upper with ⟨realU, subsetReals, bounds⟩
  have zeroMember := sqrtCandidates.zero with *
  have zeroSubset := bounds with realZero, zeroMember
  have nonnegativeU : 0 ≤ U by exact realLe.of_subset at realZero, U with realZero.real, realU, zeroSubset
  have uIn : U ∈ ℝ by typecheck
  have compare : U * U = X ∨ U * U ≠ X by tauto
  cases compare with equal | different
  . witness U
    refine ⟨uIn, nonnegativeU, equal⟩
  . have connected := realLess.connected_on
    have order := connected with U * U, X, different
    have one := realZero.lt_one
    cases order with below | above
    . -- The square falls short: U + E is a larger candidate, for a small E.
      exfalso
      have positiveD : 0 < X - U * U by linarith
      have positiveW : 0 < U + U + 1 + (X - U * U) by linarith
      have nonzeroW : U + U + 1 + (X - U * U) ≠ 0
        intro zeroW
        rw zeroW at positiveW
        linarith
      have positiveE : 0 < (X - U * U) / (U + U + 1 + (X - U * U))
        have unfolded := realDiv.eq_mul_inv at X - U * U, U + U + 1 + (X - U * U) with *
        rw unfolded
        have positiveInverse := realInvValue.positive at U + U + 1 + (X - U * U) with *
        exact realMulValue.positive with *
      have cancel := realDiv.mul_right at X - U * U, U + U + 1 + (X - U * U) with *
      have eLessOne : (X - U * U) / (U + U + 1 + (X - U * U)) < 1
        have notLess : ¬(1 ≤ (X - U * U) / (U + U + 1 + (X - U * U)))
          intro oneLe
          have nonnegativeW := realLess.implies_le at realZero, U + U + 1 + (X - U * U) with *
          have scaled := realLe.mul_right_of_nonnegative with oneLe, nonnegativeW
          have oneLeft := realMulValue.one_left at U + U + 1 + (X - U * U)
          rw [oneLeft, cancel] at scaled
          linarith
        exact realLess.of_not_le with *
      have eLeOne := realLess.implies_le at (X - U * U) / (U + U + 1 + (X - U * U)), realOne with *
      have nonnegativeE := realLess.implies_le at realZero, (X - U * U) / (U + U + 1 + (X - U * U)) with *
      have squareLeE : ((X - U * U) / (U + U + 1 + (X - U * U))) * ((X - U * U) / (U + U + 1 + (X - U * U))) ≤ (X - U * U) / (U + U + 1 + (X - U * U))
        have step := realLe.mul_left_of_nonnegative at (X - U * U) / (U + U + 1 + (X - U * U)), realOne, (X - U * U) / (U + U + 1 + (X - U * U)) with *
        have unit := realMulValue.one_right at (X - U * U) / (U + U + 1 + (X - U * U))
        rwa unit at step
      have twoUOneLessW : U + U + 1 < U + U + 1 + (X - U * U) by linarith
      have scaledLess := realLess.mul_left_of_positive at U + U + 1, U + U + 1 + (X - U * U), (X - U * U) / (U + U + 1 + (X - U * U)) with *
      rw cancel at scaledLess
      have expansion : (U + (X - U * U) / (U + U + 1 + (X - U * U))) * (U + (X - U * U) / (U + U + 1 + (X - U * U))) =
          U * U + ((U + U) * ((X - U * U) / (U + U + 1 + (X - U * U))) + ((X - U * U) / (U + U + 1 + (X - U * U))) * ((X - U * U) / (U + U + 1 + (X - U * U))))
        ring
      have regroup : (U + U) * ((X - U * U) / (U + U + 1 + (X - U * U))) + (X - U * U) / (U + U + 1 + (X - U * U)) = ((X - U * U) / (U + U + 1 + (X - U * U))) * (U + U + 1)
        ring
      have squareLe : (U + (X - U * U) / (U + U + 1 + (X - U * U))) * (U + (X - U * U) / (U + U + 1 + (X - U * U))) ≤ X
        linarith
      have nonnegativeSum : 0 ≤ U + (X - U * U) / (U + U + 1 + (X - U * U)) by linarith
      have sumIn : U + (X - U * U) / (U + U + 1 + (X - U * U)) ∈ ℝ by typecheck
      have conjunction : U + (X - U * U) / (U + U + 1 + (X - U * U)) ∈ ℝ ∧ (0:R) ≤ U + (X - U * U) / (U + U + 1 + (X - U * U)) ∧ (U + (X - U * U) / (U + U + 1 + (X - U * U))) * (U + (X - U * U) / (U + U + 1 + (X - U * U))) ≤ X
        refine ⟨sumIn, nonnegativeSum, squareLe⟩
      have sumMember := sqrtCandidates.membership.backward with conjunction
      have sumSubset := bounds with U + (X - U * U) / (U + U + 1 + (X - U * U)), sumMember
      have sumLe := realLe.of_subset at U + (X - U * U) / (U + U + 1 + (X - U * U)), U with *
      linarith
    . -- The square exceeds X: U - E is a smaller upper bound, for a small E.
      exfalso
      have nonzeroU : U ≠ 0
        intro uZero
        rw uZero at above
        have zeroSquare := realMulValue.zero_left with realZero.real
        rw zeroSquare at above
        linarith
      have positiveU := Real.positive_of_nonnegative_of_ne_zero with realU, nonnegativeU, nonzeroU
      have positiveD : 0 < U * U - X by linarith
      have positiveTwoU : 0 < U + U by linarith
      have nonzeroTwoU : U + U ≠ 0
        intro zeroTwoU
        rw zeroTwoU at positiveTwoU
        linarith
      have positiveE : 0 < (U * U - X) / (U + U)
        have unfolded := realDiv.eq_mul_inv at U * U - X, U + U with *
        rw unfolded
        have positiveInverse := realInvValue.positive at U + U with *
        exact realMulValue.positive with *
      have cancel := realDiv.mul_right at U * U - X, U + U with *
      have eLessU : (U * U - X) / (U + U) < U
        have notLe : ¬(U ≤ (U * U - X) / (U + U))
          intro uLe
          have nonnegativeTwoU := realLess.implies_le at realZero, U + U with *
          have scaled := realLe.mul_right_of_nonnegative at U, (U * U - X) / (U + U), U + U with *
          rw cancel at scaled
          have doubled : U * (U + U) = U * U + U * U by ring
          have positiveSquare := realMulValue.square_positive with realU, nonzeroU
          linarith
        exact realLess.of_not_le with *
      have positiveV : 0 < U - (U * U - X) / (U + U) by linarith
      have nonnegativeV := realLess.implies_le at realZero, U - (U * U - X) / (U + U) with *
      have expansion : (U - (U * U - X) / (U + U)) * (U - (U * U - X) / (U + U)) =
          U * U - ((U * U - X) / (U + U)) * (U + U) + ((U * U - X) / (U + U)) * ((U * U - X) / (U + U))
        ring
      rw cancel at expansion
      have nonnegativeSquare := realMulValue.square_nonnegative at (U * U - X) / (U + U)
      have xLeSquare : X ≤ (U - (U * U - X) / (U + U)) * (U - (U * U - X) / (U + U)) by linarith
      have realV : Real(U - (U * U - X) / (U + U)) by typecheck
      have upperV : RealUpperBound(sqrtCandidates(X), U - (U * U - X) / (U + U))
        unfold RealUpperBound
        refine ⟨realV, subsetReals, _⟩
        intros T member
        obtain ⟨inReals, nonnegativeT, squareLe⟩ := sqrtCandidates.membership.forward with member
        have squares : T * T ≤ (U - (U * U - X) / (U + U)) * (U - (U * U - X) / (U + U)) by linarith
        have le := realMulValue.le_of_square_le with *
        exact realLe.subset with le
      have uSubset := minimal with U - (U * U - X) / (U + U), upperV
      have uLe := realLe.of_subset at U, U - (U * U - X) / (U + U) with *
      linarith

-- Section: The square root

-- Nonnegative reals as a soft type, so that sqrt has a real result.
predicate NonnegativeReal (X : Set) := Real(X) ∧ (0:R) ≤ (X:R)

theorem NonnegativeReal.real (X : NonnegativeReal)
  shows Real(X)
proof
  have nonnegative : NonnegativeReal(X) by assumption
  rcases nonnegative with ⟨realX, _⟩
  exact realX

theorem NonnegativeReal.le (X : NonnegativeReal)
  shows 0 ≤ X
proof
  have nonnegative : NonnegativeReal(X) by assumption
  rcases nonnegative with ⟨_, le⟩
  exact le

theorem NonnegativeReal.of_le (X : Real)
  requires nonnegative : 0 ≤ X
  shows NonnegativeReal(X)
proof
  have realX : Real(X) by typecheck
  unfold NonnegativeReal
  refine ⟨realX, nonnegative⟩

theorem realZero.nonnegative_real
  shows NonnegativeReal(realZero)
proof
  have le := realLe.reflexive with realZero.real
  exact NonnegativeReal.of_le with realZero.real, le

theorem realMulValue.square_nonnegative_real (T : Real)
  shows NonnegativeReal(T * T)
proof
  have le := realMulValue.square_nonnegative at T
  exact NonnegativeReal.of_le with *

theorem NonnegativeReal.mul (X Y : NonnegativeReal)
  shows NonnegativeReal(X * Y)
proof
  have leX := NonnegativeReal.le at X
  have leY := NonnegativeReal.le at Y
  have le := realMulValue.nonnegative at X, Y with *
  exact NonnegativeReal.of_le with *

theorem NonnegativeReal.add (X Y : NonnegativeReal)
  shows NonnegativeReal(X + Y)
proof
  have leX := NonnegativeReal.le at X
  have leY := NonnegativeReal.le at Y
  have step := realLe.add at realZero, X, realZero, Y with *
  have zeroZero := realAddValue.zero_right with realZero.real
  rw zeroZero at step
  exact NonnegativeReal.of_le with *

defunique realSqrt (X : Real) (T ∈ ℝ) := (0:R) ≤ (T:R) ∧ (T:R) * (T:R) = X
requires nonnegative : 0 ≤ X
proof
  exact realSqrt.existence with *
uniqueness
  intros T tMember first S sMember second
  rcases first with ⟨nonnegativeT, squareT⟩
  rcases second with ⟨nonnegativeS, squareS⟩
  have squares : T * T = S * S
    rw [squareT, squareS]
    rfl
  exact realMulValue.eq_of_square_eq with *

def sqrt (X : NonnegativeReal) : Real := realSqrt(X)
proof
  have le := NonnegativeReal.le at X with assumption
  have realX := NonnegativeReal.real at X with assumption
  have selected := realSqrt.selected at X with realX, le
  rcases selected with ⟨member, _⟩
  unfold sqrt
  unfold Real
  exact member

notation prefix 90 "√" => sqrt for Real


theorem sqrt.real (X : NonnegativeReal)
  shows Real(√X)
proof
  typecheck

theorem sqrt.nonnegative (X : NonnegativeReal)
  shows 0 ≤ √X
proof
  have le := NonnegativeReal.le with assumption
  have realX := NonnegativeReal.real with assumption
  obtain ⟨_, nonnegative, _⟩ := realSqrt.selected with le
  unfold sqrt
  exact nonnegative

theorem sqrt.square (X : NonnegativeReal)
  shows √X * √X = X
proof
  have le := NonnegativeReal.le with assumption
  obtain ⟨_, _, square⟩ := realSqrt.selected with le
  unfold sqrt
  cc

theorem sqrt.unique (X : NonnegativeReal) (T : Real)
  requires nonnegative : 0 ≤ T
  requires square : T * T = X
  shows T = √X
proof
  have rootNonnegative := sqrt.nonnegative at X
  have rootSquare := sqrt.square at X
  have squares : T * T = √X * √X
    rw [square, rootSquare]
    rfl
  exact realMulValue.eq_of_square_eq with *

theorem sqrt.of_square (T : Real)
  requires nonnegative : 0 ≤ T
  shows √(T * T) = T
proof
  have squareNonnegative := realMulValue.square_nonnegative_real at T
  have reflexiveSquare : T * T = T * T by rfl
  have unique := sqrt.unique with squareNonnegative, nonnegative, reflexiveSquare
  cc

theorem sqrt.zero
  shows √realZero = realZero
proof
  have zeroNonnegative := realZero.nonnegative_real
  have le := realLe.reflexive with realZero.real
  have square := realMulValue.zero_left with realZero.real
  have unique := sqrt.unique with *
  cc

theorem sqrt.mul (X Y : NonnegativeReal)
  shows √(X * Y) = √X * √Y
proof
  have productNonnegative := NonnegativeReal.mul at X, Y with *
  have rootX := sqrt.nonnegative at X
  have rootY := sqrt.nonnegative at Y
  have squareX := sqrt.square at X
  have squareY := sqrt.square at Y
  have productRoots := realMulValue.nonnegative at √X, √Y with *
  have identity : (√X * √Y) * (√X * √Y) = (√X * √X) * (√Y * √Y) by ring
  rw [squareX, squareY] at identity
  have unique := sqrt.unique with *
  cc

theorem sqrt.le_of_le (X Y : Real)
  requires nonnegativeX : NonnegativeReal(X)
  requires nonnegativeY : NonnegativeReal(Y)
  requires le : X ≤ Y
  shows √X ≤ √Y
proof
  have rootX := sqrt.nonnegative with nonnegativeX
  have rootY := sqrt.nonnegative with nonnegativeY
  have squareX := sqrt.square with nonnegativeX
  have squareY := sqrt.square with nonnegativeY
  have squares : √X * √X ≤ √Y * √Y by rwa [squareX, squareY]
  exact realMulValue.le_of_square_le with *

theorem sqrt.positive (X : NonnegativeReal)
  requires nonzero : X ≠ 0
  shows 0 < √X
proof
  have rootNonnegative := sqrt.nonnegative at X
  have square := sqrt.square with assumption
  have rootNonzero : √X ≠ 0
    intro zero
    apply nonzero
    rw zero at square
    have zeroSquare := realMulValue.zero_left with realZero.real
    rw zeroSquare at square
    cc
  exact Real.positive_of_nonnegative_of_ne_zero with *
