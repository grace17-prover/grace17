-- Authors: Grant Passmore

module Grace.Cumulus.Real.MeanInequality
import Sqrt
import Metric

-- The square of the mean exceeds the product by the square of half the
-- difference, so the product is at most the square of the mean.
theorem realMulValue.le_square_of_mean (a b : Real)
  shows a * b ≤ half(a + b) * half(a + b)
proof
  have doubled := half.add_self at a + b with *
  have square := realMulValue.square_nonnegative_real at a - b with *
  have squareNonnegative := NonnegativeReal.le with square
  have expansion : (a + b) * (a + b) = a * b + a * b + a * b + a * b + (a - b) * (a - b) by ring
  have meanExpansion : (half(a + b) + half(a + b)) * (half(a + b) + half(a + b)) = half(a + b) * half(a + b) + half(a + b) * half(a + b) + half(a + b) * half(a + b) + half(a + b) * half(a + b)
    ring
  rw doubled at meanExpansion
  linarith

-- Arithmetic mean and geometric mean: √(ab) ≤ (a + b)/2 for nonnegative a, b.
theorem sqrt.le_mean (a b : Real)
  requires nonnegativeA : 0 ≤ a
  requires nonnegativeB : 0 ≤ b
  shows √(a * b) ≤ (a + b) / 2
proof
  have aNonnegative := NonnegativeReal.of_le at a with *
  have bNonnegative := NonnegativeReal.of_le at b with *
  have product := NonnegativeReal.mul at a, b with *
  have doubled := half.add_self at a + b with *
  have meanNonnegative : 0 ≤ half(a + b) by linarith
  have meanSquare := realMulValue.square_nonnegative_real at half(a + b) with *
  have bound := realMulValue.le_square_of_mean at a, b with *
  have roots := sqrt.le_of_le at a * b, half(a + b) * half(a + b) with *
  have rootOfSquare := sqrt.of_square at half(a + b) with *
  rw rootOfSquare at roots
  have asQuotient := realDiv.of_double_eq with *
  rwa ← asQuotient
