module Grace.Cumulus.Algebra.OrderedField.Core
import Defs

theorem IsOrderedField.field (A add zero neg mul one inv lt : Set)
  requires h : IsOrderedField(A, add, zero, neg, mul, one, inv, lt)
  shows IsFieldWithInverse(A, add, zero, neg, mul, one, inv)
proof
  simp [IsOrderedField]

theorem IsOrderedField.strict_linear_order (A add zero neg mul one inv lt : Set)
  requires h : IsOrderedField(A, add, zero, neg, mul, one, inv, lt)
  shows StrictLinearOrder(A, lt)
proof
  simp [IsOrderedField]

theorem IsOrderedField.add_strict_mono (A add zero neg mul one inv lt : Set)
  requires h : IsOrderedField(A, add, zero, neg, mul, one, inv, lt)
  shows AddStrictMono(A, add, lt)
proof
  simp [IsOrderedField]

theorem IsOrderedField.mul_positive (A add zero neg mul one inv lt : Set)
  requires h : IsOrderedField(A, add, zero, neg, mul, one, inv, lt)
  shows MulPositive(A, mul, zero, lt)
proof
  simp [IsOrderedField]

theorem IsOrderedField.comm_ring (A add zero neg mul one inv lt : Set)
  requires h : IsOrderedField(A, add, zero, neg, mul, one, inv, lt)
  shows IsCommRing(A, add, zero, neg, mul, one)
proof
  have field := IsOrderedField.field with h
  exact IsFieldWithInverse.comm_ring with field

theorem IsOrderedField.order (A add zero neg mul one inv lt : Set)
  requires h : IsOrderedField(A, add, zero, neg, mul, one, inv, lt)
  shows StrictOrder(A, lt)
proof
  have linear := IsOrderedField.strict_linear_order with h
  exact StrictLinearOrder.strict with linear

theorem IsOrderedField.connected (A add zero neg mul one inv lt : Set)
  requires h : IsOrderedField(A, add, zero, neg, mul, one, inv, lt)
  shows ConnectedOn(A, lt)
proof
  have linear := IsOrderedField.strict_linear_order with h
  exact StrictLinearOrder.connected with linear

theorem IsOrderedField.nontrivial (A add zero neg mul one inv lt : Set)
  requires h : IsOrderedField(A, add, zero, neg, mul, one, inv, lt)
  shows Nontrivial(A, zero, one)
proof
  have field := IsOrderedField.field with h
  exact IsFieldWithInverse.nontrivial with field

theorem IsOrderedField.add_right (A add zero neg mul one inv lt x y z : Set)
  requires h : IsOrderedField(A, add, zero, neg, mul, one, inv, lt)
  requires hx : x ∈ A
  requires hy : y ∈ A
  requires hz : z ∈ A
  requires hxy : relates(lt, x, y)
  shows relates(lt, call2(add, x, z), call2(add, y, z))
proof
  exact IsOrderedField.add_strict_mono with h, x, hx, y, hy, z, hz, hxy

theorem IsOrderedField.add_left (A add zero neg mul one inv lt x y z : Set)
  requires field : IsOrderedField(A, add, zero, neg, mul, one, inv, lt)
  requires xInA : x ∈ A
  requires yInA : y ∈ A
  requires zInA : z ∈ A
  requires less : relates(lt, x, y)
  shows relates(lt, call2(add, z, x), call2(add, z, y))
proof
  have translated := IsOrderedField.add_right with field, xInA, yInA, zInA, less
  have ring := IsOrderedField.comm_ring with field
  have commutative := IsCommRing.add_commutative with ring
  have left := commutative with x, xInA, z, zInA
  have right := commutative with y, yInA, z, zInA
  rwa [left, right] at translated

theorem IsOrderedField.add (A add zero neg mul one inv lt x y z w : Set)
  requires field : IsOrderedField(A, add, zero, neg, mul, one, inv, lt)
  requires xInA : x ∈ A
  requires yInA : y ∈ A
  requires zInA : z ∈ A
  requires wInA : w ∈ A
  requires xy : relates(lt, x, y)
  requires zw : relates(lt, z, w)
  shows relates(lt, call2(add, x, z), call2(add, y, w))
proof
  have commRing := IsOrderedField.comm_ring with field
  have ring := IsCommRing.ring with commRing
  have xzInA := IsRing.add_closed with ring, xInA, zInA
  have yzInA := IsRing.add_closed with ring, yInA, zInA
  have ywInA := IsRing.add_closed with ring, yInA, wInA
  have first := IsOrderedField.add_right with field, xInA, yInA, zInA, xy
  have second := IsOrderedField.add_left with field, zInA, wInA, yInA, zw
  have order := IsOrderedField.order with field
  have transitive := StrictOrder.transitive with order
  exact transitive with
    call2(add, x, z), xzInA,
    call2(add, y, z), yzInA,
    call2(add, y, w), ywInA, first, second

theorem IsOrderedField.transitive (A add zero neg mul one inv lt x y z : Set)
  requires field : IsOrderedField(A, add, zero, neg, mul, one, inv, lt)
  requires xInA : x ∈ A
  requires yInA : y ∈ A
  requires zInA : z ∈ A
  requires xy : relates(lt, x, y)
  requires yz : relates(lt, y, z)
  shows relates(lt, x, z)
proof
  have order := IsOrderedField.order with field
  have transitive := StrictOrder.transitive with order
  exact transitive with x, xInA, y, yInA, z, zInA, xy, yz

theorem IsOrderedField.irreflexive (A add zero neg mul one inv lt x : Set)
  requires field : IsOrderedField(A, add, zero, neg, mul, one, inv, lt)
  requires xInA : x ∈ A
  shows ¬relates(lt, x, x)
proof
  have order := IsOrderedField.order with field
  have irreflexive := StrictOrder.irreflexive with order
  exact irreflexive with x, xInA

theorem IsOrderedField.add_right_iff (A add zero neg mul one inv lt x y z : Set)
  requires field : IsOrderedField(A, add, zero, neg, mul, one, inv, lt)
  requires xInA : x ∈ A
  requires yInA : y ∈ A
  requires zInA : z ∈ A
  shows relates(lt, call2(add, x, z), call2(add, y, z)) ↔
    relates(lt, x, y)
proof
  have commRing := IsOrderedField.comm_ring with field
  have ring := IsCommRing.ring with commRing
  have negZInA := IsRing.neg_closed with ring, zInA
  have xzInA := IsRing.add_closed with ring, xInA, zInA
  have yzInA := IsRing.add_closed with ring, yInA, zInA
  have associative := IsRing.add_associative with ring
  have inverseZ := IsRing.add_inverse_right with ring, zInA
  have identityX := IsRing.add_right_identity with ring, xInA
  have identityY := IsRing.add_right_identity with ring, yInA
  constructor
  . intro translated
    have cancelled := IsOrderedField.add_right with field, xzInA, yzInA, negZInA, translated
    have associateX := Associative.law with associative, xInA, zInA, negZInA
    have associateY := Associative.law with associative, yInA, zInA, negZInA
    rwa [associateX, associateY, inverseZ, identityX, identityY] at cancelled
  . intro less
    exact IsOrderedField.add_right with field, xInA, yInA, zInA, less

theorem IsOrderedField.add_left_iff (A add zero neg mul one inv lt x y z : Set)
  requires field : IsOrderedField(A, add, zero, neg, mul, one, inv, lt)
  requires xInA : x ∈ A
  requires yInA : y ∈ A
  requires zInA : z ∈ A
  shows relates(lt, call2(add, z, x), call2(add, z, y)) ↔
    relates(lt, x, y)
proof
  have ring := IsOrderedField.comm_ring with field
  have commutative := IsCommRing.add_commutative with ring
  have left := commutative with z, zInA, x, xInA
  have right := commutative with z, zInA, y, yInA
  rw [left, right]
  exact IsOrderedField.add_right_iff with field, xInA, yInA, zInA

theorem IsOrderedField.positive_sum (A add zero neg mul one inv lt x y : Set)
  requires field : IsOrderedField(A, add, zero, neg, mul, one, inv, lt)
  requires xInA : x ∈ A
  requires yInA : y ∈ A
  requires positiveX : relates(lt, zero, x)
  requires positiveY : relates(lt, zero, y)
  shows relates(lt, zero, call2(add, x, y))
proof
  have commRing := IsOrderedField.comm_ring with field
  have ring := IsCommRing.ring with commRing
  have zeroInA := IsRing.zero_in_carrier with ring
  have sumInA := IsRing.add_closed with ring, xInA, yInA
  have xLessSum := IsOrderedField.add_left with field, zeroInA, yInA, xInA, positiveY
  have identityX := IsRing.add_right_identity with ring, xInA
  rw identityX at xLessSum
  exact IsOrderedField.transitive with field, zeroInA, xInA, sumInA, positiveX, xLessSum

theorem IsOrderedField.ne_of_less (A add zero neg mul one inv lt x y : Set)
  requires field : IsOrderedField(A, add, zero, neg, mul, one, inv, lt)
  requires xInA : x ∈ A
  requires yInA : y ∈ A
  requires less : relates(lt, x, y)
  shows x ≠ y
proof
  intro equal
  rw equal at less
  exact IsOrderedField.irreflexive with field, yInA, less

theorem IsOrderedField.positive_neg_of_negative (A add zero neg mul one inv lt x : Set)
  requires field : IsOrderedField(A, add, zero, neg, mul, one, inv, lt)
  requires xInA : x ∈ A
  requires negative : relates(lt, x, zero)
  shows relates(lt, zero, neg(x))
proof
  have commRing := IsOrderedField.comm_ring with field
  have ring := IsCommRing.ring with commRing
  have zeroInA := IsRing.zero_in_carrier with ring
  have negXInA := IsRing.neg_closed with ring, xInA
  have translated := IsOrderedField.add_right with field, xInA, zeroInA, negXInA, negative
  have inverse := IsRing.add_inverse_right with ring, xInA
  have identity := IsRing.add_left_identity with ring, negXInA
  rwa [inverse, identity] at translated

theorem IsOrderedField.negative_neg_of_positive (A add zero neg mul one inv lt x : Set)
  requires field : IsOrderedField(A, add, zero, neg, mul, one, inv, lt)
  requires xInA : x ∈ A
  requires positive : relates(lt, zero, x)
  shows relates(lt, neg(x), zero)
proof
  have commRing := IsOrderedField.comm_ring with field
  have ring := IsCommRing.ring with commRing
  have zeroInA := IsRing.zero_in_carrier with ring
  have negXInA := IsRing.neg_closed with ring, xInA
  have translated := IsOrderedField.add_right with field, zeroInA, xInA, negXInA, positive
  have identity := IsRing.add_left_identity with ring, negXInA
  have inverse := IsRing.add_inverse_right with ring, xInA
  rwa [identity, inverse] at translated

theorem IsOrderedField.neg_reverses (A add zero neg mul one inv lt x y : Set)
  requires field : IsOrderedField(A, add, zero, neg, mul, one, inv, lt)
  requires xInA : x ∈ A
  requires yInA : y ∈ A
  requires less : relates(lt, x, y)
  shows relates(lt, neg(y), neg(x))
proof
  have commRing := IsOrderedField.comm_ring with field
  have ring := IsCommRing.ring with commRing
  have zeroInA := IsRing.zero_in_carrier with ring
  have negXInA := IsRing.neg_closed with ring, xInA
  have negYInA := IsRing.neg_closed with ring, yInA
  have differencePositive := IsOrderedField.add_right with field, xInA, yInA, negXInA, less
  have inverseX := IsRing.add_inverse_right with ring, xInA
  rw inverseX at differencePositive
  have commutative := IsCommRing.add_commutative with commRing
  have differenceCommutes := commutative with y, yInA, neg(x), negXInA
  rw differenceCommutes at differencePositive
  have inverseY := IsRing.add_inverse_left with ring, yInA
  have translated : relates(lt,
      call2(add, neg(y), y),
      call2(add, neg(x), y))
    rwa inverseY
  have cancellation := IsOrderedField.add_right_iff with field, negYInA, negXInA, yInA
  exact cancellation.forward with translated

theorem IsOrderedField.sign_cases (A add zero neg mul one inv lt x : Set)
  requires field : IsOrderedField(A, add, zero, neg, mul, one, inv, lt)
  requires xInA : x ∈ A
  shows x = zero ∨ relates(lt, x, zero) ∨ relates(lt, zero, x)
proof
  have commRing := IsOrderedField.comm_ring with field
  have ring := IsCommRing.ring with commRing
  have zeroInA := IsRing.zero_in_carrier with ring
  have equalityCases : x = zero ∨ x ≠ zero by tauto
  cases equalityCases with equal | unequal
  . left
    exact equal
  . have connected := IsOrderedField.connected at
      A, add, zero, neg, mul, one, inv, lt with field
    have signs := connected with x, xInA, zero, zeroInA, unequal
    cases signs with negative | positive
    . right
      left
      exact negative
    . right
      right
      exact positive

theorem LessEqualBy.reflexive (A lt x : Set)
  requires xInA : x ∈ A
  shows LessEqualBy(A, lt, x, x)
proof
  unfold LessEqualBy
  refine ⟨xInA, xInA, _⟩
  left
  rfl

theorem LessEqualBy.of_less (A lt x y : Set)
  requires xInA : x ∈ A
  requires yInA : y ∈ A
  requires less : relates(lt, x, y)
  shows LessEqualBy(A, lt, x, y)
proof
  unfold LessEqualBy
  refine ⟨xInA, yInA, _⟩
  right
  exact less

theorem LessEqualBy.transitive (A add zero neg mul one inv lt x y z : Set)
  requires field : IsOrderedField(A, add, zero, neg, mul, one, inv, lt)
  requires xy : LessEqualBy(A, lt, x, y)
  requires yz : LessEqualBy(A, lt, y, z)
  shows LessEqualBy(A, lt, x, z)
proof
  rcases xy with ⟨xInA, yInA, xyOrder⟩
  rcases yz with ⟨yInAAgain, zInA, yzOrder⟩
  unfold LessEqualBy
  refine ⟨xInA, zInA, _⟩
  cases xyOrder with equalXY | lessXY
  . rw equalXY
    exact yzOrder
  . cases yzOrder with equalYZ | lessYZ
    . rw ← equalYZ
      right
      exact lessXY
    . right
      exact IsOrderedField.transitive with field, xInA, yInA, zInA, lessXY,
        lessYZ

theorem LessEqualBy.add (A add zero neg mul one inv lt x y z w : Set)
  requires field : IsOrderedField(A, add, zero, neg, mul, one, inv, lt)
  requires xy : LessEqualBy(A, lt, x, y)
  requires zw : LessEqualBy(A, lt, z, w)
  shows LessEqualBy(A, lt, call2(add, x, z), call2(add, y, w))
proof
  rcases xy with ⟨xInA, yInA, xyOrder⟩
  rcases zw with ⟨zInA, wInA, zwOrder⟩
  have commRing := IsOrderedField.comm_ring with field
  have ring := IsCommRing.ring with commRing
  have xzInA := IsRing.add_closed with ring, xInA, zInA
  have ywInA := IsRing.add_closed with ring, yInA, wInA
  unfold LessEqualBy
  refine ⟨xzInA, ywInA, _⟩
  cases xyOrder with equalXY | lessXY
  . cases zwOrder with equalZW | lessZW
    . left
      cc
    . right
      rw equalXY
      exact IsOrderedField.add_left with field, zInA, wInA, yInA, lessZW
  . cases zwOrder with equalZW | lessZW
    . right
      rw equalZW
      exact IsOrderedField.add_right with field, xInA, yInA, wInA, lessXY
    . right
      have yzInA := IsRing.add_closed with ring, yInA, zInA
      have first := IsOrderedField.add_right with field, xInA, yInA, zInA,
        lessXY
      have second := IsOrderedField.add_left with field, zInA, wInA, yInA,
        lessZW
      exact IsOrderedField.transitive with field, xzInA, yzInA, ywInA, first, second

theorem AbsoluteValue.function (A zero neg lt abs : Set)
  requires absolute : AbsoluteValue(A, zero, neg, lt, abs)
  shows abs : A → A
proof
  rcases absolute with ⟨function, atZero, branches⟩
  exact function

theorem AbsoluteValue.closed (A zero neg lt abs x : Set)
  requires absolute : AbsoluteValue(A, zero, neg, lt, abs)
  requires xInA : x ∈ A
  shows abs(x) ∈ A
proof
  have function := AbsoluteValue.function with absolute
  exact FunctionBetween.apply_closed with function, xInA

theorem AbsoluteValue.zero (A zero neg lt abs : Set)
  requires absolute : AbsoluteValue(A, zero, neg, lt, abs)
  shows abs(zero) = zero
proof
  rcases absolute with ⟨function, atZero, branches⟩
  exact atZero

theorem AbsoluteValue.of_positive (A zero neg lt abs x : Set)
  requires absolute : AbsoluteValue(A, zero, neg, lt, abs)
  requires xInA : x ∈ A
  requires positive : relates(lt, zero, x)
  shows abs(x) = x
proof
  rcases absolute with ⟨function, atZero, branches⟩
  obtain ⟨positiveBranch, negativeBranch⟩ := branches with x, xInA
  exact positiveBranch with positive

theorem AbsoluteValue.of_negative (A zero neg lt abs x : Set)
  requires absolute : AbsoluteValue(A, zero, neg, lt, abs)
  requires xInA : x ∈ A
  requires negative : relates(lt, x, zero)
  shows abs(x) = neg(x)
proof
  rcases absolute with ⟨function, atZero, branches⟩
  obtain ⟨positiveBranch, negativeBranch⟩ := branches with x, xInA
  exact negativeBranch with negative

theorem AbsoluteValue.nonnegative (A add zero neg mul one inv lt abs x : Set)
  requires field : IsOrderedField(A, add, zero, neg, mul, one, inv, lt)
  requires absolute : AbsoluteValue(A, zero, neg, lt, abs)
  requires xInA : x ∈ A
  shows LessEqualBy(A, lt, zero, abs(x))
proof
  have commRing := IsOrderedField.comm_ring with field
  have ring := IsCommRing.ring with commRing
  have zeroInA := IsRing.zero_in_carrier with ring
  have absoluteInA := AbsoluteValue.closed with absolute, xInA
  unfold LessEqualBy
  refine ⟨zeroInA, absoluteInA, _⟩
  have signs := IsOrderedField.sign_cases with field, xInA
  cases signs with equal | nonzero
  . left
    have atZero := AbsoluteValue.zero with absolute
    cc
  . cases nonzero with negative | positive
    . right
      have positiveNeg := IsOrderedField.positive_neg_of_negative with field, xInA, negative
      have shape := AbsoluteValue.of_negative with absolute, xInA, negative
      rwa shape
    . right
      have shape := AbsoluteValue.of_positive with absolute, xInA, positive
      rwa shape

theorem AbsoluteValue.positive_of_ne (A add zero neg mul one inv lt abs x : Set)
  requires field : IsOrderedField(A, add, zero, neg, mul, one, inv, lt)
  requires absolute : AbsoluteValue(A, zero, neg, lt, abs)
  requires xInA : x ∈ A
  requires nonzero : x ≠ zero
  shows relates(lt, zero, abs(x))
proof
  have signs := IsOrderedField.sign_cases with field, xInA
  cases signs with equal | nonzeroSign
  . exfalso
    exact nonzero with equal
  . cases nonzeroSign with negative | positive
    . have positiveNeg := IsOrderedField.positive_neg_of_negative at
        A, add, zero, neg, mul, one, inv, lt, x with
          field, xInA, negative
      have shape := AbsoluteValue.of_negative with absolute, xInA, negative
      rwa shape
    . have shape := AbsoluteValue.of_positive at
        A, zero, neg, lt, abs, x with absolute, xInA, positive
      rwa shape

theorem AbsoluteValue.eq_zero_iff (A add zero neg mul one inv lt abs x : Set)
  requires field : IsOrderedField(A, add, zero, neg, mul, one, inv, lt)
  requires absolute : AbsoluteValue(A, zero, neg, lt, abs)
  requires xInA : x ∈ A
  shows abs(x) = zero ↔ x = zero
proof
  have commRing := IsOrderedField.comm_ring with field
  have ring := IsCommRing.ring with commRing
  have zeroInA := IsRing.zero_in_carrier with ring
  constructor
  . intro absoluteZero
    have signs := IsOrderedField.sign_cases with field, xInA
    cases signs with equal | nonzero
    . exact equal
    . cases nonzero with negative | positive
      . have shape := AbsoluteValue.of_negative at
          A, zero, neg, lt, abs, x with absolute, xInA, negative
        have negXInA := IsRing.neg_closed with ring, xInA
        have positiveNeg := IsOrderedField.positive_neg_of_negative with field, xInA, negative
        rw shape at absoluteZero
        rw absoluteZero at positiveNeg
        exfalso
        exact IsOrderedField.irreflexive with field, zeroInA, positiveNeg
      . have shape := AbsoluteValue.of_positive at
          A, zero, neg, lt, abs, x with absolute, xInA, positive
        rwa shape at absoluteZero
  . intro equal
    rw equal
    exact AbsoluteValue.zero with absolute

theorem AbsoluteValue.upper (A add zero neg mul one inv lt abs x : Set)
  requires field : IsOrderedField(A, add, zero, neg, mul, one, inv, lt)
  requires absolute : AbsoluteValue(A, zero, neg, lt, abs)
  requires xInA : x ∈ A
  shows LessEqualBy(A, lt, x, abs(x))
proof
  have commRing := IsOrderedField.comm_ring with field
  have ring := IsCommRing.ring with commRing
  have zeroInA := IsRing.zero_in_carrier with ring
  have absoluteInA := AbsoluteValue.closed with absolute, xInA
  unfold LessEqualBy
  refine ⟨xInA, absoluteInA, _⟩
  have signs := IsOrderedField.sign_cases with field, xInA
  cases signs with equal | nonzero
  . left
    have atZero := AbsoluteValue.zero with absolute
    cc
  . cases nonzero with negative | positive
    . right
      have positiveNeg := IsOrderedField.positive_neg_of_negative with field, xInA, negative
      have negXInA := IsRing.neg_closed with ring, xInA
      have strict := IsOrderedField.transitive with field, xInA, zeroInA, negXInA, negative, positiveNeg
      have shape := AbsoluteValue.of_negative with absolute, xInA, negative
      rwa shape
    . left
      have shape := AbsoluteValue.of_positive with absolute, xInA, positive
      cc

theorem AbsoluteValue.upper_neg (A add zero neg mul one inv lt abs x : Set)
  requires field : IsOrderedField(A, add, zero, neg, mul, one, inv, lt)
  requires absolute : AbsoluteValue(A, zero, neg, lt, abs)
  requires xInA : x ∈ A
  shows LessEqualBy(A, lt, neg(x), abs(x))
proof
  have commRing := IsOrderedField.comm_ring with field
  have ring := IsCommRing.ring with commRing
  have additive := IsRing.additive with ring
  have group := IsAbelianGroup.group with additive
  have zeroInA := IsRing.zero_in_carrier with ring
  have negXInA := IsRing.neg_closed with ring, xInA
  have absoluteInA := AbsoluteValue.closed with absolute, xInA
  unfold LessEqualBy
  refine ⟨negXInA, absoluteInA, _⟩
  have signs := IsOrderedField.sign_cases with field, xInA
  cases signs with equal | nonzero
  . left
    have negZero := IsGroup.inverse_unit with group
    have atZero := AbsoluteValue.zero with absolute
    cc
  . cases nonzero with negative | positive
    . left
      have shape := AbsoluteValue.of_negative with absolute, xInA, negative
      cc
    . right
      have negativeNeg := IsOrderedField.negative_neg_of_positive with field, xInA, positive
      have strict := IsOrderedField.transitive with field, negXInA, zeroInA, xInA, negativeNeg, positive
      have shape := AbsoluteValue.of_positive with absolute, xInA, positive
      rwa shape

theorem AbsoluteValue.neg (A add zero neg mul one inv lt abs x : Set)
  requires field : IsOrderedField(A, add, zero, neg, mul, one, inv, lt)
  requires absolute : AbsoluteValue(A, zero, neg, lt, abs)
  requires xInA : x ∈ A
  shows abs(neg(x)) = abs(x)
proof
  have commRing := IsOrderedField.comm_ring with field
  have ring := IsCommRing.ring with commRing
  have additive := IsRing.additive with ring
  have group := IsAbelianGroup.group with additive
  have negXInA := IsRing.neg_closed with ring, xInA
  have involutive := IsGroup.inverse_involutive with group, xInA
  have signs := IsOrderedField.sign_cases with field, xInA
  cases signs with equal | nonzero
  . have negZero := IsGroup.inverse_unit with group
    have atZero := AbsoluteValue.zero with absolute
    cc
  . cases nonzero with negative | positive
    . have positiveNeg := IsOrderedField.positive_neg_of_negative at
        A, add, zero, neg, mul, one, inv, lt, x with
          field, xInA, negative
      have left := AbsoluteValue.of_positive with absolute, negXInA, positiveNeg
      have right := AbsoluteValue.of_negative with absolute, xInA, negative
      cc
    . have negativeNeg := IsOrderedField.negative_neg_of_positive at
        A, add, zero, neg, mul, one, inv, lt, x with
          field, xInA, positive
      have left := AbsoluteValue.of_negative with absolute, negXInA, negativeNeg
      have right := AbsoluteValue.of_positive with absolute, xInA, positive
      cc

-- Absolute value is multiplicative in every ordered field.  Splitting on
-- the signs of the factors leaves only the positive-product law and the
-- familiar sign rules for multiplication.
theorem AbsoluteValue.mul (A add zero neg mul one inv lt abs x y : Set)
  requires field : IsOrderedField(A, add, zero, neg, mul, one, inv, lt)
  requires absolute : AbsoluteValue(A, zero, neg, lt, abs)
  requires xInA : x ∈ A
  requires yInA : y ∈ A
  shows abs(call2(mul, x, y)) =
    call2(mul, abs(x), abs(y))
proof
  have commRing := IsOrderedField.comm_ring with field
  have ring := IsCommRing.ring with commRing
  have positiveMul := IsOrderedField.mul_positive with field
  have productInA := IsRing.mul_closed with ring, xInA, yInA
  have absXInA := AbsoluteValue.closed with absolute, xInA
  have absYInA := AbsoluteValue.closed with absolute, yInA
  have signsX := IsOrderedField.sign_cases with field, xInA
  cases signsX with xZero | xNonzero
  . have zeroProduct := IsRing.zero_mul at
      A, add, zero, neg, mul, one, y with ring, yInA
    have zeroTimesAbs := IsRing.zero_mul with ring, absYInA
    have absZero := AbsoluteValue.zero with absolute
    rw xZero
    cc
  . cases xNonzero with xNegative | xPositive
    . have negXInA := IsRing.neg_closed at
        A, add, zero, neg, mul, one, x with ring, xInA
      have negXPositive := IsOrderedField.positive_neg_of_negative with field, xInA, xNegative
      have absX := AbsoluteValue.of_negative with absolute, xInA, xNegative
      have signsY := IsOrderedField.sign_cases with field, yInA
      cases signsY with yZero | yNonzero
      . have productZero := IsRing.mul_zero at
          A, add, zero, neg, mul, one, x with ring, xInA
        have absTimesZero := IsRing.mul_zero with ring, absXInA
        have absZero := AbsoluteValue.zero with absolute
        rw yZero
        cc
      . cases yNonzero with yNegative | yPositive
        . have negYInA := IsRing.neg_closed at
            A, add, zero, neg, mul, one, y with ring, yInA
          have negYPositive := IsOrderedField.positive_neg_of_negative with field, yInA, yNegative
          have positiveProduct := positiveMul with
            neg(x), negXInA, neg(y), negYInA,
            negXPositive, negYPositive
          have signsCancel := IsCommRing.neg_mul_neg with commRing, xInA, yInA
          rw signsCancel at positiveProduct
          have absProduct := AbsoluteValue.of_positive with absolute, productInA, positiveProduct
          have absY := AbsoluteValue.of_negative with absolute, yInA, yNegative
          cc
        . have positiveProduct := positiveMul with
            neg(x), negXInA, y, yInA, negXPositive, yPositive
          have negProduct := IsRing.neg_mul with ring, xInA, yInA
          have absNegProduct := AbsoluteValue.neg with field, absolute, productInA
          have positiveProductInA := IsRing.mul_closed with ring, negXInA, yInA
          have absPositiveProduct := AbsoluteValue.of_positive with
            absolute, positiveProductInA, positiveProduct
          have absY := AbsoluteValue.of_positive with absolute, yInA, yPositive
          cc
    . have absX := AbsoluteValue.of_positive at
        A, zero, neg, lt, abs, x with absolute, xInA, xPositive
      have signsY := IsOrderedField.sign_cases with field, yInA
      cases signsY with yZero | yNonzero
      . have productZero := IsRing.mul_zero at
          A, add, zero, neg, mul, one, x with ring, xInA
        have xTimesZero := IsRing.mul_zero with ring, xInA
        have absZero := AbsoluteValue.zero with absolute
        rw yZero
        cc
      . cases yNonzero with yNegative | yPositive
        . have negYInA := IsRing.neg_closed at
            A, add, zero, neg, mul, one, y with ring, yInA
          have negYPositive := IsOrderedField.positive_neg_of_negative with field, yInA, yNegative
          have positiveProduct := positiveMul with
            x, xInA, neg(y), negYInA, xPositive, negYPositive
          have negProduct := IsCommRing.mul_neg with commRing, xInA, yInA
          have absNegProduct := AbsoluteValue.neg with field, absolute, productInA
          have positiveProductInA := IsRing.mul_closed with ring, xInA, negYInA
          have absPositiveProduct := AbsoluteValue.of_positive with
            absolute, positiveProductInA, positiveProduct
          have absY := AbsoluteValue.of_negative with absolute, yInA, yNegative
          cc
        . have positiveProduct := positiveMul with
            x, xInA, y, yInA, xPositive, yPositive
          have absProduct := AbsoluteValue.of_positive with absolute, productInA, positiveProduct
          have absY := AbsoluteValue.of_positive with absolute, yInA, yPositive
          cc

theorem AbsoluteValue.triangle (A add zero neg mul one inv lt abs x y : Set)
  requires field : IsOrderedField(A, add, zero, neg, mul, one, inv, lt)
  requires absolute : AbsoluteValue(A, zero, neg, lt, abs)
  requires xInA : x ∈ A
  requires yInA : y ∈ A
  shows LessEqualBy(A, lt,
    abs(call2(add, x, y)),
    call2(add, abs(x), abs(y)))
proof
  have commRing := IsOrderedField.comm_ring with field
  have ring := IsCommRing.ring with commRing
  have additive := IsRing.additive with ring
  have group := IsAbelianGroup.group with additive
  have sumInA := IsRing.add_closed with ring, xInA, yInA
  have upperX := AbsoluteValue.upper with field, absolute, xInA
  have upperY := AbsoluteValue.upper with field, absolute, yInA
  have sumUpper := LessEqualBy.add with field, upperX, upperY
  have upperNegX := AbsoluteValue.upper_neg with field, absolute, xInA
  have upperNegY := AbsoluteValue.upper_neg with field, absolute, yInA
  have negSumUpper := LessEqualBy.add with field, upperNegX, upperNegY
  have negSum := IsAbelianGroup.inverse_op with additive, xInA, yInA
  rw ← negSum at negSumUpper
  have signs := IsOrderedField.sign_cases with field, sumInA
  cases signs with equal | nonzero
  . have shape := AbsoluteValue.zero with absolute
    rw equal at sumUpper
    rwa [equal, shape]
  . cases nonzero with negative | positive
    . have shape := AbsoluteValue.of_negative at
        A, zero, neg, lt, abs, call2(add, x, y) with
          absolute, sumInA, negative
      rwa shape
    . have shape := AbsoluteValue.of_positive at
        A, zero, neg, lt, abs, call2(add, x, y) with
          absolute, sumInA, positive
      rwa shape

theorem IsOrderedField.positive_one (A add zero neg mul one inv lt : Set)
  requires field : IsOrderedField(A, add, zero, neg, mul, one, inv, lt)
  shows relates(lt, zero, one)
proof
  have ordinaryField := IsOrderedField.field with field
  have commRing := IsOrderedField.comm_ring with field
  have ring := IsCommRing.ring with commRing
  have zeroInA := IsRing.zero_in_carrier with ring
  have oneInA := IsFieldWithInverse.one_in_carrier with ordinaryField
  have nontrivial := IsOrderedField.nontrivial with field
  have distinct := Nontrivial.distinct with nontrivial
  have signs := IsOrderedField.sign_cases with field, oneInA
  cases signs with equal | nonzero
  . exfalso
    apply distinct
    cc
  . cases nonzero with negative | positive
    . have negOneInA := IsRing.neg_closed at
        A, add, zero, neg, mul, one, one with ring, oneInA
      have positiveNegOne := IsOrderedField.positive_neg_of_negative with field, oneInA, negative
      have positiveMul := IsOrderedField.mul_positive with field
      have positiveSquare := positiveMul with
        neg(one), negOneInA, neg(one), negOneInA,
        positiveNegOne, positiveNegOne
      have square := IsCommRing.neg_mul_neg with commRing, oneInA, oneInA
      have monoid := IsRing.multiplicative with ring
      have oneMulOne := IsMonoid.left_identity with monoid, oneInA
      rwa [square, oneMulOne] at positiveSquare
    . exact positive

theorem IsOrderedField.positive_inverse (A add zero neg mul one inv lt x : Set)
  requires field : IsOrderedField(A, add, zero, neg, mul, one, inv, lt)
  requires xInA : x ∈ A
  requires positive : relates(lt, zero, x)
  shows relates(lt, zero, inv(x))
proof
  have ordinaryField := IsOrderedField.field with field
  have commRing := IsOrderedField.comm_ring with field
  have ring := IsCommRing.ring with commRing
  have zeroInA := IsRing.zero_in_carrier with ring
  have oneInA := IsFieldWithInverse.one_in_carrier with ordinaryField
  have inverseInA := IsFieldWithInverse.inverse_closed with ordinaryField, xInA
  have zeroNeX := IsOrderedField.ne_of_less with field, zeroInA, xInA, positive
  have nonzero : x ≠ zero
    intro equal
    apply zeroNeX
    cc
  have product := IsFieldWithInverse.inverse_right with ordinaryField, xInA,
    nonzero
  have signs := IsOrderedField.sign_cases with field, inverseInA
  cases signs with equal | nonzeroSign
  . have zeroProduct := IsRing.mul_zero at
      A, add, zero, neg, mul, one, x with ring, xInA
    have nontrivial := IsOrderedField.nontrivial with field
    have distinct := Nontrivial.distinct with nontrivial
    exfalso
    apply distinct
    cc
  . cases nonzeroSign with negative | inversePositive
    . have negInverseInA := IsRing.neg_closed at
        A, add, zero, neg, mul, one, inv(x) with ring, inverseInA
      have positiveNegInverse := IsOrderedField.positive_neg_of_negative with field, inverseInA, negative
      have positiveMul := IsOrderedField.mul_positive with field
      have positiveNegativeOne := positiveMul with
        x, xInA, neg(inv(x)), negInverseInA,
        positive, positiveNegInverse
      have negProduct := IsCommRing.mul_neg with commRing, xInA, inverseInA
      have onePositive := IsOrderedField.positive_one with field
      have negativeNegativeOne := IsOrderedField.negative_neg_of_positive with field, oneInA, onePositive
      rw [negProduct, product] at positiveNegativeOne
      have negOneInA := IsRing.neg_closed with ring, oneInA
      have cycle := IsOrderedField.transitive with
        field, negOneInA, zeroInA, negOneInA, negativeNegativeOne, positiveNegativeOne
      exfalso
      exact IsOrderedField.irreflexive with field, negOneInA, cycle
    . exact inversePositive

theorem IsOrderedField.half_closed (A add zero neg mul one inv lt x : Set)
  requires field : IsOrderedField(A, add, zero, neg, mul, one, inv, lt)
  requires xInA : x ∈ A
  shows fieldHalf(add, mul, one, inv, x) ∈ A
proof
  have ordinaryField := IsOrderedField.field with field
  have commRing := IsOrderedField.comm_ring with field
  have ring := IsCommRing.ring with commRing
  have oneInA := IsFieldWithInverse.one_in_carrier with ordinaryField
  have twoInA := IsRing.add_closed with ring, oneInA, oneInA
  have inverseTwoInA := IsFieldWithInverse.inverse_closed with ordinaryField,
    twoInA
  unfold fieldHalf
  exact IsRing.mul_closed with ring, inverseTwoInA, xInA

theorem IsOrderedField.half_positive (A add zero neg mul one inv lt x : Set)
  requires field : IsOrderedField(A, add, zero, neg, mul, one, inv, lt)
  requires xInA : x ∈ A
  requires positive : relates(lt, zero, x)
  shows relates(lt, zero, fieldHalf(add, mul, one, inv, x))
proof
  have ordinaryField := IsOrderedField.field with field
  have commRing := IsOrderedField.comm_ring with field
  have ring := IsCommRing.ring with commRing
  have oneInA := IsFieldWithInverse.one_in_carrier with ordinaryField
  have onePositive := IsOrderedField.positive_one with field
  have twoInA := IsRing.add_closed with ring, oneInA, oneInA
  have twoPositive := IsOrderedField.positive_sum with field, oneInA, oneInA, onePositive, onePositive
  have inverseTwoInA := IsFieldWithInverse.inverse_closed with ordinaryField,
    twoInA
  have inverseTwoPositive := IsOrderedField.positive_inverse with field, twoInA, twoPositive
  have positiveMul := IsOrderedField.mul_positive with field
  unfold fieldHalf
  exact positiveMul with
    inv(call2(add, one, one)), inverseTwoInA, x, xInA,
    inverseTwoPositive, positive

theorem IsOrderedField.half_add_self (A add zero neg mul one inv lt x : Set)
  requires field : IsOrderedField(A, add, zero, neg, mul, one, inv, lt)
  requires xInA : x ∈ A
  shows call2(add,
    fieldHalf(add, mul, one, inv, x),
    fieldHalf(add, mul, one, inv, x)) = x
proof
  have ordinaryField := IsOrderedField.field with field
  have commRing := IsOrderedField.comm_ring with field
  have ring := IsCommRing.ring with commRing
  have monoid := IsRing.multiplicative with ring
  have oneInA := IsFieldWithInverse.one_in_carrier with ordinaryField
  have twoInA := IsRing.add_closed with ring, oneInA, oneInA
  have onePositive := IsOrderedField.positive_one with field
  have twoPositive := IsOrderedField.positive_sum with field, oneInA, oneInA, onePositive, onePositive
  have zeroInA := IsRing.zero_in_carrier with ring
  have zeroNeTwo := IsOrderedField.ne_of_less with field, zeroInA, twoInA, twoPositive
  have twoNonzero : call2(add, one, one) ≠ zero
    intro equal
    apply zeroNeTwo
    cc
  have inverseTwoInA := IsFieldWithInverse.inverse_closed with ordinaryField,
    twoInA
  have inverseTwo := IsFieldWithInverse.inverse_right with ordinaryField,
    twoInA, twoNonzero
  have halfInA := IsOrderedField.half_closed with field, xInA
  have distributive := IsRing.distributive with ring
  have laws := distributive with one, oneInA, one, oneInA,
    fieldHalf(add, mul, one, inv, x), halfInA
  rcases laws with ⟨leftLaw, twoTimesHalf⟩
  have oneTimesHalf := IsMonoid.left_identity with monoid, halfInA
  rw oneTimesHalf at twoTimesHalf
  unfold fieldHalf at twoTimesHalf
  have associative := IsMonoid.associative with monoid
  have reassociate := Associative.law with associative, twoInA, inverseTwoInA, xInA
  have oneTimesX := IsMonoid.left_identity with monoid, xInA
  unfold fieldHalf
  cc

theorem IsOrderedField.positive_product (A add zero neg mul one inv lt x y : Set)
  requires h : IsOrderedField(A, add, zero, neg, mul, one, inv, lt)
  requires hx : x ∈ A
  requires hy : y ∈ A
  requires positiveX : relates(lt, zero, x)
  requires positiveY : relates(lt, zero, y)
  shows relates(lt, zero, call2(mul, x, y))
proof
  have positive := IsOrderedField.mul_positive with h
  exact positive with x, hx, y, hy, positiveX, positiveY
