-- The order of a finite group against its elements: the order of an
-- element divides the order of the group and is at most it, and the order
-- of the group annihilates every element
-- Part of Cumulus, the Grace17 mathematics library.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module Grace.Cumulus.Algebra.Group.GroupOrder
import ElementOrder

section GroupOrder
variable (G : Set)
hypothesis group : Group(G)

theorem elementOrder.divides_order (g : G)
  requires finite : Finite(G)
  shows elementOrder(G, g) ∣ order(G)
proof
  rw order.value
  exact elementOrder.dvd_card with *

theorem elementOrder.le_order (g : G)
  requires finite : Finite(G)
  shows elementOrder(G, g) ≤ order(G)
proof
  rw order.value
  exact elementOrder.le_card with *

theorem pow_order_eq_one (g : G)
  requires finite : Finite(G)
  shows g ^ order(G) = G.one
proof
  rw order.value
  exact Group.pow_card with *

end GroupOrder
