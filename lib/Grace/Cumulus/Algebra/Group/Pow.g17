-- Authors: Grant Passmore

module Grace.Cumulus.Algebra.Group.Pow
import Subgroup
import Power

-- The n-th power of x in G, the monoid power under the operation and unit
-- of G; written x ^ n wherever a hypothesis supplies the group.
def groupPow (G x : Set, n : Nat) : Set := monoidPow(G.mul, G.one, x, n)

notation infixr 80 "^" => groupPow(G, _, _) via hypothesis Group(G) for G.carrier
notation infixr 80 "^" => groupPow(G, _, _) via hypothesis AbelianGroup(G) for G.carrier
notation infixr 80 "^" => groupPow(G, _, _) via hypothesis Subgroup(H, G) for H

theorem groupPow.value (G x : Set, n : Nat)
  shows groupPow(G, x, n) = monoidPow(G.mul, G.one, x, n)
proof
  simp [groupPow]

section PowerLaws
variable (G : Set)
hypothesis group : Group(G)

theorem pow_zero (x : G)
  shows x ^ 0 = G.one
proof
  simp [groupPow, monoidPow.zero]

theorem pow_succ_left (x : G) (n : Nat)
  shows x ^ (n + 1) = x * x ^ n
proof
  have monoid := IsGroup.monoid with (Group.parts with group)
  have step := monoidPow.succ_left at G.carrier, G.mul, G.one, x, n with monoid, *
  simp [groupPow, step]

theorem pow_succ (x : G) (n : Nat)
  shows x ^ (n + 1) = x ^ n * x
proof
  have monoid := IsGroup.monoid with (Group.parts with group)
  have step := monoidPow.succ_right at G.carrier, G.mul, G.one, x, n with monoid, *
  simp [groupPow, step]

theorem pow_one (x : G)
  shows x ^ 1 = x
proof
  have monoid := IsGroup.monoid with (Group.parts with group)
  have one := monoidPow.one with monoid, *
  simp [groupPow, one]

instance Group.pow_mem (x : G) (n : Nat)
  shows x ^ n ∈ G
proof
  have monoid := IsGroup.monoid with (Group.parts with group)
  have closed := monoidPow.closed at G.carrier, G.mul, G.one, x, n with monoid, *
  simp [groupPow, closed]

theorem pow_add (x : G) (m n : Nat)
  shows x ^ (m + n) = x ^ m * x ^ n
proof
  have monoid := IsGroup.monoid with (Group.parts with group)
  have split := monoidPow.add at G.carrier, G.mul, G.one, x, m, n with monoid, *
  simp [groupPow, split]

theorem pow_mul (x : G) (m n : Nat)
  shows x ^ (m * n) = (x ^ m) ^ n
proof
  have monoid := IsGroup.monoid with (Group.parts with group)
  have split := monoidPow.mul at G.carrier, G.mul, G.one, x, m, n with monoid, *
  simp [groupPow, split]

theorem one_pow (n : Nat)
  shows G.one ^ n = G.one
proof
  have monoid := IsGroup.monoid with (Group.parts with group)
  have power := monoidPow.unit at G.carrier, G.mul, G.one, n with monoid
  simp [groupPow, power]

theorem pow_mul_comm (x : G) (m n : Nat)
  shows x ^ m * x ^ n = x ^ n * x ^ m
proof
  have monoid := IsGroup.monoid with (Group.parts with group)
  have swap := monoidPow.add_commute at G.carrier, G.mul, G.one, x, m, n with monoid, *
  simp [groupPow, swap]

theorem pow_mul_self_comm (x : G) (n : Nat)
  shows x * x ^ n = x ^ n * x
proof
  have monoid := IsGroup.monoid with (Group.parts with group)
  have swap := monoidPow.commute at G.carrier, G.mul, G.one, x, n with monoid, *
  simp [groupPow, swap]

theorem inv_pow (x : G) (n : Nat)
  shows x⁻¹ ^ n = (x ^ n)⁻¹
proof
  induction n
  | zero =>
    rw [pow_zero, pow_zero, inv_one]
    rfl
  | succ(k) using ih =>
    have step : x⁻¹ ^ (k + 1) = x⁻¹ ^ k * x⁻¹ := pow_succ with *
    have stepX : x ^ (k + 1) = x * x ^ k := pow_succ_left with *
    rw [← add.right_one, step, stepX, ih, mul_inv_rev]
    rfl

-- The power that completes a vanishing product is the inverse power.
theorem pow_eq_inv_pow_of_pow_add (x : G) (m n : Nat)
  requires vanishes : x ^ (m + n) = G.one
  shows x ^ n = (x ^ m)⁻¹
proof
  have split : x ^ (m + n) = x ^ m * x ^ n := pow_add with *
  have product : x ^ m * x ^ n = G.one by cc
  exact eq_inv_of_mul_eq_one_right with *

end PowerLaws

section SubgroupPowers
variable (G H : Set)
hypothesis subgroup : Subgroup(H, G)

instance Subgroup.pow_mem (h : H) (n : Nat)
  shows h ^ n ∈ H
proof
  have group := Subgroup.group with subgroup
  induction n
  | zero =>
    have zero : h ^ 0 = G.one := pow_zero with *
    rw zero
    exact Subgroup.one_mem with *
  | succ(k) using ih =>
    have step : h ^ (k + 1) = h ^ k * h := pow_succ with *
    rw [← add.right_one, step]
    exact Subgroup.mul_mem with *

end SubgroupPowers
