-- The direct product of two groups on the product of their carriers,
-- with the componentwise operation: it is a group, abelian when both
-- factors are, the projections are surjective homomorphisms, and each
-- factor embeds as a normal subgroup
-- Part of Cumulus, the Grace17 mathematics library.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module Grace.Cumulus.Algebra.Group.Product
import Normal
import Set.Function.Projection

-- The componentwise operation as a function graph on (A × B) × (A × B).
def productOp (A op B op2 : Set) : Set :=
  { q ∈ ((A × B) × (A × B)) × (A × B) |
    ∃ a ∈ A, ∃ b ∈ B, ∃ c ∈ A, ∃ d ∈ B,
      q = (((a, b), (c, d)) ↦ (op(a, c), op2(b, d))) }

-- The componentwise inverse as a function graph on A × B.
def productInv (A inv B inv2 : Set) : Set :=
  { q ∈ (A × B) × (A × B) | ∃ a ∈ A, ∃ b ∈ B, q = ((a, b) ↦ (inv(a), inv2(b))) }

-- The direct product of two bundled groups.
def productGroup (G H : Set) : Set :=
  Group.mk(G.carrier × H.carrier, productOp(G.carrier, G.mul, H.carrier, H.mul),
    (G.one, H.one), productInv(G.carrier, G.inv, H.carrier, H.inv))

theorem productGroup.carrierOf (G H : Set)
  shows Group.carrier(productGroup(G, H)) = G.carrier × H.carrier
proof
  simp [productGroup, Group.mk.carrier]

theorem productGroup.operation (G H : Set)
  shows Group.mul(productGroup(G, H)) = productOp(G.carrier, G.mul, H.carrier, H.mul)
proof
  simp [productGroup, Group.mk.mul]

theorem productGroup.unit (G H : Set)
  shows Group.one(productGroup(G, H)) = (G.one, H.one)
proof
  simp [productGroup, Group.mk.one]

theorem productGroup.inverse (G H : Set)
  shows Group.inv(productGroup(G, H)) = productInv(G.carrier, G.inv, H.carrier, H.inv)
proof
  simp [productGroup, Group.mk.inv]

theorem productOp.relates (A op B op2 a b c d : Set)
  requires magma : IsMagma(A, op)
  requires magma2 : IsMagma(B, op2)
  requires ha : a ∈ A
  requires hb : b ∈ B
  requires hc : c ∈ A
  requires hd : d ∈ B
  shows relates(productOp(A, op, B, op2), ((a, b), (c, d)), (op(a, c), op2(b, d)))
proof
  have ab := product.pair at a, b, A, B with *
  have cd := product.pair at c, d, A, B with *
  have input := product.pair at (a, b), (c, d), A × B, A × B with *
  have first := IsMagma.closed with magma, ha, hc
  have second := IsMagma.closed with magma2, hb, hd
  have output := product.pair at op(a, c), op2(b, d), A, B with *
  have bounded := product.pair at ((a, b), (c, d)), (op(a, c), op2(b, d)), (A × B) × (A × B), A × B with *
  unfold relates
  apply productOp.membership.backward
  refine ⟨bounded, a, ha, b, hb, c, hc, d, hd, rfl⟩

theorem productOp.function (A op B op2 : Set)
  requires magma : IsMagma(A, op)
  requires magma2 : IsMagma(B, op2)
  shows productOp(A, op, B, op2) : (A × B) × (A × B) → A × B
proof
  unfold FunctionBetween
  refine ⟨?_, ?_, ?_⟩
  . intros q hq
    have parts := productOp.membership.forward with hq
    exact parts.left
  . intros p y edge z edge2
    unfold relates at edge
    unfold relates at edge2
    obtain ⟨bounded, a, ha, b, hb, c, hc, d, hd, shape⟩ := productOp.membership.forward with edge
    obtain ⟨bounded2, a2, ha2, b2, hb2, c2, hc2, d2, hd2, shape2⟩ := productOp.membership.forward with edge2
    have outer := orderedPair.injective with shape
    have outer2 := orderedPair.injective with shape2
    have inputs : ((a, b), (c, d)) = ((a2, b2), (c2, d2)) by cc
    have halves := orderedPair.injective with inputs
    have left := orderedPair.injective with halves.left
    have right := orderedPair.injective with halves.right
    cc
  . intros p hp
    obtain ⟨bound, u, hu, v, hv, shape⟩ := product.membership.forward with hp
    obtain ⟨boundU, a, ha, b, hb, uShape⟩ := product.membership.forward with hu
    obtain ⟨boundV, c, hc, d, hd, vShape⟩ := product.membership.forward with hv
    have first := IsMagma.closed with magma, ha, hc
    have second := IsMagma.closed with magma2, hb, hd
    have output := product.pair at op(a, c), op2(b, d), A, B with *
    have edge := productOp.relates with magma, magma2, ha, hb, hc, hd
    refine ⟨(op(a, c), op2(b, d)), output, ?_⟩
    rw [shape, uShape, vShape]
    exact edge

theorem productOp.value (A op B op2 a b c d : Set)
  requires magma : IsMagma(A, op)
  requires magma2 : IsMagma(B, op2)
  requires ha : a ∈ A
  requires hb : b ∈ B
  requires hc : c ∈ A
  requires hd : d ∈ B
  shows (productOp(A, op, B, op2))((a, b), (c, d)) = (op(a, c), op2(b, d))
proof
  have function := productOp.function with magma, magma2
  have edge := productOp.relates with magma, magma2, ha, hb, hc, hd
  have ab := product.pair at a, b, A, B with *
  have cd := product.pair at c, d, A, B with *
  have input := product.pair at (a, b), (c, d), A × B, A × B with *
  have value := FunctionBetween.apply_value with function, input, edge
  have called : (productOp(A, op, B, op2))((a, b), (c, d)) =
      productOp(A, op, B, op2)(((a, b), (c, d)))
    unfold call2
    rfl
  rw called
  exact value

theorem productInv.relates (A inv B inv2 a b : Set)
  requires function : inv : A → A
  requires function2 : inv2 : B → B
  requires ha : a ∈ A
  requires hb : b ∈ B
  shows relates(productInv(A, inv, B, inv2), (a, b), (inv(a), inv2(b)))
proof
  have ab := product.pair at a, b, A, B with *
  have invA := FunctionBetween.apply_closed with function, ha
  have invB := FunctionBetween.apply_closed with function2, hb
  have output := product.pair at inv(a), inv2(b), A, B with *
  have bounded := product.pair at (a, b), (inv(a), inv2(b)), A × B, A × B with *
  unfold relates
  apply productInv.membership.backward
  refine ⟨bounded, a, ha, b, hb, rfl⟩

theorem productInv.function (A inv B inv2 : Set)
  requires function : inv : A → A
  requires function2 : inv2 : B → B
  shows productInv(A, inv, B, inv2) : A × B → A × B
proof
  unfold FunctionBetween
  refine ⟨?_, ?_, ?_⟩
  . intros q hq
    have parts := productInv.membership.forward with hq
    exact parts.left
  . intros p y edge z edge2
    unfold relates at edge
    unfold relates at edge2
    obtain ⟨bounded, a, ha, b, hb, shape⟩ := productInv.membership.forward with edge
    obtain ⟨bounded2, a2, ha2, b2, hb2, shape2⟩ := productInv.membership.forward with edge2
    have outer := orderedPair.injective with shape
    have outer2 := orderedPair.injective with shape2
    have inputs : (a, b) = (a2, b2) by cc
    have halves := orderedPair.injective with inputs
    cc
  . intros p hp
    obtain ⟨bound, a, ha, b, hb, shape⟩ := product.membership.forward with hp
    have invA := FunctionBetween.apply_closed with function, ha
    have invB := FunctionBetween.apply_closed with function2, hb
    have output := product.pair at inv(a), inv2(b), A, B with *
    have edge := productInv.relates with function, function2, ha, hb
    refine ⟨(inv(a), inv2(b)), output, ?_⟩
    rw shape
    exact edge

theorem productInv.value (A inv B inv2 a b : Set)
  requires function : inv : A → A
  requires function2 : inv2 : B → B
  requires ha : a ∈ A
  requires hb : b ∈ B
  shows (productInv(A, inv, B, inv2))((a, b)) = (inv(a), inv2(b))
proof
  have graph := productInv.function with function, function2
  have edge := productInv.relates with function, function2, ha, hb
  have ab := product.pair at a, b, A, B with *
  exact FunctionBetween.apply_value with graph, ab, edge

section ProductGroup
variable (G H : Set)
hypothesis group : Group(G)
hypothesis group2 : Group(H)

theorem productGroup.mul (a c : G) (b d : H)
  shows Group.mul(productGroup(G, H))((a, b), (c, d)) = (a * c, b * d)
proof
  have magma := IsGroup.magma with (Group.parts with group)
  have magma2 := IsGroup.magma with (Group.parts with group2)
  rw productGroup.operation
  exact productOp.value with magma, magma2, *

theorem productGroup.inv_value (a : G) (b : H)
  shows Group.inv(productGroup(G, H))((a, b)) = (a⁻¹, b⁻¹)
proof
  have function := Group.inverse_function with group
  have function2 := Group.inverse_function with group2
  rw productGroup.inverse
  exact productInv.value with function, function2, *

-- The direct product is a group.
theorem productGroup.group
  shows Group(productGroup(G, H))
proof
  have magma := IsGroup.magma with (Group.parts with group)
  have magma2 := IsGroup.magma with (Group.parts with group2)
  have invFunction := Group.inverse_function with group
  have invFunction2 := Group.inverse_function with group2
  have unitIn : G.one ∈ G := Group.one_mem with *
  have unitIn2 : H.one ∈ H := Group.one_mem with *
  have opFunction := productOp.function with magma, magma2
  have pMagma : IsMagma(G.carrier × H.carrier, productOp(G.carrier, G.mul, H.carrier, H.mul)) by exact opFunction
  have pAssociative : Associative(G.carrier × H.carrier, productOp(G.carrier, G.mul, H.carrier, H.mul))
    intros X hX Y hY Z hZ
    obtain ⟨boundX, a, ha, b, hb, xShape⟩ := product.membership.forward with hX
    obtain ⟨boundY, c, hc, d, hd, yShape⟩ := product.membership.forward with hY
    obtain ⟨boundZ, e, he, f, hf, zShape⟩ := product.membership.forward with hZ
    have ac : a * c ∈ G by typecheck
    have bd : b * d ∈ H by typecheck
    have ce : c * e ∈ G by typecheck
    have df : d * f ∈ H by typecheck
    have xy := productOp.value with magma, magma2, ha, hb, hc, hd
    have yz := productOp.value with magma, magma2, hc, hd, he, hf
    have left := productOp.value with magma, magma2, ac, bd, he, hf
    have right := productOp.value with magma, magma2, ha, hb, ce, df
    have assocA : a * c * e = a * (c * e) := mul_assoc with *
    have assocB : b * d * f = b * (d * f) := mul_assoc with *
    rw [xShape, yShape, zShape]
    cc
  have pIdentity : Identity(G.carrier × H.carrier, productOp(G.carrier, G.mul, H.carrier, H.mul), (G.one, H.one))
    have unitPair := product.pair at G.one, H.one, G.carrier, H.carrier with *
    unfold Identity
    refine ⟨unitPair, ?_⟩
    intros X hX
    obtain ⟨boundX, a, ha, b, hb, xShape⟩ := product.membership.forward with hX
    have leftA : G.one * a = a := one_mul with *
    have leftB : H.one * b = b := one_mul with *
    have rightA : a * G.one = a := mul_one with *
    have rightB : b * H.one = b := mul_one with *
    have left := productOp.value with magma, magma2, unitIn, unitIn2, ha, hb
    have right := productOp.value with magma, magma2, ha, hb, unitIn, unitIn2
    rw xShape
    constructor
    . cc
    . cc
  have pInverse : Inverse(G.carrier × H.carrier, productOp(G.carrier, G.mul, H.carrier, H.mul), (G.one, H.one), productInv(G.carrier, G.inv, H.carrier, H.inv))
    have invGraph := productInv.function with invFunction, invFunction2
    unfold Inverse
    refine ⟨invGraph, ?_⟩
    intros X hX
    obtain ⟨boundX, a, ha, b, hb, xShape⟩ := product.membership.forward with hX
    have invA : a⁻¹ ∈ G by typecheck
    have invB : b⁻¹ ∈ H by typecheck
    have inverseValue := productInv.value with invFunction, invFunction2, ha, hb
    have leftA : a⁻¹ * a = G.one := Group.inv_mul with *
    have leftB : b⁻¹ * b = H.one := Group.inv_mul with *
    have rightA : a * a⁻¹ = G.one := Group.mul_inv with *
    have rightB : b * b⁻¹ = H.one := Group.mul_inv with *
    have left := productOp.value with magma, magma2, invA, invB, ha, hb
    have right := productOp.value with magma, magma2, ha, hb, invA, invB
    rw xShape
    constructor
    . cc
    . cc
  unfold productGroup
  apply Group.of_parts
  simp [IsGroup, IsMonoid, IsSemigroup]

instance productGroup.pair_mem (a : G) (b : H)
  shows (a, b) ∈ Group.carrier(productGroup(G, H))
proof
  rw productGroup.carrierOf
  exact product.pair with *

theorem productGroup.abelian
  requires abelian : AbelianGroup(G)
  requires abelian2 : AbelianGroup(H)
  shows AbelianGroup(productGroup(G, H))
proof
  have magma := IsGroup.magma with (Group.parts with group)
  have magma2 := IsGroup.magma with (Group.parts with group2)
  have pGroup := Group.parts with (productGroup.group with group, group2)
  have pCommutative : Commutative(G.carrier × H.carrier, productOp(G.carrier, G.mul, H.carrier, H.mul))
    intros X hX Y hY
    obtain ⟨boundX, a, ha, b, hb, xShape⟩ := product.membership.forward with hX
    obtain ⟨boundY, c, hc, d, hd, yShape⟩ := product.membership.forward with hY
    have xy := productOp.value with magma, magma2, ha, hb, hc, hd
    have yx := productOp.value with magma, magma2, hc, hd, ha, hb
    have swapA : a * c = c * a := mul_comm with *
    have swapB : b * d = d * b := mul_comm with *
    rw [xShape, yShape]
    cc
  rw [productGroup.carrierOf, productGroup.operation, productGroup.unit, productGroup.inverse] at pGroup
  unfold productGroup
  apply AbelianGroup.of_parts
  unfold IsAbelianGroup
  exact ⟨pGroup, pCommutative⟩

-- The projections are surjective homomorphisms.
theorem firstProjection.hom
  shows firstProjection(G.carrier, H.carrier) : productGroup(G, H) →* G
proof
  have pGroup := productGroup.group with group, group2
  have function := firstProjection.function at G.carrier, H.carrier
  have function2 : firstProjection(G.carrier, H.carrier) : Group.carrier(productGroup(G, H)) → G.carrier
    rw productGroup.carrierOf
    exact function
  apply GroupHom.mk with pGroup, group, function2
  intros X hX Y hY
  rw productGroup.carrierOf at hX
  rw productGroup.carrierOf at hY
  obtain ⟨boundX, a, ha, b, hb, xShape⟩ := product.membership.forward with hX
  obtain ⟨boundY, c, hc, d, hd, yShape⟩ := product.membership.forward with hY
  have ac : a * c ∈ G by typecheck
  have bd : b * d ∈ H by typecheck
  have xy : Group.mul(productGroup(G, H))((a, b), (c, d)) = (a * c, b * d) := productGroup.mul with *
  have vx := firstProjection.pair with ha, hb
  have vy := firstProjection.pair with hc, hd
  have output := firstProjection.pair with ac, bd
  rw [xShape, yShape]
  cc

theorem secondProjection.hom
  shows secondProjection(G.carrier, H.carrier) : productGroup(G, H) →* H
proof
  have pGroup := productGroup.group with group, group2
  have function := secondProjection.function at G.carrier, H.carrier
  have function2 : secondProjection(G.carrier, H.carrier) : Group.carrier(productGroup(G, H)) → H.carrier
    rw productGroup.carrierOf
    exact function
  apply GroupHom.mk with pGroup, group2, function2
  intros X hX Y hY
  rw productGroup.carrierOf at hX
  rw productGroup.carrierOf at hY
  obtain ⟨boundX, a, ha, b, hb, xShape⟩ := product.membership.forward with hX
  obtain ⟨boundY, c, hc, d, hd, yShape⟩ := product.membership.forward with hY
  have ac : a * c ∈ G by typecheck
  have bd : b * d ∈ H by typecheck
  have xy : Group.mul(productGroup(G, H))((a, b), (c, d)) = (a * c, b * d) := productGroup.mul with *
  have vx := secondProjection.pair with ha, hb
  have vy := secondProjection.pair with hc, hd
  have output := secondProjection.pair with ac, bd
  rw [xShape, yShape]
  cc

theorem firstProjection.surjective
  shows SurjectiveBetween(firstProjection(G.carrier, H.carrier), Group.carrier(productGroup(G, H)), G.carrier)
proof
  have function := firstProjection.function at G.carrier, H.carrier
  have unitIn : H.one ∈ H := Group.one_mem with *
  rw productGroup.carrierOf
  constructor
  . exact function
  . intros a ha
    have pair := product.pair at a, H.one, G.carrier, H.carrier with *
    have value := firstProjection.pair with ha, unitIn
    have edge := FunctionBetween.relates_apply with function, pair
    refine ⟨(a, H.one), pair, ?_⟩
    rwa value at edge

theorem secondProjection.surjective
  shows SurjectiveBetween(secondProjection(G.carrier, H.carrier), Group.carrier(productGroup(G, H)), H.carrier)
proof
  have function := secondProjection.function at G.carrier, H.carrier
  have unitIn : G.one ∈ G := Group.one_mem with *
  rw productGroup.carrierOf
  constructor
  . exact function
  . intros b hb
    have pair := product.pair at G.one, b, G.carrier, H.carrier with *
    have value := secondProjection.pair with unitIn, hb
    have edge := FunctionBetween.relates_apply with function, pair
    refine ⟨(G.one, b), pair, ?_⟩
    rwa value at edge

-- The kernels of the projections are the two factors.
theorem firstProjection.kernel
  shows kernel(firstProjection(G.carrier, H.carrier), productGroup(G, H), G) = {G.one} × H.carrier
proof
  have unitIn : G.one ∈ G := Group.one_mem with *
  ext X
  constructor
  . intro hX
    obtain ⟨member, value⟩ := kernel.membership.forward with hX
    rw productGroup.carrierOf at member
    obtain ⟨bound, a, ha, b, hb, shape⟩ := product.membership.forward with member
    have projected := firstProjection.pair with ha, hb
    have aUnit : a = G.one by cc
    have inUnit : a ∈ {G.one}
      rw aUnit
      exact singleton.self
    rw shape
    exact product.pair with inUnit, hb
  . intro hX
    obtain ⟨bound, a, ha, b, hb, shape⟩ := product.membership.forward with hX
    have aUnit := singleton.membership.forward with ha
    have aIn : a ∈ G by rwa aUnit
    have member := product.pair at a, b, G.carrier, H.carrier with *
    have projected := firstProjection.pair with aIn, hb
    have vanishes : firstProjection(G.carrier, H.carrier)(X) = G.one by cc
    have memberX : X ∈ Group.carrier(productGroup(G, H))
      rw productGroup.carrierOf
      rwa shape
    exact kernel.of_value with memberX, vanishes

theorem secondProjection.kernel
  shows kernel(secondProjection(G.carrier, H.carrier), productGroup(G, H), H) = G.carrier × {H.one}
proof
  have unitIn : H.one ∈ H := Group.one_mem with *
  ext X
  constructor
  . intro hX
    obtain ⟨member, value⟩ := kernel.membership.forward with hX
    rw productGroup.carrierOf at member
    obtain ⟨bound, a, ha, b, hb, shape⟩ := product.membership.forward with member
    have projected := secondProjection.pair with ha, hb
    have bUnit : b = H.one by cc
    have inUnit : b ∈ {H.one}
      rw bUnit
      exact singleton.self
    rw shape
    exact product.pair with ha, inUnit
  . intro hX
    obtain ⟨bound, a, ha, b, hb, shape⟩ := product.membership.forward with hX
    have bUnit := singleton.membership.forward with hb
    have bIn : b ∈ H by rwa bUnit
    have member := product.pair at a, b, G.carrier, H.carrier with *
    have projected := secondProjection.pair with ha, bIn
    have vanishes : secondProjection(G.carrier, H.carrier)(X) = H.one by cc
    have memberX : X ∈ Group.carrier(productGroup(G, H))
      rw productGroup.carrierOf
      rwa shape
    exact kernel.of_value with memberX, vanishes

-- Each factor is a normal subgroup of the product.
theorem productGroup.right_factor_normal
  shows NormalSubgroup({G.one} × H.carrier, productGroup(G, H))
proof
  have hom := firstProjection.hom with group, group2
  have normal := GroupHom.kernel_normal with hom
  have same := firstProjection.kernel with group, group2
  rwa same at normal

theorem productGroup.left_factor_normal
  shows NormalSubgroup(G.carrier × {H.one}, productGroup(G, H))
proof
  have hom := secondProjection.hom with group, group2
  have normal := GroupHom.kernel_normal with hom
  have same := secondProjection.kernel with group, group2
  rwa same at normal

end ProductGroup

-- The embedding of the left factor.
def leftEmbedding (A B unit2 : Set) : Set :=
  { q ∈ A × (A × B) | ∃ a ∈ A, q = (a ↦ (a, unit2)) }

theorem leftEmbedding.relates (A B unit2 a : Set)
  requires unitIn : unit2 ∈ B
  requires ha : a ∈ A
  shows relates(leftEmbedding(A, B, unit2), a, (a, unit2))
proof
  have pair := product.pair at a, unit2, A, B with *
  have bounded := product.pair at a, (a, unit2), A, A × B with *
  unfold relates
  apply leftEmbedding.membership.backward
  refine ⟨bounded, a, ha, rfl⟩

theorem leftEmbedding.function (A B unit2 : Set)
  requires unitIn : unit2 ∈ B
  shows leftEmbedding(A, B, unit2) : A → A × B
proof
  unfold FunctionBetween
  refine ⟨?_, ?_, ?_⟩
  . intros q hq
    have parts := leftEmbedding.membership.forward with hq
    exact parts.left
  . intros p y edge z edge2
    unfold relates at edge
    unfold relates at edge2
    obtain ⟨bounded, a, ha, shape⟩ := leftEmbedding.membership.forward with edge
    obtain ⟨bounded2, a2, ha2, shape2⟩ := leftEmbedding.membership.forward with edge2
    have outer := orderedPair.injective with shape
    have outer2 := orderedPair.injective with shape2
    cc
  . intros a ha
    have pair := product.pair at a, unit2, A, B with *
    have edge := leftEmbedding.relates with unitIn, ha
    exact ⟨(a, unit2), pair, edge⟩

theorem leftEmbedding.value (A B unit2 a : Set)
  requires unitIn : unit2 ∈ B
  requires ha : a ∈ A
  shows leftEmbedding(A, B, unit2)(a) = (a, unit2)
proof
  have function := leftEmbedding.function at A, B, unit2 with unitIn
  have edge := leftEmbedding.relates with unitIn, ha
  exact FunctionBetween.apply_value with function, ha, edge

theorem leftEmbedding.injective (A B unit2 : Set)
  requires unitIn : unit2 ∈ B
  shows InjectiveBetween(leftEmbedding(A, B, unit2), A, A × B)
proof
  have function := leftEmbedding.function at A, B, unit2 with unitIn
  constructor
  . exact function
  . intros x hx y hy z hz hxz hyz
    have vx := FunctionBetween.apply_value with function, hx, hxz
    have vy := FunctionBetween.apply_value with function, hy, hyz
    have ex := leftEmbedding.value with unitIn, hx
    have ey := leftEmbedding.value with unitIn, hy
    have pairs : (x, unit2) = (y, unit2) by cc
    have coordinates := orderedPair.injective with pairs
    exact coordinates.left

theorem leftEmbedding.first_projection (A B unit2 a : Set)
  requires unitIn : unit2 ∈ B
  requires ha : a ∈ A
  shows firstProjection(A, B)(leftEmbedding(A, B, unit2)(a)) = a
proof
  have value := leftEmbedding.value with unitIn, ha
  have projected := firstProjection.pair with ha, unitIn
  rw value
  exact projected

section Embedding
variable (G H : Set)
hypothesis group : Group(G)
hypothesis group2 : Group(H)

theorem leftEmbedding.hom
  shows leftEmbedding(G.carrier, H.carrier, H.one) : G →* productGroup(G, H)
proof
  have pGroup := productGroup.group with group, group2
  have unitIn : H.one ∈ H := Group.one_mem with *
  have function := leftEmbedding.function at G.carrier, H.carrier, H.one with unitIn
  have function2 : leftEmbedding(G.carrier, H.carrier, H.one) : G.carrier → Group.carrier(productGroup(G, H))
    rw productGroup.carrierOf
    exact function
  apply GroupHom.mk with group, pGroup, function2
  intros x hx y hy
  have closed : x * y ∈ G by typecheck
  have vx := leftEmbedding.value with unitIn, hx
  have vy := leftEmbedding.value with unitIn, hy
  have output := leftEmbedding.value with unitIn, closed
  have combined : Group.mul(productGroup(G, H))((x, H.one), (y, H.one)) = (x * y, H.one * H.one) :=
    productGroup.mul with *
  have identity : H.one * H.one = H.one := one_mul with *
  cc

end Embedding
