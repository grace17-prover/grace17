-- Group homomorphisms f : G →* H: maps preserving the operation, hence the
-- unit, inverses, and powers; identity, constant, and composite
-- homomorphisms
-- Part of Cumulus, the Grace17 mathematics library.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module Grace.Cumulus.Algebra.Group.Homomorphism
import Pow

-- f : G →* H: a function between the carriers preserving the operation;
-- the unit and inverse laws follow. The form is a transparent guard, so a
-- hypothesis f : G →* H also supplies the groups G and H, their operations
-- a * b, and the binders (a : G) and (b : H).
predicate GroupHom (f G H : Set) :=
  Group(G) ∧ Group(H) ∧ (f : G.carrier → H.carrier) ∧
  (∀ x y ∈ G.carrier, f(x * y) = f(x) * f(y))

notation guard "_ : _ →* _" => GroupHom

theorem GroupHom.mk (f G H : Set)
  requires source : Group(G)
  requires target : Group(H)
  requires function : f : G.carrier → H.carrier
  requires preserves : ∀ x y ∈ G.carrier, f(x * y) = f(x) * f(y)
  shows f : G →* H
proof
  unfold GroupHom
  refine ⟨source, target, function, preserves⟩

section HomLaws
variable (f G H : Set)
hypothesis hom : f : G →* H

theorem GroupHom.source
  shows Group(G)
proof
  obtain ⟨source, rest⟩ := hom
  exact source

theorem GroupHom.target
  shows Group(H)
proof
  obtain ⟨source, target, rest⟩ := hom
  exact target

theorem GroupHom.function
  shows f : G.carrier → H.carrier
proof
  obtain ⟨source, target, function, preserves⟩ := hom
  exact function

theorem GroupHom.map_mul (a b : G)
  shows f(a * b) = f(a) * f(b)
proof
  obtain ⟨source, target, function, preserves⟩ := hom
  have aIn : a ∈ G by assumption
  have bIn : b ∈ G by assumption
  exact preserves with a, aIn, b, bIn

instance GroupHom.map_mem (a : G)
  shows f(a) ∈ H
proof
  have function := GroupHom.function with hom
  exact FunctionBetween.apply_closed with function, *

theorem GroupHom.map_one
  shows f(G.one) = H.one
proof
  have group := GroupHom.source with hom
  have target := GroupHom.target with hom
  have preserved : f(G.one * G.one) = f(G.one) * f(G.one) := GroupHom.map_mul with *
  rw mul_one at preserved
  have criterion : f(G.one) * f(G.one) = f(G.one) ↔ f(G.one) = H.one := mul_self_eq_self with *
  symm at preserved
  exact criterion.forward with preserved

theorem GroupHom.map_inv (a : G)
  shows f(a⁻¹) = f(a)⁻¹
proof
  have product : f(a) * f(a⁻¹) = H.one
    rw [← GroupHom.map_mul, Group.mul_inv, GroupHom.map_one]
    rfl
  exact eq_inv_of_mul_eq_one_right with *

theorem GroupHom.map_mul_inv (a b : G)
  shows f(a * b⁻¹) = f(a) * f(b)⁻¹
proof
  rw [GroupHom.map_mul, GroupHom.map_inv]
  rfl

theorem GroupHom.map_inv_mul (a b : G)
  shows f(a⁻¹ * b) = f(a)⁻¹ * f(b)
proof
  rw [GroupHom.map_mul, GroupHom.map_inv]
  rfl

theorem GroupHom.map_pow (a : G) (n : Nat)
  shows f(a ^ n) = f(a) ^ n
proof
  have group := GroupHom.source with hom
  have target := GroupHom.target with hom
  induction n
  | zero =>
    rw [pow_zero, pow_zero, GroupHom.map_one]
    rfl
  | succ(k) using ih =>
    rw [← add.right_one, pow_succ, pow_succ, GroupHom.map_mul, ih]
    rfl

theorem GroupHom.map_inv_eq_one (a : G)
  requires vanishes : f(a) = H.one
  shows f(a⁻¹) = H.one
proof
  rw [GroupHom.map_inv, vanishes, inv_one]
  rfl

theorem GroupHom.ext (g : Set)
  requires hom2 : g : G →* H
  requires same : ∀ x ∈ G, f(x) = g(x)
  shows f = g
proof
  have fFunction := GroupHom.function with hom
  have gFunction := GroupHom.function with hom2
  exact FunctionBetween.ext with fFunction, gFunction, same

theorem GroupHom.id_comp
  shows compose(identity(H.carrier), f, G.carrier, H.carrier, H.carrier) = f
proof
  have function := GroupHom.function with hom
  exact compose.identity_left with function

theorem GroupHom.comp_id
  shows compose(f, identity(G.carrier), G.carrier, G.carrier, H.carrier) = f
proof
  have function := GroupHom.function with hom
  exact compose.identity_right with function

end HomLaws

theorem GroupHom.id (G : Set)
  requires group : Group(G)
  shows identity(G.carrier) : G →* G
proof
  have function := identity.function at G.carrier
  apply GroupHom.mk with group, group, function
  intros x hx y hy
  have vx := identity.apply with hx
  have vy := identity.apply with hy
  have closed : x * y ∈ G.carrier by typecheck
  have output := identity.apply with closed
  rw [vx, vy]
  exact output

theorem GroupHom.const (G H : Set)
  requires group : Group(G)
  requires target : Group(H)
  shows constantFunction(G.carrier, H.carrier, H.one) : G →* H
proof
  have unitIn : H.one ∈ H.carrier := Group.one_mem with *
  have function := constantFunction.function at G.carrier, H.carrier, H.one with unitIn
  apply GroupHom.mk with group, target, function
  intros x hx y hy
  have vx := constantFunction.apply with hx, unitIn
  have vy := constantFunction.apply with hy, unitIn
  have closed : x * y ∈ G.carrier by typecheck
  have output := constantFunction.apply with closed, unitIn
  rw [vx, vy, output, one_mul]
  rfl

theorem GroupHom.comp (f g G H K : Set)
  requires first : f : G →* H
  requires second : g : H →* K
  shows compose(g, f, G.carrier, H.carrier, K.carrier) : G →* K
proof
  have source := GroupHom.source with first
  have target := GroupHom.target with second
  have fFunction := GroupHom.function with first
  have gFunction := GroupHom.function with second
  have function := compose.function with fFunction, gFunction
  apply GroupHom.mk with source, target, function
  intros x hx y hy
  have fx : f(x) ∈ H.carrier by typecheck
  have fy : f(y) ∈ H.carrier by typecheck
  have fMul : f(x * y) = f(x) * f(y) := GroupHom.map_mul with *
  have gMul : g(f(x) * f(y)) = g(f(x)) * g(f(y)) := GroupHom.map_mul with *
  have vx := compose.apply at g, f, G.carrier, H.carrier, K.carrier, x with *
  have vy := compose.apply at g, f, G.carrier, H.carrier, K.carrier, y with *
  have closed : x * y ∈ G.carrier by typecheck
  have output := compose.apply at g, f, G.carrier, H.carrier, K.carrier, x * y with *
  cc
