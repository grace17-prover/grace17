-- Cyclic subgroups: the powers of an element, elements of finite order
-- and the order of an element as the least positive exponent giving the
-- unit, powers repeating with period the order, and the powers forming
-- the subgroup generated by the element
-- Part of Cumulus, the Grace17 mathematics library.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module Grace.Cumulus.Algebra.Group.Cyclic
import Lagrange
import Generated

-- The powers of g in G.
def powers (G g : Set) : Set := { x ∈ G.carrier | ∃ n ∈ ℕ, x = groupPow(G, g, n) }

-- Elements of finite order, the positive exponents giving the unit, and the
-- order of an element: the least such exponent.
predicate HasFiniteOrder (G g : Set) := ∃ n, Nat(n) ∧ 0 < n ∧ groupPow(G, g, n) = G.one

def unitPowers (G g : Set) : Set := { n ∈ ℕ | 0 < n ∧ groupPow(G, g, n) = G.one }

def elementOrder (G g : Set) : Set := leastNatural(unitPowers(G, g))

theorem powers.membership (G g x : Set)
  shows x ∈ powers(G, g) ↔ x ∈ G.carrier ∧ ∃ n ∈ ℕ, x = groupPow(G, g, n)
proof
  simp [powers]

theorem powers.subset (G g : Set)
  shows powers(G, g) ⊆ G.carrier
proof
  intros x hx
  have parts := powers.membership.forward with hx
  exact parts.left

theorem unitPowers.membership (G g n : Set)
  shows n ∈ unitPowers(G, g) ↔ n ∈ ℕ ∧ 0 < n ∧ groupPow(G, g, n) = G.one
proof
  simp [unitPowers]

theorem unitPowers.subset_naturals (G g : Set)
  shows unitPowers(G, g) ⊆ ℕ
proof
  intros n hn
  have parts := unitPowers.membership.forward with hn
  exact parts.left

theorem unitPowers.of_pow (G g : Set, n : Nat)
  requires positive : 0 < n
  requires vanishes : groupPow(G, g, n) = G.one
  shows n ∈ unitPowers(G, g)
proof
  have nNat : Nat(n) by typecheck
  have natIn := nat.omega.forward with nNat
  apply unitPowers.membership.backward
  refine ⟨natIn, positive, vanishes⟩

theorem HasFiniteOrder.nonempty (G g : Set)
  requires finite : HasFiniteOrder(G, g)
  shows Nonempty(unitPowers(G, g))
proof
  obtain ⟨n, nNat, positive, vanishes⟩ := finite
  have member := unitPowers.of_pow with positive, vanishes
  exact ⟨n, member⟩

theorem HasFiniteOrder.of_pow (G g : Set, n : Nat)
  requires positive : 0 < n
  requires vanishes : groupPow(G, g, n) = G.one
  shows HasFiniteOrder(G, g)
proof
  have nNat : Nat(n) by typecheck
  unfold HasFiniteOrder
  exact ⟨n, nNat, positive, vanishes⟩

theorem elementOrder.member (G g : Set)
  requires finite : HasFiniteOrder(G, g)
  shows elementOrder(G, g) ∈ unitPowers(G, g)
proof
  have inhabited := HasFiniteOrder.nonempty with finite
  have naturals := unitPowers.subset_naturals at G, g
  unfold elementOrder
  exact leastNatural.member with inhabited, naturals

theorem elementOrder.natural (G g : Set)
  requires finite : HasFiniteOrder(G, g)
  shows Nat(elementOrder(G, g))
proof
  have member := elementOrder.member with finite
  have parts := unitPowers.membership.forward with member
  exact nat.omega.backward with parts.left

theorem elementOrder.positive (G g : Set)
  requires finite : HasFiniteOrder(G, g)
  shows 0 < elementOrder(G, g)
proof
  have member := elementOrder.member with finite
  have parts := unitPowers.membership.forward with member
  exact parts.right.left

theorem elementOrder.nonzero (G g : Set)
  requires finite : HasFiniteOrder(G, g)
  shows elementOrder(G, g) ≠ 0
proof
  have positive := elementOrder.positive with finite
  have natural := elementOrder.natural with finite
  intro zero
  rw zero at positive
  exact Less.irreflexive at 0 with positive

theorem elementOrder.pow_order (G g : Set)
  requires finite : HasFiniteOrder(G, g)
  shows groupPow(G, g, elementOrder(G, g)) = G.one
proof
  have member := elementOrder.member with finite
  have parts := unitPowers.membership.forward with member
  exact parts.right.right

theorem elementOrder.least (G g : Set, m : Nat)
  requires finite : HasFiniteOrder(G, g)
  requires positive : 0 < m
  requires vanishes : groupPow(G, g, m) = G.one
  shows elementOrder(G, g) ≤ m
proof
  have inhabited := HasFiniteOrder.nonempty with finite
  have naturals := unitPowers.subset_naturals at G, g
  have member := unitPowers.of_pow with positive, vanishes
  unfold elementOrder
  exact leastNatural.least with inhabited, naturals, member

section Powers
variable (G : Set)
hypothesis group : Group(G)

instance powers.pow_mem (g : G) (n : Nat)
  shows g ^ n ∈ powers(G, g)
proof
  have closed : g ^ n ∈ G by typecheck
  have nNat : Nat(n) by typecheck
  have natIn := nat.omega.forward with nNat
  apply powers.membership.backward
  refine ⟨closed, n, natIn, rfl⟩

theorem powers.one_mem (g : G)
  shows G.one ∈ powers(G, g)
proof
  have member : g ^ 0 ∈ powers(G, g) := powers.pow_mem with *
  rwa pow_zero at member

theorem powers.self_mem (g : G)
  shows g ∈ powers(G, g)
proof
  have member : g ^ 1 ∈ powers(G, g) := powers.pow_mem with *
  rwa pow_one at member

theorem powers.mul_mem (g : G) (x y : Set)
  requires hx : x ∈ powers(G, g)
  requires hy : y ∈ powers(G, g)
  shows x * y ∈ powers(G, g)
proof
  obtain ⟨xIn, m, mIn, xEq⟩ := powers.membership.forward with hx
  obtain ⟨yIn, n, nIn, yEq⟩ := powers.membership.forward with hy
  have mNat := nat.omega.backward with mIn
  have nNat := nat.omega.backward with nIn
  have split : g ^ (m + n) = g ^ m * g ^ n := pow_add with *
  have member : g ^ (m + n) ∈ powers(G, g) := powers.pow_mem with *
  rw [xEq, yEq, ← split]
  exact member

theorem powers.commutative (g : G)
  shows Commutative(powers(G, g), G.mul)
proof
  intros x hx y hy
  obtain ⟨xIn, m, mIn, xEq⟩ := powers.membership.forward with hx
  obtain ⟨yIn, n, nIn, yEq⟩ := powers.membership.forward with hy
  have mNat := nat.omega.backward with mIn
  have nNat := nat.omega.backward with nIn
  have swap : g ^ m * g ^ n = g ^ n * g ^ m := pow_mul_comm with *
  rw [xEq, yEq]
  exact swap

theorem powers.subset_generated (g : G)
  shows powers(G, g) ⊆ generatedSubgroup(G, {g})
proof
  intros x hx
  obtain ⟨xIn, n, nIn, xEq⟩ := powers.membership.forward with hx
  have nNat := nat.omega.backward with nIn
  have member : g ^ n ∈ generatedSubgroup(G, {g}) := generatedSubgroup.pow_mem with *
  rwa xEq

theorem powers.subset_subgroup (H g : Set)
  requires subgroup : Subgroup(H, G)
  requires hg : g ∈ H
  shows powers(G, g) ⊆ H
proof
  intros x hx
  obtain ⟨xIn, n, nIn, xEq⟩ := powers.membership.forward with hx
  have nNat := nat.omega.backward with nIn
  have member : g ^ n ∈ H := Subgroup.pow_mem with *
  rwa xEq

theorem HasFiniteOrder.one
  shows HasFiniteOrder(G, G.one)
proof
  have one : G.one ^ 1 = G.one := pow_one with *
  have positive : 0 < 1 by arith
  exact HasFiniteOrder.of_pow with positive, one

theorem elementOrder.pow_mul (g : G) (k : Nat)
  requires finite : HasFiniteOrder(G, g)
  shows g ^ mul(elementOrder(G, g), k) = G.one
proof
  have natural := elementOrder.natural with finite
  have vanishes := elementOrder.pow_order with finite
  have split : g ^ (elementOrder(G, g) * k) = (g ^ elementOrder(G, g)) ^ k := pow_mul with *
  have unitPower : G.one ^ k = G.one := one_pow with *
  rw [split, vanishes]
  exact unitPower

theorem elementOrder.pow_mod (g : G) (n : Nat)
  requires finite : HasFiniteOrder(G, g)
  shows g ^ n = g ^ (n % elementOrder(G, g))
proof
  have natural := elementOrder.natural with finite
  have nonzero := elementOrder.nonzero with finite
  obtain ⟨q, qNat, shape⟩ := mod.equation at n, elementOrder(G, g) with nonzero
  have remainderNat : Nat(n % elementOrder(G, g)) by typecheck
  have multipleNat : Nat(elementOrder(G, g) * q) by typecheck
  have split : g ^ (elementOrder(G, g) * q + n % elementOrder(G, g)) =
      g ^ (elementOrder(G, g) * q) * g ^ (n % elementOrder(G, g)) := pow_add with *
  have vanishes : g ^ mul(elementOrder(G, g), q) = G.one := elementOrder.pow_mul with *
  have expanded : g ^ n = g ^ (elementOrder(G, g) * q + n % elementOrder(G, g))
    rw ← shape
    rfl
  rw [expanded, split, vanishes, one_mul]
  rfl

theorem elementOrder.pow_eq_one_of_dvd (g : G) (n : Nat)
  requires finite : HasFiniteOrder(G, g)
  requires divides : elementOrder(G, g) ∣ n
  shows g ^ n = G.one
proof
  have natural := elementOrder.natural with finite
  obtain ⟨k, kNat, shape⟩ := divides
  have vanishes : g ^ mul(elementOrder(G, g), k) = G.one := elementOrder.pow_mul with *
  rw ← shape
  exact vanishes

theorem elementOrder.dvd_of_pow_eq_one (g : G) (n : Nat)
  requires finite : HasFiniteOrder(G, g)
  requires vanishes : g ^ n = G.one
  shows elementOrder(G, g) ∣ n
proof
  have natural := elementOrder.natural with finite
  have nonzero := elementOrder.nonzero with finite
  obtain ⟨q, qNat, shape⟩ := mod.equation at n, elementOrder(G, g) with nonzero
  have below := mod.less at n, elementOrder(G, g) with nonzero
  have remainderNat : Nat(n % elementOrder(G, g)) by typecheck
  have reduced : g ^ n = g ^ (n % elementOrder(G, g)) := elementOrder.pow_mod with *
  have remainderVanishes : g ^ (n % elementOrder(G, g)) = G.one by cc
  have remainderZero : n % elementOrder(G, g) = 0
    by_contra
    have positive := Less.add_positive at 0, n % elementOrder(G, g) with this
    have zeroAdd : 0 + n % elementOrder(G, g) = n % elementOrder(G, g) by ring
    rw zeroAdd at positive
    have least := elementOrder.least with finite, positive, remainderVanishes
    have strict := LessEqual.transitive_Less with least, below
    exact Less.irreflexive with strict
  rw remainderZero at shape
  have multiple : elementOrder(G, g) * q = n
    have addZero : elementOrder(G, g) * q + 0 = elementOrder(G, g) * q by ring
    rw addZero at shape
    symm
    exact shape
  unfold Divides
  exact ⟨q, qNat, multiple⟩

theorem elementOrder.pow_eq_one_iff (g : G) (n : Nat)
  requires finite : HasFiniteOrder(G, g)
  shows g ^ n = G.one ↔ elementOrder(G, g) ∣ n
proof
  constructor
  . intro vanishes
    exact elementOrder.dvd_of_pow_eq_one with *
  . intro divides
    exact elementOrder.pow_eq_one_of_dvd with *

-- The order of the unit is one, and an element of order one is the unit.
theorem elementOrder.one
  shows elementOrder(G, G.one) = 1
proof
  have finite := HasFiniteOrder.one with group
  have natural := elementOrder.natural with finite
  have positive := elementOrder.positive with finite
  have one : G.one ^ 1 = G.one := pow_one with *
  have onePositive : 0 < 1 by arith
  have least := elementOrder.least with finite, onePositive, one
  have lower : 1 ≤ elementOrder(G, G.one) by arith
  exact LessEqual.antisymmetric with least, lower

theorem elementOrder.eq_one_iff (g : G)
  requires finite : HasFiniteOrder(G, g)
  shows elementOrder(G, g) = 1 ↔ g = G.one
proof
  have one : g ^ 1 = g := pow_one with *
  constructor
  . intro equal
    have vanishes := elementOrder.pow_order with finite
    rw [equal, one] at vanishes
    exact vanishes
  . intro equal
    rw equal
    exact elementOrder.one with group

-- Inverses of powers are powers when the element has finite order.
theorem powers.inv_mem (g : G) (x : Set)
  requires finite : HasFiniteOrder(G, g)
  requires hx : x ∈ powers(G, g)
  shows x⁻¹ ∈ powers(G, g)
proof
  have natural := elementOrder.natural with finite
  have nonzero := elementOrder.nonzero with finite
  obtain ⟨xIn, n, nIn, xEq⟩ := powers.membership.forward with hx
  have nNat := nat.omega.backward with nIn
  have shape := natural.zero_or_successor at elementOrder(G, g)
  cases shape with zero | successor
  . exfalso
    exact nonzero with zero
  . obtain ⟨k, kNat, orderEq⟩ := successor
    have split : g ^ (n + n * k) = g ^ n * g ^ (n * k) := pow_add with *
    have step := mul.succ_right at k, n
    have swap := mul.commutative at n, elementOrder(G, g)
    have vanishes : g ^ mul(elementOrder(G, g), n) = G.one := elementOrder.pow_mul with *
    have product : g ^ n * g ^ (n * k) = G.one
      rw [← split, ← step, ← orderEq, ← swap]
      exact vanishes
    have inverted : g ^ (n * k) = (g ^ n)⁻¹ := eq_inv_of_mul_eq_one_right with *
    have member : g ^ (n * k) ∈ powers(G, g) := powers.pow_mem with *
    rw [xEq, ← inverted]
    exact member

theorem powers.subgroup (g : G)
  requires finite : HasFiniteOrder(G, g)
  shows Subgroup(powers(G, g), G)
proof
  have unitIn : G.one ∈ powers(G, g) := powers.one_mem with *
  apply Subgroup.mk with group, (powers.subset at G, g), unitIn
  . intros x hx y hy
    exact powers.mul_mem with *
  . intros x hx
    exact powers.inv_mem with *

theorem powers.eq_generated (g : G)
  requires finite : HasFiniteOrder(G, g)
  shows powers(G, g) = generatedSubgroup(G, {g})
proof
  have subgroup := powers.subgroup with *
  have included := powers.subset_generated with *
  have selfIn : g ∈ powers(G, g) := powers.self_mem with *
  have singleton : {g} ⊆ powers(G, g)
    intros x hx
    have equal := singleton.membership.forward with hx
    rwa equal
  have least := generatedSubgroup.least with subgroup, singleton
  exact Subset.antisymmetric with included, least

end Powers

theorem powers.normal_of_abelian (G g : Set)
  requires abelian : AbelianGroup(G)
  requires hg : g ∈ G.carrier
  requires finite : HasFiniteOrder(G, g)
  shows NormalSubgroup(powers(G, g), G)
proof
  have group := AbelianGroup.to_group with abelian
  have subgroup := powers.subgroup with *
  exact NormalSubgroup.of_abelian with abelian, subgroup

section HomPowers
variable (f G H : Set)
hypothesis hom : f : G →* H

-- Homomorphisms carry powers to powers and preserve finite order.
theorem GroupHom.image_powers (g : G)
  shows functionImage(f, powers(G, g), H.carrier) = powers(H, f(g))
proof
  have group := GroupHom.source with hom
  have target := GroupHom.target with hom
  have function := GroupHom.function with hom
  have fg : f(g) ∈ H by typecheck
  ext y
  constructor
  . intro hy
    obtain ⟨yIn, x, hx, yEq⟩ := functionImage.membership.forward with hy
    obtain ⟨xIn, n, nIn, xEq⟩ := powers.membership.forward with hx
    have nNat := nat.omega.backward with nIn
    have preserved : f(g ^ n) = f(g) ^ n := GroupHom.map_pow with *
    have member : f(g) ^ n ∈ powers(H, f(g)) := powers.pow_mem with *
    rw [yEq, xEq, preserved]
    exact member
  . intro hy
    obtain ⟨yIn, n, nIn, yEq⟩ := powers.membership.forward with hy
    have nNat := nat.omega.backward with nIn
    have preserved : f(g ^ n) = f(g) ^ n := GroupHom.map_pow with *
    have member : g ^ n ∈ powers(G, g) := powers.pow_mem with *
    apply functionImage.membership.backward
    refine ⟨yIn, g ^ n, member, ?_⟩
    rw [yEq, preserved]
    rfl

theorem GroupHom.finite_order (g : G)
  requires finite : HasFiniteOrder(G, g)
  shows HasFiniteOrder(H, f(g))
proof
  have group := GroupHom.source with hom
  have target := GroupHom.target with hom
  obtain ⟨n, nNat, positive, vanishes⟩ := finite
  have preserved : f(g ^ n) = f(g) ^ n := GroupHom.map_pow with *
  have unitValue := GroupHom.map_one with hom
  have imageVanishes : f(g) ^ n = H.one by cc
  exact HasFiniteOrder.of_pow with positive, imageVanishes

theorem GroupHom.order_dvd (g : G)
  requires finite : HasFiniteOrder(G, g)
  shows elementOrder(H, f(g)) ∣ elementOrder(G, g)
proof
  have group := GroupHom.source with hom
  have target := GroupHom.target with hom
  have fg : f(g) ∈ H by typecheck
  have imageFinite := GroupHom.finite_order with hom, finite
  have natural := elementOrder.natural with finite
  have vanishes := elementOrder.pow_order with finite
  have preserved : f(g ^ elementOrder(G, g)) = f(g) ^ elementOrder(G, g) := GroupHom.map_pow with *
  have unitValue := GroupHom.map_one with hom
  have imageVanishes : f(g) ^ elementOrder(G, g) = H.one by cc
  exact elementOrder.dvd_of_pow_eq_one with *

end HomPowers
