-- A chosen representative of each left coset, and the bijection
-- g ↦ (gH, rep(gH)⁻¹ * g) from a group onto the product of the coset space
-- and the subgroup, with no finiteness assumed; this is the one place in
-- group theory up to Lagrange's theorem that selects with Choice
-- Part of Cumulus, the Grace17 mathematics library.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module Grace.Cumulus.Algebra.Group.CosetSplit
import Lagrange
import Set.Choice

-- A chosen representative of each coset.
defchoose cosetRepresentative (G H C : Set) (r ∈ G.carrier) := r ∈ C
requires group : Group(G)
requires subgroup : Subgroup(H, G)
requires hC : C ∈ leftCosets(G, H)
proof
  exact leftCosets.representative with group, subgroup, hC

-- Each element g is sent to its coset and to its position rep(gH)⁻¹ * g
-- in H.
defgraph cosetSplit (G H : Set) (g ∈ G.carrier) : leftCosets(G, H) × H :=
  (g • H, cosetRepresentative(G, H, g • H)⁻¹ * g)
requires group : Group(G)
requires subgroup : Subgroup(H, G)
proof
  have cosetIn := leftCosets.coset_member at G, H, g with member
  have selected := cosetRepresentative.selected at G, H, g • H with group, subgroup, cosetIn
  have repIn := selected.left
  obtain ⟨repBound, h0, h0In, repEq⟩ := leftCoset.membership.forward with selected.right
  have position : cosetRepresentative(G, H, g • H)⁻¹ * g = h0⁻¹
    rw [repEq, mul_inv_rev, inv_mul_cancel_right]
    rfl
  apply product.pair_membership.backward
  constructor
  . exact cosetIn
  . rw position
    exact Subgroup.inv_mem with *

section CosetSplit
variable (G H : Set)
hypothesis group : Group(G)
hypothesis subgroup : Subgroup(H, G)

-- The split g ↦ (gH, rep(gH)⁻¹ * g) is a bijection onto the product of the
-- coset space and the subgroup, with no finiteness assumed.
theorem cosetSplit.injective
  shows InjectiveBetween(cosetSplit(G, H), G.carrier, leftCosets(G, H) × H)
proof
  have function := cosetSplit.function at G, H with *
  constructor
  . exact function
  . intros x hx y hy z hz hxz hyz
    have xValue := FunctionBetween.apply_value with function, hx, hxz
    have yValue := FunctionBetween.apply_value with function, hy, hyz
    have xPair := cosetSplit.value at G, H, x with *
    have yPair := cosetSplit.value at G, H, y with *
    rw xValue at xPair
    rw [yValue, xPair] at yPair
    have components := orderedPair.injective with yPair
    have samePosition := components.right
    rw components.left at samePosition
    have cosetIn := leftCosets.coset_member at G, H, y with hy
    have selected := cosetRepresentative.selected with group, subgroup, cosetIn
    have repIn := selected.left
    exact mul_left_cancel with *

theorem cosetSplit.surjective
  shows SurjectiveBetween(cosetSplit(G, H), G.carrier, leftCosets(G, H) × H)
proof
  have function := cosetSplit.function at G, H with *
  constructor
  . exact function
  . intros p hp
    obtain ⟨bound, C, hC, h, hh, pEq⟩ := product.membership.forward with hp
    have selected := cosetRepresentative.selected with group, subgroup, hC
    have repIn := selected.left
    have repC := selected.right
    obtain ⟨cosetBound, g0, hg0, CEq⟩ := leftCosets.membership.forward with hC
    have gIn : cosetRepresentative(G, H, C) * h ∈ G by typecheck
    witness cosetRepresentative(G, H, C) * h
    constructor
    . exact gIn
    . have value := cosetSplit.value at G, H, cosetRepresentative(G, H, C) * h with *
      have gCoset : (cosetRepresentative(G, H, C) * h) • H = C
        symm at CEq
        have repIn2 : cosetRepresentative(G, H, C) ∈ g0 • H by rwa CEq
        have repCoset : cosetRepresentative(G, H, C) • H = g0 • H :=
          leftCoset.of_member with *
        have gIn2 : cosetRepresentative(G, H, C) * h ∈ cosetRepresentative(G, H, C) • H :=
          leftCoset.mul_mem with *
        have gCoset0 : (cosetRepresentative(G, H, C) * h) • H =
            cosetRepresentative(G, H, C) • H := leftCoset.of_member with *
        rw [gCoset0, repCoset, CEq]
        rfl
      have position : cosetRepresentative(G, H, C)⁻¹ * (cosetRepresentative(G, H, C) * h) = h :=
        inv_mul_cancel_left with *
      rw [gCoset, position] at value
      have related := FunctionBetween.relates_apply with function, gIn
      rw value at related
      rwa pEq

theorem cosetSplit.bijective
  shows BijectiveBetween(cosetSplit(G, H), G.carrier, leftCosets(G, H) × H)
proof
  constructor
  . exact cosetSplit.injective with group, subgroup
  . exact cosetSplit.surjective with group, subgroup

theorem Group.equipotent_cosets_product
  shows G.carrier ≃ leftCosets(G, H) × H
proof
  witness cosetSplit(G, H)
  exact cosetSplit.bijective with group, subgroup
end CosetSplit
