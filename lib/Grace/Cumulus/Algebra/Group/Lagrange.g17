-- Lagrange's theorem: the order of a group and the index of a subgroup,
-- every coset in bijection with the subgroup by translation, the cosets a
-- partition of the group, so the order of a finite group is the index times
-- the order of the subgroup, and the order of the subgroup divides it
-- Part of Cumulus, the Grace17 mathematics library.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module Grace.Cumulus.Algebra.Group.Lagrange
import Coset
import Combinatorics.Partitions
import NumberTheory.Divisibility

-- The order of a group is the size of its carrier, and the index of a
-- subgroup the number of its left cosets.
def order (G : Set) : Set := cardinality(G.carrier)
def index (G H : Set) : Set := cardinality(leftCosets(G, H))

theorem order.value (G : Set)
  shows order(G) = cardinality(G.carrier)
proof
  simp [order]

theorem index.value (G H : Set)
  shows index(G, H) = cardinality(leftCosets(G, H))
proof
  simp [index]

theorem order.nat (G : Set)
  requires finite : Finite(G.carrier)
  shows Nat(order(G))
proof
  rw order.value
  exact cardinality.nat with finite

-- Translation by g carries the subgroup onto the coset g • H.
defgraph cosetMap (G H g : Set) (h ∈ H) : g • H := g * h
requires group : Group(G)
requires subgroup : Subgroup(H, G)
requires hg : g ∈ G.carrier
proof
  exact leftCoset.mul_mem with *

section Lagrange
variable (G H : Set)
hypothesis group : Group(G)
hypothesis subgroup : Subgroup(H, G)

-- Every coset is in bijection with the subgroup: h ↦ g * h is injective by
-- cancellation and reaches every member of g • H.
theorem cosetMap.injective (g : G)
  shows InjectiveBetween(cosetMap(G, H, g), H, g • H)
proof
  have function := cosetMap.function at G, H, g with *
  constructor
  . exact function
  . intros x hx y hy z hz hxz hyz
    have xValue := FunctionBetween.apply_value with function, hx, hxz
    have yValue := FunctionBetween.apply_value with function, hy, hyz
    have xImage := cosetMap.value at G, H, g, x with *
    have yImage := cosetMap.value at G, H, g, y with *
    have equal : g * x = g * y by cc
    exact mul_left_cancel with *

theorem cosetMap.surjective (g : G)
  shows SurjectiveBetween(cosetMap(G, H, g), H, g • H)
proof
  have function := cosetMap.function at G, H, g with *
  constructor
  . exact function
  . intros y hy
    obtain ⟨yIn, h, hH, yEq⟩ := leftCoset.membership.forward with hy
    have image := cosetMap.value at G, H, g, h with *
    have related := FunctionBetween.relates_apply with function, hH
    witness h
    constructor
    . exact hH
    . rw [image, ← yEq] at related
      exact related

theorem cosetMap.bijective (g : G)
  shows BijectiveBetween(cosetMap(G, H, g), H, g • H)
proof
  constructor
  . exact cosetMap.injective with *
  . exact cosetMap.surjective with *

theorem leftCoset.equipotent (g : G)
  shows H ≃ g • H
proof
  witness cosetMap(G, H, g)
  exact cosetMap.bijective with *

theorem leftCoset.cardinality (g : G)
  requires finite : Finite(H)
  shows cardinality(g • H) = cardinality(H)
proof
  have bijective := cosetMap.bijective with *
  symm
  exact cardinality.bijective with finite, bijective

-- The cosets partition the group: two cosets are equal or disjoint, and
-- every element lies in its own coset.
theorem leftCoset.eq_or_disjoint (x y : G)
  shows x • H = y • H ∨ Disjoint(x • H, y • H)
proof
  by_contra neither
  apply neither
  right
  apply Disjoint.iff.backward
  intros z hzx hzy
  apply neither
  left
  exact leftCoset.eq_of_common with *

theorem leftCosets.cover
  shows ⋃(leftCosets(G, H)) = G.carrier
proof
  ext x
  constructor
  . intro hx
    obtain ⟨C, hC, hxC⟩ := union.membership.forward with hx
    have bounded := leftCosets.subset_powerset at G, H
    have subset := powerset.membership_iff.forward with (bounded with C, hC)
    exact subset with x, hxC
  . intro hx
    have self : x ∈ x • H := leftCoset.self with *
    have member := leftCosets.coset_member at G, H, x with hx
    exact union.membership.backward with ⟨x • H, member, self⟩

theorem leftCosets.pairwise_disjoint
  shows PairwiseDisjoint(leftCosets(G, H))
proof
  intros C hC D hD different
  obtain ⟨boundC, x, hx, CEq⟩ := leftCosets.membership.forward with hC
  obtain ⟨boundD, y, hy, DEq⟩ := leftCosets.membership.forward with hD
  rw [CEq, DEq] at different
  rw [CEq, DEq]
  have split := leftCoset.eq_or_disjoint at G, H, x, y with *
  cases split with equal | disjoint
  . exfalso
    exact different with equal
  . exact disjoint

theorem leftCosets.member_cardinality (C : Set)
  requires hC : C ∈ leftCosets(G, H)
  requires finite : Finite(H)
  shows cardinality(C) = cardinality(H)
proof
  obtain ⟨bound, g, hg, CEq⟩ := leftCosets.membership.forward with hC
  rw CEq
  exact leftCoset.cardinality with *

-- Finiteness passes from the group to the subgroup, to the cosets, and to
-- the coset space.
theorem Subgroup.finite
  requires finite : Finite(G)
  shows Finite(H)
proof
  exact Finite.subset with finite, (Subgroup.subset with subgroup)

theorem leftCosets.member_finite (C : Set)
  requires hC : C ∈ leftCosets(G, H)
  requires finite : Finite(G)
  shows Finite(C)
proof
  have bounded := leftCosets.subset_powerset at G, H
  have subset := powerset.membership_iff.forward with (bounded with C, hC)
  exact Finite.subset with finite, subset

theorem leftCosets.finite
  requires finite : Finite(G)
  shows Finite(leftCosets(G, H))
proof
  have finitePowerset := Finite.powerset with finite
  exact Finite.subset with finitePowerset, (leftCosets.subset_powerset at G, H)

instance index.nat
  requires finite : Finite(G)
  shows Nat(index(G, H))
proof
  rw index.value
  exact cardinality.nat with (leftCosets.finite with *)

-- Lagrange's theorem: a finite group is the disjoint union of its cosets,
-- each of the size of the subgroup, so its order is the index times the
-- order of the subgroup. The index is a natural number by index.nat, so
-- the product is the natural one.
theorem lagrange
  requires finite : Finite(G)
  shows order(G) = index(G, H) * cardinality(H)
proof
  have finiteH := Subgroup.finite with *
  have finiteCosets := leftCosets.finite with *
  have subgroupNat := cardinality.nat with finiteH
  have cosetsNat := cardinality.nat with finiteCosets
  have indexNat := index.nat with *
  have blocks : ∀ C ∈ leftCosets(G, H), Finite(C)
    intros C hC
    exact leftCosets.member_finite with *
  have sizes : ∀ C ∈ leftCosets(G, H), cardinality(C) = cardinality(H)
    intros C hC
    exact leftCosets.member_cardinality with *
  have disjoint := leftCosets.pairwise_disjoint with *
  calc
    order(G) = cardinality(G) := order.value at G
    _ = cardinality(⋃(leftCosets(G, H))) := by rw leftCosets.cover
    _ = cardinality(leftCosets(G, H)) * cardinality(H) :=
      cardinality.big_union_constant with finiteCosets, blocks, disjoint, sizes
    _ = index(G, H) * cardinality(H) := by rw index.value

-- Lagrange's theorem as divisibility: the index is the quotient.
theorem lagrange.theorem
  requires finite : Finite(G)
  shows cardinality(H) ∣ order(G)
proof
  have subgroupNat := cardinality.nat with (Subgroup.finite with *)
  have indexNat := index.nat with *
  have count := lagrange with *
  witness index(G, H)
  rw count
  exact mul.commutative with *

theorem Subgroup.card_le
  requires finite : Finite(G)
  shows cardinality(H) ≤ order(G)
proof
  rw order.value
  exact cardinality.monotone with finite, (Subgroup.subset with subgroup)

end Lagrange

section Index
variable (G : Set)
hypothesis group : Group(G)

-- The whole group is its only coset, so it has index one; the trivial
-- subgroup has as many cosets as the group has elements.
theorem leftCosets.whole
  shows leftCosets(G, G.carrier) = {G.carrier}
proof
  have subgroup := Subgroup.whole with group
  ext C
  constructor
  . intro hC
    obtain ⟨bound, g, hg, CEq⟩ := leftCosets.membership.forward with hC
    have criterion : g • G.carrier = G.carrier ↔ g ∈ G :=
      leftCoset.eq_self_iff with *
    have whole := criterion.backward with hg
    rw [CEq, whole]
    exact singleton.self
  . intro hC
    have equal := singleton.membership.forward with hC
    have unitIn : G.one ∈ G := Group.one_mem with *
    have one : G.one • G.carrier = G.carrier := leftCoset.one with *
    have member := leftCosets.coset_member at G, G.carrier, G.one with
      unitIn
    rw one at member
    rw equal
    exact member

theorem index.whole
  shows index(G, G.carrier) = 1
proof
  rw [index.value, leftCosets.whole]
  exact cardinality.singleton at G.carrier

theorem index.trivial
  requires finite : Finite(G)
  shows index(G, {G.one}) = order(G)
proof
  have subgroup := Subgroup.trivial with group
  have indexNat := index.nat with *
  have count := lagrange with *
  rw [count, cardinality.singleton, mul.right_unit]
  rfl

end Index
