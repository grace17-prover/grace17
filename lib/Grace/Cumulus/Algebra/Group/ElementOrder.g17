-- Orders of elements in finite groups: every element of a finite group
-- has finite order, the cyclic subgroup it generates has exactly that
-- many elements, so by Lagrange the order divides the order of the group
-- and the group order annihilates every element
-- Part of Cumulus, the Grace17 mathematics library.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module Grace.Cumulus.Algebra.Group.ElementOrder
import Cyclic
import Cardinal.Dominance

section Orders
variable (G : Set)
hypothesis group : Group(G)

theorem pow_eq_one_of_pow_add_eq (g : G) (m k : Nat)
  requires equal : g ^ (m + k) = g ^ m
  shows g ^ k = G.one
proof
  have split : g ^ (m + k) = g ^ m * g ^ k := pow_add with *
  have products : g ^ m * g ^ k = g ^ m * G.one
    rw [← split, equal, mul_one]
    rfl
  exact mul_left_cancel at G, g ^ m, g ^ k, G.one with *

theorem HasFiniteOrder.of_pow_eq (g : G) (m n : Nat)
  requires below : m < n
  requires equal : g ^ m = g ^ n
  shows HasFiniteOrder(G, g)
proof
  obtain ⟨j, jNat, shape⟩ := below
  have form : m + succ(j) = n
    rw ← shape
    exact add.successor_shift at m, j
  have shifted : g ^ (m + succ(j)) = g ^ m by cc
  have vanishes : g ^ succ(j) = G.one := pow_eq_one_of_pow_add_eq with *
  have positive : 0 < succ(j) by arith
  exact HasFiniteOrder.of_pow with positive, vanishes

end Orders

-- Powers as a function on the naturals.
defgraph powerMap (G g : Set) (n ∈ ℕ) : G.carrier := groupPow(G, g, n)
requires group : Group(G)
requires hg : g ∈ G.carrier
proof
  have nNat := nat.omega.backward with member
  exact Group.pow_mem with group, hg, nNat

-- The exponents below the order enumerate the cyclic subgroup.
defgraph orderMap (G g : Set) (n ∈ elementOrder(G, g)) : powers(G, g) := groupPow(G, g, n)
requires group : Group(G)
requires hg : g ∈ G.carrier
requires finite : HasFiniteOrder(G, g)
proof
  have natural := elementOrder.natural with finite
  have nNat := natural.member at elementOrder(G, g) with n, member
  exact powers.pow_mem with group, hg, nNat

section FiniteOrders
variable (G : Set)
hypothesis group : Group(G)

theorem powerMap.injective_of_infinite_order (g : G)
  requires infinite : ¬HasFiniteOrder(G, g)
  shows InjectiveBetween(powerMap(G, g), ℕ, G.carrier)
proof
  have function := powerMap.function at G, g with *
  constructor
  . exact function
  . intros m hm n hn z hz hmz hnz
    have mNat := nat.omega.backward with hm
    have nNat := nat.omega.backward with hn
    have vm := FunctionBetween.apply_value with function, hm, hmz
    have vn := FunctionBetween.apply_value with function, hn, hnz
    have valueM := powerMap.value at G, g, m with *
    have valueN := powerMap.value at G, g, n with *
    have equal : g ^ m = g ^ n by cc
    have comparison := Less.trichotomy at m, n with mNat, nNat
    rcases comparison with less | same | greater
    . exfalso
      have finite := HasFiniteOrder.of_pow_eq at G, g, m, n with *
      exact infinite with finite
    . exact same
    . exfalso
      have reversed : g ^ n = g ^ m by cc
      have finite := HasFiniteOrder.of_pow_eq at G, g, n, m with *
      exact infinite with finite

-- Every element of a finite group has finite order.
theorem Group.finite_order (g : G)
  requires finite : Finite(G)
  shows HasFiniteOrder(G, g)
proof
  by_contra
  have injective := powerMap.injective_of_infinite_order with *
  have dominated := Dominated.of_injective with injective
  have finiteNaturals := Finite.of_dominated with finite, dominated
  exact omega.infinite with finiteNaturals

theorem elementOrder.le_of_pow_eq (g : G) (m n : Nat)
  requires finite : HasFiniteOrder(G, g)
  requires below : m < n
  requires equal : g ^ m = g ^ n
  shows elementOrder(G, g) ≤ n
proof
  have natural := elementOrder.natural with finite
  obtain ⟨j, jNat, shape⟩ := below
  have form : m + succ(j) = n
    rw ← shape
    exact add.successor_shift at m, j
  have shifted : g ^ (m + succ(j)) = g ^ m by cc
  have vanishes : g ^ succ(j) = G.one := pow_eq_one_of_pow_add_eq with *
  have positive : 0 < succ(j) by arith
  have least := elementOrder.least with finite, positive, vanishes
  have bound : succ(j) ≤ n
    witness m
    rw ← form
    ring
  exact LessEqual.transitive with least, bound

-- Below the order, distinct exponents give distinct powers.
theorem elementOrder.pow_injective_below (g : G) (m n : Nat)
  requires finite : HasFiniteOrder(G, g)
  requires mBelow : m < elementOrder(G, g)
  requires nBelow : n < elementOrder(G, g)
  requires equal : g ^ m = g ^ n
  shows m = n
proof
  have natural := elementOrder.natural with finite
  have mNat : Nat(m) by typecheck
  have nNat : Nat(n) by typecheck
  have comparison := Less.trichotomy at m, n with mNat, nNat
  rcases comparison with less | same | greater
  . exfalso
    have bound := elementOrder.le_of_pow_eq at G, g, m, n with *
    have strict := LessEqual.transitive_Less with bound, nBelow
    exact Less.irreflexive with strict
  . exact same
  . exfalso
    have reversed : g ^ n = g ^ m by cc
    have bound := elementOrder.le_of_pow_eq at G, g, n, m with *
    have strict := LessEqual.transitive_Less with bound, mBelow
    exact Less.irreflexive with strict

theorem orderMap.injective (g : G)
  requires finite : HasFiniteOrder(G, g)
  shows InjectiveBetween(orderMap(G, g), elementOrder(G, g), powers(G, g))
proof
  have natural := elementOrder.natural with finite
  have function := orderMap.function at G, g with *
  constructor
  . exact function
  . intros m hm n hn z hz hmz hnz
    have mNat := natural.member at elementOrder(G, g) with m, hm
    have nNat := natural.member at elementOrder(G, g) with n, hn
    have mBelow := Less.of_membership at m, elementOrder(G, g) with hm
    have nBelow := Less.of_membership at n, elementOrder(G, g) with hn
    have vm := FunctionBetween.apply_value with function, hm, hmz
    have vn := FunctionBetween.apply_value with function, hn, hnz
    have valueM := orderMap.value at G, g, m with *
    have valueN := orderMap.value at G, g, n with *
    have equal : g ^ m = g ^ n by cc
    exact elementOrder.pow_injective_below with *

theorem orderMap.surjective (g : G)
  requires finite : HasFiniteOrder(G, g)
  shows SurjectiveBetween(orderMap(G, g), elementOrder(G, g), powers(G, g))
proof
  have natural := elementOrder.natural with finite
  have nonzero := elementOrder.nonzero with finite
  have function := orderMap.function at G, g with *
  constructor
  . exact function
  . intros y hy
    obtain ⟨yIn, n, nIn, yEq⟩ := powers.membership.forward with hy
    have nNat := nat.omega.backward with nIn
    have remainderNat : Nat(n % elementOrder(G, g)) by typecheck
    have below := mod.less at n, elementOrder(G, g) with nonzero
    have member := membership.of_Less with remainderNat, natural, below
    have reduced : g ^ n = g ^ (n % elementOrder(G, g)) := elementOrder.pow_mod with *
    have value := orderMap.value at G, g, n % elementOrder(G, g) with *
    have edge := FunctionBetween.relates_apply with function, member
    refine ⟨n % elementOrder(G, g), member, ?_⟩
    rw [value, ← reduced] at edge
    rw yEq
    exact edge

theorem orderMap.bijective (g : G)
  requires finite : HasFiniteOrder(G, g)
  shows BijectiveBetween(orderMap(G, g), elementOrder(G, g), powers(G, g))
proof
  constructor
  . exact orderMap.injective with *
  . exact orderMap.surjective with *

theorem powers.has_cardinality (g : G)
  requires finite : HasFiniteOrder(G, g)
  shows HasCardinality(powers(G, g), elementOrder(G, g))
proof
  have natural := elementOrder.natural with finite
  have bijective := orderMap.bijective with *
  have equipotent : Equipotent(elementOrder(G, g), powers(G, g))
    witness orderMap(G, g)
    exact bijective
  have reversed := Equipotent.symmetric with equipotent
  unfold HasCardinality
  exact ⟨natural, reversed⟩

theorem powers.cardinality (g : G)
  requires finite : HasFiniteOrder(G, g)
  shows cardinality(powers(G, g)) = elementOrder(G, g)
proof
  have hasCardinality := powers.has_cardinality with *
  exact cardinality.eq_of_has with hasCardinality

theorem powers.finite (g : G)
  requires finite : HasFiniteOrder(G, g)
  shows Finite(powers(G, g))
proof
  have hasCardinality := powers.has_cardinality with *
  exact Finite.from_cardinality with hasCardinality

-- The order of an element divides the order of the group.
theorem elementOrder.dvd_card (g : G)
  requires finite : Finite(G)
  shows elementOrder(G, g) ∣ cardinality(G)
proof
  have finiteOrder := Group.finite_order with *
  have subgroup := powers.subgroup with *
  have divides := lagrange.theorem with group, subgroup, finite
  have same := powers.cardinality with *
  rw order.value at divides
  rwa same at divides

theorem Group.pow_card (g : G)
  requires finite : Finite(G)
  shows g ^ cardinality(G) = G.one
proof
  have finiteOrder := Group.finite_order with *
  have cardNat := cardinality.nat with finite
  have divides := elementOrder.dvd_card with *
  exact elementOrder.pow_eq_one_of_dvd at G, g, cardinality(G) with *

theorem elementOrder.le_card (g : G)
  requires finite : Finite(G)
  shows elementOrder(G, g) ≤ cardinality(G)
proof
  have finiteOrder := Group.finite_order with *
  have natural := elementOrder.natural with finiteOrder
  have cardNat := cardinality.nat with finite
  have subgroup := powers.subgroup with *
  have subset := Subgroup.subset with subgroup
  have bound := cardinality.monotone with finite, subset
  have same := powers.cardinality with *
  rwa same at bound

end FiniteOrders
