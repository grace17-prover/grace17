-- Decompositions transfer between a set and an invariant subset, so a set
-- equidecomposable with a paradoxical invariant subset is paradoxical
-- Part of Cumulus, the Grace17 mathematics library.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module Grace.Cumulus.Algebra.Group.Paradox.Transfer
import Algebra.Group.Paradox
import Algebra.Group.Action.Restrict

section Transfer
variable (act G X : Set)
hypothesis action : act : G ↷ X

-- The image of a subset of Y under g is the same under the restricted
-- action, and so is every moved piece.
theorem translate.restrict (Y g S : Set)
  requires subset : Y ⊆ X
  requires invariant : ∀ g ∈ G.carrier, ∀ y ∈ Y, g ·ₐ y ∈ Y
  requires hg : g ∈ G.carrier
  requires bounded : S ⊆ Y
  shows translate(act, X, g, S) = translate(restrictAction(act, G, Y), Y, g, S)
proof
  ext y
  constructor
  . intro hy
    obtain ⟨yIn, x, hx, equal⟩ := translate.membership.forward with hy
    have xIn := bounded with x, hx
    have value := restrictAction.apply with action, subset, invariant, hg, xIn
    have moved := invariant with g, hg, x, xIn
    rw ← equal at moved
    rw ← value at equal
    exact translate.membership.backward with ⟨moved, x, hx, equal⟩
  . intro hy
    obtain ⟨yIn, x, hx, equal⟩ := translate.membership.forward with hy
    have xIn := bounded with x, hx
    have value := restrictAction.apply with action, subset, invariant, hg, xIn
    rw value at equal
    have inX := subset with y, yIn
    exact translate.membership.backward with ⟨inX, x, hx, equal⟩

theorem moved.restrict (Y p : Set)
  requires subset : Y ⊆ X
  requires invariant : ∀ g ∈ G.carrier, ∀ y ∈ Y, g ·ₐ y ∈ Y
  requires hp : p ∈ 𝒫(Y) × G.carrier
  shows moved(act, X, p) = moved(restrictAction(act, G, Y), Y, p)
proof
  obtain ⟨bound, S, hS, g, hg, shape⟩ := product.membership.forward with hp
  have bounded := powerset.membership_iff.forward with hS
  rw [shape, moved.value, moved.value]
  exact translate.restrict with action, subset, invariant, hg, bounded

-- A decomposition under the restricted action is a decomposition under
-- the action on X.
theorem Equidecomposable.of_restrict (Y A B : Set)
  requires subset : Y ⊆ X
  requires invariant : ∀ g ∈ G.carrier, ∀ y ∈ Y, g ·ₐ y ∈ Y
  requires boundedA : A ⊆ Y
  requires boundedB : B ⊆ Y
  requires restricted : Equidecomposable(restrictAction(act, G, Y), G, Y, A, B)
  shows Equidecomposable(act, G, X, A, B)
proof
  obtain ⟨F, finite, bounded, pieces, movedPieces⟩ := restricted
  obtain ⟨movedBounded, movedCover, movedDisjoint⟩ := movedPieces
  have powersets := powerset.monotone with subset
  have pairs : 𝒫(Y) × G.carrier ⊆ 𝒫(X) × G.carrier :=
    product.monotone with powersets, (Subset.reflexive at G.carrier)
  have boundedX := Subset.transitive with bounded, pairs
  have moves : ∀ p ∈ F,
      moved(act, X, p) = moved(restrictAction(act, G, Y), Y, p)
    intros p hp
    exact moved.restrict with action, subset, invariant, (bounded with p, hp)
  witness F
  refine ⟨finite, boundedX, pieces, ?_⟩
  refine ⟨?_, ?_, ?_⟩
  . intros p hp
    have move := moves with p, hp
    rw move
    exact movedBounded with p, hp
  . intros y hy
    obtain ⟨p, hp, member⟩ := movedCover with y, hy
    have move := moves with p, hp
    witness p
    rw move
    exact ⟨hp, member⟩
  . intros p hp q hq different
    have moveP := moves with p, hp
    have moveQ := moves with q, hq
    rw [moveP, moveQ]
    exact movedDisjoint with p, hp, q, hq, different

-- A paradoxical invariant subset Y of X has two disjoint subsets each
-- equidecomposable with Y under the action on X.
theorem Paradoxical.of_restrict (Y : Set)
  requires subset : Y ⊆ X
  requires invariant : ∀ g ∈ G.carrier, ∀ y ∈ Y, g ·ₐ y ∈ Y
  requires paradoxical : Paradoxical(restrictAction(act, G, Y), G, Y)
  shows ∃ A, ∃ B, A ⊆ Y ∧ B ⊆ Y ∧ Disjoint(A, B) ∧
    Equidecomposable(act, G, X, A, Y) ∧ Equidecomposable(act, G, X, B, Y)
proof
  obtain ⟨A, B, boundedA, boundedB, disjoint, firstA, secondB⟩ :=
    paradoxical
  have whole := Subset.reflexive at Y
  witness A
  witness B
  refine ⟨boundedA, boundedB, disjoint, ?_, ?_⟩
  . exact Equidecomposable.of_restrict with
      action, subset, invariant, boundedA, whole, firstA
  . exact Equidecomposable.of_restrict with
      action, subset, invariant, boundedB, whole, secondB

-- A set equidecomposable with a subset carrying two disjoint pieces each
-- equidecomposable with that subset is paradoxical.
theorem Paradoxical.of_equidecomposable (Y : Set)
  requires subset : Y ⊆ X
  requires whole : Equidecomposable(act, G, X, X, Y)
  requires pieces : ∃ A, ∃ B, A ⊆ Y ∧ B ⊆ Y ∧ Disjoint(A, B) ∧
    Equidecomposable(act, G, X, A, Y) ∧ Equidecomposable(act, G, X, B, Y)
  shows Paradoxical(act, G, X)
proof
  obtain ⟨A, B, boundedA, boundedB, disjoint, firstA, secondB⟩ := pieces
  have back : Equidecomposable(act, G, X, Y, X) :=
    Equidecomposable.symmetric with action, whole
  have inA := Subset.transitive with boundedA, subset
  have inB := Subset.transitive with boundedB, subset
  witness A
  witness B
  refine ⟨inA, inB, disjoint, ?_, ?_⟩
  . exact Equidecomposable.transitive with action, firstA, back
  . exact Equidecomposable.transitive with action, secondB, back

-- Conversely, a decomposition in X of subsets of Y whose moved pieces
-- stay inside Y is a decomposition under the restricted action; the
-- restriction need not be an action for this (restrictAction.value).
theorem translate.restrict_of_bounded (Y g S : Set)
  requires subset : Y ⊆ X
  requires hg : g ∈ G.carrier
  requires bounded : S ⊆ Y
  requires image : translate(act, X, g, S) ⊆ Y
  shows translate(restrictAction(act, G, Y), Y, g, S) = translate(act, X, g, S)
proof
  ext y
  constructor
  . intro hy
    obtain ⟨yIn, x, hx, equal⟩ := translate.membership.forward with hy
    have xIn := bounded with x, hx
    have value := restrictAction.value with action, subset, hg, xIn
    rw value at equal
    have inX := subset with y, yIn
    exact translate.membership.backward with ⟨inX, x, hx, equal⟩
  . intro hy
    have yIn := image with y, hy
    obtain ⟨inX, x, hx, equal⟩ := translate.membership.forward with hy
    have xIn := bounded with x, hx
    have value := restrictAction.value with action, subset, hg, xIn
    rw ← value at equal
    exact translate.membership.backward with ⟨yIn, x, hx, equal⟩

theorem moved.restrict_of_bounded (Y p : Set)
  requires subset : Y ⊆ X
  requires hp : p ∈ 𝒫(X) × G.carrier
  requires piece : fst(p) ⊆ Y
  requires image : moved(act, X, p) ⊆ Y
  shows moved(restrictAction(act, G, Y), Y, p) = moved(act, X, p)
proof
  obtain ⟨bound, S, hS, g, hg, shape⟩ := product.membership.forward with hp
  rw [shape, fst.pair] at piece
  rw [shape, moved.value] at image
  rw [shape, moved.value, moved.value]
  exact translate.restrict_of_bounded with action, subset, hg, piece, image

theorem Equidecomposable.to_restrict (Y A B : Set)
  requires subset : Y ⊆ X
  requires boundedA : A ⊆ Y
  requires boundedB : B ⊆ Y
  requires equidecomposable : Equidecomposable(act, G, X, A, B)
  shows Equidecomposable(restrictAction(act, G, Y), G, Y, A, B)
proof
  obtain ⟨F, finite, bounded, pieces, movedPieces⟩ := equidecomposable
  obtain ⟨piecesBounded, piecesCover, piecesDisjoint⟩ := pieces
  obtain ⟨movedBounded, movedCover, movedDisjoint⟩ := movedPieces
  have boundedY : F ⊆ 𝒫(Y) × G.carrier
    intros p hp
    obtain ⟨bound, S, hS, g, hg, shape⟩ :=
        product.membership.forward with (bounded with p, hp)
    have piece := piecesBounded with p, hp
    rw [shape, fst.pair] at piece
    have inY := powerset.membership_iff.backward with (Subset.transitive
        with piece, boundedA)
    rw shape
    exact product.pair with inY, hg
  have moves : ∀ p ∈ F,
      moved(restrictAction(act, G, Y), Y, p) = moved(act, X, p)
    intros p hp
    have piece := Subset.transitive with (piecesBounded with p, hp), boundedA
    have image := Subset.transitive with (movedBounded with p, hp), boundedB
    exact moved.restrict_of_bounded with action, subset, (bounded with p, hp),
        piece, image
  witness F
  refine ⟨finite, boundedY, pieces, ?_⟩
  refine ⟨?_, ?_, ?_⟩
  . intros p hp
    have move := moves with p, hp
    rw move
    exact movedBounded with p, hp
  . intros y hy
    obtain ⟨p, hp, member⟩ := movedCover with y, hy
    have move := moves with p, hp
    witness p
    rw move
    exact ⟨hp, member⟩
  . intros p hp q hq different
    have moveP := moves with p, hp
    have moveQ := moves with q, hq
    rw [moveP, moveQ]
    exact movedDisjoint with p, hp, q, hq, different

theorem Paradoxical.to_restrict (Y : Set)
  requires subset : Y ⊆ X
  requires pieces : ∃ A, ∃ B, A ⊆ Y ∧ B ⊆ Y ∧ Disjoint(A, B) ∧
    Equidecomposable(act, G, X, A, Y) ∧ Equidecomposable(act, G, X, B, Y)
  shows Paradoxical(restrictAction(act, G, Y), G, Y)
proof
  obtain ⟨A, B, boundedA, boundedB, disjoint, firstA, secondB⟩ := pieces
  have whole := Subset.reflexive at Y
  witness A
  witness B
  refine ⟨boundedA, boundedB, disjoint, ?_, ?_⟩
  . exact Equidecomposable.to_restrict with action, subset, boundedA, whole,
      firstA
  . exact Equidecomposable.to_restrict with action, subset, boundedB, whole,
      secondB

end Transfer
