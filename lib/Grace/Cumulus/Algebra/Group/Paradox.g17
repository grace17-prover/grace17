-- Paradoxical decompositions: two subsets of a set with a group action are
-- equidecomposable when finitely many pairwise disjoint pieces of the one
-- are carried by group elements onto pairwise disjoint pieces of the
-- other; a set is paradoxical when two disjoint subsets of it are each
-- equidecomposable with it. Equidecomposability is an equivalence relation
-- respecting disjoint unions, and the transfer theorem: a set with a free
-- action of a group containing the free group on two generators is
-- paradoxical, by choosing one point in each orbit
-- Part of Cumulus, the Grace17 mathematics library.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module Grace.Cumulus.Algebra.Group.Paradox
import FreeGroup
import Action
import Set.ChoiceFunctions

-- The image of a set S of points under a group element g, and the image
-- of a set M of points under a set H of group elements.
def translate (act X g S : Set) : Set := { y ∈ X | ∃ x ∈ S, y = act(g, x) }
def sweep (act X H M : Set) : Set :=
  { y ∈ X | ∃ g ∈ H, ∃ x ∈ M, y = act(g, x) }

-- A decomposition is a finite family F of pairs (S, g) of a piece and a
-- group element. Pieces(A, F) says the pieces are pairwise disjoint and
-- cover A; moved(act, X, p) is the image of the piece of p under its
-- element, and MovedPieces(act, X, B, F) says the moved pieces are
-- pairwise disjoint and cover B.
def moved (act X p : Set) : Set := translate(act, X, snd(p), fst(p))

predicate Pieces (A F : Set) :=
  (∀ p ∈ F, fst(p) ⊆ A) ∧ (∀ x ∈ A, ∃ p ∈ F, x ∈ fst(p)) ∧
  (∀ p q ∈ F, p ≠ q → Disjoint(fst(p), fst(q)))

predicate MovedPieces (act X B F : Set) :=
  (∀ p ∈ F, moved(act, X, p) ⊆ B) ∧ (∀ y ∈ B, ∃ p ∈ F, y ∈ moved(act, X, p)) ∧
  (∀ p q ∈ F, p ≠ q → Disjoint(moved(act, X, p), moved(act, X, q)))

-- A and B are equidecomposable under the action act of G on X; X is
-- paradoxical when two disjoint subsets are each equidecomposable with X;
-- the action is free when every stabilizer is trivial.
predicate Equidecomposable (act G X A B : Set) :=
  ∃ F, Finite(F) ∧ F ⊆ 𝒫(X) × Group.carrier(G) ∧ Pieces(A, F) ∧
    MovedPieces(act, X, B, F)

predicate Paradoxical (act G X : Set) :=
  ∃ A, ∃ B, A ⊆ X ∧ B ⊆ X ∧ Disjoint(A, B) ∧
    Equidecomposable(act, G, X, A, X) ∧ Equidecomposable(act, G, X, B, X)

predicate FreeAction (act G X : Set) :=
  ∀ x ∈ X, stabilizer(act, G, X, x) = {Group.one(G)}

-- One chosen point in each orbit, through a choice function c on the
-- subsets of X.
def representatives (act G X c : Set) : Set := { c(O) | O ∈ orbits(act, G, X) }

theorem moved.value (act X S g : Set)
  shows moved(act, X, (S, g)) = translate(act, X, g, S)
proof
  simp [moved, fst.pair, snd.pair]

theorem moved.unfold (act X p : Set)
  shows moved(act, X, p) = translate(act, X, snd(p), fst(p))
proof
  simp [moved]

theorem translate.subset (act X g S : Set)
  shows translate(act, X, g, S) ⊆ X
proof
  intros y hy
  have parts := translate.membership.forward with hy
  exact parts.left

theorem sweep.subset (act X H M : Set)
  shows sweep(act, X, H, M) ⊆ X
proof
  intros y hy
  have parts := sweep.membership.forward with hy
  exact parts.left

-- Translating by different elements or actions agreeing on S gives the
-- same image.
theorem translate.congr (act act2 X g h S : Set)
  requires agree : ∀ x ∈ S, act(g, x) = act2(h, x)
  shows translate(act, X, g, S) = translate(act2, X, h, S)
proof
  ext y
  constructor
  . intro hy
    obtain ⟨yIn, x, hx, equal⟩ := translate.membership.forward with hy
    have same := agree with x, hx
    rw same at equal
    exact translate.membership.backward with ⟨yIn, x, hx, equal⟩
  . intro hy
    obtain ⟨yIn, x, hx, equal⟩ := translate.membership.forward with hy
    have same := agree with x, hx
    rw ← same at equal
    exact translate.membership.backward with ⟨yIn, x, hx, equal⟩

theorem translate.monotone (act X g S T : Set)
  requires subset : S ⊆ T
  shows translate(act, X, g, S) ⊆ translate(act, X, g, T)
proof
  intros y hy
  obtain ⟨yIn, x, hx, equal⟩ := translate.membership.forward with hy
  exact translate.membership.backward with ⟨yIn, x, (subset with x, hx), equal⟩

theorem translate.union2 (act X g S T : Set)
  shows translate(act, X, g, S ∪ T) = translate(act, X, g, S) ∪ translate(act, X, g, T)
proof
  ext y
  constructor
  . intro hy
    obtain ⟨yIn, x, hx, equal⟩ := translate.membership.forward with hy
    have split := union2.membership.forward with hx
    cases split with inS | inT
    . apply union2.membership.backward
      left
      exact translate.membership.backward with ⟨yIn, x, inS, equal⟩
    . apply union2.membership.backward
      right
      exact translate.membership.backward with ⟨yIn, x, inT, equal⟩
  . intro hy
    have split := union2.membership.forward with hy
    cases split with inS | inT
    . obtain ⟨yIn, x, hx, equal⟩ := translate.membership.forward with inS
      have member := union2.subset_left at S, T with x, hx
      exact translate.membership.backward with ⟨yIn, x, member, equal⟩
    . obtain ⟨yIn, x, hx, equal⟩ := translate.membership.forward with inT
      have member := union2.subset_right at S, T with x, hx
      exact translate.membership.backward with ⟨yIn, x, member, equal⟩

section TranslateLaws
variable (act G X : Set)
hypothesis action : act : G ↷ X

instance translate.act_mem (g : G) (S x : Set)
  requires bounded : S ⊆ X
  requires hx : x ∈ S
  shows g ·ₐ x ∈ translate(act, X, g, S)
proof
  have xIn := bounded with x, hx
  have moved : g ·ₐ x ∈ X := Action.act_mem with *
  exact translate.membership.backward with ⟨moved, x, hx, rfl⟩

theorem translate.one (S : Set)
  requires bounded : S ⊆ X
  shows translate(act, X, G.one, S) = S
proof
  have group := Action.group with action
  ext y
  constructor
  . intro hy
    obtain ⟨yIn, x, hx, equal⟩ := translate.membership.forward with hy
    have xIn := bounded with x, hx
    have fixed : G.one ·ₐ x = x := one_act with *
    rw [equal, fixed]
    exact hx
  . intro hy
    have yIn := bounded with y, hy
    have fixed : G.one ·ₐ y = y := one_act with *
    have member : G.one ·ₐ y ∈ translate(act, X, G.one, S) := translate.act_mem with *
    rwa fixed at member

theorem translate.mul (g h : G) (S : Set)
  requires bounded : S ⊆ X
  shows translate(act, X, g * h, S) = translate(act, X, g, translate(act, X, h, S))
proof
  have group := Action.group with action
  have inner := translate.subset at act, X, h, S
  ext y
  constructor
  . intro hy
    obtain ⟨yIn, x, hx, equal⟩ := translate.membership.forward with hy
    have xIn := bounded with x, hx
    have merged : (g * h) ·ₐ x = g ·ₐ h ·ₐ x := mul_act with *
    have step : h ·ₐ x ∈ translate(act, X, h, S) := translate.act_mem with *
    have member : g ·ₐ h ·ₐ x ∈ translate(act, X, g, translate(act, X, h, S)) :=
      translate.act_mem with *
    rw [equal, merged]
    exact member
  . intro hy
    obtain ⟨yIn, z, hz, equal⟩ := translate.membership.forward with hy
    obtain ⟨zIn, x, hx, zEq⟩ := translate.membership.forward with hz
    have xIn := bounded with x, hx
    have merged : (g * h) ·ₐ x = g ·ₐ h ·ₐ x := mul_act with *
    rw [equal, zEq, ← merged]
    exact translate.act_mem with *

theorem translate.inv_translate (g : G) (S : Set)
  requires bounded : S ⊆ X
  shows translate(act, X, g⁻¹, translate(act, X, g, S)) = S
proof
  have group := Action.group with action
  have merged := translate.mul at act, G, X, g⁻¹, g, S with *
  rw [← merged, Group.inv_mul]
  exact translate.one with *

theorem translate.translate_inv (g : G) (S : Set)
  requires bounded : S ⊆ X
  shows translate(act, X, g, translate(act, X, g⁻¹, S)) = S
proof
  have group := Action.group with action
  have merged := translate.mul at act, G, X, g, g⁻¹, S with *
  rw [← merged, Group.mul_inv]
  exact translate.one with *

theorem translate.mem_iff (g : G) (S y : Set)
  requires bounded : S ⊆ X
  requires hy : y ∈ X
  shows y ∈ translate(act, X, g, S) ↔ g⁻¹ ·ₐ y ∈ S
proof
  have group := Action.group with action
  constructor
  . intro member
    obtain ⟨yIn, x, hx, equal⟩ := translate.membership.forward with member
    have xIn := bounded with x, hx
    have back : g⁻¹ ·ₐ g ·ₐ x = x := inv_act_cancel with *
    rw [equal, back]
    exact hx
  . intro member
    have moved : g ·ₐ g⁻¹ ·ₐ y ∈ translate(act, X, g, S) := translate.act_mem with *
    have cancel : g ·ₐ g⁻¹ ·ₐ y = y := act_inv_cancel with *
    rwa cancel at moved

theorem translate.disjoint (g : G) (S T : Set)
  requires boundedS : S ⊆ X
  requires boundedT : T ⊆ X
  requires disjoint : Disjoint(S, T)
  shows Disjoint(translate(act, X, g, S), translate(act, X, g, T))
proof
  have group := Action.group with action
  have apart := Disjoint.iff.forward with disjoint
  apply Disjoint.iff.backward
  intros y hyS hyT
  have yIn := translate.subset at act, X, g, S with y, hyS
  have inS := translate.mem_iff.forward with action, boundedS, yIn, hyS
  have inT := translate.mem_iff.forward with action, boundedT, yIn, hyT
  exact apart with g⁻¹ ·ₐ y, inS, inT

theorem translate.intersection (g : G) (S T : Set)
  requires boundedS : S ⊆ X
  requires boundedT : T ⊆ X
  shows translate(act, X, g, S ∩ T) = translate(act, X, g, S) ∩ translate(act, X, g, T)
proof
  have group := Action.group with action
  have boundedST := Subset.transitive with (intersection.subset_left at S, T), boundedS
  ext y
  constructor
  . intro hy
    have yIn := translate.subset at act, X, g, S ∩ T with y, hy
    have inST := translate.mem_iff.forward with action, boundedST, yIn, hy
    obtain ⟨inS, inT⟩ := intersection.membership.forward with inST
    have left := translate.mem_iff.backward with action, boundedS, yIn, inS
    have right := translate.mem_iff.backward with action, boundedT, yIn, inT
    exact intersection.membership.backward with ⟨left, right⟩
  . intro hy
    obtain ⟨hyS, hyT⟩ := intersection.membership.forward with hy
    have yIn := translate.subset at act, X, g, S with y, hyS
    have inS := translate.mem_iff.forward with action, boundedS, yIn, hyS
    have inT := translate.mem_iff.forward with action, boundedT, yIn, hyT
    have inST := intersection.membership.backward at
      S, T, g⁻¹ ·ₐ y with ⟨inS, inT⟩
    exact translate.mem_iff.backward with action, boundedST, yIn, inST

end TranslateLaws

-- A decomposition with two pieces.
theorem Equidecomposable.of_two_pieces (act G X A B S T g h : Set)
  requires action : act : G ↷ X
  requires hg : g ∈ Group.carrier(G)
  requires hh : h ∈ Group.carrier(G)
  requires boundedS : S ⊆ X
  requires boundedT : T ⊆ X
  requires disjoint : Disjoint(S, T)
  requires cover : S ∪ T = A
  requires disjointImages : Disjoint(translate(act, X, g, S), translate(act, X, h, T))
  requires coverImages : translate(act, X, g, S) ∪ translate(act, X, h, T) = B
  shows Equidecomposable(act, G, X, A, B)
proof
  have first : (S, g) ∈ 𝒫(X) × G.carrier :=
    product.pair with (powerset.membership_iff.backward with boundedS), hg
  have second : (T, h) ∈ 𝒫(X) × G.carrier :=
    product.pair with (powerset.membership_iff.backward with boundedT), hh
  have movedS := moved.value at act, X, S, g
  have movedT := moved.value at act, X, T, h
  have members : ∀ p ∈ insert((S, g), {(T, h)}), p = (S, g) ∨ p = (T, h)
    intros p hp
    have split := insert.membership.forward with hp
    cases split with left | right
    . left
      exact left
    . right
      exact singleton.membership.forward with right
  have firstIn : (S, g) ∈ insert((S, g), {(T, h)}) := insert.self
  have secondIn : (T, h) ∈ insert((S, g), {(T, h)}) :=
    insert.contains with (singleton.self at (T, h))
  witness insert((S, g), {(T, h)})
  refine ⟨?_, ?_, ?_, ?_⟩
  . exact Finite.insert with (Finite.singleton at (T, h))
  . intros p hp
    have split := members with p, hp
    cases split with left | right
    . rw left
      exact first
    . rw right
      exact second
  . refine ⟨?_, ?_, ?_⟩
    . intros p hp
      have split := members with p, hp
      cases split with left | right
      . rw [left, fst.pair, ← cover]
        exact union2.subset_left at S, T
      . rw [right, fst.pair, ← cover]
        exact union2.subset_right at S, T
    . intros x hx
      rw ← cover at hx
      have split := union2.membership.forward with hx
      cases split with inS | inT
      . witness (S, g)
        rw fst.pair
        exact ⟨firstIn, inS⟩
      . witness (T, h)
        rw fst.pair
        exact ⟨secondIn, inT⟩
    . intros p hp q hq different
      have splitP := members with p, hp
      have splitQ := members with q, hq
      cases splitP with pFirst | pSecond
      . cases splitQ with qFirst | qSecond
        . exfalso
          apply different
          rw [pFirst, qFirst]
          rfl
        . rw [pFirst, qSecond, fst.pair, fst.pair]
          exact disjoint
      . cases splitQ with qFirst | qSecond
        . rw [pSecond, qFirst, fst.pair, fst.pair]
          exact Disjoint.symmetric with disjoint
        . exfalso
          apply different
          rw [pSecond, qSecond]
          rfl
  . refine ⟨?_, ?_, ?_⟩
    . intros p hp
      have split := members with p, hp
      cases split with left | right
      . rw [left, movedS, ← coverImages]
        exact union2.subset_left at translate(act, X, g, S), translate(act, X, h, T)
      . rw [right, movedT, ← coverImages]
        exact union2.subset_right at translate(act, X, g, S), translate(act, X, h, T)
    . intros y hy
      rw ← coverImages at hy
      have split := union2.membership.forward with hy
      cases split with inS | inT
      . witness (S, g)
        rw movedS
        exact ⟨firstIn, inS⟩
      . witness (T, h)
        rw movedT
        exact ⟨secondIn, inT⟩
    . intros p hp q hq different
      have splitP := members with p, hp
      have splitQ := members with q, hq
      cases splitP with pFirst | pSecond
      . cases splitQ with qFirst | qSecond
        . exfalso
          apply different
          rw [pFirst, qFirst]
          rfl
        . rw [pFirst, qSecond, movedS, movedT]
          exact disjointImages
      . cases splitQ with qFirst | qSecond
        . rw [pSecond, qFirst, movedS, movedT]
          exact Disjoint.symmetric with disjointImages
        . exfalso
          apply different
          rw [pSecond, qSecond]
          rfl

section Equivalence
variable (act G X : Set)
hypothesis action : act : G ↷ X

-- Equidecomposability is reflexive.
theorem Equidecomposable.reflexive (A : Set)
  requires bounded : A ⊆ X
  shows Equidecomposable(act, G, X, A, A)
proof
  have group := Action.group with action
  have unitIn : G.one ∈ G := Group.one_mem with *
  have pair : (A, G.one) ∈ 𝒫(X) × G.carrier :=
    product.pair with (powerset.membership_iff.backward with bounded), unitIn
  have movedA := moved.value at act, X, A, G.one
  have fixed := translate.one with action, bounded
  rw fixed at movedA
  have members : ∀ p ∈ {(A, G.one)}, p = (A, G.one)
    intros p hp
    exact singleton.membership.forward with hp
  witness {(A, G.one)}
  refine ⟨Finite.singleton at (A, G.one), ?_, ?_, ?_⟩
  . intros p hp
    have equal := members with p, hp
    rw equal
    exact pair
  . refine ⟨?_, ?_, ?_⟩
    . intros p hp
      have equal := members with p, hp
      rw [equal, fst.pair]
      exact Subset.reflexive at A
    . intros x hx
      witness (A, G.one)
      rw fst.pair
      exact ⟨singleton.self, hx⟩
    . intros p hp q hq different
      have equalP := members with p, hp
      have equalQ := members with q, hq
      exfalso
      apply different
      rw [equalP, equalQ]
      rfl
  . refine ⟨?_, ?_, ?_⟩
    . intros p hp
      have equal := members with p, hp
      rw [equal, movedA]
      exact Subset.reflexive at A
    . intros x hx
      witness (A, G.one)
      rw movedA
      exact ⟨singleton.self, hx⟩
    . intros p hp q hq different
      have equalP := members with p, hp
      have equalQ := members with q, hq
      exfalso
      apply different
      rw [equalP, equalQ]
      rfl

end Equivalence

-- Reindexing: a finite family F of indices, each mapped by f to a piece
-- and an element, with the piece and moved-piece conditions read through f.
theorem Equidecomposable.of_reindex (act G X A B D F f : Set)
  requires function : f : D → 𝒫(X) × Group.carrier(G)
  requires finite : Finite(F)
  requires bounded : F ⊆ D
  requires piecesBounded : ∀ p ∈ F, fst(f(p)) ⊆ A
  requires piecesCover : ∀ x ∈ A, ∃ p ∈ F, x ∈ fst(f(p))
  requires piecesDisjoint : ∀ p q ∈ F, p ≠ q → Disjoint(fst(f(p)), fst(f(q)))
  requires movedBounded : ∀ p ∈ F, moved(act, X, f(p)) ⊆ B
  requires movedCover : ∀ y ∈ B, ∃ p ∈ F, y ∈ moved(act, X, f(p))
  requires movedDisjoint : ∀ p q ∈ F, p ≠ q → Disjoint(moved(act, X, f(p)), moved(act, X, f(q)))
  shows Equidecomposable(act, G, X, A, B)
proof
  have finiteImage := Finite.function_image with function, finite, bounded
  have boundedImage := functionImage.subset at f, F, 𝒫(X) × Group.carrier(G)
  have members : ∀ q ∈ functionImage(f, F, 𝒫(X) × Group.carrier(G)), ∃ p ∈ F, q = f(p)
    intros q hq
    obtain ⟨qIn, p, hp, equal⟩ := functionImage.membership.forward with hq
    exact ⟨p, hp, equal⟩
  have images : ∀ p ∈ F, f(p) ∈ functionImage(f, F, 𝒫(X) × Group.carrier(G))
    intros p hp
    have pIn := bounded with p, hp
    have qIn := FunctionBetween.apply_closed with function, pIn
    exact functionImage.membership.backward with ⟨qIn, p, hp, rfl⟩
  have distinct : ∀ p ∈ F, ∀ q ∈ F, f(p) ≠ f(q) → p ≠ q
    intros p hp q hq different same
    apply different
    rw same
    rfl
  witness functionImage(f, F, 𝒫(X) × Group.carrier(G))
  refine ⟨finiteImage, boundedImage, ?_, ?_⟩
  . refine ⟨?_, ?_, ?_⟩
    . intros q hq
      obtain ⟨p, hp, equal⟩ := members with q, hq
      rw equal
      exact piecesBounded with p, hp
    . intros x hx
      obtain ⟨p, hp, member⟩ := piecesCover with x, hx
      have image := images with p, hp
      witness f(p)
      exact ⟨image, member⟩
    . intros q hq r hr different
      obtain ⟨p, hp, qEq⟩ := members with q, hq
      obtain ⟨s, hs, rEq⟩ := members with r, hr
      rw [qEq, rEq] at different
      have apart := distinct with p, hp, s, hs, different
      rw [qEq, rEq]
      exact piecesDisjoint with p, hp, s, hs, apart
  . refine ⟨?_, ?_, ?_⟩
    . intros q hq
      obtain ⟨p, hp, equal⟩ := members with q, hq
      rw equal
      exact movedBounded with p, hp
    . intros y hy
      obtain ⟨p, hp, member⟩ := movedCover with y, hy
      have image := images with p, hp
      witness f(p)
      exact ⟨image, member⟩
    . intros q hq r hr different
      obtain ⟨p, hp, qEq⟩ := members with q, hq
      obtain ⟨s, hs, rEq⟩ := members with r, hr
      rw [qEq, rEq] at different
      have apart := distinct with p, hp, s, hs, different
      rw [qEq, rEq]
      exact movedDisjoint with p, hp, s, hs, apart

-- Symmetry: each moved piece is carried back by the inverse element.
defgraph flipPair (act G X : Set) (p ∈ 𝒫(X) × Group.carrier(G)) : 𝒫(X) × Group.carrier(G) :=
  (moved(act, X, p), Group.inv(G)(snd(p)))
requires action : act : G ↷ X
proof
  obtain ⟨bound, S, hS, g, hg, shape⟩ := product.membership.forward with member
  have group := Action.group with action
  have invIn : g⁻¹ ∈ G := Group.inv_mem with *
  have movedBounded := powerset.membership_iff.backward with (translate.subset at act, X, g, S)
  rw [shape, moved.value, snd.pair]
  exact product.pair with movedBounded, invIn

-- Transitivity: the piece of (S, g) followed by (T, h) is S ∩ g⁻¹T,
-- carried by h * g.
defgraph composePair (act G X : Set)
    (r ∈ (𝒫(X) × Group.carrier(G)) × (𝒫(X) × Group.carrier(G))) :
    𝒫(X) × Group.carrier(G) :=
  (fst(fst(r)) ∩ translate(act, X, Group.inv(G)(snd(fst(r))), fst(snd(r))),
    Group.mul(G)(snd(snd(r)), snd(fst(r))))
requires action : act : G ↷ X
proof
  obtain ⟨bound, p, hp, q, hq, shape⟩ := product.membership.forward with member
  obtain ⟨boundP, S, hS, g, hg, pShape⟩ := product.membership.forward with hp
  obtain ⟨boundQ, T, hT, h, hh, qShape⟩ := product.membership.forward with hq
  have group := Action.group with action
  have subsetS := powerset.membership_iff.forward with hS
  have product : h * g ∈ G := Group.mul_mem with *
  have pieceBounded : S ∩ translate(act, X, g⁻¹, T) ⊆ X :=
    Subset.transitive with (intersection.subset_left at S, translate(act, X, g⁻¹, T)), subsetS
  have pieceIn := powerset.membership_iff.backward with pieceBounded
  have outerFirst := fst.pair at (S, g), (T, h)
  have outerSecond := snd.pair at (S, g), (T, h)
  have firstP := fst.pair at S, g
  have secondP := snd.pair at S, g
  have firstQ := fst.pair at T, h
  have secondQ := snd.pair at T, h
  rw [shape, pShape, qShape, outerFirst, outerSecond, firstP, secondP, firstQ, secondQ]
  exact product.pair with pieceIn, product

section Equivalence2
variable (act G X : Set)
hypothesis action : act : G ↷ X

theorem flipPair.apply (S g : Set)
  requires hS : S ⊆ X
  requires hg : g ∈ G.carrier
  shows flipPair(act, G, X)((S, g)) = (translate(act, X, g, S), g⁻¹)
proof
  have boundS := powerset.membership_iff.backward with hS
  have pair := product.pair at S, g, 𝒫(X), Group.carrier(G) with boundS, hg
  have value := flipPair.value at act, G, X, (S, g) with action, pair
  rw [value, moved.value, snd.pair]
  rfl

theorem Equidecomposable.symmetric (A B : Set)
  requires equidecomposable : Equidecomposable(act, G, X, A, B)
  shows Equidecomposable(act, G, X, B, A)
proof
  have group := Action.group with action
  obtain ⟨F, finite, bounded, pieces, movedPieces⟩ := equidecomposable
  obtain ⟨piecesBounded, piecesCover, piecesDisjoint⟩ := pieces
  obtain ⟨movedBounded, movedCover, movedDisjoint⟩ := movedPieces
  have function := flipPair.function at act, G, X with action
  have firsts : ∀ p ∈ F, fst(flipPair(act, G, X)(p)) = moved(act, X, p)
    intros p hp
    obtain ⟨boundP, S, hS, g, hg, shape⟩ := product.membership.forward with (bounded with p, hp)
    have subset := powerset.membership_iff.forward with hS
    have value := flipPair.apply with action, subset, hg
    rw [shape, value, fst.pair, moved.value]
    rfl
  have moves : ∀ p ∈ F, moved(act, X, flipPair(act, G, X)(p)) = fst(p)
    intros p hp
    obtain ⟨boundP, S, hS, g, hg, shape⟩ := product.membership.forward with (bounded with p, hp)
    have subset := powerset.membership_iff.forward with hS
    have value := flipPair.apply with action, subset, hg
    have back := translate.inv_translate with action, subset
    have movedValue := moved.value at act, X, translate(act, X, g, S), g⁻¹
    rw [shape, value, movedValue, back, fst.pair]
    rfl
  apply Equidecomposable.of_reindex with function, finite, bounded
  . intros p hp
    have first := firsts with p, hp
    rw first
    exact movedBounded with p, hp
  . intros y hy
    obtain ⟨p, hp, member⟩ := movedCover with y, hy
    have first := firsts with p, hp
    witness p
    rw first
    exact ⟨hp, member⟩
  . intros p hp q hq different
    have firstP := firsts with p, hp
    have firstQ := firsts with q, hq
    rw [firstP, firstQ]
    exact movedDisjoint with p, hp, q, hq, different
  . intros p hp
    have move := moves with p, hp
    rw move
    exact piecesBounded with p, hp
  . intros x hx
    obtain ⟨p, hp, member⟩ := piecesCover with x, hx
    have move := moves with p, hp
    witness p
    rw move
    exact ⟨hp, member⟩
  . intros p hp q hq different
    have moveP := moves with p, hp
    have moveQ := moves with q, hq
    rw [moveP, moveQ]
    exact piecesDisjoint with p, hp, q, hq, different

theorem composePair.apply (S T : Set) (g h : G)
  requires hS : S ⊆ X
  requires hT : T ⊆ X
  shows composePair(act, G, X)(((S, g), (T, h))) = (S ∩ translate(act, X, g⁻¹, T), h * g)
proof
  have gIn : g ∈ G.carrier by assumption
  have hIn : h ∈ G.carrier by assumption
  have boundS := powerset.membership_iff.backward with hS
  have boundT := powerset.membership_iff.backward with hT
  have first := product.pair at S, g, 𝒫(X), Group.carrier(G) with boundS, gIn
  have second := product.pair at T, h, 𝒫(X), Group.carrier(G) with boundT, hIn
  have pair := product.pair at (S, g), (T, h), 𝒫(X) × Group.carrier(G),
    𝒫(X) × Group.carrier(G) with first, second
  have value := composePair.value at act, G, X, ((S, g), (T, h)) with action, pair
  have outerFirst := fst.pair at (S, g), (T, h)
  have outerSecond := snd.pair at (S, g), (T, h)
  have firstP := fst.pair at S, g
  have secondP := snd.pair at S, g
  have firstQ := fst.pair at T, h
  have secondQ := snd.pair at T, h
  rw [value, outerFirst, outerSecond, firstP, secondP, firstQ, secondQ]
  rfl

theorem composePair.shape (F F2 p q : Set)
  requires bounded : F ⊆ 𝒫(X) × G.carrier
  requires bounded2 : F2 ⊆ 𝒫(X) × G.carrier
  requires hp : p ∈ F
  requires hq : q ∈ F2
  shows fst(p) ⊆ X ∧ fst(q) ⊆ X ∧ snd(p) ∈ G.carrier ∧ snd(q) ∈ G.carrier ∧ fst(composePair(act, G, X)((p, q))) = fst(p) ∩ translate(act, X, G.inv(snd(p)), fst(q)) ∧ moved(act, X, composePair(act, G, X)((p, q))) = translate(act, X, snd(q), moved(act, X, p) ∩ fst(q))
proof
  obtain ⟨boundP, S, hS, g, hg, pShape⟩ := product.membership.forward with (bounded with p, hp)
  obtain ⟨boundQ, T, hT, h, hh, qShape⟩ := product.membership.forward with (bounded2 with q, hq)
  have group := Action.group with action
  have subsetS := powerset.membership_iff.forward with hS
  have subsetT := powerset.membership_iff.forward with hT
  have value : composePair(act, G, X)(((S, g), (T, h))) =
    (S ∩ translate(act, X, g⁻¹, T), h * g) := composePair.apply with *
  have invT := translate.subset at act, X, g⁻¹, T
  have pieceBounded : S ∩ translate(act, X, g⁻¹, T) ⊆ X :=
    Subset.transitive with (intersection.subset_left at S, translate(act, X, g⁻¹, T)), subsetS
  have mulLaw : translate(act, X, h * g, S ∩ translate(act, X, g⁻¹, T)) =
    translate(act, X, h, translate(act, X, g, S ∩ translate(act, X, g⁻¹, T))) :=
    translate.mul with *
  have meet : translate(act, X, g, S ∩ translate(act, X, g⁻¹, T)) =
    translate(act, X, g, S) ∩ translate(act, X, g, translate(act, X, g⁻¹, T)) :=
    translate.intersection with action, subsetS, invT
  have back : translate(act, X, g, translate(act, X, g⁻¹, T)) = T :=
    translate.translate_inv with action, subsetT
  have movedComposite := moved.value at act, X, S ∩ translate(act, X, g⁻¹, T), h * g
  have movedP := moved.value at act, X, S, g
  have firstP := fst.pair at S, g
  have secondP := snd.pair at S, g
  have firstQ := fst.pair at T, h
  have secondQ := snd.pair at T, h
  have firstComposite := fst.pair at S ∩ translate(act, X, g⁻¹, T), h * g
  rw [pShape, qShape, value]
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩
  . rw firstP
    exact subsetS
  . rw firstQ
    exact subsetT
  . rw secondP
    exact hg
  . rw secondQ
    exact hh
  . rw [firstComposite, firstP, secondP, firstQ]
    rfl
  . rw [movedComposite, movedP, mulLaw, meet, back, secondQ, firstQ]
    rfl

theorem Equidecomposable.transitive (A B C : Set)
  requires first : Equidecomposable(act, G, X, A, B)
  requires second : Equidecomposable(act, G, X, B, C)
  shows Equidecomposable(act, G, X, A, C)
proof
  have group := Action.group with action
  obtain ⟨F, finite, bounded, pieces, movedPieces⟩ := first
  obtain ⟨F2, finite2, bounded2, pieces2, movedPieces2⟩ := second
  obtain ⟨piecesBounded, piecesCover, piecesDisjoint⟩ := pieces
  obtain ⟨movedBounded, movedCover, movedDisjoint⟩ := movedPieces
  obtain ⟨piecesBounded2, piecesCover2, piecesDisjoint2⟩ := pieces2
  obtain ⟨movedBounded2, movedCover2, movedDisjoint2⟩ := movedPieces2
  have function := composePair.function at act, G, X with action
  have finiteProduct := Finite.product with finite, finite2
  have boundedProduct := product.monotone with bounded, bounded2
  apply Equidecomposable.of_reindex with function, finiteProduct, boundedProduct
  . intros r hr
    obtain ⟨bound, p, hp, q, hq, rShape⟩ := product.membership.forward with hr
    obtain ⟨subsetP, subsetQ, gIn, hIn, firstEq, movedEq⟩ :=
      composePair.shape with action, bounded, bounded2, hp, hq
    rw [rShape, firstEq]
    have inner := intersection.subset_left at fst(p), translate(act, X, G.inv(snd(p)), fst(q))
    exact Subset.transitive with inner, (piecesBounded with p, hp)
  . intros x hx
    obtain ⟨p, hp, xInP⟩ := piecesCover with x, hx
    obtain ⟨boundP, S, hS, g, hg, pShape⟩ := product.membership.forward with (bounded with p, hp)
    have subsetS := powerset.membership_iff.forward with hS
    rw [pShape, fst.pair] at xInP
    have moved : g ·ₐ x ∈ translate(act, X, g, S) := translate.act_mem with *
    have movedValue := moved.value at act, X, S, g
    rw [← movedValue, ← pShape] at moved
    have inB := movedBounded with p, hp, g ·ₐ x, moved
    obtain ⟨q, hq, inQ⟩ := piecesCover2 with g ·ₐ x, inB
    obtain ⟨subsetP, subsetQ, gIn, hIn, firstEq, movedEq⟩ :=
      composePair.shape with action, bounded, bounded2, hp, hq
    have xIn := subsetS with x, xInP
    have twice : (g⁻¹)⁻¹ = g := inv_inv with *
    have pulled : x ∈ translate(act, X, g⁻¹, fst(q))
      apply translate.mem_iff.backward with action, subsetQ, xIn
      rw twice
      exact inQ
    have pair := product.pair at p, q, F, F2 with hp, hq
    witness (p, q)
    refine ⟨pair, ?_⟩
    rw [firstEq, pShape, fst.pair, snd.pair]
    exact intersection.membership.backward at
      S, translate(act, X, g⁻¹, fst(q)), x with ⟨xInP, pulled⟩
  . intros r hr s hs different
    obtain ⟨bound, p, hp, q, hq, rShape⟩ := product.membership.forward with hr
    obtain ⟨bound2, p2, hp2, q2, hq2, sShape⟩ := product.membership.forward with hs
    obtain ⟨subsetP, subsetQ, gIn, hIn, firstEq, movedEq⟩ :=
      composePair.shape with action, bounded, bounded2, hp, hq
    obtain ⟨subsetP2, subsetQ2, gIn2, hIn2, firstEq2, movedEq2⟩ :=
      composePair.shape with action, bounded, bounded2, hp2, hq2
    rw [rShape, sShape] at different
    rw [rShape, sShape, firstEq, firstEq2]
    have splitP : p = p2 ∨ p ≠ p2 by tauto
    cases splitP with same | apart
    . have apartQ : q ≠ q2
        intro sameQ
        apply different
        rw [same, sameQ]
        rfl
      have disjointQ := piecesDisjoint2 with q, hq, q2, hq2, apartQ
      rw same
      have invIn : G.inv(snd(p2)) ∈ G.carrier := Group.inv_mem with *
      have disjointPulled : Disjoint(translate(act, X, G.inv(snd(p2)), fst(q)),
        translate(act, X, G.inv(snd(p2)), fst(q2))) := translate.disjoint with *
      have left := intersection.subset_right at fst(p2), translate(act, X, G.inv(snd(p2)), fst(q))
      have right := intersection.subset_right at fst(p2), translate(act, X, G.inv(snd(p2)), fst(q2))
      have step := Disjoint.of_subset_left with disjointPulled, left
      exact Disjoint.of_subset_right with step, right
    . have disjointP := piecesDisjoint with p, hp, p2, hp2, apart
      have left := intersection.subset_left at fst(p), translate(act, X, G.inv(snd(p)), fst(q))
      have right := intersection.subset_left at fst(p2), translate(act, X, G.inv(snd(p2)), fst(q2))
      have step := Disjoint.of_subset_left with disjointP, left
      exact Disjoint.of_subset_right with step, right
  . intros r hr
    obtain ⟨bound, p, hp, q, hq, rShape⟩ := product.membership.forward with hr
    obtain ⟨subsetP, subsetQ, gIn, hIn, firstEq, movedEq⟩ :=
      composePair.shape with action, bounded, bounded2, hp, hq
    rw [rShape, movedEq]
    have inner := intersection.subset_right at moved(act, X, p), fst(q)
    have mono := translate.monotone at act, X, snd(q), moved(act, X, p) ∩ fst(q), fst(q) with inner
    have unfolded := moved.unfold at act, X, q
    rw ← unfolded at mono
    exact Subset.transitive with mono, (movedBounded2 with q, hq)
  . intros y hy
    obtain ⟨q, hq, yInQ⟩ := movedCover2 with y, hy
    have unfolded := moved.unfold at act, X, q
    rw unfolded at yInQ
    obtain ⟨yIn, t, ht, yEq⟩ := translate.membership.forward with yInQ
    have inB := piecesBounded2 with q, hq, t, ht
    obtain ⟨p, hp, tInP⟩ := movedCover with t, inB
    obtain ⟨subsetP, subsetQ, gIn, hIn, firstEq, movedEq⟩ :=
      composePair.shape with action, bounded, bounded2, hp, hq
    have both := intersection.membership.backward at
      moved(act, X, p), fst(q), t with ⟨tInP, ht⟩
    have meetBounded : moved(act, X, p) ∩ fst(q) ⊆ X :=
      Subset.transitive with (intersection.subset_right at moved(act, X, p), fst(q)), subsetQ
    have pair := product.pair at p, q, F, F2 with hp, hq
    witness (p, q)
    refine ⟨pair, ?_⟩
    rw [movedEq, yEq]
    exact translate.act_mem with action, meetBounded, both
  . intros r hr s hs different
    obtain ⟨bound, p, hp, q, hq, rShape⟩ := product.membership.forward with hr
    obtain ⟨bound2, p2, hp2, q2, hq2, sShape⟩ := product.membership.forward with hs
    obtain ⟨subsetP, subsetQ, gIn, hIn, firstEq, movedEq⟩ :=
      composePair.shape with action, bounded, bounded2, hp, hq
    obtain ⟨subsetP2, subsetQ2, gIn2, hIn2, firstEq2, movedEq2⟩ :=
      composePair.shape with action, bounded, bounded2, hp2, hq2
    rw [rShape, sShape] at different
    rw [rShape, sShape, movedEq, movedEq2]
    have splitQ : q = q2 ∨ q ≠ q2 by tauto
    cases splitQ with same | apart
    . have apartP : p ≠ p2
        intro sameP
        apply different
        rw [same, sameP]
        rfl
      have disjointP := movedDisjoint with p, hp, p2, hp2, apartP
      rw same
      have left := intersection.subset_left at moved(act, X, p), fst(q2)
      have right := intersection.subset_left at moved(act, X, p2), fst(q2)
      have step := Disjoint.of_subset_left with disjointP, left
      have inner := Disjoint.of_subset_right with step, right
      have innerLeft := intersection.subset_right at moved(act, X, p), fst(q2)
      have innerRight := intersection.subset_right at moved(act, X, p2), fst(q2)
      have meetBounded : moved(act, X, p) ∩ fst(q2) ⊆ X :=
        Subset.transitive with innerLeft, subsetQ2
      have meetBounded2 : moved(act, X, p2) ∩ fst(q2) ⊆ X :=
        Subset.transitive with innerRight, subsetQ2
      exact translate.disjoint with action, meetBounded, meetBounded2, inner
    . have disjointQ := movedDisjoint2 with q, hq, q2, hq2, apart
      have unfoldedQ := moved.unfold at act, X, q
      have unfoldedQ2 := moved.unfold at act, X, q2
      have innerQ := intersection.subset_right at moved(act, X, p), fst(q)
      have innerQ2 := intersection.subset_right at moved(act, X, p2), fst(q2)
      have monoQ := translate.monotone at act, X, snd(q), moved(act, X, p) ∩ fst(q), fst(q)
        with innerQ
      have monoQ2 := translate.monotone at act, X, snd(q2), moved(act, X, p2) ∩ fst(q2), fst(q2)
        with innerQ2
      rw ← unfoldedQ at monoQ
      rw ← unfoldedQ2 at monoQ2
      have step := Disjoint.of_subset_left with disjointQ, monoQ
      exact Disjoint.of_subset_right with step, monoQ2

-- Disjoint unions of equidecomposable sets are equidecomposable.
theorem Equidecomposable.disjoint_union (A B C D : Set)
  requires first : Equidecomposable(act, G, X, A, C)
  requires second : Equidecomposable(act, G, X, B, D)
  requires disjointSource : Disjoint(A, B)
  requires disjointTarget : Disjoint(C, D)
  shows Equidecomposable(act, G, X, A ∪ B, C ∪ D)
proof
  obtain ⟨F, finite, bounded, pieces, movedPieces⟩ := first
  obtain ⟨F2, finite2, bounded2, pieces2, movedPieces2⟩ := second
  obtain ⟨piecesBounded, piecesCover, piecesDisjoint⟩ := pieces
  obtain ⟨movedBounded, movedCover, movedDisjoint⟩ := movedPieces
  obtain ⟨piecesBounded2, piecesCover2, piecesDisjoint2⟩ := pieces2
  obtain ⟨movedBounded2, movedCover2, movedDisjoint2⟩ := movedPieces2
  have finiteUnion := Finite.union with finite, finite2
  have boundedUnion := union2.subset with bounded, bounded2
  have leftA := union2.subset_left at A, B
  have rightB := union2.subset_right at A, B
  have leftC := union2.subset_left at C, D
  have rightD := union2.subset_right at C, D
  have leftF := union2.subset_left at F, F2
  have rightF := union2.subset_right at F, F2
  have flippedSource := Disjoint.symmetric with disjointSource
  have flippedTarget := Disjoint.symmetric with disjointTarget
  witness F ∪ F2
  refine ⟨finiteUnion, boundedUnion, ?_, ?_⟩
  . refine ⟨?_, ?_, ?_⟩
    . intros p hp
      have split := union2.membership.forward with hp
      cases split with inF | inF2
      . exact Subset.transitive with (piecesBounded with p, inF), leftA
      . exact Subset.transitive with (piecesBounded2 with p, inF2), rightB
    . intros x hx
      have split := union2.membership.forward with hx
      cases split with inA | inB
      . obtain ⟨p, hp, member⟩ := piecesCover with x, inA
        have pIn := leftF with p, hp
        exact ⟨p, pIn, member⟩
      . obtain ⟨p, hp, member⟩ := piecesCover2 with x, inB
        have pIn := rightF with p, hp
        exact ⟨p, pIn, member⟩
    . intros p hp q hq different
      have splitP := union2.membership.forward with hp
      have splitQ := union2.membership.forward with hq
      cases splitP with pF | pF2
      . cases splitQ with qF | qF2
        . exact piecesDisjoint with p, pF, q, qF, different
        . have step := Disjoint.of_subset_left with disjointSource, (piecesBounded with p, pF)
          exact Disjoint.of_subset_right with step, (piecesBounded2 with q, qF2)
      . cases splitQ with qF | qF2
        . have step := Disjoint.of_subset_left with flippedSource, (piecesBounded2 with p, pF2)
          exact Disjoint.of_subset_right with step, (piecesBounded with q, qF)
        . exact piecesDisjoint2 with p, pF2, q, qF2, different
  . refine ⟨?_, ?_, ?_⟩
    . intros p hp
      have split := union2.membership.forward with hp
      cases split with inF | inF2
      . exact Subset.transitive with (movedBounded with p, inF), leftC
      . exact Subset.transitive with (movedBounded2 with p, inF2), rightD
    . intros y hy
      have split := union2.membership.forward with hy
      cases split with inC | inD
      . obtain ⟨p, hp, member⟩ := movedCover with y, inC
        have pIn := leftF with p, hp
        exact ⟨p, pIn, member⟩
      . obtain ⟨p, hp, member⟩ := movedCover2 with y, inD
        have pIn := rightF with p, hp
        exact ⟨p, pIn, member⟩
    . intros p hp q hq different
      have splitP := union2.membership.forward with hp
      have splitQ := union2.membership.forward with hq
      cases splitP with pF | pF2
      . cases splitQ with qF | qF2
        . exact movedDisjoint with p, pF, q, qF, different
        . have step := Disjoint.of_subset_left with disjointTarget, (movedBounded with p, pF)
          exact Disjoint.of_subset_right with step, (movedBounded2 with q, qF2)
      . cases splitQ with qF | qF2
        . have step := Disjoint.of_subset_left with flippedTarget, (movedBounded2 with p, pF2)
          exact Disjoint.of_subset_right with step, (movedBounded with q, qF)
        . exact movedDisjoint2 with p, pF2, q, qF2, different

end Equivalence2

-- The action of the free group pulled back along a homomorphism into G:
-- the word w acts as φ(w).
defgraph pullback (act G X φ : Set) (p ∈ reducedWords × X) : X := act(φ(fst(p)), snd(p))
requires action : act : G ↷ X
requires hom : φ : freeGroup →* G
proof
  obtain ⟨bound, w, hw, x, hx, shape⟩ := product.membership.forward with member
  have function := GroupHom.function with hom
  have carrier := freeGroup.carrierOf
  rw ← carrier at hw
  have image := FunctionBetween.apply_closed with function, hw
  rw [shape, fst.pair, snd.pair]
  exact Action.act_mem with action, image, hx

section Pullback
variable (act G X φ : Set)
hypothesis action : act : G ↷ X
hypothesis hom : φ : freeGroup →* G

theorem pullback.apply (w x : Set)
  requires hw : w ∈ reducedWords
  requires hx : x ∈ X
  shows pullback(act, G, X, φ)(w, x) = act(φ(w), x)
proof
  have pair := product.pair at w, x, reducedWords, X with *
  have value := pullback.value at act, G, X, φ, (w, x) with action, hom, pair
  unfold call2
  rw [fst.pair, snd.pair]
  rfl

theorem pullback.image_mem (w : Set)
  requires hw : w ∈ reducedWords
  shows φ(w) ∈ G.carrier
proof
  have function := GroupHom.function with hom
  have carrier := freeGroup.carrierOf
  rw ← carrier at hw
  exact FunctionBetween.apply_closed with function, hw

theorem pullback.map_nil
  shows φ([]) = G.one
proof
  have mapOne := GroupHom.map_one with hom
  rwa freeGroup.unit at mapOne

theorem pullback.action
  shows pullback(act, G, X, φ) : freeGroup ↷ X
proof
  have group := freeGroup.group
  have function := pullback.function at act, G, X, φ with action, hom
  have carrierFunction : pullback(act, G, X, φ) : Group.carrier(freeGroup) × X → X
    rw freeGroup.carrierOf
    exact function
  apply Action.mk with group, carrierFunction
  . intros x hx
    have unitIn := reducedWords.nil_mem
    have value := pullback.apply with action, hom, unitIn, hx
    have mapOne := pullback.map_nil with hom
    rw [freeGroup.unit, value, mapOne]
    exact one_act with action, hx
  . intros u hu v hv x hx
    have uIn := hu
    have vIn := hv
    rw freeGroup.carrierOf at uIn
    rw freeGroup.carrierOf at vIn
    have mapMul : φ(u * v) = φ(u) * φ(v) := GroupHom.map_mul with *
    have productIn : u * v ∈ reducedWords
      rw freeGroup.operation
      exact freeMul.mem with uIn, vIn
    have imageU := pullback.image_mem with hom, uIn
    have imageV := pullback.image_mem with hom, vIn
    have moved : φ(v) ·ₐ x ∈ X := Action.act_mem with *
    have first := pullback.apply with action, hom, vIn, hx
    have second := pullback.apply with action, hom, uIn, moved
    have third := pullback.apply with action, hom, productIn, hx
    have merged : (φ(u) * φ(v)) ·ₐ x = φ(u) ·ₐ φ(v) ·ₐ x := mul_act with *
    rw [third, mapMul, merged, first, second]
    rfl

theorem pullback.free
  requires free : FreeAction(act, G, X)
  requires injective : InjectiveBetween(φ, reducedWords, G.carrier)
  shows FreeAction(pullback(act, G, X, φ), freeGroup, X)
proof
  have group := Action.group with action
  have function := GroupHom.function with hom
  rw freeGroup.carrierOf at function
  have mapOne := pullback.map_nil with hom
  have nilIn := reducedWords.nil_mem
  have oneIn : G.one ∈ G := Group.one_mem with *
  unfold FreeAction
  intros x hx
  have trivial := free with x, hx
  rw freeGroup.unit
  ext w
  constructor
  . intro hw
    obtain ⟨wIn, fixes⟩ := stabilizer.membership.forward with hw
    rw freeGroup.carrierOf at wIn
    have value := pullback.apply with action, hom, wIn, hx
    rw value at fixes
    have imageIn := pullback.image_mem with hom, wIn
    have inStabilizer : φ(w) ∈ stabilizer(act, G, X, x) :=
      stabilizer.membership.backward with ⟨imageIn, fixes⟩
    rw trivial at inStabilizer
    have equal := singleton.membership.forward with inStabilizer
    have relatesW := FunctionBetween.relates_apply with function, wIn
    have relatesNil := FunctionBetween.relates_apply with function, nilIn
    rw equal at relatesW
    rw mapOne at relatesNil
    have same := Injective.cancel with injective, wIn, nilIn, oneIn, relatesW, relatesNil
    rw same
    exact singleton.self
  . intro hw
    have equal := singleton.membership.forward with hw
    rw equal
    apply stabilizer.membership.backward
    constructor
    . rw freeGroup.carrierOf
      exact nilIn
    . have value := pullback.apply with action, hom, nilIn, hx
      rw [value, mapOne]
      exact one_act with action, hx

end Pullback

section Representatives
variable (act G X c : Set)
hypothesis action : act : G ↷ X
hypothesis choice : SubsetChoice(c, X)

-- The chosen point of an orbit lies in it, so the representatives lie in
-- X, every point is carried from a representative, and two
-- representatives with the same orbit coincide.
theorem representatives.chosen (O : Set)
  requires hO : O ∈ orbits(act, G, X)
  shows c(O) ∈ O
proof
  obtain ⟨bound, x, hx, OEq⟩ := orbits.membership.forward with hO
  have subset := powerset.membership_iff.forward with bound
  have self : x ∈ orbit(x) := orbit.self with *
  have inhabited : Nonempty(O)
    rw OEq
    exact ⟨x, self⟩
  exact SubsetChoice.member with choice, subset, inhabited

theorem representatives.subset
  shows representatives(act, G, X, c) ⊆ X
proof
  intros m hm
  obtain ⟨O, hO, equal⟩ := representatives.membership.forward with hm
  have bound := orbits.subset_powerset at act, G, X with O, hO
  have subset := powerset.membership_iff.forward with bound
  have chosen := representatives.chosen with action, choice, hO
  rw ← equal
  exact subset with c(O), chosen

theorem representatives.orbit (m : Set)
  requires hm : m ∈ representatives(act, G, X, c)
  shows ∃ O ∈ orbits(act, G, X), O = orbit(m) ∧ c(O) = m
proof
  obtain ⟨O, hO, equal⟩ := representatives.membership.forward with hm
  obtain ⟨bound, x, hx, OEq⟩ := orbits.membership.forward with hO
  have chosen := representatives.chosen with action, choice, hO
  rw equal at chosen
  witness O
  refine ⟨hO, ?_, equal⟩
  rw OEq at chosen
  have same : orbit(m) = orbit(x) := orbit.of_member with action, hx, chosen
  rw [OEq, same]
  rfl

theorem representatives.cover (x : Set)
  requires hx : x ∈ X
  shows ∃ m ∈ representatives(act, G, X, c), ∃ g ∈ G.carrier, x = g ·ₐ m
proof
  have group := Action.group with action
  have hO := orbits.orbit_member at act, G, X, x with hx
  have chosen := representatives.chosen with action, choice, hO
  have member : c(orbit(x)) ∈ representatives(act, G, X, c) :=
    representatives.membership.backward with ⟨orbit(x), hO, rfl⟩
  obtain ⟨mIn, h, hIn, mEq⟩ := orbit.membership.forward with chosen
  witness c(orbit(x))
  refine ⟨member, h⁻¹, ?_, ?_⟩
  . typecheck
  . rw [mEq, inv_act_cancel]
    rfl

theorem representatives.unique (m n : Set)
  requires hm : m ∈ representatives(act, G, X, c)
  requires hn : n ∈ representatives(act, G, X, c)
  requires same : orbit(m) = orbit(n)
  shows m = n
proof
  obtain ⟨O, hO, OEq, chosenO⟩ := representatives.orbit with action, choice, hm
  obtain ⟨P, hP, PEq, chosenP⟩ := representatives.orbit with action, choice, hn
  have equal : O = P by cc
  rw [← chosenO, ← chosenP, equal]
  rfl

-- Under a free action, a point of X is carried from a representative by
-- exactly one group element.
theorem representatives.injective (m n : Set) (g h : G)
  requires free : FreeAction(act, G, X)
  requires hm : m ∈ representatives(act, G, X, c)
  requires hn : n ∈ representatives(act, G, X, c)
  requires equal : g ·ₐ m = h ·ₐ n
  shows m = n ∧ g = h
proof
  have group := Action.group with action
  have bounded := representatives.subset with action, choice
  have mIn := bounded with m, hm
  have nIn := bounded with n, hn
  have moved : h⁻¹ ·ₐ g ·ₐ m = n
    rw [equal, inv_act_cancel]
    rfl
  have merged : (h⁻¹ * g) ·ₐ m = h⁻¹ ·ₐ g ·ₐ m := mul_act with *
  have nInOrbit : n ∈ orbit(m)
    rw [← moved, ← merged]
    exact orbit.act_mem with *
  have sameOrbit : orbit(n) = orbit(m) := orbit.of_member with action, mIn, nInOrbit
  symm at sameOrbit
  have mn := representatives.unique with action, choice, hm, hn, sameOrbit
  refine ⟨mn, ?_⟩
  rw ← mn at moved
  rw ← merged at moved
  have trivial := free with m, mIn
  have inStabilizer : h⁻¹ * g ∈ stabilizer(act, G, X, m) := stabilizer.of_fixes with *
  rw trivial at inStabilizer
  have unit := singleton.membership.forward with inStabilizer
  have criterion : h⁻¹ * g = G.one ↔ h = g := inv_mul_eq_one with *
  symm
  exact criterion.forward with unit

end Representatives

section Sweep
variable (act G X : Set)
hypothesis action : act : G ↷ X

-- Sweeping a set of representatives by a set of group elements: the
-- images of distinct elements on representatives are disjoint under a
-- free action, the whole group sweeps everything, and translating a
-- sweep translates the elements.
theorem sweep.act_mem (H M g x : Set)
  requires boundedH : H ⊆ G.carrier
  requires boundedM : M ⊆ X
  requires hg : g ∈ H
  requires hx : x ∈ M
  shows act(g, x) ∈ sweep(act, X, H, M)
proof
  have xIn := boundedM with x, hx
  have gIn := boundedH with g, hg
  have moved : g ·ₐ x ∈ X := Action.act_mem with *
  exact sweep.membership.backward with ⟨moved, g, hg, x, hx, rfl⟩

theorem sweep.monotone (H K M : Set)
  requires subset : H ⊆ K
  shows sweep(act, X, H, M) ⊆ sweep(act, X, K, M)
proof
  intros y hy
  obtain ⟨yIn, g, hg, x, hx, equal⟩ := sweep.membership.forward with hy
  exact sweep.membership.backward with ⟨yIn, g, (subset with g, hg), x, hx, equal⟩

theorem sweep.union2 (H K M : Set)
  shows sweep(act, X, H ∪ K, M) = sweep(act, X, H, M) ∪ sweep(act, X, K, M)
proof
  ext y
  constructor
  . intro hy
    obtain ⟨yIn, g, hg, x, hx, equal⟩ := sweep.membership.forward with hy
    have split := union2.membership.forward with hg
    cases split with inH | inK
    . apply union2.membership.backward
      left
      exact sweep.membership.backward with ⟨yIn, g, inH, x, hx, equal⟩
    . apply union2.membership.backward
      right
      exact sweep.membership.backward with ⟨yIn, g, inK, x, hx, equal⟩
  . intro hy
    have split := union2.membership.forward with hy
    cases split with inH | inK
    . have leftIn := union2.subset_left at H, K
      have mono : sweep(act, X, H, M) ⊆ sweep(act, X, H ∪ K, M) :=
        sweep.monotone with leftIn
      exact mono with y, inH
    . have rightIn := union2.subset_right at H, K
      have mono : sweep(act, X, K, M) ⊆ sweep(act, X, H ∪ K, M) :=
        sweep.monotone with rightIn
      exact mono with y, inK

theorem sweep.disjoint (c H K : Set)
  requires choice : SubsetChoice(c, X)
  requires free : FreeAction(act, G, X)
  requires boundedH : H ⊆ G.carrier
  requires boundedK : K ⊆ G.carrier
  requires disjoint : Disjoint(H, K)
  shows Disjoint(sweep(act, X, H, representatives(act, G, X, c)),
    sweep(act, X, K, representatives(act, G, X, c)))
proof
  have apart := Disjoint.iff.forward with disjoint
  apply Disjoint.iff.backward
  intros y hyH hyK
  obtain ⟨yIn, g, hg, m, hm, gEq⟩ := sweep.membership.forward with hyH
  obtain ⟨yIn2, h, hh, n, hn, hEq⟩ := sweep.membership.forward with hyK
  have gIn := boundedH with g, hg
  have hIn := boundedK with h, hh
  have equal : g ·ₐ m = h ·ₐ n by cc
  have both := representatives.injective with action, choice, free, hm, hn, equal
  rw both.right at hg
  exact apart with h, hg, hh

theorem sweep.whole (c : Set)
  requires choice : SubsetChoice(c, X)
  shows sweep(act, X, G.carrier, representatives(act, G, X, c)) = X
proof
  have boundedM := representatives.subset with action, choice
  apply Subset.antisymmetric
  . exact sweep.subset at act, X, G.carrier, representatives(act, G, X, c)
  . intros x hx
    obtain ⟨m, hm, g, hg, equal⟩ := representatives.cover with action, choice, hx
    rw equal
    exact sweep.act_mem with action, (Subset.reflexive at G.carrier), boundedM, hg, hm

theorem sweep.translate (g : G) (H M : Set)
  requires boundedH : H ⊆ G.carrier
  requires boundedM : M ⊆ X
  shows translate(act, X, g, sweep(act, X, H, M)) = sweep(act, X, leftCoset(G, g, H), M)
proof
  have group := Action.group with action
  ext y
  constructor
  . intro hy
    obtain ⟨yIn, z, hz, equal⟩ := translate.membership.forward with hy
    obtain ⟨zIn, h, hh, x, hx, zEq⟩ := sweep.membership.forward with hz
    have hIn := boundedH with h, hh
    have xIn := boundedM with x, hx
    have merged : (g * h) ·ₐ x = g ·ₐ h ·ₐ x := mul_act with *
    have product : g * h ∈ G by typecheck
    have inCoset : g * h ∈ leftCoset(G, g, H) :=
      leftCoset.membership.backward with ⟨product, h, hh, rfl⟩
    rw [equal, zEq, ← merged]
    exact sweep.act_mem with action, (leftCoset.subset at G, g, H), boundedM, inCoset, hx
  . intro hy
    obtain ⟨yIn, k, hk, x, hx, equal⟩ := sweep.membership.forward with hy
    obtain ⟨kIn, h, hh, kEq⟩ := leftCoset.membership.forward with hk
    have hIn := boundedH with h, hh
    have xIn := boundedM with x, hx
    have merged : (g * h) ·ₐ x = g ·ₐ h ·ₐ x := mul_act with *
    have inner : h ·ₐ x ∈ sweep(act, X, H, M) :=
      sweep.act_mem with action, boundedH, boundedM, hh, hx
    rw [equal, kEq, merged]
    exact translate.act_mem with action, (sweep.subset at act, X, H, M), inner

end Sweep

-- A set with a free action of the free group is paradoxical: with M one
-- chosen point in each orbit, the words starting with a and with a⁻¹
-- sweep M onto two pieces whose union is carried onto X by the unit and
-- by a, and likewise for b.
theorem Paradoxical.of_free_freeGroup (act X : Set)
  requires action : act : freeGroup ↷ X
  requires free : FreeAction(act, freeGroup, X)
  shows Paradoxical(act, freeGroup, X)
proof
  obtain ⟨c, choice⟩ := SubsetChoice.exists at X
  have group := freeGroup.group
  have carrier := freeGroup.carrierOf
  have boundedM := representatives.subset with action, choice
  have zero := letter.zero_mem
  have one := letter.one_mem
  have two := letter.two_mem
  have three := letter.three_mem
  have inverseA : 1 = inverseLetter(0)
    symm
    exact inverseLetter.zero
  have inverseB : 3 = inverseLetter(2)
    symm
    exact inverseLetter.two
  have translateA := leftCoset.letter with zero, one, inverseA
  have translateB := leftCoset.letter with two, three, inverseB
  have subset0 := startsWith.subset at 0
  have subset1 := startsWith.subset at 1
  have subset2 := startsWith.subset at 2
  have subset3 := startsWith.subset at 3
  have bounded0 : startsWith(0) ⊆ Group.carrier(freeGroup)
    rw carrier
    exact subset0
  have bounded1 : startsWith(1) ⊆ Group.carrier(freeGroup)
    rw carrier
    exact subset1
  have bounded2 : startsWith(2) ⊆ Group.carrier(freeGroup)
    rw carrier
    exact subset2
  have bounded3 : startsWith(3) ⊆ Group.carrier(freeGroup)
    rw carrier
    exact subset3
  have rest0 : reducedWords ∖ startsWith(0) ⊆ Group.carrier(freeGroup)
    rw carrier
    exact difference.subset_left at reducedWords, startsWith(0)
  have rest2 : reducedWords ∖ startsWith(2) ⊆ Group.carrier(freeGroup)
    rw carrier
    exact difference.subset_left at reducedWords, startsWith(2)
  have unitIn : [] ∈ Group.carrier(freeGroup)
    rw carrier
    exact reducedWords.nil_mem
  have valueA : freeA = 0 :: [] by simp [freeA]
  have valueB : freeB = 2 :: [] by simp [freeB]
  have singleA : 0 :: [] ∈ Group.carrier(freeGroup)
    rw [carrier, ← valueA]
    exact freeA.mem
  have singleB : 2 :: [] ∈ Group.carrier(freeGroup)
    rw [carrier, ← valueB]
    exact freeB.mem
  have whole := sweep.whole with action, choice
  rw carrier at whole
  have piece0 := sweep.subset at act, X, startsWith(0), representatives(act, freeGroup, X, c)
  have piece1 := sweep.subset at act, X, startsWith(1), representatives(act, freeGroup, X, c)
  have piece2 := sweep.subset at act, X, startsWith(2), representatives(act, freeGroup, X, c)
  have piece3 := sweep.subset at act, X, startsWith(3), representatives(act, freeGroup, X, c)
  have apart01 : 0 ≠ 1 by settle with Naturals.disjoint.zero.succ, Naturals.injective.succ
  have apart02 : 0 ≠ 2 by settle with Naturals.disjoint.zero.succ, Naturals.injective.succ
  have apart03 : 0 ≠ 3 by settle with Naturals.disjoint.zero.succ, Naturals.injective.succ
  have apart12 : 1 ≠ 2 by settle with Naturals.disjoint.zero.succ, Naturals.injective.succ
  have apart13 : 1 ≠ 3 by settle with Naturals.disjoint.zero.succ, Naturals.injective.succ
  have apart23 : 2 ≠ 3 by settle with Naturals.disjoint.zero.succ, Naturals.injective.succ
  have words01 := startsWith.disjoint with zero, one, apart01
  have words02 := startsWith.disjoint with zero, two, apart02
  have words03 := startsWith.disjoint with zero, three, apart03
  have words12 := startsWith.disjoint with one, two, apart12
  have words13 := startsWith.disjoint with one, three, apart13
  have words23 := startsWith.disjoint with two, three, apart23
  have disjoint01 := sweep.disjoint with action, choice, free, bounded0, bounded1, words01
  have disjoint23 := sweep.disjoint with action, choice, free, bounded2, bounded3, words23
  have union01 : sweep(act, X, startsWith(0) ∪ startsWith(1), representatives(act, freeGroup, X, c)) =
    sweep(act, X, startsWith(0), representatives(act, freeGroup, X, c)) ∪ sweep(act, X, startsWith(1), representatives(act, freeGroup, X, c)) := sweep.union2 with *
  have union23 : sweep(act, X, startsWith(2) ∪ startsWith(3), representatives(act, freeGroup, X, c)) =
    sweep(act, X, startsWith(2), representatives(act, freeGroup, X, c)) ∪ sweep(act, X, startsWith(3), representatives(act, freeGroup, X, c)) := sweep.union2 with *
  witness sweep(act, X, startsWith(0), representatives(act, freeGroup, X, c)) ∪ sweep(act, X, startsWith(1), representatives(act, freeGroup, X, c))
  witness sweep(act, X, startsWith(2), representatives(act, freeGroup, X, c)) ∪ sweep(act, X, startsWith(3), representatives(act, freeGroup, X, c))
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  . exact union2.subset with piece0, piece1
  . exact union2.subset with piece2, piece3
  . rw [← union01, ← union23]
    have bounded01 : startsWith(0) ∪ startsWith(1) ⊆ Group.carrier(freeGroup) :=
      union2.subset with bounded0, bounded1
    have bounded23 : startsWith(2) ∪ startsWith(3) ⊆ Group.carrier(freeGroup) :=
      union2.subset with bounded2, bounded3
    have apart : Disjoint(startsWith(0) ∪ startsWith(1), startsWith(2) ∪ startsWith(3))
      apply Disjoint.iff.backward
      intros w hwA hwB
      have splitA := union2.membership.forward with hwA
      have splitB := union2.membership.forward with hwB
      cases splitA with in0 | in1
      . cases splitB with in2 | in3
        . have apartWords02 := Disjoint.iff.forward with words02
          exact apartWords02 with w, in0, in2
        . have apartWords03 := Disjoint.iff.forward with words03
          exact apartWords03 with w, in0, in3
      . cases splitB with in2 | in3
        . have apartWords12 := Disjoint.iff.forward with words12
          exact apartWords12 with w, in1, in2
        . have apartWords13 := Disjoint.iff.forward with words13
          exact apartWords13 with w, in1, in3
    exact sweep.disjoint with action, choice, free, bounded01, bounded23, apart
  . have fixed := translate.one with action, piece0
    rw freeGroup.unit at fixed
    have shifted : translate(act, X, 0 :: [], sweep(act, X, startsWith(1), representatives(act, freeGroup, X, c))) =
      sweep(act, X, leftCoset(freeGroup, 0 :: [], startsWith(1)), representatives(act, freeGroup, X, c)) := sweep.translate with *
    rw translateA at shifted
    have apartRest := Disjoint.symmetric with (difference.disjoint at reducedWords, startsWith(0))
    have disjointImages := sweep.disjoint with action, choice, free, bounded0, rest0, apartRest
    have coverImages : sweep(act, X, startsWith(0) ∪ (reducedWords ∖ startsWith(0)), representatives(act, freeGroup, X, c)) =
      sweep(act, X, startsWith(0), representatives(act, freeGroup, X, c)) ∪ sweep(act, X, reducedWords ∖ startsWith(0), representatives(act, freeGroup, X, c)) := sweep.union2 with *
    have restore := difference.union2_of_subset with subset0
    rw restore at coverImages
    rw [← fixed, ← shifted] at disjointImages
    rw [whole, ← fixed, ← shifted] at coverImages
    symm at coverImages
    have coverPieces : sweep(act, X, startsWith(0), representatives(act, freeGroup, X, c)) ∪ sweep(act, X, startsWith(1), representatives(act, freeGroup, X, c)) =
      sweep(act, X, startsWith(0), representatives(act, freeGroup, X, c)) ∪ sweep(act, X, startsWith(1), representatives(act, freeGroup, X, c)) by rfl
    exact Equidecomposable.of_two_pieces with action, unitIn, singleA, piece0, piece1,
      disjoint01, coverPieces, disjointImages, coverImages
  . have fixed := translate.one with action, piece2
    rw freeGroup.unit at fixed
    have shifted : translate(act, X, 2 :: [], sweep(act, X, startsWith(3), representatives(act, freeGroup, X, c))) =
      sweep(act, X, leftCoset(freeGroup, 2 :: [], startsWith(3)), representatives(act, freeGroup, X, c)) := sweep.translate with *
    rw translateB at shifted
    have apartRest := Disjoint.symmetric with (difference.disjoint at reducedWords, startsWith(2))
    have disjointImages := sweep.disjoint with action, choice, free, bounded2, rest2, apartRest
    have coverImages : sweep(act, X, startsWith(2) ∪ (reducedWords ∖ startsWith(2)), representatives(act, freeGroup, X, c)) =
      sweep(act, X, startsWith(2), representatives(act, freeGroup, X, c)) ∪ sweep(act, X, reducedWords ∖ startsWith(2), representatives(act, freeGroup, X, c)) := sweep.union2 with *
    have restore := difference.union2_of_subset with subset2
    rw restore at coverImages
    rw [← fixed, ← shifted] at disjointImages
    rw [whole, ← fixed, ← shifted] at coverImages
    symm at coverImages
    have coverPieces : sweep(act, X, startsWith(2), representatives(act, freeGroup, X, c)) ∪ sweep(act, X, startsWith(3), representatives(act, freeGroup, X, c)) =
      sweep(act, X, startsWith(2), representatives(act, freeGroup, X, c)) ∪ sweep(act, X, startsWith(3), representatives(act, freeGroup, X, c)) by rfl
    exact Equidecomposable.of_two_pieces with action, unitIn, singleB, piece2, piece3,
      disjoint23, coverPieces, disjointImages, coverImages

-- A decomposition under an action pulled back along a homomorphism is a
-- decomposition under the original action, with the elements mapped.
defgraph pushPair (φ H G X : Set) (p ∈ 𝒫(X) × H.carrier) : 𝒫(X) × G.carrier :=
  (fst(p), φ(snd(p)))
requires hom : φ : H →* G
proof
  obtain ⟨bound, S, hS, h, hh, shape⟩ := product.membership.forward with member
  have function := GroupHom.function with hom
  have image := FunctionBetween.apply_closed with function, hh
  rw [shape, fst.pair, snd.pair]
  exact product.pair with hS, image

section Transfer
variable (act act2 G H X φ : Set)
hypothesis action : act : G ↷ X
hypothesis action2 : act2 : H ↷ X
hypothesis hom : φ : H →* G
hypothesis compatible : ∀ h ∈ H.carrier, ∀ x ∈ X, act2(h, x) = act(φ(h), x)

theorem pushPair.apply (S h : Set)
  requires hS : S ∈ 𝒫(X)
  requires hh : h ∈ H.carrier
  shows pushPair(φ, H, G, X)((S, h)) = (S, φ(h))
proof
  have pair := product.pair at S, h, 𝒫(X), H.carrier with *
  have value := pushPair.value at φ, H, G, X, (S, h) with hom, pair
  rw [value, fst.pair, snd.pair]
  rfl

theorem pushPair.moved (p : Set)
  requires hp : p ∈ 𝒫(X) × H.carrier
  shows moved(act, X, pushPair(φ, H, G, X)(p)) = moved(act2, X, p)
proof
  obtain ⟨bound, S, hS, h, hh, shape⟩ := product.membership.forward with hp
  have bounded := powerset.membership_iff.forward with hS
  have value := pushPair.apply with hom, hS, hh
  have agree : ∀ x ∈ S, act(φ(h), x) = act2(h, x)
    intros x hx
    have xIn := bounded with x, hx
    symm
    exact compatible with h, hh, x, xIn
  rw [shape, value, moved.value, moved.value]
  exact translate.congr with agree

theorem Equidecomposable.of_hom (A B : Set)
  requires equidecomposable : Equidecomposable(act2, H, X, A, B)
  shows Equidecomposable(act, G, X, A, B)
proof
  obtain ⟨F, finite, bounded, pieces, movedPieces⟩ := equidecomposable
  obtain ⟨piecesBounded, piecesCover, piecesDisjoint⟩ := pieces
  obtain ⟨movedBounded, movedCover, movedDisjoint⟩ := movedPieces
  have function := pushPair.function at φ, H, G, X with hom
  have finiteImage := Finite.function_image with function, finite, bounded
  have members : ∀ q ∈ functionImage(pushPair(φ, H, G, X), F, 𝒫(X) × G.carrier), ∃ p ∈ F, q = pushPair(φ, H, G, X)(p)
    intros q hq
    obtain ⟨qIn, p, hp, equal⟩ := functionImage.membership.forward with hq
    exact ⟨p, hp, equal⟩
  have images : ∀ p ∈ F, pushPair(φ, H, G, X)(p) ∈ functionImage(pushPair(φ, H, G, X), F, 𝒫(X) × G.carrier)
    intros p hp
    have pIn := bounded with p, hp
    have qIn := FunctionBetween.apply_closed with function, pIn
    exact functionImage.membership.backward with ⟨qIn, p, hp, rfl⟩
  have firsts : ∀ p ∈ F, fst(pushPair(φ, H, G, X)(p)) = fst(p)
    intros p hp
    have pIn := bounded with p, hp
    obtain ⟨boundP, S, hS, h, hh, shape⟩ := product.membership.forward with pIn
    have value := pushPair.apply with hom, hS, hh
    rw [shape, value, fst.pair, fst.pair]
    rfl
  have moves : ∀ p ∈ F, moved(act, X, pushPair(φ, H, G, X)(p)) = moved(act2, X, p)
    intros p hp
    exact pushPair.moved with action, action2, hom, compatible, (bounded with p, hp)
  have distinct : ∀ p ∈ F, ∀ q ∈ F, pushPair(φ, H, G, X)(p) ≠ pushPair(φ, H, G, X)(q) → p ≠ q
    intros p hp q hq different same
    apply different
    rw same
    rfl
  have boundedImage := functionImage.subset at pushPair(φ, H, G, X), F, 𝒫(X) × G.carrier
  witness functionImage(pushPair(φ, H, G, X), F, 𝒫(X) × G.carrier)
  refine ⟨finiteImage, boundedImage, ?_, ?_⟩
  . refine ⟨?_, ?_, ?_⟩
    . intros q hq
      obtain ⟨p, hp, equal⟩ := members with q, hq
      have first := firsts with p, hp
      rw [equal, first]
      exact piecesBounded with p, hp
    . intros x hx
      obtain ⟨p, hp, member⟩ := piecesCover with x, hx
      have first := firsts with p, hp
      have image := images with p, hp
      witness pushPair(φ, H, G, X)(p)
      rw first
      exact ⟨image, member⟩
    . intros q hq r hr different
      obtain ⟨p, hp, qEq⟩ := members with q, hq
      obtain ⟨s, hs, rEq⟩ := members with r, hr
      rw [qEq, rEq] at different
      have apart := distinct with p, hp, s, hs, different
      have firstP := firsts with p, hp
      have firstS := firsts with s, hs
      rw [qEq, rEq, firstP, firstS]
      exact piecesDisjoint with p, hp, s, hs, apart
  . refine ⟨?_, ?_, ?_⟩
    . intros q hq
      obtain ⟨p, hp, equal⟩ := members with q, hq
      have move := moves with p, hp
      rw [equal, move]
      exact movedBounded with p, hp
    . intros y hy
      obtain ⟨p, hp, member⟩ := movedCover with y, hy
      have move := moves with p, hp
      have image := images with p, hp
      witness pushPair(φ, H, G, X)(p)
      rw move
      exact ⟨image, member⟩
    . intros q hq r hr different
      obtain ⟨p, hp, qEq⟩ := members with q, hq
      obtain ⟨s, hs, rEq⟩ := members with r, hr
      rw [qEq, rEq] at different
      have apart := distinct with p, hp, s, hs, different
      have moveP := moves with p, hp
      have moveS := moves with s, hs
      rw [qEq, rEq, moveP, moveS]
      exact movedDisjoint with p, hp, s, hs, apart

theorem Paradoxical.of_hom
  requires paradoxical : Paradoxical(act2, H, X)
  shows Paradoxical(act, G, X)
proof
  obtain ⟨A, B, boundedA, boundedB, disjoint, firstA, secondB⟩ := paradoxical
  witness A
  witness B
  refine ⟨boundedA, boundedB, disjoint, ?_, ?_⟩
  . exact Equidecomposable.of_hom with action, action2, hom, compatible, firstA
  . exact Equidecomposable.of_hom with action, action2, hom, compatible, secondB

end Transfer

-- The transfer theorem: a set with a free action of a group that contains
-- the free group on two generators is paradoxical.
theorem Paradoxical.of_free_action (act G X φ : Set)
  requires action : act : G ↷ X
  requires free : FreeAction(act, G, X)
  requires hom : φ : freeGroup →* G
  requires injective : InjectiveBetween(φ, reducedWords, G.carrier)
  shows Paradoxical(act, G, X)
proof
  have pulled := pullback.action with action, hom
  have pulledFree := pullback.free with action, hom, free, injective
  have paradoxical := Paradoxical.of_free_freeGroup with pulled, pulledFree
  have compatible : ∀ w ∈ Group.carrier(freeGroup), ∀ x ∈ X, pullback(act, G, X, φ)(w, x) = act(φ(w), x)
    intros w hw x hx
    rw freeGroup.carrierOf at hw
    exact pullback.apply with action, hom, hw, hx
  exact Paradoxical.of_hom with action, pulled, hom, compatible, paradoxical
