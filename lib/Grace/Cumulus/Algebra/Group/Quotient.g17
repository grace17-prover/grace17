-- Quotient groups: the coset relation of a subgroup is an equivalence
-- whose classes are the left cosets, a normal subgroup makes it a
-- congruence, the quotient carries the induced group structure, and the
-- projection is a surjective homomorphism with the normal subgroup as its
-- kernel
-- Part of Cumulus, the Grace17 mathematics library.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module Grace.Cumulus.Algebra.Group.Quotient
import Normal
import Relation.QuotientOperations

-- x and y are related when x⁻¹ * y lies in N.
def cosetRelation (G N : Set) : Set :=
  { p ∈ G.carrier × G.carrier | ∃ x ∈ G.carrier, ∃ y ∈ G.carrier,
    p = (x, y) ∧ G.mul(G.inv(x), y) ∈ N }

-- The quotient group of G by N: the classes of the coset relation with the
-- induced operation, unit, and inverse.
def quotientGroup (G N : Set) : Set :=
  Group.mk((G.carrier ⧸ cosetRelation(G, N)),
    quotientBinary(G.carrier, cosetRelation(G, N), G.mul),
    ⟦G.one⟧[G.carrier, cosetRelation(G, N)],
    quotientUnary(G.carrier, cosetRelation(G, N), G.inv))

-- The quotient is written G ⧸ N wherever G is the group of a hypothesis in
-- scope; the set quotient A ⧸ r keeps its meaning on every other left
-- operand.
notation infixl 70 "⧸" => quotientGroup(G, _) via hypothesis Group(G) for G
notation infixl 70 "⧸" => quotientGroup(G, _) via hypothesis NormalSubgroup(N, G) for G

theorem quotientGroup.carrierOf (G N : Set)
  shows Group.carrier(quotientGroup(G, N)) = (G.carrier ⧸ cosetRelation(G, N))
proof
  simp [quotientGroup, Group.mk.carrier]

theorem quotientGroup.operation (G N : Set)
  shows Group.mul(quotientGroup(G, N)) = quotientBinary(G.carrier, cosetRelation(G, N), G.mul)
proof
  simp [quotientGroup, Group.mk.mul]

theorem quotientGroup.unit (G N : Set)
  shows Group.one(quotientGroup(G, N)) = ⟦G.one⟧[G.carrier, cosetRelation(G, N)]
proof
  simp [quotientGroup, Group.mk.one]

theorem quotientGroup.inverse (G N : Set)
  shows Group.inv(quotientGroup(G, N)) = quotientUnary(G.carrier, cosetRelation(G, N), G.inv)
proof
  simp [quotientGroup, Group.mk.inv]

theorem cosetRelation.membership (G N p : Set)
  shows p ∈ cosetRelation(G, N) ↔ p ∈ G.carrier × G.carrier ∧
    ∃ x ∈ G.carrier, ∃ y ∈ G.carrier, p = (x, y) ∧ G.mul(G.inv(x), y) ∈ N
proof
  simp [cosetRelation]

theorem cosetRelation.relation (G N : Set)
  shows RelationOn(cosetRelation(G, N), G.carrier)
proof
  intros p hp
  have parts := cosetRelation.membership.forward with hp
  exact parts.left

section CosetRelation
variable (G N : Set)
hypothesis group : Group(G)
hypothesis subgroup : Subgroup(N, G)

theorem cosetRelation.relates (x y : G)
  shows relates(cosetRelation(G, N), x, y) ↔ x⁻¹ * y ∈ N
proof
  constructor
  . intro related
    obtain ⟨bounded, u, hu, v, hv, shape, member⟩ :=
      cosetRelation.membership.forward at G, N, (x, y) with related
    have coordinates := orderedPair.injective with shape
    rwa [coordinates.left, coordinates.right]
  . intro member
    have xIn : x ∈ G by assumption
    have yIn : y ∈ G by assumption
    have bounded := product.pair at x, y, G.carrier, G.carrier with *
    unfold relates
    apply cosetRelation.membership.backward
    refine ⟨bounded, x, xIn, y, yIn, rfl, member⟩

theorem cosetRelation.equivalence
  shows Equivalence(G.carrier, cosetRelation(G, N))
proof
  have relation := cosetRelation.relation at G, N
  unfold Equivalence
  refine ⟨relation, ?_, ?_, ?_⟩
  . intros x hx
    have criterion : relates(cosetRelation(G, N), x, x) ↔ x⁻¹ * x ∈ N := cosetRelation.relates with *
    apply criterion.backward
    rw Group.inv_mul
    exact Subgroup.one_mem with *
  . intros x hx y hy related
    have forward : relates(cosetRelation(G, N), x, y) ↔ x⁻¹ * y ∈ N := cosetRelation.relates with *
    have backward : relates(cosetRelation(G, N), y, x) ↔ y⁻¹ * x ∈ N := cosetRelation.relates with *
    have member := forward.forward with related
    have inverted : (x⁻¹ * y)⁻¹ ∈ N := Subgroup.inv_mem with *
    rw [mul_inv_rev, inv_inv] at inverted
    exact backward.backward with inverted
  . intros x hx y hy z hz xy yz
    have first : relates(cosetRelation(G, N), x, y) ↔ x⁻¹ * y ∈ N := cosetRelation.relates with *
    have second : relates(cosetRelation(G, N), y, z) ↔ y⁻¹ * z ∈ N := cosetRelation.relates with *
    have third : relates(cosetRelation(G, N), x, z) ↔ x⁻¹ * z ∈ N := cosetRelation.relates with *
    have firstIn := first.forward with xy
    have secondIn := second.forward with yz
    have product : x⁻¹ * y * (y⁻¹ * z) ∈ N := Subgroup.mul_mem with *
    rw [mul_assoc, mul_inv_cancel_left] at product
    exact third.backward with product

-- The equivalence classes are the left cosets.
theorem cosetRelation.class_eq_coset (x : G)
  shows ⟦x⟧[G.carrier, cosetRelation(G, N)] = leftCoset(G, x, N)
proof
  ext y
  constructor
  . intro hy
    obtain ⟨yIn, related⟩ := equivalenceClass.membership.forward with hy
    have criterion : relates(cosetRelation(G, N), x, y) ↔ x⁻¹ * y ∈ N := cosetRelation.relates with *
    have cosetCriterion : y ∈ leftCoset(G, x, N) ↔ x⁻¹ * y ∈ N := leftCoset.mem_iff with *
    have member := criterion.forward with related
    exact cosetCriterion.backward with member
  . intro hy
    have yIn := leftCoset.subset at G, x, N with y, hy
    have criterion : relates(cosetRelation(G, N), x, y) ↔ x⁻¹ * y ∈ N := cosetRelation.relates with *
    have cosetCriterion : y ∈ leftCoset(G, x, N) ↔ x⁻¹ * y ∈ N := leftCoset.mem_iff with *
    have member := cosetCriterion.forward with hy
    have related := criterion.backward with member
    exact equivalenceClass.membership.backward with ⟨yIn, related⟩

theorem cosetRelation.quotient_eq_cosets
  shows (G.carrier ⧸ cosetRelation(G, N)) = leftCosets(G, N)
proof
  have equivalence := cosetRelation.equivalence with group, subgroup
  ext C
  constructor
  . intro hC
    obtain ⟨bounded, x, hx, shape⟩ := quotient.membership.forward with hC
    have coset : ⟦x⟧[G.carrier, cosetRelation(G, N)] = leftCoset(G, x, N) := cosetRelation.class_eq_coset with *
    rw [shape, coset]
    exact leftCosets.coset_member with hx
  . intro hC
    obtain ⟨bounded, x, hx, shape⟩ := leftCosets.membership.forward with hC
    have coset : ⟦x⟧[G.carrier, cosetRelation(G, N)] = leftCoset(G, x, N) := cosetRelation.class_eq_coset with *
    rw [shape, ← coset]
    exact quotient.contains_class with equivalence, hx

theorem cosetRelation.class_eq_iff (x y : G)
  shows ⟦x⟧[G.carrier, cosetRelation(G, N)] = ⟦y⟧[G.carrier, cosetRelation(G, N)] ↔ x⁻¹ * y ∈ N
proof
  have equivalence := cosetRelation.equivalence with group, subgroup
  have criterion : relates(cosetRelation(G, N), x, y) ↔ x⁻¹ * y ∈ N := cosetRelation.relates with *
  constructor
  . intro equal
    have related := equivalenceClass.related_of_eq with equivalence, *
    exact criterion.forward with related
  . intro member
    have related := criterion.backward with member
    exact equivalenceClass.eq with equivalence, *

theorem cosetRelation.class_eq_one_iff (x : G)
  shows ⟦x⟧[G.carrier, cosetRelation(G, N)] = ⟦G.one⟧[G.carrier, cosetRelation(G, N)] ↔ x ∈ N
proof
  have criterion : ⟦x⟧[G.carrier, cosetRelation(G, N)] = ⟦G.one⟧[G.carrier, cosetRelation(G, N)] ↔
      x⁻¹ * G.one ∈ N := cosetRelation.class_eq_iff with *
  have inverseCriterion : x⁻¹ ∈ N ↔ x ∈ N := Subgroup.inv_mem_iff with *
  rw mul_one at criterion
  constructor
  . intro equal
    have member := criterion.forward with equal
    exact inverseCriterion.forward with member
  . intro member
    have inverted := inverseCriterion.backward with member
    exact criterion.backward with inverted

instance quotientGroup.class_mem (x : G)
  shows ⟦x⟧[G.carrier, cosetRelation(G, N)] ∈ Group.carrier(G ⧸ N)
proof
  have equivalence := cosetRelation.equivalence with group, subgroup
  rw quotientGroup.carrierOf
  exact quotient.contains_class with equivalence, *

theorem quotientGroup.representative (X : Set)
  requires hX : X ∈ Group.carrier(G ⧸ N)
  shows ∃ x ∈ G, X = ⟦x⟧[G.carrier, cosetRelation(G, N)]
proof
  rw quotientGroup.carrierOf at hX
  exact quotient.representative with hX

end CosetRelation

section QuotientGroup
variable (G N : Set)
hypothesis group : Group(G)
hypothesis normal : NormalSubgroup(N, G)

-- Normality makes the coset relation a congruence.
theorem cosetRelation.mul_compatible
  shows CompatibleBinary(G.carrier, cosetRelation(G, N), G.mul)
proof
  have subgroup := NormalSubgroup.subgroup with normal
  intros x hx y hy u hu v hv xy uv
  have first : relates(cosetRelation(G, N), x, y) ↔ x⁻¹ * y ∈ N := cosetRelation.relates with *
  have second : relates(cosetRelation(G, N), u, v) ↔ u⁻¹ * v ∈ N := cosetRelation.relates with *
  have target : relates(cosetRelation(G, N), x * u, y * v) ↔ (x * u)⁻¹ * (y * v) ∈ N :=
    cosetRelation.relates with *
  have firstIn := first.forward with xy
  have secondIn := second.forward with uv
  have conj : u⁻¹ * (x⁻¹ * y) * u ∈ N := NormalSubgroup.inv_mul_mem with *
  have product : u⁻¹ * (x⁻¹ * y) * u * (u⁻¹ * v) ∈ N := Subgroup.mul_mem with *
  have same : (x * u)⁻¹ * (y * v) = u⁻¹ * (x⁻¹ * y) * u * (u⁻¹ * v)
    rw mul_inv_rev
    group_simp
  rw ← same at product
  exact target.backward with product

theorem cosetRelation.inv_compatible
  shows CompatibleUnary(G.carrier, cosetRelation(G, N), G.inv)
proof
  have subgroup := NormalSubgroup.subgroup with normal
  intros x hx y hy xy
  have criterion : relates(cosetRelation(G, N), x, y) ↔ x⁻¹ * y ∈ N := cosetRelation.relates with *
  have target : relates(cosetRelation(G, N), x⁻¹, y⁻¹) ↔ (x⁻¹)⁻¹ * y⁻¹ ∈ N := cosetRelation.relates with *
  have member := criterion.forward with xy
  have inverted : (x⁻¹ * y)⁻¹ ∈ N := Subgroup.inv_mem with *
  have conj : x * (x⁻¹ * y)⁻¹ * x⁻¹ ∈ N := NormalSubgroup.mul_mem with *
  have same : (x⁻¹)⁻¹ * y⁻¹ = x * (x⁻¹ * y)⁻¹ * x⁻¹
    rw [inv_inv, mul_inv_rev, inv_inv]
    group_simp
  rw ← same at conj
  exact target.backward with conj

-- The quotient group.
theorem quotientGroup.group
  shows Group(G ⧸ N)
proof
  have subgroup := NormalSubgroup.subgroup with normal
  have equivalence := cosetRelation.equivalence with group, subgroup
  have compatible := cosetRelation.mul_compatible with group, normal
  have invCompatible := cosetRelation.inv_compatible with group, normal
  have parts := Group.parts with group
  have magma := IsGroup.magma with parts
  have monoid := IsGroup.monoid with parts
  have associative := IsMonoid.associative with monoid
  have identity := IsMonoid.identity with monoid
  have inverseLaw := IsGroup.inverse with parts
  have qMagma := quotientBinary.magma with equivalence, magma, compatible
  have qAssociative := quotientBinary.associative with equivalence, magma, compatible, associative
  have qIdentity := quotientBinary.identity with equivalence, magma, compatible, identity
  have qInverse := quotientUnary.inverse with equivalence, magma, compatible, invCompatible, inverseLaw
  unfold quotientGroup
  apply Group.of_parts
  simp [IsGroup, IsMonoid, IsSemigroup]

theorem quotientGroup.mul_class (x y : G)
  shows Group.mul(G ⧸ N)(⟦x⟧[G.carrier, cosetRelation(G, N)], ⟦y⟧[G.carrier, cosetRelation(G, N)]) =
    ⟦x * y⟧[G.carrier, cosetRelation(G, N)]
proof
  have subgroup := NormalSubgroup.subgroup with normal
  have equivalence := cosetRelation.equivalence with group, subgroup
  have compatible := cosetRelation.mul_compatible with group, normal
  have magma := IsGroup.magma with (Group.parts with group)
  rw quotientGroup.operation
  exact quotientBinary.classes with equivalence, magma, compatible, *

theorem quotientGroup.inv_class (x : G)
  shows Group.inv(G ⧸ N)(⟦x⟧[G.carrier, cosetRelation(G, N)]) =
    ⟦x⁻¹⟧[G.carrier, cosetRelation(G, N)]
proof
  have subgroup := NormalSubgroup.subgroup with normal
  have equivalence := cosetRelation.equivalence with group, subgroup
  have invCompatible := cosetRelation.inv_compatible with group, normal
  have function := Group.inverse_function with group
  rw quotientGroup.inverse
  exact quotientUnary.classes with equivalence, function, invCompatible, *

theorem quotientGroup.abelian
  requires abelian : AbelianGroup(G)
  shows AbelianGroup(G ⧸ N)
proof
  have commutative := IsAbelianGroup.commutative with (AbelianGroup.parts with abelian)
  have subgroup := NormalSubgroup.subgroup with normal
  have equivalence := cosetRelation.equivalence with group, subgroup
  have compatible := cosetRelation.mul_compatible with group, normal
  have magma := IsGroup.magma with (Group.parts with group)
  have qgroup := quotientGroup.group with group, normal
  have qParts := Group.parts with qgroup
  have qCommutative := quotientBinary.commutative with equivalence, magma, compatible, commutative
  rw [quotientGroup.carrierOf, quotientGroup.operation, quotientGroup.unit, quotientGroup.inverse] at qParts
  unfold quotientGroup
  apply AbelianGroup.of_parts
  unfold IsAbelianGroup
  exact ⟨qParts, qCommutative⟩

-- The projection onto the quotient.
theorem quotientGroup.projection_hom
  shows quotientProjection(G.carrier, cosetRelation(G, N)) : G →* G ⧸ N
proof
  have subgroup := NormalSubgroup.subgroup with normal
  have equivalence := cosetRelation.equivalence with group, subgroup
  have qgroup := quotientGroup.group with group, normal
  have function := quotientProjection.function at G.carrier, cosetRelation(G, N) with equivalence
  have projection : quotientProjection(G.carrier, cosetRelation(G, N)) : G.carrier → Group.carrier(G ⧸ N)
    rw quotientGroup.carrierOf
    exact function
  apply GroupHom.mk with group, qgroup, projection
  intros x hx y hy
  have closed : x * y ∈ G by typecheck
  have vx := quotientProjection.value at G.carrier, cosetRelation(G, N), x with *
  have vy := quotientProjection.value at G.carrier, cosetRelation(G, N), y with *
  have output := quotientProjection.value at G.carrier, cosetRelation(G, N), x * y with *
  have lifted := quotientGroup.mul_class with group, normal, hx, hy
  cc

theorem quotientGroup.projection_surjective
  shows SurjectiveBetween(quotientProjection(G.carrier, cosetRelation(G, N)), G.carrier,
    Group.carrier(G ⧸ N))
proof
  have subgroup := NormalSubgroup.subgroup with normal
  have equivalence := cosetRelation.equivalence with group, subgroup
  rw quotientGroup.carrierOf
  exact quotientProjection.surjective with equivalence

theorem quotientGroup.projection_kernel
  shows kernel(quotientProjection(G.carrier, cosetRelation(G, N)), G, G ⧸ N) = N
proof
  have subgroup := NormalSubgroup.subgroup with normal
  have equivalence := cosetRelation.equivalence with group, subgroup
  have subset := Subgroup.subset with subgroup
  ext x
  constructor
  . intro hx
    obtain ⟨xIn, vx⟩ := kernel.membership.forward with hx
    rw quotientGroup.unit at vx
    have value := quotientProjection.value at G.carrier, cosetRelation(G, N), x with *
    have criterion := cosetRelation.class_eq_one_iff with group, subgroup, xIn
    apply criterion.forward
    cc
  . intro hx
    have xIn := subset with x, hx
    have value := quotientProjection.value at G.carrier, cosetRelation(G, N), x with *
    have criterion := cosetRelation.class_eq_one_iff with group, subgroup, xIn
    have equal := criterion.backward with hx
    apply kernel.of_value with xIn
    rw quotientGroup.unit
    cc

-- Every normal subgroup is the kernel of a homomorphism.
theorem NormalSubgroup.is_kernel
  shows ∃ f, ∃ H, GroupHom(f, G, H) ∧ kernel(f, G, H) = N
proof
  have hom := quotientGroup.projection_hom with group, normal
  have same := quotientGroup.projection_kernel with group, normal
  refine ⟨quotientProjection(G.carrier, cosetRelation(G, N)), G ⧸ N, hom, same⟩

end QuotientGroup

section Extremes
variable (G : Set)
hypothesis group : Group(G)

-- The quotient by the whole group has one element, and the quotient by
-- the trivial subgroup separates every pair of elements.
theorem quotientGroup.whole_class (x : G)
  shows ⟦x⟧[G.carrier, cosetRelation(G, G.carrier)] = ⟦G.one⟧[G.carrier, cosetRelation(G, G.carrier)]
proof
  have subgroup := Subgroup.whole with group
  have criterion := cosetRelation.class_eq_one_iff with group, subgroup, *
  exact criterion.backward with *

theorem quotientGroup.trivial_class_injective (x y : G)
  requires equal : ⟦x⟧[G.carrier, cosetRelation(G, {G.one})] = ⟦y⟧[G.carrier, cosetRelation(G, {G.one})]
  shows x = y
proof
  have subgroup := Subgroup.trivial with group
  have criterion : ⟦x⟧[G.carrier, cosetRelation(G, {G.one})] = ⟦y⟧[G.carrier, cosetRelation(G, {G.one})] ↔
      x⁻¹ * y ∈ {G.one} := cosetRelation.class_eq_iff with *
  have member := criterion.forward with equal
  have vanishes := singleton.membership.forward with member
  have solved : x⁻¹ * y = G.one ↔ x = y := inv_mul_eq_one with *
  exact solved.forward with vanishes

end Extremes
