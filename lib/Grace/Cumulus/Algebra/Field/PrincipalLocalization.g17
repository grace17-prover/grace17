module Grace.Cumulus.Algebra.Field.PrincipalLocalization
import Localization
import Powers
import Ring.Image

def denominatorPowers (B times unit s : Set) : Set :=
  {d ∈ B | ∃ n, Nat(n) ∧ d = monoidPow(times, unit, s, n)}

notation scoped denominatorPowers(R, s) => denominatorPowers(R.carrier, R.mul, R.one, s)

theorem denominatorPowers.one_mem (B times unit s : Set)
  requires oneIn : unit ∈ B
  shows unit ∈ denominatorPowers(B, times, unit, s)
proof
  have natural := Naturals.constructor.zero
  have value := monoidPow.zero at times, unit, s
  apply denominatorPowers.membership.backward
  refine ⟨oneIn, zero, natural, ?_⟩
  rw value
  rfl

theorem monoidPow.in_subring (B plus z minus times unit T s : Set) (n : Nat)
  requires subring : IsSubring(B, plus, z, minus, times, unit, T)
  requires element : s ∈ T
  shows monoidPow(times, unit, s, n) ∈ T
proof
  induction n
  | zero =>
    rw monoidPow.zero
    exact IsSubring.one_closed with subring
  | succ(k) using ih =>
    have closed := IsSubring.mul_closed with subring
    rw monoidPow.succ
    exact ClosedBinary.mem with closed, element, ih

section Powers
variable (B plus z minus times unit s y : Set)
notation ring S := (B, plus, z, minus, times, unit)
hypothesis ring : IsCommRing(S)
hypothesis inverse : IsInverse(B, times, unit, s, y)

theorem IsInverse.powers (n : Nat)
  shows IsInverse(B, times, unit, monoidPow(S, s, n), monoidPow(S, y, n))
proof
  induction n
  | zero =>
    have ordinary := IsCommRing.ring with ring
    have monoid := IsRing.multiplicative with ordinary
    have oneIn := IsMonoid.unit_in_carrier with monoid
    have equation : S[1 * 1] = S[1] by ring
    rw monoidPow.zero
    rw monoidPow.zero
    unfold IsInverse
    refine ⟨oneIn, oneIn, equation, equation⟩
  | succ(k) using ih =>
    have ordinary := IsCommRing.ring with ring
    have monoid := IsRing.multiplicative with ordinary
    have data := inverse
    have inS := data.left
    have inY := data.right.left
    have inP := ih.left
    have inQ := ih.right.left
    have cancels := data.right.right.right
    have powersCancel := ih.right.right.right
    have productP := IsRing.mul_closed with ordinary, inS, inP
    have productQ := IsRing.mul_closed with ordinary, inY, inQ
    have right : S[(s * monoidPow(S, s, k)) * (y * monoidPow(S, y, k))] = S[1]
      have rearrange : S[(s * monoidPow(S, s, k)) * (y * monoidPow(S, y, k))] = S[(s * y) * (monoidPow(S, s, k) * monoidPow(S, y, k))]
        ring
      rw rearrange
      rw cancels
      rw powersCancel
      ring
    have left : S[(y * monoidPow(S, y, k)) * (s * monoidPow(S, s, k))] = S[1]
      have commute : S[(y * monoidPow(S, y, k)) * (s * monoidPow(S, s, k))] = S[(s * monoidPow(S, s, k)) * (y * monoidPow(S, y, k))]
        ring
      rw commute
      exact right
    rw monoidPow.succ
    rw monoidPow.succ
    unfold IsInverse
    refine ⟨productP, productQ, left, right⟩

end Powers

section Fields
variable (B plus z minus times unit T s : Set)
notation ring S := (B, plus, z, minus, times, unit)
hypothesis field : IsField(S)
hypothesis subring : IsSubring(S, T)
hypothesis element : s ∈ T
hypothesis nonzero : s ≠ S[0]

theorem monoidPow.nonzero_in_field (n : Nat)
  shows monoidPow(S, s, n) ≠ S[0]
proof
  induction n
  | zero =>
    have distinct := IsField.nontrivial with field
    rw monoidPow.zero
    intro equal
    have reversed : S[0] = S[1] by cc
    exact distinct.right.right with reversed
  | succ(k) using ih =>
    have noZero := IsField.no_zero_divisors with field
    have ring := IsField.comm_ring with field
    have ordinary := IsCommRing.ring with ring
    have monoid := IsRing.multiplicative with ordinary
    have bound := IsSubring.subset_carrier with subring
    have sIn : s ∈ S by simp [Subset]
    have previous := monoidPow.closed at B, times, unit, s, k with *
    rw monoidPow.succ
    intro zeroProduct
    have alternatives := noZero with s, sIn, monoidPow(S, s, k), previous, zeroProduct
    cases alternatives with left | right
    . exact nonzero with left
    . exact ih with right

theorem denominatorPowers.denominators
  shows Denominators(S, T, denominatorPowers(S, s))
proof
  have ring := IsField.comm_ring with field
  have ordinary := IsCommRing.ring with ring
  have monoid := IsRing.multiplicative with ordinary
  have bound := IsSubring.subset_carrier with subring
  have sIn : s ∈ S by simp [Subset]
  have oneIn := IsMonoid.unit_in_carrier with monoid
  have included : denominatorPowers(S, s) ⊆ T
    intros d hd
    obtain ⟨inD, n, natural, value⟩ := denominatorPowers.membership.forward with hd
    have member := monoidPow.in_subring with *
    rwa value
  have one : S[1] ∈ denominatorPowers(S, s)
    have natural := Naturals.constructor.zero
    have value := monoidPow.zero at times, unit, s
    apply denominatorPowers.membership.backward
    refine ⟨oneIn, zero, natural, ?_⟩
    rw value
    rfl
  have closed : ClosedBinary(denominatorPowers(S, s), times)
    intros x hx y hy
    obtain ⟨inX, m, naturalM, valueX⟩ := denominatorPowers.membership.forward with hx
    obtain ⟨inY, n, naturalN, valueY⟩ := denominatorPowers.membership.forward with hy
    have product := IsRing.mul_closed with ordinary, inX, inY
    have natural : Nat(add(m, n)) by typecheck
    have sum : monoidPow(S, s, add(m, n)) = S[monoidPow(S, s, m) * monoidPow(S, s, n)]
      exact monoidPow.add with *
    apply denominatorPowers.membership.backward
    refine ⟨product, add(m, n), natural, ?_⟩
    rw [valueX, valueY]
    cc
  have avoidsZero : ∀ d ∈ denominatorPowers(S, s), d ≠ S[0]
    intros d hd
    obtain ⟨inD, n, natural, value⟩ := denominatorPowers.membership.forward with hd
    have distinct := monoidPow.nonzero_in_field with *
    rwa value
  unfold Denominators
  refine ⟨included, one, closed, avoidsZero⟩

theorem localizationWithin.clear_common_power (K : Set)
  requires finite : Finite(K)
  requires included : K ⊆ localizationWithin(S, T, denominatorPowers(S, s))
  shows ∃ n, Nat(n) ∧ (∀ x ∈ K, S[monoidPow(S, s, n) * x] ∈ T)
proof
  have ring := IsField.comm_ring with field
  have denominators := denominatorPowers.denominators with *
  obtain ⟨d, hd, clears⟩ := localizationWithin.clear_finite with ring, subring, denominators, finite, included
  obtain ⟨inD, n, natural, value⟩ := denominatorPowers.membership.forward with hd
  refine ⟨n, natural, ?_⟩
  intros x hx
  have member := clears with x, hx
  rwa value at member

theorem localizationWithin.adjoin_single_inverse (y : Set)
  requires inverse : IsInverse(B, times, unit, s, y)
  shows localizationWithin(S, T, denominatorPowers(S, s)) = generatedSubring(S, insert(y, T))
proof
  have ring := IsField.comm_ring with field
  have denominators := denominatorPowers.denominators at B, plus, z, minus, times, unit, T, s with *
  have bound := IsSubring.subset_carrier with subring
  have yIn : y ∈ S by simp [IsInverse]
  have generatorsBound : insert(y, T) ⊆ S
    intros u hu
    simp [Subset, insert.membership]
  have generated := generatedSubring.subring at B, plus, z, minus, times, unit, insert(y, T) with *
  have contains := generatedSubring.contains with ring, generatorsBound
  have includesT : T ⊆ generatedSubring(S, insert(y, T))
    intros u hu
    have member := insert.contains at u, y, T with hu
    exact contains with u, member
  have containsY : y ∈ generatedSubring(S, insert(y, T))
    have member := insert.self at y, T
    exact contains with y, member
  have inverses : ∀ d ∈ denominatorPowers(S, s), ∃ v ∈ generatedSubring(S, insert(y, T)), IsInverse(B, times, unit, d, v)
    intros d hd
    obtain ⟨inD, n, natural, value⟩ := denominatorPowers.membership.forward with hd
    have member := monoidPow.in_subring at B, plus, z, minus, times, unit, generatedSubring(S, insert(y, T)), y, n with *
    have powers := IsInverse.powers at B, plus, z, minus, times, unit, s, y, n with *
    refine ⟨monoidPow(S, y, n), member, ?_⟩
    rwa value
  have first := localizationWithin.least with ring, subring, denominators, generated, includesT, inverses
  have localized := localizationWithin.subring with ring, subring, denominators
  have original := localizationWithin.contains with ring, subring, denominators
  have sIn : s ∈ S by simp [Subset]
  have sDenominator : s ∈ denominatorPowers(S, s)
    have natural := Naturals.constructor.succ with Naturals.constructor.zero
    have value : monoidPow(S, s, succ(zero)) = s
      rw [monoidPow.succ, monoidPow.zero]
      ring
    apply denominatorPowers.membership.backward
    refine ⟨sIn, succ(zero), natural, ?_⟩
    rw value
    rfl
  have localizedY := localizationWithin.inverse_mem with ring, subring, denominators, sDenominator, inverse
  have generators : insert(y, T) ⊆ localizationWithin(S, T, denominatorPowers(S, s))
    intros u hu
    have alternatives := insert.membership.forward with hu
    cases alternatives with equal | old
    . rw equal
      exact localizedY
      exact original with u, old
  have second := generatedSubring.least with ring, localized, generators
  exact Subset.antisymmetric with first, second

end Fields
section Maps
variable (A add z neg mul one B plus o minus times unit f s : Set)
notation ring R := (A, add, z, neg, mul, one)
notation ring S := (B, plus, o, minus, times, unit)
hypothesis source : IsCommRing(R)
hypothesis target : IsCommRing(S)
hypothesis hom : IsRingHom(f, R, S)
hypothesis element : s ∈ R

theorem IsRingHom.denominator_powers
  shows functionImage(f, denominatorPowers(R, s), S) = denominatorPowers(S, f(s))
proof
  have function := IsRingHom.function with hom
  have ordinary := IsCommRing.ring with source
  have monoid := IsRing.multiplicative with ordinary
  have bounded : denominatorPowers(R, s) ⊆ R by simp [Subset, denominatorPowers]
  ext d
  constructor
  . intro member
    obtain ⟨inS, a, inD, equal⟩ := functionImage.membership.forward with member
    obtain ⟨inA, n, natural, shape⟩ := denominatorPowers.membership.forward with inD
    have mapped := IsRingHom.power at A, add, z, neg, mul, one, B, plus, o, minus, times, unit, f, s, n with *
    apply denominatorPowers.membership.backward
    refine ⟨inS, n, natural, ?_⟩
    cc
  . intro member
    obtain ⟨inS, n, natural, shape⟩ := denominatorPowers.membership.forward with member
    have power := monoidPow.closed with *
    have inD : monoidPow(R, s, n) ∈ denominatorPowers(R, s)
      apply denominatorPowers.membership.backward
      refine ⟨power, n, natural, ?_⟩
      rfl
    have mapped := IsRingHom.power at A, add, z, neg, mul, one, B, plus, o, minus, times, unit, f, s, n with *
    apply functionImage.membership.backward
    refine ⟨inS, monoidPow(R, s, n), inD, ?_⟩
    cc

theorem IsRingHom.principal_localization_subring
  requires field : IsField(S)
  requires injective : InjectiveBetween(f, R, S)
  requires nonzero : s ≠ R[0]
  shows IsSubring(S, localizationWithin(S, functionImage(f, R, S), functionImage(f, denominatorPowers(R, s), S)))
proof
  have image := IsRingHom.image_subring with *
  have function := IsRingHom.function with hom
  have member := functionImage.value with *
  have zeroIn : R[0] ∈ R by typecheck
  have zeroValue := IsRingHom.zero with hom
  have distinct : f(s) ≠ S[0]
    intro vanishes
    have equal : f(s) = f(R[0]) by cc
    have closed := FunctionBetween.apply_closed at f, A, B, s with *
    have first := FunctionBetween.relates_apply at f, A, B, s with *
    have second := FunctionBetween.relates_apply at f, A, B, z with *
    rw ← equal at second
    have impossible := Injective.cancel at f, A, B, s, z, f(s) with *
    exact nonzero with impossible
  have denominators := denominatorPowers.denominators with *
  have mapped := IsRingHom.denominator_powers at A, add, z, neg, mul, one, B, plus, o, minus, times, unit, f, s with *
  rw mapped
  exact localizationWithin.subring with *

end Maps
