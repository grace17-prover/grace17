module Grace.Cumulus.Algebra.Field.FiniteAlgebraicLocalization
import AlgebraicLocalization

section Fields
variable (A add z neg mul one B plus o minus times unit f K : Set)
notation ring R := (A, add, z, neg, mul, one)
notation ring S := (B, plus, o, minus, times, unit)
hypothesis source : IsCommRing(R)
hypothesis field : IsField(S)
hypothesis hom : IsRingHom(f, R, S)
hypothesis injective : InjectiveBetween(f, R, S)
hypothesis algebraic : ∀ x ∈ K, AlgebraicOver(f, R, S, x)

theorem algebraicList.common_leading_multiple (xs : List(K))
  shows ∃ s ∈ R, s ≠ R[0] ∧ (∀ x ∈ listSupport{K}(xs), ∃ a ∈ R, ∃ b ∈ R,
    R[a * b] = s ∧ (∃ cs, List(A, cs) ∧ polynomialHorner{A}(f, plus, times, x, a, cs) = o))
proof
  induction xs
  | List.nil =>
    have domain : IsIntegralDomain(R)
      exact IsRingHom.domain_of_field_embedding with *
    have nontrivial := IsIntegralDomain.nontrivial with domain
    have distinct := Nontrivial.distinct with nontrivial
    have oneIn : R[1] ∈ R by typecheck
    have oneNonzero : R[1] ≠ R[0]
      intro equal
      apply distinct
      cc
    refine ⟨R[1], oneIn, oneNonzero, ?_⟩
    intros x member
    rw listSupport at member
    exfalso
    exact set.empty with member
  | List.cons(x, tail) using ih =>
    have ordinary := IsCommRing.ring with source
    have domain : IsIntegralDomain(R)
      exact IsRingHom.domain_of_field_embedding with *
    have noZero := IsIntegralDomain.no_zero_divisors with domain
    have member : x ∈ K by assumption
    have root := algebraic with x, member
    obtain ⟨a, aIn, nonzeroA, cs, list, relation⟩ := root.right
    obtain ⟨s, sIn, nonzeroS, previous⟩ := ih
    have product := IsRing.mul_closed with ordinary, aIn, sIn
    have nonzero : R[a * s] ≠ R[0]
      intro vanishes
      have alternatives := noZero with a, aIn, s, sIn, vanishes
      tauto
    refine ⟨R[a * s], product, nonzero, ?_⟩
    intros y inList
    rw listSupport at inList
    have alternatives := insert.membership.forward with inList
    cases alternatives with same | inTail
    . have relationY : polynomialHorner{A}(f, plus, times, y, a, cs) = o
        rwa same
      refine ⟨a, aIn, s, sIn, rfl, cs, list, relationY⟩
    . obtain ⟨c, cIn, b, bIn, divides, ds, listD, relationD⟩ := previous with y, inTail
      have factor := IsRing.mul_closed with ordinary, aIn, bIn
      have equality : R[c * (a * b)] = R[a * s]
        have rearrange : R[c * (a * b)] = R[a * (c * b)] by ring
        rw [rearrange, divides]
        rfl
      refine ⟨c, cIn, R[a * b], factor, equality, ds, listD, relationD⟩

theorem AlgebraicOver.finite_principal_integral
  requires finite : Finite(K)
  shows ∃ s ∈ R, s ≠ R[0] ∧ (∀ x ∈ K,
    IntegralOver(identity(localizationWithin(S, functionImage(f, R, S), denominatorPowers(S, f(s)))), localizationWithin(S, functionImage(f, R, S), denominatorPowers(S, f(s))), S, x))
proof
  have target := IsField.comm_ring with field
  have ordinary := IsCommRing.ring with target
  have function := IsRingHom.function with hom
  have imageRing : IsSubring(S, functionImage(f, R, S))
    exact IsRingHom.image_subring with *
  obtain ⟨xs, list, covers⟩ := Finite.list_cover with finite
  obtain ⟨s, sIn, nonzero, witnesses⟩ := algebraicList.common_leading_multiple at A, add, z, neg, mul, one, B, plus, o, minus, times, unit, f, K, xs with *
  have zeroIn : R[0] ∈ R by typecheck
  have zero := IsRingHom.zero with hom
  have image := IsRingHom.closed with hom, sIn
  have inImage := functionImage.value at f, R, S, s with *
  have imageNonzero : f(s) ≠ S[0]
    intro vanishes
    have equal : f(s) = f(R[0]) by cc
    have original := Injective.apply_cancel with injective, sIn, equal
    exact nonzero with original
  have denominators := denominatorPowers.denominators with *
  have localized := localizationWithin.subring with target, imageRing, denominators
  have contains := localizationWithin.contains with target, imageRing, denominators
  have coefficients : ∀ c ∈ R, f(c) ∈ localizationWithin(S, functionImage(f, R, S), denominatorPowers(S, f(s)))
    intros c member
    have value := functionImage.value at f, R, S, c with *
    exact contains with f(c), value
  obtain ⟨y, inverse⟩ := IsField.inverse_exists at B, plus, o, minus, times, unit, f(s) with *
  have power : monoidPow(S, f(s), (1:Nat)) = f(s)
    rw [monoidPow.succ, monoidPow.zero]
    ring
  have natural := Naturals.constructor.succ with Naturals.constructor.zero
  have denominator : f(s) ∈ denominatorPowers(S, f(s))
    apply denominatorPowers.membership.backward
    refine ⟨image, (1:Nat), natural, ?_⟩
    symm
    exact power
  have inverseIn := localizationWithin.inverse_mem with target, imageRing, denominators, denominator, inverse
  have data := inverse
  have yIn := data.right.left
  have cancels := data.right.right.right
  have multiplication := IsSubring.mul_closed with localized
  refine ⟨s, sIn, nonzero, ?_⟩
  intros x inK
  have inList : x ∈ listSupport{K}(xs) by exact covers with x, inK
  obtain ⟨a, aIn, b, bIn, divides, cs, listC, relation⟩ := witnesses with x, inList
  have algebraicX := algebraic with x, inK
  have element := algebraicX.left
  have imageA := IsRingHom.closed with hom, aIn
  have imageB := IsRingHom.closed with hom, bIn
  have coefficientB := coefficients with b, bIn
  have candidateIn := ClosedBinary.mem with multiplication, coefficientB, inverseIn
  have candidate := IsRing.mul_closed with ordinary, imageB, yIn
  have mapped := IsRingHom.mul with hom, aIn, bIn
  have leadingInverse : S[f(a) * (f(b) * y)] = S[1]
    have rearrange : S[f(a) * (f(b) * y)] = S[(f(a) * f(b)) * y] by ring
    rwa [rearrange, ← mapped, divides]
  have inverseLeading : IsInverse(B, times, unit, f(a), S[f(b) * y])
    unfold IsInverse
    refine ⟨imageA, candidate, ?_⟩
    constructor
    . have commute : S[(f(b) * y) * f(a)] = S[f(a) * (f(b) * y)]
        ring
      rwa commute
    . exact leadingInverse
  exact IntegralOver.of_invertible_leading with *

end Fields
