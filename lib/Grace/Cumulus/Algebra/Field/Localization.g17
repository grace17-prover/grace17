module Grace.Cumulus.Algebra.Field.Localization
import ClearDenominators

def denominatorInverses (B times unit D : Set) : Set :=
  {y ∈ B | ∃ d ∈ D, IsInverse(B, times, unit, d, y)}

notation scoped denominatorInverses(R, D) => denominatorInverses(R.carrier, R.mul, R.one, D)

theorem denominatorInverses.subset (B times unit D : Set)
  shows denominatorInverses(B, times, unit, D) ⊆ B
proof
  simp

section Fields
variable (B plus z minus times unit T D : Set)
notation ring S := (B, plus, z, minus, times, unit)
hypothesis field : IsField(S)
hypothesis subring : IsSubring(S, T)
hypothesis denominators : Denominators(S, T, D)

theorem denominatorInverses.exists (d : Set)
  requires member : d ∈ D
  shows ∃ y ∈ denominatorInverses(S, D), IsInverse(B, times, unit, d, y)
proof
  have ring := IsField.comm_ring with field
  have bound := IsSubring.subset_carrier with subring
  have denomBound := Denominators.subset with ring, subring, denominators
  have ambient := Subset.transitive with denomBound, bound
  have inB : d ∈ S by simp [Subset]
  have nonzero := Denominators.nonzero with ring, subring, denominators, member
  obtain ⟨y, inverse⟩ := IsField.inverse_exists with field, inB, nonzero
  have yIn : y ∈ S by simp [IsInverse]
  have included : y ∈ denominatorInverses(S, D)
    exact denominatorInverses.membership.backward with ⟨yIn, d, member, inverse⟩
  refine ⟨y, included, inverse⟩

theorem denominatorInverses.localized
  shows denominatorInverses(S, D) ⊆ localizationWithin(S, T, D)
proof
  have ring := IsField.comm_ring with field
  intros y hy
  obtain ⟨yIn, d, hd, inverse⟩ := denominatorInverses.membership.forward with hy
  exact localizationWithin.inverse_mem with ring, subring, denominators, hd, inverse

theorem localizationWithin.generated
  shows localizationWithin(S, T, D) = generatedSubring(S, T ∪ denominatorInverses(S, D))
proof
  have ring := IsField.comm_ring with field
  have bound := IsSubring.subset_carrier with subring
  have inverseBound := denominatorInverses.subset at B, times, unit, D
  have generatorsBound : T ∪ denominatorInverses(S, D) ⊆ S
    settle with Subset, union2.membership
  have generated := generatedSubring.subring at B, plus, z, minus, times, unit, T ∪ denominatorInverses(S, D) with *
  have contains := generatedSubring.contains with ring, generatorsBound
  have includesT : T ⊆ generatedSubring(S, T ∪ denominatorInverses(S, D))
    settle with Subset, union2.membership
  have inverses : ∀ d ∈ D, ∃ y ∈ generatedSubring(S, T ∪ denominatorInverses(S, D)), IsInverse(B, times, unit, d, y)
    intros d hd
    obtain ⟨y, hy, inverse⟩ := denominatorInverses.exists with field, subring, denominators, hd
    have member : y ∈ generatedSubring(S, T ∪ denominatorInverses(S, D))
      settle with Subset, union2.membership
    refine ⟨y, member, inverse⟩
  have first := localizationWithin.least with ring, subring, denominators, generated, includesT, inverses
  have localized := localizationWithin.subring with ring, subring, denominators
  have original := localizationWithin.contains with ring, subring, denominators
  have inverseIncluded := denominatorInverses.localized with field, subring, denominators
  have generators : T ∪ denominatorInverses(S, D) ⊆ localizationWithin(S, T, D)
    settle with Subset, union2.membership
  have second := generatedSubring.least with ring, localized, generators
  exact Subset.antisymmetric with first, second

theorem IsSubring.eq_field_of_uniform_denominator (d : Set)
  requires member : d ∈ D
  requires clears : ∀ x ∈ S, S[d * x] ∈ T
  shows T = S
proof
  have ring := IsField.comm_ring with field
  have ordinary := IsCommRing.ring with ring
  have bound := IsSubring.subset_carrier with subring
  have denomBound := Denominators.subset with ring, subring, denominators
  have ambient := Subset.transitive with denomBound, bound
  have dIn : d ∈ S by simp [Subset]
  have nonzero := Denominators.nonzero with ring, subring, denominators, member
  obtain ⟨y, inverse⟩ := IsField.inverse_exists with field, dIn, nonzero
  have yIn := inverse.right.left
  have cancels := inverse.right.right.right
  apply Subset.antisymmetric
  . exact bound
    intros x hx
    have product := IsRing.mul_closed with ordinary, yIn, hx
    have numerator := clears with S[y * x], product
    have associate : S[d * (y * x)] = S[(d * y) * x] by ring
    rw [associate, cancels] at numerator
    have identity : S[1 * x] = x by ring
    rwa identity at numerator

end Fields

section Algebras
variable (A add zero neg mul one B plus z minus times unit f T D : Set)
notation ring R := (A, add, zero, neg, mul, one)
notation ring S := (B, plus, z, minus, times, unit)
hypothesis source : IsCommRing(R)
hypothesis field : IsField(S)
hypothesis hom : IsRingHom(f, R, S)
hypothesis subalgebra : Subalgebra(f, R, S, T)
hypothesis denominators : Denominators(S, T, D)

theorem localizationWithin.eq_field_of_finite_module
  requires finite : FiniteAlgebraModule(f, R, S)
  requires fractions : localizationWithin(S, T, D) = S
  shows T = S
proof
  have target := IsField.comm_ring with field
  have subring := Subalgebra.subring with source, target, hom, subalgebra
  have finiteSpan := FiniteSpan.target_iff.backward with source, target, hom, finite
  have included : S ⊆ localizationWithin(S, T, D)
    rw fractions
    exact Subset.reflexive
  obtain ⟨d, hd, clears⟩ := localizationWithin.clear_finite_span with source, target, hom, subalgebra, denominators, finiteSpan, included
  exact IsSubring.eq_field_of_uniform_denominator with field, subring, denominators, hd, clears

end Algebras
