module Grace.Cumulus.Algebra.Field.Construction
import Core

predicate IsField (A add zero neg mul one : Set) :=
  IsCommRing(A, add, zero, neg, mul, one) ∧ Nontrivial(A, zero, one) ∧
  (∀ x ∈ A, x ≠ zero → ∃ y, IsInverse(A, mul, one, x, y))

notation scoped IsField(R) => IsField(R.carrier, R.add, R.zero, R.neg, R.mul, R.one)

theorem IsField.comm_ring (A add zero neg mul one : Set)
  requires structure : IsField(A, add, zero, neg, mul, one)
  shows IsCommRing(A, add, zero, neg, mul, one)
proof
  simp [IsField]

theorem IsField.nontrivial (A add zero neg mul one : Set)
  requires structure : IsField(A, add, zero, neg, mul, one)
  shows Nontrivial(A, zero, one)
proof
  simp [IsField]

theorem IsField.inverse_exists (A add zero neg mul one x : Set)
  requires structure : IsField(A, add, zero, neg, mul, one)
  requires hx : x ∈ A
  requires nonzero : x ≠ zero
  shows ∃ y, IsInverse(A, mul, one, x, y)
proof
  exact structure.right.right with x, hx, nonzero

-- The zero branch is normalized to zero. Away from zero, uniqueness
-- follows from the monoid inverse-uniqueness theorem.
defunique fieldInverseValue (A add zero neg mul one x : Set) (y ∈ A) :=
  (x = zero ∧ y = zero) ∨ (x ≠ zero ∧ IsInverse(A, mul, one, x, y))
requires structure : IsField(A, add, zero, neg, mul, one)
requires hx : x ∈ A
proof
  have nontrivial := IsField.nontrivial with structure
  have alternatives : x = zero ∨ x ≠ zero by tauto
  cases alternatives with isZero | nonzero
  . witness zero
    refine ⟨nontrivial.left, ?_⟩
    left
    refine ⟨isZero, rfl⟩
  . obtain ⟨y, inverse⟩ := IsField.inverse_exists at A, add, zero, neg, mul, one, x with *
    have yInA : y ∈ A by simp [IsInverse]
    witness y
    refine ⟨yInA, ?_⟩
    right
    refine ⟨nonzero, inverse⟩
uniqueness
  intros y hy propertyY z hz propertyZ
  cases propertyY with yZero | yInverse
  . cases propertyZ with zZero | zInverse
    . have yValue := yZero.right
      have zValue := zZero.right
      cc
    . exfalso
      exact zInverse.left with yZero.left
  . cases propertyZ with zZero | zInverse
    . exfalso
      exact yInverse.left with zZero.left
    . have ring := IsField.comm_ring with structure
      have ordinary := IsCommRing.ring with ring
      have monoid := IsRing.multiplicative with ordinary
      exact IsInverse.unique with monoid, yInverse.right, zInverse.right

defgraph fieldInverse (A add zero neg mul one : Set) (x ∈ A) : A := fieldInverseValue(A, add, zero, neg, mul, one, x)
requires structure : IsField(A, add, zero, neg, mul, one)
proof
  have selected := fieldInverseValue.selected at A, add, zero, neg, mul, one, x with *
  exact selected.left

theorem fieldInverse.inverse (A add zero neg mul one x : Set)
  requires structure : IsField(A, add, zero, neg, mul, one)
  requires hx : x ∈ A
  requires nonzero : x ≠ zero
  shows IsInverse(A, mul, one, x, (fieldInverse(A, add, zero, neg, mul, one))(x))
proof
  have selected := fieldInverseValue.selected at A, add, zero, neg, mul, one, x with *
  have inverse : IsInverse(A, mul, one, x, fieldInverseValue(A, add, zero, neg, mul, one, x)) by tauto
  have value := fieldInverse.value at A, add, zero, neg, mul, one, x with *
  rwa value

theorem fieldInverse.zero (A add zero neg mul one : Set)
  requires structure : IsField(A, add, zero, neg, mul, one)
  shows (fieldInverse(A, add, zero, neg, mul, one))(zero) = zero
proof
  have nontrivial := IsField.nontrivial with structure
  have hz := nontrivial.left
  have selected := fieldInverseValue.selected at A, add, zero, neg, mul, one, zero with *
  have reflexive : zero = zero by rfl
  have chosen : fieldInverseValue(A, add, zero, neg, mul, one, zero) = zero by tauto
  have value := fieldInverse.value at A, add, zero, neg, mul, one, zero with *
  cc

theorem IsField.field (A add zero neg mul one : Set)
  requires structure : IsField(A, add, zero, neg, mul, one)
  shows IsFieldWithInverse(A, add, zero, neg, mul, one, fieldInverse(A, add, zero, neg, mul, one))
proof
  have ring := IsField.comm_ring with structure
  have nontrivial := IsField.nontrivial with structure
  have function := fieldInverse.function at A, add, zero, neg, mul, one with *
  unfold IsFieldWithInverse
  refine ⟨ring, nontrivial, ?_⟩
  unfold MultiplicativeInverse
  refine ⟨function, ?_⟩
  intros x hx nonzero
  have inverse := fieldInverse.inverse with *
  exact inverse.right.right

theorem IsFieldWithInverse.is_field (A add zero neg mul one inv : Set)
  requires field : IsFieldWithInverse(A, add, zero, neg, mul, one, inv)
  shows IsField(A, add, zero, neg, mul, one)
proof
  have ring := IsFieldWithInverse.comm_ring with field
  have nontrivial := IsFieldWithInverse.nontrivial with field
  unfold IsField
  refine ⟨ring, nontrivial, ?_⟩
  intros x hx nonzero
  have closed := IsFieldWithInverse.inverse_closed with *
  have left := IsFieldWithInverse.inverse_left with *
  have right := IsFieldWithInverse.inverse_right with *
  witness inv(x)
  unfold IsInverse
  refine ⟨hx, closed, left, right⟩

theorem IsField.iff_exists_inverse (A add zero neg mul one : Set)
  shows IsField(A, add, zero, neg, mul, one) ↔ ∃ inv, IsFieldWithInverse(A, add, zero, neg, mul, one, inv)
proof
  constructor
  . intro structure
    have field := IsField.field with structure
    refine ⟨fieldInverse(A, add, zero, neg, mul, one), field⟩
  . intro existence
    obtain ⟨inv, field⟩ := existence
    exact IsFieldWithInverse.is_field with field

section Domains
variable (A add zero neg mul one : Set)
notation ring R := (A, add, zero, neg, mul, one)
hypothesis field : IsField(R)

theorem IsField.no_zero_divisors
  shows NoZeroDivisors(A, mul, zero)
proof
  have ring := IsField.comm_ring with field
  have ordinary := IsCommRing.ring with ring
  intros x hx y hy equation
  have alternatives : x = zero ∨ x ≠ zero by tauto
  cases alternatives with isZero | nonzero
  . left
    exact isZero
  . obtain ⟨v, inverse⟩ := IsField.inverse_exists with field, hx, nonzero
    have inV := inverse.right.left
    have cancels := inverse.right.right.left
    right
    have associate : R[v * (x * y)] = R[(v * x) * y] by ring
    rw [equation, cancels] at associate
    have zeroProduct : R[v * 0] = zero by ring
    have oneProduct : R[1 * y] = y by ring
    cc

theorem IsField.integral_domain
  shows IsIntegralDomain(A, add, zero, neg, mul, one)
proof
  have ring := IsField.comm_ring with field
  have nontrivial := IsField.nontrivial with field
  have noZero := IsField.no_zero_divisors with field
  unfold IsIntegralDomain
  refine ⟨ring, nontrivial, noZero⟩

end Domains
