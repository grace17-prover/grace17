module Grace.Cumulus.Algebra.CoefficientSingle
import Coefficients

defunique singleValue (A z a j i : Set) (value ∈ A) :=
  (i = j → value = a) ∧ (i ≠ j → value = z)
requires zeroIn : z ∈ A
requires coefficient : a ∈ A
proof
  have casesI : i = j ∨ i ≠ j
    tauto
  cases casesI with same | different
  . witness a
    refine ⟨coefficient, _, _⟩
    . intro equal
      rfl
    . intro impossible
      exfalso
      exact impossible with same
  . witness z
    refine ⟨zeroIn, _, _⟩
    . intro impossible
      exfalso
      exact different with impossible
    . intro unequal
      rfl
uniqueness
  intros u uIn first v vIn second
  have casesI : i = j ∨ i ≠ j
    tauto
  cases casesI with same | different
  . have uValue : u = a
      tauto
    have vValue : v = a
      tauto
    cc
  . have uValue : u = z
      tauto
    have vValue : v = z
      tauto
    cc

theorem singleValue.closed (A z a j i : Set)
  requires zeroIn : z ∈ A
  requires coefficient : a ∈ A
  shows singleValue(A, z, a, j, i) ∈ A
proof
  have selected := singleValue.selected at A, z, a, j, i with *
  exact selected.left

theorem singleValue.same (A z a j i : Set)
  requires zeroIn : z ∈ A
  requires coefficient : a ∈ A
  requires equal : i = j
  shows singleValue(A, z, a, j, i) = a
proof
  have selected := singleValue.selected at A, z, a, j, i with *
  tauto

theorem singleValue.other (A z a j i : Set)
  requires zeroIn : z ∈ A
  requires coefficient : a ∈ A
  requires different : i ≠ j
  shows singleValue(A, z, a, j, i) = z
proof
  have selected := singleValue.selected at A, z, a, j, i with *
  tauto

-- Selecting a zero coefficient remains zero for either branch.
theorem singleValue.zero (A z j i : Set)
  requires zeroIn : z ∈ A
  shows singleValue(A, z, z, j, i) = z
proof
  have alternatives : i = j ∨ i ≠ j by tauto
  cases alternatives with same | different
  . exact singleValue.same with *
  . exact singleValue.other with *

-- Filtering before grouping agrees with filtering the selected group.
theorem singleValue.iterated (A z a k x c b : Set)
  requires zeroIn : z ∈ A
  requires coefficient : a ∈ A
  shows singleValue(A, z, singleValue(A, z, a, k(x), b), x, c) =
    singleValue(A, z, singleValue(A, z, a, x, c), k(c), b)
proof
  have alternatives : c = x ∨ c ≠ x by tauto
  cases alternatives with same | different
  . have left := singleValue.same at A, z, singleValue(A, z, a, k(x), b), x, c with *
    have right := singleValue.same at A, z, a, x, c with *
    cc
  . have left := singleValue.other at A, z, singleValue(A, z, a, k(x), b), x, c with *
    have innerRight := singleValue.other at A, z, a, x, c with *
    have right := singleValue.zero at A, z, k(c), b with *
    cc

defgraph coefficientSingle (I A z a j : Set) (i ∈ I) : A := singleValue(A, z, a, j, i)
requires zeroIn : z ∈ A
requires coefficient : a ∈ A
proof
  exact singleValue.closed with *

theorem coefficientSingle.same (I A z a j : Set)
  requires zeroIn : z ∈ A
  requires coefficient : a ∈ A
  requires index : j ∈ I
  shows coefficientSingle(I, A, z, a, j)(j) = a
proof
  have value := coefficientSingle.value at I, A, z, a, j, j with *
  have equal : j = j by rfl
  have selected := singleValue.same at A, z, a, j, j with *
  cc

theorem coefficientSingle.other (I A z a j i : Set)
  requires zeroIn : z ∈ A
  requires coefficient : a ∈ A
  requires index : i ∈ I
  requires different : i ≠ j
  shows coefficientSingle(I, A, z, a, j)(i) = z
proof
  have value := coefficientSingle.value at I, A, z, a, j, i with *
  have selected := singleValue.other at A, z, a, j, i with *
  cc

theorem coefficientSingle.support_membership (I A z a j i : Set)
  requires zeroIn : z ∈ A
  requires coefficient : a ∈ A
  shows i ∈ functionSupport(coefficientSingle(I, A, z, a, j), I, z) ↔ i ∈ I ∧ i = j ∧ a ≠ z
proof
  constructor
  . intro member
    have data := functionSupport.membership.forward with member
    have equal : i = j
      have alternatives : i = j ∨ i ≠ j by tauto
      cases alternatives with same | different
      . exact same
      . have value := coefficientSingle.other at I, A, z, a, j, i with *
        have contradiction := data.right with value
        tauto
    have nonzero : a ≠ z
      intro vanishes
      have atIndex : j ∈ I
        rw ← equal
        exact data.left
      have value := coefficientSingle.same at I, A, z, a, j with *
      have vanishing : coefficientSingle(I, A, z, a, j)(i) = z by cc
      exact data.right with vanishing
    refine ⟨data.left, equal, nonzero⟩
  . intro data
    rcases data with ⟨index, equal, nonzero⟩
    have atIndex : j ∈ I by rwa ← equal
    have value := coefficientSingle.same at I, A, z, a, j with *
    have different : coefficientSingle(I, A, z, a, j)(i) ≠ z
      intro vanishing
      have impossible : a = z by cc
      exact nonzero with impossible
    exact functionSupport.membership.backward with ⟨index, different⟩

theorem coefficientSingle.support (I A z a j : Set)
  requires zeroIn : z ∈ A
  requires coefficient : a ∈ A
  shows functionSupport(coefficientSingle(I, A, z, a, j), I, z) ⊆ {j}
proof
  intros i hi
  have data := coefficientSingle.support_membership.forward with *
  exact singleton.membership.backward with data.right.left

theorem CoefficientMap.single (I A z a j : Set)
  requires zeroIn : z ∈ A
  requires coefficient : a ∈ A
  shows CoefficientMap(coefficientSingle(I, A, z, a, j), I, A, z)
proof
  have function := coefficientSingle.function at I, A, z, a, j with *
  have support := coefficientSingle.support at I, A, z, a, j with *
  have finiteSingleton := Finite.singleton at j
  have finite := Finite.subset with finiteSingleton, support
  unfold CoefficientMap
  refine ⟨function, finite⟩

theorem coefficientSingle.support_nonzero (I A z a j : Set)
  requires zeroIn : z ∈ A
  requires coefficient : a ∈ A
  requires index : j ∈ I
  requires nonzero : a ≠ z
  shows functionSupport(coefficientSingle(I, A, z, a, j), I, z) = {j}
proof
  ext i
  constructor
  . intro member
    have data := coefficientSingle.support_membership.forward with *
    exact singleton.membership.backward with data.right.left
  . intro member
    have equal := singleton.membership.forward with member
    rw equal
    apply coefficientSingle.support_membership.backward with zeroIn, coefficient
    refine ⟨index, rfl, nonzero⟩
