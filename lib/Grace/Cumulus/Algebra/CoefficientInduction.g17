module Grace.Cumulus.Algebra.CoefficientInduction
import CoefficientSingle

defgraph coefficientErase (I A z f j : Set) (i ∈ I) : A := singleValue(A, f(i), z, j, i)
requires zeroIn : z ∈ A
requires function : f : I → A
proof
  have value := FunctionBetween.apply_closed at f, I, A, i with *
  exact singleValue.closed at A, f(i), z, j, i with *

theorem coefficientErase.same (I A z f j : Set)
  requires zeroIn : z ∈ A
  requires function : f : I → A
  requires index : j ∈ I
  shows coefficientErase(I, A, z, f, j)(j) = z
proof
  have coefficient := FunctionBetween.apply_closed with *
  have value := coefficientErase.value at I, A, z, f, j, j with *
  have same : j = j by rfl
  have selected := singleValue.same at A, f(j), z, j, j with *
  cc

theorem coefficientErase.other (I A z f j i : Set)
  requires zeroIn : z ∈ A
  requires function : f : I → A
  requires index : i ∈ I
  requires different : i ≠ j
  shows coefficientErase(I, A, z, f, j)(i) = f(i)
proof
  have coefficient := FunctionBetween.apply_closed with *
  have value := coefficientErase.value at I, A, z, f, j, i with *
  have selected := singleValue.other at A, f(i), z, j, i with *
  cc

theorem coefficientErase.support (I A z f j : Set)
  requires zeroIn : z ∈ A
  requires function : f : I → A
  shows functionSupport(coefficientErase(I, A, z, f, j), I, z) ⊆ functionSupport(f, I, z) ∖ {j}
proof
  intros i hi
  have data := functionSupport.membership.forward with hi
  have different : i ≠ j
    intro equal
    have erased := coefficientErase.same at I, A, z, f, i with *
    have impossible : coefficientErase(I, A, z, f, j)(i) = z by cc
    exact data.right with impossible
  have value := coefficientErase.other with *
  apply difference.membership.backward
  constructor
  . apply functionSupport.membership.backward at f, I, z, i
    rwa value at data
  . settle with singleton.membership

section Rings
variable (I A add zero neg mul one : Set)
hypothesis ring : IsCommRing(A, add, zero, neg, mul, one)
notation ring R := (A, add, zero, neg, mul, one)

theorem coefficientErase.restore (f j : Set)
  requires function : f : I → A
  requires index : j ∈ I
  shows coefficientAdd(I, A, add, zero, neg, mul, one, coefficientSingle(I, A, zero, f(j), j), coefficientErase(I, A, zero, f, j)) = f
proof
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have coefficient := FunctionBetween.apply_closed with *
  have single := coefficientSingle.function at I, A, zero, f(j), j with *
  have erased := coefficientErase.function at I, A, zero, f, j with *
  have restored := coefficientAdd.function at I, A, add, zero, neg, mul, one, coefficientSingle(I, A, zero, f(j), j), coefficientErase(I, A, zero, f, j) with *
  apply FunctionBetween.ext with restored, function
  intros i hi
  have value := FunctionBetween.apply_closed at f, I, A, i with *
  have sum := coefficientAdd.value at I, A, add, zero, neg, mul, one, coefficientSingle(I, A, zero, f(j), j), coefficientErase(I, A, zero, f, j), i with *
  rw sum
  have alternatives : i = j ∨ i ≠ j by tauto
  cases alternatives with same | different
  . rw same
    have value1 := coefficientSingle.same at I, A, zero, f(j), j with *
    rw value1
    have value2 := coefficientErase.same at I, A, zero, f, j with *
    rw value2
    ring
  . have singleOther := coefficientSingle.other with zeroIn, coefficient, different
    rw singleOther
    have value3 := coefficientErase.other with zeroIn, function, different
    rw value3
    ring

theorem coefficientMaps.generated_list (S : Set) (xs : List(I))
  requires base : constantFunction(I, A, zero) ∈ S
  requires step : ∀ a ∈ A, ∀ j ∈ I, ∀ f ∈ S, coefficientAdd(I, A, add, zero, neg, mul, one, coefficientSingle(I, A, zero, a, j), f) ∈ S
  shows ∀ f, FunctionBetween(f, I, A) → functionSupport(f, I, zero) ⊆ listSupport{I}(xs) → f ∈ S
proof
  induction xs
  | List.nil =>
    intros f function covers
    have ordinary := IsCommRing.ring with ring
    have zeroIn := IsRing.zero_in_carrier with ordinary
    rw listSupport at covers
    have zeroFunction := constantFunction.function at I, A, zero with *
    have equal : f = constantFunction(I, A, zero)
      apply FunctionBetween.ext with function, zeroFunction
      intros i hi
      have absent : ¬(i ∈ functionSupport(f, I, zero))
        intro supported
        have impossible := covers with i, supported
        exact set.empty with impossible
      have vanishes := functionSupport.outside at f, I, zero, i with *
      have value := constantFunction.apply at I, A, i, zero with *
      cc
    rwa equal
  | List.cons(j, tail) using ih =>
    intros f function covers
    have ordinary := IsCommRing.ring with ring
    have zeroIn := IsRing.zero_in_carrier with ordinary
    have index : j ∈ I by assumption
    rw listSupport at covers
    have erased := coefficientErase.function at I, A, zero, f, j with *
    have support := coefficientErase.support at I, A, zero, f, j with *
    have smaller : functionSupport(coefficientErase(I, A, zero, f, j), I, zero) ⊆ listSupport{I}(tail)
      intros i hi
      have data := support with i, hi
      have difference := difference.membership.forward with data
      have covered := covers with i, difference.left
      have alternatives := insert.membership.forward with covered
      cases alternatives with equal | old
      . have singleton : i ∈ {j}
          simp
        exfalso
        exact difference.right with singleton
      . exact old
    have rest := ih with coefficientErase(I, A, zero, f, j), erased, smaller
    have coefficient := FunctionBetween.apply_closed at f, I, A, j with *
    have next := step with f(j), coefficient, j, index, coefficientErase(I, A, zero, f, j), rest
    have restore := coefficientErase.restore at I, A, add, zero, neg, mul, one, f, j with *
    rwa restore at next

theorem coefficientMaps.induction (S f : Set)
  requires map : CoefficientMap(f, I, A, zero)
  requires base : constantFunction(I, A, zero) ∈ S
  requires step : ∀ a ∈ A, ∀ j ∈ I, ∀ p ∈ S, coefficientAdd(I, A, add, zero, neg, mul, one, coefficientSingle(I, A, zero, a, j), p) ∈ S
  shows f ∈ S
proof
  obtain ⟨xs, list, covers⟩ := CoefficientMap.support_list with ring, map
  have function := CoefficientMap.function with map
  have generated := coefficientMaps.generated_list with *
  exact generated with f, function, covers

end Rings
