-- Authors: Grant Passmore

module Grace.Cumulus.Algebra.LinearSpan
import Adjoin

predicate Submodule (f A B plus z minus times T : Set) :=
  T ⊆ B ∧ z ∈ T ∧ ClosedUnary(T, minus) ∧ ClosedBinary(T, plus) ∧
  (∀ a ∈ A, ∀ x ∈ T, times(f(a), x) ∈ T)

notation scoped Submodule(f, R, S, T) => Submodule(f, R.carrier, S.carrier, S.add, S.zero, S.neg, S.mul, T)

def linearSpan (f A B plus z minus times G : Set) : Set :=
  {x ∈ B | ∀ T, Submodule(f, A, B, plus, z, minus, times, T) → G ⊆ T → x ∈ T}

notation scoped linearSpan(f, R, S, G) => linearSpan(f, R.carrier, S.carrier, S.add, S.zero, S.neg, S.mul, G)

predicate FiniteAlgebraModule (f A B plus z minus times : Set) :=
  ∃ G, Finite(G) ∧ G ⊆ B ∧ linearSpan(f, A, B, plus, z, minus, times, G) = B

notation scoped FiniteAlgebraModule(f, R, S) => FiniteAlgebraModule(f, R.carrier, S.carrier, S.add, S.zero, S.neg, S.mul)

section Algebras
variable (A add zero neg mul one B plus z minus times unit f : Set)
notation ring R := (A, add, zero, neg, mul, one)
notation ring S := (B, plus, z, minus, times, unit)
hypothesis source : IsCommRing(R)
hypothesis target : IsCommRing(S)
hypothesis hom : IsRingHom(f, R, S)

theorem Submodule.subset (T : Set)
  requires submodule : Submodule(f, R, S, T)
  shows T ⊆ B
proof
  simp [Submodule]

theorem Submodule.zero_mem (T : Set)
  requires submodule : Submodule(f, R, S, T)
  shows S[0] ∈ T
proof
  simp [Submodule]

theorem Submodule.neg_closed (T : Set)
  requires submodule : Submodule(f, R, S, T)
  shows ClosedUnary(T, minus)
proof
  simp [Submodule]

theorem Submodule.add_closed (T : Set)
  requires submodule : Submodule(f, R, S, T)
  shows ClosedBinary(T, plus)
proof
  simp [Submodule]

theorem Submodule.scalar_closed (T : Set)
  requires submodule : Submodule(f, R, S, T)
  shows ∀ a ∈ R, ∀ x ∈ T, S[f(a) * x] ∈ T
proof
  simp [Submodule]

theorem Submodule.scalar_mul_mem (T a x : Set)
  requires submodule : Submodule(f, R, S, T)
  requires coefficient : a ∈ R
  requires member : x ∈ T
  shows S[f(a) * x] ∈ T
proof
  have closed := Submodule.scalar_closed with *
  exact closed with a, coefficient, x, member

theorem Subalgebra.submodule (T : Set)
  requires subalgebra : Subalgebra(f, R, S, T)
  shows Submodule(f, R, S, T)
proof
  have subring := Subalgebra.subring with source, target, hom, subalgebra
  have bounded := IsSubring.subset_carrier with subring
  have zeroMember := IsSubring.zero_closed with subring
  have negative := IsSubring.neg_closed with subring
  have addition := IsSubring.add_closed with subring
  have scalars : ∀ a ∈ R, ∀ x ∈ T, S[f(a) * x] ∈ T
    intros a ha x hx
    exact Subalgebra.scalar_mul_mem with *
  unfold Submodule
  refine ⟨bounded, zeroMember, negative, addition, scalars⟩

theorem linearSpan.mem_iff (G x : Set)
  shows x ∈ linearSpan(f, R, S, G) ↔ x ∈ S ∧ (∀ T, Submodule(f, R, S, T) → G ⊆ T → x ∈ T)
proof
  simp

theorem linearSpan.subset (G : Set)
  shows linearSpan(f, R, S, G) ⊆ S
proof
  simp

theorem linearSpan.contains (G : Set)
  requires bounded : G ⊆ S
  shows G ⊆ linearSpan(f, R, S, G)
proof
  intros x hx
  apply linearSpan.mem_iff.backward with source, target, hom
  constructor
  . exact bounded with x, hx
  . intros T submodule included
    exact included with x, hx

theorem linearSpan.least (G T : Set)
  requires submodule : Submodule(f, R, S, T)
  requires generators : G ⊆ T
  shows linearSpan(f, R, S, G) ⊆ T
proof
  intros x hx
  have data := linearSpan.mem_iff.forward with *
  exact data.right with T, submodule, generators

theorem linearSpan.submodule (G : Set)
  shows Submodule(f, R, S, linearSpan(f, R, S, G))
proof
  have ordinary := IsCommRing.ring with target
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have bounded := linearSpan.subset at A, add, zero, neg, mul, one, B, plus, z, minus, times, unit, f, G with *
  have zeroMember : S[0] ∈ linearSpan(f, R, S, G)
    apply linearSpan.mem_iff.backward with source, target, hom
    refine ⟨zeroIn, ?_⟩
    intros T submodule generators
    exact Submodule.zero_mem with source, target, hom, submodule
  have negative : ClosedUnary(linearSpan(f, R, S, G), minus)
    intros x hx
    have data := linearSpan.mem_iff.forward with hx
    have closed := IsRing.neg_closed with ordinary, data.left
    apply linearSpan.mem_iff.backward with source, target, hom
    refine ⟨closed, ?_⟩
    intros T submodule generators
    have member := data.right with T, submodule, generators
    have closure := Submodule.neg_closed with source, target, hom, submodule
    exact ClosedUnary.mem with closure, member
  have addition : ClosedBinary(linearSpan(f, R, S, G), plus)
    intros x hx y hy
    have first := linearSpan.mem_iff.forward with hx
    have second := linearSpan.mem_iff.forward with hy
    have closed := IsRing.add_closed with ordinary, first.left, second.left
    apply linearSpan.mem_iff.backward with source, target, hom
    refine ⟨closed, ?_⟩
    intros T submodule generators
    have memberX := first.right with T, submodule, generators
    have memberY := second.right with T, submodule, generators
    have closure := Submodule.add_closed with source, target, hom, submodule
    exact ClosedBinary.mem with closure, memberX, memberY
  have scalars : ∀ a ∈ R, ∀ x ∈ linearSpan(f, R, S, G), S[f(a) * x] ∈ linearSpan(f, R, S, G)
    intros a ha x hx
    have data := linearSpan.mem_iff.forward with hx
    have image := IsRingHom.closed with hom, ha
    have closed := IsRing.mul_closed with ordinary, image, data.left
    apply linearSpan.mem_iff.backward with source, target, hom
    refine ⟨closed, ?_⟩
    intros T submodule generators
    have member := data.right with T, submodule, generators
    exact Submodule.scalar_mul_mem with source, target, hom, submodule, ha, member
  unfold Submodule
  refine ⟨bounded, zeroMember, negative, addition, scalars⟩

theorem linearSpan.mono (G H : Set)
  requires bounded : H ⊆ S
  requires included : G ⊆ H
  shows linearSpan(f, R, S, G) ⊆ linearSpan(f, R, S, H)
proof
  have generated := linearSpan.submodule at A, add, zero, neg, mul, one, B, plus, z, minus, times, unit, f, H with *
  have contains := linearSpan.contains with *
  have generators := Subset.transitive with included, contains
  exact linearSpan.least with source, target, hom, generated, generators

theorem linearSpan.eq_of_submodule (T : Set)
  requires submodule : Submodule(f, R, S, T)
  shows linearSpan(f, R, S, T) = T
proof
  have bounded := Submodule.subset with source, target, hom, submodule
  have reflexive := Subset.reflexive at T
  have first := linearSpan.least with source, target, hom, submodule, reflexive
  have second := linearSpan.contains with source, target, hom, bounded
  exact Subset.antisymmetric with first, second

theorem linearSpan.idempotent (G : Set)
  shows linearSpan(f, R, S, linearSpan(f, R, S, G)) = linearSpan(f, R, S, G)
proof
  have generated := linearSpan.submodule at A, add, zero, neg, mul, one, B, plus, z, minus, times, unit, f, G with *
  exact linearSpan.eq_of_submodule with source, target, hom, generated

theorem linearSpan.subset_adjoin (G : Set)
  requires bounded : G ⊆ S
  shows linearSpan(f, R, S, G) ⊆ algebraAdjoin(f, R, S, G)
proof
  have generated := algebraAdjoin.subalgebra with source, target, hom, bounded
  have submodule := Subalgebra.submodule with source, target, hom, generated
  have generators := algebraAdjoin.contains with source, target, hom, bounded
  exact linearSpan.least with source, target, hom, submodule, generators

theorem FiniteAlgebraModule.finitely_generated_algebra
  requires finiteModule : FiniteAlgebraModule(f, R, S)
  shows FinitelyGeneratedAlgebra(f, R, S)
proof
  obtain ⟨G, finite, bounded, spans⟩ := finiteModule
  have included := linearSpan.subset_adjoin with source, target, hom, bounded
  rw spans at included
  have subset := algebraAdjoin.subset at A, add, zero, neg, mul, one, B, plus, z, minus, times, unit, f, G with *
  have generated := Subset.antisymmetric with subset, included
  unfold FinitelyGeneratedAlgebra
  refine ⟨G, finite, bounded, generated⟩

end Algebras
