module Grace.Cumulus.Algebra.MatrixAnnihilator
import SpanAnnihilator
import MultiplicationMatrix
import IndexedCombinations
import Polynomial.CharacteristicMonic

section Algebras
variable (A add zero neg mul one B plus z minus times unit f x : Set)
notation ring R := (A, add, zero, neg, mul, one)
notation ring S := (B, plus, z, minus, times, unit)
hypothesis source : IsCommRing(R)
hypothesis target : IsCommRing(S)
hypothesis hom : IsRingHom(f, R, S)
hypothesis element : x ∈ S

theorem multiplicationMatrix.monic_annihilator (xs : List(B)) (M : Set)
  requires matrix : RingMatrix(length{B}(xs), R, M)
  requires rows : ∀ i ∈ length{B}(xs), ∃ cs, List(A, cs) ∧ length{A}(cs) = length{B}(xs) ∧ S[x * listCoefficient{B}(z, xs, i)] = linearCombination(R, S, f, xs, cs) ∧ (∀ j ∈ length{B}(xs), M[i, j] = listCoefficient{A}(zero, cs, j))
  shows ∃ cs, List(A, cs) ∧ length{A}(cs) = length{B}(xs) ∧ (∀ g ∈ listSupport{B}(xs), S[monicValue(R, f, S, x, cs) * g] = S[0])
proof
  have size : Nat(length{B}(xs)) by typecheck
  have ordinaryR := IsCommRing.ring with source
  have ordinaryS := IsCommRing.ring with target
  have zeroR := IsRing.zero_in_carrier with ordinaryR
  have zeroS := IsRing.zero_in_carrier with ordinaryS
  have function := IsRingHom.function with hom
  have matrixFunction : M : length{B}(xs) × length{B}(xs) → A by exact matrix
  have transpose := transposedMatrix.function at length{B}(xs), length{B}(xs), A, M with *
  have transposeMatrix : RingMatrix(length{B}(xs), R, transposedMatrix(length{B}(xs), length{B}(xs), A, M))
    exact transpose
  have mapped := matrixMap.matrix with matrix, function
  have vectorSupport := listEntries.function at B, z, xs with *
  have vectorValues : ∀ i ∈ length{B}(xs), listEntries(B, z, xs)(i) ∈ B
    intros i hi
    have positions := natural.member with size
    have index := positions with i, hi
    have value := listEntries.value at B, z, xs, i with *
    rw value
    exact listCoefficient.closed with *
  have vector := FunctionBetween.codomain_of_values with *
  have entries : ∀ r ∈ length{B}(xs), ∀ c ∈ length{B}(xs), matrixMap(length{B}(xs), R, S, f, transposedMatrix(length{B}(xs), length{B}(xs), A, M))[r, c] = f(transposedMatrix(length{B}(xs), length{B}(xs), A, M)[r, c])
    intros r hr c hc
    exact matrixMap.entry with *
  have eigenvector : LeftEigenvector(length{B}(xs), S, matrixMap(length{B}(xs), R, S, f, transposedMatrix(length{B}(xs), length{B}(xs), A, M)), x, listEntries(B, z, xs))
    unfold LeftEigenvector
    refine ⟨vector, ?_⟩
    intros i hi
    obtain ⟨cs, coefficients, count, equation, row⟩ := rows with i, hi
    have weights := rowVectorWeights.function at length{B}(xs), B, plus, z, minus, times, unit, listEntries(B, z, xs), matrixMap(length{B}(xs), R, S, f, transposedMatrix(length{B}(xs), length{B}(xs), A, M)), i with *
    have products : ∀ j ∈ length{B}(xs), rowVectorWeights(length{B}(xs), S, listEntries(B, z, xs), matrixMap(length{B}(xs), R, S, f, transposedMatrix(length{B}(xs), length{B}(xs), A, M)), i)(j) = S[f(listCoefficient{A}(zero, cs, j)) * listCoefficient{B}(z, xs, j)]
      intros j hj
      have positions := natural.member with size
      have index := positions with j, hj
      have coefficient := listCoefficient.closed at A, zero, cs, j with *
      have generator := listCoefficient.closed at B, z, xs, j with *
      have image := IsRingHom.closed with hom, coefficient
      have weight := rowVectorWeights.value at length{B}(xs), B, plus, z, minus, times, unit, listEntries(B, z, xs), matrixMap(length{B}(xs), R, S, f, transposedMatrix(length{B}(xs), length{B}(xs), A, M)), i, j with *
      have vectorEntry := listEntries.value at B, z, xs, j with *
      have mappedEntry := entries with j, hj, i, hi
      have transposed := transposedMatrix.pair at length{B}(xs), length{B}(xs), A, M, i, j with *
      have rowEntry := row with j, hj
      rw [weight, vectorEntry, mappedEntry, transposed, rowEntry]
      ring
    have sum := linearCombination.finite_sum with *
    have vectorEntry := listEntries.value at B, z, xs, i with *
    unfold rowVectorEntry
    rw ← sum
    rfl
  obtain ⟨cs, coefficients, count, annihilates⟩ := LeftEigenvector.monic_annihilator at A, add, zero, neg, mul, one, B, plus, z, minus, times, unit, f, length{B}(xs), transposedMatrix(length{B}(xs), length{B}(xs), A, M), matrixMap(length{B}(xs), R, S, f, transposedMatrix(length{B}(xs), length{B}(xs), A, M)), x, listEntries(B, z, xs) with *
  refine ⟨cs, coefficients, count, ?_⟩
  intros g hg
  have covers := listSupport.exists_index at B, z, xs with *
  obtain ⟨i, index, bound, value⟩ := covers with g, hg
  have position : i ∈ length{B}(xs) by exact membership.of_Less at i, length{B}(xs) with index, bound
  have kills := annihilates with i, position
  have entry := listEntries.value at B, z, xs, i with *
  rwa [entry, value] at kills

-- Faithfulness comes from the generators spanning the unit, not from freeness.
theorem FiniteAlgebraModule.integral
  requires finiteModule : FiniteAlgebraModule(f, R, S)
  shows IntegralOver(f, R, S, x)
proof
  obtain ⟨xs, list, spans, M, matrix, rows⟩ := FiniteAlgebraModule.multiplication_matrix at A, add, zero, neg, mul, one, B, plus, z, minus, times, unit, f, x with *
  obtain ⟨cs, coefficients, count, annihilates⟩ := multiplicationMatrix.monic_annihilator at A, add, zero, neg, mul, one, B, plus, z, minus, times, unit, f, x, xs, M with *
  have bounded := listSupport.subset at B, xs with *
  have unitIn : S[1] ∈ linearSpan(f, R, S, listSupport{B}(xs))
    rw spans
    typecheck
  exact IntegralOver.of_annihilates_generators with *

end Algebras
