module Grace.Cumulus.Algebra.ClearDenominators
import Localization
import FiniteSpan

section Rings
variable (B plus z minus times unit T D : Set)
notation ring S := (B, plus, z, minus, times, unit)
hypothesis ring : IsCommRing(S)
hypothesis subring : IsSubring(S, T)
hypothesis denominators : Denominators(S, T, D)

theorem localizationWithin.clear_list (K : Set) (xs : List(K))
  requires included : K ⊆ localizationWithin(S, T, D)
  shows ∃ d ∈ D, ∀ x ∈ listSupport{K}(xs), S[d * x] ∈ T
proof
  induction xs
  | List.nil =>
    have one := Denominators.one_mem with ring, subring, denominators
    refine ⟨unit, one, ?_⟩
    intros x hx
    rw listSupport at hx
    exfalso
    exact set.empty with hx
  | List.cons(x, tail) using ih =>
    have bounded := IsSubring.subset_carrier with subring
    have denomBound := Denominators.subset with ring, subring, denominators
    have denomAmbient := Subset.transitive with denomBound, bounded
    have denomClosed := Denominators.mul_closed with ring, subring, denominators
    have multiply := IsSubring.mul_closed with subring
    obtain ⟨d, hd, clears⟩ := ih
    have localized : x ∈ localizationWithin(S, T, D) by simp [Subset]
    obtain ⟨inX, e, he, numerator⟩ := localizationWithin.membership.forward with localized
    have dIn : d ∈ S by simp [Subset]
    have eIn : e ∈ S by simp [Subset]
    have dInT : d ∈ T by simp [Subset]
    have eInT : e ∈ T by simp [Subset]
    have product := ClosedBinary.mem with denomClosed, hd, he
    refine ⟨S[d * e], product, ?_⟩
    intros u hu
    rw listSupport at hu
    have alternatives := insert.membership.forward with hu
    cases alternatives with equal | previous
    . rw equal
      have member := ClosedBinary.mem with multiply, dInT, numerator
      have equation : S[(d * e) * x] = S[d * (e * x)] by ring
      rwa equation
    . have tailBound := listSupport.subset with *
      have memberK : u ∈ K by simp [Subset]
      have memberLocal : u ∈ localizationWithin(S, T, D) by simp [Subset]
      have data := localizationWithin.membership.forward with memberLocal
      have inU := data.left
      have cleared := clears with u, previous
      have member := ClosedBinary.mem with multiply, eInT, cleared
      have equation : S[(d * e) * u] = S[e * (d * u)] by ring
      rwa equation

theorem localizationWithin.clear_finite (K : Set)
  requires finite : Finite(K)
  requires included : K ⊆ localizationWithin(S, T, D)
  shows ∃ d ∈ D, ∀ x ∈ K, S[d * x] ∈ T
proof
  obtain ⟨xs, list, covers⟩ := Finite.list_cover with finite
  obtain ⟨d, hd, clears⟩ := localizationWithin.clear_list at B, plus, z, minus, times, unit, T, D, K, xs with *
  refine ⟨d, hd, ?_⟩
  intros x hx
  have covered : x ∈ listSupport{K}(xs) by simp [Subset]
  exact clears with x, covered

end Rings

section Algebras
variable (A add zero neg mul one B plus z minus times unit f T D M : Set)
notation ring R := (A, add, zero, neg, mul, one)
notation ring S := (B, plus, z, minus, times, unit)
hypothesis source : IsCommRing(R)
hypothesis target : IsCommRing(S)
hypothesis hom : IsRingHom(f, R, S)
hypothesis subalgebra : Subalgebra(f, R, S, T)
hypothesis denominators : Denominators(S, T, D)

theorem localizationWithin.clear_finite_span
  requires finite : FiniteSpan(f, R, S, M)
  requires included : M ⊆ localizationWithin(S, T, D)
  shows ∃ d ∈ D, ∀ x ∈ M, S[d * x] ∈ T
proof
  have subring := Subalgebra.subring with source, target, hom, subalgebra
  have submodule := Subalgebra.submodule with source, target, hom, subalgebra
  have bound := IsSubring.subset_carrier with subring
  have denomBound := Denominators.subset with target, subring, denominators
  have ambient := Subset.transitive with denomBound, bound
  obtain ⟨G, finiteG, generators, spans⟩ := finite
  have localized := Subset.transitive with generators, included
  obtain ⟨d, hd, clears⟩ := localizationWithin.clear_finite with target, subring, denominators, finiteG, localized
  have dIn : d ∈ S by simp [Subset]
  have multipliers := rightMultipliers.submodule with source, target, hom, submodule, dIn
  have localBound := localizationWithin.subset at B, times, T, D
  have boundedG := Subset.transitive with localized, localBound
  have generatorsClear : G ⊆ rightMultipliers(B, times, T, d)
    intros u hu
    have inB : u ∈ S by simp [Subset]
    have cleared := clears with u, hu
    have commute : S[u * d] = S[d * u] by ring
    apply rightMultipliers.membership.backward
    rw commute
    refine ⟨inB, cleared⟩
  have allClear := linearSpan.least with source, target, hom, multipliers, generatorsClear
  rw spans at allClear
  refine ⟨d, hd, ?_⟩
  intros x hx
  have member : x ∈ rightMultipliers(B, times, T, d) by simp [Subset]
  obtain ⟨inB, cleared⟩ := rightMultipliers.membership.forward with member
  have commute : S[d * x] = S[x * d] by ring
  rwa commute

end Algebras
