module Grace.Cumulus.Algebra.IntegralAdjoin
import MonicRelations
import LinearSpanMultiplication

section Algebras
variable (A add zero neg mul one B plus z minus times unit f x : Set)
notation ring R := (A, add, zero, neg, mul, one)
notation ring S := (B, plus, z, minus, times, unit)
hypothesis source : IsCommRing(R)
hypothesis target : IsCommRing(S)
hypothesis hom : IsRingHom(f, R, S)
hypothesis element : x ∈ S

section Submodules
variable (M : Set)
hypothesis submodule : Submodule(f, R, S, M)
hypothesis unitIn : S[1] ∈ M

theorem monicTailSet.stable (cs : List(A))
  shows monicTailSet(R, f, S, x, cs) ⊆ M → S[x * monicValue(R, f, S, x, cs)] ∈ M →
    ∀ u ∈ monicTailSet(R, f, S, x, cs), S[x * u] ∈ M
proof
  induction cs
  | List.nil =>
    intros covers initial u hu
    rw monicTailSet at hu
    have equal := singleton.membership.forward with hu
    rw monicValue at initial
    rwa equal
  | List.cons(a, tail) using ih =>
    intros covers initial u hu
    have ordinary := IsCommRing.ring with target
    have coefficient : a ∈ R by assumption
    have image := IsRingHom.closed with hom, coefficient
    have scalar := Submodule.scalar_mul_mem with source, target, hom, submodule, coefficient, unitIn
    have identity : S[f(a) * 1] = f(a) by ring
    rw identity at scalar
    have negative := Submodule.neg_closed with source, target, hom, submodule
    have negativeScalar := ClosedUnary.mem with negative, scalar
    have addition := Submodule.add_closed with source, target, hom, submodule
    have head := monicTailSet.head at A, f, plus, times, unit, x, a :: tail with *
    have included := covers
    have headIn := included with monicValue(R, f, S, x, a :: tail), head
    have difference := ClosedBinary.mem with addition, headIn, negativeScalar
    have tailValue := monicValue.closed at A, add, zero, neg, mul, one, B, plus, z, minus, times, unit, f, x, tail with *
    have equation : S[monicValue(R, f, S, x, a :: tail) - f(a)] = S[x * monicValue(R, f, S, x, tail)]
      rw monicValue
      ring
    rw equation at difference
    have tailIncluded : monicTailSet(R, f, S, x, tail) ⊆ M
      rw monicTailSet at covers
      intros v hv
      have member := insert.contains at v, monicValue(R, f, S, x, a :: tail), monicTailSet(R, f, S, x, tail) with hv
      exact covers with v, member
    have rest := ih with tailIncluded, difference
    rw monicTailSet at hu
    have alternatives := insert.membership.forward with hu
    cases alternatives with equal | old
    . rw equal
      exact initial
    . exact rest with u, old

hypothesis stable : ∀ y ∈ M, S[x * y] ∈ M

theorem monicValue.mul_preserves (cs : List(A))
  shows ∀ y ∈ M, S[monicValue(R, f, S, x, cs) * y] ∈ M
proof
  induction cs
  | List.nil =>
    intros y hy
    have subset := Submodule.subset with source, target, hom, submodule
    have member := subset with y, hy
    have identity : S[1 * y] = y by ring
    rwa [monicValue, identity]
  | List.cons(a, tail) using ih =>
    intros y hy
    have coefficient : a ∈ R by assumption
    have subset := Submodule.subset with source, target, hom, submodule
    have member := subset with y, hy
    have image := IsRingHom.closed with hom, coefficient
    have tailValue := monicValue.closed at A, add, zero, neg, mul, one, B, plus, z, minus, times, unit, f, x, tail with *
    have scalar := Submodule.scalar_mul_mem with source, target, hom, submodule, coefficient, hy
    have tailProduct := ih with y, hy
    have shifted := stable with S[monicValue(R, f, S, x, tail) * y], tailProduct
    have addition := Submodule.add_closed with source, target, hom, submodule
    have sum := ClosedBinary.mem with addition, scalar, shifted
    have equation : S[monicValue(R, f, S, x, a :: tail) * y] = S[f(a) * y + x * (monicValue(R, f, S, x, tail) * y)]
      rw monicValue
      ring
    rwa equation

theorem monicTailSet.mul_preserves (cs : List(A))
  shows ∀ u ∈ monicTailSet(R, f, S, x, cs), ∀ y ∈ M, S[u * y] ∈ M
proof
  induction cs
  | List.nil =>
    intros u hu y hy
    rw monicTailSet at hu
    have equal := singleton.membership.forward with hu
    have preserved := monicValue.mul_preserves at A, add, zero, neg, mul, one, B, plus, z, minus, times, unit, f, x, M, [] with *
    have result := preserved with y, hy
    rw monicValue at result
    rwa equal
  | List.cons(a, tail) using ih =>
    intros u hu y hy
    rw monicTailSet at hu
    have alternatives := insert.membership.forward with hu
    cases alternatives with equal | old
    . have preserved := monicValue.mul_preserves at A, add, zero, neg, mul, one, B, plus, z, minus, times, unit, f, x, M, a :: tail with *
      have result := preserved with y, hy
      rwa equal
    . exact ih with u, old, y, hy

end Submodules

theorem monicTailSet.spans_adjoin (cs : List(A))
  requires relation : monicValue(R, f, S, x, cs) = S[0]
  shows linearSpan(f, R, S, monicTailSet(R, f, S, x, cs)) = algebraAdjoin(f, R, S, {x})
proof
  have ordinary := IsCommRing.ring with target
  have finite := monicTailSet.finite at A, f, plus, times, unit, x, cs with *
  have bounded := monicTailSet.subset with *
  have span := linearSpan.submodule at A, add, zero, neg, mul, one, B, plus, z, minus, times, unit, f, monicTailSet(R, f, S, x, cs) with *
  have contains := linearSpan.contains with source, target, hom, bounded
  have spanBound := linearSpan.subset at A, add, zero, neg, mul, one, B, plus, z, minus, times, unit, f, monicTailSet(R, f, S, x, cs) with *
  have spanZero := Submodule.zero_mem with source, target, hom, span
  have generatorUnit := monicTailSet.unit at A, f, plus, times, unit, x, cs with *
  have unitIn : S[1] ∈ linearSpan(f, R, S, monicTailSet(R, f, S, x, cs)) by exact contains with unit, generatorUnit
  have initial : S[x * monicValue(R, f, S, x, cs)] ∈ linearSpan(f, R, S, monicTailSet(R, f, S, x, cs))
    have vanishes : S[x * monicValue(R, f, S, x, cs)] = S[0]
      rw relation
      ring
    rwa vanishes
  have tailsStable := monicTailSet.stable with source, target, hom, element, span, unitIn, contains, initial
  have stable : ∀ y ∈ linearSpan(f, R, S, monicTailSet(R, f, S, x, cs)), S[x * y] ∈ linearSpan(f, R, S, monicTailSet(R, f, S, x, cs))
    intros y hy
    have included := spanBound
    have member := included with y, hy
    have generatorProducts : ∀ g ∈ monicTailSet(R, f, S, x, cs), S[g * x] ∈ linearSpan(f, R, S, monicTailSet(R, f, S, x, cs))
      intros g hg
      have bound := bounded
      have inB := bound with g, hg
      have product := tailsStable with g, hg
      have commute : S[g * x] = S[x * g] by ring
      rwa commute
    have multiplied := linearSpan.mul_mem with source, target, hom, span, element, bounded, generatorProducts, hy
    have commute : S[x * y] = S[y * x] by ring
    rwa commute
  have preserved := monicTailSet.mul_preserves with *
  have multiplication : ClosedBinary(linearSpan(f, R, S, monicTailSet(R, f, S, x, cs)), times)
    intros u hu v hv
    have included := spanBound
    have memberV := included with v, hv
    have generators : ∀ g ∈ monicTailSet(R, f, S, x, cs), S[g * v] ∈ linearSpan(f, R, S, monicTailSet(R, f, S, x, cs))
      intros g hg
      exact preserved with g, hg, v, hv
    exact linearSpan.mul_mem with source, target, hom, span, memberV, bounded, generators, hu
  have negative := Submodule.neg_closed with source, target, hom, span
  have addition := Submodule.add_closed with source, target, hom, span
  have subring : IsSubring(S, linearSpan(f, R, S, monicTailSet(R, f, S, x, cs)))
    unfold IsSubring
    refine ⟨spanBound, spanZero, unitIn, negative, addition, multiplication⟩
  have coefficients : functionImage(f, R, S) ⊆ linearSpan(f, R, S, monicTailSet(R, f, S, x, cs))
    intros b hb
    obtain ⟨memberB, a, ha, value⟩ := functionImage.membership.forward with hb
    have image := IsRingHom.closed with hom, ha
    have scalar := Submodule.scalar_mul_mem with source, target, hom, span, ha, unitIn
    have identity : S[f(a) * 1] = f(a) by ring
    rw identity at scalar
    rwa value
  have subalgebra : Subalgebra(f, R, S, linearSpan(f, R, S, monicTailSet(R, f, S, x, cs)))
    unfold Subalgebra
    refine ⟨subring, coefficients⟩
  have xIn : x ∈ linearSpan(f, R, S, monicTailSet(R, f, S, x, cs))
    have product := stable with unit, unitIn
    have identity : S[x * 1] = x by ring
    rwa identity at product
  have generatorIn : {x} ⊆ linearSpan(f, R, S, monicTailSet(R, f, S, x, cs))
    intros u hu
    have equal := singleton.membership.forward with hu
    rwa equal
  have first := algebraAdjoin.least with source, target, hom, subalgebra, generatorIn
  have singletonBound : {x} ⊆ S
    intros u hu
    have equal := singleton.membership.forward with hu
    rwa equal
  have adjoined := algebraAdjoin.subalgebra with source, target, hom, singletonBound
  have generatorContains := algebraAdjoin.contains with source, target, hom, singletonBound
  have generatorSelf : x ∈ {x} by simp [singleton.membership]
  have adjoinedX : x ∈ algebraAdjoin(f, R, S, {x}) by exact generatorContains with x, generatorSelf
  have tailsIncluded := monicTailSet.in_subalgebra at A, add, zero, neg, mul, one, B, plus, z, minus, times, unit, f, x, algebraAdjoin(f, R, S, {x}), cs with *
  have adjoinedModule := Subalgebra.submodule with source, target, hom, adjoined
  have second := linearSpan.least with source, target, hom, adjoinedModule, tailsIncluded
  exact Subset.antisymmetric with second, first

theorem IntegralOver.finite_adjoin
  requires integral : IntegralOver(f, R, S, x)
  shows ∃ G, Finite(G) ∧ G ⊆ algebraAdjoin(f, R, S, {x}) ∧ linearSpan(f, R, S, G) = algebraAdjoin(f, R, S, {x})
proof
  obtain ⟨cs, list, relation⟩ := integral.right
  have finite := monicTailSet.finite at A, f, plus, times, unit, x, cs with *
  have bounded := monicTailSet.subset with *
  have contains := linearSpan.contains with source, target, hom, bounded
  have spans := monicTailSet.spans_adjoin with *
  rw spans at contains
  refine ⟨monicTailSet(R, f, S, x, cs), finite, contains, spans⟩

theorem IntegralOver.finite_module_of_generates
  requires integral : IntegralOver(f, R, S, x)
  requires generates : algebraAdjoin(f, R, S, {x}) = S
  shows FiniteAlgebraModule(f, R, S)
proof
  have finite := IntegralOver.finite_adjoin with *
  obtain ⟨G, finiteG, bounded, spans⟩ := finite
  rw generates at bounded
  rw generates at spans
  unfold FiniteAlgebraModule
  refine ⟨G, finiteG, bounded, spans⟩

end Algebras
