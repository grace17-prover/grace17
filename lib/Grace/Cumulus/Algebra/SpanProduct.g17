module Grace.Cumulus.Algebra.SpanProduct
import LinearSpanMultiplication
import Cardinal.FiniteImage
import Cardinal.Product

def spanProducts (B times G H : Set) : Set := functionImage(times, G × H, B)

notation scoped spanProducts(R, G, H) => spanProducts(R.carrier, R.mul, G, H)

theorem spanProducts.membership (B times G H w : Set)
  shows w ∈ spanProducts(B, times, G, H) ↔ w ∈ B ∧ (∃ g ∈ G, ∃ h ∈ H, w = times(g, h))
proof
  constructor
  . intro member
    unfold spanProducts at member
    obtain ⟨inB, p, hp, value⟩ := functionImage.membership.forward with member
    obtain ⟨bound, g, hg, h, hh, shape⟩ := product.membership.forward with hp
    rw shape at value
    have equation : w = times(g, h)
      simp [call2]
    refine ⟨inB, g, hg, h, hh, equation⟩
  . intro data
    obtain ⟨inB, g, hg, h, hh, value⟩ := data
    unfold call2 at value
    have pair := product.pair with hg, hh
    unfold spanProducts
    exact functionImage.membership.backward with ⟨inB, (g, h), pair, value⟩

theorem spanProducts.subset (B times G H : Set)
  shows spanProducts(B, times, G, H) ⊆ B
proof
  simp

section Algebras
variable (A add zero neg mul one B plus z minus times unit f : Set)
notation ring R := (A, add, zero, neg, mul, one)
notation ring S := (B, plus, z, minus, times, unit)
hypothesis source : IsCommRing(R)
hypothesis target : IsCommRing(S)
hypothesis hom : IsRingHom(f, R, S)

theorem spanProducts.finite (G H : Set)
  requires finiteG : Finite(G)
  requires finiteH : Finite(H)
  requires boundedG : G ⊆ S
  requires boundedH : H ⊆ S
  shows Finite(spanProducts(B, times, G, H))
proof
  have function : times : B × B → B by simp [IsCommRing, IsRing, IsMonoid, IsSemigroup, IsMagma]
  have finite := Finite.product with finiteG, finiteH
  have bounded := product.monotone with boundedG, boundedH
  unfold spanProducts
  exact Finite.function_image with function, finite, bounded

theorem linearSpan.mul_mem_of_generators (G H T u v : Set)
  requires boundedG : G ⊆ S
  requires boundedH : H ⊆ S
  requires submodule : Submodule(f, R, S, T)
  requires products : ∀ g ∈ G, ∀ h ∈ H, S[g * h] ∈ T
  requires memberU : u ∈ linearSpan(f, R, S, G)
  requires memberV : v ∈ linearSpan(f, R, S, H)
  shows S[u * v] ∈ T
proof
  have spanH := linearSpan.subset at A, add, zero, neg, mul, one, B, plus, z, minus, times, unit, f, H with *
  have inV : v ∈ S by simp [Subset]
  have generators : ∀ g ∈ G, S[g * v] ∈ T
    intros g hg
    have inG : g ∈ S by simp [Subset]
    have right : ∀ h ∈ H, S[h * g] ∈ T
      intros h hh
      have inH : h ∈ S by simp [Subset]
      have product := products with g, hg, h, hh
      have commute : S[h * g] = S[g * h] by ring
      rwa commute
    have product := linearSpan.mul_mem with source, target, hom, submodule, inG, boundedH, right, memberV
    have commute : S[g * v] = S[v * g] by ring
    rwa commute
  exact linearSpan.mul_mem with source, target, hom, submodule, inV, boundedG, generators, memberU

theorem linearSpan.product_mem (G H u v : Set)
  requires boundedG : G ⊆ S
  requires boundedH : H ⊆ S
  requires memberU : u ∈ linearSpan(f, R, S, G)
  requires memberV : v ∈ linearSpan(f, R, S, H)
  shows S[u * v] ∈ linearSpan(f, R, S, spanProducts(B, times, G, H))
proof
  have ordinary := IsCommRing.ring with target
  have bounded := spanProducts.subset at B, times, G, H
  have span := linearSpan.submodule at A, add, zero, neg, mul, one, B, plus, z, minus, times, unit, f, spanProducts(B, times, G, H) with *
  have contains := linearSpan.contains with source, target, hom, bounded
  have products : ∀ g ∈ G, ∀ h ∈ H, S[g * h] ∈ linearSpan(f, R, S, spanProducts(B, times, G, H))
    intros g hg h hh
    have inG : g ∈ S by simp [Subset]
    have inH : h ∈ S by simp [Subset]
    have closed := IsRing.mul_closed with ordinary, inG, inH
    have member : S[g * h] ∈ spanProducts(B, times, G, H)
      exact spanProducts.membership.backward with ⟨closed, g, hg, h, hh, rfl⟩
    exact contains with S[g * h], member
  exact linearSpan.mul_mem_of_generators with source, target, hom, boundedG, boundedH, span, products, memberU, memberV

theorem linearSpan.product_subalgebra (G H : Set)
  requires boundedG : G ⊆ S
  requires boundedH : H ⊆ S
  requires algebraG : Subalgebra(f, R, S, linearSpan(f, R, S, G))
  requires algebraH : Subalgebra(f, R, S, linearSpan(f, R, S, H))
  shows Subalgebra(f, R, S, linearSpan(f, R, S, spanProducts(B, times, G, H)))
proof
  have ordinary := IsCommRing.ring with target
  have ringG := Subalgebra.subring with source, target, hom, algebraG
  have ringH := Subalgebra.subring with source, target, hom, algebraH
  have oneG := IsSubring.one_closed with ringG
  have oneH := IsSubring.one_closed with ringH
  have mulG := IsSubring.mul_closed with ringG
  have mulH := IsSubring.mul_closed with ringH
  have containsG := linearSpan.contains with source, target, hom, boundedG
  have containsH := linearSpan.contains with source, target, hom, boundedH
  have bounded := spanProducts.subset at B, times, G, H
  have span := linearSpan.submodule at A, add, zero, neg, mul, one, B, plus, z, minus, times, unit, f, spanProducts(B, times, G, H) with *
  have bound := Submodule.subset with source, target, hom, span
  have zeroMem := Submodule.zero_mem with source, target, hom, span
  have negative := Submodule.neg_closed with source, target, hom, span
  have addition := Submodule.add_closed with source, target, hom, span
  have multiplicative := IsRing.multiplicative with ordinary
  have unitIn := IsMonoid.unit_in_carrier with multiplicative
  have unitProduct := linearSpan.product_mem with source, target, hom, boundedG, boundedH, oneG, oneH
  have unitEquation : S[1 * 1] = S[1] by ring
  rw unitEquation at unitProduct
  have products : ∀ p ∈ spanProducts(B, times, G, H), ∀ q ∈ spanProducts(B, times, G, H), S[p * q] ∈ linearSpan(f, R, S, spanProducts(B, times, G, H))
    intros p hp q hq
    obtain ⟨pIn, g, hg, h, hh, pValue⟩ := spanProducts.membership.forward with hp
    obtain ⟨qIn, k, hk, l, hl, qValue⟩ := spanProducts.membership.forward with hq
    have gIn : g ∈ S by simp [Subset]
    have hIn : h ∈ S by simp [Subset]
    have kIn : k ∈ S by simp [Subset]
    have lIn : l ∈ S by simp [Subset]
    have gSpan : g ∈ linearSpan(f, R, S, G) by simp [Subset]
    have kSpan : k ∈ linearSpan(f, R, S, G) by simp [Subset]
    have hSpan : h ∈ linearSpan(f, R, S, H) by simp [Subset]
    have lSpan : l ∈ linearSpan(f, R, S, H) by simp [Subset]
    have first := ClosedBinary.mem with mulG, gSpan, kSpan
    have second := ClosedBinary.mem with mulH, hSpan, lSpan
    have member := linearSpan.product_mem with source, target, hom, boundedG, boundedH, first, second
    have equation : S[(g * h) * (k * l)] = S[(g * k) * (h * l)] by ring
    rwa [pValue, qValue, equation]
  have multiplication : ClosedBinary(linearSpan(f, R, S, spanProducts(B, times, G, H)), times)
    intros u hu v hv
    exact linearSpan.mul_mem_of_generators with source, target, hom, bounded, bounded, span, products, hu, hv
  have subring : IsSubring(S, linearSpan(f, R, S, spanProducts(B, times, G, H)))
    unfold IsSubring
    refine ⟨bound, zeroMem, unitProduct, negative, addition, multiplication⟩
  have coefficients : functionImage(f, R, S) ⊆ linearSpan(f, R, S, spanProducts(B, times, G, H))
    intros b hb
    obtain ⟨bIn, a, ha, equation⟩ := functionImage.membership.forward with hb
    have image := IsRingHom.closed with hom, ha
    have scalar := Submodule.scalar_mul_mem with source, target, hom, span, ha, unitProduct
    have value : S[f(a) * 1] = f(a) by ring
    rw value at scalar
    rwa equation
  unfold Subalgebra
  refine ⟨subring, coefficients⟩

theorem linearSpan.product_adjoin (G H U V : Set)
  requires boundedG : G ⊆ S
  requires boundedH : H ⊆ S
  requires boundedU : U ⊆ S
  requires boundedV : V ⊆ S
  requires spansG : linearSpan(f, R, S, G) = algebraAdjoin(f, R, S, U)
  requires spansH : linearSpan(f, R, S, H) = algebraAdjoin(f, R, S, V)
  shows linearSpan(f, R, S, spanProducts(B, times, G, H)) = algebraAdjoin(f, R, S, U ∪ V)
proof
  have ordinary := IsCommRing.ring with target
  have algebraU := algebraAdjoin.subalgebra with source, target, hom, boundedU
  have algebraV := algebraAdjoin.subalgebra with source, target, hom, boundedV
  have algebraG := algebraU
  have algebraH := algebraV
  rw ← spansG at algebraG
  rw ← spansH at algebraH
  have generated := linearSpan.product_subalgebra with source, target, hom, boundedG, boundedH, algebraG, algebraH
  have ringG := Subalgebra.subring with source, target, hom, algebraG
  have ringH := Subalgebra.subring with source, target, hom, algebraH
  have unitG := IsSubring.one_closed with ringG
  have unitH := IsSubring.one_closed with ringH
  have containsU := algebraAdjoin.contains with source, target, hom, boundedU
  have containsV := algebraAdjoin.contains with source, target, hom, boundedV
  rw ← spansG at containsU
  rw ← spansH at containsV
  have generators : U ∪ V ⊆ linearSpan(f, R, S, spanProducts(B, times, G, H))
    intros u hu
    have casesU := union2.membership.forward with hu
    cases casesU with left | right
    . have inB : u ∈ S
        simp
      have member : u ∈ linearSpan(f, R, S, G) by simp [Subset]
      have product := linearSpan.product_mem with source, target, hom, boundedG, boundedH, member, unitH
      have equation : S[u * 1] = u by ring
      rwa equation at product
    . have inB : u ∈ S
        simp
      have member : u ∈ linearSpan(f, R, S, H) by simp [Subset]
      have product := linearSpan.product_mem with source, target, hom, boundedG, boundedH, unitG, member
      have equation : S[1 * u] = u by ring
      rwa equation at product
  have first := algebraAdjoin.least with source, target, hom, generated, generators
  have unionBound : U ∪ V ⊆ S by simp [Subset, union2.membership]
  have unionAlgebra := algebraAdjoin.subalgebra with source, target, hom, unionBound
  have unionModule := Subalgebra.submodule with source, target, hom, unionAlgebra
  have unionRing := Subalgebra.subring with source, target, hom, unionAlgebra
  have multiplication := IsSubring.mul_closed with unionRing
  have subsetU := union2.subset_left at U, V
  have subsetV := union2.subset_right at U, V
  have includedU := algebraAdjoin.mono with source, target, hom, subsetU
  have includedV := algebraAdjoin.mono with source, target, hom, subsetV
  have containsG := linearSpan.contains with source, target, hom, boundedG
  have containsH := linearSpan.contains with source, target, hom, boundedH
  rw spansG at containsG
  rw spansH at containsH
  have inUnionG := Subset.transitive with containsG, includedU
  have inUnionH := Subset.transitive with containsH, includedV
  have products : spanProducts(B, times, G, H) ⊆ algebraAdjoin(f, R, S, U ∪ V)
    intros p hp
    obtain ⟨pIn, g, hg, h, hh, value⟩ := spanProducts.membership.forward with hp
    have memberG : g ∈ algebraAdjoin(f, R, S, U ∪ V) by simp [Subset]
    have memberH : h ∈ algebraAdjoin(f, R, S, U ∪ V) by simp [Subset]
    rw value
    exact ClosedBinary.mem with multiplication, memberG, memberH
  have second := linearSpan.least with source, target, hom, unionModule, products
  exact Subset.antisymmetric with second, first

end Algebras
