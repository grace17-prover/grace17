module Grace.Cumulus.Algebra.IntegralInverse
import MonicRelations

section Algebras
variable (A add zero neg mul one B plus z minus times unit f a y : Set)
notation ring R := (A, add, zero, neg, mul, one)
notation ring S := (B, plus, z, minus, times, unit)
hypothesis source : IsCommRing(R)
hypothesis target : IsCommRing(S)
hypothesis hom : IsRingHom(f, R, S)
hypothesis coefficient : a ∈ R
hypothesis element : y ∈ S
hypothesis cancels : S[f(a) * y] = S[1]

theorem monicValue.inverse_relation (cs : List(A))
  shows ∃ p ∈ R, ∃ q ∈ R, S[f(p) * monicValue(R, f, S, y, cs)] = S[1 + f(a) * f(q)]
proof
  induction cs
  | List.nil =>
    have ordinary := IsCommRing.ring with source
    have monoid := IsRing.multiplicative with ordinary
    have oneIn := IsMonoid.unit_in_carrier with monoid
    have zeroIn := IsRing.zero_in_carrier with ordinary
    have oneValue := IsRingHom.one with hom
    have zeroValue := IsRingHom.zero with hom
    have imageA := IsRingHom.closed with hom, coefficient
    refine ⟨one, oneIn, zero, zeroIn, ?_⟩
    rw [monicValue, oneValue, zeroValue]
    ring
  | List.cons(c, tail) using ih =>
    obtain ⟨p, hp, q, hq, identity⟩ := ih
    have ordinary := IsCommRing.ring with source
    have cIn : c ∈ R by assumption
    have nextP := IsRing.mul_closed with ordinary, coefficient, hp
    have pcIn := IsRing.mul_closed with ordinary, hp, cIn
    have nextQ := IsRing.add_closed with ordinary, pcIn, hq
    have imageA := IsRingHom.closed with hom, coefficient
    have imageP := IsRingHom.closed with hom, hp
    have imageQ := IsRingHom.closed with hom, hq
    have imageC := IsRingHom.closed with hom, cIn
    have tailIn := monicValue.closed at A, add, zero, neg, mul, one, B, plus, z, minus, times, unit, f, y, tail with *
    have mapP := IsRingHom.mul with hom, coefficient, hp
    have mapPC := IsRingHom.mul with hom, hp, cIn
    have mapQ := IsRingHom.add with hom, pcIn, hq
    refine ⟨R[a * p], nextP, R[p * c + q], nextQ, ?_⟩
    rw [monicValue, mapP, mapQ, mapPC]
    have rearrange : S[(f(a) * f(p)) * (f(c) + y * monicValue(R, f, S, y, tail))] = S[f(a) * (f(p) * f(c)) + (f(a) * y) * (f(p) * monicValue(R, f, S, y, tail))]
      ring
    rw [rearrange, cancels, identity]
    ring

theorem IntegralOver.inverse_in_image
  requires integral : IntegralOver(f, R, S, y)
  shows ∃ b ∈ R, y = f(b)
proof
  have ordinary := IsCommRing.ring with source
  have targetRing := IsCommRing.ring with target
  have monoid := IsRing.multiplicative with targetRing
  have imageA := IsRingHom.closed with hom, coefficient
  have data := integral
  obtain ⟨cs, list, relation⟩ := data.right
  obtain ⟨p, hp, q, hq, identity⟩ := monicValue.inverse_relation at A, add, zero, neg, mul, one, B, plus, z, minus, times, unit, f, a, y, cs with *
  have imageP := IsRingHom.closed with hom, hp
  have imageQ := IsRingHom.closed with hom, hq
  have negative := IsRing.neg_closed with ordinary, hq
  have imageNegative := IsRingHom.closed with hom, negative
  have mapped := IsRingHom.neg with hom, hq
  rw relation at identity
  have annihilate : S[f(p) * 0] = S[0] by ring
  have vanishes : S[1 + f(a) * f(q)] = S[0] by cc
  have inverseValue : S[f(a) * f(R[-q])] = S[1]
    rw mapped
    have rearrange : S[f(a) * (-f(q))] = S[1 - (1 + f(a) * f(q))] by ring
    rw [rearrange, vanishes]
    ring
  have equal : y = f(R[-q])
    have rearrange : S[y * (f(a) * f(R[-q]))] = S[f(R[-q]) * (f(a) * y)] by ring
    rw [inverseValue, cancels] at rearrange
    have leftUnit : S[y * 1] = y by ring
    have rightUnit : S[f(R[-q]) * 1] = f(R[-q]) by ring
    cc
  refine ⟨R[-q], negative, equal⟩

end Algebras
