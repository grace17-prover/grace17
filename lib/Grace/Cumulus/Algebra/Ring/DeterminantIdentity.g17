module Grace.Cumulus.Algebra.Ring.DeterminantIdentity
import CharacteristicMatrix
import DeterminantZero

def identityMatrix (I A add zero neg mul one : Set) : Set :=
  characteristicMatrix(I, A, add, zero, neg, mul, one, constantFunction(I × I, A, zero), one)

notation scoped identityMatrix(I, R) => identityMatrix(I, R.carrier, R.add, R.zero, R.neg, R.mul, R.one)

theorem inversions.identity (n : Nat)
  shows inversions(n, identity(n)) = ∅
proof
  have positions := natural.member with *
  ext q
  constructor
  . intro member
    obtain ⟨bound, i, hi, j, hj, shape, forward, backward⟩ := inversions.membership.forward with member
    have first := identity.apply with hi
    have second := identity.apply with hj
    rw [first, second] at backward
    have iNat := positions with i, hi
    have jNat := positions with j, hj
    have increasingRule := Less.of_membership at i, j with *
    have increasing := increasingRule with forward
    have decreasingRule := Less.of_membership at j, i with *
    have decreasing := decreasingRule with backward
    have impossible : (0 : Nat) < (0 : Nat) by arith
    exfalso
    exact Less.irreflexive with Naturals.constructor.zero, impossible
  . intro impossible
    exfalso
    exact set.empty with impossible

section Rings
variable (A add zero neg mul one : Set)
notation ring R := (A, add, zero, neg, mul, one)
hypothesis ring : IsCommRing(R)

theorem permutationSign.identity (n : Nat)
  shows permutationSign(n, R, identity(n)) = R[1]
proof
  have emptyCount : cardinality(∅) = (0 : Nat)
    rw ← nat.zero
    exact cardinality.natural with Naturals.constructor.zero
  unfold permutationSign
  rw [inversions.identity, emptyCount]
  exact monoidPow.zero with *

theorem determinant.identity_entries (n : Nat) (M : Set)
  requires matrix : RingMatrix(n, R, M)
  requires diagonal : ∀ i ∈ n, M[i, i] = R[1]
  requires offDiagonal : ∀ i ∈ n, ∀ j ∈ n, i ≠ j → M[i, j] = R[0]
  shows determinant(n, R, M) = R[1]
proof
  have finite := Finite.natural at n with *
  have permutationsFinite := permutations.finite with finite
  have identityBijective := identity.bijective at n
  have identityInjective := Bijective.injective with identityBijective
  have identityFunction := Injective.function with identityInjective
  have identityMember := permutations.membership.backward at n, identity(n) with *
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have oneIn : R[1] ∈ R by typecheck
  have terms := determinantTerms.function at n, A, add, zero, neg, mul, one, M with *
  have selected := coefficientSingle.function at permutations(n), A, zero, one, identity(n) with *
  have entries : ∀ p ∈ permutations(n), determinantTerms(n, R, M)(p) = coefficientSingle(permutations(n), A, zero, one, identity(n))(p)
    intros p hp
    have permutation := permutations.membership.forward with hp
    have injective := Bijective.injective with permutation
    have function := Injective.function with injective
    have weights := permutationEntries.function at n, A, M, p with *
    have term := determinantTerms.value at n, A, add, zero, neg, mul, one, M, p with *
    have signIn := permutationSign.closed at A, add, zero, neg, mul, one, n, p with *
    have alternatives : p = identity(n) ∨ p ≠ identity(n) by tauto
    cases alternatives with same | different
    . have ones : ∀ i ∈ n, permutationEntries(n, R, M, p)(i) = R[1]
        intros i hi
        have value := permutationEntries.value at n, A, M, p, i with *
        have fixed := identity.apply at i, n with *
        have entry := diagonal with i, hi
        cc
      have product := finiteRingProduct.one at n, A, add, zero, neg, mul, one, permutationEntries(n, R, M, p) with *
      have sign := permutationSign.identity at A, add, zero, neg, mul, one, n with *
      have selectedValue := coefficientSingle.same at permutations(n), A, zero, one, identity(n) with *
      rw [term, product, same, sign, selectedValue]
      ring
    . have moved : ∃ i ∈ n, p(i) ≠ i
        by_contra absent
        apply different
        apply FunctionBetween.ext with function, identityFunction
        intros i hi
        have fixed : p(i) = i
          by_contra notFixed
          apply absent
          refine ⟨i, hi, notFixed⟩
        have value := identity.apply at i, n with *
        cc
      obtain ⟨i, hi, notFixed⟩ := moved
      have column := FunctionBetween.apply_closed at p, n, n, i with *
      have distinct : i ≠ p(i)
        intro equal
        apply notFixed
        cc
      have off := offDiagonal with i, hi, p(i), column, distinct
      have value := permutationEntries.value at n, A, M, p, i with *
      have vanishes : permutationEntries(n, R, M, p)(i) = R[0] by cc
      have product := finiteRingProduct.zero_of_factor at n, A, add, zero, neg, mul, one, permutationEntries(n, R, M, p), i with *
      have selectedValue := coefficientSingle.other at permutations(n), A, zero, one, identity(n), p with *
      rw [term, product, selectedValue]
      ring
  have sum := finiteRingSum.congr at permutations(n), A, add, zero, neg, mul, one, determinantTerms(n, R, M), coefficientSingle(permutations(n), A, zero, one, identity(n)) with *
  have single := finiteRingSum.single at permutations(n), A, add, zero, neg, mul, one, one, identity(n) with *
  unfold determinant
  cc

theorem identityMatrix.matrix (I : Set)
  shows RingMatrix(I, R, identityMatrix(I, R))
proof
  have zeroIn : R[0] ∈ R by typecheck
  have oneIn : R[1] ∈ R by typecheck
  have matrix : RingMatrix(I, R, constantFunction(I × I, A, zero))
    unfold RingMatrix
    exact constantFunction.function with *
  unfold identityMatrix
  exact characteristicMatrix.matrix with *

theorem identityMatrix.entry (I i j : Set)
  requires row : i ∈ I
  requires column : j ∈ I
  shows identityMatrix(I, R)[i, j] = singleValue(A, zero, one, j, i)
proof
  have zeroIn : R[0] ∈ R by typecheck
  have oneIn : R[1] ∈ R by typecheck
  have matrix : RingMatrix(I, R, constantFunction(I × I, A, zero))
    unfold RingMatrix
    exact constantFunction.function with *
  have pair := product.pair at i, j, I, I with *
  have value := constantFunction.apply at I × I, A, (i, j), zero with *
  have entry := characteristicMatrix.entry at I, A, add, zero, neg, mul, one, constantFunction(I × I, A, zero), one, i, j with *
  have scalar := singleValue.closed at A, zero, one, j, i with *
  unfold identityMatrix
  ring

theorem determinant.identity (n : Nat)
  shows determinant(n, R, identityMatrix(n, R)) = R[1]
proof
  have matrix := identityMatrix.matrix at A, add, zero, neg, mul, one, n with *
  have zeroIn : R[0] ∈ R by typecheck
  have oneIn : R[1] ∈ R by typecheck
  have diagonal : ∀ i ∈ n, identityMatrix(n, R)[i, i] = R[1]
    intros i hi
    have same : i = i by rfl
    have entry := identityMatrix.entry at A, add, zero, neg, mul, one, n, i, i with *
    have delta := singleValue.same at A, zero, one, i, i with *
    cc
  have offDiagonal : ∀ i ∈ n, ∀ j ∈ n, i ≠ j → identityMatrix(n, R)[i, j] = R[0]
    intros i hi j hj different
    have entry := identityMatrix.entry at A, add, zero, neg, mul, one, n, i, j with *
    have delta := singleValue.other at A, zero, one, j, i with *
    cc
  exact determinant.identity_entries with *

end Rings
