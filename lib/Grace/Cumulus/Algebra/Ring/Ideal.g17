-- Authors: Grant Passmore

module Grace.Cumulus.Algebra.Ring.Ideal
import Basic
import IdealCore

-- Under a hypothesis Ring(R), an ideal of R is a subset containing zero and
-- closed under addition, negation, and multiplication by any element of R
-- on either side; a proper ideal omits one, and a maximal ideal is a proper
-- ideal contained in no larger proper ideal. The predicates take the ring
-- first, Ideal(R, I), and their bodies read the operations off the
-- hypothesis, so each is a formula over R.add, R.zero, R.neg, and R.mul
-- alone. IsIdeal(A, add, zero, neg, mul, I), IsProperIdeal(A, …, one, I),
-- and IsMaximalIdeal(A, …, one, M) remain the forms over separate pieces,
-- bridged below.
section Definitions
variable (R : Set)
hypothesis ring : Ring(R)

predicate Ideal (I : Set) :=
  I ⊆ R ∧ R[0] ∈ I ∧ (∀ x y ∈ I, x + y ∈ I) ∧
  (∀ x ∈ I, -x ∈ I) ∧ (∀ a ∈ R, ∀ x ∈ I, a * x ∈ I ∧ x * a ∈ I)
predicate ProperIdeal (I : Set) := Ideal(I) ∧ R[1] ∉ I
predicate MaximalIdeal (M : Set) :=
  ProperIdeal(M) ∧ (∀ J, ProperIdeal(J) → M ⊆ J → J = M)

end Definitions

-- On the elements of an ideal the operations are written as in the ring:
-- under Ideal(R, I) a binder (x : I) is x ∈ I, and x + y, x * y, -x, and
-- x - y are the operations of R.
notation infixl 60 "+" => call2(R.add, _, _) via hypothesis Ideal(R, I) for I
notation infixl 70 "*" => call2(R.mul, _, _) via hypothesis Ideal(R, I) for I
notation prefix 75 "-" => apply(R.neg, _) via hypothesis Ideal(R, I) for I
notation infixl 60 "-" => Ring.sub(R, _, _) via hypothesis Ideal(R, I) for I
notation infixl 60 "+" => call2(R.add, _, _) via hypothesis ProperIdeal(R, I) for I
notation infixl 70 "*" => call2(R.mul, _, _) via hypothesis ProperIdeal(R, I) for I
notation prefix 75 "-" => apply(R.neg, _) via hypothesis ProperIdeal(R, I) for I
notation infixl 60 "-" => Ring.sub(R, _, _) via hypothesis ProperIdeal(R, I) for I
notation infixl 60 "+" => call2(R.add, _, _) via hypothesis MaximalIdeal(R, I) for I
notation infixl 70 "*" => call2(R.mul, _, _) via hypothesis MaximalIdeal(R, I) for I
notation prefix 75 "-" => apply(R.neg, _) via hypothesis MaximalIdeal(R, I) for I
notation infixl 60 "-" => Ring.sub(R, _, _) via hypothesis MaximalIdeal(R, I) for I

-- Bridges between the bundled predicates and the forms over separate
-- pieces. The bundled-to-unbundled directions are instances, so `with *`
-- reads the unbundled form off a bundled hypothesis; of_projections comes
-- back for a ring value, and of_parts for a constructed ring.
instance Ideal.parts (R I : Set)
  requires ideal : Ideal(R, I)
  shows IsIdeal(R.carrier, R.add, R.zero, R.neg, R.mul, I)
proof
  obtain ⟨bounded, zeroIn, sums, negatives, products⟩ := ideal
  unfold IsIdeal
  exact ⟨bounded, zeroIn, sums, negatives, products⟩

theorem Ideal.of_projections (R I : Set)
  requires ideal : IsIdeal(R.carrier, R.add, R.zero, R.neg, R.mul, I)
  shows Ideal(R, I)
proof
  obtain ⟨bounded, zeroIn, sums, negatives, products⟩ := ideal
  unfold Ideal.Ideal
  exact ⟨bounded, zeroIn, sums, negatives, products⟩

theorem Ideal.of_parts (A add zero neg mul one I : Set)
  requires ideal : IsIdeal(A, add, zero, neg, mul, I)
  shows Ideal(Ring.mk(A, add, zero, neg, mul, one), I)
proof
  have shifted : IsIdeal(Ring.carrier(Ring.mk(A, add, zero, neg, mul, one)),
      Ring.add(Ring.mk(A, add, zero, neg, mul, one)),
      Ring.zero(Ring.mk(A, add, zero, neg, mul, one)),
      Ring.neg(Ring.mk(A, add, zero, neg, mul, one)),
      Ring.mul(Ring.mk(A, add, zero, neg, mul, one)), I)
    ring_projections
  exact Ideal.of_projections with shifted

instance ProperIdeal.parts (R I : Set)
  requires proper : ProperIdeal(R, I)
  shows IsProperIdeal(R.carrier, R.add, R.zero, R.neg, R.mul, R.one, I)
proof
  obtain ⟨ideal, oneOut⟩ := proper
  have parts := Ideal.parts with ideal
  unfold IsProperIdeal
  exact ⟨parts, oneOut⟩

theorem ProperIdeal.of_projections (R I : Set)
  requires proper : IsProperIdeal(R.carrier, R.add, R.zero, R.neg, R.mul, R.one, I)
  shows ProperIdeal(R, I)
proof
  obtain ⟨ideal, oneOut⟩ := proper
  have bundled := Ideal.of_projections with ideal
  unfold Ideal.ProperIdeal
  exact ⟨bundled, oneOut⟩

theorem ProperIdeal.of_parts (A add zero neg mul one I : Set)
  requires proper : IsProperIdeal(A, add, zero, neg, mul, one, I)
  shows ProperIdeal(Ring.mk(A, add, zero, neg, mul, one), I)
proof
  have shifted : IsProperIdeal(Ring.carrier(Ring.mk(A, add, zero, neg, mul, one)),
      Ring.add(Ring.mk(A, add, zero, neg, mul, one)),
      Ring.zero(Ring.mk(A, add, zero, neg, mul, one)),
      Ring.neg(Ring.mk(A, add, zero, neg, mul, one)),
      Ring.mul(Ring.mk(A, add, zero, neg, mul, one)),
      Ring.one(Ring.mk(A, add, zero, neg, mul, one)), I)
    ring_projections
  exact ProperIdeal.of_projections with shifted

instance MaximalIdeal.parts (R M : Set)
  requires maximal : MaximalIdeal(R, M)
  shows IsMaximalIdeal(R.carrier, R.add, R.zero, R.neg, R.mul, R.one, M)
proof
  obtain ⟨proper, largest⟩ := maximal
  have parts := ProperIdeal.parts with proper
  unfold IsMaximalIdeal
  refine ⟨parts, ?_⟩
  intros J properJ contains
  have bundledJ := ProperIdeal.of_projections with properJ
  exact largest with J, bundledJ, contains

theorem MaximalIdeal.of_projections (R M : Set)
  requires maximal : IsMaximalIdeal(R.carrier, R.add, R.zero, R.neg, R.mul, R.one, M)
  shows MaximalIdeal(R, M)
proof
  obtain ⟨proper, largest⟩ := maximal
  have bundled := ProperIdeal.of_projections with proper
  unfold Ideal.MaximalIdeal
  refine ⟨bundled, ?_⟩
  intros J properJ contains
  have partsJ := ProperIdeal.parts with properJ
  exact largest with J, partsJ, contains

theorem MaximalIdeal.of_parts (A add zero neg mul one M : Set)
  requires maximal : IsMaximalIdeal(A, add, zero, neg, mul, one, M)
  shows MaximalIdeal(Ring.mk(A, add, zero, neg, mul, one), M)
proof
  have shifted : IsMaximalIdeal(Ring.carrier(Ring.mk(A, add, zero, neg, mul, one)),
      Ring.add(Ring.mk(A, add, zero, neg, mul, one)),
      Ring.zero(Ring.mk(A, add, zero, neg, mul, one)),
      Ring.neg(Ring.mk(A, add, zero, neg, mul, one)),
      Ring.mul(Ring.mk(A, add, zero, neg, mul, one)),
      Ring.one(Ring.mk(A, add, zero, neg, mul, one)), M)
    ring_projections
  exact MaximalIdeal.of_projections with shifted

-- The projections down the hierarchy; the instance paths form a chain.
instance ProperIdeal.to_ideal (R I : Set)
  requires proper : ProperIdeal(R, I)
  shows Ideal(R, I)
proof
  obtain ⟨ideal, oneOut⟩ := proper
  exact ideal

theorem ProperIdeal.one_not_mem (R I : Set)
  requires proper : ProperIdeal(R, I)
  shows R[1] ∉ I
proof
  obtain ⟨ideal, oneOut⟩ := proper
  exact oneOut

instance MaximalIdeal.to_proper (R M : Set)
  requires maximal : MaximalIdeal(R, M)
  shows ProperIdeal(R, M)
proof
  obtain ⟨proper, largest⟩ := maximal
  exact proper

theorem MaximalIdeal.to_ideal (R M : Set)
  requires maximal : MaximalIdeal(R, M)
  shows Ideal(R, M)
proof
  have proper := MaximalIdeal.to_proper with maximal
  exact ProperIdeal.to_ideal with proper

section IdealLaws
variable (R I : Set)
hypothesis ideal : Ideal(R, I)

theorem Ideal.subset
  shows I ⊆ R.carrier
proof
  obtain ⟨bounded, rest⟩ := ideal
  exact bounded

-- Closure: the carrier membership of an element of the ideal is a typing
-- rule, and the membership of zero, a sum, and a negation are instances,
-- so each is synthesized.
theorem Ideal.mem_carrier (x : I)
  shows x ∈ R.carrier
proof
  have bounded := Ideal.subset with ideal
  have xIn : x ∈ I by assumption
  exact bounded with x, xIn

instance Ideal.zero_mem
  shows R[0] ∈ I
proof
  obtain ⟨bounded, zeroIn, rest⟩ := ideal
  exact zeroIn

instance Ideal.add_mem (x y : I)
  shows x + y ∈ I
proof
  obtain ⟨bounded, zeroIn, sums, negatives, products⟩ := ideal
  have xIn : x ∈ I by assumption
  have yIn : y ∈ I by assumption
  exact sums with x, xIn, y, yIn

instance Ideal.neg_mem (x : I)
  shows -x ∈ I
proof
  obtain ⟨bounded, zeroIn, sums, negatives, products⟩ := ideal
  have xIn : x ∈ I by assumption
  exact negatives with x, xIn

theorem Ideal.nonempty
  shows Nonempty(I)
proof
  have zeroIn : R[0] ∈ I := Ideal.zero_mem with *
  exact ⟨R[0], zeroIn⟩

end IdealLaws

section IdealAbsorption
variable (R I : Set)
hypothesis ring : Ring(R)
hypothesis ideal : Ideal(R, I)

-- Absorption on either side, and closure under subtraction.
instance Ideal.mul_left_mem (a : R) (x : I)
  shows a * x ∈ I
proof
  obtain ⟨bounded, zeroIn, sums, negatives, products⟩ := ideal
  have aIn : a ∈ R by assumption
  have xIn : x ∈ I by assumption
  have both := products with a, aIn, x, xIn
  exact both.left

instance Ideal.mul_right_mem (a : R) (x : I)
  shows x * a ∈ I
proof
  obtain ⟨bounded, zeroIn, sums, negatives, products⟩ := ideal
  have aIn : a ∈ R by assumption
  have xIn : x ∈ I by assumption
  have both := products with a, aIn, x, xIn
  exact both.right

instance Ideal.sub_mem (x y : I)
  shows x - y ∈ I
proof
  have xIn : x ∈ R := Ideal.mem_carrier with *
  have yIn : y ∈ R := Ideal.mem_carrier with *
  have negIn : -y ∈ I := Ideal.neg_mem with *
  rw Ring.sub.value
  exact Ideal.add_mem with *

end IdealAbsorption

section IdealConstructions
variable (R : Set)
hypothesis ring : Ring(R)

-- The constructor.
theorem Ideal.mk (I : Set)
  requires bounded : I ⊆ R
  requires zeroIn : R[0] ∈ I
  requires sums : ∀ x y ∈ I, x + y ∈ I
  requires negatives : ∀ x ∈ I, -x ∈ I
  requires products : ∀ a ∈ R, ∀ x ∈ I, a * x ∈ I ∧ x * a ∈ I
  shows Ideal(R, I)
proof
  unfold Ideal.Ideal
  exact ⟨bounded, zeroIn, sums, negatives, products⟩

theorem ProperIdeal.mk (I : Set)
  requires ideal : Ideal(R, I)
  requires oneOut : R[1] ∉ I
  shows ProperIdeal(R, I)
proof
  unfold Ideal.ProperIdeal
  exact ⟨ideal, oneOut⟩

-- The ideals every ring has: the whole ring and the zero ideal.
theorem Ideal.whole
  shows Ideal(R, R.carrier)
proof
  have reflexive := Subset.reflexive at R.carrier
  have zeroIn : R[0] ∈ R := Ring.zero_mem with *
  apply Ideal.mk with ring, reflexive, zeroIn
  . intros x hx y hy
    exact Ring.add_mem with *
  . intros x hx
    exact Ring.neg_mem with *
  . intros a ha x hx
    constructor
    . exact Ring.mul_mem with *
    . exact Ring.mul_mem with *

theorem Ideal.zero
  shows Ideal(R, {R[0]})
proof
  have parts := Ring.parts with ring
  have engine := IsIdeal.zero_ideal with parts
  exact Ideal.of_projections with engine

-- An ideal containing one is the whole ring, so a proper ideal is exactly
-- an ideal different from the ring.
theorem Ideal.contains_one (I : Set)
  requires ideal : Ideal(R, I)
  requires oneIn : R[1] ∈ I
  shows I = R.carrier
proof
  have parts := Ring.parts with ring
  have engine := Ideal.parts with ideal
  exact IsIdeal.whole_of_one with parts, engine, oneIn

theorem ProperIdeal.iff_ne_carrier (I : Set)
  requires ideal : Ideal(R, I)
  shows ProperIdeal(R, I) ↔ I ≠ R.carrier
proof
  have parts := Ring.parts with ring
  have engine := Ideal.parts with ideal
  have criterion := IsProperIdeal.iff_ne_whole with parts, engine
  constructor
  . intro proper
    exact criterion.forward with (ProperIdeal.parts with proper)
  . intro distinct
    exact ProperIdeal.of_projections with (criterion.backward with distinct)

theorem ProperIdeal.zero
  requires nontrivial : R[0] ≠ R[1]
  shows ProperIdeal(R, {R[0]})
proof
  have parts := Ring.parts with ring
  have zeroIn : R[0] ∈ R := Ring.zero_mem with *
  have oneIn : R[1] ∈ R := Ring.one_mem with *
  have distinct : Nontrivial(R.carrier, R.zero, R.one)
    unfold Nontrivial
    exact ⟨zeroIn, oneIn, nontrivial⟩
  have engine := IsProperIdeal.zero_ideal with parts, distinct
  exact ProperIdeal.of_projections with engine

-- An ideal above a maximal ideal is the maximal ideal or the whole ring.
theorem MaximalIdeal.overideal (M J : Set)
  requires maximal : MaximalIdeal(R, M)
  requires ideal : Ideal(R, J)
  requires contains : M ⊆ J
  shows J = M ∨ J = R.carrier
proof
  have parts := Ring.parts with ring
  have engineM := MaximalIdeal.parts with maximal
  have engineJ := Ideal.parts with ideal
  exact IsMaximalIdeal.eq_or_whole with parts, engineM, engineJ, contains

end IdealConstructions
