-- Polynomials evaluated at a square matrix: the scalar matrices a · 1, the
-- commutative ring commutant(R, n, M) generated inside the matrix ring by M
-- and the scalars, and the evaluation evalAt(M) : polynomialRing(R, {0})
-- →+* commutant(R, n, M) sending X to M and the constants to the scalar
-- matrices; everything here is ZF
-- Part of Cumulus, the Grace17 mathematics library.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module Grace.Cumulus.Algebra.Ring.MatrixPolynomial
import MatrixCramer
import Bicommutant
import Polynomial.BundledEvaluation

-- The scalar matrix a · 1, the embedding of R, and the commutative ring
-- of matrices commuting with everything that commutes with M.
def scalarMatrix (R n a : Set) : Set := scalarMultiple(R, n, a, oneMatrix(R, n))
def commutant (R n M : Set) : Set := bicommutantRing(matrixRing(R, n), {M})

section Scalars
variable (R : Set) (n : Nat)
hypothesis comm : CommRing(R)

theorem oneMatrix.guard
  shows oneMatrix(R, n) : R ^ n × n
proof
  have one := oneMatrix.matrix at R, n with *
  exact Matrix.of_square with one

theorem scalarMatrix.entry (a : R) (i j : Set)
  requires row : i ∈ n
  requires column : j ∈ n
  shows scalarMatrix(R, n, a)[i, j] = a * singleValue(R.carrier, R.zero, R.one, j, i)
proof
  have one := oneMatrix.guard at R, n with *
  have entry := scalarMultiple.entry at R, n, a, oneMatrix(R, n), i, j with *
  have unit := oneMatrix.entry at R, n, i, j with *
  unfold scalarMatrix
  cc

theorem scalarMatrix.guard (a : R)
  shows scalarMatrix(R, n, a) : R ^ n × n
proof
  have one := oneMatrix.guard at R, n with *
  unfold scalarMatrix
  exact scalarMultiple.matrix with *

instance scalarMatrix.mem (a : R)
  shows scalarMatrix(R, n, a) ∈ Ring.carrier(matrixRing(R, n))
proof
  have guard := scalarMatrix.guard at R, n, a with *
  exact Matrix.mem_ring with guard

-- Scalar matrices multiply every matrix entrywise, from either side.
theorem scalarMatrix.mul_left (a : R) (N : R ^ n × n)
  shows scalarMatrix(R, n, a) * N = scalarMultiple(R, n, a, N)
proof
  have parts := CommRing.parts with comm
  have finite := Finite.natural at n
  have scalar := scalarMatrix.guard at R, n, a with *
  have product := Matrix.of_mem at scalarMatrix(R, n, a) * N, R, n with (Ring.mul_mem with *)
  have scaled := scalarMultiple.matrix at R, n, a, N with *
  have aIn : a ∈ R by assumption
  apply Matrix.ext with product, scaled
  intros i hi j hj
  have entryN := Matrix.entry at N, R, n, i, j with *
  have entry := matrixRing.mul_entry at R, n, scalarMatrix(R, n, a), N, i, j with *
  have scale := scalarMultiple.entry at R, n, a, N, i, j with *
  have squareS := Matrix.square at scalarMatrix(R, n, a), R, n with *
  have squareN := Matrix.square at N, R, n with assumption
  have shapeS := squareMatrices.membership.forward with squareS
  have shapeN := squareMatrices.membership.forward with squareN
  have weights := matrixProductWeights.function at n, R.carrier, R.add, R.zero,
    R.neg, R.mul, R.one, scalarMatrix(R, n, a), N, i, j with *
  have selector := coefficientSingle.function at n, R.carrier, R.zero, a * N[i, j], i with *
  have values : ∀ k ∈ n, matrixProductWeights(n, Ring.carrier(R), R.add, R.zero, R.neg, R.mul, R.one, scalarMatrix(R, n, a), N, i, j)(k) =
      coefficientSingle(n, Ring.carrier(R), R.zero, a * N[i, j], i)(k)
    intros k hk
    have entryK := Matrix.entry at N, R, n, k, j with *
    have weight := matrixProductWeights.value at n, R.carrier, R.add, R.zero,
      R.neg, R.mul, R.one, scalarMatrix(R, n, a), N, i, j, k with *
    have scalarEntry := scalarMatrix.entry at R, n, a, i, k with *
    have alternatives : k = i ∨ k ≠ i by tauto
    cases alternatives with same | different
    . have equal : i = k by cc
      have delta := singleValue.same at R.carrier, R.zero, R.one, k, i with *
      have selected := coefficientSingle.same at n, R.carrier, R.zero, a * N[i, j], i with *
      rw [weight, scalarEntry, delta, same, selected]
      ring
    . have reverse : i ≠ k
        intro equal
        apply different
        cc
      have delta := singleValue.other at R.carrier, R.zero, R.one, k, i with *
      have selected := coefficientSingle.other at n, R.carrier, R.zero, a * N[i, j], i, k with *
      rw [weight, scalarEntry, delta, selected]
      ring
  have same := finiteRingSum.congr with values
  have single := finiteRingSum.single at n, R.carrier, R.add, R.zero, R.neg,
    R.mul, R.one, a * N[i, j], i with *
  unfold matrixProductEntry at entry
  cc

theorem scalarMatrix.mul_right (a : R) (N : R ^ n × n)
  shows N * scalarMatrix(R, n, a) = scalarMultiple(R, n, a, N)
proof
  have parts := CommRing.parts with comm
  have finite := Finite.natural at n
  have scalar := scalarMatrix.guard at R, n, a with *
  have product := Matrix.of_mem at N * scalarMatrix(R, n, a), R, n with (Ring.mul_mem with *)
  have scaled := scalarMultiple.matrix at R, n, a, N with *
  have aIn : a ∈ R by assumption
  apply Matrix.ext with product, scaled
  intros i hi j hj
  have entryN := Matrix.entry at N, R, n, i, j with *
  have entry := matrixRing.mul_entry at R, n, N, scalarMatrix(R, n, a), i, j with *
  have scale := scalarMultiple.entry at R, n, a, N, i, j with *
  have squareS := Matrix.square at scalarMatrix(R, n, a), R, n with *
  have squareN := Matrix.square at N, R, n with assumption
  have shapeS := squareMatrices.membership.forward with squareS
  have shapeN := squareMatrices.membership.forward with squareN
  have weights := matrixProductWeights.function at n, R.carrier, R.add, R.zero,
    R.neg, R.mul, R.one, N, scalarMatrix(R, n, a), i, j with *
  have selector := coefficientSingle.function at n, R.carrier, R.zero, a * N[i, j], j with *
  have values : ∀ k ∈ n, matrixProductWeights(n, Ring.carrier(R), R.add, R.zero, R.neg, R.mul, R.one, N, scalarMatrix(R, n, a), i, j)(k) =
      coefficientSingle(n, Ring.carrier(R), R.zero, a * N[i, j], j)(k)
    intros k hk
    have entryK := Matrix.entry at N, R, n, i, k with *
    have weight := matrixProductWeights.value at n, R.carrier, R.add, R.zero,
      R.neg, R.mul, R.one, N, scalarMatrix(R, n, a), i, j, k with *
    have scalarEntry := scalarMatrix.entry at R, n, a, k, j with *
    have alternatives : k = j ∨ k ≠ j by tauto
    cases alternatives with same | different
    . have delta := singleValue.same at R.carrier, R.zero, R.one, j, k with *
      have selected := coefficientSingle.same at n, R.carrier, R.zero, a * N[i, j], j with *
      rw [weight, scalarEntry, delta, same, selected]
      ring
    . have delta := singleValue.other at R.carrier, R.zero, R.one, j, k with *
      have selected := coefficientSingle.other at n, R.carrier, R.zero, a * N[i, j], j, k with *
      rw [weight, scalarEntry, delta, selected]
      ring
  have same := finiteRingSum.congr with values
  have single := finiteRingSum.single at n, R.carrier, R.add, R.zero, R.neg,
    R.mul, R.one, a * N[i, j], j with *
  unfold matrixProductEntry at entry
  cc

theorem scalarMatrix.central (a : R) (N : R ^ n × n)
  shows scalarMatrix(R, n, a) * N = N * scalarMatrix(R, n, a)
proof
  have left := scalarMatrix.mul_left at R, n, a, N with *
  have right := scalarMatrix.mul_right at R, n, a, N with *
  cc

theorem scalarMatrix.add (a b : R)
  shows scalarMatrix(R, n, a + b) = scalarMatrix(R, n, a) + scalarMatrix(R, n, b)
proof
  have sumIn : a + b ∈ R := Ring.add_mem with *
  have guardA := scalarMatrix.guard at R, n, a with *
  have guardB := scalarMatrix.guard at R, n, b with *
  have guardSum := scalarMatrix.guard at R, n, a + b with *
  have total := Matrix.of_mem at scalarMatrix(R, n, a) + scalarMatrix(R, n, b), R, n with (Ring.add_mem with *)
  apply Matrix.ext with guardSum, total
  intros i hi j hj
  have zeroIn : R[0] ∈ R := Ring.zero_mem with *
  have oneIn : R[1] ∈ R := Ring.one_mem with *
  have delta := singleValue.closed at R.carrier, R.zero, R.one, j, i with *
  have entry := matrixRing.add_entry at R, n, scalarMatrix(R, n, a), scalarMatrix(R, n, b), i, j with *
  have left := scalarMatrix.entry at R, n, a, i, j with *
  have right := scalarMatrix.entry at R, n, b, i, j with *
  have both := scalarMatrix.entry at R, n, a + b, i, j with *
  rw [entry, left, right, both]
  ring

theorem scalarMatrix.mul (a b : R)
  shows scalarMatrix(R, n, a * b) = scalarMatrix(R, n, a) * scalarMatrix(R, n, b)
proof
  have productIn : a * b ∈ R := Ring.mul_mem with *
  have guardB := scalarMatrix.guard at R, n, b with *
  have guardProduct := scalarMatrix.guard at R, n, a * b with *
  have scaled := scalarMultiple.matrix at R, n, a, scalarMatrix(R, n, b) with *
  have left := scalarMatrix.mul_left at R, n, a, scalarMatrix(R, n, b) with *
  rw left
  apply Matrix.ext with guardProduct, scaled
  intros i hi j hj
  have zeroIn : R[0] ∈ R := Ring.zero_mem with *
  have oneIn : R[1] ∈ R := Ring.one_mem with *
  have delta := singleValue.closed at R.carrier, R.zero, R.one, j, i with *
  have scale := scalarMultiple.entry at R, n, a, scalarMatrix(R, n, b), i, j with *
  have inner := scalarMatrix.entry at R, n, b, i, j with *
  have both := scalarMatrix.entry at R, n, a * b, i, j with *
  rw [scale, inner, both]
  ring

theorem scalarMatrix.one
  shows scalarMatrix(R, n, R[1]) = matrixRing(R, n)[1]
proof
  have oneIn : R[1] ∈ R := Ring.one_mem with *
  have guard := scalarMatrix.guard at R, n, R[1] with *
  have one := Matrix.of_mem at matrixRing(R, n)[1], R, n with (Ring.one_mem with *)
  apply Matrix.ext with guard, one
  intros i hi j hj
  have zeroIn : R[0] ∈ R := Ring.zero_mem with *
  have delta := singleValue.closed at R.carrier, R.zero, R.one, j, i with *
  have entry := scalarMatrix.entry at R, n, R[1], i, j with *
  have unit := matrixRing.one_entry at R, n, i, j with *
  rw [entry, unit]
  ring

end Scalars

-- The embedding of R into its matrix ring.
defgraph scalarEmbedding (R n : Set) (a ∈ Ring.carrier(R)) : Ring.carrier(matrixRing(R, n)) :=
  scalarMatrix(R, n, a)
requires comm : CommRing(R)
requires natural : Nat(n)
proof
  exact scalarMatrix.mem with *

-- Evaluation at M: the polynomials over R in the variable X(R, {0}, 0)
-- mapped into the commutant of M.
def matrixEvaluation (R n M : Set) : Set :=
  evaluationHom(R, commutant(R, n, M), {0}, scalarEmbedding(R, n),
    constantFunction({0}, Ring.carrier(commutant(R, n, M)), M))

notation function "evalAt(M)" => matrixEvaluation(R, n, M) via hypothesis Matrix(M, R, m, n)

section Commutants
variable (R : Set) (n : Nat)
hypothesis comm : CommRing(R)

theorem commutant.carrierOf (M : R ^ n × n)
  shows Ring.carrier(commutant(R, n, M)) = bicommutant(matrixRing(R, n), {M})
proof
  unfold commutant
  exact bicommutantRing.carrierOf at matrixRing(R, n), {M}

theorem commutant.generators (M : R ^ n × n)
  shows {M} ⊆ Ring.carrier(matrixRing(R, n))
proof
  intros s hs
  have equal := singleton.membership.forward with hs
  rw equal
  exact Matrix.mem_ring with assumption

theorem commutant.generators_commute (M : R ^ n × n)
  shows {M} ⊆ ringCentralizer(matrixRing(R, n), {M})
proof
  have ring := matrixRing.ring at R, n with *
  have member := Matrix.mem_ring at M, R, n with assumption
  exact bicommutant.singleton_commuting at matrixRing(R, n), {M}, M with *

instance commutant.comm_ring (M : R ^ n × n)
  shows CommRing(commutant(R, n, M))
proof
  have ring := matrixRing.ring at R, n with *
  have bounded := commutant.generators at R, n, M with *
  have commuting := commutant.generators_commute at R, n, M with *
  unfold commutant
  exact bicommutantRing.comm_ring with *

theorem commutant.subset (M : R ^ n × n)
  shows Ring.carrier(commutant(R, n, M)) ⊆ Ring.carrier(matrixRing(R, n))
proof
  have ring := matrixRing.ring at R, n with *
  have bounded := commutant.generators at R, n, M with *
  rw commutant.carrierOf
  exact bicommutant.subset with *

theorem commutant.mem_matrix (M : R ^ n × n) (N : Set)
  requires member : N ∈ Ring.carrier(commutant(R, n, M))
  shows N : R ^ n × n
proof
  have subset := commutant.subset at R, n, M with *
  have inRing := subset with N, member
  exact Matrix.of_mem with inRing

instance commutant.self_mem (M : R ^ n × n)
  shows M ∈ Ring.carrier(commutant(R, n, M))
proof
  have ring := matrixRing.ring at R, n with *
  have bounded := commutant.generators at R, n, M with *
  have contains := bicommutant.contains at matrixRing(R, n), {M} with *
  have self : M ∈ {M} by simp [singleton.membership]
  rw commutant.carrierOf
  exact contains with M, self

theorem commutant.scalar_mem (M : R ^ n × n) (a : R)
  shows scalarMatrix(R, n, a) ∈ Ring.carrier(commutant(R, n, M))
proof
  have ring := matrixRing.ring at R, n with *
  have bounded := commutant.generators at R, n, M with *
  have central := ringCentralizer.subset at matrixRing(R, n), {M} with *
  have element := scalarMatrix.mem at R, n, a with *
  have commutes : ∀ N ∈ ringCentralizer(matrixRing(R, n), {M}),
      call2(Ring.mul(matrixRing(R, n)), scalarMatrix(R, n, a), N) =
        call2(Ring.mul(matrixRing(R, n)), N, scalarMatrix(R, n, a))
    intros N hN
    have inRing := central with N, hN
    have guard := Matrix.of_mem with inRing
    exact scalarMatrix.central with *
  rw commutant.carrierOf
  unfold bicommutant
  exact ringCentralizer.mem at matrixRing(R, n), ringCentralizer(matrixRing(R, n), {M}), scalarMatrix(R, n, a) with *

-- Sums, products, and negations in the commutant are those of the matrix ring.
theorem commutant.add_value (M : R ^ n × n) (N P : Set)
  requires memberN : N ∈ Ring.carrier(commutant(R, n, M))
  requires memberP : P ∈ Ring.carrier(commutant(R, n, M))
  shows call2(Ring.add(commutant(R, n, M)), N, P) = call2(Ring.add(matrixRing(R, n)), N, P)
proof
  have ring := matrixRing.ring at R, n with *
  have parts := Ring.parts with ring
  have bounded := commutant.generators at R, n, M with *
  have subring := bicommutant.subring at matrixRing(R, n), {M} with *
  have subset := IsSubring.subset_carrier with subring
  have closed := IsSubring.add_closed with subring
  have magma : IsMagma(Ring.carrier(matrixRing(R, n)), Ring.add(matrixRing(R, n)))
    simp [IsRing, IsAbelianGroup, IsGroup, IsMonoid, IsSemigroup]
  rw commutant.carrierOf at memberN
  rw commutant.carrierOf at memberP
  unfold commutant
  rw bicommutantRing.addOf
  exact restrictBinary.value with *

theorem commutant.mul_value (M : R ^ n × n) (N P : Set)
  requires memberN : N ∈ Ring.carrier(commutant(R, n, M))
  requires memberP : P ∈ Ring.carrier(commutant(R, n, M))
  shows call2(Ring.mul(commutant(R, n, M)), N, P) = call2(Ring.mul(matrixRing(R, n)), N, P)
proof
  have ring := matrixRing.ring at R, n with *
  have parts := Ring.parts with ring
  have bounded := commutant.generators at R, n, M with *
  have subring := bicommutant.subring at matrixRing(R, n), {M} with *
  have subset := IsSubring.subset_carrier with subring
  have closed := IsSubring.mul_closed with subring
  have magma : IsMagma(Ring.carrier(matrixRing(R, n)), Ring.mul(matrixRing(R, n)))
    simp [IsRing, IsAbelianGroup, IsGroup, IsMonoid, IsSemigroup]
  rw commutant.carrierOf at memberN
  rw commutant.carrierOf at memberP
  unfold commutant
  rw bicommutantRing.mulOf
  exact restrictBinary.value with *

theorem commutant.neg_value (M : R ^ n × n) (N : Set)
  requires member : N ∈ Ring.carrier(commutant(R, n, M))
  shows Ring.neg(commutant(R, n, M))(N) = Ring.neg(matrixRing(R, n))(N)
proof
  have ring := matrixRing.ring at R, n with *
  have parts := Ring.parts with ring
  have bounded := commutant.generators at R, n, M with *
  have subring := bicommutant.subring at matrixRing(R, n), {M} with *
  have subset := IsSubring.subset_carrier with subring
  have closed := IsSubring.neg_closed with subring
  obtain ⟨addF, zeroIn, negF, mulF, oneIn⟩ := IsRing.typing_of_parts with parts
  rw commutant.carrierOf at member
  unfold commutant
  rw bicommutantRing.negOf
  exact restrictUnary.value with *

theorem commutant.zero_value (M : R ^ n × n)
  shows Ring.zero(commutant(R, n, M)) = Ring.zero(matrixRing(R, n))
proof
  unfold commutant
  exact bicommutantRing.zeroOf at matrixRing(R, n), {M}

theorem commutant.one_value (M : R ^ n × n)
  shows Ring.one(commutant(R, n, M)) = Ring.one(matrixRing(R, n))
proof
  unfold commutant
  exact bicommutantRing.oneOf at matrixRing(R, n), {M}

-- The scalar embedding is a homomorphism into the commutant.
theorem scalarEmbedding.hom (M : R ^ n × n)
  shows scalarEmbedding(R, n) : R →+* commutant(R, n, M)
proof
  have natural : Nat(n) by typecheck
  have parts := CommRing.parts with comm
  have ring := CommRing.to_ring with comm
  have target := commutant.comm_ring at R, n, M with *
  have targetRing := CommRing.to_ring with target
  have targetParts := CommRing.parts with target
  have graph := scalarEmbedding.function at R, n with *
  have values : ∀ a ∈ R.carrier, scalarEmbedding(R, n)(a) ∈ Ring.carrier(commutant(R, n, M))
    intros a ha
    have value := scalarEmbedding.value at R, n, a with *
    rw value
    exact commutant.scalar_mem with *
  have function := FunctionBetween.codomain_of_values with graph, values
  have additive : ∀ a ∈ R.carrier, ∀ b ∈ R.carrier,
      scalarEmbedding(R, n)(call2(R.add, a, b)) =
        call2(Ring.add(commutant(R, n, M)), scalarEmbedding(R, n)(a), scalarEmbedding(R, n)(b))
    intros a ha b hb
    have sumIn : a + b ∈ R := Ring.add_mem with *
    have valueA := scalarEmbedding.value at R, n, a with *
    have valueB := scalarEmbedding.value at R, n, b with *
    have valueSum := scalarEmbedding.value at R, n, a + b with *
    have memberA := values with a, ha
    have memberB := values with b, hb
    have inner := commutant.add_value at R, n, M, scalarEmbedding(R, n)(a), scalarEmbedding(R, n)(b) with *
    have sum := scalarMatrix.add at R, n, a, b with *
    rw [inner, valueA, valueB, valueSum]
    exact sum
  have multiplicative : ∀ a ∈ R.carrier, ∀ b ∈ R.carrier,
      scalarEmbedding(R, n)(call2(R.mul, a, b)) =
        call2(Ring.mul(commutant(R, n, M)), scalarEmbedding(R, n)(a), scalarEmbedding(R, n)(b))
    intros a ha b hb
    have productIn : a * b ∈ R := Ring.mul_mem with *
    have valueA := scalarEmbedding.value at R, n, a with *
    have valueB := scalarEmbedding.value at R, n, b with *
    have valueProduct := scalarEmbedding.value at R, n, a * b with *
    have memberA := values with a, ha
    have memberB := values with b, hb
    have inner := commutant.mul_value at R, n, M, scalarEmbedding(R, n)(a), scalarEmbedding(R, n)(b) with *
    have product := scalarMatrix.mul at R, n, a, b with *
    rw [inner, valueA, valueB, valueProduct]
    exact product
  have unital : scalarEmbedding(R, n)(R.one) = Ring.one(commutant(R, n, M))
    have oneIn : R[1] ∈ R := Ring.one_mem with *
    have value := scalarEmbedding.value at R, n, R[1] with *
    have one := scalarMatrix.one at R, n with *
    rw [commutant.one_value, value]
    exact one
  have engine := IsRingHom.of_add_mul_one with parts, targetParts, function,
    additive, multiplicative, unital
  exact RingHom.of_projections with ring, targetRing, engine

theorem matrixEvaluation.hom (M : R ^ n × n)
  shows evalAt(M) : polynomialRing(R, {0}) →+* commutant(R, n, M)
proof
  have target := commutant.comm_ring at R, n, M with *
  have hom := scalarEmbedding.hom at R, n, M with *
  have self := commutant.self_mem at R, n, M with *
  have assignment := constantFunction.function at {0}, Ring.carrier(commutant(R, n, M)), M with *
  unfold matrixEvaluation
  exact evaluationHom.hom with *

theorem matrixEvaluation.map_X (M : R ^ n × n)
  shows evalAt(M)(X(R, {0}, 0)) = M
proof
  have target := commutant.comm_ring at R, n, M with *
  have hom := scalarEmbedding.hom at R, n, M with *
  have self := commutant.self_mem at R, n, M with *
  have assignment := constantFunction.function at {0}, Ring.carrier(commutant(R, n, M)), M with *
  have index : 0 ∈ {0} by simp [singleton.membership]
  have point := constantFunction.apply at {0}, Ring.carrier(commutant(R, n, M)), 0, M with *
  have mapped := evaluationHom.map_X at R, commutant(R, n, M), {0}, scalarEmbedding(R, n),
    constantFunction({0}, Ring.carrier(commutant(R, n, M)), M), 0 with *
  unfold matrixEvaluation
  cc

theorem matrixEvaluation.map_constant (M : R ^ n × n) (a : R)
  shows evalAt(M)(polynomialConstant(R, {0})(a)) = scalarMatrix(R, n, a)
proof
  have natural : Nat(n) by typecheck
  have target := commutant.comm_ring at R, n, M with *
  have hom := scalarEmbedding.hom at R, n, M with *
  have self := commutant.self_mem at R, n, M with *
  have assignment := constantFunction.function at {0}, Ring.carrier(commutant(R, n, M)), M with *
  have mapped := evaluationHom.map_constant at R, commutant(R, n, M), {0}, scalarEmbedding(R, n),
    constantFunction({0}, Ring.carrier(commutant(R, n, M)), M), a with *
  have value := scalarEmbedding.value at R, n, a with *
  unfold matrixEvaluation
  cc

end Commutants
