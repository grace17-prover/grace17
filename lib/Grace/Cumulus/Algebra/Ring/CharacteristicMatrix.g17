module Grace.Cumulus.Algebra.Ring.CharacteristicMatrix
import DeterminantKernel
import DeterminantHom

defunique characteristicEntry (I A add zero neg mul one M x p : Set) (a ∈ A) :=
  ∃ i ∈ I, ∃ j ∈ I, p = (i, j) ∧ a = call2(add, singleValue(A, zero, x, j, i), neg(M[i, j]))
requires ring : IsCommRing(A, add, zero, neg, mul, one)
requires matrix : RingMatrix(I, A, M)
requires scalar : x ∈ A
requires pair : p ∈ I × I
proof
  obtain ⟨bound, i, hi, j, hj, shape⟩ := product.membership.forward at p, I, I with *
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have diagonal := singleValue.closed at A, zero, x, j, i with *
  have entry := RingMatrix.entry at I, A, M, i, j with *
  have negative := IsRing.neg_closed with ordinary, entry
  have value := IsRing.add_closed with ordinary, diagonal, negative
  refine ⟨call2(add, singleValue(A, zero, x, j, i), neg(M[i, j])), value, i, hi, j, hj, shape, rfl⟩
uniqueness
  intros u hu first v hv second
  obtain ⟨i, hi, j, hj, shapeU, valueU⟩ := first
  obtain ⟨k, hk, l, hl, shapeV, valueV⟩ := second
  have equal : (i, j) = (k, l)
    cc
  have coordinates := orderedPair.injective at i, j, k, l with equal
  cc

defgraph characteristicMatrix (I A add zero neg mul one M x : Set) (p ∈ I × I) : A :=
  characteristicEntry(I, A, add, zero, neg, mul, one, M, x, p)
requires ring : IsCommRing(A, add, zero, neg, mul, one)
requires matrix : RingMatrix(I, A, M)
requires scalar : x ∈ A
proof
  have selected := characteristicEntry.selected at I, A, add, zero, neg, mul, one, M, x, p with *
  exact selected.left

notation scoped characteristicMatrix(I, R, M, x) => characteristicMatrix(I, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, M, x)

section Matrices
variable (I A add zero neg mul one M x : Set)
notation ring R := (A, add, zero, neg, mul, one)
hypothesis ring : IsCommRing(R)
hypothesis matrix : RingMatrix(I, R, M)
hypothesis scalar : x ∈ R

theorem characteristicMatrix.matrix
  shows RingMatrix(I, R, characteristicMatrix(I, R, M, x))
proof
  unfold RingMatrix
  exact characteristicMatrix.function with *

theorem characteristicMatrix.entry (i j : Set)
  requires row : i ∈ I
  requires column : j ∈ I
  shows characteristicMatrix(I, R, M, x)[i, j] = R[singleValue(A, zero, x, j, i) - M[i, j]]
proof
  have pair := product.pair at i, j, I, I with *
  have selected := characteristicEntry.selected at I, A, add, zero, neg, mul, one, M, x, (i, j) with *
  obtain ⟨k, hk, l, hl, shape, result⟩ := selected.right
  have coordinates := orderedPair.injective with shape
  have value := characteristicMatrix.value at I, A, add, zero, neg, mul, one, M, x, (i, j) with *
  cc

theorem characteristicMatrix.diagonal (i : Set)
  requires row : i ∈ I
  shows characteristicMatrix(I, R, M, x)[i, i] = R[x - M[i, i]]
proof
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have same : i = i by rfl
  have diagonal := singleValue.same at A, zero, x, i, i with *
  have entry := characteristicMatrix.entry at I, A, add, zero, neg, mul, one, M, x, i, i with *
  cc

theorem characteristicMatrix.off_diagonal (i j : Set)
  requires row : i ∈ I
  requires column : j ∈ I
  requires distinct : i ≠ j
  shows characteristicMatrix(I, R, M, x)[i, j] = R[-M[i, j]]
proof
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have diagonal := singleValue.other at A, zero, x, j, i with *
  have entry := characteristicMatrix.entry at I, A, add, zero, neg, mul, one, M, x, i, j with *
  have closed := RingMatrix.entry at I, A, M, i, j with *
  rw [entry, diagonal]
  ring

end Matrices

-- The eigenvector equation includes the zero vector; nonzero coordinates are
-- required separately only when a root, rather than annihilation, is needed.
predicate LeftEigenvector (I A add zero neg mul one M x v : Set) :=
  FunctionBetween(v, I, A) ∧ ∀ j ∈ I, rowVectorEntry(I, A, add, zero, neg, mul, one, v, M, j) = call2(mul, x, v(j))

notation scoped LeftEigenvector(I, R, M, x, v) => LeftEigenvector(I, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, M, x, v)

section Eigenvectors
variable (I A add zero neg mul one M x v : Set)
notation ring R := (A, add, zero, neg, mul, one)
hypothesis ring : IsCommRing(R)
hypothesis finite : Finite(I)
hypothesis matrix : RingMatrix(I, R, M)
hypothesis scalar : x ∈ R
hypothesis eigenvector : LeftEigenvector(I, R, M, x, v)

theorem characteristicMatrix.left_kernel
  shows LeftKernelVector(I, R, characteristicMatrix(I, R, M, x), v)
proof
  have vector := eigenvector.left
  have eigen := eigenvector.right
  have characteristic := characteristicMatrix.matrix at I, A, add, zero, neg, mul, one, M, x with *
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have multiplicative := IsRing.multiplicative with ordinary
  have unit := IsMonoid.unit_in_carrier with multiplicative
  have negativeUnit := IsRing.neg_closed with ordinary, unit
  constructor
  . exact vector
  . intros j hj
    have valueIn := FunctionBetween.apply_closed at v, I, A, j with *
    have diagonalIn := RingMatrix.entry at I, A, M, j, j with *
    have productIn := IsRing.mul_closed with ordinary, scalar, valueIn
    have original := rowVectorWeights.function at I, A, add, zero, neg, mul, one, v, M, j with *
    have changed := rowVectorWeights.function at I, A, add, zero, neg, mul, one, v, characteristicMatrix(I, R, M, x), j with *
    have single := coefficientSingle.function at I, A, zero, R[x * v(j)], j with *
    have entries : ∀ i ∈ I, rowVectorWeights(I, R, v, characteristicMatrix(I, R, M, x), j)(i) = R[1 * coefficientSingle(I, A, zero, x * v(j), j)(i) + (-1) * rowVectorWeights(I, R, v, M, j)(i)]
      intros i hi
      have coefficient := FunctionBetween.apply_closed at v, I, A, i with *
      have matrixEntry := RingMatrix.entry at I, A, M, i, j with *
      have left := rowVectorWeights.value at I, A, add, zero, neg, mul, one, v, characteristicMatrix(I, R, M, x), j, i with *
      have right := rowVectorWeights.value at I, A, add, zero, neg, mul, one, v, M, j, i with *
      have entry := characteristicMatrix.entry at I, A, add, zero, neg, mul, one, M, x, i, j with *
      have alternatives : i = j ∨ i ≠ j by tauto
      cases alternatives with same | different
      . have delta := singleValue.same at A, zero, x, j, i with *
        have selected := coefficientSingle.same at I, A, zero, R[x * v(j)], j with *
        rw [left, right, entry, delta, same, selected]
        ring
      . have delta := singleValue.other at A, zero, x, j, i with *
        have selected := coefficientSingle.other at I, A, zero, R[x * v(j)], j, i with *
        rw [left, right, entry, delta, selected]
        ring
    have linear := finiteRingSum.linear at I, A, add, zero, neg, mul, one, coefficientSingle(I, A, zero, R[x * v(j)], j), rowVectorWeights(I, R, v, M, j), rowVectorWeights(I, R, v, characteristicMatrix(I, R, M, x), j), one, R[-1] with *
    have singleSum := finiteRingSum.single at I, A, add, zero, neg, mul, one, R[x * v(j)], j with *
    have eigenEquation := eigen with j, hj
    unfold rowVectorEntry at eigenEquation
    unfold rowVectorEntry
    ring

end Eigenvectors

section Annihilation
variable (A add zero neg mul one : Set)
notation ring R := (A, add, zero, neg, mul, one)
hypothesis ring : IsCommRing(R)

theorem characteristicMatrix.annihilates (n : Nat) (M x v j : Set)
  requires matrix : RingMatrix(n, R, M)
  requires scalar : x ∈ R
  requires eigenvector : LeftEigenvector(n, R, M, x, v)
  requires index : j ∈ n
  shows determinant(n, R, characteristicMatrix(n, R, M, x)) * v(j) = R[0]
proof
  have characteristic := characteristicMatrix.matrix with *
  have kernel := characteristicMatrix.left_kernel with *
  exact determinant.annihilates_left_kernel with *

end Annihilation
section Homomorphisms
variable (A add zero neg mul one B plus z minus times unit h : Set)
notation ring R := (A, add, zero, neg, mul, one)
notation ring S := (B, plus, z, minus, times, unit)
hypothesis source : IsCommRing(R)
hypothesis target : IsCommRing(S)
hypothesis hom : IsRingHom(h, R, S)

theorem characteristicMatrix.map_entries (I M N x : Set)
  requires matrixM : RingMatrix(I, R, M)
  requires matrixN : RingMatrix(I, S, N)
  requires scalar : x ∈ R
  requires entries : ∀ i ∈ I, ∀ j ∈ I, N[i, j] = h(M[i, j])
  shows ∀ i ∈ I, ∀ j ∈ I,
    characteristicMatrix(I, S, N, h(x))[i, j] = h(characteristicMatrix(I, R, M, x)[i, j])
proof
  have ordinaryR := IsCommRing.ring with source
  have ordinaryS := IsCommRing.ring with target
  have zeroR := IsRing.zero_in_carrier with ordinaryR
  have zeroS := IsRing.zero_in_carrier with ordinaryS
  have image := IsRingHom.closed with hom, scalar
  have mapsZero := IsRingHom.zero with hom
  intros i hi j hj
  have matrixEntry := RingMatrix.entry at I, A, M, i, j with *
  have deltaMap : singleValue(B, z, h(x), j, i) = h(singleValue(A, zero, x, j, i))
    have alternatives : i = j ∨ i ≠ j by tauto
    cases alternatives with same | different
    . have left := singleValue.same at B, z, h(x), j, i with *
      have right := singleValue.same at A, zero, x, j, i with *
      cc
    . have left := singleValue.other at B, z, h(x), j, i with *
      have right := singleValue.other at A, zero, x, j, i with *
      cc
  have left := characteristicMatrix.entry at I, B, plus, z, minus, times, unit, N, h(x), i, j with *
  have right := characteristicMatrix.entry at I, A, add, zero, neg, mul, one, M, x, i, j with *
  have preserved := IsRingHom.sub at h, A, add, zero, neg, mul, one, B, plus, z, minus, times, unit, singleValue(A, zero, x, j, i), M[i, j] with *
  have mapped := entries with i, hi, j, hj
  cc

theorem determinant.characteristic_map (n : Nat) (M N x : Set)
  requires matrixM : RingMatrix(n, R, M)
  requires matrixN : RingMatrix(n, S, N)
  requires scalar : x ∈ R
  requires entries : ∀ i ∈ n, ∀ j ∈ n, N[i, j] = h(M[i, j])
  shows h(determinant(n, R, characteristicMatrix(n, R, M, x))) =
    determinant(n, S, characteristicMatrix(n, S, N, h(x)))
proof
  have image := IsRingHom.closed with hom, scalar
  have first := characteristicMatrix.matrix at n, A, add, zero, neg, mul, one, M, x with *
  have second := characteristicMatrix.matrix at n, B, plus, z, minus, times, unit, N, h(x) with *
  have mapped := characteristicMatrix.map_entries with *
  exact determinant.map with *

end Homomorphisms
