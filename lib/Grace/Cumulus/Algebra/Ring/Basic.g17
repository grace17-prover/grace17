-- Bundled rings: a ring as one structure extending its additive abelian
-- group and its multiplicative monoid, with the commutative rings, fields,
-- and ordered fields as predicates over it and the ring notation read off
-- the hypothesis in scope
-- Part of Cumulus, the Grace17 mathematics library.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module Grace.Cumulus.Algebra.Ring.Basic
import Numeral
import Field.Construction
import OrderedField.Defs

-- A ring extends its two parents: the additive abelian group, whose
-- operation, unit, and inverse are the ring's add, zero, and neg, and the
-- multiplicative monoid, whose operation and unit are its mul and one and
-- whose inverse slot, which Monoid does not constrain, is fixed to ∅. The
-- fields of the parents are the ring's own, so a ring is built by
-- Ring.mk(A, add, zero, neg, mul, one) and read back by R.carrier, R.add,
-- R.zero, R.neg, R.mul, and R.one; the parents are the values
-- R.additive = Group.mk(R.carrier, R.add, R.zero, R.neg) and
-- R.multiplicative = Group.mk(R.carrier, R.mul, R.one, ∅). Ring(R) says
-- that R is such a structure, that AbelianGroup(R.additive) and
-- Monoid(R.multiplicative) hold, and that multiplication distributes;
-- Ring.Data(R) is the shape alone, and Ring.intro builds a ring from its
-- six pieces, their typing, the two parents at the constructor, and
-- distributivity. The instances Ring.additive.abelian_group and
-- Ring.multiplicative.monoid make the parents' laws available wherever
-- Ring(R) is, so a theorem about abelian groups applies to R.additive.
structure Ring extends
    AbelianGroup as additive (mul := add, one := zero, inv := neg),
    Monoid as multiplicative (inv := ∅)
  where
    distributive : Distributive(carrier, add, mul)

-- The projection laws of a constructed ring as one rewrite set, and the
-- projections of the two parents as the ring's own fields, so that a fact
-- about R.additive or R.multiplicative reads in R.add, R.zero, R.mul, R.one.
tactic ring_projections := simp [Ring.mk.carrier, Ring.mk.add, Ring.mk.zero, Ring.mk.neg, Ring.mk.mul, Ring.mk.one]
tactic ring_additive := simp [Ring.additive.carrier, Ring.additive.mul, Ring.additive.one, Ring.additive.inv]
tactic ring_multiplicative := simp [Ring.multiplicative.carrier, Ring.multiplicative.mul, Ring.multiplicative.one]

-- The commutative rings, fields, and ordered fields as properties of the
-- same structure. Field(R) is the field as a property of the ring, with an
-- inverse for every nonzero element, so no inverse graph is part of the
-- data; OrderedField(R, lt) adds a strict linear order compatible with the
-- operations. IsRing(A, add, zero, neg, mul, one), IsCommRing(…),
-- IsField(…), IsFieldWithInverse(…, inv), and IsOrderedField(…, inv, lt)
-- remain the forms over separate pieces, bridged below.
predicate CommRing (R : Set) := Ring(R) ∧ Commutative(R.carrier, R.mul)
predicate Field (R : Set) :=
  Ring.Data(R) ∧ IsField(R.carrier, R.add, R.zero, R.neg, R.mul, R.one)
predicate OrderedField (R lt : Set) :=
  Field(R) ∧ StrictLinearOrder(R.carrier, lt) ∧
  AddStrictMono(R.carrier, R.add, lt) ∧ MulPositive(R.carrier, R.mul, R.zero, lt)

-- The operations are written x + y, x * y, and -x wherever a hypothesis in
-- scope supplies the ring; the operands' membership in R.carrier selects
-- the ring when several are in scope, and operands of a typed carrier such
-- as ℕ or ℝ keep their own operations. Under the same hypotheses a binder
-- (x : R) is a set variable with x ∈ R.carrier, and R[0], R[1], R[2] are
-- the zero, the one, and the numerals of R. The multiplication keeps the
-- monoid's name, so x * y under Ring(R) is inherited from the parent's
-- notation; the additive group's operation is renamed, so + and - are
-- declared here.
notation infixl 60 "+" => call2(R.add, _, _) via hypothesis Ring(R) for R.carrier
notation infixl 60 "+" => call2(R.add, _, _) via hypothesis CommRing(R) for R.carrier
notation infixl 60 "+" => call2(R.add, _, _) via hypothesis Field(R) for R.carrier
notation infixl 60 "+" => call2(R.add, _, _) via hypothesis OrderedField(R, lt) for R.carrier
notation infixl 70 "*" => call2(R.mul, _, _) via hypothesis CommRing(R) for R.carrier
notation infixl 70 "*" => call2(R.mul, _, _) via hypothesis Field(R) for R.carrier
notation infixl 70 "*" => call2(R.mul, _, _) via hypothesis OrderedField(R, lt) for R.carrier
notation prefix 75 "-" => apply(R.neg, _) via hypothesis Ring(R) for R.carrier
notation prefix 75 "-" => apply(R.neg, _) via hypothesis CommRing(R) for R.carrier
notation prefix 75 "-" => apply(R.neg, _) via hypothesis Field(R) for R.carrier
notation prefix 75 "-" => apply(R.neg, _) via hypothesis OrderedField(R, lt) for R.carrier

-- Subtraction is addition of the negation: x - y is Ring.sub(R, x, y) under
-- the same hypotheses, and Ring.sub.value unfolds it to x + (-y), the form
-- the ring tactics read.
def Ring.sub (R x y : Set) : Set := call2(Ring.add(R), x, apply(Ring.neg(R), y))

notation infixl 60 "-" => Ring.sub(R, _, _) via hypothesis Ring(R) for R.carrier
notation infixl 60 "-" => Ring.sub(R, _, _) via hypothesis CommRing(R) for R.carrier
notation infixl 60 "-" => Ring.sub(R, _, _) via hypothesis Field(R) for R.carrier
notation infixl 60 "-" => Ring.sub(R, _, _) via hypothesis OrderedField(R, lt) for R.carrier

-- Bridges between the structure and the forms over separate pieces. The
-- bundled-to-unbundled directions are instances, so `with *`, `typecheck`,
-- and `ring` read the unbundled form off a bundled hypothesis.
instance Ring.parts (R : Set)
  requires ring : Ring(R)
  shows IsRing(R.carrier, R.add, R.zero, R.neg, R.mul, R.one)
proof
  obtain ⟨shape, addF, zeroIn, negF, mulF, oneIn, additive, multiplicative, distributive⟩ := ring
  have abelian := AbelianGroup.parts with additive
  ring_additive at abelian
  have monoid := Monoid.parts with multiplicative
  ring_multiplicative at monoid
  unfold IsRing
  exact ⟨abelian, monoid, distributive⟩

-- The typing of the six pieces, read off the parameterized ring.
theorem IsRing.typing_of_parts (A add zero neg mul one : Set)
  requires ring : IsRing(A, add, zero, neg, mul, one)
  shows (add : A × A → A) ∧ zero ∈ A ∧ (neg : A → A) ∧
    (mul : A × A → A) ∧ one ∈ A
proof
  have additive := IsRing.additive with ring
  have group := IsAbelianGroup.group with additive
  have monoid := IsRing.multiplicative with ring
  have addF := IsGroup.magma with group
  have zeroIn := IsRing.zero_in_carrier with ring
  obtain ⟨negF, inverses⟩ := IsGroup.inverse with group
  have mulF := IsSemigroup.magma with (IsMonoid.semigroup with monoid)
  have oneIn := IsMonoid.unit_in_carrier with monoid
  exact ⟨addF, zeroIn, negF, mulF, oneIn⟩

theorem Ring.of_parts (A add zero neg mul one : Set)
  requires ring : IsRing(A, add, zero, neg, mul, one)
  shows Ring(Ring.mk(A, add, zero, neg, mul, one))
proof
  obtain ⟨addF, zeroIn, negF, mulF, oneIn⟩ := IsRing.typing_of_parts with ring
  have additive := AbelianGroup.of_parts with (IsRing.additive with ring)
  have multiplicative := Monoid.of_parts at A, mul, one, ∅
    with (IsRing.multiplicative with ring)
  have distributive := IsRing.distributive with ring
  exact Ring.intro with addF, zeroIn, negF, mulF, oneIn, additive,
    multiplicative, distributive

instance CommRing.parts (R : Set)
  requires comm : CommRing(R)
  shows IsCommRing(R.carrier, R.add, R.zero, R.neg, R.mul, R.one)
proof
  obtain ⟨ring, commutative⟩ := comm
  have parts := Ring.parts with ring
  unfold IsCommRing
  exact ⟨parts, commutative⟩

theorem CommRing.of_parts (A add zero neg mul one : Set)
  requires ring : IsCommRing(A, add, zero, neg, mul, one)
  shows CommRing(Ring.mk(A, add, zero, neg, mul, one))
proof
  have bundled := Ring.of_parts with (IsCommRing.ring with ring)
  have commutative := IsCommRing.commutative with ring
  unfold CommRing
  ring_projections

theorem Ring.of_projections (R : Set)
  requires shape : Ring.Data(R)
  requires ring : IsRing(R.carrier, R.add, R.zero, R.neg, R.mul, R.one)
  shows Ring(R)
proof
  have eta := Ring.eta with shape
  rw eta
  exact Ring.of_parts with ring

theorem CommRing.of_projections (R : Set)
  requires shape : Ring.Data(R)
  requires comm : IsCommRing(R.carrier, R.add, R.zero, R.neg, R.mul, R.one)
  shows CommRing(R)
proof
  have ring := Ring.of_projections with shape, (IsCommRing.ring with comm)
  have commutative := IsCommRing.commutative with comm
  unfold CommRing
  exact ⟨ring, commutative⟩

instance CommRing.to_ring (R : Set)
  requires comm : CommRing(R)
  shows Ring(R)
proof
  obtain ⟨ring, commutative⟩ := comm
  exact ring

instance Field.parts (R : Set)
  requires field : Field(R)
  shows IsField(R.carrier, R.add, R.zero, R.neg, R.mul, R.one)
proof
  obtain ⟨shape, isField⟩ := field
  exact isField

theorem Field.of_parts (A add zero neg mul one : Set)
  requires field : IsField(A, add, zero, neg, mul, one)
  shows Field(Ring.mk(A, add, zero, neg, mul, one))
proof
  have shape := Ring.mk.data at A, add, zero, neg, mul, one
  unfold Field
  ring_projections

theorem Field.of_inverse (A add zero neg mul one inv : Set)
  requires field : IsFieldWithInverse(A, add, zero, neg, mul, one, inv)
  shows Field(Ring.mk(A, add, zero, neg, mul, one))
proof
  exact Field.of_parts with (IsFieldWithInverse.is_field with field)

instance Field.to_comm_ring (R : Set)
  requires field : Field(R)
  shows CommRing(R)
proof
  obtain ⟨shape, isField⟩ := field
  have comm := IsField.comm_ring with isField
  exact CommRing.of_projections with shape, comm

theorem OrderedField.parts (R lt : Set)
  requires ordered : OrderedField(R, lt)
  shows IsOrderedField(R.carrier, R.add, R.zero, R.neg, R.mul, R.one,
    fieldInverse(R.carrier, R.add, R.zero, R.neg, R.mul, R.one), lt)
proof
  obtain ⟨field, order, additive, positive⟩ := ordered
  have unbundled := IsField.field with (Field.parts with field)
  unfold IsOrderedField
  exact ⟨unbundled, order, additive, positive⟩

theorem OrderedField.of_parts (A add zero neg mul one inv lt : Set)
  requires ordered : IsOrderedField(A, add, zero, neg, mul, one, inv, lt)
  shows OrderedField(Ring.mk(A, add, zero, neg, mul, one), lt)
proof
  obtain ⟨field, order, additive, positive⟩ := ordered
  have bundled := Field.of_inverse with field
  unfold OrderedField
  ring_projections

instance OrderedField.to_field (R lt : Set)
  requires ordered : OrderedField(R, lt)
  shows Field(R)
proof
  obtain ⟨field, rest⟩ := ordered
  exact field

-- A ring is the constructor applied to its projections.
theorem Ring.eta_of_ring (R : Set)
  requires ring : Ring(R)
  shows R = Ring.mk(R.carrier, R.add, R.zero, R.neg, R.mul, R.one)
proof
  obtain ⟨shape, rest⟩ := ring
  exact Ring.eta with shape

section RingLaws
variable (R : Set)
hypothesis ring : Ring(R)

-- Closure: the operations and constants stay in the carrier. These are
-- instances, so the membership of a compound term is synthesized.
instance Ring.add_mem (x y : R)
  shows x + y ∈ R
proof
  have parts := Ring.parts with ring
  exact IsRing.add_closed with parts, *

instance Ring.mul_mem (x y : R)
  shows x * y ∈ R
proof
  have parts := Ring.parts with ring
  exact IsRing.mul_closed with parts, *

instance Ring.neg_mem (x : R)
  shows -x ∈ R
proof
  have parts := Ring.parts with ring
  exact IsRing.neg_closed with parts, *

theorem Ring.sub.value (x y : R)
  shows x - y = x + (-y)
proof
  simp [Ring.sub]

instance Ring.sub_mem (x y : R)
  shows x - y ∈ R
proof
  have negIn : -y ∈ R := Ring.neg_mem with *
  rw Ring.sub.value
  exact Ring.add_mem with *

instance Ring.zero_mem
  shows R.zero ∈ R
proof
  have parts := Ring.parts with ring
  exact IsRing.zero_in_carrier with parts

instance Ring.one_mem
  shows R.one ∈ R
proof
  have monoid := IsRing.multiplicative with (Ring.parts with ring)
  exact IsMonoid.unit_in_carrier with monoid

instance Ring.numeral_mem (n : Nat)
  shows ringNat(R.add, R.zero, R.one, n) ∈ R
proof
  have parts := Ring.parts with ring
  exact IsRing.numeral_closed with parts

end RingLaws
