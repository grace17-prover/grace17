module Grace.Cumulus.Algebra.Ring.FiniteCombination
import FiniteSum

def idealProducts (A mul G : Set) : Set :=
  {t ∈ A | ∃ a ∈ A, ∃ p ∈ G, t = call2(mul, a, p)}

notation scoped idealProducts(R, G) => idealProducts(R.carrier, R.mul, G)

def finiteIdealSums (A add zero mul G : Set) : Set :=
  {x ∈ A | ∃ xs, List(idealProducts(A, mul, G), xs) ∧ x = ringSum{idealProducts(A, mul, G)}(add, zero, xs)}

theorem idealProducts.subset (A mul G : Set)
  shows idealProducts(A, mul, G) ⊆ A
proof
  simp

section Rings
variable (A add zero neg mul one G : Set)
hypothesis ring : IsCommRing(A, add, zero, neg, mul, one)
hypothesis bounded : G ⊆ A
notation ring R := (A, add, zero, neg, mul, one)

theorem idealProducts.scale (a t : Set)
  requires ha : a ∈ A
  requires ht : t ∈ idealProducts(A, mul, G)
  shows a * t ∈ idealProducts(A, mul, G)
proof
  obtain ⟨tIn, b, hb, p, hp, shape⟩ := idealProducts.membership.forward with ht
  have ordinary := IsCommRing.ring with ring
  have pIn := bounded with p, hp
  have coefficient := IsRing.mul_closed with ordinary, ha, hb
  have product := IsRing.mul_closed with ordinary, ha, tIn
  have equation : a * t = (a * b) * p
    rw shape
    ring
  exact idealProducts.membership.backward with ⟨product, a * b, coefficient, p, hp, equation⟩

theorem idealProducts.contains
  shows G ⊆ idealProducts(A, mul, G)
proof
  have ordinary := IsCommRing.ring with ring
  have monoid := IsRing.multiplicative with ordinary
  have oneIn := IsMonoid.unit_in_carrier with monoid
  intros p hp
  have pIn := bounded with p, hp
  have identity : p = 1 * p by ring
  exact idealProducts.membership.backward with ⟨pIn, one, oneIn, p, hp, identity⟩

theorem finiteIdealSums.zero
  shows 0 ∈ finiteIdealSums(A, add, zero, mul, G)
proof
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have nil : List(idealProducts(A, mul, G), []) by typecheck
  have value : zero = ringSum{idealProducts(A, mul, G)}(add, zero, [])
    rw ringSum
    rfl
  exact finiteIdealSums.membership.backward with ⟨zeroIn, [], nil, value⟩

theorem finiteIdealSums.contains
  shows G ⊆ finiteIdealSums(A, add, zero, mul, G)
proof
  have products := idealProducts.contains with ring, bounded
  intros p hp
  have pIn := bounded with p, hp
  have product := products with p, hp
  have singleton : List(idealProducts(A, mul, G), [p]) by typecheck
  have value : p = ringSum{idealProducts(A, mul, G)}(add, zero, [p])
    rw [ringSum, ringSum]
    ring
  exact finiteIdealSums.membership.backward with ⟨pIn, [p], singleton, value⟩

theorem finiteIdealSums.add (x y : Set)
  requires hx : x ∈ finiteIdealSums(A, add, zero, mul, G)
  requires hy : y ∈ finiteIdealSums(A, add, zero, mul, G)
  shows x + y ∈ finiteIdealSums(A, add, zero, mul, G)
proof
  obtain ⟨xIn, xs, listX, valueX⟩ := finiteIdealSums.membership.forward with hx
  obtain ⟨yIn, ys, listY, valueY⟩ := finiteIdealSums.membership.forward with hy
  have ordinary := IsCommRing.ring with ring
  have sumIn := IsRing.add_closed with ordinary, xIn, yIn
  have products := idealProducts.subset at A, mul, G
  have combined : List(idealProducts(A, mul, G), ListOps.append{idealProducts(A, mul, G)}(ys, xs)) by typecheck
  have value := ringSum.append at A, add, zero, neg, mul, one, idealProducts(A, mul, G), ys, xs with *
  have equation : x + y = ringSum{idealProducts(A, mul, G)}(add, zero, ListOps.append{idealProducts(A, mul, G)}(ys, xs))
    cc
  exact finiteIdealSums.membership.backward with ⟨sumIn, ListOps.append{idealProducts(A, mul, G)}(ys, xs), combined, equation⟩

theorem finiteIdealSums.scale (a x : Set)
  requires ha : a ∈ A
  requires hx : x ∈ finiteIdealSums(A, add, zero, mul, G)
  shows a * x ∈ finiteIdealSums(A, add, zero, mul, G)
proof
  obtain ⟨xIn, xs, listX, valueX⟩ := finiteIdealSums.membership.forward with hx
  have ordinary := IsCommRing.ring with ring
  have productIn := IsRing.mul_closed with ordinary, ha, xIn
  have products := idealProducts.subset at A, mul, G
  have closed : ∀ t ∈ idealProducts(A, mul, G), a * t ∈ idealProducts(A, mul, G)
    intros t ht
    exact idealProducts.scale with ring, bounded, ha, ht
  have scaled := ringScale.closed with *
  have value := ringSum.scale at A, add, zero, neg, mul, one, idealProducts(A, mul, G), a, xs with *
  have equation : a * x = ringSum{idealProducts(A, mul, G)}(add, zero, ringScale{idealProducts(A, mul, G)}(mul, a, xs))
    cc
  exact finiteIdealSums.membership.backward with ⟨productIn, ringScale{idealProducts(A, mul, G)}(mul, a, xs), scaled, equation⟩

theorem finiteIdealSums.ideal
  shows IsIdeal(A, add, zero, neg, mul, finiteIdealSums(A, add, zero, mul, G))
proof
  have ordinary := IsCommRing.ring with ring
  have monoid := IsRing.multiplicative with ordinary
  have oneIn := IsMonoid.unit_in_carrier with monoid
  have negOneIn := IsRing.neg_closed with ordinary, oneIn
  unfold IsIdeal
  refine ⟨?_, ⟨?_, ⟨?_, ⟨?_, ?_⟩⟩⟩⟩
  . settle with Subset, finiteIdealSums.membership
  . exact finiteIdealSums.zero with ring, bounded
  . intros x hx y hy
    exact finiteIdealSums.add with ring, bounded, hx, hy
  . intros x hx
    have data := finiteIdealSums.membership.forward with hx
    have xIn := data.left
    have scaled := finiteIdealSums.scale with ring, bounded, negOneIn, hx
    have equation : -1 * x = -x by ring
    rwa equation at scaled
  . intros a ha x hx
    have data := finiteIdealSums.membership.forward with hx
    have xIn := data.left
    have scaled := finiteIdealSums.scale with ring, bounded, ha, hx
    have commute : x * a = a * x by ring
    constructor
    . exact scaled
    . rw commute
      exact scaled

theorem idealProducts.subset_span
  shows idealProducts(A, mul, G) ⊆ idealSpan(A, add, zero, neg, mul, G)
proof
  have ideal := idealSpan.ideal at A, add, zero, neg, mul, one, G with ring
  have includes := idealSpan.contains at A, add, zero, neg, mul, G with bounded
  intros t ht
  obtain ⟨tIn, a, ha, p, hp, shape⟩ := idealProducts.membership.forward with ht
  have member := includes with p, hp
  have product := IsIdeal.mul_left_closed with ideal, ha, member
  rwa shape

theorem idealSpan.eq_finite_sums
  shows idealSpan(A, add, zero, neg, mul, G) = finiteIdealSums(A, add, zero, mul, G)
proof
  have sumsIdeal := finiteIdealSums.ideal with ring, bounded
  have includes := finiteIdealSums.contains with ring, bounded
  have left := idealSpan.least with sumsIdeal, includes
  apply Subset.antisymmetric with left
  intros x hx
  obtain ⟨xIn, xs, listX, valueX⟩ := finiteIdealSums.membership.forward with hx
  have spanIdeal := idealSpan.ideal at A, add, zero, neg, mul, one, G with ring
  have products := idealProducts.subset_span with ring, bounded
  have sum := IsIdeal.sum_mem with *
  rwa valueX

-- The number of summands is arbitrary: a witness is any finite list of products.
theorem idealSpan.finite_certificate (x : Set)
  shows x ∈ idealSpan(A, add, zero, neg, mul, G) ↔
    ∃ xs, List(idealProducts(A, mul, G), xs) ∧ x = ringSum{idealProducts(A, mul, G)}(add, zero, xs)
proof
  have representation := idealSpan.eq_finite_sums with ring, bounded
  constructor
  . intro member
    rw representation at member
    have data := finiteIdealSums.membership.forward with member
    exact data.right
  . intro certificate
    obtain ⟨xs, listX, valueX⟩ := certificate
    have products := idealProducts.subset at A, mul, G
    have sumIn := ringSum.closed with *
    have xIn : x ∈ A by cc
    rw representation
    exact finiteIdealSums.membership.backward with ⟨xIn, xs, listX, valueX⟩

theorem idealSpan.unit_iff_finite_certificate
  shows 1 ∈ idealSpan(A, add, zero, neg, mul, G) ↔
    ∃ xs, List(idealProducts(A, mul, G), xs) ∧ 1 = ringSum{idealProducts(A, mul, G)}(add, zero, xs)
proof
  exact idealSpan.finite_certificate with ring, bounded

section Evaluations
variable (f B plus z minus times unit : Set)
hypothesis target : IsCommRing(B, plus, z, minus, times, unit)
hypothesis hom : IsRingHom(f, A, add, zero, neg, mul, one, B, plus, z, minus, times, unit)
hypothesis nontrivial : Nontrivial(B, z, unit)
notation ring S := (B, plus, z, minus, times, unit)

theorem idealSpan.finite_certificate_obstructs_vanishing (xs : List(idealProducts(A, mul, G)))
  requires identity : R[1] = ringSum{idealProducts(A, mul, G)}(add, zero, xs)
  shows ¬(∀ p ∈ G, f(p) = S[0])
proof
  have listX : List(idealProducts(A, mul, G), xs) by assumption
  have certificate : ∃ terms, List(idealProducts(A, mul, G), terms) ∧ one = ringSum{idealProducts(A, mul, G)}(add, zero, terms)
    refine ⟨xs, listX, identity⟩
  have unitIn := idealSpan.unit_iff_finite_certificate.backward with ring, bounded, certificate
  exact idealSpan.unit_obstructs_vanishing with ring, target, hom, nontrivial, bounded, unitIn

end Evaluations

end Rings
