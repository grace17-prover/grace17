module Grace.Cumulus.Algebra.Ring.PrimeCorrespondence
import Correspondence
import PrimeIdeal

section RingMaps
variable (f A add zero neg mul one B plus z minus times unit : Set)
hypothesis source : IsCommRing(A, add, zero, neg, mul, one)
hypothesis target : IsCommRing(B, plus, z, minus, times, unit)
hypothesis hom : IsRingHom(f, A, add, zero, neg, mul, one, B, plus, z, minus, times, unit)
notation ring R := (A, add, zero, neg, mul, one)
notation ring S := (B, plus, z, minus, times, unit)

theorem IsRingHom.comap_proper (J : Set)
  requires proper : IsProperIdeal(B, plus, z, minus, times, unit, J)
  shows IsProperIdeal(A, add, zero, neg, mul, one, idealComap(f, A, J))
proof
  have preimage := IsRingHom.comap_ideal with source, target, hom, proper.left
  have identity := IsRingHom.one with hom
  unfold IsProperIdeal
  refine ⟨preimage, ?_⟩
  intro member
  have data := idealComap.membership.forward with member
  have forbidden : unit ∈ J by cc
  exact proper.right with forbidden

theorem IsRingHom.comap_prime (J : Set)
  requires prime : IsPrimeIdeal(B, plus, z, minus, times, unit, J)
  shows IsPrimeIdeal(A, add, zero, neg, mul, one, idealComap(f, A, J))
proof
  have proper := IsRingHom.comap_proper with source, target, hom, prime.left
  unfold IsPrimeIdeal
  refine ⟨proper, ?_⟩
  intros x hx y hy product
  have fx := IsRingHom.closed with hom, hx
  have fy := IsRingHom.closed with hom, hy
  have value := IsRingHom.mul with hom, hx, hy
  have data := idealComap.membership.forward with product
  have mapped : S[f(x) * f(y)] ∈ J by cc
  have alternatives := prime.right with f(x), f(y), mapped
  cases alternatives with leftMember | rightMember
  . left
    exact idealComap.membership.backward with ⟨hx, leftMember⟩
  . right
    exact idealComap.membership.backward with ⟨hy, rightMember⟩

section Surjections
hypothesis onto : SurjectiveBetween(f, A, B)

theorem IsRingHom.map_proper (I : Set)
  requires proper : IsProperIdeal(A, add, zero, neg, mul, one, I)
  requires contains : ringKernel(f, A, z) ⊆ I
  shows IsProperIdeal(B, plus, z, minus, times, unit, idealMap(f, B, I))
proof
  have image := IsRingHom.map_ideal with source, target, hom, onto, proper.left
  have roundtrip := IsRingHom.comap_map_eq with source, target, hom, proper.left, contains
  have ring := IsCommRing.ring with source
  have monoid := IsRing.multiplicative with ring
  have oneIn := IsMonoid.unit_in_carrier with monoid
  have identity := IsRingHom.one with hom
  unfold IsProperIdeal
  refine ⟨image, ?_⟩
  intro member
  have mapped : f(one) ∈ idealMap(f, B, I) by cc
  have preimage : one ∈ idealComap(f, A, idealMap(f, B, I)) := idealComap.membership.backward with ⟨oneIn, mapped⟩
  rw roundtrip at preimage
  exact proper.right with preimage

theorem IsRingHom.prime_of_comap (J : Set)
  requires ideal : IsIdeal(B, plus, z, minus, times, J)
  requires prime : IsPrimeIdeal(A, add, zero, neg, mul, one,
    idealComap(f, A, J))
  shows IsPrimeIdeal(B, plus, z, minus, times, unit, J)
proof
  have contains := IsRingHom.kernel_subset_comap with source, target, hom, ideal
  have imageProper := IsRingHom.map_proper with source, target, hom, onto, prime.left, contains
  have bounded := IsIdeal.subset_carrier with ideal
  have roundtrip := idealMap.comap_eq with onto, bounded
  rw roundtrip at imageProper
  have function := IsRingHom.function with hom
  have ring := IsCommRing.ring with source
  have ontoLaw := onto
  unfold IsPrimeIdeal
  refine ⟨imageProper, ?_⟩
  intros a ha b hb product
  obtain ⟨x, hx, edgeX⟩ := ontoLaw.right with a, ha
  obtain ⟨y, hy, edgeY⟩ := ontoLaw.right with b, hb
  have valueX := FunctionBetween.apply_value at f, A, B, x, a with *
  have valueY := FunctionBetween.apply_value at f, A, B, y, b with *
  have closed := IsRing.mul_closed with ring, hx, hy
  have value := IsRingHom.mul with hom, hx, hy
  have mapped : f(R[x * y]) ∈ J by cc
  have preimage : R[x * y] ∈ idealComap(f, A, J) := idealComap.membership.backward with ⟨closed, mapped⟩
  have alternatives := prime.right with x, hx, y, hy, preimage
  cases alternatives with leftMember | rightMember
  . left
    have data := idealComap.membership.forward with leftMember
    cc
  . right
    have data := idealComap.membership.forward with rightMember
    cc

theorem IsRingHom.comap_prime_iff (J : Set)
  requires ideal : IsIdeal(B, plus, z, minus, times, J)
  shows IsPrimeIdeal(A, add, zero, neg, mul, one, idealComap(f, A, J)) ↔ IsPrimeIdeal(B, plus, z, minus, times, unit, J)
proof
  constructor
  . intro prime
    exact IsRingHom.prime_of_comap with source, target, hom, onto, ideal, prime
  . intro prime
    exact IsRingHom.comap_prime with source, target, hom, prime

theorem IsRingHom.map_prime (I : Set)
  requires prime : IsPrimeIdeal(A, add, zero, neg, mul, one, I)
  requires contains : ringKernel(f, A, z) ⊆ I
  shows IsPrimeIdeal(B, plus, z, minus, times, unit, idealMap(f, B, I))
proof
  have ideal := IsPrimeIdeal.ideal with prime
  have image := IsRingHom.map_ideal with source, target, hom, onto, ideal
  have roundtrip := IsRingHom.comap_map_eq with source, target, hom, ideal, contains
  have preimage : IsPrimeIdeal(A, add, zero, neg, mul, one, idealComap(f, A, idealMap(f, B, I))) by rwa roundtrip
  exact IsRingHom.prime_of_comap with source, target, hom, onto, image, preimage

theorem IsRingHom.comap_maximal (J : Set)
  requires maximal : IsMaximalIdeal(B, plus, z, minus, times, unit, J)
  shows IsMaximalIdeal(A, add, zero, neg, mul, one, idealComap(f, A, J))
proof
  have proper := IsRingHom.comap_proper with source, target, hom, maximal.left
  have data := maximal.left
  have kernelIn := IsRingHom.kernel_subset_comap with source, target, hom, data.left
  have bounded := IsIdeal.subset_carrier with data.left
  have targetRoundtrip := idealMap.comap_eq with onto, bounded
  unfold IsMaximalIdeal
  refine ⟨proper, ?_⟩
  intros K properK inclusion
  have contains := Subset.transitive with kernelIn, inclusion
  have imageProper := IsRingHom.map_proper with source, target, hom, onto, properK, contains
  have imageInclusion := idealMap.monotone at f, B, idealComap(f, A, J), K with inclusion
  rw targetRoundtrip at imageInclusion
  have imageEqual := maximal.right with idealMap(f, B, K), imageProper, imageInclusion
  have sourceRoundtrip := IsRingHom.comap_map_eq with source, target, hom, properK.left, contains
  cc

theorem IsRingHom.maximal_of_comap (J : Set)
  requires ideal : IsIdeal(B, plus, z, minus, times, J)
  requires maximal : IsMaximalIdeal(A, add, zero, neg, mul, one, idealComap(f, A, J))
  shows IsMaximalIdeal(B, plus, z, minus, times, unit, J)
proof
  have contains := IsRingHom.kernel_subset_comap with source, target, hom, ideal
  have proper := IsRingHom.map_proper with source, target, hom, onto, maximal.left, contains
  have bounded := IsIdeal.subset_carrier with ideal
  have roundtrip := idealMap.comap_eq with onto, bounded
  rw roundtrip at proper
  unfold IsMaximalIdeal
  refine ⟨proper, ?_⟩
  intros K properK inclusion
  have preimageProper := IsRingHom.comap_proper with source, target, hom,
    properK
  have preimageInclusion := idealComap.monotone at f, A, J, K with inclusion
  have preimageEqual := maximal.right with idealComap(f, A, K), preimageProper, preimageInclusion
  have boundedK := IsIdeal.subset_carrier with properK.left
  have roundtripK := idealMap.comap_eq with onto, boundedK
  cc

theorem IsRingHom.comap_maximal_iff (J : Set)
  requires ideal : IsIdeal(B, plus, z, minus, times, J)
  shows IsMaximalIdeal(A, add, zero, neg, mul, one, idealComap(f, A, J)) ↔ IsMaximalIdeal(B, plus, z, minus, times, unit, J)
proof
  constructor
  . intro maximal
    exact IsRingHom.maximal_of_comap with source, target, hom, onto, ideal, maximal
  . intro maximal
    exact IsRingHom.comap_maximal with source, target, hom, onto, maximal

theorem IsRingHom.map_maximal (I : Set)
  requires maximal : IsMaximalIdeal(A, add, zero, neg, mul, one, I)
  requires contains : ringKernel(f, A, z) ⊆ I
  shows IsMaximalIdeal(B, plus, z, minus, times, unit, idealMap(f, B, I))
proof
  have ideal := IsMaximalIdeal.ideal with maximal
  have image := IsRingHom.map_ideal with source, target, hom, onto, ideal
  have roundtrip := IsRingHom.comap_map_eq with source, target, hom, ideal, contains
  have preimage : IsMaximalIdeal(A, add, zero, neg, mul, one, idealComap(f, A, idealMap(f, B, I))) by rwa roundtrip
  exact IsRingHom.maximal_of_comap with source, target, hom, onto, image,
    preimage

end Surjections
end RingMaps

-- The same results for bundled rings.
section BundledRingMaps
variable (f R S : Set)
hypothesis source : CommRing(R)
hypothesis target : CommRing(S)
hypothesis hom : f : R →+* S

theorem idealComap.proper (J : Set)
  requires proper : ProperIdeal(S, J)
  shows ProperIdeal(R, idealComap(f, R, J))
proof
  have sourceParts := CommRing.parts with source
  have targetParts := CommRing.parts with target
  have parts := RingHom.parts with hom
  have properParts := ProperIdeal.parts with proper
  have engine := IsRingHom.comap_proper with sourceParts, targetParts, parts,
    properParts
  exact ProperIdeal.of_projections with engine

theorem idealComap.prime (J : Set)
  requires prime : PrimeIdeal(S, J)
  shows PrimeIdeal(R, idealComap(f, R, J))
proof
  have sourceParts := CommRing.parts with source
  have targetParts := CommRing.parts with target
  have parts := RingHom.parts with hom
  have primeParts := PrimeIdeal.parts with prime
  have engine := IsRingHom.comap_prime with sourceParts, targetParts, parts,
    primeParts
  exact PrimeIdeal.of_projections with engine

section BundledSurjections
hypothesis onto : SurjectiveBetween(f, R.carrier, S.carrier)

theorem idealMap.proper (I : Set)
  requires proper : ProperIdeal(R, I)
  requires contains : ker(f) ⊆ I
  shows ProperIdeal(S, idealMap(f, S, I))
proof
  have sourceParts := CommRing.parts with source
  have targetParts := CommRing.parts with target
  have parts := RingHom.parts with hom
  have properParts := ProperIdeal.parts with proper
  have engine := IsRingHom.map_proper with sourceParts, targetParts, parts, onto,
    properParts, contains
  exact ProperIdeal.of_projections with engine

theorem idealMap.prime (I : Set)
  requires prime : PrimeIdeal(R, I)
  requires contains : ker(f) ⊆ I
  shows PrimeIdeal(S, idealMap(f, S, I))
proof
  have sourceParts := CommRing.parts with source
  have targetParts := CommRing.parts with target
  have parts := RingHom.parts with hom
  have primeParts := PrimeIdeal.parts with prime
  have engine := IsRingHom.map_prime with sourceParts, targetParts, parts, onto,
    primeParts, contains
  exact PrimeIdeal.of_projections with engine

theorem idealMap.maximal (I : Set)
  requires maximal : MaximalIdeal(R, I)
  requires contains : ker(f) ⊆ I
  shows MaximalIdeal(S, idealMap(f, S, I))
proof
  have sourceParts := CommRing.parts with source
  have targetParts := CommRing.parts with target
  have parts := RingHom.parts with hom
  have maximalParts := MaximalIdeal.parts with maximal
  have engine := IsRingHom.map_maximal with sourceParts, targetParts, parts, onto,
    maximalParts, contains
  exact MaximalIdeal.of_projections with engine

theorem idealComap.maximal (J : Set)
  requires maximal : MaximalIdeal(S, J)
  shows MaximalIdeal(R, idealComap(f, R, J))
proof
  have sourceParts := CommRing.parts with source
  have targetParts := CommRing.parts with target
  have parts := RingHom.parts with hom
  have maximalParts := MaximalIdeal.parts with maximal
  have engine := IsRingHom.comap_maximal with sourceParts, targetParts, parts,
    onto, maximalParts
  exact MaximalIdeal.of_projections with engine

theorem idealComap.prime_iff (J : Set)
  requires ideal : Ideal(S, J)
  shows PrimeIdeal(R, idealComap(f, R, J)) ↔ PrimeIdeal(S, J)
proof
  have sourceParts := CommRing.parts with source
  have targetParts := CommRing.parts with target
  have parts := RingHom.parts with hom
  have idealParts := Ideal.parts with ideal
  have criterion := IsRingHom.comap_prime_iff with sourceParts, targetParts, parts,
    onto, idealParts
  constructor
  . intro prime
    have engine := criterion.forward with (PrimeIdeal.parts with prime)
    exact PrimeIdeal.of_projections with engine
  . intro prime
    have engine := criterion.backward with (PrimeIdeal.parts with prime)
    exact PrimeIdeal.of_projections with engine

theorem idealComap.maximal_iff (J : Set)
  requires ideal : Ideal(S, J)
  shows MaximalIdeal(R, idealComap(f, R, J)) ↔ MaximalIdeal(S, J)
proof
  have sourceParts := CommRing.parts with source
  have targetParts := CommRing.parts with target
  have parts := RingHom.parts with hom
  have idealParts := Ideal.parts with ideal
  have criterion := IsRingHom.comap_maximal_iff with sourceParts, targetParts,
    parts, onto, idealParts
  constructor
  . intro maximal
    have engine := criterion.forward with (MaximalIdeal.parts with maximal)
    exact MaximalIdeal.of_projections with engine
  . intro maximal
    have engine := criterion.backward with (MaximalIdeal.parts with maximal)
    exact MaximalIdeal.of_projections with engine

end BundledSurjections
end BundledRingMaps
