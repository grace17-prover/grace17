-- The determinant is linear in each row over any commutative ring (ZF).
-- Part of Cumulus, the Grace17 mathematics library.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module Grace.Cumulus.Algebra.Ring.DeterminantLinearity
import Determinant
import FiniteLinearity

section Rings
variable (A add zero neg mul one : Set)
notation ring R := (A, add, zero, neg, mul, one)
hypothesis ring : IsCommRing(R)

-- The three matrices agree off row i; row i of P is a times M plus b times N.
theorem determinant.row_linear (n : Nat) (M N P i a b : Set)
  requires matrixM : RingMatrix(n, R, M)
  requires matrixN : RingMatrix(n, R, N)
  requires matrixP : RingMatrix(n, R, P)
  requires row : i ∈ n
  requires scalarA : a ∈ R
  requires scalarB : b ∈ R
  requires outsideN : ∀ k ∈ n, ¬(k = i) → ∀ j ∈ n, N[k, j] = M[k, j]
  requires outsideP : ∀ k ∈ n, ¬(k = i) → ∀ j ∈ n, P[k, j] = M[k, j]
  requires entries : ∀ j ∈ n, P[i, j] = a * M[i, j] + b * N[i, j]
  shows determinant(n, R, P) = a * determinant(n, R, M) + b * determinant(n, R, N)
proof
  have finite := Finite.natural at n with *
  have permutationsFinite := permutations.finite with finite
  have weightsM := determinantTerms.function at n, A, add, zero, neg, mul, one, M with *
  have weightsN := determinantTerms.function at n, A, add, zero, neg, mul, one, N with *
  have weightsP := determinantTerms.function at n, A, add, zero, neg, mul, one, P with *
  have terms : ∀ p ∈ permutations(n), determinantTerms(n, R, P)(p) = a * determinantTerms(n, R, M)(p) + b * determinantTerms(n, R, N)(p)
    intros p hp
    have permutation := permutations.membership.forward with hp
    have injective := Bijective.injective with permutation
    have function := Injective.function with injective
    have column := FunctionBetween.apply_closed at p, n, n, i with *
    have entriesM := permutationEntries.function at n, A, M, p with *
    have entriesN := permutationEntries.function at n, A, N, p with *
    have entriesP := permutationEntries.function at n, A, P, p with *
    have outsideNEntries : ∀ k ∈ n, ¬(k = i) → permutationEntries(n, A, N, p)(k) = permutationEntries(n, A, M, p)(k)
      intros k hk distinct
      have image := FunctionBetween.apply_closed at p, n, n, k with *
      have leftValue := permutationEntries.value at n, A, N, p, k with *
      have rightValue := permutationEntries.value at n, A, M, p, k with *
      rw [leftValue, rightValue]
      exact outsideN with k, hk, distinct, p(k), image
    have outsidePEntries : ∀ k ∈ n, ¬(k = i) → permutationEntries(n, A, P, p)(k) = permutationEntries(n, A, M, p)(k)
      intros k hk distinct
      have image := FunctionBetween.apply_closed at p, n, n, k with *
      have leftValue := permutationEntries.value at n, A, P, p, k with *
      have rightValue := permutationEntries.value at n, A, M, p, k with *
      rw [leftValue, rightValue]
      exact outsideP with k, hk, distinct, p(k), image
    have entry : permutationEntries(n, A, P, p)(i) = a * permutationEntries(n, A, M, p)(i) + b * permutationEntries(n, A, N, p)(i)
      have valueM := permutationEntries.value at n, A, M, p, i with *
      have valueN := permutationEntries.value at n, A, N, p, i with *
      have valueP := permutationEntries.value at n, A, P, p, i with *
      rw [valueP, valueM, valueN]
      exact entries with p(i), column
    have product := finiteRingProduct.linear_at at n, A, add, zero, neg, mul, one, permutationEntries(n, A, M, p), permutationEntries(n, A, N, p), permutationEntries(n, A, P, p), i, a, b with *
    have sign := permutationSign.closed at A, add, zero, neg, mul, one, n, p with *
    have closedM := finiteRingProduct.closed at n, A, add, zero, neg, mul, one, permutationEntries(n, A, M, p) with *
    have closedN := finiteRingProduct.closed at n, A, add, zero, neg, mul, one, permutationEntries(n, A, N, p) with *
    have termM := determinantTerms.value at n, A, add, zero, neg, mul, one, M, p with *
    have termN := determinantTerms.value at n, A, add, zero, neg, mul, one, N, p with *
    have termP := determinantTerms.value at n, A, add, zero, neg, mul, one, P, p with *
    rw [termP, termM, termN, product]
    ring
  unfold determinant
  exact finiteRingSum.linear at permutations(n), A, add, zero, neg, mul, one, determinantTerms(n, R, M), determinantTerms(n, R, N), determinantTerms(n, R, P), a, b with *

end Rings
