module Grace.Cumulus.Algebra.Ring.IndexedSum
import CoefficientSingle
import Cardinal.Enumeration

predicate WeightedValues (w f A n : Set) := ∀ i ∈ n, w(f(i)) ∈ A

def indexedRingSum (w f add z0 : Set, n : Nat) → Set
  | w, f, add, z0, zero => z0
  | w, f, add, z0, succ(k) => call2(add, indexedRingSum(w, f, add, z0, k), w(f(k)))

def matchingRingRow (A z0 add w f x : Set, n : Nat) → Set
  | A, z0, add, w, f, x, zero => z0
  | A, z0, add, w, f, x, succ(k) => call2(add, matchingRingRow(A, z0, add, w, f, x, k), singleValue(A, z0, w(x), x, f(k)))

def matchingRingTotal (A z0 add w f g : Set, n m : Nat) → Set
  | A, z0, add, w, f, g, n, zero => z0
  | A, z0, add, w, f, g, n, succ(k) => call2(add, matchingRingTotal(A, z0, add, w, f, g, n, k), matchingRingRow(A, z0, add, w, f, g(k), n))
  descends m

theorem WeightedValues.prefix (w f A : Set, n : Nat)
  requires values : WeightedValues(w, f, A, succ(n))
  shows WeightedValues(w, f, A, n)
proof
  intros i hi
  have next := membership.into_successor with *
  exact values with i, next

theorem WeightedValues.last (w f A : Set, n : Nat)
  requires values : WeightedValues(w, f, A, succ(n))
  shows w(f(n)) ∈ A
proof
  have last := membership.self_successor with *
  exact values with n, last

section Rings
variable (A add zero neg mul one w : Set)
hypothesis ring : IsCommRing(A, add, zero, neg, mul, one)
notation ring R := (A, add, zero, neg, mul, one)

theorem indexedRingSum.closed (f : Set, n : Nat)
  shows WeightedValues(w, f, A, n) → indexedRingSum(w, f, add, zero, n) ∈ A
proof
  induction n
  | zero =>
    have ordinary := IsCommRing.ring with ring
    intro values
    rw indexedRingSum
    exact IsRing.zero_in_carrier with ordinary
  | succ(k) using ih =>
    have ordinary := IsCommRing.ring with ring
    intro values
    have prefix := WeightedValues.prefix at w, f, A, k with *
    have last := WeightedValues.last at w, f, A, k with *
    have previous := ih with prefix
    rw indexedRingSum
    exact IsRing.add_closed with ordinary, previous, last

theorem matchingRingRow.closed (f x : Set, n : Nat)
  requires value : w(x) ∈ A
  shows matchingRingRow(A, zero, add, w, f, x, n) ∈ A
proof
  induction n
  | zero =>
    have ordinary := IsCommRing.ring with ring
    have zeroIn := IsRing.zero_in_carrier with ordinary
    rwa matchingRingRow
  | succ(k) using ih =>
    have ordinary := IsCommRing.ring with ring
    have zeroIn := IsRing.zero_in_carrier with ordinary
    have last := singleValue.closed at A, zero, w(x), x, f(k) with *
    rw matchingRingRow
    exact IsRing.add_closed with ordinary, ih, last

theorem matchingRingTotal.closed (f g : Set, n m : Nat)
  shows WeightedValues(w, g, A, m) → matchingRingTotal(A, zero, add, w, f, g, n, m) ∈ A
proof
  induction m
  | zero =>
    have ordinary := IsCommRing.ring with ring
    intro values
    rw matchingRingTotal
    exact IsRing.zero_in_carrier with ordinary
  | succ(k) using ih =>
    have ordinary := IsCommRing.ring with ring
    intro values
    have prefix := WeightedValues.prefix at w, g, A, k with *
    have last := WeightedValues.last at w, g, A, k with *
    have previous := ih with prefix
    have row := matchingRingRow.closed at A, add, zero, neg, mul, one, w, f, g(k), n with *
    rw matchingRingTotal
    exact IsRing.add_closed with ordinary, previous, row

theorem matchingRingRow.absent (f x : Set, n : Nat)
  requires value : w(x) ∈ A
  shows (∀ i ∈ n, f(i) ≠ x) → matchingRingRow(A, zero, add, w, f, x, n) = zero
proof
  induction n
  | zero =>
    have ordinary := IsCommRing.ring with ring
    have zeroIn := IsRing.zero_in_carrier with ordinary
    intro absent
    rw matchingRingRow
    rfl
  | succ(k) using ih =>
    have ordinary := IsCommRing.ring with ring
    have zeroIn := IsRing.zero_in_carrier with ordinary
    intro absent
    have prefix : ∀ i ∈ k, f(i) ≠ x
      intros i before
      have included := membership.into_successor at i, k with *
      exact absent with i, included
    have last := absent with k, membership.self_successor at k with *
    have previous := ih with prefix
    have entry := singleValue.other at A, zero, w(x), x, f(k) with *
    rw [matchingRingRow, previous, entry]
    ring

theorem matchingRingRow.unique (f x : Set, n : Nat)
  requires value : w(x) ∈ A
  shows DistinctValues(f, n) → Occurs(f, n, x) → matchingRingRow(A, zero, add, w, f, x, n) = w(x)
proof
  induction n
  | zero =>
    have ordinary := IsCommRing.ring with ring
    have zeroIn := IsRing.zero_in_carrier with ordinary
    intros distinct occurs
    rcases occurs with ⟨i, impossible, same⟩
    exfalso
    simp [nat.zero, set.empty]
  | succ(k) using ih =>
    have ordinary := IsCommRing.ring with ring
    have zeroIn := IsRing.zero_in_carrier with ordinary
    intros distinct occurs
    have alternatives : f(k) = x ∨ f(k) ≠ x by tauto
    cases alternatives with last | other
    . have fresh := DistinctValues.last_fresh at f, k with *
      have absent : ∀ i ∈ k, f(i) ≠ x
        intros i before equal
        have different := fresh with i, before
        rw ← last at equal
        exact different with equal
      have previous := matchingRingRow.absent at A, add, zero, neg, mul, one, w, f, x, k with *
      have entry := singleValue.same at A, zero, w(x), x, f(k) with *
      rw [matchingRingRow, previous, entry]
      ring
    . obtain ⟨position, before, equal⟩ := Occurs.forward at f, succ(k), x with occurs
      have shape := membership.successor_forward{n := k} with before
      have earlier : position ∈ k
        cases shape with inside | atLast
        . exact inside
        . exfalso
          rw atLast at equal
          exact other with equal
      have prefix := DistinctValues.prefix at f, k with *
      have occurrence : Occurs(f, k, x)
        unfold Occurs
        refine ⟨position, earlier, equal⟩
      have previous := ih with prefix, occurrence
      have entry := singleValue.other at A, zero, w(x), x, f(k) with *
      rw [matchingRingRow, previous, entry]
      ring

theorem matchingRingWeight.symmetric (x y : Set)
  requires xValue : w(x) ∈ A
  requires yValue : w(y) ∈ A
  shows singleValue(A, zero, w(x), x, y) = singleValue(A, zero, w(y), y, x)
proof
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have alternatives : x = y ∨ x ≠ y by tauto
  cases alternatives with same | different
  . rw same
    rfl
  . have reverse : y ≠ x
      intro equal
      have impossible : x = y by cc
      exact different with impossible
    have left := singleValue.other at A, zero, w(x), x, y with *
    have right := singleValue.other at A, zero, w(y), y, x with *
    cc

theorem matchingRingTotal.empty_left (f g : Set, m : Nat)
  shows matchingRingTotal(A, zero, add, w, f, g, (0:Nat), m) = zero
proof
  induction m
  | zero =>
    rw matchingRingTotal
    rfl
  | succ(k) using ih =>
    rw [matchingRingTotal, matchingRingRow, ih]
    ring

theorem matchingRingTotal.extend_left (f g : Set, n m : Nat)
  requires value : w(f(n)) ∈ A
  shows WeightedValues(w, g, A, m) →
    matchingRingTotal(A, zero, add, w, f, g, succ(n), m) =
    matchingRingTotal(A, zero, add, w, f, g, n, m) + matchingRingRow(A, zero, add, w, g, f(n), m)
proof
  induction m
  | zero =>
    have ordinary := IsCommRing.ring with ring
    have zeroIn := IsRing.zero_in_carrier with ordinary
    intro values
    simp [matchingRingTotal, matchingRingRow]
    ring
  | succ(k) using ih =>
    have ordinary := IsCommRing.ring with ring
    have zeroIn := IsRing.zero_in_carrier with ordinary
    intro values
    have prefix := WeightedValues.prefix at w, g, A, k with *
    have last := WeightedValues.last at w, g, A, k with *
    have previous := ih with prefix
    have symmetric := matchingRingWeight.symmetric at A, add, zero, neg, mul, one, w, g(k), f(n) with *
    have totalBound := matchingRingTotal.closed at A, add, zero, neg, mul, one, w, f, g, n, k with *
    have totalIn := totalBound with prefix
    have rowLeftIn := matchingRingRow.closed at A, add, zero, neg, mul, one, w, g, f(n), k with *
    have rowRightIn := matchingRingRow.closed at A, add, zero, neg, mul, one, w, f, g(k), n with *
    have entryIn := singleValue.closed at A, zero, w(f(n)), f(n), g(k) with *
    rw [matchingRingTotal, matchingRingTotal, matchingRingRow, matchingRingRow, previous, symmetric]
    ring

theorem matchingRingTotal.transpose (f g : Set, m n : Nat)
  requires valuesG : WeightedValues(w, g, A, m)
  shows WeightedValues(w, f, A, n) →
    matchingRingTotal(A, zero, add, w, f, g, n, m) = matchingRingTotal(A, zero, add, w, g, f, m, n)
proof
  induction n
  | zero =>
    intro valuesF
    have empty := matchingRingTotal.empty_left at A, add, zero, neg, mul, one, w, f, g, m with *
    rw [empty, matchingRingTotal]
    rfl
  | succ(k) using ih =>
    intro valuesF
    have prefix := WeightedValues.prefix at w, f, A, k with *
    have last := WeightedValues.last at w, f, A, k with *
    have previous := ih with prefix
    have extended := matchingRingTotal.extend_left at A, add, zero, neg, mul, one, w, f, g, k, m with *
    rw [extended, matchingRingTotal, previous]
    rfl

theorem matchingRingTotal.sum (f g : Set, n m : Nat)
  requires distinct : DistinctValues(f, n)
  shows WeightedValues(w, g, A, m) → (∀ j ∈ m, Occurs(f, n, g(j))) →
    matchingRingTotal(A, zero, add, w, f, g, n, m) = indexedRingSum(w, g, add, zero, m)
proof
  induction m
  | zero =>
    intros values covered
    simp [matchingRingTotal, indexedRingSum]
  | succ(k) using ih =>
    intros values covered
    have prefix : ∀ j ∈ k, Occurs(f, n, g(j))
      intros j before
      have included := membership.into_successor at j, k with *
      exact covered with j, included
    have last := covered with k, membership.self_successor at k with *
    have valuePrefix := WeightedValues.prefix at w, g, A, k with *
    have valueLast := WeightedValues.last at w, g, A, k with *
    have row := matchingRingRow.unique at A, add, zero, neg, mul, one, w, f, g(k), n with *
    have previous := ih with valuePrefix, prefix
    rw [matchingRingTotal, indexedRingSum, previous, row]
    rfl

theorem indexedRingSum.same_entries (f g : Set, n m : Nat)
  requires valuesF : WeightedValues(w, f, A, n)
  requires valuesG : WeightedValues(w, g, A, m)
  requires distinctF : DistinctValues(f, n)
  requires distinctG : DistinctValues(g, m)
  requires coveredF : ∀ i ∈ n, Occurs(g, m, f(i))
  requires coveredG : ∀ j ∈ m, Occurs(f, n, g(j))
  shows indexedRingSum(w, f, add, zero, n) = indexedRingSum(w, g, add, zero, m)
proof
  have left := matchingRingTotal.sum at A, add, zero, neg, mul, one, w, g, f, m, n with *
  have right := matchingRingTotal.sum at A, add, zero, neg, mul, one, w, f, g, n, m with *
  have transpose := matchingRingTotal.transpose at A, add, zero, neg, mul, one, w, f, g, m, n with *
  rw [← left, ← right]
  symm
  exact transpose with valuesF

theorem indexedRingSum.reindex (V f g : Set, n m : Nat)
  requires weights : w : V → A
  requires enumerationF : BijectiveBetween(f, n, V)
  requires enumerationG : BijectiveBetween(g, m, V)
  shows indexedRingSum(w, f, add, zero, n) = indexedRingSum(w, g, add, zero, m)
proof
  have injF := Bijective.injective with enumerationF
  have injG := Bijective.injective with enumerationG
  have surjF := Bijective.surjective with enumerationF
  have surjG := Bijective.surjective with enumerationG
  have fnF := Injective.function with injF
  have fnG := Injective.function with injG
  have distinctF := Injective.distinct_values with injF
  have distinctG := Injective.distinct_values with injG
  have valuesF : WeightedValues(w, f, A, n)
    intros i hi
    have member := FunctionBetween.apply_closed with *
    exact FunctionBetween.apply_closed with *
  have valuesG : WeightedValues(w, g, A, m)
    intros j hj
    have member := FunctionBetween.apply_closed with *
    exact FunctionBetween.apply_closed with *
  have coveredF : ∀ i ∈ n, Occurs(g, m, f(i))
    intros i hi
    have member := FunctionBetween.apply_closed with *
    exact Surjective.occurs with *
  have coveredG : ∀ j ∈ m, Occurs(f, n, g(j))
    intros j hj
    have member := FunctionBetween.apply_closed with *
    exact Surjective.occurs with *
  exact indexedRingSum.same_entries with *

theorem indexedRingSum.add (v h f : Set, n : Nat)
  shows WeightedValues(w, f, A, n) → WeightedValues(v, f, A, n) →
    (∀ i ∈ n, h(f(i)) = w(f(i)) + v(f(i))) →
    indexedRingSum(h, f, add, zero, n) = indexedRingSum(w, f, add, zero, n) + indexedRingSum(v, f, add, zero, n)
proof
  induction n
  | zero =>
    intros valuesW valuesV equations
    simp [indexedRingSum]
    ring
  | succ(k) using ih =>
    intros valuesW valuesV equations
    have prefixW := WeightedValues.prefix at w, f, A, k with *
    have prefixV := WeightedValues.prefix at v, f, A, k with *
    have lastW := WeightedValues.last at w, f, A, k with *
    have lastV := WeightedValues.last at v, f, A, k with *
    have prefix : ∀ i ∈ k, h(f(i)) = w(f(i)) + v(f(i))
      intros i hi
      have next := membership.into_successor at i, k with *
      exact equations with i, next
    have last := equations with k, membership.self_successor at k with *
    have previous := ih with prefixW, prefixV, prefix
    have closureW := indexedRingSum.closed at A, add, zero, neg, mul, one, w, f, k with *
    have sumW := closureW with prefixW
    have closureV := indexedRingSum.closed at A, add, zero, neg, mul, one, v, f, k with *
    have sumV := closureV with prefixV
    rw [indexedRingSum, indexedRingSum, indexedRingSum, previous, last]
    ring

theorem indexedRingSum.scale (a v f : Set, n : Nat)
  requires scalar : a ∈ A
  shows WeightedValues(w, f, A, n) → (∀ i ∈ n, v(f(i)) = a * w(f(i))) →
    indexedRingSum(v, f, add, zero, n) = a * indexedRingSum(w, f, add, zero, n)
proof
  induction n
  | zero =>
    intros values equations
    simp [indexedRingSum]
    ring
  | succ(k) using ih =>
    intros values equations
    have prefixW := WeightedValues.prefix at w, f, A, k with *
    have lastW := WeightedValues.last at w, f, A, k with *
    have prefix : ∀ i ∈ k, v(f(i)) = a * w(f(i))
      intros i hi
      have next := membership.into_successor at i, k with *
      exact equations with i, next
    have last := equations with k, membership.self_successor at k with *
    have previous := ih with prefixW, prefix
    have closure := indexedRingSum.closed at A, add, zero, neg, mul, one, w, f, k with *
    have sumW := closure with prefixW
    rw [indexedRingSum, indexedRingSum, previous, last]
    ring

end Rings
