module Grace.Cumulus.Algebra.Ring.Cofactors
import Determinant
import WeightedRegrouping

defgraph permutationColumn (I i : Set) (p ∈ permutations(I)) : I := p(i)
requires row : i ∈ I
proof
  have permutation := permutations.membership.forward at I, p with *
  have injective := Bijective.injective with permutation
  have function := Injective.function with injective
  exact FunctionBetween.apply_closed at p, I, I, i with *

-- Delete just the distinguished factor, retaining its permutation sign.
defgraph cofactorTerms (I A add zero neg mul one M i : Set) (p ∈ permutations(I)) : A :=
  call2(mul, permutationSign(I, A, add, zero, neg, mul, one, p),
    finiteRingProduct(I ∖ {i}, A, add, zero, neg, mul, one, restrict(permutationEntries(I, A, M, p), I ∖ {i})))
requires ring : IsCommRing(A, add, zero, neg, mul, one)
requires finite : Finite(I)
requires matrix : RingMatrix(I, A, M)
proof
  have permutation := permutations.membership.forward at I, p with *
  have entries := permutationEntries.function at I, A, M, p with *
  have subset := difference.subset_left at I, {i}
  have smaller := Finite.subset with finite, subset
  have restricted := restrict.domain_function at permutationEntries(I, A, M, p), I, A, I ∖ {i} with *
  have product := finiteRingProduct.closed at I ∖ {i}, A, add, zero, neg, mul, one, restrict(permutationEntries(I, A, M, p), I ∖ {i}) with *
  have sign := permutationSign.closed at A, add, zero, neg, mul, one, I, p with *
  have ordinary := IsCommRing.ring with ring
  exact IsRing.mul_closed with ordinary, sign, product

notation scoped cofactorTerms(I, R, M, i) => cofactorTerms(I, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, M, i)

-- Its j-th entry is the signed cofactor at (i,j), defined without reindexing minors.
def cofactorRow (I A add zero neg mul one M i : Set) : Set :=
  finitePushforward(permutations(I), I, A, add, zero, neg, mul, one,
    permutationColumn(I, i), cofactorTerms(I, A, add, zero, neg, mul, one, M, i))

notation scoped cofactorRow(I, R, M, i) => cofactorRow(I, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, M, i)

section Cofactors
variable (I A add zero neg mul one M i : Set)
notation ring R := (A, add, zero, neg, mul, one)
hypothesis ring : IsCommRing(R)
hypothesis finite : Finite(I)
hypothesis matrix : RingMatrix(I, R, M)

theorem cofactorRow.function
  shows cofactorRow(I, R, M, i) : I → R
proof
  have permutationsFinite := permutations.finite with finite
  have weights := cofactorTerms.function at I, A, add, zero, neg, mul, one, M, i with *
  unfold cofactorRow
  exact finitePushforward.function with *

theorem cofactorTerms.factor (N p : Set)
  requires matrixN : RingMatrix(I, R, N)
  requires row : i ∈ I
  requires permutation : BijectiveBetween(p, I, I)
  requires outside : ∀ k ∈ I, k ≠ i → ∀ j ∈ I, N[k, j] = M[k, j]
  shows determinantTerms(I, R, N)(p) = N[i, p(i)] * cofactorTerms(I, R, M, i)(p)
proof
  have member := permutations.membership.backward with permutation
  have injective := Bijective.injective with permutation
  have function := Injective.function with injective
  have column := FunctionBetween.apply_closed at p, I, I, i with *
  have entryIn := RingMatrix.entry at I, A, N, i, p(i) with *
  have subset := difference.subset_left at I, {i}
  have smaller := Finite.subset with finite, subset
  have entriesM := permutationEntries.function at I, A, M, p with *
  have entriesN := permutationEntries.function at I, A, N, p with *
  have restrictedM := restrict.domain_function at permutationEntries(I, A, M, p), I, A, I ∖ {i} with *
  have restrictedN := restrict.domain_function at permutationEntries(I, A, N, p), I, A, I ∖ {i} with *
  have same : ∀ k ∈ I ∖ {i}, restrict(permutationEntries(I, A, N, p), I ∖ {i})(k) = restrict(permutationEntries(I, A, M, p), I ∖ {i})(k)
    intros k hk
    have inI : k ∈ I by simp [difference.membership]
    have different : k ≠ i by simp [difference.membership, singleton.membership]
    have image := FunctionBetween.apply_closed at p, I, I, k with *
    have restrictN := restrict.domain_apply at permutationEntries(I, A, N, p), I, A, I ∖ {i}, k with *
    have restrictM := restrict.domain_apply at permutationEntries(I, A, M, p), I, A, I ∖ {i}, k with *
    have valueN := permutationEntries.value at I, A, N, p, k with *
    have valueM := permutationEntries.value at I, A, M, p, k with *
    have equal := outside with k, inI, different, p(k), image
    cc
  have products := finiteRingProduct.congr at I ∖ {i}, A, add, zero, neg, mul, one, restrict(permutationEntries(I, A, N, p), I ∖ {i}), restrict(permutationEntries(I, A, M, p), I ∖ {i}) with *
  have removal := finiteRingProduct.remove at I, A, add, zero, neg, mul, one, permutationEntries(I, A, N, p), i with *
  have entry := permutationEntries.value at I, A, N, p, i with *
  have term := determinantTerms.value at I, A, add, zero, neg, mul, one, N, p with *
  have cofactor := cofactorTerms.value at I, A, add, zero, neg, mul, one, M, i, p with *
  have rest := finiteRingProduct.closed at I ∖ {i}, A, add, zero, neg, mul, one, restrict(permutationEntries(I, A, M, p), I ∖ {i}) with *
  have sign := permutationSign.closed at A, add, zero, neg, mul, one, I, p with *
  rw [term, cofactor, removal, products, entry]
  ring

end Cofactors

defgraph cofactorPairWeights (I A add zero neg mul one M N i r : Set) (j ∈ I) : A :=
  call2(mul, N[r, j], cofactorRow(I, A, add, zero, neg, mul, one, M, i)(j))
requires ring : IsCommRing(A, add, zero, neg, mul, one)
requires finite : Finite(I)
requires matrixM : RingMatrix(I, A, M)
requires matrixN : RingMatrix(I, A, N)
requires row : r ∈ I
proof
  have cofactors := cofactorRow.function at I, A, add, zero, neg, mul, one, M, i with *
  have cofactor := FunctionBetween.apply_closed at cofactorRow(I, A, add, zero, neg, mul, one, M, i), I, A, j with *
  have entry := RingMatrix.entry at I, A, N, r, j with *
  have ordinary := IsCommRing.ring with ring
  exact IsRing.mul_closed with ordinary, entry, cofactor

notation scoped cofactorPairWeights(I, R, M, N, i, r) => cofactorPairWeights(I, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, M, N, i, r)

def cofactorPairing (I A add zero neg mul one M N i r : Set) : Set :=
  finiteRingSum(I, A, add, zero, neg, mul, one, cofactorPairWeights(I, A, add, zero, neg, mul, one, M, N, i, r))

notation scoped cofactorPairing(I, R, M, N, i, r) => cofactorPairing(I, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, M, N, i, r)

section Expansion
variable (A add zero neg mul one : Set)
notation ring R := (A, add, zero, neg, mul, one)
hypothesis ring : IsCommRing(R)

theorem determinant.row_expansion (n : Nat) (M N i : Set)
  requires matrixM : RingMatrix(n, R, M)
  requires matrixN : RingMatrix(n, R, N)
  requires row : i ∈ n
  requires outside : ∀ k ∈ n, k ≠ i → ∀ j ∈ n, N[k, j] = M[k, j]
  shows determinant(n, R, N) = cofactorPairing(n, R, M, N, i, i)
proof
  have finite := Finite.natural with *
  have permutationsFinite := permutations.finite with finite
  have indexMap := permutationColumn.function at n, i with *
  have weights := cofactorTerms.function at n, A, add, zero, neg, mul, one, M, i with *
  have terms := determinantTerms.function at n, A, add, zero, neg, mul, one, N with *
  have functionN := matrixN
  have scalars := finiteRowWeights.function at n, n, A, N, i with *
  have outputs := cofactorPairWeights.function at n, A, add, zero, neg, mul, one, M, N, i, i with *
  have factors : ∀ p ∈ permutations(n), determinantTerms(n, R, N)(p) = finiteRowWeights(n, n, A, N, i)(permutationColumn(n, i)(p)) * cofactorTerms(n, R, M, i)(p)
    intros p hp
    have permutation := permutations.membership.forward with *
    have injective := Bijective.injective with permutation
    have function := Injective.function with injective
    have column := FunctionBetween.apply_closed with function
    have index := permutationColumn.value at n, i, p with *
    have value := finiteRowWeights.value at n, n, A, N, i, p(i) with *
    have factor := cofactorTerms.factor with *
    cc
  have values : ∀ j ∈ n, cofactorPairWeights(n, R, M, N, i, i)(j) = finiteRowWeights(n, n, A, N, i)(j) * finitePushforward(permutations(n), n, A, add, zero, neg, mul, one, permutationColumn(n, i), cofactorTerms(n, R, M, i))(j)
    intros j hj
    have value := cofactorPairWeights.value at n, A, add, zero, neg, mul, one, M, N, i, i, j with *
    have entry := finiteRowWeights.value at n, n, A, N, i, j with *
    unfold cofactorRow at value
    cc
  have regroup := finitePushforward.weighted_sum with *
  unfold determinant
  unfold cofactorPairing
  rfl

end Expansion
