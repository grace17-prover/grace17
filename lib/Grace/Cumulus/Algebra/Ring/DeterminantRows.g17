module Grace.Cumulus.Algebra.Ring.DeterminantRows
import DeterminantLinearity
import MatrixRows
import PermutationSign

section Rings
variable (A add zero neg mul one : Set)
notation ring R := (A, add, zero, neg, mul, one)
hypothesis ring : IsCommRing(R)

theorem determinant.row_scale (n : Nat) (M N i a : Set)
  requires matrixM : RingMatrix(n, R, M)
  requires matrixN : RingMatrix(n, R, N)
  requires row : i ∈ n
  requires scalar : a ∈ R
  requires outside : ∀ k ∈ n, ¬(k = i) → ∀ j ∈ n, N[k, j] = M[k, j]
  requires entries : ∀ j ∈ n, N[i, j] = a * M[i, j]
  shows determinant(n, R, N) = a * determinant(n, R, M)
proof
  have zeroIn : R[0] ∈ R by typecheck
  have unchanged : ∀ k ∈ n, ¬(k = i) → ∀ j ∈ n, M[k, j] = M[k, j]
    intros k hk distinct j hj
    rfl
  have linear : ∀ j ∈ n, N[i, j] = a * M[i, j] + R[0] * M[i, j]
    intros j hj
    have closed := RingMatrix.entry at n, A, M, i, j with *
    have entry := entries with j, hj
    rw entry
    ring
  have equation := determinant.row_linear with *
  have closed := determinant.closed at A, add, zero, neg, mul, one, M, n with *
  rw equation
  ring

-- No auxiliary matrix, coefficient graph, division, or nonzero scalar is
-- required from the caller: just the equations describing the row operation.
theorem determinant.row_add_multiple (n : Nat) (M N i r a : Set)
  requires matrixM : RingMatrix(n, R, M)
  requires matrixN : RingMatrix(n, R, N)
  requires row : i ∈ n
  requires source : r ∈ n
  requires distinct : i ≠ r
  requires scalar : a ∈ R
  requires outside : ∀ k ∈ n, ¬(k = i) → ∀ j ∈ n, N[k, j] = M[k, j]
  requires entries : ∀ j ∈ n, N[i, j] = M[i, j] + a * M[r, j]
  shows determinant(n, R, N) = determinant(n, R, M)
proof
  have copied := matrixCopyRow.matrix at n, A, M, i, r with *
  have unit : R[1] ∈ R by typecheck
  have reverse : r ≠ i
    intro equal
    apply distinct
    cc
  have outsideCopy : ∀ k ∈ n, ¬(k = i) → ∀ j ∈ n, matrixCopyRow(n, A, M, i, r)[k, j] = M[k, j]
    intros k hk different j hj
    exact matrixCopyRow.other with *
  have equalRows : ∀ j ∈ n, matrixCopyRow(n, A, M, i, r)[i, j] = matrixCopyRow(n, A, M, i, r)[r, j]
    intros j hj
    have left := matrixCopyRow.same at n, A, M, i, r, j with *
    have right := matrixCopyRow.other at n, A, M, i, r, r, j with *
    cc
  have vanishes := determinant.equal_rows with *
  have linear : ∀ j ∈ n, N[i, j] = R[1] * M[i, j] + a * matrixCopyRow(n, A, M, i, r)[i, j]
    intros j hj
    have value := matrixCopyRow.same at n, A, M, i, r, j with *
    have original := RingMatrix.entry at n, A, M, i, j with *
    have sourceEntry := RingMatrix.entry at n, A, M, r, j with *
    have entry := entries with j, hj
    rw [value, entry]
    ring
  have equation := determinant.row_linear with *
  have closed := determinant.closed at A, add, zero, neg, mul, one, M, n with *
  rw [equation, vanishes]
  ring

end Rings
