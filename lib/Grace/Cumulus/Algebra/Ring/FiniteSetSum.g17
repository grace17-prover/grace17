module Grace.Cumulus.Algebra.Ring.FiniteSetSum
import IndexedSum

theorem WeightedValues.of_functions (w f V A n : Set)
  requires weights : w : V → A
  requires enumeration : f : n → V
  shows WeightedValues(w, f, A, n)
proof
  intros i hi
  have member := FunctionBetween.apply_closed at f, n, V, i with *
  exact FunctionBetween.apply_closed at w, V, A, f(i) with *

defunique finiteRingSum (V A add zero neg mul one w : Set) (sum ∈ A) :=
  ∃ n, Nat(n) ∧ ∃ f, BijectiveBetween(f, n, V) ∧ sum = indexedRingSum(w, f, add, zero, n)
requires ring : IsCommRing(A, add, zero, neg, mul, one)
requires finite : Finite(V)
requires weights : w : V → A
proof
  obtain ⟨n, natural, equivalent⟩ := finite
  obtain ⟨f, bijective⟩ := equivalent
  have enumeration := converse.bijective with bijective
  have function := converse.function_of_bijective with bijective
  have values := WeightedValues.of_functions with weights, function
  have closure := indexedRingSum.closed at A, add, zero, neg, mul, one, w, converse(f, V, n), n with *
  have sumIn := closure with values
  witness indexedRingSum(w, converse(f, V, n), add, zero, n)
  refine ⟨sumIn, n, natural, converse(f, V, n), enumeration, rfl⟩
uniqueness
  intros u uIn first v vIn second
  obtain ⟨n, naturalN, f, enumerationF, valueF⟩ := first
  obtain ⟨m, naturalM, g, enumerationG, valueG⟩ := second
  have same := indexedRingSum.reindex at A, add, zero, neg, mul, one, w, V, f, g, n, m with *
  cc

notation scoped finiteRingSum(V, R, w) => finiteRingSum(V, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, w)

theorem finiteRingSum.closed (V A add zero neg mul one w : Set)
  requires ring : IsCommRing(A, add, zero, neg, mul, one)
  requires finite : Finite(V)
  requires weights : w : V → A
  shows finiteRingSum(V, A, add, zero, neg, mul, one, w) ∈ A
proof
  have selected := finiteRingSum.selected at V, A, add, zero, neg, mul, one, w with *
  exact selected.left

theorem finiteRingSum.enumeration (V A add zero neg mul one w f : Set, n : Nat)
  requires ring : IsCommRing(A, add, zero, neg, mul, one)
  requires weights : w : V → A
  requires enumeration : BijectiveBetween(f, n, V)
  shows finiteRingSum(V, A, add, zero, neg, mul, one, w) = indexedRingSum(w, f, add, zero, n)
proof
  have reverse := converse.bijective with enumeration
  have cardinality : HasCardinality(V, n)
    unfold HasCardinality
    refine ⟨assumption, ?_⟩
    unfold Equipotent
    refine ⟨converse(f, n, V), reverse⟩
  have finite := Finite.from_cardinality with cardinality
  have selected := finiteRingSum.selected at V, A, add, zero, neg, mul, one, w with *
  obtain ⟨m, naturalM, g, enumerationG, value⟩ := selected.right
  have same := indexedRingSum.reindex at A, add, zero, neg, mul, one, w, V, g, f, m, n with *
  cc

theorem indexedRingSum.congr (w v f g add zero : Set, n : Nat)
  shows (∀ i ∈ n, w(f(i)) = v(g(i))) → indexedRingSum(w, f, add, zero, n) = indexedRingSum(v, g, add, zero, n)
proof
  induction n
  | zero =>
    intro values
    simp [indexedRingSum]
  | succ(k) using ih =>
    intro values
    have prefix : ∀ i ∈ k, w(f(i)) = v(g(i))
      intros i before
      have included := membership.into_successor with *
      exact values with i, included
    have last := values with k, membership.self_successor at k with *
    have previous := ih with prefix
    rw [indexedRingSum, indexedRingSum, previous, last]
    rfl

theorem finiteRingSum.congr (V A add zero neg mul one w v : Set)
  requires ring : IsCommRing(A, add, zero, neg, mul, one)
  requires finite : Finite(V)
  requires weightsW : w : V → A
  requires weightsV : v : V → A
  requires values : ∀ x ∈ V, w(x) = v(x)
  shows finiteRingSum(V, A, add, zero, neg, mul, one, w) = finiteRingSum(V, A, add, zero, neg, mul, one, v)
proof
  have equal := FunctionBetween.ext with weightsW, weightsV, values
  rw equal
  rfl

theorem indexedRingSum.zero (A add zero neg mul one w f : Set, n : Nat)
  requires ring : IsCommRing(A, add, zero, neg, mul, one)
  shows (∀ i ∈ n, w(f(i)) = zero) → indexedRingSum(w, f, add, zero, n) = zero
proof
  induction n
  | zero =>
    intro values
    rw indexedRingSum
    rfl
  | succ(k) using ih =>
    intro values
    have prefix : ∀ i ∈ k, w(f(i)) = zero
      intros i before
      have included := membership.into_successor with *
      exact values with i, included
    have last := values with k, membership.self_successor at k with *
    have previous := ih with prefix
    rw [indexedRingSum, previous, last]
    ring

theorem finiteRingSum.zero (V A add zero neg mul one w : Set)
  requires ring : IsCommRing(A, add, zero, neg, mul, one)
  requires finite : Finite(V)
  requires weights : w : V → A
  requires values : ∀ x ∈ V, w(x) = zero
  shows finiteRingSum(V, A, add, zero, neg, mul, one, w) = zero
proof
  have selected := finiteRingSum.selected at V, A, add, zero, neg, mul, one, w with *
  obtain ⟨n, natural, f, enumeration, equation⟩ := selected.right
  have injective := Bijective.injective with enumeration
  have function := Injective.function with injective
  have vanishing : ∀ i ∈ n, w(f(i)) = zero
    intros i hi
    have member := FunctionBetween.apply_closed with *
    exact values with f(i), member
  have zeroSum := indexedRingSum.zero at A, add, zero, neg, mul, one, w, f, n with *
  rw equation
  exact zeroSum with vanishing

section Linearity
variable (V A add zero neg mul one w : Set)
hypothesis ring : IsCommRing(A, add, zero, neg, mul, one)
hypothesis finite : Finite(V)
hypothesis weights : w : V → A
notation ring R := (A, add, zero, neg, mul, one)

theorem finiteRingSum.add (v : Set)
  requires weightsV : v : V → A
  shows finiteRingSum(V, A, add, zero, neg, mul, one, coefficientAdd(V, A, add, zero, neg, mul, one, w, v)) =
    finiteRingSum(V, A, add, zero, neg, mul, one, w) + finiteRingSum(V, A, add, zero, neg, mul, one, v)
proof
  have selected := finiteRingSum.selected at V, A, add, zero, neg, mul, one, w with *
  obtain ⟨n, natural, f, enumeration, equationW⟩ := selected.right
  have inj := Bijective.injective with enumeration
  have function := Injective.function with inj
  have valuesW := WeightedValues.of_functions with weights, function
  have valuesV := WeightedValues.of_functions with weightsV, function
  have combined := coefficientAdd.function at V, A, add, zero, neg, mul, one, w, v with *
  have equationV := finiteRingSum.enumeration at V, A, add, zero, neg, mul, one, v, f, n with *
  have equationSum := finiteRingSum.enumeration at V, A, add, zero, neg, mul, one, coefficientAdd(V, A, add, zero, neg, mul, one, w, v), f, n with *
  have equations : ∀ i ∈ n, coefficientAdd(V, A, add, zero, neg, mul, one, w, v)(f(i)) = w(f(i)) + v(f(i))
    intros i hi
    have member := FunctionBetween.apply_closed with *
    exact coefficientAdd.value at V, A, add, zero, neg, mul, one, w, v, f(i) with *
  have distribute := indexedRingSum.add at A, add, zero, neg, mul, one, w, v, coefficientAdd(V, A, add, zero, neg, mul, one, w, v), f, n with *
  rw [equationSum, equationW, equationV]
  exact distribute with valuesW, valuesV, equations

theorem finiteRingSum.scale (a : Set)
  requires scalar : a ∈ A
  shows finiteRingSum(V, A, add, zero, neg, mul, one, coefficientScale(V, A, add, zero, neg, mul, one, a, w)) =
    a * finiteRingSum(V, A, add, zero, neg, mul, one, w)
proof
  have selected := finiteRingSum.selected at V, A, add, zero, neg, mul, one, w with *
  obtain ⟨n, natural, f, enumeration, equationW⟩ := selected.right
  have inj := Bijective.injective with enumeration
  have function := Injective.function with inj
  have valuesW := WeightedValues.of_functions with weights, function
  have scaled := coefficientScale.function at V, A, add, zero, neg, mul, one, a, w with *
  have equationScale := finiteRingSum.enumeration at V, A, add, zero, neg, mul, one, coefficientScale(V, A, add, zero, neg, mul, one, a, w), f, n with *
  have equations : ∀ i ∈ n, coefficientScale(V, A, add, zero, neg, mul, one, a, w)(f(i)) = a * w(f(i))
    intros i hi
    have member := FunctionBetween.apply_closed at f, n, V, i with *
    exact coefficientScale.value at V, A, add, zero, neg, mul, one, a, w, f(i) with *
  have distribute := indexedRingSum.scale at A, add, zero, neg, mul, one, w, a, coefficientScale(V, A, add, zero, neg, mul, one, a, w), f, n with *
  rw [equationScale, equationW]
  exact distribute with valuesW, equations

end Linearity
