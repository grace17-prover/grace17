module Grace.Cumulus.Algebra.Ring.GeneratedIdeal
import Homomorphism

-- The bounded intersection of all ambient ideals containing the generators.
def idealSpan (A add zero neg mul G : Set) : Set :=
  {x ∈ A | ∀ J, IsIdeal(A, add, zero, neg, mul, J) → G ⊆ J → x ∈ J}

notation scoped idealSpan(R, G) => idealSpan(R.carrier, R.add, R.zero, R.neg, R.mul, G)

theorem idealSpan.membership (A add zero neg mul G x : Set)
  shows x ∈ idealSpan(A, add, zero, neg, mul, G) ↔
    x ∈ A ∧ (∀ J, IsIdeal(A, add, zero, neg, mul, J) → G ⊆ J → x ∈ J)
proof
  simp

theorem idealSpan.subset (A add zero neg mul G : Set)
  shows idealSpan(A, add, zero, neg, mul, G) ⊆ A
proof
  simp

theorem idealSpan.contains (A add zero neg mul G : Set)
  requires bounded : G ⊆ A
  shows G ⊆ idealSpan(A, add, zero, neg, mul, G)
proof
  intros x hx
  apply idealSpan.membership.backward
  refine ⟨?_, ?_⟩
  . exact bounded with x, hx
  . intros J ideal includes
    exact includes with x, hx

theorem idealSpan.least (A add zero neg mul G J : Set)
  requires ideal : IsIdeal(A, add, zero, neg, mul, J)
  requires includes : G ⊆ J
  shows idealSpan(A, add, zero, neg, mul, G) ⊆ J
proof
  intros x hx
  have data := idealSpan.membership.forward with hx
  exact data.right with J, ideal, includes

section Ring
variable (A add zero neg mul one : Set)
hypothesis ring : IsCommRing(A, add, zero, neg, mul, one)
notation ring R := (A, add, zero, neg, mul, one)

theorem idealSpan.ideal (G : Set)
  shows IsIdeal(A, add, zero, neg, mul, idealSpan(A, add, zero, neg, mul, G))
proof
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have bounded := idealSpan.subset at A, add, zero, neg, mul, G
  unfold IsIdeal
  refine ⟨bounded, ⟨?_, ⟨?_, ⟨?_, ?_⟩⟩⟩⟩
  . apply idealSpan.membership.backward at A, add, zero, neg, mul, G, zero
    refine ⟨zeroIn, ?_⟩
    intros J ideal includes
    exact IsIdeal.zero_closed with ideal
  . intros x hx y hy
    have dx := idealSpan.membership.forward with hx
    have dy := idealSpan.membership.forward with hy
    have closed := IsRing.add_closed with ordinary, dx.left, dy.left
    apply idealSpan.membership.backward
    refine ⟨closed, ?_⟩
    intros J ideal includes
    have xIn := dx.right with J, ideal, includes
    have yIn := dy.right with J, ideal, includes
    exact IsIdeal.add_closed with ideal, xIn, yIn
  . intros x hx
    have data := idealSpan.membership.forward with hx
    have closed := IsRing.neg_closed with ordinary, data.left
    apply idealSpan.membership.backward
    refine ⟨closed, ?_⟩
    intros J ideal includes
    have member := data.right with J, ideal, includes
    exact IsIdeal.neg_closed with ideal, member
  . intros a ha x hx
    have data := idealSpan.membership.forward with hx
    have leftClosed := IsRing.mul_closed with ordinary, ha, data.left
    have rightClosed := IsRing.mul_closed with ordinary, data.left, ha
    constructor
    . apply idealSpan.membership.backward at A, add, zero, neg, mul, G, a * x
      refine ⟨leftClosed, ?_⟩
      intros J ideal includes
      have member := data.right with J, ideal, includes
      exact IsIdeal.mul_left_closed with ideal, ha, member
    . apply idealSpan.membership.backward at A, add, zero, neg, mul, G, x * a
      refine ⟨rightClosed, ?_⟩
      intros K idealK includesK
      have memberK := data.right with K, idealK, includesK
      exact IsIdeal.mul_right_closed with idealK, ha, memberK

theorem idealSpan.mono (G H : Set)
  requires inclusion : G ⊆ H
  requires bounded : H ⊆ A
  shows idealSpan(A, add, zero, neg, mul, G) ⊆ idealSpan(A, add, zero, neg, mul, H)
proof
  have ideal := idealSpan.ideal at A, add, zero, neg, mul, one, H with ring
  have includes := idealSpan.contains at A, add, zero, neg, mul, H with bounded
  have generators := Subset.transitive with inclusion, includes
  exact idealSpan.least with ideal, generators

theorem idealSpan.eq_of_ideal (J : Set)
  requires ideal : IsIdeal(A, add, zero, neg, mul, J)
  shows idealSpan(A, add, zero, neg, mul, J) = J
proof
  have bounded := IsIdeal.subset_carrier with ideal
  have reflexive : J ⊆ J by simp [Subset]
  have left := idealSpan.least with ideal, reflexive
  have right := idealSpan.contains at A, add, zero, neg, mul, J with bounded
  exact Subset.antisymmetric with left, right

theorem idealSpan.idempotent (G : Set)
  shows idealSpan(A, add, zero, neg, mul, idealSpan(A, add, zero, neg, mul, G)) = idealSpan(A, add, zero, neg, mul, G)
proof
  have ideal := idealSpan.ideal at A, add, zero, neg, mul, one, G with ring
  exact idealSpan.eq_of_ideal with ring, ideal

theorem idealSpan.unit_iff (G : Set)
  shows 1 ∈ idealSpan(A, add, zero, neg, mul, G) ↔ idealSpan(A, add, zero, neg, mul, G) = A
proof
  have ideal := idealSpan.ideal at A, add, zero, neg, mul, one, G with ring
  have ordinary := IsCommRing.ring with ring
  constructor
  . intro member
    exact IsIdeal.whole_of_one with ordinary, ideal, member
  . intro equal
    have monoid := IsRing.multiplicative with ordinary
    have member := IsMonoid.unit_in_carrier with monoid
    rwa equal

-- A two-term convenience; arbitrary finite certificates live in FiniteCombination.
theorem idealSpan.unit_of_linear_combination2 (G p q a b : Set)
  requires bounded : G ⊆ A
  requires hp : p ∈ G
  requires hq : q ∈ G
  requires ha : a ∈ A
  requires hb : b ∈ A
  requires identity : a * p + b * q = 1
  shows 1 ∈ idealSpan(A, add, zero, neg, mul, G)
proof
  have ideal := idealSpan.ideal at A, add, zero, neg, mul, one, G with ring
  have includes := idealSpan.contains at A, add, zero, neg, mul, G with bounded
  have pIn := includes with p, hp
  have qIn := includes with q, hq
  have left := IsIdeal.mul_left_closed with ideal, ha, pIn
  have right := IsIdeal.mul_left_closed with ideal, hb, qIn
  have sum := IsIdeal.add_closed with ideal, left, right
  rwa identity at sum

end Ring

-- Abstract certificate soundness: evaluation maps will instantiate this theorem.
theorem idealSpan.unit_obstructs_vanishing (f A add zero neg mul one B plus z minus times unit G : Set)
  requires source : IsCommRing(A, add, zero, neg, mul, one)
  requires target : IsCommRing(B, plus, z, minus, times, unit)
  requires hom : IsRingHom(f, A, add, zero, neg, mul, one, B, plus, z, minus, times, unit)
  requires nontrivial : Nontrivial(B, z, unit)
  requires bounded : G ⊆ A
  requires certificate : one ∈ idealSpan(A, add, zero, neg, mul, G)
  shows ¬(∀ p ∈ G, f(p) = z)
proof
  intro vanishes
  have kernel := IsRingHom.kernel_ideal with source, target, hom
  have generators : G ⊆ ringKernel(f, A, z)
    intros p hp
    have pIn := bounded with p, hp
    have value := vanishes with p, hp
    exact ringKernel.membership.backward with ⟨pIn, value⟩
  have included := idealSpan.least with kernel, generators
  have unitIn := included with one, certificate
  have data := ringKernel.membership.forward with unitIn
  have identity := IsRingHom.one with hom
  have distinct := Nontrivial.distinct with nontrivial
  have equal : z = unit by cc
  exact distinct with equal

-- The ideal generated by a subset of a bundled ring.
def generatedIdeal (R G : Set) : Set :=
  idealSpan(R.carrier, R.add, R.zero, R.neg, R.mul, G)

theorem generatedIdeal.value (R G : Set)
  shows generatedIdeal(R, G) = idealSpan(R.carrier, R.add, R.zero, R.neg, R.mul, G)
proof
  simp [generatedIdeal]

section GeneratedIdeals
variable (R : Set)
hypothesis comm : CommRing(R)

theorem generatedIdeal.ideal (G : Set)
  shows Ideal(R, generatedIdeal(R, G))
proof
  have parts := CommRing.parts with comm
  have engine := idealSpan.ideal at R.carrier, R.add, R.zero, R.neg, R.mul,
    R.one, G with parts
  rw generatedIdeal.value
  exact Ideal.of_projections with engine

theorem generatedIdeal.contains (G : Set)
  requires bounded : G ⊆ R
  shows G ⊆ generatedIdeal(R, G)
proof
  rw generatedIdeal.value
  exact idealSpan.contains at R.carrier, R.add, R.zero, R.neg, R.mul, G
    with bounded

theorem generatedIdeal.least (G J : Set)
  requires ideal : Ideal(R, J)
  requires includes : G ⊆ J
  shows generatedIdeal(R, G) ⊆ J
proof
  have parts := Ideal.parts with ideal
  rw generatedIdeal.value
  exact idealSpan.least with parts, includes

theorem generatedIdeal.mono (G H : Set)
  requires inclusion : G ⊆ H
  requires bounded : H ⊆ R
  shows generatedIdeal(R, G) ⊆ generatedIdeal(R, H)
proof
  have ideal := generatedIdeal.ideal at R, H with comm
  have includes := generatedIdeal.contains with comm, bounded
  have generators := Subset.transitive with inclusion, includes
  exact generatedIdeal.least with comm, ideal, generators

theorem generatedIdeal.eq_of_ideal (J : Set)
  requires ideal : Ideal(R, J)
  shows generatedIdeal(R, J) = J
proof
  have parts := Ideal.parts with ideal
  rw generatedIdeal.value
  exact idealSpan.eq_of_ideal with (CommRing.parts with comm), parts

theorem generatedIdeal.unit_iff (G : Set)
  shows R[1] ∈ generatedIdeal(R, G) ↔ generatedIdeal(R, G) = R.carrier
proof
  have ideal := generatedIdeal.ideal at R, G with comm
  have ring := CommRing.to_ring with comm
  constructor
  . intro member
    exact Ideal.contains_one with ring, ideal, member
  . intro equal
    have oneIn : R[1] ∈ R := Ring.one_mem with *
    rwa equal

end GeneratedIdeals
