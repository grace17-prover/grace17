module Grace.Cumulus.Algebra.Ring.FiniteLinearity
import FiniteProduct

section Rings
variable (V A add zero neg mul one : Set)
notation ring R := (A, add, zero, neg, mul, one)
hypothesis ring : IsCommRing(R)
hypothesis finite : Finite(V)

theorem finiteRingProduct.remove (w i : Set)
  requires weights : w : V → A
  requires member : i ∈ V
  shows finiteRingProduct(V, R, w) = finiteRingProduct(V ∖ {i}, R, restrict(w, V ∖ {i})) * w(i)
proof
  have subset : V ∖ {i} ⊆ V by simp [Subset, difference.membership]
  have smaller := Finite.subset with finite, subset
  have fresh : ¬(i ∈ V ∖ {i}) by simp [difference.membership, singleton.membership]
  have restore := insert.restore with member
  have expanded : w : insert(i, V ∖ {i}) → A by rwa restore
  have equation := finiteRingProduct.insert with *
  rwa restore at equation

-- Only the distinguished factor varies. Callers supply pointwise equations,
-- without constructing graphs for their sums or scalar multiples.
theorem finiteRingProduct.linear_at (w v h i a b : Set)
  requires weightsW : w : V → A
  requires weightsV : v : V → A
  requires weightsH : h : V → A
  requires member : i ∈ V
  requires scalarA : a ∈ A
  requires scalarB : b ∈ A
  requires outsideV : ∀ j ∈ V, ¬(j = i) → v(j) = w(j)
  requires outsideH : ∀ j ∈ V, ¬(j = i) → h(j) = w(j)
  requires entry : h(i) = a * w(i) + b * v(i)
  shows finiteRingProduct(V, R, h) = a * finiteRingProduct(V, R, w) + b * finiteRingProduct(V, R, v)
proof
  have subset : V ∖ {i} ⊆ V by simp [Subset, difference.membership]
  have smaller := Finite.subset with finite, subset
  have restrictedW := restrict.domain_function at w, V, A, V ∖ {i} with *
  have restrictedV := restrict.domain_function at v, V, A, V ∖ {i} with *
  have restrictedH := restrict.domain_function at h, V, A, V ∖ {i} with *
  have sameV : ∀ j ∈ V ∖ {i}, restrict(v, V ∖ {i})(j) = restrict(w, V ∖ {i})(j)
    intros j hj
    have inV : j ∈ V by simp [difference.membership]
    have distinct : ¬(j = i) by simp [difference.membership, singleton.membership]
    have leftValue := restrict.domain_apply at v, V, A, V ∖ {i}, j with *
    have rightValue := restrict.domain_apply at w, V, A, V ∖ {i}, j with *
    rw [leftValue, rightValue]
    exact outsideV with j, inV, distinct
  have equalV := finiteRingProduct.congr with *
  have sameH : ∀ j ∈ V ∖ {i}, restrict(h, V ∖ {i})(j) = restrict(w, V ∖ {i})(j)
    intros j hj
    have inV : j ∈ V by simp [difference.membership]
    have distinct : ¬(j = i) by simp [difference.membership, singleton.membership]
    have leftValue := restrict.domain_apply at h, V, A, V ∖ {i}, j with *
    have rightValue := restrict.domain_apply at w, V, A, V ∖ {i}, j with *
    rw [leftValue, rightValue]
    exact outsideH with j, inV, distinct
  have equalH := finiteRingProduct.congr at V ∖ {i}, A, add, zero, neg, mul, one, restrict(h, V ∖ {i}), restrict(w, V ∖ {i}) with *
  have equationW := finiteRingProduct.remove at V, A, add, zero, neg, mul, one, w, i with *
  have equationV := finiteRingProduct.remove at V, A, add, zero, neg, mul, one, v, i with *
  have equationH := finiteRingProduct.remove at V, A, add, zero, neg, mul, one, h, i with *
  have rest := finiteRingProduct.closed at V ∖ {i}, A, add, zero, neg, mul, one, restrict(w, V ∖ {i}) with *
  have valueW := FunctionBetween.apply_closed at w, V, A, i with *
  have valueV := FunctionBetween.apply_closed at v, V, A, i with *
  rw [equationH, equationW, equationV, equalH, equalV, entry]
  ring

theorem finiteRingSum.linear (w v h a b : Set)
  requires weightsW : w : V → A
  requires weightsV : v : V → A
  requires weightsH : h : V → A
  requires scalarA : a ∈ A
  requires scalarB : b ∈ A
  requires entries : ∀ i ∈ V, h(i) = a * w(i) + b * v(i)
  shows finiteRingSum(V, R, h) = a * finiteRingSum(V, R, w) + b * finiteRingSum(V, R, v)
proof
  have scaledW := coefficientScale.function at V, A, add, zero, neg, mul, one, a, w with *
  have scaledV := coefficientScale.function at V, A, add, zero, neg, mul, one, b, v with *
  have combined := coefficientAdd.function at V, A, add, zero, neg, mul, one, coefficientScale(V, R, a, w), coefficientScale(V, R, b, v) with *
  have equations : ∀ i ∈ V, h(i) = coefficientAdd(V, R, coefficientScale(V, R, a, w), coefficientScale(V, R, b, v))(i)
    intros i hi
    have sum := coefficientAdd.value at V, A, add, zero, neg, mul, one, coefficientScale(V, R, a, w), coefficientScale(V, R, b, v), i with *
    have leftValue := coefficientScale.value at V, A, add, zero, neg, mul, one, a, w, i with *
    have rightValue := coefficientScale.value at V, A, add, zero, neg, mul, one, b, v, i with *
    rw [sum, leftValue, rightValue]
    exact entries with i, hi
  have equal := finiteRingSum.congr with *
  have sum := finiteRingSum.add at V, A, add, zero, neg, mul, one, coefficientScale(V, R, a, w), coefficientScale(V, R, b, v) with *
  have leftSum := finiteRingSum.scale at V, A, add, zero, neg, mul, one, w, a with *
  have rightSum := finiteRingSum.scale at V, A, add, zero, neg, mul, one, v, b with *
  rw [equal, sum, leftSum, rightSum]
  rfl

-- Pointwise scaling avoids an auxiliary coefficientScale graph at call sites.
theorem finiteRingSum.scale_eq (w v a : Set)
  requires weightsW : w : V → A
  requires weightsV : v : V → A
  requires scalar : a ∈ R
  requires entries : ∀ i ∈ V, v(i) = a * w(i)
  shows finiteRingSum(V, R, v) = a * finiteRingSum(V, R, w)
proof
  have zeroIn : R[0] ∈ R by typecheck
  have linear : ∀ i ∈ V, v(i) = a * w(i) + R[0] * w(i)
    intros i hi
    have closed := FunctionBetween.apply_closed at w, V, A, i with *
    have entry := entries with i, hi
    rw entry
    ring
  have equation := finiteRingSum.linear with *
  have closed := finiteRingSum.closed at V, A, add, zero, neg, mul, one, w with *
  rw equation
  ring

end Rings
