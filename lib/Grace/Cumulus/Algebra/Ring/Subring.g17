module Grace.Cumulus.Algebra.Ring.Subring
import SubringCore
import Homomorphism

-- Under a hypothesis Ring(R), a subring is a subset containing zero and
-- one and closed under negation, addition, and multiplication. IsSubring(A,
-- add, zero, neg, mul, one, S) remains the form over separate pieces,
-- bridged below.
section Definitions
variable (R : Set)
hypothesis ring : Ring(R)

predicate Subring (S : Set) :=
  S ⊆ R ∧ R[0] ∈ S ∧ R[1] ∈ S ∧ (∀ x ∈ S, -x ∈ S) ∧
  (∀ x y ∈ S, x + y ∈ S) ∧ (∀ x y ∈ S, x * y ∈ S)

end Definitions

notation infixl 60 "+" => call2(R.add, _, _) via hypothesis Subring(R, S) for S
notation infixl 70 "*" => call2(R.mul, _, _) via hypothesis Subring(R, S) for S
notation prefix 75 "-" => apply(R.neg, _) via hypothesis Subring(R, S) for S
notation infixl 60 "-" => Ring.sub(R, _, _) via hypothesis Subring(R, S) for S

instance Subring.parts (R S : Set)
  requires subring : Subring(R, S)
  shows IsSubring(R.carrier, R.add, R.zero, R.neg, R.mul, R.one, S)
proof
  obtain ⟨bounded, zeroIn, oneIn, negatives, sums, products⟩ := subring
  unfold IsSubring
  refine ⟨bounded, zeroIn, oneIn, ?_, ?_, ?_⟩
  . unfold ClosedUnary
    exact negatives
  . unfold ClosedBinary
    exact sums
  . unfold ClosedBinary
    exact products

theorem Subring.of_projections (R S : Set)
  requires subring : IsSubring(R.carrier, R.add, R.zero, R.neg, R.mul, R.one, S)
  shows Subring(R, S)
proof
  obtain ⟨bounded, zeroIn, oneIn, negatives, sums, products⟩ := subring
  unfold ClosedUnary at negatives
  unfold ClosedBinary at sums
  unfold ClosedBinary at products
  unfold Subring.Subring
  exact ⟨bounded, zeroIn, oneIn, negatives, sums, products⟩

theorem Subring.of_parts (A add zero neg mul one S : Set)
  requires subring : IsSubring(A, add, zero, neg, mul, one, S)
  shows Subring(Ring.mk(A, add, zero, neg, mul, one), S)
proof
  have shifted : IsSubring(Ring.carrier(Ring.mk(A, add, zero, neg, mul, one)),
      Ring.add(Ring.mk(A, add, zero, neg, mul, one)),
      Ring.zero(Ring.mk(A, add, zero, neg, mul, one)),
      Ring.neg(Ring.mk(A, add, zero, neg, mul, one)),
      Ring.mul(Ring.mk(A, add, zero, neg, mul, one)),
      Ring.one(Ring.mk(A, add, zero, neg, mul, one)), S)
    ring_projections
  exact Subring.of_projections with shifted

section SubringLaws
variable (R S : Set)
hypothesis subring : Subring(R, S)

theorem Subring.subset
  shows S ⊆ R.carrier
proof
  obtain ⟨bounded, rest⟩ := subring
  exact bounded

-- Closure: the carrier membership of an element is a typing rule, and the
-- memberships of the constants and of compound terms are instances.
theorem Subring.mem_carrier (x : S)
  shows x ∈ R.carrier
proof
  have bounded := Subring.subset with subring
  have xIn : x ∈ S by assumption
  exact bounded with x, xIn

instance Subring.zero_mem
  shows R[0] ∈ S
proof
  obtain ⟨bounded, zeroIn, rest⟩ := subring
  exact zeroIn

instance Subring.one_mem
  shows R[1] ∈ S
proof
  obtain ⟨bounded, zeroIn, oneIn, rest⟩ := subring
  exact oneIn

instance Subring.neg_mem (x : S)
  shows -x ∈ S
proof
  obtain ⟨bounded, zeroIn, oneIn, negatives, sums, products⟩ := subring
  have xIn : x ∈ S by assumption
  exact negatives with x, xIn

instance Subring.add_mem (x y : S)
  shows x + y ∈ S
proof
  obtain ⟨bounded, zeroIn, oneIn, negatives, sums, products⟩ := subring
  have xIn : x ∈ S by assumption
  have yIn : y ∈ S by assumption
  exact sums with x, xIn, y, yIn

instance Subring.mul_mem (x y : S)
  shows x * y ∈ S
proof
  obtain ⟨bounded, zeroIn, oneIn, negatives, sums, products⟩ := subring
  have xIn : x ∈ S by assumption
  have yIn : y ∈ S by assumption
  exact products with x, xIn, y, yIn

end SubringLaws

section SubringSubtraction
variable (R S : Set)
hypothesis ring : Ring(R)
hypothesis subring : Subring(R, S)

instance Subring.sub_mem (x y : S)
  shows x - y ∈ S
proof
  have xIn : x ∈ R := Subring.mem_carrier with *
  have yIn : y ∈ R := Subring.mem_carrier with *
  have negIn : -y ∈ S := Subring.neg_mem with *
  rw Ring.sub.value
  exact Subring.add_mem with *

end SubringSubtraction

section SubringConstructions
variable (R : Set)
hypothesis ring : Ring(R)

-- The constructor, and the whole ring as a subring of itself.
theorem Subring.mk (S : Set)
  requires bounded : S ⊆ R
  requires zeroIn : R[0] ∈ S
  requires oneIn : R[1] ∈ S
  requires negatives : ∀ x ∈ S, -x ∈ S
  requires sums : ∀ x y ∈ S, x + y ∈ S
  requires products : ∀ x y ∈ S, x * y ∈ S
  shows Subring(R, S)
proof
  unfold Subring.Subring
  exact ⟨bounded, zeroIn, oneIn, negatives, sums, products⟩

theorem Subring.whole
  shows Subring(R, R.carrier)
proof
  have reflexive := Subset.reflexive at R.carrier
  have zeroIn : R[0] ∈ R := Ring.zero_mem with *
  have oneIn : R[1] ∈ R := Ring.one_mem with *
  apply Subring.mk with ring, reflexive, zeroIn, oneIn
  . intros x hx
    exact Ring.neg_mem with *
  . intros x hx y hy
    exact Ring.add_mem with *
  . intros x hx y hy
    exact Ring.mul_mem with *

end SubringConstructions

-- The ring on a subring: the operations of R restricted to S, with the
-- same zero and one.
def subringRing (R S : Set) : Set :=
  Ring.mk(S, restrict(R.add, S × S), R.zero, restrict(R.neg, S),
    restrict(R.mul, S × S), R.one)

theorem subringRing.carrierOf (R S : Set)
  shows Ring.carrier(subringRing(R, S)) = S
proof
  simp [subringRing, Ring.mk.carrier]

section SubringRings
variable (R S : Set)
hypothesis comm : CommRing(R)
hypothesis subring : Subring(R, S)

theorem subringRing.comm_ring
  shows CommRing(subringRing(R, S))
proof
  have parts := CommRing.parts with comm
  have subParts := Subring.parts with subring
  have engine := IsSubring.comm_ring with parts, subParts
  unfold subringRing
  exact CommRing.of_parts with engine

-- The inclusion is an injective homomorphism.
theorem Subring.inclusion
  shows identity(S) : subringRing(R, S) →+* R
proof
  have parts := CommRing.parts with comm
  have subParts := Subring.parts with subring
  have engine := IsSubring.inclusion_hom with parts, subParts
  have smaller := subringRing.comm_ring with comm, subring
  have shifted : IsRingHom(identity(S), Ring.carrier(subringRing(R, S)),
      Ring.add(subringRing(R, S)), Ring.zero(subringRing(R, S)),
      Ring.neg(subringRing(R, S)), Ring.mul(subringRing(R, S)),
      Ring.one(subringRing(R, S)), R.carrier, R.add, R.zero, R.neg, R.mul,
      R.one)
    unfold subringRing
    ring_projections
  exact RingHom.of_projections with (CommRing.to_ring with smaller),
    (CommRing.to_ring with comm), shifted

end SubringRings
