module Grace.Cumulus.Algebra.Ring.GeneratedSubring
import Subring

def generatedSubring (A add zero neg mul one G : Set) : Set :=
  {x ∈ A | ∀ S, IsSubring(A, add, zero, neg, mul, one, S) → G ⊆ S → x ∈ S}

notation scoped generatedSubring(R, G) => generatedSubring(R.carrier, R.add, R.zero, R.neg, R.mul, R.one, G)

section Generation
variable (A add zero neg mul one : Set)
notation ring R := (A, add, zero, neg, mul, one)
hypothesis ring : IsCommRing(R)

theorem generatedSubring.membership (G x : Set)
  shows x ∈ generatedSubring(A, add, zero, neg, mul, one, G) ↔ x ∈ R ∧ (∀ S, IsSubring(R, S) → G ⊆ S → x ∈ S)
proof
  simp

theorem generatedSubring.subset (G : Set)
  shows generatedSubring(A, add, zero, neg, mul, one, G) ⊆ R
proof
  simp

theorem generatedSubring.contains (G : Set)
  requires bounded : G ⊆ R
  shows G ⊆ generatedSubring(A, add, zero, neg, mul, one, G)
proof
  intros x hx
  apply generatedSubring.membership.backward with ring
  constructor
  . exact bounded with x, hx
  . intros S subring included
    exact included with x, hx

theorem generatedSubring.least (G S : Set)
  requires subring : IsSubring(R, S)
  requires included : G ⊆ S
  shows generatedSubring(A, add, zero, neg, mul, one, G) ⊆ S
proof
  intros x hx
  have data := generatedSubring.membership.forward with *
  exact data.right with S, subring, included

theorem generatedSubring.subring (G : Set)
  shows IsSubring(R, generatedSubring(A, add, zero, neg, mul, one, G))
proof
  have ordinary := IsCommRing.ring with ring
  have multiplicative := IsRing.multiplicative with ordinary
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have oneIn := IsMonoid.unit_in_carrier with multiplicative
  have bounded := generatedSubring.subset at A, add, zero, neg, mul, one, G with *
  have zeroMember : zero ∈ generatedSubring(A, add, zero, neg, mul, one, G)
    apply generatedSubring.membership.backward with ring
    refine ⟨zeroIn, ?_⟩
    intros S subring included
    exact IsSubring.zero_closed with subring
  have oneMember : one ∈ generatedSubring(A, add, zero, neg, mul, one, G)
    apply generatedSubring.membership.backward with ring
    refine ⟨oneIn, ?_⟩
    intros S subring included
    exact IsSubring.one_closed with subring
  have negative : ClosedUnary(generatedSubring(A, add, zero, neg, mul, one, G), neg)
    intros x hx
    have data := generatedSubring.membership.forward with hx
    have closed := IsRing.neg_closed with ordinary, data.left
    apply generatedSubring.membership.backward with ring
    refine ⟨closed, ?_⟩
    intros S subring included
    have member := data.right with S, subring, included
    have closure := IsSubring.neg_closed with subring
    exact ClosedUnary.mem with closure, member
  have addition : ClosedBinary(generatedSubring(A, add, zero, neg, mul, one, G), add)
    intros x hx y hy
    have first := generatedSubring.membership.forward with hx
    have second := generatedSubring.membership.forward with hy
    have closed := IsRing.add_closed with ordinary, first.left, second.left
    apply generatedSubring.membership.backward with ring
    refine ⟨closed, ?_⟩
    intros S subring included
    have xIn := first.right with S, subring, included
    have yIn := second.right with S, subring, included
    have closure := IsSubring.add_closed with subring
    exact ClosedBinary.mem with closure, xIn, yIn
  have multiplication : ClosedBinary(generatedSubring(A, add, zero, neg, mul, one, G), mul)
    intros x hx y hy
    have first := generatedSubring.membership.forward with hx
    have second := generatedSubring.membership.forward with hy
    have closed := IsRing.mul_closed with ordinary, first.left, second.left
    apply generatedSubring.membership.backward with ring
    refine ⟨closed, ?_⟩
    intros S subring included
    have xIn := first.right with S, subring, included
    have yIn := second.right with S, subring, included
    have closure := IsSubring.mul_closed with subring
    exact ClosedBinary.mem with closure, xIn, yIn
  unfold IsSubring
  refine ⟨bounded, zeroMember, oneMember, negative, addition, multiplication⟩

theorem generatedSubring.mono (G H : Set)
  requires included : G ⊆ H
  shows generatedSubring(A, add, zero, neg, mul, one, G) ⊆ generatedSubring(A, add, zero, neg, mul, one, H)
proof
  intros x hx
  have data := generatedSubring.membership.forward with *
  apply generatedSubring.membership.backward with ring
  refine ⟨data.left, ?_⟩
  intros S subring containsH
  have containsG : G ⊆ S
    intros y hy
    have inH := included with y, hy
    exact containsH with y, inH
  exact data.right with S, subring, containsG

theorem generatedSubring.eq_of_subring (S : Set)
  requires subring : IsSubring(R, S)
  shows generatedSubring(A, add, zero, neg, mul, one, S) = S
proof
  have bounded := IsSubring.subset_carrier with subring
  have includes := generatedSubring.contains with *
  have reflexive : S ⊆ S by simp [Subset]
  have least := generatedSubring.least with *
  exact Subset.antisymmetric with least, includes

theorem generatedSubring.idempotent (G : Set)
  shows generatedSubring(A, add, zero, neg, mul, one, generatedSubring(A, add, zero, neg, mul, one, G)) = generatedSubring(A, add, zero, neg, mul, one, G)
proof
  have subring := generatedSubring.subring at A, add, zero, neg, mul, one, G with *
  exact generatedSubring.eq_of_subring with *

end Generation
