module Grace.Cumulus.Algebra.Ring.DeterminantCancellation
import Determinant
import Cancellation
import Cardinal.PermutationExchange

section Determinants
variable (A add zero neg mul one M : Set)
notation ring R := (A, add, zero, neg, mul, one)
hypothesis ring : IsCommRing(R)

-- This isolates the combinatorial input to determinant cancellation. In the
-- repeated-row application, t will exchange those two row positions.
theorem determinant.cancel_pairs (n : Nat) (t : Set)
  requires matrix : RingMatrix(n, R, M)
  requires involution : InvolutionOn(t, permutations(n))
  requires free : ∀ p ∈ permutations(n), t(p) ≠ p
  requires signs : ∀ p ∈ permutations(n), permutationSign(n, A, add, zero, neg, mul, one, t(p)) = R[-permutationSign(n, A, add, zero, neg, mul, one, p)]
  requires products : ∀ p ∈ permutations(n), finiteRingProduct(n, A, add, zero, neg, mul, one, permutationEntries(n, A, M, t(p))) = finiteRingProduct(n, A, add, zero, neg, mul, one, permutationEntries(n, A, M, p))
  shows determinant(n, R, M) = R[0]
proof
  have finite := Finite.natural with *
  have finitePermutations := permutations.finite with finite
  have weights := determinantTerms.function at n, A, add, zero, neg, mul, one, M with *
  have function := InvolutionOn.function with involution
  have opposite : ∀ p ∈ permutations(n), determinantTerms(n, A, add, zero, neg, mul, one, M)(t(p)) = R[-determinantTerms(n, A, add, zero, neg, mul, one, M)(p)]
    intros p member
    have paired := FunctionBetween.apply_closed with function, member
    have permutation := permutations.mem_iff.forward with member
    have entries := permutationEntries.function at n, A, M, p with *
    have product := finiteRingProduct.closed with ring, finite, entries
    have sign := permutationSign.closed at A, add, zero, neg, mul, one, n, p with *
    have first := determinantTerms.value at n, A, add, zero, neg, mul, one, M, p with *
    have second := determinantTerms.value at n, A, add, zero, neg, mul, one, M, t(p) with *
    have changedSign := signs with p, member
    have sameProduct := products with p, member
    rw [first, second, changedSign, sameProduct]
    ring
  unfold determinant
  exact finiteRingSum.involution_free with *

-- Equal rows preserve the product in each paired Leibniz term. The equality
-- comes from reindexing the finite product; no ordering of factors is used.
theorem permutationEntries.exchange_product (n : Nat) (a b p : Set)
  requires matrix : RingMatrix(n, R, M)
  requires ha : a ∈ n
  requires hb : b ∈ n
  requires permutation : p ∈ permutations(n)
  requires rows : ∀ j ∈ n, M[a, j] = M[b, j]
  shows finiteRingProduct(n, A, add, zero, neg, mul, one, permutationEntries(n, A, M, permutationExchange(n, a, b)(p))) =
    finiteRingProduct(n, A, add, zero, neg, mul, one, permutationEntries(n, A, M, p))
proof
  have exchange := permutationExchange.function at n, a, b with *
  have paired := FunctionBetween.apply_closed with exchange, permutation
  have originalBijective := permutations.mem_iff.forward with permutation
  have pairedBijective := permutations.mem_iff.forward with paired
  have injective := Bijective.injective with originalBijective
  have function := Injective.function with injective
  have originalWeights := permutationEntries.function at n, A, M, p with *
  have pairedWeights := permutationEntries.function at n, A, M, permutationExchange(n, a, b)(p) with *
  have swap := transposition.bijective at n, a, b with *
  have swapFunction := transposition.function at n, a, b with *
  have atFirst := transposition.first at n, a, b with *
  have atSecond := transposition.second at n, a, b with *
  have values : ∀ i ∈ n, permutationEntries(n, A, M, permutationExchange(n, a, b)(p))(i) = permutationEntries(n, A, M, p)(transposition(n, a, b)(i))
    intros i index
    have swappedIndex := FunctionBetween.apply_closed with swapFunction, index
    have column := FunctionBetween.apply_closed with function, swappedIndex
    have firstValue := permutationEntries.value at n, A, M, permutationExchange(n, a, b)(p), i with *
    have secondValue := permutationEntries.value at n, A, M, p, transposition(n, a, b)(i) with *
    have exchanged := permutationExchange.apply at n, a, b, p, i with *
    have rowEquality := rows with p(transposition(n, a, b)(i)), column
    have alternatives : i = a ∨ i = b ∨ (i ≠ a ∧ i ≠ b) by tauto
    cases alternatives with same | remaining
    . cc
    . cases remaining with same | outside
      . cc
      . have unchanged := transposition.other with ha, hb, index, outside.left, outside.right
        cc
  exact finiteRingProduct.reindex with ring, pairedWeights, originalWeights, swap, values

-- The only remaining combinatorial premise is the inversion-count sign law.
-- This conditional result is not an unconditional equal-rows theorem.
theorem determinant.equal_rows_of_exchange_sign (n : Nat) (a b : Set)
  requires matrix : RingMatrix(n, R, M)
  requires ha : a ∈ n
  requires hb : b ∈ n
  requires distinct : a ≠ b
  requires rows : ∀ j ∈ n, M[a, j] = M[b, j]
  requires signs : ∀ p ∈ permutations(n), permutationSign(n, A, add, zero, neg, mul, one, permutationExchange(n, a, b)(p)) = R[-permutationSign(n, A, add, zero, neg, mul, one, p)]
  shows determinant(n, R, M) = R[0]
proof
  have involution := permutationExchange.involution at n, a, b with *
  have free : ∀ p ∈ permutations(n), permutationExchange(n, a, b)(p) ≠ p
    intros p member
    exact permutationExchange.free with *
  have products : ∀ p ∈ permutations(n), finiteRingProduct(n, A, add, zero, neg, mul, one, permutationEntries(n, A, M, permutationExchange(n, a, b)(p))) = finiteRingProduct(n, A, add, zero, neg, mul, one, permutationEntries(n, A, M, p))
    intros p member
    exact permutationEntries.exchange_product with *
  exact determinant.cancel_pairs with *

end Determinants
