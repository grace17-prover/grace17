module Grace.Cumulus.Algebra.Ring.PushforwardComposition
import Regrouping

section Grouping
variable (D C B A add zero neg mul one h k w : Set)
hypothesis ring : IsCommRing(A, add, zero, neg, mul, one)
hypothesis finiteD : Finite(D)
hypothesis weights : w : D → A
hypothesis firstMap : h : D → C
hypothesis secondMap : k : C → B

-- Pointwise filtering can move across the first grouping operation.
theorem finitePushforward.filter_composition (b : Set)
  shows finitePushforward(D, C, A, add, zero, neg, mul, one, h,
    pushforwardWeights(D, A, add, zero, neg, mul, one, compose(k, h, D, C, B), w, b)) =
    pushforwardWeights(C, A, add, zero, neg, mul, one, k,
      finitePushforward(D, C, A, add, zero, neg, mul, one, h, w), b)
proof
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have filtered := pushforwardWeights.function at D, A, add, zero, neg, mul, one, compose(k, h, D, C, B), w, b with *
  have grouped := finitePushforward.function at D, C, A, add, zero, neg, mul, one, h, w with *
  have leftFunction := finitePushforward.function at D, C, A, add, zero, neg, mul, one, h, pushforwardWeights(D, A, add, zero, neg, mul, one, compose(k, h, D, C, B), w, b) with *
  have rightFunction := pushforwardWeights.function at C, A, add, zero, neg, mul, one, k, finitePushforward(D, C, A, add, zero, neg, mul, one, h, w), b with *
  apply FunctionBetween.ext with leftFunction, rightFunction
  intros c hc
  have rowW := pushforwardWeights.function at D, A, add, zero, neg, mul, one, h, w, c with *
  have rowV := pushforwardWeights.function at D, A, add, zero, neg, mul, one, h, pushforwardWeights(D, A, add, zero, neg, mul, one, compose(k, h, D, C, B), w, b), c with *
  have entries : ∀ d ∈ D,
    pushforwardWeights(D, A, add, zero, neg, mul, one, h, pushforwardWeights(D, A, add, zero, neg, mul, one, compose(k, h, D, C, B), w, b), c)(d) =
    singleValue(A, zero, pushforwardWeights(D, A, add, zero, neg, mul, one, h, w, c)(d), k(c), b)
    intros d hd
    have coefficient := FunctionBetween.apply_closed at w, D, A, d with *
    have composite := compose.apply at k, h, D, C, B, d with *
    have selected := pushforwardWeights.value at D, A, add, zero, neg, mul, one, compose(k, h, D, C, B), w, b, d with *
    have left := pushforwardWeights.value at D, A, add, zero, neg, mul, one, h, pushforwardWeights(D, A, add, zero, neg, mul, one, compose(k, h, D, C, B), w, b), c, d with *
    have row := pushforwardWeights.value at D, A, add, zero, neg, mul, one, h, w, c, d with *
    have iteration := singleValue.iterated at A, zero, w(d), k, h(d), c, b with *
    cc
  have selection := finiteRingSum.select with *
  have left := finitePushforward.value at D, C, A, add, zero, neg, mul, one, h, pushforwardWeights(D, A, add, zero, neg, mul, one, compose(k, h, D, C, B), w, b), c with *
  have row := finitePushforward.value at D, C, A, add, zero, neg, mul, one, h, w, c with *
  have right := pushforwardWeights.value at C, A, add, zero, neg, mul, one, k, finitePushforward(D, C, A, add, zero, neg, mul, one, h, w), b, c with *
  cc

theorem finitePushforward.compose
  requires finiteC : Finite(C)
  shows finitePushforward(C, B, A, add, zero, neg, mul, one, k,
    finitePushforward(D, C, A, add, zero, neg, mul, one, h, w)) =
    finitePushforward(D, B, A, add, zero, neg, mul, one, compose(k, h, D, C, B), w)
proof
  have grouped := finitePushforward.function at D, C, A, add, zero, neg, mul, one, h, w with *
  have leftFunction := finitePushforward.function at C, B, A, add, zero, neg, mul, one, k, finitePushforward(D, C, A, add, zero, neg, mul, one, h, w) with *
  have rightFunction := finitePushforward.function at D, B, A, add, zero, neg, mul, one, compose(k, h, D, C, B), w with *
  apply FunctionBetween.ext with leftFunction, rightFunction
  intros b hb
  have filtered := pushforwardWeights.function at D, A, add, zero, neg, mul, one, compose(k, h, D, C, B), w, b with *
  have commuted := finitePushforward.filter_composition at D, C, B, A, add, zero, neg, mul, one, h, k, w, b with *
  have regrouped := finitePushforward.sum at D, C, A, add, zero, neg, mul, one, h, pushforwardWeights(D, A, add, zero, neg, mul, one, compose(k, h, D, C, B), w, b) with *
  have left := finitePushforward.value at C, B, A, add, zero, neg, mul, one, k, finitePushforward(D, C, A, add, zero, neg, mul, one, h, w), b with *
  have right := finitePushforward.value at D, B, A, add, zero, neg, mul, one, compose(k, h, D, C, B), w, b with *
  cc

end Grouping
theorem finitePushforward.identity (D A add zero neg mul one w : Set)
  requires ring : IsCommRing(A, add, zero, neg, mul, one)
  requires finite : Finite(D)
  requires weights : w : D → A
  shows finitePushforward(D, D, A, add, zero, neg, mul, one, identity(D), w) = w
proof
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have grouped := finitePushforward.function at D, D, A, add, zero, neg, mul, one, identity(D), w with *
  apply FunctionBetween.ext with grouped, weights
  intros b hb
  have coefficient := FunctionBetween.apply_closed at w, D, A, b with *
  have selected := pushforwardWeights.function at D, A, add, zero, neg, mul, one, identity(D), w, b with *
  have single := coefficientSingle.function at D, A, zero, w(b), b with *
  have equal : pushforwardWeights(D, A, add, zero, neg, mul, one, identity(D), w, b) = coefficientSingle(D, A, zero, w(b), b)
    apply FunctionBetween.ext with selected, single
    intros d hd
    have coefficientD := FunctionBetween.apply_closed at w, D, A, d with *
    have id := identity.apply at d, D with *
    have left := pushforwardWeights.value at D, A, add, zero, neg, mul, one, identity(D), w, b, d with *
    have right := coefficientSingle.value at D, A, zero, w(b), b, d with *
    have alternatives : d = b ∨ d ≠ b by tauto
    cases alternatives with same | different
    . cc
    . have reversed : b ≠ d
        intro equal
        have reverseEqual : d = b
          symm
          exact equal
        exact different with reverseEqual
      have leftZero := singleValue.other at A, zero, w(d), d, b with *
      have rightZero := singleValue.other at A, zero, w(b), b, d with *
      cc
  have sum := finiteRingSum.single at D, A, add, zero, neg, mul, one, w(b), b with *
  have value := finitePushforward.value at D, D, A, add, zero, neg, mul, one, identity(D), w, b with *
  cc

theorem finitePushforward.index_congr (D C A add zero neg mul one h k w : Set)
  requires ring : IsCommRing(A, add, zero, neg, mul, one)
  requires finite : Finite(D)
  requires weights : w : D → A
  requires indices : ∀ d ∈ D, h(d) = k(d)
  shows finitePushforward(D, C, A, add, zero, neg, mul, one, h, w) = finitePushforward(D, C, A, add, zero, neg, mul, one, k, w)
proof
  have leftFunction := finitePushforward.function at D, C, A, add, zero, neg, mul, one, h, w with *
  have rightFunction := finitePushforward.function at D, C, A, add, zero, neg, mul, one, k, w with *
  apply FunctionBetween.ext with leftFunction, rightFunction
  intros c hc
  have leftWeights := pushforwardWeights.function at D, A, add, zero, neg, mul, one, h, w, c with *
  have rightWeights := pushforwardWeights.function at D, A, add, zero, neg, mul, one, k, w, c with *
  have equal : pushforwardWeights(D, A, add, zero, neg, mul, one, h, w, c) = pushforwardWeights(D, A, add, zero, neg, mul, one, k, w, c)
    apply FunctionBetween.ext with leftWeights, rightWeights
    intros d hd
    have index := indices with d, hd
    have left := pushforwardWeights.value at D, A, add, zero, neg, mul, one, h, w, c, d with *
    have right := pushforwardWeights.value at D, A, add, zero, neg, mul, one, k, w, c, d with *
    cc
  have left := finitePushforward.value at D, C, A, add, zero, neg, mul, one, h, w, c with *
  have right := finitePushforward.value at D, C, A, add, zero, neg, mul, one, k, w, c with *
  cc
