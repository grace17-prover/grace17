module Grace.Cumulus.Algebra.Ring.FiniteDoubleSum
import DoubleSum

defgraph finiteRowWeights (D E A w x : Set) (y ∈ E) : A := w((x, y))
requires matrix : w : D × E → A
requires row : x ∈ D
proof
  have pair := product.pair at x, y, D, E with *
  exact FunctionBetween.apply_closed at w, D × E, A, (x, y) with *

defgraph finiteRowSums (D E A add zero neg mul one w : Set) (x ∈ D) : A :=
  finiteRingSum(E, A, add, zero, neg, mul, one, finiteRowWeights(D, E, A, w, x))
requires ring : IsCommRing(A, add, zero, neg, mul, one)
requires finiteE : Finite(E)
requires matrix : w : D × E → A
proof
  have weights := finiteRowWeights.function at D, E, A, w, x with *
  exact finiteRingSum.closed at E, A, add, zero, neg, mul, one, finiteRowWeights(D, E, A, w, x) with *

def finiteDoubleSum (D E A add zero neg mul one w : Set) : Set :=
  finiteRingSum(D, A, add, zero, neg, mul, one, finiteRowSums(D, E, A, add, zero, neg, mul, one, w))

defgraph enumeratedMatrix (m n D E A w f g : Set) (p ∈ m × n) : A :=
  w(productMap(f, g, m, n, D, E)(p))
requires matrix : w : D × E → A
requires rows : f : m → D
requires columns : g : n → E
proof
  have rectangle := productMap.function with rows, columns
  have pair := FunctionBetween.apply_closed at productMap(f, g, m, n, D, E), m × n, D × E, p with *
  exact FunctionBetween.apply_closed at w, D × E, A, productMap(f, g, m, n, D, E)(p) with *

theorem enumeratedMatrix.pair (m n D E A w f g i j : Set)
  requires matrix : w : D × E → A
  requires rows : f : m → D
  requires columns : g : n → E
  requires row : i ∈ m
  requires column : j ∈ n
  shows enumeratedMatrix(m, n, D, E, A, w, f, g)((i, j)) = w((f(i), g(j)))
proof
  have pair := product.pair at i, j, m, n with *
  have value := enumeratedMatrix.value at m, n, D, E, A, w, f, g, (i, j) with *
  have mapped := productMap.apply at f, g, m, n, D, E, i, j with *
  cc

theorem ringRowSum.as_indexed (w v f add zero x : Set, n : Nat)
  shows (∀ j ∈ n, w((x, j)) = v(f(j))) →
    ringRowSum(w, add, zero, x, n) = indexedRingSum(v, f, add, zero, n)
proof
  induction n
  | zero =>
    intro values
    simp [ringRowSum, indexedRingSum]
  | succ(k) using ih =>
    intro values
    have prefix : ∀ j ∈ k, w((x, j)) = v(f(j))
      intros j hj
      have included := membership.into_successor at j, k with *
      exact values with j, included
    have last := values with k, membership.self_successor at k with *
    have previous := ih with prefix
    rw [ringRowSum, indexedRingSum, previous, last]
    rfl

theorem ringDoubleSum.as_indexed (w v f add zero : Set, m n : Nat)
  shows (∀ i ∈ m, ringRowSum(w, add, zero, i, n) = v(f(i))) →
    ringDoubleSum(w, add, zero, m, n) = indexedRingSum(v, f, add, zero, m)
proof
  induction m
  | zero =>
    intro values
    simp [ringDoubleSum, indexedRingSum]
  | succ(k) using ih =>
    intro values
    have prefix : ∀ i ∈ k, ringRowSum(w, add, zero, i, n) = v(f(i))
      intros i hi
      have included := membership.into_successor at i, k with *
      exact values with i, included
    have last := values with k, membership.self_successor at k with *
    have previous := ih with prefix
    rw [ringDoubleSum, indexedRingSum, previous, last]
    rfl

theorem finiteDoubleSum.closed (D E A add zero neg mul one w : Set)
  requires ring : IsCommRing(A, add, zero, neg, mul, one)
  requires finiteD : Finite(D)
  requires finiteE : Finite(E)
  requires matrix : w : D × E → A
  shows finiteDoubleSum(D, E, A, add, zero, neg, mul, one, w) ∈ A
proof
  have rows := finiteRowSums.function at D, E, A, add, zero, neg, mul, one, w with *
  unfold finiteDoubleSum
  exact finiteRingSum.closed with *

theorem finiteDoubleSum.enumerations (D E A add zero neg mul one w f g : Set, m n : Nat)
  requires ring : IsCommRing(A, add, zero, neg, mul, one)
  requires finiteE : Finite(E)
  requires matrix : w : D × E → A
  requires enumD : BijectiveBetween(f, m, D)
  requires enumE : BijectiveBetween(g, n, E)
  shows finiteDoubleSum(D, E, A, add, zero, neg, mul, one, w) = ringDoubleSum(enumeratedMatrix(m, n, D, E, A, w, f, g), add, zero, m, n)
proof
  have injD := Bijective.injective with enumD
  have injE := Bijective.injective with enumE
  have rows := Injective.function with injD
  have columns := Injective.function with injE
  have rowSums := finiteRowSums.function at D, E, A, add, zero, neg, mul, one, w with *
  have outer := finiteRingSum.enumeration at D, A, add, zero, neg, mul, one, finiteRowSums(D, E, A, add, zero, neg, mul, one, w), f, m with *
  have rowValues : ∀ i ∈ m, ringRowSum(enumeratedMatrix(m, n, D, E, A, w, f, g), add, zero, i, n) = finiteRowSums(D, E, A, add, zero, neg, mul, one, w)(f(i))
    intros i hi
    have row := FunctionBetween.apply_closed at f, m, D, i with *
    have weights := finiteRowWeights.function at D, E, A, w, f(i) with *
    have inner := finiteRingSum.enumeration at E, A, add, zero, neg, mul, one, finiteRowWeights(D, E, A, w, f(i)), g, n with *
    have values : ∀ j ∈ n, enumeratedMatrix(m, n, D, E, A, w, f, g)((i, j)) = finiteRowWeights(D, E, A, w, f(i))(g(j))
      intros j hj
      have column := FunctionBetween.apply_closed at g, n, E, j with *
      have left := enumeratedMatrix.pair at m, n, D, E, A, w, f, g, i, j with *
      have right := finiteRowWeights.value at D, E, A, w, f(i), g(j) with *
      cc
    have bridge := ringRowSum.as_indexed at enumeratedMatrix(m, n, D, E, A, w, f, g), finiteRowWeights(D, E, A, w, f(i)), g, add, zero, i, n with *
    have equal := bridge with values
    have value := finiteRowSums.value at D, E, A, add, zero, neg, mul, one, w, f(i) with *
    cc
  have bridge := ringDoubleSum.as_indexed at enumeratedMatrix(m, n, D, E, A, w, f, g), finiteRowSums(D, E, A, add, zero, neg, mul, one, w), f, add, zero, m, n with *
  have equal := bridge with rowValues
  unfold finiteDoubleSum
  cc

theorem finiteDoubleSum.interchange (D E A add zero neg mul one w : Set)
  requires ring : IsCommRing(A, add, zero, neg, mul, one)
  requires finiteD : Finite(D)
  requires finiteE : Finite(E)
  requires matrix : w : D × E → A
  shows finiteDoubleSum(D, E, A, add, zero, neg, mul, one, w) =
    finiteDoubleSum(E, D, A, add, zero, neg, mul, one, transposedMatrix(D, E, A, w))
proof
  obtain ⟨m, naturalM, f, enumD⟩ := Finite.enumeration with finiteD
  obtain ⟨n, naturalN, g, enumE⟩ := Finite.enumeration with finiteE
  have injD := Bijective.injective with enumD
  have injE := Bijective.injective with enumE
  have rows := Injective.function with injD
  have columns := Injective.function with injE
  have transposed := transposedMatrix.function at D, E, A, w with *
  have first := enumeratedMatrix.function at m, n, D, E, A, w, f, g with *
  have second := enumeratedMatrix.function at n, m, E, D, A, transposedMatrix(D, E, A, w), g, f with *
  have valuesW := RingMatrixValues.of_function with first
  have valuesV := RingMatrixValues.of_function with second
  have entries : TransposedValues(enumeratedMatrix(m, n, D, E, A, w, f, g), enumeratedMatrix(n, m, E, D, A, transposedMatrix(D, E, A, w), g, f), m, n)
    intros i hi j hj
    have row := FunctionBetween.apply_closed at f, m, D, i with *
    have column := FunctionBetween.apply_closed at g, n, E, j with *
    have left := enumeratedMatrix.pair at m, n, D, E, A, w, f, g, i, j with *
    have right := enumeratedMatrix.pair at n, m, E, D, A, transposedMatrix(D, E, A, w), g, f, j, i with *
    have entry := transposedMatrix.pair at D, E, A, w, f(i), g(j) with *
    cc
  have interchange := ringDoubleSum.transpose at A, add, zero, neg, mul, one, enumeratedMatrix(m, n, D, E, A, w, f, g), enumeratedMatrix(n, m, E, D, A, transposedMatrix(D, E, A, w), g, f), m, n with *
  have equal := interchange with valuesW, valuesV, entries
  have left := finiteDoubleSum.enumerations at D, E, A, add, zero, neg, mul, one, w, f, g, m, n with *
  have right := finiteDoubleSum.enumerations at E, D, A, add, zero, neg, mul, one, transposedMatrix(D, E, A, w), g, f, n, m with *
  cc
