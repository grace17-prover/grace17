module Grace.Cumulus.Algebra.Ring.DeterminantHom
import Determinant
import FiniteHom

-- Entrywise mapping is useful independently of ring structure.
defgraph matrixMap (I A B h M : Set) (p ∈ I × I) : B := h(M(p))
requires matrix : RingMatrix(I, A, M)
requires function : h : A → B
proof
  unfold RingMatrix at matrix
  have entry := FunctionBetween.apply_closed at M, I × I, A, p with *
  exact FunctionBetween.apply_closed at h, A, B, M(p) with *

theorem matrixMap.matrix (I A B h M : Set)
  requires matrix : RingMatrix(I, A, M)
  requires function : h : A → B
  shows RingMatrix(I, B, matrixMap(I, A, B, h, M))
proof
  unfold RingMatrix
  exact matrixMap.function with *

theorem matrixMap.entry (I A B h M i j : Set)
  requires matrix : RingMatrix(I, A, M)
  requires function : h : A → B
  requires row : i ∈ I
  requires column : j ∈ I
  shows matrixMap(I, A, B, h, M)[i, j] = h(M[i, j])
proof
  have pair := product.pair at i, j, I, I with *
  exact matrixMap.value with *

section Homomorphisms
variable (A add zero neg mul one B plus z minus times unit h : Set)
notation ring R := (A, add, zero, neg, mul, one)
notation ring S := (B, plus, z, minus, times, unit)
hypothesis source : IsCommRing(R)
hypothesis target : IsCommRing(S)
hypothesis hom : IsRingHom(h, R, S)

theorem permutationSign.map (I p : Set)
  requires finite : Finite(I)
  shows h(permutationSign(I, R, p)) = permutationSign(I, S, p)
proof
  have inversionsFinite := inversions.finite at I, p with *
  have count := cardinality.correct with inversionsFinite
  have natural := count.left
  have ordinary := IsCommRing.ring with source
  have multiplicative := IsRing.multiplicative with ordinary
  have oneIn := IsMonoid.unit_in_carrier with multiplicative
  have negative := IsRing.neg_closed with ordinary, oneIn
  have mapsOne := IsRingHom.one with hom
  have mapsNegative := IsRingHom.neg at h, A, add, zero, neg, mul, one, B, plus, z, minus, times, unit, one with *
  have power := IsRingHom.pow at A, add, zero, neg, mul, one, B, plus, z, minus, times, unit, h, R[-1], cardinality(inversions(I, p)) with *
  simp [permutationSign]

theorem determinant.map (n : Nat) (M N : Set)
  requires matrixM : RingMatrix(n, R, M)
  requires matrixN : RingMatrix(n, S, N)
  requires entries : ∀ i ∈ n, ∀ j ∈ n, N[i, j] = h(M[i, j])
  shows h(determinant(n, R, M)) = determinant(n, S, N)
proof
  have finite := Finite.natural at n with *
  have permutationsFinite := permutations.finite with finite
  have weightsM := determinantTerms.function at n, A, add, zero, neg, mul, one, M with *
  have weightsN := determinantTerms.function at n, B, plus, z, minus, times, unit, N with *
  have terms : ∀ p ∈ permutations(n), determinantTerms(n, S, N)(p) = h(determinantTerms(n, R, M)(p))
    intros p hp
    have permutation := permutations.mem_iff.forward with hp
    have injective := Bijective.injective with permutation
    have function := Injective.function with injective
    have entriesM := permutationEntries.function at n, A, M, p with *
    have entriesN := permutationEntries.function at n, B, N, p with *
    have pointwise : ∀ i ∈ n, permutationEntries(n, B, N, p)(i) = h(permutationEntries(n, A, M, p)(i))
      intros i hi
      have column := FunctionBetween.apply_closed at p, n, n, i with *
      have left := permutationEntries.value at n, B, N, p, i with *
      have right := permutationEntries.value at n, A, M, p, i with *
      rw [left, right]
      exact entries with i, hi, p(i), column
    have product := finiteRingProduct.map at A, add, zero, neg, mul, one, B, plus, z, minus, times, unit, h, n, permutationEntries(n, A, M, p), permutationEntries(n, B, N, p) with *
    have sign := permutationSign.map at A, add, zero, neg, mul, one, B, plus, z, minus, times, unit, h, n, p with *
    have multiply := IsRingHom.mul at h, A, add, zero, neg, mul, one, B, plus, z, minus, times, unit, permutationSign(n, R, p), finiteRingProduct(n, R, permutationEntries(n, A, M, p)) with *
    have termM := determinantTerms.value at n, A, add, zero, neg, mul, one, M, p with *
    have termN := determinantTerms.value at n, B, plus, z, minus, times, unit, N, p with *
    rw [termM, termN, multiply, sign, product]
    rfl
  unfold determinant
  exact finiteRingSum.map at A, add, zero, neg, mul, one, B, plus, z, minus, times, unit, h, permutations(n), determinantTerms(n, R, M), determinantTerms(n, S, N) with *

theorem determinant.map_matrix (n : Nat) (M : Set)
  requires matrix : RingMatrix(n, R, M)
  shows h(determinant(n, R, M)) = determinant(n, S, matrixMap(n, R, S, h, M))
proof
  have function := IsRingHom.function with hom
  have mapped := matrixMap.matrix with *
  have entries : ∀ i ∈ n, ∀ j ∈ n, matrixMap(n, R, S, h, M)[i, j] = h(M[i, j])
    intros i hi j hj
    exact matrixMap.entry with *
  exact determinant.map with *

end Homomorphisms
