module Grace.Cumulus.Algebra.Ring.PrimeIdealCore
import IdealCore

-- IsPrimeIdeal(A, add, zero, neg, mul, one, I) is the prime ideal over
-- separate pieces; the bundled PrimeIdeal(R, I) is defined in PrimeIdeal
-- and bridged to this form.
predicate IsPrimeIdeal (A add zero neg mul one I : Set) :=
  IsProperIdeal(A, add, zero, neg, mul, one, I) ∧
  (∀ x ∈ A, ∀ y ∈ A, call2(mul, x, y) ∈ I → x ∈ I ∨ y ∈ I)

notation scoped IsPrimeIdeal(R, I) => IsPrimeIdeal(R.carrier, R.add, R.zero, R.neg, R.mul, R.one, I)

-- The colon ideal (I : y), with its ambient carrier explicit.
def colonIdeal (A mul I y : Set) : Set := {x ∈ A | call2(mul, x, y) ∈ I}

theorem colonIdeal.contains (A add zero neg mul I y : Set)
  requires ideal : IsIdeal(A, add, zero, neg, mul, I)
  requires hy : y ∈ A
  shows I ⊆ colonIdeal(A, mul, I, y)
proof
  rcases ideal with ⟨bounded, zeroIn, sums, negatives, products⟩
  intros x hx
  have xInA := bounded with x, hx
  obtain ⟨leftProduct, rightProduct⟩ := products with y, hy, x, hx
  exact colonIdeal.membership.backward with ⟨xInA, rightProduct⟩

theorem colonIdeal.ideal (A add zero neg mul one I y : Set)
  requires commRing : IsCommRing(A, add, zero, neg, mul, one)
  requires ideal : IsIdeal(A, add, zero, neg, mul, I)
  requires hy : y ∈ A
  shows IsIdeal(A, add, zero, neg, mul, colonIdeal(A, mul, I, y))
proof
  have ring := IsCommRing.ring with commRing
  rcases ideal with ⟨boundedI, zeroIn, sums, negatives, products⟩
  constructor
  . settle with Subset, colonIdeal.membership
  . constructor
    . have zeroInA := IsRing.zero_in_carrier with ring
      have zeroProduct := IsRing.zero_mul at A, add, zero, neg, mul, one,
        y with *
      apply colonIdeal.membership.backward
      constructor
      . exact zeroInA
      . rw zeroProduct
        exact zeroIn
    . constructor
      . intros x hx z hz
        have xData := colonIdeal.membership.forward with hx
        have zData := colonIdeal.membership.forward with hz
        rcases xData with ⟨xInA, xyIn⟩
        rcases zData with ⟨zInA, zyIn⟩
        have sumInA := IsRing.add_closed at A, add, zero, neg, mul, one, x, z with *
        have sumIn := sums with call2(mul, x, y), xyIn, call2(mul, z, y), zyIn
        have distribute := IsCommRing.add_mul at A, add, zero, neg, mul, one, x, z, y with *
        apply colonIdeal.membership.backward
        constructor
        . exact sumInA
        . rw distribute
          exact sumIn
      . constructor
        . intros x hx
          obtain ⟨xInA, xyIn⟩ := colonIdeal.membership.forward with hx
          have negInA := IsRing.neg_closed with ring, xInA
          have negIn := negatives with call2(mul, x, y), xyIn
          have distribute := IsRing.neg_mul at A, add, zero, neg, mul, one, x, y with *
          apply colonIdeal.membership.backward
          constructor
          . exact negInA
          . rw distribute
            exact negIn
        . intros a ha x hx
          obtain ⟨xInA, xyIn⟩ := colonIdeal.membership.forward with hx
          have axInA := IsRing.mul_closed at A, add, zero, neg, mul, one, a, x with *
          have xaInA := IsRing.mul_closed at A, add, zero, neg, mul, one, x, a with *
          obtain ⟨leftProduct, rightProduct⟩ := products with a, ha, call2(mul, x, y), xyIn
          have associate := IsCommRing.mul_assoc at A, add, zero, neg, mul, one, a, x, y with *
          have commute := IsCommRing.mul_comm at A, add, zero, neg, mul, one, x, a with *
          constructor
          . apply colonIdeal.membership.backward at
            A, mul, I, y, call2(mul, a, x)
            constructor
            . exact axInA
            . rw associate
              exact leftProduct
          . apply colonIdeal.membership.backward at
            A, mul, I, y, call2(mul, x, a)
            constructor
            . exact xaInA
            . rw [commute, associate]
              exact leftProduct

theorem colonIdeal.proper (A add zero neg mul one I y : Set)
  requires commRing : IsCommRing(A, add, zero, neg, mul, one)
  requires ideal : IsIdeal(A, add, zero, neg, mul, I)
  requires hy : y ∈ A
  requires absent : ¬(y ∈ I)
  shows IsProperIdeal(A, add, zero, neg, mul, one, colonIdeal(A, mul, I, y))
proof
  have colon := colonIdeal.ideal with *
  have identity := IsCommRing.one_left with *
  constructor
  . exact colon
  . intro member
    obtain ⟨oneInA, productIn⟩ := colonIdeal.membership.forward with member
    rw identity at productIn
    exact absent with productIn

theorem IsMaximalIdeal.is_prime (A add zero neg mul one M : Set)
  requires commRing : IsCommRing(A, add, zero, neg, mul, one)
  requires maximal : IsMaximalIdeal(A, add, zero, neg, mul, one, M)
  shows IsPrimeIdeal(A, add, zero, neg, mul, one, M)
proof
  rcases maximal with ⟨proper, largest⟩
  have ideal : IsIdeal(A, add, zero, neg, mul, M) by simp [IsProperIdeal]
  constructor
  . exact proper
  . intros x hx y hy productIn
    have alternatives : y ∈ M ∨ ¬(y ∈ M) by tauto
    cases alternatives with yIn | yOut
    . right
      exact yIn
    . left
      have colonProper := colonIdeal.proper with *
      have contains := colonIdeal.contains with ideal, hy
      have equal := largest with colonIdeal(A, mul, M, y), colonProper, contains
      have xInColon : x ∈ colonIdeal(A, mul, M, y) := colonIdeal.membership.backward with ⟨hx, productIn⟩
      rwa equal at xInColon

theorem IsPrimeIdeal.proper (A add zero neg mul one I : Set)
  requires prime : IsPrimeIdeal(A, add, zero, neg, mul, one, I)
  shows IsProperIdeal(A, add, zero, neg, mul, one, I)
proof
  simp [IsPrimeIdeal]

theorem IsPrimeIdeal.ideal (A add zero neg mul one I : Set)
  requires h : IsPrimeIdeal(A, add, zero, neg, mul, one, I)
  shows IsIdeal(A, add, zero, neg, mul, I)
proof
  have proper := IsPrimeIdeal.proper with h
  exact proper.left

theorem IsPrimeIdeal.left_of_mul (A add zero neg mul one I x y : Set)
  requires prime : IsPrimeIdeal(A, add, zero, neg, mul, one, I)
  requires hx : x ∈ A
  requires hy : y ∈ A
  requires productIn : call2(mul, x, y) ∈ I
  requires absent : ¬(y ∈ I)
  shows x ∈ I
proof
  rcases prime with ⟨proper, factors⟩
  have alternatives := factors with x, hx, y, hy, productIn
  cases alternatives with xIn | yIn
  . exact xIn
  . exfalso
    exact absent with yIn

theorem IsPrimeIdeal.colon_eq (A add zero neg mul one I y : Set)
  requires prime : IsPrimeIdeal(A, add, zero, neg, mul, one, I)
  requires hy : y ∈ A
  requires absent : ¬(y ∈ I)
  shows colonIdeal(A, mul, I, y) = I
proof
  obtain ⟨ideal, oneOut⟩ := IsPrimeIdeal.proper with prime
  have contains := colonIdeal.contains with *
  apply Subset.antisymmetric
    intros x hx
    obtain ⟨xInA, productIn⟩ := colonIdeal.membership.forward with hx
    exact IsPrimeIdeal.left_of_mul with *
  . exact contains

theorem IsIntegralDomain.zero_prime (A add zero neg mul one : Set)
  requires domain : IsIntegralDomain(A, add, zero, neg, mul, one)
  shows IsPrimeIdeal(A, add, zero, neg, mul, one, {zero})
proof
  have commRing := IsIntegralDomain.comm_ring with domain
  have ring := IsCommRing.ring with commRing
  have nontrivial := IsIntegralDomain.nontrivial with domain
  have noZeroDivisors := IsIntegralDomain.no_zero_divisors with domain
  have proper := IsProperIdeal.zero_ideal with *
  constructor
  . exact proper
  . intros x hx y hy productIn
    have zeroProduct := singleton.membership.forward with productIn
    have alternatives := noZeroDivisors with x, hx, y, hy, zeroProduct
    cases alternatives with xZero | yZero
    . left
      exact singleton.membership.backward with xZero
    . right
      exact singleton.membership.backward with yZero

theorem IsPrimeIdeal.zero_iff_domain (A add zero neg mul one : Set)
  requires commRing : IsCommRing(A, add, zero, neg, mul, one)
  shows IsPrimeIdeal(A, add, zero, neg, mul, one, {zero}) ↔
    IsIntegralDomain(A, add, zero, neg, mul, one)
proof
  constructor
  . intro prime
    have ring := IsCommRing.ring with commRing
    have zeroInA := IsRing.zero_in_carrier with ring
    have monoid := IsRing.multiplicative with ring
    have oneInA := IsMonoid.unit_in_carrier with monoid
    rcases prime with ⟨proper, factors⟩
    rcases proper with ⟨ideal, oneOut⟩
    have distinct : zero ≠ one
      intro equal
      apply oneOut
      apply singleton.membership.backward
      symm
      exact equal
    have nontrivial : Nontrivial(A, zero, one)
      unfold Nontrivial
      refine ⟨zeroInA, oneInA, distinct⟩
    have noZeroDivisors : NoZeroDivisors(A, mul, zero)
      intros x hx y hy productZero
      have productIn := singleton.membership.backward with productZero
      have alternatives := factors with x, hx, y, hy, productIn
      cases alternatives with xIn | yIn
      . left
        exact singleton.membership.forward with xIn
      . right
        exact singleton.membership.forward with yIn
    unfold IsIntegralDomain
    refine ⟨commRing, nontrivial, noZeroDivisors⟩
  . intro domain
    exact IsIntegralDomain.zero_prime with domain
