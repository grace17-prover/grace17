-- Authors: Grant Passmore

module Grace.Cumulus.Algebra.Ring.Equalizer
import Subring

def ringEqualizer (f g A : Set) : Set := {x ∈ A | f(x) = g(x)}

section Homomorphisms
variable (A add zero neg mul one B plus z minus times unit f g : Set)
notation ring R := (A, add, zero, neg, mul, one)
notation ring S := (B, plus, z, minus, times, unit)
hypothesis ring : IsCommRing(R)
hypothesis first : IsRingHom(f, R, S)
hypothesis second : IsRingHom(g, R, S)

theorem ringEqualizer.subring
  shows IsSubring(R, ringEqualizer(f, g, A))
proof
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have multiplicative := IsRing.multiplicative with ordinary
  have oneIn := IsMonoid.unit_in_carrier with multiplicative
  have firstZero := IsRingHom.zero with first
  have secondZero := IsRingHom.zero with second
  have firstOne := IsRingHom.one with first
  have secondOne := IsRingHom.one with second
  have subset : ringEqualizer(f, g, A) ⊆ A
    intros x hx
    have data := ringEqualizer.membership.forward with hx
    exact data.left
  unfold IsSubring
  refine ⟨subset, ⟨?_, ⟨?_, ⟨?_, ⟨?_, ?_⟩⟩⟩⟩⟩
  . apply ringEqualizer.membership.backward at f, g, A, zero
    constructor
    . exact zeroIn
    . cc
  . apply ringEqualizer.membership.backward at f, g, A, one
    constructor
    . exact oneIn
    . cc
    intros x hx
    obtain ⟨member, equal⟩ := ringEqualizer.membership.forward with hx
    have closed := IsRing.neg_closed with ordinary, member
    have left := IsRingHom.neg with first, member
    have right := IsRingHom.neg with second, member
    apply ringEqualizer.membership.backward
    constructor
    . exact closed
    . cc
    intros x hx y hy
    obtain ⟨memberX, equalX⟩ := ringEqualizer.membership.forward with hx
    obtain ⟨memberY, equalY⟩ := ringEqualizer.membership.forward with hy
    have closed := IsRing.add_closed with ordinary, memberX, memberY
    have left := IsRingHom.add with first, memberX, memberY
    have right := IsRingHom.add with second, memberX, memberY
    apply ringEqualizer.membership.backward
    constructor
    . exact closed
    . cc
    intros x hx y hy
    obtain ⟨memberX, equalX⟩ := ringEqualizer.membership.forward with hx
    obtain ⟨memberY, equalY⟩ := ringEqualizer.membership.forward with hy
    have closed := IsRing.mul_closed with ordinary, memberX, memberY
    have left := IsRingHom.mul with first, memberX, memberY
    have right := IsRingHom.mul with second, memberX, memberY
    apply ringEqualizer.membership.backward
    constructor
    . exact closed
    . cc

end Homomorphisms
