module Grace.Cumulus.Algebra.Ring.SubringCore
import Restriction
import HomomorphismCore

-- IsSubring(A, add, zero, neg, mul, one, S) is the subring over separate
-- pieces; the bundled Subring(R, S) is defined in Subring and bridged to
-- this form.
predicate IsSubring (A add zero neg mul one S : Set) :=
  S ⊆ A ∧ zero ∈ S ∧ one ∈ S ∧ ClosedUnary(S, neg) ∧
    ClosedBinary(S, add) ∧ ClosedBinary(S, mul)

notation scoped IsSubring(R, S) => IsSubring(R.carrier, R.add, R.zero, R.neg, R.mul, R.one, S)

theorem IsSubring.subset_carrier (A add zero neg mul one S : Set)
  requires subring : IsSubring(A, add, zero, neg, mul, one, S)
  shows S ⊆ A
proof
  simp [IsSubring]

theorem IsSubring.zero_closed (A add zero neg mul one S : Set)
  requires subring : IsSubring(A, add, zero, neg, mul, one, S)
  shows zero ∈ S
proof
  simp [IsSubring]

theorem IsSubring.one_closed (A add zero neg mul one S : Set)
  requires subring : IsSubring(A, add, zero, neg, mul, one, S)
  shows one ∈ S
proof
  simp [IsSubring]

theorem IsSubring.neg_closed (A add zero neg mul one S : Set)
  requires subring : IsSubring(A, add, zero, neg, mul, one, S)
  shows ClosedUnary(S, neg)
proof
  simp [IsSubring]

theorem IsSubring.add_closed (A add zero neg mul one S : Set)
  requires subring : IsSubring(A, add, zero, neg, mul, one, S)
  shows ClosedBinary(S, add)
proof
  simp [IsSubring]

theorem IsSubring.mul_closed (A add zero neg mul one S : Set)
  requires subring : IsSubring(A, add, zero, neg, mul, one, S)
  shows ClosedBinary(S, mul)
proof
  simp [IsSubring]

theorem IsSubring.comm_ring (A add zero neg mul one S : Set)
  requires ring : IsCommRing(A, add, zero, neg, mul, one)
  requires subring : IsSubring(A, add, zero, neg, mul, one, S)
  shows IsCommRing(S, restrict(add, S × S), zero, restrict(neg, S), restrict(mul, S × S), one)
proof
  have subset := IsSubring.subset_carrier with subring
  have zeroIn := IsSubring.zero_closed with subring
  have oneIn := IsSubring.one_closed with subring
  have addClosed := IsSubring.add_closed with subring
  have mulClosed := IsSubring.mul_closed with subring
  have negClosed := IsSubring.neg_closed with subring
  have addition : IsMagma(A, add) by simp [IsCommRing, IsRing, IsAbelianGroup, IsGroup, IsMonoid, IsSemigroup]
  have multiplication : IsMagma(A, mul) by simp [IsCommRing, IsRing, IsAbelianGroup, IsGroup, IsMonoid, IsSemigroup]
  have addAssoc : Associative(A, add) by simp [IsCommRing, IsRing, IsAbelianGroup, IsGroup, IsMonoid, IsSemigroup]
  have mulAssoc : Associative(A, mul) by simp [IsCommRing, IsRing, IsAbelianGroup, IsGroup, IsMonoid, IsSemigroup]
  have addComm : Commutative(A, add) by simp [IsCommRing, IsRing, IsAbelianGroup, IsGroup, IsMonoid, IsSemigroup]
  have mulComm : Commutative(A, mul) by simp [IsCommRing, IsRing, IsAbelianGroup, IsGroup, IsMonoid, IsSemigroup]
  have addUnit : Identity(A, add, zero) by simp [IsCommRing, IsRing, IsAbelianGroup, IsGroup, IsMonoid, IsSemigroup]
  have mulUnit : Identity(A, mul, one) by simp [IsCommRing, IsRing, IsAbelianGroup, IsGroup, IsMonoid, IsSemigroup]
  have inverse : Inverse(A, add, zero, neg) by simp [IsCommRing, IsRing, IsAbelianGroup, IsGroup, IsMonoid, IsSemigroup]
  have distribute : Distributive(A, add, mul) by simp [IsCommRing, IsRing, IsAbelianGroup, IsGroup, IsMonoid, IsSemigroup]
  have negation : neg : A → A by simp [Inverse]
  have addFunction := restrictBinary.function at A, S, add with *
  have mulFunction := restrictBinary.function at A, S, mul with *
  have restrictedAdd : IsMagma(S, restrict(add, S × S)) by exact addFunction
  have restrictedMul : IsMagma(S, restrict(mul, S × S)) by exact mulFunction
  have rAddAssoc := restrictBinary.associative at A, S, add with *
  have rMulAssoc := restrictBinary.associative at A, S, mul with *
  have rAddComm := restrictBinary.commutative at A, S, add with *
  have rMulComm := restrictBinary.commutative at A, S, mul with *
  have rAddUnit := restrictBinary.identity at A, S, add, zero with *
  have rMulUnit := restrictBinary.identity at A, S, mul, one with *
  have rInverse := restrictUnary.inverse with *
  have rDistribute := restrictBinary.distributive with *
  simp [IsCommRing, IsRing, IsAbelianGroup, IsGroup, IsMonoid, IsSemigroup]

theorem IsSubring.inclusion_function (A add zero neg mul one S : Set)
  requires subring : IsSubring(A, add, zero, neg, mul, one, S)
  shows identity(S) : S → A
proof
  have function := identity.function at S
  have subset := IsSubring.subset_carrier with subring
  apply FunctionBetween.codomain_of_values with function
  intros x hx
  have value := identity.apply with hx
  rw value
  exact subset with x, hx

theorem IsSubring.inclusion_hom (A add zero neg mul one S : Set)
  requires ring : IsCommRing(A, add, zero, neg, mul, one)
  requires subring : IsSubring(A, add, zero, neg, mul, one, S)
  shows IsRingHom(identity(S), S, restrict(add, S × S), zero, restrict(neg, S), restrict(mul, S × S), one, A, add, zero, neg, mul, one)
proof
  have smaller := IsSubring.comm_ring with ring, subring
  have function := IsSubring.inclusion_function with subring
  have subset := IsSubring.subset_carrier with subring
  have addClosed := IsSubring.add_closed with subring
  have mulClosed := IsSubring.mul_closed with subring
  have addition : IsMagma(A, add) by simp [IsCommRing, IsRing, IsAbelianGroup, IsGroup, IsMonoid, IsSemigroup]
  have multiplication : IsMagma(A, mul) by simp [IsCommRing, IsRing, IsMonoid, IsSemigroup]
  apply IsRingHom.of_add_mul_one with smaller, ring, function
  . intros x hx y hy
    have closed := ClosedBinary.mem at S, add, x, y with *
    have restricted := restrictBinary.value at A, S, add, x, y with *
    have vx := identity.apply with hx
    have vy := identity.apply with hy
    have output := identity.apply at call2(add, x, y), S with *
    cc
  . intros x hx y hy
    have closed := ClosedBinary.mem at S, mul, x, y with *
    have restricted := restrictBinary.value at A, S, mul, x, y with *
    have vx := identity.apply with hx
    have vy := identity.apply with hy
    have output := identity.apply at call2(mul, x, y), S with *
    cc
  . have oneIn := IsSubring.one_closed with subring
    exact identity.apply with oneIn

theorem IsSubring.inclusion_injective (A add zero neg mul one S : Set)
  requires subring : IsSubring(A, add, zero, neg, mul, one, S)
  shows InjectiveBetween(identity(S), S, A)
proof
  have function := IsSubring.inclusion_function with subring
  unfold InjectiveBetween
  refine ⟨function, ?_⟩
  intros x hx y hy z hz left right
  have vx := identity.apply at x, S with *
  have vy := identity.apply at y, S with *
  have ex := FunctionBetween.apply_value at identity(S), S, A, x, z with *
  have ey := FunctionBetween.apply_value at identity(S), S, A, y, z with *
  cc
