module Grace.Cumulus.Algebra.IndexedLists
import CoefficientLists
import Cardinal.ListSupport

theorem listCoefficient.mem_support (A z : Set) (xs : List(A)) (n : Nat)
  requires bound : n < length{A}(xs)
  shows listCoefficient{A}(z, xs, n) ∈ listSupport{A}(xs)
proof
  induction xs generalizing n
  | List.nil =>
    intros n natural bound
    rw length.nil at bound
    have impossible : 0 < 0 by arith
    exfalso
    exact Less.irreflexive with Naturals.constructor.zero, impossible
  | List.cons(a, tail) using ih =>
    intros n natural bound
    have element : a ∈ A by assumption
    rw length.cons at bound
    have shape := natural.zero_or_successor with *
    cases shape with zero | successor
    . rw [zero, listCoefficient.zero, listSupport]
      exact insert.self
    . obtain ⟨k, kNat, equal⟩ := successor
      have smaller : k < length{A}(tail) by arith
      have previous := ih with k, kNat, smaller
      rw [equal, listCoefficient.succ, listSupport]
      exact insert.contains with previous

theorem listCoefficient.closed (A z : Set) (xs : List(A)) (n : Nat)
  requires default : z ∈ A
  shows listCoefficient{A}(z, xs, n) ∈ A
proof
  have casesN : n < length{A}(xs) ∨ ¬(n < length{A}(xs)) by tauto
  cases casesN with inside | outside
  . have supported := listCoefficient.mem_support at A, z, xs, n with *
    have subset := listSupport.subset with *
    exact subset with listCoefficient{A}(z, xs, n), supported
  . have bound : length{A}(xs) ≤ n
      exact LessEqual.of_not_Less with *
    rwa listCoefficient.outside

-- No default-element hypothesis is needed: every index is in range.
defgraph listEntries (A z xs : Set) (i ∈ length{A}(xs)) : listSupport{A}(xs) := listCoefficient{A}(z, xs, i)
requires list : List(A, xs)
proof
  have size : Nat(length{A}(xs)) by typecheck
  have positions := natural.member with size
  have index := positions with i
  have bound := Less.of_membership with *
  exact listCoefficient.mem_support with *

theorem listCoefficient.ext (A z : Set) (xs ys : List(A))
  requires sameLength : length{A}(xs) = length{A}(ys)
  requires entries : ∀ n, Nat(n) → n < length{A}(xs) → listCoefficient{A}(z, xs, n) = listCoefficient{A}(z, ys, n)
  shows xs = ys
proof
  induction xs generalizing ys
  | List.nil =>
    intros ys ysList sameLength entries
    have shape := List.cases with ysList
    cases shape with empty | nonempty
    . rw empty
      rfl
    . obtain ⟨b, hb, tail, tailList, equal⟩ := nonempty
      rw [equal, length.nil, length.cons] at sameLength
      have impossible : 0 < 0 by arith
      exfalso
      exact Less.irreflexive with Naturals.constructor.zero, impossible
  | List.cons(a, tail) using ih =>
    intros ys ysList sameLength entries
    have headIn : a ∈ A by assumption
    have shape := List.cases with ysList
    cases shape with empty | nonempty
    . rw [empty, length.cons, length.nil] at sameLength
      have impossible : 0 < 0 by arith
      exfalso
      exact Less.irreflexive with Naturals.constructor.zero, impossible
    . obtain ⟨b, hb, rest, restList, equal⟩ := nonempty
      rw [equal, length.cons, length.cons] at sameLength
      have lengths := Naturals.injective.succ with sameLength
      have firstBound : 0 < length{A}(a :: tail)
        rw length.cons
        arith
      have heads := entries with 0, Naturals.constructor.zero, firstBound
      rw [equal, listCoefficient.zero, listCoefficient.zero] at heads
      have restEntries : ∀ n, Nat(n) → n < length{A}(tail) → listCoefficient{A}(z, tail, n) = listCoefficient{A}(z, rest, n)
        intros n nNat bound
        have nextBound : succ(n) < length{A}(a :: tail)
          rw length.cons
          arith
        have values := entries with succ(n), nextBound
        rwa [equal, listCoefficient.succ, listCoefficient.succ] at values
      have tails := ih with rest, restList, lengths, restEntries
      rw equal
      cc

theorem listSupport.exists_index (A z : Set) (xs : List(A))
  shows ∀ a ∈ listSupport{A}(xs), ∃ n, Nat(n) ∧ n < length{A}(xs) ∧ listCoefficient{A}(z, xs, n) = a
proof
  induction xs
  | List.nil =>
    intros a ha
    rw listSupport at ha
    exfalso
    exact set.empty with ha
  | List.cons(b, tail) using ih =>
    intros a ha
    have headIn : b ∈ A by assumption
    rw listSupport at ha
    have alternatives := insert.membership.forward with ha
    cases alternatives with head | rest
    . have bound : 0 < length{A}(b :: tail)
        rw length.cons
        arith
      refine ⟨0, Naturals.constructor.zero, bound, ?_⟩
      rw listCoefficient.zero
      cc
    . obtain ⟨n, nNat, bound, value⟩ := ih with a, rest
      have next : Nat(succ(n)) by typecheck
      have nextBound : succ(n) < length{A}(b :: tail)
        rw length.cons
        arith
      refine ⟨succ(n), next, nextBound, ?_⟩
      rwa listCoefficient.succ

theorem listEntries.surjective (A z : Set) (xs : List(A))
  shows SurjectiveBetween(listEntries(A, z, xs), length{A}(xs), listSupport{A}(xs))
proof
  have function := listEntries.function at A, z, xs with *
  have cover := listSupport.exists_index at A, z, xs with *
  unfold SurjectiveBetween
  refine ⟨function, ?_⟩
  intros a ha
  obtain ⟨n, nNat, bound, value⟩ := cover with a, ha
  have position : n ∈ length{A}(xs) by exact membership.of_Less at n, length{A}(xs) with nNat, bound
  have entry := listEntries.value at A, z, xs, n with *
  have graph := FunctionBetween.relates_apply with *
  refine ⟨n, position, ?_⟩
  rwa [entry, value] at graph
