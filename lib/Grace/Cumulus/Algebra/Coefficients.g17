module Grace.Cumulus.Algebra.Coefficients
import Ring
import Cardinal.ListSupport

def functionSupport (f I z : Set) : Set := {i ∈ I | f(i) ≠ z}
predicate CoefficientMap (f I A z : Set) := FunctionBetween(f, I, A) ∧ Finite(functionSupport(f, I, z))
def coefficientMaps (I A z : Set) : Set := {f ∈ 𝒫(I × A) | CoefficientMap(f, I, A, z)}

theorem functionSupport.membership (f I z i : Set)
  shows i ∈ functionSupport(f, I, z) ↔ i ∈ I ∧ f(i) ≠ z
proof
  simp

theorem functionSupport.subset (f I z : Set)
  shows functionSupport(f, I, z) ⊆ I
proof
  simp

theorem functionSupport.outside (f I z i : Set)
  requires hi : i ∈ I
  requires absent : ¬(i ∈ functionSupport(f, I, z))
  shows f(i) = z
proof
  ext y
  simp

theorem CoefficientMap.function (f I A z : Set)
  requires map : CoefficientMap(f, I, A, z)
  shows f : I → A
proof
  exact map.left

theorem CoefficientMap.finite_support (f I A z : Set)
  requires map : CoefficientMap(f, I, A, z)
  shows Finite(functionSupport(f, I, z))
proof
  exact map.right

theorem coefficientMaps.membership (I A z f : Set)
  shows f ∈ coefficientMaps(I, A, z) ↔ f ∈ 𝒫(I × A) ∧ CoefficientMap(f, I, A, z)
proof
  simp

theorem coefficientMaps.contains (I A z f : Set)
  requires map : CoefficientMap(f, I, A, z)
  shows f ∈ coefficientMaps(I, A, z)
proof
  have function := CoefficientMap.function with map
  have relation := FunctionBetween.relation with function
  unfold RelationBetween at relation
  unfold Subset at relation
  have bound := set.powerset.backward with relation
  exact coefficientMaps.membership.backward with ⟨bound, map⟩

theorem CoefficientMap.ext (f g I A z : Set)
  requires left : CoefficientMap(f, I, A, z)
  requires right : CoefficientMap(g, I, A, z)
  requires values : ∀ i ∈ I, f(i) = g(i)
  shows f = g
proof
  have functionF := CoefficientMap.function with left
  have functionG := CoefficientMap.function with right
  exact FunctionBetween.ext with functionF, functionG, values

defgraph coefficientAdd (I A add zero neg mul one f g : Set) (i ∈ I) : A := call2(add, f(i), g(i))
requires ring : IsCommRing(A, add, zero, neg, mul, one)
requires left : f : I → A
requires right : g : I → A
proof
  have ordinary := IsCommRing.ring with ring
  have fi := FunctionBetween.apply_closed with left, member
  have gi := FunctionBetween.apply_closed with right, member
  exact IsRing.add_closed with ordinary, fi, gi

notation scoped coefficientAdd(I, R, f, g) => coefficientAdd(I, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, f, g)

defgraph coefficientNeg (I A add zero neg mul one f : Set) (i ∈ I) : A := neg(f(i))
requires ring : IsCommRing(A, add, zero, neg, mul, one)
requires function : f : I → A
proof
  have ordinary := IsCommRing.ring with ring
  have fi := FunctionBetween.apply_closed with function, member
  exact IsRing.neg_closed with ordinary, fi

defgraph coefficientScale (I A add zero neg mul one a f : Set) (i ∈ I) : A := call2(mul, a, f(i))
requires ring : IsCommRing(A, add, zero, neg, mul, one)
requires scalar : a ∈ A
requires function : f : I → A
proof
  have ordinary := IsCommRing.ring with ring
  have fi := FunctionBetween.apply_closed with function, member
  exact IsRing.mul_closed with ordinary, scalar, fi

notation scoped coefficientScale(I, R, a, f) => coefficientScale(I, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, a, f)

section Rings
variable (I A add zero neg mul one : Set)
hypothesis ring : IsCommRing(A, add, zero, neg, mul, one)
notation ring R := (A, add, zero, neg, mul, one)

theorem CoefficientMap.zero
  shows CoefficientMap(constantFunction(I, A, zero), I, A, zero)
proof
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have function := constantFunction.function at I, A, zero with zeroIn
  have support : functionSupport(constantFunction(I, A, zero), I, zero) = ∅
    ext i
    constructor
    . intro member
      have data := functionSupport.membership.forward with member
      have value := constantFunction.apply with data.left, zeroIn
      have contradiction := data.right with value
      tauto
    . intro member
      simp
  unfold CoefficientMap
  refine ⟨function, ?_⟩
  rw support
  exact Finite.empty

theorem coefficientAdd.support (f g : Set)
  requires left : f : I → A
  requires right : g : I → A
  shows functionSupport(coefficientAdd(I, A, add, zero, neg, mul, one, f, g), I, zero) ⊆ functionSupport(f, I, zero) ∪ functionSupport(g, I, zero)
proof
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have zeroSum : 0 + 0 = 0 by ring
  intros i hi
  have data := functionSupport.membership.forward with hi
  have value := coefficientAdd.value at I, A, add, zero, neg, mul, one, f, g, i with *
  have casesF : f(i) = zero ∨ f(i) ≠ zero by tauto
  have casesG : g(i) = zero ∨ g(i) ≠ zero by tauto
  cases casesF with fZero | fNonzero
  . cases casesG with gZero | gNonzero
    . have equal : coefficientAdd(I, A, add, zero, neg, mul, one, f, g)(i) = zero
        cc
      have contradiction := data.right with equal
      tauto
    . have member : i ∈ functionSupport(g, I, zero)
        exact functionSupport.membership.backward with ⟨data.left, gNonzero⟩
      apply union2.membership.backward
      right
      exact member
  . have member : i ∈ functionSupport(f, I, zero)
      exact functionSupport.membership.backward with ⟨data.left, fNonzero⟩
    apply union2.membership.backward
    left
    exact member

theorem CoefficientMap.add (f g : Set)
  requires left : CoefficientMap(f, I, A, zero)
  requires right : CoefficientMap(g, I, A, zero)
  shows CoefficientMap(coefficientAdd(I, A, add, zero, neg, mul, one, f, g), I, A, zero)
proof
  have functionF := CoefficientMap.function with left
  have functionG := CoefficientMap.function with right
  have finiteF := CoefficientMap.finite_support with left
  have finiteG := CoefficientMap.finite_support with right
  have finiteUnion := Finite.union with finiteF, finiteG
  have support := coefficientAdd.support with ring, functionF, functionG
  have finite := Finite.subset with finiteUnion, support
  have function := coefficientAdd.function at I, A, add, zero, neg, mul, one, f, g with *
  unfold CoefficientMap
  refine ⟨function, finite⟩

theorem coefficientNeg.support (f : Set)
  requires function : f : I → A
  shows functionSupport(coefficientNeg(I, A, add, zero, neg, mul, one, f), I, zero) ⊆ functionSupport(f, I, zero)
proof
  have zeroValue : -0 = 0 by ring
  intros i hi
  have data := functionSupport.membership.forward with hi
  have value := coefficientNeg.value at I, A, add, zero, neg, mul, one, f, i with *
  have casesF : f(i) = zero ∨ f(i) ≠ zero by tauto
  cases casesF with fZero | fNonzero
  . have equal : coefficientNeg(I, A, add, zero, neg, mul, one, f)(i) = zero
      cc
    have contradiction := data.right with equal
    tauto
  . apply functionSupport.membership.backward at f, I, zero, i
    refine ⟨data.left, fNonzero⟩

theorem CoefficientMap.neg (f : Set)
  requires map : CoefficientMap(f, I, A, zero)
  shows CoefficientMap(coefficientNeg(I, A, add, zero, neg, mul, one, f), I, A, zero)
proof
  have functionF := CoefficientMap.function with map
  have finiteF := CoefficientMap.finite_support with map
  have support := coefficientNeg.support with *
  have finite := Finite.subset with finiteF, support
  have function := coefficientNeg.function at I, A, add, zero, neg, mul, one, f with *
  unfold CoefficientMap
  refine ⟨function, finite⟩

theorem coefficientScale.support (a f : Set)
  requires scalar : a ∈ A
  requires function : f : I → A
  shows functionSupport(coefficientScale(I, A, add, zero, neg, mul, one, a, f), I, zero) ⊆ functionSupport(f, I, zero)
proof
  have zeroValue : a * 0 = 0 by ring
  intros i hi
  have data := functionSupport.membership.forward with hi
  have value := coefficientScale.value at I, A, add, zero, neg, mul, one, a, f, i with *
  have casesF : f(i) = zero ∨ f(i) ≠ zero by tauto
  cases casesF with fZero | fNonzero
  . have equal : coefficientScale(I, A, add, zero, neg, mul, one, a, f)(i) = zero
      cc
    have contradiction := data.right with equal
    tauto
  . apply functionSupport.membership.backward at f, I, zero, i
    refine ⟨data.left, fNonzero⟩

theorem CoefficientMap.scale (a f : Set)
  requires scalar : a ∈ A
  requires map : CoefficientMap(f, I, A, zero)
  shows CoefficientMap(coefficientScale(I, A, add, zero, neg, mul, one, a, f), I, A, zero)
proof
  have functionF := CoefficientMap.function with map
  have finiteF := CoefficientMap.finite_support with map
  have support := coefficientScale.support with *
  have finite := Finite.subset with finiteF, support
  have function := coefficientScale.function at I, A, add, zero, neg, mul, one, a, f with *
  unfold CoefficientMap
  refine ⟨function, finite⟩

theorem CoefficientMap.support_list (f : Set)
  requires map : CoefficientMap(f, I, A, zero)
  shows ∃ xs, List(I, xs) ∧ functionSupport(f, I, zero) ⊆ listSupport{I}(xs)
proof
  have finite := CoefficientMap.finite_support with map
  have subset := functionSupport.subset at f, I, zero
  exact Finite.cover_in with finite, subset

theorem coefficientAdd.commutative (f g : Set)
  requires functionF : f : I → A
  requires functionG : g : I → A
  shows coefficientAdd(I, A, add, zero, neg, mul, one, f, g) = coefficientAdd(I, A, add, zero, neg, mul, one, g, f)
proof
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have function0 := coefficientAdd.function at I, A, add, zero, neg, mul, one, f, g with *
  have function1 := coefficientAdd.function at I, A, add, zero, neg, mul, one, g, f with *
  apply FunctionBetween.ext with function0, function1
  intros i hi
  have fIn := FunctionBetween.apply_closed at f, I, A, i with *
  have gIn := FunctionBetween.apply_closed at g, I, A, i with *
  have value0 := coefficientAdd.value at I, A, add, zero, neg, mul, one, f, g, i with *
  have value1 := coefficientAdd.value at I, A, add, zero, neg, mul, one, g, f, i with *
  rw [value1, value0]
  ring

theorem coefficientAdd.associative (f g h : Set)
  requires functionF : f : I → A
  requires functionG : g : I → A
  requires functionH : h : I → A
  shows coefficientAdd(I, A, add, zero, neg, mul, one, coefficientAdd(I, A, add, zero, neg, mul, one, f, g), h) = coefficientAdd(I, A, add, zero, neg, mul, one, f, coefficientAdd(I, A, add, zero, neg, mul, one, g, h))
proof
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have function0 := coefficientAdd.function at I, A, add, zero, neg, mul, one, f, g with *
  have function1 := coefficientAdd.function at I, A, add, zero, neg, mul, one, coefficientAdd(I, A, add, zero, neg, mul, one, f, g), h with *
  have function2 := coefficientAdd.function at I, A, add, zero, neg, mul, one, g, h with *
  have function3 := coefficientAdd.function at I, A, add, zero, neg, mul, one, f, coefficientAdd(I, A, add, zero, neg, mul, one, g, h) with *
  apply FunctionBetween.ext with function1, function3
  intros i hi
  have fIn := FunctionBetween.apply_closed at f, I, A, i with *
  have gIn := FunctionBetween.apply_closed at g, I, A, i with *
  have hIn := FunctionBetween.apply_closed at h, I, A, i with *
  have value0 := coefficientAdd.value at I, A, add, zero, neg, mul, one, f, g, i with *
  have value1 := coefficientAdd.value at I, A, add, zero, neg, mul, one, coefficientAdd(I, A, add, zero, neg, mul, one, f, g), h, i with *
  have value2 := coefficientAdd.value at I, A, add, zero, neg, mul, one, g, h, i with *
  have value3 := coefficientAdd.value at I, A, add, zero, neg, mul, one, f, coefficientAdd(I, A, add, zero, neg, mul, one, g, h), i with *
  rw [value3, value2, value1, value0]
  ring

theorem coefficientAdd.zero (f : Set)
  requires functionF : f : I → A
  shows coefficientAdd(I, A, add, zero, neg, mul, one, f, constantFunction(I, A, zero)) = f
proof
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have functionZero := constantFunction.function at I, A, zero with zeroIn
  have function0 := coefficientAdd.function at I, A, add, zero, neg, mul, one, f, constantFunction(I, A, zero) with *
  apply FunctionBetween.ext with function0, functionF
  intros i hi
  have fIn := FunctionBetween.apply_closed at f, I, A, i with *
  have zeroValue := constantFunction.apply at I, A, i, zero with *
  have value0 := coefficientAdd.value at I, A, add, zero, neg, mul, one, f, constantFunction(I, A, zero), i with *
  rw [value0, zeroValue]
  ring

theorem coefficientAdd.inverse (f : Set)
  requires functionF : f : I → A
  shows coefficientAdd(I, A, add, zero, neg, mul, one, f, coefficientNeg(I, A, add, zero, neg, mul, one, f)) = constantFunction(I, A, zero)
proof
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have functionZero := constantFunction.function at I, A, zero with zeroIn
  have function0 := coefficientNeg.function at I, A, add, zero, neg, mul, one, f with *
  have function1 := coefficientAdd.function at I, A, add, zero, neg, mul, one, f, coefficientNeg(I, A, add, zero, neg, mul, one, f) with *
  apply FunctionBetween.ext with function1, functionZero
  intros i hi
  have fIn := FunctionBetween.apply_closed at f, I, A, i with *
  have zeroValue := constantFunction.apply at I, A, i, zero with *
  have value0 := coefficientNeg.value at I, A, add, zero, neg, mul, one, f, i with *
  have value1 := coefficientAdd.value at I, A, add, zero, neg, mul, one, f, coefficientNeg(I, A, add, zero, neg, mul, one, f), i with *
  rw [value1, value0, zeroValue]
  ring

theorem coefficientScale.one (f : Set)
  requires functionF : f : I → A
  shows coefficientScale(I, A, add, zero, neg, mul, one, one, f) = f
proof
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have multiplicative := IsRing.multiplicative with ordinary
  have oneIn := IsMonoid.unit_in_carrier with multiplicative
  have function0 := coefficientScale.function at I, A, add, zero, neg, mul, one, one, f with *
  apply FunctionBetween.ext with function0, functionF
  intros i hi
  have fIn := FunctionBetween.apply_closed at f, I, A, i with *
  have value0 := coefficientScale.value at I, A, add, zero, neg, mul, one, one, f, i with *
  rw value0
  ring

theorem coefficientScale.associative (a b f : Set)
  requires aIn : a ∈ A
  requires bIn : b ∈ A
  requires functionF : f : I → A
  shows coefficientScale(I, A, add, zero, neg, mul, one, a, coefficientScale(I, A, add, zero, neg, mul, one, b, f)) = coefficientScale(I, A, add, zero, neg, mul, one, call2(mul, a, b), f)
proof
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have productIn := IsRing.mul_closed at A, add, zero, neg, mul, one, a,
    b with *
  have function0 := coefficientScale.function at I, A, add, zero, neg, mul, one, b, f with *
  have function1 := coefficientScale.function at I, A, add, zero, neg, mul, one, a, coefficientScale(I, A, add, zero, neg, mul, one, b, f) with *
  have function2 := coefficientScale.function at I, A, add, zero, neg, mul, one, call2(mul, a, b), f with *
  apply FunctionBetween.ext with function1, function2
  intros i hi
  have fIn := FunctionBetween.apply_closed at f, I, A, i with *
  have value0 := coefficientScale.value at I, A, add, zero, neg, mul, one, b, f, i with *
  have value1 := coefficientScale.value at I, A, add, zero, neg, mul, one, a, coefficientScale(I, A, add, zero, neg, mul, one, b, f), i with *
  have value2 := coefficientScale.value at I, A, add, zero, neg, mul, one, call2(mul, a, b), f, i with *
  rw [value2, value1, value0]
  ring

theorem coefficientScale.add (a f g : Set)
  requires aIn : a ∈ A
  requires functionF : f : I → A
  requires functionG : g : I → A
  shows coefficientScale(I, A, add, zero, neg, mul, one, a, coefficientAdd(I, A, add, zero, neg, mul, one, f, g)) = coefficientAdd(I, A, add, zero, neg, mul, one, coefficientScale(I, A, add, zero, neg, mul, one, a, f), coefficientScale(I, A, add, zero, neg, mul, one, a, g))
proof
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have function0 := coefficientAdd.function at I, A, add, zero, neg, mul, one, f, g with *
  have function1 := coefficientScale.function at I, A, add, zero, neg, mul, one, a, coefficientAdd(I, A, add, zero, neg, mul, one, f, g) with *
  have function2 := coefficientScale.function at I, A, add, zero, neg, mul, one, a, f with *
  have function3 := coefficientScale.function at I, A, add, zero, neg, mul, one, a, g with *
  have function4 := coefficientAdd.function at I, A, add, zero, neg, mul, one, coefficientScale(I, A, add, zero, neg, mul, one, a, f), coefficientScale(I, A, add, zero, neg, mul, one, a, g) with *
  apply FunctionBetween.ext with function1, function4
  intros i hi
  have fIn := FunctionBetween.apply_closed at f, I, A, i with *
  have gIn := FunctionBetween.apply_closed at g, I, A, i with *
  have value0 := coefficientAdd.value at I, A, add, zero, neg, mul, one, f, g, i with *
  have value1 := coefficientScale.value at I, A, add, zero, neg, mul, one, a, coefficientAdd(I, A, add, zero, neg, mul, one, f, g), i with *
  have value2 := coefficientScale.value at I, A, add, zero, neg, mul, one, a, f, i with *
  have value3 := coefficientScale.value at I, A, add, zero, neg, mul, one, a, g, i with *
  have value4 := coefficientAdd.value at I, A, add, zero, neg, mul, one, coefficientScale(I, A, add, zero, neg, mul, one, a, f), coefficientScale(I, A, add, zero, neg, mul, one, a, g), i with *
  rw [value4, value3, value2, value1, value0]
  ring

end Rings
