module Grace.Cumulus.Algebra.LinearSpanMap
import SpanProduct
import Image

section Algebras
variable (A add zero neg mul one B plus z minus times unit C sum o inverse product e f g : Set)
notation ring R := (A, add, zero, neg, mul, one)
notation ring S := (B, plus, z, minus, times, unit)
notation ring U := (C, sum, o, inverse, product, e)
hypothesis coefficients : IsCommRing(R)
hypothesis source : IsCommRing(S)
hypothesis target : IsCommRing(U)
hypothesis coefficientMap : IsRingHom(f, R, S)
hypothesis hom : IsRingHom(g, S, U)

theorem Submodule.comap (T : Set)
  requires submodule : Submodule(compose(g, f, A, B, C), R, U, T)
  shows Submodule(f, R, S, subringComap(g, B, T))
proof
  have ordinary := IsCommRing.ring with source
  have functionF := IsRingHom.function with coefficientMap
  have functionG := IsRingHom.function with hom
  have composite := IsRingHom.compose with coefficients, coefficientMap, hom
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have zeroMem := Submodule.zero_mem with coefficients, target, composite, submodule
  have negClosed := Submodule.neg_closed with coefficients, target, composite, submodule
  have addClosed := Submodule.add_closed with coefficients, target, composite, submodule
  have zeroValue := IsRingHom.zero with hom
  have bounded : subringComap(g, B, T) ⊆ B by simp [Subset, subringComap.membership]
  have zeroMember : S[0] ∈ subringComap(g, B, T)
    apply subringComap.membership.backward
    rw zeroValue
    refine ⟨zeroIn, zeroMem⟩
  have negative : ClosedUnary(subringComap(g, B, T), minus)
    intros x hx
    obtain ⟨inB, member⟩ := subringComap.membership.forward with hx
    have closed := IsRing.neg_closed with ordinary, inB
    have mapped := IsRingHom.neg with hom, inB
    have result := ClosedUnary.mem with negClosed, member
    apply subringComap.membership.backward
    rw mapped
    refine ⟨closed, result⟩
  have addition : ClosedBinary(subringComap(g, B, T), plus)
    intros x hx y hy
    obtain ⟨inX, memberX⟩ := subringComap.membership.forward with hx
    obtain ⟨inY, memberY⟩ := subringComap.membership.forward with hy
    have closed := IsRing.add_closed with ordinary, inX, inY
    have mapped := IsRingHom.add with hom, inX, inY
    have result := ClosedBinary.mem with addClosed, memberX, memberY
    apply subringComap.membership.backward
    rw mapped
    refine ⟨closed, result⟩
  have scalars : ∀ a ∈ R, ∀ x ∈ subringComap(g, B, T), S[f(a) * x] ∈ subringComap(g, B, T)
    intros a ha x hx
    obtain ⟨inB, member⟩ := subringComap.membership.forward with hx
    have image := IsRingHom.closed with coefficientMap, ha
    have closed := IsRing.mul_closed with ordinary, image, inB
    have mapped := IsRingHom.mul with hom, image, inB
    have compositeValue := compose.apply with ha
    have result := Submodule.scalar_mul_mem with coefficients, target, composite, submodule, ha, member
    rw compositeValue at result
    apply subringComap.membership.backward
    rw mapped
    refine ⟨closed, result⟩
  unfold Submodule
  refine ⟨bounded, zeroMember, negative, addition, scalars⟩

theorem linearSpan.map_mem (G x : Set)
  requires bounded : G ⊆ S
  requires member : x ∈ linearSpan(f, R, S, G)
  shows g(x) ∈ linearSpan(compose(g, f, A, B, C), R, U, functionImage(g, G, C))
proof
  have composite := IsRingHom.compose with coefficients, coefficientMap, hom
  have span := linearSpan.submodule at A, add, zero, neg, mul, one, C, sum, o, inverse, product, e, compose(g, f, A, B, C), functionImage(g, G, C) with *
  have preimage := Submodule.comap with coefficients, source, target, coefficientMap, hom, span
  have imageBound : functionImage(g, G, C) ⊆ C by exact functionImage.subset at g, G, C
  have contains := linearSpan.contains with coefficients, target, composite, imageBound
  have generators : G ⊆ subringComap(g, B, linearSpan(compose(g, f, A, B, C), R, U, functionImage(g, G, C)))
    intros u hu
    have inB : u ∈ B by simp [Subset]
    have closed := IsRingHom.closed with hom, inB
    have image : g(u) ∈ functionImage(g, G, C) := functionImage.membership.backward with ⟨closed, u, hu, rfl⟩
    have inSpan : g(u) ∈ linearSpan(compose(g, f, A, B, C), R, U, functionImage(g, G, C)) by simp [Subset]
    exact subringComap.membership.backward with ⟨inB, inSpan⟩
  have included := linearSpan.least with coefficients, source, coefficientMap, preimage, generators
  have inPreimage := included with x, member
  have data := subringComap.membership.forward with inPreimage
  exact data.right

end Algebras
