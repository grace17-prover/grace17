module Grace.Cumulus.Algebra.Polynomial.HornerLocalization
import HornerPolynomial
import LocalizationObstruction

section Localizations
variable (I A add z neg mul one B plus o minus times unit g j leading T : Set)
notation ring R := (A, add, z, neg, mul, one)
notation ring P := R[I]
notation ring S := (B, plus, o, minus, times, unit)
notation ring L := S ↾ T
hypothesis coefficients : IsField(R)
hypothesis infinite : ¬Finite(R)
hypothesis initial : leading ∈ R
hypothesis nonzero : leading ≠ R[0]
hypothesis index : j ∈ I
hypothesis target : IsCommRing(S)
hypothesis embedding : IsRingHom(g, P, S)
hypothesis injective : InjectiveBetween(g, P, S)

theorem polynomialLocalization.not_field_from_horner (cs : List(A))
  requires carrier : T = localizationWithin(S, functionImage(g, P, S), functionImage(g, denominatorPowers(P, polynomialFromHorner(I, R, j, leading, cs)), S))
  shows ¬IsField(L)
proof
  have point : ∃ v, FunctionBetween(v, I, R) ∧ polynomialAt(I, R, v)(polynomialFromHorner(I, R, j, leading, cs)) ≠ R[0]
    exact polynomialFromHorner.nonvanishing with *
  obtain ⟨v, assignment, nonvanishing⟩ := point
  have ring := IsField.comm_ring with coefficients
  have polynomial : polynomialFromHorner(I, R, j, leading, cs) ∈ P
    exact polynomialFromHorner.member with *
  exact polynomialLocalization.not_field_at_point with *

end Localizations
