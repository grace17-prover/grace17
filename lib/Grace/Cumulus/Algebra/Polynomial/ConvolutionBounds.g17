module Grace.Cumulus.Algebra.Polynomial.ConvolutionBounds
import ConvolutionLaws

theorem polynomialPairCoefficient.pair (I A add zero neg mul one p q u v : Set)
  requires ring : IsCommRing(A, add, zero, neg, mul, one)
  requires memberP : p ∈ polynomials(I, A, zero)
  requires memberQ : q ∈ polynomials(I, A, zero)
  requires monomialU : u ∈ monomials(I)
  requires monomialV : v ∈ monomials(I)
  shows polynomialPairCoefficient(I, A, add, zero, neg, mul, one, p, q, (u, v)) = call2(mul, p(u), q(v))
proof
  have pair := product.pair at u, v, monomials(I), monomials(I) with *
  have selected := polynomialPairCoefficient.selected at I, A, add, zero, neg, mul, one, p, q, (u, v) with *
  obtain ⟨a, ha, b, hb, shape, output⟩ := selected.right
  have coordinates := orderedPair.injective with shape
  cc

defgraph boundedConvolutionWeights (I D A add zero neg mul one p q : Set) (t ∈ D) : A :=
  polynomialPairCoefficient(I, A, add, zero, neg, mul, one, p, q, t)
requires ring : IsCommRing(A, add, zero, neg, mul, one)
requires memberP : p ∈ polynomials(I, A, zero)
requires memberQ : q ∈ polynomials(I, A, zero)
requires domain : D ⊆ monomials(I) × monomials(I)
proof
  have pair := domain with t, member
  have selected := polynomialPairCoefficient.selected at I, A, add, zero, neg, mul, one, p, q, t with *
  exact selected.left

section Bounds
variable (I D A add zero neg mul one p q : Set)
hypothesis ring : IsCommRing(A, add, zero, neg, mul, one)
hypothesis memberP : p ∈ polynomials(I, A, zero)
hypothesis memberQ : q ∈ polynomials(I, A, zero)
hypothesis domain : D ⊆ monomials(I) × monomials(I)
notation ring R := (A, add, zero, neg, mul, one)

theorem boundedConvolutionWeights.pair (u v : Set)
  requires pair : (u, v) ∈ D
  requires monomialU : u ∈ monomials(I)
  requires monomialV : v ∈ monomials(I)
  shows boundedConvolutionWeights(I, D, A, add, zero, neg, mul, one, p, q)((u, v)) = p(u) * q(v)
proof
  have value := boundedConvolutionWeights.value at I, D, A, add, zero, neg, mul, one, p, q, (u, v) with *
  have coefficient := polynomialPairCoefficient.pair at I, A, add, zero, neg, mul, one, p, q, u, v with *
  cc

theorem boundedConvolutionWeights.outside (t : Set)
  requires pair : t ∈ D
  requires outside : ¬(t ∈ convolutionPairs(I, zero, p, q))
  shows boundedConvolutionWeights(I, D, A, add, zero, neg, mul, one, p, q)(t) = zero
proof
  have included := domain
  have inProduct := included with t, pair
  obtain ⟨bound, u, hu, v, hv, shape⟩ := product.membership.forward with inProduct
  have inD : (u, v) ∈ D by rwa ← shape
  have coefficientP := polynomials.coefficient at I, A, zero, p, u with *
  have coefficientQ := polynomials.coefficient at I, A, zero, q, v with *
  have value := boundedConvolutionWeights.pair at I, D, A, add, zero, neg, mul, one, p, q, u, v with *
  have alternatives : u ∈ functionSupport(p, monomials(I), zero) ∨ ¬(u ∈ functionSupport(p, monomials(I), zero))
    tauto
  have productZero : p(u) * q(v) = 0
    cases alternatives with supportP | absentP
    . have absentQ : ¬(v ∈ functionSupport(q, monomials(I), zero))
        intro supportQ
        have pairIn := product.pair with supportP, supportQ
        have supported : t ∈ convolutionPairs(I, zero, p, q)
          unfold convolutionPairs
          rwa shape
        exact outside with supported
      have vanishes := functionSupport.outside with *
      rw vanishes
      ring
    . have vanishes := functionSupport.outside with *
      rw vanishes
      ring
  cc

theorem polynomialProduct.on_domain
  requires finite : Finite(D)
  requires covers : convolutionPairs(I, zero, p, q) ⊆ D
  shows finitePushforward(D, monomials(I), A, add, zero, neg, mul, one, monomialMul(I), boundedConvolutionWeights(I, D, A, add, zero, neg, mul, one, p, q)) = polynomialProduct(I, A, add, zero, neg, mul, one, p, q)
proof
  have weights := boundedConvolutionWeights.function at I, D, A, add, zero, neg, mul, one, p, q with *
  have original := convolutionWeights.function at I, A, add, zero, neg, mul, one, p, q with *
  have agreement : ∀ t ∈ convolutionPairs(I, zero, p, q), boundedConvolutionWeights(I, D, A, add, zero, neg, mul, one, p, q)(t) = convolutionWeights(I, A, add, zero, neg, mul, one, p, q)(t)
    intros t ht
    have included := covers
    have inD := included with t, ht
    have left := boundedConvolutionWeights.value at I, D, A, add, zero, neg, mul, one, p, q, t with *
    have right := convolutionWeights.value at I, A, add, zero, neg, mul, one, p, q, t with *
    cc
  have vanishes : ∀ t ∈ D, ¬(t ∈ convolutionPairs(I, zero, p, q)) → boundedConvolutionWeights(I, D, A, add, zero, neg, mul, one, p, q)(t) = zero
    intros t ht outside
    exact boundedConvolutionWeights.outside with *
  have extended := finitePushforward.zero_extension at D, convolutionPairs(I, zero, p, q), monomials(I), A, add, zero, neg, mul, one, monomialMul(I), boundedConvolutionWeights(I, D, A, add, zero, neg, mul, one, p, q), convolutionWeights(I, A, add, zero, neg, mul, one, p, q) with *
  unfold polynomialProduct
  cc

end Bounds
