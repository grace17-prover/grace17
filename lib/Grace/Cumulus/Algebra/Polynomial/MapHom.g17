module Grace.Cumulus.Algebra.Polynomial.MapHom
import CoefficientMap
import Set.OrderTransport

predicate PolynomialMapMultiplies (I A add z neg mul one B plus o minus times unit f p q : Set) :=
  polynomialMap(I, A, z, B, o, f)(polynomialProduct(I, A, add, z, neg, mul, one, p, q)) = polynomialProduct(I, B, plus, o, minus, times, unit, polynomialMap(I, A, z, B, o, f)(p), polynomialMap(I, A, z, B, o, f)(q))

def polynomialMapProducts (I A add z neg mul one B plus o minus times unit f p : Set) : Set :=
  {q ∈ polynomials(I, A, z) | PolynomialMapMultiplies(I, A, add, z, neg, mul, one, B, plus, o, minus, times, unit, f, p, q)}

theorem polynomialMapProducts.membership (I A add z neg mul one B plus o minus times unit f p q : Set)
  shows q ∈ polynomialMapProducts(I, A, add, z, neg, mul, one, B, plus, o, minus, times, unit, f, p) ↔ q ∈ polynomials(I, A, z) ∧ PolynomialMapMultiplies(I, A, add, z, neg, mul, one, B, plus, o, minus, times, unit, f, p, q)
proof
  simp

section Rings
variable (I A add z neg mul one B plus o minus times unit f : Set)
notation ring R := (A, add, z, neg, mul, one)
notation ring S := (B, plus, o, minus, times, unit)
notation ring P := R[I]
notation ring Q := S[I]
hypothesis source : IsCommRing(R)
hypothesis target : IsCommRing(S)
hypothesis hom : IsRingHom(f, R, S)

theorem PolynomialMapMultiplies.zero (p : Set)
  requires memberP : p ∈ P
  shows PolynomialMapMultiplies(I, A, add, z, neg, mul, one, B, plus, o, minus, times, unit, f, p, P[0])
proof
  have function := IsRingHom.function with hom
  have zero := IsRingHom.zero with hom
  have mapped := polynomialMap.member with *
  have sourceZero := polynomialProduct.zero_right at I, A, add, z, neg, mul, one, p with *
  have targetZero := polynomialProduct.zero_right at I, B, plus, o, minus, times, unit, polynomialMap(I, R, S, f)(p) with *
  have mapZero := polynomialMap.zero at I, A, add, z, neg, mul, one, B, plus, o, minus, times, unit, f with *
  unfold PolynomialMapMultiplies
  cc

theorem PolynomialMapMultiplies.swap (p q : Set)
  requires memberP : p ∈ P
  requires memberQ : q ∈ P
  requires equation : PolynomialMapMultiplies(I, A, add, z, neg, mul, one, B, plus, o, minus, times, unit, f, p, q)
  shows PolynomialMapMultiplies(I, A, add, z, neg, mul, one, B, plus, o, minus, times, unit, f, q, p)
proof
  have function := IsRingHom.function with hom
  have zero := IsRingHom.zero with hom
  have mappedP := polynomialMap.member at I, A, z, B, o, f, p with *
  have mappedQ := polynomialMap.member at I, A, z, B, o, f, q with *
  have first := polynomialProduct.commutative at I, A, add, z, neg, mul, one, p, q with *
  have second := polynomialProduct.commutative at I, B, plus, o, minus, times, unit, polynomialMap(I, R, S, f)(p), polynomialMap(I, R, S, f)(q) with *
  unfold PolynomialMapMultiplies at equation
  unfold PolynomialMapMultiplies
  cc

theorem PolynomialMapMultiplies.add (p q r : Set)
  requires memberP : p ∈ P
  requires memberQ : q ∈ P
  requires memberR : r ∈ P
  requires first : PolynomialMapMultiplies(I, A, add, z, neg, mul, one, B, plus, o, minus, times, unit, f, p, q)
  requires second : PolynomialMapMultiplies(I, A, add, z, neg, mul, one, B, plus, o, minus, times, unit, f, p, r)
  shows PolynomialMapMultiplies(I, A, add, z, neg, mul, one, B, plus, o, minus, times, unit, f, p, coefficientAdd(monomials(I), A, add, z, neg, mul, one, q, r))
proof
  have function := IsRingHom.function with hom
  have zero := IsRingHom.zero with hom
  have mappedP := polynomialMap.member at I, A, z, B, o, f, p with *
  have mappedQ := polynomialMap.member at I, A, z, B, o, f, q with *
  have mappedR := polynomialMap.member at I, A, z, B, o, f, r with *
  have pq := polynomialProduct.member at I, A, add, z, neg, mul, one, p, q with *
  have pr := polynomialProduct.member at I, A, add, z, neg, mul, one, p, r with *
  have sourceLaw := polynomialProduct.add_right at I, A, add, z, neg, mul, one, p, q, r with *
  have targetLaw := polynomialProduct.add_right at I, B, plus, o, minus, times, unit, polynomialMap(I, R, S, f)(p), polynomialMap(I, R, S, f)(q), polynomialMap(I, R, S, f)(r) with *
  have sum := polynomialMap.coefficient_add at I, A, add, z, neg, mul, one, B, plus, o, minus, times, unit, f, q, r with *
  have products := polynomialMap.coefficient_add at I, A, add, z, neg, mul, one, B, plus, o, minus, times, unit, f, polynomialProduct(I, A, add, z, neg, mul, one, p, q), polynomialProduct(I, A, add, z, neg, mul, one, p, r) with *
  unfold PolynomialMapMultiplies at first
  unfold PolynomialMapMultiplies at second
  unfold PolynomialMapMultiplies
  cc

theorem PolynomialMapMultiplies.terms (a b m n : Set)
  requires coefficientA : a ∈ R
  requires coefficientB : b ∈ R
  requires monomialM : m ∈ monomials(I)
  requires monomialN : n ∈ monomials(I)
  shows PolynomialMapMultiplies(I, A, add, z, neg, mul, one, B, plus, o, minus, times, unit, f, polynomialTerm(I, A, z, a, m), polynomialTerm(I, A, z, b, n))
proof
  have ordinary := IsCommRing.ring with source
  have coefficient := IsRing.mul_closed with ordinary, coefficientA,
    coefficientB
  have imageA := IsRingHom.closed with hom, coefficientA
  have imageB := IsRingHom.closed with hom, coefficientB
  have monomial := monomialProduct.member at I, m, n with *
  have sourceLaw := polynomialProduct.terms at I, A, add, z, neg, mul, one, a, b, m, n with *
  have targetLaw := polynomialProduct.terms at I, B, plus, o, minus, times, unit, f(a), f(b), m, n with *
  have left := polynomialMap.term at I, A, add, z, neg, mul, one, B, plus, o, minus, times, unit, f, a, m with *
  have right := polynomialMap.term at I, A, add, z, neg, mul, one, B, plus, o, minus, times, unit, f, b, n with *
  have product := polynomialMap.term at I, A, add, z, neg, mul, one, B, plus, o, minus, times, unit, f, R[a * b], monomialProduct(I, m, n) with *
  have preserved := IsRingHom.mul with hom, coefficientA, coefficientB
  unfold PolynomialMapMultiplies
  cc

theorem PolynomialMapMultiplies.term (a m q : Set)
  requires coefficient : a ∈ A
  requires monomial : m ∈ monomials(I)
  requires memberQ : q ∈ polynomials(I, A, z)
  shows PolynomialMapMultiplies(I, A, add, z, neg, mul, one, B, plus, o, minus, times, unit, f, polynomialTerm(I, A, z, a, m), q)
proof
  have ordinary := IsCommRing.ring with source
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have zeroPolynomial := polynomials.zero at I, A, add, z, neg, mul, one with *
  have fixed := polynomialTerm.member at I, A, z, a, m with *
  have base : constantFunction(monomials(I), A, z) ∈ polynomialMapProducts(I, A, add, z, neg, mul, one, B, plus, o, minus, times, unit, f, polynomialTerm(I, A, z, a, m))
    apply polynomialMapProducts.membership.backward
    constructor
    . exact zeroPolynomial
    . exact PolynomialMapMultiplies.zero with *
  have terms : ∀ b ∈ A, ∀ n ∈ monomials(I), polynomialTerm(I, A, z, b, n) ∈ polynomialMapProducts(I, A, add, z, neg, mul, one, B, plus, o, minus, times, unit, f, polynomialTerm(I, A, z, a, m))
    intros b hb n hn
    have member := polynomialTerm.member at I, A, z, b, n with *
    apply polynomialMapProducts.membership.backward
    constructor
    . exact member
    . exact PolynomialMapMultiplies.terms with *
  have sums : ∀ u ∈ polynomialMapProducts(I, A, add, z, neg, mul, one, B, plus, o, minus, times, unit, f, polynomialTerm(I, A, z, a, m)), ∀ v ∈ polynomialMapProducts(I, A, add, z, neg, mul, one, B, plus, o, minus, times, unit, f, polynomialTerm(I, A, z, a, m)), coefficientAdd(monomials(I), A, add, z, neg, mul, one, u, v) ∈ polynomialMapProducts(I, A, add, z, neg, mul, one, B, plus, o, minus, times, unit, f, polynomialTerm(I, A, z, a, m))
    intros u hf v hg
    have first := polynomialMapProducts.membership.forward with hf
    have second := polynomialMapProducts.membership.forward with hg
    have member := polynomials.add at I, A, add, z, neg, mul, one, u, v with *
    apply polynomialMapProducts.membership.backward
    constructor
    . exact member
    . exact PolynomialMapMultiplies.add with *
  have generated := polynomials.induction at I, A, add, z, neg, mul, one, polynomialMapProducts(I, A, add, z, neg, mul, one, B, plus, o, minus, times, unit, f, polynomialTerm(I, A, z, a, m)), q with *
  have result := polynomialMapProducts.membership.forward with generated
  exact result.right

theorem polynomialMap.product (p q : Set)
  requires memberP : p ∈ P
  requires memberQ : q ∈ P
  shows polynomialMap(I, R, S, f)(polynomialProduct(I, A, add, z, neg, mul, one, p, q)) = polynomialProduct(I, B, plus, o, minus, times, unit, polynomialMap(I, R, S, f)(p), polynomialMap(I, R, S, f)(q))
proof
  have ordinary := IsCommRing.ring with source
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have zeroPolynomial := polynomials.zero at I, A, add, z, neg, mul, one with *
  have base : constantFunction(monomials(I), A, z) ∈ polynomialMapProducts(I, A, add, z, neg, mul, one, B, plus, o, minus, times, unit, f, q)
    apply polynomialMapProducts.membership.backward
    constructor
    . exact zeroPolynomial
    . exact PolynomialMapMultiplies.zero with *
  have terms : ∀ b ∈ A, ∀ n ∈ monomials(I), polynomialTerm(I, A, z, b, n) ∈ polynomialMapProducts(I, A, add, z, neg, mul, one, B, plus, o, minus, times, unit, f, q)
    intros b hb n hn
    have member := polynomialTerm.member at I, A, z, b, n with *
    apply polynomialMapProducts.membership.backward
    constructor
    . exact member
    . have forward := PolynomialMapMultiplies.term at I, A, add, z, neg, mul, one, B, plus, o, minus, times, unit, f, b, n, q with *
      exact PolynomialMapMultiplies.swap with *
  have sums : ∀ u ∈ polynomialMapProducts(I, A, add, z, neg, mul, one, B, plus, o, minus, times, unit, f, q), ∀ v ∈ polynomialMapProducts(I, A, add, z, neg, mul, one, B, plus, o, minus, times, unit, f, q), coefficientAdd(monomials(I), A, add, z, neg, mul, one, u, v) ∈ polynomialMapProducts(I, A, add, z, neg, mul, one, B, plus, o, minus, times, unit, f, q)
    intros u hf v hg
    have first := polynomialMapProducts.membership.forward with hf
    have second := polynomialMapProducts.membership.forward with hg
    have member := polynomials.add at I, A, add, z, neg, mul, one, u, v with *
    apply polynomialMapProducts.membership.backward
    constructor
    . exact member
    . exact PolynomialMapMultiplies.add with *
  have generated := polynomials.induction at I, A, add, z, neg, mul, one, polynomialMapProducts(I, A, add, z, neg, mul, one, B, plus, o, minus, times, unit, f, q), p with *
  have result := polynomialMapProducts.membership.forward with generated
  exact PolynomialMapMultiplies.swap at
    I, A, add, z, neg, mul, one, B, plus, o, minus, times, unit, f, q, p with *

theorem polynomialMap.mul (p q : Set)
  requires left : p ∈ P
  requires right : q ∈ P
  shows polynomialMap(I, R, S, f)(P[p * q]) = Q[polynomialMap(I, R, S, f)(p) * polynomialMap(I, R, S, f)(q)]
proof
  have function := IsRingHom.function with hom
  have zero := IsRingHom.zero with hom
  have mappedLeft := polynomialMap.member at I, A, z, B, o, f, p with *
  have mappedRight := polynomialMap.member at I, A, z, B, o, f, q with *
  have first := polynomialMul.apply at I, A, add, z, neg, mul, one, p, q with *
  have second := polynomialMul.apply at I, B, plus, o, minus, times, unit, polynomialMap(I, R, S, f)(p), polynomialMap(I, R, S, f)(q) with *
  have value := polynomialMap.product at I, A, add, z, neg, mul, one, B, plus, o, minus, times, unit, f, p, q with *
  cc

theorem polynomialMap.hom
  shows IsRingHom(polynomialMap(I, R, S, f), P, Q)
proof
  have function := IsRingHom.function with hom
  have zero := IsRingHom.zero with hom
  have map := polynomialMap.function at I, A, z, B, o, f with *
  have sourceRing := polynomials.comm_ring at I, A, add, z, neg, mul, one with *
  have targetRing := polynomials.comm_ring at I, B, plus, o, minus, times, unit with *
  apply IsRingHom.of_add_mul_one with sourceRing, targetRing, map
  . intros p left q right
    exact polynomialMap.add with *
  . intros p left q right
    exact polynomialMap.mul with *
  . have oneIn : R[1] ∈ R
      typecheck
    have value := polynomialMap.constant at I, A, add, z, neg, mul, one, B, plus, o, minus, times, unit, f, one with *
    have oneValue := IsRingHom.one with hom
    cc

theorem polynomialMap.injective
  requires injective : InjectiveBetween(f, R, S)
  shows InjectiveBetween(polynomialMap(I, R, S, f), P, Q)
proof
  have function := IsRingHom.function with hom
  have zero := IsRingHom.zero with hom
  have map := polynomialMap.function at I, A, z, B, o, f with *
  unfold InjectiveBetween
  refine ⟨map, ?_⟩
  intros p hp q hq r hr first second
  have valueP := FunctionBetween.apply_value at polynomialMap(I, R, S, f), P, Q, p, r with *
  have valueQ := FunctionBetween.apply_value at polynomialMap(I, R, S, f), P, Q, q, r with *
  apply polynomials.ext with hp, hq
  intros m hm
  have memberP := polynomials.coefficient with hp, hm
  have memberQ := polynomials.coefficient with hq, hm
  have coefficientP := polynomialMap.coefficient with hp, hm
  have coefficientQ := polynomialMap.coefficient with hq, hm
  have equal : f(p(m)) = f(q(m)) by cc
  exact Injective.apply_cancel with *

end Rings
