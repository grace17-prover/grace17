module Grace.Cumulus.Algebra.Polynomial.IndependentSubfamily
import EvaluationOver
import Nonvanishing
import Cardinal.FiniteSubsets

def independentSubfamilies (I A add z neg mul one B plus o minus times unit f v : Set) : Set :=
  {J ∈ 𝒫(I) | AlgebraicallyIndependent(J, A, add, z, neg, mul, one, B, plus, o, minus, times, unit, f, restrict(v, J))}

section Rings
variable (A add z neg mul one B plus o minus times unit f : Set)
notation ring R := (A, add, z, neg, mul, one)
notation ring S := (B, plus, o, minus, times, unit)
hypothesis source : IsCommRing(R)
hypothesis target : IsCommRing(S)
hypothesis hom : IsRingHom(f, R, S)

theorem AlgebraicallyIndependent.empty (v : Set)
  requires injective : InjectiveBetween(f, R, S)
  requires assignment : v : ∅ → S
  shows AlgebraicallyIndependent(∅, R, S, f, v)
proof
  have zeroIn : R[0] ∈ R by typecheck
  have zero := IsRingHom.zero with hom
  apply AlgebraicallyIndependent.of_no_relation with source, target, hom, assignment
  intros p polynomial vanishes
  have used := polynomialVariablesUsed.subset at ∅, A, z, p
  have constant := polynomialVariablesUsed.empty_constant with *
  have monomial := monomialOne.member at ∅
  have coefficient := polynomials.coefficient with *
  have evaluated := polynomialAtOver.constant with coefficient
  have same : f(p(monomialOne(∅))) = f(R[0])
    rw constant at vanishes
    cc
  have coefficientZero := Injective.apply_cancel with injective, coefficient, same
  rw [constant, coefficientZero]
  exact polynomialConstant.zero with *

theorem AlgebraicallyIndependent.maximal_extension (I v J : Set)
  requires finite : Finite(I)
  requires subset : J ⊆ I
  requires independent : AlgebraicallyIndependent(J, R, S, f, restrict(v, J))
  shows ∃ M, M ⊆ I ∧ J ⊆ M ∧ AlgebraicallyIndependent(M, R, S, f, restrict(v, M)) ∧
    (∀ T, T ⊆ I → M ⊆ T → AlgebraicallyIndependent(T, R, S, f, restrict(v, T)) → T = M)
proof
  have powerFinite := Finite.powerset with finite
  have bounded : independentSubfamilies(I, A, add, z, neg, mul, one, B, plus, o, minus, times, unit, f, v) ⊆ 𝒫(I)
    simp [Subset, independentSubfamilies.membership]
  have familyFinite := Finite.subset with powerFinite, bounded
  have inPower := powerset.membership_iff.backward with subset
  have seed : J ∈ independentSubfamilies(I, A, add, z, neg, mul, one, B, plus, o, minus, times, unit, f, v)
    simp [independentSubfamilies.membership]
  obtain ⟨M, member, extends, maximal⟩ := Finite.maximal_extension with familyFinite, seed
  have data : M ∈ 𝒫(I) ∧ AlgebraicallyIndependent(M, R, S, f, restrict(v, M))
    simp [independentSubfamilies.membership]
  have included := powerset.membership_iff.forward with data.left
  refine ⟨M, included, extends, data.right, ?_⟩
  intros T inside contains independentT
  have power := powerset.membership_iff.backward with inside
  have memberT : T ∈ independentSubfamilies(I, A, add, z, neg, mul, one, B, plus, o, minus, times, unit, f, v)
    simp [independentSubfamilies.membership]
  exact maximal with T, memberT, contains

theorem AlgebraicallyIndependent.exists_maximal (I v : Set)
  requires finite : Finite(I)
  requires injective : InjectiveBetween(f, R, S)
  requires assignment : v : I → S
  shows ∃ M, M ⊆ I ∧ AlgebraicallyIndependent(M, R, S, f, restrict(v, M)) ∧
    (∀ T, T ⊆ I → M ⊆ T → AlgebraicallyIndependent(T, R, S, f, restrict(v, T)) → T = M)
proof
  have subset := empty.subset at I
  have closed : ∀ x ∈ ∅, v(x) ∈ S by simp [set.empty]
  have restricted := restrict.function with *
  have empty := AlgebraicallyIndependent.empty with *
  obtain ⟨M, included, extends, independent, maximal⟩ := AlgebraicallyIndependent.maximal_extension at A, add, z, neg, mul, one, B, plus, o, minus, times, unit, f, I, v, ∅ with *
  refine ⟨M, included, independent, maximal⟩

section Relations
variable (I v : Set)
notation ring P := R[I]

theorem AlgebraicallyIndependent.relation_of_dependent
  requires assignment : v : I → S
  requires dependent : ¬AlgebraicallyIndependent(I, R, S, f, v)
  shows ∃ p ∈ P, p ≠ P[0] ∧ polynomialAtOver(I, R, S, f, v)(p) = S[0]
proof
  by_contra absent
  have relations : ∀ p ∈ P, polynomialAtOver(I, R, S, f, v)(p) = S[0] → p = P[0]
    intros p polynomial vanishes
    by_contra nonzero
    apply absent
    refine ⟨p, polynomial, nonzero, vanishes⟩
  have independent := AlgebraicallyIndependent.of_no_relation with *
  exact dependent with independent

end Relations
section Adjoin
variable (I v M j : Set)
notation ring Q := R[insert(j, M)]

theorem AlgebraicallyIndependent.maximal_adjoin_relation
  requires assignment : v : I → S
  requires subset : M ⊆ I
  requires maximal : ∀ T, T ⊆ I → M ⊆ T → AlgebraicallyIndependent(T, R, S, f, restrict(v, T)) → T = M
  requires index : j ∈ I
  requires outside : ¬(j ∈ M)
  shows ∃ p ∈ Q, p ≠ Q[0] ∧
    polynomialAtOver(insert(j, M), R, S, f, restrict(v, insert(j, M)))(p) = S[0]
proof
  have inside : insert(j, M) ⊆ I
    settle with Subset, insert.membership
  have contains : M ⊆ insert(j, M) by simp [Subset, insert.membership]
  have closed : ∀ x ∈ insert(j, M), v(x) ∈ S
    intros x member
    have included := inside
    have inI := included with x, member
    exact FunctionBetween.apply_closed with assignment, inI
  have restricted := restrict.function at v, I, S, insert(j, M), S with *
  have dependent : ¬AlgebraicallyIndependent(insert(j, M), R, S, f, restrict(v, insert(j, M)))
    intro independent
    have equal := maximal with insert(j, M), inside, contains, independent
    have member := insert.self at j, M
    rw equal at member
    exact outside with member
  exact AlgebraicallyIndependent.relation_of_dependent with *

end Adjoin
end Rings
