-- The weak Nullstellensatz for bundled polynomial rings: over an
-- algebraically closed field, finitely many variables, and a set G of
-- polynomials, one lies in the ideal generated by G exactly when G has no
-- common zero; the predicate AlgebraicallyClosed(R) over a bundled field
-- Part of Cumulus, the Grace17 mathematics library.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module Grace.Cumulus.Algebra.Polynomial.BundledNullstellensatz
import BundledIdeals
import Nullstellensatz
import Ring.GeneratedIdeal

-- An algebraically closed field as a property of the bundled ring;
-- IsAlgebraicallyClosed(A, add, zero, neg, mul, one) remains the form over
-- separate pieces, bridged by the instance below.
predicate AlgebraicallyClosed (R : Set) :=
  Field(R) ∧
  IsAlgebraicallyClosed(R.carrier, R.add, R.zero, R.neg, R.mul, R.one)

instance AlgebraicallyClosed.parts (R : Set)
  requires closed : AlgebraicallyClosed(R)
  shows IsAlgebraicallyClosed(R.carrier, R.add, R.zero, R.neg, R.mul, R.one)
proof
  obtain ⟨field, engine⟩ := closed
  exact engine

instance AlgebraicallyClosed.to_field (R : Set)
  requires closed : AlgebraicallyClosed(R)
  shows Field(R)
proof
  obtain ⟨field, engine⟩ := closed
  exact field

theorem AlgebraicallyClosed.of_projections (R : Set)
  requires field : Field(R)
  requires closed : IsAlgebraicallyClosed(R.carrier, R.add, R.zero, R.neg,
    R.mul, R.one)
  shows AlgebraicallyClosed(R)
proof
  unfold BundledNullstellensatz.AlgebraicallyClosed
  exact ⟨field, closed⟩

section Nullstellensatz
variable (R I G : Set)
notation ring K := (R.carrier, R.add, R.zero, R.neg, R.mul, R.one)
notation ring P := K[I]
hypothesis closed : AlgebraicallyClosed(R)
hypothesis finite : Finite(I)
hypothesis generators : G ⊆ polynomialRing(R, I)

-- The weak Nullstellensatz: one is a combination of G exactly when the
-- polynomials of G have no common zero.
theorem polynomialRing.unit_iff_no_common_zero
  shows Ring.one(polynomialRing(R, I)) ∈
      generatedIdeal(polynomialRing(R, I), G) ↔
    ¬(∃ v, (v : I → R.carrier) ∧
      (∀ p ∈ G, evaluationAt(R, I, v)(p) = R[0]))
proof
  have parts := AlgebraicallyClosed.parts with closed
  rw polynomialRing.carrierOf at generators
  have engine := polynomialIdeal.unit_iff_no_common_zero with parts, finite,
    generators
  have same : (∃ v, (v : I → R.carrier) ∧
      (∀ p ∈ G, evaluationAt(R, I, v)(p) = R[0])) ↔
    (∃ v, PolynomialCommonZero(I, K, G, v))
    constructor
    . intro common
      obtain ⟨v, assignment, vanishes⟩ := common
      refine ⟨v, ?_⟩
      unfold PolynomialCommonZero
      refine ⟨assignment, ?_⟩
      intros p hp
      rw ← evaluationAt.graph
      exact vanishes with p, hp
    . intro common
      obtain ⟨v, assignment, vanishes⟩ := common
      refine ⟨v, assignment, ?_⟩
      intros p hp
      rw evaluationAt.graph
      exact vanishes with p, hp
  rw [generatedIdeal.value, polynomialRing.oneOf, polynomialRing.carrierOf,
    polynomialRing.addOf, polynomialRing.zeroOf, polynomialRing.negOf,
    polynomialRing.mulOf]
  tauto

end Nullstellensatz
