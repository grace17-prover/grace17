module Grace.Cumulus.Algebra.Polynomial.HornerForms
import HornerArithmetic

-- The terminal coefficient may be zero: n is a bound, not necessarily the degree.
predicate HornerForm (I A add zero neg mul one j p n a : Set) :=
  a ∈ A ∧ ∃ cs, List(A, cs) ∧ length{A}(cs) = n ∧ p = polynomialFromHorner(I, A, add, zero, neg, mul, one, j, a, cs)

notation scoped HornerForm(I, R, j, p, n, a) => HornerForm(I, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, j, p, n, a)

section Rings
variable (I A add zero neg mul one j : Set)
notation ring R := (A, add, zero, neg, mul, one)
notation ring P := R[I]
hypothesis ring : IsCommRing(R)

theorem HornerForm.of_list (a : Set) (cs : List(A))
  requires initial : a ∈ R
  shows HornerForm(I, R, j, polynomialFromHorner(I, R, j, a, cs), length{A}(cs), a)
proof
  unfold HornerForm
  refine ⟨initial, cs, assumption, rfl, rfl⟩

theorem HornerForm.member (p n a : Set)
  requires form : HornerForm(I, R, j, p, n, a)
  shows p ∈ P
proof
  obtain ⟨initial, cs, list, size, equal⟩ := form
  rw equal
  exact polynomialFromHorner.member with *

theorem HornerForm.constant (a : Set)
  requires initial : a ∈ R
  shows HornerForm(I, R, j, polynomialCoefficients(I, R)(a), (0 : Nat), a)
proof
  have zeroIn : R[0] ∈ R by typecheck
  have empty : List(A, []) by typecheck
  have value := polynomialCoefficients.value at I, A, zero, a with *
  have horner := polynomialFromHorner.nil at I, A, add, zero, neg, mul, one, j, a
  unfold HornerForm
  refine ⟨initial, [], empty, ?_⟩
  constructor
  . exact length.nil with *
  . cc

theorem HornerForm.add (p q n a b : Set)
  requires first : HornerForm(I, R, j, p, n, a)
  requires second : HornerForm(I, R, j, q, n, b)
  shows HornerForm(I, R, j, P[p + q], n, R[a + b])
proof
  obtain ⟨left, cs, csList, csSize, csEqual⟩ := first
  obtain ⟨right, ds, dsList, dsSize, dsEqual⟩ := second
  have ordinary := IsCommRing.ring with ring
  have initial := IsRing.add_closed with ordinary, left, right
  have sizes : length{A}(cs) = length{A}(ds) by cc
  have data := hornerAdd.data at A, add, zero, neg, mul, one, cs, ds with *
  have equation := polynomialFromHorner.add at I, A, add, zero, neg, mul, one, j, a, b, cs, ds with *
  unfold HornerForm
  refine ⟨initial, hornerAdd{A}(add, zero, cs, ds), data.left, ?_⟩
  constructor
  . cc
  . cc

theorem HornerForm.affine_product (p n a b d : Set)
  requires form : HornerForm(I, R, j, p, n, a)
  requires constant : b ∈ R
  requires slope : d ∈ R
  shows HornerForm(I, R, j, P[(polynomialCoefficients(I, R)(b) + polynomialCoefficients(I, R)(d) * polynomialVariable(I, R, j)) * p], succ(n), R[d * a])
proof
  have member := HornerForm.member with *
  obtain ⟨initial, cs, list, size, equal⟩ := form
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have oneIn : R[1] ∈ R by typecheck
  have leading := IsRing.mul_closed with ordinary, slope, initial
  have data := hornerAffineProduct.data at A, add, zero, neg, mul, one, a, b, d, zero, cs with *
  have equation := polynomialFromHorner.affine_product at I, A, add, zero, neg, mul, one, j, a, b, d, zero, cs with *
  have target := polynomials.comm_ring at I, A, add, zero, neg, mul, one with *
  have targetRing := IsCommRing.ring with target
  have hom := polynomialCoefficients.hom at I, A, add, zero, neg, mul, one with *
  have mapsZero := IsRingHom.zero with hom
  have constantIn := IsRingHom.closed with hom, constant
  have slopeIn := IsRingHom.closed with hom, slope
  have variableIn := polynomialVariable.member at I, A, zero, one, j with *
  have linear := IsRing.mul_closed with targetRing, slopeIn, variableIn
  have affine := IsRing.add_closed with targetRing, constantIn, linear
  have product := IsRing.mul_closed with targetRing, affine, member
  have identity := IsRing.add_left_identity with targetRing, product
  unfold HornerForm
  refine ⟨leading, hornerAffineProduct{A}(add, mul, a, b, d, zero, cs), data.left, ?_⟩
  constructor
  . cc
  . cc

theorem HornerForm.scale (p n a b : Set)
  requires form : HornerForm(I, R, j, p, n, b)
  requires scalar : a ∈ R
  shows HornerForm(I, R, j, P[polynomialCoefficients(I, R)(a) * p], n, R[a * b])
proof
  obtain ⟨initial, cs, list, size, equal⟩ := form
  have ordinary := IsCommRing.ring with ring
  have leading := IsRing.mul_closed with ordinary, scalar, initial
  have data := hornerScale.data with scalar
  have equation := polynomialFromHorner.scale at I, A, add, zero, neg, mul, one, j, a, b, cs with *
  unfold HornerForm
  refine ⟨leading, hornerScale{A}(mul, a, cs), data.left, ?_⟩
  constructor
  . cc
  . cc

theorem HornerForm.zero (n : Nat)
  shows HornerForm(I, R, j, P[0], n, R[0])
proof
  induction n
  | zero =>
    have zeroIn : R[0] ∈ R by typecheck
    have hom := polynomialCoefficients.hom at I, A, add, zero, neg, mul, one with *
    have mapsZero := IsRingHom.zero with hom
    have form := HornerForm.constant at I, A, add, zero, neg, mul, one, j, zero with *
    rwa ← mapsZero
  | succ(k) using ih =>
    have zeroIn : R[0] ∈ R by typecheck
    have oneIn : R[1] ∈ R by typecheck
    have target := polynomials.comm_ring at I, A, add, zero, neg, mul, one with *
    have targetRing := IsCommRing.ring with target
    have hom := polynomialCoefficients.hom at I, A, add, zero, neg, mul, one with *
    have mapsZero := IsRingHom.zero with hom
    have mapsOne := IsRingHom.one with hom
    have variableIn := polynomialVariable.member at I, A, zero, one, j with *
    have equation : P[(polynomialCoefficients(I, R)(zero) + polynomialCoefficients(I, R)(one) * polynomialVariable(I, R, j)) * 0] = P[0]
      rw [mapsZero, mapsOne]
      ring
    have leading : R[one * zero] = R[0] by ring
    have form := HornerForm.affine_product at I, A, add, zero, neg, mul, one, j, P[0], k, zero, zero, one with *
    rwa [equation, leading] at form

theorem HornerForm.leading_coefficient (p n a : Set)
  requires index : j ∈ I
  requires form : HornerForm(I, R, j, p, n, a)
  shows p(monomialShift(I, j, monomialOne(I), n)) = a
proof
  obtain ⟨initial, cs, list, size, equal⟩ := form
  have leading := polynomialFromHorner.leading_coefficient at I, A, add, zero, neg, mul, one, j, a, cs with *
  cc

theorem HornerForm.indexed_sum (n k : Nat) (w c f : Set)
  shows (∀ i ∈ k, HornerForm(I, R, j, w(f(i)), n, c(f(i)))) →
    HornerForm(I, R, j, indexedRingSum(w, f, polynomialAdd(I, R), P[0], k), n, indexedRingSum(c, f, add, zero, k))
proof
  induction k
  | zero =>
    intro forms
    rw [indexedRingSum, indexedRingSum]
    exact HornerForm.zero with *
  | succ(r) using ih =>
    intro forms
    have prefix : ∀ i ∈ r, HornerForm(I, R, j, w(f(i)), n, c(f(i)))
      intros i hi
      have next := membership.into_successor at i, r with *
      exact forms with i, next
    have previous := ih with prefix
    have last := forms with r, membership.self_successor at r with *
    rw [indexedRingSum, indexedRingSum]
    exact HornerForm.add with *

theorem HornerForm.finite_sum (n : Nat) (V w c : Set)
  requires finite : Finite(V)
  requires polynomials : w : V → P
  requires coefficients : c : V → R
  requires forms : ∀ i ∈ V, HornerForm(I, R, j, w(i), n, c(i))
  shows HornerForm(I, R, j, finiteRingSum(V, P, w), n, finiteRingSum(V, R, c))
proof
  have target := polynomials.comm_ring at I, A, add, zero, neg, mul, one with *
  have chosen := finiteRingSum.selected at V, A, add, zero, neg, mul, one, c with *
  obtain ⟨k, natural, f, enumeration, coefficientSum⟩ := chosen.right
  have injective := Bijective.injective with enumeration
  have function := Injective.function with injective
  have polynomialSum : finiteRingSum(V, P, w) = indexedRingSum(w, f, polynomialAdd(I, R), P[0], k)
    exact finiteRingSum.enumeration with *
  have entries : ∀ i ∈ k, HornerForm(I, R, j, w(f(i)), n, c(f(i)))
    intros i hi
    have image := FunctionBetween.apply_closed with *
    exact forms with f(i), image
  have result : HornerForm(I, R, j, indexedRingSum(w, f, polynomialAdd(I, R), P[0], k), n, indexedRingSum(c, f, add, zero, k))
    have closure := HornerForm.indexed_sum at I, A, add, zero, neg, mul, one, j, n, k, w, c, f with *
    exact closure with entries
  rwa [polynomialSum, coefficientSum]

theorem HornerForm.indexed_affine_product (k : Nat) (w b d f : Set)
  shows (∀ i ∈ k, b(f(i)) ∈ R ∧ d(f(i)) ∈ R ∧ w(f(i)) = P[polynomialCoefficients(I, R)(b(f(i))) + polynomialCoefficients(I, R)(d(f(i))) * polynomialVariable(I, R, j)]) →
    HornerForm(I, R, j, indexedRingProduct(w, f, polynomialMul(I, R), P[1], k), k, indexedRingProduct(d, f, mul, one, k))
proof
  induction k
  | zero =>
    intro entries
    have oneIn : R[1] ∈ R by typecheck
    have hom := polynomialCoefficients.hom at I, A, add, zero, neg, mul, one with *
    have mapsOne := IsRingHom.one with hom
    have form := HornerForm.constant at I, A, add, zero, neg, mul, one, j, one with *
    rwa [indexedRingProduct, indexedRingProduct, ← mapsOne]
  | succ(r) using ih =>
    intro entries
    have prefix : ∀ i ∈ r, b(f(i)) ∈ R ∧ d(f(i)) ∈ R ∧ w(f(i)) = P[polynomialCoefficients(I, R)(b(f(i))) + polynomialCoefficients(I, R)(d(f(i))) * polynomialVariable(I, R, j)]
      intros i hi
      have next := membership.into_successor at i, r with *
      exact entries with i, next
    have previous := ih with prefix
    have last := entries with r, membership.self_successor at r with *
    obtain ⟨constant, slope, equation⟩ := last
    have polynomial := HornerForm.member at I, A, add, zero, neg, mul, one, j, indexedRingProduct(w, f, polynomialMul(I, R), P[1], r), r, indexedRingProduct(d, f, mul, one, r) with *
    have data := previous
    have topIn := data.left
    have result := HornerForm.affine_product at I, A, add, zero, neg, mul, one, j, indexedRingProduct(w, f, polynomialMul(I, R), P[1], r), r, indexedRingProduct(d, f, mul, one, r), b(f(r)), d(f(r)) with *
    have target := polynomials.comm_ring at I, A, add, zero, neg, mul, one with *
    have hom := polynomialCoefficients.hom at I, A, add, zero, neg, mul, one with *
    have constantIn := IsRingHom.closed with hom, constant
    have slopeIn := IsRingHom.closed with hom, slope
    have zeroIn : R[0] ∈ R by typecheck
    have oneIn : R[1] ∈ R by typecheck
    have variableIn := polynomialVariable.member at I, A, zero, one, j with *
    have commute : P[(polynomialCoefficients(I, R)(b(f(r))) + polynomialCoefficients(I, R)(d(f(r))) * polynomialVariable(I, R, j)) * indexedRingProduct(w, f, polynomialMul(I, R), P[1], r)] =
      P[indexedRingProduct(w, f, polynomialMul(I, R), P[1], r) * w(f(r))]
      rw equation
      ring
    have leadingCommutes : R[d(f(r)) * indexedRingProduct(d, f, mul, one, r)] = R[indexedRingProduct(d, f, mul, one, r) * d(f(r))]
      ring
    rw [commute, leadingCommutes] at result
    rwa [indexedRingProduct, indexedRingProduct]

theorem HornerForm.finite_affine_product (V w b d : Set)
  requires finite : Finite(V)
  requires polynomials : w : V → P
  requires constants : b : V → R
  requires slopes : d : V → R
  requires entries : ∀ i ∈ V, w(i) = P[polynomialCoefficients(I, R)(b(i)) + polynomialCoefficients(I, R)(d(i)) * polynomialVariable(I, R, j)]
  shows HornerForm(I, R, j, finiteRingProduct(V, P, w), cardinality(V), finiteRingProduct(V, R, d))
proof
  have target := polynomials.comm_ring at I, A, add, zero, neg, mul, one with *
  have chosen := finiteRingProduct.selected at V, A, add, zero, neg, mul, one, d with *
  obtain ⟨k, natural, f, enumeration, coefficientProduct⟩ := chosen.right
  have injective := Bijective.injective with enumeration
  have function := Injective.function with injective
  have reverse := converse.bijective at f, k, V with *
  have cardinal : HasCardinality(V, k)
    unfold HasCardinality
    refine ⟨natural, ?_⟩
    unfold Equipotent
    refine ⟨converse(f, k, V), reverse⟩
  have size := cardinality.eq_of_has at V, k with *
  have polynomialProduct : finiteRingProduct(V, P, w) = indexedRingProduct(w, f, polynomialMul(I, R), P[1], k)
    exact finiteRingProduct.enumeration with *
  have affine : ∀ i ∈ k, b(f(i)) ∈ R ∧ d(f(i)) ∈ R ∧ w(f(i)) = P[polynomialCoefficients(I, R)(b(f(i))) + polynomialCoefficients(I, R)(d(f(i))) * polynomialVariable(I, R, j)]
    intros i hi
    have image := FunctionBetween.apply_closed at f, k, V, i with *
    have constant := FunctionBetween.apply_closed at b, V, A, f(i) with *
    have slope := FunctionBetween.apply_closed at d, V, A, f(i) with *
    have equation := entries with f(i), image
    refine ⟨constant, slope, equation⟩
  have result : HornerForm(I, R, j, indexedRingProduct(w, f, polynomialMul(I, R), P[1], k), k, indexedRingProduct(d, f, mul, one, k))
    have closure := HornerForm.indexed_affine_product at I, A, add, zero, neg, mul, one, j, k, w, b, d, f with *
    exact closure with affine
  rwa [polynomialProduct, coefficientProduct, size]

end Rings
