module Grace.Cumulus.Algebra.Polynomial.HornerDegree
import HornerPolynomial
import HornerReconstruction

section Constants
variable (I A add z neg mul one j : Set)
notation ring R := (A, add, z, neg, mul, one)
notation ring P := R[I]
hypothesis ring : IsCommRing(R)
hypothesis index : j ∈ I

theorem polynomialConstant.shift_zero (a : Set) (n : Nat)
  requires coefficient : a ∈ R
  shows polynomialConstant(I, R, a)(monomialShift(I, j, monomialOne(I), succ(n))) = R[0]
proof
  have zeroIn : R[0] ∈ R by typecheck
  have unit := monomialOne.member at I
  have zeroNat := nat.omega.forward with Naturals.constructor.zero
  have absent : monomialOne(I)(j) = (0 : Nat)
    unfold monomialOne
    exact constantFunction.apply with *
  have shifted := monomialShift.member at I, j, monomialOne(I), succ(n) with *
  have exponent := monomialShift.exponent at I, j, monomialOne(I), succ(n) with *
  have distinct : monomialShift(I, j, monomialOne(I), succ(n)) ≠ monomialOne(I)
    intro equal
    have impossible : (0 : Nat) = succ(n) by cc
    exact Naturals.disjoint.zero.succ at n with impossible
  have value := polynomialConstant.value at I, A, z, a, monomialShift(I, j, monomialOne(I), succ(n)) with *
  have selected := singleValue.other at A, z, a, monomialOne(I), monomialShift(I, j, monomialOne(I), succ(n)) with *
  cc

end Constants

section Rings
variable (I A add z neg mul one j leading : Set)
notation ring R := (A, add, z, neg, mul, one)
notation ring P := R[I]
hypothesis ring : IsCommRing(R)
hypothesis index : j ∈ I
hypothesis initial : leading ∈ R

theorem polynomialFromHorner.coefficient_succ (c : Set) (cs : List(A)) (n : Nat)
  requires coefficient : c ∈ R
  shows polynomialFromHorner(I, R, j, leading, c :: cs)(monomialShift(I, j, monomialOne(I), succ(n))) =
    polynomialFromHorner(I, R, j, leading, cs)(monomialShift(I, j, monomialOne(I), n))
proof
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have oneIn : R[1] ∈ R by typecheck
  have unit := monomialOne.member at I
  have variable := monomialVariable.member at I, j
  have previous := monomialShift.member at I, j, monomialOne(I), n with *
  have shifted := monomialShift.member at I, j, monomialOne(I), succ(n) with *
  have constant := polynomialConstant.member at I, A, z, c with *
  have tail := polynomialFromHorner.member at I, A, add, z, neg, mul, one, j, leading, cs with *
  have variablePoly := polynomialVariable.member at I, A, z, one, j with *
  have product := polynomialProduct.member at I, A, add, z, neg, mul, one, polynomialVariable(I, R, j), polynomialFromHorner(I, R, j, leading, cs) with *
  have productOperation := polynomialMul.apply at I, A, add, z, neg, mul, one, polynomialVariable(I, R, j), polynomialFromHorner(I, R, j, leading, cs) with *
  have sumOperation := polynomialAdd.apply at I, A, add, z, neg, mul, one, polynomialConstant(I, R, c), polynomialProduct(I, A, add, z, neg, mul, one, polynomialVariable(I, R, j), polynomialFromHorner(I, R, j, leading, cs)) with *
  have constantFunction := polynomials.function with constant
  have productFunction := polynomials.function with product
  have sumValue := coefficientAdd.value at monomials(I), A, add, z, neg, mul, one, polynomialConstant(I, R, c), polynomialProduct(I, A, add, z, neg, mul, one, polynomialVariable(I, R, j), polynomialFromHorner(I, R, j, leading, cs)), monomialShift(I, j, monomialOne(I), succ(n)) with *
  have constantZero := polynomialConstant.shift_zero at I, A, add, z, neg, mul, one, j, c, n with *
  have step := monomialShift.succ at I, j, monomialOne(I), n with *
  have shiftedValue := polynomialProduct.monomial_shift at I, A, add, z, neg, mul, one, monomialVariable(I, j), monomialShift(I, j, monomialOne(I), n), polynomialFromHorner(I, R, j, leading, cs) with *
  have valueIn := polynomials.coefficient at I, A, z, polynomialFromHorner(I, R, j, leading, cs), monomialShift(I, j, monomialOne(I), n) with *
  have identity := IsRing.add_left_identity with ordinary, valueIn
  have equation := polynomialFromHorner.cons at I, A, add, z, neg, mul, one, j, leading, c, cs with *
  have shiftedProduct : polynomialProduct(I, A, add, z, neg, mul, one, polynomialVariable(I, R, j), polynomialFromHorner(I, R, j, leading, cs))(monomialProduct(I, monomialVariable(I, j), monomialShift(I, j, monomialOne(I), n))) = polynomialFromHorner(I, R, j, leading, cs)(monomialShift(I, j, monomialOne(I), n))
    simp [polynomialVariable]
  rw [productOperation, sumOperation] at equation
  cc

theorem polynomialFromHorner.leading_coefficient (cs : List(A))
  shows polynomialFromHorner(I, R, j, leading, cs)(monomialShift(I, j, monomialOne(I), length{A}(cs))) = leading
proof
  induction cs
  | List.nil =>
    have zeroIn : R[0] ∈ R by typecheck
    have unit := monomialOne.member at I
    have value := polynomialConstant.value at I, A, z, leading, monomialOne(I) with *
    have reflexive : monomialOne(I) = monomialOne(I) by rfl
    have selected := singleValue.same at A, z, leading, monomialOne(I), monomialOne(I) with *
    rw [length.nil, monomialShift.zero, polynomialFromHorner.nil]
    cc
  | List.cons(c, tail) using ih =>
    have coefficient : c ∈ R by assumption
    have shifted := polynomialFromHorner.coefficient_succ at I, A, add, z, neg, mul, one, j, leading, c, tail, length{A}(tail) with *
    rw length.cons
    cc

-- Along the chosen variable, every coefficient beyond the declared length vanishes.
theorem polynomialFromHorner.coefficient_above_length (cs : List(A)) (n : Nat)
  requires bound : length{A}(cs) < n
  shows polynomialFromHorner(I, R, j, leading, cs)(monomialShift(I, j, monomialOne(I), n)) = R[0]
proof
  induction cs generalizing n
  | List.nil =>
    intros n nNat bound
    rw length.nil at bound
    have shape := natural.zero_or_successor with *
    cases shape with zero | successor
    . have impossible : (0 : Nat) < (0 : Nat)
        arith
      exfalso
      have irreflexive := Less.irreflexive with Naturals.constructor.zero
      exact irreflexive with impossible
    . obtain ⟨k, kNat, equal⟩ := successor
      rw [equal, polynomialFromHorner.nil]
      exact polynomialConstant.shift_zero with *
  | List.cons(c, tail) using ih =>
    intros n nNat bound
    have coefficient : c ∈ R by assumption
    rw length.cons at bound
    have shape := natural.zero_or_successor with *
    cases shape with zero | successor
    . have impossible : (0 : Nat) < (0 : Nat)
        arith
      exfalso
      have irreflexive := Less.irreflexive with Naturals.constructor.zero
      exact irreflexive with impossible
    . obtain ⟨k, kNat, equal⟩ := successor
      have smaller : length{A}(tail) < k by arith
      have previous := ih with k, kNat, smaller
      have shifted := polynomialFromHorner.coefficient_succ at I, A, add, z, neg, mul, one, j, leading, c, tail, k with *
      rw equal
      cc

theorem polynomialFromHorner.leading_unique (other : Set) (cs ds : List(A))
  requires otherIn : other ∈ R
  requires sameLength : length{A}(cs) = length{A}(ds)
  requires equal : polynomialFromHorner(I, R, j, leading, cs) = polynomialFromHorner(I, R, j, other, ds)
  shows leading = other
proof
  have first := polynomialFromHorner.leading_coefficient at I, A, add, z, neg, mul, one, j, leading, cs with *
  have second := polynomialFromHorner.leading_coefficient at I, A, add, z, neg, mul, one, j, other, ds with *
  cc

theorem polynomialFromHorner.length_unique (other : Set) (cs ds : List(A))
  requires otherIn : other ∈ R
  requires leadingNonzero : leading ≠ R[0]
  requires otherNonzero : other ≠ R[0]
  requires equal : polynomialFromHorner(I, R, j, leading, cs) = polynomialFromHorner(I, R, j, other, ds)
  shows length{A}(cs) = length{A}(ds)
proof
  have comparison := Less.trichotomy at length{A}(cs), length{A}(ds) with *
  have alternatives : length{A}(cs) < length{A}(ds) ∨ length{A}(cs) = length{A}(ds) ∨ length{A}(ds) < length{A}(cs)
    tauto
  cases alternatives with smaller | rest
  . have above := polynomialFromHorner.coefficient_above_length at I, A, add, z, neg, mul, one, j, leading, cs, length{A}(ds) with *
    have top := polynomialFromHorner.leading_coefficient at I, A, add, z, neg, mul, one, j, other, ds with *
    exfalso
    apply otherNonzero
    cc
  . cases rest with same | larger
    . exact same
    . have above := polynomialFromHorner.coefficient_above_length at I, A, add, z, neg, mul, one, j, other, ds, length{A}(cs) with *
      have top := polynomialFromHorner.leading_coefficient at I, A, add, z, neg, mul, one, j, leading, cs with *
      exfalso
      apply leadingNonzero
      cc

theorem polynomialFromHorner.nonzero_of_leading (cs : List(A))
  requires nonzero : leading ≠ R[0]
  shows polynomialFromHorner(I, R, j, leading, cs) ≠ P[0]
proof
  have zeroIn : R[0] ∈ R by typecheck
  have unit := monomialOne.member at I
  have shifted := monomialShift.member at I, j, monomialOne(I), length{A}(cs) with *
  have coefficient := polynomialFromHorner.leading_coefficient at I, A, add, z, neg, mul, one, j, leading, cs with *
  have zeroValue := constantFunction.apply at monomials(I), A, monomialShift(I, j, monomialOne(I), length{A}(cs)), z with *
  intro equal
  apply nonzero
  cc

end Rings
