module Grace.Cumulus.Algebra.Polynomial.MonomialGeneration
import Monomial
import CoefficientInduction

theorem monomialSingle.member (I j : Set, n : Nat)
  shows coefficientSingle(I, ℕ, 0, n, j) ∈ monomials(I)
proof
  have zeroIn := nat.omega.forward with Naturals.constructor.zero
  have nIn := nat.omega.forward at n with *
  have map := CoefficientMap.single at I, ℕ, 0, n, j with *
  exact monomials.contains with map

theorem monomialSingle.zero (I j : Set)
  shows coefficientSingle(I, ℕ, 0, 0, j) = monomialOne(I)
proof
  have zeroIn := nat.omega.forward with Naturals.constructor.zero
  have function := coefficientSingle.function at I, ℕ, 0, 0, j with *
  have unit := monomialOne.member at I
  have unitFunction := monomials.function with unit
  apply FunctionBetween.ext with function, unitFunction
  intros i hi
  have value := coefficientSingle.value at I, ℕ, 0, 0, j, i with *
  have selected := singleValue.zero at ℕ, 0, j, i with *
  have unitValue := monomialOne.value with hi
  cc

theorem monomialSingle.succ (I j : Set, n : Nat)
  requires index : j ∈ I
  shows coefficientSingle(I, ℕ, 0, n + 1, j) = monomialProduct(I, monomialVariable(I, j), coefficientSingle(I, ℕ, 0, n, j))
proof
  have zeroIn := nat.omega.forward with Naturals.constructor.zero
  have nIn := nat.omega.forward at n with *
  have successorIn := nat.omega.forward at n + 1 with *
  have first := monomialSingle.member at I, j, n + 1 with *
  have second := monomialSingle.member at I, j, n with *
  have variable := monomialVariable.member at I, j
  have product := monomialProduct.member at I, monomialVariable(I, j), coefficientSingle(I, ℕ, 0, n, j) with *
  apply monomials.ext with first, product
  intros i hi
  have value := monomialProduct.value at I, monomialVariable(I, j), coefficientSingle(I, ℕ, 0, n, j), i with *
  rw value
  have alternatives : i = j ∨ i ≠ j by tauto
  cases alternatives with same | different
  . rw same
    have left := coefficientSingle.same at I, ℕ, 0, n + 1, j with *
    have right := coefficientSingle.same at I, ℕ, 0, n, j with *
    have variableValue := monomialVariable.same at I, j with *
    rw [left, right, variableValue]
    exact add.commutative with *
  . have left := coefficientSingle.other at I, ℕ, 0, n + 1, j, i with *
    have right := coefficientSingle.other at I, ℕ, 0, n, j, i with *
    have variableValue := monomialVariable.other with *
    rw [left, right, variableValue]
    symm
    exact add.right_unit with *

theorem monomialErase.member (I m j : Set)
  requires member : m ∈ monomials(I)
  shows coefficientErase(I, ℕ, 0, m, j) ∈ monomials(I)
proof
  have zeroIn := nat.omega.forward with Naturals.constructor.zero
  have map := monomials.map with member
  have function := CoefficientMap.function with map
  have finite := CoefficientMap.finite_support with map
  have erased := coefficientErase.function at I, ℕ, 0, m, j with *
  have support := coefficientErase.support at I, ℕ, 0, m, j with *
  have bounded : functionSupport(coefficientErase(I, ℕ, 0, m, j), I, 0) ⊆ functionSupport(m, I, 0)
    intros i hi
    have data := support with i, hi
    have difference := difference.membership.forward with data
    exact difference.left
  have finiteSupport := Finite.subset with finite, bounded
  apply monomials.contains
  unfold CoefficientMap
  refine ⟨erased, finiteSupport⟩

theorem monomialErase.restore (I m j : Set)
  requires member : m ∈ monomials(I)
  requires index : j ∈ I
  shows monomialProduct(I, coefficientSingle(I, ℕ, 0, m(j), j), coefficientErase(I, ℕ, 0, m, j)) = m
proof
  have zeroIn := nat.omega.forward with Naturals.constructor.zero
  have function := monomials.function with member
  have exponent := monomials.exponent with *
  have exponentIn := nat.omega.forward at m(j) with *
  have single := monomialSingle.member at I, j, m(j) with *
  have erased := monomialErase.member at I, m, j with *
  have product := monomialProduct.member at I, coefficientSingle(I, ℕ, 0, m(j), j), coefficientErase(I, ℕ, 0, m, j) with *
  apply monomials.ext with product, member
  intros i hi
  have natural := monomials.exponent at I, m, i with *
  have value := monomialProduct.value at I, coefficientSingle(I, ℕ, 0, m(j), j), coefficientErase(I, ℕ, 0, m, j), i with *
  rw value
  have alternatives : i = j ∨ i ≠ j by tauto
  cases alternatives with same | different
  . rw same
    have left := coefficientSingle.same at I, ℕ, 0, m(j), j with *
    have right := coefficientErase.same at I, ℕ, 0, m, j with *
    rw [left, right]
    exact add.right_unit with *
  . have left := coefficientSingle.other at I, ℕ, 0, m(j), j, i with *
    have right := coefficientErase.other with zeroIn, function, different
    rw [left, right]
    exact add.left_unit with *

section Generation
variable (I T : Set)
hypothesis unit : monomialOne(I) ∈ T
hypothesis variables : ∀ j ∈ I, monomialVariable(I, j) ∈ T
hypothesis products : ∀ m ∈ T, ∀ n ∈ T, monomialProduct(I, m, n) ∈ T

theorem monomials.single_generated (j : Set, n : Nat)
  requires index : j ∈ I
  shows coefficientSingle(I, ℕ, 0, n, j) ∈ T
proof
  induction n
  | zero =>
    rw monomialSingle.zero
    exact unit
  | succ(k) using ih =>
    have variable := variables with j, index
    have next := products with monomialVariable(I, j), variable, coefficientSingle(I, ℕ, 0, k, j), ih
    have equation := monomialSingle.succ at I, j, k with *
    have successor := add.right_one at k with *
    rw successor at equation
    rw equation
    exact next

theorem monomials.generated_list (xs : List(I))
  shows ∀ m ∈ monomials(I), functionSupport(m, I, 0) ⊆ listSupport{I}(xs) → m ∈ T
proof
  induction xs
  | List.nil =>
    intros f member covers
    have function := monomials.function with member
    have zeroIn := nat.omega.forward with Naturals.constructor.zero
    rw listSupport at covers
    have zeroFunction := constantFunction.function at I, ℕ, 0 with *
    have equal : f = constantFunction(I, ℕ, 0)
      apply FunctionBetween.ext with function, zeroFunction
      intros i hi
      have absent : ¬(i ∈ functionSupport(f, I, 0))
        intro supported
        have impossible := covers with i, supported
        exact set.empty with impossible
      have vanishes := functionSupport.outside with *
      have value := constantFunction.apply at I, ℕ, i, 0 with *
      cc
    rw equal
    unfold monomialOne at unit
    exact unit
  | List.cons(j, tail) using ih =>
    intros f member covers
    have function := monomials.function with member
    have zeroIn := nat.omega.forward with Naturals.constructor.zero
    have index : j ∈ I by assumption
    rw listSupport at covers
    have erased := coefficientErase.function at I, ℕ, 0, f, j with *
    have support := coefficientErase.support at I, ℕ, 0, f, j with *
    have smaller : functionSupport(coefficientErase(I, ℕ, 0, f, j), I, 0) ⊆ listSupport{I}(tail)
      intros i hi
      have data := support with i, hi
      have difference := difference.membership.forward with data
      have covered := covers with i, difference.left
      have alternatives := insert.membership.forward with covered
      cases alternatives with equal | old
      . have singleton : i ∈ {j}
          simp
        exfalso
        exact difference.right with singleton
      . exact old
    have erasedMember := monomialErase.member at I, f, j with *
    have rest := ih with coefficientErase(I, ℕ, 0, f, j), erasedMember, smaller
    have exponent := monomials.exponent with member, index
    have single := monomials.single_generated with *
    have next := products with coefficientSingle(I, ℕ, 0, f(j), j), single, coefficientErase(I, ℕ, 0, f, j), rest
    have restore := monomialErase.restore with member, index
    rwa restore at next

theorem monomials.induction (m : Set)
  requires member : m ∈ monomials(I)
  shows m ∈ T
proof
  have map := monomials.map with member
  have finite := CoefficientMap.finite_support with map
  have subset := functionSupport.subset at m, I, 0
  obtain ⟨xs, list, covers⟩ := Finite.cover_in with finite, subset
  have generated := monomials.generated_list with *
  exact generated with m, member, covers

end Generation
