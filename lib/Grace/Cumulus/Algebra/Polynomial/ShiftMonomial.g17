-- The shifted monomial: the monomial m with its exponent at i raised by
-- one, which is the product of m by the monomial of Xᵢ, so a monomial,
-- injective in m, and never the unit monomial or a variable other than Xᵢ;
-- and every monomial with a nonzero exponent at i is a shift.
-- Part of Cumulus, the Grace17 mathematics library.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module Grace.Cumulus.Algebra.Polynomial.ShiftMonomial
import Grace.Cumulus.Algebra.Polynomial.MonomialShift
import Grace.Cumulus.Algebra.Polynomial.MonomialGeneration

-- The monomial m with its exponent at i raised by one.
def shiftMonomial (I m i : Set) : Set :=
  { e ∈ I × ℕ | (fst(e) = i ∧ snd(e) = succ(m(i))) ∨
    (fst(e) ≠ i ∧ snd(e) = m(fst(e))) }

-- The shifted monomial: a graph on I with the raised exponent at i and
-- the old exponents elsewhere, which is the product of m by the monomial
-- of Xᵢ, so a monomial, injective in m, and never the unit monomial or a
-- variable other than Xᵢ.
section Shift
variable (I i : Set)
hypothesis index : i ∈ I

theorem shiftMonomial.function (m : Set)
  requires member : m ∈ monomials(I)
  shows shiftMonomial(I, m, i) : I → ℕ
proof
  have function := monomials.function with member
  constructor
  . intros e he
    exact he.left
  constructor
  . intros x y relatedY z relatedZ
    obtain ⟨_, shapeY⟩ := relatedY
    obtain ⟨_, shapeZ⟩ := relatedZ
    simp [fst.pair, snd.pair] at shapeY, shapeZ
    rcases shapeY with ⟨sameY, valueY⟩ | ⟨otherY, valueY⟩
    . rcases shapeZ with ⟨sameZ, valueZ⟩ | ⟨otherZ, valueZ⟩
      . cc
      . exfalso
        exact otherZ with sameY
    . rcases shapeZ with ⟨sameZ, valueZ⟩ | ⟨otherZ, valueZ⟩
      . exfalso
        exact otherY with sameZ
      . cc
  . intros x hx
    have alternatives : x = i ∨ x ≠ i by tauto
    cases alternatives with same | other
    . have exponent := monomials.exponent with member, index
      have successor := Naturals.constructor.succ with exponent
      have successorIn := nat.omega.forward with successor
      refine ⟨succ(m(i)), successorIn, _⟩
      apply shiftMonomial.membership.backward
      refine ⟨(product.pair with hx, successorIn), _⟩
      rw same
      simp [fst.pair, snd.pair]
    . have valueIn := FunctionBetween.apply_closed with function, hx
      refine ⟨m(x), valueIn, _⟩
      apply shiftMonomial.membership.backward
      refine ⟨(product.pair with hx, valueIn), _⟩
      simp [fst.pair, snd.pair, other]

theorem shiftMonomial.same (m : Set)
  requires member : m ∈ monomials(I)
  shows shiftMonomial(I, m, i)(i) = succ(m(i))
proof
  have function := shiftMonomial.function at I, i, m with *
  have exponent := monomials.exponent with member, index
  have successor := Naturals.constructor.succ with exponent
  have successorIn := nat.omega.forward with successor
  have related : relates(shiftMonomial(I, m, i), i, succ(m(i)))
    apply shiftMonomial.membership.backward
    refine ⟨(product.pair with index, successorIn), _⟩
    simp [fst.pair, snd.pair]
  exact FunctionBetween.apply_value with function, index, related

theorem shiftMonomial.other (m j : Set)
  requires member : m ∈ monomials(I)
  requires other : j ∈ I
  requires apart : j ≠ i
  shows shiftMonomial(I, m, i)(j) = m(j)
proof
  have function := shiftMonomial.function at I, i, m with *
  have valueIn :=
    FunctionBetween.apply_closed with (monomials.function with member), other
  have related : relates(shiftMonomial(I, m, i), j, m(j))
    apply shiftMonomial.membership.backward
    refine ⟨(product.pair with other, valueIn), _⟩
    simp [fst.pair, snd.pair, apart]
  exact FunctionBetween.apply_value with function, other, related

theorem shiftMonomial.product (m : Set)
  requires member : m ∈ monomials(I)
  shows shiftMonomial(I, m, i) = monomialProduct(I, monomialVariable(I, i), m)
proof
  have variable := monomialVariable.member at I, i
  have product := monomialProduct.member with variable, member
  have left := shiftMonomial.function at I, i, m with *
  have right := monomials.function with product
  apply FunctionBetween.ext with left, right
  intros j hj
  have exponent := monomials.exponent with member, hj
  have value :=
    monomialProduct.value at I, monomialVariable(I, i), m, j with *
  rw value
  have alternatives : j = i ∨ j ≠ i by tauto
  cases alternatives with same | apart
  . rw same
    have shifted := shiftMonomial.same at I, i, m with *
    have unit := monomialVariable.same at I, i with index
    have exponentI := monomials.exponent with member, index
    have successor := add.right_one at m(i) with *
    rw [shifted, unit, ← successor]
    exact add.commutative with *
  . have shifted := shiftMonomial.other at I, i, m, j with *
    have unit := monomialVariable.other at I, i, j with hj, apart
    rw [shifted, unit]
    symm
    exact add.left_unit with *

theorem shiftMonomial.member (m : Set)
  requires member : m ∈ monomials(I)
  shows shiftMonomial(I, m, i) ∈ monomials(I)
proof
  have variable := monomialVariable.member at I, i
  rw shiftMonomial.product at I, i, m with *
  exact monomialProduct.member with variable, member

theorem shiftMonomial.injective (m n : Set)
  requires left : m ∈ monomials(I)
  requires right : n ∈ monomials(I)
  requires equal : shiftMonomial(I, m, i) = shiftMonomial(I, n, i)
  shows m = n
proof
  have variable := monomialVariable.member at I, i
  have productM := shiftMonomial.product at I, i, m with *
  have productN := shiftMonomial.product at I, i, n with *
  rw [productM, productN] at equal
  exact monomialProduct.cancel with variable, left, right, equal

theorem shiftMonomial.exponent_nonzero (m : Set)
  requires member : m ∈ monomials(I)
  shows shiftMonomial(I, m, i)(i) ≠ 0
proof
  have shifted := shiftMonomial.same at I, i, m with *
  rw shifted
  intro equal
  symm at equal
  exact Naturals.disjoint.zero.succ at m(i) with equal

theorem shiftMonomial.ne_one (m : Set)
  requires member : m ∈ monomials(I)
  shows shiftMonomial(I, m, i) ≠ monomialOne(I)
proof
  have nonzero := shiftMonomial.exponent_nonzero at I, i, m with *
  have unit := monomialOne.value at I, i with index
  intro equal
  apply nonzero
  rw equal
  exact unit

theorem shiftMonomial.ne_variable (m j : Set)
  requires member : m ∈ monomials(I)
  requires other : j ∈ I
  requires apart : j ≠ i
  shows shiftMonomial(I, m, i) ≠ monomialVariable(I, j)
proof
  have nonzero := shiftMonomial.exponent_nonzero at I, i, m with *
  have reverse : i ≠ j by cc
  have vanishes := monomialVariable.other at I, j, i with index, reverse
  intro equal
  apply nonzero
  rw equal
  exact vanishes

-- A monomial with a positive exponent at i is a shifted monomial.
theorem monomials.unshift (m : Set)
  requires member : m ∈ monomials(I)
  requires nonzero : m(i) ≠ 0
  shows ∃ n ∈ monomials(I), m = shiftMonomial(I, n, i)
proof
  have exponent := monomials.exponent with member, index
  have shape := natural.zero_or_successor at m(i) with *
  cases shape with vanishes | successor
  . exfalso
    exact nonzero with vanishes
  . obtain ⟨k, kNat, equal⟩ := successor
    have variable := monomialVariable.member at I, i
    have restore := monomialErase.restore with member, index
    have single := monomialSingle.member at I, i, k with *
    have erased := monomialErase.member at I, m, i with *
    have split := monomialSingle.succ at I, i, k with index
    have plusOne := add.right_one at k with *
    rw plusOne at split
    rw [equal, split] at restore
    have rest := monomialProduct.member with single, erased
    have reassociate :=
      monomialProduct.associative with variable, single, erased
    have shifted := shiftMonomial.product at I, i,
      monomialProduct(I, coefficientSingle(I, ℕ, 0, k, i),
        coefficientErase(I, ℕ, 0, m, i)) with *
    refine ⟨monomialProduct(I, coefficientSingle(I, ℕ, 0, k, i),
      coefficientErase(I, ℕ, 0, m, i)), rest, _⟩
    cc

end Shift
