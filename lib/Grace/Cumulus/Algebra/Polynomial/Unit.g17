module Grace.Cumulus.Algebra.Polynomial.Unit
import Distributivity

theorem polynomialConstant.support (I A zero a : Set)
  requires zeroIn : zero ∈ A
  requires coefficient : a ∈ A
  shows functionSupport(polynomialConstant(I, A, zero, a), monomials(I), zero) ⊆ {monomialOne(I)}
proof
  unfold polynomialConstant
  unfold polynomialTerm
  exact coefficientSingle.support with *

section Rings
variable (I A add zero neg mul one p : Set)
hypothesis ring : IsCommRing(A, add, zero, neg, mul, one)
hypothesis member : p ∈ polynomials(I, A, zero)
notation ring R := (A, add, zero, neg, mul, one)

theorem polynomialProduct.one_right
  shows polynomialProduct(I, A, add, zero, neg, mul, one, p, polynomialConstant(I, A, zero, one)) = p
proof
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have multiplicative := IsRing.multiplicative with ordinary
  have oneIn := IsMonoid.unit_in_carrier with multiplicative
  have unit := monomialOne.member at I
  have unitPolynomial := polynomialConstant.member at I, A, zero, one with *
  have unitValue := polynomialConstant.coefficient at I, A, zero, one with *
  have unitSupport := polynomialConstant.support at I, A, zero, one with *
  have support := functionSupport.subset at p, monomials(I), zero
  have singletonSubset : {monomialOne(I)} ⊆ monomials(I)
    settle with Subset, singleton.membership
  have finiteSupport := polynomials.finite_support with member
  have finiteSingleton := Finite.singleton at monomialOne(I)
  have finite := Finite.product with finiteSupport, finiteSingleton
  have domain := product.monotone with support, singletonSubset
  have reflexive : functionSupport(p, monomials(I), zero) ⊆ functionSupport(p, monomials(I), zero)
    settle with Subset
  have covers : convolutionPairs(I, zero, p, polynomialConstant(I, A, zero, one)) ⊆ functionSupport(p, monomials(I), zero) × {monomialOne(I)}
    unfold convolutionPairs
    exact product.monotone with reflexive, unitSupport
  have weights := boundedConvolutionWeights.function at I, functionSupport(p, monomials(I), zero) × {monomialOne(I)}, A, add, zero, neg, mul, one, p, polynomialConstant(I, A, zero, one) with *
  have target := polynomials.function with member
  have values : ∀ t ∈ functionSupport(p, monomials(I), zero) × {monomialOne(I)}, boundedConvolutionWeights(I, functionSupport(p, monomials(I), zero) × {monomialOne(I)}, A, add, zero, neg, mul, one, p, polynomialConstant(I, A, zero, one))(t) = p(monomialMul(I)(t))
    intros t ht
    obtain ⟨bound, u, hu, v, hv, shape⟩ := product.membership.forward at t, functionSupport(p, monomials(I), zero), {monomialOne(I)} with ht
    have equal := singleton.membership.forward at v, monomialOne(I) with hv
    have data := functionSupport.membership.forward at p, monomials(I), zero, u with hu
    have inD : (u, monomialOne(I)) ∈ functionSupport(p, monomials(I), zero) × {monomialOne(I)}
      have singleton := singleton.self at monomialOne(I)
      exact product.pair with hu, singleton
    have coefficient := polynomials.coefficient at I, A, zero, p, u with *
    have output := boundedConvolutionWeights.pair at I, functionSupport(p, monomials(I), zero) × {monomialOne(I)}, A, add, zero, neg, mul, one, p, polynomialConstant(I, A, zero, one), u, monomialOne(I) with *
    have index := monomialMul.apply at I, u, monomialOne(I) with *
    unfold call2 at index
    have unitLaw := monomialProduct.one at I, u with *
    have scalarUnit : p(u) * one = p(u)
      ring
    cc
  have injective : ∀ t ∈ functionSupport(p, monomials(I), zero) × {monomialOne(I)}, ∀ s ∈ functionSupport(p, monomials(I), zero) × {monomialOne(I)}, monomialMul(I)(t) = monomialMul(I)(s) → t = s
    intros t ht s hs equalImages
    obtain ⟨boundT, u, hu, v, hv, shapeT⟩ := product.membership.forward at t, functionSupport(p, monomials(I), zero), {monomialOne(I)} with ht
    obtain ⟨boundS, x, hx, y, hy, shapeS⟩ := product.membership.forward at s, functionSupport(p, monomials(I), zero), {monomialOne(I)} with hs
    have equalV := singleton.membership.forward at v, monomialOne(I) with hv
    have equalY := singleton.membership.forward at y, monomialOne(I) with hy
    have dataU := functionSupport.membership.forward at p, monomials(I), zero, u with hu
    have dataX := functionSupport.membership.forward at p, monomials(I), zero, x with hx
    have indexU := monomialMul.apply at I, u, monomialOne(I) with *
    have indexX := monomialMul.apply at I, x, monomialOne(I) with *
    unfold call2 at indexU
    unfold call2 at indexX
    have unitU := monomialProduct.one at I, u with *
    have unitX := monomialProduct.one at I, x with *
    cc
  have coverage : ∀ c ∈ monomials(I), p(c) ≠ zero → ∃ t ∈ functionSupport(p, monomials(I), zero) × {monomialOne(I)}, monomialMul(I)(t) = c
    intros c hc nonzero
    have supported : c ∈ functionSupport(p, monomials(I), zero)
      apply functionSupport.membership.backward at p, monomials(I), zero, c
      refine ⟨hc, nonzero⟩
    have singleton : monomialOne(I) ∈ {monomialOne(I)}
      settle with singleton.membership
    have pair := product.pair with supported, singleton
    have index := monomialMul.apply at I, c, monomialOne(I) with *
    unfold call2 at index
    have unitLaw := monomialProduct.one at I, c with *
    refine ⟨(c, monomialOne(I)), pair, _⟩
    cc
  have reconstructed := finitePushforward.reconstruct at functionSupport(p, monomials(I), zero) × {monomialOne(I)}, monomials(I), A, add, zero, neg, mul, one, monomialMul(I), boundedConvolutionWeights(I, functionSupport(p, monomials(I), zero) × {monomialOne(I)}, A, add, zero, neg, mul, one, p, polynomialConstant(I, A, zero, one)), p with *
  have bounded := polynomialProduct.on_domain with ring, member, unitPolynomial, domain, finite, covers
  cc

theorem polynomialProduct.one_left
  shows polynomialProduct(I, A, add, zero, neg, mul, one, polynomialConstant(I, A, zero, one), p) = p
proof
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have multiplicative := IsRing.multiplicative with ordinary
  have oneIn := IsMonoid.unit_in_carrier with multiplicative
  have unitPolynomial := polynomialConstant.member at I, A, zero, one with *
  have commutative := polynomialProduct.commutative at I, A, add, zero, neg, mul, one, polynomialConstant(I, A, zero, one), p with *
  have right := polynomialProduct.one_right with ring, member
  cc

end Rings
