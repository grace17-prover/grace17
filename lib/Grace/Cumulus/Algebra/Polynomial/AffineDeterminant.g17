-- Authors: Grant Passmore

module Grace.Cumulus.Algebra.Polynomial.AffineDeterminant
import HornerForms

section Rings
variable (I A add zero neg mul one j : Set)
notation ring R := (A, add, zero, neg, mul, one)
notation ring P := R[I]
hypothesis ring : IsCommRing(R)

-- det(B+XD) has a length-n Horner representation with terminal coefficient det(D).
theorem determinant.affine_horner (n : Nat) (M B D : Set)
  requires matrixM : RingMatrix(n, P, M)
  requires matrixB : RingMatrix(n, R, B)
  requires matrixD : RingMatrix(n, R, D)
  requires entries : ∀ r ∈ n, ∀ c ∈ n, M[r, c] = P[polynomialCoefficients(I, R)(B[r, c]) + polynomialCoefficients(I, R)(D[r, c]) * polynomialVariable(I, R, j)]
  shows HornerForm(I, R, j, determinant(n, P, M), n, determinant(n, R, D))
proof
  have finite := Finite.natural at n with *
  have permutationsFinite := permutations.finite with finite
  have target := polynomials.comm_ring at I, A, add, zero, neg, mul, one with *
  have hom := polynomialCoefficients.hom at I, A, add, zero, neg, mul, one with *
  have size := cardinality.natural at n with *
  have polynomialTerms := determinantTerms.function at n, P, polynomialAdd(I, R), P[0], polynomialNeg(I, R), polynomialMul(I, R), P[1], M with *
  have coefficientTerms := determinantTerms.function at n, A, add, zero, neg, mul, one, D with *
  have forms : ∀ p ∈ permutations(n), HornerForm(I, R, j, determinantTerms(n, P, M)(p), n, determinantTerms(n, R, D)(p))
    intros p hp
    have permutation := permutations.membership.forward with hp
    have injective := Bijective.injective with permutation
    have function := Injective.function with injective
    have polynomialEntries := permutationEntries.function at n, P, M, p with *
    have constantEntries := permutationEntries.function at n, A, B, p with *
    have slopeEntries := permutationEntries.function at n, A, D, p with *
    have affine : ∀ r ∈ n, permutationEntries(n, P, M, p)(r) = P[polynomialCoefficients(I, R)(permutationEntries(n, R, B, p)(r)) + polynomialCoefficients(I, R)(permutationEntries(n, R, D, p)(r)) * polynomialVariable(I, R, j)]
      intros r hr
      have column := FunctionBetween.apply_closed at p, n, n, r with *
      have left := permutationEntries.value at n, P, M, p, r with *
      have constant := permutationEntries.value at n, A, B, p, r with *
      have slope := permutationEntries.value at n, A, D, p, r with *
      have equation := entries with r, hr, p(r), column
      cc
    have product := HornerForm.finite_affine_product at I, A, add, zero, neg, mul, one, j, n, permutationEntries(n, P, M, p), permutationEntries(n, R, B, p), permutationEntries(n, R, D, p) with *
    rw size at product
    have mappedSign := permutationSign.map at A, add, zero, neg, mul, one, P, polynomialAdd(I, R), P[0], polynomialNeg(I, R), polynomialMul(I, R), P[1], polynomialCoefficients(I, R), n, p with *
    have scaled := HornerForm.scale at I, A, add, zero, neg, mul, one, j, finiteRingProduct(n, P, permutationEntries(n, P, M, p)), n, permutationSign(n, R, p), finiteRingProduct(n, R, permutationEntries(n, R, D, p)) with *
    have polynomialTerm := determinantTerms.value at n, P, polynomialAdd(I, R), P[0], polynomialNeg(I, R), polynomialMul(I, R), P[1], M, p with *
    have coefficientTerm := determinantTerms.value at n, A, add, zero, neg, mul, one, D, p with *
    rwa [polynomialTerm, coefficientTerm, ← mappedSign]
  have result := HornerForm.finite_sum at I, A, add, zero, neg, mul, one, j, n, permutations(n), determinantTerms(n, P, M), determinantTerms(n, R, D) with *
  unfold determinant
  unfold determinant
  exact result

end Rings
