module Grace.Cumulus.Algebra.Polynomial.Nullstellensatz
import MatrixAnnihilator
import IntegralFinite
import NullstellensatzReduction
import InfiniteFieldLocalization
import EmptyVariables
import TranscendenceLocalization
import Field.Rigidity
import Field.Infinite

section ZariskiFamilies
variable (I M A add zero neg mul one B plus z minus times unit f v : Set)
notation ring R := (A, add, zero, neg, mul, one)
notation ring S := (B, plus, z, minus, times, unit)
notation ring Q := R[M]
hypothesis coefficients : IsField(R)
hypothesis infinite : ¬Finite(R)
hypothesis field : IsField(S)
hypothesis hom : IsRingHom(f, R, S)
hypothesis finite : Finite(I)
hypothesis assignment : v : I → S
hypothesis subset : M ⊆ I
hypothesis independent : AlgebraicallyIndependent(M, R, S, f, restrict(v, M))
hypothesis maximal : ∀ T, T ⊆ I → M ⊆ T → AlgebraicallyIndependent(T, R, S, f, restrict(v, T)) → T = M
hypothesis generates : algebraAdjoin(f, R, S, functionImage(v, I, S)) = S

-- A nonempty independent family contradicts the existing localization obstruction.
-- Finite-module integrality supplies the constructive determinant trick.
theorem maximal_independent_empty
  shows M = ∅
proof
  have source := IsField.comm_ring with coefficients
  have target := IsField.comm_ring with field
  have sourceQ : IsCommRing(Q)
    exact polynomials.comm_ring with *
  have data := independent
  have restricted := data.right.left
  have injective := data.right.right
  have evaluation : IsRingHom(polynomialAtOver(M, R, S, f, restrict(v, M)), Q,
    S)
    exact polynomialAtOver.hom with *
  obtain ⟨s, polynomial, nonzero, T, carrier, finiteModule⟩ := AlgebraicallyIndependent.maximal_finite_module at I, M, A, add, zero, neg, mul, one, B, plus, z, minus, times, unit, f, v with *
  have localized := IsRingHom.principal_localization_subring with *
  have powers := IsRingHom.denominator_powers with *
  have mappedCarrier : T = localizationWithin(S, functionImage(polynomialAtOver(M, R, S, f, restrict(v, M)), Q, S), functionImage(polynomialAtOver(M, R, S, f, restrict(v, M)), denominatorPowers(Q, s), S))
    rwa powers
  have subring : IsSubring(S, T) by rwa mappedCarrier
  have smaller := IsSubring.comm_ring with target, subring
  have inclusion := IsSubring.inclusion_hom with target, subring
  have integral : ∀ x ∈ S, IntegralOver(identity(T), T, B, plus, z, times, unit, x)
    intros x member
    exact FiniteAlgebraModule.integral with *
  ext j
  constructor
  . intro index
    have obstruction := polynomialLocalization.not_integral with *
    exfalso
    exact obstruction with integral
  . intro impossible
    exfalso
    exact set.empty with impossible

end ZariskiFamilies

section EmptyCoefficients
variable (A add zero neg mul one B plus z minus times unit f v x : Set)
notation ring R := (A, add, zero, neg, mul, one)
notation ring S := (B, plus, z, minus, times, unit)
notation ring Q := R[∅]
hypothesis coefficients : IsField(R)
hypothesis field : IsField(S)
hypothesis hom : IsRingHom(f, R, S)
hypothesis assignment : v : ∅ → S

-- Z1 DISCHARGED: extract constant coefficients and transport the finite relation.
theorem algebraic_over_empty_variables
  requires algebraic : AlgebraicOver(polynomialAtOver(∅, R, S, f, v), Q, S, x)
  shows AlgebraicOver(f, R, S, x)
proof
  have source := IsField.comm_ring with coefficients
  have target := IsField.comm_ring with field
  exact AlgebraicOver.empty_variables with *

end EmptyCoefficients

section Zariski
variable (A add zero neg mul one B plus z minus times unit f : Set)
notation ring R := (A, add, zero, neg, mul, one)
notation ring S := (B, plus, z, minus, times, unit)
hypothesis coefficients : IsField(R)
hypothesis infinite : ¬Finite(R)
hypothesis field : IsField(S)
hypothesis hom : IsRingHom(f, R, S)
hypothesis generated : FinitelyGeneratedAlgebra(f, R, S)

theorem FinitelyGeneratedAlgebra.finite_module_of_field
  shows FiniteAlgebraModule(f, R, S)
proof
  have source := IsField.comm_ring with coefficients
  have target := IsField.comm_ring with field
  have nontrivial := IsField.nontrivial with field
  have injective : InjectiveBetween(f, R, S)
    exact IsRingHom.field_injective with *
  obtain ⟨G, finite, bounded, generates⟩ := generated
  have assignment := identity.inclusion with bounded
  have image := functionImage.identity with bounded
  have generation : algebraAdjoin(f, R, S, functionImage(identity(G), G, S)) = S by rwa image
  obtain ⟨M, subset, independent, maximal⟩ := AlgebraicallyIndependent.exists_maximal at A, add, zero, neg, mul, one, B, plus, z, minus, times, unit, f, G, identity(G) with *
  have empty := maximal_independent_empty at G, M, A, add, zero, neg, mul, one, B, plus, z, minus, times, unit, f, identity(G) with *
  have roots := AlgebraicallyIndependent.maximal_generators_algebraic with *
  have data := independent
  have restricted := data.right.left
  rw empty at restricted
  have algebraic : ∀ x ∈ G, AlgebraicOver(f, R, S, x)
    intros x member
    have inImage : x ∈ functionImage(identity(G), G, S) by rwa image
    have root := roots with x, inImage
    rw empty at root
    exact algebraic_over_empty_variables with *
  exact algebraicGenerators.finite_module with *

theorem FinitelyGeneratedAlgebra.algebraic_of_field
  shows ∀ x ∈ S, AlgebraicOver(f, R, S, x)
proof
  have source := IsField.comm_ring with coefficients
  have target := IsField.comm_ring with field
  have finiteModule : FiniteAlgebraModule(f, R, S)
    exact FinitelyGeneratedAlgebra.finite_module_of_field with *
  intros x member
  have integral : IntegralOver(f, R, S, x)
    exact FiniteAlgebraModule.integral with *
  exact IntegralOver.algebraic with coefficients, target, hom, integral

end Zariski

section AlgebraicClosure
variable (A add zero neg mul one : Set)
notation ring R := (A, add, zero, neg, mul, one)
hypothesis closed : IsAlgebraicallyClosed(R)

-- A1 discharged: an explicit positive-degree monic vanishing polynomial plus 1.
theorem algebraically_closed_infinite
  shows ¬Finite(R)
proof
  exact IsAlgebraicallyClosed.infinite with *

-- A2 discharged: synthetic division and induction on the monic relation degree.
theorem algebraic_element_in_image (B plus z minus times unit f x : Set)
  requires field : IsField(B, plus, z, minus, times, unit)
  requires hom : IsRingHom(f, A, add, zero, neg, mul, one, B, plus, z, minus, times, unit)
  requires algebraic : AlgebraicOver(f, A, zero, B, plus, z, times, x)
  shows ∃ a ∈ R, f(a) = x
proof
  exact IsAlgebraicallyClosed.algebraic_in_image with *

theorem IsAlgebraicallyClosed.field_algebra_surjective (B plus z minus times unit f : Set)
  requires field : IsField(B, plus, z, minus, times, unit)
  requires hom : IsRingHom(f, A, add, zero, neg, mul, one, B, plus, z, minus, times, unit)
  requires generated : FinitelyGeneratedAlgebra(f, A, B, plus, z, minus, times, unit)
  shows SurjectiveBetween(f, A, B)
proof
  have coefficients := IsAlgebraicallyClosed.field with closed
  have infinite : ¬Finite(R)
    exact algebraically_closed_infinite with *
  have algebraic := FinitelyGeneratedAlgebra.algebraic_of_field with *
  exact IsAlgebraicallyClosed.algebraic_extension_surjective with *

section Polynomials
variable (I G : Set)
notation ring P := R[I]
hypothesis finite : Finite(I)
hypothesis generators : G ⊆ P

theorem polynomialIdeal.unit_iff_no_common_zero
  shows P[1] ∈ idealSpan(P, G) ↔ ¬(∃ v, PolynomialCommonZero(I, R, G, v))
proof
  have field := IsAlgebraicallyClosed.field with closed
  have rigidity : ∀ B, ∀ plus, ∀ z, ∀ minus, ∀ times, ∀ unit, ∀ f, IsField(B, plus, z, minus, times, unit) → IsRingHom(f, A, add, zero, neg, mul, one, B, plus, z, minus, times, unit) → FinitelyGeneratedAlgebra(f, A, B, plus, z, minus, times, unit) → SurjectiveBetween(f, A, B)
    intros B plus z minus times unit f target hom generated
    exact IsAlgebraicallyClosed.field_algebra_surjective with *
  exact polynomialIdeal.unit_iff_no_common_zero_of_field_algebra_rigidity with *

theorem polynomialIdeal.finite_certificate_iff_no_common_zero
  shows (∃ terms, List(idealProducts(P, G), terms) ∧ P[1] = ringSum{idealProducts(P, G)}(polynomialAdd(I, R), P[0], terms)) ↔ ¬(∃ v, PolynomialCommonZero(I, R, G, v))
proof
  have field := IsAlgebraicallyClosed.field with closed
  have coefficients := IsField.comm_ring with field
  have ring : IsCommRing(P)
    exact polynomials.comm_ring with *
  have certificate := idealSpan.unit_iff_finite_certificate with *
  have equivalence := polynomialIdeal.unit_iff_no_common_zero with *
  tauto

end Polynomials
end AlgebraicClosure
