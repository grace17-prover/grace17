module Grace.Cumulus.Algebra.Polynomial.FiniteGeneration
import Generation
import Image
import Field.Quotient

section Polynomials
variable (I A add zero neg mul one : Set)
notation ring R := (A, add, zero, neg, mul, one)
notation ring P := R[I]
hypothesis ring : IsCommRing(R)
hypothesis finite : Finite(I)

theorem polynomialGenerators.finite
  shows Finite(polynomialGenerators(I, R))
proof
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have multiplicative := IsRing.multiplicative with ordinary
  have oneIn := IsMonoid.unit_in_carrier with multiplicative
  have function := polynomialVariables.function at I, A, zero, one with *
  have subset := Subset.reflexive at I
  unfold polynomialGenerators
  exact Finite.function_image with function, finite, subset

theorem polynomials.finitely_generated
  shows FinitelyGeneratedAlgebra(polynomialCoefficients(I, R), R, P)
proof
  have generators := polynomialGenerators.finite with *
  have bounded := polynomialGenerators.subset at I, A, add, zero, neg, mul, one with *
  have generated := polynomialGenerators.adjoin at I, A, add, zero, neg, mul, one with *
  unfold FinitelyGeneratedAlgebra
  refine ⟨polynomialGenerators(I, R), generators, bounded, generated⟩

section Quotients
variable (J : Set)
notation ring Q := P ⧸ J

theorem polynomialQuotient.finitely_generated
  requires ideal : IsIdeal(P, J)
  shows FinitelyGeneratedAlgebra(compose(quotientProjection(P, idealRelation(P, J)), polynomialCoefficients(I, R), R, P, Q), R, Q)
proof
  have polynomialRing := polynomials.comm_ring at I, A, add, zero, neg, mul, one with *
  have hom := polynomialCoefficients.hom at I, A, add, zero, neg, mul, one with *
  have generated := polynomials.finitely_generated at I, A, add, zero, neg, mul, one with *
  exact FinitelyGeneratedAlgebra.quotient with ring, polynomialRing, hom, ideal, generated

theorem polynomialQuotient.maximal_residue
  requires maximal : IsMaximalIdeal(P, J)
  shows IsField(Q) ∧ FinitelyGeneratedAlgebra(compose(quotientProjection(P, idealRelation(P, J)), polynomialCoefficients(I, R), R, P, Q), R, Q)
proof
  have polynomialRing := polynomials.comm_ring at I, A, add, zero, neg, mul, one with *
  have ideal : IsIdeal(P, J) by simp [IsMaximalIdeal, IsProperIdeal]
  have field := idealQuotient.is_field_of_maximal with polynomialRing, maximal
  have generated := polynomialQuotient.finitely_generated with *
  refine ⟨field, generated⟩

end Quotients

end Polynomials
