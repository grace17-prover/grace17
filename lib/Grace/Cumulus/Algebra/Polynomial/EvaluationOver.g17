module Grace.Cumulus.Algebra.Polynomial.EvaluationOver
import MapHom
import Universal

def polynomialAtOver (I A add z neg mul one B plus o minus times unit f v : Set) : Set :=
  compose(polynomialAt(I, B, plus, o, minus, times, unit, v), polynomialMap(I, A, z, B, o, f), polynomials(I, A, z), polynomials(I, B, o), B)

notation scoped polynomialAtOver(I, R, S, f, v) => polynomialAtOver(I, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, S.carrier, S.add, S.zero, S.neg, S.mul, S.one, f, v)

predicate AlgebraicallyIndependent (I A add z neg mul one B plus o minus times unit f v : Set) :=
  IsRingHom(f, A, add, z, neg, mul, one, B, plus, o, minus, times, unit) ∧ FunctionBetween(v, I, B) ∧ InjectiveBetween(polynomialAtOver(I, A, add, z, neg, mul, one, B, plus, o, minus, times, unit, f, v), polynomials(I, A, z), B)

notation scoped AlgebraicallyIndependent(I, R, S, f, v) => AlgebraicallyIndependent(I, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, S.carrier, S.add, S.zero, S.neg, S.mul, S.one, f, v)

section Rings
variable (I A add z neg mul one B plus o minus times unit f v : Set)
notation ring R := (A, add, z, neg, mul, one)
notation ring S := (B, plus, o, minus, times, unit)
notation ring P := R[I]
notation ring Q := S[I]
hypothesis source : IsCommRing(R)
hypothesis target : IsCommRing(S)
hypothesis hom : IsRingHom(f, R, S)
hypothesis assignment : v : I → S

theorem polynomialAtOver.hom
  shows IsRingHom(polynomialAtOver(I, R, S, f, v), P, S)
proof
  have mapped : IsRingHom(polynomialMap(I, R, S, f), P, Q)
    exact polynomialMap.hom with *
  have evaluated := polynomialAt.hom with *
  unfold polynomialAtOver
  exact IsRingHom.compose with *

theorem polynomialAtOver.value (p : Set)
  requires polynomial : p ∈ P
  shows polynomialAtOver(I, R, S, f, v)(p) = polynomialAt(I, S, v)(polynomialMap(I, R, S, f)(p))
proof
  have mapHom : IsRingHom(polynomialMap(I, R, S, f), P, Q)
    exact polynomialMap.hom with *
  have evaluationHom := polynomialAt.hom with *
  have map := IsRingHom.function with mapHom
  have evaluation := IsRingHom.function with evaluationHom
  unfold polynomialAtOver
  exact compose.apply with *

theorem polynomialAtOver.constant (a : Set)
  requires coefficient : a ∈ R
  shows polynomialAtOver(I, R, S, f, v)(polynomialConstant(I, R, a)) = f(a)
proof
  have zeroIn : R[0] ∈ R by typecheck
  have member := polynomialConstant.member at I, A, z, a with *
  have image := IsRingHom.closed with hom, coefficient
  have mapped := polynomialMap.constant at I, A, add, z, neg, mul, one, B, plus, o, minus, times, unit, f, a with *
  have evaluated := polynomialAt.constant with *
  rwa [polynomialAtOver.value, mapped]

theorem polynomialAtOver.coefficient_image
  shows functionImage(f, R, S) ⊆ functionImage(polynomialAtOver(I, R, S, f, v), P, S)
proof
  have evaluation : IsRingHom(polynomialAtOver(I, R, S, f, v), P, S)
    exact polynomialAtOver.hom with *
  have function := IsRingHom.function with evaluation
  have zeroIn : R[0] ∈ R by typecheck
  intros x member
  obtain ⟨inS, a, coefficient, shape⟩ := functionImage.membership.forward with member
  have constant := polynomialConstant.member at I, A, z, a with *
  have value := polynomialAtOver.constant at I, A, add, z, neg, mul, one, B, plus, o, minus, times, unit, f, v, a with *
  have image := functionImage.value at polynomialAtOver(I, R, S, f, v), P, S, polynomialConstant(I, R, a) with *
  rw value at image
  rwa shape

theorem polynomialAtOver.variable (j : Set)
  requires index : j ∈ I
  shows polynomialAtOver(I, R, S, f, v)(polynomialVariable(I, R, j)) = v(j)
proof
  have zeroIn : R[0] ∈ R by typecheck
  have oneIn : R[1] ∈ R by typecheck
  have member := polynomialVariable.member at I, A, z, one, j with *
  have mapped := polynomialMap.variable at I, A, add, z, neg, mul, one, B, plus, o, minus, times, unit, f, j with *
  have evaluated := polynomialAt.variable with *
  rwa [polynomialAtOver.value, mapped]

theorem polynomialAtOver.unique (h : Set)
  requires morphism : IsRingHom(h, P, S)
  requires constants : ∀ a ∈ R, h(polynomialConstant(I, R, a)) = f(a)
  requires variables : ∀ j ∈ I, h(polynomialVariable(I, R, j)) = v(j)
  shows h = polynomialAtOver(I, R, S, f, v)
proof
  have evaluation : IsRingHom(polynomialAtOver(I, R, S, f, v), P, S)
    exact polynomialAtOver.hom with *
  have sameConstants : ∀ a ∈ R, h(polynomialConstant(I, R, a)) = polynomialAtOver(I, R, S, f, v)(polynomialConstant(I, R, a))
    intros a ha
    have first := constants with a, ha
    have second := polynomialAtOver.constant with *
    cc
  have sameVariables : ∀ j ∈ I, h(polynomialVariable(I, R, j)) = polynomialAtOver(I, R, S, f, v)(polynomialVariable(I, R, j))
    intros j hj
    have first := variables with j, hj
    have second := polynomialAtOver.variable at I, A, add, z, neg, mul, one, B, plus, o, minus, times, unit, f, v, j with *
    cc
  exact IsRingHom.polynomial_ext with *

theorem AlgebraicallyIndependent.relation_iff (p : Set)
  requires independent : AlgebraicallyIndependent(I, R, S, f, v)
  requires polynomial : p ∈ P
  shows polynomialAtOver(I, R, S, f, v)(p) = S[0] ↔ p = P[0]
proof
  have evaluation : IsRingHom(polynomialAtOver(I, R, S, f, v), P, S)
    exact polynomialAtOver.hom with *
  have zero := IsRingHom.zero with evaluation
  have zeroMember := polynomials.zero at I, A, add, z, neg, mul, one with *
  have injective := independent.right.right
  constructor
  . intro vanishes
    have equal : polynomialAtOver(I, R, S, f, v)(p) = polynomialAtOver(I, R, S, f, v)(P[0]) by cc
    exact Injective.apply_cancel with *
  . intro equal
    rwa equal

theorem AlgebraicallyIndependent.of_no_relation
  requires relations : ∀ p ∈ P, polynomialAtOver(I, R, S, f, v)(p) = S[0] → p = P[0]
  shows AlgebraicallyIndependent(I, R, S, f, v)
proof
  have evaluation : IsRingHom(polynomialAtOver(I, R, S, f, v), P, S)
    exact polynomialAtOver.hom with *
  have function := IsRingHom.function with evaluation
  have sourceRing := polynomials.comm_ring at I, A, add, z, neg, mul, one with *
  have ordinary := IsCommRing.ring with sourceRing
  unfold AlgebraicallyIndependent
  refine ⟨hom, assignment, ?_⟩
  unfold InjectiveBetween
  refine ⟨function, ?_⟩
  intros p hp q hq y hy first second
  have valueP := FunctionBetween.apply_value at polynomialAtOver(I, R, S, f, v), P, S, p, y with *
  have valueQ := FunctionBetween.apply_value at polynomialAtOver(I, R, S, f, v), P, S, q, y with *
  have negative := IsRing.neg_closed with ordinary, hq
  have difference : P[p - q] ∈ P
    exact IsRing.add_closed with *
  have mapped := IsRingHom.sub with sourceRing, evaluation, hp, hq
  have zero : polynomialAtOver(I, R, S, f, v)(P[p - q]) = S[0]
    rw [mapped, valueP, valueQ]
    ring
  have vanishes := relations with P[p - q], difference, zero
  linear_combination vanishes

end Rings
section Canonical
variable (I A add z neg mul one : Set)
notation ring R := (A, add, z, neg, mul, one)
notation ring P := R[I]
hypothesis ring : IsCommRing(R)

theorem polynomialAtOver.identity_coefficients (v : Set)
  requires assignment : v : I → R
  shows polynomialAtOver(I, R, R, identity(R), v) = polynomialAt(I, R, v)
proof
  have hom := IsRingHom.identity with ring
  have evaluation := polynomialAt.hom with *
  have constants : ∀ a ∈ R, polynomialAt(I, R, v)(polynomialConstant(I, R, a)) = identity(R)(a)
    intros a ha
    have value := polynomialAt.constant with *
    have same := identity.apply with *
    cc
  have variables : ∀ j ∈ I, polynomialAt(I, R, v)(polynomialVariable(I, R, j)) = v(j)
    intros j hj
    exact polynomialAt.variable with *
  symm
  exact polynomialAtOver.unique with *

theorem polynomialAtOver.canonical_variables
  shows polynomialAtOver(I, R, P, polynomialCoefficients(I, R), polynomialVariables(I, R)) = identity(P)
proof
  have target := polynomials.comm_ring at I, A, add, z, neg, mul, one with *
  have hom := polynomialCoefficients.hom at I, A, add, z, neg, mul, one with *
  have zeroIn : R[0] ∈ R by typecheck
  have oneIn : R[1] ∈ R by typecheck
  have assignment := polynomialVariables.function at I, A, z, one with *
  have identity := IsRingHom.identity with target
  have constants : ∀ a ∈ R, identity(P)(polynomialConstant(I, R, a)) = polynomialCoefficients(I, R)(a)
    intros a ha
    have member := polynomialConstant.member at I, A, z, a with *
    have value := polynomialCoefficients.value at I, A, z, a with *
    have same := identity.apply with member
    cc
  have variables : ∀ j ∈ I, identity(P)(polynomialVariable(I, R, j)) = polynomialVariables(I, R)(j)
    intros j hj
    have member := polynomialVariable.member at I, A, z, one, j with *
    have value := polynomialVariables.value at I, A, z, one, j with *
    have same := identity.apply with member
    cc
  symm
  exact polynomialAtOver.unique with *

theorem polynomialVariables.algebraically_independent
  shows AlgebraicallyIndependent(I, R, P, polynomialCoefficients(I, R), polynomialVariables(I, R))
proof
  have hom := polynomialCoefficients.hom at I, A, add, z, neg, mul, one with *
  have zeroIn : R[0] ∈ R by typecheck
  have oneIn : R[1] ∈ R by typecheck
  have assignment := polynomialVariables.function at I, A, z, one with *
  have evaluation := polynomialAtOver.canonical_variables at I, A, add, z, neg, mul, one with *
  have injective := identity.injective at P
  unfold AlgebraicallyIndependent
  refine ⟨hom, assignment, ?_⟩
  rwa evaluation

end Canonical
