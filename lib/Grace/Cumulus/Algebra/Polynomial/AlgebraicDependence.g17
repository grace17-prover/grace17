module Grace.Cumulus.Algebra.Polynomial.AlgebraicDependence
import Transfer
import IndependentSubfamily
import HornerRelations

section Rings
variable (I M A add z neg mul one B plus o minus times unit f v : Set)
notation ring R := (A, add, z, neg, mul, one)
notation ring S := (B, plus, o, minus, times, unit)
notation ring P := R[I]
notation ring Q := R[M]
hypothesis source : IsCommRing(R)
hypothesis target : IsCommRing(S)
hypothesis hom : IsRingHom(f, R, S)
hypothesis assignment : v : I → S
hypothesis subset : M ⊆ I

theorem polynomialVariableCoefficient.supported_in (p j : Set, n : Nat)
  requires polynomial : p ∈ P
  requires variables : polynomialVariablesUsed(I, R, p) ⊆ insert(j, M)
  shows polynomialVariablesUsed(I, R, polynomialVariableCoefficient(I, R, p, j, n)) ⊆ M
proof
  have zeroIn : R[0] ∈ R by typecheck
  have bound := polynomialVariableCoefficient.variables at I, A, z, p, j, n with *
  intros i used
  have data := bound with i, used
  obtain ⟨original, absent⟩ := difference.membership.forward with data
  have included := variables with i, original
  have alternatives := insert.membership.forward with included
  cases alternatives with equal | member
  . exfalso
    have singleton := singleton.membership.backward with equal
    exact absent with singleton
  . exact member

theorem polynomialAtOver.algebraic_of_relation (p j : Set)
  requires polynomial : p ∈ P
  requires index : j ∈ I
  requires variables : polynomialVariablesUsed(I, R, p) ⊆ insert(j, M)
  requires nonzero : p ≠ P[0]
  requires relation : polynomialAtOver(I, R, S, f, v)(p) = S[0]
  shows AlgebraicOver(polynomialAtOver(M, R, S, f, restrict(v, M)), Q, S, v(j))
proof
  have zeroIn : R[0] ∈ R by typecheck
  have oneIn : R[1] ∈ R by typecheck
  have sourceP : IsCommRing(P)
    exact polynomials.comm_ring with *
  have sourceQ : IsCommRing(Q)
    exact polynomials.comm_ring with *
  have closed : ∀ i ∈ M, v(i) ∈ S
    intros i member
    have included := subset
    have inI := included with i, member
    exact FunctionBetween.apply_closed with assignment, inI
  have restricted := restrict.function at v, I, S, M, S with *
  have evaluationI : IsRingHom(polynomialAtOver(I, R, S, f, v), P, S)
    exact polynomialAtOver.hom with *
  have evaluationM : IsRingHom(polynomialAtOver(M, R, S, f, restrict(v, M)), Q,
    S)
    exact polynomialAtOver.hom with *
  have transfer : IsRingHom(polynomialTransfer(I, M, R), P, Q)
    exact polynomialTransfer.hom with *
  have functionI := IsRingHom.function with evaluationI
  have functionM := IsRingHom.function with evaluationM
  have functionT := IsRingHom.function with transfer
  have zeroT := IsRingHom.zero with transfer
  have zeroI := IsRingHom.zero with evaluationI
  have zeroP : P[0] ∈ P by typecheck
  have variableIn := polynomialVariable.member at I, A, z, one, j with *
  have variableValue := polynomialAtOver.variable at I, A, add, z, neg, mul, one, B, plus, o, minus, times, unit, f, v, j with *
  have element := FunctionBetween.apply_closed with assignment, index
  obtain ⟨cs, list, coefficients⟩ := polynomialCoefficientFamily.list_representation at I, A, z, p, j with *
  have reconstructed := polynomialFromCoefficients.reconstruct at I, A, add, z, neg, mul, one, p, j, cs with *
  have coefficientValues : ∀ n, Nat(n) → compose(polynomialAtOver(M, R, S, f, restrict(v, M)), polynomialTransfer(I, M, R), P, Q, S)(listCoefficient{P}(P[0], cs, n)) = polynomialAtOver(I, R, S, f, v)(listCoefficient{P}(P[0], cs, n))
    intros n natural
    have value := coefficients with n, natural
    have member := polynomialVariableCoefficient.member at I, A, z, p, j, n with *
    have supported := polynomialVariableCoefficient.supported_in at I, M, A, add, z, neg, mul, one, B, plus, o, minus, times, unit, f, v, p, j, n with *
    have agreement : ∀ i ∈ polynomialVariablesUsed(I, R, polynomialVariableCoefficient(I, R, p, j, n)), v(i) = restrict(v, M)(i)
      intros i used
      have included := supported
      have inM := included with i, used
      symm
      exact restrict.apply at v, I, S, M, S, i with *
    have evaluated := polynomialTransfer.evaluate_supported at I, M, A, add, z, neg, mul, one, B, plus, o, minus, times, unit, f, v, restrict(v, M), polynomialVariableCoefficient(I, R, p, j, n) with *
    have composed := compose.apply at polynomialAtOver(M, R, S, f, restrict(v, M)), polynomialTransfer(I, M, R), P, Q, S, polynomialVariableCoefficient(I, R, p, j, n) with *
    rw value
    cc
  have same := listMap.congr_coefficients at P, P[0], compose(polynomialAtOver(M, R, S, f, restrict(v, M)), polynomialTransfer(I, M, R), P, Q, S), polynomialAtOver(I, R, S, f, v), cs with *
  have composed := listMap.compose at P, Q, S, polynomialTransfer(I, M, R), polynomialAtOver(M, R, S, f, restrict(v, M)), cs with *
  have mapped := hornerAt.map at P, polynomialAdd(I, A, add, z, neg, mul, one), P[0], polynomialNeg(I, A, add, z, neg, mul, one), polynomialMul(I, A, add, z, neg, mul, one), polynomialConstant(I, R, one), B, plus, o, minus, times, unit, polynomialAtOver(I, R, S, f, v), P[0], polynomialVariable(I, R, j), cs with *
  rw [zeroI, variableValue] at mapped
  unfold polynomialFromCoefficients at reconstructed
  have normalized := monicValue.mapped_coefficients at Q, S, plus, times, polynomialAtOver(M, R, S, f, restrict(v, M)), o, v(j), listMap{P}(polynomialTransfer(I, M, R), cs) with *
  have vanishes : monicValue{Q}(polynomialAtOver(M, R, S, f, restrict(v, M)), plus, times, o, v(j), listMap{P}(polynomialTransfer(I, M, R), cs)) = o
    cc
  obtain ⟨n, nIn, nonzeroCoefficient⟩ := polynomialVariableCoefficient.exists_nonzero at I, A, z, p, j with *
  have natural := nat.omega.backward with nIn
  have member := polynomialVariableCoefficient.member at I, A, z, p, j, n with *
  have supported := polynomialVariableCoefficient.supported_in at I, M, A, add, z, neg, mul, one, B, plus, o, minus, times, unit, f, v, p, j, n with *
  have nonzeroTransfer := polynomialTransfer.nonzero_supported at I, M, A, add, z, neg, mul, one, polynomialVariableCoefficient(I, R, p, j, n) with *
  have coefficient := coefficients with n, natural
  have lookup := listCoefficient.map at P, Q, polynomialTransfer(I, M, R), P[0], cs, n with *
  rw zeroT at lookup
  have nonzeroList : ∃ k, Nat(k) ∧ listCoefficient{Q}(Q[0], listMap{P}(polynomialTransfer(I, M, R), cs), k) ≠ Q[0]
    refine ⟨n, natural, ?_⟩
    rwa [lookup, coefficient]
  exact AlgebraicOver.of_coefficient_relation with *

theorem AlgebraicallyIndependent.maximal_algebraic (j : Set)
  requires maximal : ∀ T, T ⊆ I → M ⊆ T → AlgebraicallyIndependent(T, R, S, f, restrict(v, T)) → T = M
  requires index : j ∈ I
  requires outside : ¬(j ∈ M)
  shows AlgebraicOver(polynomialAtOver(M, R, S, f, restrict(v, M)), Q, S, v(j))
proof
  have inside : insert(j, M) ⊆ I by simp [Subset, insert.membership]
  have contains : M ⊆ insert(j, M) by simp [Subset, insert.membership]
  have closed : ∀ i ∈ insert(j, M), v(i) ∈ S
    intros i member
    have included := inside
    have inI := included with i, member
    exact FunctionBetween.apply_closed with assignment, inI
  have restricted := restrict.function with *
  have jIn := insert.self at j, M
  obtain ⟨p, polynomial, nonzero, relation⟩ := AlgebraicallyIndependent.maximal_adjoin_relation at A, add, z, neg, mul, one, B, plus, o, minus, times, unit, f, I, v, M, j with *
  have variables := polynomialVariablesUsed.subset at insert(j, M), A, z, p
  have algebraic := polynomialAtOver.algebraic_of_relation with *
  have nested := restrict.nested at v, M, insert(j, M) with contains
  have value := restrict.apply with *
  rwa [nested, value] at algebraic

end Rings
