module Grace.Cumulus.Algebra.Polynomial.Assignment
import EvaluationHom
import Ring.FiniteProduct
import Group.Power

defgraph monomialWeights (I D A add zero neg mul one v m : Set) (i ∈ D) : A := monoidPow(mul, one, v(i), m(i))
requires ring : IsCommRing(A, add, zero, neg, mul, one)
requires assignment : v : I → A
requires monomial : m ∈ monomials(I)
requires domain : D ⊆ I
proof
  unfold Subset at domain
  have index := domain with i, member
  have exponent := monomials.exponent at I, m, i with *
  have value := FunctionBetween.apply_closed at v, I, A, i with *
  have ordinary := IsCommRing.ring with ring
  have multiplicative := IsRing.multiplicative with ordinary
  exact monoidPow.closed at A, mul, one, v(i), m(i) with *

defgraph monomialEvaluate (I A add zero neg mul one v : Set) (m ∈ monomials(I)) : A :=
  finiteRingProduct(functionSupport(m, I, 0), A, add, zero, neg, mul, one, monomialWeights(I, functionSupport(m, I, 0), A, add, zero, neg, mul, one, v, m))
requires ring : IsCommRing(A, add, zero, neg, mul, one)
requires assignment : v : I → A
proof
  have domain := functionSupport.subset at m, I, 0
  have map := monomials.map with member
  have finite := CoefficientMap.finite_support with map
  have weights := monomialWeights.function at I, functionSupport(m, I, 0), A, add, zero, neg, mul, one, v, m with *
  exact finiteRingProduct.closed at functionSupport(m, I, 0), A, add, zero, neg, mul, one, monomialWeights(I, functionSupport(m, I, 0), A, add, zero, neg, mul, one, v, m) with *

-- The evaluation graph associated with an assignment of values to variables.
def polynomialAt (I A add zero neg mul one v : Set) : Set :=
  polynomialEvaluate(I, A, add, zero, neg, mul, one, monomialEvaluate(I, A, add, zero, neg, mul, one, v))

notation scoped polynomialAt(I, R, v) => polynomialAt(I, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, v)

section Evaluation
variable (I A add zero neg mul one v : Set)
hypothesis ring : IsCommRing(A, add, zero, neg, mul, one)
hypothesis assignment : v : I → A

theorem monomialEvaluate.on_domain (m D : Set)
  requires monomial : m ∈ monomials(I)
  requires domain : D ⊆ I
  requires finite : Finite(D)
  requires covers : functionSupport(m, I, 0) ⊆ D
  shows monomialEvaluate(I, A, add, zero, neg, mul, one, v)(m) = finiteRingProduct(D, A, add, zero, neg, mul, one,  monomialWeights(I, D, A, add, zero, neg, mul, one, v,  m))
proof
  have supportDomain := functionSupport.subset at m, I, 0
  have weights := monomialWeights.function at I, D, A, add, zero, neg, mul, one, v, m with *
  have supported := monomialWeights.function at I, functionSupport(m, I, 0), A, add, zero, neg, mul, one, v, m with *
  have agreement : ∀ i ∈ functionSupport(m, I, 0), monomialWeights(I, D, A, add, zero, neg, mul, one, v,  m)(i) = monomialWeights(I, functionSupport(m, I, 0), A, add, zero, neg, mul, one, v,  m)(i)
    intros i hi
    have included := covers
    have inD := included with i, hi
    have left := monomialWeights.value at I, D, A, add, zero, neg, mul, one, v, m, i with *
    have right := monomialWeights.value at I, functionSupport(m, I, 0), A, add, zero, neg, mul, one, v, m, i with *
    cc
  have neutral : ∀ i ∈ D, ¬(i ∈ functionSupport(m, I, 0)) → monomialWeights(I, D, A, add, zero, neg, mul, one, v,  m)(i) = one
    intros i hi outside
    have included := domain
    have index := included with i, hi
    have exponent := functionSupport.outside with *
    have weight := monomialWeights.value at I, D, A, add, zero, neg, mul, one, v, m, i with *
    rw [weight, exponent]
    exact monoidPow.zero
  have extended := finiteRingProduct.unit_extension with *
  have value := monomialEvaluate.value at I, A, add, zero, neg, mul, one, v, m with *
  cc

theorem monomialEvaluate.one
  shows monomialEvaluate(I, A, add, zero, neg, mul, one, v)(monomialOne(I)) = one
proof
  have member := monomialOne.member at I
  have map := monomials.map with member
  have finite := CoefficientMap.finite_support with map
  have domain := functionSupport.subset at monomialOne(I), I, 0
  have weights := monomialWeights.function at I, functionSupport(monomialOne(I), I, 0), A, add, zero, neg, mul, one, v, monomialOne(I) with *
  have values : ∀ i ∈ functionSupport(monomialOne(I), I, 0), monomialWeights(I, functionSupport(monomialOne(I), I, 0), A, add, zero, neg, mul, one, v,  monomialOne(I))(i) = one
    intros i hi
    have index := functionSupport.membership.forward with hi
    have exponent := monomialOne.value at I, i with *
    have weight := monomialWeights.value at I, functionSupport(monomialOne(I), I, 0), A, add, zero, neg, mul, one, v, monomialOne(I), i with *
    rw [weight, exponent]
    exact monoidPow.zero
  have product := finiteRingProduct.one at functionSupport(monomialOne(I), I, 0), A, add, zero, neg, mul, one, monomialWeights(I, functionSupport(monomialOne(I), I, 0), A, add, zero, neg, mul, one, v,  monomialOne(I)) with *
  have value := monomialEvaluate.value at I, A, add, zero, neg, mul, one, v, monomialOne(I) with *
  cc

theorem monomialEvaluate.mul (m n : Set)
  requires memberM : m ∈ monomials(I)
  requires memberN : n ∈ monomials(I)
  shows monomialEvaluate(I, A, add, zero, neg, mul, one, v)(monomialProduct(I, m, n)) = call2(mul, monomialEvaluate(I, A, add, zero, neg, mul, one, v)(m), monomialEvaluate(I, A, add, zero, neg, mul, one, v)(n))
proof
  have memberProduct := monomialProduct.member at I, m, n with *
  have mapM := monomials.map with memberM
  have mapN := monomials.map with memberN
  have finiteM := CoefficientMap.finite_support with mapM
  have finiteN := CoefficientMap.finite_support with mapN
  have finite := Finite.union with finiteM, finiteN
  have domainM := functionSupport.subset at m, I, 0
  have domainN := functionSupport.subset at n, I, 0
  have domain : functionSupport(m, I, 0) ∪ functionSupport(n, I, 0) ⊆ I by simp [Subset, union2.membership]
  have coversM : functionSupport(m, I, 0) ⊆ functionSupport(m, I, 0) ∪ functionSupport(n, I, 0)
    simp [Subset, union2.membership]
  have coversN : functionSupport(n, I, 0) ⊆ functionSupport(m, I, 0) ∪ functionSupport(n, I, 0)
    simp [Subset, union2.membership]
  have support := monomialProduct.support at I, m, n with *
  have coversProduct : functionSupport(monomialProduct(I, m, n), I, 0) ⊆ functionSupport(m, I, 0) ∪ functionSupport(n, I, 0)
    rw support
    simp
  have productValue := monomialEvaluate.on_domain at I, A, add, zero, neg, mul, one, v, monomialProduct(I, m, n), functionSupport(m, I, 0) ∪ functionSupport(n, I, 0) with *
  have firstValue := monomialEvaluate.on_domain at I, A, add, zero, neg, mul, one, v, m, functionSupport(m, I, 0) ∪ functionSupport(n, I, 0) with *
  have secondValue := monomialEvaluate.on_domain at I, A, add, zero, neg, mul, one, v, n, functionSupport(m, I, 0) ∪ functionSupport(n, I, 0) with *
  have weightsM := monomialWeights.function at I, functionSupport(m, I, 0) ∪ functionSupport(n, I, 0), A, add, zero, neg, mul, one, v, m with *
  have weightsN := monomialWeights.function at I, functionSupport(m, I, 0) ∪ functionSupport(n, I, 0), A, add, zero, neg, mul, one, v, n with *
  have weightsProduct := monomialWeights.function at I, functionSupport(m, I, 0) ∪ functionSupport(n, I, 0), A, add, zero, neg, mul, one, v, monomialProduct(I, m, n) with *
  have equations : ∀ i ∈ functionSupport(m, I, 0) ∪ functionSupport(n, I, 0), monomialWeights(I, functionSupport(m, I, 0) ∪ functionSupport(n, I, 0), A, add, zero, neg, mul, one, v,  monomialProduct(I, m, n))(i) = call2(mul, monomialWeights(I, functionSupport(m, I, 0) ∪ functionSupport(n, I, 0), A, add, zero, neg, mul, one, v,  m)(i), monomialWeights(I, functionSupport(m, I, 0) ∪ functionSupport(n, I, 0), A, add, zero, neg, mul, one, v,  n)(i))
    intros i hi
    have included := domain
    have index := included with i, hi
    have exponentM := monomials.exponent at I, m, i with *
    have exponentN := monomials.exponent at I, n, i with *
    have image := FunctionBetween.apply_closed at v, I, A, i with *
    have ordinary := IsCommRing.ring with ring
    have multiplicative := IsRing.multiplicative with ordinary
    have power := monoidPow.add at A, mul, one, v(i), m(i), n(i) with *
    have exponent := monomialProduct.value at I, m, n, i with *
    have left := monomialWeights.value at I, functionSupport(m, I, 0) ∪ functionSupport(n, I, 0), A, add, zero, neg, mul, one, v, monomialProduct(I, m, n), i with *
    have first := monomialWeights.value at I, functionSupport(m, I, 0) ∪ functionSupport(n, I, 0), A, add, zero, neg, mul, one, v, m, i with *
    have second := monomialWeights.value at I, functionSupport(m, I, 0) ∪ functionSupport(n, I, 0), A, add, zero, neg, mul, one, v, n, i with *
    cc
  have multiply := finiteRingProduct.mul with *
  cc

theorem monomialEvaluate.character
  shows MonomialCharacter(I, A, mul, one, monomialEvaluate(I, A, add, zero, neg, mul, one, v))
proof
  have function := monomialEvaluate.function at I, A, add, zero, neg, mul, one, v with *
  have unit := monomialEvaluate.one at I, A, add, zero, neg, mul, one, v with *
  unfold MonomialCharacter
  refine ⟨function, unit, ?_⟩
  intros m hm n hn
  exact monomialEvaluate.mul with *

theorem monomialEvaluate.variable (j : Set)
  requires index : j ∈ I
  shows monomialEvaluate(I, A, add, zero, neg, mul, one, v)(monomialVariable(I, j)) = v(j)
proof
  have member := monomialVariable.member at I, j
  have finite := Finite.singleton at j
  have domain : {j} ⊆ I by simp [Subset, singleton.membership]
  have covers : functionSupport(monomialVariable(I, j), I, 0) ⊆ {j}
    intros i hi
    have data := functionSupport.membership.forward with hi
    have alternatives : i = j ∨ i ≠ j by tauto
    cases alternatives with same | other
    . exact singleton.membership.backward at i, j with same
    . have exponent := monomialVariable.other at I, j, i with *
      exfalso
      exact data.right with exponent
  have value := monomialEvaluate.on_domain at I, A, add, zero, neg, mul, one, v, monomialVariable(I, j), {j} with *
  have weights := monomialWeights.function at I, {j}, A, add, zero, neg, mul, one, v, monomialVariable(I, j) with *
  have product := finiteRingProduct.singleton at A, add, zero, neg, mul, one, monomialWeights(I, {j}, A, add, zero, neg, mul, one, v,  monomialVariable(I, j)), j with *
  have self := singleton.self at j
  have weight := monomialWeights.value at I, {j}, A, add, zero, neg, mul, one, v, monomialVariable(I, j), j with *
  have exponent := monomialVariable.same at I, j with *
  have image := FunctionBetween.apply_closed at v, I, A, j with *
  have ordinary := IsCommRing.ring with ring
  have multiplicative := IsRing.multiplicative with ordinary
  have identity := IsMonoid.right_identity at A, mul, one, v(j) with *
  rwa [value, product, weight, exponent, monoidPow.succ, monoidPow.zero]

theorem polynomialAt.hom
  shows IsRingHom(polynomialAt(I, A, add, zero, neg, mul, one, v), polynomials(I, A, zero), polynomialAdd(I, A, add, zero, neg, mul, one), constantFunction(monomials(I), A, zero), polynomialNeg(I, A, add, zero, neg, mul, one), polynomialMul(I, A, add, zero, neg, mul, one), polynomialConstant(I, A, zero, one), A, add, zero, neg, mul, one)
proof
  have character := monomialEvaluate.character with *
  unfold polynomialAt
  exact polynomialEvaluate.hom with *

theorem polynomialAt.constant (a : Set)
  requires coefficient : a ∈ A
  shows polynomialAt(I, A, add, zero, neg, mul, one, v)(polynomialConstant(I, A, zero, a)) = a
proof
  have character := monomialEvaluate.character with *
  unfold polynomialAt
  exact polynomialEvaluate.constant with *

theorem polynomialAt.variable (j : Set)
  requires index : j ∈ I
  shows polynomialAt(I, A, add, zero, neg, mul, one, v)(polynomialVariable(I, A, zero, one, j)) = v(j)
proof
  have function := monomialEvaluate.function at I, A, add, zero, neg, mul, one, v with *
  have monomial := monomialVariable.member at I, j
  have ordinary := IsCommRing.ring with ring
  have multiplicative := IsRing.multiplicative with ordinary
  have oneIn := IsMonoid.unit_in_carrier with multiplicative
  have image := FunctionBetween.apply_closed at v, I, A, j with *
  have value := monomialEvaluate.variable at I, A, add, zero, neg, mul, one, v, j with *
  have term := polynomialEvaluate.term at I, A, add, zero, neg, mul, one, monomialEvaluate(I, A, add, zero, neg, mul, one, v), one, monomialVariable(I, j) with *
  have identity := IsMonoid.left_identity at A, mul, one, v(j) with *
  unfold polynomialAt
  unfold polynomialVariable
  cc

theorem polynomialAt.surjective
  shows SurjectiveBetween(polynomialAt(I, A, add, zero, neg, mul, one, v), polynomials(I, A, zero), A)
proof
  have hom := polynomialAt.hom at I, A, add, zero, neg, mul, one, v with *
  have function := IsRingHom.function with hom
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  constructor
  . exact function
  . intros a ha
    have member := polynomialConstant.member at I, A, zero, a with *
    have value := polynomialAt.constant at I, A, add, zero, neg, mul, one, v, a with *
    have edge := FunctionBetween.relates_apply at polynomialAt(I, A, add, zero, neg, mul, one, v), polynomials(I, A, zero), A, polynomialConstant(I, A, zero, a) with *
    witness polynomialConstant(I, A, zero, a)
    constructor
    . exact member
    . rw value at edge
      exact edge

theorem polynomialAt.kernel_ideal
  shows IsIdeal(polynomials(I, A, zero), polynomialAdd(I, A, add, zero, neg, mul, one), constantFunction(monomials(I), A, zero), polynomialNeg(I, A, add, zero, neg, mul, one), polynomialMul(I, A, add, zero, neg, mul, one), ringKernel(polynomialAt(I, A, add, zero, neg, mul, one, v), polynomials(I, A, zero), zero))
proof
  have source := polynomials.comm_ring at I, A, add, zero, neg, mul, one with *
  have hom := polynomialAt.hom with *
  exact IsRingHom.kernel_ideal with source, ring, hom

end Evaluation
-- The certificate-to-unsatisfiability direction over every nontrivial ring.
predicate PolynomialCommonZero (I A add zero neg mul one G v : Set) :=
  FunctionBetween(v, I, A) ∧ (∀ p ∈ G, polynomialAt(I, A, add, zero, neg, mul, one, v)(p) = zero)

notation scoped PolynomialCommonZero(I, R, G, v) => PolynomialCommonZero(I, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, G, v)

section Certificates
variable (I A add zero neg mul one G : Set)
hypothesis ring : IsCommRing(A, add, zero, neg, mul, one)
hypothesis nontrivial : Nontrivial(A, zero, one)
notation ring R := (A, add, zero, neg, mul, one)
notation ring P := R[I]

theorem polynomialIdeal.no_common_zero
  requires generators : G ⊆ P
  requires certificate : P[1] ∈ idealSpan(P, polynomialAdd(I, A, add, zero, neg, mul, one), P[0], polynomialNeg(I, A, add, zero, neg, mul, one), polynomialMul(I, A, add, zero, neg, mul, one), G)
  shows ¬(∃ v, PolynomialCommonZero(I, R, G, v))
proof
  intro exists
  obtain ⟨v, common⟩ := exists
  unfold PolynomialCommonZero at common
  have source := polynomials.comm_ring at I, A, add, zero, neg, mul, one with *
  have hom := polynomialAt.hom at I, A, add, zero, neg, mul, one, v with *
  have impossible := idealSpan.unit_obstructs_vanishing with source, ring, hom, nontrivial, generators, certificate
  exact impossible with common.right

theorem polynomialIdeal.no_common_zero_of_combination (p q a b : Set)
  requires generators : G ⊆ P
  requires hp : p ∈ G
  requires hq : q ∈ G
  requires ha : a ∈ P
  requires hb : b ∈ P
  requires identity : P[a * p + b * q] = P[1]
  shows ¬(∃ v, PolynomialCommonZero(I, R, G, v))
proof
  have source := polynomials.comm_ring at I, A, add, zero, neg, mul, one with *
  have certificate := idealSpan.unit_of_linear_combination2 with source, generators, hp, hq, ha, hb, identity
  exact polynomialIdeal.no_common_zero with *

end Certificates
