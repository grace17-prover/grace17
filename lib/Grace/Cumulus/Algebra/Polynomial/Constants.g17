module Grace.Cumulus.Algebra.Polynomial.Constants
import Ring

defgraph polynomialCoefficients (I A zero : Set) (a ∈ A) : polynomials(I, A, zero) := polynomialConstant(I, A, zero, a)
requires zeroIn : zero ∈ A
proof
  exact polynomialConstant.member at I, A, zero, a with *

notation scoped polynomialCoefficients(I, R) => polynomialCoefficients(I, R.carrier, R.zero)

theorem polynomialConstant.value (I A zero a m : Set)
  requires zeroIn : zero ∈ A
  requires coefficient : a ∈ A
  requires monomial : m ∈ monomials(I)
  shows polynomialConstant(I, A, zero, a)(m) = singleValue(A, zero, a, monomialOne(I), m)
proof
  unfold polynomialConstant
  unfold polynomialTerm
  exact coefficientSingle.value at monomials(I), A, zero, a, monomialOne(I), m with *

theorem polynomialConstant.zero (I A zero : Set)
  requires zeroIn : zero ∈ A
  shows polynomialConstant(I, A, zero, zero) = constantFunction(monomials(I), A, zero)
proof
  have member := polynomialConstant.member at I, A, zero, zero with *
  have function := polynomials.function with member
  have target := constantFunction.function at monomials(I), A, zero with *
  apply FunctionBetween.ext with function, target
  intros m hm
  have value := polynomialConstant.value at I, A, zero, zero, m with *
  have selected := singleValue.zero at A, zero, monomialOne(I), m with *
  have constant := constantFunction.apply at monomials(I), A, m, zero with *
  cc

section Rings
variable (I A add zero neg mul one : Set)
hypothesis ring : IsCommRing(A, add, zero, neg, mul, one)
notation ring R := (A, add, zero, neg, mul, one)

theorem polynomialConstant.add (a b : Set)
  requires coefficientA : a ∈ A
  requires coefficientB : b ∈ A
  shows polynomialConstant(I, A, zero, a + b) = coefficientAdd(monomials(I), A, add, zero, neg, mul, one, polynomialConstant(I, A, zero, a), polynomialConstant(I, A, zero, b))
proof
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have sumIn := IsRing.add_closed at A, add, zero, neg, mul, one, a, b with *
  have memberA := polynomialConstant.member at I, A, zero, a with *
  have memberB := polynomialConstant.member at I, A, zero, b with *
  have memberSum := polynomialConstant.member at I, A, zero, a + b with *
  have functionA := polynomials.function with memberA
  have functionB := polynomials.function with memberB
  have functionSum := polynomials.function with memberSum
  have target := coefficientAdd.function at monomials(I), A, add, zero, neg, mul, one, polynomialConstant(I, A, zero, a), polynomialConstant(I, A, zero, b) with *
  apply FunctionBetween.ext with functionSum, target
  intros m hm
  have left := polynomialConstant.value at I, A, zero, a + b, m with *
  have valueA := polynomialConstant.value at I, A, zero, a, m with *
  have valueB := polynomialConstant.value at I, A, zero, b, m with *
  have right := coefficientAdd.value at monomials(I), A, add, zero, neg, mul, one, polynomialConstant(I, A, zero, a), polynomialConstant(I, A, zero, b), m with *
  have distribute := singleValue.add at A, add, zero, neg, mul, one, a, b, monomialOne(I), m with *
  cc

theorem polynomialConstant.neg (a : Set)
  requires coefficient : a ∈ A
  shows polynomialConstant(I, A, zero, -a) = coefficientNeg(monomials(I), A, add, zero, neg, mul, one, polynomialConstant(I, A, zero, a))
proof
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have negative := IsRing.neg_closed at A, add, zero, neg, mul, one, a with *
  have memberA := polynomialConstant.member at I, A, zero, a with *
  have memberNeg := polynomialConstant.member at I, A, zero, -a with *
  have functionA := polynomials.function with memberA
  have functionNeg := polynomials.function with memberNeg
  have target := coefficientNeg.function at monomials(I), A, add, zero, neg, mul, one, polynomialConstant(I, A, zero, a) with *
  apply FunctionBetween.ext with functionNeg, target
  intros m hm
  have left := polynomialConstant.value at I, A, zero, -a, m with *
  have valueA := polynomialConstant.value at I, A, zero, a, m with *
  have right := coefficientNeg.value at monomials(I), A, add, zero, neg, mul, one, polynomialConstant(I, A, zero, a), m with *
  have alternatives : m = monomialOne(I) ∨ m ≠ monomialOne(I) by tauto
  cases alternatives with same | different
  . have selectA := singleValue.same at A, zero, a, monomialOne(I), m with *
    have selectNeg := singleValue.same at A, zero, -a, monomialOne(I), m with *
    cc
  . have selectA := singleValue.other at A, zero, a, monomialOne(I), m with *
    have selectNeg := singleValue.other at A, zero, -a, monomialOne(I), m with *
    have negZero : -zero = zero by ring
    cc

theorem polynomialConstant.mul (a b : Set)
  requires coefficientA : a ∈ A
  requires coefficientB : b ∈ A
  shows polynomialConstant(I, A, zero, a * b) = polynomialProduct(I, A, add, zero, neg, mul, one, polynomialConstant(I, A, zero, a), polynomialConstant(I, A, zero, b))
proof
  have unit := monomialOne.member at I
  have terms := polynomialProduct.terms at I, A, add, zero, neg, mul, one, a, b, monomialOne(I), monomialOne(I) with *
  have unitLaw := monomialProduct.one with *
  unfold polynomialConstant
  unfold polynomialConstant
  unfold polynomialConstant
  cc

theorem polynomialCoefficients.hom
  shows IsRingHom(polynomialCoefficients(I, A, zero), A, add, zero, neg, mul, one, polynomials(I, A, zero), polynomialAdd(I, A, add, zero, neg, mul, one), constantFunction(monomials(I), A, zero), polynomialNeg(I, A, add, zero, neg, mul, one), polynomialMul(I, A, add, zero, neg, mul, one), polynomialConstant(I, A, zero, one))
proof
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have multiplicative := IsRing.multiplicative with ordinary
  have oneIn := IsMonoid.unit_in_carrier with multiplicative
  have function := polynomialCoefficients.function at I, A, zero with *
  have zeroValue := polynomialCoefficients.value at I, A, zero, zero with *
  have zeroLaw := polynomialConstant.zero at I, A, zero with *
  have oneValue := polynomialCoefficients.value at I, A, zero, one with *
  have preservesZero : polynomialCoefficients(I, A, zero)(zero) = constantFunction(monomials(I), A, zero) by cc
  have preservesNeg : ∀ x ∈ A, polynomialCoefficients(I, A, zero)(-x) = (polynomialNeg(I, A, add, zero, neg, mul, one))(polynomialCoefficients(I, A, zero)(x))
    intros x hx
    have negative := IsRing.neg_closed with hx
    have member := polynomialConstant.member at I, A, zero, x with *
    have source := polynomialCoefficients.value at I, A, zero, -x with *
    have value := polynomialCoefficients.value at I, A, zero, x with *
    have target := polynomialNeg.apply with *
    have law := polynomialConstant.neg at I, A, add, zero, neg, mul, one, x with *
    cc
  have preservesAdd : ∀ x ∈ A, ∀ y ∈ A, polynomialCoefficients(I, A, zero)(x + y) = (polynomialAdd(I, A, add, zero, neg, mul, one))(polynomialCoefficients(I, A, zero)(x), polynomialCoefficients(I, A, zero)(y))
    intros x hx y hy
    have closed := IsRing.add_closed with hx, hy
    have memberX := polynomialConstant.member at I, A, zero, x with *
    have memberY := polynomialConstant.member at I, A, zero, y with *
    have source := polynomialCoefficients.value at I, A, zero, x + y with *
    have valueX := polynomialCoefficients.value at I, A, zero, x with *
    have valueY := polynomialCoefficients.value at I, A, zero, y with *
    have target := polynomialAdd.apply at I, A, add, zero, neg, mul, one, polynomialConstant(I, A, zero, x), polynomialConstant(I, A, zero, y) with *
    have law := polynomialConstant.add at I, A, add, zero, neg, mul, one, x, y with *
    cc
  have preservesMul : ∀ x ∈ A, ∀ y ∈ A, polynomialCoefficients(I, A, zero)(x * y) = (polynomialMul(I, A, add, zero, neg, mul, one))(polynomialCoefficients(I, A, zero)(x), polynomialCoefficients(I, A, zero)(y))
    intros x hx y hy
    have closed := IsRing.mul_closed with hx, hy
    have memberX := polynomialConstant.member at I, A, zero, x with *
    have memberY := polynomialConstant.member at I, A, zero, y with *
    have source := polynomialCoefficients.value at I, A, zero, x * y with *
    have valueX := polynomialCoefficients.value at I, A, zero, x with *
    have valueY := polynomialCoefficients.value at I, A, zero, y with *
    have target := polynomialMul.apply at I, A, add, zero, neg, mul, one, polynomialConstant(I, A, zero, x), polynomialConstant(I, A, zero, y) with *
    have law := polynomialConstant.mul at I, A, add, zero, neg, mul, one, x, y with *
    cc
  unfold IsRingHom
  refine ⟨function, preservesZero, oneValue, preservesNeg, preservesAdd, preservesMul⟩

end Rings

theorem polynomialCoefficients.injective (I A zero : Set)
  requires zeroIn : zero ∈ A
  shows InjectiveBetween(polynomialCoefficients(I, A, zero), A, polynomials(I, A, zero))
proof
  have function := polynomialCoefficients.function at I, A, zero with *
  constructor
  . exact function
  . intros x hx y hy z hz hxz hyz
    have valueX := FunctionBetween.apply_value at polynomialCoefficients(I, A, zero), A, polynomials(I, A, zero), x, z with *
    have valueY := FunctionBetween.apply_value at polynomialCoefficients(I, A, zero), A, polynomials(I, A, zero), y, z with *
    have constantX := polynomialCoefficients.value at I, A, zero, x with *
    have constantY := polynomialCoefficients.value at I, A, zero, y with *
    have equal : polynomialConstant(I, A, zero, x) = polynomialConstant(I, A, zero, y) by cc
    exact polynomialConstant.injective at I, A, zero, x, y with *
