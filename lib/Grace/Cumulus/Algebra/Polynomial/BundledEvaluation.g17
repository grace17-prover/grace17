-- Evaluation of bundled polynomials: evaluationHom(R, S, I, f, v), the
-- homomorphism polynomialRing(R, I) →+* S sending the constants through
-- f : R →+* S and the variable X(R, I, j) to v(j), its universal property,
-- and evaluationAt(R, I, v) at a point of the coefficient ring; everything
-- here is ZF
-- Part of Cumulus, the Grace17 mathematics library.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module Grace.Cumulus.Algebra.Polynomial.BundledEvaluation
import Bundled
import EvaluationOver

-- Evaluation at an assignment v : I → S through a coefficient
-- homomorphism f, and at a point v : I → R of the coefficient ring itself.
def evaluationHom (R S I f v : Set) : Set :=
  polynomialAtOver(I, R.carrier, R.add, R.zero, R.neg, R.mul, R.one,
    S.carrier, S.add, S.zero, S.neg, S.mul, S.one, f, v)
def evaluationAt (R I v : Set) : Set :=
  polynomialAt(I, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, v)

theorem evaluationHom.graph (R S I f v : Set)
  shows evaluationHom(R, S, I, f, v) =
    polynomialAtOver(I, R.carrier, R.add, R.zero, R.neg, R.mul, R.one,
      S.carrier, S.add, S.zero, S.neg, S.mul, S.one, f, v)
proof
  simp [evaluationHom]

theorem evaluationAt.graph (R I v : Set)
  shows evaluationAt(R, I, v) =
    polynomialAt(I, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, v)
proof
  simp [evaluationAt]

section Evaluation
variable (R S I f v : Set)
notation ring K := (R.carrier, R.add, R.zero, R.neg, R.mul, R.one)
notation ring L := (S.carrier, S.add, S.zero, S.neg, S.mul, S.one)
notation ring P := K[I]
hypothesis source : CommRing(R)
hypothesis target : CommRing(S)
hypothesis hom : f : R →+* S
hypothesis assignment : v : I → S.carrier

theorem evaluationHom.hom
  shows evaluationHom(R, S, I, f, v) : polynomialRing(R, I) →+* S
proof
  have sourceParts := CommRing.parts with source
  have targetParts := CommRing.parts with target
  have homParts := RingHom.parts with hom
  have engine := polynomialAtOver.hom with sourceParts, targetParts,
    homParts, assignment
  rw evaluationHom.graph
  exact RingHom.polynomial_of_parts with source, target, engine

instance evaluationHom.map_mem (p : polynomialRing(R, I))
  shows evaluationHom(R, S, I, f, v)(p) ∈ S
proof
  have evaluation := evaluationHom.hom at R, S, I, f, v with *
  exact RingHom.map_mem with *

theorem evaluationHom.map_constant (a : R)
  shows evaluationHom(R, S, I, f, v)(polynomialConstant(R, I)(a)) = f(a)
proof
  have sourceParts := CommRing.parts with source
  have targetParts := CommRing.parts with target
  have homParts := RingHom.parts with hom
  have aIn : a ∈ R by assumption
  have engine := polynomialAtOver.constant with sourceParts, targetParts,
    homParts, assignment, aIn
  rw [polynomialConstant.apply, evaluationHom.graph]
  exact engine

theorem evaluationHom.map_X (j : Set)
  requires index : j ∈ I
  shows evaluationHom(R, S, I, f, v)(X(R, I, j)) = v(j)
proof
  have sourceParts := CommRing.parts with source
  have targetParts := CommRing.parts with target
  have homParts := RingHom.parts with hom
  have engine := polynomialAtOver.variable with sourceParts, targetParts,
    homParts, assignment, index
  rw [X.value, evaluationHom.graph]
  exact engine

-- A homomorphism agreeing with f on the constants and with v on the
-- variables is the evaluation.
theorem evaluationHom.unique (g : Set)
  requires candidate : g : polynomialRing(R, I) →+* S
  requires constants : ∀ a ∈ R, g(polynomialConstant(R, I)(a)) = f(a)
  requires variables : ∀ j ∈ I, g(X(R, I, j)) = v(j)
  shows g = evaluationHom(R, S, I, f, v)
proof
  have sourceParts := CommRing.parts with source
  have targetParts := CommRing.parts with target
  have homParts := RingHom.parts with hom
  have engineHom := RingHom.polynomial_parts with source, target, candidate
  have engineConstants : ∀ a ∈ R, g(polynomialConstant(I, K, a)) = f(a)
    intros a ha
    rw ← polynomialConstant.apply
    exact constants with a, ha
  have engineVariables : ∀ j ∈ I, g(polynomialVariable(I, K, j)) = v(j)
    intros j hj
    rw ← X.value
    exact variables with j, hj
  rw evaluationHom.graph
  exact polynomialAtOver.unique with sourceParts, targetParts, homParts,
    assignment, engineHom, engineConstants, engineVariables

-- The universal property of the polynomial ring: exactly one homomorphism
-- extends f along the constants and sends each variable to its value.
theorem polynomialRing.universal
  shows (evaluationHom(R, S, I, f, v) : polynomialRing(R, I) →+* S) ∧
    (∀ a ∈ R,
      evaluationHom(R, S, I, f, v)(polynomialConstant(R, I)(a)) = f(a)) ∧
    (∀ j ∈ I, evaluationHom(R, S, I, f, v)(X(R, I, j)) = v(j)) ∧
    (∀ g, (g : polynomialRing(R, I) →+* S) →
      (∀ a ∈ R, g(polynomialConstant(R, I)(a)) = f(a)) →
      (∀ j ∈ I, g(X(R, I, j)) = v(j)) → g = evaluationHom(R, S, I, f, v))
proof
  have evaluation := evaluationHom.hom at R, S, I, f, v with *
  refine ⟨evaluation, ?_, ?_, ?_⟩
  . intros a ha
    exact evaluationHom.map_constant with *
  . intros j hj
    exact evaluationHom.map_X with *
  . intros g candidate constants variables
    exact evaluationHom.unique with *

end Evaluation

section Points
variable (R I v : Set)
notation ring K := (R.carrier, R.add, R.zero, R.neg, R.mul, R.one)
notation ring P := K[I]
hypothesis comm : CommRing(R)
hypothesis assignment : v : I → R.carrier

theorem evaluationAt.hom
  shows evaluationAt(R, I, v) : polynomialRing(R, I) →+* R
proof
  have parts := CommRing.parts with comm
  have engine := polynomialAt.hom with parts, assignment
  rw evaluationAt.graph
  exact RingHom.polynomial_of_parts with comm, comm, engine

instance evaluationAt.map_mem (p : polynomialRing(R, I))
  shows evaluationAt(R, I, v)(p) ∈ R
proof
  have evaluation := evaluationAt.hom at R, I, v with *
  exact RingHom.map_mem with *

theorem evaluationAt.map_constant (a : R)
  shows evaluationAt(R, I, v)(polynomialConstant(R, I)(a)) = a
proof
  have parts := CommRing.parts with comm
  have aIn : a ∈ R by assumption
  have engine := polynomialAt.constant with parts, assignment, aIn
  rw [polynomialConstant.apply, evaluationAt.graph]
  exact engine

theorem evaluationAt.map_X (j : Set)
  requires index : j ∈ I
  shows evaluationAt(R, I, v)(X(R, I, j)) = v(j)
proof
  have parts := CommRing.parts with comm
  have engine := polynomialAt.variable with parts, assignment, index
  rw [X.value, evaluationAt.graph]
  exact engine

theorem evaluationAt.surjective
  shows SurjectiveBetween(evaluationAt(R, I, v),
    Ring.carrier(polynomialRing(R, I)), R.carrier)
proof
  have parts := CommRing.parts with comm
  have engine := polynomialAt.surjective with parts, assignment
  rw [evaluationAt.graph, polynomialRing.carrierOf]
  exact engine

-- Evaluation at a point is evaluation through the identity of R.
theorem evaluationAt.eq_evaluationHom
  shows evaluationAt(R, I, v) = evaluationHom(R, R, I, identity(R.carrier), v)
proof
  have parts := CommRing.parts with comm
  have engine := polynomialAtOver.identity_coefficients with parts, assignment
  rw [evaluationAt.graph, evaluationHom.graph]
  symm
  exact engine

end Points
