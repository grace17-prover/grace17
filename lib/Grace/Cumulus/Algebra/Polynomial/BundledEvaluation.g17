-- Evaluation of bundled polynomials: evaluationHom(R, S, I, f, v), the
-- homomorphism polynomialRing(R, I) →+* S sending the constants through
-- f : R →+* S and the variable X(R, I, j) to v(j), its universal property,
-- the extensionality and round-trip laws for homomorphisms out of a
-- polynomial ring and out of an iterated one, evaluationAt(R, I, v) at a
-- point of the coefficient ring, and evaluation after an endomorphism as
-- evaluation at the pulled point; everything here is ZF
-- Part of Cumulus, the Grace17 mathematics library.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module Grace.Cumulus.Algebra.Polynomial.BundledEvaluation
import Bundled
import EvaluationOver

-- Evaluation at an assignment v : I → S through a coefficient
-- homomorphism f, and at a point v : I → R of the coefficient ring itself.
def evaluationHom (R S I f v : Set) : Set :=
  polynomialAtOver(I, R.carrier, R.add, R.zero, R.neg, R.mul, R.one,
    S.carrier, S.add, S.zero, S.neg, S.mul, S.one, f, v)
def evaluationAt (R I v : Set) : Set :=
  polynomialAt(I, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, v)

theorem evaluationHom.graph (R S I f v : Set)
  shows evaluationHom(R, S, I, f, v) =
    polynomialAtOver(I, R.carrier, R.add, R.zero, R.neg, R.mul, R.one,
      S.carrier, S.add, S.zero, S.neg, S.mul, S.one, f, v)
proof
  simp [evaluationHom]

theorem evaluationAt.graph (R I v : Set)
  shows evaluationAt(R, I, v) =
    polynomialAt(I, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, v)
proof
  simp [evaluationAt]

section Evaluation
variable (R S I f v : Set)
notation ring K := (R.carrier, R.add, R.zero, R.neg, R.mul, R.one)
notation ring L := (S.carrier, S.add, S.zero, S.neg, S.mul, S.one)
notation ring P := K[I]
hypothesis source : CommRing(R)
hypothesis target : CommRing(S)
hypothesis hom : f : R →+* S
hypothesis assignment : v : I → S.carrier

theorem evaluationHom.hom
  shows evaluationHom(R, S, I, f, v) : polynomialRing(R, I) →+* S
proof
  have sourceParts := CommRing.parts with source
  have targetParts := CommRing.parts with target
  have homParts := RingHom.parts with hom
  have engine := polynomialAtOver.hom with sourceParts, targetParts,
    homParts, assignment
  rw evaluationHom.graph
  exact RingHom.polynomial_of_parts with source, target, engine

instance evaluationHom.map_mem (p : polynomialRing(R, I))
  shows evaluationHom(R, S, I, f, v)(p) ∈ S
proof
  have evaluation := evaluationHom.hom at R, S, I, f, v with *
  exact RingHom.map_mem with *

theorem evaluationHom.map_constant (a : R)
  shows evaluationHom(R, S, I, f, v)(polynomialConstant(R, I)(a)) = f(a)
proof
  have sourceParts := CommRing.parts with source
  have targetParts := CommRing.parts with target
  have homParts := RingHom.parts with hom
  have aIn : a ∈ R by assumption
  have engine := polynomialAtOver.constant with sourceParts, targetParts,
    homParts, assignment, aIn
  rw [polynomialConstant.apply, evaluationHom.graph]
  exact engine

theorem evaluationHom.map_X (j : Set)
  requires index : j ∈ I
  shows evaluationHom(R, S, I, f, v)(X(R, I, j)) = v(j)
proof
  have sourceParts := CommRing.parts with source
  have targetParts := CommRing.parts with target
  have homParts := RingHom.parts with hom
  have engine := polynomialAtOver.variable with sourceParts, targetParts,
    homParts, assignment, index
  rw [X.value, evaluationHom.graph]
  exact engine

-- A homomorphism agreeing with f on the constants and with v on the
-- variables is the evaluation.
theorem evaluationHom.unique (g : Set)
  requires candidate : g : polynomialRing(R, I) →+* S
  requires constants : ∀ a ∈ R, g(polynomialConstant(R, I)(a)) = f(a)
  requires variables : ∀ j ∈ I, g(X(R, I, j)) = v(j)
  shows g = evaluationHom(R, S, I, f, v)
proof
  have sourceParts := CommRing.parts with source
  have targetParts := CommRing.parts with target
  have homParts := RingHom.parts with hom
  have engineHom := RingHom.polynomial_parts with source, target, candidate
  have engineConstants : ∀ a ∈ R, g(polynomialConstant(I, K, a)) = f(a)
    intros a ha
    rw ← polynomialConstant.apply
    exact constants with a, ha
  have engineVariables : ∀ j ∈ I, g(polynomialVariable(I, K, j)) = v(j)
    intros j hj
    rw ← X.value
    exact variables with j, hj
  rw evaluationHom.graph
  exact polynomialAtOver.unique with sourceParts, targetParts, homParts,
    assignment, engineHom, engineConstants, engineVariables

-- The universal property of the polynomial ring: exactly one homomorphism
-- extends f along the constants and sends each variable to its value.
theorem polynomialRing.universal
  shows (evaluationHom(R, S, I, f, v) : polynomialRing(R, I) →+* S) ∧
    (∀ a ∈ R,
      evaluationHom(R, S, I, f, v)(polynomialConstant(R, I)(a)) = f(a)) ∧
    (∀ j ∈ I, evaluationHom(R, S, I, f, v)(X(R, I, j)) = v(j)) ∧
    (∀ g, (g : polynomialRing(R, I) →+* S) →
      (∀ a ∈ R, g(polynomialConstant(R, I)(a)) = f(a)) →
      (∀ j ∈ I, g(X(R, I, j)) = v(j)) → g = evaluationHom(R, S, I, f, v))
proof
  have evaluation := evaluationHom.hom at R, S, I, f, v with *
  refine ⟨evaluation, ?_, ?_, ?_⟩
  . intros a ha
    exact evaluationHom.map_constant with *
  . intros j hj
    exact evaluationHom.map_X with *
  . intros g candidate constants variables
    exact evaluationHom.unique with *

end Evaluation

section Points
variable (R I v : Set)
notation ring K := (R.carrier, R.add, R.zero, R.neg, R.mul, R.one)
notation ring P := K[I]
hypothesis comm : CommRing(R)
hypothesis assignment : v : I → R.carrier

theorem evaluationAt.hom
  shows evaluationAt(R, I, v) : polynomialRing(R, I) →+* R
proof
  have parts := CommRing.parts with comm
  have engine := polynomialAt.hom with parts, assignment
  rw evaluationAt.graph
  exact RingHom.polynomial_of_parts with comm, comm, engine

instance evaluationAt.map_mem (p : polynomialRing(R, I))
  shows evaluationAt(R, I, v)(p) ∈ R
proof
  have evaluation := evaluationAt.hom at R, I, v with *
  exact RingHom.map_mem with *

theorem evaluationAt.map_constant (a : R)
  shows evaluationAt(R, I, v)(polynomialConstant(R, I)(a)) = a
proof
  have parts := CommRing.parts with comm
  have aIn : a ∈ R by assumption
  have engine := polynomialAt.constant with parts, assignment, aIn
  rw [polynomialConstant.apply, evaluationAt.graph]
  exact engine

theorem evaluationAt.map_X (j : Set)
  requires index : j ∈ I
  shows evaluationAt(R, I, v)(X(R, I, j)) = v(j)
proof
  have parts := CommRing.parts with comm
  have engine := polynomialAt.variable with parts, assignment, index
  rw [X.value, evaluationAt.graph]
  exact engine

theorem evaluationAt.surjective
  shows SurjectiveBetween(evaluationAt(R, I, v),
    Ring.carrier(polynomialRing(R, I)), R.carrier)
proof
  have parts := CommRing.parts with comm
  have engine := polynomialAt.surjective with parts, assignment
  rw [evaluationAt.graph, polynomialRing.carrierOf]
  exact engine

-- Evaluation at a point is evaluation through the identity of R.
theorem evaluationAt.eq_evaluationHom
  shows evaluationAt(R, I, v) = evaluationHom(R, R, I, identity(R.carrier), v)
proof
  have parts := CommRing.parts with comm
  have engine := polynomialAtOver.identity_coefficients with parts, assignment
  rw [evaluationAt.graph, evaluationHom.graph]
  symm
  exact engine

end Points

-- Homomorphisms out of a polynomial ring agreeing on the constants and
-- the variables are equal; so a homomorphism out of K[I] followed by one
-- back that fixes the constants and the variables fixes every polynomial.
theorem polynomialRing.hom_ext (K I S g h : Set)
  requires base : CommRing(K)
  requires first : g : polynomialRing(K, I) →+* S
  requires second : h : polynomialRing(K, I) →+* S
  requires constants : ∀ a ∈ K,
    g(polynomialConstant(K, I)(a)) = h(polynomialConstant(K, I)(a))
  requires variables : ∀ j ∈ I, g(X(K, I, j)) = h(X(K, I, j))
  shows g = h
proof
  have parts := CommRing.parts with base
  have gParts := RingHom.parts with first
  have hParts := RingHom.parts with second
  rw [polynomialRing.carrierOf, polynomialRing.addOf, polynomialRing.zeroOf,
    polynomialRing.negOf, polynomialRing.mulOf, polynomialRing.oneOf]
    at gParts, hParts
  have engineConstants : ∀ a ∈ K,
      g(polynomialConstant(I, K.carrier, K.zero, a)) =
        h(polynomialConstant(I, K.carrier, K.zero, a))
    intros a ha
    rw ← polynomialConstant.apply
    exact constants with a, ha
  have engineVariables : ∀ j ∈ I,
      g(polynomialVariable(I, K.carrier, K.zero, K.one, j)) =
        h(polynomialVariable(I, K.carrier, K.zero, K.one, j))
    intros j hj
    rw ← X.value
    exact variables with j, hj
  exact IsRingHom.polynomial_ext with parts, gParts, hParts, engineConstants,
    engineVariables

theorem polynomialRing.round_trip (K I S f g : Set)
  requires base : CommRing(K)
  requires forward : f : polynomialRing(K, I) →+* S
  requires backward : g : S →+* polynomialRing(K, I)
  requires constants : ∀ a ∈ K,
    g(f(polynomialConstant(K, I)(a))) = polynomialConstant(K, I)(a)
  requires variables : ∀ j ∈ I, g(f(X(K, I, j))) = X(K, I, j)
  shows ∀ p ∈ Ring.carrier(polynomialRing(K, I)), g(f(p)) = p
proof
  have ring := polynomialRing.comm_ring at K, I with base
  have composite := RingHom.comp with ring, forward, backward
  have identityHom := RingHom.id with ring
  have forwardFunction := forward.right.right.left
  have backwardFunction := backward.right.right.left
  have onConstants : ∀ a ∈ K,
      compose(g, f, Ring.carrier(polynomialRing(K, I)), Ring.carrier(S),
        Ring.carrier(polynomialRing(K, I)))(polynomialConstant(K, I)(a)) =
      identity(Ring.carrier(polynomialRing(K, I)))(polynomialConstant(K, I)(a))
    intros a ha
    have member := polynomialConstant.mem at K, I, a with base
    have step := compose.apply with forwardFunction, backwardFunction, member
    have fixed := identity.apply with member
    have law := constants with a, ha
    cc
  have onVariables : ∀ j ∈ I,
      compose(g, f, Ring.carrier(polynomialRing(K, I)), Ring.carrier(S),
        Ring.carrier(polynomialRing(K, I)))(X(K, I, j)) =
      identity(Ring.carrier(polynomialRing(K, I)))(X(K, I, j))
    intros j hj
    have member := X.mem at K, I, j with base
    have step := compose.apply with forwardFunction, backwardFunction, member
    have fixed := identity.apply with member
    have law := variables with j, hj
    cc
  have equal := polynomialRing.hom_ext with base, composite, identityHom,
    onConstants, onVariables
  intros p hp
  have step := compose.apply with forwardFunction, backwardFunction, hp
  have fixed := identity.apply with hp
  rw equal at step
  cc

-- Homomorphisms out of an iterated polynomial ring agreeing on the
-- constants, the inner variables, and the outer variables are equal; and
-- the round trip law that follows.
theorem polynomialRing.iterated_hom_ext (K I J S g h : Set)
  requires base : CommRing(K)
  requires first : g : polynomialRing(polynomialRing(K, I), J) →+* S
  requires second : h : polynomialRing(polynomialRing(K, I), J) →+* S
  requires constants : ∀ a ∈ K,
    g(polynomialConstant(polynomialRing(K, I), J)(
      polynomialConstant(K, I)(a))) =
    h(polynomialConstant(polynomialRing(K, I), J)(
      polynomialConstant(K, I)(a)))
  requires inner : ∀ i ∈ I,
    g(polynomialConstant(polynomialRing(K, I), J)(X(K, I, i))) =
      h(polynomialConstant(polynomialRing(K, I), J)(X(K, I, i)))
  requires outer : ∀ j ∈ J,
    g(X(polynomialRing(K, I), J, j)) = h(X(polynomialRing(K, I), J, j))
  shows g = h
proof
  have innerRing := polynomialRing.comm_ring at K, I with base
  have constantsHom := polynomialConstant.hom at polynomialRing(K, I), J
    with innerRing
  have gInner := RingHom.comp with innerRing, constantsHom, first
  have hInner := RingHom.comp with innerRing, constantsHom, second
  have constFunction := constantsHom.right.right.left
  have gFunction := first.right.right.left
  have hFunction := second.right.right.left
  -- The composites with the constants of K[I][J] agree on K[I].
  have innerConstants : ∀ a ∈ K,
      compose(g, polynomialConstant(polynomialRing(K, I), J),
        Ring.carrier(polynomialRing(K, I)),
        Ring.carrier(polynomialRing(polynomialRing(K, I), J)),
        Ring.carrier(S))(polynomialConstant(K, I)(a)) =
      compose(h, polynomialConstant(polynomialRing(K, I), J),
        Ring.carrier(polynomialRing(K, I)),
        Ring.carrier(polynomialRing(polynomialRing(K, I), J)),
        Ring.carrier(S))(polynomialConstant(K, I)(a))
    intros a ha
    have member := polynomialConstant.mem at K, I, a with base
    have stepG := compose.apply with constFunction, gFunction, member
    have stepH := compose.apply with constFunction, hFunction, member
    have agree := constants with a, ha
    cc
  have innerVariables : ∀ i ∈ I,
      compose(g, polynomialConstant(polynomialRing(K, I), J),
        Ring.carrier(polynomialRing(K, I)),
        Ring.carrier(polynomialRing(polynomialRing(K, I), J)),
        Ring.carrier(S))(X(K, I, i)) =
      compose(h, polynomialConstant(polynomialRing(K, I), J),
        Ring.carrier(polynomialRing(K, I)),
        Ring.carrier(polynomialRing(polynomialRing(K, I), J)),
        Ring.carrier(S))(X(K, I, i))
    intros i hi
    have member := X.mem at K, I, i with base
    have stepG := compose.apply with constFunction, gFunction, member
    have stepH := compose.apply with constFunction, hFunction, member
    have agree := inner with i, hi
    cc
  have innerEqual := polynomialRing.hom_ext with base, gInner, hInner,
    innerConstants, innerVariables
  -- So g and h agree on every constant of K[I][J], and on the variables.
  have outerConstants : ∀ q ∈ Ring.carrier(polynomialRing(K, I)),
      g(polynomialConstant(polynomialRing(K, I), J)(q)) =
        h(polynomialConstant(polynomialRing(K, I), J)(q))
    intros q hq
    have stepG := compose.apply with constFunction, gFunction, hq
    have stepH := compose.apply with constFunction, hFunction, hq
    rw innerEqual at stepG
    cc
  exact polynomialRing.hom_ext with innerRing, first, second, outerConstants,
    outer

theorem polynomialRing.iterated_round_trip (K I J S f g : Set)
  requires base : CommRing(K)
  requires forward : f : polynomialRing(polynomialRing(K, I), J) →+* S
  requires backward : g : S →+* polynomialRing(polynomialRing(K, I), J)
  requires constants : ∀ a ∈ K,
    g(f(polynomialConstant(polynomialRing(K, I), J)(
      polynomialConstant(K, I)(a)))) =
      polynomialConstant(polynomialRing(K, I), J)(polynomialConstant(K, I)(a))
  requires inner : ∀ i ∈ I,
    g(f(polynomialConstant(polynomialRing(K, I), J)(X(K, I, i)))) =
      polynomialConstant(polynomialRing(K, I), J)(X(K, I, i))
  requires outer : ∀ j ∈ J,
    g(f(X(polynomialRing(K, I), J, j))) = X(polynomialRing(K, I), J, j)
  shows ∀ p ∈ Ring.carrier(polynomialRing(polynomialRing(K, I), J)),
    g(f(p)) = p
proof
  have innerRing := polynomialRing.comm_ring at K, I with base
  have outerRing := polynomialRing.comm_ring at polynomialRing(K, I), J
    with innerRing
  have composite := RingHom.comp with outerRing, forward, backward
  have identityHom := RingHom.id with outerRing
  have forwardFunction := forward.right.right.left
  have backwardFunction := backward.right.right.left
  have onConstants : ∀ a ∈ K,
      compose(g, f, Ring.carrier(polynomialRing(polynomialRing(K, I), J)),
        Ring.carrier(S),
        Ring.carrier(polynomialRing(polynomialRing(K, I), J)))(
        polynomialConstant(polynomialRing(K, I), J)(
          polynomialConstant(K, I)(a))) =
      identity(Ring.carrier(polynomialRing(polynomialRing(K, I), J)))(
        polynomialConstant(polynomialRing(K, I), J)(
          polynomialConstant(K, I)(a)))
    intros a ha
    have innerIn := polynomialConstant.mem at K, I, a with base
    have member := polynomialConstant.mem at polynomialRing(K, I), J,
      polynomialConstant(K, I)(a) with innerRing
    have step := compose.apply with forwardFunction, backwardFunction, member
    have fixed := identity.apply with member
    have law := constants with a, ha
    cc
  have onInner : ∀ i ∈ I,
      compose(g, f, Ring.carrier(polynomialRing(polynomialRing(K, I), J)),
        Ring.carrier(S),
        Ring.carrier(polynomialRing(polynomialRing(K, I), J)))(
        polynomialConstant(polynomialRing(K, I), J)(X(K, I, i))) =
      identity(Ring.carrier(polynomialRing(polynomialRing(K, I), J)))(
        polynomialConstant(polynomialRing(K, I), J)(X(K, I, i)))
    intros i hi
    have xIn := X.mem at K, I, i with base
    have member := polynomialConstant.mem at polynomialRing(K, I), J, X(K, I, i)
      with innerRing
    have step := compose.apply with forwardFunction, backwardFunction, member
    have fixed := identity.apply with member
    have law := inner with i, hi
    cc
  have onOuter : ∀ j ∈ J,
      compose(g, f, Ring.carrier(polynomialRing(polynomialRing(K, I), J)),
        Ring.carrier(S),
        Ring.carrier(polynomialRing(polynomialRing(K, I), J)))(
        X(polynomialRing(K, I), J, j)) =
      identity(Ring.carrier(polynomialRing(polynomialRing(K, I), J)))(
        X(polynomialRing(K, I), J, j))
    intros j hj
    have member := X.mem at polynomialRing(K, I), J, j with innerRing
    have step := compose.apply with forwardFunction, backwardFunction, member
    have fixed := identity.apply with member
    have law := outer with j, hj
    cc
  have equal := polynomialRing.iterated_hom_ext with base, composite,
    identityHom, onConstants, onInner, onOuter
  intros p hp
  have step := compose.apply with forwardFunction, backwardFunction, hp
  have fixed := identity.apply with hp
  rw equal at step
  cc

-- Evaluation after an endomorphism of the polynomial ring fixing the
-- constants is evaluation at another point, the pulled point, whose k-th
-- coordinate is the value of φ(X_k) at c.
def pulledPoint (R I φ c : Set) : Set :=
  { p ∈ I × Ring.carrier(R) |
    snd(p) = evaluationAt(R, I, c)(φ(X(R, I, fst(p)))) }

section Pulled
variable (R I φ c : Set)
hypothesis comm : CommRing(R)
hypothesis hom : φ : polynomialRing(R, I) →+* polynomialRing(R, I)
hypothesis assignment : c : I → R.carrier

theorem pulledPoint.coordinate_mem (k : Set)
  requires position : k ∈ I
  shows evaluationAt(R, I, c)(φ(X(R, I, k))) ∈ Ring.carrier(R)
proof
  have evaluation := evaluationAt.hom at R, I, c with comm, assignment
  have variable : X(R, I, k) ∈ polynomialRing(R, I) := X.mem at R, I, k with *
  have mapped : φ(X(R, I, k)) ∈ polynomialRing(R, I) :=
    RingHom.map_mem with hom, variable
  exact RingHom.map_mem with evaluation, mapped

theorem pulledPoint.function
  shows pulledPoint(R, I, φ, c) : I → Ring.carrier(R)
proof
  constructor
  . intros e he
    exact he.left
  constructor
  . intros x y relatedY z relatedZ
    obtain ⟨_, shapeY⟩ := relatedY
    obtain ⟨_, shapeZ⟩ := relatedZ
    simp [fst.pair, snd.pair] at shapeY, shapeZ
    cc
  . intros k hk
    have valueIn := pulledPoint.coordinate_mem with comm, hom, assignment, hk
    refine ⟨evaluationAt(R, I, c)(φ(X(R, I, k))), valueIn, _⟩
    apply pulledPoint.membership.backward
    refine ⟨(product.pair with hk, valueIn), _⟩
    simp [fst.pair, snd.pair]

theorem pulledPoint.value (k : Set)
  requires position : k ∈ I
  shows pulledPoint(R, I, φ, c)(k) = evaluationAt(R, I, c)(φ(X(R, I, k)))
proof
  have function := pulledPoint.function with *
  have valueIn := pulledPoint.coordinate_mem with comm, hom, assignment,
    position
  have related : relates(pulledPoint(R, I, φ, c), k,
      evaluationAt(R, I, c)(φ(X(R, I, k))))
    apply pulledPoint.membership.backward
    refine ⟨(product.pair with position, valueIn), _⟩
    simp [fst.pair, snd.pair]
  exact FunctionBetween.apply_value with function, position, related

-- Evaluation at c after φ is evaluation at the pulled point.
theorem evaluationAt.compose_hom
  requires constants : ∀ a ∈ R,
    φ(polynomialConstant(R, I)(a)) = polynomialConstant(R, I)(a)
  shows compose(evaluationAt(R, I, c), φ, Ring.carrier(polynomialRing(R, I)),
      Ring.carrier(polynomialRing(R, I)), Ring.carrier(R)) =
    evaluationAt(R, I, pulledPoint(R, I, φ, c))
proof
  have polynomials := polynomialRing.comm_ring at R, I with comm
  have evaluation := evaluationAt.hom at R, I, c with comm, assignment
  have pulled := pulledPoint.function with *
  have pulledEvaluation := evaluationAt.hom at R, I, pulledPoint(R, I, φ, c)
    with comm, pulled
  have composite := RingHom.comp with polynomials, hom, evaluation
  obtain ⟨_, _, functionPhi, _⟩ := hom
  obtain ⟨_, _, functionEvaluation, _⟩ := evaluation
  -- The two homomorphisms agree on constants and on variables.
  have onConstants : ∀ a ∈ R,
      compose(evaluationAt(R, I, c), φ, Ring.carrier(polynomialRing(R, I)),
        Ring.carrier(polynomialRing(R, I)),
        Ring.carrier(R))(polynomialConstant(R, I)(a)) =
      evaluationAt(R, I, pulledPoint(R, I, φ, c))(polynomialConstant(R, I)(a))
    intros a ha
    have constantIn : polynomialConstant(R, I)(a) ∈ polynomialRing(R, I) :=
      polynomialConstant.mem at R, I, a with *
    have fixed := constants with a, ha
    have atC := evaluationAt.map_constant at R, I, c, a with *
    have atPulled := evaluationAt.map_constant at R, I,
      pulledPoint(R, I, φ, c), a with *
    rw compose.apply with functionPhi, functionEvaluation, constantIn
    rw [fixed, atC, atPulled]
  have onVariables : ∀ j ∈ I,
      compose(evaluationAt(R, I, c), φ, Ring.carrier(polynomialRing(R, I)),
        Ring.carrier(polynomialRing(R, I)), Ring.carrier(R))(X(R, I, j)) =
      evaluationAt(R, I, pulledPoint(R, I, φ, c))(X(R, I, j))
    intros j hj
    have variable : X(R, I, j) ∈ polynomialRing(R, I) :=
      X.mem at R, I, j with *
    have atPulled := evaluationAt.map_X at R, I, pulledPoint(R, I, φ, c), j
      with *
    have coordinate := pulledPoint.value with comm, hom, assignment, hj
    rw compose.apply with functionPhi, functionEvaluation, variable
    rw [atPulled, coordinate]
  exact polynomialRing.hom_ext with comm, composite, pulledEvaluation,
    onConstants, onVariables

end Pulled
