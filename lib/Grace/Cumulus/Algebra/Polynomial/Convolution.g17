module Grace.Cumulus.Algebra.Polynomial.Convolution
import Polynomial
import Ring.Pushforward
import Cardinal.Product

def convolutionPairs (I zero p q : Set) : Set :=
  functionSupport(p, monomials(I), zero) × functionSupport(q, monomials(I), zero)

theorem convolutionPairs.subset (I zero p q : Set)
  shows convolutionPairs(I, zero, p, q) ⊆ monomials(I) × monomials(I)
proof
  have supportP := functionSupport.subset at p, monomials(I), zero
  have supportQ := functionSupport.subset at q, monomials(I), zero
  unfold convolutionPairs
  exact product.monotone with supportP, supportQ

theorem convolutionPairs.finite (I A zero p q : Set)
  requires memberP : p ∈ polynomials(I, A, zero)
  requires memberQ : q ∈ polynomials(I, A, zero)
  shows Finite(convolutionPairs(I, zero, p, q))
proof
  have finiteP := polynomials.finite_support with memberP
  have finiteQ := polynomials.finite_support with memberQ
  unfold convolutionPairs
  exact Finite.product with finiteP, finiteQ

defunique polynomialPairCoefficient (I A add zero neg mul one p q t : Set) (a ∈ A) :=
  ∃ m ∈ monomials(I), ∃ n ∈ monomials(I), t = (m, n) ∧ a = call2(mul, p(m), q(n))
requires ring : IsCommRing(A, add, zero, neg, mul, one)
requires memberP : p ∈ polynomials(I, A, zero)
requires memberQ : q ∈ polynomials(I, A, zero)
requires pair : t ∈ monomials(I) × monomials(I)
proof
  obtain ⟨bound, m, hm, n, hn, shape⟩ := product.membership.forward with pair
  have pIn := polynomials.coefficient at I, A, zero, p, m with *
  have qIn := polynomials.coefficient at I, A, zero, q, n with *
  have ordinary := IsCommRing.ring with ring
  have valueIn := IsRing.mul_closed at A, add, zero, neg, mul, one, p(m), q(n) with *
  refine ⟨call2(mul, p(m), q(n)), valueIn, m, hm, n, hn, shape, rfl⟩
uniqueness
  intros u hu first v hv second
  obtain ⟨m, hm, n, hn, shapeU, valueU⟩ := first
  obtain ⟨r, hr, s, hs, shapeV, valueV⟩ := second
  have equalPairs : (m, n) = (r, s) by cc
  have coordinates := orderedPair.injective with equalPairs
  cc

defgraph convolutionWeights (I A add zero neg mul one p q : Set) (t ∈ convolutionPairs(I, zero, p, q)) : A :=
  polynomialPairCoefficient(I, A, add, zero, neg, mul, one, p, q, t)
requires ring : IsCommRing(A, add, zero, neg, mul, one)
requires memberP : p ∈ polynomials(I, A, zero)
requires memberQ : q ∈ polynomials(I, A, zero)
proof
  have subset := convolutionPairs.subset at I, zero, p, q
  have pair := subset with t, member
  have selected := polynomialPairCoefficient.selected at I, A, add, zero, neg, mul, one, p, q, t with *
  exact selected.left

def polynomialProduct (I A add zero neg mul one p q : Set) : Set :=
  finitePushforward(convolutionPairs(I, zero, p, q), monomials(I), A, add, zero, neg, mul, one,
    monomialMul(I), convolutionWeights(I, A, add, zero, neg, mul, one, p, q))

section Rings
variable (I A add zero neg mul one p q : Set)
hypothesis ring : IsCommRing(A, add, zero, neg, mul, one)
hypothesis memberP : p ∈ polynomials(I, A, zero)
hypothesis memberQ : q ∈ polynomials(I, A, zero)
notation ring R := (A, add, zero, neg, mul, one)

theorem convolutionWeights.pair (m n : Set)
  requires supportM : m ∈ functionSupport(p, monomials(I), zero)
  requires supportN : n ∈ functionSupport(q, monomials(I), zero)
  shows convolutionWeights(I, A, add, zero, neg, mul, one, p, q)((m, n)) = p(m) * q(n)
proof
  have dataM := functionSupport.membership.forward with supportM
  have dataN := functionSupport.membership.forward with supportN
  have pair := product.pair at m, n, monomials(I), monomials(I) with *
  have supported : (m, n) ∈ convolutionPairs(I, zero, p, q)
    unfold convolutionPairs
    exact product.pair with supportM, supportN
  have selected := polynomialPairCoefficient.selected at I, A, add, zero, neg, mul, one, p, q, (m, n) with *
  obtain ⟨r, hr, s, hs, shape, output⟩ := selected.right
  have coordinates := orderedPair.injective with shape
  have value := convolutionWeights.value at I, A, add, zero, neg, mul, one, p, q, (m, n) with *
  cc

theorem polynomialProduct.member
  shows polynomialProduct(I, A, add, zero, neg, mul, one, p, q) ∈ polynomials(I, A, zero)
proof
  have finite := convolutionPairs.finite with memberP, memberQ
  have weights := convolutionWeights.function at I, A, add, zero, neg, mul, one, p, q with *
  have indexMap := monomialMul.function at I
  have domain := convolutionPairs.subset at I, zero, p, q
  have map := finitePushforward.map with *
  apply polynomials.contains
  unfold polynomialProduct
  exact map

theorem polynomialProduct.support
  shows functionSupport(polynomialProduct(I, A, add, zero, neg, mul, one, p, q), monomials(I), zero) ⊆
    functionImage(monomialMul(I), convolutionPairs(I, zero, p, q), monomials(I))
proof
  have finite := convolutionPairs.finite with memberP, memberQ
  have weights := convolutionWeights.function at I, A, add, zero, neg, mul, one, p, q with *
  unfold polynomialProduct
  exact finitePushforward.support with *

theorem polynomialProduct.support_factor (m : Set)
  requires supported : m ∈ functionSupport(polynomialProduct(I, A, add, zero, neg, mul, one, p, q), monomials(I), zero)
  shows ∃ u ∈ functionSupport(p, monomials(I), zero), ∃ v ∈ functionSupport(q, monomials(I), zero), m = monomialProduct(I, u, v)
proof
  have bound := polynomialProduct.support at I, A, add, zero, neg, mul, one, p, q with *
  have image := bound with m, supported
  obtain ⟨monomial, t, ht, equation⟩ := functionImage.membership.forward with image
  unfold convolutionPairs at ht
  obtain ⟨bounded, u, hu, v, hv, shape⟩ := product.membership.forward with ht
  have dataU := functionSupport.membership.forward with hu
  have dataV := functionSupport.membership.forward with hv
  have value := monomialMul.apply at I, u, v with *
  unfold call2 at value
  refine ⟨u, hu, v, hv, _⟩
  cc

end Rings

section Zero
variable (I A add zero neg mul one p : Set)
hypothesis ring : IsCommRing(A, add, zero, neg, mul, one)
hypothesis memberP : p ∈ polynomials(I, A, zero)

theorem polynomialProduct.zero_left
  shows polynomialProduct(I, A, add, zero, neg, mul, one, constantFunction(monomials(I), A, zero), p) = constantFunction(monomials(I), A, zero)
proof
  have zeroPolynomial := polynomials.zero at I, A, add, zero, neg, mul, one with *
  have product := polynomialProduct.member at I, A, add, zero, neg, mul, one, constantFunction(monomials(I), A, zero), p with *
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  apply polynomials.ext with product, zeroPolynomial
  intros m hm
  have zeroValue := constantFunction.apply at monomials(I), A, m, zero with *
  rw zeroValue
  have alternatives : polynomialProduct(I, A, add, zero, neg, mul, one, constantFunction(monomials(I), A, zero), p)(m) = zero ∨ polynomialProduct(I, A, add, zero, neg, mul, one, constantFunction(monomials(I), A, zero), p)(m) ≠ zero
    tauto
  cases alternatives with vanishes | nonzero
  . exact vanishes
  . have supported : m ∈ functionSupport(polynomialProduct(I, A, add, zero, neg, mul, one, constantFunction(monomials(I), A, zero), p), monomials(I), zero)
      exact functionSupport.membership.backward with ⟨hm, nonzero⟩
    obtain ⟨u, hu, v, hv, equation⟩ := polynomialProduct.support_factor at I, A, add, zero, neg, mul, one, constantFunction(monomials(I), A, zero), p, m with *
    have data := functionSupport.membership.forward with hu
    have value := constantFunction.apply at monomials(I), A, u, zero with *
    exfalso
    exact data.right with value

theorem polynomialProduct.zero_right
  shows polynomialProduct(I, A, add, zero, neg, mul, one, p, constantFunction(monomials(I), A, zero)) = constantFunction(monomials(I), A, zero)
proof
  have zeroPolynomial := polynomials.zero at I, A, add, zero, neg, mul, one with *
  have product := polynomialProduct.member at I, A, add, zero, neg, mul, one, p, constantFunction(monomials(I), A, zero) with *
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  apply polynomials.ext with product, zeroPolynomial
  intros m hm
  have zeroValue := constantFunction.apply at monomials(I), A, m, zero with *
  rw zeroValue
  have alternatives : polynomialProduct(I, A, add, zero, neg, mul, one, p, constantFunction(monomials(I), A, zero))(m) = zero ∨ polynomialProduct(I, A, add, zero, neg, mul, one, p, constantFunction(monomials(I), A, zero))(m) ≠ zero
    tauto
  cases alternatives with vanishes | nonzero
  . exact vanishes
  . have supported : m ∈ functionSupport(polynomialProduct(I, A, add, zero, neg, mul, one, p, constantFunction(monomials(I), A, zero)), monomials(I), zero)
      exact functionSupport.membership.backward with ⟨hm, nonzero⟩
    obtain ⟨u, hu, v, hv, equation⟩ := polynomialProduct.support_factor at I, A, add, zero, neg, mul, one, p, constantFunction(monomials(I), A, zero), m with *
    have data := functionSupport.membership.forward with hv
    have value := constantFunction.apply at monomials(I), A, v, zero with *
    exfalso
    exact data.right with value

end Zero
