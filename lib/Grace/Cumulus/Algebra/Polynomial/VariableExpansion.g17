module Grace.Cumulus.Algebra.Polynomial.VariableExpansion
import VariableCoefficients

defgraph monomialExponent (I j : Set) (m ∈ monomials(I)) : ℕ := m(j)
requires index : j ∈ I
proof
  have natural := monomials.exponent at I, m, j with *
  exact nat.omega.forward at m(j) with *

defgraph polynomialCoefficientFamily (I A z p j : Set) (n ∈ ℕ) : polynomials(I, A, z) := polynomialVariableCoefficient(I, A, z, p, j, n)
requires zeroIn : z ∈ A
requires polynomial : p ∈ polynomials(I, A, z)
proof
  have natural := nat.omega.backward at n with *
  exact polynomialVariableCoefficient.member with *

notation scoped polynomialCoefficientFamily(I, R, p, j) => polynomialCoefficientFamily(I, R.carrier, R.zero, p, j)

section Expansion
variable (I A z p j : Set)
hypothesis zeroIn : z ∈ A
hypothesis polynomial : p ∈ polynomials(I, A, z)
hypothesis index : j ∈ I

theorem polynomialVariableCoefficient.outside (n : Nat)
  requires absent : ¬(n ∈ functionImage(monomialExponent(I, j), functionSupport(p, monomials(I), z), ℕ))
  shows polynomialVariableCoefficient(I, A, z, p, j, n) = constantFunction(monomials(I), A, z)
proof
  have function := polynomialVariableCoefficient.function at I, A, z, p, j, n with *
  have zeroFunction := constantFunction.function at monomials(I), A, z with *
  apply FunctionBetween.ext with function, zeroFunction
  intros m hm
  have zeroValue := constantFunction.apply at monomials(I), A, m, z with *
  rw zeroValue
  have alternatives : m(j) = 0 ∨ m(j) ≠ 0 by tauto
  cases alternatives with missing | present
  . have value := polynomialVariableCoefficient.at_zero with *
    rw value
    by_contra nonzero
    have naturalZero := nat.omega.forward with Naturals.constructor.zero
    have nIn := nat.omega.forward at n with *
    have single := monomialSingle.member at I, j, n with *
    have product := monomialProduct.member at I, coefficientSingle(I, ℕ, 0, n, j), m with *
    have exponent := monomialProduct.value at I, coefficientSingle(I, ℕ, 0, n, j), m, j with *
    have singleValue := coefficientSingle.same at I, ℕ, 0, n, j with *
    have identity := add.right_unit with *
    have equal : monomialProduct(I, coefficientSingle(I, ℕ, 0, n, j), m)(j) = n by cc
    have imageValue := monomialExponent.value at I, j, monomialProduct(I, coefficientSingle(I, ℕ, 0, n, j), m) with *
    have supported : monomialProduct(I, coefficientSingle(I, ℕ, 0, n, j), m) ∈ functionSupport(p, monomials(I), z)
      exact functionSupport.membership.backward with ⟨product, nonzero⟩
    apply absent
    apply functionImage.membership.backward
    refine ⟨nIn, monomialProduct(I, coefficientSingle(I, ℕ, 0, n, j), m), supported, ?_⟩
    cc
  . exact polynomialVariableCoefficient.at_nonzero with *

theorem polynomialCoefficientFamily.support
  shows functionSupport(polynomialCoefficientFamily(I, A, z, p, j), ℕ, constantFunction(monomials(I), A, z)) ⊆ functionImage(monomialExponent(I, j), functionSupport(p, monomials(I), z), ℕ)
proof
  intros n hn
  have data := functionSupport.membership.forward with hn
  have natural := nat.omega.backward with data.left
  have value := polynomialCoefficientFamily.value at I, A, z, p, j, n with *
  by_contra absent
  have vanishes := polynomialVariableCoefficient.outside with *
  apply data.right
  cc

theorem polynomialCoefficientFamily.finite_support
  shows Finite(functionSupport(polynomialCoefficientFamily(I, A, z, p, j), ℕ, constantFunction(monomials(I), A, z)))
proof
  have finite := polynomials.finite_support with polynomial
  have domain := functionSupport.subset at p, monomials(I), z
  have exponents := monomialExponent.function at I, j with *
  have imageFinite := Finite.function_image with exponents, finite, domain
  have bound := polynomialCoefficientFamily.support with *
  exact Finite.subset with imageFinite, bound

theorem polynomialCoefficientFamily.map
  shows CoefficientMap(polynomialCoefficientFamily(I, A, z, p, j), ℕ, polynomials(I, A, z), constantFunction(monomials(I), A, z))
proof
  have function := polynomialCoefficientFamily.function at I, A, z, p, j with *
  have finite := polynomialCoefficientFamily.finite_support with *
  unfold CoefficientMap
  refine ⟨function, finite⟩

end Expansion
theorem polynomialVariableCoefficient.agree_away (I A add z neg mul one p j v w : Set, n : Nat)
  requires ring : IsCommRing(A, add, z, neg, mul, one)
  requires polynomial : p ∈ polynomials(I, A, z)
  requires first : v : I → A
  requires second : w : I → A
  requires agreement : ∀ i ∈ I, i ≠ j → v(i) = w(i)
  shows polynomialAt(I, A, add, z, neg, mul, one, v)(polynomialVariableCoefficient(I, A, z, p, j, n)) = polynomialAt(I, A, add, z, neg, mul, one, w)(polynomialVariableCoefficient(I, A, z, p, j, n))
proof
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have coefficient := polynomialVariableCoefficient.member at I, A, z, p, j, n with *
  have bound := polynomialVariableCoefficient.variables at I, A, z, p, j, n with *
  have domain := polynomialVariablesUsed.subset at I, A, z, p
  have same : ∀ i ∈ polynomialVariablesUsed(I, A, z, polynomialVariableCoefficient(I, A, z, p, j, n)), v(i) = w(i)
    intros i hi
    have data := bound with i, hi
    have difference := difference.membership.forward with data
    have inI := domain with i, difference.left
    have different : i ≠ j
      intro equal
      have singleton := singleton.membership.backward with equal
      exact difference.right with singleton
    exact agreement with i, inI, different
  exact polynomialAt.agree_on_variables with *
