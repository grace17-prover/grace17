module Grace.Cumulus.Algebra.Polynomial.CoefficientHorner
import VariableExpansion
import HornerHom

theorem polynomialCoefficientFamily.list_representation (I A z p j : Set)
  requires zeroIn : z ∈ A
  requires polynomial : p ∈ polynomials(I, A, z)
  requires index : j ∈ I
  shows ∃ cs, List(polynomials(I, A, z), cs) ∧ (∀ n, Nat(n) → listCoefficient{polynomials(I, A, z)}(constantFunction(monomials(I), A, z), cs, n) = polynomialVariableCoefficient(I, A, z, p, j, n))
proof
  have map := polynomialCoefficientFamily.map with *
  obtain ⟨cs, list, values⟩ := CoefficientMap.list_representation with map
  refine ⟨cs, list, ?_⟩
  intros n nNat
  have value := values with n, nNat
  have family := polynomialCoefficientFamily.value at I, A, z, p, j, n with *
  cc

theorem polynomialVariableCoefficient.list_recover (I A z p j : Set)
  requires zeroIn : z ∈ A
  requires polynomial : p ∈ polynomials(I, A, z)
  requires index : j ∈ I
  shows ∃ cs, List(polynomials(I, A, z), cs) ∧ (∀ m ∈ monomials(I), listCoefficient{polynomials(I, A, z)}(constantFunction(monomials(I), A, z), cs, m(j))(coefficientErase(I, ℕ, 0, m, j)) = p(m))
proof
  obtain ⟨cs, list, values⟩ := polynomialCoefficientFamily.list_representation at I, A, z, p, j with *
  refine ⟨cs, list, ?_⟩
  intros m hm
  have natural := monomials.exponent with *
  have value := values with m(j), natural
  have recovery := polynomialVariableCoefficient.recover with *
  cc

-- All coefficients, including the top one, occur in cs; the terminal value is zero.
def polynomialFromCoefficients (I A add z neg mul one j : Set) (cs : List(polynomials(I, A, z))) : Set :=
  hornerAt{polynomials(I, A, z)}(polynomialAdd(I, A, add, z, neg, mul, one), polynomialMul(I, A, add, z, neg, mul, one), constantFunction(monomials(I), A, z), polynomialVariable(I, A, z, one, j), cs)

notation scoped polynomialFromCoefficients(I, R, j, cs) => polynomialFromCoefficients(I, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, j, cs)

section Rings
variable (I A add z neg mul one j : Set)
notation ring R := (A, add, z, neg, mul, one)
notation ring P := R[I]
hypothesis ring : IsCommRing(R)

theorem polynomialFromCoefficients.member (cs : List(polynomials(I, A, z)))
  shows polynomialFromCoefficients(I, A, add, z, neg, mul, one, j, cs) ∈ P
proof
  have target : IsCommRing(P)
    exact polynomials.comm_ring with *
  have zeroIn : R[0] ∈ R by typecheck
  have oneIn : R[1] ∈ R by typecheck
  have initial : P[0] ∈ P by typecheck
  have variable := polynomialVariable.member at I, A, z, one, j with *
  unfold polynomialFromCoefficients
  exact hornerAt.closed with *

theorem polynomialFromCoefficients.nil
  shows polynomialFromCoefficients(I, A, add, z, neg, mul, one, j, []) = P[0]
proof
  unfold polynomialFromCoefficients
  exact hornerAt.nil with *

theorem polynomialFromCoefficients.cons (c : Set) (cs : List(polynomials(I, A, z)))
  requires coefficient : c ∈ P
  shows polynomialFromCoefficients(I, A, add, z, neg, mul, one, j, c :: cs) = P[c + polynomialVariable(I, R, j) * polynomialFromCoefficients(I, A, add, z, neg, mul, one, j, cs)]
proof
  unfold polynomialFromCoefficients
  exact hornerAt.cons with *

theorem polynomialAt.coefficient_horner (v : Set) (cs : List(polynomials(I, A, z)))
  requires assignment : v : I → R
  requires index : j ∈ I
  shows polynomialAt(I, R, v)(polynomialFromCoefficients(I, A, add, z, neg, mul, one, j, cs)) = hornerAt{A}(add, mul, z, v(j), listMap{polynomials(I, A, z)}(polynomialAt(I, R, v), cs))
proof
  have source : IsCommRing(P)
    exact polynomials.comm_ring with *
  have hom : IsRingHom(polynomialAt(I, R, v), P, R)
    exact polynomialAt.hom with *
  have zeroIn : R[0] ∈ R by typecheck
  have oneIn : R[1] ∈ R by typecheck
  have initial : P[0] ∈ P by typecheck
  have variable := polynomialVariable.member at I, A, z, one, j with *
  have mapped := hornerAt.map at polynomials(I, A, z), polynomialAdd(I, A, add, z, neg, mul, one), constantFunction(monomials(I), A, z), polynomialNeg(I, A, add, z, neg, mul, one), polynomialMul(I, A, add, z, neg, mul, one), polynomialConstant(I, A, z, one), A, add, z, neg, mul, one, polynomialAt(I, R, v), constantFunction(monomials(I), A, z), polynomialVariable(I, R, j), cs with *
  have zeroValue := IsRingHom.zero with hom
  have variableValue := polynomialAt.variable with *
  unfold polynomialFromCoefficients
  rw [zeroValue, variableValue] at mapped
  cc

end Rings
