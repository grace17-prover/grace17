module Grace.Cumulus.Algebra.Polynomial.CoefficientMap
import Constants
import Terms

theorem polynomials.compose (I A z B o f p : Set)
  requires function : f : A → B
  requires zero : f(z) = o
  requires polynomial : p ∈ polynomials(I, A, z)
  shows compose(f, p, monomials(I), A, B) ∈ polynomials(I, B, o)
proof
  have values := polynomials.function with polynomial
  have mapped := compose.function with values, function
  have finite := polynomials.finite_support with polynomial
  have subset : functionSupport(compose(f, p, monomials(I), A, B), monomials(I), o) ⊆ functionSupport(p, monomials(I), z)
    intros m member
    obtain ⟨monomial, nonzero⟩ := functionSupport.membership.forward with member
    have value := compose.apply at f, p, monomials(I), A, B, m with *
    apply functionSupport.membership.backward
    refine ⟨monomial, ?_⟩
    intro vanishes
    apply nonzero
    cc
  have support := Finite.subset with finite, subset
  have map : CoefficientMap(compose(f, p, monomials(I), A, B), monomials(I), B, o)
    unfold CoefficientMap
    refine ⟨mapped, support⟩
  exact polynomials.contains with *

defgraph polynomialMap (I A z B o f : Set) (p ∈ polynomials(I, A, z)) : polynomials(I, B, o) := compose(f, p, monomials(I), A, B)
requires function : f : A → B
requires zero : f(z) = o
proof
  exact polynomials.compose with *

notation scoped polynomialMap(I, R, S, f) => polynomialMap(I, R.carrier, R.zero, S.carrier, S.zero, f)

theorem polynomialMap.coefficient (I A z B o f p m : Set)
  requires function : f : A → B
  requires zero : f(z) = o
  requires polynomial : p ∈ polynomials(I, A, z)
  requires monomial : m ∈ monomials(I)
  shows polynomialMap(I, A, z, B, o, f)(p)(m) = f(p(m))
proof
  have values := polynomials.function with polynomial
  have mapped := polynomialMap.value at I, A, z, B, o, f, p with *
  have value := compose.apply at f, p, monomials(I), A, B, m with *
  cc

theorem polynomialMap.member (I A z B o f p : Set)
  requires function : f : A → B
  requires zero : f(z) = o
  requires polynomial : p ∈ polynomials(I, A, z)
  shows polynomialMap(I, A, z, B, o, f)(p) ∈ polynomials(I, B, o)
proof
  have map := polynomialMap.function at I, A, z, B, o, f with *
  exact FunctionBetween.apply_closed with *

section Rings
variable (I A add z neg mul one B plus o minus times unit f : Set)
notation ring R := (A, add, z, neg, mul, one)
notation ring S := (B, plus, o, minus, times, unit)
notation ring P := R[I]
notation ring Q := S[I]
hypothesis source : IsCommRing(R)
hypothesis target : IsCommRing(S)
hypothesis hom : IsRingHom(f, R, S)

theorem polynomialMap.add (p q : Set)
  requires left : p ∈ P
  requires right : q ∈ P
  shows polynomialMap(I, A, z, B, o, f)(P[p + q]) = Q[polynomialMap(I, A, z, B, o, f)(p) + polynomialMap(I, A, z, B, o, f)(q)]
proof
  have function := IsRingHom.function with hom
  have zero := IsRingHom.zero with hom
  have sourceRing := polynomials.comm_ring at I, A, add, z, neg, mul, one with *
  have targetRing := polynomials.comm_ring at I, B, plus, o, minus, times, unit with *
  have sourceOrdinary := IsCommRing.ring with sourceRing
  have targetOrdinary := IsCommRing.ring with targetRing
  have sum := IsRing.add_closed with sourceOrdinary, left, right
  have mappedSum := polynomialMap.member at I, A, z, B, o, f, P[p + q] with *
  have mappedLeft := polynomialMap.member at I, A, z, B, o, f, p with *
  have mappedRight := polynomialMap.member at I, A, z, B, o, f, q with *
  have targetSum := IsRing.add_closed with targetOrdinary, mappedLeft,
    mappedRight
  have sourceValue := polynomialAdd.apply at I, A, add, z, neg, mul, one, p, q with *
  have targetValue := polynomialAdd.apply at I, B, plus, o, minus, times, unit, polynomialMap(I, A, z, B, o, f)(p), polynomialMap(I, A, z, B, o, f)(q) with *
  have pFunction := polynomials.function with left
  have qFunction := polynomials.function with right
  have fpFunction := polynomials.function with mappedLeft
  have fqFunction := polynomials.function with mappedRight
  apply polynomials.ext with mappedSum, targetSum
  intros m monomial
  have pIn := polynomials.coefficient at I, A, z, p, m with *
  have qIn := polynomials.coefficient at I, A, z, q, m with *
  have sumCoefficient := polynomialMap.coefficient at I, A, z, B, o, f, P[p + q], m with *
  have pCoefficient := polynomialMap.coefficient at I, A, z, B, o, f, p, m with *
  have qCoefficient := polynomialMap.coefficient at I, A, z, B, o, f, q, m with *
  have sourceCoefficient := coefficientAdd.value at monomials(I), A, add, z, neg, mul, one, p, q, m with *
  have targetCoefficient := coefficientAdd.value at monomials(I), B, plus, o, minus, times, unit, polynomialMap(I, A, z, B, o, f)(p), polynomialMap(I, A, z, B, o, f)(q), m with *
  have preserved := IsRingHom.add with hom, pIn, qIn
  cc

theorem polynomialMap.coefficient_add (p q : Set)
  requires left : p ∈ P
  requires right : q ∈ P
  shows polynomialMap(I, R, S, f)(coefficientAdd(monomials(I), A, add, z, neg, mul, one, p, q)) = coefficientAdd(monomials(I), B, plus, o, minus, times, unit, polynomialMap(I, R, S, f)(p), polynomialMap(I, R, S, f)(q))
proof
  have function := IsRingHom.function with hom
  have zero := IsRingHom.zero with hom
  have mappedLeft := polynomialMap.member at I, A, z, B, o, f, p with *
  have mappedRight := polynomialMap.member at I, A, z, B, o, f, q with *
  have first := polynomialAdd.apply at I, A, add, z, neg, mul, one, p, q with *
  have second := polynomialAdd.apply at I, B, plus, o, minus, times, unit, polynomialMap(I, R, S, f)(p), polynomialMap(I, R, S, f)(q) with *
  have value := polynomialMap.add at I, A, add, z, neg, mul, one, B, plus, o, minus, times, unit, f, p, q with *
  cc

theorem polynomialMap.zero
  shows polynomialMap(I, A, z, B, o, f)(P[0]) = Q[0]
proof
  have function := IsRingHom.function with hom
  have zero := IsRingHom.zero with hom
  have sourceMember := polynomials.zero at I, A, add, z, neg, mul, one with *
  have targetMember := polynomials.zero at I, B, plus, o, minus, times, unit with *
  have mapped := polynomialMap.member with *
  have zeroIn : R[0] ∈ R by typecheck
  have targetZero : S[0] ∈ S by typecheck
  apply polynomials.ext with mapped, targetMember
  intros m monomial
  have coefficient := polynomialMap.coefficient with *
  have left := constantFunction.apply at monomials(I), A, m, z with *
  have right := constantFunction.apply at monomials(I), B, m, o with *
  cc

theorem polynomialMap.term (a m : Set)
  requires coefficient : a ∈ R
  requires monomial : m ∈ monomials(I)
  shows polynomialMap(I, A, z, B, o, f)(polynomialTerm(I, A, z, a, m)) = polynomialTerm(I, B, o, f(a), m)
proof
  have function := IsRingHom.function with hom
  have zero := IsRingHom.zero with hom
  have zeroIn : R[0] ∈ R by typecheck
  have targetZero : S[0] ∈ S by typecheck
  have image := IsRingHom.closed with hom, coefficient
  have term := polynomialTerm.member at I, A, z, a, m with *
  have targetTerm := polynomialTerm.member at I, B, o, f(a), m with *
  have mapped := polynomialMap.member at I, A, z, B, o, f, polynomialTerm(I, A, z, a, m) with *
  apply polynomials.ext with mapped, targetTerm
  intros n hn
  have value := polynomialMap.coefficient at I, A, z, B, o, f, polynomialTerm(I, A, z, a, m), n with *
  have alternatives : n = m ∨ n ≠ m by tauto
  cases alternatives with same | different
  . rw same
    have left := polynomialTerm.same at I, A, z, a, m with *
    have right := polynomialTerm.same at I, B, o, f(a), m with *
    rw same at value
    cc
  . have left := polynomialTerm.other at I, A, z, a, m, n with *
    have right := polynomialTerm.other at I, B, o, f(a), m, n with *
    cc

theorem polynomialMap.constant (a : Set)
  requires coefficient : a ∈ R
  shows polynomialMap(I, A, z, B, o, f)(polynomialConstant(I, A, z, a)) = polynomialConstant(I, B, o, f(a))
proof
  have monomial := monomialOne.member at I
  have value := polynomialMap.term with *
  unfold polynomialConstant
  cc

theorem polynomialMap.variable (j : Set)
  shows polynomialMap(I, A, z, B, o, f)(polynomialVariable(I, A, z, one, j)) = polynomialVariable(I, B, o, unit, j)
proof
  have coefficient : R[1] ∈ R by typecheck
  have monomial := monomialVariable.member at I, j
  have value := polynomialMap.term with *
  have oneValue := IsRingHom.one with hom
  unfold polynomialVariable
  cc

end Rings
