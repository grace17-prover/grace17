module Grace.Cumulus.Algebra.Polynomial.TranscendenceLocalization
import AlgebraicDependence
import Field.FiniteAlgebraicLocalization
import IntegralFinite

section Families
variable (I M A add z neg mul one B plus o minus times unit f v : Set)
notation ring R := (A, add, z, neg, mul, one)
notation ring S := (B, plus, o, minus, times, unit)
notation ring Q := R[M]
hypothesis source : IsCommRing(R)
hypothesis field : IsField(S)
hypothesis hom : IsRingHom(f, R, S)
hypothesis assignment : v : I → S
hypothesis subset : M ⊆ I
hypothesis independent : AlgebraicallyIndependent(M, R, S, f, restrict(v, M))
hypothesis maximal : ∀ T, T ⊆ I → M ⊆ T → AlgebraicallyIndependent(T, R, S, f, restrict(v, T)) → T = M

theorem AlgebraicallyIndependent.maximal_generators_algebraic
  shows ∀ x ∈ functionImage(v, I, S), AlgebraicOver(polynomialAtOver(M, R, S, f, restrict(v, M)), Q, S, x)
proof
  have target := IsField.comm_ring with field
  have sourceQ : IsCommRing(Q)
    exact polynomials.comm_ring with *
  have data := independent
  have restricted := data.right.left
  have injective := data.right.right
  have evaluation : IsRingHom(polynomialAtOver(M, R, S, f, restrict(v, M)), Q,
    S)
    exact polynomialAtOver.hom with *
  have domain : IsIntegralDomain(Q)
    exact IsRingHom.domain_of_field_embedding with *
  have nontrivial := IsIntegralDomain.nontrivial with domain
  have zeroIn : R[0] ∈ R by typecheck
  have oneIn : R[1] ∈ R by typecheck
  have closed : ∀ i ∈ M, v(i) ∈ S
    intros i member
    have included := subset
    have inI := included with i, member
    exact FunctionBetween.apply_closed with assignment, inI
  intros x inImage
  obtain ⟨element, j, index, value⟩ := functionImage.membership.forward with inImage
  have alternatives : j ∈ M ∨ ¬(j ∈ M) by tauto
  cases alternatives with included | outside
  . have coefficient := polynomialVariable.member at M, A, z, one, j with *
    have integral := IntegralOver.coefficient with coefficient
    have evaluated := polynomialAtOver.variable at M, A, add, z, neg, mul, one, B, plus, o, minus, times, unit, f, restrict(v, M), j with *
    have original := restrict.apply with *
    have equal : polynomialAtOver(M, R, S, f, restrict(v, M))(polynomialVariable(M, R, j)) = x by cc
    rw equal at integral
    exact IntegralOver.algebraic_of_nontrivial with *
  . have algebraic := AlgebraicallyIndependent.maximal_algebraic with *
    rwa value

theorem AlgebraicallyIndependent.maximal_common_localization
  requires finite : Finite(I)
  shows ∃ s ∈ Q, s ≠ Q[0] ∧ (∀ x ∈ functionImage(v, I, S),
    IntegralOver(identity(localizationWithin(S, functionImage(polynomialAtOver(M, R, S, f, restrict(v, M)), Q, S), denominatorPowers(S, polynomialAtOver(M, R, S, f, restrict(v, M))(s)))), localizationWithin(S, functionImage(polynomialAtOver(M, R, S, f, restrict(v, M)), Q, S), denominatorPowers(S, polynomialAtOver(M, R, S, f, restrict(v, M))(s))), S, x))
proof
  have target := IsField.comm_ring with field
  have sourceQ : IsCommRing(Q)
    exact polynomials.comm_ring with *
  have data := independent
  have restricted := data.right.left
  have injective := data.right.right
  have evaluation : IsRingHom(polynomialAtOver(M, R, S, f, restrict(v, M)), Q,
    S)
    exact polynomialAtOver.hom with *
  have reflexive := Subset.reflexive at I
  have finiteImage := Finite.function_image with assignment, finite, reflexive
  have algebraic := AlgebraicallyIndependent.maximal_generators_algebraic with *
  exact AlgebraicOver.finite_principal_integral with *

theorem AlgebraicallyIndependent.maximal_finite_module
  requires finite : Finite(I)
  requires generates : algebraAdjoin(f, R, S, functionImage(v, I, S)) = S
  shows ∃ s ∈ Q, s ≠ Q[0] ∧ (∃ T,
    T = localizationWithin(S, functionImage(polynomialAtOver(M, R, S, f, restrict(v, M)), Q, S), denominatorPowers(S, polynomialAtOver(M, R, S, f, restrict(v, M))(s))) ∧
    FiniteAlgebraModule(identity(T), T, S))
proof
  have target := IsField.comm_ring with field
  have sourceQ : IsCommRing(Q)
    exact polynomials.comm_ring with *
  have data := independent
  have restricted := data.right.left
  have injective := data.right.right
  have evaluation : IsRingHom(polynomialAtOver(M, R, S, f, restrict(v, M)), Q,
    S)
    exact polynomialAtOver.hom with *
  obtain ⟨s, polynomial, nonzero, integral⟩ := AlgebraicallyIndependent.maximal_common_localization at I, M, A, add, z, neg, mul, one, B, plus, o, minus, times, unit, f, v with *
  have localized := IsRingHom.principal_localization_subring with *
  have powers := IsRingHom.denominator_powers with *
  rw powers at localized
  have imageRing : IsSubring(S, functionImage(polynomialAtOver(M, R, S, f, restrict(v, M)), Q, S))
    exact IsRingHom.image_subring with *
  have function := IsRingHom.function with evaluation
  have image := functionImage.value with *
  have zeroQ : Q[0] ∈ Q by typecheck
  have zero := IsRingHom.zero with evaluation
  have imageNonzero : polynomialAtOver(M, R, S, f, restrict(v, M))(s) ≠ S[0]
    intro vanishes
    have equal : polynomialAtOver(M, R, S, f, restrict(v, M))(s) = polynomialAtOver(M, R, S, f, restrict(v, M))(Q[0])
      cc
    have original := Injective.apply_cancel with injective, polynomial, equal
    exact nonzero with original
  have denominators := denominatorPowers.denominators with *
  have contains := localizationWithin.contains with target, imageRing, denominators
  have coefficientImage := polynomialAtOver.coefficient_image at M, A, add, z, neg, mul, one, B, plus, o, minus, times, unit, f, restrict(v, M) with *
  have coefficients := Subset.transitive with coefficientImage, contains
  have reflexive := Subset.reflexive at I
  have finiteImage := Finite.function_image with assignment, finite, reflexive
  have bounded := functionImage.subset at v, I, S
  have finiteModule := integralGenerators.finite_module_enlarged with *
  refine ⟨s, polynomial, nonzero, localizationWithin(S, functionImage(polynomialAtOver(M, R, S, f, restrict(v, M)), Q, S), denominatorPowers(S, polynomialAtOver(M, R, S, f, restrict(v, M))(s))), rfl, finiteModule⟩

end Families
