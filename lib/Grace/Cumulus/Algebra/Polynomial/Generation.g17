module Grace.Cumulus.Algebra.Polynomial.Generation
import Constants
import MonomialGeneration
import Adjoin

defgraph polynomialVariables (I A zero one : Set) (j ∈ I) : polynomials(I, A, zero) := polynomialVariable(I, A, zero, one, j)
requires zeroIn : zero ∈ A
requires oneIn : one ∈ A
proof
  exact polynomialVariable.member at I, A, zero, one, j with *

notation scoped polynomialVariables(I, R) => polynomialVariables(I, R.carrier, R.zero, R.one)

def polynomialGenerators (I A zero one : Set) : Set :=
  functionImage(polynomialVariables(I, A, zero, one), I, polynomials(I, A, zero))

notation scoped polynomialGenerators(I, R) => polynomialGenerators(I, R.carrier, R.zero, R.one)

def subalgebraMonomials (I A zero one T : Set) : Set :=
  {m ∈ monomials(I) | polynomialTerm(I, A, zero, one, m) ∈ T}

theorem subalgebraMonomials.membership (I A zero one T m : Set)
  shows m ∈ subalgebraMonomials(I, A, zero, one, T) ↔ m ∈ monomials(I) ∧ polynomialTerm(I, A, zero, one, m) ∈ T
proof
  simp

section Polynomials
variable (I A add zero neg mul one : Set)
notation ring R := (A, add, zero, neg, mul, one)
notation ring P := R[I]
hypothesis ring : IsCommRing(R)

theorem polynomialGenerators.subset
  shows polynomialGenerators(I, R) ⊆ P
proof
  unfold polynomialGenerators
  exact functionImage.subset

theorem polynomialGenerators.variable (j : Set)
  requires index : j ∈ I
  shows polynomialVariable(I, R, j) ∈ polynomialGenerators(I, R)
proof
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have multiplicative := IsRing.multiplicative with ordinary
  have oneIn := IsMonoid.unit_in_carrier with multiplicative
  have function := polynomialVariables.function at I, A, zero, one with *
  have member := functionImage.value with *
  have value := polynomialVariables.value at I, A, zero, one, j with *
  rw value at member
  unfold polynomialGenerators
  exact member

section Subalgebras
variable (T : Set)
hypothesis subalgebra : Subalgebra(polynomialCoefficients(I, R), R, P, T)

theorem polynomialSubalgebra.constant (a : Set)
  requires coefficient : a ∈ R
  shows polynomialConstant(I, R, a) ∈ T
proof
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have function := polynomialCoefficients.function at I, A, zero with *
  have value := polynomialCoefficients.value at I, A, zero, a with *
  have image := functionImage.value at polynomialCoefficients(I, R), A, P, a with *
  have contains := subalgebra.right
  have member := contains with polynomialCoefficients(I, R)(a), image
  rwa value at member

hypothesis variables : ∀ j ∈ I, polynomialVariable(I, R, j) ∈ T

theorem polynomialSubalgebra.monomial (m : Set)
  requires monomial : m ∈ monomials(I)
  shows polynomialTerm(I, A, zero, one, m) ∈ T
proof
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have multiplicative := IsRing.multiplicative with ordinary
  have oneIn := IsMonoid.unit_in_carrier with multiplicative
  have structure := subalgebra
  have subring := structure.left
  have closed := IsSubring.mul_closed with subring
  have base : monomialOne(I) ∈ subalgebraMonomials(I, A, zero, one, T)
    have unit := monomialOne.member at I
    have constant := polynomialSubalgebra.constant at I, A, add, zero, neg, mul, one, T, one with *
    unfold polynomialConstant at constant
    exact subalgebraMonomials.membership.backward with ⟨unit, constant⟩
  have generators : ∀ j ∈ I, monomialVariable(I, j) ∈ subalgebraMonomials(I, A, zero, one, T)
    intros j hj
    have member := monomialVariable.member at I, j
    have variable := variables with j, hj
    unfold polynomialVariable at variable
    exact subalgebraMonomials.membership.backward with ⟨member, variable⟩
  have products : ∀ u ∈ subalgebraMonomials(I, A, zero, one, T), ∀ v ∈ subalgebraMonomials(I, A, zero, one, T), monomialProduct(I, u, v) ∈ subalgebraMonomials(I, A, zero, one, T)
    intros u hm v hn
    obtain ⟨memberM, termM⟩ := subalgebraMonomials.membership.forward with hm
    obtain ⟨memberN, termN⟩ := subalgebraMonomials.membership.forward with hn
    have product := monomialProduct.member at I, u, v with *
    have first := polynomialTerm.member at I, A, zero, one, u with *
    have second := polynomialTerm.member at I, A, zero, one, v with *
    have member := ClosedBinary.mem with closed, termM, termN
    have applied := polynomialMul.apply at I, A, add, zero, neg, mul, one, polynomialTerm(I, A, zero, one, u), polynomialTerm(I, A, zero, one, v) with *
    have multiplied := polynomialProduct.terms at I, A, add, zero, neg, mul, one, one, one, u, v with *
    have unit : R[1 * 1] = R[1] by ring
    rw [applied, multiplied, unit] at member
    exact subalgebraMonomials.membership.backward with ⟨product, member⟩
  have generated := monomials.induction with *
  have result := subalgebraMonomials.membership.forward with generated
  exact result.right

theorem polynomialSubalgebra.term (a m : Set)
  requires coefficient : a ∈ R
  requires monomial : m ∈ monomials(I)
  shows polynomialTerm(I, A, zero, a, m) ∈ T
proof
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have multiplicative := IsRing.multiplicative with ordinary
  have oneIn := IsMonoid.unit_in_carrier with multiplicative
  have constant := polynomialSubalgebra.constant at I, A, add, zero, neg, mul, one, T, a with *
  have term := polynomialSubalgebra.monomial with *
  have structure := subalgebra
  have closed := IsSubring.mul_closed with structure.left
  have member := ClosedBinary.mem with closed, term, constant
  have first := polynomialTerm.member at I, A, zero, one, m with *
  have second := polynomialTerm.member at I, A, zero, a, monomialOne(I) with *
  have unitMonomial := monomialOne.member at I
  unfold polynomialConstant at member
  have applied := polynomialMul.apply at I, A, add, zero, neg, mul, one, polynomialTerm(I, A, zero, one, m), polynomialTerm(I, A, zero, a, monomialOne(I)) with *
  have multiplied := polynomialProduct.terms at I, A, add, zero, neg, mul, one, one, a, m, monomialOne(I) with *
  have coefficientUnit : R[1 * a] = a by ring
  have monomialUnit := monomialProduct.one at I, m with *
  rwa [applied, multiplied, coefficientUnit, monomialUnit] at member

theorem polynomialSubalgebra.eq_carrier
  shows T = P
proof
  have structure := subalgebra
  have subring := structure.left
  have subset := IsSubring.subset_carrier with subring
  have base := IsSubring.zero_closed with subring
  have closed := IsSubring.add_closed with subring
  have terms : ∀ a ∈ A, ∀ m ∈ monomials(I), polynomialTerm(I, A, zero, a, m) ∈ T
    intros a ha m hm
    exact polynomialSubalgebra.term with *
  have sums : ∀ p ∈ T, ∀ q ∈ T, coefficientAdd(monomials(I), A, add, zero, neg, mul, one, p, q) ∈ T
    intros p hp q hq
    have included := subset
    have first := included with p, hp
    have second := included with q, hq
    have member := ClosedBinary.mem with closed, hp, hq
    have applied := polynomialAdd.apply at I, A, add, zero, neg, mul, one, p, q with *
    rwa applied at member
  apply Subset.antisymmetric with subset
  intros p hp
  exact polynomials.induction with *

end Subalgebras

theorem polynomialGenerators.adjoin
  shows algebraAdjoin(polynomialCoefficients(I, R), R, P, polynomialGenerators(I, R)) = P
proof
  have target := polynomials.comm_ring at I, A, add, zero, neg, mul, one with *
  have hom := polynomialCoefficients.hom at I, A, add, zero, neg, mul, one with *
  have bounded := polynomialGenerators.subset at I, A, add, zero, neg, mul, one with *
  have subalgebra := algebraAdjoin.subalgebra with ring, target, hom, bounded
  have included := algebraAdjoin.contains with ring, target, hom, bounded
  have variables : ∀ j ∈ I, polynomialVariable(I, R, j) ∈ algebraAdjoin(polynomialCoefficients(I, R), R, P, polynomialGenerators(I, R))
    intros j hj
    have generator := polynomialGenerators.variable at I, A, add, zero, neg, mul, one, j with *
    exact included with polynomialVariable(I, R, j), generator
  exact polynomialSubalgebra.eq_carrier with ring, subalgebra, variables

end Polynomials
