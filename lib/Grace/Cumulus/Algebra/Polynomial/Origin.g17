module Grace.Cumulus.Algebra.Polynomial.Origin
import Constants

theorem monomialProduct.one_factors (I m n : Set)
  requires memberM : m ∈ monomials(I)
  requires memberN : n ∈ monomials(I)
  requires productOne : monomialProduct(I, m, n) = monomialOne(I)
  shows m = monomialOne(I) ∧ n = monomialOne(I)
proof
  have unit := monomialOne.member at I
  have first : m = monomialOne(I)
    apply monomials.ext with memberM, unit
    intros i hi
    have mNat := monomials.exponent at I, m, i with *
    have nNat := monomials.exponent at I, n, i with *
    have value := monomialProduct.value at I, m, n, i with *
    have zeroValue := monomialOne.value with hi
    have sumZero : m(i) + n(i) = 0 by cc
    have zeroRule := add.eq_zero_left at n(i), m(i) with *
    have vanishes := zeroRule with sumZero
    cc
  have second : n = monomialOne(I)
    have comm := monomialProduct.commutative at I, m, n with *
    have rightUnit := monomialProduct.one at I, n with *
    cc
  refine ⟨first, second⟩

defgraph polynomialAtOrigin (I A zero : Set) (p ∈ polynomials(I, A, zero)) : A := p(monomialOne(I))
proof
  have unit := monomialOne.member at I
  exact polynomials.coefficient with *

theorem polynomialProduct.constant_coefficient (I A add zero neg mul one p q : Set)
  requires ring : IsCommRing(A, add, zero, neg, mul, one)
  requires memberP : p ∈ polynomials(I, A, zero)
  requires memberQ : q ∈ polynomials(I, A, zero)
  shows polynomialProduct(I, A, add, zero, neg, mul, one, p, q)(monomialOne(I)) = call2(mul, p(monomialOne(I)), q(monomialOne(I)))
proof
  have unit := monomialOne.member at I
  have pair := product.pair at monomialOne(I), monomialOne(I), monomials(I), monomials(I) with *
  have singletonSubset : {(monomialOne(I), monomialOne(I))} ⊆ monomials(I) × monomials(I) by simp
  have supportDomain := convolutionPairs.subset at I, zero, p, q
  have domain : convolutionPairs(I, zero, p, q) ∪ {(monomialOne(I), monomialOne(I))} ⊆ monomials(I) × monomials(I)
    simp
  have finitePairs := convolutionPairs.finite with memberP, memberQ
  have finiteSingleton := Finite.singleton at (monomialOne(I), monomialOne(I))
  have finite := Finite.union with finitePairs, finiteSingleton
  have covers : convolutionPairs(I, zero, p, q) ⊆ convolutionPairs(I, zero, p, q) ∪ {(monomialOne(I), monomialOne(I))}
    simp
  have singleton := singleton.self at (monomialOne(I), monomialOne(I))
  have source : (monomialOne(I), monomialOne(I)) ∈ convolutionPairs(I, zero, p, q) ∪ {(monomialOne(I), monomialOne(I))}
    simp
  have weights := boundedConvolutionWeights.function at I, convolutionPairs(I, zero, p, q) ∪ {(monomialOne(I), monomialOne(I))}, A, add, zero, neg, mul, one, p, q with *
  have imageValue := monomialMul.apply at I, monomialOne(I), monomialOne(I) with *
  unfold call2 at imageValue
  have unitLaw := monomialProduct.one at I, monomialOne(I) with *
  have image : monomialMul(I)((monomialOne(I), monomialOne(I))) = monomialOne(I) by cc
  have unique : ∀ t ∈ convolutionPairs(I, zero, p, q) ∪ {(monomialOne(I), monomialOne(I))}, monomialMul(I)(t) = monomialOne(I) → t = (monomialOne(I), monomialOne(I))
    intros t ht equality
    have included := domain
    have pairMember := included with t, ht
    obtain ⟨bound, m, hm, n, hn, shape⟩ := product.membership.forward with pairMember
    have value := monomialMul.apply at I, m, n with *
    unfold call2 at value
    have productOne : monomialProduct(I, m, n) = monomialOne(I) by cc
    have factors := monomialProduct.one_factors at I, m, n with *
    cc
  have isolated := finitePushforward.unique_fiber at convolutionPairs(I, zero, p, q) ∪ {(monomialOne(I), monomialOne(I))}, monomials(I), A, add, zero, neg, mul, one, monomialMul(I), boundedConvolutionWeights(I, convolutionPairs(I, zero, p, q) ∪ {(monomialOne(I), monomialOne(I))}, A, add, zero, neg, mul, one, p, q), (monomialOne(I), monomialOne(I)), monomialOne(I) with *
  have bounded := polynomialProduct.on_domain with ring, memberP, memberQ, domain, finite, covers
  have coefficient := boundedConvolutionWeights.pair at I, convolutionPairs(I, zero, p, q) ∪ {(monomialOne(I), monomialOne(I))}, A, add, zero, neg, mul, one, p, q, monomialOne(I), monomialOne(I) with *
  cc

theorem polynomialAtOrigin.constant (I A zero a : Set)
  requires zeroIn : zero ∈ A
  requires coefficient : a ∈ A
  shows polynomialAtOrigin(I, A, zero)(polynomialConstant(I, A, zero, a)) = a
proof
  have member := polynomialConstant.member at I, A, zero, a with *
  have value := polynomialAtOrigin.value at I, A, zero, polynomialConstant(I, A, zero, a) with *
  have coefficientValue := polynomialConstant.coefficient at I, A, zero, a with *
  cc

theorem polynomialAtOrigin.coefficients (I A zero a : Set)
  requires zeroIn : zero ∈ A
  requires coefficient : a ∈ A
  shows polynomialAtOrigin(I, A, zero)(polynomialCoefficients(I, A, zero)(a)) = a
proof
  have value := polynomialCoefficients.value at I, A, zero, a with *
  rw value
  exact polynomialAtOrigin.constant with *

theorem polynomialAtOrigin.variable (I A zero one j : Set)
  requires zeroIn : zero ∈ A
  requires oneIn : one ∈ A
  requires index : j ∈ I
  shows polynomialAtOrigin(I, A, zero)(polynomialVariable(I, A, zero, one, j)) = zero
proof
  have member := polynomialVariable.member at I, A, zero, one, j with *
  have unit := monomialOne.member at I
  have different : monomialOne(I) ≠ monomialVariable(I, j)
    intro equal
    have unitValue := monomialOne.value at I, j with *
    have variableValue := monomialVariable.same at I, j with *
    have impossible : (0:Nat) = (1:Nat) by cc
    exact Naturals.disjoint.zero.succ at 0 with impossible
  have coefficient : polynomialVariable(I, A, zero, one, j)(monomialOne(I)) = zero
    unfold polynomialVariable
    exact polynomialTerm.other with *
  have value := polynomialAtOrigin.value at I, A, zero, polynomialVariable(I, A, zero, one, j) with *
  cc

section Rings
variable (I A add zero neg mul one : Set)
hypothesis ring : IsCommRing(A, add, zero, neg, mul, one)
notation ring R := (A, add, zero, neg, mul, one)

theorem polynomialAtOrigin.hom
  shows IsRingHom(polynomialAtOrigin(I, A, zero), polynomials(I, A, zero), polynomialAdd(I, A, add, zero, neg, mul, one), constantFunction(monomials(I), A, zero), polynomialNeg(I, A, add, zero, neg, mul, one), polynomialMul(I, A, add, zero, neg, mul, one), polynomialConstant(I, A, zero, one), A, add, zero, neg, mul, one)
proof
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have multiplicative := IsRing.multiplicative with ordinary
  have oneIn := IsMonoid.unit_in_carrier with multiplicative
  have unit := monomialOne.member at I
  have function := polynomialAtOrigin.function at I, A, zero
  have zeroPolynomial := polynomials.zero at I, A, add, zero, neg, mul, one with *
  have zeroValue := polynomialAtOrigin.value at I, A, zero, constantFunction(monomials(I), A, zero) with *
  have zeroCoefficient := constantFunction.apply at monomials(I), A, monomialOne(I), zero with *
  have preservesZero : polynomialAtOrigin(I, A, zero)(constantFunction(monomials(I), A, zero)) = zero by cc
  have preservesOne := polynomialAtOrigin.constant at I, A, zero, one with *
  have preservesNeg : ∀ p ∈ polynomials(I, A, zero), polynomialAtOrigin(I, A, zero)((polynomialNeg(I, A, add, zero, neg, mul, one))(p)) = -polynomialAtOrigin(I, A, zero)(p)
    intros p hp
    have functionP := polynomials.function with hp
    have negative := polynomials.neg with hp
    have operation := polynomialNeg.apply with hp
    have source := polynomialAtOrigin.value at I, A, zero, coefficientNeg(monomials(I), A, add, zero, neg, mul, one, p) with *
    have coefficient := coefficientNeg.value at monomials(I), A, add, zero, neg, mul, one, p, monomialOne(I) with *
    have value := polynomialAtOrigin.value at I, A, zero, p with *
    cc
  have preservesAdd : ∀ p ∈ polynomials(I, A, zero), ∀ q ∈ polynomials(I, A, zero), polynomialAtOrigin(I, A, zero)((polynomialAdd(I, A, add, zero, neg, mul, one))(p, q)) = polynomialAtOrigin(I, A, zero)(p) + polynomialAtOrigin(I, A, zero)(q)
    intros p hp q hq
    have functionP := polynomials.function with hp
    have functionQ := polynomials.function with hq
    have member := polynomials.add with hp, hq
    have operation := polynomialAdd.apply with hp, hq
    have source := polynomialAtOrigin.value at I, A, zero, coefficientAdd(monomials(I), A, add, zero, neg, mul, one, p, q) with *
    have coefficient := coefficientAdd.value at monomials(I), A, add, zero, neg, mul, one, p, q, monomialOne(I) with *
    have valueP := polynomialAtOrigin.value at I, A, zero, p with *
    have valueQ := polynomialAtOrigin.value at I, A, zero, q with *
    cc
  have preservesMul : ∀ p ∈ polynomials(I, A, zero), ∀ q ∈ polynomials(I, A, zero), polynomialAtOrigin(I, A, zero)((polynomialMul(I, A, add, zero, neg, mul, one))(p, q)) = polynomialAtOrigin(I, A, zero)(p) * polynomialAtOrigin(I, A, zero)(q)
    intros p hp q hq
    have functionP := polynomials.function with hp
    have functionQ := polynomials.function with hq
    have member := polynomialProduct.member with hp, hq
    have operation := polynomialMul.apply with hp, hq
    have source := polynomialAtOrigin.value at I, A, zero, polynomialProduct(I, A, add, zero, neg, mul, one, p, q) with *
    have coefficient := polynomialProduct.constant_coefficient with hp, hq
    have valueP := polynomialAtOrigin.value at I, A, zero, p with *
    have valueQ := polynomialAtOrigin.value at I, A, zero, q with *
    cc
  unfold IsRingHom
  refine ⟨function, preservesZero, preservesOne, preservesNeg, preservesAdd, preservesMul⟩

theorem polynomialAtOrigin.kernel_ideal
  shows IsIdeal(polynomials(I, A, zero), polynomialAdd(I, A, add, zero, neg, mul, one), constantFunction(monomials(I), A, zero), polynomialNeg(I, A, add, zero, neg, mul, one), polynomialMul(I, A, add, zero, neg, mul, one), ringKernel(polynomialAtOrigin(I, A, zero), polynomials(I, A, zero), zero))
proof
  have source := polynomials.comm_ring at I, A, add, zero, neg, mul, one with *
  have hom := polynomialAtOrigin.hom at I, A, add, zero, neg, mul, one with *
  exact IsRingHom.kernel_ideal with source, ring, hom

end Rings

theorem polynomialAtOrigin.surjective (I A zero : Set)
  requires zeroIn : zero ∈ A
  shows SurjectiveBetween(polynomialAtOrigin(I, A, zero), polynomials(I, A, zero), A)
proof
  have function := polynomialAtOrigin.function at I, A, zero
  constructor
  . exact function
  . intros a ha
    have member := polynomialConstant.member at I, A, zero, a with *
    have value := polynomialAtOrigin.constant at I, A, zero, a with *
    have edge := FunctionBetween.relates_apply with *
    refine ⟨polynomialConstant(I, A, zero, a), member, _⟩
    rwa value at edge

theorem polynomialAtOrigin.kernel_membership (I A zero p : Set)
  shows p ∈ ringKernel(polynomialAtOrigin(I, A, zero), polynomials(I, A, zero), zero) ↔ p ∈ polynomials(I, A, zero) ∧ p(monomialOne(I)) = zero
proof
  constructor
  . intro member
    have data := ringKernel.membership.forward with member
    have value := polynomialAtOrigin.value at I, A, zero, p with *
    constructor
    . exact data.left
    . cc
  . intro data
    have value := polynomialAtOrigin.value at I, A, zero, p with *
    apply ringKernel.membership.backward
    constructor
    . exact data.left
    . cc

section Quotient
variable (I A add zero neg mul one : Set)
hypothesis ring : IsCommRing(A, add, zero, neg, mul, one)

theorem polynomialAtOrigin.quotient_iso
  shows IsRingIso(quotientMap(polynomialAtOrigin(I, A, zero), polynomials(I, A, zero), A, idealRelation(polynomials(I, A, zero), polynomialAdd(I, A, add, zero, neg, mul, one), polynomialNeg(I, A, add, zero, neg, mul, one), ringKernel(polynomialAtOrigin(I, A, zero), polynomials(I, A, zero), zero))),
    (polynomials(I, A, zero) ⧸ idealRelation(polynomials(I, A, zero), polynomialAdd(I, A, add, zero, neg, mul, one), polynomialNeg(I, A, add, zero, neg, mul, one), ringKernel(polynomialAtOrigin(I, A, zero), polynomials(I, A, zero), zero))),
    quotientBinary(polynomials(I, A, zero), idealRelation(polynomials(I, A, zero), polynomialAdd(I, A, add, zero, neg, mul, one), polynomialNeg(I, A, add, zero, neg, mul, one), ringKernel(polynomialAtOrigin(I, A, zero), polynomials(I, A, zero), zero)), polynomialAdd(I, A, add, zero, neg, mul, one)), ⟦constantFunction(monomials(I), A, zero)⟧[polynomials(I, A, zero), idealRelation(polynomials(I, A, zero), polynomialAdd(I, A, add, zero, neg, mul, one), polynomialNeg(I, A, add, zero, neg, mul, one), ringKernel(polynomialAtOrigin(I, A, zero), polynomials(I, A, zero), zero))],
    quotientUnary(polynomials(I, A, zero), idealRelation(polynomials(I, A, zero), polynomialAdd(I, A, add, zero, neg, mul, one), polynomialNeg(I, A, add, zero, neg, mul, one), ringKernel(polynomialAtOrigin(I, A, zero), polynomials(I, A, zero), zero)), polynomialNeg(I, A, add, zero, neg, mul, one)), quotientBinary(polynomials(I, A, zero), idealRelation(polynomials(I, A, zero), polynomialAdd(I, A, add, zero, neg, mul, one), polynomialNeg(I, A, add, zero, neg, mul, one), ringKernel(polynomialAtOrigin(I, A, zero), polynomials(I, A, zero), zero)), polynomialMul(I, A, add, zero, neg, mul, one)), ⟦polynomialConstant(I, A, zero, one)⟧[polynomials(I, A, zero), idealRelation(polynomials(I, A, zero), polynomialAdd(I, A, add, zero, neg, mul, one), polynomialNeg(I, A, add, zero, neg, mul, one), ringKernel(polynomialAtOrigin(I, A, zero), polynomials(I, A, zero), zero))],
    A, add, zero, neg, mul, one)
proof
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have source := polynomials.comm_ring at I, A, add, zero, neg, mul, one with *
  have hom := polynomialAtOrigin.hom at I, A, add, zero, neg, mul, one with *
  have onto := polynomialAtOrigin.surjective at I, A, zero with *
  exact idealQuotient.first_isomorphism with source, ring, hom, onto

end Quotient
