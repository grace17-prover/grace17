-- Bundled polynomial rings: the ring value polynomialRing(R, I) over a
-- bundled coefficient ring R in the variables I, its commutative ring
-- instance, the variables X(R, I, j), the constants as the homomorphism
-- polynomialConstant(R, I) : R →+* polynomialRing(R, I), and the bridges
-- to the forms over separate pieces; everything here is ZF
-- Part of Cumulus, the Grace17 mathematics library.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module Grace.Cumulus.Algebra.Polynomial.Bundled
import Constants
import Ring.Homomorphism

-- The polynomial ring over R in the variables I: the finite-support
-- coefficient maps on the monomials with the convolution operations, the
-- zero map, and the constant one, built from the projections of R.
def polynomialRing (R I : Set) : Set :=
  Ring.mk(polynomials(I, R.carrier, R.zero),
    polynomialAdd(I, R.carrier, R.add, R.zero, R.neg, R.mul, R.one),
    constantFunction(monomials(I), R.carrier, R.zero),
    polynomialNeg(I, R.carrier, R.add, R.zero, R.neg, R.mul, R.one),
    polynomialMul(I, R.carrier, R.add, R.zero, R.neg, R.mul, R.one),
    polynomialConstant(I, R.carrier, R.zero, R.one))

-- The variable X_j and the constants, the latter as one graph on R.
def X (R I j : Set) : Set := polynomialVariable(I, R.carrier, R.zero, R.one, j)
def polynomialConstant (R I : Set) : Set :=
  polynomialCoefficients(I, R.carrier, R.zero)

theorem polynomialRing.carrierOf (R I : Set)
  shows Ring.carrier(polynomialRing(R, I)) = polynomials(I, R.carrier, R.zero)
proof
  simp [polynomialRing, Ring.mk.carrier]

theorem polynomialRing.addOf (R I : Set)
  shows Ring.add(polynomialRing(R, I)) =
    polynomialAdd(I, R.carrier, R.add, R.zero, R.neg, R.mul, R.one)
proof
  simp [polynomialRing, Ring.mk.add]

theorem polynomialRing.zeroOf (R I : Set)
  shows Ring.zero(polynomialRing(R, I)) =
    constantFunction(monomials(I), R.carrier, R.zero)
proof
  simp [polynomialRing, Ring.mk.zero]

theorem polynomialRing.negOf (R I : Set)
  shows Ring.neg(polynomialRing(R, I)) =
    polynomialNeg(I, R.carrier, R.add, R.zero, R.neg, R.mul, R.one)
proof
  simp [polynomialRing, Ring.mk.neg]

theorem polynomialRing.mulOf (R I : Set)
  shows Ring.mul(polynomialRing(R, I)) =
    polynomialMul(I, R.carrier, R.add, R.zero, R.neg, R.mul, R.one)
proof
  simp [polynomialRing, Ring.mk.mul]

theorem polynomialRing.oneOf (R I : Set)
  shows Ring.one(polynomialRing(R, I)) =
    polynomialConstant(I, R.carrier, R.zero, R.one)
proof
  simp [polynomialRing, Ring.mk.one]

theorem X.value (R I j : Set)
  shows X(R, I, j) = polynomialVariable(I, R.carrier, R.zero, R.one, j)
proof
  simp [X]

theorem polynomialConstant.graph (R I : Set)
  shows polynomialConstant(R, I) = polynomialCoefficients(I, R.carrier, R.zero)
proof
  simp [Bundled.polynomialConstant]

-- The engine's forms at the projections of R: K is the coefficient ring
-- over separate pieces and P the polynomial ring over it.
section Engine
variable (R I : Set)
notation ring K := (R.carrier, R.add, R.zero, R.neg, R.mul, R.one)
notation ring P := K[I]
hypothesis comm : CommRing(R)

theorem polynomialRing.engine
  shows IsCommRing(P)
proof
  have parts := CommRing.parts with comm
  exact polynomials.comm_ring with parts

instance polynomialRing.comm_ring
  shows CommRing(polynomialRing(R, I))
proof
  have engine := polynomialRing.engine at R, I with comm
  unfold polynomialRing
  exact CommRing.of_parts with engine

theorem polynomialRing.ring
  shows Ring(polynomialRing(R, I))
proof
  exact CommRing.to_ring with (polynomialRing.comm_ring with comm)

-- Membership in the polynomial ring is membership in the engine's carrier.
-- The instance supplies the ring the way a hypothesis does, so under
-- CommRing(R) a binder (p : polynomialRing(R, I)) is membership in its
-- carrier, p ∈ polynomialRing(R, I) is read there, the elements carry
-- p + q, p * q, and p - q, and polynomialRing(R, I)[2] is its numeral.
theorem polynomialRing.mem_iff (p : Set)
  shows p ∈ polynomialRing(R, I) ↔ p ∈ P
proof
  rw polynomialRing.carrierOf
  tauto

instance X.mem (j : Set)
  shows X(R, I, j) ∈ polynomialRing(R, I)
proof
  have zeroIn : R[0] ∈ R := Ring.zero_mem with *
  have oneIn : R[1] ∈ R := Ring.one_mem with *
  rw [polynomialRing.carrierOf, X.value]
  exact polynomialVariable.member with *

theorem polynomialConstant.apply (a : R)
  shows polynomialConstant(R, I)(a) =
    polynomialConstant(I, R.carrier, R.zero, a)
proof
  have zeroIn : R[0] ∈ R := Ring.zero_mem with *
  have aIn : a ∈ R by assumption
  rw polynomialConstant.graph
  exact polynomialCoefficients.value with *

-- The constants form a homomorphism into the polynomial ring.
theorem polynomialConstant.hom
  shows polynomialConstant(R, I) : R →+* polynomialRing(R, I)
proof
  have parts := CommRing.parts with comm
  have engine := polynomialCoefficients.hom at I, R.carrier, R.add, R.zero,
    R.neg, R.mul, R.one with parts
  have shifted : IsRingHom(polynomialConstant(R, I), R.carrier, R.add, R.zero,
      R.neg, R.mul, R.one, Ring.carrier(polynomialRing(R, I)),
      Ring.add(polynomialRing(R, I)), Ring.zero(polynomialRing(R, I)),
      Ring.neg(polynomialRing(R, I)), Ring.mul(polynomialRing(R, I)),
      Ring.one(polynomialRing(R, I)))
    rw [polynomialRing.carrierOf, polynomialRing.addOf, polynomialRing.zeroOf,
      polynomialRing.negOf, polynomialRing.mulOf, polynomialRing.oneOf]
    rw polynomialConstant.graph
    exact engine
  exact RingHom.of_projections with (CommRing.to_ring with comm),
    (polynomialRing.ring with comm), shifted

instance polynomialConstant.mem (a : R)
  shows polynomialConstant(R, I)(a) ∈ polynomialRing(R, I)
proof
  have hom := polynomialConstant.hom at R, I with comm
  exact RingHom.map_mem with *

theorem polynomialConstant.inj (a b : R)
  requires equal : polynomialConstant(R, I)(a) = polynomialConstant(R, I)(b)
  shows a = b
proof
  have zeroIn : R[0] ∈ R := Ring.zero_mem with *
  have aIn : a ∈ R by assumption
  have bIn : b ∈ R by assumption
  rw [polynomialConstant.apply, polynomialConstant.apply] at equal
  exact polynomialConstant.injective with zeroIn, aIn, bIn, equal

-- Ideals of the bundled polynomial ring are the engine's ideals of P.
theorem Ideal.polynomial_parts (J : Set)
  requires ideal : Ideal(polynomialRing(R, I), J)
  shows IsIdeal(P, J)
proof
  have parts := Ideal.parts with ideal
  rw [polynomialRing.carrierOf, polynomialRing.addOf, polynomialRing.zeroOf,
    polynomialRing.negOf, polynomialRing.mulOf] at parts
  exact parts

theorem Ideal.polynomial_of_parts (J : Set)
  requires ideal : IsIdeal(P, J)
  shows Ideal(polynomialRing(R, I), J)
proof
  unfold polynomialRing
  exact Ideal.of_parts with ideal

theorem MaximalIdeal.polynomial_parts (M : Set)
  requires maximal : MaximalIdeal(polynomialRing(R, I), M)
  shows IsMaximalIdeal(P, M)
proof
  have parts := MaximalIdeal.parts with maximal
  rw [polynomialRing.carrierOf, polynomialRing.addOf, polynomialRing.zeroOf,
    polynomialRing.negOf, polynomialRing.mulOf, polynomialRing.oneOf] at parts
  exact parts

theorem MaximalIdeal.polynomial_of_parts (M : Set)
  requires maximal : IsMaximalIdeal(P, M)
  shows MaximalIdeal(polynomialRing(R, I), M)
proof
  unfold polynomialRing
  exact MaximalIdeal.of_parts with maximal

end Engine

-- Homomorphisms out of the bundled polynomial ring are the engine's
-- homomorphisms out of P, into the projections of the target.
section Homomorphisms
variable (R S I g : Set)
notation ring K := (R.carrier, R.add, R.zero, R.neg, R.mul, R.one)
notation ring L := (S.carrier, S.add, S.zero, S.neg, S.mul, S.one)
notation ring P := K[I]
hypothesis comm : CommRing(R)
hypothesis target : CommRing(S)

theorem RingHom.polynomial_parts
  requires hom : g : polynomialRing(R, I) →+* S
  shows IsRingHom(g, P, L)
proof
  have parts := RingHom.parts with hom
  rw [polynomialRing.carrierOf, polynomialRing.addOf, polynomialRing.zeroOf,
    polynomialRing.negOf, polynomialRing.mulOf, polynomialRing.oneOf] at parts
  exact parts

theorem RingHom.polynomial_of_parts
  requires hom : IsRingHom(g, P, L)
  shows g : polynomialRing(R, I) →+* S
proof
  have shifted : IsRingHom(g, Ring.carrier(polynomialRing(R, I)),
      Ring.add(polynomialRing(R, I)), Ring.zero(polynomialRing(R, I)),
      Ring.neg(polynomialRing(R, I)), Ring.mul(polynomialRing(R, I)),
      Ring.one(polynomialRing(R, I)), S.carrier, S.add, S.zero, S.neg,
      S.mul, S.one)
    rw [polynomialRing.carrierOf, polynomialRing.addOf, polynomialRing.zeroOf,
      polynomialRing.negOf, polynomialRing.mulOf, polynomialRing.oneOf]
    exact hom
  exact RingHom.of_projections with (polynomialRing.ring with comm),
    (CommRing.to_ring with target), shifted

end Homomorphisms
