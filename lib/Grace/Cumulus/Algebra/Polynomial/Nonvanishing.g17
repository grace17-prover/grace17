module Grace.Cumulus.Algebra.Polynomial.Nonvanishing
import HornerReconstruction
import HornerNormalization

theorem polynomialVariablesUsed.empty_constant (I A z p : Set)
  requires zeroIn : z ∈ A
  requires polynomial : p ∈ polynomials(I, A, z)
  requires unused : polynomialVariablesUsed(I, A, z, p) ⊆ ∅
  shows p = polynomialConstant(I, A, z, p(monomialOne(I)))
proof
  have unit := monomialOne.member at I
  have coefficient := polynomials.coefficient with *
  have constant := polynomialConstant.member at I, A, z, p(monomialOne(I)) with *
  apply polynomials.ext with polynomial, constant
  intros m monomial
  have alternatives : m = monomialOne(I) ∨ m ≠ monomialOne(I) by tauto
  cases alternatives with same | different
  . rw same
    symm
    exact polynomialConstant.coefficient with *
  . have vanishes : p(m) = z
      by_contra nonzero
      have supported : m ∈ functionSupport(p, monomials(I), z)
        exact functionSupport.membership.backward with ⟨monomial, nonzero⟩
      have exponents : ∀ i ∈ I, m(i) = monomialOne(I)(i)
        intros i index
        have zero := monomialOne.value with index
        rw zero
        by_contra present
        have inSupport : i ∈ functionSupport(m, I, 0) := functionSupport.membership.backward with ⟨index, present⟩
        have used : i ∈ polynomialVariablesUsed(I, A, z, p)
          exact polynomialVariablesUsed.membership.backward with ⟨m, supported, inSupport⟩
        have impossible := unused with i, used
        exact set.empty with impossible
      have equal := monomials.ext with *
      exact different with equal
    have value := polynomialConstant.value at I, A, z, p(monomialOne(I)), m with *
    have selected := singleValue.other at A, z, p(monomialOne(I)), monomialOne(I), m with *
    cc

section Fields
variable (I A add z neg mul one : Set)
notation ring R := (A, add, z, neg, mul, one)
notation ring P := R[I]
hypothesis field : IsField(R)
hypothesis infinite : ¬Finite(R)

theorem polynomialAt.nonvanishing_from_coefficient (p j v : Set, n : Nat)
  requires polynomial : p ∈ P
  requires index : j ∈ I
  requires assignment : v : I → R
  requires nonzero : polynomialAt(I, R, v)(polynomialVariableCoefficient(I, R, p, j, n)) ≠ z
  shows ∃ w, FunctionBetween(w, I, R) ∧ polynomialAt(I, R, w)(p) ≠ z
proof
  have ring := IsField.comm_ring with field
  have zeroIn : z ∈ R by typecheck
  have polynomialRing := polynomials.comm_ring at I, A, add, z, neg, mul, one with *
  have zeroMember : P[0] ∈ P by typecheck
  obtain ⟨cs, list, coefficients⟩ := polynomialCoefficientFamily.list_representation at I, A, z, p, j with *
  have hom := polynomialAt.hom with *
  have function := IsRingHom.function with hom
  have zeroValue := IsRingHom.zero with hom
  have lookup := listCoefficient.map at P, A, polynomialAt(I, R, v), P[0], cs, n with *
  have value := coefficients with n
  have scalarNonzero : ∃ k, Nat(k) ∧ listCoefficient{A}(z, listMap{P}(polynomialAt(I, R, v), cs), k) ≠ z
    refine ⟨n, assumption, ?_⟩
    rw [zeroValue, value] at lookup
    rwa lookup
  obtain ⟨a, element, avoids⟩ := hornerAt.exists_nonzero_of_coefficient at A, add, z, neg, mul, one, listMap{P}(polynomialAt(I, R, v), cs) with *
  have updated := coefficientErase.function at I, A, a, v, j with *
  have coordinate := coefficientErase.same at I, A, a, v, j with *
  have away : ∀ i ∈ I, i ≠ j → v(i) = coefficientErase(I, A, a, v, j)(i)
    intros i hi different
    symm
    exact coefficientErase.other with *
  have same : ∀ k, Nat(k) → polynomialAt(I, R, v)(listCoefficient{P}(P[0], cs, k)) = polynomialAt(I, R, coefficientErase(I, A, a, v, j))(listCoefficient{P}(P[0], cs, k))
    intros k natural
    have coefficient := coefficients with k, natural
    rw coefficient
    exact polynomialVariableCoefficient.agree_away with *
  have maps := listMap.congr_coefficients with *
  have evaluation := polynomialAt.reconstruction at I, A, add, z, neg, mul, one, p, j, coefficientErase(I, A, a, v, j), cs with *
  refine ⟨coefficientErase(I, A, a, v, j), updated, ?_⟩
  rwa [evaluation, coordinate, ← maps]

theorem polynomialAt.nonvanishing_on_list (p : Set) (xs : List(I))
  requires polynomial : p ∈ P
  requires nonzero : p ≠ P[0]
  requires variables : polynomialVariablesUsed(I, A, z, p) ⊆ listSupport{I}(xs)
  shows ∃ v, FunctionBetween(v, I, R) ∧ polynomialAt(I, R, v)(p) ≠ z
proof
  induction xs generalizing p
  | List.nil =>
    intros p polynomial nonzero variables
    have ring := IsField.comm_ring with field
    have zeroIn : z ∈ R by typecheck
    rw listSupport at variables
    have constant := polynomialVariablesUsed.empty_constant with *
    have unit := monomialOne.member at I
    have coefficient := polynomials.coefficient with *
    have different : p(monomialOne(I)) ≠ z
      intro equal
      have zero := polynomialConstant.zero at I, A, z with *
      apply nonzero
      rwa [constant, equal]
    have assignment := constantFunction.function at I, A, z with *
    have evaluation := polynomialAt.constant with coefficient
    refine ⟨constantFunction(I, A, z), assignment, ?_⟩
    rwa [constant, evaluation]
  | List.cons(j, tail) using ih =>
    intros p polynomial nonzero variables
    have index : j ∈ I by assumption
    have ring := IsField.comm_ring with field
    have zeroIn : z ∈ R by typecheck
    obtain ⟨n, nIn, coefficientNonzero⟩ := polynomialVariableCoefficient.exists_nonzero at I, A, z, p, j with *
    have natural := nat.omega.backward with nIn
    have coefficient := polynomialVariableCoefficient.member at I, A, z, p, j, n with *
    have smaller := polynomialVariableCoefficient.variables at I, A, z, p, j, n with *
    have bounded : polynomialVariablesUsed(I, A, z, polynomialVariableCoefficient(I, R, p, j, n)) ⊆ listSupport{I}(tail)
      intros i hi
      have reduced := smaller with i, hi
      obtain ⟨used, absent⟩ := difference.membership.forward with reduced
      have member := variables with i, used
      rw listSupport at member
      have alternatives := insert.membership.forward with member
      cases alternatives with same | old
      . exfalso
        apply absent
        exact singleton.membership.backward with same
      . exact old
    obtain ⟨v, assignment, value⟩ := ih with polynomialVariableCoefficient(I, R, p, j, n), coefficient, coefficientNonzero, bounded
    exact polynomialAt.nonvanishing_from_coefficient with *

theorem polynomialAt.exists_nonzero (p : Set)
  requires polynomial : p ∈ P
  requires nonzero : p ≠ P[0]
  shows ∃ v, FunctionBetween(v, I, R) ∧ polynomialAt(I, R, v)(p) ≠ z
proof
  have finite := polynomialVariablesUsed.finite with *
  have subset := polynomialVariablesUsed.subset at I, A, z, p
  obtain ⟨xs, list, covers⟩ := Finite.cover_in at polynomialVariablesUsed(I, A, z, p), I with *
  exact polynomialAt.nonvanishing_on_list with *

theorem polynomialAt.ext (p q : Set)
  requires left : p ∈ P
  requires right : q ∈ P
  requires agreement : ∀ v, FunctionBetween(v, I, R) → polynomialAt(I, R, v)(p) = polynomialAt(I, R, v)(q)
  shows p = q
proof
  have ring := IsField.comm_ring with field
  have source := polynomials.comm_ring at I, A, add, z, neg, mul, one with *
  have ordinary := IsCommRing.ring with source
  have negative := IsRing.neg_closed with ordinary, right
  have difference : P[p - q] ∈ P
    exact IsRing.add_closed with *
  by_contra different
  have nonzero : P[p - q] ≠ P[0]
    intro vanishes
    apply different
    linear_combination vanishes
  obtain ⟨v, assignment, value⟩ := polynomialAt.exists_nonzero at I, A, add, z, neg, mul, one, P[p - q] with *
  have hom := polynomialAt.hom with *
  have mapped := IsRingHom.sub with source, hom, left, right
  have same := agreement with v, assignment
  have inQ := IsRingHom.closed with hom, right
  apply value
  rw [mapped, same]
  ring

end Fields
