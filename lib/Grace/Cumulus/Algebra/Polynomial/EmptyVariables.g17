module Grace.Cumulus.Algebra.Polynomial.EmptyVariables
import EvaluationOver
import HornerRelations

theorem monomials.empty_unique (m : Set)
  requires monomial : m ∈ monomials(∅)
  shows m = monomialOne(∅)
proof
  have unit := monomialOne.member at ∅
  apply monomials.ext with monomial, unit
  intros i impossible
  exfalso
  exact set.empty with impossible

defgraph emptyPolynomialCoefficient (A zero : Set) (p ∈ polynomials(∅, A, zero)) : A := p(monomialOne(∅))
proof
  have function := polynomials.function with member
  have unit := monomialOne.member at ∅
  exact FunctionBetween.apply_closed with function, unit

theorem polynomial.empty_constant (A zero p : Set)
  requires zeroIn : zero ∈ A
  requires polynomial : p ∈ polynomials(∅, A, zero)
  shows p = polynomialConstant(∅, A, zero, emptyPolynomialCoefficient(A, zero)(p))
proof
  have function := polynomials.function with polynomial
  have coefficientMap := emptyPolynomialCoefficient.function at A, zero
  have coefficient := FunctionBetween.apply_closed with coefficientMap, polynomial
  have value := emptyPolynomialCoefficient.value with polynomial
  have constant := polynomialConstant.member at ∅, A, zero, emptyPolynomialCoefficient(A, zero)(p) with *
  have constantFunction := polynomials.function with constant
  apply FunctionBetween.ext with function, constantFunction
  intros m hm
  have same := monomials.empty_unique with hm
  have evaluated := polynomialConstant.value at ∅, A, zero, emptyPolynomialCoefficient(A, zero)(p), m with *
  have selected := singleValue.same at A, zero, emptyPolynomialCoefficient(A, zero)(p), monomialOne(∅), m with *
  cc

theorem emptyPolynomialCoefficient.nonzero (A zero p : Set)
  requires zeroIn : zero ∈ A
  requires polynomial : p ∈ polynomials(∅, A, zero)
  requires nonzero : p ≠ constantFunction(monomials(∅), A, zero)
  shows emptyPolynomialCoefficient(A, zero)(p) ≠ zero
proof
  have constant := polynomial.empty_constant with *
  intro vanishes
  rw [vanishes, polynomialConstant.zero] at constant
  exact nonzero with constant

section Algebras
variable (A add zero neg mul one B plus z minus times unit f v : Set)
notation ring R := (A, add, zero, neg, mul, one)
notation ring S := (B, plus, z, minus, times, unit)
notation ring Q := R[∅]
hypothesis source : IsCommRing(R)
hypothesis target : IsCommRing(S)
hypothesis hom : IsRingHom(f, R, S)
hypothesis assignment : v : ∅ → S

theorem polynomialAtOver.empty_value (p : Set)
  requires polynomial : p ∈ Q
  shows polynomialAtOver(∅, R, S, f, v)(p) = f(emptyPolynomialCoefficient(A, zero)(p))
proof
  have zeroIn : R[0] ∈ R by typecheck
  have function := emptyPolynomialCoefficient.function at A, zero
  have coefficient := FunctionBetween.apply_closed with function, polynomial
  have constant := polynomial.empty_constant with *
  have evaluation := polynomialAtOver.constant with coefficient
  cc

-- Top-down transport: extract each constant coefficient, preserve the nonzero
-- leading term, then map the finite Horner list through coefficient extraction.
theorem AlgebraicOver.empty_variables (x : Set)
  requires algebraic : AlgebraicOver(polynomialAtOver(∅, R, S, f, v), Q, S, x)
  shows AlgebraicOver(f, R, S, x)
proof
  obtain ⟨member, leading, polynomial, nonzero, cs, list, equation⟩ := algebraic
  have function := emptyPolynomialCoefficient.function at A, zero
  have coefficient := FunctionBetween.apply_closed with function, polynomial
  have zeroIn : R[0] ∈ R by typecheck
  have leadingNonzero := emptyPolynomialCoefficient.nonzero with *
  have coefficients := listMap.closed with *
  have agreement : ∀ p ∈ Q, polynomialAtOver(∅, R, S, f, v)(p) = f(emptyPolynomialCoefficient(A, zero)(p))
    intros p hp
    exact polynomialAtOver.empty_value with *
  have leadingValue := agreement with leading, polynomial
  have changed := monicValue.change_coefficients at Q, A, plus, times, emptyPolynomialCoefficient(A, zero), f, polynomialAtOver(∅, R, S, f, v), polynomialAtOver(∅, R, S, f, v)(leading), x, cs with *
  unfold polynomialHorner at equation
  rw [changed, leadingValue] at equation
  unfold AlgebraicOver
  refine ⟨member, emptyPolynomialCoefficient(A, zero)(leading), coefficient, leadingNonzero, listMap{Q}(emptyPolynomialCoefficient(A, zero), cs), coefficients, ?_⟩
  simp [polynomialHorner]

end Algebras
