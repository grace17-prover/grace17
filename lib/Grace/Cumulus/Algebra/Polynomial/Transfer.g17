module Grace.Cumulus.Algebra.Polynomial.Transfer
import EvaluationSupport

defgraph polynomialTransferVariables (I J A z one : Set) (i ∈ I) : polynomials(J, A, z) := polynomialVariable(J, A, z, one, i)
requires zeroIn : z ∈ A
requires oneIn : one ∈ A
proof
  exact polynomialVariable.member with *

def polynomialTransfer (I J A add z neg mul one : Set) : Set :=
  polynomialAtOver(I, A, add, z, neg, mul, one, polynomials(J, A, z), polynomialAdd(J, A, add, z, neg, mul, one), constantFunction(monomials(J), A, z), polynomialNeg(J, A, add, z, neg, mul, one), polynomialMul(J, A, add, z, neg, mul, one), polynomialConstant(J, A, z, one), polynomialCoefficients(J, A, z), polynomialTransferVariables(I, J, A, z, one))

notation scoped polynomialTransfer(I, J, R) => polynomialTransfer(I, J, R.carrier, R.add, R.zero, R.neg, R.mul, R.one)

section Rings
variable (I J A add z neg mul one : Set)
notation ring R := (A, add, z, neg, mul, one)
notation ring P := R[I]
notation ring Q := R[J]
hypothesis ring : IsCommRing(R)

theorem polynomialTransfer.hom
  shows IsRingHom(polynomialTransfer(I, J, R), P, Q)
proof
  have target : IsCommRing(Q)
    exact polynomials.comm_ring with *
  have coefficients : IsRingHom(polynomialCoefficients(J, R), R, Q)
    exact polynomialCoefficients.hom with *
  have zeroIn : R[0] ∈ R by typecheck
  have oneIn : R[1] ∈ R by typecheck
  have assignment := polynomialTransferVariables.function at I, J, A, z, one with *
  unfold polynomialTransfer
  exact polynomialAtOver.hom with *

theorem polynomialTransfer.constant (a : Set)
  requires coefficient : a ∈ R
  shows polynomialTransfer(I, J, R)(polynomialConstant(I, R, a)) = polynomialConstant(J, R, a)
proof
  have target : IsCommRing(Q)
    exact polynomials.comm_ring with *
  have coefficients : IsRingHom(polynomialCoefficients(J, R), R, Q)
    exact polynomialCoefficients.hom with *
  have zeroIn : R[0] ∈ R by typecheck
  have oneIn : R[1] ∈ R by typecheck
  have assignment := polynomialTransferVariables.function at I, J, A, z, one with *
  have value := polynomialCoefficients.value at J, A, z, a with *
  unfold polynomialTransfer
  rwa polynomialAtOver.constant

theorem polynomialTransfer.variable (i : Set)
  requires index : i ∈ I
  shows polynomialTransfer(I, J, R)(polynomialVariable(I, R, i)) = polynomialVariable(J, R, i)
proof
  have target : IsCommRing(Q)
    exact polynomials.comm_ring with *
  have coefficients : IsRingHom(polynomialCoefficients(J, R), R, Q)
    exact polynomialCoefficients.hom with *
  have zeroIn : R[0] ∈ R by typecheck
  have oneIn : R[1] ∈ R by typecheck
  have assignment := polynomialTransferVariables.function at I, J, A, z, one with *
  have value := polynomialTransferVariables.value at I, J, A, z, one, i with *
  unfold polynomialTransfer
  rwa polynomialAtOver.variable

theorem polynomialTransfer.outside_variable (i : Set)
  requires index : i ∈ I
  requires outside : ¬(i ∈ J)
  shows polynomialTransfer(I, J, R)(polynomialVariable(I, R, i)) = Q[1]
proof
  have mapped := polynomialTransfer.variable at I, J, A, add, z, neg, mul, one, i with *
  have monomial := monomialVariable.member at J, i
  have unit := monomialOne.member at J
  have same : monomialVariable(J, i) = monomialOne(J)
    apply monomials.ext with monomial, unit
    intros k member
    have distinct : k ≠ i
      intro equal
      rw equal at member
      exact outside with member
    have value := coefficientSingle.other at J, ℕ, (0:Nat), (1:Nat), i, k with *
    have zero := monomialOne.value at J, k with *
    unfold monomialVariable
    cc
  rw mapped
  simp [polynomialVariable, polynomialConstant]

section Evaluation
variable (B plus o minus times unit f v w : Set)
notation ring S := (B, plus, o, minus, times, unit)
hypothesis target : IsCommRing(S)
hypothesis hom : IsRingHom(f, R, S)
hypothesis first : v : I → S
hypothesis second : w : J → S

theorem polynomialTransfer.evaluate_supported (p : Set)
  requires polynomial : p ∈ P
  requires supported : polynomialVariablesUsed(I, R, p) ⊆ J
  requires agreement : ∀ i ∈ polynomialVariablesUsed(I, R, p), v(i) = w(i)
  shows polynomialAtOver(J, R, S, f, w)(polynomialTransfer(I, J, R)(p)) = polynomialAtOver(I, R, S, f, v)(p)
proof
  have transfer : IsRingHom(polynomialTransfer(I, J, R), P, Q)
    exact polynomialTransfer.hom with *
  have evaluationI : IsRingHom(polynomialAtOver(I, R, S, f, v), P, S)
    exact polynomialAtOver.hom with *
  have evaluationJ : IsRingHom(polynomialAtOver(J, R, S, f, w), Q, S)
    exact polynomialAtOver.hom with *
  have sourceRing : IsCommRing(P)
    exact polynomials.comm_ring with *
  have combined := IsRingHom.compose with sourceRing, transfer, evaluationJ
  have functionT := IsRingHom.function with transfer
  have functionJ := IsRingHom.function with evaluationJ
  have zeroIn : R[0] ∈ R by typecheck
  have oneIn : R[1] ∈ R by typecheck
  have constants : ∀ a ∈ R, compose(polynomialAtOver(J, R, S, f, w), polynomialTransfer(I, J, R), P, Q, S)(polynomialConstant(I, R, a)) = f(a)
    intros a coefficient
    have member := polynomialConstant.member at I, A, z, a with *
    have composed := compose.apply at polynomialAtOver(J, R, S, f, w), polynomialTransfer(I, J, R), P, Q, S, polynomialConstant(I, R, a) with *
    have mapped := polynomialTransfer.constant at I, J, A, add, z, neg, mul, one, a with *
    have evaluated := polynomialAtOver.constant at J, A, add, z, neg, mul, one, B, plus, o, minus, times, unit, f, w, a with *
    cc
  have originals : ∀ a ∈ R, polynomialAtOver(I, R, S, f, v)(polynomialConstant(I, R, a)) = f(a)
    intros a coefficient
    exact polynomialAtOver.constant with *
  have variables : ∀ i ∈ polynomialVariablesUsed(I, R, p), compose(polynomialAtOver(J, R, S, f, w), polynomialTransfer(I, J, R), P, Q, S)(polynomialVariable(I, R, i)) = polynomialAtOver(I, R, S, f, v)(polynomialVariable(I, R, i))
    intros i used
    have subset := polynomialVariablesUsed.subset at I, A, z, p
    have inI := subset with i, used
    have inJ := supported with i, used
    have member := polynomialVariable.member at I, A, z, one, i with *
    have composed := compose.apply at polynomialAtOver(J, R, S, f, w), polynomialTransfer(I, J, R), P, Q, S, polynomialVariable(I, R, i) with *
    have mapped := polynomialTransfer.variable at I, J, A, add, z, neg, mul, one, i with *
    have evaluated := polynomialAtOver.variable at J, A, add, z, neg, mul, one, B, plus, o, minus, times, unit, f, w, i with *
    have original := polynomialAtOver.variable at I, A, add, z, neg, mul, one, B, plus, o, minus, times, unit, f, v, i with *
    have same := agreement with i, used
    cc
  have equal := IsRingHom.polynomial_local_ext with *
  have value := compose.apply at polynomialAtOver(J, R, S, f, w), polynomialTransfer(I, J, R), P, Q, S, p with *
  cc

end Evaluation

theorem polynomialTransfer.roundtrip (p : Set)
  requires polynomial : p ∈ P
  requires supported : polynomialVariablesUsed(I, R, p) ⊆ J
  shows polynomialTransfer(J, I, R)(polynomialTransfer(I, J, R)(p)) = p
proof
  have target : IsCommRing(P)
    exact polynomials.comm_ring with *
  have coefficients : IsRingHom(polynomialCoefficients(I, R), R, P)
    exact polynomialCoefficients.hom with *
  have zeroIn : R[0] ∈ R by typecheck
  have oneIn : R[1] ∈ R by typecheck
  have first := polynomialVariables.function at I, A, z, one with *
  have second := polynomialTransferVariables.function at J, I, A, z, one with *
  have agreement : ∀ i ∈ polynomialVariablesUsed(I, R, p), polynomialVariables(I, R)(i) = polynomialTransferVariables(J, I, A, z, one)(i)
    intros i used
    have subset := polynomialVariablesUsed.subset at I, A, z, p
    have inI := subset with i, used
    have included := supported
    have inJ := included with i, used
    have left := polynomialVariables.value at I, A, z, one, i with *
    have right := polynomialTransferVariables.value at J, I, A, z, one, i with *
    cc
  have equal : polynomialAtOver(J, R, P, polynomialCoefficients(I, R), polynomialTransferVariables(J, I, A, z, one))(polynomialTransfer(I, J, R)(p)) = polynomialAtOver(I, R, P, polynomialCoefficients(I, R), polynomialVariables(I, R))(p)
    exact polynomialTransfer.evaluate_supported with *
  have canonical := polynomialAtOver.canonical_variables at I, A, add, z, neg, mul, one with *
  rw canonical at equal
  have identity := identity.apply at p, P with *
  unfold polynomialTransfer at equal
  unfold polynomialTransfer
  cc

theorem polynomialTransfer.nonzero_supported (p : Set)
  requires polynomial : p ∈ P
  requires supported : polynomialVariablesUsed(I, R, p) ⊆ J
  requires nonzero : p ≠ P[0]
  shows polynomialTransfer(I, J, R)(p) ≠ Q[0]
proof
  have reverse : IsRingHom(polynomialTransfer(J, I, R), Q, P)
    exact polynomialTransfer.hom with *
  have zero := IsRingHom.zero with reverse
  have recovered := polynomialTransfer.roundtrip with *
  intro vanishes
  apply nonzero
  cc

theorem polynomialTransfer.injective
  requires subset : I ⊆ J
  shows InjectiveBetween(polynomialTransfer(I, J, R), P, Q)
proof
  have hom : IsRingHom(polynomialTransfer(I, J, R), P, Q)
    exact polynomialTransfer.hom with *
  have function := IsRingHom.function with hom
  unfold InjectiveBetween
  refine ⟨function, ?_⟩
  intros p hp q hq y hy first second
  have valueP := FunctionBetween.apply_value at polynomialTransfer(I, J, R), P, Q, p, y with *
  have valueQ := FunctionBetween.apply_value at polynomialTransfer(I, J, R), P, Q, q, y with *
  have usedP := polynomialVariablesUsed.subset at I, A, z, p
  have usedQ := polynomialVariablesUsed.subset at I, A, z, q
  have supportedP := Subset.transitive with usedP, subset
  have supportedQ := Subset.transitive with usedQ, subset
  have recoveredP := polynomialTransfer.roundtrip at I, J, A, add, z, neg, mul, one, p with *
  have recoveredQ := polynomialTransfer.roundtrip at I, J, A, add, z, neg, mul, one, q with *
  cc

end Rings
