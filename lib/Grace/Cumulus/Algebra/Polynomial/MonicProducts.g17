module Grace.Cumulus.Algebra.Polynomial.MonicProducts
import HornerExtension
import MonicVanishing

section Lengths
variable (A add zero neg mul one a : Set)
notation ring R := (A, add, zero, neg, mul, one)
hypothesis source : IsCommRing(R)
hypothesis center : a ∈ R

theorem hornerLinearProduct.length (carry : Set) (cs : List(A))
  requires constant : carry ∈ R
  shows length{A}(hornerLinearProduct{A}(add, neg, mul, a, carry, cs)) = succ(length{A}(cs))
proof
  induction cs generalizing carry
  | List.nil =>
    intros carry constant
    have empty : List(A, []) by typecheck
    have ordinary := IsCommRing.ring with source
    have negative := IsRing.neg_closed with ordinary, center
    have head := IsRing.add_closed with ordinary, constant, negative
    rw [hornerLinearProduct, length.cons, length.nil]
    rfl
  | List.cons(c, tail) using ih =>
    intros carry constant
    have empty : List(A, []) by typecheck
    have coefficient : c ∈ R by assumption
    have ordinary := IsCommRing.ring with source
    have productIn := IsRing.mul_closed with ordinary, center, coefficient
    have negative := IsRing.neg_closed with ordinary, productIn
    have head := IsRing.add_closed with ordinary, constant, negative
    have rest := hornerLinearProduct.closed at A, add, zero, neg, mul, one, a, c, tail with *
    have previous := ih with c, coefficient
    rw [hornerLinearProduct, length.cons, previous, length.cons]
    rfl

end Lengths

section Extensions
variable (A add zero neg mul one B plus z minus times unit f x a : Set)
notation ring R := (A, add, zero, neg, mul, one)
notation ring S := (B, plus, z, minus, times, unit)
hypothesis source : IsCommRing(R)
hypothesis target : IsCommRing(S)
hypothesis hom : IsRingHom(f, R, S)
hypothesis element : x ∈ S
hypothesis center : a ∈ R

theorem hornerLinearProduct.map_value (carry : Set) (cs : List(A))
  requires constant : carry ∈ R
  shows monicValue(R, f, S, x, hornerLinearProduct{A}(add, neg, mul, a, carry, cs)) =
    S[f(carry) + (x - f(a)) * monicValue(R, f, S, x, cs)]
proof
  induction cs generalizing carry
  | List.nil =>
    intros carry constant
    have empty : List(A, []) by typecheck
    have ordinary := IsCommRing.ring with source
    have negative := IsRing.neg_closed with ordinary, center
    have head := IsRing.add_closed with ordinary, constant, negative
    have fa := IsRingHom.closed with hom, center
    have fc := IsRingHom.closed with hom, constant
    have difference := IsRingHom.sub at f, A, add, zero, neg, mul, one, B, plus, z, minus, times, unit, carry, a with *
    rw [hornerLinearProduct, monicValue, monicValue, monicValue, difference]
    ring
  | List.cons(c, tail) using ih =>
    intros carry constant
    have empty : List(A, []) by typecheck
    have coefficient : c ∈ R by assumption
    have ordinary := IsCommRing.ring with source
    have product := IsRing.mul_closed with ordinary, center, coefficient
    have productIn := IsRing.mul_closed with ordinary, center, coefficient
    have negative := IsRing.neg_closed with ordinary, productIn
    have head := IsRing.add_closed with ordinary, constant, negative
    have rest := hornerLinearProduct.closed at A, add, zero, neg, mul, one, a, c, tail with *
    have previous := ih with c, coefficient
    have tailValue := monicValue.closed at A, add, zero, neg, mul, one, B, plus, z, minus, times, unit, f, x, tail with *
    have fa := IsRingHom.closed with hom, center
    have fc := IsRingHom.closed with hom, coefficient
    have fcarry := IsRingHom.closed with hom, constant
    have difference := IsRingHom.sub at f, A, add, zero, neg, mul, one, B, plus, z, minus, times, unit, carry, R[a * c] with *
    have mappedProduct := IsRingHom.mul with hom, center, coefficient
    have outer := hornerValue.cons at A, f, plus, times, unit, x, R[carry - a * c], hornerLinearProduct{A}(add, neg, mul, a, c, tail) with *
    have original := hornerValue.cons at A, f, plus, times, unit, x, c, tail with *
    rw [hornerLinearProduct, outer, original, previous, difference, mappedProduct]
    ring

end Extensions

section Polynomials
variable (I A add zero neg mul one j a carry : Set)
notation ring R := (A, add, zero, neg, mul, one)
notation ring P := R[I]
hypothesis ring : IsCommRing(R)
hypothesis center : a ∈ R
hypothesis constant : carry ∈ R

theorem polynomialFromHorner.linear_product (cs : List(A))
  shows polynomialFromHorner(I, R, j, R[1], hornerLinearProduct{A}(add, neg, mul, a, carry, cs)) =
    P[polynomialCoefficients(I, R)(carry) + (polynomialVariable(I, R, j) - polynomialCoefficients(I, R)(a)) * polynomialFromHorner(I, R, j, R[1], cs)]
proof
  have target := polynomials.comm_ring at I, A, add, zero, neg, mul, one with *
  have hom := polynomialCoefficients.hom at I, A, add, zero, neg, mul, one with *
  have zeroIn : R[0] ∈ R by typecheck
  have oneIn : R[1] ∈ R by typecheck
  have variable := polynomialVariable.member at I, A, zero, one, j with *
  have result := hornerLinearProduct.map_value at A, add, zero, neg, mul, one, P, polynomialAdd(I, R), P[0], polynomialNeg(I, R), polynomialMul(I, R), P[1], polynomialCoefficients(I, R), polynomialVariable(I, R, j), a, carry, cs with *
  simp [polynomialFromHorner]

end Polynomials
-- Lower coefficients of the monic product of (X-a), one factor per list entry.
def monicFactorCoefficients {A : Set} (add z neg mul : Set) (xs : List(A)) → Set
  | add, z, neg, mul, List.nil => []
  | add, z, neg, mul, List.cons(a, tail) => hornerLinearProduct{A}(add, neg, mul, a, z, monicFactorCoefficients(add, z, neg, mul, tail))
  descends xs

def polynomialLinearFactors (I A add zero neg mul one j : Set) (xs : List(A)) : Set :=
  polynomialFromHorner(I, A, add, zero, neg, mul, one, j, one, monicFactorCoefficients{A}(add, zero, neg, mul, xs))

notation scoped polynomialLinearFactors(I, R, j, xs) => polynomialLinearFactors(I, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, j, xs)

section Coefficients
variable (A add zero neg mul one : Set)
notation ring R := (A, add, zero, neg, mul, one)
hypothesis ring : IsCommRing(R)

theorem monicFactorCoefficients.closed (xs : List(A))
  shows List(A, monicFactorCoefficients{A}(add, zero, neg, mul, xs))
proof
  induction xs
  | List.nil =>
    rw monicFactorCoefficients
    typecheck
  | List.cons(a, tail) using ih =>
    have center : a ∈ R by assumption
    have zeroIn : R[0] ∈ R by typecheck
    rw monicFactorCoefficients
    exact hornerLinearProduct.closed with *

theorem monicFactorCoefficients.length (xs : List(A))
  shows length{A}(monicFactorCoefficients{A}(add, zero, neg, mul, xs)) = length{A}(xs)
proof
  induction xs
  | List.nil =>
    rw monicFactorCoefficients
    rfl
  | List.cons(a, tail) using ih =>
    have center : a ∈ R by assumption
    have zeroIn : R[0] ∈ R by typecheck
    have rest := monicFactorCoefficients.closed with *
    have size := hornerLinearProduct.length at A, add, zero, neg, mul, one, a, zero, monicFactorCoefficients{A}(add, zero, neg, mul, tail) with *
    rw [monicFactorCoefficients, length.cons]
    cc

end Coefficients

section Factors
variable (I A add zero neg mul one j : Set)
notation ring R := (A, add, zero, neg, mul, one)
notation ring P := R[I]
hypothesis ring : IsCommRing(R)

theorem polynomialLinearFactors.member (xs : List(A))
  shows polynomialLinearFactors(I, R, j, xs) ∈ P
proof
  have oneIn : R[1] ∈ R by typecheck
  have coefficients := monicFactorCoefficients.closed with *
  unfold polynomialLinearFactors
  exact polynomialFromHorner.member with *

theorem polynomialLinearFactors.nil
  shows polynomialLinearFactors(I, R, j, []) = P[1]
proof
  unfold polynomialLinearFactors
  rw monicFactorCoefficients
  exact polynomialFromHorner.nil with *

theorem polynomialLinearFactors.cons (a : Set) (xs : List(A))
  requires center : a ∈ R
  shows polynomialLinearFactors(I, R, j, a :: xs) =
    P[(polynomialVariable(I, R, j) - polynomialCoefficients(I, R)(a)) * polynomialLinearFactors(I, R, j, xs)]
proof
  have zeroIn : R[0] ∈ R by typecheck
  have oneIn : R[1] ∈ R by typecheck
  have target := polynomials.comm_ring at I, A, add, zero, neg, mul, one with *
  have ordinary := IsCommRing.ring with target
  have hom := polynomialCoefficients.hom at I, A, add, zero, neg, mul, one with *
  have mapsZero := IsRingHom.zero with hom
  have image := IsRingHom.closed with hom, center
  have variable := polynomialVariable.member at I, A, zero, one, j with *
  have negative := IsRing.neg_closed with ordinary, image
  have difference := IsRing.add_closed with ordinary, variable, negative
  have coefficients := monicFactorCoefficients.closed with *
  have rest := polynomialFromHorner.member at I, A, add, zero, neg, mul, one, j, one, monicFactorCoefficients{A}(add, zero, neg, mul, xs) with *
  have product := IsRing.mul_closed with ordinary, difference, rest
  have identity := IsRing.add_left_identity with ordinary, product
  have equation := polynomialFromHorner.linear_product at I, A, add, zero, neg, mul, one, j, a, zero, monicFactorCoefficients{A}(add, zero, neg, mul, xs) with *
  unfold polynomialLinearFactors
  rw monicFactorCoefficients
  cc

theorem polynomialLinearFactors.leading_coefficient (xs : List(A))
  requires index : j ∈ I
  shows polynomialLinearFactors(I, R, j, xs)(monomialShift(I, j, monomialOne(I), length{A}(xs))) = R[1]
proof
  have oneIn : R[1] ∈ R by typecheck
  have coefficients := monicFactorCoefficients.closed with *
  have size := monicFactorCoefficients.length at A, add, zero, neg, mul, one, xs with *
  have leading := polynomialFromHorner.leading_coefficient at I, A, add, zero, neg, mul, one, j, one, monicFactorCoefficients{A}(add, zero, neg, mul, xs) with *
  unfold polynomialLinearFactors
  cc

theorem polynomialLinearFactors.nonzero (xs : List(A))
  requires index : j ∈ I
  requires nontrivial : R[1] ≠ R[0]
  shows polynomialLinearFactors(I, R, j, xs) ≠ P[0]
proof
  have oneIn : R[1] ∈ R by typecheck
  have coefficients := monicFactorCoefficients.closed with *
  have nonzero := polynomialFromHorner.nonzero_of_leading at I, A, add, zero, neg, mul, one, j, one, monicFactorCoefficients{A}(add, zero, neg, mul, xs) with *
  intro equal
  apply nonzero
  unfold polynomialLinearFactors at equal
  exact equal

end Factors
