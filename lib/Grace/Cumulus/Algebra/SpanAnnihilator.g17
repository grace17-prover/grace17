module Grace.Cumulus.Algebra.SpanAnnihilator
import SpanCoefficients
import LinearSpanMultiplication
import MonicRelations

section Algebras
variable (A add zero neg mul one B plus z minus times unit f G p : Set)
notation ring R := (A, add, zero, neg, mul, one)
notation ring S := (B, plus, z, minus, times, unit)
hypothesis source : IsCommRing(R)
hypothesis target : IsCommRing(S)
hypothesis hom : IsRingHom(f, R, S)
hypothesis bounded : G ⊆ S
hypothesis element : p ∈ S
hypothesis annihilates : ∀ g ∈ G, S[p * g] = S[0]

theorem linearSpan.annihilates (y : Set)
  requires member : y ∈ linearSpan(f, R, S, G)
  shows S[p * y] = S[0]
proof
  have zeroModule := Submodule.zero with *
  have products : ∀ g ∈ G, S[g * p] ∈ {S[0]}
    intros g hg
    have inB : g ∈ S by exact bounded with g, hg
    have vanishes := annihilates with g, hg
    have equal : S[g * p] = S[p * g] by ring
    rw [equal, vanishes]
    simp
  have multiplied := linearSpan.mul_mem with *
  have vanishes := singleton.membership.forward with multiplied
  have spanBound := linearSpan.subset at A, add, zero, neg, mul, one, B, plus, z, minus, times, unit, f, G with *
  have inB : y ∈ S by exact spanBound with y, member
  have equal : S[p * y] = S[y * p] by ring
  rwa equal

theorem linearSpan.annihilator_zero
  requires unitIn : S[1] ∈ linearSpan(f, R, S, G)
  shows p = S[0]
proof
  have vanishes := linearSpan.annihilates with *
  have equal : S[p * 1] = p by ring
  rwa equal at vanishes

end Algebras

section Relations
variable (A add zero neg mul one B plus z minus times unit f G x : Set)
notation ring R := (A, add, zero, neg, mul, one)
notation ring S := (B, plus, z, minus, times, unit)
hypothesis source : IsCommRing(R)
hypothesis target : IsCommRing(S)
hypothesis hom : IsRingHom(f, R, S)
hypothesis bounded : G ⊆ S
hypothesis element : x ∈ S
hypothesis unitIn : S[1] ∈ linearSpan(f, R, S, G)

theorem IntegralOver.of_annihilates_generators (cs : List(A))
  requires annihilates : ∀ g ∈ G, S[monicValue(R, f, S, x, cs) * g] = S[0]
  shows IntegralOver(f, R, S, x)
proof
  have value := monicValue.closed with *
  have relation := linearSpan.annihilator_zero with *
  unfold IntegralOver
  refine ⟨element, cs, assumption, relation⟩

end Relations
