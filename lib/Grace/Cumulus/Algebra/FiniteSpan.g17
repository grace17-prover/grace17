module Grace.Cumulus.Algebra.FiniteSpan
import SpanProduct

predicate FiniteSpan (f A B plus z minus times T : Set) :=
  ∃ G, Finite(G) ∧ G ⊆ T ∧ linearSpan(f, A, B, plus, z, minus, times, G) = T

notation scoped FiniteSpan(f, R, S, T) => FiniteSpan(f, R.carrier, S.carrier, S.add, S.zero, S.neg, S.mul, T)

section Algebras
variable (A add zero neg mul one B plus z minus times unit f : Set)
notation ring R := (A, add, zero, neg, mul, one)
notation ring S := (B, plus, z, minus, times, unit)
hypothesis source : IsCommRing(R)
hypothesis target : IsCommRing(S)
hypothesis hom : IsRingHom(f, R, S)

theorem FiniteSpan.target_iff
  shows FiniteSpan(f, R, S, S) ↔ FiniteAlgebraModule(f, R, S)
proof
  simp [FiniteSpan, FiniteAlgebraModule]

theorem linearSpan.unit
  shows linearSpan(f, R, S, {S[1]}) = algebraAdjoin(f, R, S, ∅)
proof
  have ordinary := IsCommRing.ring with target
  have multiplicative := IsRing.multiplicative with ordinary
  have unitIn := IsMonoid.unit_in_carrier with multiplicative
  have singletonBound : {S[1]} ⊆ S
    settle with Subset, singleton.membership
  have emptyBound : ∅ ⊆ S
    settle with Subset, set.empty
  have adjoined := algebraAdjoin.subalgebra with source, target, hom, emptyBound
  have submodule := Subalgebra.submodule with source, target, hom, adjoined
  have subring := Subalgebra.subring with source, target, hom, adjoined
  have unitMember := IsSubring.one_closed with subring
  have generators : {S[1]} ⊆ algebraAdjoin(f, R, S, ∅)
    settle with Subset, singleton.membership
  have first := linearSpan.least with source, target, hom, submodule, generators
  have span := linearSpan.submodule at A, add, zero, neg, mul, one, B, plus, z, minus, times, unit, f, {S[1]} with *
  have contains := linearSpan.contains with source, target, hom, singletonBound
  have inSpan : S[1] ∈ linearSpan(f, R, S, {S[1]})
    settle with Subset, singleton.membership
  have image := algebraAdjoin.empty at A, add, zero, neg, mul, one, B, plus, z, minus, times, unit, f with *
  have second : algebraAdjoin(f, R, S, ∅) ⊆ linearSpan(f, R, S, {S[1]})
    rw image
    intros b hb
    obtain ⟨inB, a, ha, value⟩ := functionImage.membership.forward at f, A, B, b with hb
    have mapped := IsRingHom.closed with hom, ha
    have scalar := Submodule.scalar_mul_mem with source, target, hom, span, ha, inSpan
    have equation : S[f(a) * 1] = f(a)
      ring
    rw equation at scalar
    rw value
    exact scalar
  exact Subset.antisymmetric with first, second

theorem FiniteSpan.empty_adjoin
  shows FiniteSpan(f, R, S, algebraAdjoin(f, R, S, ∅))
proof
  have spans := linearSpan.unit with *
  have finite := Finite.singleton at unit
  have ordinary := IsCommRing.ring with target
  have multiplicative := IsRing.multiplicative with ordinary
  have unitIn := IsMonoid.unit_in_carrier with multiplicative
  have bound : {S[1]} ⊆ S by simp [Subset, singleton.membership]
  have contains := linearSpan.contains with source, target, hom, bound
  rw spans at contains
  unfold FiniteSpan
  refine ⟨{S[1]}, finite, contains, spans⟩

theorem FiniteSpan.adjoin_union (U V : Set)
  requires boundedU : U ⊆ S
  requires boundedV : V ⊆ S
  requires finiteU : FiniteSpan(f, R, S, algebraAdjoin(f, R, S, U))
  requires finiteV : FiniteSpan(f, R, S, algebraAdjoin(f, R, S, V))
  shows FiniteSpan(f, R, S, algebraAdjoin(f, R, S, U ∪ V))
proof
  obtain ⟨G, finiteG, includedG, spansG⟩ := finiteU
  obtain ⟨H, finiteH, includedH, spansH⟩ := finiteV
  have subsetU := algebraAdjoin.subset at A, add, zero, neg, mul, one, B, plus, z, minus, times, unit, f, U with *
  have subsetV := algebraAdjoin.subset at A, add, zero, neg, mul, one, B, plus, z, minus, times, unit, f, V with *
  have boundedG := Subset.transitive with includedG, subsetU
  have boundedH := Subset.transitive with includedH, subsetV
  have finite := spanProducts.finite with source, target, hom, finiteG, finiteH, boundedG, boundedH
  have spans := linearSpan.product_adjoin with source, target, hom, boundedG, boundedH, boundedU, boundedV, spansG, spansH
  have bound := spanProducts.subset at B, times, G, H
  have contains := linearSpan.contains with source, target, hom, bound
  rw spans at contains
  unfold FiniteSpan
  refine ⟨spanProducts(B, times, G, H), finite, contains, spans⟩

end Algebras
