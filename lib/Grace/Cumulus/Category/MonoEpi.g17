module Grace.Cumulus.Category.MonoEpi
import Isomorphism

-- A monomorphism is left cancellable, an epimorphism right cancellable.
predicate Monomorphism (C f : Set) :=
  f ∈ mor(C) ∧ (∀ u ∈ mor(C), ∀ v ∈ mor(C), dom(C)(f) = cod(C)(u) → dom(C)(f) = cod(C)(v) →
    comp(C)(f, u) = comp(C)(f, v) → u = v)

predicate Epimorphism (C f : Set) :=
  f ∈ mor(C) ∧ (∀ u ∈ mor(C), ∀ v ∈ mor(C), dom(C)(u) = cod(C)(f) → dom(C)(v) = cod(C)(f) →
    comp(C)(u, f) = comp(C)(v, f) → u = v)

predicate Bimorphism (C f : Set) :=
  Monomorphism(C, f) ∧ Epimorphism(C, f)

notation infixr 70 "∘" => call2(C.comp, _, _) via hypothesis Monomorphism(C, f) for C.mor
notation infixr 70 "∘" => call2(C.comp, _, _) via hypothesis Epimorphism(C, f) for C.mor

-- r is a retraction of f (a left inverse), s a section of f (a right
-- inverse).
predicate Retraction (C f r : Set) :=
  f ∈ mor(C) ∧ r ∈ mor(C) ∧ dom(C)(r) = cod(C)(f) ∧ cod(C)(r) = dom(C)(f) ∧ comp(C)(r, f) = id(C)(dom(C)(f))

predicate SectionOf (C f s : Set) :=
  f ∈ mor(C) ∧ s ∈ mor(C) ∧ dom(C)(s) = cod(C)(f) ∧ cod(C)(s) = dom(C)(f) ∧ comp(C)(f, s) = id(C)(cod(C)(f))

notation infixr 70 "∘" => call2(C.comp, _, _) via hypothesis Retraction(C, f, r) for C.mor
notation infixr 70 "∘" => call2(C.comp, _, _) via hypothesis SectionOf(C, f, s) for C.mor

predicate SplitMonomorphism (C f : Set) :=
  ∃ r, Retraction(C, f, r)

predicate SplitEpimorphism (C f : Set) :=
  ∃ s, SectionOf(C, f, s)

theorem Monomorphism.morphism (C f : Set)
  requires mono : Monomorphism(C, f)
  shows f ∈ mor(C)
proof
  obtain ⟨fInM, cancel⟩ := mono
  exact fInM

theorem Monomorphism.cancel (C f u v : Set)
  requires mono : Monomorphism(C, f)
  requires uInM : u ∈ mor(C)
  requires vInM : v ∈ mor(C)
  requires uComposable : dom(C)(f) = cod(C)(u)
  requires vComposable : dom(C)(f) = cod(C)(v)
  requires same : f ∘ u = f ∘ v
  shows u = v
proof
  obtain ⟨fInM, cancel⟩ := mono
  exact cancel with u, uInM, v, vInM, uComposable, vComposable, same

theorem Epimorphism.morphism (C f : Set)
  requires epi : Epimorphism(C, f)
  shows f ∈ mor(C)
proof
  obtain ⟨fInM, cancel⟩ := epi
  exact fInM

theorem Epimorphism.cancel (C f u v : Set)
  requires epi : Epimorphism(C, f)
  requires uInM : u ∈ mor(C)
  requires vInM : v ∈ mor(C)
  requires uComposable : dom(C)(u) = cod(C)(f)
  requires vComposable : dom(C)(v) = cod(C)(f)
  requires same : u ∘ f = v ∘ f
  shows u = v
proof
  obtain ⟨fInM, cancel⟩ := epi
  exact cancel with u, uInM, v, vInM, uComposable, vComposable, same

theorem Bimorphism.mono (C f : Set)
  requires bi : Bimorphism(C, f)
  shows Monomorphism(C, f)
proof
  simp [Bimorphism]

theorem Bimorphism.epi (C f : Set)
  requires bi : Bimorphism(C, f)
  shows Epimorphism(C, f)
proof
  simp [Bimorphism]

theorem Monomorphism.id (C a : Set)
  requires category : Category(C)
  requires aInO : a ∈ obj(C)
  shows Monomorphism(C, id(C)(a))
proof
  have idInM := Category.id_closed with category, aInO
  have domId := Category.id_dom with category, aInO
  unfold Monomorphism
  refine ⟨idInM, ?_⟩
  intros u uInM v vInM uComposable vComposable same
  have uCod : cod(C)(u) = a by cc
  have vCod : cod(C)(v) = a by cc
  have unitU := Category.id_left_of_cod with category, uInM, uCod
  have unitV := Category.id_left_of_cod with category, vInM, vCod
  calc
    u = id(C)(a) ∘ u := by rw unitU
    _ = id(C)(a) ∘ v := same
    _ = v := unitV

theorem Epimorphism.id (C a : Set)
  requires category : Category(C)
  requires aInO : a ∈ obj(C)
  shows Epimorphism(C, id(C)(a))
proof
  have idInM := Category.id_closed with category, aInO
  have codId := Category.id_cod with category, aInO
  unfold Epimorphism
  refine ⟨idInM, ?_⟩
  intros u uInM v vInM uComposable vComposable same
  have uDom : dom(C)(u) = a by cc
  have vDom : dom(C)(v) = a by cc
  have unitU := Category.id_right_of_dom with category, uInM, uDom
  have unitV := Category.id_right_of_dom with category, vInM, vDom
  calc
    u = u ∘ id(C)(a) := by rw unitU
    _ = v ∘ id(C)(a) := same
    _ = v := unitV

section MonomorphismComposition
variable (C : Set)
hypothesis category : Category(C)

theorem Monomorphism.comp (a b c : Set) (f : a ⟶ b) (g : b ⟶ c)
  requires gMono : Monomorphism(C, g)
  requires fMono : Monomorphism(C, f)
  shows Monomorphism(C, g ∘ f)
proof
  have gfHom : g ∘ f : a ⟶ c by synthesize
  unfold Monomorphism
  refine ⟨?_, ?_⟩
  . assumption
  intros u uInM v vInM uComposable vComposable same
  have uHom : u : dom(C)(u) ⟶ a := Morphism.of_dom_cod with *
  have vHom : v : dom(C)(v) ⟶ a := Morphism.of_dom_cod with *
  have fuHom : f ∘ u : dom(C)(u) ⟶ b by synthesize
  have fvHom : f ∘ v : dom(C)(v) ⟶ b by synthesize
  have inner : g ∘ (f ∘ u) = g ∘ (f ∘ v)
    calc
      g ∘ (f ∘ u) = (g ∘ f) ∘ u := by rw Category.assoc
      _ = (g ∘ f) ∘ v := same
      _ = g ∘ (f ∘ v) := by rw Category.assoc
  have cancelled : f ∘ u = f ∘ v := Monomorphism.cancel with gMono, inner, *
  exact Monomorphism.cancel with fMono, cancelled, *

end MonomorphismComposition

theorem Epimorphism.comp (C g f : Set)
  requires category : Category(C)
  requires gEpi : Epimorphism(C, g)
  requires fEpi : Epimorphism(C, f)
  requires composable : dom(C)(g) = cod(C)(f)
  shows Epimorphism(C, g ∘ f)
proof
  have gInM := Epimorphism.morphism with gEpi
  have fInM := Epimorphism.morphism with fEpi
  have gfInM := Category.comp_closed with category, gInM, fInM, composable
  have codGF := Category.comp_cod with category, gInM, fInM, composable
  unfold Epimorphism
  refine ⟨gfInM, ?_⟩
  intros u uInM v vInM uComposable vComposable same
  have ugComposable : dom(C)(u) = cod(C)(g) by cc
  have vgComposable : dom(C)(v) = cod(C)(g) by cc
  have assocU := Category.associative with
    category, uInM, gInM, fInM, ugComposable, composable
  have assocV := Category.associative with
    category, vInM, gInM, fInM, vgComposable, composable
  have ugInM := Category.comp_closed with category, uInM, gInM, ugComposable
  have vgInM := Category.comp_closed with category, vInM, gInM, vgComposable
  have domUG := Category.comp_dom with category, uInM, gInM, ugComposable
  have domVG := Category.comp_dom with category, vInM, gInM, vgComposable
  have ugfComposable : dom(C)(u ∘ g) = cod(C)(f) by cc
  have vgfComposable : dom(C)(v ∘ g) = cod(C)(f) by cc
  have inner : (u ∘ g) ∘ f = (v ∘ g) ∘ f
    calc
      (u ∘ g) ∘ f = u ∘ (g ∘ f) := assocU
      _ = v ∘ (g ∘ f) := same
      _ = (v ∘ g) ∘ f := by rw assocV
  have cancelled := Epimorphism.cancel with
    fEpi, ugInM, vgInM, ugfComposable, vgfComposable, inner
  exact Epimorphism.cancel with
    gEpi, uInM, vInM, ugComposable, vgComposable, cancelled

-- If a composite is mono, so is its first factor; if it is epi, so is
-- its second factor.
theorem Monomorphism.of_comp (C g f : Set)
  requires category : Category(C)
  requires gInM : g ∈ mor(C)
  requires fInM : f ∈ mor(C)
  requires composable : dom(C)(g) = cod(C)(f)
  requires mono : Monomorphism(C, g ∘ f)
  shows Monomorphism(C, f)
proof
  have domGF := Category.comp_dom with category, gInM, fInM, composable
  unfold Monomorphism
  refine ⟨fInM, ?_⟩
  intros u uInM v vInM uComposable vComposable same
  have assocU := Category.associative with
    category, gInM, fInM, uInM, composable, uComposable
  have assocV := Category.associative with
    category, gInM, fInM, vInM, composable, vComposable
  have gfuComposable : dom(C)(g ∘ f) = cod(C)(u) by cc
  have gfvComposable : dom(C)(g ∘ f) = cod(C)(v) by cc
  have outer : (g ∘ f) ∘ u = (g ∘ f) ∘ v
    calc
      (g ∘ f) ∘ u = g ∘ (f ∘ u) := assocU
      _ = g ∘ (f ∘ v) := by rw same
      _ = (g ∘ f) ∘ v := by rw assocV
  exact Monomorphism.cancel with
    mono, uInM, vInM, gfuComposable, gfvComposable, outer

theorem Epimorphism.of_comp (C g f : Set)
  requires category : Category(C)
  requires gInM : g ∈ mor(C)
  requires fInM : f ∈ mor(C)
  requires composable : dom(C)(g) = cod(C)(f)
  requires epi : Epimorphism(C, g ∘ f)
  shows Epimorphism(C, g)
proof
  have codGF := Category.comp_cod with category, gInM, fInM, composable
  unfold Epimorphism
  refine ⟨gInM, ?_⟩
  intros u uInM v vInM uComposable vComposable same
  have assocU := Category.associative with
    category, uInM, gInM, fInM, uComposable, composable
  have assocV := Category.associative with
    category, vInM, gInM, fInM, vComposable, composable
  have ugfComposable : dom(C)(u) = cod(C)(g ∘ f) by cc
  have vgfComposable : dom(C)(v) = cod(C)(g ∘ f) by cc
  have outer : u ∘ (g ∘ f) = v ∘ (g ∘ f)
    calc
      u ∘ (g ∘ f) = (u ∘ g) ∘ f := by rw assocU
      _ = (v ∘ g) ∘ f := by rw same
      _ = v ∘ (g ∘ f) := assocV
  exact Epimorphism.cancel with
    epi, uInM, vInM, ugfComposable, vgfComposable, outer

theorem Retraction.morphism (C f r : Set)
  requires retraction : Retraction(C, f, r)
  shows f ∈ mor(C)
proof
  obtain ⟨fInM, rInM, domR, codR, law⟩ := retraction
  exact fInM

theorem Retraction.inverse_morphism (C f r : Set)
  requires retraction : Retraction(C, f, r)
  shows r ∈ mor(C)
proof
  obtain ⟨fInM, rInM, domR, codR, law⟩ := retraction
  exact rInM

theorem Retraction.law (C f r : Set)
  requires retraction : Retraction(C, f, r)
  shows r ∘ f = id(C)(dom(C)(f))
proof
  obtain ⟨fInM, rInM, domR, codR, law⟩ := retraction
  exact law

theorem SectionOf.morphism (C f s : Set)
  requires section : SectionOf(C, f, s)
  shows f ∈ mor(C)
proof
  obtain ⟨fInM, sInM, domS, codS, law⟩ := section
  exact fInM

theorem SectionOf.inverse_morphism (C f s : Set)
  requires section : SectionOf(C, f, s)
  shows s ∈ mor(C)
proof
  obtain ⟨fInM, sInM, domS, codS, law⟩ := section
  exact sInM

theorem SectionOf.law (C f s : Set)
  requires section : SectionOf(C, f, s)
  shows f ∘ s = id(C)(cod(C)(f))
proof
  obtain ⟨fInM, sInM, domS, codS, law⟩ := section
  exact law

-- A retraction of f is a morphism of which f is a section, and conversely.
theorem Retraction.section (C f r : Set)
  requires retraction : Retraction(C, f, r)
  shows SectionOf(C, r, f)
proof
  obtain ⟨fInM, rInM, domR, codR, law⟩ := retraction
  unfold SectionOf
  refine ⟨rInM, fInM, ?_, ?_, ?_⟩
  . cc
  . cc
  . cc

theorem SectionOf.retraction (C f s : Set)
  requires section : SectionOf(C, f, s)
  shows Retraction(C, s, f)
proof
  obtain ⟨fInM, sInM, domS, codS, law⟩ := section
  unfold Retraction
  refine ⟨sInM, fInM, ?_, ?_, ?_⟩
  . cc
  . cc
  . cc

theorem InversePair.retraction (C f g : Set)
  requires pair : InversePair(C, f, g)
  shows Retraction(C, f, g)
proof
  obtain ⟨fInM, gInM, domG, codG, leftLaw, rightLaw⟩ := pair
  unfold Retraction
  refine ⟨fInM, gInM, domG, codG, leftLaw⟩

theorem InversePair.section (C f g : Set)
  requires pair : InversePair(C, f, g)
  shows SectionOf(C, f, g)
proof
  obtain ⟨fInM, gInM, domG, codG, leftLaw, rightLaw⟩ := pair
  unfold SectionOf
  refine ⟨fInM, gInM, domG, codG, rightLaw⟩

theorem InversePair.of_retraction_section (C f g : Set)
  requires retraction : Retraction(C, f, g)
  requires section : SectionOf(C, f, g)
  shows InversePair(C, f, g)
proof
  obtain ⟨fInM, gInM, domG, codG, leftLaw⟩ := retraction
  have rightLaw := SectionOf.law with section
  unfold InversePair
  refine ⟨fInM, gInM, domG, codG, leftLaw, rightLaw⟩

theorem SplitMonomorphism.morphism (C f : Set)
  requires split : SplitMonomorphism(C, f)
  shows f ∈ mor(C)
proof
  obtain ⟨r, retraction⟩ := split
  exact Retraction.morphism with retraction

theorem SplitEpimorphism.morphism (C f : Set)
  requires split : SplitEpimorphism(C, f)
  shows f ∈ mor(C)
proof
  obtain ⟨s, section⟩ := split
  exact SectionOf.morphism with section

theorem SplitMonomorphism.of_retraction (C f r : Set)
  requires retraction : Retraction(C, f, r)
  shows SplitMonomorphism(C, f)
proof
  refine ⟨r, retraction⟩

theorem SplitEpimorphism.of_section (C f s : Set)
  requires section : SectionOf(C, f, s)
  shows SplitEpimorphism(C, f)
proof
  refine ⟨s, section⟩

theorem Isomorphism.split_mono (C f : Set)
  requires iso : Isomorphism(C, f)
  shows SplitMonomorphism(C, f)
proof
  obtain ⟨g, pair⟩ := iso
  have retraction := InversePair.retraction with pair
  exact SplitMonomorphism.of_retraction with retraction

theorem Isomorphism.split_epi (C f : Set)
  requires iso : Isomorphism(C, f)
  shows SplitEpimorphism(C, f)
proof
  obtain ⟨g, pair⟩ := iso
  have section := InversePair.section with pair
  exact SplitEpimorphism.of_section with section

-- Split monomorphisms are monomorphisms.
theorem Retraction.mono (C f r : Set)
  requires category : Category(C)
  requires retraction : Retraction(C, f, r)
  shows Monomorphism(C, f)
proof
  obtain ⟨fInM, rInM, domR, codR, law⟩ := retraction
  unfold Monomorphism
  refine ⟨fInM, ?_⟩
  intros u uInM v vInM uComposable vComposable same
  have unitU : id(C)(dom(C)(f)) ∘ u = u
    have unit := Category.left_unit with category, uInM
    rwa ← uComposable at unit
  have unitV : id(C)(dom(C)(f)) ∘ v = v
    have unit := Category.left_unit with category, vInM
    rwa ← vComposable at unit
  have assocU := Category.associative with
    category, rInM, fInM, uInM, domR, uComposable
  have assocV := Category.associative with
    category, rInM, fInM, vInM, domR, vComposable
  calc
    u = id(C)(dom(C)(f)) ∘ u := by rw unitU
    _ = (r ∘ f) ∘ u := by rw law
    _ = r ∘ (f ∘ u) := assocU
    _ = r ∘ (f ∘ v) := by rw same
    _ = (r ∘ f) ∘ v := by rw assocV
    _ = id(C)(dom(C)(f)) ∘ v := by rw law
    _ = v := unitV

theorem SplitMonomorphism.mono (C f : Set)
  requires category : Category(C)
  requires split : SplitMonomorphism(C, f)
  shows Monomorphism(C, f)
proof
  obtain ⟨r, retraction⟩ := split
  exact Retraction.mono with category, retraction

theorem SectionOf.epi (C f s : Set)
  requires category : Category(C)
  requires section : SectionOf(C, f, s)
  shows Epimorphism(C, f)
proof
  obtain ⟨fInM, sInM, domS, codS, law⟩ := section
  unfold Epimorphism
  refine ⟨fInM, ?_⟩
  intros u uInM v vInM uComposable vComposable same
  have unitU := Category.id_right_of_dom with category, uInM, uComposable
  have unitV := Category.id_right_of_dom with category, vInM, vComposable
  have fsComposable : dom(C)(f) = cod(C)(s) by cc
  have assocU := Category.associative with
    category, uInM, fInM, sInM, uComposable, fsComposable
  have assocV := Category.associative with
    category, vInM, fInM, sInM, vComposable, fsComposable
  calc
    u = u ∘ id(C)(cod(C)(f)) := by rw unitU
    _ = u ∘ (f ∘ s) := by rw law
    _ = (u ∘ f) ∘ s := by rw assocU
    _ = (v ∘ f) ∘ s := by rw same
    _ = v ∘ (f ∘ s) := assocV
    _ = v ∘ id(C)(cod(C)(f)) := by rw law
    _ = v := unitV

theorem SplitEpimorphism.epi (C f : Set)
  requires category : Category(C)
  requires split : SplitEpimorphism(C, f)
  shows Epimorphism(C, f)
proof
  obtain ⟨s, section⟩ := split
  exact SectionOf.epi with category, section

theorem Isomorphism.mono (C f : Set)
  requires category : Category(C)
  requires iso : Isomorphism(C, f)
  shows Monomorphism(C, f)
proof
  have split := Isomorphism.split_mono with iso
  exact SplitMonomorphism.mono with category, split

theorem Isomorphism.epi (C f : Set)
  requires category : Category(C)
  requires iso : Isomorphism(C, f)
  shows Epimorphism(C, f)
proof
  have split := Isomorphism.split_epi with iso
  exact SplitEpimorphism.epi with category, split

theorem Isomorphism.bimorphism (C f : Set)
  requires category : Category(C)
  requires iso : Isomorphism(C, f)
  shows Bimorphism(C, f)
proof
  have mono := Isomorphism.mono with category, iso
  have epi := Isomorphism.epi with category, iso
  unfold Bimorphism
  refine ⟨mono, epi⟩

-- A split monomorphism that is an epimorphism is an isomorphism, and its
-- retraction is its inverse.
theorem Retraction.inverse_of_epi (C f r : Set)
  requires category : Category(C)
  requires retraction : Retraction(C, f, r)
  requires epi : Epimorphism(C, f)
  shows InversePair(C, f, r)
proof
  obtain ⟨fInM, rInM, domR, codR, law⟩ := retraction
  have codIn := Category.cod_closed with category, fInM
  have idInM := Category.id_closed with category, codIn
  have domId := Category.id_dom with category, codIn
  have frComposable : dom(C)(f) = cod(C)(r) by cc
  have frInM := Category.comp_closed with category, fInM, rInM, frComposable
  have domFR := Category.comp_dom with category, fInM, rInM, frComposable
  have assoc := Category.associative with
    category, fInM, rInM, fInM, frComposable, domR
  have rightF := Category.right_unit with category, fInM
  have leftF := Category.left_unit with category, fInM
  have frfComposable : dom(C)(f ∘ r) = cod(C)(f) by cc
  have same : (f ∘ r) ∘ f = id(C)(cod(C)(f)) ∘ f
    calc
      (f ∘ r) ∘ f = f ∘ (r ∘ f) := assoc
      _ = f ∘ id(C)(dom(C)(f)) := by rw law
      _ = f := rightF
      _ = id(C)(cod(C)(f)) ∘ f := by rw leftF
  have rightLaw := Epimorphism.cancel with
    epi, frInM, idInM, frfComposable, domId, same
  unfold InversePair
  refine ⟨fInM, rInM, domR, codR, law, rightLaw⟩

theorem SplitMonomorphism.iso_of_epi (C f : Set)
  requires category : Category(C)
  requires split : SplitMonomorphism(C, f)
  requires epi : Epimorphism(C, f)
  shows Isomorphism(C, f)
proof
  obtain ⟨r, retraction⟩ := split
  have pair := Retraction.inverse_of_epi with category, retraction, epi
  exact Isomorphism.of_pair with pair

theorem SectionOf.inverse_of_mono (C f s : Set)
  requires category : Category(C)
  requires section : SectionOf(C, f, s)
  requires mono : Monomorphism(C, f)
  shows InversePair(C, f, s)
proof
  obtain ⟨fInM, sInM, domS, codS, law⟩ := section
  have domIn := Category.dom_closed with category, fInM
  have idInM := Category.id_closed with category, domIn
  have codId := Category.id_cod with category, domIn
  have sfInM := Category.comp_closed with category, sInM, fInM, domS
  have codSF := Category.comp_cod with category, sInM, fInM, domS
  have fsComposable : dom(C)(f) = cod(C)(s) by cc
  have assoc := Category.associative with
    category, fInM, sInM, fInM, fsComposable, domS
  have rightF := Category.right_unit with category, fInM
  have leftF := Category.left_unit with category, fInM
  have fsfComposable : dom(C)(f) = cod(C)(s ∘ f) by cc
  have fidComposable : dom(C)(f) = cod(C)(id(C)(dom(C)(f))) by cc
  have same : f ∘ (s ∘ f) = f ∘ id(C)(dom(C)(f))
    calc
      f ∘ (s ∘ f) = (f ∘ s) ∘ f := by rw assoc
      _ = id(C)(cod(C)(f)) ∘ f := by rw law
      _ = f := leftF
      _ = f ∘ id(C)(dom(C)(f)) := by rw rightF
  have leftLaw := Monomorphism.cancel with
    mono, sfInM, idInM, fsfComposable, fidComposable, same
  unfold InversePair
  refine ⟨fInM, sInM, domS, codS, leftLaw, law⟩

theorem SplitEpimorphism.iso_of_mono (C f : Set)
  requires category : Category(C)
  requires split : SplitEpimorphism(C, f)
  requires mono : Monomorphism(C, f)
  shows Isomorphism(C, f)
proof
  obtain ⟨s, section⟩ := split
  have pair := SectionOf.inverse_of_mono with category, section, mono
  exact Isomorphism.of_pair with pair

-- Split monomorphisms compose, and a first factor of a split mono is one.
theorem Retraction.comp (C g r f q : Set)
  requires category : Category(C)
  requires gRetraction : Retraction(C, g, r)
  requires fRetraction : Retraction(C, f, q)
  requires composable : dom(C)(g) = cod(C)(f)
  shows Retraction(C, g ∘ f, q ∘ r)
proof
  obtain ⟨gInM, rInM, domR, codR, rLaw⟩ := gRetraction
  obtain ⟨fInM, qInM, domQ, codQ, qLaw⟩ := fRetraction
  have qrComposable : dom(C)(q) = cod(C)(r) by cc
  have gfInM := Category.comp_closed with category, gInM, fInM, composable
  have qrInM := Category.comp_closed with category, qInM, rInM, qrComposable
  have domGF := Category.comp_dom with category, gInM, fInM, composable
  have codGF := Category.comp_cod with category, gInM, fInM, composable
  have domQR := Category.comp_dom with category, qInM, rInM, qrComposable
  have codQR := Category.comp_cod with category, qInM, rInM, qrComposable
  have fCod : cod(C)(f) = dom(C)(g) by cc
  have unitF := Category.id_left_of_cod with category, fInM, fCod
  have rgfComposable : dom(C)(r) = cod(C)(g ∘ f) by cc
  have assocOne := Category.associative with
    category, qInM, rInM, gfInM, qrComposable, rgfComposable
  have assocTwo := Category.associative with
    category, rInM, gInM, fInM, domR, composable
  unfold Retraction
  refine ⟨gfInM, qrInM, ?_, ?_, ?_⟩
  . cc
  . cc
  . calc
      (q ∘ r) ∘ (g ∘ f) = q ∘ (r ∘ (g ∘ f)) := assocOne
      _ = q ∘ ((r ∘ g) ∘ f) := by rw assocTwo
      _ = q ∘ (id(C)(dom(C)(g)) ∘ f) := by rw rLaw
      _ = q ∘ f := by rw unitF
      _ = id(C)(dom(C)(f)) := qLaw
      _ = id(C)(dom(C)(g ∘ f)) := by rw domGF

theorem SplitMonomorphism.comp (C g f : Set)
  requires category : Category(C)
  requires gSplit : SplitMonomorphism(C, g)
  requires fSplit : SplitMonomorphism(C, f)
  requires composable : dom(C)(g) = cod(C)(f)
  shows SplitMonomorphism(C, g ∘ f)
proof
  obtain ⟨r, gRetraction⟩ := gSplit
  obtain ⟨q, fRetraction⟩ := fSplit
  have retraction := Retraction.comp with
    category, gRetraction, fRetraction, composable
  exact SplitMonomorphism.of_retraction with retraction

theorem Retraction.of_comp (C g f r : Set)
  requires category : Category(C)
  requires gInM : g ∈ mor(C)
  requires fInM : f ∈ mor(C)
  requires composable : dom(C)(g) = cod(C)(f)
  requires retraction : Retraction(C, g ∘ f, r)
  shows Retraction(C, f, r ∘ g)
proof
  obtain ⟨gfInM, rInM, domR, codR, law⟩ := retraction
  have domGF := Category.comp_dom with category, gInM, fInM, composable
  have codGF := Category.comp_cod with category, gInM, fInM, composable
  have rgComposable : dom(C)(r) = cod(C)(g) by cc
  have rgInM := Category.comp_closed with category, rInM, gInM, rgComposable
  have domRG := Category.comp_dom with category, rInM, gInM, rgComposable
  have codRG := Category.comp_cod with category, rInM, gInM, rgComposable
  have assoc := Category.associative with
    category, rInM, gInM, fInM, rgComposable, composable
  unfold Retraction
  refine ⟨fInM, rgInM, ?_, ?_, ?_⟩
  . cc
  . cc
  . calc
      (r ∘ g) ∘ f = r ∘ (g ∘ f) := assoc
      _ = id(C)(dom(C)(g ∘ f)) := law
      _ = id(C)(dom(C)(f)) := by rw domGF

theorem SplitMonomorphism.of_comp (C g f : Set)
  requires category : Category(C)
  requires gInM : g ∈ mor(C)
  requires fInM : f ∈ mor(C)
  requires composable : dom(C)(g) = cod(C)(f)
  requires split : SplitMonomorphism(C, g ∘ f)
  shows SplitMonomorphism(C, f)
proof
  obtain ⟨r, retraction⟩ := split
  have factor := Retraction.of_comp with
    category, gInM, fInM, composable, retraction
  exact SplitMonomorphism.of_retraction with factor

-- Split epimorphisms compose, and a second factor of a split epi is one.
theorem SectionOf.comp (C g s f t : Set)
  requires category : Category(C)
  requires gSection : SectionOf(C, g, s)
  requires fSection : SectionOf(C, f, t)
  requires composable : dom(C)(g) = cod(C)(f)
  shows SectionOf(C, g ∘ f, t ∘ s)
proof
  obtain ⟨gInM, sInM, domS, codS, sLaw⟩ := gSection
  obtain ⟨fInM, tInM, domT, codT, tLaw⟩ := fSection
  have tsComposable : dom(C)(t) = cod(C)(s) by cc
  have gfInM := Category.comp_closed with category, gInM, fInM, composable
  have tsInM := Category.comp_closed with category, tInM, sInM, tsComposable
  have domGF := Category.comp_dom with category, gInM, fInM, composable
  have codGF := Category.comp_cod with category, gInM, fInM, composable
  have domTS := Category.comp_dom with category, tInM, sInM, tsComposable
  have codTS := Category.comp_cod with category, tInM, sInM, tsComposable
  have sCod : cod(C)(s) = cod(C)(f) by cc
  have unitS := Category.id_left_of_cod with category, sInM, sCod
  have ftsComposable : dom(C)(f) = cod(C)(t ∘ s) by cc
  have assocOne := Category.associative with
    category, gInM, fInM, tsInM, composable, ftsComposable
  have ftComposable : dom(C)(f) = cod(C)(t) by cc
  have assocTwo := Category.associative with
    category, fInM, tInM, sInM, ftComposable, tsComposable
  unfold SectionOf
  refine ⟨gfInM, tsInM, ?_, ?_, ?_⟩
  . cc
  . cc
  . calc
      (g ∘ f) ∘ (t ∘ s) = g ∘ (f ∘ (t ∘ s)) := assocOne
      _ = g ∘ ((f ∘ t) ∘ s) := by rw assocTwo
      _ = g ∘ (id(C)(cod(C)(f)) ∘ s) := by rw tLaw
      _ = g ∘ s := by rw unitS
      _ = id(C)(cod(C)(g)) := sLaw
      _ = id(C)(cod(C)(g ∘ f)) := by rw codGF

theorem SplitEpimorphism.comp (C g f : Set)
  requires category : Category(C)
  requires gSplit : SplitEpimorphism(C, g)
  requires fSplit : SplitEpimorphism(C, f)
  requires composable : dom(C)(g) = cod(C)(f)
  shows SplitEpimorphism(C, g ∘ f)
proof
  obtain ⟨s, gSection⟩ := gSplit
  obtain ⟨t, fSection⟩ := fSplit
  have section := SectionOf.comp with category, gSection, fSection, composable
  exact SplitEpimorphism.of_section with section

theorem SectionOf.of_comp (C g f s : Set)
  requires category : Category(C)
  requires gInM : g ∈ mor(C)
  requires fInM : f ∈ mor(C)
  requires composable : dom(C)(g) = cod(C)(f)
  requires section : SectionOf(C, g ∘ f, s)
  shows SectionOf(C, g, f ∘ s)
proof
  obtain ⟨gfInM, sInM, domS, codS, law⟩ := section
  have domGF := Category.comp_dom with category, gInM, fInM, composable
  have codGF := Category.comp_cod with category, gInM, fInM, composable
  have fsComposable : dom(C)(f) = cod(C)(s) by cc
  have fsInM := Category.comp_closed with category, fInM, sInM, fsComposable
  have domFS := Category.comp_dom with category, fInM, sInM, fsComposable
  have codFS := Category.comp_cod with category, fInM, sInM, fsComposable
  have assoc := Category.associative with
    category, gInM, fInM, sInM, composable, fsComposable
  unfold SectionOf
  refine ⟨gInM, fsInM, ?_, ?_, ?_⟩
  . cc
  . cc
  . calc
      g ∘ (f ∘ s) = (g ∘ f) ∘ s := by rw assoc
      _ = id(C)(cod(C)(g ∘ f)) := law
      _ = id(C)(cod(C)(g)) := by rw codGF

theorem SplitEpimorphism.of_comp (C g f : Set)
  requires category : Category(C)
  requires gInM : g ∈ mor(C)
  requires fInM : f ∈ mor(C)
  requires composable : dom(C)(g) = cod(C)(f)
  requires split : SplitEpimorphism(C, g ∘ f)
  shows SplitEpimorphism(C, g)
proof
  obtain ⟨s, section⟩ := split
  have factor := SectionOf.of_comp with
    category, gInM, fInM, composable, section
  exact SplitEpimorphism.of_section with factor

-- Monomorphisms and epimorphisms in hom-set form.
theorem Monomorphism.cancel_hom (C a b c f u v : Set)
  requires mono : Monomorphism(C, f)
  requires fHom : f ∈ hom(C, b, c)
  requires uHom : u ∈ hom(C, a, b)
  requires vHom : v ∈ hom(C, a, b)
  requires same : f ∘ u = f ∘ v
  shows u = v
proof
  have uInM := hom.in_morphisms with uHom
  have vInM := hom.in_morphisms with vHom
  have uComposable := hom.composable with fHom, uHom
  have vComposable := hom.composable with fHom, vHom
  exact Monomorphism.cancel with
    mono, uInM, vInM, uComposable, vComposable, same

theorem Epimorphism.cancel_hom (C a b c f u v : Set)
  requires epi : Epimorphism(C, f)
  requires fHom : f ∈ hom(C, a, b)
  requires uHom : u ∈ hom(C, b, c)
  requires vHom : v ∈ hom(C, b, c)
  requires same : u ∘ f = v ∘ f
  shows u = v
proof
  have uInM := hom.in_morphisms with uHom
  have vInM := hom.in_morphisms with vHom
  have uComposable := hom.composable with uHom, fHom
  have vComposable := hom.composable with vHom, fHom
  exact Epimorphism.cancel with epi, uInM, vInM, uComposable, vComposable, same
