module Grace.Cumulus.Category.HomFunctor
import SetMorphism

-- Post-composition with g : b ⟶ c, as the function hom(C, a, b) → hom(C, a, c)
-- sending f to g ∘ f.
defgraph postComposition (C a b c g : Set) (f ∈ hom(C, a, b)) : hom(C, a, c) := g ∘ f
requires category : Category(C)
requires gHom : g ∈ hom(C, b, c)
proof
  exact hom.comp with category, gHom, member

section PostComposition
variable (C a : Set)
hypothesis category : Category(C)

theorem postComposition.apply (b c : Set) (g : b ⟶ c) (f : Set)
  requires fHom : f ∈ hom(C, a, b)
  shows postComposition(C, a, b, c, g)(f) = g ∘ f
proof
  have gHom : g ∈ hom(C, b, c) := Morphism.hom with *
  exact postComposition.value with category, gHom, fHom

theorem postComposition.function_hom (b c g : Set)
  requires gHom : g ∈ hom(C, b, c)
  shows postComposition(C, a, b, c, g) : hom(C, a, b) → hom(C, a, c)
proof
  exact postComposition.function with category, gHom

-- Post-composition with an identity is the identity, and post-composition
-- with a composite is the composite of the post-compositions.
theorem postComposition.identity (b : Set)
  requires bInO : b ∈ obj(C)
  shows postComposition(C, a, b, b, id(C)(b)) = identity(hom(C, a, b))
proof
  have idHom := hom.id with category, bInO
  have idTyped : id(C)(b) : b ⟶ b := Morphism.of_hom with idHom
  have function : postComposition(C, a, b, b, id(C)(b)) : hom(C, a, b) → hom(C, a, b) :=
    postComposition.function_hom with category, idHom
  have identityFunction := identity.function at hom(C, a, b)
  apply FunctionBetween.ext with function, identityFunction
  intros f fHom
  have value := postComposition.apply with category, idTyped, fHom
  have unit := Category.id_left_hom with category, fHom
  have idValue := identity.apply with fHom
  rw [value, unit, idValue]
  rfl

theorem postComposition.compose (b c d g h : Set)
  requires hHom : h ∈ hom(C, c, d)
  requires gHom : g ∈ hom(C, b, c)
  shows postComposition(C, a, b, d, h ∘ g) =
    compose(postComposition(C, a, c, d, h), postComposition(C, a, b, c, g),
      hom(C, a, b), hom(C, a, c), hom(C, a, d))
proof
  have hgHom := hom.comp with category, hHom, gHom
  have hTyped : h : c ⟶ d := Morphism.of_hom with hHom
  have gTyped : g : b ⟶ c := Morphism.of_hom with gHom
  have hgTyped : h ∘ g : b ⟶ d := Morphism.of_hom with hgHom
  have composite : postComposition(C, a, b, d, h ∘ g) : hom(C, a, b) → hom(C, a, d) :=
    postComposition.function_hom with category, hgHom
  have hFunction : postComposition(C, a, c, d, h) : hom(C, a, c) → hom(C, a, d) :=
    postComposition.function_hom with category, hHom
  have gFunction : postComposition(C, a, b, c, g) : hom(C, a, b) → hom(C, a, c) :=
    postComposition.function_hom with category, gHom
  have composed := compose.function with gFunction, hFunction
  apply FunctionBetween.ext with composite, composed
  intros f fHom
  have gfHom := hom.comp with category, gHom, fHom
  have compositeValue := postComposition.apply with category, hgTyped, fHom
  have composedValue := compose.apply with gFunction, hFunction, fHom
  have gValue := postComposition.apply with category, gTyped, fHom
  have hValue := postComposition.apply with category, hTyped, gfHom
  have assoc := Category.assoc_hom with category, hHom, gHom, fHom
  rw [compositeValue, composedValue, gValue, hValue, assoc]
  rfl

end PostComposition

-- When the morphisms of C lie in U, every hom-set is an object of Sets(U).
theorem hom.object (C U a b : Set)
  requires small : mor(C) ⊆ U
  shows hom(C, a, b) ∈ 𝒫(U)
proof
  have subset := hom.subset at C, a, b
  have bounded := Subset.transitive with subset, small
  exact powerset.membership_iff.backward with bounded

-- The hom functor hom(a, −): an object b goes to the hom-set hom(C, a, b),
-- a morphism g to post-composition with g between the hom-sets at its
-- endpoints.
defgraph homObjects (C U a : Set) (b ∈ Category.obj(C)) : 𝒫(U) := hom(C, a, b)
requires small : mor(C) ⊆ U
proof
  exact hom.object with small

defgraph homMorphisms (C U a : Set) (g ∈ mor(C)) : setsMorphisms(U) :=
  setArrow(U, hom(C, a, cod(C)(g)),
    postComposition(C, a, dom(C)(g), cod(C)(g), g))
requires category : Category(C)
requires small : mor(C) ⊆ U
proof
  have gHom := hom.of_morphism at C, g with member
  have domIn := hom.object at C, U, a, dom(C)(g) with small
  have codIn := hom.object at C, U, a, cod(C)(g) with small
  have function := postComposition.function at
    C, a, dom(C)(g), cod(C)(g), g with category, gHom
  have mapIn := functionSpace.membership.backward with function
  exact setsMorphisms.arrow with domIn, codIn, mapIn

def homFunctor (C U a : Set) : Set :=
  Functor.mk(homObjects(C, U, a), homMorphisms(C, U, a), C, Sets(U))

section HomFunctor
variable (C U a : Set)
hypothesis category : Category(C)
hypothesis small : mor(C) ⊆ U

theorem homFunctor.obj (b : Set)
  requires bInO : b ∈ obj(C)
  shows obj(homFunctor(C, U, a))(b) = hom(C, a, b)
proof
  have value := homObjects.value at C, U, a, b with small, bInO
  simp [homFunctor, Functor.mk.obj, value]

theorem homFunctor.map (g : Set)
  requires gInM : g ∈ mor(C)
  shows map(homFunctor(C, U, a))(g) =
    setArrow(U, hom(C, a, cod(C)(g)), postComposition(C, a, dom(C)(g), cod(C)(g), g))
proof
  have value := homMorphisms.value at C, U, a, g with category, small, gInM
  simp [homFunctor, Functor.mk.map, value]

theorem homFunctor.map_hom (b c : Set) (g : b ⟶ c)
  shows map(homFunctor(C, U, a))(g) = setArrow(U, hom(C, a, c), postComposition(C, a, b, c, g))
proof
  have gHom : g ∈ hom(C, b, c) := Morphism.hom with *
  obtain ⟨gInM, domG, codG⟩ := hom.membership.forward with gHom
  have value := homFunctor.map at C, U, a, g with category, small, gInM
  rw [domG, codG] at value
  exact value

-- The image of g : b ⟶ c is a morphism hom(C, a, b) ⟶ hom(C, a, c) of Sets(U).
instance homFunctor.map_typed (b c ∈ obj(C)) (g : b ⟶ c)
  shows Morphism(Sets(U), map(homFunctor(C, U, a))(g), hom(C, a, b), hom(C, a, c))
proof
  have sets := Sets.category at U
  have gHomSet : g ∈ hom(C, b, c) := Morphism.hom with *
  have homB := hom.object at C, U, a, b with small
  have homC := hom.object at C, U, a, c with small
  have function := postComposition.function_hom at C, a, b, c, g with category, gHomSet
  have arrow := Sets.arrow_hom with sets, homB, homC, function
  rw homFunctor.map_hom
  exact arrow

theorem homFunctor.object_function
  shows obj(homFunctor(C, U, a)) : obj(C) → obj(Sets(U))
proof
  have function := homObjects.function at C, U, a with small
  unfold homFunctor
  rw [Functor.mk.obj, Sets.obj]
  exact function

theorem homFunctor.morphism_function
  shows map(homFunctor(C, U, a)) : mor(C) → mor(Sets(U))
proof
  have function := homMorphisms.function at C, U, a with category, small
  unfold homFunctor
  rw [Functor.mk.map, Sets.mor]
  exact function

theorem homFunctor.functor
  requires aInO : a ∈ obj(C)
  shows homFunctor(C, U, a) : C ⥤ Sets(U)
proof
  have sets := Sets.category at U
  have srcLaw : src(homFunctor(C, U, a)) = C
    simp [homFunctor, Functor.mk.src]
  have tgtLaw : tgt(homFunctor(C, U, a)) = Sets(U)
    simp [homFunctor, Functor.mk.tgt]
  have objects := homFunctor.object_function at C, U, a with category, small
  have morphisms := homFunctor.morphism_function at C, U, a with category, small
  have shape : Functor.Data(homFunctor(C, U, a)) by simp [homFunctor, Functor.mk.data]
  unfold Functor
  refine ⟨shape, category, sets, objects, morphisms, ?_, ?_, ?_, srcLaw, tgtLaw⟩
  . intros b bIn c cIn g gHom
    have gHomSet : g ∈ hom(C, b, c) := Morphism.hom with gHom
    have homB := hom.object at C, U, a, b with small
    have homC := hom.object at C, U, a, c with small
    have function := postComposition.function_hom at C, a, b, c, g with category, gHomSet
    have arrow := Sets.arrow_hom with sets, homB, homC, function
    rw [homFunctor.obj, homFunctor.obj, homFunctor.map_hom]
    exact arrow
  . intros b bIn
    have idHom := hom.id with category, bIn
    have homB := hom.object at C, U, a, b with small
    have identityValue := setsIdentity.value with homB
    have postIdentity := postComposition.identity at C, a, b with category, bIn
    rw [homFunctor.obj, homFunctor.map_hom, postIdentity, Sets.id, identityValue]
    rfl
  . intros b bIn c cIn d dIn f fHom g gHom
    have fHomSet : f ∈ hom(C, b, c) := Morphism.hom with fHom
    have gHomSet : g ∈ hom(C, c, d) := Morphism.hom with gHom
    have gfHomSet : g ∘ f ∈ hom(C, b, d) := hom.comp with category, gHomSet, fHomSet
    have homB := hom.object at C, U, a, b with small
    have homC := hom.object at C, U, a, c with small
    have homD := hom.object at C, U, a, d with small
    have fFunction := postComposition.function_hom at C, a, b, c, f with category, fHomSet
    have gFunction := postComposition.function_hom at C, a, c, d, g with category, gHomSet
    have fMapIn := functionSpace.membership.backward with fFunction
    have gMapIn := functionSpace.membership.backward with gFunction
    have composite := setsComposition.arrow with homB, homC, homD, fMapIn, gMapIn
    have postComposite := postComposition.compose at C, a, b, c, d, f, g with category, gHomSet, fHomSet
    rw [homFunctor.map_hom, homFunctor.map_hom, homFunctor.map_hom, postComposite]
    rw [Sets.comp, composite]
    rfl

end HomFunctor

-- The contravariant hom functor hom(−, a) is the hom functor of the
-- opposite category.
theorem homFunctor.contravariant (C U a : Set)
  requires category : Category(C)
  requires small : mor(C) ⊆ U
  requires aInO : a ∈ obj(C)
  shows homFunctor(opposite(C), U, a) : opposite(C) ⥤ Sets(U)
proof
  have opposite := Category.opposite with category
  have smallOpposite : mor(opposite(C)) ⊆ U by opposite_projections
  have aInOpposite : a ∈ obj(opposite(C)) by opposite_projections
  exact homFunctor.functor with opposite, smallOpposite, aInOpposite
