module Grace.Cumulus.Category.Opposite
import Natural

-- The opposite category keeps the objects and morphisms, swaps dom and
-- cod, and composes in the reverse order: the opposite composite of
-- (g, f) with cod(C)(g) = dom(C)(f) is comp(C)(f, g).
def oppositePairs (C : Set) : Set := composablePairsOf(mor(C), cod(C), dom(C))

def oppositeComposition (C : Set) : Set :=
  { p ∈ oppositePairs(C) × mor(C) |
    ∃ g ∈ mor(C), ∃ f ∈ mor(C), p = ((g, f) ↦ comp(C)(f, g)) ∧
      cod(C)(g) = dom(C)(f) }

def opposite (C : Set) : Set :=
  Category.mk(Category.obj(C), mor(C), cod(C), dom(C), id(C), oppositeComposition(C))

theorem oppositePairs.membership (C p : Set)
  shows p ∈ oppositePairs(C) ↔ (p ∈ mor(C) × mor(C) ∧
    ∃ g ∈ mor(C), ∃ f ∈ mor(C), p = (g, f) ∧ cod(C)(g) = dom(C)(f))
proof
  simp [oppositePairs]
  exact composablePairsOf.membership at mor(C), cod(C), dom(C), p

theorem oppositePairs.pair (C g f : Set)
  requires gInM : g ∈ mor(C)
  requires fInM : f ∈ mor(C)
  requires composable : cod(C)(g) = dom(C)(f)
  shows (g, f) ∈ oppositePairs(C)
proof
  apply oppositePairs.membership.backward
  constructor
  . exact product.pair with gInM, fInM
  . refine ⟨g, gInM, f, fInM, rfl, composable⟩

theorem opposite.obj (C : Set)
  shows obj(opposite(C)) = Category.obj(C)
proof
  simp [opposite, Category.mk.obj]

theorem opposite.mor (C : Set)
  shows mor(opposite(C)) = mor(C)
proof
  simp [opposite, Category.mk.mor]

theorem opposite.dom (C : Set)
  shows dom(opposite(C)) = cod(C)
proof
  simp [opposite, Category.mk.dom]

theorem opposite.cod (C : Set)
  shows cod(opposite(C)) = dom(C)
proof
  simp [opposite, Category.mk.cod]

theorem opposite.comp (C : Set)
  shows comp(opposite(C)) = oppositeComposition(C)
proof
  simp [opposite, Category.mk.comp]

theorem opposite.id (C : Set)
  shows id(opposite(C)) = id(C)
proof
  simp [opposite, Category.mk.id]

theorem opposite.projections (C : Set)
  shows obj(opposite(C)) = Category.obj(C) ∧ mor(opposite(C)) = mor(C) ∧
    dom(opposite(C)) = cod(C) ∧ cod(opposite(C)) = dom(C) ∧
    comp(opposite(C)) = oppositeComposition(C) ∧ id(opposite(C)) = id(C)
proof
  refine ⟨opposite.obj at C, opposite.mor at C, opposite.dom at C, opposite.cod at C,
    opposite.comp at C, opposite.id at C⟩

-- The projections of the opposite as one rewrite set, for equational goals.
tactic opposite_projections := simp [opposite.obj, opposite.mor, opposite.dom, opposite.cod, opposite.comp, opposite.id]

theorem composablePairs.opposite (C : Set)
  shows composablePairs(opposite(C)) = oppositePairs(C)
proof
  simp [composablePairs, oppositePairs, opposite.mor, opposite.dom, opposite.cod]

theorem oppositePairs.opposite (C : Set)
  shows oppositePairs(opposite(C)) = composablePairs(C)
proof
  simp [composablePairs, oppositePairs, opposite.mor, opposite.dom, opposite.cod]

-- Hom-sets of the opposite are the reversed hom-sets.
theorem hom.opposite (C a b : Set)
  shows hom(opposite(C), a, b) = hom(C, b, a)
proof
  ext f
  constructor
  . intro member
    obtain ⟨fInM, codF, domF⟩ := hom.membership.forward with member
    simp [opposite.obj, opposite.mor, opposite.dom, opposite.cod, opposite.comp, opposite.id] at fInM
    simp [opposite.obj, opposite.mor, opposite.dom, opposite.cod, opposite.comp, opposite.id] at codF
    simp [opposite.obj, opposite.mor, opposite.dom, opposite.cod, opposite.comp, opposite.id] at domF
    apply hom.membership.backward
    refine ⟨fInM, domF, codF⟩
  . intro member
    obtain ⟨fInM, domF, codF⟩ := hom.membership.forward with member
    apply hom.membership.backward
    rw [opposite.mor, opposite.dom, opposite.cod]
    refine ⟨fInM, codF, domF⟩

section OppositeLaws
variable (C : Set)
hypothesis category : Category(C)

theorem oppositeComposition.relates (g f : Set)
  requires gInM : g ∈ mor(C)
  requires fInM : f ∈ mor(C)
  requires composable : cod(C)(g) = dom(C)(f)
  shows relates(oppositeComposition(C), (g, f), f ∘ g)
proof
  have reversed : dom(C)(f) = cod(C)(g) by cc
  have valueIn := Category.comp_closed with category, fInM, gInM, reversed
  have pairIn := oppositePairs.pair with gInM, fInM, composable
  unfold relates
  apply oppositeComposition.membership.backward
  constructor
  . exact product.pair with pairIn, valueIn
  . refine ⟨g, gInM, f, fInM, rfl, composable⟩

theorem oppositeComposition.function
  shows oppositeComposition(C) : oppositePairs(C) → mor(C)
proof
  unfold FunctionBetween
  refine ⟨?_, ?_, ?_⟩
  . intros p member
    obtain ⟨bounded, rest⟩ := oppositeComposition.membership.forward with member
    exact bounded
  . intros x y xy z xz
    unfold relates at xy
    obtain ⟨_, g, gInM, f, fInM, firstShape, firstComposable⟩ :=
      oppositeComposition.membership.forward with xy
    unfold relates at xz
    obtain ⟨_, k, kInM, h, hInM, secondShape, secondComposable⟩ :=
      oppositeComposition.membership.forward with xz
    obtain ⟨firstPair, yValue⟩ := orderedPair.injective with firstShape
    obtain ⟨secondPair, zValue⟩ := orderedPair.injective with secondShape
    have samePair : (g, f) = (k, h) by cc
    obtain ⟨gk, fh⟩ := orderedPair.injective with samePair
    cc
  . intros p member
    obtain ⟨bounded, g, gInM, f, fInM, shape, composable⟩ :=
      oppositePairs.membership.forward with member
    have reversed : dom(C)(f) = cod(C)(g) by cc
    have valueIn := Category.comp_closed with category, fInM, gInM, reversed
    have related := oppositeComposition.relates with
      category, gInM, fInM, composable
    refine ⟨f ∘ g, valueIn, ?_⟩
    rw shape
    exact related

theorem oppositeComposition.apply (g f : Set)
  requires gInM : g ∈ mor(C)
  requires fInM : f ∈ mor(C)
  requires composable : cod(C)(g) = dom(C)(f)
  shows oppositeComposition(C)(g, f) = f ∘ g
proof
  have function := oppositeComposition.function with category
  have pairIn := oppositePairs.pair with gInM, fInM, composable
  have related := oppositeComposition.relates with
    category, gInM, fInM, composable
  have value := FunctionBetween.apply_value with function, pairIn, related
  unfold call2
  cc

theorem Category.opposite
  shows Category(opposite(C))
proof
  have domF := Category.dom_function with category
  have codF := Category.cod_function with category
  have idF := Category.id_function with category
  have compF := oppositeComposition.function with category
  have shape : Category.Data(opposite(C)) by simp [opposite, Category.mk.data]
  have pairs : composablePairsOf(mor(C), cod(C), dom(C)) = oppositePairs(C)
    have reversed := composablePairs.opposite at C
    simp [composablePairs, opposite.mor, opposite.dom, opposite.cod] at reversed
    exact reversed
  obtain ⟨objE, morE, domE, codE, compE, idE⟩ := opposite.projections at C
  unfold Category
  rw under objE
  rw under morE
  rw under domE
  rw under codE
  rw under compE
  rw under idE
  rw pairs
  refine ⟨shape, codF, domF, idF, compF, ?_, ?_, ?_, ?_⟩
  . intros a aInO
    have domId := Category.id_dom with category, aInO
    have codId := Category.id_cod with category, aInO
    refine ⟨codId, domId⟩
  . intros g gInM f fInM composable
    have value := oppositeComposition.apply with
      category, gInM, fInM, composable
    have reversed : dom(C)(f) = cod(C)(g) by cc
    have domValue := Category.comp_dom with category, fInM, gInM, reversed
    have codValue := Category.comp_cod with category, fInM, gInM, reversed
    rw value
    refine ⟨codValue, domValue⟩
  . intros f fInM
    have domIn := Category.dom_closed with category, fInM
    have codIn := Category.cod_closed with category, fInM
    have idDomIn := Category.id_closed with category, domIn
    have idCodIn := Category.id_closed with category, codIn
    have domIdCod := Category.id_cod with category, domIn
    have codIdDom := Category.id_dom with category, codIn
    have leftComposable : cod(C)(id(C)(dom(C)(f))) = dom(C)(f) by cc
    have rightComposable : cod(C)(f) = dom(C)(id(C)(cod(C)(f))) by cc
    have leftValue := oppositeComposition.apply with
      category, idDomIn, fInM, leftComposable
    have rightValue := oppositeComposition.apply with
      category, fInM, idCodIn, rightComposable
    have leftUnit := Category.left_unit with category, fInM
    have rightUnit := Category.right_unit with category, fInM
    rw [leftValue, rightValue]
    refine ⟨rightUnit, leftUnit⟩
  . intros h hInM g gInM f fInM outer inner
    have gh : dom(C)(g) = cod(C)(h) by cc
    have fg : dom(C)(f) = cod(C)(g) by cc
    have ghIn := Category.comp_closed with category, gInM, hInM, gh
    have fgIn := Category.comp_closed with category, fInM, gInM, fg
    have codGH := Category.comp_cod with category, gInM, hInM, gh
    have domFG := Category.comp_dom with category, fInM, gInM, fg
    have hgValue := oppositeComposition.apply with category, hInM, gInM, outer
    have gfValue := oppositeComposition.apply with category, gInM, fInM, inner
    have outerComposable : cod(C)(g ∘ h) = dom(C)(f) by cc
    have innerComposable : cod(C)(h) = dom(C)(f ∘ g) by cc
    have leftValue := oppositeComposition.apply with
      category, ghIn, fInM, outerComposable
    have rightValue := oppositeComposition.apply with
      category, hInM, fgIn, innerComposable
    have assoc := Category.associative with category, fInM, gInM, hInM, fg, gh
    rw [hgValue, gfValue, leftValue, rightValue]
    symm
    exact assoc

theorem InversePair.opposite (f g : Set)
  requires pair : InversePair(C, f, g)
  shows InversePair(opposite(C), f, g)
proof
  obtain ⟨fInM, gInM, domG, codG, leftLaw, rightLaw⟩ := pair
  have gfComposable : cod(C)(g) = dom(C)(f) by cc
  have fgComposable : cod(C)(f) = dom(C)(g) by cc
  have gfValue := oppositeComposition.apply with
    category, gInM, fInM, gfComposable
  have fgValue := oppositeComposition.apply with
    category, fInM, gInM, fgComposable
  unfold InversePair
  rw [opposite.mor, opposite.dom, opposite.cod, opposite.comp, opposite.id]
  refine ⟨fInM, gInM, codG, domG, ?_, ?_⟩
  . rw gfValue
    exact rightLaw
  . rw fgValue
    exact leftLaw

theorem InversePair.of_opposite (f g : Set)
  requires pair : InversePair(opposite(C), f, g)
  shows InversePair(C, f, g)
proof
  unfold InversePair at pair
  rw [opposite.mor, opposite.dom, opposite.cod, opposite.comp, opposite.id] at pair
  obtain ⟨fInM, gInM, codG, domG, leftLaw, rightLaw⟩ := pair
  have gfComposable : cod(C)(g) = dom(C)(f) by cc
  have fgComposable : cod(C)(f) = dom(C)(g) by cc
  have gfValue := oppositeComposition.apply with
    category, gInM, fInM, gfComposable
  have fgValue := oppositeComposition.apply with
    category, fInM, gInM, fgComposable
  rw gfValue at leftLaw
  rw fgValue at rightLaw
  unfold InversePair
  refine ⟨fInM, gInM, domG, codG, rightLaw, leftLaw⟩

theorem Isomorphism.opposite (f : Set)
  shows Isomorphism(C, f) ↔ Isomorphism(opposite(C), f)
proof
  constructor
  . intro iso
    obtain ⟨g, pair⟩ := iso
    have opposite := InversePair.opposite with category, pair
    exact Isomorphism.of_pair with opposite
  . intro iso
    obtain ⟨g, pair⟩ := iso
    have original := InversePair.of_opposite with category, pair
    exact Isomorphism.of_pair with original

theorem Isomorphic.opposite (a b : Set)
  shows Isomorphic(C, a, b) ↔ Isomorphic(opposite(C), b, a)
proof
  have homs := hom.opposite at C, b, a
  constructor
  . intro iso
    obtain ⟨f, fHom, fIso⟩ := iso
    have oppositeIso := Isomorphism.opposite at C, f with category
    have fIsoOpposite := oppositeIso.forward with fIso
    rw ← homs at fHom
    exact Isomorphic.of_hom with fHom, fIsoOpposite
  . intro iso
    obtain ⟨f, fHom, fIso⟩ := iso
    have oppositeIso := Isomorphism.opposite at C, f with category
    have fIsoOriginal := oppositeIso.backward with fIso
    rw homs at fHom
    exact Isomorphic.of_hom with fHom, fIsoOriginal

-- Monomorphisms of a category are the epimorphisms of its opposite.
theorem Monomorphism.opposite (f : Set)
  shows Monomorphism(C, f) ↔ Epimorphism(opposite(C), f)
proof
  constructor
  . intro mono
    have fInM := Monomorphism.morphism with mono
    obtain ⟨objE, morE, domE, codE, compE, idE⟩ := opposite.projections at C
    unfold Epimorphism
    rw under morE
    rw under domE
    rw under codE
    rw under compE
    refine ⟨fInM, ?_⟩
    intros u uInM v vInM uComposable vComposable same
    have uValue := oppositeComposition.apply with
      category, uInM, fInM, uComposable
    have vValue := oppositeComposition.apply with
      category, vInM, fInM, vComposable
    have uReversed : dom(C)(f) = cod(C)(u) by cc
    have vReversed : dom(C)(f) = cod(C)(v) by cc
    have original : f ∘ u = f ∘ v by cc
    exact Monomorphism.cancel with
      mono, uInM, vInM, uReversed, vReversed, original
  . intro epi
    obtain ⟨objE, morE, domE, codE, compE, idE⟩ := opposite.projections at C
    unfold Epimorphism at epi
    rw under morE at epi
    rw under domE at epi
    rw under codE at epi
    rw under compE at epi
    obtain ⟨fInM, cancel⟩ := epi
    unfold Monomorphism
    refine ⟨fInM, ?_⟩
    intros u uInM v vInM uComposable vComposable same
    have uReversed : cod(C)(u) = dom(C)(f) by cc
    have vReversed : cod(C)(v) = dom(C)(f) by cc
    have uValue := oppositeComposition.apply with
      category, uInM, fInM, uReversed
    have vValue := oppositeComposition.apply with
      category, vInM, fInM, vReversed
    have opposite : oppositeComposition(C)(u, f) =
        oppositeComposition(C)(v, f) by cc
    exact cancel with u, uInM, v, vInM, uReversed, vReversed, opposite

theorem Epimorphism.opposite (f : Set)
  shows Epimorphism(C, f) ↔ Monomorphism(opposite(C), f)
proof
  constructor
  . intro epi
    have fInM := Epimorphism.morphism with epi
    obtain ⟨objE, morE, domE, codE, compE, idE⟩ := opposite.projections at C
    unfold Monomorphism
    rw under morE
    rw under domE
    rw under codE
    rw under compE
    refine ⟨fInM, ?_⟩
    intros u uInM v vInM uComposable vComposable same
    have uValue := oppositeComposition.apply with
      category, fInM, uInM, uComposable
    have vValue := oppositeComposition.apply with
      category, fInM, vInM, vComposable
    have uReversed : dom(C)(u) = cod(C)(f) by cc
    have vReversed : dom(C)(v) = cod(C)(f) by cc
    have original : u ∘ f = v ∘ f by cc
    exact Epimorphism.cancel with
      epi, uInM, vInM, uReversed, vReversed, original
  . intro mono
    obtain ⟨objE, morE, domE, codE, compE, idE⟩ := opposite.projections at C
    unfold Monomorphism at mono
    rw under morE at mono
    rw under domE at mono
    rw under codE at mono
    rw under compE at mono
    obtain ⟨fInM, cancel⟩ := mono
    unfold Epimorphism
    refine ⟨fInM, ?_⟩
    intros u uInM v vInM uComposable vComposable same
    have uReversed : cod(C)(f) = dom(C)(u) by cc
    have vReversed : cod(C)(f) = dom(C)(v) by cc
    have uValue := oppositeComposition.apply with
      category, fInM, uInM, uReversed
    have vValue := oppositeComposition.apply with
      category, fInM, vInM, vReversed
    have opposite : oppositeComposition(C)(f, u) =
        oppositeComposition(C)(f, v) by cc
    exact cancel with u, uInM, v, vInM, uReversed, vReversed, opposite

theorem Retraction.opposite (f r : Set)
  requires retraction : Retraction(C, f, r)
  shows SectionOf(opposite(C), f, r)
proof
  obtain ⟨fInM, rInM, domR, codR, law⟩ := retraction
  have composable : cod(C)(f) = dom(C)(r) by cc
  have value := oppositeComposition.apply with category, fInM, rInM, composable
  unfold SectionOf
  rw [opposite.mor, opposite.dom, opposite.cod, opposite.comp, opposite.id]
  refine ⟨fInM, rInM, codR, domR, ?_⟩
  rw value
  exact law

theorem SectionOf.opposite (f s : Set)
  requires section : SectionOf(C, f, s)
  shows Retraction(opposite(C), f, s)
proof
  obtain ⟨fInM, sInM, domS, codS, law⟩ := section
  have composable : cod(C)(s) = dom(C)(f) by cc
  have value := oppositeComposition.apply with category, sInM, fInM, composable
  unfold Retraction
  rw [opposite.mor, opposite.dom, opposite.cod, opposite.comp, opposite.id]
  refine ⟨fInM, sInM, codS, domS, ?_⟩
  rw value
  exact law

-- Terminal objects of a category are the initial objects of its opposite.
theorem Terminal.opposite (t : Set)
  shows Terminal(C, t) ↔ Initial(opposite(C), t)
proof
  constructor
  . intro terminal
    obtain ⟨tInO, universal⟩ := terminal
    have objE := opposite.obj at C
    unfold Initial
    rw under objE
    refine ⟨tInO, ?_⟩
    intros a aInO
    have homs := hom.opposite at C, t, a
    obtain ⟨f, fHom, unique⟩ := universal with a, aInO
    refine ⟨f, ?_, ?_⟩
    . rw homs
      exact fHom
    . intros g gHom
      rw homs at gHom
      exact unique with g, gHom
  . intro initial
    have objE := opposite.obj at C
    unfold Initial at initial
    rw under objE at initial
    obtain ⟨tInO, universal⟩ := initial
    unfold Terminal
    refine ⟨tInO, ?_⟩
    intros a aInO
    have homs := hom.opposite at C, t, a
    obtain ⟨f, fHom, unique⟩ := universal with a, aInO
    refine ⟨f, ?_, ?_⟩
    . rw ← homs
      exact fHom
    . intros g gHom
      rw ← homs at gHom
      exact unique with g, gHom

theorem Initial.opposite (i : Set)
  shows Initial(C, i) ↔ Terminal(opposite(C), i)
proof
  constructor
  . intro initial
    obtain ⟨iInO, universal⟩ := initial
    have objE := opposite.obj at C
    unfold Terminal
    rw under objE
    refine ⟨iInO, ?_⟩
    intros a aInO
    have homs := hom.opposite at C, a, i
    obtain ⟨f, fHom, unique⟩ := universal with a, aInO
    refine ⟨f, ?_, ?_⟩
    . rw homs
      exact fHom
    . intros g gHom
      rw homs at gHom
      exact unique with g, gHom
  . intro terminal
    have objE := opposite.obj at C
    unfold Terminal at terminal
    rw under objE at terminal
    obtain ⟨iInO, universal⟩ := terminal
    unfold Initial
    refine ⟨iInO, ?_⟩
    intros a aInO
    have homs := hom.opposite at C, a, i
    obtain ⟨f, fHom, unique⟩ := universal with a, aInO
    refine ⟨f, ?_, ?_⟩
    . rw ← homs
      exact fHom
    . intros g gHom
      rw ← homs at gHom
      exact unique with g, gHom

-- The opposite of the opposite composes as the original category.
theorem oppositeComposition.involutive
  shows oppositeComposition(opposite(C)) = comp(C)
proof
  have opposite := Category.opposite with category
  have doubleFunction := oppositeComposition.function with opposite
  have compFunction := Category.comp_function with category
  have pairs := oppositePairs.opposite at C
  rw [pairs, opposite.mor] at doubleFunction
  apply FunctionBetween.ext with doubleFunction, compFunction
  intros p member
  obtain ⟨bounded, g, gInM, f, fInM, shape, composable⟩ :=
    composablePairs.membership.forward with member
  have reversed : cod(C)(f) = dom(C)(g) by cc
  have innerValue := oppositeComposition.apply with
    category, fInM, gInM, reversed
  have gInOpposite : g ∈ mor(opposite(C))
    rw opposite.mor
    exact gInM
  have fInOpposite : f ∈ mor(opposite(C))
    rw opposite.mor
    exact fInM
  have oppositeComposable : cod(opposite(C))(g) = dom(opposite(C))(f)
    rw [opposite.cod, opposite.dom]
    exact composable
  have outerValue := oppositeComposition.apply with
    opposite, gInOpposite, fInOpposite, oppositeComposable
  rw opposite.comp at outerValue
  rw shape
  unfold call2 at outerValue
  rw outerValue
  simp [call2] at innerValue
  simp [call2, innerValue]

end OppositeLaws

-- A functor between categories is a functor between their opposites.
def oppositeFunctor (F : Set) : Set :=
  Functor.mk(Functor.obj(F), Functor.map(F), opposite(src(F)), opposite(tgt(F)))

section OppositeFunctor
variable (F C D : Set)
hypothesis functor : F : C ⥤ D

theorem oppositeFunctor.obj (a : Set)
  requires aInO : a ∈ obj(C)
  shows obj(oppositeFunctor(F))(a) = F(a)
proof
  simp [oppositeFunctor, Functor.mk.obj]

theorem oppositeFunctor.map (f : Set)
  requires fInM : f ∈ mor(C)
  shows map(oppositeFunctor(F))(f) = F(f)
proof
  simp [oppositeFunctor, Functor.mk.map]

theorem Functor.opposite
  shows oppositeFunctor(F) : opposite(C) ⥤ opposite(D)
proof
  have srcF := Functor.source with functor
  have tgtF := Functor.target with functor
  have source := Functor.source_category with functor
  have target := Functor.target_category with functor
  have sourceOpposite := Category.opposite with source
  have targetOpposite := Category.opposite with target
  have srcLaw : src(oppositeFunctor(F)) = opposite(C)
    simp [oppositeFunctor, Functor.mk.src, srcF]
  have tgtLaw : tgt(oppositeFunctor(F)) = opposite(D)
    simp [oppositeFunctor, Functor.mk.tgt, tgtF]
  have objC := opposite.obj at C
  have objD := opposite.obj at D
  have morC := opposite.mor at C
  have morD := opposite.mor at D
  have objects : obj(oppositeFunctor(F)) : obj(opposite(C)) → obj(opposite(D))
    have function := Functor.object_function with functor
    unfold oppositeFunctor
    rw [Functor.mk.obj, objC, objD]
    exact function
  have morphisms : map(oppositeFunctor(F)) : mor(opposite(C)) → mor(opposite(D))
    have function := Functor.morphism_function with functor
    unfold oppositeFunctor
    rw [Functor.mk.map, morC, morD]
    exact function
  have shape : Functor.Data(oppositeFunctor(F)) by simp [oppositeFunctor, Functor.mk.data]
  unfold Functor
  refine ⟨shape, sourceOpposite, targetOpposite, objects, morphisms, ?_, ?_, ?_, srcLaw, tgtLaw⟩
  . intros a aIn b bIn f fHom
    rw opposite.obj at aIn
    rw opposite.obj at bIn
    unfold Morphism at fHom
    rw [opposite.mor, opposite.dom, opposite.cod] at fHom
    obtain ⟨fInM, codF, domF⟩ := fHom
    have typed := Morphism.of_dom_cod at C, f, b, a with source, fInM, domF, codF
    have image := Functor.map_hom at F, C, D, b, a, f with bIn, aIn, typed, functor
    have objA := oppositeFunctor.obj with functor, aIn
    have objB := oppositeFunctor.obj with functor, bIn
    have mapF := oppositeFunctor.map with functor, fInM
    unfold Morphism
    rw [opposite.mor, opposite.dom, opposite.cod, objA, objB, mapF]
    obtain ⟨imageIn, domImage, codImage⟩ := image
    refine ⟨imageIn, codImage, domImage⟩
  . intros a aIn
    rw opposite.obj at aIn
    have idIn := Category.id_closed with source, aIn
    have objA := oppositeFunctor.obj with functor, aIn
    have mapId := oppositeFunctor.map with functor, idIn
    rw [opposite.id, opposite.id, mapId, objA]
    exact Functor.map_id with functor, aIn
  . intros a aIn b bIn c cIn f fHom g gHom
    rw opposite.obj at aIn
    rw opposite.obj at bIn
    rw opposite.obj at cIn
    unfold Morphism at fHom
    unfold Morphism at gHom
    rw [opposite.mor, opposite.dom, opposite.cod] at fHom
    rw [opposite.mor, opposite.dom, opposite.cod] at gHom
    obtain ⟨fInM, codF, domF⟩ := fHom
    obtain ⟨gInM, codG, domG⟩ := gHom
    have fTyped := Morphism.of_dom_cod at C, f, b, a with source, fInM, domF, codF
    have gTyped := Morphism.of_dom_cod at C, g, c, b with source, gInM, domG, codG
    have composable : cod(C)(g) = dom(C)(f) by cc
    have fImage := Functor.map_hom at F, C, D, b, a, f with bIn, aIn, fTyped, functor
    have gImage := Functor.map_hom at F, C, D, c, b, g with cIn, bIn, gTyped, functor
    have imageComposable : cod(D)(F(g)) = dom(D)(F(f)) by cc
    have gImageIn := Functor.morphism_closed with functor, gInM
    have fImageIn := Functor.morphism_closed with functor, fInM
    have sourceValue := oppositeComposition.apply with source, gInM, fInM, composable
    have targetValue := oppositeComposition.apply with target, gImageIn, fImageIn, imageComposable
    have reversed : dom(C)(f) = cod(C)(g) by cc
    have gfIn : oppositeComposition(C)(g, f) ∈ mor(C)
      rw sourceValue
      exact Category.comp_closed with source, fInM, gInM, reversed
    have mapF := oppositeFunctor.map with functor, fInM
    have mapG := oppositeFunctor.map with functor, gInM
    have mapGF := oppositeFunctor.map with functor, gfIn
    rw [opposite.comp, opposite.comp, mapGF, mapG, mapF, sourceValue, targetValue]
    exact Functor.map_comp with *

end OppositeFunctor
