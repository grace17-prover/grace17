module Grace.Cumulus.Category.Yoneda
import HomFunctor
import Cardinal.Finite

-- For a functor F : C ⥤ Sets(U), an object a, and x ∈ F(a): the
-- transformation hom(a, −) ⟹ F whose component at b sends f : a ⟶ b to
-- F(f)(x).
defgraph yonedaComponent (C U F a x b : Set) (f ∈ hom(C, a, b)) : F(b) := F(f)(x)
requires functor : F : C ⥤ Sets(U)
requires aInO : a ∈ obj(C)
requires bInO : b ∈ obj(C)
requires xIn : x ∈ F(a)
proof
  have fHom : f : a ⟶ b := Morphism.of_hom with member
  have image : F(f) : F(a) ⟶ F(b) := Functor.map_hom with *
  exact Sets.apply_closed with *

defgraph yonedaTransformation (C U F a x : Set) (b ∈ Category.obj(C)) : mor(Sets(U)) :=
  setArrow(U, F(b), yonedaComponent(C, U, F, a, x, b))
requires functor : F : C ⥤ Sets(U)
requires small : mor(C) ⊆ U
requires aInO : a ∈ obj(C)
requires xIn : x ∈ F(a)
proof
  have homIn := hom.object at C, U, a, b with small
  have objectIn : F(b) ∈ obj(Sets(U)) := Functor.object_closed with *
  have function := yonedaComponent.function at C, U, F, a, x, b with functor, aInO, member, xIn
  have mapIn := functionSpace.mem_iff.backward with function
  rw Sets.obj at objectIn
  rw Sets.mor
  exact setsMorphisms.arrow with homIn, objectIn, mapIn

section YonedaTransformation
variable (C U F a : Set)
hypothesis functor : F : C ⥤ Sets(U)
hypothesis small : mor(C) ⊆ U
hypothesis aInO : a ∈ obj(C)

theorem yonedaComponent.apply (x b f : Set)
  requires xIn : x ∈ F(a)
  requires bInO : b ∈ obj(C)
  requires fHom : f ∈ hom(C, a, b)
  shows yonedaComponent(C, U, F, a, x, b)(f) = F(f)(x)
proof
  exact yonedaComponent.value at C, U, F, a, x, b, f with functor, aInO, bInO, xIn, fHom

theorem yonedaTransformation.component (x b : Set)
  requires xIn : x ∈ F(a)
  requires bInO : b ∈ obj(C)
  shows yonedaTransformation(C, U, F, a, x)(b) =
    setArrow(U, F(b), yonedaComponent(C, U, F, a, x, b))
proof
  exact yonedaTransformation.value at C, U, F, a, x, b with functor, small, aInO, xIn, bInO

instance yonedaTransformation.component_hom (x b : Set)
  requires xIn : x ∈ F(a)
  requires bInO : b ∈ obj(C)
  shows yonedaTransformation(C, U, F, a, x)(b) : hom(C, a, b) ⟶ F(b)
proof
  have sets := Sets.category at U
  have homIn := hom.object at C, U, a, b with small
  have objectIn : F(b) ∈ obj(Sets(U)) := Functor.object_closed with *
  have function := yonedaComponent.function at C, U, F, a, x, b with functor, aInO, bInO, xIn
  rw Sets.obj at objectIn
  rw yonedaTransformation.component
  exact Sets.arrow_hom with sets, homIn, objectIn, function

theorem yonedaTransformation.function_hom (x : Set)
  requires xIn : x ∈ F(a)
  shows yonedaTransformation(C, U, F, a, x) : obj(C) → mor(Sets(U))
proof
  exact yonedaTransformation.function at C, U, F, a, x with functor, small, aInO, xIn

-- The naturality square at g : b ⟶ c, applied to f ∈ hom(a, b), reads
-- F(g ∘ f)(x) = F(g)(F(f)(x)), which is functoriality of F.
theorem yonedaTransformation.natural (x : Set)
  requires xIn : x ∈ F(a)
  shows yonedaTransformation(C, U, F, a, x) : homFunctor(C, U, a) ⟹ F
proof
  have sets := Sets.category at U
  have homF : homFunctor(C, U, a) : C ⥤ Sets(U) := homFunctor.functor with *
  apply NaturalTransformation.mk with homF, functor
  . exact yonedaTransformation.function_hom with *
  . intros b bIn
    rw homFunctor.obj
    exact yonedaTransformation.component_hom with *
  . intros b bIn c cIn g gHom
    have left : yonedaTransformation(C, U, F, a, x)(c) ∘ homFunctor(C, U, a)(g) : hom(C, a, b) ⟶ F(c) by synthesize
    have right : F(g) ∘ yonedaTransformation(C, U, F, a, x)(b) : hom(C, a, b) ⟶ F(c) by synthesize
    apply Sets.ext with left, right, sets
    intros f fHom
    have fTyped : f : a ⟶ b := Morphism.of_hom with fHom
    have fImage : F(f) : F(a) ⟶ F(b) := Functor.map_hom with *
    have gImage : F(g) : F(b) ⟶ F(c) := Functor.map_hom with *
    simp [Sets.comp_apply, homFunctor.map_hom, Sets.arrow_apply, postComposition.apply, yonedaTransformation.component, yonedaComponent.apply, Functor.map_comp]

end YonedaTransformation

-- The Yoneda map sends a transformation η : hom(a, −) ⟹ F to the value
-- of its component at a on the identity of a; its inverse sends x ∈ F(a)
-- to the transformation above.
defgraph yonedaMap (C U F a : Set) (η ∈ NatTrans(homFunctor(C, U, a), F)) : F(a) :=
  η(a)(id(C)(a))
requires functor : F : C ⥤ Sets(U)
requires small : mor(C) ⊆ U
requires aInO : a ∈ obj(C)
proof
  have category := Functor.source_category with functor
  have homF := homFunctor.functor with category, small, aInO
  have natural := NatTrans.natural with member
  have component : η(a) : homFunctor(C, U, a)(a) ⟶ F(a) :=
    NaturalTransformation.component_hom with *
  have idHom : id(C)(a) ∈ hom(C, a, a) := hom.id with category, aInO
  rw homFunctor.obj at component
  exact Sets.apply_closed with *

defgraph yonedaInverse (C U F a : Set) (x ∈ F(a)) : NatTrans(homFunctor(C, U, a), F) :=
  yonedaTransformation(C, U, F, a, x)
requires functor : F : C ⥤ Sets(U)
requires small : mor(C) ⊆ U
requires aInO : a ∈ obj(C)
proof
  have category := Functor.source_category with functor
  have homF := homFunctor.functor with category, small, aInO
  have natural := yonedaTransformation.natural with functor, small, aInO, member
  exact NatTrans.of_transformation with homF, functor, natural

section YonedaLemma
variable (C U F a : Set)
hypothesis functor : F : C ⥤ Sets(U)
hypothesis small : mor(C) ⊆ U
hypothesis aInO : a ∈ obj(C)

theorem yonedaMap.apply (η : Set)
  requires natural : η : homFunctor(C, U, a) ⟹ F
  shows yonedaMap(C, U, F, a)(η) = η(a)(id(C)(a))
proof
  have category := Functor.source_category with functor
  have homF := homFunctor.functor with category, small, aInO
  have member := NatTrans.of_transformation with homF, functor, natural
  exact yonedaMap.value at C, U, F, a, η with functor, small, aInO, member

theorem yonedaInverse.apply (x : Set)
  requires xIn : x ∈ F(a)
  shows yonedaInverse(C, U, F, a)(x) = yonedaTransformation(C, U, F, a, x)
proof
  exact yonedaInverse.value at C, U, F, a, x with functor, small, aInO, xIn

theorem yonedaMap.in (η : Set)
  requires natural : η : homFunctor(C, U, a) ⟹ F
  shows yonedaMap(C, U, F, a)(η) ∈ F(a)
proof
  have homF : homFunctor(C, U, a) : C ⥤ Sets(U) := homFunctor.functor with *
  have member := NatTrans.of_transformation with homF, functor, natural
  have function := yonedaMap.function at C, U, F, a with functor, small, aInO
  exact FunctionBetween.apply_closed with function, member

-- The component at b of a transformation η : hom(a, −) ⟹ F, as a morphism
-- hom(C, a, b) ⟶ F(b) of Sets(U).
theorem NaturalTransformation.yoneda_component_hom (η b : Set)
  requires natural : η : homFunctor(C, U, a) ⟹ F
  requires bInO : b ∈ obj(C)
  shows η(b) : hom(C, a, b) ⟶ F(b)
proof
  have homF : homFunctor(C, U, a) : C ⥤ Sets(U) := homFunctor.functor with *
  have component : η(b) : homFunctor(C, U, a)(b) ⟶ F(b) :=
    NaturalTransformation.component_hom with *
  rwa homFunctor.obj at component

-- Naturality of η : hom(a, −) ⟹ F at f : a ⟶ b, applied to id(a): every
-- component is determined by the value of the component at a on id(a).
theorem NaturalTransformation.yoneda_component (η b f : Set)
  requires natural : η : homFunctor(C, U, a) ⟹ F
  requires bInO : b ∈ obj(C)
  requires fHom : f ∈ hom(C, a, b)
  shows η(b)(f) = F(f)(η(a)(id(C)(a)))
proof
  have sets := Sets.category at U
  have homF : homFunctor(C, U, a) : C ⥤ Sets(U) := homFunctor.functor with *
  have idHom : id(C)(a) ∈ hom(C, a, a) := hom.id with *
  have fTyped : f : a ⟶ b := Morphism.of_hom with fHom
  have etaA : η(a) : hom(C, a, a) ⟶ F(a) := NaturalTransformation.yoneda_component_hom with *
  have etaB : η(b) : hom(C, a, b) ⟶ F(b) := NaturalTransformation.yoneda_component_hom with *
  have square : η(b) ∘ homFunctor(C, U, a)(f) = F(f) ∘ η(a) := NaturalTransformation.naturality with *
  have applied : (η(b) ∘ homFunctor(C, U, a)(f))(id(C)(a)) = (F(f) ∘ η(a))(id(C)(a))
    rw square
    rfl
  simpa [Sets.comp_apply, homFunctor.map_hom, Sets.arrow_apply, postComposition.apply, Category.id_right] using applied

-- Round trip on F(a): the component at a of the transformation of x,
-- applied to id(a), is F(id(a))(x) = x.
theorem yonedaMap.inverse (x : Set)
  requires xIn : x ∈ F(a)
  shows yonedaMap(C, U, F, a)(yonedaInverse(C, U, F, a)(x)) = x
proof
  have category := Functor.source_category with functor
  have sets := Sets.category at U
  have natural := yonedaTransformation.natural with *
  have idHom : id(C)(a) ∈ hom(C, a, a) := hom.id with category, aInO
  have objectIn : F(a) ∈ obj(Sets(U)) := Functor.object_closed with *
  rw Sets.obj at objectIn
  rw [yonedaInverse.apply, yonedaMap.apply, yonedaTransformation.component]
  simp [Sets.arrow_apply, yonedaComponent.apply, Functor.map_id, Sets.id_apply]

-- Round trip on transformations: naturality of η at f ∈ hom(a, b), applied
-- to id(a), gives η(b)(f) = F(f)(η(a)(id(a))).
theorem yonedaInverse.map (η : Set)
  requires natural : η : homFunctor(C, U, a) ⟹ F
  shows yonedaInverse(C, U, F, a)(yonedaMap(C, U, F, a)(η)) = η
proof
  have sets := Sets.category at U
  have homF : homFunctor(C, U, a) : C ⥤ Sets(U) := homFunctor.functor with *
  have xIn : yonedaMap(C, U, F, a)(η) ∈ F(a) := yonedaMap.in with *
  have inverseNatural := yonedaTransformation.natural with functor, small, aInO, xIn
  rw yonedaInverse.apply
  apply NaturalTransformation.ext with homF, functor, inverseNatural, natural
  intros b bIn
  have left := yonedaTransformation.component_hom with functor, small, aInO, xIn, bIn
  have right : η(b) : hom(C, a, b) ⟶ F(b) := NaturalTransformation.yoneda_component_hom with *
  apply Sets.ext with left, right, sets
  intros f fHom
  have core := NaturalTransformation.yoneda_component with *
  rw [yonedaTransformation.component, Sets.arrow_apply, yonedaComponent.apply, yonedaMap.apply, core]
  rfl

theorem yonedaMap.bijective
  shows BijectiveBetween(yonedaMap(C, U, F, a), NatTrans(homFunctor(C, U, a), F), F(a))
proof
  have function := yonedaMap.function at C, U, F, a with functor, small, aInO
  have inverse := yonedaInverse.function at C, U, F, a with functor, small, aInO
  have leftLaw : ∀ η ∈ NatTrans(homFunctor(C, U, a), F),
    yonedaInverse(C, U, F, a)(yonedaMap(C, U, F, a)(η)) = η
    intros η member
    have natural := NatTrans.natural with member
    exact yonedaInverse.map with functor, small, aInO, natural
  have rightLaw : ∀ x ∈ F(a), yonedaMap(C, U, F, a)(yonedaInverse(C, U, F, a)(x)) = x
    intros x xIn
    exact yonedaMap.inverse with functor, small, aInO, xIn
  exact Bijective.of_two_sided_inverse with function, inverse, leftLaw, rightLaw

end YonedaLemma

-- The Yoneda lemma: for a functor F from a small category C, whose
-- morphisms lie in U, into the category of sets below U, and an object a,
-- the natural transformations hom(a, −) ⟹ F are in bijection with F(a).
theorem yoneda (C U F a : Set)
  requires functor : F : C ⥤ Sets(U)
  requires small : mor(C) ⊆ U
  requires aInO : a ∈ obj(C)
  shows NatTrans(homFunctor(C, U, a), F) ≃ F(a)
proof
  have bijective := yonedaMap.bijective with functor, small, aInO
  witness yonedaMap(C, U, F, a)
  exact bijective

-- The Yoneda embedding is fully faithful: transformations between two
-- hom functors hom(a, −) ⟹ hom(b, −) correspond to morphisms b ⟶ a.
theorem yoneda.hom_functors (C U a b : Set)
  requires category : Category(C)
  requires small : mor(C) ⊆ U
  requires aInO : a ∈ obj(C)
  requires bInO : b ∈ obj(C)
  shows NatTrans(homFunctor(C, U, a), homFunctor(C, U, b)) ≃ hom(C, b, a)
proof
  have functor := homFunctor.functor with category, small, bInO
  have equipotent := yoneda with functor, small, aInO
  have object := homFunctor.obj at C, U, b, a with category, small, aInO
  rw object at equipotent
  exact equipotent
