module Grace.Cumulus.Cardinal.CountableClosure
import Countable
import Product

-- A subset of a countable set is countable: restrict the injection.
theorem Countable.subset (A S : Set)
  requires countable : Countable(A)
  requires subset : S ⊆ A
  shows Countable(S)
proof
  obtain ⟨g, injection⟩ := countable
  have function := Injective.function with injection
  have closed : ∀ x ∈ S, g(x) ∈ ℕ
    intros x hx
    have hxA := subset with x, hx
    exact FunctionBetween.apply_closed at g, A, ℕ, x with *
  have restricted := restrict.function with *
  witness restrict(g, S)
  constructor
  . exact restricted
  . intros x hx y hy z hz relatesX relatesY
    have dataX := restrict.relates.forward with relatesX
    have dataY := restrict.relates.forward with relatesY
    rcases dataX with ⟨_, gX⟩
    rcases dataY with ⟨_, gY⟩
    have hxA := subset with x, hx
    have hyA := subset with y, hy
    exact Injective.cancel with *

-- The codes an injection g assigns to the preimages of b under f.
def surjectionCodes (g f A b : Set) : Set :=
  { n ∈ ℕ | ∃ a ∈ A, relates(f, a, b) ∧ g(a) = n }

theorem surjectionCodes.membership (g f A b n : Set)
  shows n ∈ surjectionCodes(g, f, A, b) ↔ (n ∈ ℕ ∧ ∃ a ∈ A, relates(f, a, b) ∧ g(a) = n)
proof
  simp

theorem surjectionCodes.subset (g f A b : Set)
  shows surjectionCodes(g, f, A, b) ⊆ ℕ
proof
  simp

theorem surjectionCodes.nonempty (g f A B b : Set)
  requires injection : InjectiveBetween(g, A, ℕ)
  requires surjection : SurjectiveBetween(f, A, B)
  requires member : b ∈ B
  shows Nonempty(surjectionCodes(g, f, A, b))
proof
  have gFunction := Injective.function with injection
  rcases surjection with ⟨fFunction, onto⟩
  obtain ⟨a, ha, relatesA⟩ := onto with b, member
  have code := FunctionBetween.apply_closed at g, A, ℕ, a with *
  witness g(a)
  apply surjectionCodes.membership.backward
  constructor
  . exact code
  . witness a
    refine ⟨ha, relatesA, rfl⟩

-- Send each b to the least code of a preimage. Choosing the least code
-- needs no Choice axiom.
defgraph surjectionCode (g f A B : Set) (b ∈ B) : ℕ := leastNatural(surjectionCodes(g, f, A, b))
requires injection : InjectiveBetween(g, A, ℕ)
requires surjection : SurjectiveBetween(f, A, B)
proof
  have inhabited := surjectionCodes.nonempty with *
  have naturals := surjectionCodes.subset at g, f, A, b
  have selected := leastNatural.selected at surjectionCodes(g, f, A, b) with *
  exact selected.left

-- The image of a countable set under a surjection is countable.
theorem Countable.of_surjection (f A B : Set)
  requires countable : Countable(A)
  requires surjection : SurjectiveBetween(f, A, B)
  shows Countable(B)
proof
  obtain ⟨g, injection⟩ := countable
  have gFunction := Injective.function with injection
  have fFunction := Surjective.function with surjection
  have functional := FunctionBetween.functional with fFunction
  have codeFunction := surjectionCode.function at g, f, A, B with *
  witness surjectionCode(g, f, A, B)
  constructor
  . exact codeFunction
  . intros b1 hb1 b2 hb2 z hz relates1 relates2
    have value1 := FunctionBetween.apply_value at surjectionCode(g, f, A, B), B, ℕ, b1, z with *
    have value2 := FunctionBetween.apply_value at surjectionCode(g, f, A, B), B, ℕ, b2, z with *
    have code1 := surjectionCode.value at g, f, A, B, b1 with *
    have code2 := surjectionCode.value at g, f, A, B, b2 with *
    have inhabited1 := surjectionCodes.nonempty with hb1
    have inhabited2 := surjectionCodes.nonempty with hb2
    have naturals1 := surjectionCodes.subset at g, f, A, b1
    have naturals2 := surjectionCodes.subset at g, f, A, b2
    have least1 := leastNatural.member at surjectionCodes(g, f, A, b1) with *
    have least2 := leastNatural.member at surjectionCodes(g, f, A, b2) with *
    have data1 := surjectionCodes.membership.forward with least1
    have data2 := surjectionCodes.membership.forward with least2
    obtain ⟨_, a1, ha1, relatesF1, codeA1⟩ := data1
    obtain ⟨_, a2, ha2, relatesF2, codeA2⟩ := data2
    have sameCode : g(a2) = g(a1) by cc
    have gRelates1 := FunctionBetween.relates_apply at g, A, ℕ, a1 with *
    have gRelates2 := FunctionBetween.relates_apply at g, A, ℕ, a2 with *
    rw sameCode at gRelates2
    have codeNatural := FunctionBetween.apply_closed at g, A, ℕ, a1 with *
    have sameInput := Injective.cancel with ha1, ha2
    rw sameInput at relatesF1
    exact Functional.unique with *

-- Two to the power of n is never zero.
theorem pow.two_nonzero (n : Nat)
  shows 2 ^ n ≠ 0
proof
  induction n
  | zero =>
    rw pow.zero
    intro bad
    have positiveOne : 0 < 1 by arith
    rw bad at positiveOne
    exact Less.irreflexive with *, positiveOne
  | succ(k) using ih =>
    rw pow.succ
    have twoNonzero : 2 ≠ 0
      intro bad
      have positiveTwo : 0 < 2 by arith
      rw bad at positiveTwo
      exact Less.irreflexive at 0 with *, positiveTwo
    exact mul.nonzero at 2, 2 ^ k with *

-- The code 2^a · (2b + 1) determines a and b: a is the number of factors of
-- two, and 2b + 1 is the odd part.
theorem pairingCode.strict (a k b d : Nat)
  requires equal : 2 ^ a * succ(b + b) = 2 ^ (succ(a) + k) * succ(d + d)
  shows ⊥
proof
  have split := pow.add at 2, k, succ(a) with *
  rw split at equal
  have step := pow.succ at 2, a with *
  rw step at equal
  have rearranged : (2 * 2 ^ a) * 2 ^ k * succ(d + d) = 2 ^ a * (2 * (2 ^ k * succ(d + d))) by ring
  rw rearranged at equal
  have nonzero := pow.two_nonzero at a with *
  have cancelled := mul.left_cancel_positive with *
  have doubled := mul.two_left at 2 ^ k * succ(d + d) with *
  rw doubled at cancelled
  have even := Even.double at 2 ^ k * succ(d + d) with *
  rw ← cancelled at even
  have odd := Odd.double_successor at b with *
  exact Odd.not_even with *, even

theorem pairingCode.injective (a b c d : Nat)
  requires equal : 2 ^ a * succ(b + b) = 2 ^ c * succ(d + d)
  shows a = c ∧ b = d
proof
  have twoNonzero : 2 ≠ 0
    intro bad
    arith
  have shape := Less.trichotomy at a, c with *
  rcases shape with less | same | greater
  . exfalso
    obtain ⟨k, kNat, cShape⟩ := less
    rw ← cShape at equal
    exact pairingCode.strict with equal
  . rw same at equal
    have nonzero := pow.two_nonzero at c with *
    have cancelled := mul.left_cancel_positive with *
    have doubles := Naturals.injective.succ at b + b, d + d with *
    have bLe : b ≤ d by arith
    have dLe : d ≤ b by arith
    exact ⟨same, (LessEqual.antisymmetric at b, d with *)⟩
  . exfalso
    obtain ⟨k, kNat, aShape⟩ := greater
    rw ← aShape at equal
    symm at equal
    exact pairingCode.strict with equal

-- The code of a pair of naturals.
defunique pairingCode (p : Set) (n ∈ ℕ) :=
  ∃ a ∈ ℕ, ∃ b ∈ ℕ, p = (a, b) ∧ n = 2 ^ a * succ(b + b)
requires pair : p ∈ ℕ × ℕ
proof
  obtain ⟨bound, a, ha, b, hb, shape⟩ := product.membership.forward with pair
  have aNat := nat.omega.backward with ha
  have bNat := nat.omega.backward with hb
  have codeNat : Nat(2 ^ a * succ(b + b)) by typecheck
  have codeMember := nat.omega.forward with codeNat
  refine ⟨2 ^ a * succ(b + b), codeMember, a, ha, b, hb, shape, rfl⟩
uniqueness
  intros u hu first v hv second
  obtain ⟨a, ha, b, hb, shapeU, valueU⟩ := first
  obtain ⟨c, hc, d, hd, shapeV, valueV⟩ := second
  have equal : (a, b) = (c, d) by cc
  obtain ⟨ac, bd⟩ := orderedPair.injective with equal
  rw [valueU, valueV, ac, bd]
  rfl

defgraph naturalPairing (p ∈ ℕ × ℕ) : ℕ := pairingCode(p)
proof
  have selected := pairingCode.selected with member
  exact selected.left

theorem naturalPairing.injective
  shows InjectiveBetween(naturalPairing, ℕ × ℕ, ℕ)
proof
  have function := naturalPairing.function
  constructor
  . exact function
  . intros p hp q hq z hz relatesP relatesQ
    have valueP := FunctionBetween.apply_value at naturalPairing, ℕ × ℕ, ℕ, p, z with *
    have valueQ := FunctionBetween.apply_value at naturalPairing, ℕ × ℕ, ℕ, q, z with *
    have codeP := naturalPairing.value with hp
    have codeQ := naturalPairing.value with hq
    have selectedP := pairingCode.selected with hp
    have selectedQ := pairingCode.selected with hq
    obtain ⟨_, a, ha, b, hb, shapeP, formP⟩ := selectedP
    obtain ⟨_, c, hc, d, hd, shapeQ, formQ⟩ := selectedQ
    have aNat := nat.omega.backward with ha
    have bNat := nat.omega.backward with hb
    have cNat := nat.omega.backward with hc
    have dNat := nat.omega.backward with hd
    have same : 2 ^ a * succ(b + b) = 2 ^ c * succ(d + d) by cc
    have coordinates := pairingCode.injective with *
    rcases coordinates with ⟨ac, bd⟩
    rw [shapeP, shapeQ, ac, bd]
    rfl

-- The product of two countable sets is countable.
theorem Countable.product (A B : Set)
  requires countableA : Countable(A)
  requires countableB : Countable(B)
  shows Countable(A × B)
proof
  obtain ⟨g, injectionG⟩ := countableA
  obtain ⟨h, injectionH⟩ := countableB
  have product := productMap.injective at g, h, A, B, ℕ, ℕ with *
  have pairing := naturalPairing.injective
  have composed := compose.injective at naturalPairing, productMap(g, h, A, B, ℕ, ℕ), A × B, ℕ × ℕ, ℕ with *
  witness compose(naturalPairing, productMap(g, h, A, B, ℕ, ℕ), A × B, ℕ × ℕ, ℕ)
  exact composed

theorem naturals.countable
  shows Countable(ℕ)
proof
  witness identity(ℕ)
  exact identity.injective
