module Grace.Cumulus.Cardinal.FiniteUnion
import ListSupport

theorem union.insert (A S : Set)
  shows ⋃insert(S, A) = S ∪ ⋃A
proof
  ext y
  simp [set.union, insert.membership, union2.membership]

theorem listSupport.finite_union (A : Set) (xs : List(A))
  requires members : ∀ S ∈ A, Finite(S)
  shows Finite(⋃listSupport{A}(xs))
proof
  induction xs
  | List.nil =>
    rw listSupport.nil
    have bounded : ⋃∅ ⊆ ∅ by simp [Subset, set.union, set.empty]
    exact Finite.subset with Finite.empty, bounded
  | List.cons(S, tail) using ih =>
    have member : S ∈ A by assumption
    have finite := members with S, member
    rw [listSupport.cons, union.insert]
    exact Finite.union with finite, ih

theorem Finite.big_union (A : Set)
  requires finite : Finite(A)
  requires members : ∀ S ∈ A, Finite(S)
  shows Finite(⋃A)
proof
  obtain ⟨xs, list, covers⟩ := Finite.list_cover with finite
  have bound := listSupport.finite_union with *
  have included : ⋃A ⊆ ⋃listSupport{A}(xs)
    intros x hx
    obtain ⟨S, member, inS⟩ := set.union.forward with hx
    have supported := covers with S, member
    exact union.contains with supported, inS
  exact Finite.subset with bound, included
