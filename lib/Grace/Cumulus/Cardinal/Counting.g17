-- Authors: Grant Passmore

module Grace.Cumulus.Cardinal.Counting
import Enumeration

theorem cardinality.bijective (A B f : Set)
  requires finite : Finite(A)
  requires bijective : BijectiveBetween(f, A, B)
  shows cardinality(A) = cardinality(B)
proof
  obtain ⟨natural, g, enumeration⟩ := cardinality.correct with finite
  have inverse := converse.bijective with bijective
  have composed := compose.bijective at g, converse(f, A, B), B, A, cardinality(A) with *
  have other : HasCardinality(B, cardinality(A))
    unfold HasCardinality
    refine ⟨natural, ?_⟩
    unfold Equipotent
    refine ⟨compose(g, converse(f, A, B), B, A, cardinality(A)), composed⟩
  symm
  exact cardinality.eq_of_has with other

theorem cardinality.insert (A a : Set)
  requires finite : Finite(A)
  requires fresh : ¬(a ∈ A)
  shows cardinality(insert(a, A)) = succ(cardinality(A))
proof
  obtain ⟨natural, f, enumeration⟩ := cardinality.correct with finite
  have newIndex := membership.irreflexive at cardinality(A)
  have extended := adjoinMap.bijective with *
  have successor := natural.successor_as_insert with natural
  rw ← successor at extended
  have next := Naturals.constructor.succ with natural
  have cardinal : HasCardinality(insert(a, A), succ(cardinality(A)))
    unfold HasCardinality
    refine ⟨next, ?_⟩
    unfold Equipotent
    refine ⟨adjoinMap(f, a, cardinality(A)), extended⟩
  exact cardinality.eq_of_has with cardinal

theorem cardinality.remove (A a : Set)
  requires finite : Finite(A)
  requires member : a ∈ A
  shows cardinality(A) = succ(cardinality(A ∖ {a}))
proof
  have subset := difference.subset_left at A, {a}
  have smaller := Finite.subset with finite, subset
  have fresh : ¬(a ∈ A ∖ {a}) by simp [difference.membership, singleton.membership]
  have restored := insert.restore with member
  have count := cardinality.insert with *
  rwa restored at count

-- A set of size k + 1 is a set of size k with one element put back.
theorem cardinality.exists_remove (F : Set) (k : Nat)
  requires finite : Finite(F)
  requires size : cardinality(F) = succ(k)
  shows ∃ e ∈ F, cardinality(F ∖ {e}) = k ∧ (F ∖ {e}) ∪ {e} = F
proof
  have inhabited : ∃ e, e ∈ F
    by_contra none
    have empty : F = ∅
      ext y
      constructor
      . intro hy
        exfalso
        exact none with ⟨y, hy⟩
      . intro hy
        exfalso
        exact set.empty with hy
    rw [empty, cardinality.empty] at size
    exact Naturals.disjoint.zero.succ at k with size
  obtain ⟨e, he⟩ := inhabited
  have removed := cardinality.remove with finite, he
  rw size at removed
  have restored : (F ∖ {e}) ∪ {e} = F
    ext y
    simp
  refine ⟨e, he, _, restored⟩
  symm
  exact Naturals.injective.succ with removed

-- Induction over the finite subsets of E, by the size of the subset: a
-- family S of sets containing ∅ and closed under adjoining a fresh point of
-- E to a finite member contains every finite subset of E.
theorem Finite.induction_of_size (E S : Set, n : Nat)
  requires base : ∅ ∈ S
  requires step : ∀ F ⊆ E, Finite(F) → ∀ a ∈ E, a ∉ F → F ∈ S →
    F ∪ {a} ∈ S
  shows ∀ F ⊆ E, Finite(F) → cardinality(F) = n → F ∈ S
proof
  induction n
  | zero =>
    intros F bound finite size
    have empty : F = ∅
      ext y
      constructor
      . intro hy
        exfalso
        have removed := cardinality.remove with finite, hy
        rw size at removed
        exact Naturals.disjoint.zero.succ at cardinality(F ∖ {y}) with removed
      . intro hy
        exfalso
        exact set.empty with hy
    rw empty
    exact base
  | succ(k) using ih =>
    intros F bound finite size
    obtain ⟨e, he, restSize, restored⟩ :=
      cardinality.exists_remove with finite, size
    have restSubset := difference.subset_left at F, {e}
    have restBound := Subset.transitive with restSubset, bound
    have restFinite := Finite.subset with finite, restSubset
    have rest := ih with F ∖ {e}, restBound, restFinite, restSize
    have fresh : e ∉ F ∖ {e} by simp
    have next := step with F ∖ {e}, restBound, restFinite, e,
      (bound with e, he), fresh, rest
    rw restored at next
    exact next

theorem Finite.induction (E S : Set)
  requires base : ∅ ∈ S
  requires step : ∀ F ⊆ E, Finite(F) → ∀ a ∈ E, a ∉ F → F ∈ S →
    F ∪ {a} ∈ S
  shows ∀ F ⊆ E, Finite(F) → F ∈ S
proof
  intros F bound finite
  have correct := cardinality.correct with finite
  have natural := correct.left
  have size : cardinality(F) = cardinality(F) by rfl
  exact Finite.induction_of_size at E, S, cardinality(F)
    with natural, base, step, F, bound, finite, size
