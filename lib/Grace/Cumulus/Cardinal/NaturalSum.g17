-- Sums of natural numbers over finite sets, as the size of the set of
-- weighted pairs (v, i) with i below the weight of v, so no enumeration
-- is chosen. Disjoint unions add up, and so does inserting a point.
-- Part of Cumulus, the Grace17 mathematics library.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module Grace.Cumulus.Cardinal.NaturalSum
import PowersetCount
import Product
import Set

-- Disjoint unions add up.
theorem tags.disjoint_sets
  shows Disjoint({0}, {1})
proof
  apply Disjoint.iff.backward
  intros z hz hz2
  have zero := singleton.membership.forward with hz
  have one := singleton.membership.forward with hz2
  apply zero.ne_one
  rw [← zero, ← one]
  rfl

theorem Equipotent.union_of_disjoint (A B : Set)
  requires disjoint : Disjoint(A, B)
  shows (A ⊎ B) ≃ (A ∪ B)
proof
  have left := firstProjection.bijective_singleton at A, 0
  have right := firstProjection.bijective_singleton at B, 1
  have domains : Disjoint(A × {0}, B × {1}) := product.disjoint_of_right with tags.disjoint_sets
  have joined := Bijective.union_disjoint with left, right, domains, disjoint
  witness firstProjection(A, {0}) ∪ firstProjection(B, {1})
  unfold disjointSum
  exact joined

theorem cardinality.union_disjoint (A B : Set)
  requires finiteA : Finite(A)
  requires finiteB : Finite(B)
  requires disjoint : Disjoint(A, B)
  shows cardinality(A ∪ B) = cardinality(A) + cardinality(B)
proof
  have hasA := cardinality.correct with finiteA
  have hasB := cardinality.correct with finiteB
  have hasSum := HasCardinality.disjointSum with hasA, hasB
  have finiteSum := Finite.disjointSum with finiteA, finiteB
  obtain ⟨f, bijective⟩ := Equipotent.union_of_disjoint with disjoint
  have same := cardinality.bijective with finiteSum, bijective
  have value := cardinality.eq_of_has with hasSum
  rw [← same, value]
  rfl

theorem cardinality.singleton_product (a B : Set)
  requires finite : Finite(B)
  shows cardinality({a} × B) = cardinality(B)
proof
  have finiteProduct := Finite.product with (Finite.singleton at a), finite
  exact cardinality.bijective with finiteProduct, (secondProjection.bijective_singleton at a, B)

-- Weighted pairs and the sum.
def weightedPairs (V w : Set) : Set := { p ∈ V × ℕ | ∃ v ∈ V, ∃ i ∈ w(v), p = (v, i) }
def natSum (V w : Set) : Set := cardinality(weightedPairs(V, w))

theorem weightedPairs.empty (w : Set)
  shows weightedPairs(∅, w) = ∅
proof
  ext p
  constructor
  . intro hp
    have parts := weightedPairs.membership.forward with hp
    obtain ⟨v, hv, i, hi, shape⟩ := parts.right
    exfalso
    exact empty.membership with v, hv
  . intro hp
    exfalso
    exact empty.membership with p, hp

theorem weightedPairs.insert (V w a : Set)
  requires weight : w(a) ∈ ℕ
  shows weightedPairs(insert(a, V), w) = weightedPairs(V, w) ∪ ({a} × w(a))
proof
  have weightNat := nat.omega.backward with weight
  have self : a ∈ {a} by simp [singleton.membership]
  have aInserted : a ∈ insert(a, V)
    apply insert.membership.backward
    left
    rfl
  ext p
  constructor
  . intro hp
    have parts := weightedPairs.membership.forward with hp
    obtain ⟨v, hv, i, hi, shape⟩ := parts.right
    have bound := parts.left
    rw shape at bound
    have coordinates := product.pair_membership.forward with bound
    have split := insert.membership.forward with hv
    cases split with isA | inV
    . apply union2.right
      rw isA at hi
      rw [shape, isA]
      exact product.pair with self, hi
    . apply union2.left
      apply weightedPairs.membership.backward
      have bound2 : p ∈ V × ℕ
        rw shape
        exact product.pair with inV, coordinates.right
      refine ⟨bound2, v, inV, i, hi, shape⟩
  . intro hp
    have split := union2.membership.forward with hp
    cases split with inOld | inNew
    . have parts := weightedPairs.membership.forward with inOld
      obtain ⟨v, hv, i, hi, shape⟩ := parts.right
      have bound := parts.left
      rw shape at bound
      have coordinates := product.pair_membership.forward with bound
      have hvIns : v ∈ insert(a, V)
        apply insert.membership.backward
        right
        exact hv
      apply weightedPairs.membership.backward
      have bound2 : p ∈ insert(a, V) × ℕ
        rw shape
        exact product.pair with hvIns, coordinates.right
      refine ⟨bound2, v, hvIns, i, hi, shape⟩
    . obtain ⟨bound, x, hx, i, hi, shape⟩ := product.membership.forward with inNew
      have sameX := singleton.membership.forward with hx
      rw sameX at shape
      have naturals := natural.member_natural with weightNat
      have iNat := naturals with i, hi
      have hiN : i ∈ ℕ := nat.omega.forward with iNat
      apply weightedPairs.membership.backward
      have bound2 : p ∈ insert(a, V) × ℕ
        rw shape
        exact product.pair with aInserted, hiN
      refine ⟨bound2, a, aInserted, i, hi, shape⟩

-- The pairs over a point: a copy of the weight.
theorem weightedPairs.point_count (w a : Set)
  requires weight : w(a) ∈ ℕ
  shows cardinality({a} × w(a)) = w(a)
proof
  have weightNat := nat.omega.backward with weight
  have finite := Finite.natural at w(a)
  have same := cardinality.singleton_product at a, w(a) with finite
  rw same
  exact cardinality.natural

theorem weightedPairs.disjoint_point (V w a : Set)
  requires fresh : ¬a ∈ V
  shows Disjoint(weightedPairs(V, w), {a} × w(a))
proof
  apply Disjoint.iff.backward
  intros p hp hp2
  have parts := weightedPairs.membership.forward with hp
  obtain ⟨v, hv, i, hi, shape⟩ := parts.right
  rw shape at hp2
  have coordinates := product.pair_membership.forward with hp2
  have same := singleton.membership.forward with coordinates.left
  apply fresh
  rwa ← same

-- Finiteness, by induction on the size of V.
theorem weightedPairs.finite (V w : Set, n : Nat)
  requires finite : Finite(V)
  requires size : cardinality(V) = n
  requires weights : ∀ v ∈ V, w(v) ∈ ℕ
  shows Finite(weightedPairs(V, w))
proof
  induction n generalizing V
  | zero =>
    intros V finite size weights
    have has := cardinality.correct with finite
    rw size at has
    have empty := HasCardinality.empty_of_zero at V with has
    rw [empty, weightedPairs.empty]
    exact Finite.empty
  | succ(k) using ih =>
    intros V finite size weights
    have has := cardinality.correct with finite
    rw size at has
    obtain ⟨a, ha⟩ := HasCardinality.exists_member with has
    have removed := cardinality.remove with finite, ha
    rw size at removed
    have smaller := Naturals.injective.succ with removed
    have restFinite := Finite.subset with finite, (difference.subset_left at V, {a})
    have restWeights : ∀ v ∈ V ∖ {a}, w(v) ∈ ℕ
      intros v hv
      have parts := difference.singleton_membership.forward with hv
      exact weights with v, parts.left
    have restSize : cardinality(V ∖ {a}) = k
      symm
      exact smaller
    have rest := ih with V ∖ {a}, restFinite, restSize, restWeights
    have restore := insert.restore with ha
    have weight := weights with a, ha
    have weightNat := nat.omega.backward with weight
    have split := weightedPairs.insert at V ∖ {a}, w, a with weight
    rw ← restore
    rw split
    apply Finite.union with rest
    exact Finite.product with (Finite.singleton at a), (Finite.natural at w(a))

-- The sum laws.
theorem natSum.empty (w : Set)
  shows natSum(∅, w) = 0
proof
  unfold natSum
  rw [weightedPairs.empty, ← nat.zero]
  exact cardinality.natural

theorem natSum.insert (V w a : Set)
  requires finite : Finite(V)
  requires weights : ∀ v ∈ V, w(v) ∈ ℕ
  requires weight : w(a) ∈ ℕ
  requires fresh : ¬a ∈ V
  shows natSum(insert(a, V), w) = natSum(V, w) + w(a)
proof
  have weightNat := nat.omega.backward with weight
  have split := weightedPairs.insert at V, w, a with weight
  have size : cardinality(V) = cardinality(V) by rfl
  have correct := cardinality.correct with finite
  have cardNat := correct.left
  have pairsFinite := weightedPairs.finite with finite, size, weights
  have pointFinite := Finite.product with (Finite.singleton at a), (Finite.natural at w(a))
  have disjoint := weightedPairs.disjoint_point at V, w, a with fresh
  have count := weightedPairs.point_count with weight
  have added := cardinality.union_disjoint with pairsFinite, pointFinite, disjoint
  rw count at added
  unfold natSum
  rw split
  exact added

theorem natSum.natural (V w : Set)
  requires finite : Finite(V)
  requires weights : ∀ v ∈ V, w(v) ∈ ℕ
  shows Nat(natSum(V, w))
proof
  have size : cardinality(V) = cardinality(V) by rfl
  have correct := cardinality.correct with finite
  have cardNat := correct.left
  have pairsFinite := weightedPairs.finite with finite, size, weights
  have counted := cardinality.correct with pairsFinite
  unfold natSum
  exact counted.left

-- Equal weights give equal sums.
theorem natSum.congr (V w v : Set)
  requires agree : ∀ x ∈ V, w(x) = v(x)
  shows natSum(V, w) = natSum(V, v)
proof
  have same : weightedPairs(V, w) = weightedPairs(V, v)
    ext p
    constructor
    . intro hp
      have parts := weightedPairs.membership.forward with hp
      obtain ⟨x, hx, i, hi, shape⟩ := parts.right
      have equal := agree with x, hx
      rw equal at hi
      exact weightedPairs.membership.backward with ⟨parts.left, x, hx, i, hi, shape⟩
    . intro hp
      have parts := weightedPairs.membership.forward with hp
      obtain ⟨x, hx, i, hi, shape⟩ := parts.right
      have equal := agree with x, hx
      rw ← equal at hi
      exact weightedPairs.membership.backward with ⟨parts.left, x, hx, i, hi, shape⟩
  unfold natSum
  rw same

-- Sums of pointwise sums.
theorem natSum.add_pointwise (w u t : Set, n : Nat)
  shows ∀ V, Finite(V) → cardinality(V) = n → (∀ v ∈ V, u(v) ∈ ℕ) → (∀ v ∈ V, t(v) ∈ ℕ) →
    (∀ v ∈ V, w(v) = u(v) + t(v)) → natSum(V, w) = natSum(V, u) + natSum(V, t)
proof
  induction n
  | zero =>
    intros V finite size weightsU weightsT agree
    have has := cardinality.correct with finite
    rw size at has
    have empty := HasCardinality.empty_of_zero at V with has
    rw [empty, natSum.empty, natSum.empty, natSum.empty]
    have zeroNat : Nat(0) by typecheck
    rw add.right_unit
    rfl
  | succ(k) using ih =>
    intros V finite size weightsU weightsT agree
    have has := cardinality.correct with finite
    rw size at has
    obtain ⟨a, ha⟩ := HasCardinality.exists_member with has
    have removed := cardinality.remove with finite, ha
    rw size at removed
    have smaller := Naturals.injective.succ with removed
    have restSize : cardinality(V ∖ {a}) = k
      symm
      exact smaller
    have restFinite := Finite.subset with finite, (difference.subset_left at V, {a})
    have restInside := difference.subset_left at V, {a}
    have restU : ∀ v ∈ V ∖ {a}, u(v) ∈ ℕ
      intros v hv
      exact weightsU with v, (restInside with v, hv)
    have restT : ∀ v ∈ V ∖ {a}, t(v) ∈ ℕ
      intros v hv
      exact weightsT with v, (restInside with v, hv)
    have restAgree : ∀ v ∈ V ∖ {a}, w(v) = u(v) + t(v)
      intros v hv
      exact agree with v, (restInside with v, hv)
    have restW : ∀ v ∈ V ∖ {a}, w(v) ∈ ℕ
      intros v hv
      have equal := restAgree with v, hv
      rw equal
      have uNat := nat.omega.backward with (restU with v, hv)
      have tNat := nat.omega.backward with (restT with v, hv)
      have sumNat : Nat(u(v) + t(v)) by typecheck
      exact nat.omega.forward with sumNat
    have rest := ih with V ∖ {a}, restFinite, restSize, restU, restT, restAgree
    have fresh : ¬a ∈ V ∖ {a}
      intro inside
      have parts := difference.singleton_membership.forward with inside
      apply parts.right
      rfl
    have restore := insert.restore with ha
    have weightU := weightsU with a, ha
    have weightT := weightsT with a, ha
    have weightW : w(a) ∈ ℕ
      have equal := agree with a, ha
      rw equal
      have uNat := nat.omega.backward with weightU
      have tNat := nat.omega.backward with weightT
      have sumNat : Nat(u(a) + t(a)) by typecheck
      exact nat.omega.forward with sumNat
    have insertedW := natSum.insert with restFinite, restW, weightW, fresh
    have insertedU := natSum.insert with restFinite, restU, weightU, fresh
    have insertedT := natSum.insert with restFinite, restT, weightT, fresh
    have equalA := agree with a, ha
    rw ← restore
    rw [insertedW, insertedU, insertedT, rest, equalA]
    have sumU := natSum.natural with restFinite, restU
    have sumT := natSum.natural with restFinite, restT
    have uNat := nat.omega.backward with weightU
    have tNat := nat.omega.backward with weightT
    exact add.four_shuffle at natSum(V ∖ {a}, u), natSum(V ∖ {a}, t), u(a), t(a)

-- An injection preserves the size of a finite set of inputs.
theorem cardinality.injective_image (f A B S : Set)
  requires injective : InjectiveBetween(f, A, B)
  requires subset : S ⊆ A
  requires finite : Finite(S)
  shows cardinality(functionImage(f, S, B)) = cardinality(S)
proof
  have function := Injective.function with injective
  have restricted := restrict.injective with injective, subset
  have corestricted := Injective.corestrict with restricted
  have surjective := functionImage.surjective with (Injective.function with restricted)
  have bijective : BijectiveBetween(restrict(f, S), S, functionImage(restrict(f, S), S, B)) := ⟨corestricted, surjective⟩
  have same := cardinality.bijective with finite, bijective
  have image := functionImage.restrict with function, subset
  rw image at same
  symm
  exact same
