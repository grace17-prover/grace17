-- Inclusion–exclusion for two finite sets: the sizes of the union and the
-- intersection add up to the sizes of the two sets.
-- Part of Cumulus, the Grace17 mathematics library.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module Grace.Cumulus.Cardinal.InclusionExclusion
import NaturalSum
import Pigeonhole

theorem cardinality.inclusion_exclusion (A B : Set)
  requires finiteA : Finite(A)
  requires finiteB : Finite(B)
  shows cardinality(A ∪ B) + cardinality(A ∩ B) =
    cardinality(A) + cardinality(B)
proof
  have restSubset := difference.subset_left at B, A with *
  have finiteRest := Finite.subset with finiteB, restSubset
  have meetSubset := intersection.subset_left at A, B with *
  have finiteMeet := Finite.subset with finiteA, meetSubset
  have splitUnion := difference.union2_self at A, B with *
  have disjointRest : Disjoint(A, B ∖ A)
    unfold Disjoint
    ext x
    simp
  have unionCount := cardinality.union_disjoint with
    finiteA, finiteRest, disjointRest
  rw splitUnion at unionCount
  have splitB : (A ∩ B) ∪ (B ∖ A) = B
    ext x
    simp
  have disjointMeet : Disjoint(A ∩ B, B ∖ A)
    unfold Disjoint
    ext x
    simp
  have meetCount := cardinality.union_disjoint with
    finiteMeet, finiteRest, disjointMeet
  rw splitB at meetCount
  have natA := cardinality.nat with finiteA
  have natMeet := cardinality.nat with finiteMeet
  have natRest := cardinality.nat with finiteRest
  have regroup := add.associative at cardinality(B ∖ A), cardinality(A ∩ B),
    cardinality(A) with natA
  have swap := add.commutative at cardinality(A ∩ B), cardinality(B ∖ A)
    with natMeet, natRest
  rw [unionCount, meetCount, regroup, swap]
  rfl
