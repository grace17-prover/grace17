module Grace.Cumulus.Cardinal.FiniteImage
import ListSupport

theorem listSupport.image_cover (D C f : Set) (xs : List(D))
  requires function : f : D → C
  shows ∃ ys, List(C, ys) ∧ (∀ x ∈ listSupport{D}(xs), f(x) ∈ listSupport{C}(ys))
proof
  induction xs
  | List.nil =>
    have nil : List(C, []) by typecheck
    refine ⟨[], nil, _⟩
    intros x hx
    unfold listSupport at hx
    exfalso
    exact set.empty with hx
  | List.cons(x, tail) using ih =>
    obtain ⟨ys, listY, covers⟩ := ih
    have value := FunctionBetween.apply_closed with *
    have next : List(C, f(x) :: ys) by typecheck
    refine ⟨f(x) :: ys, next, _⟩
    intros y hy
    rw listSupport at hy
    have casesY := insert.membership.forward with hy
    rw listSupport
    cases casesY with same | old
    . rw same
      exact insert.self
    . have previous := covers with y, old
      exact insert.contains with previous

theorem Finite.function_image (D C f S : Set)
  requires function : f : D → C
  requires finite : Finite(S)
  requires subset : S ⊆ D
  shows Finite(functionImage(f, S, C))
proof
  obtain ⟨xs, listX, covers⟩ := Finite.cover_in with finite, subset
  obtain ⟨ys, listY, values⟩ := listSupport.image_cover at D, C, f, xs with *
  have finiteY := listSupport.finite at C, ys with *
  have bounded : functionImage(f, S, C) ⊆ listSupport{C}(ys)
    intros y hy
    obtain ⟨inC, x, hx, equation⟩ := functionImage.membership.forward with hy
    have covered := covers with x, hx
    have value := values with x, covered
    rwa equation
  exact Finite.subset with finiteY, bounded
