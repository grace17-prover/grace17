-- Lists without repeated entries: every count is at most one, and this
-- passes to tails, prefixes, suffixes, filters, reversals, and permutations
-- Part of Cumulus, the Grace17 mathematics library.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module Grace.Cumulus.List.NoDup
import Range

predicate ListNoDup (A xs : Set) := ∀ x, listCount{A}(x, xs) ≤ 1

theorem ListNoDup.nil (A : Set)
  shows ListNoDup(A, [])
proof
  unfold ListNoDup
  intro x
  rw listCount.nil
  arith

theorem ListNoDup.count_le (A x : Set) (xs : List(A))
  requires nodup : ListNoDup(A, xs)
  shows listCount{A}(x, xs) ≤ 1
proof
  exact nodup with x

theorem ListNoDup.count_eq_one (A x : Set) (xs : List(A))
  requires nodup : ListNoDup(A, xs)
  requires member : x ∈ listSupport{A}(xs)
  shows listCount{A}(x, xs) = 1
proof
  have upper := nodup with x
  have positive := listCount.positive_of_mem with member
  have natural := listCount.natural at A, x, xs with *
  have lower : 1 ≤ listCount{A}(x, xs) by arith
  exact LessEqual.antisymmetric with upper, lower

theorem ListNoDup.singleton (A a : Set)
  requires element : a ∈ A
  shows ListNoDup(A, a :: [])
proof
  unfold ListNoDup
  intro x
  have alternatives : x = a ∨ x ≠ a by tauto
  cases alternatives with same | different
  . rw [same, listCount.singleton_self]
    arith
  . rw listCount.singleton_other
    arith

theorem ListNoDup.head_absent (A a : Set) (xs : List(A))
  requires element : a ∈ A
  requires nodup : ListNoDup(A, a :: xs)
  shows ¬(a ∈ listSupport{A}(xs))
proof
  intro member
  have count := nodup with a
  have positive := listCount.positive_of_mem with member
  have natural := listCount.natural at A, a, xs with *
  rw listCount.cons_self at count
  arith

theorem ListNoDup.tail (A a : Set) (xs : List(A))
  requires element : a ∈ A
  requires nodup : ListNoDup(A, a :: xs)
  shows ListNoDup(A, xs)
proof
  unfold ListNoDup
  intro x
  have count := nodup with x
  have mark := indicator.natural at {x}, a
  have natural := listCount.natural at A, x, xs with *
  rw listCount.cons at count
  arith

theorem ListNoDup.cons (A a : Set) (xs : List(A))
  requires element : a ∈ A
  requires absent : ¬(a ∈ listSupport{A}(xs))
  requires nodup : ListNoDup(A, xs)
  shows ListNoDup(A, a :: xs)
proof
  unfold ListNoDup
  intro x
  have natural := listCount.natural at A, x, xs with *
  have alternatives : x = a ∨ x ≠ a by tauto
  cases alternatives with same | different
  . have zero := listCount.zero_of_absent with absent
    rw [same, listCount.cons_self, zero]
    arith
  . rw listCount.cons_other
    exact nodup with x

theorem ListNoDup.cons_iff (A a : Set) (xs : List(A))
  requires element : a ∈ A
  shows ListNoDup(A, a :: xs) ↔ (¬(a ∈ listSupport{A}(xs)) ∧ ListNoDup(A, xs))
proof
  constructor
  . intro nodup
    have absent := ListNoDup.head_absent with nodup
    have tail := ListNoDup.tail with nodup
    exact ⟨absent, tail⟩
  . intro both
    obtain ⟨absent, tail⟩ := both
    exact ListNoDup.cons with absent, tail

theorem ListNoDup.of_permutation (A : Set) (xs ys : List(A))
  requires permutation : ListPermutation(A, xs, ys)
  requires nodup : ListNoDup(A, xs)
  shows ListNoDup(A, ys)
proof
  unfold ListNoDup
  intro x
  have count := permutation with x
  rw ← count
  exact nodup with x

theorem ListNoDup.reverse (A : Set) (xs : List(A))
  requires nodup : ListNoDup(A, xs)
  shows ListNoDup(A, reverse(xs))
proof
  unfold ListNoDup
  intro x
  rw listCount.reverse
  exact nodup with x

theorem ListNoDup.prefix (A : Set) (xs ys : List(A))
  requires prefix : ListPrefix(A, xs, ys)
  requires nodup : ListNoDup(A, ys)
  shows ListNoDup(A, xs)
proof
  unfold ListNoDup
  intro x
  have bound := ListPrefix.count_le at A, x, xs, ys with prefix
  have upper := nodup with x
  exact LessEqual.transitive with bound, upper

theorem ListNoDup.suffix (A : Set) (xs ys : List(A))
  requires suffix : ListSuffix(A, xs, ys)
  requires nodup : ListNoDup(A, ys)
  shows ListNoDup(A, xs)
proof
  unfold ListNoDup
  intro x
  have bound := ListSuffix.count_le at A, x, xs, ys with suffix
  have upper := nodup with x
  exact LessEqual.transitive with bound, upper

theorem ListNoDup.take (A : Set) (xs : List(A)) (n : Nat)
  requires nodup : ListNoDup(A, xs)
  shows ListNoDup(A, listTake{A}(n, xs))
proof
  have taken := listTake.closed at A, xs, n with *
  have prefix := ListPrefix.take at A, xs, n with *
  exact ListNoDup.prefix with prefix, nodup

theorem ListNoDup.drop (A : Set) (xs : List(A)) (n : Nat)
  requires nodup : ListNoDup(A, xs)
  shows ListNoDup(A, listDrop{A}(n, xs))
proof
  have dropped := listDrop.closed at A, xs, n with *
  have suffix := ListSuffix.drop at A, xs, n with *
  exact ListNoDup.suffix with suffix, nodup

theorem ListNoDup.filter (A S : Set) (xs : List(A))
  requires nodup : ListNoDup(A, xs)
  shows ListNoDup(A, listFilter{A}(S, xs))
proof
  unfold ListNoDup
  intro x
  have alternatives : x ∈ S ∨ ¬(x ∈ S) by tauto
  cases alternatives with member | absent
  . rw listCount.filter_member
    exact nodup with x
  . rw listCount.filter_other
    arith

theorem ListNoDup.append_disjoint (A : Set) (xs ys : List(A))
  requires first : ListNoDup(A, xs)
  requires second : ListNoDup(A, ys)
  requires disjoint : ∀ x ∈ listSupport{A}(xs), ¬(x ∈ listSupport{A}(ys))
  shows ListNoDup(A, append(ys, xs))
proof
  unfold ListNoDup
  intro x
  have xsNat := listCount.natural at A, x, xs with *
  have ysNat := listCount.natural at A, x, ys with *
  rw listCount.append
  have alternatives : x ∈ listSupport{A}(xs) ∨ ¬(x ∈ listSupport{A}(xs)) by tauto
  cases alternatives with member | absent
  . have other := disjoint with x, member
    have zero := listCount.zero_of_absent with other
    have bound := first with x
    rw zero
    arith
  . have zero := listCount.zero_of_absent with absent
    have bound := second with x
    rw zero
    arith

theorem ListNoDup.append_left (A : Set) (xs ys : List(A))
  requires nodup : ListNoDup(A, append(ys, xs))
  shows ListNoDup(A, xs)
proof
  have prefix := ListPrefix.append at A, xs, ys with *
  exact ListNoDup.prefix with prefix, nodup

theorem ListNoDup.append_right (A : Set) (xs ys : List(A))
  requires nodup : ListNoDup(A, append(ys, xs))
  shows ListNoDup(A, ys)
proof
  have suffix := ListSuffix.append at A, ys, xs with *
  exact ListNoDup.suffix with suffix, nodup

theorem ListNoDup.append_disjoint_supports (A : Set) (xs ys : List(A))
  requires nodup : ListNoDup(A, append(ys, xs))
  shows ∀ x ∈ listSupport{A}(xs), ¬(x ∈ listSupport{A}(ys))
proof
  intros x member other
  have bound := nodup with x
  have left := listCount.positive_of_mem with member
  have right := listCount.positive_of_mem with other
  have xsNat := listCount.natural at A, x, xs with *
  have ysNat := listCount.natural at A, x, ys with *
  rw listCount.append at bound
  arith

theorem ListNoDup.replicate (A x : Set) (n : Nat)
  requires element : x ∈ A
  requires nodup : ListNoDup(A, listReplicate(n, x))
  shows n ≤ 1
proof
  have list := listReplicate.closed at A, x, n with element
  have bound := nodup with x
  rwa listCount.replicate_self at bound

theorem ListNoDup.range (n : Nat)
  shows ListNoDup(ℕ, listRange(n))
proof
  have list := listRange.closed at n with *
  unfold ListNoDup
  intro x
  have alternatives : x ∈ listSupport{ℕ}(listRange(n)) ∨ ¬(x ∈ listSupport{ℕ}(listRange(n))) by tauto
  cases alternatives with member | absent
  . have both := listRange.mem_support_iff.forward at n, x with member
    obtain ⟨xNat, below⟩ := both
    have one := listRange.count_below at n, x with below
    rw one
    arith
  . have zero := listCount.zero_of_absent with absent
    rw zero
    arith
