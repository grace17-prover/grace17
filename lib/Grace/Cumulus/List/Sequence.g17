-- Lists as finite sequences: a function on a natural number n is the
-- entry map of a list of length n, read through the coefficient window
-- Part of Cumulus, the Grace17 mathematics library.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module Grace.Cumulus.List.Sequence
import Algebra.IndexedLists

-- The window laws need the values only at the positions read.
theorem coefficientWindow.closed_below (A f : Set, start n : Nat)
  requires values : ∀ k, Nat(k) → k < n → f(start + k) ∈ A
  shows List(A, coefficientWindow(f, start, n))
proof
  induction n generalizing start
  | zero =>
    intros start startNat values
    rw coefficientWindow
    typecheck
  | succ(k) using ih =>
    intros start startNat values
    have zeroNat : Nat(0) by typecheck
    have below : 0 < succ(k) by arith
    have head := values with 0, zeroNat, below
    rw add.right_unit at head
    have shifted : ∀ j, Nat(j) → j < k → f(succ(start) + j) ∈ A
      intros j jNat bound
      have successorNat : Nat(succ(j)) by typecheck
      have bound2 : succ(j) < succ(k) by arith
      have value := values with succ(j), successorNat, bound2
      have shift : succ(start) + j = start + succ(j) by simp [add, add.succ_right]
      rw shift
      exact value
    have tail := ih with succ(start), shifted
    rw coefficientWindow
    typecheck

theorem coefficientWindow.length_below (A f : Set, start n : Nat)
  requires values : ∀ k, Nat(k) → k < n → f(start + k) ∈ A
  shows length{A}(coefficientWindow(f, start, n)) = n
proof
  induction n generalizing start
  | zero =>
    intros start startNat values
    rw [coefficientWindow, length.nil]
    rfl
  | succ(k) using ih =>
    intros start startNat values
    have zeroNat : Nat(0) by typecheck
    have below : 0 < succ(k) by arith
    have head := values with 0, zeroNat, below
    rw add.right_unit at head
    have shifted : ∀ j, Nat(j) → j < k → f(succ(start) + j) ∈ A
      intros j jNat bound
      have successorNat : Nat(succ(j)) by typecheck
      have bound2 : succ(j) < succ(k) by arith
      have value := values with succ(j), successorNat, bound2
      have shift : succ(start) + j = start + succ(j) by simp [add, add.succ_right]
      rw shift
      exact value
    have tail := coefficientWindow.closed_below at A, f, succ(start), k with shifted
    have length := ih with succ(start), shifted
    rw [coefficientWindow, length.cons, length]
    rfl

theorem coefficientWindow.coefficient_below (A z f : Set, start n k : Nat)
  requires values : ∀ j, Nat(j) → j < n → f(start + j) ∈ A
  requires bound : k < n
  shows listCoefficient{A}(z, coefficientWindow(f, start, n), k) = f(start + k)
proof
  induction n generalizing start k
  | zero =>
    intros start k startNat kNat values bound
    exfalso
    arith
  | succ(t) using ih =>
    intros start k startNat kNat values bound
    have zeroNat : Nat(0) by typecheck
    have below : 0 < succ(t) by arith
    have head := values with 0, zeroNat, below
    rw add.right_unit at head
    have shifted : ∀ j, Nat(j) → j < t → f(succ(start) + j) ∈ A
      intros j jNat jBound
      have successorNat : Nat(succ(j)) by typecheck
      have bound2 : succ(j) < succ(t) by arith
      have value := values with succ(j), successorNat, bound2
      have shift : succ(start) + j = start + succ(j) by simp [add, add.succ_right]
      rw shift
      exact value
    have tail := coefficientWindow.closed_below at A, f, succ(start), t with shifted
    have shape := natural.zero_or_successor at k with *
    cases shape with zero | successor
    . rw [zero, coefficientWindow, listCoefficient.zero, add.right_unit]
      rfl
    . obtain ⟨r, rNat, equal⟩ := successor
      rw equal at bound
      have smaller : r < t by arith
      have result := ih with succ(start), r, rNat, shifted, smaller
      have shift : succ(start) + r = start + succ(r) by simp [add, add.succ_right]
      rw [equal, coefficientWindow, listCoefficient.succ, result, shift]
      rfl

-- Every function on a natural number n into A is the entry map of a list
-- of length n.
theorem List.of_function (A f z : Set, n : Nat)
  requires function : f : n → A
  shows ∃ xs, List(A, xs) ∧ length{A}(xs) = n ∧
    (∀ k, Nat(k) → k < n → listCoefficient{A}(z, xs, k) = f(k))
proof
  have values : ∀ k, Nat(k) → k < n → f(0 + k) ∈ A
    intros k kNat bound
    have member := membership.of_Less with kNat, bound
    have shift : 0 + k = k
      rw add.commutative
      exact add.right_unit
    rw shift
    exact FunctionBetween.apply_closed with function, member
  witness coefficientWindow(f, 0, n)
  have closed := coefficientWindow.closed_below with values
  have length := coefficientWindow.length_below with values
  refine ⟨closed, length, ?_⟩
  intros k kNat bound
  have entry := coefficientWindow.coefficient_below at A, z, f, 0, n, k with values, bound
  have shift : 0 + k = k
    rw add.commutative
    exact add.right_unit
  rwa shift at entry
