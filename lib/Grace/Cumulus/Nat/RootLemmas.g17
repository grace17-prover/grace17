module Grace.Cumulus.Nat.RootLemmas
import Root
import OrderLemmas

-- Section: Cancelling powers
-- Equal exponents cancel: a ^ s ≤ b ^ s gives a ≤ b.
theorem pow.base_cancel (a b s : Nat)
  requires positive : 1 ≤ s
  requires below : a ^ s ≤ b ^ s
  shows a ≤ b
proof
  have pa := pow.closed at a, s
  have pb := pow.closed at b, s
  have grows := rootNat.monotone at s, a ^ s, b ^ s with positive, below
  have ra := rootNat.pow at s, a with positive
  have rb := rootNat.pow at s, b with positive
  rw [ra, rb] at grows
  exact grows

-- A base above 1 cancels: b ^ m ≤ b ^ n gives m ≤ n.
theorem pow.exponent_cancel (b m n : Nat)
  requires above : 1 < b
  requires below : b ^ m ≤ b ^ n
  shows m ≤ n
proof
  have split := Less.or_LessEqual at n, m
  cases split with larger | atMost
  . have grows := pow.exponent_strict at b, n, m with above, larger
    have pm := pow.closed at b, m
    have pn := pow.closed at b, n
    have notBelow := LessEqual.not_Less at b ^ m, b ^ n with below
    exfalso
    exact notBelow with grows
  . exact atMost

-- Section: Bounds by the root
-- 1 ≤ ⌊n^(1/q)⌋ for 1 ≤ n.
theorem rootNat.ge_one (q n : Nat)
  requires positive : 1 ≤ q
  requires one : 1 ≤ n
  shows 1 ≤ rootNat(q, n)
proof
  have unit := pow.one_left at q
  have adjunction := rootNat.le_iff at q, n, 1 with positive
  rw unit at adjunction
  exact adjunction.backward with one

-- The floor costs at most a factor 2 ^ q:
-- n ≤ 2 ^ q · ⌊n^(1/q)⌋ ^ q for 1 ≤ n.
theorem rootNat.pow_lower (q n : Nat)
  requires positive : 1 ≤ q
  requires one : 1 ≤ n
  shows n ≤ 2 ^ q * rootNat(q, n) ^ q
proof
  have rNat := rootNat.natural at q, n with positive
  have rOne := rootNat.ge_one at q, n with positive, one
  have above := rootNat.lt_succ_pow at q, n with positive
  have step := LessEqual.add_monotone_left at
    1, rootNat(q, n), rootNat(q, n) with rOne
  have twice : rootNat(q, n) + rootNat(q, n) = 2 * rootNat(q, n) by ring
  rw twice at step
  have grows := pow.base_monotone at
    rootNat(q, n) + 1, 2 * rootNat(q, n), q with step
  have split := pow.mul_base at 2, rootNat(q, n), q
  rw split at grows
  have succPow := pow.closed at rootNat(q, n) + 1, q
  have twoPow := pow.closed at 2, q
  have rootPow := pow.closed at rootNat(q, n), q
  have strict := Less.transitive_LessEqual at n, (rootNat(q, n) + 1) ^ q,
    2 ^ q * rootNat(q, n) ^ q with above, grows
  have succ := Less.add_one_le_of_lt at n, 2 ^ q * rootNat(q, n) ^ q with strict
  have self := LessEqual.add_one at n
  exact LessEqual.transitive at n, n + 1, 2 ^ q * rootNat(q, n) ^ q with
    self, succ

-- Section: Roots of products
-- ⌊X^(1/q)⌋ · ⌊Y^(1/q)⌋ ≤ ⌊(X · Y)^(1/q)⌋.
theorem rootNat.mul_lower (q X Y : Nat)
  requires positive : 1 ≤ q
  shows rootNat(q, X) * rootNat(q, Y) ≤ rootNat(q, X * Y)
proof
  have xNat := rootNat.natural at q, X with positive
  have yNat := rootNat.natural at q, Y with positive
  have xBelow := rootNat.pow_le at q, X with positive
  have yBelow := rootNat.pow_le at q, Y with positive
  have xPow := pow.closed at rootNat(q, X), q
  have yPow := pow.closed at rootNat(q, Y), q
  have both := LessEqual.mul at rootNat(q, X) ^ q, X, rootNat(q, Y) ^ q, Y with
    xBelow, yBelow
  have split := pow.mul_base at rootNat(q, X), rootNat(q, Y), q
  rw ← split at both
  have adjunction := rootNat.le_iff at
    q, X * Y, rootNat(q, X) * rootNat(q, Y) with positive
  exact adjunction.backward with both

-- ⌊(X · Y)^(1/q)⌋ < (⌊X^(1/q)⌋ + 1) · (⌊Y^(1/q)⌋ + 1).
theorem rootNat.mul_upper (q X Y : Nat)
  requires positive : 1 ≤ q
  shows rootNat(q, X * Y) < (rootNat(q, X) + 1) * (rootNat(q, Y) + 1)
proof
  have xNat := rootNat.natural at q, X with positive
  have yNat := rootNat.natural at q, Y with positive
  have xAbove := rootNat.lt_succ_pow at q, X with positive
  have yAbove := rootNat.lt_succ_pow at q, Y with positive
  have xPow := pow.closed at rootNat(q, X) + 1, q
  have yPow := pow.closed at rootNat(q, Y) + 1, q
  have both := Less.mul at X, (rootNat(q, X) + 1) ^ q, Y, (rootNat(q,
    Y) + 1) ^ q with xAbove, yAbove
  have split := pow.mul_base at rootNat(q, X) + 1, rootNat(q, Y) + 1, q
  rw ← split at both
  have adjunction := rootNat.lt_iff at q, X * Y, (rootNat(q,
    X) + 1) * (rootNat(q, Y) + 1) with positive
  exact adjunction.backward with both

-- A q-th power factors out from below:
-- ⌊X^(1/q)⌋ · Y ≤ ⌊(X · Y ^ q)^(1/q)⌋.
theorem rootNat.mul_pow_lower (q X Y : Nat)
  requires positive : 1 ≤ q
  shows rootNat(q, X) * Y ≤ rootNat(q, X * Y ^ q)
proof
  have rNat := rootNat.natural at q, X with positive
  have rPow := pow.closed at rootNat(q, X), q
  have yPow := pow.closed at Y, q
  have below := rootNat.pow_le at q, X with positive
  have scaled := LessEqual.mul_right at rootNat(q, X) ^ q, X, Y ^ q with below
  have split := pow.mul_base at rootNat(q, X), Y, q
  rw ← split at scaled
  have adjunction := rootNat.le_iff at q, X * Y ^ q, rootNat(q, X) * Y with
    positive
  exact adjunction.backward with scaled

-- And from above, for 1 ≤ Y:
-- ⌊(X · Y ^ q)^(1/q)⌋ < (⌊X^(1/q)⌋ + 1) · Y.
theorem rootNat.mul_pow_upper (q X Y : Nat)
  requires positive : 1 ≤ q
  requires one : 1 ≤ Y
  shows rootNat(q, X * Y ^ q) < (rootNat(q, X) + 1) * Y
proof
  have rNat := rootNat.natural at q, X with positive
  have rPow := pow.closed at rootNat(q, X) + 1, q
  have yPow := pow.closed at Y, q
  have above := rootNat.lt_succ_pow at q, X with positive
  have yPositive := (LessEqual.one_iff_positive at Y).forward with one
  have powPositive := pow.positive at Y, q with yPositive
  have nonzero := Less.ne_zero_of_positive at Y ^ q with powPositive
  have scaled := Less.mul_right at X, (rootNat(q, X) + 1) ^ q, Y ^ q with
    nonzero, above
  have split := pow.mul_base at rootNat(q, X) + 1, Y, q
  rw ← split at scaled
  have adjunction := rootNat.lt_iff at
    q, X * Y ^ q, (rootNat(q, X) + 1) * Y with positive
  exact adjunction.backward with scaled

-- Section: Roots of roots
-- ⌊y^(1/(s·d))⌋ ^ d ≤ ⌊y^(1/s)⌋.
theorem rootNat.mul_index_lower (s d y : Nat)
  requires positive : 1 ≤ s
  requires positiveD : 1 ≤ d
  shows rootNat(s * d, y) ^ d ≤ rootNat(s, y)
proof
  have product := LessEqual.one_le_mul at s, d with positive, positiveD
  have rootNatural := rootNat.natural at s * d, y with product
  have power := pow.closed at rootNat(s * d, y), d
  have below := rootNat.pow_le at s * d, y with product
  have regroup := pow.mul_exponent at rootNat(s * d, y), d, s
  have swap : d * s = s * d by ring
  rw swap at regroup
  rw ← regroup at below
  have adjunction := rootNat.le_iff at s, y, rootNat(s * d, y) ^ d with positive
  exact adjunction.backward with below

-- ⌊y^(1/s)⌋ < (⌊y^(1/(s·d))⌋ + 1) ^ d.
theorem rootNat.mul_index_upper (s d y : Nat)
  requires positive : 1 ≤ s
  requires positiveD : 1 ≤ d
  shows rootNat(s, y) < (rootNat(s * d, y) + 1) ^ d
proof
  have product := LessEqual.one_le_mul at s, d with positive, positiveD
  have rootNatural := rootNat.natural at s * d, y with product
  have power := pow.closed at rootNat(s * d, y) + 1, d
  have above := rootNat.lt_succ_pow at s * d, y with product
  have regroup := pow.mul_exponent at rootNat(s * d, y) + 1, d, s
  have swap : d * s = s * d by ring
  rw swap at regroup
  rw ← regroup at above
  have adjunction := rootNat.lt_iff at s, y, (rootNat(s * d, y) + 1) ^ d with
    positive
  exact adjunction.backward with above
