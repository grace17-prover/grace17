module Grace.Cumulus.Nat.BigO
import OrderLemmas
import Set.Function
import Set.Function.Space

-- From some N on, f(n) ≤ C g(n) for a fixed natural C.
predicate NatBigO (f g : Set) :=
  ∃ C ∈ ℕ, ∃ N ∈ ℕ, ∀ n ∈ ℕ, N ≤ n → f(n) ≤ C * g(n)

defgraph addNatSequence (f g : Set) (n ∈ ℕ) : ℕ := f(n) + g(n)
requires seqF : f : ℕ → ℕ
requires seqG : g : ℕ → ℕ
proof
  have fn := FunctionBetween.apply_closed at f, ℕ, ℕ, n with seqF, member
  have gn := FunctionBetween.apply_closed at g, ℕ, ℕ, n with seqG, member
  typecheck

defgraph mulNatSequence (f g : Set) (n ∈ ℕ) : ℕ := f(n) * g(n)
requires seqF : f : ℕ → ℕ
requires seqG : g : ℕ → ℕ
proof
  have fn := FunctionBetween.apply_closed at f, ℕ, ℕ, n with seqF, member
  have gn := FunctionBetween.apply_closed at g, ℕ, ℕ, n with seqG, member
  typecheck

-- An eventual pointwise bound is a bound with constant 1.
theorem NatBigO.of_le (f g : Set, N : Nat)
  requires seqF : f : ℕ → ℕ
  requires seqG : g : ℕ → ℕ
  requires below : ∀ n ∈ ℕ, N ≤ n → f(n) ≤ g(n)
  shows NatBigO(f, g)
proof
  have oneMember : 1 ∈ ℕ by typecheck
  have NMember : N ∈ ℕ by typecheck
  refine ⟨1, oneMember, N, NMember, ?_⟩
  intros n member large
  have gn := FunctionBetween.apply_closed at g, ℕ, ℕ, n with seqG, member
  have gNat := nat.omega.backward with gn
  have bound := below with member, large
  have unit := mul.left_unit at g(n)
  rwa unit

theorem NatBigO.refl (f : Set)
  requires seqF : f : ℕ → ℕ
  shows NatBigO(f, f)
proof
  have oneMember : 1 ∈ ℕ by typecheck
  have zeroMember : 0 ∈ ℕ by typecheck
  refine ⟨1, oneMember, 0, zeroMember, ?_⟩
  intros n member _
  have fn := FunctionBetween.apply_closed at f, ℕ, ℕ, n with seqF, member
  have fNat := nat.omega.backward with fn
  have unit := mul.left_unit at f(n)
  rw unit
  exact LessEqual.reflexive at f(n)

theorem NatBigO.trans (f g h : Set)
  requires seqF : f : ℕ → ℕ
  requires seqG : g : ℕ → ℕ
  requires seqH : h : ℕ → ℕ
  requires fg : NatBigO(f, g)
  requires gh : NatBigO(g, h)
  shows NatBigO(f, h)
proof
  obtain ⟨C, CMember, N, NMember, fBelow⟩ := fg
  obtain ⟨D, DMember, M, MMember, gBelow⟩ := gh
  have CNat := nat.omega.backward with CMember
  have DNat := nat.omega.backward with DMember
  have NNat := nat.omega.backward with NMember
  have MNat := nat.omega.backward with MMember
  have productMember : C * D ∈ ℕ by typecheck
  have sumMember : N + M ∈ ℕ by typecheck
  refine ⟨C * D, productMember, N + M, sumMember, ?_⟩
  intros n member large
  have gn := FunctionBetween.apply_closed at g, ℕ, ℕ, n with seqG, member
  have hn := FunctionBetween.apply_closed at h, ℕ, ℕ, n with seqH, member
  have gNat := nat.omega.backward with gn
  have hNat := nat.omega.backward with hn
  have fLarge : N ≤ n by arith
  have gLarge : M ≤ n by arith
  have fBound := fBelow with member, fLarge
  have gBound := gBelow with member, gLarge
  have scaled := LessEqual.mul_left at g(n), D * h(n), C with gBound
  have regroup : C * (D * h(n)) = C * D * h(n) by ring
  rw regroup at scaled
  arith

-- Bounds survive reindexing by any p with p(n) ≥ n.
theorem NatBigO.compose (f g p : Set)
  requires seqF : f : ℕ → ℕ
  requires seqG : g : ℕ → ℕ
  requires reindex : p : ℕ → ℕ
  requires grows : ∀ n ∈ ℕ, n ≤ p(n)
  requires bound : NatBigO(f, g)
  shows NatBigO(compose(f, p, ℕ, ℕ, ℕ), compose(g, p, ℕ, ℕ, ℕ))
proof
  obtain ⟨C, CMember, N, NMember, below⟩ := bound
  refine ⟨C, CMember, N, NMember, ?_⟩
  intros n member large
  have pn := FunctionBetween.apply_closed at p, ℕ, ℕ, n with reindex, member
  have pNat := nat.omega.backward with pn
  have nNat := nat.omega.backward with member
  have NNat := nat.omega.backward with NMember
  have farther := grows with member
  have pLarge : N ≤ p(n) by arith
  have atP := below with pn, pLarge
  have fValue := compose.apply at f, p, ℕ, ℕ, ℕ, n with seqF, reindex, member
  have gValue := compose.apply at g, p, ℕ, ℕ, ℕ, n with seqG, reindex, member
  rw [fValue, gValue]
  exact atP

theorem NatBigO.add (f g h : Set)
  requires seqF : f : ℕ → ℕ
  requires seqG : g : ℕ → ℕ
  requires seqH : h : ℕ → ℕ
  requires fh : NatBigO(f, h)
  requires gh : NatBigO(g, h)
  shows NatBigO(addNatSequence(f, g), h)
proof
  obtain ⟨C, CMember, N, NMember, fBelow⟩ := fh
  obtain ⟨D, DMember, M, MMember, gBelow⟩ := gh
  have CNat := nat.omega.backward with CMember
  have DNat := nat.omega.backward with DMember
  have NNat := nat.omega.backward with NMember
  have MNat := nat.omega.backward with MMember
  have sumMember : C + D ∈ ℕ by typecheck
  have thresholdMember : N + M ∈ ℕ by typecheck
  refine ⟨C + D, sumMember, N + M, thresholdMember, ?_⟩
  intros n member large
  have fn := FunctionBetween.apply_closed at f, ℕ, ℕ, n with seqF, member
  have gn := FunctionBetween.apply_closed at g, ℕ, ℕ, n with seqG, member
  have hn := FunctionBetween.apply_closed at h, ℕ, ℕ, n with seqH, member
  have fNat := nat.omega.backward with fn
  have gNat := nat.omega.backward with gn
  have hNat := nat.omega.backward with hn
  have fLarge : N ≤ n by arith
  have gLarge : M ≤ n by arith
  have fBound := fBelow with member, fLarge
  have gBound := gBelow with member, gLarge
  have value := addNatSequence.value at f, g, n with seqF, seqG, member
  rw value
  have distribute : (C + D) * h(n) = C * h(n) + D * h(n) by ring
  rw distribute
  arith

theorem NatBigO.mul (f g h k : Set)
  requires seqF : f : ℕ → ℕ
  requires seqG : g : ℕ → ℕ
  requires seqH : h : ℕ → ℕ
  requires seqK : k : ℕ → ℕ
  requires fg : NatBigO(f, g)
  requires hk : NatBigO(h, k)
  shows NatBigO(mulNatSequence(f, h), mulNatSequence(g, k))
proof
  obtain ⟨C, CMember, N, NMember, fBelow⟩ := fg
  obtain ⟨D, DMember, M, MMember, hBelow⟩ := hk
  have CNat := nat.omega.backward with CMember
  have DNat := nat.omega.backward with DMember
  have NNat := nat.omega.backward with NMember
  have MNat := nat.omega.backward with MMember
  have productMember : C * D ∈ ℕ by typecheck
  have thresholdMember : N + M ∈ ℕ by typecheck
  refine ⟨C * D, productMember, N + M, thresholdMember, ?_⟩
  intros n member large
  have fn := FunctionBetween.apply_closed at f, ℕ, ℕ, n with seqF, member
  have gn := FunctionBetween.apply_closed at g, ℕ, ℕ, n with seqG, member
  have hn := FunctionBetween.apply_closed at h, ℕ, ℕ, n with seqH, member
  have kn := FunctionBetween.apply_closed at k, ℕ, ℕ, n with seqK, member
  have fNat := nat.omega.backward with fn
  have gNat := nat.omega.backward with gn
  have hNat := nat.omega.backward with hn
  have kNat := nat.omega.backward with kn
  have fLarge : N ≤ n by arith
  have hLarge : M ≤ n by arith
  have fBound := fBelow with member, fLarge
  have hBound := hBelow with member, hLarge
  have product := LessEqual.mul at f(n), C * g(n), h(n), D * k(n) with fBound, hBound
  have fhValue := mulNatSequence.value at f, h, n with seqF, seqH, member
  have gkValue := mulNatSequence.value at g, k, n with seqG, seqK, member
  rw [fhValue, gkValue]
  have regroup : C * g(n) * (D * k(n)) = C * D * (g(n) * k(n)) by ring
  rwa regroup at product

-- A constant factor does not change the order.
theorem NatBigO.const_mul (f : Set, c : Nat)
  requires seqF : f : ℕ → ℕ
  shows NatBigO(mulNatSequence(constantFunction(ℕ, ℕ, c), f), f)
proof
  have cMember : c ∈ ℕ by typecheck
  have constant := constantFunction.function at ℕ, ℕ, c with cMember
  have zeroMember : 0 ∈ ℕ by typecheck
  refine ⟨c, cMember, 0, zeroMember, ?_⟩
  intros n member large
  have value := mulNatSequence.value at constantFunction(ℕ, ℕ, c), f, n with constant, seqF, member
  have constantValue := constantFunction.apply at ℕ, ℕ, n, c with member, cMember
  rw [value, constantValue]
  have fn := FunctionBetween.apply_closed at f, ℕ, ℕ, n with seqF, member
  have fNat := nat.omega.backward with fn
  arith

-- The class O(g): the functions ℕ → ℕ of order at most g.
def bigO (g : Set) : Set := { f ∈ functionSpace(ℕ, ℕ) | NatBigO(f, g) }

theorem bigO.mem_iff (f g : Set)
  shows f ∈ bigO(g) ↔ (f : ℕ → ℕ) ∧ NatBigO(f, g)
proof
  constructor
  . intro member
    obtain ⟨space, bound⟩ := bigO.membership.forward with member
    have function := functionSpace.mem_iff.forward with space
    exact ⟨function, bound⟩
  . intro both
    obtain ⟨function, bound⟩ := both
    have space := functionSpace.mem_iff.backward with function
    have pair : f ∈ functionSpace(ℕ, ℕ) ∧ NatBigO(f, g) := ⟨space, bound⟩
    exact bigO.membership.backward with pair

theorem bigO.self (g : Set)
  requires seqG : g : ℕ → ℕ
  shows g ∈ bigO(g)
proof
  have bound := NatBigO.refl at g with seqG
  have both : (g : ℕ → ℕ) ∧ NatBigO(g, g) := ⟨seqG, bound⟩
  exact bigO.mem_iff.backward with both

-- Transitivity as monotonicity of the class: g ∈ O(h) gives O(g) ⊆ O(h).
theorem bigO.subset (g h : Set)
  requires seqH : h : ℕ → ℕ
  requires member : g ∈ bigO(h)
  shows bigO(g) ⊆ bigO(h)
proof
  obtain ⟨seqG, gh⟩ := bigO.mem_iff.forward with member
  intros f fMember
  obtain ⟨seqF, fg⟩ := bigO.mem_iff.forward with fMember
  have fh := NatBigO.trans at f, g, h with seqF, seqG, seqH, fg, gh
  have both : (f : ℕ → ℕ) ∧ NatBigO(f, h) := ⟨seqF, fh⟩
  exact bigO.mem_iff.backward with both
