module Grace.Cumulus.Nat.Root
import Least
import PowLemmas

-- The bases whose next power exceeds n.
def rootCandidates (q n : Nat) : Set := { r ∈ ℕ | n < (r + 1) ^ q }

theorem rootCandidates.inhabited (q n : Nat)
  requires positive : 1 ≤ q
  shows n ∈ rootCandidates(q, n)
proof
  have one : 1 ≤ n + 1 by arith
  have grows := pow.exponent_monotone at n + 1, 1, q with one, positive
  rw pow.one_right at grows
  have nNat : Nat(n) by typecheck
  have nMember := nat.omega.forward with nNat
  have bound : n < (n + 1) ^ q by arith
  simp [rootCandidates, nMember, bound]

-- The least candidate is the integer q-th root. For q = 0 no base
-- qualifies and the value is 0.
defunique rootNat (q n : Nat) (r ∈ ℕ) :=
  r ^ q ≤ n ∧ n < (r + 1) ^ q
requires positive : 1 ≤ q
proof
  have candidate := rootCandidates.inhabited at q, n with positive
  have inhabited : Nonempty(rootCandidates(q, n)) := ⟨n, candidate⟩
  have naturals : rootCandidates(q, n) ⊆ ℕ by simp
  have least := leastNatural.member with *
  obtain ⟨leastMember, above⟩ := rootCandidates.membership.forward with least
  have leastNat := nat.omega.backward with leastMember
  have shape := natural.zero_or_successor with leastNat
  witness leastNatural(rootCandidates(q, n))
  refine ⟨leastMember, _, above⟩
  cases shape with zero | successor
  . rw zero
    have qPositive : 0 < q by arith
    obtain ⟨p, pNat, shifted⟩ := Less.exists_add_one at 0, q with qPositive
    have exponent : q = p + 1 by arith
    rw exponent
    rw pow.zero_left
    arith
  . obtain ⟨j, jNat, successorEquation⟩ := successor
    have plusOne := add.right_one at j
    rw ← plusOne at successorEquation
    have equation : leastNatural(rootCandidates(q, n)) = j + 1 := successorEquation
    rw equation
    have split := Less.or_LessEqual at n, (j + 1) ^ q
    cases split with jAbove | below
    . have jMember := nat.omega.forward with jNat
      have jCandidate : j ∈ rootCandidates(q, n) by simp [rootCandidates.membership, jMember, jAbove]
      have bound := leastNatural.least at rootCandidates(q, n), j with *
      rw equation at bound
      exfalso
      arith
    . exact below
uniqueness
  intros r rMember rBounds s sMember sBounds
  have rNat := nat.omega.backward with rMember
  have sNat := nat.omega.backward with sMember
  rcases rBounds with ⟨rLower, rUpper⟩
  rcases sBounds with ⟨sLower, sUpper⟩
  have rAtMost : r ≤ s
    have split := Less.or_LessEqual at s, r
    cases split with above | atMost
    . have step : s + 1 ≤ r by arith
      have grows := pow.base_monotone at s + 1, r, q with step
      exfalso
      arith
    . exact atMost
  have sAtMost : s ≤ r
    have split := Less.or_LessEqual at r, s
    cases split with above | atMost
    . have step : r + 1 ≤ s by arith
      have grows := pow.base_monotone at r + 1, s, q with step
      exfalso
      arith
    . exact atMost
  arith

theorem rootNat.natural (q n : Nat)
  requires positive : 1 ≤ q
  shows Nat(rootNat(q, n))
proof
  obtain ⟨member, bounds⟩ := rootNat.selected at q, n with *
  exact nat.omega.backward with member

theorem rootNat.pow_le (q n : Nat)
  requires positive : 1 ≤ q
  shows rootNat(q, n) ^ q ≤ n
proof
  obtain ⟨member, lower, upper⟩ := rootNat.selected at q, n with *
  exact lower

theorem rootNat.lt_succ_pow (q n : Nat)
  requires positive : 1 ≤ q
  shows n < (rootNat(q, n) + 1) ^ q
proof
  obtain ⟨member, lower, upper⟩ := rootNat.selected at q, n with *
  exact upper

-- The bounds characterise the root.
theorem rootNat.eq_of_bounds (q n r : Nat)
  requires positive : 1 ≤ q
  requires lower : r ^ q ≤ n
  requires upper : n < (r + 1) ^ q
  shows rootNat(q, n) = r
proof
  obtain ⟨member, rootLower, rootUpper⟩ := rootNat.selected at q, n with *
  have rNat : Nat(r) by typecheck
  have rMember := nat.omega.forward with rNat
  have unique := rootNat.unique at q, n with positive
  have rootBounds : rootNat(q, n) ^ q ≤ n ∧ n < (rootNat(q, n) + 1) ^ q := ⟨rootLower, rootUpper⟩
  have rBounds : r ^ q ≤ n ∧ n < (r + 1) ^ q := ⟨lower, upper⟩
  exact unique with rootNat(q, n), member, rootBounds, r, rMember, rBounds

-- r ≤ ⌊n^(1/q)⌋ exactly when r ^ q ≤ n.
theorem rootNat.le_iff (q n r : Nat)
  requires positive : 1 ≤ q
  shows r ≤ rootNat(q, n) ↔ r ^ q ≤ n
proof
  have natural := rootNat.natural at q, n with positive
  have lower := rootNat.pow_le at q, n with positive
  have upper := rootNat.lt_succ_pow at q, n with positive
  constructor
  . intro below
    have grows := pow.base_monotone at r, rootNat(q, n), q with below
    arith
  . intro bound
    have split := Less.or_LessEqual at rootNat(q, n), r
    cases split with above | atMost
    . have step : rootNat(q, n) + 1 ≤ r by arith
      have grows := pow.base_monotone at rootNat(q, n) + 1, r, q with step
      exfalso
      arith
    . exact atMost

-- ⌊n^(1/q)⌋ < r exactly when n < r ^ q.
theorem rootNat.lt_iff (q n r : Nat)
  requires positive : 1 ≤ q
  shows rootNat(q, n) < r ↔ n < r ^ q
proof
  have natural := rootNat.natural at q, n with positive
  have adjunction := rootNat.le_iff at q, n, r with positive
  have left := Less.iff_not_LessEqual at rootNat(q, n), r
  have right := Less.iff_not_LessEqual at n, r ^ q
  rw [left, right, adjunction]

theorem rootNat.pow (q r : Nat)
  requires positive : 1 ≤ q
  shows rootNat(q, r ^ q) = r
proof
  have qPositive : 0 < q by arith
  obtain ⟨p, pNat, shifted⟩ := Less.exists_add_one at 0, q with qPositive
  have exponent : q = p + 1 by arith
  have rNat : Nat(r) by typecheck
  have lessSucc : r < r + 1 by arith
  have strict := pow.base_strict at r, r + 1, p with lessSucc
  rw ← exponent at strict
  have lower : r ^ q ≤ r ^ q by arith
  exact rootNat.eq_of_bounds with positive, lower, strict

theorem rootNat.monotone (q n m : Nat)
  requires positive : 1 ≤ q
  requires below : n ≤ m
  shows rootNat(q, n) ≤ rootNat(q, m)
proof
  have natural := rootNat.natural at q, n with positive
  have lower := rootNat.pow_le at q, n with positive
  have bound : rootNat(q, n) ^ q ≤ m by arith
  have adjunction := rootNat.le_iff at q, m, rootNat(q, n) with positive
  exact adjunction.backward with bound

theorem rootNat.le_self (q n : Nat)
  requires positive : 1 ≤ q
  shows rootNat(q, n) ≤ n
proof
  have natural := rootNat.natural at q, n with positive
  have lower := rootNat.pow_le at q, n with positive
  have shape := natural.zero_or_successor at rootNat(q, n)
  cases shape with zero | successor
  . rw zero
    arith
  . have one : 1 ≤ rootNat(q, n)
      obtain ⟨j, jNat, equation⟩ := successor
      have plusOne := add.right_one at j
      rw ← plusOne at equation
      arith
    have grows := pow.exponent_monotone at rootNat(q, n), 1, q with one, positive
    rw pow.one_right at grows
    arith
