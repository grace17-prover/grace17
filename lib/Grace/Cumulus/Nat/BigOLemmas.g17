module Grace.Cumulus.Nat.BigOLemmas
import BigO
import PowLemmas

-- Section: Membership
-- A function ℕ → ℕ with a big-O bound is a member of the class.
theorem bigO.intro (f g : Set)
  requires seqF : f : ℕ → ℕ
  requires bound : NatBigO(f, g)
  shows f ∈ bigO(g)
proof
  have both : (f : ℕ → ℕ) ∧ NatBigO(f, g) := ⟨seqF, bound⟩
  exact bigO.mem_iff.backward with both

-- A member of the class has the bound.
theorem bigO.bound (f g : Set)
  requires member : f ∈ bigO(g)
  shows NatBigO(f, g)
proof
  obtain ⟨seqF, bound⟩ := bigO.mem_iff.forward with member
  exact bound

-- Section: Powers
-- The pointwise power n ↦ f(n) ^ i.
defgraph powNatSequence (f : Set, i : Nat) (n ∈ ℕ) : ℕ := f(n) ^ i
requires seqF : f : ℕ → ℕ
proof
  have fn := FunctionBetween.apply_closed at f, ℕ, ℕ, n with seqF, member
  have fNat := nat.omega.backward with fn
  have closed := pow.closed at f(n), i
  typecheck

-- Powers keep the order: f ∈ O(g) gives f ^ i ∈ O(g ^ i), with constant
-- C ^ i.
theorem NatBigO.pow (f g : Set, i : Nat)
  requires seqF : f : ℕ → ℕ
  requires seqG : g : ℕ → ℕ
  requires bound : NatBigO(f, g)
  shows NatBigO(powNatSequence(f, i), powNatSequence(g, i))
proof
  obtain ⟨C, CMember, N, NMember, below⟩ := bound
  have CNat := nat.omega.backward with CMember
  have closed := pow.closed at C, i
  have powerMember : C ^ i ∈ ℕ by typecheck
  refine ⟨C ^ i, powerMember, N, NMember, ?_⟩
  intros n member large
  have fn := FunctionBetween.apply_closed at f, ℕ, ℕ, n with seqF, member
  have gn := FunctionBetween.apply_closed at g, ℕ, ℕ, n with seqG, member
  have fNat := nat.omega.backward with fn
  have gNat := nat.omega.backward with gn
  have fBound := below with member, large
  have fValue := powNatSequence.value at f, i, n with seqF, member
  have gValue := powNatSequence.value at g, i, n with seqG, member
  rw [fValue, gValue]
  have grows := pow.base_monotone at f(n), C * g(n), i with fBound
  have split := pow.mul_base at C, g(n), i
  rwa split at grows

-- Section: Paddings
-- A padding stays within the order of the padded bound: if n ∈ O(t) and
-- n ≤ p(n), then p ∈ O(t ∘ p).
theorem bigO.pad (t p : Set)
  requires seqT : t : ℕ → ℕ
  requires seqP : p : ℕ → ℕ
  requires grows : ∀ n ∈ ℕ, n ≤ p(n)
  requires linear : identity(ℕ) ∈ bigO(t)
  shows p ∈ bigO(compose(t, p, ℕ, ℕ, ℕ))
proof
  have seqI := identity.function at ℕ
  have linearBound := bigO.bound at identity(ℕ), t with linear
  have padBound := NatBigO.compose at identity(ℕ), t, p with
    seqI, seqT, seqP, grows, linearBound
  have padIdentity := compose.identity_left at p, ℕ, ℕ with seqP
  rw padIdentity at padBound
  exact bigO.intro at p, compose(t, p, ℕ, ℕ, ℕ) with seqP, padBound
