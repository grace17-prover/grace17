module Grace.Cumulus.Nat.BitLength
import Log
import OrderLemmas

-- The lengths at which n fits in binary.
def bitCandidates (n : Nat) : Set := { k ∈ ℕ | n < 2 ^ k }

theorem bitCandidates.inhabited (n : Nat)
  shows n ∈ bitCandidates(n)
proof
  have bound := pow.two_gt at n
  have nNat : Nat(n) by typecheck
  have nMember := nat.omega.forward with nNat
  have both : n ∈ ℕ ∧ n < 2 ^ n := ⟨nMember, bound⟩
  exact bitCandidates.membership.backward with both

theorem bitCandidates.naturals (n : Nat)
  shows bitCandidates(n) ⊆ ℕ
proof
  intros k kCandidate
  obtain ⟨kMember, below⟩ := bitCandidates.membership.forward with
    kCandidate
  exact kMember

-- The number of binary digits of n, with bitLength(0) = 0. It is the
-- least k with n < 2 ^ k, so bitLength(n) ≤ k exactly when n < 2 ^ k.
def bitLength (n : Nat) : Set := leastNatural(bitCandidates(n))

-- Section: The defining property
theorem bitLength.member (n : Nat)
  shows bitLength(n) ∈ bitCandidates(n)
proof
  have candidate := bitCandidates.inhabited at n
  have inhabited : Nonempty(bitCandidates(n)) := ⟨n, candidate⟩
  have naturals := bitCandidates.naturals at n
  have least := leastNatural.member with *
  unfold bitLength
  exact least

theorem bitLength.natural (n : Nat)
  shows Nat(bitLength(n))
proof
  have member := bitLength.member at n
  obtain ⟨kMember, below⟩ := bitCandidates.membership.forward with member
  exact nat.omega.backward with kMember

-- n < 2 ^ bitLength(n).
theorem bitLength.lt_pow (n : Nat)
  shows n < 2 ^ bitLength(n)
proof
  have member := bitLength.member at n
  obtain ⟨kMember, below⟩ := bitCandidates.membership.forward with member
  exact below

theorem bitLength.least (n k : Nat)
  requires above : n < 2 ^ k
  shows bitLength(n) ≤ k
proof
  have candidate := bitCandidates.inhabited at n
  have inhabited : Nonempty(bitCandidates(n)) := ⟨n, candidate⟩
  have naturals := bitCandidates.naturals at n
  have kNat : Nat(k) by typecheck
  have kMember := nat.omega.forward with kNat
  have both : k ∈ ℕ ∧ n < 2 ^ k := ⟨kMember, above⟩
  have kCandidate := bitCandidates.membership.backward with both
  have bound := leastNatural.least at bitCandidates(n), k with *
  unfold bitLength
  exact bound

-- The Galois connection with powers of 2: bitLength(n) ≤ k ↔ n < 2 ^ k.
theorem bitLength.le_iff (n k : Nat)
  shows bitLength(n) ≤ k ↔ n < 2 ^ k
proof
  have natural := bitLength.natural at n
  have two : 1 + 1 = 2 by arith
  have one := LessEqual.add_one at 1
  rw two at one
  constructor
  . intro below
    have above := bitLength.lt_pow at n
    have grows := pow.exponent_monotone at 2, bitLength(n), k with one, below
    have lengthPow := pow.closed at 2, bitLength(n)
    have kPow := pow.closed at 2, k
    exact Less.transitive_LessEqual at n, 2 ^ bitLength(n), 2 ^ k with
      above, grows
  . intro above
    exact bitLength.least at n, k with above

-- k < bitLength(n) ↔ 2 ^ k ≤ n.
theorem bitLength.lt_iff (n k : Nat)
  shows k < bitLength(n) ↔ 2 ^ k ≤ n
proof
  have natural := bitLength.natural at n
  have kPow := pow.closed at 2, k
  have adjunction := bitLength.le_iff at n, k
  constructor
  . intro below
    have notAtMost := Less.not_LessEqual at k, bitLength(n) with below
    have notAbove : ¬n < 2 ^ k
      intro above
      have atMost := adjunction.backward with above
      exact notAtMost with atMost
    exact (LessEqual.iff_not_Less at 2 ^ k, n).backward with notAbove
  . intro atLeast
    have notAtMost : ¬bitLength(n) ≤ k
      intro atMost
      have above := adjunction.forward with atMost
      have notAbove := LessEqual.not_Less at 2 ^ k, n with atLeast
      exact notAbove with above
    exact (Less.iff_not_LessEqual at k, bitLength(n)).backward with notAtMost

-- Section: Values and bounds
theorem bitLength.zero
  shows bitLength(0) = 0
proof
  have unit := pow.zero at 2
  have positive := Less.zero_one
  rw ← unit at positive
  have atMost := bitLength.least at 0, 0 with positive
  have natural := bitLength.natural at 0
  exact LessEqual.eq_zero at bitLength(0) with atMost

theorem bitLength.positive (n : Nat)
  requires one : 1 ≤ n
  shows 1 ≤ bitLength(n)
proof
  have natural := bitLength.natural at n
  have unit := pow.zero at 2
  have adjunction := bitLength.lt_iff at n, 0
  rw unit at adjunction
  have positive := adjunction.backward with one
  exact LessEqual.one_of_positive at bitLength(n) with positive

-- 2 ^ bitLength(n) ≤ 2 · n for 1 ≤ n: the length is exact up to one bit.
theorem bitLength.pow_le (n : Nat)
  requires one : 1 ≤ n
  shows 2 ^ bitLength(n) ≤ 2 * n
proof
  have natural := bitLength.natural at n
  have atLeast := bitLength.positive at n with one
  have positive := (LessEqual.one_iff_positive at bitLength(n)).forward with
    atLeast
  obtain ⟨e, eNat, shape⟩ := Less.exists_add_one at 0, bitLength(n) with
    positive
  have zeroPlus : 0 + e + 1 = e + 1 by arith
  rw zeroPlus at shape
  have below := Less.add_one at e
  rw ← shape at below
  have lower := (bitLength.lt_iff at n, e).forward with below
  have ePow := pow.closed at 2, e
  have doubled := LessEqual.mul_left at 2 ^ e, n, 2 with lower
  have step := pow.add_one at 2, e
  rw [shape, step]
  exact doubled

theorem bitLength.monotone (n m : Nat)
  requires below : n ≤ m
  shows bitLength(n) ≤ bitLength(m)
proof
  have natural := bitLength.natural at m
  have above := bitLength.lt_pow at m
  have mPow := pow.closed at 2, bitLength(m)
  have nAbove := LessEqual.transitive_Less at n, m, 2 ^ bitLength(m) with
    below, above
  exact bitLength.least at n, bitLength(m) with nAbove

theorem bitLength.le_self (n : Nat)
  shows bitLength(n) ≤ n
proof
  have bound := pow.two_gt at n
  exact bitLength.least at n, n with bound

theorem bitLength.pow_two (m : Nat)
  shows bitLength(2 ^ m) = m + 1
proof
  have natural := bitLength.natural at 2 ^ m
  have two : 1 + 1 = 2 by arith
  have oneTwo := Less.add_one at 1
  rw two at oneTwo
  have next := Less.add_one at m
  have grows := pow.exponent_strict at 2, m, m + 1 with oneTwo, next
  have atMost := bitLength.least at 2 ^ m, m + 1 with grows
  have mPow := pow.closed at 2, m
  have self := LessEqual.reflexive at 2 ^ m
  have below := (bitLength.lt_iff at 2 ^ m, m).backward with self
  have atLeast := Less.add_one_le_of_lt at m, bitLength(2 ^ m) with below
  exact LessEqual.antisymmetric at bitLength(2 ^ m), m + 1 with atMost, atLeast

-- The length of a product is at most the sum of the lengths.
theorem bitLength.mul (x y : Nat)
  shows bitLength(x * y) ≤ bitLength(x) + bitLength(y)
proof
  have xNatural := bitLength.natural at x
  have yNatural := bitLength.natural at y
  have xAbove := bitLength.lt_pow at x
  have yAbove := bitLength.lt_pow at y
  have xPow := pow.closed at 2, bitLength(x)
  have yPow := pow.closed at 2, bitLength(y)
  have both := Less.mul at x, 2 ^ bitLength(x), y, 2 ^ bitLength(y) with
    xAbove, yAbove
  have split := pow.add at 2, bitLength(y), bitLength(x)
  rw ← split at both
  exact bitLength.least at x * y, bitLength(x) + bitLength(y) with both

-- The length of a power: bitLength(n ^ d) ≤ d · bitLength(n) for 1 ≤ d.
theorem bitLength.pow_bound (n d : Nat)
  requires positiveD : 1 ≤ d
  shows bitLength(n ^ d) ≤ d * bitLength(n)
proof
  have natural := bitLength.natural at n
  have above := bitLength.lt_pow at n
  have positive := (LessEqual.one_iff_positive at d).forward with positiveD
  obtain ⟨e, eNat, shape⟩ := Less.exists_add_one at 0, d with positive
  have zeroPlus : 0 + e + 1 = e + 1 by arith
  rw zeroPlus at shape
  have grows := pow.base_strict at n, 2 ^ bitLength(n), e with above
  rw ← shape at grows
  have regroup := pow.mul_exponent at 2, bitLength(n), d
  rw regroup at grows
  have swap : bitLength(n) * d = d * bitLength(n) by ring
  rw swap at grows
  exact bitLength.least at n ^ d, d * bitLength(n) with grows

-- Section: The logarithm
-- For 1 ≤ n, bitLength(n) = ⌊log₂ n⌋ + 1.
theorem bitLength.eq_logNat (n : Nat)
  requires one : 1 ≤ n
  shows bitLength(n) = logNat(2, n) + 1
proof
  have natural := bitLength.natural at n
  have base := LessEqual.reflexive at 2
  have logNatural := logNat.natural at 2, n with base, one
  have upper := logNat.lt_pow_succ at 2, n with base, one
  have lower := logNat.pow_le at 2, n with base, one
  have atMost := bitLength.least at n, logNat(2, n) + 1 with upper
  have below := (bitLength.lt_iff at n, logNat(2, n)).backward with lower
  have atLeast := Less.add_one_le_of_lt at logNat(2, n), bitLength(n) with
    below
  exact LessEqual.antisymmetric at bitLength(n), logNat(2, n) + 1 with
    atMost, atLeast
