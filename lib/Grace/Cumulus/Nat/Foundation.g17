module Grace.Cumulus.Nat.Foundation
import Core.Nat
import Set.Ordinal

-- Natural numbers compute compactly, while these theorems expose their
-- von Neumann set interpretation whenever a proof needs raw membership.
lemma membership.successor (m n : Nat)
  shows m ∈ succ(n) ↔ (m ∈ n ∨ m = n)
proof
  simp

lemma membership.successor_set (x : Set) {n : Nat}
  shows x ∈ succ(n) ↔ (x ∈ n ∨ x = n)
proof
  simp

lemma membership.successor_forward (x : Set) {n : Nat}
  requires h : x ∈ succ(n)
  shows x ∈ n ∨ x = n
proof
  simp

lemma membership.successor_backward (x : Set) {n : Nat}
  requires h : x ∈ n ∨ x = n
  shows x ∈ succ(n)
proof
  simp

-- Every position in a finite ordinal is itself a natural number.
theorem natural.member (n : Nat)
  shows ∀ i ∈ n, Nat(i)
proof
  induction n
  | zero =>
    intros i hi
    rw nat.zero at hi
    exfalso
    exact set.empty with hi
  | succ(k) using ih =>
    intros i hi
    have alternatives := membership.successor_forward{n := k} with hi
    cases alternatives with before | equal
    . exact ih with i, before
    . rw equal
      assumption

lemma membership.self_successor (n : Nat)
  shows n ∈ succ(n)
proof
  simp

lemma membership.two_in_five
  shows 2 ∈ 5
proof
  simp [next.natural, next.membership]

theorem membership.one (x : Set)
  shows x ∈ 1 ↔ x = 0
proof
  have successorZero := next.natural at 0
  rw successorZero
  simp [next.membership, nat.zero, set.empty]

theorem membership.two (x : Set)
  shows x ∈ 2 ↔ (x = 0 ∨ x = 1)
proof
  have split := membership.successor_set{n := 1} at x
  have one := membership.one at x
  tauto

theorem natural.zero_one_or_above_one (n : Nat)
  shows n = 0 ∨ n = 1 ∨ 1 ∈ n
proof
  induction n
  | zero =>
    left
    rfl
  | succ(k) using ih =>
    cases ih with hkZero | hkRest
    . right
      left
      rw hkZero
      rfl
    . cases hkRest with hkOne | hkAbove
      . right
        right
        rw hkOne
        settle with membership.successor,
          Naturals.constructor.zero, Naturals.constructor.succ
      . right
        right
        settle with membership.successor, hkAbove,
          Naturals.constructor.zero, Naturals.constructor.succ

theorem natural.zero_or_successor (n : Nat)
  shows n = 0 ∨ ∃ k, Nat(k) ∧ n = succ(k)
proof
  induction n
  | zero =>
    left
    rfl
  | succ(k) using ih =>
    right
    refine ⟨k, assumption, rfl⟩

-- Every member of a natural number is a natural number.
theorem natural.member_natural (n : Nat)
  shows ∀ x ∈ n, Nat(x)
proof
  induction n
  | zero =>
    intros x hx
    have z := nat.zero
    rw z at hx
    exfalso
    exact set.empty with hx
  | succ(k) using ih =>
    intros x hx
    have d := membership.successor_forward{n := k} with hx
    cases d with inner | same
    . exact ih with x, inner
    . rw same
      assumption

-- ω, the set of all natural numbers, is an ordinal: it is transitive, and
-- so is each of its members.
theorem Ordinal.omega
  shows ω ∈ Ordinal
proof
  constructor
    intros n hn x hx
    have hnat := nat.omega.backward with hn
    have members := natural.member_natural with hnat
    have xnat := members with x, hx
    exact nat.omega.forward with xnat
  . intros n hn
    have hnat := nat.omega.backward with hn
    have ord := Ordinal.natural with hnat
    exact Ordinal.transitive with ord

-- ω is a limit ordinal: nonempty and closed under successor.
theorem Limit.omega
  shows Limit(ω)
proof
  constructor
  . exact Ordinal.omega
  . constructor
    . intro e
      have zeroNat := Naturals.constructor.zero
      have z := nat.omega.forward with zeroNat
      rw e at z
      exact set.empty with z
    . intros n hn
      have hnat := nat.omega.backward with hn
      have step := next.natural with hnat
      rw ← step
      have snat := Naturals.constructor.succ with hnat
      exact nat.omega.forward with snat
