module Grace.Cumulus.Nat.OrderLemmas
import Order

theorem LessEqual.of_eq (a b : Nat)
  requires same : a = b
  shows a ≤ b
proof
  rw same
  exact LessEqual.reflexive with *

theorem LessEqual.exists_add (a b : Nat)
  requires below : a ≤ b
  shows ∃ k, Nat(k) ∧ b = a + k
proof
  obtain ⟨k, kNat, equation⟩ := below
  witness k
  symm
  exact equation

theorem Less.ne (a b : Nat)
  requires below : a < b
  shows a ≠ b
proof
  intro same
  rw same at below
  have excluded := Less.irreflexive at b
  exact excluded with below

theorem Less.ne_reverse (a b : Nat)
  requires below : a < b
  shows b ≠ a
proof
  intro same
  rw same at below
  have excluded := Less.irreflexive at a
  exact excluded with below

theorem Less.of_LessEqual_ne (a b : Nat)
  requires below : a ≤ b
  requires distinct : a ≠ b
  shows a < b
proof
  have comparison := Less.trichotomy at a, b with *
  rcases comparison with less | equal | greater
  . exact less
  . exfalso
    exact distinct with equal
  . have weak := Less.implies_LessEqual with greater
    have same := LessEqual.antisymmetric with below, weak
    exfalso
    exact distinct with same

theorem Less.iff_LessEqual_ne (a b : Nat)
  shows a < b ↔ a ≤ b ∧ a ≠ b
proof
  constructor
  . intro below
    exact ⟨Less.implies_LessEqual with below, Less.ne with below⟩
  . intro both
    exact Less.of_LessEqual_ne with both.left, both.right

theorem LessEqual.cases (a b : Nat)
  requires below : a ≤ b
  shows a < b ∨ a = b
proof
  have split : a = b ∨ a ≠ b by tauto
  cases split with same | distinct
  . right
    exact same
  . left
    exact Less.of_LessEqual_ne with *

theorem LessEqual.iff_Less_or_eq (a b : Nat)
  shows a ≤ b ↔ a < b ∨ a = b
proof
  constructor
  . intro below
    exact LessEqual.cases with below
  . intro split
    cases split with less | same
    . exact Less.implies_LessEqual with less
    . exact LessEqual.of_eq with same

theorem LessEqual.not_Less (a b : Nat)
  requires below : a ≤ b
  shows ¬b < a
proof
  intro above
  have cycle := Less.transitive_LessEqual with above, below
  have excluded := Less.irreflexive at b
  exact excluded with cycle

theorem Less.not_LessEqual (a b : Nat)
  requires below : a < b
  shows ¬b ≤ a
proof
  intro above
  have cycle := Less.transitive_LessEqual with below, above
  have excluded := Less.irreflexive at a
  exact excluded with cycle

theorem Less.asymmetric (a b : Nat)
  requires below : a < b
  shows ¬b < a
proof
  exact LessEqual.not_Less with (Less.implies_LessEqual with below)

theorem LessEqual.iff_not_Less (a b : Nat)
  shows a ≤ b ↔ ¬b < a
proof
  constructor
  . intro below
    exact LessEqual.not_Less with below
  . intro notAbove
    exact LessEqual.of_not_Less with notAbove

theorem Less.iff_not_LessEqual (a b : Nat)
  shows a < b ↔ ¬b ≤ a
proof
  constructor
  . intro below
    exact Less.not_LessEqual with below
  . intro notAbove
    exact Less.of_not_LessEqual with notAbove

theorem LessEqual.antisymmetric_iff (a b : Nat)
  shows a = b ↔ a ≤ b ∧ b ≤ a
proof
  constructor
  . intro same
    constructor
    . exact LessEqual.of_eq with same
    . symm at same
      exact LessEqual.of_eq with same
  . intro both
    exact LessEqual.antisymmetric with both.left, both.right

theorem Less.or_LessEqual (a b : Nat)
  shows a < b ∨ b ≤ a
proof
  have split : a < b ∨ ¬a < b by tauto
  cases split with less | notLess
  . left
    exact less
  . right
    exact LessEqual.of_not_Less with notLess

theorem Less.not_below_zero (a : Nat)
  shows ¬a < 0
proof
  intro below
  have zero : 0 ≤ a by linarith
  exact Less.not_LessEqual with below, zero

theorem LessEqual.eq_zero (a : Nat)
  requires below : a ≤ 0
  shows a = 0
proof
  have zero : 0 ≤ a by linarith
  exact LessEqual.antisymmetric with below, zero

theorem LessEqual.zero_iff (a : Nat)
  shows a ≤ 0 ↔ a = 0
proof
  constructor
  . intro below
    exact LessEqual.eq_zero with below
  . intro zero
    rw zero
    exact LessEqual.reflexive with *

theorem Less.positive_of_ne_zero (a : Nat)
  requires nonzero : a ≠ 0
  shows 0 < a
proof
  have zero : 0 ≤ a by linarith
  have distinct : 0 ≠ a
    intro same
    symm at same
    exact nonzero with same
  exact Less.of_LessEqual_ne with zero, distinct

theorem Less.ne_zero_of_positive (a : Nat)
  requires positive : 0 < a
  shows a ≠ 0
proof
  exact Less.ne_reverse with positive

theorem Less.positive_iff (a : Nat)
  shows 0 < a ↔ a ≠ 0
proof
  constructor
  . intro positive
    exact Less.ne_zero_of_positive with positive
  . intro nonzero
    exact Less.positive_of_ne_zero with nonzero

theorem LessEqual.one_of_positive (a : Nat)
  requires positive : 0 < a
  shows 1 ≤ a
proof
  linarith

theorem LessEqual.one_iff_positive (a : Nat)
  shows 1 ≤ a ↔ 0 < a
proof
  constructor
  . intro one
    linarith
  . intro positive
    linarith

theorem LessEqual.one_iff_ne_zero (a : Nat)
  shows 1 ≤ a ↔ a ≠ 0
proof
  constructor
  . intro one
    have positive : 0 < a by linarith
    exact Less.ne_zero_of_positive with positive
  . intro nonzero
    have positive := Less.positive_of_ne_zero with nonzero
    linarith

theorem Less.zero_one
  shows 0 < 1
proof
  linarith

theorem Less.add_one (a : Nat)
  shows a < a + 1
proof
  linarith

theorem LessEqual.add_one (a : Nat)
  shows a ≤ a + 1
proof
  linarith

theorem Less.add_one_iff (a b : Nat)
  shows a < b + 1 ↔ a ≤ b
proof
  constructor
  . intro below
    linarith
  . intro below
    linarith

theorem LessEqual.add_one_iff (a b : Nat)
  shows a + 1 ≤ b + 1 ↔ a ≤ b
proof
  constructor
  . intro below
    linarith
  . intro below
    linarith

theorem Less.add_one_both_iff (a b : Nat)
  shows a + 1 < b + 1 ↔ a < b
proof
  constructor
  . intro below
    linarith
  . intro below
    linarith

theorem LessEqual.add_left_self (a k : Nat)
  shows a ≤ k + a
proof
  linarith

theorem LessEqual.add_monotone_left (a b c : Nat)
  requires below : a ≤ b
  shows c + a ≤ c + b
proof
  linarith

theorem LessEqual.add_right_iff (a b c : Nat)
  shows a + c ≤ b + c ↔ a ≤ b
proof
  constructor
  . intro below
    exact LessEqual.add_right_cancel with below
  . intro below
    linarith

theorem LessEqual.add_left_iff (a b c : Nat)
  shows c + a ≤ c + b ↔ a ≤ b
proof
  constructor
  . intro below
    exact LessEqual.add_left_cancel with below
  . intro below
    linarith

theorem Less.add_monotone_right (a b c : Nat)
  requires below : a < b
  shows a + c < b + c
proof
  linarith

theorem Less.add_monotone_left (a b c : Nat)
  requires below : a < b
  shows c + a < c + b
proof
  linarith

theorem Less.add_left_cancel (a b c : Nat)
  requires below : c + a < c + b
  shows a < b
proof
  linarith

theorem Less.add_right_iff (a b c : Nat)
  shows a + c < b + c ↔ a < b
proof
  constructor
  . intro below
    linarith
  . intro below
    linarith

theorem Less.add_left_iff (a b c : Nat)
  shows c + a < c + b ↔ a < b
proof
  constructor
  . intro below
    linarith
  . intro below
    linarith

theorem LessEqual.of_add_left (a b c : Nat)
  requires below : a + b ≤ c
  shows a ≤ c
proof
  linarith

theorem LessEqual.of_add_right (a b c : Nat)
  requires below : a + b ≤ c
  shows b ≤ c
proof
  linarith

theorem Less.of_add_left (a b c : Nat)
  requires below : a + b < c
  shows a < c
proof
  linarith

theorem Less.of_add_right (a b c : Nat)
  requires below : a + b < c
  shows b < c
proof
  linarith

theorem Less.add_positive_left (a k : Nat)
  requires positive : 0 < k
  shows a < k + a
proof
  linarith

theorem Less.add_positive_right (a k : Nat)
  requires positive : 0 < k
  shows a < a + k
proof
  linarith

theorem LessEqual.double (a : Nat)
  shows a ≤ a + a
proof
  linarith

theorem Less.double_of_positive (a : Nat)
  requires positive : 0 < a
  shows a < a + a
proof
  linarith

theorem LessEqual.mul_right (a b k : Nat)
  requires below : a ≤ b
  shows a * k ≤ b * k
proof
  have left := LessEqual.mul_left at a, b, k with below
  have swapA := mul.commutative at a, k with *
  have swapB := mul.commutative at b, k with *
  rw [swapA, swapB] at left
  exact left

theorem LessEqual.mul (a b c d : Nat)
  requires first : a ≤ b
  requires second : c ≤ d
  shows a * c ≤ b * d
proof
  have left := LessEqual.mul_right at a, b, c with first
  have right := LessEqual.mul_left at c, d, b with second
  exact LessEqual.transitive with left, right

theorem Less.mul_right (a b k : Nat)
  requires positive : k ≠ 0
  requires below : a < b
  shows a * k < b * k
proof
  have left := Less.mul_left at a, b, k with positive, below
  have swapA := mul.commutative at a, k with *
  have swapB := mul.commutative at b, k with *
  rw [swapA, swapB] at left
  exact left

theorem Less.mul (a b c d : Nat)
  requires first : a < b
  requires second : c < d
  shows a * c < b * d
proof
  have bPositive : b ≠ 0
    intro zero
    rw zero at first
    exact Less.not_below_zero with first
  have weak := Less.implies_LessEqual with first
  have left := LessEqual.mul_right at a, b, c with weak
  have right := Less.mul_left at c, d, b with bPositive, second
  exact LessEqual.transitive_Less with left, right

theorem Less.mul_positive (a b : Nat)
  requires first : 0 < a
  requires second : 0 < b
  shows 0 < a * b
proof
  have aNonzero := Less.ne_zero_of_positive with first
  have bNonzero := Less.ne_zero_of_positive with second
  have nonzero := mul.nonzero with aNonzero, bNonzero
  exact Less.positive_of_ne_zero with nonzero

theorem mul.positive_iff (a b : Nat)
  shows 0 < a * b ↔ 0 < a ∧ 0 < b
proof
  constructor
  . intro positive
    have nonzero := Less.ne_zero_of_positive with positive
    constructor
    . apply Less.positive_of_ne_zero
      intro zero
      rw zero at nonzero
      have vanish := mul.left_zero at b
      exact nonzero with vanish
    . apply Less.positive_of_ne_zero
      intro zero
      rw zero at nonzero
      have vanish := mul.right_zero at a
      exact nonzero with vanish
  . intro both
    exact Less.mul_positive with both.left, both.right

theorem mul.eq_zero_iff (a b : Nat)
  shows a * b = 0 ↔ a = 0 ∨ b = 0
proof
  constructor
  . intro zero
    have split : a = 0 ∨ a ≠ 0 by tauto
    cases split with aZero | aNonzero
    . left
      exact aZero
    . right
      have factor := mul.eq_zero with zero
      cases factor with first | second
      . exfalso
        exact aNonzero with first
      . exact second
  . intro split
    cases split with aZero | bZero
    . rw aZero
      exact mul.left_zero with *
    . rw bZero
      exact mul.right_zero with *

theorem LessEqual.mul_left_cancel_positive (a b k : Nat)
  requires positive : k ≠ 0
  requires below : k * a ≤ k * b
  shows a ≤ b
proof
  have split := Less.or_LessEqual at b, a
  cases split with above | fine
  . have strict := Less.mul_left at b, a, k with positive, above
    exfalso
    exact LessEqual.not_Less with below, strict
  . exact fine

theorem LessEqual.mul_right_cancel_positive (a b k : Nat)
  requires positive : k ≠ 0
  requires below : a * k ≤ b * k
  shows a ≤ b
proof
  have swapA := mul.commutative at k, a with *
  have swapB := mul.commutative at k, b with *
  rw [swapA, swapB] at below
  exact LessEqual.mul_left_cancel_positive with positive, below

theorem Less.mul_right_cancel_positive (a b k : Nat)
  requires positive : k ≠ 0
  requires below : a * k < b * k
  shows a < b
proof
  have swapA := mul.commutative at k, a with *
  have swapB := mul.commutative at k, b with *
  rw [swapA, swapB] at below
  exact Less.mul_left_cancel_positive with positive, below

theorem LessEqual.le_mul_left (a k : Nat)
  requires positive : k ≠ 0
  shows a ≤ k * a
proof
  have one := LessEqual.one_iff_ne_zero.backward with positive
  have scaled := LessEqual.mul_right at 1, k, a with one
  have unit := mul.left_unit at a
  rw unit at scaled
  exact scaled

theorem LessEqual.le_mul_right (a k : Nat)
  requires positive : k ≠ 0
  shows a ≤ a * k
proof
  have left := LessEqual.le_mul_left at a, k with positive
  have swap := mul.commutative at a, k with *
  rw swap at left
  exact left

theorem LessEqual.one_le_mul (a b : Nat)
  requires first : 1 ≤ a
  requires second : 1 ≤ b
  shows 1 ≤ a * b
proof
  have product := LessEqual.mul with first, second
  have unit := mul.left_unit at 1
  rw unit at product
  exact product

theorem LessEqual.mul_self (a : Nat)
  shows a ≤ a * a
proof
  have split : a = 0 ∨ a ≠ 0 by tauto
  cases split with zero | nonzero
  . rw zero
    linarith
  . exact LessEqual.le_mul_left with nonzero

theorem mul.eq_one (a b : Nat)
  requires product : a * b = 1
  shows a = 1 ∧ b = 1
proof
  have aNonzero : a ≠ 0
    intro zero
    rw zero at product
    have vanish := mul.left_zero at b
    rw vanish at product
    have impossible : 0 < 0 by linarith
    exact Less.irreflexive with impossible
  have bNonzero : b ≠ 0
    intro zero
    rw zero at product
    have vanish := mul.right_zero at a
    rw vanish at product
    have impossible : 0 < 0 by linarith
    exact Less.irreflexive with impossible
  have aBound := LessEqual.le_mul_right at a, b with bNonzero
  have bBound := LessEqual.le_mul_left at b, a with aNonzero
  rw product at aBound
  rw product at bBound
  have aOne := LessEqual.one_iff_ne_zero.backward with aNonzero
  have bOne := LessEqual.one_iff_ne_zero.backward with bNonzero
  constructor
  . exact LessEqual.antisymmetric with aBound, aOne
  . exact LessEqual.antisymmetric with bBound, bOne

theorem Less.one_lt_iff (a : Nat)
  shows 1 < a ↔ a ≠ 0 ∧ a ≠ 1
proof
  constructor
  . intro above
    constructor
    . intro zero
      rw zero at above
      exact Less.not_below_zero with above
    . exact Less.ne_reverse with above
  . intro both
    have one := LessEqual.one_iff_ne_zero.backward with both.left
    have distinct : 1 ≠ a
      intro same
      symm at same
      exact both.right with same
    exact Less.of_LessEqual_ne with one, distinct

theorem Less.exists_add_one (a b : Nat)
  requires below : a < b
  shows ∃ k, Nat(k) ∧ b = a + k + 1
proof
  obtain ⟨k, kNat, equation⟩ := below
  witness k
  have shape : succ(a) + k = a + k + 1 by ring
  rw shape at equation
  symm
  exact equation

theorem Less.add_one_le_of_lt (a b : Nat)
  requires below : a < b
  shows a + 1 ≤ b
proof
  linarith

theorem Less.of_add_one_le (a b : Nat)
  requires below : a + 1 ≤ b
  shows a < b
proof
  linarith

theorem Less.lt_of_lt_of_eq (a b c : Nat)
  requires below : a < b
  requires same : b = c
  shows a < c
proof
  rw ← same
  exact below

theorem LessEqual.le_of_le_of_eq (a b c : Nat)
  requires below : a ≤ b
  requires same : b = c
  shows a ≤ c
proof
  rw ← same
  exact below
