module Grace.Cumulus.Geometry.Angle
import Distance
import Isosceles

namespace Euclidean
export open Euclidean

-- Section: The cosine of an angle

-- The cosine of the angle at b between the rays to a and c. An unoriented
-- angle in [0, π] is determined by its cosine, so equal cosines are equal
-- angles; no inverse trigonometric function is needed to compare them.
def cosAngle (a b c : Point) : Real := angleDot(a, b, c) / (distance(b, a) * distance(b, c))

theorem cosAngle.real (a b c : Point)
  shows Real(cosAngle(a, b, c))
proof
  typecheck

theorem rayProduct.positive (a b c : Point)
  requires firstRay : a ≠ b
  requires secondRay : c ≠ b
  shows 0 < distance(b, a) * distance(b, c)
proof
  have firstDistinct : b ≠ a
    intro equal
    apply firstRay
    cc
  have secondDistinct : b ≠ c
    intro equal
    apply secondRay
    cc
  have first := distance.positive_of_ne at b, a with *
  have second := distance.positive_of_ne at b, c with *
  exact realMulValue.positive with *

theorem cosAngle.mul_rays (a b c : Point)
  requires firstRay : a ≠ b
  requires secondRay : c ≠ b
  shows cosAngle(a, b, c) * (distance(b, a) * distance(b, c)) = angleDot(a, b, c)
proof
  have positive := rayProduct.positive at a, b, c with *
  have nonzero : distance(b, a) * distance(b, c) ≠ 0
    intro zero
    rw zero at positive
    exact realLess.not_self with realZero.real, positive
  have cancel := realDiv.mul_right at angleDot(a, b, c), distance(b, a) * distance(b, c) with *
  unfold cosAngle
  cc

-- Section: The law of cosines

theorem law_of_cosines (a b c : Point)
  requires firstRay : a ≠ b
  requires secondRay : c ≠ b
  shows Euclidean.distanceSquared(a, c) =
    Euclidean.distanceSquared(a, b) + Euclidean.distanceSquared(b, c) - 2 * (distance(a, b) * distance(b, c) * cosAngle(a, b, c))
proof
  have product := cosAngle.mul_rays at a, b, c with *
  have symmetric := distance.symmetric at b, a with *
  rw symmetric at product
  have identity := cosine_identity at a, b, c with *
  linear_combination identity + product + product

-- Section: Cosines lie in [-1, 1]

theorem cosAngle.le_one (a b c : Point)
  requires firstRay : a ≠ b
  requires secondRay : c ≠ b
  shows cosAngle(a, b, c) ≤ 1
proof
  have positive := rayProduct.positive at a, b, c with *
  have product := cosAngle.mul_rays at a, b, c with *
  have dotReal := angleDot.real at a, b, c with *
  have productReal : Real(distance(b, a) * distance(b, c)) by typecheck
  have upper : angleDot(a, b, c) ≤ distance(b, a) * distance(b, c)
    have productNonnegative := realLess.implies_le with *
    have firstSquare := distance.square at b, a with *
    have secondSquare := distance.square at b, c with *
    have productSquare : (distance(b, a) * distance(b, c)) * (distance(b, a) * distance(b, c)) = Euclidean.distanceSquared(b, a) * Euclidean.distanceSquared(b, c)
      rw [← firstSquare, ← secondSquare]
      ring
    have schwarz := angleDot.cauchy_schwarz at a, b, c with *
    rw ← productSquare at schwarz
    have sign := Real.sign_cases with dotReal
    cases sign with nonpositive | nonnegative
    . have dotLe := realLe.of_subset at angleDot(a, b, c), realZero with realZero.real, nonpositive
      exact realLe.transitive with *
    . have dotLe := realLe.of_subset with realZero.real, nonnegative
      exact realMulValue.le_of_square_le with *
  have scaled : cosAngle(a, b, c) * (distance(b, a) * distance(b, c)) ≤ 1 * (distance(b, a) * distance(b, c))
    rw product
    have one := realMulValue.one_left with productReal
    rwa one
  exact realLe.mul_right_cancel_positive with *

theorem cosAngle.neg_one_le (a b c : Point)
  requires firstRay : a ≠ b
  requires secondRay : c ≠ b
  shows -(1:R) ≤ cosAngle(a, b, c)
proof
  have positive := rayProduct.positive at a, b, c with *
  have product := cosAngle.mul_rays at a, b, c with *
  have bound := angleDot.lower_bound at a, b, c with *
  have lower : -(distance(b, a) * distance(b, c)) ≤ angleDot(a, b, c)
    have rewrite : angleDot(a, b, c) - (-(distance(b, a) * distance(b, c))) = angleDot(a, b, c) + distance(b, a) * distance(b, c)
      ring
    have nonnegativeDifference : 0 ≤ angleDot(a, b, c) - (-(distance(b, a) * distance(b, c))) by rwa rewrite
    exact realLe.of_nonnegative_difference with *
  have scaled : (-(1:R)) * (distance(b, a) * distance(b, c)) ≤ cosAngle(a, b, c) * (distance(b, a) * distance(b, c))
    rw product
    have negOne : (-(1:R)) * (distance(b, a) * distance(b, c)) = -(distance(b, a) * distance(b, c)) by ring
    rwa negOne
  exact realLe.mul_right_cancel_positive with *

-- Section: The isosceles triangle theorem

-- Equal legs give equal base angles, stated as equality of their cosines.
theorem isosceles.cosines (a b c : Point)
  requires base : a ≠ b
  requires leg : a ≠ c
  requires equalLegs : Euclidean.distanceSquared(a, c) = Euclidean.distanceSquared(b, c)
  shows cosAngle(c, a, b) = cosAngle(c, b, a)
proof
  have ca := Euclidean.distanceSquared.symmetric at c, a with *
  have cb := Euclidean.distanceSquared.symmetric at c, b with *
  have shared := Euclidean.distanceSquared.symmetric at a, b with *
  have first : Euclidean.distanceSquared(c, a) = Euclidean.distanceSquared(c, b) by cc
  have opposite : Euclidean.distanceSquared(c, b) = Euclidean.distanceSquared(c, a) by cc
  have equalDots := angleDot.of_sss at c, a, b, c, b, a with *
  have legA : distance(a, c) = distance(b, c)
    unfold distance
    cc
  have baseSymmetric := distance.symmetric at a, b with *
  unfold cosAngle
  cc

end Euclidean
