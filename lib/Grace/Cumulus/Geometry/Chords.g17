-- Intersecting chords: the power of a point with respect to a circle, and
-- the equal products of the segments of two chords through one point.
-- Part of Cumulus, the Grace17 mathematics library.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module Grace.Cumulus.Geometry.Chords
import Circle
import Distance

namespace Euclidean
export open Euclidean

-- A point p of the line through a and b, written p = a + t(b − a).
predicate OnLine (p a b t : Set) :=
  x(p) = x(a) + (t:R) * (x(b) - x(a)) ∧ y(p) = y(a) + (t:R) * (y(b) - y(a))

-- The power of a point: for a chord ab through p, the dot product of the
-- two segments at p is the squared distance to the center less the squared
-- radius, whatever the position of p on the line.
theorem chord.power (a b p center through : Point) (t : Real)
  requires onA : OnCircle(a, center, through)
  requires onB : OnCircle(b, center, through)
  requires onLine : OnLine(p, a, b, t)
  shows angleDot(a, p, b) =
    distanceSquared(p, center) - distanceSquared(a, center)
proof
  rcases onLine with ⟨horizontal, vertical⟩
  unfold OnCircle at onA
  unfold OnCircle at onB
  have angle := angleDot.coordinates at a, p, b with *
  have pointRadius := distanceSquared.coordinates at p, center with *
  have firstRadius := distanceSquared.coordinates at a, center with *
  have secondRadius := distanceSquared.coordinates at b, center with *
  have throughRadius := distanceSquared.coordinates at through, center with *
  rw [firstRadius, throughRadius] at onA
  rw [secondRadius, throughRadius] at onB
  rw [angle, pointRadius, firstRadius, horizontal, vertical]
  linear_combination t * onA - t * onB

-- The squared segments of a chord through p, in terms of the parameter.
theorem chord.segment_squares (a b p : Point) (t : Real)
  requires onLine : OnLine(p, a, b, t)
  shows distanceSquared(p, a) * distanceSquared(p, b) =
    angleDot(a, p, b) * angleDot(a, p, b)
proof
  rcases onLine with ⟨horizontal, vertical⟩
  have first := distanceSquared.coordinates at p, a with *
  have second := distanceSquared.coordinates at p, b with *
  have angle := angleDot.coordinates at a, p, b with *
  rw [first, second, angle, horizontal, vertical]
  ring

-- Two chords ab and cd through p: the products of the squared segments agree.
theorem chord.products_squared (a b c d p center through : Point) (t u : Real)
  requires onA : OnCircle(a, center, through)
  requires onB : OnCircle(b, center, through)
  requires onC : OnCircle(c, center, through)
  requires onD : OnCircle(d, center, through)
  requires firstLine : OnLine(p, a, b, t)
  requires secondLine : OnLine(p, c, d, u)
  shows distanceSquared(p, a) * distanceSquared(p, b) =
    distanceSquared(p, c) * distanceSquared(p, d)
proof
  have firstPower := chord.power at a, b, p, center, through, t with *
  have secondPower := chord.power at c, d, p, center, through, u with *
  have firstSquares := chord.segment_squares at a, b, p, t with *
  have secondSquares := chord.segment_squares at c, d, p, u with *
  unfold OnCircle at onA
  unfold OnCircle at onC
  have same : angleDot(a, p, b) = angleDot(c, p, d)
    linear_combination firstPower - secondPower - onA + onC
  rw [firstSquares, secondSquares, same]
  rfl

-- The classical statement: the products of the segment lengths agree.
theorem chord.products (a b c d p center through : Point) (t u : Real)
  requires onA : OnCircle(a, center, through)
  requires onB : OnCircle(b, center, through)
  requires onC : OnCircle(c, center, through)
  requires onD : OnCircle(d, center, through)
  requires firstLine : OnLine(p, a, b, t)
  requires secondLine : OnLine(p, c, d, u)
  shows distance(p, a) * distance(p, b) = distance(p, c) * distance(p, d)
proof
  have squares := chord.products_squared at a, b, c, d, p, center, through, t, u
    with *
  have nonnegativeA := Euclidean.distanceSquared.nonnegative_real at p, a with *
  have nonnegativeB := Euclidean.distanceSquared.nonnegative_real at p, b with *
  have nonnegativeC := Euclidean.distanceSquared.nonnegative_real at p, c with *
  have nonnegativeD := Euclidean.distanceSquared.nonnegative_real at p, d with *
  have first := sqrt.mul with nonnegativeA, nonnegativeB
  have second := sqrt.mul with nonnegativeC, nonnegativeD
  unfold distance
  rw [← first, ← second, squares]
  rfl

end Euclidean
