-- Authors: Grant Passmore

module Grace.Cumulus.Geometry.Heron
import Distance
import Lines
import Real.AbsoluteValue

namespace Euclidean
export open Euclidean

-- Twice the area of the triangle abc is the absolute value of the cross
-- product of its two sides at a.
def doubleArea (a b c : Point) : Real := abs(directionCross(a, b, a, c))

def area (a b c : Point) : Real := doubleArea(a, b, c) / 2

theorem doubleArea.real (a b c : Point)
  shows Real(doubleArea(a, b, c))
proof
  typecheck

theorem area.real (a b c : Point)
  shows Real(area(a, b, c))
proof
  typecheck

theorem doubleArea.nonnegative (a b c : Point)
  shows 0 ≤ doubleArea(a, b, c)
proof
  have cross := directionCross.real at a, b, a, c with *
  unfold doubleArea
  exact abs.nonnegative with cross

theorem doubleArea.square (a b c : Point)
  shows doubleArea(a, b, c) * doubleArea(a, b, c) =
    directionCross(a, b, a, c) * directionCross(a, b, a, c)
proof
  have cross := directionCross.real at a, b, a, c with *
  have product := abs.mul at directionCross(a, b, a, c),
    directionCross(a, b, a, c) with *
  have nonnegative := realMulValue.square_nonnegative at
    directionCross(a, b, a, c) with *
  have same := abs.of_nonnegative with nonnegative
  unfold doubleArea
  rw ← product
  exact same

theorem area.twice (a b c : Point)
  shows (2:R) * area(a, b, c) = doubleArea(a, b, c)
proof
  have nonzero := realAddValue.two_nonzero
  unfold area
  exact realDiv.mul_left with *

theorem area.nonnegative (a b c : Point)
  shows 0 ≤ area(a, b, c)
proof
  have real := area.real at a, b, c with *
  have twice := area.twice at a, b, c with *
  have nonnegative := doubleArea.nonnegative at a, b, c with *
  linarith

-- Heron's formula in squared form: sixteen times the squared area is a
-- polynomial in the squared side lengths.
theorem heron.squared (a b c : Point)
  shows (16:R) * (area(a, b, c) * area(a, b, c)) =
    2 * distanceSquared(a, b) * distanceSquared(b, c) +
    2 * distanceSquared(b, c) * distanceSquared(c, a) +
    2 * distanceSquared(c, a) * distanceSquared(a, b) -
    distanceSquared(a, b) * distanceSquared(a, b) -
    distanceSquared(b, c) * distanceSquared(b, c) -
    distanceSquared(c, a) * distanceSquared(c, a)
proof
  have twice := area.twice at a, b, c with *
  have square := doubleArea.square at a, b, c with *
  have ab := distanceSquared.coordinates at a, b with *
  have bc := distanceSquared.coordinates at b, c with *
  have ca := distanceSquared.coordinates at c, a with *
  have sixteen : (16:R) * (area(a, b, c) * area(a, b, c)) =
      4 * (((2:R) * area(a, b, c)) * ((2:R) * area(a, b, c)))
    ring
  rw [sixteen, twice, square, ab, bc, ca]
  unfold directionCross
  ring

def semiperimeter (a b c : Point) : Real :=
  (distance(b, c) + distance(c, a) + distance(a, b)) / 2

theorem semiperimeter.twice (a b c : Point)
  shows (2:R) * semiperimeter(a, b, c) =
    distance(b, c) + distance(c, a) + distance(a, b)
proof
  have nonzero := realAddValue.two_nonzero
  unfold semiperimeter
  exact realDiv.mul_left with *

-- Heron's formula: with s the semiperimeter and p, q, r the side lengths,
-- the area is √(s(s − p)(s − q)(s − r)).
theorem heron (a b c : Point)
  shows area(a, b, c) =
    √(semiperimeter(a, b, c) *
      (semiperimeter(a, b, c) - distance(b, c)) *
      (semiperimeter(a, b, c) - distance(c, a)) *
      (semiperimeter(a, b, c) - distance(a, b)))
proof
  have twiceS := semiperimeter.twice at a, b, c with *
  have pSquare := distance.square at b, c with *
  have qSquare := distance.square at c, a with *
  have rSquare := distance.square at a, b with *
  have squared := heron.squared at a, b, c with *
  have expand : (16:R) * (semiperimeter(a, b, c) *
      (semiperimeter(a, b, c) - distance(b, c)) *
      (semiperimeter(a, b, c) - distance(c, a)) *
      (semiperimeter(a, b, c) - distance(a, b))) =
    ((2:R) * semiperimeter(a, b, c)) *
      ((2:R) * semiperimeter(a, b, c) - 2 * distance(b, c)) *
      ((2:R) * semiperimeter(a, b, c) - 2 * distance(c, a)) *
      ((2:R) * semiperimeter(a, b, c) - 2 * distance(a, b))
    ring
  have key : (16:R) * (area(a, b, c) * area(a, b, c)) =
      (16:R) * (semiperimeter(a, b, c) *
        (semiperimeter(a, b, c) - distance(b, c)) *
        (semiperimeter(a, b, c) - distance(c, a)) *
        (semiperimeter(a, b, c) - distance(a, b)))
    rw [expand, twiceS, squared, ← pSquare, ← qSquare, ← rSquare]
    ring
  have product : area(a, b, c) * area(a, b, c) =
      semiperimeter(a, b, c) *
        (semiperimeter(a, b, c) - distance(b, c)) *
        (semiperimeter(a, b, c) - distance(c, a)) *
        (semiperimeter(a, b, c) - distance(a, b))
    linarith
  have nonnegative := area.nonnegative at a, b, c with *
  have squareNonnegative := realMulValue.square_nonnegative at
    area(a, b, c) with *
  rw product at squareNonnegative
  have typed := NonnegativeReal.of_le with squareNonnegative
  exact sqrt.unique with nonnegative, product

end Euclidean
