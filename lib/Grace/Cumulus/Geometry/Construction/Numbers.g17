-- Constructible real numbers: the least subset of ℝ that is a subfield
-- closed under square roots of its nonnegative elements, with its
-- induction principle and closure laws.
-- Part of Cumulus, the Grace17 mathematics library.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module Grace.Cumulus.Geometry.Construction.Numbers
import Grace.Cumulus.Algebra.Field.RealSubfield

-- The definitions

-- A set of reals closed under the field operations and square roots.
predicate ConstructiblyClosed (S : Set) :=
  RealSubfield(S) ∧ (∀ x ∈ S, (0:R) ≤ (x:R) → realSqrt(x) ∈ S)

-- A real whose square lies in S lies in S: its absolute value is the
-- square root of the square, and the real is that value or its negation.
theorem ConstructiblyClosed.of_square_mem (S : Set) (s : Real)
  requires closed : ConstructiblyClosed(S)
  requires squareIn : s * s ∈ S
  shows s ∈ S
proof
  obtain ⟨field, roots⟩ := closed
  have squareNonneg := realMulValue.square_nonnegative at s
  have rootIn := roots with squareIn, squareNonneg
  have rootReal := realSqrt.real with squareNonneg
  have rootNonneg := realSqrt.nonneg with squareNonneg
  have rootSquare := realSqrt.square with squareNonneg
  by_cases nonneg : (0:R) ≤ s
  . have equal := realMulValue.eq_of_square_eq at realSqrt(s * s), s
      with rootNonneg, nonneg, rootSquare
    rw ← equal
    exact rootIn
  . have negNonneg : (0:R) ≤ -s by linarith
    have negSquare : realSqrt(s * s) * realSqrt(s * s) = (-s) * (-s)
      linear_combination rootSquare
    have equal := realMulValue.eq_of_square_eq at realSqrt(s * s), -s
      with rootNonneg, negNonneg, negSquare
    have negIn : -s ∈ S
      rw ← equal
      exact rootIn
    have involutive := realNegValue.involutive at s
    rw ← involutive
    exact RealSubfield.neg_mem with field, negIn

-- The intersection of every constructibly closed set.
def constructibles : Set :=
  { x ∈ ℝ | ∀ S, ConstructiblyClosed(S) → x ∈ S }

predicate Constructible (x : Set) := x ∈ constructibles

-- Membership

theorem constructibles.mem_iff (x : Set)
  shows x ∈ constructibles ↔
    x ∈ ℝ ∧ (∀ S, ConstructiblyClosed(S) → x ∈ S)
proof
  simp

theorem constructibles.subset_reals
  shows constructibles ⊆ ℝ
proof
  simp

theorem constructibles.intro (x : Real)
  requires every : ∀ S, ConstructiblyClosed(S) → x ∈ S
  shows x ∈ constructibles
proof
  have xReal : x ∈ ℝ by typecheck
  apply constructibles.mem_iff.backward
  exact ⟨xReal, every⟩

-- The induction principle: a closed set contains every constructible.
theorem constructibles.least (S : Set)
  requires closed : ConstructiblyClosed(S)
  shows constructibles ⊆ S
proof
  intros x hx
  have data := constructibles.mem_iff.forward with hx
  exact data.right with S, closed

theorem Constructible.real (x : Set)
  requires constructible : Constructible(x)
  shows Real(x)
proof
  have data := constructibles.mem_iff.forward with constructible
  exact data.left

-- The least closed set is closed

-- Each law holds in every closed set S, so it holds in the intersection.
theorem constructibles.closed
  shows ConstructiblyClosed(constructibles)
proof
  have bounded := constructibles.subset_reals
  have zeroMember : (0:R) ∈ constructibles
    apply constructibles.intro
    intros S closed
    exact RealSubfield.zero_mem with closed.left
  have oneMember : (1:R) ∈ constructibles
    apply constructibles.intro
    intros S closed
    exact RealSubfield.one_mem with closed.left
  have negatives : ∀ x ∈ constructibles, -(x:R) ∈ constructibles
    intros x hx
    have data := constructibles.mem_iff.forward with hx
    apply constructibles.intro
    intros S closed
    have xIn := data.right with S, closed
    exact RealSubfield.neg_mem with closed.left, xIn
  have sums : ∀ x y ∈ constructibles, (x:R) + (y:R) ∈ constructibles
    intros x hx y hy
    have first := constructibles.mem_iff.forward with hx
    have second := constructibles.mem_iff.forward with hy
    apply constructibles.intro
    intros S closed
    have xIn := first.right with S, closed
    have yIn := second.right with S, closed
    exact RealSubfield.add_mem with closed.left, xIn, yIn
  have products : ∀ x y ∈ constructibles, (x:R) * (y:R) ∈ constructibles
    intros x hx y hy
    have first := constructibles.mem_iff.forward with hx
    have second := constructibles.mem_iff.forward with hy
    apply constructibles.intro
    intros S closed
    have xIn := first.right with S, closed
    have yIn := second.right with S, closed
    exact RealSubfield.mul_mem with closed.left, xIn, yIn
  have inverses : ∀ x ∈ constructibles,
      x ≠ (0:R) → realInvValue(x) ∈ constructibles
    intros x hx nonzero
    have data := constructibles.mem_iff.forward with hx
    apply constructibles.intro
    intros S closed
    have xIn := data.right with S, closed
    exact RealSubfield.inv_mem with closed.left, xIn, nonzero
  have roots : ∀ x ∈ constructibles,
      (0:R) ≤ (x:R) → realSqrt(x) ∈ constructibles
    intros x hx nonneg
    have data := constructibles.mem_iff.forward with hx
    have rootReal := realSqrt.real with nonneg
    apply constructibles.intro
    intros S closed
    have xIn := data.right with S, closed
    exact closed.right with x, xIn, nonneg
  have field := RealSubfield.mk with
    bounded, zeroMember, oneMember, negatives, sums, products, inverses
  unfold ConstructiblyClosed
  exact ⟨field, roots⟩

theorem constructibles.subfield
  shows RealSubfield(constructibles)
proof
  have closed := constructibles.closed
  exact closed.left

-- The closure laws

instance Constructible.add (x y : Real)
  requires xC : Constructible(x)
  requires yC : Constructible(y)
  shows Constructible(x + y)
proof
  have field := constructibles.subfield
  exact RealSubfield.add_mem with field, xC, yC

instance Constructible.mul (x y : Real)
  requires xC : Constructible(x)
  requires yC : Constructible(y)
  shows Constructible(x * y)
proof
  have field := constructibles.subfield
  exact RealSubfield.mul_mem with field, xC, yC

instance Constructible.neg (x : Real)
  requires xC : Constructible(x)
  shows Constructible(-x)
proof
  have field := constructibles.subfield
  exact RealSubfield.neg_mem with field, xC

instance Constructible.sub (x y : Real)
  requires xC : Constructible(x)
  requires yC : Constructible(y)
  shows Constructible(x - y)
proof
  have field := constructibles.subfield
  exact RealSubfield.sub_mem with field, xC, yC

-- The square root law takes its nonnegativity as the predicate
-- NonnegativeReal, which also discharges the soft type of √x.
instance Constructible.sqrt (x : Real)
  requires xC : Constructible(x)
  requires nonneg : NonnegativeReal(x)
  shows Constructible(√x)
proof
  have le := NonnegativeReal.le at x with nonneg
  have closed := constructibles.closed
  unfold sqrt
  exact closed.right with x, xC, le

theorem Constructible.sqrt_of_le (x : Real)
  requires xC : Constructible(x)
  requires nonneg : (0:R) ≤ x
  shows Constructible(realSqrt(x))
proof
  have closed := constructibles.closed
  exact closed.right with x, xC, nonneg

theorem Constructible.inv (x : Real)
  requires xC : Constructible(x)
  requires nonzero : x ≠ 0
  shows Constructible(realInvValue(x))
proof
  have field := constructibles.subfield
  exact RealSubfield.inv_mem with field, xC, nonzero

theorem Constructible.div (x y : Real)
  requires xC : Constructible(x)
  requires yC : Constructible(y)
  requires nonzero : y ≠ 0
  shows Constructible(x / y)
proof
  have field := constructibles.subfield
  exact RealSubfield.div_mem with field, xC, yC, nonzero

theorem Constructible.zero
  shows Constructible((0:R))
proof
  have field := constructibles.subfield
  exact RealSubfield.zero_mem with field

theorem Constructible.one
  shows Constructible((1:R))
proof
  have field := constructibles.subfield
  exact RealSubfield.one_mem with field

theorem Constructible.numeral (n : Nat)
  shows Constructible(realNat(n))
proof
  have field := constructibles.subfield
  exact RealSubfield.numeral_mem with field

theorem Constructible.rational (x : Set)
  requires xIn : x ∈ rationalReals
  shows Constructible(x)
proof
  have field := constructibles.subfield
  have included := RealSubfield.rationals_subset with field
  exact included with x, xIn
