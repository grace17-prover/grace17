-- The zero vector, negation, scaling, and cross product of ℝ³ as graphs on
-- 3, with Lagrange's identity and the linearity of the matrix action
-- Part of Cumulus, the Grace17 mathematics library.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module Grace.Cumulus.Geometry.Vectors3
import Rotation.Generators

-- The zero vector.
defgraph zeroVector (i ∈ 3) : ℝ := (0:R)
proof
  typecheck

instance zeroVector.vector
  shows zeroVector : 3 → ℝ
proof
  exact zeroVector.function

theorem zeroVector.entry (i : Set)
  requires index : i ∈ 3
  shows zeroVector(i) = (0:R)
proof
  exact zeroVector.value with index

instance zeroVector.space
  shows zeroVector ∈ ℝ³
proof
  exact ℝ³.of_function with zeroVector.vector

theorem zeroVector.normSq
  shows normSq(zeroVector) = (0:R)
proof
  have e0 := zeroVector.entry at 0 with index.zero_mem
  have e1 := zeroVector.entry at 1 with index.one_mem
  have e2 := zeroVector.entry at 2 with index.two_mem
  rw [normSq.value, e0, e1, e2]
  ring

-- The negation of a vector.
defgraph vectorNeg (v : Set) (i ∈ 3) : ℝ := -(v(i):R)
requires vector : v : 3 → ℝ
proof
  have component := vector.component_real at v, i with vector, member
  typecheck

instance vectorNeg.vector (v : Set)
  requires vector : v : 3 → ℝ
  shows vectorNeg(v) : 3 → ℝ
proof
  exact vectorNeg.function with vector

theorem vectorNeg.entry (v i : Set)
  requires vector : v : 3 → ℝ
  requires index : i ∈ 3
  shows vectorNeg(v)(i) = -(v(i):R)
proof
  exact vectorNeg.value with vector, index

instance vectorNeg.space (v : Set)
  requires member : v ∈ ℝ³
  shows vectorNeg(v) ∈ ℝ³
proof
  have vector := ℝ³.function with member
  have image := vectorNeg.vector with vector
  exact ℝ³.of_function with image

theorem vectorNeg.normSq (v : Set)
  requires vector : v : 3 → ℝ
  shows normSq(vectorNeg(v)) = normSq(v)
proof
  have v0 := vector.component_real at v, 0 with vector, index.zero_mem
  have v1 := vector.component_real at v, 1 with vector, index.one_mem
  have v2 := vector.component_real at v, 2 with vector, index.two_mem
  have e0 := vectorNeg.entry at v, 0 with vector, index.zero_mem
  have e1 := vectorNeg.entry at v, 1 with vector, index.one_mem
  have e2 := vectorNeg.entry at v, 2 with vector, index.two_mem
  rw [normSq.value, normSq.value, e0, e1, e2]
  ring

theorem vectorNeg.sphere (v : Set)
  requires member : v ∈ S²
  shows vectorNeg(v) ∈ S²
proof
  obtain ⟨inSpace, unit⟩ := S².membership.forward with member
  have vector := ℝ³.function with inSpace
  have negIn := vectorNeg.space with inSpace
  have norm := vectorNeg.normSq with vector
  have negUnit : normSq(vectorNeg(v)) = (1:R)
    rw norm
    exact unit
  exact S².membership.backward with ⟨negIn, negUnit⟩

theorem vectorNeg.involutive (v : Set)
  requires vector : v : 3 → ℝ
  shows vectorNeg(vectorNeg(v)) = v
proof
  have inner := vectorNeg.vector with vector
  have outer := vectorNeg.vector with inner
  apply FunctionBetween.ext with outer, vector
  intros i hi
  have component := vector.component_real at v, i with vector, hi
  have first := vectorNeg.entry at vectorNeg(v), i with inner, hi
  have second := vectorNeg.entry at v, i with vector, hi
  rw [first, second]
  ring

-- Scaling a vector by a real.
defgraph vectorScale (c v : Set) (i ∈ 3) : ℝ := (c:R) * (v(i):R)
requires scalar : c ∈ ℝ
requires vector : v : 3 → ℝ
proof
  have component := vector.component_real at v, i with vector, member
  typecheck

instance vectorScale.vector (c v : Set)
  requires scalar : c ∈ ℝ
  requires vector : v : 3 → ℝ
  shows vectorScale(c, v) : 3 → ℝ
proof
  exact vectorScale.function with scalar, vector

theorem vectorScale.entry (c v i : Set)
  requires scalar : c ∈ ℝ
  requires vector : v : 3 → ℝ
  requires index : i ∈ 3
  shows vectorScale(c, v)(i) = (c:R) * (v(i):R)
proof
  exact vectorScale.value with scalar, vector, index

instance vectorScale.space (c v : Set)
  requires scalar : c ∈ ℝ
  requires member : v ∈ ℝ³
  shows vectorScale(c, v) ∈ ℝ³
proof
  have vector := ℝ³.function with member
  have image := vectorScale.vector with scalar, vector
  exact ℝ³.of_function with image

theorem vectorScale.normSq (c v : Set)
  requires scalar : c ∈ ℝ
  requires vector : v : 3 → ℝ
  shows normSq(vectorScale(c, v)) = (c:R) * (c:R) * normSq(v)
proof
  have v0 := vector.component_real at v, 0 with vector, index.zero_mem
  have v1 := vector.component_real at v, 1 with vector, index.one_mem
  have v2 := vector.component_real at v, 2 with vector, index.two_mem
  have e0 := vectorScale.entry at c, v, 0 with scalar, vector, index.zero_mem
  have e1 := vectorScale.entry at c, v, 1 with scalar, vector, index.one_mem
  have e2 := vectorScale.entry at c, v, 2 with scalar, vector, index.two_mem
  rw [normSq.value, normSq.value, e0, e1, e2]
  ring

theorem vectorScale.one (v : Set)
  requires vector : v : 3 → ℝ
  shows vectorScale((1:R), v) = v
proof
  have oneReal : (1:R) ∈ ℝ by typecheck
  have scaled := vectorScale.vector with oneReal, vector
  apply FunctionBetween.ext with scaled, vector
  intros i hi
  have component := vector.component_real at v, i with vector, hi
  have entry := vectorScale.entry at (1:R), v, i with oneReal, vector, hi
  rw entry
  ring

theorem vectorScale.neg_one (v : Set)
  requires vector : v : 3 → ℝ
  shows vectorScale(-(1:R), v) = vectorNeg(v)
proof
  have negReal : -(1:R) ∈ ℝ by typecheck
  have scaled := vectorScale.vector with negReal, vector
  have negated := vectorNeg.vector with vector
  apply FunctionBetween.ext with scaled, negated
  intros i hi
  have component := vector.component_real at v, i with vector, hi
  have entry := vectorScale.entry at -(1:R), v, i with negReal, vector, hi
  have negEntry := vectorNeg.entry at v, i with vector, hi
  rw [entry, negEntry]
  ring

-- The matrix action is linear: it commutes with negation and scaling.
theorem matrixVector.neg (M : realRing ^ 3 × 3) (v : Set)
  requires vector : v : 3 → ℝ
  shows M · vectorNeg(v) = vectorNeg(M · v)
proof
  have negated := vectorNeg.vector with vector
  have left := matrixVector.vector at M, vectorNeg(v) with *
  have image := matrixVector.vector at M, v with *
  have right := vectorNeg.vector with image
  apply FunctionBetween.ext with left, right
  intros i hi
  obtain ⟨m0, m1, m2⟩ := Matrix.row_real at M, i with hi
  have v0 := vector.component_real at v, 0 with vector, index.zero_mem
  have v1 := vector.component_real at v, 1 with vector, index.one_mem
  have v2 := vector.component_real at v, 2 with vector, index.two_mem
  have leftEntry := matrixVector.entry at M, vectorNeg(v), i with *
  have rightEntry := vectorNeg.entry at M · v, i with image, hi
  have inner := matrixVector.entry at M, v, i with *
  have e0 := vectorNeg.entry at v, 0 with vector, index.zero_mem
  have e1 := vectorNeg.entry at v, 1 with vector, index.one_mem
  have e2 := vectorNeg.entry at v, 2 with vector, index.two_mem
  rw [leftEntry, rightEntry, inner, e0, e1, e2]
  ring

theorem matrixVector.scale (M : realRing ^ 3 × 3) (c v : Set)
  requires scalar : c ∈ ℝ
  requires vector : v : 3 → ℝ
  shows M · vectorScale(c, v) = vectorScale(c, M · v)
proof
  have scaled := vectorScale.vector with scalar, vector
  have left := matrixVector.vector at M, vectorScale(c, v) with *
  have image := matrixVector.vector at M, v with *
  have right := vectorScale.vector with scalar, image
  apply FunctionBetween.ext with left, right
  intros i hi
  obtain ⟨m0, m1, m2⟩ := Matrix.row_real at M, i with hi
  have v0 := vector.component_real at v, 0 with vector, index.zero_mem
  have v1 := vector.component_real at v, 1 with vector, index.one_mem
  have v2 := vector.component_real at v, 2 with vector, index.two_mem
  have leftEntry := matrixVector.entry at M, vectorScale(c, v), i with *
  have rightEntry := vectorScale.entry at c, M · v, i with scalar, image, hi
  have inner := matrixVector.entry at M, v, i with *
  have e0 := vectorScale.entry at c, v, 0 with scalar, vector, index.zero_mem
  have e1 := vectorScale.entry at c, v, 1 with scalar, vector, index.one_mem
  have e2 := vectorScale.entry at c, v, 2 with scalar, vector, index.two_mem
  rw [leftEntry, rightEntry, inner, e0, e1, e2]
  ring

-- The cross product u × v, by its three coordinates.
defgraph cross (u v : Set) (i ∈ 3) : ℝ :=
  pick3((u(1):R) * (v(2):R) - (u(2):R) * (v(1):R),
    (u(2):R) * (v(0):R) - (u(0):R) * (v(2):R),
    (u(0):R) * (v(1):R) - (u(1):R) * (v(0):R), i)
requires vectorU : u : 3 → ℝ
requires vectorV : v : 3 → ℝ
proof
  have u0 := vector.component_real at u, 0 with vectorU, index.zero_mem
  have u1 := vector.component_real at u, 1 with vectorU, index.one_mem
  have u2 := vector.component_real at u, 2 with vectorU, index.two_mem
  have v0 := vector.component_real at v, 0 with vectorV, index.zero_mem
  have v1 := vector.component_real at v, 1 with vectorV, index.one_mem
  have v2 := vector.component_real at v, 2 with vectorV, index.two_mem
  have first : (u(1):R) * (v(2):R) - (u(2):R) * (v(1):R) ∈ ℝ by typecheck
  have second : (u(2):R) * (v(0):R) - (u(0):R) * (v(2):R) ∈ ℝ by typecheck
  have third : (u(0):R) * (v(1):R) - (u(1):R) * (v(0):R) ∈ ℝ by typecheck
  exact pick3.real with first, second, third, member

instance cross.vector (u v : Set)
  requires vectorU : u : 3 → ℝ
  requires vectorV : v : 3 → ℝ
  shows cross(u, v) : 3 → ℝ
proof
  exact cross.function with vectorU, vectorV

theorem cross.zero (u v : Set)
  requires vectorU : u : 3 → ℝ
  requires vectorV : v : 3 → ℝ
  shows cross(u, v)(0) = (u(1):R) * (v(2):R) - (u(2):R) * (v(1):R)
proof
  have value := cross.value at u, v, 0 with vectorU, vectorV, index.zero_mem
  rw [value, pick3.zero]
  rfl

theorem cross.one (u v : Set)
  requires vectorU : u : 3 → ℝ
  requires vectorV : v : 3 → ℝ
  shows cross(u, v)(1) = (u(2):R) * (v(0):R) - (u(0):R) * (v(2):R)
proof
  have value := cross.value at u, v, 1 with vectorU, vectorV, index.one_mem
  rw [value, pick3.one]
  rfl

theorem cross.two (u v : Set)
  requires vectorU : u : 3 → ℝ
  requires vectorV : v : 3 → ℝ
  shows cross(u, v)(2) = (u(0):R) * (v(1):R) - (u(1):R) * (v(0):R)
proof
  have value := cross.value at u, v, 2 with vectorU, vectorV, index.two_mem
  rw [value, pick3.two]
  rfl

instance cross.space (u v : Set)
  requires memberU : u ∈ ℝ³
  requires memberV : v ∈ ℝ³
  shows cross(u, v) ∈ ℝ³
proof
  have vectorU := ℝ³.function with memberU
  have vectorV := ℝ³.function with memberV
  have image := cross.vector with vectorU, vectorV
  exact ℝ³.of_function with image

-- The cross product is orthogonal to both factors, and Lagrange's
-- identity gives its squared norm.
theorem cross.dot_left (u v : Set)
  requires vectorU : u : 3 → ℝ
  requires vectorV : v : 3 → ℝ
  shows dot3(u, cross(u, v)) = (0:R)
proof
  have u0 := vector.component_real at u, 0 with vectorU, index.zero_mem
  have u1 := vector.component_real at u, 1 with vectorU, index.one_mem
  have u2 := vector.component_real at u, 2 with vectorU, index.two_mem
  have v0 := vector.component_real at v, 0 with vectorV, index.zero_mem
  have v1 := vector.component_real at v, 1 with vectorV, index.one_mem
  have v2 := vector.component_real at v, 2 with vectorV, index.two_mem
  have c0 := cross.zero with vectorU, vectorV
  have c1 := cross.one with vectorU, vectorV
  have c2 := cross.two with vectorU, vectorV
  rw [dot3.value, c0, c1, c2]
  ring

theorem cross.dot_right (u v : Set)
  requires vectorU : u : 3 → ℝ
  requires vectorV : v : 3 → ℝ
  shows dot3(v, cross(u, v)) = (0:R)
proof
  have u0 := vector.component_real at u, 0 with vectorU, index.zero_mem
  have u1 := vector.component_real at u, 1 with vectorU, index.one_mem
  have u2 := vector.component_real at u, 2 with vectorU, index.two_mem
  have v0 := vector.component_real at v, 0 with vectorV, index.zero_mem
  have v1 := vector.component_real at v, 1 with vectorV, index.one_mem
  have v2 := vector.component_real at v, 2 with vectorV, index.two_mem
  have c0 := cross.zero with vectorU, vectorV
  have c1 := cross.one with vectorU, vectorV
  have c2 := cross.two with vectorU, vectorV
  rw [dot3.value, c0, c1, c2]
  ring

theorem cross.normSq (u v : Set)
  requires vectorU : u : 3 → ℝ
  requires vectorV : v : 3 → ℝ
  shows normSq(cross(u, v)) = normSq(u) * normSq(v) - dot3(u, v) * dot3(u, v)
proof
  have u0 := vector.component_real at u, 0 with vectorU, index.zero_mem
  have u1 := vector.component_real at u, 1 with vectorU, index.one_mem
  have u2 := vector.component_real at u, 2 with vectorU, index.two_mem
  have v0 := vector.component_real at v, 0 with vectorV, index.zero_mem
  have v1 := vector.component_real at v, 1 with vectorV, index.one_mem
  have v2 := vector.component_real at v, 2 with vectorV, index.two_mem
  have c0 := cross.zero with vectorU, vectorV
  have c1 := cross.one with vectorU, vectorV
  have c2 := cross.two with vectorU, vectorV
  rw [normSq.value, normSq.value, normSq.value, dot3.value, c0, c1, c2]
  ring
