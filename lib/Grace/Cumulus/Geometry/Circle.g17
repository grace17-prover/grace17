-- Authors: Grant Passmore

module Grace.Cumulus.Geometry.Circle
import Isosceles

namespace Euclidean
export open Euclidean

predicate Midpoint (m a b : Set) :=
  x(a) + x(b) = x(m) + x(m) ∧
  y(a) + y(b) = y(m) + y(m)

-- The radius is specified by a point on the circle; no square-root choice
-- is needed. Nonzero radius is imposed only when a nondegenerate angle is used.
predicate OnCircle (p center through : Set) :=
  Euclidean.distanceSquared(p, center) = Euclidean.distanceSquared(through, center)

-- The underlying identity includes degenerate configurations. All points
-- and lengths here are defined using ordered pairs and real arithmetic.
theorem diameter_identity (a b p center : Point)
  requires midpoint : Midpoint(center, a, b)
  shows angleDot(a, p, b) =
    Euclidean.distanceSquared(p, center) - Euclidean.distanceSquared(a, center)
proof
  rcases midpoint with ⟨horizontal, vertical⟩
  have angle := angleDot.coordinates at a, p, b with *
  have pointRadius := Euclidean.distanceSquared.coordinates at p, center with *
  have endpointRadius := Euclidean.distanceSquared.coordinates at a, center with *
  rw [angle, pointRadius, endpointRadius]
  linear_combination (x(a) - x(p)) * horizontal + (y(a) - y(p)) * vertical

-- A point on the circle sees the diameter at a right angle.
-- Endpoint exclusion makes both rays nonzero, as angle language requires.
theorem thales (a b p center : Point)
  requires midpoint : Midpoint(center, a, b)
  requires onCircle : OnCircle(p, center, a)
  requires firstRay : a ≠ p
  requires secondRay : p ≠ b
  shows RightAngle(a, p, b) ∧
    0 < Euclidean.distanceSquared(a, p) ∧ 0 < Euclidean.distanceSquared(p, b)
proof
  have identity := diameter_identity at a, b, p, center with *
  have first := Euclidean.distanceSquared.positive at a, p with *
  have second := Euclidean.distanceSquared.positive at p, b with *
  unfold OnCircle at onCircle
  refine ⟨_, first, second⟩
  unfold RightAngle
  linear_combination identity + onCircle

-- The converse needs no side-length square roots or nondegeneracy.
theorem pythagoras_converse (a b c : Point)
  requires sides : Euclidean.distanceSquared(a, c) =
    Euclidean.distanceSquared(a, b) + Euclidean.distanceSquared(b, c)
  shows RightAngle(a, b, c)
proof
  have identity := cosine_identity at a, b, c with *
  have doubled : angleDot(a, b, c) + angleDot(a, b, c) = (0:R) + (0:R) by linear_combination identity - sides
  unfold RightAngle
  exact realAddValue.double_cancel with realZero.real, doubled

end Euclidean
