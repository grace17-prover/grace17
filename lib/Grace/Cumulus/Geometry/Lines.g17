module Grace.Cumulus.Geometry.Lines
import Midpoint

namespace Euclidean
export open Euclidean

def directionCross (a b c d : Point) : Real :=
  (x(b) - x(a)) * (y(d) - y(c)) -
  (y(b) - y(a)) * (x(d) - x(c))

predicate Collinear (a b c : Set) := directionCross(a, b, a, c) = 0

-- Algebraic orthogonality of directed segments, permitting zero directions.
predicate PerpendicularDirections (a b c d : Set) :=
  dot(vector(a, b), vector(c, d)) = 0

-- Parallel directions of nonzero segments. Coincident supporting lines
-- are allowed; this predicate does not assert that two lines are disjoint.
predicate ParallelSegments (a b c d : Set) :=
  a ≠ b ∧ c ≠ d ∧ directionCross(a, b, c, d) = 0

theorem directionCross.real (a b c d : Point)
  shows Real(directionCross(a, b, c, d))
proof
  unfold directionCross
  typecheck

theorem midpoint.collinear (a b m : Point)
  requires middle : Midpoint(m, a, b)
  shows Collinear(a, m, b)
proof
  rcases middle with ⟨horizontal, vertical⟩
  have doubled : directionCross(a, m, a, b) + directionCross(a, m, a, b) = (0:R) + (0:R)
    unfold directionCross
    linear_combination -(y(b) - y(a)) * horizontal + (x(b) - x(a)) * vertical
  unfold Collinear
  exact realAddValue.double_cancel with realZero.real, doubled

-- Twice the displacement between two side midpoints is the third side.
theorem midsegment.direction (a b c m n : Point)
  requires first : Midpoint(m, c, a)
  requires second : Midpoint(n, c, b)
  shows (x(n) - x(m)) + (x(n) - x(m)) = x(b) - x(a) ∧
    (y(n) - y(m)) + (y(n) - y(m)) = y(b) - y(a)
proof
  rcases first with ⟨firstX, firstY⟩
  rcases second with ⟨secondX, secondY⟩
  constructor
  . linear_combination firstX - secondX
  . linear_combination firstY - secondY

theorem midsegment.distinct (a b c m n : Point)
  requires first : Midpoint(m, c, a)
  requires second : Midpoint(n, c, b)
  requires base : a ≠ b
  shows m ≠ n
proof
  rcases first with ⟨firstX, firstY⟩
  rcases second with ⟨secondX, secondY⟩
  intro equal
  rw equal at firstX
  rw equal at firstY
  have horizontal : x(a) = x(b) by linear_combination firstX - secondX
  have vertical : y(a) = y(b) by linear_combination firstY - secondY
  have same := point.ext with *
  exact base with same

theorem midsegment.parallel (a b c m n : Point)
  requires first : Midpoint(m, c, a)
  requires second : Midpoint(n, c, b)
  requires base : a ≠ b
  shows ParallelSegments(m, n, a, b)
proof
  have direction := midsegment.direction at a, b, c, m, n with *
  rcases direction with ⟨horizontal, vertical⟩
  have distinct := midsegment.distinct with *
  have area := directionCross.real at m, n, a, b with *
  have doubled : directionCross(m, n, a, b) + directionCross(m, n, a, b) = (0:R) + (0:R)
    unfold directionCross
    linear_combination (y(b) - y(a)) * horizontal - (x(b) - x(a)) * vertical
  have parallel := realAddValue.double_cancel with area, realZero.real, doubled
  unfold ParallelSegments
  refine ⟨distinct, base, parallel⟩

-- The midsegment has half the length of the third side, stated in squares.
theorem midsegment.length (a b c m n : Point)
  requires first : Midpoint(m, c, a)
  requires second : Midpoint(n, c, b)
  shows Euclidean.distanceSquared(a, b) =
    Euclidean.distanceSquared(m, n) + Euclidean.distanceSquared(m, n) +
    Euclidean.distanceSquared(m, n) + Euclidean.distanceSquared(m, n)
proof
  have direction := midsegment.direction at a, b, c, m, n with *
  rcases direction with ⟨horizontal, vertical⟩
  have base := Euclidean.distanceSquared.coordinates at a, b with *
  have segment := Euclidean.distanceSquared.coordinates at m, n with *
  rw [base, segment]
  have squareX := realMulValue.square_of_double with horizontal
  have squareY := realMulValue.square_of_double with vertical
  rw [squareX, squareY]
  ring

-- Midsegments with the same directed base have the same displacement.
-- This is the geometric bridge used by Varignon's theorem.
theorem midsegment.equal_vectors (a b c d m n p q : Point)
  requires firstM : Midpoint(m, c, a)
  requires firstN : Midpoint(n, c, b)
  requires secondP : Midpoint(p, d, a)
  requires secondQ : Midpoint(q, d, b)
  shows vector(m, n) = vector(p, q)
proof
  have first := midsegment.direction at a, b, c, m, n with *
  have second := midsegment.direction at a, b, d, p, q with *
  rcases first with ⟨firstX, firstY⟩
  rcases second with ⟨secondX, secondY⟩
  have horizontal : x(n) - x(m) = x(q) - x(p)
    apply realAddValue.double_cancel
    . cc
  have vertical : y(n) - y(m) = y(q) - y(p)
    apply realAddValue.double_cancel
    . cc
  have components : x(n) - x(m) = x(q) - x(p) ∧
      y(n) - y(m) = y(q) - y(p)
    refine ⟨horizontal, vertical⟩
  exact vector.equal_iff.backward with components

end Euclidean
