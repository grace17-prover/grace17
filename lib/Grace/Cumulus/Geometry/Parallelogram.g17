module Grace.Cumulus.Geometry.Parallelogram
import Lines

namespace Euclidean
export open Euclidean

-- The affine parallelogram identity, allowing degenerate configurations.
-- Opposite directed sides agree. Nonzero-side hypotheses are supplied when
-- asserting ParallelSegments; coincident supporting lines remain allowed.
predicate Parallelogram (a b c d : Set) := vector(a, b) = vector(d, c)

theorem parallelogram.rotate (a b c d : Point)
  requires shape : Parallelogram(a, b, c, d)
  shows Parallelogram(b, c, d, a)
proof
  unfold Parallelogram at shape
  obtain ⟨horizontal, vertical⟩ := vector.equal_iff.forward with shape
  have other : x(c) - x(b) = x(d) - x(a) ∧
      y(c) - y(b) = y(d) - y(a)
    constructor
    . linear_combination -horizontal
    . linear_combination -vertical
  unfold Parallelogram
  exact vector.equal_iff.backward with other

theorem parallelogram.opposite_lengths (a b c d : Point)
  requires shape : Parallelogram(a, b, c, d)
  shows Euclidean.distanceSquared(a, b) = Euclidean.distanceSquared(d, c) ∧
    Euclidean.distanceSquared(b, c) = Euclidean.distanceSquared(a, d)
proof
  have other := parallelogram.rotate with *
  unfold Parallelogram at shape
  unfold Parallelogram at other
  constructor
  . unfold Euclidean.distanceSquared
    cc
  . unfold Euclidean.distanceSquared
    cc

theorem parallelogram.parallel (a b c d : Point)
  requires shape : Parallelogram(a, b, c, d)
  requires first : a ≠ b
  requires second : d ≠ c
  shows ParallelSegments(a, b, d, c)
proof
  unfold Parallelogram at shape
  obtain ⟨horizontal, vertical⟩ := vector.equal_iff.forward with shape
  have cross : directionCross(a, b, d, c) = 0
    simp [directionCross]
    ring
  unfold ParallelSegments
  refine ⟨first, second, cross⟩

-- Diagonals that bisect one another give the same affine parallelogram.
theorem parallelogram.of_bisected_diagonals (a b c d m : Point)
  requires first : Midpoint(m, a, c)
  requires second : Midpoint(m, b, d)
  shows Parallelogram(a, b, c, d)
proof
  rcases first with ⟨firstX, firstY⟩
  rcases second with ⟨secondX, secondY⟩
  have components : x(b) - x(a) = x(c) - x(d) ∧
      y(b) - y(a) = y(c) - y(d)
    constructor
    . linear_combination secondX - firstX
    . linear_combination secondY - firstY
  unfold Parallelogram
  exact vector.equal_iff.backward with components

theorem parallelogram.bisects (a b c d m : Point)
  requires shape : Parallelogram(a, b, c, d)
  requires first : Midpoint(m, a, c)
  shows Midpoint(m, b, d)
proof
  unfold Parallelogram at shape
  obtain ⟨horizontal, vertical⟩ := vector.equal_iff.forward with shape
  rcases first with ⟨firstX, firstY⟩
  constructor
  . linear_combination firstX + horizontal
  . linear_combination firstY + vertical

theorem parallelogram.diagonals (a b c d : Point)
  requires shape : Parallelogram(a, b, c, d)
  shows ∃ m, Point(m) ∧ Midpoint(m, a, c) ∧ Midpoint(m, b, d)
proof
  have point := midpoint.point at a, c with *
  have first := midpoint.correct at a, c with *
  have second := parallelogram.bisects with *
  refine ⟨midpoint(a, c), point, first, second⟩

theorem parallelogram.iff_diagonals (a b c d : Point)
  shows Parallelogram(a, b, c, d) ↔
    ∃ m, Point(m) ∧ Midpoint(m, a, c) ∧ Midpoint(m, b, d)
proof
  constructor
  . intro shape
    exact parallelogram.diagonals with *
  . intro center
    rcases center with ⟨m, point, first, second⟩
    exact parallelogram.of_bisected_diagonals with *

-- The two pairs of side midpoints are midsegments of triangles sharing AC.
-- Both directed midsegments are half of that same directed diagonal.
theorem varignon (a b c d m n p q : Point)
  requires first : Midpoint(m, a, b)
  requires second : Midpoint(n, b, c)
  requires third : Midpoint(p, c, d)
  requires fourth : Midpoint(q, d, a)
  shows Parallelogram(m, n, p, q)
proof
  have firstReversed := midpoint.symmetric at a, b, m with *
  have thirdReversed := midpoint.symmetric at c, d, p with *
  unfold Parallelogram
  exact midsegment.equal_vectors with *

-- Nonzero original diagonals give nonzero sides of the midpoint figure.
-- No convexity or simplicity assumption is needed for this affine result.
theorem varignon.parallel (a b c d m n p q : Point)
  requires first : Midpoint(m, a, b)
  requires second : Midpoint(n, b, c)
  requires third : Midpoint(p, c, d)
  requires fourth : Midpoint(q, d, a)
  requires firstDiagonal : a ≠ c
  requires secondDiagonal : b ≠ d
  shows ParallelSegments(m, n, q, p) ∧ ParallelSegments(n, p, m, q)
proof
  have shape := varignon at a, b, c, d, m, n, p, q with *
  have rotated := parallelogram.rotate at m, n, p, q with *
  have firstReversed := midpoint.symmetric at a, b, m with *
  have secondReversed := midpoint.symmetric at b, c, n with *
  have thirdReversed := midpoint.symmetric at c, d, p with *
  have fourthReversed := midpoint.symmetric at d, a, q with *
  have mn := midsegment.distinct at a, c, b, m, n with *
  have qp := midsegment.distinct at a, c, d, q, p with *
  have np := midsegment.distinct at b, d, c, n, p with *
  have mq := midsegment.distinct at b, d, a, m, q with *
  have opposite := parallelogram.parallel at m, n, p, q with *
  have other := parallelogram.parallel at n, p, q, m with *
  refine ⟨opposite, other⟩

theorem varignon.constructed (a b c d : Point)
  shows Parallelogram(midpoint(a, b), midpoint(b, c),
    midpoint(c, d), midpoint(d, a))
proof
  have mPoint := midpoint.point at a, b with *
  have nPoint := midpoint.point at b, c with *
  have pPoint := midpoint.point at c, d with *
  have qPoint := midpoint.point at d, a with *
  have first := midpoint.correct at a, b with *
  have second := midpoint.correct at b, c with *
  have third := midpoint.correct at c, d with *
  have fourth := midpoint.correct at d, a with *
  exact varignon at a, b, c, d, midpoint(a, b), midpoint(b, c), midpoint(c, d), midpoint(d, a) with *

end Euclidean
