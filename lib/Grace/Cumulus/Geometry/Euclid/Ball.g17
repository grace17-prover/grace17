-- The closed unit ball of ℝ³ and the punctured ball, which every rotation
-- carries into itself
-- Part of Cumulus, the Grace17 mathematics library.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module Grace.Cumulus.Geometry.Euclid.Ball
import Motions

def unitBall : Set := { v ∈ ℝ³ | normSq(v) ≤ (1:R) }
def puncturedBall : Set := unitBall ∖ {zeroVector}

theorem puncturedBall.graph
  shows puncturedBall = unitBall ∖ {zeroVector}
proof
  simp [puncturedBall]

theorem unitBall.subset
  shows unitBall ⊆ ℝ³
proof
  intros v hv
  have parts := unitBall.membership.forward with hv
  exact parts.left

theorem unitBall.function (v : Set)
  requires member : v ∈ unitBall
  shows v : 3 → ℝ
proof
  exact ℝ³.function with (unitBall.subset with v, member)

theorem puncturedBall.membership (v : Set)
  shows v ∈ puncturedBall ↔ v ∈ unitBall ∧ v ≠ zeroVector
proof
  rw puncturedBall.graph
  constructor
  . intro hv
    obtain ⟨inBall, notZero⟩ := difference.membership.forward with hv
    refine ⟨inBall, ?_⟩
    intro equal
    apply notZero
    rw equal
    exact singleton.self
  . intro hv
    obtain ⟨inBall, notZero⟩ := hv
    apply difference.membership.backward
    refine ⟨inBall, ?_⟩
    intro inSingleton
    exact notZero with (singleton.membership.forward with inSingleton)

theorem puncturedBall.subset
  shows puncturedBall ⊆ unitBall
proof
  rw puncturedBall.graph
  exact difference.subset_left at unitBall, {zeroVector}

theorem puncturedBall.subset_space
  shows puncturedBall ⊆ ℝ³
proof
  exact Subset.transitive with puncturedBall.subset, unitBall.subset

theorem zeroVector.in_ball
  shows zeroVector ∈ unitBall
proof
  have zeroIn : zeroVector ∈ ℝ³ := ℝ³.of_function with zeroVector.vector
  have bound : normSq(zeroVector) ≤ (1:R)
    rw zeroVector.normSq
    linarith
  exact unitBall.membership.backward with ⟨zeroIn, bound⟩

-- The sphere lies in the punctured ball.
theorem sphere.subset_ball
  shows S² ⊆ unitBall
proof
  intros v hv
  obtain ⟨inSpace, unit⟩ := S².membership.forward with hv
  have bound : normSq(v) ≤ (1:R)
    rw unit
    linarith
  exact unitBall.membership.backward with ⟨inSpace, bound⟩

theorem sphere.subset_punctured
  shows S² ⊆ puncturedBall
proof
  intros v hv
  obtain ⟨inSpace, unit⟩ := S².membership.forward with hv
  have inBall := sphere.subset_ball with v, hv
  have notZero : v ≠ zeroVector
    intro equal
    rw [equal, zeroVector.normSq] at unit
    linarith
  exact puncturedBall.membership.backward with ⟨inBall, notZero⟩

-- A rotation preserves the ball and misses the origin only at the origin.
theorem unitBall.rotate (M : realRing ^ 3 × 3) (v : Set)
  requires hM : M ∈ so3Matrices
  requires hv : v ∈ unitBall
  shows M · v ∈ unitBall
proof
  obtain ⟨inSpace, bound⟩ := unitBall.membership.forward with hv
  have vector := ℝ³.function with inSpace
  have orthogonal := so3Matrices.orthogonal with hM
  have image := matrixVector.vector at M, v with *
  have imageIn := ℝ³.of_function with image
  have norm := Orthogonal.normSq with orthogonal, vector
  have imageBound : normSq(M · v) ≤ (1:R)
    rw norm
    exact bound
  exact unitBall.membership.backward with ⟨imageIn, imageBound⟩

theorem matrixVector.eq_zero (M : realRing ^ 3 × 3) (v : Set)
  requires hM : M ∈ so3Matrices
  requires vector : v : 3 → ℝ
  requires zero : M · v = zeroVector
  shows v = zeroVector
proof
  have transposed := transpose.matrix at M with *
  have orthogonal := so3Matrices.orthogonal with hM
  have left := Orthogonal.left with orthogonal
  have composed := matrixVector.mul at transpose(M), M, v with vector
  have unit := matrixVector.one at v with vector
  have killed := matrixVector.zero_vector at transpose(M) with *
  rw [left, unit, zero, killed] at composed
  exact composed

theorem puncturedBall.rotate (M : realRing ^ 3 × 3) (v : Set)
  requires hM : M ∈ so3Matrices
  requires hv : v ∈ puncturedBall
  shows M · v ∈ puncturedBall
proof
  obtain ⟨inBall, notZero⟩ := puncturedBall.membership.forward with hv
  have vector := unitBall.function with inBall
  have imageIn := unitBall.rotate with hM, inBall
  have imageNotZero : M · v ≠ zeroVector
    intro zero
    exact notZero with (matrixVector.eq_zero with hM, vector, zero)
  exact puncturedBall.membership.backward with ⟨imageIn, imageNotZero⟩

theorem puncturedBall.invariant
  shows ∀ M ∈ Group.carrier(SO3), ∀ v ∈ puncturedBall, spaceAction(M,
      v) ∈ puncturedBall
proof
  intros M hM v hv
  rw SO3.carrierOf at hM
  have matrixM := so3Matrices.matrix with hM
  have inSpace := puncturedBall.subset_space with v, hv
  have value := spaceAction.apply with hM, inSpace
  rw value
  exact puncturedBall.rotate with hM, hv
