module Grace.Cumulus.Geometry.Plane
import Pythagoras
import Real.Squares

namespace Euclidean
export open Euclidean

-- Points are ordered pairs of reals.
predicate Point (p : Set) := ∃ a ∈ ℝ, ∃ b ∈ ℝ, p = (a, b)

defunique coordinateX (p : Set) (a ∈ ℝ) := ∃ b ∈ ℝ, p = (a, b)
requires point : Point(p)
proof
  unfold Point at point
  exact point

uniqueness
  intros a aMember first c cMember second
  obtain ⟨b, bMember, firstPair⟩ := first
  obtain ⟨d, dMember, secondPair⟩ := second
  have same : (a, b) = (c, d)
    cc
  have coordinates := orderedPair.injective at a, b, c, d with same
  tauto

def x (p : Point) : Real := coordinateX(p)

defunique coordinateY (p : Set) (b ∈ ℝ) := p = (x(p), b)
requires point : Point(p)
proof
  have selected := coordinateX.selected at p with point
  rcases selected with ⟨realX, b, realB, pair⟩
  witness b
  constructor
  . exact realB
  . unfold x
    rfl

uniqueness
  intros b bMember first d dMember second
  have same : (x(p), b) = (x(p), d)
    cc
  have coordinates := orderedPair.injective at x(p), b, x(p), d with same
  tauto

def y (p : Point) : Real := coordinateY(p)

theorem x.real (p : Point)
  shows Real(x(p))
proof
  obtain ⟨realX, rest⟩ := coordinateX.selected at p with assumption
  unfold x
  exact realX

theorem y.real (p : Point)
  shows Real(y(p))
proof
  obtain ⟨realY, pair⟩ := coordinateY.selected at p with assumption
  unfold y
  exact realY

theorem coordinates (p : Point)
  shows p = (x(p), y(p))
proof
  obtain ⟨realY, pair⟩ := coordinateY.selected at p with assumption
  unfold y
  rfl

theorem pair.point (a b : Real)
  shows Point((a, b))
proof
  unfold Point
  have ha : a ∈ ℝ by simp [Real]
  have hb : b ∈ ℝ by simp [Real]
  refine ⟨a, ha, b, hb, rfl⟩

theorem x.pair (a b : Real)
  shows x((a, b)) = a
proof
  have point := pair.point at a, b with *
  have coords := coordinates with point
  have equal := orderedPair.injective with coords
  simp

theorem y.pair (a b : Real)
  shows y((a, b)) = b
proof
  have point := pair.point at a, b with *
  have coords := coordinates with point
  have equal := orderedPair.injective with coords
  simp

theorem point.ext (p q : Point)
  requires horizontal : x(p) = x(q)
  requires vertical : y(p) = y(q)
  shows p = q
proof
  have pCoords := coordinates at p with assumption
  have qCoords := coordinates at q with assumption
  cc

-- A displacement is another pair of real coordinates.
def vector (a b : Set) : Set := (x(b) - x(a), y(b) - y(a))
def dot (u v : Point) : Real := x(u) * x(v) + y(u) * y(v)
def normSquared (u : Point) : Real := dot(u, u)
def distanceSquared (a b : Point) : Real := normSquared(vector(a, b))

theorem vector.point (a b : Point)
  shows Point(vector(a, b))
proof
  have ax := x.real at a with assumption
  have ay := y.real at a with assumption
  have bx := x.real at b with assumption
  have byReal := y.real at b with assumption
  have horizontal := realSubValue.real with bx, ax
  have vertical := realSubValue.real with byReal, ay
  unfold vector
  exact pair.point with horizontal, vertical

theorem vector.x (a b : Point)
  shows x(vector(a, b)) = x(b) - x(a)
proof
  have ax := x.real at a with assumption
  have ay := y.real at a with assumption
  have bx := x.real at b with assumption
  have byReal := y.real at b with assumption
  have horizontal := realSubValue.real with bx, ax
  have vertical := realSubValue.real with byReal, ay
  unfold vector
  exact x.pair with horizontal, vertical

theorem vector.y (a b : Point)
  shows y(vector(a, b)) = y(b) - y(a)
proof
  have ax := x.real at a with assumption
  have ay := y.real at a with assumption
  have bx := x.real at b with assumption
  have byReal := y.real at b with assumption
  have horizontal := realSubValue.real with bx, ax
  have vertical := realSubValue.real with byReal, ay
  unfold vector
  exact y.pair with horizontal, vertical

-- Dot products of two directed segments in their endpoint coordinates.
theorem vector.dot_coordinates (a b c d : Point)
  shows dot(vector(a, b), vector(c, d)) =
    (x(b) - x(a)) * (x(d) - x(c)) + (y(b) - y(a)) * (y(d) - y(c))
proof
  have firstX := vector.x at a, b with *
  have firstY := vector.y at a, b with *
  have secondX := vector.x at c, d with *
  have secondY := vector.y at c, d with *
  unfold dot
  cc

-- Equality of displacements can be used without exposing ordered-pair encodings.
theorem vector.equal_iff (a b c d : Set)
  shows vector(a, b) = vector(c, d) ↔
    x(b) - x(a) = x(d) - x(c) ∧ y(b) - y(a) = y(d) - y(c)
proof
  constructor
  . intro equal
    unfold vector at equal
    unfold vector at equal
    exact orderedPair.injective with equal
  . intro components
    rcases components with ⟨horizontal, vertical⟩
    unfold vector
    unfold vector
    cc

theorem dot.real (u v : Point)
  shows Real(dot(u, v))
proof
  have ux := x.real at u with assumption
  have uy := y.real at u with assumption
  have vx := x.real at v with assumption
  have vy := y.real at v with assumption
  have horizontal := realMulValue.real with ux, vx
  have vertical := realMulValue.real with uy, vy
  unfold dot
  exact realAddValue.real with horizontal, vertical

theorem normSquared.real (u : Point)
  shows Real(normSquared(u))
proof
  unfold normSquared
  exact dot.real with *

theorem distanceSquared.real (a b : Point)
  shows Real(distanceSquared(a, b))
proof
  have displacement := vector.point at a, b with *
  unfold distanceSquared
  exact normSquared.real with displacement

theorem distanceSquared.coordinates (a b : Point)
  shows distanceSquared(a, b) =
    (x(b) - x(a)) * (x(b) - x(a)) + (y(b) - y(a)) * (y(b) - y(a))
proof
  unfold distanceSquared
  unfold normSquared
  unfold dot
  have coordinateRule1 := vector.x at a, b with *
  rw coordinateRule1
  have coordinateRule2 := vector.y at a, b with *
  rw coordinateRule2
  rfl

theorem normSquared.nonnegative (u : Point)
  shows 0 ≤ normSquared(u)
proof
  have ux := x.real with assumption
  have uy := y.real with assumption
  unfold normSquared
  unfold dot
  exact realAddValue.sum_squares_nonnegative with ux, uy

theorem distanceSquared.symmetric (a b : Point)
  shows distanceSquared(a, b) = distanceSquared(b, a)
proof
  have coordinateRule3 := distanceSquared.coordinates at a, b with *
  rw coordinateRule3
  have coordinateRule4 := distanceSquared.coordinates at b, a with *
  rw coordinateRule4
  ring

theorem distanceSquared.nonnegative (a b : Point)
  shows 0 ≤ distanceSquared(a, b)
proof
  have displacement := vector.point at a, b with *
  unfold distanceSquared
  exact normSquared.nonnegative with displacement

theorem distanceSquared.zero_iff (a b : Point)
  shows distanceSquared(a, b) = 0 ↔ a = b
proof
  have ax := x.real at a with assumption
  have ay := y.real at a with assumption
  have bx := x.real at b with assumption
  have byReal := y.real at b with assumption
  have dx := realSubValue.real with bx, ax
  have dy := realSubValue.real with byReal, ay
  have xx := realMulValue.square_nonnegative with dx
  have yy := realMulValue.square_nonnegative with dy
  have formula := distanceSquared.coordinates at a, b with *
  constructor
  . intro zeroDistance
    rw formula at zeroDistance
    have squareX := realAddValue.nonnegative_eq_zero with xx, yy, zeroDistance
    have reversed : (y(b) - y(a)) * (y(b) - y(a)) + (x(b) - x(a)) * (x(b) - x(a)) = 0 by ring
    have squareY := realAddValue.nonnegative_eq_zero with yy, xx, reversed
    have zeroX := realMulValue.square_eq_zero_iff.forward with squareX
    have zeroY := realMulValue.square_eq_zero_iff.forward with squareY
    have equalX : x(a) = x(b) by linear_combination -zeroX
    have equalY : y(a) = y(b) by linear_combination -zeroY
    exact point.ext with *
  . intro equal
    rw equal
    have coordinateRule5 := distanceSquared.coordinates at b, b with *
    rw coordinateRule5
    ring

theorem distanceSquared.positive (a b : Point)
  requires distinct : a ≠ b
  shows 0 < distanceSquared(a, b)
proof
  have nonnegative := distanceSquared.nonnegative at a, b with *
  have nonzero : distanceSquared(a, b) ≠ 0
    intro zeroDistance
    have equal := distanceSquared.zero_iff.forward with *
    exact distinct with equal
  exact Real.positive_of_nonnegative_of_ne_zero with nonnegative, nonzero

-- The middle point is the vertex of the angle.
def angleDot (a b c : Point) : Real := dot(vector(b, a), vector(b, c))

predicate RightAngle (a b c : Set) := angleDot(a, b, c) = 0

theorem angleDot.real (a b c : Point)
  shows Real(angleDot(a, b, c))
proof
  have first := vector.point at b, a with *
  have second := vector.point at b, c with *
  unfold angleDot
  exact dot.real with first, second

theorem angleDot.coordinates (a b c : Point)
  shows angleDot(a, b, c) =
    (x(a) - x(b)) * (x(c) - x(b)) + (y(a) - y(b)) * (y(c) - y(b))
proof
  unfold angleDot
  unfold dot
  have coordinateRule6 := vector.x at b, a with *
  rw coordinateRule6
  have coordinateRule7 := vector.x at b, c with *
  rw coordinateRule7
  have coordinateRule8 := vector.y at b, a with *
  rw coordinateRule8
  have coordinateRule9 := vector.y at b, c with *
  rw coordinateRule9
  rfl

-- The cosine-law identity, stated without division or square roots.
theorem cosine_identity (a b c : Point)
  shows distanceSquared(a, c) + angleDot(a, b, c) + angleDot(a, b, c) =
    distanceSquared(a, b) + distanceSquared(b, c)
proof
  have coordinateRule10 := distanceSquared.coordinates at a, c with *
  rw coordinateRule10
  have coordinateRule11 := distanceSquared.coordinates at a, b with *
  rw coordinateRule11
  have coordinateRule12 := distanceSquared.coordinates at b, c with *
  rw coordinateRule12
  have coordinateRule13 := angleDot.coordinates at a, b, c with *
  rw coordinateRule13
  ring

theorem pythagoras (a b c : Point)
  requires right : RightAngle(a, b, c)
  shows distanceSquared(a, c) = distanceSquared(a, b) + distanceSquared(b, c)
proof
  have identity := cosine_identity at a, b, c with *
  unfold RightAngle at right
  linear_combination identity - (2:R) * right

end Euclidean
