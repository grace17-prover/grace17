-- The explicit noncoordinate polynomial with affine three-space zero
-- fibre: F = h − P(x, y, s) − 1 in ℂ[h, u, v, w] has ℂ[h, u, v, w] ⧸ (F)
-- isomorphic to ℂ[3], has a critical point, and is sent to no variable by
-- any automorphism of ℂ[h, u, v, w]; and the same holds in every dimension
-- at least four.
-- Part of Cumulus, the Grace17 mathematics library.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module Grace.Cumulus.AlgebraicGeometry.Coordinates.Theorem
import Grace.Cumulus.AlgebraicGeometry.Coordinates.Stabilization
import Grace.Cumulus.Nat.SubtractionLemmas

-- F is not a coordinate: it has a critical point, and a coordinate has
-- none.
theorem ambientF.not_coordinate
  shows ¬ (∃ e, ∃ i ∈ 4, (e : ambientAlgebra ≃ₐ ambientAlgebra) ∧
    e(X(complexRing, 4, i)) = ambientF)
proof
  have complexes := complexRing.comm_ring
  have ambient := polynomialRing.comm_ring at complexRing, 4 with complexes
  have member := ambientF.mem with *
  have values := criticalPoint.function
  have critical : ∀ i ∈ 4,
      evaluationAt(complexRing, 4, criticalPoint)(
        partialDerivative(complexRing, 4, i)(ambientF)) = Ring.zero(complexRing)
    intros i index
    rw complexRing.zeroOf
    exact criticalPoint.derivatives with index
  unfold ambientAlgebra
  exact no_coordinate_of_critical at complexRing, 4, ambientF, criticalPoint
    with complexes, complexRing.nontrivial, member, values, critical

-- The counterexample to the Abhyankar–Sathaye conjecture, as stated in the
-- source: a polynomial fibre, a critical point with F = −1 there, and no
-- automorphism sending a variable to F.
theorem counterexample
  shows (∃ e, e : fibreAlgebra ≃ₐ polynomialAlgebra(complexRing, 3)) ∧
    (∀ i ∈ 4, evaluationAt(complexRing, 4, criticalPoint)(
      partialDerivative(complexRing, 4, i)(ambientF)) = complexZero) ∧
    evaluationAt(complexRing, 4, criticalPoint)(ambientF) =
      complexNeg(complexOne) ∧
    ¬ (∃ e, ∃ i ∈ 4, (e : ambientAlgebra ≃ₐ ambientAlgebra) ∧
      e(X(complexRing, 4, i)) = ambientF)
proof
  have derivatives : ∀ i ∈ 4, evaluationAt(complexRing, 4, criticalPoint)(
      partialDerivative(complexRing, 4, i)(ambientF)) = complexZero
    intros i index
    exact criticalPoint.derivatives with index
  have value := criticalPoint.eval_F
  have noCoordinate := ambientF.not_coordinate
  refine ⟨?_, derivatives, value, noCoordinate⟩
  exact fibre_equivalence

-- In every dimension at least four, a polynomial can define affine space
-- without being a coordinate of the ambient polynomial ring.
theorem exists_noncoordinate_polynomial (n : Nat)
  requires bound : 4 ≤ n
  shows ∃ F ∈ Ring.carrier(polynomialRing(complexRing, n)),
    (∃ e, e : quotientAlgebra(polynomialAlgebra(complexRing, n),
      generatedIdeal(polynomialRing(complexRing, n), {F})) ≃ₐ
      polynomialAlgebra(complexRing, n - 1)) ∧
    ¬ (∃ e, ∃ i ∈ n,
      (e : polynomialAlgebra(complexRing, n) ≃ₐ
        polynomialAlgebra(complexRing, n)) ∧
      e(X(complexRing, n, i)) = F)
proof
  obtain ⟨k, kNat, shape⟩ := bound
  have sum : 3 + k + 1 = n
    rw ← shape
    arith
  have predecessor := sub.of_add_eq with sum
  have member := extendedF.mem at k with kNat
  have fibre := extended_fibre at k with kNat
  have noCoordinate := extendedF.not_coordinate at k with kNat
  unfold extendedIdeal at fibre
  rw predecessor
  rw ← shape
  witness extendedF(k)
  refine ⟨member, ?_, noCoordinate⟩
  exact fibre
