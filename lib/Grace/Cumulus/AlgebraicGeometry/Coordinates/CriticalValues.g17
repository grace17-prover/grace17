-- The critical point (h, u, v, w) = (2, 0, −1/2, 1/2) of the explicit
-- polynomial, as a function on 4 into ℂ, with its coordinates as members
-- of ℂ and h as the complex numeral 2.
-- Part of Cumulus, the Grace17 mathematics library.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module Grace.Cumulus.AlgebraicGeometry.Coordinates.CriticalValues
import Grace.Cumulus.Set.Function.Quadruples
import Grace.Cumulus.Real.Metric
import Grace.Cumulus.Complex.Field

-- The critical point.

-- The coordinates of the critical point, as complex numbers.
def criticalH : Set := (realNumeral(2), realZero)

def criticalV : Set := (realNeg(half(realOne)), realZero)

def criticalW : Set := (half(realOne), realZero)

def criticalPoint : Set :=
  quadrupleMap(complexCarrier, criticalH, complexZero, criticalV, criticalW)

instance criticalH.mem
  shows criticalH ∈ complexCarrier
proof
  have twoReal := realNumeral.real at 2 with *
  unfold criticalH
  exact complexCarrier.pair with *

instance criticalV.mem
  shows criticalV ∈ complexCarrier
proof
  have halfReal := half.real at realOne with *
  have negReal : Real(realNeg(half(realOne))) by typecheck
  unfold criticalV
  exact complexCarrier.pair with *

instance criticalW.mem
  shows criticalW ∈ complexCarrier
proof
  have halfReal := half.real at realOne with *
  unfold criticalW
  exact complexCarrier.pair with *

theorem criticalPoint.function
  shows criticalPoint : 4 → Ring.carrier(complexRing)
proof
  have zeroIn := complexZero.member
  unfold criticalPoint
  rw complexRing.carrierOf
  exact quadrupleMap.function with *

-- The coordinate h is the complex numeral 2.
theorem criticalH.numeral
  shows criticalH = ringNat(complexAdd, complexZero, complexOne, 2)
proof
  rw complexNumeral.pair
  unfold criticalH
  rfl
