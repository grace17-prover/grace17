-- A polynomial with a critical point is not a coordinate: if every partial
-- derivative of f vanishes at a point, no automorphism of the polynomial
-- algebra sends a variable to f, by the chain rule evaluated at the point.
-- Part of Cumulus, the Grace17 mathematics library.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module Grace.Cumulus.AlgebraicGeometry.Coordinates.NoCoordinate
import Grace.Cumulus.Algebra.Polynomial.ChainRule

-- Sums under a ring homomorphism.

-- A ring homomorphism kills a sum all of whose terms it kills.
theorem RingHom.sum_zero (S T f g : Set, m : Nat)
  requires sourceRing : CommRing(S)
  requires targetRing : CommRing(T)
  requires hom : f : S →+* T
  shows (∀ k ∈ m, g(k) ∈ Ring.carrier(S)) →
    (∀ k ∈ m, f(g(k)) = Ring.zero(T)) →
    f(indexedRingSum(identity(Ring.carrier(S)), g, Ring.add(S), Ring.zero(S),
      m)) = Ring.zero(T)
proof
  induction m
  | zero =>
    intros values zeros
    rw indexedRingSum
    exact RingHom.map_zero with hom
  | succ(k) using ih =>
    intros values zeros
    have prefix : ∀ l ∈ k, g(l) ∈ Ring.carrier(S)
      intros l hl
      have next := membership.into_successor at l, k with hl
      exact values with l, next
    have prefixZeros : ∀ l ∈ k, f(g(l)) = Ring.zero(T)
      intros l hl
      have next := membership.into_successor at l, k with hl
      exact zeros with l, next
    have last := values with k, membership.self_successor at k with *
    have lastZero := zeros with k, membership.self_successor at k with *
    have previous := ih with prefix, prefixZeros
    have sumIn := indexedRingSum.identity_mem at S, g, k with sourceRing, prefix
    have value := identity.apply at g(k), Ring.carrier(S) with last
    have mapped := RingHom.map_add at f, S, T,
      indexedRingSum(identity(Ring.carrier(S)), g, Ring.add(S), Ring.zero(S),
        k), g(k) with *
    rw [indexedRingSum, value, mapped, previous, lastZero]
    ring

-- The pulled point: evaluation after an endomorphism of K[n] is evaluation
-- at another point.

-- The point whose k-th coordinate is the value of φ(X_k) at c.
def pulledPoint (R n φ c : Set) : Set :=
  { p ∈ n × Ring.carrier(R) |
    snd(p) = evaluationAt(R, n, c)(φ(X(R, n, fst(p)))) }

section Pulled
variable (R : Set, n : Nat, φ c : Set)
hypothesis ring : CommRing(R)
hypothesis hom : φ : polynomialAlgebra(R, n) →ₐ polynomialAlgebra(R, n)
hypothesis values : c : n → Ring.carrier(R)

theorem pulledPoint.coordinate_mem (k : Set)
  requires position : k ∈ n
  shows evaluationAt(R, n, c)(φ(X(R, n, k))) ∈ Ring.carrier(R)
proof
  have polynomials := polynomialRing.comm_ring at R, n with ring
  have ringHom := AlgebraHom.polynomial_ring_hom at R, n, n, φ with hom
  have evaluation := evaluationAt.hom at R, n, c with ring, values
  have variable : X(R, n, k) ∈ polynomialRing(R, n) := X.mem at R, n, k with *
  have mapped : φ(X(R, n, k)) ∈ polynomialRing(R, n) :=
    RingHom.map_mem with ringHom, variable
  exact RingHom.map_mem with evaluation, mapped

theorem pulledPoint.function
  shows pulledPoint(R, n, φ, c) : n → Ring.carrier(R)
proof
  constructor
  . intros e he
    exact he.left
  constructor
  . intros x y relatedY z relatedZ
    obtain ⟨_, shapeY⟩ := relatedY
    obtain ⟨_, shapeZ⟩ := relatedZ
    simp [fst.pair, snd.pair] at shapeY, shapeZ
    cc
  . intros k hk
    have valueIn := pulledPoint.coordinate_mem with ring, hom, values, hk
    refine ⟨evaluationAt(R, n, c)(φ(X(R, n, k))), valueIn, _⟩
    apply pulledPoint.membership.backward
    refine ⟨(product.pair with hk, valueIn), _⟩
    simp [fst.pair, snd.pair]

theorem pulledPoint.value (k : Set)
  requires position : k ∈ n
  shows pulledPoint(R, n, φ, c)(k) = evaluationAt(R, n, c)(φ(X(R, n, k)))
proof
  have function := pulledPoint.function with *
  have valueIn := pulledPoint.coordinate_mem with ring, hom, values, position
  have related : relates(pulledPoint(R, n, φ, c), k,
      evaluationAt(R, n, c)(φ(X(R, n, k))))
    apply pulledPoint.membership.backward
    refine ⟨(product.pair with position, valueIn), _⟩
    simp [fst.pair, snd.pair]
  exact FunctionBetween.apply_value with function, position, related

-- Evaluation at c after φ is evaluation at the pulled point.
theorem evaluationAt.compose_hom
  shows compose(evaluationAt(R, n, c), φ, Ring.carrier(polynomialRing(R, n)),
      Ring.carrier(polynomialRing(R, n)), Ring.carrier(R)) =
    evaluationAt(R, n, pulledPoint(R, n, φ, c))
proof
  have polynomials := polynomialRing.comm_ring at R, n with ring
  have ringHom := AlgebraHom.polynomial_ring_hom at R, n, n, φ with hom
  have evaluation := evaluationAt.hom at R, n, c with ring, values
  have pulled := pulledPoint.function with *
  have pulledEvaluation := evaluationAt.hom at R, n, pulledPoint(R, n, φ, c)
    with ring, pulled
  have composite := RingHom.comp with polynomials, ringHom, evaluation
  obtain ⟨_, _, functionPhi, _⟩ := ringHom
  obtain ⟨_, _, functionEvaluation, _⟩ := evaluation
  -- The two homomorphisms agree on constants and on variables.
  have constants : ∀ a ∈ R,
      compose(evaluationAt(R, n, c), φ, Ring.carrier(polynomialRing(R, n)),
        Ring.carrier(polynomialRing(R, n)),
        Ring.carrier(R))(polynomialConstant(R, n)(a)) =
      evaluationAt(R, n, pulledPoint(R, n, φ, c))(polynomialConstant(R, n)(a))
    intros a ha
    have constantIn : polynomialConstant(R, n)(a) ∈ polynomialRing(R, n) :=
      polynomialConstant.mem at R, n, a with *
    have fixed := AlgebraHom.polynomial_constant at R, n, n, φ, a with hom, ha
    have atC := evaluationAt.map_constant at R, n, c, a with *
    have atPulled := evaluationAt.map_constant at R, n,
      pulledPoint(R, n, φ, c), a with *
    rw compose.apply with functionPhi, functionEvaluation, constantIn
    rw [fixed, atC, atPulled]
  have variables : ∀ j ∈ n,
      compose(evaluationAt(R, n, c), φ, Ring.carrier(polynomialRing(R, n)),
        Ring.carrier(polynomialRing(R, n)), Ring.carrier(R))(X(R, n, j)) =
      evaluationAt(R, n, pulledPoint(R, n, φ, c))(X(R, n, j))
    intros j hj
    have variable : X(R, n, j) ∈ polynomialRing(R, n) := X.mem at R, n, j with *
    have atPulled := evaluationAt.map_X at R, n, pulledPoint(R, n, φ, c), j
      with *
    have coordinate := pulledPoint.value with ring, hom, values, hj
    rw compose.apply with functionPhi, functionEvaluation, variable
    rw [atPulled, coordinate]
  exact polynomialRing.hom_ext with ring, composite, pulledEvaluation,
    constants, variables

end Pulled

-- The theorem.

section NoCoordinate
variable (R : Set, n : Nat)
hypothesis ring : CommRing(R)
hypothesis nontrivial : Ring.zero(R) ≠ Ring.one(R)

theorem no_coordinate_of_critical (f point : Set)
  requires member : f ∈ Ring.carrier(polynomialRing(R, n))
  requires values : point : n → Ring.carrier(R)
  requires critical : ∀ i ∈ n,
    evaluationAt(R, n, point)(partialDerivative(R, n, i)(f)) = Ring.zero(R)
  shows ¬ (∃ e, ∃ i ∈ n,
    (e : polynomialAlgebra(R, n) ≃ₐ polynomialAlgebra(R, n)) ∧
    e(X(R, n, i)) = f)
proof
  intro witness
  obtain ⟨e, i, index, iso, image⟩ := witness
  have polynomials := polynomialRing.comm_ring at R, n with ring
  have carrier := polynomialAlgebra.carrier at R, n with ring
  have inverseIso := AlgebraIso.inverse with iso
  rw carrier at inverseIso
  set g := converse(e, Ring.carrier(polynomialRing(R, n)),
    Ring.carrier(polynomialRing(R, n))) with gDef
  rw ← gDef at inverseIso
  obtain ⟨gHom, _⟩ := inverseIso
  obtain ⟨eHom, eBijective⟩ := iso
  rw carrier at eBijective
  have eRingHom := AlgebraHom.polynomial_ring_hom at R, n, n, e with eHom
  have gRingHom := AlgebraHom.polynomial_ring_hom at R, n, n, g with gHom
  obtain ⟨_, _, functionE, _⟩ := eRingHom
  -- The inverse sends f back to the variable, so the chain rule for g at
  -- f reads 1 = Σ_k g(∂_k f) · ∂_i(g(X_k)).
  have variableIn : X(R, n, i) ∈ polynomialRing(R, n) := X.mem at R, n, i with *
  have gf : g(f) = X(R, n, i)
    rw [gDef, ← image]
    exact Bijective.inverse_apply with eBijective, variableIn
  have chain := polynomial_chain_rule at R, n, n, g, f, i
    with ring, gHom, member, index
  have self := partialDerivative.X_self at R, n, i with ring, polynomials, index
  rw [gf, self] at chain
  -- Evaluating at the pulled point b of e turns g into evaluation at the
  -- critical point: ev_b(g(q)) = ev_point(e(g(q))) = ev_point(q).
  have pulled := pulledPoint.function at R, n, e, point with ring, eHom, values
  have composite := evaluationAt.compose_hom at R, n, e, point
    with ring, eHom, values
  have evaluationB := evaluationAt.hom at R, n, pulledPoint(R, n, e, point)
    with ring, pulled
  have evaluationC := evaluationAt.hom at R, n, point with ring, values
  obtain ⟨_, _, functionC, _⟩ := evaluationC
  have transfer : ∀ q ∈ Ring.carrier(polynomialRing(R, n)),
      evaluationAt(R, n, pulledPoint(R, n, e, point))(g(q)) =
        evaluationAt(R, n, point)(q)
    intros q hq
    have gq : g(q) ∈ polynomialRing(R, n) := RingHom.map_mem with gRingHom, hq
    have back : e(g(q)) = q
      rw gDef
      exact Bijective.apply_inverse with eBijective, hq
    rw ← composite
    rw compose.apply with functionE, functionC, gq
    rw back
  -- Every chain term vanishes at b, so the sum does, and 1 = 0 in R.
  have terms := chainTerms.values at R, n, g, f, i, n
    with ring, gHom, member, index
  have zeros : ∀ k ∈ n,
      evaluationAt(R, n, pulledPoint(R, n, e, point))(
        chainTerms(R, n, g, f, i, n)(k)) = Ring.zero(R)
    intros k hk
    have value := chainTerms.value at R, n, g, f, i, n, k
      with ring, gHom, member, index, hk
    have derivativeIn : partialDerivative(R, n, k)(f) ∈ polynomialRing(R, n) :=
      partialDerivative.map_mem at R, n, k, f with *
    have mappedIn : g(partialDerivative(R, n, k)(f)) ∈ polynomialRing(R, n) :=
      RingHom.map_mem with gRingHom, derivativeIn
    have variableK : X(R, n, k) ∈ polynomialRing(R, n) :=
      X.mem at R, n, k with *
    have mappedVariable : g(X(R, n, k)) ∈ polynomialRing(R, n) :=
      RingHom.map_mem with gRingHom, variableK
    have otherIn : partialDerivative(R, n, i)(g(X(R, n, k))) ∈
        polynomialRing(R, n) :=
      partialDerivative.map_mem at R, n, i, g(X(R, n, k)) with *
    have product := RingHom.map_mul at
      evaluationAt(R, n, pulledPoint(R, n, e, point)), polynomialRing(R, n), R,
      g(partialDerivative(R, n, k)(f)),
      partialDerivative(R, n, i)(g(X(R, n, k))) with *
    have otherValue : evaluationAt(R, n, pulledPoint(R, n, e, point))(
        partialDerivative(R, n, i)(g(X(R, n, k)))) ∈ R :=
      RingHom.map_mem with evaluationB, otherIn
    have vanishing := critical with k, hk
    have moved := transfer with partialDerivative(R, n, k)(f), derivativeIn
    rw [value, product, moved, vanishing]
    ring
  have sumZero := RingHom.sum_zero at polynomialRing(R, n), R,
    evaluationAt(R, n, pulledPoint(R, n, e, point)),
    chainTerms(R, n, g, f, i, n), n
    with polynomials, ring, evaluationB, terms, zeros
  have one := RingHom.map_one with evaluationB
  rw [← chain, one] at sumZero
  symm at sumZero
  exact nontrivial with sumZero

end NoCoordinate
