module Grace.Cumulus.Probability.RandomVariable
import Independence

-- Pointwise product of two real-valued functions on the same domain.
defgraph weightMul (Ω w v : Set) (x ∈ Ω) : ℝ := call2(realMul, w(x), v(x))
requires weightsW : w : Ω → ℝ
requires weightsV : v : Ω → ℝ
proof
  have left := FunctionBetween.apply_closed with weightsW, member
  have right := FunctionBetween.apply_closed with weightsV, member
  exact realMulValue.real at w(x), v(x)

-- Pointwise difference of two real-valued functions on the same domain.
defgraph weightSub (Ω w v : Set) (x ∈ Ω) : ℝ := realSubValue(w(x), v(x))
requires weightsW : w : Ω → ℝ
requires weightsV : v : Ω → ℝ
proof
  have left := FunctionBetween.apply_closed with weightsW, member
  have right := FunctionBetween.apply_closed with weightsV, member
  exact realSubValue.real at w(x), v(x)

-- The expectation of a random variable X : Ω → ℝ is the P-weighted sum of
-- its values.
def expectation (Ω P X : Set) : Set := realSetSum(Ω, weightMul(Ω, P, X))

theorem expectation.value (Ω P X : Set)
  shows expectation(Ω, P, X) = realSetSum(Ω, weightMul(Ω, P, X))
proof
  simp [expectation]

theorem expectation.real (Ω P X : Set)
  requires space : ProbabilitySpace(Ω, P)
  requires random : X : Ω → ℝ
  shows Real(expectation(Ω, P, X))
proof
  have finite := ProbabilitySpace.finite with space
  have function := ProbabilitySpace.function with space
  have whole := Subset.reflexive at Ω
  have product := weightMul.function with function, random
  rw expectation.value
  exact realSetSum.real with finite, product, whole

theorem expectation.congr (Ω P X Y : Set)
  requires space : ProbabilitySpace(Ω, P)
  requires variableX : X : Ω → ℝ
  requires variableY : Y : Ω → ℝ
  requires values : ∀ ω ∈ Ω, X(ω) = Y(ω)
  shows expectation(Ω, P, X) = expectation(Ω, P, Y)
proof
  have function := ProbabilitySpace.function with space
  have whole := Subset.reflexive at Ω
  have productX := weightMul.function with function, variableX
  have productY := weightMul.function with function, variableY
  have agree : ∀ ω ∈ Ω, weightMul(Ω, P, X)(ω) = weightMul(Ω, P, Y)(ω)
    intros ω point
    have left := weightMul.value at Ω, P, X, ω with function, variableX, point
    have right := weightMul.value at Ω, P, Y, ω with function, variableY, point
    have equal := values with ω, point
    rw [left, right, equal]
    rfl
  rw [expectation.value, expectation.value]
  exact realSetSum.congr with productX, productY, whole, agree

-- Linearity of expectation.
theorem expectation.add (Ω P X Y : Set)
  requires space : ProbabilitySpace(Ω, P)
  requires variableX : X : Ω → ℝ
  requires variableY : Y : Ω → ℝ
  shows expectation(Ω, P, weightAdd(Ω, X, Y)) =
    (expectation(Ω, P, X):R) + (expectation(Ω, P, Y):R)
proof
  have finite := ProbabilitySpace.finite with space
  have function := ProbabilitySpace.function with space
  have whole := Subset.reflexive at Ω
  have sum := weightAdd.function with variableX, variableY
  have productX := weightMul.function with function, variableX
  have productY := weightMul.function with function, variableY
  have productSum := weightMul.function with function, sum
  have combined := weightAdd.function with productX, productY
  have agree : ∀ ω ∈ Ω, weightMul(Ω, P, weightAdd(Ω, X, Y))(ω) =
      weightAdd(Ω, weightMul(Ω, P, X), weightMul(Ω, P, Y))(ω)
    intros ω point
    have pointReal := ProbabilitySpace.point_real with space, point
    have xReal := FunctionBetween.apply_closed with variableX, point
    have yReal := FunctionBetween.apply_closed with variableY, point
    have left := weightMul.value at Ω, P, weightAdd(Ω, X, Y), ω with function,
        sum, point
    have inner := weightAdd.value at Ω, X, Y, ω with variableX, variableY, point
    have right := weightAdd.value at Ω, weightMul(Ω, P, X), weightMul(Ω, P, Y),
        ω with
      productX, productY, point
    have mulX := weightMul.value at Ω, P, X, ω with function, variableX, point
    have mulY := weightMul.value at Ω, P, Y, ω with function, variableY, point
    rw [left, inner, right, mulX, mulY]
    ring
  have same := realSetSum.congr with productSum, combined, whole, agree
  have split := realSetSum.add with finite, productX, productY, whole
  rw [expectation.value, expectation.value, expectation.value, same, split]
  rfl

theorem expectation.scale (Ω P X : Set) (c : Real)
  requires space : ProbabilitySpace(Ω, P)
  requires random : X : Ω → ℝ
  shows expectation(Ω, P, weightScale(Ω, c, X)) = c * (expectation(Ω, P, X):R)
proof
  have finite := ProbabilitySpace.finite with space
  have function := ProbabilitySpace.function with space
  have whole := Subset.reflexive at Ω
  have scaled := weightScale.function at Ω, c, X with random
  have product := weightMul.function with function, random
  have productScaled := weightMul.function with function, scaled
  have combined := weightScale.function at Ω, c, weightMul(Ω, P, X) with product
  have agree : ∀ ω ∈ Ω, weightMul(Ω, P, weightScale(Ω, c, X))(ω) =
      weightScale(Ω, c, weightMul(Ω, P, X))(ω)
    intros ω point
    have pointReal := ProbabilitySpace.point_real with space, point
    have xReal := FunctionBetween.apply_closed with random, point
    have left := weightMul.value at Ω, P, weightScale(Ω, c, X), ω with
        function, scaled, point
    have inner := weightScale.value at Ω, c, X, ω with random, point
    have right := weightScale.value at Ω, c, weightMul(Ω, P, X), ω with
        product, point
    have mul := weightMul.value at Ω, P, X, ω with function, random, point
    rw [left, inner, right, mul]
    ring
  have same := realSetSum.congr with productScaled, combined, whole, agree
  have pulled := realSetSum.scale at Ω, Ω, weightMul(Ω, P, X), c with finite,
      product, whole
  rw [expectation.value, expectation.value, same, pulled]
  rfl

theorem expectation.constant (Ω P : Set) (c : Real)
  requires space : ProbabilitySpace(Ω, P)
  shows expectation(Ω, P, constantFunction(Ω, ℝ, c)) = c
proof
  have finite := ProbabilitySpace.finite with space
  have function := ProbabilitySpace.function with space
  have total := ProbabilitySpace.total with space
  have whole := Subset.reflexive at Ω
  have scalar : c ∈ ℝ by simp [Real]
  have constant := constantFunction.function at Ω, ℝ, c with scalar
  have product := weightMul.function with function, constant
  have scaled := weightScale.function at Ω, c, P with function
  have agree : ∀ ω ∈ Ω, weightMul(Ω, P, constantFunction(Ω, ℝ, c))(ω) =
      weightScale(Ω, c, P)(ω)
    intros ω point
    have pointReal := ProbabilitySpace.point_real with space, point
    have left := weightMul.value at Ω, P, constantFunction(Ω, ℝ, c), ω with
      function, constant, point
    have value := constantFunction.apply at Ω, ℝ, ω, c with point, scalar
    have right := weightScale.value at Ω, c, P, ω with function, point
    rw [left, value, right]
    ring
  have same := realSetSum.congr with product, scaled, whole, agree
  have pulled := realSetSum.scale at Ω, Ω, P, c with finite, function, whole
  rw [expectation.value, same, pulled, total]
  ring

-- The expectation of an indicator is the probability of its event.
theorem expectation.indicator (Ω P A : Set)
  requires space : ProbabilitySpace(Ω, P)
  requires event : A ⊆ Ω
  shows expectation(Ω, P, realIndicator(Ω, A)) = prob(P, A)
proof
  have finite := ProbabilitySpace.finite with space
  have function := ProbabilitySpace.function with space
  have whole := Subset.reflexive at Ω
  have indicator := realIndicator.function at Ω, A
  have product := weightMul.function with function, indicator
  have masked := maskedWeight.function at Ω, A, P with function
  have agree : ∀ ω ∈ Ω, weightMul(Ω, P, realIndicator(Ω,
      A))(ω) = maskedWeight(Ω, A, P)(ω)
    intros ω point
    have pointReal := ProbabilitySpace.point_real with space, point
    have natural := indicator.natural at A, ω
    have maskReal := realNat.real at indicator(A, ω)
    have left := weightMul.value at Ω, P, realIndicator(Ω, A), ω with function,
        indicator, point
    have inner := realIndicator.value at Ω, A, ω with point
    have right := maskedWeight.value at Ω, A, P, ω with function, point
    rw [left, inner, right]
    ring
  have same := realSetSum.congr with product, masked, whole, agree
  have counted := realSetSum.masked_intersection at Ω, A, Ω, P with finite,
      function, whole
  have meet := intersection.eq_right_of_subset at Ω, A with event
  rw [expectation.value, prob.value, same, counted, meet]
  rfl

theorem expectation.monotone (Ω P X Y : Set)
  requires space : ProbabilitySpace(Ω, P)
  requires variableX : X : Ω → ℝ
  requires variableY : Y : Ω → ℝ
  requires bounds : ∀ ω ∈ Ω, (X(ω):R) ≤ (Y(ω):R)
  shows (expectation(Ω, P, X):R) ≤ (expectation(Ω, P, Y):R)
proof
  have finite := ProbabilitySpace.finite with space
  have function := ProbabilitySpace.function with space
  have whole := Subset.reflexive at Ω
  have productX := weightMul.function with function, variableX
  have productY := weightMul.function with function, variableY
  have pointwise : ∀ ω ∈ Ω, (weightMul(Ω, P, X)(ω):R) ≤ (weightMul(Ω, P,
      Y)(ω):R)
    intros ω point
    have pointReal := ProbabilitySpace.point_real with space, point
    have pointNonnegative := ProbabilitySpace.point_nonnegative with space,
        point
    have xReal := FunctionBetween.apply_closed with variableX, point
    have yReal := FunctionBetween.apply_closed with variableY, point
    have left := weightMul.value at Ω, P, X, ω with function, variableX, point
    have right := weightMul.value at Ω, P, Y, ω with function, variableY, point
    have bound := bounds with ω, point
    have scaled := realLe.mul_left_of_nonnegative at X(ω), Y(ω), P(ω) with
      bound, pointNonnegative
    rw [left, right]
    exact scaled
  rw [expectation.value, expectation.value]
  exact realSetSum.monotone with finite, productX, productY, whole, pointwise

theorem expectation.nonnegative (Ω P X : Set)
  requires space : ProbabilitySpace(Ω, P)
  requires random : X : Ω → ℝ
  requires nonnegative : ∀ ω ∈ Ω, (0:R) ≤ (X(ω):R)
  shows (0:R) ≤ (expectation(Ω, P, X):R)
proof
  have finite := ProbabilitySpace.finite with space
  have function := ProbabilitySpace.function with space
  have whole := Subset.reflexive at Ω
  have product := weightMul.function with function, random
  have pointwise : ∀ ω ∈ Ω, (0:R) ≤ (weightMul(Ω, P, X)(ω):R)
    intros ω point
    have pointReal := ProbabilitySpace.point_real with space, point
    have pointNonnegative := ProbabilitySpace.point_nonnegative with space,
        point
    have xReal := FunctionBetween.apply_closed with random, point
    have value := weightMul.value at Ω, P, X, ω with function, random, point
    have bound := nonnegative with ω, point
    have scaled := realMulValue.nonnegative at P(ω), X(ω) with
        pointNonnegative, bound
    rw value
    exact scaled
  rw expectation.value
  exact realSetSum.nonnegative with finite, product, whole, pointwise

theorem expectation.le_of_bounded (Ω P X : Set) (c : Real)
  requires space : ProbabilitySpace(Ω, P)
  requires random : X : Ω → ℝ
  requires bounded : ∀ ω ∈ Ω, (X(ω):R) ≤ c
  shows (expectation(Ω, P, X):R) ≤ c
proof
  have scalar : c ∈ ℝ by simp [Real]
  have constant := constantFunction.function at Ω, ℝ, c with scalar
  have bounds : ∀ ω ∈ Ω, (X(ω):R) ≤ (constantFunction(Ω, ℝ, c)(ω):R)
    intros ω point
    have value := constantFunction.apply at Ω, ℝ, ω, c with point, scalar
    rw value
    exact bounded with ω, point
  have monotone := expectation.monotone with space, random, constant, bounds
  have expected := expectation.constant at Ω, P, c with space
  rwa expected at monotone

theorem expectation.ge_of_bounded (Ω P X : Set) (c : Real)
  requires space : ProbabilitySpace(Ω, P)
  requires random : X : Ω → ℝ
  requires bounded : ∀ ω ∈ Ω, c ≤ (X(ω):R)
  shows c ≤ (expectation(Ω, P, X):R)
proof
  have scalar : c ∈ ℝ by simp [Real]
  have constant := constantFunction.function at Ω, ℝ, c with scalar
  have bounds : ∀ ω ∈ Ω, (constantFunction(Ω, ℝ, c)(ω):R) ≤ (X(ω):R)
    intros ω point
    have value := constantFunction.apply at Ω, ℝ, ω, c with point, scalar
    rw value
    exact bounded with ω, point
  have monotone := expectation.monotone with space, constant, random, bounds
  have expected := expectation.constant at Ω, P, c with space
  rwa expected at monotone

theorem expectation.sub (Ω P X Y : Set)
  requires space : ProbabilitySpace(Ω, P)
  requires variableX : X : Ω → ℝ
  requires variableY : Y : Ω → ℝ
  shows expectation(Ω, P, weightSub(Ω, X, Y)) =
    (expectation(Ω, P, X):R) - (expectation(Ω, P, Y):R)
proof
  have difference := weightSub.function with variableX, variableY
  have restored := weightAdd.function with difference, variableY
  have agree : ∀ ω ∈ Ω, weightAdd(Ω, weightSub(Ω, X, Y), Y)(ω) = X(ω)
    intros ω point
    have xReal := FunctionBetween.apply_closed with variableX, point
    have yReal := FunctionBetween.apply_closed with variableY, point
    have outer := weightAdd.value at Ω, weightSub(Ω, X, Y), Y, ω with
        difference, variableY, point
    have inner := weightSub.value at Ω, X, Y, ω with variableX, variableY, point
    rw [outer, inner]
    ring
  have same := expectation.congr with space, restored, variableX, agree
  have split := expectation.add with space, difference, variableY
  have realX := expectation.real with space, variableX
  have realY := expectation.real with space, variableY
  have realDifference := expectation.real with space, difference
  linarith

-- The pointwise absolute value of a random random.
defgraph absVariable (Ω X : Set) (x ∈ Ω) : ℝ := abs(X(x))
requires random : X : Ω → ℝ
proof
  have value := FunctionBetween.apply_closed with random, member
  exact abs.real at X(x)

theorem expectation.abs_le (Ω P X : Set)
  requires space : ProbabilitySpace(Ω, P)
  requires random : X : Ω → ℝ
  shows (abs(expectation(Ω, P, X)):R) ≤ (expectation(Ω, P, absVariable(Ω, X)):R)
proof
  have absolute := absVariable.function with random
  have zeroReal := realZero.real
  have zeros := constantFunction.function at Ω, ℝ, (0:R) with zeroReal
  have negated := weightSub.function with zeros, random
  have realX := expectation.real with space, random
  have realAbs := expectation.real with space, absolute
  have upperBounds : ∀ ω ∈ Ω, (X(ω):R) ≤ (absVariable(Ω, X)(ω):R)
    intros ω point
    have xReal := FunctionBetween.apply_closed with random, point
    have value := absVariable.value at Ω, X, ω with random, point
    rw value
    exact abs.upper at X(ω)
  have lowerBounds : ∀ ω ∈ Ω,
      (weightSub(Ω, constantFunction(Ω, ℝ, (0:R)), X)(ω):R) ≤ (absVariable(Ω,
        X)(ω):R)
    intros ω point
    have xReal := FunctionBetween.apply_closed with random, point
    have absReal := abs.real at X(ω)
    have value := absVariable.value at Ω, X, ω with random, point
    have difference := weightSub.value at Ω, constantFunction(Ω, ℝ, (0:R)), X,
        ω with
      zeros, random, point
    have zero := constantFunction.apply at Ω, ℝ, ω, (0:R) with point, zeroReal
    have negative := abs.upper_neg at X(ω)
    rw [value, difference, zero]
    linarith
  have upper := expectation.monotone with space, random, absolute, upperBounds
  have lower := expectation.monotone with space, negated, absolute, lowerBounds
  have split := expectation.sub with space, zeros, random
  have zeroExpected := expectation.constant at Ω, P, (0:R) with space
  rw [split, zeroExpected] at lower
  have alternatives : (0:R) ≤ (expectation(Ω, P, X):R) ∨
      ¬((0:R) ≤ (expectation(Ω, P, X):R)) by tauto
  cases alternatives with nonnegative | negative
  . have same := abs.of_nonnegative at expectation(Ω, P, X) with nonnegative
    rw same
    exact upper
  . have below := realLess.of_not_le at realZero, expectation(Ω, P, X) with
    negative
    have nonpositive := realLess.implies_le with below
    have same := abs.of_nonpositive at expectation(Ω, P, X) with nonpositive
    rw same
    linarith

-- The event that X is at least a.
def levelSet (Ω X : Set) (a : Real) : Set := { ω ∈ Ω | a ≤ (X(ω):R) }

theorem levelSet.subset (Ω X : Set) (a : Real)
  shows levelSet(Ω, X, a) ⊆ Ω
proof
  intros ω member
  have data := levelSet.membership.forward with member
  exact data.left

-- Markov's inequality.
theorem expectation.markov (Ω P X : Set) (a : Real)
  requires space : ProbabilitySpace(Ω, P)
  requires random : X : Ω → ℝ
  requires nonnegative : ∀ ω ∈ Ω, (0:R) ≤ (X(ω):R)
  requires positive : (0:R) < a
  shows (prob(P, levelSet(Ω, X, a)):R) ≤ (expectation(Ω, P, X):R) / a
proof
  have event := levelSet.subset at Ω, X, a
  have indicator := realIndicator.function at Ω, levelSet(Ω, X, a)
  have scaled := weightScale.function at Ω, a, realIndicator(Ω, levelSet(Ω, X,
      a)) with
    indicator
  have pointwise : ∀ ω ∈ Ω,
      (weightScale(Ω, a, realIndicator(Ω, levelSet(Ω, X, a)))(ω):R) ≤ (X(ω):R)
    intros ω point
    have xReal := FunctionBetween.apply_closed with random, point
    have value := weightScale.value at Ω, a, realIndicator(Ω, levelSet(Ω, X,
        a)), ω with
      indicator, point
    have alternatives : ω ∈ levelSet(Ω, X, a) ∨ ¬(ω ∈ levelSet(Ω, X,
        a)) by tauto
    cases alternatives with inside | outside
    . have one := realIndicator.inside at Ω, levelSet(Ω, X, a), ω with point,
      inside
      have data := levelSet.membership.forward with inside
      have oneMul := realMulValue.one_right at a
      rw [value, one, oneMul]
      exact data.right
    . have zero := realIndicator.outside at Ω, levelSet(Ω, X, a), ω with point,
      outside
      have zeroMul := realMulValue.zero_right at a
      rw [value, zero, zeroMul]
      exact nonnegative with ω, point
  have monotone := expectation.monotone with space, scaled, random, pointwise
  have scale := expectation.scale at Ω, P, realIndicator(Ω, levelSet(Ω, X, a)),
      a with
    space, indicator
  have indicatorValue := expectation.indicator with space, event
  rw [scale, indicatorValue] at monotone
  have realLevel := prob.real with space, event
  have realExpected := expectation.real with space, random
  have inverseReal := realInvValue.real at a
  have inversePositive := realInvValue.positive at a with positive
  have inverseNonnegative : (0:R) ≤ (realInvValue(a):R) by linarith
  have nonzero : a ≠ (0:R)
    intro zero
    rw zero at positive
    exact realLess.not_self with positive
  have inverseLaw := realInvValue.mul_right at a with nonzero
  have scaledBound := realLe.mul_right_of_nonnegative at
    a * (prob(P, levelSet(Ω, X, a)):R), expectation(Ω, P, X),
      realInvValue(a) with
    monotone, inverseNonnegative
  have division := realDiv.eq_mul_inv at expectation(Ω, P, X), a
  have simplify : (a * (prob(P, levelSet(Ω, X, a)):R)) * (realInvValue(a):R) =
      prob(P, levelSet(Ω, X, a))
    calc
      (a * (prob(P, levelSet(Ω, X, a)):R)) * (realInvValue(a):R) =
          (prob(P, levelSet(Ω, X, a)):R) * (a * (realInvValue(a):R)) := by ring
      _ = (prob(P, levelSet(Ω, X, a)):R) * (1:R) := by cc
      _ = prob(P, levelSet(Ω, X, a)) := realMulValue.one_right at prob(P,
        levelSet(Ω, X, a))
  rw simplify at scaledBound
  rw division
  exact scaledBound

theorem expectation.indicator_complement (Ω P A : Set)
  requires space : ProbabilitySpace(Ω, P)
  requires event : A ⊆ Ω
  shows expectation(Ω, P, realIndicator(Ω, Ω ∖ A)) = (1:R) - (prob(P, A):R)
proof
  have eventRest : Ω ∖ A ⊆ Ω by simp
  have indicator := expectation.indicator with space, eventRest
  have complement := prob.complement with space, event
  rw [indicator, complement]
  rfl
