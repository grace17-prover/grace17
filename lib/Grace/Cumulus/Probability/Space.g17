module Grace.Cumulus.Probability.Space
import SetSum
import Real.AbsoluteValue

-- A finite probability space: a finite sample space Ω with nonnegative
-- weights P(ω) that sum to one.
predicate ProbabilitySpace (Ω P : Set) :=
  Finite(Ω) ∧ FunctionBetween(P, Ω, ℝ) ∧
    (∀ ω ∈ Ω, (0:R) ≤ (P(ω):R)) ∧ realSetSum(Ω, P) = (1:R)

-- The probability of an event A ⊆ Ω is the total weight of its points.
def prob (P A : Set) : Set := realSetSum(A, P)

theorem prob.value (P A : Set)
  shows prob(P, A) = realSetSum(A, P)
proof
  simp [prob]

theorem ProbabilitySpace.intro (Ω P : Set)
  requires finite : Finite(Ω)
  requires function : P : Ω → ℝ
  requires nonnegative : ∀ ω ∈ Ω, (0:R) ≤ (P(ω):R)
  requires total : realSetSum(Ω, P) = (1:R)
  shows ProbabilitySpace(Ω, P)
proof
  unfold ProbabilitySpace
  refine ⟨finite, function, nonnegative, total⟩

theorem ProbabilitySpace.finite (Ω P : Set)
  requires space : ProbabilitySpace(Ω, P)
  shows Finite(Ω)
proof
  unfold ProbabilitySpace at space
  exact space.left

theorem ProbabilitySpace.function (Ω P : Set)
  requires space : ProbabilitySpace(Ω, P)
  shows P : Ω → ℝ
proof
  unfold ProbabilitySpace at space
  exact space.right.left

theorem ProbabilitySpace.nonnegative (Ω P : Set)
  requires space : ProbabilitySpace(Ω, P)
  shows ∀ ω ∈ Ω, (0:R) ≤ (P(ω):R)
proof
  unfold ProbabilitySpace at space
  exact space.right.right.left

theorem ProbabilitySpace.total (Ω P : Set)
  requires space : ProbabilitySpace(Ω, P)
  shows realSetSum(Ω, P) = (1:R)
proof
  unfold ProbabilitySpace at space
  exact space.right.right.right

theorem ProbabilitySpace.event_finite (Ω P A : Set)
  requires space : ProbabilitySpace(Ω, P)
  requires event : A ⊆ Ω
  shows Finite(A)
proof
  have finite := ProbabilitySpace.finite with space
  exact Finite.subset with finite, event

theorem ProbabilitySpace.point_real (Ω P ω : Set)
  requires space : ProbabilitySpace(Ω, P)
  requires point : ω ∈ Ω
  shows Real(P(ω))
proof
  have function := ProbabilitySpace.function with space
  exact FunctionBetween.apply_closed with function, point

theorem ProbabilitySpace.point_nonnegative (Ω P ω : Set)
  requires space : ProbabilitySpace(Ω, P)
  requires point : ω ∈ Ω
  shows (0:R) ≤ (P(ω):R)
proof
  have nonnegative := ProbabilitySpace.nonnegative with space
  exact nonnegative with ω, point

theorem prob.real (Ω P A : Set)
  requires space : ProbabilitySpace(Ω, P)
  requires event : A ⊆ Ω
  shows Real(prob(P, A))
proof
  have function := ProbabilitySpace.function with space
  have finite := ProbabilitySpace.event_finite with space, event
  have sum := realSetSum.real with finite, function, event
  rw prob.value
  exact sum

theorem prob.empty (P : Set)
  shows prob(P, ∅) = (0:R)
proof
  rw prob.value
  exact realSetSum.empty at P

theorem prob.whole (Ω P : Set)
  requires space : ProbabilitySpace(Ω, P)
  shows prob(P, Ω) = (1:R)
proof
  rw prob.value
  exact ProbabilitySpace.total with space

theorem prob.nonnegative (Ω P A : Set)
  requires space : ProbabilitySpace(Ω, P)
  requires event : A ⊆ Ω
  shows (0:R) ≤ (prob(P, A):R)
proof
  have function := ProbabilitySpace.function with space
  have nonnegative := ProbabilitySpace.nonnegative with space
  have finite := ProbabilitySpace.event_finite with space, event
  have bounds : ∀ x ∈ A, (0:R) ≤ (P(x):R)
    intros x hx
    have member := event with x, hx
    exact nonnegative with x, member
  have sum := realSetSum.nonnegative with finite, function, event, bounds
  rw prob.value
  exact sum

theorem prob.monotone (Ω P A B : Set)
  requires space : ProbabilitySpace(Ω, P)
  requires eventB : B ⊆ Ω
  requires inner : A ⊆ B
  shows (prob(P, A):R) ≤ (prob(P, B):R)
proof
  have function := ProbabilitySpace.function with space
  have nonnegative := ProbabilitySpace.nonnegative with space
  have finite := ProbabilitySpace.event_finite with space, eventB
  have bounds : ∀ x ∈ B, (0:R) ≤ (P(x):R)
    intros x hx
    have member := eventB with x, hx
    exact nonnegative with x, member
  have sum := realSetSum.subset_le with finite, function, eventB, inner, bounds
  rw [prob.value, prob.value]
  exact sum

theorem prob.le_one (Ω P A : Set)
  requires space : ProbabilitySpace(Ω, P)
  requires event : A ⊆ Ω
  shows (prob(P, A):R) ≤ (1:R)
proof
  have whole := Subset.reflexive at Ω
  have bound := prob.monotone with space, whole, event
  have total := prob.whole with space
  rwa total at bound

theorem prob.union_disjoint (Ω P A B : Set)
  requires space : ProbabilitySpace(Ω, P)
  requires eventA : A ⊆ Ω
  requires eventB : B ⊆ Ω
  requires disjoint : Disjoint(A, B)
  shows prob(P, A ∪ B) = (prob(P, A):R) + (prob(P, B):R)
proof
  have function := ProbabilitySpace.function with space
  have finiteA := ProbabilitySpace.event_finite with space, eventA
  have finiteB := ProbabilitySpace.event_finite with space, eventB
  have sum := realSetSum.union_disjoint with finiteA, finiteB, function,
    eventA, eventB, disjoint
  rw [prob.value, prob.value, prob.value]
  exact sum

theorem prob.difference_subset (Ω P A B : Set)
  requires space : ProbabilitySpace(Ω, P)
  requires eventA : A ⊆ Ω
  requires inner : B ⊆ A
  shows prob(P, A ∖ B) = (prob(P, A):R) - (prob(P, B):R)
proof
  have function := ProbabilitySpace.function with space
  have finiteA := ProbabilitySpace.event_finite with space, eventA
  have split := realSetSum.difference with finiteA, function, eventA, inner
  have rest := difference.subset_left at A, B
  have eventRest := Subset.transitive with rest, eventA
  have eventB := Subset.transitive with inner, eventA
  have finiteB := Finite.subset with finiteA, inner
  have finiteRest := Finite.subset with finiteA, rest
  have realA := realSetSum.real with finiteA, function, eventA
  have realB := realSetSum.real with finiteB, function, eventB
  have realRest := realSetSum.real with finiteRest, function, eventRest
  rw [prob.value, prob.value, prob.value]
  linarith

theorem prob.complement (Ω P A : Set)
  requires space : ProbabilitySpace(Ω, P)
  requires event : A ⊆ Ω
  shows prob(P, Ω ∖ A) = (1:R) - (prob(P, A):R)
proof
  have whole := Subset.reflexive at Ω
  have difference := prob.difference_subset with space, whole, event
  have total := prob.whole with space
  rwa total at difference

theorem prob.singleton (Ω P ω : Set)
  requires space : ProbabilitySpace(Ω, P)
  requires point : ω ∈ Ω
  shows prob(P, {ω}) = P(ω)
proof
  have function := ProbabilitySpace.function with space
  rw prob.value
  exact realSetSum.singleton with function, point

theorem prob.zero_of_pointwise (Ω P A : Set)
  requires space : ProbabilitySpace(Ω, P)
  requires event : A ⊆ Ω
  requires vanishes : ∀ ω ∈ A, P(ω) = (0:R)
  shows prob(P, A) = (0:R)
proof
  have function := ProbabilitySpace.function with space
  have finite := ProbabilitySpace.event_finite with space, event
  rw prob.value
  exact realSetSum.zero with finite, function, event, vanishes

theorem prob.insert (Ω P A ω : Set)
  requires space : ProbabilitySpace(Ω, P)
  requires event : A ⊆ Ω
  requires point : ω ∈ Ω
  requires fresh : ¬(ω ∈ A)
  shows prob(P, insert(ω, A)) = (prob(P, A):R) + (P(ω):R)
proof
  have function := ProbabilitySpace.function with space
  have finite := ProbabilitySpace.event_finite with space, event
  rw [prob.value, prob.value]
  exact realSetSum.insert with finite, function, event, point, fresh

theorem prob.remove (Ω P A ω : Set)
  requires space : ProbabilitySpace(Ω, P)
  requires event : A ⊆ Ω
  requires point : ω ∈ A
  shows prob(P, A) = (prob(P, A ∖ {ω}):R) + (P(ω):R)
proof
  have function := ProbabilitySpace.function with space
  have finite := ProbabilitySpace.event_finite with space, event
  rw [prob.value, prob.value]
  exact realSetSum.insert_member with finite, function, event, point

theorem prob.inclusion_exclusion (Ω P A B : Set)
  requires space : ProbabilitySpace(Ω, P)
  requires eventA : A ⊆ Ω
  requires eventB : B ⊆ Ω
  shows (prob(P, A ∪ B):R) + (prob(P, A ∩ B):R) = (prob(P, A):R) + (prob(P,
      B):R)
proof
  have restSubset := difference.subset_left at B, A
  have meetSubset := intersection.subset_right at A, B
  have meetLeft := intersection.subset_left at A, B
  have eventRest := Subset.transitive with restSubset, eventB
  have eventMeet := Subset.transitive with meetSubset, eventB
  have disjointRest := Disjoint.difference_right at B, A
  have disjointMeet := Disjoint.of_subset_left with disjointRest, meetLeft
  have unionSplit : A ∪ (B ∖ A) = A ∪ B
    ext y
    simp
  have meetSplit : (A ∩ B) ∪ (B ∖ A) = B
    ext y
    simp
  have first := prob.union_disjoint with space, eventA, eventRest, disjointRest
  have second := prob.union_disjoint with space, eventMeet, eventRest,
      disjointMeet
  rw unionSplit at first
  rw meetSplit at second
  have realA := prob.real with space, eventA
  have realB := prob.real with space, eventB
  have realMeet := prob.real with space, eventMeet
  have realRest := prob.real with space, eventRest
  have realUnion : Real(prob(P, A ∪ B))
    have eventUnion : A ∪ B ⊆ Ω by simp
    exact prob.real with space, eventUnion
  linarith

theorem prob.union (Ω P A B : Set)
  requires space : ProbabilitySpace(Ω, P)
  requires eventA : A ⊆ Ω
  requires eventB : B ⊆ Ω
  shows prob(P, A ∪ B) = ((prob(P, A):R) + (prob(P, B):R)) - (prob(P, A ∩ B):R)
proof
  have identity := prob.inclusion_exclusion with space, eventA, eventB
  have eventUnion : A ∪ B ⊆ Ω by simp
  have eventMeet : A ∩ B ⊆ Ω by simp
  have realA := prob.real with space, eventA
  have realB := prob.real with space, eventB
  have realMeet := prob.real with space, eventMeet
  have realUnion := prob.real with space, eventUnion
  linarith

theorem prob.union_le (Ω P A B : Set)
  requires space : ProbabilitySpace(Ω, P)
  requires eventA : A ⊆ Ω
  requires eventB : B ⊆ Ω
  shows (prob(P, A ∪ B):R) ≤ (prob(P, A):R) + (prob(P, B):R)
proof
  have identity := prob.inclusion_exclusion with space, eventA, eventB
  have eventUnion : A ∪ B ⊆ Ω by simp
  have eventMeet : A ∩ B ⊆ Ω by simp
  have realA := prob.real with space, eventA
  have realB := prob.real with space, eventB
  have realMeet := prob.real with space, eventMeet
  have realUnion := prob.real with space, eventUnion
  have nonnegative := prob.nonnegative with space, eventMeet
  linarith

theorem prob.union_three_le (Ω P A B C : Set)
  requires space : ProbabilitySpace(Ω, P)
  requires eventA : A ⊆ Ω
  requires eventB : B ⊆ Ω
  requires eventC : C ⊆ Ω
  shows (prob(P, A ∪ B ∪ C):R) ≤
    ((prob(P, A):R) + (prob(P, B):R)) + (prob(P, C):R)
proof
  have eventUnion : A ∪ B ⊆ Ω by simp
  have first := prob.union_le with space, eventUnion, eventC
  have second := prob.union_le with space, eventA, eventB
  have eventAll : A ∪ B ∪ C ⊆ Ω by simp
  have realA := prob.real with space, eventA
  have realB := prob.real with space, eventB
  have realC := prob.real with space, eventC
  have realUnion := prob.real with space, eventUnion
  have realAll := prob.real with space, eventAll
  linarith

theorem prob.intersection_le_left (Ω P A B : Set)
  requires space : ProbabilitySpace(Ω, P)
  requires eventA : A ⊆ Ω
  shows (prob(P, A ∩ B):R) ≤ (prob(P, A):R)
proof
  have inner := intersection.subset_left at A, B
  exact prob.monotone with space, eventA, inner

theorem prob.intersection_le_right (Ω P A B : Set)
  requires space : ProbabilitySpace(Ω, P)
  requires eventB : B ⊆ Ω
  shows (prob(P, A ∩ B):R) ≤ (prob(P, B):R)
proof
  have inner := intersection.subset_right at A, B
  exact prob.monotone with space, eventB, inner

theorem prob.difference (Ω P A B : Set)
  requires space : ProbabilitySpace(Ω, P)
  requires eventA : A ⊆ Ω
  shows prob(P, A ∖ B) = (prob(P, A):R) - (prob(P, A ∩ B):R)
proof
  have inner := intersection.subset_left at A, B
  have split := prob.difference_subset with space, eventA, inner
  have same := difference.of_intersection at A, B
  rwa same at split

theorem prob.difference_le (Ω P A B : Set)
  requires space : ProbabilitySpace(Ω, P)
  requires eventA : A ⊆ Ω
  shows (prob(P, A ∖ B):R) ≤ (prob(P, A):R)
proof
  have inner := difference.subset_left at A, B
  exact prob.monotone with space, eventA, inner

theorem prob.point_le (Ω P A ω : Set)
  requires space : ProbabilitySpace(Ω, P)
  requires event : A ⊆ Ω
  requires point : ω ∈ A
  shows (P(ω):R) ≤ (prob(P, A):R)
proof
  have member := event with ω, point
  have inner : {ω} ⊆ A by simp
  have bound := prob.monotone with space, event, inner
  have singleton := prob.singleton with space, member
  rwa singleton at bound

theorem ProbabilitySpace.point_le_one (Ω P ω : Set)
  requires space : ProbabilitySpace(Ω, P)
  requires point : ω ∈ Ω
  shows (P(ω):R) ≤ (1:R)
proof
  have whole := Subset.reflexive at Ω
  have bound := prob.point_le with space, whole, point
  have total := prob.whole with space
  rwa total at bound

theorem prob.disjoint_le_one (Ω P A B : Set)
  requires space : ProbabilitySpace(Ω, P)
  requires eventA : A ⊆ Ω
  requires eventB : B ⊆ Ω
  requires disjoint : Disjoint(A, B)
  shows (prob(P, A):R) + (prob(P, B):R) ≤ (1:R)
proof
  have union := prob.union_disjoint with space, eventA, eventB, disjoint
  have eventUnion : A ∪ B ⊆ Ω by simp
  have bound := prob.le_one with space, eventUnion
  rwa union at bound

theorem prob.complement_zero_iff (Ω P A : Set)
  requires space : ProbabilitySpace(Ω, P)
  requires event : A ⊆ Ω
  shows prob(P, Ω ∖ A) = (0:R) ↔ prob(P, A) = (1:R)
proof
  have complement := prob.complement with space, event
  have realA := prob.real with space, event
  have eventRest := difference.subset_left at Ω, A
  have realRest := prob.real with space, eventRest
  constructor
  . intro zero
    linarith
  . intro one
    linarith

theorem prob.union_disjoint_three (Ω P A B C : Set)
  requires space : ProbabilitySpace(Ω, P)
  requires eventA : A ⊆ Ω
  requires eventB : B ⊆ Ω
  requires eventC : C ⊆ Ω
  requires disjointAB : Disjoint(A, B)
  requires disjointAC : Disjoint(A, C)
  requires disjointBC : Disjoint(B, C)
  shows prob(P, A ∪ B ∪ C) =
    ((prob(P, A):R) + (prob(P, B):R)) + (prob(P, C):R)
proof
  have eventUnion : A ∪ B ⊆ Ω by simp
  have disjointUnion := Disjoint.union2_iff.backward at A, B, C with
    ⟨disjointAC, disjointBC⟩
  have first := prob.union_disjoint with space, eventUnion, eventC,
      disjointUnion
  have second := prob.union_disjoint with space, eventA, eventB, disjointAB
  rw [first, second]
  rfl

theorem prob.subset_zero (Ω P A B : Set)
  requires space : ProbabilitySpace(Ω, P)
  requires eventA : A ⊆ Ω
  requires inner : B ⊆ A
  requires zero : prob(P, A) = (0:R)
  shows prob(P, B) = (0:R)
proof
  have eventB := Subset.transitive with inner, eventA
  have realA := prob.real with space, eventA
  have realB := prob.real with space, eventB
  have upper := prob.monotone with space, eventA, inner
  have lower := prob.nonnegative with space, eventB
  linarith

theorem prob.superset_one (Ω P A B : Set)
  requires space : ProbabilitySpace(Ω, P)
  requires eventB : B ⊆ Ω
  requires inner : A ⊆ B
  requires one : prob(P, A) = (1:R)
  shows prob(P, B) = (1:R)
proof
  have eventA := Subset.transitive with inner, eventB
  have realA := prob.real with space, eventA
  have realB := prob.real with space, eventB
  have lower := prob.monotone with space, eventB, inner
  have upper := prob.le_one with space, eventB
  linarith
