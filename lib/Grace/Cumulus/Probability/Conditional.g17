module Grace.Cumulus.Probability.Conditional
import Space

-- The probability of A given B.
def condProb (P A B : Set) : Set := call2(realDiv, prob(P, A ∩ B), prob(P, B))

theorem condProb.value (P A B : Set)
  shows condProb(P, A, B) = (prob(P, A ∩ B):R) / (prob(P, B):R)
proof
  simp [condProb]

theorem prob.ne_zero_of_positive (Ω P B : Set)
  requires space : ProbabilitySpace(Ω, P)
  requires event : B ⊆ Ω
  requires positive : (0:R) < (prob(P, B):R)
  shows prob(P, B) ≠ (0:R)
proof
  have realB := prob.real with space, event
  intro zero
  rw zero at positive
  exact realLess.not_self with positive

theorem prob.positive_of_ne_zero (Ω P B : Set)
  requires space : ProbabilitySpace(Ω, P)
  requires event : B ⊆ Ω
  requires nonzero : prob(P, B) ≠ (0:R)
  shows (0:R) < (prob(P, B):R)
proof
  have realB := prob.real with space, event
  have nonnegative := prob.nonnegative with space, event
  exact Real.positive_of_nonnegative_of_ne_zero with nonnegative, nonzero

theorem condProb.real (Ω P A B : Set)
  requires space : ProbabilitySpace(Ω, P)
  requires eventA : A ⊆ Ω
  requires eventB : B ⊆ Ω
  shows Real(condProb(P, A, B))
proof
  have eventMeet : A ∩ B ⊆ Ω by simp
  have realMeet := prob.real with space, eventMeet
  have realB := prob.real with space, eventB
  rw condProb.value
  exact realDiv.real at prob(P, A ∩ B), prob(P, B)

theorem condProb.nonnegative (Ω P A B : Set)
  requires space : ProbabilitySpace(Ω, P)
  requires eventA : A ⊆ Ω
  requires eventB : B ⊆ Ω
  requires positive : (0:R) < (prob(P, B):R)
  shows (0:R) ≤ (condProb(P, A, B):R)
proof
  have eventMeet : A ∩ B ⊆ Ω by simp
  have realMeet := prob.real with space, eventMeet
  have realB := prob.real with space, eventB
  have nonnegativeMeet := prob.nonnegative with space, eventMeet
  have inversePositive := realInvValue.positive at prob(P, B) with positive
  have inverseReal := realInvValue.real at prob(P, B)
  have inverseNonnegative : (0:R) ≤ (realInvValue(prob(P, B)):R) by linarith
  have division := realDiv.eq_mul_inv at prob(P, A ∩ B), prob(P, B)
  have product := realMulValue.nonnegative at prob(P, A ∩ B),
      realInvValue(prob(P, B)) with
    nonnegativeMeet, inverseNonnegative
  rw [condProb.value, division]
  exact product

theorem condProb.le_one (Ω P A B : Set)
  requires space : ProbabilitySpace(Ω, P)
  requires eventA : A ⊆ Ω
  requires eventB : B ⊆ Ω
  requires positive : (0:R) < (prob(P, B):R)
  shows (condProb(P, A, B):R) ≤ (1:R)
proof
  have eventMeet : A ∩ B ⊆ Ω by simp
  have realMeet := prob.real with space, eventMeet
  have realB := prob.real with space, eventB
  have nonzero := prob.ne_zero_of_positive with space, eventB, positive
  have bound := prob.intersection_le_right at Ω, P, A, B with space, eventB
  have inversePositive := realInvValue.positive at prob(P, B) with positive
  have inverseReal := realInvValue.real at prob(P, B)
  have inverseNonnegative : (0:R) ≤ (realInvValue(prob(P, B)):R) by linarith
  have division := realDiv.eq_mul_inv at prob(P, A ∩ B), prob(P, B)
  have scaled := realLe.mul_right_of_nonnegative at prob(P, A ∩ B), prob(P, B),
    realInvValue(prob(P, B)) with bound, inverseNonnegative
  have inverseLaw := realInvValue.mul_right at prob(P, B) with nonzero
  rw [condProb.value, division]
  rw inverseLaw at scaled
  exact scaled

theorem condProb.self (Ω P B : Set)
  requires space : ProbabilitySpace(Ω, P)
  requires eventB : B ⊆ Ω
  requires positive : (0:R) < (prob(P, B):R)
  shows condProb(P, B, B) = (1:R)
proof
  have realB := prob.real with space, eventB
  have nonzero := prob.ne_zero_of_positive with space, eventB, positive
  have same := intersection.idempotent at B
  rw [condProb.value, same]
  exact realDiv.self at prob(P, B) with nonzero

theorem condProb.whole (Ω P B : Set)
  requires space : ProbabilitySpace(Ω, P)
  requires eventB : B ⊆ Ω
  requires positive : (0:R) < (prob(P, B):R)
  shows condProb(P, Ω, B) = (1:R)
proof
  have realB := prob.real with space, eventB
  have nonzero := prob.ne_zero_of_positive with space, eventB, positive
  have same := intersection.eq_right_of_subset at Ω, B with eventB
  rw [condProb.value, same]
  exact realDiv.self at prob(P, B) with nonzero

theorem condProb.empty (Ω P B : Set)
  requires space : ProbabilitySpace(Ω, P)
  requires eventB : B ⊆ Ω
  shows condProb(P, ∅, B) = (0:R)
proof
  have realB := prob.real with space, eventB
  have same := intersection.left_empty at B
  have empty := prob.empty at P
  rw [condProb.value, same, empty]
  exact realDiv.zero_left at prob(P, B)

theorem condProb.of_disjoint (Ω P A B : Set)
  requires space : ProbabilitySpace(Ω, P)
  requires eventB : B ⊆ Ω
  requires disjoint : Disjoint(A, B)
  shows condProb(P, A, B) = (0:R)
proof
  have realB := prob.real with space, eventB
  have same : A ∩ B = ∅ := disjoint
  have empty := prob.empty at P
  rw [condProb.value, same, empty]
  exact realDiv.zero_left at prob(P, B)

-- The multiplication rule.
theorem condProb.multiplication (Ω P A B : Set)
  requires space : ProbabilitySpace(Ω, P)
  requires eventA : A ⊆ Ω
  requires eventB : B ⊆ Ω
  requires positive : (0:R) < (prob(P, B):R)
  shows prob(P, A ∩ B) = (condProb(P, A, B):R) * (prob(P, B):R)
proof
  have eventMeet : A ∩ B ⊆ Ω by simp
  have realMeet := prob.real with space, eventMeet
  have realB := prob.real with space, eventB
  have nonzero := prob.ne_zero_of_positive with space, eventB, positive
  have cancel := realDiv.mul_right at prob(P, A ∩ B), prob(P, B) with nonzero
  rw condProb.value
  symm
  exact cancel

theorem condProb.of_subset (Ω P A B : Set)
  requires space : ProbabilitySpace(Ω, P)
  requires inner : A ⊆ B
  shows condProb(P, A, B) = (prob(P, A):R) / (prob(P, B):R)
proof
  have same := intersection.eq_left_of_subset at A, B with inner
  rw [condProb.value, same]
  rfl

theorem condProb.of_superset (Ω P A B : Set)
  requires space : ProbabilitySpace(Ω, P)
  requires eventB : B ⊆ Ω
  requires inner : B ⊆ A
  requires positive : (0:R) < (prob(P, B):R)
  shows condProb(P, A, B) = (1:R)
proof
  have realB := prob.real with space, eventB
  have nonzero := prob.ne_zero_of_positive with space, eventB, positive
  have same := intersection.eq_right_of_subset at A, B with inner
  rw [condProb.value, same]
  exact realDiv.self at prob(P, B) with nonzero

theorem condProb.monotone (Ω P A C B : Set)
  requires space : ProbabilitySpace(Ω, P)
  requires eventC : C ⊆ Ω
  requires eventB : B ⊆ Ω
  requires inner : A ⊆ C
  requires positive : (0:R) < (prob(P, B):R)
  shows (condProb(P, A, B):R) ≤ (condProb(P, C, B):R)
proof
  have eventMeetC : C ∩ B ⊆ Ω by simp
  have innerMeet : A ∩ B ⊆ C ∩ B by simp
  have eventMeetA := Subset.transitive with innerMeet, eventMeetC
  have realMeetA := prob.real with space, eventMeetA
  have realMeetC := prob.real with space, eventMeetC
  have realB := prob.real with space, eventB
  have bound := prob.monotone with space, eventMeetC, innerMeet
  have inversePositive := realInvValue.positive at prob(P, B) with positive
  have inverseReal := realInvValue.real at prob(P, B)
  have inverseNonnegative : (0:R) ≤ (realInvValue(prob(P, B)):R) by linarith
  have divisionA := realDiv.eq_mul_inv at prob(P, A ∩ B), prob(P, B)
  have divisionC := realDiv.eq_mul_inv at prob(P, C ∩ B), prob(P, B)
  have scaled := realLe.mul_right_of_nonnegative at prob(P, A ∩ B), prob(P,
      C ∩ B),
    realInvValue(prob(P, B)) with bound, inverseNonnegative
  rw [condProb.value, condProb.value, divisionA, divisionC]
  exact scaled

theorem condProb.union_disjoint (Ω P A C B : Set)
  requires space : ProbabilitySpace(Ω, P)
  requires eventA : A ⊆ Ω
  requires eventC : C ⊆ Ω
  requires eventB : B ⊆ Ω
  requires disjoint : Disjoint(A, C)
  shows condProb(P, A ∪ C, B) = (condProb(P, A, B):R) + (condProb(P, C, B):R)
proof
  have eventMeetA : A ∩ B ⊆ Ω by simp
  have eventMeetC : C ∩ B ⊆ Ω by simp
  have realMeetA := prob.real with space, eventMeetA
  have realMeetC := prob.real with space, eventMeetC
  have realB := prob.real with space, eventB
  have split : (A ∪ C) ∩ B = (A ∩ B) ∪ (C ∩ B)
    ext y
    simp
  have innerC := intersection.subset_left at C, B
  have innerA := intersection.subset_left at A, B
  have disjointRight := Disjoint.of_subset_right with disjoint, innerC
  have disjointMeet := Disjoint.of_subset_left with disjointRight, innerA
  have union := prob.union_disjoint with space, eventMeetA, eventMeetC,
      disjointMeet
  have division := realDiv.add_left at prob(P, A ∩ B), prob(P, C ∩ B), prob(P,
      B)
  rw [condProb.value, condProb.value, condProb.value, split, union]
  exact division

theorem condProb.complement (Ω P A B : Set)
  requires space : ProbabilitySpace(Ω, P)
  requires eventA : A ⊆ Ω
  requires eventB : B ⊆ Ω
  requires positive : (0:R) < (prob(P, B):R)
  shows condProb(P, Ω ∖ A, B) = (1:R) - (condProb(P, A, B):R)
proof
  have eventMeet : A ∩ B ⊆ Ω by simp
  have eventRest : B ∖ A ⊆ Ω by simp
  have realMeet := prob.real with space, eventMeet
  have realRest := prob.real with space, eventRest
  have realB := prob.real with space, eventB
  have nonzero := prob.ne_zero_of_positive with space, eventB, positive
  have same : (Ω ∖ A) ∩ B = B ∖ A
    ext y
    simp
  have commute := intersection.commutative at B, A
  have split := prob.difference at Ω, P, B, A with space, eventB
  rw commute at split
  have inverseReal := realInvValue.real at prob(P, B)
  have inverseLaw := realInvValue.mul_right at prob(P, B) with nonzero
  have divisionRest := realDiv.eq_mul_inv at prob(P, B ∖ A), prob(P, B)
  have divisionMeet := realDiv.eq_mul_inv at prob(P, A ∩ B), prob(P, B)
  rw [condProb.value, condProb.value, same, divisionRest, divisionMeet, split]
  calc
    ((prob(P, B):R) - (prob(P, A ∩ B):R)) * (realInvValue(prob(P, B)):R) =
        (prob(P, B):R) * (realInvValue(prob(P, B)):R) -
          (prob(P, A ∩ B):R) * (realInvValue(prob(P, B)):R) := by ring
    _ = (1:R) - (prob(P, A ∩ B):R) * (realInvValue(prob(P, B)):R) := by cc

-- The law of total probability for the partition B, Ω ∖ B.
theorem condProb.total_probability (Ω P A B : Set)
  requires space : ProbabilitySpace(Ω, P)
  requires eventA : A ⊆ Ω
  requires eventB : B ⊆ Ω
  requires positive : (0:R) < (prob(P, B):R)
  requires positiveRest : (0:R) < (prob(P, Ω ∖ B):R)
  shows prob(P, A) = (condProb(P, A, B):R) * (prob(P, B):R) +
    (condProb(P, A, Ω ∖ B):R) * (prob(P, Ω ∖ B):R)
proof
  have eventRest : Ω ∖ B ⊆ Ω by simp
  have eventMeet : A ∩ B ⊆ Ω by simp
  have eventMeetRest : A ∩ (Ω ∖ B) ⊆ Ω by simp
  have split : (A ∩ B) ∪ (A ∩ (Ω ∖ B)) = A
    ext y
    simp
  have innerB := intersection.subset_right at A, B
  have innerRest := intersection.subset_right at A, Ω ∖ B
  have disjointRest := Disjoint.difference_right at Ω, B
  have disjointRight := Disjoint.of_subset_right with disjointRest, innerRest
  have disjointMeet := Disjoint.of_subset_left with disjointRight, innerB
  have union := prob.union_disjoint with space, eventMeet, eventMeetRest,
      disjointMeet
  have first := condProb.multiplication with space, eventA, eventB, positive
  have second := condProb.multiplication with space, eventA, eventRest,
      positiveRest
  rw split at union
  rw [union, first, second]
  rfl

theorem condProb.bayes (Ω P A B : Set)
  requires space : ProbabilitySpace(Ω, P)
  requires eventA : A ⊆ Ω
  requires eventB : B ⊆ Ω
  requires positiveA : (0:R) < (prob(P, A):R)
  requires positiveB : (0:R) < (prob(P, B):R)
  shows condProb(P, A, B) = ((condProb(P, B, A):R) * (prob(P, A):R)) / (prob(P,
      B):R)
proof
  have commute := intersection.commutative at A, B
  have product := condProb.multiplication with space, eventB, eventA, positiveA
  rw condProb.value
  rw [commute, product]
  rfl

-- Conditioning on B is again a probability space on Ω: the weight is
-- rescaled on B and vanishes outside it.
def conditionalWeight (Ω P B : Set) : Set :=
  maskedWeight(Ω, B, weightScale(Ω, realInvValue(prob(P, B)), P))

theorem conditionalWeight.inverse_real (Ω P B : Set)
  requires space : ProbabilitySpace(Ω, P)
  requires eventB : B ⊆ Ω
  shows Real(realInvValue(prob(P, B)))
proof
  have realB := prob.real with space, eventB
  exact realInvValue.real at prob(P, B)

theorem conditionalWeight.function (Ω P B : Set)
  requires space : ProbabilitySpace(Ω, P)
  requires eventB : B ⊆ Ω
  shows conditionalWeight(Ω, P, B) : Ω → ℝ
proof
  have function := ProbabilitySpace.function with space
  have inverseReal := conditionalWeight.inverse_real with space, eventB
  have scaled := weightScale.function at Ω, realInvValue(prob(P, B)), P with
      function
  unfold conditionalWeight
  exact maskedWeight.function at Ω, B, weightScale(Ω, realInvValue(prob(P, B)),
    P) with
    scaled

theorem conditionalWeight.inside (Ω P B ω : Set)
  requires space : ProbabilitySpace(Ω, P)
  requires eventB : B ⊆ Ω
  requires point : ω ∈ Ω
  requires inside : ω ∈ B
  shows conditionalWeight(Ω, P, B)(ω) = (realInvValue(prob(P, B)):R) * (P(ω):R)
proof
  have function := ProbabilitySpace.function with space
  have inverseReal := conditionalWeight.inverse_real with space, eventB
  have scaled := weightScale.function at Ω, realInvValue(prob(P, B)), P with
      function
  have mask := maskedWeight.inside at Ω, B, weightScale(Ω, realInvValue(prob(P,
      B)), P),
    ω with scaled, point, inside
  have value := weightScale.value at Ω, realInvValue(prob(P, B)), P, ω with
      function, point
  unfold conditionalWeight
  cc

theorem conditionalWeight.outside (Ω P B ω : Set)
  requires space : ProbabilitySpace(Ω, P)
  requires eventB : B ⊆ Ω
  requires point : ω ∈ Ω
  requires outside : ¬(ω ∈ B)
  shows conditionalWeight(Ω, P, B)(ω) = (0:R)
proof
  have function := ProbabilitySpace.function with space
  have inverseReal := conditionalWeight.inverse_real with space, eventB
  have scaled := weightScale.function at Ω, realInvValue(prob(P, B)), P with
      function
  have mask := maskedWeight.outside at Ω, B, weightScale(Ω,
      realInvValue(prob(P, B)), P),
    ω with scaled, point, outside
  unfold conditionalWeight
  cc

theorem conditionalWeight.nonnegative (Ω P B : Set)
  requires space : ProbabilitySpace(Ω, P)
  requires eventB : B ⊆ Ω
  requires positive : (0:R) < (prob(P, B):R)
  shows ∀ ω ∈ Ω, (0:R) ≤ (conditionalWeight(Ω, P, B)(ω):R)
proof
  intros ω point
  have realB := prob.real with space, eventB
  have inverseReal := conditionalWeight.inverse_real with space, eventB
  have inversePositive := realInvValue.positive at prob(P, B) with positive
  have inverseNonnegative : (0:R) ≤ (realInvValue(prob(P, B)):R) by linarith
  have alternatives : ω ∈ B ∨ ¬(ω ∈ B) by tauto
  cases alternatives with inside | outside
  . have value := conditionalWeight.inside with space, eventB, point, inside
    have pointReal := ProbabilitySpace.point_real with space, point
    have pointNonnegative := ProbabilitySpace.point_nonnegative with space,
        point
    rw value
    exact realMulValue.nonnegative at realInvValue(prob(P, B)), P(ω) with
      inverseNonnegative, pointNonnegative
  . have value := conditionalWeight.outside with space, eventB, point, outside
    rw value
    exact realLe.reflexive with realZero.real

-- Under the conditional weight an event A has probability condProb(A, B).
theorem conditionalWeight.prob (Ω P B A : Set)
  requires space : ProbabilitySpace(Ω, P)
  requires eventB : B ⊆ Ω
  requires eventA : A ⊆ Ω
  shows prob(conditionalWeight(Ω, P, B), A) = condProb(P, A, B)
proof
  have function := ProbabilitySpace.function with space
  have finiteA := ProbabilitySpace.event_finite with space, eventA
  have inverseReal := conditionalWeight.inverse_real with space, eventB
  have scaled := weightScale.function at Ω, realInvValue(prob(P, B)), P with
      function
  have eventMeet : A ∩ B ⊆ Ω by simp
  have finiteMeet := ProbabilitySpace.event_finite with space, eventMeet
  have realMeet := prob.real with space, eventMeet
  have realB := prob.real with space, eventB
  have masked := realSetSum.masked_intersection at A, B, Ω,
    weightScale(Ω, realInvValue(prob(P, B)), P) with finiteA, scaled, eventA
  have scale := realSetSum.scale at A ∩ B, Ω, P, realInvValue(prob(P, B)) with
    finiteMeet, function, eventMeet
  have division := realDiv.eq_mul_inv at prob(P, A ∩ B), prob(P, B)
  have commute := realMulValue.commutative at realInvValue(prob(P, B)), prob(P,
      A ∩ B)
  have meetValue := prob.value at P, A ∩ B
  rw [prob.value, condProb.value, division]
  unfold conditionalWeight
  cc

theorem conditionalWeight.total (Ω P B : Set)
  requires space : ProbabilitySpace(Ω, P)
  requires eventB : B ⊆ Ω
  requires positive : (0:R) < (prob(P, B):R)
  shows realSetSum(Ω, conditionalWeight(Ω, P, B)) = (1:R)
proof
  have whole := Subset.reflexive at Ω
  have conditioned := conditionalWeight.prob with space, eventB, whole
  have one := condProb.whole with space, eventB, positive
  rw prob.value at conditioned
  rw conditioned
  exact one

theorem conditionalWeight.space (Ω P B : Set)
  requires space : ProbabilitySpace(Ω, P)
  requires eventB : B ⊆ Ω
  requires positive : (0:R) < (prob(P, B):R)
  shows ProbabilitySpace(Ω, conditionalWeight(Ω, P, B))
proof
  have finite := ProbabilitySpace.finite with space
  have function := conditionalWeight.function with space, eventB
  have nonnegative := conditionalWeight.nonnegative with space, eventB, positive
  have total := conditionalWeight.total with space, eventB, positive
  exact ProbabilitySpace.intro with finite, function, nonnegative, total
