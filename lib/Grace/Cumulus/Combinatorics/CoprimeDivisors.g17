-- Divisors of a coprime product: a divisor d of a · b with gcd(a, b) = 1
-- splits as gcd(d, a) · gcd(d, b), the product (d, e) ↦ d · e is a bijection
-- divisors(a) × divisors(b) ≃ divisors(a · b), and a sum over the divisors
-- of a · b is the sum over such pairs
-- Part of Cumulus, the Grace17 mathematics library.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module Grace.Cumulus.Combinatorics.CoprimeDivisors
import DivisorSums

theorem coprime.of_divisors (a b d e : Nat)
  requires coprime : gcd(a, b) = 1
  requires left : d ∣ a
  requires right : e ∣ b
  shows gcd(d, e) = 1
proof
  have characterization := gcd.eq_one_iff at d, e
  apply characterization.backward
  intros k kNat kd ke
  have ka := divides.transitive with kd, left
  have kb := divides.transitive with ke, right
  exact coprime.divisor_one with coprime, ka, kb

theorem mul.nonzero (a b : Nat)
  requires nonzeroA : a ≠ 0
  requires nonzeroB : b ≠ 0
  shows a * b ≠ 0
proof
  intro zero
  have characterization := mul.eq_zero_iff at a, b
  have alternatives := characterization.forward with zero
  cases alternatives with aZero | bZero
  . exact nonzeroA with aZero
  . exact nonzeroB with bZero

-- A divisor of a coprime product is the product of its parts in each
-- factor.
theorem divides.split_coprime (a b d : Nat)
  requires nonzeroA : a ≠ 0
  requires nonzeroB : b ≠ 0
  requires coprime : gcd(a, b) = 1
  requires factor : d ∣ a * b
  shows d = gcd(d, a) * gcd(d, b)
proof
  have gNonzero := gcd.nonzero_right at d, a with nonzeroA
  have gNat := gcd.natural at d, a
  have hNat := gcd.natural at d, b
  have gDividesD := gcd.divides_left at d, a
  have gDividesA := gcd.divides_right at d, a
  have hDividesD := gcd.divides_left at d, b
  have hDividesB := gcd.divides_right at d, b
  obtain ⟨e, eNat, dProduct⟩ := gDividesD
  obtain ⟨p, pNat, aProduct⟩ := gDividesA
  have cofactors := gcd.cofactor_coprime at d, a, e, p with gNonzero, dProduct,
    aProduct
  have rearranged : gcd(d, a) * p * b = gcd(d, a) * (p * b) by ring
  have expanded : a * b = gcd(d, a) * (p * b) by cc
  have scaled : gcd(d, a) * e ∣ gcd(d, a) * (p * b)
    rw [dProduct, ← expanded]
    exact factor
  have cancel := divides.mul_cancel_left at gcd(d, a), e, p * b with gNonzero
  have eDivides := cancel.forward with scaled
  have commuted : p * b = b * p by ring
  rw commuted at eDivides
  have coprimePE := coprime.symmetric with cofactors
  have eDividesB := coprime.cancel_right with coprimePE, eDivides
  have eDividesD := divides.mul_right_self at e, gcd(d, a)
  rw dProduct at eDividesD
  have eDividesH := gcd.greatest with eDividesD, eDividesB
  have gSelf := divides.reflexive at gcd(d, a)
  have forward := divides.mul_mono with gSelf, eDividesH
  rw dProduct at forward
  have gDividesD2 := gcd.divides_left at d, a
  have coprimeGH := coprime.of_divisors with coprime, gDividesA, hDividesB
  have backward := coprime.mul_divides with coprimeGH, gDividesD2, hDividesD
  exact divides.antisymmetric with forward, backward

-- The product (d, e) ↦ d · e of a divisor of a and a divisor of b.
defgraph divisorProduct (a b : Nat) (q ∈ divisors(a) × divisors(b)) :
    divisors(a * b) :=
  mul(firstProjection(divisors(a), divisors(b))(q),
    secondProjection(divisors(a), divisors(b))(q))
requires nonzeroA : a ≠ 0
requires nonzeroB : b ≠ 0
proof
  have firstFunction := firstProjection.function at divisors(a), divisors(b)
  have secondFunction := secondProjection.function at divisors(a), divisors(b)
  have dMember := FunctionBetween.apply_closed with firstFunction, member
  have eMember := FunctionBetween.apply_closed with secondFunction, member
  have dNat := divisors.natural with dMember
  have eNat := divisors.natural with eMember
  have dDivides := divisors.divides with dMember
  have eDivides := divisors.divides with eMember
  have productDivides := divides.mul_mono with dDivides, eDivides
  have productNonzero := mul.nonzero with nonzeroA, nonzeroB
  have below := divides.le with productDivides, productNonzero
  have characterization := divisors.membership_le at a * b,
    mul(firstProjection(divisors(a), divisors(b))(q),
      secondProjection(divisors(a), divisors(b))(q))
  exact characterization.backward with ⟨below, productDivides⟩

theorem divisorProduct.pair (a b : Nat) (d e : Set)
  requires nonzeroA : a ≠ 0
  requires nonzeroB : b ≠ 0
  requires hd : d ∈ divisors(a)
  requires he : e ∈ divisors(b)
  shows divisorProduct(a, b)((d, e)) = mul(d, e)
proof
  have pairMember := product.pair with hd, he
  have value := divisorProduct.value at a, b, (d, e) with nonzeroA, nonzeroB,
    pairMember
  have firstValue := firstProjection.pair at divisors(a), divisors(b), d, e
    with hd, he
  have secondValue := secondProjection.pair at divisors(a), divisors(b), d, e
    with hd, he
  rw [value, firstValue, secondValue]
  rfl

theorem divisorProduct.injective (a b : Nat)
  requires nonzeroA : a ≠ 0
  requires nonzeroB : b ≠ 0
  requires coprime : gcd(a, b) = 1
  shows InjectiveBetween(divisorProduct(a, b), divisors(a) × divisors(b),
    divisors(a * b))
proof
  have function := divisorProduct.function at a, b with nonzeroA, nonzeroB
  refine ⟨function, _⟩
  intros x hx y hy z hz relatesX relatesY
  have xShape := product.membership.forward with hx
  obtain ⟨_, d1, hd1, d2, hd2, xEq⟩ := xShape
  have yShape := product.membership.forward with hy
  obtain ⟨_, e1, he1, e2, he2, yEq⟩ := yShape
  have d1Nat := divisors.natural with hd1
  have d2Nat := divisors.natural with hd2
  have e1Nat := divisors.natural with he1
  have e2Nat := divisors.natural with he2
  have d1Divides := divisors.divides with hd1
  have d2Divides := divisors.divides with hd2
  have e1Divides := divisors.divides with he1
  have e2Divides := divisors.divides with he2
  have valueX := FunctionBetween.apply_value with function, hx, relatesX
  have valueY := FunctionBetween.apply_value with function, hy, relatesY
  have pairX := divisorProduct.pair with nonzeroA, nonzeroB, hd1, hd2
  have pairY := divisorProduct.pair with nonzeroA, nonzeroB, he1, he2
  rw xEq at valueX
  rw yEq at valueY
  have same : d1 * d2 = e1 * e2 by cc
  have d1DividesProduct : d1 ∣ e1 * e2
    rw ← same
    exact divides.mul_left_self at d1, d2
  have e1DividesProduct : e1 ∣ d1 * d2
    rw same
    exact divides.mul_left_self at e1, e2
  have coprimeD1E2 := coprime.of_divisors with coprime, d1Divides, e2Divides
  have coprimeE2D1 := coprime.symmetric with coprimeD1E2
  have d1DividesE1 := coprime.cancel_right with coprimeE2D1, d1DividesProduct
  have coprimeE1D2 := coprime.of_divisors with coprime, e1Divides, d2Divides
  have coprimeD2E1 := coprime.symmetric with coprimeE1D2
  have e1DividesD1 := coprime.cancel_right with coprimeD2E1, e1DividesProduct
  have firstEqual := divides.antisymmetric with d1DividesE1, e1DividesD1
  have e1Nonzero := divides.nonzero with e1Divides, nonzeroA
  rw firstEqual at same
  have secondEqual := mul.left_cancel_positive with e1Nonzero, same
  rw [xEq, yEq, firstEqual, secondEqual]
  rfl

theorem divisorProduct.surjective (a b : Nat)
  requires nonzeroA : a ≠ 0
  requires nonzeroB : b ≠ 0
  requires coprime : gcd(a, b) = 1
  shows SurjectiveBetween(divisorProduct(a, b), divisors(a) × divisors(b),
    divisors(a * b))
proof
  have function := divisorProduct.function at a, b with nonzeroA, nonzeroB
  refine ⟨function, _⟩
  intros z hz
  have zNat := divisors.natural with hz
  have factor := divisors.divides with hz
  have split := divides.split_coprime with nonzeroA, nonzeroB, coprime, factor
  have gNat := gcd.natural at z, a
  have hNat := gcd.natural at z, b
  have gDividesA := gcd.divides_right at z, a
  have hDividesB := gcd.divides_right at z, b
  have gBelow := divides.le with gDividesA, nonzeroA
  have hBelow := divides.le with hDividesB, nonzeroB
  have characterizationA := divisors.membership_le at a, gcd(z, a)
  have characterizationB := divisors.membership_le at b, gcd(z, b)
  have inA := characterizationA.backward with ⟨gBelow, gDividesA⟩
  have inB := characterizationB.backward with ⟨hBelow, hDividesB⟩
  have pairMember := product.pair with inA, inB
  have value := divisorProduct.pair with nonzeroA, nonzeroB, inA, inB
  have relates := FunctionBetween.relates_apply with function, pairMember
  rw [value, ← split] at relates
  exact ⟨(gcd(z, a), gcd(z, b)), pairMember, relates⟩

-- Divisors of a coprime product are the products of divisors of the
-- factors.
theorem divisorProduct.bijective (a b : Nat)
  requires nonzeroA : a ≠ 0
  requires nonzeroB : b ≠ 0
  requires coprime : gcd(a, b) = 1
  shows BijectiveBetween(divisorProduct(a, b), divisors(a) × divisors(b),
    divisors(a * b))
proof
  have injective := divisorProduct.injective with nonzeroA, nonzeroB, coprime
  have surjective := divisorProduct.surjective with nonzeroA, nonzeroB, coprime
  exact ⟨injective, surjective⟩

-- The weight (d, e) ↦ w(d · e) on pairs of divisors.
defgraph pairedWeights (a b : Nat) (w : Set) (q ∈ divisors(a) × divisors(b)) :
    ℤ := w(divisorProduct(a, b)(q))
requires nonzeroA : a ≠ 0
requires nonzeroB : b ≠ 0
requires weights : w : ℕ → ℤ
proof
  have function := divisorProduct.function at a, b with nonzeroA, nonzeroB
  have image := FunctionBetween.apply_closed with function, member
  have naturals := divisors.subset_naturals at a * b
  have imageMember := naturals with divisorProduct(a, b)(q), image
  exact FunctionBetween.apply_closed with weights, imageMember

-- A sum over the divisors of a coprime product a · b is the sum of
-- w(d · e) over the pairs of divisors d ∣ a, e ∣ b.
theorem divisorSum.mul_coprime (a b : Nat, w : Set)
  requires nonzeroA : a ≠ 0
  requires nonzeroB : b ≠ 0
  requires coprime : gcd(a, b) = 1
  requires weights : w : ℕ → ℤ
  shows divisorSum(a * b, w) =
    integerSetSum(divisors(a) × divisors(b), pairedWeights(a, b, w))
proof
  have finiteA := divisors.finite at a
  have finiteB := divisors.finite at b
  have finite := Finite.product with finiteA, finiteB
  have paired := pairedWeights.function at a, b, w with nonzeroA, nonzeroB,
    weights
  have bijective := divisorProduct.bijective with nonzeroA, nonzeroB, coprime
  have selfSubset := Subset.reflexive at divisors(a) × divisors(b)
  have naturals := divisors.subset_naturals at a * b
  have values : ∀ q ∈ divisors(a) × divisors(b),
      pairedWeights(a, b, w)(q) = w(divisorProduct(a, b)(q))
    intros q hq
    exact pairedWeights.value at a, b, w, q with nonzeroA, nonzeroB, weights,
      hq
  have sum := integerSetSum.reindex at divisors(a) × divisors(b),
    divisors(a * b), divisors(a) × divisors(b), ℕ, pairedWeights(a, b, w), w,
      divisorProduct(a, b) with finite, paired, weights, selfSubset, naturals,
        bijective, values
  symm
  unfold divisorSum
  rfl
