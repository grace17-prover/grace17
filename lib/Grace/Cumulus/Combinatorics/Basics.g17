module Grace.Cumulus.Combinatorics.Basics
import Cardinal
import Cardinal.Combinations
import Nat.Subtraction

theorem HasCardinality.of_cardinality (A : Set) (n : Nat)
  requires finite : Finite(A)
  requires size : cardinality(A) = n
  shows HasCardinality(A, n)
proof
  have counted := cardinality.correct with finite
  rw size at counted
  exact counted

theorem cardinality.eq_zero_iff (A : Set)
  requires finite : Finite(A)
  shows cardinality(A) = 0 ↔ A = ∅
proof
  constructor
  . intro zero
    have counted := cardinality.correct with finite
    rw zero at counted
    exact HasCardinality.empty_of_zero with counted
  . intro empty
    rw empty
    exact cardinality.empty

theorem cardinality.positive_of_member (A a : Set)
  requires finite : Finite(A)
  requires member : a ∈ A
  shows 0 < cardinality(A)
proof
  have removed := cardinality.remove with finite, member
  have restFinite := Finite.subset with
    finite, (difference.subset_left at A, {a})
  have restNat := cardinality.nat with restFinite
  rw removed
  arith

theorem cardinality.ne_zero_of_member (A a : Set)
  requires finite : Finite(A)
  requires member : a ∈ A
  shows cardinality(A) ≠ 0
proof
  intro zero
  have iff := cardinality.eq_zero_iff with finite
  have empty := iff.forward with zero
  rw empty at member
  exact set.empty with member

theorem cardinality.positive_iff_nonempty (A : Set)
  requires finite : Finite(A)
  shows Nonempty(A) ↔ 0 < cardinality(A)
proof
  constructor
  . intro nonempty
    obtain ⟨a, member⟩ := nonempty
    exact cardinality.positive_of_member with finite, member
  . intro positive
    apply Nonempty.of_ne_empty
    intro empty
    have iff := cardinality.eq_zero_iff with finite
    have zero := iff.backward with empty
    rw zero at positive
    have irreflexive := Less.irreflexive at 0
    exact irreflexive with positive

theorem cardinality.member_of_positive (A : Set)
  requires finite : Finite(A)
  requires positive : 0 < cardinality(A)
  shows ∃ a, a ∈ A
proof
  have iff := cardinality.positive_iff_nonempty with finite
  exact iff.backward with positive

theorem cardinality.ne_zero_iff_nonempty (A : Set)
  requires finite : Finite(A)
  shows cardinality(A) ≠ 0 ↔ Nonempty(A)
proof
  constructor
  . intro nonzero
    apply Nonempty.of_ne_empty
    intro empty
    have iff := cardinality.eq_zero_iff with finite
    exact nonzero with (iff.backward with empty)
  . intro nonempty
    obtain ⟨a, member⟩ := nonempty
    exact cardinality.ne_zero_of_member with finite, member

-- Inserting a point already present changes nothing.
theorem insert.eq_of_member (A a : Set)
  requires member : a ∈ A
  shows insert(a, A) = A
proof
  ext z
  simp

theorem cardinality.insert_of_member (A a : Set)
  requires member : a ∈ A
  shows cardinality(insert(a, A)) = cardinality(A)
proof
  have same := insert.eq_of_member with member
  rw same
  rfl

theorem cardinality.insert_add_one (A a : Set)
  requires finite : Finite(A)
  requires fresh : ¬a ∈ A
  shows cardinality(insert(a, A)) = cardinality(A) + 1
proof
  have inserted := cardinality.insert with finite, fresh
  have natA := cardinality.nat with finite
  have one := add.right_one at cardinality(A)
  rw [inserted, one]
  rfl

theorem cardinality.remove_add_one (A a : Set)
  requires finite : Finite(A)
  requires member : a ∈ A
  shows cardinality(A) = cardinality(A ∖ {a}) + 1
proof
  have removed := cardinality.remove with finite, member
  have restFinite := Finite.subset with
    finite, (difference.subset_left at A, {a})
  have restNat := cardinality.nat with restFinite
  have one := add.right_one at cardinality(A ∖ {a})
  rw [removed, one]
  rfl

theorem cardinality.remove_sub_one (A a : Set)
  requires finite : Finite(A)
  requires member : a ∈ A
  shows cardinality(A ∖ {a}) = cardinality(A) - 1
proof
  have split := cardinality.remove_add_one with finite, member
  have restFinite := Finite.subset with
    finite, (difference.subset_left at A, {a})
  have restNat := cardinality.nat with restFinite
  rw split
  symm
  exact sub.add_right at cardinality(A ∖ {a}), 1

theorem cardinality.remove_of_absent (A a : Set)
  requires absent : ¬a ∈ A
  shows cardinality(A ∖ {a}) = cardinality(A)
proof
  have same := difference.singleton_of_absent with absent
  rw same
  rfl

theorem cardinality.pair (x y : Set)
  requires different : x ≠ y
  shows cardinality({x, y}) = 2
proof
  have shape : {x, y} = insert(x, {y})
    ext z
    simp
  have fresh : ¬x ∈ {y}
    intro member
    have equal := singleton.membership.forward with member
    exact different with equal
  have inserted := cardinality.insert at {y}, x with
    (Finite.singleton at y), fresh
  have one := cardinality.singleton at y
  rw [shape, inserted, one]
  compute

theorem cardinality.pair_same (x : Set)
  shows cardinality({x, x}) = 1
proof
  have same : {x, x} = {x}
    ext z
    simp
  rw same
  exact cardinality.singleton at x

-- A set with exactly one element is a singleton.
theorem cardinality.one_iff (A : Set)
  requires finite : Finite(A)
  shows cardinality(A) = 1 ↔ ∃ x, A = {x}
proof
  constructor
  . intro one
    have counted := cardinality.correct with finite
    rw one at counted
    obtain ⟨a, member⟩ := HasCardinality.exists_member at A, 0 with counted
    have split := cardinality.remove_add_one with finite, member
    have restFinite := Finite.subset with
      finite, (difference.subset_left at A, {a})
    have restNat := cardinality.nat with restFinite
    rw one at split
    have restZero : cardinality(A ∖ {a}) = 0
      have balance : cardinality(A ∖ {a}) + 1 = 0 + 1
        rw ← split
        compute
      exact add.right_cancel with balance
    have iff := cardinality.eq_zero_iff with restFinite
    have restEmpty := iff.forward with restZero
    have restored := insert.restore with member
    rw restEmpty at restored
    witness a
    rw ← restored
    ext z
    simp
  . intro singleton
    obtain ⟨x, shape⟩ := singleton
    rw shape
    exact cardinality.singleton at x

theorem cardinality.equipotent (A B : Set)
  requires finite : Finite(A)
  requires equipotent : A ≃ B
  shows cardinality(A) = cardinality(B)
proof
  obtain ⟨f, bijective⟩ := equipotent
  exact cardinality.bijective with finite, bijective

theorem cardinality.equipotent_of_eq (A B : Set)
  requires finiteA : Finite(A)
  requires finiteB : Finite(B)
  requires same : cardinality(A) = cardinality(B)
  shows A ≃ B
proof
  have countedA := HasCardinality.equipotent with (cardinality.correct with
    finiteA)
  have countedB := HasCardinality.equipotent with (cardinality.correct with
    finiteB)
  rw same at countedA
  have back := Equipotent.symmetric with countedB
  exact Equipotent.transitive with countedA, back

theorem cardinality.eq_iff_equipotent (A B : Set)
  requires finiteA : Finite(A)
  requires finiteB : Finite(B)
  shows cardinality(A) = cardinality(B) ↔ A ≃ B
proof
  constructor
  . intro same
    exact cardinality.equipotent_of_eq with finiteA, finiteB, same
  . intro equipotent
    exact cardinality.equipotent with finiteA, equipotent

-- A proper subset of a finite set is strictly smaller.
theorem cardinality.strict_of_ne (S T : Set)
  requires finite : Finite(T)
  requires subset : S ⊆ T
  requires different : S ≠ T
  shows cardinality(S) < cardinality(T)
proof
  have witness : ∃ a ∈ T, ¬a ∈ S
    by_contra none
    apply different
    apply Subset.antisymmetric with subset
    intros z hz
    by_contra outside
    apply none
    exact ⟨z, hz, outside⟩
  obtain ⟨a, member, fresh⟩ := witness
  exact cardinality.strict with finite, subset, member, fresh

theorem cardinality.lt_iff_ne (S T : Set)
  requires finite : Finite(T)
  requires subset : S ⊆ T
  shows cardinality(S) < cardinality(T) ↔ S ≠ T
proof
  constructor
  . intro less
    intro equal
    rw equal at less
    have irreflexive := Less.irreflexive at cardinality(T)
    exact irreflexive with less
  . intro different
    exact cardinality.strict_of_ne with finite, subset, different

theorem cardinality.eq_iff_subset_eq (S T : Set)
  requires finite : Finite(T)
  requires subset : S ⊆ T
  shows cardinality(S) = cardinality(T) ↔ S = T
proof
  constructor
  . intro same
    exact cardinality.eq_subset with finite, subset, same
  . intro equal
    rw equal
    rfl

theorem cardinality.le_of_subset_natural (S : Set) (n : Nat)
  requires subset : S ⊆ n
  shows cardinality(S) ≤ n
proof
  have bound := cardinality.monotone with (Finite.natural at n), subset
  have same := cardinality.natural at n
  rw same at bound
  exact bound

theorem cardinality.le_one_of_subset_singleton (S x : Set)
  requires subset : S ⊆ {x}
  shows cardinality(S) ≤ 1
proof
  have bound := cardinality.monotone with (Finite.singleton at x), subset
  have one := cardinality.singleton at x
  rw one at bound
  exact bound

theorem cardinality.product_count (A B : Set)
  requires finiteA : Finite(A)
  requires finiteB : Finite(B)
  shows cardinality(A × B) = cardinality(A) * cardinality(B)
proof
  have countedA := cardinality.correct with finiteA
  have countedB := cardinality.correct with finiteB
  have product := HasCardinality.product with countedA, countedB
  exact cardinality.eq_of_has with product

theorem cardinality.disjointSum_count (A B : Set)
  requires finiteA : Finite(A)
  requires finiteB : Finite(B)
  shows cardinality(A ⊎ B) = cardinality(A) + cardinality(B)
proof
  have countedA := cardinality.correct with finiteA
  have countedB := cardinality.correct with finiteB
  have sum := HasCardinality.disjointSum with countedA, countedB
  exact cardinality.eq_of_has with sum

theorem powerset.count (A : Set)
  requires finite : Finite(A)
  shows cardinality(𝒫(A)) = 2 ^ cardinality(A)
proof
  have counted := cardinality.correct with finite
  have natA := cardinality.nat with finite
  have power := powerset.cardinality at A, cardinality(A) with counted
  exact cardinality.eq_of_has with power

theorem cardinality.square (A : Set)
  requires finite : Finite(A)
  shows cardinality(A × A) = cardinality(A) * cardinality(A)
proof
  exact cardinality.product_count with finite, finite

theorem cardinality.product_commutative (A B : Set)
  requires finiteA : Finite(A)
  requires finiteB : Finite(B)
  shows cardinality(A × B) = cardinality(B × A)
proof
  have left := cardinality.product_count with finiteA, finiteB
  have right := cardinality.product_count with finiteB, finiteA
  have natA := cardinality.nat with finiteA
  have natB := cardinality.nat with finiteB
  rw [left, right]
  ring

theorem cardinality.subsets_count (A : Set) (k : Nat)
  requires finite : Finite(A)
  shows cardinality(subsetsOfSize(A, k)) = cardinality(A) choose k
proof
  exact combinations.count with finite

theorem subsetsOfSize.finite (A : Set) (k : Nat)
  requires finite : Finite(A)
  shows Finite(subsetsOfSize(A, k))
proof
  have inside : subsetsOfSize(A, k) ⊆ 𝒫(A)
    intros S hS
    have parts := subsetsOfSize.membership.forward with hS
    exact parts.left
  exact Finite.subset with (Finite.powerset with finite), inside
