module Grace.Cumulus.Combinatorics.InclusionExclusion
import Basics

theorem Finite.difference (A B : Set)
  requires finite : Finite(A)
  shows Finite(A ∖ B)
proof
  exact Finite.subset with finite, (difference.subset_left at A, B)

theorem Finite.intersection_left (A B : Set)
  requires finite : Finite(A)
  shows Finite(A ∩ B)
proof
  exact Finite.subset with finite, (intersection.subset_left at A, B)

theorem Finite.intersection_right (A B : Set)
  requires finite : Finite(B)
  shows Finite(A ∩ B)
proof
  exact Finite.subset with finite, (intersection.subset_right at A, B)

theorem Finite.symmetricDifference (A B : Set)
  requires finiteA : Finite(A)
  requires finiteB : Finite(B)
  shows Finite(A △ B)
proof
  unfold symmetricDifference
  exact Finite.union with (Finite.difference at A, B with finiteA),
    (Finite.difference at B, A with finiteB)

-- A finite set splits into the part inside B and the part outside B.
theorem cardinality.difference_add_intersection (A B : Set)
  requires finite : Finite(A)
  shows cardinality(A ∖ B) + cardinality(A ∩ B) = cardinality(A)
proof
  have finiteRest := Finite.difference at A, B with finite
  have finiteMeet := Finite.intersection_left at A, B with finite
  have disjoint : Disjoint(A ∖ B, A ∩ B)
    unfold Disjoint
    ext x
    simp
  have split : (A ∖ B) ∪ (A ∩ B) = A
    ext x
    simp
  have count := cardinality.union_disjoint with finiteRest, finiteMeet, disjoint
  rw split at count
  symm
  exact count

theorem cardinality.difference_count (A B : Set)
  requires finite : Finite(A)
  shows cardinality(A ∖ B) = cardinality(A) - cardinality(A ∩ B)
proof
  have split := cardinality.difference_add_intersection at A, B with finite
  have natRest := cardinality.nat with (Finite.difference at A, B with finite)
  have natMeet := cardinality.nat with (Finite.intersection_left at A, B with
    finite)
  rw ← split
  symm
  exact sub.add_right at cardinality(A ∖ B), cardinality(A ∩ B)

theorem cardinality.intersection_le_left (A B : Set)
  requires finite : Finite(A)
  shows cardinality(A ∩ B) ≤ cardinality(A)
proof
  exact cardinality.monotone with finite, (intersection.subset_left at A, B)

theorem cardinality.intersection_le_right (A B : Set)
  requires finite : Finite(B)
  shows cardinality(A ∩ B) ≤ cardinality(B)
proof
  exact cardinality.monotone with finite, (intersection.subset_right at A, B)

theorem cardinality.difference_le (A B : Set)
  requires finite : Finite(A)
  shows cardinality(A ∖ B) ≤ cardinality(A)
proof
  exact cardinality.monotone with finite, (difference.subset_left at A, B)

theorem cardinality.difference_add_of_subset (A B : Set)
  requires finite : Finite(A)
  requires subset : B ⊆ A
  shows cardinality(A ∖ B) + cardinality(B) = cardinality(A)
proof
  have split := cardinality.difference_add_intersection at A, B with finite
  have meet : A ∩ B = B
    ext x
    simp
  rw meet at split
  exact split

theorem cardinality.difference_of_subset (A B : Set)
  requires finite : Finite(A)
  requires subset : B ⊆ A
  shows cardinality(A ∖ B) = cardinality(A) - cardinality(B)
proof
  have split := cardinality.difference_add_of_subset with finite, subset
  have natRest := cardinality.nat with (Finite.difference at A, B with finite)
  have natB := cardinality.nat with (Finite.subset with finite, subset)
  rw ← split
  symm
  exact sub.add_right at cardinality(A ∖ B), cardinality(B)

theorem cardinality.union_sub (A B : Set)
  requires finiteA : Finite(A)
  requires finiteB : Finite(B)
  shows
    cardinality(A ∪ B) = cardinality(A) + cardinality(B) - cardinality(A ∩ B)
proof
  have both := cardinality.inclusion_exclusion with finiteA, finiteB
  have natUnion := cardinality.nat with (Finite.union with finiteA, finiteB)
  have natMeet := cardinality.nat with (Finite.intersection_left at A, B with
    finiteA)
  rw ← both
  symm
  exact sub.add_right at cardinality(A ∪ B), cardinality(A ∩ B)

theorem cardinality.union_le (A B : Set)
  requires finiteA : Finite(A)
  requires finiteB : Finite(B)
  shows cardinality(A ∪ B) ≤ cardinality(A) + cardinality(B)
proof
  have both := cardinality.inclusion_exclusion with finiteA, finiteB
  have natUnion := cardinality.nat with (Finite.union with finiteA, finiteB)
  have natMeet := cardinality.nat with (Finite.intersection_left at A, B with
    finiteA)
  have natA := cardinality.nat with finiteA
  have natB := cardinality.nat with finiteB
  arith

theorem cardinality.union_ge_left (A B : Set)
  requires finiteA : Finite(A)
  requires finiteB : Finite(B)
  shows cardinality(A) ≤ cardinality(A ∪ B)
proof
  have finiteUnion := Finite.union with finiteA, finiteB
  exact cardinality.monotone with finiteUnion, (union2.subset_left at A, B)

theorem cardinality.union_ge_right (A B : Set)
  requires finiteA : Finite(A)
  requires finiteB : Finite(B)
  shows cardinality(B) ≤ cardinality(A ∪ B)
proof
  have finiteUnion := Finite.union with finiteA, finiteB
  exact cardinality.monotone with finiteUnion, (union2.subset_right at A, B)

theorem cardinality.le_add_of_cover (S A B : Set)
  requires finiteA : Finite(A)
  requires finiteB : Finite(B)
  requires cover : S ⊆ A ∪ B
  shows cardinality(S) ≤ cardinality(A) + cardinality(B)
proof
  have finiteUnion := Finite.union with finiteA, finiteB
  have inside := cardinality.monotone with finiteUnion, cover
  have bound := cardinality.union_le with finiteA, finiteB
  have natS := cardinality.nat with (Finite.subset with finiteUnion, cover)
  have natUnion := cardinality.nat with finiteUnion
  have natA := cardinality.nat with finiteA
  have natB := cardinality.nat with finiteB
  exact LessEqual.transitive with inside, bound

-- The union has the full count exactly when the sets are disjoint.
theorem cardinality.union_eq_add_iff_disjoint (A B : Set)
  requires finiteA : Finite(A)
  requires finiteB : Finite(B)
  shows cardinality(A ∪ B) = cardinality(A) + cardinality(B) ↔ Disjoint(A, B)
proof
  constructor
  . intro full
    have both := cardinality.inclusion_exclusion with finiteA, finiteB
    rw full at both
    have finiteMeet := Finite.intersection_left at A, B with finiteA
    have natMeet := cardinality.nat with finiteMeet
    have natA := cardinality.nat with finiteA
    have natB := cardinality.nat with finiteB
    have zero : cardinality(A ∩ B) = 0
      have le : cardinality(A ∩ B) ≤ 0 by arith
      have ge : 0 ≤ cardinality(A ∩ B) by arith
      exact LessEqual.antisymmetric with le, ge
    have iff := cardinality.eq_zero_iff with finiteMeet
    unfold Disjoint
    exact iff.forward with zero
  . intro disjoint
    exact cardinality.union_disjoint with finiteA, finiteB, disjoint

-- Inclusion–exclusion for three sets.
theorem cardinality.union_three (A B C : Set)
  requires finiteA : Finite(A)
  requires finiteB : Finite(B)
  requires finiteC : Finite(C)
  shows cardinality(A ∪ B ∪ C) + cardinality(A ∩ B) + cardinality(A ∩ C) +
      cardinality(B ∩ C) =
    cardinality(A) + cardinality(B) + cardinality(C) + cardinality(A ∩ B ∩ C)
proof
  have finiteAB := Finite.union with finiteA, finiteB
  have finiteAC := Finite.intersection_left at A, C with finiteA
  have finiteBC := Finite.intersection_left at B, C with finiteB
  have outer := cardinality.inclusion_exclusion with finiteAB, finiteC
  have inner := cardinality.inclusion_exclusion with finiteA, finiteB
  have meetSplit : (A ∪ B) ∩ C = (A ∩ C) ∪ (B ∩ C)
    ext x
    simp
  have meetMeet : (A ∩ C) ∩ (B ∩ C) = A ∩ B ∩ C
    ext x
    simp
  have meets := cardinality.inclusion_exclusion with finiteAC, finiteBC
  rw meetSplit at outer
  rw meetMeet at meets
  have natUnion := cardinality.nat with (Finite.union with finiteAB, finiteC)
  have natAB := cardinality.nat with finiteAB
  have natMeetAB := cardinality.nat with (Finite.intersection_left at A, B with
    finiteA)
  have natAC := cardinality.nat with finiteAC
  have natBC := cardinality.nat with finiteBC
  have natACBC := cardinality.nat with (Finite.union with finiteAC, finiteBC)
  have natABC := cardinality.nat with (Finite.intersection_left at A ∩ B, C with (Finite.intersection_left at A, B with finiteA))
  have natA := cardinality.nat with finiteA
  have natB := cardinality.nat with finiteB
  have natC := cardinality.nat with finiteC
  have le : cardinality(A ∪ B ∪ C) + cardinality(A ∩ B) + cardinality(A ∩ C) + cardinality(B ∩ C) ≤ cardinality(A) + cardinality(B) + cardinality(C) + cardinality(A ∩ B ∩ C) by arith
  have ge : cardinality(A) + cardinality(B) + cardinality(C) + cardinality(A ∩ B ∩ C) ≤ cardinality(A ∪ B ∪ C) + cardinality(A ∩ B) + cardinality(A ∩ C) + cardinality(B ∩ C) by arith
  exact LessEqual.antisymmetric with le, ge

theorem cardinality.union_three_le (A B C : Set)
  requires finiteA : Finite(A)
  requires finiteB : Finite(B)
  requires finiteC : Finite(C)
  shows
    cardinality(A ∪ B ∪ C) ≤ cardinality(A) + cardinality(B) + cardinality(C)
proof
  have finiteAB := Finite.union with finiteA, finiteB
  have first := cardinality.union_le with finiteAB, finiteC
  have second := cardinality.union_le with finiteA, finiteB
  have natABC := cardinality.nat with (Finite.union with finiteAB, finiteC)
  have natAB := cardinality.nat with finiteAB
  have natA := cardinality.nat with finiteA
  have natB := cardinality.nat with finiteB
  have natC := cardinality.nat with finiteC
  arith

theorem cardinality.union_three_disjoint (A B C : Set)
  requires finiteA : Finite(A)
  requires finiteB : Finite(B)
  requires finiteC : Finite(C)
  requires disjointAB : Disjoint(A, B)
  requires disjointAC : Disjoint(A, C)
  requires disjointBC : Disjoint(B, C)
  shows
    cardinality(A ∪ B ∪ C) = cardinality(A) + cardinality(B) + cardinality(C)
proof
  have finiteAB := Finite.union with finiteA, finiteB
  have disjoint : Disjoint(A ∪ B, C)
    have leftFree := Disjoint.iff.forward with disjointAC
    have rightFree := Disjoint.iff.forward with disjointBC
    apply Disjoint.iff.backward
    intros x hx
    have split := union2.membership.forward with hx
    cases split with inA | inB
    . exact leftFree with x, inA
    . exact rightFree with x, inB
  have outer := cardinality.union_disjoint with finiteAB, finiteC, disjoint
  have inner := cardinality.union_disjoint with finiteA, finiteB, disjointAB
  rw [outer, inner]
  rfl

-- The symmetric difference counts each set once and the overlap twice less.
theorem cardinality.symmetricDifference_add (A B : Set)
  requires finiteA : Finite(A)
  requires finiteB : Finite(B)
  shows cardinality(A △ B) + 2 * cardinality(A ∩ B) =
    cardinality(A) + cardinality(B)
proof
  have finiteAB := Finite.difference at A, B with finiteA
  have finiteBA := Finite.difference at B, A with finiteB
  have disjoint : Disjoint(A ∖ B, B ∖ A)
    unfold Disjoint
    ext x
    simp
  have split := cardinality.union_disjoint with finiteAB, finiteBA, disjoint
  have left := cardinality.difference_add_intersection at A, B with finiteA
  have right := cardinality.difference_add_intersection at B, A with finiteB
  have commute := intersection.commutative at B, A
  rw commute at right
  have natAB := cardinality.nat with finiteAB
  have natBA := cardinality.nat with finiteBA
  have natMeet := cardinality.nat with (Finite.intersection_left at A, B with
    finiteA)
  have natA := cardinality.nat with finiteA
  have natB := cardinality.nat with finiteB
  unfold symmetricDifference
  have le : cardinality(A ∖ B) + cardinality(B ∖ A) + 2 * cardinality(A ∩ B) ≤ cardinality(A) + cardinality(B) by arith
  have ge : cardinality(A) + cardinality(B) ≤ cardinality(A ∖ B) + cardinality(B ∖ A) + 2 * cardinality(A ∩ B) by arith
  exact LessEqual.antisymmetric with le, ge

theorem cardinality.symmetricDifference_sub (A B : Set)
  requires finiteA : Finite(A)
  requires finiteB : Finite(B)
  shows cardinality(A △ B) =
    cardinality(A) + cardinality(B) - 2 * cardinality(A ∩ B)
proof
  have split := cardinality.symmetricDifference_add with finiteA, finiteB
  have natSym := cardinality.nat with (Finite.symmetricDifference with
    finiteA, finiteB)
  have natMeet := cardinality.nat with (Finite.intersection_left at A, B with
    finiteA)
  rw ← split
  symm
  exact sub.add_right at cardinality(A △ B), 2 * cardinality(A ∩ B)

theorem cardinality.symmetricDifference_le (A B : Set)
  requires finiteA : Finite(A)
  requires finiteB : Finite(B)
  shows cardinality(A △ B) ≤ cardinality(A) + cardinality(B)
proof
  have split := cardinality.symmetricDifference_add with finiteA, finiteB
  have natSym := cardinality.nat with (Finite.symmetricDifference with
    finiteA, finiteB)
  have natMeet := cardinality.nat with (Finite.intersection_left at A, B with
    finiteA)
  have natA := cardinality.nat with finiteA
  have natB := cardinality.nat with finiteB
  arith

theorem cardinality.symmetricDifference_of_disjoint (A B : Set)
  requires finiteA : Finite(A)
  requires finiteB : Finite(B)
  requires disjoint : Disjoint(A, B)
  shows cardinality(A △ B) = cardinality(A) + cardinality(B)
proof
  have split := cardinality.symmetricDifference_add with finiteA, finiteB
  unfold Disjoint at disjoint
  rw [disjoint, cardinality.empty] at split
  have natSym := cardinality.nat with (Finite.symmetricDifference with
    finiteA, finiteB)
  have zero : 2 * 0 = 0 by compute
  rw zero at split
  have natA := cardinality.nat with finiteA
  have natB := cardinality.nat with finiteB
  have shape : cardinality(A △ B) + 0 = cardinality(A △ B) by ring
  rw shape at split
  exact split

-- Removing a subset of known size.
theorem cardinality.difference_lt_of_member (A B b : Set)
  requires finite : Finite(A)
  requires inA : b ∈ A
  requires inB : b ∈ B
  shows cardinality(A ∖ B) < cardinality(A)
proof
  have absent : ¬b ∈ A ∖ B
    intro h
    have parts := difference.membership.forward with h
    exact parts.right with inB
  exact cardinality.strict with finite, (difference.subset_left at A, B), inA, absent

theorem cardinality.difference_eq_iff_disjoint (A B : Set)
  requires finite : Finite(A)
  shows cardinality(A ∖ B) = cardinality(A) ↔ Disjoint(A, B)
proof
  constructor
  . intro same
    have equal := cardinality.eq_subset with finite,
      (difference.subset_left at A, B), same
    apply Disjoint.iff.backward
    intros x hx inB
    rw ← equal at hx
    have parts := difference.membership.forward with hx
    exact parts.right with inB
  . intro disjoint
    have same : A ∖ B = A
      have free := Disjoint.iff.forward with disjoint
      ext x
      constructor
      . intro hx
        exact difference.subset_left at A, B with x, hx
      . intro hx
        apply difference.membership.backward
        exact ⟨hx, (free with x, hx)⟩
    rw same
    rfl
