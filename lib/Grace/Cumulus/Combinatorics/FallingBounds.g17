-- Bounds and divisibility for the falling factorial: it is at most n ^ m,
-- vanishes exactly above the diagonal, is a multiple of m!, splits at an
-- intermediate stage as a product of two falling factorials, divides n!,
-- and grows with its first argument
-- Part of Cumulus, the Grace17 mathematics library.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module Grace.Cumulus.Combinatorics.FallingBounds
import Catalan

theorem fallingFactorial.le_pow (n m : Nat)
  shows fallingFactorial(n, m) ≤ n ^ m
proof
  induction m
  | zero =>
    rw [fallingFactorial.zero, pow.zero]
    exact LessEqual.reflexive at 1
  | j + 1 using ih =>
    rw [fallingFactorial.succ, pow.succ_right]
    have factor := sub.le_self at n, j
    have natural := fallingFactorial.natural at n, j
    have powNat := pow.closed at n, j
    have subNat := sub.closed at n, j
    exact LessEqual.mul with ih, factor

theorem fallingFactorial.positive (n m : Nat)
  requires le : m ≤ n
  shows 0 < fallingFactorial(n, m)
proof
  have form := fallingFactorial.choose with le
  rw form
  have first := choose.positive with le
  have second := factorial.positive at m
  have cNat := choose.natural at n, m
  have closed := factorial.closed at m
  exact Less.mul_positive with first, second

theorem fallingFactorial.eq_zero_iff (n m : Nat)
  shows fallingFactorial(n, m) = 0 ↔ n < m
proof
  constructor
  . intro zero
    by_contra notBelow
    have le := LessEqual.of_not_Less with notBelow
    have positive := fallingFactorial.positive with le
    rw zero at positive
    exact Less.irreflexive at 0 with positive
  . intro below
    exact fallingFactorial.of_Less with below

theorem fallingFactorial.ne_zero_iff (n m : Nat)
  shows fallingFactorial(n, m) ≠ 0 ↔ m ≤ n
proof
  constructor
  . intro nonzero
    by_contra notLe
    have below := Less.of_not_LessEqual with notLe
    exact nonzero with (fallingFactorial.of_Less with below)
  . intro le
    intro zero
    have positive := fallingFactorial.positive with le
    rw zero at positive
    exact Less.irreflexive at 0 with positive

theorem fallingFactorial.positive_iff (n m : Nat)
  shows 0 < fallingFactorial(n, m) ↔ m ≤ n
proof
  constructor
  . intro positive
    have natural := fallingFactorial.natural at n, m
    have nonzero := Less.ne_zero_of_positive with positive
    have iff := fallingFactorial.ne_zero_iff at n, m
    exact iff.forward with nonzero
  . intro le
    exact fallingFactorial.positive with le

-- The factorial form holds without restriction: above the diagonal both
-- sides vanish.
theorem fallingFactorial.choose_mul (n k : Nat)
  shows fallingFactorial(n, k) = (n choose k) * k!
proof
  have alternatives := Less.or_LessEqual at n, k
  cases alternatives with below | le
  . have vanish := fallingFactorial.of_Less with below
    have vanishChoose := choose.above_diagonal with below
    rw [vanish, vanishChoose]
    have closed := factorial.closed at k
    ring
  . exact fallingFactorial.choose with le

theorem choose.mul_factorial (n k : Nat)
  shows (n choose k) * k! = fallingFactorial(n, k)
proof
  symm
  exact fallingFactorial.choose_mul at n, k

theorem fallingFactorial.factorial_divides (n m : Nat)
  shows m! ∣ fallingFactorial(n, m)
proof
  rw fallingFactorial.choose_mul
  have cNat := choose.natural at n, m
  have closed := factorial.closed at m
  witness n choose m
  ring

-- Splitting the falling factorial at an intermediate stage.
theorem fallingFactorial.add (n m k : Nat)
  shows fallingFactorial(n, m + k) =
    fallingFactorial(n, m) * fallingFactorial(n - m, k)
proof
  induction k
  | zero =>
    have shape : m + 0 = m by ring
    rw [shape, fallingFactorial.zero]
    have natural := fallingFactorial.natural at n, m
    ring
  | j + 1 using ih =>
    have shape : m + (j + 1) = (m + j) + 1 by ring
    rw [shape, fallingFactorial.succ, ih, fallingFactorial.succ, sub.sub]
    have natural := fallingFactorial.natural at n, m
    have subNat := sub.closed at n, m
    have inner := fallingFactorial.natural at n - m, j
    have subNatJ := sub.closed at n - m, j
    ring

theorem fallingFactorial.divides_add (n m k : Nat)
  shows fallingFactorial(n, m) ∣ fallingFactorial(n, m + k)
proof
  rw fallingFactorial.add
  have subNat := sub.closed at n, m
  have inner := fallingFactorial.natural at n - m, k
  have natural := fallingFactorial.natural at n, m
  witness fallingFactorial(n - m, k)
  rfl

theorem fallingFactorial.divides_of_le (n m k : Nat)
  requires le : m ≤ k
  shows fallingFactorial(n, m) ∣ fallingFactorial(n, k)
proof
  obtain ⟨d, dNat, shape⟩ := le
  rw ← shape
  exact fallingFactorial.divides_add at n, m, d

-- fallingFactorial(n, m) · (n − m)! = n! below the diagonal.
theorem fallingFactorial.mul_factorial_sub (n m : Nat)
  requires le : m ≤ n
  shows fallingFactorial(n, m) * (n - m)! = n!
proof
  obtain ⟨d, dNat, shape⟩ := le
  have difference : n - m = d
    rw ← shape
    exact sub.add_left at d, m
  rw [difference, ← shape]
  have row := fallingFactorial.mul_factorial at m
  exact row with d, dNat

theorem fallingFactorial.divides_factorial (n m : Nat)
  requires le : m ≤ n
  shows fallingFactorial(n, m) ∣ n!
proof
  have form := fallingFactorial.mul_factorial_sub with le
  rw ← form
  have subNat := sub.closed at n, m
  have closed := factorial.closed at n - m
  have natural := fallingFactorial.natural at n, m
  witness (n - m)!
  rfl

theorem fallingFactorial.le_factorial (n m : Nat)
  requires le : m ≤ n
  shows fallingFactorial(n, m) ≤ n!
proof
  have divides := fallingFactorial.divides_factorial with le
  have nonzero := factorial.nonzero at n
  have natural := fallingFactorial.natural at n, m
  have closed := factorial.closed at n
  exact divides.le with divides, nonzero

theorem fallingFactorial.two (n : Nat)
  shows fallingFactorial(n, 2) = n * (n - 1)
proof
  have two : 1 + 1 = 2 by compute
  rw ← two
  rw [fallingFactorial.succ, fallingFactorial.one]
  rfl

-- The falling factorial grows with its first argument.
theorem fallingFactorial.le_succ_left (n m : Nat)
  shows fallingFactorial(n, m) ≤ fallingFactorial(n + 1, m)
proof
  have split := natural.zero_or_successor at m
  cases split with isZero | isSucc
  . rw [isZero, fallingFactorial.zero, fallingFactorial.zero]
    exact LessEqual.reflexive at 1
  . obtain ⟨j, jNat, shape⟩ := isSucc
    have hj : succ(j) = j + 1
      symm
      exact add.right_one at j
    rw [shape, hj, fallingFactorial.succ, fallingFactorial.succ_succ]
    have natural := fallingFactorial.natural at n, j
    have subNat := sub.closed at n, j
    have factor : n - j ≤ n + 1
      have self := sub.le_self at n, j
      arith
    have scaled := LessEqual.mul_left at n - j, n + 1, fallingFactorial(n, j)
      with factor
    have commute : (n + 1) * fallingFactorial(n, j) =
      fallingFactorial(n, j) * (n + 1) by ring
    rw commute
    exact scaled

theorem fallingFactorial.le_add_left (n d m : Nat)
  shows fallingFactorial(n, m) ≤ fallingFactorial(n + d, m)
proof
  induction d
  | zero =>
    have shape : n + 0 = n by ring
    rw shape
    have natural := fallingFactorial.natural at n, m
    exact LessEqual.reflexive at fallingFactorial(n, m)
  | j + 1 using ih =>
    have shape : n + (j + 1) = (n + j) + 1 by ring
    rw shape
    have step := fallingFactorial.le_succ_left at n + j, m
    have aNat := fallingFactorial.natural at n, m
    have bNat := fallingFactorial.natural at n + j, m
    have cNat := fallingFactorial.natural at n + j + 1, m
    exact LessEqual.transitive with ih, step

theorem fallingFactorial.monotone_left (n k m : Nat)
  requires le : n ≤ k
  shows fallingFactorial(n, m) ≤ fallingFactorial(k, m)
proof
  obtain ⟨d, dNat, shape⟩ := le
  rw ← shape
  exact fallingFactorial.le_add_left at n, d, m

-- The binomial coefficient is bounded by the power n ^ k.
theorem choose.le_pow_base (n k : Nat)
  shows n choose k ≤ n ^ k
proof
  have cNat := choose.natural at n, k
  have closed := factorial.closed at k
  have nonzero := factorial.nonzero at k
  have grow := LessEqual.le_mul_right at n choose k, k! with nonzero
  rw choose.mul_factorial at grow
  have bound := fallingFactorial.le_pow at n, k
  have natural := fallingFactorial.natural at n, k
  have powNat := pow.closed at n, k
  exact LessEqual.transitive with grow, bound

-- There are no more injections than functions.
theorem injections.count_le (A B : Set)
  requires finiteA : Finite(A)
  requires finiteB : Finite(B)
  shows cardinality(injections(A, B)) ≤ cardinality(functionSpace(A, B))
proof
  have left := injections.count with finiteA, finiteB
  have right := functionSpace.count with finiteA, finiteB
  rw [left, right]
  have aNat := cardinality.nat with finiteA
  have bNat := cardinality.nat with finiteB
  exact fallingFactorial.le_pow at cardinality(B), cardinality(A)
