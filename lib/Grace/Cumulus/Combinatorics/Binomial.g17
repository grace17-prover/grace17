-- Authors: Grant Passmore

module Grace.Cumulus.Combinatorics.Binomial
import Pigeonhole
import NumberTheory.BinomialVanishing

theorem natural.positive_of_nonzero (n : Nat)
  requires nonzero : n ≠ 0
  shows 0 < n
proof
  have split := natural.zero_or_successor at n
  cases split with isZero | isSucc
  . exfalso
    exact nonzero with isZero
  . obtain ⟨k, kNat, shape⟩ := isSucc
    rw shape
    arith

theorem natural.nonzero_of_positive (n : Nat)
  requires positive : 0 < n
  shows n ≠ 0
proof
  intro zero
  rw zero at positive
  exact Less.irreflexive at 0 with positive

theorem choose.natural (n k : Nat)
  shows Nat(n choose k)
proof
  typecheck

-- Pascal's rule with successors written as additions.
theorem choose.pascal (n k : Nat)
  shows (n + 1) choose (k + 1) = (n choose k) + (n choose (k + 1))
proof
  have hn : n + 1 = succ(n) := add.right_one with *
  have hk : k + 1 = succ(k) := add.right_one with *
  rw [hn, hk]
  exact choose.succ_succ at n, k

theorem choose.one_right (n : Nat)
  shows n choose 1 = n
proof
  induction n
  | zero => compute
  | k + 1 using ih =>
    have step := choose.pascal at k, 0
    have one : 0 + 1 = 1 by compute
    rw one at step
    rw [step, choose.zero_right, ih]
    ring

theorem choose.succ_self (n : Nat)
  shows (n + 1) choose n = n + 1
proof
  induction n
  | zero => compute
  | k + 1 using ih =>
    have step := choose.pascal at k + 1, k
    rw [step, ih, choose.diagonal]
    rfl

theorem choose.above_diagonal (n k : Nat)
  requires below : n < k
  shows n choose k = 0
proof
  obtain ⟨d, dNat, shape⟩ := below
  have form : k = succ(n + d)
    rw ← shape
    ring
  rw form
  have le : n ≤ n + d by arith
  exact choose.vanishes at n, n + d with le

theorem choose.eq_zero_iff (n k : Nat)
  shows n choose k = 0 ↔ n < k
proof
  constructor
  . intro zero
    by_contra notBelow
    have le := LessEqual.of_not_Less with notBelow
    obtain ⟨d, dNat, shape⟩ := le
    have form : n = d + k
      rw ← shape
      ring
    rw form at zero
    have row := choose.factorial at d
    have identity := row with k, assumption
    rw zero at identity
    have nonzero := factorial.nonzero at d + k
    apply nonzero
    rw ← identity
    ring
  . intro below
    exact choose.above_diagonal with below

theorem choose.ne_zero_iff (n k : Nat)
  shows n choose k ≠ 0 ↔ k ≤ n
proof
  constructor
  . intro nonzero
    by_contra notLe
    have below := Less.of_not_LessEqual with notLe
    exact nonzero with (choose.above_diagonal with below)
  . intro le
    intro zero
    have iff := choose.eq_zero_iff at n, k
    have below := iff.forward with zero
    have strict := Less.transitive_LessEqual with below, le
    exact Less.irreflexive at n with strict

theorem choose.positive (n k : Nat)
  requires le : k ≤ n
  shows 0 < n choose k
proof
  have iff := choose.ne_zero_iff at n, k
  have nonzero := iff.backward with le
  have chooseNat := choose.natural at n, k
  exact natural.positive_of_nonzero at n choose k with nonzero

theorem choose.positive_iff (n k : Nat)
  shows 0 < n choose k ↔ k ≤ n
proof
  constructor
  . intro positive
    have iff := choose.ne_zero_iff at n, k
    have chooseNat := choose.natural at n, k
    have nonzero := natural.nonzero_of_positive at n choose k with positive
    exact iff.forward with nonzero
  . intro le
    exact choose.positive with le

-- Symmetry of Pascal's triangle, in the form that needs no subtraction.
theorem choose.add_symmetric (m k : Nat)
  shows (m + k) choose k = (m + k) choose m
proof
  have rowM := choose.factorial at m
  have first := rowM with k, assumption
  have rowK := choose.factorial at k
  have second := rowK with m, assumption
  have commute : k + m = m + k by ring
  rw commute at second
  have factorialK := factorial.closed at k
  have factorialM := factorial.closed at m
  have swap : m! * k! = k! * m! by ring
  rw swap at second
  rw ← second at first
  have productNonzero := mul.nonzero with
    (factorial.nonzero at k), (factorial.nonzero at m)
  have leftNat := choose.natural at m + k, k
  have rightNat := choose.natural at m + k, m
  have balanced : (k! * m!) * ((m + k) choose k) = (k! * m!) * ((m + k) choose m) by ring [first]
  exact mul.left_cancel_positive with productNonzero, balanced

theorem choose.symmetric (n k : Nat)
  requires le : k ≤ n
  shows n choose k = n choose (n - k)
proof
  obtain ⟨d, dNat, shape⟩ := le
  have form : n = d + k
    rw ← shape
    ring
  have difference : n - k = d
    rw form
    exact sub.add_right at d, k
  rw [difference, form]
  exact choose.add_symmetric at d, k

theorem choose.sub_self (n : Nat)
  shows ∀ k, Nat(k) → k ≤ n → n choose (n - k) = n choose k
proof
  intros k kNat le
  symm
  exact choose.symmetric with le

-- The factorial form n choose k · k! · (n − k)! = n!.
theorem choose.factorial_form (n k : Nat)
  requires le : k ≤ n
  shows (n choose k) * (k! * (n - k)!) = n!
proof
  obtain ⟨d, dNat, shape⟩ := le
  have form : n = d + k
    rw ← shape
    ring
  have difference : n - k = d
    rw form
    exact sub.add_right at d, k
  rw [difference, form]
  have row := choose.factorial at d
  exact row with k, assumption

theorem choose.two (n : Nat)
  shows 2 * ((n + 1) choose 2) = (n + 1) * n
proof
  induction n
  | zero => compute
  | k + 1 using ih =>
    have step := choose.pascal at k + 1, 1
    have two : 1 + 1 = 2 by compute
    rw two at step
    rw [step, choose.one_right]
    have chooseNat := choose.natural at k + 1, 2
    ring [ih]

theorem choose.two_sub (n : Nat)
  shows 2 * (n choose 2) = n * (n - 1)
proof
  have split := natural.zero_or_successor at n
  cases split with isZero | isSucc
  . rw isZero
    compute
  . obtain ⟨k, kNat, shape⟩ := isSucc
    have one : succ(k) = k + 1
      symm
      exact add.right_one at k
    rw [shape, one]
    have difference : k + 1 - 1 = k := sub.add_right at k, 1
    rw difference
    exact choose.two at k

-- Absorption: (k + 1) · (n + 1 choose k + 1) = (n + 1) · (n choose k).
theorem choose.absorption (n : Nat)
  shows
    ∀ k, Nat(k) → (k + 1) * ((n + 1) choose (k + 1)) = (n + 1) * (n choose k)
proof
  induction n
  | zero =>
    intros k kNat
    have split := natural.zero_or_successor at k
    cases split with isZero | isSucc
    . rw isZero
      compute
    . obtain ⟨j, jNat, shape⟩ := isSucc
      rw shape
      have vanishTop : (0 + 1) choose (succ(j) + 1) = 0
        have le : 0 + 1 ≤ succ(j) by arith
        have hs : succ(j) + 1 = succ(succ(j)) := add.right_one with *
        rw hs
        exact choose.vanishes at 0 + 1, succ(j) with le
      have vanishBottom : 0 choose succ(j) = 0 := choose.zero_left at j
      rw [vanishTop, vanishBottom]
      ring
  | m + 1 using ih =>
    intros k kNat
    have split := natural.zero_or_successor at k
    cases split with isZero | isSucc
    . rw isZero
      have top := choose.pascal at m + 1, 0
      have one : 0 + 1 = 1 by compute
      rw one at top
      rw [one, top, choose.zero_right, choose.one_right]
      ring
    . obtain ⟨j, jNat, shape⟩ := isSucc
      have hj : succ(j) = j + 1
        symm
        exact add.right_one at j
      rw [shape, hj]
      have top := choose.pascal at m + 1, j + 1
      have first := ih with j, jNat
      have sjNat : Nat(j + 1) by typecheck
      have second := ih with j + 1, sjNat
      have inner := choose.pascal at m, j
      have aNat := choose.natural at m + 1, j + 1
      have bNat := choose.natural at m + 1, j + 1 + 1
      have pNat := choose.natural at m, j
      have qNat := choose.natural at m, j + 1
      rw top
      ring [second, first, inner]

theorem choose.absorption_at (n k : Nat)
  shows (k + 1) * ((n + 1) choose (k + 1)) = (n + 1) * (n choose k)
proof
  have all := choose.absorption at n
  exact all with k, assumption

-- Each row of Pascal's triangle is pointwise below the next.
theorem choose.monotone_row (n k : Nat)
  shows n choose k ≤ (n + 1) choose k
proof
  have split := natural.zero_or_successor at k
  cases split with isZero | isSucc
  . rw [isZero, choose.zero_right, choose.zero_right]
    exact LessEqual.reflexive at 1
  . obtain ⟨j, jNat, shape⟩ := isSucc
    have hj : succ(j) = j + 1
      symm
      exact add.right_one at j
    rw [shape, hj, choose.pascal]
    have leftNat := choose.natural at n, j
    have rightNat := choose.natural at n, j + 1
    arith

-- Partial sums along a row of Pascal's triangle.
def chooseRowSum (n k : Nat) → Nat
  | n, zero => 0
  | n, succ(k) => chooseRowSum(n, k) + choose(n, k)
  descends k

theorem chooseRowSum.zero (n : Nat)
  shows chooseRowSum(n, 0) = 0
proof
  simp [chooseRowSum]

theorem chooseRowSum.succ (n k : Nat)
  shows chooseRowSum(n, k + 1) = chooseRowSum(n, k) + (n choose k)
proof
  have hk : k + 1 = succ(k) := add.right_one with *
  rw hk
  simp [chooseRowSum]

theorem chooseRowSum.natural (n k : Nat)
  shows Nat(chooseRowSum(n, k))
proof
  induction k
  | zero =>
    rw chooseRowSum.zero
    typecheck
  | j + 1 using ih =>
    rw chooseRowSum.succ
    have chooseNat := choose.natural at n, j
    typecheck

theorem chooseRowSum.one (n : Nat)
  shows chooseRowSum(n, 1) = 1
proof
  simp [chooseRowSum, choose.zero_right]
  compute

theorem chooseRowSum.pascal (n k : Nat)
  shows chooseRowSum(n + 1, k + 1) = chooseRowSum(n, k) + chooseRowSum(n, k + 1)
proof
  induction k
  | zero =>
    have one : 0 + 1 = 1 by compute
    rw [one, chooseRowSum.one, chooseRowSum.zero, chooseRowSum.one]
    compute
  | j + 1 using ih =>
    have top := chooseRowSum.succ at n + 1, j + 1
    have pascalRule := choose.pascal at n, j
    have right := chooseRowSum.succ at n, j + 1
    have left := chooseRowSum.succ at n, j
    have sumNat := chooseRowSum.natural at n, j
    have sumNat1 := chooseRowSum.natural at n, j + 1
    have cNat := choose.natural at n, j
    have cNat1 := choose.natural at n, j + 1
    rw [top, ih, pascalRule, right]
    ring [left]

theorem chooseRowSum.monotone (n k d : Nat)
  shows chooseRowSum(n, k) ≤ chooseRowSum(n, k + d)
proof
  induction d
  | zero =>
    have shape : k + 0 = k by ring
    rw shape
    have sumNat := chooseRowSum.natural at n, k
    exact LessEqual.reflexive at chooseRowSum(n, k)
  | j + 1 using ih =>
    have shape : k + (j + 1) = (k + j) + 1 by ring
    rw [shape, chooseRowSum.succ]
    have sumNat := chooseRowSum.natural at n, k
    have sumNatJ := chooseRowSum.natural at n, k + j
    have cNat := choose.natural at n, k + j
    arith

theorem chooseRowSum.term_le (n k m : Nat)
  requires below : k < m
  shows n choose k ≤ chooseRowSum(n, m)
proof
  induction m
  | zero =>
    intro below
    have cNat := choose.natural at n, k
    arith
  | j + 1 using ih =>
    intro below
    rw chooseRowSum.succ
    have sumNat := chooseRowSum.natural at n, j
    have cNat := choose.natural at n, k
    have cNatJ := choose.natural at n, j
    have alternatives : k = j ∨ k ≠ j by tauto
    cases alternatives with same | different
    . rw same
      arith
    . have hj : j + 1 = succ(j) := add.right_one with *
      rw hj at below
      have strict := Less.of_successor_upper_ne with below, different
      have bound := ih with strict
      arith

-- The row sums: the full row adds up to 2 ^ n.
theorem chooseRowSum.full (n : Nat)
  shows chooseRowSum(n, n + 1) = 2 ^ n
proof
  induction n
  | zero =>
    have one : 0 + 1 = 1 by compute
    rw [one, chooseRowSum.one, pow.zero]
    rfl
  | k + 1 using ih =>
    rw chooseRowSum.pascal
    have expand := chooseRowSum.succ at k, k + 1
    rw [expand, ih]
    have below : k < k + 1 by arith
    have vanish := choose.above_diagonal with below
    rw vanish
    have hs : k + 1 = succ(k) := add.right_one with *
    rw [hs, pow.succ]
    have powNat := pow.closed at 2, k
    ring

theorem chooseRowSum.beyond (n d : Nat)
  shows chooseRowSum(n, n + 1 + d) = 2 ^ n
proof
  induction d
  | zero =>
    have shape : n + 1 + 0 = n + 1 by ring
    rw shape
    exact chooseRowSum.full at n
  | j + 1 using ih =>
    have shape : n + 1 + (j + 1) = (n + 1 + j) + 1 by ring
    rw [shape, chooseRowSum.succ, ih]
    have below : n < n + 1 + j by arith
    have vanish := choose.above_diagonal with below
    rw vanish
    have powNat := pow.closed at 2, n
    ring

theorem choose.le_pow (n k : Nat)
  shows n choose k ≤ 2 ^ n
proof
  have powNat := pow.closed at 2, n
  have cNat := choose.natural at n, k
  have alternatives := LessEqual.total at k, n
  cases alternatives with le | ge
  . have below : k < n + 1 by arith
    have bound := chooseRowSum.term_le at n, k, n + 1 with below
    rw chooseRowSum.full at bound
    exact bound
  . have split : k = n ∨ k ≠ n by tauto
    cases split with same | different
    . rw same
      have below : n < n + 1 by arith
      have bound := chooseRowSum.term_le at n, n, n + 1 with below
      rw chooseRowSum.full at bound
      exact bound
    . have strict : n < k
        obtain ⟨d, dNat, shape⟩ := ge
        have dSplit := natural.zero_or_successor at d
        cases dSplit with dZero | dSucc
        . exfalso
          apply different
          rw [dZero] at shape
          rw ← shape
          ring
        . obtain ⟨e, eNat, dShape⟩ := dSucc
          rw dShape at shape
          rw ← shape
          arith
      have vanish := choose.above_diagonal with strict
      rw vanish
      arith

-- Partial sums down a diagonal of Pascal's triangle.
def diagonalSum (k m : Nat) → Nat
  | k, zero => 0
  | k, succ(m) => diagonalSum(k, m) + choose(m + k, k)
  descends m

theorem diagonalSum.zero (k : Nat)
  shows diagonalSum(k, 0) = 0
proof
  simp [diagonalSum]

theorem diagonalSum.succ (k m : Nat)
  shows diagonalSum(k, m + 1) = diagonalSum(k, m) + ((m + k) choose k)
proof
  have hm : m + 1 = succ(m) := add.right_one with *
  rw hm
  simp [diagonalSum]

theorem diagonalSum.natural (k m : Nat)
  shows Nat(diagonalSum(k, m))
proof
  induction m
  | zero =>
    rw diagonalSum.zero
    typecheck
  | j + 1 using ih =>
    rw diagonalSum.succ
    have cNat := choose.natural at j + k, k
    typecheck

-- The hockey-stick identity.
theorem diagonalSum.hockey_stick (k m : Nat)
  shows diagonalSum(k, m) = (m + k) choose (k + 1)
proof
  induction m
  | zero =>
    have shape : 0 + k = k by ring
    rw [diagonalSum.zero, shape]
    have below : k < k + 1 by arith
    symm
    exact choose.above_diagonal with below
  | j + 1 using ih =>
    rw [diagonalSum.succ, ih]
    have shape : j + 1 + k = (j + k) + 1 by ring
    rw [shape, choose.pascal]
    have leftNat := choose.natural at j + k, k
    have rightNat := choose.natural at j + k, k + 1
    ring

theorem factorial.one
  shows 1! = 1
proof
  compute

theorem factorial.two
  shows 2! = 2
proof
  compute

theorem factorial.positive (n : Nat)
  shows 0 < n!
proof
  have nonzero := factorial.nonzero at n
  have closed := factorial.closed at n
  exact natural.positive_of_nonzero at n! with nonzero

theorem factorial.ge_one (n : Nat)
  shows 1 ≤ n!
proof
  have positive := factorial.positive at n
  have closed := factorial.closed at n
  arith

theorem factorial.monotone (n : Nat)
  shows n! ≤ (n + 1)!
proof
  rw factorial.succ
  have closed := factorial.closed at n
  have expand : (n + 1) * n! = n * n! + n! by ring
  rw expand
  have productNat : Nat(n * n!) by typecheck
  arith

theorem factorial.le_of_le (m d : Nat)
  shows m! ≤ (m + d)!
proof
  induction d
  | zero =>
    have shape : m + 0 = m by ring
    rw shape
    have closed := factorial.closed at m
    exact LessEqual.reflexive at m!
  | j + 1 using ih =>
    have shape : m + (j + 1) = (m + j) + 1 by ring
    rw shape
    have step := factorial.monotone at m + j
    have closedM := factorial.closed at m
    have closedJ := factorial.closed at m + j
    have closedTop := factorial.closed at m + j + 1
    exact LessEqual.transitive with ih, step
