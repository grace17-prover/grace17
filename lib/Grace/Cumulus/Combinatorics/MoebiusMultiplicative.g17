-- Multiplicativity of the Möbius function: a product of coprime squarefree
-- numbers is squarefree, the prime divisors of a product are the union of
-- the prime divisors of the factors, disjoint for coprime factors, and
-- μ(a · b) = μ(a) · μ(b) whenever gcd(a, b) = 1
-- Part of Cumulus, the Grace17 mathematics library.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module Grace.Cumulus.Combinatorics.MoebiusMultiplicative
import Moebius

theorem Squarefree.mul (a b : Nat)
  requires squarefreeA : Squarefree(a)
  requires squarefreeB : Squarefree(b)
  requires coprime : gcd(a, b) = 1
  shows Squarefree(a * b)
proof
  intros q qMember qPrime square
  have qNat := nat.omega.backward with qMember
  have qDivides := divides.of_mul_left with square
  have alternatives := Prime.divides_mul with qPrime, qDivides
  cases alternatives with dividesA | dividesB
  . have notB : ¬(q ∣ b)
      intro dividesB
      have one := coprime.divisor_one with coprime, dividesA, dividesB
      exact Prime.ne_one with qPrime, one
    have coprimeQB := Prime.gcd_of_not_divides with qPrime, notB
    have characterization := coprime.mul_iff at q, q, b
    have coprimeSquare := characterization.backward with ⟨coprimeQB, coprimeQB⟩
    have coprimeSym := coprime.symmetric with coprimeSquare
    have squareDividesA := coprime.cancel_right with coprimeSym, square
    have absent := Squarefree.not_divides with squarefreeA, qPrime
    exact absent with squareDividesA
  . have notA : ¬(q ∣ a)
      intro dividesA
      have one := coprime.divisor_one with coprime, dividesA, dividesB
      exact Prime.ne_one with qPrime, one
    have coprimeQA := Prime.gcd_of_not_divides with qPrime, notA
    have characterization := coprime.mul_iff at q, q, a
    have coprimeSquare := characterization.backward with ⟨coprimeQA, coprimeQA⟩
    have coprimeSym := coprime.symmetric with coprimeSquare
    have commuted : a * b = b * a by ring
    rw commuted at square
    have squareDividesB := coprime.cancel_right with coprimeSym, square
    have absent := Squarefree.not_divides with squarefreeB, qPrime
    exact absent with squareDividesB

theorem primeDivisors.mul (a b : Nat)
  requires nonzeroA : a ≠ 0
  requires nonzeroB : b ≠ 0
  shows primeDivisors(a * b) = primeDivisors(a) ∪ primeDivisors(b)
proof
  have productNonzero : a * b ≠ 0
    intro zero
    have characterization := mul.eq_zero_iff at a, b
    have alternatives := characterization.forward with zero
    cases alternatives with aZero | bZero
    . exact nonzeroA with aZero
    . exact nonzeroB with bZero
  ext q
  constructor
  . intro member
    have both := primeDivisors.membership.forward with member
    have inDivisors := both.left
    have qPrime := both.right
    have qNat := divisors.natural with inDivisors
    have factor := divisors.divides with inDivisors
    have alternatives := Prime.divides_mul with qPrime, factor
    apply union2.membership.backward
    cases alternatives with dividesA | dividesB
    . left
      have below := divides.le with dividesA, nonzeroA
      have characterization := divisors.membership_le at a, q
      have inA := characterization.backward with ⟨below, dividesA⟩
      have membershipA := primeDivisors.membership at a, q
      exact membershipA.backward with ⟨inA, qPrime⟩
    . right
      have below := divides.le with dividesB, nonzeroB
      have characterization := divisors.membership_le at b, q
      have inB := characterization.backward with ⟨below, dividesB⟩
      have membershipB := primeDivisors.membership at b, q
      exact membershipB.backward with ⟨inB, qPrime⟩
  . intro member
    have alternatives := union2.membership.forward with member
    have membershipProduct := primeDivisors.membership at a * b, q
    cases alternatives with inA | inB
    . have both := primeDivisors.membership.forward with inA
      have inDivisors := both.left
      have qPrime := both.right
      have qNat := divisors.natural with inDivisors
      have factor := divisors.divides with inDivisors
      have multiple := divides.mul_left_self at a, b
      have chained := divides.transitive with factor, multiple
      have below := divides.le with chained, productNonzero
      have characterization := divisors.membership_le at a * b, q
      have inProduct := characterization.backward with ⟨below, chained⟩
      exact membershipProduct.backward with ⟨inProduct, qPrime⟩
    . have both := primeDivisors.membership.forward with inB
      have inDivisors := both.left
      have qPrime := both.right
      have qNat := divisors.natural with inDivisors
      have factor := divisors.divides with inDivisors
      have multiple := divides.mul_right_self at b, a
      have chained := divides.transitive with factor, multiple
      have below := divides.le with chained, productNonzero
      have characterization := divisors.membership_le at a * b, q
      have inProduct := characterization.backward with ⟨below, chained⟩
      exact membershipProduct.backward with ⟨inProduct, qPrime⟩

theorem primeDivisors.disjoint (a b : Nat)
  requires coprime : gcd(a, b) = 1
  shows Disjoint(primeDivisors(a), primeDivisors(b))
proof
  apply Disjoint.iff.backward
  intros q inA inB
  have bothA := primeDivisors.membership.forward with inA
  have bothB := primeDivisors.membership.forward with inB
  have qNat := divisors.natural with bothA.left
  have qPrime := bothA.right
  have dividesA := divisors.divides with bothA.left
  have dividesB := divisors.divides with bothB.left
  have one := coprime.divisor_one with coprime, dividesA, dividesB
  exact Prime.ne_one with qPrime, one

theorem primeDivisorCount.mul_coprime (a b : Nat)
  requires nonzeroA : a ≠ 0
  requires nonzeroB : b ≠ 0
  requires coprime : gcd(a, b) = 1
  shows primeDivisorCount(a * b) = primeDivisorCount(a) + primeDivisorCount(b)
proof
  have same := primeDivisors.mul with nonzeroA, nonzeroB
  have disjoint := primeDivisors.disjoint with coprime
  have finiteA := primeDivisors.finite at a
  have finiteB := primeDivisors.finite at b
  have count := cardinality.union_disjoint with finiteA, finiteB, disjoint
  unfold primeDivisorCount
  cc

-- The Möbius function is multiplicative.
theorem moebius.multiplicative (a b : Nat)
  requires coprime : gcd(a, b) = 1
  shows moebius(a * b) = integerMulValue(moebius(a), moebius(b))
proof
  have aInteger := moebius.integer at a
  have bInteger := moebius.integer at b
  have alternativesA : Squarefree(a) ∨ ¬Squarefree(a) by tauto
  cases alternativesA with squarefreeA | notA
  . have alternativesB : Squarefree(b) ∨ ¬Squarefree(b) by tauto
    cases alternativesB with squarefreeB | notB
    . have nonzeroA := Squarefree.nonzero with squarefreeA
      have nonzeroB := Squarefree.nonzero with squarefreeB
      have squarefreeProduct := Squarefree.mul with squarefreeA, squarefreeB,
        coprime
      have valueA := moebius.of_squarefree with squarefreeA
      have valueB := moebius.of_squarefree with squarefreeB
      have valueProduct := moebius.of_squarefree with squarefreeProduct
      have count := primeDivisorCount.mul_coprime with nonzeroA, nonzeroB,
        coprime
      have countA := primeDivisorCount.natural at a
      have countB := primeDivisorCount.natural at b
      have split := integerPow.add at -integerOne, primeDivisorCount(a),
        primeDivisorCount(b)
      rw [valueProduct, count, split, valueA, valueB]
      rfl
    . have notProduct : ¬Squarefree(a * b)
        intro squarefreeProduct
        have multiple := divides.mul_right_self at b, a
        have squarefreeB := Squarefree.of_divides with squarefreeProduct,
          multiple
        exact notB with squarefreeB
      have valueB := moebius.of_not_squarefree with notB
      have valueProduct := moebius.of_not_squarefree with notProduct
      rw [valueProduct, valueB]
      ring
  . have notProduct : ¬Squarefree(a * b)
      intro squarefreeProduct
      have multiple := divides.mul_left_self at a, b
      have squarefreeA := Squarefree.of_divides with squarefreeProduct, multiple
      exact notA with squarefreeA
    have valueA := moebius.of_not_squarefree with notA
    have valueProduct := moebius.of_not_squarefree with notProduct
    rw [valueProduct, valueA]
    ring
