-- The alternative for parity systems: a system is solvable exactly when no
-- left-kernel vector sees an odd right-hand side, proved by eliminating one
-- column at a time at a pivot row, which preserves obstructions and lifts
-- solutions.
-- Part of Cumulus, the Grace17 mathematics library.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module Grace.Cumulus.Combinatorics.ParityAlternative
import ParitySystems

-- Section: Elimination.

-- Elimination of the column c at a pivot row p meeting it: the pivot row is
-- added to every other row meeting c, and then the row p and the column c
-- are deleted. The right-hand side follows the rows.
def pivoted (A R C p c : Set) : Set :=
  ((R ∖ {p}) × (C ∖ {c})) ∩ (A △ (cofiber(A, R, c) × fiber(A, C, p)))

def pivotRows (A R b p c : Set) : Set := { r ∈ cofiber(A, R, c) | p ∈ b }

def pivotedSide (A R b p c : Set) : Set :=
  (R ∖ {p}) ∩ (b △ pivotRows(A, R, b, p, c))

theorem pivoted.subset (A R C p c : Set)
  shows pivoted(A, R, C, p, c) ⊆ R × (C ∖ {c})
proof
  intros q hq
  unfold pivoted at hq
  have parts := intersection.membership.forward with hq
  obtain ⟨_, r, hr, x, hx, rfl⟩ := product.membership.forward with parts.left
  have row : r ∈ R := (difference.singleton_membership.forward with hr).left
  exact product.pair with row, hx

theorem pivotedSide.subset (A R b p c : Set)
  shows pivotedSide(A, R, b, p, c) ⊆ R
proof
  intros r hr
  unfold pivotedSide at hr
  have parts := intersection.membership.forward with hr
  exact (difference.singleton_membership.forward with parts.left).left

-- The rows of the pivoted matrix, met by a set t of the remaining columns:
-- a row missing c is unchanged, a row meeting c has the pivot row added.
theorem pivoted.row_unchanged (A R C p c r t : Set)
  requires row : r ∈ R
  requires other : r ≠ p
  requires missing : ¬(r, c) ∈ A
  requires inside : t ⊆ C ∖ {c}
  shows fiber(pivoted(A, R, C, p, c), C ∖ {c}, r) ∩ t = fiber(A, C, r) ∩ t
proof
  ext x
  simp [pivoted, fiber.membership, cofiber.membership, intersection.membership,
    difference.singleton_membership, product.pair_membership,
    symmetricDifference.membership]

theorem pivoted.row_added (A R C p c r t : Set)
  requires row : r ∈ R
  requires other : r ≠ p
  requires meets : (r, c) ∈ A
  requires inside : t ⊆ C ∖ {c}
  shows fiber(pivoted(A, R, C, p, c), C ∖ {c}, r) ∩ t =
    (fiber(A, C, r) ∩ t) △ (fiber(A, C, p) ∩ t)
proof
  ext x
  simp [pivoted, fiber.membership, cofiber.membership, intersection.membership,
    difference.singleton_membership, product.pair_membership,
    symmetricDifference.membership]

-- The columns, met by a set y of rows: a column missing the pivot row is
-- unchanged off p, a column meeting it has the column c added.
theorem pivoted.column_unchanged (A R C p c x y : Set)
  requires column : x ∈ C ∖ {c}
  requires missing : ¬(p, x) ∈ A
  requires rows : y ⊆ R
  shows cofiber(pivoted(A, R, C, p, c), R, x) ∩ y =
    cofiber(A, R, x) ∩ (y ∖ {p})
proof
  ext r
  simp [pivoted, fiber.membership, cofiber.membership, intersection.membership,
    difference.singleton_membership, product.pair_membership,
    symmetricDifference.membership]

theorem pivoted.column_added (A R C p c x y : Set)
  requires column : x ∈ C ∖ {c}
  requires meets : (p, x) ∈ A
  requires rows : y ⊆ R
  shows cofiber(pivoted(A, R, C, p, c), R, x) ∩ y =
    (cofiber(A, R, x) ∩ (y ∖ {p})) △ (cofiber(A, R, c) ∩ (y ∖ {p}))
proof
  ext r
  simp [pivoted, fiber.membership, cofiber.membership, intersection.membership,
    difference.singleton_membership, product.pair_membership,
    symmetricDifference.membership]

-- The pivoted right-hand side: a row r ≠ p is set when b and the correction
-- by the pivot row disagree.
theorem pivotedSide.member (A R b p c r : Set)
  requires row : r ∈ R
  requires other : r ≠ p
  shows r ∈ pivotedSide(A, R, b, p, c) ↔ ¬(r ∈ b ↔ ((r, c) ∈ A ∧ p ∈ b))
proof
  simp [pivotedSide, pivotRows, cofiber.membership, intersection.membership,
    difference.singleton_membership, symmetricDifference.membership]

theorem pivotedSide.rows_unset (A R b p c y : Set)
  requires rows : y ⊆ R
  requires unset : ¬p ∈ b
  shows y ∩ pivotedSide(A, R, b, p, c) = b ∩ (y ∖ {p})
proof
  ext r
  simp [pivotedSide, pivotRows, cofiber.membership, intersection.membership,
    difference.singleton_membership, symmetricDifference.membership]

theorem pivotedSide.rows_set (A R b p c y : Set)
  requires rows : y ⊆ R
  requires pivotSet : p ∈ b
  shows y ∩ pivotedSide(A, R, b, p, c) =
    (b ∩ (y ∖ {p})) △ (cofiber(A, R, c) ∩ (y ∖ {p}))
proof
  ext r
  simp [pivotedSide, pivotRows, cofiber.membership, intersection.membership,
    difference.singleton_membership, symmetricDifference.membership]

-- A solution t of the pivoted system extends to one of the original: the
-- rows other than p are satisfied by t as they were, and c is added to t
-- exactly when the pivot row asks for it.
theorem pivoted.extend (A R C b p c t : Set)
  requires finiteColumns : Finite(C)
  requires column : c ∈ C
  requires pivotRow : p ∈ R
  requires pivot : (p, c) ∈ A
  requires solution :
    Solves(pivoted(A, R, C, p, c), R, C ∖ {c}, pivotedSide(A, R, b, p, c), t)
  shows ∃ s, Solves(A, R, C, b, s)
proof
  have inside := solution.left
  have finiteT : Finite(t) :=
    Finite.subset with (Finite.difference with finiteColumns), inside
  have fresh : ¬c ∈ t
    intro hc
    have bad := inside with c, hc
    simp at bad
  have inPivot : c ∈ fiber(A, C, p) := ⟨column, pivot⟩
  have extend : ∀ X ⊆ {c},
      (EvenSet(fiber(A, C, p) ∩ t) ↔ (c ∈ X ↔ p ∈ b)) →
      Solves(A, R, C, b, t ∪ X)
    intros X part fixed
    constructor
    . simp
    . intros r hr
      rw EvenSet.intersection_union_part with finiteT, part, fresh
      have inRow : c ∈ fiber(A, C, r) ↔ (r, c) ∈ A by simp [column]
      by_cases same : r = p
      . rw same
        tauto
      . have reduced := solution.right with r, hr
        rw pivotedSide.member with hr, same at reduced
        by_cases meets : (r, c) ∈ A
        . have finiteRow : Finite(fiber(A, C, r) ∩ t) :=
            Finite.subset with finiteT, intersection.subset_right
          have finitePivot : Finite(fiber(A, C, p) ∩ t) :=
            Finite.subset with finiteT, intersection.subset_right
          rw [(pivoted.row_added with hr, same, meets, inside),
            (EvenSet.symmetricDifference with finiteRow, finitePivot)]
            at reduced
          tauto
        . rw pivoted.row_unchanged with hr, same, meets, inside at reduced
          tauto
  by_cases fixed : EvenSet(fiber(A, C, p) ∩ t) ↔ ¬p ∈ b
  . witness t ∪ ∅
    have choice : EvenSet(fiber(A, C, p) ∩ t) ↔ (c ∈ ∅ ↔ p ∈ b) by simp
    exact extend with ∅, empty.subset, choice
  . witness t ∪ {c}
    have choice : EvenSet(fiber(A, C, p) ∩ t) ↔ (c ∈ {c} ↔ p ∈ b) by simp
    exact extend with {c}, Subset.reflexive, choice

-- An obstruction y of the pivoted system lifts to one of the original: the
-- columns other than c are even over y ∖ {p} as they were, and p is added
-- exactly when the column c is odd there.
theorem pivoted.lift (A R C b p c y : Set)
  requires finiteRows : Finite(R)
  requires pivotRow : p ∈ R
  requires pivot : (p, c) ∈ A
  requires obstruction : Obstructs(pivoted(A, R, C, p, c), R, C ∖ {c},
    pivotedSide(A, R, b, p, c), y)
  shows ∃ z, Obstructs(A, R, C, b, z)
proof
  have rows := obstruction.left
  have finiteRest : Finite(y ∖ {p}) :=
    Finite.difference with (Finite.subset with finiteRows, rows)
  have fresh : ¬p ∈ y ∖ {p} by simp
  have finitePivot : Finite(cofiber(A, R, c) ∩ (y ∖ {p})) :=
    Finite.subset with finiteRest, intersection.subset_right
  have inPivot : p ∈ cofiber(A, R, c) := ⟨pivotRow, pivot⟩
  have lift : ∀ Y ⊆ {p},
      (EvenSet(cofiber(A, R, c) ∩ (y ∖ {p})) ↔ ¬p ∈ Y) →
      Obstructs(A, R, C, b, (y ∖ {p}) ∪ Y)
    intros Y part pivotColumn
    refine ⟨?_, ?_, ?_⟩
    . simp
    . intros x hx
      rw EvenSet.intersection_union_part with finiteRest, part, fresh
      have inColumn : p ∈ cofiber(A, R, x) ↔ (p, x) ∈ A by simp [pivotRow]
      by_cases same : x = c
      . rw same
        tauto
      . have column : x ∈ C ∖ {c} by simp [hx, same]
        have reduced := obstruction.right.left with x, column
        by_cases meets : (p, x) ∈ A
        . have finiteColumn : Finite(cofiber(A, R, x) ∩ (y ∖ {p})) :=
            Finite.subset with finiteRest, intersection.subset_right
          rw [(pivoted.column_added with column, meets, rows),
            (EvenSet.symmetricDifference with finiteColumn, finitePivot)]
            at reduced
          tauto
        . rw pivoted.column_unchanged with column, meets, rows at reduced
          tauto
    . have reduced := obstruction.right.right
      have finiteSide : Finite(b ∩ (y ∖ {p})) :=
        Finite.subset with finiteRest, intersection.subset_right
      rw [intersection.commutative,
        (EvenSet.intersection_union_part with finiteRest, part, fresh)]
      by_cases pivotSet : p ∈ b
      . rw [(pivotedSide.rows_set with rows, pivotSet),
          (EvenSet.symmetricDifference with finiteSide, finitePivot)]
          at reduced
        tauto
      . rw pivotedSide.rows_unset with rows, pivotSet at reduced
        tauto
  by_cases evenColumn : EvenSet(cofiber(A, R, c) ∩ (y ∖ {p}))
  . witness (y ∖ {p}) ∪ ∅
    have choice : EvenSet(cofiber(A, R, c) ∩ (y ∖ {p})) ↔ ¬p ∈ ∅ by simp
    exact lift with ∅, empty.subset, choice
  . witness (y ∖ {p}) ∪ {p}
    have choice : EvenSet(cofiber(A, R, c) ∩ (y ∖ {p})) ↔ ¬p ∈ {p} by simp
    exact lift with {p}, Subset.reflexive, choice

-- Elimination of a column c: the rows of A meeting c are added to a pivot
-- row, and a solution of the reduced system extends by choosing c. A column
-- no row meets is simply dropped.
theorem paritySystem.eliminate (A R C b c : Set)
  requires finiteRows : Finite(R)
  requires finiteColumns : Finite(C)
  requires matrix : A ⊆ R × C
  requires column : c ∈ C
  requires unobstructed : ¬(∃ y, Obstructs(A, R, C, b, y))
  shows ∃ B, ∃ d, B ⊆ R × (C ∖ {c}) ∧ d ⊆ R ∧
    ¬(∃ y, Obstructs(B, R, C ∖ {c}, d, y)) ∧
    (∀ t, Solves(B, R, C ∖ {c}, d, t) → ∃ s, Solves(A, R, C, b, s))
proof
  by_cases pivot : ∃ p ∈ R, (p, c) ∈ A
  . obtain ⟨p, pivotRow, meets⟩ := pivot
    refine ⟨pivoted(A, R, C, p, c), pivotedSide(A, R, b, p, c),
      pivoted.subset, pivotedSide.subset, ?_, ?_⟩
    . intro obstructed
      obtain ⟨y, obstruction⟩ := obstructed
      exact unobstructed
        with (pivoted.lift with finiteRows, pivotRow, meets, obstruction)
    . intros t solution
      exact pivoted.extend
        with finiteColumns, column, pivotRow, meets, solution
  . have noPivot : ∀ r ∈ R, ¬(r, c) ∈ A
      intros r hr hrc
      exact pivot with ⟨r, hr, hrc⟩
    refine ⟨A, b ∩ R, ?_, intersection.subset_right, ?_, ?_⟩
    . -- The column c of A is empty.
      intros q hq
      obtain ⟨_, r, hr, x, hx, rfl⟩ :=
        product.membership.forward with (matrix with q, hq)
      have other : x ≠ c
        intro same
        rw same at hq
        exact noPivot with r, hr, hq
      exact product.pair with hr, (difference.singleton_membership.backward
        with ⟨hx, other⟩)
    . -- An obstruction of the reduced system obstructs A, c being even.
      intro obstructed
      obtain ⟨y, obstruction⟩ := obstructed
      have rows := obstruction.left
      apply unobstructed
      witness y
      refine ⟨rows, ?_, ?_⟩
      . intros x hx
        by_cases same : x = c
        . have none : cofiber(A, R, c) ∩ y = ∅ by ext r; simp [noPivot]
          rw [same, none]
          exact EvenSet.empty
        . have remaining : x ∈ C ∖ {c} by simp [hx, same]
          exact obstruction.right.left with x, remaining
      . have same : y ∩ (b ∩ R) = y ∩ b by ext r; simp
        rw ← same
        exact obstruction.right.right
    . -- A solution of the reduced system solves A.
      intros t solution
      witness t
      have inside := solution.left
      constructor
      . intros x hx
        exact (inside with x, hx).left
      . intros r hr
        have reduced := solution.right with r, hr
        have same : fiber(A, C ∖ {c}, r) ∩ t = fiber(A, C, r) ∩ t by ext x; simp
        rw same at reduced
        rw reduced
        simp [hr]

-- Section: The alternative.

-- Eliminating the columns one at a time: an unobstructed system over no
-- columns has the empty solution, since a row r ∈ b would obstruct by
-- itself.
theorem paritySystem.solvable (R C : Set)
  requires finiteRows : Finite(R)
  requires finiteColumns : Finite(C)
  shows ∀ A, ∀ b, A ⊆ R × C → ¬(∃ y, Obstructs(A, R, C, b, y)) →
    ∃ t, Solves(A, R, C, b, t)
proof
  induction finiteColumns with G c
  | empty =>
    intros A b matrix unobstructed
    witness ∅
    constructor
    . simp
    . intros r hr
      have none : fiber(A, ∅, r) ∩ ∅ = ∅ by ext x; simp
      have absent : ¬r ∈ b
        intro hrb
        apply unobstructed
        witness {r}
        refine ⟨singleton.subset_iff.backward with hr, ?_, ?_⟩
        . intros x hx
          simp at hx
        . rw EvenSet.singleton_intersection
          tauto
      rw none
      simp [EvenSet.empty, absent]
  | insert using ih =>
    intros A b matrix unobstructed
    have column : c ∈ G ∪ {c} by simp
    have finiteStep : Finite(G ∪ {c}) :=
      Finite.union with GFinite, Finite.singleton
    obtain ⟨B, d, reducedMatrix, _, reducedUnobstructed, extension⟩ :=
      paritySystem.eliminate
        with finiteRows, finiteStep, matrix, column, unobstructed
    have same : (G ∪ {c}) ∖ {c} = G by ext x; simp [cFresh]
    rw same at reducedMatrix
    rw under same at reducedUnobstructed, extension
    obtain ⟨t, solution⟩ := ih with B, d, reducedMatrix, reducedUnobstructed
    exact extension with t, solution

theorem paritySystem.alternative (A R C b : Set)
  requires finiteRows : Finite(R)
  requires finiteColumns : Finite(C)
  requires matrix : A ⊆ R × C
  requires side : b ⊆ R
  shows (∃ t, Solves(A, R, C, b, t)) ↔ ¬(∃ y, Obstructs(A, R, C, b, y))
proof
  constructor
  . intros solvable obstructed
    obtain ⟨t, solution⟩ := solvable
    obtain ⟨y, obstruction⟩ := obstructed
    exact Solves.not_obstructed
      with finiteRows, finiteColumns, matrix, solution, obstruction
  . intro unobstructed
    have solvable := paritySystem.solvable with finiteRows, finiteColumns
    exact solvable with A, b, matrix, unobstructed
