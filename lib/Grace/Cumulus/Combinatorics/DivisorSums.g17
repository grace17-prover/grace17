-- Sums over the divisors of a natural number: ∑_{d ∣ n} w(d) for an
-- integer-valued weight w, its value at n = 1, congruence, scaling,
-- vanishing, restriction to a support, the complementary divisor d ↦ n / d
-- as an involution of divisors(n) with the reflection of a divisor sum along
-- it, the Dirichlet summands a(d) · b(n / d), and the summatory function
-- Part of Cumulus, the Grace17 mathematics library.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module Grace.Cumulus.Combinatorics.DivisorSums
import IntegerSum
import NumberTheory

-- Arithmetic of the quotient of a number by one of its divisors.
theorem divides.quotient_ne_zero (d n : Nat)
  requires nonzero : n ≠ 0
  requires factor : d ∣ n
  shows quotientNat(n, d) ≠ 0
proof
  have dNonzero := divides.nonzero with factor, nonzero
  have equation := divides.quotient_equation with dNonzero, factor
  intro zero
  rw zero at equation
  have product : d * 0 = 0 by ring
  have same : n = 0 by cc
  exact nonzero with same

theorem quotientNat.mul_left (a b : Nat)
  requires nonzero : a ≠ 0
  shows quotientNat(a * b, a) = b
proof
  have factor := divides.mul_left_self at a, b
  have equation := divides.quotient_equation with nonzero, factor
  symm
  exact mul.left_cancel_positive with nonzero, equation

theorem quotientNat.complement (d n : Nat)
  requires nonzero : n ≠ 0
  requires factor : d ∣ n
  shows quotientNat(n, quotientNat(n, d)) = d
proof
  have dNonzero := divides.nonzero with factor, nonzero
  have equation := divides.quotient_equation with dNonzero, factor
  have quotientNonzero := divides.quotient_ne_zero with nonzero, factor
  have commuted := mul.commutative at d, quotientNat(n, d)
  have shape : n = quotientNat(n, d) * d by cc
  have reduced := quotientNat.mul_left at quotientNat(n, d), d with
    quotientNonzero
  cc

theorem divides.mul_iff_quotient (d e n : Nat)
  requires nonzero : n ≠ 0
  requires factor : d ∣ n
  shows d * e ∣ n ↔ e ∣ quotientNat(n, d)
proof
  have dNonzero := divides.nonzero with factor, nonzero
  have equation := divides.quotient_equation with dNonzero, factor
  have cancel := divides.mul_cancel_left at d, e, quotientNat(n, d) with
    dNonzero
  rw ← equation at cancel
  exact cancel

theorem divisors.quotient_member (n d : Nat)
  requires nonzero : n ≠ 0
  requires member : d ∈ divisors(n)
  shows quotientNat(n, d) ∈ divisors(n)
proof
  have factor := divisors.divides with member
  have dNonzero := divides.nonzero with factor, nonzero
  have quotientDivides := divides.quotient with dNonzero, factor
  have below := divides.le with quotientDivides, nonzero
  have characterization := divisors.membership_le at n, quotientNat(n, d)
  exact characterization.backward with ⟨below, quotientDivides⟩

theorem divisors.quotient_subset (n d : Nat)
  requires nonzero : n ≠ 0
  requires factor : d ∣ n
  shows divisors(quotientNat(n, d)) ⊆ divisors(n)
proof
  have dNonzero := divides.nonzero with factor, nonzero
  have quotientDivides := divides.quotient with dNonzero, factor
  exact divisors.subset_of_divides with nonzero, quotientDivides

-- The sum ∑_{d ∣ n} w(d) of an integer-valued weight over the divisors of n.
def divisorSum (n : Nat, w : Set) : Set := integerSetSum(divisors(n), w)

theorem divisorSum.integer (n : Nat, w : Set)
  requires weights : w : ℕ → ℤ
  shows Integer(divisorSum(n, w))
proof
  have finite := divisors.finite at n
  have subset := divisors.subset_naturals at n
  have total := integerSetSum.integer with finite, weights, subset
  unfold divisorSum
  exact total

theorem divisorSum.one (w : Set)
  requires weights : w : ℕ → ℤ
  shows divisorSum(1, w) = w(1)
proof
  have oneNat : Nat(1) by typecheck
  have oneMember := nat.omega.forward with oneNat
  have single := integerSetSum.singleton with weights, oneMember
  have same := divisors.one
  unfold divisorSum
  cc

theorem divisorSum.congr (n : Nat, w v : Set)
  requires weightsW : w : ℕ → ℤ
  requires weightsV : v : ℕ → ℤ
  requires values : ∀ d ∈ divisors(n), w(d) = v(d)
  shows divisorSum(n, w) = divisorSum(n, v)
proof
  have subset := divisors.subset_naturals at n
  have same := integerSetSum.congr with weightsW, weightsV, subset, values
  unfold divisorSum
  cc

theorem divisorSum.scale (n : Nat, w v : Set) (a : Integer)
  requires weightsW : w : ℕ → ℤ
  requires weightsV : v : ℕ → ℤ
  requires values : ∀ d ∈ divisors(n), v(d) = integerMulValue(a, w(d))
  shows divisorSum(n, v) = integerMulValue(a, divisorSum(n, w))
proof
  have finite := divisors.finite at n
  have subset := divisors.subset_naturals at n
  have scaled := integerSetSum.scale with finite, weightsW, weightsV, subset,
    values
  unfold divisorSum
  cc

theorem divisorSum.zero (n : Nat, w : Set)
  requires weights : w : ℕ → ℤ
  requires values : ∀ d ∈ divisors(n), w(d) = integerZero
  shows divisorSum(n, w) = integerZero
proof
  have finite := divisors.finite at n
  have subset := divisors.subset_naturals at n
  have vanishing := integerSetSum.zero with finite, weights, subset, values
  unfold divisorSum
  cc

theorem divisorSum.support (n : Nat, S w : Set)
  requires weights : w : ℕ → ℤ
  requires inner : S ⊆ divisors(n)
  requires vanishes : ∀ d ∈ divisors(n), ¬(d ∈ S) → w(d) = integerZero
  shows divisorSum(n, w) = integerSetSum(S, w)
proof
  have finite := divisors.finite at n
  have subset := divisors.subset_naturals at n
  have restricted := integerSetSum.support with finite, weights, subset, inner,
    vanishes
  unfold divisorSum
  cc

-- A weight vanishing at every proper divisor of n sums to its value at n.
theorem divisorSum.single (n : Nat, w : Set)
  requires weights : w : ℕ → ℤ
  requires vanishes : ∀ d ∈ divisors(n), d ≠ n → w(d) = integerZero
  shows divisorSum(n, w) = w(n)
proof
  have self := divisors.self_member at n
  have inner : {n} ⊆ divisors(n) by simp
  have nNat : Nat(n) by typecheck
  have nMember := nat.omega.forward with nNat
  have outside : ∀ d ∈ divisors(n), ¬(d ∈ {n}) → w(d) = integerZero
    intros d hd absent
    have different : d ≠ n
      intro same
      apply absent
      rw same
      simp
    exact vanishes with d, hd, different
  have restricted := divisorSum.support with weights, inner, outside
  have single := integerSetSum.singleton with weights, nMember
  rw [restricted, single]
  rfl

-- The complementary divisor n / d of a divisor d of n.
defgraph complementaryDivisor (n : Nat) (d ∈ divisors(n)) : divisors(n) :=
  quotientNat(n, d)
requires nonzero : n ≠ 0
proof
  have dNat := divisors.natural with member
  exact divisors.quotient_member with nonzero, member

theorem complementaryDivisor.involution (n : Nat)
  requires nonzero : n ≠ 0
  shows InvolutionOn(complementaryDivisor(n), divisors(n))
proof
  have function := complementaryDivisor.function at n with nonzero
  refine ⟨function, _⟩
  intros d hd
  have dNat := divisors.natural with hd
  have factor := divisors.divides with hd
  have image := divisors.quotient_member with nonzero, hd
  have first := complementaryDivisor.value at n, d with nonzero, hd
  have second := complementaryDivisor.value at n, quotientNat(n, d) with
    nonzero, image
  have twice := quotientNat.complement with nonzero, factor
  rw [first, second, twice]
  rfl

theorem complementaryDivisor.bijective (n : Nat)
  requires nonzero : n ≠ 0
  shows BijectiveBetween(complementaryDivisor(n), divisors(n), divisors(n))
proof
  have involution := complementaryDivisor.involution with nonzero
  exact InvolutionOn.bijective with involution

-- The weight d ↦ w(n / d).
defgraph complementaryWeights (n : Nat) (w : Set) (d ∈ ℕ) : ℤ :=
  w(quotientNat(n, d))
requires weights : w : ℕ → ℤ
proof
  have dNat := nat.omega.backward with member
  have quotientNatural := quotientNat.natural at d, n
  have quotientMember := nat.omega.forward with quotientNatural
  exact FunctionBetween.apply_closed with weights, quotientMember

-- Summing w(n / d) over the divisors d of n is summing w over them.
theorem divisorSum.reflect (n : Nat, w : Set)
  requires nonzero : n ≠ 0
  requires weights : w : ℕ → ℤ
  shows divisorSum(n, complementaryWeights(n, w)) = divisorSum(n, w)
proof
  have finite := divisors.finite at n
  have subset := divisors.subset_naturals at n
  have reflected := complementaryWeights.function at n, w with weights
  have bijective := complementaryDivisor.bijective with nonzero
  have values : ∀ d ∈ divisors(n),
      complementaryWeights(n, w)(d) = w(complementaryDivisor(n)(d))
    intros d hd
    have dMember := subset with d, hd
    have value := complementaryWeights.value at n, w, d with weights
    have image := complementaryDivisor.value at n, d with nonzero, hd
    cc
  have sum := integerSetSum.reindex at divisors(n), divisors(n), ℕ, ℕ,
    complementaryWeights(n, w), w, complementaryDivisor(n) with finite,
      reflected, weights, subset, subset, bijective, values
  unfold divisorSum
  cc

-- The summands a(d) · b(n / d) of a Dirichlet convolution at n.
defgraph dirichletTerms (a b : Set) (n : Nat) (d ∈ ℕ) : ℤ :=
  integerMulValue(a(d), b(quotientNat(n, d)))
requires weightsA : a : ℕ → ℤ
requires weightsB : b : ℕ → ℤ
proof
  have dNat := nat.omega.backward with member
  have quotientNatural := quotientNat.natural at d, n
  have quotientMember := nat.omega.forward with quotientNatural
  have left := FunctionBetween.apply_closed with weightsA, member
  have right := FunctionBetween.apply_closed with weightsB, quotientMember
  exact integerMulValue.integer at a(d), b(quotientNat(n, d)) with *

-- The summatory function n ↦ ∑_{d ∣ n} w(d) of an integer-valued weight.
defgraph summatory (w : Set) (n ∈ ℕ) : ℤ := divisorSum(n, w)
requires weights : w : ℕ → ℤ
proof
  have nNat := nat.omega.backward with member
  exact divisorSum.integer with weights
