-- Counting injections: the falling factorial n · (n − 1) ⋯ (n − m + 1)
-- counts the injections from an m-element set into an n-element set, and
-- the bijections between two n-element sets number n!
-- Part of Cumulus, the Grace17 mathematics library.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module Grace.Cumulus.Combinatorics.Injections
import Functions

def injections (A B : Set) : Set :=
  { f ∈ functionSpace(A, B) | InjectiveBetween(f, A, B) }

theorem injections.of_injective (f A B : Set)
  requires injective : InjectiveBetween(f, A, B)
  shows f ∈ injections(A, B)
proof
  have function := Injective.function with injective
  have inSpace := functionSpace.mem_iff.backward with function
  exact injections.membership.backward with ⟨inSpace, injective⟩

theorem injections.injective (f A B : Set)
  requires member : f ∈ injections(A, B)
  shows InjectiveBetween(f, A, B)
proof
  have parts := injections.membership.forward with member
  exact parts.right

theorem injections.function (f A B : Set)
  requires member : f ∈ injections(A, B)
  shows f : A → B
proof
  exact Injective.function with (injections.injective with member)

theorem injections.subset (A B : Set)
  shows injections(A, B) ⊆ functionSpace(A, B)
proof
  intros f hf
  have parts := injections.membership.forward with hf
  exact parts.left

theorem injections.finite (A B : Set)
  requires finiteA : Finite(A)
  requires finiteB : Finite(B)
  shows Finite(injections(A, B))
proof
  have space := functionSpace.finite with finiteA, finiteB
  exact Finite.subset with space, (injections.subset at A, B)

theorem injections.empty_domain (B : Set)
  shows injections(∅, B) = {∅}
proof
  have emptyFunction := FunctionBetween.empty at B
  have emptyInjective : InjectiveBetween(∅, ∅, B)
    unfold InjectiveBetween
    refine ⟨emptyFunction, ?_⟩
    intros u impossible
    exfalso
    exact set.empty with impossible
  ext f
  constructor
  . intro member
    have parts := injections.membership.forward with member
    have inSpace := parts.left
    rw functionSpace.empty_domain at inSpace
    exact inSpace
  . intro member
    have equal := singleton.membership.forward with member
    rw equal
    exact injections.of_injective with emptyInjective

theorem injections.empty_domain_count (B : Set)
  shows cardinality(injections(∅, B)) = 1
proof
  rw injections.empty_domain
  exact cardinality.singleton at ∅

theorem injections.empty_codomain (A : Set)
  requires nonempty : Nonempty(A)
  shows injections(A, ∅) = ∅
proof
  have empty := functionSpace.empty_codomain with nonempty
  have subset := injections.subset at A, ∅
  rw empty at subset
  exact Subset.empty_iff.forward with subset

-- The falling factorial n · (n − 1) ⋯ (n − m + 1), zero once m exceeds n.
def fallingFactorial (n m : Nat) → Nat
  | n, zero => 1
  | n, succ(m) => mul(fallingFactorial(n, m), sub(n, m))
  descends m

theorem fallingFactorial.zero (n : Nat)
  shows fallingFactorial(n, 0) = 1
proof
  simp [fallingFactorial]

theorem fallingFactorial.succ (n m : Nat)
  shows fallingFactorial(n, m + 1) = fallingFactorial(n, m) * (n - m)
proof
  have hm : m + 1 = succ(m) := add.right_one with *
  rw hm
  simp [fallingFactorial]

theorem fallingFactorial.natural (n m : Nat)
  shows Nat(fallingFactorial(n, m))
proof
  induction m
  | zero =>
    rw fallingFactorial.zero
    typecheck
  | j + 1 using ih =>
    rw fallingFactorial.succ
    have subNat := sub.closed at n, j
    typecheck

theorem fallingFactorial.one (n : Nat)
  shows fallingFactorial(n, 1) = n
proof
  have one : 0 + 1 = 1 by compute
  rw ← one
  rw [fallingFactorial.succ, fallingFactorial.zero, sub.zero_right]
  ring

theorem fallingFactorial.zero_left (m : Nat)
  shows fallingFactorial(0, m + 1) = 0
proof
  rw [fallingFactorial.succ, sub.zero_left]
  have natural := fallingFactorial.natural at 0, m
  ring

-- The recursion on the first argument, free of subtraction.
theorem fallingFactorial.succ_succ (n m : Nat)
  shows fallingFactorial(n + 1, m + 1) = (n + 1) * fallingFactorial(n, m)
proof
  induction m
  | zero =>
    have one : 0 + 1 = 1 by compute
    rw [one, fallingFactorial.one, fallingFactorial.zero]
    ring
  | j + 1 using ih =>
    rw [fallingFactorial.succ, ih]
    have hn : n + 1 = succ(n) := add.right_one with *
    have hj : j + 1 = succ(j) := add.right_one with *
    rw [hn, hj, sub.succ_succ, ← hj]
    rw fallingFactorial.succ
    have natural := fallingFactorial.natural at n, j
    have subNat := sub.closed at n, j
    ring

theorem fallingFactorial.self (n : Nat)
  shows fallingFactorial(n, n) = n!
proof
  induction n
  | zero => compute
  | k + 1 using ih =>
    rw [fallingFactorial.succ_succ, ih, factorial.succ]
    rfl

theorem fallingFactorial.self_vanishes (n : Nat)
  shows fallingFactorial(n, n + 1) = 0
proof
  rw fallingFactorial.succ
  have shape : 0 + n = n by ring
  have difference : n - n = 0
    have step := sub.add_right at 0, n
    rw shape at step
    exact step
  rw difference
  have natural := fallingFactorial.natural at n, n
  ring

theorem fallingFactorial.beyond (n d : Nat)
  shows fallingFactorial(n, n + 1 + d) = 0
proof
  induction d
  | zero =>
    have shape : n + 1 + 0 = n + 1 by ring
    rw shape
    exact fallingFactorial.self_vanishes at n
  | j + 1 using ih =>
    have shape : n + 1 + (j + 1) = (n + 1 + j) + 1 by ring
    rw [shape, fallingFactorial.succ, ih]
    have subNat := sub.closed at n, n + 1 + j
    ring

theorem fallingFactorial.of_Less (n m : Nat)
  requires below : n < m
  shows fallingFactorial(n, m) = 0
proof
  obtain ⟨d, dNat, shape⟩ := below
  have form : m = n + 1 + d
    rw ← shape
    ring
  rw form
  exact fallingFactorial.beyond at n, d

theorem fallingFactorial.mul_factorial (k : Nat)
  shows ∀ d, Nat(d) → fallingFactorial(k + d, k) * d! = (k + d)!
proof
  induction k
  | zero =>
    intros d dNat
    have shape : 0 + d = d by ring
    rw [shape, fallingFactorial.zero]
    have closed := factorial.closed at d
    ring
  | j + 1 using ih =>
    intros d dNat
    have shape : j + 1 + d = (j + d) + 1 by ring
    rw [shape, fallingFactorial.succ_succ]
    have inner := ih with d, dNat
    rw factorial.succ
    have natural := fallingFactorial.natural at j + d, j
    have closedD := factorial.closed at d
    have closedTop := factorial.closed at j + d
    ring [inner]

-- The falling factorial is the binomial coefficient times k!.
theorem fallingFactorial.choose (n k : Nat)
  requires le : k ≤ n
  shows fallingFactorial(n, k) = (n choose k) * k!
proof
  obtain ⟨d, dNat, shape⟩ := le
  have form : n = k + d
    rw ← shape
    rfl
  rw form
  have row := fallingFactorial.mul_factorial at k
  have first := row with d, dNat
  have commute : k + d = d + k by ring
  have chooseRow := choose.factorial at d
  have second := chooseRow with k, assumption
  rw ← commute at second
  have natural := fallingFactorial.natural at k + d, k
  have chooseNat := choose.natural at k + d, k
  have closedK := factorial.closed at k
  have closedD := factorial.closed at d
  have nonzero := factorial.nonzero at d
  have balanced : d! * fallingFactorial(k + d, k) = d! * (((k + d) choose k) * k!) by ring [first, second]
  exact mul.left_cancel_positive with nonzero, balanced

-- Changing the codomain of an injection.
theorem Injective.widen (f A B C : Set)
  requires injective : InjectiveBetween(f, A, B)
  requires subset : B ⊆ C
  shows InjectiveBetween(f, A, C)
proof
  have function := Injective.function with injective
  have values : ∀ x ∈ A, f(x) ∈ C
    intros x hx
    exact subset with f(x), (FunctionBetween.apply_closed with function, hx)
  have widened := FunctionBetween.codomain_of_values with function, values
  apply Injective.of_pointwise with widened
  intros x hx y hy same
  exact Injective.apply_cancel with injective, hx, hy, same

theorem Injective.avoid (g A B b : Set)
  requires injective : InjectiveBetween(g, A, B)
  requires absent : ¬b ∈ functionImage(g, A, B)
  shows InjectiveBetween(g, A, B ∖ {b})
proof
  have function := Injective.function with injective
  have values : ∀ x ∈ A, g(x) ∈ B ∖ {b}
    intros x hx
    apply difference.singleton_membership.backward
    constructor
    . exact FunctionBetween.apply_closed with function, hx
    . intro same
      apply absent
      rw ← same
      exact functionImage.value with function, hx
  have narrowed := FunctionBetween.codomain_of_values with function, values
  apply Injective.of_pointwise with narrowed
  intros x hx y hy same
  exact Injective.apply_cancel with injective, hx, hy, same

-- Pairs of an injection on A and a point of B, split by whether the point
-- is already a value.
def freshPairs (A B : Set) : Set :=
  { p ∈ injections(A, B) × B | ∃ g ∈ injections(A, B), ∃ b ∈ B, p = (g, b) ∧ ¬b ∈ functionImage(g, A, B) }

def coveredPairs (A B : Set) : Set :=
  { p ∈ injections(A, B) × B | ∃ g ∈ injections(A, B), ∃ b ∈ B, p = (g, b) ∧ b ∈ functionImage(g, A, B) }

theorem freshPairs.pair (A B g b : Set)
  shows
    (g, b) ∈ freshPairs(A, B) ↔ g ∈ injections(A, B) ∧ b ∈ B ∧ ¬b ∈ functionImage(g, A, B)
proof
  constructor
  . intro member
    obtain ⟨bound, h, hh, c, hc, shape, absent⟩ := freshPairs.membership.forward with member
    have coordinates := orderedPair.injective with shape
    rw [coordinates.left, coordinates.right]
    exact ⟨hh, hc, absent⟩
  . intro parts
    obtain ⟨hg, hb, absent⟩ := parts
    apply freshPairs.membership.backward
    refine ⟨(product.pair with hg, hb), g, hg, b, hb, rfl, absent⟩

theorem coveredPairs.pair (A B g b : Set)
  shows
    (g, b) ∈ coveredPairs(A, B) ↔ g ∈ injections(A, B) ∧ b ∈ B ∧ b ∈ functionImage(g, A, B)
proof
  constructor
  . intro member
    obtain ⟨bound, h, hh, c, hc, shape, covered⟩ := coveredPairs.membership.forward with member
    have coordinates := orderedPair.injective with shape
    rw [coordinates.left, coordinates.right]
    exact ⟨hh, hc, covered⟩
  . intro parts
    obtain ⟨hg, hb, covered⟩ := parts
    apply coveredPairs.membership.backward
    refine ⟨(product.pair with hg, hb), g, hg, b, hb, rfl, covered⟩

theorem freshPairs.subset (A B : Set)
  shows freshPairs(A, B) ⊆ injections(A, B) × B
proof
  intros p hp
  have parts := freshPairs.membership.forward with hp
  exact parts.left

theorem coveredPairs.subset (A B : Set)
  shows coveredPairs(A, B) ⊆ injections(A, B) × B
proof
  intros p hp
  have parts := coveredPairs.membership.forward with hp
  exact parts.left

theorem freshPairs.disjoint (A B : Set)
  shows Disjoint(freshPairs(A, B), coveredPairs(A, B))
proof
  apply Disjoint.iff.backward
  intros p fresh covered
  obtain ⟨bound, g, hg, b, hb, shape, absent⟩ := freshPairs.membership.forward with fresh
  rw shape at covered
  have parts := coveredPairs.pair.forward with covered
  exact absent with parts.right.right

theorem freshPairs.union (A B : Set)
  shows freshPairs(A, B) ∪ coveredPairs(A, B) = injections(A, B) × B
proof
  ext p
  constructor
  . intro hp
    have split := union2.membership.forward with hp
    cases split with fresh | covered
    . exact freshPairs.subset at A, B with p, fresh
    . exact coveredPairs.subset at A, B with p, covered
  . intro hp
    obtain ⟨bound, g, hg, b, hb, shape⟩ := product.membership.forward with hp
    rw shape
    have alternatives : b ∈ functionImage(g, A, B) ∨ ¬b ∈ functionImage(g, A, B) by tauto
    cases alternatives with covered | absent
    . apply union2.right
      exact coveredPairs.pair.backward with ⟨hg, hb, covered⟩
    . apply union2.left
      exact freshPairs.pair.backward with ⟨hg, hb, absent⟩

theorem freshPairs.finite (A B : Set)
  requires finiteA : Finite(A)
  requires finiteB : Finite(B)
  shows Finite(freshPairs(A, B))
proof
  have product := Finite.product with (injections.finite with
    finiteA, finiteB), finiteB
  exact Finite.subset with product, (freshPairs.subset at A, B)

theorem coveredPairs.finite (A B : Set)
  requires finiteA : Finite(A)
  requires finiteB : Finite(B)
  shows Finite(coveredPairs(A, B))
proof
  have product := Finite.product with (injections.finite with
    finiteA, finiteB), finiteB
  exact Finite.subset with product, (coveredPairs.subset at A, B)

-- Splitting an injection on insert(a, A) into its restriction and its
-- value at a lands exactly on the fresh pairs.
theorem injections.restrict (f A B a : Set)
  requires member : f ∈ injections(insert(a, A), B)
  shows restrict(f, A) ∈ injections(A, B)
proof
  have injective := injections.injective with member
  have restricted := restrict.injective with
    injective, (insert.subset_self at A, a)
  exact injections.of_injective with restricted

theorem injections.value_fresh (f A B a : Set)
  requires fresh : ¬a ∈ A
  requires member : f ∈ injections(insert(a, A), B)
  shows ¬f(a) ∈ functionImage(restrict(f, A), A, B)
proof
  intro covered
  have injective := injections.injective with member
  have function := injections.function with member
  have subset := insert.subset_self at A, a
  obtain ⟨inB, x, hx, shape⟩ := functionImage.membership.forward with covered
  have step := restrict.domain_apply with function, subset, hx
  rw step at shape
  have equal := Injective.apply_cancel with injective, (insert.self at a, A), (subset with x, hx), shape
  apply fresh
  rw equal
  exact hx

theorem injections.adjoin (g A B a b : Set)
  requires fresh : ¬a ∈ A
  requires hg : g ∈ injections(A, B)
  requires hb : b ∈ B
  requires absent : ¬b ∈ functionImage(g, A, B)
  shows adjoinMap(g, a, b) ∈ injections(insert(a, A), B)
proof
  have injective := injections.injective with hg
  have narrowed := Injective.avoid with injective, absent
  have notIn : ¬b ∈ B ∖ {b} by simp [difference.membership, singleton.membership]
  have extended := adjoinMap.injective at g, A, B ∖ {b}, a, b with
    narrowed, fresh, notIn
  have restored := insert.restore with hb
  rw restored at extended
  exact injections.of_injective with extended

theorem injections.split_image (A B a : Set)
  requires fresh : ¬a ∈ A
  shows
    functionImage(functionSplit(A, B, a), injections(insert(a, A), B), functionSpace(A, B) × B) = freshPairs(A, B)
proof
  have function := functionSplit.function at A, B, a
  ext p
  constructor
  . intro hp
    obtain ⟨bound, f, hf, shape⟩ := functionImage.membership.forward with hp
    have inSpace := injections.subset at insert(a, A), B with f, hf
    have value := functionSplit.value at A, B, a, f with inSpace
    rw [shape, value]
    apply freshPairs.pair.backward
    have restricted := injections.restrict with hf
    have inB := FunctionBetween.apply_closed with (injections.function with
      hf), (insert.self at a, A)
    have absent := injections.value_fresh with fresh, hf
    exact ⟨restricted, inB, absent⟩
  . intro hp
    obtain ⟨bound, g, hg, b, hb, shape, absent⟩ := freshPairs.membership.forward with hp
    have adjoined := injections.adjoin with fresh, hg, hb, absent
    have gSpace := injections.subset at A, B with g, hg
    have value := functionSplit.adjoin_value with fresh, gSpace, hb
    apply functionImage.membership.backward
    constructor
    . rw shape
      exact product.pair with gSpace, hb
    . witness adjoinMap(g, a, b)
      constructor
      . exact adjoined
      . rw [shape, value]
        rfl

theorem injections.insert_equipotent (A B a : Set)
  requires fresh : ¬a ∈ A
  shows injections(insert(a, A), B) ≃ freshPairs(A, B)
proof
  have injective := functionSplit.injective at A, B, a
  have function := functionSplit.function at A, B, a
  have subset := injections.subset at insert(a, A), B
  have restricted := restrict.injective with injective, subset
  have equipotent := Equipotent.image with restricted
  have sameImage := functionImage.restrict with function, subset
  have image := injections.split_image at A, B, a with fresh
  rwa [sameImage, image] at equipotent

-- The covered pairs are the pairs (g, x) of an injection and a point of
-- its domain, through (g, x) ↦ (g, g(x)).
defunique coveredPair (A B p : Set) (q ∈ injections(A, B) × B) :=
  ∃ g ∈ injections(A, B), ∃ x ∈ A, p = (g, x) ∧ q = (g, g(x))
requires pair : p ∈ injections(A, B) × A
proof
  obtain ⟨bound, g, hg, x, hx, shape⟩ := product.membership.forward with pair
  have function := injections.function with hg
  have value := FunctionBetween.apply_closed with function, hx
  have output := product.pair with hg, value
  refine ⟨(g, g(x)), output, g, hg, x, hx, shape, rfl⟩
uniqueness
  intros u hu first v hv second
  obtain ⟨g, hg, x, hx, shapeU, valueU⟩ := first
  obtain ⟨h, hh, y, hy, shapeV, valueV⟩ := second
  have equal : (g, x) = (h, y) by cc
  have coordinates := orderedPair.injective with equal
  cc

defgraph coveredMap (A B : Set) (p ∈ injections(A, B) × A) : injections(A, B) × B := coveredPair(A, B, p)
proof
  have selected := coveredPair.selected with member
  exact selected.left

theorem coveredMap.pair (A B g x : Set)
  requires hg : g ∈ injections(A, B)
  requires hx : x ∈ A
  shows coveredMap(A, B)((g, x)) = (g, g(x))
proof
  have pair := product.pair at g, x, injections(A, B), A with *
  have selected := coveredPair.selected with pair
  obtain ⟨h, hh, y, hy, shape, output⟩ := selected.right
  have coordinates := orderedPair.injective with shape
  have value := coveredMap.value with pair
  cc

theorem coveredMap.injective (A B : Set)
  shows
    InjectiveBetween(coveredMap(A, B), injections(A, B) × A, injections(A, B) × B)
proof
  have function := coveredMap.function at A, B
  apply Injective.of_pointwise with function
  intros p hp q hq same
  obtain ⟨boundP, g, hg, x, hx, shapeP⟩ := product.membership.forward with hp
  obtain ⟨boundQ, h, hh, y, hy, shapeQ⟩ := product.membership.forward with hq
  have valueP := coveredMap.pair with hg, hx
  have valueQ := coveredMap.pair with hh, hy
  rw [shapeP, shapeQ, valueP, valueQ] at same
  have coordinates := orderedPair.injective with same
  have sameFunction := coordinates.left
  have sameValue := coordinates.right
  rw ← sameFunction at sameValue
  have injective := injections.injective with hg
  have sameInput := Injective.apply_cancel with injective, hx, hy, sameValue
  rw [shapeP, shapeQ, sameFunction, sameInput]
  rfl

theorem coveredMap.image (A B : Set)
  shows
    functionImage(coveredMap(A, B), injections(A, B) × A, injections(A, B) × B) = coveredPairs(A, B)
proof
  have function := coveredMap.function at A, B
  ext q
  constructor
  . intro hq
    obtain ⟨bound, p, hp, shape⟩ := functionImage.membership.forward with hq
    obtain ⟨boundP, g, hg, x, hx, shapeP⟩ := product.membership.forward with hp
    have value := coveredMap.pair with hg, hx
    rw [shape, shapeP, value]
    apply coveredPairs.pair.backward
    have gFunction := injections.function with hg
    have inB := FunctionBetween.apply_closed with gFunction, hx
    have covered := functionImage.value with gFunction, hx
    exact ⟨hg, inB, covered⟩
  . intro hq
    obtain ⟨bound, g, hg, b, hb, shape, covered⟩ := coveredPairs.membership.forward with hq
    obtain ⟨inB, x, hx, valueShape⟩ := functionImage.membership.forward with covered
    have pair := product.pair at g, x, injections(A, B), A with hg, hx
    have value := coveredMap.pair with hg, hx
    apply functionImage.membership.backward
    constructor
    . exact bound
    . witness (g, x)
      constructor
      . exact pair
      . rw [shape, value, valueShape]
        rfl

theorem coveredPairs.equipotent (A B : Set)
  shows injections(A, B) × A ≃ coveredPairs(A, B)
proof
  have equipotent := Equipotent.image with (coveredMap.injective at A, B)
  rw coveredMap.image at equipotent
  exact equipotent

-- Truncated subtraction distributes over a product.
theorem sub.self_add (a d : Nat)
  shows a - (a + d) = 0
proof
  induction d
  | zero =>
    have shape : a + 0 = a by ring
    rw shape
    have step := sub.add_right at 0, a
    have zero : 0 + a = a by ring
    rw zero at step
    exact step
  | j + 1 using ih =>
    have shape : a + (j + 1) = succ(a + j) by ring
    rw [shape, sub.succ_right, ih]
    exact predecessor.zero

theorem sub.vanishes_of_le (a b : Nat)
  requires le : a ≤ b
  shows a - b = 0
proof
  obtain ⟨d, dNat, shape⟩ := le
  rw ← shape
  exact sub.self_add at a, d

theorem mul.sub_distributes (a n m : Nat)
  shows a * (n - m) = a * n - a * m
proof
  have alternatives := LessEqual.total at m, n
  cases alternatives with le | ge
  . obtain ⟨d, dNat, shape⟩ := le
    rw ← shape
    have left : m + d - m = d
      have commute : m + d = d + m by ring
      rw commute
      exact sub.add_right at d, m
    have right : a * (m + d) - a * m = a * d
      have expand : a * (m + d) = a * d + a * m by ring
      rw expand
      exact sub.add_right at a * d, a * m
    rw [left, right]
    rfl
  . have zero := sub.vanishes_of_le with ge
    have bound := LessEqual.mul_left at n, m, a with ge
    have productZero := sub.vanishes_of_le with bound
    rw [zero, productZero]
    ring

-- The count of injections grows by the factor n − m when the domain grows
-- by a point.
theorem injections.insert_count (A B a : Set) (m n : Nat)
  requires fresh : ¬a ∈ A
  requires countedA : HasCardinality(A, m)
  requires countedB : HasCardinality(B, n)
  requires counted : HasCardinality(injections(A, B), fallingFactorial(n, m))
  shows HasCardinality(injections(insert(a, A), B), fallingFactorial(n, m + 1))
proof
  have finiteA := Finite.from_cardinality with countedA
  have finiteB := Finite.from_cardinality with countedB
  have finiteInj := Finite.from_cardinality with counted
  have sizeA := cardinality.eq_of_has with countedA
  have sizeB := cardinality.eq_of_has with countedB
  have sizeInj := cardinality.eq_of_has with counted
  have finiteFresh := freshPairs.finite with finiteA, finiteB
  have finiteCovered := coveredPairs.finite with finiteA, finiteB
  have split := cardinality.union_disjoint with
    finiteFresh, finiteCovered, (freshPairs.disjoint at A, B)
  rw freshPairs.union at split
  have productB := cardinality.product_count with finiteInj, finiteB
  have productA := cardinality.product_count with finiteInj, finiteA
  have coveredCount := cardinality.equipotent with (Finite.product with
    finiteInj, finiteA), (coveredPairs.equipotent at A, B)
  rw [sizeInj, sizeB] at productB
  rw [sizeInj, sizeA] at productA
  rw productA at coveredCount
  rw [productB, ← coveredCount] at split
  have natural := fallingFactorial.natural at n, m
  have natFresh := cardinality.nat with finiteFresh
  have freshCount : cardinality(freshPairs(A, B)) = fallingFactorial(n, m) * (n - m)
    rw mul.sub_distributes
    rw split
    symm
    exact sub.add_right at cardinality(freshPairs(A, B)), fallingFactorial(n, m) * m
  have finiteInsert := injections.finite with (Finite.insert at A, a with
    finiteA), finiteB
  have same := cardinality.equipotent with finiteInsert, (injections.insert_equipotent at A, B, a with fresh)
  rw [freshCount, ← fallingFactorial.succ] at same
  exact HasCardinality.of_cardinality with finiteInsert, same

-- The number of injections from an m-element set into an n-element set.
theorem injections.cardinality (m : Nat)
  shows ∀ A, ∀ B, ∀ n, Nat(n) → HasCardinality(A, m) → HasCardinality(B, n) →
    HasCardinality(injections(A, B), fallingFactorial(n, m))
proof
  induction m
  | zero =>
    intros A B n nNat countedA countedB
    have empty := HasCardinality.empty_of_zero at A with countedA
    rw [empty, injections.empty_domain, fallingFactorial.zero]
    constructor
    . exact Naturals.constructor.succ at 0 with Naturals.constructor.zero
    . exact Equipotent.singleton_one at ∅
  | k + 1 using ih =>
    intros A B n nNat countedA countedB
    have hk : k + 1 = succ(k) := add.right_one with *
    rw hk at countedA
    obtain ⟨a, member⟩ := HasCardinality.exists_member with countedA
    have rest := HasCardinality.remove at A, a, k with countedA, member
    have fresh : ¬a ∈ A ∖ {a} by simp [difference.membership, singleton.membership]
    have restored := insert.restore with member
    have restCount := ih with A ∖ {a}, B, n, nNat, rest, countedB
    have inserted := injections.insert_count at A ∖ {a}, B, a, k, n with
      fresh, rest, countedB, restCount
    rw restored at inserted
    exact inserted

theorem injections.count (A B : Set)
  requires finiteA : Finite(A)
  requires finiteB : Finite(B)
  shows
    cardinality(injections(A, B)) = fallingFactorial(cardinality(B), cardinality(A))
proof
  have countedA := cardinality.correct with finiteA
  have countedB := cardinality.correct with finiteB
  have natA := cardinality.nat with finiteA
  have natB := cardinality.nat with finiteB
  have all := injections.cardinality at cardinality(A)
  have counted := all with A, B, cardinality(B), natB, countedA, countedB
  exact cardinality.eq_of_has with counted

theorem injections.count_self (A : Set)
  requires finite : Finite(A)
  shows cardinality(injections(A, A)) = cardinality(A)!
proof
  have count := injections.count with finite, finite
  have natA := cardinality.nat with finite
  rw [count, fallingFactorial.self]
  rfl

theorem injections.empty_of_larger (A B : Set)
  requires finiteB : Finite(B)
  requires more : cardinality(B) < cardinality(A)
  shows injections(A, B) = ∅
proof
  apply Subset.empty_iff.forward
  intros f hf
  have injective := injections.injective with hf
  have function := Injective.function with injective
  exfalso
  exact pigeonhole.not_injective with function, finiteB, more, injective

theorem injections.count_choose (A B : Set)
  requires finiteA : Finite(A)
  requires finiteB : Finite(B)
  requires le : cardinality(A) ≤ cardinality(B)
  shows
    cardinality(injections(A, B)) = (cardinality(B) choose cardinality(A)) * cardinality(A)!
proof
  have count := injections.count with finiteA, finiteB
  have natA := cardinality.nat with finiteA
  have natB := cardinality.nat with finiteB
  rw count
  exact fallingFactorial.choose with le

-- Bijections between two sets, as a set of function graphs.
def bijections (A B : Set) : Set :=
  { f ∈ functionSpace(A, B) | BijectiveBetween(f, A, B) }

theorem bijections.of_bijective (f A B : Set)
  requires bijective : BijectiveBetween(f, A, B)
  shows f ∈ bijections(A, B)
proof
  have function := Injective.function with (Bijective.injective with bijective)
  have inSpace := functionSpace.mem_iff.backward with function
  exact bijections.membership.backward with ⟨inSpace, bijective⟩

theorem bijections.bijective (f A B : Set)
  requires member : f ∈ bijections(A, B)
  shows BijectiveBetween(f, A, B)
proof
  have parts := bijections.membership.forward with member
  exact parts.right

theorem bijections.subset_injections (A B : Set)
  shows bijections(A, B) ⊆ injections(A, B)
proof
  intros f hf
  have bijective := bijections.bijective with hf
  exact injections.of_injective with (Bijective.injective with bijective)

theorem bijections.finite (A B : Set)
  requires finiteA : Finite(A)
  requires finiteB : Finite(B)
  shows Finite(bijections(A, B))
proof
  have finite := injections.finite with finiteA, finiteB
  exact Finite.subset with finite, (bijections.subset_injections at A, B)

-- Between finite sets of the same size every injection is a bijection.
theorem bijections.eq_injections (A B : Set)
  requires finiteB : Finite(B)
  requires same : cardinality(A) = cardinality(B)
  shows bijections(A, B) = injections(A, B)
proof
  apply Subset.antisymmetric with (bijections.subset_injections at A, B)
  intros f hf
  have injective := injections.injective with hf
  have bijective := Finite.bijective_of_injective with injective, finiteB, same
  exact bijections.of_bijective with bijective

theorem bijections.count (A B : Set)
  requires finiteA : Finite(A)
  requires finiteB : Finite(B)
  requires same : cardinality(A) = cardinality(B)
  shows cardinality(bijections(A, B)) = cardinality(A)!
proof
  have equal := bijections.eq_injections with finiteB, same
  have count := injections.count with finiteA, finiteB
  have natA := cardinality.nat with finiteA
  rw [equal, count, ← same, fallingFactorial.self]
  rfl

theorem bijections.count_self (A : Set)
  requires finite : Finite(A)
  shows cardinality(bijections(A, A)) = cardinality(A)!
proof
  have same : cardinality(A) = cardinality(A) by rfl
  exact bijections.count with finite, finite, same

theorem bijections.empty_of_ne (A B : Set)
  requires finiteA : Finite(A)
  requires different : cardinality(A) ≠ cardinality(B)
  shows bijections(A, B) = ∅
proof
  apply Subset.empty_iff.forward
  intros f hf
  have bijective := bijections.bijective with hf
  exfalso
  apply different
  exact cardinality.bijective with finiteA, bijective
