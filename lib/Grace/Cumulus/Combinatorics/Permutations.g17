-- Permutations of a finite set: the bijections of a set onto itself form
-- a set of size n!, closed under composition and inversion and containing
-- the identity and every transposition
-- Part of Cumulus, the Grace17 mathematics library.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module Grace.Cumulus.Combinatorics.Permutations
import Injections

theorem permutations.eq_bijections (I : Set)
  shows permutations(I) = bijections(I, I)
proof
  ext p
  constructor
  . intro member
    exact bijections.of_bijective with (permutations.membership.forward with member)
  . intro member
    exact permutations.membership.backward with (bijections.bijective with member)

theorem permutations.of_bijective (I p : Set)
  requires bijective : BijectiveBetween(p, I, I)
  shows p ∈ permutations(I)
proof
  exact permutations.membership.backward with bijective

theorem permutations.bijective (I p : Set)
  requires member : p ∈ permutations(I)
  shows BijectiveBetween(p, I, I)
proof
  exact permutations.membership.forward with member

theorem permutations.function (I p : Set)
  requires member : p ∈ permutations(I)
  shows p : I → I
proof
  have bijective := permutations.bijective with member
  exact Injective.function with (Bijective.injective with bijective)

-- A finite set with n elements has n! permutations.
theorem permutations.count (I : Set)
  requires finite : Finite(I)
  shows cardinality(permutations(I)) = cardinality(I)!
proof
  rw permutations.eq_bijections
  exact bijections.count_self with finite

theorem permutations.natural_count (n : Nat)
  shows cardinality(permutations(n)) = n!
proof
  have count := permutations.count with (Finite.natural at n)
  rw [count, cardinality.natural]
  rfl

theorem permutations.identity (I : Set)
  shows identity(I) ∈ permutations(I)
proof
  exact permutations.of_bijective with (identity.bijective at I)

theorem permutations.nonempty (I : Set)
  shows Nonempty(permutations(I))
proof
  exact ⟨identity(I), permutations.identity at I⟩

theorem permutations.compose (I p q : Set)
  requires hp : p ∈ permutations(I)
  requires hq : q ∈ permutations(I)
  shows compose(q, p, I, I, I) ∈ permutations(I)
proof
  have pBijective := permutations.bijective with hp
  have qBijective := permutations.bijective with hq
  have composed := compose.bijective at q, p, I, I, I with
    pBijective, qBijective
  exact permutations.of_bijective with composed

theorem permutations.converse (I p : Set)
  requires hp : p ∈ permutations(I)
  shows converse(p, I, I) ∈ permutations(I)
proof
  have bijective := permutations.bijective with hp
  exact permutations.of_bijective with (converse.bijective with bijective)

theorem permutations.transposition (I a b : Set)
  requires ha : a ∈ I
  requires hb : b ∈ I
  shows transposition(I, a, b) ∈ permutations(I)
proof
  have bijective := transposition.bijective at I, a, b with ha, hb
  exact permutations.of_bijective with bijective

theorem permutations.apply_closed (I p x : Set)
  requires hp : p ∈ permutations(I)
  requires hx : x ∈ I
  shows p(x) ∈ I
proof
  exact FunctionBetween.apply_closed with (permutations.function with hp), hx

theorem permutations.apply_cancel (I p x y : Set)
  requires hp : p ∈ permutations(I)
  requires hx : x ∈ I
  requires hy : y ∈ I
  requires same : p(x) = p(y)
  shows x = y
proof
  have injective := Bijective.injective with (permutations.bijective with hp)
  exact Injective.apply_cancel with injective, hx, hy, same

theorem permutations.apply_surjective (I p y : Set)
  requires hp : p ∈ permutations(I)
  requires hy : y ∈ I
  shows ∃ x ∈ I, p(x) = y
proof
  have bijective := permutations.bijective with hp
  have surjective := Bijective.surjective with bijective
  have function := permutations.function with hp
  obtain ⟨x, hx, related⟩ := surjective.right with y, hy
  refine ⟨x, hx, ?_⟩
  exact FunctionBetween.apply_value with function, hx, related

theorem permutations.image_full (I p : Set)
  requires hp : p ∈ permutations(I)
  shows functionImage(p, I, I) = I
proof
  have bijective := permutations.bijective with hp
  exact Surjective.image_full with (Bijective.surjective with bijective)

theorem permutations.inverse_apply (I p x : Set)
  requires hp : p ∈ permutations(I)
  requires hx : x ∈ I
  shows converse(p, I, I)(p(x)) = x
proof
  exact Bijective.inverse_apply with (permutations.bijective with hp), hx

theorem permutations.apply_inverse (I p y : Set)
  requires hp : p ∈ permutations(I)
  requires hy : y ∈ I
  shows p(converse(p, I, I)(y)) = y
proof
  exact Bijective.apply_inverse with (permutations.bijective with hp), hy

theorem permutations.compose_identity_left (I p : Set)
  requires hp : p ∈ permutations(I)
  shows compose(identity(I), p, I, I, I) = p
proof
  exact compose.identity_left with (permutations.function with hp)

theorem permutations.compose_identity_right (I p : Set)
  requires hp : p ∈ permutations(I)
  shows compose(p, identity(I), I, I, I) = p
proof
  exact compose.identity_right with (permutations.function with hp)

theorem permutations.compose_associative (I p q r : Set)
  requires hp : p ∈ permutations(I)
  requires hq : q ∈ permutations(I)
  requires hr : r ∈ permutations(I)
  shows
    compose(r, compose(q, p, I, I, I), I, I, I) = compose(compose(r, q, I, I, I), p, I, I, I)
proof
  have pFunction := permutations.function with hp
  have qFunction := permutations.function with hq
  have rFunction := permutations.function with hr
  exact compose.associative at r, q, p, I, I, I, I with pFunction, qFunction, rFunction

-- On a finite set an injective self-map is already a permutation.
theorem permutations.of_injective (I p : Set)
  requires finite : Finite(I)
  requires injective : InjectiveBetween(p, I, I)
  shows p ∈ permutations(I)
proof
  exact permutations.of_bijective with (Finite.self_injective_bijective with injective, finite)

theorem permutations.of_surjective (I p : Set)
  requires finite : Finite(I)
  requires surjective : SurjectiveBetween(p, I, I)
  shows p ∈ permutations(I)
proof
  exact permutations.of_bijective with (Finite.self_surjective_bijective with surjective, finite)

theorem permutations.eq_injections (I : Set)
  requires finite : Finite(I)
  shows permutations(I) = injections(I, I)
proof
  have same : cardinality(I) = cardinality(I) by rfl
  rw permutations.eq_bijections
  exact bijections.eq_injections with finite, same

-- A singleton has only the identity permutation.
theorem permutations.singleton (x : Set)
  shows permutations({x}) = {identity({x})}
proof
  have finite := Finite.singleton at x
  have count := permutations.count with finite
  rw [cardinality.singleton, factorial.one] at count
  have finitePerms := permutations.finite with finite
  have iff := cardinality.one_iff with finitePerms
  obtain ⟨y, shape⟩ := iff.forward with count
  have member := permutations.identity at {x}
  rw shape at member
  have equal := singleton.membership.forward with member
  rw [shape, equal]
  rfl

theorem permutations.two_count
  shows cardinality(permutations(2)) = 2
proof
  have count := permutations.natural_count at 2
  rw count
  compute

theorem permutations.three_count
  shows cardinality(permutations(3)) = 6
proof
  have count := permutations.natural_count at 3
  rw count
  compute
