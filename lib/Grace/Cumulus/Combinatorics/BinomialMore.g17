-- Further identities for the binomial coefficient: the weighted row sum
-- ∑ k · (n choose k) = n · 2 ^ (n − 1), the even-index and odd-index row
-- sums agreeing at 2 ^ (n − 1), the ratio of neighbouring entries in
-- product form, unimodality of a row, and the third column
-- Part of Cumulus, the Grace17 mathematics library.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module Grace.Cumulus.Combinatorics.BinomialMore
import Derangements

-- Partial sums ∑_{i < k} i · (n choose i).
def weightedRowSum (n k : Nat) → Nat
  | n, zero => 0
  | n, succ(k) => weightedRowSum(n, k) + k * choose(n, k)
  descends k

theorem weightedRowSum.zero (n : Nat)
  shows weightedRowSum(n, 0) = 0
proof
  simp [weightedRowSum]

theorem weightedRowSum.succ (n k : Nat)
  shows weightedRowSum(n, k + 1) = weightedRowSum(n, k) + k * (n choose k)
proof
  have hk : k + 1 = succ(k) := add.right_one with *
  rw hk
  simp [weightedRowSum]

theorem weightedRowSum.natural (n k : Nat)
  shows Nat(weightedRowSum(n, k))
proof
  induction k
  | zero =>
    rw weightedRowSum.zero
    typecheck
  | j + 1 using ih =>
    rw weightedRowSum.succ
    have cNat := choose.natural at n, j
    typecheck

theorem weightedRowSum.one (n : Nat)
  shows weightedRowSum(n, 1) = 0
proof
  have one : 0 + 1 = 1 by compute
  rw ← one
  rw [weightedRowSum.succ, weightedRowSum.zero, choose.zero_right]
  compute

-- Absorption termwise:
-- ∑_{i ≤ k} i · (n + 1 choose i) = (n + 1) · ∑_{i < k} (n choose i).
theorem weightedRowSum.shift (n k : Nat)
  shows weightedRowSum(n + 1, k + 1) = (n + 1) * chooseRowSum(n, k)
proof
  induction k
  | zero =>
    have one : 0 + 1 = 1 by compute
    rw [one, weightedRowSum.one, chooseRowSum.zero]
    ring
  | j + 1 using ih =>
    rw [weightedRowSum.succ, ih, chooseRowSum.succ]
    have absorb := choose.absorption_at at n, j
    have rowNat := chooseRowSum.natural at n, j
    have cNat := choose.natural at n, j
    have topNat := choose.natural at n + 1, j + 1
    ring [absorb]

-- ∑_{k ≤ n + 1} k · (n + 1 choose k) = (n + 1) · 2 ^ n.
theorem weightedRowSum.full (n : Nat)
  shows weightedRowSum(n + 1, n + 2) = (n + 1) * 2 ^ n
proof
  have shape : n + 2 = (n + 1) + 1 by ring
  rw [shape, weightedRowSum.shift, chooseRowSum.full]
  rfl

theorem weightedRowSum.double (n : Nat)
  shows 2 * weightedRowSum(n, n + 1) = n * 2 ^ n
proof
  have split := natural.zero_or_successor at n
  cases split with isZero | isSucc
  . rw isZero
    compute
  . obtain ⟨j, jNat, shape⟩ := isSucc
    have hj : succ(j) = j + 1
      symm
      exact add.right_one at j
    have two : j + 1 + 1 = j + 2 by ring
    rw [shape, hj, two, weightedRowSum.full, pow.add_one]
    have powNat := pow.closed at 2, j
    ring

-- Partial sums over the even and the odd columns of a row.
def evenRowSum (n k : Nat) → Nat
  | n, zero => 0
  | n, succ(k) => evenRowSum(n, k) + choose(n, 2 * k)
  descends k

def oddRowSum (n k : Nat) → Nat
  | n, zero => 0
  | n, succ(k) => oddRowSum(n, k) + choose(n, 2 * k + 1)
  descends k

theorem evenRowSum.zero (n : Nat)
  shows evenRowSum(n, 0) = 0
proof
  simp [evenRowSum]

theorem evenRowSum.succ (n k : Nat)
  shows evenRowSum(n, k + 1) = evenRowSum(n, k) + (n choose (2 * k))
proof
  have hk : k + 1 = succ(k) := add.right_one with *
  rw hk
  simp [evenRowSum]

theorem evenRowSum.natural (n k : Nat)
  shows Nat(evenRowSum(n, k))
proof
  induction k
  | zero =>
    rw evenRowSum.zero
    typecheck
  | j + 1 using ih =>
    rw evenRowSum.succ
    have cNat := choose.natural at n, 2 * j
    typecheck

theorem oddRowSum.zero (n : Nat)
  shows oddRowSum(n, 0) = 0
proof
  simp [oddRowSum]

theorem oddRowSum.succ (n k : Nat)
  shows oddRowSum(n, k + 1) = oddRowSum(n, k) + (n choose (2 * k + 1))
proof
  have hk : k + 1 = succ(k) := add.right_one with *
  rw hk
  simp [oddRowSum]

theorem oddRowSum.natural (n k : Nat)
  shows Nat(oddRowSum(n, k))
proof
  induction k
  | zero =>
    rw oddRowSum.zero
    typecheck
  | j + 1 using ih =>
    rw oddRowSum.succ
    have cNat := choose.natural at n, 2 * j + 1
    typecheck

theorem evenRowSum.one (n : Nat)
  shows evenRowSum(n, 1) = 1
proof
  have one : 0 + 1 = 1 by compute
  rw ← one
  rw [evenRowSum.succ, evenRowSum.zero]
  have twice : 2 * 0 = 0 by compute
  rw [twice, choose.zero_right]
  compute

theorem oddRowSum.one (n : Nat)
  shows oddRowSum(n, 1) = n
proof
  have one : 0 + 1 = 1 by compute
  rw ← one
  rw [oddRowSum.succ, oddRowSum.zero]
  have twice : 2 * 0 = 0 by compute
  rw [twice, one, choose.one_right]
  ring

-- Pascal's rule column by column: the even sums of row n + 1 come from the
-- even and the odd sums of row n.
theorem evenRowSum.pascal (n k : Nat)
  shows evenRowSum(n + 1, k + 1) = evenRowSum(n, k + 1) + oddRowSum(n, k)
proof
  induction k
  | zero =>
    have one : 0 + 1 = 1 by compute
    rw [one, evenRowSum.one, evenRowSum.one, oddRowSum.zero]
    compute
  | j + 1 using ih =>
    have top := evenRowSum.succ at n + 1, j + 1
    have right := evenRowSum.succ at n, j + 1
    have low := oddRowSum.succ at n, j
    rw [top, ih, right, low]
    have shape : 2 * (j + 1) = 2 * j + 1 + 1 by ring
    rw [shape, choose.pascal]
    have aNat := evenRowSum.natural at n, j + 1
    have bNat := oddRowSum.natural at n, j
    have cNat := choose.natural at n, 2 * j + 1
    have dNat := choose.natural at n, 2 * j + 1 + 1
    ring

theorem oddRowSum.pascal (n k : Nat)
  shows oddRowSum(n + 1, k) = evenRowSum(n, k) + oddRowSum(n, k)
proof
  induction k
  | zero =>
    rw [oddRowSum.zero, evenRowSum.zero, oddRowSum.zero]
    compute
  | j + 1 using ih =>
    rw [oddRowSum.succ, ih, evenRowSum.succ, oddRowSum.succ, choose.pascal]
    have aNat := evenRowSum.natural at n, j
    have bNat := oddRowSum.natural at n, j
    have cNat := choose.natural at n, 2 * j
    have dNat := choose.natural at n, 2 * j + 1
    ring

-- A row sum up to an even bound splits into its even and odd parts.
theorem chooseRowSum.split_parity (n k : Nat)
  shows chooseRowSum(n, 2 * k) = evenRowSum(n, k) + oddRowSum(n, k)
proof
  induction k
  | zero =>
    have twice : 2 * 0 = 0 by compute
    rw [twice, chooseRowSum.zero, evenRowSum.zero, oddRowSum.zero]
    compute
  | j + 1 using ih =>
    have shape : 2 * (j + 1) = (2 * j + 1) + 1 by ring
    rw [shape, chooseRowSum.succ, chooseRowSum.succ, ih]
    rw [evenRowSum.succ, oddRowSum.succ]
    have aNat := evenRowSum.natural at n, j
    have bNat := oddRowSum.natural at n, j
    have cNat := choose.natural at n, 2 * j
    have dNat := choose.natural at n, 2 * j + 1
    ring

theorem evenRowSum.add_odd (n : Nat)
  shows evenRowSum(n, n + 1) + oddRowSum(n, n + 1) = 2 ^ n
proof
  rw ← chooseRowSum.split_parity
  have shape : 2 * (n + 1) = n + 1 + (n + 1) by ring
  rw shape
  exact chooseRowSum.beyond at n, n + 1

theorem evenRowSum.beyond (n d : Nat)
  shows evenRowSum(n, n + 1 + d) = evenRowSum(n, n + 1)
proof
  induction d
  | zero =>
    have shape : n + 1 + 0 = n + 1 by ring
    rw shape
    rfl
  | j + 1 using ih =>
    have shape : n + 1 + (j + 1) = (n + 1 + j) + 1 by ring
    rw [shape, evenRowSum.succ, ih]
    have below : n < 2 * (n + 1 + j) by arith
    have vanish := choose.above_diagonal with below
    rw vanish
    have sumNat := evenRowSum.natural at n, n + 1
    ring

theorem oddRowSum.beyond (n d : Nat)
  shows oddRowSum(n, n + 1 + d) = oddRowSum(n, n + 1)
proof
  induction d
  | zero =>
    have shape : n + 1 + 0 = n + 1 by ring
    rw shape
    rfl
  | j + 1 using ih =>
    have shape : n + 1 + (j + 1) = (n + 1 + j) + 1 by ring
    rw [shape, oddRowSum.succ, ih]
    have below : n < 2 * (n + 1 + j) + 1 by arith
    have vanish := choose.above_diagonal with below
    rw vanish
    have sumNat := oddRowSum.natural at n, n + 1
    ring

-- The even columns of row n + 1 add up to 2 ^ n, and so do the odd columns.
theorem evenRowSum.full (n : Nat)
  shows evenRowSum(n + 1, n + 2) = 2 ^ n
proof
  have shape : n + 2 = (n + 1) + 1 by ring
  rw [shape, evenRowSum.pascal]
  have tail := evenRowSum.beyond at n, 1
  rw tail
  exact evenRowSum.add_odd at n

theorem oddRowSum.full (n : Nat)
  shows oddRowSum(n + 1, n + 2) = 2 ^ n
proof
  rw oddRowSum.pascal
  have shape : n + 2 = n + 1 + 1 by ring
  rw shape
  have evenTail := evenRowSum.beyond at n, 1
  have oddTail := oddRowSum.beyond at n, 1
  rw [evenTail, oddTail]
  exact evenRowSum.add_odd at n

-- The alternating row sum vanishes: even and odd columns balance.
theorem choose.alternating (n : Nat)
  shows evenRowSum(n + 1, n + 2) = oddRowSum(n + 1, n + 2)
proof
  rw [evenRowSum.full, oddRowSum.full]
  rfl

-- The complementary absorption law
-- (m − k + 1) · (m + 1 choose k) = (m + 1) · (m choose k).
theorem choose.absorption_complement (m k : Nat)
  requires le : k ≤ m
  shows (m - k + 1) * ((m + 1) choose k) = (m + 1) * (m choose k)
proof
  obtain ⟨d, dNat, shape⟩ := le
  have difference : m - k = d
    rw ← shape
    exact sub.add_left at d, k
  rw [difference, ← shape]
  have first := choose.add_symmetric at d + 1, k
  have shapeA : k + d + 1 = d + 1 + k by ring
  rw [shapeA, first]
  have second := choose.add_symmetric at d, k
  have shapeB : k + d = d + k by ring
  rw [shapeB, second]
  have absorb := choose.absorption_at at d + k, d
  have aNat := choose.natural at d + 1 + k, d + 1
  have bNat := choose.natural at d + k, d
  ring [absorb]

-- Neighbouring entries of a row:
-- (k + 1) · (m + 1 choose k + 1) = (m − k + 1) · (m + 1 choose k).
theorem choose.ratio (m k : Nat)
  requires le : k ≤ m
  shows (k + 1) * ((m + 1) choose (k + 1)) = (m - k + 1) * ((m + 1) choose k)
proof
  have complement := choose.absorption_complement with le
  rw [choose.absorption_at, complement]
  rfl

theorem choose.le_succ_of_below_half (m k : Nat)
  requires half : 2 * k ≤ m
  shows (m + 1) choose k ≤ (m + 1) choose (k + 1)
proof
  have le : k ≤ m by arith
  have ratio := choose.ratio with le
  have subNat := sub.closed at m, k
  have cancel := sub.add_cancel_left with le
  have coefficient : k + 1 ≤ m - k + 1 by arith
  have aNat := choose.natural at m + 1, k
  have bNat := choose.natural at m + 1, k + 1
  have scaled := LessEqual.mul_right at k + 1, m - k + 1, (m + 1) choose k
    with coefficient
  rw ← ratio at scaled
  have positive : 0 < k + 1 by arith
  have nonzero := Less.ne_zero_of_positive with positive
  exact LessEqual.mul_left_cancel_positive with nonzero, scaled

theorem choose.lt_succ_of_below_half (m k : Nat)
  requires half : 2 * k + 1 ≤ m
  shows (m + 1) choose k < (m + 1) choose (k + 1)
proof
  have le : k ≤ m by arith
  have ratio := choose.ratio with le
  have subNat := sub.closed at m, k
  have cancel := sub.add_cancel_left with le
  have coefficient : k + 1 < m - k + 1 by arith
  have aNat := choose.natural at m + 1, k
  have bNat := choose.natural at m + 1, k + 1
  have leTop : k ≤ m + 1 by arith
  have positive := choose.positive with leTop
  have nonzero := Less.ne_zero_of_positive with positive
  have scaled := Less.mul_right at k + 1, m - k + 1, (m + 1) choose k
    with nonzero, coefficient
  rw ← ratio at scaled
  have gapPositive : 0 < k + 1 by arith
  have gap := Less.ne_zero_of_positive with gapPositive
  exact Less.mul_left_cancel_positive with gap, scaled

-- A row of Pascal's triangle increases up to its middle.
theorem choose.monotone_to_half (n j d : Nat)
  requires half : 2 * (j + d) ≤ n
  shows n choose j ≤ n choose (j + d)
proof
  induction d
  | zero =>
    intro half
    have shape : j + 0 = j by ring
    rw shape
    have cNat := choose.natural at n, j
    exact LessEqual.reflexive at n choose j
  | k + 1 using ih =>
    intro half
    have earlier : 2 * (j + k) ≤ n by arith
    have inner := ih with earlier
    have positive : 0 < n by arith
    obtain ⟨m, mNat, shape⟩ := Less.exists_add_one with positive
    have form : n = m + 1
      rw shape
      ring
    rw form at inner
    rw form at half
    rw form
    have below : 2 * (j + k) ≤ m by arith
    have step := choose.le_succ_of_below_half at m, j + k with below
    have shapeD : j + (k + 1) = j + k + 1 by ring
    rw shapeD
    have aNat := choose.natural at m + 1, j
    have bNat := choose.natural at m + 1, j + k
    have cNat := choose.natural at m + 1, j + k + 1
    exact LessEqual.transitive with inner, step

theorem choose.central_dominates_below (n k : Nat)
  requires le : k ≤ n
  shows (2 * n) choose k ≤ (2 * n) choose n
proof
  obtain ⟨d, dNat, shape⟩ := le
  have half : 2 * (k + d) ≤ 2 * n
    rw shape
    have doubleNat : Nat(2 * n) by typecheck
    exact LessEqual.reflexive at 2 * n
  have bound := choose.monotone_to_half at 2 * n, k, d with half
  rw shape at bound
  exact bound

-- The central entry dominates every entry of an even row.
theorem choose.le_central (n k : Nat)
  shows (2 * n) choose k ≤ (2 * n) choose n
proof
  have alternatives := Less.or_LessEqual at n, k
  cases alternatives with above | le
  . have split := Less.or_LessEqual at 2 * n, k
    cases split with far | inRow
    . have vanish := choose.above_diagonal with far
      rw vanish
      have cNat := choose.natural at 2 * n, n
      arith
    . have mirror := choose.symmetric at 2 * n, k with inRow
      rw mirror
      have subNat := sub.closed at 2 * n, k
      have iff := sub.le_iff at 2 * n, k, n
      have small : 2 * n ≤ k + n by arith
      have le := iff.backward with small
      exact choose.central_dominates_below with le
  . exact choose.central_dominates_below with le

theorem choose.odd_dominates_below (n k : Nat)
  requires le : k ≤ n
  shows (2 * n + 1) choose k ≤ (2 * n + 1) choose n
proof
  obtain ⟨d, dNat, shape⟩ := le
  have half : 2 * (k + d) ≤ 2 * n + 1
    rw shape
    arith
  have bound := choose.monotone_to_half at 2 * n + 1, k, d with half
  rw shape at bound
  exact bound

-- The two middle entries dominate every entry of an odd row.
theorem choose.le_central_odd (n k : Nat)
  shows (2 * n + 1) choose k ≤ (2 * n + 1) choose n
proof
  have alternatives := Less.or_LessEqual at n, k
  cases alternatives with above | le
  . have split := Less.or_LessEqual at 2 * n + 1, k
    cases split with far | inRow
    . have vanish := choose.above_diagonal with far
      rw vanish
      have cNat := choose.natural at 2 * n + 1, n
      arith
    . have mirror := choose.symmetric at 2 * n + 1, k with inRow
      rw mirror
      have subNat := sub.closed at 2 * n + 1, k
      have iff := sub.le_iff at 2 * n + 1, k, n
      have small : 2 * n + 1 ≤ k + n by arith
      have le := iff.backward with small
      exact choose.odd_dominates_below with le
  . exact choose.odd_dominates_below with le

theorem choose.pascal_le_left (n k : Nat)
  shows n choose k ≤ (n + 1) choose (k + 1)
proof
  rw choose.pascal
  have aNat := choose.natural at n, k
  have bNat := choose.natural at n, k + 1
  arith

theorem choose.pascal_le_right (n k : Nat)
  shows n choose (k + 1) ≤ (n + 1) choose (k + 1)
proof
  rw choose.pascal
  have aNat := choose.natural at n, k
  have bNat := choose.natural at n, k + 1
  arith

-- The third column: 6 · (n + 3 choose 3) = (n + 3)(n + 2)(n + 1).
theorem choose.three (n : Nat)
  shows 6 * ((n + 3) choose 3) = (n + 3) * (n + 2) * (n + 1)
proof
  have absorb := choose.absorption_at at n + 2, 2
  have three : 2 + 1 = 3 by compute
  have shape : n + 2 + 1 = n + 3 by ring
  rw [three, shape] at absorb
  have second := choose.two at n + 1
  have shape2 : n + 1 + 1 = n + 2 by ring
  rw shape2 at second
  have aNat := choose.natural at n + 3, 3
  have bNat := choose.natural at n + 2, 2
  ring [absorb, second]
