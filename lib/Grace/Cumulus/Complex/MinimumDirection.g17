module Grace.Cumulus.Complex.MinimumDirection
import Descent

def complexDotSequence (z u : Set) : Set := addSequence(
  mulSequence(constantSequence(Euclidean.x(z)), complexSequenceX(u)),
  mulSequence(constantSequence(Euclidean.y(z)), complexSequenceY(u)))

def normalizedNormSequence (z s u : Set) : Set := addSequence(
  mulSequence(constantSequence((2:R)), complexDotSequence(z, u)),
  mulSequence(s, complexNormSequence(u)))

section Complexes
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg, complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

theorem complexDotSequence.sequence (z u : Set)
  requires member : z ∈ ℂ
  requires sequence : ComplexSequence(u)
  shows RealSequence(complexDotSequence(z, u))
proof
  have point := complex.point with *
  have cx := constantSequence.sequence at Euclidean.x(z) with *
  have cy := constantSequence.sequence at Euclidean.y(z) with *
  have ux := complexSequenceX.sequence with *
  have uy := complexSequenceY.sequence with *
  have xx := mulSequence.sequence at constantSequence(Euclidean.x(z)), complexSequenceX(u) with *
  have yy := mulSequence.sequence at constantSequence(Euclidean.y(z)), complexSequenceY(u) with *
  unfold complexDotSequence
  exact addSequence.sequence with *

theorem complexDotSequence.value (z u : Set) (n : Nat)
  requires member : z ∈ ℂ
  requires sequence : ComplexSequence(u)
  shows complexDotSequence(z, u)(n) = Euclidean.dot(z, u(n))
proof
  have point := complex.point with *
  have cx := constantSequence.sequence at Euclidean.x(z) with *
  have cy := constantSequence.sequence at Euclidean.y(z) with *
  have ux := complexSequenceX.sequence with *
  have uy := complexSequenceY.sequence with *
  have xx := mulSequence.sequence at constantSequence(Euclidean.x(z)), complexSequenceX(u) with *
  have yy := mulSequence.sequence at constantSequence(Euclidean.y(z)), complexSequenceY(u) with *
  have cxn := RealSequence.value at constantSequence(Euclidean.x(z)), n with *
  have cyn := RealSequence.value at constantSequence(Euclidean.y(z)), n with *
  have uxn := RealSequence.value at complexSequenceX(u), n with *
  have uyn := RealSequence.value at complexSequenceY(u), n with *
  have xxn := RealSequence.value at mulSequence(constantSequence(Euclidean.x(z)), complexSequenceX(u)), n with *
  have yyn := RealSequence.value at mulSequence(constantSequence(Euclidean.y(z)), complexSequenceY(u)), n with *
  unfold complexDotSequence
  rw [addSequence.value, mulSequence.value, mulSequence.value, constantSequence.value, constantSequence.value, complexSequenceX.value, complexSequenceY.value]
  unfold Euclidean.dot
  rfl

theorem ComplexConvergesTo.dot (z u a : Set)
  requires member : z ∈ ℂ
  requires converges : ComplexConvergesTo(u, a)
  shows ConvergesTo(complexDotSequence(z, u), Euclidean.dot(z, a))
proof
  obtain ⟨sequence, center, horizontal, vertical⟩ := converges
  have pointZ := complex.point at z with *
  have pointA := complex.point at a with *
  have cx := constantSequence.converges at Euclidean.x(z) with *
  have cy := constantSequence.converges at Euclidean.y(z) with *
  have xx := ConvergesTo.mul at constantSequence(Euclidean.x(z)), complexSequenceX(u), Euclidean.x(z), Euclidean.x(a) with *
  have yy := ConvergesTo.mul at constantSequence(Euclidean.y(z)), complexSequenceY(u), Euclidean.y(z), Euclidean.y(a) with *
  have sum := ConvergesTo.add at mulSequence(constantSequence(Euclidean.x(z)), complexSequenceX(u)), mulSequence(constantSequence(Euclidean.y(z)), complexSequenceY(u)), R[Euclidean.x(z) * Euclidean.x(a)], R[Euclidean.y(z) * Euclidean.y(a)] with *
  unfold complexDotSequence
  unfold Euclidean.dot
  exact sum

-- Cancel a positive step from the exact squared-norm expansion.
theorem complexNormSquared.minimum_step (z w : Set) (t : Real)
  requires first : z ∈ ℂ
  requires second : w ∈ ℂ
  requires positive : realZero < t
  requires minimum : complexNormSquared(z) ≤ complexNormSquared(ℂ[z + complexScale(t, w)])
  shows realZero ≤ R[2 * Euclidean.dot(z, w) + t * complexNormSquared(w)]
proof
  have pointZ := complex.point at z with *
  have pointW := complex.point at w with *
  have identity := complexNormSquared.perturbation at z, complexScale(t, w) with *
  rw [complexScale.dot_right, complexNormSquared.scale] at identity
  rw identity at minimum
  have shifted := realLe.add_right at complexNormSquared(z), R[complexNormSquared(z) + 2 * (t * Euclidean.dot(z, w)) + t * t * complexNormSquared(w)], R[-complexNormSquared(z)] with *
  have left : R[complexNormSquared(z) + -complexNormSquared(z)] = R[0 * t] by ring
  have right : R[(complexNormSquared(z) + 2 * (t * Euclidean.dot(z, w)) + t * t * complexNormSquared(w)) + -complexNormSquared(z)] = R[(2 * Euclidean.dot(z, w) + t * complexNormSquared(w)) * t]
    ring
  rw [left, right] at shifted
  exact realLe.mul_right_cancel_positive at realZero, R[2 * Euclidean.dot(z, w) + t * complexNormSquared(w)], t with *

theorem normalizedNormSequence.converges (z s u a : Set)
  requires member : z ∈ ℂ
  requires steps : ConvergesTo(s, realZero)
  requires directions : ComplexConvergesTo(u, a)
  shows ConvergesTo(normalizedNormSequence(z, s, u), R[2 * Euclidean.dot(z, a)])
proof
  have center : a ∈ ℂ
    obtain ⟨sequence, center, horizontal, vertical⟩ := directions
    exact center
  have pointZ := complex.point at z with *
  have pointA := complex.point at a with *
  have two := constantSequence.converges at R[2] with *
  have dot := ComplexConvergesTo.dot at z, u, a with *
  have norm := ComplexConvergesTo.norm_squared with *
  have linear := ConvergesTo.mul at constantSequence(R[2]), complexDotSequence(z, u), R[2], Euclidean.dot(z, a) with *
  have quadratic := ConvergesTo.mul at s, complexNormSequence(u), realZero, complexNormSquared(a) with *
  have sum := ConvergesTo.add at mulSequence(constantSequence(R[2]), complexDotSequence(z, u)), mulSequence(s, complexNormSequence(u)), R[2 * Euclidean.dot(z, a)], R[0 * complexNormSquared(a)] with *
  rw [realMulValue.zero_left, realAddValue.zero_right] at sum
  unfold normalizedNormSequence
  exact sum

theorem normalizedNormSequence.value (z s u : Set) (n : Nat)
  requires member : z ∈ ℂ
  requires steps : RealSequence(s)
  requires directions : ComplexSequence(u)
  shows normalizedNormSequence(z, s, u)(n) = R[2 * Euclidean.dot(z, u(n)) + s(n) * complexNormSquared(u(n))]
proof
  have two := constantSequence.sequence at R[2] with *
  have dot := complexDotSequence.sequence with *
  have norm : RealSequence(complexNormSequence(u))
    unfold RealSequence
    exact complexNormSequence.function with *
  have linear := mulSequence.sequence at constantSequence(R[2]), complexDotSequence(z, u) with *
  have quadratic := mulSequence.sequence at s, complexNormSequence(u) with *
  have tn := RealSequence.value at constantSequence(R[2]), n with *
  have dn := RealSequence.value at complexDotSequence(z, u), n with *
  have sn := RealSequence.value at s, n with *
  have nn := RealSequence.value at complexNormSequence(u), n with *
  have ln := RealSequence.value at mulSequence(constantSequence(R[2]), complexDotSequence(z, u)), n with *
  have qn := RealSequence.value at mulSequence(s, complexNormSequence(u)), n with *
  unfold normalizedNormSequence
  rw [addSequence.value, mulSequence.value, mulSequence.value, constantSequence.value, complexDotSequence.value, complexNormSequence.value]
  rfl

-- Varying directions are allowed: their limit controls the first-order sign.
theorem complexNormSquared.minimum_direction (z s u a : Set)
  requires member : z ∈ ℂ
  requires steps : ConvergesTo(s, realZero)
  requires directions : ComplexConvergesTo(u, a)
  requires positive : ∀ n ∈ ℕ, realZero < s(n)
  requires minimum : ∀ n ∈ ℕ, complexNormSquared(z) ≤ complexNormSquared(ℂ[z + complexScale(s(n), u(n))])
  shows realZero ≤ Euclidean.dot(z, a)
proof
  have limit := normalizedNormSequence.converges with *
  have stepSequence := ConvergesTo.sequence at s, realZero with *
  obtain ⟨sequence, center, horizontal, vertical⟩ := directions
  have function : u : ℕ → ℂ by exact sequence
  have pointZ := complex.point at z with *
  have pointA := complex.point at a with *
  have nonnegative : NonnegativeTerms(normalizedNormSequence(z, s, u))
    intros n nIn
    have nNat := nat.omega.backward at n with *
    have sn := RealSequence.value with *
    have un := FunctionBetween.apply_closed with *
    have stepPositive := positive with n, nIn
    have least := minimum with n, nIn
    rw normalizedNormSequence.value
    have bound := complexNormSquared.minimum_step with *
    exact realLe.characterization.forward with bound
  have doubled := ConvergesTo.nonnegative_of_nonnegative_terms with *
  have twoPositive : (0:R) < 2 by linarith
  have left : realZero = R[0 * 2] by ring
  have right : R[2 * Euclidean.dot(z, a)] = R[Euclidean.dot(z, a) * 2] by ring
  rw [left, right] at doubled
  exact realLe.mul_right_cancel_positive with *

end Complexes
