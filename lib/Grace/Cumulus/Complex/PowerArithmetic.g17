module Grace.Cumulus.Complex.PowerArithmetic
import SquareDirections
import Nat.Parity

def complexImaginaryUnit : Set := (realZero, realOne)

theorem complexImaginaryUnit.member
  shows complexImaginaryUnit ∈ complexCarrier
proof
  unfold complexImaginaryUnit
  exact complexCarrier.pair with *

theorem natural.double_successor (n : Nat)
  shows add(succ(n), succ(n)) = succ(succ(add(n, n)))
proof
  ring

section Complexes
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg, complexMul, complexOne)

theorem complexImaginaryUnit.square
  shows ℂ[complexImaginaryUnit * complexImaginaryUnit] = ℂ[-1]
proof
  unfold complexImaginaryUnit
  unfold complexOne
  simp [complexMul.pair, complexNeg.pair, realMulValue.zero_left, realMulValue.zero_right, realMulValue.one_left, realAddValue.zero_left, realAddValue.zero_right, realNegValue.zero]

theorem complexPower.one (n : Nat)
  shows (ℂ[1]) ^ n = ℂ[1]
proof
  induction n
  | zero =>
    rw monoidPow.zero
    rfl
  | succ(k) using ih =>
    rw [monoidPow.succ, ih]
    have ring := complexes.comm_ring
    ring

theorem complexPower.square (z : Set) (n : Nat)
  requires member : z ∈ ℂ
  shows z ^ (Grace.Core.Nat.Rec.add(n, n)) = (ℂ[z * z]) ^ n
proof
  induction n
  | zero =>
    rw [Grace.Core.Nat.Rec.add, monoidPow.zero, monoidPow.zero]
    rfl
  | succ(k) using ih =>
    have ring := complexes.comm_ring
    have ordinary := IsCommRing.ring with ring
    have monoid := IsRing.multiplicative with ordinary
    have square := IsRing.mul_closed with ordinary, member, member
    have power := monoidPow.closed at ℂ, complexMul, complexOne, ℂ[z * z], k with *
    rw [natural.double_successor, monoidPow.succ, monoidPow.succ, ih, monoidPow.succ]
    ring

theorem complexPower.negative_one_odd (n : Nat)
  shows (ℂ[-1]) ^ (succ(Grace.Core.Nat.Rec.add(n, n))) = ℂ[-1]
proof
  induction n
  | zero =>
    rw [Grace.Core.Nat.Rec.add, monoidPow.succ, monoidPow.zero]
    have ring := complexes.comm_ring
    ring
  | succ(k) using ih =>
    rw [natural.double_successor, monoidPow.succ, monoidPow.succ, ih]
    have ring := complexes.comm_ring
    ring

theorem complexImaginaryUnit.twice (z : Set)
  requires member : z ∈ ℂ
  shows ℂ[complexImaginaryUnit * (complexImaginaryUnit * z)] = ℂ[-z]
proof
  have ring := complexes.comm_ring
  have iIn := complexImaginaryUnit.member
  have regroup : ℂ[complexImaginaryUnit * (complexImaginaryUnit * z)] = ℂ[(complexImaginaryUnit * complexImaginaryUnit) * z]
    ring
  rw [regroup, complexImaginaryUnit.square]
  ring

theorem complexImaginaryUnit.negative_twice (z : Set)
  requires member : z ∈ ℂ
  shows ℂ[(-complexImaginaryUnit) * ((-complexImaginaryUnit) * z)] = ℂ[-z]
proof
  have ring := complexes.comm_ring
  have iIn := complexImaginaryUnit.member
  have regroup : ℂ[(-complexImaginaryUnit) * ((-complexImaginaryUnit) * z)] = ℂ[complexImaginaryUnit * (complexImaginaryUnit * z)]
    ring
  rw regroup
  exact complexImaginaryUnit.twice with *

theorem complexPower.imaginary_odd (n : Nat)
  shows (complexImaginaryUnit ^ (succ(Grace.Core.Nat.Rec.add(n, n))) = complexImaginaryUnit ∧ (ℂ[-complexImaginaryUnit]) ^ (succ(Grace.Core.Nat.Rec.add(n, n))) = ℂ[-complexImaginaryUnit]) ∨
    (complexImaginaryUnit ^ (succ(Grace.Core.Nat.Rec.add(n, n))) = ℂ[-complexImaginaryUnit] ∧ (ℂ[-complexImaginaryUnit]) ^ (succ(Grace.Core.Nat.Rec.add(n, n))) = complexImaginaryUnit)
proof
  induction n
  | zero =>
    left
    constructor
    . rw [Grace.Core.Nat.Rec.add, monoidPow.succ, monoidPow.zero]
      have ring := complexes.comm_ring
      have iIn := complexImaginaryUnit.member
      ring
    . rw [Grace.Core.Nat.Rec.add, monoidPow.succ, monoidPow.zero]
      have ring := complexes.comm_ring
      have iIn := complexImaginaryUnit.member
      ring
  | succ(k) using ih =>
    have ring := complexes.comm_ring
    have ordinary := IsCommRing.ring with ring
    have iIn := complexImaginaryUnit.member
    have niIn := IsRing.neg_closed with ordinary, iIn
    cases ih with first | second
    . right
      constructor
      . rw [natural.double_successor, monoidPow.succ, monoidPow.succ, first.left]
        exact complexImaginaryUnit.twice with *
      . rw [natural.double_successor, monoidPow.succ, monoidPow.succ, first.right, complexImaginaryUnit.negative_twice]
        ring
    . left
      constructor
      . rw [natural.double_successor, monoidPow.succ, monoidPow.succ, second.left, complexImaginaryUnit.twice]
        ring
      . rw [natural.double_successor, monoidPow.succ, monoidPow.succ, second.right]
        exact complexImaginaryUnit.negative_twice with *

end Complexes
