-- Ferrari's solution of the quartic over the complex numbers: a depressed
-- quartic y⁴ + py² + qy + r is a difference of two squares once m solves the
-- resolvent cubic, so its roots are roots of two quadratics, and a general
-- monic quartic is depressed by the shift x = y − a/4
-- Part of Cumulus, the Grace17 mathematics library.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module Grace.Cumulus.Complex.Quartic
import Cubic

section Complexes
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg, complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

theorem complex.two_nonzero
  shows ℂ[2] ≠ ℂ[0]
proof
  have positive : 0 < 2 by arith
  exact complexNumeral.nonzero with positive

theorem complex.zero_of_square (s : Set)
  requires sIn : s ∈ ℂ
  requires square : ℂ[s * s] = ℂ[0]
  shows s = ℂ[0]
proof
  have alternatives : s = ℂ[0] ∨ s ≠ ℂ[0] by tauto
  cases alternatives with zero | nonzero
  . exact zero
  . exact complex.zero_of_mul with sIn, sIn, nonzero, square

-- Ferrari's identity: with α² = 2m, αγ = q, and γ² = 4m² + 4pm + p² − 4r,
-- four times the depressed quartic is (2y² + p + 2m)² − (2αy − γ)².
theorem quartic.ferrari_identity (p q r m α γ y : Set)
  requires pIn : p ∈ ℂ
  requires qIn : q ∈ ℂ
  requires rIn : r ∈ ℂ
  requires mIn : m ∈ ℂ
  requires alphaIn : α ∈ ℂ
  requires gammaIn : γ ∈ ℂ
  requires yIn : y ∈ ℂ
  requires alphaSquare : ℂ[α * α] = ℂ[2 * m]
  requires gamma : ℂ[α * γ] = q
  requires gammaSquare : ℂ[γ * γ] = ℂ[2 * 2 * (m * m) + 2 * 2 * (p * m) + p * p + -(2 * 2 * r)]
  shows ℂ[2 * 2 * (y * y * y * y + p * (y * y) + q * y + r)] = ℂ[(2 * (y * y) + p + 2 * m) * (2 * (y * y) + p + 2 * m) + -((2 * (α * y) + -γ) * (2 * (α * y) + -γ))]
proof
  linear_combination (ℂ[2 * 2 * (y * y)]) * alphaSquare + (ℂ[-(2 * 2 * y)]) * gamma + gammaSquare

-- A root of either Ferrari quadratic is a root of the depressed quartic.
theorem quartic.root_of_factor (p q r m α γ y : Set)
  requires pIn : p ∈ ℂ
  requires qIn : q ∈ ℂ
  requires rIn : r ∈ ℂ
  requires mIn : m ∈ ℂ
  requires alphaIn : α ∈ ℂ
  requires gammaIn : γ ∈ ℂ
  requires yIn : y ∈ ℂ
  requires alphaSquare : ℂ[α * α] = ℂ[2 * m]
  requires gamma : ℂ[α * γ] = q
  requires gammaSquare : ℂ[γ * γ] = ℂ[2 * 2 * (m * m) + 2 * 2 * (p * m) + p * p + -(2 * 2 * r)]
  requires factor : ℂ[2 * (y * y) + -(2 * (α * y)) + (p + 2 * m + γ)] = ℂ[0]
  shows ℂ[y * y * y * y + p * (y * y) + q * y + r] = ℂ[0]
proof
  have two := complex.two_nonzero
  have twoIn : ℂ[2] ∈ ℂ by typecheck
  have four := complex.mul_nonzero with two, two
  have fourIn : ℂ[2 * 2] ∈ ℂ by typecheck
  have quarticIn : ℂ[y * y * y * y + p * (y * y) + q * y + r] ∈ ℂ by typecheck
  have identity := quartic.ferrari_identity at p, q, r, m, α, γ, y with *
  have scaled : ℂ[2 * 2 * (y * y * y * y + p * (y * y) + q * y + r)] = ℂ[0]
    rw identity
    linear_combination (ℂ[2 * (y * y) + p + 2 * m + 2 * (α * y) + -γ]) * factor
  exact complex.zero_of_mul with four, scaled

-- Every depressed quartic has a root given by Ferrari's method: m solves the
-- resolvent cubic, α² = 2m, γ = q/α (or γ² = p² − 4r when m = 0), and y
-- solves 2y² − 2αy + (p + 2m + γ) = 0.
theorem quartic.depressed_solution (p q r : Set)
  requires pIn : p ∈ ℂ
  requires qIn : q ∈ ℂ
  requires rIn : r ∈ ℂ
  shows ∃ y ∈ ℂ, ℂ[y * y * y * y + p * (y * y) + q * y + r] = ℂ[0] ∧ ∃ m ∈ ℂ, ∃ α ∈ ℂ, ∃ γ ∈ ℂ, ℂ[2 * 2 * 2 * (m * m * m) + 2 * 2 * 2 * (p * (m * m)) + 2 * (p * p * m) + -(2 * 2 * 2 * (r * m)) + -(q * q)] = ℂ[0] ∧ ℂ[α * α] = ℂ[2 * m] ∧ ℂ[α * γ] = q ∧ ℂ[2 * (y * y) + -(2 * (α * y)) + (p + 2 * m + γ)] = ℂ[0]
proof
  have zeroIn := complexZero.member
  have two := complex.two_nonzero
  have twoIn : ℂ[2] ∈ ℂ by typecheck
  have four := complex.mul_nonzero with two, two
  have fourIn : ℂ[2 * 2] ∈ ℂ by typecheck
  obtain ⟨h, hIn, half⟩ := complex.inverse_exists with two
  obtain ⟨e, eIn, quarter⟩ := complex.inverse_exists with four
  have linearIn : ℂ[p * p * e + -r] ∈ ℂ by typecheck
  have constantIn : ℂ[-(q * q * (e * h))] ∈ ℂ by typecheck
  obtain ⟨m, mIn, monic⟩ := cubic.root_exists at p, ℂ[p * p * e + -r], ℂ[-(q * q * (e * h))] with pIn, linearIn, constantIn
  have resolvent : ℂ[2 * 2 * 2 * (m * m * m) + 2 * 2 * 2 * (p * (m * m)) + 2 * (p * p * m) + -(2 * 2 * 2 * (r * m)) + -(q * q)] = ℂ[0]
    linear_combination (ℂ[2 * 2 * 2]) * monic + (ℂ[-(2 * (p * p * m)) + q * q * (2 * h)]) * quarter + (ℂ[q * q]) * half
  have data : ∃ α ∈ ℂ, ∃ γ ∈ ℂ, ℂ[α * α] = ℂ[2 * m] ∧ ℂ[α * γ] = q ∧ ℂ[γ * γ] = ℂ[2 * 2 * (m * m) + 2 * 2 * (p * m) + p * p + -(2 * 2 * r)]
    have alternatives : m = ℂ[0] ∨ m ≠ ℂ[0] by tauto
    cases alternatives with mZero | mNonzero
    . have squareZero : ℂ[q * q] = ℂ[0]
        rw mZero at resolvent
        linear_combination -resolvent
      have qZero := complex.zero_of_square with qIn, squareZero
      have discriminantIn : ℂ[p * p + -(2 * 2 * r)] ∈ ℂ by typecheck
      obtain ⟨γ, gammaIn, gammaRoot⟩ := complex.square_root with discriminantIn
      witness ℂ[0]
      constructor
      . exact zeroIn
      . witness γ
        constructor
        . exact gammaIn
        . constructor
          . rw mZero
            ring
          . constructor
            . rw qZero
              ring
            . rw mZero
              linear_combination gammaRoot
    . have twoMIn : ℂ[2 * m] ∈ ℂ by typecheck
      have twoMNonzero := complex.mul_nonzero with mIn, two, mNonzero
      obtain ⟨α, alphaIn, alphaSquare⟩ := complex.square_root with twoMIn
      have alphaNonzero : α ≠ ℂ[0]
        intro alphaZero
        rw alphaZero at alphaSquare
        apply twoMNonzero
        linear_combination -alphaSquare
      obtain ⟨w, wIn, unit⟩ := complex.inverse_exists with alphaIn, alphaNonzero
      have gammaIn : ℂ[q * w] ∈ ℂ by typecheck
      have scale : ℂ[2 * m * (w * w)] = ℂ[1]
        linear_combination (ℂ[-(w * w)]) * alphaSquare + (ℂ[α * w + 1]) * unit
      witness α
      constructor
      . exact alphaIn
      . witness ℂ[q * w]
        constructor
        . exact gammaIn
        . constructor
          . exact alphaSquare
          . constructor
            . linear_combination q * unit
            . linear_combination (ℂ[2 * 2 * (m * m) + 2 * 2 * (p * m) + p * p + -(2 * 2 * r)]) * scale + (ℂ[-(w * w)]) * resolvent
  obtain ⟨α, alphaIn, γ, gammaIn, alphaSquare, gamma, gammaSquare⟩ := data
  have quadraticConstantIn : ℂ[(p + 2 * m + γ) * h] ∈ ℂ by typecheck
  have quadraticLinearIn : ℂ[-α] ∈ ℂ by typecheck
  obtain ⟨y, yIn, yRoot⟩ := complexPolynomial.quadratic_root with quadraticConstantIn, quadraticLinearIn
  have list : List(ℂ, [ℂ[(p + 2 * m + γ) * h], ℂ[-α]]) by typecheck
  have tail : List(ℂ, [ℂ[-α]]) by typecheck
  have empty : List(ℂ, []) by typecheck
  rw [complexPolynomial.horner_value, hornerAt.cons, hornerAt.cons, hornerAt.nil] at yRoot
  have factor : ℂ[2 * (y * y) + -(2 * (α * y)) + (p + 2 * m + γ)] = ℂ[0]
    linear_combination (ℂ[2]) * yRoot + (ℂ[-(p + 2 * m + γ)]) * half
  have root := quartic.root_of_factor with *
  witness y
  constructor
  . exact yIn
  . constructor
    . exact root
    . witness m
      constructor
      . exact mIn
      . witness α
        constructor
        . exact alphaIn
        . witness γ
          constructor
          . exact gammaIn
          . exact ⟨resolvent, ⟨alphaSquare, ⟨gamma, factor⟩⟩⟩

-- The shift x = y − a·e with 4e = 1 depresses a monic quartic.
theorem quartic.depress (a b c d e y : Set)
  requires aIn : a ∈ ℂ
  requires bIn : b ∈ ℂ
  requires cIn : c ∈ ℂ
  requires dIn : d ∈ ℂ
  requires eIn : e ∈ ℂ
  requires yIn : y ∈ ℂ
  requires quarter : ℂ[2 * 2 * e] = ℂ[1]
  shows ℂ[(y + -(a * e)) * (y + -(a * e)) * (y + -(a * e)) * (y + -(a * e)) + a * ((y + -(a * e)) * (y + -(a * e)) * (y + -(a * e))) + b * ((y + -(a * e)) * (y + -(a * e))) + c * (y + -(a * e)) + d] = ℂ[y * y * y * y + (b + -((3 + 3) * (a * a * (e * e)))) * (y * y) + (c + -(2 * (a * b * e)) + 2 * 2 * 2 * (a * a * a * (e * e * e))) * y + (d + -(a * c * e) + a * a * b * (e * e) + -(3 * (a * a * a * a * (e * e * e * e))))]
proof
  linear_combination (ℂ[-(a * ((y + -(a * e)) * (y + -(a * e)) * (y + -(a * e))))]) * quarter

-- Ferrari's solution of the general monic quartic.
theorem quartic.solution (a b c d : Set)
  requires aIn : a ∈ ℂ
  requires bIn : b ∈ ℂ
  requires cIn : c ∈ ℂ
  requires dIn : d ∈ ℂ
  shows ∃ x ∈ ℂ, ℂ[x * x * x * x + a * (x * x * x) + b * (x * x) + c * x + d] = ℂ[0] ∧ ∃ e ∈ ℂ, ∃ y ∈ ℂ, ℂ[2 * 2 * e] = ℂ[1] ∧ x = ℂ[y + -(a * e)] ∧ ℂ[y * y * y * y + (b + -((3 + 3) * (a * a * (e * e)))) * (y * y) + (c + -(2 * (a * b * e)) + 2 * 2 * 2 * (a * a * a * (e * e * e))) * y + (d + -(a * c * e) + a * a * b * (e * e) + -(3 * (a * a * a * a * (e * e * e * e))))] = ℂ[0]
proof
  have two := complex.two_nonzero
  have four := complex.mul_nonzero with two, two
  obtain ⟨e, eIn, quarter⟩ := complex.inverse_exists with four
  have pIn : ℂ[b + -((3 + 3) * (a * a * (e * e)))] ∈ ℂ by typecheck
  have qIn : ℂ[c + -(2 * (a * b * e)) + 2 * 2 * 2 * (a * a * a * (e * e * e))] ∈ ℂ by typecheck
  have rIn : ℂ[d + -(a * c * e) + a * a * b * (e * e) + -(3 * (a * a * a * a * (e * e * e * e)))] ∈ ℂ by typecheck
  obtain ⟨y, yIn, root, rest⟩ := quartic.depressed_solution with pIn, qIn, rIn
  have identity := quartic.depress with aIn, bIn, cIn, dIn, eIn, yIn, quarter
  have xIn : ℂ[y + -(a * e)] ∈ ℂ by typecheck
  witness ℂ[y + -(a * e)]
  constructor
  . exact xIn
  . constructor
    . rw identity
      exact root
    . witness e
      constructor
      . exact eIn
      . witness y
        constructor
        . exact yIn
        . exact ⟨quarter, ⟨rfl, root⟩⟩

end Complexes
