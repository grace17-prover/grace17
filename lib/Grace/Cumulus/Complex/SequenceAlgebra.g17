module Grace.Cumulus.Complex.SequenceAlgebra
import MinimumDirection
import Real.Analysis.Examples

def complexPairSequence (u v : Set) : Set := pairFunctions(u, v, ℕ, ℝ, ℝ)

theorem complexPairSequence.sequence (u v : Set)
  requires horizontal : RealSequence(u)
  requires vertical : RealSequence(v)
  shows ComplexSequence(complexPairSequence(u, v))
proof
  unfold ComplexSequence
  unfold complexPairSequence
  unfold complexCarrier
  exact pairFunctions.function with *

theorem complexPairSequence.value (u v : Set) (n : Nat)
  requires horizontal : RealSequence(u)
  requires vertical : RealSequence(v)
  shows complexPairSequence(u, v)(n) = (u(n), v(n))
proof
  unfold complexPairSequence
  exact pairFunctions.apply with *

theorem complexPairSequence.x (u v : Set)
  requires horizontal : RealSequence(u)
  requires vertical : RealSequence(v)
  shows complexSequenceX(complexPairSequence(u, v)) = u
proof
  have sequence := complexPairSequence.sequence at u, v with *
  have left := complexSequenceX.function at complexPairSequence(u, v) with *
  have right : u : ℕ → ℝ by exact horizontal
  apply FunctionBetween.ext with left, right
  intros n nIn
  have nNat := nat.omega.backward at n with *
  have un := RealSequence.value at u, n with *
  have vn := RealSequence.value at v, n with *
  rw [complexSequenceX.value, complexPairSequence.value, Euclidean.x.pair]
  rfl

theorem complexPairSequence.y (u v : Set)
  requires horizontal : RealSequence(u)
  requires vertical : RealSequence(v)
  shows complexSequenceY(complexPairSequence(u, v)) = v
proof
  have sequence := complexPairSequence.sequence at u, v with *
  have left := complexSequenceY.function at complexPairSequence(u, v) with *
  have right : v : ℕ → ℝ by exact vertical
  apply FunctionBetween.ext with left, right
  intros n nIn
  have nNat := nat.omega.backward at n with *
  have un := RealSequence.value at u, n with *
  have vn := RealSequence.value at v, n with *
  rw [complexSequenceY.value, complexPairSequence.value, Euclidean.y.pair]
  rfl

theorem complexPairSequence.converges (u v : Set) (a b : Real)
  requires horizontal : ConvergesTo(u, a)
  requires vertical : ConvergesTo(v, b)
  shows ComplexConvergesTo(complexPairSequence(u, v), (a, b))
proof
  have uSequence := ConvergesTo.sequence at u, a with *
  have vSequence := ConvergesTo.sequence at v, b with *
  have sequence := complexPairSequence.sequence at u, v with *
  have member := complexCarrier.pair at a, b with *
  unfold ComplexConvergesTo
  refine ⟨sequence, member, ?_⟩
  constructor
  . rw [complexPairSequence.x, Euclidean.x.pair]
    exact horizontal
  . rw [complexPairSequence.y, Euclidean.y.pair]
    exact vertical

def complexRaySequence (s z : Set) : Set := complexPairSequence(
  mulSequence(s, constantSequence(Euclidean.x(z))),
  mulSequence(s, constantSequence(Euclidean.y(z))))

defgraph complexLeftMul (z : Set) (w ∈ complexCarrier) : complexCarrier := complexMul(z, w)
requires factor : z ∈ complexCarrier
proof
  have ring := complexes.comm_ring
  have ordinary := IsCommRing.ring with ring
  exact IsRing.mul_closed with *

section Complexes
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg, complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

theorem complexRaySequence.sequence (s z : Set)
  requires steps : RealSequence(s)
  requires member : z ∈ ℂ
  shows ComplexSequence(complexRaySequence(s, z))
proof
  have point := complex.point with *
  have cx := constantSequence.sequence at Euclidean.x(z) with *
  have cy := constantSequence.sequence at Euclidean.y(z) with *
  have sx := mulSequence.sequence at s, constantSequence(Euclidean.x(z)) with *
  have sy := mulSequence.sequence at s, constantSequence(Euclidean.y(z)) with *
  unfold complexRaySequence
  exact complexPairSequence.sequence with *

theorem complexRaySequence.value (s z : Set) (n : Nat)
  requires steps : RealSequence(s)
  requires member : z ∈ ℂ
  shows complexRaySequence(s, z)(n) = complexScale(s(n), z)
proof
  have point := complex.point with *
  have cx := constantSequence.sequence at Euclidean.x(z) with *
  have cy := constantSequence.sequence at Euclidean.y(z) with *
  have sx := mulSequence.sequence at s, constantSequence(Euclidean.x(z)) with *
  have sy := mulSequence.sequence at s, constantSequence(Euclidean.y(z)) with *
  have sn := RealSequence.value at s, n with *
  have xn := RealSequence.value at constantSequence(Euclidean.x(z)), n with *
  have yn := RealSequence.value at constantSequence(Euclidean.y(z)), n with *
  unfold complexRaySequence
  rw [complexPairSequence.value, mulSequence.value, mulSequence.value, constantSequence.value, constantSequence.value]
  unfold complexScale
  rfl

theorem complexRaySequence.converges_zero (s z : Set)
  requires steps : ConvergesTo(s, realZero)
  requires member : z ∈ ℂ
  shows ComplexConvergesTo(complexRaySequence(s, z), ℂ[0])
proof
  have point := complex.point with *
  have cx := constantSequence.converges at Euclidean.x(z) with *
  have cy := constantSequence.converges at Euclidean.y(z) with *
  have sx := ConvergesTo.mul at s, constantSequence(Euclidean.x(z)), realZero, Euclidean.x(z) with *
  have sy := ConvergesTo.mul at s, constantSequence(Euclidean.y(z)), realZero, Euclidean.y(z) with *
  rw realMulValue.zero_left at sx
  rw realMulValue.zero_left at sy
  unfold complexRaySequence
  unfold complexZero
  exact complexPairSequence.converges with *

theorem complexLeftMul.continuous_at (z a : Set)
  requires member : z ∈ ℂ
  requires center : a ∈ ℂ
  shows ComplexContinuousAt(complexLeftMul(z), a)
proof
  have function := complexLeftMul.function at z with *
  have ring := complexes.comm_ring
  have ordinary := IsCommRing.ring with ring
  have scalePositive := limitScale.positive at complexNormSquared(z) with *
  unfold ComplexContinuousAt
  refine ⟨function, center, ?_⟩
  intros e eIn positive
  have radiusIn : scaledRadius(e, limitScale(complexNormSquared(z))) ∈ ℝ by typecheck
  have radiusPositive := scaledRadius.positive at e, limitScale(complexNormSquared(z)) with *
  refine ⟨scaledRadius(e, limitScale(complexNormSquared(z))), radiusIn, radiusPositive, ?_⟩
  intros x xIn near
  have negA := IsRing.neg_closed with ordinary, center
  have difference := IsRing.add_closed with ordinary, xIn, negA
  have nonnegative := complexNormSquared.nonnegative at ℂ[x - a] with *
  have control := scaledRadius.product_control with *
  rw [complexLeftMul.value, complexLeftMul.value]
  have distribute : ℂ[z * x - z * a] = ℂ[z * (x - a)] by ring
  rw [distribute, complexNormSquared.mul]
  have commute := realMulValue.commutative at complexNormSquared(z), complexNormSquared(ℂ[x - a]) with *
  rwa commute

theorem realPow.positive (t : Real) (n : Nat)
  requires positive : realZero < t
  shows realZero < realPow(t, n)
proof
  induction n
  | zero =>
    rw realPow.zero
    exact realZero.lt_one
  | succ(k) using ih =>
    rw realPow.succ
    exact realMulValue.positive with *

end Complexes
