-- Authors: Grant Passmore

module Grace.Cumulus.Complex.QuadraticRoots
import FTAReduction
import SquareDirections

section Complexes
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg, complexMul, complexOne)

theorem complexPolynomial.quadratic_root (c d : Set)
  requires constant : c ∈ ℂ
  requires linear : d ∈ ℂ
  shows ∃ a ∈ ℂ, complexPolynomial([c, d])(a) = ℂ[0]
proof
  obtain ⟨a, aIn, least⟩ := complexPolynomial.global_minimum at c, [d] with *
  have function := complexPolynomial.function at [c, d] with *
  have valueIn := FunctionBetween.apply_closed at complexPolynomial([c, d]), ℂ, ℂ, a with *
  have root : complexPolynomial([c, d])(a) = ℂ[0]
    by_contra nonzero
    obtain ⟨n, nIn, ds, dsList, residualNonzero, degree, pairing⟩ := complexPolynomial.minimum_power_pairing at c, a, [d] with *
    have nNat := nat.omega.backward at n with *
    have empty : List(ℂ, []) by typecheck
    rw [length.cons, length.nil] at degree
    have small : n ≤ (1:N) by arith
    have residualFunction := complexPolynomial.function at ds with *
    have zeroIn := complexZero.member
    have residualIn := FunctionBetween.apply_closed at complexPolynomial(ds), ℂ, ℂ, ℂ[0] with *
    obtain ⟨u, uIn, negative⟩ := complexDot.small_power_direction at complexPolynomial([c, d])(a), complexPolynomial(ds)(ℂ[0]), n with *
    have nonnegative := pairing with u, uIn
    have ring := complexes.comm_ring
    have ordinary := IsCommRing.ring with ring
    have monoid := IsRing.multiplicative with ordinary
    have power := monoidPow.closed at ℂ, complexMul, complexOne, u, succ(n) with *
    have product := IsRing.mul_closed with ordinary, power, residualIn
    have firstPoint := complex.point with valueIn
    have secondPoint := complex.point with product
    have impossible := realLe.transitive_less with *
    have irrefl := realLess.irreflexive_on
    exact irrefl with realZero, impossible
  refine ⟨a, aIn, root⟩

theorem complex.square_root (b : Set)
  requires member : b ∈ ℂ
  shows ∃ a ∈ ℂ, ℂ[a * a] = b
proof
  have ring := complexes.comm_ring
  have ordinary := IsCommRing.ring with ring
  have negative := IsRing.neg_closed with ordinary, member
  have zeroIn := complexZero.member
  obtain ⟨a, aIn, root⟩ := complexPolynomial.quadratic_root at ℂ[-b], ℂ[0] with *
  have list : List(ℂ, [ℂ[-b], ℂ[0]]) by typecheck
  have empty : List(ℂ, []) by typecheck
  have tail : List(ℂ, [ℂ[0]]) by typecheck
  have identity : ℂ[a * a] = ℂ[complexPolynomial([ℂ[-b], ℂ[0]])(a) + b]
    rw [complexPolynomial.horner_value, hornerAt.cons, hornerAt.cons, hornerAt.nil]
    ring
  rw root at identity
  have cancel : ℂ[0 + b] = b by ring
  rw cancel at identity
  refine ⟨a, aIn, identity⟩

end Complexes
