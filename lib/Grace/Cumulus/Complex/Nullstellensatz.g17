module Grace.Cumulus.Complex.Nullstellensatz
import FundamentalTheorem
import Algebra.Polynomial.Nullstellensatz

section ComplexPolynomials
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg, complexMul, complexOne)
variable (I G : Set)
notation ring P := ℂ[I]
hypothesis finite : Finite(I)
hypothesis generators : G ⊆ P

theorem complexes.weak_nullstellensatz
  shows P[1] ∈ idealSpan(P, G) ↔ ¬(∃ v, PolynomialCommonZero(I, ℂ, G, v))
proof
  have closed := complexes.algebraically_closed
  exact polynomialIdeal.unit_iff_no_common_zero with *

theorem complexes.unsatisfiable_iff_certificate
  shows (∃ terms, List(idealProducts(P, G), terms) ∧ P[1] = ringSum{idealProducts(P, G)}(polynomialAdd(I, ℂ), P[0], terms)) ↔ ¬(∃ v, PolynomialCommonZero(I, ℂ, G, v))
proof
  have closed := complexes.algebraically_closed
  exact polynomialIdeal.finite_certificate_iff_no_common_zero with *

end ComplexPolynomials
