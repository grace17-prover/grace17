module Grace.Cumulus.Complex.PolynomialMinimum
import Norm
import Algebra.Polynomial.HornerTranslation

defgraph complexPolynomial (cs : Set) (z ∈ complexCarrier) : complexCarrier := monicValue{complexCarrier}(identity(complexCarrier), complexAdd, complexMul, complexOne, z, cs)
requires coefficients : List(complexCarrier, cs)
proof
  have field := complexes.is_field
  have ring := IsField.comm_ring with field
  have hom := IsRingHom.identity with ring
  exact monicValue.closed with *

-- The analytic premises are hypotheses of the theorem; nothing here defines
-- algebraic closure.
theorem complexFunction.root_of_minimum_and_descent (p : Set)
  requires function : p : complexCarrier → complexCarrier
  requires minimum : ∃ a ∈ complexCarrier, ∀ z ∈ complexCarrier, complexNormSquared(p(a)) ≤ complexNormSquared(p(z))
  requires descent : ∀ a ∈ complexCarrier, p(a) ≠ complexZero → ∃ z ∈ complexCarrier, complexNormSquared(p(z)) < complexNormSquared(p(a))
  shows ∃ a ∈ complexCarrier, p(a) = complexZero
proof
  obtain ⟨a, member, least⟩ := minimum
  have image := FunctionBetween.apply_closed with *
  have root : p(a) = complexZero
    by_contra nonzero
    obtain ⟨z, zIn, smaller⟩ := descent with a, member, nonzero
    have otherImage := FunctionBetween.apply_closed at p, complexCarrier, complexCarrier, z with *
    have bound := least with z, zIn
    have impossible := realLe.transitive_less with *
    have irreflexive := realLess.irreflexive_on
    exact irreflexive with complexNormSquared(p(a)), impossible
  refine ⟨a, member, root⟩

section Polynomials
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg, complexMul, complexOne)

theorem complexPolynomial.root_of_minimum_and_descent (cs : List(complexCarrier))
  requires minimum : ∃ a ∈ ℂ, ∀ z ∈ ℂ, complexNormSquared(complexPolynomial(cs)(a)) ≤ complexNormSquared(complexPolynomial(cs)(z))
  requires descent : ∀ a ∈ ℂ, complexPolynomial(cs)(a) ≠ ℂ[0] → ∃ z ∈ ℂ, complexNormSquared(complexPolynomial(cs)(z)) < complexNormSquared(complexPolynomial(cs)(a))
  shows ∃ a ∈ ℂ, monicValue(ℂ, identity(ℂ), ℂ, a, cs) = ℂ[0]
proof
  have function := complexPolynomial.function at cs with *
  obtain ⟨a, member, root⟩ := complexFunction.root_of_minimum_and_descent at complexPolynomial(cs) with *
  have value := complexPolynomial.value at cs, a with *
  refine ⟨a, member, ?_⟩
  rwa value at root

end Polynomials
