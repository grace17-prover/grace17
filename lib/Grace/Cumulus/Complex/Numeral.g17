-- Numerals of ℂ: the numeral n in a complex ring scope is the pair (n, 0),
-- so 3 may be written in place of 1 + 1 + 1.
-- Part of Cumulus, the Grace17 mathematics library.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module Grace.Cumulus.Complex.Numeral
import Ring
import Real.Natural
import Real.RootTwo

section Numerals
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg, complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

theorem complexNumeral.pair (n : Nat)
  shows ringNat(complexAdd, complexZero, complexOne, n) =
    (realNumeral(n), realZero)
proof
  induction n
  | zero =>
    rw [ringNat.zero, realNumeral.nat, realNat.zero]
    unfold complexZero
    rfl
  | succ(k) using ih =>
    have step := realNumeral.succ at k with *
    have pair := complexAdd.pair at realNumeral(k), realZero, realOne,
      realZero with *
    have second : R[realZero + realZero] = realZero by linarith
    rw [ringNat.succ, ih, step]
    unfold complexOne
    simp [pair, second]

theorem complexNumeral.member (n : Nat)
  shows ringNat(complexAdd, complexZero, complexOne, n) ∈ ℂ
proof
  have pair := complexNumeral.pair at n with *
  have real := realNumeral.real at n with *
  rw pair
  typecheck

-- A nonzero numeral is a nonzero complex number.
theorem complexNumeral.nonzero (n : Nat)
  requires positive : 0 < n
  shows ringNat(complexAdd, complexZero, complexOne, n) ≠ ℂ[0]
proof
  intro same
  have pair := complexNumeral.pair at n with *
  rw pair at same
  unfold complexZero at same
  have coordinates := orderedPair.injective with same
  have first := coordinates.left
  have real := realNumeral.real at n with *
  have bridge := realNumeral.nat at n with *
  rw bridge at first
  have below := realNat.lt_of_lt at 0, n with *
  rw realNat.zero at below
  linarith

end Numerals
