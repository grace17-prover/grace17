-- Authors: Grant Passmore

module Grace.Cumulus.Complex.OddDirections
import PowerArithmetic

section Complexes
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg, complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

theorem complexDot.neg_right (z w : Set)
  requires first : z ∈ ℂ
  requires second : w ∈ ℂ
  shows Euclidean.dot(z, ℂ[-w]) = R[-Euclidean.dot(z, w)]
proof
  obtain ⟨a, aReal, b, bReal, zs⟩ := complexCarrier.cases at z with *
  obtain ⟨c, cReal, d, dReal, ws⟩ := complexCarrier.cases at w with *
  rw [zs, ws]
  simp [complexNeg.pair, Euclidean.dot, Euclidean.x.pair, Euclidean.y.pair]
  ring

theorem complexDot.imaginary_pair (a b c d : Real)
  shows Euclidean.dot((a, b), ℂ[complexImaginaryUnit * (c, d)]) = R[b * c - a * d]
proof
  unfold complexImaginaryUnit
  simp [complexMul.pair, Euclidean.dot, Euclidean.x.pair, Euclidean.y.pair]
  ring

theorem complexDot.square_zero (z w u : Set)
  requires first : z ∈ ℂ
  requires second : w ∈ ℂ
  requires direction : u ∈ ℂ
  requires realPart : Euclidean.dot(z, w) = realZero
  requires imaginaryPart : Euclidean.dot(z, ℂ[complexImaginaryUnit * w]) = realZero
  shows Euclidean.dot(z, ℂ[(u * u) * w]) = realZero
proof
  obtain ⟨a, aReal, b, bReal, zs⟩ := complexCarrier.cases at z with *
  obtain ⟨c, cReal, d, dReal, ws⟩ := complexCarrier.cases at w with *
  obtain ⟨x, xReal, y, yReal, us⟩ := complexCarrier.cases at u with *
  rw [zs, ws] at realPart
  simp [Euclidean.dot, Euclidean.x.pair, Euclidean.y.pair] at realPart
  rw [zs, ws, complexDot.imaginary_pair] at imaginaryPart
  rw [zs, ws, us, complexDot.square_pair, realPart, imaginaryPart]
  ring

theorem complexDot.odd_power_direction (z w : Set) (n : Nat)
  requires first : z ∈ ℂ
  requires second : w ∈ ℂ
  requires nonzeroZ : z ≠ ℂ[0]
  requires nonzeroW : w ≠ ℂ[0]
  shows ∃ u ∈ ℂ, Euclidean.dot(z, ℂ[u ^ (succ(Grace.Core.Nat.Rec.add(n, n))) * w]) < realZero
proof
  by_contra noDirection
  have ring := complexes.comm_ring
  have ordinary := IsCommRing.ring with ring
  have monoid := IsRing.multiplicative with ordinary
  have pointZ := complex.point at z with *
  have all : ∀ u ∈ ℂ, realZero ≤ Euclidean.dot(z, ℂ[u ^ (succ(Grace.Core.Nat.Rec.add(n, n))) * w])
    intros u uIn
    have power := monoidPow.closed at ℂ, complexMul, complexOne, u, succ(Grace.Core.Nat.Rec.add(n, n)) with *
    have product := IsRing.mul_closed with ordinary, power, second
    have point := complex.point with product
    by_contra notNonnegative
    have negative := realLess.of_not_le with *
    apply noDirection
    refine ⟨u, uIn, negative⟩
  have oneIn := complexOne.member
  have negOne := IsRing.neg_closed with ordinary, oneIn
  have iIn := complexImaginaryUnit.member
  have niIn := IsRing.neg_closed with ordinary, iIn
  have iw := IsRing.mul_closed with ordinary, iIn, second
  have oneBound := all with ℂ[1], oneIn
  have negBound := all with ℂ[-1], negOne
  rw complexPower.one at oneBound
  rw complexPower.negative_one_odd at negBound
  have unit : ℂ[1 * w] = w by ring
  have negativeUnit : ℂ[(-1) * w] = ℂ[-w] by ring
  rw unit at oneBound
  rw [negativeUnit, complexDot.neg_right] at negBound
  have pointW := complex.point at w with *
  have realPart := realLe.zero_of_opposite_bounds with *
  have iBound := all with complexImaginaryUnit, iIn
  have niBound := all with ℂ[-complexImaginaryUnit], niIn
  have negativeProduct : ℂ[(-complexImaginaryUnit) * w] = ℂ[-(complexImaginaryUnit * w)] by ring
  have iwPoint := complex.point with iw
  have imaginaryPart : Euclidean.dot(z, ℂ[complexImaginaryUnit * w]) = realZero
    have alternatives := complexPower.imaginary_odd with *
    cases alternatives with direct | reversed
    . rw direct.left at iBound
      rw [direct.right, negativeProduct, complexDot.neg_right] at niBound
      exact realLe.zero_of_opposite_bounds with *
    . rw reversed.left at iBound
      rw reversed.right at niBound
      rw [negativeProduct, complexDot.neg_right] at iBound
      exact realLe.zero_of_opposite_bounds with *
  obtain ⟨u, uIn, negative⟩ := complexDot.square_direction at z, w with *
  have zero := complexDot.square_zero at z, w, u with *
  rw zero at negative
  have irrefl := realLess.irreflexive_on
  exact irrefl with realZero, negative

end Complexes
