module Grace.Cumulus.Complex.PolynomialGrowth
import Continuity

predicate ComplexDiskMinimum (p radius : Set) :=
  ∃ a ∈ complexCarrier, complexNormSquared(a) ≤ radius ∧
    (∀ z ∈ complexCarrier, complexNormSquared(z) ≤ radius → complexNormSquared(p(a)) ≤ complexNormSquared(p(z)))

theorem realLe.two_sum_cancel (a b c : Real)
  requires bound : (2:R) * (a + c) ≤ (2:R) * (b + c)
  shows a ≤ b
proof
  have onePositive := realZero.lt_one
  have twoPositive : (0:R) < 2 by linarith
  have first : (2:R) * (a + c) = (a + c) * (2:R) by ring
  have second : (2:R) * (b + c) = (b + c) * (2:R) by ring
  rw [first, second] at bound
  have sums := realLe.mul_right_cancel_positive with *
  have translated := realLe.add_right at a + c, b + c, -c with *
  have left : (a + c) + (-c) = a by ring
  have right : (b + c) + (-c) = b by ring
  rwa [left, right] at translated

theorem realLe.nonnegative_sum_bounds (a b : Real)
  requires first : realZero ≤ a
  requires second : realZero ≤ b
  shows realZero ≤ a + b ∧ a ≤ a + b ∧ b ≤ a + b
proof
  have sum := realLe.add at realZero, a, realZero, b with *
  rw realAddValue.zero_left at sum
  have left := realLe.add_left at realZero, b, a with *
  rw realAddValue.zero_right at left
  have right := realLe.add_right at realZero, a, b with *
  rw realAddValue.zero_left at right
  refine ⟨sum, left, right⟩

section Complexes
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg, complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

theorem complexNormSquared.horner_step_lower_bound (c z w : Set) (target : Real)
  requires coefficient : c ∈ ℂ
  requires first : z ∈ ℂ
  requires second : w ∈ ℂ
  requires unitBound : R[1] ≤ complexNormSquared(w)
  requires large : R[2 * (target + complexNormSquared(c))] ≤ complexNormSquared(z)
  shows target ≤ complexNormSquared(ℂ[c + z * w])
proof
  have field := complexes.is_field
  have ring := IsField.comm_ring with field
  have ordinary := IsCommRing.ring with ring
  have product := IsRing.mul_closed with ordinary, first, second
  have sum := IsRing.add_closed with ordinary, coefficient, product
  have negated := IsRing.neg_closed with ordinary, coefficient
  have productReal := complexNormSquared.real with product
  have zNonnegative := complexNormSquared.nonnegative with first
  have multiplied := realLe.mul_left_of_nonnegative at realOne, complexNormSquared(w), complexNormSquared(z) with *
  rw realMulValue.one_right at multiplied
  have normProduct := complexNormSquared.mul at z, w with *
  rw ← normProduct at multiplied
  have reverse := complexNormSquared.add_bound at ℂ[c + z * w], ℂ[-c] with *
  have cancel : ℂ[(c + z * w) + (-c)] = ℂ[z * w] by ring
  rw [cancel, complexNormSquared.neg] at reverse
  have lower := realLe.transitive at R[2 * (target + complexNormSquared(c))], complexNormSquared(z), complexNormSquared(ℂ[z * w]) with *
  have sandwich := realLe.transitive at R[2 * (target + complexNormSquared(c))], complexNormSquared(ℂ[z * w]), R[2 * (complexNormSquared(ℂ[c + z * w]) + complexNormSquared(c))] with *
  exact realLe.two_sum_cancel with *

theorem complexPolynomial.eventually_unit_bound (cs : List(complexCarrier))
  shows ∃ radius ∈ ℝ, realZero ≤ radius ∧ (∀ z ∈ ℂ, radius ≤ complexNormSquared(z) → R[1] ≤ complexNormSquared(hornerAt{complexCarrier}(complexAdd, complexMul, complexOne, z, cs)))
proof
  have field := complexes.is_field
  have ring := IsField.comm_ring with field
  have oneNonnegative := realLess.implies_le with realZero.real, realOne.real, realZero.lt_one
  induction cs
  | List.nil =>
    have zeroIn : realZero ∈ ℝ by typecheck
    have zeroReflexive := realLe.reflexive at realZero with *
    refine ⟨realZero, zeroIn, zeroReflexive, ?_⟩
    intros z member outside
    rw [hornerAt.nil, complexNormSquared.one]
    exact realLe.reflexive with *
  | List.cons(c, tail) using ih =>
    have coefficient : c ∈ ℂ by assumption
    obtain ⟨r, rIn, rNonnegative, tailBound⟩ := ih
    have cNonnegative := complexNormSquared.nonnegative with coefficient
    have thresholdNonnegative := realLe.two_sum_nonnegative at realOne, complexNormSquared(c) with *
    have bounds := realLe.nonnegative_sum_bounds at r, R[2 * (1 + complexNormSquared(c))] with *
    have radiusIn : R[r + 2 * (1 + complexNormSquared(c))] ∈ ℝ by typecheck
    refine ⟨R[r + 2 * (1 + complexNormSquared(c))], radiusIn, bounds.left, ?_⟩
    intros z member outside
    have beyondTail := realLe.transitive at r, R[r + 2 * (1 + complexNormSquared(c))], complexNormSquared(z) with *
    have beyondThreshold := realLe.transitive at R[2 * (1 + complexNormSquared(c))], R[r + 2 * (1 + complexNormSquared(c))], complexNormSquared(z) with *
    have tailLarge := tailBound with z, member, beyondTail
    have tailValue := hornerAt.closed at complexCarrier, complexAdd, complexZero, complexNeg, complexMul, complexOne, complexOne, z, tail with *
    have bound := complexNormSquared.horner_step_lower_bound with *
    rwa hornerAt.cons

theorem complexPolynomial.eventually_above (c : Set) (target : Real) (cs : List(complexCarrier))
  requires coefficient : c ∈ ℂ
  requires targetNonnegative : realZero ≤ target
  shows ∃ radius ∈ ℝ, realZero ≤ radius ∧ (∀ z ∈ ℂ, radius ≤ complexNormSquared(z) → target ≤ complexNormSquared(complexPolynomial(c :: cs)(z)))
proof
  have field := complexes.is_field
  have ring := IsField.comm_ring with field
  obtain ⟨r, rIn, rNonnegative, tailBound⟩ := complexPolynomial.eventually_unit_bound at cs with *
  have cNonnegative := complexNormSquared.nonnegative with coefficient
  have thresholdNonnegative := realLe.two_sum_nonnegative at target, complexNormSquared(c) with *
  have bounds := realLe.nonnegative_sum_bounds at r, R[2 * (target + complexNormSquared(c))] with *
  have radiusIn : R[r + 2 * (target + complexNormSquared(c))] ∈ ℝ by typecheck
  refine ⟨R[r + 2 * (target + complexNormSquared(c))], radiusIn, bounds.left, ?_⟩
  intros z member outside
  have beyondTail := realLe.transitive at r, R[r + 2 * (target + complexNormSquared(c))], complexNormSquared(z) with *
  have beyondThreshold := realLe.transitive at R[2 * (target + complexNormSquared(c))], R[r + 2 * (target + complexNormSquared(c))], complexNormSquared(z) with *
  have tailLarge := tailBound with z, member, beyondTail
  have tailValue := hornerAt.closed at complexCarrier, complexAdd, complexZero, complexNeg, complexMul, complexOne, complexOne, z, cs with *
  have bound := complexNormSquared.horner_step_lower_bound at c, z, hornerAt{complexCarrier}(complexAdd, complexMul, complexOne, z, cs), target with *
  have evaluation := complexPolynomial.value at c :: cs, z with *
  rw evaluation
  have expansion := hornerAt.cons at complexCarrier, complexAdd, complexMul, complexOne, z, c, cs with *
  unfold hornerAt at expansion
  rwa expansion

theorem complexPolynomial.grows_at_infinity (c : Set) (target : Real) (cs : List(complexCarrier))
  requires coefficient : c ∈ ℂ
  shows ∃ radius ∈ ℝ, realZero ≤ radius ∧ (∀ z ∈ ℂ, radius ≤ complexNormSquared(z) → target < complexNormSquared(complexPolynomial(c :: cs)(z)))
proof
  have scaleReal := limitScale.real with *
  have positive := limitScale.positive at target with *
  have nonnegative := realLess.implies_le with *
  have absoluteBound := abs.upper at target with *
  have scaleBound := abs.lt_limitScale at target with *
  have targetLess := realLe.transitive_less at target, abs(target), limitScale(target) with *
  obtain ⟨radius, radiusIn, radiusNonnegative, grows⟩ := complexPolynomial.eventually_above at c, limitScale(target), cs with *
  refine ⟨radius, radiusIn, radiusNonnegative, ?_⟩
  intros z member outside
  have lower := grows with z, member, outside
  have function := complexPolynomial.function at c :: cs with *
  have image := FunctionBetween.apply_closed at complexPolynomial(c :: cs), complexCarrier, complexCarrier, z with *
  exact realLess.transitive_le with *

theorem complexFunction.global_minimum_of_disk_minimum (p : Set) (radius : Real)
  requires function : p : ℂ → ℂ
  requires nonnegative : realZero ≤ radius
  requires escape : ∀ z ∈ ℂ, radius ≤ complexNormSquared(z) → complexNormSquared(p(ℂ[0])) < complexNormSquared(p(z))
  requires diskMinimum : ComplexDiskMinimum(p, radius)
  shows ∃ a ∈ ℂ, ∀ z ∈ ℂ, complexNormSquared(p(a)) ≤ complexNormSquared(p(z))
proof
  obtain ⟨a, member, inside, least⟩ := diskMinimum
  have field := complexes.is_field
  have ring := IsField.comm_ring with field
  have zeroInside : complexNormSquared(ℂ[0]) ≤ radius by rwa complexNormSquared.zero
  have atZero := least with complexZero, zeroInside
  have imageA := FunctionBetween.apply_closed with *
  have imageZero := FunctionBetween.apply_closed at p, complexCarrier, complexCarrier, complexZero with *
  refine ⟨a, member, ?_⟩
  intros z zIn
  have imageZ := FunctionBetween.apply_closed at p, complexCarrier, complexCarrier, z with *
  have location : complexNormSquared(z) ≤ radius ∨ ¬ (complexNormSquared(z) ≤ radius) by tauto
  cases location with within | outside
  . exact least with z, zIn, within
  . have strict := realLess.of_not_le at complexNormSquared(z), radius with *
    have beyond := realLess.implies_le at radius, complexNormSquared(z) with *
    have larger := escape with z, zIn, beyond
    have leastStrict := realLe.transitive_less at complexNormSquared(p(a)), complexNormSquared(p(ℂ[0])), complexNormSquared(p(z)) with *
    exact realLess.implies_le with *

theorem complexPolynomial.minimum_of_disk_minima (c : Set) (cs : List(complexCarrier))
  requires coefficient : c ∈ ℂ
  requires diskMinima : ∀ radius ∈ ℝ, realZero ≤ radius → ComplexDiskMinimum(complexPolynomial(c :: cs), radius)
  shows ∃ a ∈ ℂ, ∀ z ∈ ℂ, complexNormSquared(complexPolynomial(c :: cs)(a)) ≤ complexNormSquared(complexPolynomial(c :: cs)(z))
proof
  have function := complexPolynomial.function at c :: cs with *
  have field := complexes.is_field
  have ring := IsField.comm_ring with field
  have image := FunctionBetween.apply_closed at complexPolynomial(c :: cs), complexCarrier, complexCarrier, complexZero with *
  obtain ⟨radius, radiusIn, nonnegative, escape⟩ := complexPolynomial.grows_at_infinity at c, complexNormSquared(complexPolynomial(c :: cs)(ℂ[0])), cs with *
  have diskMinimum := diskMinima with radius, radiusIn, nonnegative
  exact complexFunction.global_minimum_of_disk_minimum with *

theorem complexPolynomial.root_of_disk_minima_and_descent (c : Set) (cs : List(complexCarrier))
  requires coefficient : c ∈ ℂ
  requires diskMinima : ∀ radius ∈ ℝ, realZero ≤ radius → ComplexDiskMinimum(complexPolynomial(c :: cs), radius)
  requires descent : ∀ a ∈ ℂ, complexPolynomial(c :: cs)(a) ≠ ℂ[0] → ∃ z ∈ ℂ, complexNormSquared(complexPolynomial(c :: cs)(z)) < complexNormSquared(complexPolynomial(c :: cs)(a))
  shows ∃ a ∈ ℂ, monicValue(ℂ, identity(ℂ), ℂ, a, c :: cs) = ℂ[0]
proof
  have minimum := complexPolynomial.minimum_of_disk_minima with *
  exact complexPolynomial.root_of_minimum_and_descent with *

end Complexes
