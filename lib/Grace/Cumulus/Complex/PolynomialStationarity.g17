-- The first nonconstant term at a global minimum has nonnegative real pairing.
-- Part of Cumulus, the Grace17 mathematics library.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module Grace.Cumulus.Complex.PolynomialStationarity
import SequenceAlgebra

section Complexes
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg, complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

theorem complexPolynomial.minimum_leading_term (c a s : Set) (cs : List(ℂ))
  requires coefficient : c ∈ ℂ
  requires center : a ∈ ℂ
  requires steps : ConvergesTo(s, realZero)
  requires positive : ∀ j ∈ ℕ, realZero < s(j)
  requires minimum : ∀ z ∈ ℂ, complexNormSquared(complexPolynomial(c :: cs)(a)) ≤ complexNormSquared(complexPolynomial(c :: cs)(z))
  shows ∃ n ∈ ℕ, ∃ ds, List(ℂ, ds) ∧ complexPolynomial(ds)(ℂ[0]) ≠ ℂ[0] ∧
    length{ℂ}(cs) = Grace.Core.Nat.Rec.add(n, length{ℂ}(ds)) ∧
    (∀ u ∈ ℂ, realZero ≤ Euclidean.dot(complexPolynomial(c :: cs)(a), ℂ[u ^ succ(n) * complexPolynomial(ds)(ℂ[0])]))
proof
  obtain ⟨n, nIn, ds, dsList, nonzero, degree, continuous, expansion⟩ := complexPolynomial.ray_normal_form at c, a, cs with *
  have nNat := nat.omega.backward at n with *
  have pFunction := complexPolynomial.function at c :: cs with *
  have base := FunctionBetween.apply_closed at complexPolynomial(c :: cs), ℂ, ℂ, a with *
  have qFunction := complexPolynomial.function at ds with *
  have zeroIn := complexZero.member
  have qZero := FunctionBetween.apply_closed at complexPolynomial(ds), ℂ, ℂ, ℂ[0] with *
  have stepSequence := ConvergesTo.sequence at s, realZero with *
  have powerSteps := ConvergesTo.pow at s, realZero, succ(n) with *
  rw realPow.zero_succ at powerSteps
  have powerSequence := powSequence.sequence at s, succ(n) with *
  have powerPositive : ∀ j ∈ ℕ, realZero < powSequence(s, succ(n))(j)
    intros j jIn
    have jNat := nat.omega.backward at j with *
    have value := RealSequence.value at s, j with *
    have stepPositive := positive with j, jIn
    rw powSequence.value
    exact realPow.positive at s(j), succ(n) with *
  refine ⟨n, nIn, ds, dsList, nonzero, degree, ?_⟩
  intros u uIn
  have ring := complexes.comm_ring
  have ordinary := IsCommRing.ring with ring
  have monoid := IsRing.multiplicative with ordinary
  have power := monoidPow.closed at ℂ, complexMul, complexOne, u, succ(n) with *
  have ray := complexRaySequence.converges_zero at s, u with *
  have raySequence := complexRaySequence.sequence at s, u with *
  have qLimit := complexPolynomial.converges at complexRaySequence(s, u), ℂ[0], ds with *
  have qSequence := complexMappedSequence.sequence at complexPolynomial(ds), complexRaySequence(s, u) with *
  have multiplier := complexLeftMul.function at u ^ succ(n) with *
  have multiplierContinuous := complexLeftMul.continuous_at at u ^ succ(n), complexPolynomial(ds)(ℂ[0]) with *
  have directionLimit := ComplexContinuousAt.converges at complexLeftMul(u ^ succ(n)), complexMappedSequence(complexPolynomial(ds), complexRaySequence(s, u)), complexPolynomial(ds)(ℂ[0]) with *
  rw complexLeftMul.value at directionLimit
  have along := expansion with u, uIn
  have least : ∀ j ∈ ℕ, complexNormSquared(complexPolynomial(c :: cs)(a)) ≤ complexNormSquared(ℂ[complexPolynomial(c :: cs)(a) + complexScale(powSequence(s, succ(n))(j), complexMappedSequence(complexLeftMul(u ^ succ(n)), complexMappedSequence(complexPolynomial(ds), complexRaySequence(s, u)))(j))])
    intros j jIn
    have jNat := nat.omega.backward at j with *
    have sjReal := RealSequence.value at s, j with *
    have sjIn : s(j) ∈ ℝ by typecheck
    have scaled := complexScale.closed at s(j), u with *
    have sum := IsRing.add_closed with ordinary, center, scaled
    have bound := minimum with ℂ[a + complexScale(s(j), u)], sum
    have equation := along with s(j)
    rw equation at bound
    have rayFunction : complexRaySequence(s, u) : ℕ → ℂ by exact raySequence
    have rayMember := FunctionBetween.apply_closed at complexRaySequence(s, u), ℕ, ℂ, j with *
    have qMember := FunctionBetween.apply_closed at complexPolynomial(ds), ℂ, ℂ, complexRaySequence(s, u)(j) with *
    rwa [powSequence.value, complexMappedSequence.value, complexMappedSequence.value, complexLeftMul.value, complexRaySequence.value]
  exact complexNormSquared.minimum_direction at complexPolynomial(c :: cs)(a), powSequence(s, succ(n)), complexMappedSequence(complexLeftMul(u ^ succ(n)), complexMappedSequence(complexPolynomial(ds), complexRaySequence(s, u))), ℂ[u ^ succ(n) * complexPolynomial(ds)(ℂ[0])] with *

end Complexes
