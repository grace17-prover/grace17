module Grace.Cumulus.Complex.ExtremeValue
import SequentialContinuity
import Real.Analysis.ExtremeValue

def complexNormImage (f S : Set) : Set := { complexNormSquared(f(z)) | z ∈ S }

theorem complexNormImage.membership (f S t : Set)
  shows t ∈ complexNormImage(f, S) ↔ ∃ z ∈ S, complexNormSquared(f(z)) = t
proof
  simp

theorem complexNormImage.subset_reals (f S : Set)
  requires function : f : complexCarrier → complexCarrier
  requires subset : S ⊆ complexCarrier
  shows complexNormImage(f, S) ⊆ ℝ
proof
  intros t member
  obtain ⟨z, zIn, value⟩ := complexNormImage.membership.forward with member
  have zComplex := subset with z, zIn
  have image := FunctionBetween.apply_closed with *
  have typed : complexNormSquared(f(z)) ∈ ℝ by typecheck
  rwa value at typed

defchoose complexNormPreimage (f S u : Set, n : Nat) (z ∈ complexCarrier) :=
  z ∈ S ∧ complexNormSquared(f(z)) = u(n)
requires subset : S ⊆ complexCarrier
requires terms : TermsIn(u, complexNormImage(f, S))
proof
  have nIn : n ∈ ℕ by typecheck
  have term := terms with n, nIn
  obtain ⟨z, zIn, value⟩ := complexNormImage.membership.forward at f, S, u(n) with *
  have member := subset with z, zIn
  refine ⟨z, member, zIn, value⟩

defgraph complexNormPreimages (f S u : Set) (n ∈ ℕ) : complexCarrier := complexNormPreimage(f, S, u, n)
requires subset : S ⊆ complexCarrier
requires terms : TermsIn(u, complexNormImage(f, S))
proof
  have chosen := complexNormPreimage.selected at f, S, u, n with *
  exact chosen.left

theorem complexNormPreimages.properties (f S u : Set) (n : Nat)
  requires subset : S ⊆ complexCarrier
  requires terms : TermsIn(u, complexNormImage(f, S))
  shows complexNormPreimages(f, S, u)(n) ∈ S ∧ complexNormSquared(f(complexNormPreimages(f, S, u)(n))) = u(n)
proof
  have chosen := complexNormPreimage.selected at f, S, u, n with *
  rw complexNormPreimages.value
  exact chosen.right

theorem complexNormPreimages.terms (f S u : Set)
  requires subset : S ⊆ complexCarrier
  requires terms : TermsIn(u, complexNormImage(f, S))
  shows TermsIn(complexNormPreimages(f, S, u), S)
proof
  intros n member
  have natural := nat.omega.backward at n with *
  have chosen := complexNormPreimages.properties with *
  exact chosen.left

theorem complexNormImage.sequentially_compact (f S : Set)
  requires continuous : ComplexContinuous(f)
  requires compact : ComplexSequentiallyCompact(S)
  shows SequentiallyCompact(complexNormImage(f, S))
proof
  rcases continuous with ⟨function, atPoints⟩
  rcases compact with ⟨subset, extract⟩
  have imageSubset := complexNormImage.subset_reals with *
  unfold SequentiallyCompact
  refine ⟨imageSubset, ?_⟩
  intros u sequence terms
  have preimageSequence : ComplexSequence(complexNormPreimages(f, S, u))
    unfold ComplexSequence
    exact complexNormPreimages.function at f, S, u with *
  have preimageTerms := complexNormPreimages.terms with *
  obtain ⟨k, increasing, a, aIn, converges⟩ := extract with complexNormPreimages(f, S, u), preimageSequence, preimageTerms
  have aComplex : a ∈ complexCarrier by exact subset with a, aIn
  have local := atPoints with a, aComplex
  have mapped := ComplexContinuousAt.converges with *
  have normLimit := ComplexConvergesTo.norm_squared with converges
  have selected := subsequence.sequence with *
  have selectedPreimages := complexSubsequence.sequence with *
  have mappedSequence := complexMappedSequence.sequence at f, complexSubsequence(complexNormPreimages(f, S, u), k) with *
  have image := FunctionBetween.apply_closed with *
  have same : ∀ n ∈ ℕ, subsequence(u, k)(n) = complexNormSequence(complexMappedSequence(f, complexSubsequence(complexNormPreimages(f, S, u), k)))(n)
    intros n nIn
    have natural := nat.omega.backward at n with *
    have selector := StrictlyIncreasingNat.function with increasing
    have kn := FunctionBetween.apply_closed at k, ℕ, ℕ, n with *
    have knNat := nat.omega.backward at k(n) with *
    have chosen := complexNormPreimages.properties at f, S, u, k(n) with *
    rw [complexNormSequence.value, complexMappedSequence.value, complexSubsequence.value, subsequence.value]
    symm
    exact chosen.right
  have outputLimit := ConvergesTo.of_equal_terms at subsequence(u, k), complexNormSequence(complexMappedSequence(f, complexSubsequence(complexNormPreimages(f, S, u), k))), complexNormSquared(f(a)) with *
  have imageMember : complexNormSquared(f(a)) ∈ complexNormImage(f, S)
    exact complexNormImage.membership.backward with ⟨a, aIn, rfl⟩
  have normIn : complexNormSquared(f(a)) ∈ ℝ by typecheck
  refine ⟨k, increasing, complexNormSquared(f(a)), normIn, imageMember, outputLimit⟩

theorem ComplexContinuous.minimum_on_compact (f S : Set)
  requires continuous : ComplexContinuous(f)
  requires compact : ComplexSequentiallyCompact(S)
  requires inhabited : Nonempty(S)
  shows ∃ a ∈ S, ∀ z ∈ S, complexNormSquared(f(a)) ≤ complexNormSquared(f(z))
proof
  have imageCompact := complexNormImage.sequentially_compact with *
  have imageInhabited : Nonempty(complexNormImage(f, S))
    obtain ⟨z, member⟩ := inhabited
    witness complexNormSquared(f(z))
    exact complexNormImage.membership.backward with ⟨z, member, rfl⟩
  obtain ⟨t, tIn, least⟩ := SequentiallyCompact.has_minimum at complexNormImage(f, S) with *
  obtain ⟨a, aIn, value⟩ := complexNormImage.membership.forward at f, S, t with *
  refine ⟨a, aIn, ?_⟩
  intros z zIn
  have imageMember : complexNormSquared(f(z)) ∈ complexNormImage(f, S)
    exact complexNormImage.membership.backward with ⟨z, zIn, rfl⟩
  have bound := least with complexNormSquared(f(z)), imageMember
  rwa value

theorem closedComplexDisk.nonempty (radius : Real)
  requires nonnegative : realZero ≤ radius
  shows Nonempty(closedComplexDisk(radius))
proof
  witness complexZero
  apply closedComplexDisk.membership.backward with assumption
  constructor
  . exact complexZero.member
  . rw complexNormSquared.zero
    exact nonnegative

theorem complexPolynomial.disk_minimum (cs : List(complexCarrier)) (radius : Real)
  requires nonnegative : realZero ≤ radius
  shows ComplexDiskMinimum(complexPolynomial(cs), radius)
proof
  have continuous := complexPolynomial.continuous with *
  have compact := closedComplexDisk.sequentially_compact with *
  have inhabited := closedComplexDisk.nonempty with *
  obtain ⟨a, aIn, least⟩ := ComplexContinuous.minimum_on_compact at complexPolynomial(cs), closedComplexDisk(radius) with *
  have disk := closedComplexDisk.membership.forward with *
  unfold ComplexDiskMinimum
  refine ⟨a, disk.left, disk.right, ?_⟩
  intros z zIn bound
  have member : z ∈ closedComplexDisk(radius)
    apply closedComplexDisk.membership.backward with assumption
    refine ⟨zIn, bound⟩
  exact least with z, member

theorem complexPolynomial.global_minimum (c : Set) (cs : List(complexCarrier))
  requires coefficient : c ∈ complexCarrier
  shows ∃ a ∈ complexCarrier, ∀ z ∈ complexCarrier, complexNormSquared(complexPolynomial(c :: cs)(a)) ≤ complexNormSquared(complexPolynomial(c :: cs)(z))
proof
  have disks : ∀ radius ∈ ℝ, realZero ≤ radius → ComplexDiskMinimum(complexPolynomial(c :: cs), radius)
    intros radius realRadius nonnegative
    exact complexPolynomial.disk_minimum with *
  exact complexPolynomial.minimum_of_disk_minima with *

section Complexes
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg, complexMul, complexOne)

theorem complexPolynomial.root_of_descent (c : Set) (cs : List(ℂ))
  requires coefficient : c ∈ ℂ
  requires descent : ∀ a ∈ ℂ, complexPolynomial(c :: cs)(a) ≠ ℂ[0] → ∃ z ∈ ℂ, complexNormSquared(complexPolynomial(c :: cs)(z)) < complexNormSquared(complexPolynomial(c :: cs)(a))
  shows ∃ a ∈ ℂ, monicValue(ℂ, identity(ℂ), ℂ, a, c :: cs) = ℂ[0]
proof
  have minimum := complexPolynomial.global_minimum with *
  exact complexPolynomial.root_of_minimum_and_descent with *

end Complexes
