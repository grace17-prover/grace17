-- Authors: Grant Passmore

module Grace.Cumulus.Metric.Spaces
import Structure

-- MetricContinuous(f, X, Y): f is an ε–δ continuous function between the
-- carriers; Lipschitz(f, X, Y, K), Isometry(f, X, Y), and
-- UniformlyContinuous(f, X, Y) likewise, and Complete(X) says every Cauchy
-- sequence converges. Each takes the spaces, so a hypothesis supplies both
-- distances. IsMetricContinuous(f, A, d, B, e) and the rest remain the forms
-- over separate pieces, bridged below.
predicate MetricContinuous (f X Y : Set) :=
  MetricSpace(X) ∧ MetricSpace(Y) ∧
  IsMetricContinuous(f, X.carrier, X.dist, Y.carrier, Y.dist)
predicate Lipschitz (f X Y : Set) (K : Real) :=
  MetricSpace(X) ∧ MetricSpace(Y) ∧
  IsLipschitz(f, X.carrier, X.dist, Y.carrier, Y.dist, K)
predicate Isometry (f X Y : Set) :=
  MetricSpace(X) ∧ MetricSpace(Y) ∧
  IsIsometry(f, X.carrier, X.dist, Y.carrier, Y.dist)
predicate UniformlyContinuous (f X Y : Set) :=
  MetricSpace(X) ∧ MetricSpace(Y) ∧
  IsUniformlyContinuous(f, X.carrier, X.dist, Y.carrier, Y.dist)
predicate Complete (X : Set) :=
  IsComplete(MetricSpace.carrier(X), MetricSpace.dist(X))

-- A continuity, isometry, or Lipschitz hypothesis supplies convergence in
-- both of its spaces, so under it the binders (x : X) and (y : Y) are
-- carrier memberships and u ⇝ x is read in the space of its limit.
notation infix 50 "⇝" => Converges(metricTopology(X), _, _) via hypothesis MetricContinuous(f, X, Y) for X.carrier
notation infix 50 "⇝" => Converges(metricTopology(Y), _, _) via hypothesis MetricContinuous(f, X, Y) for Y.carrier
notation infix 50 "⇝" => Converges(metricTopology(X), _, _) via hypothesis Isometry(f, X, Y) for X.carrier
notation infix 50 "⇝" => Converges(metricTopology(Y), _, _) via hypothesis Isometry(f, X, Y) for Y.carrier
notation infix 50 "⇝" => Converges(metricTopology(X), _, _) via hypothesis Lipschitz(f, X, Y, K) for X.carrier
notation infix 50 "⇝" => Converges(metricTopology(Y), _, _) via hypothesis Lipschitz(f, X, Y, K) for Y.carrier
notation function "d(x, y)" => X.dist(x, y) via hypothesis MetricContinuous(f, X, Y) for X.carrier
notation function "d(x, y)" => Y.dist(x, y) via hypothesis MetricContinuous(f, X, Y) for Y.carrier
notation function "d(x, y)" => X.dist(x, y) via hypothesis Isometry(f, X, Y) for X.carrier
notation function "d(x, y)" => Y.dist(x, y) via hypothesis Isometry(f, X, Y) for Y.carrier
notation function "d(x, y)" => X.dist(x, y) via hypothesis Lipschitz(f, X, Y, K) for X.carrier
notation function "d(x, y)" => Y.dist(x, y) via hypothesis Lipschitz(f, X, Y, K) for Y.carrier

instance MetricContinuous.parts (f X Y : Set)
  requires continuous : MetricContinuous(f, X, Y)
  shows IsMetricContinuous(f, X.carrier, X.dist, Y.carrier, Y.dist)
proof
  obtain ⟨metricX, metricY, engine⟩ := continuous
  exact engine

theorem MetricContinuous.of_projections (f X Y : Set)
  requires metricX : MetricSpace(X)
  requires metricY : MetricSpace(Y)
  requires continuous :
    IsMetricContinuous(f, X.carrier, X.dist, Y.carrier, Y.dist)
  shows MetricContinuous(f, X, Y)
proof
  unfold MetricContinuous
  exact ⟨metricX, metricY, continuous⟩

theorem MetricContinuous.source (f X Y : Set)
  requires continuous : MetricContinuous(f, X, Y)
  shows MetricSpace(X)
proof
  obtain ⟨metricX, rest⟩ := continuous
  exact metricX

theorem MetricContinuous.target (f X Y : Set)
  requires continuous : MetricContinuous(f, X, Y)
  shows MetricSpace(Y)
proof
  obtain ⟨metricX, metricY, rest⟩ := continuous
  exact metricY

theorem MetricContinuous.function_between (f X Y : Set)
  requires continuous : MetricContinuous(f, X, Y)
  shows f : X.carrier → Y.carrier
proof
  have engine := MetricContinuous.parts with continuous
  exact Continuity.IsMetricContinuous.function with engine

-- ε–δ continuity is continuity of the metric topologies.
theorem MetricContinuous.iff_continuous (f X Y : Set)
  requires metricX : MetricSpace(X)
  requires metricY : MetricSpace(Y)
  shows MetricContinuous(f, X, Y) ↔
    f : metricTopology(X) ⇒ metricTopology(Y)
proof
  have partsX := MetricSpace.parts with metricX
  have partsY := MetricSpace.parts with metricY
  have spaceX := MetricSpace.topological_space with metricX
  have spaceY := MetricSpace.topological_space with metricY
  have criterion := IsMetricContinuous.iff_continuous_map at f, X.carrier, X.dist, Y.carrier, Y.dist with partsX, partsY
  constructor
  . intro continuous
    have engine := MetricContinuous.parts with continuous
    have map := criterion.forward with engine
    have shifted : ContinuousMap(f, TopologicalSpace.carrier(metricTopology(X)),
        TopologicalSpace.opens(metricTopology(X)),
        TopologicalSpace.carrier(metricTopology(Y)),
        TopologicalSpace.opens(metricTopology(Y)))
      rw [metricTopology.carrier, metricTopology.opens]
      rw [metricTopology.carrier, metricTopology.opens]
      exact map
    exact Continuous.of_projections with spaceX, spaceY, shifted
  . intro continuous
    have map := Continuous.parts with continuous
    rw [metricTopology.carrier, metricTopology.opens] at map
    rw [metricTopology.carrier, metricTopology.opens] at map
    have engine := criterion.backward with map
    exact MetricContinuous.of_projections with metricX, metricY, engine

theorem MetricContinuous.continuous (f X Y : Set)
  requires continuous : MetricContinuous(f, X, Y)
  shows f : metricTopology(X) ⇒ metricTopology(Y)
proof
  have metricX := MetricContinuous.source with continuous
  have metricY := MetricContinuous.target with continuous
  have criterion := MetricContinuous.iff_continuous at f, X, Y with metricX, metricY
  exact criterion.forward with continuous

section ContinuityLaws
variable (f X Y : Set)
hypothesis continuous : MetricContinuous(f, X, Y)

theorem MetricContinuous.apply_mem (x : X)
  shows f(x) ∈ Y
proof
  have function := MetricContinuous.function_between with continuous
  have xIn : x ∈ X by assumption
  exact FunctionBetween.apply_closed with function, xIn

-- The ε–δ form at a point.
theorem MetricContinuous.control (x : X) (ε : Real)
  requires positive : 0 < ε
  shows ∃ δ ∈ ℝ, 0 < δ ∧
    ∀ y ∈ X, (d(x, y) < δ → d(f(x), f(y)) < ε)
proof
  have engine := MetricContinuous.parts with continuous
  have xIn : x ∈ X by assumption
  have pointwise := Continuity.IsMetricContinuous.at with engine, xIn
  exact MetricContinuousAt.control with pointwise, positive

-- A continuous map carries a convergent sequence to a convergent sequence.
theorem MetricContinuous.map_converges (u : Set) (x : X)
  requires converges : u ⇝ x
  shows compose(f, u, ℕ, X.carrier, Y.carrier) ⇝ f(x)
proof
  have metricX := MetricContinuous.source with continuous
  have metricY := MetricContinuous.target with continuous
  have spaceX := MetricSpace.topological_space with metricX
  have engine := MetricContinuous.parts with continuous
  have function := MetricContinuous.function_between with continuous
  have xIn : x ∈ X by assumption
  have image := FunctionBetween.apply_closed with function, xIn
  have sequence := Converges.sequence with spaceX, converges
  rw metricTopology.carrier at sequence
  have composite := compose.function with sequence, function
  have bridge := Converges.iff_parts with metricX, sequence
  have limit := bridge.forward with converges
  have mapped := ConvergesIn.map_continuous with engine, limit
  have bridgeY := Converges.iff_parts with metricY, composite
  exact bridgeY.backward with mapped

end ContinuityLaws

theorem MetricContinuous.id (X : Set)
  requires metric : MetricSpace(X)
  shows MetricContinuous(identity(X.carrier), X, X)
proof
  have parts := MetricSpace.parts with metric
  have engine := identity.metric_continuous at X.carrier, X.dist
  exact MetricContinuous.of_projections with *

theorem MetricContinuous.comp (f g X Y Z : Set)
  requires first : MetricContinuous(f, X, Y)
  requires second : MetricContinuous(g, Y, Z)
  shows MetricContinuous(compose(g, f, X.carrier, Y.carrier, Z.carrier), X, Z)
proof
  have engineF := MetricContinuous.parts with first
  have engineG := MetricContinuous.parts with second
  have metricX := MetricContinuous.source with first
  have metricZ := MetricContinuous.target with second
  have engine := Continuity.IsMetricContinuous.compose with engineF, engineG
  exact MetricContinuous.of_projections with *

-- Lipschitz maps, isometries, and uniformly continuous maps are
-- continuous; an isometry preserves distances.
theorem Lipschitz.metric_continuous (f X Y : Set) (K : Real)
  requires lipschitz : Lipschitz(f, X, Y, K)
  shows MetricContinuous(f, X, Y)
proof
  obtain ⟨metricX, metricY, engine⟩ := lipschitz
  have partsX := MetricSpace.parts with metricX
  have partsY := MetricSpace.parts with metricY
  have continuous := Continuity.IsLipschitz.continuous with partsX, partsY,
    engine
  exact MetricContinuous.of_projections with *

theorem Isometry.metric_continuous (f X Y : Set)
  requires isometry : Isometry(f, X, Y)
  shows MetricContinuous(f, X, Y)
proof
  obtain ⟨metricX, metricY, engine⟩ := isometry
  have continuous := Continuity.IsIsometry.continuous with engine
  exact MetricContinuous.of_projections with *

theorem UniformlyContinuous.metric_continuous (f X Y : Set)
  requires uniform : UniformlyContinuous(f, X, Y)
  shows MetricContinuous(f, X, Y)
proof
  obtain ⟨metricX, metricY, engine⟩ := uniform
  have continuous := Uniform.IsUniformlyContinuous.continuous with engine
  exact MetricContinuous.of_projections with *

section IsometryLaws
variable (f X Y : Set)
hypothesis isometry : Isometry(f, X, Y)

theorem Isometry.dist (x y : X)
  shows d(f(x), f(y)) = d(x, y)
proof
  obtain ⟨metricX, metricY, engine⟩ := isometry
  have xIn : x ∈ X by assumption
  have yIn : y ∈ X by assumption
  exact IsIsometry.distance with engine, xIn, yIn

end IsometryLaws

section LipschitzLaws
variable (f X Y : Set) (K : Real)
hypothesis lipschitz : Lipschitz(f, X, Y, K)

theorem Lipschitz.dist_le (x y : X)
  shows d(f(x), f(y)) ≤ K * d(x, y)
proof
  obtain ⟨metricX, metricY, engine⟩ := lipschitz
  have xIn : x ∈ X by assumption
  have yIn : y ∈ X by assumption
  exact IsLipschitz.bound with engine, xIn, yIn

end LipschitzLaws

-- Completeness.
instance Complete.parts (X : Set)
  requires complete : Complete(X)
  shows IsComplete(MetricSpace.carrier(X), MetricSpace.dist(X))
proof
  unfold Complete at complete
  exact complete

theorem Complete.of_parts (X : Set)
  requires complete : IsComplete(MetricSpace.carrier(X), MetricSpace.dist(X))
  shows Complete(X)
proof
  unfold Complete
  exact complete

theorem Complete.of_mk (A d : Set)
  requires complete : IsComplete(A, d)
  shows Complete(MetricSpace.mk(A, d))
proof
  unfold Complete
  metric_projections

theorem Complete.converges (X u : Set)
  requires metric : MetricSpace(X)
  requires complete : Complete(X)
  requires cauchy : Cauchy(X, u)
  shows ∃ x ∈ X, u ⇝ x
proof
  have pieces := Complete.parts with complete
  have cauchyU := Cauchy.parts with cauchy
  have limit := Sequences.IsComplete.limit with pieces, cauchyU
  obtain ⟨x, xIn, converges⟩ := limit
  have sequence := SequenceIn.function with (IsCauchy.sequence with cauchyU)
  have bridge := Converges.iff_parts at X, u, x with metric, sequence
  witness x
  exact ⟨xIn, (bridge.backward with converges)⟩

-- The real line with its usual distance, the discrete metric on a set, the
-- subspace metric on a subset, and the product of two metric spaces.
def realMetric : Set := MetricSpace.mk(ℝ, realDistance)
def discreteMetric (A : Set) : Set := MetricSpace.mk(A, discreteDistance(A))
def metricSubspace (X S : Set) : Set :=
  MetricSpace.mk(S, subspaceMetric(MetricSpace.dist(X), S))
def productMetric (X Y : Set) : Set :=
  MetricSpace.mk(MetricSpace.carrier(X) × MetricSpace.carrier(Y),
    productDistance(MetricSpace.carrier(X), MetricSpace.dist(X),
      MetricSpace.carrier(Y), MetricSpace.dist(Y)))

theorem realMetric.carrier
  shows MetricSpace.carrier(realMetric) = ℝ
proof
  unfold realMetric
  metric_projections

theorem realMetric.dist
  shows MetricSpace.dist(realMetric) = realDistance
proof
  unfold realMetric
  metric_projections

instance realMetric.space
  shows MetricSpace(realMetric)
proof
  unfold realMetric
  exact MetricSpace.of_parts with realDistance.metric

instance realMetric.complete
  shows Complete(realMetric)
proof
  unfold realMetric
  exact Complete.of_mk with realDistance.complete

-- The metric topology of the line is the real line.
theorem realMetric.topology
  shows metricTopology(realMetric) = realLine
proof
  unfold metricTopology
  rw [realMetric.carrier, realMetric.dist, realDistance.topology]
  unfold realLine
  rfl

-- Convergence of a real sequence is convergence in the real metric.
theorem realMetric.converges_iff (u : Set) (L : Real)
  requires metric : MetricSpace(realMetric)
  requires sequence : u : ℕ → ℝ
  shows ConvergesTo(u, L) ↔ u ⇝ L
proof
  have realL : L ∈ MetricSpace.carrier(realMetric)
    rw realMetric.carrier
    typecheck
  have sequenceIn : u : ℕ → MetricSpace.carrier(realMetric)
    rw realMetric.carrier
    exact sequence
  have bridge := Converges.iff_parts with metric, sequenceIn
  have engine := realDistance.converges_iff at u, L
  rw [realMetric.carrier, realMetric.dist] at bridge
  constructor
  . intro converges
    exact bridge.backward with (engine.forward with converges)
  . intro converges
    exact engine.backward with (bridge.forward with converges)

instance discreteMetric.space (A : Set)
  shows MetricSpace(discreteMetric(A))
proof
  unfold discreteMetric
  exact MetricSpace.of_parts with (discreteDistance.metric at A)

instance discreteMetric.complete (A : Set)
  shows Complete(discreteMetric(A))
proof
  unfold discreteMetric
  exact Complete.of_mk with (discreteDistance.complete at A)

-- The discrete metric induces the discrete topology.
theorem discreteMetric.topology (A : Set)
  shows metricTopology(discreteMetric(A)) = TopologicalSpace.mk(A, 𝒫(A))
proof
  unfold metricTopology
  unfold discreteMetric
  metric_projections
  rw discreteDistance.topology
  rfl

instance metricSubspace.space (X S : Set)
  requires metric : MetricSpace(X)
  requires inside : S ⊆ X
  shows MetricSpace(metricSubspace(X, S))
proof
  have parts := MetricSpace.parts with metric
  unfold metricSubspace
  exact MetricSpace.of_parts with (subspaceMetric.metric with parts, inside)

-- A closed subset of a complete space is complete.
theorem Complete.subspace (X S : Set)
  requires metric : MetricSpace(X)
  requires complete : Complete(X)
  requires closed : Closed(metricTopology(X), S)
  shows Complete(metricSubspace(X, S))
proof
  have space := MetricSpace.topological_space with metric
  have pieces := Complete.parts with complete
  have closedS := Closed.parts with space, closed
  rw [metricTopology.carrier, metricTopology.opens] at closedS
  have metricClosed : MetricClosed(X.carrier, X.dist, S)
    unfold MetricClosed
    exact closedS
  unfold metricSubspace
  exact Complete.of_mk with (IsComplete.closed_subspace with pieces,
    metricClosed)

instance productMetric.space (X Y : Set)
  requires metricX : MetricSpace(X)
  requires metricY : MetricSpace(Y)
  shows MetricSpace(productMetric(X, Y))
proof
  have partsX := MetricSpace.parts with metricX
  have partsY := MetricSpace.parts with metricY
  unfold productMetric
  exact MetricSpace.of_parts with (productDistance.metric with partsX, partsY)
