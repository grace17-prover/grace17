module Grace.Cumulus.Metric.Maps
import Limits

theorem IsLipschitz.of_le (f X d Y e : Set) (K L : Real)
  requires metricD : IsMetric(X, d)
  requires metricE : IsMetric(Y, e)
  requires lipschitz : IsLipschitz(f, X, d, Y, e, K)
  requires le : K ≤ L
  shows IsLipschitz(f, X, d, Y, e, L)
proof
  have function := IsLipschitz.function with lipschitz
  have nonnegativeK := IsLipschitz.nonnegative with lipschitz
  have nonnegativeL : 0 ≤ L by linarith
  unfold IsLipschitz
  constructor
  . exact function
  . constructor
    . exact nonnegativeL
    . intros x hx y hy
      have bound := IsLipschitz.bound with lipschitz, hx, hy
      have dxy := IsMetric.real with metricD, hx, hy
      have imageX := FunctionBetween.apply_closed with function, hx
      have imageY := FunctionBetween.apply_closed with function, hy
      have exy := IsMetric.real with metricE, imageX, imageY
      have nonnegative := IsMetric.nonnegative with metricD, hx, hy
      have scaled := realLe.mul_right_of_nonnegative with le, nonnegative
      linarith

-- A Lipschitz map with constant zero is constant.
theorem IsLipschitz.constant_of_zero (f X d Y e x y : Set)
  requires metricD : IsMetric(X, d)
  requires metricE : IsMetric(Y, e)
  requires lipschitz : IsLipschitz(f, X, d, Y, e, (0:R))
  requires hx : x ∈ X
  requires hy : y ∈ X
  shows f(x) = f(y)
proof
  have function := IsLipschitz.function with lipschitz
  have bound := IsLipschitz.bound with lipschitz, hx, hy
  have dxy := IsMetric.real with metricD, hx, hy
  have imageX := FunctionBetween.apply_closed with function, hx
  have imageY := FunctionBetween.apply_closed with function, hy
  have exy := IsMetric.real with metricE, imageX, imageY
  have nonnegative := IsMetric.nonnegative with metricE, imageX, imageY
  have annihilate := realMulValue.zero_left at d(x, y)
  rw annihilate at bound
  have zero : e(f(x), f(y)) = (0:R) by linarith
  exact IsMetric.eq_of_zero with metricE, imageX, imageY, zero

theorem IsLipschitz.restrict (f X d Y e S : Set) (K : Real)
  requires metric : IsMetric(X, d)
  requires inside : S ⊆ X
  requires lipschitz : IsLipschitz(f, X, d, Y, e, K)
  shows IsLipschitz(restrict(f, S), S, subspaceMetric(d, S), Y, e, K)
proof
  have function := IsLipschitz.function with lipschitz
  have nonnegative := IsLipschitz.nonnegative with lipschitz
  unfold IsLipschitz
  constructor
  . exact restrict.domain_function with function, inside
  . constructor
    . exact nonnegative
    . intros x hx y hy
      have valueX := restrict.domain_apply with function, inside, hx
      have valueY := restrict.domain_apply with function, inside, hy
      have distance := subspaceMetric.apply with metric, inside, hx, hy
      rw [valueX, valueY, distance]
      exact IsLipschitz.bound with lipschitz, (inside with x, hx), (inside with
        y, hy)

theorem IsIsometry.restrict (f X d Y e S : Set)
  requires metric : IsMetric(X, d)
  requires inside : S ⊆ X
  requires isometry : IsIsometry(f, X, d, Y, e)
  shows IsIsometry(restrict(f, S), S, subspaceMetric(d, S), Y, e)
proof
  have function := IsIsometry.function with isometry
  constructor
  . exact restrict.domain_function with function, inside
  . intros x hx y hy
    have valueX := restrict.domain_apply with function, inside, hx
    have valueY := restrict.domain_apply with function, inside, hy
    have distance := subspaceMetric.apply with metric, inside, hx, hy
    rw [valueX, valueY, distance]
    exact IsIsometry.distance with isometry, (inside with x, hx), (inside with
      y, hy)

theorem IsUniformlyContinuous.restrict (f X d Y e S : Set)
  requires metric : IsMetric(X, d)
  requires inside : S ⊆ X
  requires uniform : IsUniformlyContinuous(f, X, d, Y, e)
  shows IsUniformlyContinuous(restrict(f, S), S, subspaceMetric(d, S), Y, e)
proof
  have function := IsUniformlyContinuous.function with uniform
  apply IsUniformlyContinuous.of_control with (restrict.domain_function with
    function, inside)
  intros ε hε positive
  obtain ⟨δ, hδ, positiveD, maps⟩ :=
    IsUniformlyContinuous.control with uniform, positive
  refine ⟨δ, hδ, positiveD, ?_⟩
  intros x hx y hy near
  have valueX := restrict.domain_apply with function, inside, hx
  have valueY := restrict.domain_apply with function, inside, hy
  have distance := subspaceMetric.apply with metric, inside, hx, hy
  rw distance at near
  rw [valueX, valueY]
  exact maps with x, (inside with x, hx), y, (inside with y, hy), near

theorem MetricContinuousAt.restrict (f X d Y e S x : Set)
  requires metric : IsMetric(X, d)
  requires inside : S ⊆ X
  requires continuous : MetricContinuousAt(f, X, d, Y, e, x)
  requires hx : x ∈ S
  shows MetricContinuousAt(restrict(f, S), S, subspaceMetric(d, S), Y, e, x)
proof
  have function := MetricContinuousAt.function with continuous
  have restricted := restrict.domain_function with function, inside
  apply MetricContinuousAt.of_control with restricted, hx
  intros ε hε positive
  obtain ⟨δ, hδ, positiveD, maps⟩ :=
    MetricContinuousAt.control with continuous, positive
  refine ⟨δ, hδ, positiveD, ?_⟩
  intros y hy near
  have valueX := restrict.domain_apply with function, inside, hx
  have valueY := restrict.domain_apply with function, inside, hy
  have distance := subspaceMetric.apply with metric, inside, hx, hy
  rw distance at near
  rw [valueX, valueY]
  exact maps with y, (inside with y, hy), near

theorem inclusionMap.lipschitz (X d S : Set)
  requires metric : IsMetric(X, d)
  requires inside : S ⊆ X
  shows IsLipschitz(inclusionMap(S, X), S, subspaceMetric(d, S), X, d, (1:R))
proof
  have subspace := subspaceMetric.metric with metric, inside
  exact IsIsometry.lipschitz with subspace, (inclusionMap.isometry with
    metric, inside)

theorem inclusionMap.uniformly_continuous (X d S : Set)
  requires metric : IsMetric(X, d)
  requires inside : S ⊆ X
  shows IsUniformlyContinuous(inclusionMap(S, X), S, subspaceMetric(d, S), X, d)
proof
  exact IsIsometry.uniformly_continuous with (inclusionMap.isometry with
    metric, inside)

-- Images of balls under Lipschitz maps and isometries.
theorem IsLipschitz.image_ball (f X d Y e x : Set) (K r : Real)
  requires metricD : IsMetric(X, d)
  requires metricE : IsMetric(Y, e)
  requires lipschitz : IsLipschitz(f, X, d, Y, e, K)
  requires positive : 0 < K
  requires hx : x ∈ X
  shows functionImage(f, ball(X, d, x, r), Y) ⊆ ball(Y, e, f(x), K * r)
proof
  have function := IsLipschitz.function with lipschitz
  intros v hv
  obtain ⟨hvY, y, hy, shape⟩ := functionImage.membership.forward with hv
  rw shape
  have hyX := ball.point with hy
  have near := ball.distance with hy
  have bound := IsLipschitz.bound with lipschitz, hx, hyX
  have dxy := IsMetric.real with metricD, hx, hyX
  have imageX := FunctionBetween.apply_closed with function, hx
  have imageY := FunctionBetween.apply_closed with function, hyX
  have exy := IsMetric.real with metricE, imageX, imageY
  have scaled := realLess.mul_left_of_positive with near, positive
  apply ball.of_distance with imageY
  linarith

theorem IsLipschitz.image_closedBall (f X d Y e x : Set) (K r : Real)
  requires metricD : IsMetric(X, d)
  requires metricE : IsMetric(Y, e)
  requires lipschitz : IsLipschitz(f, X, d, Y, e, K)
  requires hx : x ∈ X
  shows
    functionImage(f, closedBall(X, d, x, r), Y) ⊆ closedBall(Y, e, f(x), K * r)
proof
  have function := IsLipschitz.function with lipschitz
  have nonnegative := IsLipschitz.nonnegative with lipschitz
  intros v hv
  obtain ⟨hvY, y, hy, shape⟩ := functionImage.membership.forward with hv
  rw shape
  have hyX := closedBall.point with hy
  have near := closedBall.distance with hy
  have bound := IsLipschitz.bound with lipschitz, hx, hyX
  have dxy := IsMetric.real with metricD, hx, hyX
  have imageX := FunctionBetween.apply_closed with function, hx
  have imageY := FunctionBetween.apply_closed with function, hyX
  have exy := IsMetric.real with metricE, imageX, imageY
  have scaled := realLe.mul_left_of_nonnegative with near, nonnegative
  apply closedBall.of_distance with imageY
  linarith

theorem IsIsometry.image_ball_subset (f X d Y e x : Set, r : Real)
  requires isometry : IsIsometry(f, X, d, Y, e)
  requires hx : x ∈ X
  shows functionImage(f, ball(X, d, x, r), Y) ⊆ ball(Y, e, f(x), r)
proof
  intros v hv
  obtain ⟨hvY, y, hy, shape⟩ := functionImage.membership.forward with hv
  rw shape
  have hyX := ball.point with hy
  have characterization := IsIsometry.ball_image at f, X, d, Y, e, x, y, r with
    isometry, hx, hyX
  exact characterization.forward with hy

theorem IsIsometry.closedBall_image (f X d Y e x y : Set, r : Real)
  requires isometry : IsIsometry(f, X, d, Y, e)
  requires hx : x ∈ X
  requires hy : y ∈ X
  shows y ∈ closedBall(X, d, x, r) ↔ f(y) ∈ closedBall(Y, e, f(x), r)
proof
  have function := IsIsometry.function with isometry
  have preserved := IsIsometry.distance with isometry, hx, hy
  have image := FunctionBetween.apply_closed with function, hy
  constructor
  . intro member
    have near := closedBall.distance with member
    apply closedBall.of_distance with image
    rwa preserved
  . intro member
    have near := closedBall.distance with member
    apply closedBall.of_distance with hy
    rwa preserved at near

theorem IsIsometry.sphere_image (f X d Y e x y : Set, r : Real)
  requires isometry : IsIsometry(f, X, d, Y, e)
  requires hx : x ∈ X
  requires hy : y ∈ X
  shows y ∈ sphere(X, d, x, r) ↔ f(y) ∈ sphere(Y, e, f(x), r)
proof
  have function := IsIsometry.function with isometry
  have preserved := IsIsometry.distance with isometry, hx, hy
  have image := FunctionBetween.apply_closed with function, hy
  constructor
  . intro member
    obtain ⟨hyX, equal⟩ := sphere.membership.forward with member
    apply sphere.membership.backward
    refine ⟨image, ?_⟩
    rwa preserved
  . intro member
    obtain ⟨imageY, equal⟩ := sphere.membership.forward with member
    apply sphere.membership.backward
    refine ⟨hy, ?_⟩
    rwa preserved at equal

theorem IsIsometry.image_bounded (f X d Y e S : Set)
  requires metricD : IsMetric(X, d)
  requires metricE : IsMetric(Y, e)
  requires isometry : IsIsometry(f, X, d, Y, e)
  requires bounded : IsBounded(X, d, S)
  shows IsBounded(Y, e, functionImage(f, S, Y))
proof
  have lipschitz := IsIsometry.lipschitz with metricD, isometry
  exact IsLipschitz.image_bounded with metricD, metricE, lipschitz, bounded

theorem IsLipschitz.converges (f X d Y e u x : Set) (K : Real)
  requires metricD : IsMetric(X, d)
  requires metricE : IsMetric(Y, e)
  requires lipschitz : IsLipschitz(f, X, d, Y, e, K)
  requires converges : ConvergesIn(X, d, u, x)
  shows ConvergesIn(Y, e, compose(f, u, ℕ, X, Y), f(x))
proof
  have continuous := IsLipschitz.continuous with metricD, metricE, lipschitz
  exact ConvergesIn.map_continuous with continuous, converges

-- The inverse of a bijective isometry is an isometry, so a bijective
-- isometry is a homeomorphism of the metric topologies.
theorem IsIsometry.inverse (f X d Y e : Set)
  requires isometry : IsIsometry(f, X, d, Y, e)
  requires bijective : BijectiveBetween(f, X, Y)
  shows IsIsometry(converse(f, X, Y), Y, e, X, d)
proof
  have inverse := converse.function_of_bijective with bijective
  constructor
  . exact inverse
  . intros v hv w hw
    have preimageV := FunctionBetween.apply_closed with inverse, hv
    have preimageW := FunctionBetween.apply_closed with inverse, hw
    have preserved := IsIsometry.distance with isometry, preimageV, preimageW
    have backV := Bijective.apply_inverse with bijective, hv
    have backW := Bijective.apply_inverse with bijective, hw
    rw [backV, backW] at preserved
    symm at preserved
    exact preserved

theorem IsIsometry.inverse_continuous (f X d Y e : Set)
  requires isometry : IsIsometry(f, X, d, Y, e)
  requires bijective : BijectiveBetween(f, X, Y)
  shows IsMetricContinuous(converse(f, X, Y), Y, e, X, d)
proof
  exact IsIsometry.continuous with (IsIsometry.inverse with isometry, bijective)

theorem IsIsometry.inverse_uniformly_continuous (f X d Y e : Set)
  requires isometry : IsIsometry(f, X, d, Y, e)
  requires bijective : BijectiveBetween(f, X, Y)
  shows IsUniformlyContinuous(converse(f, X, Y), Y, e, X, d)
proof
  exact IsIsometry.uniformly_continuous with (IsIsometry.inverse with
    isometry, bijective)

theorem IsIsometry.homeomorphism (f X d Y e : Set)
  requires metricD : IsMetric(X, d)
  requires metricE : IsMetric(Y, e)
  requires isometry : IsIsometry(f, X, d, Y, e)
  requires bijective : BijectiveBetween(f, X, Y)
  shows IsHomeomorphism(f, X, metricTopology(X, d), Y, metricTopology(Y, e))
proof
  have forward := IsIsometry.continuous with isometry
  have backward := IsIsometry.inverse_continuous with isometry, bijective
  refine ⟨bijective, ?_, ?_⟩
  . exact IsMetricContinuous.continuous_map with metricD, metricE, forward
  . exact IsMetricContinuous.continuous_map with metricE, metricD, backward

-- The distance to a fixed point, as a real-valued function on the space.
defgraph distanceTo (X d y : Set) (x ∈ X) : ℝ := d(x, y)
requires metric : IsMetric(X, d)
requires hy : y ∈ X
proof
  exact IsMetric.real with metric, member, hy

theorem distanceTo.nonnegative (X d y x : Set)
  requires metric : IsMetric(X, d)
  requires hy : y ∈ X
  requires hx : x ∈ X
  shows (0:R) ≤ distanceTo(X, d, y)(x)
proof
  have value := distanceTo.value at X, d, y, x with metric, hy, hx
  rw value
  exact IsMetric.nonnegative with metric, hx, hy

theorem distanceTo.zero_iff (X d y x : Set)
  requires metric : IsMetric(X, d)
  requires hy : y ∈ X
  requires hx : x ∈ X
  shows distanceTo(X, d, y)(x) = (0:R) ↔ x = y
proof
  have value := distanceTo.value at X, d, y, x with metric, hy, hx
  rw value
  exact IsMetric.eq_zero_iff with metric, hx, hy

theorem distanceTo.lipschitz (X d y : Set)
  requires metric : IsMetric(X, d)
  requires hy : y ∈ X
  shows IsLipschitz(distanceTo(X, d, y), X, d, ℝ, realDistance, (1:R))
proof
  have one : (0:R) ≤ 1 by linarith
  unfold IsLipschitz
  constructor
  . exact distanceTo.function with metric, hy
  . constructor
    . exact one
    . intros x hx z hz
      have valueX := distanceTo.value at X, d, y, x with metric, hy, hx
      have valueZ := distanceTo.value at X, d, y, z with metric, hy, hz
      rw [valueX, valueZ]
      have dxy := IsMetric.real with metric, hx, hy
      have dzy := IsMetric.real with metric, hz, hy
      have dxz := IsMetric.real with metric, hx, hz
      have realValue := realDistance.apply at d(x, y), d(z, y) with *
      rw realValue
      unfold dist
      have reverse := IsMetric.abs_sub_le with metric, hx, hz, hy
      have unit := realMulValue.one_left at d(x, z)
      rw unit
      exact reverse

theorem distanceTo.uniformly_continuous (X d y : Set)
  requires metric : IsMetric(X, d)
  requires hy : y ∈ X
  shows IsUniformlyContinuous(distanceTo(X, d, y), X, d, ℝ, realDistance)
proof
  have lipschitz := distanceTo.lipschitz with metric, hy
  exact IsLipschitz.uniformly_continuous with
    metric, realDistance.metric, lipschitz

theorem distanceTo.continuous (X d y : Set)
  requires metric : IsMetric(X, d)
  requires hy : y ∈ X
  shows IsMetricContinuous(distanceTo(X, d, y), X, d, ℝ, realDistance)
proof
  have uniform := distanceTo.uniformly_continuous with metric, hy
  exact IsUniformlyContinuous.continuous with uniform

theorem distanceTo.converges (X d y u x : Set)
  requires metric : IsMetric(X, d)
  requires hy : y ∈ X
  requires converges : ConvergesIn(X, d, u, x)
  shows ConvergesIn(ℝ, realDistance, compose(distanceTo(X, d, y), u, ℕ, X, ℝ),
    distanceTo(X, d, y)(x))
proof
  have continuous := distanceTo.continuous with metric, hy
  exact ConvergesIn.map_continuous with continuous, converges

theorem distanceTo.ball_preimage (X d y : Set, r : Real)
  requires metric : IsMetric(X, d)
  requires hy : y ∈ X
  shows
    ball(X, d, y, r) = functionPreimage(distanceTo(X, d, y), X, openBall(0, r))
proof
  ext x
  constructor
  . intro hx
    have hxX := ball.point with hx
    have near := ball.distance with hx
    have value := distanceTo.value at X, d, y, x with metric, hy, hxX
    have symmetric := IsMetric.symmetric with metric, hy, hxX
    have dxy := IsMetric.real with metric, hxX, hy
    have nonnegative := IsMetric.nonnegative with metric, hxX, hy
    apply functionPreimage.membership.backward
    refine ⟨hxX, ?_⟩
    rw value
    apply openBall.membership.backward
    refine ⟨dxy, ?_⟩
    unfold dist
    have zero := realSubValue.zero_right at d(x, y)
    have unfolded := abs.of_nonnegative with nonnegative
    rw [zero, unfolded]
    rwa symmetric at near
  . intro hx
    obtain ⟨hxX, inBall⟩ := functionPreimage.membership.forward with hx
    have value := distanceTo.value at X, d, y, x with metric, hy, hxX
    rw value at inBall
    have symmetric := IsMetric.symmetric with metric, hy, hxX
    have dxy := IsMetric.real with metric, hxX, hy
    have nonnegative := IsMetric.nonnegative with metric, hxX, hy
    obtain ⟨valueReal, near⟩ := openBall.membership.forward with inBall
    unfold dist at near
    have zero := realSubValue.zero_right at d(x, y)
    have unfolded := abs.of_nonnegative with nonnegative
    rw [zero, unfolded] at near
    apply ball.of_distance with hxX
    rwa symmetric
