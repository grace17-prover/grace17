-- Bundled metric spaces: a space as one structure of its carrier and its
-- distance, the metric laws under their standard names, balls, the metric
-- topology as a space, convergence written u ⇝ x with its ε–N form, the
-- uniqueness of limits, and the metric rewrite set
-- Part of Cumulus, the Grace17 mathematics library.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module Grace.Cumulus.Metric.Structure
import Maps
import Topology.Spaces

-- A metric space is a structure of its carrier and its distance, a
-- real-valued function on pairs of points written d(x, y) under a
-- hypothesis MetricSpace(X) and applied as X.dist(x, y) otherwise, built by
-- MetricSpace.mk(A, d) and read back by the projections X.carrier and
-- X.dist. MetricSpace(X) says that the distance is nonnegative, vanishes
-- exactly on the diagonal, is symmetric, and satisfies the triangle
-- inequality. IsMetric(A, d) remains the form over separate pieces, bridged
-- below.
structure MetricSpace
  | carrier : Set
  | dist : carrier × carrier → ℝ
  where
    dist_nonneg : ∀ x y ∈ carrier, relates(realLe, (0:R), dist(x, y))
    dist_eq_zero : ∀ x y ∈ carrier, dist(x, y) = (0:R) ↔ x = y
    dist_comm : ∀ x y ∈ carrier, dist(x, y) = dist(y, x)
    dist_triangle : ∀ x y z ∈ carrier,
      relates(realLe, dist(x, z), realAdd(dist(x, y), dist(y, z)))

-- The projection laws of a constructed metric space as one rewrite set.
tactic metric_projections := simp [MetricSpace.mk.carrier, MetricSpace.mk.dist]

-- Bridges between the structure and the form over separate pieces. The
-- bundled-to-unbundled direction is an instance, so `with *` reads the
-- metric off a space hypothesis.
instance MetricSpace.parts (X : Set)
  requires metric : MetricSpace(X)
  shows IsMetric(X.carrier, X.dist)
proof
  obtain ⟨shape, function, nonneg, zero, comm, triangle⟩ := metric
  unfold IsMetric
  exact ⟨function, nonneg, zero, comm, triangle⟩

theorem MetricSpace.of_parts (A d : Set)
  requires metric : IsMetric(A, d)
  shows MetricSpace(MetricSpace.mk(A, d))
proof
  obtain ⟨function, nonneg, zero, comm, triangle⟩ := metric
  apply MetricSpace.intro
  . exact function
  . exact nonneg
  . exact zero
  . exact comm
  . exact triangle

theorem MetricSpace.of_projections (X : Set)
  requires shape : MetricSpace.Data(X)
  requires metric : IsMetric(X.carrier, X.dist)
  shows MetricSpace(X)
proof
  obtain ⟨function, nonneg, zero, comm, triangle⟩ := metric
  unfold MetricSpace
  exact ⟨shape, function, nonneg, zero, comm, triangle⟩

theorem MetricSpace.eta_of_space (X : Set)
  requires metric : MetricSpace(X)
  shows X = MetricSpace.mk(X.carrier, X.dist)
proof
  obtain ⟨shape, rest⟩ := metric
  exact MetricSpace.eta with shape

-- The metric topology as a space: the open sets are those containing a
-- ball around each of their points. Its carrier is the carrier of X and
-- its open sets are metricTopology(A, d) over the pieces.
def metricTopology (X : Set) : Set :=
  TopologicalSpace.mk(MetricSpace.carrier(X),
    metricTopology(MetricSpace.carrier(X), MetricSpace.dist(X)))

theorem metricTopology.carrier (X : Set)
  shows TopologicalSpace.carrier(metricTopology(X)) = MetricSpace.carrier(X)
proof
  unfold metricTopology
  topology_projections

theorem metricTopology.opens (X : Set)
  shows TopologicalSpace.opens(metricTopology(X)) =
    metricTopology(MetricSpace.carrier(X), MetricSpace.dist(X))
proof
  unfold metricTopology
  topology_projections

instance MetricSpace.topological_space (X : Set)
  requires metric : MetricSpace(X)
  shows TopologicalSpace(metricTopology(X))
proof
  have parts := MetricSpace.parts with metric
  unfold metricTopology
  exact TopologicalSpace.of_parts with (Open.metricTopology.topology with parts)

instance MetricSpace.hausdorff (X : Set)
  requires metric : MetricSpace(X)
  shows Hausdorff(metricTopology(X))
proof
  have parts := MetricSpace.parts with metric
  unfold metricTopology
  exact Hausdorff.of_mk with (Open.metricTopology.hausdorff with parts)

-- A sequence converging to a point of a metric space is written u ⇝ x: it
-- is convergence in the metric topology. Under a hypothesis MetricSpace(X)
-- a binder (x : X) is a set variable with x ∈ X.carrier.
notation infix 50 "⇝" => Converges(metricTopology(X), _, _) via hypothesis MetricSpace(X) for X.carrier

-- The distance between two points is written d(x, y) wherever a hypothesis
-- in scope supplies the space; it is the value X.dist(x, y).
notation function "d(x, y)" => X.dist(x, y) via hypothesis MetricSpace(X) for X.carrier

-- The open and closed balls. ball(A, d, x, r) and closedBall(A, d, x, r)
-- remain the forms over separate pieces.
def ball (X x : Set, r : Real) : Set :=
  ball(MetricSpace.carrier(X), MetricSpace.dist(X), x, r)
def closedBall (X x : Set, r : Real) : Set :=
  closedBall(MetricSpace.carrier(X), MetricSpace.dist(X), x, r)

theorem ball.parts (X x : Set, r : Real)
  shows ball(X, x, r) = ball(MetricSpace.carrier(X), MetricSpace.dist(X), x, r)
proof
  simp [ball]

theorem closedBall.parts (X x : Set, r : Real)
  shows closedBall(X, x, r) =
    closedBall(MetricSpace.carrier(X), MetricSpace.dist(X), x, r)
proof
  simp [closedBall]

-- Under a hypothesis MetricSpace(X): Cauchy(X, u) says the terms of u are
-- eventually within any ε of each other, and Bounded(X, S) that the
-- distances within S have a bound. IsCauchy(A, d, u) and IsBounded(A, d, S)
-- remain the forms over separate pieces.
section Definitions
variable (X : Set)
hypothesis metric : MetricSpace(X)

predicate Cauchy (u : Set) := IsCauchy(X.carrier, X.dist, u)
predicate Bounded (S : Set) := IsBounded(X.carrier, X.dist, S)

end Definitions

section MetricLaws
variable (X : Set)
hypothesis metric : MetricSpace(X)

-- A distance is a real number; this is an instance, so the real
-- arithmetic and order on distances is synthesized.
instance dist_real (x y : X)
  shows d(x, y) ∈ ℝ
proof
  have parts := MetricSpace.parts with metric
  exact IsMetric.member_reals with parts, *

theorem dist_nonneg (x y : X)
  shows (0:R) ≤ d(x, y)
proof
  have parts := MetricSpace.parts with metric
  exact IsMetric.nonnegative with parts, *

theorem dist_self (x : X)
  shows d(x, x) = (0:R)
proof
  have parts := MetricSpace.parts with metric
  exact IsMetric.self with parts, *

theorem dist_comm (x y : X)
  shows d(x, y) = d(y, x)
proof
  have parts := MetricSpace.parts with metric
  exact IsMetric.symmetric with parts, *

theorem dist_triangle (x y z : X)
  shows d(x, z) ≤ d(x, y) + d(y, z)
proof
  have parts := MetricSpace.parts with metric
  exact IsMetric.triangle with parts, *

theorem dist_eq_zero (x y : X)
  shows d(x, y) = (0:R) ↔ x = y
proof
  have parts := MetricSpace.parts with metric
  exact IsMetric.eq_zero_iff with parts, *

theorem dist_pos (x y : X)
  shows (0:R) < d(x, y) ↔ x ≠ y
proof
  have parts := MetricSpace.parts with metric
  exact IsMetric.positive_iff_ne with parts, *

theorem dist_triangle_left (x y z : X)
  shows d(y, z) ≤ d(x, y) + d(x, z)
proof
  have parts := MetricSpace.parts with metric
  exact IsMetric.triangle_from with parts, *

theorem abs_dist_sub_le (x y z : X)
  shows abs(d(x, z) - d(y, z)) ≤ d(x, y)
proof
  have parts := MetricSpace.parts with metric
  exact IsMetric.abs_sub_le with parts, *

-- Balls.
theorem mem_ball (x y : X) (r : Real)
  shows y ∈ ball(X, x, r) ↔ d(x, y) < r
proof
  have yIn : y ∈ X by assumption
  rw ball.parts
  have characterization := ball.membership at X.carrier, X.dist, x, r, y
  constructor
  . intro member
    have parts := characterization.forward with member
    exact parts.right
  . intro close
    exact characterization.backward with ⟨yIn, close⟩

theorem mem_closedBall (x y : X) (r : Real)
  shows y ∈ closedBall(X, x, r) ↔ d(x, y) ≤ r
proof
  have yIn : y ∈ X by assumption
  rw closedBall.parts
  have characterization := closedBall.membership at X.carrier, X.dist, x, r, y
  constructor
  . intro member
    have parts := characterization.forward with member
    exact parts.right
  . intro close
    exact characterization.backward with ⟨yIn, close⟩

theorem ball_subset (x : X) (r : Real)
  shows ball(X, x, r) ⊆ X
proof
  rw ball.parts
  exact Ball.ball.subset at X.carrier, X.dist, x, r

theorem mem_ball_self (x : X) (r : Real)
  requires positive : 0 < r
  shows x ∈ ball(X, x, r)
proof
  have parts := MetricSpace.parts with metric
  rw ball.parts
  exact ball.center with parts, *

theorem ball_mono (x : X) (r s : Real)
  requires radii : r ≤ s
  shows ball(X, x, r) ⊆ ball(X, x, s)
proof
  have parts := MetricSpace.parts with metric
  rw [ball.parts, ball.parts]
  exact Ball.ball.mono with parts, *

theorem ball_subset_closedBall (x : X) (r : Real)
  shows ball(X, x, r) ⊆ closedBall(X, x, r)
proof
  have parts := MetricSpace.parts with metric
  rw [ball.parts, closedBall.parts]
  exact Ball.ball.subset_closedBall with parts, *

-- The open sets of the metric topology: a set is open exactly when it
-- contains a ball around each of its points, and balls are open.
theorem Open.iff_balls (U : Set)
  requires hU : U ⊆ X
  shows Open(metricTopology(X), U) ↔
    ∀ x ∈ U, ∃ r ∈ ℝ, 0 < r ∧ ball(X, x, r) ⊆ U
proof
  have space := MetricSpace.topological_space with metric
  constructor
  . intros open x hx
    have member := Open.mem with open
    rw metricTopology.opens at member
    have inside := metricTopology.ball_inside with member, hx
    obtain ⟨r, hr, positive, small⟩ := inside
    witness r
    rw ball.parts
    exact ⟨hr, positive, small⟩
  . intro balls
    have engine : MetricOpen(X.carrier, X.dist, U)
      unfold MetricOpen
      refine ⟨hU, ?_⟩
      intros x hx
      obtain ⟨r, hr, positive, inside⟩ := balls with x, hx
      rw ball.parts at inside
      exact ⟨r, hr, positive, inside⟩
    have member : U ∈ TopologicalSpace.opens(metricTopology(X))
      rw metricTopology.opens
      exact metricTopology.of_open with engine
    exact Open.of_mem with space, member

instance ball_open (x : X) (r : Real)
  shows Open(metricTopology(X), ball(X, x, r))
proof
  have parts := MetricSpace.parts with metric
  have space := MetricSpace.topological_space with metric
  have member : ball(X, x, r) ∈ TopologicalSpace.opens(metricTopology(X))
    rw [metricTopology.opens, ball.parts]
    exact ball.member_topology with parts, *
  exact Open.of_mem with space, member

instance closedBall_closed (x : X) (r : Real)
  shows Closed(metricTopology(X), closedBall(X, x, r))
proof
  have parts := MetricSpace.parts with metric
  have closed := Closed.closedBall.closed with parts, *
  unfold MetricClosed at closed
  rw closedBall.parts
  unfold metricTopology
  exact Closed.of_mk with (Open.metricTopology.topology with parts), closed

-- Convergence: u ⇝ x is convergence in the metric topology, which is the
-- ε–N form over the pieces and the textbook form on distances.
theorem Converges.iff_parts (u : Set) (x : X)
  requires sequence : u : ℕ → X.carrier
  shows u ⇝ x ↔ ConvergesIn(X.carrier, X.dist, u, x)
proof
  have parts := MetricSpace.parts with metric
  have space := MetricSpace.topological_space with metric
  have xIn : x ∈ X by assumption
  have sequenceIn : SequenceIn(X.carrier, u)
    unfold SequenceIn
    exact sequence
  have characterization := ConvergesIn.iff_open with parts, sequenceIn, xIn
  constructor
  . intro converges
    apply characterization.backward
    intros U open hxU
    have member : U ∈ TopologicalSpace.opens(metricTopology(X))
      rw metricTopology.opens
      exact metricTopology.of_open with open
    have openU := Open.of_mem with space, member
    exact Converges.eventually with converges, openU, hxU
  . intro converges
    have eventually : ∀ U, Open(metricTopology(X), U) → x ∈ U →
        ∃ N ∈ ℕ, ∀ n ∈ ℕ, N ≤ n → u(n) ∈ U
      intros U open hxU
      have member := Open.mem with open
      rw metricTopology.opens at member
      have metricOpen := metricTopology.open with member
      exact ConvergesIn.eventually_in_open with converges, metricOpen, hxU
    have sequenceT : u : ℕ → TopologicalSpace.carrier(metricTopology(X))
      rw metricTopology.carrier
      exact sequence
    have xInT : x ∈ TopologicalSpace.carrier(metricTopology(X))
      rw metricTopology.carrier
      exact xIn
    exact Converges.of_eventually with space, sequenceT, xInT, eventually

theorem Converges.iff_dist (u : Set) (x : X)
  requires sequence : u : ℕ → X.carrier
  shows u ⇝ x ↔
    ∀ ε ∈ ℝ, 0 < ε →
      ∃ N ∈ ℕ, ∀ n ∈ ℕ, N ≤ n → d(x, u(n)) < ε
proof
  have bridge := Converges.iff_parts with *
  have xIn : x ∈ X by assumption
  have sequenceIn : SequenceIn(X.carrier, u)
    unfold SequenceIn
    exact sequence
  constructor
  . intro converges
    have engine := bridge.forward with converges
    obtain ⟨sequenceU, point, control⟩ := engine
    exact control
  . intro control
    apply bridge.backward
    unfold ConvergesIn
    exact ⟨sequenceIn, xIn, control⟩

-- A sequence has at most one limit.
theorem Converges.unique_metric (u : Set) (x y : X)
  requires first : u ⇝ x
  requires second : u ⇝ y
  shows x = y
proof
  have space := MetricSpace.topological_space with metric
  have hausdorff := MetricSpace.hausdorff with metric
  exact Spaces.Converges.unique with space, hausdorff, first, second

theorem Converges.cauchy (u : Set) (x : X)
  requires converges : u ⇝ x
  shows Cauchy(X, u)
proof
  have parts := MetricSpace.parts with metric
  have space := MetricSpace.topological_space with metric
  have sequence := Converges.sequence with space, converges
  rw metricTopology.carrier at sequence
  have bridge := Converges.iff_parts with sequence
  have engine := bridge.forward with converges
  unfold Cauchy
  exact ConvergesIn.cauchy with parts, engine

theorem Converges.bounded_range (u : Set) (x : X)
  requires converges : u ⇝ x
  shows Bounded(X, functionImage(u, ℕ, X.carrier))
proof
  have parts := MetricSpace.parts with metric
  have space := MetricSpace.topological_space with metric
  have sequence := Converges.sequence with space, converges
  rw metricTopology.carrier at sequence
  have bridge := Converges.iff_parts with sequence
  have engine := bridge.forward with converges
  unfold Bounded
  exact ConvergesIn.range_bounded with parts, engine

instance Cauchy.parts (u : Set)
  requires cauchy : Cauchy(X, u)
  shows IsCauchy(X.carrier, X.dist, u)
proof
  unfold Cauchy at cauchy
  exact cauchy

theorem Cauchy.of_parts (u : Set)
  requires cauchy : IsCauchy(X.carrier, X.dist, u)
  shows Cauchy(X, u)
proof
  unfold Cauchy
  exact cauchy

instance Bounded.parts (S : Set)
  requires bounded : Bounded(X, S)
  shows IsBounded(X.carrier, X.dist, S)
proof
  unfold Bounded at bounded
  exact bounded

theorem Bounded.of_parts (S : Set)
  requires bounded : IsBounded(X.carrier, X.dist, S)
  shows Bounded(X, S)
proof
  unfold Bounded
  exact bounded

instance ball_bounded (x : X) (r : Real)
  shows Bounded(X, ball(X, x, r))
proof
  have parts := MetricSpace.parts with metric
  unfold Bounded
  rw ball.parts
  exact Bounded.IsBounded.ball with parts, *

theorem Cauchy.bounded_range (u : Set)
  requires cauchy : Cauchy(X, u)
  shows Bounded(X, functionImage(u, ℕ, X.carrier))
proof
  have parts := MetricSpace.parts with metric
  have pieces := Cauchy.parts with cauchy
  unfold Bounded
  exact Bounded.IsCauchy.range_bounded with parts, pieces

end MetricLaws

-- The metric rewrite set: the distance from a point to itself, the
-- vanishing criterion, and membership in balls.
tactic metric_simp := simp [dist_self, dist_eq_zero, mem_ball, mem_closedBall]
