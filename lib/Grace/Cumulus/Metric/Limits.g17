module Grace.Cumulus.Metric.Limits
import Product

theorem SequenceIn.constant (X x : Set)
  requires hx : x ∈ X
  shows SequenceIn(X, constantFunction(ℕ, X, x))
proof
  exact constantFunction.function at ℕ, X, x with hx

theorem IsCauchy.constant (X d x : Set)
  requires metric : IsMetric(X, d)
  requires hx : x ∈ X
  shows IsCauchy(X, d, constantFunction(ℕ, X, x))
proof
  have converges := constantFunction.converges_in with metric, hx
  exact ConvergesIn.cauchy with metric, converges

-- Convergence through open neighbourhoods of the limit.
theorem ConvergesIn.iff_open (X d u x : Set)
  requires metric : IsMetric(X, d)
  requires sequence : SequenceIn(X, u)
  requires hx : x ∈ X
  shows ConvergesIn(X, d, u, x) ↔
    (∀ U, MetricOpen(X, d, U) → x ∈ U → ∃ N ∈ ℕ, ∀ n ∈ ℕ, (N ≤ n → u(n) ∈ U))
proof
  constructor
  . intro converges
    intros U open hxU
    exact ConvergesIn.eventually_in_open with converges, open, hxU
  . intro neighbourhoods
    apply ConvergesIn.of_eventually with sequence, hx
    intros ε hε positive
    have typedE : Real(ε) by exact hε
    have open := ball.open at X, d, x, ε with metric, hx
    have center := ball.center with metric, hx, positive
    obtain ⟨N, hN, inside⟩ := neighbourhoods with ball(X, d, x, ε), open, center
    refine ⟨N, hN, ?_⟩
    intros n hn le
    exact ball.distance with (inside with n, hn, le)

-- Sequences that agree from some index on have the same limits.
theorem ConvergesIn.of_eventually_equal (X d u v x M : Set)
  requires converges : ConvergesIn(X, d, u, x)
  requires sequence : SequenceIn(X, v)
  requires hM : M ∈ ℕ
  requires agree : ∀ n ∈ ℕ, (M ≤ n → v(n) = u(n))
  shows ConvergesIn(X, d, v, x)
proof
  have hx := ConvergesIn.limit_point with converges
  apply ConvergesIn.of_eventually with sequence, hx
  intros ε hε positive
  obtain ⟨N, hN, near⟩ := ConvergesIn.eventually with converges, positive
  have natM : Nat(M) by exact hM
  have natN : Nat(N) by exact hN
  obtain ⟨K, hK, leM, leN⟩ := naturalPair.upper_bound at M, N
  refine ⟨K, hK, ?_⟩
  intros n hn le
  have natK : Nat(K) by exact hK
  have natn : Nat(n) by exact hn
  have aboveM := LessEqual.transitive with leM, le
  have aboveN := LessEqual.transitive with leN, le
  have same := agree with n, hn, aboveM
  rw same
  exact near with n, hn, aboveN

theorem ConvergesIn.limit_in_closedBall (X d u x y : Set, r : Real)
  requires metric : IsMetric(X, d)
  requires converges : ConvergesIn(X, d, u, x)
  requires hy : y ∈ X
  requires terms : ∀ n ∈ ℕ, u(n) ∈ closedBall(X, d, y, r)
  shows x ∈ closedBall(X, d, y, r)
proof
  have closed := closedBall.closed at X, d, y, r with metric, hy
  exact ConvergesIn.limit_in_closed with closed, terms, converges

theorem ConvergesIn.distance_le (X d u x y : Set, r : Real)
  requires metric : IsMetric(X, d)
  requires converges : ConvergesIn(X, d, u, x)
  requires hy : y ∈ X
  requires bounds : ∀ n ∈ ℕ, d(y, u(n)) ≤ r
  shows d(y, x) ≤ r
proof
  have sequence := ConvergesIn.sequence with converges
  have terms : ∀ n ∈ ℕ, u(n) ∈ closedBall(X, d, y, r)
    intros n hn
    have term := SequenceIn.term_of_member with sequence, hn
    exact closedBall.of_distance with term, (bounds with n, hn)
  have inBall := ConvergesIn.limit_in_closedBall with
    metric, converges, hy, terms
  exact closedBall.distance with inBall

theorem ConvergesIn.map_continuous (f X d Y e u x : Set)
  requires continuous : IsMetricContinuous(f, X, d, Y, e)
  requires converges : ConvergesIn(X, d, u, x)
  shows ConvergesIn(Y, e, compose(f, u, ℕ, X, Y), f(x))
proof
  have hx := ConvergesIn.limit_point with converges
  have atX := IsMetricContinuous.at with continuous, hx
  exact ConvergesIn.map with atX, converges

theorem IsLipschitz.cauchy (f X d Y e u : Set) (K : Real)
  requires metricD : IsMetric(X, d)
  requires metricE : IsMetric(Y, e)
  requires lipschitz : IsLipschitz(f, X, d, Y, e, K)
  requires cauchy : IsCauchy(X, d, u)
  shows IsCauchy(Y, e, compose(f, u, ℕ, X, Y))
proof
  have uniform := IsLipschitz.uniformly_continuous with
    metricD, metricE, lipschitz
  exact IsUniformlyContinuous.cauchy with uniform, cauchy

theorem IsIsometry.cauchy (f X d Y e u : Set)
  requires isometry : IsIsometry(f, X, d, Y, e)
  requires cauchy : IsCauchy(X, d, u)
  shows IsCauchy(Y, e, compose(f, u, ℕ, X, Y))
proof
  have uniform := IsIsometry.uniformly_continuous with isometry
  exact IsUniformlyContinuous.cauchy with uniform, cauchy

theorem IsIsometry.converges (f X d Y e u x : Set)
  requires isometry : IsIsometry(f, X, d, Y, e)
  requires converges : ConvergesIn(X, d, u, x)
  shows ConvergesIn(Y, e, compose(f, u, ℕ, X, Y), f(x))
proof
  have continuous := IsIsometry.continuous with isometry
  exact ConvergesIn.map_continuous with continuous, converges

-- The real sequence of distances to a point.
defgraph distanceSequence (X d u x : Set) (n ∈ ℕ) : ℝ := d(x, u(n))
requires metric : IsMetric(X, d)
requires sequence : SequenceIn(X, u)
requires hx : x ∈ X
proof
  have term := SequenceIn.term_of_member with sequence, member
  exact IsMetric.real with metric, hx, term

theorem distanceSequence.real_sequence (X d u x : Set)
  requires metric : IsMetric(X, d)
  requires sequence : SequenceIn(X, u)
  requires hx : x ∈ X
  shows RealSequence(distanceSequence(X, d, u, x))
proof
  exact distanceSequence.function with metric, sequence, hx

-- A sequence converges to x exactly when its distances to x tend to zero.
theorem ConvergesIn.distance_converges (X d u x : Set)
  requires metric : IsMetric(X, d)
  requires converges : ConvergesIn(X, d, u, x)
  shows ConvergesTo(distanceSequence(X, d, u, x), (0:R))
proof
  have sequence := ConvergesIn.sequence with converges
  have hx := ConvergesIn.limit_point with converges
  unfold ConvergesTo
  constructor
  . exact distanceSequence.real_sequence with metric, sequence, hx
  . intros E hE positive
    obtain ⟨N, hN, near⟩ := ConvergesIn.eventually with converges, positive
    refine ⟨N, hN, ?_⟩
    intros n hn le
    have term := SequenceIn.term_of_member with sequence, hn
    have distance := IsMetric.real with metric, hx, term
    have nonnegative := IsMetric.nonnegative with metric, hx, term
    have close := near with n, hn, le
    have value := distanceSequence.value at X, d, u, x, n with
      metric, sequence, hx
    rw value
    apply openBall.membership.backward
    refine ⟨distance, ?_⟩
    unfold dist
    have zero := realSubValue.zero_right at d(x, u(n))
    have unfolded := abs.of_nonnegative with nonnegative
    rw [zero, unfolded]
    exact close

theorem ConvergesIn.of_distance_converges (X d u x : Set)
  requires metric : IsMetric(X, d)
  requires sequence : SequenceIn(X, u)
  requires hx : x ∈ X
  requires converges : ConvergesTo(distanceSequence(X, d, u, x), (0:R))
  shows ConvergesIn(X, d, u, x)
proof
  obtain ⟨realSequence, tail⟩ := converges
  apply ConvergesIn.of_eventually with sequence, hx
  intros ε hε positive
  obtain ⟨N, hN, near⟩ := tail with ε, hε, positive
  refine ⟨N, hN, ?_⟩
  intros n hn le
  have term := SequenceIn.term_of_member with sequence, hn
  have distance := IsMetric.real with metric, hx, term
  have nonnegative := IsMetric.nonnegative with metric, hx, term
  have inBall := near with n, hn, le
  have value := distanceSequence.value at X, d, u, x, n with
    metric, sequence, hx
  rw value at inBall
  obtain ⟨valueReal, close⟩ := openBall.membership.forward with inBall
  unfold dist at close
  have zero := realSubValue.zero_right at d(x, u(n))
  have unfolded := abs.of_nonnegative with nonnegative
  rw [zero, unfolded] at close
  exact close

theorem ConvergesIn.iff_distance_converges (X d u x : Set)
  requires metric : IsMetric(X, d)
  requires sequence : SequenceIn(X, u)
  requires hx : x ∈ X
  shows
    ConvergesIn(X, d, u, x) ↔ ConvergesTo(distanceSequence(X, d, u, x), (0:R))
proof
  constructor
  . intro converges
    exact ConvergesIn.distance_converges with metric, converges
  . intro converges
    exact ConvergesIn.of_distance_converges with metric, sequence, hx, converges

-- The closure in metric terms.
theorem metricClosure.closed (X d A : Set)
  requires metric : IsMetric(X, d)
  requires hA : A ⊆ X
  shows MetricClosed(X, d, closure(X, metricTopology(X, d), A))
proof
  exact closure.closed with (metricTopology.topology with metric), hA

theorem metricClosure.contains (X d A : Set)
  requires metric : IsMetric(X, d)
  requires hA : A ⊆ X
  shows A ⊆ closure(X, metricTopology(X, d), A)
proof
  exact Grace.Cumulus.Topology.Space.closure.contains with
    (metricTopology.topology with metric), hA

theorem metricClosure.subset (X d A : Set)
  requires metric : IsMetric(X, d)
  requires hA : A ⊆ X
  shows closure(X, metricTopology(X, d), A) ⊆ X
proof
  exact closure.subset with (metricTopology.topology with metric), hA

theorem metricClosure.least (X d A C : Set)
  requires closed : MetricClosed(X, d, C)
  requires hAC : A ⊆ C
  shows closure(X, metricTopology(X, d), A) ⊆ C
proof
  unfold MetricClosed at closed
  exact closure.least with closed, hAC

theorem metricClosure.of_closed (X d C : Set)
  requires metric : IsMetric(X, d)
  requires closed : MetricClosed(X, d, C)
  shows closure(X, metricTopology(X, d), C) = C
proof
  unfold MetricClosed at closed
  exact closure.of_closed with (metricTopology.topology with metric), closed

theorem MetricClosed.iff_closure (X d C : Set)
  requires metric : IsMetric(X, d)
  requires hC : C ⊆ X
  shows MetricClosed(X, d, C) ↔ closure(X, metricTopology(X, d), C) = C
proof
  constructor
  . intro closed
    exact metricClosure.of_closed with metric, closed
  . intro equal
    have closed := metricClosure.closed with metric, hC
    rwa equal at closed

-- The closure of a bounded set is bounded.
theorem IsBounded.closure (X d S : Set)
  requires metric : IsMetric(X, d)
  requires bounded : IsBounded(X, d, S)
  shows IsBounded(X, d, closure(X, metricTopology(X, d), S))
proof
  have inside := IsBounded.subset with bounded
  have split : Nonempty(S) ∨ ¬Nonempty(S) by tauto
  cases split with nonempty | empty
  . obtain ⟨x, hx⟩ := nonempty
    have hxX := inside with x, hx
    obtain ⟨r, hr, positive, ballInside⟩ :=
      IsBounded.ball_around with metric, bounded, hx
    have typedR : Real(r) by exact hr
    have closed := closedBall.closed at X, d, x, r with metric, hxX
    have closedInside := ball.subset_closedBall with metric, hxX
    have insideClosed := Subset.transitive with ballInside, closedInside
    have least := metricClosure.least with closed, insideClosed
    exact IsBounded.of_closedBall with metric, hxX, least
  . have equal : S = ∅
      apply Subset.antisymmetric
      . intros s hs
        exfalso
        apply empty
        exact ⟨s, hs⟩
      . exact empty.subset at S
    rw equal
    have closedEmpty := MetricClosed.empty at X, d with metric
    have same := metricClosure.of_closed with metric, closedEmpty
    rw same
    exact IsBounded.empty at X, d

theorem MetricOpen.difference (X d U C : Set)
  requires metric : IsMetric(X, d)
  requires open : MetricOpen(X, d, U)
  requires closed : MetricClosed(X, d, C)
  shows MetricOpen(X, d, U ∖ C)
proof
  have openComplement := MetricClosed.complement_open with closed
  have both := MetricOpen.intersection2 with metric, open, openComplement
  have same : U ∖ C = U ∩ complement(X, C)
    have insideU := MetricOpen.subset with open
    ext y
    constructor
    . intro hy
      have parts := difference.membership.forward with hy
      apply intersection.membership.backward
      refine ⟨parts.left, ?_⟩
      exact complement.membership.backward with ⟨(insideU with
        y, parts.left), parts.right⟩
    . intro hy
      have parts := intersection.membership.forward with hy
      have away := complement.membership.forward with parts.right
      exact difference.membership.backward with ⟨parts.left, away.right⟩
  rwa same

theorem MetricClosed.difference (X d C U : Set)
  requires metric : IsMetric(X, d)
  requires closed : MetricClosed(X, d, C)
  requires open : MetricOpen(X, d, U)
  shows MetricClosed(X, d, C ∖ U)
proof
  have closedComplement := MetricOpen.complement_closed with metric, open
  have both := MetricClosed.intersection2 with metric, closed, closedComplement
  have same : C ∖ U = C ∩ complement(X, U)
    have insideC := MetricClosed.subset with closed
    ext y
    constructor
    . intro hy
      have parts := difference.membership.forward with hy
      apply intersection.membership.backward
      refine ⟨parts.left, ?_⟩
      exact complement.membership.backward with ⟨(insideC with
        y, parts.left), parts.right⟩
    . intro hy
      have parts := intersection.membership.forward with hy
      have away := complement.membership.forward with parts.right
      exact difference.membership.backward with ⟨parts.left, away.right⟩
  rwa same

theorem ball.subset_interior_closedBall (X d x : Set, r : Real)
  requires metric : IsMetric(X, d)
  requires hx : x ∈ X
  shows
    ball(X, d, x, r) ⊆ interiorIn(metricTopology(X, d), closedBall(X, d, x, r))
proof
  have open := ball.member_topology at X, d, x, r with metric, hx
  have inside := ball.subset_closedBall with metric, hx
  exact interiorIn.greatest with open, inside

-- A point is isolated exactly when some ball around it is a singleton.
theorem metricTopology.singleton_open_iff (X d x : Set)
  requires metric : IsMetric(X, d)
  requires hx : x ∈ X
  shows MetricOpen(X, d, {x}) ↔ ∃ r ∈ ℝ, 0 < r ∧ ball(X, d, x, r) = {x}
proof
  constructor
  . intro open
    obtain ⟨r, hr, positive, inside⟩ :=
      MetricOpen.ball_inside with open, (singleton.self at x)
    refine ⟨r, hr, positive, ?_⟩
    apply Subset.antisymmetric
    . exact inside
    . intros y hy
      have same := singleton.membership.forward with hy
      rw same
      exact ball.center with metric, hx, positive
  . intro data
    obtain ⟨r, hr, positive, same⟩ := data
    constructor
    . intros y hy
      have equal := singleton.membership.forward with hy
      rwa equal
    . intros y hy
      have equal := singleton.membership.forward with hy
      rw under equal
      refine ⟨r, hr, positive, ?_⟩
      rw same
      exact Subset.reflexive at {x}
