module Grace.Cumulus.Metric.Line
import Uniform
import Topology.Real

defgraph realDistance (p ∈ ℝ × ℝ) : ℝ :=
  dist(firstProjection(ℝ, ℝ)(p), secondProjection(ℝ, ℝ)(p))
proof
  have first := firstProjection.function at ℝ, ℝ
  have second := secondProjection.function at ℝ, ℝ
  have realA : Real(firstProjection(ℝ, ℝ)(p))
    exact FunctionBetween.apply_closed with first, member
  have realB : Real(secondProjection(ℝ, ℝ)(p))
    exact FunctionBetween.apply_closed with second, member
  exact dist.real with realA, realB

theorem realDistance.apply (x y : Real)
  shows realDistance(x, y) = dist(x, y)
proof
  have realX : x ∈ ℝ by simp [Real]
  have realY : y ∈ ℝ by simp [Real]
  have pair := product.pair_membership.backward at x, y, ℝ, ℝ with
    ⟨realX, realY⟩
  have value := realDistance.value with pair
  have first := firstProjection.pair at ℝ, ℝ, x, y with realX, realY
  have second := secondProjection.pair at ℝ, ℝ, x, y with realX, realY
  unfold call2
  cc

theorem realDistance.metric
  shows IsMetric(ℝ, realDistance)
proof
  constructor
  . exact realDistance.function
  . constructor
    . intros x hx y hy
      have typedX : Real(x) by exact hx
      have typedY : Real(y) by exact hy
      have value := realDistance.apply at x, y with *
      rw value
      exact dist.nonnegative with typedX, typedY
    . constructor
      . intros x hx y hy
        have typedX : Real(x) by exact hx
        have typedY : Real(y) by exact hy
        have value := realDistance.apply at x, y with *
        rw value
        exact dist.eq_zero_iff at x, y with *
      . constructor
        . intros x hx y hy
          have typedX : Real(x) by exact hx
          have typedY : Real(y) by exact hy
          have valueXY := realDistance.apply at x, y with *
          have valueYX := realDistance.apply at y, x with *
          rw [valueXY, valueYX]
          exact dist.symmetric at x, y with *
        . intros x hx y hy z hz
          have typedX : Real(x) by exact hx
          have typedY : Real(y) by exact hy
          have typedZ : Real(z) by exact hz
          have valueXZ := realDistance.apply at x, z with *
          have valueXY := realDistance.apply at x, y with *
          have valueYZ := realDistance.apply at y, z with *
          rw [valueXZ, valueXY, valueYZ]
          exact dist.triangle at x, y, z with *

theorem realDistance.ball (x r : Real)
  shows ball(ℝ, realDistance, x, r) = openBall(x, r)
proof
  ext y
  constructor
  . intro hy
    have hyR := ball.point with hy
    have near := ball.distance with hy
    have typedY : Real(y) by exact hyR
    have value := realDistance.apply at x, y with *
    have symmetric := dist.symmetric at x, y with *
    rw [value, symmetric] at near
    apply openBall.membership.backward
    exact ⟨hyR, near⟩
  . intro hy
    obtain ⟨hyR, near⟩ := openBall.membership.forward with hy
    have typedY : Real(y) by exact hyR
    have value := realDistance.apply at x, y with *
    have symmetric := dist.symmetric at x, y with *
    apply ball.of_distance with hyR
    rw [value, symmetric]
    exact near

theorem realDistance.closedBall (x r : Real)
  shows closedBall(ℝ, realDistance, x, r) = closedInterval(x - r, x + r)
proof
  ext y
  constructor
  . intro hy
    have hyR := closedBall.point with hy
    have near := closedBall.distance with hy
    have typedY : Real(y) by exact hyR
    have value := realDistance.apply at x, y with *
    rw value at near
    unfold dist at near
    have upper := abs.upper at x - y
    have upperNeg := abs.upper_neg at x - y
    apply closedInterval.membership.backward
    refine ⟨hyR, ?_, ?_⟩
    . linarith
    . linarith
  . intro hy
    obtain ⟨hyR, lower, upper⟩ := closedInterval.membership.forward with hy
    have typedY : Real(y) by exact hyR
    have value := realDistance.apply at x, y with *
    apply closedBall.of_distance with hyR
    rw value
    unfold dist
    have sign := realLess.trichotomy at (0:R), x - y
    rcases sign with positive | zero | negative
    . have nonnegative : 0 ≤ x - y by linarith
      have unfolded := abs.of_nonnegative with nonnegative
      rw unfolded
      linarith
    . have nonnegative : 0 ≤ x - y by linarith
      have unfolded := abs.of_nonnegative with nonnegative
      rw unfolded
      linarith
    . have nonpositive : x - y ≤ 0 by linarith
      have unfolded := abs.of_nonpositive with nonpositive
      rw unfolded
      linarith

theorem realDistance.topology
  shows metricTopology(ℝ, realDistance) = realTopology
proof
  ext U
  constructor
  . intro hU
    obtain ⟨bound, balls⟩ := metricTopology.membership.forward with hU
    have inside := powerset.membership_iff.forward with bound
    apply realTopology.membership.backward
    refine ⟨bound, ?_⟩
    intros x hx
    obtain ⟨E, hE, positive, ballInside⟩ := balls with x, hx
    have typedX : Real(x) by exact inside with x, hx
    have typedE : Real(E) by exact hE
    have same := realDistance.ball at x, E with *
    rw same at ballInside
    exact ⟨E, hE, positive, ballInside⟩
  . intro hU
    obtain ⟨bound, balls⟩ := realTopology.membership.forward with hU
    have inside := powerset.membership_iff.forward with bound
    apply metricTopology.membership.backward
    refine ⟨bound, ?_⟩
    intros x hx
    obtain ⟨E, hE, positive, ballInside⟩ := balls with x, hx
    have typedX : Real(x) by exact inside with x, hx
    have typedE : Real(E) by exact hE
    have same := realDistance.ball at x, E with *
    rw ← same at ballInside
    exact ⟨E, hE, positive, ballInside⟩

theorem realDistance.hausdorff
  shows IsHausdorff(ℝ, metricTopology(ℝ, realDistance))
proof
  exact metricTopology.hausdorff with realDistance.metric

-- ε–δ continuity of a real function is metric continuity for realDistance.
theorem realDistance.continuous_iff (f : Set)
  shows Continuous(f) ↔ IsMetricContinuous(f, ℝ, realDistance, ℝ, realDistance)
proof
  have metric := realDistance.metric
  have topological := Continuous.continuous_map at f
  have metrical := IsMetricContinuous.iff_continuous_map at
    f, ℝ, realDistance, ℝ, realDistance with metric, metric
  rw realDistance.topology at metrical
  constructor
  . intro continuous
    exact metrical.backward with (topological.forward with continuous)
  . intro continuous
    exact topological.backward with (metrical.forward with continuous)

theorem realDistance.converges_iff (u : Set) (L : Real)
  shows ConvergesTo(u, L) ↔ ConvergesIn(ℝ, realDistance, u, L)
proof
  have realL : L ∈ ℝ by simp [Real]
  constructor
  . intro converges
    obtain ⟨sequence, tail⟩ := converges
    have function : u : ℕ → ℝ by exact sequence
    have sequenceIn : SequenceIn(ℝ, u) by exact function
    apply ConvergesIn.of_eventually with sequenceIn, realL
    intros ε hε positive
    obtain ⟨N, hN, near⟩ := tail with ε, hε, positive
    refine ⟨N, hN, ?_⟩
    intros n hn le
    have inBall := near with n, hn, le
    obtain ⟨termR, close⟩ := openBall.membership.forward with inBall
    have typedN : Real(u(n)) by exact termR
    have value := realDistance.apply at L, u(n) with *
    have symmetric := dist.symmetric at L, u(n) with *
    rw [value, symmetric]
    exact close
  . intro converges
    have sequenceIn := ConvergesIn.sequence with converges
    have function := SequenceIn.function with sequenceIn
    have sequence : RealSequence(u) by exact function
    constructor
    . exact sequence
    . intros ε hε positive
      obtain ⟨N, hN, near⟩ := ConvergesIn.eventually with converges, positive
      refine ⟨N, hN, ?_⟩
      intros n hn le
      have close := near with n, hn, le
      have termR := SequenceIn.term_of_member with sequenceIn, hn
      have typedN : Real(u(n)) by exact termR
      have value := realDistance.apply at L, u(n) with *
      have symmetric := dist.symmetric at L, u(n) with *
      rw [value, symmetric] at close
      apply openBall.membership.backward
      exact ⟨termR, close⟩

-- The real line is complete: a Cauchy sequence is bounded, so it lies in a
-- closed interval, where Bolzano–Weierstrass provides a convergent
-- subsequence, whose limit the whole sequence then approaches.
theorem realDistance.complete
  shows IsComplete(ℝ, realDistance)
proof
  have metric := realDistance.metric
  apply IsComplete.of_limits with metric
  intros u cauchy
  have sequenceIn := IsCauchy.sequence with cauchy
  have function := SequenceIn.function with sequenceIn
  have sequence : RealSequence(u) by exact function
  obtain ⟨r, hr, close⟩ := IsCauchy.bounded with metric, cauchy
  have zero : 0 ∈ ℕ by exact nat.omega.forward at 0 with
    Naturals.constructor.zero
  have term0 := SequenceIn.term_of_member with sequenceIn, zero
  have typed0 : Real(u(0)) by exact term0
  have typedR : Real(r) by exact hr
  have terms : TermsIn(u, closedInterval(u(0) - r, u(0) + r))
    intros n hn
    have termN := SequenceIn.term_of_member with sequenceIn, hn
    have typedN : Real(u(n)) by exact termN
    have near := close with n, hn
    have value := realDistance.apply at u(0), u(n) with *
    rw value at near
    unfold dist at near
    have upper := abs.upper at u(0) - u(n)
    have upperNeg := abs.upper_neg at u(0) - u(n)
    apply closedInterval.membership.backward
    refine ⟨termN, ?_, ?_⟩
    . linarith
    . linarith
  obtain ⟨k, increasing, L, hL, inInterval, converges⟩ :=
    closedInterval.bolzano_weierstrass with sequence, terms
  have typedL : Real(L) by exact hL
  have bridge := realDistance.converges_iff at subsequence(u, k), L with *
  have subConverges := bridge.forward with converges
  unfold subsequence at subConverges
  have limit := IsCauchy.converges_of_subsequence with
    metric, cauchy, increasing, subConverges
  exact ⟨L, hL, limit⟩
