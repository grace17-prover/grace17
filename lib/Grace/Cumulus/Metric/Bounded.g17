-- Authors: Grant Passmore

module Grace.Cumulus.Metric.Bounded
import Sequences

predicate IsBounded (X d S : Set) :=
  (S ⊆ X) ∧ (∃ r ∈ ℝ, ∀ x ∈ S, ∀ y ∈ S, d(x, y) ≤ r)

theorem IsBounded.subset (X d S : Set)
  requires bounded : IsBounded(X, d, S)
  shows S ⊆ X
proof
  exact bounded.left

theorem IsBounded.bound (X d S : Set)
  requires bounded : IsBounded(X, d, S)
  shows ∃ r ∈ ℝ, ∀ x ∈ S, ∀ y ∈ S, d(x, y) ≤ r
proof
  exact bounded.right

theorem IsBounded.of_bound (X d S : Set, r : Real)
  requires inside : S ⊆ X
  requires bound : ∀ x ∈ S, ∀ y ∈ S, d(x, y) ≤ r
  shows IsBounded(X, d, S)
proof
  have realR : r ∈ ℝ by typecheck
  exact ⟨inside, r, realR, bound⟩

theorem IsBounded.empty (X d : Set)
  shows IsBounded(X, d, ∅)
proof
  apply IsBounded.of_bound at X, d, ∅, (0:R) with (empty.subset at X)
  intros x hx
  exfalso
  exact empty.membership with hx

theorem IsBounded.singleton (X d x : Set)
  requires metric : IsMetric(X, d)
  requires hx : x ∈ X
  shows IsBounded(X, d, {x})
proof
  have inside : {x} ⊆ X
    intros z hz
    have same := singleton.membership.forward with hz
    rwa same
  apply IsBounded.of_bound at X, d, {x}, (0:R) with inside
  intros y hy z hz
  have sameY := singleton.membership.forward with hy
  have sameZ := singleton.membership.forward with hz
  rw [sameY, sameZ]
  have self := IsMetric.self with metric, hx
  rw self
  exact realLe.reflexive

theorem IsBounded.of_subset (X d S T : Set)
  requires bounded : IsBounded(X, d, T)
  requires inside : S ⊆ T
  shows IsBounded(X, d, S)
proof
  obtain ⟨insideT, r, hr, bound⟩ := bounded
  refine ⟨(Subset.transitive with inside, insideT), r, hr, ?_⟩
  intros x hx y hy
  exact bound with x, (inside with x, hx), y, (inside with y, hy)

theorem IsBounded.intersection2 (X d S T : Set)
  requires bounded : IsBounded(X, d, S)
  shows IsBounded(X, d, S ∩ T)
proof
  exact IsBounded.of_subset with bounded, (intersection.subset_left at S, T)

theorem IsBounded.ball (X d x : Set, r : Real)
  requires metric : IsMetric(X, d)
  requires hx : x ∈ X
  shows IsBounded(X, d, ball(X, d, x, r))
proof
  apply IsBounded.of_bound at X, d, ball(X, d, x, r), r + r with
    (ball.subset at X, d, x, r)
  intros y hy z hz
  have hyX := ball.point with hy
  have hzX := ball.point with hz
  have nearY := ball.distance with hy
  have nearZ := ball.distance with hz
  have triangle := IsMetric.triangle_from with metric, hx, hyX, hzX
  have dxy := IsMetric.real with metric, hx, hyX
  have dxz := IsMetric.real with metric, hx, hzX
  have dyz := IsMetric.real with metric, hyX, hzX
  linarith

theorem IsBounded.closedBall (X d x : Set, r : Real)
  requires metric : IsMetric(X, d)
  requires hx : x ∈ X
  shows IsBounded(X, d, closedBall(X, d, x, r))
proof
  apply IsBounded.of_bound at X, d, closedBall(X, d, x, r), r + r with
    (closedBall.subset at X, d, x, r)
  intros y hy z hz
  have hyX := closedBall.point with hy
  have hzX := closedBall.point with hz
  have nearY := closedBall.distance with hy
  have nearZ := closedBall.distance with hz
  have triangle := IsMetric.triangle_from with metric, hx, hyX, hzX
  have dxy := IsMetric.real with metric, hx, hyX
  have dxz := IsMetric.real with metric, hx, hzX
  have dyz := IsMetric.real with metric, hyX, hzX
  linarith

theorem IsBounded.sphere (X d x : Set, r : Real)
  requires metric : IsMetric(X, d)
  requires hx : x ∈ X
  shows IsBounded(X, d, sphere(X, d, x, r))
proof
  have bounded := IsBounded.closedBall at X, d, x, r with metric, hx
  exact IsBounded.of_subset with bounded, (sphere.subset_closedBall with
    metric, hx)

theorem IsBounded.of_ball (X d S x : Set, r : Real)
  requires metric : IsMetric(X, d)
  requires hx : x ∈ X
  requires inside : S ⊆ ball(X, d, x, r)
  shows IsBounded(X, d, S)
proof
  exact IsBounded.of_subset with (IsBounded.ball at X, d, x, r with
    metric, hx), inside

theorem IsBounded.of_closedBall (X d S x : Set, r : Real)
  requires metric : IsMetric(X, d)
  requires hx : x ∈ X
  requires inside : S ⊆ closedBall(X, d, x, r)
  shows IsBounded(X, d, S)
proof
  exact IsBounded.of_subset with (IsBounded.closedBall at X, d, x, r with
    metric, hx), inside

-- A nonempty bounded set lies in a ball around any of its points.
theorem IsBounded.ball_around (X d S x : Set)
  requires metric : IsMetric(X, d)
  requires bounded : IsBounded(X, d, S)
  requires hx : x ∈ S
  shows ∃ r ∈ ℝ, 0 < r ∧ S ⊆ ball(X, d, x, r)
proof
  obtain ⟨inside, r, hr, bound⟩ := bounded
  have hxX := inside with x, hx
  have self := IsMetric.self with metric, hxX
  have nonnegative : (0:R) ≤ r
    have selfBound := bound with x, hx, x, hx
    rw self at selfBound
    exact selfBound
  have radiusReal : r + 1 ∈ ℝ by typecheck
  have positive : (0:R) < r + 1 by linarith
  refine ⟨r + 1, radiusReal, positive, ?_⟩
  intros y hy
  have hyX := inside with y, hy
  have dxy := IsMetric.real with metric, hxX, hyX
  have near := bound with x, hx, y, hy
  apply ball.of_distance with hyX
  linarith

theorem IsBounded.in_ball (X d S : Set)
  requires metric : IsMetric(X, d)
  requires bounded : IsBounded(X, d, S)
  requires nonempty : Nonempty(S)
  shows ∃ x ∈ X, ∃ r ∈ ℝ, 0 < r ∧ S ⊆ ball(X, d, x, r)
proof
  obtain ⟨x, hx⟩ := nonempty
  have hxX := IsBounded.subset with bounded, x, hx
  obtain ⟨r, hr, positive, inside⟩ :=
    IsBounded.ball_around with metric, bounded, hx
  exact ⟨x, hxX, r, hr, positive, inside⟩

theorem IsBounded.iff_ball (X d S : Set)
  requires metric : IsMetric(X, d)
  requires nonempty : Nonempty(S)
  shows IsBounded(X, d, S) ↔ ∃ x ∈ X, ∃ r ∈ ℝ, S ⊆ ball(X, d, x, r)
proof
  constructor
  . intro bounded
    obtain ⟨x, hx, r, hr, positive, inside⟩ :=
      IsBounded.in_ball with metric, bounded, nonempty
    exact ⟨x, hx, r, hr, inside⟩
  . intro data
    obtain ⟨x, hx, r, hr, inside⟩ := data
    exact IsBounded.of_ball with metric, hx, inside

theorem IsBounded.nonnegative_bound (X d S : Set)
  requires metric : IsMetric(X, d)
  requires bounded : IsBounded(X, d, S)
  shows ∃ r ∈ ℝ, 0 ≤ r ∧ ∀ x ∈ S, ∀ y ∈ S, d(x, y) ≤ r
proof
  obtain ⟨inside, r, hr, bound⟩ := bounded
  have split : Nonempty(S) ∨ ¬Nonempty(S) by tauto
  cases split with nonempty | empty
  . obtain ⟨x, hx⟩ := nonempty
    have hxX := inside with x, hx
    have self := IsMetric.self with metric, hxX
    have selfBound := bound with x, hx, x, hx
    rw self at selfBound
    exact ⟨r, hr, selfBound, bound⟩
  . have zeroReal : (0:R) ∈ ℝ by typecheck
    have reflexive : (0:R) ≤ 0 by linarith
    refine ⟨(0:R), zeroReal, reflexive, ?_⟩
    intros x hx
    exfalso
    apply empty
    exact ⟨x, hx⟩

-- The union of two bounded sets is bounded.
theorem IsBounded.union2 (X d S T : Set)
  requires metric : IsMetric(X, d)
  requires boundedS : IsBounded(X, d, S)
  requires boundedT : IsBounded(X, d, T)
  shows IsBounded(X, d, S ∪ T)
proof
  have insideS := IsBounded.subset with boundedS
  have insideT := IsBounded.subset with boundedT
  have inside := union2.subset with insideS, insideT
  have splitS : Nonempty(S) ∨ ¬Nonempty(S) by tauto
  have splitT : Nonempty(T) ∨ ¬Nonempty(T) by tauto
  cases splitS with nonemptyS | emptyS
  . cases splitT with nonemptyT | emptyT
    . obtain ⟨s, hs⟩ := nonemptyS
      obtain ⟨t, ht⟩ := nonemptyT
      have hsX := insideS with s, hs
      have htX := insideT with t, ht
      obtain ⟨r, hr, positiveR, ballS⟩ :=
        IsBounded.ball_around with metric, boundedS, hs
      obtain ⟨q, hq, positiveQ, ballT⟩ :=
        IsBounded.ball_around with metric, boundedT, ht
      have dst := IsMetric.real with metric, hsX, htX
      apply IsBounded.of_bound at
        X, d, S ∪ T, (r + d(s, t) + q) + (r + d(s, t) + q) with
        inside
      have reach : ∀ x ∈ S ∪ T, d(s, x) ≤ r + d(s, t) + q
        intros x hx
        have hxX := inside with x, hx
        have dsx := IsMetric.real with metric, hsX, hxX
        have cases := union2.membership.forward with hx
        cases cases with inS | inT
        . have near := ball.distance with (ballS with x, inS)
          have nonnegative := IsMetric.nonnegative with metric, hsX, htX
          linarith
        . have near := ball.distance with (ballT with x, inT)
          have dtx := IsMetric.real with metric, htX, hxX
          have triangle := IsMetric.triangle with metric, hsX, htX, hxX
          linarith
      intros x hx y hy
      have hxX := inside with x, hx
      have hyX := inside with y, hy
      have reachX := reach with x, hx
      have reachY := reach with y, hy
      have triangle := IsMetric.triangle_from with metric, hsX, hxX, hyX
      have dsx := IsMetric.real with metric, hsX, hxX
      have dsy := IsMetric.real with metric, hsX, hyX
      have dxy := IsMetric.real with metric, hxX, hyX
      linarith
    . have equal : T = ∅
        apply Subset.antisymmetric
        . intros t ht
          exfalso
          apply emptyT
          exact ⟨t, ht⟩
        . exact empty.subset at T
      rw equal
      rw union2.right_empty
      exact boundedS
  . have equal : S = ∅
      apply Subset.antisymmetric
      . intros s hs
        exfalso
        apply emptyS
        exact ⟨s, hs⟩
      . exact empty.subset at S
    rw equal
    rw union2.left_empty
    exact boundedT

theorem IsBounded.union_singleton (X d S x : Set)
  requires metric : IsMetric(X, d)
  requires bounded : IsBounded(X, d, S)
  requires hx : x ∈ X
  shows IsBounded(X, d, {x} ∪ S)
proof
  exact IsBounded.union2 with metric, (IsBounded.singleton with metric, hx),
    bounded

theorem IsBounded.pair (X d x y : Set)
  requires metric : IsMetric(X, d)
  requires hx : x ∈ X
  requires hy : y ∈ X
  shows IsBounded(X, d, {x, y})
proof
  rw pair.eq_union2
  exact IsBounded.union2 with metric, (IsBounded.singleton with metric, hx),
    (IsBounded.singleton with metric, hy)

-- The range of a Cauchy sequence is bounded.
theorem IsCauchy.range_bounded (X d u : Set)
  requires metric : IsMetric(X, d)
  requires cauchy : IsCauchy(X, d, u)
  shows IsBounded(X, d, functionImage(u, ℕ, X))
proof
  have sequence := IsCauchy.sequence with cauchy
  obtain ⟨r, hr, close⟩ := IsCauchy.bounded with metric, cauchy
  have zero : 0 ∈ ℕ by exact nat.omega.forward at 0 with
    Naturals.constructor.zero
  have term0 := SequenceIn.term_of_member with sequence, zero
  apply IsBounded.of_bound at X, d, functionImage(u, ℕ, X), r + r with
    (functionImage.subset at u, ℕ, X)
  intros x hx y hy
  obtain ⟨hxX, m, hm, shapeX⟩ := functionImage.membership.forward with hx
  obtain ⟨hyX, n, hn, shapeY⟩ := functionImage.membership.forward with hy
  have closeM := close with m, hm
  have closeN := close with n, hn
  rw ← shapeX at closeM
  rw ← shapeY at closeN
  have triangle := IsMetric.triangle_from with metric, term0, hxX, hyX
  have d0x := IsMetric.real with metric, term0, hxX
  have d0y := IsMetric.real with metric, term0, hyX
  have dxy := IsMetric.real with metric, hxX, hyX
  linarith

theorem ConvergesIn.range_bounded (X d u x : Set)
  requires metric : IsMetric(X, d)
  requires converges : ConvergesIn(X, d, u, x)
  shows IsBounded(X, d, functionImage(u, ℕ, X))
proof
  have cauchy := ConvergesIn.cauchy with metric, converges
  exact IsCauchy.range_bounded with metric, cauchy

-- Lipschitz maps send bounded sets to bounded sets.
theorem IsLipschitz.image_bounded (f X d Y e S : Set) (K : Real)
  requires metricD : IsMetric(X, d)
  requires metricE : IsMetric(Y, e)
  requires lipschitz : IsLipschitz(f, X, d, Y, e, K)
  requires bounded : IsBounded(X, d, S)
  shows IsBounded(Y, e, functionImage(f, S, Y))
proof
  have function := IsLipschitz.function with lipschitz
  have nonnegative := IsLipschitz.nonnegative with lipschitz
  have inside := IsBounded.subset with bounded
  obtain ⟨r, hr, bound⟩ := IsBounded.bound with bounded
  apply IsBounded.of_bound at Y, e, functionImage(f, S, Y), K * r with
    (functionImage.subset at f, S, Y)
  intros v hv w hw
  obtain ⟨hvY, x, hx, shapeV⟩ := functionImage.membership.forward with hv
  obtain ⟨hwY, y, hy, shapeW⟩ := functionImage.membership.forward with hw
  rw [shapeV, shapeW]
  have hxX := inside with x, hx
  have hyX := inside with y, hy
  have estimate := IsLipschitz.bound with lipschitz, hxX, hyX
  have distance := bound with x, hx, y, hy
  have dxy := IsMetric.real with metricD, hxX, hyX
  have scaled := realLe.mul_left_of_nonnegative with distance, nonnegative
  have imageX := FunctionBetween.apply_closed with function, hxX
  have imageY := FunctionBetween.apply_closed with function, hyX
  have exy := IsMetric.real with metricE, imageX, imageY
  linarith
