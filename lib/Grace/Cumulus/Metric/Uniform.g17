-- Uniform continuity between metric spaces: Lipschitz maps and isometries
-- are uniformly continuous, uniformly continuous maps are continuous,
-- compose, and preserve Cauchy sequences
-- Part of Cumulus, the Grace17 mathematics library.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module Grace.Cumulus.Metric.Uniform
import Bounded

predicate IsUniformlyContinuous (f X d Y e : Set) :=
  FunctionBetween(f, X, Y) ∧
  (∀ ε ∈ ℝ, 0 < ε → ∃ δ ∈ ℝ, 0 < δ ∧
    ∀ x ∈ X, ∀ y ∈ X, (d(x, y) < δ → e(f(x), f(y)) < ε))

theorem IsUniformlyContinuous.function (f X d Y e : Set)
  requires uniform : IsUniformlyContinuous(f, X, d, Y, e)
  shows f : X → Y
proof
  exact uniform.left

theorem IsUniformlyContinuous.control (f X d Y e : Set, ε : Real)
  requires uniform : IsUniformlyContinuous(f, X, d, Y, e)
  requires positive : 0 < ε
  shows ∃ δ ∈ ℝ, 0 < δ ∧ ∀ x ∈ X, ∀ y ∈ X, (d(x, y) < δ → e(f(x), f(y)) < ε)
proof
  obtain ⟨function, control⟩ := uniform
  have realE : ε ∈ ℝ by typecheck
  exact control with ε, realE, positive

theorem IsUniformlyContinuous.of_control (f X d Y e : Set)
  requires function : f : X → Y
  requires control : ∀ ε ∈ ℝ, 0 < ε → ∃ δ ∈ ℝ, 0 < δ ∧
    ∀ x ∈ X, ∀ y ∈ X, (d(x, y) < δ → e(f(x), f(y)) < ε)
  shows IsUniformlyContinuous(f, X, d, Y, e)
proof
  exact ⟨function, control⟩

theorem IsUniformlyContinuous.continuous_at (f X d Y e x : Set)
  requires uniform : IsUniformlyContinuous(f, X, d, Y, e)
  requires hx : x ∈ X
  shows MetricContinuousAt(f, X, d, Y, e, x)
proof
  have function := IsUniformlyContinuous.function with uniform
  apply MetricContinuousAt.of_control with function, hx
  intros ε hε positive
  obtain ⟨δ, hδ, positiveD, maps⟩ :=
    IsUniformlyContinuous.control with uniform, positive
  refine ⟨δ, hδ, positiveD, ?_⟩
  intros y hy near
  exact maps with x, hx, y, hy, near

theorem IsUniformlyContinuous.continuous (f X d Y e : Set)
  requires uniform : IsUniformlyContinuous(f, X, d, Y, e)
  shows IsMetricContinuous(f, X, d, Y, e)
proof
  apply IsMetricContinuous.of_pointwise with (IsUniformlyContinuous.function with
    uniform)
  intros x hx
  exact IsUniformlyContinuous.continuous_at with uniform, hx

theorem IsLipschitz.uniformly_continuous (f X d Y e : Set) (K : Real)
  requires metricD : IsMetric(X, d)
  requires metricE : IsMetric(Y, e)
  requires lipschitz : IsLipschitz(f, X, d, Y, e, K)
  shows IsUniformlyContinuous(f, X, d, Y, e)
proof
  have function := IsLipschitz.function with lipschitz
  have nonnegative := IsLipschitz.nonnegative with lipschitz
  apply IsUniformlyContinuous.of_control with function
  intros ε hε positive
  obtain ⟨positiveD, small⟩ := Lipschitz.modulus with nonnegative, positive
  have quotientReal : ε / (K + 1) ∈ ℝ by typecheck
  refine ⟨ε / (K + 1), quotientReal, positiveD, ?_⟩
  intros x hx y hy near
  have bound := IsLipschitz.bound with lipschitz, hx, hy
  have imageX := FunctionBetween.apply_closed with function, hx
  have imageY := FunctionBetween.apply_closed with function, hy
  have dxy := IsMetric.real with metricD, hx, hy
  have exy := IsMetric.real with metricE, imageX, imageY
  have le := realLess.implies_le with near
  have scaled := realLe.mul_left_of_nonnegative with le, nonnegative
  linarith

theorem IsIsometry.uniformly_continuous (f X d Y e : Set)
  requires isometry : IsIsometry(f, X, d, Y, e)
  shows IsUniformlyContinuous(f, X, d, Y, e)
proof
  have function := IsIsometry.function with isometry
  apply IsUniformlyContinuous.of_control with function
  intros ε hε positive
  refine ⟨ε, hε, positive, ?_⟩
  intros x hx y hy near
  have preserved := IsIsometry.distance with isometry, hx, hy
  rwa preserved

theorem identity.uniformly_continuous (X d : Set)
  shows IsUniformlyContinuous(identity(X), X, d, X, d)
proof
  exact IsIsometry.uniformly_continuous with (identity.isometry at X, d)

theorem constantFunction.uniformly_continuous (X d Y e c : Set)
  requires metric : IsMetric(Y, e)
  requires hc : c ∈ Y
  shows IsUniformlyContinuous(constantFunction(X, Y, c), X, d, Y, e)
proof
  have function := constantFunction.function at X, Y, c with hc
  apply IsUniformlyContinuous.of_control with function
  intros ε hε positive
  refine ⟨ε, hε, positive, ?_⟩
  intros x hx y hy near
  have valueX := constantFunction.apply with hx, hc
  have valueY := constantFunction.apply with hy, hc
  rw [valueX, valueY]
  have self := IsMetric.self with metric, hc
  rw self
  exact positive

theorem IsUniformlyContinuous.compose (g f X d Y e Z k : Set)
  requires first : IsUniformlyContinuous(f, X, d, Y, e)
  requires second : IsUniformlyContinuous(g, Y, e, Z, k)
  shows IsUniformlyContinuous(compose(g, f, X, Y, Z), X, d, Z, k)
proof
  have fFunction := IsUniformlyContinuous.function with first
  have gFunction := IsUniformlyContinuous.function with second
  apply IsUniformlyContinuous.of_control with (compose.function with
    fFunction, gFunction)
  intros ε hε positive
  obtain ⟨η, hη, positiveH, mapsG⟩ :=
    IsUniformlyContinuous.control with second, positive
  obtain ⟨δ, hδ, positiveD, mapsF⟩ :=
    IsUniformlyContinuous.control with first, positiveH
  refine ⟨δ, hδ, positiveD, ?_⟩
  intros x hx y hy near
  have valueX := compose.apply with fFunction, gFunction, hx
  have valueY := compose.apply with fFunction, gFunction, hy
  rw [valueX, valueY]
  have imageX := FunctionBetween.apply_closed with fFunction, hx
  have imageY := FunctionBetween.apply_closed with fFunction, hy
  have middle := mapsF with x, hx, y, hy, near
  exact mapsG with f(x), imageX, f(y), imageY, middle

-- Uniformly continuous maps send Cauchy sequences to Cauchy sequences.
theorem IsUniformlyContinuous.cauchy (f X d Y e u : Set)
  requires uniform : IsUniformlyContinuous(f, X, d, Y, e)
  requires cauchy : IsCauchy(X, d, u)
  shows IsCauchy(Y, e, compose(f, u, ℕ, X, Y))
proof
  have function := IsUniformlyContinuous.function with uniform
  have sequence := IsCauchy.sequence with cauchy
  have uFunction := SequenceIn.function with sequence
  have composite := SequenceIn.compose with sequence, function
  apply IsCauchy.of_eventually with composite
  intros ε hε positive
  obtain ⟨δ, hδ, positiveD, maps⟩ :=
    IsUniformlyContinuous.control with uniform, positive
  obtain ⟨N, hN, close⟩ := IsCauchy.eventually with cauchy, positiveD
  refine ⟨N, hN, ?_⟩
  intros m hm n hn leM leN
  have termM := SequenceIn.term_of_member with sequence, hm
  have termN := SequenceIn.term_of_member with sequence, hn
  have valueM := compose.apply with uFunction, function, hm
  have valueN := compose.apply with uFunction, function, hn
  rw [valueM, valueN]
  exact maps with u(m), termM, u(n), termN, (close with m, hm, n, hn, leM, leN)

theorem IsUniformlyContinuous.of_isometry_compose (g f X d Y e Z k : Set)
  requires isometry : IsIsometry(f, X, d, Y, e)
  requires uniform : IsUniformlyContinuous(g, Y, e, Z, k)
  shows IsUniformlyContinuous(compose(g, f, X, Y, Z), X, d, Z, k)
proof
  have first := IsIsometry.uniformly_continuous with isometry
  exact IsUniformlyContinuous.compose with first, uniform
