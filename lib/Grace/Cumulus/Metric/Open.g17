-- The metric topology: open sets are those containing a ball around each of
-- their points; they form a Hausdorff topology in which balls are open
-- Part of Cumulus, the Grace17 mathematics library.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module Grace.Cumulus.Metric.Open
import Ball

predicate MetricOpen (X d U : Set) :=
  (U ⊆ X) ∧ (∀ x ∈ U, ∃ r ∈ ℝ, 0 < r ∧ ball(X, d, x, r) ⊆ U)

def metricTopology (X d : Set) : Set :=
  { U ∈ 𝒫(X) | ∀ x ∈ U, ∃ r ∈ ℝ, 0 < r ∧ ball(X, d, x, r) ⊆ U }

theorem metricTopology.membership (X d U : Set)
  shows U ∈ metricTopology(X, d) ↔
    U ∈ 𝒫(X) ∧ (∀ x ∈ U, ∃ r ∈ ℝ, 0 < r ∧ ball(X, d, x, r) ⊆ U)
proof
  simp [metricTopology]

theorem MetricOpen.subset (X d U : Set)
  requires open : MetricOpen(X, d, U)
  shows U ⊆ X
proof
  exact open.left

theorem MetricOpen.ball_inside (X d U x : Set)
  requires open : MetricOpen(X, d, U)
  requires hx : x ∈ U
  shows ∃ r ∈ ℝ, 0 < r ∧ ball(X, d, x, r) ⊆ U
proof
  exact open.right with x, hx

theorem metricTopology.of_open (X d U : Set)
  requires open : MetricOpen(X, d, U)
  shows U ∈ metricTopology(X, d)
proof
  obtain ⟨inside, balls⟩ := open
  apply metricTopology.membership.backward
  exact ⟨(powerset.membership_iff.backward with inside), balls⟩

theorem metricTopology.open (X d U : Set)
  requires member : U ∈ metricTopology(X, d)
  shows MetricOpen(X, d, U)
proof
  obtain ⟨bound, balls⟩ := metricTopology.membership.forward with member
  exact ⟨(powerset.membership_iff.forward with bound), balls⟩

theorem metricTopology.iff (X d U : Set)
  shows U ∈ metricTopology(X, d) ↔ MetricOpen(X, d, U)
proof
  constructor
  . intro member
    exact metricTopology.open with member
  . intro open
    exact metricTopology.of_open with open

theorem metricTopology.subset (X d U : Set)
  requires member : U ∈ metricTopology(X, d)
  shows U ⊆ X
proof
  exact MetricOpen.subset with (metricTopology.open with member)

theorem metricTopology.ball_inside (X d U x : Set)
  requires member : U ∈ metricTopology(X, d)
  requires hx : x ∈ U
  shows ∃ r ∈ ℝ, 0 < r ∧ ball(X, d, x, r) ⊆ U
proof
  exact MetricOpen.ball_inside with (metricTopology.open with member), hx

theorem metricTopology.subset_powerset (X d : Set)
  shows metricTopology(X, d) ⊆ 𝒫(X)
proof
  intros U hU
  exact powerset.membership_iff.backward with (metricTopology.subset with hU)

theorem MetricOpen.whole (X d : Set)
  shows MetricOpen(X, d, X)
proof
  constructor
  . exact Subset.reflexive at X
  . intros x hx
    have one : (1:R) ∈ ℝ by typecheck
    have positive : (0:R) < 1 by linarith
    exact ⟨(1:R), one, positive, (ball.subset at X, d, x, (1:R))⟩

theorem MetricOpen.empty (X d : Set)
  shows MetricOpen(X, d, ∅)
proof
  constructor
  . exact empty.subset at X
  . intros x hx
    exfalso
    exact empty.membership with hx

theorem MetricOpen.union (X d S : Set)
  requires open : ∀ U ∈ S, MetricOpen(X, d, U)
  shows MetricOpen(X, d, ⋃(S))
proof
  constructor
  . apply union.subset
    intros U hU
    exact MetricOpen.subset with (open with U, hU)
  . intros x hx
    obtain ⟨U, hU, hxU⟩ := union.membership.forward with hx
    obtain ⟨r, hr, positive, inside⟩ :=
      MetricOpen.ball_inside with (open with U, hU), hxU
    refine ⟨r, hr, positive, ?_⟩
    exact Subset.transitive with inside, (union.subset_of_member with hU)

theorem MetricOpen.union2 (X d U V : Set)
  requires openU : MetricOpen(X, d, U)
  requires openV : MetricOpen(X, d, V)
  shows MetricOpen(X, d, U ∪ V)
proof
  constructor
  . exact union2.subset with openU.left, openV.left
  . intros x hx
    have split := union2.membership.forward with hx
    cases split with inU | inV
    . obtain ⟨r, hr, positive, inside⟩ := MetricOpen.ball_inside with openU, inU
      refine ⟨r, hr, positive, ?_⟩
      exact Subset.transitive with inside, (union2.subset_left at U, V)
    . obtain ⟨r, hr, positive, inside⟩ := MetricOpen.ball_inside with openV, inV
      refine ⟨r, hr, positive, ?_⟩
      exact Subset.transitive with inside, (union2.subset_right at U, V)

theorem MetricOpen.intersection2 (X d U V : Set)
  requires metric : IsMetric(X, d)
  requires openU : MetricOpen(X, d, U)
  requires openV : MetricOpen(X, d, V)
  shows MetricOpen(X, d, U ∩ V)
proof
  constructor
  . exact Subset.transitive with (intersection.subset_left at U, V), openU.left
  . intros x hx
    have both := intersection.membership.forward with hx
    have hxX := openU.left with x, both.left
    obtain ⟨r, hr, positiveR, insideU⟩ :=
      MetricOpen.ball_inside with openU, both.left
    obtain ⟨s, hs, positiveS, insideV⟩ :=
      MetricOpen.ball_inside with openV, both.right
    have centerR := ball.center with metric, hxX, positiveR
    have centerS := ball.center with metric, hxX, positiveS
    obtain ⟨t, ht, positiveT, inR, inS⟩ :=
      ball.common_radius with metric, hxX, hxX, centerR, centerS
    refine ⟨t, ht, positiveT, ?_⟩
    apply intersection.greatest
    . exact Subset.transitive with inR, insideU
    . exact Subset.transitive with inS, insideV

theorem metricTopology.topology (X d : Set)
  requires metric : IsMetric(X, d)
  shows IsTopology(X, metricTopology(X, d))
proof
  constructor
  . exact metricTopology.subset_powerset at X, d
  . constructor
    . exact metricTopology.of_open with (MetricOpen.whole at X, d)
    . constructor
      . intros S hS
        apply metricTopology.of_open
        apply MetricOpen.union
        intros U hU
        exact metricTopology.open with (hS with U, hU)
      . intros U hU V hV
        have openU := metricTopology.open with hU
        have openV := metricTopology.open with hV
        exact metricTopology.of_open with (MetricOpen.intersection2 with
          metric, openU, openV)

theorem metricTopology.empty (X d : Set)
  shows ∅ ∈ metricTopology(X, d)
proof
  exact metricTopology.of_open with (MetricOpen.empty at X, d)

theorem metricTopology.whole (X d : Set)
  shows X ∈ metricTopology(X, d)
proof
  exact metricTopology.of_open with (MetricOpen.whole at X, d)

-- Balls are open.
theorem ball.open (X d x : Set, r : Real)
  requires metric : IsMetric(X, d)
  requires hx : x ∈ X
  shows MetricOpen(X, d, ball(X, d, x, r))
proof
  constructor
  . exact ball.subset at X, d, x, r
  . intros y hy
    have hyX := ball.point with hy
    have dxy := IsMetric.real with metric, hx, hyX
    have positive := ball.inside_radius_positive with metric, hx, hy
    have inside := ball.inside with metric, hx, hy
    have radiusReal : r - d(x, y) ∈ ℝ by typecheck
    exact ⟨r - d(x, y), radiusReal, positive, inside⟩

theorem ball.member_topology (X d x : Set, r : Real)
  requires metric : IsMetric(X, d)
  requires hx : x ∈ X
  shows ball(X, d, x, r) ∈ metricTopology(X, d)
proof
  exact metricTopology.of_open with (ball.open with metric, hx)

-- Distinct points are separated by disjoint balls, so the metric topology
-- is Hausdorff.
theorem metricTopology.hausdorff (X d : Set)
  requires metric : IsMetric(X, d)
  shows IsHausdorff(X, metricTopology(X, d))
proof
  intros x hx y hy distinct
  have dxy := IsMetric.real with metric, hx, hy
  have positive := ball.half_positive with metric, hx, hy, distinct
  have disjoint := ball.half_disjoint with metric, hx, hy, distinct
  refine ⟨ball(X, d, x, half(d(x, y))), (ball.member_topology with metric, hx),
    ball(X, d, y, half(d(x, y))), (ball.member_topology with
      metric, hy), ?_, ?_, disjoint⟩
  . exact ball.center with metric, hx, positive
  . exact ball.center with metric, hy, positive

-- A point is interior to A exactly when some ball around it lies in A.
theorem metricInterior.membership (X d A x : Set)
  requires metric : IsMetric(X, d)
  shows x ∈ interiorIn(metricTopology(X, d), A) ↔
    x ∈ X ∧ (∃ r ∈ ℝ, 0 < r ∧ ball(X, d, x, r) ⊆ A)
proof
  constructor
  . intro hx
    unfold interiorIn at hx
    obtain ⟨U, hU, hxU⟩ := union.membership.forward with hx
    obtain ⟨openU, inside⟩ := openSubsets.membership.forward with hU
    have hxX := metricTopology.subset with openU, x, hxU
    obtain ⟨r, hr, positive, ballInside⟩ :=
      metricTopology.ball_inside with openU, hxU
    exact ⟨hxX, r, hr, positive, (Subset.transitive with ballInside, inside)⟩
  . intro data
    obtain ⟨hxX, r, hr, positive, inside⟩ := data
    have openBall := ball.member_topology at X, d, x, r with metric, hxX
    have greatest := interiorIn.greatest with openBall, inside
    exact greatest with x, (ball.center with metric, hxX, positive)
