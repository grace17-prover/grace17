module Grace.Cumulus.LargeCardinal.Axioms
import Universe
import Inaccessible

-- Large cardinal axioms are not axioms of the kernel. They are nullary
-- predicates, written applied to no arguments: a theorem that needs one
-- takes it as a hypothesis, `requires TG : TarskiGrothendieck()` or a
-- section's `hypothesis TG : TarskiGrothendieck()`, so its certificate is
-- a ZF(C) proof of the implication from the axiom.

-- Every set is a member of some Grothendieck universe.
predicate TarskiGrothendieck := ∀ x, ∃ U, GrothendieckUniverse(U) ∧ x ∈ U

-- Some inaccessible cardinal exists.
predicate ExistsInaccessible := ∃ κ, Inaccessible(κ)

theorem ExistsInaccessible.iff_exists_universe
  shows ExistsInaccessible() ↔ ∃ U, GrothendieckUniverse(U)
proof
  unfold ExistsInaccessible
  constructor
  . intro exists
    obtain ⟨κ, inaccessible⟩ := exists
    exact ⟨V(κ), (Inaccessible.universe with inaccessible)⟩
  . intro exists
    obtain ⟨U, universe⟩ := exists
    exact ⟨ordinalsWithin(U), (GrothendieckUniverse.inaccessible with universe)⟩

section TarskiGrothendieckLaws
hypothesis TG : TarskiGrothendieck()

theorem TarskiGrothendieck.universe_containing (x : Set)
  shows ∃ U, GrothendieckUniverse(U) ∧ x ∈ U
proof
  exact TG with x

-- Every set lies in the stage V(κ) of some inaccessible κ.
theorem TarskiGrothendieck.inaccessible_containing (x : Set)
  shows ∃ κ, Inaccessible(κ) ∧ x ∈ V(κ)
proof
  obtain ⟨U, universe, hx⟩ := TarskiGrothendieck.universe_containing at x with TG
  have stage := GrothendieckUniverse.eq_V with universe
  rw stage at hx
  exact ⟨ordinalsWithin(U), (GrothendieckUniverse.inaccessible with universe), hx⟩

theorem TarskiGrothendieck.existsInaccessible
  shows ExistsInaccessible()
proof
  obtain ⟨U, universe, _⟩ := TarskiGrothendieck.universe_containing at ∅ with TG
  exact ExistsInaccessible.iff_exists_universe.backward with ⟨U, universe⟩

end TarskiGrothendieckLaws
