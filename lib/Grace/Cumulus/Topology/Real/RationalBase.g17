module Grace.Cumulus.Topology.Real.RationalBase
import Basis
import Real.Analysis.OpenIntervals
import Rat.Countable

-- The rationals are dense in the reals: between two reals lies a rational
-- cut. A real is a lower cut; a rational of y missing from x, pushed up
-- once inside y, has a cut strictly between the two.
theorem rationalCut.between (x y : Real)
  requires less : x < y
  shows ∃ q ∈ ℚ, x < rationalCut(q) ∧ rationalCut(q) < y
proof
  obtain ⟨typedX, typedY, inclusion⟩ :=
    realLess.characterization.forward with less
  have cutX := Real.characterization.forward with typedX
  have cutY := Real.characterization.forward with typedY
  obtain ⟨r, rInY, rMissing⟩ := ProperSubset.missing with inclusion
  obtain ⟨s, sInY, rLessS⟩ := DedekindCut.no_greatest with cutY, rInY
  have rationalsX := DedekindCut.subset_rationals with cutX
  have rationalsY := DedekindCut.subset_rationals with cutY
  have rInQ := rationalsY with r, rInY
  have sInQ := rationalsY with s, sInY
  have cutS := rationalCut.real at s with sInQ
  have transitive := rationalLess.transitive_on
  witness s
  refine ⟨sInQ, ?_, ?_⟩
  . apply realLess.characterization.backward
    refine ⟨typedX, cutS, ?_⟩
    constructor
    . intros p pInX
      have pInQ := rationalsX with p, pInX
      have pLessR := DedekindCut.lt_missing with cutX, pInX, rInQ, rMissing
      have pLessS := transitive with
        p, pInQ, r, rInQ, s, sInQ, pLessR, rLessS
      exact Grace.Cumulus.Real.Core.rationalCut.membership.backward with
        ⟨pInQ, pLessS⟩
    . intro same
      apply rMissing
      rw same
      exact Grace.Cumulus.Real.Core.rationalCut.membership.backward with
        ⟨rInQ, rLessS⟩
  . apply realLess.characterization.backward
    refine ⟨cutS, typedY, ?_⟩
    constructor
    . intros p pInCut
      obtain ⟨pInQ, pLessS⟩ :=
        Grace.Cumulus.Real.Core.rationalCut.membership.forward with pInCut
      exact DedekindCut.downward with cutY, sInY, pInQ, pLessS
    . intro same
      have sInCut : s ∈ rationalCut(s)
        rw same
        exact sInY
      obtain ⟨_, selfLess⟩ :=
        Grace.Cumulus.Real.Core.rationalCut.membership.forward with sInCut
      have irreflexive := rationalLess.irreflexive_on
      exact irreflexive with s, sInQ, selfLess

-- The cut embedding reflects the order.
theorem rationalCut.lt_of_cut_lt (p q : Rational)
  requires less : RealLess(rationalCut(p), rationalCut(q))
  shows p < q
proof
  have order := rationalLess.trichotomy at p, q
  cases order with below | rest
  . exact below
  . exfalso
    cases rest with equal | above
    . rw equal at less
      exact RealLess.irreflexive with less
    . have reversed := rationalCut.strict_mono with above
      have cycle := RealLess.transitive with less, reversed
      exact RealLess.irreflexive with cycle

theorem openInterval.subset_reals (A B : Real)
  shows openInterval(A, B) ⊆ ℝ
proof
  intros X hX
  obtain ⟨real, lower, upper⟩ := openInterval.membership.forward with hX
  exact real

-- A ball that stays between the endpoints lies in the interval.
theorem openInterval.ball_subset (A B X E : Real)
  requires lower : A ≤ X - E
  requires upper : X + E ≤ B
  shows openBall(X, E) ⊆ openInterval(A, B)
proof
  intros Y hY
  have ballInside := openBall.subset_reals at X, E
  have realY := ballInside with Y, hY
  obtain ⟨lowerY, upperY⟩ := openBall.order_characterization.forward with hY
  apply openInterval.membership.backward
  refine ⟨realY, ?_, ?_⟩
  . linarith
  . linarith

theorem openInterval.open (A B : Real)
  shows openInterval(A, B) ∈ realTopology
proof
  apply realTopology.membership.backward
  have inside := openInterval.subset_reals at A, B
  refine ⟨(powerset.membership_iff.backward with inside), ?_⟩
  intros x hx
  obtain ⟨realX, lower, upper⟩ := openInterval.membership.forward with hx
  have leftReal : x - A ∈ ℝ by typecheck
  have rightReal : B - x ∈ ℝ by typecheck
  have split : x - A ≤ B - x ∨ ¬(x - A ≤ B - x) by tauto
  cases split with leftSmaller | rightSmaller
  . have positive : (0:R) < x - A by linarith
    refine ⟨x - A, leftReal, positive, ?_⟩
    apply openInterval.ball_subset
    . linarith
    . linarith
  . have order := realLess.of_not_le with rightSmaller
    have positive : (0:R) < B - x by linarith
    refine ⟨B - x, rightReal, positive, ?_⟩
    apply openInterval.ball_subset
    . linarith
    . linarith

-- The open intervals with rational endpoints.
def rationalIntervals : Set :=
  { W ∈ 𝒫(ℝ) | ∃ p ∈ ℚ, ∃ q ∈ ℚ, p < q ∧
    W = openInterval(rationalCut(p), rationalCut(q)) }

theorem rationalIntervals.membership (W : Set)
  shows W ∈ rationalIntervals ↔
    W ∈ 𝒫(ℝ) ∧ (∃ p ∈ ℚ, ∃ q ∈ ℚ, p < q ∧
      W = openInterval(rationalCut(p), rationalCut(q)))
proof
  simp [rationalIntervals]

theorem openInterval.member_intervals (p q : Rational)
  requires less : p < q
  shows openInterval(rationalCut(p), rationalCut(q)) ∈ rationalIntervals
proof
  have realP := rationalCut.real at p with assumption
  have realQ := rationalCut.real at q with assumption
  have pInQ : p ∈ ℚ by typecheck
  have qInQ : q ∈ ℚ by typecheck
  apply rationalIntervals.membership.backward
  refine ⟨?_, p, pInQ, q, qInQ, less, rfl⟩
  apply powerset.membership_iff.backward
  exact openInterval.subset_reals at rationalCut(p), rationalCut(q)

theorem rationalIntervals.open
  shows rationalIntervals ⊆ realTopology
proof
  intros W hW
  have parts := rationalIntervals.membership.forward with hW
  obtain ⟨p, hp, q, hq, less, shape⟩ := parts.right
  have realP := rationalCut.real at p with hp
  have realQ := rationalCut.real at q with hq
  rw shape
  exact openInterval.open at rationalCut(p), rationalCut(q)

-- Every open set around a real contains a rational interval around it.
theorem rationalIntervals.basis
  shows Basis(ℝ, realTopology, rationalIntervals)
proof
  constructor
  . exact rationalIntervals.open
  . intros U hU x hx
    have parts := realTopology.membership.forward with hU
    have inside := powerset.membership_iff.forward with parts.left
    have realX := inside with x, hx
    obtain ⟨E, hE, positive, below⟩ := parts.right with x, hx
    have lowerReal : x - E ∈ ℝ by typecheck
    have upperReal : x + E ∈ ℝ by typecheck
    have lowerLess : x - E < x by linarith
    have upperLess : x < x + E by linarith
    obtain ⟨p, hp, lowerP, upperP⟩ := rationalCut.between with lowerLess
    obtain ⟨q, hq, lowerQ, upperQ⟩ := rationalCut.between with upperLess
    have realP := rationalCut.real at p with hp
    have realQ := rationalCut.real at q with hq
    have cutsOrdered := realLess.transitive with upperP, lowerQ
    have proper := realLess.characterization.forward with cutsOrdered
    have ordered := rationalCut.lt_of_cut_lt with proper
    have found := openInterval.member_intervals with ordered
    have center : x ∈ openInterval(rationalCut(p), rationalCut(q)) :=
      openInterval.membership.backward with ⟨realX, upperP, lowerQ⟩
    refine ⟨openInterval(rationalCut(p), rationalCut(q)), found, center, ?_⟩
    . intros y hy
      obtain ⟨realY, lowerY, upperY⟩ :=
        openInterval.membership.forward with hy
      have bounds : x - E < y ∧ y < x + E
        constructor
        . linarith
        . linarith
      have inBall := openBall.order_characterization.backward with bounds
      exact below with y, inBall

-- The pairs of rationals in increasing order index the rational intervals.
def rationalPairs : Set :=
  { r ∈ ℚ × ℚ | relates(rationalLess, fst(r), snd(r)) }

theorem rationalPairs.membership (r : Set)
  shows r ∈ rationalPairs ↔
    r ∈ ℚ × ℚ ∧ relates(rationalLess, fst(r), snd(r))
proof
  simp [rationalPairs]

theorem rationalPairs.countable
  shows Countable(rationalPairs)
proof
  have rationals := rationals.countable
  have pairs := Countable.product at ℚ, ℚ with rationals, rationals
  have subset : rationalPairs ⊆ ℚ × ℚ
    intros r hr
    have parts := rationalPairs.membership.forward with hr
    exact parts.left
  exact Countable.subset with pairs, subset

defgraph rationalInterval (r ∈ rationalPairs) : rationalIntervals :=
  openInterval(rationalCut(fst(r)), rationalCut(snd(r)))
proof
  have parts := rationalPairs.membership.forward with member
  obtain ⟨bound, p, hp, q, hq, shape⟩ :=
    product.membership.forward with parts.left
  have less := parts.right
  rw [shape, fst.pair, snd.pair] at less
  rw [shape, fst.pair, snd.pair]
  exact openInterval.member_intervals with less

theorem rationalInterval.surjective
  shows SurjectiveBetween(rationalInterval, rationalPairs, rationalIntervals)
proof
  constructor
  . exact rationalInterval.function
  . intros W hW
    have parts := rationalIntervals.membership.forward with hW
    obtain ⟨p, hp, q, hq, less, shape⟩ := parts.right
    have pairIn : (p, q) ∈ ℚ × ℚ := product.pair with hp, hq
    have inPairs : (p, q) ∈ rationalPairs
      apply rationalPairs.membership.backward
      refine ⟨pairIn, ?_⟩
      rw [fst.pair, snd.pair]
      exact less
    have value := rationalInterval.relates with inPairs
    rw [fst.pair, snd.pair, ← shape] at value
    exact ⟨(p, q), inPairs, value⟩

theorem rationalIntervals.countable
  shows Countable(rationalIntervals)
proof
  have countable := rationalPairs.countable
  have surjection := rationalInterval.surjective
  exact Countable.of_surjection with countable, surjection
