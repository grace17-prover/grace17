-- Cantor–Bendixson on the real line: every closed set of reals is the
-- disjoint union of a perfect set and a countable set, through the
-- countable basis of rational intervals
-- Part of Cumulus, the Grace17 mathematics library.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module Grace.Cumulus.Topology.Real.CantorBendixson
import RationalBase
import Topology.CantorBendixson

-- The kernel of a closed set of reals is perfect, lies inside the set,
-- and leaves a countable remainder.
theorem reals.cantorBendixson (A : Set)
  requires closed : IsClosed(ℝ, realTopology, A)
  shows Perfect(ℝ, realTopology, perfectKernel(ℝ, realTopology, A)) ∧
    perfectKernel(ℝ, realTopology, A) ⊆ A ∧
    Countable(A ∖ perfectKernel(ℝ, realTopology, A))
proof
  have topology := realTopology.topology
  have basis := rationalIntervals.basis
  have countable := rationalIntervals.countable
  exact cantorBendixson with topology, basis, closed, countable

theorem reals.kernel_perfect (A : Set)
  requires closed : IsClosed(ℝ, realTopology, A)
  shows Perfect(ℝ, realTopology, perfectKernel(ℝ, realTopology, A))
proof
  have parts := reals.cantorBendixson with closed
  exact parts.left

theorem reals.kernel_subset (A : Set)
  requires closed : IsClosed(ℝ, realTopology, A)
  shows perfectKernel(ℝ, realTopology, A) ⊆ A
proof
  obtain ⟨perfect, inside, countable⟩ := reals.cantorBendixson with closed
  exact inside

theorem reals.scattered_countable (A : Set)
  requires closed : IsClosed(ℝ, realTopology, A)
  shows Countable(A ∖ perfectKernel(ℝ, realTopology, A))
proof
  obtain ⟨perfect, inside, countable⟩ := reals.cantorBendixson with closed
  exact countable

-- The rank of a closed set of reals is a countable ordinal.
theorem reals.rank_countable (A : Set)
  requires closed : IsClosed(ℝ, realTopology, A)
  shows Countable(cantorBendixsonRank(ℝ, realTopology, A))
proof
  have topology := realTopology.topology
  have basis := rationalIntervals.basis
  have countable := rationalIntervals.countable
  exact cantorBendixson.rank_countable with topology, basis, closed, countable

-- A closed set of reals is countable or contains a nonempty perfect set:
-- either the kernel is empty and the set is its countable remainder, or
-- the kernel is the perfect part.
theorem closed.countable_or_perfect_part (A : Set)
  requires closed : IsClosed(ℝ, realTopology, A)
  shows Countable(A) ∨
    (∃ P, Nonempty(P) ∧ Perfect(ℝ, realTopology, P) ∧ P ⊆ A)
proof
  obtain ⟨perfect, inside, countable⟩ := reals.cantorBendixson with closed
  have split : Nonempty(perfectKernel(ℝ, realTopology, A)) ∨
    ¬Nonempty(perfectKernel(ℝ, realTopology, A)) by tauto
  cases split with nonempty | empty
  . right
    exact ⟨perfectKernel(ℝ, realTopology, A), nonempty, perfect, inside⟩
  . left
    have subset : A ⊆ A ∖ perfectKernel(ℝ, realTopology, A)
      intros x hx
      apply difference.membership.backward
      refine ⟨hx, ?_⟩
      intro inKernel
      exact empty with ⟨x, inKernel⟩
    exact Countable.subset with countable, subset
