-- The tube lemma and the compactness of a product: if A is compact in X
-- and B is compact in Y, then A × B is compact in the product topology.
-- Over each point x of A finitely many open boxes inside the cover cover
-- the slice {x} × B, and their widths meet in a tube; finitely many tubes
-- cover A. The finite families are handled by induction on finite sets,
-- so no selection is made.
-- Part of Cumulus, the Grace17 mathematics library.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module Grace.Cumulus.Topology.Tube
import Separation
import Cardinal.Counting

-- Section: The tube lemma without selection
-- The slices V of open boxes U × V through x inside some member of C.
def boxSlices (T S C x : Set) : Set :=
  { V ∈ S | ∃ U ∈ T, x ∈ U ∧ ∃ W ∈ C, U × V ⊆ W }

theorem boxSlices.cover (X T Y S C A B x : Set)
  requires topologyX : IsTopology(X, T)
  requires topologyY : IsTopology(Y, S)
  requires cover : OpenCover(productTopology(X, T, Y, S), A × B, C)
  requires hx : x ∈ A
  shows B ⊆ ⋃(boxSlices(T, S, C, x))
proof
  intros y hy
  have pair := product.pair with hx, hy
  obtain ⟨W, hW, hpW⟩ := union.membership.forward with
    (cover.right with (x, y), pair)
  have parts := productTopology.membership.forward with
    (cover.left with W, hW)
  obtain ⟨U, hU, V, hV, inBox, boxInside⟩ := parts.right with (x, y), hpW
  have coordinates := product.pair_membership.forward with inBox
  have member : V ∈ boxSlices(T, S, C, x) :=
    boxSlices.membership.backward with
      ⟨hV, U, hU, coordinates.left, W, hW, boxInside⟩
  exact union.contains with member, coordinates.right

-- Finitely many slices through x have a tube over their union.
def slicedFamilies (T S C x : Set) : Set :=
  { F ∈ 𝒫(boxSlices(T, S, C, x)) | ∃ U ∈ T, x ∈ U ∧
    ∃ H, H ⊆ C ∧ Finite(H) ∧ U × ⋃(F) ⊆ ⋃(H) }

theorem boxSlices.tube (X T S C x F : Set)
  requires topology : IsTopology(X, T)
  requires hx : x ∈ X
  requires inside : F ⊆ boxSlices(T, S, C, x)
  requires finite : Finite(F)
  shows ∃ U ∈ T, x ∈ U ∧ ∃ H, H ⊆ C ∧ Finite(H) ∧ U × ⋃(F) ⊆ ⋃(H)
proof
  have base : ∅ ∈ slicedFamilies(T, S, C, x)
    apply slicedFamilies.membership.backward
    refine ⟨(powerset.membership_iff.backward with
      (empty.subset at boxSlices(T, S, C, x))), X,
      (IsTopology.whole with topology), hx, ∅, (empty.subset at C),
      Finite.empty, ?_⟩
    intros p hp
    obtain ⟨bound, u, hu, y, hy, shape⟩ := product.membership.forward with hp
    rw union.empty at hy
    simp at hy
  have step : ∀ G ⊆ boxSlices(T, S, C, x), Finite(G) →
      ∀ V ∈ boxSlices(T, S, C, x), V ∉ G → G ∈ slicedFamilies(T, S, C, x) →
        G ∪ {V} ∈ slicedFamilies(T, S, C, x)
    intros G hG finiteG V hV fresh hasTube
    obtain ⟨_, U1, hU1, hxU1, H1, hH1, finiteH1, covered1⟩ :=
      slicedFamilies.membership.forward with hasTube
    obtain ⟨_, U2, hU2, hxU2, W, hW, boxInside⟩ :=
      boxSlices.membership.forward with hV
    have bound : G ∪ {V} ⊆ boxSlices(T, S, C, x)
      intros Z hZ
      cases (union2.membership.forward with hZ) with inG | isV
      . exact hG with Z, inG
      . rwa (singleton.membership.forward with isV)
    apply slicedFamilies.membership.backward
    refine ⟨(powerset.membership_iff.backward with bound), U1 ∩ U2,
      (IsTopology.intersection2 with topology, hU1, hU2),
      (intersection.membership.backward with ⟨hxU1, hxU2⟩), H1 ∪ {W}, ?_,
      (Finite.union with finiteH1, (Finite.singleton at W)), ?_⟩
    . intros Z hZ
      cases (union2.membership.forward with hZ) with inH | isW
      . exact hH1 with Z, inH
      . rwa (singleton.membership.forward with isW)
    . intros p hp
      obtain ⟨_, u, hu, y, hy, shape⟩ := product.membership.forward with hp
      have huParts := intersection.membership.forward with hu
      obtain ⟨Z, hZ, hyZ⟩ := union.membership.forward with hy
      rw shape
      cases (union2.membership.forward with hZ) with inG | isV
      . have inSlices : y ∈ ⋃(G) := union.contains with inG, hyZ
        have inBox := product.pair with huParts.left, inSlices
        obtain ⟨E, hE, hpE⟩ := union.membership.forward with
          (covered1 with (u, y), inBox)
        exact union.contains with (union2.left with hE), hpE
      . rw (singleton.membership.forward with isV) at hyZ
        have inBox := product.pair with huParts.right, hyZ
        have inW := boxInside with (u, y), inBox
        have member : W ∈ H1 ∪ {W} :=
          union2.right with (singleton.membership.backward with rfl)
        exact union.contains with member, inW
  have all := Finite.induction with base, step
  have member := all with F, inside, finite
  obtain ⟨_, rest⟩ := slicedFamilies.membership.forward with member
  exact rest

-- The opens U for which finitely many members of C cover U × B.
def coveredTubes (T C B : Set) : Set :=
  { U ∈ T | ∃ H, H ⊆ C ∧ Finite(H) ∧ U × B ⊆ ⋃(H) }

def coveredFamilies (T C B : Set) : Set :=
  { O ∈ 𝒫(coveredTubes(T, C, B)) |
    ∃ H, H ⊆ C ∧ Finite(H) ∧ ⋃(O) × B ⊆ ⋃(H) }

theorem coveredTubes.union (T C B O : Set)
  requires inside : O ⊆ coveredTubes(T, C, B)
  requires finite : Finite(O)
  shows ∃ H, H ⊆ C ∧ Finite(H) ∧ ⋃(O) × B ⊆ ⋃(H)
proof
  have base : ∅ ∈ coveredFamilies(T, C, B)
    apply coveredFamilies.membership.backward
    refine ⟨(powerset.membership_iff.backward with
      (empty.subset at coveredTubes(T, C, B))), ∅, (empty.subset at C),
      Finite.empty, ?_⟩
    intros p hp
    obtain ⟨bound, u, hu, y, hy, shape⟩ := product.membership.forward with hp
    rw union.empty at hu
    simp at hu
  have step : ∀ G ⊆ coveredTubes(T, C, B), Finite(G) →
      ∀ U ∈ coveredTubes(T, C, B), U ∉ G → G ∈ coveredFamilies(T, C, B) →
        G ∪ {U} ∈ coveredFamilies(T, C, B)
    intros G hG finiteG U hU fresh covered
    obtain ⟨_, H1, hH1, finiteH1, covered1⟩ :=
      coveredFamilies.membership.forward with covered
    obtain ⟨_, H2, hH2, finiteH2, covered2⟩ :=
      coveredTubes.membership.forward with hU
    have bound : G ∪ {U} ⊆ coveredTubes(T, C, B)
      intros Z hZ
      cases (union2.membership.forward with hZ) with inG | isU
      . exact hG with Z, inG
      . rwa (singleton.membership.forward with isU)
    apply coveredFamilies.membership.backward
    refine ⟨(powerset.membership_iff.backward with bound), H1 ∪ H2, ?_,
      (Finite.union with finiteH1, finiteH2), ?_⟩
    . intros Z hZ
      cases (union2.membership.forward with hZ) with inH1 | inH2
      . exact hH1 with Z, inH1
      . exact hH2 with Z, inH2
    . intros p hp
      obtain ⟨_, u, hu, y, hy, shape⟩ := product.membership.forward with hp
      obtain ⟨Z, hZ, huZ⟩ := union.membership.forward with hu
      rw shape
      cases (union2.membership.forward with hZ) with inG | isU
      . have inTubes : u ∈ ⋃(G) := union.contains with inG, huZ
        have inBox := product.pair with inTubes, hy
        obtain ⟨E, hE, hpE⟩ := union.membership.forward with
          (covered1 with (u, y), inBox)
        exact union.contains with (union2.left with hE), hpE
      . rw (singleton.membership.forward with isU) at huZ
        have inBox := product.pair with huZ, hy
        obtain ⟨E, hE, hpE⟩ := union.membership.forward with
          (covered2 with (u, y), inBox)
        exact union.contains with (union2.right with hE), hpE
  have all := Finite.induction with base, step
  have member := all with O, inside, finite
  obtain ⟨_, rest⟩ := coveredFamilies.membership.forward with member
  exact rest

-- The product of compact sets is compact.
theorem IsCompact.product (X T Y S A B : Set)
  requires topologyX : IsTopology(X, T)
  requires topologyY : IsTopology(Y, S)
  requires compactA : IsCompact(X, T, A)
  requires compactB : IsCompact(Y, S, B)
  shows IsCompact(X × Y, productTopology(X, T, Y, S), A × B)
proof
  have hA := compactA.left
  have hB := compactB.left
  constructor
  . exact product.monotone with hA, hB
  . intros C cover
    have tubesOpen : coveredTubes(T, C, B) ⊆ T
      intros U hU
      have parts := coveredTubes.membership.forward with hU
      exact parts.left
    have tubesCover : A ⊆ ⋃(coveredTubes(T, C, B))
      intros x hx
      have slicesCover := boxSlices.cover with topologyX, topologyY, cover, hx
      have slicesOpen : boxSlices(T, S, C, x) ⊆ S
        intros V hV
        have parts := boxSlices.membership.forward with hV
        exact parts.left
      obtain ⟨F, hF, finiteF, coveredB⟩ := compactB.right with
        boxSlices(T, S, C, x), ⟨slicesOpen, slicesCover⟩
      obtain ⟨U, hU, hxU, H, hH, finiteH, covered⟩ := boxSlices.tube with
        topologyX, (hA with x, hx), hF, finiteF
      have member : U ∈ coveredTubes(T, C, B)
        apply coveredTubes.membership.backward
        refine ⟨hU, H, hH, finiteH, ?_⟩
        intros p hp
        obtain ⟨_, u, hu, y, hy, shape⟩ := product.membership.forward with hp
        rw shape
        exact covered with (u, y), (product.pair with hu, (coveredB with y, hy))
      exact union.contains with member, hxU
    obtain ⟨O, hO, finiteO, coveredA⟩ := compactA.right with
      coveredTubes(T, C, B), ⟨tubesOpen, tubesCover⟩
    obtain ⟨H, hH, finiteH, covered⟩ := coveredTubes.union with hO, finiteO
    refine ⟨H, hH, finiteH, ?_⟩
    intros p hp
    obtain ⟨_, u, hu, y, hy, shape⟩ := product.membership.forward with hp
    rw shape
    exact covered with (u, y), (product.pair with (coveredA with u, hu), hy)
