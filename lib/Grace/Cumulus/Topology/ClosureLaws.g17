-- Authors: Grant Passmore

module Grace.Cumulus.Topology.ClosureLaws
import Space

-- Interior

theorem interiorIn.whole (X T : Set)
  requires topology : IsTopology(X, T)
  shows interiorIn(T, X) = X
proof
  exact interiorIn.of_open with (IsTopology.whole with topology)

theorem interiorIn.empty (X T : Set)
  requires topology : IsTopology(X, T)
  shows interiorIn(T, ∅) = ∅
proof
  exact interiorIn.of_open with (IsTopology.empty with topology)

theorem interiorIn.subset_whole (X T A : Set)
  requires topology : IsTopology(X, T)
  shows interiorIn(T, A) ⊆ X
proof
  have isOpen := interiorIn.open at X, T, A with topology
  exact IsTopology.subset with topology, isOpen

theorem interiorIn.membership (T A x : Set)
  shows x ∈ interiorIn(T, A) ↔ ∃ U ∈ T, x ∈ U ∧ U ⊆ A
proof
  constructor
  . intro hx
    unfold interiorIn at hx
    obtain ⟨U, hU, hxU⟩ := union.membership.forward with hx
    have parts := openSubsets.membership.forward with hU
    exact ⟨U, parts.left, hxU, parts.right⟩
  . intro h
    obtain ⟨U, hU, hxU, inside⟩ := h
    have below := interiorIn.greatest with hU, inside
    exact below with x, hxU

theorem interiorIn.subset_closure (X T A : Set)
  requires topology : IsTopology(X, T)
  requires hA : A ⊆ X
  shows interiorIn(T, A) ⊆ closure(X, T, A)
proof
  have below := interiorIn.subset at T, A
  have contains := Space.closure.contains with topology, hA
  exact Subset.transitive with below, contains

theorem interiorIn.union2_subset (X T A B : Set)
  requires topology : IsTopology(X, T)
  shows interiorIn(T, A) ∪ interiorIn(T, B) ⊆ interiorIn(T, A ∪ B)
proof
  apply union2.subset
  . exact interiorIn.monotone with topology, (union2.subset_left at A, B)
  . exact interiorIn.monotone with topology, (union2.subset_right at A, B)

-- Closure

theorem closure.empty (X T : Set)
  requires topology : IsTopology(X, T)
  shows closure(X, T, ∅) = ∅
proof
  exact closure.of_closed with topology, (IsClosed.empty with topology)

theorem closure.whole (X T : Set)
  requires topology : IsTopology(X, T)
  shows closure(X, T, X) = X
proof
  exact closure.of_closed with topology, (IsClosed.whole with topology)

theorem closure.intersection2_subset (X T A B : Set)
  requires topology : IsTopology(X, T)
  requires hA : A ⊆ X
  requires hB : B ⊆ X
  shows closure(X, T, A ∩ B) ⊆ closure(X, T, A) ∩ closure(X, T, B)
proof
  apply intersection.greatest
  . exact closure.monotone with topology, hA, (intersection.subset_left at A, B)
  . exact closure.monotone with topology, hB, (intersection.subset_right at A, B)

-- Duality: the closure of a complement is the complement of the interiorIn.
theorem closure.complement (X T A : Set)
  requires topology : IsTopology(X, T)
  requires hA : A ⊆ X
  shows closure(X, T, complement(X, A)) = complement(X, interiorIn(T, A))
proof
  have openInterior := interiorIn.open at X, T, A with topology
  have complementSubset := complement.subset at X, A
  apply Subset.antisymmetric
  . have closed := Open.complement_closed with topology, openInterior
    have inside := complement.antitone at X, interiorIn(T, A), A with (interiorIn.subset at T, A)
    exact closure.least with closed, inside
  . have closedClosure := closure.closed with topology, complementSubset
    have openPart := IsClosed.complement_open with closedClosure
    have contains := Space.closure.contains with topology, complementSubset
    have below := complement.antitone at X, complement(X, A), closure(X, T, complement(X, A)) with contains
    have double := complement.complement with hA
    rw double at below
    have inside := interiorIn.greatest with openPart, below
    have flipped := complement.antitone at X, complement(X, closure(X, T, complement(X, A))), interiorIn(T, A) with inside
    have closureInside := closure.subset with topology, complementSubset
    have doubleClosure := complement.complement with closureInside
    rwa doubleClosure at flipped

theorem interiorIn.complement (X T A : Set)
  requires topology : IsTopology(X, T)
  requires hA : A ⊆ X
  shows interiorIn(T, complement(X, A)) = complement(X, closure(X, T, A))
proof
  have complementSubset := complement.subset at X, A
  have duality := closure.complement with topology, complementSubset
  have double := complement.complement with hA
  rw double at duality
  have interiorInside := interiorIn.subset_whole at X, T, complement(X, A) with topology
  have doubleInterior := complement.complement with interiorInside
  rw [duality, doubleInterior]
  rfl

-- Boundary: the closure with the interior removed.

def boundary (X T A : Set) : Set := closure(X, T, A) ∖ interiorIn(T, A)

theorem boundary.membership (X T A x : Set)
  shows x ∈ boundary(X, T, A) ↔ x ∈ closure(X, T, A) ∧ ¬x ∈ interiorIn(T, A)
proof
  simp [boundary, difference.membership]

theorem boundary.subset_closure (X T A : Set)
  shows boundary(X, T, A) ⊆ closure(X, T, A)
proof
  unfold boundary
  exact difference.subset_left

theorem boundary.subset_whole (X T A : Set)
  requires topology : IsTopology(X, T)
  requires hA : A ⊆ X
  shows boundary(X, T, A) ⊆ X
proof
  have below := boundary.subset_closure at X, T, A
  have inside := closure.subset with topology, hA
  exact Subset.transitive with below, inside

theorem boundary.closed (X T A : Set)
  requires topology : IsTopology(X, T)
  requires hA : A ⊆ X
  shows IsClosed(X, T, boundary(X, T, A))
proof
  have closedClosure := closure.closed with topology, hA
  have openInterior := interiorIn.open at X, T, A with topology
  have closedComplement := Open.complement_closed with topology, openInterior
  have closureInside := closure.subset with topology, hA
  have same : boundary(X, T, A) = closure(X, T, A) ∩ complement(X, interiorIn(T, A))
    ext x
    constructor
    . intro hx
      have parts := boundary.membership.forward with hx
      have hxX := closureInside with x, parts.left
      apply intersection.membership.backward
      exact ⟨parts.left, (complement.membership.backward with ⟨hxX, parts.right⟩)⟩
    . intro hx
      have parts := intersection.membership.forward with hx
      have away := complement.membership.forward with parts.right
      exact boundary.membership.backward with ⟨parts.left, away.right⟩
  rw same
  exact IsClosed.intersection2 with topology, closedClosure, closedComplement

theorem boundary.complement (X T A : Set)
  requires topology : IsTopology(X, T)
  requires hA : A ⊆ X
  shows boundary(X, T, complement(X, A)) = boundary(X, T, A)
proof
  have closureInside := closure.subset with topology, hA
  have closureSwap := closure.complement with topology, hA
  have interiorSwap := interiorIn.complement with topology, hA
  unfold boundary
  ext x
  constructor
  . intro hx
    have parts := difference.membership.forward with hx
    have inComplement := complement.membership.forward with parts.left
    apply difference.membership.backward
    constructor
    . by_contra outside
      apply parts.right
      exact complement.membership.backward with ⟨inComplement.left, outside⟩
    . exact inComplement.right
  . intro hx
    have parts := difference.membership.forward with hx
    have hxX := closureInside with x, parts.left
    apply difference.membership.backward
    constructor
    . exact complement.membership.backward with ⟨hxX, parts.right⟩
    . intro away
      have awayParts := complement.membership.forward with away
      exact awayParts.right with parts.left

theorem IsClosed.iff_boundary_subset (X T A : Set)
  requires topology : IsTopology(X, T)
  requires hA : A ⊆ X
  shows IsClosed(X, T, A) ↔ boundary(X, T, A) ⊆ A
proof
  constructor
  . intro closed
    have same := closure.of_closed with topology, closed
    have below := boundary.subset_closure at X, T, A
    rwa same at below
  . intro inside
    apply IsClosed.iff_closure.backward with topology, hA
    have interiorBelow := interiorIn.subset at T, A
    apply Subset.antisymmetric
    . intros x hx
      have split : x ∈ interiorIn(T, A) ∨ ¬x ∈ interiorIn(T, A) by tauto
      cases split with inner | outer
      . exact interiorBelow with x, inner
      . have onBoundary := boundary.membership.backward at X, T, A, x with ⟨hx, outer⟩
        exact inside with x, onBoundary
    . exact Space.closure.contains with topology, hA

theorem Open.iff_boundary_disjoint (X T U : Set)
  requires topology : IsTopology(X, T)
  requires hU : U ⊆ X
  shows U ∈ T ↔ Disjoint(U, boundary(X, T, U))
proof
  constructor
  . intro isOpen
    have same := interiorIn.of_open with isOpen
    apply Disjoint.iff.backward
    intros x hx onBoundary
    have parts := boundary.membership.forward with onBoundary
    apply parts.right
    rwa same
  . intro disjoint
    have separated := Disjoint.iff.forward with disjoint
    have contains := Space.closure.contains with topology, hU
    apply Open.iff_interior.backward with topology
    apply Subset.antisymmetric
    . exact interiorIn.subset at T, U
    . intros x hx
      have inClosure := contains with x, hx
      by_contra outer
      apply separated with x, hx
      exact boundary.membership.backward with ⟨inClosure, outer⟩

theorem closure.union_boundary (X T A : Set)
  requires topology : IsTopology(X, T)
  requires hA : A ⊆ X
  shows closure(X, T, A) = A ∪ boundary(X, T, A)
proof
  have contains := Space.closure.contains with topology, hA
  have interiorBelow := interiorIn.subset at T, A
  apply Subset.antisymmetric
  . intros x hx
    apply union2.membership.backward
    have split : x ∈ interiorIn(T, A) ∨ ¬x ∈ interiorIn(T, A) by tauto
    cases split with inner | outer
    . left
      exact interiorBelow with x, inner
    . right
      exact boundary.membership.backward with ⟨hx, outer⟩
  . apply union2.subset
    . exact contains
    . exact boundary.subset_closure at X, T, A

theorem interiorIn.difference_boundary (X T A : Set)
  requires topology : IsTopology(X, T)
  requires hA : A ⊆ X
  shows interiorIn(T, A) = A ∖ boundary(X, T, A)
proof
  have contains := Space.closure.contains with topology, hA
  have interiorBelow := interiorIn.subset at T, A
  ext x
  constructor
  . intro hx
    apply difference.membership.backward
    constructor
    . exact interiorBelow with x, hx
    . intro onBoundary
      have parts := boundary.membership.forward with onBoundary
      exact parts.right with hx
  . intro hx
    have parts := difference.membership.forward with hx
    have inClosure := contains with x, parts.left
    by_contra outer
    apply parts.right
    exact boundary.membership.backward with ⟨inClosure, outer⟩

theorem boundary.whole (X T : Set)
  requires topology : IsTopology(X, T)
  shows boundary(X, T, X) = ∅
proof
  have closureWhole := closure.whole with topology
  have interiorWhole := interiorIn.whole with topology
  unfold boundary
  exact difference.self at X

theorem boundary.empty (X T : Set)
  requires topology : IsTopology(X, T)
  shows boundary(X, T, ∅) = ∅
proof
  have closureEmpty := closure.empty with topology
  have interiorEmpty := interiorIn.empty with topology
  unfold boundary
  exact difference.self at ∅

-- A set that is both open and closed has no boundary.
theorem boundary.empty_of_clopen (X T U : Set)
  requires topology : IsTopology(X, T)
  requires isOpen : U ∈ T
  requires closed : IsClosed(X, T, U)
  shows boundary(X, T, U) = ∅
proof
  have closureSame := closure.of_closed with topology, closed
  have interiorSame := interiorIn.of_open with isOpen
  unfold boundary
  exact difference.self at U

theorem boundary.boundary_subset (X T A : Set)
  requires topology : IsTopology(X, T)
  requires hA : A ⊆ X
  shows boundary(X, T, boundary(X, T, A)) ⊆ boundary(X, T, A)
proof
  have closed := boundary.closed with topology, hA
  have same := closure.of_closed with topology, closed
  have below := boundary.subset_closure at X, T, boundary(X, T, A)
  rwa same at below

-- Limit points: every open set around x meets A away from x.

def limitPoints (X T A : Set) : Set :=
  { x ∈ X | ∀ U ∈ T, x ∈ U → Nonempty(U ∩ (A ∖ {x})) }

theorem limitPoints.subset (X T A : Set)
  shows limitPoints(X, T, A) ⊆ X
proof
  intros x hx
  have parts := limitPoints.membership.forward with hx
  exact parts.left

theorem limitPoints.subset_closure (X T A : Set)
  requires topology : IsTopology(X, T)
  requires hA : A ⊆ X
  shows limitPoints(X, T, A) ⊆ closure(X, T, A)
proof
  intros x hx
  have parts := limitPoints.membership.forward with hx
  apply closure.membership.backward with topology, hA
  refine ⟨parts.left, ?_⟩
  intros U hU hxU
  obtain ⟨a, ha⟩ := parts.right with U, hU, hxU
  have inner := intersection.membership.forward with ha
  have away := difference.singleton_membership.forward with inner.right
  witness a
  exact intersection.membership.backward with ⟨inner.left, away.left⟩

theorem closure.union_limitPoints (X T A : Set)
  requires topology : IsTopology(X, T)
  requires hA : A ⊆ X
  shows closure(X, T, A) = A ∪ limitPoints(X, T, A)
proof
  apply Subset.antisymmetric
  . intros x hx
    have parts := closure.membership.forward with topology, hA, hx
    apply union2.membership.backward
    have split : x ∈ A ∨ ¬x ∈ A by tauto
    cases split with inA | outside
    . left
      exact inA
    . right
      apply limitPoints.membership.backward
      refine ⟨parts.left, ?_⟩
      intros U hU hxU
      obtain ⟨a, ha⟩ := parts.right with U, hU, hxU
      have inner := intersection.membership.forward with ha
      have distinct : a ≠ x
        intro same
        apply outside
        rw ← same
        exact inner.right
      witness a
      apply intersection.membership.backward
      refine ⟨inner.left, ?_⟩
      exact difference.singleton_membership.backward with ⟨inner.right, distinct⟩
  . apply union2.subset
    . exact Space.closure.contains with topology, hA
    . exact limitPoints.subset_closure with topology, hA

theorem IsClosed.iff_limitPoints_subset (X T A : Set)
  requires topology : IsTopology(X, T)
  requires hA : A ⊆ X
  shows IsClosed(X, T, A) ↔ limitPoints(X, T, A) ⊆ A
proof
  constructor
  . intro closed
    have same := closure.of_closed with topology, closed
    have below := limitPoints.subset_closure with topology, hA
    rwa same at below
  . intro inside
    apply IsClosed.iff_closure.backward with topology, hA
    have split := closure.union_limitPoints with topology, hA
    rw split
    apply Subset.antisymmetric
    . exact union2.subset with (Subset.reflexive at A), inside
    . exact union2.subset_left at A, limitPoints(X, T, A)

theorem limitPoints.monotone (X T A B : Set)
  requires hAB : A ⊆ B
  shows limitPoints(X, T, A) ⊆ limitPoints(X, T, B)
proof
  intros x hx
  have parts := limitPoints.membership.forward with hx
  apply limitPoints.membership.backward
  refine ⟨parts.left, ?_⟩
  intros U hU hxU
  obtain ⟨a, ha⟩ := parts.right with U, hU, hxU
  have inner := intersection.membership.forward with ha
  have away := difference.singleton_membership.forward with inner.right
  witness a
  apply intersection.membership.backward
  refine ⟨inner.left, ?_⟩
  exact difference.singleton_membership.backward with ⟨(hAB with a, away.left), away.right⟩

-- Isolated points: some open set around x meets A only in x.

predicate IsolatedPoint (X T A x : Set) :=
  x ∈ A ∧ ∃ U ∈ T, x ∈ U ∧ U ∩ A = {x}

theorem IsolatedPoint.not_limit (X T A x : Set)
  requires isolated : IsolatedPoint(X, T, A, x)
  shows ¬x ∈ limitPoints(X, T, A)
proof
  obtain ⟨hxA, U, hU, hxU, trace⟩ := isolated
  intro limit
  have parts := limitPoints.membership.forward with limit
  obtain ⟨a, ha⟩ := parts.right with U, hU, hxU
  have inner := intersection.membership.forward with ha
  have away := difference.singleton_membership.forward with inner.right
  have inTrace : a ∈ U ∩ A := intersection.membership.backward with ⟨inner.left, away.left⟩
  rw trace at inTrace
  have same := singleton.membership.forward with inTrace
  exact away.right with same

theorem IsolatedPoint.of_not_limit (X T A x : Set)
  requires topology : IsTopology(X, T)
  requires hA : A ⊆ X
  requires hxA : x ∈ A
  requires notLimit : ¬x ∈ limitPoints(X, T, A)
  shows IsolatedPoint(X, T, A, x)
proof
  have hxX := hA with x, hxA
  refine ⟨hxA, ?_⟩
  by_contra none
  apply notLimit
  apply limitPoints.membership.backward
  refine ⟨hxX, ?_⟩
  intros U hU hxU
  by_contra empty
  apply none
  refine ⟨U, hU, hxU, ?_⟩
  ext y
  constructor
  . intro hy
    have parts := intersection.membership.forward with hy
    apply singleton.membership.backward
    by_contra distinct
    apply empty
    witness y
    apply intersection.membership.backward
    refine ⟨parts.left, ?_⟩
    exact difference.singleton_membership.backward with ⟨parts.right, distinct⟩
  . intro hy
    have same := singleton.membership.forward with hy
    rw same
    exact intersection.membership.backward with ⟨hxU, hxA⟩

theorem IsolatedPoint.iff (X T A x : Set)
  requires topology : IsTopology(X, T)
  requires hA : A ⊆ X
  requires hxA : x ∈ A
  shows IsolatedPoint(X, T, A, x) ↔ ¬x ∈ limitPoints(X, T, A)
proof
  constructor
  . intro isolated
    exact IsolatedPoint.not_limit with isolated
  . intro notLimit
    exact IsolatedPoint.of_not_limit with topology, hA, hxA, notLimit

-- Dense sets

theorem IsDense.whole (X T : Set)
  requires topology : IsTopology(X, T)
  shows IsDense(X, T, X)
proof
  exact closure.whole with topology

theorem IsDense.iff_meets_open (X T A : Set)
  requires topology : IsTopology(X, T)
  requires hA : A ⊆ X
  shows IsDense(X, T, A) ↔ ∀ U ∈ T, Nonempty(U) → Nonempty(U ∩ A)
proof
  constructor
  . intros dense U hU inhabited
    have equal : closure(X, T, A) = X := dense
    obtain ⟨x, hx⟩ := inhabited
    have inside := IsTopology.subset with topology, hU
    have hxX := inside with x, hx
    have inClosure : x ∈ closure(X, T, A)
      rw equal
      exact hxX
    have parts := closure.membership.forward with topology, hA, inClosure
    exact parts.right with U, hU, hx
  . intro meets
    have inside := closure.subset with topology, hA
    have equal : closure(X, T, A) = X
      apply Subset.antisymmetric
      . exact inside
      . intros x hx
        apply closure.membership.backward with topology, hA
        refine ⟨hx, ?_⟩
        intros U hU hxU
        have inhabited : Nonempty(U) := ⟨x, hxU⟩
        exact meets with U, hU, inhabited
    exact equal

theorem IsDense.of_subset (X T A B : Set)
  requires topology : IsTopology(X, T)
  requires hB : B ⊆ X
  requires hAB : A ⊆ B
  requires dense : IsDense(X, T, A)
  shows IsDense(X, T, B)
proof
  have equal : closure(X, T, A) = X := dense
  have below := closure.monotone with topology, hB, hAB
  have inside := closure.subset with topology, hB
  rw equal at below
  exact Subset.antisymmetric with inside, below

theorem IsDense.meets (X T A U : Set)
  requires topology : IsTopology(X, T)
  requires hA : A ⊆ X
  requires dense : IsDense(X, T, A)
  requires hU : U ∈ T
  requires inhabited : Nonempty(U)
  shows Nonempty(U ∩ A)
proof
  have meets := IsDense.iff_meets_open.forward with topology, hA, dense
  exact meets with U, hU, inhabited

theorem IsDense.interior_complement (X T A : Set)
  requires topology : IsTopology(X, T)
  requires hA : A ⊆ X
  shows IsDense(X, T, A) ↔ interiorIn(T, complement(X, A)) = ∅
proof
  have swap := interiorIn.complement with topology, hA
  have inside := closure.subset with topology, hA
  rw swap
  constructor
  . intro dense
    have equal : closure(X, T, A) = X := dense
    rw equal
    exact complement.self at X
  . intro empty
    unfold complement at empty
    have below := difference.eq_empty_iff.forward with empty
    exact Subset.antisymmetric with inside, below
