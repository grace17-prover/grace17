-- Spaces built from spaces and the properties of a space: subspaces,
-- products, the real line and the plane as values; compactness, the
-- Hausdorff and T1 properties, connectedness, and their laws, with the
-- tube lemma, Heine–Borel, compact subsets of Hausdorff spaces, and the
-- uniqueness of limits in their textbook statements
-- Part of Cumulus, the Grace17 mathematics library.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module Grace.Cumulus.Topology.Spaces
import Continuous
import Plane

-- The subspace on a subset, the product of two spaces, the real line, and
-- the plane, each a constructed space whose projections are the carrier
-- and topology over separate pieces.
def subspace (X A : Set) : Set :=
  TopologicalSpace.mk(A, subspaceTopology(TopologicalSpace.opens(X), A))
def productSpace (X Y : Set) : Set :=
  TopologicalSpace.mk(
    TopologicalSpace.carrier(X) × TopologicalSpace.carrier(Y),
    productTopology(TopologicalSpace.carrier(X), TopologicalSpace.opens(X),
      TopologicalSpace.carrier(Y), TopologicalSpace.opens(Y)))
def realLine : Set := TopologicalSpace.mk(ℝ, realTopology)
def plane : Set := TopologicalSpace.mk(ℝ × ℝ, planeTopology)

theorem subspace.carrier (X A : Set)
  shows TopologicalSpace.carrier(subspace(X, A)) = A
proof
  unfold subspace
  topology_projections

theorem subspace.opens (X A : Set)
  shows TopologicalSpace.opens(subspace(X, A)) =
    subspaceTopology(TopologicalSpace.opens(X), A)
proof
  unfold subspace
  topology_projections

theorem productSpace.carrier (X Y : Set)
  shows TopologicalSpace.carrier(productSpace(X, Y)) =
    TopologicalSpace.carrier(X) × TopologicalSpace.carrier(Y)
proof
  unfold productSpace
  topology_projections

theorem productSpace.opens (X Y : Set)
  shows TopologicalSpace.opens(productSpace(X, Y)) =
    productTopology(TopologicalSpace.carrier(X), TopologicalSpace.opens(X),
      TopologicalSpace.carrier(Y), TopologicalSpace.opens(Y))
proof
  unfold productSpace
  topology_projections

theorem realLine.carrier
  shows TopologicalSpace.carrier(realLine) = ℝ
proof
  unfold realLine
  topology_projections

theorem realLine.opens
  shows TopologicalSpace.opens(realLine) = realTopology
proof
  unfold realLine
  topology_projections

theorem plane.carrier
  shows TopologicalSpace.carrier(plane) = ℝ × ℝ
proof
  unfold plane
  topology_projections

theorem plane.opens
  shows TopologicalSpace.opens(plane) = planeTopology
proof
  unfold plane
  topology_projections

-- Each construction is a space; these are instances, so the hypothesis on
-- a constructed space is synthesized from those on its pieces.
instance subspace.space (X A : Set)
  requires space : TopologicalSpace(X)
  requires hA : A ⊆ X
  shows TopologicalSpace(subspace(X, A))
proof
  have parts := TopologicalSpace.parts with space
  have topology := subspaceTopology.topology with parts, hA
  unfold subspace
  exact TopologicalSpace.of_parts with topology

instance productSpace.space (X Y : Set)
  requires spaceX : TopologicalSpace(X)
  requires spaceY : TopologicalSpace(Y)
  shows TopologicalSpace(productSpace(X, Y))
proof
  have partsX := TopologicalSpace.parts with spaceX
  have partsY := TopologicalSpace.parts with spaceY
  have topology := productTopology.topology with partsX, partsY
  unfold productSpace
  exact TopologicalSpace.of_parts with topology

instance realLine.space
  shows TopologicalSpace(realLine)
proof
  unfold realLine
  exact TopologicalSpace.of_parts with realTopology.topology

instance plane.space
  shows TopologicalSpace(plane)
proof
  unfold plane
  exact TopologicalSpace.of_parts with planeTopology.topology

theorem plane.eq_product
  shows plane = productSpace(realLine, realLine)
proof
  unfold plane
  unfold productSpace
  unfold planeTopology
  rw [realLine.carrier, realLine.opens]
  rfl

section CompactLaws
variable (X : Set)
hypothesis space : TopologicalSpace(X)

theorem Compact.subset_carrier (A : Set)
  requires compact : Compact(X, A)
  shows A ⊆ X
proof
  have pieces := Compact.parts with compact
  exact Compact.IsCompact.subset with pieces

instance Compact.empty_set
  shows Compact(X, ∅)
proof
  exact Compact.of_parts with (Compact.IsCompact.empty at X.carrier, X.opens)

instance Compact.point (x : X)
  shows Compact(X, {x})
proof
  have xIn : x ∈ X by assumption
  have point := Compact.IsCompact.singleton at X.carrier, X.opens, x with xIn
  exact Compact.of_parts with point

instance Compact.union (A B : Set)
  requires compactA : Compact(X, A)
  requires compactB : Compact(X, B)
  shows Compact(X, A ∪ B)
proof
  have piecesA := Compact.parts with compactA
  have piecesB := Compact.parts with compactB
  exact Compact.of_parts with (Compact.IsCompact.union2 with piecesA, piecesB)

theorem Compact.of_finite (A : Set)
  requires finite : Finite(A)
  requires hA : A ⊆ X
  shows Compact(X, A)
proof
  have engine := CompactMore.IsCompact.finite at X.carrier, X.opens, A with *
  exact Compact.of_parts with engine

-- A closed subset of a compact set is compact.
theorem Compact.of_closed_subset (A C : Set)
  requires compact : Compact(X, A)
  requires closed : Closed(X, C)
  requires hCA : C ⊆ A
  shows Compact(X, C)
proof
  have parts := TopologicalSpace.parts with space
  have piecesA := Compact.parts with compact
  have piecesC := Closed.parts with closed
  have engine := Compact.IsCompact.closed_subset with parts, piecesA, piecesC,
    hCA
  exact Compact.of_parts with engine

theorem Compact.space_iff
  shows Compact(X) ↔ Compact(X, X.carrier)
proof
  constructor
  . intro compact
    exact Compact.of_parts with (Compact.space_parts with compact)
  . intro compact
    exact Compact.of_space_parts with (Compact.parts with compact)

theorem Compact.space_of_finite
  requires finite : Finite(X.carrier)
  shows Compact(X)
proof
  apply Compact.of_space_parts
  exact IsCompact.whole_of_finite at X.carrier, X.opens with finite

end CompactLaws

section HausdorffLaws
variable (X : Set)
hypothesis space : TopologicalSpace(X)
hypothesis hausdorff : Hausdorff(X)

-- Distinct points have disjoint open neighborhoods.
theorem Hausdorff.separate (x y : X)
  requires distinct : x ≠ y
  shows ∃ U ∈ X.opens, ∃ V ∈ X.opens,
    x ∈ U ∧ y ∈ V ∧ Disjoint(U, V)
proof
  have parts := Hausdorff.parts with hausdorff
  have xIn : x ∈ X by assumption
  have yIn : y ∈ X by assumption
  exact parts with x, xIn, y, yIn, distinct

instance Hausdorff.point_closed (x : X)
  shows Closed(X, {x})
proof
  have parts := TopologicalSpace.parts with space
  have pieces := Hausdorff.parts with hausdorff
  have xIn : x ∈ X by assumption
  have engine := Subspace.IsHausdorff.singleton_closed with parts, pieces, xIn
  exact Closed.of_parts with engine

theorem Hausdorff.t1_space
  shows T1Space(X)
proof
  have pieces := Hausdorff.parts with hausdorff
  apply T1Space.of_parts
  exact Separation.IsHausdorff.t1 with pieces

-- A compact subset of a Hausdorff space is closed.
theorem Compact.closed_of_hausdorff (K : Set)
  requires compact : Compact(X, K)
  shows Closed(X, K)
proof
  have parts := TopologicalSpace.parts with space
  have pieces := Hausdorff.parts with hausdorff
  have compactK := Compact.parts with compact
  have engine := IsCompact.hausdorff_closed with parts, pieces, compactK
  exact Closed.of_parts with engine

-- In a compact Hausdorff space the compact subsets are the closed ones.
theorem Compact.iff_closed (K : Set)
  requires compact : Compact(X)
  shows Compact(X, K) ↔ Closed(X, K)
proof
  constructor
  . intro compactK
    exact Compact.closed_of_hausdorff with *
  . intro closed
    have whole := Compact.of_parts with (Compact.space_parts with compact)
    have inside := Closed.subset with closed
    exact Compact.of_closed_subset with whole, closed, inside

-- A sequence has at most one limit.
theorem Converges.unique (u : Set) (x y : X)
  requires first : u ⇝ x
  requires second : u ⇝ y
  shows x = y
proof
  by_contra distinct
  obtain ⟨U, hU, V, hV, hxU, hyV, disjoint⟩ := Hausdorff.separate with *
  have separated := Disjoint.iff.forward with disjoint
  have openU := Open.of_mem with hU
  have openV := Open.of_mem with hV
  obtain ⟨N, hN, tailU⟩ := Converges.eventually with first, openU, hxU
  obtain ⟨M, hM, tailV⟩ := Converges.eventually with second, openV, hyV
  have order := LessEqual.total at N, M
  cases order with below | above
  . have inU := tailU with M, hM, below
    have inV := tailV with M, hM, (LessEqual.reflexive at M)
    exact separated with u(M), inU, inV
  . have inU := tailU with N, hN, (LessEqual.reflexive at N)
    have inV := tailV with N, hN, above
    exact separated with u(N), inU, inV

end HausdorffLaws

section ConnectedLaws
variable (X : Set)
hypothesis space : TopologicalSpace(X)

theorem Connected.clopen_trivial (U : Set)
  requires connected : Connected(X)
  requires open : Open(X, U)
  requires closed : Closed(X, U)
  shows U = ∅ ∨ U = X.carrier
proof
  have parts := TopologicalSpace.parts with space
  have pieces := Connected.parts with connected
  have member := Open.mem with open
  have closedU := Closed.parts with closed
  exact Connected.IsConnected.clopen with parts, pieces, member, closedU

theorem Connected.iff_clopen_trivial
  shows Connected(X) ↔
    ∀ U, Open(X, U) → Closed(X, U) → U = ∅ ∨ U = X.carrier
proof
  have parts := TopologicalSpace.parts with space
  have characterization := Connected.IsConnected.iff_clopen with parts
  constructor
  . intros connected U open closed
    exact Connected.clopen_trivial with *
  . intro trivial
    have pieces : ∀ U ∈ X.opens, IsClosed(X.carrier, X.opens, U) →
        U = ∅ ∨ U = X.carrier
      intros U hU closedU
      have openU := Open.of_mem with hU
      have closedB := Closed.of_parts with closedU
      exact trivial with U, openU, closedB
    exact Connected.of_parts with (characterization.backward with pieces)

theorem ConnectedSubset.subset_carrier (A : Set)
  requires connected : ConnectedSubset(X, A)
  shows A ⊆ X
proof
  have pieces := ConnectedSubset.parts with connected
  exact Connected.IsConnectedSubset.subset with pieces

-- A subset is connected exactly when it is connected as a subspace.
theorem ConnectedSubset.iff_subspace_connected (A : Set)
  requires hA : A ⊆ X
  shows ConnectedSubset(X, A) ↔ Connected(subspace(X, A))
proof
  have parts := TopologicalSpace.parts with space
  have characterization := Connected.IsConnectedSubset.iff_subspace with parts,
    hA
  constructor
  . intro connected
    have pieces := ConnectedSubset.parts with connected
    unfold subspace
    exact Connected.of_mk with (characterization.forward with pieces)
  . intro connected
    have pieces := Connected.parts with connected
    rw [subspace.carrier, subspace.opens] at pieces
    exact ConnectedSubset.of_parts with (characterization.backward with pieces)

end ConnectedLaws

-- The continuous image of a connected space is connected.
theorem Connected.continuous_image (f X Y : Set)
  requires continuous : f : X ⇒ Y
  requires connected : Connected(X)
  shows ConnectedSubset(Y, functionImage(f, X.carrier, Y.carrier))
proof
  have parts := TopologicalSpace.parts with (Continuous.source with continuous)
  have engine := Continuous.parts with continuous
  have pieces := Connected.parts with connected
  have target := Continuous.target with continuous
  have image := Connected.IsConnected.image with parts, engine, pieces
  exact ConnectedSubset.of_parts with target, image

theorem ConnectedSubset.continuous_image (f X Y A : Set)
  requires continuous : f : X ⇒ Y
  requires connected : ConnectedSubset(X, A)
  shows ConnectedSubset(Y, functionImage(f, A, Y.carrier))
proof
  have engine := Continuous.parts with continuous
  have pieces := ConnectedSubset.parts with connected
  have target := Continuous.target with continuous
  have image := Connected.IsConnectedSubset.image with engine, pieces
  exact ConnectedSubset.of_parts with target, image

-- Subspaces: the inclusion and restrictions are continuous, and the
-- Hausdorff and T1 properties pass to subspaces.
theorem Continuous.inclusion (X A : Set)
  requires space : TopologicalSpace(X)
  requires hA : A ⊆ X
  shows inclusionMap(A, X.carrier) : subspace(X, A) ⇒ X
proof
  have parts := TopologicalSpace.parts with space
  have engine := ContinuousMap.inclusion with parts, hA
  have spaceA : TopologicalSpace(subspace(X, A)) := subspace.space with *
  have shifted : ContinuousMap(inclusionMap(A, X.carrier),
      TopologicalSpace.carrier(subspace(X, A)),
      TopologicalSpace.opens(subspace(X, A)), X.carrier, X.opens)
    rw [subspace.carrier, subspace.opens]
    exact engine
  exact Continuous.of_projections with spaceA, space, shifted

theorem Continuous.restrict (f X Y A : Set)
  requires continuous : f : X ⇒ Y
  requires hA : A ⊆ X
  shows restrict(f, A) : subspace(X, A) ⇒ Y
proof
  have spaceX := Continuous.source with continuous
  have spaceY := Continuous.target with continuous
  have engine := Continuous.parts with continuous
  have restricted := ContinuousMap.restrict with engine, hA
  have spaceA : TopologicalSpace(subspace(X, A)) := subspace.space with *
  have shifted : ContinuousMap(restrict(f, A),
      TopologicalSpace.carrier(subspace(X, A)),
      TopologicalSpace.opens(subspace(X, A)), Y.carrier, Y.opens)
    rw [subspace.carrier, subspace.opens]
    exact restricted
  exact Continuous.of_projections with spaceA, spaceY, shifted

instance Hausdorff.subspace_of (X A : Set)
  requires space : TopologicalSpace(X)
  requires hausdorff : Hausdorff(X)
  requires hA : A ⊆ X
  shows Hausdorff(subspace(X, A))
proof
  have pieces := Hausdorff.parts with hausdorff
  unfold subspace
  exact Hausdorff.of_mk with (Separation.IsHausdorff.subspace with pieces, hA)

theorem T1Space.subspace_of (X A : Set)
  requires space : TopologicalSpace(X)
  requires t1 : T1Space(X)
  requires hA : A ⊆ X
  shows T1Space(subspace(X, A))
proof
  have pieces := T1Space.parts with t1
  unfold subspace
  exact T1Space.of_mk with (Separation.IsT1Space.subspace with pieces, hA)

-- Products: boxes are open, the projections are continuous, the product
-- of Hausdorff spaces is Hausdorff, and the product of compact sets is
-- compact (the tube lemma).
theorem Open.box (X Y U V : Set)
  requires spaceX : TopologicalSpace(X)
  requires spaceY : TopologicalSpace(Y)
  requires openU : Open(X, U)
  requires openV : Open(Y, V)
  shows Open(productSpace(X, Y), U × V)
proof
  have partsX := TopologicalSpace.parts with spaceX
  have partsY := TopologicalSpace.parts with spaceY
  have memberU := Open.mem with openU
  have memberV := Open.mem with openV
  have box := productTopology.box with partsX, partsY, memberU, memberV
  unfold productSpace
  exact Open.of_mk with (productTopology.topology with partsX, partsY), box

theorem Continuous.fst (X Y : Set)
  requires spaceX : TopologicalSpace(X)
  requires spaceY : TopologicalSpace(Y)
  shows firstProjection(X.carrier, Y.carrier) : productSpace(X, Y) ⇒ X
proof
  have partsX := TopologicalSpace.parts with spaceX
  have partsY := TopologicalSpace.parts with spaceY
  have engine := Product.firstProjection.continuous with partsX, partsY
  have spaceP := productSpace.space with spaceX, spaceY
  have shifted : ContinuousMap(firstProjection(X.carrier, Y.carrier),
      TopologicalSpace.carrier(productSpace(X, Y)),
      TopologicalSpace.opens(productSpace(X, Y)), X.carrier, X.opens)
    rw [productSpace.carrier, productSpace.opens]
    exact engine
  exact Continuous.of_projections with spaceP, spaceX, shifted

theorem Continuous.snd (X Y : Set)
  requires spaceX : TopologicalSpace(X)
  requires spaceY : TopologicalSpace(Y)
  shows secondProjection(X.carrier, Y.carrier) : productSpace(X, Y) ⇒ Y
proof
  have partsX := TopologicalSpace.parts with spaceX
  have partsY := TopologicalSpace.parts with spaceY
  have engine := Product.secondProjection.continuous with partsX, partsY
  have spaceP := productSpace.space with spaceX, spaceY
  have shifted : ContinuousMap(secondProjection(X.carrier, Y.carrier),
      TopologicalSpace.carrier(productSpace(X, Y)),
      TopologicalSpace.opens(productSpace(X, Y)), Y.carrier, Y.opens)
    rw [productSpace.carrier, productSpace.opens]
    exact engine
  exact Continuous.of_projections with spaceP, spaceY, shifted

instance Hausdorff.prod (X Y : Set)
  requires spaceX : TopologicalSpace(X)
  requires spaceY : TopologicalSpace(Y)
  requires hausdorffX : Hausdorff(X)
  requires hausdorffY : Hausdorff(Y)
  shows Hausdorff(productSpace(X, Y))
proof
  have partsX := TopologicalSpace.parts with spaceX
  have partsY := TopologicalSpace.parts with spaceY
  have piecesX := Hausdorff.parts with hausdorffX
  have piecesY := Hausdorff.parts with hausdorffY
  unfold productSpace
  have product := Separation.IsHausdorff.product with partsX, partsY, piecesX, piecesY
  exact Hausdorff.of_mk with product

theorem Compact.prod (X Y A B : Set)
  requires spaceX : TopologicalSpace(X)
  requires spaceY : TopologicalSpace(Y)
  requires compactA : Compact(X, A)
  requires compactB : Compact(Y, B)
  shows Compact(productSpace(X, Y), A × B)
proof
  have partsX := TopologicalSpace.parts with spaceX
  have partsY := TopologicalSpace.parts with spaceY
  have piecesA := Compact.parts with compactA
  have piecesB := Compact.parts with compactB
  have product := Tube.IsCompact.product with partsX, partsY, piecesA, piecesB
  unfold productSpace
  have topology := productTopology.topology with partsX, partsY
  exact Compact.of_mk with topology, product

-- The real line: Hausdorff, with closed intervals closed and compact
-- (Heine–Borel), closed rectangles compact in the plane, and ε–δ
-- continuity the continuity of the line into itself.
instance realLine.hausdorff
  shows Hausdorff(realLine)
proof
  unfold realLine
  exact Hausdorff.of_mk with realTopology.hausdorff

instance Closed.interval (A B : Real)
  shows Closed(realLine, closedInterval(A, B))
proof
  unfold realLine
  exact Closed.of_mk with realTopology.topology, (closedInterval.closed at A, B)

theorem Compact.interval (A B : Real)
  requires ordered : A ≤ B
  shows Compact(realLine, closedInterval(A, B))
proof
  unfold realLine
  have compact := closedInterval.compact with ordered
  exact Compact.of_mk with realTopology.topology, compact

theorem Compact.rectangle (A B C D : Real)
  requires orderedX : A ≤ B
  requires orderedY : C ≤ D
  shows Compact(plane, closedInterval(A, B) × closedInterval(C, D))
proof
  unfold plane
  have compact := closedRectangle.compact with orderedX, orderedY
  exact Compact.of_mk with planeTopology.topology, compact

theorem Continuous.iff_real_line (f : Set)
  shows Continuous(f) ↔ f : realLine ⇒ realLine
proof
  have characterization := Continuous.continuous_map at f
  constructor
  . intro continuous
    have engine := characterization.forward with continuous
    unfold realLine
    have topology := realTopology.topology
    exact Continuous.of_parts with *
  . intro continuous
    have engine := Continuous.parts with continuous
    rw [realLine.carrier, realLine.opens] at engine
    exact characterization.backward with engine
