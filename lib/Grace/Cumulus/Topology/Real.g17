-- The standard topology on the real line: a set is open when every point
-- has an open ball inside it. Open balls and open intervals are open,
-- closed intervals are closed, the line is Hausdorff, and ε–δ continuity is topological
-- continuity
-- Part of Cumulus, the Grace17 mathematics library.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module Grace.Cumulus.Topology.Real
import Subspace
import Real.Analysis.OpenIntervals

def realTopology : Set :=
  { U ∈ 𝒫(ℝ) | ∀ x ∈ U, ∃ E ∈ ℝ, 0 < E ∧ openBall(x, E) ⊆ U }

theorem openBall.subset_reals (C E : Real)
  shows openBall(C, E) ⊆ ℝ
proof
  intros x hx
  have parts := openBall.membership.forward with hx
  exact parts.left

theorem openBall.open (C E : Real)
  shows openBall(C, E) ∈ realTopology
proof
  apply realTopology.membership.backward
  refine ⟨(powerset.membership_iff.backward with (openBall.subset_reals at C, E)), ?_⟩
  intros x hx
  obtain ⟨realX, near⟩ := openBall.membership.forward with hx
  have radiusReal : E - dist(x, C) ∈ ℝ by typecheck
  have positive : (0:R) < E - dist(x, C) by linarith
  refine ⟨E - dist(x, C), radiusReal, positive, ?_⟩
  intros y hy
  obtain ⟨realY, nearY⟩ := openBall.membership.forward with hy
  apply openBall.membership.backward
  refine ⟨realY, ?_⟩
  have triangle := dist.triangle at y, x, C
  linarith

theorem realTopology.topology
  shows IsTopology(ℝ, realTopology)
proof
  constructor
  . intros U hU
    have parts := realTopology.membership.forward with hU
    exact parts.left
  . constructor
    . apply realTopology.membership.backward
      refine ⟨(powerset.self at ℝ), ?_⟩
      intros x hx
      have one : (1:R) ∈ ℝ by typecheck
      have positive : (0:R) < 1 by linarith
      refine ⟨(1:R), one, positive, (openBall.subset_reals at x, (1:R))⟩
    . constructor
      . intros S hS
        apply realTopology.membership.backward
        constructor
        . apply powerset.membership_iff.backward
          apply union.subset
          intros U hU
          have parts := realTopology.membership.forward with (hS with U, hU)
          exact powerset.membership_iff.forward with parts.left
        . intros x hx
          obtain ⟨U, hU, hxU⟩ := union.membership.forward with hx
          have parts := realTopology.membership.forward with (hS with U, hU)
          obtain ⟨E, hE, positive, inside⟩ := parts.right with x, hxU
          refine ⟨E, hE, positive, ?_⟩
          exact Subset.transitive with inside, (union.subset_of_member with hU)
      . intros U hU V hV
        have partsU := realTopology.membership.forward with hU
        have partsV := realTopology.membership.forward with hV
        have insideU := powerset.membership_iff.forward with partsU.left
        apply realTopology.membership.backward
        constructor
        . apply powerset.membership_iff.backward
          exact Subset.transitive with (intersection.subset_left at U, V), insideU
        . intros x hx
          have both := intersection.membership.forward with hx
          have realX := insideU with x, both.left
          obtain ⟨E1, hE1, positive1, inside1⟩ := partsU.right with x, both.left
          obtain ⟨E2, hE2, positive2, inside2⟩ := partsV.right with x, both.right
          have order := realLess.trichotomy at E1, E2
          cases order with smaller | rest
          . have le := realLess.implies_le with smaller
            refine ⟨E1, hE1, positive1, ?_⟩
            apply intersection.greatest
            . exact inside1
            . have ballMono : openBall(x, E1) ⊆ openBall(x, E2)
                intros w hw
                have ballInside := openBall.subset_reals at x, E1
                have realY := ballInside with w, hw
                exact openBall.mono with hw, le
              exact Subset.transitive with ballMono, inside2
          . cases rest with equal | larger
            . refine ⟨E1, hE1, positive1, ?_⟩
              apply intersection.greatest
              . exact inside1
              . rw equal
                exact inside2
            . have le := realLess.implies_le with larger
              refine ⟨E2, hE2, positive2, ?_⟩
              apply intersection.greatest
              . have ballMono : openBall(x, E2) ⊆ openBall(x, E1)
                  intros w hw
                  have ballInside := openBall.subset_reals at x, E2
                  have realY := ballInside with w, hw
                  exact openBall.mono with hw, le
                exact Subset.transitive with ballMono, inside1
              . exact inside2

theorem realTopology.hausdorff
  shows IsHausdorff(ℝ, realTopology)
proof
  intros x hx y hy distinct
  have positive := dist.positive_of_ne with distinct
  have halfPositive := half.positive with positive
  refine ⟨openBall(x, half(dist(x, y))), (openBall.open at x, half(dist(x, y))), openBall(y, half(dist(x, y))), (openBall.open at y, half(dist(x, y))), (openBall.center with halfPositive), ?_, ?_⟩
  . exact openBall.center with halfPositive
  . apply Disjoint.iff.backward
    intros z hz hz2
    have ballInside := openBall.subset_reals at x, half(dist(x, y))
    have realZ := ballInside with z, hz
    have same := openBall.half_radius_unique with hz, hz2
    exact distinct with same

-- Closed intervals are closed: a point outside has a ball that stays
-- outside.
theorem closedInterval.closed (A B : Real)
  shows IsClosed(ℝ, realTopology, closedInterval(A, B))
proof
  constructor
  . exact closedInterval.subset_reals at A, B
  . apply realTopology.membership.backward
    constructor
    . exact powerset.membership_iff.backward with (complement.subset at ℝ, closedInterval(A, B))
    . intros x hx
      have parts := complement.membership.forward with hx
      have realX := parts.left
      have outside : x < A ∨ B < x
        have orderA := realLess.trichotomy at x, A
        cases orderA with belowA | restA
        . left
          exact belowA
        . right
          have aboveA : A ≤ x
            cases restA with equalA | aboveA
            . rw equalA
              exact realLe.reflexive
            . exact realLess.implies_le with aboveA
          have orderB := realLess.trichotomy at x, B
          cases orderB with belowB | restB
          . exfalso
            apply parts.right
            apply closedInterval.membership.backward
            exact ⟨realX, aboveA, (realLess.implies_le with belowB)⟩
          . cases restB with equalB | aboveB
            . exfalso
              apply parts.right
              apply closedInterval.membership.backward
              have le : x ≤ B
                rw equalB
                exact realLe.reflexive
              exact ⟨realX, aboveA, le⟩
            . exact aboveB
      cases outside with belowA | aboveB
      . have radiusReal : A - x ∈ ℝ by typecheck
        have positive : (0:R) < A - x by linarith
        refine ⟨A - x, radiusReal, positive, ?_⟩
        intros y hy
        obtain ⟨realY, near⟩ := openBall.membership.forward with hy
        unfold dist at near
        have upper := abs.upper at y - x
        apply complement.membership.backward
        refine ⟨realY, ?_⟩
        intro member
        obtain ⟨realY2, lower, upperY⟩ := closedInterval.membership.forward with member
        linarith
      . have radiusReal : x - B ∈ ℝ by typecheck
        have positive : (0:R) < x - B by linarith
        refine ⟨x - B, radiusReal, positive, ?_⟩
        intros y hy
        obtain ⟨realY, near⟩ := openBall.membership.forward with hy
        unfold dist at near
        have upper := abs.upper_neg at y - x
        apply complement.membership.backward
        refine ⟨realY, ?_⟩
        intro member
        obtain ⟨realY2, lower, upperY⟩ := closedInterval.membership.forward with member
        linarith

-- Open intervals are open.
theorem openInterval.open (A B : Real)
  shows openInterval(A, B) ∈ realTopology
proof
  apply realTopology.membership.backward
  have inside := openInterval.subset_reals at A, B
  refine ⟨(powerset.membership_iff.backward with inside), ?_⟩
  intros x hx
  obtain ⟨realX, lower, upper⟩ := openInterval.membership.forward with hx
  have leftReal : x - A ∈ ℝ by typecheck
  have rightReal : B - x ∈ ℝ by typecheck
  have split : x - A ≤ B - x ∨ ¬(x - A ≤ B - x) by tauto
  cases split with leftSmaller | rightSmaller
  . have positive : (0:R) < x - A by linarith
    refine ⟨x - A, leftReal, positive, ?_⟩
    apply openInterval.ball_subset
    . linarith
    . linarith
  . have order := realLess.of_not_le with rightSmaller
    have positive : (0:R) < B - x by linarith
    refine ⟨B - x, rightReal, positive, ?_⟩
    apply openInterval.ball_subset
    . linarith
    . linarith

-- ε–δ continuity on the line is continuity for the standard topology.
theorem Continuous.continuous_map (f : Set)
  shows Continuous(f) ↔ ContinuousMap(f, ℝ, realTopology, ℝ, realTopology)
proof
  constructor
  . intro continuous
    obtain ⟨function, pointwise⟩ := continuous
    constructor
    . exact function
    . intros V hV
      have partsV := realTopology.membership.forward with hV
      apply realTopology.membership.backward
      constructor
      . exact powerset.membership_iff.backward with (functionPreimage.subset at f, ℝ, V)
      . intros x hx
        have inPreimage := functionPreimage.membership.forward with hx
        obtain ⟨E, hE, positive, ballInside⟩ := partsV.right with f(x), inPreimage.right
        obtain ⟨function2, control⟩ := pointwise with x, inPreimage.left
        obtain ⟨D, hD, positiveD, maps⟩ := control with E, hE, positive
        refine ⟨D, hD, positiveD, ?_⟩
        intros y hy
        have ballInsideD := openBall.subset_reals at x, D
        have realY := ballInsideD with y, hy
        apply functionPreimage.membership.backward
        refine ⟨realY, ?_⟩
        exact ballInside with f(y), (maps with y, realY, hy)
  . intro continuousMap
    obtain ⟨function, preimages⟩ := continuousMap
    constructor
    . exact function
    . intros a ha
      constructor
      . exact function
      . intros E hE positive
        have ballOpen := openBall.open at f(a), E
        have preimageOpen := preimages with openBall(f(a), E), ballOpen
        have parts := realTopology.membership.forward with preimageOpen
        have center := openBall.center at f(a), E with positive
        have inPreimage : a ∈ functionPreimage(f, ℝ, openBall(f(a), E)) := functionPreimage.membership.backward with ⟨ha, center⟩
        obtain ⟨D, hD, positiveD, inside⟩ := parts.right with a, inPreimage
        refine ⟨D, hD, positiveD, ?_⟩
        intros x hx near
        have member := inside with x, near
        have parts2 := functionPreimage.membership.forward with member
        exact parts2.right
