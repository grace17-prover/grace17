module Grace.Cumulus.Topology.Plane
import Tube
import HeineBorel

def planeTopology : Set := productTopology(ℝ, realTopology, ℝ, realTopology)

theorem planeTopology.topology
  shows IsTopology(ℝ × ℝ, planeTopology)
proof
  unfold planeTopology
  exact productTopology.topology with realTopology.topology, realTopology.topology

theorem closedRectangle.compact (A B C D : Real)
  requires orderedX : A ≤ B
  requires orderedY : C ≤ D
  shows IsCompact(ℝ × ℝ, planeTopology, closedInterval(A, B) × closedInterval(C, D))
proof
  have compactX := closedInterval.compact with orderedX
  have compactY := closedInterval.compact with orderedY
  unfold planeTopology
  exact IsCompact.product with realTopology.topology, realTopology.topology, compactX, compactY
