-- Derived sets: the limit points of a set, their closure laws, and the
-- isolated points as the difference between a set and its derived set
-- Part of Cumulus, the Grace17 mathematics library.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module Grace.Cumulus.Topology.CantorBendixson.Derived
import Topology.Separation

-- The derived set of A is its set of limit points.
def derivedSet (X T A : Set) : Set := limitPoints(X, T, A)

theorem derivedSet.membership (X T A x : Set)
  shows x ∈ derivedSet(X, T, A) ↔
    x ∈ X ∧ (∀ U ∈ T, x ∈ U → Nonempty(U ∩ (A ∖ {x})))
proof
  simp [derivedSet, limitPoints.membership]

theorem derivedSet.limit_iff (X T A x : Set)
  shows x ∈ derivedSet(X, T, A) ↔ x ∈ limitPoints(X, T, A)
proof
  simp [derivedSet]

theorem derivedSet.subset_whole (X T A : Set)
  shows derivedSet(X, T, A) ⊆ X
proof
  unfold derivedSet
  exact limitPoints.subset at X, T, A

theorem derivedSet.subset_closure (X T A : Set)
  requires topology : IsTopology(X, T)
  requires hA : A ⊆ X
  shows derivedSet(X, T, A) ⊆ closure(X, T, A)
proof
  unfold derivedSet
  exact limitPoints.subset_closure with topology, hA

theorem derivedSet.subset (X T A : Set)
  requires topology : IsTopology(X, T)
  requires closed : IsClosed(X, T, A)
  shows derivedSet(X, T, A) ⊆ A
proof
  have inside := closed.left
  unfold derivedSet
  exact IsClosed.iff_limitPoints_subset.forward with topology, inside, closed

theorem derivedSet.monotone (X T A B : Set)
  requires hAB : A ⊆ B
  shows derivedSet(X, T, A) ⊆ derivedSet(X, T, B)
proof
  unfold derivedSet
  unfold derivedSet
  exact limitPoints.monotone at X, T with hAB

-- The derived set of a closed set is closed: it lies inside the set, so
-- by monotonicity its own derived set lies inside it.
theorem derivedSet.closed (X T A : Set)
  requires topology : IsTopology(X, T)
  requires closed : IsClosed(X, T, A)
  shows IsClosed(X, T, derivedSet(X, T, A))
proof
  have inside := derivedSet.subset with topology, closed
  have twice := derivedSet.monotone at X, T with inside
  have whole := derivedSet.subset_whole at X, T, A
  apply IsClosed.iff_limitPoints_subset.backward with topology, whole
  intros x hx
  have limit := derivedSet.limit_iff.backward with hx
  exact twice with x, limit

-- In a T1 space the derived set of any subset is closed: a limit point x
-- of the derived set has, in every open U around it, a limit point y ≠ x
-- of A, and U with x removed is an open set around y that meets A.
theorem derivedSet.closed_of_t1 (X T A : Set)
  requires topology : IsTopology(X, T)
  requires t1 : IsT1Space(X, T)
  requires hA : A ⊆ X
  shows IsClosed(X, T, derivedSet(X, T, A))
proof
  have whole := derivedSet.subset_whole at X, T, A
  apply IsClosed.iff_limitPoints_subset.backward with topology, whole
  intros x hx
  have parts := limitPoints.membership.forward with hx
  apply derivedSet.membership.backward
  refine ⟨parts.left, ?_⟩
  intros U hU hxU
  obtain ⟨y, hy⟩ := parts.right with U, hU, hxU
  have inner := intersection.membership.forward with hy
  have away := difference.singleton_membership.forward with inner.right
  have yParts := derivedSet.membership.forward with away.left
  have openPoint := IsT1Space.point_complement_open with
    topology, t1, parts.left
  have openCut := IsTopology.intersection2 with topology, hU, openPoint
  have yAway : ¬y ∈ {x}
    intro same
    exact away.right with (singleton.membership.forward with same)
  have yOutside : y ∈ complement(X, {x})
    exact complement.membership.backward with ⟨yParts.left, yAway⟩
  have yCut : y ∈ U ∩ complement(X, {x})
    exact intersection.membership.backward with ⟨inner.left, yOutside⟩
  obtain ⟨z, hz⟩ := yParts.right with
    U ∩ complement(X, {x}), openCut, yCut
  have zParts := intersection.membership.forward with hz
  have zCut := intersection.membership.forward with zParts.left
  have zOutside := complement.membership.forward with zCut.right
  have zInA := difference.singleton_membership.forward with zParts.right
  have zDistinct : z ≠ x
    intro same
    apply zOutside.right
    rw same
    exact singleton.self at x
  witness z
  apply intersection.membership.backward
  refine ⟨zCut.left, ?_⟩
  exact difference.singleton_membership.backward with ⟨zInA.left, zDistinct⟩

-- The isolated points of A: the points of A that are not limit points.

def isolatedPoints (X T A : Set) : Set :=
  { x ∈ A | IsolatedPoint(X, T, A, x) }

theorem derivedSet.difference (X T A : Set)
  requires topology : IsTopology(X, T)
  requires hA : A ⊆ X
  shows A ∖ derivedSet(X, T, A) = isolatedPoints(X, T, A)
proof
  ext x
  constructor
  . intro hx
    have parts := difference.membership.forward with hx
    have notLimit : ¬x ∈ limitPoints(X, T, A)
      intro limit
      exact parts.right with (derivedSet.limit_iff.backward with limit)
    have isolated := IsolatedPoint.of_not_limit with
      topology, hA, parts.left, notLimit
    exact isolatedPoints.membership.backward with ⟨parts.left, isolated⟩
  . intro hx
    have parts := isolatedPoints.membership.forward with hx
    have notLimit := IsolatedPoint.not_limit with parts.right
    apply difference.membership.backward
    refine ⟨parts.left, ?_⟩
    intro limit
    exact notLimit with (derivedSet.limit_iff.forward with limit)

theorem derivedSet.removed_iff (X T A x : Set)
  requires topology : IsTopology(X, T)
  requires hA : A ⊆ X
  shows x ∈ A ∖ derivedSet(X, T, A) ↔ IsolatedPoint(X, T, A, x)
proof
  have split := derivedSet.difference with topology, hA
  rw split
  constructor
  . intro hx
    have parts := isolatedPoints.membership.forward with hx
    exact parts.right
  . intro isolated
    obtain ⟨hxA, U, hU, hxU, trace⟩ := isolated
    have again : IsolatedPoint(X, T, A, x) := ⟨hxA, U, hU, hxU, trace⟩
    exact isolatedPoints.membership.backward with ⟨hxA, again⟩
