module Grace.Cumulus.Lattice.DistribLattice
import Distributive
import CompleteLattice

-- Distributivity and modularity as properties of the bundled order.
predicate DistributiveLattice (P : Set) := IsDistributiveLattice(points(P), le(P))
predicate ModularLattice (P : Set) := IsModularLattice(points(P), le(P))

notation infixl 68 "⊔" => call2(sup(P), _, _) via hypothesis DistributiveLattice(P) for P.points
notation infixl 69 "⊓" => call2(inf(P), _, _) via hypothesis DistributiveLattice(P) for P.points
notation infix 50 "≤" => Le(P, _, _) via hypothesis DistributiveLattice(P) for P.points
notation infixl 68 "⊔" => call2(sup(P), _, _) via hypothesis ModularLattice(P) for P.points
notation infixl 69 "⊓" => call2(inf(P), _, _) via hypothesis ModularLattice(P) for P.points
notation infix 50 "≤" => Le(P, _, _) via hypothesis ModularLattice(P) for P.points

instance DistributiveLattice.unbundled (P : Set)
  requires distributive : DistributiveLattice(P)
  shows IsDistributiveLattice(points(P), le(P))
proof
  simp [DistributiveLattice]

theorem DistributiveLattice.mk (A r : Set)
  requires distributive : IsDistributiveLattice(A, r)
  shows DistributiveLattice(Order.mk(A, r))
proof
  unfold DistributiveLattice
  rw [Order.mk.points, Order.mk.le]
  exact distributive

instance DistributiveLattice.lattice_of (P : Set)
  requires distributive : DistributiveLattice(P)
  shows Lattice(P)
proof
  unfold Join.Lattice
  exact IsDistributiveLattice.lattice with
      (DistributiveLattice.unbundled with distributive)

instance ModularLattice.unbundled (P : Set)
  requires modular : ModularLattice(P)
  shows IsModularLattice(points(P), le(P))
proof
  simp [ModularLattice]

theorem ModularLattice.mk (A r : Set)
  requires modular : IsModularLattice(A, r)
  shows ModularLattice(Order.mk(A, r))
proof
  unfold ModularLattice
  rw [Order.mk.points, Order.mk.le]
  exact modular

instance ModularLattice.lattice_of (P : Set)
  requires modular : ModularLattice(P)
  shows Lattice(P)
proof
  unfold Join.Lattice
  exact IsModularLattice.lattice with (ModularLattice.unbundled with modular)

theorem DistributiveLattice.modular_of (P : Set)
  requires distributive : DistributiveLattice(P)
  shows ModularLattice(P)
proof
  unfold ModularLattice
  exact IsDistributiveLattice.modular with
      (DistributiveLattice.unbundled with distributive)

theorem DistributiveLattice.dual (P : Set)
  requires distributive : DistributiveLattice(P)
  shows DistributiveLattice(dual(P))
proof
  unfold dual
  apply DistributiveLattice.mk
  exact IsDistributiveLattice.converse with
      (DistributiveLattice.unbundled with distributive)

section DistributiveLaws
variable (P : Set)
hypothesis distributive : DistributiveLattice(P)

theorem inf_sup_left (a b c ∈ points(P))
  shows a ⊓ (b ⊔ c) = (a ⊓ b) ⊔ (a ⊓ c)
proof
  simp [sup.join, inf.meet]
  exact IsDistributiveLattice.meet_join with *

theorem inf_sup_right (a b c ∈ points(P))
  shows (a ⊔ b) ⊓ c = (a ⊓ c) ⊔ (b ⊓ c)
proof
  simp [sup.join, inf.meet]
  exact IsDistributiveLattice.meet_join_right with *

theorem sup_inf_left (a b c ∈ points(P))
  shows a ⊔ (b ⊓ c) = (a ⊔ b) ⊓ (a ⊔ c)
proof
  simp [sup.join, inf.meet]
  exact IsDistributiveLattice.join_meet with *

theorem sup_inf_right (a b c ∈ points(P))
  shows (a ⊓ b) ⊔ c = (a ⊔ c) ⊓ (b ⊔ c)
proof
  simp [sup.join, inf.meet]
  exact IsDistributiveLattice.join_meet_right with *

theorem eq_of_inf_eq_sup_eq (a b c ∈ points(P))
  requires meets : a ⊓ b = a ⊓ c
  requires joins : a ⊔ b = a ⊔ c
  shows b = c
proof
  simp [sup.join, inf.meet] at meets
  simp [sup.join, inf.meet] at joins
  exact IsDistributiveLattice.cancel with *

end DistributiveLaws

-- A lattice is distributive when either distributive law holds.
theorem DistributiveLattice.of_inf_sup_left (P : Set)
  requires lattice : Lattice(P)
  requires law : ∀ a b c ∈ points(P), a ⊓ (b ⊔ c) = (a ⊓ b) ⊔ (a ⊓ c)
  shows DistributiveLattice(P)
proof
  unfold DistributiveLattice
  constructor
  . exact Lattice.unbundled with lattice
  . intros a aIn b bIn c cIn
    have bridged := law with a, aIn, b, bIn, c, cIn
    simp [sup.join, inf.meet] at bridged
    exact bridged

theorem DistributiveLattice.of_sup_inf_left (P : Set)
  requires lattice : Lattice(P)
  requires law : ∀ a b c ∈ points(P), a ⊔ (b ⊓ c) = (a ⊔ b) ⊓ (a ⊔ c)
  shows DistributiveLattice(P)
proof
  unfold DistributiveLattice
  apply IsDistributiveLattice.of_join_meet with (Lattice.unbundled with lattice)
  intros a aIn b bIn c cIn
  have bridged := law with a, aIn, b, bIn, c, cIn
  simp [sup.join, inf.meet] at bridged
  exact bridged

section ModularLaws
variable (P : Set)
hypothesis modular : ModularLattice(P)

theorem inf_sup_assoc_of_le (a b c ∈ points(P))
  requires hba : b ≤ a
  shows a ⊓ (b ⊔ c) = b ⊔ (a ⊓ c)
proof
  simp [sup.join, inf.meet]
  exact IsModularLattice.law with *

end ModularLaws

section ComplementLaws
variable (P : Set)
hypothesis distributive : DistributiveLattice(P)
hypothesis bounded : BoundedLattice(P)

theorem BoundedLattice.bounded_distributive
  shows BoundedDistributiveLattice(points(P), le(P), bot(P), top(P))
proof
  exact BoundedDistributiveLattice.of_bounds with
      (DistributiveLattice.unbundled with distributive),
      (BoundedLattice.unbundled with bounded)

theorem IsCompl.unique (b c : Set) (a ∈ points(P))
  requires first : IsCompl(P, a, b)
  requires second : IsCompl(P, a, c)
  shows b = c
proof
  have both := BoundedLattice.bounded_distributive with distributive, bounded
  have firstC := IsCompl.unbundled with bounded, first
  have secondC := IsCompl.unbundled with bounded, second
  exact Complementary.unique with both, assumption, firstC, secondC

end ComplementLaws

instance powersetLattice.distributive (X : Set)
  shows DistributiveLattice(powersetLattice(X))
proof
  unfold powersetLattice
  exact DistributiveLattice.mk with (powersetOrder.distributive at X)
