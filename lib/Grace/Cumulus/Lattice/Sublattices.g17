module Grace.Cumulus.Lattice.Sublattices
import Sublattice
import CompleteLattice

-- A sublattice is a subset of the points closed under join and meet.
predicate Sublattice (P B : Set) := IsSublattice(points(P), le(P), B)

notation infixl 68 "⊔" => call2(sup(P), _, _) via hypothesis Sublattice(P, B) for P.points
notation infixl 69 "⊓" => call2(inf(P), _, _) via hypothesis Sublattice(P, B) for P.points
notation infix 50 "≤" => Le(P, _, _) via hypothesis Sublattice(P, B) for P.points

instance Sublattice.unbundled (P B : Set)
  requires sub : Sublattice(P, B)
  shows IsSublattice(points(P), le(P), B)
proof
  simp [Sublattice]

theorem Sublattice.mk (A r B : Set)
  requires sub : IsSublattice(A, r, B)
  shows Sublattice(Order.mk(A, r), B)
proof
  unfold Sublattice
  rw [Order.mk.points, Order.mk.le]
  exact sub

instance Sublattice.lattice_of (P B : Set)
  requires sub : Sublattice(P, B)
  shows Lattice(P)
proof
  unfold Join.Lattice
  exact IsSublattice.lattice with (Sublattice.unbundled with sub)

theorem Sublattice.subset_points (P B : Set)
  requires sub : Sublattice(P, B)
  shows B ⊆ points(P)
proof
  exact IsSublattice.subset with (Sublattice.unbundled with sub)

theorem Sublattice.mem_points (P B x : Set)
  requires sub : Sublattice(P, B)
  requires xIn : x ∈ B
  shows x ∈ points(P)
proof
  have subset := Sublattice.subset_points with sub
  exact subset with x, xIn

section SublatticeClosure
variable (P B : Set)
hypothesis sub : Sublattice(P, B)

instance Sublattice.sup_mem (a b : Set)
  requires aIn : a ∈ B
  requires bIn : b ∈ B
  shows a ⊔ b ∈ B
proof
  have aCarrier := Sublattice.mem_points with sub, aIn
  have bCarrier := Sublattice.mem_points with sub, bIn
  rw sup.join
  exact IsSublattice.join_closed with (Sublattice.unbundled with sub), aIn, bIn

instance Sublattice.inf_mem (a b : Set)
  requires aIn : a ∈ B
  requires bIn : b ∈ B
  shows a ⊓ b ∈ B
proof
  have aCarrier := Sublattice.mem_points with sub, aIn
  have bCarrier := Sublattice.mem_points with sub, bIn
  rw inf.meet
  exact IsSublattice.meet_closed with (Sublattice.unbundled with sub), aIn, bIn

end SublatticeClosure

theorem Sublattice.univ (P : Set)
  requires lattice : Lattice(P)
  shows Sublattice(P, points(P))
proof
  unfold Sublattice
  exact IsSublattice.whole with (Lattice.unbundled with lattice)

theorem Sublattice.inter (P B C : Set)
  requires hB : Sublattice(P, B)
  requires hC : Sublattice(P, C)
  shows Sublattice(P, B ∩ C)
proof
  unfold Sublattice
  exact IsSublattice.intersection with (Sublattice.unbundled with hB),
      (Sublattice.unbundled with hC)

-- The order restricted to a subset, as a bundled order.
def suborder (P B : Set) : Set := Order.mk(B, restrictOrder(le(P), B))

theorem suborder.points (P B : Set)
  shows points(suborder(P, B)) = B
proof
  simp [suborder, Order.mk.points]

theorem suborder.le (P B : Set)
  shows le(suborder(P, B)) = restrictOrder(le(P), B)
proof
  simp [suborder, Order.mk.le]

theorem suborder.partial_order (P B : Set)
  requires order : PartialOrder(P)
  requires hB : B ⊆ points(P)
  shows PartialOrder(suborder(P, B))
proof
  unfold suborder
  apply PartialOrder.mk
  exact restrictOrder.partial with (PartialOrder.unbundled with order), hB

instance Sublattice.lattice_suborder (P B : Set)
  requires sub : Sublattice(P, B)
  shows Lattice(suborder(P, B))
proof
  unfold suborder
  apply Lattice.mk
  exact IsSublattice.restricted with (Sublattice.unbundled with sub)

-- Join and meet in the restricted lattice agree with those of P; the
-- restricted operation is written as its application, since the operands
-- lie in both carriers.
section Suborder
variable (P B : Set)
hypothesis sub : Sublattice(P, B)

theorem Sublattice.sup_suborder (a b : Set)
  requires aIn : a ∈ B
  requires bIn : b ∈ B
  shows call2(sup(suborder(P, B)), a, b) = a ⊔ b
proof
  have restricted : Lattice(suborder(P, B)) := Sublattice.lattice_suborder with
      sub
  have aCarrier := Sublattice.mem_points with sub, aIn
  have bCarrier := Sublattice.mem_points with sub, bIn
  have aSub : a ∈ points(suborder(P, B))
    rw suborder.points
    exact aIn
  have bSub : b ∈ points(suborder(P, B))
    rw suborder.points
    exact bIn
  have inner := sup.join at suborder(P, B), a, b with restricted
  have outer := sup.join at P, a, b with *
  rw [inner, outer, suborder.points, suborder.le]
  exact IsSublattice.join with (Sublattice.unbundled with sub), aIn, bIn

theorem Sublattice.inf_suborder (a b : Set)
  requires aIn : a ∈ B
  requires bIn : b ∈ B
  shows call2(inf(suborder(P, B)), a, b) = a ⊓ b
proof
  have restricted : Lattice(suborder(P, B)) := Sublattice.lattice_suborder with
      sub
  have aCarrier := Sublattice.mem_points with sub, aIn
  have bCarrier := Sublattice.mem_points with sub, bIn
  have aSub : a ∈ points(suborder(P, B))
    rw suborder.points
    exact aIn
  have bSub : b ∈ points(suborder(P, B))
    rw suborder.points
    exact bIn
  have inner := inf.meet at suborder(P, B), a, b with restricted
  have outer := inf.meet at P, a, b with *
  rw [inner, outer, suborder.points, suborder.le]
  exact IsSublattice.meet with (Sublattice.unbundled with sub), aIn, bIn

end Suborder
