module Grace.Cumulus.Lattice.OrderHom
import Monotone
import CompleteLattice

-- Maps between bundled orders, as properties of the map and the two
-- ordered sets. A Galois connection is written with its lower adjoint
-- first: l : P → Q is left adjoint to u : Q → P.
predicate MonotoneMap (f P Q : Set) :=
  IsMonotoneMap(f, points(P), le(P), points(Q), le(Q))
predicate AntitoneMap (f P Q : Set) :=
  IsAntitoneMap(f, points(P), le(P), points(Q), le(Q))
predicate GaloisConnection (l u P Q : Set) :=
  IsGaloisConnection(l, points(P), le(P), u, points(Q), le(Q))
predicate ClosureOperator (c P : Set) := IsClosureOperator(c, points(P), le(P))
predicate OrderIso (f P Q : Set) :=
  OrderIsomorphism(f, points(P), le(P), points(Q), le(Q))

-- A map hypothesis supplies the orders of both of its ordered sets; an
-- operand is placed by its membership in a points or as a value f(a).
notation infix 50 "≤" => Le(P, _, _) via hypothesis MonotoneMap(f, P, Q) for P.points
notation infix 50 "≤" => Le(Q, _, _) via hypothesis MonotoneMap(f, P, Q) for Q.points
notation infix 50 "≤" => Le(P, _, _) via hypothesis AntitoneMap(f, P, Q) for P.points
notation infix 50 "≤" => Le(Q, _, _) via hypothesis AntitoneMap(f, P, Q) for Q.points
notation infix 50 "≤" => Le(P, _, _) via hypothesis GaloisConnection(l, u, P, Q) for P.points
notation infix 50 "≤" => Le(Q, _, _) via hypothesis GaloisConnection(l, u, P, Q) for Q.points
notation infix 50 "≤" => Le(P, _, _) via hypothesis ClosureOperator(c, P) for P.points
notation infix 50 "≤" => Le(P, _, _) via hypothesis OrderIso(f, P, Q) for P.points
notation infix 50 "≤" => Le(Q, _, _) via hypothesis OrderIso(f, P, Q) for Q.points
notation infixl 68 "⊔" => call2(sup(P), _, _) via hypothesis MonotoneMap(f, P, Q) for P.points
notation infixl 68 "⊔" => call2(sup(Q), _, _) via hypothesis MonotoneMap(f, P, Q) for Q.points
notation infixl 69 "⊓" => call2(inf(P), _, _) via hypothesis MonotoneMap(f, P, Q) for P.points
notation infixl 69 "⊓" => call2(inf(Q), _, _) via hypothesis MonotoneMap(f, P, Q) for Q.points

-- Bridges to the unbundled forms.
instance MonotoneMap.unbundled (f P Q : Set)
  requires monotone : MonotoneMap(f, P, Q)
  shows IsMonotoneMap(f, points(P), le(P), points(Q), le(Q))
proof
  simp [MonotoneMap]

instance AntitoneMap.unbundled (f P Q : Set)
  requires antitone : AntitoneMap(f, P, Q)
  shows IsAntitoneMap(f, points(P), le(P), points(Q), le(Q))
proof
  simp [AntitoneMap]

instance GaloisConnection.unbundled (l u P Q : Set)
  requires gc : GaloisConnection(l, u, P, Q)
  shows IsGaloisConnection(l, points(P), le(P), u, points(Q), le(Q))
proof
  simp [GaloisConnection]

instance ClosureOperator.unbundled (c P : Set)
  requires closure : ClosureOperator(c, P)
  shows IsClosureOperator(c, points(P), le(P))
proof
  simp [ClosureOperator]

instance OrderIso.unbundled (f P Q : Set)
  requires iso : OrderIso(f, P, Q)
  shows OrderIsomorphism(f, points(P), le(P), points(Q), le(Q))
proof
  simp [OrderIso]

theorem MonotoneMap.mk (f A r B s : Set)
  requires monotone : IsMonotoneMap(f, A, r, B, s)
  shows MonotoneMap(f, Order.mk(A, r), Order.mk(B, s))
proof
  unfold MonotoneMap
  rw [Order.mk.points, Order.mk.le, Order.mk.points, Order.mk.le]
  exact monotone

theorem AntitoneMap.mk (f A r B s : Set)
  requires antitone : IsAntitoneMap(f, A, r, B, s)
  shows AntitoneMap(f, Order.mk(A, r), Order.mk(B, s))
proof
  unfold AntitoneMap
  rw [Order.mk.points, Order.mk.le, Order.mk.points, Order.mk.le]
  exact antitone

theorem GaloisConnection.mk (l A r u B s : Set)
  requires gc : IsGaloisConnection(l, A, r, u, B, s)
  shows GaloisConnection(l, u, Order.mk(A, r), Order.mk(B, s))
proof
  unfold GaloisConnection
  rw [Order.mk.points, Order.mk.le, Order.mk.points, Order.mk.le]
  exact gc

theorem ClosureOperator.mk (c A r : Set)
  requires closure : IsClosureOperator(c, A, r)
  shows ClosureOperator(c, Order.mk(A, r))
proof
  unfold ClosureOperator
  rw [Order.mk.points, Order.mk.le]
  exact closure

theorem OrderIso.mk (f A r B s : Set)
  requires iso : OrderIsomorphism(f, A, r, B, s)
  shows OrderIso(f, Order.mk(A, r), Order.mk(B, s))
proof
  unfold OrderIso
  rw [Order.mk.points, Order.mk.le, Order.mk.points, Order.mk.le]
  exact iso

-- Monotone maps

theorem IsMonotoneMap.function (f P Q : Set)
  requires monotone : MonotoneMap(f, P, Q)
  shows f : points(P) → points(Q)
proof
  exact IsMonotoneMap.function with (MonotoneMap.unbundled with monotone)

instance MonotoneMap.apply_mem (f P Q : Set) (a ∈ points(P))
  requires monotone : MonotoneMap(f, P, Q)
  shows f(a) ∈ points(Q)
proof
  exact IsMonotoneMap.apply_member with (MonotoneMap.unbundled with monotone), *

theorem IsAntitoneMap.function (f P Q : Set)
  requires antitone : AntitoneMap(f, P, Q)
  shows f : points(P) → points(Q)
proof
  exact IsAntitoneMap.function with (AntitoneMap.unbundled with antitone)

section MonotoneLaws
variable (f P Q : Set)
hypothesis monotone : MonotoneMap(f, P, Q)

theorem MonotoneMap.map_le (a b ∈ points(P))
  requires hab : a ≤ b
  shows f(a) ≤ f(b)
proof
  unfold Le
  exact IsMonotoneMap.preserves with (MonotoneMap.unbundled with monotone),
      (Le.relates with hab), *

theorem MonotoneMap.dual
  shows MonotoneMap(f, dual(P), dual(Q))
proof
  unfold MonotoneMap
  rw [dual.points, dual.le, dual.points, dual.le]
  exact IsMonotoneMap.converse with (MonotoneMap.unbundled with monotone)

end MonotoneLaws

section AntitoneLaws
variable (f P Q : Set)
hypothesis antitone : AntitoneMap(f, P, Q)

theorem AntitoneMap.map_le (a b ∈ points(P))
  requires hab : a ≤ b
  shows f(b) ≤ f(a)
proof
  unfold Le
  exact IsAntitoneMap.reverses with (AntitoneMap.unbundled with antitone),
      (Le.relates with hab), *

theorem AntitoneMap.monotone_dual
  shows MonotoneMap(f, P, dual(Q))
proof
  unfold MonotoneMap
  rw [dual.points, dual.le]
  exact IsAntitoneMap.monotone_converse with (AntitoneMap.unbundled with antitone)

end AntitoneLaws

theorem MonotoneMap.id (P : Set)
  shows MonotoneMap(identity(points(P)), P, P)
proof
  unfold MonotoneMap
  exact IsMonotoneMap.identity at points(P), le(P)

theorem MonotoneMap.comp (f g P Q R : Set)
  requires hf : MonotoneMap(f, P, Q)
  requires hg : MonotoneMap(g, Q, R)
  shows MonotoneMap(compose(g, f, points(P), points(Q), points(R)), P, R)
proof
  unfold MonotoneMap
  exact IsMonotoneMap.compose with (MonotoneMap.unbundled with hf),
      (MonotoneMap.unbundled with hg)

instance OrderIso.monotone_of (f P Q : Set)
  requires iso : OrderIso(f, P, Q)
  shows MonotoneMap(f, P, Q)
proof
  unfold MonotoneMap
  exact OrderIsomorphism.monotone with (OrderIso.unbundled with iso)

-- A monotone map between lattices sends joins above the join of the images
-- and meets below the meet of the images.
section MonotoneLattice
variable (f P Q : Set)
hypothesis monotone : MonotoneMap(f, P, Q)
hypothesis source : Lattice(P)
hypothesis target : Lattice(Q)

theorem MonotoneMap.map_sup_le (a b ∈ points(P))
  shows f(a) ⊔ f(b) ≤ f(a ⊔ b)
proof
  have faIn : f(a) ∈ points(Q) := MonotoneMap.apply_mem with *
  have fbIn : f(b) ∈ points(Q) := MonotoneMap.apply_mem with *
  unfold Le
  rw [sup.join, sup.join]
  exact IsMonotoneMap.join_le at f, points(P), le(P), points(Q), le(Q), a, b
      with (MonotoneMap.unbundled with monotone), *

theorem MonotoneMap.le_map_inf (a b ∈ points(P))
  shows f(a ⊓ b) ≤ f(a) ⊓ f(b)
proof
  have faIn : f(a) ∈ points(Q) := MonotoneMap.apply_mem with *
  have fbIn : f(b) ∈ points(Q) := MonotoneMap.apply_mem with *
  unfold Le
  rw [inf.meet, inf.meet]
  exact IsMonotoneMap.meet_ge at f, points(P), le(P), points(Q), le(Q), a, b
      with (MonotoneMap.unbundled with monotone), *

end MonotoneLattice

-- Galois connections

theorem GaloisConnection.l_function (l u P Q : Set)
  requires gc : GaloisConnection(l, u, P, Q)
  shows l : points(P) → points(Q)
proof
  exact IsGaloisConnection.lower_function with (GaloisConnection.unbundled with gc)

theorem GaloisConnection.u_function (l u P Q : Set)
  requires gc : GaloisConnection(l, u, P, Q)
  shows u : points(Q) → points(P)
proof
  exact IsGaloisConnection.upper_function with (GaloisConnection.unbundled with gc)

instance GaloisConnection.l_apply_mem (l u P Q : Set) (a ∈ points(P))
  requires gc : GaloisConnection(l, u, P, Q)
  shows l(a) ∈ points(Q)
proof
  have function := GaloisConnection.l_function with gc
  exact FunctionBetween.apply_closed with function, *

instance GaloisConnection.u_apply_mem (l u P Q : Set) (b ∈ points(Q))
  requires gc : GaloisConnection(l, u, P, Q)
  shows u(b) ∈ points(P)
proof
  have function := GaloisConnection.u_function with gc
  exact FunctionBetween.apply_closed with function, *

section GaloisLaws
variable (l u P Q : Set)
hypothesis gc : GaloisConnection(l, u, P, Q)
hypothesis source : PartialOrder(P)
hypothesis target : PartialOrder(Q)

theorem GaloisConnection.le_iff_le (a ∈ points(P)) (b ∈ points(Q))
  shows l(a) ≤ b ↔ a ≤ u(b)
proof
  have adjoint := IsGaloisConnection.adjunction
      with (GaloisConnection.unbundled with gc), *
  constructor
  . intro h
    exact Le.of_relates with (adjoint.forward with (Le.relates with h))
  . intro h
    exact Le.of_relates with (adjoint.backward with (Le.relates with h))

theorem GaloisConnection.le_u_l (a ∈ points(P))
  shows a ≤ u(l(a))
proof
  unfold Le
  exact IsGaloisConnection.unit with (GaloisConnection.unbundled with gc),
      (PartialOrder.unbundled with target), *

theorem GaloisConnection.l_u_le (b ∈ points(Q))
  shows l(u(b)) ≤ b
proof
  unfold Le
  exact IsGaloisConnection.counit with (GaloisConnection.unbundled with gc),
      (PartialOrder.unbundled with source), *

theorem GaloisConnection.monotone_l
  shows MonotoneMap(l, P, Q)
proof
  unfold MonotoneMap
  exact IsGaloisConnection.lower_monotone with (GaloisConnection.unbundled with gc),
      (PartialOrder.unbundled with source), (PartialOrder.unbundled with target)

theorem GaloisConnection.monotone_u
  shows MonotoneMap(u, Q, P)
proof
  unfold MonotoneMap
  exact IsGaloisConnection.upper_monotone with (GaloisConnection.unbundled with gc),
      (PartialOrder.unbundled with source), (PartialOrder.unbundled with target)

theorem GaloisConnection.l_u_l_eq_l (a ∈ points(P))
  shows l(u(l(a))) = l(a)
proof
  exact IsGaloisConnection.lower_upper_lower with (GaloisConnection.unbundled with gc),
      (PartialOrder.unbundled with source),
      (PartialOrder.unbundled with target), *

theorem GaloisConnection.u_l_u_eq_u (b ∈ points(Q))
  shows u(l(u(b))) = u(b)
proof
  exact IsGaloisConnection.upper_lower_upper with (GaloisConnection.unbundled with gc),
      (PartialOrder.unbundled with source),
      (PartialOrder.unbundled with target), *

theorem GaloisConnection.l_isLUB (S s : Set)
  requires lub : IsLUB(P, S, s)
  shows IsLUB(Q, functionImage(l, S, points(Q)), l(s))
proof
  unfold IsLUB at lub
  unfold IsLUB
  exact IsGaloisConnection.lower_supremum with (GaloisConnection.unbundled with gc),
      (PartialOrder.unbundled with source),
      (PartialOrder.unbundled with target), lub

theorem GaloisConnection.u_isGLB (T t : Set)
  requires glb : IsGLB(Q, T, t)
  shows IsGLB(P, functionImage(u, T, points(P)), u(t))
proof
  unfold IsGLB at glb
  unfold IsGLB
  exact IsGaloisConnection.upper_infimum with (GaloisConnection.unbundled with gc),
      (PartialOrder.unbundled with source),
      (PartialOrder.unbundled with target), glb

theorem IsGaloisConnection.closure
  shows ClosureOperator(compose(u, l, points(P), points(Q), points(P)), P)
proof
  unfold ClosureOperator
  exact IsGaloisConnection.closure with (GaloisConnection.unbundled with gc),
      (PartialOrder.unbundled with source), (PartialOrder.unbundled with target)

end GaloisLaws

theorem GaloisConnection.id (P : Set)
  shows GaloisConnection(identity(points(P)), identity(points(P)), P, P)
proof
  unfold GaloisConnection
  exact IsGaloisConnection.identity at points(P), le(P)

theorem GaloisConnection.comp (l u k v P Q R : Set)
  requires first : GaloisConnection(l, u, P, Q)
  requires second : GaloisConnection(k, v, Q, R)
  shows GaloisConnection(compose(k, l, points(P), points(Q), points(R)),
    compose(u, v, points(R), points(Q), points(P)), P, R)
proof
  unfold GaloisConnection
  exact IsGaloisConnection.compose with (GaloisConnection.unbundled with first),
      (GaloisConnection.unbundled with second)

-- Closure operators

theorem IsClosureOperator.function (c P : Set)
  requires closure : ClosureOperator(c, P)
  shows c : points(P) → points(P)
proof
  exact IsClosureOperator.function with (ClosureOperator.unbundled with closure)

instance ClosureOperator.apply_mem (c P : Set) (a ∈ points(P))
  requires closure : ClosureOperator(c, P)
  shows c(a) ∈ points(P)
proof
  exact IsClosureOperator.apply_member with (ClosureOperator.unbundled with closure),
      *

instance ClosureOperator.monotone_of (c P : Set)
  requires closure : ClosureOperator(c, P)
  shows MonotoneMap(c, P, P)
proof
  unfold MonotoneMap
  exact IsClosureOperator.monotone with (ClosureOperator.unbundled with closure)

section ClosureLaws
variable (c P : Set)
hypothesis closure : ClosureOperator(c, P)

theorem ClosureOperator.le_closure (a ∈ points(P))
  shows a ≤ c(a)
proof
  unfold Le
  exact IsClosureOperator.extensive with (ClosureOperator.unbundled with closure),
      *

theorem ClosureOperator.closure_closure (a ∈ points(P))
  shows c(c(a)) = c(a)
proof
  exact IsClosureOperator.idempotent with (ClosureOperator.unbundled with closure),
      *

theorem ClosureOperator.le_closure_iff (a b ∈ points(P))
  requires order : PartialOrder(P)
  shows a ≤ c(b) ↔ c(a) ≤ c(b)
proof
  have characterization := IsClosureOperator.le_iff at c, points(P), le(P), a, b
      with (ClosureOperator.unbundled with closure),
      (PartialOrder.unbundled with order), *
  constructor
  . intro h
    exact Le.of_relates with (characterization.forward with (Le.relates with h))
  . intro h
    exact Le.of_relates with (characterization.backward with (Le.relates with h))

end ClosureLaws

theorem ClosureOperator.id (P : Set)
  requires order : PartialOrder(P)
  shows ClosureOperator(identity(points(P)), P)
proof
  unfold ClosureOperator
  exact IsClosureOperator.identity with (PartialOrder.unbundled with order)
