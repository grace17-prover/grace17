module Grace.Cumulus.Lattice.LinearLattice
import Distributive

theorem IsLinearOrder.total (A r x y : Set)
  requires h : IsLinearOrder(A, r)
  requires hx : x ∈ A
  requires hy : y ∈ A
  shows relates(r, x, y) ∨ relates(r, y, x)
proof
  rcases h with ⟨partial, total⟩
  exact total with x, hx, y, hy

theorem IsLinearOrder.converse (A r : Set)
  requires h : IsLinearOrder(A, r)
  shows IsLinearOrder(A, converse(r, A, A))
proof
  have order := IsLinearOrder.partial with h
  constructor
  . exact IsPartialOrder.converse with order
  . intros x hx y hy
    have cases := IsLinearOrder.total with h, hx, hy
    cases cases with xy | yx
    . right
      exact converse.relates with hx, hy, xy
    . left
      exact converse.relates with hy, hx, yx

-- In a linear order the join of two elements is the larger and the meet
-- is the smaller.

theorem IsLinearOrder.lattice (A r : Set)
  requires h : IsLinearOrder(A, r)
  shows IsLattice(A, r)
proof
  have order := IsLinearOrder.partial with h
  have reflexive := IsPartialOrder.reflexive with order
  apply IsLattice.of_pairs with order
  . intros x hx y hy
    have cases := IsLinearOrder.total with h, hx, hy
    cases cases with xy | yx
    . witness y
      apply Supremum.of_pair with hx, hy, hy, xy, (reflexive with y, hy)
      intros b hb xb yb
      exact yb
    . witness x
      apply Supremum.of_pair with hx, hy, hx, (reflexive with x, hx), yx
      intros b hb xb yb
      exact xb
  . intros x hx y hy
    have cases := IsLinearOrder.total with h, hx, hy
    cases cases with xy | yx
    . witness x
      apply Infimum.of_pair with hx, hy, hx, (reflexive with x, hx), xy
      intros b hb bx byBound
      exact bx
    . witness y
      apply Infimum.of_pair with hx, hy, hy, yx, (reflexive with y, hy)
      intros b hb bx byBound
      exact byBound

theorem IsLinearOrder.join_cases (A r x y : Set)
  requires h : IsLinearOrder(A, r)
  requires hx : x ∈ A
  requires hy : y ∈ A
  shows join(A, r, x, y) = x ∨ join(A, r, x, y) = y
proof
  have lattice := IsLinearOrder.lattice with h
  have cases := IsLinearOrder.total with h, hx, hy
  cases cases with xy | yx
  . right
    exact join.of_le with lattice, hx, hy, xy
  . left
    exact join.of_ge with lattice, hx, hy, yx

theorem IsLinearOrder.meet_cases (A r x y : Set)
  requires h : IsLinearOrder(A, r)
  requires hx : x ∈ A
  requires hy : y ∈ A
  shows meet(A, r, x, y) = x ∨ meet(A, r, x, y) = y
proof
  have lattice := IsLinearOrder.lattice with h
  have cases := IsLinearOrder.total with h, hx, hy
  cases cases with xy | yx
  . left
    exact meet.of_le with lattice, hx, hy, xy
  . right
    exact meet.of_ge with lattice, hx, hy, yx

theorem IsLinearOrder.join_member_pair (A r x y : Set)
  requires h : IsLinearOrder(A, r)
  requires hx : x ∈ A
  requires hy : y ∈ A
  shows join(A, r, x, y) ∈ {x, y}
proof
  have cases := IsLinearOrder.join_cases with h, hx, hy
  cases cases with left | right
  . rw left
    exact pair.left at x, y
  . rw right
    exact pair.right at x, y

theorem IsLinearOrder.meet_member_pair (A r x y : Set)
  requires h : IsLinearOrder(A, r)
  requires hx : x ∈ A
  requires hy : y ∈ A
  shows meet(A, r, x, y) ∈ {x, y}
proof
  have cases := IsLinearOrder.meet_cases with h, hx, hy
  cases cases with left | right
  . rw left
    exact pair.left at x, y
  . rw right
    exact pair.right at x, y

-- Distributivity, first when the two joined elements are comparable in a
-- known direction, then in general.

theorem IsLinearOrder.distributive_of_le (A r x y z : Set)
  requires h : IsLinearOrder(A, r)
  requires hx : x ∈ A
  requires hy : y ∈ A
  requires hz : z ∈ A
  requires hyz : relates(r, y, z)
  shows
    meet(A, r, x, join(A, r, y, z)) = join(A, r, meet(A, r, x, y), meet(A, r, x, z))
proof
  have lattice := IsLinearOrder.lattice with h
  have transitive := IsLattice.transitive with lattice
  have joinValue := join.of_le with lattice, hy, hz, hyz
  rw joinValue
  have casesXY := IsLinearOrder.total with h, hx, hy
  cases casesXY with xy | yx
  . have xz := transitive with x, hx, y, hy, z, hz, xy, hyz
    have meetY := meet.of_le with lattice, hx, hy, xy
    have meetZ := meet.of_le with lattice, hx, hz, xz
    rw [meetY, meetZ]
    symm
    exact join.idempotent with lattice, hx
  . have meetY := meet.of_ge with lattice, hx, hy, yx
    rw meetY
    have casesXZ := IsLinearOrder.total with h, hx, hz
    cases casesXZ with xz | zx
    . have meetZ := meet.of_le with lattice, hx, hz, xz
      rw meetZ
      symm
      exact join.of_le with lattice, hy, hx, yx
    . have meetZ := meet.of_ge with lattice, hx, hz, zx
      rw meetZ
      symm
      exact join.of_le with lattice, hy, hz, hyz

theorem IsLinearOrder.distributive (A r : Set)
  requires h : IsLinearOrder(A, r)
  shows IsDistributiveLattice(A, r)
proof
  have lattice := IsLinearOrder.lattice with h
  constructor
  . exact lattice
  . intros x hx y hy z hz
    have cases := IsLinearOrder.total with h, hy, hz
    cases cases with yz | zy
    . exact IsLinearOrder.distributive_of_le with h, hx, hy, hz, yz
    . have swapJoin := join.commutative with lattice, hy, hz
      have xyA := meet.member with lattice, hx, hy
      have xzA := meet.member with lattice, hx, hz
      have swapMeets := join.commutative with lattice, xyA, xzA
      rw [swapJoin, swapMeets]
      exact IsLinearOrder.distributive_of_le with h, hx, hz, hy, zy

theorem IsLinearOrder.modular (A r : Set)
  requires h : IsLinearOrder(A, r)
  shows IsModularLattice(A, r)
proof
  exact IsDistributiveLattice.modular with (IsLinearOrder.distributive with h)
