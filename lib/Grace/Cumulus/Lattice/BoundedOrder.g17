-- Bounded lattices bundled as ordered sets, with bot(P) and top(P)
-- Part of Cumulus, the Grace17 mathematics library.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module Grace.Cumulus.Lattice.BoundedOrder
import Bounded
import Join

-- A bounded lattice is a lattice with a least and a greatest element; the
-- elements are determined by the order and read back as bot(P) and top(P).
predicate BoundedLattice (P : Set) :=
  Lattice(P) ∧ (∃ b, Least(points(P), le(P), points(P), b)) ∧
  (∃ t, Greatest(points(P), le(P), points(P), t))

notation infixl 68 "⊔" => call2(sup(P), _, _) via hypothesis BoundedLattice(P) for P.points
notation infixl 69 "⊓" => call2(inf(P), _, _) via hypothesis BoundedLattice(P) for P.points
notation infix 50 "≤" => Le(P, _, _) via hypothesis BoundedLattice(P) for P.points

instance BoundedLattice.lattice_of (P : Set)
  requires bounded : BoundedLattice(P)
  shows Lattice(P)
proof
  simp [BoundedLattice]

theorem BoundedLattice.exists_least (P : Set)
  requires bounded : BoundedLattice(P)
  shows ∃ b, Least(points(P), le(P), points(P), b)
proof
  obtain ⟨lattice, least, greatest⟩ := bounded
  exact least

theorem BoundedLattice.exists_greatest (P : Set)
  requires bounded : BoundedLattice(P)
  shows ∃ t, Greatest(points(P), le(P), points(P), t)
proof
  obtain ⟨lattice, least, greatest⟩ := bounded
  exact greatest

defunique bot (P : Set) (b ∈ points(P)) := Least(points(P), le(P), points(P), b)
requires bounded : BoundedLattice(P)
proof
  obtain ⟨b, least⟩ := BoundedLattice.exists_least with bounded
  witness b
  refine ⟨Least.member with least, least⟩
uniqueness
  intros b bIn first c cIn second
  have order := IsLattice.order with (Lattice.unbundled with (BoundedLattice.lattice_of with bounded))
  exact Least.unique with order, first, second

defunique top (P : Set) (t ∈ points(P)) := Greatest(points(P), le(P), points(P), t)
requires bounded : BoundedLattice(P)
proof
  obtain ⟨t, greatest⟩ := BoundedLattice.exists_greatest with bounded
  witness t
  refine ⟨Greatest.member with greatest, greatest⟩
uniqueness
  intros t tIn first u uIn second
  have order := IsLattice.order with (Lattice.unbundled with (BoundedLattice.lattice_of with bounded))
  exact Greatest.unique with order, first, second

-- Bridges to the unbundled form IsBoundedLattice(A, r, bot, top).
instance BoundedLattice.unbundled (P : Set)
  requires bounded : BoundedLattice(P)
  shows IsBoundedLattice(points(P), le(P), bot(P), top(P))
proof
  have lattice := Lattice.unbundled with (BoundedLattice.lattice_of with bounded)
  have least := bot.selected with bounded
  have greatest := top.selected with bounded
  exact IsBoundedLattice.of_bounds with lattice, least.right, greatest.right

theorem BoundedLattice.mk (A r b t : Set)
  requires bounded : IsBoundedLattice(A, r, b, t)
  shows BoundedLattice(Order.mk(A, r))
proof
  have lattice := Lattice.mk with (IsBoundedLattice.lattice with bounded)
  have least := IsBoundedLattice.least with bounded
  have greatest := IsBoundedLattice.greatest with bounded
  unfold BoundedLattice
  refine ⟨lattice, ?_, ?_⟩
  . witness b
    rw [Order.mk.points, Order.mk.le]
    exact least
  . witness t
    rw [Order.mk.points, Order.mk.le]
    exact greatest

theorem bot.mk (A r b t : Set)
  requires bounded : IsBoundedLattice(A, r, b, t)
  shows bot(Order.mk(A, r)) = b
proof
  have bundled := BoundedLattice.mk with bounded
  have selected := bot.selected with bundled
  have least := IsBoundedLattice.least with bounded
  have order := IsLattice.order with (IsBoundedLattice.lattice with bounded)
  rw [Order.mk.points, Order.mk.le] at selected
  exact Least.unique with order, selected.right, least

theorem top.mk (A r b t : Set)
  requires bounded : IsBoundedLattice(A, r, b, t)
  shows top(Order.mk(A, r)) = t
proof
  have bundled := BoundedLattice.mk with bounded
  have selected := top.selected with bundled
  have greatest := IsBoundedLattice.greatest with bounded
  have order := IsLattice.order with (IsBoundedLattice.lattice with bounded)
  rw [Order.mk.points, Order.mk.le] at selected
  exact Greatest.unique with order, selected.right, greatest

-- Two elements are complementary when they meet at the bottom and join at
-- the top; under a hypothesis the conjuncts read a ⊓ b = bot(P) and
-- a ⊔ b = top(P).
predicate IsCompl (P a b : Set) :=
  b ∈ points(P) ∧ call2(inf(P), a, b) = bot(P) ∧ call2(sup(P), a, b) = top(P)

-- The bounds are written ⊥ and ⊤ wherever a hypothesis in scope supplies
-- the bounded lattice; both lie in points(P).
notation constant "⊥" => bot(P) via hypothesis BoundedLattice(P) for P.points
notation constant "⊤" => top(P) via hypothesis BoundedLattice(P) for P.points

section BoundedLatticeLaws
variable (P : Set)
hypothesis bounded : BoundedLattice(P)

instance bot.member
  shows bot(P) ∈ points(P)
proof
  have selected := bot.selected with bounded
  exact selected.left

instance top.member
  shows top(P) ∈ points(P)
proof
  have selected := top.selected with bounded
  exact selected.left

theorem bot.isLeast
  shows IsLeast(P, points(P), bot(P))
proof
  unfold IsLeast
  have selected := bot.selected with bounded
  exact selected.right

theorem top.isGreatest
  shows IsGreatest(P, points(P), top(P))
proof
  unfold IsGreatest
  have selected := top.selected with bounded
  exact selected.right

theorem bot_le (a ∈ points(P))
  shows ⊥ ≤ a
proof
  unfold Le
  exact IsBoundedLattice.bottom_le with (BoundedLattice.unbundled with bounded),
    *

theorem le_top (a ∈ points(P))
  shows a ≤ ⊤
proof
  unfold Le
  exact IsBoundedLattice.le_top with (BoundedLattice.unbundled with bounded), *

theorem bot_unique (b : Set)
  requires least : IsLeast(P, points(P), b)
  shows b = bot(P)
proof
  unfold IsLeast at least
  exact IsBoundedLattice.bottom_unique with (BoundedLattice.unbundled with bounded), *

theorem top_unique (t : Set)
  requires greatest : IsGreatest(P, points(P), t)
  shows t = top(P)
proof
  unfold IsGreatest at greatest
  exact IsBoundedLattice.top_unique with (BoundedLattice.unbundled with bounded), *

theorem le_bot_iff (a ∈ points(P))
  shows a ≤ bot(P) ↔ a = bot(P)
proof
  have characterization := IsBoundedLattice.le_bottom_iff with (BoundedLattice.unbundled with bounded), *
  constructor
  . intro h
    exact characterization.forward with (Le.relates with h)
  . intro h
    exact Le.of_relates with (characterization.backward with h)

theorem top_le_iff (a ∈ points(P))
  shows top(P) ≤ a ↔ a = top(P)
proof
  have characterization := IsBoundedLattice.top_le_iff with (BoundedLattice.unbundled with bounded), *
  constructor
  . intro h
    exact characterization.forward with (Le.relates with h)
  . intro h
    exact Le.of_relates with (characterization.backward with h)

theorem sup_bot_eq (a ∈ points(P))
  shows a ⊔ bot(P) = a
proof
  rw sup.join
  exact join.bottom_right with (BoundedLattice.unbundled with bounded), *

theorem bot_sup_eq (a ∈ points(P))
  shows bot(P) ⊔ a = a
proof
  rw sup.join
  exact join.bottom_left with (BoundedLattice.unbundled with bounded), *

theorem inf_bot_eq (a ∈ points(P))
  shows a ⊓ bot(P) = bot(P)
proof
  rw inf.meet
  exact meet.bottom_right with (BoundedLattice.unbundled with bounded), *

theorem bot_inf_eq (a ∈ points(P))
  shows bot(P) ⊓ a = bot(P)
proof
  rw inf.meet
  exact meet.bottom_left with (BoundedLattice.unbundled with bounded), *

theorem sup_top_eq (a ∈ points(P))
  shows a ⊔ top(P) = top(P)
proof
  rw sup.join
  exact join.top_right with (BoundedLattice.unbundled with bounded), *

theorem top_sup_eq (a ∈ points(P))
  shows top(P) ⊔ a = top(P)
proof
  rw sup.join
  exact join.top_left with (BoundedLattice.unbundled with bounded), *

theorem inf_top_eq (a ∈ points(P))
  shows a ⊓ top(P) = a
proof
  rw inf.meet
  exact meet.top_right with (BoundedLattice.unbundled with bounded), *

theorem top_inf_eq (a ∈ points(P))
  shows top(P) ⊓ a = a
proof
  rw inf.meet
  exact meet.top_left with (BoundedLattice.unbundled with bounded), *

theorem sup_eq_bot_iff (a b ∈ points(P))
  shows a ⊔ b = bot(P) ↔ (a = bot(P) ∧ b = bot(P))
proof
  rw sup.join
  exact join.eq_bottom_iff with (BoundedLattice.unbundled with bounded), *

theorem inf_eq_top_iff (a b ∈ points(P))
  shows a ⊓ b = top(P) ↔ (a = top(P) ∧ b = top(P))
proof
  rw inf.meet
  exact meet.eq_top_iff with (BoundedLattice.unbundled with bounded), *

theorem bot.isLUB_empty
  shows IsLUB(P, ∅, bot(P))
proof
  unfold IsLUB
  exact IsBoundedLattice.supremum_empty with (BoundedLattice.unbundled with bounded), *

theorem top.isGLB_empty
  shows IsGLB(P, ∅, top(P))
proof
  unfold IsGLB
  exact IsBoundedLattice.infimum_empty with (BoundedLattice.unbundled with bounded), *

theorem BoundedLattice.nonempty_points
  shows Nonempty(points(P))
proof
  exact IsBoundedLattice.nonempty with (BoundedLattice.unbundled with bounded),
    *

theorem IsCompl.member (a b : Set)
  requires compl : IsCompl(P, a, b)
  shows b ∈ points(P)
proof
  obtain ⟨bIn, meetEq, joinEq⟩ := compl
  exact bIn

theorem IsCompl.inf_eq_bot (a b : Set)
  requires compl : IsCompl(P, a, b)
  shows a ⊓ b = bot(P)
proof
  obtain ⟨bIn, meetEq, joinEq⟩ := compl
  exact meetEq

theorem IsCompl.sup_eq_top (a b : Set)
  requires compl : IsCompl(P, a, b)
  shows a ⊔ b = top(P)
proof
  obtain ⟨bIn, meetEq, joinEq⟩ := compl
  exact joinEq

theorem IsCompl.unbundled (b : Set) (a ∈ points(P))
  requires compl : IsCompl(P, a, b)
  shows Complementary(points(P), le(P), bot(P), top(P), a, b)
proof
  obtain ⟨bIn, meetEq, joinEq⟩ := compl
  have meetBridge := inf.meet at P, a, b with *
  have joinBridge := sup.join at P, a, b with *
  unfold Complementary
  rw [← meetBridge, ← joinBridge]
  exact ⟨bIn, meetEq, joinEq⟩

theorem IsCompl.of_complementary (b : Set) (a ∈ points(P))
  requires compl : Complementary(points(P), le(P), bot(P), top(P), a, b)
  shows IsCompl(P, a, b)
proof
  obtain ⟨bIn, meetEq, joinEq⟩ := compl
  have meetBridge := inf.meet at P, a, b with *
  have joinBridge := sup.join at P, a, b with *
  unfold IsCompl
  rw [meetBridge, joinBridge]
  exact ⟨bIn, meetEq, joinEq⟩

theorem IsCompl.symm (b : Set) (a ∈ points(P))
  requires compl : IsCompl(P, a, b)
  shows IsCompl(P, b, a)
proof
  obtain ⟨bIn, meetEq, joinEq⟩ := compl
  have meetComm : b ⊓ a = a ⊓ b := inf_comm with *
  have supComm : b ⊔ a = a ⊔ b := sup_comm with *
  unfold IsCompl
  rw [meetComm, supComm]
  constructor
  . assumption
  . exact ⟨meetEq, joinEq⟩

theorem IsCompl.bot_top
  shows IsCompl(P, bot(P), top(P))
proof
  have topIn : top(P) ∈ points(P) := top.member with *
  have meetEq : bot(P) ⊓ top(P) = bot(P) := inf_top_eq with *
  have joinEq : bot(P) ⊔ top(P) = top(P) := bot_sup_eq with *
  exact ⟨topIn, meetEq, joinEq⟩

end BoundedLatticeLaws

-- The bounded-lattice rewrite set.
tactic bounded_simp := simp [sup_bot_eq, bot_sup_eq, inf_bot_eq, bot_inf_eq, sup_top_eq, top_sup_eq, inf_top_eq, top_inf_eq, bot_le, le_top]
