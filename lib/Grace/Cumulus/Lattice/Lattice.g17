-- Authors: Grant Passmore

module Grace.Cumulus.Lattice.Lattice
import Bounds

predicate IsLattice (A r : Set) :=
  IsPartialOrder(A, r) ∧
  (∀ x ∈ A, ∀ y ∈ A,
    (∃ s, Supremum(A, r, {x, y}, s)) ∧ (∃ i, Infimum(A, r, {x, y}, i)))

theorem IsLattice.order (A r : Set)
  requires h : IsLattice(A, r)
  shows IsPartialOrder(A, r)
proof
  simp [IsLattice]

theorem IsLattice.reflexive (A r : Set)
  requires h : IsLattice(A, r)
  shows ReflexiveOn(A, r)
proof
  exact IsPartialOrder.reflexive with (IsLattice.order with h)

theorem IsLattice.transitive (A r : Set)
  requires h : IsLattice(A, r)
  shows TransitiveOn(A, r)
proof
  exact IsPartialOrder.transitive with (IsLattice.order with h)

theorem IsLattice.antisymmetric (A r : Set)
  requires h : IsLattice(A, r)
  shows AntisymmetricOn(A, r)
proof
  exact IsPartialOrder.antisymmetric with (IsLattice.order with h)

theorem IsLattice.exists_supremum (A r x y : Set)
  requires h : IsLattice(A, r)
  requires hx : x ∈ A
  requires hy : y ∈ A
  shows ∃ s, Supremum(A, r, {x, y}, s)
proof
  rcases h with ⟨order, pairs⟩
  have both := pairs with x, hx, y, hy
  exact both.left

theorem IsLattice.exists_infimum (A r x y : Set)
  requires h : IsLattice(A, r)
  requires hx : x ∈ A
  requires hy : y ∈ A
  shows ∃ i, Infimum(A, r, {x, y}, i)
proof
  rcases h with ⟨order, pairs⟩
  have both := pairs with x, hx, y, hy
  exact both.right

-- The join of two elements is the supremum of the pair, and the meet is
-- its infimum. Both are determined uniquely by antisymmetry.

defunique join (A r x y : Set) (z ∈ A) := Supremum(A, r, {x, y}, z)
requires lattice : IsLattice(A, r)
requires hx : x ∈ A
requires hy : y ∈ A
proof
  obtain ⟨s, hs⟩ := IsLattice.exists_supremum with lattice, hx, hy
  witness s
  refine ⟨Supremum.member with hs, hs⟩
uniqueness
  intros s sA first t tA second
  exact Supremum.unique with (IsLattice.order with lattice), first, second

defunique meet (A r x y : Set) (z ∈ A) := Infimum(A, r, {x, y}, z)
requires lattice : IsLattice(A, r)
requires hx : x ∈ A
requires hy : y ∈ A
proof
  obtain ⟨i, hi⟩ := IsLattice.exists_infimum with lattice, hx, hy
  witness i
  refine ⟨Infimum.member with hi, hi⟩
uniqueness
  intros i iA first j jA second
  exact Infimum.unique with (IsLattice.order with lattice), first, second

theorem join.member (A r x y : Set)
  requires lattice : IsLattice(A, r)
  requires hx : x ∈ A
  requires hy : y ∈ A
  shows join(A, r, x, y) ∈ A
proof
  have selected := join.selected with lattice, hx, hy
  exact selected.left

theorem join.supremum (A r x y : Set)
  requires lattice : IsLattice(A, r)
  requires hx : x ∈ A
  requires hy : y ∈ A
  shows Supremum(A, r, {x, y}, join(A, r, x, y))
proof
  have selected := join.selected with lattice, hx, hy
  exact selected.right

theorem join.upper_left (A r x y : Set)
  requires lattice : IsLattice(A, r)
  requires hx : x ∈ A
  requires hy : y ∈ A
  shows relates(r, x, join(A, r, x, y))
proof
  exact Supremum.pair_left with (join.supremum with lattice, hx, hy)

theorem join.upper_right (A r x y : Set)
  requires lattice : IsLattice(A, r)
  requires hx : x ∈ A
  requires hy : y ∈ A
  shows relates(r, y, join(A, r, x, y))
proof
  exact Supremum.pair_right with (join.supremum with lattice, hx, hy)

theorem join.least (A r x y b : Set)
  requires lattice : IsLattice(A, r)
  requires hx : x ∈ A
  requires hy : y ∈ A
  requires hb : b ∈ A
  requires hxb : relates(r, x, b)
  requires hyb : relates(r, y, b)
  shows relates(r, join(A, r, x, y), b)
proof
  have supremum := join.supremum with lattice, hx, hy
  exact Supremum.pair_least with supremum, hb, hxb, hyb

theorem join.of_supremum (A r x y z : Set)
  requires lattice : IsLattice(A, r)
  requires hx : x ∈ A
  requires hy : y ∈ A
  requires h : Supremum(A, r, {x, y}, z)
  shows z = join(A, r, x, y)
proof
  have order := IsLattice.order with lattice
  have supremum := join.supremum with lattice, hx, hy
  exact Supremum.unique with order, h, supremum

theorem meet.member (A r x y : Set)
  requires lattice : IsLattice(A, r)
  requires hx : x ∈ A
  requires hy : y ∈ A
  shows meet(A, r, x, y) ∈ A
proof
  have selected := meet.selected with lattice, hx, hy
  exact selected.left

theorem meet.infimum (A r x y : Set)
  requires lattice : IsLattice(A, r)
  requires hx : x ∈ A
  requires hy : y ∈ A
  shows Infimum(A, r, {x, y}, meet(A, r, x, y))
proof
  have selected := meet.selected with lattice, hx, hy
  exact selected.right

theorem meet.lower_left (A r x y : Set)
  requires lattice : IsLattice(A, r)
  requires hx : x ∈ A
  requires hy : y ∈ A
  shows relates(r, meet(A, r, x, y), x)
proof
  exact Infimum.pair_left with (meet.infimum with lattice, hx, hy)

theorem meet.lower_right (A r x y : Set)
  requires lattice : IsLattice(A, r)
  requires hx : x ∈ A
  requires hy : y ∈ A
  shows relates(r, meet(A, r, x, y), y)
proof
  exact Infimum.pair_right with (meet.infimum with lattice, hx, hy)

theorem meet.greatest (A r x y b : Set)
  requires lattice : IsLattice(A, r)
  requires hx : x ∈ A
  requires hy : y ∈ A
  requires hb : b ∈ A
  requires hbx : relates(r, b, x)
  requires hby : relates(r, b, y)
  shows relates(r, b, meet(A, r, x, y))
proof
  have infimum := meet.infimum with lattice, hx, hy
  exact Infimum.pair_greatest with infimum, hb, hbx, hby

theorem meet.of_infimum (A r x y z : Set)
  requires lattice : IsLattice(A, r)
  requires hx : x ∈ A
  requires hy : y ∈ A
  requires h : Infimum(A, r, {x, y}, z)
  shows z = meet(A, r, x, y)
proof
  have order := IsLattice.order with lattice
  have infimum := meet.infimum with lattice, hx, hy
  exact Infimum.unique with order, h, infimum

-- A lattice may be built from any choice of pairwise suprema and infima.

theorem IsLattice.of_pairs (A r : Set)
  requires order : IsPartialOrder(A, r)
  requires suprema : ∀ x ∈ A, ∀ y ∈ A, ∃ s, Supremum(A, r, {x, y}, s)
  requires infima : ∀ x ∈ A, ∀ y ∈ A, ∃ i, Infimum(A, r, {x, y}, i)
  shows IsLattice(A, r)
proof
  constructor
  . exact order
  . intros x hx y hy
    have supremum := suprema with x, hx, y, hy
    have infimum := infima with x, hx, y, hy
    constructor
    . exact supremum
    . exact infimum

-- The dual of a lattice is a lattice, with join and meet exchanged.

theorem IsLattice.converse (A r : Set)
  requires lattice : IsLattice(A, r)
  shows IsLattice(A, converse(r, A, A))
proof
  have order := IsLattice.order with lattice
  apply IsLattice.of_pairs with (IsPartialOrder.converse with order)
  . intros x hx y hy
    obtain ⟨i, hi⟩ := IsLattice.exists_infimum with lattice, hx, hy
    refine ⟨i, Infimum.converse with hi⟩
  . intros x hx y hy
    obtain ⟨s, hs⟩ := IsLattice.exists_supremum with lattice, hx, hy
    refine ⟨s, Supremum.converse with hs⟩

theorem join.converse (A r x y : Set)
  requires lattice : IsLattice(A, r)
  requires hx : x ∈ A
  requires hy : y ∈ A
  shows join(A, converse(r, A, A), x, y) = meet(A, r, x, y)
proof
  have dual := IsLattice.converse with lattice
  have infimum := meet.infimum with lattice, hx, hy
  have supremum := Infimum.converse with infimum
  symm
  exact join.of_supremum with dual, hx, hy, supremum

theorem meet.converse (A r x y : Set)
  requires lattice : IsLattice(A, r)
  requires hx : x ∈ A
  requires hy : y ∈ A
  shows meet(A, converse(r, A, A), x, y) = join(A, r, x, y)
proof
  have dual := IsLattice.converse with lattice
  have supremum := join.supremum with lattice, hx, hy
  have infimum := Supremum.converse with supremum
  symm
  exact meet.of_infimum with dual, hx, hy, infimum
