module Grace.Cumulus.Lattice.Hom
import LatticeHom
import FixedPoints

-- A lattice homomorphism between bundled lattices preserves joins and
-- meets; the hypothesis supplies the orders and operations of both sides.
predicate LatticeHom (f P Q : Set) :=
  IsLatticeHom(f, points(P), le(P), points(Q), le(Q))

notation infix 50 "≤" => Le(P, _, _) via hypothesis LatticeHom(f, P, Q) for P.points
notation infix 50 "≤" => Le(Q, _, _) via hypothesis LatticeHom(f, P, Q) for Q.points
notation infixl 68 "⊔" => call2(sup(P), _, _) via hypothesis LatticeHom(f, P, Q) for P.points
notation infixl 68 "⊔" => call2(sup(Q), _, _) via hypothesis LatticeHom(f, P, Q) for Q.points
notation infixl 69 "⊓" => call2(inf(P), _, _) via hypothesis LatticeHom(f, P, Q) for P.points
notation infixl 69 "⊓" => call2(inf(Q), _, _) via hypothesis LatticeHom(f, P, Q) for Q.points

instance LatticeHom.unbundled (f P Q : Set)
  requires hom : LatticeHom(f, P, Q)
  shows IsLatticeHom(f, points(P), le(P), points(Q), le(Q))
proof
  simp [LatticeHom]

theorem LatticeHom.mk (f A r B s : Set)
  requires hom : IsLatticeHom(f, A, r, B, s)
  shows LatticeHom(f, Order.mk(A, r), Order.mk(B, s))
proof
  unfold LatticeHom
  rw [Order.mk.points, Order.mk.le, Order.mk.points, Order.mk.le]
  exact hom

instance LatticeHom.source_lattice (f P Q : Set)
  requires hom : LatticeHom(f, P, Q)
  shows Lattice(P)
proof
  unfold Join.Lattice
  exact IsLatticeHom.source with (LatticeHom.unbundled with hom)

instance LatticeHom.target_lattice (f P Q : Set)
  requires hom : LatticeHom(f, P, Q)
  shows Lattice(Q)
proof
  unfold Join.Lattice
  exact IsLatticeHom.target with (LatticeHom.unbundled with hom)

instance LatticeHom.monotone_of (f P Q : Set)
  requires hom : LatticeHom(f, P, Q)
  shows MonotoneMap(f, P, Q)
proof
  unfold OrderHom.MonotoneMap
  exact IsLatticeHom.monotone with (LatticeHom.unbundled with hom)

theorem IsLatticeHom.function (f P Q : Set)
  requires hom : LatticeHom(f, P, Q)
  shows f : points(P) → points(Q)
proof
  exact IsLatticeHom.function with (LatticeHom.unbundled with hom)

instance LatticeHom.apply_mem (f P Q : Set) (a ∈ points(P))
  requires hom : LatticeHom(f, P, Q)
  shows f(a) ∈ points(Q)
proof
  exact IsLatticeHom.apply_member with (LatticeHom.unbundled with hom), *

section LatticeHomLaws
variable (f P Q : Set)
hypothesis hom : LatticeHom(f, P, Q)

theorem map_sup (a b ∈ points(P))
  shows f(a ⊔ b) = f(a) ⊔ f(b)
proof
  have faIn : f(a) ∈ points(Q) := LatticeHom.apply_mem with *
  have fbIn : f(b) ∈ points(Q) := LatticeHom.apply_mem with *
  rw [sup.join, sup.join]
  exact IsLatticeHom.join with (LatticeHom.unbundled with hom), *

theorem map_inf (a b ∈ points(P))
  shows f(a ⊓ b) = f(a) ⊓ f(b)
proof
  have faIn : f(a) ∈ points(Q) := LatticeHom.apply_mem with *
  have fbIn : f(b) ∈ points(Q) := LatticeHom.apply_mem with *
  rw [inf.meet, inf.meet]
  exact IsLatticeHom.meet with (LatticeHom.unbundled with hom), *

theorem LatticeHom.map_le (a b ∈ points(P))
  requires hab : a ≤ b
  shows f(a) ≤ f(b)
proof
  have monotone : MonotoneMap(f, P, Q) := LatticeHom.monotone_of with hom
  exact MonotoneMap.map_le with *

end LatticeHomLaws

theorem LatticeHom.id (P : Set)
  requires lattice : Lattice(P)
  shows LatticeHom(identity(points(P)), P, P)
proof
  unfold LatticeHom
  exact IsLatticeHom.identity with (Lattice.unbundled with lattice)

theorem LatticeHom.comp (f g P Q R : Set)
  requires hf : LatticeHom(f, P, Q)
  requires hg : LatticeHom(g, Q, R)
  shows LatticeHom(compose(g, f, points(P), points(Q), points(R)), P, R)
proof
  unfold LatticeHom
  exact IsLatticeHom.compose with (LatticeHom.unbundled with hf),
      (LatticeHom.unbundled with hg)

-- An order isomorphism between lattices is a lattice homomorphism.
section OrderIsoLattice
variable (f P Q : Set)
hypothesis iso : OrderIso(f, P, Q)
hypothesis source : Lattice(P)
hypothesis target : Lattice(Q)

theorem OrderIso.latticeHom
  shows LatticeHom(f, P, Q)
proof
  unfold LatticeHom
  exact OrderIsomorphism.lattice_hom with (OrderIso.unbundled with iso),
      (Lattice.unbundled with source), (Lattice.unbundled with target)

end OrderIsoLattice
