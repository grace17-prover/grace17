module Grace.Cumulus.Lattice.LatticeLaws
import Lattice

-- Commutativity and idempotency

theorem join.commutative (A r x y : Set)
  requires lattice : IsLattice(A, r)
  requires hx : x ∈ A
  requires hy : y ∈ A
  shows join(A, r, x, y) = join(A, r, y, x)
proof
  have supremum := join.supremum with lattice, hx, hy
  have swap := pair.commutative at x, y
  rw swap at supremum
  exact join.of_supremum with lattice, hy, hx, supremum

theorem meet.commutative (A r x y : Set)
  requires lattice : IsLattice(A, r)
  requires hx : x ∈ A
  requires hy : y ∈ A
  shows meet(A, r, x, y) = meet(A, r, y, x)
proof
  have infimum := meet.infimum with lattice, hx, hy
  have swap := pair.commutative at x, y
  rw swap at infimum
  exact meet.of_infimum with lattice, hy, hx, infimum

theorem join.idempotent (A r x : Set)
  requires lattice : IsLattice(A, r)
  requires hx : x ∈ A
  shows join(A, r, x, x) = x
proof
  have order := IsLattice.order with lattice
  have supremum := Supremum.singleton with order, hx
  have same := pair.self at x
  rw ← same at supremum
  symm
  exact join.of_supremum with lattice, hx, hx, supremum

theorem meet.idempotent (A r x : Set)
  requires lattice : IsLattice(A, r)
  requires hx : x ∈ A
  shows meet(A, r, x, x) = x
proof
  have order := IsLattice.order with lattice
  have infimum := Infimum.singleton with order, hx
  have same := pair.self at x
  rw ← same at infimum
  symm
  exact meet.of_infimum with lattice, hx, hx, infimum

-- The order is recovered from either operation.

theorem join.of_le (A r x y : Set)
  requires lattice : IsLattice(A, r)
  requires hx : x ∈ A
  requires hy : y ∈ A
  requires hxy : relates(r, x, y)
  shows join(A, r, x, y) = y
proof
  have reflexive := IsLattice.reflexive with lattice
  have supremum : Supremum(A, r, {x, y}, y)
    apply Supremum.of_pair with hx, hy, hy, hxy, (reflexive with y, hy)
    intros b hb xb yb
    exact yb
  symm
  exact join.of_supremum with lattice, hx, hy, supremum

theorem join.of_ge (A r x y : Set)
  requires lattice : IsLattice(A, r)
  requires hx : x ∈ A
  requires hy : y ∈ A
  requires hyx : relates(r, y, x)
  shows join(A, r, x, y) = x
proof
  have swap := join.commutative with lattice, hx, hy
  rw swap
  exact join.of_le with lattice, hy, hx, hyx

theorem meet.of_le (A r x y : Set)
  requires lattice : IsLattice(A, r)
  requires hx : x ∈ A
  requires hy : y ∈ A
  requires hxy : relates(r, x, y)
  shows meet(A, r, x, y) = x
proof
  have reflexive := IsLattice.reflexive with lattice
  have infimum : Infimum(A, r, {x, y}, x)
    apply Infimum.of_pair with hx, hy, hx, (reflexive with x, hx), hxy
    intros b hb bx by_
    exact bx
  symm
  exact meet.of_infimum with lattice, hx, hy, infimum

theorem meet.of_ge (A r x y : Set)
  requires lattice : IsLattice(A, r)
  requires hx : x ∈ A
  requires hy : y ∈ A
  requires hyx : relates(r, y, x)
  shows meet(A, r, x, y) = y
proof
  have swap := meet.commutative with lattice, hx, hy
  rw swap
  exact meet.of_le with lattice, hy, hx, hyx

theorem join.eq_right_iff (A r x y : Set)
  requires lattice : IsLattice(A, r)
  requires hx : x ∈ A
  requires hy : y ∈ A
  shows relates(r, x, y) ↔ join(A, r, x, y) = y
proof
  constructor
  . intro hxy
    exact join.of_le with lattice, hx, hy, hxy
  . intro equal
    have upper := join.upper_left with lattice, hx, hy
    rw equal at upper
    exact upper

theorem join.eq_left_iff (A r x y : Set)
  requires lattice : IsLattice(A, r)
  requires hx : x ∈ A
  requires hy : y ∈ A
  shows relates(r, y, x) ↔ join(A, r, x, y) = x
proof
  constructor
  . intro hyx
    exact join.of_ge with lattice, hx, hy, hyx
  . intro equal
    have upper := join.upper_right with lattice, hx, hy
    rw equal at upper
    exact upper

theorem meet.eq_left_iff (A r x y : Set)
  requires lattice : IsLattice(A, r)
  requires hx : x ∈ A
  requires hy : y ∈ A
  shows relates(r, x, y) ↔ meet(A, r, x, y) = x
proof
  constructor
  . intro hxy
    exact meet.of_le with lattice, hx, hy, hxy
  . intro equal
    have lower := meet.lower_right with lattice, hx, hy
    rw equal at lower
    exact lower

theorem meet.eq_right_iff (A r x y : Set)
  requires lattice : IsLattice(A, r)
  requires hx : x ∈ A
  requires hy : y ∈ A
  shows relates(r, y, x) ↔ meet(A, r, x, y) = y
proof
  constructor
  . intro hyx
    exact meet.of_ge with lattice, hx, hy, hyx
  . intro equal
    have lower := meet.lower_left with lattice, hx, hy
    rw equal at lower
    exact lower

-- Absorption

theorem join.absorb (A r x y : Set)
  requires lattice : IsLattice(A, r)
  requires hx : x ∈ A
  requires hy : y ∈ A
  shows join(A, r, x, meet(A, r, x, y)) = x
proof
  have meetA := meet.member with lattice, hx, hy
  have lower := meet.lower_left with lattice, hx, hy
  exact join.of_ge with lattice, hx, meetA, lower

theorem join.absorb_swap (A r x y : Set)
  requires lattice : IsLattice(A, r)
  requires hx : x ∈ A
  requires hy : y ∈ A
  shows join(A, r, x, meet(A, r, y, x)) = x
proof
  have meetA := meet.member with lattice, hy, hx
  have lower := meet.lower_right with lattice, hy, hx
  exact join.of_ge with lattice, hx, meetA, lower

theorem meet.absorb (A r x y : Set)
  requires lattice : IsLattice(A, r)
  requires hx : x ∈ A
  requires hy : y ∈ A
  shows meet(A, r, x, join(A, r, x, y)) = x
proof
  have joinA := join.member with lattice, hx, hy
  have upper := join.upper_left with lattice, hx, hy
  exact meet.of_le with lattice, hx, joinA, upper

theorem meet.absorb_swap (A r x y : Set)
  requires lattice : IsLattice(A, r)
  requires hx : x ∈ A
  requires hy : y ∈ A
  shows meet(A, r, x, join(A, r, y, x)) = x
proof
  have joinA := join.member with lattice, hy, hx
  have upper := join.upper_right with lattice, hy, hx
  exact meet.of_le with lattice, hx, joinA, upper

-- Bounds through join and meet

theorem join.le_iff (A r x y b : Set)
  requires lattice : IsLattice(A, r)
  requires hx : x ∈ A
  requires hy : y ∈ A
  requires hb : b ∈ A
  shows relates(r, join(A, r, x, y), b) ↔ relates(r, x, b) ∧ relates(r, y, b)
proof
  have transitive := IsLattice.transitive with lattice
  have joinA := join.member with lattice, hx, hy
  constructor
  . intro below
    have xJ := join.upper_left with lattice, hx, hy
    have yJ := join.upper_right with lattice, hx, hy
    constructor
    . exact transitive with x, hx, join(A, r, x, y), joinA, b, hb, xJ, below
    . exact transitive with y, hy, join(A, r, x, y), joinA, b, hb, yJ, below
  . intro both
    exact join.least with lattice, hx, hy, hb, both.left, both.right

theorem meet.ge_iff (A r x y b : Set)
  requires lattice : IsLattice(A, r)
  requires hx : x ∈ A
  requires hy : y ∈ A
  requires hb : b ∈ A
  shows relates(r, b, meet(A, r, x, y)) ↔ relates(r, b, x) ∧ relates(r, b, y)
proof
  have transitive := IsLattice.transitive with lattice
  have meetA := meet.member with lattice, hx, hy
  constructor
  . intro above
    have mX := meet.lower_left with lattice, hx, hy
    have mY := meet.lower_right with lattice, hx, hy
    constructor
    . exact transitive with b, hb, meet(A, r, x, y), meetA, x, hx, above, mX
    . exact transitive with b, hb, meet(A, r, x, y), meetA, y, hy, above, mY
  . intro both
    exact meet.greatest with lattice, hx, hy, hb, both.left, both.right

theorem meet.le_join (A r x y : Set)
  requires lattice : IsLattice(A, r)
  requires hx : x ∈ A
  requires hy : y ∈ A
  shows relates(r, meet(A, r, x, y), join(A, r, x, y))
proof
  have transitive := IsLattice.transitive with lattice
  have meetA := meet.member with lattice, hx, hy
  have joinA := join.member with lattice, hx, hy
  have lower := meet.lower_left with lattice, hx, hy
  have upper := join.upper_left with lattice, hx, hy
  exact transitive with meet(A, r, x, y), meetA, x, hx, join(A, r, x, y),
      joinA, lower, upper

-- Monotonicity

theorem join.monotone (A r x y u v : Set)
  requires lattice : IsLattice(A, r)
  requires hx : x ∈ A
  requires hy : y ∈ A
  requires hu : u ∈ A
  requires hv : v ∈ A
  requires hxu : relates(r, x, u)
  requires hyv : relates(r, y, v)
  shows relates(r, join(A, r, x, y), join(A, r, u, v))
proof
  have transitive := IsLattice.transitive with lattice
  have joinA := join.member with lattice, hu, hv
  have uJ := join.upper_left with lattice, hu, hv
  have vJ := join.upper_right with lattice, hu, hv
  have xJ := transitive with x, hx, u, hu, join(A, r, u, v), joinA, hxu, uJ
  have yJ := transitive with y, hy, v, hv, join(A, r, u, v), joinA, hyv, vJ
  exact join.least with lattice, hx, hy, joinA, xJ, yJ

theorem join.monotone_left (A r x y u : Set)
  requires lattice : IsLattice(A, r)
  requires hx : x ∈ A
  requires hy : y ∈ A
  requires hu : u ∈ A
  requires hxu : relates(r, x, u)
  shows relates(r, join(A, r, x, y), join(A, r, u, y))
proof
  have reflexive := IsLattice.reflexive with lattice
  exact join.monotone with lattice, hx, hy, hu, hy, hxu, (reflexive with y, hy)

theorem join.monotone_right (A r x y v : Set)
  requires lattice : IsLattice(A, r)
  requires hx : x ∈ A
  requires hy : y ∈ A
  requires hv : v ∈ A
  requires hyv : relates(r, y, v)
  shows relates(r, join(A, r, x, y), join(A, r, x, v))
proof
  have reflexive := IsLattice.reflexive with lattice
  exact join.monotone with lattice, hx, hy, hx, hv, (reflexive with x, hx), hyv

theorem meet.monotone (A r x y u v : Set)
  requires lattice : IsLattice(A, r)
  requires hx : x ∈ A
  requires hy : y ∈ A
  requires hu : u ∈ A
  requires hv : v ∈ A
  requires hxu : relates(r, x, u)
  requires hyv : relates(r, y, v)
  shows relates(r, meet(A, r, x, y), meet(A, r, u, v))
proof
  have transitive := IsLattice.transitive with lattice
  have meetA := meet.member with lattice, hx, hy
  have mX := meet.lower_left with lattice, hx, hy
  have mY := meet.lower_right with lattice, hx, hy
  have mU := transitive with meet(A, r, x, y), meetA, x, hx, u, hu, mX, hxu
  have mV := transitive with meet(A, r, x, y), meetA, y, hy, v, hv, mY, hyv
  exact meet.greatest with lattice, hu, hv, meetA, mU, mV

theorem meet.monotone_left (A r x y u : Set)
  requires lattice : IsLattice(A, r)
  requires hx : x ∈ A
  requires hy : y ∈ A
  requires hu : u ∈ A
  requires hxu : relates(r, x, u)
  shows relates(r, meet(A, r, x, y), meet(A, r, u, y))
proof
  have reflexive := IsLattice.reflexive with lattice
  exact meet.monotone with lattice, hx, hy, hu, hy, hxu, (reflexive with y, hy)

theorem meet.monotone_right (A r x y v : Set)
  requires lattice : IsLattice(A, r)
  requires hx : x ∈ A
  requires hy : y ∈ A
  requires hv : v ∈ A
  requires hyv : relates(r, y, v)
  shows relates(r, meet(A, r, x, y), meet(A, r, x, v))
proof
  have reflexive := IsLattice.reflexive with lattice
  exact meet.monotone with lattice, hx, hy, hx, hv, (reflexive with x, hx), hyv

-- Associativity

theorem join.associative (A r x y z : Set)
  requires lattice : IsLattice(A, r)
  requires hx : x ∈ A
  requires hy : y ∈ A
  requires hz : z ∈ A
  shows join(A, r, join(A, r, x, y), z) = join(A, r, x, join(A, r, y, z))
proof
  have transitive := IsLattice.transitive with lattice
  have xyA := join.member with lattice, hx, hy
  have yzA := join.member with lattice, hy, hz
  have uA := join.member with lattice, xyA, hz
  have xXY := join.upper_left with lattice, hx, hy
  have yXY := join.upper_right with lattice, hx, hy
  have yYZ := join.upper_left with lattice, hy, hz
  have zYZ := join.upper_right with lattice, hy, hz
  have xyU := join.upper_left with lattice, xyA, hz
  have zU := join.upper_right with lattice, xyA, hz
  have xU := transitive with x, hx, join(A, r, x, y), xyA, join(A, r, join(A,
      r, x, y), z), uA, xXY, xyU
  have yU := transitive with y, hy, join(A, r, x, y), xyA, join(A, r, join(A,
      r, x, y), z), uA, yXY, xyU
  have yzU := join.least with lattice, hy, hz, uA, yU, zU
  have supremum : Supremum(A, r, {x, join(A, r, y, z)}, join(A, r, join(A, r,
      x, y), z))
    apply Supremum.of_pair with hx, yzA, uA, xU, yzU
    intros b hb xb yzb
    have yb := transitive with y, hy, join(A, r, y, z), yzA, b, hb, yYZ, yzb
    have zb := transitive with z, hz, join(A, r, y, z), yzA, b, hb, zYZ, yzb
    have xyb := join.least with lattice, hx, hy, hb, xb, yb
    exact join.least with lattice, xyA, hz, hb, xyb, zb
  exact join.of_supremum with lattice, hx, yzA, supremum

theorem meet.associative (A r x y z : Set)
  requires lattice : IsLattice(A, r)
  requires hx : x ∈ A
  requires hy : y ∈ A
  requires hz : z ∈ A
  shows meet(A, r, meet(A, r, x, y), z) = meet(A, r, x, meet(A, r, y, z))
proof
  have transitive := IsLattice.transitive with lattice
  have xyA := meet.member with lattice, hx, hy
  have yzA := meet.member with lattice, hy, hz
  have uA := meet.member with lattice, xyA, hz
  have xyX := meet.lower_left with lattice, hx, hy
  have xyY := meet.lower_right with lattice, hx, hy
  have yzY := meet.lower_left with lattice, hy, hz
  have yzZ := meet.lower_right with lattice, hy, hz
  have uXY := meet.lower_left with lattice, xyA, hz
  have uZ := meet.lower_right with lattice, xyA, hz
  have uX := transitive with meet(A, r, meet(A, r, x, y), z), uA, meet(A, r,
      x, y), xyA, x, hx, uXY, xyX
  have uY := transitive with meet(A, r, meet(A, r, x, y), z), uA, meet(A, r,
      x, y), xyA, y, hy, uXY, xyY
  have uYZ := meet.greatest with lattice, hy, hz, uA, uY, uZ
  have infimum : Infimum(A, r, {x, meet(A, r, y, z)}, meet(A, r, meet(A, r, x,
      y), z))
    apply Infimum.of_pair with hx, yzA, uA, uX, uYZ
    intros b hb bx byz
    have by_ := transitive with b, hb, meet(A, r, y, z), yzA, y, hy, byz, yzY
    have bz := transitive with b, hb, meet(A, r, y, z), yzA, z, hz, byz, yzZ
    have bxy := meet.greatest with lattice, hx, hy, hb, bx, by_
    exact meet.greatest with lattice, xyA, hz, hb, bxy, bz
  exact meet.of_infimum with lattice, hx, yzA, infimum

theorem join.left_commutative (A r x y z : Set)
  requires lattice : IsLattice(A, r)
  requires hx : x ∈ A
  requires hy : y ∈ A
  requires hz : z ∈ A
  shows join(A, r, x, join(A, r, y, z)) = join(A, r, y, join(A, r, x, z))
proof
  have first := join.associative with lattice, hx, hy, hz
  have swap := join.commutative with lattice, hx, hy
  have second := join.associative with lattice, hy, hx, hz
  rw ← first
  rw swap
  exact second

theorem meet.left_commutative (A r x y z : Set)
  requires lattice : IsLattice(A, r)
  requires hx : x ∈ A
  requires hy : y ∈ A
  requires hz : z ∈ A
  shows meet(A, r, x, meet(A, r, y, z)) = meet(A, r, y, meet(A, r, x, z))
proof
  have first := meet.associative with lattice, hx, hy, hz
  have swap := meet.commutative with lattice, hx, hy
  have second := meet.associative with lattice, hy, hx, hz
  rw ← first
  rw swap
  exact second

-- The distributive and modular inequalities hold in every lattice.

theorem meet.join_distributive_le (A r x y z : Set)
  requires lattice : IsLattice(A, r)
  requires hx : x ∈ A
  requires hy : y ∈ A
  requires hz : z ∈ A
  shows relates(r, join(A, r, meet(A, r, x, y), meet(A, r, x, z)),
    meet(A, r, x, join(A, r, y, z)))
proof
  have transitive := IsLattice.transitive with lattice
  have xyA := meet.member with lattice, hx, hy
  have xzA := meet.member with lattice, hx, hz
  have yzA := join.member with lattice, hy, hz
  have targetA := meet.member with lattice, hx, yzA
  have yYZ := join.upper_left with lattice, hy, hz
  have zYZ := join.upper_right with lattice, hy, hz
  have xyX := meet.lower_left with lattice, hx, hy
  have xyY := meet.lower_right with lattice, hx, hy
  have xzX := meet.lower_left with lattice, hx, hz
  have xzZ := meet.lower_right with lattice, hx, hz
  have xyYZ := transitive with meet(A, r, x, y), xyA, y, hy, join(A, r, y, z),
      yzA, xyY, yYZ
  have xzYZ := transitive with meet(A, r, x, z), xzA, z, hz, join(A, r, y, z),
      yzA, xzZ, zYZ
  have xyT := meet.greatest with lattice, hx, yzA, xyA, xyX, xyYZ
  have xzT := meet.greatest with lattice, hx, yzA, xzA, xzX, xzYZ
  exact join.least with lattice, xyA, xzA, targetA, xyT, xzT

theorem join.meet_distributive_ge (A r x y z : Set)
  requires lattice : IsLattice(A, r)
  requires hx : x ∈ A
  requires hy : y ∈ A
  requires hz : z ∈ A
  shows relates(r, join(A, r, x, meet(A, r, y, z)),
    meet(A, r, join(A, r, x, y), join(A, r, x, z)))
proof
  have transitive := IsLattice.transitive with lattice
  have xyA := join.member with lattice, hx, hy
  have xzA := join.member with lattice, hx, hz
  have yzA := meet.member with lattice, hy, hz
  have targetA := meet.member with lattice, xyA, xzA
  have xXY := join.upper_left with lattice, hx, hy
  have xXZ := join.upper_left with lattice, hx, hz
  have yXY := join.upper_right with lattice, hx, hy
  have zXZ := join.upper_right with lattice, hx, hz
  have yzY := meet.lower_left with lattice, hy, hz
  have yzZ := meet.lower_right with lattice, hy, hz
  have xT := meet.greatest with lattice, xyA, xzA, hx, xXY, xXZ
  have yzXY := transitive with meet(A, r, y, z), yzA, y, hy, join(A, r, x, y),
      xyA, yzY, yXY
  have yzXZ := transitive with meet(A, r, y, z), yzA, z, hz, join(A, r, x, z),
      xzA, yzZ, zXZ
  have yzT := meet.greatest with lattice, xyA, xzA, yzA, yzXY, yzXZ
  exact join.least with lattice, hx, yzA, targetA, xT, yzT

theorem join.modular_le (A r x y z : Set)
  requires lattice : IsLattice(A, r)
  requires hx : x ∈ A
  requires hy : y ∈ A
  requires hz : z ∈ A
  requires hyx : relates(r, y, x)
  shows
    relates(r, join(A, r, y, meet(A, r, x, z)), meet(A, r, x, join(A, r, y, z)))
proof
  have transitive := IsLattice.transitive with lattice
  have xzA := meet.member with lattice, hx, hz
  have yzA := join.member with lattice, hy, hz
  have targetA := meet.member with lattice, hx, yzA
  have yYZ := join.upper_left with lattice, hy, hz
  have zYZ := join.upper_right with lattice, hy, hz
  have xzX := meet.lower_left with lattice, hx, hz
  have xzZ := meet.lower_right with lattice, hx, hz
  have yT := meet.greatest with lattice, hx, yzA, hy, hyx, yYZ
  have xzYZ := transitive with meet(A, r, x, z), xzA, z, hz, join(A, r, y, z),
      yzA, xzZ, zYZ
  have xzT := meet.greatest with lattice, hx, yzA, xzA, xzX, xzYZ
  exact join.least with lattice, hy, xzA, targetA, yT, xzT
