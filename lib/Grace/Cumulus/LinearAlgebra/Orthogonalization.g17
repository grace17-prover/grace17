module Grace.Cumulus.LinearAlgebra.Orthogonalization
import Projection

-- Removing a component along v leaves every inner product with a direction
-- perpendicular to v unchanged. No nonzero-norm premise is needed here.
theorem dotProduct.after_orthogonal_removal (u v w : Set, n : Nat)
  requires sequenceU : RealSequence(u)
  requires sequenceV : RealSequence(v)
  requires sequenceW : RealSequence(w)
  requires perpendicular : Orthogonal(v, w, n)
  shows dotProduct(orthogonalResidual(u, v, n), w, n) = dotProduct(u, w, n)
proof
  unfold Orthogonal at perpendicular
  unfold orthogonalResidual
  rw dotProduct.sub_left
  unfold lineProjection
  rw [dotProduct.scale_left, perpendicular]
  ring

theorem orthogonalResidual.preserve_orthogonal (u v w : Set, n : Nat)
  requires sequenceU : RealSequence(u)
  requires sequenceV : RealSequence(v)
  requires sequenceW : RealSequence(w)
  requires old : Orthogonal(u, w, n)
  requires directions : Orthogonal(v, w, n)
  shows Orthogonal(orthogonalResidual(u, v, n), w, n)
proof
  unfold Orthogonal at old
  unfold Orthogonal
  rwa dotProduct.after_orthogonal_removal

theorem projectionCoefficient.after_orthogonal_removal (u v w : Set, n : Nat)
  requires sequenceU : RealSequence(u)
  requires sequenceV : RealSequence(v)
  requires sequenceW : RealSequence(w)
  requires perpendicular : Orthogonal(v, w, n)
  shows projectionCoefficient(orthogonalResidual(u, v, n), w, n) = projectionCoefficient(u, w, n)
proof
  have unchanged := dotProduct.after_orthogonal_removal at u, v, w, n with *
  unfold projectionCoefficient
  rfl

theorem lineProjection.after_orthogonal_removal (u v w : Set, n : Nat)
  requires sequenceU : RealSequence(u)
  requires sequenceV : RealSequence(v)
  requires sequenceW : RealSequence(w)
  requires perpendicular : Orthogonal(v, w, n)
  shows lineProjection(orthogonalResidual(u, v, n), w, n) = lineProjection(u, w, n)
proof
  have unchanged := projectionCoefficient.after_orthogonal_removal at u, v, w, n with *
  unfold lineProjection
  rfl

theorem orthogonalResidual.orthogonal_pair (u v w : Set, n : Nat)
  requires sequenceU : RealSequence(u)
  requires sequenceV : RealSequence(v)
  requires sequenceW : RealSequence(w)
  requires nonzeroV : squaredNorm(v, n) ≠ (0:R)
  requires nonzeroW : squaredNorm(w, n) ≠ (0:R)
  requires perpendicular : Orthogonal(v, w, n)
  shows Orthogonal(orthogonalResidual(orthogonalResidual(u, v, n), w, n), v, n) ∧
    Orthogonal(orthogonalResidual(orthogonalResidual(u, v, n), w, n), w, n)
proof
  have firstOrthogonal := orthogonalResidual.orthogonal at u, v, n with *
  have symmetric := Orthogonal.symmetric at v, w, n with *
  constructor
  . exact orthogonalResidual.preserve_orthogonal with *
  . exact orthogonalResidual.orthogonal with *

theorem orthogonalResidual.two_step_reconstruction (u v w : Set, n i : Nat)
  requires sequenceU : RealSequence(u)
  requires sequenceV : RealSequence(v)
  requires sequenceW : RealSequence(w)
  requires perpendicular : Orthogonal(v, w, n)
  shows u[i] = (lineProjection(u, v, n)[i]:R) + (lineProjection(u, w, n)[i]:R) +
    (orthogonalResidual(orthogonalResidual(u, v, n), w, n)[i]:R)
proof
  have firstReconstruction := orthogonalResidual.reconstruction at u, v, n, i with *
  have secondReconstruction := orthogonalResidual.reconstruction at orthogonalResidual(u, v, n), w, n, i with *
  have unchanged := lineProjection.after_orthogonal_removal at u, v, w, n with *
  rw unchanged at secondReconstruction
  linear_combination firstReconstruction + secondReconstruction

theorem orthogonalResidual.two_step_pythagorean (u v w : Set, n : Nat)
  requires sequenceU : RealSequence(u)
  requires sequenceV : RealSequence(v)
  requires sequenceW : RealSequence(w)
  requires nonzeroV : squaredNorm(v, n) ≠ (0:R)
  requires nonzeroW : squaredNorm(w, n) ≠ (0:R)
  requires perpendicular : Orthogonal(v, w, n)
  shows squaredNorm(u, n) = squaredNorm(lineProjection(u, v, n), n) +
    squaredNorm(lineProjection(u, w, n), n) +
    squaredNorm(orthogonalResidual(orthogonalResidual(u, v, n), w, n), n)
proof
  have firstPythagorean := orthogonalResidual.pythagorean at u, v, n with *
  have secondPythagorean := orthogonalResidual.pythagorean at orthogonalResidual(u, v, n), w, n with *
  have unchanged := lineProjection.after_orthogonal_removal at u, v, w, n with *
  rw unchanged at secondPythagorean
  linear_combination firstPythagorean + secondPythagorean

theorem orthogonalResidual.commute (u v w : Set, n i : Nat)
  requires sequenceU : RealSequence(u)
  requires sequenceV : RealSequence(v)
  requires sequenceW : RealSequence(w)
  requires perpendicular : Orthogonal(v, w, n)
  shows orthogonalResidual(orthogonalResidual(u, v, n), w, n)[i] =
    orthogonalResidual(orthogonalResidual(u, w, n), v, n)[i]
proof
  have symmetric := Orthogonal.symmetric with *
  have forward := orthogonalResidual.two_step_reconstruction at u, v, w, n, i with *
  have backward := orthogonalResidual.two_step_reconstruction at u, w, v, n, i with *
  linear_combination backward - forward

-- Bessel's inequality for two perpendicular, not necessarily unit, directions.
-- The captured squared lengths cannot exceed the original squared length.
theorem lineProjection.bessel_pair (u v w : RealSequence, n : Nat)
  requires nonzeroV : squaredNorm(v, n) ≠ (0:R)
  requires nonzeroW : squaredNorm(w, n) ≠ (0:R)
  requires perpendicular : Orthogonal(v, w, n)
  shows squaredNorm(lineProjection(u, v, n), n) +
    squaredNorm(lineProjection(u, w, n), n) ≤ squaredNorm(u, n)
proof
  have decomposition := orthogonalResidual.two_step_pythagorean at u, v, w, n with *
  have remainderNonnegative := squaredNorm.nonnegative at orthogonalResidual(orthogonalResidual(u, v, n), w, n), n with *
  rw decomposition
  linarith
