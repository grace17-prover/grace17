-- The sum of divisors σ(n) = ∑_{d ∣ n} d: its values at 0, 1, and a prime,
-- the split σ(n) = n + 1 + (sum over the divisors strictly between), the
-- characterisation of primes by σ(p) = p + 1, and multiplicativity
-- σ(m · n) = σ(m) · σ(n) for coprime m and n through the bijection
-- (d, e) ↦ d · e from divisors(m) × divisors(n) onto divisors(m · n)
-- Part of Cumulus, the Grace17 mathematics library.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module Grace.Cumulus.NumberTheory.DivisorSum
import Cardinal.NaturalSumLaws
import Divisors
import LCM

-- The identity on ℕ as the weight of a divisor.
theorem identityWeight.natural (d : Nat)
  shows identity(ℕ)(d) ∈ ℕ
proof
  have dNat : Nat(d) by typecheck
  have dIn := nat.omega.forward with dNat
  have value := identity.apply at d, ℕ with dIn
  rw value
  exact dIn

theorem identityWeight.value (d : Nat)
  shows identity(ℕ)(d) = d
proof
  have dNat : Nat(d) by typecheck
  have dIn := nat.omega.forward with dNat
  exact identity.apply at d, ℕ with dIn

theorem divisors.weights (n : Nat)
  shows ∀ d ∈ divisors(n), identity(ℕ)(d) ∈ ℕ
proof
  intros d hd
  have dNat := divisors.natural with hd
  exact identityWeight.natural at d

-- The sum of the divisors.
def sigma (n : Nat) : Nat := natSum(divisors(n), identity(ℕ))
proof
  have finite := divisors.finite at n
  have weights := divisors.weights at n
  unfold sigma
  exact natSum.natural with finite, weights

theorem sigma.definition (n : Nat)
  shows sigma(n) = natSum(divisors(n), identity(ℕ))
proof
  simp [sigma]

theorem sigma.natural (n : Nat)
  shows Nat(sigma(n))
proof
  typecheck

theorem sigma.zero
  shows sigma(0) = 0
proof
  have weight := identityWeight.natural at 0
  have value := identityWeight.value at 0
  have single := natSum.singleton with weight
  rw [sigma.definition, divisors.zero, single, value]
  rfl

theorem sigma.one
  shows sigma(1) = 1
proof
  have weight := identityWeight.natural at 1
  have value := identityWeight.value at 1
  have single := natSum.singleton with weight
  rw [sigma.definition, divisors.one, single, value]
  rfl

theorem sigma.prime (p : Nat)
  requires prime : Prime(p)
  shows sigma(p) = p + 1
proof
  have same := divisors.prime with prime
  have aboveOne := Prime.greater_than_one with prime
  have distinct : 1 ≠ p
    intro equal
    rw ← equal at aboveOne
    exact Less.irreflexive at 1 with aboveOne
  have weightOne := identityWeight.natural at 1
  have weightP := identityWeight.natural at p
  have valueOne := identityWeight.value at 1
  have valueP := identityWeight.value at p
  have paired := natSum.pair with weightOne, weightP, distinct
  rw [sigma.definition, same, paired, valueOne, valueP]
  exact add.commutative at p, 1

-- The divisors strictly between 1 and n.
def innerDivisors (n : Nat) : Set := divisors(n) ∖ {1, n}

theorem innerDivisors.membership (n : Nat, d : Set)
  shows d ∈ innerDivisors(n) ↔ d ∈ divisors(n) ∧ ¬(d = 1 ∨ d = n)
proof
  simp [innerDivisors, difference.membership, pair.membership]

theorem innerDivisors.subset (n : Nat)
  shows innerDivisors(n) ⊆ divisors(n)
proof
  intros d hd
  have parts := innerDivisors.membership.forward with hd
  exact parts.left

theorem innerDivisors.finite (n : Nat)
  shows Finite(innerDivisors(n))
proof
  have finite := divisors.finite at n
  have subset := innerDivisors.subset at n
  exact Finite.subset with finite, subset

theorem innerDivisors.weights (n : Nat)
  shows ∀ d ∈ innerDivisors(n), identity(ℕ)(d) ∈ ℕ
proof
  intros d hd
  have subset := innerDivisors.subset at n
  have member := subset with d, hd
  have dNat := divisors.natural with member
  exact identityWeight.natural at d

-- The sum of the divisors strictly between 1 and n.
def innerSum (n : Nat) : Nat := natSum(innerDivisors(n), identity(ℕ))
proof
  have finite := innerDivisors.finite at n
  have weights := innerDivisors.weights at n
  unfold innerSum
  exact natSum.natural with finite, weights

theorem innerSum.definition (n : Nat)
  shows innerSum(n) = natSum(innerDivisors(n), identity(ℕ))
proof
  simp [innerSum]

theorem innerDivisors.disjoint (n : Nat)
  shows Disjoint({1, n}, innerDivisors(n))
proof
  apply Disjoint.iff.backward
  intros d hd inside
  have parts := innerDivisors.membership.forward with inside
  have alternatives := pair.membership.forward with hd
  exact parts.right with alternatives

theorem divisors.split (n : Nat)
  requires nonzero : n ≠ 0
  shows divisors(n) = {1, n} ∪ innerDivisors(n)
proof
  have oneMember := divisors.one_member at n with nonzero
  have selfMember := divisors.self_member at n
  ext d
  constructor
  . intro member
    have decided : d = 1 ∨ d = n ∨ ¬(d = 1 ∨ d = n) by tauto
    apply union2.membership.backward
    rcases decided with one | self | neither
    . left
      rw one
      exact pair.left at 1, n
    . left
      rw self
      exact pair.right at 1, n
    . right
      exact innerDivisors.membership.backward with ⟨member, neither⟩
  . intro member
    have split := union2.membership.forward with member
    cases split with inPair | inner
    . have alternatives := pair.membership.forward with inPair
      cases alternatives with one | self
      . rw one
        exact oneMember
      . rw self
        exact selfMember
    . have parts := innerDivisors.membership.forward with inner
      exact parts.left

-- σ(n) = n + 1 + the sum of the divisors strictly between.
theorem sigma.split (n : Nat)
  requires aboveOne : 1 < n
  shows sigma(n) = n + 1 + innerSum(n)
proof
  have positive : 0 < n by arith
  have nonzero := Less.ne_zero_of_positive with positive
  have split := divisors.split with nonzero
  have distinct : 1 ≠ n
    intro equal
    rw ← equal at aboveOne
    exact Less.irreflexive at 1 with aboveOne
  have oneMember := divisors.one_member at n with nonzero
  have selfMember := divisors.self_member at n
  have characterization := pair.subset_iff at 1, n, divisors(n)
  have pairSubset := characterization.backward with ⟨oneMember, selfMember⟩
  have finite := divisors.finite at n
  have finitePair := Finite.subset with finite, pairSubset
  have finiteInner := innerDivisors.finite at n
  have weights := divisors.weights at n
  have weightsPair : ∀ d ∈ {1, n}, identity(ℕ)(d) ∈ ℕ
    intros d hd
    exact weights with d, (pairSubset with d, hd)
  have weightsInner := innerDivisors.weights at n
  have disjoint := innerDivisors.disjoint at n
  have added := natSum.union_disjoint with finitePair, finiteInner, weightsPair,
    weightsInner, disjoint
  have weightOne := identityWeight.natural at 1
  have weightN := identityWeight.natural at n
  have valueOne := identityWeight.value at 1
  have valueN := identityWeight.value at n
  have paired := natSum.pair with weightOne, weightN, distinct
  have innerNat := natSum.natural with finiteInner, weightsInner
  have swapped : 1 + n = n + 1 := add.commutative at n, 1
  rw [sigma.definition, innerSum.definition, split, added, paired, valueOne,
    valueN, swapped]
  rfl

theorem innerDivisors.le_sum (n d : Nat)
  requires member : d ∈ innerDivisors(n)
  shows d ≤ innerSum(n)
proof
  rw innerSum.definition
  have finite := innerDivisors.finite at n
  have weights := innerDivisors.weights at n
  have characterization := singleton.subset_iff at d, innerDivisors(n)
  have single := characterization.backward with member
  have bounded := natSum.monotone with finite, single, weights
  have weight := identityWeight.natural at d
  have value := identityWeight.value at d
  have point := natSum.singleton with weight
  rw [point, value] at bounded
  exact bounded

theorem innerDivisors.two_le (n d : Nat)
  requires nonzero : n ≠ 0
  requires member : d ∈ innerDivisors(n)
  shows 2 ≤ d
proof
  have parts := innerDivisors.membership.forward with member
  have factor := divisors.divides with parts.left
  have dNonzero := divides.nonzero with factor, nonzero
  have notOne : d ≠ 1
    intro one
    apply parts.right
    left
    exact one
  have characterization := Less.one_lt_iff at d
  have aboveOne := characterization.backward with ⟨dNonzero, notOne⟩
  arith

theorem innerDivisors.member (n d : Nat)
  requires nonzero : n ≠ 0
  requires factor : d ∣ n
  requires notOne : d ≠ 1
  requires notSelf : d ≠ n
  shows d ∈ innerDivisors(n)
proof
  have below := divides.le with factor, nonzero
  have characterization := divisors.membership_le at n, d
  have member := characterization.backward with ⟨below, factor⟩
  have neither : ¬(d = 1 ∨ d = n)
    intro either
    cases either with one | self
    . exact notOne with one
    . exact notSelf with self
  exact innerDivisors.membership.backward with ⟨member, neither⟩

-- A number above 1 with σ(n) = n + 1 has no divisor strictly between.
theorem Prime.of_sigma (n : Nat)
  requires aboveOne : 1 < n
  requires sum : sigma(n) = n + 1
  shows Prime(n)
proof
  have positive : 0 < n by arith
  have nonzero := Less.ne_zero_of_positive with positive
  have split := sigma.split with aboveOne
  rw sum at split
  have bounded : innerSum(n) ≤ 0 by arith
  have innerZero := LessEqual.eq_zero with bounded
  have innerEmpty : innerDivisors(n) = ∅
    ext d
    constructor
    . intro member
      have subset := innerDivisors.subset at n
      have dNat := divisors.natural with (subset with d, member)
      have twoLe := innerDivisors.two_le with nonzero, member
      have bound := innerDivisors.le_sum with member
      rw innerZero at bound
      exfalso
      arith
    . intro member
      exfalso
      exact empty.membership with d, member
  have decomposed := divisors.split with nonzero
  rw [innerEmpty, union2.right_empty] at decomposed
  exact Prime.of_divisors with aboveOne, decomposed

theorem sigma.prime_iff (p : Nat)
  requires aboveOne : 1 < p
  shows Prime(p) ↔ sigma(p) = p + 1
proof
  constructor
  . intro prime
    exact sigma.prime with prime
  . intro sum
    exact Prime.of_sigma with aboveOne, sum

-- Divisors of coprime numbers are coprime.
theorem coprime.of_divides (a b d e : Nat)
  requires coprime : gcd(a, b) = 1
  requires left : d ∣ a
  requires right : e ∣ b
  shows gcd(d, e) = 1
proof
  have characterization := gcd.eq_one_iff at d, e
  apply characterization.backward
  intros k kNat kd ke
  have ka := divides.transitive with kd, left
  have kb := divides.transitive with ke, right
  exact coprime.divisor_one with coprime, ka, kb

-- A divisor of a coprime product is the product of its parts in each
-- factor.
theorem divides.coprime_split (a b d : Nat)
  requires nonzeroA : a ≠ 0
  requires nonzeroB : b ≠ 0
  requires coprime : gcd(a, b) = 1
  requires factor : d ∣ a * b
  shows d = gcd(d, a) * gcd(d, b)
proof
  have gNonzero := gcd.nonzero_right at d, a with nonzeroA
  have gNat := gcd.natural at d, a
  have hNat := gcd.natural at d, b
  have gDividesD := gcd.divides_left at d, a
  have gDividesA := gcd.divides_right at d, a
  have hDividesD := gcd.divides_left at d, b
  have hDividesB := gcd.divides_right at d, b
  obtain ⟨e, eNat, dProduct⟩ := gDividesD
  obtain ⟨p, pNat, aProduct⟩ := gDividesA
  have cofactors := gcd.cofactor_coprime at d, a, e, p with gNonzero, dProduct,
    aProduct
  have rearranged : gcd(d, a) * p * b = gcd(d, a) * (p * b) by ring
  have expanded : a * b = gcd(d, a) * (p * b) by cc
  have scaled : gcd(d, a) * e ∣ gcd(d, a) * (p * b)
    rw [dProduct, ← expanded]
    exact factor
  have cancel := divides.mul_cancel_left at gcd(d, a), e, p * b with gNonzero
  have eDivides := cancel.forward with scaled
  have commuted : p * b = b * p by ring
  rw commuted at eDivides
  have coprimePE := coprime.symmetric with cofactors
  have eDividesB := coprime.cancel_right with coprimePE, eDivides
  have eDividesD := divides.mul_right_self at e, gcd(d, a)
  rw dProduct at eDividesD
  have eDividesH := gcd.greatest with eDividesD, eDividesB
  have gSelf := divides.reflexive at gcd(d, a)
  have forward := divides.mul_mono with gSelf, eDividesH
  rw dProduct at forward
  have gDividesD2 := gcd.divides_left at d, a
  have coprimeGH := coprime.of_divides with coprime, gDividesA, hDividesB
  have backward := coprime.mul_divides with coprimeGH, gDividesD2, hDividesD
  exact divides.antisymmetric with forward, backward

-- The product (d, e) ↦ d · e of a divisor of a and a divisor of b.
defgraph divisorMul (a b : Nat) (q ∈ divisors(a) × divisors(b)) :
    divisors(a * b) := mul(fst(q), snd(q))
requires nonzeroA : a ≠ 0
requires nonzeroB : b ≠ 0
proof
  obtain ⟨bound, d, hd, e, he, shape⟩ :=
    product.membership.forward with member
  have dNat := divisors.natural with hd
  have eNat := divisors.natural with he
  have dDivides := divisors.divides with hd
  have eDivides := divisors.divides with he
  have productDivides := divides.mul_mono with dDivides, eDivides
  have productNonzero := mul.nonzero with nonzeroA, nonzeroB
  have below := divides.le with productDivides, productNonzero
  have characterization := divisors.membership_le at a * b, mul(d, e)
  rw [shape, fst.pair, snd.pair]
  exact characterization.backward with ⟨below, productDivides⟩

theorem divisorMul.pair (a b : Nat) (d e : Set)
  requires nonzeroA : a ≠ 0
  requires nonzeroB : b ≠ 0
  requires hd : d ∈ divisors(a)
  requires he : e ∈ divisors(b)
  shows divisorMul(a, b)((d, e)) = mul(d, e)
proof
  have pairMember := product.pair with hd, he
  have value := divisorMul.value at a, b, (d, e) with nonzeroA, nonzeroB,
    pairMember
  rw [value, fst.pair, snd.pair]
  rfl

theorem divisorMul.injective (a b : Nat)
  requires nonzeroA : a ≠ 0
  requires nonzeroB : b ≠ 0
  requires coprime : gcd(a, b) = 1
  shows InjectiveBetween(divisorMul(a, b), divisors(a) × divisors(b),
    divisors(a * b))
proof
  have function := divisorMul.function at a, b with nonzeroA, nonzeroB
  refine ⟨function, _⟩
  intros x hx y hy z hz relatesX relatesY
  obtain ⟨boundX, d1, hd1, d2, hd2, xEq⟩ :=
    product.membership.forward with hx
  obtain ⟨boundY, e1, he1, e2, he2, yEq⟩ :=
    product.membership.forward with hy
  have d1Nat := divisors.natural with hd1
  have d2Nat := divisors.natural with hd2
  have e1Nat := divisors.natural with he1
  have e2Nat := divisors.natural with he2
  have d1Divides := divisors.divides with hd1
  have d2Divides := divisors.divides with hd2
  have e1Divides := divisors.divides with he1
  have e2Divides := divisors.divides with he2
  have valueX := FunctionBetween.apply_value with function, hx, relatesX
  have valueY := FunctionBetween.apply_value with function, hy, relatesY
  have pairX := divisorMul.pair with nonzeroA, nonzeroB, hd1, hd2
  have pairY := divisorMul.pair with nonzeroA, nonzeroB, he1, he2
  rw xEq at valueX
  rw yEq at valueY
  have same : mul(d1, d2) = mul(e1, e2) by cc
  have d1DividesProduct : d1 ∣ mul(e1, e2)
    rw ← same
    exact divides.mul_left_self at d1, d2
  have e1DividesProduct : e1 ∣ mul(d1, d2)
    rw same
    exact divides.mul_left_self at e1, e2
  have coprimeD1E2 := coprime.of_divides with coprime, d1Divides, e2Divides
  have coprimeE2D1 := coprime.symmetric with coprimeD1E2
  have d1DividesE1 := coprime.cancel_right with coprimeE2D1, d1DividesProduct
  have coprimeE1D2 := coprime.of_divides with coprime, e1Divides, d2Divides
  have coprimeD2E1 := coprime.symmetric with coprimeE1D2
  have e1DividesD1 := coprime.cancel_right with coprimeD2E1, e1DividesProduct
  have firstEqual := divides.antisymmetric with d1DividesE1, e1DividesD1
  have e1Nonzero := divides.nonzero with e1Divides, nonzeroA
  rw firstEqual at same
  have secondEqual := mul.left_cancel_positive with e1Nonzero, same
  rw [xEq, yEq, firstEqual, secondEqual]
  rfl

theorem divisorMul.surjective (a b : Nat)
  requires nonzeroA : a ≠ 0
  requires nonzeroB : b ≠ 0
  requires coprime : gcd(a, b) = 1
  shows SurjectiveBetween(divisorMul(a, b), divisors(a) × divisors(b),
    divisors(a * b))
proof
  have function := divisorMul.function at a, b with nonzeroA, nonzeroB
  refine ⟨function, _⟩
  intros z hz
  have zNat := divisors.natural with hz
  have factor := divisors.divides with hz
  have split := divides.coprime_split with nonzeroA, nonzeroB, coprime, factor
  have gNat := gcd.natural at z, a
  have hNat := gcd.natural at z, b
  have gDividesA := gcd.divides_right at z, a
  have hDividesB := gcd.divides_right at z, b
  have gBelow := divides.le with gDividesA, nonzeroA
  have hBelow := divides.le with hDividesB, nonzeroB
  have characterizationA := divisors.membership_le at a, gcd(z, a)
  have characterizationB := divisors.membership_le at b, gcd(z, b)
  have inA := characterizationA.backward with ⟨gBelow, gDividesA⟩
  have inB := characterizationB.backward with ⟨hBelow, hDividesB⟩
  have pairMember := product.pair with inA, inB
  have value := divisorMul.pair with nonzeroA, nonzeroB, inA, inB
  have relates := FunctionBetween.relates_apply with function, pairMember
  rw [value, ← split] at relates
  exact ⟨(gcd(z, a), gcd(z, b)), pairMember, relates⟩

-- The divisors of a coprime product are the products of divisors of the
-- factors, each exactly once.
theorem divisorMul.bijective (a b : Nat)
  requires nonzeroA : a ≠ 0
  requires nonzeroB : b ≠ 0
  requires coprime : gcd(a, b) = 1
  shows BijectiveBetween(divisorMul(a, b), divisors(a) × divisors(b),
    divisors(a * b))
proof
  have injective := divisorMul.injective with nonzeroA, nonzeroB, coprime
  have surjective := divisorMul.surjective with nonzeroA, nonzeroB, coprime
  exact ⟨injective, surjective⟩

theorem sigma.multiplicative_of_nonzero (m n : Nat)
  requires nonzeroM : m ≠ 0
  requires nonzeroN : n ≠ 0
  requires coprime : gcd(m, n) = 1
  shows sigma(m * n) = sigma(m) * sigma(n)
proof
  have finiteM := divisors.finite at m
  have finiteN := divisors.finite at n
  have finitePairs := Finite.product with finiteM, finiteN
  have weightsM := divisors.weights at m
  have weightsN := divisors.weights at n
  have weightsProduct := divisors.weights at m * n
  have bijective := divisorMul.bijective with nonzeroM, nonzeroN, coprime
  have values : ∀ q ∈ divisors(m) × divisors(n),
      weightProduct(divisors(m), divisors(n), identity(ℕ), identity(ℕ))(q) =
        identity(ℕ)(divisorMul(m, n)(q))
    intros q hq
    obtain ⟨bound, d, hd, e, he, shape⟩ :=
      product.membership.forward with hq
    have dNat := divisors.natural with hd
    have eNat := divisors.natural with he
    have left := weightProduct.pair with weightsM, weightsN, hd, he
    have right := divisorMul.pair with nonzeroM, nonzeroN, hd, he
    have valueD := identityWeight.value at d
    have valueE := identityWeight.value at e
    have valueDE := identityWeight.value at mul(d, e)
    rw [shape, left, right, valueD, valueE, valueDE]
    rfl
  have reindexed := natSum.reindex with finitePairs, bijective, weightsProduct,
    values
  have product := natSum.product with finiteM, finiteN, weightsM, weightsN
  rw [sigma.definition, sigma.definition, sigma.definition, reindexed, product]
  rfl

-- σ is multiplicative.
theorem sigma.multiplicative (m n : Nat)
  requires coprime : gcd(m, n) = 1
  shows sigma(m * n) = sigma(m) * sigma(n)
proof
  have casesM : m = 0 ∨ m ≠ 0 by tauto
  have casesN : n = 0 ∨ n ≠ 0 by tauto
  cases casesM with mZero | mNonzero
  . have nOne : n = 1
      rw [mZero, gcd.zero_left] at coprime
      exact coprime
    rw [mZero, nOne, mul.left_zero, sigma.zero, sigma.one, mul.left_zero]
    rfl
  . cases casesN with nZero | nNonzero
    . have mOne : m = 1
        rw [nZero, gcd.zero_right] at coprime
        exact coprime
      rw [nZero, mOne, mul.right_zero, sigma.zero, sigma.one, mul.right_zero]
      rfl
    . exact sigma.multiplicative_of_nonzero with mNonzero, nNonzero, coprime
