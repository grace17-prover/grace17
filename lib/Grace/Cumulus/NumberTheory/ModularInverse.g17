-- Every residue coprime to n has a multiplicative inverse mod n: scaling the
-- residues below n by a is injective, so by counting it is onto, and some
-- residue is sent to one
-- Part of Cumulus, the Grace17 mathematics library.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module Grace.Cumulus.NumberTheory.ModularInverse
import CoprimeCancel
import Cardinal

-- Multiplication by a on the residues below n.
defgraph scaleMod (a n : Nat) (x ∈ n) : n := mod(mul(a, x), n)
requires nonzero : n ≠ 0
proof
  have xNat := natural.member at n with member
  have bound := mod.less at a * x, n with nonzero
  exact membership.of_Less at (a * x) % n, n with *, *, bound

theorem scaleMod.injective (a n : Nat)
  requires nonzero : n ≠ 0
  requires coprime : gcd(a, n) = 1
  shows InjectiveBetween(scaleMod(a, n), n, n)
proof
  have function := scaleMod.function at a, n with nonzero
  constructor
  . exact function
  . intros x hx y hy z hz hxz hyz
    have xValue := FunctionBetween.apply_value with function, hx, hxz
    have yValue := FunctionBetween.apply_value with function, hy, hyz
    have xScaled := scaleMod.value at a, n, x with *
    have yScaled := scaleMod.value at a, n, y with *
    have xNat := natural.member at n with hx
    have yNat := natural.member at n with hy
    have same : (a * x) % n = (a * y) % n
      rw [← xScaled, ← yScaled, xValue, yValue]
      rfl
    have residues := coprime.mul_cancel_mod with nonzero, coprime, same
    have xBelow := Less.of_membership with hx
    have yBelow := Less.of_membership with hy
    have xSelf := mod.of_less with xBelow
    have ySelf := mod.of_less with yBelow
    rwa [xSelf, ySelf] at residues

theorem scaleMod.onto (a n : Nat)
  requires nonzero : n ≠ 0
  requires coprime : gcd(a, n) = 1
  shows functionImage(scaleMod(a, n), n, n) = n
proof
  have injective := scaleMod.injective with nonzero, coprime
  have finite := Finite.natural at n
  have subset : functionImage(scaleMod(a, n), n, n) ⊆ n
    intros y hy
    have parts := functionImage.membership.forward with hy
    exact parts.left
  have reflexive : n ⊆ n
    intros y hy
    exact hy
  have same := cardinality.injective_image with injective, reflexive, finite
  exact cardinality.eq_subset with finite, subset, same

theorem coprime.inverse (a n : Nat)
  requires aboveOne : 1 < n
  requires coprime : gcd(a, n) = 1
  shows ∃ b, Nat(b) ∧ b < n ∧ (a * b) % n = 1
proof
  have nonzero : n ≠ 0
    intro zero
    rw zero at aboveOne
    have impossible : ¬(1:N) < 0 by arith
    exact impossible with aboveOne
  have onto := scaleMod.onto with nonzero, coprime
  have oneIn : (1:N) ∈ n by exact membership.of_Less at (1:N), n with *, *, aboveOne
  rw ← onto at oneIn
  have parts := functionImage.membership.forward with oneIn
  obtain ⟨b, hb, equation⟩ := parts.right
  have bNat := natural.member at n with hb
  have value := scaleMod.value at a, n, b with *
  witness b
  constructor
  . exact Less.of_membership with hb
  . rw [value] at equation
    symm at equation
    exact equation
