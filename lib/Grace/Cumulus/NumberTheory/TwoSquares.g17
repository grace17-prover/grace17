-- Authors: Grant Passmore

module Grace.Cumulus.NumberTheory.TwoSquares
import Grace.Cumulus.NumberTheory.Thue
import Grace.Cumulus.NumberTheory.EulerCriterion
import Grace.Cumulus.NumberTheory.PerfectSquares

-- The square sum of Thue's pair

-- p = 4j + 1 is 2h + 1 with h = 2j even.
theorem Prime.one_mod_four_half (p : Nat)
  requires prime : Prime(p)
  requires residue : p % 4 = 1
  shows ∃ h, Nat(h) ∧ p = 2 * h + 1 ∧ Even(h)
proof
  have four : 4 ≠ 0 by arith
  obtain ⟨j, jNat, shape⟩ := mod.equation at p, 4 with four
  rw residue at shape
  have doubleNat : Nat(2 * j) by typecheck
  have even := Even.two_mul at j
  refine ⟨2 * j, doubleNat, ?_, even⟩
  rw shape
  ring

-- y² ≡ a² x² and a² + 1 ≡ 0 give x² + y² ≡ (a² + 1) x² ≡ 0.
theorem fermat.square_sum_of_congruent (a p x y : Nat)
  requires root : (a * a + 1) % p = 0
  requires squares : CongruentMod(y * y, a * x * (a * x), p)
  shows (x * x + y * y) % p = 0
proof
  have rootCongruent : CongruentMod(a * a + 1, 0, p)
    unfold CongruentMod
    rw mod.zero_left
    exact root
  have scaled := CongruentMod.mul_right at a * a + 1, 0, x * x
    with rootCongruent
  have shape : (a * a + 1) * (x * x) = x * x + a * x * (a * x) by ring
  have zeroShape : 0 * (x * x) = 0 by ring
  rw [shape, zeroShape] at scaled
  have added := CongruentMod.add_left at y * y, a * x * (a * x), x * x
    with squares
  have total := CongruentMod.transitive with added, scaled
  unfold CongruentMod at total
  rw mod.zero_left at total
  exact total

-- With a² + 1 ≡ 0, Thue's pair has x² + y² ≡ (1 + a²) x² ≡ 0 in either
-- sign case: y ≡ a x gives y² ≡ a² x² at once, and a x + y ≡ 0 gives
-- a x y + a² x² ≡ 0 ≡ a x y + y², so again y² ≡ a² x².
theorem fermat.square_sum_multiple (a p m x y : Nat)
  requires root : (a * a + 1) % p = 0
  requires congruent : (a * x) % p = y % p ∨ (a * x + y) % p = 0
  shows (x * x + y * y) % p = 0
proof
  cases congruent with plus | minus
  . have first : CongruentMod(a * x, y, p)
      unfold CongruentMod
      exact plus
    have squares := CongruentMod.mul with first, first
    have symmetric := CongruentMod.symmetric with squares
    exact fermat.square_sum_of_congruent with root, symmetric
  . have zero : CongruentMod(a * x + y, 0, p)
      unfold CongruentMod
      rw mod.zero_left
      exact minus
    have byX := CongruentMod.mul_right at a * x + y, 0, a * x with zero
    have byY := CongruentMod.mul_right at a * x + y, 0, y with zero
    have xShape : (a * x + y) * (a * x) = a * x * y + a * x * (a * x) by ring
    have yShape : (a * x + y) * y = a * x * y + y * y by ring
    have zeroX : 0 * (a * x) = 0 by ring
    have zeroY : 0 * y = 0 by ring
    rw [xShape, zeroX] at byX
    rw [yShape, zeroY] at byY
    have reverse := CongruentMod.symmetric with byY
    have both := CongruentMod.transitive with byX, reverse
    have squares := CongruentMod.add_left_cancel with both
    have symmetric := CongruentMod.symmetric with squares
    exact fermat.square_sum_of_congruent with root, symmetric

-- Fermat's theorem

-- 0 < x² + y² ≤ 2p with x, y < squareBound(p), and x² + y² = 2p would
-- make x² = y² = p a square; so the multiple of p is p itself.
theorem fermat.two_squares (p : Nat)
  requires prime : Prime(p)
  requires residue : p % 4 = 1
  shows ∃ a, Nat(a) ∧ ∃ b, Nat(b) ∧ a * a + b * b = p
proof
  obtain ⟨h, hNat, odd, even⟩ := Prime.one_mod_four_half with prime, residue
  obtain ⟨a, aNat, root⟩ := negOne.square with prime, odd, even
  have aboveOne := Prime.greater_than_one with prime
  have positive : 0 < p by arith
  have bound := squareBound.above at p
  have below := squareBound.le with aboveOne
  obtain ⟨x, xNat, y, yNat, xPositive, xLess, yLess, congruent⟩ :=
    thue.natural at a, p, squareBound(p) with positive, bound, below
  have multiple := fermat.square_sum_multiple at a, p, squareBound(p), x, y
    with root, congruent
  have xSquare := squareBound.least with xLess
  have ySquare := squareBound.least with yLess
  have squarePositive := Less.mul_positive with xPositive, xPositive
  have nonzero := Prime.nonzero with prime
  have characterization := mod.zero_iff at p, x * x + y * y with nonzero
  have divides := characterization.forward with multiple
  have definition := divides.definition at p, x * x + y * y
  obtain ⟨k, kNat, product⟩ := definition.forward with divides
  -- p k = x² + y² ≤ 2p, so k is at most 2.
  have kBelow : k < 3
    by_contra notBelow
    have threeLe : 3 ≤ k by arith
    have scaled := LessEqual.mul at p, p, 3, k with
      (LessEqual.reflexive at p), threeLe
    arith
  have alternatives := natural.below_three with kBelow
  rcases alternatives with zero | one | two
  . -- k = 0 contradicts 0 < x².
    exfalso
    rw zero at product
    have zeroShape : p * 0 = 0 by ring
    rw zeroShape at product
    arith
  . rw one at product
    have oneShape : p * 1 = p by ring
    rw oneShape at product
    refine ⟨x, xNat, y, yNat, ?_⟩
    symm
    exact product
  . -- k = 2 forces x² = p, but a prime is not a square.
    exfalso
    rw two at product
    have atLeast : p ≤ x * x by arith
    have same := LessEqual.antisymmetric with xSquare, atLeast
    have square := IsSquare.intro at x
    rw same at square
    have notSquare := Prime.not_square with prime
    exact notSquare with square

theorem Prime.sum_of_two_squares (p : Nat)
  requires prime : Prime(p)
  requires residue : p % 4 = 1
  shows SumOfTwoSquares(p)
proof
  obtain ⟨a, aNat, b, bNat, sum⟩ :=
    fermat.two_squares at p with prime, residue
  rw ← sum
  exact SumOfTwoSquares.intro at a, b

-- The converse for odd primes

-- An odd number is 1 or 3 modulo 4.
theorem Odd.mod_four (n : Nat)
  requires odd : Odd(n)
  shows n % 4 = 1 ∨ n % 4 = 3
proof
  have characterization := Odd.iff_two_mul_add_one at n
  obtain ⟨k, kNat, shape⟩ := characterization.forward with odd
  have two : 2 ≠ 0 by arith
  have four : 4 ≠ 0 by arith
  obtain ⟨q, qNat, split⟩ := mod.equation at k, 2 with two
  have cases := mod.two_cases at k
  cases cases with zero | one
  . left
    rw zero at split
    have form : n = 4 * q + 1 by ring [shape, split]
    have reduce := mod.multiple_add at 4, 1, q with four
    rw [form, reduce]
    compute
  . right
    rw one at split
    have form : n = 4 * q + 3 by ring [shape, split]
    have reduce := mod.multiple_add at 4, 3, q with four
    rw [form, reduce]
    compute

-- A prime other than 2 is odd: an even prime has the proper divisor 2.
theorem Prime.odd_of_not_two (p : Nat)
  requires prime : Prime(p)
  requires distinct : p ≠ 2
  shows Odd(p)
proof
  have parity := parity.exhaustive at p
  cases parity with even | odd
  . exfalso
    have characterization := divides.two_iff_even at p
    have divides := characterization.backward with even
    have nonzero := Prime.nonzero with prime
    have bound := divides.le at 2, p with divides, nonzero
    have alternatives := LessEqual.cases at 2, p with bound
    cases alternatives with strict | same
    . have twoNat : Nat(2) by typecheck
      have proper := membership.of_Less at 2, p with *, strict
      have one := Prime.divisor at p, 2 with prime, twoNat, proper, divides
      arith
    . apply distinct
      symm
      exact same
  . exact odd

-- An odd prime is 1 or 3 modulo 4, and a sum of two squares is never 3.
theorem Prime.sum_of_two_squares_iff (p : Nat)
  requires prime : Prime(p)
  requires odd : p ≠ 2
  shows SumOfTwoSquares(p) ↔ p % 4 = 1
proof
  constructor
  . intro sum
    have notThree := SumOfTwoSquares.mod_four with sum
    have oddPrime := Prime.odd_of_not_two at p with prime, odd
    have residues := Odd.mod_four with oddPrime
    cases residues with one | three
    . exact one
    . exfalso
      exact notThree with three
  . intro residue
    exact Prime.sum_of_two_squares with prime, residue
