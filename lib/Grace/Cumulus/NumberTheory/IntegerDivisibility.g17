-- Authors: Grant Passmore

module Grace.Cumulus.NumberTheory.IntegerDivisibility
import Coprime
import Int
import ModularMore

theorem IntegerDivides.intro (x y q : Integer)
  requires product : x * q = y
  shows IntegerDivides(x, y)
proof
  witness q
  exact product

theorem IntegerDivides.reflexive (x : Integer)
  shows IntegerDivides(x, x)
proof
  witness integerOne
  ring

theorem IntegerDivides.zero (x : Integer)
  shows IntegerDivides(x, integerZero)
proof
  witness integerZero
  ring

theorem IntegerDivides.one_left (x : Integer)
  shows IntegerDivides(integerOne, x)
proof
  witness x
  ring

theorem IntegerDivides.zero_left_iff (x : Integer)
  shows IntegerDivides(integerZero, x) ↔ x = 0
proof
  constructor
  . intro h
    obtain ⟨q, qInteger, equation⟩ := h
    have vanish : integerZero * q = 0 by ring
    rw ← equation
    exact vanish
  . intro zero
    rw zero
    exact IntegerDivides.zero at integerZero

theorem IntegerDivides.transitive (x y z : Integer)
  requires first : IntegerDivides(x, y)
  requires second : IntegerDivides(y, z)
  shows IntegerDivides(x, z)
proof
  obtain ⟨p, pInteger, pEquation⟩ := first
  obtain ⟨q, qInteger, qEquation⟩ := second
  witness p * q
  rw [← qEquation, ← pEquation]
  ring

theorem IntegerDivides.mul_right (x y z : Integer)
  requires hxy : IntegerDivides(x, y)
  shows IntegerDivides(x, y * z)
proof
  obtain ⟨q, qInteger, equation⟩ := hxy
  witness q * z
  rw ← equation
  ring

theorem IntegerDivides.mul_left (x y z : Integer)
  requires hxy : IntegerDivides(x, y)
  shows IntegerDivides(x, z * y)
proof
  obtain ⟨q, qInteger, equation⟩ := hxy
  witness z * q
  rw ← equation
  ring

theorem IntegerDivides.mul_left_self (x y : Integer)
  shows IntegerDivides(x, x * y)
proof
  witness y
  rfl

theorem IntegerDivides.mul_right_self (x y : Integer)
  shows IntegerDivides(x, y * x)
proof
  witness y
  ring

theorem IntegerDivides.add (d x y : Integer)
  requires left : IntegerDivides(d, x)
  requires right : IntegerDivides(d, y)
  shows IntegerDivides(d, x + y)
proof
  obtain ⟨p, pInteger, pEquation⟩ := left
  obtain ⟨q, qInteger, qEquation⟩ := right
  witness p + q
  rw [← pEquation, ← qEquation]
  ring

theorem IntegerDivides.neg_right (x y : Integer)
  requires hxy : IntegerDivides(x, y)
  shows IntegerDivides(x, -y)
proof
  obtain ⟨q, qInteger, equation⟩ := hxy
  witness -q
  rw ← equation
  ring

theorem IntegerDivides.sub (d x y : Integer)
  requires left : IntegerDivides(d, x)
  requires right : IntegerDivides(d, y)
  shows IntegerDivides(d, x - y)
proof
  obtain ⟨p, pInteger, pEquation⟩ := left
  obtain ⟨q, qInteger, qEquation⟩ := right
  witness p - q
  rw [← pEquation, ← qEquation]
  ring

theorem IntegerDivides.neg_right_iff (x y : Integer)
  shows IntegerDivides(x, -y) ↔ IntegerDivides(x, y)
proof
  constructor
  . intro h
    have doubled := IntegerDivides.neg_right at x, -y with h
    have involutive := integerNegValue.involutive at y
    rw involutive at doubled
    exact doubled
  . intro h
    exact IntegerDivides.neg_right at x, y with h

theorem IntegerDivides.neg_left (x y : Integer)
  requires hxy : IntegerDivides(x, y)
  shows IntegerDivides(-x, y)
proof
  obtain ⟨q, qInteger, equation⟩ := hxy
  witness -q
  rw ← equation
  ring

theorem IntegerDivides.neg_left_iff (x y : Integer)
  shows IntegerDivides(-x, y) ↔ IntegerDivides(x, y)
proof
  constructor
  . intro h
    have doubled := IntegerDivides.neg_left at -x, y with h
    have involutive := integerNegValue.involutive at x
    rw involutive at doubled
    exact doubled
  . intro h
    exact IntegerDivides.neg_left at x, y with h

theorem IntegerDivides.abs_left_iff (x y : Integer)
  shows IntegerDivides(integerAbs(x), y) ↔ IntegerDivides(x, y)
proof
  have left := IntegerDivides.magnitude_iff at integerAbs(x), y
  have right := IntegerDivides.magnitude_iff at x, y
  have magnitude : integerNatAbs(integerAbs(x)) = integerNatAbs(x)
    have value := integerAbs.value at x
    rw value
    exact integerNatAbs.ofNat at integerNatAbs(x)
  rw magnitude at left
  constructor
  . intro h
    exact right.backward with (left.forward with h)
  . intro h
    exact left.backward with (right.forward with h)

theorem IntegerDivides.abs_right_iff (x y : Integer)
  shows IntegerDivides(x, integerAbs(y)) ↔ IntegerDivides(x, y)
proof
  have left := IntegerDivides.magnitude_iff at x, integerAbs(y)
  have right := IntegerDivides.magnitude_iff at x, y
  have magnitude : integerNatAbs(integerAbs(y)) = integerNatAbs(y)
    have value := integerAbs.value at y
    rw value
    exact integerNatAbs.ofNat at integerNatAbs(y)
  rw magnitude at left
  constructor
  . intro h
    exact right.backward with (left.forward with h)
  . intro h
    exact left.backward with (right.forward with h)

theorem IntegerDivides.mul_mono (a b c d : Integer)
  requires left : IntegerDivides(a, b)
  requires right : IntegerDivides(c, d)
  shows IntegerDivides(a * c, b * d)
proof
  obtain ⟨p, pInteger, pEquation⟩ := left
  obtain ⟨q, qInteger, qEquation⟩ := right
  witness p * q
  rw [← pEquation, ← qEquation]
  ring

theorem IntegerDivides.mul_cancel_left (a b c : Integer)
  requires nonzero : a ≠ 0
  shows IntegerDivides(a * b, a * c) ↔ IntegerDivides(b, c)
proof
  constructor
  . intro scaled
    obtain ⟨q, qInteger, equation⟩ := scaled
    have rearranged : a * (b * q) = a * c
    . rw ← equation
      ring
    have cancelled := integerMulValue.left_cancel at b * q, c, a
      with nonzero, rearranged
    witness q
    exact cancelled
  . intro plain
    obtain ⟨q, qInteger, equation⟩ := plain
    witness q
    rw ← equation
    ring

theorem IntegerDivides.add_right_iff (d x y : Integer)
  requires left : IntegerDivides(d, x)
  shows IntegerDivides(d, x + y) ↔ IntegerDivides(d, y)
proof
  constructor
  . intro sum
    have difference := IntegerDivides.sub at d, x + y, x with sum, left
    have shape : x + y - x = y by ring
    rw shape at difference
    exact difference
  . intro right
    exact IntegerDivides.add at d, x, y with left, right

theorem IntegerDivides.ofNat_iff (a b : Nat)
  shows IntegerDivides(integerOfNat(a), integerOfNat(b)) ↔ a ∣ b
proof
  have bridge := IntegerDivides.natural_left at a, integerOfNat(b)
  have magnitude := integerNatAbs.ofNat at b
  rw magnitude at bridge
  exact bridge

theorem IntegerDivides.of_natural (a b : Nat)
  requires hab : a ∣ b
  shows IntegerDivides(integerOfNat(a), integerOfNat(b))
proof
  have bridge := IntegerDivides.ofNat_iff at a, b
  exact bridge.backward with hab

theorem IntegerDivides.natAbs_le (x y : Integer)
  requires nonzero : y ≠ 0
  requires hxy : IntegerDivides(x, y)
  shows integerNatAbs(x) ≤ integerNatAbs(y)
proof
  have magnitudes := IntegerDivides.to_magnitudes with hxy
  have distinct : integerNatAbs(y) ≠ 0
    intro zero
    have characterization := integerNatAbs.zero_iff at y
    have yZero := characterization.forward with zero
    exact nonzero with yZero
  exact divides.le at integerNatAbs(x), integerNatAbs(y)
    with magnitudes, distinct

theorem IntegerDivides.abs_le (x y : Integer)
  requires nonzero : y ≠ 0
  requires hxy : IntegerDivides(x, y)
  shows integerAbs(x) ≤ integerAbs(y)
proof
  have below := IntegerDivides.natAbs_le with nonzero, hxy
  have left := integerAbs.value at x
  have right := integerAbs.value at y
  rw [left, right]
  exact integerOfNat.monotone with below

theorem IntegerDivides.antisymmetric_natAbs (x y : Integer)
  requires forward : IntegerDivides(x, y)
  requires backward : IntegerDivides(y, x)
  shows integerNatAbs(x) = integerNatAbs(y)
proof
  have first := IntegerDivides.to_magnitudes with forward
  have second := IntegerDivides.to_magnitudes with backward
  exact divides.antisymmetric with first, second

theorem IntegerDivides.antisymmetric (x y : Integer)
  requires forward : IntegerDivides(x, y)
  requires backward : IntegerDivides(y, x)
  shows x = y ∨ x = -y
proof
  have magnitudes := IntegerDivides.antisymmetric_natAbs with forward, backward
  have same : integerAbs(x) = integerAbs(y)
    have left := integerAbs.value at x
    have right := integerAbs.value at y
    rw [left, right, magnitudes]
    rfl
  have characterization := integerAbs.eq_iff at x, y
  exact characterization.forward with same

theorem IntegerDivides.unit_iff (z : Integer)
  shows IntegerDivides(z, integerOne) ↔ z = integerOne ∨ z = -integerOne
proof
  have oneForm := integerOfNat.one
  constructor
  . intro h
    have magnitudes := IntegerDivides.to_magnitudes with h
    rw ← oneForm at magnitudes
    have magnitude := integerNatAbs.ofNat at 1
    rw magnitude at magnitudes
    have unit := divides.one_only at integerNatAbs(z) with *
    have signs := integerNatAbs.cases at z
    rw unit at signs
    cases signs with positive | negative
    . left
      rw [positive, oneForm]
      rfl
    . right
      have negated := integerNegativeOfNat.eq_neg at 1
      rw [negative, negated, oneForm]
      rfl
  . intro signs
    cases signs with positive | negative
    . rw positive
      exact IntegerDivides.reflexive at integerOne
    . rw negative
      witness -integerOne
      ring

theorem IntegerDivides.unit_left (z x : Integer)
  requires unit : z = integerOne ∨ z = -integerOne
  shows IntegerDivides(z, x)
proof
  cases unit with positive | negative
  . rw positive
    exact IntegerDivides.one_left at x
  . rw negative
    witness -x
    ring

theorem IntegerDivides.two_iff_even (z : Integer)
  shows IntegerDivides(integerOfNat(2), z) ↔ IntegerEven(z)
proof
  have two : integerOfNat(2) = integerOne + integerOne
    have split := integerOfNat.add at 1, 1
    have sum : 1 + 1 = 2 by compute
    rw [sum, integerOfNat.one] at split
    exact split
  constructor
  . intro h
    obtain ⟨q, qInteger, equation⟩ := h
    have shape : z = q + q
      rw [← equation, two]
      ring
    rw shape
    exact IntegerEven.double at q
  . intro even
    obtain ⟨k, kMember, shape⟩ := even
    have kInteger : Integer(k) by typecheck
    witness k
    rw [two, shape]
    ring

theorem IntegerDivides.not_two_iff_odd (z : Integer)
  shows ¬IntegerDivides(integerOfNat(2), z) ↔ IntegerOdd(z)
proof
  have even := IntegerDivides.two_iff_even at z
  have odd := IntegerOdd.iff_not_even at z
  constructor
  . intro notDivides
    apply odd.backward
    intro isEven
    exact notDivides with (even.backward with isEven)
  . intro isOdd
    intro h
    have isEven := even.forward with h
    exact odd.forward with isOdd, isEven

theorem IntegerDivides.pow (x y : Integer, n : Nat)
  requires hxy : IntegerDivides(x, y)
  shows IntegerDivides(x, integerPow(y, n + 1))
proof
  have expand := integerPow.add_one at y, n
  rw expand
  exact IntegerDivides.mul_right at x, y, integerPow(y, n) with hxy

theorem IntegerCongruent.zero_right_iff (m a : Integer)
  shows IntegerCongruent(m, a, integerZero) ↔ IntegerDivides(m, a)
proof
  have shape : a - integerZero = a by ring
  constructor
  . intro congruent
    unfold IntegerCongruent at congruent
    rw shape at congruent
    exact congruent
  . intro h
    unfold IntegerCongruent
    rw shape
    exact h

theorem IntegerCongruent.of_eq (m a b : Integer)
  requires same : a = b
  shows IntegerCongruent(m, a, b)
proof
  rw same
  exact IntegerCongruent.reflexive at m, b

theorem IntegerCongruent.one_modulus (a b : Integer)
  shows IntegerCongruent(integerOne, a, b)
proof
  unfold IntegerCongruent
  exact IntegerDivides.one_left at a - b

theorem IntegerCongruent.neg (m a b : Integer)
  requires congruent : IntegerCongruent(m, a, b)
  shows IntegerCongruent(m, -a, -b)
proof
  unfold IntegerCongruent at congruent
  unfold IntegerCongruent
  have negated := IntegerDivides.neg_right at m, a - b with congruent
  have shape : -(a - b) = -a - (-b) by ring
  rw shape at negated
  exact negated

theorem IntegerCongruent.sub (m a b c d : Integer)
  requires first : IntegerCongruent(m, a, b)
  requires second : IntegerCongruent(m, c, d)
  shows IntegerCongruent(m, a - c, b - d)
proof
  have negated := IntegerCongruent.neg at m, c, d with second
  have sum := IntegerCongruent.add at m, a, b, -c, -d with first, negated
  have left : a + (-c) = a - c by ring
  have right : b + (-d) = b - d by ring
  rw [left, right] at sum
  exact sum

theorem IntegerCongruent.mul_left (m a b c : Integer)
  requires congruent : IntegerCongruent(m, a, b)
  shows IntegerCongruent(m, c * a, c * b)
proof
  have reflexive := IntegerCongruent.reflexive at m, c
  exact IntegerCongruent.mul at m, c, c, a, b with reflexive, congruent

theorem IntegerCongruent.mul_right (m a b c : Integer)
  requires congruent : IntegerCongruent(m, a, b)
  shows IntegerCongruent(m, a * c, b * c)
proof
  have reflexive := IntegerCongruent.reflexive at m, c
  exact IntegerCongruent.mul at m, a, b, c, c with congruent, reflexive

theorem IntegerCongruent.add_right_cancel (m a b c : Integer)
  requires congruent : IntegerCongruent(m, a + c, b + c)
  shows IntegerCongruent(m, a, b)
proof
  unfold IntegerCongruent at congruent
  unfold IntegerCongruent
  have shape : a + c - (b + c) = a - b by ring
  rw shape at congruent
  exact congruent

theorem IntegerCongruent.add_left_cancel (m a b c : Integer)
  requires congruent : IntegerCongruent(m, c + a, c + b)
  shows IntegerCongruent(m, a, b)
proof
  unfold IntegerCongruent at congruent
  unfold IntegerCongruent
  have shape : c + a - (c + b) = a - b by ring
  rw shape at congruent
  exact congruent

theorem IntegerCongruent.pow (m a b : Integer, n : Nat)
  requires congruent : IntegerCongruent(m, a, b)
  shows IntegerCongruent(m, integerPow(a, n), integerPow(b, n))
proof
  induction n
  | zero =>
    have left := integerPow.zero at a
    have right := integerPow.zero at b
    rw [left, right]
    exact IntegerCongruent.reflexive at m, integerOne
  | k + 1 using ih =>
    have left := integerPow.add_one at a, k
    have right := integerPow.add_one at b, k
    rw [left, right]
    exact IntegerCongruent.mul at m, a, b, integerPow(a, k), integerPow(b, k)
      with congruent, ih

theorem IntegerCongruent.divides_modulus (m n a b : Integer)
  requires hmn : IntegerDivides(m, n)
  requires congruent : IntegerCongruent(n, a, b)
  shows IntegerCongruent(m, a, b)
proof
  unfold IntegerCongruent at congruent
  unfold IntegerCongruent
  exact IntegerDivides.transitive at m, n, a - b with hmn, congruent

theorem IntegerCongruent.neg_modulus (m a b : Integer)
  shows IntegerCongruent(-m, a, b) ↔ IntegerCongruent(m, a, b)
proof
  have characterization := IntegerDivides.neg_left_iff at m, a - b
  constructor
  . intro congruent
    unfold IntegerCongruent at congruent
    unfold IntegerCongruent
    exact characterization.forward with congruent
  . intro congruent
    unfold IntegerCongruent at congruent
    unfold IntegerCongruent
    exact characterization.backward with congruent

-- Integer congruence of embedded naturals is natural congruence.
theorem IntegerCongruent.ofNat_iff (m a b : Nat)
  shows
    IntegerCongruent(integerOfNat(m), integerOfNat(a), integerOfNat(b)) ↔
      CongruentMod(a, b, m)
proof
  have bridge := IntegerDivides.natural_left at m, integerOfNat(a) - integerOfNat(b)
  have distance := integerNatAbs.ofNat_sub at a, b
  rw distance at bridge
  have characterization := CongruentMod.iff_divides_natDist at a, b, m
  constructor
  . intro congruent
    unfold IntegerCongruent at congruent
    have distanceDivides := bridge.forward with congruent
    exact characterization.backward with distanceDivides
  . intro congruent
    unfold IntegerCongruent
    have distanceDivides := characterization.forward with congruent
    exact bridge.backward with distanceDivides
