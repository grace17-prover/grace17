-- Sums of naturals over finite sets: disjoint unions add, a subset sums to
-- no more, the sums over a point and over a pair, reindexing along a
-- bijection, and the sum of w(d) · u(e) over a product set as the product
-- of the two sums
-- Part of Cumulus, the Grace17 mathematics library.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module Grace.Cumulus.NumberTheory.NaturalSums
import Cardinal.Pigeonhole

-- The weighted pairs of a subset, of a union, and of disjoint sets.
theorem weightedPairs.monotone (S T w : Set)
  requires subset : S ⊆ T
  shows weightedPairs(S, w) ⊆ weightedPairs(T, w)
proof
  intros p hp
  have parts := weightedPairs.membership.forward with hp
  obtain ⟨v, hv, i, hi, shape⟩ := parts.right
  have bound := parts.left
  rw shape at bound
  have coordinates := product.pair_membership.forward with bound
  have hvT := subset with v, hv
  have boundT : p ∈ T × ℕ
    rw shape
    exact product.pair with hvT, coordinates.right
  exact weightedPairs.membership.backward with
    ⟨boundT, v, hvT, i, hi, shape⟩

theorem weightedPairs.union (A B w : Set)
  shows weightedPairs(A ∪ B, w) = weightedPairs(A, w) ∪ weightedPairs(B, w)
proof
  have leftSubset := union2.subset_left at A, B
  have rightSubset := union2.subset_right at A, B
  have leftInside := weightedPairs.monotone at A, A ∪ B, w with leftSubset
  have rightInside := weightedPairs.monotone at B, A ∪ B, w with rightSubset
  ext p
  constructor
  . intro hp
    have parts := weightedPairs.membership.forward with hp
    obtain ⟨v, hv, i, hi, shape⟩ := parts.right
    have bound := parts.left
    rw shape at bound
    have coordinates := product.pair_membership.forward with bound
    have split := union2.membership.forward with hv
    apply union2.membership.backward
    cases split with inA | inB
    . left
      have boundA : p ∈ A × ℕ
        rw shape
        exact product.pair with inA, coordinates.right
      exact weightedPairs.membership.backward with
        ⟨boundA, v, inA, i, hi, shape⟩
    . right
      have boundB : p ∈ B × ℕ
        rw shape
        exact product.pair with inB, coordinates.right
      exact weightedPairs.membership.backward with
        ⟨boundB, v, inB, i, hi, shape⟩
  . intro hp
    have split := union2.membership.forward with hp
    cases split with inA | inB
    . exact leftInside with p, inA
    . exact rightInside with p, inB

theorem weightedPairs.disjoint (A B w : Set)
  requires disjoint : Disjoint(A, B)
  shows Disjoint(weightedPairs(A, w), weightedPairs(B, w))
proof
  have apart := Disjoint.iff.forward with disjoint
  apply Disjoint.iff.backward
  intros p hp hp2
  have parts := weightedPairs.membership.forward with hp
  obtain ⟨v, hv, i, hi, shape⟩ := parts.right
  have parts2 := weightedPairs.membership.forward with hp2
  obtain ⟨u, hu, j, hj, shape2⟩ := parts2.right
  rw shape at shape2
  have coordinates := orderedPair.injective with shape2
  have same := coordinates.left
  have notB := apart with v, hv
  rw ← same at hu
  exact notB with hu

-- Disjoint unions add up.
theorem natSum.union_disjoint (A B w : Set)
  requires finiteA : Finite(A)
  requires finiteB : Finite(B)
  requires weightsA : ∀ v ∈ A, w(v) ∈ ℕ
  requires weightsB : ∀ v ∈ B, w(v) ∈ ℕ
  requires disjoint : Disjoint(A, B)
  shows natSum(A ∪ B, w) = natSum(A, w) + natSum(B, w)
proof
  have sizeA : cardinality(A) = cardinality(A) by rfl
  have sizeB : cardinality(B) = cardinality(B) by rfl
  have correctA := cardinality.correct with finiteA
  have cardNatA := correctA.left
  have correctB := cardinality.correct with finiteB
  have cardNatB := correctB.left
  have pairsA := weightedPairs.finite with finiteA, sizeA, weightsA
  have pairsB := weightedPairs.finite with finiteB, sizeB, weightsB
  have apart := weightedPairs.disjoint at A, B, w with disjoint
  have added := cardinality.union_disjoint with pairsA, pairsB, apart
  have split := weightedPairs.union at A, B, w
  unfold natSum
  rfl

-- A subset sums to no more.
theorem natSum.monotone (S T w : Set)
  requires finite : Finite(T)
  requires subset : S ⊆ T
  requires weights : ∀ v ∈ T, w(v) ∈ ℕ
  shows natSum(S, w) ≤ natSum(T, w)
proof
  have size : cardinality(T) = cardinality(T) by rfl
  have correct := cardinality.correct with finite
  have cardNat := correct.left
  have pairsFinite := weightedPairs.finite with finite, size, weights
  have inside := weightedPairs.monotone at S, T, w with subset
  have bounded := cardinality.monotone with pairsFinite, inside
  simp [natSum]

-- The sum over a point and over a pair.
theorem natSum.singleton (w a : Set)
  requires weight : w(a) ∈ ℕ
  shows natSum({a}, w) = w(a)
proof
  have asInsert : {a} = insert(a, ∅)
    ext x
    simp [insert.membership]
  have finite := Finite.empty
  have weights : ∀ v ∈ ∅, w(v) ∈ ℕ
    intros v hv
    exfalso
    exact empty.membership with v, hv
  have fresh : ¬a ∈ ∅ := empty.membership at a
  have inserted := natSum.insert with finite, weights, weight, fresh
  have weightNat := nat.omega.backward with weight
  rw [asInsert, inserted, natSum.empty]
  exact add.left_unit at w(a)

theorem natSum.pair (w a b : Set)
  requires weightA : w(a) ∈ ℕ
  requires weightB : w(b) ∈ ℕ
  requires distinct : a ≠ b
  shows natSum({a, b}, w) = w(a) + w(b)
proof
  have asInsert : {a, b} = insert(a, {b})
    ext x
    simp [insert.membership, pair.membership]
  have finite := Finite.singleton at b
  have weights : ∀ v ∈ {b}, w(v) ∈ ℕ
    intros v hv
    have same := singleton.membership.forward with hv
    rw same
    exact weightB
  have fresh : ¬a ∈ {b}
    intro inside
    have same := singleton.membership.forward with inside
    exact distinct with same
  have inserted := natSum.insert with finite, weights, weightA, fresh
  have single := natSum.singleton with weightB
  have aNat := nat.omega.backward with weightA
  have bNat := nat.omega.backward with weightB
  rw [asInsert, inserted, single]
  exact add.commutative at w(a), w(b)

-- Reindexing: a bijection f : S → T carries the weighted pairs of the
-- pulled-back weights v(s) = w(f(s)) onto those of w.
defgraph reindexPairs (f S T v w : Set) (p ∈ weightedPairs(S, v)) :
    weightedPairs(T, w) := (f(fst(p)), snd(p))
requires fFunction : f : S → T
requires values : ∀ s ∈ S, v(s) = w(f(s))
proof
  have parts := weightedPairs.membership.forward with member
  obtain ⟨s, hs, i, hi, shape⟩ := parts.right
  have bound := parts.left
  rw shape at bound
  have coordinates := product.pair_membership.forward with bound
  have image := FunctionBetween.apply_closed with fFunction, hs
  have equal := values with s, hs
  rw equal at hi
  have boundT : (f(s), i) ∈ T × ℕ :=
    product.pair with image, coordinates.right
  have same : (f(s), i) = (f(s), i) by rfl
  rw [shape, fst.pair, snd.pair]
  exact weightedPairs.membership.backward with
    ⟨boundT, f(s), image, i, hi, same⟩

theorem reindexPairs.pair (f S T v w s i : Set)
  requires fFunction : f : S → T
  requires values : ∀ s ∈ S, v(s) = w(f(s))
  requires member : (s, i) ∈ weightedPairs(S, v)
  shows reindexPairs(f, S, T, v, w)((s, i)) = (f(s), i)
proof
  have value := reindexPairs.value at f, S, T, v, w, (s, i) with fFunction,
    values, member
  rw [value, fst.pair, snd.pair]
  rfl

theorem reindexPairs.injective (f S T v w : Set)
  requires injective : InjectiveBetween(f, S, T)
  requires values : ∀ s ∈ S, v(s) = w(f(s))
  shows InjectiveBetween(reindexPairs(f, S, T, v, w), weightedPairs(S, v),
    weightedPairs(T, w))
proof
  have fFunction := Injective.function with injective
  have function := reindexPairs.function at f, S, T, v, w with fFunction, values
  refine ⟨function, _⟩
  intros x hx y hy z hz relatesX relatesY
  have partsX := weightedPairs.membership.forward with hx
  obtain ⟨s, hs, i, hi, shapeX⟩ := partsX.right
  have partsY := weightedPairs.membership.forward with hy
  obtain ⟨t, ht, j, hj, shapeY⟩ := partsY.right
  have valueX := FunctionBetween.apply_value with function, hx, relatesX
  have valueY := FunctionBetween.apply_value with function, hy, relatesY
  rw shapeX at hx
  rw shapeY at hy
  rw shapeX at valueX
  rw shapeY at valueY
  have pairX := reindexPairs.pair with fFunction, values, hx
  have pairY := reindexPairs.pair with fFunction, values, hy
  have same : (f(s), i) = (f(t), j) by cc
  have coordinates := orderedPair.injective with same
  have imageS := FunctionBetween.relates_apply with fFunction, hs
  have imageT := FunctionBetween.relates_apply with fFunction, ht
  have imageIn := FunctionBetween.apply_closed with fFunction, hs
  rw coordinates.left at imageS
  rw coordinates.left at imageIn
  have sameInput : s = t := Injective.cancel with *
  rw [shapeX, shapeY, sameInput, coordinates.right]
  rfl

theorem reindexPairs.surjective (f S T v w : Set)
  requires bijective : BijectiveBetween(f, S, T)
  requires values : ∀ s ∈ S, v(s) = w(f(s))
  shows SurjectiveBetween(reindexPairs(f, S, T, v, w), weightedPairs(S, v),
    weightedPairs(T, w))
proof
  have injective := Bijective.injective with bijective
  have surjective := Bijective.surjective with bijective
  have fFunction := Injective.function with injective
  have function := reindexPairs.function at f, S, T, v, w with fFunction, values
  refine ⟨function, _⟩
  intros z hz
  have parts := weightedPairs.membership.forward with hz
  obtain ⟨t, ht, j, hj, shape⟩ := parts.right
  have bound := parts.left
  rw shape at bound
  have coordinates := product.pair_membership.forward with bound
  obtain ⟨s, hs, relatesS⟩ := surjective.right with t, ht
  have image := FunctionBetween.apply_value with fFunction, hs, relatesS
  have equal := values with s, hs
  rw image at equal
  rw ← equal at hj
  have boundS : (s, j) ∈ S × ℕ := product.pair with hs, coordinates.right
  have same : (s, j) = (s, j) by rfl
  have memberS : (s, j) ∈ weightedPairs(S, v) :=
    weightedPairs.membership.backward with ⟨boundS, s, hs, j, hj, same⟩
  have value := reindexPairs.pair with fFunction, values, memberS
  have relates := FunctionBetween.relates_apply with function, memberS
  rw [value, image, ← shape] at relates
  exact ⟨(s, j), memberS, relates⟩

theorem reindexPairs.bijective (f S T v w : Set)
  requires bijective : BijectiveBetween(f, S, T)
  requires values : ∀ s ∈ S, v(s) = w(f(s))
  shows BijectiveBetween(reindexPairs(f, S, T, v, w), weightedPairs(S, v),
    weightedPairs(T, w))
proof
  have injective := Bijective.injective with bijective
  have pairsInjective := reindexPairs.injective with injective, values
  have pairsSurjective := reindexPairs.surjective with bijective, values
  exact ⟨pairsInjective, pairsSurjective⟩

-- The sum of w over T is the sum over S of the pulled-back weights.
theorem natSum.reindex (f S T v w : Set)
  requires finite : Finite(S)
  requires bijective : BijectiveBetween(f, S, T)
  requires weights : ∀ t ∈ T, w(t) ∈ ℕ
  requires values : ∀ s ∈ S, v(s) = w(f(s))
  shows natSum(T, w) = natSum(S, v)
proof
  have injective := Bijective.injective with bijective
  have fFunction := Injective.function with injective
  have weightsS : ∀ s ∈ S, v(s) ∈ ℕ
    intros s hs
    have equal := values with s, hs
    have image := FunctionBetween.apply_closed with fFunction, hs
    rw equal
    exact weights with f(s), image
  have size : cardinality(S) = cardinality(S) by rfl
  have correct := cardinality.correct with finite
  have cardNat := correct.left
  have pairsFinite := weightedPairs.finite with finite, size, weightsS
  have pairsBijective := reindexPairs.bijective with bijective, values
  have same := cardinality.bijective with pairsFinite, pairsBijective
  unfold natSum
  rfl

-- The weight (d, e) ↦ w(d) · u(e) on a product set.
defgraph weightProduct (D E w u : Set) (q ∈ D × E) : ℕ :=
  w(fst(q)) * u(snd(q))
requires weightsD : ∀ d ∈ D, w(d) ∈ ℕ
requires weightsE : ∀ e ∈ E, u(e) ∈ ℕ
proof
  obtain ⟨bound, d, hd, e, he, shape⟩ :=
    product.membership.forward with member
  have dNat := nat.omega.backward with (weightsD with d, hd)
  have eNat := nat.omega.backward with (weightsE with e, he)
  have productNat : Nat(w(d) * u(e)) by typecheck
  rw [shape, fst.pair, snd.pair]
  exact nat.omega.forward with productNat

theorem weightProduct.pair (D E w u d e : Set)
  requires weightsD : ∀ d ∈ D, w(d) ∈ ℕ
  requires weightsE : ∀ e ∈ E, u(e) ∈ ℕ
  requires hd : d ∈ D
  requires he : e ∈ E
  shows weightProduct(D, E, w, u)((d, e)) = w(d) * u(e)
proof
  have pairMember := product.pair with hd, he
  have value := weightProduct.value at D, E, w, u, (d, e) with weightsD,
    weightsE, pairMember
  rw [value, fst.pair, snd.pair]
  rfl

-- The weighted pairs of a product: ((d, i), (e, j)) ↦ ((d, e), k) with k the
-- position of (i, j) in the enumeration of w(d) × u(e) by w(d) · u(e).
defgraph productPairs (D E w u : Set)
    (q ∈ weightedPairs(D, w) × weightedPairs(E, u)) :
    weightedPairs(D × E, weightProduct(D, E, w, u)) :=
  ((fst(fst(q)), fst(snd(q))),
    natProductEquiv(w(fst(fst(q))), u(fst(snd(q))))((snd(fst(q)), snd(snd(q)))))
requires weightsD : ∀ d ∈ D, w(d) ∈ ℕ
requires weightsE : ∀ e ∈ E, u(e) ∈ ℕ
proof
  obtain ⟨bound, x, hx, y, hy, shape⟩ :=
    product.membership.forward with member
  have partsX := weightedPairs.membership.forward with hx
  obtain ⟨d, hd, i, hi, shapeX⟩ := partsX.right
  have partsY := weightedPairs.membership.forward with hy
  obtain ⟨e, he, j, hj, shapeY⟩ := partsY.right
  have dNat := nat.omega.backward with (weightsD with d, hd)
  have eNat := nat.omega.backward with (weightsE with e, he)
  have equiv := natProductEquiv.bijective at u(e), w(d)
  have equivFunction := Injective.function with (Bijective.injective with equiv)
  have pairIJ := product.pair with hi, hj
  have kMember := FunctionBetween.apply_closed with equivFunction, pairIJ
  have naturals := natural.member at w(d) * u(e)
  have kNat := naturals with natProductEquiv(w(d), u(e))((i, j)), kMember
  have kIn := nat.omega.forward with kNat
  have weightValue := weightProduct.pair with weightsD, weightsE, hd, he
  rw ← weightValue at kMember
  have deMember := product.pair with hd, he
  have boundQ := product.pair with deMember, kIn
  have same : ((d, e), natProductEquiv(w(d), u(e))((i, j))) =
    ((d, e), natProductEquiv(w(d), u(e))((i, j))) by rfl
  rw [shape, shapeX, shapeY]
  simp [fst.pair, snd.pair]
  exact weightedPairs.membership.backward with
    ⟨boundQ, (d, e), deMember, natProductEquiv(w(d), u(e))((i, j)), kMember,
      same⟩

theorem productPairs.pair (D E w u d i e j : Set)
  requires weightsD : ∀ d ∈ D, w(d) ∈ ℕ
  requires weightsE : ∀ e ∈ E, u(e) ∈ ℕ
  requires hx : (d, i) ∈ weightedPairs(D, w)
  requires hy : (e, j) ∈ weightedPairs(E, u)
  shows productPairs(D, E, w, u)(((d, i), (e, j))) =
    ((d, e), natProductEquiv(w(d), u(e))((i, j)))
proof
  have pairMember := product.pair with hx, hy
  have value := productPairs.value at D, E, w, u, ((d, i), (e, j)) with
    weightsD, weightsE, pairMember
  rw value
  simp [fst.pair, snd.pair]

theorem productPairs.injective (D E w u : Set)
  requires weightsD : ∀ d ∈ D, w(d) ∈ ℕ
  requires weightsE : ∀ e ∈ E, u(e) ∈ ℕ
  shows InjectiveBetween(productPairs(D, E, w, u),
    weightedPairs(D, w) × weightedPairs(E, u),
    weightedPairs(D × E, weightProduct(D, E, w, u)))
proof
  have function := productPairs.function at D, E, w, u with weightsD, weightsE
  refine ⟨function, _⟩
  intros x hx y hy z hz relatesX relatesY
  obtain ⟨boundX, x1, hx1, x2, hx2, shapeX⟩ :=
    product.membership.forward with hx
  obtain ⟨boundY, y1, hy1, y2, hy2, shapeY⟩ :=
    product.membership.forward with hy
  have partsX1 := weightedPairs.membership.forward with hx1
  obtain ⟨d, hd, i, hi, shapeX1⟩ := partsX1.right
  have partsX2 := weightedPairs.membership.forward with hx2
  obtain ⟨e, he, j, hj, shapeX2⟩ := partsX2.right
  have partsY1 := weightedPairs.membership.forward with hy1
  obtain ⟨d2, hd2, i2, hi2, shapeY1⟩ := partsY1.right
  have partsY2 := weightedPairs.membership.forward with hy2
  obtain ⟨e2, he2, j2, hj2, shapeY2⟩ := partsY2.right
  have valueX := FunctionBetween.apply_value with function, hx, relatesX
  have valueY := FunctionBetween.apply_value with function, hy, relatesY
  rw shapeX1 at hx1
  rw shapeX2 at hx2
  rw shapeY1 at hy1
  rw shapeY2 at hy2
  rw [shapeX, shapeX1, shapeX2] at valueX
  rw [shapeY, shapeY1, shapeY2] at valueY
  have pairX := productPairs.pair with weightsD, weightsE, hx1, hx2
  have pairY := productPairs.pair with weightsD, weightsE, hy1, hy2
  have same : ((d, e), natProductEquiv(w(d), u(e))((i, j))) =
    ((d2, e2), natProductEquiv(w(d2), u(e2))((i2, j2))) by cc
  have outer := orderedPair.injective with same
  have inner := orderedPair.injective with outer.left
  have dEqual := inner.left
  have eEqual := inner.right
  have positions := outer.right
  rw [← dEqual, ← eEqual] at positions
  rw ← dEqual at hi2
  rw ← eEqual at hj2
  have dNat := nat.omega.backward with (weightsD with d, hd)
  have eNat := nat.omega.backward with (weightsE with e, he)
  have equiv := natProductEquiv.bijective at u(e), w(d)
  have equivInjective := Bijective.injective with equiv
  have equivFunction := Injective.function with equivInjective
  have pairIJ := product.pair with hi, hj
  have pairIJ2 := product.pair with hi2, hj2
  have relatesIJ := FunctionBetween.relates_apply with equivFunction, pairIJ
  have relatesIJ2 := FunctionBetween.relates_apply with equivFunction, pairIJ2
  have kMember := FunctionBetween.apply_closed with equivFunction, pairIJ2
  rw positions at relatesIJ
  have sameInput := Injective.cancel at natProductEquiv(w(d), u(e)),
    w(d) × u(e), w(d) * u(e), (i, j), (i2, j2),
    natProductEquiv(w(d), u(e))((i2, j2)) with equivInjective, pairIJ,
      pairIJ2, kMember, relatesIJ, relatesIJ2
  have coordinates := orderedPair.injective with sameInput
  rw [shapeX, shapeY, shapeX1, shapeX2, shapeY1, shapeY2, ← dEqual,
    ← eEqual, ← coordinates.left, ← coordinates.right]
  rfl

theorem productPairs.surjective (D E w u : Set)
  requires weightsD : ∀ d ∈ D, w(d) ∈ ℕ
  requires weightsE : ∀ e ∈ E, u(e) ∈ ℕ
  shows SurjectiveBetween(productPairs(D, E, w, u),
    weightedPairs(D, w) × weightedPairs(E, u),
    weightedPairs(D × E, weightProduct(D, E, w, u)))
proof
  have function := productPairs.function at D, E, w, u with weightsD, weightsE
  refine ⟨function, _⟩
  intros z hz
  have parts := weightedPairs.membership.forward with hz
  obtain ⟨p, hp, k, hk, shape⟩ := parts.right
  obtain ⟨boundP, d, hd, e, he, shapeP⟩ :=
    product.membership.forward with hp
  have weightValue := weightProduct.pair with weightsD, weightsE, hd, he
  rw [shapeP, weightValue] at hk
  have dNat := nat.omega.backward with (weightsD with d, hd)
  have eNat := nat.omega.backward with (weightsE with e, he)
  have equiv := natProductEquiv.bijective at u(e), w(d)
  have equivSurjective := Bijective.surjective with equiv
  have equivFunction := Injective.function with (Bijective.injective with equiv)
  obtain ⟨r, hr, relatesR⟩ := equivSurjective.right with k, hk
  obtain ⟨boundR, i, hi, j, hj, shapeR⟩ :=
    product.membership.forward with hr
  have iNat := natural.member at w(d) with i, hi
  have jNat := natural.member at u(e) with j, hj
  have iIn := nat.omega.forward with iNat
  have jIn := nat.omega.forward with jNat
  have boundX := product.pair with hd, iIn
  have boundY := product.pair with he, jIn
  have sameX : (d, i) = (d, i) by rfl
  have sameY : (e, j) = (e, j) by rfl
  have memberX : (d, i) ∈ weightedPairs(D, w) :=
    weightedPairs.membership.backward with ⟨boundX, d, hd, i, hi, sameX⟩
  have memberY : (e, j) ∈ weightedPairs(E, u) :=
    weightedPairs.membership.backward with ⟨boundY, e, he, j, hj, sameY⟩
  have memberQ := product.pair with memberX, memberY
  have value := productPairs.pair with weightsD, weightsE, memberX, memberY
  have kValue := FunctionBetween.apply_value with equivFunction, hr, relatesR
  rw shapeR at kValue
  have relates := FunctionBetween.relates_apply with function, memberQ
  rw [value, kValue, ← shapeP, ← shape] at relates
  exact ⟨((d, i), (e, j)), memberQ, relates⟩

theorem productPairs.bijective (D E w u : Set)
  requires weightsD : ∀ d ∈ D, w(d) ∈ ℕ
  requires weightsE : ∀ e ∈ E, u(e) ∈ ℕ
  shows BijectiveBetween(productPairs(D, E, w, u),
    weightedPairs(D, w) × weightedPairs(E, u),
    weightedPairs(D × E, weightProduct(D, E, w, u)))
proof
  have injective := productPairs.injective with weightsD, weightsE
  have surjective := productPairs.surjective with weightsD, weightsE
  exact ⟨injective, surjective⟩

-- The sum of w(d) · u(e) over D × E is the product of the two sums.
theorem natSum.product (D E w u : Set)
  requires finiteD : Finite(D)
  requires finiteE : Finite(E)
  requires weightsD : ∀ d ∈ D, w(d) ∈ ℕ
  requires weightsE : ∀ e ∈ E, u(e) ∈ ℕ
  shows natSum(D × E, weightProduct(D, E, w, u)) = natSum(D, w) * natSum(E, u)
proof
  have sizeD : cardinality(D) = cardinality(D) by rfl
  have sizeE : cardinality(E) = cardinality(E) by rfl
  have correctD := cardinality.correct with finiteD
  have cardNatD := correctD.left
  have correctE := cardinality.correct with finiteE
  have cardNatE := correctE.left
  have pairsD := weightedPairs.finite with finiteD, sizeD, weightsD
  have pairsE := weightedPairs.finite with finiteE, sizeE, weightsE
  have pairsFinite := Finite.product with pairsD, pairsE
  have bijective := productPairs.bijective with weightsD, weightsE
  have same := cardinality.bijective with pairsFinite, bijective
  have countD := cardinality.correct with pairsD
  have countE := cardinality.correct with pairsE
  have countProduct := HasCardinality.product with countD, countE
  have productValue := cardinality.eq_of_has with countProduct
  unfold natSum
  rw [← same, productValue]
  rfl
