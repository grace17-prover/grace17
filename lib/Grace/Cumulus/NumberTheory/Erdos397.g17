-- Erdős problem 397: infinitely many coincidences among products of central
-- binomial coefficients
-- Part of Cumulus, the Grace17 mathematics library.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module Grace.Cumulus.NumberTheory.Erdos397
import Binomial

-- Erdős and Graham asked whether the equation
--   ∏ᵢ C(2mᵢ, mᵢ) = ∏ⱼ C(2nⱼ, nⱼ)
-- has only finitely many solutions in distinct positive integers. The answer
-- is no: for every a ≥ 2, with c = 8a² + 8a + 1,
--   C(2a, a) · C(4a + 4, 2a + 2) · C(2c, c)
--     = C(2a + 2, a + 1) · C(4a, 2a) · C(2c + 2, c + 1).
-- The family was found by Neel Somani with ChatGPT in January 2026. This
-- module checks it from the axioms of set theory: the identity rests on one
-- step law for central binomial coefficients and a polynomial identity.

-- The central binomial coefficient C(2n, n).
def central (n : Nat) : Nat := 2 * n choose n

theorem add_one.nonzero (x : Nat)
  shows x + 1 ≠ 0
proof
  arith

-- Each step of the central binomial sequence:
--   C(2n + 2, n + 1) · (n + 1)² = C(2n, n) · (2n + 2)(2n + 1).
theorem central.step (n : Nat)
  shows central(n + 1) * ((n + 1) * (n + 1)) =
    central(n) * ((2 * n + 2) * (2 * n + 1))
proof
  unfold central
  have lower := choose.factorial at n with n
  have upper := choose.factorial at n + 1 with n + 1
  have outer := factorial.succ at n + n + 1 with *
  have inner := factorial.succ at n + n with *
  have step := factorial.succ at n with *
  have nonzero := factorial.nonzero at n with *
  have squareNonzero := mul.nonzero with nonzero, nonzero
  have key : (n! * n!) * ((2 * (n + 1) choose n + 1) * ((n + 1) * (n + 1))) =
      (n! * n!) * ((2 * n choose n) * ((2 * n + 2) * (2 * n + 1)))
    ring [upper, lower, outer, inner, step]
  exact mul.left_cancel_positive with squareNonzero, key

-- The identity behind every solution in the family: with c = 8a² + 8a + 1,
--   C(2a, a) · C(4a + 4, 2a + 2) · C(2c, c)
--     = C(2a + 2, a + 1) · C(4a, 2a) · C(2c + 2, c + 1).
-- Multiply both sides by (a + 1)²(2a + 1)²(2a + 2)²(c + 1)² and apply the
-- step law to each central binomial coefficient whose index is a successor.
theorem erdos397.identity (a : Nat)
  shows central(a) * (central(2 * a + 2) * central(8 * a * a + 8 * a + 1)) =
    central(a + 1) * (central(2 * a) * central(8 * a * a + 8 * a + 2))
proof
  have e1 : 2 * a + 2 = 2 * a + 1 + 1 by ring
  have e2 : 8 * a * a + 8 * a + 2 = 8 * a * a + 8 * a + 1 + 1 by ring
  rw [e1, e2]
  have s1 := central.step at a with *
  have s2 := central.step at 2 * a with *
  have s3 := central.step at 2 * a + 1 with *
  have s4 := central.step at 8 * a * a + 8 * a + 1 with *
  have n1 := add_one.nonzero at a with *
  have n2 := add_one.nonzero at 2 * a with *
  have n3 := add_one.nonzero at 2 * a + 1 with *
  have n4 := add_one.nonzero at 8 * a * a + 8 * a + 1 with *
  have q1 := mul.nonzero with n1, n1
  have q2 := mul.nonzero with n2, n2
  have q3 := mul.nonzero with n3, n3
  have q4 := mul.nonzero with n4, n4
  have q34 := mul.nonzero with q3, q4
  have q234 := mul.nonzero with q2, q34
  have nonzero := mul.nonzero with q1, q234
  have key : ((a + 1) * (a + 1)) *
        (((2 * a + 1) * (2 * a + 1)) *
          (((2 * a + 1 + 1) * (2 * a + 1 + 1)) *
            ((8 * a * a + 8 * a + 1 + 1) * (8 * a * a + 8 * a + 1 + 1)))) *
        (central(a) *
          (central(2 * a + 1 + 1) * central(8 * a * a + 8 * a + 1))) =
      ((a + 1) * (a + 1)) *
        (((2 * a + 1) * (2 * a + 1)) *
          (((2 * a + 1 + 1) * (2 * a + 1 + 1)) *
            ((8 * a * a + 8 * a + 1 + 1) * (8 * a * a + 8 * a + 1 + 1)))) *
        (central(a + 1) * (central(2 * a) * central(8 * a * a + 8 * a + 1 + 1)))
    ring [s1, s2, s3, s4]
  exact mul.left_cancel_positive with nonzero, key

-- For a ≥ 2 the three indices on each side are distinct, and the two sides
-- use different indices, so each a gives a genuine solution.
theorem erdos397.distinct (a : Nat)
  requires large : 2 ≤ a
  shows (a ≠ 2 * a + 2 ∧ a ≠ 8 * a * a + 8 * a + 1 ∧
      2 * a + 2 ≠ 8 * a * a + 8 * a + 1) ∧
    (a + 1 ≠ 2 * a ∧ a + 1 ≠ 8 * a * a + 8 * a + 2 ∧
      2 * a ≠ 8 * a * a + 8 * a + 2) ∧
    (a ≠ a + 1 ∧ a ≠ 2 * a ∧ a ≠ 8 * a * a + 8 * a + 2)
proof
  arith

-- Infinitely many solutions: beyond any bound there is another a.
theorem erdos397.unbounded (N : Nat)
  shows ∃ a ∈ ℕ, N < a ∧ 2 ≤ a ∧
    central(a) * (central(2 * a + 2) * central(8 * a * a + 8 * a + 1)) =
    central(a + 1) * (central(2 * a) * central(8 * a * a + 8 * a + 2))
proof
  have witnessNat : Nat(N + 2) by typecheck
  have member := nat.omega.forward with witnessNat
  refine ⟨N + 2, member, ?_, ?_, erdos397.identity at N + 2 with *⟩
  . arith
  . arith
