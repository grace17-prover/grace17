-- The set of divisors of a natural number: membership, finiteness, the
-- divisors of 0, 1, and a prime, a characterisation of primes by their
-- divisors, and the small primes
-- Part of Cumulus, the Grace17 mathematics library.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module Grace.Cumulus.NumberTheory.Divisors
import ModularMore
import Cardinal.ListSupport

def divisors (n : Nat) : Set := { d ∈ n + 1 | d ∣ n }

theorem divisors.natural (n : Nat, d : Set)
  requires member : d ∈ divisors(n)
  shows Nat(d)
proof
  have both := divisors.membership.forward with member
  have all := natural.member at n + 1
  exact all with d, both.left

theorem divisors.divides (n d : Nat)
  requires member : d ∈ divisors(n)
  shows d ∣ n
proof
  have both := divisors.membership.forward with member
  exact both.right

theorem divisors.le (n d : Nat)
  requires member : d ∈ divisors(n)
  shows d ≤ n
proof
  have both := divisors.membership.forward with member
  have below := Less.of_membership at d, n + 1 with both.left
  arith

theorem divisors.membership_le (n d : Nat)
  shows d ∈ divisors(n) ↔ d ≤ n ∧ d ∣ n
proof
  constructor
  . intro member
    have below := divisors.le with member
    have factor := divisors.divides with member
    exact ⟨below, factor⟩
  . intro both
    rcases both with ⟨below, factor⟩
    have bound : d < n + 1 by arith
    have member := membership.of_Less at d, n + 1 with *, bound
    exact divisors.membership.backward with ⟨member, factor⟩

theorem divisors.subset_successor (n : Nat)
  shows divisors(n) ⊆ n + 1
proof
  intros d member
  have both := divisors.membership.forward with member
  exact both.left

theorem divisors.subset_naturals (n : Nat)
  shows divisors(n) ⊆ ℕ
proof
  intros d member
  have dNat := divisors.natural with member
  exact nat.omega.forward with dNat

theorem divisors.finite (n : Nat)
  shows Finite(divisors(n))
proof
  have bounded := Finite.natural at n + 1
  have subset := divisors.subset_successor at n
  exact Finite.subset with bounded, subset

theorem divisors.self_member (n : Nat)
  shows n ∈ divisors(n)
proof
  have reflexive := divides.reflexive at n
  have below := LessEqual.reflexive at n
  have characterization := divisors.membership_le at n, n
  exact characterization.backward with ⟨below, reflexive⟩

theorem divisors.one_member (n : Nat)
  requires nonzero : n ≠ 0
  shows 1 ∈ divisors(n)
proof
  have one := one.divides at n
  have positive := LessEqual.one_iff_ne_zero at n
  have below := positive.backward with nonzero
  have characterization := divisors.membership_le at n, 1
  exact characterization.backward with ⟨below, one⟩

theorem divisors.nonempty (n : Nat)
  shows Nonempty(divisors(n))
proof
  have member := divisors.self_member at n
  exact ⟨n, member⟩

theorem divisors.zero
  shows divisors(0) = {0}
proof
  ext x
  constructor
  . intro member
    have xNat := divisors.natural at 0, x with member
    have below := divisors.le at 0, x with member
    have xZero := LessEqual.eq_zero with below
    rw xZero
    apply singleton.membership.backward
    rfl
  . intro member
    have xZero := singleton.membership.forward with member
    rw xZero
    exact divisors.self_member at 0

theorem divisors.one
  shows divisors(1) = {1}
proof
  ext x
  constructor
  . intro member
    have xNat := divisors.natural at 1, x with member
    have factor := divisors.divides at 1, x with member
    have xOne := divides.one_only at x with *
    rw xOne
    apply singleton.membership.backward
    rfl
  . intro member
    have xOne := singleton.membership.forward with member
    rw xOne
    exact divisors.self_member at 1

theorem divisors.subset_of_divides (a b : Nat)
  requires nonzero : b ≠ 0
  requires hab : a ∣ b
  shows divisors(a) ⊆ divisors(b)
proof
  intros d member
  have dNat := divisors.natural at a, d with member
  have factor := divisors.divides at a, d with member
  have chained := divides.transitive at d, a, b with factor, hab
  have below := divides.le at d, b with chained, nonzero
  have characterization := divisors.membership_le at b, d
  exact characterization.backward with ⟨below, chained⟩

theorem divisors.prime (p : Nat)
  requires prime : Prime(p)
  shows divisors(p) = {1, p}
proof
  have nonzero := Prime.nonzero with prime
  ext x
  constructor
  . intro member
    have xNat := divisors.natural at p, x with member
    have factor := divisors.divides at p, x with member
    have below := divisors.le at p, x with member
    have alternatives := LessEqual.cases at x, p with below
    apply pair.membership.backward
    cases alternatives with strict | same
    . left
      have proper := membership.of_Less at x, p with *, strict
      exact Prime.divisor at p, x with prime, xNat, proper, factor
    . right
      exact same
  . intro member
    have alternatives := pair.membership.forward with member
    cases alternatives with one | self
    . rw one
      exact divisors.one_member at p with nonzero
    . rw self
      exact divisors.self_member at p

theorem Prime.of_divisors (p : Nat)
  requires aboveOne : 1 < p
  requires same : divisors(p) = {1, p}
  shows Prime(p)
proof
  have oneMember := membership.of_Less at 1, p with *, aboveOne
  refine ⟨oneMember, _⟩
  intros d dNat proper factor
  have strict := Less.of_membership at d, p with proper
  have below : d ≤ p by arith
  have characterization := divisors.membership_le at p, d
  have member := characterization.backward with ⟨below, factor⟩
  rw same at member
  have alternatives := pair.membership.forward with member
  cases alternatives with one | self
  . exact one
  . exfalso
    rw self at strict
    exact Less.irreflexive at p with strict

theorem Prime.iff_divisors (p : Nat)
  shows Prime(p) ↔ 1 < p ∧ divisors(p) = {1, p}
proof
  constructor
  . intro prime
    have aboveOne := Prime.greater_than_one with prime
    have same := divisors.prime with prime
    exact ⟨aboveOne, same⟩
  . intro both
    rcases both with ⟨aboveOne, same⟩
    exact Prime.of_divisors with aboveOne, same

theorem Prime.ne_one (p : Nat)
  requires prime : Prime(p)
  shows p ≠ 1
proof
  have aboveOne := Prime.greater_than_one with prime
  intro one
  rw one at aboveOne
  exact Less.irreflexive at 1 with aboveOne

theorem Prime.two_le (p : Nat)
  requires prime : Prime(p)
  shows 2 ≤ p
proof
  have aboveOne := Prime.greater_than_one with prime
  arith

theorem Prime.not_divides_one (p : Nat)
  requires prime : Prime(p)
  shows ¬(p ∣ 1)
proof
  intro unit
  have one := divides.one_only at p with *
  exact Prime.ne_one with prime, one

theorem Prime.two
  shows Prime(2)
proof
  have oneMember : 1 ∈ 2 by typecheck
  refine ⟨oneMember, _⟩
  intros d dNat proper factor
  have strict := Less.of_membership at d, 2 with proper
  have alternatives := natural.below_two with strict
  cases alternatives with zero | one
  . exfalso
    rw zero at factor
    have bad := zero.divides_only_zero with factor
    have distinct : 2 ≠ 0 by arith
    exact distinct with bad
  . exact one

theorem Prime.three
  shows Prime(3)
proof
  have oneMember : 1 ∈ 3 by typecheck
  refine ⟨oneMember, _⟩
  intros d dNat proper factor
  have strict := Less.of_membership at d, 3 with proper
  have alternatives := natural.below_three with strict
  rcases alternatives with zero | one | two
  . exfalso
    rw zero at factor
    have bad := zero.divides_only_zero with factor
    have distinct : 3 ≠ 0 by arith
    exact distinct with bad
  . exact one
  . exfalso
    rw two at factor
    have even := divides.two_iff_even at 3
    have isEven := even.forward with factor
    exact Even.not_three with isEven

theorem divisors.two
  shows divisors(2) = {1, 2}
proof
  have prime := Prime.two
  exact divisors.prime with prime

theorem divisors.three
  shows divisors(3) = {1, 3}
proof
  have prime := Prime.three
  exact divisors.prime with prime

theorem Prime.two_or_odd (p : Nat)
  requires prime : Prime(p)
  shows p = 2 ∨ Odd(p)
proof
  have parity := parity.exhaustive at p
  cases parity with even | odd
  . left
    have characterization := divides.two_iff_even at p
    have two := characterization.backward with even
    have nonzero := Prime.nonzero with prime
    have below := divides.le at 2, p with two, nonzero
    have alternatives := LessEqual.cases at 2, p with below
    cases alternatives with strict | same
    . exfalso
      have proper := membership.of_Less at 2, p with *, strict
      have one := Prime.divisor at p, 2 with *
      have distinct : 2 ≠ 1 by arith
      exact distinct with one
    . symm
      exact same
  . right
    exact odd

theorem Prime.odd_of_ne_two (p : Nat)
  requires prime : Prime(p)
  requires distinct : p ≠ 2
  shows Odd(p)
proof
  have alternatives := Prime.two_or_odd with prime
  cases alternatives with two | odd
  . exfalso
    exact distinct with two
  . exact odd
