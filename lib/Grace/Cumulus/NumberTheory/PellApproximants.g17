-- Authors: Grant Passmore

module Grace.Cumulus.NumberTheory.PellApproximants
import Grace.Cumulus.NumberTheory.Dirichlet
import Grace.Cumulus.NumberTheory.SqrtNonsquare
import Grace.Cumulus.Cardinal

-- The pairs of naturals (x, y) with y > 0 and |x² − d y²| < M.

def pellPairs (d M : Set) : Set :=
  { q ∈ ℕ × ℕ | 0 < snd(q) ∧
    natDist(mul(fst(q), fst(q)), mul(d, mul(snd(q), snd(q)))) < M }

theorem pellPairs.mem_iff (d M x y : Nat)
  shows (x, y) ∈ pellPairs(d, M) ↔ 0 < y ∧ natDist(x * x, d * (y * y)) < M
proof
  have xIn : x ∈ ℕ by typecheck
  have yIn : y ∈ ℕ by typecheck
  have inProduct := product.pair at x, y, ℕ, ℕ with xIn, yIn
  have first := fst.pair at x, y
  have second := snd.pair at x, y
  have split := pellPairs.membership at d, M, (x, y)
  rw [first, second] at split
  constructor
  . intro member
    have facts := split.forward with member
    exact facts.right
  . intro facts
    apply split.backward
    exact ⟨inProduct, facts⟩

theorem pellPairs.subset (d M : Nat)
  shows pellPairs(d, M) ⊆ ℕ × ℕ
proof
  intros q member
  have split := pellPairs.membership.forward with member
  exact split.left

-- The distance in ℝ: x² − d y² = (x − y √d)(x + y √d), and the natural
-- distance is the real absolute value of that difference.

theorem pellPairs.real_distance (d x y : Nat)
  shows (realNat(natDist(x * x, d * (y * y))):R) =
    abs((realNat(x):R) - (realNat(y):R) * sqrtNat(d)) *
      ((realNat(x):R) + (realNat(y):R) * sqrtNat(d))
proof
  have rootNonneg := sqrtNat.nonnegative at d
  have xNonneg := realNat.nonnegative at x
  have yNonneg := realNat.nonnegative at y
  have square := sqrtNat.square at d
  have productNonneg :=
    realMulValue.nonnegative with yNonneg, rootNonneg
  have expand : (realNat(y) * sqrtNat(d)) * (realNat(y) * sqrtNat(d)) =
      (sqrtNat(d) * sqrtNat(d)) * (realNat(y) * realNat(y))
    ring
  rw square at expand
  have left : realNat(x * x) = realNat(x) * realNat(x)
    exact realNat.mul at x, x
  have right : realNat(d * (y * y)) = realNat(d) * (realNat(y) * realNat(y))
    rw [realNat.mul, realNat.mul]
    rfl
  have total := LessEqual.total at x * x, d * (y * y)
  cases total with below | above
  . -- x² ≤ d y²: the distance is d y² − x², and x ≤ y √d.
    have value := natDist.of_le with below
    have cancel := sub.add_cancel_left with below
    have distNonneg := realNat.nonnegative at d * (y * y) - x * x
    have asReal := realNat.add at x * x, d * (y * y) - x * x
    rw [cancel, left, right] at asReal
    have squares : realNat(x) * realNat(x) ≤
        (realNat(y) * sqrtNat(d)) * (realNat(y) * sqrtNat(d))
      rw expand
      linarith
    have le := realMulValue.le_of_square_le with xNonneg, productNonneg, squares
    have nonpositive : realNat(x) - realNat(y) * sqrtNat(d) ≤ 0 by linarith
    have absValue := abs.of_nonpositive with nonpositive
    rw [value, absValue]
    linear_combination -asReal - (realNat(y) * realNat(y)) * square
  . -- d y² ≤ x²: the distance is x² − d y², and y √d ≤ x.
    have value := natDist.of_ge with above
    have cancel := sub.add_cancel_left with above
    have distNonneg := realNat.nonnegative at x * x - d * (y * y)
    have asReal := realNat.add at d * (y * y), x * x - d * (y * y)
    rw [cancel, left, right] at asReal
    have squares : (realNat(y) * sqrtNat(d)) * (realNat(y) * sqrtNat(d)) ≤
        realNat(x) * realNat(x)
      rw expand
      linarith
    have le := realMulValue.le_of_square_le with productNonneg, xNonneg, squares
    have nonnegative : 0 ≤ realNat(x) - realNat(y) * sqrtNat(d) by linarith
    have absValue := abs.of_nonnegative with nonnegative
    rw [value, absValue]
    linear_combination -asReal + (realNat(y) * realNat(y)) * square

-- The real order on naturals reflects the natural order.
theorem realNat.lt_of_real_lt (m n : Nat)
  requires less : realNat(m) < realNat(n)
  shows m < n
proof
  have notLe : ¬(n ≤ m)
    intro le
    have mono := realNat.le_of_natural_le with le
    exact realLe.not_less with mono, less
  exact Less.of_not_LessEqual with notLe

-- Dirichlet's pair is an approximant: |x − y √d| < 1/N ≤ 1/y gives
-- x < y √d + 1, so |x² − d y²| < (2 y √d + 1) / y ≤ 2 √d + 1 ≤ 3d.

theorem pellPairs.of_approximation (d x y N : Nat)
  requires above : 1 < d
  requires positive : 0 < y
  requires below : y ≤ N
  requires close : abs((realNat(x):R) - (realNat(y):R) * sqrtNat(d)) *
    (realNat(N):R) < (1:R)
  shows (x, y) ∈ pellPairs(d, 3 * d)
proof
  have realRoot : Real(sqrtNat(d)) by typecheck
  have realDiff : Real(realNat(x) - realNat(y) * sqrtNat(d)) by typecheck
  have realAbs : Real(abs(realNat(x) - realNat(y) * sqrtNat(d))) by typecheck
  have absNonneg := abs.nonnegative with realDiff
  have upper := abs.upper with realDiff
  have dPositive : 0 < d by arith
  have rootPositive := sqrtNat.positive with dPositive
  have rootLe := sqrtNat.le_self with dPositive
  have dAbove := realNat.lt_of_lt at 1, d with above
  rw realNat.one at dAbove
  have yLe := realNat.le_of_natural_le with below
  have oneLeN : 1 ≤ N by arith
  have oneLe := realNat.le_of_natural_le at 1, N with oneLeN
  rw realNat.one at oneLe
  -- |x − y √d| ≤ |x − y √d| N < 1, and likewise times y.
  have scaledOne := realLe.mul_left_of_nonnegative with oneLe, absNonneg
  have unit := realMulValue.one_right with realAbs
  rw unit at scaledOne
  have scaledY := realLe.mul_left_of_nonnegative with yLe, absNonneg
  have absLess : abs(realNat(x) - realNat(y) * sqrtNat(d)) < 1 by linarith
  have absYLess : abs(realNat(x) - realNat(y) * sqrtNat(d)) * realNat(y) < 1
    linarith
  -- x + y √d < 1 + 2 y √d, so the product is below 1 + 2 √d ≤ 1 + 2 d.
  have sumLess : realNat(x) + realNat(y) * sqrtNat(d) <
      1 + 2 * (realNat(y) * sqrtNat(d))
    linarith
  have sumLe := realLess.implies_le with sumLess
  have scaledSum := realLe.mul_left_of_nonnegative with sumLe, absNonneg
  have regroup : abs(realNat(x) - realNat(y) * sqrtNat(d)) *
      (1 + 2 * (realNat(y) * sqrtNat(d))) =
      abs(realNat(x) - realNat(y) * sqrtNat(d)) +
        2 * ((abs(realNat(x) - realNat(y) * sqrtNat(d)) * realNat(y)) *
          sqrtNat(d))
    ring
  have scaledRoot := realLess.mul_right_of_positive with absYLess, rootPositive
  have unitRoot := realMulValue.one_left with realRoot
  rw unitRoot at scaledRoot
  have distance := pellPairs.real_distance at d, x, y
  have three : realNat(3 * d) = (3:R) * realNat(d)
    rw [realNat.mul, realNat.succ, realNat.succ, realNat.one]
    ring
  have realLess : realNat(natDist(x * x, d * (y * y))) < realNat(3 * d)
    rw [distance, three]
    linarith
  have natLess := realNat.lt_of_real_lt with realLess
  have memberIff := pellPairs.mem_iff at d, 3 * d, x, y
  apply memberIff.backward
  exact ⟨positive, natLess⟩

-- Arbitrarily many approximants: each pair with y > 0 keeps a positive
-- distance from the line x = y √d, so a finite set of pairs has a common
-- gap ε, and Dirichlet's pair for an N with 1/N < ε is a new pair.

theorem pellPairs.gap (d x y : Nat)
  requires nonsquare : ¬IsSquare(d)
  requires positive : 0 < y
  shows (0:R) < abs((realNat(x):R) - (realNat(y):R) * sqrtNat(d))
proof
  have distinct := sqrtNat.irrational at d, x, y with nonsquare, positive
  have nonzero : realNat(x) - realNat(y) * sqrtNat(d) ≠ 0
    intro zero
    have equal : realNat(x) = realNat(y) * sqrtNat(d) by linear_combination zero
    exact distinct with equal
  exact abs.positive_of_ne with nonzero

-- Induction on n with HasCardinality.insert_fresh: the new pair's own
-- distance is the next gap.
theorem pellPairs.many_gap (d n : Nat)
  requires nonsquare : ¬IsSquare(d)
  shows ∃ S, S ⊆ pellPairs(d, 3 * d) ∧ HasCardinality(S, n) ∧
    (∃ ε ∈ ℝ, (0:R) < (ε:R) ∧ (∀ q ∈ S,
      (ε:R) ≤ abs(realNat(fst(q)) - realNat(snd(q)) * sqrtNat(d))))
proof
  induction n
  | zero =>
    have emptySubset := empty.subset at pellPairs(d, 3 * d)
    have emptyCounted := HasCardinality.empty_set
    have oneIn : realOne ∈ ℝ by typecheck
    have onePositive := realZero.lt_one
    witness ∅
    refine ⟨emptySubset, emptyCounted, ?_⟩
    witness realOne
    refine ⟨oneIn, onePositive, ?_⟩
    intros q member
    exfalso
    exact set.empty with member
  | succ(k) using ih =>
    obtain ⟨S, subset, counted, ε, εIn, εPositive, bound⟩ := ih
    have above := IsSquare.above_one_of_not with nonsquare
    have rootNonneg := sqrtNat.nonnegative at d
    -- A natural N with 1/ε < N, so that 1 < ε N.
    have εNonzero : ε ≠ 0
      intro zero
      rw zero at εPositive
      linarith
    have inversePositive := realInvValue.positive with εPositive
    obtain ⟨N, NNat, NBig⟩ := Real.below_natural at realInvValue(ε)
    have NNonneg := realNat.nonnegative at N
    have NNonzero : N ≠ 0
      intro zero
      rw [zero, realNat.zero] at NBig
      linarith
    have NPositive := Less.positive_of_ne_zero with NNonzero
    have unit := realInvValue.mul_right with εNonzero
    have scaled := realLess.mul_left_of_positive with NBig, εPositive
    rw unit at scaled
    -- Dirichlet's pair for N is within 1/N < ε of the line.
    obtain ⟨x, xNat, y, yNat, yPositive, yLe, close⟩ :=
      dirichlet.approximation at sqrtNat(d), N with rootNonneg, NPositive
    have realAbs : Real(abs(realNat(x) - realNat(y) * sqrtNat(d))) by typecheck
    have absIn : abs(realNat(x) - realNat(y) * sqrtNat(d)) ∈ ℝ by typecheck
    have gapLess : abs(realNat(x) - realNat(y) * sqrtNat(d)) < ε
      have notLe : ¬(ε ≤ abs(realNat(x) - realNat(y) * sqrtNat(d)))
        intro le
        have scaledLe := realLe.mul_right_of_nonnegative with le, NNonneg
        linarith
      exact realLess.of_not_le with notLe
    have member := pellPairs.of_approximation at d, x, y, N
      with above, yPositive, yLe, close
    have gapPositive := pellPairs.gap at d, x, y with nonsquare, yPositive
    have fresh : ¬((x, y) ∈ S)
      intro inS
      have atPair := bound with (x, y), inS
      rw [fst.pair, snd.pair] at atPair
      linarith
    have countedMore := HasCardinality.insert_fresh with counted, fresh
    witness insert((x, y), S)
    refine ⟨?_, countedMore, ?_⟩
    . intros q qIn
      have split := insert.membership.forward with qIn
      cases split with same | old
      . rw same
        exact member
      . exact subset with q, old
    . witness abs(realNat(x) - realNat(y) * sqrtNat(d))
      refine ⟨absIn, gapPositive, ?_⟩
      intros q qIn
      have split := insert.membership.forward with qIn
      cases split with same | old
      . rw [same, fst.pair, snd.pair]
        exact realLe.reflexive with realAbs
      . have oldGap := bound with q, old
        have inPairs := subset with q, old
        have inProduct := (pellPairs.membership.forward with inPairs).left
        obtain ⟨_, a, aIn, b, bIn, shape⟩ :=
          product.membership.forward with inProduct
        rw [shape, fst.pair, snd.pair] at oldGap
        rw [shape, fst.pair, snd.pair]
        linarith

theorem pellPairs.many (d n : Nat)
  requires nonsquare : ¬IsSquare(d)
  shows ∃ S, S ⊆ pellPairs(d, 3 * d) ∧ HasCardinality(S, n)
proof
  obtain ⟨S, subset, counted, _⟩ :=
    pellPairs.many_gap at d, n with nonsquare
  witness S
  exact ⟨subset, counted⟩
