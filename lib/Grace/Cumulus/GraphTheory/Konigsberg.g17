module Grace.Cumulus.GraphTheory.Konigsberg
import Multigraph
import Nat.Mod

-- Endpoint table follows Grant Passmore's Imandra Top 100 development:
-- https://github.com/imandra-ai/imandra-100-theorems/blob/main/src/konigsberg.iml
-- Regions 0,1,2,3 represent L1,L2,I1,I2; bridge i represents B(i+1).
-- Edges: (0,2), (0,2), (0,3), (1,2), (1,2), (1,3), (2,3).

theorem bridge_cases (i : Set)
  shows i ∈ 7 ↔ (i = 0 ∨ i = 1 ∨ i = 2 ∨ i = 3 ∨ i = 4 ∨ i = 5 ∨ i = 6)
proof
  have s1 := membership.successor_set{n := 1} at i with *
  have s2 := membership.successor_set{n := 2} at i with *
  have s3 := membership.successor_set{n := 3} at i with *
  have s4 := membership.successor_set{n := 4} at i with *
  have s5 := membership.successor_set{n := 5} at i with *
  have s6 := membership.successor_set{n := 6} at i with *
  have first := membership.one at i
  tauto

theorem region0
  shows 0 ∈ 4
proof
  simp [next.natural, next.membership, Naturals.constructor.zero, Naturals.constructor.succ]

theorem region1
  shows 1 ∈ 4
proof
  simp [next.natural, next.membership, Naturals.constructor.zero, Naturals.constructor.succ]

theorem region2
  shows 2 ∈ 4
proof
  simp [next.natural, next.membership, Naturals.constructor.zero, Naturals.constructor.succ]

theorem region3
  shows 3 ∈ 4
proof
  simp [next.natural, next.membership, Naturals.constructor.zero, Naturals.constructor.succ]

def leftValue (i : Set) : Set :=
  chooseNat(equalNat(i, 6), 2,
    chooseNat(equalNat(i, 3), 1, chooseNat(equalNat(i, 4), 1, chooseNat(equalNat(i, 5), 1, 0))))

def rightValue (i : Set) : Set :=
  chooseNat(equalNat(i, 2), 3, chooseNat(equalNat(i, 5), 3, chooseNat(equalNat(i, 6), 3, 2)))

defgraph leftEnd (i ∈ 7) : 4 := leftValue(i)
proof
  have alternatives := bridge_cases.forward at i with member
  rcases alternatives with h0 | h1 | h2 | h3 | h4 | h5 | h6
  . rw h0
    have value : leftValue(0) = 0
      compute
    rw value
    exact region0
  . rw h1
    have value : leftValue(1) = 0
      compute
    rw value
    exact region0
  . rw h2
    have value : leftValue(2) = 0
      compute
    rw value
    exact region0
  . rw h3
    have value : leftValue(3) = 1
      compute
    rw value
    exact region1
  . rw h4
    have value : leftValue(4) = 1
      compute
    rw value
    exact region1
  . rw h5
    have value : leftValue(5) = 1
      compute
    rw value
    exact region1
  . rw h6
    have value : leftValue(6) = 2
      compute
    rw value
    exact region2

defgraph rightEnd (i ∈ 7) : 4 := rightValue(i)
proof
  have alternatives := bridge_cases.forward at i with member
  rcases alternatives with h0 | h1 | h2 | h3 | h4 | h5 | h6
  . rw h0
    have value : rightValue(0) = 2
      compute
    rw value
    exact region2
  . rw h1
    have value : rightValue(1) = 2
      compute
    rw value
    exact region2
  . rw h2
    have value : rightValue(2) = 3
      compute
    rw value
    exact region3
  . rw h3
    have value : rightValue(3) = 2
      compute
    rw value
    exact region2
  . rw h4
    have value : rightValue(4) = 2
      compute
    rw value
    exact region2
  . rw h5
    have value : rightValue(5) = 3
      compute
    rw value
    exact region3
  . rw h6
    have value : rightValue(6) = 3
      compute
    rw value
    exact region3

theorem graph
  shows Multigraph.Graph(4, 7, leftEnd, rightEnd)
proof
  unfold Multigraph.Graph
  refine ⟨leftEnd.function, rightEnd.function⟩

theorem leftValue.table
  shows leftValue(0) = 0 ∧ leftValue(1) = 0 ∧ leftValue(2) = 0 ∧ leftValue(3) = 1 ∧ leftValue(4) = 1 ∧ leftValue(5) = 1 ∧ leftValue(6) = 2
proof
  refine ⟨_, _, _, _, _, _, _⟩
  . compute
  . compute
  . compute
  . compute
  . compute
  . compute
  . compute

theorem rightValue.table
  shows rightValue(0) = 2 ∧ rightValue(1) = 2 ∧ rightValue(2) = 3 ∧ rightValue(3) = 2 ∧ rightValue(4) = 2 ∧ rightValue(5) = 3 ∧ rightValue(6) = 3
proof
  refine ⟨_, _, _, _, _, _, _⟩
  . compute
  . compute
  . compute
  . compute
  . compute
  . compute
  . compute

-- The complete degree table, with each bridge identity counted separately.
theorem degree_formula (x : Set)
  shows Multigraph.incidences(leftEnd, rightEnd, identity(7), x, 7) =
    add(add(mul(3, indicator({x}, 0)), mul(3, indicator({x}, 1))),
      add(mul(5, indicator({x}, 2)), mul(3, indicator({x}, 3))))
proof
  have member0 : 0 ∈ 7
    have shape := bridge_cases at 0
    have same : 0 = 0 by rfl
    tauto
  have member1 : 1 ∈ 7
    have shape := bridge_cases at 1
    have same : 1 = 1 by rfl
    tauto
  have member2 : 2 ∈ 7
    have shape := bridge_cases at 2
    have same : 2 = 2 by rfl
    tauto
  have member3 : 3 ∈ 7
    have shape := bridge_cases at 3
    have same : 3 = 3 by rfl
    tauto
  have member4 : 4 ∈ 7
    have shape := bridge_cases at 4
    have same : 4 = 4 by rfl
    tauto
  have member5 : 5 ∈ 7
    have shape := bridge_cases at 5
    have same : 5 = 5 by rfl
    tauto
  have member6 : 6 ∈ 7
    have shape := bridge_cases at 6
    have same : 6 = 6 by rfl
    tauto
  obtain ⟨l0, l1, l2, l3, l4, l5, l6⟩ := leftValue.table
  obtain ⟨r0, r1, r2, r3, r4, r5, r6⟩ := rightValue.table
  simp [Multigraph.incidences, identity.apply, leftEnd.value, rightEnd.value, mul, add.right_unit]
  ring

theorem degree_land1
  shows Multigraph.incidences(leftEnd, rightEnd, identity(7), 0, 7) = 3
proof
  rw degree_formula
  have different1 : 0 ≠ 1 by simp [Naturals.disjoint.zero.succ, Naturals.injective.succ]
  have different2 : 0 ≠ 2 by simp [Naturals.disjoint.zero.succ, Naturals.injective.succ]
  have different3 : 0 ≠ 3 by simp [Naturals.disjoint.zero.succ, Naturals.injective.succ]
  simp [indicator.singleton_self, indicator.singleton_other]

theorem degree_land2
  shows Multigraph.incidences(leftEnd, rightEnd, identity(7), 1, 7) = 3
proof
  rw degree_formula
  have different0 : 1 ≠ 0
    have reversed : 0 ≠ 1 by simp [Naturals.disjoint.zero.succ, Naturals.injective.succ]
    intro same
    cc
  have different2 : 1 ≠ 2 by simp [Naturals.disjoint.zero.succ, Naturals.injective.succ]
  have different3 : 1 ≠ 3 by simp [Naturals.disjoint.zero.succ, Naturals.injective.succ]
  simp [indicator.singleton_self, indicator.singleton_other]

theorem degree_island1
  shows Multigraph.incidences(leftEnd, rightEnd, identity(7), 2, 7) = 5
proof
  rw degree_formula
  have different0 : 2 ≠ 0
    have reversed : 0 ≠ 2 by simp [Naturals.disjoint.zero.succ, Naturals.injective.succ]
    intro same
    cc
  have different1 : 2 ≠ 1
    have reversed : 1 ≠ 2 by simp [Naturals.disjoint.zero.succ, Naturals.injective.succ]
    intro same
    cc
  have different3 : 2 ≠ 3 by simp [Naturals.disjoint.zero.succ, Naturals.injective.succ]
  simp [indicator.singleton_self, indicator.singleton_other]

theorem degree_island2
  shows Multigraph.incidences(leftEnd, rightEnd, identity(7), 3, 7) = 3
proof
  rw degree_formula
  have different0 : 3 ≠ 0
    have reversed : 0 ≠ 3 by simp [Naturals.disjoint.zero.succ, Naturals.injective.succ]
    intro same
    cc
  have different1 : 3 ≠ 1
    have reversed : 1 ≠ 3 by simp [Naturals.disjoint.zero.succ, Naturals.injective.succ]
    intro same
    cc
  have different2 : 3 ≠ 2
    have reversed : 2 ≠ 3 by simp [Naturals.disjoint.zero.succ, Naturals.injective.succ]
    intro same
    cc
  simp [indicator.singleton_self, indicator.singleton_other]

-- No start, finish, length, or ordering can traverse every bridge exactly once.
theorem no_euler_trail (edges vertices : Set, n : Nat)
  shows ¬Multigraph.EulerTrail(4, 7, leftEnd, rightEnd, edges, vertices, n)
proof
  have enumeration := identity.bijective at 7
  have distinct01 : 0 ≠ 1 by simp [Naturals.disjoint.zero.succ, Naturals.injective.succ]
  have distinct03 : 0 ≠ 3 by simp [Naturals.disjoint.zero.succ, Naturals.injective.succ]
  have distinct13 : 1 ≠ 3 by simp [Naturals.disjoint.zero.succ, Naturals.injective.succ]
  have degree0 : Odd(Multigraph.incidences(leftEnd, rightEnd, identity(7), 0, 7))
    rw degree_land1
    exact Odd.three
  have degree1 : Odd(Multigraph.incidences(leftEnd, rightEnd, identity(7), 1, 7))
    rw degree_land2
    exact Odd.three
  have degree3 : Odd(Multigraph.incidences(leftEnd, rightEnd, identity(7), 3, 7))
    rw degree_island2
    exact Odd.three
  exact Multigraph.EulerTrail.three_odd_obstruction at 4, 7, leftEnd, rightEnd,
    edges, vertices, identity(7), 0, 1, 3, n, 7 with *


theorem no_euler_trail_exists
  shows ¬(∃ n ∈ ℕ, ∃ edges, ∃ vertices,
    Multigraph.EulerTrail(4, 7, leftEnd, rightEnd, edges, vertices, n))
proof
  intro exists
  rcases exists with ⟨n, member, edges, vertices, trail⟩
  have natural := nat.omega.backward with member
  exact no_euler_trail with trail
