-- Authors: Grant Passmore

module Grace.Cumulus.GraphTheory.Flows.Splits
import Lifting
import Multigraph.Subgraph

-- An even set of one side of a split is even in the whole graph: no edge of
-- it has an end outside the side.
theorem EvenEdgeSet.of_side (V X leftEnd rightEnd F : Set)
  requires even : EvenEdgeSet(X, leftEnd, rightEnd, F)
  requires ends : ∀ e ∈ F, leftEnd(e) ∈ X ∧ rightEnd(e) ∈ X
  shows EvenEdgeSet(V, leftEnd, rightEnd, F)
proof
  obtain ⟨finite, degrees⟩ := even
  refine ⟨finite, _⟩
  intros v hv
  by_cases inX : v ∈ X
  . exact degrees with v, inX
  . -- No edge of F has an end at v.
    have none : incidentEnds(leftEnd, rightEnd, F, v) = ∅
      ext p
      constructor
      . intro hp
        obtain ⟨e, he, i, hi, rfl⟩ := incidentEnds.shape with hp
        obtain ⟨leftX, rightX⟩ := ends with e, he
        have sides := (incidentEnds.pair.forward with hp).right
        exfalso
        rcases sides with ⟨_, atLeft⟩ | ⟨_, atRight⟩
        . rw atLeft at leftX
          exact inX with leftX
        . rw atRight at rightX
          exact inX with rightX
      . intro hp
        simp at hp
    unfold degreeIn
    rw [none, cardinality.empty]
    exact Even.zero

-- A vertex set left by no edge splits the graph; covers of the two sides join.
theorem EvenCover.join (V E leftEnd rightEnd X F G : Set)
  requires graph : Graph(V, E, leftEnd, rightEnd)
  requires split : X ⊆ V ∧ crossing(leftEnd, rightEnd, E, X) = ∅
  requires first : EvenCover(X, inside(leftEnd, rightEnd, E, X), leftEnd,
    rightEnd, F)
  requires second : EvenCover(V ∖ X, inside(leftEnd, rightEnd, E, V ∖ X),
    leftEnd, rightEnd, G)
  shows ∃ H, EvenCover(V, E, leftEnd, rightEnd, H)
proof
  obtain ⟨subset, none⟩ := split
  obtain ⟨functionF, evenF, coversF⟩ := first
  obtain ⟨functionG, evenG, coversG⟩ := second
  have endsE := Graph.ends with graph
  -- The insides of the two sides are disjoint, and since no edge crosses
  -- between the sides, together they hold every edge.
  have apart : Disjoint(inside(leftEnd, rightEnd, E, X),
      inside(leftEnd, rightEnd, E, V ∖ X))
    rw Disjoint.iff
    intros e he inY
    have outside := difference.membership.forward with inY.right.left
    exact outside.right with he.right.left
  have sides : ∀ e ∈ E, e ∈ inside(leftEnd, rightEnd, E, X) ∨
      e ∈ inside(leftEnd, rightEnd, E, V ∖ X)
    intros e he
    obtain ⟨leftV, rightV⟩ := endsE with e, he
    have notCross : ¬e ∈ crossing(leftEnd, rightEnd, E, X)
      rw none
      simp
    by_cases leftX : leftEnd(e) ∈ X
    . left
      refine ⟨he, leftX, _⟩
      by_contra rightX
      apply notCross
      refine ⟨he, _⟩
      left
      exact ⟨leftX, rightX⟩
    . right
      have rightX : ¬rightEnd(e) ∈ X
        intro rightX
        apply notCross
        refine ⟨he, _⟩
        right
        exact ⟨rightX, leftX⟩
      exact ⟨he, (difference.membership.backward with leftV, leftX),
        (difference.membership.backward with rightV, rightX)⟩
  -- Coordinate by coordinate, the union of the two sides' even sets is an
  -- even set of the whole graph.
  have union : ∀ i ∈ 3, F(i) ∪ G(i) ∈ 𝒫(E) ∧
      EvenEdgeSet(V, leftEnd, rightEnd, F(i) ∪ G(i))
    intros i hi
    have subF : F(i) ⊆ inside(leftEnd, rightEnd, E, X) :=
      powerset.membership_iff.forward
        with (FunctionBetween.apply_closed with functionF, hi)
    have subG : G(i) ⊆ inside(leftEnd, rightEnd, E, V ∖ X) :=
      powerset.membership_iff.forward
        with (FunctionBetween.apply_closed with functionG, hi)
    have evenFi := EvenEdgeSet.of_side at V, X, leftEnd, rightEnd, F(i)
      with (evenF with i, hi),
        (ends_in.subset with (inside.ends at leftEnd, rightEnd, E, X), subF)
    have evenGi := EvenEdgeSet.of_side at V, V ∖ X, leftEnd, rightEnd, G(i)
      with (evenG with i, hi),
        (ends_in.subset with (inside.ends at leftEnd, rightEnd, E, V ∖ X),
          subG)
    have apartI : Disjoint(F(i), G(i)) :=
      Disjoint.of_subset_right
        with (Disjoint.of_subset_left with apart, subF), subG
    refine ⟨powerset.membership_iff.backward with (Subset.union2_iff.backward
      with ⟨(Subset.transitive with subF, inside.subset),
        (Subset.transitive with subG, inside.subset)⟩),
      (EvenEdgeSet.union_disjoint with evenFi, evenGi, apartI)⟩
  have zero : 0 ∈ 3 by simp [membership.three]
  have one : 1 ∈ 3 by simp [membership.three]
  have two : 2 ∈ 3 by simp [membership.three]
  obtain ⟨mem0, even0⟩ := union with 0, zero
  obtain ⟨mem1, even1⟩ := union with 1, one
  obtain ⟨mem2, even2⟩ := union with 2, two
  have values := tripleMap.value with mem0, mem1, mem2
  have valueAt : ∀ i ∈ 3,
      tripleMap(𝒫(E), F(0) ∪ G(0), F(1) ∪ G(1), F(2) ∪ G(2))(i) =
        F(i) ∪ G(i)
    intros i hi
    have cases := membership.three.forward with hi
    rcases cases with rfl | rfl | rfl
    . exact values.left
    . exact values.right.left
    . exact values.right.right
  witness tripleMap(𝒫(E), F(0) ∪ G(0), F(1) ∪ G(1), F(2) ∪ G(2))
  refine ⟨(tripleMap.function with mem0, mem1, mem2), _, _⟩
  . intros i hi
    have value := valueAt with i, hi
    rw value
    exact (union with i, hi).right
  . intros e he
    have cases := sides with e, he
    rcases cases with inX | inY
    . obtain ⟨i, hi, inF⟩ := coversF with e, inX
      have value := valueAt with i, hi
      refine ⟨i, hi, _⟩
      rw value
      simp [inF]
    . obtain ⟨i, hi, inG⟩ := coversG with e, inY
      have value := valueAt with i, hi
      refine ⟨i, hi, _⟩
      rw value
      simp [inG]

-- An even cover found with the restricted ends is one for the original
-- ends, since a degree reads only the ends of edges of the set.
theorem EvenCover.of_restricted (W V E leftEnd rightEnd D F : Set)
  requires graph : Graph(W, E, leftEnd, rightEnd)
  requires edges : D ⊆ E
  requires cover : EvenCover(V, D, restrict(leftEnd, D), restrict(rightEnd, D),
    F)
  shows EvenCover(V, D, leftEnd, rightEnd, F)
proof
  obtain ⟨function, even, covers⟩ := cover
  refine ⟨function, _, covers⟩
  intros i hi
  have subset : F(i) ⊆ D := powerset.membership_iff.forward
    with (FunctionBetween.apply_closed with function, hi)
  obtain ⟨finite, degrees⟩ := even with i, hi
  refine ⟨finite, _⟩
  intros v hv
  have same := degreeIn.restricted at W, E, D, F(i), leftEnd, rightEnd, v
    with graph, edges, subset
  rw ← same
  exact degrees with v, hv
