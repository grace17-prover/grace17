module Grace.Cumulus.GraphTheory.DijkstraIndex
import DijkstraVectors

namespace Dijkstra


theorem equalNat.false_iff (a b : Nat)
  shows equalNat(a, b) = Bool.false ↔ a ≠ b
proof
  exact Grace.Cumulus.Nat.Mod.equalNat.false_iff at a, b with *

theorem available.finite_iff (value : Option(ℕ), flag index target distance : Nat)
  shows Dijkstra.available(equalNat(flag, 1), value, index) = Option.some(Dijkstra.Candidate.value(target, distance)) ↔
    flag ≠ 1 ∧ value = Option.some(distance) ∧ index = target
proof
  have condition := Dijkstra.equalNat.boolean at flag, 1 with *
  have flagCases := Dijkstra.boolean_cases with condition
  cases flagCases with open | closed
  . have different := equalNat.false_iff.forward at flag, 1 with *{2}, open
    have valueCases := Dijkstra.option_cases at value with assumption
    cases valueCases with absent | finite
    . rw open
      rw absent
      have computed : Dijkstra.available(Bool.false, Option.none, index) = Option.none
        settle with Dijkstra.available, Dijkstra.availableOpen
      rw computed
      have noCandidate := Option.inductive.disjoint.none.some at Dijkstra.Candidate.value(target, distance)
      have noDistance := Option.inductive.disjoint.none.some at distance
      tauto
    . rcases finite with ⟨d, hd, valueEquality⟩
      rw open
      rw valueEquality
      have computed : Dijkstra.available(Bool.false, Option.some(d), index) = Option.some(Dijkstra.Candidate.value(index, d))
        settle with Dijkstra.available, Dijkstra.availableOpen
      rw computed
      constructor
      . intro same
        have pair := Option.inductive.injective.some with same
        have coordinates := Dijkstra.Candidate.inductive.injective.value with pair
        rcases coordinates with ⟨sameIndex, sameDistance⟩
        refine ⟨different, _, sameIndex⟩
        rw sameDistance
        rfl
      . intro facts
        rcases facts with ⟨notClosed, sameValue, sameIndex⟩
        have sameDistance := Option.inductive.injective.some with sameValue
        rw sameIndex
        rw sameDistance
        rfl
  . have sameFlag := Grace.Cumulus.Nat.Mod.equalNat.true_iff.forward at flag, 1 with *{2}, closed
    rw closed
    have computed : Dijkstra.available(Bool.true, value, index) = Option.none by settle with Dijkstra.available
    rw computed
    have noCandidate := Option.inductive.disjoint.none.some at Dijkstra.Candidate.value(target, distance)
    tauto

predicate IndexedOffer (A values flags start target distance : Set) :=
  ∃ offset ∈ ℕ, Less(offset, ListOps.length{A := A}(values)) ∧
    target = add(start, offset) ∧ Dijkstra.entry(values, offset) = Option.some(distance) ∧
    Dijkstra.flagAt(flags, offset) ≠ 1

theorem scanOffers.sound (A : Set, values : List(A), flags : List(ℕ), start target distance : Nat)
  requires cells : ∀ value ∈ A, Option(ℕ, value)
  requires offered : Option.some(Dijkstra.Candidate.value(target, distance)) ∈ Dijkstra.scanOffers{A := A}(values, flags, start)
  shows IndexedOffer(A, values, flags, start, target, distance)
proof
  induction values generalizing flags start
  | List.nil =>
    intros flags start flagsType startNat offered
    have computed : Dijkstra.scanOffers{A := A}(List.nil, flags, start) = {Option.none}
      settle with Dijkstra.scanOffers
    rw computed at offered
    have impossible := singleton.membership.forward with offered
    have distinct := Option.inductive.disjoint.none.some at Dijkstra.Candidate.value(target, distance)
    exfalso
    apply distinct
    symm
    exact impossible
  | List.cons(head, tail) using ih =>
    intros flags start flagsType startNat offered
    have alternatives : Option.some(Dijkstra.Candidate.value(target, distance)) = Dijkstra.available(equalNat(Dijkstra.boolHead(flags), 1), head, start) ∨ Option.some(Dijkstra.Candidate.value(target, distance)) ∈ Dijkstra.scanOffers{A := A}(tail, Dijkstra.boolTail(flags), succ(start))
      settle with Dijkstra.scanOffers, union2.membership, singleton.membership, offered
    cases alternatives with first | rest
    . have headType := cells with head, assumption
      have flagNat := Dijkstra.boolHead.natural with flagsType
      have equality : Dijkstra.available(equalNat(Dijkstra.boolHead(flags), 1), head, start) = Option.some(Dijkstra.Candidate.value(target, distance))
        symm
        exact first
      have facts := available.finite_iff.forward with headType, flagNat, startNat, *{2}, equality
      rcases facts with ⟨open, value, index⟩
      have zeroIn := nat.omega.forward with Naturals.constructor.zero
      have tailNat := ListOps.length.closed at A, tail with assumption
      have positive : Less(0, succ(ListOps.length{A := A}(tail)))
        unfold Less
        unfold LessEqual
        refine ⟨ListOps.length{A := A}(tail), tailNat, _⟩
        simp [add]
      unfold IndexedOffer
      refine ⟨0, zeroIn, _, _, _, _⟩
      . simp [ListOps.length]
      . rw ← index
        symm
        exact add.right_unit with startNat
      . simp [Dijkstra.entry, Dijkstra.optionHead]
      . simp [Dijkstra.flagAt]
        exact open
    . have flagsTail := Dijkstra.boolTail.closed at flags with flagsType
      have nextNat := Naturals.constructor.succ with startNat
      have previous := ih with Dijkstra.boolTail(flags), succ(start), flagsTail, nextNat, rest
      rcases previous with ⟨offset, offsetIn, bound, targetValue, distanceValue, open⟩
      have offsetNat := nat.omega.backward with offsetIn
      have nextOffsetNat := Naturals.constructor.succ with offsetNat
      have nextOffsetIn := nat.omega.forward with nextOffsetNat
      have tailNat := ListOps.length.closed at A, tail with assumption
      have larger := Dijkstra.successor_less_iff.backward with offsetNat, tailNat, bound
      have shifted := add.successor_shift with startNat, offsetNat
      unfold IndexedOffer
      refine ⟨succ(offset), nextOffsetIn, _, _, _, _⟩
      . simp [ListOps.length]
      . rw shifted
        exact targetValue
      . simp [Dijkstra.entry, Dijkstra.optionTail]
      . simp [Dijkstra.flagAt]
        exact open

theorem scanOffers.includes (A : Set, offset : Nat, values : List(A), flags : List(ℕ), start distance : Nat)
  requires cells : ∀ value ∈ A, Option(ℕ, value)
  requires bound : Less(offset, ListOps.length{A := A}(values))
  requires value : Dijkstra.entry(values, offset) = Option.some(distance)
  requires open : Dijkstra.flagAt(flags, offset) ≠ 1
  shows Option.some(Dijkstra.Candidate.value(add(start, offset), distance)) ∈ Dijkstra.scanOffers{A := A}(values, flags, start)
proof
  induction offset generalizing values flags start
  | zero =>
    intros values flags start valuesType flagsType startNat bound value open
    have shape := Dijkstra.list_cases with valuesType
    cases shape with empty | cons
    . rw empty at bound
      have lengthZero : ListOps.length{A := A}(List.nil) = 0 by settle with ListOps.length
      rw lengthZero at bound
      have impossible := Dijkstra.no_less_zero with Naturals.constructor.zero
      exfalso
      exact impossible with bound
    . rcases cons with ⟨head, headIn, tail, tailType, equality⟩
      have headType := cells with head, headIn
      have flagNat := Dijkstra.boolHead.natural with flagsType
      rw equality at value
      have headValue : head = Option.some(distance)
        simp [Dijkstra.entry, Dijkstra.optionHead] at value
        exact value
      have headOpen : Dijkstra.boolHead(flags) ≠ 1
        simp [Dijkstra.flagAt] at open
        exact open
      have facts : Dijkstra.boolHead(flags) ≠ 1 ∧ head = Option.some(distance) ∧ start = start
        refine ⟨headOpen, headValue, rfl⟩
      have available := available.finite_iff.backward with headType, flagNat, startNat, startNat, assumption, facts
      have sameIndex := add.right_unit with startNat
      rw sameIndex
      rw equality
      have collected : Dijkstra.scanOffers{A := A}(List.cons(head, tail), flags, start) = {Dijkstra.available(equalNat(Dijkstra.boolHead(flags), 1), head, start)} ∪ Dijkstra.scanOffers{A := A}(tail, Dijkstra.boolTail(flags), succ(start))
        settle with Dijkstra.scanOffers
      rw collected
      rw available
      apply union2.left
      exact singleton.self
  | succ(k) using ih =>
    intros values flags start valuesType flagsType startNat bound value open
    have shape := Dijkstra.list_cases with valuesType
    cases shape with empty | cons
    . rw empty at bound
      have lengthZero : ListOps.length{A := A}(List.nil) = 0 by settle with ListOps.length
      rw lengthZero at bound
      have skNat : Nat(succ(k)) by typecheck
      have impossible := Dijkstra.no_less_zero with skNat
      exfalso
      exact impossible with bound
    . rcases cons with ⟨head, headIn, tail, tailType, equality⟩
      have tailNat := ListOps.length.closed with tailType
      have kNat : Nat(k) by typecheck
      rw equality at bound
      have lengthStep : ListOps.length{A := A}(List.cons(head, tail)) = succ(ListOps.length{A := A}(tail))
        settle with ListOps.length
      rw lengthStep at bound
      have smaller := Dijkstra.successor_less_iff.forward with kNat, tailNat, bound
      rw equality at value
      have tailValue : Dijkstra.entry(tail, k) = Option.some(distance)
        simp [Dijkstra.entry, Dijkstra.optionTail] at value
        exact value
      have tailOpen : Dijkstra.flagAt(Dijkstra.boolTail(flags), k) ≠ 1
        simp [Dijkstra.flagAt] at open
        exact open
      have flagsTail := Dijkstra.boolTail.closed with flagsType
      have nextNat := Naturals.constructor.succ with startNat
      have previous := ih with tail, Dijkstra.boolTail(flags), succ(start), tailType, flagsTail, nextNat, smaller, tailValue, tailOpen
      have shift := add.successor_shift with startNat, kNat
      rw shift
      rw equality
      have collected : Dijkstra.scanOffers{A := A}(List.cons(head, tail), flags, start) = {Dijkstra.available(equalNat(Dijkstra.boolHead(flags), 1), head, start)} ∪ Dijkstra.scanOffers{A := A}(tail, Dijkstra.boolTail(flags), succ(start))
        settle with Dijkstra.scanOffers
      rw collected
      apply union2.right
      exact previous

theorem minimum.selected_entry (A : Set, values : List(A), flags : List(ℕ), target distance : Nat)
  requires cells : ∀ value ∈ A, Option(ℕ, value)
  requires chosen : Dijkstra.minimum(values, flags, 0) = Option.some(Dijkstra.Candidate.value(target, distance))
  shows Less(target, ListOps.length{A := A}(values)) ∧
    Dijkstra.entry(values, target) = Option.some(distance) ∧ Dijkstra.flagAt(flags, target) ≠ 1
proof
  obtain ⟨valid, member, least⟩ := Dijkstra.minimum.correct with Naturals.constructor.zero, cells
  rw chosen at member
  obtain ⟨offset, offsetIn, bound, targetValue, value, open⟩ := scanOffers.sound with Naturals.constructor.zero, cells, member
  have zeroAdd : add(0, offset) = offset by simp [add]
  rw zeroAdd at targetValue
  rw targetValue
  refine ⟨bound, value, open⟩

theorem minimum.le_open_entry (A : Set, values : List(A), flags : List(ℕ), target distance other cost : Nat)
  requires cells : ∀ value ∈ A, Option(ℕ, value)
  requires chosen : Dijkstra.minimum(values, flags, 0) = Option.some(Dijkstra.Candidate.value(target, distance))
  requires bound : Less(other, ListOps.length{A := A}(values))
  requires value : Dijkstra.entry(values, other) = Option.some(cost)
  requires open : Dijkstra.flagAt(flags, other) ≠ 1
  shows distance ≤ cost
proof
  have offered := scanOffers.includes at A, other, values, flags, 0, cost with Naturals.constructor.zero, cells, bound, value, open
  have zeroAdd : add(0, other) = other by simp [add]
  rw zeroAdd at offered
  obtain ⟨j, hj, c, hc, equality, order⟩ := Dijkstra.minimum.le_every_offer with Naturals.constructor.zero, cells, offered
  rw chosen at equality
  have pair := Option.inductive.injective.some with equality
  obtain ⟨indexEquality, distanceEquality⟩ := Dijkstra.Candidate.inductive.injective.value with pair
  rwa distanceEquality

theorem minimum.none_no_open_finite (A : Set, values : List(A), flags : List(ℕ), target distance : Nat)
  requires cells : ∀ value ∈ A, Option(ℕ, value)
  requires absent : Dijkstra.minimum(values, flags, 0) = Option.none
  requires bound : Less(target, ListOps.length{A := A}(values))
  requires value : Dijkstra.entry(values, target) = Option.some(distance)
  shows Dijkstra.flagAt(flags, target) = 1
proof
  by_contra open
  have offered := scanOffers.includes at A, target, values, flags, 0, distance with *{3}, Naturals.constructor.zero, assumption, cells, bound, value, open
  have zeroAdd : add(0, target) = target by settle with add
  rw zeroAdd at offered
  have characterization := Dijkstra.minimum.none_iff.forward with *{2}, Naturals.constructor.zero, cells, absent
  have targetIn := nat.omega.forward at target with assumption
  have distanceIn := nat.omega.forward at distance with assumption
  have impossible := characterization with target, targetIn, distance, distanceIn
  exact impossible with offered

theorem minimum.none_iff_no_open_finite (A : Set, values : List(A), flags : List(ℕ))
  requires cells : ∀ value ∈ A, Option(ℕ, value)
  shows Dijkstra.minimum(values, flags, 0) = Option.none ↔
    (∀ target ∈ ℕ, ∀ distance ∈ ℕ,
      Less(target, ListOps.length{A := A}(values)) → Dijkstra.entry(values, target) = Option.some(distance) → Dijkstra.flagAt(flags, target) = 1)
proof
  constructor
  . intros absent target targetIn distance distanceIn bound value
    have targetNat := nat.omega.backward with targetIn
    have distanceNat := nat.omega.backward with distanceIn
    exact minimum.none_no_open_finite with *
  . intro noOpen
    obtain ⟨valid, member, least⟩ := Dijkstra.minimum.correct with Naturals.constructor.zero, cells
    cases valid with absent | finite
    . exact absent
    . rcases finite with ⟨candidateIndex, candidateIndexIn, candidateCost, candidateCostIn, equality⟩
      have candidateIndexNat := nat.omega.backward with candidateIndexIn
      have candidateCostNat := nat.omega.backward with candidateCostIn
      have actual := minimum.selected_entry at A, values, flags, candidateIndex, candidateCost with *
      rcases actual with ⟨candidateBound, candidateValue, candidateOpen⟩
      have closed := noOpen with candidateIndex, candidateIndexIn, candidateCost, candidateCostIn, candidateBound, candidateValue
      exfalso
      exact candidateOpen with closed

end Dijkstra
