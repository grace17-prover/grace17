-- The even set of a disconnected last colour: on the stable partition the
-- packing condition leaves the last colour enough crossing edges to close a
-- nonempty even set, which holds an edge of finite level.
-- Part of Cumulus, the Grace17 mathematics library.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module Grace.Cumulus.GraphTheory.TreePacking.LastColour
import Levels

-- An edge of a colour below j lies in the union of the first j colours.
theorem coloursBelow.contains (T g : Set, j i : Nat)
  requires index : i ∈ j
  requires member : g ∈ T(i)
  shows g ∈ coloursBelow(T, j)
proof
  induction j
  | zero =>
    intro index
    exfalso
    rw nat.zero at index
    exact set.empty with index
  | succ(m) using ih =>
    intro index
    have cases := membership.successor_forward{n := m} with index
    unfold coloursBelow
    rcases cases with earlier | same
    . have inBelow := ih with earlier
      simp [inBelow]
    . rw same at member
      simp [member]

-- An edge of the first j colours has a colour below j, and the first j
-- colours lie in E.
theorem coloursBelow.colour (T g : Set, j : Nat)
  requires member : g ∈ coloursBelow(T, j)
  shows ∃ i ∈ j, g ∈ T(i)
proof
  induction j
  | zero =>
    intro member
    unfold coloursBelow at member
    exfalso
    exact set.empty with member
  | succ(m) using ih =>
    intro member
    unfold coloursBelow at member
    simp at member
    rcases member with earlier | last
    . obtain ⟨i, index, inT⟩ := ih with earlier
      have inSucc : i ∈ succ(m) by simp [index]
      exact ⟨i, inSucc, inT⟩
    . have self : m ∈ succ(m) by simp
      exact ⟨m, self, last⟩

-- Two facts about n − 1 beside sub.one_le_of_le_add_one.
theorem sub.one_of_add_one (a b : Nat)
  requires sum : a + 1 = b
  shows b - 1 = a
proof
  have shape := natural.zero_or_successor at b
  rcases shape with zero | ⟨q, natural, rfl⟩
  . rw zero at sum
    arith
  . rw [sub.one, predecessor.succ]
    arith

theorem sub.le_one_add_one (a : Nat)
  shows a ≤ (a - 1) + 1
proof
  have shape := natural.zero_or_successor at a
  rcases shape with zero | ⟨q, natural, rfl⟩
  . rw [zero, sub.zero_left]
    arith
  . rw [sub.one, predecessor.succ]
    arith

-- The first j trees, each internally connected on P, cross it in at most
-- j(|P| − 1) edges: exactly |P| − 1 each.
theorem coloursBelow.crossing_upper (V E P leftEnd rightEnd T : Set, k j : Nat)
  requires graph : Graph(V, E, leftEnd, rightEnd)
  requires finiteVertices : Finite(V)
  requires finiteEdges : Finite(E)
  requires partition : Partition(V, P)
  requires classes : ∀ i ∈ k, T(i) ⊆ E
  requires trees : ∀ i ∈ k, SpanningTree(V, leftEnd, rightEnd, T(i))
  requires internal :
    ∀ i ∈ k, InternallyConnected(leftEnd, rightEnd, T(i), P)
  requires below : j ≤ k
  shows coloursBelow(T, j) ⊆ E ∧
    cardinality(crossingClasses(P, leftEnd, rightEnd, coloursBelow(T, j))) ≤
      j * (cardinality(P) - 1)
proof
  induction j
  | zero =>
    intro below
    have finiteClasses := Partition.finite with finiteVertices, partition
    unfold coloursBelow
    refine ⟨empty.subset, ?_⟩
    have none : crossingClasses(P, leftEnd, rightEnd, ∅) = ∅
      ext e
      simp [crossingClasses]
    rw [none, cardinality.empty, mul.left_zero]
    arith
  | succ(m) using ih =>
    intro below
    have finiteClasses := Partition.finite with finiteVertices, partition
    have earlier : m ≤ k by arith
    obtain ⟨subsetE, count⟩ := ih with earlier
    have less : m < k by arith
    have inK := membership.of_Less at m, k with *, less
    have classE := classes with m, inK
    have ends := ends_in.subset with (Graph.ends with graph), classE
    have exact := SpanningTree.crossing_count with finiteVertices,
      partition, ends, (trees with m, inK), (internal with m, inK)
    have finiteBelow : Finite(crossingClasses(P, leftEnd, rightEnd,
        coloursBelow(T, m))) :=
      Finite.subset with finiteEdges,
        (Subset.transitive with crossingClasses.subset, subsetE)
    have finiteClass : Finite(crossingClasses(P, leftEnd, rightEnd, T(m))) :=
      Finite.subset with finiteEdges,
        (Subset.transitive with crossingClasses.subset, classE)
    have sum := cardinality.union_le with finiteBelow, finiteClass
    have bound := sub.one_of_add_one with exact
    have step := mul.succ_left at m, cardinality(P) - 1
    unfold coloursBelow
    refine ⟨(Subset.union2_iff.backward with ⟨subsetE, classE⟩), ?_⟩
    rw bound at count
    rw [crossingClasses.union, step, bound]
    arith

-- The forests inside a finite edge set form a finite family holding ∅.
theorem forestsIn.finite (V leftEnd rightEnd F : Set)
  requires finite : Finite(F)
  shows Finite(forestsIn(V, leftEnd, rightEnd, F))
proof
  have subset : forestsIn(V, leftEnd, rightEnd, F) ⊆ 𝒫(F)
    intros G inFamily
    exact inFamily.left
  exact Finite.subset with (Finite.powerset with finite), subset

theorem forestsIn.contains_empty (V leftEnd rightEnd F : Set)
  shows ∅ ∈ forestsIn(V, leftEnd, rightEnd, F)
proof
  have forest : Forest(V, leftEnd, rightEnd, ∅)
    constructor
    . exact Finite.empty
    . intros C bound even
      exact Subset.antisymmetric with bound, empty.subset
  exact ⟨(powerset.membership_iff.backward with empty.subset), forest⟩

-- A maximal forest inside an edge set R joins whatever R joins: an edge of
-- R leaving a component of the forest could be added to it.
theorem Forest.maximal_joined (V leftEnd rightEnd R G u v : Set)
  requires finiteVertices : Finite(V)
  requires ends : ∀ e ∈ R, leftEnd(e) ∈ V ∧ rightEnd(e) ∈ V
  requires member : G ∈ forestsIn(V, leftEnd, rightEnd, R)
  requires maximal :
    ∀ H ∈ forestsIn(V, leftEnd, rightEnd, R), G ⊆ H → H = G
  requires vertex : u ∈ V
  requires joined : Joined(leftEnd, rightEnd, R, u, v)
  shows Joined(leftEnd, rightEnd, G, u, v)
proof
  obtain ⟨inPowerset, forest⟩ := member
  have subsetR := powerset.membership_iff.forward with inPowerset
  have endsG := ends_in.subset with ends, subsetR
  have closedG := componentBy.closed at V, leftEnd, rightEnd, G, u with endsG
  have selfU := componentBy.self at V, leftEnd, rightEnd, G, u with vertex
  have closedR : ClosedUnder(leftEnd, rightEnd, R,
      componentBy(V, leftEnd, rightEnd, G, u))
    intros e inR
    by_contra unbalanced
    have edgeEnds := ends with e, inR
    have outside : ¬e ∈ G
      intro inG
      exact unbalanced with (closedG with e, inG)
    have apartEnds : ¬Joined(leftEnd, rightEnd, G, leftEnd(e), rightEnd(e))
      intro joinedEnds
      exact unbalanced with (Joined.balanced with
        endsG, edgeEnds.left, edgeEnds.right, joinedEnds, closedG)
    have bigger := Forest.add_edge with
      finiteVertices, endsG, edgeEnds, forest, apartEnds
    have biggerSubset : G ∪ {e} ⊆ R := Subset.union2_iff.backward with
      ⟨subsetR, (singleton.subset_iff.backward with inR)⟩
    have biggerIn : G ∪ {e} ∈ forestsIn(V, leftEnd, rightEnd, R) :=
      ⟨(powerset.membership_iff.backward with biggerSubset), bigger⟩
    have equal := maximal with G ∪ {e}, biggerIn, union2.subset_left
    have inBigger : e ∈ G ∪ {e} by simp
    rw equal at inBigger
    exact outside with inBigger
  exact (joined with componentBy(V, leftEnd, rightEnd, G, u), selfU,
    closedR).right

theorem Forest.maximal_components (V leftEnd rightEnd R G : Set)
  requires finiteVertices : Finite(V)
  requires ends : ∀ e ∈ R, leftEnd(e) ∈ V ∧ rightEnd(e) ∈ V
  requires member : G ∈ forestsIn(V, leftEnd, rightEnd, R)
  requires maximal :
    ∀ H ∈ forestsIn(V, leftEnd, rightEnd, R), G ⊆ H → H = G
  shows componentsBy(V, leftEnd, rightEnd, G) =
    componentsBy(V, leftEnd, rightEnd, R)
proof
  have subsetR := powerset.membership_iff.forward with member.left
  have same : ∀ u ∈ V, componentBy(V, leftEnd, rightEnd, G, u) =
      componentBy(V, leftEnd, rightEnd, R, u)
    intros u vertex
    ext v
    constructor
    . intro inG
      exact ⟨inG.left, (Joined.monotone with subsetR, inG.right)⟩
    . intro inR
      exact ⟨inR.left, (Forest.maximal_joined with
        finiteVertices, ends, member, maximal, vertex, inR.right)⟩
  ext X
  constructor
  . intro inG
    obtain ⟨u, vertex, rfl⟩ := inG
    rw same with u, vertex
    exact componentsBy.contains with vertex
  . intro inR
    obtain ⟨u, vertex, rfl⟩ := inR
    rw ← same with u, vertex
    exact componentsBy.contains with vertex

-- On a partition P where every colour is internally connected, the packing
-- condition leaves the last colour at least |P| − 1 crossing edges; with a
-- maximal forest of its edges inside the classes, which has the classes as
-- components, these make |V| − 1 edges that do not connect V, so they hold
-- a nonempty even set, which the forest cannot contain.
theorem Kaiser.crossing_cycle (V E P leftEnd rightEnd T : Set, k : Nat)
  requires graph : Graph(V, E, leftEnd, rightEnd)
  requires finiteVertices : Finite(V)
  requires finiteEdges : Finite(E)
  requires partition : Partition(V, P)
  requires decomposition : Decomposition(E, T, succ(k))
  requires trees : ∀ i ∈ k, SpanningTree(V, leftEnd, rightEnd, T(i))
  requires internal :
    ∀ i ∈ succ(k), InternallyConnected(leftEnd, rightEnd, T(i), P)
  requires condition : PackingCondition(V, E, leftEnd, rightEnd, succ(k))
  requires disconnected : ¬Connects(V, leftEnd, rightEnd, T(k))
  shows ∃ C, C ⊆ T(k) ∧ EvenEdgeSet(V, leftEnd, rightEnd, C) ∧
    (∃ e ∈ C, e ∈ crossingClasses(P, leftEnd, rightEnd, T(k)))
proof
  have kIn : k ∈ succ(k) by simp
  have endsE := Graph.ends with graph
  have classK := Decomposition.class_subset with decomposition, kIn
  have endsK := ends_in.subset with endsE, classK
  have finiteK := Finite.subset with finiteEdges, classK
  have finiteClasses := Partition.finite with finiteVertices, partition
  have crossingSubset := crossingClasses.subset at P, leftEnd, rightEnd, T(k)
  have finiteCrossing : Finite(crossingClasses(P, leftEnd, rightEnd, T(k))) :=
    Finite.subset with finiteK, crossingSubset
  -- The last colour crosses P at least |P| − 1 times.
  have classes : ∀ i ∈ k, T(i) ⊆ E
    intros i index
    have iNat := natural.member at k with i, index
    have inSucc : i ∈ succ(k) by simp [index]
    exact Decomposition.class_subset with decomposition, inSucc
  have internalBelow :
      ∀ i ∈ k, InternallyConnected(leftEnd, rightEnd, T(i), P)
    intros i index
    have inSucc : i ∈ succ(k) by simp [index]
    exact internal with i, inSucc
  obtain ⟨belowE, upper⟩ := coloursBelow.crossing_upper with graph,
    finiteVertices, finiteEdges, partition, classes, trees, internalBelow,
    (LessEqual.reflexive at k)
  have cover : E ⊆ coloursBelow(T, k) ∪ T(k)
    intros g inE
    obtain ⟨i, index, inT⟩ := decomposition.right.left with g, inE
    have iNat := natural.member at succ(k) with i, index
    have cases := membership.successor_forward{n := k} with index
    rcases cases with earlier | same
    . have inBelow := coloursBelow.contains with earlier, inT
      simp [inBelow]
    . rw same at inT
      simp [inT]
  have finiteBelow : Finite(crossingClasses(P, leftEnd, rightEnd,
      coloursBelow(T, k))) :=
    Finite.subset with finiteEdges,
      (Subset.transitive with crossingClasses.subset, belowE)
  have covered := crossingClasses.monotone at P, leftEnd, rightEnd, E,
    coloursBelow(T, k) ∪ T(k) with cover
  rw crossingClasses.union at covered
  have boundE := cardinality.monotone with
    (Finite.union with finiteBelow, finiteCrossing), covered
  have sumLe := cardinality.union_le with finiteBelow, finiteCrossing
  have packed := condition with P, partition
  have step := mul.succ_left at k, cardinality(P) - 1
  rw step at packed
  have lowerK : cardinality(P) - 1 ≤
      cardinality(crossingClasses(P, leftEnd, rightEnd, T(k))) by arith
  have lowerP := sub.le_one_add_one at cardinality(P)
  -- A maximal forest among the edges of T(k) inside the classes.
  have restSubset := difference.subset_left
    at T(k), crossingClasses(P, leftEnd, rightEnd, T(k))
  have restFinite := Finite.subset with finiteK, restSubset
  have restEnds := ends_in.subset with endsK, restSubset
  have finiteFamily := forestsIn.finite at V, leftEnd, rightEnd,
    T(k) ∖ crossingClasses(P, leftEnd, rightEnd, T(k)) with restFinite
  have emptyForest := forestsIn.contains_empty at V, leftEnd, rightEnd,
    T(k) ∖ crossingClasses(P, leftEnd, rightEnd, T(k))
  obtain ⟨G, inFamily, _, maximal⟩ :=
    Finite.maximal_extension with finiteFamily, emptyForest
  obtain ⟨inPowerset, forest⟩ := inFamily
  have finiteG := forest.left
  have subsetRest := powerset.membership_iff.forward with inPowerset
  have endsG := ends_in.subset with restEnds, subsetRest
  have components : componentsBy(V, leftEnd, rightEnd, G) = P
    rw ← (componentsBy.eq_classes with
      partition, endsK, (internal with k, kIn))
    exact Forest.maximal_components with
      finiteVertices, restEnds, inFamily, maximal
  have upperG := Forest.edge_bound with finiteVertices, endsG, forest
  have lowerG := componentsBy.lower_bound with finiteVertices, finiteG, endsG
  rw components at upperG, lowerG
  -- The forest with the crossing edges: |V| − 1 edges or more, inside T(k).
  have apart : Disjoint(G, crossingClasses(P, leftEnd, rightEnd, T(k))) :=
    Disjoint.of_subset_left with Disjoint.difference_left, subsetRest
  have sum := cardinality.union_disjoint with finiteG, finiteCrossing, apart
  have subsetK : G ∪ crossingClasses(P, leftEnd, rightEnd, T(k)) ⊆ T(k) :=
    Subset.union2_iff.backward with
      ⟨(Subset.transitive with subsetRest, restSubset), crossingSubset⟩
  have endsF := ends_in.subset with endsK, subsetK
  have finiteF := Finite.subset with finiteK, subsetK
  have dense : cardinality(V) ≤
      cardinality(G ∪ crossingClasses(P, leftEnd, rightEnd, T(k))) + 1
    rw sum
    arith
  have disconnectedF : ¬Connects(V, leftEnd, rightEnd,
      G ∪ crossingClasses(P, leftEnd, rightEnd, T(k)))
    intro connected
    apply disconnected
    intros u hu v hv
    exact Joined.monotone with subsetK, (connected with u, hu, v, hv)
  obtain ⟨C, subsetC, nonemptyC, even⟩ := EvenEdgeSet.of_dense_disconnected
    with finiteVertices, finiteF, endsF, dense, disconnectedF
  -- The even set is not inside the forest, so it holds a crossing edge.
  have escapes : ∃ e ∈ C, ¬e ∈ G
    by_contra none
    have inG : C ⊆ G
      intros e inC
      by_contra outside
      exact none with ⟨e, inC, outside⟩
    exact nonemptyC with (forest.right with C, inG, even)
  obtain ⟨e, inC, outside⟩ := escapes
  have crossing : e ∈ crossingClasses(P, leftEnd, rightEnd, T(k))
    have inF := subsetC with e, inC
    simp at inF
    rcases inF with inG | inCrossing
    . exfalso
      exact outside with inG
    . exact inCrossing
  exact ⟨C, (Subset.transitive with subsetC, subsetK), even,
    e, inC, crossing⟩

-- When the last colour is disconnected, the packing condition leaves it at
-- least |P_∞| − 1 edges crossing the stable partition, so it contains an
-- even set, and that even set has an edge of finite level.
theorem Kaiser.cycle_edge (V E leftEnd rightEnd T : Set, k : Nat)
  requires graph : Graph(V, E, leftEnd, rightEnd)
  requires finiteVertices : Finite(V)
  requires finiteEdges : Finite(E)
  requires nonempty : V ≠ ∅
  requires decomposition : Decomposition(E, T, succ(k))
  requires trees : ∀ i ∈ k, SpanningTree(V, leftEnd, rightEnd, T(i))
  requires condition : PackingCondition(V, E, leftEnd, rightEnd, succ(k))
  requires disconnected : ¬Connects(V, leftEnd, rightEnd, T(k))
  shows ∃ C, C ⊆ T(k) ∧ EvenEdgeSet(V, leftEnd, rightEnd, C) ∧
    (∃ e ∈ C, ∃ n ∈ ℕ,
      FiniteLevel(V, leftEnd, rightEnd, T, e, succ(k), n))
proof
  have partition :
      Partition(V, stablePartition(V, leftEnd, rightEnd, T, succ(k)))
    unfold stablePartition
    exact partitionSequence.partition with graph, nonempty, decomposition
  have internal := stablePartition.internal with
    graph, finiteVertices, nonempty, decomposition
  obtain ⟨C, subsetC, even, e, inC, crossing⟩ := Kaiser.crossing_cycle with
    graph, finiteVertices, finiteEdges, partition, decomposition, trees,
    internal, condition, disconnected
  have kIn : k ∈ succ(k) by simp
  have ends := Decomposition.ends with graph, decomposition, kIn
  obtain ⟨n, natural, _, level⟩ := FiniteLevel.of_crossing with
    finiteVertices, partition, (ends with e, (subsetC with e, inC)), crossing
  exact ⟨C, subsetC, even, e, inC, n, natural, level⟩
