module Grace.Cumulus.GraphTheory.DijkstraProofs
import Dijkstra
import WeightedPaths

namespace Dijkstra

theorem less.true_iff (a b : Nat)
  shows Dijkstra.less(a, b) = Bool.true ↔ a < b
proof
  induction a generalizing b
  | zero =>
    intros b bNat
    have shape := natural.zero_or_successor with bNat
    cases shape with equal | successor
    . rw equal
      have computed : Dijkstra.less(0, 0) = Bool.false by simp [Dijkstra.less, isZero, BoolOps.not]
      rw computed
      have distinct := Bool.inductive.disjoint.false.true
      have noLess := Less.irreflexive with Naturals.constructor.zero
      tauto
    . rcases successor with ⟨k, kNat, bShape⟩
      rw bShape
      have computed : Dijkstra.less(0, succ(k)) = Bool.true by simp [Dijkstra.less, isZero, BoolOps.not]
      rw computed
      constructor
      . intro truth
        unfold Less
        unfold LessEqual
        refine ⟨k, kNat, _⟩
        simp [add]
      . intro order
        rfl
  | succ(k) using ih =>
    intros b bNat
    have shape := natural.zero_or_successor with bNat
    cases shape with equal | successor
    . rw equal
      have computed : Dijkstra.less(succ(k), 0) = Bool.false
        settle with Dijkstra.less, isZero, predecessor, BoolOps.not, BoolOps.and
      rw computed
      have distinct := Bool.inductive.disjoint.false.true
      have noLess : ¬Less(succ(k), 0)
        intro impossible
        have skNat : Nat(succ(k)) by typecheck
        have member := membership.of_Less with skNat, Naturals.constructor.zero, impossible
        rw nat.zero at member
        exact set.empty with member
      tauto
    . rcases successor with ⟨j, jNat, bShape⟩
      rw bShape
      have reduced : Dijkstra.less(succ(k), succ(j)) = Dijkstra.less(k, j)
        settle with Dijkstra.less, isZero, predecessor, BoolOps.not, BoolOps.and
      rw reduced
      have inner := ih with j, jNat
      constructor
      . intro truth
        have order := inner.forward with truth
        have lifted := Less.add_LessEqual at k, j, 1, 1 with assumption, jNat, *{2}, order, LessEqual.reflexive at 1 with assumption
        simp [add.right_one] at lifted
        exact lifted
      . intro order
        have smaller : k < j
          apply Less.add_right_cancel at k, j, 1
          . simp [add.right_one]
        exact inner.backward with smaller


theorem boolean_cases (b : Bool)
  shows b = Bool.false ∨ b = Bool.true
proof
  induction b
  | Bool.false =>
    left
    rfl
  | Bool.true =>
    right
    rfl

theorem option_cases (o : Option(ℕ))
  shows o = Option.none ∨ ∃ d ∈ ℕ, o = Option.some(d)
proof
  induction o
  | Option.none =>
    left
    rfl
  | Option.some(d) =>
    right
    refine ⟨d, assumption, rfl⟩

theorem candidate_cases (c : Dijkstra.Candidate(ℕ,ℕ))
  shows ∃ i ∈ ℕ, ∃ d ∈ ℕ, c = Dijkstra.Candidate.value(i, d)
proof
  induction c
  | Dijkstra.Candidate.value(i, d) =>
    refine ⟨i, assumption, d, assumption, rfl⟩

theorem less.boolean (a b : Nat)
  shows Bool(Dijkstra.less(a, b))
proof
  induction a generalizing b
  | zero =>
    intros b bNat
    have shape := natural.zero_or_successor with bNat
    cases shape with equal | successor
    . rw equal
      have computed : Dijkstra.less(0, 0) = Bool.false by simp [Dijkstra.less, isZero, BoolOps.not]
      rw computed
      exact Bool.inductive.constructor.false
    . rcases successor with ⟨k, kNat, equal⟩
      rw equal
      have computed : Dijkstra.less(0, succ(k)) = Bool.true by simp [Dijkstra.less, isZero, BoolOps.not]
      rw computed
      exact Bool.inductive.constructor.true
  | succ(k) using ih =>
    intros b bNat
    have shape := natural.zero_or_successor with bNat
    cases shape with equal | successor
    . rw equal
      have computed : Dijkstra.less(succ(k), 0) = Bool.false
        settle with Dijkstra.less, isZero, BoolOps.not, BoolOps.and
      rw computed
      exact Bool.inductive.constructor.false
    . rcases successor with ⟨j, jNat, equal⟩
      rw equal
      have computed : Dijkstra.less(succ(k), succ(j)) = Dijkstra.less(k, j)
        settle with Dijkstra.less, isZero, predecessor, BoolOps.not, BoolOps.and
      rw computed
      exact ih with j, jNat

theorem less.false_iff (a b : Nat)
  shows Dijkstra.less(a, b) = Bool.false ↔ b ≤ a
proof
  have typed := less.boolean at a, b with *
  have shape := boolean_cases with typed
  have meaning := less.true_iff at a, b with *
  have distinct := Bool.inductive.disjoint.false.true
  constructor
  . intro no
    have notLess : ¬(a < b)
      intro order
      have yes := meaning.backward with order
      rw no at yes
      exact distinct with yes
    exact LessEqual.of_not_Less with *
  . intro order
    cases shape with no | yes
    . exact no
    . have strict := meaning.forward with yes
      have cycle : a < a by arith
      have noCycle := Less.irreflexive at a
      exfalso
      exact noCycle with cycle


theorem chooseDistance.selects (first second : Set, condition : Bool)
  shows Dijkstra.chooseDistance(condition, first, second) = first ∨
    Dijkstra.chooseDistance(condition, first, second) = second
proof
  induction condition
  | Bool.false =>
    right
    simp [Dijkstra.chooseDistance]
  | Bool.true =>
    left
    simp [Dijkstra.chooseDistance]

theorem minOption.selects (old new : Option(ℕ))
  shows Dijkstra.minOption(old, new) = old ∨ Dijkstra.minOption(old, new) = new
proof
  induction old generalizing new
  | Option.none =>
    intros new newType
    right
    settle with Dijkstra.minOption
  | Option.some(d) =>
    intros new newType
    have shape := option_cases with newType
    cases shape with absent | present
    . rw absent
      left
      settle with Dijkstra.minOption, Dijkstra.minSome
    . rcases present with ⟨e, he, equality⟩
      rw equality
      have dNat : Nat(d) by typecheck
      have eNat := nat.omega.backward with he
      have condition := less.boolean with eNat, dNat
      have selected := chooseDistance.selects at Option.some(e), Option.some(d), Dijkstra.less(e, d) with condition
      simp [Dijkstra.minOption, Dijkstra.minSome]

theorem minOption.finite (a b : Nat)
  shows ∃ d ∈ ℕ, Dijkstra.minOption(Option.some(a), Option.some(b)) = Option.some(d) ∧
    (d = a ∨ d = b) ∧ d ≤ a ∧ d ≤ b
proof
  have condition := less.boolean at b, a with *
  have shape := boolean_cases with condition
  cases shape with no | yes
  . have order := less.false_iff.forward at b, a with *{2}, no
    have aIn := nat.omega.forward at a with assumption
    have same := LessEqual.reflexive at a with assumption
    have computed : Dijkstra.minOption(Option.some(a), Option.some(b)) = Option.some(a)
      settle with Dijkstra.minOption, Dijkstra.minSome, Dijkstra.chooseDistance, no
    refine ⟨a, aIn, computed, _, same, order⟩
    left
    rfl
  . have strict := less.true_iff.forward at b, a with *{2}, yes
    have order := Less.implies_LessEqual at b, a with *
    have bIn := nat.omega.forward at b with assumption
    have same := LessEqual.reflexive at b with assumption
    have computed : Dijkstra.minOption(Option.some(a), Option.some(b)) = Option.some(b)
      settle with Dijkstra.minOption, Dijkstra.minSome, Dijkstra.chooseDistance, yes
    refine ⟨b, bIn, computed, _, order, same⟩
    right
    rfl

-- A finite distance is justified by a real path; none makes no claim.
predicate WitnessedDistance (V E weights source target distance : Set) :=
  ∀ d ∈ ℕ, distance = Option.some(d) → HasPathCost(V, E, weights, source, target, d)

theorem WitnessedDistance.minimum (V E weights source target : Set, old new : Option(ℕ))
  requires oldPath : WitnessedDistance(V, E, weights, source, target, old)
  requires newPath : WitnessedDistance(V, E, weights, source, target, new)
  shows WitnessedDistance(V, E, weights, source, target, Dijkstra.minOption(old, new))
proof
  have selected := minOption.selects at old, new with *
  cases selected with first | second
  . rw first
    exact oldPath
  . rw second
    exact newPath

theorem WitnessedDistance.some (V E weights source target : Set, cost : Nat)
  requires path : HasPathCost(V, E, weights, source, target, cost)
  shows WitnessedDistance(V, E, weights, source, target, Option.some(cost))
proof
  intros d hd equality
  have same := Option.inductive.injective.some with equality
  rwa ← same

theorem WitnessedDistance.none (V E weights source target : Set)
  shows WitnessedDistance(V, E, weights, source, target, Option.none)
proof
  intros d hd equality
  have impossible := Option.inductive.disjoint.none.some at d
  exfalso
  exact impossible with equality

theorem WitnessedDistance.extension (V E weights source u v : Set, c k : Nat)
  requires hu : u ∈ V
  requires hv : v ∈ V
  requires prefix : HasPathCost(V, E, weights, source, u, c)
  requires edge : WeightedEdge(E, weights, u, v, k)
  shows WitnessedDistance(V, E, weights, source, v,
    Dijkstra.extension(Option.some(c), Option.some(k)))
proof
  have path := HasPathCost.extend with hu, hv, prefix, edge
  have result := WitnessedDistance.some with path
  simp [Dijkstra.extension, Dijkstra.extendSome]


theorem minOption.closed (old new : Option(ℕ))
  shows Option(ℕ, Dijkstra.minOption(old, new))
proof
  have selected := minOption.selects at old, new with *
  cases selected with first | second
  . rw first
    assumption
  . rw second
    assumption

theorem extension.closed (distance weight : Option(ℕ))
  shows Option(ℕ, Dijkstra.extension(distance, weight))
proof
  induction distance generalizing weight
  | Option.none =>
    intros weight weightType
    have computed : Dijkstra.extension(Option.none, weight) = Option.none
      settle with Dijkstra.extension
    rw computed
    exact Option.inductive.constructor.none at ℕ
  | Option.some(c) =>
    intros weight weightType
    have shape := option_cases at weight with weightType
    cases shape with absent | present
    . rw absent
      have computed : Dijkstra.extension(Option.some(c), Option.none) = Option.none
        settle with Dijkstra.extension, Dijkstra.extendSome
      rw computed
      exact Option.inductive.constructor.none at ℕ
    . rcases present with ⟨k, hk, equality⟩
      rw equality
      have computed : Dijkstra.extension(Option.some(c), Option.some(k)) = Option.some(add(c, k))
        settle with Dijkstra.extension, Dijkstra.extendSome
      rw computed
      have kNat := nat.omega.backward at k with hk
      have sumNat := add.closed at k, c with kNat
      have sumIn := nat.omega.forward at add(c, k) with sumNat
      exact Option.inductive.constructor.some at ℕ, add(c, k) with sumIn

theorem WitnessedDistance.extend_option (V E weights source u v : Set, distance weight : Option(ℕ))
  requires hu : u ∈ V
  requires hv : v ∈ V
  requires sourcePaths : WitnessedDistance(V, E, weights, source, u, distance)
  requires edges : ∀ k ∈ ℕ, weight = Option.some(k) → WeightedEdge(E, weights, u, v, k)
  shows WitnessedDistance(V, E, weights, source, v, Dijkstra.extension(distance, weight))
proof
  have distanceShape := option_cases at distance with assumption
  have weightShape := option_cases at weight with assumption
  cases distanceShape with noDistance | finiteDistance
  . rw noDistance
    have computed : Dijkstra.extension(Option.none, weight) = Option.none by simp [Dijkstra.extension]
    rw computed
    exact WitnessedDistance.none
  . rcases finiteDistance with ⟨c, hc, distanceValue⟩
    cases weightShape with noEdge | finiteEdge
    . rw noEdge
      have computed := Dijkstra.extension.absent_edge at distance with assumption
      rw computed
      exact WitnessedDistance.none
    . rcases finiteEdge with ⟨k, hk, weightValue⟩
      have prefix := sourcePaths with c, hc, distanceValue
      have edge := edges with k, hk, weightValue
      have cNat := nat.omega.backward with hc
      have kNat := nat.omega.backward with hk
      rw [distanceValue, weightValue]
      exact WitnessedDistance.extension with cNat, kNat, hu, hv, prefix, edge

theorem WitnessedDistance.relax (V E weights source u v : Set, old weight distance : Option(ℕ), flag : Bool)
  requires hu : u ∈ V
  requires hv : v ∈ V
  requires oldPaths : WitnessedDistance(V, E, weights, source, v, old)
  requires sourcePaths : WitnessedDistance(V, E, weights, source, u, distance)
  requires edges : ∀ k ∈ ℕ, weight = Option.some(k) → WeightedEdge(E, weights, u, v, k)
  shows WitnessedDistance(V, E, weights, source, v, Dijkstra.relaxValue(old, weight, flag, distance))
proof
  induction flag
  | Bool.false =>
    have extended := WitnessedDistance.extend_option with *
    have selected := WitnessedDistance.minimum with oldPaths, extended
    simp [Dijkstra.relaxValue]
  | Bool.true =>
    have computed := Dijkstra.relaxValue.settled at old, weight, distance with *
    rwa computed

predicate DistanceAtMost (first second : Set) :=
  ∀ e ∈ ℕ, second = Option.some(e) →
    ∃ d ∈ ℕ, first = Option.some(d) ∧ d ≤ e

theorem DistanceAtMost.reflexive (distance : Set)
  shows DistanceAtMost(distance, distance)
proof
  intros e he equality
  have eNat := nat.omega.backward with he
  have same := LessEqual.reflexive with eNat
  refine ⟨e, he, equality, same⟩

theorem minOption.no_increase (old new : Option(ℕ))
  shows DistanceAtMost(Dijkstra.minOption(old, new), old)
proof
  intros e he oldValue
  have eNat := nat.omega.backward with he
  have newShape := option_cases at new with assumption
  cases newShape with absent | present
  . have same := LessEqual.reflexive at e with eNat
    refine ⟨e, he, _, same⟩
    rw absent
    have computed := Dijkstra.minOption.none_right at old with assumption
    rwa computed
  . rcases present with ⟨b, hb, newValue⟩
    have bNat := nat.omega.backward with hb
    obtain ⟨d, hd, computed, selected, leOld, leNew⟩ := minOption.finite with eNat, bNat
    refine ⟨d, hd, _, leOld⟩
    rwa [oldValue, newValue]

theorem relaxValue.no_increase (old weight distance : Option(ℕ), flag : Bool)
  shows DistanceAtMost(Dijkstra.relaxValue(old, weight, flag, distance), old)
proof
  induction flag
  | Bool.false =>
    have extensionType := extension.closed at distance, weight with *
    have bound := minOption.no_increase at old, Dijkstra.extension(distance, weight) with assumption, extensionType
    simp [Dijkstra.relaxValue]
  | Bool.true =>
    have computed := Dijkstra.relaxValue.settled at old, weight, distance with *
    rw computed
    exact DistanceAtMost.reflexive

end Dijkstra
