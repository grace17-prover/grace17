module Grace.Cumulus.GraphTheory.DijkstraFlags
import DijkstraVectors

namespace Dijkstra


theorem flagAt.nil (index : Nat)
  shows Dijkstra.flagAt(List.nil, index) = 1
proof
  induction index
  | zero =>
    simp
  | succ(k) using ih =>
    simp [Dijkstra.flagAt, Dijkstra.boolTail]

theorem mark.nil (index : Nat)
  shows Dijkstra.mark(List.nil, index) = List.nil
proof
  induction index
  | zero =>
    simp
  | succ(k) using ih =>
    simp [Dijkstra.mark, Dijkstra.keepHead]

theorem mark.closed (index : Nat, flags : List(ℕ))
  shows List(ℕ, Dijkstra.mark(flags, index))
proof
  induction index generalizing flags
  | zero =>
    intros flags flagsType
    have shape := Dijkstra.list_cases with flagsType
    cases shape with empty | cons
    . rw empty
      have computed := mark.nil with Naturals.constructor.zero
      rw computed
      exact List.inductive.constructor.nil
    . rcases cons with ⟨head, headIn, tail, tailType, equality⟩
      have oneIn := nat.omega.forward at 1 with assumption
      have constructed := List.inductive.constructor.cons with oneIn, tailType
      have computed : Dijkstra.mark(List.cons(head, tail), 0) = List.cons(1, tail)
        settle with Dijkstra.mark, Dijkstra.markHead
      rw equality
      rw computed
      exact constructed
  | succ(k) using ih =>
    intros flags flagsType
    have shape := Dijkstra.list_cases with flagsType
    cases shape with empty | cons
    . rw empty
      have skNat : Nat(succ(k)) by typecheck
      have computed := mark.nil with skNat
      rw computed
      exact List.inductive.constructor.nil
    . rcases cons with ⟨head, headIn, tail, tailType, equality⟩
      have previous := ih with tail, tailType
      have constructed := List.inductive.constructor.cons with headIn, previous
      have computed : Dijkstra.mark(List.cons(head, tail), succ(k)) = List.cons(head, Dijkstra.mark(tail, k))
        settle with Dijkstra.mark, Dijkstra.keepHead, Dijkstra.boolTail
      rw equality
      rw computed
      exact constructed

theorem mark.length (index : Nat, flags : List(ℕ))
  shows ListOps.length{A := ℕ}(Dijkstra.mark(flags, index)) = ListOps.length{A := ℕ}(flags)
proof
  induction index generalizing flags
  | zero =>
    intros flags flagsType
    have shape := Dijkstra.list_cases with flagsType
    cases shape with empty | cons
    . rw empty
      have computed := mark.nil with Naturals.constructor.zero
      rw computed
      rfl
    . rcases cons with ⟨head, headIn, tail, tailType, equality⟩
      rw equality
      simp [Dijkstra.mark, Dijkstra.markHead, ListOps.length]
  | succ(k) using ih =>
    intros flags flagsType
    have shape := Dijkstra.list_cases with flagsType
    cases shape with empty | cons
    . rw empty
      have skNat : Nat(succ(k)) by typecheck
      have computed := mark.nil with skNat
      rw computed
      rfl
    . rcases cons with ⟨head, headIn, tail, tailType, equality⟩
      have previous := ih with tail, tailType
      rw equality
      simp [Dijkstra.mark, Dijkstra.keepHead, Dijkstra.boolTail, ListOps.length]

theorem mark.at_same (index : Nat, flags : List(ℕ))
  shows Dijkstra.flagAt(Dijkstra.mark(flags, index), index) = 1
proof
  induction index generalizing flags
  | zero =>
    intros flags flagsType
    have shape := Dijkstra.list_cases with flagsType
    cases shape with empty | cons
    . rw empty
      simp
    . rcases cons with ⟨head, headIn, tail, tailType, equality⟩
      rw equality
      simp [Dijkstra.mark, Dijkstra.markHead, Dijkstra.flagAt, Dijkstra.boolHead]
  | succ(k) using ih =>
    intros flags flagsType
    have shape := Dijkstra.list_cases with flagsType
    cases shape with empty | cons
    . rw empty
      have skNat : Nat(succ(k)) by typecheck
      have computed := mark.nil with skNat
      rw computed
      exact flagAt.nil with skNat
    . rcases cons with ⟨head, headIn, tail, tailType, equality⟩
      have previous := ih with tail, tailType
      rw equality
      simp [Dijkstra.mark, Dijkstra.keepHead, Dijkstra.boolTail, Dijkstra.flagAt]

theorem mark.at_other (index target : Nat, flags : List(ℕ))
  requires distinct : target ≠ index
  shows Dijkstra.flagAt(Dijkstra.mark(flags, index), target) = Dijkstra.flagAt(flags, target)
proof
  induction index generalizing target flags
  | zero =>
    intros target flags targetNat flagsType distinct
    have targetShape := natural.zero_or_successor with targetNat
    cases targetShape with targetZero | targetNext
    . exfalso
      exact distinct with targetZero
    . rcases targetNext with ⟨j, jNat, targetEquality⟩
      have flagsShape := Dijkstra.list_cases with flagsType
      cases flagsShape with empty | cons
      . rw empty
        have computed := mark.nil with Naturals.constructor.zero
        rw computed
        rfl
      . rcases cons with ⟨head, headIn, tail, tailType, flagsEquality⟩
        rw flagsEquality
        rw targetEquality
        settle with Dijkstra.mark, Dijkstra.markHead, Dijkstra.flagAt, Dijkstra.boolTail
  | succ(k) using ih =>
    intros target flags targetNat flagsType distinct
    have skNat : Nat(succ(k)) by typecheck
    have flagsShape := Dijkstra.list_cases with flagsType
    cases flagsShape with empty | cons
    . rw empty
      have computed := mark.nil with skNat
      rw computed
      rfl
    . rcases cons with ⟨head, headIn, tail, tailType, flagsEquality⟩
      have targetShape := natural.zero_or_successor with targetNat
      cases targetShape with targetZero | targetNext
      . rw flagsEquality
        rw targetZero
        settle with Dijkstra.mark, Dijkstra.keepHead, Dijkstra.boolHead, Dijkstra.flagAt
      . rcases targetNext with ⟨j, jNat, targetEquality⟩
        have smallerDistinct : j ≠ k
          intro same
          apply distinct
          rw targetEquality
          rw same
          rfl
        have previous := ih with j, tail, jNat, tailType, smallerDistinct
        rw flagsEquality
        rw targetEquality
        simp [Dijkstra.mark, Dijkstra.keepHead, Dijkstra.boolTail, Dijkstra.flagAt]

end Dijkstra
