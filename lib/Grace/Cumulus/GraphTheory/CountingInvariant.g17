module Grace.Cumulus.GraphTheory.CountingInvariant
import Counting
import Cardinal.Enumeration

namespace GraphCount

theorem degree.reindex (V E f g x : Set, n m : Nat)
  requires enumerationF : BijectiveBetween(f, n, V)
  requires enumerationG : BijectiveBetween(g, m, V)
  shows GraphCount.degree(E, f, x, n) = GraphCount.degree(E, g, x, m)
proof
  have valuesF := Bijective.values with enumerationF
  have valuesG := Bijective.values with enumerationG
  have left := GraphCount.degree.neighbors at V, E, f, x, n with valuesF
  have right := GraphCount.degree.neighbors at V, E, g, x, m with valuesG
  rw [left, right]
  exact countMembers.reindex with enumerationF, enumerationG

-- Cross sums allow two independent enumerations of the two endpoints.
def crossSum (E f g : Set, n m : Nat) → Set
  | E, f, g, n, zero => 0
  | E, f, g, n, succ(k) => add(crossSum(E, f, g, n, k), GraphCount.degree(E, f, g[k], n))
  descends m

theorem crossSum.natural (E f g : Set, n m : Nat)
  shows Nat(crossSum(E, f, g, n, m))
proof
  induction m
  | zero =>
    rw crossSum
    typecheck
  | succ(k) using ih =>
    rw crossSum
    have value := GraphCount.degree.natural at E, f, g[k], n with assumption
    typecheck

theorem crossSum.diagonal (E f : Set, n m : Nat)
  shows crossSum(E, f, f, n, m) = GraphCount.degreeSum(E, f, n, m)
proof
  induction m
  | zero =>
    simp [crossSum, GraphCount.degreeSum]
  | succ(k) using ih =>
    rw [crossSum, GraphCount.degreeSum, ih]
    rfl

theorem crossSum.empty_left (E f g : Set, m : Nat)
  shows crossSum(E, f, g, 0, m) = 0
proof
  induction m
  | zero =>
    rw crossSum
    rfl
  | succ(k) using ih =>
    rw [crossSum, GraphCount.degree, ih]
    simp [add]

theorem crossSum.extend_left (V E f g : Set, n m : Nat)
  requires graph : SimpleGraph(V, E)
  shows crossSum(E, f, g, succ(n), m) =
    add(crossSum(E, f, g, n, m), GraphCount.degree(E, g, f[n], m))
proof
  induction m
  | zero =>
    simp [crossSum, GraphCount.degree, add]
  | succ(k) using ih =>
    rw [crossSum, crossSum, GraphCount.degree, GraphCount.degree, ih]
    have symmetric := GraphCount.indicator.symmetric at V, E, g[k], f[n] with graph
    rw symmetric
    have a := crossSum.natural at E, f, g, n, k with *
    have b := GraphCount.degree.natural at E, g, f[n], k with assumption
    have c := GraphCount.degree.natural at E, f, g[k], n with assumption
    have d := indicator.natural at E, (f[n], g[k])
    exact add.four_shuffle with a, b, c, d

theorem crossSum.transpose (V E f g : Set, m n : Nat)
  requires graph : SimpleGraph(V, E)
  shows crossSum(E, f, g, n, m) = crossSum(E, g, f, m, n)
proof
  induction n
  | zero =>
    rw [crossSum.empty_left, crossSum]
    rfl
  | succ(k) using ih =>
    have extended := crossSum.extend_left at V, E, f, g, k, m with *
    rw [extended, crossSum, ih]
    rfl

theorem crossSum.reindex_neighbors (V E f g h : Set, n m k : Nat)
  requires enumerationF : BijectiveBetween(f, n, V)
  requires enumerationG : BijectiveBetween(g, m, V)
  shows crossSum(E, f, h, n, k) = crossSum(E, g, h, m, k)
proof
  induction k
  | zero =>
    simp [crossSum]
  | succ(j) using ih =>
    rw [crossSum, crossSum, ih]
    have equal := GraphCount.degree.reindex at V, E, f, g, h[j], n, m with *
    rw equal
    rfl

theorem degreeSum.reindex (V E f g : Set, n m : Nat)
  requires graph : SimpleGraph(V, E)
  requires enumerationF : BijectiveBetween(f, n, V)
  requires enumerationG : BijectiveBetween(g, m, V)
  shows GraphCount.degreeSum(E, f, n, n) = GraphCount.degreeSum(E, g, m, m)
proof
  have diagonalF := crossSum.diagonal at E, f, n, n with *
  have diagonalG := crossSum.diagonal at E, g, m, m with *
  have first := crossSum.reindex_neighbors at V, E, f, g, f, n, m, n with
    *{3}, enumerationF, enumerationG
  have transpose := crossSum.transpose at V, E, g, f, n, m with *
  have second := crossSum.reindex_neighbors at V, E, f, g, g, n, m, m with
    *{3}, enumerationF, enumerationG
  rwa [← diagonalF, first, transpose, second]

theorem edgeCount.reindex (V E f g : Set, n m : Nat)
  requires graph : SimpleGraph(V, E)
  requires enumerationF : BijectiveBetween(f, n, V)
  requires enumerationG : BijectiveBetween(g, m, V)
  shows GraphCount.edgeCount(E, f, n) = GraphCount.edgeCount(E, g, m)
proof
  have totals := degreeSum.reindex with graph, enumerationF, enumerationG
  have left := GraphCount.handshaking at V, E, f, n with graph
  have right := GraphCount.handshaking at V, E, g, m with graph
  rw [left, right] at totals
  have positive : 2 ≠ 0
    intro zero
    have reversed : 0 = 2 by cc
    exact Naturals.disjoint.zero.succ at 1 with reversed
  exact mul.left_cancel_positive with positive, totals

end GraphCount
