module Grace.Cumulus.Set.WellOrder.Isomorphism
import WellOrder

-- An order isomorphism, read through function application: for x and y
-- in A, x is below y exactly when f(x) is below f(y).
theorem OrderIsomorphism.apply_iff (f A r B s x y : Set)
  requires iso : OrderIsomorphism(f, A, r, B, s)
  requires hx : x ∈ A
  requires hy : y ∈ A
  shows relates(r, x, y) ↔ relates(s, f(x), f(y))
proof
  have function := Bijective.injective with iso.left
  have fFunction := Injective.function with function
  have valueX := FunctionBetween.apply_closed with fFunction, hx
  have valueY := FunctionBetween.apply_closed with fFunction, hy
  have relatedX := FunctionBetween.relates_apply with fFunction, hx
  have relatedY := FunctionBetween.relates_apply with fFunction, hy
  exact iso.right with x, hx, y, hy, f(x), valueX, f(y), valueY, relatedX, relatedY

theorem OrderIsomorphism.of_apply (f A r B s : Set)
  requires bijective : BijectiveBetween(f, A, B)
  requires preserves : ∀ x ∈ A, ∀ y ∈ A, relates(r, x, y) ↔ relates(s, f(x), f(y))
  shows OrderIsomorphism(f, A, r, B, s)
proof
  have fFunction := Injective.function with (Bijective.injective with bijective)
  constructor
  . exact bijective
  . intros x hx y hy u hu v hv hxu hyv
    have valueU := FunctionBetween.apply_value with fFunction, hx, hxu
    have valueV := FunctionBetween.apply_value with fFunction, hy, hyv
    rw [← valueU, ← valueV]
    exact preserves with x, hx, y, hy

theorem OrderIsomorphism.identity (A r : Set)
  shows OrderIsomorphism(identity(A), A, r, A, r)
proof
  apply OrderIsomorphism.of_apply with (identity.bijective at A)
  intros x hx y hy
  have fixedX := identity.apply with hx
  have fixedY := identity.apply with hy
  rw [fixedX, fixedY]
  constructor
  . intro h
    exact h
  . intro h
    exact h

theorem OrderIsomorphism.inverse (f A r B s : Set)
  requires iso : OrderIsomorphism(f, A, r, B, s)
  shows OrderIsomorphism(converse(f, A, B), B, s, A, r)
proof
  have bijective := iso.left
  have inverse := converse.bijective with bijective
  have fFunction := Injective.function with (Bijective.injective with bijective)
  have gFunction := Injective.function with (Bijective.injective with inverse)
  apply OrderIsomorphism.of_apply with inverse
  intros u hu v hv
  have preimageU := FunctionBetween.apply_closed with gFunction, hu
  have preimageV := FunctionBetween.apply_closed with gFunction, hv
  have backU := Bijective.apply_inverse with bijective, hu
  have backV := Bijective.apply_inverse with bijective, hv
  have characterization := OrderIsomorphism.apply_iff with iso, preimageU, preimageV
  rw [backU, backV] at characterization
  constructor
  . intro h
    exact characterization.backward with h
  . intro h
    exact characterization.forward with h

theorem OrderIsomorphism.compose (g f A r B s C t : Set)
  requires first : OrderIsomorphism(f, A, r, B, s)
  requires second : OrderIsomorphism(g, B, s, C, t)
  shows OrderIsomorphism(compose(g, f, A, B, C), A, r, C, t)
proof
  have fFunction := Injective.function with (Bijective.injective with first.left)
  have gFunction := Injective.function with (Bijective.injective with second.left)
  have bijective := compose.bijective with first.left, second.left
  apply OrderIsomorphism.of_apply with bijective
  intros x hx y hy
  have valueX := FunctionBetween.apply_closed with fFunction, hx
  have valueY := FunctionBetween.apply_closed with fFunction, hy
  have stepX := compose.apply with fFunction, gFunction, hx
  have stepY := compose.apply with fFunction, gFunction, hy
  rw [stepX, stepY]
  have innerCharacterization := OrderIsomorphism.apply_iff with first, hx, hy
  have outerCharacterization := OrderIsomorphism.apply_iff with second, valueX, valueY
  constructor
  . intro h
    exact outerCharacterization.forward with (innerCharacterization.forward with h)
  . intro h
    exact innerCharacterization.backward with (outerCharacterization.backward with h)

-- Replacing the order on the domain by one that agrees on it.
theorem OrderIsomorphism.congr_left (f A r t B s : Set)
  requires iso : OrderIsomorphism(f, A, r, B, s)
  requires agree : ∀ x ∈ A, ∀ y ∈ A, relates(t, x, y) ↔ relates(r, x, y)
  shows OrderIsomorphism(f, A, t, B, s)
proof
  apply OrderIsomorphism.of_apply with iso.left
  intros x hx y hy
  have inner := agree with x, hx, y, hy
  have characterization := OrderIsomorphism.apply_iff with iso, hx, hy
  constructor
  . intro h
    exact characterization.forward with (inner.forward with h)
  . intro h
    exact inner.backward with (characterization.backward with h)

-- The image of an initial segment under an isomorphism is an initial segment.
theorem OrderIsomorphism.image_initial (f A r B s I : Set)
  requires iso : OrderIsomorphism(f, A, r, B, s)
  requires initial : InitialSegment(A, r, I)
  shows InitialSegment(B, s, functionImage(f, I, B))
proof
  have hI := InitialSegment.subset with initial
  have bijective := iso.left
  have inverse := converse.bijective with bijective
  have gFunction := Injective.function with (Bijective.injective with inverse)
  constructor
  . intros y hy
    simp [functionImage.membership] at hy
    exact hy.left
  . intros y hy z hz hzy
    simp [functionImage.membership] at hy
    obtain ⟨inB, x, hx, shape⟩ := hy
    have hxA := hI with x, hx
    have hw := FunctionBetween.apply_closed with gFunction, hz
    have back := Bijective.apply_inverse with bijective, hz
    rw [shape, ← back] at hzy
    have characterization := OrderIsomorphism.apply_iff with iso, hw, hxA
    have below := characterization.backward with hzy
    have inI := initial.right with x, hx, converse(f, A, B)(z), hw, below
    rw ← back at hz
    rw ← back
    simp [functionImage.membership]
    constructor
    . exact hz
    . witness converse(f, A, B)(z)
      constructor
      . exact inI
      . rfl

-- The order carried to the image of an injection is the transported order
-- of Set/OrderTransport; the restriction of an isomorphism to a subset of
-- its domain is an isomorphism onto the image under the restricted orders.
theorem OrderIsomorphism.restrict (f A r B s S : Set)
  requires iso : OrderIsomorphism(f, A, r, B, s)
  requires hS : S ⊆ A
  shows OrderIsomorphism(restrict(f, S), S, restrictOrder(r, S), functionImage(f, S, B), restrictOrder(s, functionImage(f, S, B)))
proof
  have fFunction := Injective.function with (Bijective.injective with iso.left)
  have closed : ∀ x ∈ S, f(x) ∈ functionImage(f, S, B)
    intros x hx
    have value := FunctionBetween.apply_closed with fFunction, (hS with x, hx)
    simp [functionImage.membership]
  have restricted := restrict.function with fFunction, hS, closed
  have injective : InjectiveBetween(restrict(f, S), S, functionImage(f, S, B))
    constructor
    . exact restricted
    . intros x hx y hy z hz hxz hyz
      have valueX := FunctionBetween.apply_value with restricted, hx, hxz
      have valueY := FunctionBetween.apply_value with restricted, hy, hyz
      have stepX := restrict.apply with fFunction, hS, closed, hx
      have stepY := restrict.apply with fFunction, hS, closed, hy
      rw stepX at valueX
      rw stepY at valueY
      have agree : f(x) = f(y)
        rw [valueX, valueY]
        rfl
      exact Injective.apply_cancel with (Bijective.injective with iso.left), (hS with x, hx), (hS with y, hy), agree
  have surjective : SurjectiveBetween(restrict(f, S), S, functionImage(f, S, B))
    constructor
    . exact restricted
    . intros y hy
      simp [functionImage.membership] at hy
      obtain ⟨inB, x, hx, shape⟩ := hy
      witness x
      constructor
      . exact hx
      . have related := FunctionBetween.relates_apply with restricted, hx
        have step := restrict.apply with fFunction, hS, closed, hx
        rwa [step, ← shape] at related
  apply OrderIsomorphism.of_apply with ⟨injective, surjective⟩
  intros x hx y hy
  have stepX := restrict.apply with fFunction, hS, closed, hx
  have stepY := restrict.apply with fFunction, hS, closed, hy
  rw [stepX, stepY]
  have characterization := OrderIsomorphism.apply_iff with iso, (hS with x, hx), (hS with y, hy)
  have imageX := closed with x, hx
  have imageY := closed with y, hy
  constructor
  . intro h
    have inner := restrictOrder.relates.forward with h
    apply restrictOrder.relates.backward
    exact ⟨(characterization.forward with inner.left), imageX, imageY⟩
  . intro h
    have inner := restrictOrder.relates.forward with h
    apply restrictOrder.relates.backward
    exact ⟨(characterization.backward with inner.left), hx, hy⟩

-- Ordinals are rigid: an order isomorphism between two ordinals, each
-- under membership, fixes every point, so isomorphic ordinals are equal.
theorem OrderIsomorphism.ordinal_fixed (f α β γ : Set)
  requires hAlpha : α ∈ Ordinal
  requires hBeta : β ∈ Ordinal
  requires iso : OrderIsomorphism(f, α, membershipOn(α), β, membershipOn(β))
  requires hγ : γ ∈ α
  shows f(γ) = γ
proof
  revert hγ
  induction γ using membership
  intros current ih hCurrent
  have bijective := iso.left
  have fFunction := Injective.function with (Bijective.injective with bijective)
  have inverse := converse.bijective with bijective
  have gFunction := Injective.function with (Bijective.injective with inverse)
  have value := FunctionBetween.apply_closed with fFunction, hCurrent
  ext z
  constructor
  . intro hz
    have below := Ordinal.member_subset with hBeta, value
    have hzB := below with z, hz
    have hw := FunctionBetween.apply_closed with gFunction, hzB
    have back := Bijective.apply_inverse with bijective, hzB
    have fw := FunctionBetween.apply_closed with fFunction, hw
    have outerRule := membershipOn.relates with fw, value
    have innerRule := membershipOn.relates with hw, hCurrent
    have characterization := OrderIsomorphism.apply_iff with iso, hw, hCurrent
    rw ← back at hz
    have outer := outerRule.backward with hz
    have inner := characterization.backward with outer
    have member := innerRule.forward with inner
    have fixed := ih with converse(f, α, β)(z), member, hw
    rwa [← back, fixed]
  . intro hz
    have below := Ordinal.member_subset with hAlpha, hCurrent
    have hzA := below with z, hz
    have innerRule := membershipOn.relates with hzA, hCurrent
    have inner := innerRule.backward with hz
    have characterization := OrderIsomorphism.apply_iff with iso, hzA, hCurrent
    have outer := characterization.forward with inner
    have fz := FunctionBetween.apply_closed with fFunction, hzA
    have outerRule := membershipOn.relates with fz, value
    have member := outerRule.forward with outer
    have fixed := ih with z, hz, hzA
    rwa fixed at member

theorem OrderIsomorphism.ordinal_equal (f α β : Set)
  requires hAlpha : α ∈ Ordinal
  requires hBeta : β ∈ Ordinal
  requires iso : OrderIsomorphism(f, α, membershipOn(α), β, membershipOn(β))
  shows α = β
proof
  have bijective := iso.left
  have fFunction := Injective.function with (Bijective.injective with bijective)
  have inverse := OrderIsomorphism.inverse with iso
  have gFunction := Injective.function with (Bijective.injective with inverse.left)
  apply Subset.antisymmetric
  . intros γ hγ
    have fixed := OrderIsomorphism.ordinal_fixed with hAlpha, hBeta, iso, hγ
    have value := FunctionBetween.apply_closed with fFunction, hγ
    rwa fixed at value
  . intros γ hγ
    have fixed := OrderIsomorphism.ordinal_fixed with hBeta, hAlpha, inverse, hγ
    have value := FunctionBetween.apply_closed with gFunction, hγ
    rwa fixed at value
