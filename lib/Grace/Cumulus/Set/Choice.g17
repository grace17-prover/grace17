module Grace.Cumulus.Set.Choice
import Core

-- Global choice is exposed through this interface:
-- choosing from an inhabited set returns one of its members.
theorem choose.member (A : Set)
  requires inhabited : Nonempty(A)
  shows choose(A) ∈ A
proof
  simp [Nonempty.ne_empty, set.globalChoice]
