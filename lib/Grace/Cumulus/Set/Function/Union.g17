-- The union of two functions with disjoint domains is a function on the
-- union of the domains; injectivity needs disjoint images too, and
-- surjectivity passes to the union of the codomains
-- Part of Cumulus, the Grace17 mathematics library.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module Grace.Cumulus.Set.Function.Union
import Image
import Algebra

theorem union2.relates (f g x y : Set)
  shows relates(f ∪ g, x, y) ↔ relates(f, x, y) ∨ relates(g, x, y)
proof
  constructor
  . intro h
    have member : (x, y) ∈ f ∪ g := h
    have split := union2.membership.forward with member
    cases split with inF | inG
    . left
      exact inF
    . right
      exact inG
  . intro h
    cases h with inF | inG
    . have member : (x, y) ∈ f := inF
      exact union2.left at (x, y), f, g with member
    . have member : (x, y) ∈ g := inG
      exact union2.right at (x, y), f, g with member

theorem FunctionBetween.union_disjoint (f g A B C D : Set)
  requires hf : f : A → C
  requires hg : g : B → D
  requires disjoint : Disjoint(A, B)
  shows f ∪ g : A ∪ B → C ∪ D
proof
  have fRelation := RelationBetween.monotone with (FunctionBetween.relation with hf), (union2.subset_left at A, B), (union2.subset_left at C, D)
  have gRelation := RelationBetween.monotone with (FunctionBetween.relation with hg), (union2.subset_right at A, B), (union2.subset_right at C, D)
  have separated := Disjoint.iff.forward with disjoint
  have fFunctional := FunctionBetween.functional with hf
  have gFunctional := FunctionBetween.functional with hg
  have fSubset : f ⊆ (A ∪ B) × (C ∪ D) := fRelation
  have gSubset : g ⊆ (A ∪ B) × (C ∪ D) := gRelation
  constructor
  . exact union2.subset with fSubset, gSubset
  . constructor
    . intros x y hxy z hxz
      have hxy2 := union2.relates.forward with hxy
      have hxz2 := union2.relates.forward with hxz
      cases hxy2 with fy | gy
      . cases hxz2 with fz | gz
        . exact fFunctional with x, y, fy, z, fz
        . exfalso
          have boundsY := FunctionBetween.bounds with hf, fy
          have boundsZ := FunctionBetween.bounds with hg, gz
          exact separated with x, boundsY.left, boundsZ.left
      . cases hxz2 with fz | gz
        . exfalso
          have boundsZ := FunctionBetween.bounds with hf, fz
          have boundsY := FunctionBetween.bounds with hg, gy
          exact separated with x, boundsZ.left, boundsY.left
        . exact gFunctional with x, y, gy, z, gz
    . intros x hx
      have split := union2.membership.forward with hx
      cases split with hxA | hxB
      . obtain ⟨y, hy, related⟩ := FunctionBetween.exists_value with hf, hxA
        refine ⟨y, (union2.subset_left at C, D with y, hy), ?_⟩
        apply union2.relates.backward
        left
        exact related
      . obtain ⟨y, hy, related⟩ := FunctionBetween.exists_value with hg, hxB
        refine ⟨y, (union2.subset_right at C, D with y, hy), ?_⟩
        apply union2.relates.backward
        right
        exact related

theorem FunctionBetween.union_apply_left (f g A B C D x : Set)
  requires hf : f : A → C
  requires hg : g : B → D
  requires disjoint : Disjoint(A, B)
  requires hx : x ∈ A
  shows (f ∪ g)(x) = f(x)
proof
  have union := FunctionBetween.union_disjoint with hf, hg, disjoint
  have hxU := union2.subset_left at A, B with x, hx
  have related := FunctionBetween.relates_apply with hf, hx
  have lifted : relates(f ∪ g, x, f(x))
    apply union2.relates.backward
    left
    exact related
  exact FunctionBetween.apply_value with union, hxU, lifted

theorem FunctionBetween.union_apply_right (f g A B C D x : Set)
  requires hf : f : A → C
  requires hg : g : B → D
  requires disjoint : Disjoint(A, B)
  requires hx : x ∈ B
  shows (f ∪ g)(x) = g(x)
proof
  have union := FunctionBetween.union_disjoint with hf, hg, disjoint
  have hxU := union2.subset_right at A, B with x, hx
  have related := FunctionBetween.relates_apply with hg, hx
  have lifted : relates(f ∪ g, x, g(x))
    apply union2.relates.backward
    right
    exact related
  exact FunctionBetween.apply_value with union, hxU, lifted

theorem Injective.union_disjoint (f g A B C D : Set)
  requires hf : InjectiveBetween(f, A, C)
  requires hg : InjectiveBetween(g, B, D)
  requires domains : Disjoint(A, B)
  requires codomains : Disjoint(C, D)
  shows InjectiveBetween(f ∪ g, A ∪ B, C ∪ D)
proof
  have fFunction := Injective.function with hf
  have gFunction := Injective.function with hg
  have separated := Disjoint.iff.forward with codomains
  constructor
  . exact FunctionBetween.union_disjoint with fFunction, gFunction, domains
  . intros x hx y hy z hz hxz hyz
    have hxz2 := union2.relates.forward with hxz
    have hyz2 := union2.relates.forward with hyz
    cases hxz2 with fx | gx
    . cases hyz2 with fy | gy
      . have boundsX := FunctionBetween.bounds with fFunction, fx
        have boundsY := FunctionBetween.bounds with fFunction, fy
        exact hf.right with x, boundsX.left, y, boundsY.left, z, boundsX.right, fx, fy
      . exfalso
        have boundsX := FunctionBetween.bounds with fFunction, fx
        have boundsY := FunctionBetween.bounds with gFunction, gy
        exact separated with z, boundsX.right, boundsY.right
    . cases hyz2 with fy | gy
      . exfalso
        have boundsX := FunctionBetween.bounds with gFunction, gx
        have boundsY := FunctionBetween.bounds with fFunction, fy
        exact separated with z, boundsY.right, boundsX.right
      . have boundsX := FunctionBetween.bounds with gFunction, gx
        have boundsY := FunctionBetween.bounds with gFunction, gy
        exact hg.right with x, boundsX.left, y, boundsY.left, z, boundsX.right, gx, gy

theorem Surjective.union_disjoint (f g A B C D : Set)
  requires hf : SurjectiveBetween(f, A, C)
  requires hg : SurjectiveBetween(g, B, D)
  requires domains : Disjoint(A, B)
  shows SurjectiveBetween(f ∪ g, A ∪ B, C ∪ D)
proof
  have fFunction := Surjective.function with hf
  have gFunction := Surjective.function with hg
  constructor
  . exact FunctionBetween.union_disjoint with fFunction, gFunction, domains
  . intros z hz
    have split := union2.membership.forward with hz
    cases split with hzC | hzD
    . obtain ⟨x, hx, related⟩ := hf.right with z, hzC
      refine ⟨x, (union2.subset_left at A, B with x, hx), ?_⟩
      apply union2.relates.backward
      left
      exact related
    . obtain ⟨x, hx, related⟩ := hg.right with z, hzD
      refine ⟨x, (union2.subset_right at A, B with x, hx), ?_⟩
      apply union2.relates.backward
      right
      exact related

theorem Bijective.union_disjoint (f g A B C D : Set)
  requires hf : BijectiveBetween(f, A, C)
  requires hg : BijectiveBetween(g, B, D)
  requires domains : Disjoint(A, B)
  requires codomains : Disjoint(C, D)
  shows BijectiveBetween(f ∪ g, A ∪ B, C ∪ D)
proof
  constructor
  . exact Injective.union_disjoint with hf.left, hg.left, domains, codomains
  . exact Surjective.union_disjoint with hf.right, hg.right, domains
