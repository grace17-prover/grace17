module Grace.Cumulus.Set.Family
import Powerset

-- The intersection of a family is carved out of its union, so it is a set
-- for every family and the empty family's intersection is empty.
def familyIntersection (S : Set) : Set := { x ∈ ⋃(S) | ∀ A ∈ S, x ∈ A }
notation prefix 90 "⋂" => familyIntersection

-- The complement of A within a carrier E.
def complement (E A : Set) : Set := E ∖ A

-- The family of complements of the members of S within E.
def complements (E S : Set) : Set := { E ∖ A | A ∈ S }

theorem familyIntersection.membership (x S : Set)
  shows x ∈ ⋂(S) ↔ x ∈ ⋃(S) ∧ ∀ A ∈ S, x ∈ A
proof
  simp [familyIntersection]

theorem familyIntersection.membership_of_nonempty (x S : Set)
  requires nonempty : Nonempty(S)
  shows x ∈ ⋂(S) ↔ ∀ A ∈ S, x ∈ A
proof
  constructor
  . intro h
    simp [familyIntersection] at h
    exact h.right
  . intro h
    obtain ⟨B, hB⟩ := nonempty
    simp [familyIntersection]
    constructor
    . exact union.contains with hB, (h with B, hB)
    . exact h

theorem familyIntersection.subset_of_member (A S : Set)
  requires h : A ∈ S
  shows ⋂(S) ⊆ A
proof
  intros x hx
  simp [familyIntersection] at hx
  exact hx.right with A, h

theorem familyIntersection.subset_union (S : Set)
  shows ⋂(S) ⊆ ⋃(S)
proof
  intros x hx
  simp [familyIntersection] at hx
  exact hx.left

theorem familyIntersection.empty
  shows ⋂(∅) = ∅
proof
  apply Subset.empty_iff.forward
  have included := familyIntersection.subset_union at ∅
  rwa union.empty at included

theorem familyIntersection.greatest (Z S : Set)
  requires nonempty : Nonempty(S)
  requires h : ∀ A ∈ S, Z ⊆ A
  shows Z ⊆ ⋂(S)
proof
  intros x hx
  apply familyIntersection.membership_of_nonempty.backward with nonempty
  intros A hA
  exact h with A, hA, x, hx

theorem familyIntersection.antitone (S T : Set)
  requires nonempty : Nonempty(S)
  requires h : S ⊆ T
  shows ⋂(T) ⊆ ⋂(S)
proof
  apply familyIntersection.greatest with nonempty
  intros A hA
  exact familyIntersection.subset_of_member with (h with A, hA)

theorem familyIntersection.singleton (A : Set)
  shows ⋂({A}) = A
proof
  apply Subset.antisymmetric
  . exact familyIntersection.subset_of_member with (singleton.self at A)
  . apply familyIntersection.greatest with (Nonempty.singleton at A)
    intros B hB
    simp [singleton.membership] at hB
    rw hB
    exact Subset.reflexive

theorem familyIntersection.pair (A B : Set)
  shows ⋂({A, B}) = A ∩ B
proof
  apply Subset.antisymmetric
  . apply Subset.intersection_iff.backward
    constructor
    . exact familyIntersection.subset_of_member with (pair.left at A, B)
    . exact familyIntersection.subset_of_member with (pair.right at A, B)
  . have nonempty : Nonempty({A, B}) := ⟨A, (pair.left at A, B)⟩
    apply familyIntersection.greatest with nonempty
    intros C hC
    simp at hC
    cases hC with hA | hB
    . rw hA
      exact intersection.subset_left
    . rw hB
      exact intersection.subset_right

theorem familyIntersection.union2 (S T : Set)
  requires nonemptyS : Nonempty(S)
  requires nonemptyT : Nonempty(T)
  shows ⋂(S ∪ T) = ⋂(S) ∩ ⋂(T)
proof
  apply Subset.antisymmetric
  . apply Subset.intersection_iff.backward
    constructor
    . exact familyIntersection.antitone with nonemptyS, (union2.subset_left at S, T)
    . exact familyIntersection.antitone with nonemptyT, (union2.subset_right at S, T)
  . obtain ⟨B, hB⟩ := nonemptyS
    have nonempty : Nonempty(S ∪ T) := ⟨B, (union2.subset_left at S, T with B, hB)⟩
    apply familyIntersection.greatest with nonempty
    intros A hA
    simp [union2.membership] at hA
    cases hA with hS | hT
    . exact Subset.transitive with (intersection.subset_left at ⋂(S), ⋂(T)), (familyIntersection.subset_of_member with hS)
    . exact Subset.transitive with (intersection.subset_right at ⋂(S), ⋂(T)), (familyIntersection.subset_of_member with hT)

-- Complements within a carrier

theorem complement.membership (x E A : Set)
  shows x ∈ complement(E, A) ↔ x ∈ E ∧ ¬(x ∈ A)
proof
  simp [complement, difference.membership]

theorem complement.subset (E A : Set)
  shows complement(E, A) ⊆ E
proof
  simp [complement]
  exact difference.subset_left

theorem complement.union2 (E A : Set)
  requires h : A ⊆ E
  shows A ∪ complement(E, A) = E
proof
  simp [complement]
  ext y
  simp

theorem complement.intersection (E A : Set)
  shows A ∩ complement(E, A) = ∅
proof
  ext y
  simp [complement]

theorem complement.complement (E A : Set)
  requires h : A ⊆ E
  shows complement(E, complement(E, A)) = A
proof
  simp [complement]
  ext y
  simp

theorem complement.empty (E : Set)
  shows complement(E, ∅) = E
proof
  simp [complement]
  exact difference.empty

theorem complement.self (E : Set)
  shows complement(E, E) = ∅
proof
  simp [complement]
  exact difference.self

theorem complement.antitone (E A B : Set)
  requires h : A ⊆ B
  shows complement(E, B) ⊆ complement(E, A)
proof
  intros x hx
  simp [complement.membership] at hx
  simp [complement.membership]

theorem complement.subset_iff (E A B : Set)
  requires hA : A ⊆ E
  requires hB : B ⊆ E
  shows A ⊆ B ↔ complement(E, B) ⊆ complement(E, A)
proof
  constructor
  . intro h
    exact complement.antitone with h
  . intros h x hx
    by_contra absent
    have inE : x ∈ E := hA with x, hx
    have member : x ∈ complement(E, B) by simp [complement.membership, inE, absent]
    have inComplement : x ∈ complement(E, A) := h with x, member
    simp [complement.membership] at inComplement
    exact inComplement.right with hx

theorem complement.injective (E A B : Set)
  requires hA : A ⊆ E
  requires hB : B ⊆ E
  requires h : complement(E, A) = complement(E, B)
  shows A = B
proof
  have double := complement.complement with hA
  rw [← double, h]
  exact complement.complement with hB

theorem complement.union2_distrib (E A B : Set)
  shows complement(E, A ∪ B) = complement(E, A) ∩ complement(E, B)
proof
  simp [complement]
  exact difference.union2

theorem complement.intersection_distrib (E A B : Set)
  shows complement(E, A ∩ B) = complement(E, A) ∪ complement(E, B)
proof
  simp [complement]
  exact difference.intersection

theorem complement.disjoint_iff (E A B : Set)
  requires hA : A ⊆ E
  shows Disjoint(A, B) ↔ A ⊆ complement(E, B)
proof
  constructor
  . intro h
    have absent := Disjoint.iff.forward with h
    intros x hx
    simp [complement.membership]
  . intro h
    apply Disjoint.iff.backward
    intros x hx
    have member : x ∈ complement(E, B) := h with x, hx
    simp [complement.membership] at member
    exact member.right

-- De Morgan laws for families

theorem complements.membership (B E S : Set)
  shows B ∈ complements(E, S) ↔ ∃ A ∈ S, E ∖ A = B
proof
  simp [complements]

theorem complements.union (E S : Set)
  requires nonempty : Nonempty(S)
  shows complement(E, ⋃(S)) = ⋂(complements(E, S))
proof
  obtain ⟨C, hC⟩ := nonempty
  have nonemptyComplements : Nonempty(complements(E, S))
    witness E ∖ C
    apply complements.membership.backward
    witness C
    constructor
    . exact hC
    . rfl
  ext x
  constructor
  . intro hx
    simp [complement.membership] at hx
    apply familyIntersection.membership_of_nonempty.backward with nonemptyComplements
    intros B hB
    obtain ⟨A, hA, shape⟩ := complements.membership.forward with hB
    rw ← shape
    simp [difference.membership]
    constructor
    . exact hx.left
    . intro inA
      exact hx.right with (union.contains with hA, inA)
  . intro hx
    have everywhere := familyIntersection.membership_of_nonempty.forward with nonemptyComplements, hx
    have inFirst : x ∈ E ∖ C
      apply everywhere
      apply complements.membership.backward
      witness C
      constructor
      . exact hC
      . rfl
    simp [difference.membership] at inFirst
    simp [complement.membership]
    constructor
    . exact inFirst.left
    . intro inUnion
      simp [set.union] at inUnion
      obtain ⟨A, hA, inA⟩ := inUnion
      have inComplement : x ∈ E ∖ A
        apply everywhere
        apply complements.membership.backward
        witness A
        constructor
        . exact hA
        . rfl
      simp [difference.membership] at inComplement
      exact inComplement.right with inA

theorem complements.intersection (E S : Set)
  requires nonempty : Nonempty(S)
  shows complement(E, ⋂(S)) = ⋃(complements(E, S))
proof
  ext x
  constructor
  . intro hx
    simp [complement.membership] at hx
    have notEverywhere : ¬(∀ A ∈ S, x ∈ A)
      intro everywhere
      exact hx.right with (familyIntersection.membership_of_nonempty.backward with nonempty, everywhere)
    by_contra absent
    apply notEverywhere
    intros A hA
    by_contra outside
    apply absent
    have inComplement : x ∈ E ∖ A by simp [difference.membership, hx.left, outside]
    have member : E ∖ A ∈ complements(E, S)
      apply complements.membership.backward
      witness A
      constructor
      . exact hA
      . rfl
    exact union.contains with member, inComplement
  . intro hx
    simp [set.union] at hx
    obtain ⟨B, hB, inB⟩ := hx
    obtain ⟨A, hA, shape⟩ := complements.membership.forward with hB
    rw ← shape at inB
    simp [difference.membership] at inB
    simp [complement.membership]
    constructor
    . exact inB.left
    . intro inIntersection
      have inA : x ∈ A := familyIntersection.subset_of_member with hA, x, inIntersection
      exact inB.right with inA
