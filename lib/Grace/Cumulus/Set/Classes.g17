module Grace.Cumulus.Set.Classes
import Basic

namespace Class

class Universe (x : Set) := { x | x = x }
class Natural (x : Set) := Nat(x)
class MemberOf (x A : Set) := x ∈ A
class SubsetsOf (A : Class) := { X : Set | ∀ x ∈ X, x ∈ A }
class Inhabited (A : Set) := ∃ x, x ∈ A

def naturalsIn (A : Set) : Set := { x ∈ A | x ∈ Natural }

theorem Natural.of_Nat (n : Nat)
  shows n ∈ Natural
proof
  simp [Natural]

theorem Universe.membership (x : Set)
  shows x ∈ Universe ↔ x = x
proof
  simp [Universe]

theorem MemberOf.characterization (x A : Set)
  shows x ∈ MemberOf(A) ↔ x ∈ A
proof
  simp [MemberOf]

theorem SubsetsOf.characterization (X A : Set)
  shows X ∈ SubsetsOf(A) ↔ (X ⊆ A)
proof
  simp

theorem SubsetsOf.Universe
  shows SubsetsOf(Universe) = Universe
proof
  simp

end Class

export open Grace.Cumulus.Set.Classes.Class
