-- Authors: Grant Passmore

module Grace.Cumulus.Set.Ordinal.OrderType
import Cardinal.Hartogs
import WellOrder.Isomorphism

theorem wellOrderType.order_isomorphism (A r : Set)
  requires order : WellOrder(A, r)
  shows OrderIsomorphism(
    wellOrderCollapseGraph(A, r), A, r,
    wellOrderType(A, r), membershipOn(wellOrderType(A, r)))
proof
  have active := wellOrderCollapseGraph.order_isomorphism with order
  apply OrderIsomorphism.congr_left with active
  intros x hx y hy
  have rule := activeWellOrderRelation.relates at x, y, A, r
  constructor
  . intro h
    exact rule.backward with ⟨h, order⟩
  . intro h
    have parts := rule.forward with h
    exact parts.left

theorem wellOrderType.isomorphic_of_equal (A r B s : Set)
  requires orderA : WellOrder(A, r)
  requires orderB : WellOrder(B, s)
  requires equal : wellOrderType(A, r) = wellOrderType(B, s)
  shows ∃ f, OrderIsomorphism(f, A, r, B, s)
proof
  have typeA := wellOrderType.order_isomorphism with orderA
  have typeB := wellOrderType.order_isomorphism with orderB
  have inverse := OrderIsomorphism.inverse with typeB
  rw ← equal at inverse
  witness compose(
    converse(wellOrderCollapseGraph(B, s), B, wellOrderType(A, r)),
    wellOrderCollapseGraph(A, r), A, wellOrderType(A, r), B)
  exact OrderIsomorphism.compose with typeA, inverse

theorem wellOrderType.equal_of_isomorphic (A r B s f : Set)
  requires orderA : WellOrder(A, r)
  requires orderB : WellOrder(B, s)
  requires iso : OrderIsomorphism(f, A, r, B, s)
  shows wellOrderType(A, r) = wellOrderType(B, s)
proof
  have typeA := wellOrderType.order_isomorphism with orderA
  have typeB := wellOrderType.order_isomorphism with orderB
  have inverseA := OrderIsomorphism.inverse with typeA
  have step := OrderIsomorphism.compose with inverseA, iso
  have whole := OrderIsomorphism.compose with step, typeB
  have alphaOrdinal := wellOrderType.ordinal with orderA
  have betaOrdinal := wellOrderType.ordinal with orderB
  exact OrderIsomorphism.ordinal_equal with alphaOrdinal, betaOrdinal, whole

-- The order type is a complete invariant of a well-order.
theorem wellOrderType.equal_iff_isomorphic (A r B s : Set)
  requires orderA : WellOrder(A, r)
  requires orderB : WellOrder(B, s)
  shows wellOrderType(A, r) = wellOrderType(B, s) ↔
    ∃ f, OrderIsomorphism(f, A, r, B, s)
proof
  constructor
  . intro equal
    exact wellOrderType.isomorphic_of_equal with orderA, orderB, equal
  . intro isomorphic
    obtain ⟨f, iso⟩ := isomorphic
    exact wellOrderType.equal_of_isomorphic with orderA, orderB, iso

-- Membership on an ordinal is membership on any larger set, restricted.
theorem membershipOn.restrict_relates (α β x y : Set)
  requires hSub : α ⊆ β
  requires hx : x ∈ α
  requires hy : y ∈ α
  shows relates(membershipOn(α), x, y) ↔
    relates(restrictOrder(membershipOn(β), α), x, y)
proof
  have inner := membershipOn.relates with hx, hy
  have outer := membershipOn.relates with (hSub with x, hx), (hSub with y, hy)
  have restricted := restrictOrder.relates at membershipOn(β), α, x, y
  constructor
  . intro h
    apply restricted.backward
    exact ⟨(outer.backward with (inner.forward with h)), hx, hy⟩
  . intro h
    have parts := restricted.forward with h
    exact inner.backward with (outer.forward with parts.left)

theorem Ordinal.subset_initial_segment (α β : Set)
  requires ordinal : α ∈ Ordinal
  requires hSub : α ⊆ β
  shows InitialSegment(β, membershipOn(β), α)
proof
  constructor
  . exact hSub
  . intros x hx y hy hyx
    have rule := membershipOn.relates with hy, (hSub with x, hx)
    have below := rule.forward with hyx
    have inside := Ordinal.member_subset with ordinal, hx
    exact inside with y, below

-- When the type of (A, r) sits inside the type of (B, s), carrying the
-- smaller type back into B through the collapse of (B, s) cuts out an
-- initial segment of B, and composing the two collapses maps A onto it.
def typeSegment (A r B s : Set) : Set :=
  functionImage(
    converse(wellOrderCollapseGraph(B, s), B, wellOrderType(B, s)),
    wellOrderType(A, r), B)

def typeEmbedding (A r B s : Set) : Set :=
  compose(
    restrict(
      converse(wellOrderCollapseGraph(B, s), B, wellOrderType(B, s)),
      wellOrderType(A, r)),
    wellOrderCollapseGraph(A, r), A, wellOrderType(A, r),
    typeSegment(A, r, B, s))

theorem typeSegment.initial (A r B s : Set)
  requires orderA : WellOrder(A, r)
  requires orderB : WellOrder(B, s)
  requires hSub : wellOrderType(A, r) ⊆ wellOrderType(B, s)
  shows InitialSegment(B, s, typeSegment(A, r, B, s))
proof
  have alphaOrdinal := wellOrderType.ordinal with orderA
  have typeB := wellOrderType.order_isomorphism with orderB
  have inverse := OrderIsomorphism.inverse with typeB
  have initial := Ordinal.subset_initial_segment with alphaOrdinal, hSub
  unfold typeSegment
  exact OrderIsomorphism.image_initial with inverse, initial

theorem typeEmbedding.order_isomorphism (A r B s : Set)
  requires orderA : WellOrder(A, r)
  requires orderB : WellOrder(B, s)
  requires hSub : wellOrderType(A, r) ⊆ wellOrderType(B, s)
  shows OrderIsomorphism(
    typeEmbedding(A, r, B, s), A, r,
    typeSegment(A, r, B, s), restrictOrder(s, typeSegment(A, r, B, s)))
proof
  have typeA := wellOrderType.order_isomorphism with orderA
  have typeB := wellOrderType.order_isomorphism with orderB
  have inverse := OrderIsomorphism.inverse with typeB
  have restricted := OrderIsomorphism.restrict with inverse, hSub
  have agree : ∀ x ∈ wellOrderType(A, r), ∀ y ∈ wellOrderType(A, r),
      relates(membershipOn(wellOrderType(A, r)), x, y) ↔
        relates(restrictOrder(membershipOn(wellOrderType(B, s)), wellOrderType(A, r)), x, y)
    intros x hx y hy
    exact membershipOn.restrict_relates with hSub, hx, hy
  have adjusted := OrderIsomorphism.congr_left with restricted, agree
  unfold typeEmbedding
  unfold typeSegment
  exact OrderIsomorphism.compose with typeA, adjusted

-- Comparability: one of two well-orders is isomorphic to an initial
-- segment of the other.
theorem WellOrder.comparable (A r B s : Set)
  requires orderA : WellOrder(A, r)
  requires orderB : WellOrder(B, s)
  shows (∃ I, ∃ f, InitialSegment(B, s, I) ∧
      OrderIsomorphism(f, A, r, I, restrictOrder(s, I))) ∨
    (∃ I, ∃ f, InitialSegment(A, r, I) ∧
      OrderIsomorphism(f, B, s, I, restrictOrder(r, I)))
proof
  have alphaOrdinal := wellOrderType.ordinal with orderA
  have betaOrdinal := wellOrderType.ordinal with orderB
  have comparison := Ordinal.subset_or_member with alphaOrdinal, betaOrdinal
  cases comparison with below | above
  . left
    witness typeSegment(A, r, B, s)
    witness typeEmbedding(A, r, B, s)
    exact ⟨(typeSegment.initial with orderA, orderB, below), (typeEmbedding.order_isomorphism with orderA, orderB, below)⟩
  . right
    have reversed := Ordinal.member_subset with alphaOrdinal, above
    witness typeSegment(B, s, A, r)
    witness typeEmbedding(B, s, A, r)
    exact ⟨(typeSegment.initial with orderB, orderA, reversed), (typeEmbedding.order_isomorphism with orderB, orderA, reversed)⟩
