module Grace.Cumulus.Set.Ordinal.Basic
import Core
import Family

theorem Ordinal.not_member_self (α : Set)
  shows ¬(α ∈ α)
proof
  exact membership.irreflexive

theorem Ordinal.member_subset (α β : Set)
  requires hBeta : β ∈ Ordinal
  requires h : α ∈ β
  shows α ⊆ β
proof
  have transitive := Ordinal.transitive with hBeta
  exact transitive with α, h

theorem Ordinal.not_member_of_subset (α β : Set)
  requires h : β ⊆ α
  shows ¬(α ∈ β)
proof
  intro member
  exact Ordinal.not_member_self with (h with α, member)

theorem Ordinal.subset_or_member (α β : Set)
  requires hAlpha : α ∈ Ordinal
  requires hBeta : β ∈ Ordinal
  shows α ⊆ β ∨ β ∈ α
proof
  have cases := Ordinal.trichotomy with hAlpha, β, hBeta
  cases cases with less | rest
  . left
    exact Ordinal.member_subset with hBeta, less
  . cases rest with equal | greater
    . left
      rw equal
      exact Subset.reflexive
    . right
      exact greater

theorem Ordinal.member_iff_proper_subset (α β : Set)
  requires hAlpha : α ∈ Ordinal
  requires hBeta : β ∈ Ordinal
  shows α ∈ β ↔ α ⊆ β ∧ α ≠ β
proof
  constructor
  . intro h
    constructor
    . exact Ordinal.member_subset with hBeta, h
    . intro equal
      rw equal at h
      exact Ordinal.not_member_self with h
  . intro h
    have cases := Ordinal.trichotomy with hAlpha, β, hBeta
    cases cases with less | rest
    . exact less
    . cases rest with equal | greater
      . exfalso
        exact h.right with equal
      . exfalso
        exact Ordinal.not_member_of_subset with h.left, greater

theorem Ordinal.subset_iff_member_next (α β : Set)
  requires hAlpha : α ∈ Ordinal
  requires hBeta : β ∈ Ordinal
  shows α ⊆ β ↔ α ∈ next(β)
proof
  constructor
  . intro h
    exact Ordinal.subset_bound with hAlpha, hBeta, h
  . intro h
    simp [next.membership] at h
    cases h with less | equal
    . exact Ordinal.member_subset with hBeta, less
    . rw equal
      exact Subset.reflexive

theorem Ordinal.member_iff_next_subset (α β : Set)
  requires hAlpha : α ∈ Ordinal
  requires hBeta : β ∈ Ordinal
  shows α ∈ β ↔ next(α) ⊆ β
proof
  constructor
  . intros h x hx
    simp [next.membership] at hx
    cases hx with less | equal
    . exact Ordinal.member_subset at α, β with hBeta, h, x, less
    . rw equal
      exact h
  . intro h
    exact h with α, (next.contains at α)

theorem next.injective (α β : Set)
  requires hAlpha : α ∈ Ordinal
  requires hBeta : β ∈ Ordinal
  requires h : next(α) = next(β)
  shows α = β
proof
  have alphaIn : α ∈ next(β)
    rw ← h
    exact next.contains
  have betaIn : β ∈ next(α)
    rw h
    exact next.contains
  simp [next.membership] at alphaIn
  simp [next.membership] at betaIn
  cases alphaIn with less | equal
  . cases betaIn with lessBack | equalBack
    . exfalso
      have included := Ordinal.member_subset with hAlpha, lessBack
      exact Ordinal.not_member_of_subset with included, less
    . symm
      exact equalBack
  . exact equal

theorem next.not_member_self (α : Set)
  requires hAlpha : α ∈ Ordinal
  shows ¬(next(α) ∈ α)
proof
  intro h
  have included := Ordinal.member_subset with hAlpha, h
  exact Ordinal.not_member_self with (included with α, (next.contains at α))

theorem next.member_iff (α β : Set)
  requires hAlpha : α ∈ Ordinal
  requires hBeta : β ∈ Ordinal
  shows next(α) ∈ next(β) ↔ α ∈ β
proof
  constructor
  . intro h
    have included := Ordinal.subset_iff_member_next.backward with (Ordinal.next with hAlpha), hBeta, h
    exact included with α, (next.contains at α)
  . intro h
    apply Ordinal.subset_iff_member_next.forward with (Ordinal.next with hAlpha), hBeta
    exact Ordinal.member_iff_next_subset.forward with hAlpha, hBeta, h

theorem Ordinal.union_upper (A α : Set)
  requires h : α ∈ A
  shows α ⊆ ⋃(A)
proof
  exact union.subset_of_member with h

theorem Ordinal.union_least (A β : Set)
  requires h : ∀ α ∈ A, α ⊆ β
  shows ⋃(A) ⊆ β
proof
  exact union.subset with h

theorem Ordinal.union_next (α : Set)
  requires hAlpha : α ∈ Ordinal
  shows ⋃(next(α)) = α
proof
  apply Subset.antisymmetric
  . apply union.subset
    intros β hβ
    simp [next.membership] at hβ
    cases hβ with less | equal
    . exact Ordinal.member_subset with hAlpha, less
    . rw equal
      exact Subset.reflexive
  . exact union.subset_of_member with (next.contains at α)

theorem Ordinal.least (S : Set)
  requires ordinals : ∀ α ∈ S, α ∈ Ordinal
  requires nonempty : S ≠ ∅
  shows ∃ m ∈ S, ∀ α ∈ S, m ⊆ α
proof
  have found := membership.wellFounded at S
  have within : ∀ x ∈ S, x ∈ S
    intros x hx
    exact hx
  obtain ⟨m, hm, minimal⟩ := found with S, within, nonempty
  witness m
  constructor
  . exact hm
  . intros α hα
    have cases := Ordinal.subset_or_member with (ordinals with m, hm), (ordinals with α, hα)
    cases cases with included | greater
    . exact included
    . exfalso
      exact minimal with α, greater, hα

-- The least element of a nonempty set of ordinals is its intersection.
theorem Ordinal.intersection_least (S : Set)
  requires ordinals : ∀ α ∈ S, α ∈ Ordinal
  requires nonempty : S ≠ ∅
  shows ⋂(S) ∈ S ∧ (∀ α ∈ S, ⋂(S) ⊆ α)
proof
  obtain ⟨m, hm, least⟩ := Ordinal.least with ordinals, nonempty
  have inhabited : Nonempty(S) := ⟨m, hm⟩
  have equal : ⋂(S) = m
    apply Subset.antisymmetric
    . exact familyIntersection.subset_of_member with hm
    . exact familyIntersection.greatest with inhabited, least
  constructor
  . rw equal
    exact hm
  . intros α hα
    rw equal
    exact least with α, hα

-- The ordinals among the members of X.
def ordinalsWithin (X : Set) : Set := { α ∈ X | α ∈ Ordinal }

theorem ordinalsWithin.ordinal (X : Set)
  requires h : ∀ α, α ∈ Ordinal → α ∈ X
  shows ordinalsWithin(X) ∈ Ordinal
proof
  have transitive : Transitive(ordinalsWithin(X))
    intros α hα
    simp [ordinalsWithin.membership] at hα
    intros β hβ
    have ordinal := Ordinal.member with hα.right, hβ
    simp [ordinalsWithin.membership]
  simp [Ordinal]

theorem Ordinal.no_set_of_all
  shows ¬(∃ X, ∀ α, α ∈ Ordinal → α ∈ X)
proof
  intro h
  obtain ⟨X, hX⟩ := h
  have ordinal := ordinalsWithin.ordinal with hX
  have selfMember : ordinalsWithin(X) ∈ ordinalsWithin(X) by simp [ordinalsWithin.membership]
  exact Ordinal.not_member_self with selfMember
