module Grace.Cumulus.Set.Algebra
import Core

def symmetricDifference (A B : Set) : Set := (A ∖ B) ∪ (B ∖ A)
notation infixl 60 "△" => symmetricDifference

theorem symmetricDifference.membership (x A B : Set)
  shows x ∈ A △ B ↔ ¬(x ∈ A ↔ x ∈ B)
proof
  simp [symmetricDifference]

-- Inclusion

theorem Subset.of_eq (A B : Set)
  requires h : A = B
  shows A ⊆ B
proof
  rw h
  simp

theorem Subset.empty_iff (A : Set)
  shows A ⊆ ∅ ↔ A = ∅
proof
  constructor
  . intro h
    ext y
    simp
  . intro h
    rw h
    simp

theorem Subset.union2_iff (A B C : Set)
  shows A ∪ B ⊆ C ↔ A ⊆ C ∧ B ⊆ C
proof
  constructor
  . intro h
    constructor
    . simp
    . simp
  . intro h
    simp

theorem Subset.intersection_iff (A B C : Set)
  shows A ⊆ B ∩ C ↔ A ⊆ B ∧ A ⊆ C
proof
  constructor
  . intro h
    constructor
    . simp
    . simp
  . intro h
    simp

-- Union

theorem union2.left_empty (A : Set)
  shows ∅ ∪ A = A
proof
  ext y
  simp

theorem union2.right_empty (A : Set)
  shows A ∪ ∅ = A
proof
  ext y
  simp

theorem union2.monotone (A B C D : Set)
  requires hAC : A ⊆ C
  requires hBD : B ⊆ D
  shows A ∪ B ⊆ C ∪ D
proof
  simp

theorem union2.monotone_left (A B C : Set)
  requires h : A ⊆ B
  shows A ∪ C ⊆ B ∪ C
proof
  simp

theorem union2.monotone_right (A B C : Set)
  requires h : A ⊆ B
  shows C ∪ A ⊆ C ∪ B
proof
  simp

theorem union2.eq_right_of_subset (A B : Set)
  requires h : A ⊆ B
  shows A ∪ B = B
proof
  ext y
  simp

theorem union2.eq_left_of_subset (A B : Set)
  requires h : B ⊆ A
  shows A ∪ B = A
proof
  ext y
  simp

theorem union2.subset_iff_eq (A B : Set)
  shows A ⊆ B ↔ A ∪ B = B
proof
  constructor
  . intro h
    ext y
    simp
  . intros h x hx
    have member : x ∈ A ∪ B by simp [hx]
    rwa h at member

theorem union2.left_commutative (A B C : Set)
  shows A ∪ (B ∪ C) = B ∪ (A ∪ C)
proof
  ext y
  simp

theorem union2.subset_of_subset_left (A B C : Set)
  requires h : A ⊆ B
  shows A ⊆ B ∪ C
proof
  simp

theorem union2.subset_of_subset_right (A B C : Set)
  requires h : A ⊆ C
  shows A ⊆ B ∪ C
proof
  simp

theorem union2.eq_empty_iff (A B : Set)
  shows A ∪ B = ∅ ↔ A = ∅ ∧ B = ∅
proof
  constructor
  . intro h
    constructor
    . ext y
      constructor
      . intro hy
        have member : y ∈ A ∪ B by simp [hy]
        rwa h at member
      . intro hy
        exact empty.subset at A with y, hy
    . ext y
      constructor
      . intro hy
        have member : y ∈ A ∪ B by simp [hy]
        rwa h at member
      . intro hy
        exact empty.subset at B with y, hy
  . intro h
    rw [h.left, h.right]
    exact union2.left_empty

-- Intersection

theorem intersection.left_empty (A : Set)
  shows ∅ ∩ A = ∅
proof
  ext y
  simp

theorem intersection.right_empty (A : Set)
  shows A ∩ ∅ = ∅
proof
  ext y
  simp

theorem intersection.associative (A B C : Set)
  shows (A ∩ B) ∩ C = A ∩ (B ∩ C)
proof
  ext y
  simp

theorem intersection.left_commutative (A B C : Set)
  shows A ∩ (B ∩ C) = B ∩ (A ∩ C)
proof
  ext y
  simp

theorem intersection.monotone (A B C D : Set)
  requires hAC : A ⊆ C
  requires hBD : B ⊆ D
  shows A ∩ B ⊆ C ∩ D
proof
  simp

theorem intersection.monotone_left (A B C : Set)
  requires h : A ⊆ B
  shows A ∩ C ⊆ B ∩ C
proof
  simp

theorem intersection.monotone_right (A B C : Set)
  requires h : A ⊆ B
  shows C ∩ A ⊆ C ∩ B
proof
  simp

theorem intersection.eq_left_of_subset (A B : Set)
  requires h : A ⊆ B
  shows A ∩ B = A
proof
  ext y
  simp

theorem intersection.eq_right_of_subset (A B : Set)
  requires h : B ⊆ A
  shows A ∩ B = B
proof
  ext y
  simp

theorem intersection.subset_iff_eq (A B : Set)
  shows A ⊆ B ↔ A ∩ B = A
proof
  constructor
  . intro h
    ext y
    simp
  . intros h x hx
    rw ← h at hx
    exact intersection.subset_right at A, B with x, hx

theorem intersection.subset_union2 (A B : Set)
  shows A ∩ B ⊆ A ∪ B
proof
  simp

-- Distributivity and absorption

theorem intersection.union2_distrib (A B C : Set)
  shows A ∩ (B ∪ C) = (A ∩ B) ∪ (A ∩ C)
proof
  ext y
  simp

theorem union2.intersection_distrib (A B C : Set)
  shows A ∪ (B ∩ C) = (A ∪ B) ∩ (A ∪ C)
proof
  ext y
  simp

theorem intersection.union2_distrib_right (A B C : Set)
  shows (A ∪ B) ∩ C = (A ∩ C) ∪ (B ∩ C)
proof
  ext y
  simp

theorem union2.intersection_distrib_right (A B C : Set)
  shows (A ∩ B) ∪ C = (A ∪ C) ∩ (B ∪ C)
proof
  ext y
  simp

theorem union2.absorb (A B : Set)
  shows A ∪ (A ∩ B) = A
proof
  ext y
  simp

theorem intersection.absorb (A B : Set)
  shows A ∩ (A ∪ B) = A
proof
  ext y
  simp

-- Difference

theorem difference.self (A : Set)
  shows A ∖ A = ∅
proof
  ext y
  simp

theorem difference.empty (A : Set)
  shows A ∖ ∅ = A
proof
  ext y
  simp

theorem difference.left_empty (A : Set)
  shows ∅ ∖ A = ∅
proof
  ext y
  simp

theorem difference.eq_empty_iff (A B : Set)
  shows A ∖ B = ∅ ↔ A ⊆ B
proof
  constructor
  . intros h x hx
    by_contra absent
    have member : x ∈ A ∖ B by simp [hx, absent]
    rw h at member
    simpa using member
  . intro h
    ext y
    simp

theorem difference.eq_self_iff_disjoint (A B : Set)
  shows A ∖ B = A ↔ A ∩ B = ∅
proof
  constructor
  . intro h
    ext y
    constructor
    . intro hy
      simp [intersection.membership] at hy
      have inA := hy.left
      rw ← h at inA
      simp [difference.membership] at inA
      exfalso
      exact inA.right with hy.right
    . intro hy
      exact empty.subset at A ∩ B with y, hy
  . intro h
    ext y
    constructor
    . intro hy
      simp [difference.membership] at hy
      exact hy.left
    . intro hy
      simp [difference.membership]
      constructor
      . exact hy
      . intro hB
        have member : y ∈ A ∩ B by simp [hy, hB]
        rw h at member
        simpa using member

theorem difference.subset_of_subset (A B C : Set)
  requires h : A ⊆ B
  shows A ∖ C ⊆ B ∖ C
proof
  simp

theorem difference.antitone (A B C : Set)
  requires h : B ⊆ C
  shows A ∖ C ⊆ A ∖ B
proof
  simp

theorem difference.monotone (A B C D : Set)
  requires hAC : A ⊆ C
  requires hDB : D ⊆ B
  shows A ∖ B ⊆ C ∖ D
proof
  simp

theorem difference.union2_of_subset (A B : Set)
  requires h : A ⊆ B
  shows A ∪ (B ∖ A) = B
proof
  ext y
  simp

theorem difference.union2_self (A B : Set)
  shows A ∪ (B ∖ A) = A ∪ B
proof
  ext y
  simp

theorem difference.difference (A B : Set)
  shows A ∖ (A ∖ B) = A ∩ B
proof
  ext y
  simp

theorem difference.difference_right (A B C : Set)
  shows (A ∖ B) ∖ C = A ∖ (B ∪ C)
proof
  ext y
  simp

theorem difference.union2 (A B C : Set)
  shows A ∖ (B ∪ C) = (A ∖ B) ∩ (A ∖ C)
proof
  ext y
  simp

theorem difference.intersection (A B C : Set)
  shows A ∖ (B ∩ C) = (A ∖ B) ∪ (A ∖ C)
proof
  ext y
  simp

theorem difference.union2_left (A B C : Set)
  shows (A ∪ B) ∖ C = (A ∖ C) ∪ (B ∖ C)
proof
  ext y
  simp

theorem difference.intersection_left (A B C : Set)
  shows (A ∩ B) ∖ C = (A ∖ C) ∩ (B ∖ C)
proof
  ext y
  simp

theorem difference.intersection_right (A B C : Set)
  shows A ∖ (B ∖ C) = (A ∖ B) ∪ (A ∩ C)
proof
  ext y
  simp

theorem difference.of_intersection (A B : Set)
  shows A ∖ (A ∩ B) = A ∖ B
proof
  ext y
  simp

theorem difference.intersection_eq (A B : Set)
  shows (A ∖ B) ∩ B = ∅
proof
  ext y
  simp

theorem difference.disjoint (A B : Set)
  shows Disjoint(A ∖ B, B)
proof
  simp [Disjoint, difference.intersection_eq]

theorem difference.union2_intersection (A B : Set)
  shows (A ∖ B) ∪ (A ∩ B) = A
proof
  ext y
  simp

theorem difference.of_union2 (A B : Set)
  shows (A ∪ B) ∖ B = A ∖ B
proof
  ext y
  simp

theorem difference.subset_iff (A B C : Set)
  shows A ∖ B ⊆ C ↔ A ⊆ B ∪ C
proof
  constructor
  . intro h
    simp
  . intros h x hx
    simp [difference.membership] at hx
    have inUnion : x ∈ B ∪ C := h with x, hx.left
    simp [union2.membership] at inUnion
    cases inUnion with inB | inC
    . exfalso
      exact hx.right with inB
    . exact inC

-- Disjointness

theorem Disjoint.iff (A B : Set)
  shows Disjoint(A, B) ↔ ∀ x ∈ A, ¬(x ∈ B)
proof
  constructor
  . intros h x hx hB
    have member : x ∈ A ∩ B by simp [hx, hB]
    simp [Disjoint] at h
    rw h at member
    simpa using member
  . intro h
    simp [Disjoint]
    ext y
    constructor
    . intro hy
      simp [intersection.membership] at hy
      exfalso
      exact h with y, hy.left, hy.right
    . intro hy
      exact empty.subset at A ∩ B with y, hy

theorem Disjoint.empty_left (A : Set)
  shows Disjoint(∅, A)
proof
  simp [Disjoint, intersection.left_empty]

theorem Disjoint.empty_right (A : Set)
  shows Disjoint(A, ∅)
proof
  simp [Disjoint, intersection.right_empty]

theorem Disjoint.of_subset_left (A B C : Set)
  requires h : Disjoint(B, C)
  requires hAB : A ⊆ B
  shows Disjoint(A, C)
proof
  have absent := Disjoint.iff.forward with h
  apply Disjoint.iff.backward
  intros x hx
  exact absent with x, (hAB with x, hx)

theorem Disjoint.of_subset_right (A B C : Set)
  requires h : Disjoint(A, C)
  requires hBC : B ⊆ C
  shows Disjoint(A, B)
proof
  have absent := Disjoint.iff.forward with h
  apply Disjoint.iff.backward
  intros x hx hB
  exact absent with x, hx, (hBC with x, hB)

theorem Disjoint.union2_iff (A B C : Set)
  shows Disjoint(A ∪ B, C) ↔ Disjoint(A, C) ∧ Disjoint(B, C)
proof
  constructor
  . intro h
    have absent := Disjoint.iff.forward with h
    constructor
    . apply Disjoint.iff.backward
      intros x hx
      exact absent with x, (union2.subset_left at A, B with x, hx)
    . apply Disjoint.iff.backward
      intros x hx
      exact absent with x, (union2.subset_right at A, B with x, hx)
  . intro h
    have absentA := Disjoint.iff.forward with h.left
    have absentB := Disjoint.iff.forward with h.right
    apply Disjoint.iff.backward
    intros x hx
    simp [union2.membership] at hx
    cases hx with inA | inB
    . exact absentA with x, inA
    . exact absentB with x, inB

theorem Disjoint.difference_left (A B : Set)
  shows Disjoint(A ∖ B, B)
proof
  exact difference.disjoint

theorem Disjoint.difference_right (A B : Set)
  shows Disjoint(B, A ∖ B)
proof
  apply Disjoint.symmetric
  exact difference.disjoint

theorem Disjoint.subset_difference (A B : Set)
  requires h : Disjoint(A, B)
  shows A ⊆ A ∖ B
proof
  have absent := Disjoint.iff.forward with h
  intros x hx
  simp [difference.membership]

-- Symmetric difference

theorem symmetricDifference.commutative (A B : Set)
  shows A △ B = B △ A
proof
  ext y
  simp [symmetricDifference]

theorem symmetricDifference.self (A : Set)
  shows A △ A = ∅
proof
  ext y
  simp [symmetricDifference]

theorem symmetricDifference.empty (A : Set)
  shows A △ ∅ = A
proof
  ext y
  simp [symmetricDifference]

theorem symmetricDifference.left_empty (A : Set)
  shows ∅ △ A = A
proof
  ext y
  simp [symmetricDifference]

theorem symmetricDifference.eq_difference (A B : Set)
  shows A △ B = (A ∪ B) ∖ (A ∩ B)
proof
  ext y
  simp [symmetricDifference]

theorem symmetricDifference.associative (A B C : Set)
  shows (A △ B) △ C = A △ (B △ C)
proof
  ext y
  simp [symmetricDifference]

theorem symmetricDifference.union2 (A B : Set)
  shows A ∪ B = (A △ B) ∪ (A ∩ B)
proof
  ext y
  simp [symmetricDifference]

theorem symmetricDifference.intersection_distrib (A B C : Set)
  shows A ∩ (B △ C) = (A ∩ B) △ (A ∩ C)
proof
  ext y
  simp [symmetricDifference]

theorem symmetricDifference.eq_empty_iff (A B : Set)
  shows A △ B = ∅ ↔ A = B
proof
  constructor
  . intro h
    ext y
    by_contra different
    have member : y ∈ A △ B by simp [symmetricDifference.membership]
    rw h at member
    simpa using member
  . intro h
    rw h
    exact symmetricDifference.self

theorem symmetricDifference.subset (A B C : Set)
  requires first : A ⊆ C
  requires second : B ⊆ C
  shows A △ B ⊆ C
proof
  have left : A ∖ B ⊆ C :=
    Subset.transitive with (difference.subset_left at A, B), first
  have right : B ∖ A ⊆ C :=
    Subset.transitive with (difference.subset_left at B, A), second
  unfold symmetricDifference
  exact union2.subset with left, right
