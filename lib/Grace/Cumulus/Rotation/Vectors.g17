-- Vectors of ℝ³: functions v : 3 → ℝ, the dot product and the squared
-- norm, the unit sphere S², entries of 3 × 3 real matrices as sums of
-- three terms, and the action M · v of a matrix on a vector
-- Part of Cumulus, the Grace17 mathematics library.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module Grace.Cumulus.Rotation.Vectors
import Real.Field
import Real.Natural
import Algebra.Ring.MatrixEntries

-- The three indices of a vector or a row.
instance index.zero_mem
  shows 0 ∈ 3
proof
  typecheck

instance index.one_mem
  shows 1 ∈ 3
proof
  typecheck

instance index.two_mem
  shows 2 ∈ 3
proof
  typecheck

theorem index.zero_ne_one
  shows 0 ≠ 1
proof
  intro equal
  arith

theorem index.zero_ne_two
  shows 0 ≠ 2
proof
  intro equal
  arith

theorem index.one_ne_two
  shows 1 ≠ 2
proof
  intro equal
  arith

theorem index.one_ne_zero
  shows 1 ≠ 0
proof
  intro equal
  arith

theorem index.two_ne_zero
  shows 2 ≠ 0
proof
  intro equal
  arith

theorem index.two_ne_one
  shows 2 ≠ 1
proof
  intro equal
  arith

theorem index.cases (i : Set)
  requires member : i ∈ 3
  shows i = 0 ∨ i = 1 ∨ i = 2
proof
  have natural := natural.member_natural at 3 with i, member
  have below := Less.of_membership at i, 3 with member
  have le2 : i ≤ 2 by arith
  have split := LessEqual.cases at i, 2 with le2
  cases split with lt2 | eq2
  . have le1 : i ≤ 1 by arith
    have split1 := LessEqual.cases at i, 1 with le1
    cases split1 with lt1 | eq1
    . left
      have le0 : i ≤ 0 by arith
      exact LessEqual.eq_zero with le0
    . right
      left
      exact eq1
  . right
    right
    exact eq2

-- ℝ³ is the set of functions 3 → ℝ.
def ℝ³ : Set := functionSpace(3, ℝ)

theorem ℝ³.membership (v : Set)
  shows v ∈ ℝ³ ↔ v : 3 → ℝ
proof
  simp [ℝ³, functionSpace.membership]

theorem ℝ³.function (v : Set)
  requires member : v ∈ ℝ³
  shows v : 3 → ℝ
proof
  exact ℝ³.membership.forward with member

instance ℝ³.of_function (v : Set)
  requires vector : v : 3 → ℝ
  shows v ∈ ℝ³
proof
  exact ℝ³.membership.backward with vector

instance vector.component_real (v i : Set)
  requires vector : v : 3 → ℝ
  requires index : i ∈ 3
  shows v(i) ∈ ℝ
proof
  exact FunctionBetween.apply_closed with vector, index

-- The dot product and the squared norm.
def dot3 (u v : Set) : Set :=
  (u(0):R) * (v(0):R) + (u(1):R) * (v(1):R) + (u(2):R) * (v(2):R)

def normSq (v : Set) : Set := dot3(v, v)

theorem dot3.value (u v : Set)
  shows dot3(u, v) = (u(0):R) * (v(0):R) + (u(1):R) * (v(1):R) + (u(2):R) * (v(2):R)
proof
  simp [dot3]

theorem normSq.value (v : Set)
  shows normSq(v) = (v(0):R) * (v(0):R) + (v(1):R) * (v(1):R) + (v(2):R) * (v(2):R)
proof
  simp [normSq, dot3]

instance dot3.real (u v : Set)
  requires vectorU : u : 3 → ℝ
  requires vectorV : v : 3 → ℝ
  shows dot3(u, v) ∈ ℝ
proof
  have u0 := vector.component_real at u, 0 with vectorU, index.zero_mem
  have u1 := vector.component_real at u, 1 with vectorU, index.one_mem
  have u2 := vector.component_real at u, 2 with vectorU, index.two_mem
  have v0 := vector.component_real at v, 0 with vectorV, index.zero_mem
  have v1 := vector.component_real at v, 1 with vectorV, index.one_mem
  have v2 := vector.component_real at v, 2 with vectorV, index.two_mem
  rw dot3.value
  typecheck

instance normSq.real (v : Set)
  requires vector : v : 3 → ℝ
  shows normSq(v) ∈ ℝ
proof
  unfold normSq
  exact dot3.real with vector, vector

theorem dot3.symmetric (u v : Set)
  requires vectorU : u : 3 → ℝ
  requires vectorV : v : 3 → ℝ
  shows dot3(u, v) = dot3(v, u)
proof
  have u0 := vector.component_real at u, 0 with vectorU, index.zero_mem
  have u1 := vector.component_real at u, 1 with vectorU, index.one_mem
  have u2 := vector.component_real at u, 2 with vectorU, index.two_mem
  have v0 := vector.component_real at v, 0 with vectorV, index.zero_mem
  have v1 := vector.component_real at v, 1 with vectorV, index.one_mem
  have v2 := vector.component_real at v, 2 with vectorV, index.two_mem
  rw [dot3.value, dot3.value]
  ring

-- The unit sphere.
def S² : Set := { v ∈ ℝ³ | normSq(v) = (1:R) }

theorem S².membership (v : Set)
  shows v ∈ S² ↔ v ∈ ℝ³ ∧ normSq(v) = (1:R)
proof
  simp [S²]

theorem S².subset
  shows S² ⊆ ℝ³
proof
  intros v hv
  have parts := S².membership.forward with hv
  exact parts.left

theorem S².function (v : Set)
  requires member : v ∈ S²
  shows v : 3 → ℝ
proof
  have parts := S².membership.forward with member
  exact ℝ³.function with parts.left

-- Entries of a 3 × 3 real matrix are real.
instance Matrix.real_entry (M : realRing ^ 3 × 3) (i j : Set)
  requires row : i ∈ 3
  requires column : j ∈ 3
  shows M[i, j] ∈ ℝ
proof
  have entry := Matrix.entry at M, realRing, 3, i, j with *
  rw realRing.carrierOf at entry
  exact entry

theorem Matrix.row_real (M : realRing ^ 3 × 3) (i : Set)
  requires row : i ∈ 3
  shows M[i, 0] ∈ ℝ ∧ M[i, 1] ∈ ℝ ∧ M[i, 2] ∈ ℝ
proof
  have e0 := Matrix.real_entry at M, i, 0 with *
  have e1 := Matrix.real_entry at M, i, 1 with *
  have e2 := Matrix.real_entry at M, i, 2 with *
  exact ⟨e0, e1, e2⟩

-- The operations of realRing are the real operations.
theorem realRing.add_value (x y : Set)
  shows call2(Ring.add(realRing), x, y) = (x:R) + (y:R)
proof
  simp [realRing, Ring.mk.add]

theorem realRing.mul_value (x y : Set)
  shows call2(Ring.mul(realRing), x, y) = (x:R) * (y:R)
proof
  simp [realRing, Ring.mk.mul]

theorem realRing.zero_value
  shows Ring.zero(realRing) = (0:R)
proof
  simp [realRing, Ring.mk.zero]

theorem realRing.one_value
  shows Ring.one(realRing) = (1:R)
proof
  simp [realRing, Ring.mk.one]

-- A finite sum over the index set 3 is the sum of its three terms.
theorem finiteRingSum.three (A add zero neg mul one w : Set)
  requires ring : IsCommRing(A, add, zero, neg, mul, one)
  requires weights : w : 3 → A
  shows finiteRingSum(3, A, add, zero, neg, mul, one, w) =
    call2(add, call2(add, w(0), w(1)), w(2))
proof
  have three : 3 = insert(2, 2) := natural.successor_as_insert at 2 with *
  have two : 2 = insert(1, 1) := natural.successor_as_insert at 1 with *
  have one : 1 = insert(0, 0) := natural.successor_as_insert at 0 with *
  have finite2 := Finite.natural at 2
  have finite1 := Finite.natural at 1
  have finite0 := Finite.natural at 0
  have fresh2 := membership.irreflexive at 2
  have fresh1 := membership.irreflexive at 1
  have fresh0 := membership.irreflexive at 0
  have sub2 : 2 ⊆ 3
    intros x hx
    exact membership.into_successor at x, 2 with hx
  have sub1 : 1 ⊆ 2
    intros x hx
    exact membership.into_successor at x, 1 with hx
  have closed2 : ∀ x ∈ 2, w(x) ∈ A
    intros x hx
    exact FunctionBetween.apply_closed with weights, (sub2 with x, hx)
  have weights2 := restrict.function at w, 3, A, 2, A with *
  have closed1 : ∀ x ∈ 1, restrict(w, 2)(x) ∈ A
    intros x hx
    exact FunctionBetween.apply_closed with weights2, (sub1 with x, hx)
  have weights1 := restrict.function at restrict(w, 2), 2, A, 1, A with *
  have closed0 : ∀ x ∈ 0, restrict(restrict(w, 2), 1)(x) ∈ A
    intros x hx
    exfalso
    settle with nat.zero, set.empty
  have sub0 : 0 ⊆ 1
    intros x hx
    exact membership.into_successor at x, 0 with hx
  have weights0 := restrict.function at restrict(restrict(w, 2), 1), 1, A, 0, A with *
  have weights3i : w : insert(2, 2) → A
    rw ← three
    exact weights
  have step3 := finiteRingSum.insert at 2, A, add, zero, neg, mul, one, w, 2
    with ring, finite2, weights3i, fresh2
  rw ← three at step3
  have weights2i : restrict(w, 2) : insert(1, 1) → A
    rw ← two
    exact weights2
  have step2 := finiteRingSum.insert at 1, A, add, zero, neg, mul, one, restrict(w, 2), 1
    with ring, finite1, weights2i, fresh1
  rw ← two at step2
  have weights1i : restrict(restrict(w, 2), 1) : insert(0, 0) → A
    rw ← one
    exact weights1
  have step1 := finiteRingSum.insert at 0, A, add, zero, neg, mul, one,
    restrict(restrict(w, 2), 1), 0 with ring, finite0, weights1i, fresh0
  rw ← one at step1
  have value1 := restrict.apply at w, 3, A, 2, A, 1 with *
  have value0 := restrict.apply at w, 3, A, 2, A, 0 with *
  have value00 := restrict.apply at restrict(w, 2), 2, A, 1, A, 0 with *
  have weightsE : restrict(restrict(restrict(w, 2), 1), 0) : ∅ → A
    rw ← nat.zero
    exact weights0
  have step0 := finiteRingSum.empty at A, add, zero, neg, mul, one,
    restrict(restrict(restrict(w, 2), 1), 0) with ring, weightsE
  rw ← nat.zero at step0
  have w0 := FunctionBetween.apply_closed at w, 3, A, 0 with *
  have ordinary := IsCommRing.ring with ring
  have identity := IsRing.add_left_identity at A, add, zero, neg, mul, one, w(0)
    with ordinary, w0
  rw [step3, step2, step1, step0, value1, value00, value0, identity]
  rfl

-- An entry of a product of 3 × 3 real matrices is the sum of three terms.
theorem matrixRing.mul_entry_three (M N : realRing ^ 3 × 3) (i j : Set)
  requires row : i ∈ 3
  requires column : j ∈ 3
  shows (M * N)[i, j] =
    (M[i, 0]:R) * (N[0, j]:R) + (M[i, 1]:R) * (N[1, j]:R) + (M[i, 2]:R) * (N[2, j]:R)
proof
  have comm := realRing.comm_ring
  have parts := CommRing.parts with comm
  have entry := matrixRing.mul_entry at realRing, 3, M, N, i, j with *
  have squareM := Matrix.square at M, realRing, 3 with *
  have squareN := Matrix.square at N, realRing, 3 with *
  have shapeM := squareMatrices.membership.forward with squareM
  have shapeN := squareMatrices.membership.forward with squareN
  have weights := matrixProductWeights.function at 3, Ring.carrier(realRing),
    Ring.add(realRing), Ring.zero(realRing), Ring.neg(realRing), Ring.mul(realRing),
    Ring.one(realRing), M, N, i, j with *
  have three := finiteRingSum.three at Ring.carrier(realRing), Ring.add(realRing),
    Ring.zero(realRing), Ring.neg(realRing), Ring.mul(realRing), Ring.one(realRing),
    matrixProductWeights(3, Ring.carrier(realRing), Ring.add(realRing),
      Ring.zero(realRing), Ring.neg(realRing), Ring.mul(realRing), Ring.one(realRing),
      M, N, i, j) with parts, weights
  have w0 := matrixProductWeights.value at 3, Ring.carrier(realRing),
    Ring.add(realRing), Ring.zero(realRing), Ring.neg(realRing), Ring.mul(realRing),
    Ring.one(realRing), M, N, i, j, 0 with *
  have w1 := matrixProductWeights.value at 3, Ring.carrier(realRing),
    Ring.add(realRing), Ring.zero(realRing), Ring.neg(realRing), Ring.mul(realRing),
    Ring.one(realRing), M, N, i, j, 1 with *
  have w2 := matrixProductWeights.value at 3, Ring.carrier(realRing),
    Ring.add(realRing), Ring.zero(realRing), Ring.neg(realRing), Ring.mul(realRing),
    Ring.one(realRing), M, N, i, j, 2 with *
  rw entry
  unfold matrixProductEntry
  simp [realRing.mul_value, realRing.add_value]

-- The action of a 3 × 3 real matrix on a vector, M · v.
defgraph matrixVector (M v : Set) (i ∈ 3) : ℝ :=
  (M[i, 0]:R) * (v(0):R) + (M[i, 1]:R) * (v(1):R) + (M[i, 2]:R) * (v(2):R)
requires matrix : M : realRing ^ 3 × 3
requires vector : v : 3 → ℝ
proof
  have m0 := Matrix.real_entry at M, i, 0 with matrix, member, index.zero_mem
  have m1 := Matrix.real_entry at M, i, 1 with matrix, member, index.one_mem
  have m2 := Matrix.real_entry at M, i, 2 with matrix, member, index.two_mem
  have v0 := vector.component_real at v, 0 with vector, index.zero_mem
  have v1 := vector.component_real at v, 1 with vector, index.one_mem
  have v2 := vector.component_real at v, 2 with vector, index.two_mem
  typecheck

notation infixl 72 "·" => matrixVector

theorem matrixVector.entry (M v i : Set)
  requires matrix : M : realRing ^ 3 × 3
  requires vector : v : 3 → ℝ
  requires index : i ∈ 3
  shows (M · v)(i) = (M[i, 0]:R) * (v(0):R) + (M[i, 1]:R) * (v(1):R) + (M[i, 2]:R) * (v(2):R)
proof
  exact matrixVector.value with *

instance matrixVector.vector (M v : Set)
  requires matrix : M : realRing ^ 3 × 3
  requires vector : v : 3 → ℝ
  shows M · v : 3 → ℝ
proof
  exact matrixVector.function with *

-- The ring of 3 × 3 real matrices, as a closed instance, so that its
-- numerals matrixRing(realRing, 3)[0] and matrixRing(realRing, 3)[1] read.
instance matrixRing.real_ring
  shows Ring(matrixRing(realRing, 3))
proof
  have comm := realRing.comm_ring
  exact matrixRing.ring at realRing, 3 with comm

-- Products of matrices are square matrices, and the identity is one.
instance Matrix.mul_matrix (M N : realRing ^ 3 × 3)
  shows M * N : realRing ^ 3 × 3
proof
  have comm := realRing.comm_ring
  have ring := matrixRing.real_ring
  have memberM := Matrix.mem_ring at M, realRing, 3 with assumption
  have memberN := Matrix.mem_ring at N, realRing, 3 with assumption
  have product := Ring.mul_mem at matrixRing(realRing, 3), M, N with *
  exact Matrix.of_mem with product

instance Matrix.one_matrix
  shows matrixRing(realRing, 3)[1] : realRing ^ 3 × 3
proof
  have comm := realRing.comm_ring
  have ring := matrixRing.real_ring
  have unit := Ring.one_mem at matrixRing(realRing, 3) with ring
  apply Matrix.of_mem
  exact unit

-- The identity matrix acts trivially and a product acts by composition.
theorem matrixVector.one (v : Set)
  requires vector : v : 3 → ℝ
  shows matrixRing(realRing, 3)[1] · v = v
proof
  have comm := realRing.comm_ring
  have one := Matrix.one_matrix
  have zeroIn : Ring.zero(realRing) ∈ Ring.carrier(realRing) := Ring.zero_mem with *
  have oneIn : Ring.one(realRing) ∈ Ring.carrier(realRing) := Ring.one_mem with *
  have image := matrixVector.vector at matrixRing(realRing, 3)[1], v with *
  have v0 := vector.component_real at v, 0 with vector, index.zero_mem
  have v1 := vector.component_real at v, 1 with vector, index.one_mem
  have v2 := vector.component_real at v, 2 with vector, index.two_mem
  apply FunctionBetween.ext with image, vector
  intros i hi
  have entry := matrixVector.entry at matrixRing(realRing, 3)[1], v, i with one, vector, hi
  rw entry
  have e0 := matrixRing.one_entry at realRing, 3, i, 0 with *
  have e1 := matrixRing.one_entry at realRing, 3, i, 1 with *
  have e2 := matrixRing.one_entry at realRing, 3, i, 2 with *
  rw [e0, e1, e2]
  have alternatives := index.cases with hi
  rcases alternatives with at0 | at1 | at2
  . rw at0
    have s0 := singleValue.same at Ring.carrier(realRing), Ring.zero(realRing),
      Ring.one(realRing), 0, 0 with *
    have s1 := singleValue.other at Ring.carrier(realRing), Ring.zero(realRing),
      Ring.one(realRing), 1, 0 with zeroIn, oneIn, index.zero_ne_one
    have s2 := singleValue.other at Ring.carrier(realRing), Ring.zero(realRing),
      Ring.one(realRing), 2, 0 with zeroIn, oneIn, index.zero_ne_two
    rw [s0, s1, s2, realRing.zero_value, realRing.one_value]
    ring
  . rw at1
    have same1 : 1 = 1 by rfl
    have s0 := singleValue.other at Ring.carrier(realRing), Ring.zero(realRing),
      Ring.one(realRing), 0, 1 with zeroIn, oneIn, index.one_ne_zero
    have s1 := singleValue.same at Ring.carrier(realRing), Ring.zero(realRing),
      Ring.one(realRing), 1, 1 with zeroIn, oneIn, same1
    have s2 := singleValue.other at Ring.carrier(realRing), Ring.zero(realRing),
      Ring.one(realRing), 2, 1 with zeroIn, oneIn, index.one_ne_two
    rw [s0, s1, s2, realRing.zero_value, realRing.one_value]
    ring
  . rw at2
    have same2 : 2 = 2 by rfl
    have s0 := singleValue.other at Ring.carrier(realRing), Ring.zero(realRing),
      Ring.one(realRing), 0, 2 with zeroIn, oneIn, index.two_ne_zero
    have s1 := singleValue.other at Ring.carrier(realRing), Ring.zero(realRing),
      Ring.one(realRing), 1, 2 with zeroIn, oneIn, index.two_ne_one
    have s2 := singleValue.same at Ring.carrier(realRing), Ring.zero(realRing),
      Ring.one(realRing), 2, 2 with zeroIn, oneIn, same2
    rw [s0, s1, s2, realRing.zero_value, realRing.one_value]
    ring

theorem matrixVector.mul (M N : realRing ^ 3 × 3) (v : Set)
  requires vector : v : 3 → ℝ
  shows (M * N) · v = M · (N · v)
proof
  have product := Matrix.mul_matrix at M, N with *
  have inner := matrixVector.vector at N, v with *
  have left := matrixVector.vector at M * N, v with *
  have right := matrixVector.vector at M, N · v with *
  apply FunctionBetween.ext with left, right
  intros i hi
  have leftEntry := matrixVector.entry at M * N, v, i with *
  have rightEntry := matrixVector.entry at M, N · v, i with *
  have c0 := matrixRing.mul_entry_three at M, N, i, 0 with *
  have c1 := matrixRing.mul_entry_three at M, N, i, 1 with *
  have c2 := matrixRing.mul_entry_three at M, N, i, 2 with *
  have n0 := matrixVector.entry at N, v, 0 with *
  have n1 := matrixVector.entry at N, v, 1 with *
  have n2 := matrixVector.entry at N, v, 2 with *
  obtain ⟨m0, m1, m2⟩ := Matrix.row_real at M, i with hi
  obtain ⟨n00, n01, n02⟩ := Matrix.row_real at N, 0 with index.zero_mem
  obtain ⟨n10, n11, n12⟩ := Matrix.row_real at N, 1 with index.one_mem
  obtain ⟨n20, n21, n22⟩ := Matrix.row_real at N, 2 with index.two_mem
  have v0 := vector.component_real at v, 0 with vector, index.zero_mem
  have v1 := vector.component_real at v, 1 with vector, index.one_mem
  have v2 := vector.component_real at v, 2 with vector, index.two_mem
  rw [leftEntry, rightEntry, c0, c1, c2, n0, n1, n2]
  ring
