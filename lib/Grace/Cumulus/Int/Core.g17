module Grace.Cumulus.Int.Core
import Defs

def integerClass (a b : Set) : Set :=
  ⟦(a, b)⟧[integerPairs, integerEquivalent]

def integerZero : Integer := integerClass(0, 0)
def integerOfNat (n : Nat) : Integer := integerClass(n, 0)
def integerNegativeOfNat (n : Nat) : Integer := integerClass(0, n)

theorem integerClass.membership (p a b : Set)
  shows p ∈ integerClass(a, b) ↔ (p ∈ integerPairs ∧ relates(integerEquivalent, (a, b), p))
proof
  simp [integerClass, equivalenceClass.membership]

theorem integerClass.integer (a b : Nat)
  shows Integer(integerClass(a, b))
proof
  unfold Integer
  unfold ℤ
  unfold integerClass
  apply quotient.contains_class
  . exact integerEquivalent.equivalence
  . exact integerPairs.pair at a, b

theorem integerClass.eq (a b c d : Nat)
  requires equivalent : add(a, d) = add(c, b)
  shows integerClass(a, b) = integerClass(c, d)
proof
  unfold integerClass
  apply equivalenceClass.eq
  . exact integerEquivalent.equivalence
  . exact integerPairs.pair at a, b
  . exact integerPairs.pair at c, d
  . have characterization := integerEquivalent.relates_pairs at a, b, c, d
    apply characterization.backward
    exact equivalent

theorem integerZero.integer
  shows Integer(integerZero)
proof
  unfold integerZero
  exact integerClass.integer with Naturals.constructor.zero, Naturals.constructor.zero

theorem integerOfNat.integer (n : Nat)
  shows Integer(integerOfNat(n))
proof
  unfold integerOfNat
  exact integerClass.integer with Naturals.constructor.zero

theorem integerNegativeOfNat.integer (n : Nat)
  shows Integer(integerNegativeOfNat(n))
proof
  unfold integerNegativeOfNat
  exact integerClass.integer with Naturals.constructor.zero

theorem integerOfNat.zero
  shows integerOfNat(0) = integerZero
proof
  simp

-- Every integer is represented by a difference of two naturals.
theorem Integer.representatives (z : Set)
  requires integer : Integer(z)
  shows ∃ a, Nat(a) ∧ ∃ b, Nat(b) ∧ z = integerClass(a, b)
proof
  unfold Integer at integer
  unfold ℤ at integer
  obtain ⟨bounded, p, pair, shape⟩ := quotient.membership.forward with integer
  obtain ⟨a, aNat, b, bNat, coordinates⟩ := integerPairs.coordinates with pair
  witness a
  witness b
  unfold integerClass
  rw ← coordinates
  exact shape

theorem integerClass.equivalent_of_eq (a b c d : Nat)
  requires same : integerClass(a, b) = integerClass(c, d)
  shows a + d = c + b
proof
  have left := integerPairs.pair at a, b with *
  have right := integerPairs.pair at c, d with *
  simp [integerClass] at same
  have related := equivalenceClass.related_of_eq with integerEquivalent.equivalence, left, right, same
  exact integerEquivalent.relates_pairs.forward with *

theorem integerOfNat.injective (a b : Nat)
  requires same : integerOfNat(a) = integerOfNat(b)
  shows a = b
proof
  simp [integerOfNat] at same
  have sums := integerClass.equivalent_of_eq with *
  simpa [add.right_unit] using sums
