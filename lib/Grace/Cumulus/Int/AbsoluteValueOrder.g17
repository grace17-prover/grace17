module Grace.Cumulus.Int.AbsoluteValueOrder
import OrderMul

theorem integerAbs.value (z : Integer)
  shows integerAbs(z) = integerOfNat(integerNatAbs(z))
proof
  simp [integerAbs]

theorem integerAbs.nonneg (z : Integer)
  shows 0 ≤ integerAbs(z)
proof
  have magnitude := integerNatAbs.natural at z
  rw integerAbs.value
  exact integerLe.ofNat_nonneg with *

theorem integerAbs.ofNat (n : Nat)
  shows integerAbs(integerOfNat(n)) = integerOfNat(n)
proof
  rw [integerAbs.value, integerNatAbs.ofNat]
  rfl

theorem integerAbs.negative_ofNat (n : Nat)
  shows integerAbs(integerNegativeOfNat(n)) = integerOfNat(n)
proof
  rw [integerAbs.value, integerNatAbs.ofNegativeNat]
  rfl

theorem integerAbs.of_nonneg (z : Integer)
  requires nonnegative : 0 ≤ z
  shows integerAbs(z) = z
proof
  have shape := integerLe.zero_iff.forward with nonnegative
  obtain ⟨n, nNat, equation⟩ := IntegerNonnegative.exists_natural with shape
  rw equation
  exact integerAbs.ofNat with *

theorem integerAbs.of_nonpos (z : Integer)
  requires nonpositive : z ≤ 0
  shows integerAbs(z) = -z
proof
  obtain ⟨n, nNat, equation⟩ := integerLe.exists_negative with nonpositive
  rw [equation, integerAbs.negative_ofNat, integerNegativeOfNat.neg]
  rfl

theorem integerAbs.zero
  shows integerAbs(integerZero) = integerZero
proof
  have reflexive := integerLe.reflexive at integerZero
  exact integerAbs.of_nonneg with reflexive

theorem integerAbs.one
  shows integerAbs(integerOne) = integerOne
proof
  have one := integerLe.zero_one
  exact integerAbs.of_nonneg with one

theorem integerAbs.cases (z : Integer)
  shows integerAbs(z) = z ∨ integerAbs(z) = -z
proof
  have split := integerLe.cases_sign at z
  cases split with nonnegative | nonpositive
  . left
    exact integerAbs.of_nonneg with nonnegative
  . right
    exact integerAbs.of_nonpos with nonpositive

theorem integerAbs.le_self (z : Integer)
  shows z ≤ integerAbs(z)
proof
  have split := integerLe.cases_sign at z
  cases split with nonnegative | nonpositive
  . have value := integerAbs.of_nonneg with nonnegative
    rw value
    exact integerLe.reflexive with *
  . have bound := integerAbs.nonneg at z
    exact integerLe.transitive with nonpositive, bound

theorem integerAbs.neg_le_self (z : Integer)
  shows -z ≤ integerAbs(z)
proof
  have flipped := integerAbs.neg at z
  have bound := integerAbs.le_self at -z
  rw flipped at bound
  exact bound

theorem integerAbs.mul (x y : Integer)
  shows integerAbs(x * y) = integerAbs(x) * integerAbs(y)
proof
  have xNat := integerNatAbs.natural at x
  have yNat := integerNatAbs.natural at y
  have magnitudes := integerNatAbs.mul at x, y
  rw [integerAbs.value, integerAbs.value, integerAbs.value, magnitudes]
  exact integerOfNat.mul with *

theorem integerAbs.eq_zero_iff (z : Integer)
  shows integerAbs(z) = 0 ↔ z = 0
proof
  have magnitude := integerNatAbs.natural at z
  constructor
  . intro zero
    rw [integerAbs.value, ← integerOfNat.zero] at zero
    have vanish := integerOfNat.injective with zero
    exact integerNatAbs.zero_iff.forward with vanish
  . intro zero
    rw zero
    exact integerAbs.zero

theorem integerAbs.positive_of_nonzero (z : Integer)
  requires nonzero : z ≠ 0
  shows 0 < integerAbs(z)
proof
  have nonnegative := integerAbs.nonneg at z
  have distinct : 0 ≠ integerAbs(z)
    intro zero
    symm at zero
    have same := integerAbs.eq_zero_iff.forward with zero
    exact nonzero with same
  exact integerLess.of_le_ne with nonnegative, distinct

theorem integerAbs.le_iff (z b : Integer)
  shows integerAbs(z) ≤ b ↔ -b ≤ z ∧ z ≤ b
proof
  have lower := integerAbs.le_self at z
  have upper := integerAbs.neg_le_self at z
  constructor
  . intro bound
    constructor
    . have negated := integerLe.transitive with upper, bound
      have flipped := integerLe.neg.forward with negated
      have restore : -(-z) = z by ring
      rw restore at flipped
      exact flipped
    . exact integerLe.transitive with lower, bound
  . intro both
    have split := integerAbs.cases at z
    cases split with positive | negative
    . rw positive
      exact both.right
    . rw negative
      have flipped := integerLe.neg.forward with both.left
      have restore : -(-b) = b by ring
      rw restore at flipped
      exact flipped

theorem integerAbs.lt_iff (z b : Integer)
  shows integerAbs(z) < b ↔ -b < z ∧ z < b
proof
  have lower := integerAbs.le_self at z
  have upper := integerAbs.neg_le_self at z
  constructor
  . intro bound
    constructor
    . have negated := integerLe.transitive_less with upper, bound
      have flipped := integerLess.neg.forward with negated
      have restore : -(-z) = z by ring
      rw restore at flipped
      exact flipped
    . exact integerLe.transitive_less with lower, bound
  . intro both
    have split := integerAbs.cases at z
    cases split with positive | negative
    . rw positive
      exact both.right
    . rw negative
      have flipped := integerLess.neg.forward with both.left
      have restore : -(-b) = b by ring
      rw restore at flipped
      exact flipped

theorem integerAbs.triangle (x y : Integer)
  shows integerAbs(x + y) ≤ integerAbs(x) + integerAbs(y)
proof
  have xAbs := integerAbs.integer at x
  have yAbs := integerAbs.integer at y
  have split := integerAbs.cases at x + y
  cases split with positive | negative
  . rw positive
    have xBound := integerAbs.le_self at x
    have yBound := integerAbs.le_self at y
    exact integerLe.add with xBound, yBound
  . rw negative
    have shape : -(x + y) = (-x) + (-y) by ring
    rw shape
    have xBound := integerAbs.neg_le_self at x
    have yBound := integerAbs.neg_le_self at y
    exact integerLe.add with xBound, yBound

theorem integerAbs.sub_abs_le (x y : Integer)
  shows integerAbs(x) - integerAbs(y) ≤ integerAbs(x - y)
proof
  have xAbs := integerAbs.integer at x
  have yAbs := integerAbs.integer at y
  have differenceAbs := integerAbs.integer at x - y
  have restore : x = (x - y) + y by ring
  have bound := integerAbs.triangle at x - y, y
  rw ← restore at bound
  have shifted := integerLe.sub_right at integerAbs(x),
    integerAbs(x - y) + integerAbs(y), integerAbs(y) with bound
  have cancel : integerAbs(x - y) + integerAbs(y) - integerAbs(y) =
      integerAbs(x - y)
    ring
  rw cancel at shifted
  exact shifted

theorem integerAbs.sub_commutative (x y : Integer)
  shows integerAbs(x - y) = integerAbs(y - x)
proof
  have shape : y - x = -(x - y) by ring
  rw [shape, integerAbs.neg]
  rfl

theorem integerAbs.square (z : Integer)
  shows integerAbs(z) * integerAbs(z) = z * z
proof
  have split := integerAbs.cases at z
  cases split with positive | negative
  . rw positive
    rfl
  . rw negative
    ring

theorem integerAbs.eq_iff (x y : Integer)
  shows integerAbs(x) = integerAbs(y) ↔ x = y ∨ x = -y
proof
  constructor
  . intro same
    have xSquare := integerAbs.square at x
    have ySquare := integerAbs.square at y
    rw same at xSquare
    have squares : x * x = y * y
      rw [← xSquare, ← ySquare]
      rfl
    have product : (x - y) * (x + y) = 0
      have shape : (x - y) * (x + y) = x * x - y * y by ring
      rw [shape, squares]
      ring
    have split := integerMulValue.eq_zero with product
    cases split with first | second
    . left
      linear_combination first
    . right
      linear_combination second
  . intro split
    cases split with same | negated
    . rw same
      rfl
    . rw [negated, integerAbs.neg]
      rfl

theorem integerAbs.monotone_nonneg (x y : Integer)
  requires nonnegative : 0 ≤ x
  requires below : x ≤ y
  shows integerAbs(x) ≤ integerAbs(y)
proof
  have yNonnegative := integerLe.transitive with nonnegative, below
  have xValue := integerAbs.of_nonneg with nonnegative
  have yValue := integerAbs.of_nonneg at y with yNonnegative
  rw [xValue, yValue]
  exact below

theorem integerAbs.le_of_abs_le (x b : Integer)
  requires bound : integerAbs(x) ≤ b
  shows x ≤ b
proof
  have both := integerAbs.le_iff.forward with bound
  exact both.right

theorem integerAbs.sub_le_of_le (x y b : Integer)
  requires lower : y - b ≤ x
  requires upper : x ≤ y + b
  shows integerAbs(x - y) ≤ b
proof
  apply integerAbs.le_iff.backward
  constructor
  . have shifted := integerLe.sub_right at y - b, x, y with lower
    have shape : y - b - y = -b by ring
    rw shape at shifted
    exact shifted
  . have shifted := integerLe.sub_right at x, y + b, y with upper
    have shape : y + b - y = b by ring
    rw shape at shifted
    exact shifted
