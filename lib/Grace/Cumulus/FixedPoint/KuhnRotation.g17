-- Kuhn simplices through the face opposite the bottom vertex: rotating the
-- permutation moves the bottom vertex to the top, and the two simplices
-- through such a face are the original one and its rotation
-- Part of Cumulus, the Grace17 mathematics library.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module Grace.Cumulus.FixedPoint.KuhnRotation
import KuhnFaces

-- The cyclic shift l ↦ l + 1 on n, wrapping n − 1 to 0.
defgraph rotation (n : Set) (l ∈ n) : n := chooseNat(equalNat(succ(l), n), 0, succ(l))
requires nNat : Nat(n)
proof
  have lNat := natural.member at n with member
  have less := Less.of_membership with member
  have alternatives : succ(l) = n ∨ succ(l) ≠ n
    tauto
  cases alternatives with wrap | step
  . have flag := equalNat.true_iff.backward with wrap
    rw flag
    simp [chooseNat]
    have positive : 0 < n by arith
    exact membership.of_Less with positive
  . have flag := equalNat.false_iff.backward with step
    rw flag
    simp [chooseNat]
    have separated : n ≠ succ(l)
      intro same
      apply step
      symm
      exact same
    have below := Less.successor_lower_of_ne with less, separated
    exact membership.of_Less with below

theorem rotation.step (n : Nat) (l : Set)
  requires hl : l ∈ n
  requires hs : succ(l) ∈ n
  shows rotation(n)(l) = succ(l)
proof
  have lNat := natural.member at n with hl
  have different : succ(l) ≠ n
    intro same
    rw same at hs
    exact membership.irreflexive with hs
  have flag := equalNat.false_iff.backward with different
  have value := rotation.value at n, l with *
  rw [value, flag]
  simp [chooseNat]

theorem rotation.wrap (n : Nat) (l : Set)
  requires hl : l ∈ n
  requires top : succ(l) = n
  shows rotation(n)(l) = 0
proof
  have lNat := natural.member at n with hl
  have flag := equalNat.true_iff.backward with top
  have value := rotation.value at n, l with *
  rw [value, flag]
  simp [chooseNat]

theorem rotation.cancel (n : Nat) (x y : Set)
  requires hx : x ∈ n
  requires hy : y ∈ n
  requires same : rotation(n)(x) = rotation(n)(y)
  shows x = y
proof
  have xNat := natural.member at n with hx
  have yNat := natural.member at n with hy
  have xLess := Less.of_membership with hx
  have yLess := Less.of_membership with hy
  have xAlternatives : succ(x) = n ∨ succ(x) ≠ n by tauto
  have yAlternatives : succ(y) = n ∨ succ(y) ≠ n by tauto
  cases xAlternatives with xWrap | xStep
  . have xValue := rotation.wrap with hx, xWrap
    cases yAlternatives with yWrap | yStep
    . have both : succ(x) = succ(y)
        rw [xWrap, yWrap]
        rfl
      have forward : x ≤ y by arith
      have backward : y ≤ x by arith
      exact LessEqual.antisymmetric with forward, backward
    . have ySeparated : n ≠ succ(y)
        intro equal
        apply yStep
        symm
        exact equal
      have yIn := membership.of_Less with (Less.successor_lower_of_ne with yLess, ySeparated)
      have yValue := rotation.step with hy, yIn
      rw [xValue, yValue] at same
      arith
  . have xSeparated : n ≠ succ(x)
      intro equal
      apply xStep
      symm
      exact equal
    have xIn := membership.of_Less with (Less.successor_lower_of_ne with xLess, xSeparated)
    have xValue := rotation.step with hx, xIn
    cases yAlternatives with yWrap | yStep
    . have yValue := rotation.wrap with hy, yWrap
      rw [xValue, yValue] at same
      arith
    . have ySeparated : n ≠ succ(y)
        intro equal
        apply yStep
        symm
        exact equal
      have yIn := membership.of_Less with (Less.successor_lower_of_ne with yLess, ySeparated)
      have yValue := rotation.step with hy, yIn
      rw [xValue, yValue] at same
      have forward : x ≤ y by arith
      have backward : y ≤ x by arith
      exact LessEqual.antisymmetric with forward, backward

theorem rotation.injective (n : Nat)
  shows InjectiveBetween(rotation(n), n, n)
proof
  have function := rotation.function at n with *
  constructor
  . exact function
  . intros x hx y hy z hz hxz hyz
    have xValue := FunctionBetween.apply_value with function, hx, hxz
    have yValue := FunctionBetween.apply_value with function, hy, hyz
    have same : rotation(n)(x) = rotation(n)(y)
      rw [xValue, yValue]
      rfl
    exact rotation.cancel with hx, hy, same

theorem rotation.surjective (n : Nat)
  shows SurjectiveBetween(rotation(n), n, n)
proof
  have function := rotation.function at n with *
  constructor
  . exact function
  . intros y hy
    have yNat := natural.member at n with hy
    have yLess := Less.of_membership with hy
    have shape := natural.zero_or_successor with yNat
    cases shape with zero | successor
    . have nShape := natural.zero_or_successor at n with *
      cases nShape with nZero | nSuccessor
      . exfalso
        rw nZero at yLess
        arith
      . obtain ⟨m, mNat, nEq⟩ := nSuccessor
        have top : succ(m) = n
          symm
          exact nEq
        have mIn : m ∈ n
          rw nEq
          exact bootstrap.succ.self
        have value := rotation.wrap with mIn, top
        have edge := FunctionBetween.relates_apply with function, mIn
        rw value at edge
        witness m
        constructor
        . exact mIn
        . rw zero
          exact edge
    . obtain ⟨k, kNat, yEq⟩ := successor
      have kLess : k < n
        rw yEq at yLess
        arith
      have kIn := membership.of_Less with kLess
      have sIn : succ(k) ∈ n by rwa ← yEq
      have value := rotation.step with kIn, sIn
      have edge := FunctionBetween.relates_apply with function, kIn
      rw value at edge
      witness k
      constructor
      . exact kIn
      . rw yEq
        exact edge

theorem rotation.bijective (n : Nat)
  shows BijectiveBetween(rotation(n), n, n)
proof
  constructor
  . exact rotation.injective at n
  . exact rotation.surjective at n

def rotated (n upd : Set) : Set := compose(upd, rotation(n), n, n, n)

theorem rotated.bijective (n : Nat) (upd : Set)
  requires updBijective : BijectiveBetween(upd, n, n)
  shows BijectiveBetween(rotated(n, upd), n, n)
proof
  have turn := rotation.bijective at n
  unfold rotated
  exact compose.bijective with turn, updBijective

theorem rotated.value (n : Nat) (upd l : Set)
  requires updBijective : BijectiveBetween(upd, n, n)
  requires hl : l ∈ n
  shows rotated(n, upd)(l) = upd(rotation(n)(l))
proof
  have updFunction := Injective.function with (Bijective.injective with updBijective)
  have turn := rotation.function at n with *
  have same : rotated(n, upd)(l) = compose(upd, rotation(n), n, n, n)(l)
    unfold rotated
    rfl
  rw same
  exact compose.apply with turn, updFunction, hl

theorem rotated.step (n : Nat) (upd l : Set)
  requires updBijective : BijectiveBetween(upd, n, n)
  requires hl : l ∈ n
  requires hs : succ(l) ∈ n
  shows rotated(n, upd)(l) = upd(succ(l))
proof
  have value := rotated.value with updBijective, hl
  have turn := rotation.step with hl, hs
  rw [value, turn]
  rfl

theorem rotated.wrap (n : Nat) (upd l : Set)
  requires updBijective : BijectiveBetween(upd, n, n)
  requires hl : l ∈ n
  requires top : succ(l) = n
  shows rotated(n, upd)(l) = upd(0)
proof
  have value := rotated.value with updBijective, hl
  have turn := rotation.wrap with hl, top
  rw [value, turn]
  rfl

-- The first k rotated coordinates are coordinates 1, …, k of the original.
theorem raised.rotated (n : Nat) (upd k : Set)
  requires updBijective : BijectiveBetween(upd, n, n)
  requires hk : k ∈ n
  shows raised(n, upd, succ(k)) = insert(upd(0), raised(n, rotated(n, upd), k))
proof
  have updFunction := Injective.function with (Bijective.injective with updBijective)
  have kNat := natural.member at n with hk
  have kLess := Less.of_membership with hk
  have kInside := Ordinal.member_subset with (Ordinal.natural at n), hk
  have zeroLess : 0 < n by arith
  have zeroIn := membership.of_Less with zeroLess
  ext y
  constructor
  . intro hy
    obtain ⟨inN, m, hm, shape⟩ := raised.membership.forward with hy
    have mNat := natural.member at succ(k) with hm
    have mLess := Less.of_membership with hm
    have split := natural.zero_or_successor with mNat
    apply insert.membership.backward
    cases split with zero | successor
    . left
      rw [shape, zero]
      rfl
    . right
      obtain ⟨l, lNat, mEq⟩ := successor
      rw mEq at mLess
      have lLess : l < k by arith
      have lIn := membership.of_Less with lLess
      have lInN := kInside with l, lIn
      have sLess : succ(l) < n by arith
      have sIn := membership.of_Less with sLess
      have value := rotated.step with updBijective, lInN, sIn
      apply raised.membership.backward
      constructor
      . exact inN
      . witness l
        constructor
        . exact lIn
        . rw [shape, mEq, value]
          rfl
  . intro hy
    have split := insert.membership.forward with hy
    cases split with same | below
    . apply raised.membership.backward
      constructor
      . rw same
        exact FunctionBetween.apply_closed with updFunction, zeroIn
      . witness 0
        constructor
        . have less : 0 < succ(k) by arith
          exact membership.of_Less with less
        . exact same
    . obtain ⟨inN, l, hl, shape⟩ := raised.membership.forward with below
      have lInN := kInside with l, hl
      have lNat := natural.member at n with lInN
      have lLess := Less.of_membership with hl
      have sLess : succ(l) < n by arith
      have sIn := membership.of_Less with sLess
      have value := rotated.step with updBijective, lInN, sIn
      apply raised.membership.backward
      constructor
      . exact inN
      . witness succ(l)
        constructor
        . have less : succ(l) < succ(k) by arith
          exact membership.of_Less with less
        . rw [shape, value]
          rfl

theorem raised.rotated_fresh (n : Nat) (upd k : Set)
  requires updBijective : BijectiveBetween(upd, n, n)
  requires hk : k ∈ n
  shows ¬upd(0) ∈ raised(n, rotated(n, upd), k)
proof
  have updInjective := Bijective.injective with updBijective
  have kNat := natural.member at n with hk
  have kLess := Less.of_membership with hk
  have kInside := Ordinal.member_subset with (Ordinal.natural at n), hk
  have zeroLess : 0 < n by arith
  have zeroIn := membership.of_Less with zeroLess
  intro inside
  obtain ⟨inN, l, hl, shape⟩ := raised.membership.forward with inside
  have lInN := kInside with l, hl
  have lNat := natural.member at n with lInN
  have lLess := Less.of_membership with hl
  have sLess : succ(l) < n by arith
  have sIn := membership.of_Less with sLess
  have value := rotated.step with updBijective, lInN, sIn
  rw value at shape
  have same := Injective.apply_cancel with updInjective, zeroIn, sIn, shape
  arith

theorem indicator.insert_fresh (a A j : Set)
  requires fresh : ¬a ∈ A
  shows indicator(insert(a, A), j) = indicator({a}, j) + indicator(A, j)
proof
  have alternatives : j = a ∨ j ≠ a by tauto
  cases alternatives with same | different
  . have inInsert : j ∈ insert(a, A)
      apply insert.membership.backward
      left
      exact same
    have absent : ¬j ∈ A by rwa same
    have one := indicator.member with inInsert
    have self : indicator({a}, j) = 1
      rw same
      exact indicator.singleton_self
    have zero := indicator.absent with absent
    rw [one, self, zero]
    arith
  . have equivalent : j ∈ insert(a, A) ↔ j ∈ A
      constructor
      . intro h
        have split := insert.membership.forward with h
        cases split with equal | inside
        . exfalso
          exact different with equal
        . exact inside
      . intro h
        apply insert.membership.backward
        right
        exact h
    have same := indicator.congr with equivalent
    have separated : a ≠ j
      intro equal
      apply different
      symm
      exact equal
    have zero := indicator.singleton_other with separated
    rw [same, zero]
    ring

-- The rotated simplex, based at the second vertex, lists vertices 1, …, n
-- of the original followed by a new top.
theorem kuhnVertex.rotated (n : Nat) (base upd k : Set)
  requires baseFunction : base : n → ℕ
  requires updBijective : BijectiveBetween(upd, n, n)
  requires hk : k ∈ n
  shows kuhnVertex(n, kuhnVertex(n, base, upd)(succ(0)), rotated(n, upd))(k) = kuhnVertex(n, base, upd)(succ(k))
proof
  have updInjective := Bijective.injective with updBijective
  have kNat := natural.member at n with hk
  have kLess := Less.of_membership with hk
  have zeroLess : 0 < n by arith
  have positive := membership.of_Less with zeroLess
  have oneLess : succ(0) < succ(n) by arith
  have oneIn := membership.of_Less with oneLess
  have kInSucc := membership.into_successor with hk
  have sLess : succ(k) < succ(n) by arith
  have sIn := membership.of_Less with sLess
  have oneFunction := kuhnVertex.function_on at n, base, upd, succ(0) with baseFunction, oneIn
  have leftFunction := kuhnVertex.function_on at n, kuhnVertex(n, base, upd)(succ(0)), rotated(n, upd), k with oneFunction, kInSucc
  have rightFunction := kuhnVertex.function_on at n, base, upd, succ(k) with baseFunction, sIn
  apply FunctionBetween.ext with leftFunction, rightFunction
  intros j hj
  have leftValue := kuhnVertex.coordinate at n, kuhnVertex(n, base, upd)(succ(0)), rotated(n, upd), k, j with oneFunction, kInSucc, hj
  have oneValue := kuhnVertex.coordinate_succ with baseFunction, updInjective, positive, hj
  have zeroValue := kuhnVertex.zero_coordinate at n, base, upd, j with baseFunction, hj
  have rightValue := kuhnVertex.coordinate at n, base, upd, succ(k), j with baseFunction, sIn, hj
  have image := raised.rotated with updBijective, hk
  have fresh := raised.rotated_fresh with updBijective, hk
  have split := indicator.insert_fresh at upd(0), raised(n, rotated(n, upd), k), j with fresh
  have baseNatural := FunctionBetween.apply_closed with baseFunction, hj
  have baseNat := nat.omega.backward with baseNatural
  rw [leftValue, oneValue, zeroValue, rightValue, image, split]
  exact add.associative

theorem kuhnSimplex.rotated_face (n : Nat) (base upd : Set)
  requires baseFunction : base : n → ℕ
  requires updBijective : BijectiveBetween(upd, n, n)
  requires positive : 0 ∈ n
  shows kuhnSimplex(n, base, upd) ∖ {kuhnVertex(n, base, upd)(0)} =
    kuhnSimplex(n, kuhnVertex(n, base, upd)(succ(0)), rotated(n, upd)) ∖
      {kuhnVertex(n, kuhnVertex(n, base, upd)(succ(0)), rotated(n, upd))(n)}
proof
  have updInjective := Bijective.injective with updBijective
  have rotatedInjective := Bijective.injective with (rotated.bijective with updBijective)
  have zeroLess := Less.of_membership with positive
  have oneLess : succ(0) < succ(n) by arith
  have oneIn := membership.of_Less with oneLess
  have oneFunction := kuhnVertex.function_on at n, base, upd, succ(0) with baseFunction, oneIn
  have zeroIn := membership.into_successor with positive
  have nIn := bootstrap.succ.self at n
  ext x
  constructor
  . intro hx
    have parts := difference.singleton_membership.forward with hx
    obtain ⟨inSpace, k, hk, shape⟩ := kuhnSimplex.membership.forward with parts.left
    have kNat := natural.member at succ(n) with hk
    have kLess := Less.of_membership with hk
    have split := natural.zero_or_successor with kNat
    cases split with zero | successor
    . exfalso
      apply parts.right
      rw [shape, zero]
      rfl
    . obtain ⟨m, mNat, kEq⟩ := successor
      rw kEq at kLess
      have mLess : m < n by arith
      have mIn := membership.of_Less with mLess
      have mInSucc := membership.into_successor with mIn
      have agree := kuhnVertex.rotated with baseFunction, updBijective, mIn
      apply difference.singleton_membership.backward
      constructor
      . rw [shape, kEq, ← agree]
        exact kuhnVertex.member with oneFunction, mInSucc
      . intro equal
        rw [shape, kEq, ← agree] at equal
        have same := kuhnVertex.injective with oneFunction, rotatedInjective, mInSucc, nIn, equal
        rw same at mIn
        exact membership.irreflexive with mIn
  . intro hx
    have parts := difference.singleton_membership.forward with hx
    obtain ⟨inSpace, m, hm, shape⟩ := kuhnSimplex.membership.forward with parts.left
    have mIn : m ∈ n
      have split := bootstrap.succ.membership.forward with hm
      cases split with below | same
      . exact below
      . exfalso
        apply parts.right
        rw [shape, same]
        rfl
    have mNat := natural.member at n with mIn
    have mLess := Less.of_membership with mIn
    have sLess : succ(m) < succ(n) by arith
    have sIn := membership.of_Less with sLess
    have agree := kuhnVertex.rotated with baseFunction, updBijective, mIn
    apply difference.singleton_membership.backward
    constructor
    . rw [shape, agree]
      exact kuhnVertex.member with baseFunction, sIn
    . intro equal
      rw [shape, agree] at equal
      have same := kuhnVertex.injective with baseFunction, updInjective, sIn, zeroIn, equal
      arith

-- Away from the bottom vertex, coordinate upd(0) is constant on a simplex.
theorem kuhnSimplex.bottom_face_constant (n : Nat) (base upd x : Set)
  requires baseFunction : base : n → ℕ
  requires updBijective : BijectiveBetween(upd, n, n)
  requires positive : 0 ∈ n
  requires hx : x ∈ kuhnSimplex(n, base, upd) ∖ {kuhnVertex(n, base, upd)(0)}
  shows x(upd(0)) = kuhnVertex(n, base, upd)(succ(0))(upd(0))
proof
  have updFunction := Injective.function with (Bijective.injective with updBijective)
  have jIn := FunctionBetween.apply_closed with updFunction, positive
  have zeroLess := Less.of_membership with positive
  have oneLess : succ(0) < succ(n) by arith
  have oneIn := membership.of_Less with oneLess
  have parts := difference.singleton_membership.forward with hx
  obtain ⟨inSpace, k, hk, shape⟩ := kuhnSimplex.membership.forward with parts.left
  have kNat := natural.member at succ(n) with hk
  have zeroInK : 0 ∈ k
    have split := natural.zero_or_successor with kNat
    cases split with zero | successor
    . exfalso
      apply parts.right
      rw [shape, zero]
      rfl
    . obtain ⟨m, mNat, kEq⟩ := successor
      rw kEq
      have less : 0 < succ(m) by arith
      exact membership.of_Less with less
  have raisedK : upd(0) ∈ raised(n, upd, k)
    apply raised.membership.backward
    constructor
    . exact jIn
    . witness 0
      constructor
      . exact zeroInK
      . rfl
  have raisedOne : upd(0) ∈ raised(n, upd, succ(0))
    apply raised.membership.backward
    constructor
    . exact jIn
    . witness 0
      constructor
      . exact bootstrap.succ.self at 0
      . rfl
  have valueK := kuhnVertex.coordinate at n, base, upd, k, upd(0) with baseFunction, hk, jIn
  have valueOne := kuhnVertex.coordinate at n, base, upd, succ(0), upd(0) with baseFunction, oneIn, jIn
  have oneK := indicator.member with raisedK
  have oneOne := indicator.member with raisedOne
  rw [shape, valueK, valueOne, oneK, oneOne]
  rfl

-- If every vertex but the k-th shares a coordinate value, the k-th vertex is
-- the bottom or the top.
theorem kuhnSimplex.constant_face_index (n : Nat) (base upd k j v : Set)
  requires baseFunction : base : n → ℕ
  requires updBijective : BijectiveBetween(upd, n, n)
  requires hk : k ∈ succ(n)
  requires hj : j ∈ n
  requires constant : ∀ m ∈ succ(n), m ≠ k → kuhnVertex(n, base, upd)(m)(j) = v
  shows k = 0 ∨ k = n
proof
  by_contra neither
  have notZero : 0 ≠ k
    intro same
    apply neither
    left
    symm
    exact same
  have notTop : n ≠ k
    intro same
    apply neither
    right
    symm
    exact same
  have zeroLess : 0 < succ(n) by arith
  have zeroIn := membership.of_Less with zeroLess
  have nIn := bootstrap.succ.self at n
  have atZero := constant with zeroIn, notZero
  have atTop := constant with nIn, notTop
  have zeroValue := kuhnVertex.zero_coordinate at n, base, upd, j with baseFunction, hj
  have topValue := kuhnVertex.top_coordinate with baseFunction, updBijective, hj
  rw zeroValue at atZero
  rw topValue at atTop
  have baseNatural := FunctionBetween.apply_closed with baseFunction, hj
  rw ← atZero at atTop
  arith

-- Through the face opposite the bottom vertex there are exactly the original
-- simplex and its rotation.
theorem kuhnSimplex.bottom_face_neighbours (n : Nat) (base upd b2 u2 c : Set)
  requires baseFunction : base : n → ℕ
  requires updBijective : BijectiveBetween(upd, n, n)
  requires f2 : b2 : n → ℕ
  requires bij2 : BijectiveBetween(u2, n, n)
  requires positive : 0 ∈ n
  requires hc : c ∈ kuhnSimplex(n, b2, u2)
  requires same : kuhnSimplex(n, b2, u2) ∖ {c} = kuhnSimplex(n, base, upd) ∖ {kuhnVertex(n, base, upd)(0)}
  shows kuhnSimplex(n, b2, u2) = kuhnSimplex(n, base, upd) ∨
    kuhnSimplex(n, b2, u2) = kuhnSimplex(n, kuhnVertex(n, base, upd)(succ(0)), rotated(n, upd))
proof
  have updFunction := Injective.function with (Bijective.injective with updBijective)
  have injective2 := Bijective.injective with bij2
  have jIn := FunctionBetween.apply_closed with updFunction, positive
  have zeroLess := Less.of_membership with positive
  have oneLess : succ(0) < succ(n) by arith
  have oneIn := membership.of_Less with oneLess
  have oneFunction := kuhnVertex.function_on at n, base, upd, succ(0) with baseFunction, oneIn
  have rotatedBijective := rotated.bijective with updBijective
  obtain ⟨inSpace, k, hk, shape⟩ := kuhnSimplex.membership.forward with hc
  have constant : ∀ m ∈ succ(n), m ≠ k → kuhnVertex(n, b2, u2)(m)(upd(0)) = kuhnVertex(n, base, upd)(succ(0))(upd(0))
    intros m hm different
    have vertexMember := kuhnVertex.member at n, b2, u2, m with f2, hm
    have inFace : kuhnVertex(n, b2, u2)(m) ∈ kuhnSimplex(n, b2, u2) ∖ {c}
      apply difference.singleton_membership.backward
      constructor
      . exact vertexMember
      . intro equal
        rw shape at equal
        have index := kuhnVertex.injective with f2, injective2, hm, hk, equal
        exact different with index
    rw same at inFace
    exact kuhnSimplex.bottom_face_constant with baseFunction, updBijective, positive, inFace
  have index := kuhnSimplex.constant_face_index with f2, bij2, hk, jIn, constant
  cases index with zero | top
  . left
    rw [shape, zero] at same
    exact kuhnSimplex.eq_bottom with f2, bij2, baseFunction, updBijective, positive, same
  . right
    rw [shape, top] at same
    have face := kuhnSimplex.rotated_face with baseFunction, updBijective, positive
    rw face at same
    exact kuhnSimplex.eq_top with f2, bij2, oneFunction, rotatedBijective, positive, same

theorem kuhnSimplex.rotated_ne (n : Nat) (base upd : Set)
  requires baseFunction : base : n → ℕ
  requires updBijective : BijectiveBetween(upd, n, n)
  requires positive : 0 ∈ n
  shows kuhnSimplex(n, kuhnVertex(n, base, upd)(succ(0)), rotated(n, upd)) ≠ kuhnSimplex(n, base, upd)
proof
  have updInjective := Bijective.injective with updBijective
  have rotatedInjective := Bijective.injective with (rotated.bijective with updBijective)
  have zeroLess := Less.of_membership with positive
  have oneLess : succ(0) < succ(n) by arith
  have oneIn := membership.of_Less with oneLess
  have oneFunction := kuhnVertex.function_on at n, base, upd, succ(0) with baseFunction, oneIn
  have nIn := bootstrap.succ.self at n
  intro equal
  have topMember := kuhnVertex.member at n, kuhnVertex(n, base, upd)(succ(0)), rotated(n, upd), n with oneFunction, nIn
  rw equal at topMember
  have bounds := kuhnSimplex.sum_bounds with baseFunction, updInjective, topMember
  have topSum := kuhnVertex.sum with oneFunction, rotatedInjective, nIn
  have oneSum := kuhnVertex.sum with baseFunction, updInjective, oneIn
  have upper := bounds.right
  rw [topSum, oneSum] at upper
  have baseWeights : ∀ j ∈ n, base(j) ∈ ℕ
    intros j hj
    exact FunctionBetween.apply_closed with baseFunction, hj
  have baseSum := natSum.natural with (Finite.natural at n), baseWeights
  arith
