module Grace.Cumulus.FixedPoint.CubeAssembly
import CubeMask
import Real.FiniteSum

-- Sums of the first m selected coordinates, as cube functions.
defgraph prefixSumCube (n S m : Set) (x ∈ unitCube(n)) : ℝ := realPartialSum(maskedPoint(n, S, x), m)
requires nNat : Nat(n)
requires mNat : Nat(m)
proof
  have xFunction := unitCube.point with member
  have sequence := maskedPoint.sequence at n, S, x with xFunction
  exact realPartialSum.real at maskedPoint(n, S, x), m with sequence

theorem prefixSumCube.continuous (n : Nat) (S : Set) (m : Nat)
  shows m ∈ succ(n) → CubeFunctionContinuous(prefixSumCube(n, S, m), n)
proof
  induction m
  | zero =>
    intro hm
    have zeroIn : (0:R) ∈ ℝ by typecheck
    have constant := constantCube.continuous at n, (0:R) with zeroIn
    have function : CubeFunction(prefixSumCube(n, S, 0), n)
      exact prefixSumCube.function at n, S, 0 with *
    apply CubeFunctionContinuous.congr with function, constant
    intros x hx
    have value := prefixSumCube.value at n, S, 0, x with *
    have constantValue := constantFunction.apply at unitCube(n), ℝ, x, (0:R) with hx, zeroIn
    rw [value, constantValue]
    exact realPartialSum.zero at maskedPoint(n, S, x)
  | succ(j) using ih =>
    intro hm
    have jNat : Nat(j) by typecheck
    have jIn : j ∈ succ(n)
      have less := Less.of_membership with hm
      have below : j < succ(n) by arith
      exact membership.of_Less with below
    have jInN : j ∈ n
      have less := Less.of_membership with hm
      have below : j < n by arith
      exact membership.of_Less with below
    have previous := ih with jIn
    have weightNat := indicator.natural at S, j
    have weightReal := realNat.real at indicator(S, j)
    have weightIn : (realNat(indicator(S, j)):R) ∈ ℝ by typecheck
    have constant := constantCube.continuous at n, (realNat(indicator(S, j)):R) with weightIn
    have coordinate := coordinateCube.continuous at n, j with jInN
    have term := mulCube.continuous with constant, coordinate
    have total := addCube.continuous with previous, term
    have function : CubeFunction(prefixSumCube(n, S, succ(j)), n)
      exact prefixSumCube.function at n, S, succ(j) with *
    apply CubeFunctionContinuous.congr with function, total
    intros x hx
    have xFunction := unitCube.point with hx
    have previousFunction := CubeFunctionContinuous.function with previous
    have termFunction := CubeFunctionContinuous.function with term
    have constantFunction2 := CubeFunctionContinuous.function with constant
    have coordinateFunction := CubeFunctionContinuous.function with coordinate
    have value := prefixSumCube.value at n, S, succ(j), x with *
    have previousValue := prefixSumCube.value at n, S, j, x with *
    have sumValue := addCube.value at n, prefixSumCube(n, S, j), mulCube(n, constantFunction(unitCube(n), ℝ, (realNat(indicator(S, j)):R)), coordinateCube(n, j)), x with previousFunction, termFunction, hx
    have termValue := mulCube.value at n, constantFunction(unitCube(n), ℝ, (realNat(indicator(S, j)):R)), coordinateCube(n, j), x with constantFunction2, coordinateFunction, hx
    have constantValue := constantFunction.apply at unitCube(n), ℝ, x, (realNat(indicator(S, j)):R) with hx, weightIn
    have coordinateValue := coordinateCube.value at n, j, x with jInN, hx
    have step := realPartialSum.succ at maskedPoint(n, S, x), j
    have masked := maskedPoint.coordinate at n, S, x, j with xFunction, jInN
    have sequence := maskedPoint.sequence at n, S, x with xFunction
    have xReal := unitCube.coordinate_real with hx, jInN
    rw [value, sumValue, previousValue, termValue, constantValue, coordinateValue, step, masked]
    linarith

def sumCube (n S : Set) : Set := prefixSumCube(n, S, n)

theorem sumCube.continuous (n : Nat) (S : Set)
  shows CubeFunctionContinuous(sumCube(n, S), n)
proof
  have all := prefixSumCube.continuous at n, S, n
  have same : sumCube(n, S) = prefixSumCube(n, S, n)
    unfold sumCube
    rfl
  rw same
  exact all with (bootstrap.succ.self at n)

theorem sumCube.value (n : Nat) (S x : Set)
  requires hx : x ∈ unitCube(n)
  shows sumCube(n, S)(x) = realPartialSum(maskedPoint(n, S, x), n)
proof
  have same : sumCube(n, S) = prefixSumCube(n, S, n)
    unfold sumCube
    rfl
  rw same
  exact prefixSumCube.value at n, S, n, x with *

-- A map of the cube assembled from one cube function per coordinate.
defgraph assembledPoint (n G x : Set) (i ∈ n) : ℝ := G(i)(x)
requires family : ∀ i ∈ n, CubeFunction(G(i), n)
requires hx : x ∈ unitCube(n)
proof
  exact CubeFunction.value with (family with member), hx

defgraph assembledMap (n G : Set) (x ∈ unitCube(n)) : unitCube(n) := assembledPoint(n, G, x)
requires family : ∀ i ∈ n, CubeFunction(G(i), n)
requires bounds : ∀ i ∈ n, ∀ x ∈ unitCube(n), (0:R) ≤ (G(i)(x):R) ∧ (G(i)(x):R) ≤ (1:R)
proof
  have function := assembledPoint.function with family, member
  apply unitCube.membership.backward
  constructor
  . exact functionSpace.membership.backward with function
  . intros i hi
    have value := assembledPoint.value with family, member, hi
    have forI := bounds with hi
    obtain ⟨lower, upper⟩ := forI with member
    apply closedInterval.membership.backward
    rw value
    constructor
    . exact CubeFunction.value with (family with hi), member
    . exact ⟨lower, upper⟩

theorem assembledMap.coordinate (n : Nat) (G x i : Set)
  requires family : ∀ i ∈ n, CubeFunction(G(i), n)
  requires bounds : ∀ i ∈ n, ∀ x ∈ unitCube(n), (0:R) ≤ (G(i)(x):R) ∧ (G(i)(x):R) ≤ (1:R)
  requires hx : x ∈ unitCube(n)
  requires hi : i ∈ n
  shows assembledMap(n, G)(x)(i) = G(i)(x)
proof
  have value := assembledMap.value with family, bounds, hx
  have point := assembledPoint.value with family, hx, hi
  rw [value, point]
  rfl

-- Finitely many coordinate functions have a common tolerance at a point.
theorem assembledMap.common_tolerance (n : Nat) (G x : Set) (E : Real) (m : Nat)
  requires family : ∀ i ∈ n, CubeFunctionContinuous(G(i), n)
  requires hx : x ∈ unitCube(n)
  requires positive : 0 < E
  shows m ∈ succ(n) → ∃ D ∈ ℝ, (0:R) < D ∧ (∀ y ∈ unitCube(n), ((∀ j ∈ n, dist(y(j), x(j)) < D) → (∀ i ∈ m, dist(G(i)(y), G(i)(x)) < E)))
proof
  induction m
  | zero =>
    intro hm
    have oneIn : (1:R) ∈ ℝ by typecheck
    have onePos : (0:R) < (1:R) by linarith
    witness (1:R)
    constructor
    . exact oneIn
    . constructor
      . exact onePos
      . intros y hy near i hi
        exfalso
        rw nat.zero at hi
        simpa using hi
  | succ(j) using ih =>
    intro hm
    have jNat : Nat(j) by typecheck
    have jIn : j ∈ succ(n)
      have less := Less.of_membership with hm
      have below : j < succ(n) by arith
      exact membership.of_Less with below
    have jInN : j ∈ n
      have less := Less.of_membership with hm
      have below : j < n by arith
      exact membership.of_Less with below
    obtain ⟨D1, D1Real, D1Pos, previous⟩ := ih with jIn
    have jAt := CubeFunctionContinuous.at with (family with jInN), hx
    have EReal : E ∈ ℝ by typecheck
    obtain ⟨D2, D2Real, D2Pos, close⟩ := jAt with EReal, positive
    obtain ⟨D, DReal, DPos, DBelow1, DBelow2⟩ := positive.below_both with D1Pos, D2Pos
    have shrunk := CubeFunctionContinuousAt.shrink at G(j), n, x, E, D2, D with hx, close, (realLess.implies_le with DBelow2)
    witness D
    constructor
    . exact DReal
    . constructor
      . exact DPos
      . intros y hy near i hi
        have nearD1 : ∀ k ∈ n, dist(y(k), x(k)) < D1
          intros k hk
          have step := near with hk
          have yReal := unitCube.coordinate_real with hy, hk
          have xReal := unitCube.coordinate_real with hx, hk
          have distReal := dist.real at y(k), x(k)
          linarith
        have split := bootstrap.succ.membership.forward with hi
        cases split with below | same
        . have forY := previous with hy, nearD1
          exact forY with below
        . rw same
          exact shrunk with hy, near

theorem assembledMap.continuous (n : Nat) (G : Set)
  requires family : ∀ i ∈ n, CubeFunctionContinuous(G(i), n)
  requires bounds : ∀ i ∈ n, ∀ x ∈ unitCube(n), (0:R) ≤ (G(i)(x):R) ∧ (G(i)(x):R) ≤ (1:R)
  shows CubeContinuous(assembledMap(n, G), n)
proof
  have functions : ∀ i ∈ n, CubeFunction(G(i), n)
    intros i hi
    exact CubeFunctionContinuous.function with (family with hi)
  have function := assembledMap.function with functions, bounds
  constructor
  . exact function
  . intros x hx E EReal Epos
    have all := assembledMap.common_tolerance with family, hx, Epos
    obtain ⟨D, DReal, DPos, close⟩ := all with (bootstrap.succ.self at n)
    witness D
    constructor
    . exact DReal
    . constructor
      . exact DPos
      . intros y hy near i hi
        have yValue := assembledMap.coordinate with functions, bounds, hy, hi
        have xValue := assembledMap.coordinate with functions, bounds, hx, hi
        rw [yValue, xValue]
        have forY := close with hy, near
        exact forY with hi
