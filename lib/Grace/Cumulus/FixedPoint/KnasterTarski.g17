-- The Knaster–Tarski theorem on subsets: a monotone map on the power set
-- of X has a least fixed point, the intersection of its pre-fixed points,
-- and a greatest one, the union of its post-fixed points
-- Part of Cumulus, the Grace17 mathematics library.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module Grace.Cumulus.FixedPoint.KnasterTarski
import Set

predicate MonotoneOnSubsets (F X : Set) :=
  FunctionBetween(F, 𝒫(X), 𝒫(X)) ∧
  (∀ A ∈ 𝒫(X), ∀ B ∈ 𝒫(X), A ⊆ B → F(A) ⊆ F(B))

def prefixedPoints (F X : Set) : Set := { A ∈ 𝒫(X) | F(A) ⊆ A }
def postfixedPoints (F X : Set) : Set := { A ∈ 𝒫(X) | A ⊆ F(A) }
def leastFixedPoint (F X : Set) : Set := ⋂(prefixedPoints(F, X))
def greatestFixedPoint (F X : Set) : Set := ⋃(postfixedPoints(F, X))

theorem prefixedPoints.membership (A F X : Set)
  shows A ∈ prefixedPoints(F, X) ↔ A ∈ 𝒫(X) ∧ F(A) ⊆ A
proof
  simp [prefixedPoints]

theorem postfixedPoints.membership (A F X : Set)
  shows A ∈ postfixedPoints(F, X) ↔ A ∈ 𝒫(X) ∧ A ⊆ F(A)
proof
  simp [postfixedPoints]

theorem MonotoneOnSubsets.apply_subset (F X A : Set)
  requires monotone : MonotoneOnSubsets(F, X)
  requires hA : A ⊆ X
  shows F(A) ⊆ X
proof
  have member := powerset.membership_iff.backward with hA
  have value := FunctionBetween.apply_closed with monotone.left, member
  exact powerset.membership_iff.forward with value

theorem MonotoneOnSubsets.monotone (F X A B : Set)
  requires monotone : MonotoneOnSubsets(F, X)
  requires hA : A ⊆ X
  requires hB : B ⊆ X
  requires hAB : A ⊆ B
  shows F(A) ⊆ F(B)
proof
  have memberA := powerset.membership_iff.backward with hA
  have memberB := powerset.membership_iff.backward with hB
  exact monotone.right with A, memberA, B, memberB, hAB

theorem prefixedPoints.whole (F X : Set)
  requires monotone : MonotoneOnSubsets(F, X)
  shows X ∈ prefixedPoints(F, X)
proof
  apply prefixedPoints.membership.backward
  refine ⟨(powerset.self at X), ?_⟩
  exact MonotoneOnSubsets.apply_subset with monotone, (Subset.reflexive at X)

theorem leastFixedPoint.subset (F X : Set)
  requires monotone : MonotoneOnSubsets(F, X)
  shows leastFixedPoint(F, X) ⊆ X
proof
  unfold leastFixedPoint
  exact familyIntersection.subset_of_member with (prefixedPoints.whole with monotone)

theorem leastFixedPoint.below (F X A : Set)
  requires hA : A ⊆ X
  requires prefixed : F(A) ⊆ A
  shows leastFixedPoint(F, X) ⊆ A
proof
  have member : A ∈ prefixedPoints(F, X)
    apply prefixedPoints.membership.backward
    exact ⟨(powerset.membership_iff.backward with hA), prefixed⟩
  unfold leastFixedPoint
  exact familyIntersection.subset_of_member with member

theorem leastFixedPoint.prefixed (F X : Set)
  requires monotone : MonotoneOnSubsets(F, X)
  shows F(leastFixedPoint(F, X)) ⊆ leastFixedPoint(F, X)
proof
  have whole := prefixedPoints.whole with monotone
  have inhabited : Nonempty(prefixedPoints(F, X)) := ⟨X, whole⟩
  have inside := leastFixedPoint.subset with monotone
  unfold leastFixedPoint at inside
  unfold leastFixedPoint
  apply familyIntersection.greatest with inhabited
  intros A hA
  have parts := prefixedPoints.membership.forward with hA
  have hAX := powerset.membership_iff.forward with parts.left
  have below := leastFixedPoint.below with hAX, parts.right
  unfold leastFixedPoint at below
  have step := MonotoneOnSubsets.monotone with monotone, inside, hAX, below
  exact Subset.transitive with step, parts.right

theorem leastFixedPoint.fixed (F X : Set)
  requires monotone : MonotoneOnSubsets(F, X)
  shows F(leastFixedPoint(F, X)) = leastFixedPoint(F, X)
proof
  have prefixed := leastFixedPoint.prefixed with monotone
  have inside := leastFixedPoint.subset with monotone
  have imageInside := MonotoneOnSubsets.apply_subset with monotone, inside
  apply Subset.antisymmetric
  . exact prefixed
  . have step := MonotoneOnSubsets.monotone with monotone, imageInside, inside, prefixed
    exact leastFixedPoint.below with imageInside, step

theorem leastFixedPoint.least (F X A : Set)
  requires hA : A ⊆ X
  requires fixed : F(A) = A
  shows leastFixedPoint(F, X) ⊆ A
proof
  have prefixed : F(A) ⊆ A
    rw fixed
    exact Subset.reflexive
  exact leastFixedPoint.below with hA, prefixed

theorem greatestFixedPoint.subset (F X : Set)
  shows greatestFixedPoint(F, X) ⊆ X
proof
  unfold greatestFixedPoint
  apply union.subset
  intros A hA
  have parts := postfixedPoints.membership.forward with hA
  exact powerset.membership_iff.forward with parts.left

theorem greatestFixedPoint.above (F X A : Set)
  requires hA : A ⊆ X
  requires postfixed : A ⊆ F(A)
  shows A ⊆ greatestFixedPoint(F, X)
proof
  have member : A ∈ postfixedPoints(F, X)
    apply postfixedPoints.membership.backward
    exact ⟨(powerset.membership_iff.backward with hA), postfixed⟩
  unfold greatestFixedPoint
  exact union.subset_of_member with member

theorem greatestFixedPoint.postfixed (F X : Set)
  requires monotone : MonotoneOnSubsets(F, X)
  shows greatestFixedPoint(F, X) ⊆ F(greatestFixedPoint(F, X))
proof
  have inside := greatestFixedPoint.subset at F, X
  unfold greatestFixedPoint at inside
  unfold greatestFixedPoint
  apply union.subset
  intros A hA
  have parts := postfixedPoints.membership.forward with hA
  have hAX := powerset.membership_iff.forward with parts.left
  have above := greatestFixedPoint.above with hAX, parts.right
  unfold greatestFixedPoint at above
  have step := MonotoneOnSubsets.monotone with monotone, hAX, inside, above
  exact Subset.transitive with parts.right, step

theorem greatestFixedPoint.fixed (F X : Set)
  requires monotone : MonotoneOnSubsets(F, X)
  shows F(greatestFixedPoint(F, X)) = greatestFixedPoint(F, X)
proof
  have postfixed := greatestFixedPoint.postfixed with monotone
  have inside := greatestFixedPoint.subset at F, X
  have imageInside := MonotoneOnSubsets.apply_subset with monotone, inside
  apply Subset.antisymmetric
  . have step := MonotoneOnSubsets.monotone with monotone, inside, imageInside, postfixed
    exact greatestFixedPoint.above with imageInside, step
  . exact postfixed

theorem greatestFixedPoint.greatest (F X A : Set)
  requires hA : A ⊆ X
  requires fixed : F(A) = A
  shows A ⊆ greatestFixedPoint(F, X)
proof
  have postfixed : A ⊆ F(A)
    rw fixed
    exact Subset.reflexive
  exact greatestFixedPoint.above with hA, postfixed

-- The theorem itself: a monotone map on the subsets of X has a fixed point.
theorem KnasterTarski.theorem (F X : Set)
  requires monotone : MonotoneOnSubsets(F, X)
  shows ∃ A, A ⊆ X ∧ F(A) = A
proof
  witness leastFixedPoint(F, X)
  exact ⟨(leastFixedPoint.subset with monotone), (leastFixedPoint.fixed with monotone)⟩
