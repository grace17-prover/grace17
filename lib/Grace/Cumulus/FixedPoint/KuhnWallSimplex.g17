-- Authors: Grant Passmore

module Grace.Cumulus.FixedPoint.KuhnWallSimplex
import KuhnExtend

def wallPerm (m u : Set) : Set := restrict(rotated(succ(m), u), m)

-- A bijection of succ(m) fixing m restricts to a bijection of m.
theorem Bijective.restrict_fixed (m : Nat) (g : Set)
  requires bijective : BijectiveBetween(g, succ(m), succ(m))
  requires fixed : g(m) = m
  shows BijectiveBetween(restrict(g, m), m, m)
proof
  have injective := Bijective.injective with bijective
  have function := Injective.function with injective
  have mSubset := successor.subset at m
  have mIn := bootstrap.succ.self at m
  have closed : ∀ l ∈ m, g(l) ∈ m
    intros l hl
    have lIn := membership.into_successor with hl
    have valueIn := FunctionBetween.apply_closed with function, lIn
    have split := bootstrap.succ.membership.forward with valueIn
    cases split with below | same
    . exact below
    . exfalso
      rw ← fixed at same
      have equal := Injective.apply_cancel with injective, lIn, mIn, same
      rw equal at hl
      exact membership.irreflexive with hl
  have restricted := restrict.function with function, mSubset, closed
  constructor
  . apply Injective.of_cancel with restricted
    intros x hx y hy same
    have xValue := restrict.domain_apply with function, mSubset, hx
    have yValue := restrict.domain_apply with function, mSubset, hy
    rw [xValue, yValue] at same
    have xIn := membership.into_successor with hx
    have yIn := membership.into_successor with hy
    exact Injective.apply_cancel with injective, xIn, yIn, same
  . constructor
    . exact restricted
    . intros y hy
      obtain ⟨fn, law⟩ := Bijective.surjective with bijective
      have yIn := membership.into_successor with hy
      obtain ⟨l, hl, edge⟩ := law with yIn
      have value := FunctionBetween.apply_value with function, hl, edge
      have lBelow : l ∈ m
        have split := bootstrap.succ.membership.forward with hl
        cases split with below | same
        . exact below
        . exfalso
          rw [same, fixed] at value
          rw ← value at hy
          exact membership.irreflexive with hy
      witness l
      constructor
      . exact lBelow
      . have restrictedValue := restrict.domain_apply with function, mSubset, lBelow
        have edge2 := FunctionBetween.relates_apply with restricted, lBelow
        rwa [restrictedValue, value] at edge2

theorem wallPerm.bijective (m : Nat) (u : Set)
  requires updBijective : BijectiveBetween(u, succ(m), succ(m))
  requires first : u(0) = m
  shows BijectiveBetween(wallPerm(m, u), m, m)
proof
  have turned := rotated.bijective with updBijective
  have mIn := bootstrap.succ.self at m
  have top : succ(m) = succ(m) by rfl
  have fixed := rotated.wrap with updBijective, mIn, top
  rw first at fixed
  have same : wallPerm(m, u) = restrict(rotated(succ(m), u), m)
    unfold wallPerm
    rfl
  rw same
  exact Bijective.restrict_fixed with turned, fixed

theorem wallPerm.value (m : Nat) (u l : Set)
  requires updBijective : BijectiveBetween(u, succ(m), succ(m))
  requires hl : l ∈ m
  shows wallPerm(m, u)(l) = u(succ(l))
proof
  have turned := rotated.bijective with updBijective
  have turnedFunction := Injective.function with (Bijective.injective with turned)
  have mSubset := successor.subset at m
  have lIn := membership.into_successor with hl
  have lNat := natural.member at m with hl
  have lLess := Less.of_membership with hl
  have sLess : succ(l) < succ(m) by arith
  have sIn := membership.of_Less with sLess
  have same : wallPerm(m, u) = restrict(rotated(succ(m), u), m)
    unfold wallPerm
    rfl
  rw same
  have value := restrict.domain_apply with turnedFunction, mSubset, hl
  rw value
  exact rotated.step with updBijective, lIn, sIn

-- Below the far wall, the raised coordinates of the restricted simplex are
-- those of the original one step up.
theorem raised.wall_iff (m : Nat) (u k j : Set)
  requires updBijective : BijectiveBetween(u, succ(m), succ(m))
  requires first : u(0) = m
  requires hk : k ∈ succ(m)
  requires hj : j ∈ m
  shows j ∈ raised(m, wallPerm(m, u), k) ↔ j ∈ raised(succ(m), u, succ(k))
proof
  have kNat := natural.member at succ(m) with hk
  have kLess := Less.of_membership with hk
  have kInside := Ordinal.member_subset with (Ordinal.natural at succ(m)), hk
  have jIn := membership.into_successor with hj
  constructor
  . intro inside
    obtain ⟨inM, l, hl, shape⟩ := raised.membership.forward with inside
    have lIn := kInside with l, hl
    have lBelow : l ∈ m
      have lNat := natural.member at succ(m) with lIn
      have lLess := Less.of_membership with hl
      have less : l < m by arith
      exact membership.of_Less with less
    have value := wallPerm.value with updBijective, lBelow
    apply raised.membership.backward
    constructor
    . exact jIn
    . witness succ(l)
      constructor
      . have lNat := natural.member at m with lBelow
        have lLess := Less.of_membership with hl
        have less : succ(l) < succ(k) by arith
        exact membership.of_Less with less
      . rw [shape, value]
        rfl
  . intro inside
    obtain ⟨inSucc, i, hi, shape⟩ := raised.membership.forward with inside
    have iNat := natural.member at succ(k) with hi
    have iLess := Less.of_membership with hi
    have split := natural.zero_or_successor with iNat
    cases split with zero | successor
    . exfalso
      rw [zero, first] at shape
      rw shape at hj
      exact membership.irreflexive with hj
    . obtain ⟨l, lNat, iEq⟩ := successor
      rw iEq at iLess
      have lLess : l < k by arith
      have lIn := membership.of_Less with lLess
      have lBelow : l < m by arith
      have lInM := membership.of_Less with lBelow
      have value := wallPerm.value with updBijective, lInM
      apply raised.membership.backward
      constructor
      . exact hj
      . witness l
        constructor
        . exact lIn
        . rw [shape, iEq, value]
          rfl

theorem kuhnVertex.wall (m : Nat) (b u k : Set)
  requires baseFunction : b : succ(m) → ℕ
  requires updBijective : BijectiveBetween(u, succ(m), succ(m))
  requires first : u(0) = m
  requires hk : k ∈ succ(m)
  shows restrict(kuhnVertex(succ(m), b, u)(succ(k)), m) = kuhnVertex(m, restrict(b, m), wallPerm(m, u))(k)
proof
  have mSubset := successor.subset at m
  have kNat := natural.member at succ(m) with hk
  have kLess := Less.of_membership with hk
  have sLess : succ(k) < succ(succ(m)) by arith
  have sIn := membership.of_Less with sLess
  have restrictedBase := restrict.domain_function with baseFunction, mSubset
  have vertexFunction := kuhnVertex.function_on at succ(m), b, u, succ(k) with baseFunction, sIn
  have leftFunction := restrict.domain_function with vertexFunction, mSubset
  have rightFunction := kuhnVertex.function_on at m, restrict(b, m), wallPerm(m, u), k with restrictedBase, hk
  apply FunctionBetween.ext with leftFunction, rightFunction
  intros j hj
  have leftValue := restrict.domain_apply with vertexFunction, mSubset, hj
  have jIn := membership.into_successor with hj
  have coordinate := kuhnVertex.coordinate at succ(m), b, u, succ(k), j with baseFunction, sIn, jIn
  have rightValue := kuhnVertex.coordinate at m, restrict(b, m), wallPerm(m, u), k, j with restrictedBase, hk, hj
  have baseValue := restrict.domain_apply with baseFunction, mSubset, hj
  have equivalent := raised.wall_iff with updBijective, first, hk, hj
  have same := indicator.congr with equivalent
  rw [leftValue, coordinate, rightValue, baseValue, same]
  rfl

-- The far-wall face of a simplex, restricted, is the simplex one dimension
-- down with the restricted base and the rotated permutation restricted.
theorem kuhnSimplex.wall_face (m p : Nat) (b u : Set)
  requires baseFunction : b : succ(m) → ℕ
  requires bounds : ∀ j ∈ succ(m), b(j) < p
  requires updBijective : BijectiveBetween(u, succ(m), succ(m))
  requires first : u(0) = m
  shows functionImage(cubeRestrict(m, p), kuhnSimplex(succ(m), b, u) ∖ {kuhnVertex(succ(m), b, u)(0)}, functionSpace(m, succ(p))) =
    kuhnSimplex(m, restrict(b, m), wallPerm(m, u))
proof
  have updInjective := Bijective.injective with updBijective
  have mSubset := successor.subset at m
  have restrictedBase := restrict.domain_function with baseFunction, mSubset
  have zeroLess : 0 < succ(succ(m)) by arith
  have zeroIn := membership.of_Less with zeroLess
  ext y
  constructor
  . intro hy
    obtain ⟨yIn, x, hx, yShape⟩ := functionImage.membership.forward with hy
    have parts := difference.singleton_membership.forward with hx
    obtain ⟨inSpace, i, hi, xShape⟩ := kuhnSimplex.membership.forward with parts.left
    have xInCube : x ∈ functionSpace(succ(m), succ(p))
      rw xShape
      exact kuhnVertex.into_cube with baseFunction, bounds, hi
    have value := cubeRestrict.value with xInCube
    have iNat := natural.member at succ(succ(m)) with hi
    have iLess := Less.of_membership with hi
    have split := natural.zero_or_successor with iNat
    cases split with zero | successor
    . exfalso
      apply parts.right
      rw [xShape, zero]
      rfl
    . obtain ⟨k, kNat, iEq⟩ := successor
      rw iEq at iLess
      have kLess : k < succ(m) by arith
      have kIn := membership.of_Less with kLess
      have agree := kuhnVertex.wall with baseFunction, updBijective, first, kIn
      rw [yShape, value, xShape, iEq, agree]
      exact kuhnVertex.member with restrictedBase, kIn
  . intro hy
    obtain ⟨inSpace, k, hk, yShape⟩ := kuhnSimplex.membership.forward with hy
    have kNat := natural.member at succ(m) with hk
    have kLess := Less.of_membership with hk
    have sLess : succ(k) < succ(succ(m)) by arith
    have sIn := membership.of_Less with sLess
    have agree := kuhnVertex.wall with baseFunction, updBijective, first, hk
    have xInCube := kuhnVertex.into_cube at succ(m), p, b, u, succ(k) with baseFunction, bounds, sIn
    have value := cubeRestrict.value with xInCube
    have restrictedBounds : ∀ j ∈ m, restrict(b, m)(j) < p
      intros j hj
      have baseValue := restrict.domain_apply with baseFunction, mSubset, hj
      rw baseValue
      exact bounds with (membership.into_successor with hj)
    apply functionImage.membership.backward
    constructor
    . rw yShape
      exact kuhnVertex.into_cube with restrictedBase, restrictedBounds, hk
    . witness kuhnVertex(succ(m), b, u)(succ(k))
      constructor
      . apply difference.singleton_membership.backward
        constructor
        . exact kuhnVertex.member with baseFunction, sIn
        . intro equal
          have same := kuhnVertex.injective with baseFunction, updInjective, sIn, zeroIn, equal
          arith
      . rw [yShape, value, agree]
        rfl
