-- Authors: Grant Passmore

module Grace.Cumulus.FixedPoint.KuhnInduction
import KuhnWallCount

theorem successor.zero_member (k : Set)
  requires hk : k ∈ succ(0)
  shows k = 0
proof
  have split := bootstrap.succ.membership.forward with hk
  cases split with below | same
  . exfalso
    have kNat := natural.member at succ(0) with hk
    have less := Less.of_membership with below
    arith
  . exact same

-- In dimension zero the only simplex is the single empty function.
theorem kuhnSimplices.zero_subset (p : Nat) (s : Set)
  requires hs : s ∈ kuhnSimplices(p, 0)
  shows s = {∅}
proof
  have parts := kuhnSimplices.membership.forward with hs
  have inCube := powerset.membership_iff.forward with parts.left
  have cubeEq : functionSpace(0, succ(p)) = {∅}
    rw nat.zero
    exact functionSpace.empty_domain
  rw cubeEq at inCube
  obtain ⟨base, baseFunction, bounds, upd, updBijective, shape⟩ := kuhnSimplices.shape with hs
  have zeroIn := bootstrap.succ.self at 0
  have vertexIn : kuhnVertex(0, base, upd)(0) ∈ s
    rw shape
    exact kuhnVertex.member with baseFunction, zeroIn
  have vertexSingleton := inCube with vertexIn
  have vertexEq := singleton.membership.forward with vertexSingleton
  apply Subset.antisymmetric
  . exact inCube
  . intros x hx
    have xEq := singleton.membership.forward with hx
    rwa [xEq, ← vertexEq]

theorem kuhnSimplices.zero_member (p : Nat)
  shows {∅} ∈ kuhnSimplices(p, 0)
proof
  have emptyFunction := FunctionBetween.empty at ℕ
  have baseFunction : ∅ : 0 → ℕ by rwa nat.zero
  have bounds : ∀ j ∈ 0, apply(∅, j) < p
    intros j hj
    exfalso
    have jNat := natural.member at 0 with hj
    have less := Less.of_membership with hj
    arith
  have updBijective := identity.bijective at 0
  have member := kuhnSimplex.in_family with baseFunction, updBijective, bounds
  have same := kuhnSimplices.zero_subset with member
  rwa same at member

theorem kuhnSimplices.zero (p : Nat)
  shows kuhnSimplices(p, 0) = {{∅}}
proof
  apply Subset.antisymmetric
  . intros s hs
    apply singleton.membership.backward
    exact kuhnSimplices.zero_subset with hs
  . intros s hs
    have same := singleton.membership.forward with hs
    rw same
    exact kuhnSimplices.zero_member

theorem completeSimplices.zero (p : Nat) (lab : Set)
  shows completeSimplices(p, 0, lab) = kuhnSimplices(p, 0)
proof
  apply Subset.antisymmetric
  . intros s hs
    have parts := completeSimplices.membership.forward with hs
    exact parts.left
  . intros s hs
    apply completeSimplices.membership.backward
    constructor
    . exact hs
    . have same := kuhnSimplices.zero_subset with hs
      apply Subset.antisymmetric
      . intros k hk
        have parts := labelImage.membership.forward with hk
        exact parts.left
      . intros k hk
        have kEq := successor.zero_member with hk
        have emptyIn : ∅ ∈ s
          rw same
          apply singleton.membership.backward
          rfl
        have bound := reduced.bound at 0, lab, ∅
        have reducedEq := successor.zero_member with bound
        apply labelImage.membership.backward
        constructor
        . exact hk
        . witness ∅
          constructor
          . exact emptyIn
          . rw [kEq, reducedEq]
            rfl

theorem kuhn.base (p : Nat) (lab : Set)
  shows Odd(cardinality(completeSimplices(p, 0, lab)))
proof
  have complete := completeSimplices.zero at p, lab
  have family := kuhnSimplices.zero at p
  have one := cardinality.singleton at {∅}
  rw [complete, family, one]
  have shape : 1 = succ(add(0, 0)) by compute
  rw shape
  exact Odd.double_successor

-- Kuhn's combinatorial lemma: the number of completely labelled simplices
-- is odd, by induction on the dimension.
theorem kuhn.combinatorial (q n : Nat)
  shows ∀ lab, ∀ L, FunctionBetween(lab, functionSpace(n, succ(succ(q))), L) →
    (∀ x ∈ functionSpace(n, succ(succ(q))), ∀ j ∈ n, x(j) = 0 → lab(x)(j) = 0) →
    (∀ x ∈ functionSpace(n, succ(succ(q))), ∀ j ∈ n, x(j) = succ(q) → lab(x)(j) = 1) →
    Odd(cardinality(completeSimplices(succ(q), n, lab)))
proof
  induction n
  | zero =>
    intros lab L labFunction zeroWall fullWall
    exact kuhn.base at succ(q), lab
  | succ(m) using ih =>
    intros lab L labFunction zeroWall fullWall
    have boundaryEq := boundaryDoors.top_wall at m, succ(q), lab with zeroWall, fullWall
    have count := topWallFaces.count at m, q, lab, L with labFunction, fullWall
    have wallFunction := wallLabels.function at m, succ(q), lab, L with *
    have wallZero := wallLabels.zero_wall at m, succ(q), lab, L with labFunction, zeroWall
    have wallFull := wallLabels.full_wall at m, succ(q), lab, L with labFunction, fullWall
    have lower := ih with wallFunction, wallZero, wallFull
    have zeroLess : 0 < succ(m) by arith
    have positive := membership.of_Less with zeroLess
    apply kuhn.parity at succ(m), succ(q), lab with positive
    rw [boundaryEq, count]
    exact lower

-- Kuhn's lemma: some cell of the grid carries, for every coordinate, two
-- points whose labels there differ.
theorem kuhn.lemma (q n : Nat) (lab L : Set)
  requires labFunction : lab : functionSpace(n, succ(succ(q))) → L
  requires zeroWall : ∀ x ∈ functionSpace(n, succ(succ(q))), ∀ j ∈ n, x(j) = 0 → lab(x)(j) = 0
  requires fullWall : ∀ x ∈ functionSpace(n, succ(succ(q))), ∀ j ∈ n, x(j) = succ(q) → lab(x)(j) = 1
  shows ∃ base ∈ functionSpace(n, ℕ), (∀ j ∈ n, base(j) < succ(q)) ∧
    ∀ i ∈ n, ∃ u ∈ functionSpace(n, succ(succ(q))), ∃ v ∈ functionSpace(n, succ(succ(q))),
      (∀ j ∈ n, base(j) ≤ u(j) ∧ u(j) ≤ base(j) + 1) ∧ (∀ j ∈ n, base(j) ≤ v(j) ∧ v(j) ≤ base(j) + 1) ∧
      lab(u)(i) = 0 ∧ lab(v)(i) ≠ 0
proof
  have all := kuhn.combinatorial at q, n
  have odd := all with labFunction, zeroWall, fullWall
  have inhabited : ∃ s, s ∈ completeSimplices(succ(q), n, lab)
    by_contra none
    have empty : completeSimplices(succ(q), n, lab) = ∅
      apply Subset.antisymmetric
      . intros s hs
        exfalso
        apply none
        witness s
        exact hs
      . intros s hs
        exfalso
        simpa using hs
    rw [empty, ← nat.zero] at odd
    have zero := cardinality.natural at 0
    rw zero at odd
    obtain ⟨k, kIn, shape⟩ := odd
    have kNat := nat.omega.backward with kIn
    have self := bootstrap.succ.self at add(k, k)
    rw [← shape, nat.zero] at self
    simpa using self
  obtain ⟨s, hs⟩ := inhabited
  obtain ⟨sIn, complete⟩ := completeSimplices.membership.forward with hs
  obtain ⟨base, baseFunction, bounds, upd, updBijective, sShape⟩ := kuhnSimplices.shape with sIn
  have sParts := kuhnSimplices.membership.forward with sIn
  have sCube := powerset.membership_iff.forward with sParts.left
  witness base
  constructor
  . exact functionSpace.membership.backward with baseFunction
  . constructor
    . exact bounds
    . intros i hi
      have iNat := natural.member at n with hi
      have iLess := Less.of_membership with hi
      have iIn := membership.into_successor with hi
      have sLess : succ(i) < succ(n) by arith
      have succIn := membership.of_Less with sLess
      have upperIn : succ(i) ∈ labelImage(n, lab, s) by rwa complete
      have lowerIn : i ∈ labelImage(n, lab, s) by rwa complete
      obtain ⟨uBound, u, hu, uShape⟩ := labelImage.membership.forward with upperIn
      obtain ⟨vBound, v, hv, vShape⟩ := labelImage.membership.forward with lowerIn
      have uCube := sCube with u, hu
      have vCube := sCube with v, hv
      have uBetween : ∀ j ∈ n, base(j) ≤ u(j) ∧ u(j) ≤ base(j) + 1
        intros j hj
        rw sShape at hu
        obtain ⟨inSpace, k, hk, uVertex⟩ := kuhnSimplex.membership.forward with hu
        rw uVertex
        exact kuhnVertex.between with baseFunction, hk, hj
      have vBetween : ∀ j ∈ n, base(j) ≤ v(j) ∧ v(j) ≤ base(j) + 1
        intros j hj
        rw sShape at hv
        obtain ⟨inSpace, k, hk, vVertex⟩ := kuhnSimplex.membership.forward with hv
        rw vVertex
        exact kuhnVertex.between with baseFunction, hk, hj
      witness u
      constructor
      . exact uCube
      . witness v
        constructor
        . exact vCube
        . constructor
          . exact uBetween
          . constructor
            . exact vBetween
            . constructor
              . have inReduced : i ∈ reduced(n, lab, u)
                  rw ← uShape
                  exact bootstrap.succ.self
                exact reduced.below with inReduced
              . have stop := reduced.stop at n, lab, v
                rw ← vShape at stop
                cases stop with top | nonzero
                . exfalso
                  rw top at hi
                  exact membership.irreflexive with hi
                . exact nonzero
