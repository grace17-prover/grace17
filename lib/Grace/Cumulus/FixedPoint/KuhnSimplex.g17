-- Kuhn simplices: the cells of the standard triangulation of the cube
-- {0, …, p}ⁿ. A simplex is determined by a base point and an order upd on
-- the coordinates; its vertices step from the base one coordinate at a
-- time in that order.
-- Part of Cumulus, the Grace17 mathematics library.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module Grace.Cumulus.FixedPoint.KuhnSimplex
import Set
import Set.Indicator
import Cardinal.IndicatorSum

-- The i-th vertex raises the coordinates upd(0), …, upd(i − 1) by one.
def raised (n upd i : Set) : Set := functionImage(upd, i, n)

defgraph kuhnPoint (n base upd i : Set) (j ∈ n) : ℕ := base(j) + indicator(raised(n, upd, i), j)
requires baseFunction : base : n → ℕ
proof
  have value := FunctionBetween.apply_closed with baseFunction, assumption
  have valueNat := nat.omega.backward with value
  have tag := indicator.natural at raised(n, upd, i), j
  have sumNat : Nat(base(j) + indicator(raised(n, upd, i), j)) by typecheck
  exact nat.omega.forward with sumNat

defgraph kuhnVertex (n base upd : Set) (i ∈ succ(n)) : functionSpace(n, ℕ) := kuhnPoint(n, base, upd, i)
requires baseFunction : base : n → ℕ
proof
  have function := kuhnPoint.function at n, base, upd, i with baseFunction
  exact functionSpace.membership.backward with function

def kuhnSimplex (n base upd : Set) : Set :=
  functionImage(kuhnVertex(n, base, upd), succ(n), functionSpace(n, ℕ))

predicate KuhnSimplex (p n s : Set) :=
  ∃ base ∈ functionSpace(n, ℕ), (∀ j ∈ n, base(j) < p) ∧
    ∃ upd, BijectiveBetween(upd, n, n) ∧ s = kuhnSimplex(n, base, upd)

theorem raised.membership (j n upd i : Set)
  shows j ∈ raised(n, upd, i) ↔ j ∈ n ∧ ∃ k ∈ i, j = upd(k)
proof
  have same : raised(n, upd, i) = functionImage(upd, i, n)
    unfold raised
    rfl
  rw same
  exact functionImage.membership

theorem kuhnSimplex.membership (x n base upd : Set)
  shows x ∈ kuhnSimplex(n, base, upd) ↔ x ∈ functionSpace(n, ℕ) ∧ ∃ i ∈ succ(n), x = kuhnVertex(n, base, upd)(i)
proof
  have same : kuhnSimplex(n, base, upd) = functionImage(kuhnVertex(n, base, upd), succ(n), functionSpace(n, ℕ))
    unfold kuhnSimplex
    rfl
  rw same
  exact functionImage.membership

theorem kuhnVertex.coordinate (n base upd i j : Set)
  requires baseFunction : base : n → ℕ
  requires hi : i ∈ succ(n)
  requires hj : j ∈ n
  shows kuhnVertex(n, base, upd)(i)(j) = base(j) + indicator(raised(n, upd, i), j)
proof
  have vertex := kuhnVertex.value at n, base, upd, i with baseFunction
  have point := kuhnPoint.value at n, base, upd, i, j with baseFunction
  rw [vertex, point]
  rfl

-- Raised coordinate sets grow one coordinate at a time.
theorem raised.monotone (n upd i k : Set)
  requires hik : i ⊆ k
  shows raised(n, upd, i) ⊆ raised(n, upd, k)
proof
  intros j hj
  obtain ⟨hjn, x, hx, shape⟩ := raised.membership.forward with hj
  exact raised.membership.backward with ⟨hjn, x, (hik with x, hx), shape⟩

theorem raised.succ (n : Nat) (upd i : Set)
  requires updFunction : upd : n → n
  requires hi : i ∈ n
  shows raised(n, upd, succ(i)) = insert(upd(i), raised(n, upd, i))
proof
  have naturals := natural.member at n
  have iNat := naturals with hi
  have value := FunctionBetween.apply_closed with updFunction, hi
  ext j
  constructor
  . intro hj
    obtain ⟨hjn, k, hk, shape⟩ := raised.membership.forward with hj
    have split := bootstrap.succ.membership.forward with hk
    apply insert.membership.backward
    cases split with before | same
    . right
      exact raised.membership.backward with ⟨hjn, k, before, shape⟩
    . left
      rw [shape, same]
      rfl
  . intro hj
    have split := insert.membership.forward with hj
    cases split with same | inRaised
    . rw same
      have self := bootstrap.succ.self at i
      exact raised.membership.backward with ⟨value, i, self, rfl⟩
    . obtain ⟨hjn, k, hk, shape⟩ := raised.membership.forward with inRaised
      have later := membership.into_successor with hk
      exact raised.membership.backward with ⟨hjn, k, later, shape⟩

theorem raised.fresh (n : Nat) (upd i : Set)
  requires injective : InjectiveBetween(upd, n, n)
  requires hi : i ∈ n
  shows ¬upd(i) ∈ raised(n, upd, i)
proof
  intro inside
  obtain ⟨hjn, k, hk, shape⟩ := raised.membership.forward with inside
  have below := Ordinal.member_subset with hi
  have hkn := below with k, hk
  have same := Injective.apply_cancel with injective, hi, hkn, shape
  rw same at hk
  have irreflexive := Ordinal.not_member_self at k
  exact irreflexive with hk

theorem raised.subset (n upd i : Set)
  shows raised(n, upd, i) ⊆ n
proof
  intros j hj
  obtain ⟨hjn, k, hk, shape⟩ := raised.membership.forward with hj
  exact hjn

-- Vertices.
theorem kuhnVertex.member (n base upd i : Set)
  requires baseFunction : base : n → ℕ
  requires hi : i ∈ succ(n)
  shows kuhnVertex(n, base, upd)(i) ∈ kuhnSimplex(n, base, upd)
proof
  have graph := kuhnVertex.function at n, base, upd with baseFunction
  have closed := FunctionBetween.apply_closed with graph, hi
  exact kuhnSimplex.membership.backward with ⟨closed, i, hi, rfl⟩

theorem kuhnVertex.function_on (n base upd i : Set)
  requires baseFunction : base : n → ℕ
  requires hi : i ∈ succ(n)
  shows kuhnVertex(n, base, upd)(i) : n → ℕ
proof
  have graph := kuhnVertex.function at n, base, upd with baseFunction
  have closed := FunctionBetween.apply_closed with graph, hi
  exact functionSpace.membership.forward with closed

theorem kuhnVertex.coordinate_succ (n : Nat) (base upd i j : Set)
  requires baseFunction : base : n → ℕ
  requires updInjective : InjectiveBetween(upd, n, n)
  requires hi : i ∈ n
  requires hj : j ∈ n
  shows kuhnVertex(n, base, upd)(succ(i))(j) = kuhnVertex(n, base, upd)(i)(j) + indicator({upd(i)}, j)
proof
  have updFunction := Injective.function with updInjective
  have naturals := natural.member at n
  have iNat := naturals with hi
  have below := Less.of_membership with hi
  have succBelow : succ(i) < succ(n) by arith
  have succIn := membership.of_Less with succBelow
  have iIn := membership.into_successor with hi
  have first := kuhnVertex.coordinate at n, base, upd, succ(i), j with baseFunction, succIn, hj
  have second := kuhnVertex.coordinate at n, base, upd, i, j with baseFunction, iIn, hj
  have step := raised.succ with updFunction, hi
  have baseValue := FunctionBetween.apply_closed with baseFunction, hj
  have baseNat := nat.omega.backward with baseValue
  rw [first, second, step]
  have split : j = upd(i) ∨ j ≠ upd(i) by tauto
  cases split with same | different
  . have inInsert : j ∈ insert(upd(i), raised(n, upd, i))
      apply insert.membership.backward
      left
      exact same
    have single : j ∈ {upd(i)} := singleton.membership.backward with same
    have fresh := raised.fresh with updInjective, hi
    have absent : ¬j ∈ raised(n, upd, i) by rwa same
    have one := indicator.member with inInsert
    have zero := indicator.absent with absent
    have one2 := indicator.member with single
    rw [one, zero, one2]
    rw add.right_unit
    rfl
  . have equivalent : j ∈ insert(upd(i), raised(n, upd, i)) ↔ j ∈ raised(n, upd, i)
      constructor
      . intro inside
        have split2 := insert.membership.forward with inside
        cases split2 with same | inRaised
        . exfalso
          exact different with same
        . exact inRaised
      . intro inRaised
        apply insert.membership.backward
        right
        exact inRaised
    have different2 : upd(i) ≠ j
      intro same
      apply different
      symm
      exact same
    have congr := indicator.congr with equivalent
    have zero := indicator.singleton_other with different2
    rw [congr, zero]
    rw add.right_unit
    rfl

-- Monotonicity along the vertex chain, and strictness at the raised
-- coordinate.
theorem indicator.monotone (A B j : Set)
  requires hAB : A ⊆ B
  shows indicator(A, j) ≤ indicator(B, j)
proof
  have split : j ∈ A ∨ ¬j ∈ A by tauto
  cases split with inA | outA
  . have inB := hAB with j, inA
    have oneA := indicator.member with inA
    have oneB := indicator.member with inB
    rw [oneA, oneB]
    arith
  . have zero := indicator.absent with outA
    rw zero
    arith

theorem kuhnVertex.monotone (n : Nat) (base upd i k j : Set)
  requires baseFunction : base : n → ℕ
  requires hi : i ∈ succ(n)
  requires hk : k ∈ succ(n)
  requires hik : i ⊆ k
  requires hj : j ∈ n
  shows kuhnVertex(n, base, upd)(i)(j) ≤ kuhnVertex(n, base, upd)(k)(j)
proof
  have first := kuhnVertex.coordinate at n, base, upd, i, j with baseFunction, hi, hj
  have second := kuhnVertex.coordinate at n, base, upd, k, j with baseFunction, hk, hj
  have grown := raised.monotone at n, upd, i, k with hik
  have tags := indicator.monotone at raised(n, upd, i), raised(n, upd, k), j with grown
  have baseValue := FunctionBetween.apply_closed with baseFunction, hj
  have baseNat := nat.omega.backward with baseValue
  rw [first, second]
  arith

theorem kuhnVertex.strict (n : Nat) (base upd i k : Set)
  requires baseFunction : base : n → ℕ
  requires updInjective : InjectiveBetween(upd, n, n)
  requires hi : i ∈ n
  requires hk : k ∈ succ(n)
  requires hik : i ∈ k
  shows kuhnVertex(n, base, upd)(i)(upd(i)) < kuhnVertex(n, base, upd)(k)(upd(i))
proof
  have updFunction := Injective.function with updInjective
  have value := FunctionBetween.apply_closed with updFunction, hi
  have iIn := membership.into_successor with hi
  have first := kuhnVertex.coordinate at n, base, upd, i, upd(i) with baseFunction, iIn, value
  have second := kuhnVertex.coordinate at n, base, upd, k, upd(i) with baseFunction, hk, value
  have fresh := raised.fresh with updInjective, hi
  have inK : upd(i) ∈ raised(n, upd, k) := raised.membership.backward with ⟨value, i, hik, rfl⟩
  have zero := indicator.absent with fresh
  have one := indicator.member with inK
  have baseValue := FunctionBetween.apply_closed with baseFunction, value
  have baseNat := nat.omega.backward with baseValue
  rw [first, second, zero, one]
  arith

theorem kuhnVertex.injective (n : Nat) (base upd i k : Set)
  requires baseFunction : base : n → ℕ
  requires updInjective : InjectiveBetween(upd, n, n)
  requires hi : i ∈ succ(n)
  requires hk : k ∈ succ(n)
  requires equal : kuhnVertex(n, base, upd)(i) = kuhnVertex(n, base, upd)(k)
  shows i = k
proof
  have naturals := natural.member at succ(n)
  have iNat := naturals with hi
  have kNat := naturals with hk
  have order := Ordinal.trichotomy with (Ordinal.natural at i), k, (Ordinal.natural at k)
  cases order with below | rest
  . exfalso
    have iInN : i ∈ n
      have below2 := Less.of_membership with below
      have kBound := Less.of_membership with hk
      have small : i < n by arith
      exact membership.of_Less with small
    have strict := kuhnVertex.strict with baseFunction, updInjective, iInN, hk, below
    rw equal at strict
    have updFunction := Injective.function with updInjective
    have coordinate := FunctionBetween.apply_closed with updFunction, iInN
    have vertexFunction := kuhnVertex.function_on at n, base, upd, k with baseFunction, hk
    have valueIn := FunctionBetween.apply_closed with vertexFunction, coordinate
    have valueNat := nat.omega.backward with valueIn
    exact Less.irreflexive with strict
  . cases rest with same | above
    . exact same
    . exfalso
      have kInN : k ∈ n
        have above2 := Less.of_membership with above
        have iBound := Less.of_membership with hi
        have small : k < n by arith
        exact membership.of_Less with small
      have strict := kuhnVertex.strict with baseFunction, updInjective, kInN, hi, above
      rw equal at strict
      have updFunction := Injective.function with updInjective
      have coordinate := FunctionBetween.apply_closed with updFunction, kInN
      have vertexFunction := kuhnVertex.function_on at n, base, upd, k with baseFunction, hk
      have valueIn := FunctionBetween.apply_closed with vertexFunction, coordinate
      have valueNat := nat.omega.backward with valueIn
      exact Less.irreflexive with strict

theorem kuhnVertex.graph_injective (n : Nat) (base upd : Set)
  requires baseFunction : base : n → ℕ
  requires updInjective : InjectiveBetween(upd, n, n)
  shows InjectiveBetween(kuhnVertex(n, base, upd), succ(n), functionSpace(n, ℕ))
proof
  have graph := kuhnVertex.function at n, base, upd with baseFunction
  constructor
  . exact graph
  . intros i hi k hk z hz hiz hkz
    have valueI := FunctionBetween.apply_value with graph, hi, hiz
    have valueK := FunctionBetween.apply_value with graph, hk, hkz
    have equal : kuhnVertex(n, base, upd)(i) = kuhnVertex(n, base, upd)(k) by cc
    exact kuhnVertex.injective with baseFunction, updInjective, hi, hk, equal

theorem kuhnSimplex.cardinality (n : Nat) (base upd : Set)
  requires baseFunction : base : n → ℕ
  requires updInjective : InjectiveBetween(upd, n, n)
  shows cardinality(kuhnSimplex(n, base, upd)) = succ(n)
proof
  have injective := kuhnVertex.graph_injective with baseFunction, updInjective
  have corestricted := Injective.corestrict with injective
  have surjective := functionImage.surjective with (Injective.function with injective)
  have bijective : BijectiveBetween(kuhnVertex(n, base, upd), succ(n), functionImage(kuhnVertex(n, base, upd), succ(n), functionSpace(n, ℕ))) := ⟨corestricted, surjective⟩
  have same := cardinality.bijective with bijective
  have count := cardinality.natural at succ(n)
  unfold kuhnSimplex
  rw [← same, count]
  rfl

theorem kuhnSimplex.finite (n : Nat) (base upd : Set)
  requires baseFunction : base : n → ℕ
  requires updInjective : InjectiveBetween(upd, n, n)
  shows Finite(kuhnSimplex(n, base, upd))
proof
  have injective := kuhnVertex.graph_injective with baseFunction, updInjective
  have corestricted := Injective.corestrict with injective
  have surjective := functionImage.surjective with (Injective.function with injective)
  have bijective : BijectiveBetween(kuhnVertex(n, base, upd), succ(n), functionImage(kuhnVertex(n, base, upd), succ(n), functionSpace(n, ℕ))) := ⟨corestricted, surjective⟩
  have equipotent : succ(n) ≃ functionImage(kuhnVertex(n, base, upd), succ(n), functionSpace(n, ℕ)) := ⟨kuhnVertex(n, base, upd), bijective⟩
  unfold kuhnSimplex
  exact Finite.of_equipotent with (Finite.natural at succ(n)), equipotent

-- Bounds on the coordinates.
theorem kuhnVertex.between (n : Nat) (base upd i j : Set)
  requires baseFunction : base : n → ℕ
  requires hi : i ∈ succ(n)
  requires hj : j ∈ n
  shows base(j) ≤ kuhnVertex(n, base, upd)(i)(j) ∧ kuhnVertex(n, base, upd)(i)(j) ≤ base(j) + 1
proof
  have value := kuhnVertex.coordinate at n, base, upd, i, j with baseFunction, hi, hj
  have baseValue := FunctionBetween.apply_closed with baseFunction, hj
  have baseNat := nat.omega.backward with baseValue
  rw value
  have split : j ∈ raised(n, upd, i) ∨ ¬j ∈ raised(n, upd, i) by tauto
  cases split with inside | outside
  . have one := indicator.member with inside
    rw one
    constructor
    . arith
    . arith
  . have zero := indicator.absent with outside
    rw zero
    constructor
    . arith
    . arith

theorem kuhnVertex.bounded (n : Nat) (base upd i j p : Set)
  requires baseFunction : base : n → ℕ
  requires pNat : Nat(p)
  requires below : base(j) < p
  requires hi : i ∈ succ(n)
  requires hj : j ∈ n
  shows kuhnVertex(n, base, upd)(i)(j) ≤ p
proof
  have bounds := kuhnVertex.between at n, base, upd, i, j with baseFunction, hi, hj
  have baseValue := FunctionBetween.apply_closed with baseFunction, hj
  have baseNat := nat.omega.backward with baseValue
  have upper := bounds.right
  have vertexFunction := kuhnVertex.function_on at n, base, upd, i with baseFunction, hi
  have valueIn := FunctionBetween.apply_closed with vertexFunction, hj
  have valueNat := nat.omega.backward with valueIn
  arith

-- The first vertex is the base; the last raises every coordinate.
theorem raised.zero (n upd : Set)
  shows raised(n, upd, 0) = ∅
proof
  have same : raised(n, upd, 0) = functionImage(upd, 0, n)
    unfold raised
    rfl
  rw [same, nat.zero]
  exact functionImage.empty

theorem raised.full (n upd : Set)
  requires bijective : BijectiveBetween(upd, n, n)
  shows raised(n, upd, n) = n
proof
  have function := Injective.function with (Bijective.injective with bijective)
  have surjective := Bijective.surjective with bijective
  apply Subset.antisymmetric
  . exact raised.subset at n, upd, n
  . intros j hj
    obtain ⟨k, hk, related⟩ := surjective.right with j, hj
    have value := FunctionBetween.apply_value with function, hk, related
    apply raised.membership.backward
    refine ⟨hj, k, hk, ?_⟩
    symm
    exact value

theorem kuhnVertex.zero_coordinate (n : Nat) (base upd j : Set)
  requires baseFunction : base : n → ℕ
  requires hj : j ∈ n
  shows kuhnVertex(n, base, upd)(0)(j) = base(j)
proof
  have zeroNat : Nat(0) by typecheck
  have positive : 0 < succ(n) by arith
  have zeroIn := membership.of_Less with positive
  have value := kuhnVertex.coordinate at n, base, upd, 0, j with baseFunction, zeroIn, hj
  have absent : ¬j ∈ ∅
    intro inside
    exact empty.membership with j, inside
  have zero := indicator.absent with absent
  have baseValue := FunctionBetween.apply_closed with baseFunction, hj
  have baseNat := nat.omega.backward with baseValue
  rw [value, raised.zero, zero, add.right_unit]
  rfl

theorem kuhnVertex.top_coordinate (n : Nat) (base upd j : Set)
  requires baseFunction : base : n → ℕ
  requires bijective : BijectiveBetween(upd, n, n)
  requires hj : j ∈ n
  shows kuhnVertex(n, base, upd)(n)(j) = base(j) + 1
proof
  have nIn := bootstrap.succ.self at n
  have value := kuhnVertex.coordinate at n, base, upd, n, j with baseFunction, nIn, hj
  have full := raised.full with bijective
  have one := indicator.member with hj
  rw [value, full, one]
  rfl

-- Any two vertices are comparable coordinatewise.
theorem kuhnVertex.comparable (n : Nat) (base upd i k j : Set)
  requires baseFunction : base : n → ℕ
  requires hi : i ∈ succ(n)
  requires hk : k ∈ succ(n)
  requires hj : j ∈ n
  shows kuhnVertex(n, base, upd)(i)(j) ≤ kuhnVertex(n, base, upd)(k)(j) ∨
    kuhnVertex(n, base, upd)(k)(j) ≤ kuhnVertex(n, base, upd)(i)(j)
proof
  have naturals := natural.member at succ(n)
  have iNat := naturals with hi
  have kNat := naturals with hk
  have order := Ordinal.trichotomy with (Ordinal.natural at i), k, (Ordinal.natural at k)
  cases order with below | rest
  . left
    have hik := Ordinal.member_subset with (Ordinal.natural at k), below
    exact kuhnVertex.monotone with baseFunction, hi, hk, hik, hj
  . cases rest with same | above
    . left
      rw same
      have vertexFunction := kuhnVertex.function_on at n, base, upd, k with baseFunction, hk
      have valueIn := FunctionBetween.apply_closed with vertexFunction, hj
      have valueNat := nat.omega.backward with valueIn
      arith
    . right
      have hki := Ordinal.member_subset with (Ordinal.natural at i), above
      exact kuhnVertex.monotone with baseFunction, hk, hi, hki, hj

-- Vertices agree once their coordinates do.
theorem kuhnVertex.ext (n : Nat) (base upd i k : Set)
  requires baseFunction : base : n → ℕ
  requires hi : i ∈ succ(n)
  requires hk : k ∈ succ(n)
  requires same : ∀ j ∈ n, kuhnVertex(n, base, upd)(i)(j) = kuhnVertex(n, base, upd)(k)(j)
  shows kuhnVertex(n, base, upd)(i) = kuhnVertex(n, base, upd)(k)
proof
  have fi := kuhnVertex.function_on at n, base, upd, i with baseFunction, hi
  have fk := kuhnVertex.function_on at n, base, upd, k with baseFunction, hk
  exact FunctionBetween.ext with fi, fk, same

theorem kuhnVertex.index_subset (n : Nat) (i : Set)
  requires hi : i ∈ succ(n)
  shows i ⊆ n
proof
  have split := bootstrap.succ.membership.forward with hi
  cases split with below | same
  . exact Ordinal.member_subset with (Ordinal.natural at n), below
  . rw same
    exact Subset.reflexive

-- The last vertex lies above every vertex; the first lies below.
theorem kuhnVertex.top_of_face (n : Nat) (base upd x j : Set)
  requires baseFunction : base : n → ℕ
  requires hx : x ∈ kuhnSimplex(n, base, upd)
  requires hj : j ∈ n
  shows x(j) ≤ kuhnVertex(n, base, upd)(n)(j)
proof
  obtain ⟨inSpace, i, hi, shape⟩ := kuhnSimplex.membership.forward with hx
  have hin := kuhnVertex.index_subset with hi
  have nIn := bootstrap.succ.self at n
  rw shape
  exact kuhnVertex.monotone with baseFunction, hi, nIn, hin, hj

theorem kuhnVertex.bottom_of_face (n : Nat) (base upd x j : Set)
  requires baseFunction : base : n → ℕ
  requires hx : x ∈ kuhnSimplex(n, base, upd)
  requires hj : j ∈ n
  shows kuhnVertex(n, base, upd)(0)(j) ≤ x(j)
proof
  obtain ⟨inSpace, i, hi, shape⟩ := kuhnSimplex.membership.forward with hx
  have positive : 0 < succ(n) by arith
  have zeroIn := membership.of_Less with positive
  have zeroSub : 0 ⊆ i
    rw nat.zero
    exact empty.subset
  rw shape
  exact kuhnVertex.monotone with baseFunction, zeroIn, hi, zeroSub, hj

theorem kuhnVertex.top_ne_bottom (n : Nat) (base upd : Set)
  requires baseFunction : base : n → ℕ
  requires updInjective : InjectiveBetween(upd, n, n)
  requires positive : 0 ∈ n
  shows kuhnVertex(n, base, upd)(n) ≠ kuhnVertex(n, base, upd)(0)
proof
  intro equal
  have zeroIn := membership.into_successor with positive
  have nIn := bootstrap.succ.self at n
  have same := kuhnVertex.injective with baseFunction, updInjective, nIn, zeroIn, equal
  rw same at positive
  have irreflexive := Ordinal.not_member_self at 0
  exact irreflexive with positive

-- A face determines the missing vertex: below the bottom vertex the face's
-- maximum is the top vertex, and above the top vertex its minimum is the
-- bottom vertex.
theorem kuhnSimplex.top_of_bottom_face (n : Nat) (base upd M : Set)
  requires baseFunction : base : n → ℕ
  requires updInjective : InjectiveBetween(upd, n, n)
  requires positive : 0 ∈ n
  requires hM : M ∈ kuhnSimplex(n, base, upd) ∖ {kuhnVertex(n, base, upd)(0)}
  requires maximal : ∀ x ∈ kuhnSimplex(n, base, upd) ∖ {kuhnVertex(n, base, upd)(0)}, ∀ j ∈ n, x(j) ≤ M(j)
  shows M = kuhnVertex(n, base, upd)(n)
proof
  have nIn := bootstrap.succ.self at n
  have topMember := kuhnVertex.member at n, base, upd, n with baseFunction, nIn
  have topDifferent := kuhnVertex.top_ne_bottom with baseFunction, updInjective, positive
  have topInFace : kuhnVertex(n, base, upd)(n) ∈ kuhnSimplex(n, base, upd) ∖ {kuhnVertex(n, base, upd)(0)}
    exact difference.singleton_membership.backward with ⟨topMember, topDifferent⟩
  have parts := difference.singleton_membership.forward with hM
  obtain ⟨inSpace, i, hi, shape⟩ := kuhnSimplex.membership.forward with parts.left
  have below := maximal with kuhnVertex(n, base, upd)(n), topInFace
  rw shape
  apply kuhnVertex.ext with baseFunction, hi, nIn
  intros j hj
  have above := kuhnVertex.top_of_face with baseFunction, parts.left, hj
  have belowJ := below with hj
  rw shape at above
  rw shape at belowJ
  have vi := kuhnVertex.function_on at n, base, upd, i with baseFunction, hi
  have vn := kuhnVertex.function_on at n, base, upd, n with baseFunction, nIn
  have valueI := nat.omega.backward with (FunctionBetween.apply_closed with vi, hj)
  have valueN := nat.omega.backward with (FunctionBetween.apply_closed with vn, hj)
  exact LessEqual.antisymmetric with above, belowJ

theorem kuhnSimplex.bottom_of_top_face (n : Nat) (base upd M : Set)
  requires baseFunction : base : n → ℕ
  requires updInjective : InjectiveBetween(upd, n, n)
  requires positive : 0 ∈ n
  requires hM : M ∈ kuhnSimplex(n, base, upd) ∖ {kuhnVertex(n, base, upd)(n)}
  requires minimal : ∀ x ∈ kuhnSimplex(n, base, upd) ∖ {kuhnVertex(n, base, upd)(n)}, ∀ j ∈ n, M(j) ≤ x(j)
  shows M = kuhnVertex(n, base, upd)(0)
proof
  have zeroNat : Nat(0) by typecheck
  have zeroIn := membership.into_successor with positive
  have nIn := bootstrap.succ.self at n
  have bottomMember := kuhnVertex.member at n, base, upd, 0 with baseFunction, zeroIn
  have topDifferent := kuhnVertex.top_ne_bottom with baseFunction, updInjective, positive
  have bottomDifferent : kuhnVertex(n, base, upd)(0) ≠ kuhnVertex(n, base, upd)(n)
    intro equal
    apply topDifferent
    symm
    exact equal
  have bottomInFace : kuhnVertex(n, base, upd)(0) ∈ kuhnSimplex(n, base, upd) ∖ {kuhnVertex(n, base, upd)(n)}
    exact difference.singleton_membership.backward with ⟨bottomMember, bottomDifferent⟩
  have parts := difference.singleton_membership.forward with hM
  obtain ⟨inSpace, i, hi, shape⟩ := kuhnSimplex.membership.forward with parts.left
  have above := minimal with kuhnVertex(n, base, upd)(0), bottomInFace
  rw shape
  apply kuhnVertex.ext with baseFunction, hi, zeroIn
  intros j hj
  have below := kuhnVertex.bottom_of_face with baseFunction, parts.left, hj
  have aboveJ := above with hj
  rw shape at below
  rw shape at aboveJ
  have vi := kuhnVertex.function_on at n, base, upd, i with baseFunction, hi
  have v0 := kuhnVertex.function_on at n, base, upd, 0 with baseFunction, zeroIn
  have valueI := nat.omega.backward with (FunctionBetween.apply_closed with vi, hj)
  have value0 := nat.omega.backward with (FunctionBetween.apply_closed with v0, hj)
  exact LessEqual.antisymmetric with aboveJ, below

-- Two simplices sharing the face below their bottom vertices coincide.
theorem kuhnSimplex.eq_bottom (n : Nat) (b1 u1 b2 u2 : Set)
  requires f1 : b1 : n → ℕ
  requires bij1 : BijectiveBetween(u1, n, n)
  requires f2 : b2 : n → ℕ
  requires bij2 : BijectiveBetween(u2, n, n)
  requires positive : 0 ∈ n
  requires same : kuhnSimplex(n, b1, u1) ∖ {kuhnVertex(n, b1, u1)(0)} = kuhnSimplex(n, b2, u2) ∖ {kuhnVertex(n, b2, u2)(0)}
  shows kuhnSimplex(n, b1, u1) = kuhnSimplex(n, b2, u2)
proof
  have inj1 := Bijective.injective with bij1
  have inj2 := Bijective.injective with bij2
  have zeroNat : Nat(0) by typecheck
  have zeroIn := membership.into_successor with positive
  have nIn := bootstrap.succ.self at n
  have top1Member := kuhnVertex.member at n, b1, u1, n with f1, nIn
  have top1Different := kuhnVertex.top_ne_bottom with f1, inj1, positive
  have top1InFace : kuhnVertex(n, b1, u1)(n) ∈ kuhnSimplex(n, b1, u1) ∖ {kuhnVertex(n, b1, u1)(0)}
    exact difference.singleton_membership.backward with ⟨top1Member, top1Different⟩
  have maximal1 : ∀ x ∈ kuhnSimplex(n, b1, u1) ∖ {kuhnVertex(n, b1, u1)(0)}, ∀ j ∈ n, x(j) ≤ kuhnVertex(n, b1, u1)(n)(j)
    intros x hx j hj
    have parts := difference.singleton_membership.forward with hx
    exact kuhnVertex.top_of_face with f1, parts.left, hj
  rw same at top1InFace
  rw under same at maximal1
  have topsEqual := kuhnSimplex.top_of_bottom_face with f2, inj2, positive, top1InFace, maximal1
  have basesEqual : b1 = b2
    apply FunctionBetween.ext with f1, f2
    intros j hj
    have t1 := kuhnVertex.top_coordinate with f1, bij1, hj
    have t2 := kuhnVertex.top_coordinate with f2, bij2, hj
    rw topsEqual at t1
    have equal : b1(j) + 1 = b2(j) + 1 by cc
    have v1 := nat.omega.backward with (FunctionBetween.apply_closed with f1, hj)
    have v2 := nat.omega.backward with (FunctionBetween.apply_closed with f2, hj)
    have oneNat : Nat(1) by typecheck
    exact add.right_cancel with equal
  have bottomsEqual : kuhnVertex(n, b1, u1)(0) = kuhnVertex(n, b2, u2)(0)
    have g1 := kuhnVertex.function_on at n, b1, u1, 0 with f1, zeroIn
    have g2 := kuhnVertex.function_on at n, b2, u2, 0 with f2, zeroIn
    apply FunctionBetween.ext with g1, g2
    intros j hj
    have z1 := kuhnVertex.zero_coordinate at n, b1, u1, j with f1, hj
    have z2 := kuhnVertex.zero_coordinate at n, b2, u2, j with f2, hj
    rw [z1, z2, basesEqual]
    rfl
  have bottom1Member := kuhnVertex.member at n, b1, u1, 0 with f1, zeroIn
  have bottom2Member := kuhnVertex.member at n, b2, u2, 0 with f2, zeroIn
  have restore1 := insert.restore with bottom1Member
  have restore2 := insert.restore with bottom2Member
  rwa [← restore1, same, bottomsEqual]

-- Two simplices sharing the face above their top vertices coincide.
theorem kuhnSimplex.eq_top (n : Nat) (b1 u1 b2 u2 : Set)
  requires f1 : b1 : n → ℕ
  requires bij1 : BijectiveBetween(u1, n, n)
  requires f2 : b2 : n → ℕ
  requires bij2 : BijectiveBetween(u2, n, n)
  requires positive : 0 ∈ n
  requires same : kuhnSimplex(n, b1, u1) ∖ {kuhnVertex(n, b1, u1)(n)} = kuhnSimplex(n, b2, u2) ∖ {kuhnVertex(n, b2, u2)(n)}
  shows kuhnSimplex(n, b1, u1) = kuhnSimplex(n, b2, u2)
proof
  have inj1 := Bijective.injective with bij1
  have inj2 := Bijective.injective with bij2
  have zeroNat : Nat(0) by typecheck
  have zeroIn := membership.into_successor with positive
  have nIn := bootstrap.succ.self at n
  have bottom1Member := kuhnVertex.member at n, b1, u1, 0 with f1, zeroIn
  have top1Different := kuhnVertex.top_ne_bottom with f1, inj1, positive
  have bottom1Different : kuhnVertex(n, b1, u1)(0) ≠ kuhnVertex(n, b1, u1)(n)
    intro equal
    apply top1Different
    symm
    exact equal
  have bottom1InFace : kuhnVertex(n, b1, u1)(0) ∈ kuhnSimplex(n, b1, u1) ∖ {kuhnVertex(n, b1, u1)(n)}
    exact difference.singleton_membership.backward with ⟨bottom1Member, bottom1Different⟩
  have minimal1 : ∀ x ∈ kuhnSimplex(n, b1, u1) ∖ {kuhnVertex(n, b1, u1)(n)}, ∀ j ∈ n, kuhnVertex(n, b1, u1)(0)(j) ≤ x(j)
    intros x hx j hj
    have parts := difference.singleton_membership.forward with hx
    exact kuhnVertex.bottom_of_face with f1, parts.left, hj
  rw same at bottom1InFace
  rw under same at minimal1
  have bottomsEqual := kuhnSimplex.bottom_of_top_face with f2, inj2, positive, bottom1InFace, minimal1
  have basesEqual : b1 = b2
    apply FunctionBetween.ext with f1, f2
    intros j hj
    have z1 := kuhnVertex.zero_coordinate at n, b1, u1, j with f1, hj
    have z2 := kuhnVertex.zero_coordinate at n, b2, u2, j with f2, hj
    rw bottomsEqual at z1
    cc
  have topsEqual : kuhnVertex(n, b1, u1)(n) = kuhnVertex(n, b2, u2)(n)
    have g1 := kuhnVertex.function_on at n, b1, u1, n with f1, nIn
    have g2 := kuhnVertex.function_on at n, b2, u2, n with f2, nIn
    apply FunctionBetween.ext with g1, g2
    intros j hj
    have t1 := kuhnVertex.top_coordinate with f1, bij1, hj
    have t2 := kuhnVertex.top_coordinate with f2, bij2, hj
    rw [t1, t2, basesEqual]
    rfl
  have top1Member := kuhnVertex.member at n, b1, u1, n with f1, nIn
  have top2Member := kuhnVertex.member at n, b2, u2, n with f2, nIn
  have restore1 := insert.restore with top1Member
  have restore2 := insert.restore with top2Member
  rwa [← restore1, same, topsEqual]

-- The coordinate sum of the k-th vertex exceeds that of the base by k,
-- so a vertex is determined by its sum.
theorem raised.cardinality (n : Nat) (upd k : Set)
  requires updInjective : InjectiveBetween(upd, n, n)
  requires hk : k ∈ succ(n)
  shows cardinality(raised(n, upd, k)) = k
proof
  have naturals := natural.member at succ(n)
  have kNat := naturals with hk
  have inside := kuhnVertex.index_subset with hk
  have same : raised(n, upd, k) = functionImage(upd, k, n)
    unfold raised
    rfl
  rw same
  have count := cardinality.injective_image with updInjective, inside, (Finite.natural at k)
  rw count
  exact cardinality.natural

theorem kuhnVertex.sum (n : Nat) (base upd k : Set)
  requires baseFunction : base : n → ℕ
  requires updInjective : InjectiveBetween(upd, n, n)
  requires hk : k ∈ succ(n)
  shows natSum(n, kuhnVertex(n, base, upd)(k)) = natSum(n, base) + k
proof
  have finite := Finite.natural at n
  have size : cardinality(n) = n := cardinality.natural
  have baseWeights : ∀ j ∈ n, base(j) ∈ ℕ
    intros j hj
    exact FunctionBetween.apply_closed with baseFunction, hj
  have tagGraph := indicatorMap.function at raised(n, upd, k), n
  have tagWeights : ∀ j ∈ n, indicatorMap(raised(n, upd, k), n)(j) ∈ ℕ
    intros j hj
    exact FunctionBetween.apply_closed with tagGraph, hj
  have agree : ∀ j ∈ n, kuhnVertex(n, base, upd)(k)(j) = base(j) + indicatorMap(raised(n, upd, k), n)(j)
    intros j hj
    have value := kuhnVertex.coordinate at n, base, upd, k, j with baseFunction, hk, hj
    have tag := indicatorMap.value at raised(n, upd, k), n, j with hj
    rw [value, tag]
    rfl
  have additive := natSum.add_pointwise at kuhnVertex(n, base, upd)(k), base, indicatorMap(raised(n, upd, k), n), n
  have split := additive with n, finite, size, baseWeights, tagWeights, agree
  have counted := natSum.indicator at raised(n, upd, k), n
  have tags := counted with n, size
  have inside := raised.subset at n, upd, k
  have intersected : n ∩ raised(n, upd, k) = raised(n, upd, k) := intersection.eq_right_of_subset with inside
  have count := raised.cardinality with updInjective, hk
  rw [split, tags, intersected, count]
  rfl

theorem kuhnSimplex.sum_of_member (n : Nat) (base upd x : Set)
  requires baseFunction : base : n → ℕ
  requires updInjective : InjectiveBetween(upd, n, n)
  requires hx : x ∈ kuhnSimplex(n, base, upd)
  shows ∃ k ∈ succ(n), x = kuhnVertex(n, base, upd)(k) ∧ natSum(n, x) = natSum(n, base) + k
proof
  obtain ⟨inSpace, k, hk, shape⟩ := kuhnSimplex.membership.forward with hx
  have total := kuhnVertex.sum with baseFunction, updInjective, hk
  refine ⟨k, hk, shape, ?_⟩
  rwa shape

theorem kuhnSimplex.sum_determines (n : Nat) (base upd x y : Set)
  requires baseFunction : base : n → ℕ
  requires updInjective : InjectiveBetween(upd, n, n)
  requires hx : x ∈ kuhnSimplex(n, base, upd)
  requires hy : y ∈ kuhnSimplex(n, base, upd)
  requires same : natSum(n, x) = natSum(n, y)
  shows x = y
proof
  obtain ⟨i, hi, shapeX, sumX⟩ := kuhnSimplex.sum_of_member with baseFunction, updInjective, hx
  obtain ⟨k, hk, shapeY, sumY⟩ := kuhnSimplex.sum_of_member with baseFunction, updInjective, hy
  have naturals := natural.member at succ(n)
  have iNat := naturals with hi
  have kNat := naturals with hk
  have baseWeights : ∀ j ∈ n, base(j) ∈ ℕ
    intros j hj
    exact FunctionBetween.apply_closed with baseFunction, hj
  have baseSum := natSum.natural with (Finite.natural at n), baseWeights
  have equal : natSum(n, base) + i = natSum(n, base) + k by cc
  have indices := add.left_cancel with equal
  rw [shapeX, shapeY, indices]
  rfl

theorem kuhnSimplex.vertex_of_sum (n : Nat) (base upd x k : Set)
  requires baseFunction : base : n → ℕ
  requires updInjective : InjectiveBetween(upd, n, n)
  requires hx : x ∈ kuhnSimplex(n, base, upd)
  requires hk : k ∈ succ(n)
  requires total : natSum(n, x) = natSum(n, base) + k
  shows x = kuhnVertex(n, base, upd)(k)
proof
  have member := kuhnVertex.member at n, base, upd, k with baseFunction, hk
  have vertexSum := kuhnVertex.sum with baseFunction, updInjective, hk
  have same : natSum(n, x) = natSum(n, kuhnVertex(n, base, upd)(k)) by cc
  exact kuhnSimplex.sum_determines with baseFunction, updInjective, hx, member, same

theorem kuhnSimplex.sum_bounds (n : Nat) (base upd x : Set)
  requires baseFunction : base : n → ℕ
  requires updInjective : InjectiveBetween(upd, n, n)
  requires hx : x ∈ kuhnSimplex(n, base, upd)
  shows natSum(n, base) ≤ natSum(n, x) ∧ natSum(n, x) ≤ natSum(n, base) + n
proof
  obtain ⟨k, hk, shape, total⟩ := kuhnSimplex.sum_of_member with baseFunction, updInjective, hx
  have naturals := natural.member at succ(n)
  have kNat := naturals with hk
  have bound := Less.of_membership with hk
  have baseWeights : ∀ j ∈ n, base(j) ∈ ℕ
    intros j hj
    exact FunctionBetween.apply_closed with baseFunction, hj
  have baseSum := natSum.natural with (Finite.natural at n), baseWeights
  rw total
  constructor
  . arith
  . arith
