-- A continuous retraction of the cube onto a product of simplices: each
-- coordinate is shifted toward an anchor point by the shortfall of its block
-- sum and then divided by the scale, so that every block sums to one
-- Part of Cumulus, the Grace17 mathematics library.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module Grace.Cumulus.FixedPoint.SimplexRetraction
import BlockSimplex

-- Coordinate j of the retraction toward the anchor a.
def retractCoordinate (n blk a j : Set) : Set :=
  mulCube(n, addCube(n, coordinateCube(n, j), mulCube(n, excessCube(n, blk, blk(j)), constantFunction(unitCube(n), ℝ, a(j)))), invCube(n, scaleCube(n, blk, blk(j))))

theorem retractCoordinate.definition (n blk a j : Set)
  shows retractCoordinate(n, blk, a, j) = mulCube(n, addCube(n, coordinateCube(n, j), mulCube(n, excessCube(n, blk, blk(j)), constantFunction(unitCube(n), ℝ, a(j)))), invCube(n, scaleCube(n, blk, blk(j))))
proof
  unfold retractCoordinate
  rfl

theorem retractCoordinate.continuous (n : Nat) (blk a j : Set)
  requires ha : a ∈ unitCube(n)
  requires hj : j ∈ n
  shows CubeFunctionContinuous(retractCoordinate(n, blk, a, j), n)
proof
  have aj := unitCube.coordinate_real with ha, hj
  have coordinate := coordinateCube.continuous with hj
  have excess := excessCube.continuous at n, blk, blk(j)
  have anchor := constantCube.continuous with aj
  have shift := mulCube.continuous with excess, anchor
  have numerator := addCube.continuous with coordinate, shift
  have scale := scaleCube.continuous at n, blk, blk(j)
  have atLeastOne : ∀ x ∈ unitCube(n), (1:R) ≤ (scaleCube(n, blk, blk(j))(x):R)
    intros x hx
    exact scaleCube.at_least_one with hx
  have inverse := invCube.continuous with scale, atLeastOne
  have same := retractCoordinate.definition at n, blk, a, j
  rw same
  exact mulCube.continuous with numerator, inverse

theorem retractCoordinate.value (n : Nat) (blk a j x : Set)
  requires ha : a ∈ unitCube(n)
  requires hj : j ∈ n
  requires hx : x ∈ unitCube(n)
  shows retractCoordinate(n, blk, a, j)(x) = ((x(j):R) + (excessCube(n, blk, blk(j))(x):R) * (a(j):R)) * realInvValue((scaleCube(n, blk, blk(j))(x):R))
proof
  have aj := unitCube.coordinate_real with ha, hj
  have coordinate := coordinateCube.continuous with hj
  have excess := excessCube.continuous at n, blk, blk(j)
  have anchor := constantCube.continuous with aj
  have shift := mulCube.continuous with excess, anchor
  have numerator := addCube.continuous with coordinate, shift
  have scale := scaleCube.continuous at n, blk, blk(j)
  have atLeastOne : ∀ y ∈ unitCube(n), (1:R) ≤ (scaleCube(n, blk, blk(j))(y):R)
    intros y hy
    exact scaleCube.at_least_one with hy
  have inverse := invCube.continuous with scale, atLeastOne
  have coordinateFunction := CubeFunctionContinuous.function with coordinate
  have excessFunction := CubeFunctionContinuous.function with excess
  have anchorFunction := CubeFunctionContinuous.function with anchor
  have shiftFunction := CubeFunctionContinuous.function with shift
  have numeratorFunction := CubeFunctionContinuous.function with numerator
  have scaleFunction := CubeFunctionContinuous.function with scale
  have inverseFunction := CubeFunctionContinuous.function with inverse
  have same := retractCoordinate.definition at n, blk, a, j
  have product := mulCube.value with numeratorFunction, inverseFunction, hx
  have sum := addCube.value with coordinateFunction, shiftFunction, hx
  have shiftValue := mulCube.value with excessFunction, anchorFunction, hx
  have coordinateValue := coordinateCube.value with hj, hx
  have anchorValue := constantFunction.apply with hx, aj
  have inverseValue := invCube.value with scaleFunction, hx
  rw [same, product, sum, shiftValue, coordinateValue, anchorValue, inverseValue]
  rfl

-- Every retracted coordinate lies in [0, 1].
theorem retractCoordinate.bounds (n : Nat) (blk a j x : Set)
  requires ha : a ∈ unitCube(n)
  requires hj : j ∈ n
  requires hx : x ∈ unitCube(n)
  shows (0:R) ≤ (retractCoordinate(n, blk, a, j)(x):R) ∧ (retractCoordinate(n, blk, a, j)(x):R) ≤ (1:R)
proof
  have value := retractCoordinate.value at n, blk, a, j, x with ha, hj, hx
  have xInterval := unitCube.coordinate with hx, hj
  obtain ⟨xReal, xLower, xUpper⟩ := closedInterval.membership.forward with xInterval
  have aInterval := unitCube.coordinate with ha, hj
  obtain ⟨aReal, aLower, aUpper⟩ := closedInterval.membership.forward with aInterval
  have sumReal := blockSum.real at n, blk, blk(j), x with hx
  have excessReal := excessCube.real at n, blk, blk(j), x with hx
  have scaleReal := scaleCube.real at n, blk, blk(j), x with hx
  have excessNonneg := excessCube.nonnegative at n, blk, blk(j), x with hx
  have scaleAtLeastOne := scaleCube.at_least_one at n, blk, blk(j), x with hx
  have sumExcess := scaleCube.sum_excess at n, blk, blk(j), x with hx
  have termBound := blockSum.ge_coordinate at n, blk, x, j with hx, hj
  obtain ⟨inversePositive, inverseLe⟩ := realInvValue.le_one with scaleAtLeastOne
  have inverseNonneg := realLess.implies_le with inversePositive
  have shiftNonneg := realMulValue.nonnegative with excessNonneg, aLower
  have numeratorNonneg : (0:R) ≤ (x(j):R) + (excessCube(n, blk, blk(j))(x):R) * (a(j):R) by linarith
  have scaleNonzero : (scaleCube(n, blk, blk(j))(x):R) ≠ (0:R)
    intro zero
    rw zero at scaleAtLeastOne
    linarith
  have cancel := realInvValue.mul_right with scaleNonzero
  have shiftLe : (excessCube(n, blk, blk(j))(x):R) * (a(j):R) ≤ (excessCube(n, blk, blk(j))(x):R)
    have step := realLe.mul_left_of_nonnegative with aUpper, excessNonneg
    have one := realMulValue.one_right at excessCube(n, blk, blk(j))(x)
    rwa one at step
  have numeratorLe : (x(j):R) + (excessCube(n, blk, blk(j))(x):R) * (a(j):R) ≤ (scaleCube(n, blk, blk(j))(x):R) by linarith
  have scaled := realLe.mul_right_of_nonnegative with numeratorLe, inverseNonneg
  rw cancel at scaled
  rw value
  constructor
  . exact realMulValue.nonnegative with numeratorNonneg, inverseNonneg
  . exact scaled

-- The family of retracted coordinates and the assembled retraction.
defgraph retractFamily (n blk a : Set) (j ∈ n) : functionSpace(unitCube(n), ℝ) := retractCoordinate(n, blk, a, j)
requires nNat : Nat(n)
requires ha : a ∈ unitCube(n)
proof
  have continuous := retractCoordinate.continuous at n, blk, a, j with ha, member
  have function := CubeFunctionContinuous.function with continuous
  have between : retractCoordinate(n, blk, a, j) : unitCube(n) → ℝ
    exact CubeFunction.function with function
  exact functionSpace.membership.backward with between

theorem retractFamily.coordinate (n : Nat) (blk a j : Set)
  requires ha : a ∈ unitCube(n)
  requires hj : j ∈ n
  shows retractFamily(n, blk, a)(j) = retractCoordinate(n, blk, a, j)
proof
  exact retractFamily.value at n, blk, a, j with *

theorem retractFamily.continuous (n : Nat) (blk a : Set)
  requires ha : a ∈ unitCube(n)
  shows ∀ j ∈ n, CubeFunctionContinuous(retractFamily(n, blk, a)(j), n)
proof
  intros j hj
  have same := retractFamily.coordinate at n, blk, a, j with ha, hj
  rw same
  exact retractCoordinate.continuous with ha, hj

theorem retractFamily.functions (n : Nat) (blk a : Set)
  requires ha : a ∈ unitCube(n)
  shows ∀ j ∈ n, CubeFunction(retractFamily(n, blk, a)(j), n)
proof
  intros j hj
  have continuous := retractFamily.continuous at n, blk, a with ha
  exact CubeFunctionContinuous.function with (continuous with hj)

theorem retractFamily.bounds (n : Nat) (blk a : Set)
  requires ha : a ∈ unitCube(n)
  shows ∀ j ∈ n, ∀ x ∈ unitCube(n), (0:R) ≤ (retractFamily(n, blk, a)(j)(x):R) ∧ (retractFamily(n, blk, a)(j)(x):R) ≤ (1:R)
proof
  intros j hj x hx
  have same := retractFamily.coordinate at n, blk, a, j with ha, hj
  rw same
  exact retractCoordinate.bounds with ha, hj, hx

def retraction (n blk a : Set) : Set := assembledMap(n, retractFamily(n, blk, a))

theorem retraction.definition (n blk a : Set)
  shows retraction(n, blk, a) = assembledMap(n, retractFamily(n, blk, a))
proof
  unfold retraction
  rfl

theorem retraction.continuous (n : Nat) (blk a : Set)
  requires ha : a ∈ unitCube(n)
  shows CubeContinuous(retraction(n, blk, a), n)
proof
  have family := retractFamily.continuous at n, blk, a with ha
  have bounds := retractFamily.bounds at n, blk, a with ha
  have same := retraction.definition at n, blk, a
  rw same
  exact assembledMap.continuous with family, bounds

theorem retraction.map (n : Nat) (blk a : Set)
  requires ha : a ∈ unitCube(n)
  shows CubeMap(retraction(n, blk, a), n)
proof
  have continuous := retraction.continuous at n, blk, a with ha
  exact continuous.left

theorem retraction.in_cube (n : Nat) (blk a x : Set)
  requires ha : a ∈ unitCube(n)
  requires hx : x ∈ unitCube(n)
  shows retraction(n, blk, a)(x) ∈ unitCube(n)
proof
  have map := retraction.map at n, blk, a with ha
  have function := CubeMap.function with map
  exact FunctionBetween.apply_closed with function, hx

theorem retraction.coordinate (n : Nat) (blk a x j : Set)
  requires ha : a ∈ unitCube(n)
  requires hx : x ∈ unitCube(n)
  requires hj : j ∈ n
  shows retraction(n, blk, a)(x)(j) = ((x(j):R) + (excessCube(n, blk, blk(j))(x):R) * (a(j):R)) * realInvValue((scaleCube(n, blk, blk(j))(x):R))
proof
  have functions := retractFamily.functions at n, blk, a with ha
  have bounds := retractFamily.bounds at n, blk, a with ha
  have same := retraction.definition at n, blk, a
  have assembled := assembledMap.coordinate with functions, bounds, hx, hj
  have family := retractFamily.coordinate at n, blk, a, j with ha, hj
  rw [same, assembled, family]
  exact retractCoordinate.value with ha, hj, hx

-- Every block of the retracted point sums to one, so the retraction lands in
-- the product of simplices, and it fixes every point of the product.
theorem retraction.block_sum (n : Nat) (m blk a x p : Set)
  requires blkFunction : blk : n → m
  requires ha : a ∈ simplexProduct(n, m, blk)
  requires hx : x ∈ unitCube(n)
  requires hp : p ∈ m
  shows blockSum(n, blk, p)(retraction(n, blk, a)(x)) = (1:R)
proof
  have aCube := simplexProduct.cube with ha
  have anchor := simplexProduct.block_sum with ha, hp
  have image := retraction.in_cube at n, blk, a, x with aCube, hx
  have shifted : ∀ j ∈ n, j ∈ blockSet(n, blk, p) → retraction(n, blk, a)(x)(j) = ((x(j):R) + (excessCube(n, blk, p)(x):R) * (a(j):R)) * realInvValue((scaleCube(n, blk, p)(x):R))
    intros j hj inBlock
    have parts := blockSet.membership.forward with inBlock
    have block := parts.right
    have value := retraction.coordinate at n, blk, a, x, j with aCube, hx, hj
    rwa block at value
  have sumSame := blockSum.definition at n, blk, p
  have affine := sumCube.affine with hx, aCube, image, shifted
  rw sumSame at affine
  have sumExcess := scaleCube.sum_excess at n, blk, p, x with hx
  have scaleAtLeastOne := scaleCube.at_least_one at n, blk, p, x with hx
  have scaleNonzero : (scaleCube(n, blk, p)(x):R) ≠ (0:R)
    intro zero
    rw zero at scaleAtLeastOne
    linarith
  have cancel := realInvValue.mul_right with scaleNonzero
  have one := realMulValue.one_right at excessCube(n, blk, p)(x)
  rwa [affine, anchor, one, sumExcess]

theorem retraction.in_product (n : Nat) (m blk a x : Set)
  requires blkFunction : blk : n → m
  requires ha : a ∈ simplexProduct(n, m, blk)
  requires hx : x ∈ unitCube(n)
  shows retraction(n, blk, a)(x) ∈ simplexProduct(n, m, blk)
proof
  have aCube := simplexProduct.cube with ha
  apply simplexProduct.membership.backward
  constructor
  . exact retraction.in_cube with aCube, hx
  . intros p hp
    exact retraction.block_sum with blkFunction, ha, hx, hp

theorem retraction.fixed (n : Nat) (m blk a x : Set)
  requires blkFunction : blk : n → m
  requires ha : a ∈ simplexProduct(n, m, blk)
  requires hx : x ∈ simplexProduct(n, m, blk)
  shows retraction(n, blk, a)(x) = x
proof
  have aCube := simplexProduct.cube with ha
  have xCube := simplexProduct.cube with hx
  have image := retraction.in_cube at n, blk, a, x with aCube, xCube
  have imageFunction := unitCube.point with image
  have xFunction := unitCube.point with xCube
  apply FunctionBetween.ext with imageFunction, xFunction
  intros j hj
  have value := retraction.coordinate at n, blk, a, x, j with aCube, xCube, hj
  have block := FunctionBetween.apply_closed with blkFunction, hj
  have sumOne := simplexProduct.block_sum with hx, block
  have excessValue := excessCube.value at n, blk, blk(j), x with xCube
  have scaleValue := scaleCube.value at n, blk, blk(j), x with xCube
  rw sumOne at excessValue
  rw sumOne at scaleValue
  have shift : (1:R) + -(1:R) = (0:R) by linarith
  rw shift at excessValue
  have excessZero := realMax.of_le with (realLe.reflexive at (0:R))
  have scaleOne := realMax.of_le with (realLe.reflexive at (1:R))
  rw excessZero at excessValue
  rw scaleOne at scaleValue
  have oneNonzero : (1:R) ≠ (0:R)
    intro equal
    linarith
  have inverseOne : realInvValue((1:R)) = (1:R)
    have cancel := realInvValue.mul_right with oneNonzero
    have one := realMulValue.one_left at realInvValue((1:R))
    rwa one at cancel
  have xj := unitCube.coordinate_real with xCube, hj
  have aj := unitCube.coordinate_real with aCube, hj
  rw [value, excessValue, scaleValue, inverseOne]
  ring
