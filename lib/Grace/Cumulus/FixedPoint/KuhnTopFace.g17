-- Authors: Grant Passmore

module Grace.Cumulus.FixedPoint.KuhnTopFace
import KuhnRotation

-- The inverse cyclic shift sends 0 to n − 1 and l + 1 to l.
def unrotation (n : Set) : Set := converse(rotation(n), n, n)

theorem unrotation.bijective (n : Nat)
  shows BijectiveBetween(unrotation(n), n, n)
proof
  have turn := rotation.bijective at n
  unfold unrotation
  exact converse.bijective with turn

theorem unrotation.step (n : Nat) (l : Set)
  requires hl : l ∈ n
  requires hs : succ(l) ∈ n
  shows unrotation(n)(succ(l)) = l
proof
  have turn := rotation.step with hl, hs
  have bijective := rotation.bijective at n
  have same : unrotation(n)(succ(l)) = converse(rotation(n), n, n)(succ(l))
    unfold unrotation
    rfl
  rw [same, ← turn]
  exact Bijective.inverse_apply with bijective, hl

theorem unrotation.wrap (n : Nat) (m : Set)
  requires hm : m ∈ n
  requires top : succ(m) = n
  shows unrotation(n)(0) = m
proof
  have turn := rotation.wrap with hm, top
  have bijective := rotation.bijective at n
  have same : unrotation(n)(0) = converse(rotation(n), n, n)(0)
    unfold unrotation
    rfl
  rw [same, ← turn]
  exact Bijective.inverse_apply with bijective, hm

def unrotated (n upd : Set) : Set := compose(upd, unrotation(n), n, n, n)

theorem unrotated.bijective (n : Nat) (upd : Set)
  requires updBijective : BijectiveBetween(upd, n, n)
  shows BijectiveBetween(unrotated(n, upd), n, n)
proof
  have turn := unrotation.bijective at n
  unfold unrotated
  exact compose.bijective with turn, updBijective

theorem unrotated.value (n : Nat) (upd l : Set)
  requires updBijective : BijectiveBetween(upd, n, n)
  requires hl : l ∈ n
  shows unrotated(n, upd)(l) = upd(unrotation(n)(l))
proof
  have updFunction := Injective.function with (Bijective.injective with updBijective)
  have turn := Injective.function with (Bijective.injective with (unrotation.bijective at n))
  have same : unrotated(n, upd)(l) = compose(upd, unrotation(n), n, n, n)(l)
    unfold unrotated
    rfl
  rw same
  exact compose.apply with turn, updFunction, hl

theorem unrotated.step (n : Nat) (upd l : Set)
  requires updBijective : BijectiveBetween(upd, n, n)
  requires hl : l ∈ n
  requires hs : succ(l) ∈ n
  shows unrotated(n, upd)(succ(l)) = upd(l)
proof
  have value := unrotated.value with updBijective, hs
  have turn := unrotation.step with hl, hs
  rw [value, turn]
  rfl

theorem unrotated.wrap (n : Nat) (upd m : Set)
  requires updBijective : BijectiveBetween(upd, n, n)
  requires hm : m ∈ n
  requires top : succ(m) = n
  shows unrotated(n, upd)(0) = upd(m)
proof
  have mNat := natural.member at n with hm
  have mLess := Less.of_membership with hm
  have zeroLess : 0 < n by arith
  have zeroIn := membership.of_Less with zeroLess
  have value := unrotated.value with updBijective, zeroIn
  have turn := unrotation.wrap with hm, top
  rw [value, turn]
  rfl

-- The first k + 1 shifted coordinates are upd(n − 1) and the first k of the
-- original.
theorem raised.unrotated (n : Nat) (upd m k : Set)
  requires updBijective : BijectiveBetween(upd, n, n)
  requires hm : m ∈ n
  requires top : succ(m) = n
  requires hk : k ∈ n
  shows raised(n, unrotated(n, upd), succ(k)) = insert(upd(m), raised(n, upd, k))
proof
  have updFunction := Injective.function with (Bijective.injective with updBijective)
  have kNat := natural.member at n with hk
  have kLess := Less.of_membership with hk
  have kInside := Ordinal.member_subset with (Ordinal.natural at n), hk
  ext y
  constructor
  . intro hy
    obtain ⟨inN, l, hl, shape⟩ := raised.membership.forward with hy
    have lNat := natural.member at succ(k) with hl
    have lLess := Less.of_membership with hl
    have split := natural.zero_or_successor with lNat
    apply insert.membership.backward
    cases split with zero | successor
    . left
      have value := unrotated.wrap with updBijective, hm, top
      rw [shape, zero, value]
      rfl
    . right
      obtain ⟨l2, l2Nat, lEq⟩ := successor
      rw lEq at lLess
      have l2Less : l2 < k by arith
      have l2In := membership.of_Less with l2Less
      have l2InN := kInside with l2, l2In
      have sLess : succ(l2) < n by arith
      have sIn := membership.of_Less with sLess
      have value := unrotated.step with updBijective, l2InN, sIn
      apply raised.membership.backward
      constructor
      . exact inN
      . witness l2
        constructor
        . exact l2In
        . rw [shape, lEq, value]
          rfl
  . intro hy
    have split := insert.membership.forward with hy
    cases split with same | below
    . have value := unrotated.wrap with updBijective, hm, top
      apply raised.membership.backward
      constructor
      . rw same
        exact FunctionBetween.apply_closed with updFunction, hm
      . witness 0
        constructor
        . have less : 0 < succ(k) by arith
          exact membership.of_Less with less
        . rw [same, value]
          rfl
    . obtain ⟨inN, l, hl, shape⟩ := raised.membership.forward with below
      have lInN := kInside with l, hl
      have lNat := natural.member at n with lInN
      have lLess := Less.of_membership with hl
      have sLess : succ(l) < n by arith
      have sIn := membership.of_Less with sLess
      have value := unrotated.step with updBijective, lInN, sIn
      apply raised.membership.backward
      constructor
      . exact inN
      . witness succ(l)
        constructor
        . have less : succ(l) < succ(k) by arith
          exact membership.of_Less with less
        . rw [shape, value]
          rfl

theorem raised.unrotated_fresh (n : Nat) (upd m k : Set)
  requires updBijective : BijectiveBetween(upd, n, n)
  requires hm : m ∈ n
  requires top : succ(m) = n
  requires hk : k ∈ n
  shows ¬upd(m) ∈ raised(n, upd, k)
proof
  have updInjective := Bijective.injective with updBijective
  have mNat := natural.member at n with hm
  have kNat := natural.member at n with hk
  have kLess := Less.of_membership with hk
  have kInside := Ordinal.member_subset with (Ordinal.natural at n), hk
  intro inside
  obtain ⟨inN, l, hl, shape⟩ := raised.membership.forward with inside
  have lInN := kInside with l, hl
  have lNat := natural.member at n with lInN
  have lLess := Less.of_membership with hl
  have same := Injective.apply_cancel with updInjective, hm, lInN, shape
  rw ← top at kLess
  arith

-- The base lowered by one at coordinate upd(m): the unique function with
-- lowered(j) + [j = upd(m)] = base(j).
defunique loweredValue (n base upd m j : Set) (y ∈ ℕ) := y + indicator({upd(m)}, j) = base(j)
requires baseFunction : base : n → ℕ
requires rooted : 0 < base(upd(m))
requires hj : j ∈ n
proof
  have baseIn := FunctionBetween.apply_closed with baseFunction, hj
  have baseNat := nat.omega.backward with baseIn
  have alternatives : j = upd(m) ∨ j ≠ upd(m) by tauto
  cases alternatives with same | different
  . have positive : 0 < base(j)
      rwa same
    have shape := natural.zero_or_successor with baseNat
    cases shape with zero | successor
    . exfalso
      rw zero at positive
      arith
    . obtain ⟨k, kNat, eq⟩ := successor
      have kIn := nat.omega.forward with kNat
      refine ⟨k, kIn, ?_⟩
      have one : indicator({upd(m)}, j) = 1
        rw same
        exact indicator.singleton_self
      rw [one, eq]
      exact add.right_one
  . have separated : upd(m) ≠ j
      intro equal
      apply different
      symm
      exact equal
    have zero := indicator.singleton_other with separated
    refine ⟨base(j), baseIn, ?_⟩
    rw zero
    exact add.right_unit
uniqueness
  intros u hu first v hv second
  have uNat := nat.omega.backward with hu
  have vNat := nat.omega.backward with hv
  have same : u + indicator({upd(m)}, j) = v + indicator({upd(m)}, j)
    rw [first, second]
    rfl
  exact add.right_cancel with same

defgraph lowered (n base upd m : Set) (j ∈ n) : ℕ := loweredValue(n, base, upd, m, j)
requires baseFunction : base : n → ℕ
requires rooted : 0 < base(upd(m))
proof
  have selected := loweredValue.selected at n, base, upd, m, j with *
  exact selected.left

theorem lowered.restores (n : Nat) (base upd m j : Set)
  requires baseFunction : base : n → ℕ
  requires rooted : 0 < base(upd(m))
  requires hj : j ∈ n
  shows lowered(n, base, upd, m)(j) + indicator({upd(m)}, j) = base(j)
proof
  have value := lowered.value at n, base, upd, m, j with *
  have selected := loweredValue.selected at n, base, upd, m, j with *
  rw value
  exact selected.right

-- The lowered simplex lists a new bottom followed by vertices 0, …, n − 1 of
-- the original.
theorem kuhnVertex.unrotated (n : Nat) (base upd m k : Set)
  requires baseFunction : base : n → ℕ
  requires updBijective : BijectiveBetween(upd, n, n)
  requires hm : m ∈ n
  requires top : succ(m) = n
  requires rooted : 0 < base(upd(m))
  requires hk : k ∈ n
  shows kuhnVertex(n, lowered(n, base, upd, m), unrotated(n, upd))(succ(k)) = kuhnVertex(n, base, upd)(k)
proof
  have lowFunction := lowered.function with baseFunction, rooted
  have kNat := natural.member at n with hk
  have kLess := Less.of_membership with hk
  have kInSucc := membership.into_successor with hk
  have sLess : succ(k) < succ(n) by arith
  have sIn := membership.of_Less with sLess
  have leftFunction := kuhnVertex.function_on at n, lowered(n, base, upd, m), unrotated(n, upd), succ(k) with lowFunction, sIn
  have rightFunction := kuhnVertex.function_on at n, base, upd, k with baseFunction, kInSucc
  apply FunctionBetween.ext with leftFunction, rightFunction
  intros j hj
  have leftValue := kuhnVertex.coordinate at n, lowered(n, base, upd, m), unrotated(n, upd), succ(k), j with lowFunction, sIn, hj
  have rightValue := kuhnVertex.coordinate at n, base, upd, k, j with baseFunction, kInSucc, hj
  have image := raised.unrotated with updBijective, hm, top, hk
  have fresh := raised.unrotated_fresh with updBijective, hm, top, hk
  have split := indicator.insert_fresh at upd(m), raised(n, upd, k), j with fresh
  have restores := lowered.restores with baseFunction, rooted, hj
  have lowNat := nat.omega.backward with (FunctionBetween.apply_closed with lowFunction, hj)
  rw [leftValue, rightValue, image, split, ← restores]
  exact add.associative_reverse

theorem kuhnSimplex.unrotated_face (n : Nat) (base upd m : Set)
  requires baseFunction : base : n → ℕ
  requires updBijective : BijectiveBetween(upd, n, n)
  requires hm : m ∈ n
  requires top : succ(m) = n
  requires rooted : 0 < base(upd(m))
  shows kuhnSimplex(n, base, upd) ∖ {kuhnVertex(n, base, upd)(n)} =
    kuhnSimplex(n, lowered(n, base, upd, m), unrotated(n, upd)) ∖
      {kuhnVertex(n, lowered(n, base, upd, m), unrotated(n, upd))(0)}
proof
  have updInjective := Bijective.injective with updBijective
  have lowFunction := lowered.function with baseFunction, rooted
  have unrotatedInjective := Bijective.injective with (unrotated.bijective with updBijective)
  have zeroLess : 0 < succ(n) by arith
  have zeroIn := membership.of_Less with zeroLess
  have nIn := bootstrap.succ.self at n
  ext x
  constructor
  . intro hx
    have parts := difference.singleton_membership.forward with hx
    obtain ⟨inSpace, k, hk, shape⟩ := kuhnSimplex.membership.forward with parts.left
    have kIn : k ∈ n
      have split := bootstrap.succ.membership.forward with hk
      cases split with below | same
      . exact below
      . exfalso
        apply parts.right
        rw [shape, same]
        rfl
    have kNat := natural.member at n with kIn
    have kLess := Less.of_membership with kIn
    have sLess : succ(k) < succ(n) by arith
    have sIn := membership.of_Less with sLess
    have agree := kuhnVertex.unrotated with baseFunction, updBijective, hm, top, rooted, kIn
    apply difference.singleton_membership.backward
    constructor
    . rw [shape, ← agree]
      exact kuhnVertex.member with lowFunction, sIn
    . intro equal
      rw [shape, ← agree] at equal
      have same := kuhnVertex.injective with lowFunction, unrotatedInjective, sIn, zeroIn, equal
      arith
  . intro hx
    have parts := difference.singleton_membership.forward with hx
    obtain ⟨inSpace, l, hl, shape⟩ := kuhnSimplex.membership.forward with parts.left
    have lNat := natural.member at succ(n) with hl
    have lLess := Less.of_membership with hl
    have split := natural.zero_or_successor with lNat
    cases split with zero | successor
    . exfalso
      apply parts.right
      rw [shape, zero]
      rfl
    . obtain ⟨k, kNat, lEq⟩ := successor
      rw lEq at lLess
      have kLess : k < n by arith
      have kIn := membership.of_Less with kLess
      have kInSucc := membership.into_successor with kIn
      have agree := kuhnVertex.unrotated with baseFunction, updBijective, hm, top, rooted, kIn
      apply difference.singleton_membership.backward
      constructor
      . rw [shape, lEq, agree]
        exact kuhnVertex.member with baseFunction, kInSucc
      . intro equal
        rw [shape, lEq, agree] at equal
        have same := kuhnVertex.injective with baseFunction, updInjective, kInSucc, nIn, equal
        rw same at kIn
        exact membership.irreflexive with kIn

-- Away from the top vertex, coordinate upd(n − 1) is constant on a simplex.
theorem kuhnSimplex.top_face_constant (n : Nat) (base upd m x : Set)
  requires baseFunction : base : n → ℕ
  requires updBijective : BijectiveBetween(upd, n, n)
  requires hm : m ∈ n
  requires top : succ(m) = n
  requires hx : x ∈ kuhnSimplex(n, base, upd) ∖ {kuhnVertex(n, base, upd)(n)}
  shows x(upd(m)) = base(upd(m))
proof
  have updFunction := Injective.function with (Bijective.injective with updBijective)
  have jIn := FunctionBetween.apply_closed with updFunction, hm
  have parts := difference.singleton_membership.forward with hx
  obtain ⟨inSpace, k, hk, shape⟩ := kuhnSimplex.membership.forward with parts.left
  have kIn : k ∈ n
    have split := bootstrap.succ.membership.forward with hk
    cases split with below | same
    . exact below
    . exfalso
      apply parts.right
      rw [shape, same]
      rfl
  have fresh := raised.unrotated_fresh with updBijective, hm, top, kIn
  have zero := indicator.absent with fresh
  have value := kuhnVertex.coordinate at n, base, upd, k, upd(m) with baseFunction, hk, jIn
  have baseNat := nat.omega.backward with (FunctionBetween.apply_closed with baseFunction, jIn)
  rw [shape, value, zero]
  exact add.right_unit

-- A top face off the wall x_{upd(n − 1)} = 0 has a positive base coordinate
-- there, so the lowered base exists.
theorem kuhnSimplex.top_face_rooted (n : Nat) (base upd m : Set)
  requires baseFunction : base : n → ℕ
  requires updBijective : BijectiveBetween(upd, n, n)
  requires hm : m ∈ n
  requires top : succ(m) = n
  requires notZero : ∃ x ∈ kuhnSimplex(n, base, upd) ∖ {kuhnVertex(n, base, upd)(n)}, x(upd(m)) ≠ 0
  shows 0 < base(upd(m))
proof
  have updFunction := Injective.function with (Bijective.injective with updBijective)
  have jIn := FunctionBetween.apply_closed with updFunction, hm
  have baseNat := nat.omega.backward with (FunctionBetween.apply_closed with baseFunction, jIn)
  obtain ⟨x, hx, apart⟩ := notZero
  have constant := kuhnSimplex.top_face_constant with baseFunction, updBijective, hm, top, hx
  rw constant at apart
  have shape := natural.zero_or_successor with baseNat
  cases shape with zero | successor
  . exfalso
    exact apart with zero
  . obtain ⟨k, kNat, eq⟩ := successor
    rw eq
    arith

-- Through the face opposite the top vertex there are exactly the original
-- simplex and its lowering.
theorem kuhnSimplex.top_face_neighbours (n : Nat) (base upd m b2 u2 c : Set)
  requires baseFunction : base : n → ℕ
  requires updBijective : BijectiveBetween(upd, n, n)
  requires hm : m ∈ n
  requires top : succ(m) = n
  requires rooted : 0 < base(upd(m))
  requires f2 : b2 : n → ℕ
  requires bij2 : BijectiveBetween(u2, n, n)
  requires hc : c ∈ kuhnSimplex(n, b2, u2)
  requires same : kuhnSimplex(n, b2, u2) ∖ {c} = kuhnSimplex(n, base, upd) ∖ {kuhnVertex(n, base, upd)(n)}
  shows kuhnSimplex(n, b2, u2) = kuhnSimplex(n, base, upd) ∨
    kuhnSimplex(n, b2, u2) = kuhnSimplex(n, lowered(n, base, upd, m), unrotated(n, upd))
proof
  have updFunction := Injective.function with (Bijective.injective with updBijective)
  have injective2 := Bijective.injective with bij2
  have jIn := FunctionBetween.apply_closed with updFunction, hm
  have mNat := natural.member at n with hm
  have mLess := Less.of_membership with hm
  have zeroLess : 0 < n by arith
  have positive := membership.of_Less with zeroLess
  have lowFunction := lowered.function with baseFunction, rooted
  have unrotatedBijective := unrotated.bijective with updBijective
  obtain ⟨inSpace, k, hk, shape⟩ := kuhnSimplex.membership.forward with hc
  have constant : ∀ l ∈ succ(n), l ≠ k → kuhnVertex(n, b2, u2)(l)(upd(m)) = base(upd(m))
    intros l hl different
    have vertexMember := kuhnVertex.member at n, b2, u2, l with f2, hl
    have inFace : kuhnVertex(n, b2, u2)(l) ∈ kuhnSimplex(n, b2, u2) ∖ {c}
      apply difference.singleton_membership.backward
      constructor
      . exact vertexMember
      . intro equal
        rw shape at equal
        have index := kuhnVertex.injective with f2, injective2, hl, hk, equal
        exact different with index
    rw same at inFace
    exact kuhnSimplex.top_face_constant with baseFunction, updBijective, hm, top, inFace
  have index := kuhnSimplex.constant_face_index with f2, bij2, hk, jIn, constant
  cases index with zero | topIndex
  . right
    rw [shape, zero] at same
    have face := kuhnSimplex.unrotated_face with baseFunction, updBijective, hm, top, rooted
    rw face at same
    exact kuhnSimplex.eq_bottom with f2, bij2, lowFunction, unrotatedBijective, positive, same
  . left
    rw [shape, topIndex] at same
    exact kuhnSimplex.eq_top with f2, bij2, baseFunction, updBijective, positive, same

theorem kuhnSimplex.unrotated_ne (n : Nat) (base upd m : Set)
  requires baseFunction : base : n → ℕ
  requires updBijective : BijectiveBetween(upd, n, n)
  requires hm : m ∈ n
  requires top : succ(m) = n
  requires rooted : 0 < base(upd(m))
  shows kuhnSimplex(n, lowered(n, base, upd, m), unrotated(n, upd)) ≠ kuhnSimplex(n, base, upd)
proof
  have updInjective := Bijective.injective with updBijective
  have lowFunction := lowered.function with baseFunction, rooted
  have unrotatedInjective := Bijective.injective with (unrotated.bijective with updBijective)
  have mNat := natural.member at n with hm
  have mLess := Less.of_membership with hm
  have zeroLess : 0 < n by arith
  have positive := membership.of_Less with zeroLess
  have zeroIn := membership.into_successor with positive
  have oneLess : succ(0) < succ(n) by arith
  have oneIn := membership.of_Less with oneLess
  intro equal
  have bottomMember := kuhnVertex.member at n, lowered(n, base, upd, m), unrotated(n, upd), 0 with lowFunction, zeroIn
  rw equal at bottomMember
  have bounds := kuhnSimplex.sum_bounds with baseFunction, updInjective, bottomMember
  have bottomSum := kuhnVertex.sum with lowFunction, unrotatedInjective, zeroIn
  have oneSum := kuhnVertex.sum with lowFunction, unrotatedInjective, oneIn
  have agree := kuhnVertex.unrotated with baseFunction, updBijective, hm, top, rooted, positive
  have zeroSum := kuhnVertex.sum with baseFunction, updInjective, zeroIn
  rw [agree, zeroSum] at oneSum
  have lower := bounds.left
  rw bottomSum at lower
  have baseWeights : ∀ j ∈ n, base(j) ∈ ℕ
    intros j hj
    exact FunctionBetween.apply_closed with baseFunction, hj
  have baseSum := natSum.natural with (Finite.natural at n), baseWeights
  have lowWeights : ∀ j ∈ n, lowered(n, base, upd, m)(j) ∈ ℕ
    intros j hj
    exact FunctionBetween.apply_closed with lowFunction, hj
  have lowSum := natSum.natural with (Finite.natural at n), lowWeights
  arith
