-- Brouwer's fixed point theorem for the unit cube: every continuous self-map
-- of [0, 1]ⁿ has a fixed point, from Kuhn's lemma on finer and finer grids
-- Part of Cumulus, the Grace17 mathematics library.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module Grace.Cumulus.FixedPoint.BrouwerCube
import BrouwerGrid

-- At every grid level Kuhn's lemma gives a cell carrying, in each direction,
-- a point labelled 0 and a point labelled 1; one such cell is chosen.
defchoose kuhnCell (n f : Set, k : Nat) (base ∈ functionSpace(n, ℕ)) :=
  (∀ j ∈ n, base(j) < doubling(k)) ∧
  ∀ i ∈ n, ∃ u ∈ functionSpace(n, succ(doubling(k))), ∃ v ∈ functionSpace(n, succ(doubling(k))),
    (∀ j ∈ n, LessEqual(base(j), u(j)) ∧ LessEqual(u(j), add(base(j), (1:N)))) ∧ (∀ j ∈ n, LessEqual(base(j), v(j)) ∧ LessEqual(v(j), add(base(j), (1:N)))) ∧
    gridLabels(k, n, f)(u)(i) = (0:N) ∧ gridLabels(k, n, f)(v)(i) ≠ (0:N)
requires nNat : Nat(n)
proof
  obtain ⟨q, qNat, shape⟩ := doubling.successor at k
  have labFunction := gridLabels.function at k, n, f
  rw shape at labFunction
  have zeroWall := gridLabels.zero_wall at k, n, q, f with shape
  have fullWall := gridLabels.full_wall at k, n, q, f with shape
  obtain ⟨base, baseIn, bounds, pairs⟩ := kuhn.lemma at q, n, gridLabels(k, n, f), functionSpace(n, succ(succ(0))) with labFunction, zeroWall, fullWall
  witness base
  refine ⟨baseIn, ?_, ?_⟩
  . intros j hj
    have bound := bounds with hj
    rw ← shape at bound
    exact bound
  . intros i hi
    obtain ⟨u, hu, v, hv, uCell, vCell, uLabel, vLabel⟩ := pairs with hi
    rw ← shape at hu
    rw ← shape at hv
    witness u
    constructor
    . exact hu
    . witness v
      constructor
      . exact hv
      . exact ⟨uCell, vCell, uLabel, vLabel⟩

theorem kuhnCell.grid (n : Nat) (f : Set) (k : Nat)
  shows kuhnCell(n, f, k) ∈ functionSpace(n, succ(doubling(k)))
proof
  obtain ⟨baseIn, bounds, pairs⟩ := kuhnCell.selected at n, f, k
  have baseFunction := functionSpace.membership.forward with baseIn
  apply functionSpace.membership.backward
  apply FunctionBetween.codomain_of_values with baseFunction
  intros j hj
  have bound := bounds with hj
  have valueIn := FunctionBetween.apply_closed with baseFunction, hj
  have valueNat := nat.omega.backward with valueIn
  have less : kuhnCell(n, f, k)(j) < succ(doubling(k)) by arith
  exact membership.of_Less with less

defchoose lowPoint (n f : Set, k : Nat, i : Set) (u ∈ functionSpace(n, succ(doubling(k)))) :=
  (∀ j ∈ n, LessEqual(kuhnCell(n, f, k)(j), u(j)) ∧ LessEqual(u(j), add(kuhnCell(n, f, k)(j), (1:N)))) ∧ gridLabels(k, n, f)(u)(i) = (0:N)
requires nNat : Nat(n)
requires hi : i ∈ n
proof
  obtain ⟨baseIn, bounds, pairs⟩ := kuhnCell.selected at n, f, k
  obtain ⟨u, hu, v, hv, uCell, vCell, uLabel, vLabel⟩ := pairs with hi
  witness u
  refine ⟨hu, uCell, uLabel⟩

defchoose highPoint (n f : Set, k : Nat, i : Set) (v ∈ functionSpace(n, succ(doubling(k)))) :=
  (∀ j ∈ n, LessEqual(kuhnCell(n, f, k)(j), v(j)) ∧ LessEqual(v(j), add(kuhnCell(n, f, k)(j), (1:N)))) ∧ gridLabels(k, n, f)(v)(i) ≠ (0:N)
requires nNat : Nat(n)
requires hi : i ∈ n
proof
  obtain ⟨baseIn, bounds, pairs⟩ := kuhnCell.selected at n, f, k
  obtain ⟨u, hu, v, hv, uCell, vCell, uLabel, vLabel⟩ := pairs with hi
  witness v
  refine ⟨hv, vCell, vLabel⟩

-- The chosen cells, low points, and high points, scaled into the cube.
defgraph basePoints (n f : Set) (k ∈ ℕ) : functionSpace(n, ℝ) := gridPoint(k, n)(kuhnCell(n, f, k))
requires nNat : Nat(n)
proof
  have kNat := nat.omega.backward with member
  have gridFunction := gridPoint.function at k, n with *
  have pointIn := FunctionBetween.apply_closed with gridFunction, (kuhnCell.grid at n, f, k)
  have parts := unitCube.membership.forward with pointIn
  exact parts.left

defgraph lowPoints (n f i : Set) (k ∈ ℕ) : functionSpace(n, ℝ) := gridPoint(k, n)(lowPoint(n, f, k, i))
requires nNat : Nat(n)
requires hi : i ∈ n
proof
  have kNat := nat.omega.backward with member
  have gridFunction := gridPoint.function at k, n with *
  have selected := lowPoint.selected at n, f, k, i with *
  have pointIn := FunctionBetween.apply_closed with gridFunction, selected.left
  have parts := unitCube.membership.forward with pointIn
  exact parts.left

defgraph highPoints (n f i : Set) (k ∈ ℕ) : functionSpace(n, ℝ) := gridPoint(k, n)(highPoint(n, f, k, i))
requires nNat : Nat(n)
requires hi : i ∈ n
proof
  have kNat := nat.omega.backward with member
  have gridFunction := gridPoint.function at k, n with *
  have selected := highPoint.selected at n, f, k, i with *
  have pointIn := FunctionBetween.apply_closed with gridFunction, selected.left
  have parts := unitCube.membership.forward with pointIn
  exact parts.left

theorem basePoints.sequence (n : Nat) (f : Set)
  shows PointSequence(basePoints(n, f), n)
proof
  exact basePoints.function at n, f with *

theorem basePoints.in_cube (n : Nat) (f k : Set)
  requires hk : k ∈ ℕ
  shows basePoints(n, f)(k) ∈ unitCube(n)
proof
  have kNat := nat.omega.backward with hk
  have value := basePoints.value at n, f, k with *
  rw value
  have gridFunction := gridPoint.function at k, n with *
  exact FunctionBetween.apply_closed with gridFunction, (kuhnCell.grid at n, f, k)

theorem lowPoints.sequence (n : Nat) (f i : Set)
  requires hi : i ∈ n
  shows PointSequence(lowPoints(n, f, i), n)
proof
  exact lowPoints.function at n, f, i with *

theorem lowPoints.in_cube (n : Nat) (f i k : Set)
  requires hi : i ∈ n
  requires hk : k ∈ ℕ
  shows lowPoints(n, f, i)(k) ∈ unitCube(n)
proof
  have kNat := nat.omega.backward with hk
  have value := lowPoints.value at n, f, i, k with *
  rw value
  have gridFunction := gridPoint.function at k, n with *
  have selected := lowPoint.selected at n, f, k, i with *
  exact FunctionBetween.apply_closed with gridFunction, selected.left

theorem highPoints.sequence (n : Nat) (f i : Set)
  requires hi : i ∈ n
  shows PointSequence(highPoints(n, f, i), n)
proof
  exact highPoints.function at n, f, i with *

theorem highPoints.in_cube (n : Nat) (f i k : Set)
  requires hi : i ∈ n
  requires hk : k ∈ ℕ
  shows highPoints(n, f, i)(k) ∈ unitCube(n)
proof
  have kNat := nat.omega.backward with hk
  have value := highPoints.value at n, f, i, k with *
  rw value
  have gridFunction := gridPoint.function at k, n with *
  have selected := highPoint.selected at n, f, k, i with *
  exact FunctionBetween.apply_closed with gridFunction, selected.left

-- The low and high points stay within one grid width of the cell's base
-- point in every coordinate.
theorem lowPoints.close (n : Nat) (f i k j : Set)
  requires hi : i ∈ n
  requires hk : k ∈ ℕ
  requires hj : j ∈ n
  shows dist(lowPoints(n, f, i)(k)(j), basePoints(n, f)(k)(j)) ≤ (dyadicRadius(k):R)
proof
  have kNat := nat.omega.backward with hk
  have lowValue := lowPoints.value at n, f, i, k with *
  have baseValue := basePoints.value at n, f, k with *
  rw [lowValue, baseValue]
  have selected := lowPoint.selected at n, f, k, i with *
  have uIn := selected.left
  have cell := selected.right.left with hj
  have baseIn := kuhnCell.grid at n, f, k
  have gridU := gridPoint.coordinate with uIn, hj
  have gridB := gridPoint.coordinate with baseIn, hj
  rw [gridU, gridB]
  have uFunction := functionSpace.membership.forward with uIn
  have bFunction := functionSpace.membership.forward with baseIn
  have close := scaledPoint.close with bFunction, uFunction, hj, cell.left, cell.right
  have uValue := scaledPoint.value at k, n, lowPoint(n, f, k, i), j with *
  have bValue := scaledPoint.value at k, n, kuhnCell(n, f, k), j with *
  rwa [uValue, bValue] at close

theorem highPoints.close (n : Nat) (f i k j : Set)
  requires hi : i ∈ n
  requires hk : k ∈ ℕ
  requires hj : j ∈ n
  shows dist(highPoints(n, f, i)(k)(j), basePoints(n, f)(k)(j)) ≤ (dyadicRadius(k):R)
proof
  have kNat := nat.omega.backward with hk
  have highValue := highPoints.value at n, f, i, k with *
  have baseValue := basePoints.value at n, f, k with *
  rw [highValue, baseValue]
  have selected := highPoint.selected at n, f, k, i with *
  have vIn := selected.left
  have cell := selected.right.left with hj
  have baseIn := kuhnCell.grid at n, f, k
  have gridV := gridPoint.coordinate with vIn, hj
  have gridB := gridPoint.coordinate with baseIn, hj
  rw [gridV, gridB]
  have vFunction := functionSpace.membership.forward with vIn
  have bFunction := functionSpace.membership.forward with baseIn
  have close := scaledPoint.close with bFunction, vFunction, hj, cell.left, cell.right
  have vValue := scaledPoint.value at k, n, highPoint(n, f, k, i), j with *
  have bValue := scaledPoint.value at k, n, kuhnCell(n, f, k), j with *
  rwa [vValue, bValue] at close

-- Along a subsequence on which the base points converge, so do the low and
-- high points, since the grid widths shrink to nothing.
theorem closePoints.converges (n : Nat) (Y X s L j : Set)
  requires ySequence : PointSequence(Y, n)
  requires xSequence : PointSequence(X, n)
  requires yCube : ∀ k ∈ ℕ, Y(k) ∈ unitCube(n)
  requires increasing : StrictlyIncreasingNat(s)
  requires hj : j ∈ n
  requires LReal : L ∈ ℝ
  requires close : ∀ k ∈ ℕ, dist(Y(k)(j), X(k)(j)) ≤ (dyadicRadius(k):R)
  requires converges : ConvergesTo(coordinateSequence(pointSubsequence(X, n, s), n, j), L)
  shows ConvergesTo(coordinateSequence(pointSubsequence(Y, n, s), n, j), L)
proof
  have xSub := pointSubsequence.sequence with xSequence, increasing
  have ySub := pointSubsequence.sequence with ySequence, increasing
  have u := coordinateSequence.sequence with xSub, hj
  have v := coordinateSequence.sequence with ySub, hj
  have sFunction := increasing.left
  apply ConvergesTo.of_asymptotically_close with converges
  unfold AsymptoticallyClose
  refine ⟨u, v, ?_⟩
  intros E EIn Epos
  obtain ⟨N, NIn, tail⟩ := dyadicRadii.eventually_below with Epos
  witness N
  constructor
  . exact NIn
  . intros m hm bound
    have mNat := nat.omega.backward with hm
    have NNat := nat.omega.backward with NIn
    have index := StrictlyIncreasingNat.index_le_value at s, m with increasing
    have sm := FunctionBetween.apply_closed with sFunction, hm
    have smNat := nat.omega.backward with sm
    have far : N ≤ s(m) by arith
    have small := tail with sm, far
    have vValue := coordinateSequence.value at pointSubsequence(Y, n, s), n, j, m with ySub, hj
    have uValue := coordinateSequence.value at pointSubsequence(X, n, s), n, j, m with xSub, hj
    have ySubValue := pointSubsequence.value with ySequence, increasing, hm
    have xSubValue := pointSubsequence.value with xSequence, increasing, hm
    rw [vValue, uValue, ySubValue, xSubValue]
    have near := close with sm
    have yIn := yCube with sm
    have yReal := unitCube.coordinate_real with yIn, hj
    have xPoint := PointSequence.point with xSequence, sm
    have xReal := FunctionBetween.apply_closed with xPoint, hj
    apply openBall.membership.backward
    constructor
    . exact yReal
    . linarith

theorem lowPoints.coordinate (n : Nat) (f i s m j : Set)
  requires hi : i ∈ n
  requires increasing : StrictlyIncreasingNat(s)
  requires hm : m ∈ ℕ
  requires hj : j ∈ n
  shows coordinateSequence(pointSubsequence(lowPoints(n, f, i), n, s), n, j)(m) = scaledPoint(s(m), n, lowPoint(n, f, s(m), i))(j)
proof
  have lowSeq := lowPoints.sequence at n, f, i with hi
  have lowSub := pointSubsequence.sequence with lowSeq, increasing
  have sm := FunctionBetween.apply_closed with increasing.left, hm
  have smNat := nat.omega.backward with sm
  have value := coordinateSequence.value at pointSubsequence(lowPoints(n, f, i), n, s), n, j, m with lowSub, hj
  have subValue := pointSubsequence.value with lowSeq, increasing, hm
  have lowValue := lowPoints.value at n, f, i, s(m) with *
  rw [value, subValue, lowValue]
  have selected := lowPoint.selected at n, f, s(m), i with *
  have gridValue := gridPoint.value at s(m), n, lowPoint(n, f, s(m), i) with *
  rw gridValue
  rfl

theorem highPoints.coordinate (n : Nat) (f i s m j : Set)
  requires hi : i ∈ n
  requires increasing : StrictlyIncreasingNat(s)
  requires hm : m ∈ ℕ
  requires hj : j ∈ n
  shows coordinateSequence(pointSubsequence(highPoints(n, f, i), n, s), n, j)(m) = scaledPoint(s(m), n, highPoint(n, f, s(m), i))(j)
proof
  have highSeq := highPoints.sequence at n, f, i with hi
  have highSub := pointSubsequence.sequence with highSeq, increasing
  have sm := FunctionBetween.apply_closed with increasing.left, hm
  have smNat := nat.omega.backward with sm
  have value := coordinateSequence.value at pointSubsequence(highPoints(n, f, i), n, s), n, j, m with highSub, hj
  have subValue := pointSubsequence.value with highSeq, increasing, hm
  have highValue := highPoints.value at n, f, i, s(m) with *
  rw [value, subValue, highValue]
  have selected := highPoint.selected at n, f, s(m), i with *
  have gridValue := gridPoint.value at s(m), n, highPoint(n, f, s(m), i) with *
  rw gridValue
  rfl

theorem imageSequence.coordinate (n : Nat) (f Y s m j : Set)
  requires map : CubeMap(f, n)
  requires ySequence : PointSequence(Y, n)
  requires yCube : ∀ k ∈ ℕ, Y(k) ∈ unitCube(n)
  requires increasing : StrictlyIncreasingNat(s)
  requires hm : m ∈ ℕ
  requires hj : j ∈ n
  shows coordinateSequence(imageSequence(f, pointSubsequence(Y, n, s), n), n, j)(m) = f(Y(s(m)))(j)
proof
  have ySub := pointSubsequence.sequence with ySequence, increasing
  have subCube : ∀ k ∈ ℕ, pointSubsequence(Y, n, s)(k) ∈ unitCube(n)
    intros k hk
    have subValue := pointSubsequence.value with ySequence, increasing, hk
    rw subValue
    exact yCube with (FunctionBetween.apply_closed with increasing.left, hk)
  have imageSeq := imageSequence.sequence with map, ySub, subCube
  have value := coordinateSequence.value at imageSequence(f, pointSubsequence(Y, n, s), n), n, j, m with imageSeq, hj
  have imageValue := imageSequence.value with map, ySub, subCube, hm
  have subValue := pointSubsequence.value with ySequence, increasing, hm
  rw [value, imageValue, subValue]
  rfl

-- Brouwer's fixed point theorem for the cube.
theorem brouwer.cube (n : Nat) (f : Set)
  requires continuous : CubeContinuous(f, n)
  shows ∃ x ∈ unitCube(n), f(x) = x
proof
  have map := continuous.left
  have fFunction := CubeMap.function with map
  have baseSeq := basePoints.sequence at n, f
  have baseCube : ∀ k ∈ ℕ, basePoints(n, f)(k) ∈ unitCube(n)
    intros k hk
    exact basePoints.in_cube with hk
  obtain ⟨s, increasing, x, xIn, limits⟩ := unitCube.bolzano_weierstrass with baseSeq, baseCube
  have xFunction := unitCube.point with xIn
  have fxIn := FunctionBetween.apply_closed with fFunction, xIn
  have fxFunction := unitCube.point with fxIn
  witness x
  constructor
  . exact xIn
  . apply FunctionBetween.ext with fxFunction, xFunction
    intros i hi
    have xiReal := FunctionBetween.apply_closed with xFunction, hi
    have fxiReal := FunctionBetween.apply_closed with fxFunction, hi
    have lowSeq := lowPoints.sequence at n, f, i with hi
    have lowCube : ∀ k ∈ ℕ, lowPoints(n, f, i)(k) ∈ unitCube(n)
      intros k hk
      exact lowPoints.in_cube with hi, hk
    have lowSub := pointSubsequence.sequence with lowSeq, increasing
    have lowSubCube : ∀ k ∈ ℕ, pointSubsequence(lowPoints(n, f, i), n, s)(k) ∈ unitCube(n)
      intros k hk
      have subValue := pointSubsequence.value with lowSeq, increasing, hk
      rw subValue
      exact lowCube with (FunctionBetween.apply_closed with increasing.left, hk)
    have lowConverges : ∀ j ∈ n, ConvergesTo(coordinateSequence(pointSubsequence(lowPoints(n, f, i), n, s), n, j), x(j))
      intros j hj
      have xjReal := FunctionBetween.apply_closed with xFunction, hj
      have close : ∀ k ∈ ℕ, dist(lowPoints(n, f, i)(k)(j), basePoints(n, f)(k)(j)) ≤ (dyadicRadius(k):R)
        intros k hk
        exact lowPoints.close with hi, hk, hj
      exact closePoints.converges with lowSeq, baseSeq, lowCube, increasing, hj, xjReal, close, (limits with hj)
    have imageLow := CubeContinuous.sequential with continuous, lowSub, lowSubCube, xIn, lowConverges
    have lowLimit := lowConverges with hi
    have imageLowLimit := imageLow with hi
    have lowOrdered : PointwiseLE(coordinateSequence(pointSubsequence(lowPoints(n, f, i), n, s), n, i), coordinateSequence(imageSequence(f, pointSubsequence(lowPoints(n, f, i), n, s), n), n, i))
      unfold PointwiseLE
      intros m hm
      have sm := FunctionBetween.apply_closed with increasing.left, hm
      have smNat := nat.omega.backward with sm
      have left := lowPoints.coordinate at n, f, i, s, m, i with hi, increasing, hm, hi
      have right := imageSequence.coordinate with map, lowSeq, lowCube, increasing, hm, hi
      have lowValue := lowPoints.value at n, f, i, s(m) with *
      rw [left, right, lowValue]
      have selected := lowPoint.selected at n, f, s(m), i with *
      have le := gridLabels.low_le with map, selected.left, hi, selected.right.right
      exact realLe.characterization.forward with le
    have lower := ConvergesTo.le_of_le_terms with lowLimit, imageLowLimit, lowOrdered
    have highSeq := highPoints.sequence at n, f, i with hi
    have highCube : ∀ k ∈ ℕ, highPoints(n, f, i)(k) ∈ unitCube(n)
      intros k hk
      exact highPoints.in_cube with hi, hk
    have highSub := pointSubsequence.sequence with highSeq, increasing
    have highSubCube : ∀ k ∈ ℕ, pointSubsequence(highPoints(n, f, i), n, s)(k) ∈ unitCube(n)
      intros k hk
      have subValue := pointSubsequence.value with highSeq, increasing, hk
      rw subValue
      exact highCube with (FunctionBetween.apply_closed with increasing.left, hk)
    have highConverges : ∀ j ∈ n, ConvergesTo(coordinateSequence(pointSubsequence(highPoints(n, f, i), n, s), n, j), x(j))
      intros j hj
      have xjReal := FunctionBetween.apply_closed with xFunction, hj
      have close : ∀ k ∈ ℕ, dist(highPoints(n, f, i)(k)(j), basePoints(n, f)(k)(j)) ≤ (dyadicRadius(k):R)
        intros k hk
        exact highPoints.close with hi, hk, hj
      exact closePoints.converges with highSeq, baseSeq, highCube, increasing, hj, xjReal, close, (limits with hj)
    have imageHigh := CubeContinuous.sequential with continuous, highSub, highSubCube, xIn, highConverges
    have highLimit := highConverges with hi
    have imageHighLimit := imageHigh with hi
    have highOrdered : PointwiseLE(coordinateSequence(imageSequence(f, pointSubsequence(highPoints(n, f, i), n, s), n), n, i), coordinateSequence(pointSubsequence(highPoints(n, f, i), n, s), n, i))
      unfold PointwiseLE
      intros m hm
      have sm := FunctionBetween.apply_closed with increasing.left, hm
      have smNat := nat.omega.backward with sm
      have left := highPoints.coordinate at n, f, i, s, m, i with hi, increasing, hm, hi
      have right := imageSequence.coordinate with map, highSeq, highCube, increasing, hm, hi
      have highValue := highPoints.value at n, f, i, s(m) with *
      rw [left, right, highValue]
      have selected := highPoint.selected at n, f, s(m), i with *
      have ge := gridLabels.high_ge with map, selected.left, hi, selected.right.right
      exact realLe.characterization.forward with ge
    have upper := ConvergesTo.le_of_le_terms with imageHighLimit, highLimit, highOrdered
    have upperLe := realLe.characterization.forward with upper
    have lowerLe := realLe.characterization.forward with lower
    exact RealLe.antisymmetric with upperLe, lowerLe
