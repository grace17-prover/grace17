-- Blocks of coordinates, their sums, the product of simplices cut out of the
-- cube by asking every block sum to be one, and the two continuous
-- corrections, max(0, 1 − s) and max(1, s), applied to a block sum s
-- Part of Cumulus, the Grace17 mathematics library.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module Grace.Cumulus.FixedPoint.BlockSimplex
import BlockSums

-- The coordinates that the block map blk sends to p.
def blockSet (n blk p : Set) : Set := { i ∈ n | blk(i) = p }

theorem blockSet.membership (n blk p i : Set)
  shows i ∈ blockSet(n, blk, p) ↔ i ∈ n ∧ blk(i) = p
proof
  simp [blockSet]

theorem blockSet.own (n blk j : Set)
  requires hj : j ∈ n
  shows j ∈ blockSet(n, blk, blk(j))
proof
  apply blockSet.membership.backward
  exact ⟨hj, rfl⟩

-- The sum of the coordinates in block p, as a cube function.
def blockSum (n blk p : Set) : Set := sumCube(n, blockSet(n, blk, p))

theorem blockSum.definition (n blk p : Set)
  shows sumCube(n, blockSet(n, blk, p)) = blockSum(n, blk, p)
proof
  unfold blockSum
  rfl

theorem blockSum.continuous (n : Nat) (blk p : Set)
  shows CubeFunctionContinuous(blockSum(n, blk, p), n)
proof
  have same := blockSum.definition at n, blk, p
  have continuous := sumCube.continuous at n, blockSet(n, blk, p)
  rwa same at continuous

theorem blockSum.function (n : Nat) (blk p : Set)
  shows CubeFunction(blockSum(n, blk, p), n)
proof
  exact CubeFunctionContinuous.function with (blockSum.continuous at n, blk, p)

theorem blockSum.real (n : Nat) (blk p x : Set)
  requires hx : x ∈ unitCube(n)
  shows blockSum(n, blk, p)(x) ∈ ℝ
proof
  exact CubeFunction.value with (blockSum.function at n, blk, p), hx

theorem blockSum.nonnegative (n : Nat) (blk p x : Set)
  requires hx : x ∈ unitCube(n)
  shows (0:R) ≤ (blockSum(n, blk, p)(x):R)
proof
  have same := blockSum.definition at n, blk, p
  have bound := sumCube.nonnegative at n, blockSet(n, blk, p), x with hx
  rwa same at bound

theorem blockSum.ge_coordinate (n : Nat) (blk x j : Set)
  requires hx : x ∈ unitCube(n)
  requires hj : j ∈ n
  shows (x(j):R) ≤ (blockSum(n, blk, blk(j))(x):R)
proof
  have same := blockSum.definition at n, blk, blk(j)
  have inBlock := blockSet.own at n, blk, j with hj
  have bound := sumCube.ge_coordinate with hx, hj, inBlock
  rwa same at bound

-- The product of simplices: the points of the cube whose block sums are one.
def simplexProduct (n m blk : Set) : Set :=
  { x ∈ unitCube(n) | ∀ p ∈ m, blockSum(n, blk, p)(x) = (1:R) }

theorem simplexProduct.membership (n m blk x : Set)
  shows x ∈ simplexProduct(n, m, blk) ↔ x ∈ unitCube(n) ∧ ∀ p ∈ m, blockSum(n, blk, p)(x) = (1:R)
proof
  simp [simplexProduct]

theorem simplexProduct.cube (n m blk x : Set)
  requires hx : x ∈ simplexProduct(n, m, blk)
  shows x ∈ unitCube(n)
proof
  have parts := simplexProduct.membership.forward with hx
  exact parts.left

theorem simplexProduct.block_sum (n m blk x p : Set)
  requires hx : x ∈ simplexProduct(n, m, blk)
  requires hp : p ∈ m
  shows blockSum(n, blk, p)(x) = (1:R)
proof
  have parts := simplexProduct.membership.forward with hx
  exact parts.right with hp

-- The shortfall of a block sum below one, and the block sum capped below by one.
def excessCube (n blk p : Set) : Set :=
  maxCube(n, constantFunction(unitCube(n), ℝ, (0:R)), addCube(n, constantFunction(unitCube(n), ℝ, (1:R)), negCube(n, blockSum(n, blk, p))))

def scaleCube (n blk p : Set) : Set :=
  maxCube(n, constantFunction(unitCube(n), ℝ, (1:R)), blockSum(n, blk, p))

theorem excessCube.definition (n blk p : Set)
  shows excessCube(n, blk, p) = maxCube(n, constantFunction(unitCube(n), ℝ, (0:R)), addCube(n, constantFunction(unitCube(n), ℝ, (1:R)), negCube(n, blockSum(n, blk, p))))
proof
  unfold excessCube
  rfl

theorem scaleCube.definition (n blk p : Set)
  shows scaleCube(n, blk, p) = maxCube(n, constantFunction(unitCube(n), ℝ, (1:R)), blockSum(n, blk, p))
proof
  unfold scaleCube
  rfl

theorem excessCube.continuous (n : Nat) (blk p : Set)
  shows CubeFunctionContinuous(excessCube(n, blk, p), n)
proof
  have zeroIn : (0:R) ∈ ℝ by typecheck
  have oneIn : (1:R) ∈ ℝ by typecheck
  have zero := constantCube.continuous with zeroIn
  have one := constantCube.continuous with oneIn
  have sum := blockSum.continuous at n, blk, p
  have negative := negCube.continuous with sum
  have shifted := addCube.continuous with one, negative
  have same := excessCube.definition at n, blk, p
  rw same
  exact maxCube.continuous with zero, shifted

theorem scaleCube.continuous (n : Nat) (blk p : Set)
  shows CubeFunctionContinuous(scaleCube(n, blk, p), n)
proof
  have oneIn : (1:R) ∈ ℝ by typecheck
  have one := constantCube.continuous with oneIn
  have sum := blockSum.continuous at n, blk, p
  have same := scaleCube.definition at n, blk, p
  rw same
  exact maxCube.continuous with one, sum

theorem excessCube.value (n : Nat) (blk p x : Set)
  requires hx : x ∈ unitCube(n)
  shows excessCube(n, blk, p)(x) = realMax((0:R), (1:R) + -(blockSum(n, blk, p)(x):R))
proof
  have zeroIn : (0:R) ∈ ℝ by typecheck
  have oneIn : (1:R) ∈ ℝ by typecheck
  have zero := constantCube.continuous with zeroIn
  have one := constantCube.continuous with oneIn
  have sum := blockSum.continuous at n, blk, p
  have negative := negCube.continuous with sum
  have shifted := addCube.continuous with one, negative
  have zeroFunction := CubeFunctionContinuous.function with zero
  have oneFunction := CubeFunctionContinuous.function with one
  have sumFunction := CubeFunctionContinuous.function with sum
  have negativeFunction := CubeFunctionContinuous.function with negative
  have shiftedFunction := CubeFunctionContinuous.function with shifted
  have same := excessCube.definition at n, blk, p
  have maxValue := maxCube.value with zeroFunction, shiftedFunction, hx
  have zeroValue := constantFunction.apply at unitCube(n), ℝ, x, (0:R) with hx
  have oneValue := constantFunction.apply at unitCube(n), ℝ, x, (1:R) with hx
  have shiftedValue := addCube.value with oneFunction, negativeFunction, hx
  have negativeValue := negCube.value with sumFunction, hx
  rw [same, maxValue, zeroValue, shiftedValue, oneValue, negativeValue]
  rfl

theorem scaleCube.value (n : Nat) (blk p x : Set)
  requires hx : x ∈ unitCube(n)
  shows scaleCube(n, blk, p)(x) = realMax((1:R), (blockSum(n, blk, p)(x):R))
proof
  have oneIn : (1:R) ∈ ℝ by typecheck
  have one := constantCube.continuous with oneIn
  have oneFunction := CubeFunctionContinuous.function with one
  have sumFunction := blockSum.function at n, blk, p
  have same := scaleCube.definition at n, blk, p
  have maxValue := maxCube.value with oneFunction, sumFunction, hx
  have oneValue := constantFunction.apply at unitCube(n), ℝ, x, (1:R) with hx
  rw [same, maxValue, oneValue]
  rfl

-- The two corrections are nonnegative, the scale is at least one, and a block
-- sum plus its shortfall is exactly the scale.
theorem realMax.excess (S : Real)
  shows S + realMax((0:R), (1:R) + -S) = realMax((1:R), S)
proof
  have alternatives : (1:R) ≤ S ∨ ¬(1:R) ≤ S by tauto
  cases alternatives with atLeastOne | below
  . have shortfall : (1:R) + -S ≤ (0:R) by linarith
    have excessZero := realMax.of_le with shortfall
    have scaleS := realMax.of_ge with atLeastOne
    rw [excessZero, scaleS]
    linarith
  . have notLess : ¬((1:R) < S)
      intro less
      apply below
      exact realLess.implies_le with less
    have atMostOne := realLe.of_not_less with notLess
    have shortfall : (0:R) ≤ (1:R) + -S by linarith
    have excessShortfall := realMax.of_ge with shortfall
    have scaleOne := realMax.of_le with atMostOne
    rw [excessShortfall, scaleOne]
    linarith

theorem excessCube.nonnegative (n : Nat) (blk p x : Set)
  requires hx : x ∈ unitCube(n)
  shows (0:R) ≤ (excessCube(n, blk, p)(x):R)
proof
  have value := excessCube.value at n, blk, p, x with hx
  rw value
  exact realMax.ge_left

theorem scaleCube.at_least_one (n : Nat) (blk p x : Set)
  requires hx : x ∈ unitCube(n)
  shows (1:R) ≤ (scaleCube(n, blk, p)(x):R)
proof
  have value := scaleCube.value at n, blk, p, x with hx
  rw value
  exact realMax.ge_left

theorem scaleCube.ge_sum (n : Nat) (blk p x : Set)
  requires hx : x ∈ unitCube(n)
  shows (blockSum(n, blk, p)(x):R) ≤ (scaleCube(n, blk, p)(x):R)
proof
  have value := scaleCube.value at n, blk, p, x with hx
  rw value
  exact realMax.ge_right

theorem scaleCube.sum_excess (n : Nat) (blk p x : Set)
  requires hx : x ∈ unitCube(n)
  shows (blockSum(n, blk, p)(x):R) + (excessCube(n, blk, p)(x):R) = scaleCube(n, blk, p)(x)
proof
  have excessValue := excessCube.value at n, blk, p, x with hx
  have scaleValue := scaleCube.value at n, blk, p, x with hx
  rw [excessValue, scaleValue]
  exact realMax.excess

theorem scaleCube.real (n : Nat) (blk p x : Set)
  requires hx : x ∈ unitCube(n)
  shows scaleCube(n, blk, p)(x) ∈ ℝ
proof
  exact CubeFunction.value with (CubeFunctionContinuous.function with (scaleCube.continuous at n, blk, p)), hx

theorem excessCube.real (n : Nat) (blk p x : Set)
  requires hx : x ∈ unitCube(n)
  shows excessCube(n, blk, p)(x) ∈ ℝ
proof
  exact CubeFunction.value with (CubeFunctionContinuous.function with (excessCube.continuous at n, blk, p)), hx
