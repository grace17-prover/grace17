-- Block sums of a family of cube functions: continuity, nonnegativity, the
-- bound of a sum by any of its terms, sums of vanishing terms, and how the
-- block sum of a point changes when a common real shift is scaled
-- Part of Cumulus, the Grace17 mathematics library.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module Grace.Cumulus.FixedPoint.WeightedSums
import BlockSums

-- Sums over the first m coordinates of S of the values W(i)(x).
defgraph prefixWeighted (n S W m : Set) (x ∈ unitCube(n)) : ℝ := realPartialSum(maskedPoint(n, S, assembledPoint(n, W, x)), m)
requires nNat : Nat(n)
requires mNat : Nat(m)
requires functions : ∀ i ∈ n, CubeFunction(W(i), n)
proof
  have values := assembledPoint.function at n, W, x with functions, member
  have sequence := maskedPoint.sequence at n, S, assembledPoint(n, W, x) with values
  exact realPartialSum.real at maskedPoint(n, S, assembledPoint(n, W, x)), m with sequence

theorem prefixWeighted.continuous (n : Nat) (S W : Set) (m : Nat)
  requires family : ∀ i ∈ n, CubeFunctionContinuous(W(i), n)
  shows m ∈ succ(n) → CubeFunctionContinuous(prefixWeighted(n, S, W, m), n)
proof
  induction m
  | zero =>
    intro hm
    have functions : ∀ i ∈ n, CubeFunction(W(i), n)
      intros i hi
      exact CubeFunctionContinuous.function with (family with hi)
    have zeroIn : (0:R) ∈ ℝ by typecheck
    have constant := constantCube.continuous at n, (0:R) with zeroIn
    have function : CubeFunction(prefixWeighted(n, S, W, 0), n)
      exact prefixWeighted.function at n, S, W, 0 with *
    apply CubeFunctionContinuous.congr with function, constant
    intros x hx
    have value := prefixWeighted.value at n, S, W, 0, x with *
    have constantValue := constantFunction.apply at unitCube(n), ℝ, x, (0:R) with hx, zeroIn
    rw [value, constantValue]
    exact realPartialSum.zero at maskedPoint(n, S, assembledPoint(n, W, x))
  | succ(j) using ih =>
    intro hm
    have functions : ∀ i ∈ n, CubeFunction(W(i), n)
      intros i hi
      exact CubeFunctionContinuous.function with (family with hi)
    have jNat : Nat(j) by typecheck
    have jIn : j ∈ succ(n)
      have less := Less.of_membership with hm
      have below : j < succ(n) by arith
      exact membership.of_Less with below
    have jInN : j ∈ n
      have less := Less.of_membership with hm
      have below : j < n by arith
      exact membership.of_Less with below
    have previous := ih with jIn
    have weightNat := indicator.natural at S, j
    have weightReal := realNat.real at indicator(S, j)
    have weightIn : (realNat(indicator(S, j)):R) ∈ ℝ by typecheck
    have constant := constantCube.continuous at n, (realNat(indicator(S, j)):R) with weightIn
    have component := family with jInN
    have term := mulCube.continuous with constant, component
    have total := addCube.continuous with previous, term
    have function : CubeFunction(prefixWeighted(n, S, W, succ(j)), n)
      exact prefixWeighted.function at n, S, W, succ(j) with *
    apply CubeFunctionContinuous.congr with function, total
    intros x hx
    have values := assembledPoint.function at n, W, x with functions, hx
    have previousFunction := CubeFunctionContinuous.function with previous
    have termFunction := CubeFunctionContinuous.function with term
    have constantFunction2 := CubeFunctionContinuous.function with constant
    have componentFunction := CubeFunctionContinuous.function with component
    have value := prefixWeighted.value at n, S, W, succ(j), x with *
    have previousValue := prefixWeighted.value at n, S, W, j, x with *
    have sumValue := addCube.value at n, prefixWeighted(n, S, W, j), mulCube(n, constantFunction(unitCube(n), ℝ, (realNat(indicator(S, j)):R)), W(j)), x with previousFunction, termFunction, hx
    have termValue := mulCube.value at n, constantFunction(unitCube(n), ℝ, (realNat(indicator(S, j)):R)), W(j), x with constantFunction2, componentFunction, hx
    have constantValue := constantFunction.apply at unitCube(n), ℝ, x, (realNat(indicator(S, j)):R) with hx, weightIn
    have componentValue := assembledPoint.value at n, W, x, j with functions, hx, jInN
    have step := realPartialSum.succ at maskedPoint(n, S, assembledPoint(n, W, x)), j
    have masked := maskedPoint.coordinate at n, S, assembledPoint(n, W, x), j with values, jInN
    have sequence := maskedPoint.sequence at n, S, assembledPoint(n, W, x) with values
    have componentReal := CubeFunction.value with componentFunction, hx
    rw [value, sumValue, previousValue, termValue, constantValue, step, masked, componentValue]
    linarith

-- The block sum of the family over S.
def weightedSum (n S W : Set) : Set := prefixWeighted(n, S, W, n)

theorem weightedSum.definition (n S W : Set)
  shows weightedSum(n, S, W) = prefixWeighted(n, S, W, n)
proof
  unfold weightedSum
  rfl

theorem weightedSum.continuous (n : Nat) (S W : Set)
  requires family : ∀ i ∈ n, CubeFunctionContinuous(W(i), n)
  shows CubeFunctionContinuous(weightedSum(n, S, W), n)
proof
  have all := prefixWeighted.continuous at n, S, W, n with family
  have same := weightedSum.definition at n, S, W
  rw same
  exact all with (bootstrap.succ.self at n)

theorem weightedSum.function (n : Nat) (S W : Set)
  requires functions : ∀ i ∈ n, CubeFunction(W(i), n)
  shows CubeFunction(weightedSum(n, S, W), n)
proof
  have same := weightedSum.definition at n, S, W
  rw same
  exact prefixWeighted.function at n, S, W, n with *

theorem weightedSum.value (n : Nat) (S W x : Set)
  requires functions : ∀ i ∈ n, CubeFunction(W(i), n)
  requires hx : x ∈ unitCube(n)
  shows weightedSum(n, S, W)(x) = realPartialSum(maskedPoint(n, S, assembledPoint(n, W, x)), n)
proof
  have same := weightedSum.definition at n, S, W
  rw same
  exact prefixWeighted.value at n, S, W, n, x with *

theorem weightedSum.real (n : Nat) (S W x : Set)
  requires functions : ∀ i ∈ n, CubeFunction(W(i), n)
  requires hx : x ∈ unitCube(n)
  shows weightedSum(n, S, W)(x) ∈ ℝ
proof
  exact CubeFunction.value with (weightedSum.function at n, S, W with functions), hx

-- Masked terms of a nonnegative family are nonnegative.
theorem maskedPoint.nonnegative_of (n : Nat) (S w k : Set)
  requires wFunction : w : n → ℝ
  requires hk : k ∈ n
  requires nonnegative : (0:R) ≤ (w(k):R)
  shows (0:R) ≤ (maskedPoint(n, S, w)(k):R)
proof
  have alternatives : k ∈ S ∨ ¬k ∈ S by tauto
  cases alternatives with inBlock | outside
  . have same := maskedPoint.on_block with wFunction, hk, inBlock
    rwa same
  . have same := maskedPoint.off_block with wFunction, hk, outside
    rw same
    linarith

theorem weightedSum.terms_nonnegative (n : Nat) (S W x : Set)
  requires functions : ∀ i ∈ n, CubeFunction(W(i), n)
  requires hx : x ∈ unitCube(n)
  requires nonnegative : ∀ i ∈ n, (0:R) ≤ (W(i)(x):R)
  shows ∀ k ∈ n, (0:R) ≤ (maskedPoint(n, S, assembledPoint(n, W, x))(k):R)
proof
  intros k hk
  have values := assembledPoint.function with functions, hx
  have value := assembledPoint.value with functions, hx, hk
  have bound := nonnegative with hk
  have termNonneg : (0:R) ≤ (assembledPoint(n, W, x)(k):R) by rwa value
  exact maskedPoint.nonnegative_of with values, hk, termNonneg

theorem weightedSum.nonnegative (n : Nat) (S W x : Set)
  requires functions : ∀ i ∈ n, CubeFunction(W(i), n)
  requires hx : x ∈ unitCube(n)
  requires nonnegative : ∀ i ∈ n, (0:R) ≤ (W(i)(x):R)
  shows (0:R) ≤ (weightedSum(n, S, W)(x):R)
proof
  have values := assembledPoint.function with functions, hx
  have sequence := maskedPoint.sequence at n, S, assembledPoint(n, W, x) with values
  have value := weightedSum.value at n, S, W, x with functions, hx
  have terms := weightedSum.terms_nonnegative at n, S, W, x with functions, hx, nonnegative
  have bound := realPartialSum.nonnegative_prefix with sequence
  rw value
  exact bound with terms

theorem weightedSum.ge_term (n : Nat) (S W x j : Set)
  requires functions : ∀ i ∈ n, CubeFunction(W(i), n)
  requires hx : x ∈ unitCube(n)
  requires nonnegative : ∀ i ∈ n, (0:R) ≤ (W(i)(x):R)
  requires hj : j ∈ n
  requires inBlock : j ∈ S
  shows (W(j)(x):R) ≤ (weightedSum(n, S, W)(x):R)
proof
  have values := assembledPoint.function with functions, hx
  have sequence := maskedPoint.sequence at n, S, assembledPoint(n, W, x) with values
  have value := weightedSum.value at n, S, W, x with functions, hx
  have terms := weightedSum.terms_nonnegative at n, S, W, x with functions, hx, nonnegative
  have bounds := realPartialSum.term_le_prefix with sequence
  have forAll := bounds with terms
  have bound := forAll with hj
  have same := maskedPoint.on_block with values, hj, inBlock
  have component := assembledPoint.value with functions, hx, hj
  rw value
  rwa [same, component] at bound

-- A partial sum of vanishing terms vanishes.
theorem realPartialSum.zero_terms (u : Set) (m : Nat)
  requires sequence : RealSequence(u)
  shows (∀ k ∈ m, u(k) = (0:R)) → realPartialSum(u, m) = (0:R)
proof
  induction m
  | zero =>
    intro terms
    exact realPartialSum.zero at u
  | succ(j) using ih =>
    intro terms
    have jNat : Nat(j) by typecheck
    have last := terms with (bootstrap.succ.self at j)
    have smaller : ∀ k ∈ j, u(k) = (0:R)
      intros k hk
      have kNat := natural.member at j with hk
      have less := Less.of_membership with hk
      have below : k < succ(j) by arith
      have inSucc : k ∈ succ(j)
        exact membership.of_Less with below
      exact terms with inSucc
    have previous := ih with smaller
    have step := realPartialSum.succ at u, j
    have lastReal := RealSequence.value at u, j with sequence
    rw step
    linarith

-- When the selected coordinates of z are those of x shifted by a real
-- function w and scaled by C, so is the block sum.
theorem sumCube.scaled_sum (n : Nat) (S x z w : Set) (C : Real)
  requires hx : x ∈ unitCube(n)
  requires hz : z ∈ unitCube(n)
  requires wFunction : w : n → ℝ
  requires shifted : ∀ j ∈ n, j ∈ S → z(j) = ((x(j):R) + (w(j):R)) * C
  shows sumCube(n, S)(z) = ((sumCube(n, S)(x):R) + (realPartialSum(maskedPoint(n, S, w), n):R)) * C
proof
  have xFunction := unitCube.point with hx
  have zFunction := unitCube.point with hz
  have maskedX := maskedPoint.sequence at n, S, x with xFunction
  have maskedW := maskedPoint.sequence at n, S, w with wFunction
  have maskedZ := maskedPoint.sequence at n, S, z with zFunction
  have constantC := constantSequence.sequence at C
  have inner := addSequence.sequence with maskedX, maskedW
  have agree : ∀ k ∈ ℕ, k < n → maskedPoint(n, S, z)(k) = mulSequence(constantSequence(C), addSequence(maskedPoint(n, S, x), maskedPoint(n, S, w)))(k)
    intros k hk hkn
    have kNat : Nat(k) by typecheck
    have hkIn : k ∈ n by exact membership.of_Less with hkn
    have xReal := RealSequence.value at maskedPoint(n, S, x), k with maskedX
    have wReal := RealSequence.value at maskedPoint(n, S, w), k with maskedW
    have cReal := RealSequence.value at constantSequence(C), k with constantC
    have cValue := constantSequence.value at C, k
    have innerValue := addSequence.value with maskedX, maskedW, xReal, wReal
    have innerReal := RealSequence.value at addSequence(maskedPoint(n, S, x), maskedPoint(n, S, w)), k with inner
    have outerValue := mulSequence.value with constantC, inner, cReal, innerReal
    rw [outerValue, innerValue, cValue]
    have alternatives : k ∈ S ∨ ¬k ∈ S by tauto
    cases alternatives with inBlock | outside
    . have zSame := maskedPoint.on_block with zFunction, hkIn, inBlock
      have xSame := maskedPoint.on_block with xFunction, hkIn, inBlock
      have wSame := maskedPoint.on_block with wFunction, hkIn, inBlock
      have zValue := shifted with hkIn, inBlock
      have xk := unitCube.coordinate_real with hx, hkIn
      have wk := FunctionBetween.apply_closed with wFunction, hkIn
      rw [zSame, xSame, wSame, zValue]
      ring
    . have zSame := maskedPoint.off_block with zFunction, hkIn, outside
      have xSame := maskedPoint.off_block with xFunction, hkIn, outside
      have wSame := maskedPoint.off_block with wFunction, hkIn, outside
      rw [zSame, xSame, wSame]
      ring
  have outer := mulSequence.sequence with constantC, inner
  have equal := realPartialSum.eq_prefix with maskedZ, outer, agree
  have scaleC := realPartialSum.scale with inner
  have addXW := realPartialSum.add with maskedX, maskedW
  have zValue := sumCube.value at n, S, z with hz
  have xValue := sumCube.value at n, S, x with hx
  rw [zValue, xValue, equal, scaleC, addXW]
  ring
