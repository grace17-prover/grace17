-- Faces of Kuhn simplices on the boundary of the cube: a face lying on a
-- coordinate hyperplane x_j = 0 misses the top vertex, one lying on x_j = p
-- misses the bottom vertex, and in either case the simplex through the
-- face is unique
-- Part of Cumulus, the Grace17 mathematics library.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module Grace.Cumulus.FixedPoint.KuhnFaces
import KuhnNeighbour

theorem kuhnSimplex.zero_face_top (n : Nat) (base upd i j : Set)
  requires baseFunction : base : n → ℕ
  requires updBijective : BijectiveBetween(upd, n, n)
  requires hi : i ∈ succ(n)
  requires hj : j ∈ n
  requires flat : ∀ x ∈ kuhnSimplex(n, base, upd) ∖ {kuhnVertex(n, base, upd)(i)}, x(j) = 0
  shows i = n
proof
  have updInjective := Bijective.injective with updBijective
  have nIn := bootstrap.succ.self at n
  by_contra different
  have topMember := kuhnVertex.member at n, base, upd, n with baseFunction, nIn
  have topDifferent : kuhnVertex(n, base, upd)(n) ≠ kuhnVertex(n, base, upd)(i)
    intro equal
    have same := kuhnVertex.injective with baseFunction, updInjective, nIn, hi, equal
    apply different
    symm
    exact same
  have inFace : kuhnVertex(n, base, upd)(n) ∈ kuhnSimplex(n, base, upd) ∖ {kuhnVertex(n, base, upd)(i)}
    exact difference.singleton_membership.backward with ⟨topMember, topDifferent⟩
  have zero := flat with kuhnVertex(n, base, upd)(n), inFace
  have value := kuhnVertex.top_coordinate with baseFunction, updBijective, hj
  rw value at zero
  have baseValue := FunctionBetween.apply_closed with baseFunction, hj
  have baseNat := nat.omega.backward with baseValue
  arith

theorem kuhnSimplex.full_face_bottom (n p : Nat) (base upd i j : Set)
  requires baseFunction : base : n → ℕ
  requires updBijective : BijectiveBetween(upd, n, n)
  requires hi : i ∈ succ(n)
  requires hj : j ∈ n
  requires bound : base(j) < p
  requires flat : ∀ x ∈ kuhnSimplex(n, base, upd) ∖ {kuhnVertex(n, base, upd)(i)}, x(j) = p
  shows i = 0
proof
  have updInjective := Bijective.injective with updBijective
  have zeroNat : Nat(0) by typecheck
  have positive : 0 < succ(n) by arith
  have zeroIn := membership.of_Less with positive
  by_contra different
  have bottomMember := kuhnVertex.member at n, base, upd, 0 with baseFunction, zeroIn
  have bottomDifferent : kuhnVertex(n, base, upd)(0) ≠ kuhnVertex(n, base, upd)(i)
    intro equal
    have same := kuhnVertex.injective with baseFunction, updInjective, zeroIn, hi, equal
    apply different
    symm
    exact same
  have inFace : kuhnVertex(n, base, upd)(0) ∈ kuhnSimplex(n, base, upd) ∖ {kuhnVertex(n, base, upd)(i)}
    exact difference.singleton_membership.backward with ⟨bottomMember, bottomDifferent⟩
  have full := flat with kuhnVertex(n, base, upd)(0), inFace
  have value := kuhnVertex.zero_coordinate at n, base, upd, j with baseFunction, hj
  rw value at full
  have baseValue := FunctionBetween.apply_closed with baseFunction, hj
  have baseNat := nat.omega.backward with baseValue
  arith

-- Through a face on x_j = 0 or on x_j = p there is exactly one simplex.
theorem kuhnSimplex.zero_face_unique (n : Nat) (b u b2 u2 c j : Set)
  requires f1 : b : n → ℕ
  requires bij1 : BijectiveBetween(u, n, n)
  requires f2 : b2 : n → ℕ
  requires bij2 : BijectiveBetween(u2, n, n)
  requires positive : 0 ∈ n
  requires hj : j ∈ n
  requires flat : ∀ x ∈ kuhnSimplex(n, b, u) ∖ {kuhnVertex(n, b, u)(n)}, x(j) = 0
  requires hc : c ∈ kuhnSimplex(n, b2, u2)
  requires same : kuhnSimplex(n, b2, u2) ∖ {c} = kuhnSimplex(n, b, u) ∖ {kuhnVertex(n, b, u)(n)}
  shows kuhnSimplex(n, b2, u2) = kuhnSimplex(n, b, u)
proof
  obtain ⟨inSpace, k, hk, shape⟩ := kuhnSimplex.membership.forward with hc
  have flat2 : ∀ x ∈ kuhnSimplex(n, b2, u2) ∖ {kuhnVertex(n, b2, u2)(k)}, x(j) = 0
    rw under ← shape
    rwa under same
  have top := kuhnSimplex.zero_face_top with f2, bij2, hk, hj, flat2
  rw [shape, top] at same
  exact kuhnSimplex.eq_top with f2, bij2, f1, bij1, positive, same

theorem kuhnSimplex.full_face_unique (n p : Nat) (b u b2 u2 c j : Set)
  requires f1 : b : n → ℕ
  requires bij1 : BijectiveBetween(u, n, n)
  requires f2 : b2 : n → ℕ
  requires bij2 : BijectiveBetween(u2, n, n)
  requires positive : 0 ∈ n
  requires hj : j ∈ n
  requires bound2 : b2(j) < p
  requires flat : ∀ x ∈ kuhnSimplex(n, b, u) ∖ {kuhnVertex(n, b, u)(0)}, x(j) = p
  requires hc : c ∈ kuhnSimplex(n, b2, u2)
  requires same : kuhnSimplex(n, b2, u2) ∖ {c} = kuhnSimplex(n, b, u) ∖ {kuhnVertex(n, b, u)(0)}
  shows kuhnSimplex(n, b2, u2) = kuhnSimplex(n, b, u)
proof
  obtain ⟨inSpace, k, hk, shape⟩ := kuhnSimplex.membership.forward with hc
  have flat2 : ∀ x ∈ kuhnSimplex(n, b2, u2) ∖ {kuhnVertex(n, b2, u2)(k)}, x(j) = p
    rw under ← shape
    rwa under same
  have bottom := kuhnSimplex.full_face_bottom with f2, bij2, hk, hj, bound2, flat2
  rw [shape, bottom] at same
  exact kuhnSimplex.eq_bottom with f2, bij2, f1, bij1, positive, same
