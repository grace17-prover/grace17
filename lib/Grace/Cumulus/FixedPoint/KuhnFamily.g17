module Grace.Cumulus.FixedPoint.KuhnFamily
import KuhnTopFace
import Cardinal.FiniteSubsets

def kuhnSimplices (p n : Set) : Set :=
  { s ∈ 𝒫(functionSpace(n, succ(p))) | KuhnSimplex(p, n, s) }

theorem kuhnSimplices.membership (s p n : Set)
  shows s ∈ kuhnSimplices(p, n) ↔ s ∈ 𝒫(functionSpace(n, succ(p))) ∧ KuhnSimplex(p, n, s)
proof
  simp [kuhnSimplices]

-- Every vertex of a simplex is a function into {0, …, p}.
theorem kuhnVertex.into_cube (n p : Nat) (base upd i : Set)
  requires baseFunction : base : n → ℕ
  requires bounds : ∀ j ∈ n, base(j) < p
  requires hi : i ∈ succ(n)
  shows kuhnVertex(n, base, upd)(i) ∈ functionSpace(n, succ(p))
proof
  have function := kuhnVertex.function_on at n, base, upd, i with baseFunction, hi
  apply functionSpace.membership.backward
  apply FunctionBetween.codomain_of_values with function
  intros j hj
  have below := bounds with j, hj
  have bounded := kuhnVertex.bounded at n, base, upd, i, j, p with baseFunction, below, hi, hj
  have valueIn := FunctionBetween.apply_closed with function, hj
  have valueNat := nat.omega.backward with valueIn
  have strict : kuhnVertex(n, base, upd)(i)(j) < succ(p) by arith
  exact membership.of_Less with strict

theorem kuhnSimplex.in_family (n p : Nat) (base upd : Set)
  requires baseFunction : base : n → ℕ
  requires updBijective : BijectiveBetween(upd, n, n)
  requires bounds : ∀ j ∈ n, base(j) < p
  shows kuhnSimplex(n, base, upd) ∈ kuhnSimplices(p, n)
proof
  apply kuhnSimplices.membership.backward
  constructor
  . apply powerset.membership_iff.backward
    intros x hx
    obtain ⟨inSpace, i, hi, shape⟩ := kuhnSimplex.membership.forward with hx
    rw shape
    exact kuhnVertex.into_cube with baseFunction, bounds, hi
  . have baseIn : base ∈ functionSpace(n, ℕ) := functionSpace.membership.backward with baseFunction
    refine ⟨base, baseIn, bounds, upd, updBijective, rfl⟩

-- The rotation of a simplex stays in the cube as long as its bottom face does
-- not lie on the far wall x_{upd(0)} = p.
theorem kuhnSimplex.rotated_in_family (n p : Nat) (base upd : Set)
  requires baseFunction : base : n → ℕ
  requires updBijective : BijectiveBetween(upd, n, n)
  requires bounds : ∀ j ∈ n, base(j) < p
  requires positive : 0 ∈ n
  requires notFull : ∃ x ∈ kuhnSimplex(n, base, upd) ∖ {kuhnVertex(n, base, upd)(0)}, x(upd(0)) ≠ p
  shows kuhnSimplex(n, kuhnVertex(n, base, upd)(succ(0)), rotated(n, upd)) ∈ kuhnSimplices(p, n)
proof
  have updInjective := Bijective.injective with updBijective
  have updFunction := Injective.function with updInjective
  have jIn := FunctionBetween.apply_closed with updFunction, positive
  have zeroLess := Less.of_membership with positive
  have oneLess : succ(0) < succ(n) by arith
  have oneIn := membership.of_Less with oneLess
  have oneFunction := kuhnVertex.function_on at n, base, upd, succ(0) with baseFunction, oneIn
  have rotatedBijective := rotated.bijective with updBijective
  have oneBounds : ∀ j ∈ n, kuhnVertex(n, base, upd)(succ(0))(j) < p
    intros j hj
    have alternatives : j = upd(0) ∨ j ≠ upd(0) by tauto
    cases alternatives with same | different
    . obtain ⟨x, hx, apart⟩ := notFull
      have constant := kuhnSimplex.bottom_face_constant with baseFunction, updBijective, positive, hx
      rw constant at apart
      have below := bounds with jIn
      have bounded := kuhnVertex.bounded at n, base, upd, succ(0), upd(0), p with baseFunction, below, oneIn, jIn
      have valueIn := FunctionBetween.apply_closed with oneFunction, jIn
      have valueNat := nat.omega.backward with valueIn
      have strict : kuhnVertex(n, base, upd)(succ(0))(upd(0)) < succ(p) by arith
      have less := Less.of_successor_upper_ne with strict, apart
      rwa same
    . have value := kuhnVertex.coordinate_succ with baseFunction, updInjective, positive, hj
      have zeroValue := kuhnVertex.zero_coordinate at n, base, upd, j with baseFunction, hj
      have separated : upd(0) ≠ j
        intro equal
        apply different
        symm
        exact equal
      have zero := indicator.singleton_other with separated
      have baseNat := nat.omega.backward with (FunctionBetween.apply_closed with baseFunction, hj)
      have below := bounds with hj
      rw [value, zeroValue, zero]
      arith
  exact kuhnSimplex.in_family with oneFunction, rotatedBijective, oneBounds

-- The lowering of a simplex stays in the cube: its base is below the old one.
theorem kuhnSimplex.unrotated_in_family (n p : Nat) (base upd m : Set)
  requires baseFunction : base : n → ℕ
  requires updBijective : BijectiveBetween(upd, n, n)
  requires bounds : ∀ j ∈ n, base(j) < p
  requires hm : m ∈ n
  requires top : succ(m) = n
  requires rooted : 0 < base(upd(m))
  shows kuhnSimplex(n, lowered(n, base, upd, m), unrotated(n, upd)) ∈ kuhnSimplices(p, n)
proof
  have lowFunction := lowered.function with baseFunction, rooted
  have unrotatedBijective := unrotated.bijective with updBijective
  have lowBounds : ∀ j ∈ n, lowered(n, base, upd, m)(j) < p
    intros j hj
    have restores := lowered.restores with baseFunction, rooted, hj
    have below := bounds with hj
    have lowNat := nat.omega.backward with (FunctionBetween.apply_closed with lowFunction, hj)
    have baseNat := nat.omega.backward with (FunctionBetween.apply_closed with baseFunction, hj)
    arith
  exact kuhnSimplex.in_family with lowFunction, unrotatedBijective, lowBounds

theorem kuhnSimplices.finite (n p : Nat)
  shows Finite(kuhnSimplices(p, n))
proof
  have cube : Finite(functionSpace(n, succ(p)))
    have pairs := Finite.product with (Finite.natural at n), (Finite.natural at succ(p))
    have inside : functionSpace(n, succ(p)) ⊆ 𝒫(n × succ(p))
      intros f hf
      have function := functionSpace.membership.forward with hf
      have relation := FunctionBetween.relation with function
      have subset : f ⊆ n × succ(p) := relation
      exact powerset.membership_iff.backward with subset
    exact Finite.subset with (Finite.powerset with pairs), inside
  have inside : kuhnSimplices(p, n) ⊆ 𝒫(functionSpace(n, succ(p)))
    intros s hs
    have parts := kuhnSimplices.membership.forward with hs
    exact parts.left
  exact Finite.subset with (Finite.powerset with cube), inside
