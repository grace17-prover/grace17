module Grace.Cumulus.FixedPoint.KuhnExtend
import KuhnWallFace

def cubeExtend (m p y : Set) : Set := y ∪ constantFunction({m}, succ(p), p)

theorem cubeExtend.disjoint (m : Set)
  shows Disjoint(m, {m})
proof
  apply Disjoint.iff.backward
  intros x hx inside
  have same := singleton.membership.forward with inside
  rw same at hx
  exact membership.irreflexive with hx

theorem cubeExtend.function (m p : Nat) (y : Set)
  requires hy : y ∈ functionSpace(m, succ(p))
  shows cubeExtend(m, p, y) : succ(m) → succ(p)
proof
  have yFunction := functionSpace.mem_iff.forward with hy
  have pIn := bootstrap.succ.self at p
  have constant := constantFunction.function at {m}, succ(p), p with pIn
  have disjoint := cubeExtend.disjoint at m
  have union := FunctionBetween.union_disjoint with yFunction, constant, disjoint
  have asInsert := natural.successor_as_insert at m
  have unfolded : insert(m, m) = {m} ∪ m
    unfold insert
    rfl
  have domain : m ∪ {m} = succ(m)
    rw [asInsert, unfolded]
    exact union2.commutative
  have codomain := union2.idempotent at succ(p)
  rw [domain, codomain] at union
  have same : cubeExtend(m, p, y) = y ∪ constantFunction({m}, succ(p), p)
    unfold cubeExtend
    rfl
  rwa same

theorem cubeExtend.apply_below (m p : Nat) (y j : Set)
  requires hy : y ∈ functionSpace(m, succ(p))
  requires hj : j ∈ m
  shows cubeExtend(m, p, y)(j) = y(j)
proof
  have yFunction := functionSpace.mem_iff.forward with hy
  have pIn := bootstrap.succ.self at p
  have constant := constantFunction.function at {m}, succ(p), p with pIn
  have disjoint := cubeExtend.disjoint at m
  have same : cubeExtend(m, p, y) = y ∪ constantFunction({m}, succ(p), p)
    unfold cubeExtend
    rfl
  rw same
  exact FunctionBetween.union_apply_left with yFunction, constant, disjoint, hj

theorem cubeExtend.apply_top (m p : Nat) (y : Set)
  requires hy : y ∈ functionSpace(m, succ(p))
  shows cubeExtend(m, p, y)(m) = p
proof
  have yFunction := functionSpace.mem_iff.forward with hy
  have pIn := bootstrap.succ.self at p
  have constant := constantFunction.function at {m}, succ(p), p with pIn
  have disjoint := cubeExtend.disjoint at m
  have mIn : m ∈ {m}
    apply singleton.membership.backward
    rfl
  have same : cubeExtend(m, p, y) = y ∪ constantFunction({m}, succ(p), p)
    unfold cubeExtend
    rfl
  rw same
  have value := FunctionBetween.union_apply_right with yFunction, constant, disjoint, mIn
  rw value
  exact constantFunction.apply with mIn, pIn

theorem cubeExtend.member (m p : Nat) (y : Set)
  requires hy : y ∈ functionSpace(m, succ(p))
  shows cubeExtend(m, p, y) ∈ functionSpace(succ(m), succ(p))
proof
  exact functionSpace.mem_iff.backward with (cubeExtend.function with hy)

theorem successor.subset (m : Nat)
  shows m ⊆ succ(m)
proof
  intros l hl
  exact membership.into_successor with hl

theorem cubeExtend.restrict (m p : Nat) (y : Set)
  requires hy : y ∈ functionSpace(m, succ(p))
  shows restrict(cubeExtend(m, p, y), m) = y
proof
  have yFunction := functionSpace.mem_iff.forward with hy
  have extended := cubeExtend.function with hy
  have mSubset := successor.subset at m
  have restricted := restrict.domain_function with extended, mSubset
  apply FunctionBetween.ext with restricted, yFunction
  intros j hj
  have value := restrict.domain_apply with extended, mSubset, hj
  rw value
  exact cubeExtend.apply_below with hy, hj

theorem cubeRestrict.member (m p : Nat) (x : Set)
  requires hx : x ∈ functionSpace(succ(m), succ(p))
  shows restrict(x, m) ∈ functionSpace(m, succ(p))
proof
  have xFunction := functionSpace.mem_iff.forward with hx
  have mSubset := successor.subset at m
  exact functionSpace.mem_iff.backward with (restrict.domain_function with xFunction, mSubset)

-- A point on the far wall is the extension of its restriction.
theorem cubeRestrict.extend (m p : Nat) (x : Set)
  requires hx : x ∈ functionSpace(succ(m), succ(p))
  requires top : x(m) = p
  shows cubeExtend(m, p, restrict(x, m)) = x
proof
  have xFunction := functionSpace.mem_iff.forward with hx
  have mSubset := successor.subset at m
  have restrictedIn := cubeRestrict.member with hx
  have extended := cubeExtend.function with restrictedIn
  apply FunctionBetween.ext with extended, xFunction
  intros j hj
  have split := bootstrap.succ.membership.forward with hj
  cases split with below | same
  . have value := cubeExtend.apply_below with restrictedIn, below
    rw value
    exact restrict.domain_apply with xFunction, mSubset, below
  . rw same
    have value := cubeExtend.apply_top with restrictedIn
    rw [value, top]
    rfl

defgraph cubeRestrict (m p : Set) (x ∈ functionSpace(succ(m), succ(p))) : functionSpace(m, succ(p)) := restrict(x, m)
requires mNat : Nat(m)
requires pNat : Nat(p)
proof
  exact cubeRestrict.member with member

-- The labelling of the lower cube induced by a labelling of the cube.
defgraph wallLabels (m p lab L : Set) (y ∈ functionSpace(m, succ(p))) : L := lab(cubeExtend(m, p, y))
requires mNat : Nat(m)
requires pNat : Nat(p)
requires labFunction : lab : functionSpace(succ(m), succ(p)) → L
proof
  have extendedIn := cubeExtend.member with member
  exact FunctionBetween.apply_closed with labFunction, extendedIn

theorem wallLabels.zero_wall (m p : Nat) (lab L : Set)
  requires labFunction : lab : functionSpace(succ(m), succ(p)) → L
  requires zeroWall : ∀ x ∈ functionSpace(succ(m), succ(p)), ∀ j ∈ succ(m), x(j) = 0 → lab(x)(j) = 0
  shows ∀ y ∈ functionSpace(m, succ(p)), ∀ j ∈ m, y(j) = 0 → wallLabels(m, p, lab, L)(y)(j) = 0
proof
  intros y hy j hj zero
  have value := wallLabels.value at m, p, lab, L, y with *
  rw value
  have extendedIn := cubeExtend.member with hy
  have jIn := membership.into_successor with hj
  have below := cubeExtend.apply_below with hy, hj
  have forX := zeroWall with extendedIn
  apply forX with jIn
  rwa below

theorem wallLabels.full_wall (m p : Nat) (lab L : Set)
  requires labFunction : lab : functionSpace(succ(m), succ(p)) → L
  requires fullWall : ∀ x ∈ functionSpace(succ(m), succ(p)), ∀ j ∈ succ(m), x(j) = p → lab(x)(j) = 1
  shows ∀ y ∈ functionSpace(m, succ(p)), ∀ j ∈ m, y(j) = p → wallLabels(m, p, lab, L)(y)(j) = 1
proof
  intros y hy j hj full
  have value := wallLabels.value at m, p, lab, L, y with *
  rw value
  have extendedIn := cubeExtend.member with hy
  have jIn := membership.into_successor with hj
  have below := cubeExtend.apply_below with hy, hj
  have forX := fullWall with extendedIn
  apply forX with jIn
  rwa below

-- On the far wall the reduced label survives restriction.
theorem reduced.restrict (m p : Nat) (lab L x : Set)
  requires labFunction : lab : functionSpace(succ(m), succ(p)) → L
  requires fullWall : ∀ x ∈ functionSpace(succ(m), succ(p)), ∀ j ∈ succ(m), x(j) = p → lab(x)(j) = 1
  requires hx : x ∈ functionSpace(succ(m), succ(p))
  requires top : x(m) = p
  shows reduced(m, wallLabels(m, p, lab, L), restrict(x, m)) = reduced(succ(m), lab, x)
proof
  have yIn := cubeRestrict.member with hx
  have labelValue := wallLabels.value at m, p, lab, L, restrict(x, m) with *
  have back := cubeRestrict.extend with hx, top
  rw back at labelValue
  have mIn := bootstrap.succ.self at m
  have forX := fullWall with hx
  have labelOne := forX with mIn, top
  have nonzero : lab(x)(m) ≠ 0
    rw labelOne
    intro equal
    arith
  have bound := reduced.le_of_nonzero with mIn, nonzero
  have less : reduced(succ(m), lab, x) < succ(m) by arith
  have rIn := membership.of_Less with less
  apply reduced.unique
  . exact rIn
  . intros i hi
    have zero := reduced.below with hi
    rwa labelValue
  . have stop := reduced.stop at succ(m), lab, x
    cases stop with top2 | nonzero2
    . exfalso
      rw top2 at rIn
      exact membership.irreflexive with rIn
    . right
      rwa labelValue

theorem labelImage.restrict_wall (m p : Nat) (lab L f : Set)
  requires labFunction : lab : functionSpace(succ(m), succ(p)) → L
  requires fullWall : ∀ x ∈ functionSpace(succ(m), succ(p)), ∀ j ∈ succ(m), x(j) = p → lab(x)(j) = 1
  requires inCube : f ⊆ functionSpace(succ(m), succ(p))
  requires top : ∀ x ∈ f, x(m) = p
  shows labelImage(m, wallLabels(m, p, lab, L), functionImage(cubeRestrict(m, p), f, functionSpace(m, succ(p)))) =
    labelImage(succ(m), lab, f)
proof
  ext k
  constructor
  . intro hk
    obtain ⟨kIn, y, hy, shape⟩ := labelImage.membership.forward with hk
    obtain ⟨yIn, x, hx, yShape⟩ := functionImage.membership.forward with hy
    have xIn := inCube with x, hx
    have value := cubeRestrict.value with xIn
    rw value at yShape
    have same := reduced.restrict with labFunction, fullWall, xIn, (top with hx)
    apply labelImage.membership.backward
    constructor
    . exact membership.into_successor with kIn
    . witness x
      constructor
      . exact hx
      . rw [shape, yShape, same]
        rfl
  . intro hk
    obtain ⟨kIn, x, hx, shape⟩ := labelImage.membership.forward with hk
    have xIn := inCube with x, hx
    have same := reduced.restrict with labFunction, fullWall, xIn, (top with hx)
    have value := cubeRestrict.value with xIn
    have restrictedIn := cubeRestrict.member with xIn
    have reducedBound := reduced.bound at m, wallLabels(m, p, lab, L), restrict(x, m)
    apply labelImage.membership.backward
    constructor
    . rw [shape, ← same]
      exact reducedBound
    . witness restrict(x, m)
      constructor
      . apply functionImage.membership.backward
        constructor
        . exact restrictedIn
        . witness x
          constructor
          . exact hx
          . rw value
            rfl
      . rw [shape, ← same]
        rfl
