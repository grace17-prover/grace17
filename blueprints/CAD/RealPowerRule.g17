module CAD.RealPowerRule
import Grace.Cumulus.Real.Analysis.Derivative
import Grace.Cumulus.Real.Power

def powerFunction (n : Nat) → Set
  | zero => constantRealFunction(realOne)
  | succ(k) => pointwiseMul(identity(ℝ), powerFunction(k))

theorem powerFunction.zero
  shows powerFunction(0) = constantRealFunction(realOne)
proof
  rw powerFunction

theorem powerFunction.succ (k : Nat)
  shows powerFunction(k + 1) = pointwiseMul(identity(ℝ), powerFunction(k))
proof
  have one : k + 1 = succ(k) := add.right_one with *
  rw one
  rw powerFunction

theorem powerFunction.function (n : Nat)
  shows powerFunction(n) : ℝ → ℝ
proof
  induction n
  | zero =>
    rw powerFunction.zero
    exact constantRealFunction.function with realOne.real
  | succ(k) using ih =>
    have one : k + 1 = succ(k) := add.right_one with *
    rw ← one
    rw powerFunction.succ
    have identityFunction := identity.function at ℝ
    exact pointwiseMul.function with identityFunction, ih

theorem powerFunction.value (n : Nat) (X : Real)
  shows powerFunction(n)(X) = X ^ n
proof
  induction n
  | zero =>
    rw [powerFunction.zero, realPow.zero]
    exact constantRealFunction.value with realOne.real, assumption
  | succ(k) using ih =>
    have one : k + 1 = succ(k) := add.right_one with *
    rw ← one
    rw [powerFunction.succ, one, realPow.succ]
    have realX : X ∈ ℝ by simp [Real]
    have identityValue := identity.apply with realX
    have power := powerFunction.function at k
    have typedIdentity : Real(identity(ℝ)(X)) by rwa identityValue
    have typedPower : Real(powerFunction(k)(X))
      exact FunctionBetween.apply_closed with power, realX
    have identityFunction := identity.function at ℝ
    have value := pointwiseMul.value at identity(ℝ), powerFunction(k), X with
      assumption, identityFunction, power, typedIdentity, typedPower
    rwa [identityValue, ih] at value

theorem powerFunction.continuous (n : Nat)
  shows Continuous(powerFunction(n))
proof
  induction n
  | zero =>
    rw powerFunction.zero
    exact constantRealFunction.continuous with realOne.real
  | succ(k) using ih =>
    have one : k + 1 = succ(k) := add.right_one with *
    rw ← one
    rw powerFunction.succ
    exact Continuous.mul with identity.continuous, ih

-- The real of a successor, in the notation the power rule uses.
theorem powerFunction.nat_succ (n : Nat)
  shows realNat(succ(n)) = (realNat(n):R) + 1
proof
  rw realNat.succ
  unfold realAddValue
  unfold call2
  rfl

-- The power rule.
theorem powerFunction.has_derivative_at (n : Nat) (X : Real)
  shows HasDerivativeAt(powerFunction(n + 1), realNat(n + 1) * X ^ n, X)
proof
  induction n
  | zero =>
    rw powerFunction.succ
    rw powerFunction.zero
    have identityDerivative := identity.has_derivative_at at X
    have typedOne := realOne.real
    have constantDerivative := constantRealFunction.has_derivative_at at
      realOne, X
    have realX : X ∈ ℝ by simp [Real]
    have identityValue := identity.apply with realX
    have constantValue := constantRealFunction.value at realOne, X with
      realOne.real, assumption
    have typedIdentity : Real(identity(ℝ)(X)) by rwa identityValue
    have typedConstant : Real(constantRealFunction(realOne)(X))
      rwa constantValue
    have product := HasDerivativeAt.mul_value with
      identityDerivative, constantDerivative, typedIdentity, typedConstant
    have one : 0 + 1 = succ(0) := add.right_one with *
    have algebra : realOne * constantRealFunction(realOne)(X) +
        identity(ℝ)(X) * realZero = realNat(0 + 1) * X ^ 0
      rw [constantValue, identityValue, realPow.zero, one,
        powerFunction.nat_succ, realNat.zero]
      ring
    exact HasDerivativeAt.congr_value with product, algebra
  | succ(k) using ih =>
    have one : k + 1 = succ(k) := add.right_one with *
    rw ← one
    rw powerFunction.succ
    have identityDerivative := identity.has_derivative_at at X
    have realX : X ∈ ℝ by simp [Real]
    have identityValue := identity.apply with realX
    have powerValue := powerFunction.value at k + 1, X
    have typedIdentity : Real(identity(ℝ)(X)) by rwa identityValue
    have typedPowerValue := realPow.real at X, k + 1
    have typedPower : Real(powerFunction(k + 1)(X)) by rwa powerValue
    have product := HasDerivativeAt.mul_value with
      identityDerivative, ih, typedIdentity, typedPower
    have typedBase := realPow.real at X, k
    have typedNat := realNat.real at k
    have two : k + 1 + 1 = succ(k + 1) := add.right_one with *
    have algebra : realOne * powerFunction(k + 1)(X) +
        identity(ℝ)(X) * (realNat(k + 1) * X ^ k) =
        realNat(k + 1 + 1) * X ^ (k + 1)
      rw [powerValue, identityValue, two, powerFunction.nat_succ, one,
        powerFunction.nat_succ, realPow.succ]
      ring
    exact HasDerivativeAt.congr_value with product, algebra

theorem powerFunction.derivative (n : Nat) (X : Real)
  shows powerFunction(n + 1)′(X) = realNat(n + 1) * X ^ n
proof
  have derivative := powerFunction.has_derivative_at at n, X
  exact derivative.of_has_derivative with derivative

-- Functions equal everywhere have the same derivatives.
theorem HasDerivativeAt.congr (f g : Set) (D A : Real)
  requires derivative : HasDerivativeAt(f, D, A)
  requires gFunction : g : ℝ → ℝ
  requires equal : ∀ x ∈ ℝ, f(x) = g(x)
  shows HasDerivativeAt(g, D, A)
proof
  have fFunction := HasDerivativeAt.function with derivative
  have limit := HasDerivativeAt.limit with derivative
  have quotientFunction := differenceQuotient.function at g, A with gFunction
  have realA : A ∈ ℝ by simp [Real]
  have equalA := equal with A, realA
  have equalAway : ∀ H ∈ ℝ, (H ≠ realZero →
      differenceQuotient(g, A)(H) = differenceQuotient(f, A)(H))
    intros H realH nonzero
    have typedH : Real(H) by exact realH
    have sumReal := realAddValue.real at A, H with assumption, typedH
    have sumInReals : A + H ∈ ℝ by exact sumReal
    have equalShift := equal with A + H, sumInReals
    have fQuotient := differenceQuotient.value at f, A, H with
      assumption, typedH, fFunction
    have gQuotient := differenceQuotient.value at g, A, H with
      assumption, typedH, gFunction
    rw [gQuotient, fQuotient, equalShift, equalA]
  have quotientLimit := TendsToAt.congr with limit, quotientFunction, equalAway
  unfold HasDerivativeAt
  refine ⟨gFunction, quotientLimit⟩

-- The chain rule, by the factor H ↦ (g(Y + H) − g(Y)) / H completed by
-- the derivative E at the origin, which is continuous at the origin; the
-- difference quotient of g ∘ f is this factor at the increment of f
-- times the difference quotient of f.
defunique chainFactorValue (g : Set, E Y H : Real) (v ∈ ℝ) :=
  (H = (0:R) ∧ v = E) ∨ (H ≠ (0:R) ∧ v = differenceQuotient(g, Y)(H))
requires gFunction : g : ℝ → ℝ
proof
  have split : H = (0:R) ∨ H ≠ (0:R) by tauto
  cases split with zero | nonzero
  . have realE : E ∈ ℝ by simp [Real]
    refine ⟨E, realE, ?_⟩
    left
    exact ⟨zero, rfl⟩
  . have quotientFunction := differenceQuotient.function at g, Y with gFunction
    have realH : H ∈ ℝ by simp [Real]
    have quotientReal := FunctionBetween.apply_closed with
      quotientFunction, realH
    refine ⟨differenceQuotient(g, Y)(H), quotientReal, ?_⟩
    right
    exact ⟨nonzero, rfl⟩
uniqueness
  intros s sMember first t tMember second
  rcases first with zeroS | nonzeroS
  . rcases second with zeroT | nonzeroT
    . cc
    . exfalso
      exact nonzeroT.left with zeroS.left
  . rcases second with zeroT | nonzeroT
    . exfalso
      exact nonzeroS.left with zeroT.left
    . cc

defgraph chainFactor (g : Set, E Y : Real) (H ∈ ℝ) : ℝ :=
  chainFactorValue(g, E, Y, H)
requires gFunction : g : ℝ → ℝ
proof
  have typedH : Real(H) by exact member
  have selected := chainFactorValue.selected at g, E, Y, H with gFunction
  exact selected.left

theorem chainFactor.at_zero (g : Set) (E Y : Real)
  requires gFunction : g : ℝ → ℝ
  shows chainFactor(g, E, Y)(realZero) = E
proof
  have zeroReal := realZero.real
  have value := chainFactor.value at g, E, Y, realZero with gFunction, zeroReal
  have selected := chainFactorValue.selected at g, E, Y, realZero with gFunction
  rcases selected with ⟨member, property⟩
  rw value
  rcases property with zero | nonzero
  . exact zero.right
  . exfalso
    exact nonzero.left with rfl

theorem chainFactor.away (g : Set) (E Y H : Real)
  requires gFunction : g : ℝ → ℝ
  requires nonzero : H ≠ realZero
  shows chainFactor(g, E, Y)(H) = differenceQuotient(g, Y)(H)
proof
  have realH : H ∈ ℝ by simp [Real]
  have value := chainFactor.value at g, E, Y, H with gFunction, realH
  have selected := chainFactorValue.selected at g, E, Y, H with gFunction
  rcases selected with ⟨member, property⟩
  rw value
  rcases property with zero | isNonzero
  . exfalso
    exact nonzero with zero.left
  . exact isNonzero.right

theorem chainFactor.continuous_at (g : Set) (E Y : Real)
  requires derivative : HasDerivativeAt(g, E, Y)
  shows ContinuousAt(chainFactor(g, E, Y), realZero)
proof
  have gFunction := HasDerivativeAt.function with derivative
  have limit := HasDerivativeAt.limit with derivative
  have factorFunction := chainFactor.function at g, E, Y with gFunction
  have equalAway : ∀ H ∈ ℝ, (H ≠ realZero →
      chainFactor(g, E, Y)(H) = differenceQuotient(g, Y)(H))
    intros H realH nonzero
    have typedH : Real(H) by exact realH
    exact chainFactor.away with gFunction, nonzero
  have factorLimit := TendsToAt.congr with limit, factorFunction, equalAway
  have atZero := chainFactor.at_zero at g, E, Y with gFunction
  exact TendsToAt.continuous_at with factorLimit, atZero

-- The increment of f at A tends to zero with its argument.
theorem incrementAt.continuous_at_zero (f : Set) (D A : Real)
  requires derivative : HasDerivativeAt(f, D, A)
  shows ContinuousAt(incrementAt(f, A), realZero) ∧
    incrementAt(f, A)(realZero) = realZero
proof
  have fFunction := HasDerivativeAt.function with derivative
  have realA : A ∈ ℝ by simp [Real]
  have fAInReals := FunctionBetween.apply_closed with fFunction, realA
  have typedFA : Real(f(A)) by exact fAInReals
  have shiftedLimit := HasDerivativeAt.shifted_limit with derivative
  have constantContinuous := constantRealFunction.continuous_at with
    typedFA, realZero.real
  have constantLimit := ContinuousAt.tends_to with constantContinuous
  have constantValue := constantRealFunction.value with typedFA, realZero.real
  rw constantValue at constantLimit
  have differenceLimit := TendsToAt.sub with shiftedLimit, constantLimit
  have selfDifference : f(A) - f(A) = realZero by ring
  rw selfDifference at differenceLimit
  have incrementValue := incrementAt.value at f, A, realZero with
    assumption, realZero.real, fFunction
  have addZero := realAddValue.zero_right at A
  rw [addZero, selfDifference] at incrementValue
  have incrementLimit : TendsToAt(incrementAt(f, A), realZero, realZero)
    unfold incrementAt
    exact differenceLimit
  constructor
  . exact TendsToAt.continuous_at with incrementLimit, incrementValue
  . exact incrementValue

-- The chain rule.
theorem HasDerivativeAt.comp (g f : Set) (D E A : Real)
  requires derivativeF : HasDerivativeAt(f, D, A)
  requires derivativeG : HasDerivativeAt(g, E, f(A))
  shows HasDerivativeAt(compose(g, f, ℝ, ℝ, ℝ), E * D, A)
proof
  have fFunction := HasDerivativeAt.function with derivativeF
  have gFunction := HasDerivativeAt.function with derivativeG
  have limitF := HasDerivativeAt.limit with derivativeF
  have composedFunction := compose.function with fFunction, gFunction
  have quotientFunction := differenceQuotient.function at
    compose(g, f, ℝ, ℝ, ℝ), A with composedFunction
  have realA : A ∈ ℝ by simp [Real]
  have fAInReals := FunctionBetween.apply_closed with fFunction, realA
  have typedFA : Real(f(A)) by exact fAInReals
  have gFAInReals := FunctionBetween.apply_closed with gFunction, fAInReals
  have typedGFA : Real(g(f(A))) by exact gFAInReals
  have incrementFunction := incrementAt.function at f, A with fFunction
  have factorFunction := chainFactor.function at g, E, f(A) with gFunction
  have incrementFacts := incrementAt.continuous_at_zero with derivativeF
  have incrementContinuous := incrementFacts.left
  have incrementZero := incrementFacts.right
  have factorContinuous := chainFactor.continuous_at with derivativeG
  have factorAtIncrement : ContinuousAt(chainFactor(g, E, f(A)),
      incrementAt(f, A)(realZero))
    rwa incrementZero
  have composedContinuous := ContinuousAt.comp with
    incrementContinuous, factorAtIncrement
  have factorLimit := ContinuousAt.tends_to with composedContinuous
  have factorAtZero := compose.apply with
    incrementFunction, factorFunction, realZero.real
  have atZero := chainFactor.at_zero at g, E, f(A) with gFunction
  rw [incrementZero, atZero] at factorAtZero
  rw factorAtZero at factorLimit
  have productLimit := TendsToAt.mul with factorLimit, limitF
  have equalAway : ∀ H ∈ ℝ, (H ≠ realZero →
      differenceQuotient(compose(g, f, ℝ, ℝ, ℝ), A)(H) =
        pointwiseMul(
          compose(chainFactor(g, E, f(A)), incrementAt(f, A), ℝ, ℝ, ℝ),
          differenceQuotient(f, A))(H))
    intros H realH nonzero
    have typedH : Real(H) by exact realH
    have sumReal := realAddValue.real at A, H with assumption, typedH
    have sumInReals : A + H ∈ ℝ by exact sumReal
    have fShiftInReals := FunctionBetween.apply_closed with
      fFunction, sumInReals
    have typedFShift : Real(f(A + H)) by exact fShiftInReals
    have gShiftInReals := FunctionBetween.apply_closed with
      gFunction, fShiftInReals
    have typedGShift : Real(g(f(A + H))) by exact gShiftInReals
    have composedShift := compose.apply with fFunction, gFunction, sumInReals
    have composedCenter := compose.apply with fFunction, gFunction, realA
    have composedQuotient := differenceQuotient.value at
      compose(g, f, ℝ, ℝ, ℝ), A, H with
        assumption, typedH, composedFunction
    rw [composedShift, composedCenter] at composedQuotient
    have fQuotient := differenceQuotient.value at f, A, H with
      assumption, typedH, fFunction
    have incrementValue := incrementAt.value at f, A, H with
      assumption, typedH, fFunction
    have typedIncrement := realSubValue.real at f(A + H), f(A) with
      typedFShift, typedFA
    have typedFactor : Real(compose(chainFactor(g, E, f(A)),
        incrementAt(f, A), ℝ, ℝ, ℝ)(H))
      have composedFactorFunction := compose.function with
        incrementFunction, factorFunction
      exact FunctionBetween.apply_closed with composedFactorFunction, realH
    have fQuotientFunction := differenceQuotient.function at f, A with
      fFunction
    have typedFQuotient : Real(differenceQuotient(f, A)(H))
      exact FunctionBetween.apply_closed with fQuotientFunction, realH
    have composedFactorFunction := compose.function with
      incrementFunction, factorFunction
    have productValue := pointwiseMul.value with
      typedH, composedFactorFunction, fQuotientFunction,
      typedFactor, typedFQuotient
    have factorValue := compose.apply with
      incrementFunction, factorFunction, realH
    rw incrementValue at factorValue
    rw [productValue, factorValue, composedQuotient, fQuotient]
    have split : f(A + H) - f(A) = realZero ∨ f(A + H) - f(A) ≠ realZero
      by tauto
    cases split with zero | nonzeroIncrement
    . rw zero
      rw atZero
      have same : f(A + H) = f(A) by linarith
      rw same
      have selfDifference : g(f(A)) - g(f(A)) = realZero by ring
      rw selfDifference
      rw realDiv.zero_left
      ring
    . have away := chainFactor.away at g, E, f(A), f(A + H) - f(A) with
        gFunction, nonzeroIncrement
      rw away
      have gQuotient := differenceQuotient.value at
        g, f(A), f(A + H) - f(A) with typedFA, typedIncrement, gFunction
      have restored : f(A) + (f(A + H) - f(A)) = f(A + H) by ring
      rw restored at gQuotient
      rw gQuotient
      have typedNumerator := realSubValue.real at g(f(A + H)), g(f(A)) with
        typedGShift, typedGFA
      have law := realInvValue.mul_right with nonzeroIncrement
      have invHReal := realInvValue.real at H
      have invKReal := realInvValue.real at f(A + H) - f(A)
      rw [realDiv.eq_mul_inv, realDiv.eq_mul_inv, realDiv.eq_mul_inv]
      linear_combination -((g(f(A + H)) - g(f(A))) * realInvValue(H)) * law
  have quotientLimit := TendsToAt.congr with
    productLimit, quotientFunction, equalAway
  unfold HasDerivativeAt
  refine ⟨composedFunction, quotientLimit⟩

theorem DifferentiableAt.comp (g f : Set) (A : Real)
  requires differentiableF : DifferentiableAt(f, A)
  requires differentiableG : DifferentiableAt(g, f(A))
  shows DifferentiableAt(compose(g, f, ℝ, ℝ, ℝ), A)
proof
  obtain ⟨D, realD, derivativeF⟩ := differentiableF
  obtain ⟨E, realE, derivativeG⟩ := differentiableG
  have typedD : Real(D) by exact realD
  have typedE : Real(E) by exact realE
  have composed := HasDerivativeAt.comp with derivativeF, derivativeG
  exact HasDerivativeAt.differentiable_at with composed

-- The derivative of a translate: (f(C + ·))′(X) = f′(C + X).
theorem HasDerivativeAt.translate (f : Set) (C D X : Real)
  requires derivative : HasDerivativeAt(f, D, C + X)
  shows HasDerivativeAt(compose(f, translateBy(C), ℝ, ℝ, ℝ), D, X)
proof
  have constantDerivative := constantRealFunction.has_derivative_at at C, X
  have identityDerivative := identity.has_derivative_at at X
  have sum := HasDerivativeAt.add with constantDerivative, identityDerivative
  have normalized : realZero + realOne = realOne by ring
  rw normalized at sum
  have translation : HasDerivativeAt(translateBy(C), realOne, X)
    unfold translateBy
    exact sum
  have translationValue := translateBy.value at C, X
  have shifted : HasDerivativeAt(f, D, translateBy(C)(X))
    rwa translationValue
  have composed := HasDerivativeAt.comp with translation, shifted
  have oneRight : D * realOne = D by ring
  rwa oneRight at composed
