  have cancelRows := sub.cancel_of_le at length{A}(ds),
    length{A}(hornerGcdLower{A}(add, zero, neg, mul, one, a, b, cs,
        ds)) with gsBelow
  have rowsEq : length{A}(ds) - length{A}(hornerGcdLower{A}(add, zero, neg,
      mul, one, a, b, cs, ds)) = length{A}(ds1)
    arith
  have twice : (2:N) * length{A}(hornerGcdLower{A}(add, zero, neg, mul, one, a,
      b, cs, ds)) ≤ length{A}(cs) + length{A}(ds)
    arith
