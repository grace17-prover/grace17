-- The principal subresultant coefficients of two Horner pairs: psc_j is
-- the determinant of the j-th subresultant matrix, the Sylvester block
-- matrix with the last j rows of each block and the last 2j columns
-- removed, of size m + n − 2j, for 0 ≤ j ≤ min(m, n); psc_0 is the
-- resultant. Transport under ring homomorphisms and evaluation, the top
-- values, and the gcd-degree lemma: over a field the degree of the gcd is
-- the least j with psc_j ≠ 0.
-- Part of the CAD blueprint.
-- Planned home: Algebra/Polynomial/Subresultant.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module CAD.Subresultant
import CAD.ResultantGcd
import Grace.Cumulus.Nat.Least
import Grace.Cumulus.Nat.MinMax

-- The j-th subresultant matrix has size m + n − 2j.
def subresultantMatrix {A : Set} (zero a b : Set)
  (cs ds : List(A), j : Nat) : Set :=
  sylvesterBlockMatrix(A, zero, a, b, cs, ds, length{A}(ds) - j,
    (length{A}(cs) + length{A}(ds)) - (2 * j))

def principalSubresultant {A : Set} (add zero neg mul one a b : Set)
  (cs ds : List(A), j : Nat) : Set :=
  determinant((length{A}(cs) + length{A}(ds)) - (2 * j), A, add, zero, neg,
    mul, one, subresultantMatrix{A}(zero, a, b, cs, ds, j))
notation scoped principalSubresultant(R, a, cs, b, ds, j) =>
  principalSubresultant(R.carrier, R.add, R.zero, R.neg, R.mul, R.one, a, b,
    cs, ds, j)

-- The indices from which some later index is moved by a function p on n.
def permutation.movedAbove (p n : Set) : Set :=
  { i ∈ ℕ | ∃ j ∈ n, i ≤ j ∧ p(j) ≠ j }

-- A permutation other than the identity moves some index down.
theorem permutation.exists_descent (n : Nat) (p : Set)
  requires permutation : p ∈ permutations(n)
  requires different : p ≠ identity(n)
  shows ∃ i ∈ n, p(i) < i
proof
  have bijective := permutations.mem_iff.forward at n, p with permutation
  have injective := Bijective.injective with bijective
  have function := Injective.function with injective
  have identityFunction := identity.function at n
  by_contra absent
  have fixedAbove : ∀ i ∈ n, i ≤ p(i)
    intros i hi
    have iNat := natural.member at n with hi
    have image := FunctionBetween.apply_closed with function, hi
    have imageNat := natural.member at n with image
    have notLess : ¬(p(i) < i)
      intro less
      apply absent
      refine ⟨i, hi, less⟩
    exact LessEqual.of_not_Less at p(i), i with notLess
  have moved : ∃ j ∈ n, p(j) ≠ j
    by_contra allFixed
    apply different
    apply FunctionBetween.ext with function, identityFunction
    intros i hi
    have fixed : p(i) = i
      by_contra notFixed
      apply allFixed
      refine ⟨i, hi, notFixed⟩
    have value := identity.apply at i, n with hi
    rw [fixed, value]
    rfl
  obtain ⟨j0, hj0, moved0⟩ := moved
  have zeroNat : Nat((0:N)) by typecheck
  have zeroMember := nat.omega.forward with zeroNat
  have zeroIn : (0:N) ∈ permutation.movedAbove(p, n)
    have rule := permutation.movedAbove.membership at p, n, (0:N)
    apply rule.backward
    have j0Nat := natural.member at n with hj0
    have below : (0:N) ≤ j0 by arith
    exact ⟨zeroMember, j0, hj0, below, moved0⟩
  have nMissing : ¬(n ∈ permutation.movedAbove(p, n))
    intro inside
    have rule := permutation.movedAbove.membership at p, n, n
    obtain ⟨_, j, hj, below, _⟩ := rule.forward with inside
    have jLess := Less.of_membership at j, n with hj
    have jNat := natural.member at n with hj
    arith
  obtain ⟨k, kNat, kIn, succMissing⟩ := natural.exists_boundary at
    permutation.movedAbove(p, n), n with zeroIn, nMissing
  have rule := permutation.movedAbove.membership at p, n, k
  obtain ⟨_, j, hj, kBelowJ, movedJ⟩ := rule.forward with kIn
  have jNat := natural.member at n with hj
  have jLess := Less.of_membership at j, n with hj
  have succNat : Nat(succ(k)) by typecheck
  have succMember := nat.omega.forward with succNat
  have same : j = k
    by_contra notSame
    apply succMissing
    have rule2 := permutation.movedAbove.membership at p, n, succ(k)
    apply rule2.backward
    have succBelow : succ(k) ≤ j by arith
    exact ⟨succMember, j, hj, succBelow, movedJ⟩
  have kMember : k ∈ n
    rw ← same
    exact hj
  have movedK : p(k) ≠ k
    rw ← same
    exact movedJ
  have kImage := FunctionBetween.apply_closed with function, kMember
  have kImageNat := natural.member at n with kImage
  have kBelow := fixedAbove with k, kMember
  have strict : k < p(k) by arith
  have imageFixed : p(p(k)) = p(k)
    by_contra notFixed
    apply succMissing
    have rule3 := permutation.movedAbove.membership at p, n, succ(k)
    apply rule3.backward
    have succBelow : succ(k) ≤ p(k) by arith
    exact ⟨succMember, p(k), kImage, succBelow, notFixed⟩
  have relK := FunctionBetween.relates_apply at p, n, n, k with function,
    kMember
  have relImage := FunctionBetween.relates_apply at p, n, n, p(k)
    with function, kImage
  rw imageFixed at relImage
  have equal := Injective.cancel at p, n, n, k, p(k), p(k) with injective,
    kMember, kImage, kImage, relK, relImage
  arith

section Triangular
variable (A add zero neg mul one : Set)
notation ring R := (A, add, zero, neg, mul, one)
hypothesis ring : IsCommRing(R)

theorem indexedRingProduct.constant_identity (w d : Set) (n k : Nat)
  requires element : d ∈ R
  requires values : ∀ i ∈ n, w(i) = d
  requires bound : k ≤ n
  shows indexedRingProduct(w, identity(n), mul, one, k) =
    monoidPow(mul, one, d, k)
proof
  have ordinary := IsCommRing.ring with ring
  have multiplicative := IsRing.multiplicative with ordinary
  have nNat : Nat(n) by typecheck
  induction k
  | zero =>
    intro bound
    rw [indexedRingProduct, monoidPow.zero]
    rfl
  | succ(m) using ih =>
    intro bound
    have smaller : m ≤ n by arith
    have previous := ih with smaller
    have mNat : Nat(m) by typecheck
    have mLess : m < n by arith
    have mMember := membership.of_Less at m, n with mNat, nNat, mLess
    have fixed := identity.apply at m, n with mMember
    have value := values with m, mMember
    have step := monoidPow.succ at mul, one, d, m
    have powerIn := monoidPow.closed at A, mul, one, d, m
      with multiplicative, element
    rw [indexedRingProduct, fixed, value, previous, step]
    ring

theorem finiteRingProduct.constant (w d : Set) (n : Nat)
  requires element : d ∈ R
  requires weights : w : n → A
  requires values : ∀ i ∈ n, w(i) = d
  shows finiteRingProduct(n, A, add, zero, neg, mul, one, w) =
    monoidPow(mul, one, d, n)
proof
  have enumeration := finiteRingProduct.enumeration at n, A, add, zero, neg,
    mul, one, w, identity(n), n with ring, weights, (identity.bijective at n)
  have reflexive : n ≤ n by arith
  have product := indexedRingProduct.constant_identity at A, add, zero, neg,
    mul, one, w, d, n, n with ring, element, values, reflexive
  rw [enumeration, product]
  rfl

-- An upper triangular matrix with a constant diagonal d has determinant
-- d to the size: every other permutation moves some index down, where
-- the entry vanishes.
theorem determinant.upper_triangular_constant (n : Nat) (M d : Set)
  requires matrix : RingMatrix(n, R, M)
  requires element : d ∈ R
  requires diagonal : ∀ i ∈ n, M[i, i] = d
  requires below : ∀ i ∈ n, ∀ k ∈ n, k < i → M[i, k] = R[0]
  shows determinant(n, R, M) = monoidPow(mul, one, d, n)
proof
  have finite := Finite.natural at n
  have permutationsFinite := permutations.finite with finite
  have identityBijective := identity.bijective at n
  have identityMember := permutations.mem_iff.backward at n, identity(n)
    with identityBijective
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have multiplicative := IsRing.multiplicative with ordinary
  have powerIn := monoidPow.closed at A, mul, one, d, n
    with multiplicative, element
  have terms := determinantTerms.function at n, A, add, zero, neg, mul, one, M
    with *
  have selected := coefficientSingle.function at permutations(n), A, zero,
    monoidPow(mul, one, d, n), identity(n) with *
  have entries : ∀ p ∈ permutations(n),
      determinantTerms(n, A, add, zero, neg, mul, one, M)(p) =
      coefficientSingle(permutations(n), A, zero, monoidPow(mul, one, d, n),
        identity(n))(p)
    intros p hp
    have permutation := permutations.mem_iff.forward with hp
    have injective := Bijective.injective with permutation
    have function := Injective.function with injective
    have weights := permutationEntries.function at n, A, M, p with *
    have term := determinantTerms.value at n, A, add, zero, neg, mul, one, M,
      p with *
    have signIn := permutationSign.closed at A, add, zero, neg, mul, one, n, p
      with *
    have alternatives : p = identity(n) ∨ p ≠ identity(n) by tauto
    rcases alternatives with same | different
    . have constant : ∀ i ∈ n, permutationEntries(n, A, M, p)(i) = d
        intros i hi
        have value := permutationEntries.value at n, A, M, p, i with *
        have fixed := identity.apply at i, n with hi
        have entry := diagonal with i, hi
        rw [value, same, fixed, entry]
        rfl
      have product := finiteRingProduct.constant at A, add, zero, neg, mul,
        one, permutationEntries(n, A, M, p), d, n
        with ring, element, weights, constant
      have sign := permutationSign.identity at A, add, zero, neg, mul, one, n
        with ring
      have selectedValue := coefficientSingle.same at permutations(n), A,
        zero, monoidPow(mul, one, d, n), identity(n)
        with zeroIn, powerIn, identityMember
      rw [term, product, same, sign, selectedValue]
      ring
    . have descent := permutation.exists_descent at n, p with hp, different
      obtain ⟨i, hi, less⟩ := descent
      have column := FunctionBetween.apply_closed at p, n, n, i
        with function, hi
      have off := below with i, hi, p(i), column, less
      have value := permutationEntries.value at n, A, M, p, i with *
      have vanishes : permutationEntries(n, A, M, p)(i) = R[0]
        rw [value, off]
        rfl
      have product := finiteRingProduct.zero_of_factor at n, A, add, zero,
        neg, mul, one, permutationEntries(n, A, M, p), i
        with ring, finite, weights, hi, vanishes
      have selectedValue := coefficientSingle.other at permutations(n), A,
        zero, monoidPow(mul, one, d, n), identity(n), p
        with zeroIn, powerIn, hp, different
      rw [term, product, selectedValue]
      ring
  have sum := finiteRingSum.congr at permutations(n), A, add, zero, neg, mul,
    one, determinantTerms(n, A, add, zero, neg, mul, one, M),
    coefficientSingle(permutations(n), A, zero, monoidPow(mul, one, d, n),
      identity(n)) with ring, permutationsFinite, terms, selected, entries
  have single := finiteRingSum.single at permutations(n), A, add, zero, neg,
    mul, one, monoidPow(mul, one, d, n), identity(n)
    with ring, permutationsFinite, powerIn, identityMember
  unfold determinant
  rw [sum, single]
  rfl

end Triangular

section Rings
variable (A add zero neg mul one a b : Set)
notation ring R := (A, add, zero, neg, mul, one)
hypothesis ring : IsCommRing(R)
hypothesis left : a ∈ R
hypothesis right : b ∈ R

theorem subresultantMatrix.matrix (cs ds : List(A)) (j : Nat)
  shows RingMatrix((length{A}(cs) + length{A}(ds)) - (2 * j), R,
    subresultantMatrix{A}(zero, a, b, cs, ds, j))
proof
  unfold subresultantMatrix
  exact sylvesterBlockMatrix.matrix at A, add, zero, neg, mul, one, a, b, cs,
    ds, length{A}(ds) - j, (length{A}(cs) + length{A}(ds)) - (2 * j)
    with ring, left, right

theorem principalSubresultant.closed (cs ds : List(A)) (j : Nat)
  shows principalSubresultant(R, a, cs, b, ds, j) ∈ R
proof
  have matrix := subresultantMatrix.matrix at A, add, zero, neg, mul, one, a,
    b, cs, ds, j with ring, left, right
  unfold principalSubresultant
  exact determinant.closed at A, add, zero, neg, mul, one,
    subresultantMatrix{A}(zero, a, b, cs, ds, j),
    (length{A}(cs) + length{A}(ds)) - (2 * j) with ring, matrix

theorem principalSubresultant.zero_index (cs ds : List(A))
  shows principalSubresultant(R, a, cs, b, ds, (0:N)) =
    resultant(R, a, cs, b, ds)
proof
  have rows := sub.zero_right at length{A}(ds)
  have twice := mul.right_zero at (2:N)
  have columns := sub.zero_right at length{A}(cs) + length{A}(ds)
  unfold principalSubresultant
  unfold subresultantMatrix
  unfold resultant
  unfold sylvesterMatrix
  rw [twice, rows, columns]
  rfl
-- At j = n ≤ m the matrix is triangular with b on the diagonal.
theorem principalSubresultant.top_left (cs ds : List(A))
  requires order : length{A}(ds) ≤ length{A}(cs)
  shows principalSubresultant(R, a, cs, b, ds, length{A}(ds)) =
    monoidPow(R, b, length{A}(cs) - length{A}(ds))
proof
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have rowsZero : length{A}(ds) - length{A}(ds) = (0:N)
    have difference := sub.add_right at (0:N), length{A}(ds)
    have shift : (0:N) + length{A}(ds) = length{A}(ds) by arith
    rw shift at difference
    exact difference
  have cancelM := sub.cancel_of_le at length{A}(cs), length{A}(ds) with order
  have twice : (2:N) * length{A}(ds) ≤ length{A}(cs) + length{A}(ds) by arith
  have cancelSize := sub.cancel_of_le at length{A}(cs) + length{A}(ds),
    (2:N) * length{A}(ds) with twice
  have sizeEq : (length{A}(cs) + length{A}(ds)) - (2 * length{A}(ds)) =
      length{A}(cs) - length{A}(ds)
    arith
  have sizeNat : Nat(length{A}(cs) - length{A}(ds)) by typecheck
  have matrix := sylvesterBlockMatrix.matrix at A, add, zero, neg, mul, one,
    a, b, cs, ds, (0:N), length{A}(cs) - length{A}(ds) with ring, left, right
  have diagonal : ∀ i ∈ length{A}(cs) - length{A}(ds),
      sylvesterBlockMatrix(A, zero, a, b, cs, ds, (0:N),
      length{A}(cs) - length{A}(ds))[i, i] = b
    intros i hi
    have iNat := natural.member at length{A}(cs) - length{A}(ds) with hi
    have iLess := Less.of_membership at i, length{A}(cs) - length{A}(ds)
      with hi
    have zeroBelow : (0:N) ≤ i by arith
    have entry := sylvesterBlockMatrix.entry_lower at A, add, zero, neg, mul,
      one, a, b, cs, ds, (0:N), length{A}(cs) - length{A}(ds), i, i
      with ring, left, right, zeroBelow, iLess, iLess
    have same := sub.zero_right at i
    have lowerBound : i ≤ i by arith
    have upperBound : i ≤ i + length{A}(ds) by arith
    have coefficient := sylvesterRow.coefficient at A, zero, b, ds, i, i
      with zeroIn, right, lowerBound, upperBound
    have difference := sub.add_right at length{A}(ds), i
    have leading := hornerCoefficient.leading at A, zero, b, ds with right
    rw [entry, same, coefficient, difference, leading]
    rfl
  have below : ∀ i ∈ length{A}(cs) - length{A}(ds),
      ∀ k ∈ length{A}(cs) - length{A}(ds), k < i →
      sylvesterBlockMatrix(A, zero, a, b, cs, ds, (0:N),
      length{A}(cs) - length{A}(ds))[i, k] = R[0]
    intros i hi k hk less
    have iLess := Less.of_membership at i, length{A}(cs) - length{A}(ds)
      with hi
    have kLess := Less.of_membership at k, length{A}(cs) - length{A}(ds)
      with hk
    have iNat := natural.member at length{A}(cs) - length{A}(ds) with hi
    have zeroBelow : (0:N) ≤ i by arith
    have entry := sylvesterBlockMatrix.entry_lower at A, add, zero, neg, mul,
      one, a, b, cs, ds, (0:N), length{A}(cs) - length{A}(ds), i, k
      with ring, left, right, zeroBelow, iLess, kLess
    have same := sub.zero_right at i
    have outside : k < i ∨ i + length{A}(ds) < k
      left
      exact less
    have vanish := sylvesterRow.coefficient_outside at A, zero, b, ds, i, k
      with zeroIn, right, outside
    rw [entry, same, vanish]
    rfl
  have det := determinant.upper_triangular_constant at A, add, zero, neg, mul,
    one, length{A}(cs) - length{A}(ds),
    sylvesterBlockMatrix(A, zero, a, b, cs, ds, (0:N),
      length{A}(cs) - length{A}(ds)), b
    with ring, matrix, right, diagonal, below
  unfold principalSubresultant
  unfold subresultantMatrix
  rw [rowsZero, sizeEq]
  exact det
theorem principalSubresultant.top_right (cs ds : List(A))
  requires order : length{A}(cs) ≤ length{A}(ds)
  shows principalSubresultant(R, a, cs, b, ds, length{A}(cs)) =
    monoidPow(R, a, length{A}(ds) - length{A}(cs))
proof
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have cancelN := sub.cancel_of_le at length{A}(ds), length{A}(cs) with order
  have twice : (2:N) * length{A}(cs) ≤ length{A}(cs) + length{A}(ds) by arith
  have cancelSize := sub.cancel_of_le at length{A}(cs) + length{A}(ds),
    (2:N) * length{A}(cs) with twice
  have sizeEq : (length{A}(cs) + length{A}(ds)) - (2 * length{A}(cs)) =
      length{A}(ds) - length{A}(cs)
    arith
  have sizeNat : Nat(length{A}(ds) - length{A}(cs)) by typecheck
  have matrix := sylvesterBlockMatrix.matrix at A, add, zero, neg, mul, one,
    a, b, cs, ds, length{A}(ds) - length{A}(cs),
    length{A}(ds) - length{A}(cs) with ring, left, right
  have diagonal : ∀ i ∈ length{A}(ds) - length{A}(cs),
      sylvesterBlockMatrix(A, zero, a, b, cs, ds, length{A}(ds) - length{A}(cs),
      length{A}(ds) - length{A}(cs))[i, i] = a
    intros i hi
    have iNat := natural.member at length{A}(ds) - length{A}(cs) with hi
    have iLess := Less.of_membership at i, length{A}(ds) - length{A}(cs)
      with hi
    have entry := sylvesterBlockMatrix.entry_upper at A, add, zero, neg, mul,
      one, a, b, cs, ds, length{A}(ds) - length{A}(cs),
      length{A}(ds) - length{A}(cs), i, i
      with ring, left, right, iLess, iLess, iLess
    have lowerBound : i ≤ i by arith
    have upperBound : i ≤ i + length{A}(cs) by arith
    have coefficient := sylvesterRow.coefficient at A, zero, a, cs, i, i
      with zeroIn, left, lowerBound, upperBound
    have difference := sub.add_right at length{A}(cs), i
    have leading := hornerCoefficient.leading at A, zero, a, cs with left
    rw [entry, coefficient, difference, leading]
    rfl
  have below : ∀ i ∈ length{A}(ds) - length{A}(cs),
      ∀ k ∈ length{A}(ds) - length{A}(cs), k < i →
      sylvesterBlockMatrix(A, zero, a, b, cs, ds, length{A}(ds) - length{A}(cs),
      length{A}(ds) - length{A}(cs))[i, k] = R[0]
    intros i hi k hk less
    have iLess := Less.of_membership at i, length{A}(ds) - length{A}(cs)
      with hi
    have kLess := Less.of_membership at k, length{A}(ds) - length{A}(cs)
      with hk
    have iNat := natural.member at length{A}(ds) - length{A}(cs) with hi
    have entry := sylvesterBlockMatrix.entry_upper at A, add, zero, neg, mul,
      one, a, b, cs, ds, length{A}(ds) - length{A}(cs),
      length{A}(ds) - length{A}(cs), i, k
      with ring, left, right, iLess, iLess, kLess
    have outside : k < i ∨ i + length{A}(cs) < k
      left
      exact less
    have vanish := sylvesterRow.coefficient_outside at A, zero, a, cs, i, k
      with zeroIn, left, outside
    rw [entry, vanish]
    rfl
  have det := determinant.upper_triangular_constant at A, add, zero, neg, mul,
    one, length{A}(ds) - length{A}(cs),
    sylvesterBlockMatrix(A, zero, a, b, cs, ds, length{A}(ds) - length{A}(cs),
      length{A}(ds) - length{A}(cs)), a
    with ring, matrix, left, diagonal, below
  unfold principalSubresultant
  unfold subresultantMatrix
  rw sizeEq
  exact det
end Rings

section Homomorphisms
variable (A add zero neg mul one B plus z minus times unit h a b : Set)
notation ring R := (A, add, zero, neg, mul, one)
notation ring S := (B, plus, z, minus, times, unit)
hypothesis source : IsCommRing(R)
hypothesis target : IsCommRing(S)
hypothesis hom : IsRingHom(h, R, S)
hypothesis left : a ∈ R
hypothesis right : b ∈ R

-- Transport of the block matrix entries.
theorem sylvesterBlockMatrix.map_entry (cs ds : List(A))
  (rowsP size i k : Nat)
  requires row : i < size
  requires column : k < size
  shows sylvesterBlockMatrix(B, z, h(a), h(b), listMap{A}(h, cs),
      listMap{A}(h, ds), rowsP, size)[i, k] =
    h(sylvesterBlockMatrix(A, zero, a, b, cs, ds, rowsP, size)[i, k])
proof
  have function := IsRingHom.function with hom
  have ordinary := IsCommRing.ring with source
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have zeroMap := IsRingHom.zero with hom
  have haIn := IsRingHom.closed with hom, left
  have hbIn := IsRingHom.closed with hom, right
  have csMap := listMap.closed at A, B, h, cs with function
  have dsMap := listMap.closed at A, B, h, ds with function
  have iNat : Nat(i) by typecheck
  have rowsNat : Nat(rowsP) by typecheck
  have comparison := Less.trichotomy at i, rowsP with iNat, rowsNat
  rcases comparison with below | rest
  . have upperA := sylvesterBlockMatrix.entry_upper at A, add, zero, neg, mul,
      one, a, b, cs, ds, rowsP, size, i, k with source, left, right, below,
      row, column
    have upperB := sylvesterBlockMatrix.entry_upper at B, plus, z, minus,
      times, unit, h(a), h(b), listMap{A}(h, cs), listMap{A}(h, ds), rowsP,
      size, i, k with target, haIn, hbIn, csMap, dsMap, below, row, column
    have rowMap := sylvesterRow.map at A, add, zero, neg, mul, one, B, plus, z,
      minus, times, unit, h, a, b, cs, i with source, target, hom, left, right
    have rowList := sylvesterRow.list at A, zero, a, cs, i with zeroIn, left
    have coefficientMap := listCoefficient.map at A, B, h, zero,
      sylvesterRow{A}(zero, a, cs, i), k with function, zeroIn, rowList
    rw [upperA, upperB, ← rowMap, ← zeroMap, coefficientMap]
    rfl
  . have above : rowsP ≤ i
      rcases rest with same | greater
      . rw same
        arith
      . unfold Less at greater
        arith
    have lowerA := sylvesterBlockMatrix.entry_lower at A, add, zero, neg, mul,
      one, a, b, cs, ds, rowsP, size, i, k with source, left, right, above,
      row, column
    have lowerB := sylvesterBlockMatrix.entry_lower at B, plus, z, minus,
      times, unit, h(a), h(b), listMap{A}(h, cs), listMap{A}(h, ds), rowsP,
      size, i, k with target, haIn, hbIn, csMap, dsMap, above, row, column
    have rowMap := sylvesterRow.map at A, add, zero, neg, mul, one, B, plus, z,
      minus, times, unit, h, b, b, ds, i - rowsP with source, target, hom,
      right, right
    have rowList := sylvesterRow.list at A, zero, b, ds, i - rowsP
      with zeroIn, right
    have coefficientMap := listCoefficient.map at A, B, h, zero,
      sylvesterRow{A}(zero, b, ds, i - rowsP), k with function, zeroIn,
      rowList
    rw [lowerA, lowerB, ← rowMap, ← zeroMap, coefficientMap]
    rfl

theorem principalSubresultant.map (cs ds : List(A)) (j : Nat)
  shows h(principalSubresultant(R, a, cs, b, ds, j)) =
    principalSubresultant(S, h(a), listMap{A}(h, cs), h(b), listMap{A}(h, ds),
      j)
proof
  have function := IsRingHom.function with hom
  have haIn := IsRingHom.closed with hom, left
  have hbIn := IsRingHom.closed with hom, right
  have csMap := listMap.closed at A, B, h, cs with function
  have dsMap := listMap.closed at A, B, h, ds with function
  have csLength := listMap.length at A, B, h, cs with function
  have dsLength := listMap.length at A, B, h, ds with function
  have matrixM := sylvesterBlockMatrix.matrix at A, add, zero, neg, mul, one,
    a, b, cs, ds, length{A}(ds) - j,
        (length{A}(cs) + length{A}(ds)) - (2 * j) with source, left, right
  have matrixN := sylvesterBlockMatrix.matrix at B, plus, z, minus, times,
    unit, h(a), h(b), listMap{A}(h, cs), listMap{A}(h, ds), length{A}(ds) - j,
    (length{A}(cs) + length{A}(ds)) - (2 * j) with target, haIn, hbIn, csMap,
        dsMap
  have sizeNat : Nat((length{A}(cs) + length{A}(ds)) - (2 * j)) by typecheck
  have entries : ∀ i ∈ (length{A}(cs) + length{A}(ds)) - (2 * j),
      ∀ k ∈ (length{A}(cs) + length{A}(ds)) - (2 * j),
      sylvesterBlockMatrix(B, z, h(a), h(b), listMap{A}(h, cs),
        listMap{A}(h, ds), length{A}(ds) - j,
            (length{A}(cs) + length{A}(ds)) - (2 * j))[i, k] =
      h(sylvesterBlockMatrix(A, zero, a, b, cs, ds, length{A}(ds) - j,
        (length{A}(cs) + length{A}(ds)) - (2 * j))[i, k])
    intros i hi k hk
    have iLess := Less.of_membership at i,
        (length{A}(cs) + length{A}(ds)) - (2 * j) with hi
    have kLess := Less.of_membership at k,
        (length{A}(cs) + length{A}(ds)) - (2 * j) with hk
    exact sylvesterBlockMatrix.map_entry at A, add, zero, neg, mul, one, B,
      plus, z, minus, times, unit, h, a, b, cs, ds, length{A}(ds) - j,
      (length{A}(cs) + length{A}(ds)) - (2 * j), i, k with source, target, hom,
          left, right, iLess, kLess
  have det := determinant.map at A, add, zero, neg, mul, one, B, plus, z,
    minus, times, unit, h, (length{A}(cs) + length{A}(ds)) - (2 * j),
    sylvesterBlockMatrix(A, zero, a, b, cs, ds, length{A}(ds) - j,
        (length{A}(cs) + length{A}(ds)) - (2 * j)),
    sylvesterBlockMatrix(B, z, h(a), h(b), listMap{A}(h, cs),
      listMap{A}(h, ds), length{A}(ds) - j,
          (length{A}(cs) + length{A}(ds)) - (2 * j))
    with source, target, hom, matrixM, matrixN, entries
  unfold principalSubresultant
  unfold subresultantMatrix
  rw [csLength, dsLength]
  exact det
end Homomorphisms

section Evaluation
variable (I A add zero neg mul one v a b : Set)
notation ring R := (A, add, zero, neg, mul, one)
notation ring P := R[I]
hypothesis ring : IsCommRing(R)
hypothesis assignment : v : I → R
hypothesis left : a ∈ P
hypothesis right : b ∈ P

theorem principalSubresultant.evaluate (cs ds : List(polynomials(I, A,
    zero))) (j : Nat)
  shows polynomialAt(I, R, v)(principalSubresultant(P, a, cs, b, ds, j)) =
    principalSubresultant(R, polynomialAt(I, R, v)(a),
      listMap{polynomials(I, A, zero)}(polynomialAt(I, R, v), cs),
      polynomialAt(I, R, v)(b),
      listMap{polynomials(I, A, zero)}(polynomialAt(I, R, v), ds), j)
proof
  have source := polynomials.comm_ring at I, A, add, zero, neg, mul, one
    with ring
  have hom := polynomialAt.hom at I, A, add, zero, neg, mul, one, v
    with ring, assignment
  exact principalSubresultant.map at polynomials(I, A, zero),
    polynomialAdd(I, A, add, zero, neg, mul, one),
    constantFunction(monomials(I), A, zero),
    polynomialNeg(I, A, add, zero, neg, mul, one),
    polynomialMul(I, A, add, zero, neg, mul, one),
    polynomialConstant(I, A, zero, one), A, add, zero, neg, mul, one,
    polynomialAt(I, R, v), a, b, cs, ds, j
    with source, ring, hom, left, right
end Evaluation

-- The indices of the nonzero principal subresultant coefficients.
def nonzeroSubresultantIndices {A : Set} (add zero neg mul one a b : Set)
  (cs ds : List(A)) : Set :=
  { j ∈ ℕ | principalSubresultant{A}(add, zero, neg, mul, one, a, b, cs, ds,
    j) ≠ zero }

section Cofactors
variable (A add zero neg mul one : Set)
notation ring R := (A, add, zero, neg, mul, one)
notation ring P := R[oneVariable]
hypothesis field : IsField(R)

-- A nonzero pair divided by a nonzero pair is the product with a pair in
-- normal form, of complementary length.
theorem hornerPoly.cofactor_of_divides (g x : Set) (gs xs : List(A))
  requires divisor : g ∈ R
  requires divisorNonzero : g ≠ R[0]
  requires initial : x ∈ R
  requires nonzero : x ≠ R[0]
  requires divides : HornerDivides(A, add, zero, neg, mul, one, g, gs, x, xs)
  shows ∃ c ∈ R, c ≠ R[0] ∧ ∃ cs1, List(A, cs1) ∧
    length{A}(cs1) + length{A}(gs) = length{A}(xs) ∧
    hornerPoly{A}(add, zero, neg, mul, one, x, xs) =
      P[hornerPoly{A}(add, zero, neg, mul, one, c, cs1) *
        hornerPoly{A}(add, zero, neg, mul, one, g, gs)]
proof
  have ring := IsField.comm_ring with field
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have index := oneVariable.index
  have factor := HornerDivides.quotient at A, add, zero, neg, mul, one, g, x,
    gs, xs with field, divisor, divisorNonzero, initial, divides
  have qData := hornerDivQuotient.data at A, add, zero, neg, mul, one, g, x,
    gs, xs with field, divisor, divisorNonzero, initial
  have trimEq := hornerPoly.trim at A, add, zero, neg, mul, one,
    hornerDivQuotient{A}(add, zero, neg, mul, one, g, x, gs,
      xs) with ring, qData.left
  have normal := hornerTrim.normal at A, zero,
    hornerDivQuotient{A}(add, zero, neg, mul, one, g, x, gs,
      xs) with qData.left
  have cIn := hornerTrimLeading.mem at A, zero,
    hornerDivQuotient{A}(add, zero, neg, mul, one, g, x, gs,
      xs) with zeroIn, qData.left
  have csList := hornerTrimLower.list at A, zero,
    hornerDivQuotient{A}(add, zero, neg, mul, one, g, x, gs,
      xs) with qData.left
  have gIn := hornerPoly.member at A, add, zero, neg, mul, one, g, gs
    with ring, divisor
  have xNonzero : hornerPoly{A}(add, zero, neg, mul, one, x, xs) ≠ P[0]
    unfold hornerPoly
    exact polynomialFromHorner.nonzero_of_leading at oneVariable, A, add, zero,
      neg, mul, one, (0:N), x, xs with ring, index, initial, nonzero
  have cNonzero : hornerTrimLeading{A}(zero, hornerDivQuotient{A}(add, zero,
      neg, mul, one, g, x, gs,
      xs)) ≠ R[0]
    rcases normal with nonzeroLeading | ⟨isZero, isNil⟩
    . exact nonzeroLeading
    . exfalso
      apply xNonzero
      have zeroPoly := hornerPoly.zero_list at A, add, zero, neg, mul, one
        with ring
      rw [factor, ← trimEq, isZero, isNil, zeroPoly]
      ring
  have product := hornerPoly.mul at A, add, zero, neg, mul, one,
    hornerTrimLeading{A}(zero, hornerDivQuotient{A}(add, zero, neg, mul, one,
        g, x, gs,
      xs)), g,
    hornerTrimLower{A}(zero, hornerDivQuotient{A}(add, zero, neg, mul, one, g,
        x, gs,
      xs)), gs with ring, cIn, divisor, csList
  have mulData := hornerMulList.data at A, add, zero, neg, mul, one,
    hornerTrimLeading{A}(zero, hornerDivQuotient{A}(add, zero, neg, mul, one,
        g, x, gs,
      xs)), g,
    hornerTrimLower{A}(zero, hornerDivQuotient{A}(add, zero, neg, mul, one, g,
        x, gs,
      xs)), gs with ring, cIn, divisor, csList
  have cgIn := IsRing.mul_closed with ordinary, cIn, divisor
  have cgNonzero : R[hornerTrimLeading{A}(zero, hornerDivQuotient{A}(add, zero,
      neg, mul, one, g, x, gs,
      xs)) * g] ≠ R[0]
    have noDivisors := IsField.no_zero_divisors with field
    unfold NoZeroDivisors at noDivisors
    intro vanishes
    have alternatives := noDivisors with hornerTrimLeading{A}(zero,
        hornerDivQuotient{A}(add, zero, neg, mul, one, g, x, gs,
      xs)), cIn, g,
      divisor, vanishes
    rcases alternatives with cZero | gZero
    . exact cNonzero with cZero
    . exact divisorNonzero with gZero
  have same : hornerPoly{A}(add, zero, neg, mul, one,
      R[hornerTrimLeading{A}(zero, hornerDivQuotient{A}(add, zero, neg, mul,
      one, g, x, gs,
      xs)) * g],
      hornerMulList{A}(add, zero, mul, hornerTrimLeading{A}(zero,
          hornerDivQuotient{A}(add, zero, neg, mul, one, g, x, gs,
      xs)), g,
      hornerTrimLower{A}(zero, hornerDivQuotient{A}(add, zero, neg, mul, one,
          g, x, gs,
      xs)), gs)) =
      hornerPoly{A}(add, zero, neg, mul, one, x, xs)
    rw [product, trimEq, factor]
    rfl
  unfold hornerPoly at same
  have lengths := polynomialFromHorner.length_unique at oneVariable, A, add,
    zero, neg, mul, one, (0:N), R[hornerTrimLeading{A}(zero,
        hornerDivQuotient{A}(add, zero, neg, mul, one, g, x, gs,
      xs)) * g], x,
    hornerMulList{A}(add, zero, mul, hornerTrimLeading{A}(zero,
        hornerDivQuotient{A}(add, zero, neg, mul, one, g, x, gs,
      xs)), g,
      hornerTrimLower{A}(zero, hornerDivQuotient{A}(add, zero, neg, mul, one,
          g, x, gs,
      xs)), gs), xs
    with ring, index, cgIn, initial, cgNonzero, nonzero, same
  refine ⟨hornerTrimLeading{A}(zero, hornerDivQuotient{A}(add, zero, neg, mul,
      one, g, x, gs,
      xs)), cIn, cNonzero,
    hornerTrimLower{A}(zero, hornerDivQuotient{A}(add, zero, neg, mul, one, g,
        x, gs,
      xs)), csList, ?_, ?_⟩
  . rw ← mulData.right
    exact lengths
  . rw [factor, ← trimEq]
    rfl

end Cofactors

section Fields
variable (A add zero neg mul one a b : Set)
notation ring R := (A, add, zero, neg, mul, one)
notation ring P := R[oneVariable]
hypothesis field : IsField(R)
hypothesis left : a ∈ R
hypothesis right : b ∈ R
hypothesis leftNonzero : a ≠ R[0]
hypothesis rightNonzero : b ≠ R[0]

-- Below the degree of the gcd every principal subresultant coefficient
-- vanishes, and at that degree it does not.
theorem principalSubresultant.zero_below_gcd_degree (cs ds : List(A)) (j : Nat)
  requires below : j < length{A}(hornerGcdLower{A}(add, zero, neg, mul, one, a,
    b, cs, ds))
  shows principalSubresultant(R, a, cs, b, ds, j) = R[0]
proof
  have ring := IsField.comm_ring with field
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have index := oneVariable.index
  have unit := monomialOne.member at oneVariable
  have gIn := hornerGcdLeading.mem at A, add, zero, neg, mul, one, a, b, cs, ds
    with field, left, right
  have gNonzero := hornerGcd.nonzero_of_left at A, add, zero, neg, mul, one,
    a, b, cs, ds with field, left, right, leftNonzero
  have gsList := hornerGcdLower.list at A, add, zero, neg, mul, one, a, b, cs,
    ds with field, left, right
  have dividesLeft := hornerGcd.divides_left at A, add, zero, neg, mul, one, a,
    b, cs, ds with field, left, right
  have dividesRight := hornerGcd.divides_right at A, add, zero, neg, mul, one,
    a, b, cs, ds with field, left, right
  have leftFactor := hornerPoly.cofactor_of_divides at A, add, zero, neg, mul,
    one, hornerGcdLeading{A}(add, zero, neg, mul, one, a, b, cs, ds), a,
    hornerGcdLower{A}(add, zero, neg, mul, one, a, b, cs, ds), cs
    with field, gIn, gNonzero, gsList, left, leftNonzero, dividesLeft
  obtain ⟨c, cIn, cNonzero, cs1, cs1List, cs1Length, pEq⟩ := leftFactor
  have rightFactor := hornerPoly.cofactor_of_divides at A, add, zero, neg,
    mul, one, hornerGcdLeading{A}(add, zero, neg, mul, one, a, b, cs, ds), b,
    hornerGcdLower{A}(add, zero, neg, mul, one, a, b, cs, ds), ds
    with field, gIn, gNonzero, gsList, right, rightNonzero, dividesRight
  obtain ⟨e, eIn, eNonzero, ds1, ds1List, ds1Length, qEq⟩ := rightFactor
  -- The lists q/g and −p/g, padded to lengths n − j and m − j.
  have jBelowN : j ≤ length{A}(ds) by arith
  have jBelowM : j ≤ length{A}(cs) by arith
  have cancelN := sub.cancel_of_le at length{A}(ds), j with jBelowN
  have cancelM := sub.cancel_of_le at length{A}(cs), j with jBelowM
  have fullE := hornerFullList.list at A, e, ds1 with eIn
  have fullELength := hornerFullList.length at A, e, ds1
  have fullC := hornerFullList.list at A, c, cs1 with cIn
  have fullCLength := hornerFullList.length at A, c, cs1
  have negC := hornerNeg.data at A, add, zero, neg, mul, one,
      hornerFullList{A}(c, cs1)
    with ring, fullC
  have gapU : succ(length{A}(ds1)) ≤ length{A}(ds) - j by arith
  have gapV : succ(length{A}(cs1)) ≤ length{A}(cs) - j by arith
  have cancelU :
      sylvesterRow.indexSum(sylvesterRow.indexDifference(length{A}(ds) - j,
      succ(length{A}(ds1))),
      succ(length{A}(ds1))) = length{A}(ds) - j
    rw [sylvesterRow.indexSum.value, sylvesterRow.indexDifference.value]
    exact sub.cancel_of_le at length{A}(ds) - j, succ(length{A}(ds1)) with gapU
  rw sylvesterRow.indexSum.value at cancelU
  have cancelV :
      sylvesterRow.indexSum(sylvesterRow.indexDifference(length{A}(cs) - j,
      succ(length{A}(cs1))),
      succ(length{A}(cs1))) = length{A}(cs) - j
    rw [sylvesterRow.indexSum.value, sylvesterRow.indexDifference.value]
    exact sub.cancel_of_le at length{A}(cs) - j, succ(length{A}(cs1)) with gapV
  rw sylvesterRow.indexSum.value at cancelV
  have padU := listReplicate.closed at A, zero,
      sylvesterRow.indexDifference(length{A}(ds) - j,
      succ(length{A}(ds1))) with zeroIn
  have padULength := listReplicate.length at A, zero,
      sylvesterRow.indexDifference(length{A}(ds) - j,
      succ(length{A}(ds1))) with zeroIn
  have padV := listReplicate.closed at A, zero,
      sylvesterRow.indexDifference(length{A}(cs) - j,
      succ(length{A}(cs1))) with zeroIn
  have padVLength := listReplicate.length at A, zero,
      sylvesterRow.indexDifference(length{A}(cs) - j,
      succ(length{A}(cs1))) with zeroIn
  have usList := append.closed at A, hornerFullList{A}(e, ds1),
    listReplicate(sylvesterRow.indexDifference(length{A}(ds) - j,
        succ(length{A}(ds1))), zero) with fullE, padU
  have vsList := append.closed at A, hornerNeg{A}(neg, hornerFullList{A}(c,
      cs1)),
    listReplicate(sylvesterRow.indexDifference(length{A}(cs) - j,
        succ(length{A}(cs1))), zero) with negC.left, padV
  have usLengthRaw := length.append at A,
      listReplicate(sylvesterRow.indexDifference(length{A}(ds) - j,
      succ(length{A}(ds1))), zero),
    hornerFullList{A}(e, ds1) with padU, fullE
  have vsLengthRaw := length.append at A,
      listReplicate(sylvesterRow.indexDifference(length{A}(cs) - j,
      succ(length{A}(cs1))), zero),
    hornerNeg{A}(neg, hornerFullList{A}(c, cs1)) with padV, negC.left
  have usLength :
      length{A}(append{A}(listReplicate(sylvesterRow.indexDifference(length{A}(
          ds) - j, succ(length{A}(ds1))), zero), hornerFullList{A}(e,
          ds1))) = length{A}(ds) - j
    rw [usLengthRaw, padULength, fullELength]
    arith
  have vsLength :
      length{A}(append{A}(listReplicate(sylvesterRow.indexDifference(length{A}(
          cs) - j, succ(length{A}(cs1))), zero), hornerNeg{A}(neg,
          hornerFullList{A}(c, cs1)))) = length{A}(cs) - j
    rw [vsLengthRaw, padVLength, negC.right, fullCLength]
    arith
  have usPoly : hornerPoly{A}(add, zero, neg, mul, one, zero,
      append{A}(listReplicate(sylvesterRow.indexDifference(length{A}(ds) - j,
      succ(length{A}(ds1))), zero), hornerFullList{A}(e,
      ds1))) = hornerPoly{A}(add, zero, neg, mul, one, e, ds1)
    have padEq := hornerPoly.pad at A, add, zero, neg, mul, one,
        hornerFullList{A}(e, ds1),
      sylvesterRow.indexDifference(length{A}(ds) - j,
          succ(length{A}(ds1))) with ring, fullE
    have fullEq := hornerPoly.full_list at A, add, zero, neg, mul, one, e, ds1
      with ring, eIn
    rw [padEq, fullEq]
    rfl
  have vsPoly : hornerPoly{A}(add, zero, neg, mul, one, zero,
      append{A}(listReplicate(sylvesterRow.indexDifference(length{A}(cs) - j,
      succ(length{A}(cs1))), zero), hornerNeg{A}(neg, hornerFullList{A}(c,
      cs1)))) = P[-hornerPoly{A}(add, zero, neg, mul, one, c, cs1)]
    have padEq := hornerPoly.pad at A, add, zero, neg, mul, one,
        hornerNeg{A}(neg, hornerFullList{A}(c, cs1)),
      sylvesterRow.indexDifference(length{A}(cs) - j,
          succ(length{A}(cs1))) with ring, negC.left
    have negEq := hornerPoly.neg_list at A, add, zero, neg, mul, one,
        hornerFullList{A}(c, cs1)
      with ring, fullC
    have fullEq := hornerPoly.full_list at A, add, zero, neg, mul, one, c, cs1
      with ring, cIn
    rw [padEq, negEq, fullEq]
    rfl
  have p1In := hornerPoly.member at A, add, zero, neg, mul, one, c, cs1
    with ring, cIn
  have q1In := hornerPoly.member at A, add, zero, neg, mul, one, e, ds1
    with ring, eIn
  have gPoly := hornerPoly.member at A, add, zero, neg, mul, one,
    hornerGcdLeading{A}(add, zero, neg, mul, one, a, b, cs, ds),
    hornerGcdLower{A}(add, zero, neg, mul, one, a, b, cs, ds) with ring, gIn
  have combination : P[hornerPoly{A}(add, zero, neg, mul, one, zero,
      append{A}(listReplicate(sylvesterRow.indexDifference(length{A}(ds) - j,
      succ(length{A}(ds1))), zero), hornerFullList{A}(e,
      ds1))) * hornerPoly{A}(add, zero, neg, mul, one, a, cs) +
      hornerPoly{A}(add, zero, neg, mul, one, zero,
          append{A}(listReplicate(sylvesterRow.indexDifference(length{A}(cs) -
          j, succ(length{A}(cs1))), zero), hornerNeg{A}(neg,
          hornerFullList{A}(c, cs1)))) * hornerPoly{A}(add, zero, neg, mul,
          one, b, ds)] = P[0]
    rw [usPoly, vsPoly, pEq, qEq]
    ring
  have vanishing : ∀ t ∈ ℕ,
      ∀ l ∈
      length{A}(append{A}(listReplicate(sylvesterRow.indexDifference(length{A}(
          ds) - j, succ(length{A}(ds1))), zero), hornerFullList{A}(e,
          ds1))) + length{A}(append{A}(listReplicate(
          sylvesterRow.indexDifference(length{A}(cs) - j, succ(length{A}(
          cs1))), zero), hornerNeg{A}(neg, hornerFullList{A}(c, cs1)))),
      sylvesterRow.indexSum(l,
          succ(t)) = length{A}(cs) +
          length{A}(append{A}(listReplicate(sylvesterRow.indexDifference(
              length{A}(ds) - j, succ(length{A}(ds1))), zero),
              hornerFullList{A}(e, ds1))) →
      call2(polynomialAdd(oneVariable, A, add, zero, neg, mul, one),
        call2(polynomialMul(oneVariable, A, add, zero, neg, mul, one),
          hornerPoly{A}(add, zero, neg, mul, one, zero,
              append{A}(listReplicate(sylvesterRow.indexDifference(length{A}(
                  ds) - j, succ(length{A}(ds1))), zero), hornerFullList{A}(e,
                  ds1))), hornerPoly{A}(add, zero, neg, mul, one, a, cs)),
        call2(polynomialMul(oneVariable, A, add, zero, neg, mul, one),
          hornerPoly{A}(add, zero, neg, mul, one, zero,
              append{A}(listReplicate(sylvesterRow.indexDifference(length{A}(
                  cs) - j, succ(length{A}(cs1))), zero), hornerNeg{A}(neg,
                  hornerFullList{A}(c, cs1)))), hornerPoly{A}(add, zero, neg,
                  mul, one, b, ds)))(monomialShift(oneVariable, (0:N),
            monomialOne(oneVariable), t)) = zero
    intros t tMember l hl equation
    have tNat := nat.omega.backward with tMember
    have monomial := monomialShift.member at oneVariable, (0 : Nat),
      monomialOne(oneVariable), t with unit
    rw combination
    exact constantFunction.apply at monomials(oneVariable), A,
      monomialShift(oneVariable, (0:N), monomialOne(oneVariable), t), zero
      with monomial, zeroIn
  have nontrivial : ∃ k ∈ ℕ, listCoefficient{A}(zero,
      append{A}(listReplicate(sylvesterRow.indexDifference(length{A}(ds) - j,
      succ(length{A}(ds1))), zero), hornerFullList{A}(e, ds1)), k) ≠ zero ∨
      listCoefficient{A}(zero,
          append{A}(listReplicate(sylvesterRow.indexDifference(length{A}(cs) -
          j, succ(length{A}(cs1))), zero), hornerNeg{A}(neg,
          hornerFullList{A}(c, cs1))), k) ≠ zero
    by_contra absent
    have allZero : ∀ k, Nat(k) → listCoefficient{A}(zero,
        append{A}(listReplicate(sylvesterRow.indexDifference(length{A}(ds) - j,
        succ(length{A}(ds1))), zero), hornerFullList{A}(e, ds1)), k) = zero
      intros k kNat
      by_contra nonzero
      apply absent
      have kMember := nat.omega.forward with kNat
      refine ⟨k, kMember, ?_⟩
      left
      exact nonzero
    have usZero : hornerPoly{A}(add, zero, neg, mul, one, zero,
        append{A}(listReplicate(sylvesterRow.indexDifference(length{A}(ds) - j,
        succ(length{A}(ds1))), zero), hornerFullList{A}(e, ds1))) = P[0]
      have rule := hornerPoly.zero_iff at A, add, zero, neg, mul, one, zero,
        append{A}(listReplicate(sylvesterRow.indexDifference(length{A}(ds) - j,
            succ(length{A}(ds1))), zero), hornerFullList{A}(e, ds1)) with ring,
            zeroIn, usList
      apply rule.backward
      unfold HornerZero
      intros k kNat
      have usNat :
          Nat(length{A}(append{A}(listReplicate(sylvesterRow.indexDifference(
              length{A}(ds) - j, succ(length{A}(ds1))), zero),
              hornerFullList{A}(e, ds1)))) by typecheck
      have comparison := Less.trichotomy at k,
          length{A}(append{A}(listReplicate(sylvesterRow.indexDifference(
              length{A}(ds) - j, succ(length{A}(ds1))), zero),
              hornerFullList{A}(e, ds1)))
        with kNat, usNat
      rcases comparison with belowLength | rest
      . have value := hornerCoefficient.below at A, zero, zero,
          append{A}(listReplicate(sylvesterRow.indexDifference(length{A}(ds) -
          j, succ(length{A}(ds1))), zero), hornerFullList{A}(e, ds1)), k
          with usList, belowLength
        rw value
        exact allZero with k, kNat
      . rcases rest with same | above
        . have value := hornerCoefficient.leading at A, zero, zero,
            append{A}(listReplicate(sylvesterRow.indexDifference(length{A}(ds)
            - j, succ(length{A}(ds1))), zero), hornerFullList{A}(e, ds1))
            with usList, zeroIn
          rw same
          exact value
        . exact hornerCoefficient.above at A, zero, zero,
            append{A}(listReplicate(sylvesterRow.indexDifference(length{A}(ds)
            - j, succ(length{A}(ds1))), zero), hornerFullList{A}(e, ds1)), k
            with usList, above
    rw usPoly at usZero
    have qNonzero : hornerPoly{A}(add, zero, neg, mul, one, b, ds) ≠ P[0]
      unfold hornerPoly
      exact polynomialFromHorner.nonzero_of_leading at oneVariable, A, add,
        zero, neg, mul, one, (0:N), b, ds with ring, index, right, rightNonzero
    apply qNonzero
    rw [qEq, usZero]
    ring
  have balance : length{A}(cs) +
      length{A}(append{A}(listReplicate(sylvesterRow.indexDifference(length{A}(
          ds) - j, succ(length{A}(ds1))), zero), hornerFullList{A}(e, ds1))) =
      length{A}(ds) +
          length{A}(append{A}(listReplicate(sylvesterRow.indexDifference(
              length{A}(cs) - j, succ(length{A}(cs1))), zero), hornerNeg{A}(
              neg, hornerFullList{A}(c, cs1))))
    rw [usLength, vsLength]
    arith
  have bound :
      length{A}(append{A}(listReplicate(sylvesterRow.indexDifference(length{A}(
          cs) - j, succ(length{A}(cs1))), zero), hornerNeg{A}(neg,
          hornerFullList{A}(c, cs1)))) ≤ length{A}(cs)
    rw vsLength
    arith
  have vanish := sylvesterBlockMatrix.det_zero_of_combination at A, add, zero,
    neg, mul, one, a, b,
        append{A}(listReplicate(sylvesterRow.indexDifference(length{A}(ds) - j,
        succ(length{A}(ds1))), zero), hornerFullList{A}(e, ds1)),
    append{A}(listReplicate(sylvesterRow.indexDifference(length{A}(cs) - j,
        succ(length{A}(cs1))), zero), hornerNeg{A}(neg, hornerFullList{A}(c,
        cs1))), cs, ds
    with field, left, right, usList, vsList, balance, bound, vanishing,
      nontrivial
  rw [usLength, vsLength] at vanish
  have twice : (2:N) * j ≤ length{A}(cs) + length{A}(ds) by arith
  have cancelSize := sub.cancel_of_le at length{A}(cs) + length{A}(ds),
    (2:N) * j with twice
  have sizeEq : (length{A}(ds) - j) + (length{A}(cs) - j) =
      (length{A}(cs) + length{A}(ds)) - (2 * j)
    arith
  rw sizeEq at vanish
  unfold principalSubresultant
  unfold subresultantMatrix
  exact vanish
-- The Bézout lists of the pair also witness the coprimality of the
-- cofactors by the gcd.
theorem hornerGcd.cofactor_bezout (c e : Set) (cs ds cs1 ds1 : List(A))
  requires cIn : c ∈ R
  requires eIn : e ∈ R
  requires pEq : hornerPoly{A}(add, zero, neg, mul, one, a, cs) =
    P[hornerPoly{A}(add, zero, neg, mul, one, c, cs1) *
      hornerPoly{A}(add, zero, neg, mul, one,
      hornerGcdLeading{A}(add, zero, neg, mul, one, a, b, cs, ds),
      hornerGcdLower{A}(add, zero, neg, mul, one, a, b, cs, ds))]
  requires qEq : hornerPoly{A}(add, zero, neg, mul, one, b, ds) =
    P[hornerPoly{A}(add, zero, neg, mul, one, e, ds1) *
      hornerPoly{A}(add, zero, neg, mul, one,
      hornerGcdLeading{A}(add, zero, neg, mul, one, a, b, cs, ds),
      hornerGcdLower{A}(add, zero, neg, mul, one, a, b, cs, ds))]
  shows ∃ us, List(A, us) ∧ ∃ vs, List(A, vs) ∧
    hornerPoly{A}(add, zero, neg, mul, one, one, []) =
      P[hornerPoly{A}(add, zero, neg, mul, one, zero, us) * hornerPoly{A}(add,
          zero, neg, mul, one, c, cs1) +
        hornerPoly{A}(add, zero, neg, mul, one, zero, vs) * hornerPoly{A}(add,
            zero, neg, mul, one, e, ds1)]
proof
  have ring := IsField.comm_ring with field
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have oneIn : R[1] ∈ R by typecheck
  have gIn := hornerGcdLeading.mem at A, add, zero, neg, mul, one, a, b, cs, ds
    with field, left, right
  have gNonzero := hornerGcd.nonzero_of_left at A, add, zero, neg, mul, one,
    a, b, cs, ds with field, left, right, leftNonzero
  have gsList := hornerGcdLower.list at A, add, zero, neg, mul, one, a, b, cs,
    ds with field, left, right
  have gPoly := hornerPoly.member at A, add, zero, neg, mul, one,
    hornerGcdLeading{A}(add, zero, neg, mul, one, a, b, cs, ds),
    hornerGcdLower{A}(add, zero, neg, mul, one, a, b, cs, ds) with ring, gIn
  have p1In := hornerPoly.member at A, add, zero, neg, mul, one, c, cs1
    with ring, cIn
  have q1In := hornerPoly.member at A, add, zero, neg, mul, one, e, ds1
    with ring, eIn
  obtain ⟨us, usList, vs, vsList, bezout⟩ := hornerGcd.bezout at A, add, zero,
    neg, mul, one, a, b, cs, ds with field, left, right
  rw [pEq, qEq] at bezout
  have uIn := hornerPoly.member at A, add, zero, neg, mul, one, zero, us
    with ring, zeroIn, usList
  have vIn := hornerPoly.member at A, add, zero, neg, mul, one, zero, vs
    with ring, zeroIn, vsList
  refine ⟨us, usList, vs, vsList, ?_⟩
  have fullC := hornerFullList.list at A, c, cs1 with cIn
  have fullE := hornerFullList.list at A, e, ds1 with eIn
  have fullCEq := hornerPoly.full_list at A, add, zero, neg, mul, one, c, cs1
    with ring, cIn
  have fullEEq := hornerPoly.full_list at A, add, zero, neg, mul, one, e, ds1
    with ring, eIn
  have w1Data := hornerMulList.data at A, add, zero, neg, mul, one, zero, zero,
    us, hornerFullList{A}(c, cs1) with ring, zeroIn, zeroIn, usList, fullC
  have w1Eq := hornerPoly.mul_lists at A, add, zero, neg, mul, one, us,
    hornerFullList{A}(c, cs1) with ring, usList, fullC
  have w2Data := hornerMulList.data at A, add, zero, neg, mul, one, zero, zero,
    vs, hornerFullList{A}(e, ds1) with ring, zeroIn, zeroIn, vsList, fullE
  have w2Eq := hornerPoly.mul_lists at A, add, zero, neg, mul, one, vs,
    hornerFullList{A}(e, ds1) with ring, vsList, fullE
  obtain ⟨w3, w3List, w3Eq⟩ := hornerPoly.exists_sum at A, add, zero, neg,
    mul, one, hornerMulList{A}(add, zero, mul, zero, zero, us,
        hornerFullList{A}(c, cs1)),
    hornerMulList{A}(add, zero, mul, zero, zero, vs, hornerFullList{A}(e,
        ds1)) with ring, w1Data.left, w2Data.left
  have oneList : List(A, one :: []) by typecheck
  have negOneData := hornerNeg.data at A, add, zero, neg, mul, one, one :: []
    with ring, oneList
  have negOneEq := hornerPoly.neg_list at A, add, zero, neg, mul, one,
    one :: [] with ring, oneList
  have single := hornerPoly.singleton at A, add, zero, neg, mul, one, one
    with ring, oneIn
  have onePoly := hornerPoly.one_list at A, add, zero, neg, mul, one with ring
  have constOne := hornerPoly.constant at A, add, zero, neg, mul, one, one
    with ring, oneIn
  obtain ⟨w4, w4List, w4Eq⟩ := hornerPoly.exists_sum at A, add, zero, neg,
    mul, one, w3, hornerNeg{A}(neg, one :: []) with ring, w3List,
        negOneData.left
  have padList := listReplicate.closed at A, zero,
      length{A}(hornerGcdLower{A}(add, zero, neg, mul, one, a, b, cs, ds))
    with zeroIn
  have padLength := listReplicate.length at A, zero,
      length{A}(hornerGcdLower{A}(add, zero, neg, mul, one, a, b, cs, ds))
    with zeroIn
  have padPoly := CAD.HornerDivision.hornerPoly.replicate_zero at A, add, zero,
      neg, mul, one,
    length{A}(hornerGcdLower{A}(add, zero, neg, mul, one, a, b, cs,
        ds)) with ring
  have key : P[(hornerPoly{A}(add, zero, neg, mul, one, zero,
      us) * hornerPoly{A}(add, zero, neg, mul, one, c, cs1) +
      hornerPoly{A}(add, zero, neg, mul, one, zero, vs) * hornerPoly{A}(add,
          zero, neg, mul, one, e, ds1)) *
      hornerPoly{A}(add, zero, neg, mul, one,
      hornerGcdLeading{A}(add, zero, neg, mul, one, a, b, cs, ds),
      hornerGcdLower{A}(add, zero, neg, mul, one, a, b, cs, ds))] =
      P[hornerPoly{A}(add, zero, neg, mul, one, zero, us) * (hornerPoly{A}(add,
          zero, neg, mul, one, c, cs1) * hornerPoly{A}(add, zero, neg, mul, one,
      hornerGcdLeading{A}(add, zero, neg, mul, one, a, b, cs, ds),
      hornerGcdLower{A}(add, zero, neg, mul, one, a, b, cs, ds))) +
        hornerPoly{A}(add, zero, neg, mul, one, zero, vs) * (hornerPoly{A}(add,
            zero, neg, mul, one, e, ds1) * hornerPoly{A}(add, zero, neg, mul,
            one,
      hornerGcdLeading{A}(add, zero, neg, mul, one, a, b, cs, ds),
      hornerGcdLower{A}(add, zero, neg, mul, one, a, b, cs, ds)))]
    ring
  rw ← bezout at key
  have vanishes : P[hornerPoly{A}(add, zero, neg, mul, one, zero,
      w4) * hornerPoly{A}(add, zero, neg, mul, one,
      hornerGcdLeading{A}(add, zero, neg, mul, one, a, b, cs, ds),
      hornerGcdLower{A}(add, zero, neg, mul, one, a, b, cs, ds)) +
      hornerPoly{A}(add, zero, neg, mul, one, zero,
          listReplicate(length{A}(hornerGcdLower{A}(add, zero, neg, mul, one,
          a, b, cs, ds)), zero))] = P[0]
    rw [w4Eq, w3Eq, w1Eq, w2Eq, fullCEq, fullEEq, negOneEq, single, padPoly]
    have expand : P[((hornerPoly{A}(add, zero, neg, mul, one, zero,
        us) * hornerPoly{A}(add, zero, neg, mul, one, c, cs1) +
        hornerPoly{A}(add, zero, neg, mul, one, zero, vs) * hornerPoly{A}(add,
            zero, neg, mul, one, e, ds1)) + -(1)) * hornerPoly{A}(add, zero,
            neg, mul, one,
      hornerGcdLeading{A}(add, zero, neg, mul, one, a, b, cs, ds),
      hornerGcdLower{A}(add, zero, neg, mul, one, a, b, cs, ds)) + 0] =
        P[(hornerPoly{A}(add, zero, neg, mul, one, zero,
            us) * hornerPoly{A}(add, zero, neg, mul, one, c, cs1) +
          hornerPoly{A}(add, zero, neg, mul, one, zero,
              vs) * hornerPoly{A}(add, zero, neg, mul, one, e,
              ds1)) * hornerPoly{A}(add, zero, neg, mul, one,
      hornerGcdLeading{A}(add, zero, neg, mul, one, a, b, cs, ds),
      hornerGcdLower{A}(add, zero, neg, mul, one, a, b, cs,
          ds)) - hornerPoly{A}(add, zero, neg, mul, one,
      hornerGcdLeading{A}(add, zero, neg, mul, one, a, b, cs, ds),
      hornerGcdLower{A}(add, zero, neg, mul, one, a, b, cs, ds))]
      ring
    rw [expand, key]
    ring
  have result := hornerDivision.zero_of_combination at A, add, zero, neg, mul,
    one, hornerGcdLeading{A}(add, zero, neg, mul, one, a, b, cs, ds),
    hornerGcdLower{A}(add, zero, neg, mul, one, a, b, cs, ds), w4,
        listReplicate(length{A}(hornerGcdLower{A}(add, zero, neg, mul, one, a,
        b, cs, ds)), zero)
    with field, gIn, gNonzero, gsList, w4List, padList, padLength, vanishes
  have w4Zero := result.left
  rw [w4Eq, w3Eq, w1Eq, w2Eq, fullCEq, fullEEq, negOneEq, single] at w4Zero
  have shift : P[hornerPoly{A}(add, zero, neg, mul, one, zero,
      us) * hornerPoly{A}(add, zero, neg, mul, one, c, cs1) +
      hornerPoly{A}(add, zero, neg, mul, one, zero, vs) * hornerPoly{A}(add,
          zero, neg, mul, one, e, ds1)] =
      P[((hornerPoly{A}(add, zero, neg, mul, one, zero,
          us) * hornerPoly{A}(add, zero, neg, mul, one, c, cs1) +
        hornerPoly{A}(add, zero, neg, mul, one, zero, vs) * hornerPoly{A}(add,
            zero, neg, mul, one, e, ds1)) + -(1)) + 1]
    ring
  rw [onePoly, shift, w4Zero]
  ring

end Fields

-- The left inverse of the subresultant matrix at the degree of the gcd:
-- for the coprime cofactor pair (c, cs), (e, ds) with Bézout lists u0, v0
-- and the gcd (g, gs), row l holds the combination lists of the quotient
-- of X^(m + n − d − 1 − l) by the gcd.
defgraph principalSubresultant.inverseMatrix (A add zero neg mul one c e u0 v0
    cs ds g gs : Set)
    (p ∈ (length{A}(cs) + length{A}(ds)) × (length{A}(cs) + length{A}(ds))) :
    A :=
  sylvesterVector(A, zero,
    resultant.combinationLeft{A}(add, zero, neg, mul, one, e, u0, ds,
      hornerFullList{A}(hornerTrimLeading{A}(zero, hornerDivQuotient{A}(add,
          zero, neg, mul, one, g, one, gs,
      listReplicate(sylvesterRow.indexDifference(length{A}(cs) + length{A}(ds) +
        length{A}(gs), succ(fst(p))), zero))),
      hornerTrimLower{A}(zero, hornerDivQuotient{A}(add, zero, neg, mul, one,
          g, one, gs,
      listReplicate(sylvesterRow.indexDifference(length{A}(cs) + length{A}(ds) +
        length{A}(gs), succ(fst(p))), zero))))),
    resultant.combinationRight{A}(add, zero, neg, mul, one, c, e, u0, v0, cs,
      ds, hornerFullList{A}(hornerTrimLeading{A}(zero,
          hornerDivQuotient{A}(add, zero, neg, mul, one, g, one, gs,
      listReplicate(sylvesterRow.indexDifference(length{A}(cs) + length{A}(ds) +
        length{A}(gs), succ(fst(p))), zero))),
      hornerTrimLower{A}(zero, hornerDivQuotient{A}(add, zero, neg, mul, one,
          g, one, gs,
      listReplicate(sylvesterRow.indexDifference(length{A}(cs) + length{A}(ds) +
        length{A}(gs), succ(fst(p))), zero))))),
    length{A}(ds), length{A}(cs) + length{A}(ds))(snd(p))
requires field : IsField(A, add, zero, neg, mul, one)
requires leftIn : c ∈ A
requires rightIn : e ∈ A
requires leftNonzero : c ≠ zero
requires rightNonzero : e ≠ zero
requires csList : List(A, cs)
requires dsList : List(A, ds)
requires u0List : List(A, u0)
requires v0List : List(A, v0)
requires divisor : g ∈ A
requires divisorNonzero : g ≠ zero
requires gsList : List(A, gs)
proof
  have ring := IsField.comm_ring with field
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have multiplicative := IsRing.multiplicative with ordinary
  have oneIn := IsMonoid.unit_in_carrier with multiplicative
  obtain ⟨bound, l, hl, i, hi, shape⟩ := product.membership.forward with member
  have sizeNat : Nat(length{A}(cs) + length{A}(ds)) by typecheck
  have lNat := natural.member at length{A}(cs) + length{A}(ds) with hl
  have topNat : Nat(sylvesterRow.indexDifference(length{A}(cs) + length{A}(ds) +
    length{A}(gs), succ(l))) by typecheck
  have powList := listReplicate.closed at A, zero,
      sylvesterRow.indexDifference(length{A}(cs) + length{A}(ds) +
        length{A}(gs), succ(l)) with zeroIn
  have quotientData := hornerDivQuotient.data at A, add, zero, neg, mul, one,
    g, one, gs,
        listReplicate(sylvesterRow.indexDifference(length{A}(cs) +
        length{A}(ds) +
        length{A}(gs), succ(l)), zero)
    with field, divisor, divisorNonzero, gsList, oneIn, powList
  have trimIn := hornerTrimLeading.mem at A, zero, hornerDivQuotient{A}(add,
      zero, neg, mul, one, g, one, gs,
      listReplicate(sylvesterRow.indexDifference(length{A}(cs) + length{A}(ds) +
        length{A}(gs), succ(l)), zero))
    with zeroIn, quotientData.left
  have trimList := hornerTrimLower.list at A, zero, hornerDivQuotient{A}(add,
      zero, neg, mul, one, g, one, gs,
      listReplicate(sylvesterRow.indexDifference(length{A}(cs) + length{A}(ds) +
        length{A}(gs), succ(l)), zero))
    with quotientData.left
  have tsList := hornerFullList.list at A, hornerTrimLeading{A}(zero,
      hornerDivQuotient{A}(add, zero, neg, mul, one, g, one, gs,
      listReplicate(sylvesterRow.indexDifference(length{A}(cs) + length{A}(ds) +
        length{A}(gs), succ(l)), zero))),
    hornerTrimLower{A}(zero, hornerDivQuotient{A}(add, zero, neg, mul, one, g,
        one, gs,
      listReplicate(sylvesterRow.indexDifference(length{A}(cs) + length{A}(ds) +
        length{A}(gs), succ(l)), zero)))
    with trimIn, trimList
  have lists := resultant.combination_lists at A, add, zero, neg, mul, one, c,
    e, cs, ds, u0, v0, hornerFullList{A}(hornerTrimLeading{A}(zero,
        hornerDivQuotient{A}(add, zero, neg, mul, one, g, one, gs,
      listReplicate(sylvesterRow.indexDifference(length{A}(cs) + length{A}(ds) +
        length{A}(gs), succ(l)), zero))),
      hornerTrimLower{A}(zero, hornerDivQuotient{A}(add, zero, neg, mul, one,
          g, one, gs,
      listReplicate(sylvesterRow.indexDifference(length{A}(cs) + length{A}(ds) +
        length{A}(gs), succ(l)), zero))))
    with field, leftIn, rightIn, leftNonzero, rightNonzero, csList, dsList,
      u0List, v0List, tsList
  have vector := sylvesterVector.function at A, zero,
    resultant.combinationLeft{A}(add, zero, neg, mul, one, e, u0, ds,
      hornerFullList{A}(hornerTrimLeading{A}(zero, hornerDivQuotient{A}(add,
          zero, neg, mul, one, g, one, gs,
      listReplicate(sylvesterRow.indexDifference(length{A}(cs) + length{A}(ds) +
        length{A}(gs), succ(l)), zero))),
      hornerTrimLower{A}(zero, hornerDivQuotient{A}(add, zero, neg, mul, one,
          g, one, gs,
      listReplicate(sylvesterRow.indexDifference(length{A}(cs) + length{A}(ds) +
        length{A}(gs), succ(l)), zero))))),
    resultant.combinationRight{A}(add, zero, neg, mul, one, c, e, u0, v0, cs,
      ds, hornerFullList{A}(hornerTrimLeading{A}(zero,
          hornerDivQuotient{A}(add, zero, neg, mul, one, g, one, gs,
      listReplicate(sylvesterRow.indexDifference(length{A}(cs) + length{A}(ds) +
        length{A}(gs), succ(l)), zero))),
      hornerTrimLower{A}(zero, hornerDivQuotient{A}(add, zero, neg, mul, one,
          g, one, gs,
      listReplicate(sylvesterRow.indexDifference(length{A}(cs) + length{A}(ds) +
        length{A}(gs), succ(l)), zero))))),
    length{A}(ds), length{A}(cs) + length{A}(ds)
    with zeroIn, lists.left, lists.right.right.left
  rw [shape, fst.pair, snd.pair]
  exact FunctionBetween.apply_closed with vector, hi

section Fields
variable (A add zero neg mul one a b : Set)
notation ring R := (A, add, zero, neg, mul, one)
notation ring P := R[oneVariable]
hypothesis field : IsField(R)
hypothesis left : a ∈ R
hypothesis right : b ∈ R
hypothesis leftNonzero : a ≠ R[0]
hypothesis rightNonzero : b ≠ R[0]

theorem principalSubresultant.nonzero_at_gcd_degree (cs ds : List(A))
  shows principalSubresultant(R, a, cs, b, ds,
    length{A}(hornerGcdLower{A}(add, zero, neg, mul, one, a, b, cs, ds))) ≠ R[0]
proof
  have ring := IsField.comm_ring with field
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have oneIn : R[1] ∈ R by typecheck
  have index := oneVariable.index
  have unit := monomialOne.member at oneVariable
  have target := polynomials.comm_ring at oneVariable, A, add, zero, neg, mul,
    one with ring
  have polynomialRing := IsCommRing.ring with target
  have gIn := hornerGcdLeading.mem at A, add, zero, neg, mul, one, a, b, cs, ds
    with field, left, right
  have gNonzero := hornerGcd.nonzero_of_left at A, add, zero, neg, mul, one,
    a, b, cs, ds with field, left, right, leftNonzero
  have gsList := hornerGcdLower.list at A, add, zero, neg, mul, one, a, b, cs,
    ds with field, left, right
  have dividesLeft := hornerGcd.divides_left at A, add, zero, neg, mul, one, a,
    b, cs, ds with field, left, right
  have dividesRight := hornerGcd.divides_right at A, add, zero, neg, mul, one,
    a, b, cs, ds with field, left, right
  have leftFactor := hornerPoly.cofactor_of_divides at A, add, zero, neg, mul,
    one, hornerGcdLeading{A}(add, zero, neg, mul, one, a, b, cs, ds), a,
    hornerGcdLower{A}(add, zero, neg, mul, one, a, b, cs, ds), cs
    with field, gIn, gNonzero, gsList, left, leftNonzero, dividesLeft
  obtain ⟨c, cIn, cNonzero, cs1, cs1List, cs1Length, pEq⟩ := leftFactor
  have rightFactor := hornerPoly.cofactor_of_divides at A, add, zero, neg,
    mul, one, hornerGcdLeading{A}(add, zero, neg, mul, one, a, b, cs, ds), b,
    hornerGcdLower{A}(add, zero, neg, mul, one, a, b, cs, ds), ds
