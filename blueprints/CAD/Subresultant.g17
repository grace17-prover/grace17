-- The principal subresultant coefficients of two Horner pairs: psc_j is
-- the determinant of the j-th subresultant matrix, the Sylvester block
-- matrix with the last j rows of each block and the last 2j columns
-- removed, of size m + n − 2j, for 0 ≤ j ≤ min(m, n); psc_0 is the
-- resultant. Transport under ring homomorphisms and evaluation, the top
-- values, and the gcd-degree lemma: over a field the degree of the gcd is
-- the least j with psc_j ≠ 0.
-- Part of the CAD blueprint.
-- Planned home: Algebra/Polynomial/Subresultant.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module CAD.Subresultant
import CAD.ResultantGcd
import Grace.Cumulus.Nat.Least
import Grace.Cumulus.Nat.MinMax

-- The j-th subresultant matrix has size m + n − 2j.
def subresultantMatrix {A : Set} (zero a b : Set)
  (cs ds : List(A), j : Nat) : Set :=
  sylvesterBlockMatrix(A, zero, a, b, cs, ds, length{A}(ds) - j,
    (length{A}(cs) + length{A}(ds)) - (2 * j))

def principalSubresultant {A : Set} (add zero neg mul one a b : Set)
  (cs ds : List(A), j : Nat) : Set :=
  determinant((length{A}(cs) + length{A}(ds)) - (2 * j), A, add, zero, neg,
    mul, one, subresultantMatrix{A}(zero, a, b, cs, ds, j))
notation scoped principalSubresultant(R, a, cs, b, ds, j) =>
  principalSubresultant(R.carrier, R.add, R.zero, R.neg, R.mul, R.one, a, b,
    cs, ds, j)

section Rings
variable (A add zero neg mul one a b : Set)
notation ring R := (A, add, zero, neg, mul, one)
hypothesis ring : IsCommRing(R)
hypothesis left : a ∈ R
hypothesis right : b ∈ R

theorem subresultantMatrix.matrix (cs ds : List(A)) (j : Nat)
  shows RingMatrix((length{A}(cs) + length{A}(ds)) - (2 * j), R,
    subresultantMatrix{A}(zero, a, b, cs, ds, j))
proof
  sorry

theorem principalSubresultant.closed (cs ds : List(A)) (j : Nat)
  shows principalSubresultant(R, a, cs, b, ds, j) ∈ R
proof
  sorry

theorem principalSubresultant.zero_index (cs ds : List(A))
  shows principalSubresultant(R, a, cs, b, ds, 0) = resultant(R, a, cs, b, ds)
proof
  sorry

-- At j = n ≤ m the matrix is triangular with b on the diagonal.
theorem principalSubresultant.top_left (cs ds : List(A))
  requires order : length{A}(ds) ≤ length{A}(cs)
  shows principalSubresultant(R, a, cs, b, ds, length{A}(ds)) =
    monoidPow(R, b, length{A}(cs) - length{A}(ds))
proof
  sorry

theorem principalSubresultant.top_right (cs ds : List(A))
  requires order : length{A}(cs) ≤ length{A}(ds)
  shows principalSubresultant(R, a, cs, b, ds, length{A}(cs)) =
    monoidPow(R, a, length{A}(ds) - length{A}(cs))
proof
  sorry

end Rings

section Homomorphisms
variable (A add zero neg mul one B plus z minus times unit h a b : Set)
notation ring R := (A, add, zero, neg, mul, one)
notation ring S := (B, plus, z, minus, times, unit)
hypothesis source : IsCommRing(R)
hypothesis target : IsCommRing(S)
hypothesis hom : IsRingHom(h, R, S)
hypothesis left : a ∈ R
hypothesis right : b ∈ R

theorem principalSubresultant.map (cs ds : List(A)) (j : Nat)
  shows h(principalSubresultant(R, a, cs, b, ds, j)) =
    principalSubresultant(S, h(a), listMap{A}(h, cs), h(b), listMap{A}(h, ds),
      j)
proof
  sorry

end Homomorphisms

section Evaluation
variable (I A add zero neg mul one v a b : Set)
notation ring R := (A, add, zero, neg, mul, one)
notation ring P := R[I]
hypothesis ring : IsCommRing(R)
hypothesis assignment : v : I → R
hypothesis left : a ∈ P
hypothesis right : b ∈ P

theorem principalSubresultant.evaluate (cs ds : List(polynomials(I, A,
    zero))) (j : Nat)
  shows polynomialAt(I, R, v)(principalSubresultant(P, a, cs, b, ds, j)) =
    principalSubresultant(R, polynomialAt(I, R, v)(a),
      listMap{polynomials(I, A, zero)}(polynomialAt(I, R, v), cs),
      polynomialAt(I, R, v)(b),
      listMap{polynomials(I, A, zero)}(polynomialAt(I, R, v), ds), j)
proof
  sorry

end Evaluation

-- The indices of the nonzero principal subresultant coefficients.
def nonzeroSubresultantIndices {A : Set} (add zero neg mul one a b : Set)
  (cs ds : List(A)) : Set :=
  { j ∈ ℕ | principalSubresultant{A}(add, zero, neg, mul, one, a, b, cs, ds,
    j) ≠ zero }

section Fields
variable (A add zero neg mul one a b : Set)
notation ring R := (A, add, zero, neg, mul, one)
hypothesis field : IsField(R)
hypothesis left : a ∈ R
hypothesis right : b ∈ R
hypothesis leftNonzero : a ≠ R[0]
hypothesis rightNonzero : b ≠ R[0]

-- Below the degree of the gcd every principal subresultant coefficient
-- vanishes, and at that degree it does not.
theorem principalSubresultant.zero_below_gcd_degree (cs ds : List(A)) (j : Nat)
  requires below : j < length{A}(hornerGcdLower{A}(add, zero, neg, mul, one, a,
    b, cs, ds))
  shows principalSubresultant(R, a, cs, b, ds, j) = R[0]
proof
  sorry

theorem principalSubresultant.nonzero_at_gcd_degree (cs ds : List(A))
  shows principalSubresultant(R, a, cs, b, ds,
    length{A}(hornerGcdLower{A}(add, zero, neg, mul, one, a, b, cs, ds))) ≠ R[0]
proof
  sorry

theorem hornerGcd.length_le_min (cs ds : List(A))
  shows length{A}(hornerGcdLower{A}(add, zero, neg, mul, one, a, b, cs, ds)) ≤
    natMin(length{A}(cs), length{A}(ds))
proof
  sorry

-- The degree of the gcd is the least index with a nonzero coefficient.
theorem hornerGcd.length_eq_least_nonzero (cs ds : List(A))
  shows length{A}(hornerGcdLower{A}(add, zero, neg, mul, one, a, b, cs, ds)) =
    leastNatural(nonzeroSubresultantIndices{A}(add, zero, neg, mul, one, a, b,
      cs, ds))
proof
  sorry

end Fields
