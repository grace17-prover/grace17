theorem hornerGcd.length_le_min (cs ds : List(A))
  shows length{A}(hornerGcdLower{A}(add, zero, neg, mul, one, a, b, cs, ds)) ≤
    natMin(length{A}(cs), length{A}(ds))
proof
  have leftBound := hornerGcd.length_le_left at A, add, zero, neg, mul, one,
    a, b, cs, ds with field, left, right, leftNonzero
  have gIn := hornerGcdLeading.mem at A, add, zero, neg, mul, one, a, b, cs, ds
    with field, left, right
  have gNonzero := hornerGcd.nonzero_of_left at A, add, zero, neg, mul, one,
    a, b, cs, ds with field, left, right, leftNonzero
  have gsList := hornerGcdLower.list at A, add, zero, neg, mul, one, a, b, cs,
    ds with field, left, right
  have dividesRight := hornerGcd.divides_right at A, add, zero, neg, mul, one,
    a, b, cs, ds with field, left, right
  have rightBound := HornerDivides.length_le at A, add, zero, neg, mul, one,
    hornerGcdLeading{A}(add, zero, neg, mul, one, a, b, cs, ds), b,
    hornerGcdLower{A}(add, zero, neg, mul, one, a, b, cs, ds), ds
    with field, gIn, gNonzero, gsList, right, rightNonzero, dividesRight
  have rule := natMin.le_iff at length{A}(cs), length{A}(ds),
    length{A}(hornerGcdLower{A}(add, zero, neg, mul, one, a, b, cs, ds))
  exact rule.backward with ⟨leftBound, rightBound⟩

-- The degree of the gcd is the least index with a nonzero coefficient.
theorem hornerGcd.length_eq_least_nonzero (cs ds : List(A))
  shows length{A}(hornerGcdLower{A}(add, zero, neg, mul, one, a, b, cs, ds)) =
    leastNatural(nonzeroSubresultantIndices{A}(add, zero, neg, mul, one, a, b,
      cs, ds))
proof
  have gsNat : Nat(length{A}(hornerGcdLower{A}(add, zero, neg, mul, one, a, b,
      cs, ds))) by typecheck
  have gsMember := nat.omega.forward with gsNat
  have atDegree := principalSubresultant.nonzero_at_gcd_degree at A, add, zero,
    neg, mul, one, a, b, cs, ds with field, left, right, leftNonzero,
    rightNonzero
  have degreeIn : length{A}(hornerGcdLower{A}(add, zero, neg, mul, one, a, b,
      cs, ds)) ∈ nonzeroSubresultantIndices{A}(add, zero, neg, mul, one, a, b,
      cs,
      ds)
    have rule := nonzeroSubresultantIndices.membership at A, add, zero, neg,
      mul, one, a, b, cs, ds, length{A}(hornerGcdLower{A}(add, zero, neg, mul,
          one, a, b, cs, ds))
    exact rule.backward with ⟨gsMember, atDegree⟩
  have inhabited : Nonempty(nonzeroSubresultantIndices{A}(add, zero, neg, mul,
      one, a, b, cs,
      ds))
    exact ⟨length{A}(hornerGcdLower{A}(add, zero, neg, mul, one, a, b, cs,
        ds)), degreeIn⟩
  have naturals : nonzeroSubresultantIndices{A}(add, zero, neg, mul, one, a, b,
      cs,
      ds) ⊆ ℕ
    unfold Subset
    intros j hj
    have rule := nonzeroSubresultantIndices.membership at A, add, zero, neg,
      mul, one, a, b, cs, ds, j
    have pair := rule.forward with hj
    exact pair.left
  have leastIn := leastNatural.member at nonzeroSubresultantIndices{A}(add,
      zero, neg, mul, one, a, b, cs,
      ds) with inhabited, naturals
  have leastBelow := leastNatural.least at nonzeroSubresultantIndices{A}(add,
      zero, neg, mul, one, a, b, cs,
      ds), length{A}(hornerGcdLower{A}(add, zero, neg, mul, one, a, b, cs, ds))
    with inhabited, naturals, degreeIn
  have leastRule := nonzeroSubresultantIndices.membership at A, add, zero, neg,
    mul, one, a, b, cs, ds, leastNatural(nonzeroSubresultantIndices{A}(add,
        zero, neg, mul, one, a, b, cs,
      ds))
  have leastPair := leastRule.forward with leastIn
  have leastNat := nat.omega.backward with leastPair.left
  have comparison := Less.trichotomy at
      leastNatural(nonzeroSubresultantIndices{A}(add, zero, neg, mul, one, a,
      b, cs,
      ds)), length{A}(hornerGcdLower{A}(add, zero, neg, mul, one, a, b, cs, ds))
    with leastNat, gsNat
  rcases comparison with below | rest
  . exfalso
    have vanishes := principalSubresultant.zero_below_gcd_degree at A, add,
      zero, neg, mul, one, a, b, cs, ds,
          leastNatural(nonzeroSubresultantIndices{A}(add, zero, neg, mul, one,
          a, b, cs,
      ds))
      with field, left, right, leftNonzero, rightNonzero, below
    exact leastPair.right with vanishes
  . rcases rest with same | above
    . rw same
      rfl
    . exfalso
      arith
end Fields
