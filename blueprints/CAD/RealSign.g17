-- The sign of a real number as a real in {−1, 0, 1}, with the interface
-- of the integer sign: the three cases, the sign of a negation, of a
-- product, of a power of −1, and the recovery of a number from its sign
-- and absolute value.
-- Part of the CAD blueprint.
-- Planned home: Real/Sign.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module CAD.RealSign
import Grace.Cumulus.Real.AbsoluteValue
import Grace.Cumulus.Real.Power

defunique realSign (X : Real) (s ∈ ℝ) :=
  (X = (0:R) ∧ s = (0:R)) ∨ ((0:R) < X ∧ s = (1:R)) ∨ (X < (0:R) ∧ s = -(1:R))
proof
  sorry
uniqueness
  sorry

theorem realSign.real (X : Real)
  shows Real(realSign(X))
proof
  sorry

theorem realSign.of_zero (X : Real)
  requires zero : X = 0
  shows realSign(X) = (0:R)
proof
  sorry

theorem realSign.of_positive (X : Real)
  requires positive : 0 < X
  shows realSign(X) = (1:R)
proof
  sorry

theorem realSign.of_negative (X : Real)
  requires negative : X < 0
  shows realSign(X) = -(1:R)
proof
  sorry

theorem realSign.cases (X : Real)
  shows realSign(X) = (0:R) ∨ realSign(X) = (1:R) ∨ realSign(X) = -(1:R)
proof
  sorry

theorem realSign.eq_zero_iff (X : Real)
  shows realSign(X) = (0:R) ↔ X = 0
proof
  sorry

theorem realSign.eq_one_iff (X : Real)
  shows realSign(X) = (1:R) ↔ 0 < X
proof
  sorry

theorem realSign.eq_neg_one_iff (X : Real)
  shows realSign(X) = -(1:R) ↔ X < 0
proof
  sorry

theorem realSign.one
  shows realSign((1:R)) = (1:R)
proof
  sorry

theorem realSign.neg (X : Real)
  shows realSign(-X) = -realSign(X)
proof
  sorry

theorem realSign.mul (X Y : Real)
  shows realSign(X * Y) = realSign(X) * realSign(Y)
proof
  sorry

theorem realSign.mul_abs (X : Real)
  shows realSign(X) * abs(X) = X
proof
  sorry

theorem realSign.mul_self (X : Real)
  shows realSign(X) * X = abs(X)
proof
  sorry

theorem realSign.square (X : Real)
  requires nonzero : X ≠ 0
  shows realSign(X) * realSign(X) = (1:R)
proof
  sorry

theorem realSign.pow (X : Real) (n : Nat)
  shows realSign(X ^ n) = realSign(X) ^ n
proof
  sorry

theorem realSign.neg_one_pow (n : Nat)
  shows realSign((-(1:R)) ^ n) = (-(1:R)) ^ n
proof
  sorry

theorem realSign.inv (X : Real)
  shows realSign(realInvValue(X)) = realSign(X)
proof
  sorry

-- Two numbers with the same nonzero sign have a positive product.
theorem realSign.product_positive_of_eq (X Y : Real)
  requires nonzero : X ≠ 0
  requires same : realSign(X) = realSign(Y)
  shows 0 < X * Y
proof
  sorry

theorem realSign.eq_of_product_positive (X Y : Real)
  requires positive : 0 < X * Y
  shows realSign(X) = realSign(Y)
proof
  sorry

theorem realSign.ne_of_product_negative (X Y : Real)
  requires negative : X * Y < 0
  shows realSign(X) = -realSign(Y)
proof
  sorry
