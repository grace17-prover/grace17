-- The sign of a real number as a real in {−1, 0, 1}, with the interface
-- of the integer sign: the three cases, the sign of a negation, of a
-- product, of a power of −1, and the recovery of a number from its sign
-- and absolute value.
-- Part of the CAD blueprint.
-- Planned home: Real/Sign.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module CAD.RealSign
import Grace.Cumulus.Real.AbsoluteValue
import Grace.Cumulus.Real.Power

-- Products with one negative factor are negative, with two positive.
theorem realSign.product_negative (X Y : Real)
  requires positive : 0 < X
  requires negative : Y < 0
  shows X * Y < 0
proof
  have negY : 0 < -Y by linarith
  have product := realMulValue.positive with positive, negY
  have shape : X * Y = -(X * -Y) by ring
  linarith

theorem realSign.product_of_negatives (X Y : Real)
  requires negativeX : X < 0
  requires negativeY : Y < 0
  shows 0 < X * Y
proof
  have negX : 0 < -X by linarith
  have negY : 0 < -Y by linarith
  have product := realMulValue.positive with negX, negY
  have shape : X * Y = -X * -Y by ring
  linarith

defunique realSign (X : Real) (s ∈ ℝ) :=
  (X = (0:R) ∧ s = (0:R)) ∨ ((0:R) < X ∧ s = (1:R)) ∨
  (X < (0:R) ∧ s = -(1:R))
proof
  have zeroMember : realZero ∈ ℝ := realZero.real
  have oneMember : realOne ∈ ℝ := realOne.real
  have negMember : -(1:R) ∈ ℝ := realNegValue.real at realOne with oneMember
  have split := realLess.trichotomy at realZero, X
  rcases split with positive | zero | negative
  . refine ⟨(1:R), oneMember, ?_⟩
    right
    left
    exact ⟨positive, rfl⟩
  . refine ⟨(0:R), zeroMember, ?_⟩
    left
    symm at zero
    exact ⟨zero, rfl⟩
  . refine ⟨-(1:R), negMember, ?_⟩
    right
    right
    exact ⟨negative, rfl⟩
uniqueness
  intros s sMember first t tMember second
  rcases first with zeroS | positiveS | negativeS
  . rcases second with zeroT | positiveT | negativeT
    . cc
    . rw zeroS.left at positiveT
      exfalso
      exact realLess.not_self at realZero with positiveT.left
    . rw zeroS.left at negativeT
      exfalso
      exact realLess.not_self at realZero with negativeT.left
  . rcases second with zeroT | positiveT | negativeT
    . rw zeroT.left at positiveS
      exfalso
      exact realLess.not_self at realZero with positiveS.left
    . cc
    . have ordered := positiveS.left
      have reversed := negativeT.left
      exfalso
      linarith
  . rcases second with zeroT | positiveT | negativeT
    . rw zeroT.left at negativeS
      exfalso
      exact realLess.not_self at realZero with negativeS.left
    . have ordered := negativeS.left
      have reversed := positiveT.left
      exfalso
      linarith
    . cc

theorem realSign.real (X : Real)
  shows Real(realSign(X))
proof
  have selected := realSign.selected at X with *
  exact selected.left

theorem realSign.of_zero (X : Real)
  requires zero : X = 0
  shows realSign(X) = (0:R)
proof
  have selected := realSign.selected at X with *
  rcases selected with ⟨member, property⟩
  rcases property with isZero | positive | negative
  . exact isZero.right
  . rw zero at positive
    exfalso
    exact realLess.not_self at realZero with positive.left
  . rw zero at negative
    exfalso
    exact realLess.not_self at realZero with negative.left

theorem realSign.of_positive (X : Real)
  requires positive : 0 < X
  shows realSign(X) = (1:R)
proof
  have selected := realSign.selected at X with *
  rcases selected with ⟨member, property⟩
  rcases property with zero | isPositive | negative
  . rw zero.left at positive
    exfalso
    exact realLess.not_self at realZero with positive
  . exact isPositive.right
  . have reversed := negative.left
    exfalso
    linarith

theorem realSign.of_negative (X : Real)
  requires negative : X < 0
  shows realSign(X) = -(1:R)
proof
  have selected := realSign.selected at X with *
  rcases selected with ⟨member, property⟩
  rcases property with zero | positive | isNegative
  . rw zero.left at negative
    exfalso
    exact realLess.not_self at realZero with negative
  . have reversed := positive.left
    exfalso
    linarith
  . exact isNegative.right

theorem realSign.cases (X : Real)
  shows realSign(X) = (0:R) ∨ realSign(X) = (1:R) ∨ realSign(X) = -(1:R)
proof
  have split := realLess.trichotomy at realZero, X
  rcases split with positive | zero | negative
  . right
    left
    exact realSign.of_positive with positive
  . left
    symm at zero
    exact realSign.of_zero with zero
  . right
    right
    exact realSign.of_negative with negative

theorem realSign.eq_zero_iff (X : Real)
  shows realSign(X) = (0:R) ↔ X = 0
proof
  constructor
  . intro zero
    have split := realLess.trichotomy at realZero, X
    rcases split with positive | same | negative
    . have sign := realSign.of_positive with positive
      rw sign at zero
      exfalso
      linarith
    . symm
      exact same
    . have sign := realSign.of_negative with negative
      rw sign at zero
      exfalso
      linarith
  . intro zero
    exact realSign.of_zero with zero

theorem realSign.eq_one_iff (X : Real)
  shows realSign(X) = (1:R) ↔ 0 < X
proof
  constructor
  . intro one
    have split := realLess.trichotomy at realZero, X
    rcases split with positive | same | negative
    . exact positive
    . symm at same
      have sign := realSign.of_zero with same
      rw sign at one
      exfalso
      linarith
    . have sign := realSign.of_negative with negative
      rw sign at one
      exfalso
      linarith
  . intro positive
    exact realSign.of_positive with positive

theorem realSign.eq_neg_one_iff (X : Real)
  shows realSign(X) = -(1:R) ↔ X < 0
proof
  constructor
  . intro negOne
    have split := realLess.trichotomy at realZero, X
    rcases split with positive | same | negative
    . have sign := realSign.of_positive with positive
      rw sign at negOne
      exfalso
      linarith
    . symm at same
      have sign := realSign.of_zero with same
      rw sign at negOne
      exfalso
      linarith
    . exact negative
  . intro negative
    exact realSign.of_negative with negative

theorem realSign.one
  shows realSign((1:R)) = (1:R)
proof
  have positive : (0:R) < (1:R) by linarith
  exact realSign.of_positive with positive

theorem realSign.neg (X : Real)
  shows realSign(-X) = -realSign(X)
proof
  have split := realLess.trichotomy at realZero, X
  rcases split with positive | zero | negative
  . have flipped : -X < 0 by linarith
    have left := realSign.of_negative with flipped
    have right := realSign.of_positive with positive
    rw [left, right]
    rfl
  . rw ← zero
    have zeroNeg : -(0:R) = (0:R) by ring
    rw zeroNeg
    have sign := realSign.of_zero at realZero with rfl
    rw sign
    ring
  . have flipped : 0 < -X by linarith
    have left := realSign.of_positive with flipped
    have right := realSign.of_negative with negative
    rw [left, right]
    ring

theorem realSign.mul (X Y : Real)
  shows realSign(X * Y) = realSign(X) * realSign(Y)
proof
  have xSplit := realLess.trichotomy at realZero, X
  have ySplit := realLess.trichotomy at realZero, Y
  rcases xSplit with xPositive | xZero | xNegative
  . have xSign := realSign.of_positive with xPositive
    rcases ySplit with yPositive | yZero | yNegative
    . have ySign := realSign.of_positive with yPositive
      have product := realMulValue.positive with xPositive, yPositive
      have sign := realSign.of_positive with product
      rw [sign, xSign, ySign]
      ring
    . rw ← yZero
      have vanish : X * (0:R) = (0:R) by ring
      have zeroSign := realSign.of_zero at realZero with rfl
      rw [vanish, zeroSign, xSign]
      ring
    . have ySign := realSign.of_negative with yNegative
      have product :=
        realSign.product_negative with xPositive, yNegative
      have sign := realSign.of_negative with product
      rw [sign, xSign, ySign]
      ring
  . rw ← xZero
    have vanish : (0:R) * Y = (0:R) by ring
    have zeroSign := realSign.of_zero at realZero with rfl
    rw [vanish, zeroSign]
    ring
  . have xSign := realSign.of_negative with xNegative
    rcases ySplit with yPositive | yZero | yNegative
    . have ySign := realSign.of_positive with yPositive
      have swapped :=
        realSign.product_negative with yPositive, xNegative
      have shape : Y * X = X * Y by ring
      rw shape at swapped
      have sign := realSign.of_negative with swapped
      rw [sign, xSign, ySign]
      ring
    . rw ← yZero
      have vanish : X * (0:R) = (0:R) by ring
      have zeroSign := realSign.of_zero at realZero with rfl
      rw [vanish, zeroSign, xSign]
      ring
    . have ySign := realSign.of_negative with yNegative
      have product :=
        realSign.product_of_negatives with xNegative, yNegative
      have sign := realSign.of_positive with product
      rw [sign, xSign, ySign]
      ring

theorem realSign.mul_abs (X : Real)
  shows realSign(X) * abs(X) = X
proof
  have split := realLess.trichotomy at realZero, X
  rcases split with positive | zero | negative
  . have sign := realSign.of_positive with positive
    have absolute := abs.of_nonnegative with (realLess.implies_le with positive)
    rw [sign, absolute]
    ring
  . rw ← zero
    have zeroSign := realSign.of_zero at realZero with rfl
    rw [zeroSign, abs.zero]
    ring
  . have sign := realSign.of_negative with negative
    have absolute := abs.of_nonpositive with (realLess.implies_le with negative)
    rw [sign, absolute]
    ring

theorem realSign.mul_self (X : Real)
  shows realSign(X) * X = abs(X)
proof
  have split := realLess.trichotomy at realZero, X
  rcases split with positive | zero | negative
  . have sign := realSign.of_positive with positive
    have absolute := abs.of_nonnegative with (realLess.implies_le with positive)
    rw [sign, absolute]
    ring
  . rw ← zero
    have zeroSign := realSign.of_zero at realZero with rfl
    rw [zeroSign, abs.zero]
    ring
  . have sign := realSign.of_negative with negative
    have absolute := abs.of_nonpositive with (realLess.implies_le with negative)
    rw [sign, absolute]
    ring

theorem realSign.square (X : Real)
  requires nonzero : X ≠ 0
  shows realSign(X) * realSign(X) = (1:R)
proof
  have split := realLess.trichotomy at realZero, X
  rcases split with positive | zero | negative
  . have sign := realSign.of_positive with positive
    rw sign
    ring
  . symm at zero
    exfalso
    exact nonzero with zero
  . have sign := realSign.of_negative with negative
    rw sign
    ring

theorem realSign.pow (X : Real) (n : Nat)
  shows realSign(X ^ n) = realSign(X) ^ n
proof
  induction n
  | zero =>
    have signReal := realSign.real at X
    rw [realPow.zero, realPow.zero]
    exact realSign.one
  | succ(k) using ih =>
    have signReal := realSign.real at X
    rw [realPow.succ, realPow.succ, realSign.mul, ih]

theorem realSign.neg_one_pow (n : Nat)
  shows realSign((-(1:R)) ^ n) = (-(1:R)) ^ n
proof
  have negOneReal := realNegValue.real at realOne with realOne.real
  have negative : -(1:R) < 0 by linarith
  have sign := realSign.of_negative with negative
  rw [realSign.pow, sign]

theorem realSign.inv (X : Real)
  shows realSign(realInvValue(X)) = realSign(X)
proof
  have inverseReal := realInvValue.real at X
  have split := realLess.trichotomy at realZero, X
  rcases split with positive | zero | negative
  . have inversePositive := realInvValue.positive with positive
    have left := realSign.of_positive with inversePositive
    have right := realSign.of_positive with positive
    rw [left, right]
  . rw ← zero
    rw realInvValue.zero
  . have nonzero : X ≠ 0 by linarith
    have law := realInvValue.mul_right with nonzero
    have inverseNegative : realInvValue(X) < 0
      have inverseSplit := realLess.trichotomy at realZero, realInvValue(X)
      rcases inverseSplit with inversePositive | inverseZero | inverseNegative
      . have product := realSign.product_negative with
          inversePositive, negative
        have shape : realInvValue(X) * X = X * realInvValue(X) by ring
        rw shape at product
        exfalso
        linarith
      . rw ← inverseZero at law
        have vanish : X * (0:R) = (0:R) by ring
        rw vanish at law
        exfalso
        linarith
      . exact inverseNegative
    have left := realSign.of_negative with inverseNegative
    have right := realSign.of_negative with negative
    rw [left, right]

-- Two numbers with the same nonzero sign have a positive product.
theorem realSign.product_positive_of_eq (X Y : Real)
  requires nonzero : X ≠ 0
  requires same : realSign(X) = realSign(Y)
  shows 0 < X * Y
proof
  have xSplit := realLess.trichotomy at realZero, X
  rcases xSplit with xPositive | xZero | xNegative
  . have xSign := realSign.of_positive with xPositive
    rw xSign at same
    symm at same
    have yPositive := realSign.eq_one_iff.forward with same
    exact realMulValue.positive with xPositive, yPositive
  . symm at xZero
    exfalso
    exact nonzero with xZero
  . have xSign := realSign.of_negative with xNegative
    rw xSign at same
    symm at same
    have yNegative := realSign.eq_neg_one_iff.forward with same
    exact realSign.product_of_negatives with xNegative, yNegative

theorem realSign.eq_of_product_positive (X Y : Real)
  requires positive : 0 < X * Y
  shows realSign(X) = realSign(Y)
proof
  have xSplit := realLess.trichotomy at realZero, X
  have ySplit := realLess.trichotomy at realZero, Y
  rcases xSplit with xPositive | xZero | xNegative
  . rcases ySplit with yPositive | yZero | yNegative
    . have xSign := realSign.of_positive with xPositive
      have ySign := realSign.of_positive with yPositive
      rw [xSign, ySign]
    . rw ← yZero at positive
      have vanish : X * (0:R) = (0:R) by ring
      rw vanish at positive
      exfalso
      linarith
    . have product :=
        realSign.product_negative with xPositive, yNegative
      exfalso
      linarith
  . rw ← xZero at positive
    have vanish : (0:R) * Y = (0:R) by ring
    rw vanish at positive
    exfalso
    linarith
  . rcases ySplit with yPositive | yZero | yNegative
    . have product :=
        realSign.product_negative with yPositive, xNegative
      have shape : Y * X = X * Y by ring
      rw shape at product
      exfalso
      linarith
    . rw ← yZero at positive
      have vanish : X * (0:R) = (0:R) by ring
      rw vanish at positive
      exfalso
      linarith
    . have xSign := realSign.of_negative with xNegative
      have ySign := realSign.of_negative with yNegative
      rw [xSign, ySign]

theorem realSign.ne_of_product_negative (X Y : Real)
  requires negative : X * Y < 0
  shows realSign(X) = -realSign(Y)
proof
  have xSplit := realLess.trichotomy at realZero, X
  have ySplit := realLess.trichotomy at realZero, Y
  rcases xSplit with xPositive | xZero | xNegative
  . rcases ySplit with yPositive | yZero | yNegative
    . have product := realMulValue.positive with xPositive, yPositive
      exfalso
      linarith
    . rw ← yZero at negative
      have vanish : X * (0:R) = (0:R) by ring
      rw vanish at negative
      exfalso
      linarith
    . have xSign := realSign.of_positive with xPositive
      have ySign := realSign.of_negative with yNegative
      rw [xSign, ySign]
      ring
  . rw ← xZero at negative
    have vanish : (0:R) * Y = (0:R) by ring
    rw vanish at negative
    exfalso
    linarith
  . rcases ySplit with yPositive | yZero | yNegative
    . have xSign := realSign.of_negative with xNegative
      have ySign := realSign.of_positive with yPositive
      rw [xSign, ySign]
      ring
    . rw ← yZero at negative
      have vanish : X * (0:R) = (0:R) by ring
      rw vanish at negative
      exfalso
      linarith
    . have product :=
        realSign.product_of_negatives with xNegative, yNegative
      exfalso
      linarith
