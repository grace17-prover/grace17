-- The discriminant of a Horner pair as the resultant of the pair with its
-- derivative pair. Convention: discriminant(a, cs) = resultant(p, p′) with
-- p′ of declared degree length(cs) − 1 and leading (length cs)·a, no
-- division by a and no sign; it is (−1)^(m(m−1)/2)·a times the classical
-- discriminant and vanishes exactly when that does, for a ≠ 0. It is
-- nonzero over a field exactly when the pair is squarefree, vanishes over
-- ℂ exactly at a repeated root, and over ℝ exactly when the pair has a
-- repeated complex root.
-- Part of the CAD blueprint.
-- Planned home: Algebra/Polynomial/Discriminant.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module CAD.Discriminant
import CAD.ResultantGcd
import CAD.ResultantRoots
import CAD.HornerMultiplicity
import CAD.RealSquarefree
import Grace.Cumulus.Algebra.Ring.DeterminantThree

def discriminant {A : Set} (add zero neg mul one a : Set)
  (cs : List(A)) : Set :=
  resultant{A}(add, zero, neg, mul, one, a,
    hornerDerivativeLeading{A}(add, zero, one, mul, a, cs),
    cs, hornerDerivativeList{A}(add, zero, one, mul, cs))
notation scoped discriminant(R, a, cs) =>
  discriminant(R.carrier, R.add, R.zero, R.neg, R.mul, R.one, a, cs)

section Rings
variable (A add zero neg mul one a : Set)
notation ring R := (A, add, zero, neg, mul, one)
hypothesis ring : IsCommRing(R)
hypothesis initial : a ∈ R

theorem discriminant.closed (cs : List(A))
  shows discriminant(R, a, cs) ∈ R
proof
  have derivativeIn := hornerDerivativeLeading.closed at A, add, zero, neg,
    mul, one, a, cs with ring, initial
  have derivativeData := hornerDerivativeList.data at A, add, zero, neg, mul,
    one, a, cs with ring, initial
  have derivativeList := derivativeData.left
  unfold discriminant
  exact resultant.closed at A, add, zero, neg, mul, one, a,
    hornerDerivativeLeading{A}(add, zero, one, mul, a, cs), cs,
    hornerDerivativeList{A}(add, zero, one, mul, cs) with ring, initial,
    derivativeIn

theorem discriminant.as_resultant (cs : List(A))
  shows discriminant(R, a, cs) =
    resultant(R, a, cs, hornerDerivativeLeading{A}(add, zero, one, mul, a, cs),
      hornerDerivativeList{A}(add, zero, one, mul, cs))
proof
  unfold discriminant
  rfl

-- The 3 × 3 Sylvester matrix of c + bX + aX² and b + 2aX, by rows:
-- (a, b, c), (2a, b, 0), (0, 2a, b).
theorem discriminant.quadratic_row_p (b c : Set)
  requires linear : b ∈ R
  requires constant : c ∈ R
  shows listCoefficient{A}(zero, sylvesterRow{A}(zero, a, c :: b :: [], (0:N)),
      (0:N)) = a ∧
    listCoefficient{A}(zero, sylvesterRow{A}(zero, a, c :: b :: [], (0:N)),
      (1:N)) = b ∧
    listCoefficient{A}(zero, sylvesterRow{A}(zero, a, c :: b :: [], (0:N)),
      (2:N)) = c
proof
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have csList : List(A, c :: b :: []) by typecheck
  have single : List(A, b :: []) by typecheck
  have emptyList : List(A, []) by typecheck
  have twoLength : length{A}(c :: b :: []) = (2:N)
    rw [length.cons, length.cons, length.nil]
    rfl
  have lower0 : (0:N) ≤ (0:N) by arith
  have lower1 : (0:N) ≤ (1:N) by arith
  have lower2 : (0:N) ≤ (2:N) by arith
  have upper0 : (0:N) ≤ (0:N) + length{A}(c :: b :: [])
    rw twoLength
    arith
  have upper1 : (1:N) ≤ (0:N) + length{A}(c :: b :: [])
    rw twoLength
    arith
  have upper2 : (2:N) ≤ (0:N) + length{A}(c :: b :: [])
    rw twoLength
    arith
  have entry0 := sylvesterRow.coefficient at A, zero, a, c :: b :: [], (0:N),
    (0:N) with zeroIn, initial, lower0, upper0
  have entry1 := sylvesterRow.coefficient at A, zero, a, c :: b :: [], (0:N),
    (1:N) with zeroIn, initial, lower1, upper1
  have entry2 := sylvesterRow.coefficient at A, zero, a, c :: b :: [], (0:N),
    (2:N) with zeroIn, initial, lower2, upper2
  rw twoLength at entry0
  rw twoLength at entry1
  rw twoLength at entry2
  have index0 : sub((2:N) + (0:N), (0:N)) = (2:N)
    have shape : (2:N) + (0:N) = (0:N) + (2:N) by arith
    exact sub.of_add at (2:N) + (0:N), (0:N), (2:N) with shape
  have index1 : sub((2:N) + (0:N), (1:N)) = (1:N)
    have shape : (2:N) + (0:N) = (1:N) + (1:N) by arith
    exact sub.of_add at (2:N) + (0:N), (1:N), (1:N) with shape
  have index2 : sub((2:N) + (0:N), (2:N)) = (0:N)
    have shape : (2:N) + (0:N) = (2:N) + (0:N) by arith
    exact sub.of_add at (2:N) + (0:N), (2:N), (0:N) with shape
  have leading := hornerCoefficient.leading at A, zero, a, c :: b :: [] with *
  rw twoLength at leading
  have middle := hornerCoefficient.cons_succ at A, add, zero, neg, mul, one, a,
    c, b :: [], (0:N) with ring, initial, constant
  have inner := hornerCoefficient.cons_zero at A, add, zero, neg, mul, one, a,
    b, [] with ring, initial, linear
  have head := hornerCoefficient.cons_zero at A, add, zero, neg, mul, one, a,
    c, b :: [] with ring, initial, constant
  rw [entry0, entry1, entry2, index0, index1, index2, leading, middle, inner,
    head]
  refine ⟨rfl, rfl, rfl⟩

theorem discriminant.quadratic_row_q (d e : Set) (i : Nat)
  requires top : d ∈ R
  requires low : e ∈ R
  shows listCoefficient{A}(zero, sylvesterRow{A}(zero, d, e :: [], i), i)
      = d ∧
    listCoefficient{A}(zero, sylvesterRow{A}(zero, d, e :: [], i), i + (1:N))
      = e ∧
    listCoefficient{A}(zero, sylvesterRow{A}(zero, d, e :: [], i), i + (2:N))
      = zero
proof
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have single : List(A, e :: []) by typecheck
  have emptyList : List(A, []) by typecheck
  have oneLength : length{A}(e :: []) = (1:N)
    rw [length.cons, length.nil]
    rfl
  have lower0 : i ≤ i by arith
  have lower1 : i ≤ i + (1:N) by arith
  have upper0 : i ≤ i + length{A}(e :: [])
    rw oneLength
    arith
  have upper1 : i + (1:N) ≤ i + length{A}(e :: [])
    rw oneLength
    arith
  have outside : i + (2:N) < i ∨ i + length{A}(e :: []) < i + (2:N)
    right
    rw oneLength
    arith
  have entry0 := sylvesterRow.coefficient at A, zero, d, e :: [], i, i with
    zeroIn, top, lower0, upper0
  have entry1 := sylvesterRow.coefficient at A, zero, d, e :: [], i,
    i + (1:N) with zeroIn, top, lower1, upper1
  have entry2 := sylvesterRow.coefficient_outside at A, zero, d, e :: [], i,
    i + (2:N) with zeroIn, top, outside
  rw oneLength at entry0
  rw oneLength at entry1
  have index0 : sub((1:N) + i, i) = (1:N)
    have shape : (1:N) + i = i + (1:N) by arith
    exact sub.of_add at (1:N) + i, i, (1:N) with shape
  have index1 : sub((1:N) + i, i + (1:N)) = (0:N)
    have shape : (1:N) + i = (i + (1:N)) + (0:N) by arith
    exact sub.of_add at (1:N) + i, i + (1:N), (0:N) with shape
  have leading := hornerCoefficient.leading at A, zero, d, e :: [] with *
  rw oneLength at leading
  have head := hornerCoefficient.cons_zero at A, add, zero, neg, mul, one, d,
    e, [] with ring, top, low
  rw [entry0, entry1, entry2, index0, index1, leading, head]
  refine ⟨rfl, rfl, rfl⟩

-- For c + bX + aX² the value is −a(b² − 4ac).
theorem discriminant.quadratic (b c : Set)
  requires linear : b ∈ R
  requires constant : c ∈ R
  shows discriminant(R, a, c :: b :: []) = R[-(a * (b * b - 4 * (a * c)))]
proof
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have oneIn : R[1] ∈ R by typecheck
  have twoIn := IsRing.numeral_closed at A, add, zero, neg, mul, one, (2:N)
    with ordinary
  have oneNumeralIn := IsRing.numeral_closed at A, add, zero, neg, mul, one,
    (1:N) with ordinary
  have csList : List(A, c :: b :: []) by typecheck
  have single : List(A, b :: []) by typecheck
  have emptyList : List(A, []) by typecheck
  have twoLength : length{A}(c :: b :: []) = (2:N)
    rw [length.cons, length.cons, length.nil]
    rfl
  have leadingShape : hornerDerivativeLeading{A}(add, zero, one, mul, a,
      c :: b :: []) = R[2 * a]
    unfold hornerDerivativeLeading
    rw twoLength
    rfl
  have listShape : hornerDerivativeList{A}(add, zero, one, mul, c :: b :: []) =
      R[ringNat(add, zero, one, (1:N)) * b] :: []
    rw [hornerDerivativeList.cons, hornerIndexScale.cons, hornerIndexScale.nil]
    rfl
  have twoA : R[2 * a] ∈ R := IsRing.mul_closed with ordinary, twoIn, initial
  have oneB : R[ringNat(add, zero, one, (1:N)) * b] ∈ R :=
    IsRing.mul_closed with ordinary, oneNumeralIn, linear
  have dsList : List(A, R[ringNat(add, zero, one, (1:N)) * b] :: []) by
    typecheck
  have dsLength : length{A}(R[ringNat(add, zero, one, (1:N)) * b] :: []) =
      (1:N)
    rw [length.cons, length.nil]
    rfl
  have size : length{A}(c :: b :: []) +
      length{A}(R[ringNat(add, zero, one, (1:N)) * b] :: []) = (3:N)
    rw [twoLength, dsLength]
    arith
  have matrix := sylvesterBlockMatrix.matrix at A, add, zero, neg, mul, one, a,
    R[2 * a], c :: b :: [], R[ringNat(add, zero, one, (1:N)) * b] :: [],
    (1:N), (3:N) with *
  have expansion := determinant.three at A, add, zero, neg, mul, one,
    sylvesterBlockMatrix(A, zero, a, R[2 * a], c :: b :: [],
      R[ringNat(add, zero, one, (1:N)) * b] :: [], (1:N), (3:N)) with ring,
    matrix
  have bound0 : (0:N) < (3:N) by arith
  have bound1 : (1:N) < (3:N) by arith
  have bound2 : (2:N) < (3:N) by arith
  have upperRow : (0:N) < (1:N) by arith
  have lowerRow1 : (1:N) ≤ (1:N) by arith
  have lowerRow2 : (1:N) ≤ (2:N) by arith
  have rowP := discriminant.quadratic_row_p at A, add, zero, neg, mul, one, a,
    b, c with ring, initial, linear, constant
  have rowQ0 := discriminant.quadratic_row_q at A, add, zero, neg, mul, one, a,
    R[2 * a], R[ringNat(add, zero, one, (1:N)) * b], (0:N) with ring, initial,
    twoA, oneB
  have rowQ1 := discriminant.quadratic_row_q at A, add, zero, neg, mul, one, a,
    R[2 * a], R[ringNat(add, zero, one, (1:N)) * b], (1:N) with ring, initial,
    twoA, oneB
  have index1 : sub((1:N), (1:N)) = (0:N)
    have shape : (1:N) = (1:N) + (0:N) by arith
    exact sub.of_add at (1:N), (1:N), (0:N) with shape
  have index2 : sub((2:N), (1:N)) = (1:N)
    have shape : (2:N) = (1:N) + (1:N) by arith
    exact sub.of_add at (2:N), (1:N), (1:N) with shape
  have e00 := sylvesterBlockMatrix.entry_upper at A, add, zero, neg, mul, one,
    a, R[2 * a], c :: b :: [], R[ringNat(add, zero, one, (1:N)) * b] :: [],
    (1:N), (3:N), (0:N), (0:N) with *
  have e01 := sylvesterBlockMatrix.entry_upper at A, add, zero, neg, mul, one,
    a, R[2 * a], c :: b :: [], R[ringNat(add, zero, one, (1:N)) * b] :: [],
    (1:N), (3:N), (0:N), (1:N) with *
  have e02 := sylvesterBlockMatrix.entry_upper at A, add, zero, neg, mul, one,
    a, R[2 * a], c :: b :: [], R[ringNat(add, zero, one, (1:N)) * b] :: [],
    (1:N), (3:N), (0:N), (2:N) with *
  have e10 := sylvesterBlockMatrix.entry_lower at A, add, zero, neg, mul, one,
    a, R[2 * a], c :: b :: [], R[ringNat(add, zero, one, (1:N)) * b] :: [],
    (1:N), (3:N), (1:N), (0:N) with *
  have e11 := sylvesterBlockMatrix.entry_lower at A, add, zero, neg, mul, one,
    a, R[2 * a], c :: b :: [], R[ringNat(add, zero, one, (1:N)) * b] :: [],
    (1:N), (3:N), (1:N), (1:N) with *
  have e12 := sylvesterBlockMatrix.entry_lower at A, add, zero, neg, mul, one,
    a, R[2 * a], c :: b :: [], R[ringNat(add, zero, one, (1:N)) * b] :: [],
    (1:N), (3:N), (1:N), (2:N) with *
  have e20 := sylvesterBlockMatrix.entry_lower at A, add, zero, neg, mul, one,
    a, R[2 * a], c :: b :: [], R[ringNat(add, zero, one, (1:N)) * b] :: [],
    (1:N), (3:N), (2:N), (0:N) with *
  have e21 := sylvesterBlockMatrix.entry_lower at A, add, zero, neg, mul, one,
    a, R[2 * a], c :: b :: [], R[ringNat(add, zero, one, (1:N)) * b] :: [],
    (1:N), (3:N), (2:N), (1:N) with *
  have e22 := sylvesterBlockMatrix.entry_lower at A, add, zero, neg, mul, one,
    a, R[2 * a], c :: b :: [], R[ringNat(add, zero, one, (1:N)) * b] :: [],
    (1:N), (3:N), (2:N), (2:N) with *
  rw [index1] at e10
  rw [index1] at e11
  rw [index1] at e12
  rw [index2] at e20
  rw [index2] at e21
  rw [index2] at e22
  have q00 := rowQ0.left
  have q01 := rowQ0.right.left
  have q02 := rowQ0.right.right
  have q10 : listCoefficient{A}(zero, sylvesterRow{A}(zero, R[2 * a],
      R[ringNat(add, zero, one, (1:N)) * b] :: [], (1:N)), (0:N)) = zero
    have outside : (0:N) < (1:N) ∨
        (1:N) + length{A}(R[ringNat(add, zero, one, (1:N)) * b] :: []) < (0:N)
      left
      arith
    exact sylvesterRow.coefficient_outside at A, zero, R[2 * a],
      R[ringNat(add, zero, one, (1:N)) * b] :: [], (1:N), (0:N) with zeroIn,
      twoA, outside
  have q11 := rowQ1.left
  have q12 := rowQ1.right.left
  have shift1 : (0:N) + (1:N) = (1:N) by arith
  have shift2 : (0:N) + (2:N) = (2:N) by arith
  have shift3 : (1:N) + (1:N) = (2:N) by arith
  rw shift1 at q01
  rw shift2 at q02
  rw shift3 at q12
  have oneNumeral : ringNat(add, zero, one, (1:N)) = R[1]
    rw [ringNat.succ, ringNat.zero]
    ring
  unfold discriminant
  rw [leadingShape, listShape]
  unfold resultant
  unfold sylvesterMatrix
  rw [size, dsLength, expansion, e00, e01, e02, e10, e11, e12, e20, e21, e22,
    rowP.left, rowP.right.left, rowP.right.right, q00, q01, q02, q10, q11,
    q12, oneNumeral]
  ring

end Rings

section Homomorphisms
variable (A add zero neg mul one B plus z minus times unit h a : Set)
notation ring R := (A, add, zero, neg, mul, one)
notation ring S := (B, plus, z, minus, times, unit)
hypothesis source : IsCommRing(R)
hypothesis target : IsCommRing(S)
hypothesis hom : IsRingHom(h, R, S)
hypothesis initial : a ∈ R

theorem discriminant.map (cs : List(A))
  shows h(discriminant(R, a, cs)) = discriminant(S, h(a), listMap{A}(h, cs))
proof
  have derivativeIn := hornerDerivativeLeading.closed at A, add, zero, neg,
    mul, one, a, cs with source, initial
  have derivativeData := hornerDerivativeList.data at A, add, zero, neg, mul,
    one, a, cs with source, initial
  have derivativeList := derivativeData.left
  have mapped := resultant.map at A, add, zero, neg, mul, one, B, plus, z,
    minus, times, unit, h, a, hornerDerivativeLeading{A}(add, zero, one, mul,
      a, cs), cs, hornerDerivativeList{A}(add, zero, one, mul, cs) with source,
    target, hom, initial, derivativeIn
  have leadingMapped := hornerDerivativeLeading.map at A, add, zero, neg, mul,
    one, B, plus, z, minus, times, unit, h, a, cs with source, target, hom,
    initial
  have listMapped := hornerDerivativeList.map at A, add, zero, neg, mul, one,
    B, plus, z, minus, times, unit, h, a, cs with source, target, hom, initial
  unfold discriminant
  rw [mapped, leadingMapped, listMapped]
  rfl

end Homomorphisms

section Evaluation
variable (I A add zero neg mul one v a : Set)
notation ring R := (A, add, zero, neg, mul, one)
notation ring P := R[I]
hypothesis ring : IsCommRing(R)
hypothesis assignment : v : I → R
hypothesis initial : a ∈ P

theorem discriminant.evaluate (cs : List(polynomials(I, A, zero)))
  shows polynomialAt(I, R, v)(discriminant(P, a, cs)) =
    discriminant(R, polynomialAt(I, R, v)(a),
      listMap{polynomials(I, A, zero)}(polynomialAt(I, R, v), cs))
proof
  have polynomials := polynomials.comm_ring at I, A, add, zero, neg, mul, one
    with ring
  have evaluation := polynomialAt.hom with *
  exact discriminant.map with *

end Evaluation

section Fields
variable (A add zero neg mul one a : Set)
notation ring R := (A, add, zero, neg, mul, one)
hypothesis field : IsField(R)
hypothesis initial : a ∈ R
hypothesis nonzero : a ≠ R[0]

-- With a nonzero derivative leading coefficient the equivalence is the
-- coprimality criterion for the resultant.
theorem discriminant.nonzero_iff_squarefree_of_derivative (cs : List(A))
  requires derivativeNonzero :
    hornerDerivativeLeading{A}(add, zero, one, mul, a, cs) ≠ R[0]
  shows discriminant(R, a, cs) ≠ R[0] ↔ HornerSquarefree(A, add, zero, neg,
    mul, one, a, cs)
proof
  have ring := IsField.comm_ring with field
  have derivativeIn := hornerDerivativeLeading.closed at A, add, zero, neg,
    mul, one, a, cs with ring, initial
  have derivativeData := hornerDerivativeList.data at A, add, zero, neg, mul,
    one, a, cs with ring, initial
  have derivativeList := derivativeData.left
  unfold discriminant
  unfold HornerSquarefree
  exact resultant.nonzero_iff_coprime at A, add, zero, neg, mul, one, a,
    hornerDerivativeLeading{A}(add, zero, one, mul, a, cs), cs,
    hornerDerivativeList{A}(add, zero, one, mul, cs) with field, initial,
    derivativeIn, nonzero, derivativeNonzero

end Fields

section Complexes
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- The complex numerals are the images of the real ones, so nonzero.
theorem complexes.numeral_nonzero (n : Nat)
  requires positive : n ≠ (0:N)
  shows ringNat(complexAdd, complexZero, complexOne, n) ≠ ℂ[0]
proof
  have source := reals.comm_ring
  have target := complexes.comm_ring
  have hom := complexOfReal.hom
  have oneIn : (1:R) ∈ ℝ := realOne.real
  have mapped := hornerDerivative.numeral_map at ℝ, realAdd, realZero,
    realNeg, realMul, realOne, complexCarrier, complexAdd, complexZero,
    complexNeg, complexMul, complexOne, complexOfReal, realOne, n with source,
    target, hom, oneIn
  have numeral := realNat.numeral at n
  have natNonzero := realNat.ne_zero at n with positive
  have natReal : Real(realNat(n)) := realNat.real at n
  have zeroReal : Real((0:R)) := realZero.real
  intro vanish
  rw [← mapped, ← numeral, ← complexOfReal.zero] at vanish
  exact natNonzero with (complexOfReal.injective with vanish)

theorem complexes.derivative_leading_nonzero (a : Set) (cs : List(ℂ))
  requires leading : a ∈ ℂ
  requires nonzero : a ≠ ℂ[0]
  requires positive : cs ≠ []
  shows hornerDerivativeLeading{ℂ}(complexAdd, complexZero, complexOne,
    complexMul, a, cs) ≠ ℂ[0]
proof
  have ring := complexes.comm_ring
  have ordinary := IsCommRing.ring with ring
  have field := complexes.is_field
  have noZeroDivisors := IsField.no_zero_divisors with field
  unfold NoZeroDivisors at noZeroDivisors
  have lengthNonzero : length{ℂ}(cs) ≠ (0:N)
    intro zeroLength
    exact positive with (length.eq_zero with zeroLength)
  have numeralNonzero := complexes.numeral_nonzero at length{ℂ}(cs) with
    lengthNonzero
  have numeralIn := IsRing.numeral_closed at complexCarrier, complexAdd,
    complexZero, complexNeg, complexMul, complexOne, length{ℂ}(cs) with
    ordinary
  unfold hornerDerivativeLeading
  intro vanish
  have firstBinder := noZeroDivisors with numeralIn
  have secondBinder := firstBinder with leading
  have split := secondBinder with vanish
  cases split with numeralZero | leadingZero
  . exact numeralNonzero with numeralZero
  . exact nonzero with leadingZero

theorem discriminant.zero_iff_common_root_derivative (a : Set) (cs : List(ℂ))
  requires leading : a ∈ ℂ
  requires nonzero : a ≠ ℂ[0]
  requires positive : cs ≠ []
  shows discriminant(ℂ, a, cs) = ℂ[0] ↔
    ∃ z ∈ ℂ, hornerAt{ℂ}(complexAdd, complexMul, a, z, cs) = ℂ[0] ∧
      hornerAt{ℂ}(complexAdd, complexMul,
        hornerDerivativeLeading{ℂ}(complexAdd, complexZero, complexOne,
          complexMul, a, cs), z,
        hornerDerivativeList{ℂ}(complexAdd, complexZero, complexOne,
          complexMul, cs)) = ℂ[0]
proof
  have ring := complexes.comm_ring
  have derivativeIn := hornerDerivativeLeading.closed at complexCarrier,
    complexAdd, complexZero, complexNeg, complexMul, complexOne, a, cs with
    ring, leading
  have derivativeData := hornerDerivativeList.data at complexCarrier,
    complexAdd, complexZero, complexNeg, complexMul, complexOne, a, cs with
    ring, leading
  have derivativeList := derivativeData.left
  have derivativeNonzero := complexes.derivative_leading_nonzero at a, cs with
    leading, nonzero, positive
  unfold discriminant
  exact resultant.zero_iff_common_root_complex at a,
    hornerDerivativeLeading{ℂ}(complexAdd, complexZero, complexOne,
      complexMul, a, cs), cs,
    hornerDerivativeList{ℂ}(complexAdd, complexZero, complexOne, complexMul,
      cs) with leading, derivativeIn, nonzero, derivativeNonzero

-- Over ℂ the discriminant vanishes exactly at a repeated root.
theorem discriminant.zero_iff_repeated_root (a : Set) (cs : List(ℂ))
  requires leading : a ∈ ℂ
  requires nonzero : a ≠ ℂ[0]
  requires positive : cs ≠ []
  shows discriminant(ℂ, a, cs) = ℂ[0] ↔
    ∃ z ∈ ℂ, 2 ≤ rootMultiplicity(complexCarrier, complexAdd, complexZero,
      complexNeg, complexMul, complexOne, a, cs, z)
proof
  have ring := complexes.comm_ring
  have criterion := discriminant.zero_iff_common_root_derivative at a, cs with
    leading, nonzero, positive
  rw criterion
  constructor
  . intro witness
    obtain ⟨z, zIn, rootP, rootD⟩ := witness
    have repeated := rootMultiplicity.two_le_of_common_root at complexCarrier,
      complexAdd, complexZero, complexNeg, complexMul, complexOne, a, z, cs
      with ring, leading, nonzero, zIn, rootP, rootD
    refine ⟨z, zIn, repeated⟩
  . intro witness
    obtain ⟨z, zIn, repeated⟩ := witness
    have rootD := rootMultiplicity.derivative_root at complexCarrier,
      complexAdd, complexZero, complexNeg, complexMul, complexOne, a, z, cs
      with ring, leading, nonzero, zIn, repeated
    have natural := rootMultiplicity.natural at complexCarrier, complexAdd,
      complexZero, complexNeg, complexMul, complexOne, a, z, cs with ring,
      leading, zIn
    have atLeastOne : 1 ≤ rootMultiplicity(complexCarrier, complexAdd,
      complexZero, complexNeg, complexMul, complexOne, a, cs, z) by arith
    have criterionP := rootMultiplicity.positive_iff at complexCarrier,
      complexAdd, complexZero, complexNeg, complexMul, complexOne, a, z, cs
      with ring, leading, nonzero, zIn
    have rootP := criterionP.forward with atLeastOne
    refine ⟨z, zIn, rootP, rootD⟩

-- A real pair is squarefree exactly when its discriminant is nonzero,
-- exactly when it has no repeated complex root.
theorem discriminant.real_nonzero_iff_squarefree (a : Real) (cs : List(ℝ))
  requires nonzero : a ≠ (0:R)
  requires positive : cs ≠ []
  shows discriminant(R, a, cs) ≠ (0:R) ↔ RealSquarefree(a, cs)
proof
  have field := RealSquarefree.field
  have aIn : a ∈ ℝ by simp [Real]
  have derivativeNonzero := RealSquarefree.derivative_leading_nonzero at a, cs
    with aIn, nonzero, positive
  unfold RealSquarefree
  exact discriminant.nonzero_iff_squarefree_of_derivative at ℝ, realAdd,
    realZero, realNeg, realMul, realOne, a, cs with field, aIn, nonzero,
    derivativeNonzero

theorem discriminant.real_zero_iff_repeated_complex_root (a : Real)
  (cs : List(ℝ))
  requires nonzero : a ≠ (0:R)
  requires positive : cs ≠ []
  shows discriminant(R, a, cs) = (0:R) ↔
    ∃ z ∈ ℂ, 2 ≤ rootMultiplicity(complexCarrier, complexAdd, complexZero,
      complexNeg, complexMul, complexOne,
      complexOfReal(a), listMap{ℝ}(complexOfReal, cs), z)
proof
  have source := reals.comm_ring
  have target := complexes.comm_ring
  have hom := complexOfReal.hom
  have function := complexOfReal.function
  have aIn : a ∈ ℝ by simp [Real]
  have zeroReal : Real((0:R)) := realZero.real
  have aImage := FunctionBetween.apply_closed at complexOfReal, ℝ,
    complexCarrier, a with function, aIn
  have zero := complexOfReal.zero
  have aNonzero : complexOfReal(a) ≠ ℂ[0]
    intro equal
    rw ← zero at equal
    exact nonzero with (complexOfReal.injective with equal)
  have csList := complexOfReal.list at cs
  have positiveImage : listMap{ℝ}(complexOfReal, cs) ≠ []
    intro empty
    exact positive with (listMap.eq_nil with empty)
  have complexIff := discriminant.zero_iff_repeated_root at complexOfReal(a),
    listMap{ℝ}(complexOfReal, cs) with aImage, aNonzero, positiveImage
  have transported := discriminant.map at ℝ, realAdd, realZero, realNeg,
    realMul, realOne, complexCarrier, complexAdd, complexZero, complexNeg,
    complexMul, complexOne, complexOfReal, a, cs with source, target, hom, aIn
  have discriminantIn := discriminant.closed at ℝ, realAdd, realZero, realNeg,
    realMul, realOne, a, cs with source, aIn
  have discriminantReal : Real(discriminant(R, a, cs)) by exact discriminantIn
  rw [← complexIff, ← transported]
  constructor
  . intro vanish
    rw vanish
    exact zero
  . intro vanish
    rw ← zero at vanish
    exact complexOfReal.injective with vanish

end Complexes
