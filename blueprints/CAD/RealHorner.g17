-- The real polynomial function of a Horner pair: hornerFunction(leading,
-- cs) is the set function X ↦ horner(realRing, leading, X, cs) on ℝ, with
-- the real derivative pair, continuity, the derivative at every point as
-- the function of the derivative pair, iterated derivatives, and the root
-- set read through the function.
-- Part of the CAD blueprint.
-- Planned home: Real/Analysis/PolynomialFunction.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module CAD.RealHorner
import CAD.HornerDerivative
import CAD.RealPowerRule
import Grace.Cumulus.Real.Field
import Grace.Cumulus.Real.Analysis.Intervals

defgraph hornerFunction (leading cs : Set) (X ∈ ℝ) : ℝ :=
  horner(realRing, leading, X, cs)
requires initial : Real(leading)
requires coefficients : List(ℝ, cs)
proof
  sorry

-- The real derivative pair, and its iterates.
def realDerivativeLeading (leading cs : Set) : Set :=
  hornerDerivativeLeading{ℝ}(realAdd, realZero, realOne, realMul, leading, cs)
def realDerivativeList (cs : Set) : Set :=
  hornerDerivativeList{ℝ}(realAdd, realZero, realOne, realMul, cs)
def realDerivativePair (leading cs : Set, k : Nat) → Set
  | leading, cs, zero => (leading, cs)
  | leading, cs, succ(k) =>
      (realDerivativeLeading(fst(realDerivativePair(leading, cs, k)),
          snd(realDerivativePair(leading, cs, k))),
        realDerivativeList(snd(realDerivativePair(leading, cs, k))))

theorem realDerivativePair.zero (leading cs : Set)
  shows realDerivativePair(leading, cs, 0) = (leading, cs)
proof
  sorry

theorem realDerivativePair.succ (leading cs : Set, k : Nat)
  shows realDerivativePair(leading, cs, k + 1) =
    (realDerivativeLeading(fst(realDerivativePair(leading, cs, k)),
        snd(realDerivativePair(leading, cs, k))),
      realDerivativeList(snd(realDerivativePair(leading, cs, k))))
proof
  sorry

section Polynomials
variable (leading cs : Set)
hypothesis initial : Real(leading)
hypothesis coefficients : List(ℝ, cs)

instance realDerivativeLeading.real
  shows Real(realDerivativeLeading(leading, cs))
proof
  sorry

theorem realDerivativeList.list
  shows List(ℝ, realDerivativeList(cs))
proof
  sorry

theorem realDerivativeList.length
  shows length{ℝ}(realDerivativeList(cs)) = predecessor(length{ℝ}(cs))
proof
  sorry

instance realDerivativePair.real (k : Nat)
  shows Real(fst(realDerivativePair(leading, cs, k)))
proof
  sorry

instance realDerivativePair.list (k : Nat)
  shows List(ℝ, snd(realDerivativePair(leading, cs, k)))
proof
  sorry

theorem hornerFunction.nil (X : Real)
  shows hornerFunction(leading, [])(X) = leading
proof
  sorry

theorem hornerFunction.cons (c X : Real)
  shows hornerFunction(leading, c :: cs)(X) = c + X * hornerFunction(leading,
    cs)(X)
proof
  sorry

theorem hornerFunction.continuous
  shows Continuous(hornerFunction(leading, cs))
proof
  sorry

theorem hornerFunction.continuous_on (S : Set)
  requires subset : S ⊆ ℝ
  shows ContinuousOn(hornerFunction(leading, cs), S)
proof
  sorry

-- The derivative of the function of a pair is the function of the
-- derivative pair.
theorem hornerFunction.has_derivative_at (X : Real)
  shows HasDerivativeAt(hornerFunction(leading, cs),
    hornerFunction(realDerivativeLeading(leading, cs),
      realDerivativeList(cs))(X), X)
proof
  sorry

theorem hornerFunction.differentiable_at (X : Real)
  shows DifferentiableAt(hornerFunction(leading, cs), X)
proof
  sorry

theorem hornerFunction.derivative (X : Real)
  shows hornerFunction(leading, cs)′(X) =
    hornerFunction(realDerivativeLeading(leading, cs),
      realDerivativeList(cs))(X)
proof
  sorry

theorem hornerFunction.iterated_derivative (k : Nat) (X : Real)
  shows hornerFunction(leading, cs)⁽ᵏ⁾(X) =
    hornerFunction(fst(realDerivativePair(leading, cs, k)),
      snd(realDerivativePair(leading, cs, k)))(X)
proof
  sorry

-- The root set of the bundled real pair, read through the function.
theorem hornerFunction.root_iff (X : Real)
  shows X ∈ rootSet(realRing, leading, cs) ↔ hornerFunction(leading,
    cs)(X) = (0:R)
proof
  sorry

theorem rootSet.subset_reals
  shows rootSet(realRing, leading, cs) ⊆ ℝ
proof
  sorry

theorem rootSet.real_finite
  requires nonzero : leading ≠ (0:R)
  shows Finite(rootSet(realRing, leading, cs))
proof
  sorry

end Polynomials
