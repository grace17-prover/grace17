-- The real polynomial function of a Horner pair: hornerFunction(leading,
-- cs) is the set function X ↦ horner(realRing, leading, X, cs) on ℝ, with
-- the real derivative pair, continuity, the derivative at every point as
-- the function of the derivative pair, iterated derivatives, and the root
-- set read through the function.
-- Part of the CAD blueprint.
-- Planned home: Real/Analysis/PolynomialFunction.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module CAD.RealHorner
import CAD.HornerDerivative
import CAD.RealPowerRule
import Grace.Cumulus.Real.Field
import Grace.Cumulus.Real.Analysis.Intervals

-- The real derivative pair, and its iterates.
def realDerivativeLeading (leading cs : Set) : Set :=
  hornerDerivativeLeading{ℝ}(realAdd, realZero, realOne, realMul, leading, cs)
def realDerivativeList (cs : Set) : Set :=
  hornerDerivativeList{ℝ}(realAdd, realZero, realOne, realMul, cs)
def realDerivativePair (leading cs : Set, k : Nat) → Set
  | leading, cs, zero => (leading, cs)
  | leading, cs, succ(k) =>
      (realDerivativeLeading(fst(realDerivativePair(leading, cs, k)),
          snd(realDerivativePair(leading, cs, k))),
        realDerivativeList(snd(realDerivativePair(leading, cs, k))))

theorem realDerivativePair.zero (leading cs : Set)
  shows realDerivativePair(leading, cs, 0) = (leading, cs)
proof
  rw realDerivativePair

theorem realDerivativePair.succ (leading cs : Set, k : Nat)
  shows realDerivativePair(leading, cs, k + 1) =
    (realDerivativeLeading(fst(realDerivativePair(leading, cs, k)),
        snd(realDerivativePair(leading, cs, k))),
      realDerivativeList(snd(realDerivativePair(leading, cs, k))))
proof
  have one : k + 1 = succ(k) := add.right_one with *
  rw one
  rw realDerivativePair

-- The pieces of the bundled real ring.
theorem realRing.addOf
  shows Ring.add(realRing) = realAdd
proof
  simp [realRing, Ring.mk.add]

theorem realRing.mulOf
  shows Ring.mul(realRing) = realMul
proof
  simp [realRing, Ring.mk.mul]

theorem realRing.zeroOf
  shows Ring.zero(realRing) = realZero
proof
  simp [realRing, Ring.mk.zero]

section Polynomials
variable (leading cs : Set)
hypothesis initial : Real(leading)
hypothesis coefficients : List(ℝ, cs)

defgraph hornerFunction (X ∈ ℝ) : ℝ := horner(realRing, leading, X, cs)
proof
  have carrier := realRing.carrierOf
  have realX : X ∈ ℝ by exact member
  have leadingIn : leading ∈ Ring.carrier(realRing)
    rw carrier
    exact initial
  have xIn : X ∈ Ring.carrier(realRing)
    rw carrier
    exact realX
  have listIn : List(Ring.carrier(realRing), cs)
    rw carrier
    exact coefficients
  have closed := horner.mem at realRing, leading, X, cs with
    realRing.comm_ring, leadingIn, xIn, listIn
  rwa carrier at closed

instance realDerivativeLeading.real
  shows Real(realDerivativeLeading(leading, cs))
proof
  have leadingIn : leading ∈ ℝ by exact initial
  have closed := hornerDerivativeLeading.closed with
    coefficients, reals.comm_ring, leadingIn
  unfold realDerivativeLeading
  exact closed

theorem realDerivativeList.list
  shows List(ℝ, realDerivativeList(cs))
proof
  have leadingIn : leading ∈ ℝ by exact initial
  have data := hornerDerivativeList.data with
    coefficients, reals.comm_ring, leadingIn
  unfold realDerivativeList
  exact data.left

theorem realDerivativeList.length
  shows length{ℝ}(realDerivativeList(cs)) = predecessor(length{ℝ}(cs))
proof
  have leadingIn : leading ∈ ℝ by exact initial
  have data := hornerDerivativeList.data with
    coefficients, reals.comm_ring, leadingIn
  unfold realDerivativeList
  exact data.right

instance realDerivativePair.list (k : Nat)
  shows List(ℝ, snd(realDerivativePair(leading, cs, k)))
proof
  induction k
  | zero =>
    rw realDerivativePair.zero
    rw snd.pair
    exact coefficients
  | succ(j) using ih =>
    have one : j + 1 = succ(j) := add.right_one with *
    rw ← one
    rw realDerivativePair.succ
    rw snd.pair
    exact realDerivativeList.list at
      leading, snd(realDerivativePair(leading, cs, j)) with initial, ih

instance realDerivativePair.real (k : Nat)
  shows Real(fst(realDerivativePair(leading, cs, k)))
proof
  induction k
  | zero =>
    rw realDerivativePair.zero
    rw fst.pair
    exact initial
  | succ(j) using ih =>
    have one : j + 1 = succ(j) := add.right_one with *
    rw ← one
    rw realDerivativePair.succ
    rw fst.pair
    have tailList := realDerivativePair.list at leading, cs, j with
      initial, coefficients
    exact realDerivativeLeading.real at
      fst(realDerivativePair(leading, cs, j)),
      snd(realDerivativePair(leading, cs, j)) with ih, tailList

theorem hornerFunction.nil (X : Real)
  shows hornerFunction(leading, [])(X) = leading
proof
  have realX : X ∈ ℝ by simp [Real]
  have nilList : List(ℝ, []) by typecheck
  have value := hornerFunction.value at leading, [], X with
    initial, nilList, realX
  have carrier := realRing.carrierOf
  have leadingIn : leading ∈ Ring.carrier(realRing)
    rw carrier
    exact initial
  have xIn : X ∈ Ring.carrier(realRing)
    rw carrier
    exact realX
  have nil := horner.nil at realRing, leading, X with
    realRing.comm_ring, leadingIn, xIn
  rw [value, nil]

theorem hornerFunction.cons (c X : Real)
  shows hornerFunction(leading, c :: cs)(X) = c + X * hornerFunction(X)
proof
  have realX : X ∈ ℝ by simp [Real]
  have realC : c ∈ ℝ by simp [Real]
  have consList : List(ℝ, c :: cs) by typecheck
  have value := hornerFunction.value at leading, c :: cs, X with
    initial, consList, realX
  have tailValue := hornerFunction.value at leading, cs, X with
    initial, coefficients, realX
  have carrier := realRing.carrierOf
  have leadingIn : leading ∈ Ring.carrier(realRing)
    rw carrier
    exact initial
  have xIn : X ∈ Ring.carrier(realRing)
    rw carrier
    exact realX
  have cIn : c ∈ Ring.carrier(realRing)
    rw carrier
    exact realC
  have listIn : List(Ring.carrier(realRing), cs)
    rw carrier
    exact coefficients
  have cons := horner.cons at realRing, leading, X, c, cs with
    realRing.comm_ring, leadingIn, xIn, cIn, listIn
  rw [realRing.addOf, realRing.mulOf] at cons
  rw [value, tailValue, cons]

-- The value as the engine-level Horner evaluation over the real pieces.
theorem hornerFunction.value_at (X : Real)
  shows hornerFunction(X) = hornerAt{ℝ}(realAdd, realMul, leading, X, cs)
proof
  have realX : X ∈ ℝ by simp [Real]
  have value := hornerFunction.value at leading, cs, X with
    initial, coefficients, realX
  have graph := horner.graph at realRing, leading, X, cs
  rw [realRing.carrierOf, realRing.addOf, realRing.mulOf] at graph
  rw [value, graph]

-- The function of the empty pair is the constant function.
theorem hornerFunction.nil_function
  shows hornerFunction(leading, []) = constantRealFunction(leading)
proof
  have nilList : List(ℝ, []) by typecheck
  have function := hornerFunction.function at leading, [] with
    initial, nilList
  have constant := constantRealFunction.function at leading
  have same : ∀ X ∈ ℝ, hornerFunction(leading, [])(X) =
      constantRealFunction(leading)(X)
    intros X realX
    have typedX : Real(X) by exact realX
    have left := hornerFunction.nil at leading, cs, X with
      initial, coefficients
    have right := constantRealFunction.value at leading, X
    rw [left, right]
  exact FunctionBetween.ext with function, constant, same

-- The function of a longer pair is c + X·p(X) as a pointwise combination.
theorem hornerFunction.cons_function (c : Real)
  shows hornerFunction(leading, c :: cs) =
    pointwiseAdd(constantRealFunction(c),
      pointwiseMul(identity(ℝ), hornerFunction))
proof
  have realC : c ∈ ℝ by simp [Real]
  have consList : List(ℝ, c :: cs) by typecheck
  have function := hornerFunction.function at leading, c :: cs with
    initial, consList
  have tailFunction := hornerFunction.function at leading, cs with
    initial, coefficients
  have constant := constantRealFunction.function at c
  have identityFunction := identity.function at ℝ
  have product := pointwiseMul.function with identityFunction, tailFunction
  have sum := pointwiseAdd.function with constant, product
  have same : ∀ X ∈ ℝ, hornerFunction(leading, c :: cs)(X) =
      pointwiseAdd(constantRealFunction(c),
        pointwiseMul(identity(ℝ), hornerFunction))(X)
    intros X realX
    have typedX : Real(X) by exact realX
    have left := hornerFunction.cons at leading, cs, c, X with
      initial, coefficients
    have constantValue := constantRealFunction.value at c, X
    have identityValue := identity.apply with realX
    have typedConstant : Real(constantRealFunction(c)(X)) by rwa constantValue
    have typedIdentity : Real(identity(ℝ)(X)) by rwa identityValue
    have typedTail : Real(hornerFunction(leading, cs)(X))
      exact FunctionBetween.apply_closed with tailFunction, realX
    have productValue := pointwiseMul.value with
      typedX, identityFunction, tailFunction, typedIdentity, typedTail
    have typedProduct : Real(pointwiseMul(identity(ℝ), hornerFunction)(X))
      exact FunctionBetween.apply_closed with product, realX
    have sumValue := pointwiseAdd.value with
      typedX, constant, product, typedConstant, typedProduct
    rw [left, sumValue, productValue, constantValue, identityValue]
  exact FunctionBetween.ext with function, sum, same

-- Continuity, by induction over an arbitrary coefficient list.
theorem hornerFunction.continuous_all (ds : List(ℝ))
  shows Continuous(hornerFunction(leading, ds))
proof
  induction ds
  | List.nil =>
    have same := hornerFunction.nil_function at leading, cs with
      initial, coefficients
    rw same
    exact constantRealFunction.continuous with initial
  | List.cons(c, tail) using ih =>
    have realC : c ∈ ℝ by assumption
    have typedC : Real(c) by exact realC
    have tailList : List(ℝ, tail) by typecheck
    have same := hornerFunction.cons_function at leading, tail, c with
      initial, tailList, typedC
    rw same
    have constant := constantRealFunction.continuous with typedC
    have product := Continuous.mul with identity.continuous, ih
    exact Continuous.add with constant, product

theorem hornerFunction.continuous
  shows Continuous(hornerFunction)
proof
  exact hornerFunction.continuous_all at leading, cs, cs with
    initial, coefficients, coefficients

theorem hornerFunction.continuous_on (S : Set)
  requires subset : S ⊆ ℝ
  shows ContinuousOn(hornerFunction, S)
proof
  have continuous := hornerFunction.continuous at leading, cs with
    initial, coefficients
  exact Continuous.continuous_on with continuous, subset

-- The derivative, by induction over an arbitrary coefficient list: the
-- recursion (c + X·p)′ = p + X·p′ of the derivative pair is the product
-- rule.
theorem hornerFunction.has_derivative_at_all (ds : List(ℝ)) (X : Real)
  shows HasDerivativeAt(hornerFunction(leading, ds),
    hornerFunction(realDerivativeLeading(leading, ds),
      realDerivativeList(ds))(X), X)
proof
  induction ds
  | List.nil =>
    have leadingIn : leading ∈ ℝ by exact initial
    have nilList : List(ℝ, []) by typecheck
    have leadingValue : realDerivativeLeading(leading, []) = realZero
      unfold realDerivativeLeading
      exact hornerDerivativeLeading.nil with reals.comm_ring, leadingIn
    have listValue : realDerivativeList([]) = []
      unfold realDerivativeList
      exact hornerDerivativeList.nil at ℝ, realAdd, realZero, realOne, realMul
    have typedZero : Real(realZero) by exact realZero.real
    have zeroValue := hornerFunction.nil at realZero, [], X with
      typedZero, nilList
    have same := hornerFunction.nil_function at leading, cs with
      initial, coefficients
    rw [leadingValue, listValue, zeroValue, same]
    exact constantRealFunction.has_derivative_at at leading, X
  | List.cons(c, tail) using ih =>
    have leadingIn : leading ∈ ℝ by exact initial
    have realX : X ∈ ℝ by simp [Real]
    have realC : c ∈ ℝ by assumption
    have typedC : Real(c) by exact realC
    have tailList : List(ℝ, tail) by typecheck
    have consList : List(ℝ, c :: tail) by typecheck
    have same := hornerFunction.cons_function at leading, tail, c with
      initial, tailList, typedC
    rw same
    have constantDerivative := constantRealFunction.has_derivative_at at c, X
    have identityDerivative := identity.has_derivative_at at X
    have identityValue := identity.apply with realX
    have typedIdentity : Real(identity(ℝ)(X)) by rwa identityValue
    have tailFunction := hornerFunction.function at leading, tail with
      initial, tailList
    have typedTail : Real(hornerFunction(leading, tail)(X))
      exact FunctionBetween.apply_closed with tailFunction, realX
    have tailLeading := realDerivativeLeading.real at leading, tail with
      initial, tailList
    have tailDerivativeList := realDerivativeList.list at leading, tail with
      initial, tailList
    have derivativeFunction := hornerFunction.function at
      realDerivativeLeading(leading, tail), realDerivativeList(tail) with
      tailLeading, tailDerivativeList
    have typedDerivative : Real(hornerFunction(realDerivativeLeading(leading,
        tail), realDerivativeList(tail))(X))
      exact FunctionBetween.apply_closed with derivativeFunction, realX
    have product := HasDerivativeAt.mul_value with
      identityDerivative, ih, typedIdentity, typedTail
    have sum := HasDerivativeAt.add with constantDerivative, product
    have consLeading := realDerivativeLeading.real at leading, c :: tail with
      initial, consList
    have consDerivativeList := realDerivativeList.list at
      leading, c :: tail with initial, consList
    have consValue := hornerFunction.value_at at
      realDerivativeLeading(leading, c :: tail),
      realDerivativeList(c :: tail), X with
      consLeading, consDerivativeList
    have tailValue := hornerFunction.value_at at leading, tail, X with
      initial, tailList
    have tailDerivativeValue := hornerFunction.value_at at
      realDerivativeLeading(leading, tail), realDerivativeList(tail), X with
      tailLeading, tailDerivativeList
    have recursion := hornerDerivative.value_cons at
      ℝ, realAdd, realZero, realNeg, realMul, realOne, leading, X, c,
      tail with tailList, reals.comm_ring, leadingIn, realX, realC
    have algebra : realZero + (realOne * hornerFunction(leading, tail)(X) +
        identity(ℝ)(X) * hornerFunction(realDerivativeLeading(leading, tail),
          realDerivativeList(tail))(X)) =
        hornerFunction(realDerivativeLeading(leading, c :: tail),
          realDerivativeList(c :: tail))(X)
      have typedTailAt := typedTail
      rw tailValue at typedTailAt
      have typedDerivativeAt := typedDerivative
      rw tailDerivativeValue at typedDerivativeAt
      unfold realDerivativeLeading at typedDerivativeAt
      unfold realDerivativeList at typedDerivativeAt
      rw [consValue, identityValue, tailValue, tailDerivativeValue]
      unfold realDerivativeLeading
      unfold realDerivativeList
      rw recursion
      ring
    exact HasDerivativeAt.congr_value with sum, algebra

-- The derivative of the function of a pair is the function of the
-- derivative pair.
theorem hornerFunction.has_derivative_at (X : Real)
  shows HasDerivativeAt(hornerFunction,
    hornerFunction(realDerivativeLeading(leading, cs),
      realDerivativeList(cs))(X), X)
proof
  exact hornerFunction.has_derivative_at_all at leading, cs, cs, X with
    initial, coefficients, coefficients

-- The value of the derivative pair's function is a real.
theorem hornerFunction.derivative_real (X : Real)
  shows Real(hornerFunction(realDerivativeLeading(leading, cs),
    realDerivativeList(cs))(X))
proof
  have realX : X ∈ ℝ by simp [Real]
  have derivativeLeading := realDerivativeLeading.real at leading, cs with
    initial, coefficients
  have derivativeList := realDerivativeList.list at leading, cs with
    initial, coefficients
  have function := hornerFunction.function at
    realDerivativeLeading(leading, cs), realDerivativeList(cs) with
    derivativeLeading, derivativeList
  exact FunctionBetween.apply_closed with function, realX

theorem hornerFunction.differentiable_at (X : Real)
  shows DifferentiableAt(hornerFunction, X)
proof
  have typedDerivative := hornerFunction.derivative_real at leading, cs, X with
    initial, coefficients
  have derivative := hornerFunction.has_derivative_at at leading, cs, X with
    initial, coefficients
  exact HasDerivativeAt.differentiable_at with derivative

theorem hornerFunction.derivative (X : Real)
  shows hornerFunction′(X) =
    hornerFunction(realDerivativeLeading(leading, cs),
      realDerivativeList(cs))(X)
proof
  have typedDerivative := hornerFunction.derivative_real at leading, cs, X with
    initial, coefficients
  have derivative := hornerFunction.has_derivative_at at leading, cs, X with
    initial, coefficients
  exact derivative.of_has_derivative with derivative

theorem hornerFunction.iterated_derivative (k : Nat) (X : Real)
  shows hornerFunction⁽ᵏ⁾(X) =
    hornerFunction(fst(realDerivativePair(leading, cs, k)),
      snd(realDerivativePair(leading, cs, k)))(X)
proof
  induction k generalizing X
  | zero =>
    intros X typedX
    rw [iteratedDerivative.zero, realDerivativePair.zero, fst.pair, snd.pair]
  | succ(j) using ih =>
    intros X typedX
    have one : j + 1 = succ(j) := add.right_one with *
    rw ← one
    rw iteratedDerivative.succ
    have function := hornerFunction.function at leading, cs with
      initial, coefficients
    have jFunction := iteratedDerivative.function at
      hornerFunction(leading, cs), j with function
    have pairReal := realDerivativePair.real at leading, cs, j with
      initial, coefficients
    have pairList := realDerivativePair.list at leading, cs, j with
      initial, coefficients
    have pairFunction := hornerFunction.function at
      fst(realDerivativePair(leading, cs, j)),
      snd(realDerivativePair(leading, cs, j)) with pairReal, pairList
    have agree : ∀ Y ∈ ℝ, hornerFunction⁽ʲ⁾(Y) =
        hornerFunction(fst(realDerivativePair(leading, cs, j)),
          snd(realDerivativePair(leading, cs, j)))(Y)
      intros Y realY
      have typedY : Real(Y) by exact realY
      exact ih with typedY
    have same := FunctionBetween.ext with jFunction, pairFunction, agree
    rw same
    have derivativeValue := hornerFunction.derivative at
      fst(realDerivativePair(leading, cs, j)),
      snd(realDerivativePair(leading, cs, j)), X with pairReal, pairList
    rw derivativeValue
    rw [realDerivativePair.succ, fst.pair, snd.pair]

-- The root set of the bundled real pair, read through the function.
theorem hornerFunction.root_iff (X : Real)
  shows X ∈ rootSet(realRing, leading, cs) ↔ hornerFunction(X) = (0:R)
proof
  have realX : X ∈ ℝ by simp [Real]
  have value := hornerFunction.value at leading, cs, X with
    initial, coefficients, realX
  have graph := rootSet.graph at realRing, leading, cs
  have body := horner.graph at realRing, leading, X, cs
  have membership := hornerRoots.membership at
    Ring.carrier(realRing), Ring.add(realRing), Ring.zero(realRing),
    Ring.mul(realRing), leading, cs, X
  rw [← graph, ← body, realRing.carrierOf, realRing.zeroOf] at membership
  rw value
  constructor
  . intro root
    exact (membership.forward with root).right
  . intro zero
    exact membership.backward with ⟨realX, zero⟩

theorem rootSet.subset_reals
  shows rootSet(realRing, leading, cs) ⊆ ℝ
proof
  intros X root
  have graph := rootSet.graph at realRing, leading, cs
  have membership := hornerRoots.membership at
    Ring.carrier(realRing), Ring.add(realRing), Ring.zero(realRing),
    Ring.mul(realRing), leading, cs, X
  rw [← graph, realRing.carrierOf] at membership
  exact (membership.forward with root).left

theorem rootSet.real_finite
  requires nonzero : leading ≠ (0:R)
  shows Finite(rootSet(realRing, leading, cs))
proof
  have carrier := realRing.carrierOf
  have leadingIn : leading ∈ Ring.carrier(realRing)
    rw carrier
    exact initial
  have listIn : List(Ring.carrier(realRing), cs)
    rw carrier
    exact coefficients
  have nonzeroIn : leading ≠ Ring.zero(realRing) by rwa realRing.zeroOf
  exact rootSet.finite at realRing, leading, cs with
    realRing.field, leadingIn, nonzeroIn, listIn

end Polynomials
