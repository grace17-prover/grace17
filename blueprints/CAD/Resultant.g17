-- The Sylvester matrix of two Horner pairs over a commutative ring and
-- the resultant as its determinant: with p = (a, cs) of declared degree
-- m = length(cs) and q = (b, ds) of declared degree n = length(ds), the
-- matrix has n rows of shifted coefficients of p followed by m rows of
-- shifted coefficients of q, in descending powers. Its closure, transport
-- under ring homomorphisms and evaluation of polynomial coefficients, the
-- values on constants and linear factors, multiplicativity, the Bézout
-- combination res = A·p + B·q with deg A < n and deg B < m, and the
-- vanishing at a common root.
-- Part of the CAD blueprint.
-- Planned home: Algebra/Polynomial/Resultant.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module CAD.Resultant
import CAD.HornerNormalForm
import CAD.DeterminantColumns
import Grace.Cumulus.Algebra.Ring.DeterminantHom
import Grace.Cumulus.Algebra.Polynomial.Determinant
import Grace.Cumulus.List.Replicate
import Grace.Cumulus.Nat.Subtraction

-- Row i of the block of (a, cs): i zeros, then a, c_{m−1}, …, c₀; later
-- entries are read as zero by listCoefficient.
def sylvesterRow {A : Set} (zero a : Set) (cs : List(A), i : Nat) : Set :=
  append{A}(reverse{A}(hornerFullList{A}(a, cs)), listReplicate(i, zero))

-- The entry at (i, j) of the block matrix whose first rowsP rows come
-- from (a, cs) and the rest from (b, ds).
def sylvesterEntry {A : Set} (zero a b : Set) (cs ds : List(A),
    rowsP i j : Nat) : Set :=
  boolChoice(memberTest(rowsP, i),
    listCoefficient{A}(zero, sylvesterRow{A}(zero, a, cs, i), j),
    listCoefficient{A}(zero, sylvesterRow{A}(zero, b, ds, i - rowsP), j))

defgraph sylvesterBlockMatrix (A zero a b cs ds rowsP size : Set)
  (p ∈ size × size) : A :=
  sylvesterEntry{A}(zero, a, b, cs, ds, rowsP, fst(p), snd(p))
requires zeroIn : zero ∈ A
requires left : a ∈ A
requires right : b ∈ A
requires leftList : List(A, cs)
requires rightList : List(A, ds)
proof
  sorry

def sylvesterMatrix {A : Set} (zero a b : Set) (cs ds : List(A)) : Set :=
  sylvesterBlockMatrix(A, zero, a, b, cs, ds, length{A}(ds),
    length{A}(cs) + length{A}(ds))

def resultant {A : Set} (add zero neg mul one a b : Set)
  (cs ds : List(A)) : Set :=
  determinant(length{A}(cs) + length{A}(ds), A, add, zero, neg, mul, one,
    sylvesterMatrix{A}(zero, a, b, cs, ds))
notation scoped resultant(R, a, cs, b, ds) =>
  resultant(R.carrier, R.add, R.zero, R.neg, R.mul, R.one, a, b, cs, ds)

theorem sylvesterRow.list (A zero a : Set) (cs : List(A), i : Nat)
  requires zeroIn : zero ∈ A
  requires initial : a ∈ A
  shows List(A, sylvesterRow{A}(zero, a, cs, i))
proof
  sorry

theorem sylvesterRow.length (A zero a : Set) (cs : List(A), i : Nat)
  shows length{A}(sylvesterRow{A}(zero, a, cs, i)) = i + succ(length{A}(cs))
proof
  sorry

-- The entry at column j of row i is the coefficient of degree m + i − j.
theorem sylvesterRow.coefficient (A zero a : Set) (cs : List(A), i j : Nat)
  requires zeroIn : zero ∈ A
  requires initial : a ∈ A
  requires lower : i ≤ j
  requires upper : j ≤ i + length{A}(cs)
  shows listCoefficient{A}(zero, sylvesterRow{A}(zero, a, cs, i), j) =
    hornerCoefficient{A}(zero, a, cs, (length{A}(cs) + i) - j)
proof
  sorry

theorem sylvesterRow.coefficient_outside (A zero a : Set)
  (cs : List(A), i j : Nat)
  requires zeroIn : zero ∈ A
  requires initial : a ∈ A
  requires outside : j < i ∨ i + length{A}(cs) < j
  shows listCoefficient{A}(zero, sylvesterRow{A}(zero, a, cs, i), j) = zero
proof
  sorry

section Rings
variable (A add zero neg mul one a b : Set)
notation ring R := (A, add, zero, neg, mul, one)
notation ring P := R[oneVariable]
hypothesis ring : IsCommRing(R)
hypothesis left : a ∈ R
hypothesis right : b ∈ R

theorem sylvesterBlockMatrix.matrix (cs ds : List(A)) (rowsP size : Nat)
  shows RingMatrix(size, R, sylvesterBlockMatrix(A, zero, a, b, cs, ds, rowsP,
    size))
proof
  sorry

theorem sylvesterBlockMatrix.entry_upper (cs ds : List(A))
  (rowsP size i j : Nat)
  requires upper : i < rowsP
  requires row : i < size
  requires column : j < size
  shows sylvesterBlockMatrix(A, zero, a, b, cs, ds, rowsP, size)[i, j] =
    listCoefficient{A}(zero, sylvesterRow{A}(zero, a, cs, i), j)
proof
  sorry

theorem sylvesterBlockMatrix.entry_lower (cs ds : List(A))
  (rowsP size i j : Nat)
  requires lower : rowsP ≤ i
  requires row : i < size
  requires column : j < size
  shows sylvesterBlockMatrix(A, zero, a, b, cs, ds, rowsP, size)[i, j] =
    listCoefficient{A}(zero, sylvesterRow{A}(zero, b, ds, i - rowsP), j)
proof
  sorry

theorem sylvesterMatrix.matrix (cs ds : List(A))
  shows RingMatrix(length{A}(cs) + length{A}(ds), R, sylvesterMatrix{A}(zero,
    a, b, cs, ds))
proof
  sorry

theorem resultant.closed (cs ds : List(A))
  shows resultant(R, a, cs, b, ds) ∈ R
proof
  sorry

-- A constant p has resultant aⁿ with every q of declared degree n.
theorem resultant.constant_left (ds : List(A))
  shows resultant(R, a, [], b, ds) = monoidPow(R, a, length{A}(ds))
proof
  sorry

theorem resultant.constant_right (cs : List(A))
  shows resultant(R, a, cs, b, []) = monoidPow(R, b, length{A}(cs))
proof
  sorry

-- The resultant of X − r with q is q(r).
theorem resultant.linear_left (r : Set) (ds : List(A))
  requires center : r ∈ R
  shows resultant(R, one, neg(r) :: [], b, ds) = hornerAt{A}(add, mul, b, r, ds)
proof
  sorry

-- Swapping the pairs changes the sign by (−1)^(m·n).
theorem resultant.swap (cs ds : List(A))
  shows resultant(R, b, ds, a, cs) =
    R[monoidPow(R, -R[1], length{A}(cs) * length{A}(ds)) *
      resultant(R, a, cs, b, ds)]
proof
  sorry

theorem resultant.scale_left (c : Set) (cs ds : List(A))
  requires scalar : c ∈ R
  shows resultant(R, R[c * a], hornerScale{A}(mul, c, cs), b, ds) =
    R[monoidPow(R, c, length{A}(ds)) * resultant(R, a, cs, b, ds)]
proof
  sorry

-- Multiplicativity in the first argument.
theorem resultant.mul_left (c : Set) (cs es ds : List(A))
  requires other : c ∈ R
  shows resultant(R, R[a * c], hornerMulList{A}(add, zero, mul, a, c, cs, es),
    b, ds) =
    R[resultant(R, a, cs, b, ds) * resultant(R, c, es, b, ds)]
proof
  sorry

-- The Bézout combination: res = A·p + B·q with deg A < n, deg B < m.
theorem resultant.combination (cs ds : List(A))
  shows ∃ us, List(A, us) ∧ ∃ vs, List(A, vs) ∧
    length{A}(us) = length{A}(ds) ∧ length{A}(vs) = length{A}(cs) ∧
    P[hornerPoly{A}(add, zero, neg, mul, one, zero, us) * hornerPoly{A}(add,
      zero, neg, mul, one, a, cs) +
      hornerPoly{A}(add, zero, neg, mul, one, zero, vs) * hornerPoly{A}(add,
        zero, neg, mul, one, b, ds)] =
    polynomialConstant(oneVariable, R, resultant(R, a, cs, b, ds))
proof
  sorry

-- At a common root the resultant vanishes.
theorem resultant.eq_zero_of_common_root (r : Set) (cs ds : List(A))
  requires center : r ∈ R
  requires rootLeft : hornerAt{A}(add, mul, a, r, cs) = R[0]
  requires rootRight : hornerAt{A}(add, mul, b, r, ds) = R[0]
  shows resultant(R, a, cs, b, ds) = R[0]
proof
  sorry

end Rings

section Homomorphisms
variable (A add zero neg mul one B plus z minus times unit h a b : Set)
notation ring R := (A, add, zero, neg, mul, one)
notation ring S := (B, plus, z, minus, times, unit)
hypothesis source : IsCommRing(R)
hypothesis target : IsCommRing(S)
hypothesis hom : IsRingHom(h, R, S)
hypothesis left : a ∈ R
hypothesis right : b ∈ R

theorem resultant.map (cs ds : List(A))
  shows h(resultant(R, a, cs, b, ds)) =
    resultant(S, h(a), listMap{A}(h, cs), h(b), listMap{A}(h, ds))
proof
  sorry

end Homomorphisms

section Evaluation
variable (I A add zero neg mul one v a b : Set)
notation ring R := (A, add, zero, neg, mul, one)
notation ring P := R[I]
hypothesis ring : IsCommRing(R)
hypothesis assignment : v : I → R
hypothesis left : a ∈ P
hypothesis right : b ∈ P

-- The resultant of pairs with polynomial coefficients commutes with
-- evaluating the coefficients, the declared degrees being kept.
theorem resultant.evaluate (cs ds : List(polynomials(I, A, zero)))
  shows polynomialAt(I, R, v)(resultant(P, a, cs, b, ds)) =
    resultant(R, polynomialAt(I, R, v)(a),
      listMap{polynomials(I, A, zero)}(polynomialAt(I, R, v), cs),
      polynomialAt(I, R, v)(b),
      listMap{polynomials(I, A, zero)}(polynomialAt(I, R, v), ds))
proof
  sorry

end Evaluation

-- The bundled resultant over a bundled commutative ring.
section Bundled
variable (R : Set)
hypothesis comm : CommRing(R)

def resultantOf (a b cs ds : Set) : Set :=
  resultant{R.carrier}(R.add, R.zero, R.neg, R.mul, R.one, a, b, cs, ds)

instance resultantOf.mem (a b : R) (cs ds : List(R.carrier))
  shows resultantOf(a, b, cs, ds) ∈ R
proof
  sorry

theorem resultantOf.eq_zero_of_common_root (a b r : R) (cs ds : List(R.carrier))
  requires rootLeft : horner(R, a, r, cs) = R[0]
  requires rootRight : horner(R, b, r, ds) = R[0]
  shows resultantOf(a, b, cs, ds) = R[0]
proof
  sorry

end Bundled
