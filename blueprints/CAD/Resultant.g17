        cs, ds, length{A}(ds),
        length{A}(cs) + length{A}(ds))), last), length{A}(ds),
        length{A}(cs))), vsList,
    usLength, vsLength, ?_⟩
  rw [← polyComb, valueQ, valueP]
  ring

-- At a common root the resultant vanishes (m + n > 0 added in round 1).
theorem resultant.eq_zero_of_common_root (r : Set) (cs ds : List(A))
  requires positive : 0 < length{A}(cs) + length{A}(ds)
  requires center : r ∈ R
  requires rootLeft : hornerAt{A}(add, mul, a, r, cs) = R[0]
  requires rootRight : hornerAt{A}(add, mul, b, r, ds) = R[0]
  shows resultant(R, a, cs, b, ds) = R[0]
proof
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have polynomials := polynomials.comm_ring at oneVariable, A, add, zero, neg,
    mul, one with *
  have polynomialRing := IsCommRing.ring with polynomials
  obtain ⟨us, usList, vs, vsList, usLength, vsLength, identity⟩ :=
    resultant.combination at A, add, zero, neg, mul, one, a, b, cs, ds with *
  have assignment := constantFunction.function at oneVariable, A, r with *
  have hom := polynomialAt.hom at oneVariable, A, add, zero, neg, mul, one,
    constantFunction(oneVariable, A, r) with *
  have usPoly := hornerPoly.member at A, add, zero, neg, mul, one, zero,
    us with *
  have vsPoly := hornerPoly.member at A, add, zero, neg, mul, one, zero,
    vs with *
  have pMember := hornerPoly.member at A, add, zero, neg, mul, one, a, cs with *
  have qMember := hornerPoly.member at A, add, zero, neg, mul, one, b, ds with *
  have leftIn := IsRing.mul_closed with polynomialRing, usPoly, pMember
  have rightIn := IsRing.mul_closed with polynomialRing, vsPoly, qMember
  have resultantIn := resultant.closed at A, add, zero, neg, mul, one, a, b, cs,
    ds with *
  have mapped : polynomialAt(oneVariable, R, constantFunction(oneVariable, A,
      r))(P[hornerPoly{A}(add, zero, neg, mul, one, zero, us) *
        hornerPoly{A}(add, zero, neg, mul, one, a, cs) +
        hornerPoly{A}(add, zero, neg, mul, one, zero, vs) *
        hornerPoly{A}(add, zero, neg, mul, one, b, ds)]) =
      polynomialAt(oneVariable, R, constantFunction(oneVariable, A,
        r))(polynomialConstant(oneVariable, R, resultant(R, a, cs, b, ds)))
    rw identity
    rfl
  have addLaw := IsRingHom.add with hom, leftIn, rightIn
  have mulLawP := IsRingHom.mul with hom, usPoly, pMember
  have mulLawQ := IsRingHom.mul with hom, vsPoly, qMember
  have valueP := hornerPoly.value at A, add, zero, neg, mul, one, a, r,
    cs with *
  have valueQ := hornerPoly.value at A, add, zero, neg, mul, one, b, r,
    ds with *
  have constantLaw := polynomialAt.constant at oneVariable, A, add, zero, neg,
    mul, one, constantFunction(oneVariable, A, r), resultant(R, a, cs, b, ds)
    with *
  rw [addLaw, mulLawP, mulLawQ, valueP, valueQ, rootLeft, rootRight,
    constantLaw]
    at mapped
  have usValue := IsRingHom.closed with hom, usPoly
  have vsValue := IsRingHom.closed with hom, vsPoly
  rw ← mapped
  ring
end Rings2

section Homomorphisms
variable (A add zero neg mul one B plus z minus times unit h a b : Set)
notation ring R := (A, add, zero, neg, mul, one)
notation ring S := (B, plus, z, minus, times, unit)
hypothesis source : IsCommRing(R)
hypothesis target : IsCommRing(S)
hypothesis hom : IsRingHom(h, R, S)
hypothesis left : a ∈ R
hypothesis right : b ∈ R

theorem sylvesterRow.map (cs : List(A)) (i : Nat)
  shows listMap{A}(h, sylvesterRow{A}(zero, a, cs, i)) =
    sylvesterRow{B}(z, h(a), listMap{A}(h, cs), i)
proof
  have function := IsRingHom.function with hom
  have ordinary := IsCommRing.ring with source
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have mapsZero := IsRingHom.zero with hom
  have full := hornerFullList.list at A, a, cs with left
  have reversed : List(A, reverse{A}(hornerFullList{A}(a, cs))) by typecheck
  have zeros := listReplicate.closed at A, zero, i with zeroIn
  have fullMap := hornerFullList.map at A, add, zero, neg, mul, one, B, plus, z,
    minus, times, unit, h, a, cs with *
  have reverseMap := listMap.reverse at A, B, h, hornerFullList{A}(a, cs)
    with function
  have zerosMap := listReplicate.map at A, B, h, zero, i with function, zeroIn
  unfold sylvesterRow
  rw [listMap.append, reverseMap, fullMap, zerosMap, mapsZero]
  rfl

theorem resultant.map (cs ds : List(A))
  shows h(resultant(R, a, cs, b, ds)) =
    resultant(S, h(a), listMap{A}(h, cs), h(b), listMap{A}(h, ds))
proof
  have function := IsRingHom.function with hom
  have ordinary := IsCommRing.ring with source
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have mapsZero := IsRingHom.zero with hom
  have mappedLeft := IsRingHom.closed with hom, left
  have mappedRight := IsRingHom.closed with hom, right
  have csMapped := listMap.closed at A, B, h, cs with function
  have dsMapped := listMap.closed at A, B, h, ds with function
  have csLength := listMap.length at A, B, h, cs with function
  have dsLength := listMap.length at A, B, h, ds with function
  have matrixM := sylvesterBlockMatrix.matrix at A, add, zero, neg, mul, one, a,
    b, cs, ds, length{A}(ds), length{A}(cs) + length{A}(ds) with *
  have matrixN := sylvesterBlockMatrix.matrix at B, plus, z, minus, times, unit,
    h(a), h(b), listMap{A}(h, cs), listMap{A}(h, ds), length{A}(ds),
    length{A}(cs) + length{A}(ds) with *
  have sizeNat : Nat(length{A}(cs) + length{A}(ds)) by typecheck
  have positions := natural.member at length{A}(cs) + length{A}(ds)
  have entries : ∀ i ∈ length{A}(cs) + length{A}(ds),
      ∀ j ∈ length{A}(cs) + length{A}(ds),
      sylvesterBlockMatrix(B, z, h(a), h(b), listMap{A}(h, cs), listMap{A}(h,
      ds),
        length{A}(ds), length{A}(cs) + length{A}(ds))[i, j] =
      h(sylvesterBlockMatrix(A, zero, a, b, cs, ds, length{A}(ds),
        length{A}(cs) + length{A}(ds))[i, j])
    intros i hi j hj
    have iNat := positions with i, hi
    have jNat := positions with j, hj
    have rowRule := Less.of_membership at i,
      length{A}(cs) + length{A}(ds) with *
    have row := rowRule with hi
    have columnRule := Less.of_membership at j, length{A}(cs) + length{A}(ds)
      with *
    have column := columnRule with hj
    have alternatives : i < length{A}(ds) ∨ ¬(i < length{A}(ds)) by tauto
    cases alternatives with upper | lower
    . have entryM := sylvesterBlockMatrix.entry_upper at A, add, zero, neg, mul,
        one, a, b, cs, ds, length{A}(ds), length{A}(cs) + length{A}(ds), i, j
        with *
      have entryN := sylvesterBlockMatrix.entry_upper at B, plus, z, minus,
        times,
        unit, h(a), h(b), listMap{A}(h, cs), listMap{A}(h, ds), length{A}(ds),
        length{A}(cs) + length{A}(ds), i, j with *
      have rowMap := sylvesterRow.map at A, add, zero, neg, mul, one, B, plus,
        z,
        minus, times, unit, h, a, b, cs, i with *
      have rowList := sylvesterRow.list at A, zero, a, cs, i with *
      have coefficientMap := listCoefficient.map at A, B, h, zero,
        sylvesterRow{A}(zero, a, cs, i), j with function, zeroIn
      rw [entryM, entryN, ← coefficientMap, rowMap, mapsZero]
      rfl
    . have bound := LessEqual.of_not_Less with lower
      have entryM := sylvesterBlockMatrix.entry_lower at A, add, zero, neg, mul,
        one, a, b, cs, ds, length{A}(ds), length{A}(cs) + length{A}(ds), i, j
        with *
      have entryN := sylvesterBlockMatrix.entry_lower at B, plus, z, minus,
        times,
        unit, h(a), h(b), listMap{A}(h, cs), listMap{A}(h, ds), length{A}(ds),
        length{A}(cs) + length{A}(ds), i, j with *
      have rowMap := sylvesterRow.map at A, add, zero, neg, mul, one, B, plus,
        z,
        minus, times, unit, h, b, b, ds, i - length{A}(ds) with *
      have rowList := sylvesterRow.list at A, zero, b, ds, i - length{A}(ds)
        with *
      have coefficientMap := listCoefficient.map at A, B, h, zero,
        sylvesterRow{A}(zero, b, ds, i - length{A}(ds)), j with function, zeroIn
      rw [entryM, entryN, ← coefficientMap, rowMap, mapsZero]
      rfl
  unfold resultant
  unfold sylvesterMatrix
  rw [csLength, dsLength]
  exact determinant.map with *

end Homomorphisms

section Evaluation
variable (I A add zero neg mul one v a b : Set)
notation ring R := (A, add, zero, neg, mul, one)
notation ring P := R[I]
hypothesis ring : IsCommRing(R)
hypothesis assignment : v : I → R
hypothesis left : a ∈ P
hypothesis right : b ∈ P

-- The resultant of pairs with polynomial coefficients commutes with
-- evaluating the coefficients, the declared degrees being kept.
theorem resultant.evaluate (cs ds : List(polynomials(I, A, zero)))
  shows polynomialAt(I, R, v)(resultant(P, a, cs, b, ds)) =
    resultant(R, polynomialAt(I, R, v)(a),
      listMap{polynomials(I, A, zero)}(polynomialAt(I, R, v), cs),
      polynomialAt(I, R, v)(b),
      listMap{polynomials(I, A, zero)}(polynomialAt(I, R, v), ds))
proof
  have polynomials := polynomials.comm_ring at I, A, add, zero, neg, mul, one
    with *
  have evaluation := polynomialAt.hom with *
  exact resultant.map with *

end Evaluation

-- The bundled resultant over a bundled commutative ring.
section Bundled
variable (R : Set)
hypothesis comm : CommRing(R)

def resultantOf (a b cs ds : Set) : Set :=
  resultant{R.carrier}(R.add, R.zero, R.neg, R.mul, R.one, a, b, cs, ds)

instance resultantOf.mem (a b : R) (cs ds : List(R.carrier))
  shows resultantOf(a, b, cs, ds) ∈ R
proof
  have parts := CommRing.parts with comm
  have aIn : a ∈ R by assumption
  have bIn : b ∈ R by assumption
  unfold resultantOf
  exact resultant.closed at R.carrier, R.add, R.zero, R.neg, R.mul, R.one, a, b,
    cs, ds with *

-- m + n > 0 added in round 1 (two zero constants have resultant 1).
theorem resultantOf.eq_zero_of_common_root (a b r : R) (cs ds : List(R.carrier))
  requires positive : 0 < length{R.carrier}(cs) + length{R.carrier}(ds)
  requires rootLeft : horner(R, a, r, cs) = R[0]
  requires rootRight : horner(R, b, r, ds) = R[0]
  shows resultantOf(a, b, cs, ds) = R[0]
proof
  have parts := CommRing.parts with comm
  have aIn : a ∈ R by assumption
  have bIn : b ∈ R by assumption
  have rIn : r ∈ R by assumption
  rw horner.graph at rootLeft
  rw horner.graph at rootRight
  unfold resultantOf
  exact resultant.eq_zero_of_common_root at R.carrier, R.add, R.zero, R.neg,
    R.mul, R.one, a, b, r, cs, ds with *
end Bundled
