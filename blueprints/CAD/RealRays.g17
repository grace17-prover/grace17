-- The unbounded open intervals of the real line: the rays above and
-- below a point, their membership laws, and their relation to the
-- bounded intervals.
-- Part of the CAD blueprint.
-- Planned home: Real/Analysis/OpenIntervals.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module CAD.RealRays
import Grace.Cumulus.Real.Analysis.OpenIntervals

def rayAbove (A : Real) : Set := { X ∈ ℝ | A < X }
def rayBelow (A : Real) : Set := { X ∈ ℝ | X < A }

theorem rayAbove.subset_reals (A : Real)
  shows rayAbove(A) ⊆ ℝ
proof
  intros X hX
  obtain ⟨real, above⟩ := rayAbove.membership.forward with hX
  exact real

theorem rayBelow.subset_reals (A : Real)
  shows rayBelow(A) ⊆ ℝ
proof
  intros X hX
  obtain ⟨real, below⟩ := rayBelow.membership.forward with hX
  exact real

theorem rayAbove.nonempty (A : Real)
  shows Nonempty(rayAbove(A))
proof
  have sumReal : Real(A + 1) by typecheck
  have inSum : A + 1 ∈ ℝ by simp [Real]
  have above : A < A + 1 by linarith
  have member : A + 1 ∈ rayAbove(A)
    apply rayAbove.membership.backward
    exact ⟨inSum, above⟩
  exact ⟨A + 1, member⟩

theorem rayBelow.nonempty (A : Real)
  shows Nonempty(rayBelow(A))
proof
  have differenceReal : Real(A - 1) by typecheck
  have inDifference : A - 1 ∈ ℝ by simp [Real]
  have below : A - 1 < A by linarith
  have member : A - 1 ∈ rayBelow(A)
    apply rayBelow.membership.backward
    exact ⟨inDifference, below⟩
  exact ⟨A - 1, member⟩

theorem openInterval.subset_rayAbove (A B : Real)
  shows openInterval(A, B) ⊆ rayAbove(A)
proof
  intros X hX
  obtain ⟨real, lower, upper⟩ := openInterval.membership.forward with hX
  apply rayAbove.membership.backward
  exact ⟨real, lower⟩

theorem openInterval.subset_rayBelow (A B : Real)
  shows openInterval(A, B) ⊆ rayBelow(B)
proof
  intros X hX
  obtain ⟨real, lower, upper⟩ := openInterval.membership.forward with hX
  apply rayBelow.membership.backward
  exact ⟨real, upper⟩

theorem rayAbove.ball_subset (A X E : Real)
  requires lower : A ≤ X - E
  shows openBall(X, E) ⊆ rayAbove(A)
proof
  intros Y hY
  obtain ⟨realY, near⟩ := openBall.membership.forward with hY
  obtain ⟨lowerY, upperY⟩ := openBall.order_characterization.forward with hY
  apply rayAbove.membership.backward
  refine ⟨realY, ?_⟩
  linarith

theorem rayBelow.ball_subset (A X E : Real)
  requires upper : X + E ≤ A
  shows openBall(X, E) ⊆ rayBelow(A)
proof
  intros Y hY
  obtain ⟨realY, near⟩ := openBall.membership.forward with hY
  obtain ⟨lowerY, upperY⟩ := openBall.order_characterization.forward with hY
  apply rayBelow.membership.backward
  refine ⟨realY, ?_⟩
  linarith

-- A closed interval inside a ray.
theorem closedInterval.subset_rayAbove (A B C : Real)
  requires below : C < A
  shows closedInterval(A, B) ⊆ rayAbove(C)
proof
  intros X hX
  obtain ⟨real, lower, upper⟩ := closedInterval.membership.forward with hX
  apply rayAbove.membership.backward
  refine ⟨real, ?_⟩
  linarith

theorem closedInterval.subset_rayBelow (A B C : Real)
  requires above : B < C
  shows closedInterval(A, B) ⊆ rayBelow(C)
proof
  intros X hX
  obtain ⟨real, lower, upper⟩ := closedInterval.membership.forward with hX
  apply rayBelow.membership.backward
  refine ⟨real, ?_⟩
  linarith
