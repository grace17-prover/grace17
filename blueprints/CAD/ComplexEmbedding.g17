module CAD.ComplexEmbedding
import Grace.Cumulus.Complex.Field
import Grace.Cumulus.Algebra.Polynomial.HornerHom
import Grace.Cumulus.Algebra.Polynomial.BundledRoots
import Grace.Cumulus.Real.Field

defgraph complexOfReal (a ∈ ℝ) : complexCarrier := (a, realZero)
proof
  have aReal : Real(a) by exact member
  have zeroReal : Real(realZero) := realZero.real
  exact complexCarrier.pair at a, realZero with aReal, zeroReal

defgraph complexConj (z ∈ complexCarrier) : complexCarrier := (fst(z),
    realNeg(snd(z)))
proof
  obtain ⟨a, aReal, b, bReal, shape⟩ := complexCarrier.cases with member
  have negReal : Real(realNeg(b)) by typecheck
  rw [shape, fst.pair, snd.pair]
  exact complexCarrier.pair at a, realNeg(b) with aReal, negReal

section Embedding
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

theorem complexOfReal.hom
  shows IsRingHom(complexOfReal, R, ℂ)
proof
  have source := reals.comm_ring
  have target := complexes.comm_ring
  have function := complexOfReal.function
  have additive : ∀ x ∈ ℝ, ∀ y ∈ ℝ,
      complexOfReal(R[x + y]) = ℂ[complexOfReal(x) + complexOfReal(y)]
    intros x xMember y yMember
    have xReal : Real(x) by exact xMember
    have yReal : Real(y) by exact yMember
    have sumReal : Real(R[x + y]) by typecheck
    rw [complexOfReal.value, complexOfReal.value, complexOfReal.value,
      realPair.add]
    rfl
  have multiplicative : ∀ x ∈ ℝ, ∀ y ∈ ℝ,
      complexOfReal(R[x * y]) = ℂ[complexOfReal(x) * complexOfReal(y)]
    intros x xMember y yMember
    have xReal : Real(x) by exact xMember
    have yReal : Real(y) by exact yMember
    have productReal : Real(R[x * y]) by typecheck
    rw [complexOfReal.value, complexOfReal.value, complexOfReal.value,
      realPair.mul]
    rfl
  have unital : complexOfReal(realOne) = complexOne
    have oneReal : Real(realOne) := realOne.real
    rw complexOfReal.value
    simp [complexOne]
  exact IsRingHom.of_add_mul_one with source, target, function, additive,
    multiplicative, unital

theorem complexOfReal.ring_hom
  shows complexOfReal : realRing →+* complexRing
proof
  have hom := complexOfReal.hom
  have source : CommRing(realRing) := realRing.comm_ring
  have target : CommRing(complexRing) := complexRing.comm_ring
  have parts : IsRingHom(complexOfReal, Ring.carrier(realRing),
      Ring.add(realRing), Ring.zero(realRing), Ring.neg(realRing),
      Ring.mul(realRing), Ring.one(realRing), Ring.carrier(complexRing),
      Ring.add(complexRing), Ring.zero(complexRing), Ring.neg(complexRing),
      Ring.mul(complexRing), Ring.one(complexRing))
    simp [hom, realRing, complexRing, Ring.mk.carrier, Ring.mk.add,
      Ring.mk.zero, Ring.mk.neg, Ring.mk.mul, Ring.mk.one]
  exact RingHom.of_projections with (CommRing.to_ring with source),
    (CommRing.to_ring with target), parts

theorem complexOfReal.injective (a b : Real)
  requires equal : complexOfReal(a) = complexOfReal(b)
  shows a = b
proof
  have first := complexOfReal.value at a with *
  have second := complexOfReal.value at b with *
  rw [first, second] at equal
  have both := orderedPair.injective with equal
  exact both.left

theorem complexOfReal.zero
  shows complexOfReal((0:R)) = ℂ[0]
proof
  have zeroReal : Real(realZero) := realZero.real
  rw complexOfReal.value
  simp [complexZero]

theorem complexOfReal.one
  shows complexOfReal((1:R)) = ℂ[1]
proof
  have oneReal : Real(realOne) := realOne.real
  rw complexOfReal.value
  simp [complexOne]

theorem complexOfReal.list (cs : List(ℝ))
  shows List(ℂ, listMap{ℝ}(complexOfReal, cs))
proof
  have function := complexOfReal.function
  exact listMap.closed at ℝ, complexCarrier, complexOfReal, cs with *

-- The bundled real ring evaluates Horner pairs with the real operations.
theorem complexOfReal.horner_unfold (leading x : Set) (cs : List(ℝ))
  shows horner(realRing, leading, x, cs) =
    hornerAt{ℝ}(realAdd, realMul, leading, x, cs)
proof
  rw horner.graph
  simp [realRing, Ring.mk.carrier, Ring.mk.add, Ring.mk.mul]

-- The value of a real pair at a real point, read in ℂ.
theorem complexOfReal.horner (leading x : Real) (cs : List(ℝ))
  shows complexOfReal(horner(realRing, leading, x, cs)) =
    hornerAt{ℂ}(complexAdd, complexMul, complexOfReal(leading),
      complexOfReal(x),
      listMap{ℝ}(complexOfReal, cs))
proof
  have ring := reals.comm_ring
  have hom := complexOfReal.hom
  have initial : leading ∈ ℝ by simp [Real]
  have element : x ∈ ℝ by simp [Real]
  have transported := hornerAt.map at ℝ, realAdd, realZero, realNeg, realMul,
    realOne, complexCarrier, complexAdd, complexZero, complexNeg, complexMul,
    complexOne, complexOfReal, leading, x, cs with ring, hom, initial, element
  rw complexOfReal.horner_unfold
  exact transported

theorem complexOfReal.root_iff (leading x : Real) (cs : List(ℝ))
  shows hornerAt{ℂ}(complexAdd, complexMul, complexOfReal(leading),
    complexOfReal(x),
      listMap{ℝ}(complexOfReal, cs)) = ℂ[0] ↔
    horner(realRing, leading, x, cs) = (0:R)
proof
  have ring := reals.comm_ring
  have initial : leading ∈ ℝ by simp [Real]
  have element : x ∈ ℝ by simp [Real]
  have closed := hornerAt.closed at ℝ, realAdd, realZero, realNeg, realMul,
    realOne, leading, x, cs with ring, initial, element
  rw ← complexOfReal.horner_unfold at closed
  have valueReal : Real(horner(realRing, leading, x, cs)) by exact closed
  have zeroReal : Real((0:R)) := realZero.real
  have transported := complexOfReal.horner at leading, x, cs with *
  have zero := complexOfReal.zero
  rw ← transported
  constructor
  . intro vanish
    rw ← zero at vanish
    exact complexOfReal.injective with vanish
  . intro vanish
    rw vanish
    exact zero

theorem complexConj.pair (a b : Real)
  shows complexConj((a, b)) = (a, -b)
proof
  have member : (a, b) ∈ complexCarrier := complexCarrier.pair at a, b with *
  have value := complexConj.value at (a, b) with member
  rw [value, fst.pair, snd.pair]
  rfl

theorem complexConj.hom
  shows IsRingHom(complexConj, ℂ, ℂ)
proof
  have ring := complexes.comm_ring
  have function := complexConj.function
  have additive : ∀ u ∈ ℂ, ∀ v ∈ ℂ,
      complexConj(ℂ[u + v]) = ℂ[complexConj(u) + complexConj(v)]
    intros u uMember v vMember
    obtain ⟨a, aReal, b, bReal, uShape⟩ := complexCarrier.cases with uMember
    obtain ⟨c, cReal, d, dReal, vShape⟩ := complexCarrier.cases with vMember
    have sumReal : Real(a + c) by typecheck
    have otherSumReal : Real(b + d) by typecheck
    have negB : Real(-b) by typecheck
    have negD : Real(-d) by typecheck
    have negSum : -(b + d) = -b + -d by ring
    rw [uShape, vShape, complexAdd.pair, complexConj.pair, complexConj.pair,
      complexConj.pair, complexAdd.pair, negSum]
    rfl
  have multiplicative : ∀ u ∈ ℂ, ∀ v ∈ ℂ,
      complexConj(ℂ[u * v]) = ℂ[complexConj(u) * complexConj(v)]
    intros u uMember v vMember
    obtain ⟨a, aReal, b, bReal, uShape⟩ := complexCarrier.cases with uMember
    obtain ⟨c, cReal, d, dReal, vShape⟩ := complexCarrier.cases with vMember
    have firstReal : Real(a * c + -(b * d)) by typecheck
    have secondReal : Real(a * d + b * c) by typecheck
    have negB : Real(-b) by typecheck
    have negD : Real(-d) by typecheck
    have first : a * c + -(b * d) = a * c + -(-b * -d) by ring
    have second : -(a * d + b * c) = a * -d + -b * c by ring
    rw [uShape, vShape, complexMul.pair, complexConj.pair, complexConj.pair,
      complexConj.pair, complexMul.pair, first, second]
    rfl
  have unital : complexConj(complexOne) = complexOne
    have oneReal : Real(realOne) := realOne.real
    have zeroReal : Real(realZero) := realZero.real
    have negZero : -realZero = realZero by ring
    have shape : complexOne = (realOne, realZero) by simp [complexOne]
    rw [shape, complexConj.pair, negZero]
    rfl
  exact IsRingHom.of_add_mul_one with ring, ring, function, additive,
    multiplicative, unital

theorem complexConj.involution (z : Set)
  requires member : z ∈ ℂ
  shows complexConj(complexConj(z)) = z
proof
  obtain ⟨a, aReal, b, bReal, shape⟩ := complexCarrier.cases with member
  have negReal : Real(-b) by typecheck
  have negNeg : -(-b) = b by ring
  rw [shape, complexConj.pair, complexConj.pair, negNeg]
  rfl

theorem complexConj.fixes_real (a : Real)
  shows complexConj(complexOfReal(a)) = complexOfReal(a)
proof
  have zeroReal : Real(realZero) := realZero.real
  have negZero : -realZero = realZero by ring
  rw [complexOfReal.value, complexConj.pair, negZero]
  rfl

-- The fixed points of conjugation are exactly the real axis.
theorem complexConj.fixed_iff (z : Set)
  requires member : z ∈ ℂ
  shows complexConj(z) = z ↔ ∃ a ∈ ℝ, z = complexOfReal(a)
proof
  obtain ⟨a, aReal, b, bReal, shape⟩ := complexCarrier.cases with member
  have aMember : a ∈ ℝ by simp [Real]
  have zeroReal : Real(realZero) := realZero.real
  rw [shape, complexConj.pair]
  constructor
  . intro fixed
    have both := orderedPair.injective with fixed
    have flipped := both.right
    have bZero : b = realZero by linarith
    refine ⟨a, aMember, ?_⟩
    rw [shape, complexOfReal.value, bZero]
    rfl
  . intro axis
    obtain ⟨c, cMember, equal⟩ := axis
    have cReal : Real(c) by exact cMember
    rw [shape, complexOfReal.value] at equal
    have both := orderedPair.injective with equal
    have negZero : -realZero = realZero by ring
    rw [both.left, both.right, negZero]
    rfl

-- Conjugation fixes every real coefficient of a list.
theorem complexConj.map_of_real (cs : List(ℝ))
  shows listMap{complexCarrier}(complexConj, listMap{ℝ}(complexOfReal, cs)) =
    listMap{ℝ}(complexOfReal, cs)
proof
  have function := complexOfReal.function
  induction cs
  | List.nil =>
    simp [listMap]
  | List.cons(a, tail) using ih =>
    have element : a ∈ ℝ by assumption
    have aReal : Real(a) by exact element
    have image : complexOfReal(a) ∈ complexCarrier :=
      FunctionBetween.apply_closed with function, element
    have mapped := listMap.closed at ℝ, complexCarrier, complexOfReal, tail
      with function
    have fixed := complexConj.fixes_real at a with *
    simp [listMap, fixed, ih]

-- Conjugation commutes with a polynomial with real coefficients.
theorem complexConj.horner_real (leading : Real) (z : Set) (cs : List(ℝ))
  requires member : z ∈ ℂ
  shows complexConj(hornerAt{ℂ}(complexAdd, complexMul, complexOfReal(leading),
    z,
      listMap{ℝ}(complexOfReal, cs))) =
    hornerAt{ℂ}(complexAdd, complexMul, complexOfReal(leading), complexConj(z),
      listMap{ℝ}(complexOfReal, cs))
proof
  have ring := complexes.comm_ring
  have hom := complexConj.hom
  have function := complexOfReal.function
  have leadingMember : leading ∈ ℝ by simp [Real]
  have initial : complexOfReal(leading) ∈ complexCarrier :=
    FunctionBetween.apply_closed with function, leadingMember
  have mapped := listMap.closed at ℝ, complexCarrier, complexOfReal, cs
    with function
  have transported := hornerAt.map at complexCarrier, complexAdd, complexZero,
    complexNeg, complexMul, complexOne, complexCarrier, complexAdd, complexZero,
    complexNeg, complexMul, complexOne, complexConj, complexOfReal(leading), z,
    listMap{ℝ}(complexOfReal, cs) with ring, hom, initial, member
  have fixedLeading := complexConj.fixes_real at leading with *
  have fixedList := complexConj.map_of_real at cs with *
  rw [fixedLeading, fixedList] at transported
  exact transported

theorem complexConj.root_of_root (leading : Real) (z : Set) (cs : List(ℝ))
  requires member : z ∈ ℂ
  requires root : hornerAt{ℂ}(complexAdd, complexMul, complexOfReal(leading), z,
    listMap{ℝ}(complexOfReal, cs)) = ℂ[0]
  shows hornerAt{ℂ}(complexAdd, complexMul, complexOfReal(leading),
    complexConj(z),
    listMap{ℝ}(complexOfReal, cs)) = ℂ[0]
proof
  have hom := complexConj.hom
  have commuted := complexConj.horner_real at leading, z, cs with member
  rw [← commuted, root]
  exact IsRingHom.zero with hom

end Embedding
