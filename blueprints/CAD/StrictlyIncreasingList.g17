-- Strictly increasing lists of reals: the enumeration of a finite set of
-- reals in increasing order exists and is unique, has distinct entries,
-- as many as the set has elements, begins with the least and ends with
-- the greatest element, and nothing of the set lies strictly between two
-- consecutive entries.
-- Part of the CAD blueprint.
-- Planned home: List/RealSorted.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module CAD.StrictlyIncreasingList
import CAD.RealFiniteExtrema
import Grace.Cumulus.List.NoDup
import Grace.Cumulus.List.Index
import Grace.Cumulus.Real.Natural

predicate StrictlyIncreasingList (xs : List(ℝ)) :=
  ∀ i, Nat(i) → ∀ j, Nat(j) → i < j → j < length{ℝ}(xs) →
    (listCoefficient{ℝ}((0:R), xs, i):R) < (listCoefficient{ℝ}((0:R), xs, j):R)

theorem StrictlyIncreasingList.nil
  shows StrictlyIncreasingList([])
proof
  unfold StrictlyIncreasingList
  intros i iNat j jNat below bound
  rw length.nil at bound
  exfalso
  arith

theorem StrictlyIncreasingList.singleton (x : Real)
  shows StrictlyIncreasingList(x :: [])
proof
  unfold StrictlyIncreasingList
  intros i iNat j jNat below bound
  have xIn : x ∈ ℝ by simp [Real]
  rw length.singleton at bound
  exfalso
  arith

-- The head of an increasing list is below every entry of the tail.
theorem StrictlyIncreasingList.head_lt (x : Real) (xs : List(ℝ))
  requires increasing : StrictlyIncreasingList(x :: xs)
  shows ∀ y ∈ listSupport{ℝ}(xs), x < (y:R)
proof
  intros y hy
  have xIn : x ∈ ℝ by simp [Real]
  obtain ⟨k, kNat, bound, value⟩ :=
    listSupport.mem_iff_index.forward at ℝ, (0:R), y, xs with hy
  have kSucc : Nat(succ(k)) by typecheck
  have positive : 0 < succ(k) by arith
  have inside : succ(k) < length{ℝ}(x :: xs)
    rw length.cons
    arith
  unfold StrictlyIncreasingList at increasing
  have step := increasing with 0, Naturals.constructor.zero, succ(k), kSucc,
    positive, inside
  rw [listCoefficient.zero, listCoefficient.succ, value] at step
  exact step

theorem StrictlyIncreasingList.tail (x : Real) (xs : List(ℝ))
  requires increasing : StrictlyIncreasingList(x :: xs)
  shows StrictlyIncreasingList(xs)
proof
  unfold StrictlyIncreasingList
  intros i iNat j jNat below bound
  have xIn : x ∈ ℝ by simp [Real]
  have iSucc : Nat(succ(i)) by typecheck
  have jSucc : Nat(succ(j)) by typecheck
  have belowSucc : succ(i) < succ(j) by arith
  have inside : succ(j) < length{ℝ}(x :: xs)
    rw length.cons
    arith
  unfold StrictlyIncreasingList at increasing
  have step := increasing with succ(i), iSucc, succ(j), jSucc, belowSucc, inside
  rw [listCoefficient.succ, listCoefficient.succ] at step
  exact step

theorem StrictlyIncreasingList.cons (x : Real) (xs : List(ℝ))
  requires head : ∀ y ∈ listSupport{ℝ}(xs), x < (y:R)
  requires increasing : StrictlyIncreasingList(xs)
  shows StrictlyIncreasingList(x :: xs)
proof
  unfold StrictlyIncreasingList
  intros i iNat j jNat below bound
  have xIn : x ∈ ℝ by simp [Real]
  rw length.cons at bound
  have shapeJ := natural.zero_or_successor at j with jNat
  cases shapeJ with zeroJ | successorJ
  . rw zeroJ at below
    exfalso
    arith
  . obtain ⟨q, qNat, equalJ⟩ := successorJ
    rw equalJ at bound
    have insideQ : q < length{ℝ}(xs) by arith
    have memberQ :=
      listCoefficient.mem_support at ℝ, (0:R), xs, q with insideQ
    have shapeI := natural.zero_or_successor at i with iNat
    cases shapeI with zeroI | successorI
    . rw [zeroI, equalJ, listCoefficient.zero, listCoefficient.succ]
      exact head with listCoefficient{ℝ}((0:R), xs, q), memberQ
    . obtain ⟨p, pNat, equalI⟩ := successorI
      rw [equalI, equalJ] at below
      have belowPQ : p < q by arith
      unfold StrictlyIncreasingList at increasing
      have step := increasing with p, pNat, q, qNat, belowPQ, insideQ
      rw [equalI, equalJ, listCoefficient.succ, listCoefficient.succ]
      exact step

theorem StrictlyIncreasingList.cons_iff (x : Real) (xs : List(ℝ))
  shows StrictlyIncreasingList(x :: xs) ↔
    ((∀ y ∈ listSupport{ℝ}(xs), x < (y:R)) ∧ StrictlyIncreasingList(xs))
proof
  constructor
  . intro increasing
    have head := StrictlyIncreasingList.head_lt with increasing
    have tail := StrictlyIncreasingList.tail with increasing
    exact ⟨head, tail⟩
  . intro both
    obtain ⟨head, tail⟩ := both
    exact StrictlyIncreasingList.cons with head, tail

-- The head of an increasing list is not among the entries of its tail.
theorem StrictlyIncreasingList.head_absent (x : Real) (xs : List(ℝ))
  requires increasing : StrictlyIncreasingList(x :: xs)
  shows ¬(x ∈ listSupport{ℝ}(xs))
proof
  intro member
  have head := StrictlyIncreasingList.head_lt with increasing
  have less := head with x, member
  linarith

theorem StrictlyIncreasingList.nodup (xs : List(ℝ))
  requires increasing : StrictlyIncreasingList(xs)
  shows ListNoDup(ℝ, xs)
proof
  induction xs
  | List.nil =>
    intro increasing
    exact ListNoDup.nil at ℝ
  | List.cons(x, tail) using ih =>
    intro increasing
    have element : x ∈ ℝ by assumption
    have typedX : Real(x) by exact element
    have absent := StrictlyIncreasingList.head_absent with increasing
    have tailIncreasing := StrictlyIncreasingList.tail with increasing
    have tailNoDup := ih with tailIncreasing
    exact ListNoDup.cons with element, absent, tailNoDup

theorem StrictlyIncreasingList.length (xs : List(ℝ))
  requires increasing : StrictlyIncreasingList(xs)
  shows length{ℝ}(xs) = cardinality(listSupport{ℝ}(xs))
proof
  induction xs
  | List.nil =>
    intro increasing
    rw [length.nil, listSupport.nil, cardinality.empty]
    rfl
  | List.cons(x, tail) using ih =>
    intro increasing
    have element : x ∈ ℝ by assumption
    have typedX : Real(x) by exact element
    have absent := StrictlyIncreasingList.head_absent with increasing
    have tailIncreasing := StrictlyIncreasingList.tail with increasing
    have tailLength := ih with tailIncreasing
    have tailList : List(ℝ, tail) by assumption
    have finite := listSupport.finite at ℝ, tail with tailList
    have inserted := cardinality.insert with finite, absent
    have support := listSupport.cons at ℝ, x, tail with element
    rw [length.cons, support, inserted, tailLength]
    rfl

-- The head of an increasing list is the least element of its support.
theorem StrictlyIncreasingList.cons_head_least (x : Real) (xs : List(ℝ))
  requires increasing : StrictlyIncreasingList(x :: xs)
  shows x = realLeast(listSupport{ℝ}(x :: xs))
proof
  have xIn : x ∈ ℝ by simp [Real]
  have xMember := listSupport.mem_cons_self at ℝ, x, xs with xIn
  have inhabited : Nonempty(listSupport{ℝ}(x :: xs)) := ⟨x, xMember⟩
  have consList : List(ℝ, x :: xs) by typecheck
  have reals := listSupport.subset at ℝ, x :: xs with consList
  have finite := listSupport.finite at ℝ, x :: xs with consList
  have selected := realLeast.selected at listSupport{ℝ}(x :: xs)
    with inhabited, reals, finite
  have leastReal : Real(realLeast(listSupport{ℝ}(x :: xs))) by
    exact selected.left
  have leastLe := selected.right.right with x, xMember
  have leastMember := selected.right.left
  have iff := listSupport.mem_cons_iff
    at ℝ, x, realLeast(listSupport{ℝ}(x :: xs)), xs with xIn
  have cases := iff.forward with leastMember
  cases cases with same | inTail
  . symm
    exact same
  . have head := StrictlyIncreasingList.head_lt with increasing
    have less := head with realLeast(listSupport{ℝ}(x :: xs)), inTail
    exfalso
    linarith

-- The support of the tail is the support without the head.
theorem StrictlyIncreasingList.support_tail (x : Real) (xs : List(ℝ))
  requires increasing : StrictlyIncreasingList(x :: xs)
  shows listSupport{ℝ}(xs) = listSupport{ℝ}(x :: xs) ∖ {x}
proof
  have xIn : x ∈ ℝ by simp [Real]
  have absent := StrictlyIncreasingList.head_absent with increasing
  ext y
  constructor
  . intro hy
    have notSingleton : ¬(y ∈ {x})
      intro inSingleton
      have equal := singleton.membership.forward with inSingleton
      rw equal at hy
      exact absent with hy
    have inCons := listSupport.mem_cons_of_mem with xIn, hy
    apply difference.membership.backward
    exact ⟨inCons, notSingleton⟩
  . intro hy
    obtain ⟨inCons, notSingleton⟩ := difference.membership.forward with hy
    have iff := listSupport.mem_cons_iff at ℝ, x, y, xs with xIn
    have cases := iff.forward with inCons
    cases cases with same | inTail
    . exfalso
      apply notSingleton
      rw same
      exact singleton.self at x
    . exact inTail

-- Every finite set of reals is the support of an increasing list.
theorem Finite.exists_increasing_list_of_size (n : Nat)
  shows ∀ S, S ⊆ ℝ → Finite(S) → cardinality(S) = n →
    ∃ xs, List(ℝ, xs) ∧ StrictlyIncreasingList(xs) ∧
      listSupport{ℝ}(xs) = S
proof
  induction n
  | zero =>
    intros S reals finite size
    have empty : S = ∅
      ext y
      constructor
      . intro hy
        exfalso
        have removed := cardinality.remove with finite, hy
        rw size at removed
        exact Naturals.disjoint.zero.succ at cardinality(S ∖ {y}) with removed
      . intro hy
        exfalso
        exact set.empty with hy
    have nilList : List(ℝ, []) by typecheck
    refine ⟨[], nilList, StrictlyIncreasingList.nil, ?_⟩
    rw [listSupport.nil, empty]
    rfl
  | succ(k) using ih =>
    intros S reals finite size
    obtain ⟨e, he, restSize, restored⟩ :=
      cardinality.exists_remove with finite, size
    have inhabited : Nonempty(S) := ⟨e, he⟩
    have selected := realLeast.selected at S with inhabited, reals, finite
    have leastIn : realLeast(S) ∈ ℝ := selected.left
    have leastReal : Real(realLeast(S)) by exact leastIn
    have leastMember := selected.right.left
    have leastLe := selected.right.right
    have restSubset := difference.subset_left at S, {realLeast(S)}
    have restReals := Subset.transitive with restSubset, reals
    have restFinite := Finite.subset with finite, restSubset
    have removed := cardinality.remove with finite, leastMember
    rw size at removed
    have restCount : cardinality(S ∖ {realLeast(S)}) = k
      symm
      exact Naturals.injective.succ with removed
    obtain ⟨xs, listXs, increasing, support⟩ :=
      ih with S ∖ {realLeast(S)}, restReals, restFinite, restCount
    have head : ∀ y ∈ listSupport{ℝ}(xs), realLeast(S) < (y:R)
      intros y hy
      rw support at hy
      obtain ⟨inS, notSingleton⟩ := difference.membership.forward with hy
      have yIn : y ∈ ℝ := reals with y, inS
      have typedY : Real(y) by exact yIn
      have le := leastLe with y, inS
      have distinct : realLeast(S) ≠ y
        intro equal
        apply notSingleton
        rw ← equal
        exact singleton.self at realLeast(S)
      have split := realLess.trichotomy at realLeast(S), y
      rcases split with below | same | above
      . exact below
      . exfalso
        exact distinct with same
      . exfalso
        linarith
    have consList := List.closed_cons at ℝ, realLeast(S), xs with leastIn
    have consIncreasing := StrictlyIncreasingList.cons with head, increasing
    refine ⟨realLeast(S) :: xs, consList, consIncreasing, ?_⟩
    have consSupport := listSupport.cons at ℝ, realLeast(S), xs with leastIn
    rw [consSupport, support]
    ext y
    constructor
    . intro hy
      have cases := insert.membership.forward with hy
      cases cases with same | inRest
      . rw same
        exact leastMember
      . obtain ⟨inS, notSingleton⟩ :=
        difference.membership.forward with inRest
        exact inS
    . intro hy
      apply insert.membership.backward
      have decide : y = realLeast(S) ∨ ¬(y = realLeast(S)) by tauto
      cases decide with same | distinct
      . left
        exact same
      . right
        apply difference.membership.backward
        refine ⟨hy, ?_⟩
        intro inSingleton
        exact distinct with (singleton.membership.forward with inSingleton)

theorem Finite.exists_increasing_list (S : Set)
  requires reals : S ⊆ ℝ
  requires finite : Finite(S)
  shows ∃ xs, List(ℝ, xs) ∧ StrictlyIncreasingList(xs) ∧ listSupport{ℝ}(xs) = S
proof
  have natural := cardinality.nat with finite
  have size : cardinality(S) = cardinality(S) by rfl
  exact Finite.exists_increasing_list_of_size at cardinality(S)
    with natural, S, reals, finite, size

theorem StrictlyIncreasingList.unique_of_support (xs ys : List(ℝ))
  requires first : StrictlyIncreasingList(xs)
  requires second : StrictlyIncreasingList(ys)
  requires same : listSupport{ℝ}(xs) = listSupport{ℝ}(ys)
  shows xs = ys
proof
  induction xs generalizing ys
  | List.nil =>
    intros ys listYs first second same
    rw listSupport.nil at same
    symm at same
    symm
    exact listSupport.eq_empty with same
  | List.cons(x, tail) using ih =>
    intros ys listYs first second same
    have element : x ∈ ℝ by assumption
    have typedX : Real(x) by exact element
    have shape := List.cases at ℝ, ys with listYs
    cases shape with empty | cons
    . exfalso
      rw [empty, listSupport.nil] at same
      have memberX := listSupport.mem_cons_self at ℝ, x, tail with element
      rw same at memberX
      exact set.empty with memberX
    . obtain ⟨y, yIn, rest, restList, equal⟩ := cons
      have typedY : Real(y) by exact yIn
      rw equal at second
      rw equal at same
      rw equal
      have xLeast := StrictlyIncreasingList.cons_head_least with first
      have yLeast := StrictlyIncreasingList.cons_head_least with second
      rw same at xLeast
      have headsEqual : x = y
        cc [xLeast, yLeast]
      have tailSupport := StrictlyIncreasingList.support_tail with first
      have restSupport := StrictlyIncreasingList.support_tail with second
      have sameTails : listSupport{ℝ}(tail) = listSupport{ℝ}(rest)
        rw [tailSupport, restSupport, same, headsEqual]
        rfl
      have tailIncreasing := StrictlyIncreasingList.tail with first
      have restIncreasing := StrictlyIncreasingList.tail with second
      have tailsEqual := ih with rest, restList, tailIncreasing,
        restIncreasing, sameTails
      rw [headsEqual, tailsEqual]
      rfl

theorem StrictlyIncreasingList.head_least (xs : List(ℝ))
  requires increasing : StrictlyIncreasingList(xs)
  requires nonempty : xs ≠ []
  shows listHeadOr{ℝ}((0:R), xs) = realLeast(listSupport{ℝ}(xs))
proof
  have shape := List.cases at ℝ, xs with *
  cases shape with empty | cons
  . exfalso
    exact nonempty with empty
  . obtain ⟨x, xIn, tail, tailList, equal⟩ := cons
    have typedX : Real(x) by exact xIn
    rw equal at increasing
    rw equal
    have least := StrictlyIncreasingList.cons_head_least with increasing
    rw listHeadOr.cons
    exact least

theorem StrictlyIncreasingList.last_greatest (xs : List(ℝ))
  requires increasing : StrictlyIncreasingList(xs)
  requires nonempty : xs ≠ []
  shows listCoefficient{ℝ}((0:R), xs, predecessor(length{ℝ}(xs))) =
    realGreatest(listSupport{ℝ}(xs))
proof
  have zeroReal : Real((0:R)) by typecheck
  have zeroIn : (0:R) ∈ ℝ by exact zeroReal
  have positive := length.positive_of_ne_nil at ℝ, xs with nonempty
  have lengthNat : Nat(length{ℝ}(xs)) by typecheck
  have shape := natural.zero_or_successor at length{ℝ}(xs) with lengthNat
  cases shape with zero | successor
  . exfalso
    rw zero at positive
    arith
  . obtain ⟨m, mNat, equal⟩ := successor
    have predecessorEq : predecessor(length{ℝ}(xs)) = m
      rw equal
      exact predecessor.succ at m
    rw predecessorEq
    have bound : m < length{ℝ}(xs)
      rw equal
      arith
    have lastMember :=
      listCoefficient.mem_support at ℝ, (0:R), xs, m with bound
    have lastReal : Real(listCoefficient{ℝ}((0:R), xs, m)) by
      exact listCoefficient.closed at ℝ, (0:R), xs, m with zeroIn
    have inhabited : Nonempty(listSupport{ℝ}(xs)) :=
      ⟨listCoefficient{ℝ}((0:R), xs, m), lastMember⟩
    have xsList : List(ℝ, xs) by assumption
    have reals := listSupport.subset at ℝ, xs with xsList
    have finite := listSupport.finite at ℝ, xs with xsList
    have selected := realGreatest.selected at listSupport{ℝ}(xs)
      with inhabited, reals, finite
    have greatestReal : Real(realGreatest(listSupport{ℝ}(xs))) by
      exact selected.left
    have lastLe := selected.right.right
      with listCoefficient{ℝ}((0:R), xs, m), lastMember
    have greatestMember := selected.right.left
    obtain ⟨j, jNat, jBound, jValue⟩ := listSupport.mem_iff_index.forward
      at ℝ, (0:R), realGreatest(listSupport{ℝ}(xs)), xs with greatestMember
    have split := Less.trichotomy at j, m with jNat, mNat
    rcases split with below | same | above
    . unfold StrictlyIncreasingList at increasing
      have less := increasing with j, jNat, m, mNat, below, bound
      rw jValue at less
      exfalso
      linarith
    . rw same at jValue
      exact jValue
    . exfalso
      rw equal at jBound
      arith

-- Consecutive entries have nothing of the support between them.
theorem StrictlyIncreasingList.between_consecutive (xs : List(ℝ)) (i : Nat)
  (y : Real)
  requires increasing : StrictlyIncreasingList(xs)
  requires bound : succ(i) < length{ℝ}(xs)
  requires above : (listCoefficient{ℝ}((0:R), xs, i):R) < y
  requires below : y < (listCoefficient{ℝ}((0:R), xs, succ(i)):R)
  shows ¬(y ∈ listSupport{ℝ}(xs))
proof
  intro member
  have zeroReal : Real((0:R)) by typecheck
  have zeroIn : (0:R) ∈ ℝ by exact zeroReal
  have iNat : Nat(i) by typecheck
  have succNat : Nat(succ(i)) by typecheck
  have iBound : i < length{ℝ}(xs) by arith
  have entryReal : Real(listCoefficient{ℝ}((0:R), xs, i)) by
    exact listCoefficient.closed at ℝ, (0:R), xs, i with zeroIn
  have nextReal : Real(listCoefficient{ℝ}((0:R), xs, succ(i))) by
    exact listCoefficient.closed at ℝ, (0:R), xs, succ(i) with zeroIn
  obtain ⟨j, jNat, jBound, jValue⟩ :=
    listSupport.mem_iff_index.forward at ℝ, (0:R), y, xs with member
  unfold StrictlyIncreasingList at increasing
  have split := Less.trichotomy at j, i with jNat, iNat
  rcases split with belowI | sameI | aboveI
  . have less := increasing with j, jNat, i, iNat, belowI, iBound
    rw jValue at less
    linarith
  . rw sameI at jValue
    rw jValue at above
    linarith
  . have splitSucc := Less.trichotomy at succ(i), j with succNat, jNat
    rcases splitSucc with belowJ | sameJ | aboveJ
    . have less := increasing with succ(i), succNat, j, jNat, belowJ, jBound
      rw jValue at less
      linarith
    . rw ← sameJ at jValue
      rw jValue at below
      linarith
    . arith

-- An element of the support below a later entry is below or at the
-- entry before it: the entries sweep the support in order.
theorem StrictlyIncreasingList.index_of_mem (xs : List(ℝ)) (y : Set)
  requires increasing : StrictlyIncreasingList(xs)
  requires member : y ∈ listSupport{ℝ}(xs)
  shows ∃ i, Nat(i) ∧ i < length{ℝ}(xs) ∧ listCoefficient{ℝ}((0:R), xs, i) = y
proof
  exact listSupport.mem_iff_index.forward at ℝ, (0:R), y, xs with member

theorem StrictlyIncreasingList.coefficient_mem (xs : List(ℝ)) (i : Nat)
  requires bound : i < length{ℝ}(xs)
  shows listCoefficient{ℝ}((0:R), xs, i) ∈ listSupport{ℝ}(xs)
proof
  exact listCoefficient.mem_support with bound
