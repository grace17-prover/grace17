-- Strictly increasing lists of reals: the enumeration of a finite set of
-- reals in increasing order exists and is unique, has distinct entries,
-- as many as the set has elements, begins with the least and ends with
-- the greatest element, and nothing of the set lies strictly between two
-- consecutive entries.
-- Part of the CAD blueprint.
-- Planned home: List/RealSorted.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module CAD.StrictlyIncreasingList
import CAD.RealFiniteExtrema
import Grace.Cumulus.List.NoDup
import Grace.Cumulus.List.Index
import Grace.Cumulus.Real.Natural

predicate StrictlyIncreasingList (xs : List(ℝ)) :=
  ∀ i, Nat(i) → ∀ j, Nat(j) → i < j → j < length{ℝ}(xs) →
    (listCoefficient{ℝ}((0:R), xs, i):R) < (listCoefficient{ℝ}((0:R), xs, j):R)

theorem StrictlyIncreasingList.nil
  shows StrictlyIncreasingList([])
proof
  sorry

theorem StrictlyIncreasingList.singleton (x : Real)
  shows StrictlyIncreasingList(x :: [])
proof
  sorry

theorem StrictlyIncreasingList.cons_iff (x : Real) (xs : List(ℝ))
  shows StrictlyIncreasingList(x :: xs) ↔
    ((∀ y ∈ listSupport{ℝ}(xs), x < (y:R)) ∧ StrictlyIncreasingList(xs))
proof
  sorry

theorem StrictlyIncreasingList.tail (x : Real) (xs : List(ℝ))
  requires increasing : StrictlyIncreasingList(x :: xs)
  shows StrictlyIncreasingList(xs)
proof
  sorry

theorem StrictlyIncreasingList.nodup (xs : List(ℝ))
  requires increasing : StrictlyIncreasingList(xs)
  shows ListNoDup(ℝ, xs)
proof
  sorry

theorem StrictlyIncreasingList.length (xs : List(ℝ))
  requires increasing : StrictlyIncreasingList(xs)
  shows length{ℝ}(xs) = cardinality(listSupport{ℝ}(xs))
proof
  sorry

-- Every finite set of reals is the support of an increasing list.
theorem Finite.exists_increasing_list (S : Set)
  requires reals : S ⊆ ℝ
  requires finite : Finite(S)
  shows ∃ xs, List(ℝ, xs) ∧ StrictlyIncreasingList(xs) ∧ listSupport{ℝ}(xs) = S
proof
  sorry

theorem StrictlyIncreasingList.unique_of_support (xs ys : List(ℝ))
  requires first : StrictlyIncreasingList(xs)
  requires second : StrictlyIncreasingList(ys)
  requires same : listSupport{ℝ}(xs) = listSupport{ℝ}(ys)
  shows xs = ys
proof
  sorry

theorem StrictlyIncreasingList.head_least (xs : List(ℝ))
  requires increasing : StrictlyIncreasingList(xs)
  requires nonempty : xs ≠ []
  shows listHeadOr{ℝ}((0:R), xs) = realLeast(listSupport{ℝ}(xs))
proof
  sorry

theorem StrictlyIncreasingList.last_greatest (xs : List(ℝ))
  requires increasing : StrictlyIncreasingList(xs)
  requires nonempty : xs ≠ []
  shows listCoefficient{ℝ}((0:R), xs, predecessor(length{ℝ}(xs))) =
    realGreatest(listSupport{ℝ}(xs))
proof
  sorry

-- Consecutive entries have nothing of the support between them.
theorem StrictlyIncreasingList.between_consecutive (xs : List(ℝ)) (i : Nat)
  (y : Real)
  requires increasing : StrictlyIncreasingList(xs)
  requires bound : succ(i) < length{ℝ}(xs)
  requires above : (listCoefficient{ℝ}((0:R), xs, i):R) < y
  requires below : y < (listCoefficient{ℝ}((0:R), xs, succ(i)):R)
  shows ¬(y ∈ listSupport{ℝ}(xs))
proof
  sorry

-- An element of the support below a later entry is below or at the
-- entry before it: the entries sweep the support in order.
theorem StrictlyIncreasingList.index_of_mem (xs : List(ℝ)) (y : Set)
  requires increasing : StrictlyIncreasingList(xs)
  requires member : y ∈ listSupport{ℝ}(xs)
  shows ∃ i, Nat(i) ∧ i < length{ℝ}(xs) ∧ listCoefficient{ℝ}((0:R), xs, i) = y
proof
  sorry

theorem StrictlyIncreasingList.coefficient_mem (xs : List(ℝ)) (i : Nat)
  requires bound : i < length{ℝ}(xs)
  shows listCoefficient{ℝ}((0:R), xs, i) ∈ listSupport{ℝ}(xs)
proof
  sorry
