-- Division with remainder of Horner pairs over a field: dividing (a, cs)
-- by (b, ds) with b ≠ 0 gives a quotient list and a remainder list of
-- the length of ds (so of degree below the divisor's), with
-- p = q·d + r as values and as polynomials, its uniqueness, and
-- divisibility HornerDivides with the factor theorem in that language.
-- Quotients and remainders are full lists, read with leading zero.
-- Part of the CAD blueprint.
-- Planned home: Algebra/Polynomial/HornerDivision.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module CAD.HornerDivision
import CAD.HornerNormalForm
import Grace.Cumulus.Algebra.Field.Construction
import Grace.Cumulus.List.Replicate
import Grace.Cumulus.List.TakeDrop

-- One step of long division from the low end: the candidate c :: rs has
-- one entry more than the divisor; its top entry divided by b is the
-- next quotient coefficient t, and t·d is subtracted.
def hornerDivStep {A : Set} (add zero neg mul one b : Set) (ds qs rs : List(A))
  (c : Set) : Set :=
  (call2(mul, listCoefficient{A}(zero, c :: rs, length{A}(ds)),
      fieldInverseValue(A, add, zero, neg, mul, one, b)) :: qs,
    listTake{A}(length{A}(ds), hornerSub{A}(add, zero, neg, c :: rs,
      hornerScale{A}(mul,
        call2(mul, listCoefficient{A}(zero, c :: rs, length{A}(ds)),
          fieldInverseValue(A, add, zero, neg, mul, one, b)),
        hornerFullList{A}(b, ds)))))

-- The quotient and remainder of (a, cs) by (b, ds), as the pair
-- (quotient list, remainder list), by recursion on cs.
def hornerDivPair {A : Set} (add zero neg mul one b a : Set)
    (ds cs : List(A)) → Set
  | add, zero, neg, mul, one, b, a, ds, List.nil =>
      hornerDivStep{A}(add, zero, neg, mul, one, b, ds, [],
        listReplicate(length{A}(ds), zero), a)
  | add, zero, neg, mul, one, b, a, ds, List.cons(c, tail) =>
      hornerDivStep{A}(add, zero, neg, mul, one, b, ds,
        fst(hornerDivPair(add, zero, neg, mul, one, b, a, ds, tail)),
        snd(hornerDivPair(add, zero, neg, mul, one, b, a, ds, tail)), c)
  descends cs

def hornerDivQuotient {A : Set} (add zero neg mul one b a : Set)
  (ds cs : List(A)) : Set :=
  fst(hornerDivPair{A}(add, zero, neg, mul, one, b, a, ds, cs))
def hornerDivRemainder {A : Set} (add zero neg mul one b a : Set)
  (ds cs : List(A)) : Set :=
  snd(hornerDivPair{A}(add, zero, neg, mul, one, b, a, ds, cs))

-- (b, ds) divides (a, cs): some polynomial times (b, ds) is (a, cs).
predicate HornerDivides (A add zero neg mul one b ds a cs : Set) :=
  ∃ qs, List(A, qs) ∧
    hornerPoly{A}(add, zero, neg, mul, one, a, cs) =
      call2(polynomialMul(oneVariable, A, add, zero, neg, mul, one),
        hornerPoly{A}(add, zero, neg, mul, one, zero, qs),
        hornerPoly{A}(add, zero, neg, mul, one, b, ds))

-- Coefficientwise laws of the list operations, the decomposition of a list
-- into its top entry and the rest, and the polynomials of zero-padded lists.
section Lists
variable (A add zero neg mul one : Set)
notation ring R := (A, add, zero, neg, mul, one)
notation ring P := R[oneVariable]
hypothesis ring : IsCommRing(R)

theorem hornerAdd.coefficient (cs ds : List(A)) (k : Nat)
  requires bound : k < length{A}(cs)
  shows listCoefficient{A}(zero, hornerAdd{A}(add, zero, cs, ds), k) =
    R[listCoefficient{A}(zero, cs, k) + listCoefficient{A}(zero, ds, k)]
proof
  induction cs generalizing ds k
  | List.nil =>
    intros ds k dsList kNat bound
    rw length.nil at bound
    have zeroLe := Grace.Cumulus.Nat.Order.LessEqual.zero at k with kNat
    have circular := Less.transitive_LessEqual with bound, zeroLe
    have irreflexive := Less.irreflexive at k with kNat
    exfalso
    exact irreflexive with circular
  | List.cons(c, tail) using ih =>
    intros ds k dsList kNat bound
    have coefficient : c ∈ R by assumption
    have ordinary := IsCommRing.ring with ring
    have zeroIn := IsRing.zero_in_carrier with ordinary
    have other := listHeadOr.closed at A, zero, ds with *
    have head := IsRing.add_closed with ordinary, coefficient, other
    have rest := listTail.closed at A, ds with *
    have added := hornerAdd.data at A, add, zero, neg, mul, one, tail,
      listTail{A}(ds) with *
    have addedList := added.left
    have shape := natural.zero_or_successor at k with kNat
    rw hornerAdd
    cases shape with isZero | isSucc
    . have headValue : listCoefficient{A}(zero, ds, 0) = listHeadOr{A}(zero, ds)
        rw listCoefficient
        rfl
      rw [isZero, listCoefficient.zero, listCoefficient.zero, headValue]
      rfl
    . obtain ⟨j, jNat, equal⟩ := isSucc
      rw [equal, length.cons] at bound
      have jBound : j < length{A}(tail) by arith
      have previous := ih at listTail{A}(ds), j with rest, jNat, jBound
      have tailValue : listCoefficient{A}(zero, ds, succ(j)) =
          listCoefficient{A}(zero, listTail{A}(ds), j)
        rw listCoefficient
        rfl
      rw [equal, listCoefficient.succ, listCoefficient.succ, previous,
        tailValue]
      rfl

theorem hornerScale.coefficient (t : Set) (cs : List(A)) (k : Nat)
  requires scalar : t ∈ R
  shows listCoefficient{A}(zero, hornerScale{A}(mul, t, cs), k) =
    R[t * listCoefficient{A}(zero, cs, k)]
proof
  induction cs generalizing k
  | List.nil =>
    intros k kNat
    rw [hornerScale, listCoefficient.nil]
    ring
  | List.cons(c, tail) using ih =>
    intros k kNat
    have coefficient : c ∈ R by assumption
    have ordinary := IsCommRing.ring with ring
    have head := IsRing.mul_closed with ordinary, scalar, coefficient
    have scaled := hornerScale.data at A, add, zero, neg, mul, one, t, tail
      with *
    have scaledList := scaled.left
    have shape := natural.zero_or_successor at k with kNat
    rw hornerScale
    cases shape with isZero | isSucc
    . rw [isZero, listCoefficient.zero, listCoefficient.zero]
      rfl
    . obtain ⟨j, jNat, equal⟩ := isSucc
      have previous := ih with j, jNat
      rw [equal, listCoefficient.succ, listCoefficient.succ, previous]
      rfl

theorem hornerNeg.entry (cs : List(A)) (k : Nat)
  shows listCoefficient{A}(zero, hornerNeg{A}(neg, cs), k) =
    R[-listCoefficient{A}(zero, cs, k)]
proof
  induction cs generalizing k
  | List.nil =>
    intros k kNat
    have negZero := IsCommRing.neg_zero with ring
    unfold hornerNeg
    rw [listMap, listCoefficient.nil, negZero]
    rfl
  | List.cons(c, tail) using ih =>
    intros k kNat
    have coefficient : c ∈ R by assumption
    have ordinary := IsCommRing.ring with ring
    have head := IsRing.neg_closed with ordinary, coefficient
    have mapped := hornerNeg.data at A, add, zero, neg, mul, one, tail with *
    unfold hornerNeg at mapped
    have mappedList := mapped.left
    have shape := natural.zero_or_successor at k with kNat
    unfold hornerNeg
    rw listMap
    cases shape with isZero | isSucc
    . rw [isZero, listCoefficient.zero, listCoefficient.zero]
      rfl
    . obtain ⟨j, jNat, equal⟩ := isSucc
      have previous := ih with j, jNat
      unfold hornerNeg at previous
      rw [equal, listCoefficient.succ, listCoefficient.succ, previous]
      rfl

-- The full list of a pair has the leading entry at the length and the
-- lower entries below it.
theorem hornerFullList.coefficient_top (leading : Set) (cs : List(A))
  requires initial : leading ∈ R
  shows listCoefficient{A}(zero, hornerFullList{A}(leading, cs),
    length{A}(cs)) = leading
proof
  have top := hornerCoefficient.leading at A, zero, leading, cs with *
  unfold hornerCoefficient at top
  exact top

theorem hornerFullList.coefficient_below (leading : Set) (cs : List(A))
    (k : Nat)
  requires bound : k < length{A}(cs)
  shows listCoefficient{A}(zero, hornerFullList{A}(leading, cs), k) =
    listCoefficient{A}(zero, cs, k)
proof
  have below := hornerCoefficient.below at A, zero, leading, cs, k with *
  unfold hornerCoefficient at below
  exact below

-- A list of length succ(m) is the full list of its first m entries and
-- its entry at m.
theorem List.eq_full_of_length (xs : List(A)) (m : Nat)
  requires size : length{A}(xs) = succ(m)
  shows xs = hornerFullList{A}(listCoefficient{A}(zero, xs, m),
    listTake{A}(m, xs))
proof
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have mLe : m ≤ length{A}(xs)
    rw size
    exact Grace.Core.Nat.Order.LessEqual.successor at m
  have takeList := listTake.closed at A, xs, m with *
  have takeLength := listTake.length at A, xs, m with *
  have topIn := listCoefficient.closed at A, zero, xs, m with *
  have fullList := hornerFullList.list at A, listCoefficient{A}(zero, xs, m),
    listTake{A}(m, xs) with *
  have fullLength := hornerFullList.length at A,
    listCoefficient{A}(zero, xs, m), listTake{A}(m, xs)
  have sameLength : length{A}(xs) =
      length{A}(hornerFullList{A}(listCoefficient{A}(zero, xs, m),
        listTake{A}(m, xs)))
    rw [fullLength, takeLength, size]
    rfl
  have entries : ∀ n < length{A}(xs), listCoefficient{A}(zero, xs, n) =
      listCoefficient{A}(zero, hornerFullList{A}(listCoefficient{A}(zero, xs,
        m), listTake{A}(m, xs)), n)
    intros n nNat bound
    rw size at bound
    have inSucc := membership.of_Less with bound
    have split := membership.successor.forward with inSucc
    cases split with below | top
    . have belowLess := Less.of_membership with below
      have takeCoefficient := listTake.coefficient at A, zero, xs, m, n with *
      have belowTake : n < length{A}(listTake{A}(m, xs))
        rw takeLength
        exact belowLess
      have fullBelow := hornerFullList.coefficient_below at A, add, zero, neg,
        mul, one, listCoefficient{A}(zero, xs, m), listTake{A}(m, xs), n with *
      rw [fullBelow, takeCoefficient]
      rfl
    . have fullTop := hornerFullList.coefficient_top at A, add, zero, neg,
        mul, one, listCoefficient{A}(zero, xs, m), listTake{A}(m, xs) with *
      rw takeLength at fullTop
      rw [top, fullTop]
      rfl
  exact listCoefficient.ext at A, zero, xs, hornerFullList{A}(
    listCoefficient{A}(zero, xs, m), listTake{A}(m, xs)) with *

theorem hornerAt.replicate_zero (x : Set) (m : Nat)
  requires element : x ∈ R
  shows hornerAt{A}(add, mul, zero, x, listReplicate(m, zero)) = R[0]
proof
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  induction m
  | zero =>
    rw [listReplicate.zero, hornerAt.nil]
    rfl
  | succ(k) using ih =>
    have ordinary := IsCommRing.ring with ring
    have zeroIn := IsRing.zero_in_carrier with ordinary
    have rest := listReplicate.closed at A, zero, k with *
    rw [listReplicate.succ, hornerAt.cons, ih]
    ring

theorem hornerPoly.cons (a c : Set) (cs : List(A))
  requires initial : a ∈ R
  requires coefficient : c ∈ R
  shows hornerPoly{A}(add, zero, neg, mul, one, a, c :: cs) =
    P[polynomialConstant(oneVariable, R, c) +
      polynomialVariable(oneVariable, R, (0:N)) *
        hornerPoly{A}(add, zero, neg, mul, one, a, cs)]
proof
  unfold hornerPoly
  exact polynomialFromHorner.cons with *

theorem hornerPoly.zero_nil
  shows hornerPoly{A}(add, zero, neg, mul, one, zero, []) = P[0]
proof
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  rw hornerPoly.constant
  exact polynomialConstant.zero at oneVariable, A, zero with *

theorem hornerPoly.replicate_zero (m : Nat)
  shows hornerPoly{A}(add, zero, neg, mul, one, zero, listReplicate(m, zero)) =
    P[0]
proof
  induction m
  | zero =>
    rw listReplicate.zero
    exact hornerPoly.zero_nil with *
  | succ(k) using ih =>
    have ordinary := IsCommRing.ring with ring
    have zeroIn := IsRing.zero_in_carrier with ordinary
    have oneIn : R[1] ∈ R by typecheck
    have target := polynomials.comm_ring at oneVariable, A, add, zero, neg,
      mul, one with *
    have rest := listReplicate.closed at A, zero, k with *
    have variable := polynomialVariable.member at oneVariable, A, zero, one,
      (0:N) with *
    have constant := polynomialConstant.member at oneVariable, A, zero, zero
      with *
    have zeroConstant := polynomialConstant.zero at oneVariable, A, zero with *
    rw [listReplicate.succ, hornerPoly.cons, ih, zeroConstant]
    ring

-- Trailing zeros do not change the polynomial of a list read with leading
-- zero.
theorem hornerPoly.pad (xs : List(A)) (k : Nat)
  shows hornerPoly{A}(add, zero, neg, mul, one, zero,
      append{A}(listReplicate(k, zero), xs)) =
    hornerPoly{A}(add, zero, neg, mul, one, zero, xs)
proof
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have zeros := listReplicate.closed at A, zero, k with *
  induction xs
  | List.nil =>
    have ordinary := IsCommRing.ring with ring
    have zeroIn := IsRing.zero_in_carrier with ordinary
    have zeros := listReplicate.closed at A, zero, k with *
    rw [append.nil, hornerPoly.replicate_zero, hornerPoly.zero_nil]
    rfl
  | List.cons(c, tail) using ih =>
    have coefficient : c ∈ R by assumption
    have ordinary := IsCommRing.ring with ring
    have zeroIn := IsRing.zero_in_carrier with ordinary
    have zeros := listReplicate.closed at A, zero, k with *
    have appended := append.cons at A, c, tail, listReplicate(k, zero) with *
    have appendedList : List(A, append{A}(listReplicate(k, zero), tail))
      typecheck
    rw [appended, hornerPoly.cons, hornerPoly.cons, ih]
    rfl

end Lists

section Fields
variable (A add zero neg mul one b : Set)
notation ring R := (A, add, zero, neg, mul, one)
notation ring P := R[oneVariable]
hypothesis field : IsField(R)
hypothesis divisorLeading : b ∈ R
hypothesis divisorNonzero : b ≠ R[0]

theorem hornerDivision.inverse
  shows fieldInverseValue(A, add, zero, neg, mul, one, b) ∈ R ∧
    R[fieldInverseValue(A, add, zero, neg, mul, one, b) * b] = R[1]
proof
  have selected := fieldInverseValue.selected at A, add, zero, neg, mul, one, b
    with *
  constructor
  . exact selected.left
  . have alternatives := selected.right
    cases alternatives with vanishes | inverse
    . exfalso
      exact divisorNonzero with vanishes.left
    . obtain ⟨bIn, inverseIn, leftInverse, rightInverse⟩ := inverse.right
      exact leftInverse

theorem hornerDivStep.quotient (ds qs rs : List(A)) (c : Set)
  shows fst(hornerDivStep{A}(add, zero, neg, mul, one, b, ds, qs, rs, c)) =
    R[listCoefficient{A}(zero, c :: rs, length{A}(ds)) *
      fieldInverseValue(A, add, zero, neg, mul, one, b)] :: qs
proof
  unfold hornerDivStep
  rw fst.pair
  rfl

theorem hornerDivStep.remainder (ds qs rs : List(A)) (c : Set)
  shows snd(hornerDivStep{A}(add, zero, neg, mul, one, b, ds, qs, rs, c)) =
    listTake{A}(length{A}(ds), hornerSub{A}(add, zero, neg, c :: rs,
      hornerScale{A}(mul,
        R[listCoefficient{A}(zero, c :: rs, length{A}(ds)) *
          fieldInverseValue(A, add, zero, neg, mul, one, b)],
        hornerFullList{A}(b, ds))))
proof
  unfold hornerDivStep
  rw snd.pair
  rfl

-- The top entry of the candidate after subtracting t·d vanishes.
theorem hornerDivStep.top (ds rs : List(A)) (c : Set)
  requires coefficient : c ∈ R
  requires short : length{A}(rs) = length{A}(ds)
  shows listCoefficient{A}(zero, hornerSub{A}(add, zero, neg, c :: rs,
      hornerScale{A}(mul,
        R[listCoefficient{A}(zero, c :: rs, length{A}(ds)) *
          fieldInverseValue(A, add, zero, neg, mul, one, b)],
        hornerFullList{A}(b, ds))), length{A}(ds)) = R[0]
proof
  have ring := IsField.comm_ring with field
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have inverse := hornerDivision.inverse at A, add, zero, neg, mul, one, b
    with *
  have inverseIn := inverse.left
  have topIn := listCoefficient.closed at A, zero, c :: rs, length{A}(ds)
    with *
  have scalar := IsRing.mul_closed with ordinary, topIn, inverseIn
  have full := hornerFullList.list at A, b, ds with *
  have scaled := hornerScale.data at A, add, zero, neg, mul, one,
    R[listCoefficient{A}(zero, c :: rs, length{A}(ds)) *
      fieldInverseValue(A, add, zero, neg, mul, one, b)],
    hornerFullList{A}(b, ds) with *
  have scaledList := scaled.left
  have negatedData := hornerNeg.data at A, add, zero, neg, mul, one,
    hornerScale{A}(mul,
      R[listCoefficient{A}(zero, c :: rs, length{A}(ds)) *
        fieldInverseValue(A, add, zero, neg, mul, one, b)],
      hornerFullList{A}(b, ds)) with *
  have negatedList := negatedData.left
  have bound : length{A}(ds) < length{A}(c :: rs)
    rw [length.cons, short]
    arith
  have added := hornerAdd.coefficient at A, add, zero, neg, mul, one, c :: rs,
    hornerNeg{A}(neg, hornerScale{A}(mul,
      R[listCoefficient{A}(zero, c :: rs, length{A}(ds)) *
        fieldInverseValue(A, add, zero, neg, mul, one, b)],
      hornerFullList{A}(b, ds))), length{A}(ds) with *
  have negated := hornerNeg.entry at A, add, zero, neg, mul, one,
    hornerScale{A}(mul,
      R[listCoefficient{A}(zero, c :: rs, length{A}(ds)) *
        fieldInverseValue(A, add, zero, neg, mul, one, b)],
      hornerFullList{A}(b, ds)), length{A}(ds) with *
  have scaledValue := hornerScale.coefficient at A, add, zero, neg, mul, one,
    R[listCoefficient{A}(zero, c :: rs, length{A}(ds)) *
      fieldInverseValue(A, add, zero, neg, mul, one, b)],
    hornerFullList{A}(b, ds), length{A}(ds) with *
  have top := hornerFullList.coefficient_top at A, add, zero, neg, mul, one, b,
    ds with *
  unfold hornerSub
  rw [added, negated, scaledValue, top]
  have unit := inverse.right
  linear_combination -(listCoefficient{A}(zero, c :: rs, length{A}(ds))) *
    unit

theorem hornerDivStep.data (ds qs rs : List(A)) (c : Set)
  requires coefficient : c ∈ R
  requires short : length{A}(rs) = length{A}(ds)
  shows List(A, fst(hornerDivStep{A}(add, zero, neg, mul, one, b, ds, qs, rs,
      c))) ∧
    length{A}(fst(hornerDivStep{A}(add, zero, neg, mul, one, b, ds, qs, rs,
        c))) = succ(length{A}(qs)) ∧
    List(A, snd(hornerDivStep{A}(add, zero, neg, mul, one, b, ds, qs, rs, c))) ∧
    length{A}(snd(hornerDivStep{A}(add, zero, neg, mul, one, b, ds, qs, rs,
        c))) = length{A}(ds)
proof
  have ring := IsField.comm_ring with field
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have inverse := hornerDivision.inverse at A, add, zero, neg, mul, one, b
    with *
  have inverseIn := inverse.left
  have topIn := listCoefficient.closed at A, zero, c :: rs, length{A}(ds)
    with *
  have scalar := IsRing.mul_closed with ordinary, topIn, inverseIn
  have full := hornerFullList.list at A, b, ds with *
  have scaled := hornerScale.data at A, add, zero, neg, mul, one,
    R[listCoefficient{A}(zero, c :: rs, length{A}(ds)) *
      fieldInverseValue(A, add, zero, neg, mul, one, b)],
    hornerFullList{A}(b, ds) with *
  have scaledList := scaled.left
  have subtracted := hornerSub.data at A, add, zero, neg, mul, one, c :: rs,
    hornerScale{A}(mul,
      R[listCoefficient{A}(zero, c :: rs, length{A}(ds)) *
        fieldInverseValue(A, add, zero, neg, mul, one, b)],
      hornerFullList{A}(b, ds)) with *
  have subtractedList := subtracted.left
  have subtractedLength : length{A}(hornerSub{A}(add, zero, neg, c :: rs,
      hornerScale{A}(mul,
      R[listCoefficient{A}(zero, c :: rs, length{A}(ds)) *
        fieldInverseValue(A, add, zero, neg, mul, one, b)],
      hornerFullList{A}(b, ds)))) = succ(length{A}(ds))
    rw [subtracted.right, length.cons, short]
    rfl
  have bound : length{A}(ds) ≤ length{A}(hornerSub{A}(add, zero, neg, c :: rs,
      hornerScale{A}(mul,
      R[listCoefficient{A}(zero, c :: rs, length{A}(ds)) *
        fieldInverseValue(A, add, zero, neg, mul, one, b)],
      hornerFullList{A}(b, ds))))
    rw subtractedLength
    exact Grace.Core.Nat.Order.LessEqual.successor at length{A}(ds)
  have takeList := listTake.closed at A, hornerSub{A}(add, zero, neg, c :: rs,
      hornerScale{A}(mul,
      R[listCoefficient{A}(zero, c :: rs, length{A}(ds)) *
        fieldInverseValue(A, add, zero, neg, mul, one, b)],
      hornerFullList{A}(b, ds))), length{A}(ds) with *
  have takeLength := listTake.length at A, hornerSub{A}(add, zero, neg,
      c :: rs, hornerScale{A}(mul,
      R[listCoefficient{A}(zero, c :: rs, length{A}(ds)) *
        fieldInverseValue(A, add, zero, neg, mul, one, b)],
      hornerFullList{A}(b, ds))), length{A}(ds) with *
  rw [hornerDivStep.quotient, hornerDivStep.remainder]
  refine ⟨?_, ?_, takeList, takeLength⟩
  . typecheck
  . rw length.cons
    rfl

-- The value of the new remainder: the candidate minus t·d.
theorem hornerDivStep.remainder_value (x : Set) (ds rs : List(A)) (c : Set)
  requires element : x ∈ R
  requires coefficient : c ∈ R
  requires short : length{A}(rs) = length{A}(ds)
  shows hornerAt{A}(add, mul, zero, x, listTake{A}(length{A}(ds),
      hornerSub{A}(add, zero, neg, c :: rs, hornerScale{A}(mul,
      R[listCoefficient{A}(zero, c :: rs, length{A}(ds)) *
        fieldInverseValue(A, add, zero, neg, mul, one, b)],
      hornerFullList{A}(b, ds))))) =
    R[(c + x * hornerAt{A}(add, mul, zero, x, rs)) -
      R[listCoefficient{A}(zero, c :: rs, length{A}(ds)) *
      fieldInverseValue(A, add, zero, neg, mul, one, b)] * hornerAt{A}(add,
          mul, b, x, ds)]
proof
  have ring := IsField.comm_ring with field
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have inverse := hornerDivision.inverse at A, add, zero, neg, mul, one, b
    with *
  have inverseIn := inverse.left
  have topIn := listCoefficient.closed at A, zero, c :: rs, length{A}(ds)
    with *
  have scalar := IsRing.mul_closed with ordinary, topIn, inverseIn
  have full := hornerFullList.list at A, b, ds with *
  have scaled := hornerScale.data at A, add, zero, neg, mul, one,
    R[listCoefficient{A}(zero, c :: rs, length{A}(ds)) *
      fieldInverseValue(A, add, zero, neg, mul, one, b)],
    hornerFullList{A}(b, ds) with *
  have scaledList := scaled.left
  have subtracted := hornerSub.data at A, add, zero, neg, mul, one, c :: rs,
    hornerScale{A}(mul,
      R[listCoefficient{A}(zero, c :: rs, length{A}(ds)) *
        fieldInverseValue(A, add, zero, neg, mul, one, b)],
      hornerFullList{A}(b, ds)) with *
  have subtractedList := subtracted.left
  have subtractedLength : length{A}(hornerSub{A}(add, zero, neg, c :: rs,
      hornerScale{A}(mul,
      R[listCoefficient{A}(zero, c :: rs, length{A}(ds)) *
        fieldInverseValue(A, add, zero, neg, mul, one, b)],
      hornerFullList{A}(b, ds)))) = succ(length{A}(ds))
    rw [subtracted.right, length.cons, short]
    rfl
  have decomposition := List.eq_full_of_length at A, add, zero, neg, mul, one,
    hornerSub{A}(add, zero, neg, c :: rs, hornerScale{A}(mul,
      R[listCoefficient{A}(zero, c :: rs, length{A}(ds)) *
        fieldInverseValue(A, add, zero, neg, mul, one, b)],
      hornerFullList{A}(b, ds))), length{A}(ds) with *
  have top := hornerDivStep.top at A, add, zero, neg, mul, one, b, ds, rs, c
    with *
  rw top at decomposition
  have bound : length{A}(ds) ≤ length{A}(hornerSub{A}(add, zero, neg, c :: rs,
      hornerScale{A}(mul,
      R[listCoefficient{A}(zero, c :: rs, length{A}(ds)) *
        fieldInverseValue(A, add, zero, neg, mul, one, b)],
      hornerFullList{A}(b, ds))))
    rw subtractedLength
    exact Grace.Core.Nat.Order.LessEqual.successor at length{A}(ds)
  have takeList := listTake.closed at A, hornerSub{A}(add, zero, neg, c :: rs,
      hornerScale{A}(mul,
      R[listCoefficient{A}(zero, c :: rs, length{A}(ds)) *
        fieldInverseValue(A, add, zero, neg, mul, one, b)],
      hornerFullList{A}(b, ds))), length{A}(ds) with *
  have fullValue := hornerFullList.value at A, add, zero, neg, mul, one, R[0],
      x,
    listTake{A}(length{A}(ds), hornerSub{A}(add, zero, neg, c :: rs,
        hornerScale{A}(mul,
      R[listCoefficient{A}(zero, c :: rs, length{A}(ds)) *
        fieldInverseValue(A, add, zero, neg, mul, one, b)],
      hornerFullList{A}(b, ds)))) with *
  have sameLength : length{A}(c :: rs) = length{A}(hornerScale{A}(mul,
      R[listCoefficient{A}(zero, c :: rs, length{A}(ds)) *
        fieldInverseValue(A, add, zero, neg, mul, one, b)],
      hornerFullList{A}(b, ds)))
    rw [scaled.right, hornerFullList.length, length.cons, short]
    rfl
  have subValue := hornerSub.value at A, add, zero, neg, mul, one, R[0], R[0],
      x,
    c :: rs, hornerScale{A}(mul,
      R[listCoefficient{A}(zero, c :: rs, length{A}(ds)) *
        fieldInverseValue(A, add, zero, neg, mul, one, b)],
      hornerFullList{A}(b, ds)) with *
  have scaleValue := hornerScale.value at A, add, zero, neg, mul, one,
    R[listCoefficient{A}(zero, c :: rs, length{A}(ds)) *
      fieldInverseValue(A, add, zero, neg, mul, one, b)], R[0], x,
    hornerFullList{A}(b, ds) with *
  have fullB := hornerFullList.value at A, add, zero, neg, mul, one, b, x, ds
    with *
  have zeroSub : R[0 - 0] = R[0] by ring
  have zeroScale : R[R[listCoefficient{A}(zero, c :: rs, length{A}(ds)) *
      fieldInverseValue(A, add, zero, neg, mul, one, b)] * 0] = R[0] by ring
  rw zeroSub at subValue
  rw zeroScale at scaleValue
  have consValue := hornerAt.cons at A, add, mul, zero, x, c, rs with *
  rw [← fullValue, ← decomposition, subValue, scaleValue, fullB, consValue]
  rfl

-- One step keeps p = q·d + r: the new pair represents c + X·(q·d + r).
theorem hornerDivStep.value (x : Set) (ds qs rs : List(A)) (c : Set)
  requires element : x ∈ R
  requires coefficient : c ∈ R
  requires short : length{A}(rs) = length{A}(ds)
  shows R[hornerAt{A}(add, mul, zero, x, fst(hornerDivStep{A}(add, zero, neg,
      mul, one, b, ds, qs, rs, c))) *
      hornerAt{A}(add, mul, b, x, ds) +
      hornerAt{A}(add, mul, zero, x, snd(hornerDivStep{A}(add, zero, neg, mul,
          one, b, ds, qs, rs, c)))] =
    R[c + x * (hornerAt{A}(add, mul, zero, x, qs) *
      hornerAt{A}(add, mul, b, x, ds) + hornerAt{A}(add, mul, zero, x, rs))]
proof
  have ring := IsField.comm_ring with field
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have inverse := hornerDivision.inverse at A, add, zero, neg, mul, one, b
    with *
  have inverseIn := inverse.left
  have topIn := listCoefficient.closed at A, zero, c :: rs, length{A}(ds)
    with *
  have scalar := IsRing.mul_closed with ordinary, topIn, inverseIn
  have remainderValue := hornerDivStep.remainder_value at A, add, zero, neg,
    mul, one, b, x, ds, rs, c with *
  have quotientValue := hornerAt.cons at A, add, mul, zero, x,
    R[listCoefficient{A}(zero, c :: rs, length{A}(ds)) *
      fieldInverseValue(A, add, zero, neg, mul, one, b)], qs with *
  have qValue := hornerAt.closed at A, add, zero, neg, mul, one, R[0], x, qs
    with *
  have dValue := hornerAt.closed at A, add, zero, neg, mul, one, b, x, ds with *
  have rValue := hornerAt.closed at A, add, zero, neg, mul, one, R[0], x, rs
    with *
  rw [hornerDivStep.quotient, hornerDivStep.remainder, quotientValue,
    remainderValue]
  ring

theorem hornerDivPair.data (a : Set) (ds cs : List(A))
  requires initial : a ∈ R
  shows List(A, fst(hornerDivPair{A}(add, zero, neg, mul, one, b, a, ds, cs))) ∧
    length{A}(fst(hornerDivPair{A}(add, zero, neg, mul, one, b, a, ds, cs))) =
      succ(length{A}(cs)) ∧
    List(A, snd(hornerDivPair{A}(add, zero, neg, mul, one, b, a, ds, cs))) ∧
    length{A}(snd(hornerDivPair{A}(add, zero, neg, mul, one, b, a, ds,
        cs))) = length{A}(ds)
proof
  induction cs
  | List.nil =>
    have ring := IsField.comm_ring with field
    have ordinary := IsCommRing.ring with ring
    have zeroIn := IsRing.zero_in_carrier with ordinary
    have zeros := listReplicate.closed at A, zero, length{A}(ds) with *
    have zerosLength := listReplicate.length at A, zero, length{A}(ds) with *
    have empty : List(A, []) by typecheck
    have step := hornerDivStep.data at A, add, zero, neg, mul, one, b, ds, [],
      listReplicate(length{A}(ds), zero), a with *
    rw hornerDivPair
    exact step
  | List.cons(c, tail) using ih =>
    have coefficient : c ∈ R by assumption
    obtain ⟨quotientList, quotientLength, remainderList, remainderLength⟩ := ih
    have step := hornerDivStep.data at A, add, zero, neg, mul, one, b, ds,
      fst(hornerDivPair{A}(add, zero, neg, mul, one, b, a, ds, tail)),
      snd(hornerDivPair{A}(add, zero, neg, mul, one, b, a, ds, tail)), c with *
    obtain ⟨qList, qLength, rList, rLength⟩ := step
    rw hornerDivPair
    refine ⟨qList, ?_, rList, rLength⟩
    rw [qLength, quotientLength, length.cons]
    rfl

theorem hornerDivPair.value (a x : Set) (ds cs : List(A))
  requires initial : a ∈ R
  requires element : x ∈ R
  shows R[hornerAt{A}(add, mul, zero, x, fst(hornerDivPair{A}(add, zero, neg,
      mul, one, b, a, ds, cs))) *
      hornerAt{A}(add, mul, b, x, ds) +
      hornerAt{A}(add, mul, zero, x, snd(hornerDivPair{A}(add, zero, neg, mul,
          one, b, a, ds, cs)))] =
    hornerAt{A}(add, mul, a, x, cs)
proof
  induction cs
  | List.nil =>
    have ring := IsField.comm_ring with field
    have ordinary := IsCommRing.ring with ring
    have zeroIn := IsRing.zero_in_carrier with ordinary
    have zeros := listReplicate.closed at A, zero, length{A}(ds) with *
    have zerosLength := listReplicate.length at A, zero, length{A}(ds) with *
    have empty : List(A, []) by typecheck
    have step := hornerDivStep.value at A, add, zero, neg, mul, one, b, x, ds,
      [], listReplicate(length{A}(ds), zero), a with *
    have zerosValue := hornerAt.replicate_zero at A, add, zero, neg, mul, one,
      x, length{A}(ds) with *
    have emptyValue := hornerAt.nil at A, add, mul, R[0], x
    have dValue := hornerAt.closed at A, add, zero, neg, mul, one, b, x, ds
      with *
    rw [hornerDivPair, step, zerosValue, emptyValue, hornerAt.nil]
    ring
  | List.cons(c, tail) using ih =>
    have coefficient : c ∈ R by assumption
    have data := hornerDivPair.data at A, add, zero, neg, mul, one, b, a, ds,
      tail with *
    obtain ⟨quotientList, quotientLength, remainderList, remainderLength⟩ :=
      data
    have step := hornerDivStep.value at A, add, zero, neg, mul, one, b, x, ds,
      fst(hornerDivPair{A}(add, zero, neg, mul, one, b, a, ds, tail)),
      snd(hornerDivPair{A}(add, zero, neg, mul, one, b, a, ds, tail)), c with *
    rw [hornerDivPair, step, ih, hornerAt.cons]
    rfl

-- The polynomial of the new remainder: the candidate minus t·d.
theorem hornerDivStep.remainder_poly (ds rs : List(A)) (c : Set)
  requires coefficient : c ∈ R
  requires short : length{A}(rs) = length{A}(ds)
  shows hornerPoly{A}(add, zero, neg, mul, one, zero,
      listTake{A}(length{A}(ds), hornerSub{A}(add, zero, neg, c :: rs,
        hornerScale{A}(mul,
      R[listCoefficient{A}(zero, c :: rs, length{A}(ds)) *
        fieldInverseValue(A, add, zero, neg, mul, one, b)],
      hornerFullList{A}(b, ds))))) =
    P[(polynomialConstant(oneVariable, R, c) +
        polynomialVariable(oneVariable, R, (0:N)) *
          hornerPoly{A}(add, zero, neg, mul, one, zero, rs)) -
      polynomialConstant(oneVariable, R,
        R[listCoefficient{A}(zero, c :: rs, length{A}(ds)) *
      fieldInverseValue(A, add, zero, neg, mul, one, b)]) *
        hornerPoly{A}(add, zero, neg, mul, one, b, ds)]
proof
  have ring := IsField.comm_ring with field
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have inverse := hornerDivision.inverse at A, add, zero, neg, mul, one, b
    with *
  have inverseIn := inverse.left
  have topIn := listCoefficient.closed at A, zero, c :: rs, length{A}(ds)
    with *
  have scalar := IsRing.mul_closed with ordinary, topIn, inverseIn
  have full := hornerFullList.list at A, b, ds with *
  have scaled := hornerScale.data at A, add, zero, neg, mul, one,
    R[listCoefficient{A}(zero, c :: rs, length{A}(ds)) *
      fieldInverseValue(A, add, zero, neg, mul, one, b)],
    hornerFullList{A}(b, ds) with *
  have scaledList := scaled.left
  have subtracted := hornerSub.data at A, add, zero, neg, mul, one, c :: rs,
    hornerScale{A}(mul,
      R[listCoefficient{A}(zero, c :: rs, length{A}(ds)) *
        fieldInverseValue(A, add, zero, neg, mul, one, b)],
      hornerFullList{A}(b, ds)) with *
  have subtractedList := subtracted.left
  have subtractedLength : length{A}(hornerSub{A}(add, zero, neg, c :: rs,
      hornerScale{A}(mul,
      R[listCoefficient{A}(zero, c :: rs, length{A}(ds)) *
        fieldInverseValue(A, add, zero, neg, mul, one, b)],
      hornerFullList{A}(b, ds)))) = succ(length{A}(ds))
    rw [subtracted.right, length.cons, short]
    rfl
  have oneIn : R[1] ∈ R by typecheck
  have target := polynomials.comm_ring at oneVariable, A, add, zero, neg, mul,
    one with *
  have decomposition := List.eq_full_of_length at A, add, zero, neg, mul, one,
    hornerSub{A}(add, zero, neg, c :: rs, hornerScale{A}(mul,
      R[listCoefficient{A}(zero, c :: rs, length{A}(ds)) *
        fieldInverseValue(A, add, zero, neg, mul, one, b)],
      hornerFullList{A}(b, ds))), length{A}(ds) with *
  have top := hornerDivStep.top at A, add, zero, neg, mul, one, b, ds, rs, c
    with *
  rw top at decomposition
  have bound : length{A}(ds) ≤ length{A}(hornerSub{A}(add, zero, neg, c :: rs,
      hornerScale{A}(mul,
      R[listCoefficient{A}(zero, c :: rs, length{A}(ds)) *
        fieldInverseValue(A, add, zero, neg, mul, one, b)],
      hornerFullList{A}(b, ds))))
    rw subtractedLength
    exact Grace.Core.Nat.Order.LessEqual.successor at length{A}(ds)
  have takeList := listTake.closed at A, hornerSub{A}(add, zero, neg, c :: rs,
      hornerScale{A}(mul,
      R[listCoefficient{A}(zero, c :: rs, length{A}(ds)) *
        fieldInverseValue(A, add, zero, neg, mul, one, b)],
      hornerFullList{A}(b, ds))), length{A}(ds) with *
  have fullPoly := hornerPoly.full_list at A, add, zero, neg, mul, one, R[0],
    listTake{A}(length{A}(ds), hornerSub{A}(add, zero, neg, c :: rs,
      hornerScale{A}(mul,
      R[listCoefficient{A}(zero, c :: rs, length{A}(ds)) *
        fieldInverseValue(A, add, zero, neg, mul, one, b)],
      hornerFullList{A}(b, ds)))) with *
  have negatedData := hornerNeg.data at A, add, zero, neg, mul, one,
    hornerScale{A}(mul,
      R[listCoefficient{A}(zero, c :: rs, length{A}(ds)) *
        fieldInverseValue(A, add, zero, neg, mul, one, b)],
      hornerFullList{A}(b, ds)) with *
  have negatedList := negatedData.left
  have sameLength : length{A}(c :: rs) = length{A}(hornerNeg{A}(neg,
      hornerScale{A}(mul,
      R[listCoefficient{A}(zero, c :: rs, length{A}(ds)) *
        fieldInverseValue(A, add, zero, neg, mul, one, b)],
      hornerFullList{A}(b, ds))))
    rw [negatedData.right, scaled.right, hornerFullList.length, length.cons,
      short]
    rfl
  have addPoly := hornerPoly.add at A, add, zero, neg, mul, one, R[0], R[0],
    c :: rs, hornerNeg{A}(neg, hornerScale{A}(mul,
      R[listCoefficient{A}(zero, c :: rs, length{A}(ds)) *
        fieldInverseValue(A, add, zero, neg, mul, one, b)],
      hornerFullList{A}(b, ds))) with *
  have negPoly := hornerPoly.neg at A, add, zero, neg, mul, one, R[0],
    hornerScale{A}(mul,
      R[listCoefficient{A}(zero, c :: rs, length{A}(ds)) *
        fieldInverseValue(A, add, zero, neg, mul, one, b)],
      hornerFullList{A}(b, ds)) with *
  have scalePoly := hornerPoly.scale at A, add, zero, neg, mul, one,
    R[listCoefficient{A}(zero, c :: rs, length{A}(ds)) *
      fieldInverseValue(A, add, zero, neg, mul, one, b)], R[0],
    hornerFullList{A}(b, ds) with *
  have fullB := hornerPoly.full_list at A, add, zero, neg, mul, one, b, ds
    with *
  have consPoly := hornerPoly.cons at A, add, zero, neg, mul, one, R[0], c, rs
    with *
  have zeroAdd : R[0 + 0] = R[0] by ring
  have negZero := IsCommRing.neg_zero with ring
  have zeroScale : R[R[listCoefficient{A}(zero, c :: rs, length{A}(ds)) *
      fieldInverseValue(A, add, zero, neg, mul, one, b)] * 0] = R[0] by ring
  rw zeroAdd at addPoly
  rw negZero at negPoly
  rw zeroScale at scalePoly
  have constantC := polynomialConstant.member at oneVariable, A, zero, c with *
  have constantT := polynomialConstant.member at oneVariable, A, zero,
    R[listCoefficient{A}(zero, c :: rs, length{A}(ds)) *
      fieldInverseValue(A, add, zero, neg, mul, one, b)] with *
  have variable := polynomialVariable.member at oneVariable, A, zero, one,
    (0:N) with *
  have restPoly := hornerPoly.member at A, add, zero, neg, mul, one, R[0], rs
    with *
  have divisorPoly := hornerPoly.member at A, add, zero, neg, mul, one, b, ds
    with *
  rw [← fullPoly, ← decomposition]
  unfold hornerSub
  rw [addPoly, negPoly, scalePoly, fullB, consPoly]
  ring

theorem hornerDivStep.poly (ds qs rs : List(A)) (c : Set)
  requires coefficient : c ∈ R
  requires short : length{A}(rs) = length{A}(ds)
  shows P[hornerPoly{A}(add, zero, neg, mul, one, zero,
      fst(hornerDivStep{A}(add, zero, neg, mul, one, b, ds, qs, rs, c))) *
      hornerPoly{A}(add, zero, neg, mul, one, b, ds) +
      hornerPoly{A}(add, zero, neg, mul, one, zero, snd(hornerDivStep{A}(add,
          zero, neg, mul, one, b, ds, qs, rs, c)))] =
    P[polynomialConstant(oneVariable, R, c) +
      polynomialVariable(oneVariable, R, (0:N)) *
        (hornerPoly{A}(add, zero, neg, mul, one, zero, qs) *
          hornerPoly{A}(add, zero, neg, mul, one, b, ds) +
          hornerPoly{A}(add, zero, neg, mul, one, zero, rs))]
proof
  have ring := IsField.comm_ring with field
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have oneIn : R[1] ∈ R by typecheck
  have target := polynomials.comm_ring at oneVariable, A, add, zero, neg, mul,
    one with *
  have inverse := hornerDivision.inverse at A, add, zero, neg, mul, one, b
    with *
  have inverseIn := inverse.left
  have topIn := listCoefficient.closed at A, zero, c :: rs, length{A}(ds)
    with *
  have scalar := IsRing.mul_closed with ordinary, topIn, inverseIn
  have remainderPoly := hornerDivStep.remainder_poly at A, add, zero, neg,
    mul, one, b, ds, rs, c with *
  have quotientPoly := hornerPoly.cons at A, add, zero, neg, mul, one, R[0],
    R[listCoefficient{A}(zero, c :: rs, length{A}(ds)) *
      fieldInverseValue(A, add, zero, neg, mul, one, b)], qs with *
  have constantC := polynomialConstant.member at oneVariable, A, zero, c with *
  have constantT := polynomialConstant.member at oneVariable, A, zero,
    R[listCoefficient{A}(zero, c :: rs, length{A}(ds)) *
      fieldInverseValue(A, add, zero, neg, mul, one, b)] with *
  have variable := polynomialVariable.member at oneVariable, A, zero, one,
    (0:N) with *
  have qPoly := hornerPoly.member at A, add, zero, neg, mul, one, R[0], qs
    with *
  have rPoly := hornerPoly.member at A, add, zero, neg, mul, one, R[0], rs
    with *
  have dPoly := hornerPoly.member at A, add, zero, neg, mul, one, b, ds with *
  rw [hornerDivStep.quotient, hornerDivStep.remainder, quotientPoly,
    remainderPoly]
  ring

theorem hornerDivPair.poly (a : Set) (ds cs : List(A))
  requires initial : a ∈ R
  shows P[hornerPoly{A}(add, zero, neg, mul, one, zero,
      fst(hornerDivPair{A}(add, zero, neg, mul, one, b, a, ds, cs))) *
      hornerPoly{A}(add, zero, neg, mul, one, b, ds) +
      hornerPoly{A}(add, zero, neg, mul, one, zero, snd(hornerDivPair{A}(add,
          zero, neg, mul, one, b, a, ds, cs)))] =
    hornerPoly{A}(add, zero, neg, mul, one, a, cs)
proof
  induction cs
  | List.nil =>
    have ring := IsField.comm_ring with field
    have ordinary := IsCommRing.ring with ring
    have zeroIn := IsRing.zero_in_carrier with ordinary
    have oneIn : R[1] ∈ R by typecheck
    have target := polynomials.comm_ring at oneVariable, A, add, zero, neg,
      mul, one with *
    have zeros := listReplicate.closed at A, zero, length{A}(ds) with *
    have zerosLength := listReplicate.length at A, zero, length{A}(ds) with *
    have empty : List(A, []) by typecheck
    have step := hornerDivStep.poly at A, add, zero, neg, mul, one, b, ds, [],
      listReplicate(length{A}(ds), zero), a with *
    have zerosPoly := hornerPoly.replicate_zero at A, add, zero, neg, mul, one,
      length{A}(ds) with *
    have emptyPoly := hornerPoly.zero_nil at A, add, zero, neg, mul, one with *
    have constant := hornerPoly.constant at A, add, zero, neg, mul, one, a
      with *
    have dPoly := hornerPoly.member at A, add, zero, neg, mul, one, b, ds
      with *
    have constantA := polynomialConstant.member at oneVariable, A, zero, a
      with *
    have variable := polynomialVariable.member at oneVariable, A, zero, one,
      (0:N) with *
    rw [hornerDivPair, step, zerosPoly, emptyPoly, constant]
    ring
  | List.cons(c, tail) using ih =>
    have coefficient : c ∈ R by assumption
    have ring := IsField.comm_ring with field
    have data := hornerDivPair.data at A, add, zero, neg, mul, one, b, a, ds,
      tail with *
    obtain ⟨quotientList, quotientLength, remainderList, remainderLength⟩ :=
      data
    have step := hornerDivStep.poly at A, add, zero, neg, mul, one, b, ds,
      fst(hornerDivPair{A}(add, zero, neg, mul, one, b, a, ds, tail)),
      snd(hornerDivPair{A}(add, zero, neg, mul, one, b, a, ds, tail)), c with *
    have consPoly := hornerPoly.cons at A, add, zero, neg, mul, one, a, c, tail
      with *
    rw [hornerDivPair, step, ih, consPoly]
    rfl

theorem hornerDivQuotient.data (a : Set) (ds cs : List(A))
  requires initial : a ∈ R
  shows List(A, hornerDivQuotient{A}(add, zero, neg, mul, one, b, a, ds, cs)) ∧
    length{A}(hornerDivQuotient{A}(add, zero, neg, mul, one, b, a, ds, cs)) =
      succ(length{A}(cs))
proof
  have data := hornerDivPair.data at A, add, zero, neg, mul, one, b, a, ds, cs
    with *
  obtain ⟨quotientList, quotientLength, remainderList, remainderLength⟩ := data
  unfold hornerDivQuotient
  exact ⟨quotientList, quotientLength⟩

theorem hornerDivRemainder.data (a : Set) (ds cs : List(A))
  requires initial : a ∈ R
  shows List(A, hornerDivRemainder{A}(add, zero, neg, mul, one, b, a, ds, cs)) ∧
    length{A}(hornerDivRemainder{A}(add, zero, neg, mul, one, b, a, ds, cs)) =
      length{A}(ds)
proof
  have data := hornerDivPair.data at A, add, zero, neg, mul, one, b, a, ds, cs
    with *
  obtain ⟨quotientList, quotientLength, remainderList, remainderLength⟩ := data
  unfold hornerDivRemainder
  exact ⟨remainderList, remainderLength⟩

-- p(x) = q(x)·d(x) + r(x) at every point.
theorem hornerDivision.value (a x : Set) (ds cs : List(A))
  requires initial : a ∈ R
  requires element : x ∈ R
  shows hornerAt{A}(add, mul, a, x, cs) =
    R[hornerAt{A}(add, mul, zero, x, hornerDivQuotient{A}(add, zero, neg, mul,
      one, b, a, ds, cs)) *
        hornerAt{A}(add, mul, b, x, ds) +
      hornerAt{A}(add, mul, zero, x, hornerDivRemainder{A}(add, zero, neg, mul,
        one, b, a, ds, cs))]
proof
  have value := hornerDivPair.value at A, add, zero, neg, mul, one, b, a, x, ds,
    cs with *
  unfold hornerDivQuotient
  unfold hornerDivRemainder
  symm
  exact value

-- p = q·d + r in the polynomial ring.
theorem hornerDivision.poly (a : Set) (ds cs : List(A))
  requires initial : a ∈ R
  shows hornerPoly{A}(add, zero, neg, mul, one, a, cs) =
    P[hornerPoly{A}(add, zero, neg, mul, one, zero, hornerDivQuotient{A}(add,
      zero, neg, mul, one, b, a, ds, cs)) *
        hornerPoly{A}(add, zero, neg, mul, one, b, ds) +
      hornerPoly{A}(add, zero, neg, mul, one, zero, hornerDivRemainder{A}(add,
        zero, neg, mul, one, b, a, ds, cs))]
proof
  have poly := hornerDivPair.poly at A, add, zero, neg, mul, one, b, a, ds, cs
    with *
  unfold hornerDivQuotient
  unfold hornerDivRemainder
  symm
  exact poly

-- A combination w·d + v with v of degree below d vanishes only trivially:
-- the top coefficient of w·d is the product of the leading coefficients.
theorem hornerDivision.zero_of_combination (ds ws vs : List(A))
  requires short : length{A}(vs) = length{A}(ds)
  requires vanishes : P[hornerPoly{A}(add, zero, neg, mul, one, zero, ws) *
    hornerPoly{A}(add, zero, neg, mul, one, b, ds) +
    hornerPoly{A}(add, zero, neg, mul, one, zero, vs)] = P[0]
  shows hornerPoly{A}(add, zero, neg, mul, one, zero, ws) = P[0] ∧
    hornerPoly{A}(add, zero, neg, mul, one, zero, vs) = P[0]
proof
  have ring := IsField.comm_ring with field
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have oneIn : R[1] ∈ R by typecheck
  have target := polynomials.comm_ring at oneVariable, A, add, zero, neg, mul,
    one with *
  have noZero := IsField.no_zero_divisors with field
  have wsPoly := hornerPoly.member at A, add, zero, neg, mul, one, R[0], ws
    with *
  have vsPoly := hornerPoly.member at A, add, zero, neg, mul, one, R[0], vs
    with *
  have dPoly := hornerPoly.member at A, add, zero, neg, mul, one, b, ds with *
  have alternatives : hornerPoly{A}(add, zero, neg, mul, one, zero, ws) = P[0] ∨
    hornerPoly{A}(add, zero, neg, mul, one, zero, ws) ≠ P[0] by tauto
  cases alternatives with wZero | wNonzero
  . constructor
    . exact wZero
    . rw wZero at vanishes
      linear_combination vanishes
  . exfalso
    have normalPoly := hornerPoly.normal at A, add, zero, neg, mul, one, R[0],
      ws with *
    unfold normalLeading at normalPoly
    unfold normalLower at normalPoly
    have fullList := hornerFullList.list at A, R[0], ws with *
    have normalShape := hornerTrim.normal at A, zero,
      hornerFullList{A}(zero, ws) with *
    have wIn := hornerTrimLeading.mem at A, zero, hornerFullList{A}(zero, ws)
      with *
    have wsList := hornerTrimLower.list at A, zero,
      hornerFullList{A}(zero, ws) with *
    cases normalShape with wLead | trivial
    . have product := hornerPoly.mul at A, add, zero, neg, mul, one,
        hornerTrimLeading{A}(zero, hornerFullList{A}(zero, ws)), b,
        hornerTrimLower{A}(zero, hornerFullList{A}(zero, ws)), ds with *
      have mulData := hornerMulList.data at A, add, zero, neg, mul, one,
          hornerTrimLeading{A}(zero, hornerFullList{A}(zero, ws)),
        b, hornerTrimLower{A}(zero, hornerFullList{A}(zero, ws)), ds with *
      have mulList := mulData.left
      have mulLength := mulData.right
      have wb := IsRing.mul_closed with ordinary, wIn, divisorLeading
      have wbNonzero : R[hornerTrimLeading{A}(zero, hornerFullList{A}(zero,
          ws)) * b] ≠ R[0]
        intro productZero
        have split := noZero with hornerTrimLeading{A}(zero,
            hornerFullList{A}(zero, ws)), wIn, b, divisorLeading, productZero
        cases split with w0 | b0
        . exact wLead with w0
        . exact divisorNonzero with b0
      have negPoly := hornerPoly.neg at A, add, zero, neg, mul, one, R[0], vs
        with *
      have negZero := IsCommRing.neg_zero with ring
      rw negZero at negPoly
      have negData := hornerNeg.data at A, add, zero, neg, mul, one, vs with *
      have negList := negData.left
      have equal : hornerPoly{A}(add, zero, neg, mul, one,
          R[hornerTrimLeading{A}(zero, hornerFullList{A}(zero, ws)) * b],
            hornerMulList{A}(add, zero, mul, hornerTrimLeading{A}(zero,
              hornerFullList{A}(zero, ws)), b, hornerTrimLower{A}(zero,
                hornerFullList{A}(zero, ws)), ds)) =
          hornerPoly{A}(add, zero, neg, mul, one, R[0], hornerNeg{A}(neg, vs))
        rw [product, normalPoly, negPoly]
        linear_combination vanishes
      have iff := hornerPoly.eq_iff at A, add, zero, neg, mul, one,
          R[hornerTrimLeading{A}(zero, hornerFullList{A}(zero, ws)) * b],
        R[0], hornerMulList{A}(add, zero, mul, hornerTrimLeading{A}(zero,
            hornerFullList{A}(zero, ws)), b, hornerTrimLower{A}(zero,
              hornerFullList{A}(zero, ws)), ds), hornerNeg{A}(neg, vs) with *
      have coefficients := iff.forward with equal
      have kNat : Nat(length{A}(hornerMulList{A}(add, zero, mul,
          hornerTrimLeading{A}(zero, hornerFullList{A}(zero, ws)), b,
            hornerTrimLower{A}(zero, hornerFullList{A}(zero, ws)),
              ds))) by typecheck
      have kIn := nat.omega.forward with kNat
      have atTop := coefficients with length{A}(hornerMulList{A}(add, zero,
          mul, hornerTrimLeading{A}(zero, hornerFullList{A}(zero, ws)), b,
            hornerTrimLower{A}(zero, hornerFullList{A}(zero, ws)), ds)), kIn
      have leading := hornerCoefficient.leading at A, zero,
          R[hornerTrimLeading{A}(zero, hornerFullList{A}(zero, ws)) * b],
            hornerMulList{A}(add, zero, mul, hornerTrimLeading{A}(zero,
              hornerFullList{A}(zero, ws)), b, hornerTrimLower{A}(zero,
                hornerFullList{A}(zero, ws)), ds)
        with *
      rw leading at atTop
      have negLength : length{A}(hornerNeg{A}(neg, vs)) = length{A}(ds)
        rw [negData.right, short]
        rfl
      have le : length{A}(hornerNeg{A}(neg,
          vs)) ≤ length{A}(hornerMulList{A}(add, zero, mul,
            hornerTrimLeading{A}(zero, hornerFullList{A}(zero, ws)), b,
              hornerTrimLower{A}(zero, hornerFullList{A}(zero, ws)), ds))
        rw [negLength, mulLength]
        arith
      have inSucc := membership.successor_of_LessEqual with le
      have split := membership.successor.forward with inSucc
      cases split with below | same
      . have belowLess := Less.of_membership with below
        have above := hornerCoefficient.above at A, zero, R[0],
          hornerNeg{A}(neg, vs), length{A}(hornerMulList{A}(add, zero, mul,
            hornerTrimLeading{A}(zero, hornerFullList{A}(zero, ws)), b,
              hornerTrimLower{A}(zero, hornerFullList{A}(zero, ws)), ds)) with *
        rw above at atTop
        exact wbNonzero with atTop
      . have top := hornerCoefficient.leading at A, zero, R[0],
          hornerNeg{A}(neg, vs) with *
        rw [← same, top] at atTop
        exact wbNonzero with atTop
    . apply wNonzero
      rw [← normalPoly, trivial.left, trivial.right]
      exact hornerPoly.zero_nil with *

-- Any quotient and remainder of the divisor's length are the ones above.
theorem hornerDivision.unique (a : Set) (ds cs qs rs : List(A))
  requires initial : a ∈ R
  requires short : length{A}(rs) = length{A}(ds)
  requires equation : hornerPoly{A}(add, zero, neg, mul, one, a, cs) =
    P[hornerPoly{A}(add, zero, neg, mul, one, zero, qs) * hornerPoly{A}(add,
      zero, neg, mul, one, b, ds) +
      hornerPoly{A}(add, zero, neg, mul, one, zero, rs)]
  shows hornerPoly{A}(add, zero, neg, mul, one, zero, qs) =
      hornerPoly{A}(add, zero, neg, mul, one, zero, hornerDivQuotient{A}(add,
        zero, neg, mul, one, b, a, ds, cs)) ∧
    rs = hornerDivRemainder{A}(add, zero, neg, mul, one, b, a, ds, cs)
proof
  have ring := IsField.comm_ring with field
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have oneIn : R[1] ∈ R by typecheck
  have target := polynomials.comm_ring at oneVariable, A, add, zero, neg, mul,
    one with *
  have negZero := IsCommRing.neg_zero with ring
  have zeroAdd : R[0 + 0] = R[0] by ring
  have poly := hornerDivision.poly at A, add, zero, neg, mul, one, b, a, ds, cs
    with *
  have qData := hornerDivQuotient.data at A, add, zero, neg, mul, one, b, a,
    ds, cs with *
  have qList := qData.left
  have rData := hornerDivRemainder.data at A, add, zero, neg, mul, one, b, a,
    ds, cs with *
  have rList := rData.left
  set quotient := hornerDivQuotient{A}(add, zero, neg, mul, one, b, a, ds,
      cs) with quotientDef
  set remainder := hornerDivRemainder{A}(add, zero, neg, mul, one, b, a, ds,
      cs) with remainderDef
  rw ← quotientDef at qData
  rw ← quotientDef at qList
  rw ← quotientDef at poly
  rw ← remainderDef at rData
  rw ← remainderDef at rList
  rw ← remainderDef at poly
  have zerosQ := listReplicate.closed at A, zero, length{A}(quotient) with *
  have zerosQs := listReplicate.closed at A, zero, length{A}(qs) with *
  have padQs := hornerPoly.pad at A, add, zero, neg, mul, one, qs,
    length{A}(quotient) with *
  have padQ := hornerPoly.pad at A, add, zero, neg, mul, one, quotient,
    length{A}(qs) with *
  have qsPadList : List(A, append{A}(listReplicate(length{A}(quotient), zero),
      qs))
    typecheck
  have qPadList : List(A, append{A}(listReplicate(length{A}(qs), zero),
      quotient))
    typecheck
  have sameLength : length{A}(append{A}(listReplicate(length{A}(quotient),
      zero),
      qs)) = length{A}(append{A}(listReplicate(length{A}(qs), zero), quotient))
    rw [length.append, length.append, listReplicate.length,
      listReplicate.length]
    arith
  have negQData := hornerNeg.data at A, add, zero, neg, mul, one,
    append{A}(listReplicate(length{A}(qs), zero), quotient) with *
  have negQList := negQData.left
  have sameLengthNeg : length{A}(append{A}(listReplicate(length{A}(quotient),
      zero), qs)) = length{A}(hornerNeg{A}(neg,
      append{A}(listReplicate(length{A}(qs), zero), quotient)))
    rw [negQData.right, sameLength]
    rfl
  have sumQ := hornerPoly.add at A, add, zero, neg, mul, one, R[0], R[0],
    append{A}(listReplicate(length{A}(quotient), zero), qs),
    hornerNeg{A}(neg, append{A}(listReplicate(length{A}(qs), zero), quotient))
    with *
  have negQ := hornerPoly.neg at A, add, zero, neg, mul, one, R[0],
    append{A}(listReplicate(length{A}(qs), zero), quotient) with *
  rw zeroAdd at sumQ
  rw negZero at negQ
  have negRData := hornerNeg.data at A, add, zero, neg, mul, one,
      remainder with *
  have negRList := negRData.left
  have sameLengthR : length{A}(rs) = length{A}(hornerNeg{A}(neg, remainder))
    rw [negRData.right, rData.right, short]
    rfl
  have sumR := hornerPoly.add at A, add, zero, neg, mul, one, R[0], R[0], rs,
    hornerNeg{A}(neg, remainder) with *
  have negR := hornerPoly.neg at A, add, zero, neg, mul, one, R[0],
      remainder with *
  rw zeroAdd at sumR
  rw negZero at negR
  have subQData := hornerSub.data at A, add, zero, neg, mul, one,
    append{A}(listReplicate(length{A}(quotient), zero), qs),
    append{A}(listReplicate(length{A}(qs), zero), quotient) with *
  have subQList := subQData.left
  have subRData := hornerSub.data at A, add, zero, neg, mul, one, rs, remainder
    with *
  have subRList := subRData.left
  have subRShort : length{A}(hornerSub{A}(add, zero, neg, rs, remainder)) =
      length{A}(ds)
    rw [subRData.right, short]
    rfl
  have qsPoly := hornerPoly.member at A, add, zero, neg, mul, one, R[0], qs
    with *
  have qPoly := hornerPoly.member at A, add, zero, neg, mul, one, R[0], quotient
    with *
  have rsPoly := hornerPoly.member at A, add, zero, neg, mul, one, R[0], rs
    with *
  have rPoly := hornerPoly.member at A, add, zero, neg, mul, one, R[0],
      remainder
    with *
  have dPoly := hornerPoly.member at A, add, zero, neg, mul, one, b, ds with *
  have combination : P[hornerPoly{A}(add, zero, neg, mul, one, zero,
      hornerSub{A}(add, zero, neg,
        append{A}(listReplicate(length{A}(quotient), zero), qs),
          append{A}(listReplicate(length{A}(qs), zero), quotient))) *
      hornerPoly{A}(add, zero, neg, mul, one, b, ds) +
      hornerPoly{A}(add, zero, neg, mul, one, zero, hornerSub{A}(add, zero,
          neg, rs, remainder))] = P[0]
    unfold hornerSub
    rw [sumQ, negQ, padQs, padQ, sumR, negR]
    linear_combination poly - equation
  have zeros := hornerDivision.zero_of_combination at A, add, zero, neg, mul,
    one, b, ds, hornerSub{A}(add, zero, neg, append{A}(listReplicate(
      length{A}(quotient), zero), qs), append{A}(listReplicate(length{A}(qs),
      zero), quotient)), hornerSub{A}(add, zero, neg, rs, remainder) with *
  have quotientZero := zeros.left
  have remainderZero := zeros.right
  unfold hornerSub at quotientZero
  unfold hornerSub at remainderZero
  rw [sumQ, negQ, padQs, padQ] at quotientZero
  rw [sumR, negR] at remainderZero
  constructor
  . linear_combination quotientZero
  . have same : hornerPoly{A}(add, zero, neg, mul, one, R[0],
      rs) = hornerPoly{A}(add, zero, neg, mul, one, R[0], remainder)
      linear_combination remainderZero
    have sameLengthRm : length{A}(rs) = length{A}(remainder)
      rw [rData.right, short]
      rfl
    exact hornerPoly.list_unique at A, add, zero, neg, mul, one, R[0], rs,
        remainder
      with *

-- A remainder list whose entries all vanish is the zero polynomial.
theorem hornerDivRemainder.poly_zero (a : Set) (ds cs : List(A))
  requires initial : a ∈ R
  requires entries : ∀ k, Nat(k) → listCoefficient{A}(zero,
      hornerDivRemainder{A}(add, zero, neg, mul, one, b, a, ds, cs), k) = zero
  shows hornerPoly{A}(add, zero, neg, mul, one, zero,
      hornerDivRemainder{A}(add, zero, neg, mul, one, b, a, ds, cs)) = P[0]
proof
  have ring := IsField.comm_ring with field
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have rData := hornerDivRemainder.data at A, add, zero, neg, mul, one, b, a,
    ds, cs with *
  have rList := rData.left
  have iff := hornerPoly.zero_iff at A, add, zero, neg, mul, one, R[0],
      hornerDivRemainder{A}(add, zero, neg, mul, one, b, a, ds, cs)
    with *
  apply iff.backward
  intros k kNat
  have alternatives : k < length{A}(hornerDivRemainder{A}(add, zero, neg, mul,
      one, b, a, ds, cs)) ∨ ¬(k < length{A}(hornerDivRemainder{A}(add, zero,
        neg, mul, one, b, a, ds, cs))) by tauto
  cases alternatives with below | notBelow
  . have value := hornerCoefficient.below at A, zero, R[0],
      hornerDivRemainder{A}(add, zero, neg, mul, one, b, a, ds, cs), k with *
    rw value
    exact entries with k, kNat
  . have le := LessEqual.of_not_Less with notBelow
    have inSucc := membership.successor_of_LessEqual with le
    have split := membership.successor.forward with inSucc
    cases split with above | same
    . have aboveLess := Less.of_membership with above
      exact hornerCoefficient.above at A, zero, R[0],
          hornerDivRemainder{A}(add, zero, neg, mul, one, b, a, ds, cs),
            k with *
    . rw ← same
      exact hornerCoefficient.leading at A, zero, R[0],
          hornerDivRemainder{A}(add, zero, neg, mul, one, b, a, ds, cs) with *

theorem HornerDivides.iff_remainder_zero (a : Set) (ds cs : List(A))
  requires initial : a ∈ R
  shows HornerDivides(A, add, zero, neg, mul, one, b, ds, a, cs) ↔
    ∀ k, Nat(k) → listCoefficient{A}(zero, hornerDivRemainder{A}(add, zero,
      neg, mul, one, b, a, ds, cs), k) = zero
proof
  have ring := IsField.comm_ring with field
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have oneIn : R[1] ∈ R by typecheck
  have target := polynomials.comm_ring at oneVariable, A, add, zero, neg, mul,
    one with *
  have poly := hornerDivision.poly at A, add, zero, neg, mul, one, b, a, ds, cs
    with *
  have qData := hornerDivQuotient.data at A, add, zero, neg, mul, one, b, a,
    ds, cs with *
  have qList := qData.left
  have rData := hornerDivRemainder.data at A, add, zero, neg, mul, one, b, a,
    ds, cs with *
  have rList := rData.left
  have qPoly := hornerPoly.member at A, add, zero, neg, mul, one, R[0],
      hornerDivQuotient{A}(add, zero, neg, mul, one, b, a, ds, cs)
    with *
  have dPoly := hornerPoly.member at A, add, zero, neg, mul, one, b, ds with *
  constructor
  . intro divides
    obtain ⟨qs, qsList, equal⟩ := divides
    have zeros := listReplicate.closed at A, zero, length{A}(ds) with *
    have zerosLength := listReplicate.length at A, zero, length{A}(ds) with *
    have zerosPoly := hornerPoly.replicate_zero at A, add, zero, neg, mul, one,
      length{A}(ds) with *
    have qsPoly := hornerPoly.member at A, add, zero, neg, mul, one, R[0], qs
      with *
    have equation : hornerPoly{A}(add, zero, neg, mul, one, a,
        cs) = P[hornerPoly{A}(add, zero, neg, mul, one, zero,
          qs) * hornerPoly{A}(add, zero, neg, mul, one, b, ds) +
        hornerPoly{A}(add, zero, neg, mul, one, zero,
            listReplicate(length{A}(ds), zero))]
      rw [zerosPoly, equal]
      ring
    have unique := hornerDivision.unique at A, add, zero, neg, mul, one, b, a,
      ds, cs, qs, listReplicate(length{A}(ds), zero) with *
    have remainder := unique.right
    intros k kNat
    rw ← remainder
    have alternatives : k < length{A}(ds) ∨ ¬(k < length{A}(ds)) by tauto
    cases alternatives with below | notBelow
    . exact listReplicate.coefficient at A, zero, zero, length{A}(ds), k
        with *
    . have le := LessEqual.of_not_Less with notBelow
      have bound : length{A}(listReplicate(length{A}(ds), zero)) ≤ k
        rw zerosLength
        exact le
      exact listCoefficient.outside at A, zero,
        listReplicate(length{A}(ds), zero), k with *
  . intro entries
    have remainderZero := hornerDivRemainder.poly_zero at A, add, zero, neg,
      mul, one, b, a, ds, cs with *
    refine ⟨hornerDivQuotient{A}(add, zero, neg, mul, one, b, a, ds, cs),
        qList, ?_⟩
    rw [poly, remainderZero]
    ring

-- The quotient of a multiple recovers the cofactor.
theorem HornerDivides.quotient (a : Set) (ds cs : List(A))
  requires initial : a ∈ R
  requires divides : HornerDivides(A, add, zero, neg, mul, one, b, ds, a, cs)
  shows hornerPoly{A}(add, zero, neg, mul, one, a, cs) =
    P[hornerPoly{A}(add, zero, neg, mul, one, zero, hornerDivQuotient{A}(add,
      zero, neg, mul, one, b, a, ds, cs)) *
      hornerPoly{A}(add, zero, neg, mul, one, b, ds)]
proof
  have ring := IsField.comm_ring with field
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have oneIn : R[1] ∈ R by typecheck
  have target := polynomials.comm_ring at oneVariable, A, add, zero, neg, mul,
    one with *
  have poly := hornerDivision.poly at A, add, zero, neg, mul, one, b, a, ds, cs
    with *
  have criterion := HornerDivides.iff_remainder_zero at A, add, zero, neg, mul,
    one, b, a, ds, cs with *
  have entries := criterion.forward with divides
  have remainderZero := hornerDivRemainder.poly_zero at A, add, zero, neg, mul,
    one, b, a, ds, cs with *
  have qData := hornerDivQuotient.data at A, add, zero, neg, mul, one, b, a,
    ds, cs with *
  have qList := qData.left
  have qPoly := hornerPoly.member at A, add, zero, neg, mul, one, R[0],
      hornerDivQuotient{A}(add, zero, neg, mul, one, b, a, ds, cs)
    with *
  have dPoly := hornerPoly.member at A, add, zero, neg, mul, one, b, ds with *
  rw [poly, remainderZero]
  ring

-- A divisor of a nonzero pair has no larger declared degree.
theorem HornerDivides.length_le (a : Set) (ds cs : List(A))
  requires initial : a ∈ R
  requires nonzero : a ≠ R[0]
  requires divides : HornerDivides(A, add, zero, neg, mul, one, b, ds, a, cs)
  shows length{A}(ds) ≤ length{A}(cs)
proof
  have ring := IsField.comm_ring with field
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have oneIn : R[1] ∈ R by typecheck
  have target := polynomials.comm_ring at oneVariable, A, add, zero, neg, mul,
    one with *
  have noZero := IsField.no_zero_divisors with field
  obtain ⟨ws, wsList, equal⟩ := divides
  have wsPoly := hornerPoly.member at A, add, zero, neg, mul, one, R[0], ws
    with *
  have dPoly := hornerPoly.member at A, add, zero, neg, mul, one, b, ds with *
  have wNonzero : hornerPoly{A}(add, zero, neg, mul, one, zero, ws) ≠ P[0]
    intro wZero
    rw wZero at equal
    have pZero : hornerPoly{A}(add, zero, neg, mul, one, a, cs) = P[0]
      rw equal
      ring
    have iff := hornerPoly.zero_iff at A, add, zero, neg, mul, one, a, cs with *
    have vanishing := iff.forward with pZero
    have lengthNat : Nat(length{A}(cs)) by typecheck
    have top := vanishing with length{A}(cs), lengthNat
    have leading := hornerCoefficient.leading at A, zero, a, cs with *
    rw leading at top
    exact nonzero with top
  have normalPoly := hornerPoly.normal at A, add, zero, neg, mul, one, R[0], ws
    with *
  unfold normalLeading at normalPoly
  unfold normalLower at normalPoly
  have fullList := hornerFullList.list at A, R[0], ws with *
  have normalShape := hornerTrim.normal at A, zero, hornerFullList{A}(zero, ws)
    with *
  have wIn := hornerTrimLeading.mem at A, zero, hornerFullList{A}(zero, ws)
    with *
  have trimList := hornerTrimLower.list at A, zero, hornerFullList{A}(zero, ws)
    with *
  cases normalShape with wLead | trivial
  . have product := hornerPoly.mul at A, add, zero, neg, mul, one,
      hornerTrimLeading{A}(zero, hornerFullList{A}(zero, ws)), b,
      hornerTrimLower{A}(zero, hornerFullList{A}(zero, ws)), ds with *
    have mulData := hornerMulList.data at A, add, zero, neg, mul, one,
        hornerTrimLeading{A}(zero, hornerFullList{A}(zero, ws)), b,
      hornerTrimLower{A}(zero, hornerFullList{A}(zero, ws)), ds with *
    have mulList := mulData.left
    have mulLength := mulData.right
    have wb := IsRing.mul_closed with ordinary, wIn, divisorLeading
    have wbNonzero : R[hornerTrimLeading{A}(zero, hornerFullList{A}(zero,
        ws)) * b] ≠ R[0]
      intro productZero
      have split := noZero with hornerTrimLeading{A}(zero,
          hornerFullList{A}(zero, ws)), wIn, b, divisorLeading, productZero
      cases split with w0 | b0
      . exact wLead with w0
      . exact divisorNonzero with b0
    rw [← normalPoly, ← product] at equal
    have iff := hornerPoly.eq_iff at A, add, zero, neg, mul, one, a,
      R[hornerTrimLeading{A}(zero, hornerFullList{A}(zero, ws)) * b], cs,
        hornerMulList{A}(add, zero, mul, hornerTrimLeading{A}(zero,
          hornerFullList{A}(zero, ws)), b, hornerTrimLower{A}(zero,
            hornerFullList{A}(zero, ws)), ds) with *
    have coefficients := iff.forward with equal
    have kNat : Nat(length{A}(hornerMulList{A}(add, zero, mul,
        hornerTrimLeading{A}(zero, hornerFullList{A}(zero, ws)), b,
          hornerTrimLower{A}(zero, hornerFullList{A}(zero, ws)),
            ds))) by typecheck
    have kIn := nat.omega.forward with kNat
    have atTop := coefficients with length{A}(hornerMulList{A}(add, zero, mul,
        hornerTrimLeading{A}(zero, hornerFullList{A}(zero, ws)), b,
          hornerTrimLower{A}(zero, hornerFullList{A}(zero, ws)), ds)), kIn
    have leading := hornerCoefficient.leading at A, zero,
        R[hornerTrimLeading{A}(zero, hornerFullList{A}(zero, ws)) * b],
          hornerMulList{A}(add, zero, mul, hornerTrimLeading{A}(zero,
            hornerFullList{A}(zero, ws)), b, hornerTrimLower{A}(zero,
              hornerFullList{A}(zero, ws)), ds)
      with *
    rw leading at atTop
    have alternatives : length{A}(ds) ≤ length{A}(cs) ∨
      ¬(length{A}(ds) ≤ length{A}(cs)) by tauto
    cases alternatives with le | notLe
    . exact le
    . have less := Less.of_not_LessEqual with notLe
      have bound : length{A}(cs) < length{A}(hornerMulList{A}(add, zero, mul,
          hornerTrimLeading{A}(zero, hornerFullList{A}(zero, ws)), b,
            hornerTrimLower{A}(zero, hornerFullList{A}(zero, ws)), ds))
        rw mulLength
        arith
      have above := hornerCoefficient.above at A, zero, a, cs,
        length{A}(hornerMulList{A}(add, zero, mul, hornerTrimLeading{A}(zero,
          hornerFullList{A}(zero, ws)), b, hornerTrimLower{A}(zero,
            hornerFullList{A}(zero, ws)), ds)) with *
      rw above at atTop
      exfalso
      symm at atTop
      exact wbNonzero with atTop
  . exfalso
    apply wNonzero
    rw [← normalPoly, trivial.left, trivial.right]
    exact hornerPoly.zero_nil with *

end Fields

section Rings
variable (A add zero neg mul one : Set)
notation ring R := (A, add, zero, neg, mul, one)
notation ring P := R[oneVariable]
hypothesis ring : IsCommRing(R)

theorem HornerDivides.refl (a : Set) (cs : List(A))
  requires initial : a ∈ R
  shows HornerDivides(A, add, zero, neg, mul, one, a, cs, a, cs)
proof
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have oneIn : R[1] ∈ R by typecheck
  have target := polynomials.comm_ring at oneVariable, A, add, zero, neg, mul,
    one with *
  have empty : List(A, []) by typecheck
  have single : List(A, one :: []) by typecheck
  have consPoly := hornerPoly.cons at A, add, zero, neg, mul, one, R[0], R[1],
    [] with *
  have emptyPoly := hornerPoly.zero_nil at A, add, zero, neg, mul, one with *
  have variable := polynomialVariable.member at oneVariable, A, zero, one,
    (0:N) with *
  have unitPoly : hornerPoly{A}(add, zero, neg, mul, one, zero,
      one :: []) = P[1]
    rw [consPoly, emptyPoly]
    ring
  have selfPoly := hornerPoly.member at A, add, zero, neg, mul, one, a, cs
    with *
  refine ⟨one :: [], single, ?_⟩
  rw unitPoly
  ring

theorem HornerDivides.trans (a b c : Set) (cs ds es : List(A))
  requires first : a ∈ R
  requires second : b ∈ R
  requires third : c ∈ R
  requires left : HornerDivides(A, add, zero, neg, mul, one, a, cs, b, ds)
  requires right : HornerDivides(A, add, zero, neg, mul, one, b, ds, c, es)
  shows HornerDivides(A, add, zero, neg, mul, one, a, cs, c, es)
proof
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have target := polynomials.comm_ring at oneVariable, A, add, zero, neg, mul,
    one with *
  obtain ⟨qs, qsList, equalB⟩ := left
  obtain ⟨ps, psList, equalC⟩ := right
  have product := hornerPoly.mul at A, add, zero, neg, mul, one, R[0], R[0], ps,
    qs with *
  have zeroMul : R[0 * 0] = R[0] by ring
  rw zeroMul at product
  have mulData := hornerMulList.data at A, add, zero, neg, mul, one, R[0], R[0],
    ps, qs with *
  have psPoly := hornerPoly.member at A, add, zero, neg, mul, one, R[0], ps
    with *
  have qsPoly := hornerPoly.member at A, add, zero, neg, mul, one, R[0], qs
    with *
  have aPoly := hornerPoly.member at A, add, zero, neg, mul, one, a, cs with *
  refine ⟨hornerMulList{A}(add, zero, mul, zero, zero, ps, qs), mulData.left,
    ?_⟩
  rw [equalC, equalB, product]
  ring

theorem HornerDivides.mul_right (a b c : Set) (cs ds es : List(A))
  requires first : a ∈ R
  requires second : b ∈ R
  requires third : c ∈ R
  requires divides : HornerDivides(A, add, zero, neg, mul, one, a, cs, b, ds)
  shows HornerDivides(A, add, zero, neg, mul, one, a, cs, R[b * c],
    hornerMulList{A}(add, zero, mul, b, c, ds, es))
proof
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have target := polynomials.comm_ring at oneVariable, A, add, zero, neg, mul,
    one with *
  obtain ⟨qs, qsList, equalB⟩ := divides
  have productBC := hornerPoly.mul at A, add, zero, neg, mul, one, b, c, ds, es
    with *
  have productQ := hornerPoly.mul at A, add, zero, neg, mul, one, R[0], c, qs,
    es with *
  have zeroMul : R[0 * c] = R[0] by ring
  rw zeroMul at productQ
  have mulData := hornerMulList.data at A, add, zero, neg, mul, one, R[0], c,
    qs, es with *
  have qsPoly := hornerPoly.member at A, add, zero, neg, mul, one, R[0], qs
    with *
  have aPoly := hornerPoly.member at A, add, zero, neg, mul, one, a, cs with *
  have cPoly := hornerPoly.member at A, add, zero, neg, mul, one, c, es with *
  refine ⟨hornerMulList{A}(add, zero, mul, zero, c, qs, es), mulData.left, ?_⟩
  rw [productBC, productQ, equalB]
  ring

theorem HornerDivides.add (a b c : Set) (cs ds es : List(A))
  requires first : a ∈ R
  requires second : b ∈ R
  requires third : c ∈ R
  requires sameLength : length{A}(ds) = length{A}(es)
  requires left : HornerDivides(A, add, zero, neg, mul, one, a, cs, b, ds)
  requires right : HornerDivides(A, add, zero, neg, mul, one, a, cs, c, es)
  shows HornerDivides(A, add, zero, neg, mul, one, a, cs, R[b + c],
    hornerAdd{A}(add, zero, ds, es))
proof
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have target := polynomials.comm_ring at oneVariable, A, add, zero, neg, mul,
    one with *
  have zeroAdd : R[0 + 0] = R[0] by ring
  obtain ⟨qs, qsList, equalB⟩ := left
  obtain ⟨ps, psList, equalC⟩ := right
  have zerosQ := listReplicate.closed at A, zero, length{A}(qs) with *
  have zerosP := listReplicate.closed at A, zero, length{A}(ps) with *
  have padQs := hornerPoly.pad at A, add, zero, neg, mul, one, qs,
    length{A}(ps) with *
  have padPs := hornerPoly.pad at A, add, zero, neg, mul, one, ps,
    length{A}(qs) with *
  have qsPadList : List(A, append{A}(listReplicate(length{A}(ps), zero), qs))
    typecheck
  have psPadList : List(A, append{A}(listReplicate(length{A}(qs), zero), ps))
    typecheck
  have samePad : length{A}(append{A}(listReplicate(length{A}(ps), zero),
      qs)) = length{A}(append{A}(listReplicate(length{A}(qs), zero), ps))
    rw [length.append, length.append, listReplicate.length,
      listReplicate.length]
    arith
  have sumQ := hornerPoly.add at A, add, zero, neg, mul, one, R[0], R[0],
    append{A}(listReplicate(length{A}(ps), zero), qs),
    append{A}(listReplicate(length{A}(qs), zero), ps) with *
  rw zeroAdd at sumQ
  have sumBC := hornerPoly.add at A, add, zero, neg, mul, one, b, c, ds, es
    with *
  have addData := hornerAdd.data at A, add, zero, neg, mul, one,
    append{A}(listReplicate(length{A}(ps), zero), qs),
    append{A}(listReplicate(length{A}(qs), zero), ps) with *
  have qsPoly := hornerPoly.member at A, add, zero, neg, mul, one, R[0], qs
    with *
  have psPoly := hornerPoly.member at A, add, zero, neg, mul, one, R[0], ps
    with *
  have aPoly := hornerPoly.member at A, add, zero, neg, mul, one, a, cs with *
  refine ⟨hornerAdd{A}(add, zero,
    append{A}(listReplicate(length{A}(ps), zero), qs),
    append{A}(listReplicate(length{A}(qs), zero), ps)), addData.left, ?_⟩
  rw [sumBC, sumQ, padQs, padPs, equalB, equalC]
  ring

theorem HornerDivides.zero (a b : Set) (cs ds : List(A))
  requires first : a ∈ R
  requires second : b ∈ R
  requires vanishes : HornerZero(A, zero, b, ds)
  shows HornerDivides(A, add, zero, neg, mul, one, a, cs, b, ds)
proof
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have target := polynomials.comm_ring at oneVariable, A, add, zero, neg, mul,
    one with *
  have empty : List(A, []) by typecheck
  have iff := hornerPoly.zero_iff at A, add, zero, neg, mul, one, b, ds with *
  have bZero := iff.backward with vanishes
  have emptyPoly := hornerPoly.zero_nil at A, add, zero, neg, mul, one with *
  have aPoly := hornerPoly.member at A, add, zero, neg, mul, one, a, cs with *
  refine ⟨[], empty, ?_⟩
  rw [bZero, emptyPoly]
  ring

-- A root of a divisor is a root of the multiple.
theorem HornerDivides.root (a b x : Set) (cs ds : List(A))
  requires first : a ∈ R
  requires second : b ∈ R
  requires element : x ∈ R
  requires divides : HornerDivides(A, add, zero, neg, mul, one, a, cs, b, ds)
  requires root : hornerAt{A}(add, mul, a, x, cs) = R[0]
  shows hornerAt{A}(add, mul, b, x, ds) = R[0]
proof
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  obtain ⟨qs, qsList, equal⟩ := divides
  have product := hornerPoly.mul at A, add, zero, neg, mul, one, R[0], a, qs, cs
    with *
  have zeroMul : R[0 * a] = R[0] by ring
  rw zeroMul at product
  have mulData := hornerMulList.data at A, add, zero, neg, mul, one, R[0], a,
    qs, cs with *
  have mulList := mulData.left
  rw ← product at equal
  have value := hornerAt.congr_of_poly at A, add, zero, neg, mul, one, b, R[0],
    x, ds, hornerMulList{A}(add, zero, mul, zero, a, qs, cs) with *
  have mulValue := hornerMulList.value at A, add, zero, neg, mul, one, R[0], a,
    x, qs, cs with *
  rw zeroMul at mulValue
  have qValue := hornerAt.closed at A, add, zero, neg, mul, one, R[0], x, qs
    with *
  rw [value, mulValue, root]
  ring

-- The factor theorem: X − r divides p exactly when p(r) = 0.
theorem HornerDivides.linear_iff (a r : Set) (cs : List(A))
  requires initial : a ∈ R
  requires center : r ∈ R
  shows HornerDivides(A, add, zero, neg, mul, one, one, neg(r) :: [], a, cs) ↔
    hornerAt{A}(add, mul, a, r, cs) = R[0]
proof
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have oneIn : R[1] ∈ R by typecheck
  have negated := IsRing.neg_closed with ordinary, center
  have single : List(A, neg(r) :: []) by typecheck
  have empty : List(A, []) by typecheck
  have target := polynomials.comm_ring at oneVariable, A, add, zero, neg, mul,
    one with *
  have hom := polynomialCoefficients.hom at oneVariable, A, add, zero, neg, mul,
    one with *
  have variable := polynomialVariable.member at oneVariable, A, zero, one,
    (0:N) with *
  have linearValue : hornerAt{A}(add, mul, one, r, neg(r) :: []) = R[0]
    rw [hornerAt.cons, hornerAt.nil]
    ring
  have centerValue := polynomialCoefficients.value at oneVariable, A, zero, r
    with *
  have negValue := polynomialCoefficients.value at oneVariable, A, zero, neg(r)
    with *
  have mappedNeg := IsRingHom.neg with hom, center
  have linearPoly : hornerPoly{A}(add, zero, neg, mul, one, one, neg(r) :: []) =
      P[polynomialVariable(oneVariable, R,
        (0:N)) - polynomialConstant(oneVariable, R, r)]
    have consPoly := hornerPoly.cons at A, add, zero, neg, mul, one, R[1],
      neg(r), [] with *
    have constant := hornerPoly.constant at A, add, zero, neg, mul, one, R[1]
      with *
    have constantR := polynomialConstant.member at oneVariable, A, zero, r
      with *
    rw [consPoly, constant, ← negValue, mappedNeg, centerValue]
    ring
  constructor
  . intro divides
    exact HornerDivides.root at A, add, zero, neg, mul, one, one, a, r,
      neg(r) :: [], cs with *
  . intro root
    have shape := List.cases at A, cs with *
    cases shape with isEmpty | isCons
    . rw [isEmpty, hornerAt.nil] at root
      have vanishing : HornerZero(A, zero, a, [])
        intros k kNat
        have alternatives : k = (0:N) ∨ k ≠ (0:N) by tauto
        cases alternatives with isZero | nonzero
        . rw isZero
          have top := hornerCoefficient.leading at A, zero, a, [] with *
          rw length.nil at top
          rw [top, root]
          rfl
        . have positive := Less.positive_of_ne_zero with kNat, nonzero
          have bound : length{A}([]) < k
            rw length.nil
            exact positive
          exact hornerCoefficient.above at A, zero, a, [], k with *
      rw isEmpty
      exact HornerDivides.zero at A, add, zero, neg, mul, one, one, a,
        neg(r) :: [], [] with *
    . obtain ⟨c, coefficient, tail, tailList, equal⟩ := isCons
      rw equal at root
      rw equal
      have quotient := hornerQuotient.closed at A, add, zero, neg, mul, one, a,
        r, tail with *
      have first := polynomialCoefficients.value at oneVariable, A, zero, a
        with *
      have mappedZero := IsRingHom.zero with hom
      have constantA := polynomialConstant.member at oneVariable, A, zero, a
        with *
      have result := hornerValue.synthetic_division at A, add, zero, neg, mul,
        one, P, polynomialAdd(oneVariable, R), P[0],
        polynomialNeg(oneVariable, R), polynomialMul(oneVariable, R), P[1],
        polynomialCoefficients(oneVariable, R), a, r,
            polynomialVariable(oneVariable, R, (0:N)), c, tail with *
      have quotientValue := hornerValue.closed at A, add, zero, neg, mul, one,
        P, polynomialAdd(oneVariable, R), P[0], polynomialNeg(oneVariable, R),
        polynomialMul(oneVariable, R), P[1],
        polynomialCoefficients(oneVariable, R),
            polynomialVariable(oneVariable, R, (0:N)),
        polynomialConstant(oneVariable, R, a),
        hornerQuotient{A}(add, mul, a, r, tail) with *
      have constantR := polynomialConstant.member at oneVariable, A, zero, r
        with *
      rw [first, centerValue, root, mappedZero] at result
      have factor : hornerPoly{A}(add, zero, neg, mul, one, a, c :: tail) =
          P[(polynomialVariable(oneVariable, R,
            (0:N)) - polynomialConstant(oneVariable, R, r)) *
            hornerPoly{A}(add, zero, neg, mul, one, a, hornerQuotient{A}(add,
                mul, a, r, tail))]
        unfold hornerPoly
        unfold polynomialFromHorner
        rw result
        ring
      have fullList := hornerFullList.list at A, a,
        hornerQuotient{A}(add, mul, a, r, tail) with *
      have fullPoly := hornerPoly.full_list at A, add, zero, neg, mul, one, a,
        hornerQuotient{A}(add, mul, a, r, tail) with *
      have quotientPoly := hornerPoly.member at A, add, zero, neg, mul, one, a,
        hornerQuotient{A}(add, mul, a, r, tail) with *
      refine ⟨hornerFullList{A}(a, hornerQuotient{A}(add, mul, a, r, tail)),
        fullList, ?_⟩
      rw [factor, fullPoly, linearPoly]
      ring

end Rings
