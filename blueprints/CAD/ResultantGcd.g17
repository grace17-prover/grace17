      hornerMulList{A}(add, zero, mul, zero, zero, ts, u0)),
      hornerFullList{A}(a, cs))), zero),
      hornerMulList{A}(add, zero, mul, zero, zero, ts, v0)),
      hornerMulList{A}(add, zero, mul, zero, zero,
      hornerDivQuotient{A}(add, zero, neg, mul, one, b, zero, ds,
      hornerMulList{A}(add, zero, mul, zero, zero, ts, u0)),
      hornerFullList{A}(a, cs)))), ds))))
    with field, abIn, abNonzero, pqData.left, s2Data.left, nfData.left,
      nfLength, vanishes
  have sZero := result.left
  unfold resultant.combinationRight
  unfold resultant.combinationMiddle
  unfold resultant.combinationLeft
  refine ⟨clData.left, clData.right, crData.left, crData.right, ?_⟩
  rw [chain, sZero]
  ring

-- A common factor of positive degree divides the constant resultant, so
-- the resultant vanishes.
theorem resultant.eq_zero_of_common_factor (g : Set) (cs ds gs : List(A))
  requires divisor : g ∈ R
  requires nonzero : g ≠ R[0]
  requires nonempty : gs ≠ []
  requires dividesLeft : HornerDivides(A, add, zero, neg, mul, one, g, gs, a,
      cs)
  requires dividesRight : HornerDivides(A, add, zero, neg, mul, one, g, gs, b,
    ds)
  shows resultant(R, a, cs, b, ds) = R[0]
proof
  have ring := IsField.comm_ring with field
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have sizeNat : Nat(length{A}(cs) + length{A}(ds)) by typecheck
  have shape := natural.zero_or_successor at length{A}(cs) + length{A}(ds)
    with sizeNat
  rcases shape with isZero | ⟨k, kNat, isSucc⟩
  . -- Both pairs are constants: no divisor of positive degree.
    exfalso
    have bound := HornerDivides.length_le at A, add, zero, neg, mul, one, g, a,
      gs, cs with field, divisor, nonzero, left, leftNonzero, dividesLeft
    have zeroLength : length{A}(gs) = (0:N) by arith
    have gsNil := length.eq_zero at A, gs with zeroLength
    exact nonempty with gsNil
  have positive : (0:N) < length{A}(cs) + length{A}(ds) by arith
  have combination := resultant.combination at A, add, zero, neg, mul, one, a,
    b, cs, ds with ring, left, right, positive
  obtain ⟨us, usList, vs, vsList, usLength, vsLength, identity⟩ := combination
  unfold HornerDivides at dividesLeft
  obtain ⟨qs1, qs1List, pEq⟩ := dividesLeft
  unfold HornerDivides at dividesRight
  obtain ⟨qs2, qs2List, qEq⟩ := dividesRight
  by_contra nonzeroRes
  have resIn := resultant.closed at A, add, zero, neg, mul, one, a, b, cs, ds
    with ring, left, right
  have constEq := hornerPoly.constant at A, add, zero, neg, mul, one,
    resultant(R, a, cs, b, ds) with ring, resIn
  have w1Data := hornerMulList.data at A, add, zero, neg, mul, one, zero, zero,
    us, qs1 with ring, zeroIn, zeroIn, usList, qs1List
  have w1Eq := hornerPoly.mul_lists at A, add, zero, neg, mul, one, us, qs1
    with ring, usList, qs1List
  have w2Data := hornerMulList.data at A, add, zero, neg, mul, one, zero, zero,
    vs, qs2 with ring, zeroIn, zeroIn, vsList, qs2List
  have w2Eq := hornerPoly.mul_lists at A, add, zero, neg, mul, one, vs, qs2
    with ring, vsList, qs2List
  obtain ⟨ws, wsList, sumEq⟩ := hornerPoly.exists_sum at A, add, zero, neg,
    mul, one, hornerMulList{A}(add, zero, mul, zero, zero, us, qs1),
    hornerMulList{A}(add, zero, mul, zero, zero, vs, qs2)
    with ring, w1Data.left, w2Data.left
  have gIn := hornerPoly.member at A, add, zero, neg, mul, one, g, gs
    with ring, divisor
  have usIn := hornerPoly.member at A, add, zero, neg, mul, one, zero, us
    with ring, zeroIn, usList
  have vsIn := hornerPoly.member at A, add, zero, neg, mul, one, zero, vs
    with ring, zeroIn, vsList
  have qs1In := hornerPoly.member at A, add, zero, neg, mul, one, zero, qs1
    with ring, zeroIn, qs1List
  have qs2In := hornerPoly.member at A, add, zero, neg, mul, one, zero, qs2
    with ring, zeroIn, qs2List
  have divides : HornerDivides(A, add, zero, neg, mul, one, g, gs,
      resultant(R, a, cs, b, ds), [])
    unfold HornerDivides
    refine ⟨ws, wsList, ?_⟩
    rw [constEq, ← identity, pEq, qEq, sumEq, w1Eq, w2Eq]
    ring
  have bound := HornerDivides.length_le at A, add, zero, neg, mul, one, g,
    resultant(R, a, cs, b, ds), gs, [] with field, divisor, nonzero, resIn,
    nonzeroRes, divides
  rw length.nil at bound
  have zeroLength : length{A}(gs) = (0:N) by arith
  have gsNil := length.eq_zero at A, gs with zeroLength
  exact nonempty with gsNil

-- A coprime pair has a nonzero resultant: the explicit left inverse of the
-- Sylvester matrix built from a Bézout identity.
theorem resultant.nonzero_of_coprime (cs ds : List(A))
  requires coprime : HornerCoprime(A, add, zero, neg, mul, one, a, cs, b, ds)
  shows resultant(R, a, cs, b, ds) ≠ R[0]
proof
  have ring := IsField.comm_ring with field
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have oneIn : R[1] ∈ R by typecheck
  have sizeNat : Nat(length{A}(cs) + length{A}(ds)) by typecheck
  have finite := Finite.natural at length{A}(cs) + length{A}(ds)
  unfold HornerCoprime at coprime
  obtain ⟨u0, u0List, v0, v0List, identity⟩ := coprime
  have wFunction := resultant.inverseMatrix.function at A, add, zero, neg, mul,
    one, a, b, u0, v0, cs, ds with *
  have matrixW : RingMatrix(length{A}(cs) + length{A}(ds), R,
      resultant.inverseMatrix(A, add, zero, neg, mul, one, a, b, u0, v0, cs,
          ds))
    unfold RingMatrix
    exact wFunction
  have matrix := sylvesterBlockMatrix.matrix at A, add, zero, neg, mul, one,
    a, b, cs, ds, length{A}(ds), length{A}(cs) + length{A}(ds) with ring, left,
        right
  have inverse : ∀ l ∈ length{A}(cs) + length{A}(ds),
      ∀ k ∈ length{A}(cs) + length{A}(ds),
      matrixProductEntry(length{A}(cs) + length{A}(ds), A, add, zero, neg, mul,
        one, resultant.inverseMatrix(A, add, zero, neg, mul, one, a, b, u0, v0,
            cs, ds),
        sylvesterBlockMatrix(A, zero, a, b, cs, ds, length{A}(ds),
      length{A}(cs) + length{A}(ds)), l, k) =
      singleValue(A, zero, one, k, l)
    intros l hl k hk
    have lNat := natural.member at length{A}(cs) + length{A}(ds) with hl
    have kNat := natural.member at length{A}(cs) + length{A}(ds) with hk
    have lLess := Less.of_membership at l, length{A}(cs) + length{A}(ds) with hl
    have kLess := Less.of_membership at k, length{A}(cs) + length{A}(ds) with hk
    have lGap : succ(l) ≤ length{A}(cs) + length{A}(ds)
      unfold Less at lLess
      exact lLess
    have kGap : succ(k) ≤ length{A}(cs) + length{A}(ds)
      unfold Less at kLess
      exact kLess
    have lCancel : sylvesterRow.indexSum(sylvesterRow.indexDifference(
        length{A}(cs) + length{A}(ds), succ(l)), succ(l)) =
        length{A}(cs) + length{A}(ds)
      rw [sylvesterRow.indexSum.value, sylvesterRow.indexDifference.value]
      exact sub.cancel_of_le at length{A}(cs) + length{A}(ds), succ(l)
        with lGap
    rw sylvesterRow.indexSum.value at lCancel
    have kCancel : sylvesterRow.indexSum(sylvesterRow.indexDifference(
        length{A}(cs) + length{A}(ds), succ(k)), succ(k)) =
        length{A}(cs) + length{A}(ds)
      rw [sylvesterRow.indexSum.value, sylvesterRow.indexDifference.value]
      exact sub.cancel_of_le at length{A}(cs) + length{A}(ds), succ(k)
        with kGap
    rw sylvesterRow.indexSum.value at kCancel
    have powerList := resultant.power.list at A, zero, one,
        sylvesterRow.indexDifference(length{A}(cs) + length{A}(ds), succ(l))
      with zeroIn, oneIn
    have powerLength := resultant.power.length at A, zero, one,
        sylvesterRow.indexDifference(length{A}(cs) + length{A}(ds), succ(l))
      with zeroIn
    have powerShort : length{A}(resultant.power{A}(zero, one,
        sylvesterRow.indexDifference(length{A}(cs) + length{A}(ds), succ(l)))) ≤
        length{A}(cs) + length{A}(ds)
      rw powerLength
      arith
    have combination := resultant.combination_of_bezout at A, add, zero, neg,
      mul, one, a, b, cs, ds, u0, v0, resultant.power{A}(zero, one,
          sylvesterRow.indexDifference(length{A}(cs) + length{A}(ds), succ(l)))
      with field, left, right, leftNonzero, rightNonzero, u0List, v0List,
        powerList, identity, powerShort
    obtain ⟨clList, clLength, crList, crLength, combEq⟩ := combination
    have rowEntries : ∀ i ∈ length{A}(cs) + length{A}(ds),
        resultant.inverseMatrix(A, add, zero, neg, mul, one, a, b, u0, v0, cs,
            ds)[l, i] =
        sylvesterVector(A, zero,
      resultant.combinationLeft{A}(add, zero, neg, mul, one, b, u0, ds,
      resultant.power{A}(zero, one,
          sylvesterRow.indexDifference(length{A}(cs) + length{A}(ds),
          succ(l)))),
      resultant.combinationRight{A}(add, zero, neg, mul, one, a, b, u0, v0,
      cs, ds, resultant.power{A}(zero, one,
          sylvesterRow.indexDifference(length{A}(cs) + length{A}(ds),
          succ(l)))),
      length{A}(ds), length{A}(cs) + length{A}(ds))(i)
      intros i hi
      have pair := product.pair at l, i, length{A}(cs) + length{A}(ds),
        length{A}(cs) + length{A}(ds) with hl, hi
      have value := resultant.inverseMatrix.value at A, add, zero, neg, mul,
        one, a, b, u0, v0, cs, ds, (l, i) with *
      rw [value, fst.pair, snd.pair]
      rfl
    unfold matrixProductEntry
    have weightsW := matrixProductWeights.function at length{A}(cs) +
        length{A}(ds), A,
      add, zero, neg, mul, one,
      resultant.inverseMatrix(A, add, zero, neg, mul, one, a, b, u0, v0, cs,
          ds),
      sylvesterBlockMatrix(A, zero, a, b, cs, ds, length{A}(ds),
      length{A}(cs) + length{A}(ds)), l, k with *
    have vectorFunction := sylvesterVector.function at A, zero,
      resultant.combinationLeft{A}(add, zero, neg, mul, one, b, u0, ds,
      resultant.power{A}(zero, one,
          sylvesterRow.indexDifference(length{A}(cs) + length{A}(ds),
          succ(l)))),
      resultant.combinationRight{A}(add, zero, neg, mul, one, a, b, u0, v0,
      cs, ds, resultant.power{A}(zero, one,
          sylvesterRow.indexDifference(length{A}(cs) + length{A}(ds),
          succ(l)))),
      length{A}(ds), length{A}(cs) + length{A}(ds) with zeroIn, clList, crList
    have weightsV := rowVectorWeights.function at length{A}(cs) +
        length{A}(ds), A, add,
      zero, neg, mul, one,
      sylvesterVector(A, zero,
      resultant.combinationLeft{A}(add, zero, neg, mul, one, b, u0, ds,
      resultant.power{A}(zero, one,
          sylvesterRow.indexDifference(length{A}(cs) + length{A}(ds),
          succ(l)))),
      resultant.combinationRight{A}(add, zero, neg, mul, one, a, b, u0, v0,
      cs, ds, resultant.power{A}(zero, one,
          sylvesterRow.indexDifference(length{A}(cs) + length{A}(ds),
          succ(l)))),
      length{A}(ds), length{A}(cs) + length{A}(ds)),
      sylvesterBlockMatrix(A, zero, a, b, cs, ds, length{A}(ds),
      length{A}(cs) + length{A}(ds)), k with *
    have agree : ∀ i ∈ length{A}(cs) + length{A}(ds),
        matrixProductWeights(length{A}(cs) + length{A}(ds), A, add, zero, neg,
            mul,
      one, resultant.inverseMatrix(A, add, zero, neg, mul, one, a, b, u0, v0,
          cs, ds),
      sylvesterBlockMatrix(A, zero, a, b, cs, ds, length{A}(ds),
      length{A}(cs) + length{A}(ds)), l, k)(i) =
        rowVectorWeights(length{A}(cs) + length{A}(ds), A, add, zero, neg, mul,
            one,
      sylvesterVector(A, zero,
      resultant.combinationLeft{A}(add, zero, neg, mul, one, b, u0, ds,
      resultant.power{A}(zero, one,
          sylvesterRow.indexDifference(length{A}(cs) + length{A}(ds),
          succ(l)))),
      resultant.combinationRight{A}(add, zero, neg, mul, one, a, b, u0, v0,
      cs, ds, resultant.power{A}(zero, one,
          sylvesterRow.indexDifference(length{A}(cs) + length{A}(ds),
          succ(l)))),
      length{A}(ds), length{A}(cs) + length{A}(ds)),
      sylvesterBlockMatrix(A, zero, a, b, cs, ds, length{A}(ds),
      length{A}(cs) + length{A}(ds)), k)(i)
      intros i hi
      have first := matrixProductWeights.value at length{A}(cs) +
          length{A}(ds), A, add,
        zero, neg, mul, one,
        resultant.inverseMatrix(A, add, zero, neg, mul, one, a, b, u0, v0, cs,
            ds),
        sylvesterBlockMatrix(A, zero, a, b, cs, ds, length{A}(ds),
      length{A}(cs) + length{A}(ds)), l, k, i with *
      have second := rowVectorWeights.value at length{A}(cs) + length{A}(ds),
          A, add,
        zero, neg, mul, one,
        sylvesterVector(A, zero,
      resultant.combinationLeft{A}(add, zero, neg, mul, one, b, u0, ds,
      resultant.power{A}(zero, one,
          sylvesterRow.indexDifference(length{A}(cs) + length{A}(ds),
          succ(l)))),
      resultant.combinationRight{A}(add, zero, neg, mul, one, a, b, u0, v0,
      cs, ds, resultant.power{A}(zero, one,
          sylvesterRow.indexDifference(length{A}(cs) + length{A}(ds),
          succ(l)))),
      length{A}(ds), length{A}(cs) + length{A}(ds)),
        sylvesterBlockMatrix(A, zero, a, b, cs, ds, length{A}(ds),
      length{A}(cs) + length{A}(ds)), k, i with *
      have entry := rowEntries with i, hi
      rw [first, second, entry]
      rfl
    have congr := finiteRingSum.congr at length{A}(cs) + length{A}(ds), A, add,
        zero,
      neg, mul, one,
      matrixProductWeights(length{A}(cs) + length{A}(ds), A, add, zero, neg,
          mul,
      one, resultant.inverseMatrix(A, add, zero, neg, mul, one, a, b, u0, v0,
          cs, ds),
      sylvesterBlockMatrix(A, zero, a, b, cs, ds, length{A}(ds),
      length{A}(cs) + length{A}(ds)), l, k),
      rowVectorWeights(length{A}(cs) + length{A}(ds), A, add, zero, neg, mul,
          one,
      sylvesterVector(A, zero,
      resultant.combinationLeft{A}(add, zero, neg, mul, one, b, u0, ds,
      resultant.power{A}(zero, one,
          sylvesterRow.indexDifference(length{A}(cs) + length{A}(ds),
          succ(l)))),
      resultant.combinationRight{A}(add, zero, neg, mul, one, a, b, u0, v0,
      cs, ds, resultant.power{A}(zero, one,
          sylvesterRow.indexDifference(length{A}(cs) + length{A}(ds),
          succ(l)))),
      length{A}(ds), length{A}(cs) + length{A}(ds)),
      sylvesterBlockMatrix(A, zero, a, b, cs, ds, length{A}(ds),
      length{A}(cs) + length{A}(ds)), k)
      with ring, finite, weightsW, weightsV, agree
    rw congr
    have balance : length{A}(cs) + length{A}(resultant.combinationLeft{A}(add,
        zero, neg, mul, one, b, u0, ds,
      resultant.power{A}(zero, one,
          sylvesterRow.indexDifference(length{A}(cs) + length{A}(ds),
          succ(l))))) =
        length{A}(ds) + length{A}(resultant.combinationRight{A}(add, zero, neg,
            mul, one, a, b, u0, v0,
      cs, ds, resultant.power{A}(zero, one,
          sylvesterRow.indexDifference(length{A}(cs) + length{A}(ds),
          succ(l)))))
      rw [clLength, crLength]
      arith
    have column : k < length{A}(resultant.combinationLeft{A}(add, zero, neg,
        mul, one, b, u0, ds,
      resultant.power{A}(zero, one,
          sylvesterRow.indexDifference(length{A}(cs) + length{A}(ds),
          succ(l))))) +
        length{A}(resultant.combinationRight{A}(add, zero, neg, mul, one, a, b,
            u0, v0,
      cs, ds, resultant.power{A}(zero, one,
          sylvesterRow.indexDifference(length{A}(cs) + length{A}(ds),
          succ(l)))))
      rw [clLength, crLength]
      arith
    have degree : sylvesterRow.indexSum(k,
        succ(sylvesterRow.indexDifference(length{A}(cs) + length{A}(ds),
        succ(k)))) =
        length{A}(cs) + length{A}(resultant.combinationLeft{A}(add, zero, neg,
            mul, one, b, u0, ds,
      resultant.power{A}(zero, one,
          sylvesterRow.indexDifference(length{A}(cs) + length{A}(ds),
          succ(l)))))
      rw [sylvesterRow.indexSum.value, clLength]
      arith
    have entry := sylvesterBlockMatrix.vector_entry at A, add, zero, neg, mul,
      one, a, b, resultant.combinationLeft{A}(add, zero, neg, mul, one, b, u0,
          ds,
      resultant.power{A}(zero, one,
          sylvesterRow.indexDifference(length{A}(cs) + length{A}(ds),
          succ(l)))),
      resultant.combinationRight{A}(add, zero, neg, mul, one, a, b, u0, v0,
      cs, ds, resultant.power{A}(zero, one,
          sylvesterRow.indexDifference(length{A}(cs) + length{A}(ds),
          succ(l)))), cs, ds, k,
          sylvesterRow.indexDifference(length{A}(cs) + length{A}(ds), succ(k))
      with ring, left, right, balance, column, degree
    unfold rowVectorEntry at entry
    rw [clLength, crLength] at entry
    have commute : length{A}(ds) + length{A}(cs) = length{A}(cs) + length{A}(ds)
      arith
    rw commute at entry
    rw [entry, ← combEq]
    have power := resultant.power.coefficient at A, add, zero, neg, mul, one,
      sylvesterRow.indexDifference(length{A}(cs) + length{A}(ds), succ(l)),
          sylvesterRow.indexDifference(length{A}(cs) + length{A}(ds),
          succ(k)) with ring
    rw power
    have alternatives : l = k ∨ l ≠ k by tauto
    rcases alternatives with same | different
    . rw same
      have reflexiveT : sylvesterRow.indexDifference(length{A}(cs) +
          length{A}(ds),
          succ(k)) = sylvesterRow.indexDifference(length{A}(cs) +
          length{A}(ds), succ(k)) by rfl
      have reflexiveK : k = k by rfl
      have leftValue := singleValue.same at A, zero, one,
          sylvesterRow.indexDifference(length{A}(cs) + length{A}(ds), succ(k)),
        sylvesterRow.indexDifference(length{A}(cs) + length{A}(ds),
            succ(k)) with zeroIn, oneIn, reflexiveT
      have rightValue := singleValue.same at A, zero, one, k, k
        with zeroIn, oneIn, reflexiveK
      rw [leftValue, rightValue]
      rfl
    . have differentT : sylvesterRow.indexDifference(length{A}(cs) +
        length{A}(ds),
        succ(k)) ≠ sylvesterRow.indexDifference(length{A}(cs) + length{A}(ds),
        succ(l))
        intro sameT
        apply different
        rw sameT at kCancel
        arith
      have leftValue := singleValue.other at A, zero, one,
          sylvesterRow.indexDifference(length{A}(cs) + length{A}(ds), succ(l)),
        sylvesterRow.indexDifference(length{A}(cs) + length{A}(ds),
            succ(k)) with zeroIn, oneIn, differentT
      have rightValue := singleValue.other at A, zero, one, k, l
        with zeroIn, oneIn, different
      rw [leftValue, rightValue]
      rfl
  have nonzero := sylvesterBlockMatrix.det_nonzero_of_inverse at A, add, zero,
    neg, mul, one, a, b, cs, ds, length{A}(ds), length{A}(cs) + length{A}(ds),
    resultant.inverseMatrix(A, add, zero, neg, mul, one, a, b, u0, v0, cs, ds)
    with field, left, right, matrixW, inverse
  unfold resultant
  unfold sylvesterMatrix
  exact nonzero

theorem resultant.zero_iff_common_factor (cs ds : List(A))
  shows resultant(R, a, cs, b, ds) = R[0] ↔
    ∃ g ∈ R, g ≠ R[0] ∧ ∃ gs, List(A, gs) ∧ gs ≠ [] ∧
      HornerDivides(A, add, zero, neg, mul, one, g, gs, a, cs) ∧
      HornerDivides(A, add, zero, neg, mul, one, g, gs, b, ds)
proof
  constructor
  . intro vanishes
    by_contra absent
    have noFactor : ∀ g ∈ R, g ≠ R[0] → ∀ gs, List(A, gs) → gs ≠ [] →
        ¬(HornerDivides(A, add, zero, neg, mul, one, g, gs, a, cs) ∧
          HornerDivides(A, add, zero, neg, mul, one, g, gs, b, ds))
      intros g gIn gNonzero gs gsList gsNonempty both
      apply absent
      refine ⟨g, gIn, gNonzero, gs, gsList, gsNonempty, both.left, both.right⟩
    have coprime := HornerCoprime.of_no_common_factor at A, add, zero, neg,
      mul, one, a, b, cs, ds with field, left, right, leftNonzero, noFactor
    have nonzero := resultant.nonzero_of_coprime at A, add, zero, neg, mul,
      one, a, b, cs, ds with field, left, right, leftNonzero, rightNonzero,
      coprime
    exact nonzero with vanishes
  . intro factor
    obtain ⟨g, gIn, gNonzero, gs, gsList, gsNonempty, dividesLeft,
      dividesRight⟩ := factor
    exact resultant.eq_zero_of_common_factor at A, add, zero, neg, mul, one,
      a, b, g, cs, ds, gs with field, left, right, leftNonzero, rightNonzero,
      gIn, gNonzero, gsList, gsNonempty, dividesLeft, dividesRight

theorem resultant.zero_iff_not_coprime (cs ds : List(A))
  shows resultant(R, a, cs, b, ds) = R[0] ↔
    ¬HornerCoprime(A, add, zero, neg, mul, one, a, cs, b, ds)
proof
  constructor
  . intro vanishes
    intro coprime
    have nonzero := resultant.nonzero_of_coprime at A, add, zero, neg, mul,
      one, a, b, cs, ds with field, left, right, leftNonzero, rightNonzero,
      coprime
    exact nonzero with vanishes
  . intro notCoprime
    have factor := HornerCoprime.common_factor_of_not at A, add, zero, neg,
      mul, one, a, b, cs, ds with field, left, right, leftNonzero, notCoprime
    obtain ⟨g, gIn, gNonzero, gs, gsList, gsNonempty, dividesLeft,
      dividesRight⟩ := factor
    exact resultant.eq_zero_of_common_factor at A, add, zero, neg, mul, one,
      a, b, g, cs, ds, gs with field, left, right, leftNonzero, rightNonzero,
      gIn, gNonzero, gsList, gsNonempty, dividesLeft, dividesRight

theorem resultant.nonzero_iff_coprime (cs ds : List(A))
  shows resultant(R, a, cs, b, ds) ≠ R[0] ↔
    HornerCoprime(A, add, zero, neg, mul, one, a, cs, b, ds)
proof
  have rule := resultant.zero_iff_not_coprime at A, add, zero, neg, mul, one,
    a, b, cs, ds with field, left, right, leftNonzero, rightNonzero
  constructor
  . intro nonzero
    by_contra notCoprime
    have vanishes := rule.backward with notCoprime
    exact nonzero with vanishes
  . intro coprime
    intro vanishes
    have notCoprime := rule.forward with vanishes
    exact notCoprime with coprime

theorem resultant.zero_iff_gcd_degree (cs ds : List(A))
  shows resultant(R, a, cs, b, ds) = R[0] ↔
    hornerGcdLower{A}(add, zero, neg, mul, one, a, b, cs, ds) ≠ []
proof
  have rule := resultant.zero_iff_not_coprime at A, add, zero, neg, mul, one,
    a, b, cs, ds with field, left, right, leftNonzero, rightNonzero
  have constant := HornerCoprime.iff_gcd_constant at A, add, zero, neg, mul,
    one, a, b, cs, ds with field, left, right
  have gNonzero := hornerGcd.nonzero_of_left at A, add, zero, neg, mul, one,
    a, b, cs, ds with field, left, right, leftNonzero
  constructor
  . intro vanishes
    have notCoprime := rule.forward with vanishes
    intro isNil
    have coprime := constant.backward with ⟨gNonzero, isNil⟩
    exact notCoprime with coprime
  . intro nonempty
    apply rule.backward
    intro coprime
    have pair := constant.forward with coprime
    exact nonempty with pair.right

end Fields
