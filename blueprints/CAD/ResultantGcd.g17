-- The resultant over a field vanishes exactly when the two pairs have a
-- common factor of positive degree, that is, when they are not coprime,
-- that is, when their gcd has positive degree.
-- Part of the CAD blueprint.
-- Planned home: Algebra/Polynomial/ResultantGcd.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module CAD.ResultantGcd
import CAD.Resultant
import CAD.HornerGcd

section Fields
variable (A add zero neg mul one a b : Set)
notation ring R := (A, add, zero, neg, mul, one)
hypothesis field : IsField(R)
hypothesis left : a ∈ R
hypothesis right : b ∈ R
hypothesis leftNonzero : a ≠ R[0]
hypothesis rightNonzero : b ≠ R[0]

theorem resultant.zero_iff_common_factor (cs ds : List(A))
  shows resultant(R, a, cs, b, ds) = R[0] ↔
    (∃ g ∈ R, g ≠ R[0] ∧ ∃ gs, List(A, gs) ∧ gs ≠ [] ∧
      HornerDivides(A, add, zero, neg, mul, one, g, gs, a, cs) ∧
      HornerDivides(A, add, zero, neg, mul, one, g, gs, b, ds))
proof
  sorry

theorem resultant.zero_iff_not_coprime (cs ds : List(A))
  shows resultant(R, a, cs, b, ds) = R[0] ↔
    ¬HornerCoprime(A, add, zero, neg, mul, one, a, cs, b, ds)
proof
  sorry

theorem resultant.nonzero_iff_coprime (cs ds : List(A))
  shows resultant(R, a, cs, b, ds) ≠ R[0] ↔
    HornerCoprime(A, add, zero, neg, mul, one, a, cs, b, ds)
proof
  sorry

theorem resultant.zero_iff_gcd_degree (cs ds : List(A))
  shows resultant(R, a, cs, b, ds) = R[0] ↔
    hornerGcdLower{A}(add, zero, neg, mul, one, a, b, cs, ds) ≠ []
proof
  sorry

end Fields
