-- Squarefree real polynomials and the squarefree part: a real pair is
-- squarefree when it is coprime to its derivative; its roots are then
-- simple. The squarefree part, the quotient by the gcd with the
-- derivative brought to normal form, is squarefree and has the same real
-- roots.
-- Part of the CAD blueprint.
-- Planned home: Real/Analysis/PolynomialSquarefree.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module CAD.RealSquarefree
import CAD.HornerGcd
import CAD.RealHorner

predicate RealSquarefree (leading cs : Set) :=
  HornerSquarefree(ℝ, realAdd, realZero, realNeg, realMul, realOne, leading, cs)

predicate RealCoprime (a cs b ds : Set) :=
  HornerCoprime(ℝ, realAdd, realZero, realNeg, realMul, realOne, a, cs, b, ds)

-- The real pieces form a field.
theorem RealSquarefree.field
  shows IsField(ℝ, realAdd, realZero, realNeg, realMul, realOne)
proof
  exact IsFieldWithInverse.is_field with reals.field

-- An index at or beyond the length reads the default.
theorem RealSquarefree.coefficient_beyond (A z : Set) (xs : List(A)) (n : Nat)
  requires beyond : length{A}(xs) ≤ n
  shows listCoefficient{A}(z, xs, n) = z
proof
  induction xs generalizing n
  | List.nil =>
    intros n nNat beyond
    exact listCoefficient.nil at A, z, n
  | List.cons(x, tail) using ih =>
    intros n nNat beyond
    have xIn : x ∈ A by assumption
    rw length.cons at beyond
    have shape := natural.zero_or_successor at n with nNat
    cases shape with zero | successor
    . rw zero at beyond
      exfalso
      arith
    . obtain ⟨m, mNat, equal⟩ := successor
      rw equal at beyond
      rw equal
      rw listCoefficient.succ at A, z, x, tail, m with xIn
      have le : length{A}(tail) ≤ m by arith
      exact ih with m, mNat, le

-- The coefficients of a full list read with leading coefficient zero are
-- the entries of the list, zero beyond its length.
theorem RealSquarefree.coefficient_zero_leading (A zero : Set) (rs : List(A))
  (k : Nat)
  requires zeroIn : zero ∈ A
  shows hornerCoefficient{A}(zero, zero, rs, k) =
    listCoefficient{A}(zero, rs, k)
proof
  have kNat : Nat(k) by typecheck
  have lengthNat : Nat(length{A}(rs)) by typecheck
  have split := Less.trichotomy at k, length{A}(rs) with kNat, lengthNat
  rcases split with below | same | above
  . exact hornerCoefficient.below at A, zero, zero, rs, k with below
  . rw same
    rw hornerCoefficient.leading at A, zero, zero, rs with zeroIn
    have le : length{A}(rs) ≤ length{A}(rs) by arith
    symm
    exact RealSquarefree.coefficient_beyond at A, zero, rs, length{A}(rs)
      with le
  . rw hornerCoefficient.above at A, zero, zero, rs, k with above
    have le : length{A}(rs) ≤ k by arith
    symm
    exact RealSquarefree.coefficient_beyond at A, zero, rs, k with le

-- Trimming a full list keeps its polynomial.
theorem RealSquarefree.trim_poly (rs : List(ℝ))
  shows hornerPoly{ℝ}(realAdd, realZero, realNeg, realMul, realOne,
      hornerTrimLeading{ℝ}(realZero, rs), hornerTrimLower{ℝ}(realZero, rs)) =
    hornerPoly{ℝ}(realAdd, realZero, realNeg, realMul, realOne, realZero, rs)
proof
  have zeroIn : realZero ∈ ℝ := realZero.real
  have trimIn := hornerTrimLeading.mem at ℝ, realZero, rs with zeroIn
  have lowerList := hornerTrimLower.list at ℝ, realZero, rs
  have iff := hornerPoly.eq_iff at ℝ, realAdd, realZero, realNeg, realMul,
    realOne, hornerTrimLeading{ℝ}(realZero, rs), realZero,
    hornerTrimLower{ℝ}(realZero, rs), rs with reals.comm_ring, trimIn, zeroIn
  apply iff.backward
  intros k kNat
  rw hornerTrim.coefficient
  symm
  exact RealSquarefree.coefficient_zero_leading at ℝ, realZero, rs, k
    with zeroIn

-- Real univariate polynomials: the pair as an element of the polynomial
-- ring, the formal derivative, evaluation at a point, and the elements
-- that are pairs with leading coefficient zero.
def RealSquarefree.poly (a cs : Set) : Set :=
  hornerPoly{ℝ}(realAdd, realZero, realNeg, realMul, realOne, a, cs)
def RealSquarefree.derivation : Set :=
  partialDerivative(realRing, oneVariable, 0)
def RealSquarefree.evaluation (X : Set) : Set :=
  polynomialAt(oneVariable, ℝ, realAdd, realZero, realNeg, realMul, realOne,
    constantFunction(oneVariable, ℝ, X))
predicate RealSquarefree.IsPair (p : Set) :=
  ∃ cs, List(ℝ, cs) ∧ p = RealSquarefree.poly(realZero, cs)

-- The lower coefficients of (X − r)^k.
def RealSquarefree.linearPower (X : Set, k : Nat) → Set
  | X, zero => []
  | X, succ(k) => hornerMulList{ℝ}(realAdd, realZero, realMul, realOne,
      realOne, realNeg(X) :: [], RealSquarefree.linearPower(X, k))

theorem RealSquarefree.linearPower.zero (X : Set)
  shows RealSquarefree.linearPower(X, 0) = []
proof
  rw RealSquarefree.linearPower

theorem RealSquarefree.linearPower.succ (X : Set, k : Nat)
  shows RealSquarefree.linearPower(X, succ(k)) =
    hornerMulList{ℝ}(realAdd, realZero, realMul, realOne, realOne,
      realNeg(X) :: [], RealSquarefree.linearPower(X, k))
proof
  rw RealSquarefree.linearPower

-- The gcd of a pair with its derivative pair, and the lower coefficients
-- of the k-th power of a pair.
def RealSquarefree.gcdLeading (a cs : Set) : Set :=
  hornerGcdLeading{ℝ}(realAdd, realZero, realNeg, realMul, realOne, a,
    hornerDerivativeLeading{ℝ}(realAdd, realZero, realOne, realMul, a, cs),
    cs, hornerDerivativeList{ℝ}(realAdd, realZero, realOne, realMul, cs))
def RealSquarefree.gcdLower (a cs : Set) : Set :=
  hornerGcdLower{ℝ}(realAdd, realZero, realNeg, realMul, realOne, a,
    hornerDerivativeLeading{ℝ}(realAdd, realZero, realOne, realMul, a, cs),
    cs, hornerDerivativeList{ℝ}(realAdd, realZero, realOne, realMul, cs))
def RealSquarefree.pairPower (f fs : Set, k : Nat) → Set
  | f, fs, zero => []
  | f, fs, succ(k) => hornerMulList{ℝ}(realAdd, realZero, realMul, f,
      realPow(f, k), fs, RealSquarefree.pairPower(f, fs, k))

theorem RealSquarefree.pairPower.zero (f fs : Set)
  shows RealSquarefree.pairPower(f, fs, 0) = []
proof
  rw RealSquarefree.pairPower

theorem RealSquarefree.pairPower.succ (f fs : Set, k : Nat)
  shows RealSquarefree.pairPower(f, fs, succ(k)) =
    hornerMulList{ℝ}(realAdd, realZero, realMul, f, realPow(f, k), fs,
      RealSquarefree.pairPower(f, fs, k))
proof
  rw RealSquarefree.pairPower

-- A natural is at most its product with a successor.
theorem RealSquarefree.le_mul_succ (m n : Nat)
  shows m ≤ m * succ(n)
proof
  have expand : m * succ(n) = m * n + m by ring
  rw expand
  arith

theorem RealSquarefree.negOf
  shows Ring.neg(realRing) = realNeg
proof
  simp [realRing, Ring.mk.neg]

theorem RealSquarefree.oneOf
  shows Ring.one(realRing) = realOne
proof
  simp [realRing, Ring.mk.one]

theorem RealSquarefree.index
  shows 0 ∈ oneVariable
proof
  unfold oneVariable
  typecheck

section Pieces
notation ring F := (ℝ, realAdd, realZero, realNeg, realMul, realOne)
notation ring P := F[oneVariable]

theorem RealSquarefree.ring_P
  shows IsCommRing(P)
proof
  exact polynomials.comm_ring at oneVariable, ℝ, realAdd, realZero, realNeg,
    realMul, realOne with reals.comm_ring

theorem RealSquarefree.poly.member (a : Set) (cs : List(ℝ))
  requires aIn : a ∈ ℝ
  shows RealSquarefree.poly(a, cs) ∈ P
proof
  unfold RealSquarefree.poly
  exact hornerPoly.member at ℝ, realAdd, realZero, realNeg, realMul, realOne,
    a, cs with reals.comm_ring, aIn

theorem RealSquarefree.poly.full (a : Set) (cs : List(ℝ))
  requires aIn : a ∈ ℝ
  shows RealSquarefree.poly(realZero, hornerFullList{ℝ}(a, cs)) =
    RealSquarefree.poly(a, cs)
proof
  unfold RealSquarefree.poly
  exact hornerPoly.full_list at ℝ, realAdd, realZero, realNeg, realMul,
    realOne, a, cs with reals.comm_ring, aIn

theorem RealSquarefree.poly.constant (a : Set)
  requires aIn : a ∈ ℝ
  shows RealSquarefree.poly(a, []) = polynomialConstant(oneVariable, F, a)
proof
  unfold RealSquarefree.poly
  exact hornerPoly.constant at ℝ, realAdd, realZero, realNeg, realMul,
    realOne, a with reals.comm_ring, aIn

theorem RealSquarefree.poly.zero_constant
  shows polynomialConstant(oneVariable, F, realZero) = P[0]
proof
  have zeroIn : realZero ∈ ℝ := realZero.real
  rw polynomialConstant.zero at oneVariable, ℝ, realZero with zeroIn
  rfl

theorem RealSquarefree.poly.one_constant
  shows polynomialConstant(oneVariable, F, realOne) = P[1]
proof
  rfl

theorem RealSquarefree.poly.mul (a b : Set) (cs ds : List(ℝ))
  requires aIn : a ∈ ℝ
  requires bIn : b ∈ ℝ
  shows RealSquarefree.poly(F[a * b],
      hornerMulList{ℝ}(realAdd, realZero, realMul, a, b, cs, ds)) =
    P[RealSquarefree.poly(a, cs) * RealSquarefree.poly(b, ds)]
proof
  unfold RealSquarefree.poly
  exact hornerPoly.mul at ℝ, realAdd, realZero, realNeg, realMul, realOne,
    a, b, cs, ds with reals.comm_ring, aIn, bIn

theorem RealSquarefree.poly.add (a b : Set) (cs ds : List(ℝ))
  requires aIn : a ∈ ℝ
  requires bIn : b ∈ ℝ
  requires sameLength : length{ℝ}(cs) = length{ℝ}(ds)
  shows RealSquarefree.poly(F[a + b],
      hornerAdd{ℝ}(realAdd, realZero, cs, ds)) =
    P[RealSquarefree.poly(a, cs) + RealSquarefree.poly(b, ds)]
proof
  unfold RealSquarefree.poly
  exact hornerPoly.add at ℝ, realAdd, realZero, realNeg, realMul, realOne,
    a, b, cs, ds with reals.comm_ring, aIn, bIn, sameLength

theorem RealSquarefree.poly.neg (a : Set) (cs : List(ℝ))
  requires aIn : a ∈ ℝ
  shows RealSquarefree.poly(realNeg(a), hornerNeg{ℝ}(realNeg, cs)) =
    P[-RealSquarefree.poly(a, cs)]
proof
  unfold RealSquarefree.poly
  exact hornerPoly.neg at ℝ, realAdd, realZero, realNeg, realMul, realOne,
    a, cs with reals.comm_ring, aIn

theorem RealSquarefree.poly.value (a X : Set) (cs : List(ℝ))
  requires aIn : a ∈ ℝ
  requires realX : X ∈ ℝ
  shows RealSquarefree.evaluation(X)(RealSquarefree.poly(a, cs)) =
    hornerAt{ℝ}(realAdd, realMul, a, X, cs)
proof
  unfold RealSquarefree.evaluation
  unfold RealSquarefree.poly
  exact hornerPoly.value at ℝ, realAdd, realZero, realNeg, realMul, realOne,
    a, X, cs with reals.comm_ring, aIn, realX

theorem RealSquarefree.evaluation.hom (X : Set)
  requires realX : X ∈ ℝ
  shows IsRingHom(RealSquarefree.evaluation(X), P, F)
proof
  have assignment := constantFunction.function at oneVariable, ℝ, X with realX
  unfold RealSquarefree.evaluation
  exact polynomialAt.hom at oneVariable, ℝ, realAdd, realZero, realNeg,
    realMul, realOne, constantFunction(oneVariable, ℝ, X) with
    reals.comm_ring, assignment

theorem RealSquarefree.evaluation.mul (X p q : Set)
  requires realX : X ∈ ℝ
  requires pIn : p ∈ P
  requires qIn : q ∈ P
  shows RealSquarefree.evaluation(X)(P[p * q]) =
    F[RealSquarefree.evaluation(X)(p) * RealSquarefree.evaluation(X)(q)]
proof
  have hom := RealSquarefree.evaluation.hom at X with realX
  exact IsRingHom.mul with hom, pIn, qIn

theorem RealSquarefree.evaluation.add (X p q : Set)
  requires realX : X ∈ ℝ
  requires pIn : p ∈ P
  requires qIn : q ∈ P
  shows RealSquarefree.evaluation(X)(P[p + q]) =
    F[RealSquarefree.evaluation(X)(p) + RealSquarefree.evaluation(X)(q)]
proof
  have hom := RealSquarefree.evaluation.hom at X with realX
  exact IsRingHom.add with hom, pIn, qIn

theorem RealSquarefree.evaluation.constant (X a : Set)
  requires realX : X ∈ ℝ
  requires aIn : a ∈ ℝ
  shows RealSquarefree.evaluation(X)(polynomialConstant(oneVariable, F, a)) = a
proof
  have assignment := constantFunction.function at oneVariable, ℝ, X with realX
  unfold RealSquarefree.evaluation
  exact polynomialAt.constant at oneVariable, ℝ, realAdd, realZero, realNeg,
    realMul, realOne, constantFunction(oneVariable, ℝ, X), a with
    reals.comm_ring, assignment, aIn

theorem RealSquarefree.evaluation.real (X p : Set)
  requires realX : X ∈ ℝ
  requires pIn : p ∈ P
  shows RealSquarefree.evaluation(X)(p) ∈ ℝ
proof
  have hom := RealSquarefree.evaluation.hom at X with realX
  have function := IsRingHom.function with hom
  exact FunctionBetween.apply_closed with function, pIn

-- The derivative of a pair is the derivative pair, and the product rule.
theorem RealSquarefree.derivation.poly (a : Set) (cs : List(ℝ))
  requires aIn : a ∈ ℝ
  shows RealSquarefree.derivation(RealSquarefree.poly(a, cs)) =
    RealSquarefree.poly(
      hornerDerivativeLeading{ℝ}(realAdd, realZero, realOne, realMul, a, cs),
      hornerDerivativeList{ℝ}(realAdd, realZero, realOne, realMul, cs))
proof
  have index := RealSquarefree.index
  have csList : List(ℝ, cs) by typecheck
  have carrier := realRing.carrierOf
  have aInCarrier : a ∈ Ring.carrier(realRing)
    rw carrier
    exact aIn
  have csInCarrier : List(Ring.carrier(realRing), cs)
    rw carrier
    exact csList
  unfold RealSquarefree.derivation
  have bridge := hornerPolynomial.derivative at realRing, a, oneVariable, 0, cs
    with realRing.comm_ring, aInCarrier, index, csInCarrier
  rw hornerPolynomial.graph at bridge
  rw hornerPolynomial.graph at bridge
  unfold derivativeLeading at bridge
  unfold derivativeList at bridge
  rw [realRing.carrierOf, realRing.addOf, realRing.zeroOf] at bridge
  rw [RealSquarefree.negOf, realRing.mulOf, RealSquarefree.oneOf] at bridge
  unfold RealSquarefree.poly
  unfold hornerPoly
  exact bridge

theorem RealSquarefree.derivation.mul (p q : Set)
  requires pIn : p ∈ P
  requires qIn : q ∈ P
  shows RealSquarefree.derivation(P[p * q]) =
    P[RealSquarefree.derivation(p) * q + p * RealSquarefree.derivation(q)]
proof
  have index := RealSquarefree.index
  have carrier := polynomialRing.carrierOf at realRing, oneVariable
  rw [realRing.carrierOf, realRing.zeroOf] at carrier
  have pInCarrier : p ∈ Ring.carrier(polynomialRing(realRing, oneVariable))
    rw carrier
    exact pIn
  have qInCarrier : q ∈ Ring.carrier(polynomialRing(realRing, oneVariable))
    rw carrier
    exact qIn
  have polynomials := polynomialRing.comm_ring at realRing, oneVariable with
    realRing.comm_ring
  unfold RealSquarefree.derivation
  have rule := partialDerivative.mul at realRing, oneVariable, 0, p, q with
    realRing.comm_ring, polynomials, index, pInCarrier, qInCarrier
  rw [polynomialRing.mulOf, polynomialRing.addOf] at rule
  rw [realRing.carrierOf, realRing.addOf, realRing.zeroOf] at rule
  rw [RealSquarefree.negOf, realRing.mulOf, RealSquarefree.oneOf] at rule
  exact rule

theorem RealSquarefree.derivation.member (p : Set)
  requires pIn : p ∈ P
  shows RealSquarefree.derivation(p) ∈ P
proof
  have index := RealSquarefree.index
  have carrier := polynomialRing.carrierOf at realRing, oneVariable
  rw [realRing.carrierOf, realRing.zeroOf] at carrier
  have pInCarrier : p ∈ Ring.carrier(polynomialRing(realRing, oneVariable))
    rw carrier
    exact pIn
  have polynomials := polynomialRing.comm_ring at realRing, oneVariable with
    realRing.comm_ring
  unfold RealSquarefree.derivation
  have closed := partialDerivative.map_mem at realRing, oneVariable, 0, p with
    realRing.comm_ring, polynomials, index, pInCarrier
  rw carrier at closed
  exact closed

-- The linear factor X − r: its value at r is zero, its derivative is 1.
theorem RealSquarefree.linear.value (X : Set)
  requires realX : X ∈ ℝ
  shows hornerAt{ℝ}(realAdd, realMul, realOne, X, realNeg(X) :: []) = realZero
proof
  have typedX : Real(X) by exact realX
  have negIn : realNeg(X) ∈ ℝ by typecheck
  rw hornerAt.cons at ℝ, realAdd, realMul, realOne, X, realNeg(X), []
    with negIn
  rw hornerAt.nil
  ring

theorem RealSquarefree.linear.derivation (X : Set)
  requires realX : X ∈ ℝ
  shows RealSquarefree.derivation(
    RealSquarefree.poly(realOne, realNeg(X) :: [])) = P[1]
proof
  have typedX : Real(X) by exact realX
  have negIn : realNeg(X) ∈ ℝ by typecheck
  have oneIn : realOne ∈ ℝ := realOne.real
  have bridge := RealSquarefree.derivation.poly at realOne, realNeg(X) :: []
    with oneIn
  rw bridge
  have nilList : List(ℝ, []) by typecheck
  rw hornerDerivativeList.cons at ℝ, realAdd, realZero, realOne, realMul,
    realNeg(X), [] with nilList
  rw hornerIndexScale.nil
  unfold hornerDerivativeLeading
  have lengthOne := length.cons at ℝ, realNeg(X), [] with negIn
  rw [lengthOne, length.nil, ringNat.succ, ringNat.zero]
  have same : call2(realMul, call2(realAdd, realZero, realOne), realOne) =
    realOne by ring
  rw same
  rw RealSquarefree.poly.constant at realOne with oneIn
  exact RealSquarefree.poly.one_constant

-- Pairs: the elements that are some list with leading coefficient zero,
-- closed under the ring operations and the derivative.
theorem RealSquarefree.IsPair.member (p : Set)
  requires pair : RealSquarefree.IsPair(p)
  shows p ∈ P
proof
  obtain ⟨cs, csList, equal⟩ := pair
  have zeroIn : realZero ∈ ℝ := realZero.real
  rw equal
  exact RealSquarefree.poly.member at realZero, cs with zeroIn

theorem RealSquarefree.IsPair.of_poly (a : Set) (cs : List(ℝ))
  requires aIn : a ∈ ℝ
  shows RealSquarefree.IsPair(RealSquarefree.poly(a, cs))
proof
  have fullList := hornerFullList.list at ℝ, a, cs with aIn
  have full := RealSquarefree.poly.full at a, cs with aIn
  refine ⟨hornerFullList{ℝ}(a, cs), fullList, ?_⟩
  symm
  exact full

theorem RealSquarefree.IsPair.constant (a : Set)
  requires aIn : a ∈ ℝ
  shows RealSquarefree.IsPair(polynomialConstant(oneVariable, F, a))
proof
  rw ← RealSquarefree.poly.constant at a with aIn
  exact RealSquarefree.IsPair.of_poly at a, [] with aIn

theorem RealSquarefree.pad (cs : List(ℝ)) (k : Nat)
  shows ∃ ds, List(ℝ, ds) ∧ length{ℝ}(ds) = length{ℝ}(cs) + k ∧
    RealSquarefree.poly(realZero, ds) = RealSquarefree.poly(realZero, cs)
proof
  have zeroIn : realZero ∈ ℝ := realZero.real
  induction k
  | zero =>
    have csList : List(ℝ, cs) by typecheck
    have same : length{ℝ}(cs) = length{ℝ}(cs) + 0 by arith
    exact ⟨cs, csList, same, rfl⟩
  | succ(j) using ih =>
    obtain ⟨ds, dsList, dsLength, dsPoly⟩ := ih
    have fullList := hornerFullList.list at ℝ, realZero, ds with zeroIn
    have fullLength := hornerFullList.length at ℝ, realZero, ds
    have full := RealSquarefree.poly.full at realZero, ds with zeroIn
    refine ⟨hornerFullList{ℝ}(realZero, ds), fullList, ?_, ?_⟩
    . rw [fullLength, dsLength]
      arith
    . rw [full, dsPoly]
      rfl

theorem RealSquarefree.IsPair.add (p q : Set)
  requires pPair : RealSquarefree.IsPair(p)
  requires qPair : RealSquarefree.IsPair(q)
  shows RealSquarefree.IsPair(P[p + q])
proof
  have zeroIn : realZero ∈ ℝ := realZero.real
  obtain ⟨cs, csList, pEqual⟩ := pPair
  obtain ⟨ds, dsList, qEqual⟩ := qPair
  obtain ⟨cs1, cs1List, cs1Length, cs1Poly⟩ :=
    RealSquarefree.pad at cs, length{ℝ}(ds) with csList
  obtain ⟨ds1, ds1List, ds1Length, ds1Poly⟩ :=
    RealSquarefree.pad at ds, length{ℝ}(cs) with dsList
  have sameLength : length{ℝ}(cs1) = length{ℝ}(ds1)
    rw [cs1Length, ds1Length]
    arith
  have sum := RealSquarefree.poly.add at realZero, realZero, cs1, ds1 with
    zeroIn, zeroIn, sameLength
  have zeroSum : F[realZero + realZero] = realZero by ring
  rw [zeroSum, cs1Poly, ds1Poly] at sum
  have sumList := hornerAdd.data at ℝ, realAdd, realZero, realNeg, realMul,
    realOne, cs1, ds1 with reals.comm_ring
  refine ⟨hornerAdd{ℝ}(realAdd, realZero, cs1, ds1), sumList.left, ?_⟩
  rw [pEqual, qEqual, sum]
  rfl

theorem RealSquarefree.IsPair.neg (p : Set)
  requires pPair : RealSquarefree.IsPair(p)
  shows RealSquarefree.IsPair(P[-p])
proof
  have zeroIn : realZero ∈ ℝ := realZero.real
  obtain ⟨cs, csList, pEqual⟩ := pPair
  have negated := RealSquarefree.poly.neg at realZero, cs with zeroIn
  have zeroNeg : realNeg(realZero) = realZero by ring
  rw zeroNeg at negated
  have negList := hornerNeg.data at ℝ, realAdd, realZero, realNeg, realMul,
    realOne, cs with reals.comm_ring
  refine ⟨hornerNeg{ℝ}(realNeg, cs), negList.left, ?_⟩
  rw [pEqual, negated]
  rfl

theorem RealSquarefree.IsPair.mul (p q : Set)
  requires pPair : RealSquarefree.IsPair(p)
  requires qPair : RealSquarefree.IsPair(q)
  shows RealSquarefree.IsPair(P[p * q])
proof
  have zeroIn : realZero ∈ ℝ := realZero.real
  obtain ⟨cs, csList, pEqual⟩ := pPair
  obtain ⟨ds, dsList, qEqual⟩ := qPair
  have product := RealSquarefree.poly.mul at realZero, realZero, cs, ds with
    zeroIn, zeroIn
  have zeroProduct : F[realZero * realZero] = realZero by ring
  rw zeroProduct at product
  have productList := hornerMulList.data at ℝ, realAdd, realZero, realNeg,
    realMul, realOne, realZero, realZero, cs, ds with reals.comm_ring,
    zeroIn, zeroIn
  refine ⟨hornerMulList{ℝ}(realAdd, realZero, realMul, realZero, realZero,
    cs, ds), productList.left, ?_⟩
  rw [pEqual, qEqual, product]
  rfl

theorem RealSquarefree.IsPair.derivation (p : Set)
  requires pPair : RealSquarefree.IsPair(p)
  shows RealSquarefree.IsPair(RealSquarefree.derivation(p))
proof
  have zeroIn : realZero ∈ ℝ := realZero.real
  obtain ⟨cs, csList, pEqual⟩ := pPair
  have bridge := RealSquarefree.derivation.poly at realZero, cs with zeroIn
  have leadingIn := hornerDerivativeLeading.closed at ℝ, realAdd, realZero,
    realNeg, realMul, realOne, realZero, cs with reals.comm_ring, zeroIn
  have listData := hornerDerivativeList.data at ℝ, realAdd, realZero, realNeg,
    realMul, realOne, realZero, cs with reals.comm_ring, zeroIn
  rw [pEqual, bridge]
  exact RealSquarefree.IsPair.of_poly at
    hornerDerivativeLeading{ℝ}(realAdd, realZero, realOne, realMul, realZero,
      cs),
    hornerDerivativeList{ℝ}(realAdd, realZero, realOne, realMul, cs) with
    leadingIn, listData.left

-- A pair killed by the linear factor X − r is zero.
theorem RealSquarefree.IsPair.cancel (X p : Set)
  requires realX : X ∈ ℝ
  requires pPair : RealSquarefree.IsPair(p)
  requires killed : P[RealSquarefree.poly(realOne, realNeg(X) :: []) * p] = P[0]
  shows p = P[0]
proof
  have typedX : Real(X) by exact realX
  have zeroIn : realZero ∈ ℝ := realZero.real
  have oneIn : realOne ∈ ℝ := realOne.real
  have index := RealSquarefree.index
  obtain ⟨gs, gsList, pEqual⟩ := pPair
  rw pEqual at killed
  rw pEqual
  have normal := hornerPoly.normal at ℝ, realAdd, realZero, realNeg, realMul,
    realOne, realZero, gs with reals.comm_ring, zeroIn
  have fullList := hornerFullList.list at ℝ, realZero, gs with zeroIn
  have trim : normalLeading{ℝ}(realZero, realZero, gs) ≠ realZero ∨
      (normalLeading{ℝ}(realZero, realZero, gs) = realZero ∧
        normalLower{ℝ}(realZero, realZero, gs) = [])
    unfold normalLeading
    unfold normalLower
    exact hornerTrim.normal at ℝ, realZero, hornerFullList{ℝ}(realZero, gs)
      with fullList
  have leadingIn : normalLeading{ℝ}(realZero, realZero, gs) ∈ ℝ
    unfold normalLeading
    exact hornerTrimLeading.mem at ℝ, realZero, hornerFullList{ℝ}(realZero, gs)
      with zeroIn
  have lowerList : List(ℝ, normalLower{ℝ}(realZero, realZero, gs))
    unfold normalLower
    exact hornerTrimLower.list at ℝ, realZero, hornerFullList{ℝ}(realZero, gs)
      with fullList
  have typedLeading : Real(normalLeading{ℝ}(realZero, realZero, gs)) by
    exact leadingIn
  have normalPoly : RealSquarefree.poly(
      normalLeading{ℝ}(realZero, realZero, gs),
      normalLower{ℝ}(realZero, realZero, gs)) =
      RealSquarefree.poly(realZero, gs)
    unfold RealSquarefree.poly
    exact normal
  cases trim with nonzero | vanishing
  . exfalso
    have product := RealSquarefree.poly.mul at realOne,
      normalLeading{ℝ}(realZero, realZero, gs), realNeg(X) :: [],
      normalLower{ℝ}(realZero, realZero, gs) with oneIn, leadingIn
    rw [normalPoly, killed] at product
    have productIn : F[realOne * normalLeading{ℝ}(realZero, realZero, gs)] ∈ ℝ
      by typecheck
    have productNonzero :
        F[realOne * normalLeading{ℝ}(realZero, realZero, gs)] ≠ realZero
      have same : F[realOne * normalLeading{ℝ}(realZero, realZero, gs)] =
        normalLeading{ℝ}(realZero, realZero, gs) by ring
      rw same
      exact nonzero
    have productList := hornerMulList.data at ℝ, realAdd, realZero, realNeg,
      realMul, realOne, realOne, normalLeading{ℝ}(realZero, realZero, gs),
      realNeg(X) :: [], normalLower{ℝ}(realZero, realZero, gs) with
      reals.comm_ring, oneIn, leadingIn
    have productListed := productList.left
    have nonzeroPoly := polynomialFromHorner.nonzero_of_leading at oneVariable,
      ℝ, realAdd, realZero, realNeg, realMul, realOne, 0,
      F[realOne * normalLeading{ℝ}(realZero, realZero, gs)],
      hornerMulList{ℝ}(realAdd, realZero, realMul, realOne,
        normalLeading{ℝ}(realZero, realZero, gs), realNeg(X) :: [],
        normalLower{ℝ}(realZero, realZero, gs)) with
      reals.comm_ring, index, productIn, productNonzero
    apply nonzeroPoly
    unfold RealSquarefree.poly at product
    unfold hornerPoly at product
    exact product
  . obtain ⟨leadingZero, lowerNil⟩ := vanishing
    rw [leadingZero, lowerNil] at normalPoly
    rw ← normalPoly
    rw RealSquarefree.poly.constant at realZero with zeroIn
    exact RealSquarefree.poly.zero_constant

theorem RealSquarefree.linearPower.data (X : Set) (k : Nat)
  requires realX : X ∈ ℝ
  shows List(ℝ, RealSquarefree.linearPower(X, k)) ∧
    length{ℝ}(RealSquarefree.linearPower(X, k)) = k
proof
  induction k
  | zero =>
    have nilList : List(ℝ, []) by typecheck
    rw RealSquarefree.linearPower.zero
    exact ⟨nilList, length.nil at ℝ⟩
  | succ(j) using ih =>
    have typedX : Real(X) by exact realX
    have oneIn : realOne ∈ ℝ := realOne.real
    have negIn : realNeg(X) ∈ ℝ by typecheck
    have linearList : List(ℝ, realNeg(X) :: []) by typecheck
    have tailList := ih.left
    have tailLength := ih.right
    have data := hornerMulList.data at ℝ, realAdd, realZero, realNeg, realMul,
      realOne, realOne, realOne, realNeg(X) :: [],
      RealSquarefree.linearPower(X, j) with reals.comm_ring, oneIn, oneIn
    rw RealSquarefree.linearPower.succ
    refine ⟨data.left, ?_⟩
    rw data.right
    rw length.cons at ℝ, realNeg(X), [] with negIn
    rw [length.nil, tailLength]
    arith

theorem RealSquarefree.constant_succ (k : Nat)
  shows polynomialConstant(oneVariable, F, realNat(succ(k))) =
    P[polynomialConstant(oneVariable, F, realNat(k)) + 1]
proof
  have kIn : realNat(k) ∈ ℝ := realNat.real at k
  have oneIn : realOne ∈ ℝ := realOne.real
  have step := realNat.succ_add at k
  rw step
  have sum := polynomialConstant.add at oneVariable, ℝ, realAdd, realZero,
    realNeg, realMul, realOne, realNat(k), realOne with reals.comm_ring,
    kIn, oneIn
  rw sum
  have constantPair := RealSquarefree.IsPair.constant at realNat(k) with kIn
  have constantIn := RealSquarefree.IsPair.member with constantPair
  have onePair := RealSquarefree.IsPair.constant at realOne with oneIn
  have oneConstantIn := RealSquarefree.IsPair.member with onePair
  have apply := polynomialAdd.apply at oneVariable, ℝ, realAdd, realZero,
    realNeg, realMul, realOne, polynomialConstant(oneVariable, F, realNat(k)),
    polynomialConstant(oneVariable, F, realOne) with
    reals.comm_ring, constantIn, oneConstantIn
  rw ← apply
  rfl

-- The chain invariant: the cofactor es vanishes at X, and
-- q·e′·(X − r) + c·q·e = e·(X − r)·t.
predicate RealSquarefree.Chain (X t c qs es : Set) :=
  hornerAt{ℝ}(realAdd, realMul, realZero, X, es) = realZero ∧
  P[RealSquarefree.poly(realZero, qs) *
      RealSquarefree.derivation(RealSquarefree.poly(realZero, es)) *
      RealSquarefree.poly(realOne, realNeg(X) :: []) +
    c * RealSquarefree.poly(realZero, qs) * RealSquarefree.poly(realZero, es)] =
  P[RealSquarefree.poly(realZero, es) *
    RealSquarefree.poly(realOne, realNeg(X) :: []) * t]

-- The chain starts at d itself when q·d′ = t·d and d(X) = 0.
theorem RealSquarefree.chain_base (X t g : Set) (qs gs : List(ℝ))
  requires realX : X ∈ ℝ
  requires gIn : g ∈ ℝ
  requires tPair : RealSquarefree.IsPair(t)
  requires gcdRoot : hornerAt{ℝ}(realAdd, realMul, g, X, gs) = realZero
  requires relation : P[RealSquarefree.poly(realZero, qs) *
      RealSquarefree.derivation(RealSquarefree.poly(g, gs))] =
    P[t * RealSquarefree.poly(g, gs)]
  shows ∃ es, List(ℝ, es) ∧
    RealSquarefree.Chain(X, t, polynomialConstant(oneVariable, F, realNat(0)),
      qs, es) ∧
    RealSquarefree.poly(g, gs) = P[RealSquarefree.poly(realZero, es) *
      RealSquarefree.poly(realOne, RealSquarefree.linearPower(X, 0))]
proof
  have typedX : Real(X) by exact realX
  have zeroIn : realZero ∈ ℝ := realZero.real
  have oneIn : realOne ∈ ℝ := realOne.real
  have negIn : realNeg(X) ∈ ℝ by typecheck
  have linearList : List(ℝ, realNeg(X) :: []) by typecheck
  have ringP := RealSquarefree.ring_P
  have qIn := RealSquarefree.poly.member at realZero, qs with zeroIn
  have tIn := RealSquarefree.IsPair.member with tPair
  have dIn := RealSquarefree.poly.member at g, gs with gIn
  have dDerivationIn := RealSquarefree.derivation.member with dIn
  have linearIn := RealSquarefree.poly.member at realOne, realNeg(X) :: []
    with oneIn
  have fullList := hornerFullList.list at ℝ, g, gs with gIn
  have full := RealSquarefree.poly.full at g, gs with gIn
  have fullValue := hornerFullList.value at ℝ, realAdd, realZero, realNeg,
    realMul, realOne, g, X, gs with reals.comm_ring, gIn, realX
  refine ⟨hornerFullList{ℝ}(g, gs), fullList, ?_, ?_⟩
  . unfold RealSquarefree.Chain
    rw [full, fullValue, realNat.zero, RealSquarefree.poly.zero_constant]
    refine ⟨gcdRoot, ?_⟩
    have expand : P[RealSquarefree.poly(realZero, qs) *
        RealSquarefree.derivation(RealSquarefree.poly(g, gs)) *
        RealSquarefree.poly(realOne, realNeg(X) :: []) +
        0 * RealSquarefree.poly(realZero, qs) * RealSquarefree.poly(g, gs)] =
      P[(RealSquarefree.poly(realZero, qs) *
        RealSquarefree.derivation(RealSquarefree.poly(g, gs))) *
        RealSquarefree.poly(realOne, realNeg(X) :: [])] by ring
    rw [expand, relation]
    ring
  . rw [full, RealSquarefree.linearPower.zero]
    rw RealSquarefree.poly.constant at realOne with oneIn
    ring

-- One more linear factor: the cofactor vanishes at X, so it factors, and
-- the relation for the new cofactor follows by canceling X − r.
theorem RealSquarefree.chain_step (X t g : Set) (qs gs es : List(ℝ)) (k : Nat)
  requires realX : X ∈ ℝ
  requires gIn : g ∈ ℝ
  requires tPair : RealSquarefree.IsPair(t)
  requires quotientNonzero :
    hornerAt{ℝ}(realAdd, realMul, realZero, X, qs) ≠ realZero
  requires chain : RealSquarefree.Chain(X, t,
    polynomialConstant(oneVariable, F, realNat(k)), qs, es)
  requires divides : RealSquarefree.poly(g, gs) =
    P[RealSquarefree.poly(realZero, es) *
      RealSquarefree.poly(realOne, RealSquarefree.linearPower(X, k))]
  shows ∃ ts, List(ℝ, ts) ∧
    RealSquarefree.Chain(X, t,
      polynomialConstant(oneVariable, F, realNat(succ(k))), qs, ts) ∧
    RealSquarefree.poly(g, gs) = P[RealSquarefree.poly(realZero, ts) *
      RealSquarefree.poly(realOne, RealSquarefree.linearPower(X, succ(k)))]
proof
  have typedX : Real(X) by exact realX
  have zeroIn : realZero ∈ ℝ := realZero.real
  have oneIn : realOne ∈ ℝ := realOne.real
  have negIn : realNeg(X) ∈ ℝ by typecheck
  have linearList : List(ℝ, realNeg(X) :: []) by typecheck
  have ringP := RealSquarefree.ring_P
  have kIn : realNat(k) ∈ ℝ := realNat.real at k
  have kSuccIn : realNat(succ(k)) ∈ ℝ := realNat.real at succ(k)
  have powerData := RealSquarefree.linearPower.data at X, k with realX
  have powerList := powerData.left
  obtain ⟨esRoot, identity⟩ := chain
  have linearIff := HornerDivides.linear_iff at ℝ, realAdd, realZero, realNeg,
    realMul, realOne, realZero, X, es with reals.comm_ring, zeroIn, realX
  have dividesLinear := linearIff.backward with esRoot
  obtain ⟨ts, tsList, factorRaw⟩ := dividesLinear
  have factor : RealSquarefree.poly(realZero, es) =
      P[RealSquarefree.poly(realZero, ts) *
        RealSquarefree.poly(realOne, realNeg(X) :: [])]
    unfold RealSquarefree.poly
    exact factorRaw
  have qIn := RealSquarefree.poly.member at realZero, qs with zeroIn
  have qPair := RealSquarefree.IsPair.of_poly at realZero, qs with zeroIn
  have tIn := RealSquarefree.IsPair.member with tPair
  have eIn := RealSquarefree.poly.member at realZero, ts with zeroIn
  have ePair := RealSquarefree.IsPair.of_poly at realZero, ts with zeroIn
  have eDerivationIn := RealSquarefree.derivation.member with eIn
  have eDerivationPair := RealSquarefree.IsPair.derivation with ePair
  have linearIn := RealSquarefree.poly.member at realOne, realNeg(X) :: []
    with oneIn
  have linearPair := RealSquarefree.IsPair.of_poly at realOne,
    realNeg(X) :: [] with oneIn
  have constantPair := RealSquarefree.IsPair.constant at realNat(k) with kIn
  have constantIn := RealSquarefree.IsPair.member with constantPair
  have constantSuccPair := RealSquarefree.IsPair.constant at realNat(succ(k))
    with kSuccIn
  have constantSuccIn := RealSquarefree.IsPair.member with constantSuccPair
  have powerIn := RealSquarefree.poly.member at realOne,
    RealSquarefree.linearPower(X, k) with oneIn
  have linearDerivation := RealSquarefree.linear.derivation at X with realX
  have product := RealSquarefree.derivation.mul at
    RealSquarefree.poly(realZero, ts),
    RealSquarefree.poly(realOne, realNeg(X) :: []) with eIn, linearIn
  rw linearDerivation at product
  rw ← factor at product
  rw [product, factor] at identity
  have killed : P[RealSquarefree.poly(realOne, realNeg(X) :: []) *
      (RealSquarefree.poly(realZero, qs) *
        RealSquarefree.derivation(RealSquarefree.poly(realZero, ts)) *
        RealSquarefree.poly(realOne, realNeg(X) :: []) +
      polynomialConstant(oneVariable, F, realNat(k)) *
        RealSquarefree.poly(realZero, qs) *
        RealSquarefree.poly(realZero, ts) +
      RealSquarefree.poly(realZero, qs) * RealSquarefree.poly(realZero, ts) +
      -(RealSquarefree.poly(realZero, ts) *
        RealSquarefree.poly(realOne, realNeg(X) :: []) * t))] = P[0]
    have expand : P[RealSquarefree.poly(realOne, realNeg(X) :: []) *
        (RealSquarefree.poly(realZero, qs) *
          RealSquarefree.derivation(RealSquarefree.poly(realZero, ts)) *
          RealSquarefree.poly(realOne, realNeg(X) :: []) +
        polynomialConstant(oneVariable, F, realNat(k)) *
          RealSquarefree.poly(realZero, qs) *
          RealSquarefree.poly(realZero, ts) +
        RealSquarefree.poly(realZero, qs) * RealSquarefree.poly(realZero, ts) +
        -(RealSquarefree.poly(realZero, ts) *
          RealSquarefree.poly(realOne, realNeg(X) :: []) * t))] =
      P[RealSquarefree.poly(realZero, qs) *
          (RealSquarefree.derivation(RealSquarefree.poly(realZero, ts)) *
            RealSquarefree.poly(realOne, realNeg(X) :: []) +
            RealSquarefree.poly(realZero, ts) * 1) *
          RealSquarefree.poly(realOne, realNeg(X) :: []) +
        polynomialConstant(oneVariable, F, realNat(k)) *
          RealSquarefree.poly(realZero, qs) *
          (RealSquarefree.poly(realZero, ts) *
            RealSquarefree.poly(realOne, realNeg(X) :: [])) +
        -(RealSquarefree.poly(realZero, ts) *
          RealSquarefree.poly(realOne, realNeg(X) :: []) *
          RealSquarefree.poly(realOne, realNeg(X) :: []) * t)] by ring
    rw [expand, identity]
    ring
  have term1 := RealSquarefree.IsPair.mul with qPair, eDerivationPair
  have term2 := RealSquarefree.IsPair.mul with term1, linearPair
  have term3 := RealSquarefree.IsPair.mul with constantPair, qPair
  have term4 := RealSquarefree.IsPair.mul with term3, ePair
  have term5 := RealSquarefree.IsPair.add with term2, term4
  have term6 := RealSquarefree.IsPair.mul with qPair, ePair
  have term7 := RealSquarefree.IsPair.add with term5, term6
  have term8 := RealSquarefree.IsPair.mul with ePair, linearPair
  have term9 := RealSquarefree.IsPair.mul with term8, tPair
  have term10 := RealSquarefree.IsPair.neg with term9
  have gPair := RealSquarefree.IsPair.add with term7, term10
  have gZero := RealSquarefree.IsPair.cancel with realX, gPair, killed
  have constantSucc := RealSquarefree.constant_succ at k
  have newIdentity : P[RealSquarefree.poly(realZero, qs) *
      RealSquarefree.derivation(RealSquarefree.poly(realZero, ts)) *
      RealSquarefree.poly(realOne, realNeg(X) :: []) +
      polynomialConstant(oneVariable, F, realNat(succ(k))) *
        RealSquarefree.poly(realZero, qs) *
        RealSquarefree.poly(realZero, ts)] =
    P[RealSquarefree.poly(realZero, ts) *
      RealSquarefree.poly(realOne, realNeg(X) :: []) * t]
    rw constantSucc
    have expand : P[RealSquarefree.poly(realZero, qs) *
        RealSquarefree.derivation(RealSquarefree.poly(realZero, ts)) *
        RealSquarefree.poly(realOne, realNeg(X) :: []) +
        (polynomialConstant(oneVariable, F, realNat(k)) + 1) *
          RealSquarefree.poly(realZero, qs) *
          RealSquarefree.poly(realZero, ts)] =
      P[(RealSquarefree.poly(realZero, qs) *
          RealSquarefree.derivation(RealSquarefree.poly(realZero, ts)) *
          RealSquarefree.poly(realOne, realNeg(X) :: []) +
        polynomialConstant(oneVariable, F, realNat(k)) *
          RealSquarefree.poly(realZero, qs) *
          RealSquarefree.poly(realZero, ts) +
        RealSquarefree.poly(realZero, qs) * RealSquarefree.poly(realZero, ts) +
        -(RealSquarefree.poly(realZero, ts) *
          RealSquarefree.poly(realOne, realNeg(X) :: []) * t)) +
        RealSquarefree.poly(realZero, ts) *
          RealSquarefree.poly(realOne, realNeg(X) :: []) * t] by ring
    rw [expand, gZero]
    ring
  -- the new cofactor vanishes at X: evaluate the identity there.
  have evaluated : RealSquarefree.evaluation(X)(
      P[RealSquarefree.poly(realZero, qs) *
        RealSquarefree.derivation(RealSquarefree.poly(realZero, ts)) *
        RealSquarefree.poly(realOne, realNeg(X) :: []) +
        polynomialConstant(oneVariable, F, realNat(succ(k))) *
          RealSquarefree.poly(realZero, qs) *
          RealSquarefree.poly(realZero, ts)]) =
    RealSquarefree.evaluation(X)(P[RealSquarefree.poly(realZero, ts) *
      RealSquarefree.poly(realOne, realNeg(X) :: []) * t])
    rw newIdentity
    rfl
  have part1In : P[RealSquarefree.poly(realZero, qs) *
    RealSquarefree.derivation(RealSquarefree.poly(realZero, ts))] ∈ P
    by typecheck
  have part2In : P[RealSquarefree.poly(realZero, qs) *
    RealSquarefree.derivation(RealSquarefree.poly(realZero, ts)) *
    RealSquarefree.poly(realOne, realNeg(X) :: [])] ∈ P by typecheck
  have part3In : P[polynomialConstant(oneVariable, F, realNat(succ(k))) *
    RealSquarefree.poly(realZero, qs)] ∈ P by typecheck
  have part4In : P[polynomialConstant(oneVariable, F, realNat(succ(k))) *
    RealSquarefree.poly(realZero, qs) * RealSquarefree.poly(realZero, ts)] ∈ P
    by typecheck
  have part5In : P[RealSquarefree.poly(realZero, ts) *
    RealSquarefree.poly(realOne, realNeg(X) :: [])] ∈ P by typecheck
  rw RealSquarefree.evaluation.add at X, P[RealSquarefree.poly(realZero, qs) *
      RealSquarefree.derivation(RealSquarefree.poly(realZero, ts)) *
      RealSquarefree.poly(realOne, realNeg(X) :: [])],
    P[polynomialConstant(oneVariable, F, realNat(succ(k))) *
      RealSquarefree.poly(realZero, qs) * RealSquarefree.poly(realZero, ts)]
    with realX, part2In, part4In at evaluated
  rw RealSquarefree.evaluation.mul at X, P[RealSquarefree.poly(realZero, qs) *
      RealSquarefree.derivation(RealSquarefree.poly(realZero, ts))],
    RealSquarefree.poly(realOne, realNeg(X) :: []) with realX, part1In, linearIn
    at evaluated
  rw RealSquarefree.evaluation.mul at X, P[polynomialConstant(oneVariable, F,
      realNat(succ(k))) * RealSquarefree.poly(realZero, qs)],
    RealSquarefree.poly(realZero, ts) with realX, part3In, eIn at evaluated
  rw RealSquarefree.evaluation.mul at X, polynomialConstant(oneVariable, F,
      realNat(succ(k))), RealSquarefree.poly(realZero, qs) with
    realX, constantSuccIn, qIn at evaluated
  rw RealSquarefree.evaluation.mul at X, P[RealSquarefree.poly(realZero, ts) *
      RealSquarefree.poly(realOne, realNeg(X) :: [])], t with
    realX, part5In, tIn at evaluated
  rw RealSquarefree.evaluation.mul at X, RealSquarefree.poly(realZero, ts),
    RealSquarefree.poly(realOne, realNeg(X) :: []) with realX, eIn, linearIn
    at evaluated
  have linearValue := RealSquarefree.poly.value at realOne, X, realNeg(X) :: []
    with oneIn, realX
  rw RealSquarefree.linear.value at X with realX at linearValue
  have qValue := RealSquarefree.poly.value at realZero, X, qs with zeroIn, realX
  have eValue := RealSquarefree.poly.value at realZero, X, ts with zeroIn, realX
  have constantValue := RealSquarefree.evaluation.constant at X,
    realNat(succ(k)) with realX, kSuccIn
  rw [linearValue, qValue, eValue, constantValue] at evaluated
  have qReal : hornerAt{ℝ}(realAdd, realMul, realZero, X, qs) ∈ ℝ
    rw ← qValue
    exact RealSquarefree.evaluation.real at X, RealSquarefree.poly(realZero, qs)
      with realX, qIn
  have eReal : hornerAt{ℝ}(realAdd, realMul, realZero, X, ts) ∈ ℝ
    rw ← eValue
    exact RealSquarefree.evaluation.real at X, RealSquarefree.poly(realZero, ts)
      with realX, eIn
  have derivationReal : RealSquarefree.evaluation(X)(RealSquarefree.derivation(
      RealSquarefree.poly(realZero, ts))) ∈ ℝ
    exact RealSquarefree.evaluation.real at X,
      RealSquarefree.derivation(RealSquarefree.poly(realZero, ts)) with
      realX, eDerivationIn
  have tReal : RealSquarefree.evaluation(X)(t) ∈ ℝ
    exact RealSquarefree.evaluation.real at X, t with realX, tIn
  have typedQ : Real(hornerAt{ℝ}(realAdd, realMul, realZero, X, qs)) by
    exact qReal
  have typedE : Real(hornerAt{ℝ}(realAdd, realMul, realZero, X, ts)) by
    exact eReal
  have typedDerivation : Real(RealSquarefree.evaluation(X)(
    RealSquarefree.derivation(RealSquarefree.poly(realZero, ts)))) by
    exact derivationReal
  have typedT : Real(RealSquarefree.evaluation(X)(t)) by exact tReal
  have typedK : Real(realNat(succ(k))) by exact kSuccIn
  have productZero : (realNat(succ(k)):R) *
      hornerAt{ℝ}(realAdd, realMul, realZero, X, qs) *
      hornerAt{ℝ}(realAdd, realMul, realZero, X, ts) = (0:R)
    linear_combination evaluated
  have cases := realMulValue.eq_zero_or at (realNat(succ(k)):R) *
    hornerAt{ℝ}(realAdd, realMul, realZero, X, qs),
    hornerAt{ℝ}(realAdd, realMul, realZero, X, ts) with productZero
  have eRoot : hornerAt{ℝ}(realAdd, realMul, realZero, X, ts) = realZero
    cases cases with first | second
    . exfalso
      have inner := realMulValue.eq_zero_or at (realNat(succ(k)):R),
        hornerAt{ℝ}(realAdd, realMul, realZero, X, qs) with first
      cases inner with kZero | qZero
      . have succNonzero : succ(k) ≠ (0:N) by arith
        exact realNat.ne_zero at succ(k) with succNonzero, kZero
      . exact quotientNonzero with qZero
    . exact second
  -- the power grows by one factor.
  have power := RealSquarefree.linearPower.succ at X, k
  have productPower := RealSquarefree.poly.mul at realOne, realOne,
    realNeg(X) :: [], RealSquarefree.linearPower(X, k) with oneIn, oneIn
  have oneOne : F[realOne * realOne] = realOne by ring
  rw oneOne at productPower
  have newDivides : RealSquarefree.poly(g, gs) =
      P[RealSquarefree.poly(realZero, ts) *
        RealSquarefree.poly(realOne, RealSquarefree.linearPower(X, succ(k)))]
    rw [power, productPower, divides, factor]
    ring
  refine ⟨ts, tsList, ?_, newDivides⟩
  unfold RealSquarefree.Chain
  exact ⟨eRoot, newIdentity⟩

theorem RealSquarefree.chain (X t g : Set) (qs gs : List(ℝ)) (k : Nat)
  requires realX : X ∈ ℝ
  requires gIn : g ∈ ℝ
  requires tPair : RealSquarefree.IsPair(t)
  requires quotientNonzero :
    hornerAt{ℝ}(realAdd, realMul, realZero, X, qs) ≠ realZero
  requires gcdRoot : hornerAt{ℝ}(realAdd, realMul, g, X, gs) = realZero
  requires relation : P[RealSquarefree.poly(realZero, qs) *
      RealSquarefree.derivation(RealSquarefree.poly(g, gs))] =
    P[t * RealSquarefree.poly(g, gs)]
  shows ∃ es, List(ℝ, es) ∧
    RealSquarefree.Chain(X, t, polynomialConstant(oneVariable, F, realNat(k)),
      qs, es) ∧
    RealSquarefree.poly(g, gs) = P[RealSquarefree.poly(realZero, es) *
      RealSquarefree.poly(realOne, RealSquarefree.linearPower(X, k))]
proof
  induction k
  | zero =>
    exact RealSquarefree.chain_base at X, t, g, qs, gs with
      realX, gIn, tPair, gcdRoot, relation
  | succ(j) using ih =>
    obtain ⟨es, esList, chain, divides⟩ := ih
    exact RealSquarefree.chain_step at X, t, g, qs, gs, es, j with
      realX, gIn, tPair, quotientNonzero, chain, divides

theorem RealSquarefree.pairPower.data (f : Set) (fs : List(ℝ)) (k : Nat)
  requires fIn : f ∈ ℝ
  shows List(ℝ, RealSquarefree.pairPower(f, fs, k)) ∧
    length{ℝ}(RealSquarefree.pairPower(f, fs, k)) = k * length{ℝ}(fs)
proof
  induction k
  | zero =>
    have nilList : List(ℝ, []) by typecheck
    rw RealSquarefree.pairPower.zero
    refine ⟨nilList, ?_⟩
    rw length.nil
    ring
  | succ(j) using ih =>
    have typedF : Real(f) by exact fIn
    have powerIn : realPow(f, j) ∈ ℝ by typecheck
    have tailList := ih.left
    have tailLength := ih.right
    have data := hornerMulList.data at ℝ, realAdd, realZero, realNeg, realMul,
      realOne, f, realPow(f, j), fs, RealSquarefree.pairPower(f, fs, j) with
      reals.comm_ring, fIn, powerIn
    rw RealSquarefree.pairPower.succ
    refine ⟨data.left, ?_⟩
    rw [data.right, tailLength]
    ring

theorem RealSquarefree.pairPower.poly (f : Set) (fs : List(ℝ)) (k : Nat)
  requires fIn : f ∈ ℝ
  shows RealSquarefree.poly(realPow(f, succ(k)),
      RealSquarefree.pairPower(f, fs, succ(k))) =
    P[RealSquarefree.poly(f, fs) *
      RealSquarefree.poly(realPow(f, k), RealSquarefree.pairPower(f, fs, k))]
proof
  have typedF : Real(f) by exact fIn
  have powerIn : realPow(f, k) ∈ ℝ by typecheck
  have powerData := RealSquarefree.pairPower.data at f, fs, k with fIn
  have powerList := powerData.left
  have product := RealSquarefree.poly.mul at f, realPow(f, k), fs,
    RealSquarefree.pairPower(f, fs, k) with fIn, powerIn
  rw RealSquarefree.pairPower.succ
  rw realPow.succ
  exact product

theorem RealSquarefree.pairPower.zero_poly (f fs : Set)
  requires fIn : f ∈ ℝ
  shows RealSquarefree.poly(realPow(f, 0), RealSquarefree.pairPower(f, fs, 0)) =
    P[1]
proof
  have typedF : Real(f) by exact fIn
  have oneIn : realOne ∈ ℝ := realOne.real
  rw [RealSquarefree.pairPower.zero, realPow.zero]
  rw RealSquarefree.poly.constant at realOne with oneIn
  rfl

-- The derivative of N·F^(j+1) is a multiple of F^j.
theorem RealSquarefree.power_derivation (f : Set) (fs : List(ℝ)) (j : Nat)
  requires fIn : f ∈ ℝ
  shows ∀ ns, List(ℝ, ns) → ∃ vs, List(ℝ, vs) ∧
    RealSquarefree.derivation(P[RealSquarefree.poly(realZero, ns) *
      RealSquarefree.poly(realPow(f, succ(j)),
        RealSquarefree.pairPower(f, fs, succ(j)))]) =
    P[RealSquarefree.poly(realZero, vs) *
      RealSquarefree.poly(realPow(f, j), RealSquarefree.pairPower(f, fs, j))]
proof
  induction j
  | zero =>
    intros ns nsList
    have typedF : Real(f) by exact fIn
    have zeroIn : realZero ∈ ℝ := realZero.real
    have ringP := RealSquarefree.ring_P
    have fsList : List(ℝ, fs) by typecheck
    have nIn := RealSquarefree.poly.member at realZero, ns with zeroIn
    have nPair := RealSquarefree.IsPair.of_poly at realZero, ns with zeroIn
    have fPolyIn := RealSquarefree.poly.member at f, fs with fIn
    have fPair := RealSquarefree.IsPair.of_poly at f, fs with fIn
    have nDerivationPair := RealSquarefree.IsPair.derivation with nPair
    have fDerivationPair := RealSquarefree.IsPair.derivation with fPair
    have nDerivationIn := RealSquarefree.derivation.member with nIn
    have fDerivationIn := RealSquarefree.derivation.member with fPolyIn
    have term1 := RealSquarefree.IsPair.mul with nDerivationPair, fPair
    have term2 := RealSquarefree.IsPair.mul with nPair, fDerivationPair
    have sumPair := RealSquarefree.IsPair.add with term1, term2
    obtain ⟨vs, vsList, vsEqual⟩ := sumPair
    have power := RealSquarefree.pairPower.poly at f, fs, 0 with fIn
    have base := RealSquarefree.pairPower.zero_poly at f, fs with fIn
    rw [power, base]
    have product := RealSquarefree.derivation.mul at
      RealSquarefree.poly(realZero, ns), RealSquarefree.poly(f, fs) with
      nIn, fPolyIn
    have same : P[RealSquarefree.poly(realZero, ns) *
        (RealSquarefree.poly(f, fs) * 1)] =
      P[RealSquarefree.poly(realZero, ns) * RealSquarefree.poly(f, fs)] by ring
    rw [same, product]
    refine ⟨vs, vsList, ?_⟩
    rw ← vsEqual
    ring
  | succ(i) using ih =>
    intros ns nsList
    have typedF : Real(f) by exact fIn
    have zeroIn : realZero ∈ ℝ := realZero.real
    have ringP := RealSquarefree.ring_P
    have fsList : List(ℝ, fs) by typecheck
    have powerIn : realPow(f, succ(i)) ∈ ℝ by typecheck
    have lowerIn : realPow(f, i) ∈ ℝ by typecheck
    have powerData := RealSquarefree.pairPower.data at f, fs, succ(i) with fIn
    have powerList := powerData.left
    have lowerData := RealSquarefree.pairPower.data at f, fs, i with fIn
    have lowerList := lowerData.left
    have nIn := RealSquarefree.poly.member at realZero, ns with zeroIn
    have nPair := RealSquarefree.IsPair.of_poly at realZero, ns with zeroIn
    have fPolyIn := RealSquarefree.poly.member at f, fs with fIn
    have fPair := RealSquarefree.IsPair.of_poly at f, fs with fIn
    have fDerivationPair := RealSquarefree.IsPair.derivation with fPair
    have fDerivationIn := RealSquarefree.derivation.member with fPolyIn
    have powerPolyIn := RealSquarefree.poly.member at realPow(f, succ(i)),
      RealSquarefree.pairPower(f, fs, succ(i)) with powerIn
    have lowerPolyIn := RealSquarefree.poly.member at realPow(f, i),
      RealSquarefree.pairPower(f, fs, i) with lowerIn
    obtain ⟨vs, vsList, vsEqual⟩ := ih with ns, nsList
    have vIn := RealSquarefree.poly.member at realZero, vs with zeroIn
    have vPair := RealSquarefree.IsPair.of_poly at realZero, vs with zeroIn
    have term1 := RealSquarefree.IsPair.mul with fDerivationPair, nPair
    have sumPair := RealSquarefree.IsPair.add with term1, vPair
    obtain ⟨ws, wsList, wsEqual⟩ := sumPair
    have power := RealSquarefree.pairPower.poly at f, fs, succ(i) with fIn
    have lower := RealSquarefree.pairPower.poly at f, fs, i with fIn
    have innerIn : P[RealSquarefree.poly(realZero, ns) *
      RealSquarefree.poly(realPow(f, succ(i)),
        RealSquarefree.pairPower(f, fs, succ(i)))] ∈ P by typecheck
    have product := RealSquarefree.derivation.mul at RealSquarefree.poly(f, fs),
      P[RealSquarefree.poly(realZero, ns) *
        RealSquarefree.poly(realPow(f, succ(i)),
          RealSquarefree.pairPower(f, fs, succ(i)))] with fPolyIn, innerIn
    rw vsEqual at product
    have same : P[RealSquarefree.poly(realZero, ns) *
        (RealSquarefree.poly(f, fs) *
          RealSquarefree.poly(realPow(f, succ(i)),
            RealSquarefree.pairPower(f, fs, succ(i))))] =
      P[RealSquarefree.poly(f, fs) * (RealSquarefree.poly(realZero, ns) *
        RealSquarefree.poly(realPow(f, succ(i)),
          RealSquarefree.pairPower(f, fs, succ(i))))] by ring
    rw [power, same, product]
    refine ⟨ws, wsList, ?_⟩
    rw [← wsEqual, lower]
    ring

theorem RealSquarefree.gcdLeading.mem (a : Set) (cs : List(ℝ))
  requires aIn : a ∈ ℝ
  shows RealSquarefree.gcdLeading(a, cs) ∈ ℝ
proof
  have derivativeIn := hornerDerivativeLeading.closed at ℝ, realAdd, realZero,
    realNeg, realMul, realOne, a, cs with reals.comm_ring, aIn
  have derivativeData := hornerDerivativeList.data at ℝ, realAdd, realZero,
    realNeg, realMul, realOne, a, cs with reals.comm_ring, aIn
  have derivativeList := derivativeData.left
  unfold RealSquarefree.gcdLeading
  exact hornerGcdLeading.mem at ℝ, realAdd, realZero, realNeg, realMul,
    realOne, a,
    hornerDerivativeLeading{ℝ}(realAdd, realZero, realOne, realMul, a, cs),
    cs, hornerDerivativeList{ℝ}(realAdd, realZero, realOne, realMul, cs) with
    RealSquarefree.field, aIn, derivativeIn, derivativeList

theorem RealSquarefree.gcdLower.list (a : Set) (cs : List(ℝ))
  requires aIn : a ∈ ℝ
  shows List(ℝ, RealSquarefree.gcdLower(a, cs))
proof
  have derivativeIn := hornerDerivativeLeading.closed at ℝ, realAdd, realZero,
    realNeg, realMul, realOne, a, cs with reals.comm_ring, aIn
  have derivativeData := hornerDerivativeList.data at ℝ, realAdd, realZero,
    realNeg, realMul, realOne, a, cs with reals.comm_ring, aIn
  have derivativeList := derivativeData.left
  unfold RealSquarefree.gcdLower
  exact hornerGcdLower.list at ℝ, realAdd, realZero, realNeg, realMul,
    realOne, a,
    hornerDerivativeLeading{ℝ}(realAdd, realZero, realOne, realMul, a, cs),
    cs, hornerDerivativeList{ℝ}(realAdd, realZero, realOne, realMul, cs) with
    RealSquarefree.field, aIn, derivativeIn, derivativeList

-- The chain: when p = N·F²·d for the gcd d of p and p′, every power of F
-- divides d, since F^(k+2) | p forces F^(k+1) | p′.
theorem RealSquarefree.power_chain (a f : Set) (cs fs ns : List(ℝ)) (k : Nat)
  requires aIn : a ∈ ℝ
  requires fIn : f ∈ ℝ
  requires factor : RealSquarefree.poly(a, cs) =
    P[RealSquarefree.poly(realZero, ns) * RealSquarefree.poly(f, fs) *
      RealSquarefree.poly(f, fs) *
      RealSquarefree.poly(RealSquarefree.gcdLeading(a, cs),
        RealSquarefree.gcdLower(a, cs))]
  shows ∃ ms, List(ℝ, ms) ∧
    RealSquarefree.poly(RealSquarefree.gcdLeading(a, cs),
      RealSquarefree.gcdLower(a, cs)) =
    P[RealSquarefree.poly(realZero, ms) *
      RealSquarefree.poly(realPow(f, k), RealSquarefree.pairPower(f, fs, k))]
proof
  induction k
  | zero =>
    have zeroIn : realZero ∈ ℝ := realZero.real
    have ringP := RealSquarefree.ring_P
    have gIn := RealSquarefree.gcdLeading.mem at a, cs with aIn
    have gsList := RealSquarefree.gcdLower.list at a, cs with aIn
    have fullList := hornerFullList.list at ℝ,
      RealSquarefree.gcdLeading(a, cs), RealSquarefree.gcdLower(a, cs) with gIn
    have full := RealSquarefree.poly.full at RealSquarefree.gcdLeading(a, cs),
      RealSquarefree.gcdLower(a, cs) with gIn
    have base := RealSquarefree.pairPower.zero_poly at f, fs with fIn
    have dIn := RealSquarefree.poly.member at RealSquarefree.gcdLeading(a, cs),
      RealSquarefree.gcdLower(a, cs) with gIn
    refine ⟨hornerFullList{ℝ}(RealSquarefree.gcdLeading(a, cs),
      RealSquarefree.gcdLower(a, cs)), fullList, ?_⟩
    rw [full, base]
    ring
  | succ(j) using ih =>
    obtain ⟨ms, msList, dEqual⟩ := ih
    have zeroIn : realZero ∈ ℝ := realZero.real
    have ringP := RealSquarefree.ring_P
    have gIn := RealSquarefree.gcdLeading.mem at a, cs with aIn
    have gsList := RealSquarefree.gcdLower.list at a, cs with aIn
    have derivativeIn := hornerDerivativeLeading.closed at ℝ, realAdd,
      realZero, realNeg, realMul, realOne, a, cs with reals.comm_ring, aIn
    have derivativeData := hornerDerivativeList.data at ℝ, realAdd, realZero,
      realNeg, realMul, realOne, a, cs with reals.comm_ring, aIn
    have derivativeList := derivativeData.left
    have typedF : Real(f) by exact fIn
    have fsList : List(ℝ, fs) by typecheck
    have powerIn : realPow(f, succ(j)) ∈ ℝ by typecheck
    have lowerIn : realPow(f, j) ∈ ℝ by typecheck
    have topIn : realPow(f, succ(succ(j))) ∈ ℝ by typecheck
    have powerData := RealSquarefree.pairPower.data at f, fs, succ(j) with fIn
    have powerList := powerData.left
    have lowerData := RealSquarefree.pairPower.data at f, fs, j with fIn
    have lowerList := lowerData.left
    have topData := RealSquarefree.pairPower.data at f, fs, succ(succ(j))
      with fIn
    have topList := topData.left
    have nPair := RealSquarefree.IsPair.of_poly at realZero, ns with zeroIn
    have mPair := RealSquarefree.IsPair.of_poly at realZero, ms with zeroIn
    have fPair := RealSquarefree.IsPair.of_poly at f, fs with fIn
    have nIn := RealSquarefree.poly.member at realZero, ns with zeroIn
    have mIn := RealSquarefree.poly.member at realZero, ms with zeroIn
    have fPolyIn := RealSquarefree.poly.member at f, fs with fIn
    have dIn := RealSquarefree.poly.member at RealSquarefree.gcdLeading(a, cs),
      RealSquarefree.gcdLower(a, cs) with gIn
    have powerPolyIn := RealSquarefree.poly.member at realPow(f, succ(j)),
      RealSquarefree.pairPower(f, fs, succ(j)) with powerIn
    have lowerPolyIn := RealSquarefree.poly.member at realPow(f, j),
      RealSquarefree.pairPower(f, fs, j) with lowerIn
    have topPolyIn := RealSquarefree.poly.member at realPow(f, succ(succ(j))),
      RealSquarefree.pairPower(f, fs, succ(succ(j))) with topIn
    have nmPair := RealSquarefree.IsPair.mul with nPair, mPair
    obtain ⟨nms, nmsList, nmsEqual⟩ := nmPair
    have nmsIn := RealSquarefree.poly.member at realZero, nms with zeroIn
    have top := RealSquarefree.pairPower.poly at f, fs, succ(j) with fIn
    have middle := RealSquarefree.pairPower.poly at f, fs, j with fIn
    -- p = (N·M)·F^(j+2)
    have pTop : RealSquarefree.poly(a, cs) =
        P[RealSquarefree.poly(realZero, nms) *
          RealSquarefree.poly(realPow(f, succ(succ(j))),
            RealSquarefree.pairPower(f, fs, succ(succ(j))))]
      rw [factor, dEqual, top, middle, ← nmsEqual]
      ring
    -- p′ = V·F^(j+1)
    have derivative := RealSquarefree.derivation.poly at a, cs with aIn
    obtain ⟨vs, vsList, vsEqual⟩ :=
      RealSquarefree.power_derivation at f, fs, succ(j) with fIn, nms, nmsList
    rw ← pTop at vsEqual
    rw derivative at vsEqual
    -- p = (N·M·F)·F^(j+1)
    have nmfPair := RealSquarefree.IsPair.mul with nmPair, fPair
    obtain ⟨ws, wsList, wsEqual⟩ := nmfPair
    have pMiddle : RealSquarefree.poly(a, cs) =
        P[RealSquarefree.poly(realZero, ws) *
          RealSquarefree.poly(realPow(f, succ(j)),
            RealSquarefree.pairPower(f, fs, succ(j)))]
      rw [pTop, top, ← wsEqual, nmsEqual]
      ring
    have dividesLeft : HornerDivides(ℝ, realAdd, realZero, realNeg, realMul,
        realOne, realPow(f, succ(j)), RealSquarefree.pairPower(f, fs, succ(j)),
        a, cs)
      refine ⟨ws, wsList, ?_⟩
      unfold RealSquarefree.poly at pMiddle
      exact pMiddle
    have dividesRight : HornerDivides(ℝ, realAdd, realZero, realNeg, realMul,
        realOne, realPow(f, succ(j)), RealSquarefree.pairPower(f, fs, succ(j)),
        hornerDerivativeLeading{ℝ}(realAdd, realZero, realOne, realMul, a, cs),
        hornerDerivativeList{ℝ}(realAdd, realZero, realOne, realMul, cs))
      refine ⟨vs, vsList, ?_⟩
      unfold RealSquarefree.poly at vsEqual
      exact vsEqual
    have greatest := hornerGcd.greatest at ℝ, realAdd, realZero, realNeg,
      realMul, realOne, a,
      hornerDerivativeLeading{ℝ}(realAdd, realZero, realOne, realMul, a, cs),
      realPow(f, succ(j)), cs,
      hornerDerivativeList{ℝ}(realAdd, realZero, realOne, realMul, cs),
      RealSquarefree.pairPower(f, fs, succ(j)) with
      RealSquarefree.field, aIn, derivativeIn, powerIn, dividesLeft,
      dividesRight
    obtain ⟨ms2, ms2List, dividesGcd⟩ := greatest
    refine ⟨ms2, ms2List, ?_⟩
    unfold RealSquarefree.poly
    unfold RealSquarefree.gcdLeading
    unfold RealSquarefree.gcdLower
    exact dividesGcd

-- A power of a nonzero real is nonzero.
theorem RealSquarefree.pow_nonzero (f : Set) (k : Nat)
  requires fIn : f ∈ ℝ
  requires fNonzero : f ≠ realZero
  shows realPow(f, k) ≠ realZero
proof
  induction k
  | zero =>
    have typedF : Real(f) by exact fIn
    rw realPow.zero
    intro same
    linarith
  | succ(j) using ih =>
    have typedF : Real(f) by exact fIn
    have powerIn : realPow(f, j) ∈ ℝ by typecheck
    have typedPower : Real(realPow(f, j)) by exact powerIn
    rw realPow.succ
    intro same
    have cases := realMulValue.eq_zero_or with same
    cases cases with first | second
    . exact fNonzero with first
    . exact ih with second

-- A nonconstant pair has a nonzero derivative leading coefficient.
theorem RealSquarefree.derivative_leading_nonzero (h : Set) (hs : List(ℝ))
  requires hIn : h ∈ ℝ
  requires hNonzero : h ≠ realZero
  requires nonempty : hs ≠ []
  shows hornerDerivativeLeading{ℝ}(realAdd, realZero, realOne, realMul, h, hs) ≠
    realZero
proof
  have typedH : Real(h) by exact hIn
  have lengthNonzero : length{ℝ}(hs) ≠ (0:N)
    have shape := List.cases at ℝ, hs with *
    cases shape with empty | cons
    . exfalso
      exact nonempty with empty
    . obtain ⟨x, xIn, tail, tailList, equal⟩ := cons
      rw equal
      rw length.cons at ℝ, x, tail with xIn
      arith
  have lengthNat : Nat(length{ℝ}(hs)) by typecheck
  have numeral := realNat.numeral at length{ℝ}(hs)
  have natNonzero := realNat.ne_zero at length{ℝ}(hs) with lengthNonzero
  have typedNat : Real(realNat(length{ℝ}(hs))) := realNat.real at length{ℝ}(hs)
  unfold hornerDerivativeLeading
  rw ← numeral
  intro same
  have cases := realMulValue.eq_zero_or with same
  cases cases with first | second
  . exact natNonzero with first
  . exact hNonzero with second
end Pieces

section Polynomials
variable (leading cs : Set)
hypothesis initial : Real(leading)
hypothesis coefficients : List(ℝ, cs)
hypothesis nonzero : leading ≠ (0:R)
notation ring F := (ℝ, realAdd, realZero, realNeg, realMul, realOne)
notation ring P := F[oneVariable]

-- The squarefree part as a full list, and in normal form.
def realSquarefreeList : Set :=
  squarefreePartList{ℝ}(realAdd, realZero, realNeg, realMul, realOne, leading,
    cs)
def squarefreeLeading : Set :=
  hornerTrimLeading{ℝ}(realZero, realSquarefreeList)
def squarefreeLower : Set :=
  hornerTrimLower{ℝ}(realZero, realSquarefreeList)

-- The gcd of the pair with its derivative pair, in normal form.
def realSquarefreeGcdLeading : Set :=
  hornerGcdLeading{ℝ}(realAdd, realZero, realNeg, realMul, realOne, leading,
    hornerDerivativeLeading{ℝ}(realAdd, realZero, realOne, realMul, leading,
    cs),
    cs, hornerDerivativeList{ℝ}(realAdd, realZero, realOne, realMul, cs))
def realSquarefreeGcdLower : Set :=
  hornerGcdLower{ℝ}(realAdd, realZero, realNeg, realMul, realOne, leading,
    hornerDerivativeLeading{ℝ}(realAdd, realZero, realOne, realMul, leading,
    cs),
    cs, hornerDerivativeList{ℝ}(realAdd, realZero, realOne, realMul, cs))

theorem realSquarefreeGcd.real
  shows realSquarefreeGcdLeading ∈ ℝ
proof
  have leadingIn : leading ∈ ℝ by exact initial
  have derivativeIn := hornerDerivativeLeading.closed with
    coefficients, reals.comm_ring, leadingIn
  have derivativeData := hornerDerivativeList.data with
    coefficients, reals.comm_ring, leadingIn
  unfold realSquarefreeGcdLeading
  exact hornerGcdLeading.mem at ℝ, realAdd, realZero, realNeg, realMul,
    realOne, leading,
    hornerDerivativeLeading{ℝ}(realAdd, realZero, realOne, realMul, leading,
    cs),
    cs, hornerDerivativeList{ℝ}(realAdd, realZero, realOne, realMul, cs) with
    RealSquarefree.field, leadingIn, derivativeIn, derivativeData.left

theorem realSquarefreeGcd.list
  shows List(ℝ, realSquarefreeGcdLower)
proof
  have leadingIn : leading ∈ ℝ by exact initial
  have derivativeIn := hornerDerivativeLeading.closed with
    coefficients, reals.comm_ring, leadingIn
  have derivativeData := hornerDerivativeList.data with
    coefficients, reals.comm_ring, leadingIn
  unfold realSquarefreeGcdLower
  exact hornerGcdLower.list at ℝ, realAdd, realZero, realNeg, realMul,
    realOne, leading,
    hornerDerivativeLeading{ℝ}(realAdd, realZero, realOne, realMul, leading,
    cs),
    cs, hornerDerivativeList{ℝ}(realAdd, realZero, realOne, realMul, cs) with
    RealSquarefree.field, leadingIn, derivativeIn, derivativeData.left

theorem realSquarefreeGcd.nonzero
  shows realSquarefreeGcdLeading ≠ realZero
proof
  have leadingIn : leading ∈ ℝ by exact initial
  have derivativeIn := hornerDerivativeLeading.closed with
    coefficients, reals.comm_ring, leadingIn
  have derivativeData := hornerDerivativeList.data with
    coefficients, reals.comm_ring, leadingIn
  unfold realSquarefreeGcdLeading
  exact hornerGcd.nonzero_of_left at ℝ, realAdd, realZero, realNeg, realMul,
    realOne, leading,
    hornerDerivativeLeading{ℝ}(realAdd, realZero, realOne, realMul, leading,
    cs),
    cs, hornerDerivativeList{ℝ}(realAdd, realZero, realOne, realMul, cs) with
    RealSquarefree.field, leadingIn, derivativeIn, derivativeData.left, nonzero

theorem realSquarefreeGcd.divides_derivative
  shows HornerDivides(ℝ, realAdd, realZero, realNeg, realMul, realOne,
    realSquarefreeGcdLeading, realSquarefreeGcdLower,
    hornerDerivativeLeading{ℝ}(realAdd, realZero, realOne, realMul, leading,
    cs),
    hornerDerivativeList{ℝ}(realAdd, realZero, realOne, realMul, cs))
proof
  have leadingIn : leading ∈ ℝ by exact initial
  have derivativeIn := hornerDerivativeLeading.closed with
    coefficients, reals.comm_ring, leadingIn
  have derivativeData := hornerDerivativeList.data with
    coefficients, reals.comm_ring, leadingIn
  unfold realSquarefreeGcdLeading
  unfold realSquarefreeGcdLower
  exact hornerGcd.divides_right at ℝ, realAdd, realZero, realNeg, realMul,
    realOne, leading,
    hornerDerivativeLeading{ℝ}(realAdd, realZero, realOne, realMul, leading,
    cs),
    cs, hornerDerivativeList{ℝ}(realAdd, realZero, realOne, realMul, cs) with
    RealSquarefree.field, leadingIn, derivativeIn, derivativeData.left

-- p = q·d in the polynomial ring, q the squarefree list and d the gcd.
theorem realSquarefreeList.quotient
  shows RealSquarefree.poly(leading, cs) =
    P[RealSquarefree.poly(realZero, realSquarefreeList) *
      RealSquarefree.poly(realSquarefreeGcdLeading, realSquarefreeGcdLower)]
proof
  have leadingIn : leading ∈ ℝ by exact initial
  have derivativeIn := hornerDerivativeLeading.closed with
    coefficients, reals.comm_ring, leadingIn
  have derivativeData := hornerDerivativeList.data with
    coefficients, reals.comm_ring, leadingIn
  have gcdIn := realSquarefreeGcd.real at leading, cs with
    initial, coefficients, nonzero
  have gcdList := realSquarefreeGcd.list at leading, cs with
    initial, coefficients, nonzero
  have gcdNonzero := realSquarefreeGcd.nonzero at leading, cs with
    initial, coefficients, nonzero
  have divides : HornerDivides(ℝ, realAdd, realZero, realNeg, realMul, realOne,
      realSquarefreeGcdLeading, realSquarefreeGcdLower, leading, cs)
    unfold realSquarefreeGcdLeading
    unfold realSquarefreeGcdLower
    exact hornerGcd.divides_left at ℝ, realAdd, realZero, realNeg, realMul,
      realOne, leading,
      hornerDerivativeLeading{ℝ}(realAdd, realZero, realOne, realMul, leading,
        cs),
      cs, hornerDerivativeList{ℝ}(realAdd, realZero, realOne, realMul, cs) with
      RealSquarefree.field, leadingIn, derivativeIn, derivativeData.left
  have quotient := HornerDivides.quotient at ℝ, realAdd, realZero, realNeg,
    realMul, realOne, realSquarefreeGcdLeading, leading,
    realSquarefreeGcdLower, cs with
    RealSquarefree.field, gcdIn, gcdNonzero, leadingIn, divides
  unfold RealSquarefree.poly
  unfold realSquarefreeList
  unfold squarefreePartList
  unfold realSquarefreeGcdLeading
  unfold realSquarefreeGcdLower
  unfold realSquarefreeGcdLeading at quotient
  unfold realSquarefreeGcdLower at quotient
  exact quotient

-- The squarefree list is a list of reals one longer than cs, and it
-- divides the pair.
theorem realSquarefreeList.list
  shows List(ℝ, realSquarefreeList)
proof
  have leadingIn : leading ∈ ℝ by exact initial
  unfold realSquarefreeList
  exact squarefreePartList.list at ℝ, realAdd, realZero, realNeg, realMul,
    realOne, leading, cs with RealSquarefree.field, leadingIn

theorem realSquarefreeList.length
  shows length{ℝ}(realSquarefreeList) = succ(length{ℝ}(cs))
proof
  have leadingIn : leading ∈ ℝ by exact initial
  have derivativeIn := hornerDerivativeLeading.closed with
    coefficients, reals.comm_ring, leadingIn
  have derivativeData := hornerDerivativeList.data with
    coefficients, reals.comm_ring, leadingIn
  have gcdIn := hornerGcdLeading.mem at ℝ, realAdd, realZero, realNeg, realMul,
    realOne, leading,
    hornerDerivativeLeading{ℝ}(realAdd, realZero, realOne, realMul, leading,
    cs),
    cs, hornerDerivativeList{ℝ}(realAdd, realZero, realOne, realMul, cs) with
    RealSquarefree.field, leadingIn, derivativeIn, derivativeData.left
  have gcdList := hornerGcdLower.list at ℝ, realAdd, realZero, realNeg, realMul,
    realOne, leading,
    hornerDerivativeLeading{ℝ}(realAdd, realZero, realOne, realMul, leading,
    cs),
    cs, hornerDerivativeList{ℝ}(realAdd, realZero, realOne, realMul, cs) with
    RealSquarefree.field, leadingIn, derivativeIn, derivativeData.left
  have gcdNonzero := hornerGcd.nonzero_of_left at ℝ, realAdd, realZero, realNeg,
    realMul, realOne, leading,
    hornerDerivativeLeading{ℝ}(realAdd, realZero, realOne, realMul, leading,
    cs),
    cs, hornerDerivativeList{ℝ}(realAdd, realZero, realOne, realMul, cs) with
    RealSquarefree.field, leadingIn, derivativeIn, derivativeData.left, nonzero
  have data := hornerDivQuotient.data at ℝ, realAdd, realZero, realNeg, realMul,
    realOne,
    hornerGcdLeading{ℝ}(realAdd, realZero, realNeg, realMul, realOne, leading,
      hornerDerivativeLeading{ℝ}(realAdd, realZero, realOne, realMul, leading,
        cs), cs,
      hornerDerivativeList{ℝ}(realAdd, realZero, realOne, realMul, cs)),
    leading,
    hornerGcdLower{ℝ}(realAdd, realZero, realNeg, realMul, realOne, leading,
      hornerDerivativeLeading{ℝ}(realAdd, realZero, realOne, realMul, leading,
        cs), cs,
      hornerDerivativeList{ℝ}(realAdd, realZero, realOne, realMul, cs)),
    cs with RealSquarefree.field, gcdIn, gcdNonzero, leadingIn, gcdList
  unfold realSquarefreeList
  unfold squarefreePartList
  exact data.right

theorem realSquarefreeList.divides
  shows HornerDivides(ℝ, realAdd, realZero, realNeg, realMul, realOne,
    realZero, realSquarefreeList, leading, cs)
proof
  have leadingIn : leading ∈ ℝ by exact initial
  unfold realSquarefreeList
  exact squarefreePartList.divides at ℝ, realAdd, realZero, realNeg, realMul,
    realOne, leading, cs with RealSquarefree.field, leadingIn, nonzero

-- A root of a squarefree pair is not a root of the derivative.
theorem RealSquarefree.simple_root (X : Real)
  requires squarefree : RealSquarefree(leading, cs)
  requires root : hornerFunction(leading, cs)(X) = (0:R)
  shows hornerFunction(realDerivativeLeading(leading, cs),
    realDerivativeList(cs))(X) ≠ (0:R)
proof
  have realX : X ∈ ℝ by simp [Real]
  have leadingIn : leading ∈ ℝ by exact initial
  have derivativeReal := realDerivativeLeading.real at leading, cs with
    initial, coefficients
  have derivativeList := realDerivativeList.list at leading, cs with
    initial, coefficients
  have value := hornerFunction.value_at at leading, cs, X with
    initial, coefficients
  have derivativeValue := hornerFunction.value_at at
    realDerivativeLeading(leading, cs), realDerivativeList(cs), X with
    derivativeReal, derivativeList
  rw value at root
  rw derivativeValue
  unfold realDerivativeLeading
  unfold realDerivativeList
  unfold RealSquarefree at squarefree
  exact HornerSquarefree.simple_root at ℝ, realAdd, realZero, realNeg, realMul,
    realOne, leading, X, cs with RealSquarefree.field, leadingIn, realX,
    squarefree, root

theorem squarefreeLeading.real
  shows Real(squarefreeLeading)
proof
  have zeroIn : realZero ∈ ℝ := realZero.real
  have list := realSquarefreeList.list at leading, cs with
    initial, coefficients, nonzero
  unfold squarefreeLeading
  exact hornerTrimLeading.mem at ℝ, realZero, realSquarefreeList with zeroIn

theorem squarefreeLower.list
  shows List(ℝ, squarefreeLower)
proof
  have list := realSquarefreeList.list at leading, cs with
    initial, coefficients, nonzero
  unfold squarefreeLower
  exact hornerTrimLower.list at ℝ, realZero, realSquarefreeList with list

theorem squarefreeLeading.nonzero
  shows squarefreeLeading ≠ (0:R)
proof
  have zeroIn : realZero ∈ ℝ := realZero.real
  have leadingIn : leading ∈ ℝ by exact initial
  have list := realSquarefreeList.list at leading, cs with
    initial, coefficients, nonzero
  have divides := realSquarefreeList.divides at leading, cs with
    initial, coefficients, nonzero
  intro zero
  unfold squarefreeLeading at zero
  have iff := hornerTrim.zero_iff at ℝ, realZero, realSquarefreeList
  have entries := iff.forward with zero
  have vanishes : HornerZero(ℝ, realZero, realZero, realSquarefreeList)
    unfold HornerZero
    intros k kNat
    rw RealSquarefree.coefficient_zero_leading at ℝ, realZero,
      realSquarefreeList, k with zeroIn
    exact entries with k, kNat
  have zeroIff := hornerPoly.zero_iff at ℝ, realAdd, realZero, realNeg,
    realMul, realOne, realZero, realSquarefreeList with reals.comm_ring, zeroIn
  have partZero := zeroIff.backward with vanishes
  obtain ⟨qs, qsList, equation⟩ := divides
  rw partZero at equation
  have ringP := polynomials.comm_ring at oneVariable, ℝ, realAdd, realZero,
    realNeg, realMul, realOne with reals.comm_ring
  have qsIn := hornerPoly.member at ℝ, realAdd, realZero, realNeg, realMul,
    realOne, realZero, qs with reals.comm_ring, zeroIn
  have killed := IsRing.mul_zero with (IsCommRing.ring with ringP), qsIn
  rw killed at equation
  have leadingIff := hornerPoly.zero_iff at ℝ, realAdd, realZero, realNeg,
    realMul, realOne, leading, cs with reals.comm_ring, leadingIn
  have allZero := leadingIff.forward with equation
  unfold HornerZero at allZero
  have lengthNat : Nat(length{ℝ}(cs)) by typecheck
  have top := allZero with length{ℝ}(cs), lengthNat
  rw hornerCoefficient.leading at ℝ, realZero, leading, cs with leadingIn at top
  exact nonzero with top

theorem squarefreeLower.length_le
  shows length{ℝ}(squarefreeLower) ≤ length{ℝ}(cs)
proof
  have list := realSquarefreeList.list at leading, cs with
    initial, coefficients, nonzero
  have length := realSquarefreeList.length at leading, cs with
    initial, coefficients, nonzero
  have nonempty : realSquarefreeList ≠ []
    intro empty
    rw empty at length
    rw length.nil at length
    arith
  have less := hornerTrim.length_lt at ℝ, realZero, realSquarefreeList with
    nonempty
  unfold squarefreeLower
  rw length at less
  arith

theorem squarefreePart.divides
  shows HornerDivides(ℝ, realAdd, realZero, realNeg, realMul, realOne,
    squarefreeLeading, squarefreeLower, leading, cs)
proof
  have list := realSquarefreeList.list at leading, cs with
    initial, coefficients, nonzero
  have divides := realSquarefreeList.divides at leading, cs with
    initial, coefficients, nonzero
  have trimmed := RealSquarefree.trim_poly at realSquarefreeList with list
  obtain ⟨qs, qsList, equation⟩ := divides
  unfold squarefreeLeading
  unfold squarefreeLower
  refine ⟨qs, qsList, ?_⟩
  rw trimmed
  exact equation

-- In characteristic zero the squarefree part is squarefree and keeps
-- the roots.
theorem squarefreePart.squarefree
  shows RealSquarefree(squarefreeLeading, squarefreeLower)
proof
  have sqfReal := squarefreeLeading.real at leading, cs with
    initial, coefficients, nonzero
  have sqfList := squarefreeLower.list at leading, cs with
    initial, coefficients, nonzero
  have sqfNonzero := squarefreeLeading.nonzero at leading, cs with
    initial, coefficients, nonzero
  have sqfIn : squarefreeLeading ∈ ℝ by exact sqfReal
  have leadingIn : leading ∈ ℝ by exact initial
  have zeroIn : realZero ∈ ℝ := realZero.real
  have oneIn : realOne ∈ ℝ := realOne.real
  have ringP := RealSquarefree.ring_P
  have index := RealSquarefree.index
  have list := realSquarefreeList.list at leading, cs with
    initial, coefficients, nonzero
  have trimmed := RealSquarefree.trim_poly at realSquarefreeList with list
  have gIn := realSquarefreeGcd.real at leading, cs with
    initial, coefficients, nonzero
  have gsList := realSquarefreeGcd.list at leading, cs with
    initial, coefficients, nonzero
  have gNonzero := realSquarefreeGcd.nonzero at leading, cs with
    initial, coefficients, nonzero
  have quotient := realSquarefreeList.quotient at leading, cs with
    initial, coefficients, nonzero
  have sqfPoly : RealSquarefree.poly(realZero, realSquarefreeList) =
      RealSquarefree.poly(squarefreeLeading, squarefreeLower)
    unfold RealSquarefree.poly
    unfold squarefreeLeading
    unfold squarefreeLower
    symm
    exact trimmed
  rw sqfPoly at quotient
  have sqfDerivativeIn := hornerDerivativeLeading.closed at ℝ, realAdd,
    realZero, realNeg, realMul, realOne, squarefreeLeading, squarefreeLower with
    reals.comm_ring, sqfIn
  have sqfDerivativeData := hornerDerivativeList.data at ℝ, realAdd,
    realZero, realNeg, realMul, realOne, squarefreeLeading, squarefreeLower with
    reals.comm_ring, sqfIn
  have sqfDerivativeList := sqfDerivativeData.left
  have qIn := RealSquarefree.poly.member at squarefreeLeading, squarefreeLower
    with sqfIn
  have qPair := RealSquarefree.IsPair.of_poly at squarefreeLeading,
    squarefreeLower with sqfIn
  have qDerivation := RealSquarefree.derivation.poly at squarefreeLeading,
    squarefreeLower with sqfIn
  have dIn := RealSquarefree.poly.member at realSquarefreeGcdLeading,
    realSquarefreeGcdLower with gIn
  unfold RealSquarefree
  apply HornerCoprime.of_no_common_factor at ℝ, realAdd, realZero, realNeg,
    realMul, realOne, squarefreeLeading,
    hornerDerivativeLeading{ℝ}(realAdd, realZero, realOne, realMul,
      squarefreeLeading, squarefreeLower),
    squarefreeLower,
    hornerDerivativeList{ℝ}(realAdd, realZero, realOne, realMul,
    squarefreeLower)
    with RealSquarefree.field, sqfIn, sqfDerivativeIn, sqfNonzero
  intros h hIn hNonzero hs hsList hsNonempty both
  obtain ⟨dividesQ, dividesDerivative⟩ := both
  have typedH : Real(h) by exact hIn
  have eIn := RealSquarefree.poly.member at h, hs with hIn
  have ePair := RealSquarefree.IsPair.of_poly at h, hs with hIn
  have eDerivation := RealSquarefree.derivation.poly at h, hs with hIn
  have eDerivationIn := RealSquarefree.derivation.member with eIn
  have eDerivationPair := RealSquarefree.IsPair.derivation with ePair
  have eDerivativeIn := hornerDerivativeLeading.closed at ℝ, realAdd, realZero,
    realNeg, realMul, realOne, h, hs with reals.comm_ring, hIn
  have eDerivativeData := hornerDerivativeList.data at ℝ, realAdd, realZero,
    realNeg, realMul, realOne, h, hs with reals.comm_ring, hIn
  have eDerivativeList := eDerivativeData.left
  -- Q = S·E and Q′ = U·E, so S·E′ = (U − S′)·E.
  obtain ⟨ss, ssList, qFactorRaw⟩ := dividesQ
  obtain ⟨us, usList, derivativeFactorRaw⟩ := dividesDerivative
  have qFactor : RealSquarefree.poly(squarefreeLeading, squarefreeLower) =
      P[RealSquarefree.poly(realZero, ss) * RealSquarefree.poly(h, hs)]
    unfold RealSquarefree.poly
    exact qFactorRaw
  have derivativeFactor : RealSquarefree.poly(
      hornerDerivativeLeading{ℝ}(realAdd, realZero, realOne, realMul,
        squarefreeLeading, squarefreeLower),
      hornerDerivativeList{ℝ}(realAdd, realZero, realOne, realMul,
        squarefreeLower)) =
      P[RealSquarefree.poly(realZero, us) * RealSquarefree.poly(h, hs)]
    unfold RealSquarefree.poly
    exact derivativeFactorRaw
  rw derivativeFactor at qDerivation
  have sIn := RealSquarefree.poly.member at realZero, ss with zeroIn
  have sPair := RealSquarefree.IsPair.of_poly at realZero, ss with zeroIn
  have sDerivationIn := RealSquarefree.derivation.member with sIn
  have sDerivationPair := RealSquarefree.IsPair.derivation with sPair
  have uIn := RealSquarefree.poly.member at realZero, us with zeroIn
  have uPair := RealSquarefree.IsPair.of_poly at realZero, us with zeroIn
  have productRule := RealSquarefree.derivation.mul at
    RealSquarefree.poly(realZero, ss), RealSquarefree.poly(h, hs) with sIn, eIn
  rw ← qFactor at productRule
  rw qDerivation at productRule
  have negPair := RealSquarefree.IsPair.neg with sDerivationPair
  have wPair := RealSquarefree.IsPair.add with uPair, negPair
  obtain ⟨ws, wsList, wsEqual⟩ := wPair
  have relation : P[RealSquarefree.poly(realZero, ss) *
      RealSquarefree.derivation(RealSquarefree.poly(h, hs))] =
    P[RealSquarefree.poly(realZero, ws) * RealSquarefree.poly(h, hs)]
    rw ← wsEqual
    have expand : P[RealSquarefree.poly(realZero, ss) *
        RealSquarefree.derivation(RealSquarefree.poly(h, hs))] =
      P[(RealSquarefree.derivation(RealSquarefree.poly(realZero, ss)) *
          RealSquarefree.poly(h, hs) +
        RealSquarefree.poly(realZero, ss) *
          RealSquarefree.derivation(RealSquarefree.poly(h, hs))) +
        -(RealSquarefree.derivation(RealSquarefree.poly(realZero, ss)) *
          RealSquarefree.poly(h, hs))] by ring
    rw [expand, ← productRule]
    ring
  -- the gcd F of E and S.
  have fIn := hornerGcdLeading.mem at ℝ, realAdd, realZero, realNeg, realMul,
    realOne, h, realZero, hs, ss with RealSquarefree.field, hIn, zeroIn
  have fsList := hornerGcdLower.list at ℝ, realAdd, realZero, realNeg, realMul,
    realOne, h, realZero, hs, ss with RealSquarefree.field, hIn, zeroIn
  have fNonzero := hornerGcd.nonzero_of_left at ℝ, realAdd, realZero, realNeg,
    realMul, realOne, h, realZero, hs, ss with RealSquarefree.field, hIn,
    zeroIn, hNonzero
  have fDividesE := hornerGcd.divides_left at ℝ, realAdd, realZero, realNeg,
    realMul, realOne, h, realZero, hs, ss with RealSquarefree.field, hIn, zeroIn
  have fDividesS := hornerGcd.divides_right at ℝ, realAdd, realZero, realNeg,
    realMul, realOne, h, realZero, hs, ss with RealSquarefree.field, hIn, zeroIn
  have normal := hornerGcd.normal at ℝ, realAdd, realZero, realNeg, realMul,
    realOne, h, realZero, hs, ss with RealSquarefree.field, hIn, zeroIn
  have typedF : Real(hornerGcdLeading{ℝ}(realAdd, realZero, realNeg, realMul,
    realOne, h, realZero, hs, ss)) by exact fIn
  have decide : hornerGcdLower{ℝ}(realAdd, realZero, realNeg, realMul, realOne,
      h, realZero, hs, ss) = [] ∨
    hornerGcdLower{ℝ}(realAdd, realZero, realNeg, realMul, realOne, h, realZero,
      hs, ss) ≠ [] by tauto
  cases decide with constant | nonconstant
  . -- E and S coprime: Euclid gives E | E′, against the degrees.
    have iff := HornerCoprime.iff_gcd_constant at ℝ, realAdd, realZero,
      realNeg, realMul, realOne, h, realZero, hs, ss with
      RealSquarefree.field, hIn, zeroIn
    have coprime := iff.backward with ⟨fNonzero, constant⟩
    have product := RealSquarefree.poly.mul at realZero,
      hornerDerivativeLeading{ℝ}(realAdd, realZero, realOne, realMul, h, hs),
      ss, hornerDerivativeList{ℝ}(realAdd, realZero, realOne, realMul, hs) with
      zeroIn, eDerivativeIn
    rw ← eDerivation at product
    rw relation at product
    have dividesProduct : HornerDivides(ℝ, realAdd, realZero, realNeg, realMul,
        realOne, h, hs,
        F[realZero * hornerDerivativeLeading{ℝ}(realAdd, realZero, realOne,
          realMul, h, hs)],
        hornerMulList{ℝ}(realAdd, realZero, realMul, realZero,
          hornerDerivativeLeading{ℝ}(realAdd, realZero, realOne, realMul, h,
          hs),
          ss, hornerDerivativeList{ℝ}(realAdd, realZero, realOne, realMul, hs)))
      refine ⟨ws, wsList, ?_⟩
      unfold RealSquarefree.poly at product
      exact product
    have euclid := HornerCoprime.divides_of_divides_mul at ℝ, realAdd, realZero,
      realNeg, realMul, realOne, h, realZero,
      hornerDerivativeLeading{ℝ}(realAdd, realZero, realOne, realMul, h, hs),
      hs, ss, hornerDerivativeList{ℝ}(realAdd, realZero, realOne, realMul, hs)
      with RealSquarefree.field, hIn, zeroIn, eDerivativeIn, coprime,
      dividesProduct
    have derivativeNonzero := RealSquarefree.derivative_leading_nonzero at h, hs
      with hIn, hNonzero, hsNonempty
    have bound := HornerDivides.length_le at ℝ, realAdd, realZero, realNeg,
      realMul, realOne, h,
      hornerDerivativeLeading{ℝ}(realAdd, realZero, realOne, realMul, h, hs),
      hs, hornerDerivativeList{ℝ}(realAdd, realZero, realOne, realMul, hs) with
      RealSquarefree.field, hIn, hNonzero, eDerivativeIn, derivativeNonzero,
      euclid
    rw eDerivativeData.right at bound
    have shape := List.cases at ℝ, hs with *
    cases shape with empty | cons
    . exact hsNonempty with empty
    . obtain ⟨x, xIn, tail, tailList, equal⟩ := cons
      rw equal at bound
      rw length.cons at ℝ, x, tail with xIn at bound
      rw predecessor.succ at bound
      arith
  . -- F nonconstant divides S and E, so p = (S₁·E₁)·F²·d and every
    -- power of F divides d: against the degree of d.
    obtain ⟨s1, s1List, sFactorRaw⟩ := fDividesS
    obtain ⟨e1, e1List, eFactorRaw⟩ := fDividesE
    have sFactor : RealSquarefree.poly(realZero, ss) =
        P[RealSquarefree.poly(realZero, s1) *
          RealSquarefree.poly(hornerGcdLeading{ℝ}(realAdd, realZero, realNeg,
            realMul, realOne, h, realZero, hs, ss),
          hornerGcdLower{ℝ}(realAdd, realZero, realNeg, realMul, realOne, h,
            realZero, hs, ss))]
      unfold RealSquarefree.poly
      exact sFactorRaw
    have eFactor : RealSquarefree.poly(h, hs) =
        P[RealSquarefree.poly(realZero, e1) *
          RealSquarefree.poly(hornerGcdLeading{ℝ}(realAdd, realZero, realNeg,
            realMul, realOne, h, realZero, hs, ss),
          hornerGcdLower{ℝ}(realAdd, realZero, realNeg, realMul, realOne, h,
            realZero, hs, ss))]
      unfold RealSquarefree.poly
      exact eFactorRaw
    have s1Pair := RealSquarefree.IsPair.of_poly at realZero, s1 with zeroIn
    have e1Pair := RealSquarefree.IsPair.of_poly at realZero, e1 with zeroIn
    have s1In := RealSquarefree.poly.member at realZero, s1 with zeroIn
    have e1In := RealSquarefree.poly.member at realZero, e1 with zeroIn
    have fPolyIn := RealSquarefree.poly.member at
      hornerGcdLeading{ℝ}(realAdd, realZero, realNeg, realMul, realOne, h,
        realZero, hs, ss),
      hornerGcdLower{ℝ}(realAdd, realZero, realNeg, realMul, realOne, h,
        realZero, hs, ss) with fIn
    have nPair := RealSquarefree.IsPair.mul with s1Pair, e1Pair
    obtain ⟨ns, nsList, nsEqual⟩ := nPair
    have gcdForm : RealSquarefree.poly(realSquarefreeGcdLeading,
        realSquarefreeGcdLower) =
      RealSquarefree.poly(RealSquarefree.gcdLeading(leading, cs),
        RealSquarefree.gcdLower(leading, cs))
      unfold realSquarefreeGcdLeading
      unfold realSquarefreeGcdLower
      unfold RealSquarefree.gcdLeading
      unfold RealSquarefree.gcdLower
      rfl
    have factor : RealSquarefree.poly(leading, cs) =
        P[RealSquarefree.poly(realZero, ns) *
          RealSquarefree.poly(hornerGcdLeading{ℝ}(realAdd, realZero, realNeg,
            realMul, realOne, h, realZero, hs, ss),
          hornerGcdLower{ℝ}(realAdd, realZero, realNeg, realMul, realOne, h,
            realZero, hs, ss)) *
          RealSquarefree.poly(hornerGcdLeading{ℝ}(realAdd, realZero, realNeg,
            realMul, realOne, h, realZero, hs, ss),
          hornerGcdLower{ℝ}(realAdd, realZero, realNeg, realMul, realOne, h,
            realZero, hs, ss)) *
          RealSquarefree.poly(RealSquarefree.gcdLeading(leading, cs),
            RealSquarefree.gcdLower(leading, cs))]
      rw [quotient, qFactor, sFactor, eFactor, ← nsEqual, ← gcdForm]
      ring
    have lengthNat : Nat(length{ℝ}(realSquarefreeGcdLower)) by typecheck
    obtain ⟨ms, msList, powerDivides⟩ := RealSquarefree.power_chain at
      leading,
      hornerGcdLeading{ℝ}(realAdd, realZero, realNeg, realMul, realOne, h,
        realZero, hs, ss),
      cs, hornerGcdLower{ℝ}(realAdd, realZero, realNeg, realMul, realOne, h,
        realZero, hs, ss), ns, succ(length{ℝ}(realSquarefreeGcdLower)) with
      leadingIn, fIn, factor
    rw ← gcdForm at powerDivides
    have powerData := RealSquarefree.pairPower.data at
      hornerGcdLeading{ℝ}(realAdd, realZero, realNeg, realMul, realOne, h,
        realZero, hs, ss),
      hornerGcdLower{ℝ}(realAdd, realZero, realNeg, realMul, realOne, h,
        realZero, hs, ss), succ(length{ℝ}(realSquarefreeGcdLower)) with fIn
    have powerList := powerData.left
    have powerIn : realPow(hornerGcdLeading{ℝ}(realAdd, realZero, realNeg,
      realMul, realOne, h, realZero, hs, ss),
      succ(length{ℝ}(realSquarefreeGcdLower))) ∈ ℝ by typecheck
    have powerNonzero := RealSquarefree.pow_nonzero at hornerGcdLeading{ℝ}(
      realAdd, realZero, realNeg, realMul, realOne, h, realZero, hs, ss),
      succ(length{ℝ}(realSquarefreeGcdLower)) with fIn, fNonzero
    have dividesPower : HornerDivides(ℝ, realAdd, realZero, realNeg, realMul,
        realOne,
        realPow(hornerGcdLeading{ℝ}(realAdd, realZero, realNeg, realMul,
          realOne, h, realZero, hs, ss),
          succ(length{ℝ}(realSquarefreeGcdLower))),
        RealSquarefree.pairPower(hornerGcdLeading{ℝ}(realAdd, realZero,
          realNeg, realMul, realOne, h, realZero, hs, ss),
          hornerGcdLower{ℝ}(realAdd, realZero, realNeg, realMul, realOne, h,
            realZero, hs, ss), succ(length{ℝ}(realSquarefreeGcdLower))),
        realSquarefreeGcdLeading, realSquarefreeGcdLower)
      refine ⟨ms, msList, ?_⟩
      unfold RealSquarefree.poly at powerDivides
      exact powerDivides
    have bound := HornerDivides.length_le at ℝ, realAdd, realZero, realNeg,
      realMul, realOne,
      realPow(hornerGcdLeading{ℝ}(realAdd, realZero, realNeg, realMul, realOne,
        h, realZero, hs, ss), succ(length{ℝ}(realSquarefreeGcdLower))),
      realSquarefreeGcdLeading,
      RealSquarefree.pairPower(hornerGcdLeading{ℝ}(realAdd, realZero, realNeg,
        realMul, realOne, h, realZero, hs, ss),
        hornerGcdLower{ℝ}(realAdd, realZero, realNeg, realMul, realOne, h,
          realZero, hs, ss), succ(length{ℝ}(realSquarefreeGcdLower))),
      realSquarefreeGcdLower with
      RealSquarefree.field, powerIn, powerNonzero, gIn, gNonzero, dividesPower
    rw powerData.right at bound
    have shape := List.cases at ℝ, hornerGcdLower{ℝ}(realAdd, realZero,
      realNeg, realMul, realOne, h, realZero, hs, ss) with fsList
    cases shape with empty | cons
    . exact nonconstant with empty
    . obtain ⟨x, xIn, tail, tailList, equal⟩ := cons
      rw equal at bound
      rw length.cons at ℝ, x, tail with xIn at bound
      have le := RealSquarefree.le_mul_succ at
        succ(length{ℝ}(realSquarefreeGcdLower)), length{ℝ}(tail)
      arith

theorem squarefreePart.roots
  shows rootSet(realRing, squarefreeLeading, squarefreeLower) =
    rootSet(realRing, leading, cs)
proof
  have sqfReal := squarefreeLeading.real at leading, cs with
    initial, coefficients, nonzero
  have sqfList := squarefreeLower.list at leading, cs with
    initial, coefficients, nonzero
  have sqfIn : squarefreeLeading ∈ ℝ by exact sqfReal
  have leadingIn : leading ∈ ℝ by exact initial
  have zeroIn : realZero ∈ ℝ := realZero.real
  have oneIn : realOne ∈ ℝ := realOne.real
  have divides := squarefreePart.divides at leading, cs with
    initial, coefficients, nonzero
  have list := realSquarefreeList.list at leading, cs with
    initial, coefficients, nonzero
  have trimmed := RealSquarefree.trim_poly at realSquarefreeList with list
  have reals := rootSet.subset_reals at squarefreeLeading, squarefreeLower
    with sqfReal, sqfList
  have realsP := rootSet.subset_reals at leading, cs with initial, coefficients
  ext X
  constructor
  . intro root
    have realX : X ∈ ℝ := reals with X, root
    have typedX : Real(X) by exact realX
    have iff := hornerFunction.root_iff at squarefreeLeading, squarefreeLower,
      X with sqfReal, sqfList
    have value := hornerFunction.value_at at squarefreeLeading,
      squarefreeLower, X with sqfReal, sqfList
    have zero := iff.forward with root
    rw value at zero
    have zeroP := HornerDivides.root at ℝ, realAdd, realZero, realNeg, realMul,
      realOne, squarefreeLeading, leading, X, squarefreeLower, cs with
      reals.comm_ring, sqfIn, leadingIn, realX, divides, zero
    have iffP := hornerFunction.root_iff at leading, cs, X with
      initial, coefficients
    have valueP := hornerFunction.value_at at leading, cs, X with
      initial, coefficients
    apply iffP.backward
    rw valueP
    exact zeroP
  . intro root
    have realX : X ∈ ℝ := realsP with X, root
    have typedX : Real(X) by exact realX
    have iffP := hornerFunction.root_iff at leading, cs, X with
      initial, coefficients
    have valueP := hornerFunction.value_at at leading, cs, X with
      initial, coefficients
    have zeroP := iffP.forward with root
    rw valueP at zeroP
    have iff := hornerFunction.root_iff at squarefreeLeading, squarefreeLower,
      X with sqfReal, sqfList
    have value := hornerFunction.value_at at squarefreeLeading,
      squarefreeLower, X with sqfReal, sqfList
    apply iff.backward
    rw value
    by_contra notRoot
    have trimmedDefs : hornerPoly{ℝ}(realAdd, realZero, realNeg, realMul,
        realOne, squarefreeLeading, squarefreeLower) =
      hornerPoly{ℝ}(realAdd, realZero, realNeg, realMul, realOne, realZero,
        realSquarefreeList)
      unfold squarefreeLeading
      unfold squarefreeLower
      exact trimmed
    have congr := hornerAt.congr_of_poly at ℝ, realAdd, realZero, realNeg,
      realMul, realOne, squarefreeLeading, realZero, X, squarefreeLower,
      realSquarefreeList with reals.comm_ring, sqfIn, zeroIn, realX,
      trimmedDefs
    have qNonzero : hornerAt{ℝ}(realAdd, realMul, realZero, X,
        realSquarefreeList) ≠ realZero
      rw ← congr
      exact notRoot
    have gIn := realSquarefreeGcd.real at leading, cs with
      initial, coefficients, nonzero
    have gsList := realSquarefreeGcd.list at leading, cs with
      initial, coefficients, nonzero
    have gNonzero := realSquarefreeGcd.nonzero at leading, cs with
      initial, coefficients, nonzero
    have quotient := realSquarefreeList.quotient at leading, cs with
      initial, coefficients, nonzero
    have ringP := RealSquarefree.ring_P
    have index := RealSquarefree.index
    have qIn := RealSquarefree.poly.member at realZero, realSquarefreeList
      with zeroIn
    have dIn := RealSquarefree.poly.member at realSquarefreeGcdLeading,
      realSquarefreeGcdLower with gIn
    have pIn := RealSquarefree.poly.member at leading, cs with leadingIn
    -- d(X) = 0 since p(X) = q(X)·d(X) and q(X) ≠ 0.
    have evaluated : RealSquarefree.evaluation(X)(RealSquarefree.poly(leading,
        cs)) = RealSquarefree.evaluation(X)(P[RealSquarefree.poly(realZero,
        realSquarefreeList) * RealSquarefree.poly(realSquarefreeGcdLeading,
        realSquarefreeGcdLower)])
      rw quotient
      rfl
    rw RealSquarefree.evaluation.mul at X, RealSquarefree.poly(realZero,
      realSquarefreeList), RealSquarefree.poly(realSquarefreeGcdLeading,
      realSquarefreeGcdLower) with realX, qIn, dIn at evaluated
    have pValue := RealSquarefree.poly.value at leading, X, cs with
      leadingIn, realX
    have qValue := RealSquarefree.poly.value at realZero, X, realSquarefreeList
      with zeroIn, realX
    have dValue := RealSquarefree.poly.value at realSquarefreeGcdLeading, X,
      realSquarefreeGcdLower with gIn, realX
    rw [pValue, qValue, dValue, zeroP] at evaluated
    have qReal : hornerAt{ℝ}(realAdd, realMul, realZero, X,
        realSquarefreeList) ∈ ℝ
      rw ← qValue
      exact RealSquarefree.evaluation.real at X, RealSquarefree.poly(realZero,
        realSquarefreeList) with realX, qIn
    have dReal : hornerAt{ℝ}(realAdd, realMul, realSquarefreeGcdLeading, X,
        realSquarefreeGcdLower) ∈ ℝ
      rw ← dValue
      exact RealSquarefree.evaluation.real at X,
        RealSquarefree.poly(realSquarefreeGcdLeading, realSquarefreeGcdLower)
        with realX, dIn
    have typedQ : Real(hornerAt{ℝ}(realAdd, realMul, realZero, X,
      realSquarefreeList)) by exact qReal
    have typedD : Real(hornerAt{ℝ}(realAdd, realMul, realSquarefreeGcdLeading,
      X, realSquarefreeGcdLower)) by exact dReal
    have productZero : hornerAt{ℝ}(realAdd, realMul, realZero, X,
        realSquarefreeList) * hornerAt{ℝ}(realAdd, realMul,
        realSquarefreeGcdLeading, X, realSquarefreeGcdLower) = (0:R)
      symm
      exact evaluated
    have cases := realMulValue.eq_zero_or with productZero
    have dRoot : hornerAt{ℝ}(realAdd, realMul, realSquarefreeGcdLeading, X,
        realSquarefreeGcdLower) = realZero
      cases cases with first | second
      . exfalso
        exact qNonzero with first
      . exact second
    -- q·d′ = t·d with t = u − q′, from d | p′ and the product rule.
    have derivativeIn := hornerDerivativeLeading.closed at ℝ, realAdd,
      realZero, realNeg, realMul, realOne, leading, cs with
      reals.comm_ring, leadingIn
    have derivativeData := hornerDerivativeList.data at ℝ, realAdd,
      realZero, realNeg, realMul, realOne, leading, cs with
      reals.comm_ring, leadingIn
    have derivativeList := derivativeData.left
    have dividesDerivative := realSquarefreeGcd.divides_derivative at leading,
      cs with initial, coefficients, nonzero
    obtain ⟨us, usList, cofactorRaw⟩ := dividesDerivative
    have cofactor : RealSquarefree.poly(
        hornerDerivativeLeading{ℝ}(realAdd, realZero, realOne, realMul, leading,
          cs),
        hornerDerivativeList{ℝ}(realAdd, realZero, realOne, realMul, cs)) =
      P[RealSquarefree.poly(realZero, us) *
        RealSquarefree.poly(realSquarefreeGcdLeading, realSquarefreeGcdLower)]
      unfold RealSquarefree.poly
      exact cofactorRaw
    have bridge := RealSquarefree.derivation.poly at leading, cs with leadingIn
    rw cofactor at bridge
    have productRule := RealSquarefree.derivation.mul at
      RealSquarefree.poly(realZero, realSquarefreeList),
      RealSquarefree.poly(realSquarefreeGcdLeading, realSquarefreeGcdLower) with
      qIn, dIn
    rw ← quotient at productRule
    rw bridge at productRule
    have uIn := RealSquarefree.poly.member at realZero, us with zeroIn
    have uPair := RealSquarefree.IsPair.of_poly at realZero, us with zeroIn
    have qPair := RealSquarefree.IsPair.of_poly at realZero, realSquarefreeList
      with zeroIn
    have qDerivationPair := RealSquarefree.IsPair.derivation with qPair
    have qDerivationIn := RealSquarefree.derivation.member with qIn
    have dDerivationIn := RealSquarefree.derivation.member with dIn
    have negPair := RealSquarefree.IsPair.neg with qDerivationPair
    have tPair := RealSquarefree.IsPair.add with uPair, negPair
    have relation : P[RealSquarefree.poly(realZero, realSquarefreeList) *
        RealSquarefree.derivation(RealSquarefree.poly(realSquarefreeGcdLeading,
          realSquarefreeGcdLower))] =
      P[(RealSquarefree.poly(realZero, us) +
        -RealSquarefree.derivation(RealSquarefree.poly(realZero,
          realSquarefreeList))) *
        RealSquarefree.poly(realSquarefreeGcdLeading, realSquarefreeGcdLower)]
      have expand : P[RealSquarefree.poly(realZero, realSquarefreeList) *
          RealSquarefree.derivation(RealSquarefree.poly(
            realSquarefreeGcdLeading, realSquarefreeGcdLower))] =
        P[(RealSquarefree.derivation(RealSquarefree.poly(realZero,
            realSquarefreeList)) *
          RealSquarefree.poly(realSquarefreeGcdLeading, realSquarefreeGcdLower)
          + RealSquarefree.poly(realZero, realSquarefreeList) *
          RealSquarefree.derivation(RealSquarefree.poly(
            realSquarefreeGcdLeading, realSquarefreeGcdLower))) +
          -(RealSquarefree.derivation(RealSquarefree.poly(realZero,
            realSquarefreeList)) *
          RealSquarefree.poly(realSquarefreeGcdLeading,
            realSquarefreeGcdLower))] by ring
      rw [expand, ← productRule]
      ring
    -- every power of X − r divides d: impossible beyond the degree of d.
    have lengthNat : Nat(length{ℝ}(realSquarefreeGcdLower)) by typecheck
    obtain ⟨es, esList, chain, powerDivides⟩ := RealSquarefree.chain at X,
      P[RealSquarefree.poly(realZero, us) +
        -RealSquarefree.derivation(RealSquarefree.poly(realZero,
          realSquarefreeList))],
      realSquarefreeGcdLeading, realSquarefreeList, realSquarefreeGcdLower,
      succ(length{ℝ}(realSquarefreeGcdLower)) with
      realX, gIn, tPair, qNonzero, dRoot, relation
    have powerData := RealSquarefree.linearPower.data at X,
      succ(length{ℝ}(realSquarefreeGcdLower)) with realX
    have powerList := powerData.left
    have oneNonzero : realOne ≠ realZero
      intro same
      linarith
    have dividesPower : HornerDivides(ℝ, realAdd, realZero, realNeg, realMul,
        realOne, realOne,
        RealSquarefree.linearPower(X, succ(length{ℝ}(realSquarefreeGcdLower))),
        realSquarefreeGcdLeading, realSquarefreeGcdLower)
      refine ⟨es, esList, ?_⟩
      unfold RealSquarefree.poly at powerDivides
      exact powerDivides
    have bound := HornerDivides.length_le at ℝ, realAdd, realZero, realNeg,
      realMul, realOne, realOne, realSquarefreeGcdLeading,
      RealSquarefree.linearPower(X, succ(length{ℝ}(realSquarefreeGcdLower))),
      realSquarefreeGcdLower with
      RealSquarefree.field, oneIn, oneNonzero, gIn, gNonzero, dividesPower
    rw powerData.right at bound
    arith

-- A squarefree pair is its own squarefree part up to the leading unit:
-- the part has the same declared degree.
theorem squarefreePart.length_of_squarefree
  requires squarefree : RealSquarefree(leading, cs)
  shows length{ℝ}(squarefreeLower) = length{ℝ}(cs)
proof
  have sqfReal := squarefreeLeading.real at leading, cs with
    initial, coefficients, nonzero
  have sqfList := squarefreeLower.list at leading, cs with
    initial, coefficients, nonzero
  have sqfNonzero := squarefreeLeading.nonzero at leading, cs with
    initial, coefficients, nonzero
  have sqfIn : squarefreeLeading ∈ ℝ by exact sqfReal
  have leadingIn : leading ∈ ℝ by exact initial
  have zeroIn : realZero ∈ ℝ := realZero.real
  have list := realSquarefreeList.list at leading, cs with
    initial, coefficients, nonzero
  have trimmed := RealSquarefree.trim_poly at realSquarefreeList with list
  have gIn := realSquarefreeGcd.real at leading, cs with
    initial, coefficients, nonzero
  have gNonzero := realSquarefreeGcd.nonzero at leading, cs with
    initial, coefficients, nonzero
  have quotient := realSquarefreeList.quotient at leading, cs with
    initial, coefficients, nonzero
  have gcdNil : realSquarefreeGcdLower = []
    unfold RealSquarefree at squarefree
    unfold realSquarefreeGcdLower
    exact HornerSquarefree.gcd_constant at ℝ, realAdd, realZero, realNeg,
      realMul, realOne, leading, cs with RealSquarefree.field, leadingIn,
      squarefree
  rw gcdNil at quotient
  have constant := RealSquarefree.poly.constant at realSquarefreeGcdLeading
    with gIn
  rw constant at quotient
  have sqfPoly : RealSquarefree.poly(realZero, realSquarefreeList) =
      RealSquarefree.poly(squarefreeLeading, squarefreeLower)
    unfold RealSquarefree.poly
    unfold squarefreeLeading
    unfold squarefreeLower
    symm
    exact trimmed
  rw sqfPoly at quotient
  have ringP := RealSquarefree.ring_P
  have index := RealSquarefree.index
  have sqfPolyIn := RealSquarefree.poly.member at squarefreeLeading,
    squarefreeLower with sqfIn
  have constantPair := RealSquarefree.IsPair.constant at
    realSquarefreeGcdLeading with gIn
  have constantIn := RealSquarefree.IsPair.member with constantPair
  have scaled := hornerPoly.scale at ℝ, realAdd, realZero, realNeg, realMul,
    realOne, realSquarefreeGcdLeading, squarefreeLeading, squarefreeLower with
    reals.comm_ring, gIn, sqfIn
  have commuted : P[RealSquarefree.poly(squarefreeLeading, squarefreeLower) *
      polynomialConstant(oneVariable, F, realSquarefreeGcdLeading)] =
    P[polynomialConstant(oneVariable, F, realSquarefreeGcdLeading) *
      RealSquarefree.poly(squarefreeLeading, squarefreeLower)] by ring
  rw commuted at quotient
  unfold RealSquarefree.poly at quotient
  rw ← scaled at quotient
  have typedG : Real(realSquarefreeGcdLeading) by exact gIn
  have typedSqf : Real(squarefreeLeading) by exact sqfReal
  have productIn : F[realSquarefreeGcdLeading * squarefreeLeading] ∈ ℝ by
    typecheck
  have productNonzero : F[realSquarefreeGcdLeading * squarefreeLeading] ≠
      realZero
    intro same
    have cases := realMulValue.eq_zero_or with same
    cases cases with first | second
    . exact gNonzero with first
    . exact sqfNonzero with second
  have scaleData := hornerScale.data at ℝ, realAdd, realZero, realNeg, realMul,
    realOne, realSquarefreeGcdLeading, squarefreeLower with reals.comm_ring,
    gIn
  have scaleList := scaleData.left
  unfold hornerPoly at quotient
  have same := polynomialFromHorner.length_unique at oneVariable, ℝ, realAdd,
    realZero, realNeg, realMul, realOne, 0, leading,
    F[realSquarefreeGcdLeading * squarefreeLeading], cs,
    hornerScale{ℝ}(realMul, realSquarefreeGcdLeading, squarefreeLower) with
    reals.comm_ring, index, leadingIn, productIn, nonzero, productNonzero,
    quotient
  rw [same, scaleData.right]
  rfl

end Polynomials
