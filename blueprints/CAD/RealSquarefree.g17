-- Squarefree real polynomials and the squarefree part: a real pair is
-- squarefree when it is coprime to its derivative; its roots are then
-- simple. The squarefree part, the quotient by the gcd with the
-- derivative brought to normal form, is squarefree and has the same real
-- roots.
-- Part of the CAD blueprint.
-- Planned home: Real/Analysis/PolynomialSquarefree.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module CAD.RealSquarefree
import CAD.HornerGcd
import CAD.RealHorner

predicate RealSquarefree (leading cs : Set) :=
  HornerSquarefree(ℝ, realAdd, realZero, realNeg, realMul, realOne, leading, cs)

predicate RealCoprime (a cs b ds : Set) :=
  HornerCoprime(ℝ, realAdd, realZero, realNeg, realMul, realOne, a, cs, b, ds)

section Polynomials
variable (leading cs : Set)
hypothesis initial : Real(leading)
hypothesis coefficients : List(ℝ, cs)
hypothesis nonzero : leading ≠ (0:R)

-- The squarefree part as a full list, and in normal form.
def realSquarefreeList : Set :=
  squarefreePartList{ℝ}(realAdd, realZero, realNeg, realMul, realOne, leading,
    cs)
def squarefreeLeading : Set :=
  hornerTrimLeading{ℝ}(realZero, realSquarefreeList)
def squarefreeLower : Set :=
  hornerTrimLower{ℝ}(realZero, realSquarefreeList)

-- A root of a squarefree pair is not a root of the derivative.
theorem RealSquarefree.simple_root (X : Real)
  requires squarefree : RealSquarefree(leading, cs)
  requires root : hornerFunction(leading, cs)(X) = (0:R)
  shows hornerFunction(realDerivativeLeading(leading, cs),
    realDerivativeList(cs))(X) ≠ (0:R)
proof
  sorry

theorem squarefreeLeading.real
  shows Real(squarefreeLeading)
proof
  sorry

theorem squarefreeLower.list
  shows List(ℝ, squarefreeLower)
proof
  sorry

theorem squarefreeLeading.nonzero
  shows squarefreeLeading ≠ (0:R)
proof
  sorry

theorem squarefreeLower.length_le
  shows length{ℝ}(squarefreeLower) ≤ length{ℝ}(cs)
proof
  sorry

theorem squarefreePart.divides
  shows HornerDivides(ℝ, realAdd, realZero, realNeg, realMul, realOne,
    squarefreeLeading, squarefreeLower, leading, cs)
proof
  sorry

-- In characteristic zero the squarefree part is squarefree and keeps
-- the roots.
theorem squarefreePart.squarefree
  shows RealSquarefree(squarefreeLeading, squarefreeLower)
proof
  sorry

theorem squarefreePart.roots
  shows rootSet(realRing, squarefreeLeading, squarefreeLower) =
    rootSet(realRing, leading, cs)
proof
  sorry

-- A squarefree pair is its own squarefree part up to the leading unit:
-- the part has the same declared degree.
theorem squarefreePart.length_of_squarefree
  requires squarefree : RealSquarefree(leading, cs)
  shows length{ℝ}(squarefreeLower) = length{ℝ}(cs)
proof
  sorry

end Polynomials
