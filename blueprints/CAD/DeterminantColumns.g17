module CAD.DeterminantColumns
import Grace.Cumulus.Algebra.Ring.DeterminantRows
import Grace.Cumulus.Algebra.Ring.DeterminantZero
import Grace.Cumulus.Algebra.Ring.DeterminantRowPermutation
import Grace.Cumulus.Algebra.Ring.DoubleSum

defgraph matrixOfEntries (n A g : Set) (p ∈ n × n) : A := g(p)
requires entries : g : n × n → A
proof
  exact FunctionBetween.apply_closed with *

theorem matrixOfEntries.matrix (n A g : Set)
  requires entries : g : n × n → A
  shows RingMatrix(n, A, matrixOfEntries(n, A, g))
proof
  unfold RingMatrix
  exact matrixOfEntries.function with entries

theorem matrixOfEntries.entry (n A g i j : Set)
  requires entries : g : n × n → A
  requires row : i ∈ n
  requires column : j ∈ n
  shows matrixOfEntries(n, A, g)[i, j] = g((i, j))
proof
  have pair := product.pair with row, column
  exact matrixOfEntries.value with entries, pair

theorem transposedMatrix.matrix (n A M : Set)
  requires matrix : RingMatrix(n, A, M)
  shows RingMatrix(n, A, transposedMatrix(n, n, A, M))
proof
  unfold RingMatrix at matrix
  unfold RingMatrix
  exact transposedMatrix.function with matrix

theorem transposedMatrix.entry (n A M i j : Set)
  requires matrix : RingMatrix(n, A, M)
  requires row : i ∈ n
  requires column : j ∈ n
  shows transposedMatrix(n, n, A, M)[i, j] = M[j, i]
proof
  unfold RingMatrix at matrix
  exact transposedMatrix.pair at n, n, A, M, j, i with matrix, column, row

-- Inversion, p ↦ p⁻¹, as a map on the permutations of n.
defgraph permutationInverse (n : Set) (p ∈ permutations(n)) :
    permutations(n) := converse(p, n, n)
proof
  exact permutations.converse at n, p with assumption

theorem permutationInverse.involution (n p : Set)
  requires hp : p ∈ permutations(n)
  shows permutationInverse(n)(permutationInverse(n)(p)) = p
proof
  have inverse := permutations.converse at n, p with hp
  have once := permutationInverse.value at n, p with hp
  have twice := permutationInverse.value at n, converse(p, n, n) with inverse
  have function := permutations.function with hp
  have relation := FunctionBetween.relation with function
  have back := converse.converse at p, n, n with relation
  rw [once, twice, back]
  rfl

theorem permutationInverse.bijective (n : Set)
  shows BijectiveBetween(permutationInverse(n), permutations(n),
    permutations(n))
proof
  have function := permutationInverse.function at n
  have injective : InjectiveBetween(permutationInverse(n), permutations(n),
      permutations(n))
    have cancel : ∀ p ∈ permutations(n), ∀ q ∈ permutations(n),
        permutationInverse(n)(p) = permutationInverse(n)(q) → p = q
      intros p hp q hq same
      have restoreP := permutationInverse.involution at n, p with hp
      have restoreQ := permutationInverse.involution at n, q with hq
      rw [← restoreP, ← restoreQ, same]
      rfl
    exact Injective.of_pointwise with function, cancel
  have surjective : SurjectiveBetween(permutationInverse(n), permutations(n),
      permutations(n))
    constructor
    . exact function
    . intros r hr
      have preimage := FunctionBetween.apply_closed with function, hr
      have restore := permutationInverse.involution at n, r with hr
      witness permutationInverse(n)(r)
      constructor
      . exact preimage
      . have related := FunctionBetween.relates_apply with function, preimage
        rw restore at related
        exact related
  exact ⟨injective, surjective⟩

section Rings
variable (A add zero neg mul one : Set)
notation ring R := (A, add, zero, neg, mul, one)
hypothesis ring : IsCommRing(R)

-- A power of −1 is its own inverse.
theorem negOnePow.mul_self (k : Nat)
  shows R[monoidPow(mul, one, neg(one), k) * monoidPow(mul, one, neg(one), k)] =
    R[1]
proof
  induction k
  | zero =>
    rw monoidPow.zero
    ring
  | succ(m) using ih =>
    have ordinary := IsCommRing.ring with ring
    have multiplicative := IsRing.multiplicative with ordinary
    have unitIn := IsMonoid.unit_in_carrier with multiplicative
    have negative := IsRing.neg_closed with ordinary, unitIn
    have closed := monoidPow.closed at A, mul, one, neg(one), m with
      multiplicative, negative
    rw monoidPow.succ
    linear_combination ih

theorem permutationSign.mul_self (n : Nat) (σ : Set)
  shows R[permutationSign(n, R, σ) * permutationSign(n, R, σ)] = R[1]
proof
  have finite := Finite.natural at n
  have inversionsFinite := inversions.finite at n, σ with finite
  have count := cardinality.nat at inversions(n, σ) with inversionsFinite
  unfold permutationSign
  exact negOnePow.mul_self at A, add, zero, neg, mul, one,
    cardinality(inversions(n, σ)) with ring, count

-- The inverse permutation has the sign of the permutation.
theorem permutationSign.converse (n : Nat) (σ : Set)
  requires permutation : σ ∈ permutations(n)
  shows permutationSign(n, R, converse(σ, n, n)) = permutationSign(n, R, σ)
proof
  have finite := Finite.natural at n
  have inverse := permutations.converse at n, σ with permutation
  have signClosed := permutationSign.closed at A, add, zero, neg, mul, one, n,
    σ with ring, finite
  have inverseClosed := permutationSign.closed at A, add, zero, neg, mul, one,
    n, converse(σ, n, n) with ring, finite
  have split := permutationSign.compose at A, add, zero, neg, mul, one, n, σ,
    converse(σ, n, n) with ring, permutation, inverse
  have cancel := permutations.compose_converse at n, σ with permutation
  have unit := permutationSign.identity at A, add, zero, neg, mul, one, n
    with ring
  rw [cancel, unit] at split
  have square := permutationSign.mul_self at A, add, zero, neg, mul, one, n, σ
    with ring
  linear_combination (-permutationSign(n, R, converse(σ, n, n))) * square +
    (-permutationSign(n, R, σ)) * split

theorem determinant.transpose (n : Nat) (M : Set)
  requires matrix : RingMatrix(n, R, M)
  shows determinant(n, R, transposedMatrix(n, n, A, M)) = determinant(n, R, M)
proof
  have finite := Finite.natural at n
  have permutationsFinite := permutations.finite at n with finite
  have matrixT := transposedMatrix.matrix at n, A, M with matrix
  have termsT := determinantTerms.function at n, A, add, zero, neg, mul, one,
    transposedMatrix(n, n, A, M) with ring, finite, matrixT
  have termsM := determinantTerms.function at n, A, add, zero, neg, mul, one, M
    with ring, finite, matrix
  have inverseBijective := permutationInverse.bijective at n
  -- The term of the transpose at p is the term of M at p⁻¹: the product
  -- is reindexed along p and the sign is unchanged.
  have values : ∀ p ∈ permutations(n),
      determinantTerms(n, A, add, zero, neg, mul, one,
        transposedMatrix(n, n, A, M))(p) =
      determinantTerms(n, A, add, zero, neg, mul, one, M)(
        permutationInverse(n)(p))
    intros p hp
    have inverse := permutations.converse at n, p with hp
    have inverseValue := permutationInverse.value at n, p with hp
    have termT := determinantTerms.value at n, A, add, zero, neg, mul, one,
      transposedMatrix(n, n, A, M), p with ring, finite, matrixT, hp
    have termM := determinantTerms.value at n, A, add, zero, neg, mul, one, M,
      converse(p, n, n) with ring, finite, matrix, inverse
    have pBijective := permutations.bijective with hp
    have inverseBij := permutations.bijective with inverse
    have entriesT := permutationEntries.function at n, A,
      transposedMatrix(n, n, A, M), p with matrixT, pBijective
    have entriesM := permutationEntries.function at n, A, M, converse(p, n, n)
      with matrix, inverseBij
    have products : ∀ i ∈ n,
        permutationEntries(n, A, transposedMatrix(n, n, A, M), p)(i) =
        permutationEntries(n, A, M, converse(p, n, n))(p(i))
      intros i hi
      have imageIn := permutations.apply_closed at n, p, i with hp, hi
      have valueT := permutationEntries.value at n, A,
        transposedMatrix(n, n, A, M), p, i with matrixT, pBijective, hi
      have valueM := permutationEntries.value at n, A, M, converse(p, n, n),
        p(i) with matrix, inverseBij, imageIn
      have cancel := permutations.inverse_apply at n, p, i with hp, hi
      have entry := transposedMatrix.entry at n, A, M, i, p(i)
        with matrix, hi, imageIn
      rw [valueT, valueM, cancel, entry]
      rfl
    have productEq := finiteRingProduct.reindex at n, n, A, add, zero, neg, mul,
      one, permutationEntries(n, A, transposedMatrix(n, n, A, M), p),
      permutationEntries(n, A, M, converse(p, n, n)), p
      with ring, finite, entriesT, entriesM, pBijective, products
    have sign := permutationSign.converse at A, add, zero, neg, mul, one, n, p
      with ring, hp
    rw [termT, inverseValue, termM, productEq, sign]
    rfl
  have reindexed := finiteRingSum.reindex at permutations(n), permutations(n),
    A, add, zero, neg, mul, one,
    determinantTerms(n, A, add, zero, neg, mul, one,
      transposedMatrix(n, n, A, M)),
    determinantTerms(n, A, add, zero, neg, mul, one, M), permutationInverse(n)
    with ring, permutationsFinite, termsT, termsM, inverseBijective, values
  unfold determinant
  exact reindexed

theorem determinant.column_scale (n : Nat) (M N j a : Set)
  requires matrixM : RingMatrix(n, R, M)
  requires matrixN : RingMatrix(n, R, N)
  requires column : j ∈ n
  requires scalar : a ∈ R
  requires outside : ∀ k ∈ n, ¬(k = j) → ∀ i ∈ n, N[i, k] = M[i, k]
  requires entries : ∀ i ∈ n, N[i, j] = a * M[i, j]
  shows determinant(n, R, N) = a * determinant(n, R, M)
proof
  have matrixMT := transposedMatrix.matrix at n, A, M with matrixM
  have matrixNT := transposedMatrix.matrix at n, A, N with matrixN
  have outsideT : ∀ k ∈ n, ¬(k = j) → ∀ i ∈ n,
      transposedMatrix(n, n, A, N)[k, i] = transposedMatrix(n, n, A, M)[k, i]
    intros k hk distinct i hi
    have left := transposedMatrix.entry at n, A, N, k, i
      with matrixN, hk, hi
    have right := transposedMatrix.entry at n, A, M, k, i
      with matrixM, hk, hi
    have same := outside with k, hk, distinct, i, hi
    rw [left, right]
    exact same
  have entriesT : ∀ i ∈ n,
      transposedMatrix(n, n, A, N)[j, i] =
        a * transposedMatrix(n, n, A, M)[j, i]
    intros i hi
    have left := transposedMatrix.entry at n, A, N, j, i
      with matrixN, column, hi
    have right := transposedMatrix.entry at n, A, M, j, i
      with matrixM, column, hi
    have same := entries with i, hi
    rw [left, right]
    exact same
  have scaled := determinant.row_scale at A, add, zero, neg, mul, one, n,
    transposedMatrix(n, n, A, M), transposedMatrix(n, n, A, N), j, a
    with ring, matrixMT, matrixNT, column, scalar, outsideT, entriesT
  have transposeM := determinant.transpose at A, add, zero, neg, mul, one, n, M
    with ring, matrixM
  have transposeN := determinant.transpose at A, add, zero, neg, mul, one, n, N
    with ring, matrixN
  rw [← transposeN, scaled, transposeM]
  rfl

theorem determinant.column_add_multiple (n : Nat) (M N j r a : Set)
  requires matrixM : RingMatrix(n, R, M)
  requires matrixN : RingMatrix(n, R, N)
  requires column : j ∈ n
  requires source : r ∈ n
  requires distinct : j ≠ r
  requires scalar : a ∈ R
  requires outside : ∀ k ∈ n, ¬(k = j) → ∀ i ∈ n, N[i, k] = M[i, k]
  requires entries : ∀ i ∈ n, N[i, j] = M[i, j] + a * M[i, r]
  shows determinant(n, R, N) = determinant(n, R, M)
proof
  have matrixMT := transposedMatrix.matrix at n, A, M with matrixM
  have matrixNT := transposedMatrix.matrix at n, A, N with matrixN
  have outsideT : ∀ k ∈ n, ¬(k = j) → ∀ i ∈ n,
      transposedMatrix(n, n, A, N)[k, i] = transposedMatrix(n, n, A, M)[k, i]
    intros k hk different i hi
    have left := transposedMatrix.entry at n, A, N, k, i
      with matrixN, hk, hi
    have right := transposedMatrix.entry at n, A, M, k, i
      with matrixM, hk, hi
    have same := outside with k, hk, different, i, hi
    rw [left, right]
    exact same
  have entriesT : ∀ i ∈ n, transposedMatrix(n, n, A, N)[j, i] =
      transposedMatrix(n, n, A, M)[j, i] +
        a * transposedMatrix(n, n, A, M)[r, i]
    intros i hi
    have left := transposedMatrix.entry at n, A, N, j, i
      with matrixN, column, hi
    have right := transposedMatrix.entry at n, A, M, j, i
      with matrixM, column, hi
    have sourceEntry := transposedMatrix.entry at n, A, M, r, i
      with matrixM, source, hi
    have same := entries with i, hi
    rw [left, right, sourceEntry]
    exact same
  have added := determinant.row_add_multiple at A, add, zero, neg, mul, one, n,
    transposedMatrix(n, n, A, M), transposedMatrix(n, n, A, N), j, r, a
    with ring, matrixMT, matrixNT, column, source, distinct, scalar, outsideT,
      entriesT
  have transposeM := determinant.transpose at A, add, zero, neg, mul, one, n, M
    with ring, matrixM
  have transposeN := determinant.transpose at A, add, zero, neg, mul, one, n, N
    with ring, matrixN
  rw [← transposeN, added, transposeM]
  rfl

theorem determinant.column_linear (n : Nat) (M N P j a b : Set)
  requires matrixM : RingMatrix(n, R, M)
  requires matrixN : RingMatrix(n, R, N)
  requires matrixP : RingMatrix(n, R, P)
  requires column : j ∈ n
  requires scalarA : a ∈ R
  requires scalarB : b ∈ R
  requires outsideN : ∀ k ∈ n, ¬(k = j) → ∀ i ∈ n, N[i, k] = M[i, k]
  requires outsideP : ∀ k ∈ n, ¬(k = j) → ∀ i ∈ n, P[i, k] = M[i, k]
  requires entries : ∀ i ∈ n, P[i, j] = a * M[i, j] + b * N[i, j]
  shows determinant(n, R, P) = a * determinant(n, R, M) + b * determinant(n, R,
    N)
proof
  have matrixMT := transposedMatrix.matrix at n, A, M with matrixM
  have matrixNT := transposedMatrix.matrix at n, A, N with matrixN
  have matrixPT := transposedMatrix.matrix at n, A, P with matrixP
  have outsideNT : ∀ k ∈ n, ¬(k = j) → ∀ i ∈ n,
      transposedMatrix(n, n, A, N)[k, i] = transposedMatrix(n, n, A, M)[k, i]
    intros k hk different i hi
    have left := transposedMatrix.entry at n, A, N, k, i
      with matrixN, hk, hi
    have right := transposedMatrix.entry at n, A, M, k, i
      with matrixM, hk, hi
    have same := outsideN with k, hk, different, i, hi
    rw [left, right]
    exact same
  have outsidePT : ∀ k ∈ n, ¬(k = j) → ∀ i ∈ n,
      transposedMatrix(n, n, A, P)[k, i] = transposedMatrix(n, n, A, M)[k, i]
    intros k hk different i hi
    have left := transposedMatrix.entry at n, A, P, k, i
      with matrixP, hk, hi
    have right := transposedMatrix.entry at n, A, M, k, i
      with matrixM, hk, hi
    have same := outsideP with k, hk, different, i, hi
    rw [left, right]
    exact same
  have entriesT : ∀ i ∈ n, transposedMatrix(n, n, A, P)[j, i] =
      a * transposedMatrix(n, n, A, M)[j, i] +
        b * transposedMatrix(n, n, A, N)[j, i]
    intros i hi
    have left := transposedMatrix.entry at n, A, P, j, i
      with matrixP, column, hi
    have first := transposedMatrix.entry at n, A, M, j, i
      with matrixM, column, hi
    have second := transposedMatrix.entry at n, A, N, j, i
      with matrixN, column, hi
    have same := entries with i, hi
    rw [left, first, second]
    exact same
  have linear := determinant.row_linear at A, add, zero, neg, mul, one, n,
    transposedMatrix(n, n, A, M), transposedMatrix(n, n, A, N),
    transposedMatrix(n, n, A, P), j, a, b
    with ring, matrixMT, matrixNT, matrixPT, column, scalarA, scalarB,
      outsideNT, outsidePT, entriesT
  have transposeM := determinant.transpose at A, add, zero, neg, mul, one, n, M
    with ring, matrixM
  have transposeN := determinant.transpose at A, add, zero, neg, mul, one, n, N
    with ring, matrixN
  have transposeP := determinant.transpose at A, add, zero, neg, mul, one, n, P
    with ring, matrixP
  rw [← transposeP, linear, transposeM, transposeN]
  rfl

theorem determinant.zero_column (n : Nat) (M j : Set)
  requires matrix : RingMatrix(n, R, M)
  requires column : j ∈ n
  requires vanishes : ∀ i ∈ n, M[i, j] = R[0]
  shows determinant(n, R, M) = R[0]
proof
  have matrixT := transposedMatrix.matrix at n, A, M with matrix
  have vanishesT : ∀ i ∈ n, transposedMatrix(n, n, A, M)[j, i] = R[0]
    intros i hi
    have entry := transposedMatrix.entry at n, A, M, j, i
      with matrix, column, hi
    have same := vanishes with i, hi
    rw entry
    exact same
  have zeroRow := determinant.zero_row at A, add, zero, neg, mul, one,
    transposedMatrix(n, n, A, M), n, j with ring, matrixT, column, vanishesT
  have transpose := determinant.transpose at A, add, zero, neg, mul, one, n, M
    with ring, matrix
  rw [← transpose, zeroRow]
  rfl

theorem determinant.column_permutation (n : Nat) (M N σ : Set)
  requires matrixM : RingMatrix(n, R, M)
  requires matrixN : RingMatrix(n, R, N)
  requires permutation : σ ∈ permutations(n)
  requires columns : ∀ i ∈ n, ∀ j ∈ n, N[i, j] = M[i, σ(j)]
  shows determinant(n, R, N) = permutationSign(n, R, σ) * determinant(n, R, M)
proof
  have matrixMT := transposedMatrix.matrix at n, A, M with matrixM
  have matrixNT := transposedMatrix.matrix at n, A, N with matrixN
  have rowsT : ∀ i ∈ n, ∀ j ∈ n,
      transposedMatrix(n, n, A, N)[i, j] =
        transposedMatrix(n, n, A, M)[σ(i), j]
    intros i hi j hj
    have imageIn := permutations.apply_closed at n, σ, i with permutation, hi
    have left := transposedMatrix.entry at n, A, N, i, j with matrixN, hi, hj
    have right := transposedMatrix.entry at n, A, M, σ(i), j
      with matrixM, imageIn, hj
    have same := columns with j, hj, i, hi
    rw [left, right]
    exact same
  have permuted := determinant.row_permutation at A, add, zero, neg, mul, one,
    n, transposedMatrix(n, n, A, M), transposedMatrix(n, n, A, N), σ
    with ring, matrixMT, matrixNT, permutation, rowsT
  have transposeM := determinant.transpose at A, add, zero, neg, mul, one, n, M
    with ring, matrixM
  have transposeN := determinant.transpose at A, add, zero, neg, mul, one, n, N
    with ring, matrixN
  rw [← transposeN, permuted, transposeM]
  rfl

theorem determinant.equal_rows (n : Nat) (M i r : Set)
  requires matrix : RingMatrix(n, R, M)
  requires row : i ∈ n
  requires other : r ∈ n
  requires distinct : i ≠ r
  requires equal : ∀ j ∈ n, M[i, j] = M[r, j]
  shows determinant(n, R, M) = R[0]
proof
  exact PermutationSign.determinant.equal_rows at A, add, zero, neg, mul, one,
    n, i, r, M with ring, matrix, row, other, distinct, equal

theorem determinant.equal_columns (n : Nat) (M j r : Set)
  requires matrix : RingMatrix(n, R, M)
  requires column : j ∈ n
  requires other : r ∈ n
  requires distinct : j ≠ r
  requires equal : ∀ i ∈ n, M[i, j] = M[i, r]
  shows determinant(n, R, M) = R[0]
proof
  have matrixT := transposedMatrix.matrix at n, A, M with matrix
  have equalT : ∀ i ∈ n,
      transposedMatrix(n, n, A, M)[j, i] = transposedMatrix(n, n, A, M)[r, i]
    intros i hi
    have left := transposedMatrix.entry at n, A, M, j, i
      with matrix, column, hi
    have right := transposedMatrix.entry at n, A, M, r, i
      with matrix, other, hi
    have same := equal with i, hi
    rw [left, right]
    exact same
  have vanishes := PermutationSign.determinant.equal_rows at A, add, zero, neg,
    mul, one, n, j, r, transposedMatrix(n, n, A, M)
    with ring, matrixT, column, other, distinct, equalT
  have transpose := determinant.transpose at A, add, zero, neg, mul, one, n, M
    with ring, matrix
  rw [← transpose, vanishes]
  rfl

end Rings
