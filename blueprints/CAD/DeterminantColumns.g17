-- Authors: Grant Passmore

module CAD.DeterminantColumns
import Grace.Cumulus.Algebra.Ring.DeterminantRows
import Grace.Cumulus.Algebra.Ring.DeterminantZero
import Grace.Cumulus.Algebra.Ring.DeterminantRowPermutation
import Grace.Cumulus.Algebra.Ring.DoubleSum

defgraph matrixOfEntries (n A g : Set) (p ∈ n × n) : A := g(p)
requires entries : g : n × n → A
proof
  sorry

theorem matrixOfEntries.matrix (n A g : Set)
  requires entries : g : n × n → A
  shows RingMatrix(n, A, matrixOfEntries(n, A, g))
proof
  sorry

theorem matrixOfEntries.entry (n A g i j : Set)
  requires entries : g : n × n → A
  requires row : i ∈ n
  requires column : j ∈ n
  shows matrixOfEntries(n, A, g)[i, j] = g((i, j))
proof
  sorry

theorem transposedMatrix.matrix (n A M : Set)
  requires matrix : RingMatrix(n, A, M)
  shows RingMatrix(n, A, transposedMatrix(n, n, A, M))
proof
  sorry

theorem transposedMatrix.entry (n A M i j : Set)
  requires matrix : RingMatrix(n, A, M)
  requires row : i ∈ n
  requires column : j ∈ n
  shows transposedMatrix(n, n, A, M)[i, j] = M[j, i]
proof
  sorry

section Rings
variable (A add zero neg mul one : Set)
notation ring R := (A, add, zero, neg, mul, one)
hypothesis ring : IsCommRing(R)

theorem determinant.transpose (n : Nat) (M : Set)
  requires matrix : RingMatrix(n, R, M)
  shows determinant(n, R, transposedMatrix(n, n, A, M)) = determinant(n, R, M)
proof
  sorry

theorem determinant.column_scale (n : Nat) (M N j a : Set)
  requires matrixM : RingMatrix(n, R, M)
  requires matrixN : RingMatrix(n, R, N)
  requires column : j ∈ n
  requires scalar : a ∈ R
  requires outside : ∀ k ∈ n, ¬(k = j) → ∀ i ∈ n, N[i, k] = M[i, k]
  requires entries : ∀ i ∈ n, N[i, j] = a * M[i, j]
  shows determinant(n, R, N) = a * determinant(n, R, M)
proof
  sorry

theorem determinant.column_add_multiple (n : Nat) (M N j r a : Set)
  requires matrixM : RingMatrix(n, R, M)
  requires matrixN : RingMatrix(n, R, N)
  requires column : j ∈ n
  requires source : r ∈ n
  requires distinct : j ≠ r
  requires scalar : a ∈ R
  requires outside : ∀ k ∈ n, ¬(k = j) → ∀ i ∈ n, N[i, k] = M[i, k]
  requires entries : ∀ i ∈ n, N[i, j] = M[i, j] + a * M[i, r]
  shows determinant(n, R, N) = determinant(n, R, M)
proof
  sorry

theorem determinant.column_linear (n : Nat) (M N P j a b : Set)
  requires matrixM : RingMatrix(n, R, M)
  requires matrixN : RingMatrix(n, R, N)
  requires matrixP : RingMatrix(n, R, P)
  requires column : j ∈ n
  requires scalarA : a ∈ R
  requires scalarB : b ∈ R
  requires outsideN : ∀ k ∈ n, ¬(k = j) → ∀ i ∈ n, N[i, k] = M[i, k]
  requires outsideP : ∀ k ∈ n, ¬(k = j) → ∀ i ∈ n, P[i, k] = M[i, k]
  requires entries : ∀ i ∈ n, P[i, j] = a * M[i, j] + b * N[i, j]
  shows determinant(n, R, P) = a * determinant(n, R, M) + b * determinant(n, R,
    N)
proof
  sorry

theorem determinant.zero_column (n : Nat) (M j : Set)
  requires matrix : RingMatrix(n, R, M)
  requires column : j ∈ n
  requires vanishes : ∀ i ∈ n, M[i, j] = R[0]
  shows determinant(n, R, M) = R[0]
proof
  sorry

theorem determinant.column_permutation (n : Nat) (M N σ : Set)
  requires matrixM : RingMatrix(n, R, M)
  requires matrixN : RingMatrix(n, R, N)
  requires permutation : σ ∈ permutations(n)
  requires columns : ∀ i ∈ n, ∀ j ∈ n, N[i, j] = M[i, σ(j)]
  shows determinant(n, R, N) = permutationSign(n, R, σ) * determinant(n, R, M)
proof
  sorry

theorem determinant.equal_rows (n : Nat) (M i r : Set)
  requires matrix : RingMatrix(n, R, M)
  requires row : i ∈ n
  requires other : r ∈ n
  requires distinct : i ≠ r
  requires equal : ∀ j ∈ n, M[i, j] = M[r, j]
  shows determinant(n, R, M) = R[0]
proof
  sorry

theorem determinant.equal_columns (n : Nat) (M j r : Set)
  requires matrix : RingMatrix(n, R, M)
  requires column : j ∈ n
  requires other : r ∈ n
  requires distinct : j ≠ r
  requires equal : ∀ i ∈ n, M[i, j] = M[i, r]
  shows determinant(n, R, M) = R[0]
proof
  sorry

end Rings
