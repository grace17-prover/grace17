-- A Horner pair as an element hornerPoly of the univariate polynomial ring
-- R[oneVariable] (the variable 0), its coefficients hornerCoefficient, equality
-- of pairs as polynomials through their coefficients, equality of values over
-- an infinite integral domain, and the normal form of a full coefficient list:
-- trailing zeros removed so that the leading coefficient is nonzero unless the
-- polynomial is zero.
-- Part of the CAD blueprint.
-- Planned home: Algebra/Polynomial/HornerNormalForm.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module CAD.HornerNormalForm
import CAD.HornerProduct
import Grace.Cumulus.Algebra.Polynomial.HornerDegree
import Grace.Cumulus.Algebra.Polynomial.HornerNormalization
import Grace.Cumulus.List.Filter

-- The k-th coefficient of the pair: c_k below the length, leading at
-- the length, and zero above it.
def hornerCoefficient {A : Set} (zero leading : Set) (cs : List(A))
  (k : Nat) : Set :=
  listCoefficient{A}(zero, hornerFullList{A}(leading, cs), k)

-- The index set of one variable, named so that a ring scope R[oneVariable]
-- reads it as the set 1 = {0} and not as the one of the ring.
def oneVariable : Set := 1

-- The pair as the polynomial c₀ + c₁X + … + leading·Xⁿ of R[oneVariable]
-- in the variable 0.
def hornerPoly {A : Set} (add zero neg mul one leading : Set)
  (cs : List(A)) : Set :=
  polynomialFromHorner(oneVariable, A, add, zero, neg, mul, one, 0, leading, cs)

-- The pair is the zero polynomial: every coefficient vanishes.
predicate HornerZero (A zero leading cs : Set) :=
  ∀ k, Nat(k) → hornerCoefficient{A}(zero, leading, cs, k) = zero

-- Trailing zeros of a full coefficient list are removed from the top:
-- dropZeros drops leading zeros of the reversed list.
def dropZeros {A : Set} (zero : Set) (xs : List(A)) → Set
  | zero, List.nil => []
  | zero, List.cons(x, tail) =>
      boolChoice(memberTest({zero}, x), dropZeros(zero, tail), x :: tail)
  descends xs

def hornerTrimLeading {A : Set} (zero : Set) (rs : List(A)) : Set :=
  listHeadOr{A}(zero, dropZeros{A}(zero, reverse{A}(rs)))
def hornerTrimLower {A : Set} (zero : Set) (rs : List(A)) : Set :=
  reverse{A}(listTail{A}(dropZeros{A}(zero, reverse{A}(rs))))

-- The normal form of a pair: the trimmed full list.
def normalLeading {A : Set} (zero leading : Set) (cs : List(A)) : Set :=
  hornerTrimLeading{A}(zero, hornerFullList{A}(leading, cs))
def normalLower {A : Set} (zero leading : Set) (cs : List(A)) : Set :=
  hornerTrimLower{A}(zero, hornerFullList{A}(leading, cs))

theorem hornerCoefficient.below (A zero leading : Set) (cs : List(A)) (k : Nat)
  requires bound : k < length{A}(cs)
  shows hornerCoefficient{A}(zero, leading, cs, k) =
    listCoefficient{A}(zero, cs, k)
proof
  sorry

theorem hornerCoefficient.leading (A zero leading : Set) (cs : List(A))
  requires initial : leading ∈ A
  shows hornerCoefficient{A}(zero, leading, cs, length{A}(cs)) = leading
proof
  sorry

theorem hornerCoefficient.above (A zero leading : Set) (cs : List(A)) (k : Nat)
  requires bound : length{A}(cs) < k
  shows hornerCoefficient{A}(zero, leading, cs, k) = zero
proof
  sorry

theorem dropZeros.closed (A zero : Set) (xs : List(A))
  shows List(A, dropZeros{A}(zero, xs))
proof
  sorry

theorem dropZeros.length_le (A zero : Set) (xs : List(A))
  shows length{A}(dropZeros{A}(zero, xs)) ≤ length{A}(xs)
proof
  sorry

theorem dropZeros.head_nonzero (A zero : Set) (xs : List(A))
  shows dropZeros{A}(zero, xs) = [] ∨
    listHeadOr{A}(zero, dropZeros{A}(zero, xs)) ≠ zero
proof
  sorry

theorem hornerTrimLower.list (A zero : Set) (rs : List(A))
  shows List(A, hornerTrimLower{A}(zero, rs))
proof
  sorry

theorem hornerTrimLeading.mem (A zero : Set) (rs : List(A))
  requires zeroIn : zero ∈ A
  shows hornerTrimLeading{A}(zero, rs) ∈ A
proof
  sorry

-- The trimmed pair is in normal form: nonzero leading or the zero pair.
theorem hornerTrim.normal (A zero : Set) (rs : List(A))
  shows hornerTrimLeading{A}(zero, rs) ≠ zero ∨
    (hornerTrimLeading{A}(zero, rs) = zero ∧ hornerTrimLower{A}(zero, rs) = [])
proof
  sorry

theorem hornerTrim.length_lt (A zero : Set) (rs : List(A))
  requires nonempty : rs ≠ []
  shows length{A}(hornerTrimLower{A}(zero, rs)) < length{A}(rs)
proof
  sorry

theorem hornerTrim.coefficient (A zero : Set) (rs : List(A)) (k : Nat)
  shows hornerCoefficient{A}(zero, hornerTrimLeading{A}(zero, rs),
    hornerTrimLower{A}(zero, rs), k) =
    listCoefficient{A}(zero, rs, k)
proof
  sorry

theorem hornerTrim.zero_iff (A zero : Set) (rs : List(A))
  shows hornerTrimLeading{A}(zero, rs) = zero ↔
    ∀ k, Nat(k) → listCoefficient{A}(zero, rs, k) = zero
proof
  sorry

-- A pair in normal form is its own normal form.
theorem normalLeading.of_nonzero (A zero leading : Set) (cs : List(A))
  requires initial : leading ∈ A
  requires nonzero : leading ≠ zero
  shows normalLeading{A}(zero, leading, cs) = leading ∧
    normalLower{A}(zero, leading, cs) = cs
proof
  sorry

section Rings
variable (A add zero neg mul one : Set)
notation ring R := (A, add, zero, neg, mul, one)
notation ring P := R[oneVariable]
hypothesis ring : IsCommRing(R)

theorem hornerPoly.member (leading : Set) (cs : List(A))
  requires initial : leading ∈ R
  shows hornerPoly{A}(add, zero, neg, mul, one, leading, cs) ∈ P
proof
  sorry

theorem hornerPoly.coefficient (leading : Set) (cs : List(A)) (k : Nat)
  requires initial : leading ∈ R
  shows hornerPoly{A}(add, zero, neg, mul, one, leading,
    cs)(monomialShift(oneVariable, 0, monomialOne(oneVariable), k)) =
    hornerCoefficient{A}(zero, leading, cs, k)
proof
  sorry

-- Two pairs are the same polynomial exactly when their coefficients agree.
theorem hornerPoly.eq_iff (a b : Set) (cs ds : List(A))
  requires left : a ∈ R
  requires right : b ∈ R
  shows hornerPoly{A}(add, zero, neg, mul, one, a, cs) = hornerPoly{A}(add,
    zero, neg, mul, one, b, ds) ↔
    ∀ k, Nat(k) →
      hornerCoefficient{A}(zero, a, cs, k) =
        hornerCoefficient{A}(zero, b, ds, k)
proof
  sorry

theorem hornerPoly.zero_iff (leading : Set) (cs : List(A))
  requires initial : leading ∈ R
  shows hornerPoly{A}(add, zero, neg, mul, one, leading,
    cs) = P[0] ↔ HornerZero(A, zero, leading, cs)
proof
  sorry

-- Lists of one length with the same polynomial and leading are equal.
theorem hornerPoly.list_unique (leading : Set) (cs ds : List(A))
  requires initial : leading ∈ R
  requires sameLength : length{A}(cs) = length{A}(ds)
  requires equal : hornerPoly{A}(add, zero, neg, mul, one, leading,
    cs) = hornerPoly{A}(add, zero, neg, mul, one, leading, ds)
  shows cs = ds
proof
  sorry

theorem hornerPoly.full_list (leading : Set) (cs : List(A))
  requires initial : leading ∈ R
  shows hornerPoly{A}(add, zero, neg, mul, one, zero,
    hornerFullList{A}(leading, cs)) =
    hornerPoly{A}(add, zero, neg, mul, one, leading, cs)
proof
  sorry

theorem hornerPoly.normal (leading : Set) (cs : List(A))
  requires initial : leading ∈ R
  shows hornerPoly{A}(add, zero, neg, mul, one, normalLeading{A}(zero, leading,
    cs), normalLower{A}(zero, leading, cs)) =
    hornerPoly{A}(add, zero, neg, mul, one, leading, cs)
proof
  sorry

theorem hornerPoly.add (a b : Set) (cs ds : List(A))
  requires left : a ∈ R
  requires right : b ∈ R
  requires sameLength : length{A}(cs) = length{A}(ds)
  shows hornerPoly{A}(add, zero, neg, mul, one, R[a + b], hornerAdd{A}(add,
    zero, cs, ds)) =
    P[hornerPoly{A}(add, zero, neg, mul, one, a, cs) + hornerPoly{A}(add, zero,
      neg, mul, one, b, ds)]
proof
  sorry

theorem hornerPoly.neg (a : Set) (cs : List(A))
  requires initial : a ∈ R
  shows hornerPoly{A}(add, zero, neg, mul, one, neg(a), hornerNeg{A}(neg, cs)) =
    P[-hornerPoly{A}(add, zero, neg, mul, one, a, cs)]
proof
  sorry

theorem hornerPoly.scale (a b : Set) (cs : List(A))
  requires scalar : a ∈ R
  requires initial : b ∈ R
  shows hornerPoly{A}(add, zero, neg, mul, one, R[a * b], hornerScale{A}(mul,
    a, cs)) =
    P[polynomialConstant(oneVariable, R, a) * hornerPoly{A}(add, zero, neg,
      mul, one, b, cs)]
proof
  sorry

theorem hornerPoly.mul (a b : Set) (cs ds : List(A))
  requires left : a ∈ R
  requires right : b ∈ R
  shows hornerPoly{A}(add, zero, neg, mul, one, R[a * b], hornerMulList{A}(add,
    zero, mul, a, b, cs, ds)) =
    P[hornerPoly{A}(add, zero, neg, mul, one, a, cs) * hornerPoly{A}(add, zero,
      neg, mul, one, b, ds)]
proof
  sorry

theorem hornerPoly.constant (a : Set)
  requires initial : a ∈ R
  shows hornerPoly{A}(add, zero, neg, mul, one, a,
    []) = polynomialConstant(oneVariable, R, a)
proof
  sorry

-- The value at x is the evaluation at the assignment sending 0 to x.
theorem hornerPoly.value (leading x : Set) (cs : List(A))
  requires initial : leading ∈ R
  requires element : x ∈ R
  shows polynomialAt(oneVariable, R, constantFunction(oneVariable, A,
    x))(hornerPoly{A}(add, zero, neg, mul, one, leading, cs)) =
    hornerAt{A}(add, mul, leading, x, cs)
proof
  sorry

-- Equal polynomials take equal values.
theorem hornerAt.congr_of_poly (a b x : Set) (cs ds : List(A))
  requires left : a ∈ R
  requires right : b ∈ R
  requires element : x ∈ R
  requires equal : hornerPoly{A}(add, zero, neg, mul, one, a,
    cs) = hornerPoly{A}(add, zero, neg, mul, one, b, ds)
  shows hornerAt{A}(add, mul, a, x, cs) = hornerAt{A}(add, mul, b, x, ds)
proof
  sorry

theorem hornerAt.normal (leading x : Set) (cs : List(A))
  requires initial : leading ∈ R
  requires element : x ∈ R
  shows hornerAt{A}(add, mul, normalLeading{A}(zero, leading, cs), x,
    normalLower{A}(zero, leading, cs)) =
    hornerAt{A}(add, mul, leading, x, cs)
proof
  sorry

end Rings

section Domains
variable (A add zero neg mul one : Set)
notation ring R := (A, add, zero, neg, mul, one)
notation ring P := R[oneVariable]
hypothesis domain : IsIntegralDomain(R)
hypothesis infinite : ¬Finite(R)

-- Over an infinite integral domain, equal values everywhere force equal
-- polynomials.
theorem hornerPoly.eq_of_values (a b : Set) (cs ds : List(A))
  requires left : a ∈ R
  requires right : b ∈ R
  requires agree : ∀ x ∈ R, hornerAt{A}(add, mul, a, x, cs) = hornerAt{A}(add,
    mul, b, x, ds)
  shows hornerPoly{A}(add, zero, neg, mul, one, a, cs) = hornerPoly{A}(add,
    zero, neg, mul, one, b, ds)
proof
  sorry

theorem HornerZero.of_values (leading : Set) (cs : List(A))
  requires initial : leading ∈ R
  requires vanishes : ∀ x ∈ R, hornerAt{A}(add, mul, leading, x, cs) = R[0]
  shows HornerZero(A, zero, leading, cs)
proof
  sorry

end Domains
