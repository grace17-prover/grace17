-- A Horner pair as an element hornerPoly of the univariate polynomial ring
-- R[oneVariable] (the variable 0), its coefficients hornerCoefficient, equality
-- of pairs as polynomials through their coefficients, equality of values over
-- an infinite integral domain, and the normal form of a full coefficient list:
-- trailing zeros removed so that the leading coefficient is nonzero unless the
-- polynomial is zero.
-- Part of the CAD blueprint.
-- Planned home: Algebra/Polynomial/HornerNormalForm.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module CAD.HornerNormalForm
import CAD.HornerProduct
import Grace.Cumulus.Algebra.Polynomial.HornerDegree
import Grace.Cumulus.Algebra.Polynomial.HornerNormalization
import Grace.Cumulus.List.Filter

-- The k-th coefficient of the pair: c_k below the length, leading at
-- the length, and zero above it.
def hornerCoefficient {A : Set} (zero leading : Set) (cs : List(A))
  (k : Nat) : Set :=
  listCoefficient{A}(zero, hornerFullList{A}(leading, cs), k)

-- The index set of one variable, named so that a ring scope R[oneVariable]
-- reads it as the set 1 = {0} and not as the one of the ring.
def oneVariable : Set := 1

-- The pair as the polynomial c₀ + c₁X + … + leading·Xⁿ of R[oneVariable]
-- in the variable 0.
def hornerPoly {A : Set} (add zero neg mul one leading : Set)
  (cs : List(A)) : Set :=
  polynomialFromHorner(oneVariable, A, add, zero, neg, mul, one, 0, leading, cs)

-- The pair is the zero polynomial: every coefficient vanishes.
predicate HornerZero (A zero leading cs : Set) :=
  ∀ k, Nat(k) → hornerCoefficient{A}(zero, leading, cs, k) = zero

-- Trailing zeros of a full coefficient list are removed from the top:
-- dropZeros drops leading zeros of the reversed list.
def dropZeros {A : Set} (zero : Set) (xs : List(A)) → Set
  | zero, List.nil => []
  | zero, List.cons(x, tail) =>
      boolChoice(memberTest({zero}, x), dropZeros(zero, tail), x :: tail)
  descends xs

def hornerTrimLeading {A : Set} (zero : Set) (rs : List(A)) : Set :=
  listHeadOr{A}(zero, dropZeros{A}(zero, reverse{A}(rs)))
def hornerTrimLower {A : Set} (zero : Set) (rs : List(A)) : Set :=
  reverse{A}(listTail{A}(dropZeros{A}(zero, reverse{A}(rs))))

-- The normal form of a pair: the trimmed full list.
def normalLeading {A : Set} (zero leading : Set) (cs : List(A)) : Set :=
  hornerTrimLeading{A}(zero, hornerFullList{A}(leading, cs))
def normalLower {A : Set} (zero leading : Set) (cs : List(A)) : Set :=
  hornerTrimLower{A}(zero, hornerFullList{A}(leading, cs))

theorem hornerCoefficient.below (A zero leading : Set) (cs : List(A)) (k : Nat)
  requires bound : k < length{A}(cs)
  shows hornerCoefficient{A}(zero, leading, cs, k) =
    listCoefficient{A}(zero, cs, k)
proof
  induction cs generalizing k
  | List.nil =>
    intros k kNat bound
    rw length.nil at bound
    have impossible : (0 : Nat) < (0 : Nat)
      arith
    exfalso
    have irreflexive := Less.irreflexive with Naturals.constructor.zero
    exact irreflexive with impossible
  | List.cons(c, tail) using ih =>
    intros k kNat bound
    have coefficient : c ∈ A by assumption
    unfold hornerCoefficient at ih
    unfold hornerFullList at ih
    unfold hornerCoefficient
    unfold hornerFullList
    have shape := natural.zero_or_successor at k with *
    cases shape with isZero | successor
    . rw [isZero, append]
      simp [listCoefficient, listHeadOr]
    . obtain ⟨r, rNat, equal⟩ := successor
      rw [equal, length.cons] at bound
      have smaller : r < length{A}(tail) by arith
      have previous := ih with r, rNat, smaller
      rw [equal, append]
      simp [listCoefficient, listTail]

theorem hornerCoefficient.leading (A zero leading : Set) (cs : List(A))
  requires initial : leading ∈ A
  shows hornerCoefficient{A}(zero, leading, cs, length{A}(cs)) = leading
proof
  have single : List(A, leading :: []) by typecheck
  have empty : List(A, []) by typecheck
  have shifted := listCoefficient.append_right at A, zero, cs, leading :: [],
    (0 : Nat) with *
  have offset : (0 : Nat) + length{A}(cs) = length{A}(cs) by arith
  have head := listCoefficient.zero at A, zero, leading, [] with *
  rw [offset, head] at shifted
  unfold hornerCoefficient
  unfold hornerFullList
  exact shifted

theorem hornerCoefficient.above (A zero leading : Set) (cs : List(A)) (k : Nat)
  requires bound : length{A}(cs) < k
  shows hornerCoefficient{A}(zero, leading, cs, k) = zero
proof
  induction cs generalizing k
  | List.nil =>
    intros k kNat bound
    unfold hornerCoefficient
    unfold hornerFullList
    rw length.nil at bound
    have shape := natural.zero_or_successor at k with *
    cases shape with isZero | successor
    . rw isZero at bound
      have impossible : (0 : Nat) < (0 : Nat)
        arith
      exfalso
      have irreflexive := Less.irreflexive with Naturals.constructor.zero
      exact irreflexive with impossible
    . obtain ⟨r, rNat, equal⟩ := successor
      rw [equal, append]
      simp [listCoefficient, listTail, listCoefficient.nil]
  | List.cons(c, tail) using ih =>
    intros k kNat bound
    have coefficient : c ∈ A by assumption
    unfold hornerCoefficient at ih
    unfold hornerFullList at ih
    unfold hornerCoefficient
    unfold hornerFullList
    rw length.cons at bound
    have shape := natural.zero_or_successor at k with *
    cases shape with isZero | successor
    . rw isZero at bound
      have impossible : (0 : Nat) < (0 : Nat)
        arith
      exfalso
      have irreflexive := Less.irreflexive with Naturals.constructor.zero
      exact irreflexive with impossible
    . obtain ⟨r, rNat, equal⟩ := successor
      rw equal at bound
      have larger : length{A}(tail) < r by arith
      have previous := ih with r, rNat, larger
      rw [equal, append]
      simp [listCoefficient, listTail]

theorem dropZeros.closed (A zero : Set) (xs : List(A))
  shows List(A, dropZeros{A}(zero, xs))
proof
  induction xs
  | List.nil =>
    rw dropZeros
    typecheck
  | List.cons(x, tail) using ih =>
    have element : x ∈ A by assumption
    have alternatives : x ∈ {zero} ∨ ¬(x ∈ {zero}) by tauto
    cases alternatives with member | absent
    . have test := memberTest.true with member
      rw [dropZeros, test, boolChoice.true]
      exact ih
    . have test := memberTest.false with absent
      rw [dropZeros, test, boolChoice.false]
      typecheck

theorem dropZeros.length_le (A zero : Set) (xs : List(A))
  shows length{A}(dropZeros{A}(zero, xs)) ≤ length{A}(xs)
proof
  induction xs
  | List.nil =>
    rw dropZeros
    arith
  | List.cons(x, tail) using ih =>
    have element : x ∈ A by assumption
    have alternatives : x ∈ {zero} ∨ ¬(x ∈ {zero}) by tauto
    cases alternatives with member | absent
    . have test := memberTest.true with member
      rw [dropZeros, test, boolChoice.true, length.cons]
      arith
    . have test := memberTest.false with absent
      rw [dropZeros, test, boolChoice.false]
      arith

theorem dropZeros.head_nonzero (A zero : Set) (xs : List(A))
  shows dropZeros{A}(zero, xs) = [] ∨
    listHeadOr{A}(zero, dropZeros{A}(zero, xs)) ≠ zero
proof
  induction xs
  | List.nil =>
    left
    rw dropZeros
    rfl
  | List.cons(x, tail) using ih =>
    have element : x ∈ A by assumption
    have alternatives : x ∈ {zero} ∨ ¬(x ∈ {zero}) by tauto
    cases alternatives with member | absent
    . have test := memberTest.true with member
      rw [dropZeros, test, boolChoice.true]
      exact ih
    . have test := memberTest.false with absent
      right
      rw [dropZeros, test, boolChoice.false, listHeadOr]
      intro equal
      apply absent
      rw equal
      exact singleton.self at zero

theorem hornerTrimLower.list (A zero : Set) (rs : List(A))
  shows List(A, hornerTrimLower{A}(zero, rs))
proof
  have reversed : List(A, reverse(rs)) by typecheck
  have dropped := dropZeros.closed at A, zero, reverse(rs) with *
  have tail := listTail.closed at A, dropZeros{A}(zero, reverse(rs)) with *
  unfold hornerTrimLower
  typecheck

theorem hornerTrimLeading.mem (A zero : Set) (rs : List(A))
  requires zeroIn : zero ∈ A
  shows hornerTrimLeading{A}(zero, rs) ∈ A
proof
  have reversed : List(A, reverse(rs)) by typecheck
  have dropped := dropZeros.closed at A, zero, reverse(rs) with *
  unfold hornerTrimLeading
  exact listHeadOr.mem_carrier at A, zero, dropZeros{A}(zero, reverse(rs))
    with *

-- The trimmed pair is in normal form: nonzero leading or the zero pair.
theorem hornerTrim.normal (A zero : Set) (rs : List(A))
  shows hornerTrimLeading{A}(zero, rs) ≠ zero ∨
    (hornerTrimLeading{A}(zero, rs) = zero ∧ hornerTrimLower{A}(zero, rs) = [])
proof
  have reversed : List(A, reverse(rs)) by typecheck
  have alternatives := dropZeros.head_nonzero at A, zero, reverse(rs) with *
  unfold hornerTrimLeading
  unfold hornerTrimLower
  cases alternatives with empty | nonzero
  . right
    rw [empty, listHeadOr, listTail, reverse]
    constructor
    . rfl
    . rfl
  . left
    exact nonzero

theorem hornerTrim.length_lt (A zero : Set) (rs : List(A))
  requires nonempty : rs ≠ []
  shows length{A}(hornerTrimLower{A}(zero, rs)) < length{A}(rs)
proof
  have reversed : List(A, reverse(rs)) by typecheck
  have dropped := dropZeros.closed at A, zero, reverse(rs) with *
  have shorter := dropZeros.length_le at A, zero, reverse(rs) with *
  have same := reverse.length at A, rs with *
  have shape := List.cases at A, dropZeros{A}(zero, reverse(rs)) with *
  unfold hornerTrimLower
  cases shape with empty | nonempty
  . rw [empty, listTail, reverse, length.nil]
    exact length.positive_of_ne_nil with nonempty
  . obtain ⟨d, dIn, front, frontList, equal⟩ := nonempty
    rw [equal, length.cons] at shorter
    rw [equal, listTail, reverse.length]
    arith

-- A list with leading zeros dropped from the front has, after reversal,
-- the same entries at every position as the reversed original.
theorem dropZeros.reverse_coefficient (A zero : Set) (xs : List(A)) (k : Nat)
  shows listCoefficient{A}(zero, reverse(xs), k) =
    listCoefficient{A}(zero, reverse(dropZeros{A}(zero, xs)), k)
proof
  induction xs generalizing k
  | List.nil =>
    intros k kNat
    rw dropZeros
    rfl
  | List.cons(x, tail) using ih =>
    intros k kNat
    have element : x ∈ A by assumption
    have single : List(A, x :: []) by typecheck
    have reversed : List(A, reverse(tail)) by typecheck
    have dropped := dropZeros.closed at A, zero, tail with *
    have droppedReversed : List(A, reverse(dropZeros{A}(zero, tail)))
      by typecheck
    have alternatives : x ∈ {zero} ∨ ¬(x ∈ {zero}) by tauto
    cases alternatives with member | absent
    . have test := memberTest.true with member
      have headZero : x = zero
        exact (singleton.membership at x, zero).forward with member
      have previous := ih with k, kNat
      rw [dropZeros, test, boolChoice.true, reverse.cons]
      have inside : k < length{A}(reverse(tail)) ∨
        ¬(k < length{A}(reverse(tail))) by tauto
      cases inside with below | above
      . have front := listCoefficient.append_left at A, zero, reverse(tail),
          x :: [], k with *
        rw [front, previous]
        rfl
      . have bound := LessEqual.of_not_Less with above
        obtain ⟨n, nNat, split⟩ := LessEqual.exists_add with bound
        have commuted : length{A}(reverse(tail)) + n =
          n + length{A}(reverse(tail)) by arith
        rw commuted at split
        have back := listCoefficient.append_right at A, zero, reverse(tail),
          x :: [], n with *
        have shorter := dropZeros.length_le at A, zero, tail with *
        have outside : length{A}(reverse(dropZeros{A}(zero, tail))) ≤ k
          rw [reverse.length, split, reverse.length]
          arith
        have vanishes := listCoefficient.outside at A, zero,
          reverse(dropZeros{A}(zero, tail)), k with *
        rw [vanishes, split, back]
        have shape := natural.zero_or_successor at n with *
        cases shape with isZero | successor
        . rw isZero
          simp [listCoefficient, listHeadOr]
        . obtain ⟨r, rNat, equal⟩ := successor
          rw equal
          simp [listCoefficient, listTail, listCoefficient.nil]
    . have test := memberTest.false with absent
      rw [dropZeros, test, boolChoice.false]
      rfl

-- The list with the single entry zero reads zero at every position.
theorem hornerCoefficient.singleton_zero (A zero : Set) (k : Nat)
  shows listCoefficient{A}(zero, zero :: [], k) = zero
proof
  have shape := natural.zero_or_successor at k with *
  cases shape with isZero | successor
  . rw isZero
    simp [listCoefficient, listHeadOr]
  . obtain ⟨r, rNat, equal⟩ := successor
    rw equal
    simp [listCoefficient, listTail, listCoefficient.nil]

theorem hornerTrim.coefficient (A zero : Set) (rs : List(A)) (k : Nat)
  shows hornerCoefficient{A}(zero, hornerTrimLeading{A}(zero, rs),
    hornerTrimLower{A}(zero, rs), k) =
    listCoefficient{A}(zero, rs, k)
proof
  have reversed : List(A, reverse(rs)) by typecheck
  have dropped := dropZeros.closed at A, zero, reverse(rs) with *
  have claim := dropZeros.reverse_coefficient at A, zero, reverse(rs), k with *
  rw reverse.involutive at claim
  have shape := List.cases at A, dropZeros{A}(zero, reverse(rs)) with *
  unfold hornerCoefficient
  unfold hornerTrimLeading
  unfold hornerTrimLower
  unfold hornerFullList
  cases shape with empty | nonempty
  . rw empty at claim
    rw [reverse, listCoefficient.nil] at claim
    rw [empty, listHeadOr, listTail, reverse, append, claim]
    exact hornerCoefficient.singleton_zero at A, zero, k with *
  . obtain ⟨d, dIn, front, frontList, equal⟩ := nonempty
    rw equal at claim
    rw reverse.cons at claim
    rw [equal, listHeadOr, listTail, claim]
    rfl

theorem hornerTrim.zero_iff (A zero : Set) (rs : List(A))
  shows hornerTrimLeading{A}(zero, rs) = zero ↔
    ∀ k, Nat(k) → listCoefficient{A}(zero, rs, k) = zero
proof
  have reversed : List(A, reverse(rs)) by typecheck
  have dropped := dropZeros.closed at A, zero, reverse(rs) with *
  have normal := hornerTrim.normal at A, zero, rs with *
  constructor
  . intros vanishing k kNat
    have lower : hornerTrimLower{A}(zero, rs) = []
      cases normal with nonzero | zeroPair
      . exfalso
        exact nonzero with vanishing
      . exact zeroPair.right
    have trimmed := hornerTrim.coefficient at A, zero, rs, k with *
    rw [vanishing, lower] at trimmed
    unfold hornerCoefficient at trimmed
    unfold hornerFullList at trimmed
    rw append at trimmed
    rw ← trimmed
    exact hornerCoefficient.singleton_zero at A, zero, k with *
  . intro zeros
    by_contra different
    have claim := dropZeros.reverse_coefficient at A, zero, reverse(rs),
      length{A}(listTail{A}(dropZeros{A}(zero, reverse(rs)))) with *
    rw reverse.involutive at claim
    have shape := List.cases at A, dropZeros{A}(zero, reverse(rs)) with *
    cases shape with empty | nonempty
    . apply different
      unfold hornerTrimLeading
      rw [empty, listHeadOr]
      rfl
    . obtain ⟨d, dIn, front, frontList, equal⟩ := nonempty
      have single : List(A, d :: []) by typecheck
      have frontReversed : List(A, reverse(front)) by typecheck
      have head : hornerTrimLeading{A}(zero, rs) = d
        unfold hornerTrimLeading
        rw [equal, listHeadOr]
        rfl
      rw [equal, listTail, reverse.cons] at claim
      have offset : (0 : Nat) + length{A}(reverse(front)) =
        length{A}(reverse(front)) by arith
      have back := listCoefficient.append_right at A, zero, reverse(front),
        d :: [], (0 : Nat) with *
      rw [offset, listCoefficient.head, listHeadOr, reverse.length] at back
      rw back at claim
      have frontNat : Nat(length{A}(front)) by typecheck
      have vanishes := zeros with length{A}(front), frontNat
      apply different
      rw head
      rw ← vanishes
      symm
      exact claim

-- A pair in normal form is its own normal form.
theorem normalLeading.of_nonzero (A zero leading : Set) (cs : List(A))
  requires initial : leading ∈ A
  requires nonzero : leading ≠ zero
  shows normalLeading{A}(zero, leading, cs) = leading ∧
    normalLower{A}(zero, leading, cs) = cs
proof
  have single : List(A, leading :: []) by typecheck
  have reversedCs : List(A, reverse(cs)) by typecheck
  have snoc := reverse.snoc at A, leading, cs with *
  have absent : ¬(leading ∈ {zero})
    intro member
    apply nonzero
    exact (singleton.membership at leading, zero).forward with member
  have test := memberTest.false with absent
  unfold normalLeading
  unfold normalLower
  unfold hornerTrimLeading
  unfold hornerTrimLower
  unfold hornerFullList
  rw [snoc, dropZeros, test, boolChoice.false, listHeadOr, listTail,
    reverse.involutive]
  constructor
  . rfl
  . rfl

-- The variable set has the single index 0.
theorem oneVariable.index
  shows (0 : Nat) ∈ oneVariable
proof
  unfold oneVariable
  exact bootstrap.succ.self at (0 : Nat)

theorem oneVariable.only (i : Set)
  requires member : i ∈ oneVariable
  shows i = (0 : Nat)
proof
  unfold oneVariable at member
  have cases := (bootstrap.succ.membership at i, (0 : Nat)).forward
    with member
  cases cases with inside | same
  . exfalso
    rw nat.zero at inside
    exact set.empty with inside
  . exact same

-- Every monomial in one variable is a power of that variable.
theorem oneVariable.monomial (m : Set)
  requires monomial : m ∈ monomials(oneVariable)
  shows m = monomialShift(oneVariable, (0 : Nat), monomialOne(oneVariable),
    m((0 : Nat)))
proof
  have index := oneVariable.index
  have exponent := monomials.exponent at oneVariable, m, (0 : Nat) with *
  have unit := monomialOne.member at oneVariable
  have absent := monomialOne.value at oneVariable, (0 : Nat) with *
  have shifted := monomialShift.member at oneVariable, (0 : Nat),
    monomialOne(oneVariable), m((0 : Nat)) with *
  have value := monomialShift.exponent at oneVariable, (0 : Nat),
    monomialOne(oneVariable), m((0 : Nat)) with *
  apply monomials.ext at oneVariable with monomial, shifted
  intros i iIn
  have same := oneVariable.only with iIn
  rw [same, value]
  rfl

section Rings
variable (A add zero neg mul one : Set)
notation ring R := (A, add, zero, neg, mul, one)
notation ring P := R[oneVariable]
hypothesis ring : IsCommRing(R)

theorem hornerPoly.member (leading : Set) (cs : List(A))
  requires initial : leading ∈ R
  shows hornerPoly{A}(add, zero, neg, mul, one, leading, cs) ∈ P
proof
  unfold hornerPoly
  exact polynomialFromHorner.member with *

-- The constant coefficient and the coefficients below the length.
theorem hornerPoly.constant_coefficient (leading c : Set) (cs : List(A))
  requires initial : leading ∈ R
  requires coefficient : c ∈ R
  shows hornerPoly{A}(add, zero, neg, mul, one, leading,
    c :: cs)(monomialOne(oneVariable)) = c
proof
  have index := oneVariable.index
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have oneIn : R[1] ∈ R by typecheck
  have target := polynomials.comm_ring at oneVariable, A, add, zero, neg, mul,
    one with *
  have polynomialRing := IsCommRing.ring with target
  have origin := polynomialAtOrigin.hom at oneVariable, A, add, zero, neg,
    mul, one with *
  have constant := polynomialConstant.member at oneVariable, A, zero, c with *
  have variable := polynomialVariable.member at oneVariable, A, zero, one,
    (0 : Nat) with *
  have rest := polynomialFromHorner.member at oneVariable, A, add, zero, neg,
    mul, one, (0 : Nat), leading, cs with *
  have whole := polynomialFromHorner.member at oneVariable, A, add, zero, neg,
    mul, one, (0 : Nat), leading, c :: cs with *
  have product := IsRing.mul_closed with polynomialRing, variable, rest
  have expression := polynomialFromHorner.cons at oneVariable, A, add, zero,
    neg, mul, one, (0 : Nat), leading, c, cs with *
  have sumValue := IsRingHom.add with origin, constant, product
  have productValue := IsRingHom.mul with origin, variable, rest
  have constantValue := polynomialAtOrigin.constant at oneVariable, A, zero, c
    with *
  have variableValue := polynomialAtOrigin.variable at oneVariable, A, zero,
    one, (0 : Nat) with *
  have restValue := IsRingHom.closed with origin, rest
  have zeroProduct := IsRing.zero_mul with ordinary, restValue
  have addZero := IsRing.add_right_identity with ordinary, coefficient
  have atOrigin := polynomialAtOrigin.value at oneVariable, A, zero,
    polynomialFromHorner(oneVariable, R, (0 : Nat), leading, c :: cs) with *
  unfold hornerPoly
  cc

theorem hornerPoly.coefficient_below (leading : Set) (cs : List(A)) (k : Nat)
  requires initial : leading ∈ R
  requires bound : k < length{A}(cs)
  shows hornerPoly{A}(add, zero, neg, mul, one, leading,
    cs)(monomialShift(oneVariable, (0 : Nat), monomialOne(oneVariable), k)) =
    listCoefficient{A}(zero, cs, k)
proof
  induction cs generalizing k
  | List.nil =>
    intros k kNat bound
    rw length.nil at bound
    have impossible : (0 : Nat) < (0 : Nat)
      arith
    exfalso
    have irreflexive := Less.irreflexive with Naturals.constructor.zero
    exact irreflexive with impossible
  | List.cons(c, tail) using ih =>
    intros k kNat bound
    have coefficient : c ∈ R by assumption
    have index := oneVariable.index
    have unit := monomialOne.member at oneVariable
    have shape := natural.zero_or_successor at k with *
    cases shape with isZero | successor
    . have unshifted := monomialShift.zero at oneVariable, (0 : Nat),
        monomialOne(oneVariable) with *
      have constant := hornerPoly.constant_coefficient at A, add, zero, neg,
        mul, one, leading, c, tail with *
      rw [isZero, unshifted, constant, listCoefficient.zero]
      rfl
    . obtain ⟨r, rNat, equal⟩ := successor
      rw [equal, length.cons] at bound
      have smaller : r < length{A}(tail) by arith
      have previous := ih with r, rNat, smaller
      have step := polynomialFromHorner.coefficient_succ at oneVariable, A,
        add, zero, neg, mul, one, (0 : Nat), leading, c, tail, r with *
      unfold hornerPoly at previous
      unfold hornerPoly
      rw [equal, step, previous, listCoefficient.succ]
      rfl

theorem hornerPoly.coefficient (leading : Set) (cs : List(A)) (k : Nat)
  requires initial : leading ∈ R
  shows hornerPoly{A}(add, zero, neg, mul, one, leading,
    cs)(monomialShift(oneVariable, 0, monomialOne(oneVariable), k)) =
    hornerCoefficient{A}(zero, leading, cs, k)
proof
  have index := oneVariable.index
  have lengthNat : Nat(length{A}(cs)) by typecheck
  have comparison := Less.trichotomy at k, length{A}(cs) with *
  cases comparison with below | rest
  . have value := hornerPoly.coefficient_below at A, add, zero, neg, mul, one,
      leading, cs, k with *
    have entry := hornerCoefficient.below at A, zero, leading, cs, k with *
    rw [value, entry]
    rfl
  . cases rest with same | above
    . have value := polynomialFromHorner.leading_coefficient at oneVariable,
        A, add, zero, neg, mul, one, (0 : Nat), leading, cs with *
      have entry := hornerCoefficient.leading at A, zero, leading, cs with *
      unfold hornerPoly
      rw [same, value, entry]
      rfl
    . have value := polynomialFromHorner.coefficient_above_length at
        oneVariable, A, add, zero, neg, mul, one, (0 : Nat), leading, cs, k
        with *
      have entry := hornerCoefficient.above at A, zero, leading, cs, k with *
      unfold hornerPoly
      rw [value, entry]
      rfl

-- Two pairs are the same polynomial exactly when their coefficients agree.
theorem hornerPoly.eq_iff (a b : Set) (cs ds : List(A))
  requires left : a ∈ R
  requires right : b ∈ R
  shows hornerPoly{A}(add, zero, neg, mul, one, a, cs) = hornerPoly{A}(add,
    zero, neg, mul, one, b, ds) ↔
    ∀ k, Nat(k) →
      hornerCoefficient{A}(zero, a, cs, k) =
        hornerCoefficient{A}(zero, b, ds, k)
proof
  have leftMember := hornerPoly.member at A, add, zero, neg, mul, one, a, cs
    with *
  have rightMember := hornerPoly.member at A, add, zero, neg, mul, one, b, ds
    with *
  constructor
  . intros equal k kNat
    have first := hornerPoly.coefficient at A, add, zero, neg, mul, one, a, cs,
      k with *
    have second := hornerPoly.coefficient at A, add, zero, neg, mul, one, b,
      ds, k with *
    rw [← first, ← second, equal]
    rfl
  . intro agree
    apply polynomials.ext at oneVariable, A, zero with leftMember, rightMember
    intros m monomial
    have representation := oneVariable.monomial with monomial
    have index := oneVariable.index
    have exponent := monomials.exponent at oneVariable, m, (0 : Nat) with *
    have first := hornerPoly.coefficient at A, add, zero, neg, mul, one, a, cs,
      m((0 : Nat)) with *
    have second := hornerPoly.coefficient at A, add, zero, neg, mul, one, b,
      ds, m((0 : Nat)) with *
    have same := agree with m((0 : Nat)), exponent
    rw representation
    rw [first, second, same]
    rfl

theorem hornerPoly.zero_iff (leading : Set) (cs : List(A))
  requires initial : leading ∈ R
  shows hornerPoly{A}(add, zero, neg, mul, one, leading,
    cs) = P[0] ↔ HornerZero(A, zero, leading, cs)
proof
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have empty : List(A, []) by typecheck
  have zeroPoly : hornerPoly{A}(add, zero, neg, mul, one, zero, []) = P[0]
    unfold hornerPoly
    rw polynomialFromHorner.nil
    exact polynomialConstant.zero at oneVariable, A, zero with *
  have equivalence := hornerPoly.eq_iff at A, add, zero, neg, mul, one,
    leading, zero, cs, [] with *
  have vanish : ∀ k, Nat(k) → hornerCoefficient{A}(zero, zero, [], k) = zero
    intros k kNat
    unfold hornerCoefficient
    unfold hornerFullList
    rw append
    exact hornerCoefficient.singleton_zero at A, zero, k with *
  rw ← zeroPoly
  rw equivalence
  unfold HornerZero
  constructor
  . intros agree k kNat
    have value := vanish with k, kNat
    have same := agree with k, kNat
    rw [same, value]
    rfl
  . intros zeros k kNat
    have value := vanish with k, kNat
    have same := zeros with k, kNat
    rw [same, value]
    rfl

-- Lists of one length with the same polynomial and leading are equal.
theorem hornerPoly.list_unique (leading : Set) (cs ds : List(A))
  requires initial : leading ∈ R
  requires sameLength : length{A}(cs) = length{A}(ds)
  requires equal : hornerPoly{A}(add, zero, neg, mul, one, leading,
    cs) = hornerPoly{A}(add, zero, neg, mul, one, leading, ds)
  shows cs = ds
proof
  have equivalence := hornerPoly.eq_iff at A, add, zero, neg, mul, one,
    leading, leading, cs, ds with *
  have agree := equivalence.forward with equal
  have entries : ∀ n, Nat(n) → n < length{A}(cs) →
      listCoefficient{A}(zero, cs, n) = listCoefficient{A}(zero, ds, n)
    intros n nNat bound
    have boundDs : n < length{A}(ds)
      rw ← sameLength
      exact bound
    have first := hornerCoefficient.below at A, zero, leading, cs, n with *
    have second := hornerCoefficient.below at A, zero, leading, ds, n with *
    have same := agree with n, nNat
    rw [← first, ← second]
    exact same
  exact listCoefficient.ext at A, zero, cs, ds with *

theorem hornerPoly.full_list (leading : Set) (cs : List(A))
  requires initial : leading ∈ R
  shows hornerPoly{A}(add, zero, neg, mul, one, zero,
    hornerFullList{A}(leading, cs)) =
    hornerPoly{A}(add, zero, neg, mul, one, leading, cs)
proof
  unfold hornerPoly
  exact polynomialFromHorner.full_list with *

theorem hornerPoly.normal (leading : Set) (cs : List(A))
  requires initial : leading ∈ R
  shows hornerPoly{A}(add, zero, neg, mul, one, normalLeading{A}(zero, leading,
    cs), normalLower{A}(zero, leading, cs)) =
    hornerPoly{A}(add, zero, neg, mul, one, leading, cs)
proof
  have full := hornerFullList.list at A, leading, cs with *
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have normalIn : normalLeading{A}(zero, leading, cs) ∈ R
    unfold normalLeading
    exact hornerTrimLeading.mem at A, zero, hornerFullList{A}(leading, cs)
      with *
  have lowerList : List(A, normalLower{A}(zero, leading, cs))
    unfold normalLower
    exact hornerTrimLower.list at A, zero, hornerFullList{A}(leading, cs)
      with *
  have equivalence := hornerPoly.eq_iff at A, add, zero, neg, mul, one,
    normalLeading{A}(zero, leading, cs), leading,
    normalLower{A}(zero, leading, cs), cs with *
  apply equivalence.backward
  intros k kNat
  have trimmed := hornerTrim.coefficient at A, zero,
    hornerFullList{A}(leading, cs), k with *
  unfold normalLeading
  unfold normalLower
  rw trimmed
  unfold hornerCoefficient
  rfl

theorem hornerPoly.add (a b : Set) (cs ds : List(A))
  requires left : a ∈ R
  requires right : b ∈ R
  requires sameLength : length{A}(cs) = length{A}(ds)
  shows hornerPoly{A}(add, zero, neg, mul, one, R[a + b], hornerAdd{A}(add,
    zero, cs, ds)) =
    P[hornerPoly{A}(add, zero, neg, mul, one, a, cs) + hornerPoly{A}(add, zero,
      neg, mul, one, b, ds)]
proof
  unfold hornerPoly
  exact polynomialFromHorner.add with *

theorem hornerPoly.neg (a : Set) (cs : List(A))
  requires initial : a ∈ R
  shows hornerPoly{A}(add, zero, neg, mul, one, neg(a), hornerNeg{A}(neg, cs)) =
    P[-hornerPoly{A}(add, zero, neg, mul, one, a, cs)]
proof
  unfold hornerPoly
  exact polynomialFromHorner.neg with *

theorem hornerPoly.scale (a b : Set) (cs : List(A))
  requires scalar : a ∈ R
  requires initial : b ∈ R
  shows hornerPoly{A}(add, zero, neg, mul, one, R[a * b], hornerScale{A}(mul,
    a, cs)) =
    P[polynomialConstant(oneVariable, R, a) * hornerPoly{A}(add, zero, neg,
      mul, one, b, cs)]
proof
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have value := polynomialCoefficients.value at oneVariable, A, zero, a with *
  have scaled := polynomialFromHorner.scale at oneVariable, A, add, zero, neg,
    mul, one, (0 : Nat), a, b, cs with *
  rw value at scaled
  unfold hornerPoly
  exact scaled

theorem hornerPoly.mul (a b : Set) (cs ds : List(A))
  requires left : a ∈ R
  requires right : b ∈ R
  shows hornerPoly{A}(add, zero, neg, mul, one, R[a * b], hornerMulList{A}(add,
    zero, mul, a, b, cs, ds)) =
    P[hornerPoly{A}(add, zero, neg, mul, one, a, cs) * hornerPoly{A}(add, zero,
      neg, mul, one, b, ds)]
proof
  unfold hornerPoly
  exact polynomialFromHorner.mul with *

theorem hornerPoly.constant (a : Set)
  requires initial : a ∈ R
  shows hornerPoly{A}(add, zero, neg, mul, one, a,
    []) = polynomialConstant(oneVariable, R, a)
proof
  unfold hornerPoly
  exact polynomialFromHorner.nil at oneVariable, A, add, zero, neg, mul, one,
    (0 : Nat), a

-- The value at x is the evaluation at the assignment sending 0 to x.
theorem hornerPoly.value (leading x : Set) (cs : List(A))
  requires initial : leading ∈ R
  requires element : x ∈ R
  shows polynomialAt(oneVariable, R, constantFunction(oneVariable, A,
    x))(hornerPoly{A}(add, zero, neg, mul, one, leading, cs)) =
    hornerAt{A}(add, mul, leading, x, cs)
proof
  have index := oneVariable.index
  have assignment := constantFunction.function at oneVariable, A, x with *
  have coordinate := constantFunction.apply at oneVariable, A, (0 : Nat), x
    with *
  have evaluation := polynomialAt.from_horner at oneVariable, A, add, zero,
    neg, mul, one, (0 : Nat), leading, constantFunction(oneVariable, A, x), cs
    with *
  unfold hornerPoly
  rw [evaluation, coordinate]
  rfl

-- Equal polynomials take equal values.
theorem hornerAt.congr_of_poly (a b x : Set) (cs ds : List(A))
  requires left : a ∈ R
  requires right : b ∈ R
  requires element : x ∈ R
  requires equal : hornerPoly{A}(add, zero, neg, mul, one, a,
    cs) = hornerPoly{A}(add, zero, neg, mul, one, b, ds)
  shows hornerAt{A}(add, mul, a, x, cs) = hornerAt{A}(add, mul, b, x, ds)
proof
  have first := hornerPoly.value at A, add, zero, neg, mul, one, a, x, cs
    with *
  have second := hornerPoly.value at A, add, zero, neg, mul, one, b, x, ds
    with *
  rw [← first, ← second, equal]
  rfl

theorem hornerAt.normal (leading x : Set) (cs : List(A))
  requires initial : leading ∈ R
  requires element : x ∈ R
  shows hornerAt{A}(add, mul, normalLeading{A}(zero, leading, cs), x,
    normalLower{A}(zero, leading, cs)) =
    hornerAt{A}(add, mul, leading, x, cs)
proof
  have full := hornerFullList.list at A, leading, cs with *
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have normalIn : normalLeading{A}(zero, leading, cs) ∈ R
    unfold normalLeading
    exact hornerTrimLeading.mem at A, zero, hornerFullList{A}(leading, cs)
      with *
  have lowerList : List(A, normalLower{A}(zero, leading, cs))
    unfold normalLower
    exact hornerTrimLower.list at A, zero, hornerFullList{A}(leading, cs)
      with *
  have same := hornerPoly.normal at A, add, zero, neg, mul, one, leading, cs
    with *
  exact hornerAt.congr_of_poly at A, add, zero, neg, mul, one,
    normalLeading{A}(zero, leading, cs), leading, x,
    normalLower{A}(zero, leading, cs), cs with *

end Rings

section Domains
variable (A add zero neg mul one : Set)
notation ring R := (A, add, zero, neg, mul, one)
notation ring P := R[oneVariable]
hypothesis domain : IsIntegralDomain(R)
hypothesis infinite : ¬Finite(R)

-- Finitely many roots over an integral domain, by the argument for fields.
theorem hornerAt.roots_divide_domain (leading a c : Set) (cs : List(A))
  requires initial : leading ∈ R
  requires center : a ∈ R
  requires coefficient : c ∈ R
  requires root : hornerAt{A}(add, mul, leading, a, c :: cs) = R[0]
  shows hornerRoots{A}(add, zero, mul, leading, c :: cs) ⊆
    insert(a, hornerRoots{A}(add, zero, mul, leading,
      hornerQuotient{A}(add, mul, leading, a, cs)))
proof
  have ring := IsIntegralDomain.comm_ring with domain
  have ordinary := IsCommRing.ring with ring
  have quotient := hornerQuotient.closed at A, add, zero, neg, mul, one,
    leading, a, cs with *
  have noZero := IsIntegralDomain.no_zero_divisors with domain
  intros x hx
  obtain ⟨element, vanishes⟩ := hornerRoots.membership.forward at
    A, add, zero, mul, leading, c :: cs, x with *
  have division := hornerAt.synthetic_division at A, add, zero, neg, mul, one,
    leading, a, x, c, cs with *
  have value := hornerAt.closed at A, add, zero, neg, mul, one, leading, x,
    hornerQuotient{A}(add, mul, leading, a, cs) with *
  have negative := IsRing.neg_closed with ordinary, center
  have difference := IsRing.add_closed with ordinary, element, negative
  rw [root, vanishes] at division
  have productZero : R[(x - a) * hornerAt{A}(add, mul, leading, x,
      hornerQuotient{A}(add, mul, leading, a, cs))] = R[0]
    linear_combination -division
  have alternatives := noZero with R[x - a], difference,
    hornerAt{A}(add, mul, leading, x, hornerQuotient{A}(add, mul, leading, a,
      cs)), productZero
  cases alternatives with same | remaining
  . have equal : x = a
      linear_combination same
    rw equal
    exact insert.self
  . have member : x ∈ hornerRoots{A}(add, zero, mul, leading,
        hornerQuotient{A}(add, mul, leading, a, cs))
      apply hornerRoots.membership.backward
      refine ⟨element, remaining⟩
    exact insert.contains with member

theorem hornerAt.roots_finite_domain (leading : Set) (n : Nat)
    (cs : List(A))
  requires initial : leading ∈ R
  requires nonzero : leading ≠ R[0]
  requires size : length{A}(cs) = n
  shows Finite(hornerRoots{A}(add, zero, mul, leading, cs))
proof
  induction n generalizing cs
  | zero =>
    intros cs list size
    have cases := List.cases with list
    cases cases with empty | cons
    . rw [empty, hornerRoots.nil]
      exact Finite.empty
    . obtain ⟨c, coefficient, tail, tailList, shape⟩ := cons
      rw [shape, length.cons] at size
      have impossible := Naturals.disjoint.zero.succ at length{A}(tail)
      exfalso
      apply impossible
      symm
      exact size
  | succ(k) using ih =>
    intros cs list size
    have cases := List.cases with list
    cases cases with empty | cons
    . rw [empty, hornerRoots.nil]
      exact Finite.empty
    . obtain ⟨c, coefficient, tail, tailList, shape⟩ := cons
      have tailSize : length{A}(tail) = k
        rw [shape, length.cons] at size
        exact Naturals.injective.succ with size
      have alternatives : (∃ a, a ∈ hornerRoots{A}(add, zero, mul, leading,
        cs)) ∨ ¬(∃ a, a ∈ hornerRoots{A}(add, zero, mul, leading, cs))
        tauto
      cases alternatives with inhabited | emptyRoots
      . obtain ⟨a, ha⟩ := inhabited
        rw shape at ha
        obtain ⟨center, root⟩ := hornerRoots.membership.forward at
          A, add, zero, mul, leading, c :: tail, a with *
        have ring := IsIntegralDomain.comm_ring with domain
        have quotient := hornerQuotient.closed at A, add, zero, neg, mul, one,
          leading, a, tail with *
        have quotientLength := hornerQuotient.length at A, add, zero, neg, mul,
          one, leading, a, tail with *
        have quotientSize : length{A}(hornerQuotient{A}(add, mul, leading, a,
          tail)) = k by cc
        have finite := ih with hornerQuotient{A}(add, mul, leading, a, tail),
          quotientSize
        have inserted := Finite.insert at hornerRoots{A}(add, zero, mul,
          leading, hornerQuotient{A}(add, mul, leading, a, tail)), a with finite
        have subset := hornerAt.roots_divide_domain at A, add, zero, neg, mul,
          one, leading, a, c, tail with *
        rw shape
        exact Finite.subset with inserted, subset
      . have empty : hornerRoots{A}(add, zero, mul, leading, cs) = ∅
          ext x
          constructor
          . intro member
            exfalso
            apply emptyRoots
            refine ⟨x, member⟩
          . intro impossible
            exfalso
            exact set.empty with impossible
        rw empty
        exact Finite.empty

theorem hornerAt.exists_nonzero_domain (leading : Set) (cs : List(A))
  requires initial : leading ∈ R
  requires nonzero : leading ≠ R[0]
  shows ∃ x ∈ R, hornerAt{A}(add, mul, leading, x, cs) ≠ R[0]
proof
  have size : length{A}(cs) = length{A}(cs) by rfl
  have finite := hornerAt.roots_finite_domain at A, add, zero, neg,
    mul, one, leading, length{A}(cs), cs with *
  by_contra absent
  have equal : hornerRoots{A}(add, zero, mul, leading, cs) = R
    ext x
    constructor
    . intro member
      have data := hornerRoots.membership.forward with member
      exact data.left
    . intro member
      apply hornerRoots.membership.backward
      refine ⟨member, ?_⟩
      by_contra value
      apply absent
      refine ⟨x, member, value⟩
  rw equal at finite
  exact infinite with finite

-- A full coefficient list vanishing everywhere has only zero entries.
theorem hornerAt.zero_coefficients_of_values (rs : List(A))
  requires vanishes : ∀ x ∈ R, hornerAt{A}(add, mul, zero, x, rs) = R[0]
  shows ∀ k, Nat(k) → listCoefficient{A}(zero, rs, k) = zero
proof
  intros k kNat
  by_contra different
  have nonzero : ∃ n, Nat(n) ∧ listCoefficient{A}(zero, rs, n) ≠ zero
    refine ⟨k, kNat, different⟩
  have ring := IsIntegralDomain.comm_ring with domain
  obtain ⟨leading, initial, differentLeading, lower, list, equal⟩ :=
    hornerAt.normalize at A, add, zero, neg, mul, one, rs with *
  obtain ⟨x, element, value⟩ := hornerAt.exists_nonzero_domain at A, add,
    zero, neg, mul, one, leading, lower with *
  have same := equal with x, element
  have zeroValue := vanishes with x, element
  apply value
  rw ← same
  exact zeroValue

-- Entries of the padded sum and of the negation, position by position.
theorem hornerAdd.coefficient (cs ds : List(A)) (k : Nat)
  requires bound : k < length{A}(cs)
  shows listCoefficient{A}(zero, hornerAdd{A}(add, zero, cs, ds), k) =
    R[listCoefficient{A}(zero, cs, k) + listCoefficient{A}(zero, ds, k)]
proof
  induction cs generalizing ds k
  | List.nil =>
    intros ds k dsList kNat bound
    rw length.nil at bound
    have impossible : (0 : Nat) < (0 : Nat)
      arith
    exfalso
    have irreflexive := Less.irreflexive with Naturals.constructor.zero
    exact irreflexive with impossible
  | List.cons(c, tail) using ih =>
    intros ds k dsList kNat bound
    have coefficient : c ∈ A by assumption
    have rest := listTail.closed at A, ds with *
    have shape := natural.zero_or_successor at k with *
    cases shape with isZero | successor
    . rw [isZero, hornerAdd]
      simp [listCoefficient, listHeadOr]
    . obtain ⟨r, rNat, equal⟩ := successor
      rw [equal, length.cons] at bound
      have smaller : r < length{A}(tail) by arith
      have previous := ih with listTail{A}(ds), r, rest, rNat, smaller
      rw [equal, hornerAdd]
      simp [listCoefficient, listTail]

theorem hornerNeg.coefficient (cs : List(A)) (k : Nat)
  shows listCoefficient{A}(zero, hornerNeg{A}(neg, cs), k) =
    neg(listCoefficient{A}(zero, cs, k))
proof
  have ring := IsIntegralDomain.comm_ring with domain
  have negZero := IsCommRing.neg_zero with ring
  induction cs generalizing k
  | List.nil =>
    intros k kNat
    unfold hornerNeg
    rw [listMap, listCoefficient.nil]
    symm
    exact negZero
  | List.cons(c, tail) using ih =>
    intros k kNat
    have coefficient : c ∈ A by assumption
    unfold hornerNeg at ih
    unfold hornerNeg
    have shape := natural.zero_or_successor at k with *
    cases shape with isZero | successor
    . rw [isZero, listMap]
      simp [listCoefficient, listHeadOr]
    . obtain ⟨r, rNat, equal⟩ := successor
      have previous := ih with r, rNat
      rw [equal, listMap]
      simp [listCoefficient, listTail]

-- The case of a shorter second pair; the general statement follows by
-- symmetry.
theorem hornerPoly.eq_of_values_le (a b : Set) (cs ds : List(A))
  requires left : a ∈ R
  requires right : b ∈ R
  requires shorter : length{A}(ds) ≤ length{A}(cs)
  requires agree : ∀ x ∈ R,
    hornerAt{A}(add, mul, a, x, cs) = hornerAt{A}(add, mul, b, x, ds)
  shows hornerPoly{A}(add, zero, neg, mul, one, a, cs) = hornerPoly{A}(add,
    zero, neg, mul, one, b, ds)
proof
  have ring := IsIntegralDomain.comm_ring with domain
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have rsList := hornerFullList.list at A, a, cs with *
  have ssList := hornerFullList.list at A, b, ds with *
  have rsLength := hornerFullList.length at A, a, cs with *
  have ssLength := hornerFullList.length at A, b, ds with *
  have negData := hornerNeg.data at A, add, zero, neg, mul, one,
    hornerFullList{A}(b, ds) with *
  have negList := negData.left
  have lengths : length{A}(hornerNeg{A}(neg, hornerFullList{A}(b, ds))) ≤
      length{A}(hornerFullList{A}(a, cs))
    rw [negData.right, rsLength, ssLength]
    arith
  have sumData := hornerAdd.data at A, add, zero, neg, mul, one,
    hornerFullList{A}(a, cs), hornerNeg{A}(neg, hornerFullList{A}(b, ds))
    with *
  have sumList := sumData.left
  have sumValues : ∀ x ∈ R, hornerAt{A}(add, mul, zero, x,
      hornerAdd{A}(add, zero, hornerFullList{A}(a, cs),
        hornerNeg{A}(neg, hornerFullList{A}(b, ds)))) = R[0]
    intros x element
    have split := hornerAdd.value_short at A, add, zero, neg, mul, one, zero,
      x, hornerFullList{A}(a, cs), hornerNeg{A}(neg, hornerFullList{A}(b, ds))
      with *
    have negValue := hornerNeg.value at A, add, zero, neg, mul, one, zero, x,
      hornerFullList{A}(b, ds) with *
    have negZero := IsCommRing.neg_zero with ring
    rw negZero at negValue
    have first := hornerFullList.value at A, add, zero, neg, mul, one, a, x,
      cs with *
    have second := hornerFullList.value at A, add, zero, neg, mul, one, b, x,
      ds with *
    have same := agree with x, element
    have valueB := hornerAt.closed at A, add, zero, neg, mul, one, b, x, ds
      with *
    rw [split, negValue, first, second, same]
    ring
  have zeros := hornerAt.zero_coefficients_of_values at A, add, zero, neg,
    mul, one, hornerAdd{A}(add, zero, hornerFullList{A}(a, cs),
      hornerNeg{A}(neg, hornerFullList{A}(b, ds))) with *
  have equivalence := hornerPoly.eq_iff at A, add, zero, neg, mul, one, a, b,
    cs, ds with *
  apply equivalence.backward
  intros k kNat
  unfold hornerCoefficient
  have sumEntry := zeros with k, kNat
  have negEntry := hornerNeg.coefficient at A, add, zero, neg, mul, one,
    hornerFullList{A}(b, ds), k with *
  have rsIn := listCoefficient.closed at A, zero, hornerFullList{A}(a, cs), k
    with *
  have ssIn := listCoefficient.closed at A, zero, hornerFullList{A}(b, ds), k
    with *
  have alternatives : k < length{A}(hornerFullList{A}(a, cs)) ∨
    ¬(k < length{A}(hornerFullList{A}(a, cs))) by tauto
  cases alternatives with inside | outside
  . have sumCoefficient := hornerAdd.coefficient at A, add, zero, neg, mul,
      one, hornerFullList{A}(a, cs), hornerNeg{A}(neg, hornerFullList{A}(b,
      ds)), k with *
    rw [sumCoefficient, negEntry] at sumEntry
    linear_combination sumEntry
  . have bound := LessEqual.of_not_Less with outside
    have rsZero := listCoefficient.outside at A, zero, hornerFullList{A}(a,
      cs), k with *
    have ssBound : length{A}(hornerFullList{A}(b, ds)) ≤ k
      rw ssLength
      rw rsLength at bound
      arith
    have ssZero := listCoefficient.outside at A, zero, hornerFullList{A}(b,
      ds), k with *
    rw [rsZero, ssZero]
    rfl

-- Over an infinite integral domain, equal values everywhere force equal
-- polynomials.
theorem hornerPoly.eq_of_values (a b : Set) (cs ds : List(A))
  requires left : a ∈ R
  requires right : b ∈ R
  requires agree : ∀ x ∈ R, hornerAt{A}(add, mul, a, x, cs) = hornerAt{A}(add,
    mul, b, x, ds)
  shows hornerPoly{A}(add, zero, neg, mul, one, a, cs) = hornerPoly{A}(add,
    zero, neg, mul, one, b, ds)
proof
  have csNat : Nat(length{A}(cs)) by typecheck
  have dsNat : Nat(length{A}(ds)) by typecheck
  have alternatives : length{A}(cs) < length{A}(ds) ∨
    ¬(length{A}(cs) < length{A}(ds)) by tauto
  cases alternatives with longer | shorter
  . have below : length{A}(cs) ≤ length{A}(ds) by arith
    have agreeSymm : ∀ x ∈ R, hornerAt{A}(add, mul, b, x, ds) =
        hornerAt{A}(add, mul, a, x, cs)
      intros x element
      symm
      exact agree with x, element
    symm
    exact hornerPoly.eq_of_values_le at A, add, zero, neg, mul, one, b, a, ds,
      cs with *
  . have below := LessEqual.of_not_Less with shorter
    exact hornerPoly.eq_of_values_le at A, add, zero, neg, mul, one, a, b, cs,
      ds with *

theorem HornerZero.of_values (leading : Set) (cs : List(A))
  requires initial : leading ∈ R
  requires vanishes : ∀ x ∈ R, hornerAt{A}(add, mul, leading, x, cs) = R[0]
  shows HornerZero(A, zero, leading, cs)
proof
  have ring := IsIntegralDomain.comm_ring with domain
  have full := hornerFullList.list at A, leading, cs with *
  have fullValues : ∀ x ∈ R, hornerAt{A}(add, mul, zero, x,
      hornerFullList{A}(leading, cs)) = R[0]
    intros x element
    have same := hornerFullList.value at A, add, zero, neg, mul, one, leading,
      x, cs with *
    rw same
    exact vanishes with x, element
  have zeros := hornerAt.zero_coefficients_of_values at A, add, zero, neg,
    mul, one, hornerFullList{A}(leading, cs) with *
  unfold HornerZero
  intros k kNat
  unfold hornerCoefficient
  exact zeros with k, kNat

end Domains
