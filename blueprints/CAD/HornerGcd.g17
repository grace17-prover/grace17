-- The Euclidean algorithm for Horner pairs over a field: the greatest
-- common divisor hornerGcd of two pairs as a pair in normal form, its
-- divisibility laws, Bézout coefficients, coprime pairs HornerCoprime
-- (a Bézout identity equal to 1), squarefree pairs HornerSquarefree
-- (coprime to the derivative), and a root of the gcd as a common root.
-- Part of the CAD blueprint.
-- Planned home: Algebra/Polynomial/HornerGcd.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module CAD.HornerGcd
import CAD.HornerDivision
import CAD.HornerDerivative

-- The remainder of (a, cs) by (b, ds) brought to normal form, as the pair
-- (leading, lower).
def hornerRemainderPair {A : Set} (add zero neg mul one b a : Set)
  (ds cs : List(A)) : Set :=
  (hornerTrimLeading{A}(zero,
      hornerDivRemainder{A}(add, zero, neg, mul, one, b, a, ds, cs)),
    hornerTrimLower{A}(zero,
      hornerDivRemainder{A}(add, zero, neg, mul, one, b, a, ds, cs)))

-- Euclid's steps on pairs (a, cs), (b, ds) with (b, ds) in normal form:
-- stop when b = 0, else continue with (b, ds) and the remainder.
def gcdSteps {A : Set} (add zero neg mul one : Set, n : Nat,
    a cs b ds : Set) → Set
  | add, zero, neg, mul, one, 0, a, cs, b, ds => (a, cs)
  | add, zero, neg, mul, one, succ(n), a, cs, b, ds =>
      boolChoice(memberTest({zero}, b), (a, cs),
        gcdSteps(add, zero, neg, mul, one, n, b, ds,
          fst(hornerRemainderPair{A}(add, zero, neg, mul, one, b, a, ds, cs)),
          snd(hornerRemainderPair{A}(add, zero, neg, mul, one, b, a, ds, cs))))
  descends n

-- The gcd pair: both inputs are brought to normal form first, and the
-- length of ds bounds the number of steps.
def hornerGcdPair {A : Set} (add zero neg mul one a b : Set)
  (cs ds : List(A)) : Set :=
  gcdSteps{A}(add, zero, neg, mul, one, succ(length{A}(ds)),
    normalLeading{A}(zero, a, cs), normalLower{A}(zero, a, cs),
    normalLeading{A}(zero, b, ds), normalLower{A}(zero, b, ds))

def hornerGcdLeading {A : Set} (add zero neg mul one a b : Set)
  (cs ds : List(A)) : Set :=
  fst(hornerGcdPair{A}(add, zero, neg, mul, one, a, b, cs, ds))
def hornerGcdLower {A : Set} (add zero neg mul one a b : Set)
  (cs ds : List(A)) : Set :=
  snd(hornerGcdPair{A}(add, zero, neg, mul, one, a, b, cs, ds))

-- Coprime pairs: a Bézout identity with value 1.
predicate HornerCoprime (A add zero neg mul one a cs b ds : Set) :=
  ∃ us, List(A, us) ∧ ∃ vs, List(A, vs) ∧
    hornerPoly{A}(add, zero, neg, mul, one, one, []) =
      call2(polynomialAdd(oneVariable, A, add, zero, neg, mul, one),
        call2(polynomialMul(oneVariable, A, add, zero, neg, mul, one),
          hornerPoly{A}(add, zero, neg, mul, one, zero, us),
          hornerPoly{A}(add, zero, neg, mul, one, a, cs)),
        call2(polynomialMul(oneVariable, A, add, zero, neg, mul, one),
          hornerPoly{A}(add, zero, neg, mul, one, zero, vs),
          hornerPoly{A}(add, zero, neg, mul, one, b, ds)))

-- Squarefree pairs: coprime to the derivative pair.
predicate HornerSquarefree (A add zero neg mul one a cs : Set) :=
  HornerCoprime(A, add, zero, neg, mul, one, a, cs,
    hornerDerivativeLeading{A}(add, zero, one, mul, a, cs),
      hornerDerivativeList{A}(add, zero, one, mul, cs))

section Fields
variable (A add zero neg mul one a b : Set)
notation ring R := (A, add, zero, neg, mul, one)
notation ring P := R[oneVariable]
hypothesis field : IsField(R)
hypothesis left : a ∈ R
hypothesis right : b ∈ R

theorem hornerGcdLeading.mem (cs ds : List(A))
  shows hornerGcdLeading{A}(add, zero, neg, mul, one, a, b, cs, ds) ∈ R
proof
  sorry

theorem hornerGcdLower.list (cs ds : List(A))
  shows List(A, hornerGcdLower{A}(add, zero, neg, mul, one, a, b, cs, ds))
proof
  sorry

-- The gcd is in normal form.
theorem hornerGcd.normal (cs ds : List(A))
  shows hornerGcdLeading{A}(add, zero, neg, mul, one, a, b, cs, ds) ≠ R[0] ∨
    (hornerGcdLeading{A}(add, zero, neg, mul, one, a, b, cs, ds) = R[0] ∧
      hornerGcdLower{A}(add, zero, neg, mul, one, a, b, cs, ds) = [])
proof
  sorry

theorem hornerGcd.divides_left (cs ds : List(A))
  shows HornerDivides(A, add, zero, neg, mul, one,
    hornerGcdLeading{A}(add, zero, neg, mul, one, a, b, cs, ds),
    hornerGcdLower{A}(add, zero, neg, mul, one, a, b, cs, ds), a, cs)
proof
  sorry

theorem hornerGcd.divides_right (cs ds : List(A))
  shows HornerDivides(A, add, zero, neg, mul, one,
    hornerGcdLeading{A}(add, zero, neg, mul, one, a, b, cs, ds),
    hornerGcdLower{A}(add, zero, neg, mul, one, a, b, cs, ds), b, ds)
proof
  sorry

theorem hornerGcd.greatest (g : Set) (cs ds gs : List(A))
  requires divisor : g ∈ R
  requires dividesLeft : HornerDivides(A, add, zero, neg, mul, one, g, gs, a,
    cs)
  requires dividesRight : HornerDivides(A, add, zero, neg, mul, one, g, gs, b,
    ds)
  shows HornerDivides(A, add, zero, neg, mul, one, g, gs,
    hornerGcdLeading{A}(add, zero, neg, mul, one, a, b, cs, ds),
    hornerGcdLower{A}(add, zero, neg, mul, one, a, b, cs, ds))
proof
  sorry

-- Bézout: the gcd is a polynomial combination of the two pairs.
theorem hornerGcd.bezout (cs ds : List(A))
  shows ∃ us, List(A, us) ∧ ∃ vs, List(A, vs) ∧
    hornerPoly{A}(add, zero, neg, mul, one,
        hornerGcdLeading{A}(add, zero, neg, mul, one, a, b, cs, ds),
        hornerGcdLower{A}(add, zero, neg, mul, one, a, b, cs, ds)) =
      P[hornerPoly{A}(add, zero, neg, mul, one, zero, us) * hornerPoly{A}(add,
        zero, neg, mul, one, a, cs) +
        hornerPoly{A}(add, zero, neg, mul, one, zero, vs) * hornerPoly{A}(add,
          zero, neg, mul, one, b, ds)]
proof
  sorry

theorem hornerGcd.nonzero_of_left (cs ds : List(A))
  requires nonzero : a ≠ R[0]
  shows hornerGcdLeading{A}(add, zero, neg, mul, one, a, b, cs, ds) ≠ R[0]
proof
  sorry

theorem hornerGcd.length_le_left (cs ds : List(A))
  requires nonzero : a ≠ R[0]
  shows length{A}(hornerGcdLower{A}(add, zero, neg, mul, one, a, b, cs,
    ds)) ≤ length{A}(cs)
proof
  sorry

-- A root of the gcd is a common root, and conversely.
theorem hornerGcd.root_iff (x : Set) (cs ds : List(A))
  requires element : x ∈ R
  requires nonzero : a ≠ R[0]
  shows hornerAt{A}(add, mul, hornerGcdLeading{A}(add, zero, neg, mul, one, a,
    b, cs, ds), x,
      hornerGcdLower{A}(add, zero, neg, mul, one, a, b, cs, ds)) = R[0] ↔
    (hornerAt{A}(add, mul, a, x, cs) = R[0] ∧ hornerAt{A}(add, mul, b, x,
      ds) = R[0])
proof
  sorry

theorem HornerCoprime.iff_gcd_constant (cs ds : List(A))
  shows HornerCoprime(A, add, zero, neg, mul, one, a, cs, b, ds) ↔
    (hornerGcdLeading{A}(add, zero, neg, mul, one, a, b, cs, ds) ≠ R[0] ∧
      hornerGcdLower{A}(add, zero, neg, mul, one, a, b, cs, ds) = [])
proof
  sorry

-- Coprime pairs have no common root.
theorem HornerCoprime.no_common_root (x : Set) (cs ds : List(A))
  requires element : x ∈ R
  requires coprime : HornerCoprime(A, add, zero, neg, mul, one, a, cs, b, ds)
  requires rootLeft : hornerAt{A}(add, mul, a, x, cs) = R[0]
  shows hornerAt{A}(add, mul, b, x, ds) ≠ R[0]
proof
  sorry

theorem HornerCoprime.symmetric (cs ds : List(A))
  requires coprime : HornerCoprime(A, add, zero, neg, mul, one, a, cs, b, ds)
  shows HornerCoprime(A, add, zero, neg, mul, one, b, ds, a, cs)
proof
  sorry

-- Euclid's lemma: a pair coprime to p that divides p·q divides q.
theorem HornerCoprime.divides_of_divides_mul (c : Set) (cs ds es : List(A))
  requires third : c ∈ R
  requires coprime : HornerCoprime(A, add, zero, neg, mul, one, a, cs, b, ds)
  requires divides : HornerDivides(A, add, zero, neg, mul, one, a, cs, R[b * c],
    hornerMulList{A}(add, zero, mul, b, c, ds, es))
  shows HornerDivides(A, add, zero, neg, mul, one, a, cs, c, es)
proof
  sorry

-- Not coprime: a common divisor of positive degree in normal form.
theorem HornerCoprime.of_no_common_factor (cs ds : List(A))
  requires leftNonzero : a ≠ R[0]
  requires noFactor : ∀ g ∈ R, g ≠ R[0] → ∀ gs, List(A, gs) → gs ≠ [] →
    ¬(HornerDivides(A, add, zero, neg, mul, one, g, gs, a, cs) ∧
      HornerDivides(A, add, zero, neg, mul, one, g, gs, b, ds))
  shows HornerCoprime(A, add, zero, neg, mul, one, a, cs, b, ds)
proof
  sorry

theorem HornerCoprime.common_factor_of_not (cs ds : List(A))
  requires leftNonzero : a ≠ R[0]
  requires notCoprime : ¬HornerCoprime(A, add, zero, neg, mul, one, a, cs, b,
    ds)
  shows ∃ g ∈ R, g ≠ R[0] ∧ ∃ gs, List(A, gs) ∧ gs ≠ [] ∧
    HornerDivides(A, add, zero, neg, mul, one, g, gs, a, cs) ∧
    HornerDivides(A, add, zero, neg, mul, one, g, gs, b, ds)
proof
  sorry

end Fields

-- The quotient by the gcd with the derivative: the squarefree part, a full
-- list with leading zero.
def squarefreePartList {A : Set} (add zero neg mul one a : Set)
  (cs : List(A)) : Set :=
  hornerDivQuotient{A}(add, zero, neg, mul, one,
    hornerGcdLeading{A}(add, zero, neg, mul, one, a,
      hornerDerivativeLeading{A}(add, zero, one, mul, a, cs), cs,
      hornerDerivativeList{A}(add, zero, one, mul, cs)), a,
    hornerGcdLower{A}(add, zero, neg, mul, one, a,
      hornerDerivativeLeading{A}(add, zero, one, mul, a, cs), cs,
      hornerDerivativeList{A}(add, zero, one, mul, cs)), cs)

section Squarefree
variable (A add zero neg mul one a : Set)
notation ring R := (A, add, zero, neg, mul, one)
hypothesis field : IsField(R)
hypothesis initial : a ∈ R

-- A squarefree pair and its derivative have no common root: its roots
-- are simple.
theorem HornerSquarefree.simple_root (x : Set) (cs : List(A))
  requires element : x ∈ R
  requires squarefree : HornerSquarefree(A, add, zero, neg, mul, one, a, cs)
  requires root : hornerAt{A}(add, mul, a, x, cs) = R[0]
  shows hornerAt{A}(add, mul, hornerDerivativeLeading{A}(add, zero, one, mul,
    a, cs), x,
    hornerDerivativeList{A}(add, zero, one, mul, cs)) ≠ R[0]
proof
  sorry

-- The gcd of a squarefree pair with its derivative is a nonzero constant.
theorem HornerSquarefree.gcd_constant (cs : List(A))
  requires squarefree : HornerSquarefree(A, add, zero, neg, mul, one, a, cs)
  shows hornerGcdLower{A}(add, zero, neg, mul, one, a,
    hornerDerivativeLeading{A}(add, zero, one, mul, a, cs), cs,
    hornerDerivativeList{A}(add, zero, one, mul, cs)) = []
proof
  sorry

theorem squarefreePartList.list (cs : List(A))
  shows List(A, squarefreePartList{A}(add, zero, neg, mul, one, a, cs))
proof
  sorry

theorem squarefreePartList.divides (cs : List(A))
  requires nonzero : a ≠ R[0]
  shows HornerDivides(A, add, zero, neg, mul, one, zero,
    squarefreePartList{A}(add, zero, neg, mul, one, a, cs), a, cs)
proof
  sorry

-- A root of the pair is a root of its squarefree part.
theorem squarefreePartList.root_of_root (x : Set) (cs : List(A))
  requires element : x ∈ R
  requires nonzero : a ≠ R[0]
  requires root : hornerAt{A}(add, mul, a, x, cs) = R[0]
  shows hornerAt{A}(add, mul, zero, x, squarefreePartList{A}(add, zero, neg,
    mul, one, a, cs)) = R[0]
proof
  sorry

end Squarefree
