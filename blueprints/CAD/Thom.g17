-- Thom's lemma: the signs of p, p′, …, p^(deg p) at a real root determine
-- the root, and the set of points realizing a sign condition on all the
-- derivatives is convex.
-- Part of the CAD blueprint.
-- Planned home: Real/Analysis/Thom.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module CAD.Thom
import CAD.RealRootOrder

-- Taking k + 1 derivatives is taking k derivatives of the derivative pair.
theorem realDerivativePair.shift (leading cs : Set) (k : Nat)
  shows realDerivativePair(leading, cs, k + 1) =
    realDerivativePair(realDerivativeLeading(leading, cs),
      realDerivativeList(cs), k)
proof
  induction k
  | zero =>
    have one : 0 + 1 = 1 by ring
    have step := realDerivativePair.succ at leading, cs, 0
    rw one at step
    rw one
    rw [step, (realDerivativePair.zero at leading, cs), fst.pair, snd.pair,
      (realDerivativePair.zero at realDerivativeLeading(leading, cs),
        realDerivativeList(cs))]
  | succ(j) using ih =>
    have two : succ(j) + 1 = (j + 1) + 1 by ring
    have one : succ(j) = j + 1 by ring
    rw [two, one]
    have left := realDerivativePair.succ at leading, cs, j + 1
    have right := realDerivativePair.succ at realDerivativeLeading(leading, cs),
      realDerivativeList(cs), j
    rw [left, right, ih]

-- The leading coefficient of the derivative of a nonconstant pair with a
-- nonzero leading coefficient is nonzero.
theorem realDerivativeLeading.nonzero (h : Set) (hs : List(ℝ))
  requires hIn : h ∈ ℝ
  requires hNonzero : h ≠ realZero
  requires nonempty : hs ≠ []
  shows realDerivativeLeading(h, hs) ≠ realZero
proof
  have typedH : Real(h) by exact hIn
  have lengthNonzero : length{ℝ}(hs) ≠ (0:N)
    have shape := List.cases at ℝ, hs with *
    cases shape with empty | cons
    . exfalso
      exact nonempty with empty
    . obtain ⟨x, xIn, tail, tailList, equal⟩ := cons
      rw equal
      rw length.cons at ℝ, x, tail with xIn
      arith
  have lengthNat : Nat(length{ℝ}(hs)) by typecheck
  have numeral := realNat.numeral at length{ℝ}(hs)
  have natNonzero := realNat.ne_zero at length{ℝ}(hs) with lengthNonzero
  have typedNat : Real(realNat(length{ℝ}(hs))) := realNat.real at length{ℝ}(hs)
  unfold realDerivativeLeading
  unfold hornerDerivativeLeading
  rw ← numeral
  intro same
  have cases := realMulValue.eq_zero_or with same
  cases cases with first | second
  . exact natNonzero with first
  . exact hNonzero with second

-- After as many derivatives as the degree, the pair is a nonzero constant.
theorem realDerivativePair.top (n : Nat)
  shows ∀ a, Real(a) → ∀ ds, List(ℝ, ds) → a ≠ (0:R) → length{ℝ}(ds) = n →
    fst(realDerivativePair(a, ds, n)) ≠ (0:R) ∧
      snd(realDerivativePair(a, ds, n)) = []
proof
  induction n
  | zero =>
    intros a aReal ds dsList aNonzero size
    have nil := length.eq_zero with dsList, size
    rw [nil, (realDerivativePair.zero at a, []), fst.pair, snd.pair]
    exact ⟨aNonzero, rfl⟩
  | succ(m) using ih =>
    intros a aReal ds dsList aNonzero size
    have aIn : a ∈ ℝ by exact aReal
    have nonempty : ds ≠ []
      intro empty
      rw [empty, length.nil] at size
      symm at size
      exact succ.ne_zero with size
    have dNonzero := realDerivativeLeading.nonzero at a, ds with aIn, aNonzero,
      nonempty
    have dReal : Real(realDerivativeLeading(a, ds)) by typecheck
    have dList := realDerivativeList.list at a, ds with aReal, dsList
    have dLength := realDerivativeList.length at a, ds with aReal, dsList
    rw [size, predecessor.succ] at dLength
    have one : succ(m) = m + 1 by ring
    rw one
    rw (realDerivativePair.shift at a, ds, m)
    exact ih with realDerivativeLeading(a, ds), dReal, realDerivativeList(ds),
      dList, dNonzero, dLength

-- Sign bookkeeping.
theorem realSign.nonzero_of_sign_eq (a b : Real)
  requires nonzero : a ≠ 0
  requires same : realSign(b) = realSign(a)
  shows b ≠ 0
proof
  intro zero
  rw zero at same
  have signZero := realSign.of_zero at (0:R) with rfl
  rw signZero at same
  symm at same
  have aZero := (realSign.eq_zero_iff at a).forward with same
  exact nonzero with aZero

theorem realSign.product_negative_of_ne (X Y : Real)
  requires left : X ≠ 0
  requires right : Y ≠ 0
  requires distinct : realSign(X) ≠ realSign(Y)
  shows X * Y < 0
proof
  have productReal : Real(X * Y) by typecheck
  have split := realLess.trichotomy at X * Y, (0:R)
  rcases split with negative | zero | positive
  . exact negative
  . exfalso
    have cases := realMulValue.eq_zero_or at X, Y with zero
    cases cases with xZero | yZero
    . exact left with xZero
    . exact right with yZero
  . exfalso
    have same := realSign.eq_of_product_positive at X, Y with positive
    exact distinct with same

theorem realSign.eq_or_neg (X Y : Real)
  requires left : X ≠ 0
  requires right : Y ≠ 0
  shows realSign(X) = realSign(Y) ∨ realSign(X) = -realSign(Y)
proof
  have productReal : Real(X * Y) by typecheck
  have split := realLess.trichotomy at X * Y, (0:R)
  rcases split with negative | zero | positive
  . right
    exact realSign.ne_of_product_negative at X, Y with negative
  . exfalso
    have cases := realMulValue.eq_zero_or at X, Y with zero
    cases cases with xZero | yZero
    . exact left with xZero
    . exact right with yZero
  . left
    exact realSign.eq_of_product_positive at X, Y with positive

-- Points on either side of a point, inside a prescribed gap.
theorem thom.left_point (A r D : Real)
  requires below : A < r
  requires positive : 0 < D
  shows ∃ Y ∈ ℝ, A < Y ∧ r - D < Y ∧ Y < r
proof
  have halfPositiveD := half.positive at D with positive
  have halfLessD := half.lt_self at D with positive
  have halfRealD := half.real at D
  by_cases far : A < r - D
  . have yReal := realSubValue.real at r, half(D)
    have yIn : r - half(D) ∈ ℝ by exact yReal
    witness r - half(D)
    refine ⟨yIn, _, _, _⟩
    . linarith
    . linarith
    . linarith
  . have near := realLe.of_not_less at r - D, A with far
    have gapReal := realSubValue.real at r, A
    have gapPositive : 0 < r - A by linarith
    have halfPositive := half.positive at r - A with gapPositive
    have halfLess := half.lt_self at r - A with gapPositive
    have halfReal := half.real at r - A
    have yReal := realAddValue.real at A, half(r - A)
    have yIn : A + half(r - A) ∈ ℝ by exact yReal
    witness A + half(r - A)
    refine ⟨yIn, _, _, _⟩
    . linarith
    . linarith
    . linarith

theorem thom.right_point (r W D : Real)
  requires above : r < W
  requires positive : 0 < D
  shows ∃ Z ∈ ℝ, r < Z ∧ Z < W ∧ Z < r + D
proof
  have halfPositiveD := half.positive at D with positive
  have halfLessD := half.lt_self at D with positive
  have halfRealD := half.real at D
  by_cases far : r + D < W
  . have zReal := realAddValue.real at r, half(D)
    have zIn : r + half(D) ∈ ℝ by exact zReal
    witness r + half(D)
    refine ⟨zIn, _, _, _⟩
    . linarith
    . linarith
    . linarith
  . have near := realLe.of_not_less at W, r + D with far
    have gapReal := realSubValue.real at W, r
    have gapPositive : 0 < W - r by linarith
    have halfPositive := half.positive at W - r with gapPositive
    have halfLess := half.lt_self at W - r with gapPositive
    have halfReal := half.real at W - r
    have zReal := realAddValue.real at r, half(W - r)
    have zIn : r + half(W - r) ∈ ℝ by exact zReal
    witness r + half(W - r)
    refine ⟨zIn, _, _, _⟩
    . linarith
    . linarith
    . linarith

section Derivatives
variable (a ds : Set)
hypothesis aIn : a ∈ ℝ
hypothesis dsList : List(ℝ, ds)

-- Near a simple root the value of p has the sign of (Y - X)·p′(X).
theorem hornerFunction.sign_near_simple_root (X : Real)
  requires root : hornerFunction(a, ds)(X) = (0:R)
  requires simple : hornerFunction(realDerivativeLeading(a, ds),
    realDerivativeList(ds))(X) ≠ (0:R)
  shows ∃ E ∈ ℝ, 0 < E ∧ ∀ Y ∈ ℝ, X - E < Y → Y < X + E → Y ≠ X →
    (Y < X → hornerFunction(a, ds)(Y) *
      hornerFunction(realDerivativeLeading(a, ds),
        realDerivativeList(ds))(X) < 0) ∧
    (X < Y → 0 < hornerFunction(a, ds)(Y) *
      hornerFunction(realDerivativeLeading(a, ds),
        realDerivativeList(ds))(X))
proof
  have realX : X ∈ ℝ by simp [Real]
  have derivative := hornerFunction.has_derivative_at at a, ds, X with aIn,
    dsList
  have function := HasDerivativeAt.function with derivative
  have limit := HasDerivativeAt.limit with derivative
  have slopeReal := hornerFunction.derivative_real at a, ds, X with aIn, dsList
  have quotientFunction := differenceQuotient.function at
    hornerFunction(a, ds), X with function
  have split := realLess.trichotomy at hornerFunction(realDerivativeLeading(
    a, ds), realDerivativeList(ds))(X), (0:R)
  rcases split with negative | zero | positive
  . obtain ⟨E, realE, positiveE, near⟩ := TendsToAt.eventually_negative with
      limit, negative
    witness E
    refine ⟨realE, positiveE, _⟩
    intros Y realY lower upper distinct
    have typedY : Real(Y) by exact realY
    have hReal := realSubValue.real at Y, X
    have hIn : Y - X ∈ ℝ by exact hReal
    have hNonzero : Y - X ≠ 0
      intro zero
      have same : Y = X by linarith
      exact distinct with same
    have hBounds : (0:R) - E < Y - X ∧ Y - X < (0:R) + E
      constructor
      . linarith
      . linarith
    have hBall := openBall.order_characterization.backward at Y - X, (0:R), E
      with hBounds
    have quotientNegative := near with Y - X, hIn, hNonzero, hBall
    have value := differenceQuotient.value at hornerFunction(a, ds), X,
      Y - X with function
    have shift : X + (Y - X) = Y by ring
    rw [shift, root] at value
    have quotientReal := FunctionBetween.apply_closed with quotientFunction,
      hIn
    have valueReal := FunctionBetween.apply_closed with function, realY
    have typedValue : Real(hornerFunction(a, ds)(Y)) by exact valueReal
    have typedQuotient : Real(differenceQuotient(hornerFunction(a, ds),
      X)(Y - X)) by exact quotientReal
    have cancel := realDiv.mul_right at hornerFunction(a, ds)(Y),
      Y - X with hNonzero
    have shiftValue : hornerFunction(a, ds)(Y) - 0 =
      hornerFunction(a, ds)(Y) by ring
    rw shiftValue at value
    rw ← value at cancel
    constructor
    . intro below
      have hNegative : Y - X < 0 by linarith
      have product := realSign.product_of_negatives at
        differenceQuotient(hornerFunction(a, ds), X)(Y - X), Y - X with
        quotientNegative, hNegative
      rw cancel at product
      exact realSign.product_negative with product, negative
    . intro above
      have hPositive : 0 < Y - X by linarith
      have product := realSign.product_negative at Y - X,
        differenceQuotient(hornerFunction(a, ds), X)(Y - X) with
        hPositive, quotientNegative
      have commute : (Y - X) * differenceQuotient(hornerFunction(a, ds),
        X)(Y - X) = differenceQuotient(hornerFunction(a, ds), X)(Y - X) *
        (Y - X) by ring
      rw [commute, cancel] at product
      exact realSign.product_of_negatives with product, negative
  . exfalso
    exact simple with zero
  . obtain ⟨E, realE, positiveE, near⟩ := TendsToAt.eventually_positive with
      limit, positive
    witness E
    refine ⟨realE, positiveE, _⟩
    intros Y realY lower upper distinct
    have typedY : Real(Y) by exact realY
    have hReal := realSubValue.real at Y, X
    have hIn : Y - X ∈ ℝ by exact hReal
    have hNonzero : Y - X ≠ 0
      intro zero
      have same : Y = X by linarith
      exact distinct with same
    have hBounds : (0:R) - E < Y - X ∧ Y - X < (0:R) + E
      constructor
      . linarith
      . linarith
    have hBall := openBall.order_characterization.backward at Y - X, (0:R), E
      with hBounds
    have quotientPositive := near with Y - X, hIn, hNonzero, hBall
    have value := differenceQuotient.value at hornerFunction(a, ds), X,
      Y - X with function
    have shift : X + (Y - X) = Y by ring
    rw [shift, root] at value
    have quotientReal := FunctionBetween.apply_closed with quotientFunction,
      hIn
    have valueReal := FunctionBetween.apply_closed with function, realY
    have typedValue : Real(hornerFunction(a, ds)(Y)) by exact valueReal
    have typedQuotient : Real(differenceQuotient(hornerFunction(a, ds),
      X)(Y - X)) by exact quotientReal
    have cancel := realDiv.mul_right at hornerFunction(a, ds)(Y),
      Y - X with hNonzero
    have shiftValue : hornerFunction(a, ds)(Y) - 0 =
      hornerFunction(a, ds)(Y) by ring
    rw shiftValue at value
    rw ← value at cancel
    constructor
    . intro below
      have hNegative : Y - X < 0 by linarith
      have product := realSign.product_negative at
        differenceQuotient(hornerFunction(a, ds), X)(Y - X), Y - X with
        quotientPositive, hNegative
      rw cancel at product
      have commute : hornerFunction(a, ds)(Y) *
          hornerFunction(realDerivativeLeading(a, ds),
            realDerivativeList(ds))(X) =
          hornerFunction(realDerivativeLeading(a, ds),
            realDerivativeList(ds))(X) * hornerFunction(a, ds)(Y) by ring
      rw commute
      exact realSign.product_negative with positive, product
    . intro above
      have hPositive : 0 < Y - X by linarith
      have product := realMulValue.positive at
        differenceQuotient(hornerFunction(a, ds), X)(Y - X), Y - X with
        quotientPositive, hPositive
      rw cancel at product
      exact realMulValue.positive with product, positive

section Nonzero
hypothesis aNonzero : a ≠ (0:R)

-- A polynomial with a nonzero leading coefficient does not vanish on an
-- interval, since its roots are finitely many.
theorem hornerFunction.not_all_roots (X Z : Real)
  requires ordered : X < Z
  shows ¬(∀ W ∈ ℝ, X < W → W < Z → hornerFunction(a, ds)(W) = (0:R))
proof
  intro roots
  have rootsFinite := rootSet.real_finite at a, ds with aIn, dsList, aNonzero
  have rootsReal := rootSet.subset_reals at a, ds with aIn, dsList
  have subsetRoots := intersection.subset_left at rootSet(realRing, a, ds),
    openInterval(X, Z)
  have finite := Finite.subset with rootsFinite, subsetRoots
  have subsetReals := Subset.transitive with subsetRoots, rootsReal
  have gapPositive : 0 < Z - X by linarith
  have gapReal := realSubValue.real at Z, X
  have halfPositive := half.positive at Z - X with gapPositive
  have halfLess := half.lt_self at Z - X with gapPositive
  have halfReal := half.real at Z - X
  have mReal := realAddValue.real at X, half(Z - X)
  have mIn : X + half(Z - X) ∈ ℝ by exact mReal
  have xm : X < X + half(Z - X) by linarith
  have mz : X + half(Z - X) < Z by linarith
  have mRoot := roots with X + half(Z - X), mIn, xm, mz
  have mIff := hornerFunction.root_iff at a, ds, X + half(Z - X) with aIn,
    dsList, mIn
  have mInRoots := mIff.backward with mRoot
  have mOpen : X + half(Z - X) ∈ openInterval(X, Z)
    apply openInterval.membership.backward
    exact ⟨mIn, xm, mz⟩
  have mMember : X + half(Z - X) ∈ rootSet(realRing, a, ds) ∩ openInterval(X, Z)
    apply intersection.membership.backward
    exact ⟨mInRoots, mOpen⟩
  have inhabited : Nonempty(rootSet(realRing, a, ds) ∩ openInterval(X, Z)) :=
    ⟨X + half(Z - X), mMember⟩
  obtain ⟨g, gMember, gGreatest⟩ := Finite.exists_greatest_real with
    inhabited, subsetReals, finite
  obtain ⟨gRoot, gOpen⟩ := intersection.membership.forward with gMember
  obtain ⟨realG, xg, gz⟩ := openInterval.membership.forward with gOpen
  have typedG : Real(g) by exact realG
  have gapG : 0 < Z - g by linarith
  have gapGReal := realSubValue.real at Z, g
  have halfG := half.positive at Z - g with gapG
  have halfGLess := half.lt_self at Z - g with gapG
  have halfGReal := half.real at Z - g
  have nReal := realAddValue.real at g, half(Z - g)
  have nIn : g + half(Z - g) ∈ ℝ by exact nReal
  have gn : g < g + half(Z - g) by linarith
  have xn : X < g + half(Z - g) by linarith
  have nz : g + half(Z - g) < Z by linarith
  have nRoot := roots with g + half(Z - g), nIn, xn, nz
  have nIff := hornerFunction.root_iff at a, ds, g + half(Z - g) with aIn,
    dsList, nIn
  have nInRoots := nIff.backward with nRoot
  have nOpen : g + half(Z - g) ∈ openInterval(X, Z)
    apply openInterval.membership.backward
    exact ⟨nIn, xn, nz⟩
  have nMember : g + half(Z - g) ∈ rootSet(realRing, a, ds) ∩ openInterval(X, Z)
    apply intersection.membership.backward
    exact ⟨nInRoots, nOpen⟩
  have le := gGreatest with g + half(Z - g), nMember
  linarith

-- Two roots cannot be joined by an interval on which the derivative keeps
-- a nonzero sign: the sign of p just after the last root below the second
-- and just before the second disagree, yet p has no root between.
theorem hornerFunction.no_two_roots (R1 R2 : Real)
  requires ordered : R1 < R2
  requires rootLeft : hornerFunction(a, ds)(R1) = (0:R)
  requires rootRight : hornerFunction(a, ds)(R2) = (0:R)
  requires slopeNonzero : hornerFunction(realDerivativeLeading(a, ds),
    realDerivativeList(ds))(R1) ≠ (0:R)
  shows ¬(∀ W ∈ ℝ, R1 ≤ W → W ≤ R2 →
    realSign(hornerFunction(realDerivativeLeading(a, ds),
      realDerivativeList(ds))(W)) =
    realSign(hornerFunction(realDerivativeLeading(a, ds),
      realDerivativeList(ds))(R1)))
proof
  intro slopes
  have realR1 : R1 ∈ ℝ by simp [Real]
  have realR2 : R2 ∈ ℝ by simp [Real]
  have rootsFinite := rootSet.real_finite at a, ds with aIn, dsList, aNonzero
  have rootsReal := rootSet.subset_reals at a, ds with aIn, dsList
  have subsetRoots := intersection.subset_left at rootSet(realRing, a, ds),
    closedInterval(R1, R2)
  have finiteClosed := Finite.subset with rootsFinite, subsetRoots
  have finite := Finite.difference at
    rootSet(realRing, a, ds) ∩ closedInterval(R1, R2), {R2} with finiteClosed
  have subsetRest := difference.subset_left at
    rootSet(realRing, a, ds) ∩ closedInterval(R1, R2), {R2}
  have subsetRealsClosed := Subset.transitive with subsetRoots, rootsReal
  have subsetReals := Subset.transitive with subsetRest, subsetRealsClosed
  have orderedLe : R1 ≤ R2 by linarith
  have r1Iff := hornerFunction.root_iff at a, ds, R1 with aIn, dsList, realR1
  have r1InRoots := r1Iff.backward with rootLeft
  have r1Closed := closedInterval.left_mem at R1, R2 with orderedLe
  have r1Member : R1 ∈ (rootSet(realRing, a, ds) ∩ closedInterval(R1, R2)) ∖
      {R2}
    apply difference.membership.backward
    constructor
    . apply intersection.membership.backward
      exact ⟨r1InRoots, r1Closed⟩
    . intro inSingleton
      have singleton := FiniteSet.singleton.membership at R1, R2
      have same := singleton.forward with inSingleton
      rw same at ordered
      linarith
  have inhabited : Nonempty((rootSet(realRing, a, ds) ∩
    closedInterval(R1, R2)) ∖ {R2}) := ⟨R1, r1Member⟩
  obtain ⟨g, gMember, gGreatest⟩ := Finite.exists_greatest_real with
    inhabited, subsetReals, finite
  obtain ⟨gIn, gNotR2⟩ := difference.membership.forward with gMember
  obtain ⟨gRoot, gClosed⟩ := intersection.membership.forward with gIn
  obtain ⟨realG, r1g, gr2⟩ := closedInterval.membership.forward with gClosed
  have typedG : Real(g) by exact realG
  have gIff := hornerFunction.root_iff at a, ds, g with aIn, dsList, realG
  have gZero := gIff.forward with gRoot
  have singletonG := FiniteSet.singleton.membership at g, R2
  have gLess : g < R2
    have split := realLess.trichotomy at g, R2
    rcases split with less | same | more
    . exact less
    . exfalso
      exact gNotR2 with (singletonG.backward with same)
    . exfalso
      linarith
  -- No root lies in (g, R2).
  have noRoots : ∀ W ∈ openInterval(g, R2), hornerFunction(a, ds)(W) ≠ (0:R)
    intros W wOpen wZero
    obtain ⟨realW, gw, wr2⟩ := openInterval.membership.forward with wOpen
    have typedW : Real(W) by exact realW
    have wIff := hornerFunction.root_iff at a, ds, W with aIn, dsList, realW
    have wInRoots := wIff.backward with wZero
    have wClosed : W ∈ closedInterval(R1, R2)
      apply closedInterval.membership.backward
      have r1w : R1 ≤ W by linarith
      have wr2Le : W ≤ R2 by linarith
      exact ⟨realW, r1w, wr2Le⟩
    have wMember : W ∈ (rootSet(realRing, a, ds) ∩ closedInterval(R1, R2)) ∖
        {R2}
      apply difference.membership.backward
      constructor
      . apply intersection.membership.backward
        exact ⟨wInRoots, wClosed⟩
      . intro inSingleton
        have singleton := FiniteSet.singleton.membership at W, R2
        have same := singleton.forward with inSingleton
        rw same at wr2
        linarith
    have le := gGreatest with W, wMember
    linarith
  -- The derivative at g and at R2 has the sign of the derivative at R1.
  have slopeG := slopes with g, realG, r1g, gr2
  have r2Le : R2 ≤ R2 by linarith
  have slopeR2 := slopes with R2, realR2, orderedLe, r2Le
  have slopeGNonzero := realSign.nonzero_of_sign_eq at
    hornerFunction(realDerivativeLeading(a, ds), realDerivativeList(ds))(R1),
    hornerFunction(realDerivativeLeading(a, ds), realDerivativeList(ds))(g)
    with slopeNonzero, slopeG
  have slopeR2Nonzero := realSign.nonzero_of_sign_eq at
    hornerFunction(realDerivativeLeading(a, ds), realDerivativeList(ds))(R1),
    hornerFunction(realDerivativeLeading(a, ds), realDerivativeList(ds))(R2)
    with slopeNonzero, slopeR2
  obtain ⟨E1, realE1, positiveE1, nearG⟩ :=
    hornerFunction.sign_near_simple_root at a, ds, g with aIn, dsList, gZero,
    slopeGNonzero
  obtain ⟨E2, realE2, positiveE2, nearR2⟩ :=
    hornerFunction.sign_near_simple_root at a, ds, R2 with aIn, dsList,
    rootRight, slopeR2Nonzero
  have typedE1 : Real(E1) by exact realE1
  have typedE2 : Real(E2) by exact realE2
  obtain ⟨W1, realW1, gw1, w1r2, w1Near⟩ := thom.right_point at g, R2, E1 with
    gLess, positiveE1
  obtain ⟨W2, realW2, gw2, w2Near, w2r2⟩ := thom.left_point at g, R2, E2 with
    gLess, positiveE2
  have typedW1 : Real(W1) by exact realW1
  have typedW2 : Real(W2) by exact realW2
  have w1Lower : g - E1 < W1 by linarith
  have w1Distinct : W1 ≠ g
    intro same
    rw same at gw1
    linarith
  have w1Signs := nearG with W1, realW1, w1Lower, w1Near, w1Distinct
  have w1Product := w1Signs.right with gw1
  have w2Upper : W2 < R2 + E2 by linarith
  have w2Distinct : W2 ≠ R2
    intro same
    rw same at w2r2
    linarith
  have w2Signs := nearR2 with W2, realW2, w2Near, w2Upper, w2Distinct
  have w2Product := w2Signs.left with w2r2
  have w1Value : Real(hornerFunction(a, ds)(W1)) by typecheck
  have w2Value : Real(hornerFunction(a, ds)(W2)) by typecheck
  have gSlope : Real(hornerFunction(realDerivativeLeading(a, ds),
    realDerivativeList(ds))(g)) by typecheck
  have r2Slope : Real(hornerFunction(realDerivativeLeading(a, ds),
    realDerivativeList(ds))(R2)) by typecheck
  have signW1 := realSign.eq_of_product_positive at hornerFunction(a, ds)(W1),
    hornerFunction(realDerivativeLeading(a, ds), realDerivativeList(ds))(g)
    with w1Product
  have signW2 := realSign.ne_of_product_negative at hornerFunction(a, ds)(W2),
    hornerFunction(realDerivativeLeading(a, ds), realDerivativeList(ds))(R2)
    with w2Product
  rw slopeG at signW1
  rw slopeR2 at signW2
  -- p keeps its sign on (g, R2), so the two signs agree.
  have continuous := hornerFunction.continuous at a, ds with aIn, dsList
  have w1Open : W1 ∈ openInterval(g, R2)
    apply openInterval.membership.backward
    exact ⟨realW1, gw1, w1r2⟩
  have w2Open : W2 ∈ openInterval(g, R2)
    apply openInterval.membership.backward
    exact ⟨realW2, gw2, w2r2⟩
  have same := Continuous.sign_eq_on_open_interval at hornerFunction(a, ds), g,
    R2, W1, W2 with continuous, noRoots, w1Open, w2Open
  rw [signW1, signW2] at same
  have signReal := realSign.real at hornerFunction(realDerivativeLeading(a, ds),
    realDerivativeList(ds))(R1)
  have signZero : realSign(hornerFunction(realDerivativeLeading(a, ds),
    realDerivativeList(ds))(R1)) = (0:R) by linarith
  have characterization := realSign.eq_zero_iff at
    hornerFunction(realDerivativeLeading(a, ds), realDerivativeList(ds))(R1)
  exact slopeNonzero with (characterization.forward with signZero)

-- Between two points where p is nonzero with the same sign, on an interval
-- where p′ keeps a nonzero sign, p keeps that sign.
theorem hornerFunction.sign_between (X Y Z : Real)
  requires xy : X < Y
  requires yz : Y < Z
  requires nonrootX : hornerFunction(a, ds)(X) ≠ (0:R)
  requires sameEnds : realSign(hornerFunction(a, ds)(X)) =
    realSign(hornerFunction(a, ds)(Z))
  requires slopeNonzero : hornerFunction(realDerivativeLeading(a, ds),
    realDerivativeList(ds))(X) ≠ (0:R)
  requires slopes : ∀ W ∈ ℝ, X ≤ W → W ≤ Z →
    realSign(hornerFunction(realDerivativeLeading(a, ds),
      realDerivativeList(ds))(W)) =
    realSign(hornerFunction(realDerivativeLeading(a, ds),
      realDerivativeList(ds))(X))
  shows realSign(hornerFunction(a, ds)(Y)) = realSign(hornerFunction(a, ds)(X))
proof
  have realX : X ∈ ℝ by simp [Real]
  have realY : Y ∈ ℝ by simp [Real]
  have realZ : Z ∈ ℝ by simp [Real]
  have function := hornerFunction.function at a, ds with aIn, dsList
  have xValue : Real(hornerFunction(a, ds)(X)) by typecheck
  have zValue : Real(hornerFunction(a, ds)(Z)) by typecheck
  have xSlope : Real(hornerFunction(realDerivativeLeading(a, ds),
    realDerivativeList(ds))(X)) by typecheck
  have signSlope := realSign.real at hornerFunction(realDerivativeLeading(a,
    ds), realDerivativeList(ds))(X)
  have xLe : X ≤ X by linarith
  have zLe : Z ≤ Z by linarith
  have xz : X < Z by linarith
  have xzLe : X ≤ Z by linarith
  have slopeZ := slopes with Z, realZ, xzLe, zLe
  have endsSymm := sameEnds
  symm at endsSymm
  have nonrootZ := realSign.nonzero_of_sign_eq at hornerFunction(a, ds)(X),
    hornerFunction(a, ds)(Z) with nonrootX, endsSymm
  -- No root lies in (X, Z).
  have noRoot : ∀ C ∈ ℝ, X < C → C < Z → hornerFunction(a, ds)(C) ≠ (0:R)
    intros C realC xc cz rootC
    have typedC : Real(C) by exact realC
    have xcLe : X ≤ C by linarith
    have czLe : C ≤ Z by linarith
    have slopeC := slopes with C, realC, xcLe, czLe
    have slopeCNonzero := realSign.nonzero_of_sign_eq at
      hornerFunction(realDerivativeLeading(a, ds), realDerivativeList(ds))(X),
      hornerFunction(realDerivativeLeading(a, ds), realDerivativeList(ds))(C)
      with slopeNonzero, slopeC
    have cSlope : Real(hornerFunction(realDerivativeLeading(a, ds),
      realDerivativeList(ds))(C)) by typecheck
    obtain ⟨E, realE, positiveE, near⟩ :=
      hornerFunction.sign_near_simple_root at a, ds, C with aIn, dsList, rootC,
      slopeCNonzero
    have typedE : Real(E) by exact realE
    -- The slopes on a subinterval of [X, Z] agree with the slope at its
    -- left end.
    have subSlopes : ∀ A ∈ ℝ, X ≤ A → A ≤ Z → ∀ W ∈ ℝ, A ≤ W → W ≤ Z →
        realSign(hornerFunction(realDerivativeLeading(a, ds),
          realDerivativeList(ds))(W)) =
        realSign(hornerFunction(realDerivativeLeading(a, ds),
          realDerivativeList(ds))(A))
      intros A realA xa az W realW aw wz
      have xw : X ≤ W by linarith
      have slopeW := slopes with W, realW, xw, wz
      have slopeA := slopes with A, realA, xa, az
      rw [slopeW, slopeA]
    have split := realSign.eq_or_neg at hornerFunction(a, ds)(X),
      hornerFunction(realDerivativeLeading(a, ds), realDerivativeList(ds))(X)
      with nonrootX, slopeNonzero
    cases split with sameSign | oppositeSign
    . -- Just left of C the sign of p is opposite to the sign at X.
      obtain ⟨W1, realW1, xw1, w1Near, w1c⟩ := thom.left_point at X, C, E with
        xc, positiveE
      have typedW1 : Real(W1) by exact realW1
      have w1Upper : W1 < C + E by linarith
      have w1Distinct : W1 ≠ C
        intro same
        rw same at w1c
        linarith
      have w1Signs := near with W1, realW1, w1Near, w1Upper, w1Distinct
      have w1Product := w1Signs.left with w1c
      have w1Value : Real(hornerFunction(a, ds)(W1)) by typecheck
      have signW1 := realSign.ne_of_product_negative at
        hornerFunction(a, ds)(W1), hornerFunction(realDerivativeLeading(a, ds),
          realDerivativeList(ds))(C) with w1Product
      rw slopeC at signW1
      have w1Nonzero : hornerFunction(a, ds)(W1) ≠ (0:R)
        intro zero
        rw zero at w1Product
        have vanish : (0:R) * hornerFunction(realDerivativeLeading(a, ds),
          realDerivativeList(ds))(C) = (0:R) by ring
        rw vanish at w1Product
        linarith
      have distinct : realSign(hornerFunction(a, ds)(X)) ≠
          realSign(hornerFunction(a, ds)(W1))
        rw [sameSign, signW1]
        intro same
        have zero : realSign(hornerFunction(realDerivativeLeading(a, ds),
          realDerivativeList(ds))(X)) = (0:R) by linarith
        have characterization := realSign.eq_zero_iff at
          hornerFunction(realDerivativeLeading(a, ds),
            realDerivativeList(ds))(X)
        exact slopeNonzero with (characterization.forward with zero)
      have opposite := realSign.product_negative_of_ne at
        hornerFunction(a, ds)(X), hornerFunction(a, ds)(W1) with nonrootX,
        w1Nonzero, distinct
      have xw1Le : X ≤ W1 by linarith
      have subset := closedInterval.subset_reals at X, W1
      have continuousOn := hornerFunction.continuous_on at a, ds,
        closedInterval(X, W1) with aIn, dsList, subset
      obtain ⟨C1, c1In, rootC1⟩ := closedInterval.zero_of_opposite_signs at
        hornerFunction(a, ds), X, W1 with function, xw1Le, continuousOn,
        opposite
      obtain ⟨realC1, xc1, c1w1⟩ := closedInterval.membership.forward with c1In
      have typedC1 : Real(C1) by exact realC1
      have c1c : C1 < C by linarith
      have c1z : C1 ≤ Z by linarith
      have slopeC1 := slopes with C1, realC1, xc1, c1z
      have slopeC1Nonzero := realSign.nonzero_of_sign_eq at
        hornerFunction(realDerivativeLeading(a, ds), realDerivativeList(ds))(X),
        hornerFunction(realDerivativeLeading(a, ds), realDerivativeList(ds))(C1)
        with slopeNonzero, slopeC1
      have slopesC1 := subSlopes with C1, realC1, xc1, c1z
      have slopesC1C : ∀ W ∈ ℝ, C1 ≤ W → W ≤ C →
          realSign(hornerFunction(realDerivativeLeading(a, ds),
            realDerivativeList(ds))(W)) =
          realSign(hornerFunction(realDerivativeLeading(a, ds),
            realDerivativeList(ds))(C1))
        intros W realW c1w wc
        have wz : W ≤ Z by linarith
        exact slopesC1 with W, realW, c1w, wz
      exact hornerFunction.no_two_roots at a, ds, C1, C with aIn, dsList,
        aNonzero, c1c, rootC1, rootC, slopeC1Nonzero, slopesC1C
    . -- Just right of C the sign of p is opposite to the sign at Z.
      obtain ⟨W2, realW2, cw2, w2z, w2Near⟩ := thom.right_point at C, Z, E with
        cz, positiveE
      have typedW2 : Real(W2) by exact realW2
      have w2Lower : C - E < W2 by linarith
      have w2Distinct : W2 ≠ C
        intro same
        rw same at cw2
        linarith
      have w2Signs := near with W2, realW2, w2Lower, w2Near, w2Distinct
      have w2Product := w2Signs.right with cw2
      have w2Value : Real(hornerFunction(a, ds)(W2)) by typecheck
      have signW2 := realSign.eq_of_product_positive at
        hornerFunction(a, ds)(W2), hornerFunction(realDerivativeLeading(a, ds),
          realDerivativeList(ds))(C) with w2Product
      rw slopeC at signW2
      have w2Nonzero : hornerFunction(a, ds)(W2) ≠ (0:R)
        intro zero
        rw zero at w2Product
        have vanish : (0:R) * hornerFunction(realDerivativeLeading(a, ds),
          realDerivativeList(ds))(C) = (0:R) by ring
        rw vanish at w2Product
        linarith
      have distinct : realSign(hornerFunction(a, ds)(W2)) ≠
          realSign(hornerFunction(a, ds)(Z))
        rw [signW2, ← sameEnds, oppositeSign]
        intro same
        have zero : realSign(hornerFunction(realDerivativeLeading(a, ds),
          realDerivativeList(ds))(X)) = (0:R) by linarith
        have characterization := realSign.eq_zero_iff at
          hornerFunction(realDerivativeLeading(a, ds),
            realDerivativeList(ds))(X)
        exact slopeNonzero with (characterization.forward with zero)
      have opposite := realSign.product_negative_of_ne at
        hornerFunction(a, ds)(W2), hornerFunction(a, ds)(Z) with w2Nonzero,
        nonrootZ, distinct
      have w2zLe : W2 ≤ Z by linarith
      have subset := closedInterval.subset_reals at W2, Z
      have continuousOn := hornerFunction.continuous_on at a, ds,
        closedInterval(W2, Z) with aIn, dsList, subset
      obtain ⟨C2, c2In, rootC2⟩ := closedInterval.zero_of_opposite_signs at
        hornerFunction(a, ds), W2, Z with function, w2zLe, continuousOn,
        opposite
      obtain ⟨realC2, w2c2, c2z⟩ := closedInterval.membership.forward with c2In
      have typedC2 : Real(C2) by exact realC2
      have cc2 : C < C2 by linarith
      have slopesCC2 : ∀ W ∈ ℝ, C ≤ W → W ≤ C2 →
          realSign(hornerFunction(realDerivativeLeading(a, ds),
            realDerivativeList(ds))(W)) =
          realSign(hornerFunction(realDerivativeLeading(a, ds),
            realDerivativeList(ds))(C))
        intros W realW cw wc2
        have wz : W ≤ Z by linarith
        have slopesC := subSlopes with C, realC, xcLe, czLe
        exact slopesC with W, realW, cw, wz
      exact hornerFunction.no_two_roots at a, ds, C, C2 with aIn, dsList,
        aNonzero, cc2, rootC, rootC2, slopeCNonzero, slopesCC2
  -- So p(Y) is nonzero, and a sign different from that at X would force a
  -- root in (X, Y).
  have yNonroot := noRoot with Y, realY, xy, yz
  have yValue : Real(hornerFunction(a, ds)(Y)) by typecheck
  by_contra distinct
  have distinctX : realSign(hornerFunction(a, ds)(X)) ≠
      realSign(hornerFunction(a, ds)(Y))
    intro same
    apply distinct
    symm at same
    exact same
  have opposite := realSign.product_negative_of_ne at hornerFunction(a, ds)(X),
    hornerFunction(a, ds)(Y) with nonrootX, yNonroot, distinctX
  have xyLe : X ≤ Y by linarith
  have subset := closedInterval.subset_reals at X, Y
  have continuousOn := hornerFunction.continuous_on at a, ds,
    closedInterval(X, Y) with aIn, dsList, subset
  obtain ⟨C, cIn, rootC⟩ := closedInterval.zero_of_opposite_signs at
    hornerFunction(a, ds), X, Y with function, xyLe, continuousOn, opposite
  obtain ⟨realC, xc, cy⟩ := closedInterval.membership.forward with cIn
  have typedC : Real(C) by exact realC
  have xcStrict : X < C
    have split := realLess.trichotomy at X, C
    rcases split with less | same | more
    . exact less
    . exfalso
      rw ← same at rootC
      exact nonrootX with rootC
    . exfalso
      linarith
  have cyStrict : C < Y
    have split := realLess.trichotomy at C, Y
    rcases split with less | same | more
    . exact less
    . exfalso
      rw same at rootC
      exact yNonroot with rootC
    . exfalso
      linarith
  have cz : C < Z by linarith
  exact noRoot with C, realC, xcStrict, cz, rootC

end Nonzero
end Derivatives

section Polynomials
variable (leading cs : Set)
hypothesis initial : Real(leading)
hypothesis coefficients : List(ℝ, cs)

-- The sign of the k-th derivative of the pair at X.
defgraph derivativeSigns (X : Real) (k ∈ ℕ) : ℝ :=
  realSign(hornerFunction(fst(realDerivativePair(leading, cs, k)),
    snd(realDerivativePair(leading, cs, k)))(X))
proof
  have pairReal := realDerivativePair.real at leading, cs, k with initial,
    coefficients
  have pairList := realDerivativePair.list at leading, cs, k with initial,
    coefficients
  have realX : X ∈ ℝ by simp [Real]
  have valueReal : Real(hornerFunction(fst(realDerivativePair(leading, cs, k)),
    snd(realDerivativePair(leading, cs, k)))(X)) by typecheck
  exact realSign.real at hornerFunction(fst(realDerivativePair(leading, cs, k)),
    snd(realDerivativePair(leading, cs, k)))(X)

-- X and Y satisfy the same sign condition on p, p′, …, p^(length cs).
predicate SameDerivativeSigns (X Y : Real) :=
  ∀ k, Nat(k) → k ≤ length{ℝ}(cs) →
    derivativeSigns(X)(k) = derivativeSigns(Y)(k)

theorem derivativeSigns.zero_all (X : Real)
  shows derivativeSigns(X)(0) = realSign(hornerFunction(leading, cs)(X))
proof
  have value := derivativeSigns.value at leading, cs, X, 0 with initial,
    coefficients
  rw [value, (realDerivativePair.zero at leading, cs), fst.pair, snd.pair]

theorem derivativeSigns.succ_all (k : Nat) (X : Real)
  shows derivativeSigns(X)(k + 1) =
    derivativeSigns(realDerivativeLeading(leading, cs), realDerivativeList(cs),
      X)(k)
proof
  have dReal : Real(realDerivativeLeading(leading, cs)) by typecheck
  have dList := realDerivativeList.list at leading, cs with initial,
    coefficients
  have left := derivativeSigns.value at leading, cs, X, k + 1 with initial,
    coefficients
  have right := derivativeSigns.value at realDerivativeLeading(leading, cs),
    realDerivativeList(cs), X, k with dReal, dList
  rw [left, right, (realDerivativePair.shift at leading, cs, k)]

-- The sign condition passes to the derivative pair of a nonconstant pair.
theorem SameDerivativeSigns.derivative (X Y : Real) (m : Nat)
  requires size : length{ℝ}(cs) = succ(m)
  requires same : SameDerivativeSigns(X, Y)
  shows SameDerivativeSigns(realDerivativeLeading(leading, cs),
    realDerivativeList(cs), X, Y)
proof
  have dLength := realDerivativeList.length at leading, cs with initial,
    coefficients
  rw [size, predecessor.succ] at dLength
  unfold SameDerivativeSigns
  intros k kNat bound
  rw dLength at bound
  have nextNat : Nat(k + 1) by typecheck
  have boundNext : k + 1 ≤ length{ℝ}(cs)
    rw size
    arith
  unfold SameDerivativeSigns at same
  have signs := same with k + 1, nextNat, boundNext
  rw [(derivativeSigns.succ_all at leading, cs, k, X with initial,
    coefficients), (derivativeSigns.succ_all at leading, cs, k, Y with initial,
    coefficients)] at signs
  exact signs

-- Conversely, the sign of p together with the condition on the derivative
-- pair gives the condition on the pair.
theorem SameDerivativeSigns.of_derivative (X Y : Real)
  requires first : realSign(hornerFunction(leading, cs)(X)) =
    realSign(hornerFunction(leading, cs)(Y))
  requires rest : SameDerivativeSigns(realDerivativeLeading(leading, cs),
    realDerivativeList(cs), X, Y)
  shows SameDerivativeSigns(X, Y)
proof
  have dLength := realDerivativeList.length at leading, cs with initial,
    coefficients
  unfold SameDerivativeSigns
  intros k kNat bound
  have shape := natural.zero_or_successor at k with kNat
  cases shape with zero | successor
  . rw [zero, (derivativeSigns.zero_all at leading, cs, X with initial,
      coefficients), (derivativeSigns.zero_all at leading, cs, Y with initial,
      coefficients)]
    exact first
  . obtain ⟨j, jNat, kEq⟩ := successor
    have one : succ(j) = j + 1 by ring
    rw [kEq, one]
    rw [(derivativeSigns.succ_all at leading, cs, j, X with initial,
      coefficients), (derivativeSigns.succ_all at leading, cs, j, Y with
      initial, coefficients)]
    rw [kEq, one] at bound
    obtain ⟨i, iNat, lengthEq⟩ := LessEqual.exists_add with bound
    have shift : j + 1 + i = succ(j + i) by ring
    rw shift at lengthEq
    have jBound : j ≤ length{ℝ}(realDerivativeList(cs))
      rw [dLength, lengthEq, predecessor.succ]
      arith
    unfold SameDerivativeSigns at rest
    exact rest with j, jNat, jBound

section Nonzero
hypothesis nonzero : leading ≠ (0:R)

theorem derivativeSigns.zero (X : Real)
  shows derivativeSigns(X)(0) = realSign(hornerFunction(leading, cs)(X))
proof
  exact derivativeSigns.zero_all at leading, cs, X with initial, coefficients

theorem derivativeSigns.succ (k : Nat) (X : Real)
  shows derivativeSigns(X)(k + 1) =
    derivativeSigns(realDerivativeLeading(leading, cs), realDerivativeList(cs),
      X)(k)
proof
  exact derivativeSigns.succ_all at leading, cs, k, X with initial,
    coefficients

-- The top derivative is the nonzero constant (length cs)!·leading.
theorem derivativeSigns.top (X : Real)
  shows derivativeSigns(X)(length{ℝ}(cs)) ≠ (0:R)
proof
  have realX : X ∈ ℝ by simp [Real]
  have lengthNat : Nat(length{ℝ}(cs)) by typecheck
  have value := derivativeSigns.value at leading, cs, X, length{ℝ}(cs) with
    initial, coefficients
  have same : length{ℝ}(cs) = length{ℝ}(cs) by rfl
  have top := realDerivativePair.top at length{ℝ}(cs) with lengthNat, leading,
    initial, cs, coefficients, nonzero, same
  rcases top with ⟨topNonzero, topNil⟩
  have topReal := realDerivativePair.real at leading, cs, length{ℝ}(cs) with
    initial, coefficients
  have nilList : List(ℝ, []) by typecheck
  have constant := hornerFunction.nil at
    fst(realDerivativePair(leading, cs, length{ℝ}(cs))), [], X with topReal,
    nilList, realX
  rw [value, topNil, constant]
  intro zero
  have characterization := realSign.eq_zero_iff at
    fst(realDerivativePair(leading, cs, length{ℝ}(cs)))
  exact topNonzero with (characterization.forward with zero)

-- Convexity by induction on the degree: the derivative keeps a nonzero
-- sign on [X, Z] by the induction hypothesis and finiteness of its roots,
-- so the sign of p is constant between X and Z, and the signs of the
-- higher derivatives come from the induction hypothesis.
theorem thom.convex_induction (n : Nat)
  shows ∀ a, Real(a) → ∀ ds, List(ℝ, ds) → a ≠ (0:R) → length{ℝ}(ds) = n →
    ∀ X ∈ ℝ, ∀ Y ∈ ℝ, ∀ Z ∈ ℝ, X < Y → Y < Z →
      SameDerivativeSigns(a, ds, X, Z) → SameDerivativeSigns(a, ds, X, Y)
proof
  induction n
  | zero =>
    intros a aReal ds dsList aNonzero size X realX Y realY Z realZ xy yz same
    have typedX : Real(X) by exact realX
    have typedY : Real(Y) by exact realY
    have nil := length.eq_zero with dsList, size
    have nilList : List(ℝ, []) by typecheck
    rw nil
    unfold SameDerivativeSigns
    intros k kNat bound
    rw length.nil at bound
    have atLeast : 0 ≤ k by arith
    have kZero := LessEqual.antisymmetric with bound, atLeast
    rw kZero
    rw [(derivativeSigns.zero_all at a, [], X with aReal, nilList),
      (derivativeSigns.zero_all at a, [], Y with aReal, nilList)]
    rw [(hornerFunction.nil at a, [], X with aReal, nilList, realX),
      (hornerFunction.nil at a, [], Y with aReal, nilList, realY)]
  | succ(m) using ih =>
    intros a aReal ds dsList aNonzero size X realX Y realY Z realZ xy yz same
    have typedX : Real(X) by exact realX
    have typedY : Real(Y) by exact realY
    have typedZ : Real(Z) by exact realZ
    have aIn : a ∈ ℝ by exact aReal
    have xz : X < Z by linarith
    have nonempty : ds ≠ []
      intro empty
      rw [empty, length.nil] at size
      symm at size
      exact succ.ne_zero with size
    have dNonzero := realDerivativeLeading.nonzero at a, ds with aIn, aNonzero,
      nonempty
    have dReal : Real(realDerivativeLeading(a, ds)) by typecheck
    have dIn : realDerivativeLeading(a, ds) ∈ ℝ by exact dReal
    have dList := realDerivativeList.list at a, ds with aReal, dsList
    have dLength := realDerivativeList.length at a, ds with aReal, dsList
    rw [size, predecessor.succ] at dLength
    have sameD := SameDerivativeSigns.derivative at a, ds, X, Z, m with aReal,
      dsList, size, same
    have convexD := ih with realDerivativeLeading(a, ds), dReal,
      realDerivativeList(ds), dList, dNonzero, dLength
    have zeroNat : Nat(0) by typecheck
    have oneNat : Nat(1) by typecheck
    -- The derivative keeps its sign on (X, Z), and at Z.
    have signsD : ∀ W ∈ ℝ, X < W → W < Z →
        realSign(hornerFunction(realDerivativeLeading(a, ds),
          realDerivativeList(ds))(W)) =
        realSign(hornerFunction(realDerivativeLeading(a, ds),
          realDerivativeList(ds))(X))
      intros W realW xw wz
      have sameW := convexD with X, realX, W, realW, Z, realZ, xw, wz, sameD
      unfold SameDerivativeSigns at sameW
      have zeroLe : 0 ≤ length{ℝ}(realDerivativeList(ds)) by arith
      have signs := sameW with 0, zeroNat, zeroLe
      rw [(derivativeSigns.zero_all at realDerivativeLeading(a, ds),
        realDerivativeList(ds), X with dReal, dList),
        (derivativeSigns.zero_all at realDerivativeLeading(a, ds),
        realDerivativeList(ds), W with dReal, dList)] at signs
      symm at signs
      exact signs
    have slopeZ : realSign(hornerFunction(realDerivativeLeading(a, ds),
        realDerivativeList(ds))(Z)) =
        realSign(hornerFunction(realDerivativeLeading(a, ds),
          realDerivativeList(ds))(X))
      have sameCopy := same
      unfold SameDerivativeSigns at sameCopy
      have oneLe : 1 ≤ length{ℝ}(ds)
        rw size
        arith
      have signs := sameCopy with 1, oneNat, oneLe
      have zeroOne : 0 + 1 = 1 by ring
      rw ← zeroOne at signs
      rw [(derivativeSigns.succ_all at a, ds, 0, X with aReal, dsList),
        (derivativeSigns.succ_all at a, ds, 0, Z with aReal, dsList)] at signs
      rw [(derivativeSigns.zero_all at realDerivativeLeading(a, ds),
        realDerivativeList(ds), X with dReal, dList),
        (derivativeSigns.zero_all at realDerivativeLeading(a, ds),
        realDerivativeList(ds), Z with dReal, dList)] at signs
      symm at signs
      exact signs
    have slopes : ∀ W ∈ ℝ, X ≤ W → W ≤ Z →
        realSign(hornerFunction(realDerivativeLeading(a, ds),
          realDerivativeList(ds))(W)) =
        realSign(hornerFunction(realDerivativeLeading(a, ds),
          realDerivativeList(ds))(X))
      intros W realW xw wz
      have typedW : Real(W) by exact realW
      have splitLeft := realLess.trichotomy at X, W
      rcases splitLeft with less | sameX | more
      . have splitRight := realLess.trichotomy at W, Z
        rcases splitRight with lessZ | sameZ | moreZ
        . exact signsD with W, realW, less, lessZ
        . rw sameZ
          exact slopeZ
        . exfalso
          linarith
      . rw ← sameX
      . exfalso
        linarith
    -- The sign of p at Y.
    have signY : realSign(hornerFunction(a, ds)(Y)) =
        realSign(hornerFunction(a, ds)(X))
      unfold SameDerivativeSigns at same
      have zeroLe : 0 ≤ length{ℝ}(ds) by arith
      have s0 := same with 0, zeroNat, zeroLe
      rw [(derivativeSigns.zero_all at a, ds, X with aReal, dsList),
        (derivativeSigns.zero_all at a, ds, Z with aReal, dsList)] at s0
      have xSlope : Real(hornerFunction(realDerivativeLeading(a, ds),
        realDerivativeList(ds))(X)) by typecheck
      have xValue : Real(hornerFunction(a, ds)(X)) by typecheck
      have zValue : Real(hornerFunction(a, ds)(Z)) by typecheck
      by_cases slopeZero : hornerFunction(realDerivativeLeading(a, ds),
          realDerivativeList(ds))(X) = (0:R)
      . -- The derivative would vanish on (X, Z), against the finiteness of
        -- its roots.
        exfalso
        have signZero := realSign.of_zero with slopeZero
        have roots : ∀ W ∈ ℝ, X < W → W < Z →
            hornerFunction(realDerivativeLeading(a, ds),
              realDerivativeList(ds))(W) = (0:R)
          intros W realW xw wz
          have typedW : Real(W) by exact realW
          have signW := signsD with W, realW, xw, wz
          rw signZero at signW
          have characterization := realSign.eq_zero_iff at
            hornerFunction(realDerivativeLeading(a, ds),
              realDerivativeList(ds))(W)
          exact characterization.forward with signW
        exact hornerFunction.not_all_roots at realDerivativeLeading(a, ds),
          realDerivativeList(ds), X, Z with dIn, dList, dNonzero, xz, roots
      . by_cases rootX : hornerFunction(a, ds)(X) = (0:R)
        . -- X and Z would be two roots across which p′ keeps its sign.
          exfalso
          have signZero := realSign.of_zero with rootX
          rw signZero at s0
          symm at s0
          have characterization := realSign.eq_zero_iff at
            hornerFunction(a, ds)(Z)
          have rootZ := characterization.forward with s0
          exact hornerFunction.no_two_roots at a, ds, X, Z with aIn, dsList,
            aNonzero, xz, rootX, rootZ, slopeZero, slopes
        . exact hornerFunction.sign_between at a, ds, X, Y, Z with aIn, dsList,
            aNonzero, xy, yz, rootX, s0, slopeZero, slopes
    have restY := convexD with X, realX, Y, realY, Z, realZ, xy, yz, sameD
    symm at signY
    exact SameDerivativeSigns.of_derivative at a, ds, X, Y with aReal, dsList,
      signY, restY

-- The realization of a sign condition on all derivatives is convex.
theorem thom.convex (X Y Z : Real)
  requires leftOrder : X < Y
  requires rightOrder : Y < Z
  requires same : SameDerivativeSigns(X, Z)
  shows SameDerivativeSigns(X, Y)
proof
  have realX : X ∈ ℝ by simp [Real]
  have realY : Y ∈ ℝ by simp [Real]
  have realZ : Z ∈ ℝ by simp [Real]
  have lengthNat : Nat(length{ℝ}(cs)) by typecheck
  have size : length{ℝ}(cs) = length{ℝ}(cs) by rfl
  have convex := thom.convex_induction at leading, cs, length{ℝ}(cs) with
    initial, coefficients, nonzero
  exact convex with leading, initial, cs, coefficients, nonzero, size, X, realX,
    Y, realY, Z, realZ, leftOrder, rightOrder, same

-- Thom's lemma: a root is determined by the signs of the derivatives. Two
-- distinct roots with the same signs would make every point between them a
-- root, by convexity.
theorem thom.lemma (X Y : Real)
  requires rootX : hornerFunction(leading, cs)(X) = (0:R)
  requires rootY : hornerFunction(leading, cs)(Y) = (0:R)
  requires same : SameDerivativeSigns(X, Y)
  shows X = Y
proof
  have realX : X ∈ ℝ by simp [Real]
  have realY : Y ∈ ℝ by simp [Real]
  have leadingIn : leading ∈ ℝ by exact initial
  have zeroNat : Nat(0) by typecheck
  have zeroLe : 0 ≤ length{ℝ}(cs) by arith
  have signZero := realSign.of_zero with rootX
  have split := realLess.trichotomy at X, Y
  rcases split with less | equal | more
  . exfalso
    have roots : ∀ W ∈ ℝ, X < W → W < Y → hornerFunction(leading, cs)(W) = (0:R)
      intros W realW xw wy
      have typedW : Real(W) by exact realW
      have sameW := thom.convex at leading, cs, X, W, Y with initial,
        coefficients, nonzero, xw, wy, same
      unfold SameDerivativeSigns at sameW
      have signs := sameW with 0, zeroNat, zeroLe
      rw [(derivativeSigns.zero_all at leading, cs, X with initial,
        coefficients), (derivativeSigns.zero_all at leading, cs, W with
        initial, coefficients), signZero] at signs
      symm at signs
      have characterization := realSign.eq_zero_iff at
        hornerFunction(leading, cs)(W)
      exact characterization.forward with signs
    exact hornerFunction.not_all_roots at leading, cs, X, Y with leadingIn,
      coefficients, nonzero, less, roots
  . exact equal
  . exfalso
    have sameYX : SameDerivativeSigns(Y, X)
      unfold SameDerivativeSigns
      intros k kNat bound
      unfold SameDerivativeSigns at same
      have signs := same with k, kNat, bound
      symm at signs
      exact signs
    have signZeroY := realSign.of_zero with rootY
    have roots : ∀ W ∈ ℝ, Y < W → W < X → hornerFunction(leading, cs)(W) = (0:R)
      intros W realW yw wx
      have typedW : Real(W) by exact realW
      have sameW := thom.convex at leading, cs, Y, W, X with initial,
        coefficients, nonzero, yw, wx, sameYX
      unfold SameDerivativeSigns at sameW
      have signs := sameW with 0, zeroNat, zeroLe
      rw [(derivativeSigns.zero_all at leading, cs, Y with initial,
        coefficients), (derivativeSigns.zero_all at leading, cs, W with
        initial, coefficients), signZeroY] at signs
      symm at signs
      have characterization := realSign.eq_zero_iff at
        hornerFunction(leading, cs)(W)
      exact characterization.forward with signs
    exact hornerFunction.not_all_roots at leading, cs, Y, X with leadingIn,
      coefficients, nonzero, more, roots

end Nonzero
end Polynomials
