-- Thom's lemma: the signs of p, p′, …, p^(deg p) at a real root determine
-- the root, and the set of points realizing a sign condition on all the
-- derivatives is convex.
-- Part of the CAD blueprint.
-- Planned home: Real/Analysis/Thom.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module CAD.Thom
import CAD.RealRootOrder

-- The sign of the k-th derivative of the pair at X.
defgraph derivativeSigns (leading cs : Set, X : Real) (k ∈ ℕ) : ℝ :=
  realSign(hornerFunction(fst(realDerivativePair(leading, cs, k)),
    snd(realDerivativePair(leading, cs, k)))(X))
requires initial : Real(leading)
requires coefficients : List(ℝ, cs)
proof
  sorry

-- X and Y satisfy the same sign condition on p, p′, …, p^(length cs).
predicate SameDerivativeSigns (leading cs : Set) (X Y : Real) :=
  ∀ k, Nat(k) → k ≤ length{ℝ}(cs) →
    derivativeSigns(leading, cs, X)(k) = derivativeSigns(leading, cs, Y)(k)

section Polynomials
variable (leading cs : Set)
hypothesis initial : Real(leading)
hypothesis coefficients : List(ℝ, cs)
hypothesis nonzero : leading ≠ (0:R)

theorem derivativeSigns.zero (X : Real)
  shows derivativeSigns(leading, cs, X)(0) = realSign(hornerFunction(leading,
    cs)(X))
proof
  sorry

theorem derivativeSigns.succ (k : Nat) (X : Real)
  shows derivativeSigns(leading, cs, X)(k + 1) =
    derivativeSigns(realDerivativeLeading(leading, cs), realDerivativeList(cs),
      X)(k)
proof
  sorry

-- The top derivative is the nonzero constant (length cs)!·leading.
theorem derivativeSigns.top (X : Real)
  shows derivativeSigns(leading, cs, X)(length{ℝ}(cs)) ≠ (0:R)
proof
  sorry

-- The realization of a sign condition on all derivatives is convex.
theorem thom.convex (X Y Z : Real)
  requires leftOrder : X < Y
  requires rightOrder : Y < Z
  requires same : SameDerivativeSigns(leading, cs, X, Z)
  shows SameDerivativeSigns(leading, cs, X, Y)
proof
  sorry

-- Thom's lemma: a root is determined by the signs of the derivatives.
theorem thom.lemma (X Y : Real)
  requires rootX : hornerFunction(leading, cs)(X) = (0:R)
  requires rootY : hornerFunction(leading, cs)(Y) = (0:R)
  requires same : SameDerivativeSigns(leading, cs, X, Y)
  shows X = Y
proof
  sorry

end Polynomials
