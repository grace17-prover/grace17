module CAD.RealConstantSign
import Grace.Cumulus.Real.Analysis.IntermediateValue
import CAD.RealSign
import CAD.RealRays

-- Continuity on a set restricts to every subset.
theorem ContinuousOn.subset (f S T : Set)
  requires continuous : ContinuousOn(f, T)
  requires subset : S ⊆ T
  shows ContinuousOn(f, S)
proof
  obtain ⟨function, bound, pointwise⟩ := continuous
  have boundS := Subset.transitive with subset, bound
  refine ⟨function, boundS, ?_⟩
  intros A hA
  have inT := subset with A, hA
  have typedA : Real(A) by exact (bound with A, inT)
  obtain ⟨functionAgain, boundAgain, control⟩ := pointwise with A, inT
  refine ⟨function, boundS, ?_⟩
  intros E hE positive
  obtain ⟨D, hD, positiveD, near⟩ := control with E, hE, positive
  refine ⟨D, hD, positiveD, ?_⟩
  intros X hX inS inBall
  exact near with X, hX, (subset with X, inS), inBall

-- The negative of a function continuous on a set, as its product with
-- the constant −1, is continuous there and takes the negated values.
theorem ContinuousOn.neg_scaled (f S : Set)
  requires continuous : ContinuousOn(f, S)
  shows ContinuousOn(pointwiseMul(constantFunction(ℝ, ℝ, -(1:R)), f), S) ∧
    ∀ X ∈ ℝ, pointwiseMul(constantFunction(ℝ, ℝ, -(1:R)), f)(X) =
      -(1:R) * f(X)
proof
  have function : f : ℝ → ℝ
    rcases continuous with ⟨function, subset, pointwise⟩
    exact function
  have subset : S ⊆ ℝ
    rcases continuous with ⟨function, subset, pointwise⟩
    exact subset
  have typedNegOne : Real(-(1:R)) by typecheck
  have negOneReal : -(1:R) ∈ ℝ by exact typedNegOne
  have constantFunction : constantFunction(ℝ, ℝ, -(1:R)) : ℝ → ℝ :=
    constantFunction.function at ℝ, ℝ, -(1:R) with negOneReal
  have uniform := constantFunction.uniform_continuous_on at S, -(1:R)
    with subset
  have constantContinuous := UniformContinuousOn.continuous_on with uniform
  constructor
  . exact ContinuousOn.mul with constantContinuous, continuous
  . intros X hX
    have typedX : Real(X) by exact hX
    have valueReal : Real(f(X)) by
      exact FunctionBetween.apply_closed with function, hX
    have constantValue := constantFunction.apply at ℝ, ℝ, X, -(1:R)
      with hX, negOneReal
    have constantReal : Real(constantFunction(ℝ, ℝ, -(1:R))(X))
      rw constantValue
      typecheck
    have value := pointwiseMul.value at constantFunction(ℝ, ℝ, -(1:R)), f, X
      with constantFunction, function, constantReal, valueReal
    rw constantValue at value
    exact value

theorem closedInterval.intermediate_value_decreasing (f : Set) (A B V : Real)
  requires ordered : A ≤ B
  requires continuous : ContinuousOn(f, closedInterval(A, B))
  requires above : V < (f(A):R)
  requires below : (f(B):R) < V
  shows ∃ C ∈ closedInterval(A, B), f(C) = V
proof
  have function : f : ℝ → ℝ
    rcases continuous with ⟨function, subset, pointwise⟩
    exact function
  obtain ⟨scaledContinuous, scaledValue⟩ :=
    ContinuousOn.neg_scaled with continuous
  have realA : A ∈ ℝ by simp [Real]
  have realB : B ∈ ℝ by simp [Real]
  have typedFA : Real(f(A)) by
    exact FunctionBetween.apply_closed with function, realA
  have typedFB : Real(f(B)) by
    exact FunctionBetween.apply_closed with function, realB
  have valueA := scaledValue with A, realA
  have valueB := scaledValue with B, realB
  have negatedA : -(1:R) * f(A) = -f(A) by ring
  have negatedB : -(1:R) * f(B) = -f(B) by ring
  have belowScaled :
      (pointwiseMul(constantFunction(ℝ, ℝ, -(1:R)), f)(A):R) < -V
    rw [valueA, negatedA]
    linarith
  have aboveScaled :
      -V < (pointwiseMul(constantFunction(ℝ, ℝ, -(1:R)), f)(B):R)
    rw [valueB, negatedB]
    linarith
  obtain ⟨C, hC, valueC⟩ := closedInterval.intermediate_value
    at pointwiseMul(constantFunction(ℝ, ℝ, -(1:R)), f), A, B, -V
    with ordered, scaledContinuous, belowScaled, aboveScaled
  obtain ⟨realC, lowerC, upperC⟩ :=
    closedInterval.membership.forward with hC
  have typedC : Real(C) by exact realC
  have typedFC : Real(f(C)) by
    exact FunctionBetween.apply_closed with function, realC
  have scaledC := scaledValue with C, realC
  have negatedC : -(1:R) * f(C) = -f(C) by ring
  rw [scaledC, negatedC] at valueC
  refine ⟨C, hC, ?_⟩
  linarith

theorem closedInterval.zero_of_sign_change_decreasing (f : Set) (A B : Real)
  requires ordered : A ≤ B
  requires continuous : ContinuousOn(f, closedInterval(A, B))
  requires positive : 0 < (f(A):R)
  requires negative : (f(B):R) < 0
  shows ∃ C ∈ closedInterval(A, B), f(C) = (0:R)
proof
  exact closedInterval.intermediate_value_decreasing with *

theorem closedInterval.zero_of_opposite_signs (f : ℝ → ℝ) (A B : Real)
  requires ordered : A ≤ B
  requires continuous : ContinuousOn(f, closedInterval(A, B))
  requires opposite : f(A) * f(B) < 0
  shows ∃ C ∈ closedInterval(A, B), f(C) = (0:R)
proof
  have function : f : ℝ → ℝ by assumption
  have realA : A ∈ ℝ by simp [Real]
  have realB : B ∈ ℝ by simp [Real]
  have typedFA : Real(f(A)) by
    exact FunctionBetween.apply_closed with function, realA
  have typedFB : Real(f(B)) by
    exact FunctionBetween.apply_closed with function, realB
  have split := realLess.trichotomy at f(A), (0:R)
  rcases split with negativeA | zeroA | positiveA
  . have positiveB : 0 < f(B)
      by_contra notPositive
      have nonpositive := realLe.of_not_less with notPositive
      have nonnegativeA : 0 ≤ -f(A) by linarith
      have nonnegativeB : 0 ≤ -f(B) by linarith
      have product := realMulValue.nonnegative with nonnegativeA, nonnegativeB
      have same : -f(A) * -f(B) = f(A) * f(B) by ring
      rw same at product
      linarith
    exact closedInterval.zero_of_sign_change with
      ordered, continuous, negativeA, positiveB
  . exfalso
    have productZero := realMulValue.zero_left at f(B)
    rw [zeroA, productZero] at opposite
    linarith
  . have negativeB : f(B) < 0
      by_contra notNegative
      have nonnegativeB := realLe.of_not_less with notNegative
      have nonnegativeA := realLess.implies_le with positiveA
      have product := realMulValue.nonnegative with nonnegativeA, nonnegativeB
      linarith
    exact closedInterval.zero_of_sign_change_decreasing with
      ordered, continuous, positiveA, negativeB

-- A continuous function without zeros on a closed interval keeps one
-- sign there.
theorem ContinuousOn.constant_sign (f : ℝ → ℝ) (A B : Real)
  requires ordered : A ≤ B
  requires continuous : ContinuousOn(f, closedInterval(A, B))
  requires nonzero : ∀ X ∈ closedInterval(A, B), f(X) ≠ (0:R)
  shows (∀ X ∈ closedInterval(A, B), (0:R) < f(X)) ∨
    ∀ X ∈ closedInterval(A, B), f(X) < (0:R)
proof
  have function : f : ℝ → ℝ by assumption
  have realA : A ∈ ℝ by simp [Real]
  have leftMember := closedInterval.left_mem with ordered
  have typedFA : Real(f(A)) by
    exact FunctionBetween.apply_closed with function, realA
  have nonzeroA := nonzero with A, leftMember
  have reflexive := realLe.reflexive at A
  have split := realLess.trichotomy at f(A), (0:R)
  rcases split with negativeA | zeroA | positiveA
  . right
    intros X hX
    obtain ⟨realX, lowerX, upperX⟩ :=
      closedInterval.membership.forward with hX
    have typedX : Real(X) by exact realX
    have typedFX : Real(f(X)) by
      exact FunctionBetween.apply_closed with function, realX
    have nonzeroX := nonzero with X, hX
    by_contra notNegative
    have positiveX : 0 < f(X)
      have splitX := realLess.trichotomy at (0:R), f(X)
      rcases splitX with positive | zero | negative
      . exact positive
      . exfalso
        apply nonzeroX
        symm
        exact zero
      . exfalso
        exact notNegative with negative
    have nested := closedInterval.nested at A, X, A, B with reflexive, upperX
    have continuousAX := ContinuousOn.subset with continuous, nested
    obtain ⟨C, hC, zeroC⟩ := closedInterval.zero_of_sign_change
      with lowerX, continuousAX, negativeA, positiveX
    exact nonzero with C, (nested with C, hC), zeroC
  . exfalso
    exact nonzeroA with zeroA
  . left
    intros X hX
    obtain ⟨realX, lowerX, upperX⟩ :=
      closedInterval.membership.forward with hX
    have typedX : Real(X) by exact realX
    have typedFX : Real(f(X)) by
      exact FunctionBetween.apply_closed with function, realX
    have nonzeroX := nonzero with X, hX
    by_contra notPositive
    have negativeX : f(X) < 0
      have splitX := realLess.trichotomy at (0:R), f(X)
      rcases splitX with positive | zero | negative
      . exfalso
        exact notPositive with positive
      . exfalso
        apply nonzeroX
        symm
        exact zero
      . exact negative
    have nested := closedInterval.nested at A, X, A, B with reflexive, upperX
    have continuousAX := ContinuousOn.subset with continuous, nested
    obtain ⟨C, hC, zeroC⟩ := closedInterval.zero_of_sign_change_decreasing
      with lowerX, continuousAX, positiveA, negativeX
    exact nonzero with C, (nested with C, hC), zeroC

theorem ContinuousOn.sign_eq_of_no_zero (f : ℝ → ℝ) (A B X Y : Real)
  requires ordered : A ≤ B
  requires continuous : ContinuousOn(f, closedInterval(A, B))
  requires nonzero : ∀ Z ∈ closedInterval(A, B), f(Z) ≠ (0:R)
  requires left : X ∈ closedInterval(A, B)
  requires right : Y ∈ closedInterval(A, B)
  shows realSign(f(X)) = realSign(f(Y))
proof
  have function : f : ℝ → ℝ by assumption
  have realX : X ∈ ℝ by simp [Real]
  have realY : Y ∈ ℝ by simp [Real]
  have typedFX : Real(f(X)) by
    exact FunctionBetween.apply_closed with function, realX
  have typedFY : Real(f(Y)) by
    exact FunctionBetween.apply_closed with function, realY
  have constant := ContinuousOn.constant_sign with ordered, continuous, nonzero
  cases constant with positive | negative
  . have signX := realSign.of_positive with (positive with X, left)
    have signY := realSign.of_positive with (positive with Y, right)
    rw [signX, signY]
    rfl
  . have signX := realSign.of_negative with (negative with X, left)
    have signY := realSign.of_negative with (negative with Y, right)
    rw [signX, signY]
    rfl

-- The sign of a function continuous on the line agrees at the ends of a
-- closed interval inside a set where the function has no zero.
theorem Continuous.sign_eq_of_closed_in (f : ℝ → ℝ) (T : Set) (X Y : Real)
  requires continuous : Continuous(f)
  requires ordered : X ≤ Y
  requires inside : closedInterval(X, Y) ⊆ T
  requires nonzero : ∀ Z ∈ T, f(Z) ≠ (0:R)
  shows realSign(f(X)) = realSign(f(Y))
proof
  have subset := closedInterval.subset_reals at X, Y
  have continuousOn := Continuous.continuous_on with continuous, subset
  have nonzeroOn : ∀ Z ∈ closedInterval(X, Y), f(Z) ≠ (0:R)
    intros Z hZ
    exact nonzero with Z, (inside with Z, hZ)
  have leftMember := closedInterval.left_mem with ordered
  have rightMember := closedInterval.right_mem with ordered
  exact ContinuousOn.sign_eq_of_no_zero with
    ordered, continuousOn, nonzeroOn, leftMember, rightMember

-- The closed interval between two points of an open interval lies in it.
theorem closedInterval.subset_open_of_mem (A B X Y : Real)
  requires left : X ∈ openInterval(A, B)
  requires right : Y ∈ openInterval(A, B)
  shows closedInterval(X, Y) ⊆ openInterval(A, B)
proof
  obtain ⟨realX, lowerX, upperX⟩ :=
    openInterval.membership.forward with left
  obtain ⟨realY, lowerY, upperY⟩ :=
    openInterval.membership.forward with right
  intros Z hZ
  obtain ⟨realZ, lowerZ, upperZ⟩ :=
    closedInterval.membership.forward with hZ
  have typedZ : Real(Z) by exact realZ
  apply openInterval.membership.backward
  refine ⟨realZ, ?_, ?_⟩
  . linarith
  . linarith

-- The same on an open interval and on rays, for a function continuous
-- on the line.
theorem Continuous.sign_eq_on_open_interval (f : ℝ → ℝ) (A B X Y : Real)
  requires continuous : Continuous(f)
  requires nonzero : ∀ Z ∈ openInterval(A, B), f(Z) ≠ (0:R)
  requires left : X ∈ openInterval(A, B)
  requires right : Y ∈ openInterval(A, B)
  shows realSign(f(X)) = realSign(f(Y))
proof
  have split := realLess.trichotomy at X, Y
  rcases split with below | same | above
  . have inside := closedInterval.subset_open_of_mem with left, right
    have ordered := realLess.implies_le with below
    exact Continuous.sign_eq_of_closed_in with
      continuous, ordered, inside, nonzero
  . rw same
    rfl
  . have inside := closedInterval.subset_open_of_mem with right, left
    have ordered := realLess.implies_le with above
    symm
    exact Continuous.sign_eq_of_closed_in with
      continuous, ordered, inside, nonzero

theorem Continuous.sign_eq_on_rayAbove (f : ℝ → ℝ) (A X Y : Real)
  requires continuous : Continuous(f)
  requires nonzero : ∀ Z ∈ rayAbove(A), f(Z) ≠ (0:R)
  requires left : X ∈ rayAbove(A)
  requires right : Y ∈ rayAbove(A)
  shows realSign(f(X)) = realSign(f(Y))
proof
  obtain ⟨realX, lowerX⟩ := rayAbove.membership.forward with left
  obtain ⟨realY, lowerY⟩ := rayAbove.membership.forward with right
  have split := realLess.trichotomy at X, Y
  rcases split with below | same | above
  . have inside := closedInterval.subset_rayAbove at X, Y, A with lowerX
    have ordered := realLess.implies_le with below
    exact Continuous.sign_eq_of_closed_in with
      continuous, ordered, inside, nonzero
  . rw same
    rfl
  . have inside := closedInterval.subset_rayAbove at Y, X, A with lowerY
    have ordered := realLess.implies_le with above
    symm
    exact Continuous.sign_eq_of_closed_in with
      continuous, ordered, inside, nonzero

theorem Continuous.sign_eq_on_rayBelow (f : ℝ → ℝ) (A X Y : Real)
  requires continuous : Continuous(f)
  requires nonzero : ∀ Z ∈ rayBelow(A), f(Z) ≠ (0:R)
  requires left : X ∈ rayBelow(A)
  requires right : Y ∈ rayBelow(A)
  shows realSign(f(X)) = realSign(f(Y))
proof
  obtain ⟨realX, upperX⟩ := rayBelow.membership.forward with left
  obtain ⟨realY, upperY⟩ := rayBelow.membership.forward with right
  have split := realLess.trichotomy at X, Y
  rcases split with below | same | above
  . have inside := closedInterval.subset_rayBelow at X, Y, A with upperY
    have ordered := realLess.implies_le with below
    exact Continuous.sign_eq_of_closed_in with
      continuous, ordered, inside, nonzero
  . rw same
    rfl
  . have inside := closedInterval.subset_rayBelow at Y, X, A with upperX
    have ordered := realLess.implies_le with above
    symm
    exact Continuous.sign_eq_of_closed_in with
      continuous, ordered, inside, nonzero

-- A sign change on an open interval forces a zero in it.
theorem Continuous.zero_of_sign_change_open (f : ℝ → ℝ) (A B X Y : Real)
  requires continuous : Continuous(f)
  requires left : X ∈ openInterval(A, B)
  requires right : Y ∈ openInterval(A, B)
  requires opposite : f(X) * f(Y) < 0
  shows ∃ Z ∈ openInterval(A, B), f(Z) = (0:R)
proof
  have function : f : ℝ → ℝ by assumption
  have realX : X ∈ ℝ by simp [Real]
  have realY : Y ∈ ℝ by simp [Real]
  have typedFX : Real(f(X)) by
    exact FunctionBetween.apply_closed with function, realX
  have typedFY : Real(f(Y)) by
    exact FunctionBetween.apply_closed with function, realY
  by_cases ordered : X ≤ Y
  . have inside := closedInterval.subset_open_of_mem with left, right
    have subset := closedInterval.subset_reals at X, Y
    have continuousOn := Continuous.continuous_on with continuous, subset
    obtain ⟨Z, hZ, zeroZ⟩ := closedInterval.zero_of_opposite_signs with
      ordered, continuousOn, opposite
    have inOpen := inside with Z, hZ
    exact ⟨Z, inOpen, zeroZ⟩
  . have reversed := realLess.of_not_le with ordered
    have orderedYX := realLess.implies_le with reversed
    have inside := closedInterval.subset_open_of_mem with right, left
    have subset := closedInterval.subset_reals at Y, X
    have continuousOn := Continuous.continuous_on with continuous, subset
    have commuted := realMulValue.commutative at f(X), f(Y)
    rw commuted at opposite
    obtain ⟨Z, hZ, zeroZ⟩ := closedInterval.zero_of_opposite_signs with
      orderedYX, continuousOn, opposite
    have inOpen := inside with Z, hZ
    exact ⟨Z, inOpen, zeroZ⟩
