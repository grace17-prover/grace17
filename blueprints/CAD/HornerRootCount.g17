-- Counting the roots of a Horner pair with nonzero leading coefficient
-- over a field: at most length(cs) roots, at most length(cs) counted with
-- multiplicity, and the roots of a product are the union of the roots.
-- Part of the CAD blueprint.
-- Planned home: Algebra/Polynomial/HornerRootCount.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module CAD.HornerRootCount
import CAD.HornerMultiplicity
import CAD.HornerProduct
import Grace.Cumulus.Algebra.Polynomial.HornerRoots
import Grace.Cumulus.Cardinal.NaturalSum
import Grace.Cumulus.Cardinal.Counting

-- The multiplicities of the points of A as a function on A.
defgraph rootMultiplicities (A add zero neg mul one leading cs : Set)
  (r ∈ A) : ℕ :=
  rootMultiplicity(A, add, zero, neg, mul, one, leading, cs, r)
requires ring : IsCommRing(A, add, zero, neg, mul, one)
requires initial : leading ∈ A
requires nonzero : leading ≠ zero
requires coefficients : List(A, cs)
proof
  have natural := rootMultiplicity.natural at A, add, zero, neg, mul, one,
    leading, r, cs with *
  exact nat.omega.forward with natural

-- Translation through an arbitrary extension: the value of the
-- translated list at x is the value of the list at f(a) + x.
section Translation
variable (A add zero neg mul one B plus z minus times unit f x leading : Set)
notation ring R := (A, add, zero, neg, mul, one)
notation ring S := (B, plus, z, minus, times, unit)
hypothesis source : IsCommRing(R)
hypothesis target : IsCommRing(S)
hypothesis hom : IsRingHom(f, R, S)
hypothesis element : x ∈ S
hypothesis initial : leading ∈ R

theorem hornerTranslate.map_value (a : Set) (cs : List(A))
  requires center : a ∈ R
  shows monicValue{A}(f, plus, times, f(leading), x,
      hornerTranslate{A}(add, mul, one, leading, a, cs)) =
    monicValue{A}(f, plus, times, f(leading), S[f(a) + x], cs)
proof
  induction cs
  | List.nil =>
    rw [hornerTranslate, monicValue, monicValue]
    rfl
  | List.cons(c, tail) using ih =>
    have coefficient : c ∈ R by assumption
    have ordinary := IsCommRing.ring with source
    have unitIn : R[1] ∈ R by typecheck
    have terminal : R[1 * leading] = leading by ring
    have data := hornerTranslate.data at A, add, zero, neg, mul, one, leading,
      a, tail with *
    have translatedList := data.left
    have expansion := hornerAffineProduct.map_value at A, add, zero, neg, mul,
      one, B, plus, z, minus, times, unit, f, x, leading, a, one, c,
      hornerTranslate{A}(add, mul, one, leading, a, tail) with *
    have unitMap := IsRingHom.one with hom
    rw [terminal, unitMap] at expansion
    have imageA := IsRingHom.closed with hom, center
    have imageC := IsRingHom.closed with hom, coefficient
    have imageLeading := IsRingHom.closed with hom, initial
    have targetRing := IsCommRing.ring with target
    have shifted := IsRing.add_closed with targetRing, imageA, element
    have outer := hornerValue.cons at A, f, plus, times, f(leading),
      S[f(a) + x], c, tail with *
    have rest := hornerValue.closed at A, add, zero, neg, mul, one, B, plus, z,
      minus, times, unit, f, S[f(a) + x], f(leading), tail with *
    rw [hornerTranslate, expansion, ih, outer]
    ring

end Translation

-- m leading zeros are the factor X^m in the polynomial ring, translation
-- is the evaluation at X + r, so it commutes with products of pairs.
section Polynomials
variable (A add zero neg mul one : Set)
notation ring R := (A, add, zero, neg, mul, one)
notation ring P := R[oneVariable]
hypothesis ring : IsCommRing(R)

theorem hornerPoly.cons_entry (l c : Set) (cs : List(A))
  requires initial : l ∈ R
  requires coefficient : c ∈ R
  shows hornerPoly{A}(add, zero, neg, mul, one, l, c :: cs) =
    P[polynomialConstant(oneVariable, R, c) +
      polynomialVariable(oneVariable, R, (0:N)) *
        hornerPoly{A}(add, zero, neg, mul, one, l, cs)]
proof
  unfold hornerPoly
  exact polynomialFromHorner.cons with *

theorem hornerPoly.shift (l : Set) (ds : List(A)) (m : Nat)
  requires initial : l ∈ R
  shows hornerPoly{A}(add, zero, neg, mul, one, l,
      append{A}(ds, listReplicate(m, zero))) =
    P[monoidPow(P, polynomialVariable(oneVariable, R, (0:N)), m) *
      hornerPoly{A}(add, zero, neg, mul, one, l, ds)]
proof
  induction m
  | zero =>
    have ordinary := IsCommRing.ring with ring
    have zeroIn := IsRing.zero_in_carrier with ordinary
    have oneIn : R[1] ∈ R by typecheck
    have target := polynomials.comm_ring at oneVariable, A, add, zero, neg,
      mul, one with *
    have dsPoly := hornerPoly.member at A, add, zero, neg, mul, one, l, ds
      with *
    rw [listReplicate.zero, append.nil, monoidPow.zero]
    ring
  | succ(k) using ih =>
    have ordinary := IsCommRing.ring with ring
    have zeroIn := IsRing.zero_in_carrier with ordinary
    have oneIn : R[1] ∈ R by typecheck
    have target := polynomials.comm_ring at oneVariable, A, add, zero, neg,
      mul, one with *
    have ordinaryP := IsCommRing.ring with target
    have monoidP := IsRing.multiplicative with ordinaryP
    have zeros := listReplicate.closed at A, zero, k with *
    have appended : List(A, append{A}(ds, listReplicate(k, zero))) by typecheck
    have expansion := append.cons at A, zero, listReplicate(k, zero), ds with *
    have consPoly := hornerPoly.cons_entry at A, add, zero, neg, mul, one, l,
      zero, append{A}(ds, listReplicate(k, zero)) with *
    have variable := polynomialVariable.member at oneVariable, A, zero, one,
      (0:N) with *
    have zeroConstant := polynomialConstant.zero at oneVariable, A, zero with *
    have power := monoidPow.closed at polynomials(oneVariable, A, zero),
      polynomialMul(oneVariable, R), P[1],
      polynomialVariable(oneVariable, R, (0:N)), k with *
    have dsPoly := hornerPoly.member at A, add, zero, neg, mul, one, l, ds
      with *
    rw [listReplicate.succ, expansion, consPoly, ih, zeroConstant,
      monoidPow.succ]
    ring

theorem hornerPoly.translate_eval (l r : Set) (cs : List(A))
  requires initial : l ∈ R
  requires center : r ∈ R
  shows polynomialAtOver(oneVariable, A, add, zero, neg, mul, one,
      polynomials(oneVariable, A, zero), polynomialAdd(oneVariable, R), P[0],
      polynomialNeg(oneVariable, R), polynomialMul(oneVariable, R), P[1],
      polynomialCoefficients(oneVariable, R),
      constantFunction(oneVariable, polynomials(oneVariable, A, zero),
        P[polynomialConstant(oneVariable, R, r) +
          polynomialVariable(oneVariable, R, (0:N))]))(
      hornerPoly{A}(add, zero, neg, mul, one, l, cs)) =
    hornerPoly{A}(add, zero, neg, mul, one, l,
      hornerTranslate{A}(add, mul, one, l, r, cs))
proof
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have oneIn : R[1] ∈ R by typecheck
  have target := polynomials.comm_ring at oneVariable, A, add, zero, neg, mul,
    one with *
  have ordinaryP := IsCommRing.ring with target
  have hom := polynomialCoefficients.hom at oneVariable, A, add, zero, neg, mul,
    one with *
  have variable := polynomialVariable.member at oneVariable, A, zero, one,
    (0:N) with *
  have constantR := polynomialConstant.member at oneVariable, A, zero, r with *
  have point : P[polynomialConstant(oneVariable, R, r) +
      polynomialVariable(oneVariable, R, (0:N))] ∈
      polynomials(oneVariable, A, zero)
    exact IsRing.add_closed with ordinaryP, constantR, variable
  have assignment := constantFunction.function at oneVariable,
    polynomials(oneVariable, A, zero),
    P[polynomialConstant(oneVariable, R, r) +
      polynomialVariable(oneVariable, R, (0:N))] with point
  have zeroNat : Nat((0:N)) by typecheck
  have zeroIndex : (0:N) ∈ oneVariable
    unfold oneVariable
    apply (membership.successor at (0:N), (0:N) with zeroNat, zeroNat).backward
    right
    rfl
  have evaluation := polynomialAtOver.from_horner at oneVariable, A, add, zero,
    neg, mul, one, polynomials(oneVariable, A, zero),
    polynomialAdd(oneVariable, R), P[0], polynomialNeg(oneVariable, R),
    polynomialMul(oneVariable, R), P[1], polynomialCoefficients(oneVariable, R),
    constantFunction(oneVariable, polynomials(oneVariable, A, zero),
      P[polynomialConstant(oneVariable, R, r) +
        polynomialVariable(oneVariable, R, (0:N))]), (0:N), l, cs with *
  have atIndex := constantFunction.apply at oneVariable,
    polynomials(oneVariable, A, zero), (0:N),
    P[polynomialConstant(oneVariable, R, r) +
      polynomialVariable(oneVariable, R, (0:N))] with zeroIndex, point
  have first := polynomialCoefficients.value at oneVariable, A, zero, l with *
  have centerValue := polynomialCoefficients.value at oneVariable, A, zero, r
    with *
  have translate := hornerTranslate.map_value at A, add, zero, neg, mul, one,
    polynomials(oneVariable, A, zero), polynomialAdd(oneVariable, R), P[0],
    polynomialNeg(oneVariable, R), polynomialMul(oneVariable, R), P[1],
    polynomialCoefficients(oneVariable, R),
    polynomialVariable(oneVariable, R, (0:N)), l, r, cs with *
  rw centerValue at translate
  unfold hornerPoly
  rw [evaluation, atIndex, ← translate]
  unfold polynomialFromHorner
  rw first
  rfl

theorem hornerTranslate.mul_list (l b r : Set) (cs ds : List(A))
  requires left : l ∈ R
  requires right : b ∈ R
  requires center : r ∈ R
  shows hornerTranslate{A}(add, mul, one, R[l * b], r,
      hornerMulList{A}(add, zero, mul, l, b, cs, ds)) =
    hornerMulList{A}(add, zero, mul, l, b,
      hornerTranslate{A}(add, mul, one, l, r, cs),
      hornerTranslate{A}(add, mul, one, b, r, ds))
proof
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have oneIn : R[1] ∈ R by typecheck
  have target := polynomials.comm_ring at oneVariable, A, add, zero, neg, mul,
    one with *
  have ordinaryP := IsCommRing.ring with target
  have hom := polynomialCoefficients.hom at oneVariable, A, add, zero, neg, mul,
    one with *
  have product := IsRing.mul_closed with ordinary, left, right
  have variable := polynomialVariable.member at oneVariable, A, zero, one,
    (0:N) with *
  have constantR := polynomialConstant.member at oneVariable, A, zero, r with *
  have point : P[polynomialConstant(oneVariable, R, r) +
      polynomialVariable(oneVariable, R, (0:N))] ∈
      polynomials(oneVariable, A, zero)
    exact IsRing.add_closed with ordinaryP, constantR, variable
  have assignment := constantFunction.function at oneVariable,
    polynomials(oneVariable, A, zero),
    P[polynomialConstant(oneVariable, R, r) +
      polynomialVariable(oneVariable, R, (0:N))] with point
  have evalHom := polynomialAtOver.hom at oneVariable, A, add, zero, neg, mul,
    one, polynomials(oneVariable, A, zero), polynomialAdd(oneVariable, R),
    P[0], polynomialNeg(oneVariable, R), polynomialMul(oneVariable, R), P[1],
    polynomialCoefficients(oneVariable, R),
    constantFunction(oneVariable, polynomials(oneVariable, A, zero),
      P[polynomialConstant(oneVariable, R, r) +
        polynomialVariable(oneVariable, R, (0:N))]) with *
  have mulData := hornerMulList.data at A, add, zero, neg, mul, one, l, b, cs,
    ds with *
  have mulListL := mulData.left
  have dataCs := hornerTranslate.data at A, add, zero, neg, mul, one, l, r, cs
    with *
  have translatedCs := dataCs.left
  have dataDs := hornerTranslate.data at A, add, zero, neg, mul, one, b, r, ds
    with *
  have translatedDs := dataDs.left
  have translatedMul := hornerTranslate.data at A, add, zero, neg, mul, one,
    R[l * b], r, hornerMulList{A}(add, zero, mul, l, b, cs, ds) with *
  have translatedMulList := translatedMul.left
  have mulDataT := hornerMulList.data at A, add, zero, neg, mul, one, l, b,
    hornerTranslate{A}(add, mul, one, l, r, cs),
    hornerTranslate{A}(add, mul, one, b, r, ds) with *
  have mulListT := mulDataT.left
  have evalProduct := hornerPoly.translate_eval at A, add, zero, neg, mul, one,
    R[l * b], r, hornerMulList{A}(add, zero, mul, l, b, cs, ds) with *
  have evalL := hornerPoly.translate_eval at A, add, zero, neg, mul, one, l, r,
    cs with *
  have evalB := hornerPoly.translate_eval at A, add, zero, neg, mul, one, b, r,
    ds with *
  have productPoly := hornerPoly.mul at A, add, zero, neg, mul, one, l, b, cs,
    ds with *
  have productPolyT := hornerPoly.mul at A, add, zero, neg, mul, one, l, b,
    hornerTranslate{A}(add, mul, one, l, r, cs),
    hornerTranslate{A}(add, mul, one, b, r, ds) with *
  have csPoly := hornerPoly.member at A, add, zero, neg, mul, one, l, cs with *
  have dsPoly := hornerPoly.member at A, add, zero, neg, mul, one, b, ds with *
  have mapped := IsRingHom.mul with evalHom, csPoly, dsPoly
  have equal : hornerPoly{A}(add, zero, neg, mul, one, R[l * b],
      hornerTranslate{A}(add, mul, one, R[l * b], r,
        hornerMulList{A}(add, zero, mul, l, b, cs, ds))) =
      hornerPoly{A}(add, zero, neg, mul, one, R[l * b],
        hornerMulList{A}(add, zero, mul, l, b,
          hornerTranslate{A}(add, mul, one, l, r, cs),
          hornerTranslate{A}(add, mul, one, b, r, ds)))
    rw [← evalProduct, productPoly, mapped, evalL, evalB, productPolyT]
    rfl
  have sameLength : length{A}(hornerTranslate{A}(add, mul, one, R[l * b], r,
      hornerMulList{A}(add, zero, mul, l, b, cs, ds))) =
      length{A}(hornerMulList{A}(add, zero, mul, l, b,
        hornerTranslate{A}(add, mul, one, l, r, cs),
        hornerTranslate{A}(add, mul, one, b, r, ds)))
    rw [translatedMul.right, mulData.right, mulDataT.right, dataCs.right,
      dataDs.right]
    rfl
  exact hornerPoly.list_unique at A, add, zero, neg, mul, one, R[l * b],
    hornerTranslate{A}(add, mul, one, R[l * b], r,
      hornerMulList{A}(add, zero, mul, l, b, cs, ds)),
    hornerMulList{A}(add, zero, mul, l, b,
      hornerTranslate{A}(add, mul, one, l, r, cs),
      hornerTranslate{A}(add, mul, one, b, r, ds)) with *

theorem hornerMulList.shift (l b : Set) (ds es : List(A)) (m n : Nat)
  requires left : l ∈ R
  requires right : b ∈ R
  shows hornerMulList{A}(add, zero, mul, l, b,
      append{A}(ds, listReplicate(m, zero)),
      append{A}(es, listReplicate(n, zero))) =
    append{A}(hornerMulList{A}(add, zero, mul, l, b, ds, es),
      listReplicate(m + n, zero))
proof
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have oneIn : R[1] ∈ R by typecheck
  have target := polynomials.comm_ring at oneVariable, A, add, zero, neg, mul,
    one with *
  have ordinaryP := IsCommRing.ring with target
  have monoidP := IsRing.multiplicative with ordinaryP
  have product := IsRing.mul_closed with ordinary, left, right
  have variable := polynomialVariable.member at oneVariable, A, zero, one,
    (0:N) with *
  have zerosM := listReplicate.closed at A, zero, m with *
  have zerosN := listReplicate.closed at A, zero, n with *
  have zerosMN := listReplicate.closed at A, zero, m + n with *
  have lengthM := listReplicate.length at A, zero, m with *
  have lengthN := listReplicate.length at A, zero, n with *
  have lengthMN := listReplicate.length at A, zero, m + n with *
  have appendedD : List(A, append{A}(ds, listReplicate(m, zero))) by typecheck
  have appendedE : List(A, append{A}(es, listReplicate(n, zero))) by typecheck
  have mulData := hornerMulList.data at A, add, zero, neg, mul, one, l, b, ds,
    es with *
  have mulListL := mulData.left
  have mulDataA := hornerMulList.data at A, add, zero, neg, mul, one, l, b,
    append{A}(ds, listReplicate(m, zero)),
    append{A}(es, listReplicate(n, zero)) with *
  have mulListA := mulDataA.left
  have appendedMul : List(A,
    append{A}(hornerMulList{A}(add, zero, mul, l, b, ds, es),
      listReplicate(m + n, zero))) by typecheck
  have shiftD := hornerPoly.shift at A, add, zero, neg, mul, one, l, ds, m
    with *
  have shiftE := hornerPoly.shift at A, add, zero, neg, mul, one, b, es, n
    with *
  have shiftProduct := hornerPoly.shift at A, add, zero, neg, mul, one,
    R[l * b], hornerMulList{A}(add, zero, mul, l, b, ds, es), m + n with *
  have productPoly := hornerPoly.mul at A, add, zero, neg, mul, one, l, b,
    append{A}(ds, listReplicate(m, zero)),
    append{A}(es, listReplicate(n, zero)) with *
  have productInner := hornerPoly.mul at A, add, zero, neg, mul, one, l, b, ds,
    es with *
  have powerAdd := monoidPow.add at polynomials(oneVariable, A, zero),
    polynomialMul(oneVariable, R), P[1],
    polynomialVariable(oneVariable, R, (0:N)), m, n with *
  have powerM := monoidPow.closed at polynomials(oneVariable, A, zero),
    polynomialMul(oneVariable, R), P[1],
    polynomialVariable(oneVariable, R, (0:N)), m with *
  have powerN := monoidPow.closed at polynomials(oneVariable, A, zero),
    polynomialMul(oneVariable, R), P[1],
    polynomialVariable(oneVariable, R, (0:N)), n with *
  have dsPoly := hornerPoly.member at A, add, zero, neg, mul, one, l, ds with *
  have esPoly := hornerPoly.member at A, add, zero, neg, mul, one, b, es with *
  have equal : hornerPoly{A}(add, zero, neg, mul, one, R[l * b],
      hornerMulList{A}(add, zero, mul, l, b,
        append{A}(ds, listReplicate(m, zero)),
        append{A}(es, listReplicate(n, zero)))) =
      hornerPoly{A}(add, zero, neg, mul, one, R[l * b],
        append{A}(hornerMulList{A}(add, zero, mul, l, b, ds, es),
          listReplicate(m + n, zero)))
    rw [productPoly, shiftD, shiftE, shiftProduct, productInner, powerAdd]
    ring
  have totalD := length.append at A, ds, listReplicate(m, zero) with *
  have totalE := length.append at A, es, listReplicate(n, zero) with *
  have totalMul := length.append at A,
    hornerMulList{A}(add, zero, mul, l, b, ds, es), listReplicate(m + n, zero)
    with *
  have sameLength : length{A}(hornerMulList{A}(add, zero, mul, l, b,
      append{A}(ds, listReplicate(m, zero)),
      append{A}(es, listReplicate(n, zero)))) =
      length{A}(append{A}(hornerMulList{A}(add, zero, mul, l, b, ds, es),
        listReplicate(m + n, zero)))
    rw [mulDataA.right, totalD, totalE, lengthM, lengthN, totalMul,
      mulData.right, lengthMN]
    arith
  exact hornerPoly.list_unique at A, add, zero, neg, mul, one, R[l * b],
    hornerMulList{A}(add, zero, mul, l, b,
      append{A}(ds, listReplicate(m, zero)),
      append{A}(es, listReplicate(n, zero))),
    append{A}(hornerMulList{A}(add, zero, mul, l, b, ds, es),
      listReplicate(m + n, zero)) with *

end Polynomials

section Fields
variable (A add zero neg mul one leading : Set)
notation ring R := (A, add, zero, neg, mul, one)
notation ring P := R[oneVariable]
hypothesis field : IsField(R)
hypothesis initial : leading ∈ R
hypothesis nonzero : leading ≠ R[0]

-- Every subset of the root set has at most length(cs) points.
theorem hornerRoots.subset_cardinality_le (n : Nat) (cs : List(A))
  requires size : length{A}(cs) = n
  shows ∀ S, S ⊆ hornerRoots{A}(add, zero, mul, leading, cs) →
    cardinality(S) ≤ n
proof
  induction n generalizing cs
  | zero =>
    intros cs list size S subset
    have shape := List.cases at A, cs with *
    cases shape with empty | cons
    . have emptySet : S = ∅
        ext x
        constructor
        . intro member
          have root := subset with x, member
          rw [empty, hornerRoots.nil] at root
          exfalso
          exact set.empty with root
        . intro impossible
          exfalso
          exact set.empty with impossible
      rw [emptySet, cardinality.empty]
      arith
    . obtain ⟨c, coefficient, tail, tailList, equal⟩ := cons
      rw [equal, length.cons] at size
      symm at size
      exfalso
      exact Naturals.disjoint.zero.succ at length{A}(tail) with size
  | succ(k) using ih =>
    intros cs list size S subset
    have shape := List.cases at A, cs with *
    cases shape with empty | cons
    . have emptySet : S = ∅
        ext x
        constructor
        . intro member
          have root := subset with x, member
          rw [empty, hornerRoots.nil] at root
          exfalso
          exact set.empty with root
        . intro impossible
          exfalso
          exact set.empty with impossible
      rw [emptySet, cardinality.empty]
      arith
    . obtain ⟨c, coefficient, tail, tailList, equal⟩ := cons
      have tailSize : length{A}(tail) = k
        rw [equal, length.cons] at size
        exact Naturals.injective.succ with size
      have alternatives : (∃ a, a ∈ S) ∨ ¬(∃ a, a ∈ S) by tauto
      cases alternatives with inhabited | emptySet
      . obtain ⟨a, ha⟩ := inhabited
        have root := subset with a, ha
        rw equal at root
        obtain ⟨center, rootValue⟩ := hornerRoots.membership.forward at A, add,
          zero, mul, leading, c :: tail, a with *
        have ring := IsField.comm_ring with field
        have quotient := hornerQuotient.closed at A, add, zero, neg, mul, one,
          leading, a, tail with *
        have quotientLength := hornerQuotient.length at A, add, zero, neg, mul,
          one, leading, a, tail with *
        have quotientSize : length{A}(hornerQuotient{A}(add, mul, leading, a,
          tail)) = k by cc
        have divided := hornerRoots.divide at A, add, zero, neg, mul, one,
          leading, a, c, tail with *
        have removed : S ∖ {a} ⊆ hornerRoots{A}(add, zero, mul, leading,
            hornerQuotient{A}(add, mul, leading, a, tail))
          intros x hx
          have parts := difference.singleton_membership.forward with hx
          have inRoots := subset with x, parts.left
          rw equal at inRoots
          have inInsert := divided with x, inRoots
          have split := insert.membership.forward with inInsert
          cases split with same | inner
          . exfalso
            exact parts.right with same
          . exact inner
        have previous := ih with hornerQuotient{A}(add, mul, leading, a, tail),
          quotient, quotientSize, S ∖ {a}, removed
        have finite := hornerRoots.finite at A, add, zero, neg, mul, one,
          leading, cs with *
        have finiteS := Finite.subset with finite, subset
        have count := cardinality.remove with finiteS, ha
        have finiteQuotient := hornerRoots.finite at A, add, zero, neg, mul,
          one, leading, hornerQuotient{A}(add, mul, leading, a, tail) with *
        have finiteRemoved := Finite.subset with finiteQuotient, removed
        have removedNat := cardinality.nat with finiteRemoved
        rw count
        arith
      . have empty : S = ∅
          ext x
          constructor
          . intro member
            exfalso
            apply emptySet
            refine ⟨x, member⟩
          . intro impossible
            exfalso
            exact set.empty with impossible
        rw [empty, cardinality.empty]
        arith

theorem hornerRoots.cardinality_le (cs : List(A))
  shows cardinality(hornerRoots{A}(add, zero, mul, leading, cs)) ≤
    length{A}(cs)
proof
  have size : length{A}(cs) = length{A}(cs) by rfl
  have bound := hornerRoots.subset_cardinality_le at A, add, zero, neg, mul,
    one, leading, length{A}(cs), cs with *
  exact bound with hornerRoots{A}(add, zero, mul, leading, cs),
    Subset.reflexive

theorem hornerRoots.mul (b : Set) (cs ds : List(A))
  requires second : b ∈ R
  requires secondNonzero : b ≠ R[0]
  shows hornerRoots{A}(add, zero, mul, R[leading * b], hornerMulList{A}(add,
    zero, mul, leading, b, cs, ds)) =
    hornerRoots{A}(add, zero, mul, leading, cs) ∪ hornerRoots{A}(add, zero,
      mul, b, ds)
proof
  have ring := IsField.comm_ring with field
  have ordinary := IsCommRing.ring with ring
  have noZero := IsField.no_zero_divisors with field
  ext x
  constructor
  . intro member
    obtain ⟨element, vanishes⟩ := hornerRoots.membership.forward at A, add,
      zero, mul, R[leading * b], hornerMulList{A}(add, zero, mul, leading, b,
      cs, ds), x with *
    have product := hornerMulList.value at A, add, zero, neg, mul, one, leading,
      b, x, cs, ds with *
    have left := hornerAt.closed at A, add, zero, neg, mul, one, leading, x, cs
      with *
    have right := hornerAt.closed at A, add, zero, neg, mul, one, b, x, ds
      with *
    rw product at vanishes
    have alternatives := noZero with hornerAt{A}(add, mul, leading, x, cs),
      left, hornerAt{A}(add, mul, b, x, ds), right, vanishes
    apply union2.membership.backward
    cases alternatives with first | second
    . left
      apply hornerRoots.membership.backward
      refine ⟨element, first⟩
    . right
      apply hornerRoots.membership.backward
      refine ⟨element, second⟩
  . intro member
    have split := union2.membership.forward with member
    apply hornerRoots.membership.backward
    cases split with first | second
    . obtain ⟨element, vanishes⟩ := hornerRoots.membership.forward at A, add,
        zero, mul, leading, cs, x with *
      have product := hornerMulList.value at A, add, zero, neg, mul, one,
        leading, b, x, cs, ds with *
      have right := hornerAt.closed at A, add, zero, neg, mul, one, b, x, ds
        with *
      refine ⟨element, ?_⟩
      rw [product, vanishes]
      ring
    . obtain ⟨element, vanishes⟩ := hornerRoots.membership.forward at A, add,
        zero, mul, b, ds, x with *
      have product := hornerMulList.value at A, add, zero, neg, mul, one,
        leading, b, x, cs, ds with *
      have left := hornerAt.closed at A, add, zero, neg, mul, one, leading, x,
        cs with *
      refine ⟨element, ?_⟩
      rw [product, vanishes]
      ring

-- The multiplicity at a point adds over a product.
theorem rootMultiplicity.mul (b r : Set) (cs ds : List(A))
  requires second : b ∈ R
  requires secondNonzero : b ≠ R[0]
  requires center : r ∈ R
  shows rootMultiplicity(A, add, zero, neg, mul, one, R[leading * b],
      hornerMulList{A}(add, zero, mul, leading, b, cs, ds), r) =
    rootMultiplicity(A, add, zero, neg, mul, one, leading, cs, r) +
      rootMultiplicity(A, add, zero, neg, mul, one, b, ds, r)
proof
  have ring := IsField.comm_ring with field
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have noZero := IsField.no_zero_divisors with field
  have productIn := IsRing.mul_closed with ordinary, initial, second
  have productNonzero : R[leading * b] ≠ R[0]
    intro vanishes
    have split := noZero with leading, initial, b, second, vanishes
    cases split with first | last
    . exact nonzero with first
    . exact secondNonzero with last
  have hasL := rootMultiplicity.has at A, add, zero, neg, mul, one, leading, r,
    cs with *
  have hasB := rootMultiplicity.has at A, add, zero, neg, mul, one, b, r, ds
    with *
  obtain ⟨mNat, ds1, ds1List, headD, equalD⟩ := hasL
  obtain ⟨nNat, es1, es1List, headE, equalE⟩ := hasB
  have productData := hornerMulList.data at A, add, zero, neg, mul, one,
    leading, b, cs, ds with *
  have productList := productData.left
  have translateMul := hornerTranslate.mul_list at A, add, zero, neg, mul, one,
    leading, b, r, cs, ds with *
  have shift := hornerMulList.shift at A, add, zero, neg, mul, one, leading, b,
    ds1, es1, rootMultiplicity(A, add, zero, neg, mul, one, leading, cs, r),
    rootMultiplicity(A, add, zero, neg, mul, one, b, ds, r) with *
  have mulData := hornerMulList.data at A, add, zero, neg, mul, one, leading,
    b, ds1, es1 with *
  have mulListL := mulData.left
  have atZeroP := hornerAt.at_zero at A, add, zero, neg, mul, one,
    R[leading * b], r, hornerMulList{A}(add, zero, mul, leading, b, ds1, es1)
    with *
  have atZeroD := hornerAt.at_zero at A, add, zero, neg, mul, one, leading, r,
    ds1 with *
  have atZeroE := hornerAt.at_zero at A, add, zero, neg, mul, one, b, r, es1
    with *
  have value := hornerMulList.value at A, add, zero, neg, mul, one, leading, b,
    R[0], ds1, es1 with *
  have headDIn := listHeadOr.closed at A, leading, ds1 with *
  have headEIn := listHeadOr.closed at A, b, es1 with *
  have headProduct : listHeadOr{A}(R[leading * b],
      hornerMulList{A}(add, zero, mul, leading, b, ds1, es1)) ≠ zero
    rw [← atZeroP, value, atZeroD, atZeroE]
    intro vanishes
    have split := noZero with listHeadOr{A}(leading, ds1), headDIn,
      listHeadOr{A}(b, es1), headEIn, vanishes
    cases split with first | last
    . exact headD with first
    . exact headE with last
  have sumNat : Nat(rootMultiplicity(A, add, zero, neg, mul, one, leading, cs,
    r) + rootMultiplicity(A, add, zero, neg, mul, one, b, ds, r)) by typecheck
  have hasProduct : HasMultiplicity(A, add, zero, neg, mul, one, R[leading * b],
      hornerMulList{A}(add, zero, mul, leading, b, cs, ds), r,
      rootMultiplicity(A, add, zero, neg, mul, one, leading, cs, r) +
        rootMultiplicity(A, add, zero, neg, mul, one, b, ds, r))
    refine ⟨sumNat, hornerMulList{A}(add, zero, mul, leading, b, ds1, es1),
      mulListL, headProduct, ?_⟩
    rw [translateMul, equalD, equalE, shift]
    rfl
  have hasRoot := rootMultiplicity.has at A, add, zero, neg, mul, one,
    R[leading * b], r, hornerMulList{A}(add, zero, mul, leading, b, cs, ds)
    with *
  exact HasMultiplicity.unique at A, add, zero, neg, mul, one, R[leading * b],
    r, rootMultiplicity(A, add, zero, neg, mul, one, R[leading * b],
      hornerMulList{A}(add, zero, mul, leading, b, cs, ds), r),
    rootMultiplicity(A, add, zero, neg, mul, one, leading, cs, r) +
      rootMultiplicity(A, add, zero, neg, mul, one, b, ds, r),
    hornerMulList{A}(add, zero, mul, leading, b, cs, ds) with *

-- The pair X − a: its only root is a, of multiplicity one.
theorem hornerRoots.linear_member (a x : Set)
  requires center : a ∈ R
  requires member : x ∈ hornerRoots{A}(add, zero, mul, one, neg(a) :: [])
  shows x = a
proof
  have ring := IsField.comm_ring with field
  have ordinary := IsCommRing.ring with ring
  have negated := IsRing.neg_closed with ordinary, center
  have empty : List(A, []) by typecheck
  obtain ⟨element, vanishes⟩ := hornerRoots.membership.forward at A, add, zero,
    mul, one, neg(a) :: [], x with *
  rw [hornerAt.cons, hornerAt.nil] at vanishes
  linear_combination vanishes

theorem rootMultiplicity.linear_self (a : Set)
  requires center : a ∈ R
  shows rootMultiplicity(A, add, zero, neg, mul, one, one, neg(a) :: [], a) =
    (1:N)
proof
  have ring := IsField.comm_ring with field
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have oneIn : R[1] ∈ R by typecheck
  have negated := IsRing.neg_closed with ordinary, center
  have single : List(A, neg(a) :: []) by typecheck
  have empty : List(A, []) by typecheck
  have nontrivial := IsField.nontrivial with field
  have distinct := Nontrivial.distinct with nontrivial
  have oneNonzero : one ≠ zero
    intro equal
    apply distinct
    symm
    exact equal
  have translated : hornerTranslate{A}(add, mul, one, one, a, neg(a) :: []) =
      zero :: []
    rw [hornerTranslate, hornerTranslate, hornerAffineProduct]
    have entry : R[-a + a * 1] = R[0] by ring
    rw entry
    rfl
  have oneNat : Nat((1:N)) by typecheck
  have head : listHeadOr{A}(one, []) ≠ zero by rwa listHeadOr
  have has : HasMultiplicity(A, add, zero, neg, mul, one, one, neg(a) :: [], a,
      (1:N))
    refine ⟨oneNat, [], empty, head, ?_⟩
    rw [translated, listReplicate.one, append.cons, append.nil]
    rfl
  have hasRoot := rootMultiplicity.has at A, add, zero, neg, mul, one, one, a,
    neg(a) :: [] with *
  exact HasMultiplicity.unique at A, add, zero, neg, mul, one, one, a,
    rootMultiplicity(A, add, zero, neg, mul, one, one, neg(a) :: [], a), (1:N),
    neg(a) :: [] with *

theorem rootMultiplicity.linear_other (a x : Set)
  requires center : a ∈ R
  requires element : x ∈ R
  requires distinct : x ≠ a
  shows rootMultiplicity(A, add, zero, neg, mul, one, one, neg(a) :: [], x) =
    (0:N)
proof
  have ring := IsField.comm_ring with field
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have oneIn : R[1] ∈ R by typecheck
  have negated := IsRing.neg_closed with ordinary, center
  have single : List(A, neg(a) :: []) by typecheck
  have nontrivial := IsField.nontrivial with field
  have zeroOne := Nontrivial.distinct with nontrivial
  have oneNonzero : one ≠ zero
    intro equal
    apply zeroOne
    symm
    exact equal
  have scaled := IsRing.mul_closed with ordinary, element, oneIn
  have entryIn := IsRing.add_closed with ordinary, negated, scaled
  have shifted : List(A, R[-a + x * 1] :: []) by typecheck
  have translated : hornerTranslate{A}(add, mul, one, one, x, neg(a) :: []) =
      R[-a + x * 1] :: []
    rw [hornerTranslate, hornerTranslate, hornerAffineProduct]
    rfl
  have zeroNat : Nat((0:N)) by typecheck
  have head : listHeadOr{A}(one, R[-a + x * 1] :: []) ≠ zero
    rw listHeadOr
    intro vanishes
    apply distinct
    linear_combination vanishes
  have has : HasMultiplicity(A, add, zero, neg, mul, one, one, neg(a) :: [], x,
      (0:N))
    refine ⟨zeroNat, R[-a + x * 1] :: [], shifted, head, ?_⟩
    rw [translated, listReplicate.zero, append.nil]
    rfl
  have hasRoot := rootMultiplicity.has at A, add, zero, neg, mul, one, one, x,
    neg(a) :: [] with *
  exact HasMultiplicity.unique at A, add, zero, neg, mul, one, one, x,
    rootMultiplicity(A, add, zero, neg, mul, one, one, neg(a) :: [], x), (0:N),
    neg(a) :: [] with *

-- At a root a, the pair is the product of X − a and the synthetic quotient,
-- as lists.
theorem hornerRoots.factor_list (a c : Set) (tail : List(A))
  requires center : a ∈ R
  requires coefficient : c ∈ R
  requires root : hornerAt{A}(add, mul, leading, a, c :: tail) = R[0]
  shows c :: tail = hornerMulList{A}(add, zero, mul, one, leading, neg(a) :: [],
    hornerQuotient{A}(add, mul, leading, a, tail))
proof
  have ring := IsField.comm_ring with field
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have oneIn : R[1] ∈ R by typecheck
  have negated := IsRing.neg_closed with ordinary, center
  have single : List(A, neg(a) :: []) by typecheck
  have empty : List(A, []) by typecheck
  have consList : List(A, c :: tail) by typecheck
  have target := polynomials.comm_ring at oneVariable, A, add, zero, neg, mul,
    one with *
  have hom := polynomialCoefficients.hom at oneVariable, A, add, zero, neg, mul,
    one with *
  have variable := polynomialVariable.member at oneVariable, A, zero, one,
    (0:N) with *
  have centerValue := polynomialCoefficients.value at oneVariable, A, zero, a
    with *
  have negValue := polynomialCoefficients.value at oneVariable, A, zero, neg(a)
    with *
  have mappedNeg := IsRingHom.neg with hom, center
  have constantA := polynomialConstant.member at oneVariable, A, zero, a with *
  have linearPoly : hornerPoly{A}(add, zero, neg, mul, one, one, neg(a) :: []) =
      P[polynomialVariable(oneVariable, R, (0:N)) -
        polynomialConstant(oneVariable, R, a)]
    have consPoly := hornerPoly.cons_entry at A, add, zero, neg, mul, one, R[1],
      neg(a), [] with *
    have constant := hornerPoly.constant at A, add, zero, neg, mul, one, R[1]
      with *
    rw [consPoly, constant, ← negValue, mappedNeg, centerValue]
    ring
  have quotient := hornerQuotient.closed at A, add, zero, neg, mul, one,
    leading, a, tail with *
  have quotientLength := hornerQuotient.length at A, add, zero, neg, mul, one,
    leading, a, tail with *
  have first := polynomialCoefficients.value at oneVariable, A, zero, leading
    with *
  have mappedZero := IsRingHom.zero with hom
  have constantL := polynomialConstant.member at oneVariable, A, zero, leading
    with *
  have result := hornerValue.synthetic_division at A, add, zero, neg, mul, one,
    polynomials(oneVariable, A, zero), polynomialAdd(oneVariable, R), P[0],
    polynomialNeg(oneVariable, R), polynomialMul(oneVariable, R), P[1],
    polynomialCoefficients(oneVariable, R), leading, a,
    polynomialVariable(oneVariable, R, (0:N)), c, tail with *
  have quotientValue := hornerValue.closed at A, add, zero, neg, mul, one,
    polynomials(oneVariable, A, zero), polynomialAdd(oneVariable, R), P[0],
    polynomialNeg(oneVariable, R), polynomialMul(oneVariable, R), P[1],
    polynomialCoefficients(oneVariable, R),
    polynomialVariable(oneVariable, R, (0:N)),
    polynomialConstant(oneVariable, R, leading),
    hornerQuotient{A}(add, mul, leading, a, tail) with *
  rw [first, centerValue, root, mappedZero] at result
  have factor : hornerPoly{A}(add, zero, neg, mul, one, leading, c :: tail) =
      P[(polynomialVariable(oneVariable, R, (0:N)) -
        polynomialConstant(oneVariable, R, a)) *
        hornerPoly{A}(add, zero, neg, mul, one, leading,
          hornerQuotient{A}(add, mul, leading, a, tail))]
    unfold hornerPoly
    unfold polynomialFromHorner
    rw result
    ring
  have productPoly := hornerPoly.mul at A, add, zero, neg, mul, one, one,
    leading, neg(a) :: [], hornerQuotient{A}(add, mul, leading, a, tail) with *
  have unit : R[1 * leading] = leading by ring
  rw unit at productPoly
  have mulData := hornerMulList.data at A, add, zero, neg, mul, one, one,
    leading, neg(a) :: [], hornerQuotient{A}(add, mul, leading, a, tail) with *
  have mulListL := mulData.left
  have equal : hornerPoly{A}(add, zero, neg, mul, one, leading, c :: tail) =
      hornerPoly{A}(add, zero, neg, mul, one, leading,
        hornerMulList{A}(add, zero, mul, one, leading, neg(a) :: [],
          hornerQuotient{A}(add, mul, leading, a, tail)))
    rw [productPoly, linearPoly, factor]
    rfl
  have sameLength : length{A}(c :: tail) =
      length{A}(hornerMulList{A}(add, zero, mul, one, leading, neg(a) :: [],
        hornerQuotient{A}(add, mul, leading, a, tail)))
    rw [mulData.right, length.cons, length.cons, length.nil, quotientLength]
    arith
  exact hornerPoly.list_unique at A, add, zero, neg, mul, one, leading,
    c :: tail, hornerMulList{A}(add, zero, mul, one, leading, neg(a) :: [],
      hornerQuotient{A}(add, mul, leading, a, tail)) with *

-- The multiplicities on a subset of A are naturals.
theorem rootMultiplicities.natural_on (l : Set) (cs : List(A)) (V : Set)
  requires lIn : l ∈ R
  requires lNonzero : l ≠ R[0]
  requires subset : V ⊆ A
  shows ∀ v ∈ V, rootMultiplicities(A, add, zero, neg, mul, one, l, cs)(v) ∈ ℕ
proof
  have ring := IsField.comm_ring with field
  intros v hv
  have vIn := subset with v, hv
  have value := rootMultiplicities.value at A, add, zero, neg, mul, one, l, cs,
    v with *
  have natural := rootMultiplicity.natural at A, add, zero, neg, mul, one, l, v,
    cs with *
  rw value
  exact nat.omega.forward with natural

-- Counted with multiplicity, the roots of a pair of length n number at
-- most n: a root a splits off X − a and the quotient has length n − 1.
theorem hornerRoots.multiplicity_sum_le_of_length (n : Nat) (cs : List(A))
  requires size : length{A}(cs) = n
  shows natSum(hornerRoots{A}(add, zero, mul, leading, cs),
    rootMultiplicities(A, add, zero, neg, mul, one, leading, cs)) ≤ n
proof
  induction n generalizing cs
  | zero =>
    intros cs list size
    have shape := List.cases at A, cs with *
    cases shape with empty | cons
    . rw [empty, hornerRoots.nil, natSum.empty]
      arith
    . obtain ⟨c, coefficient, tail, tailList, equal⟩ := cons
      rw [equal, length.cons] at size
      symm at size
      exfalso
      exact Naturals.disjoint.zero.succ at length{A}(tail) with size
  | succ(k) using ih =>
    intros cs list size
    have ring := IsField.comm_ring with field
    have ordinary := IsCommRing.ring with ring
    have zeroIn := IsRing.zero_in_carrier with ordinary
    have oneIn : R[1] ∈ R by typecheck
    have nontrivial := IsField.nontrivial with field
    have zeroOne := Nontrivial.distinct with nontrivial
    have oneNonzero : one ≠ R[0]
      intro equal
      apply zeroOne
      symm
      exact equal
    have shape := List.cases at A, cs with *
    cases shape with empty | cons
    . rw [empty, hornerRoots.nil, natSum.empty]
      arith
    . obtain ⟨c, coefficient, tail, tailList, equal⟩ := cons
      rw equal
      rw equal at size
      have alternatives :
        (∃ a, a ∈ hornerRoots{A}(add, zero, mul, leading, c :: tail)) ∨
        ¬(∃ a, a ∈ hornerRoots{A}(add, zero, mul, leading, c :: tail)) by tauto
      cases alternatives with inhabited | emptyRoots
      . obtain ⟨a, ha⟩ := inhabited
        obtain ⟨center, rootValue⟩ := hornerRoots.membership.forward at A, add,
          zero, mul, leading, c :: tail, a with *
        have negated := IsRing.neg_closed with ordinary, center
        have single : List(A, neg(a) :: []) by typecheck
        have quotient := hornerQuotient.closed at A, add, zero, neg, mul, one,
          leading, a, tail with *
        have quotientLength := hornerQuotient.length at A, add, zero, neg, mul,
          one, leading, a, tail with *
        have quotientSize : length{A}(hornerQuotient{A}(add, mul, leading, a,
            tail)) = k
          rw [quotientLength]
          rw length.cons at size
          exact Naturals.injective.succ with size
        have previous := ih at hornerQuotient{A}(add, mul, leading, a, tail)
          with quotient, quotientSize
        have factor := hornerRoots.factor_list at A, add, zero, neg, mul, one,
          leading, a, c, tail with *
        have unit : R[1 * leading] = leading by ring
        have rootsMul := hornerRoots.mul at A, add, zero, neg, mul, one, one,
          leading, neg(a) :: [], hornerQuotient{A}(add, mul, leading, a, tail)
          with *
        rw [unit, ← factor] at rootsMul
        have multLaw : ∀ x ∈ A,
            rootMultiplicity(A, add, zero, neg, mul, one, leading, c :: tail,
              x) =
            rootMultiplicity(A, add, zero, neg, mul, one, one, neg(a) :: [],
              x) +
            rootMultiplicity(A, add, zero, neg, mul, one, leading,
              hornerQuotient{A}(add, mul, leading, a, tail), x)
          intros x hx
          have law := rootMultiplicity.mul at A, add, zero, neg, mul, one, one,
            leading, x, neg(a) :: [],
            hornerQuotient{A}(add, mul, leading, a, tail) with *
          rw [unit, ← factor] at law
          exact law
        have finiteT := hornerRoots.finite at A, add, zero, neg, mul, one,
          leading, c :: tail with *
        have finiteQ := hornerRoots.finite at A, add, zero, neg, mul, one,
          leading, hornerQuotient{A}(add, mul, leading, a, tail) with *
        have rootsIn : hornerRoots{A}(add, zero, mul, leading, c :: tail) ⊆ A
          intros x hx
          have parts := hornerRoots.membership.forward at A, add, zero, mul,
            leading, c :: tail, x with *
          exact parts.left
        have quotientRootsIn : hornerRoots{A}(add, zero, mul, leading,
            hornerQuotient{A}(add, mul, leading, a, tail)) ⊆ A
          intros x hx
          have parts := hornerRoots.membership.forward at A, add, zero, mul,
            leading, hornerQuotient{A}(add, mul, leading, a, tail), x with *
          exact parts.left
        have quotientRootsSub : hornerRoots{A}(add, zero, mul, leading,
            hornerQuotient{A}(add, mul, leading, a, tail)) ⊆
            hornerRoots{A}(add, zero, mul, leading, c :: tail)
          intros x hx
          rw rootsMul
          apply union2.membership.backward
          right
          exact hx
        have removedSub : hornerRoots{A}(add, zero, mul, leading, c :: tail) ∖
            {a} ⊆ hornerRoots{A}(add, zero, mul, leading, c :: tail)
          intros x hx
          have parts := difference.singleton_membership.forward with hx
          exact parts.left
        have removedIn : hornerRoots{A}(add, zero, mul, leading, c :: tail) ∖
            {a} ⊆ A
          intros x hx
          exact rootsIn with x, (removedSub with x, hx)
        have removedQuotient : hornerRoots{A}(add, zero, mul, leading,
            c :: tail) ∖ {a} ⊆ hornerRoots{A}(add, zero, mul, leading,
            hornerQuotient{A}(add, mul, leading, a, tail))
          intros x hx
          have parts := difference.singleton_membership.forward with hx
          have inRoots := parts.left
          rw rootsMul at inRoots
          have split := union2.membership.forward with inRoots
          cases split with linear | inner
          . exfalso
            apply parts.right
            exact hornerRoots.linear_member at A, add, zero, neg, mul, one,
              leading, a, x with *
          . exact inner
        have finiteS := Finite.subset with finiteT, removedSub
        have aNotRemoved : ¬(a ∈ hornerRoots{A}(add, zero, mul, leading,
            c :: tail) ∖ {a})
          intro member
          have parts := difference.singleton_membership.forward with member
          exact parts.right with rfl
        have insertRemoved : insert(a, hornerRoots{A}(add, zero, mul, leading,
            c :: tail) ∖ {a}) =
            hornerRoots{A}(add, zero, mul, leading, c :: tail)
          ext x
          constructor
          . intro member
            have split := insert.membership.forward with member
            cases split with same | inner
            . rw same
              exact ha
            . exact removedSub with x, inner
          . intro member
            apply insert.membership.backward
            have decide : x = a ∨ x ≠ a by tauto
            cases decide with same | different
            . left
              exact same
            . right
              exact difference.singleton_membership.backward with
                ⟨member, different⟩
        have weightsT := rootMultiplicities.natural_on at A, add, zero, neg,
          mul, one, leading, leading, c :: tail,
          hornerRoots{A}(add, zero, mul, leading, c :: tail) ∖ {a} with *
        have weightsQ := rootMultiplicities.natural_on at A, add, zero, neg,
          mul, one, leading, leading,
          hornerQuotient{A}(add, mul, leading, a, tail),
          hornerRoots{A}(add, zero, mul, leading, c :: tail) ∖ {a} with *
        have weightsQAll := rootMultiplicities.natural_on at A, add, zero, neg,
          mul, one, leading, leading,
          hornerQuotient{A}(add, mul, leading, a, tail),
          hornerRoots{A}(add, zero, mul, leading,
            hornerQuotient{A}(add, mul, leading, a, tail)) with *
        have valueTa := rootMultiplicities.value at A, add, zero, neg, mul, one,
          leading, c :: tail, a with *
        have valueQa := rootMultiplicities.value at A, add, zero, neg, mul, one,
          leading, hornerQuotient{A}(add, mul, leading, a, tail), a with *
        have naturalTa := rootMultiplicity.natural at A, add, zero, neg, mul,
          one, leading, a, c :: tail with *
        have naturalQa := rootMultiplicity.natural at A, add, zero, neg, mul,
          one, leading, a, hornerQuotient{A}(add, mul, leading, a, tail) with *
        have weightTa : rootMultiplicities(A, add, zero, neg, mul, one, leading,
            c :: tail)(a) ∈ ℕ
          rw valueTa
          exact nat.omega.forward with naturalTa
        have weightQa : rootMultiplicities(A, add, zero, neg, mul, one, leading,
            hornerQuotient{A}(add, mul, leading, a, tail))(a) ∈ ℕ
          rw valueQa
          exact nat.omega.forward with naturalQa
        have sumInsert := natSum.insert at
          hornerRoots{A}(add, zero, mul, leading, c :: tail) ∖ {a},
          rootMultiplicities(A, add, zero, neg, mul, one, leading, c :: tail), a
          with *
        rw insertRemoved at sumInsert
        have linearSelf := rootMultiplicity.linear_self at A, add, zero, neg,
          mul, one, leading, a with *
        have lawA := multLaw with a, center
        rw linearSelf at lawA
        have agree : ∀ x ∈ hornerRoots{A}(add, zero, mul, leading, c :: tail) ∖
            {a},
            rootMultiplicities(A, add, zero, neg, mul, one, leading,
              c :: tail)(x) =
            rootMultiplicities(A, add, zero, neg, mul, one, leading,
              hornerQuotient{A}(add, mul, leading, a, tail))(x)
          intros x hx
          have parts := difference.singleton_membership.forward with hx
          have xIn := rootsIn with x, parts.left
          have different := parts.right
          have valueT := rootMultiplicities.value at A, add, zero, neg, mul,
            one, leading, c :: tail, x with *
          have valueQ := rootMultiplicities.value at A, add, zero, neg, mul,
            one, leading, hornerQuotient{A}(add, mul, leading, a, tail), x
            with *
          have law := multLaw with x, xIn
          have other := rootMultiplicity.linear_other at A, add, zero, neg, mul,
            one, leading, a, x with *
          rw [valueT, valueQ, law, other, add.left_unit]
          rfl
        have congruent := natSum.congr at
          hornerRoots{A}(add, zero, mul, leading, c :: tail) ∖ {a},
          rootMultiplicities(A, add, zero, neg, mul, one, leading, c :: tail),
          rootMultiplicities(A, add, zero, neg, mul, one, leading,
            hornerQuotient{A}(add, mul, leading, a, tail)) with agree
        have sumS := natSum.natural at
          hornerRoots{A}(add, zero, mul, leading, c :: tail) ∖ {a},
          rootMultiplicities(A, add, zero, neg, mul, one, leading,
            hornerQuotient{A}(add, mul, leading, a, tail)) with *
        have sumQ := natSum.natural at hornerRoots{A}(add, zero, mul, leading,
            hornerQuotient{A}(add, mul, leading, a, tail)),
          rootMultiplicities(A, add, zero, neg, mul, one, leading,
            hornerQuotient{A}(add, mul, leading, a, tail)) with *
        have bound : natSum(hornerRoots{A}(add, zero, mul, leading, c :: tail) ∖
              {a},
            rootMultiplicities(A, add, zero, neg, mul, one, leading,
              hornerQuotient{A}(add, mul, leading, a, tail))) +
            rootMultiplicities(A, add, zero, neg, mul, one, leading,
              hornerQuotient{A}(add, mul, leading, a, tail))(a) ≤ k
          have decide : a ∈ hornerRoots{A}(add, zero, mul, leading,
              hornerQuotient{A}(add, mul, leading, a, tail)) ∨
            ¬(a ∈ hornerRoots{A}(add, zero, mul, leading,
              hornerQuotient{A}(add, mul, leading, a, tail))) by tauto
          cases decide with inside | outside
          . have quotientRoots : hornerRoots{A}(add, zero, mul, leading,
                hornerQuotient{A}(add, mul, leading, a, tail)) =
                insert(a, hornerRoots{A}(add, zero, mul, leading, c :: tail) ∖
                  {a})
              ext x
              constructor
              . intro member
                apply insert.membership.backward
                have split : x = a ∨ x ≠ a by tauto
                cases split with same | different
                . left
                  exact same
                . right
                  have inRoots := quotientRootsSub with x, member
                  exact difference.singleton_membership.backward with
                    ⟨inRoots, different⟩
              . intro member
                have split := insert.membership.forward with member
                cases split with same | inner
                . cc [same, inside]
                . exact removedQuotient with x, inner
            have sumInsertQ := natSum.insert at
              hornerRoots{A}(add, zero, mul, leading, c :: tail) ∖ {a},
              rootMultiplicities(A, add, zero, neg, mul, one, leading,
                hornerQuotient{A}(add, mul, leading, a, tail)), a with *
            rw [← quotientRoots] at sumInsertQ
            rw ← sumInsertQ
            exact previous
          . have quotientRoots : hornerRoots{A}(add, zero, mul, leading,
                hornerQuotient{A}(add, mul, leading, a, tail)) =
                hornerRoots{A}(add, zero, mul, leading, c :: tail) ∖ {a}
              ext x
              constructor
              . intro member
                have different : x ≠ a
                  intro same
                  apply outside
                  cc [same, member]
                have inRoots := quotientRootsSub with x, member
                exact difference.singleton_membership.backward with
                  ⟨inRoots, different⟩
              . intro member
                exact removedQuotient with x, member
            have notRoot : hornerAt{A}(add, mul, leading, a,
                hornerQuotient{A}(add, mul, leading, a, tail)) ≠ R[0]
              intro vanishes
              apply outside
              apply hornerRoots.membership.backward
              refine ⟨center, vanishes⟩
            have criterion := rootMultiplicity.zero_iff at A, add, zero, neg,
              mul, one, leading, a, hornerQuotient{A}(add, mul, leading, a,
              tail) with *
            have vanishesQ := criterion.backward with notRoot
            rw [valueQa, vanishesQ, add.right_unit, ← quotientRoots]
            exact previous
        rw [sumInsert, congruent, valueTa, lawA]
        rw valueQa at bound
        arith
      . have empty : hornerRoots{A}(add, zero, mul, leading, c :: tail) = ∅
          ext x
          constructor
          . intro member
            exfalso
            apply emptyRoots
            refine ⟨x, member⟩
          . intro impossible
            exfalso
            exact set.empty with impossible
        rw [empty, natSum.empty]
        arith

-- Counted with multiplicity, the roots number at most the degree.
theorem hornerRoots.multiplicity_sum_le (cs : List(A))
  shows natSum(hornerRoots{A}(add, zero, mul, leading, cs),
    rootMultiplicities(A, add, zero, neg, mul, one, leading,
      cs)) ≤ length{A}(cs)
proof
  have size : length{A}(cs) = length{A}(cs) by rfl
  exact hornerRoots.multiplicity_sum_le_of_length at A, add, zero, neg, mul,
    one, leading, length{A}(cs), cs with *

end Fields
