-- The Sturm sequence of a real Horner pair, p, p′, and then the negated
-- remainders until zero, each in normal form; the Sturm count at a point
-- as the sign variations of the values; the sign relations the classical
-- proof uses; and Sturm's theorem: for a squarefree pair and A < B with
-- p(A), p(B) nonzero, the number of roots in (A, B) is the drop of the
-- count from A to B.
-- Part of the CAD blueprint.
-- Planned home: Real/Analysis/Sturm.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module CAD.Sturm
import CAD.SignVariations
import CAD.RealSquarefree
import CAD.RealRootOrder
import Grace.Cumulus.Nat.Least

-- The next term after the pairs p and q: the negated remainder of p by q
-- in normal form, or the zero pair once q is zero.
def sturmStep (p q : Set) : Set :=
  boolChoice(memberTest({realZero}, fst(q)), (realZero, []),
    (hornerTrimLeading{ℝ}(realZero, hornerNeg{ℝ}(realNeg,
        hornerDivRemainder{ℝ}(realAdd, realZero, realNeg, realMul, realOne,
          fst(q), fst(p), snd(q), snd(p)))),
      hornerTrimLower{ℝ}(realZero, hornerNeg{ℝ}(realNeg,
        hornerDivRemainder{ℝ}(realAdd, realZero, realNeg, realMul, realOne,
          fst(q), fst(p), snd(q), snd(p))))))

def sturmNormal (leading cs : Set) : Set :=
  (normalLeading{ℝ}(realZero, leading, cs),
    normalLower{ℝ}(realZero, leading, cs))

-- The zero pair absorbs the step.
theorem sturmStep.zero_second (p : Set)
  shows sturmStep(p, (realZero, [])) = (realZero, [])
proof
  have zeroIn : realZero ∈ {realZero} by simp [singleton.membership]
  have test := memberTest.true at {realZero}, realZero with zeroIn
  unfold sturmStep
  rw [fst.pair, test, boolChoice.true]

theorem sturmStep.of_nonzero (p q : Set)
  requires nonzero : fst(q) ≠ realZero
  shows sturmStep(p, q) =
    (hornerTrimLeading{ℝ}(realZero, hornerNeg{ℝ}(realNeg,
        hornerDivRemainder{ℝ}(realAdd, realZero, realNeg, realMul, realOne,
          fst(q), fst(p), snd(q), snd(p)))),
      hornerTrimLower{ℝ}(realZero, hornerNeg{ℝ}(realNeg,
        hornerDivRemainder{ℝ}(realAdd, realZero, realNeg, realMul, realOne,
          fst(q), fst(p), snd(q), snd(p)))))
proof
  have absent : ¬(fst(q) ∈ {realZero})
    intro member
    have same := singleton.membership.forward with member
    exact nonzero with same
  have test := memberTest.false at {realZero}, fst(q) with absent
  unfold sturmStep
  rw [test, boolChoice.false]

-- A step keeps the pairs real and in normal form.
theorem sturmStep.data (p q : Set)
  requires pReal : fst(p) ∈ ℝ
  requires pList : List(ℝ, snd(p))
  requires qReal : fst(q) ∈ ℝ
  requires qList : List(ℝ, snd(q))
  shows fst(sturmStep(p, q)) ∈ ℝ ∧ List(ℝ, snd(sturmStep(p, q))) ∧
    (fst(sturmStep(p, q)) ≠ realZero ∨
      (fst(sturmStep(p, q)) = realZero ∧ snd(sturmStep(p, q)) = [])) ∧
    sturmStep(p, q) = (fst(sturmStep(p, q)), snd(sturmStep(p, q)))
proof
  have zeroIn : realZero ∈ ℝ by typecheck
  by_cases zero : fst(q) = realZero
  . have member : fst(q) ∈ {realZero} by simp [zero, singleton.membership]
    have test := memberTest.true at {realZero}, fst(q) with member
    unfold sturmStep
    rw [test, boolChoice.true, fst.pair, snd.pair]
    refine ⟨zeroIn, _, _, rfl⟩
    . typecheck
    . right
      exact ⟨rfl, rfl⟩
  . rw sturmStep.of_nonzero at p, q with zero
    have field := RealSquarefree.field
    have remainder := hornerDivPair.lists at ℝ, realAdd, realZero, realNeg,
      realMul, realOne, fst(q), fst(p), snd(q), snd(p) with
      qList, pList, field, qReal, pReal
    have remainderList : List(ℝ, hornerDivRemainder{ℝ}(realAdd, realZero,
        realNeg, realMul, realOne, fst(q), fst(p), snd(q), snd(p)))
      unfold hornerDivRemainder
      exact remainder.right
    have negated := hornerNeg.data at ℝ, realAdd, realZero, realNeg, realMul,
      realOne, hornerDivRemainder{ℝ}(realAdd, realZero, realNeg, realMul,
        realOne, fst(q), fst(p), snd(q), snd(p)) with
      remainderList, reals.comm_ring
    have negatedList := negated.left
    have leadingIn := hornerTrimLeading.mem with negatedList, zeroIn
    have lowerList := hornerTrimLower.list at ℝ, realZero, _ with negatedList
    have normal := hornerTrim.normal at ℝ, realZero, _ with negatedList
    rw [fst.pair, snd.pair]
    exact ⟨leadingIn, lowerList, normal, rfl⟩

-- A real pair in normal form: a nonzero leading coefficient, or the zero
-- pair.
predicate SturmNormalPair (p : Set) :=
  fst(p) ∈ ℝ ∧ List(ℝ, snd(p)) ∧
    (fst(p) ≠ realZero ∨ (fst(p) = realZero ∧ snd(p) = [])) ∧
    p = (fst(p), snd(p))

theorem sturmNormal.normal_pair (a ds : Set)
  requires aReal : a ∈ ℝ
  requires dsList : List(ℝ, ds)
  shows SturmNormalPair(sturmNormal(a, ds))
proof
  have zeroIn : realZero ∈ ℝ by typecheck
  have full := hornerFullList.list with dsList, aReal
  have leadingIn := hornerTrimLeading.mem with full, zeroIn
  have lowerList := hornerTrimLower.list at ℝ, realZero, _ with full
  have normal := hornerTrim.normal at ℝ, realZero, _ with full
  unfold SturmNormalPair
  unfold sturmNormal
  unfold normalLeading
  unfold normalLower
  rw [fst.pair, snd.pair]
  exact ⟨leadingIn, lowerList, normal, rfl⟩

theorem sturmStep.normal_pair (p q : Set)
  requires pNormal : SturmNormalPair(p)
  requires qNormal : SturmNormalPair(q)
  shows SturmNormalPair(sturmStep(p, q))
proof
  rcases pNormal with ⟨pReal, pList, pShape, pEta⟩
  rcases qNormal with ⟨qReal, qList, qShape, qEta⟩
  have step := sturmStep.data with pReal, pList, qReal, qList
  unfold SturmNormalPair
  exact step

-- A pair in normal form with zero leading coefficient is the zero pair.
theorem SturmNormalPair.zero_of_leading (p : Set)
  requires normal : SturmNormalPair(p)
  requires zero : fst(p) = realZero
  shows p = (realZero, [])
proof
  rcases normal with ⟨pReal, pList, pShape, pEta⟩
  cases pShape with nonzero | shape
  . exfalso
    exact nonzero with zero
  . rw [pEta, zero, shape.right]

-- The trimmed empty list is the zero pair.
theorem hornerTrim.nil_pair (rs : Set)
  requires rsList : List(ℝ, rs)
  requires empty : rs = []
  shows hornerTrimLeading{ℝ}(realZero, rs) = realZero ∧
    hornerTrimLower{ℝ}(realZero, rs) = []
proof
  have vanish : ∀ k, Nat(k) → listCoefficient{ℝ}(realZero, rs, k) = realZero
    intros k kNat
    rw empty
    exact listCoefficient.nil at ℝ, realZero, k with kNat
  have characterization := hornerTrim.zero_iff at ℝ, realZero, rs with rsList
  have zero := characterization.backward with vanish
  have normal := hornerTrim.normal at ℝ, realZero, _ with rsList
  cases normal with nonzero | shape
  . exfalso
    exact nonzero with zero
  . exact shape

-- Sign bookkeeping for the local constancy of the count.
theorem realMulValue.nonzero_of_nonzero (a b : Real)
  requires left : a ≠ 0
  requires right : b ≠ 0
  shows a * b ≠ 0
proof
  intro zero
  have split := realMulValue.eq_zero_or at a, b with zero
  cases split with aZero | bZero
  . exact left with aZero
  . exact right with bZero

theorem realMulValue.neg_square_negative (a : Real)
  requires nonzero : a ≠ 0
  shows (-a) * a < 0
proof
  have same : realSign(a) = realSign(a) by rfl
  have square := realSign.product_positive_of_eq at a, a with nonzero, same
  have negated : (-a) * a = -(a * a) by ring
  rw negated
  linarith

theorem realSign.nonzero_of_sign_eq (a b : Real)
  requires nonzero : a ≠ 0
  requires same : realSign(b) = realSign(a)
  shows b ≠ 0
proof
  intro zero
  rw zero at same
  have signZero := realSign.of_zero at (0:R) with rfl
  rw signZero at same
  symm at same
  have aZero := (realSign.eq_zero_iff at a).forward with same
  exact nonzero with aZero

theorem realMulValue.negative_of_neg_pos (a b : Real)
  requires negative : a < 0
  requires positive : 0 < b
  shows a * b < 0
proof
  have product := realSign.product_negative at b, a with positive, negative
  have commute : a * b = b * a by ring
  rw commute
  exact product

theorem realSign.product_congr (a b c d : Real)
  requires first : realSign(c) = realSign(a)
  requires second : realSign(d) = realSign(b)
  shows realSign(c * d) = realSign(a * b)
proof
  have left := realSign.mul at c, d
  have right := realSign.mul at a, b
  rw [left, right, first, second]

-- Two nonzero entries contribute the sign change indicator.
theorem signVariations.cons_cons_indicator (a b : Real) (xs : List(ℝ))
  requires left : a ≠ 0
  requires right : b ≠ 0
  shows signVariations(a :: b :: xs) =
    signVariations(b :: xs) + signChangeIndicator(a, b)
proof
  have productReal : Real(a * b) by typecheck
  have nonzero := realMulValue.nonzero_of_nonzero at a, b with left, right
  have split := realLess.trichotomy at a * b, (0:R)
  rcases split with negative | zero | positive
  . have same := signVariations.cons_cons_opposite at a, b, xs with *
    have one := (signChangeIndicator.one_iff at a, b).backward with negative
    rw [same, one]
  . exfalso
    exact nonzero with zero
  . have same := signVariations.cons_cons_same at a, b, xs with *
    have nonnegative : 0 ≤ a * b by linarith
    have zeroIndicator := (signChangeIndicator.zero_iff at a, b).backward with
      nonnegative
    rw [same, zeroIndicator]
    arith

-- Whatever stands between two entries of opposite signs, the triple
-- contributes exactly one sign change.
theorem signVariations.triple_opposite (a b c : Real) (xs : List(ℝ))
  requires opposite : a * c < 0
  shows signVariations(a :: b :: c :: xs) = signVariations(c :: xs) + 1
proof
  have productReal : Real(a * c) by typecheck
  have productNonzero : a * c ≠ 0
    intro zero
    rw zero at opposite
    linarith
  have aNonzero : a ≠ 0
    intro zero
    have product : a * c = 0
      rw zero
      ring
    exact productNonzero with product
  have cNonzero : c ≠ 0
    intro zero
    have product : a * c = 0
      rw zero
      ring
    exact productNonzero with product
  have signA := realSign.real at a
  have signB := realSign.real at b
  have signC := realSign.real at c
  have relation := realSign.ne_of_product_negative at a, c with opposite
  have squareC := realSign.square at c with cNonzero
  have split := realLess.trichotomy at b, (0:R)
  have consList : List(ℝ, c :: xs) by typecheck
  rcases split with negative | zero | positive
  . have bNonzero : b ≠ 0
      intro zero
      rw zero at negative
      linarith
    have productAB : Real(a * b) by typecheck
    have abNonzero := realMulValue.nonzero_of_nonzero at a, b with aNonzero,
      bNonzero
    have splitAB := realLess.trichotomy at a * b, (0:R)
    rcases splitAB with abNegative | abZero | abPositive
    . have signAB := realSign.ne_of_product_negative at a, b with abNegative
      have signBC : realSign(b * c) = (1:R)
        have mul := realSign.mul at b, c
        rw mul
        have same : realSign(b) = realSign(c)
          rw relation at signAB
          linarith
        rw [same, squareC]
      have bcPositive := (realSign.eq_one_iff at b * c).forward with signBC
      have first := signVariations.cons_cons_opposite at a, b, c :: xs with
        consList, abNegative
      have second := signVariations.cons_cons_same at b, c, xs with *
      rw [first, second]
    . exfalso
      exact abNonzero with abZero
    . have signAB := realSign.eq_of_product_positive at a, b with abPositive
      have signBC : realSign(b * c) = -(1:R)
        have mul := realSign.mul at b, c
        rw mul
        have same : realSign(b) = -realSign(c)
          rw [← signAB, relation]
        rw same
        have negated : -realSign(c) * realSign(c) = -(realSign(c) * realSign(c))
          by ring
        rw [negated, squareC]
      have bcNegative := (realSign.eq_neg_one_iff at b * c).forward with signBC
      have first := signVariations.cons_cons_same at a, b, c :: xs with
        consList, abPositive
      have second := signVariations.cons_cons_opposite at b, c, xs with *
      rw [first, second]
  . rw zero
    have first := signVariations.cons_cons_zero at a, c, xs with *
    have second := signVariations.cons_cons_opposite at a, c, xs with *
    rw [first, second]
  . have bNonzero : b ≠ 0
      intro zero
      rw zero at positive
      linarith
    have productAB : Real(a * b) by typecheck
    have abNonzero := realMulValue.nonzero_of_nonzero at a, b with aNonzero,
      bNonzero
    have splitAB := realLess.trichotomy at a * b, (0:R)
    rcases splitAB with abNegative | abZero | abPositive
    . have signAB := realSign.ne_of_product_negative at a, b with abNegative
      have signBC : realSign(b * c) = (1:R)
        have mul := realSign.mul at b, c
        rw mul
        have same : realSign(b) = realSign(c)
          rw relation at signAB
          linarith
        rw [same, squareC]
      have bcPositive := (realSign.eq_one_iff at b * c).forward with signBC
      have first := signVariations.cons_cons_opposite at a, b, c :: xs with
        consList, abNegative
      have second := signVariations.cons_cons_same at b, c, xs with *
      rw [first, second]
    . exfalso
      exact abNonzero with abZero
    . have signAB := realSign.eq_of_product_positive at a, b with abPositive
      have signBC : realSign(b * c) = -(1:R)
        have mul := realSign.mul at b, c
        rw mul
        have same : realSign(b) = -realSign(c)
          rw [← signAB, relation]
        rw same
        have negated : -realSign(c) * realSign(c) = -(realSign(c) * realSign(c))
          by ring
        rw [negated, squareC]
      have bcNegative := (realSign.eq_neg_one_iff at b * c).forward with signBC
      have first := signVariations.cons_cons_same at a, b, c :: xs with
        consList, abPositive
      have second := signVariations.cons_cons_opposite at b, c, xs with *
      rw [first, second]

-- The hypotheses under which the sign variations of the window of g from i
-- of length n + 1 agree with those of f: the ends of f are nonzero, g has
-- the sign of f wherever f is nonzero, and the neighbors of a zero of f
-- have opposite signs.
predicate SturmWindow (f g : Set) (i n : Nat) :=
  f(i) ≠ (0:R) ∧ f(i + n) ≠ (0:R) ∧
  (∀ k, Nat(k) → i ≤ k → k ≤ i + n → f(k) ≠ (0:R) →
    realSign(g(k)) = realSign(f(k))) ∧
  (∀ k, Nat(k) → i ≤ k → k + 2 ≤ i + n → f(k + 1) = (0:R) →
    f(k) * f(k + 2) < 0)

theorem SturmWindow.shift (f g : Set) (i n j : Nat)
  requires window : SturmWindow(f, g, i, n + j)
  requires start : f(i + j) ≠ (0:R)
  shows SturmWindow(f, g, i + j, n)
proof
  rcases window with ⟨first, last, signs, opposite⟩
  have same : i + j + n = i + (n + j) by ring
  unfold SturmWindow
  refine ⟨start, _, _, _⟩
  . rw same
    exact last
  . intros k kNat lower upper nonzero
    have lowerK : i ≤ k by arith
    have upperK : k ≤ i + (n + j) by arith
    exact signs with k, kNat, lowerK, upperK, nonzero
  . intros k kNat lower upper zero
    have lowerK : i ≤ k by arith
    have upperK : k + 2 ≤ i + (n + j) by arith
    exact opposite with k, kNat, lowerK, upperK, zero

theorem signVariations.window_congr_pair (f g : Set) (n : Nat)
  requires fFunction : f : ℕ → ℝ
  requires gFunction : g : ℕ → ℝ
  shows (∀ i, Nat(i) → SturmWindow(f, g, i, n) →
      signVariations(coefficientWindow(g, i, succ(n))) =
        signVariations(coefficientWindow(f, i, succ(n)))) ∧
    (∀ i, Nat(i) → SturmWindow(f, g, i, succ(n)) →
      signVariations(coefficientWindow(g, i, succ(succ(n)))) =
        signVariations(coefficientWindow(f, i, succ(succ(n)))))
proof
  induction n
  | zero =>
    constructor
    . intros i iNat window
      have iIn : i ∈ ℕ by typecheck
      have fReal : Real(f(i)) by exact FunctionBetween.apply_closed with
        fFunction, iIn
      have gReal : Real(g(i)) by exact FunctionBetween.apply_closed with
        gFunction, iIn
      rw [coefficientWindow, coefficientWindow, coefficientWindow,
        coefficientWindow]
      rw [signVariations.singleton at g(i), signVariations.singleton at f(i)]
    . intros i iNat window
      rcases window with ⟨first, last, signs, opposite⟩
      have iIn : i ∈ ℕ by typecheck
      have nextIn : succ(i) ∈ ℕ by typecheck
      have shift : i + succ(0) = succ(i) by ring
      rw shift at last
      have fReal : Real(f(i)) by exact FunctionBetween.apply_closed with
        fFunction, iIn
      have gReal : Real(g(i)) by exact FunctionBetween.apply_closed with
        gFunction, iIn
      have fNext : Real(f(succ(i))) by exact FunctionBetween.apply_closed with
        fFunction, nextIn
      have gNext : Real(g(succ(i))) by exact FunctionBetween.apply_closed with
        gFunction, nextIn
      have lowerI : i ≤ i by arith
      have upperI : i ≤ i + succ(0) by arith
      have lowerNext : i ≤ succ(i) by arith
      have upperNext : succ(i) ≤ i + succ(0) by arith
      have signI := signs with i, iNat, lowerI, upperI, first
      have signNext := signs with succ(i), nextIn, lowerNext, upperNext, last
      have gFirst := realSign.nonzero_of_sign_eq at f(i), g(i) with first,
        signI
      have gLast := realSign.nonzero_of_sign_eq at f(succ(i)), g(succ(i)) with
        last, signNext
      have nilList : List(ℝ, []) by typecheck
      have fStep := signVariations.cons_cons_indicator at f(i), f(succ(i)), []
        with first, last, nilList
      have gStep := signVariations.cons_cons_indicator at g(i), g(succ(i)), []
        with gFirst, gLast, nilList
      have products := realSign.product_congr at f(i), f(succ(i)), g(i),
        g(succ(i)) with signI, signNext
      have indicators := signChangeIndicator.congr at g(i), g(succ(i)), f(i),
        f(succ(i)) with products
      rw [coefficientWindow, coefficientWindow, coefficientWindow,
        coefficientWindow, coefficientWindow, coefficientWindow]
      rw [fStep, gStep, indicators, signVariations.singleton at g(succ(i)),
        signVariations.singleton at f(succ(i))]
  | succ(m) using ih =>
    rcases ih with ⟨short, long⟩
    constructor
    . exact long
    . intros i iNat window
      have shifted := window
      rcases window with ⟨first, last, signs, opposite⟩
      have iIn : i ∈ ℕ by typecheck
      have nextIn : succ(i) ∈ ℕ by typecheck
      have thirdIn : succ(succ(i)) ∈ ℕ by typecheck
      have fReal : Real(f(i)) by exact FunctionBetween.apply_closed with
        fFunction, iIn
      have gReal : Real(g(i)) by exact FunctionBetween.apply_closed with
        gFunction, iIn
      have fNext : Real(f(succ(i))) by exact FunctionBetween.apply_closed with
        fFunction, nextIn
      have gNext : Real(g(succ(i))) by exact FunctionBetween.apply_closed with
        gFunction, nextIn
      have fThirdIn := FunctionBetween.apply_closed with fFunction, thirdIn
      have gThirdIn := FunctionBetween.apply_closed with gFunction, thirdIn
      have fThird : Real(f(succ(succ(i)))) by exact fThirdIn
      have gThird : Real(g(succ(succ(i)))) by exact gThirdIn
      have restF := coefficientWindow.closed at ℝ, f, succ(succ(succ(i))), m
        with fFunction
      have restG := coefficientWindow.closed at ℝ, g, succ(succ(succ(i))), m
        with gFunction
      have lowerI : i ≤ i by arith
      have upperI : i ≤ i + succ(succ(m)) by arith
      have signI := signs with i, iNat, lowerI, upperI, first
      have gFirst := realSign.nonzero_of_sign_eq at f(i), g(i) with first,
        signI
      by_cases middle : f(succ(i)) = (0:R)
      . have two : i + 2 ≤ i + succ(succ(m)) by arith
        have oneIndex : i + 1 = succ(i) by ring
        have twoIndex : i + 2 = succ(succ(i)) by ring
        have middleIndex : f(i + 1) = (0:R)
          rw oneIndex
          exact middle
        have product := opposite with i, iNat, lowerI, two, middleIndex
        rw twoIndex at product
        have thirdNonzero : f(succ(succ(i))) ≠ (0:R)
          intro zero
          rw zero at product
          have vanish : f(i) * (0:R) = (0:R) by ring
          rw vanish at product
          linarith
        have lowerThird : i ≤ succ(succ(i)) by arith
        have upperThird : succ(succ(i)) ≤ i + succ(succ(m)) by arith
        have signThird := signs with succ(succ(i)), thirdIn, lowerThird,
          upperThird, thirdNonzero
        have products := realSign.product_congr at f(i), f(succ(succ(i))),
          g(i), g(succ(succ(i))) with signI, signThird
        have negativeSign := realSign.of_negative at f(i) * f(succ(succ(i)))
          with product
        rw negativeSign at products
        have gProduct := (realSign.eq_neg_one_iff at
          g(i) * g(succ(succ(i)))).forward with products
        have gStep := signVariations.triple_opposite at g(i), g(succ(i)),
          g(succ(succ(i))), coefficientWindow(g, succ(succ(succ(i))), m) with
          restG, gProduct
        have fStep := signVariations.triple_opposite at f(i), f(succ(i)),
          f(succ(succ(i))), coefficientWindow(f, succ(succ(succ(i))), m) with
          restF, product
        have shiftTwo : i + 2 = succ(succ(i)) by ring
        have sumShift : m + 2 = succ(succ(m)) by ring
        rw ← sumShift at shifted
        have startNonzero : f(i + 2) ≠ (0:R)
          rw shiftTwo
          exact thirdNonzero
        have rest := SturmWindow.shift at f, g, i, m, 2 with shifted,
          startNonzero
        rw shiftTwo at rest
        have same := short with succ(succ(i)), thirdIn, rest
        rw [coefficientWindow, coefficientWindow] at same
        rw [coefficientWindow, coefficientWindow, coefficientWindow,
          coefficientWindow, coefficientWindow, coefficientWindow]
        rw [fStep, gStep, same]
      . have lowerNext : i ≤ succ(i) by arith
        have upperNext : succ(i) ≤ i + succ(succ(m)) by arith
        have signNext := signs with succ(i), nextIn, lowerNext, upperNext,
          middle
        have gNextNonzero := realSign.nonzero_of_sign_eq at f(succ(i)),
          g(succ(i)) with middle, signNext
        have tailF := coefficientWindow.closed at ℝ, f, succ(succ(i)), succ(m)
          with fFunction
        have tailG := coefficientWindow.closed at ℝ, g, succ(succ(i)), succ(m)
          with gFunction
        have fStep := signVariations.cons_cons_indicator at f(i), f(succ(i)),
          coefficientWindow(f, succ(succ(i)), succ(m)) with first, middle,
          tailF
        have gStep := signVariations.cons_cons_indicator at g(i), g(succ(i)),
          coefficientWindow(g, succ(succ(i)), succ(m)) with gFirst,
          gNextNonzero, tailG
        have products := realSign.product_congr at f(i), f(succ(i)), g(i),
          g(succ(i)) with signI, signNext
        have indicators := signChangeIndicator.congr at g(i), g(succ(i)), f(i),
          f(succ(i)) with products
        have shiftOne : i + 1 = succ(i) by ring
        have sumShift : succ(m) + 1 = succ(succ(m)) by ring
        rw ← sumShift at shifted
        have startNonzero : f(i + 1) ≠ (0:R)
          rw shiftOne
          exact middle
        have rest := SturmWindow.shift at f, g, i, succ(m), 1 with shifted,
          startNonzero
        rw shiftOne at rest
        have same := long with succ(i), nextIn, rest
        have unfoldF : coefficientWindow(f, i, succ(succ(succ(m)))) =
            f(i) :: f(succ(i)) :: coefficientWindow(f, succ(succ(i)), succ(m))
          rw [coefficientWindow, coefficientWindow]
        have unfoldG : coefficientWindow(g, i, succ(succ(succ(m)))) =
            g(i) :: g(succ(i)) :: coefficientWindow(g, succ(succ(i)), succ(m))
          rw [coefficientWindow, coefficientWindow]
        have tailUnfoldF : coefficientWindow(f, succ(i), succ(succ(m))) =
            f(succ(i)) :: coefficientWindow(f, succ(succ(i)), succ(m))
          rw coefficientWindow
        have tailUnfoldG : coefficientWindow(g, succ(i), succ(succ(m))) =
            g(succ(i)) :: coefficientWindow(g, succ(succ(i)), succ(m))
          rw coefficientWindow
        rw [tailUnfoldG, tailUnfoldF] at same
        rw [unfoldG, unfoldF, fStep, gStep, indicators, same]

theorem signVariations.window_congr (f g : Set) (i n : Nat)
  requires fFunction : f : ℕ → ℝ
  requires gFunction : g : ℕ → ℝ
  requires window : SturmWindow(f, g, i, n)
  shows signVariations(coefficientWindow(g, i, succ(n))) =
    signVariations(coefficientWindow(f, i, succ(n)))
proof
  have pair := signVariations.window_congr_pair at f, g, n with fFunction,
    gFunction
  exact pair.left with i, window

section Polynomials
variable (leading cs : Set)
hypothesis initial : Real(leading)
hypothesis coefficients : List(ℝ, cs)

-- The state at k is the pair of consecutive terms (p_k, p_{k+1}).
def sturmState (k : Nat) → Set
  | zero => (sturmNormal(leading, cs),
      sturmNormal(realDerivativeLeading(leading, cs), realDerivativeList(cs)))
  | succ(k) => (snd(sturmState(k)),
      sturmStep(fst(sturmState(k)), snd(sturmState(k))))

def sturmPair (k : Nat) : Set := fst(sturmState(k))
def sturmLeading (k : Nat) : Set := fst(sturmPair(k))
def sturmLower (k : Nat) : Set := snd(sturmPair(k))

-- The indices after which the sequence has reached zero; the length of
-- the sequence is the index of its last nonzero term.
def sturmVanishing : Set := { k ∈ ℕ | sturmPair(k + 1) = (realZero, []) }
def sturmLength : Set := leastNatural(sturmVanishing)

theorem sturmState.zero_law
  shows sturmState(0) = (sturmNormal(leading, cs),
    sturmNormal(realDerivativeLeading(leading, cs), realDerivativeList(cs)))
proof
  rw sturmState

theorem sturmState.succ_law (k : Nat)
  shows sturmState(k + 1) = (snd(sturmState(k)),
    sturmStep(fst(sturmState(k)), snd(sturmState(k))))
proof
  have step : k + 1 = succ(k) := add.right_one at k
  rw [step, sturmState]

theorem sturmPair.succ_state (k : Nat)
  shows sturmPair(k + 1) = snd(sturmState(k))
proof
  unfold sturmPair
  rw [sturmState.succ_law, fst.pair]

theorem sturmState.data (k : Nat)
  shows SturmNormalPair(fst(sturmState(k))) ∧
    SturmNormalPair(snd(sturmState(k)))
proof
  induction k
  | zero =>
    have leadingIn : leading ∈ ℝ by exact initial
    have derivativeIn : realDerivativeLeading(leading, cs) ∈ ℝ by typecheck
    have derivativeList := realDerivativeList.list with coefficients
    have first := sturmNormal.normal_pair at leading, cs with leadingIn,
      coefficients
    have second := sturmNormal.normal_pair at
      realDerivativeLeading(leading, cs), realDerivativeList(cs) with
      derivativeIn, derivativeList
    rw [sturmState.zero_law, fst.pair, snd.pair]
    exact ⟨first, second⟩
  | succ(j) using ih =>
    have step := sturmStep.normal_pair with ih.left, ih.right
    have law := sturmState.succ_law at leading, cs, j with initial, coefficients
    rw add.right_one at law
    rw [law, fst.pair, snd.pair]
    exact ⟨ih.right, step⟩

theorem sturmPair.normal_pair (k : Nat)
  shows SturmNormalPair(sturmPair(k))
proof
  have data := sturmState.data at leading, cs, k with initial, coefficients
  unfold sturmPair
  exact data.left

theorem sturmPair.data (k : Nat)
  shows sturmLeading(k) ∈ ℝ ∧ List(ℝ, sturmLower(k))
proof
  have normal := sturmPair.normal_pair at leading, cs, k with initial,
    coefficients
  rcases normal with ⟨leadingIn, lowerList, shape, eta⟩
  unfold sturmLeading
  unfold sturmLower
  exact ⟨leadingIn, lowerList⟩

theorem sturmPair.pair_data (k : Nat)
  shows fst(sturmPair(k)) ∈ ℝ ∧ List(ℝ, snd(sturmPair(k)))
proof
  have normal := sturmPair.normal_pair at leading, cs, k with initial,
    coefficients
  rcases normal with ⟨leadingIn, lowerList, shape, eta⟩
  exact ⟨leadingIn, lowerList⟩

theorem sturmPair.normal_all (k : Nat)
  shows sturmLeading(k) ≠ (0:R) ∨
    (sturmLeading(k) = (0:R) ∧ sturmLower(k) = [])
proof
  have normal := sturmPair.normal_pair at leading, cs, k with initial,
    coefficients
  rcases normal with ⟨leadingIn, lowerList, shape, eta⟩
  unfold sturmLeading
  unfold sturmLower
  exact shape

theorem sturmPair.eta (k : Nat)
  shows sturmPair(k) = (sturmLeading(k), sturmLower(k))
proof
  have normal := sturmPair.normal_pair at leading, cs, k with initial,
    coefficients
  rcases normal with ⟨leadingIn, lowerList, shape, eta⟩
  unfold sturmLeading
  unfold sturmLower
  exact eta

theorem sturmPair.zero_all
  shows sturmPair(0) = sturmNormal(leading, cs)
proof
  unfold sturmPair
  rw [sturmState.zero_law, fst.pair]

theorem sturmPair.one_all
  shows sturmPair(1) =
    sturmNormal(realDerivativeLeading(leading, cs), realDerivativeList(cs))
proof
  have law := sturmPair.succ_state at leading, cs, 0 with initial, coefficients
  have one : 0 + 1 = 1 by ring
  rw one at law
  rw [law, sturmState.zero_law, snd.pair]

theorem sturmPair.succ_succ_all (k : Nat)
  shows sturmPair(k + 2) = sturmStep(sturmPair(k), sturmPair(k + 1))
proof
  have law := sturmPair.succ_state at leading, cs, k + 1 with initial,
    coefficients
  have two : k + 1 + 1 = k + 2 by ring
  rw two at law
  have state := sturmState.succ_law at leading, cs, k with initial, coefficients
  have next := sturmPair.succ_state at leading, cs, k with initial, coefficients
  rw [law, state, snd.pair, next]
  unfold sturmPair
  rfl

-- Once a term is zero, so are all the later ones.
theorem sturmPair.zero_step (k : Nat)
  requires vanished : sturmPair(k + 1) = (realZero, [])
  shows sturmPair(k + 2) = (realZero, [])
proof
  have law := sturmPair.succ_succ_all at leading, cs, k with initial,
    coefficients
  rw [law, vanished, sturmStep.zero_second]

theorem sturmPair.zero_of_leading (k : Nat)
  requires zero : sturmLeading(k) = (0:R)
  shows sturmPair(k) = (realZero, [])
proof
  have normal := sturmPair.normal_pair at leading, cs, k with initial,
    coefficients
  have zeroFst : fst(sturmPair(k)) = realZero
    unfold sturmLeading at zero
    exact zero
  exact SturmNormalPair.zero_of_leading with normal, zeroFst

-- The degrees strictly decrease while the terms are nonzero.
theorem sturmLower.length_step (k : Nat)
  requires nonzero : sturmPair(k + 2) ≠ (realZero, [])
  shows length{ℝ}(sturmLower(k + 2)) < length{ℝ}(sturmLower(k + 1))
proof
  have law := sturmPair.succ_succ_all at leading, cs, k with initial,
    coefficients
  have dataK := sturmPair.pair_data at leading, cs, k with initial,
    coefficients
  have dataNext := sturmPair.pair_data at leading, cs, k + 1 with initial,
    coefficients
  have leadingNonzero : sturmLeading(k + 1) ≠ (0:R)
    intro zero
    have vanished := sturmPair.zero_of_leading at leading, cs, k + 1 with
      initial, coefficients, zero
    have next := sturmPair.zero_step at leading, cs, k with initial,
      coefficients, vanished
    exact nonzero with next
  have fstNonzero : fst(sturmPair(k + 1)) ≠ realZero
    unfold sturmLeading at leadingNonzero
    exact leadingNonzero
  rw sturmStep.of_nonzero at sturmPair(k), sturmPair(k + 1) with fstNonzero
    at law
  have field := RealSquarefree.field
  have remainder := hornerDivRemainder.data at ℝ, realAdd, realZero, realNeg,
    realMul, realOne, fst(sturmPair(k + 1)), fst(sturmPair(k)),
    snd(sturmPair(k + 1)), snd(sturmPair(k)) with
    dataNext.right, dataK.right, field, dataNext.left, fstNonzero, dataK.left
  have negated := hornerNeg.data at ℝ, realAdd, realZero, realNeg, realMul,
    realOne, hornerDivRemainder{ℝ}(realAdd, realZero, realNeg, realMul,
      realOne, fst(sturmPair(k + 1)), fst(sturmPair(k)), snd(sturmPair(k + 1)),
      snd(sturmPair(k))) with
    remainder.left, reals.comm_ring
  have nonempty : hornerNeg{ℝ}(realNeg, hornerDivRemainder{ℝ}(realAdd,
      realZero, realNeg, realMul, realOne, fst(sturmPair(k + 1)),
      fst(sturmPair(k)), snd(sturmPair(k + 1)), snd(sturmPair(k)))) ≠ []
    intro empty
    have trimmed := hornerTrim.nil_pair with negated.left, empty
    rw [trimmed.left, trimmed.right] at law
    exact nonzero with law
  have shorter := hornerTrim.length_lt at ℝ, realZero, _ with negated.left,
    nonempty
  rw [negated.right, remainder.right] at shorter
  unfold sturmLower
  rw [law, snd.pair]
  exact shorter

theorem sturmLower.length_one
  shows sturmPair(1) = (realZero, []) ∨
    length{ℝ}(sturmLower(1)) < length{ℝ}(cs)
proof
  have zeroIn : realZero ∈ ℝ by typecheck
  have leadingIn : leading ∈ ℝ by exact initial
  have law := sturmPair.one_all at leading, cs with initial, coefficients
  have derivativeIn : realDerivativeLeading(leading, cs) ∈ ℝ by typecheck
  have derivativeList := realDerivativeList.list with coefficients
  have derivativeLength := realDerivativeList.length with coefficients
  have full := hornerFullList.list with derivativeList, derivativeIn
  have fullLength := hornerFullList.length at ℝ,
    realDerivativeLeading(leading, cs), _ with derivativeList
  have shape := List.cases with coefficients
  cases shape with empty | cons
  . left
    have listNil : realDerivativeList(cs) = []
      rw empty
      unfold realDerivativeList
      exact hornerDerivativeList.nil at ℝ, realAdd, realZero, realOne, realMul
    have leadingNil : realDerivativeLeading(leading, cs) = realZero
      rw empty
      unfold realDerivativeLeading
      exact hornerDerivativeLeading.nil at ℝ, realAdd, realZero, realNeg,
        realMul, realOne, leading with reals.comm_ring, leadingIn
    have top := hornerFullList.coefficient_top at ℝ, realAdd, realZero, realNeg,
      realMul, realOne, realDerivativeLeading(leading, cs),
      realDerivativeList(cs) with derivativeList, reals.comm_ring, derivativeIn
    rw [listNil, leadingNil] at top
    rw [listNil, leadingNil] at full
    rw [listNil, leadingNil] at fullLength
    rw length.nil at top
    rw length.nil at fullLength
    have vanish : ∀ j, Nat(j) → listCoefficient{ℝ}(realZero,
        hornerFullList{ℝ}(realZero, []), j) = realZero
      intros j jNat
      have shapeJ := natural.zero_or_successor at j with jNat
      cases shapeJ with jZero | jSucc
      . rw jZero
        exact top
      . obtain ⟨i, iNat, jEq⟩ := jSucc
        have beyond : length{ℝ}(hornerFullList{ℝ}(realZero, [])) ≤ j
          rw [fullLength, jEq]
          arith
        exact RealSquarefree.coefficient_beyond with full, jNat, beyond
    have characterization := hornerTrim.zero_iff at ℝ, realZero,
      hornerFullList{ℝ}(realZero, []) with full
    have zero := characterization.backward with vanish
    have normal := hornerTrim.normal at ℝ, realZero, _ with full
    cases normal with nonzero | both
    . exfalso
      exact nonzero with zero
    . rw law
      unfold sturmNormal
      unfold normalLeading
      unfold normalLower
      rw [listNil, leadingNil, both.left, both.right]
  . right
    obtain ⟨c, cIn, tail, tailList, csEq⟩ := cons
    have lengthCons : length{ℝ}(cs) = succ(length{ℝ}(tail))
      rw csEq
      exact length.cons at ℝ, c, tail with tailList, cIn
    have predecessor := predecessor.succ at length{ℝ}(tail)
    rw [lengthCons, predecessor] at derivativeLength
    rw derivativeLength at fullLength
    have nonempty : hornerFullList{ℝ}(realDerivativeLeading(leading, cs),
        realDerivativeList(cs)) ≠ []
      intro empty
      rw [empty, length.nil] at fullLength
      symm at fullLength
      exact succ.ne_zero at length{ℝ}(tail) with fullLength
    have shorter := hornerTrim.length_lt at ℝ, realZero, _ with full, nonempty
    rw [fullLength, ← lengthCons] at shorter
    unfold sturmLower
    rw law
    unfold sturmNormal
    unfold normalLower
    rw snd.pair
    exact shorter

-- The descent: after k + 1 steps the term is zero or its degree is at most
-- the degree of p less k + 1.
theorem sturmPair.descent (k : Nat)
  shows sturmPair(k + 1) = (realZero, []) ∨
    length{ℝ}(sturmLower(k + 1)) + (k + 1) ≤ length{ℝ}(cs)
proof
  induction k
  | zero =>
    have one : 0 + 1 = 1 by ring
    rw one
    have first := sturmLower.length_one at leading, cs with initial,
      coefficients
    cases first with vanished | shorter
    . left
      exact vanished
    . right
      arith
  | succ(j) using ih =>
    have two : succ(j) + 1 = j + 2 by ring
    rw two
    cases ih with vanished | bound
    . left
      exact sturmPair.zero_step at leading, cs, j with initial, coefficients,
        vanished
    . by_cases next : sturmPair(j + 2) = (realZero, [])
      . left
        exact next
      . right
        have shorter := sturmLower.length_step at leading, cs, j with initial,
          coefficients, next
        arith

theorem sturmVanishing.member_length
  shows length{ℝ}(cs) ∈ sturmVanishing
proof
  have descent := sturmPair.descent at leading, cs, length{ℝ}(cs) with
    initial, coefficients
  have lengthIn : length{ℝ}(cs) ∈ ℕ by typecheck
  apply sturmVanishing.membership.backward
  cases descent with vanished | bound
  . exact ⟨lengthIn, vanished⟩
  . exfalso
    arith

theorem sturmVanishing.subset_naturals
  shows sturmVanishing ⊆ ℕ
proof
  intros k member
  obtain ⟨kIn, vanished⟩ := sturmVanishing.membership.forward with member
  exact kIn

theorem sturmVanishing.nonempty_all
  shows Nonempty(sturmVanishing)
proof
  have member := sturmVanishing.member_length at leading, cs with initial,
    coefficients
  exact ⟨length{ℝ}(cs), member⟩

theorem sturmLength.nat
  shows Nat(sturmLength)
proof
  have inhabited := sturmVanishing.nonempty_all at leading, cs with initial,
    coefficients
  have naturals := sturmVanishing.subset_naturals at leading, cs with initial,
    coefficients
  have member := leastNatural.member with inhabited, naturals
  unfold sturmLength
  have inNaturals := naturals with leastNatural(sturmVanishing), member
  exact nat.omega.backward with inNaturals

theorem sturmLength.vanishes
  shows sturmPair(sturmLength + 1) = (realZero, [])
proof
  have inhabited := sturmVanishing.nonempty_all at leading, cs with initial,
    coefficients
  have naturals := sturmVanishing.subset_naturals at leading, cs with initial,
    coefficients
  have member := leastNatural.member with inhabited, naturals
  obtain ⟨kIn, vanished⟩ := sturmVanishing.membership.forward with member
  unfold sturmLength
  exact vanished

theorem sturmLength.le_of_vanishing (k : Nat)
  requires vanished : sturmPair(k + 1) = (realZero, [])
  shows sturmLength ≤ k
proof
  have inhabited := sturmVanishing.nonempty_all at leading, cs with initial,
    coefficients
  have naturals := sturmVanishing.subset_naturals at leading, cs with initial,
    coefficients
  have kIn : k ∈ ℕ by typecheck
  have member : k ∈ sturmVanishing
    apply sturmVanishing.membership.backward
    exact ⟨kIn, vanished⟩
  unfold sturmLength
  exact leastNatural.least with inhabited, naturals, member

defgraph sturmValues (X : Real) (k ∈ ℕ) : ℝ :=
  horner(realRing, sturmLeading(k), X, sturmLower(k))
proof
  have data := sturmPair.data at leading, cs, k with initial, coefficients
  have carrier := realRing.carrierOf
  have realX : X ∈ ℝ by simp [Real]
  have leadingIn : sturmLeading(k) ∈ Ring.carrier(realRing)
    rw carrier
    exact data.left
  have xIn : X ∈ Ring.carrier(realRing)
    rw carrier
    exact realX
  have listIn : List(Ring.carrier(realRing), sturmLower(k))
    rw carrier
    exact data.right
  have closed := horner.mem at realRing, sturmLeading(k), X, sturmLower(k) with
    realRing.comm_ring, leadingIn, xIn, listIn
  rwa carrier at closed

def sturmValueList (X : Real) : Set :=
  coefficientWindow(sturmValues(X), 0, succ(sturmLength))
def sturmCount (X : Real) : Set := signVariations(sturmValueList(X))

instance sturmLeading.real (k : Nat)
  shows Real(sturmLeading(k))
proof
  have data := sturmPair.data at leading, cs, k with initial, coefficients
  exact data.left

instance sturmLower.list (k : Nat)
  shows List(ℝ, sturmLower(k))
proof
  have data := sturmPair.data at leading, cs, k with initial, coefficients
  exact data.right

theorem sturmValueList.list_all (X : Real)
  shows List(ℝ, sturmValueList(X))
proof
  have lengthNat := sturmLength.nat at leading, cs with initial, coefficients
  have function := sturmValues.function at leading, cs, X with initial,
    coefficients
  unfold sturmValueList
  exact coefficientWindow.closed at ℝ, sturmValues(X), 0, succ(sturmLength)
    with function

theorem sturmValueList.length_all (X : Real)
  shows length{ℝ}(sturmValueList(X)) = succ(sturmLength)
proof
  have lengthNat := sturmLength.nat at leading, cs with initial, coefficients
  have function := sturmValues.function at leading, cs, X with initial,
    coefficients
  unfold sturmValueList
  exact coefficientWindow.length at ℝ, sturmValues(X), 0, succ(sturmLength)
    with function

instance sturmCount.natural (X : Real)
  shows Nat(sturmCount(X))
proof
  have list := sturmValueList.list_all at leading, cs, X with initial,
    coefficients
  unfold sturmCount
  typecheck

-- The k-th value is the polynomial function of the k-th term.
theorem sturmValues.eq_function (X : Real) (k : Nat)
  shows sturmValues(X)(k) = hornerFunction(sturmLeading(k), sturmLower(k))(X)
proof
  have data := sturmPair.data at leading, cs, k with initial, coefficients
  have realX : X ∈ ℝ by simp [Real]
  have value := sturmValues.value at leading, cs, X, k with initial,
    coefficients
  have function := hornerFunction.value at sturmLeading(k), sturmLower(k), X
    with data.left, data.right, realX
  rw [value, function]

theorem sturmValues.real_all (X : Real) (k : Nat)
  shows Real(sturmValues(X)(k))
proof
  have function := sturmValues.function at leading, cs, X with initial,
    coefficients
  have kIn : k ∈ ℕ by typecheck
  exact FunctionBetween.apply_closed with function, kIn

-- The terms after the first zero stay zero.
theorem sturmPair.zero_from (j : Nat)
  shows ∀ m, Nat(m) → sturmPair(m + 1) = (realZero, []) →
    sturmPair(m + 1 + j) = (realZero, [])
proof
  induction j
  | zero =>
    intros m mNat vanished
    have same : m + 1 + 0 = m + 1 by ring
    rw same
    exact vanished
  | succ(i) using ih =>
    intros m mNat vanished
    have previous := ih with m, mNat, vanished
    have shift : m + 1 + succ(i) = (m + i) + 2 by ring
    have shiftPrevious : m + 1 + i = (m + i) + 1 by ring
    rw shiftPrevious at previous
    rw shift
    exact sturmPair.zero_step at leading, cs, m + i with initial, coefficients,
      previous

section Nonzero
hypothesis nonzero : leading ≠ (0:R)

theorem sturmPair.zero
  shows sturmPair(0) = (leading, cs)
proof
  have leadingIn : leading ∈ ℝ by exact initial
  have same := normalLeading.of_nonzero at ℝ, realZero, leading, cs with
    coefficients, leadingIn, nonzero
  have law := sturmPair.zero_all at leading, cs with initial, coefficients
  rw law
  unfold sturmNormal
  rw [same.left, same.right]

theorem sturmPair.one
  shows sturmPair(1) =
    sturmNormal(realDerivativeLeading(leading, cs), realDerivativeList(cs))
proof
  exact sturmPair.one_all at leading, cs with initial, coefficients

theorem sturmPair.succ_succ (k : Nat)
  shows sturmPair(k + 2) = sturmStep(sturmPair(k), sturmPair(k + 1))
proof
  exact sturmPair.succ_succ_all at leading, cs, k with initial, coefficients

-- Every term is in normal form.
theorem sturmPair.normal (k : Nat)
  shows sturmLeading(k) ≠ (0:R) ∨
    (sturmLeading(k) = (0:R) ∧ sturmLower(k) = [])
proof
  exact sturmPair.normal_all at leading, cs, k with initial, coefficients

-- The sequence reaches zero, since the degrees strictly decrease.
theorem sturmVanishing.nonempty
  shows Nonempty(sturmVanishing)
proof
  exact sturmVanishing.nonempty_all at leading, cs with initial, coefficients

theorem sturmLength.natural
  shows Nat(sturmLength)
proof
  exact sturmLength.nat at leading, cs with initial, coefficients

theorem sturmLength.le_length
  shows sturmLength ≤ length{ℝ}(cs)
proof
  have member := sturmVanishing.member_length at leading, cs with initial,
    coefficients
  obtain ⟨lengthIn, vanished⟩ := sturmVanishing.membership.forward with member
  exact sturmLength.le_of_vanishing at leading, cs, length{ℝ}(cs) with initial,
    coefficients, vanished

theorem sturmPair.zero_above_length (k : Nat)
  requires above : sturmLength < k
  shows sturmPair(k) = (realZero, [])
proof
  have lengthNat := sturmLength.nat at leading, cs with initial, coefficients
  have first := sturmLength.vanishes at leading, cs with initial, coefficients
  obtain ⟨j, jNat, kEq⟩ := Less.exists_add_one with above
  have shift : sturmLength + j + 1 = sturmLength + 1 + j by ring
  rw [kEq, shift]
  exact sturmPair.zero_from at leading, cs, j with initial, coefficients,
    sturmLength, lengthNat, first

theorem sturmLeading.nonzero_below_length (k : Nat)
  requires below : k ≤ sturmLength
  shows sturmLeading(k) ≠ (0:R)
proof
  intro zero
  have vanished := sturmPair.zero_of_leading at leading, cs, k with initial,
    coefficients, zero
  have shape := natural.zero_or_successor at k with *
  cases shape with kZero | kSucc
  . have law := sturmPair.zero at leading, cs with initial, coefficients,
      nonzero
    rw [kZero, law] at vanished
    have first : fst((leading, cs)) = fst((realZero, [])) by rw vanished
    rw [fst.pair, fst.pair] at first
    exact nonzero with first
  . obtain ⟨j, jNat, kEq⟩ := kSucc
    have one : succ(j) = j + 1 by ring
    rw [kEq, one] at vanished
    have le := sturmLength.le_of_vanishing at leading, cs, j with initial,
      coefficients, vanished
    rw [kEq, one] at below
    arith

theorem sturmLower.length_decreasing (k : Nat)
  requires below : k + 1 ≤ sturmLength
  shows length{ℝ}(sturmLower(k + 1)) < length{ℝ}(sturmLower(k))
proof
  have lengthNat := sturmLength.nat at leading, cs with initial, coefficients
  have nonzeroNext : sturmPair(k + 1) ≠ (realZero, [])
    intro vanished
    have le := sturmLength.le_of_vanishing at leading, cs, k with initial,
      coefficients, vanished
    arith
  have shape := natural.zero_or_successor at k with *
  cases shape with kZero | kSucc
  . have one : 0 + 1 = 1 by ring
    rw [kZero, one] at nonzeroNext
    rw [kZero, one]
    have first := sturmLower.length_one at leading, cs with initial,
      coefficients
    cases first with vanished | shorter
    . exfalso
      exact nonzeroNext with vanished
    . have law := sturmPair.zero at leading, cs with initial, coefficients,
        nonzero
      have lowerZero : sturmLower(0) = cs
        unfold sturmLower
        rw [law, snd.pair]
      rw lowerZero
      exact shorter
  . obtain ⟨j, jNat, kEq⟩ := kSucc
    have two : succ(j) + 1 = j + 2 by ring
    have one : succ(j) = j + 1 by ring
    rw [kEq, two] at nonzeroNext
    rw [kEq, two, one]
    exact sturmLower.length_step at leading, cs, j with initial, coefficients,
      nonzeroNext

theorem sturmValues.zero (X : Real)
  shows sturmValues(X)(0) = hornerFunction(leading, cs)(X)
proof
  have same := sturmValues.eq_function at leading, cs, X, 0 with initial,
    coefficients
  have law := sturmPair.zero at leading, cs with initial, coefficients, nonzero
  have leadingZero : sturmLeading(0) = leading
    unfold sturmLeading
    rw [law, fst.pair]
  have lowerZero : sturmLower(0) = cs
    unfold sturmLower
    rw [law, snd.pair]
  rw [same, leadingZero, lowerZero]

theorem sturmValues.one (X : Real)
  shows sturmValues(X)(1) =
    hornerFunction(realDerivativeLeading(leading, cs),
      realDerivativeList(cs))(X)
proof
  have same := sturmValues.eq_function at leading, cs, X, 1 with initial,
    coefficients
  have law := sturmPair.one at leading, cs with initial, coefficients, nonzero
  have realX : X ∈ ℝ by simp [Real]
  have zeroIn : realZero ∈ ℝ by typecheck
  have derivativeIn : realDerivativeLeading(leading, cs) ∈ ℝ by typecheck
  have derivativeList := realDerivativeList.list at leading, cs with initial,
    coefficients
  have full := hornerFullList.list with derivativeList, derivativeIn
  have normalIn : normalLeading{ℝ}(realZero, realDerivativeLeading(leading, cs),
      realDerivativeList(cs)) ∈ ℝ
    unfold normalLeading
    exact hornerTrimLeading.mem with full, zeroIn
  have normalList : List(ℝ, normalLower{ℝ}(realZero,
      realDerivativeLeading(leading, cs), realDerivativeList(cs)))
    unfold normalLower
    exact hornerTrimLower.list at ℝ, realZero, _ with full
  have leadingOne : sturmLeading(1) = normalLeading{ℝ}(realZero,
      realDerivativeLeading(leading, cs), realDerivativeList(cs))
    unfold sturmLeading
    rw law
    unfold sturmNormal
    rw fst.pair
  have lowerOne : sturmLower(1) = normalLower{ℝ}(realZero,
      realDerivativeLeading(leading, cs), realDerivativeList(cs))
    unfold sturmLower
    rw law
    unfold sturmNormal
    rw snd.pair
  have left := hornerFunction.value_at at normalLeading{ℝ}(realZero,
      realDerivativeLeading(leading, cs), realDerivativeList(cs)),
    normalLower{ℝ}(realZero, realDerivativeLeading(leading, cs),
      realDerivativeList(cs)), X with normalIn, normalList, realX
  have right := hornerFunction.value_at at realDerivativeLeading(leading, cs),
    realDerivativeList(cs), X with derivativeIn, derivativeList, realX
  have normal := hornerAt.normal at ℝ, realAdd, realZero, realNeg, realMul,
    realOne, realDerivativeLeading(leading, cs), X, realDerivativeList(cs) with
    derivativeList, reals.comm_ring, derivativeIn, realX
  rw [same, leadingOne, lowerOne, left, right, normal]

-- The division relation between three consecutive terms, as values.
theorem sturmValues.recurrence (k : Nat) (X : Real)
  requires below : k + 1 ≤ sturmLength
  shows ∃ Q ∈ ℝ, sturmValues(X)(k) =
    Q * sturmValues(X)(k + 1) - sturmValues(X)(k + 2)
proof
  have realX : X ∈ ℝ by simp [Real]
  have zeroIn : realZero ∈ ℝ by typecheck
  have field := RealSquarefree.field
  have law := sturmPair.succ_succ at leading, cs, k with initial, coefficients,
    nonzero
  have dataK := sturmPair.pair_data at leading, cs, k with initial,
    coefficients
  have dataNext := sturmPair.pair_data at leading, cs, k + 1 with initial,
    coefficients
  have leadingNonzero := sturmLeading.nonzero_below_length at leading, cs,
    k + 1 with initial, coefficients, nonzero, below
  have fstNonzero : fst(sturmPair(k + 1)) ≠ realZero
    unfold sturmLeading at leadingNonzero
    exact leadingNonzero
  rw sturmStep.of_nonzero at sturmPair(k), sturmPair(k + 1) with fstNonzero
    at law
  have sameK := sturmValues.eq_function at leading, cs, X, k with initial,
    coefficients
  have sameNext := sturmValues.eq_function at leading, cs, X, k + 1 with
    initial, coefficients
  have sameLast := sturmValues.eq_function at leading, cs, X, k + 2 with
    initial, coefficients
  have valueK := hornerFunction.value_at at sturmLeading(k), sturmLower(k), X
    with *
  have valueNext := hornerFunction.value_at at sturmLeading(k + 1),
    sturmLower(k + 1), X with *
  have valueLast := hornerFunction.value_at at sturmLeading(k + 2),
    sturmLower(k + 2), X with *
  have division := hornerDivision.value at ℝ, realAdd, realZero, realNeg,
    realMul, realOne, fst(sturmPair(k + 1)), fst(sturmPair(k)), X,
    snd(sturmPair(k + 1)), snd(sturmPair(k)) with
    dataNext.right, dataK.right, field, dataNext.left, fstNonzero, dataK.left,
    realX
  have remainder := hornerDivRemainder.data at ℝ, realAdd, realZero, realNeg,
    realMul, realOne, fst(sturmPair(k + 1)), fst(sturmPair(k)),
    snd(sturmPair(k + 1)), snd(sturmPair(k)) with
    dataNext.right, dataK.right, field, dataNext.left, fstNonzero, dataK.left
  have quotient := hornerDivQuotient.data at ℝ, realAdd, realZero, realNeg,
    realMul, realOne, fst(sturmPair(k + 1)), fst(sturmPair(k)),
    snd(sturmPair(k + 1)), snd(sturmPair(k)) with
    dataNext.right, dataK.right, field, dataNext.left, fstNonzero, dataK.left
  have negated := hornerNeg.data at ℝ, realAdd, realZero, realNeg, realMul,
    realOne, hornerDivRemainder{ℝ}(realAdd, realZero, realNeg, realMul,
      realOne, fst(sturmPair(k + 1)), fst(sturmPair(k)), snd(sturmPair(k + 1)),
      snd(sturmPair(k))) with
    remainder.left, reals.comm_ring
  have trimPoly := hornerPoly.trim at ℝ, realAdd, realZero, realNeg, realMul,
    realOne, hornerNeg{ℝ}(realNeg, hornerDivRemainder{ℝ}(realAdd, realZero,
      realNeg, realMul, realOne, fst(sturmPair(k + 1)), fst(sturmPair(k)),
      snd(sturmPair(k + 1)), snd(sturmPair(k)))) with
    negated.left, reals.comm_ring
  have trimLeadingIn := hornerTrimLeading.mem with negated.left, zeroIn
  have trimLowerList := hornerTrimLower.list at ℝ, realZero, _ with
    negated.left
  have trimValue := hornerAt.congr_of_poly with trimLowerList, negated.left,
    reals.comm_ring, trimLeadingIn, zeroIn, realX, trimPoly
  have negValue := hornerNeg.value at ℝ, realAdd, realZero, realNeg, realMul,
    realOne, realZero, X, hornerDivRemainder{ℝ}(realAdd, realZero, realNeg,
      realMul, realOne, fst(sturmPair(k + 1)), fst(sturmPair(k)),
      snd(sturmPair(k + 1)), snd(sturmPair(k))) with
    remainder.left, reals.comm_ring, zeroIn, realX
  rw realNegValue.zero at negValue
  have quotientReal := hornerAt.closed at ℝ, realAdd, realZero, realNeg,
    realMul, realOne, realZero, X, hornerDivQuotient{ℝ}(realAdd, realZero,
      realNeg, realMul, realOne, fst(sturmPair(k + 1)), fst(sturmPair(k)),
      snd(sturmPair(k + 1)), snd(sturmPair(k))) with
    quotient.left, reals.comm_ring, zeroIn, realX
  have remainderReal := hornerAt.closed at ℝ, realAdd, realZero, realNeg,
    realMul, realOne, realZero, X, hornerDivRemainder{ℝ}(realAdd, realZero,
      realNeg, realMul, realOne, fst(sturmPair(k + 1)), fst(sturmPair(k)),
      snd(sturmPair(k + 1)), snd(sturmPair(k))) with
    remainder.left, reals.comm_ring, zeroIn, realX
  have nextReal := hornerAt.closed at ℝ, realAdd, realZero, realNeg,
    realMul, realOne, fst(sturmPair(k + 1)), X, snd(sturmPair(k + 1)) with
    dataNext.right, reals.comm_ring, dataNext.left, realX
  witness hornerAt{ℝ}(realAdd, realMul, realZero, X, hornerDivQuotient{ℝ}(
    realAdd, realZero, realNeg, realMul, realOne, fst(sturmPair(k + 1)),
    fst(sturmPair(k)), snd(sturmPair(k + 1)), snd(sturmPair(k))))
  refine ⟨quotientReal, _⟩
  rw [sameK, sameNext, sameLast, valueK, valueNext, valueLast]
  unfold sturmLeading
  unfold sturmLower
  rw [law, fst.pair, snd.pair, trimValue, negValue, division]
  have realQ : Real(hornerAt{ℝ}(realAdd, realMul, realZero, X,
    hornerDivQuotient{ℝ}(realAdd, realZero, realNeg, realMul, realOne,
      fst(sturmPair(k + 1)), fst(sturmPair(k)), snd(sturmPair(k + 1)),
      snd(sturmPair(k))))) by exact quotientReal
  have realRemainder : Real(hornerAt{ℝ}(realAdd, realMul, realZero, X,
    hornerDivRemainder{ℝ}(realAdd, realZero, realNeg, realMul, realOne,
      fst(sturmPair(k + 1)), fst(sturmPair(k)), snd(sturmPair(k + 1)),
      snd(sturmPair(k))))) by exact remainderReal
  have realNext : Real(hornerAt{ℝ}(realAdd, realMul, fst(sturmPair(k + 1)), X,
    snd(sturmPair(k + 1)))) by exact nextReal
  ring

-- At a root of a middle term, its neighbors are negatives of each other.
theorem sturmValues.neighbors_at_root (k : Nat) (X : Real)
  requires below : k + 2 ≤ sturmLength
  requires middle : sturmValues(X)(k + 1) = (0:R)
  shows sturmValues(X)(k) = -sturmValues(X)(k + 2)
proof
  have lengthNat := sturmLength.natural at leading, cs with initial,
    coefficients, nonzero
  have bound : k + 1 ≤ sturmLength by arith
  obtain ⟨Q, realQ, relation⟩ := sturmValues.recurrence at leading, cs, k, X
    with initial, coefficients, nonzero, bound
  have realLast := sturmValues.real_all at leading, cs, X, k + 2 with initial,
    coefficients
  have typedQ : Real(Q) by exact realQ
  rw [relation, middle]
  ring

-- The values beyond the length are zero.
theorem sturmValues.above_length (k : Nat) (X : Real)
  requires above : sturmLength < k
  shows sturmValues(X)(k) = (0:R)
proof
  have realX : X ∈ ℝ by simp [Real]
  have zeroIn : realZero ∈ ℝ by typecheck
  have nilList : List(ℝ, []) by typecheck
  have beyond := sturmPair.zero_above_length at leading, cs, k with initial,
    coefficients, nonzero, above
  have same := sturmValues.eq_function at leading, cs, X, k with initial,
    coefficients
  have leadingZero : sturmLeading(k) = realZero
    unfold sturmLeading
    rw [beyond, fst.pair]
  have lowerNil : sturmLower(k) = []
    unfold sturmLower
    rw [beyond, snd.pair]
  rw [same, leadingZero, lowerNil]
  exact hornerFunction.nil at realZero, [], X with zeroIn, nilList, realX

-- Two consecutive zeros propagate down to p and p′.
theorem sturmValues.consecutive_zero (X : Real) (k : Nat)
  shows k ≤ sturmLength → sturmValues(X)(k) = (0:R) →
    sturmValues(X)(k + 1) = (0:R) →
    sturmValues(X)(0) = (0:R) ∧ sturmValues(X)(1) = (0:R)
proof
  induction k
  | zero =>
    intros bound zero one
    have oneIndex : 0 + 1 = 1 by ring
    rw oneIndex at one
    exact ⟨zero, one⟩
  | succ(j) using ih =>
    intros bound zeroJ oneJ
    have lengthNat := sturmLength.natural at leading, cs with initial,
      coefficients, nonzero
    have succEq : succ(j) = j + 1 by ring
    have two : succ(j) + 1 = j + 2 by ring
    rw two at oneJ
    rw succEq at zeroJ
    rw succEq at bound
    obtain ⟨Q, realQ, relation⟩ := sturmValues.recurrence at leading, cs, j, X
      with initial, coefficients, nonzero, bound
    rw [zeroJ, oneJ] at relation
    have typedQ : Real(Q) by exact realQ
    have valueJ : sturmValues(X)(j) = (0:R)
      rw relation
      ring
    have jBound : j ≤ sturmLength by arith
    exact ih with jBound, valueJ, zeroJ

-- At a point where p does not vanish, no two consecutive terms vanish, and
-- the last term does not vanish.
theorem sturmValues.no_consecutive_zero (X : Real) (k : Nat)
  requires nonroot : hornerFunction(leading, cs)(X) ≠ (0:R)
  requires below : k ≤ sturmLength
  requires zero : sturmValues(X)(k) = (0:R)
  shows sturmValues(X)(k + 1) ≠ (0:R)
proof
  intro next
  have both := sturmValues.consecutive_zero at leading, cs, X, k with initial,
    coefficients, nonzero, below, zero, next
  have first := sturmValues.zero at leading, cs, X with initial, coefficients,
    nonzero
  rw first at both
  exact nonroot with both.left

theorem sturmValues.last_nonzero (X : Real)
  requires nonroot : hornerFunction(leading, cs)(X) ≠ (0:R)
  shows sturmValues(X)(sturmLength) ≠ (0:R)
proof
  intro zero
  have lengthNat := sturmLength.natural at leading, cs with initial,
    coefficients, nonzero
  have above : sturmLength < sturmLength + 1 by arith
  have next := sturmValues.above_length at leading, cs, sturmLength + 1, X with
    initial, coefficients, nonzero, above
  have le : sturmLength ≤ sturmLength by arith
  have nonzeroNext := sturmValues.no_consecutive_zero at leading, cs, X,
    sturmLength with initial, coefficients, nonzero, nonroot, le, zero
  exact nonzeroNext with next

section Algebra
notation ring F := (ℝ, realAdd, realZero, realNeg, realMul, realOne)
notation ring P := F[oneVariable]

-- A common divisor of the divisor and the negated remainder divides the
-- dividend.
theorem HornerDivides.of_recurrence (g a b c : Set)
  (gs xs ds es qs rs : List(ℝ))
  requires gIn : g ∈ ℝ
  requires aIn : a ∈ ℝ
  requires bIn : b ∈ ℝ
  requires cIn : c ∈ ℝ
  requires relation : RealSquarefree.poly(a, xs) =
    P[RealSquarefree.poly(realZero, qs) * RealSquarefree.poly(b, ds) +
      RealSquarefree.poly(realZero, rs)]
  requires negation : RealSquarefree.poly(c, es) =
    P[-RealSquarefree.poly(realZero, rs)]
  requires dividesB : HornerDivides(ℝ, realAdd, realZero, realNeg, realMul,
    realOne, g, gs, b, ds)
  requires dividesC : HornerDivides(ℝ, realAdd, realZero, realNeg, realMul,
    realOne, g, gs, c, es)
  shows HornerDivides(ℝ, realAdd, realZero, realNeg, realMul, realOne, g, gs,
    a, xs)
proof
  have zeroIn : realZero ∈ ℝ := realZero.real
  have ringP := RealSquarefree.ring_P
  obtain ⟨us, usList, eqB⟩ := dividesB
  obtain ⟨vs, vsList, eqC⟩ := dividesC
  have mulData := hornerMulList.data at ℝ, realAdd, realZero, realNeg, realMul,
    realOne, realZero, realZero, qs, us with usList, reals.comm_ring,
    zeroIn, zeroIn
  have negData := hornerNeg.data at ℝ, realAdd, realZero, realNeg, realMul,
    realOne, vs with vsList, reals.comm_ring
  obtain ⟨ws, wsList, eqW⟩ := hornerPoly.exists_sum at ℝ, realAdd, realZero,
    realNeg, realMul, realOne,
    hornerMulList{ℝ}(realAdd, realZero, realMul, realZero, realZero, qs, us),
    hornerNeg{ℝ}(realNeg, vs) with mulData.left, negData.left, reals.comm_ring
  have mulList := hornerPoly.mul_lists at ℝ, realAdd, realZero, realNeg,
    realMul, realOne, qs, us with usList, reals.comm_ring
  have negList := hornerPoly.neg_list at ℝ, realAdd, realZero, realNeg,
    realMul, realOne, vs with vsList, reals.comm_ring
  have qIn := RealSquarefree.poly.member at realZero, qs with zeroIn
  have uIn := RealSquarefree.poly.member at realZero, us with zeroIn
  have vIn := RealSquarefree.poly.member at realZero, vs with zeroIn
  have rIn := RealSquarefree.poly.member at realZero, rs with zeroIn
  have gsIn := RealSquarefree.poly.member at g, gs with gIn
  unfold RealSquarefree.poly at relation
  unfold RealSquarefree.poly at negation
  unfold RealSquarefree.poly at qIn
  unfold RealSquarefree.poly at uIn
  unfold RealSquarefree.poly at vIn
  unfold RealSquarefree.poly at rIn
  unfold RealSquarefree.poly at gsIn
  have rsEq : hornerPoly{ℝ}(realAdd, realZero, realNeg, realMul, realOne,
      realZero, rs) =
      P[-(hornerPoly{ℝ}(realAdd, realZero, realNeg, realMul, realOne, realZero,
        vs) * hornerPoly{ℝ}(realAdd, realZero, realNeg, realMul, realOne, g,
        gs))]
    have step : P[-hornerPoly{ℝ}(realAdd, realZero, realNeg, realMul, realOne,
        realZero, rs)] =
        P[hornerPoly{ℝ}(realAdd, realZero, realNeg, realMul, realOne, realZero,
          vs) * hornerPoly{ℝ}(realAdd, realZero, realNeg, realMul, realOne, g,
          gs)]
      rw ← negation
      exact eqC
    rw ← step
    ring
  unfold HornerDivides
  witness ws
  refine ⟨wsList, _⟩
  rw [relation, eqW, mulList, negList, eqB, rsEq]
  ring

end Algebra

-- The last term divides the pair at k and the pair at k + 1, by descent
-- from the end of the sequence.
theorem sturmPair.last_divides_pair (j : Nat)
  shows ∀ k, Nat(k) → k + j = sturmLength →
    HornerDivides(ℝ, realAdd, realZero, realNeg, realMul, realOne,
      sturmLeading(sturmLength), sturmLower(sturmLength),
      sturmLeading(k), sturmLower(k)) ∧
    HornerDivides(ℝ, realAdd, realZero, realNeg, realMul, realOne,
      sturmLeading(sturmLength), sturmLower(sturmLength),
      sturmLeading(k + 1), sturmLower(k + 1))
proof
  induction j
  | zero =>
    intros k kNat same
    have unit := add.right_unit at k with kNat
    rw unit at same
    rw same
    have lengthNat := sturmLength.natural at leading, cs with initial,
      coefficients, nonzero
    have dataLast := sturmPair.data at leading, cs, sturmLength with initial,
      coefficients
    have zeroIn : realZero ∈ ℝ := realZero.real
    have nilList : List(ℝ, []) by typecheck
    constructor
    . exact HornerDivides.refl at ℝ, realAdd, realZero, realNeg, realMul,
        realOne, sturmLeading(sturmLength), sturmLower(sturmLength) with
        dataLast.right, reals.comm_ring, dataLast.left
    . have above : sturmLength < sturmLength + 1 by arith
      have vanish := sturmPair.zero_above_length at leading, cs,
        sturmLength + 1 with initial, coefficients, nonzero, above
      have leadingZero : sturmLeading(sturmLength + 1) = realZero
        unfold sturmLeading
        rw [vanish, fst.pair]
      have lowerNil : sturmLower(sturmLength + 1) = []
        unfold sturmLower
        rw [vanish, snd.pair]
      rw [leadingZero, lowerNil]
      have hornerZero : HornerZero(ℝ, realZero, realZero, [])
        unfold HornerZero
        intros i iNat
        have coefficient := RealSquarefree.coefficient_zero_leading at ℝ,
          realZero, [], i with nilList, iNat, zeroIn
        rw coefficient
        exact listCoefficient.nil at ℝ, realZero, i with iNat
      exact HornerDivides.zero at ℝ, realAdd, realZero, realNeg, realMul,
        realOne, sturmLeading(sturmLength), realZero, sturmLower(sturmLength),
        [] with dataLast.right, nilList, reals.comm_ring, dataLast.left,
        zeroIn, hornerZero
  | succ(i) using ih =>
    intros k kNat same
    have lengthNat := sturmLength.natural at leading, cs with initial,
      coefficients, nonzero
    have nextNat : Nat(k + 1) by typecheck
    have sameNext : k + 1 + i = sturmLength
      rw ← same
      ring
    obtain ⟨divNext, divLast⟩ := ih with k + 1, nextNat, sameNext
    have two : k + 1 + 1 = k + 2 by ring
    rw two at divLast
    refine ⟨_, divNext⟩
    have below : k + 1 ≤ sturmLength by arith
    have law := sturmPair.succ_succ at leading, cs, k with initial,
      coefficients, nonzero
    have dataLast := sturmPair.data at leading, cs, sturmLength with initial,
      coefficients
    have dataK := sturmPair.pair_data at leading, cs, k with initial,
      coefficients
    have dataNext := sturmPair.pair_data at leading, cs, k + 1 with initial,
      coefficients
    have namedK := sturmPair.data at leading, cs, k with initial, coefficients
    have namedNext := sturmPair.data at leading, cs, k + 1 with initial,
      coefficients
    have namedLast := sturmPair.data at leading, cs, k + 2 with initial,
      coefficients
    have leadingNonzero := sturmLeading.nonzero_below_length at leading, cs,
      k + 1 with initial, coefficients, nonzero, below
    have fstNonzero : fst(sturmPair(k + 1)) ≠ realZero
      unfold sturmLeading at leadingNonzero
      exact leadingNonzero
    rw sturmStep.of_nonzero at sturmPair(k), sturmPair(k + 1) with fstNonzero
      at law
    have field := RealSquarefree.field
    have division := hornerDivision.poly at ℝ, realAdd, realZero, realNeg,
      realMul, realOne, fst(sturmPair(k + 1)), fst(sturmPair(k)),
      snd(sturmPair(k + 1)), snd(sturmPair(k)) with
      dataNext.right, dataK.right, field, dataNext.left, fstNonzero, dataK.left
    have remainder := hornerDivRemainder.data at ℝ, realAdd, realZero, realNeg,
      realMul, realOne, fst(sturmPair(k + 1)), fst(sturmPair(k)),
      snd(sturmPair(k + 1)), snd(sturmPair(k)) with
      dataNext.right, dataK.right, field, dataNext.left, fstNonzero, dataK.left
    have negated := hornerNeg.data at ℝ, realAdd, realZero, realNeg, realMul,
      realOne, hornerDivRemainder{ℝ}(realAdd, realZero, realNeg, realMul,
        realOne, fst(sturmPair(k + 1)), fst(sturmPair(k)),
        snd(sturmPair(k + 1)), snd(sturmPair(k))) with
      remainder.left, reals.comm_ring
    have trimPoly := hornerPoly.trim at ℝ, realAdd, realZero, realNeg, realMul,
      realOne, hornerNeg{ℝ}(realNeg, hornerDivRemainder{ℝ}(realAdd, realZero,
        realNeg, realMul, realOne, fst(sturmPair(k + 1)), fst(sturmPair(k)),
        snd(sturmPair(k + 1)), snd(sturmPair(k)))) with
      negated.left, reals.comm_ring
    have negPoly := hornerPoly.neg_list at ℝ, realAdd, realZero, realNeg,
      realMul, realOne, hornerDivRemainder{ℝ}(realAdd, realZero, realNeg,
        realMul, realOne, fst(sturmPair(k + 1)), fst(sturmPair(k)),
        snd(sturmPair(k + 1)), snd(sturmPair(k))) with
      remainder.left, reals.comm_ring
    have leadingEq : sturmLeading(k + 2) = hornerTrimLeading{ℝ}(realZero,
        hornerNeg{ℝ}(realNeg, hornerDivRemainder{ℝ}(realAdd, realZero, realNeg,
          realMul, realOne, fst(sturmPair(k + 1)), fst(sturmPair(k)),
          snd(sturmPair(k + 1)), snd(sturmPair(k)))))
      unfold sturmLeading
      rw [law, fst.pair]
    have lowerEq : sturmLower(k + 2) = hornerTrimLower{ℝ}(realZero,
        hornerNeg{ℝ}(realNeg, hornerDivRemainder{ℝ}(realAdd, realZero, realNeg,
          realMul, realOne, fst(sturmPair(k + 1)), fst(sturmPair(k)),
          snd(sturmPair(k + 1)), snd(sturmPair(k)))))
      unfold sturmLower
      rw [law, snd.pair]
    have negation : RealSquarefree.poly(sturmLeading(k + 2),
        sturmLower(k + 2)) =
        polynomialNeg(oneVariable, ℝ, realAdd, realZero, realNeg, realMul,
          realOne)(RealSquarefree.poly(realZero, hornerDivRemainder{ℝ}(realAdd,
            realZero, realNeg, realMul, realOne, fst(sturmPair(k + 1)),
            fst(sturmPair(k)), snd(sturmPair(k + 1)), snd(sturmPair(k)))))
      unfold RealSquarefree.poly
      rw [leadingEq, lowerEq, trimPoly, negPoly]
    have relation : RealSquarefree.poly(sturmLeading(k), sturmLower(k)) =
        call2(polynomialAdd(oneVariable, ℝ, realAdd, realZero, realNeg,
            realMul, realOne),
          call2(polynomialMul(oneVariable, ℝ, realAdd, realZero, realNeg,
              realMul, realOne),
            RealSquarefree.poly(realZero, hornerDivQuotient{ℝ}(realAdd,
              realZero, realNeg, realMul, realOne, fst(sturmPair(k + 1)),
              fst(sturmPair(k)), snd(sturmPair(k + 1)), snd(sturmPair(k)))),
            RealSquarefree.poly(sturmLeading(k + 1), sturmLower(k + 1))),
          RealSquarefree.poly(realZero, hornerDivRemainder{ℝ}(realAdd,
            realZero, realNeg, realMul, realOne, fst(sturmPair(k + 1)),
            fst(sturmPair(k)), snd(sturmPair(k + 1)), snd(sturmPair(k)))))
      unfold RealSquarefree.poly
      unfold sturmLeading
      unfold sturmLower
      exact division
    have quotient := hornerDivQuotient.data at ℝ, realAdd, realZero, realNeg,
      realMul, realOne, fst(sturmPair(k + 1)), fst(sturmPair(k)),
      snd(sturmPair(k + 1)), snd(sturmPair(k)) with
      dataNext.right, dataK.right, field, dataNext.left, fstNonzero, dataK.left
    have quotientList := quotient.left
    have remainderList := remainder.left
    exact HornerDivides.of_recurrence at leading, cs, sturmLeading(sturmLength),
      sturmLeading(k), sturmLeading(k + 1), sturmLeading(k + 2),
      sturmLower(sturmLength), sturmLower(k), sturmLower(k + 1),
      sturmLower(k + 2),
      hornerDivQuotient{ℝ}(realAdd, realZero, realNeg, realMul, realOne,
        fst(sturmPair(k + 1)), fst(sturmPair(k)), snd(sturmPair(k + 1)),
        snd(sturmPair(k))),
      hornerDivRemainder{ℝ}(realAdd, realZero, realNeg, realMul, realOne,
        fst(sturmPair(k + 1)), fst(sturmPair(k)), snd(sturmPair(k + 1)),
        snd(sturmPair(k))) with *

-- The last term divides every term: it is the gcd of p and p′ up to a
-- nonzero constant.
theorem sturmPair.last_divides (k : Nat)
  requires below : k ≤ sturmLength
  shows HornerDivides(ℝ, realAdd, realZero, realNeg, realMul, realOne,
    sturmLeading(sturmLength), sturmLower(sturmLength),
    sturmLeading(k), sturmLower(k))
proof
  have lengthNat := sturmLength.natural at leading, cs with initial,
    coefficients, nonzero
  obtain ⟨j, jNat, same⟩ := LessEqual.exists_add with below
  have kNat : Nat(k) by typecheck
  symm at same
  have pair := sturmPair.last_divides_pair at leading, cs, j with initial,
    coefficients, nonzero
  have both := pair with k, kNat, same
  exact both.left

theorem sturmPair.last_constant_of_squarefree
  requires squarefree : RealSquarefree(leading, cs)
  shows sturmLower(sturmLength) = []
proof
  have lengthNat := sturmLength.natural at leading, cs with initial,
    coefficients, nonzero
  have leadingIn : leading ∈ ℝ by exact initial
  have zeroIn : realZero ∈ ℝ := realZero.real
  have field := RealSquarefree.field
  have derivativeIn : realDerivativeLeading(leading, cs) ∈ ℝ by typecheck
  have derivativeList := realDerivativeList.list at leading, cs with initial,
    coefficients
  have shape := natural.zero_or_successor at sturmLength with lengthNat
  cases shape with zeroLength | successor
  . -- With no step at all, p′ is the zero pair, so cs is empty.
    have first := sturmLength.vanishes at leading, cs with initial,
      coefficients
    rw zeroLength at first
    have one : 0 + 1 = 1 by ring
    rw one at first
    have law := sturmPair.one at leading, cs with initial, coefficients,
      nonzero
    rw law at first
    have lowerZero : sturmLower(0) = cs
      have zeroLaw := sturmPair.zero at leading, cs with initial, coefficients,
        nonzero
      unfold sturmLower
      rw [zeroLaw, snd.pair]
    rw [zeroLength, lowerZero]
    by_contra nonempty
    have derivativeNonzero : hornerDerivativeLeading{ℝ}(realAdd, realZero,
        realOne, realMul, leading, cs) ≠ realZero
      exact RealSquarefree.derivative_leading_nonzero at leading, cs with
        coefficients, leadingIn, nonzero, nonempty
    have derivativeNonzeroReal : realDerivativeLeading(leading, cs) ≠ realZero
      unfold realDerivativeLeading
      exact derivativeNonzero
    have normal := normalLeading.of_nonzero at ℝ, realZero,
      realDerivativeLeading(leading, cs), realDerivativeList(cs) with
      derivativeList, derivativeIn, derivativeNonzeroReal
    unfold sturmNormal at first
    rw normal.left at first
    have fstEq : fst((realDerivativeLeading(leading, cs),
        normalLower{ℝ}(realZero, realDerivativeLeading(leading, cs),
          realDerivativeList(cs)))) = fst((realZero, [])) by rw first
    rw [fst.pair, fst.pair] at fstEq
    exact derivativeNonzeroReal with fstEq
  . obtain ⟨m, mNat, lengthEq⟩ := successor
    have dataLast := sturmPair.data at leading, cs, sturmLength with initial,
      coefficients
    have lengthLe : sturmLength ≤ sturmLength by arith
    have lastNonzero := sturmLeading.nonzero_below_length at leading, cs,
      sturmLength with initial, coefficients, nonzero, lengthLe
    have zeroLe : 0 ≤ sturmLength by arith
    have oneLe : 1 ≤ sturmLength
      rw lengthEq
      arith
    have dividesFirst := sturmPair.last_divides at leading, cs, 0 with initial,
      coefficients, nonzero, zeroLe
    have dividesSecond := sturmPair.last_divides at leading, cs, 1 with
      initial, coefficients, nonzero, oneLe
    have zeroLaw := sturmPair.zero at leading, cs with initial, coefficients,
      nonzero
    have oneLaw := sturmPair.one at leading, cs with initial, coefficients,
      nonzero
    have leadingZero : sturmLeading(0) = leading
      unfold sturmLeading
      rw [zeroLaw, fst.pair]
    have lowerZero : sturmLower(0) = cs
      unfold sturmLower
      rw [zeroLaw, snd.pair]
    have leadingOne : sturmLeading(1) = normalLeading{ℝ}(realZero,
        realDerivativeLeading(leading, cs), realDerivativeList(cs))
      unfold sturmLeading
      rw oneLaw
      unfold sturmNormal
      rw fst.pair
    have lowerOne : sturmLower(1) = normalLower{ℝ}(realZero,
        realDerivativeLeading(leading, cs), realDerivativeList(cs))
      unfold sturmLower
      rw oneLaw
      unfold sturmNormal
      rw snd.pair
    rw [leadingZero, lowerZero] at dividesFirst
    rw [leadingOne, lowerOne] at dividesSecond
    have normalPoly := hornerPoly.normal at ℝ, realAdd, realZero, realNeg,
      realMul, realOne, realDerivativeLeading(leading, cs),
      realDerivativeList(cs) with derivativeList, reals.comm_ring, derivativeIn
    have dividesDerivative : HornerDivides(ℝ, realAdd, realZero, realNeg,
        realMul, realOne, sturmLeading(sturmLength), sturmLower(sturmLength),
        realDerivativeLeading(leading, cs), realDerivativeList(cs))
      unfold HornerDivides at dividesSecond
      obtain ⟨qs, qsList, equation⟩ := dividesSecond
      unfold HornerDivides
      witness qs
      refine ⟨qsList, _⟩
      rw ← normalPoly
      exact equation
    unfold realDerivativeLeading at dividesDerivative
    unfold realDerivativeList at dividesDerivative
    unfold RealSquarefree at squarefree
    have derivativeListRaw : List(ℝ, hornerDerivativeList{ℝ}(realAdd, realZero,
        realOne, realMul, cs))
      unfold realDerivativeList at derivativeList
      exact derivativeList
    have derivativeInRaw : hornerDerivativeLeading{ℝ}(realAdd, realZero,
        realOne, realMul, leading, cs) ∈ ℝ
      unfold realDerivativeLeading at derivativeIn
      exact derivativeIn
    have gcdDivides := hornerGcd.greatest at ℝ, realAdd, realZero, realNeg,
      realMul, realOne, leading, hornerDerivativeLeading{ℝ}(realAdd, realZero,
        realOne, realMul, leading, cs), sturmLeading(sturmLength), cs,
      hornerDerivativeList{ℝ}(realAdd, realZero, realOne, realMul, cs),
      sturmLower(sturmLength) with coefficients, derivativeListRaw,
      dataLast.right, field, leadingIn, derivativeInRaw, dataLast.left,
      dividesFirst, dividesDerivative
    have constant := HornerSquarefree.gcd_constant at ℝ, realAdd, realZero,
      realNeg, realMul, realOne, leading, cs with coefficients, field,
      leadingIn, squarefree
    have gcdNonzero := hornerGcd.nonzero_of_left at ℝ, realAdd, realZero,
      realNeg, realMul, realOne, leading, hornerDerivativeLeading{ℝ}(realAdd,
        realZero, realOne, realMul, leading, cs), cs,
      hornerDerivativeList{ℝ}(realAdd, realZero, realOne, realMul, cs) with
      coefficients, derivativeListRaw, field, leadingIn, derivativeInRaw,
      nonzero
    have gcdIn := hornerGcdLeading.mem at ℝ, realAdd, realZero, realNeg,
      realMul, realOne, leading, hornerDerivativeLeading{ℝ}(realAdd, realZero,
        realOne, realMul, leading, cs), cs,
      hornerDerivativeList{ℝ}(realAdd, realZero, realOne, realMul, cs) with
      coefficients, derivativeListRaw, field, leadingIn, derivativeInRaw
    rw constant at gcdDivides
    have nilList : List(ℝ, []) by typecheck
    have shorter := HornerDivides.length_le at ℝ, realAdd, realZero, realNeg,
      realMul, realOne, sturmLeading(sturmLength),
      hornerGcdLeading{ℝ}(realAdd, realZero, realNeg, realMul, realOne, leading,
        hornerDerivativeLeading{ℝ}(realAdd, realZero, realOne, realMul, leading,
          cs), cs, hornerDerivativeList{ℝ}(realAdd, realZero, realOne, realMul,
          cs)), sturmLower(sturmLength), [] with dataLast.right, nilList, field,
      dataLast.left, lastNonzero, gcdIn, gcdNonzero, gcdDivides
    rw length.nil at shorter
    have lengthNatural : Nat(length{ℝ}(sturmLower(sturmLength))) by typecheck
    have atLeast : 0 ≤ length{ℝ}(sturmLower(sturmLength)) by arith
    have zeroLength := LessEqual.antisymmetric with shorter, atLeast
    exact length.eq_zero with dataLast.right, zeroLength

-- For a squarefree pair, consecutive terms have no common root.
theorem sturmValues.no_common_root (k : Nat) (X : Real)
  requires squarefree : RealSquarefree(leading, cs)
  requires below : k + 1 ≤ sturmLength
  requires root : sturmValues(X)(k) = (0:R)
  shows sturmValues(X)(k + 1) ≠ (0:R)
proof
  intro next
  have lengthNat := sturmLength.natural at leading, cs with initial,
    coefficients, nonzero
  have bound : k ≤ sturmLength by arith
  have both := sturmValues.consecutive_zero at leading, cs, X, k with initial,
    coefficients, nonzero, bound, root, next
  have first := sturmValues.zero at leading, cs, X with initial, coefficients,
    nonzero
  have second := sturmValues.one at leading, cs, X with initial, coefficients,
    nonzero
  rw [first, second] at both
  have simple := RealSquarefree.simple_root at leading, cs, X with initial,
    coefficients, nonzero, squarefree, both.left
  exact simple with both.right

-- For a squarefree pair the last term never vanishes.
theorem sturmValues.last_nonzero_of_squarefree (X : Real)
  requires squarefree : RealSquarefree(leading, cs)
  shows sturmValues(X)(sturmLength) ≠ (0:R)
proof
  intro zero
  have lengthNat := sturmLength.natural at leading, cs with initial,
    coefficients, nonzero
  have above : sturmLength < sturmLength + 1 by arith
  have next := sturmValues.above_length at leading, cs, sturmLength + 1, X with
    initial, coefficients, nonzero, above
  have le : sturmLength ≤ sturmLength by arith
  have both := sturmValues.consecutive_zero at leading, cs, X, sturmLength with
    initial, coefficients, nonzero, le, zero, next
  have first := sturmValues.zero at leading, cs, X with initial, coefficients,
    nonzero
  have second := sturmValues.one at leading, cs, X with initial, coefficients,
    nonzero
  rw [first, second] at both
  have simple := RealSquarefree.simple_root at leading, cs, X with initial,
    coefficients, nonzero, squarefree, both.left
  exact simple with both.right

theorem sturmValueList.list (X : Real)
  shows List(ℝ, sturmValueList(X))
proof
  exact sturmValueList.list_all at leading, cs, X with initial, coefficients

theorem sturmValueList.length (X : Real)
  shows length{ℝ}(sturmValueList(X)) = succ(sturmLength)
proof
  exact sturmValueList.length_all at leading, cs, X with initial, coefficients

-- A nonzero value keeps its sign near the point, by continuity.
theorem sturmValues.sign_near (X : Real) (k : Nat)
  requires valueNonzero : sturmValues(X)(k) ≠ (0:R)
  shows ∃ D ∈ ℝ, 0 < D ∧ ∀ Y ∈ ℝ, Y ∈ openBall(X, D) →
    realSign(sturmValues(Y)(k)) = realSign(sturmValues(X)(k))
proof
  have same := sturmValues.eq_function at leading, cs, X, k with initial,
    coefficients
  have continuous := hornerFunction.continuous at sturmLeading(k),
    sturmLower(k) with *
  have atX := Continuous.at at hornerFunction(sturmLeading(k), sturmLower(k)),
    X with continuous
  have valueReal := sturmValues.real_all at leading, cs, X, k with initial,
    coefficients
  rw same at valueNonzero
  rw same at valueReal
  have split := realLess.trichotomy at
    hornerFunction(sturmLeading(k), sturmLower(k))(X), (0:R)
  rcases split with negative | zero | positive
  . have negativeValue : Negative(hornerFunction(sturmLeading(k),
        sturmLower(k))(X))
      unfold Negative
      exact negative
    obtain ⟨D, realD, positiveD, near⟩ := ContinuousAt.eventually_negative
      with atX, negativeValue
    witness D
    refine ⟨realD, positiveD, _⟩
    intros Y realY inBall
    have nearY := near with Y, realY, inBall
    unfold Negative at nearY
    have sameY := sturmValues.eq_function at leading, cs, Y, k with initial,
      coefficients
    have signY := realSign.of_negative with nearY
    have signX := realSign.of_negative with negative
    rw [sameY, same, signY, signX]
  . exfalso
    exact valueNonzero with zero
  . have positiveValue : Positive(hornerFunction(sturmLeading(k),
        sturmLower(k))(X))
      unfold Positive
      exact positive
    obtain ⟨D, realD, positiveD, near⟩ := ContinuousAt.eventually_positive
      with atX, positiveValue
    witness D
    refine ⟨realD, positiveD, _⟩
    intros Y realY inBall
    have nearY := near with Y, realY, inBall
    unfold Positive at nearY
    have sameY := sturmValues.eq_function at leading, cs, Y, k with initial,
      coefficients
    have signY := realSign.of_positive with nearY
    have signX := realSign.of_positive with positive
    rw [sameY, same, signY, signX]

-- One radius serves all the nonzero values among the first m.
theorem sturmValues.ball_signs (X : Real) (m : Nat)
  shows ∃ D ∈ ℝ, 0 < D ∧ ∀ k, Nat(k) → k < m → sturmValues(X)(k) ≠ (0:R) →
    ∀ Y ∈ ℝ, Y ∈ openBall(X, D) →
      realSign(sturmValues(Y)(k)) = realSign(sturmValues(X)(k))
proof
  induction m
  | zero =>
    have oneReal : (1:R) ∈ ℝ by typecheck
    have onePositive := realZero.lt_one
    witness (1:R)
    refine ⟨oneReal, onePositive, _⟩
    intros k kNat below
    exfalso
    arith
  | succ(j) using ih =>
    obtain ⟨D1, realD1, positiveD1, near1⟩ := ih
    have typedD1 : Real(D1) by exact realD1
    by_cases zero : sturmValues(X)(j) = (0:R)
    . witness D1
      refine ⟨realD1, positiveD1, _⟩
      intros k kNat below nonzeroK Y realY inBall
      by_cases before : k < j
      . exact near1 with k, kNat, before, nonzeroK, Y, realY, inBall
      . have atLeast := LessEqual.of_not_Less at k, j with before
        have atMost : k ≤ j by arith
        have same := LessEqual.antisymmetric at k, j with atMost, atLeast
        rw same at nonzeroK
        exfalso
        exact nonzeroK with zero
    . obtain ⟨D2, realD2, positiveD2, near2⟩ := sturmValues.sign_near at
        leading, cs, X, j with initial, coefficients, nonzero, zero
      have typedD2 : Real(D2) by exact realD2
      by_cases order : D1 ≤ D2
      . witness D1
        refine ⟨realD1, positiveD1, _⟩
        intros k kNat below nonzeroK Y realY inBall
        by_cases before : k < j
        . exact near1 with k, kNat, before, nonzeroK, Y, realY, inBall
        . have atLeast := LessEqual.of_not_Less at k, j with before
          have atMost : k ≤ j by arith
          have same := LessEqual.antisymmetric at k, j with atMost, atLeast
          have wider := openBall.mono at Y, X, D1, D2 with inBall, order
          rw same
          exact near2 with Y, realY, wider
      . have less := realLess.of_not_le at D1, D2 with order
        have le : D2 ≤ D1 by linarith
        witness D2
        refine ⟨realD2, positiveD2, _⟩
        intros k kNat below nonzeroK Y realY inBall
        by_cases before : k < j
        . have wider := openBall.mono at Y, X, D2, D1 with inBall, le
          exact near1 with k, kNat, before, nonzeroK, Y, realY, wider
        . have atLeast := LessEqual.of_not_Less at k, j with before
          have atMost : k ≤ j by arith
          have same := LessEqual.antisymmetric at k, j with atMost, atLeast
          rw same
          exact near2 with Y, realY, inBall

-- Away from the roots of p the count is locally constant.
theorem sturmCount.locally_constant (X : Real)
  requires nonroot : hornerFunction(leading, cs)(X) ≠ (0:R)
  shows ∃ D ∈ ℝ, 0 < D ∧ ∀ Y ∈ ℝ, Y ∈ openBall(X, D) →
    sturmCount(Y) = sturmCount(X)
proof
  have lengthNat := sturmLength.natural at leading, cs with initial,
    coefficients, nonzero
  obtain ⟨D, realD, positiveD, near⟩ := sturmValues.ball_signs at leading, cs,
    X, sturmLength + 1 with initial, coefficients, nonzero
  witness D
  refine ⟨realD, positiveD, _⟩
  intros Y realY inBall
  have fFunction := sturmValues.function at leading, cs, X with initial,
    coefficients
  have gFunction := sturmValues.function at leading, cs, Y with initial,
    coefficients
  have first := sturmValues.zero at leading, cs, X with initial, coefficients,
    nonzero
  have window : SturmWindow(sturmValues(X), sturmValues(Y), 0, sturmLength)
    unfold SturmWindow
    have zeroLength : 0 + sturmLength = sturmLength by ring
    refine ⟨_, _, _, _⟩
    . rw first
      exact nonroot
    . rw zeroLength
      exact sturmValues.last_nonzero at leading, cs, X with initial,
        coefficients, nonzero, nonroot
    . intros k kNat lower upper nonzeroK
      have below : k < sturmLength + 1 by arith
      exact near with k, kNat, below, nonzeroK, Y, realY, inBall
    . intros k kNat lower upper zeroK
      have below : k + 2 ≤ sturmLength by arith
      have relation := sturmValues.neighbors_at_root at leading, cs, k, X with
        initial, coefficients, nonzero, below, zeroK
      have bound : k + 1 ≤ sturmLength by arith
      have nextNonzero := sturmValues.no_consecutive_zero at leading, cs, X,
        k + 1 with initial, coefficients, nonzero, nonroot, bound, zeroK
      have two : k + 1 + 1 = k + 2 by ring
      rw two at nextNonzero
      have realNext := sturmValues.real_all at leading, cs, X, k + 2 with
        initial, coefficients
      rw relation
      exact realMulValue.neg_square_negative at sturmValues(X)(k + 2) with
        nextNonzero
  have same := signVariations.window_congr at sturmValues(X), sturmValues(Y),
    0, sturmLength with fFunction, gFunction, window
  unfold sturmCount
  unfold sturmValueList
  exact same

-- The points of [A, B] where the count is the count at A.
def sturmConstantSet (A B : Real) : Set :=
  { X ∈ closedInterval(A, B) | sturmCount(X) = sturmCount(A) }

theorem sturmCount.constant_without_roots (A B : Real)
  requires ordered : A ≤ B
  requires free : ∀ X ∈ closedInterval(A, B), hornerFunction(leading,
    cs)(X) ≠ (0:R)
  shows sturmCount(A) = sturmCount(B)
proof
  have realA : A ∈ ℝ by simp [Real]
  have realB : B ∈ ℝ by simp [Real]
  have aIn := closedInterval.left_mem at A, B with ordered
  have bIn := closedInterval.right_mem at A, B with ordered
  have aMember : A ∈ sturmConstantSet(A, B)
    apply sturmConstantSet.membership.backward
    exact ⟨aIn, rfl⟩
  have inhabited : Nonempty(sturmConstantSet(A, B)) := ⟨A, aMember⟩
  have subsetReals : sturmConstantSet(A, B) ⊆ ℝ
    intros X member
    obtain ⟨inInterval, same⟩ := sturmConstantSet.membership.forward with
      member
    obtain ⟨realX, lower, upper⟩ := closedInterval.membership.forward with
      inInterval
    exact realX
  have upper : RealUpperBound(sturmConstantSet(A, B), B)
    unfold RealUpperBound
    have typedB : Real(B) by assumption
    refine ⟨typedB, subsetReals, _⟩
    intros X member
    obtain ⟨inInterval, same⟩ := sturmConstantSet.membership.forward with
      member
    obtain ⟨realX, lower, upperX⟩ := closedInterval.membership.forward with
      inInterval
    exact realLe.subset at X, B with upperX
  have bounded : ∃ D, RealUpperBound(sturmConstantSet(A, B), D) := ⟨B, upper⟩
  obtain ⟨U, lub⟩ := Real.least_upper_bound_property at
    sturmConstantSet(A, B) with inhabited, bounded
  have least := lub
  rcases lub with ⟨⟨typedU, pointsSubset, boundsU⟩, leastU⟩
  have realU : U ∈ ℝ by exact typedU
  have aSubset := boundsU with A, aMember
  have aLe := realLe.of_subset at A, U with aSubset
  have uSubset := leastU with B, upper
  have uLe := realLe.of_subset at U, B with uSubset
  have uIn : U ∈ closedInterval(A, B)
    apply closedInterval.membership.backward
    exact ⟨realU, aLe, uLe⟩
  have uNonroot := free with U, uIn
  obtain ⟨D, realD, positiveD, near⟩ := sturmCount.locally_constant at
    leading, cs, U with initial, coefficients, nonzero, uNonroot
  have typedD : Real(D) by exact realD
  obtain ⟨Y, yMember, yNear⟩ := RealLeastUpperBound.approached at
    sturmConstantSet(A, B), U, D with least, positiveD
  obtain ⟨yInterval, ySame⟩ := sturmConstantSet.membership.forward with yMember
  obtain ⟨realY, yLower, yUpper⟩ := closedInterval.membership.forward with
    yInterval
  have ySubset := boundsU with Y, yMember
  have yLe := realLe.of_subset at Y, U with ySubset
  have typedY : Real(Y) by exact realY
  have yBounds : U - D < Y ∧ Y < U + D
    constructor
    . exact yNear
    . linarith
  have yBall := openBall.order_characterization.backward at Y, U, D with
    yBounds
  have countY := near with Y, realY, yBall
  have countU : sturmCount(U) = sturmCount(A)
    rw ← countY
    exact ySame
  have halfPositive := half.positive at D with positiveD
  have halfLess := half.lt_self at D with positiveD
  have halfReal := half.real at D
  have uEqB : U = B
    have split := realLess.trichotomy at U, B
    rcases split with less | same | more
    . exfalso
      by_cases inside : U + half(D) ≤ B
      . have zReal := realAddValue.real at U, half(D)
        have zMember : U + half(D) ∈ ℝ by exact zReal
        have zLower : A ≤ U + half(D) by linarith
        have zIn : U + half(D) ∈ closedInterval(A, B)
          apply closedInterval.membership.backward
          exact ⟨zMember, zLower, inside⟩
        have zBounds : U - D < U + half(D) ∧ U + half(D) < U + D
          constructor
          . linarith
          . linarith
        have zBall := openBall.order_characterization.backward at U + half(D),
          U, D with zBounds
        have countZ := near with U + half(D), zMember, zBall
        have zSame : sturmCount(U + half(D)) = sturmCount(A)
          rw [countZ, countU]
        have zMemberSet : U + half(D) ∈ sturmConstantSet(A, B)
          apply sturmConstantSet.membership.backward
          exact ⟨zIn, zSame⟩
        have zSubset := boundsU with U + half(D), zMemberSet
        have zLe := realLe.of_subset at U + half(D), U with zSubset
        linarith
      . have bLess := realLess.of_not_le at U + half(D), B with inside
        have bBounds : U - D < B ∧ B < U + D
          constructor
          . linarith
          . linarith
        have bBall := openBall.order_characterization.backward at B, U, D with
          bBounds
        have countB := near with B, realB, bBall
        have bSame : sturmCount(B) = sturmCount(A)
          rw [countB, countU]
        have bMemberSet : B ∈ sturmConstantSet(A, B)
          apply sturmConstantSet.membership.backward
          exact ⟨bIn, bSame⟩
        have bSubset := boundsU with B, bMemberSet
        have bLe := realLe.of_subset at B, U with bSubset
        linarith
    . exact same
    . exfalso
      linarith
  rw ← uEqB
  symm at countU
  exact countU

-- Near a simple root the value of p has the sign of (Y - X)·p′(X).
theorem hornerFunction.sign_near_simple_root (X : Real)
  requires root : hornerFunction(leading, cs)(X) = (0:R)
  requires simple : hornerFunction(realDerivativeLeading(leading, cs),
    realDerivativeList(cs))(X) ≠ (0:R)
  shows ∃ E ∈ ℝ, 0 < E ∧ ∀ Y ∈ ℝ, X - E < Y → Y < X + E → Y ≠ X →
    (Y < X → hornerFunction(leading, cs)(Y) *
      hornerFunction(realDerivativeLeading(leading, cs),
        realDerivativeList(cs))(X) < 0) ∧
    (X < Y → 0 < hornerFunction(leading, cs)(Y) *
      hornerFunction(realDerivativeLeading(leading, cs),
        realDerivativeList(cs))(X))
proof
  have realX : X ∈ ℝ by simp [Real]
  have derivative := hornerFunction.has_derivative_at at leading, cs, X with
    initial, coefficients
  have function := HasDerivativeAt.function with derivative
  have limit := HasDerivativeAt.limit with derivative
  have slopeReal := hornerFunction.derivative_real at leading, cs, X with
    initial, coefficients
  have quotientFunction := differenceQuotient.function at
    hornerFunction(leading, cs), X with function
  have split := realLess.trichotomy at hornerFunction(realDerivativeLeading(
    leading, cs), realDerivativeList(cs))(X), (0:R)
  rcases split with negative | zero | positive
  . obtain ⟨E, realE, positiveE, near⟩ := TendsToAt.eventually_negative with
      limit, negative
    witness E
    refine ⟨realE, positiveE, _⟩
    intros Y realY lower upper distinct
    have typedY : Real(Y) by exact realY
    have hReal := realSubValue.real at Y, X
    have hIn : Y - X ∈ ℝ by exact hReal
    have hNonzero : Y - X ≠ 0
      intro zero
      have same : Y = X by linarith
      exact distinct with same
    have hBounds : (0:R) - E < Y - X ∧ Y - X < (0:R) + E
      constructor
      . linarith
      . linarith
    have hBall := openBall.order_characterization.backward at Y - X, (0:R), E
      with hBounds
    have quotientNegative := near with Y - X, hIn, hNonzero, hBall
    have value := differenceQuotient.value at hornerFunction(leading, cs), X,
      Y - X with function
    have shift : X + (Y - X) = Y by ring
    rw [shift, root] at value
    have quotientReal := FunctionBetween.apply_closed with quotientFunction,
      hIn
    have valueReal := FunctionBetween.apply_closed with function, realY
    have typedValue : Real(hornerFunction(leading, cs)(Y)) by exact valueReal
    have typedQuotient : Real(differenceQuotient(hornerFunction(leading, cs),
      X)(Y - X)) by exact quotientReal
    have cancel := realDiv.mul_right at hornerFunction(leading, cs)(Y),
      Y - X with hNonzero
    have shiftValue : hornerFunction(leading, cs)(Y) - 0 =
      hornerFunction(leading, cs)(Y) by ring
    rw shiftValue at value
    rw ← value at cancel
    constructor
    . intro below
      have hNegative : Y - X < 0 by linarith
      have product := realSign.product_of_negatives at
        differenceQuotient(hornerFunction(leading, cs), X)(Y - X), Y - X with
        quotientNegative, hNegative
      rw cancel at product
      exact realSign.product_negative with product, negative
    . intro above
      have hPositive : 0 < Y - X by linarith
      have product := realSign.product_negative at Y - X,
        differenceQuotient(hornerFunction(leading, cs), X)(Y - X) with
        hPositive, quotientNegative
      have commute : (Y - X) * differenceQuotient(hornerFunction(leading, cs),
        X)(Y - X) = differenceQuotient(hornerFunction(leading, cs), X)(Y - X) *
        (Y - X) by ring
      rw [commute, cancel] at product
      exact realSign.product_of_negatives with product, negative
  . exfalso
    exact simple with zero
  . obtain ⟨E, realE, positiveE, near⟩ := TendsToAt.eventually_positive with
      limit, positive
    witness E
    refine ⟨realE, positiveE, _⟩
    intros Y realY lower upper distinct
    have typedY : Real(Y) by exact realY
    have hReal := realSubValue.real at Y, X
    have hIn : Y - X ∈ ℝ by exact hReal
    have hNonzero : Y - X ≠ 0
      intro zero
      have same : Y = X by linarith
      exact distinct with same
    have hBounds : (0:R) - E < Y - X ∧ Y - X < (0:R) + E
      constructor
      . linarith
      . linarith
    have hBall := openBall.order_characterization.backward at Y - X, (0:R), E
      with hBounds
    have quotientPositive := near with Y - X, hIn, hNonzero, hBall
    have value := differenceQuotient.value at hornerFunction(leading, cs), X,
      Y - X with function
    have shift : X + (Y - X) = Y by ring
    rw [shift, root] at value
    have quotientReal := FunctionBetween.apply_closed with quotientFunction,
      hIn
    have valueReal := FunctionBetween.apply_closed with function, realY
    have typedValue : Real(hornerFunction(leading, cs)(Y)) by exact valueReal
    have typedQuotient : Real(differenceQuotient(hornerFunction(leading, cs),
      X)(Y - X)) by exact quotientReal
    have cancel := realDiv.mul_right at hornerFunction(leading, cs)(Y),
      Y - X with hNonzero
    have shiftValue : hornerFunction(leading, cs)(Y) - 0 =
      hornerFunction(leading, cs)(Y) by ring
    rw shiftValue at value
    rw ← value at cancel
    constructor
    . intro below
      have hNegative : Y - X < 0 by linarith
      have product := realSign.product_negative at
        differenceQuotient(hornerFunction(leading, cs), X)(Y - X), Y - X with
        quotientPositive, hNegative
      rw cancel at product
      exact realMulValue.negative_of_neg_pos with product, positive
    . intro above
      have hPositive : 0 < Y - X by linarith
      have product := realMulValue.positive at
        differenceQuotient(hornerFunction(leading, cs), X)(Y - X), Y - X with
        quotientPositive, hPositive
      rw cancel at product
      exact realMulValue.positive with product, positive

-- Across a root of a squarefree pair the count drops by exactly one.
theorem sturmCount.drop_at_root (X : Real)
  requires squarefree : RealSquarefree(leading, cs)
  requires root : hornerFunction(leading, cs)(X) = (0:R)
  shows ∃ D ∈ ℝ, 0 < D ∧ ∀ Y ∈ ℝ, ∀ Z ∈ ℝ,
    X - D < Y → Y < X → X < Z → Z < X + D →
      sturmCount(Y) = sturmCount(Z) + 1
proof
  have realX : X ∈ ℝ by simp [Real]
  have lengthNat := sturmLength.natural at leading, cs with initial,
    coefficients, nonzero
  have simple := RealSquarefree.simple_root at leading, cs, X with initial,
    coefficients, nonzero, squarefree, root
  have slopeReal := hornerFunction.derivative_real at leading, cs, X with
    initial, coefficients
  have first := sturmValues.zero at leading, cs, X with initial, coefficients,
    nonzero
  have second := sturmValues.one at leading, cs, X with initial, coefficients,
    nonzero
  have secondNonzero : sturmValues(X)(1) ≠ (0:R)
    rw second
    exact simple
  have shape := natural.zero_or_successor at sturmLength with lengthNat
  have positiveLength : ∃ m, Nat(m) ∧ sturmLength = succ(m)
    cases shape with zeroLength | successor
    . exfalso
      have above : sturmLength < 1
        rw zeroLength
        arith
      have vanish := sturmValues.above_length at leading, cs, 1, X with
        initial, coefficients, nonzero, above
      exact secondNonzero with vanish
    . exact successor
  obtain ⟨m, mNat, lengthEq⟩ := positiveLength
  obtain ⟨E, realE, positiveE, nearRoot⟩ :=
    hornerFunction.sign_near_simple_root at leading, cs, X with initial,
    coefficients, nonzero, root, simple
  obtain ⟨D1, realD1, positiveD1, nearSigns⟩ := sturmValues.ball_signs at
    leading, cs, X, sturmLength + 1 with initial, coefficients, nonzero
  have typedE : Real(E) by exact realE
  have typedD1 : Real(D1) by exact realD1
  -- The radius serving both.
  have radius : ∃ D ∈ ℝ, 0 < D ∧ D ≤ E ∧ D ≤ D1
    by_cases order : E ≤ D1
    . witness E
      have le : E ≤ E by linarith
      exact ⟨realE, positiveE, le, order⟩
    . have less := realLess.of_not_le at E, D1 with order
      witness D1
      have le : D1 ≤ D1 by linarith
      have leE : D1 ≤ E by linarith
      exact ⟨realD1, positiveD1, leE, le⟩
  obtain ⟨D, realD, positiveD, leE, leD1⟩ := radius
  have typedD : Real(D) by exact realD
  witness D
  refine ⟨realD, positiveD, _⟩
  intros Y realY Z realZ lowerY upperY lowerZ upperZ
  have typedY : Real(Y) by exact realY
  have typedZ : Real(Z) by exact realZ
  -- The tail of the sequence keeps its sign variations near X.
  have tailSame : ∀ W ∈ ℝ, W ∈ openBall(X, D) →
      signVariations(coefficientWindow(sturmValues(W), 1, succ(m))) =
        signVariations(coefficientWindow(sturmValues(X), 1, succ(m)))
    intros W realW inBall
    have wider := openBall.mono at W, X, D, D1 with inBall, leD1
    have fFunction := sturmValues.function at leading, cs, X with initial,
      coefficients
    have gFunction := sturmValues.function at leading, cs, W with initial,
      coefficients
    have window : SturmWindow(sturmValues(X), sturmValues(W), 1, m)
      unfold SturmWindow
      have lastIndex : 1 + m = sturmLength
        rw lengthEq
        ring
      refine ⟨secondNonzero, _, _, _⟩
      . rw lastIndex
        exact sturmValues.last_nonzero_of_squarefree at leading, cs, X with
          initial, coefficients, nonzero, squarefree
      . intros k kNat lower upper nonzeroK
        have below : k < sturmLength + 1
          rw lengthEq
          arith
        exact nearSigns with k, kNat, below, nonzeroK, W, realW, wider
      . intros k kNat lower upper zeroK
        have below : k + 2 ≤ sturmLength
          rw lengthEq
          arith
        have relation := sturmValues.neighbors_at_root at leading, cs, k, X
          with initial, coefficients, nonzero, below, zeroK
        have bound : k + 1 + 1 ≤ sturmLength by arith
        have nextNonzero := sturmValues.no_common_root at leading, cs, k + 1, X
          with initial, coefficients, nonzero, squarefree, bound, zeroK
        have two : k + 1 + 1 = k + 2 by ring
        rw two at nextNonzero
        have realNext := sturmValues.real_all at leading, cs, X, k + 2 with
          initial, coefficients
        rw relation
        exact realMulValue.neg_square_negative at sturmValues(X)(k + 2) with
          nextNonzero
    exact signVariations.window_congr at sturmValues(X), sturmValues(W), 1, m
      with fFunction, gFunction, window
  -- The count at a point near X with p(W) ≠ 0 and the sign of p · p′.
  have countAt : ∀ W ∈ ℝ, W ∈ openBall(X, D) →
      hornerFunction(leading, cs)(W) ≠ (0:R) →
      sturmCount(W) =
        signVariations(coefficientWindow(sturmValues(X), 1, succ(m))) +
          signChangeIndicator(hornerFunction(leading, cs)(W),
            hornerFunction(realDerivativeLeading(leading, cs),
              realDerivativeList(cs))(W))
    intros W realW inBall nonrootW
    have typedW : Real(W) by exact realW
    have wider := openBall.mono at W, X, D, D1 with inBall, leD1
    have firstW := sturmValues.zero at leading, cs, W with initial,
      coefficients, nonzero
    have secondW := sturmValues.one at leading, cs, W with initial,
      coefficients, nonzero
    have one : 1 < sturmLength + 1
      rw lengthEq
      arith
    have oneNat : Nat(1) by typecheck
    have signSecond := nearSigns with 1, oneNat, one, secondNonzero, W,
      realW, wider
    have secondNonzeroW := realSign.nonzero_of_sign_eq at sturmValues(X)(1),
      sturmValues(W)(1) with secondNonzero, signSecond
    have firstNonzeroW : sturmValues(W)(0) ≠ (0:R)
      rw firstW
      exact nonrootW
    have gFunction := sturmValues.function at leading, cs, W with initial,
      coefficients
    have tailList := coefficientWindow.closed at ℝ, sturmValues(W), succ(1), m
      with gFunction
    have firstReal := sturmValues.real_all at leading, cs, W, 0 with initial,
      coefficients
    have secondReal := sturmValues.real_all at leading, cs, W, 1 with initial,
      coefficients
    have step := signVariations.cons_cons_indicator at sturmValues(W)(0),
      sturmValues(W)(1), coefficientWindow(sturmValues(W), succ(1), m) with
      firstNonzeroW, secondNonzeroW, tailList
    have unfoldHead : coefficientWindow(sturmValues(W), 0, succ(sturmLength)) =
        sturmValues(W)(0) :: coefficientWindow(sturmValues(W), 1, succ(m))
      rw lengthEq
      rw coefficientWindow
      have oneIndex : succ(0) = 1 by ring
      rw oneIndex
    have unfoldTail : coefficientWindow(sturmValues(W), 1, succ(m)) =
        sturmValues(W)(1) :: coefficientWindow(sturmValues(W), succ(1), m)
      rw coefficientWindow
    have same := tailSame with W, realW, inBall
    unfold sturmCount
    unfold sturmValueList
    rw [unfoldHead, unfoldTail, step, ← unfoldTail, same, firstW, secondW]
  -- At Y the first two values have opposite signs, at Z the same sign.
  have yBounds : X - D < Y ∧ Y < X + D
    constructor
    . exact lowerY
    . linarith
  have yBall := openBall.order_characterization.backward at Y, X, D with
    yBounds
  have zBounds : X - D < Z ∧ Z < X + D
    constructor
    . linarith
    . exact upperZ
  have zBall := openBall.order_characterization.backward at Z, X, D with
    zBounds
  have yDistinct : Y ≠ X
    intro same
    rw same at upperY
    linarith
  have zDistinct : Z ≠ X
    intro same
    rw same at lowerZ
    linarith
  have yLowerE : X - E < Y by linarith
  have yUpperE : Y < X + E by linarith
  have zLowerE : X - E < Z by linarith
  have zUpperE : Z < X + E by linarith
  have ySigns := nearRoot with Y, realY, yLowerE, yUpperE, yDistinct
  have zSigns := nearRoot with Z, realZ, zLowerE, zUpperE, zDistinct
  have yProduct := ySigns.left with upperY
  have zProduct := zSigns.right with lowerZ
  have yNonroot : hornerFunction(leading, cs)(Y) ≠ (0:R)
    intro zero
    rw zero at yProduct
    have vanish : (0:R) * hornerFunction(realDerivativeLeading(leading, cs),
      realDerivativeList(cs))(X) = (0:R) by ring
    rw vanish at yProduct
    linarith
  have zNonroot : hornerFunction(leading, cs)(Z) ≠ (0:R)
    intro zero
    rw zero at zProduct
    have vanish : (0:R) * hornerFunction(realDerivativeLeading(leading, cs),
      realDerivativeList(cs))(X) = (0:R) by ring
    rw vanish at zProduct
    linarith
  -- The derivative keeps its sign at Y and Z.
  have one : 1 < sturmLength + 1
    rw lengthEq
    arith
  have derivativeSign : ∀ W ∈ ℝ, W ∈ openBall(X, D) →
      realSign(hornerFunction(realDerivativeLeading(leading, cs),
        realDerivativeList(cs))(W)) =
      realSign(hornerFunction(realDerivativeLeading(leading, cs),
        realDerivativeList(cs))(X))
    intros W realW inBall
    have wider := openBall.mono at W, X, D, D1 with inBall, leD1
    have oneNat : Nat(1) by typecheck
    have signSecond := nearSigns with 1, oneNat, one, secondNonzero, W,
      realW, wider
    have secondW := sturmValues.one at leading, cs, W with initial,
      coefficients, nonzero
    rw [secondW, second] at signSecond
    exact signSecond
  have ySlope := derivativeSign with Y, realY, yBall
  have zSlope := derivativeSign with Z, realZ, zBall
  have ySlopeReal := hornerFunction.derivative_real at leading, cs, Y with
    initial, coefficients
  have zSlopeReal := hornerFunction.derivative_real at leading, cs, Z with
    initial, coefficients
  have yValueReal := sturmValues.real_all at leading, cs, Y, 0 with initial,
    coefficients
  have zValueReal := sturmValues.real_all at leading, cs, Z, 0 with initial,
    coefficients
  have firstY := sturmValues.zero at leading, cs, Y with initial, coefficients,
    nonzero
  have firstZ := sturmValues.zero at leading, cs, Z with initial, coefficients,
    nonzero
  rw firstY at yValueReal
  rw firstZ at zValueReal
  have yOpposite : hornerFunction(leading, cs)(Y) *
      hornerFunction(realDerivativeLeading(leading, cs),
        realDerivativeList(cs))(Y) < 0
    have signProduct := realSign.product_congr at hornerFunction(leading,
      cs)(Y), hornerFunction(realDerivativeLeading(leading, cs),
        realDerivativeList(cs))(X), hornerFunction(leading, cs)(Y),
      hornerFunction(realDerivativeLeading(leading, cs),
        realDerivativeList(cs))(Y) with rfl, ySlope
    have negativeSign := realSign.of_negative with yProduct
    rw negativeSign at signProduct
    have characterization := realSign.eq_neg_one_iff at
      hornerFunction(leading, cs)(Y) *
        hornerFunction(realDerivativeLeading(leading, cs),
          realDerivativeList(cs))(Y)
    exact characterization.forward with signProduct
  have zSame : 0 < hornerFunction(leading, cs)(Z) *
      hornerFunction(realDerivativeLeading(leading, cs),
        realDerivativeList(cs))(Z)
    have signProduct := realSign.product_congr at hornerFunction(leading,
      cs)(Z), hornerFunction(realDerivativeLeading(leading, cs),
        realDerivativeList(cs))(X), hornerFunction(leading, cs)(Z),
      hornerFunction(realDerivativeLeading(leading, cs),
        realDerivativeList(cs))(Z) with rfl, zSlope
    have positiveSign := realSign.of_positive with zProduct
    rw positiveSign at signProduct
    have characterization := realSign.eq_one_iff at
      hornerFunction(leading, cs)(Z) *
        hornerFunction(realDerivativeLeading(leading, cs),
          realDerivativeList(cs))(Z)
    exact characterization.forward with signProduct
  have countY := countAt with Y, realY, yBall, yNonroot
  have countZ := countAt with Z, realZ, zBall, zNonroot
  have oneIff := signChangeIndicator.one_iff at hornerFunction(leading, cs)(Y),
    hornerFunction(realDerivativeLeading(leading, cs),
      realDerivativeList(cs))(Y)
  have indicatorY := oneIff.backward with yOpposite
  have zNonnegative : 0 ≤ hornerFunction(leading, cs)(Z) *
    hornerFunction(realDerivativeLeading(leading, cs),
      realDerivativeList(cs))(Z) by linarith
  have zeroIff := signChangeIndicator.zero_iff at
    hornerFunction(leading, cs)(Z),
    hornerFunction(realDerivativeLeading(leading, cs),
      realDerivativeList(cs))(Z)
  have indicatorZ := zeroIff.backward with zNonnegative
  rw [countY, countZ, indicatorY, indicatorZ]
  have tailNat : Nat(signVariations(coefficientWindow(sturmValues(X), 1,
    succ(m)))) by typecheck
  ring

-- Points on either side of a root, inside a prescribed gap.
theorem sturm.left_point (A r D : Real)
  requires below : A < r
  requires positive : 0 < D
  shows ∃ Y ∈ ℝ, A < Y ∧ r - D < Y ∧ Y < r
proof
  have halfPositiveD := half.positive at D with positive
  have halfLessD := half.lt_self at D with positive
  have halfRealD := half.real at D
  by_cases far : A < r - D
  . have yReal := realSubValue.real at r, half(D)
    have yIn : r - half(D) ∈ ℝ by exact yReal
    witness r - half(D)
    refine ⟨yIn, _, _, _⟩
    . linarith
    . linarith
    . linarith
  . have near := realLe.of_not_less at r - D, A with far
    have gapReal := realSubValue.real at r, A
    have gapPositive : 0 < r - A by linarith
    have halfPositive := half.positive at r - A with gapPositive
    have halfLess := half.lt_self at r - A with gapPositive
    have halfReal := half.real at r - A
    have yReal := realAddValue.real at A, half(r - A)
    have yIn : A + half(r - A) ∈ ℝ by exact yReal
    witness A + half(r - A)
    refine ⟨yIn, _, _, _⟩
    . linarith
    . linarith
    . linarith

theorem sturm.right_point (r W D : Real)
  requires above : r < W
  requires positive : 0 < D
  shows ∃ Z ∈ ℝ, r < Z ∧ Z < W ∧ Z < r + D
proof
  have halfPositiveD := half.positive at D with positive
  have halfLessD := half.lt_self at D with positive
  have halfRealD := half.real at D
  by_cases far : r + D < W
  . have zReal := realAddValue.real at r, half(D)
    have zIn : r + half(D) ∈ ℝ by exact zReal
    witness r + half(D)
    refine ⟨zIn, _, _, _⟩
    . linarith
    . linarith
    . linarith
  . have near := realLe.of_not_less at W, r + D with far
    have gapReal := realSubValue.real at W, r
    have gapPositive : 0 < W - r by linarith
    have halfPositive := half.positive at W - r with gapPositive
    have halfLess := half.lt_self at W - r with gapPositive
    have halfReal := half.real at W - r
    have zReal := realAddValue.real at r, half(W - r)
    have zIn : r + half(W - r) ∈ ℝ by exact zReal
    witness r + half(W - r)
    refine ⟨zIn, _, _, _⟩
    . linarith
    . linarith
    . linarith

-- The sweep from A to B, by induction on the number of roots between.
theorem sturm.sweep (B : Real) (n : Nat)
  requires squarefree : RealSquarefree(leading, cs)
  requires right : hornerFunction(leading, cs)(B) ≠ (0:R)
  shows ∀ A ∈ ℝ, A < B → hornerFunction(leading, cs)(A) ≠ (0:R) →
    cardinality(rootSet(realRing, leading, cs) ∩ openInterval(A, B)) = n →
    sturmCount(A) = sturmCount(B) + n
proof
  induction n
  | zero =>
    intros A realA ordered left count
    have typedA : Real(A) by exact realA
    have rootsFinite := rootSet.real_finite at leading, cs with initial,
      coefficients, nonzero
    have subsetRoots := intersection.subset_left at
      rootSet(realRing, leading, cs), openInterval(A, B)
    have finite := Finite.subset with rootsFinite, subsetRoots
    have free : ∀ X ∈ closedInterval(A, B),
        hornerFunction(leading, cs)(X) ≠ (0:R)
      intros X inInterval
      obtain ⟨realX, lower, upper⟩ := closedInterval.membership.forward with
        inInterval
      have typedX : Real(X) by exact realX
      intro zeroX
      have rootIff := hornerFunction.root_iff at leading, cs, X with initial,
        coefficients
      have rootX := rootIff.backward with zeroX
      have splitLower := realLess.trichotomy at A, X
      rcases splitLower with less | same | more
      . have splitUpper := realLess.trichotomy at X, B
        rcases splitUpper with lessB | sameB | moreB
        . have inOpen : X ∈ openInterval(A, B)
            apply openInterval.membership.backward
            exact ⟨realX, less, lessB⟩
          have member : X ∈ rootSet(realRing, leading, cs) ∩ openInterval(A, B)
            apply intersection.membership.backward
            exact ⟨rootX, inOpen⟩
          have counted := cardinality.remove with finite, member
          rw count at counted
          symm at counted
          exact succ.ne_zero with counted
        . rw sameB at zeroX
          exact right with zeroX
        . linarith
      . rw ← same at zeroX
        exact left with zeroX
      . linarith
    have orderedLe : A ≤ B by linarith
    have constant := sturmCount.constant_without_roots at leading, cs, A, B
      with initial, coefficients, nonzero, orderedLe, free
    have natB : Nat(sturmCount(B)) by typecheck
    have unit := add.right_unit at sturmCount(B) with natB
    rw [constant, unit]
  | succ(m) using ih =>
    intros A realA ordered left count
    have typedA : Real(A) by exact realA
    have realB : B ∈ ℝ by simp [Real]
    have rootsFinite := rootSet.real_finite at leading, cs with initial,
      coefficients, nonzero
    have rootsReal := rootSet.subset_reals at leading, cs with initial,
      coefficients
    have subsetRoots := intersection.subset_left at
      rootSet(realRing, leading, cs), openInterval(A, B)
    have finite := Finite.subset with rootsFinite, subsetRoots
    have subsetReals := Subset.transitive with subsetRoots, rootsReal
    have inhabited : Nonempty(rootSet(realRing, leading, cs) ∩
        openInterval(A, B))
      by_cases isEmpty : rootSet(realRing, leading, cs) ∩ openInterval(A, B) =
        ∅
      . exfalso
        rw [isEmpty, cardinality.empty] at count
        symm at count
        exact succ.ne_zero with count
      . exact Nonempty.of_ne_empty with isEmpty
    obtain ⟨r, rMember, rLeast⟩ := Finite.exists_least_real with inhabited,
      subsetReals, finite
    obtain ⟨rRoot, rOpen⟩ := intersection.membership.forward with rMember
    obtain ⟨realR, lowerR, upperR⟩ := openInterval.membership.forward with rOpen
    have typedR : Real(r) by exact realR
    have rootIffR := hornerFunction.root_iff at leading, cs, r with initial,
      coefficients
    have rZero := rootIffR.forward with rRoot
    obtain ⟨D, realD, positiveD, drop⟩ := sturmCount.drop_at_root at leading,
      cs, r with initial, coefficients, nonzero, squarefree, rZero
    have typedD : Real(D) by exact realD
    -- No root lies in (A, r).
    have noRootBelow : ∀ X ∈ ℝ, A < X → X < r →
        hornerFunction(leading, cs)(X) ≠ (0:R)
      intros X realX lower upper zeroX
      have typedX : Real(X) by exact realX
      have rootIff := hornerFunction.root_iff at leading, cs, X with initial,
        coefficients
      have rootX := rootIff.backward with zeroX
      have upperB : X < B by linarith
      have inOpen : X ∈ openInterval(A, B)
        apply openInterval.membership.backward
        exact ⟨realX, lower, upperB⟩
      have member : X ∈ rootSet(realRing, leading, cs) ∩ openInterval(A, B)
        apply intersection.membership.backward
        exact ⟨rootX, inOpen⟩
      have le := rLeast with X, member
      linarith
    -- The point Y just below r.
    obtain ⟨Y, realY, aY, dY, yR⟩ := sturm.left_point at leading, cs, A, r, D
      with initial, coefficients, nonzero, lowerR, positiveD
    have typedY : Real(Y) by exact realY
    have freeAY : ∀ X ∈ closedInterval(A, Y),
        hornerFunction(leading, cs)(X) ≠ (0:R)
      intros X inInterval
      obtain ⟨realX, lower, upper⟩ := closedInterval.membership.forward with
        inInterval
      have typedX : Real(X) by exact realX
      have split := realLess.trichotomy at A, X
      rcases split with less | same | more
      . have upperR2 : X < r by linarith
        exact noRootBelow with X, realX, less, upperR2
      . rw ← same
        exact left
      . exfalso
        linarith
    have orderedAY : A ≤ Y by linarith
    have countAY := sturmCount.constant_without_roots at leading, cs, A, Y with
      initial, coefficients, nonzero, orderedAY, freeAY
    -- The next root W above r, or B when there is none.
    have rest : ∃ W ∈ ℝ, r < W ∧ W ≤ B ∧
        ∀ X ∈ rootSet(realRing, leading, cs) ∩ openInterval(A, B), X ≠ r →
          W ≤ X
      by_cases emptyRest : (rootSet(realRing, leading, cs) ∩
          openInterval(A, B)) ∖ {r} = ∅
      . witness B
        have bLe : B ≤ B by linarith
        refine ⟨realB, upperR, bLe, _⟩
        intros X member distinct
        exfalso
        have inRest : X ∈ (rootSet(realRing, leading, cs) ∩
            openInterval(A, B)) ∖ {r}
          apply difference.membership.backward
          refine ⟨member, _⟩
          intro inSingleton
          have singleton := FiniteSet.singleton.membership at X, r
          have same := singleton.forward with inSingleton
          exact distinct with same
        rw emptyRest at inRest
        exact set.empty with inRest
      . have inhabitedRest := Nonempty.of_ne_empty with emptyRest
        have subsetRest := difference.subset_left at
          rootSet(realRing, leading, cs) ∩ openInterval(A, B), {r}
        have finiteRest := Finite.subset with finite, subsetRest
        have realsRest := Subset.transitive with subsetRest, subsetReals
        obtain ⟨W, wMember, wLeast⟩ := Finite.exists_least_real with
          inhabitedRest, realsRest, finiteRest
        obtain ⟨wInRoots, wNotR⟩ := difference.membership.forward with wMember
        obtain ⟨wRoot, wOpen⟩ := intersection.membership.forward with wInRoots
        obtain ⟨realW, lowerW, upperW⟩ := openInterval.membership.forward with
          wOpen
        have typedW : Real(W) by exact realW
        have rLeW := rLeast with W, wInRoots
        have singletonW := FiniteSet.singleton.membership at W, r
        have rLtW : r < W
          have split := realLess.trichotomy at r, W
          rcases split with less | same | more
          . exact less
          . exfalso
            symm at same
            exact wNotR with (singletonW.backward with same)
          . exfalso
            linarith
        witness W
        have wLe : W ≤ B by linarith
        refine ⟨realW, rLtW, wLe, _⟩
        intros X member distinct
        have inRest : X ∈ (rootSet(realRing, leading, cs) ∩
            openInterval(A, B)) ∖ {r}
          apply difference.membership.backward
          refine ⟨member, _⟩
          intro inSingleton
          have singleton := FiniteSet.singleton.membership at X, r
          have same := singleton.forward with inSingleton
          exact distinct with same
        exact wLeast with X, inRest
    obtain ⟨W, realW, rW, wB, wLeast⟩ := rest
    have typedW : Real(W) by exact realW
    obtain ⟨Z, realZ, rZ, zW, zD⟩ := sturm.right_point at leading, cs, r, W, D
      with initial, coefficients, nonzero, rW, positiveD
    have typedZ : Real(Z) by exact realZ
    have zB : Z < B by linarith
    have aZ : A < Z by linarith
    have zNonroot : hornerFunction(leading, cs)(Z) ≠ (0:R)
      intro zeroZ
      have rootIff := hornerFunction.root_iff at leading, cs, Z with initial,
        coefficients
      have rootZ := rootIff.backward with zeroZ
      have inOpen : Z ∈ openInterval(A, B)
        apply openInterval.membership.backward
        exact ⟨realZ, aZ, zB⟩
      have member : Z ∈ rootSet(realRing, leading, cs) ∩ openInterval(A, B)
        apply intersection.membership.backward
        exact ⟨rootZ, inOpen⟩
      have distinct : Z ≠ r
        intro same
        rw same at rZ
        linarith
      have le := wLeast with Z, member, distinct
      linarith
    -- The roots in (Z, B) are the roots in (A, B) other than r.
    have restEq : rootSet(realRing, leading, cs) ∩ openInterval(Z, B) =
        (rootSet(realRing, leading, cs) ∩ openInterval(A, B)) ∖ {r}
      ext X
      constructor
      . intro member
        obtain ⟨rootX, openX⟩ := intersection.membership.forward with member
        obtain ⟨realX, lowerX, upperX⟩ := openInterval.membership.forward with
          openX
        have typedX : Real(X) by exact realX
        apply difference.membership.backward
        constructor
        . apply intersection.membership.backward
          refine ⟨rootX, _⟩
          apply openInterval.membership.backward
          have aX : A < X by linarith
          exact ⟨realX, aX, upperX⟩
        . intro inSingleton
          have singleton := FiniteSet.singleton.membership at X, r
          have same := singleton.forward with inSingleton
          rw same at lowerX
          linarith
      . intro member
        obtain ⟨inRoots, notR⟩ := difference.membership.forward with member
        obtain ⟨rootX, openX⟩ := intersection.membership.forward with inRoots
        obtain ⟨realX, lowerX, upperX⟩ := openInterval.membership.forward with
          openX
        have typedX : Real(X) by exact realX
        have singleton := FiniteSet.singleton.membership at X, r
        have distinct : X ≠ r
          intro same
          apply notR
          exact singleton.backward with same
        have wX := wLeast with X, inRoots, distinct
        apply intersection.membership.backward
        refine ⟨rootX, _⟩
        apply openInterval.membership.backward
        have zX : Z < X by linarith
        exact ⟨realX, zX, upperX⟩
    have countRest : cardinality(rootSet(realRing, leading, cs) ∩
        openInterval(Z, B)) = m
      rw restEq
      have removed := cardinality.remove with finite, rMember
      rw count at removed
      have finiteRest := Finite.difference at
        rootSet(realRing, leading, cs) ∩ openInterval(A, B), {r} with finite
      have restNat := cardinality.nat with finiteRest
      have forward : m ≤ cardinality((rootSet(realRing, leading, cs) ∩
        openInterval(A, B)) ∖ {r}) by arith
      have backward : cardinality((rootSet(realRing, leading, cs) ∩
        openInterval(A, B)) ∖ {r}) ≤ m by arith
      exact LessEqual.antisymmetric with backward, forward
    have countZB := ih with Z, realZ, zB, zNonroot, countRest
    have countYZ := drop with Y, realY, Z, realZ, dY, yR, rZ, zD
    have natB : Nat(sturmCount(B)) by typecheck
    rw [countAY, countYZ, countZB]
    ring

-- Sturm's theorem.
theorem sturm.theorem (A B : Real)
  requires squarefree : RealSquarefree(leading, cs)
  requires ordered : A < B
  requires left : hornerFunction(leading, cs)(A) ≠ (0:R)
  requires right : hornerFunction(leading, cs)(B) ≠ (0:R)
  shows cardinality(rootSet(realRing, leading, cs) ∩ openInterval(A, B)) +
    sturmCount(B) = sturmCount(A)
proof
  have realA : A ∈ ℝ by simp [Real]
  have rootsFinite := rootSet.real_finite at leading, cs with initial,
    coefficients, nonzero
  have subsetRoots := intersection.subset_left at
    rootSet(realRing, leading, cs), openInterval(A, B)
  have finite := Finite.subset with rootsFinite, subsetRoots
  have countNat := cardinality.nat with finite
  have sweep := sturm.sweep at leading, cs, B,
    cardinality(rootSet(realRing, leading, cs) ∩ openInterval(A, B)) with
    initial, coefficients, nonzero, squarefree, right
  have same : cardinality(rootSet(realRing, leading, cs) ∩ openInterval(A, B))
    = cardinality(rootSet(realRing, leading, cs) ∩ openInterval(A, B)) by rfl
  have result := sweep with A, realA, ordered, left, same
  have natB : Nat(sturmCount(B)) by typecheck
  rw result
  ring

-- Beyond the root bound the count gives the number of all real roots.
theorem sturm.root_count
  requires squarefree : RealSquarefree(leading, cs)
  shows ∃ B ∈ ℝ, cardinality(rootSet(realRing, leading, cs)) + sturmCount(B) =
    sturmCount(-B)
proof
  obtain ⟨B0, realB0, bound⟩ := hornerFunction.roots_bounded at leading, cs
    with initial, coefficients, nonzero
  have typedB0 : Real(B0) by exact realB0
  have rootsReal := rootSet.subset_reals at leading, cs with initial,
    coefficients
  have absReal := abs.real at B0
  have absNonnegative := abs.nonnegative at B0
  have absUpper := abs.upper at B0
  have bReal := realAddValue.real at abs(B0), (1:R)
  have bIn : abs(B0) + (1:R) ∈ ℝ by exact bReal
  have negReal := realNegValue.real at abs(B0) + (1:R)
  have ordered : -(abs(B0) + (1:R)) < abs(B0) + (1:R) by linarith
  have rootsIn : ∀ r ∈ rootSet(realRing, leading, cs),
      r ∈ openInterval(-(abs(B0) + (1:R)), abs(B0) + (1:R))
    intros r rRoot
    have realR := rootsReal with r, rRoot
    have typedR : Real(r) by exact realR
    have le := bound with r, rRoot
    have upperR := abs.upper at r
    have lowerR := abs.upper_neg at r
    have absRReal := abs.real at r
    apply openInterval.membership.backward
    refine ⟨realR, _, _⟩
    . linarith
    . linarith
  have leftNonroot : hornerFunction(leading, cs)(-(abs(B0) + (1:R))) ≠ (0:R)
    intro zero
    have rootIff := hornerFunction.root_iff at leading, cs,
      -(abs(B0) + (1:R)) with initial, coefficients
    have root := rootIff.backward with zero
    have inOpen := rootsIn with -(abs(B0) + (1:R)), root
    obtain ⟨realL, lower, upper⟩ := openInterval.membership.forward with inOpen
    linarith
  have rightNonroot : hornerFunction(leading, cs)(abs(B0) + (1:R)) ≠ (0:R)
    intro zero
    have rootIff := hornerFunction.root_iff at leading, cs, abs(B0) + (1:R)
      with initial, coefficients
    have root := rootIff.backward with zero
    have inOpen := rootsIn with abs(B0) + (1:R), root
    obtain ⟨realL, lower, upper⟩ := openInterval.membership.forward with inOpen
    linarith
  have same : rootSet(realRing, leading, cs) ∩
      openInterval(-(abs(B0) + (1:R)), abs(B0) + (1:R)) =
      rootSet(realRing, leading, cs)
    ext r
    constructor
    . intro member
      obtain ⟨rootR, openR⟩ := intersection.membership.forward with member
      exact rootR
    . intro rootR
      apply intersection.membership.backward
      have inOpen := rootsIn with r, rootR
      exact ⟨rootR, inOpen⟩
  have result := sturm.theorem at leading, cs, -(abs(B0) + (1:R)),
    abs(B0) + (1:R) with initial, coefficients, nonzero, squarefree, ordered,
    leftNonroot, rightNonroot
  rw same at result
  witness abs(B0) + (1:R)
  exact ⟨bIn, result⟩

end Nonzero
end Polynomials
