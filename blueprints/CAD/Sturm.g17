-- The Sturm sequence of a real Horner pair, p, p′, and then the negated
-- remainders until zero, each in normal form; the Sturm count at a point
-- as the sign variations of the values; the sign relations the classical
-- proof uses; and Sturm's theorem: for a squarefree pair and A < B with
-- p(A), p(B) nonzero, the number of roots in (A, B) is the drop of the
-- count from A to B.
-- Part of the CAD blueprint.
-- Planned home: Real/Analysis/Sturm.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module CAD.Sturm
import CAD.SignVariations
import CAD.RealSquarefree
import CAD.RealRootOrder
import Grace.Cumulus.Nat.Least

-- The next term after the pairs p and q: the negated remainder of p by q
-- in normal form, or the zero pair once q is zero.
def sturmStep (p q : Set) : Set :=
  boolChoice(memberTest({realZero}, fst(q)), (realZero, []),
    (hornerTrimLeading{ℝ}(realZero, hornerNeg{ℝ}(realNeg,
        hornerDivRemainder{ℝ}(realAdd, realZero, realNeg, realMul, realOne,
          fst(q), fst(p), snd(q), snd(p)))),
      hornerTrimLower{ℝ}(realZero, hornerNeg{ℝ}(realNeg,
        hornerDivRemainder{ℝ}(realAdd, realZero, realNeg, realMul, realOne,
          fst(q), fst(p), snd(q), snd(p))))))

def sturmNormal (leading cs : Set) : Set :=
  (normalLeading{ℝ}(realZero, leading, cs), normalLower{ℝ}(realZero, leading,
    cs))

-- The state at k is the pair of consecutive terms (p_k, p_{k+1}).
def sturmState (leading cs : Set, k : Nat) → Set
  | leading, cs, zero =>
      (sturmNormal(leading, cs),
        sturmNormal(realDerivativeLeading(leading, cs), realDerivativeList(cs)))
  | leading, cs, succ(k) =>
      (snd(sturmState(leading, cs, k)),
        sturmStep(fst(sturmState(leading, cs, k)), snd(sturmState(leading, cs,
          k))))

def sturmPair (leading cs : Set, k : Nat) : Set := fst(sturmState(leading, cs,
    k))
def sturmLeading (leading cs : Set, k : Nat) : Set := fst(sturmPair(leading,
    cs, k))
def sturmLower (leading cs : Set, k : Nat) : Set := snd(sturmPair(leading, cs,
    k))

-- The indices after which the sequence has reached zero; the length of
-- the sequence is the index of its last nonzero term.
def sturmVanishing (leading cs : Set) : Set :=
  { k ∈ ℕ | sturmPair(leading, cs, succ(k)) = (realZero, []) }
def sturmLength (leading cs : Set)
    : Set := leastNatural(sturmVanishing(leading, cs))

defgraph sturmValues (leading cs : Set, X : Real) (k ∈ ℕ) : ℝ :=
  horner(realRing, sturmLeading(leading, cs, k), X, sturmLower(leading, cs, k))
requires initial : Real(leading)
requires coefficients : List(ℝ, cs)
proof
  sorry

def sturmValueList (leading cs : Set, X : Real) : Set :=
  coefficientWindow(sturmValues(leading, cs, X), 0, succ(sturmLength(leading,
    cs)))
def sturmCount (leading cs : Set, X : Real) : Set :=
  signVariations(sturmValueList(leading, cs, X))

section Terms
variable (leading cs : Set)
hypothesis initial : Real(leading)
hypothesis coefficients : List(ℝ, cs)

instance sturmLeading.real (k : Nat)
  shows Real(sturmLeading(leading, cs, k))
proof
  sorry

instance sturmLower.list (k : Nat)
  shows List(ℝ, sturmLower(leading, cs, k))
proof
  sorry

instance sturmCount.natural (X : Real)
  shows Nat(sturmCount(leading, cs, X))
proof
  sorry

end Terms

section Polynomials
variable (leading cs : Set)
hypothesis initial : Real(leading)
hypothesis coefficients : List(ℝ, cs)
hypothesis nonzero : leading ≠ (0:R)

theorem sturmPair.zero
  shows sturmPair(leading, cs, 0) = (leading, cs)
proof
  sorry

theorem sturmPair.one
  shows sturmPair(leading, cs, 1) =
    sturmNormal(realDerivativeLeading(leading, cs), realDerivativeList(cs))
proof
  sorry

theorem sturmPair.succ_succ (k : Nat)
  shows sturmPair(leading, cs, k + 2) =
    sturmStep(sturmPair(leading, cs, k), sturmPair(leading, cs, k + 1))
proof
  sorry

-- Every term is in normal form.
theorem sturmPair.normal (k : Nat)
  shows sturmLeading(leading, cs, k) ≠ (0:R) ∨
    (sturmLeading(leading, cs, k) = (0:R) ∧ sturmLower(leading, cs, k) = [])
proof
  sorry

-- The sequence reaches zero, since the degrees strictly decrease.
theorem sturmVanishing.nonempty
  shows Nonempty(sturmVanishing(leading, cs))
proof
  sorry

theorem sturmLength.natural
  shows Nat(sturmLength(leading, cs))
proof
  sorry

theorem sturmLength.le_length
  shows sturmLength(leading, cs) ≤ length{ℝ}(cs)
proof
  sorry

theorem sturmPair.zero_above_length (k : Nat)
  requires above : sturmLength(leading, cs) < k
  shows sturmPair(leading, cs, k) = (realZero, [])
proof
  sorry

theorem sturmLeading.nonzero_below_length (k : Nat)
  requires below : k ≤ sturmLength(leading, cs)
  shows sturmLeading(leading, cs, k) ≠ (0:R)
proof
  sorry

theorem sturmLower.length_decreasing (k : Nat)
  requires below : k + 1 ≤ sturmLength(leading, cs)
  shows length{ℝ}(sturmLower(leading, cs,
    k + 1)) < length{ℝ}(sturmLower(leading, cs, k))
proof
  sorry

theorem sturmValues.zero (X : Real)
  shows sturmValues(leading, cs, X)(0) = hornerFunction(leading, cs)(X)
proof
  sorry

theorem sturmValues.one (X : Real)
  shows sturmValues(leading, cs, X)(1) =
    hornerFunction(realDerivativeLeading(leading, cs),
      realDerivativeList(cs))(X)
proof
  sorry

-- At a root of a middle term, its neighbors are negatives of each other.
theorem sturmValues.neighbors_at_root (k : Nat) (X : Real)
  requires below : k + 2 ≤ sturmLength(leading, cs)
  requires middle : sturmValues(leading, cs, X)(k + 1) = (0:R)
  shows sturmValues(leading, cs, X)(k) = -sturmValues(leading, cs, X)(k + 2)
proof
  sorry

-- The last term divides every term: it is the gcd of p and p′ up to a
-- nonzero constant.
theorem sturmPair.last_divides (k : Nat)
  requires below : k ≤ sturmLength(leading, cs)
  shows HornerDivides(ℝ, realAdd, realZero, realNeg, realMul, realOne,
    sturmLeading(leading, cs, sturmLength(leading, cs)),
    sturmLower(leading, cs, sturmLength(leading, cs)),
    sturmLeading(leading, cs, k), sturmLower(leading, cs, k))
proof
  sorry

theorem sturmPair.last_constant_of_squarefree
  requires squarefree : RealSquarefree(leading, cs)
  shows sturmLower(leading, cs, sturmLength(leading, cs)) = []
proof
  sorry

-- For a squarefree pair, consecutive terms have no common root.
theorem sturmValues.no_common_root (k : Nat) (X : Real)
  requires squarefree : RealSquarefree(leading, cs)
  requires below : k + 1 ≤ sturmLength(leading, cs)
  requires root : sturmValues(leading, cs, X)(k) = (0:R)
  shows sturmValues(leading, cs, X)(k + 1) ≠ (0:R)
proof
  sorry

theorem sturmValueList.list (X : Real)
  shows List(ℝ, sturmValueList(leading, cs, X))
proof
  sorry

theorem sturmValueList.length (X : Real)
  shows length{ℝ}(sturmValueList(leading, cs, X)) = succ(sturmLength(leading,
    cs))
proof
  sorry

-- Away from the roots of p the count is locally constant.
theorem sturmCount.locally_constant (X : Real)
  requires nonroot : hornerFunction(leading, cs)(X) ≠ (0:R)
  shows ∃ D ∈ ℝ, 0 < D ∧ (∀ Y ∈ ℝ, Y ∈ openBall(X, D) →
    sturmCount(leading, cs, Y) = sturmCount(leading, cs, X))
proof
  sorry

theorem sturmCount.constant_without_roots (A B : Real)
  requires ordered : A ≤ B
  requires free : ∀ X ∈ closedInterval(A, B), hornerFunction(leading,
    cs)(X) ≠ (0:R)
  shows sturmCount(leading, cs, A) = sturmCount(leading, cs, B)
proof
  sorry

-- Across a root of a squarefree pair the count drops by exactly one.
theorem sturmCount.drop_at_root (X : Real)
  requires squarefree : RealSquarefree(leading, cs)
  requires root : hornerFunction(leading, cs)(X) = (0:R)
  shows ∃ D ∈ ℝ, 0 < D ∧ (∀ Y ∈ ℝ, ∀ Z ∈ ℝ,
    X - D < Y → Y < X → X < Z → Z < X + D →
      sturmCount(leading, cs, Y) = sturmCount(leading, cs, Z) + 1)
proof
  sorry

-- Sturm's theorem.
theorem sturm.theorem (A B : Real)
  requires squarefree : RealSquarefree(leading, cs)
  requires ordered : A < B
  requires left : hornerFunction(leading, cs)(A) ≠ (0:R)
  requires right : hornerFunction(leading, cs)(B) ≠ (0:R)
  shows add(cardinality(rootSet(realRing, leading, cs) ∩ openInterval(A, B)),
    sturmCount(leading, cs, B)) = sturmCount(leading, cs, A)
proof
  sorry

-- Beyond the root bound the count gives the number of all real roots.
theorem sturm.root_count
  requires squarefree : RealSquarefree(leading, cs)
  shows ∃ B ∈ ℝ, add(cardinality(rootSet(realRing, leading, cs)),
    sturmCount(leading, cs, B)) = sturmCount(leading, cs, -B)
proof
  sorry

end Polynomials
