-- The derivative of a Horner coefficient list: for the pair (leading, cs)
-- representing c₀ + c₁X + … + leading·Xⁿ, the pair of the derivative is
-- (n·leading, [1·c₁, 2·c₂, …, (n−1)·c_{n−1}]). Its closure and length,
-- the recursion law of its values, transport under ring homomorphisms,
-- and the bridge to partialDerivative on the polynomial ring.
-- Part of the CAD blueprint.
-- Planned home: Algebra/Polynomial/HornerDerivative.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module CAD.HornerDerivative
import Grace.Cumulus.Algebra.Polynomial.HornerArithmetic
import Grace.Cumulus.Algebra.Polynomial.HornerHom
import Grace.Cumulus.Algebra.Polynomial.HornerTranslation
import Grace.Cumulus.Algebra.Polynomial.Derivative
import Grace.Cumulus.Algebra.Polynomial.BundledRoots
import Grace.Cumulus.Algebra.Ring.Numeral

-- The entries k·c of cs for consecutive naturals k starting at start.
def hornerIndexScale {A : Set} (add zero one mul start : Set)
    (cs : List(A)) → Set
  | add, zero, one, mul, start, List.nil => []
  | add, zero, one, mul, start, List.cons(c, tail) =>
      call2(mul, ringNat(add, zero, one, start), c) ::
        hornerIndexScale(add, zero, one, mul, succ(start), tail)
  descends cs

-- The lower coefficients of the derivative drop c₀ and scale the rest.
def hornerDerivativeList {A : Set} (add zero one mul : Set)
  (cs : List(A)) : Set :=
  hornerIndexScale{A}(add, zero, one, mul, 1, listTail{A}(cs))

-- The leading coefficient of the derivative is n·leading, n = length(cs).
def hornerDerivativeLeading {A : Set} (add zero one mul leading : Set)
  (cs : List(A)) : Set :=
  call2(mul, ringNat(add, zero, one, length{A}(cs)), leading)

theorem hornerIndexScale.nil (A add zero one mul : Set, start : Nat)
  shows hornerIndexScale{A}(add, zero, one, mul, start, []) = []
proof
  rw hornerIndexScale
  rfl

theorem hornerIndexScale.cons (A add zero one mul c : Set,
    start : Nat) (tail : List(A))
  shows hornerIndexScale{A}(add, zero, one, mul, start, c :: tail) =
    call2(mul, ringNat(add, zero, one, start), c) ::
      hornerIndexScale{A}(add, zero, one, mul, succ(start), tail)
proof
  rw hornerIndexScale
  rfl

theorem hornerDerivativeList.nil (A add zero one mul : Set)
  shows hornerDerivativeList{A}(add, zero, one, mul, []) = []
proof
  unfold hornerDerivativeList
  rw [listTail, hornerIndexScale]
  rfl

theorem hornerDerivativeList.cons (A add zero one mul c : Set) (tail : List(A))
  shows hornerDerivativeList{A}(add, zero, one, mul, c :: tail) =
    hornerIndexScale{A}(add, zero, one, mul, 1, tail)
proof
  unfold hornerDerivativeList
  rw listTail
  rfl

section Rings
variable (A add zero neg mul one leading : Set)
notation ring R := (A, add, zero, neg, mul, one)
hypothesis ring : IsCommRing(R)
hypothesis initial : leading ∈ R

theorem hornerIndexScale.data (start : Nat) (cs : List(A))
  shows List(A, hornerIndexScale{A}(add, zero, one, mul, start, cs)) ∧
    length{A}(hornerIndexScale{A}(add, zero, one, mul, start,
      cs)) = length{A}(cs)
proof
  induction cs generalizing start
  | List.nil =>
    intros start startNat
    rw hornerIndexScale
    constructor
    . typecheck
    . rfl
  | List.cons(c, tail) using ih =>
    intros start startNat
    have coefficient : c ∈ R by assumption
    have ordinary := IsCommRing.ring with ring
    have numeral := IsRing.numeral_closed at A, add, zero, neg, mul, one, start
      with ordinary
    have head := IsRing.mul_closed with ordinary, numeral, coefficient
    have next : Nat(succ(start)) by typecheck
    have previous := ih with succ(start), next
    rw hornerIndexScale
    constructor
    . typecheck
    . rw [length.cons, previous.right, length.cons]
      rfl

theorem hornerDerivativeList.data (cs : List(A))
  shows List(A, hornerDerivativeList{A}(add, zero, one, mul, cs)) ∧
    length{A}(hornerDerivativeList{A}(add, zero, one, mul, cs)) =
      predecessor(length{A}(cs))
proof
  have oneNat : Nat((1:N)) by typecheck
  have rest := listTail.closed at A, cs with *
  have data := hornerIndexScale.data at A, add, zero, neg, mul, one, leading,
      (1:N),
    listTail{A}(cs) with *
  unfold hornerDerivativeList
  constructor
  . exact data.left
  . rw data.right
    have shape := List.cases at A, cs with *
    cases shape with empty | cons
    . rw [empty, listTail, length.nil, predecessor.zero]
      rfl
    . obtain ⟨c, coefficient, tail, tailList, equal⟩ := cons
      rw [equal, listTail, length.cons, predecessor.succ]
      rfl

theorem hornerDerivativeLeading.closed (cs : List(A))
  shows hornerDerivativeLeading{A}(add, zero, one, mul, leading, cs) ∈ R
proof
  have ordinary := IsCommRing.ring with ring
  have numeral := IsRing.numeral_closed at A, add, zero, neg, mul, one,
    length{A}(cs) with ordinary
  unfold hornerDerivativeLeading
  exact IsRing.mul_closed with ordinary, numeral, initial

-- The derivative of a constant is the zero pair.
theorem hornerDerivativeLeading.nil
  shows hornerDerivativeLeading{A}(add, zero, one, mul, leading, []) = R[0]
proof
  unfold hornerDerivativeLeading
  rw [length.nil, ringNat.zero]
  ring

end Rings

-- The value laws through an arbitrary coefficient extension f : R → S at
-- a point x of S, so that they hold for values in R and in R[X] alike.
section Extensions
variable (A add zero neg mul one B plus z minus times unit f x leading : Set)
notation ring R := (A, add, zero, neg, mul, one)
notation ring S := (B, plus, z, minus, times, unit)
hypothesis source : IsCommRing(R)
hypothesis target : IsCommRing(S)
hypothesis hom : IsRingHom(f, R, S)
hypothesis element : x ∈ S
hypothesis initial : leading ∈ R

-- Raising the start index by one adds the value of the pair itself.
theorem hornerIndexScale.map_value_succ (start : Nat) (cs : List(A))
  shows monicValue{A}(f, plus, times,
      f(R[ringNat(add, zero, one, succ(start + length{A}(cs))) * leading]), x,
      hornerIndexScale{A}(add, zero, one, mul, succ(start), cs)) =
    S[monicValue{A}(f, plus, times,
        f(R[ringNat(add, zero, one, start + length{A}(cs)) * leading]), x,
        hornerIndexScale{A}(add, zero, one, mul, start, cs)) +
      monicValue{A}(f, plus, times, f(leading), x, cs)]
proof
  induction cs generalizing start
  | List.nil =>
    intros start startNat
    have ordinary := IsCommRing.ring with source
    have next : Nat(succ(start)) by typecheck
    have numeral := IsRing.numeral_closed at A, add, zero, neg, mul, one, start
      with ordinary
    have scaled := IsRing.mul_closed with ordinary, numeral, initial
    have unfolded : R[ringNat(add, zero, one, succ(start)) * leading] =
        R[ringNat(add, zero, one, start) * leading + leading]
      rw ringNat.succ
      ring
    have mapped := IsRingHom.add with hom, scaled, initial
    rw [hornerIndexScale, hornerIndexScale, length.nil, add.right_unit,
      monicValue, monicValue, monicValue, unfolded, mapped]
    rfl
  | List.cons(c, tail) using ih =>
    intros start startNat
    have coefficient : c ∈ R by assumption
    have ordinary := IsCommRing.ring with source
    have next : Nat(succ(start)) by typecheck
    have afterNext : Nat(succ(succ(start))) by typecheck
    have previous := ih with succ(start), next
    have numeral := IsRing.numeral_closed at A, add, zero, neg, mul, one, start
      with ordinary
    have numeralNext := IsRing.numeral_closed at A, add, zero, neg, mul, one,
      succ(start) with ordinary
    have scaled := IsRing.mul_closed with ordinary, numeral, coefficient
    have scaledNext := IsRing.mul_closed with ordinary, numeralNext, coefficient
    have unfolded : R[ringNat(add, zero, one, succ(start)) * c] =
        R[ringNat(add, zero, one, start) * c + c]
      rw ringNat.succ
      ring
    have mapped := IsRingHom.add with hom, scaled, coefficient
    have shiftOne : succ(start + length{A}(c :: tail)) =
        succ(Grace.Core.Nat.Rec.add(succ(start), length{A}(tail)))
      rw length.cons
      arith
    have shiftZero : start + length{A}(c :: tail) =
        Grace.Core.Nat.Rec.add(succ(start), length{A}(tail))
      rw length.cons
      arith
    have leftCons := hornerIndexScale.cons at A, add, zero, one, mul, c,
      succ(start), tail
    have rightCons := hornerIndexScale.cons at A, add, zero, one, mul, c,
      start, tail
    have numeralLeft := IsRing.numeral_closed at A, add, zero, neg, mul, one,
      succ(Grace.Core.Nat.Rec.add(succ(start), length{A}(tail))) with ordinary
    have numeralRight := IsRing.numeral_closed at A, add, zero, neg, mul, one,
      Grace.Core.Nat.Rec.add(succ(start), length{A}(tail)) with ordinary
    have leadLeft := IsRing.mul_closed with ordinary, numeralLeft, initial
    have leadRight := IsRing.mul_closed with ordinary, numeralRight, initial
    have imageLeft := IsRingHom.closed with hom, leadLeft
    have imageRight := IsRingHom.closed with hom, leadRight
    have imageLeading := IsRingHom.closed with hom, initial
    have imageScaled := IsRingHom.closed with hom, scaled
    have imageC := IsRingHom.closed with hom, coefficient
    have dataLeft := hornerIndexScale.data at A, add, zero, neg, mul, one,
      leading, succ(succ(start)), tail with *
    have dataRight := hornerIndexScale.data at A, add, zero, neg, mul, one,
      leading, succ(start), tail with *
    have valueRight := hornerValue.closed at A, add, zero, neg, mul, one, B,
      plus, z, minus, times, unit, f, x,
      f(R[ringNat(add, zero, one, Grace.Core.Nat.Rec.add(succ(start),
        length{A}(tail))) * leading]),
      hornerIndexScale{A}(add, zero, one, mul, succ(start), tail) with *
    have valueTail := hornerValue.closed at A, add, zero, neg, mul, one, B,
      plus, z, minus, times, unit, f, x, f(leading), tail with *
    have outerLeft := hornerValue.cons at A, f, plus, times,
      f(R[ringNat(add, zero, one, succ(Grace.Core.Nat.Rec.add(succ(start),
        length{A}(tail)))) * leading]), x,
      R[ringNat(add, zero, one, succ(start)) * c],
      hornerIndexScale{A}(add, zero, one, mul, succ(succ(start)), tail) with *
    have outerRight := hornerValue.cons at A, f, plus, times,
      f(R[ringNat(add, zero, one, Grace.Core.Nat.Rec.add(succ(start),
        length{A}(tail))) * leading]), x,
      R[ringNat(add, zero, one, start) * c],
      hornerIndexScale{A}(add, zero, one, mul, succ(start), tail) with *
    have original := hornerValue.cons at A, f, plus, times, f(leading), x, c,
      tail with *
    rw [leftCons, rightCons, shiftOne, shiftZero, outerLeft, outerRight,
      original, previous, unfolded, mapped]
    ring

-- At start zero the value is x times the value of the derivative pair.
theorem hornerIndexScale.map_value_zero (cs : List(A))
  shows monicValue{A}(f, plus, times,
      f(R[ringNat(add, zero, one, length{A}(cs)) * leading]), x,
      hornerIndexScale{A}(add, zero, one, mul, (0:N), cs)) =
    S[x * monicValue{A}(f, plus, times,
      f(hornerDerivativeLeading{A}(add, zero, one, mul, leading, cs)), x,
      hornerDerivativeList{A}(add, zero, one, mul, cs))]
proof
  have ordinary := IsCommRing.ring with source
  have zeroIn : R[0] ∈ R by typecheck
  have mappedZero := IsRingHom.zero with hom
  have shape := List.cases at A, cs with *
  cases shape with empty | cons
  . have vanishes : R[ringNat(add, zero, one, (0:N)) * leading] = R[0]
      rw ringNat.zero
      ring
    rw [empty, hornerIndexScale, hornerDerivativeLeading.nil,
      hornerDerivativeList.nil, length.nil, monicValue, monicValue, vanishes,
      mappedZero]
    ring
  . obtain ⟨d, dIn, tail, tailList, equal⟩ := cons
    have scaled : R[ringNat(add, zero, one, (0:N)) * d] = R[0]
      rw ringNat.zero
      ring
    have zeroNat : Nat((0:N)) by typecheck
    have oneNat : Nat((1:N)) by typecheck
    have numeral := IsRing.numeral_closed at A, add, zero, neg, mul, one, (0:N)
      with ordinary
    have scaledIn := IsRing.mul_closed with ordinary, numeral, dIn
    have expansion := hornerIndexScale.cons at A, add, zero, one, mul, d, (0:N),
      tail
    have derivativeList := hornerDerivativeList.cons at A, add, zero, one, mul,
      d, tail
    have lead := hornerDerivativeLeading.closed at A, add, zero, neg, mul, one,
      leading, d :: tail with *
    have image := IsRingHom.closed with hom, lead
    have data := hornerIndexScale.data at A, add, zero, neg, mul, one, leading,
      1, tail with *
    have value := hornerValue.closed at A, add, zero, neg, mul, one, B, plus, z,
      minus, times, unit, f, x,
      f(hornerDerivativeLeading{A}(add, zero, one, mul, leading, d :: tail)),
      hornerIndexScale{A}(add, zero, one, mul, (1:N), tail) with *
    have outer := hornerValue.cons at A, f, plus, times,
      f(hornerDerivativeLeading{A}(add, zero, one, mul, leading, d :: tail)), x,
      R[ringNat(add, zero, one, (0:N)) * d],
      hornerIndexScale{A}(add, zero, one, mul, (1:N), tail) with *
    rw [equal, expansion, derivativeList]
    unfold hornerDerivativeLeading at outer
    unfold hornerDerivativeLeading at value
    unfold hornerDerivativeLeading
    rw [outer, scaled, mappedZero]
    ring

-- (c + X·p)′ = p + X·p′ through the extension.
theorem hornerDerivative.map_value_cons (c : Set) (cs : List(A))
  requires coefficient : c ∈ R
  shows monicValue{A}(f, plus, times,
      f(hornerDerivativeLeading{A}(add, zero, one, mul, leading, c :: cs)), x,
      hornerDerivativeList{A}(add, zero, one, mul, c :: cs)) =
    S[monicValue{A}(f, plus, times, f(leading), x, cs) +
      x * monicValue{A}(f, plus, times,
        f(hornerDerivativeLeading{A}(add, zero, one, mul, leading, cs)), x,
        hornerDerivativeList{A}(add, zero, one, mul, cs))]
proof
  have zeroNat : Nat((0:N)) by typecheck
  have step := hornerIndexScale.map_value_succ at A, add, zero, neg, mul, one,
    B, plus, z, minus, times, unit, f, x, leading, (0:N), cs with *
  have base := hornerIndexScale.map_value_zero at A, add, zero, neg, mul, one,
    B, plus, z, minus, times, unit, f, x, leading, cs with *
  have derivativeList := hornerDerivativeList.cons at A, add, zero, one, mul,
    c, cs
  rw add.left_unit at step
  have lead : hornerDerivativeLeading{A}(add, zero, one, mul, leading,
      c :: cs) =
      R[ringNat(add, zero, one, succ(length{A}(cs))) * leading]
    unfold hornerDerivativeLeading
    rw length.cons
    rfl
  have leadTail := hornerDerivativeLeading.closed at A, add, zero, neg, mul,
    one, leading, cs with *
  have imageTail := IsRingHom.closed with hom, leadTail
  have imageLeading := IsRingHom.closed with hom, initial
  have data := hornerDerivativeList.data at A, add, zero, neg, mul, one,
    leading, cs with *
  have derivativeTail := data.left
  have valueTail := hornerValue.closed at A, add, zero, neg, mul, one, B, plus,
    z, minus, times, unit, f, x, f(leading), cs with *
  have valueDerivative := hornerValue.closed at A, add, zero, neg, mul, one, B,
    plus, z, minus, times, unit, f, x,
    f(hornerDerivativeLeading{A}(add, zero, one, mul, leading, cs)),
    hornerDerivativeList{A}(add, zero, one, mul, cs) with *
  rw [derivativeList, lead, step, base]
  ring

end Extensions

section Values
variable (A add zero neg mul one leading : Set)
notation ring R := (A, add, zero, neg, mul, one)
hypothesis ring : IsCommRing(R)
hypothesis initial : leading ∈ R

-- (c + X·p)′ = p + X·p′, the recursion the analytic derivative follows.
theorem hornerDerivative.value_cons (x c : Set) (cs : List(A))
  requires element : x ∈ R
  requires coefficient : c ∈ R
  shows hornerAt{A}(add, mul,
      hornerDerivativeLeading{A}(add, zero, one, mul, leading, c :: cs), x,
      hornerDerivativeList{A}(add, zero, one, mul, c :: cs)) =
    R[hornerAt{A}(add, mul, leading, x, cs) +
      x * hornerAt{A}(add, mul,
        hornerDerivativeLeading{A}(add, zero, one, mul, leading, cs), x,
        hornerDerivativeList{A}(add, zero, one, mul, cs))]
proof
  have hom := IsRingHom.identity with ring
  have consList : List(A, c :: cs) by typecheck
  have leadCons := hornerDerivativeLeading.closed at A, add, zero, neg, mul,
    one, leading, c :: cs with *
  have leadTail := hornerDerivativeLeading.closed at A, add, zero, neg, mul,
    one, leading, cs with *
  have leadingValue := identity.apply with initial
  have consValue := identity.apply with leadCons
  have tailValue := identity.apply with leadTail
  have expansion := hornerDerivative.map_value_cons at A, add, zero, neg, mul,
    one, A, add, zero, neg, mul, one, identity(A), x, leading, c, cs with *
  rw [leadingValue, consValue, tailValue] at expansion
  unfold hornerAt
  exact expansion

-- The derivative of c + (a + X)·q is q + (a + X)·q′.
theorem hornerDerivative.affine_value (a x c : Set) (ds : List(A))
  requires center : a ∈ R
  requires element : x ∈ R
  requires coefficient : c ∈ R
  shows hornerAt{A}(add, mul,
      hornerDerivativeLeading{A}(add, zero, one, mul, leading,
        hornerAffineProduct{A}(add, mul, leading, a, one, c, ds)), x,
      hornerDerivativeList{A}(add, zero, one, mul,
        hornerAffineProduct{A}(add, mul, leading, a, one, c, ds))) =
    R[hornerAt{A}(add, mul, leading, x, ds) +
      (a + x) * hornerAt{A}(add, mul,
        hornerDerivativeLeading{A}(add, zero, one, mul, leading, ds), x,
        hornerDerivativeList{A}(add, zero, one, mul, ds))]
proof
  have ordinary := IsCommRing.ring with ring
  have oneIn : R[1] ∈ R by typecheck
  induction ds generalizing c
  | List.nil =>
    intros c coefficient
    have product := IsRing.mul_closed with ordinary, center, initial
    have head := IsRing.add_closed with ordinary, coefficient, product
    have empty : List(A, []) by typecheck
    have leadOne : hornerDerivativeLeading{A}(add, zero, one, mul, leading,
        R[c + a * leading] :: []) = leading
      unfold hornerDerivativeLeading
      rw [length.cons, length.nil, ringNat.succ, ringNat.zero]
      ring
    have listOne := hornerDerivativeList.cons at A, add, zero, one, mul,
      R[c + a * leading], []
    have zeroValue := hornerAt.nil at A, add, mul, R[0], x
    rw [hornerAffineProduct, leadOne, listOne, hornerIndexScale,
      hornerDerivativeLeading.nil, hornerDerivativeList.nil, hornerAt.nil,
      zeroValue]
    ring
  | List.cons(d, tail) using ih =>
    intros c coefficient
    have dIn : d ∈ R by assumption
    have next := IsRing.mul_closed with ordinary, oneIn, dIn
    have previous := ih with R[1 * d], next
    have product := IsRing.mul_closed with ordinary, center, dIn
    have head := IsRing.add_closed with ordinary, coefficient, product
    have affine := hornerAffineProduct.data at A, add, zero, neg, mul, one,
      leading, a, one, R[1 * d], tail with *
    have affineList := affine.left
    have outer := hornerDerivative.value_cons at A, add, zero, neg, mul, one,
      leading, x, R[c + a * d],
      hornerAffineProduct{A}(add, mul, leading, a, one, R[1 * d], tail) with *
    have inner := hornerTranslate.affine_value at A, add, zero, neg, mul, one,
      leading, a, x, R[1 * d], tail with *
    have right := hornerDerivative.value_cons at A, add, zero, neg, mul, one,
      leading, x, d, tail with *
    have leadTail := hornerDerivativeLeading.closed at A, add, zero, neg, mul,
      one, leading, tail with *
    have dataTail := hornerDerivativeList.data at A, add, zero, neg, mul, one,
      leading, tail with *
    have tailValue := hornerAt.closed at A, add, zero, neg, mul, one, leading,
      x, tail with *
    have expansion := hornerAt.cons at A, add, mul, leading, x, d, tail with *
    have derivativeValue := hornerAt.closed at A, add, zero, neg, mul, one,
      hornerDerivativeLeading{A}(add, zero, one, mul, leading, tail), x,
      hornerDerivativeList{A}(add, zero, one, mul, tail) with *
    rw [hornerAffineProduct, outer, inner, previous, right, expansion]
    ring

-- The derivative commutes with translation: (p(a + ·))′ = p′(a + ·).
theorem hornerDerivative.translate (a x : Set) (cs : List(A))
  requires center : a ∈ R
  requires element : x ∈ R
  shows hornerAt{A}(add, mul,
      hornerDerivativeLeading{A}(add, zero, one, mul, leading,
        hornerTranslate{A}(add, mul, one, leading, a, cs)), x,
      hornerDerivativeList{A}(add, zero, one, mul,
        hornerTranslate{A}(add, mul, one, leading, a, cs))) =
    hornerAt{A}(add, mul,
      hornerDerivativeLeading{A}(add, zero, one, mul, leading, cs), R[a + x],
      hornerDerivativeList{A}(add, zero, one, mul, cs))
proof
  induction cs
  | List.nil =>
    have zeroValue := hornerAt.nil at A, add, mul, R[0], x
    have shiftedValue := hornerAt.nil at A, add, mul, R[0], R[a + x]
    rw [hornerTranslate, hornerDerivativeLeading.nil, hornerDerivativeList.nil,
      zeroValue, shiftedValue]
    rfl
  | List.cons(c, tail) using ih =>
    have coefficient : c ∈ R by assumption
    have ordinary := IsCommRing.ring with ring
    have shifted := IsRing.add_closed with ordinary, center, element
    have data := hornerTranslate.data at A, add, zero, neg, mul, one, leading,
      a, tail with *
    have translatedList := data.left
    have affine := hornerDerivative.affine_value at A, add, zero, neg, mul, one,
      leading, a, x, c, hornerTranslate{A}(add, mul, one, leading, a, tail)
      with *
    have translated := hornerTranslate.value at A, add, zero, neg, mul, one,
      leading, a, x, tail with *
    have expansion := hornerDerivative.value_cons at A, add, zero, neg, mul,
      one, leading, R[a + x], c, tail with *
    rw [hornerTranslate, affine, translated, ih, expansion]
    rfl

end Values

section Homomorphisms
variable (A add zero neg mul one B plus z minus times unit h leading : Set)
notation ring R := (A, add, zero, neg, mul, one)
notation ring S := (B, plus, z, minus, times, unit)
hypothesis source : IsCommRing(R)
hypothesis target : IsCommRing(S)
hypothesis hom : IsRingHom(h, R, S)
hypothesis initial : leading ∈ R

theorem hornerDerivative.numeral_map (n : Nat)
  shows h(ringNat(add, zero, one, n)) = ringNat(plus, z, unit, n)
proof
  induction n
  | zero =>
    rw [ringNat.zero, ringNat.zero]
    exact IsRingHom.zero with hom
  | succ(k) using ih =>
    have ordinary := IsCommRing.ring with source
    have numeral := IsRing.numeral_closed at A, add, zero, neg, mul, one, k
      with ordinary
    have oneIn : R[1] ∈ R by typecheck
    have mapped := IsRingHom.add with hom, numeral, oneIn
    have unit := IsRingHom.one with hom
    rw [ringNat.succ, ringNat.succ, mapped, ih, unit]
    rfl

theorem hornerIndexScale.map (start : Nat) (cs : List(A))
  shows listMap{A}(h, hornerIndexScale{A}(add, zero, one, mul, start, cs)) =
    hornerIndexScale{B}(plus, z, unit, times, start, listMap{A}(h, cs))
proof
  induction cs generalizing start
  | List.nil =>
    intros start startNat
    rw [hornerIndexScale, listMap, hornerIndexScale]
    rfl
  | List.cons(c, tail) using ih =>
    intros start startNat
    have function := IsRingHom.function with hom
    have coefficient : c ∈ R by assumption
    have ordinary := IsCommRing.ring with source
    have next : Nat(succ(start)) by typecheck
    have previous := ih with succ(start), next
    have numeral := IsRing.numeral_closed at A, add, zero, neg, mul, one, start
      with ordinary
    have scaled := IsRing.mul_closed with ordinary, numeral, coefficient
    have mapped := IsRingHom.mul with hom, numeral, coefficient
    have numeralMap := hornerDerivative.numeral_map at A, add, zero, neg, mul,
      one, B, plus, z, minus, times, unit, h, leading, start with *
    have image := IsRingHom.closed with hom, coefficient
    have tailMap := listMap.closed at A, B, h, tail with *
    have data := hornerIndexScale.data at A, add, zero, neg, mul, one, leading,
      succ(start), tail with *
    rw [hornerIndexScale, listMap, listMap, hornerIndexScale, mapped,
      numeralMap, previous]
    rfl

theorem hornerDerivativeList.map_tail (cs : List(A))
  shows listMap{A}(h, listTail{A}(cs)) = listTail{B}(listMap{A}(h, cs))
proof
  have function := IsRingHom.function with hom
  have shape := List.cases at A, cs with *
  cases shape with empty | cons
  . rw [empty, listTail, listMap, listTail]
    rfl
  . obtain ⟨c, coefficient, tail, tailList, equal⟩ := cons
    have image := IsRingHom.closed with hom, coefficient
    have tailMap := listMap.closed at A, B, h, tail with *
    rw [equal, listTail, listMap, listTail]
    rfl

theorem hornerDerivativeList.map (cs : List(A))
  shows listMap{A}(h, hornerDerivativeList{A}(add, zero, one, mul, cs)) =
    hornerDerivativeList{B}(plus, z, unit, times, listMap{A}(h, cs))
proof
  have oneNat : Nat((1:N)) by typecheck
  have rest := listTail.closed at A, cs with *
  have tails := hornerDerivativeList.map_tail at A, add, zero, neg, mul, one,
    B, plus, z, minus, times, unit, h, leading, cs with *
  have scaled := hornerIndexScale.map at A, add, zero, neg, mul, one, B, plus,
    z, minus, times, unit, h, leading, (1:N), listTail{A}(cs) with *
  unfold hornerDerivativeList
  rw [scaled, tails]
  rfl

theorem hornerDerivativeLeading.map (cs : List(A))
  shows h(hornerDerivativeLeading{A}(add, zero, one, mul, leading, cs)) =
    hornerDerivativeLeading{B}(plus, z, unit, times, h(leading), listMap{A}(h,
      cs))
proof
  have function := IsRingHom.function with hom
  have ordinary := IsCommRing.ring with source
  have numeral := IsRing.numeral_closed at A, add, zero, neg, mul, one,
    length{A}(cs) with ordinary
  have mapped := IsRingHom.mul with hom, numeral, initial
  have numeralMap := hornerDerivative.numeral_map at A, add, zero, neg, mul,
    one, B, plus, z, minus, times, unit, h, leading, length{A}(cs) with *
  have sameLength := listMap.length at A, B, h, cs with *
  unfold hornerDerivativeLeading
  rw [sameLength, mapped, numeralMap]
  rfl

end Homomorphisms

-- The derivative pair in the polynomial ring, from the extension law.
section Polynomials
variable (I A add zero neg mul one j leading : Set)
notation ring R := (A, add, zero, neg, mul, one)
notation ring P := R[I]
hypothesis ring : IsCommRing(R)
hypothesis initial : leading ∈ R

theorem polynomialFromHorner.derivative_cons (c : Set) (cs : List(A))
  requires coefficient : c ∈ R
  shows polynomialFromHorner(I, R, j,
      hornerDerivativeLeading{A}(add, zero, one, mul, leading, c :: cs),
      hornerDerivativeList{A}(add, zero, one, mul, c :: cs)) =
    P[polynomialFromHorner(I, R, j, leading, cs) +
      polynomialVariable(I, R, j) * polynomialFromHorner(I, R, j,
        hornerDerivativeLeading{A}(add, zero, one, mul, leading, cs),
        hornerDerivativeList{A}(add, zero, one, mul, cs))]
proof
  have target := polynomials.comm_ring at I, A, add, zero, neg, mul, one with *
  have hom := polynomialCoefficients.hom at I, A, add, zero, neg, mul, one
    with *
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have oneIn : R[1] ∈ R by typecheck
  have consList : List(A, c :: cs) by typecheck
  have leadCons := hornerDerivativeLeading.closed at A, add, zero, neg, mul,
    one, leading, c :: cs with *
  have leadTail := hornerDerivativeLeading.closed at A, add, zero, neg, mul,
    one, leading, cs with *
  have variable := polynomialVariable.member at I, A, zero, one, j with *
  have first := polynomialCoefficients.value at I, A, zero, leading with *
  have second := polynomialCoefficients.value at I, A, zero,
    hornerDerivativeLeading{A}(add, zero, one, mul, leading, c :: cs) with *
  have third := polynomialCoefficients.value at I, A, zero,
    hornerDerivativeLeading{A}(add, zero, one, mul, leading, cs) with *
  have result := hornerDerivative.map_value_cons at A, add, zero, neg, mul,
    one, P, polynomialAdd(I, R), P[0], polynomialNeg(I, R),
    polynomialMul(I, R), P[1], polynomialCoefficients(I, R),
    polynomialVariable(I, R, j), leading, c, cs with *
  unfold polynomialFromHorner
  cc

end Polynomials

-- The bundled derivative pair over a bundled commutative ring.
section Bundled
variable (R : Set)
hypothesis comm : CommRing(R)

def derivativeList (cs : Set) : Set :=
  hornerDerivativeList{R.carrier}(R.add, R.zero, R.one, R.mul, cs)

section Pair
variable (leading : Set)
hypothesis initial : leading ∈ R

def derivativeLeading (cs : Set) : Set :=
  hornerDerivativeLeading{R.carrier}(R.add, R.zero, R.one, R.mul, leading, cs)

instance derivativeLeading.mem (cs : List(R.carrier))
  shows derivativeLeading(cs) ∈ R
proof
  have parts := CommRing.parts with comm
  unfold derivativeLeading
  exact hornerDerivativeLeading.closed with parts, initial

theorem derivativeList.list (cs : List(R.carrier))
  shows List(R.carrier, derivativeList(cs))
proof
  have parts := CommRing.parts with comm
  have data := hornerDerivativeList.data with parts, initial
  unfold derivativeList
  exact data.left

theorem derivativeList.length (cs : List(R.carrier))
  shows length{R.carrier}(derivativeList(cs)) =
    predecessor(length{R.carrier}(cs))
proof
  have parts := CommRing.parts with comm
  have data := hornerDerivativeList.data with parts, initial
  unfold derivativeList
  exact data.right

theorem horner.derivative_cons (x c : R) (cs : List(R.carrier))
  shows horner(R, derivativeLeading(c :: cs), x, derivativeList(c :: cs)) =
    horner(R, leading, x, cs) +
      x * horner(R, derivativeLeading(cs), x, derivativeList(cs))
proof
  have parts := CommRing.parts with comm
  have xIn : x ∈ R by assumption
  have cIn : c ∈ R by assumption
  rw [horner.graph, horner.graph, horner.graph]
  unfold derivativeLeading
  unfold derivativeList
  exact hornerDerivative.value_cons with parts, initial, xIn, cIn

-- The bridge: the partial derivative in the variable j of the Horner
-- polynomial is the Horner polynomial of the derivative pair.
theorem hornerPolynomial.derivative (I j : Set) (cs : List(R.carrier))
  requires index : j ∈ I
  shows partialDerivative(R, I, j)(hornerPolynomial(R, I, j, leading, cs)) =
    hornerPolynomial(R, I, j, derivativeLeading(cs), derivativeList(cs))
proof
  have parts := CommRing.parts with comm
  have polynomials : CommRing(polynomialRing(R, I)) by typecheck
  have zeroIn : R.zero ∈ R.carrier by typecheck
  induction cs
  | List.nil =>
    have constant : hornerPolynomial(R, I, j, leading, []) =
        polynomialConstant(R, I)(leading)
      rw [hornerPolynomial.graph, polynomialFromHorner.nil,
        polynomialConstant.apply]
      rfl
    have killed := partialDerivative.constant at R, I, j, leading with *
    have leadNil : derivativeLeading([]) = R.zero
      unfold derivativeLeading
      exact hornerDerivativeLeading.nil with parts, initial
    have listNil : derivativeList([]) = []
      unfold derivativeList
      exact hornerDerivativeList.nil
    have zeroConstant : hornerPolynomial(R, I, j, R.zero, []) =
        Ring.zero(polynomialRing(R, I))
      rw [hornerPolynomial.graph, polynomialFromHorner.nil,
        polynomialRing.zeroOf]
      exact polynomialConstant.zero at I, R.carrier, R.zero with *
    rw [constant, killed, leadNil, listNil, zeroConstant]
    rfl
  | List.cons(c, tail) using ih =>
    have cIn : c ∈ R by assumption
    have expansion := hornerPolynomial.cons at R, leading, I, j, c, tail with *
    have tailMem := hornerPolynomial.mem at R, leading, I, j, tail with *
    have constantMem : polynomialConstant(R, I)(c) ∈ polynomialRing(R, I) :=
      polynomialConstant.mem at R, I, c with *
    have variableMem : X(R, I, j) ∈ polynomialRing(R, I) :=
      X.mem at R, I, j with *
    have productMem : X(R, I, j) * hornerPolynomial(R, I, j, leading, tail) ∈
      polynomialRing(R, I) := Ring.mul_mem with *
    have additive := partialDerivative.add at R, I, j,
      polynomialConstant(R, I)(c),
      X(R, I, j) * hornerPolynomial(R, I, j, leading, tail) with *
    have killed := partialDerivative.constant at R, I, j, c with *
    have leibniz := partialDerivative.X_self_mul at R, I, j,
      hornerPolynomial(R, I, j, leading, tail) with *
    have engine := polynomialFromHorner.derivative_cons at I, R.carrier, R.add,
      R.zero, R.neg, R.mul, R.one, j, leading, c, tail with *
    have derivativeMem : partialDerivative(R, I, j)(hornerPolynomial(R, I, j,
      leading, tail)) ∈ polynomialRing(R, I) :=
      partialDerivative.map_mem at R, I, j,
        hornerPolynomial(R, I, j, leading, tail) with *
    have bundled : hornerPolynomial(R, I, j, derivativeLeading(c :: tail),
        derivativeList(c :: tail)) =
        hornerPolynomial(R, I, j, leading, tail) +
          X(R, I, j) * hornerPolynomial(R, I, j, derivativeLeading(tail),
            derivativeList(tail))
      unfold derivativeLeading
      unfold derivativeList
      rw [hornerPolynomial.graph, hornerPolynomial.graph,
        hornerPolynomial.graph, polynomialRing.addOf, polynomialRing.mulOf,
        X.value]
      exact engine
    have derivativeTailList := derivativeList.list at R, leading, tail with *
    have derivativeTailLead : derivativeLeading(tail) ∈ R :=
      derivativeLeading.mem at R, leading, tail with *
    have derivativeTailMem : hornerPolynomial(R, I, j, derivativeLeading(tail),
      derivativeList(tail)) ∈ polynomialRing(R, I) :=
      hornerPolynomial.mem at R, derivativeLeading(tail), I, j,
        derivativeList(tail) with *
    rw [expansion, additive, killed, leibniz, ih, bundled]
    ring

end Pair
end Bundled
