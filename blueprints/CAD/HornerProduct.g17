-- Negation, subtraction, padded addition, and the product of Horner
-- coefficient lists over a commutative ring: the full coefficient list of
-- a pair, hornerNeg, hornerSub for lists of one length, the value of a
-- padded hornerAdd, and hornerMulList with its closure, length, value,
-- transport under ring homomorphisms, and the bridge to the product of
-- the polynomial ring.
-- Part of the CAD blueprint.
-- Planned home: Algebra/Polynomial/HornerProduct.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module CAD.HornerProduct
import Grace.Cumulus.Algebra.Polynomial.HornerArithmetic
import Grace.Cumulus.Algebra.Polynomial.HornerHom
import Grace.Cumulus.Algebra.Polynomial.BundledRoots
import Grace.Cumulus.Nat.Order

-- The full coefficient list c₀, …, c_{n−1}, leading of the pair.
def hornerFullList {A : Set} (leading : Set) (cs : List(A)) : Set :=
  append{A}(leading :: [], cs)

def hornerNeg {A : Set} (neg : Set) (cs : List(A)) : Set := listMap{A}(neg, cs)

-- Subtraction of lists of the same length, entry by entry.
def hornerSub {A : Set} (add zero neg : Set) (cs ds : List(A)) : Set :=
  hornerAdd{A}(add, zero, cs, hornerNeg{A}(neg, ds))

-- The lower coefficients of (a, cs)·(b, ds), by recursion on ds:
-- p·(d + X·q) = d·p + X·(p·q); the leading coefficient is a·b and the
-- length is length(cs) + length(ds).
def hornerMulList {A : Set} (add zero mul a b : Set)
    (cs ds : List(A)) → Set
  | add, zero, mul, a, b, cs, List.nil => hornerScale{A}(mul, b, cs)
  | add, zero, mul, a, b, cs, List.cons(d, tail) =>
      hornerAdd{A}(add, zero,
        zero :: hornerMulList(add, zero, mul, a, b, cs, tail),
        hornerScale{A}(mul, d, hornerFullList{A}(a, cs)))
  descends ds

theorem hornerFullList.length (A leading : Set) (cs : List(A))
  shows length{A}(hornerFullList{A}(leading, cs)) = succ(length{A}(cs))
proof
  induction cs
  | List.nil =>
    unfold hornerFullList
    simp [append, length]
  | List.cons(c, tail) using ih =>
    have coefficient : c ∈ A by assumption
    unfold hornerFullList at ih
    unfold hornerFullList
    simp [append, length, ih]

theorem hornerFullList.list (A leading : Set) (cs : List(A))
  requires initial : leading ∈ A
  shows List(A, hornerFullList{A}(leading, cs))
proof
  have single : List(A, leading :: []) by typecheck
  unfold hornerFullList
  typecheck

theorem hornerMulList.nil (A add zero mul a b : Set) (cs : List(A))
  shows hornerMulList{A}(add, zero, mul, a, b, cs, []) =
    hornerScale{A}(mul, b, cs)
proof
  rw hornerMulList
  rfl

theorem hornerMulList.cons (A add zero mul a b d : Set) (cs tail : List(A))
  shows hornerMulList{A}(add, zero, mul, a, b, cs, d :: tail) =
    hornerAdd{A}(add, zero,
      zero :: hornerMulList{A}(add, zero, mul, a, b, cs, tail),
      hornerScale{A}(mul, d, hornerFullList{A}(a, cs)))
proof
  rw hornerMulList
  rfl

section Rings
variable (A add zero neg mul one : Set)
notation ring R := (A, add, zero, neg, mul, one)
hypothesis ring : IsCommRing(R)

-- The value of the full list with leading zero is the value of the pair.
theorem hornerFullList.value (leading x : Set) (cs : List(A))
  requires initial : leading ∈ R
  requires element : x ∈ R
  shows hornerAt{A}(add, mul, zero, x, hornerFullList{A}(leading, cs)) =
    hornerAt{A}(add, mul, leading, x, cs)
proof
  induction cs
  | List.nil =>
    have empty : List(A, []) by typecheck
    unfold hornerFullList
    rw [append, hornerAt.cons, hornerAt.nil, hornerAt.nil]
    ring
  | List.cons(c, tail) using ih =>
    have coefficient : c ∈ R by assumption
    have full := hornerFullList.list at A, leading, tail with *
    unfold hornerFullList at full
    unfold hornerFullList at ih
    unfold hornerFullList
    rw [append, hornerAt.cons, hornerAt.cons, ih]
    rfl

theorem hornerNeg.data (cs : List(A))
  shows List(A, hornerNeg{A}(neg, cs)) ∧
    length{A}(hornerNeg{A}(neg, cs)) = length{A}(cs)
proof
  induction cs
  | List.nil =>
    unfold hornerNeg
    rw listMap
    constructor
    . typecheck
    . rfl
  | List.cons(c, tail) using ih =>
    have coefficient : c ∈ R by assumption
    have ordinary := IsCommRing.ring with ring
    have head := IsRing.neg_closed with ordinary, coefficient
    unfold hornerNeg at ih
    unfold hornerNeg
    rw listMap
    constructor
    . typecheck
    . rw [length.cons, ih.right, length.cons]
      rfl

theorem hornerNeg.value (leading x : Set) (cs : List(A))
  requires initial : leading ∈ R
  requires element : x ∈ R
  shows hornerAt{A}(add, mul, neg(leading), x, hornerNeg{A}(neg, cs)) =
    R[-hornerAt{A}(add, mul, leading, x, cs)]
proof
  induction cs
  | List.nil =>
    unfold hornerNeg
    rw [listMap, hornerAt.nil, hornerAt.nil]
    rfl
  | List.cons(c, tail) using ih =>
    have coefficient : c ∈ R by assumption
    have ordinary := IsCommRing.ring with ring
    have head := IsRing.neg_closed with ordinary, coefficient
    have rest := hornerNeg.data at A, add, zero, neg, mul, one, tail with *
    have tailValue := hornerAt.closed at A, add, zero, neg, mul, one, leading,
      x, tail with *
    unfold hornerNeg at ih
    unfold hornerNeg at rest
    unfold hornerNeg
    rw [listMap, hornerAt.cons, hornerAt.cons, ih]
    ring

theorem hornerSub.data (cs ds : List(A))
  shows List(A, hornerSub{A}(add, zero, neg, cs, ds)) ∧
    length{A}(hornerSub{A}(add, zero, neg, cs, ds)) = length{A}(cs)
proof
  have negated := hornerNeg.data at A, add, zero, neg, mul, one, ds with *
  have negList := negated.left
  unfold hornerSub
  exact hornerAdd.data at A, add, zero, neg, mul, one, cs,
    hornerNeg{A}(neg, ds) with *

theorem hornerSub.value (a b x : Set) (cs ds : List(A))
  requires left : a ∈ R
  requires right : b ∈ R
  requires element : x ∈ R
  requires sameLength : length{A}(cs) = length{A}(ds)
  shows hornerAt{A}(add, mul, R[a - b], x, hornerSub{A}(add, zero, neg, cs,
    ds)) =
    R[hornerAt{A}(add, mul, a, x, cs) - hornerAt{A}(add, mul, b, x, ds)]
proof
  have ordinary := IsCommRing.ring with ring
  have negative := IsRing.neg_closed with ordinary, right
  have negated := hornerNeg.data at A, add, zero, neg, mul, one, ds with *
  have negList := negated.left
  have lengths : length{A}(cs) = length{A}(hornerNeg{A}(neg, ds))
    rw negated.right
    exact sameLength
  have difference := IsRing.add_closed with ordinary, left, negative
  have hom := IsRingHom.identity with ring
  have mapped := hornerAdd.map_value at A, add, zero, neg, mul, one, A, add,
    zero, neg, mul, one, identity(A), x, a, neg(b), cs, hornerNeg{A}(neg, ds)
    with *
  have sameA := identity.apply with left
  have sameB := identity.apply with negative
  have sameDifference := identity.apply with difference
  rw [sameA, sameB, sameDifference] at mapped
  have negValue := hornerNeg.value at A, add, zero, neg, mul, one, b, x, ds
    with *
  unfold hornerAt at negValue
  unfold hornerSub
  unfold hornerAt
  rw [mapped, negValue]
  rfl

theorem hornerScale.value (a b x : Set) (cs : List(A))
  requires scalar : a ∈ R
  requires initial : b ∈ R
  requires element : x ∈ R
  shows hornerAt{A}(add, mul, R[a * b], x, hornerScale{A}(mul, a, cs)) =
    R[a * hornerAt{A}(add, mul, b, x, cs)]
proof
  have ordinary := IsCommRing.ring with ring
  have product := IsRing.mul_closed with ordinary, scalar, initial
  have hom := IsRingHom.identity with ring
  have mapped := hornerScale.map_value at A, add, zero, neg, mul, one, A, add,
    zero, neg, mul, one, identity(A), x, a, b, cs with *
  have sameA := identity.apply with scalar
  have sameB := identity.apply with initial
  have sameProduct := identity.apply with product
  rw [sameA, sameB, sameProduct] at mapped
  unfold hornerAt
  exact mapped

theorem hornerAdd.value (a b x : Set) (cs ds : List(A))
  requires left : a ∈ R
  requires right : b ∈ R
  requires element : x ∈ R
  requires sameLength : length{A}(cs) = length{A}(ds)
  shows hornerAt{A}(add, mul, R[a + b], x, hornerAdd{A}(add, zero, cs, ds)) =
    R[hornerAt{A}(add, mul, a, x, cs) + hornerAt{A}(add, mul, b, x, ds)]
proof
  have ordinary := IsCommRing.ring with ring
  have sum := IsRing.add_closed with ordinary, left, right
  have hom := IsRingHom.identity with ring
  have mapped := hornerAdd.map_value at A, add, zero, neg, mul, one, A, add,
    zero, neg, mul, one, identity(A), x, a, b, cs, ds with *
  have sameA := identity.apply with left
  have sameB := identity.apply with right
  have sameSum := identity.apply with sum
  rw [sameA, sameB, sameSum] at mapped
  unfold hornerAt
  exact mapped

-- The value of a list with leading zero, split at its head.
theorem hornerAt.head_tail (x : Set) (ds : List(A))
  requires element : x ∈ R
  shows hornerAt{A}(add, mul, zero, x, ds) =
    R[listHeadOr{A}(zero, ds) + x * hornerAt{A}(add, mul, zero, x,
      listTail{A}(ds))]
proof
  have shape := List.cases with *
  cases shape with empty | nonempty
  . rw [empty, listHeadOr, listTail, hornerAt.nil]
    ring
  . obtain ⟨e, he, rest, restList, equal⟩ := nonempty
    rw [equal, listHeadOr, listTail, hornerAt.cons]
    rfl

-- A shorter second list is added as a polynomial with leading zero.
theorem hornerAdd.value_short (a x : Set) (cs ds : List(A))
  requires initial : a ∈ R
  requires element : x ∈ R
  requires shorter : length{A}(ds) ≤ length{A}(cs)
  shows hornerAt{A}(add, mul, a, x, hornerAdd{A}(add, zero, cs, ds)) =
    R[hornerAt{A}(add, mul, a, x, cs) + hornerAt{A}(add, mul, zero, x, ds)]
proof
  induction cs generalizing ds
  | List.nil =>
    intros ds dsList shorter
    rw length.nil at shorter
    have empty : ds = []
      have shape := List.cases with *
      cases shape with empty | nonempty
      . exact empty
      . obtain ⟨e, he, rest, restList, equal⟩ := nonempty
        rw [equal, length.cons] at shorter
        have impossible : (0 : Nat) < (0 : Nat)
          arith
        exfalso
        have irreflexive := Less.irreflexive with Naturals.constructor.zero
        exact irreflexive with impossible
    rw [empty, hornerAdd, hornerAt.nil, hornerAt.nil]
    ring
  | List.cons(c, tail) using ih =>
    intros ds dsList shorter
    have coefficient : c ∈ R by assumption
    have ordinary := IsCommRing.ring with ring
    have zeroIn := IsRing.zero_in_carrier with ordinary
    have headIn := listHeadOr.closed at A, zero, ds with *
    have rest := listTail.closed at A, ds with *
    have shorterTail : length{A}(listTail{A}(ds)) ≤ length{A}(tail)
      have shape := List.cases at A, ds with *
      cases shape with empty | nonempty
      . rw [empty, listTail, length.nil]
        arith
      . obtain ⟨e, he, front, frontList, equal⟩ := nonempty
        rw [equal, listTail]
        rw [equal, length.cons, length.cons] at shorter
        arith
    have previous := ih with listTail{A}(ds), rest, shorterTail
    have added := hornerAdd.data at A, add, zero, neg, mul, one, tail,
      listTail{A}(ds) with *
    have addedList := added.left
    have head := IsRing.add_closed with ordinary, coefficient, headIn
    have tailValue := hornerAt.closed at A, add, zero, neg, mul, one, a, x,
      tail with *
    have restValue := hornerAt.closed at A, add, zero, neg, mul, one, zero, x,
      listTail{A}(ds) with *
    have split := hornerAt.head_tail at A, add, zero, neg, mul, one, x, ds
      with *
    rw [hornerAdd, hornerAt.cons, hornerAt.cons, previous, split]
    ring

theorem hornerMulList.data (a b : Set) (cs ds : List(A))
  requires left : a ∈ R
  requires right : b ∈ R
  shows List(A, hornerMulList{A}(add, zero, mul, a, b, cs, ds)) ∧
    length{A}(hornerMulList{A}(add, zero, mul, a, b, cs, ds)) =
      length{A}(cs) + length{A}(ds)
proof
  induction ds
  | List.nil =>
    have scaled := hornerScale.data at A, add, zero, neg, mul, one, b, cs
      with *
    rw [hornerMulList, scaled.right, length.nil, add.right_unit]
    exact ⟨scaled.left, rfl⟩
  | List.cons(d, tail) using ih =>
    have coefficient : d ∈ R by assumption
    have ordinary := IsCommRing.ring with ring
    have zeroIn := IsRing.zero_in_carrier with ordinary
    have full := hornerFullList.list at A, a, cs with *
    have scaled := hornerScale.data at A, add, zero, neg, mul, one, d,
      hornerFullList{A}(a, cs) with *
    have scaledList := scaled.left
    have previous := ih.left
    have extended : List(A, zero :: hornerMulList{A}(add, zero, mul, a, b, cs,
      tail)) by typecheck
    have added := hornerAdd.data at A, add, zero, neg, mul, one,
      zero :: hornerMulList{A}(add, zero, mul, a, b, cs, tail),
      hornerScale{A}(mul, d, hornerFullList{A}(a, cs)) with *
    rw [hornerMulList, added.right, length.cons, ih.right, length.cons,
      add.succ_right]
    exact ⟨added.left, rfl⟩

theorem hornerMulList.value (a b x : Set) (cs ds : List(A))
  requires left : a ∈ R
  requires right : b ∈ R
  requires element : x ∈ R
  shows hornerAt{A}(add, mul, R[a * b], x, hornerMulList{A}(add, zero, mul, a,
    b, cs, ds)) =
    R[hornerAt{A}(add, mul, a, x, cs) * hornerAt{A}(add, mul, b, x, ds)]
proof
  induction ds
  | List.nil =>
    have scaled := hornerScale.value at A, add, zero, neg, mul, one, b, a, x,
      cs with *
    have commuted : R[a * b] = R[b * a] by ring
    have value := hornerAt.closed at A, add, zero, neg, mul, one, a, x, cs
      with *
    rw [hornerMulList, commuted, scaled, hornerAt.nil]
    ring
  | List.cons(d, tail) using ih =>
    have coefficient : d ∈ R by assumption
    have ordinary := IsCommRing.ring with ring
    have zeroIn := IsRing.zero_in_carrier with ordinary
    have product := IsRing.mul_closed with ordinary, left, right
    have full := hornerFullList.list at A, a, cs with *
    have scaled := hornerScale.data at A, add, zero, neg, mul, one, d,
      hornerFullList{A}(a, cs) with *
    have scaledList := scaled.left
    have rest := hornerMulList.data at A, add, zero, neg, mul, one, a, b, cs,
      tail with *
    have restList := rest.left
    have extended : List(A, zero :: hornerMulList{A}(add, zero, mul, a, b, cs,
      tail)) by typecheck
    have shorter : length{A}(hornerScale{A}(mul, d, hornerFullList{A}(a, cs)))
      ≤ length{A}(zero :: hornerMulList{A}(add, zero, mul, a, b, cs, tail))
      rw [scaled.right, hornerFullList.length, length.cons, rest.right]
      arith
    have added := hornerAdd.value_short at A, add, zero, neg, mul, one,
      R[a * b], x, zero :: hornerMulList{A}(add, zero, mul, a, b, cs, tail),
      hornerScale{A}(mul, d, hornerFullList{A}(a, cs)) with *
    have scaledValue := hornerScale.value at A, add, zero, neg, mul, one, d,
      zero, x, hornerFullList{A}(a, cs) with *
    have zeroProduct : R[d * zero] = zero by ring
    have fullValue := hornerFullList.value at A, add, zero, neg, mul, one, a,
      x, cs with *
    have value := hornerAt.closed at A, add, zero, neg, mul, one, a, x, cs
      with *
    have tailValue := hornerAt.closed at A, add, zero, neg, mul, one, b, x,
      tail with *
    rw zeroProduct at scaledValue
    rw [hornerMulList, added, hornerAt.cons, ih, scaledValue, fullValue,
      hornerAt.cons]
    ring

end Rings

section Homomorphisms
variable (A add zero neg mul one B plus z minus times unit h : Set)
notation ring R := (A, add, zero, neg, mul, one)
notation ring S := (B, plus, z, minus, times, unit)
hypothesis source : IsCommRing(R)
hypothesis target : IsCommRing(S)
hypothesis hom : IsRingHom(h, R, S)

-- Transport of the list operations, entry by entry.
theorem hornerAdd.head_map (ds : List(A))
  shows h(listHeadOr{A}(zero, ds)) = listHeadOr{B}(z, listMap{A}(h, ds))
proof
  have shape := List.cases at A, ds with *
  cases shape with empty | nonempty
  . rw [empty, listHeadOr, listMap, listHeadOr]
    exact IsRingHom.zero with hom
  . obtain ⟨e, he, rest, restList, equal⟩ := nonempty
    have image := IsRingHom.closed with hom, he
    rw [equal, listHeadOr, listMap, listHeadOr]
    rfl

theorem hornerAdd.tail_map (ds : List(A))
  shows listMap{A}(h, listTail{A}(ds)) = listTail{B}(listMap{A}(h, ds))
proof
  have shape := List.cases at A, ds with *
  cases shape with empty | nonempty
  . rw [empty, listTail, listMap, listTail]
    rfl
  . obtain ⟨e, he, rest, restList, equal⟩ := nonempty
    have image := IsRingHom.closed with hom, he
    rw [equal, listTail, listMap, listTail]
    rfl

theorem hornerScale.map (a : Set) (cs : List(A))
  requires scalar : a ∈ R
  shows listMap{A}(h, hornerScale{A}(mul, a, cs)) =
    hornerScale{B}(times, h(a), listMap{A}(h, cs))
proof
  induction cs
  | List.nil =>
    rw [hornerScale, listMap, hornerScale]
    rfl
  | List.cons(c, tail) using ih =>
    have coefficient : c ∈ R by assumption
    have ordinary := IsCommRing.ring with source
    have head := IsRing.mul_closed with ordinary, scalar, coefficient
    have image := IsRingHom.closed with hom, coefficient
    have rest := hornerScale.data at A, add, zero, neg, mul, one, a, tail
      with *
    have restList := rest.left
    have mapped := IsRingHom.mul with hom, scalar, coefficient
    rw [hornerScale, listMap, listMap, hornerScale, ih, mapped]
    rfl

theorem hornerAdd.map (cs ds : List(A))
  shows listMap{A}(h, hornerAdd{A}(add, zero, cs, ds)) =
    hornerAdd{B}(plus, z, listMap{A}(h, cs), listMap{A}(h, ds))
proof
  induction cs generalizing ds
  | List.nil =>
    intros ds dsList
    rw [hornerAdd, listMap, hornerAdd]
    rfl
  | List.cons(c, tail) using ih =>
    intros ds dsList
    have coefficient : c ∈ R by assumption
    have ordinary := IsCommRing.ring with source
    have zeroIn := IsRing.zero_in_carrier with ordinary
    have headIn := listHeadOr.closed at A, zero, ds with *
    have head := IsRing.add_closed with ordinary, coefficient, headIn
    have image := IsRingHom.closed with hom, coefficient
    have rest := listTail.closed at A, ds with *
    have added := hornerAdd.data at A, add, zero, neg, mul, one, tail,
      listTail{A}(ds) with *
    have addedList := added.left
    have previous := ih with listTail{A}(ds), rest
    have mapped := IsRingHom.add with hom, coefficient, headIn
    have headMap := hornerAdd.head_map at A, add, zero, neg, mul, one, B, plus, z,
      minus, times, unit, h, ds with *
    have tailMap := hornerAdd.tail_map at A, add, zero, neg, mul, one, B, plus, z,
      minus, times, unit, h, ds with *
    rw [hornerAdd, listMap, listMap, hornerAdd, previous, mapped, headMap,
      tailMap]
    rfl

theorem hornerFullList.map (leading : Set) (cs : List(A))
  requires initial : leading ∈ R
  shows listMap{A}(h, hornerFullList{A}(leading, cs)) =
    hornerFullList{B}(h(leading), listMap{A}(h, cs))
proof
  have image := IsRingHom.closed with hom, initial
  induction cs
  | List.nil =>
    unfold hornerFullList
    simp [append, listMap]
  | List.cons(c, tail) using ih =>
    have coefficient : c ∈ R by assumption
    have imageC := IsRingHom.closed with hom, coefficient
    have function := IsRingHom.function with hom
    have mappedTail := listMap.closed at A, B, h, tail with *
    have full := hornerFullList.list at A, leading, tail with *
    have mappedFull := hornerFullList.list at B, h(leading),
      listMap{A}(h, tail) with *
    unfold hornerFullList at full
    unfold hornerFullList at mappedFull
    unfold hornerFullList at ih
    unfold hornerFullList
    rw [append, listMap, ih, listMap, append]
    rfl

theorem hornerNeg.map (cs : List(A))
  shows listMap{A}(h, hornerNeg{A}(neg, cs)) = hornerNeg{B}(minus,
    listMap{A}(h, cs))
proof
  induction cs
  | List.nil =>
    unfold hornerNeg
    rw [listMap, listMap, listMap]
    rfl
  | List.cons(c, tail) using ih =>
    have coefficient : c ∈ R by assumption
    have ordinary := IsCommRing.ring with source
    have negated := IsRing.neg_closed with ordinary, coefficient
    have image := IsRingHom.closed with hom, coefficient
    have rest := hornerNeg.data at A, add, zero, neg, mul, one, tail with *
    have restList := rest.left
    have mapped := IsRingHom.neg with hom, coefficient
    unfold hornerNeg at ih
    unfold hornerNeg at restList
    unfold hornerNeg
    rw [listMap, listMap, listMap, listMap, ih, mapped]
    rfl

theorem hornerMulList.map (a b : Set) (cs ds : List(A))
  requires left : a ∈ R
  requires right : b ∈ R
  shows listMap{A}(h, hornerMulList{A}(add, zero, mul, a, b, cs, ds)) =
    hornerMulList{B}(plus, z, times, h(a), h(b), listMap{A}(h, cs),
      listMap{A}(h, ds))
proof
  induction ds
  | List.nil =>
    have scaled := hornerScale.map at A, add, zero, neg, mul, one, B, plus,
      z, minus, times, unit, h, b, cs with *
    rw [hornerMulList, listMap, hornerMulList, scaled]
    rfl
  | List.cons(d, tail) using ih =>
    have coefficient : d ∈ R by assumption
    have ordinary := IsCommRing.ring with source
    have zeroIn := IsRing.zero_in_carrier with ordinary
    have image := IsRingHom.closed with hom, coefficient
    have full := hornerFullList.list at A, a, cs with *
    have scaled := hornerScale.data at A, add, zero, neg, mul, one, d,
      hornerFullList{A}(a, cs) with *
    have scaledList := scaled.left
    have rest := hornerMulList.data at A, add, zero, neg, mul, one, a, b, cs,
      tail with *
    have restList := rest.left
    have extended : List(A, zero :: hornerMulList{A}(add, zero, mul, a, b, cs,
      tail)) by typecheck
    have added := hornerAdd.map at A, add, zero, neg, mul, one, B, plus, z,
      minus, times, unit, h,
      zero :: hornerMulList{A}(add, zero, mul, a, b, cs, tail),
      hornerScale{A}(mul, d, hornerFullList{A}(a, cs)) with *
    have scaledMap := hornerScale.map at A, add, zero, neg, mul, one, B, plus,
      z, minus, times, unit, h, d, hornerFullList{A}(a, cs) with *
    have fullMap := hornerFullList.map at A, add, zero, neg, mul, one, B, plus,
      z, minus, times, unit, h, a, cs with *
    have zeroMap := IsRingHom.zero with hom
    rw [hornerMulList, listMap, hornerMulList, added, listMap, ih, scaledMap,
      fullMap, zeroMap]
    rfl

end Homomorphisms

section Polynomials
variable (I A add zero neg mul one j : Set)
notation ring R := (A, add, zero, neg, mul, one)
notation ring P := R[I]
hypothesis ring : IsCommRing(R)

-- The pair as a Horner value in the polynomial ring itself, with the
-- coefficients embedded as constants.
theorem polynomialFromHorner.as_horner (a : Set) (cs : List(A))
  requires initial : a ∈ R
  shows polynomialFromHorner(I, R, j, a, cs) =
    hornerAt{P}(polynomialAdd(I, R), polynomialMul(I, R),
      polynomialConstant(I, R, a), polynomialVariable(I, R, j),
      listMap{A}(polynomialCoefficients(I, R), cs))
proof
  induction cs
  | List.nil =>
    unfold polynomialFromHorner
    rw [listMap, monicValue, hornerAt.nil]
    rfl
  | List.cons(c, tail) using ih =>
    have coefficient : c ∈ R by assumption
    have hom := polynomialCoefficients.hom at I, A, add, zero, neg, mul, one
      with *
    have function := IsRingHom.function with hom
    have mapped := listMap.closed at A, P, polynomialCoefficients(I, R), tail
      with *
    have image := IsRingHom.closed with hom, coefficient
    unfold polynomialFromHorner at ih
    unfold polynomialFromHorner
    rw [listMap, monicValue, hornerAt.cons, ih]
    rfl

theorem polynomialFromHorner.neg (a : Set) (cs : List(A))
  requires initial : a ∈ R
  shows polynomialFromHorner(I, R, j, neg(a), hornerNeg{A}(neg, cs)) =
    P[-polynomialFromHorner(I, R, j, a, cs)]
proof
  have target := polynomials.comm_ring at I, A, add, zero, neg, mul, one
    with *
  have hom := polynomialCoefficients.hom at I, A, add, zero, neg, mul, one
    with *
  have function := IsRingHom.function with hom
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have oneIn : R[1] ∈ R by typecheck
  have negated := IsRing.neg_closed with ordinary, initial
  have negList := hornerNeg.data at A, add, zero, neg, mul, one, cs with *
  have negatedList := negList.left
  have variable := polynomialVariable.member at I, A, zero, one, j with *
  have constant := polynomialConstant.member at I, A, zero, a with *
  have mapped := listMap.closed at A, P, polynomialCoefficients(I, R), cs
    with *
  have first := polynomialFromHorner.as_horner at I, A, add, zero, neg, mul,
    one, j, a, cs with *
  have second := polynomialFromHorner.as_horner at I, A, add, zero, neg, mul,
    one, j, neg(a), hornerNeg{A}(neg, cs) with *
  have transported := hornerNeg.map at A, add, zero, neg, mul, one, P,
    polynomialAdd(I, R), P[0], polynomialNeg(I, R), polynomialMul(I, R), P[1],
    polynomialCoefficients(I, R), cs with *
  have value := hornerNeg.value at P, polynomialAdd(I, R), P[0],
    polynomialNeg(I, R), polynomialMul(I, R), P[1], polynomialConstant(I, R, a),
    polynomialVariable(I, R, j), listMap{A}(polynomialCoefficients(I, R), cs)
    with *
  have constantNeg := IsRingHom.neg with hom, initial
  have valueA := polynomialCoefficients.value at I, A, zero, a with *
  have valueNeg := polynomialCoefficients.value at I, A, zero, neg(a) with *
  rw [valueA, valueNeg] at constantNeg
  rw [first, second, transported, constantNeg, value]
  rfl

theorem polynomialFromHorner.full_list (a : Set) (cs : List(A))
  requires initial : a ∈ R
  shows polynomialFromHorner(I, R, j, zero, hornerFullList{A}(a, cs)) =
    polynomialFromHorner(I, R, j, a, cs)
proof
  have target := polynomials.comm_ring at I, A, add, zero, neg, mul, one
    with *
  have hom := polynomialCoefficients.hom at I, A, add, zero, neg, mul, one
    with *
  have function := IsRingHom.function with hom
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have oneIn : R[1] ∈ R by typecheck
  have variable := polynomialVariable.member at I, A, zero, one, j with *
  have constant := polynomialConstant.member at I, A, zero, a with *
  have mapped := listMap.closed at A, P, polynomialCoefficients(I, R), cs
    with *
  have first := polynomialFromHorner.as_horner at I, A, add, zero, neg, mul,
    one, j, a, cs with *
  have second := polynomialFromHorner.as_horner at I, A, add, zero, neg, mul,
    one, j, zero, hornerFullList{A}(a, cs) with *
  have transported := hornerFullList.map at A, add, zero, neg, mul, one, P,
    polynomialAdd(I, R), P[0], polynomialNeg(I, R), polynomialMul(I, R), P[1],
    polynomialCoefficients(I, R), a, cs with *
  have value := hornerFullList.value at P, polynomialAdd(I, R), P[0],
    polynomialNeg(I, R), polynomialMul(I, R), P[1], polynomialConstant(I, R, a),
    polynomialVariable(I, R, j), listMap{A}(polynomialCoefficients(I, R), cs)
    with *
  have constantZero := IsRingHom.zero with hom
  have valueA := polynomialCoefficients.value at I, A, zero, a with *
  have valueZero := polynomialCoefficients.value at I, A, zero, zero with *
  rw valueZero at constantZero
  rw [first, second, transported, constantZero, valueA, value]
  rfl

theorem polynomialFromHorner.mul (a b : Set) (cs ds : List(A))
  requires left : a ∈ R
  requires right : b ∈ R
  shows polynomialFromHorner(I, R, j, R[a * b], hornerMulList{A}(add, zero,
    mul, a, b, cs, ds)) =
    P[polynomialFromHorner(I, R, j, a, cs) * polynomialFromHorner(I, R, j, b,
      ds)]
proof
  have target := polynomials.comm_ring at I, A, add, zero, neg, mul, one
    with *
  have hom := polynomialCoefficients.hom at I, A, add, zero, neg, mul, one
    with *
  have function := IsRingHom.function with hom
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have oneIn : R[1] ∈ R by typecheck
  have product := IsRing.mul_closed with ordinary, left, right
  have productData := hornerMulList.data at A, add, zero, neg, mul, one, a, b,
    cs, ds with *
  have productList := productData.left
  have variable := polynomialVariable.member at I, A, zero, one, j with *
  have constantA := polynomialConstant.member at I, A, zero, a with *
  have constantB := polynomialConstant.member at I, A, zero, b with *
  have mappedCs := listMap.closed at A, P, polynomialCoefficients(I, R), cs
    with *
  have mappedDs := listMap.closed at A, P, polynomialCoefficients(I, R), ds
    with *
  have first := polynomialFromHorner.as_horner at I, A, add, zero, neg, mul,
    one, j, a, cs with *
  have second := polynomialFromHorner.as_horner at I, A, add, zero, neg, mul,
    one, j, b, ds with *
  have third := polynomialFromHorner.as_horner at I, A, add, zero, neg, mul,
    one, j, R[a * b], hornerMulList{A}(add, zero, mul, a, b, cs, ds) with *
  have transported := hornerMulList.map at A, add, zero, neg, mul, one, P,
    polynomialAdd(I, R), P[0], polynomialNeg(I, R), polynomialMul(I, R), P[1],
    polynomialCoefficients(I, R), a, b, cs, ds with *
  have value := hornerMulList.value at P, polynomialAdd(I, R), P[0],
    polynomialNeg(I, R), polynomialMul(I, R), P[1], polynomialConstant(I, R, a),
    polynomialConstant(I, R, b), polynomialVariable(I, R, j),
    listMap{A}(polynomialCoefficients(I, R), cs),
    listMap{A}(polynomialCoefficients(I, R), ds) with *
  have constantMul := IsRingHom.mul with hom, left, right
  have valueA := polynomialCoefficients.value at I, A, zero, a with *
  have valueB := polynomialCoefficients.value at I, A, zero, b with *
  have valueProduct := polynomialCoefficients.value at I, A, zero, R[a * b]
    with *
  rw [valueA, valueB, valueProduct] at constantMul
  rw [first, second, third, transported, constantMul, valueA, valueB, value]
  rfl

end Polynomials

-- The bundled product pair over a bundled commutative ring.
section Bundled
variable (R : Set)
hypothesis comm : CommRing(R)

def mulList (a b cs ds : Set) : Set :=
  hornerMulList{R.carrier}(R.add, R.zero, R.mul, a, b, cs, ds)

theorem mulList.list (a b : R) (cs ds : List(R.carrier))
  shows List(R.carrier, mulList(a, b, cs, ds))
proof
  have parts := CommRing.parts with comm
  have aIn : a ∈ R by assumption
  have bIn : b ∈ R by assumption
  have data := hornerMulList.data at R.carrier, R.add, R.zero, R.neg, R.mul,
    R.one, a, b, cs, ds with *
  unfold mulList
  exact data.left

theorem mulList.length (a b : R) (cs ds : List(R.carrier))
  shows length{R.carrier}(mulList(a, b, cs, ds)) =
    length{R.carrier}(cs) + length{R.carrier}(ds)
proof
  have parts := CommRing.parts with comm
  have aIn : a ∈ R by assumption
  have bIn : b ∈ R by assumption
  have data := hornerMulList.data at R.carrier, R.add, R.zero, R.neg, R.mul,
    R.one, a, b, cs, ds with *
  unfold mulList
  exact data.right

theorem horner.mul (a b x : R) (cs ds : List(R.carrier))
  shows horner(R, a * b, x, mulList(a, b, cs, ds)) =
    horner(R, a, x, cs) * horner(R, b, x, ds)
proof
  have parts := CommRing.parts with comm
  have aIn : a ∈ R by assumption
  have bIn : b ∈ R by assumption
  have xIn : x ∈ R by assumption
  have value := hornerMulList.value at R.carrier, R.add, R.zero, R.neg, R.mul,
    R.one, a, b, x, cs, ds with *
  rw [horner.graph, horner.graph, horner.graph]
  unfold mulList
  exact value

theorem hornerPolynomial.mul (I j : Set) (a b : R) (cs ds : List(R.carrier))
  shows hornerPolynomial(R, I, j, a * b, mulList(a, b, cs, ds)) =
    Ring.mul(polynomialRing(R, I))(hornerPolynomial(R, I, j, a, cs),
      hornerPolynomial(R, I, j, b, ds))
proof
  have parts := CommRing.parts with comm
  have aIn : a ∈ R by assumption
  have bIn : b ∈ R by assumption
  have value := polynomialFromHorner.mul at I, R.carrier, R.add, R.zero, R.neg,
    R.mul, R.one, j, a, b, cs, ds with *
  rw [hornerPolynomial.graph, hornerPolynomial.graph, hornerPolynomial.graph,
    polynomialRing.mulOf]
  unfold mulList
  exact value

end Bundled
