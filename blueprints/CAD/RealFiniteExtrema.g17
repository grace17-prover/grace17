-- The greatest and least element of a nonempty finite set of reals,
-- mirroring greatestNatural: existence by finite induction, the
-- characterizing properties, and their relation.
-- Part of the CAD blueprint.
-- Planned home: Real/FiniteExtrema.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module CAD.RealFiniteExtrema
import Grace.Cumulus.Real.Order
import Grace.Cumulus.Cardinal.Counting

theorem Finite.exists_greatest_real (S : Set)
  requires inhabited : Nonempty(S)
  requires reals : S ⊆ ℝ
  requires finite : Finite(S)
  shows ∃ x ∈ S, ∀ y ∈ S, (y:R) ≤ (x:R)
proof
  sorry

theorem Finite.exists_least_real (S : Set)
  requires inhabited : Nonempty(S)
  requires reals : S ⊆ ℝ
  requires finite : Finite(S)
  shows ∃ x ∈ S, ∀ y ∈ S, (x:R) ≤ (y:R)
proof
  sorry

defunique realGreatest (S : Set) (x ∈ ℝ) := x ∈ S ∧ ∀ y ∈ S, (y:R) ≤ (x:R)
requires inhabited : Nonempty(S)
requires reals : S ⊆ ℝ
requires finite : Finite(S)
proof
  sorry
uniqueness
  sorry

defunique realLeast (S : Set) (x ∈ ℝ) := x ∈ S ∧ ∀ y ∈ S, (x:R) ≤ (y:R)
requires inhabited : Nonempty(S)
requires reals : S ⊆ ℝ
requires finite : Finite(S)
proof
  sorry
uniqueness
  sorry

section Extrema
variable (S : Set)
hypothesis inhabited : Nonempty(S)
hypothesis reals : S ⊆ ℝ
hypothesis finite : Finite(S)

theorem realGreatest.real
  shows Real(realGreatest(S))
proof
  sorry

theorem realGreatest.member
  shows realGreatest(S) ∈ S
proof
  sorry

theorem realGreatest.greatest (y : Real)
  requires member : y ∈ S
  shows y ≤ realGreatest(S)
proof
  sorry

theorem realLeast.real
  shows Real(realLeast(S))
proof
  sorry

theorem realLeast.member
  shows realLeast(S) ∈ S
proof
  sorry

theorem realLeast.least (y : Real)
  requires member : y ∈ S
  shows realLeast(S) ≤ y
proof
  sorry

theorem realLeast.le_greatest
  shows realLeast(S) ≤ realGreatest(S)
proof
  sorry

-- Nothing of S lies above the greatest or below the least element.
theorem realGreatest.not_member_above (y : Real)
  requires above : realGreatest(S) < y
  shows ¬(y ∈ S)
proof
  sorry

theorem realLeast.not_member_below (y : Real)
  requires below : y < realLeast(S)
  shows ¬(y ∈ S)
proof
  sorry

end Extrema

theorem realGreatest.singleton (x : Real)
  shows realGreatest({x}) = x
proof
  sorry

theorem realLeast.singleton (x : Real)
  shows realLeast({x}) = x
proof
  sorry
