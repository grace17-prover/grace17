module CAD.RealFiniteExtrema
import Grace.Cumulus.Real.Ring
import Grace.Cumulus.Cardinal.Counting

-- The finite subsets of the line with a greatest element, and with a
-- least element, when nonempty: the families the finite induction runs on.
def Finite.greatestFamily : Set :=
  { F ∈ 𝒫(ℝ) |
    Nonempty(F) → ∃ x ∈ F, ∀ y ∈ F, (y:R) ≤ (x:R) }

def Finite.leastFamily : Set :=
  { F ∈ 𝒫(ℝ) |
    Nonempty(F) → ∃ x ∈ F, ∀ y ∈ F, (x:R) ≤ (y:R) }

theorem Finite.greatestFamily.empty
  shows ∅ ∈ Finite.greatestFamily
proof
  apply Finite.greatestFamily.membership.backward
  constructor
  . exact powerset.membership_iff.backward with empty.subset
  . intro nonempty
    obtain ⟨x, hx⟩ := nonempty
    exfalso
    exact set.empty with hx

theorem Finite.leastFamily.empty
  shows ∅ ∈ Finite.leastFamily
proof
  apply Finite.leastFamily.membership.backward
  constructor
  . exact powerset.membership_iff.backward with empty.subset
  . intro nonempty
    obtain ⟨x, hx⟩ := nonempty
    exfalso
    exact set.empty with hx

-- Adjoining a real to a set of reals keeps it in the powerset of ℝ.
theorem Finite.adjoin_subset_reals (F a : Set)
  requires bound : F ⊆ ℝ
  requires real : a ∈ ℝ
  shows F ∪ {a} ∈ 𝒫(ℝ)
proof
  apply powerset.membership_iff.backward
  intros y hy
  have split := union2.membership.forward with hy
  cases split with inF | inSingleton
  . exact bound with y, inF
  . have equal := singleton.membership.forward with inSingleton
    rw equal
    exact real

theorem Finite.greatestFamily.adjoin (F a : Set)
  requires bound : F ⊆ ℝ
  requires real : a ∈ ℝ
  requires member : F ∈ Finite.greatestFamily
  shows F ∪ {a} ∈ Finite.greatestFamily
proof
  obtain ⟨inPowerset, property⟩ :=
    Finite.greatestFamily.membership.forward with member
  have typedA : Real(a) by exact real
  have aMember : a ∈ F ∪ {a}
    apply union2.right
    exact singleton.self at a
  apply Finite.greatestFamily.membership.backward
  constructor
  . exact Finite.adjoin_subset_reals with bound, real
  . intro nonempty
    have emptyOrNot : Nonempty(F) ∨ ¬(Nonempty(F)) by tauto
    cases emptyOrNot with inhabitedF | emptyF
    . obtain ⟨x, hx, greatest⟩ := property with inhabitedF
      have xReal : x ∈ ℝ := bound with x, hx
      have typedX : Real(x) by exact xReal
      have xMember : x ∈ F ∪ {a}
        apply union2.left
        exact hx
      have split := realLess.trichotomy at x, a
      cases split with below | rest
      . refine ⟨a, aMember, ?_⟩
        intros y hy
        have yReal : y ∈ ℝ := (powerset.membership_iff.forward with
          (Finite.adjoin_subset_reals with bound, real)) with y, hy
        have typedY : Real(y) by exact yReal
        have cases := union2.membership.forward with hy
        cases cases with inF | inSingleton
        . have le := greatest with y, inF
          linarith
        . have equal := singleton.membership.forward with inSingleton
          rw equal
          exact realLe.reflexive at a
      . refine ⟨x, xMember, ?_⟩
        intros y hy
        have cases := union2.membership.forward with hy
        cases cases with inF | inSingleton
        . exact greatest with y, inF
        . have equal := singleton.membership.forward with inSingleton
          rw equal
          cases rest with same | above
          . rw same
            exact realLe.reflexive at a
          . exact realLess.implies_le with above
    . refine ⟨a, aMember, ?_⟩
      intros y hy
      have cases := union2.membership.forward with hy
      cases cases with inF | inSingleton
      . exfalso
        apply emptyF
        exact ⟨y, inF⟩
      . have equal := singleton.membership.forward with inSingleton
        rw equal
        exact realLe.reflexive at a

theorem Finite.leastFamily.adjoin (F a : Set)
  requires bound : F ⊆ ℝ
  requires real : a ∈ ℝ
  requires member : F ∈ Finite.leastFamily
  shows F ∪ {a} ∈ Finite.leastFamily
proof
  obtain ⟨inPowerset, property⟩ :=
    Finite.leastFamily.membership.forward with member
  have typedA : Real(a) by exact real
  have aMember : a ∈ F ∪ {a}
    apply union2.right
    exact singleton.self at a
  apply Finite.leastFamily.membership.backward
  constructor
  . exact Finite.adjoin_subset_reals with bound, real
  . intro nonempty
    have emptyOrNot : Nonempty(F) ∨ ¬(Nonempty(F)) by tauto
    cases emptyOrNot with inhabitedF | emptyF
    . obtain ⟨x, hx, least⟩ := property with inhabitedF
      have xReal : x ∈ ℝ := bound with x, hx
      have typedX : Real(x) by exact xReal
      have xMember : x ∈ F ∪ {a}
        apply union2.left
        exact hx
      have split := realLess.trichotomy at a, x
      cases split with below | rest
      . refine ⟨a, aMember, ?_⟩
        intros y hy
        have yReal : y ∈ ℝ := (powerset.membership_iff.forward with
          (Finite.adjoin_subset_reals with bound, real)) with y, hy
        have typedY : Real(y) by exact yReal
        have cases := union2.membership.forward with hy
        cases cases with inF | inSingleton
        . have le := least with y, inF
          linarith
        . have equal := singleton.membership.forward with inSingleton
          rw equal
          exact realLe.reflexive at a
      . refine ⟨x, xMember, ?_⟩
        intros y hy
        have cases := union2.membership.forward with hy
        cases cases with inF | inSingleton
        . exact least with y, inF
        . have equal := singleton.membership.forward with inSingleton
          rw equal
          cases rest with same | above
          . rw same
            exact realLe.reflexive at x
          . exact realLess.implies_le with above
    . refine ⟨a, aMember, ?_⟩
      intros y hy
      have cases := union2.membership.forward with hy
      cases cases with inF | inSingleton
      . exfalso
        apply emptyF
        exact ⟨y, inF⟩
      . have equal := singleton.membership.forward with inSingleton
        rw equal
        exact realLe.reflexive at a

theorem Finite.exists_greatest_real (S : Set)
  requires inhabited : Nonempty(S)
  requires reals : S ⊆ ℝ
  requires finite : Finite(S)
  shows ∃ x ∈ S, ∀ y ∈ S, (y:R) ≤ (x:R)
proof
  have base := Finite.greatestFamily.empty
  have step : ∀ F ⊆ ℝ, Finite(F) → ∀ a ∈ ℝ, a ∉ F →
      F ∈ Finite.greatestFamily → F ∪ {a} ∈ Finite.greatestFamily
    intros F bound finiteF a real fresh member
    exact Finite.greatestFamily.adjoin with bound, real, member
  have all := Finite.induction at ℝ, Finite.greatestFamily with base, step
  have member := all with S, reals, finite
  obtain ⟨inPowerset, property⟩ :=
    Finite.greatestFamily.membership.forward with member
  exact property with inhabited

theorem Finite.exists_least_real (S : Set)
  requires inhabited : Nonempty(S)
  requires reals : S ⊆ ℝ
  requires finite : Finite(S)
  shows ∃ x ∈ S, ∀ y ∈ S, (x:R) ≤ (y:R)
proof
  have base := Finite.leastFamily.empty
  have step : ∀ F ⊆ ℝ, Finite(F) → ∀ a ∈ ℝ, a ∉ F →
      F ∈ Finite.leastFamily → F ∪ {a} ∈ Finite.leastFamily
    intros F bound finiteF a real fresh member
    exact Finite.leastFamily.adjoin with bound, real, member
  have all := Finite.induction at ℝ, Finite.leastFamily with base, step
  have member := all with S, reals, finite
  obtain ⟨inPowerset, property⟩ :=
    Finite.leastFamily.membership.forward with member
  exact property with inhabited

section Extrema
variable (S : Set)
hypothesis inhabited : Nonempty(S)
hypothesis reals : S ⊆ ℝ
hypothesis finite : Finite(S)

defunique realGreatest (x ∈ ℝ) := x ∈ S ∧ ∀ y ∈ S, (y:R) ≤ (x:R)
proof
  obtain ⟨x, hx, greatest⟩ :=
    Finite.exists_greatest_real with inhabited, reals, finite
  have xReal : x ∈ ℝ := reals with x, hx
  refine ⟨x, xReal, ?_⟩
  exact ⟨hx, greatest⟩
uniqueness
  intros u hu first v hv second
  have typedU : Real(u) by exact hu
  have typedV : Real(v) by exact hv
  have uLe := second.right with u, first.left
  have vLe := first.right with v, second.left
  exact realLe.antisymmetric with uLe, vLe

defunique realLeast (x ∈ ℝ) := x ∈ S ∧ ∀ y ∈ S, (x:R) ≤ (y:R)
proof
  obtain ⟨x, hx, least⟩ :=
    Finite.exists_least_real with inhabited, reals, finite
  have xReal : x ∈ ℝ := reals with x, hx
  refine ⟨x, xReal, ?_⟩
  exact ⟨hx, least⟩
uniqueness
  intros u hu first v hv second
  have typedU : Real(u) by exact hu
  have typedV : Real(v) by exact hv
  have uLe := first.right with v, second.left
  have vLe := second.right with u, first.left
  exact realLe.antisymmetric with uLe, vLe

theorem realGreatest.real
  shows Real(realGreatest)
proof
  have selected := realGreatest.selected with *
  exact selected.left

theorem realGreatest.member
  shows realGreatest ∈ S
proof
  have selected := realGreatest.selected with *
  exact selected.right.left

theorem realGreatest.greatest (y : Real)
  requires member : y ∈ S
  shows y ≤ realGreatest
proof
  have selected := realGreatest.selected with *
  exact selected.right.right with y, member

theorem realLeast.real
  shows Real(realLeast)
proof
  have selected := realLeast.selected with *
  exact selected.left

theorem realLeast.member
  shows realLeast ∈ S
proof
  have selected := realLeast.selected with *
  exact selected.right.left

theorem realLeast.least (y : Real)
  requires member : y ∈ S
  shows realLeast ≤ y
proof
  have selected := realLeast.selected with *
  exact selected.right.right with y, member

theorem realLeast.le_greatest
  shows realLeast ≤ realGreatest
proof
  have greatestReal := realGreatest.real with *
  have member := realGreatest.member with *
  exact realLeast.least with member

-- Nothing of S lies above the greatest or below the least element.
theorem realGreatest.not_member_above (y : Real)
  requires above : realGreatest < y
  shows ¬(y ∈ S)
proof
  intro member
  have greatestReal := realGreatest.real with *
  have le := realGreatest.greatest with member
  linarith

theorem realLeast.not_member_below (y : Real)
  requires below : y < realLeast
  shows ¬(y ∈ S)
proof
  intro member
  have leastReal := realLeast.real with *
  have le := realLeast.least with member
  linarith

end Extrema

theorem realGreatest.singleton (x : Real)
  shows realGreatest({x}) = x
proof
  have xReal : x ∈ ℝ by simp [Real]
  have inhabited := Nonempty.singleton at x
  have reals : {x} ⊆ ℝ
    intros y hy
    have equal := singleton.membership.forward with hy
    rw equal
    exact xReal
  have finite := Finite.singleton at x
  have selected := realGreatest.selected at {x} with inhabited, reals, finite
  exact singleton.membership.forward with selected.right.left

theorem realLeast.singleton (x : Real)
  shows realLeast({x}) = x
proof
  have xReal : x ∈ ℝ by simp [Real]
  have inhabited := Nonempty.singleton at x
  have reals : {x} ⊆ ℝ
    intros y hy
    have equal := singleton.membership.forward with hy
    rw equal
    exact xReal
  have finite := Finite.singleton at x
  have selected := realLeast.selected at {x} with inhabited, reals, finite
  exact singleton.membership.forward with selected.right.left
