-- The real roots of a Horner pair in increasing order: between two
-- consecutive roots the polynomial keeps one sign, above the greatest
-- root its sign is that of the leading coefficient and below the least
-- root that sign times (−1)^degree, every root lies within the Cauchy
-- bound, between two distinct roots lies a root of the derivative, and an
-- odd degree forces a real root.
-- Part of the CAD blueprint.
-- Planned home: Real/Analysis/PolynomialRoots.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module CAD.RealRootOrder
import CAD.RealHorner
import CAD.StrictlyIncreasingList
import CAD.RealConstantSign
import Grace.Cumulus.Real.Analysis.MeanValueIntegration

-- Every list of reals is bounded in absolute value by some M ≥ 0.
theorem hornerFunction.coefficient_bound (ds : List(ℝ))
  shows ∃ M ∈ ℝ, (0:R) ≤ M ∧
    ∀ c ∈ listSupport{ℝ}(ds), (c:R) ≤ M ∧ -M ≤ (c:R)
proof
  induction ds
  | List.nil =>
    have zeroReal : Real((0:R)) by typecheck
    have zeroIn : (0:R) ∈ ℝ by exact zeroReal
    refine ⟨(0:R), zeroIn, realLe.reflexive at (0:R), ?_⟩
    intros c hc
    rw listSupport.nil at hc
    exfalso
    exact set.empty with hc
  | List.cons(c, tail) using ih =>
    obtain ⟨M, realM, nonnegative, bound⟩ := ih
    have cIn : c ∈ ℝ by assumption
    have typedC : Real(c) by exact cIn
    have typedM : Real(M) by exact realM
    have tailList : List(ℝ, tail) by typecheck
    have absReal : Real(abs(c)) := abs.real at c
    have sumReal : Real(M + abs(c)) by typecheck
    have sumIn : M + abs(c) ∈ ℝ by exact sumReal
    have upper := abs.upper at c
    have upperNeg := abs.upper_neg at c
    have absNonnegative := abs.nonnegative at c
    refine ⟨M + abs(c), sumIn, ?_, ?_⟩
    . linarith
    . intros d hd
      have iff := listSupport.mem_cons_iff at ℝ, c, d, tail with cIn
      have cases := iff.forward with hd
      cases cases with same | inTail
      . rw same
        constructor
        . linarith
        . linarith
      . have reals := listSupport.subset at ℝ, tail with tailList
        have dIn : d ∈ ℝ := reals with d, inTail
        have typedD : Real(d) by exact dIn
        obtain ⟨le, ge⟩ := bound with d, inTail
        constructor
        . linarith
        . linarith

-- A quotient bound multiplied out.
theorem hornerFunction.le_mul_of_div_le (M D a : Real)
  requires positive : 0 < a
  requires le : M / a ≤ D
  shows M ≤ a * D
proof
  have nonzero : a ≠ (0:R)
    intro same
    rw same at positive
    linarith
  have quotientReal : Real(M / a) := realDiv.real at M, a
  have cancel := realDiv.mul_left at M, a with nonzero
  have nonnegative := realLess.implies_le with positive
  have diff : 0 ≤ D - M / a by linarith
  have product := realMulValue.nonnegative with nonnegative, diff
  have expand : a * (D - M / a) = a * D - a * (M / a) by ring
  linarith

theorem hornerFunction.neg_one_pow_odd (k : Nat)
  shows (-(1:R)) ^ (2 * k + 1) = -(1:R)
proof
  induction k
  | zero =>
    have one : 2 * 0 + 1 = succ(0) by arith
    rw [one, realPow.succ, realPow.zero]
    ring
  | succ(j) using ih =>
    have step : 2 * succ(j) + 1 = succ(succ(2 * j + 1)) by arith
    rw [step, realPow.succ, realPow.succ, ih]
    ring

-- Beyond the Cauchy bound the value has the sign of the leading
-- coefficient times the sign of X to the degree, and is at least
-- |leading| in absolute value: by induction on the list, since
-- |X·p(X)| ≥ |X|·|leading| ≥ |leading| + M > |c|.
theorem hornerFunction.far_from_zero (leading M X : Real) (ds : List(ℝ))
  requires nonzero : leading ≠ (0:R)
  requires bound : ∀ c ∈ listSupport{ℝ}(ds), (c:R) ≤ M ∧ -M ≤ (c:R)
  requires far : M ≤ abs(leading) * (abs(X) - 1)
  shows realSign(hornerFunction(leading, ds)(X)) =
      realSign(leading) * realSign(X) ^ length{ℝ}(ds) ∧
    abs(leading) ≤ abs(hornerFunction(leading, ds)(X))
proof
  induction ds
  | List.nil =>
    intro bound
    have typedLeading : Real(leading) by typecheck
    have nilList : List(ℝ, []) by typecheck
    have value := hornerFunction.nil at leading, [], X with
      typedLeading, nilList
    have signReal : Real(realSign(leading)) := realSign.real at leading
    have absReal : Real(abs(leading)) := abs.real at leading
    rw [value, length.nil, realPow.zero]
    constructor
    . ring
    . exact realLe.reflexive at abs(leading)
  | List.cons(c, tail) using ih =>
    intro bound
    have typedLeading : Real(leading) by typecheck
    have cIn : c ∈ ℝ by assumption
    have typedC : Real(c) by exact cIn
    have tailList : List(ℝ, tail) by typecheck
    have realX : X ∈ ℝ by simp [Real]
    have lengthNat : Nat(length{ℝ}(tail)) by typecheck
    have tailBound : ∀ d ∈ listSupport{ℝ}(tail), (d:R) ≤ M ∧ -M ≤ (d:R)
      intros d hd
      have inCons := listSupport.mem_cons_of_mem with cIn, hd
      exact bound with d, inCons
    have headMember := listSupport.mem_cons_self at ℝ, c, tail with cIn
    obtain ⟨cUpper, cLower⟩ := bound with c, headMember
    obtain ⟨tailSign, tailAbs⟩ := ih with tailBound
    have value := hornerFunction.cons at leading, tail, c, X with
      typedLeading, tailList
    have tailFunction := hornerFunction.function at leading, tail with
      typedLeading, tailList
    have typedT : Real(hornerFunction(leading, tail)(X)) by
      exact FunctionBetween.apply_closed with tailFunction, realX
    have typedP : Real(X * hornerFunction(leading, tail)(X)) by typecheck
    have absLeading := abs.positive_of_ne with nonzero
    have absReal : Real(abs(leading)) := abs.real at leading
    have absX := abs.nonnegative at X
    have absXReal : Real(abs(X)) := abs.real at X
    have absTReal : Real(abs(hornerFunction(leading, tail)(X))) by typecheck
    have absPReal : Real(abs(X * hornerFunction(leading, tail)(X))) by
      typecheck
    have absProduct := abs.mul at X, hornerFunction(leading, tail)(X)
    have diff : 0 ≤ abs(hornerFunction(leading, tail)(X)) - abs(leading) by
      linarith
    have gap := realMulValue.nonnegative with absX, diff
    have expandGap : abs(X) * (abs(hornerFunction(leading, tail)(X)) -
        abs(leading)) =
      abs(X) * abs(hornerFunction(leading, tail)(X)) - abs(X) * abs(leading)
      by ring
    have expandFar : abs(leading) * (abs(X) - 1) =
      abs(X) * abs(leading) - abs(leading) by ring
    have large : abs(leading) + M ≤ abs(X * hornerFunction(leading, tail)(X))
      rw absProduct
      linarith
    have split := realLess.trichotomy at (0:R),
      X * hornerFunction(leading, tail)(X)
    have signSum : realSign(c + X * hornerFunction(leading, tail)(X)) =
        realSign(X * hornerFunction(leading, tail)(X)) ∧
      abs(leading) ≤ abs(c + X * hornerFunction(leading, tail)(X))
      rcases split with positive | zero | negative
      . have absP := abs.of_nonnegative with
          (realLess.implies_le with positive)
        have sumPositive : 0 < c + X * hornerFunction(leading, tail)(X) by
          linarith
        have absSum := abs.of_nonnegative with
          (realLess.implies_le with sumPositive)
        have signP := realSign.of_positive with positive
        have signS := realSign.of_positive with sumPositive
        rw [signP, signS, absSum]
        constructor
        . rfl
        . linarith
      . exfalso
        rw [← zero, abs.zero] at large
        linarith
      . have absP := abs.of_nonpositive with
          (realLess.implies_le with negative)
        have sumNegative : c + X * hornerFunction(leading, tail)(X) < 0 by
          linarith
        have absSum := abs.of_nonpositive with
          (realLess.implies_le with sumNegative)
        have signP := realSign.of_negative with negative
        have signS := realSign.of_negative with sumNegative
        rw [signP, signS, absSum]
        constructor
        . rfl
        . linarith
    obtain ⟨signEq, absSum⟩ := signSum
    have productSign := realSign.mul at X, hornerFunction(leading, tail)(X)
    have signX : Real(realSign(X)) := realSign.real at X
    have signLeading : Real(realSign(leading)) := realSign.real at leading
    have powerReal : Real(realSign(X) ^ length{ℝ}(tail)) :=
      realPow.real at realSign(X), length{ℝ}(tail)
    rw [value, length.cons, realPow.succ]
    constructor
    . rw [signEq, productSign, tailSign]
      ring
    . exact absSum

-- Far to the right and to the left the sign is settled, for use before
-- the section states it.
theorem hornerFunction.exists_sign_above (leading : Real) (cs : List(ℝ))
  requires nonzero : leading ≠ (0:R)
  shows ∃ B ∈ ℝ, ∀ X ∈ ℝ, B < X →
    realSign(hornerFunction(leading, cs)(X)) = realSign(leading)
proof
  have csList : List(ℝ, cs) by typecheck
  obtain ⟨M, realM, nonnegativeM, bound⟩ :=
    hornerFunction.coefficient_bound at cs with csList
  have typedM : Real(M) by exact realM
  have absLeading := abs.positive_of_ne with nonzero
  have absReal : Real(abs(leading)) := abs.real at leading
  have quotientReal : Real(M / abs(leading)) := realDiv.real at M, abs(leading)
  have boundReal : Real(abs(1 + M / abs(leading))) by typecheck
  have boundIn : abs(1 + M / abs(leading)) ∈ ℝ by exact boundReal
  have lengthNat : Nat(length{ℝ}(cs)) by typecheck
  have signReal : Real(realSign(leading)) := realSign.real at leading
  refine ⟨abs(1 + M / abs(leading)), boundIn, ?_⟩
  intros X realX above
  have typedX : Real(X) by exact realX
  have upper := abs.upper at 1 + M / abs(leading)
  have nonnegative := abs.nonnegative at 1 + M / abs(leading)
  have positive : 0 < X by linarith
  have absX := abs.of_nonnegative with (realLess.implies_le with positive)
  have quotientLe : M / abs(leading) ≤ abs(X) - 1
    rw absX
    linarith
  have far := hornerFunction.le_mul_of_div_le with absLeading, quotientLe
  obtain ⟨sign, large⟩ := hornerFunction.far_from_zero at leading, M, X, cs
    with nonzero, bound, far
  have signX := realSign.of_positive with positive
  rw [sign, signX, realPow.one]
  ring

theorem hornerFunction.exists_sign_below (leading : Real) (cs : List(ℝ))
  requires nonzero : leading ≠ (0:R)
  shows ∃ B ∈ ℝ, ∀ X ∈ ℝ, X < B →
    realSign(hornerFunction(leading,
      cs)(X)) = realSign(leading) * (-(1:R)) ^ length{ℝ}(cs)
proof
  have csList : List(ℝ, cs) by typecheck
  obtain ⟨M, realM, nonnegativeM, bound⟩ :=
    hornerFunction.coefficient_bound at cs with csList
  have typedM : Real(M) by exact realM
  have absLeading := abs.positive_of_ne with nonzero
  have absReal : Real(abs(leading)) := abs.real at leading
  have quotientReal : Real(M / abs(leading)) := realDiv.real at M, abs(leading)
  have boundReal : Real(-abs(1 + M / abs(leading))) by typecheck
  have boundIn : -abs(1 + M / abs(leading)) ∈ ℝ by exact boundReal
  refine ⟨-abs(1 + M / abs(leading)), boundIn, ?_⟩
  intros X realX below
  have typedX : Real(X) by exact realX
  have upper := abs.upper at 1 + M / abs(leading)
  have nonnegative := abs.nonnegative at 1 + M / abs(leading)
  have negative : X < 0 by linarith
  have absX := abs.of_nonpositive with (realLess.implies_le with negative)
  have quotientLe : M / abs(leading) ≤ abs(X) - 1
    rw absX
    linarith
  have far := hornerFunction.le_mul_of_div_le with absLeading, quotientLe
  obtain ⟨sign, large⟩ := hornerFunction.far_from_zero at leading, M, X, cs
    with nonzero, bound, far
  have signX := realSign.of_negative with negative
  rw [sign, signX]

section Polynomials
variable (leading cs : Set)
hypothesis initial : Real(leading)
hypothesis coefficients : List(ℝ, cs)
hypothesis nonzero : leading ≠ (0:R)

-- The roots in increasing order.
theorem rootSet.enumeration
  shows ∃ xs, List(ℝ, xs) ∧ StrictlyIncreasingList(xs) ∧
    listSupport{ℝ}(xs) = rootSet(realRing, leading, cs)
proof
  have reals := rootSet.subset_reals at leading, cs with initial, coefficients
  have finite := rootSet.real_finite at leading, cs with
    initial, coefficients, nonzero
  exact Finite.exists_increasing_list with reals, finite

-- On an open interval free of roots the sign is constant.
theorem hornerFunction.sign_eq_without_roots (U V X Y : Real)
  requires free : ∀ r ∈ rootSet(realRing, leading, cs), ¬(U < (r:R) ∧ (r:R) < V)
  requires left : X ∈ openInterval(U, V)
  requires right : Y ∈ openInterval(U, V)
  shows realSign(hornerFunction(leading,
    cs)(X)) = realSign(hornerFunction(leading, cs)(Y))
proof
  have function := hornerFunction.function at leading, cs with
    initial, coefficients
  have continuous := hornerFunction.continuous at leading, cs with
    initial, coefficients
  have nonzeroOn : ∀ Z ∈ openInterval(U, V), hornerFunction(leading, cs)(Z) ≠
      (0:R)
    intros Z hZ zero
    obtain ⟨realZ, lowerZ, upperZ⟩ := openInterval.membership.forward with hZ
    have typedZ : Real(Z) by exact realZ
    have iff := hornerFunction.root_iff at leading, cs, Z with
      initial, coefficients
    have root := iff.backward with zero
    have notBetween := free with Z, root
    exact notBetween with ⟨lowerZ, upperZ⟩
  exact Continuous.sign_eq_on_open_interval at hornerFunction(leading, cs),
    U, V, X, Y with continuous, nonzeroOn, left, right

-- Between consecutive roots, the i-th and (i+1)-th of the enumeration.
theorem hornerFunction.sign_between_roots (xs : List(ℝ)) (i : Nat)
  (U V X Y : Real)
  requires increasing : StrictlyIncreasingList(xs)
  requires support : listSupport{ℝ}(xs) = rootSet(realRing, leading, cs)
  requires bound : succ(i) < length{ℝ}(xs)
  requires lower : U = listCoefficient{ℝ}((0:R), xs, i)
  requires upper : V = listCoefficient{ℝ}((0:R), xs, succ(i))
  requires left : X ∈ openInterval(U, V)
  requires right : Y ∈ openInterval(U, V)
  shows realSign(hornerFunction(leading,
    cs)(X)) = realSign(hornerFunction(leading, cs)(Y))
proof
  have reals := rootSet.subset_reals at leading, cs with initial, coefficients
  have free : ∀ r ∈ rootSet(realRing, leading, cs), ¬(U < (r:R) ∧ (r:R) < V)
    intros r hr between
    obtain ⟨above, below⟩ := between
    have realR : r ∈ ℝ := reals with r, hr
    have typedR : Real(r) by exact realR
    rw lower at above
    rw upper at below
    have absent := StrictlyIncreasingList.between_consecutive with
      increasing, bound, above, below
    rw support at absent
    exact absent with hr
  exact hornerFunction.sign_eq_without_roots at leading, cs, U, V, X, Y with
    initial, coefficients, nonzero, free, left, right

-- Above every root the sign is that of the leading coefficient.
theorem hornerFunction.sign_above_roots (X : Real)
  requires above : ∀ r ∈ rootSet(realRing, leading, cs), (r:R) < X
  shows realSign(hornerFunction(leading, cs)(X)) = realSign(leading)
proof
  obtain ⟨B, realB, eventually⟩ := hornerFunction.exists_sign_above at
    leading, cs with nonzero
  have typedB : Real(B) by exact realB
  have function := hornerFunction.function at leading, cs with
    initial, coefficients
  have upperX := abs.upper at X
  have upperB := abs.upper at B
  have nonnegativeX := abs.nonnegative at X
  have nonnegativeB := abs.nonnegative at B
  have typedY : Real(abs(X) + abs(B) + 1) by typecheck
  have realY : abs(X) + abs(B) + 1 ∈ ℝ by exact typedY
  have ordered : X ≤ abs(X) + abs(B) + 1 by linarith
  have aboveB : B < abs(X) + abs(B) + 1 by linarith
  have signY := eventually with abs(X) + abs(B) + 1, realY, aboveB
  have subset := closedInterval.subset_reals at X, abs(X) + abs(B) + 1
  have continuousOn := hornerFunction.continuous_on at leading, cs,
    closedInterval(X, abs(X) + abs(B) + 1) with initial, coefficients, subset
  have nonzeroOn : ∀ Z ∈ closedInterval(X, abs(X) + abs(B) + 1),
      hornerFunction(leading, cs)(Z) ≠ (0:R)
    intros Z hZ zero
    obtain ⟨realZ, lowerZ, upperZ⟩ := closedInterval.membership.forward with hZ
    have typedZ : Real(Z) by exact realZ
    have iff := hornerFunction.root_iff at leading, cs, Z with
      initial, coefficients
    have root := iff.backward with zero
    have less := above with Z, root
    linarith
  have leftMember := closedInterval.left_mem with ordered
  have rightMember := closedInterval.right_mem with ordered
  have same := ContinuousOn.sign_eq_of_no_zero at hornerFunction(leading, cs),
    X, abs(X) + abs(B) + 1, X, abs(X) + abs(B) + 1 with
    ordered, continuousOn, nonzeroOn, leftMember, rightMember
  rw [same, signY]

-- Below every root it is that sign times (−1)^degree.
theorem hornerFunction.sign_below_roots (X : Real)
  requires below : ∀ r ∈ rootSet(realRing, leading, cs), X < (r:R)
  shows realSign(hornerFunction(leading, cs)(X)) =
    realSign(leading) * (-(1:R)) ^ length{ℝ}(cs)
proof
  obtain ⟨B, realB, eventually⟩ := hornerFunction.exists_sign_below at
    leading, cs with nonzero
  have typedB : Real(B) by exact realB
  have function := hornerFunction.function at leading, cs with
    initial, coefficients
  have upperX := abs.upper_neg at X
  have upperB := abs.upper_neg at B
  have nonnegativeX := abs.nonnegative at X
  have nonnegativeB := abs.nonnegative at B
  have typedY : Real(-(abs(X) + abs(B) + 1)) by typecheck
  have realY : -(abs(X) + abs(B) + 1) ∈ ℝ by exact typedY
  have ordered : -(abs(X) + abs(B) + 1) ≤ X by linarith
  have belowB : -(abs(X) + abs(B) + 1) < B by linarith
  have signY := eventually with -(abs(X) + abs(B) + 1), realY, belowB
  have subset := closedInterval.subset_reals at -(abs(X) + abs(B) + 1), X
  have continuousOn := hornerFunction.continuous_on at leading, cs,
    closedInterval(-(abs(X) + abs(B) + 1), X) with initial, coefficients, subset
  have nonzeroOn : ∀ Z ∈ closedInterval(-(abs(X) + abs(B) + 1), X),
      hornerFunction(leading, cs)(Z) ≠ (0:R)
    intros Z hZ zero
    obtain ⟨realZ, lowerZ, upperZ⟩ := closedInterval.membership.forward with hZ
    have typedZ : Real(Z) by exact realZ
    have iff := hornerFunction.root_iff at leading, cs, Z with
      initial, coefficients
    have root := iff.backward with zero
    have less := below with Z, root
    linarith
  have leftMember := closedInterval.left_mem with ordered
  have rightMember := closedInterval.right_mem with ordered
  have same := ContinuousOn.sign_eq_of_no_zero at hornerFunction(leading, cs),
    -(abs(X) + abs(B) + 1), X, -(abs(X) + abs(B) + 1), X with
    ordered, continuousOn, nonzeroOn, leftMember, rightMember
  rw [← same, signY]

-- The Cauchy bound: with M bounding the lower coefficients in absolute
-- value, every root lies in |X| ≤ 1 + M / |leading|.
theorem hornerFunction.cauchy_bound (M X : Real)
  requires bound : ∀ c ∈ listSupport{ℝ}(cs), (c:R) ≤ M ∧ -M ≤ (c:R)
  requires root : hornerFunction(leading, cs)(X) = (0:R)
  shows abs(X) ≤ 1 + M / abs(leading)
proof
  have absLeading := abs.positive_of_ne with nonzero
  have absReal : Real(abs(leading)) := abs.real at leading
  have quotientReal : Real(M / abs(leading)) := realDiv.real at M, abs(leading)
  have absXReal : Real(abs(X)) := abs.real at X
  by_contra notLe
  have above := realLess.of_not_le with notLe
  have quotientLe : M / abs(leading) ≤ abs(X) - 1 by linarith
  have far := hornerFunction.le_mul_of_div_le with absLeading, quotientLe
  obtain ⟨sign, large⟩ := hornerFunction.far_from_zero at leading, M, X, cs
    with nonzero, bound, far
  rw [root, abs.zero] at large
  linarith

theorem hornerFunction.roots_bounded
  shows ∃ B ∈ ℝ, ∀ r ∈ rootSet(realRing, leading, cs), abs(r) ≤ B
proof
  obtain ⟨M, realM, nonnegativeM, bound⟩ :=
    hornerFunction.coefficient_bound at cs with coefficients
  have typedM : Real(M) by exact realM
  have absReal : Real(abs(leading)) := abs.real at leading
  have quotientReal : Real(M / abs(leading)) := realDiv.real at M, abs(leading)
  have boundReal : Real(1 + M / abs(leading)) by typecheck
  have boundIn : 1 + M / abs(leading) ∈ ℝ by exact boundReal
  have reals := rootSet.subset_reals at leading, cs with initial, coefficients
  refine ⟨1 + M / abs(leading), boundIn, ?_⟩
  intros r hr
  have realR : r ∈ ℝ := reals with r, hr
  have typedR : Real(r) by exact realR
  have iff := hornerFunction.root_iff at leading, cs, r with
    initial, coefficients
  have root := iff.forward with hr
  exact hornerFunction.cauchy_bound at leading, cs, M, r with
    initial, coefficients, nonzero, bound, root

-- Far to the right and to the left the sign is settled.
theorem hornerFunction.eventually_sign_above
  shows ∃ B ∈ ℝ, ∀ X ∈ ℝ, B < X →
    realSign(hornerFunction(leading, cs)(X)) = realSign(leading)
proof
  exact hornerFunction.exists_sign_above at leading, cs with nonzero

theorem hornerFunction.eventually_sign_below
  shows ∃ B ∈ ℝ, ∀ X ∈ ℝ, X < B →
    realSign(hornerFunction(leading,
      cs)(X)) = realSign(leading) * (-(1:R)) ^ length{ℝ}(cs)
proof
  exact hornerFunction.exists_sign_below at leading, cs with nonzero

-- Rolle for polynomials: between two distinct roots lies a root of the
-- derivative.
theorem hornerFunction.rolle (X Y : Real)
  requires ordered : X < Y
  requires rootLeft : hornerFunction(leading, cs)(X) = (0:R)
  requires rootRight : hornerFunction(leading, cs)(Y) = (0:R)
  shows ∃ Z ∈ openInterval(X, Y),
    hornerFunction(realDerivativeLeading(leading, cs),
      realDerivativeList(cs))(Z) = (0:R)
proof
  have function := hornerFunction.function at leading, cs with
    initial, coefficients
  have subset := closedInterval.subset_reals at X, Y
  have continuousOn := hornerFunction.continuous_on at leading, cs,
    closedInterval(X, Y) with initial, coefficients, subset
  have endpoints : hornerFunction(leading, cs)(X) =
      hornerFunction(leading, cs)(Y)
    rw [rootLeft, rootRight]
    rfl
  have differentiable : ∀ C ∈ ℝ, X < C → C < Y →
      ∃ D ∈ ℝ, HasDerivativeAt(hornerFunction(leading, cs), D, C)
    intros C realC lowerC upperC
    have typedC : Real(C) by exact realC
    have typedD := hornerFunction.derivative_real at leading, cs, C with
      initial, coefficients
    have realD : hornerFunction(realDerivativeLeading(leading, cs),
      realDerivativeList(cs))(C) ∈ ℝ by exact typedD
    have derivative := hornerFunction.has_derivative_at at leading, cs, C with
      initial, coefficients
    exact ⟨hornerFunction(realDerivativeLeading(leading, cs),
      realDerivativeList(cs))(C), realD, derivative⟩
  obtain ⟨C, realC, lowerC, upperC, atZero⟩ := Rolle.theorem at
    hornerFunction(leading, cs), X, Y with
    ordered, continuousOn, endpoints, differentiable
  have typedC : Real(C) by exact realC
  have zeroValue := derivative.of_has_derivative with atZero
  have pairValue := hornerFunction.derivative at leading, cs, C with
    initial, coefficients
  have member : C ∈ openInterval(X, Y) :=
    openInterval.membership.backward with ⟨realC, lowerC, upperC⟩
  refine ⟨C, member, ?_⟩
  rw [← pairValue, zeroValue]
  rfl

theorem hornerFunction.odd_degree_root (k : Nat)
  requires odd : length{ℝ}(cs) = 2 * k + 1
  shows ∃ X ∈ ℝ, hornerFunction(leading, cs)(X) = (0:R)
proof
  have negOnePow := hornerFunction.neg_one_pow_odd at k
  obtain ⟨B1, realB1, aboveSign⟩ := hornerFunction.exists_sign_above at
    leading, cs with nonzero
  obtain ⟨B2, realB2, belowSign⟩ := hornerFunction.exists_sign_below at
    leading, cs with nonzero
  have typedB1 : Real(B1) by exact realB1
  have typedB2 : Real(B2) by exact realB2
  have function := hornerFunction.function at leading, cs with
    initial, coefficients
  have upper1 := abs.upper at B1
  have upper2 := abs.upper_neg at B2
  have nonnegative1 := abs.nonnegative at B1
  have nonnegative2 := abs.nonnegative at B2
  have typedY : Real(abs(B1) + 1) by typecheck
  have realY : abs(B1) + 1 ∈ ℝ by exact typedY
  have typedX : Real(-(abs(B2) + 1)) by typecheck
  have realX : -(abs(B2) + 1) ∈ ℝ by exact typedX
  have aboveB : B1 < abs(B1) + 1 by linarith
  have belowB : -(abs(B2) + 1) < B2 by linarith
  have signY := aboveSign with abs(B1) + 1, realY, aboveB
  have signX := belowSign with -(abs(B2) + 1), realX, belowB
  rw [odd, negOnePow] at signX
  have typedPX : Real(hornerFunction(leading, cs)(-(abs(B2) + 1))) by
    exact FunctionBetween.apply_closed with function, realX
  have typedPY : Real(hornerFunction(leading, cs)(abs(B1) + 1)) by
    exact FunctionBetween.apply_closed with function, realY
  have signReal : Real(realSign(leading)) := realSign.real at leading
  have square := realSign.square with nonzero
  have productSign := realSign.mul at
    hornerFunction(leading, cs)(-(abs(B2) + 1)),
    hornerFunction(leading, cs)(abs(B1) + 1)
  rw [signX, signY] at productSign
  have negOne : realSign(leading) * -(1:R) * realSign(leading) =
    -(realSign(leading) * realSign(leading)) by ring
  rw square at negOne
  rw negOne at productSign
  have iff := realSign.eq_neg_one_iff at
    hornerFunction(leading, cs)(-(abs(B2) + 1)) *
      hornerFunction(leading, cs)(abs(B1) + 1)
  have opposite := iff.forward with productSign
  have ordered : -(abs(B2) + 1) ≤ abs(B1) + 1 by linarith
  have subset := closedInterval.subset_reals at -(abs(B2) + 1), abs(B1) + 1
  have continuousOn := hornerFunction.continuous_on at leading, cs,
    closedInterval(-(abs(B2) + 1), abs(B1) + 1) with
    initial, coefficients, subset
  obtain ⟨C, hC, zeroC⟩ := closedInterval.zero_of_opposite_signs at
    hornerFunction(leading, cs), -(abs(B2) + 1), abs(B1) + 1 with
    ordered, continuousOn, opposite
  obtain ⟨realC, lowerC, upperC⟩ := closedInterval.membership.forward with hC
  exact ⟨C, realC, zeroC⟩

end Polynomials
