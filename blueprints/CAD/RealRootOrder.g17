-- The real roots of a Horner pair in increasing order: between two
-- consecutive roots the polynomial keeps one sign, above the greatest
-- root its sign is that of the leading coefficient and below the least
-- root that sign times (−1)^degree, every root lies within the Cauchy
-- bound, between two distinct roots lies a root of the derivative, and an
-- odd degree forces a real root.
-- Part of the CAD blueprint.
-- Planned home: Real/Analysis/PolynomialRoots.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module CAD.RealRootOrder
import CAD.RealHorner
import CAD.StrictlyIncreasingList
import CAD.RealConstantSign
import Grace.Cumulus.Real.Analysis.MeanValueIntegration

section Polynomials
variable (leading cs : Set)
hypothesis initial : Real(leading)
hypothesis coefficients : List(ℝ, cs)
hypothesis nonzero : leading ≠ (0:R)

-- The roots in increasing order.
theorem rootSet.enumeration
  shows ∃ xs, List(ℝ, xs) ∧ StrictlyIncreasingList(xs) ∧
    listSupport{ℝ}(xs) = rootSet(realRing, leading, cs)
proof
  sorry

-- On an open interval free of roots the sign is constant.
theorem hornerFunction.sign_eq_without_roots (U V X Y : Real)
  requires free : ∀ r ∈ rootSet(realRing, leading, cs), ¬(U < (r:R) ∧ (r:R) < V)
  requires left : X ∈ openInterval(U, V)
  requires right : Y ∈ openInterval(U, V)
  shows realSign(hornerFunction(leading,
    cs)(X)) = realSign(hornerFunction(leading, cs)(Y))
proof
  sorry

-- Between consecutive roots, the i-th and (i+1)-th of the enumeration.
theorem hornerFunction.sign_between_roots (xs : List(ℝ)) (i : Nat)
  (U V X Y : Real)
  requires increasing : StrictlyIncreasingList(xs)
  requires support : listSupport{ℝ}(xs) = rootSet(realRing, leading, cs)
  requires bound : succ(i) < length{ℝ}(xs)
  requires lower : U = listCoefficient{ℝ}((0:R), xs, i)
  requires upper : V = listCoefficient{ℝ}((0:R), xs, succ(i))
  requires left : X ∈ openInterval(U, V)
  requires right : Y ∈ openInterval(U, V)
  shows realSign(hornerFunction(leading,
    cs)(X)) = realSign(hornerFunction(leading, cs)(Y))
proof
  sorry

-- Above every root the sign is that of the leading coefficient.
theorem hornerFunction.sign_above_roots (X : Real)
  requires above : ∀ r ∈ rootSet(realRing, leading, cs), (r:R) < X
  shows realSign(hornerFunction(leading, cs)(X)) = realSign(leading)
proof
  sorry

-- Below every root it is that sign times (−1)^degree.
theorem hornerFunction.sign_below_roots (X : Real)
  requires below : ∀ r ∈ rootSet(realRing, leading, cs), X < (r:R)
  shows realSign(hornerFunction(leading, cs)(X)) =
    realSign(leading) * (-(1:R)) ^ length{ℝ}(cs)
proof
  sorry

-- The Cauchy bound: with M bounding the lower coefficients in absolute
-- value, every root lies in |X| ≤ 1 + M / |leading|.
theorem hornerFunction.cauchy_bound (M X : Real)
  requires bound : ∀ c ∈ listSupport{ℝ}(cs), (c:R) ≤ M ∧ -M ≤ (c:R)
  requires root : hornerFunction(leading, cs)(X) = (0:R)
  shows abs(X) ≤ 1 + M / abs(leading)
proof
  sorry

theorem hornerFunction.roots_bounded
  shows ∃ B ∈ ℝ, ∀ r ∈ rootSet(realRing, leading, cs), abs(r) ≤ B
proof
  sorry

-- Far to the right and to the left the sign is settled.
theorem hornerFunction.eventually_sign_above
  shows ∃ B ∈ ℝ, ∀ X ∈ ℝ, B < X →
    realSign(hornerFunction(leading, cs)(X)) = realSign(leading)
proof
  sorry

theorem hornerFunction.eventually_sign_below
  shows ∃ B ∈ ℝ, ∀ X ∈ ℝ, X < B →
    realSign(hornerFunction(leading,
      cs)(X)) = realSign(leading) * (-(1:R)) ^ length{ℝ}(cs)
proof
  sorry

-- Rolle for polynomials: between two distinct roots lies a root of the
-- derivative.
theorem hornerFunction.rolle (X Y : Real)
  requires ordered : X < Y
  requires rootLeft : hornerFunction(leading, cs)(X) = (0:R)
  requires rootRight : hornerFunction(leading, cs)(Y) = (0:R)
  shows ∃ Z ∈ openInterval(X, Y),
    hornerFunction(realDerivativeLeading(leading, cs),
      realDerivativeList(cs))(Z) = (0:R)
proof
  sorry

theorem hornerFunction.odd_degree_root (k : Nat)
  requires odd : length{ℝ}(cs) = 2 * k + 1
  shows ∃ X ∈ ℝ, hornerFunction(leading, cs)(X) = (0:R)
proof
  sorry

end Polynomials
