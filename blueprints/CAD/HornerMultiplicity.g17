-- The multiplicity of a root of a Horner pair with nonzero leading
-- coefficient, at the level of coefficients: the translate of the pair
-- by r is m zeros followed by a list whose head (leading, if empty) is
-- nonzero, so p(r + x) = x^m·h(x) with h(0) ≠ 0; its existence,
-- uniqueness, the characterizations of non-roots and simple roots, and
-- that a root of multiplicity at least two is a root of the derivative.
-- Part of the CAD blueprint.
-- Planned home: Algebra/Polynomial/HornerMultiplicity.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module CAD.HornerMultiplicity
import CAD.HornerDerivative
import CAD.HornerNormalForm
import Grace.Cumulus.Algebra.Polynomial.HornerVanishing
import Grace.Cumulus.List.Replicate

-- r is a root of multiplicity m of (leading, cs): the translate by r is
-- m zeros followed by a list ds with listHeadOr(leading, ds) nonzero,
-- that is, the coefficient of x^m in p(r + x) is the first nonzero one.
predicate HasMultiplicity (A add zero neg mul one leading cs r m : Set) :=
  Nat(m) ∧ ∃ ds, List(A, ds) ∧ listHeadOr{A}(leading, ds) ≠ zero ∧
    hornerTranslate{A}(add, mul, one, leading, r, cs) =
      append{A}(ds, listReplicate(m, zero))

-- Coefficients of a list with m leading zeros, and the head of the
-- derivative pair as the coefficient of x.
section Coefficients
variable (A add zero neg mul one leading : Set)
notation ring R := (A, add, zero, neg, mul, one)
hypothesis ring : IsCommRing(R)
hypothesis initial : leading ∈ R

theorem hornerFullList.cons (c : Set) (tail : List(A))
  requires coefficient : c ∈ R
  shows hornerFullList{A}(leading, c :: tail) =
    c :: hornerFullList{A}(leading, tail)
proof
  have single : List(A, leading :: []) by typecheck
  unfold hornerFullList
  exact append.cons at A, c, tail, leading :: [] with *

theorem hornerCoefficient.head (ls : List(A))
  shows hornerCoefficient{A}(zero, leading, ls, (0:N)) =
    listHeadOr{A}(leading, ls)
proof
  have shape := List.cases at A, ls with *
  cases shape with empty | cons
  . have top := hornerCoefficient.leading at A, zero, leading, [] with *
    rw length.nil at top
    rw [empty, top, listHeadOr]
    rfl
  . obtain ⟨c, coefficient, tail, tailList, equal⟩ := cons
    have positive := length.cons_positive at A, c, tail with *
    have below := hornerCoefficient.below at A, zero, leading, c :: tail, (0:N)
      with *
    rw [equal, below, listCoefficient.zero, listHeadOr]
    rfl

theorem hornerCoefficient.succ (c : Set) (tail : List(A)) (k : Nat)
  requires coefficient : c ∈ R
  shows hornerCoefficient{A}(zero, leading, c :: tail, succ(k)) =
    hornerCoefficient{A}(zero, leading, tail, k)
proof
  have full := hornerFullList.list at A, leading, tail with *
  have expansion := hornerFullList.cons at A, add, zero, neg, mul, one,
    leading, c, tail with *
  unfold hornerCoefficient
  rw [expansion, listCoefficient.succ]
  rfl

theorem hornerCoefficient.shift_below (ds : List(A)) (m k : Nat)
  requires bound : k < m
  shows hornerCoefficient{A}(zero, leading,
    append{A}(ds, listReplicate(m, zero)), k) = zero
proof
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have zeros := listReplicate.closed at A, zero, m with *
  have zerosLength := listReplicate.length at A, zero, m with *
  have appended : List(A, append{A}(ds, listReplicate(m, zero))) by typecheck
  have total := length.append at A, ds, listReplicate(m, zero) with *
  have inside : k < length{A}(append{A}(ds, listReplicate(m, zero)))
    rw [total, zerosLength]
    arith
  have below := hornerCoefficient.below at A, zero, leading,
    append{A}(ds, listReplicate(m, zero)), k with *
  have inZeros : k < length{A}(listReplicate(m, zero))
    rw zerosLength
    exact bound
  have left := listCoefficient.append_left at A, zero, listReplicate(m, zero),
    ds, k with *
  have entry := listReplicate.coefficient at A, zero, zero, m, k with *
  rw [below, left, entry]
  rfl

theorem hornerCoefficient.shift_at (ds : List(A)) (m : Nat)
  shows hornerCoefficient{A}(zero, leading,
    append{A}(ds, listReplicate(m, zero)), m) = listHeadOr{A}(leading, ds)
proof
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have zeros := listReplicate.closed at A, zero, m with *
  have zerosLength := listReplicate.length at A, zero, m with *
  have appended : List(A, append{A}(ds, listReplicate(m, zero))) by typecheck
  have total := length.append at A, ds, listReplicate(m, zero) with *
  have shape := List.cases at A, ds with *
  cases shape with empty | cons
  . rw empty at total
    rw [zerosLength, length.nil, add.right_unit] at total
    have top := hornerCoefficient.leading at A, zero, leading,
      append{A}([], listReplicate(m, zero)) with *
    rw total at top
    rw [empty, top, listHeadOr]
    rfl
  . obtain ⟨d, dIn, tail, tailList, equal⟩ := cons
    have inside : m < length{A}(append{A}(ds, listReplicate(m, zero)))
      rw [total, zerosLength, equal, length.cons]
      arith
    have below := hornerCoefficient.below at A, zero, leading,
      append{A}(ds, listReplicate(m, zero)), m with *
    have right := listCoefficient.append_right at A, zero,
      listReplicate(m, zero), ds, (0:N) with *
    rw [zerosLength, add.left_unit] at right
    rw [below, right, equal, listCoefficient.zero, listHeadOr]
    rfl

-- m leading zeros are a factor x^m of the value.
theorem hornerAt.shift (x : Set) (ds : List(A)) (m : Nat)
  requires element : x ∈ R
  shows hornerAt{A}(add, mul, leading, x,
      append{A}(ds, listReplicate(m, zero))) =
    R[monoidPow(R, x, m) * hornerAt{A}(add, mul, leading, x, ds)]
proof
  induction m
  | zero =>
    have ordinary := IsCommRing.ring with ring
    have value := hornerAt.closed at A, add, zero, neg, mul, one, leading, x,
      ds with *
    rw [listReplicate.zero, append.nil, monoidPow.zero]
    ring
  | succ(k) using ih =>
    have ordinary := IsCommRing.ring with ring
    have monoid := IsRing.multiplicative with ordinary
    have zeroIn := IsRing.zero_in_carrier with ordinary
    have value := hornerAt.closed at A, add, zero, neg, mul, one, leading, x,
      ds with *
    have zeros := listReplicate.closed at A, zero, k with *
    have appended : List(A, append{A}(ds, listReplicate(k, zero))) by typecheck
    have expansion := append.cons at A, zero, listReplicate(k, zero), ds with *
    have power := monoidPow.closed at A, mul, one, x, k with *
    rw [listReplicate.succ, expansion, hornerAt.cons, ih, monoidPow.succ]
    ring

-- The head of the derivative pair is the coefficient of x.
theorem hornerDerivative.head (ls : List(A))
  shows listHeadOr{A}(hornerDerivativeLeading{A}(add, zero, one, mul, leading,
      ls), hornerDerivativeList{A}(add, zero, one, mul, ls)) =
    hornerCoefficient{A}(zero, leading, ls, (1:N))
proof
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have shape := List.cases at A, ls with *
  cases shape with empty | cons
  . have positive : length{A}([]) < (1:N)
      rw length.nil
      exact Less.zero_one
    have above := hornerCoefficient.above at A, zero, leading, [], (1:N) with *
    rw [empty, hornerDerivativeLeading.nil, hornerDerivativeList.nil,
      listHeadOr, above]
    rfl
  . obtain ⟨c, cIn, tail, tailList, equal⟩ := cons
    have derivativeList := hornerDerivativeList.cons at A, add, zero, one, mul,
      c, tail
    have shift := hornerCoefficient.succ at A, add, zero, neg, mul, one,
      leading, c, tail, (0:N) with *
    have headTail := hornerCoefficient.head at A, add, zero, neg, mul, one,
      leading, tail with *
    rw [equal, derivativeList, shift, headTail]
    have tailShape := List.cases at A, tail with *
    cases tailShape with tailEmpty | tailCons
    . have empty : List(A, []) by typecheck
      rw [tailEmpty, hornerIndexScale, listHeadOr, listHeadOr]
      unfold hornerDerivativeLeading
      rw [length.cons, length.nil, ringNat.succ, ringNat.zero]
      ring
    . obtain ⟨d, dIn, rest, restList, tailEqual⟩ := tailCons
      have scaleCons := hornerIndexScale.cons at A, add, zero, one, mul, d,
        (1:N), rest
      have unit := IsRing.numeral_one with ordinary
      rw [tailEqual, scaleCons, listHeadOr, listHeadOr, unit]
      ring

end Coefficients

section Rings
variable (A add zero neg mul one leading : Set)
notation ring R := (A, add, zero, neg, mul, one)
hypothesis ring : IsCommRing(R)
hypothesis initial : leading ∈ R
hypothesis nonzero : leading ≠ R[0]

-- Every list is some zeros followed by a list with nonzero head.
theorem HasMultiplicity.first_nonzero (ls : List(A))
  shows ∃ m ∈ ℕ, ∃ ds, List(A, ds) ∧ listHeadOr{A}(leading, ds) ≠ zero ∧
    ls = append{A}(ds, listReplicate(m, zero))
proof
  induction ls
  | List.nil =>
    have zeroNat : (0:N) ∈ ℕ by typecheck
    have empty : List(A, []) by typecheck
    have head : listHeadOr{A}(leading, []) ≠ zero by rwa listHeadOr
    refine ⟨(0:N), zeroNat, [], empty, head, ?_⟩
    rw [listReplicate.zero, append.nil]
    rfl
  | List.cons(c, tail) using ih =>
    have coefficient : c ∈ R by assumption
    have list : List(A, c :: tail) by typecheck
    have ordinary := IsCommRing.ring with ring
    have zeroIn := IsRing.zero_in_carrier with ordinary
    have comparison : c = zero ∨ c ≠ zero by tauto
    cases comparison with vanishes | survives
    . obtain ⟨m, mIn, ds, dsList, head, equal⟩ := ih
      have mNat := nat.omega.backward with mIn
      have next : succ(m) ∈ ℕ by typecheck
      have zeros := listReplicate.closed at A, zero, m with *
      have expansion := append.cons at A, zero, listReplicate(m, zero), ds
        with *
      refine ⟨succ(m), next, ds, dsList, head, ?_⟩
      rw [listReplicate.succ, expansion, ← equal, vanishes]
      rfl
    . have zeroNat : (0:N) ∈ ℕ by typecheck
      have head : listHeadOr{A}(leading, c :: tail) ≠ zero by rwa listHeadOr
      refine ⟨(0:N), zeroNat, c :: tail, list, head, ?_⟩
      rw [listReplicate.zero, append.nil]
      rfl

-- The number of leading zeros is determined: it is the first nonzero
-- coefficient's index.
theorem HasMultiplicity.unique_lists (ls ds es : List(A)) (m n : Nat)
  requires headD : listHeadOr{A}(leading, ds) ≠ zero
  requires headE : listHeadOr{A}(leading, es) ≠ zero
  requires equalD : ls = append{A}(ds, listReplicate(m, zero))
  requires equalE : ls = append{A}(es, listReplicate(n, zero))
  shows m = n
proof
  have shape := Less.trichotomy at m, n with *
  rcases shape with below | same | above
  . have atD := hornerCoefficient.shift_at at A, add, zero, neg, mul, one,
      leading, ds, m with *
    have atE := hornerCoefficient.shift_below at A, add, zero, neg, mul, one,
      leading, es, n, m with *
    rw ← equalD at atD
    rw ← equalE at atE
    exfalso
    apply headD
    rw [← atD, atE]
    rfl
  . exact same
  . have atE := hornerCoefficient.shift_at at A, add, zero, neg, mul, one,
      leading, es, n with *
    have atD := hornerCoefficient.shift_below at A, add, zero, neg, mul, one,
      leading, ds, m, n with *
    rw ← equalE at atE
    rw ← equalD at atD
    exfalso
    apply headE
    rw [← atE, atD]
    rfl

-- Existence, from the first nonzero coefficient of the translated list.
theorem HasMultiplicity.exists_nat (r : Set) (cs : List(A))
  requires center : r ∈ R
  shows ∃ m ∈ ℕ,
    HasMultiplicity(A, add, zero, neg, mul, one, leading, cs, r, m)
proof
  have data := hornerTranslate.data at A, add, zero, neg, mul, one, leading, r,
    cs with *
  have translated := data.left
  obtain ⟨m, mIn, ds, dsList, head, equal⟩ :=
    HasMultiplicity.first_nonzero at A, add, zero, neg, mul, one, leading,
      hornerTranslate{A}(add, mul, one, leading, r, cs) with *
  have mNat := nat.omega.backward with mIn
  refine ⟨m, mIn, mNat, ds, dsList, head, equal⟩

-- Existence and uniqueness are HasMultiplicity.exists and .unique below.
defunique rootMultiplicity (cs r : Set) (m ∈ ℕ) :=
  HasMultiplicity(A, add, zero, neg, mul, one, leading, cs, r, m)
requires coefficients : List(A, cs)
requires center : r ∈ R
proof
  obtain ⟨m, mIn, has⟩ := HasMultiplicity.exists_nat at A, add, zero, neg, mul,
    one, leading, r, cs with *
  witness m
  refine ⟨mIn, has⟩
uniqueness
  intros m hm first n hn second
  obtain ⟨mNat, ds, dsList, headD, equalD⟩ := first
  obtain ⟨nNat, es, esList, headE, equalE⟩ := second
  have data := hornerTranslate.data at A, add, zero, neg, mul, one, leading, r,
    cs with *
  have translated := data.left
  exact HasMultiplicity.unique_lists at A, add, zero, neg, mul, one, leading,
    hornerTranslate{A}(add, mul, one, leading, r, cs), ds, es, m, n with *

theorem HasMultiplicity.exists (r : Set) (cs : List(A))
  requires center : r ∈ R
  shows ∃ m, HasMultiplicity(A, add, zero, neg, mul, one, leading, cs, r, m)
proof
  obtain ⟨m, mIn, has⟩ := HasMultiplicity.exists_nat at A, add, zero, neg, mul,
    one, leading, r, cs with *
  refine ⟨m, has⟩

theorem HasMultiplicity.unique (r m n : Set) (cs : List(A))
  requires center : r ∈ R
  requires first : HasMultiplicity(A, add, zero, neg, mul, one, leading, cs, r,
    m)
  requires second : HasMultiplicity(A, add, zero, neg, mul, one, leading, cs,
    r, n)
  shows m = n
proof
  obtain ⟨mNat, ds, dsList, headD, equalD⟩ := first
  obtain ⟨nNat, es, esList, headE, equalE⟩ := second
  have data := hornerTranslate.data at A, add, zero, neg, mul, one, leading, r,
    cs with *
  have translated := data.left
  exact HasMultiplicity.unique_lists at A, add, zero, neg, mul, one, leading,
    hornerTranslate{A}(add, mul, one, leading, r, cs), ds, es, m, n with *

-- The value identity p(r + x) = x^m·h(x) with h(0) ≠ 0 and the degree
-- count, derived from the coefficient form.
theorem HasMultiplicity.value (r m x : Set) (cs : List(A))
  requires center : r ∈ R
  requires element : x ∈ R
  requires has : HasMultiplicity(A, add, zero, neg, mul, one, leading, cs, r,
    m)
  shows ∃ ds, List(A, ds) ∧ listHeadOr{A}(leading, ds) ≠ zero ∧
    length{A}(cs) = Grace.Core.Nat.Rec.add(m, length{A}(ds)) ∧
    hornerAt{A}(add, mul, leading, x,
      hornerTranslate{A}(add, mul, one, leading, r, cs)) =
      R[monoidPow(R, x, m) * hornerAt{A}(add, mul, leading, x, ds)]
proof
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  obtain ⟨mNat, ds, dsList, head, equal⟩ := has
  have data := hornerTranslate.data at A, add, zero, neg, mul, one, leading, r,
    cs with *
  have zeros := listReplicate.closed at A, zero, m with *
  have zerosLength := listReplicate.length at A, zero, m with *
  have total := length.append at A, ds, listReplicate(m, zero) with *
  have shifted := hornerAt.shift at A, add, zero, neg, mul, one, leading, x,
    ds, m with *
  refine ⟨ds, dsList, head, ?_, ?_⟩
  . rw [← data.right, equal, total, zerosLength]
    rfl
  . rw [equal, shifted]
    rfl

instance rootMultiplicity.natural (r : Set) (cs : List(A))
  requires center : r ∈ R
  shows Nat(rootMultiplicity(cs, r))
proof
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have lengthNat : Nat(length{A}(cs)) by typecheck
  have lengthOrdinal := Ordinal.natural at length{A}(cs) with lengthNat
  have data := hornerTranslate.data at A, add, zero, neg, mul, one, leading, r,
    cs with *
  have members : ∀ m ∈ rootMultiplicity.candidates(A, add, zero, neg, mul, one,
      leading, cs, r), m ∈ Ordinal
    intros m hm
    have parts := rootMultiplicity.candidates.membership.forward with hm
    have mNat := nat.omega.backward with parts.left
    exact Ordinal.natural with mNat
  have bounded : ∀ m ∈ rootMultiplicity.candidates(A, add, zero, neg, mul, one,
      leading, cs, r), m ⊆ length{A}(cs)
    intros m hm
    have parts := rootMultiplicity.candidates.membership.forward with hm
    have mNat := nat.omega.backward with parts.left
    obtain ⟨natural, ds, dsList, head, equal⟩ := parts.right
    have zeros := listReplicate.closed at A, zero, m with *
    have zerosLength := listReplicate.length at A, zero, m with *
    have total := length.append at A, ds, listReplicate(m, zero) with *
    have le : m ≤ length{A}(cs)
      rw [← data.right, equal, total, zerosLength]
      arith
    have inSucc := membership.successor_of_LessEqual with le
    have split := membership.successor.forward with inSucc
    cases split with below | same
    . exact Ordinal.member_subset with lengthOrdinal, below
    . rw same
      exact Subset.reflexive
  have ordinal := Ordinal.union with members
  have subset := Ordinal.union_least with bounded
  have bound := Ordinal.subset_bound with ordinal, lengthOrdinal, subset
  have split := next.membership.forward with bound
  unfold rootMultiplicity
  cases split with below | same
  . have inside := natural.member at length{A}(cs) with lengthNat
    exact inside with below
  . rw same
    exact lengthNat

theorem rootMultiplicity.has (r : Set) (cs : List(A))
  requires center : r ∈ R
  shows HasMultiplicity(A, add, zero, neg, mul, one, leading, cs, r,
    rootMultiplicity(cs, r))
proof
  have selected := rootMultiplicity.selected at A, add, zero, neg, mul, one,
    leading, cs, r with *
  exact selected.right

theorem rootMultiplicity.le_length (r : Set) (cs : List(A))
  requires center : r ∈ R
  shows rootMultiplicity(cs, r) ≤ length{A}(cs)
proof
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have has := rootMultiplicity.has at A, add, zero, neg, mul, one, leading, r,
    cs with *
  obtain ⟨natural, ds, dsList, head, equal⟩ := has
  have data := hornerTranslate.data at A, add, zero, neg, mul, one, leading, r,
    cs with *
  have zeros := listReplicate.closed at A, zero, rootMultiplicity(cs, r) with *
  have zerosLength := listReplicate.length at A, zero, rootMultiplicity(cs, r)
    with *
  have total := length.append at A, ds, listReplicate(rootMultiplicity(cs, r),
    zero) with *
  rw [← data.right, equal, total, zerosLength]
  arith

-- The value at r is the coefficient of x^0 of the translated pair.
theorem hornerTranslate.coefficient_zero (r : Set) (cs : List(A))
  requires center : r ∈ R
  shows hornerCoefficient{A}(zero, leading,
      hornerTranslate{A}(add, mul, one, leading, r, cs), (0:N)) =
    hornerAt{A}(add, mul, leading, r, cs)
proof
  have data := hornerTranslate.data at A, add, zero, neg, mul, one, leading, r,
    cs with *
  have translated := data.left
  have head := hornerCoefficient.head at A, add, zero, neg, mul, one, leading,
    hornerTranslate{A}(add, mul, one, leading, r, cs) with *
  have constant := hornerTranslate.constant at A, add, zero, neg, mul, one,
    leading, r, cs with *
  rw [head, constant]
  rfl

-- The derivative at r is the coefficient of x^1 of the translated pair.
theorem hornerDerivative.at_center (r : Set) (cs : List(A))
  requires center : r ∈ R
  shows hornerAt{A}(add, mul, hornerDerivativeLeading{A}(add, zero, one, mul,
      leading, cs), r, hornerDerivativeList{A}(add, zero, one, mul, cs)) =
    hornerCoefficient{A}(zero, leading,
      hornerTranslate{A}(add, mul, one, leading, r, cs), (1:N))
proof
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have data := hornerTranslate.data at A, add, zero, neg, mul, one, leading, r,
    cs with *
  have translated := data.left
  have translate := hornerDerivative.translate at A, add, zero, neg, mul, one,
    leading, r, R[0], cs with *
  have shifted : R[r + 0] = r by ring
  rw shifted at translate
  have leadT := hornerDerivativeLeading.closed at A, add, zero, neg, mul, one,
    leading, hornerTranslate{A}(add, mul, one, leading, r, cs) with *
  have listT := hornerDerivativeList.data at A, add, zero, neg, mul, one,
    leading, hornerTranslate{A}(add, mul, one, leading, r, cs) with *
  have derivativeList := listT.left
  have atZero := hornerAt.at_zero at A, add, zero, neg, mul, one,
    hornerDerivativeLeading{A}(add, zero, one, mul, leading,
      hornerTranslate{A}(add, mul, one, leading, r, cs)), r,
    hornerDerivativeList{A}(add, zero, one, mul,
      hornerTranslate{A}(add, mul, one, leading, r, cs)) with *
  have head := hornerDerivative.head at A, add, zero, neg, mul, one, leading,
    hornerTranslate{A}(add, mul, one, leading, r, cs) with *
  rw [← translate, atZero, head]
  rfl

-- Multiplicity zero is exactly not being a root.
theorem rootMultiplicity.zero_iff (r : Set) (cs : List(A))
  requires center : r ∈ R
  shows rootMultiplicity(cs, r) = 0 ↔
    hornerAt{A}(add, mul, leading, r, cs) ≠ R[0]
proof
  have has := rootMultiplicity.has at A, add, zero, neg, mul, one, leading, r,
    cs with *
  obtain ⟨natural, ds, dsList, head, equal⟩ := has
  have constant := hornerTranslate.coefficient_zero at A, add, zero, neg, mul,
    one, leading, r, cs with *
  constructor
  . intro vanishes
    have atM := hornerCoefficient.shift_at at A, add, zero, neg, mul, one,
      leading, ds, rootMultiplicity(cs, r) with *
    rw ← equal at atM
    rw vanishes at atM
    rw [← constant, atM]
    exact head
  . intro survives
    have shape := natural.zero_or_successor at rootMultiplicity(cs, r) with *
    cases shape with isZero | isSucc
    . exact isZero
    . obtain ⟨k, kNat, equalM⟩ := isSucc
      exfalso
      apply survives
      have positive : (0:N) < rootMultiplicity(cs, r)
        have notZero : rootMultiplicity(cs, r) ≠ 0
          rw equalM
          exact succ.ne_zero at k
        exact Less.positive_of_ne_zero with natural, notZero
      have below := hornerCoefficient.shift_below at A, add, zero, neg, mul,
        one, leading, ds, rootMultiplicity(cs, r), (0:N) with *
      rw ← equal at below
      rw [← constant, below]
      rfl

theorem rootMultiplicity.positive_iff (r : Set) (cs : List(A))
  requires center : r ∈ R
  shows 1 ≤ rootMultiplicity(cs, r) ↔
    hornerAt{A}(add, mul, leading, r, cs) = R[0]
proof
  have natural := rootMultiplicity.natural at A, add, zero, neg, mul, one,
    leading, r, cs with *
  have criterion := rootMultiplicity.zero_iff at A, add, zero, neg, mul, one,
    leading, r, cs with *
  constructor
  . intro positive
    have alternatives : hornerAt{A}(add, mul, leading, r, cs) = R[0] ∨
      hornerAt{A}(add, mul, leading, r, cs) ≠ R[0] by tauto
    cases alternatives with root | survives
    . exact root
    . have vanishes := criterion.backward with survives
      rw vanishes at positive
      have zeroLe := Grace.Cumulus.Nat.Order.LessEqual.zero at (1:N)
      have equal := LessEqual.antisymmetric with positive, zeroLe
      exfalso
      exact succ.ne_zero at (0:N) with equal
  . intro root
    have nonzeroValue : rootMultiplicity(cs, r) ≠ 0
      intro vanishes
      have survives := criterion.forward with vanishes
      exact survives with root
    have positive := Less.positive_of_ne_zero with natural, nonzeroValue
    exact LessEqual.one_of_positive with natural, positive

-- A root of multiplicity at least two is a root of the derivative.
theorem rootMultiplicity.derivative_root (r : Set) (cs : List(A))
  requires center : r ∈ R
  requires repeated : 2 ≤ rootMultiplicity(cs, r)
  shows hornerAt{A}(add, mul, hornerDerivativeLeading{A}(add, zero, one, mul,
    leading, cs), r,
    hornerDerivativeList{A}(add, zero, one, mul, cs)) = R[0]
proof
  have has := rootMultiplicity.has at A, add, zero, neg, mul, one, leading, r,
    cs with *
  obtain ⟨natural, ds, dsList, head, equal⟩ := has
  have value := hornerDerivative.at_center at A, add, zero, neg, mul, one,
    leading, r, cs with *
  have bound : (1:N) < rootMultiplicity(cs, r) by arith
  have below := hornerCoefficient.shift_below at A, add, zero, neg, mul, one,
    leading, ds, rootMultiplicity(cs, r), (1:N) with *
  rw ← equal at below
  rw [value, below]
  rfl

-- A simple root is a root at which the derivative does not vanish.
theorem rootMultiplicity.one_iff (r : Set) (cs : List(A))
  requires center : r ∈ R
  shows rootMultiplicity(cs, r) = 1 ↔
    (hornerAt{A}(add, mul, leading, r, cs) = R[0] ∧
      hornerAt{A}(add, mul, hornerDerivativeLeading{A}(add, zero, one, mul,
        leading, cs), r,
        hornerDerivativeList{A}(add, zero, one, mul, cs)) ≠ R[0])
proof
  have has := rootMultiplicity.has at A, add, zero, neg, mul, one, leading, r,
    cs with *
  obtain ⟨natural, ds, dsList, head, equal⟩ := has
  have value := hornerDerivative.at_center at A, add, zero, neg, mul, one,
    leading, r, cs with *
  have constant := hornerTranslate.coefficient_zero at A, add, zero, neg, mul,
    one, leading, r, cs with *
  have atM := hornerCoefficient.shift_at at A, add, zero, neg, mul, one,
    leading, ds, rootMultiplicity(cs, r) with *
  rw ← equal at atM
  constructor
  . intro isOne
    have positive : (0:N) < rootMultiplicity(cs, r)
      rw isOne
      exact Less.zero_one
    have below := hornerCoefficient.shift_below at A, add, zero, neg, mul, one,
      leading, ds, rootMultiplicity(cs, r), (0:N) with *
    rw ← equal at below
    rw isOne at atM
    constructor
    . rw [← constant, below]
      rfl
    . rw [value, atM]
      exact head
  . intro both
    obtain ⟨root, derivative⟩ := both
    have notZero : rootMultiplicity(cs, r) ≠ 0
      intro isZero
      rw isZero at atM
      apply head
      rw [← atM, constant]
      exact root
    have notAbove : ¬((1:N) < rootMultiplicity(cs, r))
      intro above
      have below := hornerCoefficient.shift_below at A, add, zero, neg, mul,
        one, leading, ds, rootMultiplicity(cs, r), (1:N) with *
      rw ← equal at below
      apply derivative
      rw [value, below]
      rfl
    have le := LessEqual.of_not_Less with notAbove
    have positive := Less.positive_of_ne_zero with natural, notZero
    have ge := LessEqual.one_of_positive with natural, positive
    exact LessEqual.antisymmetric with le, ge

-- A common root of a pair and its derivative is a repeated root.
theorem rootMultiplicity.two_le_of_common_root (r : Set) (cs : List(A))
  requires center : r ∈ R
  requires root : hornerAt{A}(add, mul, leading, r, cs) = R[0]
  requires derivativeRoot : hornerAt{A}(add, mul,
    hornerDerivativeLeading{A}(add, zero, one, mul, leading, cs), r,
    hornerDerivativeList{A}(add, zero, one, mul, cs)) = R[0]
  shows 2 ≤ rootMultiplicity(cs, r)
proof
  have has := rootMultiplicity.has at A, add, zero, neg, mul, one, leading, r,
    cs with *
  obtain ⟨natural, ds, dsList, head, equal⟩ := has
  have value := hornerDerivative.at_center at A, add, zero, neg, mul, one,
    leading, r, cs with *
  have constant := hornerTranslate.coefficient_zero at A, add, zero, neg, mul,
    one, leading, r, cs with *
  have atM := hornerCoefficient.shift_at at A, add, zero, neg, mul, one,
    leading, ds, rootMultiplicity(cs, r) with *
  rw ← equal at atM
  have notZero : rootMultiplicity(cs, r) ≠ 0
    intro isZero
    rw isZero at atM
    apply head
    rw [← atM, constant]
    exact root
  have notOne : rootMultiplicity(cs, r) ≠ 1
    intro isOne
    rw isOne at atM
    apply head
    rw [← atM, ← value]
    exact derivativeRoot
  have shape := natural.zero_or_successor at rootMultiplicity(cs, r) with *
  cases shape with isZero | isSucc
  . exfalso
    exact notZero with isZero
  . obtain ⟨k, kNat, equalK⟩ := isSucc
    have shapeK := natural.zero_or_successor at k with kNat
    cases shapeK with kZero | kSucc
    . exfalso
      apply notOne
      rw [equalK, kZero]
      rfl
    . obtain ⟨j, jNat, equalJ⟩ := kSucc
      rw [equalK, equalJ]
      arith

end Rings
