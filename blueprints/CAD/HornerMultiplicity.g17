-- The multiplicity of a root of a Horner pair with nonzero leading
-- coefficient: p(r + x) = x^m·h(x) with h(0) ≠ 0, by translation and the
-- first nonzero term; its existence, uniqueness, the characterizations of
-- non-roots and simple roots, and that a root of multiplicity at least
-- two is a root of the derivative.
-- Part of the CAD blueprint.
-- Planned home: Algebra/Polynomial/HornerMultiplicity.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module CAD.HornerMultiplicity
import CAD.HornerDerivative
import Grace.Cumulus.Algebra.Polynomial.HornerVanishing

-- r is a root of multiplicity m of (leading, cs): the translate by r is
-- x^m times a pair whose value at 0 is nonzero.
predicate HasMultiplicity (A add zero neg mul one leading cs r m : Set) :=
  Nat(m) ∧ ∃ ds, List(A, ds) ∧ listHeadOr{A}(leading, ds) ≠ zero ∧
    length{A}(cs) = m + length{A}(ds) ∧
    (∀ x ∈ A, hornerAt{A}(add, mul, leading, x, hornerTranslate{A}(add, mul,
      one, leading, r, cs)) =
      call2(mul, monoidPow(mul, one, x, m), hornerAt{A}(add, mul, leading, x,
        ds)))

-- Existence and uniqueness are HasMultiplicity.exists and .unique below.
defunique rootMultiplicity (A add zero neg mul one leading cs r : Set)
  (m ∈ ℕ) :=
  HasMultiplicity(A, add, zero, neg, mul, one, leading, cs, r, m)
requires ring : IsCommRing(A, add, zero, neg, mul, one)
requires initial : leading ∈ A
requires nonzero : leading ≠ zero
requires coefficients : List(A, cs)
requires center : r ∈ A
proof
  sorry
uniqueness
  sorry

section Rings
variable (A add zero neg mul one leading : Set)
notation ring R := (A, add, zero, neg, mul, one)
hypothesis ring : IsCommRing(R)
hypothesis initial : leading ∈ R
hypothesis nonzero : leading ≠ R[0]

theorem HasMultiplicity.exists (r : Set) (cs : List(A))
  requires center : r ∈ R
  shows ∃ m, HasMultiplicity(A, add, zero, neg, mul, one, leading, cs, r, m)
proof
  sorry

theorem HasMultiplicity.unique (r m n : Set) (cs : List(A))
  requires center : r ∈ R
  requires first : HasMultiplicity(A, add, zero, neg, mul, one, leading, cs, r,
    m)
  requires second : HasMultiplicity(A, add, zero, neg, mul, one, leading, cs,
    r, n)
  shows m = n
proof
  sorry

theorem rootMultiplicity.natural (r : Set) (cs : List(A))
  requires center : r ∈ R
  shows Nat(rootMultiplicity(A, add, zero, neg, mul, one, leading, cs, r))
proof
  sorry

theorem rootMultiplicity.has (r : Set) (cs : List(A))
  requires center : r ∈ R
  shows HasMultiplicity(A, add, zero, neg, mul, one, leading, cs, r,
    rootMultiplicity(A, add, zero, neg, mul, one, leading, cs, r))
proof
  sorry

theorem rootMultiplicity.le_length (r : Set) (cs : List(A))
  requires center : r ∈ R
  shows rootMultiplicity(A, add, zero, neg, mul, one, leading, cs,
    r) ≤ length{A}(cs)
proof
  sorry

-- Multiplicity zero is exactly not being a root.
theorem rootMultiplicity.zero_iff (r : Set) (cs : List(A))
  requires center : r ∈ R
  shows rootMultiplicity(A, add, zero, neg, mul, one, leading, cs, r) = (0:N) ↔
    hornerAt{A}(add, mul, leading, r, cs) ≠ R[0]
proof
  sorry

theorem rootMultiplicity.positive_iff (r : Set) (cs : List(A))
  requires center : r ∈ R
  shows (1:N) ≤ rootMultiplicity(A, add, zero, neg, mul, one, leading, cs, r) ↔
    hornerAt{A}(add, mul, leading, r, cs) = R[0]
proof
  sorry

-- A root of multiplicity at least two is a root of the derivative.
theorem rootMultiplicity.derivative_root (r : Set) (cs : List(A))
  requires center : r ∈ R
  requires repeated : (2:N) ≤ rootMultiplicity(A, add, zero, neg, mul, one,
    leading, cs, r)
  shows hornerAt{A}(add, mul, hornerDerivativeLeading{A}(add, zero, one, mul,
    leading, cs), r,
    hornerDerivativeList{A}(add, zero, one, mul, cs)) = R[0]
proof
  sorry

-- A simple root is a root at which the derivative does not vanish.
theorem rootMultiplicity.one_iff (r : Set) (cs : List(A))
  requires center : r ∈ R
  shows rootMultiplicity(A, add, zero, neg, mul, one, leading, cs, r) = (1:N) ↔
    (hornerAt{A}(add, mul, leading, r, cs) = R[0] ∧
      hornerAt{A}(add, mul, hornerDerivativeLeading{A}(add, zero, one, mul,
        leading, cs), r,
        hornerDerivativeList{A}(add, zero, one, mul, cs)) ≠ R[0])
proof
  sorry

-- A common root of a pair and its derivative is a repeated root.
theorem rootMultiplicity.two_le_of_common_root (r : Set) (cs : List(A))
  requires center : r ∈ R
  requires root : hornerAt{A}(add, mul, leading, r, cs) = R[0]
  requires derivativeRoot : hornerAt{A}(add, mul,
    hornerDerivativeLeading{A}(add, zero, one, mul, leading, cs), r,
    hornerDerivativeList{A}(add, zero, one, mul, cs)) = R[0]
  shows (2:N) ≤ rootMultiplicity(A, add, zero, neg, mul, one, leading, cs, r)
proof
  sorry

end Rings
