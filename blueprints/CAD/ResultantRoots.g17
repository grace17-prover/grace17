-- The resultant over the complex numbers vanishes exactly when the two
-- pairs have a common root: by the fundamental theorem of algebra a pair
-- with nonzero leading coefficient is a product of linear factors, and
-- the resultant is aⁿ times the product of the values of q at the roots
-- of p. For real pairs, read in ℂ along complexOfReal, the real resultant
-- vanishes exactly when they have a common complex root.
-- Part of the CAD blueprint.
-- Planned home: Complex/Resultant.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module CAD.ResultantRoots
import CAD.Resultant
import CAD.ComplexEmbedding
import Grace.Cumulus.Complex.FundamentalTheoremGeneral

-- ∏ (z − r) over the list rs, and ∏ q(r) over rs.
def complexLinearProduct (rs : List(complexCarrier), z : Set) → Set
  | List.nil, z => complexOne
  | List.cons(r, rest), z =>
      complexMul(complexAdd(z, complexNeg(r)), complexLinearProduct(rest, z))

def complexValueProduct (b : Set, ds rs : List(complexCarrier)) → Set
  | b, ds, List.nil => complexOne
  | b, ds, List.cons(r, rest) =>
      complexMul(hornerAt{complexCarrier}(complexAdd, complexMul, b, r, ds),
        complexValueProduct(b, ds, rest))

-- The lower coefficients of the monic pair ∏ (X − r) over rs, built by
-- the affine products (X − r)·(1, ls).
def complexLinearList (rs : List(complexCarrier)) → Set
  | List.nil => []
  | List.cons(r, rest) =>
      hornerAffineProduct{complexCarrier}(complexAdd, complexMul, complexOne,
        complexNeg(r), complexOne, complexZero, complexLinearList(rest))

-- A bordered determinant: when the last column of a matrix of size n + 1
-- vanishes above its corner, the determinant is the corner times the
-- determinant of the leading n × n block. The permutations of n + 1 that
-- move n contribute nothing, and those fixing n are the permutations of
-- n extended by the fixed point, with the same inversions.
defgraph extendFixed (n p : Set) (i ∈ succ(n)) : succ(n) :=
  boolChoice(memberTest(n, i), p(i), n)
requires permutation : p ∈ permutations(n)
proof
  have function := permutations.function with permutation
  have alternatives : i ∈ n ∨ ¬(i ∈ n) by tauto
  cases alternatives with member | absent
  . have test := memberTest.true with member
    have image := FunctionBetween.apply_closed with function, member
    have inSucc : p(i) ∈ succ(n)
      rw bootstrap.succ.membership
      left
      exact image
    rw [test, boolChoice.true]
    exact inSucc
  . have test := memberTest.false with absent
    rw [test, boolChoice.false]
    exact bootstrap.succ.self at n

theorem extendFixed.low (n p i : Set)
  requires permutation : p ∈ permutations(n)
  requires member : i ∈ n
  shows extendFixed(n, p)(i) = p(i)
proof
  have inSucc : i ∈ succ(n)
    rw bootstrap.succ.membership
    left
    exact member
  have value := extendFixed.value at n, p, i with permutation, inSucc
  have test := memberTest.true with member
  rw [value, test, boolChoice.true]
  rfl

theorem extendFixed.top (n p : Set)
  requires permutation : p ∈ permutations(n)
  shows extendFixed(n, p)(n) = n
proof
  have self := bootstrap.succ.self at n
  have value := extendFixed.value at n, p, n with permutation, self
  have absent : ¬(n ∈ n) := membership.irreflexive at n
  have test := memberTest.false with absent
  rw [value, test, boolChoice.false]
  rfl

theorem succ.member_of_member (n i : Set)
  requires member : i ∈ n
  shows i ∈ succ(n)
proof
  rw bootstrap.succ.membership
  left
  exact member

-- Below n, a permutation of succ(n) fixing n stays below n.
defgraph restrictFixed (n σ : Set) (i ∈ n) : n := σ(i)
requires permutation : σ ∈ permutations(succ(n))
requires fixed : σ(n) = n
proof
  have function := permutations.function with permutation
  have bijective := permutations.bijective with permutation
  have injective := Bijective.injective with bijective
  have inSucc := succ.member_of_member at n, i with member
  have self := bootstrap.succ.self at n
  have image := FunctionBetween.apply_closed with function, inSucc
  have split := bootstrap.succ.membership at σ(i), n
  have alternatives := split.forward with image
  cases alternatives with inside | top
  . exact inside
  . exfalso
    have relatesI := FunctionBetween.relates_apply at σ, succ(n), succ(n), i
      with function, inSucc
    have relatesN := FunctionBetween.relates_apply at σ, succ(n), succ(n), n
      with function, self
    rw top at relatesI
    rw fixed at relatesN
    have equal := Injective.cancel at σ, succ(n), succ(n), i, n, n with
      injective, inSucc, self, self, relatesI, relatesN
    rw equal at member
    exact membership.irreflexive at n with member

theorem restrictFixed.apply (n σ i : Set)
  requires permutation : σ ∈ permutations(succ(n))
  requires fixed : σ(n) = n
  requires member : i ∈ n
  shows restrictFixed(n, σ)(i) = σ(i)
proof
  exact restrictFixed.value at n, σ, i with permutation, fixed, member

theorem restrictFixed.permutation (n σ : Set)
  requires permutation : σ ∈ permutations(succ(n))
  requires fixed : σ(n) = n
  shows restrictFixed(n, σ) ∈ permutations(n)
proof
  have function := restrictFixed.function at n, σ with permutation, fixed
  have sigmaFunction := permutations.function with permutation
  have bijective := permutations.bijective with permutation
  have injective := Bijective.injective with bijective
  have surjective := Bijective.surjective with bijective
  have self := bootstrap.succ.self at n
  have cancel : ∀ x ∈ n, ∀ y ∈ n,
      restrictFixed(n, σ)(x) = restrictFixed(n, σ)(y) → x = y
    intros x hx y hy equal
    have xIn := succ.member_of_member at n, x with hx
    have yIn := succ.member_of_member at n, y with hy
    have valueX := restrictFixed.apply at n, σ, x with permutation, fixed, hx
    have valueY := restrictFixed.apply at n, σ, y with permutation, fixed, hy
    rw [valueX, valueY] at equal
    have imageY := FunctionBetween.apply_closed with sigmaFunction, yIn
    have relatesX := FunctionBetween.relates_apply at σ, succ(n), succ(n), x
      with sigmaFunction, xIn
    have relatesY := FunctionBetween.relates_apply at σ, succ(n), succ(n), y
      with sigmaFunction, yIn
    rw equal at relatesX
    exact Injective.cancel at σ, succ(n), succ(n), x, y, σ(y) with injective,
      xIn, yIn, imageY, relatesX, relatesY
  have injectiveR := Injective.of_pointwise at restrictFixed(n, σ), n, n with
    function, cancel
  have surjectiveR : SurjectiveBetween(restrictFixed(n, σ), n, n)
    unfold SurjectiveBetween
    refine ⟨function, ?_⟩
    intros j hj
    have jIn := succ.member_of_member at n, j with hj
    unfold SurjectiveBetween at surjective
    obtain ⟨i, hi, edge⟩ := surjective.right with j, jIn
    have value := FunctionBetween.apply_value at σ, succ(n), succ(n), i, j
      with sigmaFunction, hi, edge
    have split := bootstrap.succ.membership at i, n
    have alternatives := split.forward with hi
    cases alternatives with inside | top
    . have restricted := restrictFixed.apply at n, σ, i with permutation,
        fixed, inside
      have edgeR := FunctionBetween.relates_apply at restrictFixed(n, σ), n,
        n, i with function, inside
      rw [restricted, value] at edgeR
      refine ⟨i, inside, edgeR⟩
    . exfalso
      rw [top, fixed] at value
      rw ← value at hj
      exact membership.irreflexive at n with hj
  have bijectiveR : BijectiveBetween(restrictFixed(n, σ), n, n)
    unfold BijectiveBetween
    refine ⟨injectiveR, surjectiveR⟩
  exact permutations.of_bijective with bijectiveR

theorem extendFixed.permutation (n p : Set)
  requires permutation : p ∈ permutations(n)
  shows extendFixed(n, p) ∈ permutations(succ(n))
proof
  have function := extendFixed.function at n, p with permutation
  have pFunction := permutations.function with permutation
  have pBijective := permutations.bijective with permutation
  have pInjective := Bijective.injective with pBijective
  have pSurjective := Bijective.surjective with pBijective
  have self := bootstrap.succ.self at n
  have top := extendFixed.top at n, p with permutation
  have cancel : ∀ x ∈ succ(n), ∀ y ∈ succ(n),
      extendFixed(n, p)(x) = extendFixed(n, p)(y) → x = y
    intros x hx y hy equal
    have splitX := bootstrap.succ.membership at x, n
    have splitY := bootstrap.succ.membership at y, n
    have casesX := splitX.forward with hx
    have casesY := splitY.forward with hy
    cases casesX with xInside | xTop
    . have lowX := extendFixed.low at n, p, x with permutation, xInside
      have imageX := FunctionBetween.apply_closed with pFunction, xInside
      cases casesY with yInside | yTop
      . have lowY := extendFixed.low at n, p, y with permutation, yInside
        rw [lowX, lowY] at equal
        have imageY := FunctionBetween.apply_closed with pFunction, yInside
        have relatesX := FunctionBetween.relates_apply at p, n, n, x with
          pFunction, xInside
        have relatesY := FunctionBetween.relates_apply at p, n, n, y with
          pFunction, yInside
        rw equal at relatesX
        exact Injective.cancel at p, n, n, x, y, p(y) with pInjective,
          xInside, yInside, imageY, relatesX, relatesY
      . exfalso
        rw [lowX, yTop, top] at equal
        rw equal at imageX
        exact membership.irreflexive at n with imageX
    . cases casesY with yInside | yTop
      . exfalso
        have lowY := extendFixed.low at n, p, y with permutation, yInside
        have imageY := FunctionBetween.apply_closed with pFunction, yInside
        rw [lowY, xTop, top] at equal
        rw ← equal at imageY
        exact membership.irreflexive at n with imageY
      . rw [xTop, yTop]
        rfl
  have injectiveE := Injective.of_pointwise at extendFixed(n, p), succ(n),
    succ(n) with function, cancel
  have surjectiveE : SurjectiveBetween(extendFixed(n, p), succ(n), succ(n))
    unfold SurjectiveBetween
    refine ⟨function, ?_⟩
    intros j hj
    have split := bootstrap.succ.membership at j, n
    have alternatives := split.forward with hj
    cases alternatives with inside | jTop
    . unfold SurjectiveBetween at pSurjective
      obtain ⟨i, hi, edge⟩ := pSurjective.right with j, inside
      have value := FunctionBetween.apply_value at p, n, n, i, j with
        pFunction, hi, edge
      have iIn := succ.member_of_member at n, i with hi
      have low := extendFixed.low at n, p, i with permutation, hi
      have edgeE := FunctionBetween.relates_apply at extendFixed(n, p),
        succ(n), succ(n), i with function, iIn
      rw [low, value] at edgeE
      refine ⟨i, iIn, edgeE⟩
    . have edgeE := FunctionBetween.relates_apply at extendFixed(n, p),
        succ(n), succ(n), n with function, self
      rw top at edgeE
      rw jTop
      refine ⟨n, self, edgeE⟩
  have bijectiveE : BijectiveBetween(extendFixed(n, p), succ(n), succ(n))
    unfold BijectiveBetween
    refine ⟨injectiveE, surjectiveE⟩
  exact permutations.of_bijective with bijectiveE

-- The permutations of succ(n) fixing n.
def fixingTop (n : Set) : Set := {σ ∈ permutations(succ(n)) | σ(n) = n}

defgraph extendFixedMap (n : Set) (p ∈ permutations(n)) : fixingTop(n) :=
  extendFixed(n, p)
proof
  have extended := extendFixed.permutation at n, p with member
  have top := extendFixed.top at n, p with member
  rw fixingTop.membership
  refine ⟨extended, top⟩

defgraph restrictFixedMap (n : Set) (σ ∈ fixingTop(n)) : permutations(n) :=
  restrictFixed(n, σ)
proof
  have data : σ ∈ fixingTop(n) := member
  rw fixingTop.membership at data
  exact restrictFixed.permutation at n, σ with data.left, data.right

theorem extendFixedMap.bijective (n : Set)
  shows BijectiveBetween(extendFixedMap(n), permutations(n), fixingTop(n))
proof
  have function := extendFixedMap.function at n
  have inverse := restrictFixedMap.function at n
  have self := bootstrap.succ.self at n
  have leftLaw : ∀ p ∈ permutations(n),
      restrictFixedMap(n)(extendFixedMap(n)(p)) = p
    intros p hp
    have extendedIn := FunctionBetween.apply_closed with function, hp
    have extended := extendFixedMap.value at n, p with hp
    have restricted := restrictFixedMap.value at n, extendFixedMap(n)(p) with
      extendedIn
    rw extended at extendedIn
    rw fixingTop.membership at extendedIn
    have permutation := extendedIn.left
    have fixed := extendedIn.right
    have restrictedFunction := restrictFixed.function at n,
      extendFixed(n, p) with permutation, fixed
    have pFunction := permutations.function with hp
    have same : ∀ i ∈ n, restrictFixed(n, extendFixed(n, p))(i) = p(i)
      intros i hi
      have applied := restrictFixed.apply at n, extendFixed(n, p), i with
        permutation, fixed, hi
      have low := extendFixed.low at n, p, i with hp, hi
      rw [applied, low]
      rfl
    have equal := FunctionBetween.ext at restrictFixed(n, extendFixed(n, p)),
      p, n, n with restrictedFunction, pFunction, same
    rw [restricted, extended, equal]
    rfl
  have rightLaw : ∀ σ ∈ fixingTop(n),
      extendFixedMap(n)(restrictFixedMap(n)(σ)) = σ
    intros σ hσ
    have restrictedIn := FunctionBetween.apply_closed with inverse, hσ
    have restricted := restrictFixedMap.value at n, σ with hσ
    have extended := extendFixedMap.value at n, restrictFixedMap(n)(σ) with
      restrictedIn
    rw restricted at restrictedIn
    have data := hσ
    rw fixingTop.membership at data
    have permutation := data.left
    have fixed := data.right
    have sigmaFunction := permutations.function with permutation
    have extendedFunction := extendFixed.function at n,
      restrictFixed(n, σ) with restrictedIn
    have same : ∀ i ∈ succ(n),
        extendFixed(n, restrictFixed(n, σ))(i) = σ(i)
      intros i hi
      have split := bootstrap.succ.membership at i, n
      have alternatives := split.forward with hi
      cases alternatives with inside | top
      . have low := extendFixed.low at n, restrictFixed(n, σ), i with
          restrictedIn, inside
        have applied := restrictFixed.apply at n, σ, i with permutation,
          fixed, inside
        rw [low, applied]
        rfl
      . have topValue := extendFixed.top at n, restrictFixed(n, σ) with
          restrictedIn
        rw [top, topValue, fixed]
        rfl
    have equal := FunctionBetween.ext at extendFixed(n, restrictFixed(n, σ)),
      σ, succ(n), succ(n) with extendedFunction, sigmaFunction, same
    rw [extended, restricted, equal]
    rfl
  exact Bijective.of_two_sided_inverse at extendFixedMap(n),
    restrictFixedMap(n), permutations(n), fixingTop(n) with function, inverse,
    leftLaw, rightLaw

-- A natural below n is not above n.
theorem natural.not_member_of_member (n x : Nat)
  requires member : x ∈ n
  shows ¬(n ∈ x)
proof
  intro back
  have belowRule := Less.of_membership at x, n with *
  have below := belowRule with member
  have aboveRule := Less.of_membership at n, x with *
  have above := aboveRule with back
  exact Less.asymmetric with below, above

-- The extension has the same inversions as p.
theorem extendFixed.inversions (n : Nat) (p : Set)
  requires permutation : p ∈ permutations(n)
  shows inversions(succ(n), extendFixed(n, p)) = inversions(n, p)
proof
  have succNat : Nat(succ(n)) by typecheck
  have positions := natural.member at n
  have positionsSucc := natural.member at succ(n)
  have pFunction := permutations.function with permutation
  have top := extendFixed.top at n, p with permutation
  ext q
  constructor
  . intro member
    obtain ⟨bound, i, hi, j, hj, shape, before, reversed⟩ :=
      inversions.membership.forward with member
    have iNat := positionsSucc with i, hi
    have jNat := positionsSucc with j, hj
    have splitJ := bootstrap.succ.membership at j, n
    have casesJ := splitJ.forward with hj
    have jInside : j ∈ n
      cases casesJ with inside | jTop
      . exact inside
      . exfalso
        rw jTop at before
        have low := extendFixed.low at n, p, i with permutation, before
        have image := FunctionBetween.apply_closed with pFunction, before
        have imageNat := positions with p(i), image
        rw [jTop, top, low] at reversed
        exact natural.not_member_of_member at n, p(i) with image, reversed
    have iInside : i ∈ n
      have orderRule := Less.of_membership at i, j with *
      have order := orderRule with before
      have jRule := Less.of_membership at j, n with *
      have jBelow := jRule with jInside
      have iBelow : i < n by arith
      have memberRule := membership.of_Less at i, n with *
      exact memberRule with iBelow
    have lowI := extendFixed.low at n, p, i with permutation, iInside
    have lowJ := extendFixed.low at n, p, j with permutation, jInside
    rw [lowI, lowJ] at reversed
    rw shape
    rw inversions.pair
    refine ⟨iInside, jInside, before, reversed⟩
  . intro member
    obtain ⟨bound, i, hi, j, hj, shape, before, reversed⟩ :=
      inversions.membership.forward with member
    have iIn := succ.member_of_member at n, i with hi
    have jIn := succ.member_of_member at n, j with hj
    have lowI := extendFixed.low at n, p, i with permutation, hi
    have lowJ := extendFixed.low at n, p, j with permutation, hj
    rw shape
    rw inversions.pair
    rw [lowI, lowJ]
    refine ⟨iIn, jIn, before, reversed⟩

theorem succ.difference_top (n : Set)
  shows succ(n) ∖ {n} = n
proof
  ext x
  rw [difference.membership, singleton.membership, bootstrap.succ.membership]
  constructor
  . intro data
    obtain ⟨inSucc, notTop⟩ := data
    cases inSucc with inside | top
    . exact inside
    . exfalso
      exact notTop with top
  . intro inside
    have notTop : ¬(x = n)
      intro top
      rw top at inside
      exact membership.irreflexive at n with inside
    have inSucc : x ∈ n ∨ x = n
      left
      exact inside
    refine ⟨inSucc, notTop⟩

section Border
variable (A add zero neg mul one : Set)
notation ring R := (A, add, zero, neg, mul, one)
hypothesis ring : IsCommRing(R)

theorem determinant.border (n : Nat) (M S : Set)
  requires matrixM : RingMatrix(succ(n), R, M)
  requires matrixS : RingMatrix(n, R, S)
  requires column : ∀ i ∈ n, M[i, n] = R[0]
  requires entries : ∀ i ∈ n, ∀ j ∈ n, M[i, j] = S[i, j]
  shows determinant(succ(n), R, M) = R[M[n, n] * determinant(n, R, S)]
proof
  have succNat : Nat(succ(n)) by typecheck
  have finite := Finite.natural at n
  have finiteSucc := Finite.natural at succ(n)
  have permsFinite := permutations.finite at n with finite
  have permsSuccFinite := permutations.finite at succ(n) with finiteSucc
  have self := bootstrap.succ.self at n
  have belowSucc : n ⊆ succ(n)
    unfold Subset
    intros i hi
    exact succ.member_of_member at n, i with hi
  have termsM := determinantTerms.function at succ(n), A, add, zero, neg, mul,
    one, M with ring, finiteSucc, matrixM
  have termsS := determinantTerms.function at n, A, add, zero, neg, mul, one,
    S with ring, finite, matrixS
  have cornerIn := RingMatrix.entry at succ(n), A, M, n, n with matrixM, self,
    self
  have subset : fixingTop(n) ⊆ permutations(succ(n))
    unfold Subset
    intros σ member
    rw fixingTop.membership at member
    exact member.left
  have vanishes : ∀ σ ∈ permutations(succ(n)), ¬(σ ∈ fixingTop(n)) →
      determinantTerms(succ(n), R, M)(σ) = R[0]
    intros σ hσ absent
    have notFixed : σ(n) ≠ n
      intro fixed
      apply absent
      rw fixingTop.membership
      refine ⟨hσ, fixed⟩
    have bijective := permutations.bijective with hσ
    have function := permutations.function with hσ
    have surjective := Bijective.surjective with bijective
    unfold SurjectiveBetween at surjective
    obtain ⟨i, hi, edge⟩ := surjective.right with n, self
    have value := FunctionBetween.apply_value at σ, succ(n), succ(n), i, n
      with function, hi, edge
    have iBelow : i ∈ n
      have split := bootstrap.succ.membership at i, n
      have alternatives := split.forward with hi
      cases alternatives with inside | top
      . exact inside
      . exfalso
        rw top at value
        exact notFixed with value
    have entry := column with i, iBelow
    have weights := permutationEntries.function at succ(n), A, M, σ with
      matrixM, bijective
    have entryValue := permutationEntries.value at succ(n), A, M, σ, i with
      matrixM, bijective, hi
    have zeroEntry : permutationEntries(succ(n), A, M, σ)(i) = R[0]
      rw [entryValue, value]
      exact entry
    have product := finiteRingProduct.zero_of_factor at succ(n), A, add, zero,
      neg, mul, one, permutationEntries(succ(n), A, M, σ), i with ring,
      finiteSucc, weights, hi, zeroEntry
    have sign := permutationSign.closed at A, add, zero, neg, mul, one,
      succ(n), σ with ring, finiteSucc
    have term := determinantTerms.value at succ(n), A, add, zero, neg, mul,
      one, M, σ with ring, finiteSucc, matrixM, hσ
    rw [term, product]
    ring
  have restricted := finiteRingSum.restrict at permutations(succ(n)),
    fixingTop(n), A, add, zero, neg, mul, one, determinantTerms(succ(n), R, M)
    with ring, permsSuccFinite, termsM, subset, vanishes
  have restrictedWeights := restrict.domain_function at
    determinantTerms(succ(n), R, M), permutations(succ(n)), A, fixingTop(n)
    with termsM, subset
  have bijective := extendFixedMap.bijective at n
  have mapFunction := extendFixedMap.function at n
  have composed := compose.function at
    restrict(determinantTerms(succ(n), R, M), fixingTop(n)),
    extendFixedMap(n), permutations(n), fixingTop(n), A with mapFunction,
    restrictedWeights
  have values : ∀ p ∈ permutations(n),
      compose(restrict(determinantTerms(succ(n), R, M), fixingTop(n)),
        extendFixedMap(n), permutations(n), fixingTop(n), A)(p) =
      restrict(determinantTerms(succ(n), R, M),
        fixingTop(n))(extendFixedMap(n)(p))
    intros p hp
    exact compose.apply at
      restrict(determinantTerms(succ(n), R, M), fixingTop(n)),
      extendFixedMap(n), permutations(n), fixingTop(n), A, p with mapFunction,
      restrictedWeights, hp
  have reindexed := finiteRingSum.reindex at permutations(n), fixingTop(n), A,
    add, zero, neg, mul, one,
    compose(restrict(determinantTerms(succ(n), R, M), fixingTop(n)),
      extendFixedMap(n), permutations(n), fixingTop(n), A),
    restrict(determinantTerms(succ(n), R, M), fixingTop(n)), extendFixedMap(n)
    with ring, permsFinite, composed, restrictedWeights, bijective, values
  have scaled : ∀ p ∈ permutations(n),
      compose(restrict(determinantTerms(succ(n), R, M), fixingTop(n)),
        extendFixedMap(n), permutations(n), fixingTop(n), A)(p) =
      R[M[n, n] * determinantTerms(n, R, S)(p)]
    intros p hp
    have composedValue := values with p, hp
    have extendedIn := FunctionBetween.apply_closed with mapFunction, hp
    have extended := extendFixedMap.value at n, p with hp
    rw extended at extendedIn
    have restrictedValue := restrict.domain_apply at
      determinantTerms(succ(n), R, M), permutations(succ(n)), A, fixingTop(n),
      extendFixed(n, p) with termsM, subset, extendedIn
    have data := extendedIn
    rw fixingTop.membership at data
    have extendedPermutation := data.left
    have extendedBijective := permutations.bijective with extendedPermutation
    have pBijective := permutations.bijective with hp
    have pFunction := permutations.function with hp
    have termM := determinantTerms.value at succ(n), A, add, zero, neg, mul,
      one, M, extendFixed(n, p) with ring, finiteSucc, matrixM,
      extendedPermutation
    have termS := determinantTerms.value at n, A, add, zero, neg, mul, one, S,
      p with ring, finite, matrixS, hp
    have sameInversions := extendFixed.inversions at n, p with hp
    have sameSign : permutationSign(succ(n), R, extendFixed(n, p)) =
        permutationSign(n, R, p)
      unfold permutationSign
      rw sameInversions
      rfl
    have weightsM := permutationEntries.function at succ(n), A, M,
      extendFixed(n, p) with matrixM, extendedBijective
    have weightsS := permutationEntries.function at n, A, S, p with matrixS,
      pBijective
    have removed := finiteRingProduct.remove at succ(n), A, add, zero, neg,
      mul, one, permutationEntries(succ(n), A, M, extendFixed(n, p)), n with
      ring, finiteSucc, weightsM, self
    have difference := succ.difference_top at n
    rw difference at removed
    have corner := permutationEntries.value at succ(n), A, M,
      extendFixed(n, p), n with matrixM, extendedBijective, self
    have top := extendFixed.top at n, p with hp
    rw top at corner
    have restrictedEntries := restrict.domain_function at
      permutationEntries(succ(n), A, M, extendFixed(n, p)), succ(n), A, n with
      weightsM, belowSucc
    have sameEntries : ∀ i ∈ n,
        restrict(permutationEntries(succ(n), A, M, extendFixed(n, p)), n)(i) =
        permutationEntries(n, A, S, p)(i)
      intros i hi
      have iIn := succ.member_of_member at n, i with hi
      have restrictedEntry := restrict.domain_apply at
        permutationEntries(succ(n), A, M, extendFixed(n, p)), succ(n), A, n, i
        with weightsM, belowSucc, hi
      have entryM := permutationEntries.value at succ(n), A, M,
        extendFixed(n, p), i with matrixM, extendedBijective, iIn
      have entryS := permutationEntries.value at n, A, S, p, i with matrixS,
        pBijective, hi
      have low := extendFixed.low at n, p, i with hp, hi
      have image := FunctionBetween.apply_closed with pFunction, hi
      have same := entries with i, hi, p(i), image
      rw [restrictedEntry, entryM, entryS, low, same]
      rfl
    have sameProducts := finiteRingProduct.congr at n, A, add, zero, neg, mul,
      one, restrict(permutationEntries(succ(n), A, M, extendFixed(n, p)), n),
      permutationEntries(n, A, S, p) with ring, finite, restrictedEntries,
      weightsS, sameEntries
    have signIn := permutationSign.closed at A, add, zero, neg, mul, one, n, p
      with ring, finite
    have productIn := finiteRingProduct.closed at n, A, add, zero, neg, mul,
      one, permutationEntries(n, A, S, p) with ring, finite, weightsS
    rw [composedValue, extended, restrictedValue, termM, termS, sameSign,
      removed, corner, sameProducts]
    ring
  have factored := finiteRingSum.scale_eq at permutations(n), A, add, zero,
    neg, mul, one, determinantTerms(n, R, S),
    compose(restrict(determinantTerms(succ(n), R, M), fixingTop(n)),
      extendFixedMap(n), permutations(n), fixingTop(n), A), M[n, n] with ring,
    permsFinite, termsS, composed, cornerIn, scaled
  unfold determinant
  rw [restricted, ← reindexed, factored]
  rfl

end Border

-- The coefficients of the affine product (X − r)·p with a carry: the
-- constant coefficient is carry − r·c₀ and the coefficient of X^(k+1)
-- is c_k − r·c_(k+1), with the leading coefficient read as c_m.
section Coefficients
variable (A add zero neg mul one : Set)
notation ring R := (A, add, zero, neg, mul, one)
hypothesis ring : IsCommRing(R)

theorem hornerCoefficient.cons_zero (a c : Set) (tail : List(A))
  requires initial : a ∈ R
  requires coefficient : c ∈ R
  shows hornerCoefficient{A}(zero, a, c :: tail, (0:N)) = c
proof
  have consList : List(A, c :: tail) by typecheck
  have positive : 0 < length{A}(c :: tail)
    rw length.cons
    arith
  have below := hornerCoefficient.below at A, zero, a, c :: tail, (0 : Nat)
    with *
  have head := listCoefficient.head at A, zero, c :: tail with consList
  have headValue := listHeadOr.cons at A, zero, c, tail with *
  rw [below, head, headValue]
  rfl

theorem hornerCoefficient.cons_succ (a c : Set) (tail : List(A)) (k : Nat)
  requires initial : a ∈ R
  requires coefficient : c ∈ R
  shows hornerCoefficient{A}(zero, a, c :: tail, succ(k)) =
    hornerCoefficient{A}(zero, a, tail, k)
proof
  have single : List(A, a :: []) by typecheck
  have full := hornerFullList.list at A, a, tail with initial
  have consFull : hornerFullList{A}(a, c :: tail) =
      c :: hornerFullList{A}(a, tail)
    unfold hornerFullList
    exact append.cons at A, c, tail, a :: [] with *
  have consList : List(A, c :: hornerFullList{A}(a, tail)) by typecheck
  have tailValue := listTail.cons at A, c, hornerFullList{A}(a, tail) with *
  have shifted := listCoefficient.tail at A, zero,
    c :: hornerFullList{A}(a, tail), k with *
  unfold hornerCoefficient
  rw [consFull, ← shifted, tailValue]
  rfl

theorem hornerCoefficient.member (a : Set) (cs : List(A)) (k : Nat)
  requires initial : a ∈ R
  shows hornerCoefficient{A}(zero, a, cs, k) ∈ R
proof
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have full := hornerFullList.list at A, a, cs with initial
  unfold hornerCoefficient
  exact listCoefficient.closed at A, zero, hornerFullList{A}(a, cs), k with *

theorem hornerAffineProduct.coefficient_zero (a r carry : Set) (cs : List(A))
  requires initial : a ∈ R
  requires center : r ∈ R
  requires carried : carry ∈ R
  shows hornerCoefficient{A}(zero, a,
      hornerAffineProduct{A}(add, mul, a, neg(r), one, carry, cs), (0:N)) =
    R[carry - r * hornerCoefficient{A}(zero, a, cs, (0:N))]
proof
  have ordinary := IsCommRing.ring with ring
  have negIn := IsRing.neg_closed with ordinary, center
  have shape := List.cases at A, cs with *
  cases shape with empty | cons
  . rw empty
    rw hornerAffineProduct
    have productIn := IsRing.mul_closed with ordinary, negIn, initial
    have headIn := IsRing.add_closed with ordinary, carried, productIn
    have emptyList : List(A, []) by typecheck
    have top := hornerCoefficient.cons_zero at A, add, zero, neg, mul, one, a,
      R[carry + -r * a], [] with ring, initial, headIn
    have leading := hornerCoefficient.leading at A, zero, a, [] with *
    rw length.nil at leading
    rw [top, leading]
    ring
  . obtain ⟨c, cIn, tail, tailList, equal⟩ := cons
    rw equal
    rw hornerAffineProduct
    have oneIn : R[1] ∈ R by typecheck
    have productIn := IsRing.mul_closed with ordinary, negIn, cIn
    have headIn := IsRing.add_closed with ordinary, carried, productIn
    have carryIn := IsRing.mul_closed with ordinary, oneIn, cIn
    have data := hornerAffineProduct.data at A, add, zero, neg, mul, one, a,
      neg(r), one, R[1 * c], tail with *
    have restList := data.left
    have top := hornerCoefficient.cons_zero at A, add, zero, neg, mul, one, a,
      R[carry + -r * c],
      hornerAffineProduct{A}(add, mul, a, neg(r), one, R[1 * c], tail) with
      ring, initial, headIn
    have first := hornerCoefficient.cons_zero at A, add, zero, neg, mul, one,
      a, c, tail with ring, initial, cIn
    rw [top, first]
    ring

theorem hornerAffineProduct.coefficient_succ (a r carry : Set) (cs : List(A))
  (k : Nat)
  requires initial : a ∈ R
  requires center : r ∈ R
  requires carried : carry ∈ R
  shows hornerCoefficient{A}(zero, a,
      hornerAffineProduct{A}(add, mul, a, neg(r), one, carry, cs), succ(k)) =
    R[hornerCoefficient{A}(zero, a, cs, k) -
      r * hornerCoefficient{A}(zero, a, cs, succ(k))]
proof
  induction cs generalizing carry k
  | List.nil =>
    intros carry k kNat carried
    have ordinary := IsCommRing.ring with ring
    have negIn := IsRing.neg_closed with ordinary, center
    rw hornerAffineProduct
    have productIn := IsRing.mul_closed with ordinary, negIn, initial
    have headIn := IsRing.add_closed with ordinary, carried, productIn
    have single : List(A, R[carry + -r * a] :: []) by typecheck
    have emptyList : List(A, []) by typecheck
    have singleLength : length{A}(R[carry + -r * a] :: []) = (1:N)
      rw [length.cons, length.nil]
      rfl
    have shape := natural.zero_or_successor at k with *
    cases shape with isZero | successor
    . rw isZero
      have top := hornerCoefficient.leading at A, zero, a,
        R[carry + -r * a] :: [] with *
      rw singleLength at top
      have base := hornerCoefficient.leading at A, zero, a, [] with *
      rw length.nil at base
      have bound : length{A}([]) < (1:N)
        rw length.nil
        arith
      have above := hornerCoefficient.above at A, zero, a, [], (1:N) with *
      rw [top, base, above]
      ring
    . obtain ⟨j, jNat, equal⟩ := successor
      rw equal
      have bound1 : length{A}(R[carry + -r * a] :: []) < succ(succ(j))
        rw singleLength
        arith
      have bound2 : length{A}([]) < succ(j)
        rw length.nil
        arith
      have bound3 : length{A}([]) < succ(succ(j))
        rw length.nil
        arith
      have above1 := hornerCoefficient.above at A, zero, a,
        R[carry + -r * a] :: [], succ(succ(j)) with *
      have above2 := hornerCoefficient.above at A, zero, a, [], succ(j) with *
      have above3 := hornerCoefficient.above at A, zero, a, [], succ(succ(j))
        with *
      rw [above1, above2, above3]
      ring
  | List.cons(c, tail) using ih =>
    intros carry k kNat carried
    have ordinary := IsCommRing.ring with ring
    have negIn := IsRing.neg_closed with ordinary, center
    have cIn : c ∈ R by assumption
    have tailList : List(A, tail) by assumption
    rw hornerAffineProduct
    have oneIn : R[1] ∈ R by typecheck
    have productIn := IsRing.mul_closed with ordinary, negIn, cIn
    have headIn := IsRing.add_closed with ordinary, carried, productIn
    have carryIn := IsRing.mul_closed with ordinary, oneIn, cIn
    have data := hornerAffineProduct.data at A, add, zero, neg, mul, one, a,
      neg(r), one, R[1 * c], tail with *
    have restList := data.left
    have step := hornerCoefficient.cons_succ at A, add, zero, neg, mul, one, a,
      R[carry + -r * c],
      hornerAffineProduct{A}(add, mul, a, neg(r), one, R[1 * c], tail), k with
      ring, initial, headIn
    rw step
    have shape := natural.zero_or_successor at k with *
    cases shape with isZero | successor
    . rw isZero
      have first := hornerAffineProduct.coefficient_zero at A, add, zero, neg,
        mul, one, a, r, R[1 * c], tail with ring, initial, center, carryIn
      have head := hornerCoefficient.cons_zero at A, add, zero, neg, mul, one,
        a, c, tail with ring, initial, cIn
      have next := hornerCoefficient.cons_succ at A, add, zero, neg, mul, one,
        a, c, tail, (0 : Nat) with ring, initial, cIn
      have zeroIn := IsRing.zero_in_carrier with ordinary
      have full := hornerFullList.list at A, a, tail with initial
      have coefficientIn := hornerCoefficient.member at A, add, zero, neg, mul,
        one, a, tail, (0 : Nat) with ring, initial
      have headOrIn := listHeadOr.mem_carrier at A, zero,
        hornerFullList{A}(a, tail) with zeroIn
      rw [first, head, next]
      ring
    . obtain ⟨j, jNat, equal⟩ := successor
      rw equal
      have inner := ih with carryIn, jNat
      have next1 := hornerCoefficient.cons_succ at A, add, zero, neg, mul, one,
        a, c, tail, j with ring, initial, cIn
      have next2 := hornerCoefficient.cons_succ at A, add, zero, neg, mul, one,
        a, c, tail, succ(j) with ring, initial, cIn
      have coefficientJ := hornerCoefficient.member at A, add, zero, neg, mul,
        one, a, tail, j with ring, initial
      have coefficientSuccJ := hornerCoefficient.member at A, add, zero, neg,
        mul, one, a, tail, succ(j) with ring, initial
      rw [inner, next1, next2]
      ring

-- The coefficients of a list padded below by m zeros.
theorem hornerCoefficient.pad_shift (b : Set) (ds : List(A)) (m u : Nat)
  requires initial : b ∈ R
  shows hornerCoefficient{A}(zero, b, append{A}(ds, listReplicate(m, zero)),
      m + u) =
    hornerCoefficient{A}(zero, b, ds, u)
proof
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have zeros := listReplicate.closed at A, zero, m with *
  have zerosLength := listReplicate.length at A, zero, m with *
  have single : List(A, b :: []) by typecheck
  have full := hornerFullList.list at A, b, ds with initial
  have assoc := append.associative at A, b :: [], ds, listReplicate(m, zero)
    with *
  have fullShape : hornerFullList{A}(b, append{A}(ds, listReplicate(m, zero)))
      = append{A}(hornerFullList{A}(b, ds), listReplicate(m, zero))
    unfold hornerFullList
    exact assoc
  have commuted : m + u = u + m by arith
  have right := listCoefficient.append_right at A, zero,
    listReplicate(m, zero), hornerFullList{A}(b, ds), u with *
  rw zerosLength at right
  unfold hornerCoefficient
  rw [fullShape, commuted]
  exact right

theorem hornerCoefficient.pad_below (b : Set) (ds : List(A)) (m k : Nat)
  requires initial : b ∈ R
  requires bound : k < m
  shows hornerCoefficient{A}(zero, b, append{A}(ds, listReplicate(m, zero)),
    k) = zero
proof
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have zeros := listReplicate.closed at A, zero, m with *
  have zerosLength := listReplicate.length at A, zero, m with *
  have appended : List(A, append{A}(ds, listReplicate(m, zero))) by typecheck
  have total := length.append at A, ds, listReplicate(m, zero) with *
  have inside : k < length{A}(append{A}(ds, listReplicate(m, zero)))
    rw [total, zerosLength]
    arith
  have below := hornerCoefficient.below at A, zero, b,
    append{A}(ds, listReplicate(m, zero)), k with *
  have inZeros : k < length{A}(listReplicate(m, zero))
    rw zerosLength
    exact bound
  have left := listCoefficient.append_left at A, zero, listReplicate(m, zero),
    ds, k with *
  have entry := listReplicate.coefficient at A, zero, zero, m, k with *
  rw [below, left, entry]
  rfl

end Coefficients

section Rings
variable (A add zero neg mul one a b : Set)
notation ring R := (A, add, zero, neg, mul, one)
hypothesis ring : IsCommRing(R)
hypothesis left : a ∈ R
hypothesis right : b ∈ R

-- The Sylvester rows of (X − r)·p against those of p: entry 0 agrees, and
-- entry t + 1 of the product row is entry t + 1 minus r times entry t of
-- the row of p.
theorem sylvesterRow.affine_zero (r : Set) (cs : List(A)) (i : Nat)
  requires center : r ∈ R
  shows listCoefficient{A}(zero, sylvesterRow{A}(zero, a,
      hornerAffineProduct{A}(add, mul, a, neg(r), one, zero, cs), i), (0:N)) =
    listCoefficient{A}(zero, sylvesterRow{A}(zero, a, cs, i), (0:N))
proof
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have negIn := IsRing.neg_closed with ordinary, center
  have data := hornerAffineProduct.data at A, add, zero, neg, mul, one, a,
    neg(r), one, zero, cs with *
  have esList := data.left
  have esLength := data.right
  have shape := natural.zero_or_successor at i with *
  cases shape with isZero | successor
  . rw isZero
    have lower : (0:N) ≤ (0:N) by arith
    have upperE : (0:N) ≤ (0:N) + length{A}(hornerAffineProduct{A}(add, mul,
      a, neg(r), one, zero, cs)) by arith
    have upperC : (0:N) ≤ (0:N) + length{A}(cs) by arith
    have entryE := sylvesterRow.coefficient at A, zero, a,
      hornerAffineProduct{A}(add, mul, a, neg(r), one, zero, cs), (0:N), (0:N)
      with zeroIn, left, lower, upperE
    have entryC := sylvesterRow.coefficient at A, zero, a, cs, (0:N), (0:N)
      with zeroIn, left, lower, upperC
    have indexE : sub(length{A}(hornerAffineProduct{A}(add, mul, a, neg(r),
        one, zero, cs)) + (0:N), (0:N)) =
        length{A}(hornerAffineProduct{A}(add, mul, a, neg(r), one, zero, cs))
      rw sub.zero_right
      arith
    have indexC : sub(length{A}(cs) + (0:N), (0:N)) = length{A}(cs)
      rw sub.zero_right
      arith
    have leadingE := hornerCoefficient.leading at A, zero, a,
      hornerAffineProduct{A}(add, mul, a, neg(r), one, zero, cs) with *
    have leadingC := hornerCoefficient.leading at A, zero, a, cs with *
    rw [entryE, entryC, indexE, indexC, leadingE, leadingC]
    rfl
  . obtain ⟨k, kNat, equal⟩ := successor
    rw equal
    have outside : (0:N) < succ(k) ∨ (succ(k) : Nat) + length{A}(cs) < (0:N)
      left
      arith
    have outsideE : (0:N) < succ(k) ∨
        (succ(k) : Nat) + length{A}(hornerAffineProduct{A}(add, mul, a, neg(r),
          one, zero, cs)) < (0:N)
      left
      arith
    have entryE := sylvesterRow.coefficient_outside at A, zero, a,
      hornerAffineProduct{A}(add, mul, a, neg(r), one, zero, cs), succ(k),
      (0:N) with zeroIn, left, outsideE
    have entryC := sylvesterRow.coefficient_outside at A, zero, a, cs, succ(k),
      (0:N) with zeroIn, left, outside
    rw [entryE, entryC]
    rfl

theorem sylvesterRow.affine_succ (r : Set) (cs : List(A)) (i t : Nat)
  requires center : r ∈ R
  shows listCoefficient{A}(zero, sylvesterRow{A}(zero, a,
      hornerAffineProduct{A}(add, mul, a, neg(r), one, zero, cs), i), succ(t)) =
    R[listCoefficient{A}(zero, sylvesterRow{A}(zero, a, cs, i), succ(t)) -
      r * listCoefficient{A}(zero, sylvesterRow{A}(zero, a, cs, i), t)]
proof
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have negIn := IsRing.neg_closed with ordinary, center
  have data := hornerAffineProduct.data at A, add, zero, neg, mul, one, a,
    neg(r), one, zero, cs with *
  have esList := data.left
  have esLength := data.right
  have rowC := sylvesterRow.list at A, zero, a, cs, i with *
  have entryIn := listCoefficient.closed at A, zero,
    sylvesterRow{A}(zero, a, cs, i), succ(t) with *
  have previousIn := listCoefficient.closed at A, zero,
    sylvesterRow{A}(zero, a, cs, i), t with *
  have first := Less.trichotomy at succ(t), i with *
  rcases first with before | same | after
  . have outsideE : succ(t) < i ∨ i + length{A}(hornerAffineProduct{A}(add,
        mul, a, neg(r), one, zero, cs)) < succ(t)
      left
      exact before
    have outsideC : succ(t) < i ∨ i + length{A}(cs) < succ(t)
      left
      exact before
    have outsideP : t < i ∨ i + length{A}(cs) < t
      left
      arith
    have entryE := sylvesterRow.coefficient_outside at A, zero, a,
      hornerAffineProduct{A}(add, mul, a, neg(r), one, zero, cs), i, succ(t)
      with zeroIn, left, outsideE
    have entryC := sylvesterRow.coefficient_outside at A, zero, a, cs, i,
      succ(t) with zeroIn, left, outsideC
    have entryP := sylvesterRow.coefficient_outside at A, zero, a, cs, i, t
      with zeroIn, left, outsideP
    rw [entryE, entryC, entryP]
    ring
  . rw ← same
    have lower : succ(t) ≤ succ(t) by arith
    have upperE : succ(t) ≤
      (succ(t) : Nat) + length{A}(hornerAffineProduct{A}(add, mul, a, neg(r),
        one, zero, cs)) by arith
    have upperC : succ(t) ≤ (succ(t) : Nat) + length{A}(cs) by arith
    have outsideP : t < succ(t) ∨ (succ(t) : Nat) + length{A}(cs) < t
      left
      arith
    have entryE := sylvesterRow.coefficient at A, zero, a,
      hornerAffineProduct{A}(add, mul, a, neg(r), one, zero, cs), succ(t),
      succ(t) with zeroIn, left, lower, upperE
    have entryC := sylvesterRow.coefficient at A, zero, a, cs, succ(t), succ(t)
      with zeroIn, left, lower, upperC
    have entryP := sylvesterRow.coefficient_outside at A, zero, a, cs, succ(t),
      t with zeroIn, left, outsideP
    have indexE : sub(length{A}(hornerAffineProduct{A}(add, mul, a, neg(r),
        one, zero, cs)) + (succ(t) : Nat), succ(t)) =
        length{A}(hornerAffineProduct{A}(add, mul, a, neg(r), one, zero, cs))
      exact sub.add_right at length{A}(hornerAffineProduct{A}(add, mul, a,
        neg(r), one, zero, cs)), succ(t)
    have indexC : sub(length{A}(cs) + (succ(t) : Nat), succ(t)) = length{A}(cs)
      exact sub.add_right at length{A}(cs), succ(t)
    have leadingE := hornerCoefficient.leading at A, zero, a,
      hornerAffineProduct{A}(add, mul, a, neg(r), one, zero, cs) with *
    have leadingC := hornerCoefficient.leading at A, zero, a, cs with *
    rw [entryE, entryC, entryP, indexE, indexC, leadingE, leadingC]
    ring
  . have second := Less.trichotomy at succ(t),
      i + (succ(length{A}(cs)) : Nat) with *
    rcases second with inside | last | beyond
    . have lowerBound : i ≤ succ(t) by arith
      have lowerP : i ≤ t by arith
      have upperBound : succ(t) ≤ i + length{A}(cs) by arith
      have upperP : t ≤ i + length{A}(cs) by arith
      have upperE : succ(t) ≤ i + length{A}(hornerAffineProduct{A}(add, mul,
          a, neg(r), one, zero, cs))
        rw esLength
        arith
      have atMost : succ(t) ≤ length{A}(cs) + i by arith
      obtain ⟨u, uNat, split⟩ := LessEqual.exists_add with atMost
      have shapeP : length{A}(cs) + i = t + (succ(u) : Nat) by arith
      have shapeE : length{A}(hornerAffineProduct{A}(add, mul, a, neg(r), one,
          zero, cs)) + i = (succ(t) : Nat) + (succ(u) : Nat)
        rw esLength
        arith
      have indexC : sub(length{A}(cs) + i, succ(t)) = u
        exact sub.of_add at length{A}(cs) + i, succ(t), u with split
      have indexP : sub(length{A}(cs) + i, t) = succ(u)
        exact sub.of_add at length{A}(cs) + i, t, succ(u) with shapeP
      have indexE : sub(length{A}(hornerAffineProduct{A}(add, mul, a, neg(r),
          one, zero, cs)) + i, succ(t)) = succ(u)
        exact sub.of_add at length{A}(hornerAffineProduct{A}(add, mul, a,
          neg(r), one, zero, cs)) + i, succ(t), succ(u) with shapeE
      have entryE := sylvesterRow.coefficient at A, zero, a,
        hornerAffineProduct{A}(add, mul, a, neg(r), one, zero, cs), i, succ(t)
        with zeroIn, left, lowerBound, upperE
      have entryC := sylvesterRow.coefficient at A, zero, a, cs, i, succ(t)
        with zeroIn, left, lowerBound, upperBound
      have entryP := sylvesterRow.coefficient at A, zero, a, cs, i, t with
        zeroIn, left, lowerP, upperP
      have affine := hornerAffineProduct.coefficient_succ at A, add, zero, neg,
        mul, one, a, r, zero, cs, u with ring, left, center, zeroIn
      have coefficientU := hornerCoefficient.member at A, add, zero, neg, mul,
        one, a, cs, u with ring, left
      have coefficientSuccU := hornerCoefficient.member at A, add, zero, neg,
        mul, one, a, cs, succ(u) with ring, left
      rw [entryE, entryC, entryP, indexE, indexC, indexP, affine]
      ring
  . have lowerBound : i ≤ succ(t) by arith
      have lowerP : i ≤ t by arith
      have upperE : succ(t) ≤ i + length{A}(hornerAffineProduct{A}(add, mul,
          a, neg(r), one, zero, cs))
        rw esLength
        arith
      have upperP : t ≤ i + length{A}(cs) by arith
      have outsideC : succ(t) < i ∨ i + length{A}(cs) < succ(t)
        right
        arith
      have shapeE : length{A}(hornerAffineProduct{A}(add, mul, a, neg(r), one,
          zero, cs)) + i = (succ(t) : Nat) + (0:N)
        rw esLength
        arith
      have shapeP : length{A}(cs) + i = t + (0:N) by arith
      have indexE : sub(length{A}(hornerAffineProduct{A}(add, mul, a, neg(r),
          one, zero, cs)) + i, succ(t)) = (0:N)
        exact sub.of_add at length{A}(hornerAffineProduct{A}(add, mul, a,
          neg(r), one, zero, cs)) + i, succ(t), (0:N) with shapeE
      have indexP : sub(length{A}(cs) + i, t) = (0:N)
        exact sub.of_add at length{A}(cs) + i, t, (0:N) with shapeP
      have entryE := sylvesterRow.coefficient at A, zero, a,
        hornerAffineProduct{A}(add, mul, a, neg(r), one, zero, cs), i, succ(t)
        with zeroIn, left, lowerBound, upperE
      have entryC := sylvesterRow.coefficient_outside at A, zero, a, cs, i,
        succ(t) with zeroIn, left, outsideC
      have entryP := sylvesterRow.coefficient at A, zero, a, cs, i, t with
        zeroIn, left, lowerP, upperP
      have affine := hornerAffineProduct.coefficient_zero at A, add, zero, neg,
        mul, one, a, r, zero, cs with ring, left, center, zeroIn
      have coefficientZero := hornerCoefficient.member at A, add, zero, neg,
        mul, one, a, cs, (0:N) with ring, left
      rw [entryE, entryC, entryP, indexE, indexP, affine]
      ring
    . have outsideE : succ(t) < i ∨ i + length{A}(hornerAffineProduct{A}(add,
          mul, a, neg(r), one, zero, cs)) < succ(t)
        right
        rw esLength
        exact beyond
      have outsideC : succ(t) < i ∨ i + length{A}(cs) < succ(t)
        right
        arith
      have outsideP : t < i ∨ i + length{A}(cs) < t
        right
        arith
      have entryE := sylvesterRow.coefficient_outside at A, zero, a,
        hornerAffineProduct{A}(add, mul, a, neg(r), one, zero, cs), i, succ(t)
        with zeroIn, left, outsideE
      have entryC := sylvesterRow.coefficient_outside at A, zero, a, cs, i,
        succ(t) with zeroIn, left, outsideC
      have entryP := sylvesterRow.coefficient_outside at A, zero, a, cs, i, t
        with zeroIn, left, outsideP
      rw [entryE, entryC, entryP]
      ring

-- Entry i + j + 1 of the i-th Sylvester row of q is the coefficient of
-- index m + n − (j + 1) of q padded below by m zeros.
theorem sylvesterRow.padded_coefficient (ds : List(A)) (m i j : Nat)
  requires bound : succ(j) ≤ m + length{A}(ds)
  shows listCoefficient{A}(zero, sylvesterRow{A}(zero, b, ds, i),
      i + (succ(j) : Nat)) =
    hornerCoefficient{A}(zero, b, append{A}(ds, listReplicate(m, zero)),
      sub(m + length{A}(ds), succ(j)))
proof
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have alternatives : succ(j) ≤ length{A}(ds) ∨
    ¬(succ(j) ≤ length{A}(ds)) by tauto
  cases alternatives with inside | outside
  . obtain ⟨u, uNat, split⟩ := LessEqual.exists_add with inside
    have lower : i ≤ i + (succ(j) : Nat) by arith
    have upper : i + (succ(j) : Nat) ≤ i + length{A}(ds) by arith
    have entry := sylvesterRow.coefficient at A, zero, b, ds, i,
      i + (succ(j) : Nat) with zeroIn, right, lower, upper
    have shape : length{A}(ds) + i = (i + (succ(j) : Nat)) + u by arith
    have shapePadded : m + length{A}(ds) = (succ(j) : Nat) + (m + u) by arith
    have index := sub.of_add at length{A}(ds) + i, i + (succ(j) : Nat), u
      with shape
    have indexPadded := sub.of_add at m + length{A}(ds), succ(j), m + u with
      shapePadded
    have shifted := hornerCoefficient.pad_shift at A, add, zero, neg, mul,
      one, b, ds, m, u with ring, right
    rw [entry, index, indexPadded, shifted]
    rfl
  . have above := Less.of_not_LessEqual with outside
    have atLeast : succ(length{A}(ds)) ≤ succ(j) by arith
    obtain ⟨w, wNat, splitW⟩ := LessEqual.exists_add with atLeast
    obtain ⟨v, vNat, splitV⟩ := LessEqual.exists_add with bound
    have outsideRow : i + (succ(j) : Nat) < i ∨
        i + length{A}(ds) < i + (succ(j) : Nat)
      right
      arith
    have entry := sylvesterRow.coefficient_outside at A, zero, b, ds, i,
      i + (succ(j) : Nat) with zeroIn, right, outsideRow
    have small : v < m by arith
    have indexPadded := sub.of_add at m + length{A}(ds), succ(j), v with splitV
    have padded := hornerCoefficient.pad_below at A, add, zero, neg, mul, one,
      b, ds, m, v with ring, right, small
    rw [entry, indexPadded, padded]
    rfl

end Rings

-- The Sylvester matrix of (X − r)·p and q after k column operations, each
-- adding r times a column to the next one: in the columns up to k the
-- rows of (X − r)·p have become the rows of p, and the rows of q the
-- partial Horner values of q at r (read from the list of q padded below
-- by m zeros); the later columns are untouched.
defgraph columnReduced (A add zero neg mul one a b r cs ds : Set, m n k : Nat)
  (p ∈ succ(m + n) × succ(m + n)) : A :=
  boolChoice(memberTest(succ(k), snd(p)),
    boolChoice(memberTest(n, fst(p)),
      listCoefficient{A}(zero, sylvesterRow{A}(zero, a, cs, fst(p)), snd(p)),
      boolChoice(memberTest(sub(fst(p), n), snd(p)), zero,
        linearValue{A}(add, mul, b, r, append{A}(ds, listReplicate(m, zero)),
          m + n, sub(snd(p), sub(fst(p), n))))),
    sylvesterBlockMatrix(A, zero, a, b,
      hornerAffineProduct{A}(add, mul, a, neg(r), one, zero, cs), ds, n,
      succ(m + n))(p))
requires ring : IsCommRing(A, add, zero, neg, mul, one)
requires left : a ∈ A
requires right : b ∈ A
requires center : r ∈ A
requires leftList : List(A, cs)
requires rightList : List(A, ds)
proof
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have negIn := IsRing.neg_closed with ordinary, center
  have esData := hornerAffineProduct.data at A, add, zero, neg, mul, one, a,
    neg(r), one, zero, cs with *
  have esList := esData.left
  have sumNat : Nat(succ(m + n)) by typecheck
  have matrix := sylvesterBlockMatrix.function at A, zero, a, b,
    hornerAffineProduct{A}(add, mul, a, neg(r), one, zero, cs), ds, n,
    succ(m + n) with *
  have original := FunctionBetween.apply_closed at
    sylvesterBlockMatrix(A, zero, a, b,
      hornerAffineProduct{A}(add, mul, a, neg(r), one, zero, cs), ds, n,
      succ(m + n)), succ(m + n) × succ(m + n), A, p with *
  obtain ⟨bound, i, hi, j, hj, shape⟩ := product.membership.forward
    at succ(m + n), succ(m + n), p with *
  have positions := natural.member at succ(m + n)
  have iNat := positions with i, hi
  have jNat := positions with j, hj
  have zeros := listReplicate.closed at A, zero, m with zeroIn
  have padded : List(A, append{A}(ds, listReplicate(m, zero))) by typecheck
  have dropped := listDrop.closed at A, append{A}(ds, listReplicate(m, zero)),
    sub(m + n, sub(j, sub(i, n)))
  have valueIn := hornerAt.closed at A, add, zero, neg, mul, one, b, r,
    listDrop{A}(sub(m + n, sub(j, sub(i, n))),
      append{A}(ds, listReplicate(m, zero))) with *
  have rowC := sylvesterRow.list at A, zero, a, cs, i with *
  have entryIn := listCoefficient.closed at A, zero,
    sylvesterRow{A}(zero, a, cs, i), j with *
  rw [shape, fst.pair, snd.pair]
  have columns : j ∈ succ(k) ∨ ¬(j ∈ succ(k)) by tauto
  cases columns with reduced | kept
  . have test := memberTest.true with reduced
    rw [test, boolChoice.true]
    have rows : i ∈ n ∨ ¬(i ∈ n) by tauto
    cases rows with upper | lower
    . have test2 := memberTest.true with upper
      rw [test2, boolChoice.true]
      exact entryIn
    . have test2 := memberTest.false with lower
      rw [test2, boolChoice.false]
      have below : j ∈ sub(i, n) ∨ ¬(j ∈ sub(i, n)) by tauto
      cases below with early | late
      . have test3 := memberTest.true with early
        rw [test3, boolChoice.true]
        exact zeroIn
      . have test3 := memberTest.false with late
        rw [test3, boolChoice.false]
        unfold linearValue
        exact valueIn
  . have test := memberTest.false with kept
    rw [test, boolChoice.false]
    rw shape at original
    exact original

theorem columnReduced.matrix (A add zero neg mul one a b r : Set)
  (cs ds : List(A)) (m n k : Nat)
  requires ring : IsCommRing(A, add, zero, neg, mul, one)
  requires left : a ∈ A
  requires right : b ∈ A
  requires center : r ∈ A
  shows RingMatrix(succ(m + n), A,
    columnReduced(A, add, zero, neg, mul, one, a, b, r, cs, ds, m, n, k))
proof
  unfold RingMatrix
  exact columnReduced.function with *

theorem columnReduced.entry (A add zero neg mul one a b r : Set)
  (cs ds : List(A)) (m n k i j : Nat)
  requires ring : IsCommRing(A, add, zero, neg, mul, one)
  requires left : a ∈ A
  requires right : b ∈ A
  requires center : r ∈ A
  requires row : i < succ(m + n)
  requires column : j < succ(m + n)
  shows columnReduced(A, add, zero, neg, mul, one, a, b, r, cs, ds, m, n,
      k)[i, j] =
    boolChoice(memberTest(succ(k), j),
      boolChoice(memberTest(n, i),
        listCoefficient{A}(zero, sylvesterRow{A}(zero, a, cs, i), j),
        boolChoice(memberTest(sub(i, n), j), zero,
          linearValue{A}(add, mul, b, r, append{A}(ds, listReplicate(m, zero)),
            m + n, sub(j, sub(i, n))))),
      sylvesterBlockMatrix(A, zero, a, b,
        hornerAffineProduct{A}(add, mul, a, neg(r), one, zero, cs), ds, n,
        succ(m + n))[i, j])
proof
  have sumNat : Nat(succ(m + n)) by typecheck
  have rowRule := membership.of_Less at i, succ(m + n) with *
  have rowMember := rowRule with row
  have columnRule := membership.of_Less at j, succ(m + n) with *
  have columnMember := columnRule with column
  have pair := product.pair at i, j, succ(m + n), succ(m + n) with rowMember,
    columnMember
  have value := columnReduced.value at A, add, zero, neg, mul, one, a, b, r,
    cs, ds, m, n, k, (i, j) with *
  rw [value, fst.pair, snd.pair]
  rfl

theorem columnReduced.upper (A add zero neg mul one a b r : Set)
  (cs ds : List(A)) (m n k i j : Nat)
  requires ring : IsCommRing(A, add, zero, neg, mul, one)
  requires left : a ∈ A
  requires right : b ∈ A
  requires center : r ∈ A
  requires upper : i < n
  requires row : i < succ(m + n)
  requires column : j < succ(m + n)
  requires reduced : j < succ(k)
  shows columnReduced(A, add, zero, neg, mul, one, a, b, r, cs, ds, m, n,
      k)[i, j] =
    listCoefficient{A}(zero, sylvesterRow{A}(zero, a, cs, i), j)
proof
  have entry := columnReduced.entry at A, add, zero, neg, mul, one, a, b, r,
    cs, ds, m, n, k, i, j with *
  have columnRule := membership.of_Less at j, succ(k) with *
  have columnMember := columnRule with reduced
  have rowRule := membership.of_Less at i, n with *
  have rowMember := rowRule with upper
  have test := memberTest.true with columnMember
  have test2 := memberTest.true with rowMember
  rw [entry, test, boolChoice.true, test2, boolChoice.true]
  rfl

theorem columnReduced.lower_zero (A add zero neg mul one a b r : Set)
  (cs ds : List(A)) (m n k i j : Nat)
  requires ring : IsCommRing(A, add, zero, neg, mul, one)
  requires left : a ∈ A
  requires right : b ∈ A
  requires center : r ∈ A
  requires lower : n ≤ i
  requires row : i < succ(m + n)
  requires column : j < succ(m + n)
  requires reduced : j < succ(k)
  requires early : j < sub(i, n)
  shows columnReduced(A, add, zero, neg, mul, one, a, b, r, cs, ds, m, n,
    k)[i, j] = zero
proof
  have entry := columnReduced.entry at A, add, zero, neg, mul, one, a, b, r,
    cs, ds, m, n, k, i, j with *
  have columnRule := membership.of_Less at j, succ(k) with *
  have columnMember := columnRule with reduced
  have absent : ¬(i ∈ n)
    intro member
    have belowRule := Less.of_membership at i, n with *
    have below := belowRule with member
    arith
  have differenceNat : Nat(sub(i, n)) by typecheck
  have earlyRule := membership.of_Less at j, sub(i, n) with *
  have earlyMember := earlyRule with early
  have test := memberTest.true with columnMember
  have test2 := memberTest.false with absent
  have test3 := memberTest.true with earlyMember
  rw [entry, test, boolChoice.true, test2, boolChoice.false, test3,
    boolChoice.true]
  rfl

theorem columnReduced.lower_value (A add zero neg mul one a b r : Set)
  (cs ds : List(A)) (m n k i j : Nat)
  requires ring : IsCommRing(A, add, zero, neg, mul, one)
  requires left : a ∈ A
  requires right : b ∈ A
  requires center : r ∈ A
  requires lower : n ≤ i
  requires row : i < succ(m + n)
  requires column : j < succ(m + n)
  requires reduced : j < succ(k)
  requires late : sub(i, n) ≤ j
  shows columnReduced(A, add, zero, neg, mul, one, a, b, r, cs, ds, m, n,
      k)[i, j] =
    linearValue{A}(add, mul, b, r, append{A}(ds, listReplicate(m, zero)),
      m + n, sub(j, sub(i, n)))
proof
  have entry := columnReduced.entry at A, add, zero, neg, mul, one, a, b, r,
    cs, ds, m, n, k, i, j with *
  have columnRule := membership.of_Less at j, succ(k) with *
  have columnMember := columnRule with reduced
  have absent : ¬(i ∈ n)
    intro member
    have belowRule := Less.of_membership at i, n with *
    have below := belowRule with member
    arith
  have differenceNat : Nat(sub(i, n)) by typecheck
  have absent3 : ¬(j ∈ sub(i, n))
    intro member
    have belowRule := Less.of_membership at j, sub(i, n) with *
    have below := belowRule with member
    have contradiction := LessEqual.not_Less with late
    exact contradiction with below
  have test := memberTest.true with columnMember
  have test2 := memberTest.false with absent
  have test3 := memberTest.false with absent3
  rw [entry, test, boolChoice.true, test2, boolChoice.false, test3,
    boolChoice.false]
  rfl

theorem columnReduced.original (A add zero neg mul one a b r : Set)
  (cs ds : List(A)) (m n k i j : Nat)
  requires ring : IsCommRing(A, add, zero, neg, mul, one)
  requires left : a ∈ A
  requires right : b ∈ A
  requires center : r ∈ A
  requires row : i < succ(m + n)
  requires column : j < succ(m + n)
  requires kept : ¬(j < succ(k))
  shows columnReduced(A, add, zero, neg, mul, one, a, b, r, cs, ds, m, n,
      k)[i, j] =
    sylvesterBlockMatrix(A, zero, a, b,
      hornerAffineProduct{A}(add, mul, a, neg(r), one, zero, cs), ds, n,
      succ(m + n))[i, j]
proof
  have entry := columnReduced.entry at A, add, zero, neg, mul, one, a, b, r,
    cs, ds, m, n, k, i, j with *
  have absent : ¬(j ∈ succ(k))
    intro member
    have belowRule := Less.of_membership at j, succ(k) with *
    have below := belowRule with member
    exact kept with below
  have test := memberTest.false with absent
  rw [entry, test, boolChoice.false]
  rfl

section Columns
variable (A add zero neg mul one a b r : Set)
notation ring R := (A, add, zero, neg, mul, one)
hypothesis ring : IsCommRing(R)
hypothesis left : a ∈ R
hypothesis right : b ∈ R
hypothesis center : r ∈ R

-- Before any column operation the reduced matrix is the Sylvester matrix.
theorem columnReduced.initial (cs ds : List(A)) (m n : Nat)
  requires sizeC : length{A}(cs) = m
  requires sizeD : length{A}(ds) = n
  shows determinant(succ(m + n), R, columnReduced(A, add, zero, neg, mul, one,
      a, b, r, cs, ds, m, n, (0:N))) =
    determinant(succ(m + n), R, sylvesterBlockMatrix(A, zero, a, b,
      hornerAffineProduct{A}(add, mul, a, neg(r), one, zero, cs), ds, n,
      succ(m + n)))
proof
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have negIn := IsRing.neg_closed with ordinary, center
  have esData := hornerAffineProduct.data at A, add, zero, neg, mul, one, a,
    neg(r), one, zero, cs with *
  have esList := esData.left
  have sumNat : Nat(succ(m + n)) by typecheck
  have zeros := listReplicate.closed at A, zero, m with zeroIn
  have zerosLength := listReplicate.length at A, zero, m with zeroIn
  have padded : List(A, append{A}(ds, listReplicate(m, zero))) by typecheck
  have paddedLength : length{A}(append{A}(ds, listReplicate(m, zero))) = m + n
    rw [length.append, zerosLength, sizeD]
    rfl
  have reduced := columnReduced.matrix at A, add, zero, neg, mul, one, a, b, r,
    cs, ds, m, n, (0:N) with *
  have matrix := sylvesterBlockMatrix.matrix at A, add, zero, neg, mul, one, a,
    b, hornerAffineProduct{A}(add, mul, a, neg(r), one, zero, cs), ds, n,
    succ(m + n) with *
  have positions := natural.member at succ(m + n)
  have entries : ∀ i ∈ succ(m + n), ∀ j ∈ succ(m + n),
      columnReduced(A, add, zero, neg, mul, one, a, b, r, cs, ds, m, n,
        (0:N))[i, j] =
      sylvesterBlockMatrix(A, zero, a, b,
        hornerAffineProduct{A}(add, mul, a, neg(r), one, zero, cs), ds, n,
        succ(m + n))[i, j]
    intros i hi j hj
    have iNat := positions with i, hi
    have jNat := positions with j, hj
    have rowRule := Less.of_membership at i, succ(m + n) with *
    have row := rowRule with hi
    have columnRule := Less.of_membership at j, succ(m + n) with *
    have column := columnRule with hj
    have alternatives : j < succ((0:N)) ∨ ¬(j < succ((0:N))) by tauto
    cases alternatives with first | later
    . have jZero : j = (0:N) by arith
      rw jZero
      have reducedBound : (0:N) < succ((0:N)) by arith
      have zeroBound : (0:N) < succ(m + n) by arith
      have rows : i < n ∨ ¬(i < n) by tauto
      cases rows with upper | lower
      . have entry := columnReduced.upper at A, add, zero, neg, mul, one, a, b,
          r, cs, ds, m, n, (0:N), i, (0:N) with *
        have original := sylvesterBlockMatrix.entry_upper at A, add, zero, neg,
          mul, one, a, b,
          hornerAffineProduct{A}(add, mul, a, neg(r), one, zero, cs), ds, n,
          succ(m + n), i, (0:N) with *
        have same := sylvesterRow.affine_zero at A, add, zero, neg, mul, one,
          a, b, r, cs, i with ring, left, right, center
        rw [entry, original, same]
        rfl
      . have atLeast := LessEqual.of_not_Less with lower
        have original := sylvesterBlockMatrix.entry_lower at A, add, zero, neg,
          mul, one, a, b,
          hornerAffineProduct{A}(add, mul, a, neg(r), one, zero, cs), ds, n,
          succ(m + n), i, (0:N) with *
        have split : i = n ∨ n < i
          have shape := Less.trichotomy at n, i with *
          rcases shape with below | same | above
          . right
            exact below
          . left
            symm
            exact same
          . exfalso
            have contradiction := LessEqual.not_Less with atLeast
            exact contradiction with above
        cases split with same | above
        . have shape : i = n + (0:N) by arith
          have difference := sub.of_add at i, n, (0:N) with shape
          have late : sub(i, n) ≤ (0:N)
            rw difference
            arith
          have entry := columnReduced.lower_value at A, add, zero, neg, mul,
            one, a, b, r, cs, ds, m, n, (0:N), i, (0:N) with *
          have zeroSub : sub((0:N), sub(i, n)) = (0:N)
            rw difference
            exact sub.zero_right at (0:N)
          have initial := linearValue.initial at A, add, mul, b, r,
            append{A}(ds, listReplicate(m, zero)), m + n with *
          have lowerBound : (0:N) ≤ (0:N) by arith
          have upperBound : (0:N) ≤ (0:N) + length{A}(ds) by arith
          have rowEntry := sylvesterRow.coefficient at A, zero, b, ds, (0:N),
            (0:N) with zeroIn, right, lowerBound, upperBound
          have index : sub(length{A}(ds) + (0:N), (0:N)) = length{A}(ds)
            rw add.right_unit
            exact sub.zero_right at length{A}(ds)
          have leading := hornerCoefficient.leading at A, zero, b, ds with *
          rw [entry, zeroSub, initial, original, difference, rowEntry, index,
            leading]
          rfl
        . have atLeastSucc : (succ(n) : Nat) ≤ i by arith
          obtain ⟨e, eNat, splitE⟩ := LessEqual.exists_add with atLeastSucc
          have shape : i = n + (succ(e) : Nat) by arith
          have difference := sub.of_add at i, n, (succ(e) : Nat) with shape
          have early : (0:N) < sub(i, n)
            rw difference
            arith
          have entry := columnReduced.lower_zero at A, add, zero, neg, mul,
            one, a, b, r, cs, ds, m, n, (0:N), i, (0:N) with *
          have outside : (0:N) < sub(i, n) ∨ sub(i, n) + length{A}(ds) < (0:N)
            left
            exact early
          have rowEntry := sylvesterRow.coefficient_outside at A, zero, b, ds,
            sub(i, n), (0:N) with zeroIn, right, outside
          rw [entry, original, rowEntry]
          rfl
    . have entry := columnReduced.original at A, add, zero, neg, mul, one, a,
        b, r, cs, ds, m, n, (0:N), i, j with *
      exact entry
  exact determinant.congr with *

-- Each column operation keeps the determinant.
theorem columnReduced.step (cs ds : List(A)) (m n k : Nat)
  requires sizeC : length{A}(cs) = m
  requires sizeD : length{A}(ds) = n
  requires bound : k < m + n
  shows determinant(succ(m + n), R, columnReduced(A, add, zero, neg, mul, one,
      a, b, r, cs, ds, m, n, succ(k))) =
    determinant(succ(m + n), R, columnReduced(A, add, zero, neg, mul, one,
      a, b, r, cs, ds, m, n, k))
proof
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have negIn := IsRing.neg_closed with ordinary, center
  have esData := hornerAffineProduct.data at A, add, zero, neg, mul, one, a,
    neg(r), one, zero, cs with *
  have esList := esData.left
  have sumNat : Nat(succ(m + n)) by typecheck
  have zeros := listReplicate.closed at A, zero, m with zeroIn
  have zerosLength := listReplicate.length at A, zero, m with zeroIn
  have padded : List(A, append{A}(ds, listReplicate(m, zero))) by typecheck
  have paddedLength : length{A}(append{A}(ds, listReplicate(m, zero))) = m + n
    rw [length.append, zerosLength, sizeD]
    rfl
  have matrixM := columnReduced.matrix at A, add, zero, neg, mul, one, a, b, r,
    cs, ds, m, n, k with *
  have matrixN := columnReduced.matrix at A, add, zero, neg, mul, one, a, b, r,
    cs, ds, m, n, succ(k) with *
  have columnBound : succ(k) < succ(m + n) by arith
  have columnRule := membership.of_Less at succ(k), succ(m + n) with *
  have column := columnRule with columnBound
  have sourceBound : k < succ(m + n) by arith
  have sourceRule := membership.of_Less at k, succ(m + n) with *
  have source := sourceRule with sourceBound
  have distinct : succ(k) ≠ k
    intro equal
    have below : k < succ(k) by arith
    rw equal at below
    exact Less.irreflexive at k with below
  have positions := natural.member at succ(m + n)
  have outside : ∀ c ∈ succ(m + n), ¬(c = succ(k)) →
      ∀ i ∈ succ(m + n),
      columnReduced(A, add, zero, neg, mul, one, a, b, r, cs, ds, m, n,
        succ(k))[i, c] =
      columnReduced(A, add, zero, neg, mul, one, a, b, r, cs, ds, m, n, k)[i,
        c]
    intros c hc different i hi
    have cNat := positions with c, hc
    have iNat := positions with i, hi
    have cRule := Less.of_membership at c, succ(m + n) with *
    have cBound := cRule with hc
    have iRule := Less.of_membership at i, succ(m + n) with *
    have iBound := iRule with hi
    have entryN := columnReduced.entry at A, add, zero, neg, mul, one, a, b, r,
      cs, ds, m, n, succ(k), i, c with *
    have entryM := columnReduced.entry at A, add, zero, neg, mul, one, a, b, r,
      cs, ds, m, n, k, i, c with *
    have alternatives : c < succ(succ(k)) ∨ ¬(c < succ(succ(k))) by tauto
    cases alternatives with reduced | kept
    . have earlier : c < succ(k)
        by_contra notEarlier
        have equal : c = succ(k) by arith
        exact different with equal
      have memberN := membership.of_Less at c, succ(succ(k)) with *
      have memberM := membership.of_Less at c, succ(k) with *
      have testN := memberTest.true with (memberN with reduced)
      have testM := memberTest.true with (memberM with earlier)
      rw [entryN, entryM, testN, testM, boolChoice.true]
      rfl
    . have keptM : ¬(c < succ(k))
        intro below
        apply kept
        arith
      have absentN : ¬(c ∈ succ(succ(k)))
        intro member
        have belowRule := Less.of_membership at c, succ(succ(k)) with *
        exact kept with (belowRule with member)
      have absentM : ¬(c ∈ succ(k))
        intro member
        have belowRule := Less.of_membership at c, succ(k) with *
        exact keptM with (belowRule with member)
      have testN := memberTest.false with absentN
      have testM := memberTest.false with absentM
      rw [entryN, entryM, testN, testM, boolChoice.false]
      rfl
  have entries : ∀ i ∈ succ(m + n),
      columnReduced(A, add, zero, neg, mul, one, a, b, r, cs, ds, m, n,
        succ(k))[i, succ(k)] =
      R[columnReduced(A, add, zero, neg, mul, one, a, b, r, cs, ds, m, n,
        k)[i, succ(k)] +
        r * columnReduced(A, add, zero, neg, mul, one, a, b, r, cs, ds, m, n,
          k)[i, k]]
    intros i hi
    have iNat := positions with i, hi
    have iRule := Less.of_membership at i, succ(m + n) with *
    have iBound := iRule with hi
    have keptM : ¬(succ(k) < succ(k)) := Less.irreflexive at succ(k)
    have originalM := columnReduced.original at A, add, zero, neg, mul, one, a,
      b, r, cs, ds, m, n, k, i, succ(k) with *
    have reducedN : succ(k) < succ(succ(k)) by arith
    have reducedM : k < succ(k) by arith
    have rows : i < n ∨ ¬(i < n) by tauto
    cases rows with upper | lower
    . have entryN := columnReduced.upper at A, add, zero, neg, mul, one, a, b,
        r, cs, ds, m, n, succ(k), i, succ(k) with *
      have entryM := columnReduced.upper at A, add, zero, neg, mul, one, a, b,
        r, cs, ds, m, n, k, i, k with *
      have original := sylvesterBlockMatrix.entry_upper at A, add, zero, neg,
        mul, one, a, b,
        hornerAffineProduct{A}(add, mul, a, neg(r), one, zero, cs), ds, n,
        succ(m + n), i, succ(k) with *
      have same := sylvesterRow.affine_succ at A, add, zero, neg, mul, one, a,
        b, r, cs, i, k with ring, left, right, center
      have rowC := sylvesterRow.list at A, zero, a, cs, i with *
      have entryIn := listCoefficient.closed at A, zero,
        sylvesterRow{A}(zero, a, cs, i), succ(k) with *
      have previousIn := listCoefficient.closed at A, zero,
        sylvesterRow{A}(zero, a, cs, i), k with *
      rw [entryN, originalM, original, entryM, same]
      ring
    . have atLeast := LessEqual.of_not_Less with lower
      have differenceNat : Nat(sub(i, n)) by typecheck
      have original := sylvesterBlockMatrix.entry_lower at A, add, zero, neg,
        mul, one, a, b,
        hornerAffineProduct{A}(add, mul, a, neg(r), one, zero, cs), ds, n,
        succ(m + n), i, succ(k) with *
      have shape := Less.trichotomy at succ(k), sub(i, n) with *
      rcases shape with before | same | after
      . have earlyM : k < sub(i, n) by arith
        have entryN := columnReduced.lower_zero at A, add, zero, neg, mul, one,
          a, b, r, cs, ds, m, n, succ(k), i, succ(k) with *
        have entryM := columnReduced.lower_zero at A, add, zero, neg, mul, one,
          a, b, r, cs, ds, m, n, k, i, k with *
        have outsideRow : succ(k) < sub(i, n) ∨
            sub(i, n) + length{A}(ds) < succ(k)
          left
          exact before
        have rowEntry := sylvesterRow.coefficient_outside at A, zero, b, ds,
          sub(i, n), succ(k) with zeroIn, right, outsideRow
        rw [entryN, originalM, original, rowEntry, entryM]
        ring
      . have late : sub(i, n) ≤ succ(k) by arith
        have earlyM : k < sub(i, n) by arith
        have entryN := columnReduced.lower_value at A, add, zero, neg, mul,
          one, a, b, r, cs, ds, m, n, succ(k), i, succ(k) with *
        have entryM := columnReduced.lower_zero at A, add, zero, neg, mul, one,
          a, b, r, cs, ds, m, n, k, i, k with *
        have shapeZero : succ(k) = sub(i, n) + (0:N) by arith
        have zeroSub := sub.of_add at succ(k), sub(i, n), (0:N) with shapeZero
        have initial := linearValue.initial at A, add, mul, b, r,
          append{A}(ds, listReplicate(m, zero)), m + n with *
        have lowerBound : sub(i, n) ≤ succ(k) by arith
        have upperBound : succ(k) ≤ sub(i, n) + length{A}(ds) by arith
        have rowEntry := sylvesterRow.coefficient at A, zero, b, ds, sub(i, n),
          succ(k) with zeroIn, right, lowerBound, upperBound
        have shapeIndex : length{A}(ds) + sub(i, n) = succ(k) + length{A}(ds)
          by arith
        have index := sub.of_add at length{A}(ds) + sub(i, n), succ(k),
          length{A}(ds) with shapeIndex
        have leading := hornerCoefficient.leading at A, zero, b, ds with *
        rw [entryN, zeroSub, initial, originalM, original, rowEntry, index,
          leading, entryM]
        ring
      . have late : sub(i, n) ≤ succ(k) by arith
        have lateM : sub(i, n) ≤ k by arith
        obtain ⟨j, jNat, splitJ⟩ := LessEqual.exists_add with lateM
        have shapeSucc : succ(k) = sub(i, n) + (succ(j) : Nat) by arith
        have indexN := sub.of_add at succ(k), sub(i, n), (succ(j) : Nat) with
          shapeSucc
        have indexM := sub.of_add at k, sub(i, n), j with splitJ
        have entryN := columnReduced.lower_value at A, add, zero, neg, mul,
          one, a, b, r, cs, ds, m, n, succ(k), i, succ(k) with *
        have entryM := columnReduced.lower_value at A, add, zero, neg, mul,
          one, a, b, r, cs, ds, m, n, k, i, k with *
        have small : j < m + n by arith
        have step := linearValue.step at A, add, zero, mul, b, r,
          append{A}(ds, listReplicate(m, zero)), m + n, j with *
        have paddedBound : (succ(j) : Nat) ≤ m + length{A}(ds)
          rw sizeD
          arith
        have rowEntry := sylvesterRow.padded_coefficient at A, add, zero, neg,
          mul, one, a, b, ds, m, sub(i, n), j with ring, left, right,
          paddedBound
        rw sizeD at rowEntry
        rw [entryN, indexN, step, originalM, original, shapeSucc, rowEntry,
          entryM, indexM]
        rfl
  exact determinant.column_add_multiple at A, add, zero, neg, mul, one,
    succ(m + n),
    columnReduced(A, add, zero, neg, mul, one, a, b, r, cs, ds, m, n, k),
    columnReduced(A, add, zero, neg, mul, one, a, b, r, cs, ds, m, n, succ(k)),
    succ(k), k, r with ring, matrixM, matrixN, column, source, distinct, center,
    outside, entries

theorem columnReduced.chain (cs ds : List(A)) (m n k : Nat)
  requires sizeC : length{A}(cs) = m
  requires sizeD : length{A}(ds) = n
  requires bound : k ≤ m + n
  shows determinant(succ(m + n), R, columnReduced(A, add, zero, neg, mul, one,
      a, b, r, cs, ds, m, n, k)) =
    determinant(succ(m + n), R, sylvesterBlockMatrix(A, zero, a, b,
      hornerAffineProduct{A}(add, mul, a, neg(r), one, zero, cs), ds, n,
      succ(m + n)))
proof
  induction k
  | zero =>
    intro bound
    exact columnReduced.initial at A, add, zero, neg, mul, one, a, b, r, cs,
      ds, m, n with *
  | succ(j) using ih =>
    intro bound
    have smaller : j ≤ m + n by arith
    have strict : j < m + n by arith
    have step := columnReduced.step at A, add, zero, neg, mul, one, a, b, r,
      cs, ds, m, n, j with *
    have previous := ih with smaller
    rw [step, previous]
    rfl

end Columns

-- The fully column-reduced matrix after k row operations: the first k
-- rows of q, holding partial Horner values, have been returned to the
-- rows of q by subtracting r times the next row each; the rows of p and
-- the remaining rows are untouched.
defgraph rowReduced (A add zero neg mul one a b r cs ds : Set, m n k : Nat)
  (p ∈ succ(m + n) × succ(m + n)) : A :=
  boolChoice(memberTest(n, fst(p)),
    columnReduced(A, add, zero, neg, mul, one, a, b, r, cs, ds, m, n,
      m + n)(p),
    boolChoice(memberTest(n + k, fst(p)),
      listCoefficient{A}(zero, sylvesterRow{A}(zero, b, ds, sub(fst(p), n)),
        snd(p)),
      columnReduced(A, add, zero, neg, mul, one, a, b, r, cs, ds, m, n,
        m + n)(p)))
requires ring : IsCommRing(A, add, zero, neg, mul, one)
requires left : a ∈ A
requires right : b ∈ A
requires center : r ∈ A
requires leftList : List(A, cs)
requires rightList : List(A, ds)
proof
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have sumNat : Nat(succ(m + n)) by typecheck
  have reduced := columnReduced.function at A, add, zero, neg, mul, one, a, b,
    r, cs, ds, m, n, m + n with *
  have original := FunctionBetween.apply_closed at
    columnReduced(A, add, zero, neg, mul, one, a, b, r, cs, ds, m, n, m + n),
    succ(m + n) × succ(m + n), A, p with *
  obtain ⟨bound, i, hi, j, hj, shape⟩ := product.membership.forward
    at succ(m + n), succ(m + n), p with *
  have positions := natural.member at succ(m + n)
  have iNat := positions with i, hi
  have jNat := positions with j, hj
  have differenceNat : Nat(sub(i, n)) by typecheck
  have rowD := sylvesterRow.list at A, zero, b, ds, sub(i, n) with *
  have entryIn := listCoefficient.closed at A, zero,
    sylvesterRow{A}(zero, b, ds, sub(i, n)), j with *
  rw [shape, fst.pair, snd.pair]
  rw shape at original
  have rows : i ∈ n ∨ ¬(i ∈ n) by tauto
  cases rows with upper | lower
  . have test := memberTest.true with upper
    rw [test, boolChoice.true]
    exact original
  . have test := memberTest.false with lower
    rw [test, boolChoice.false]
    have finished : i ∈ n + k ∨ ¬(i ∈ n + k) by tauto
    cases finished with done | pending
    . have test2 := memberTest.true with done
      rw [test2, boolChoice.true]
      exact entryIn
    . have test2 := memberTest.false with pending
      rw [test2, boolChoice.false]
      exact original

theorem rowReduced.matrix (A add zero neg mul one a b r : Set)
  (cs ds : List(A)) (m n k : Nat)
  requires ring : IsCommRing(A, add, zero, neg, mul, one)
  requires left : a ∈ A
  requires right : b ∈ A
  requires center : r ∈ A
  shows RingMatrix(succ(m + n), A,
    rowReduced(A, add, zero, neg, mul, one, a, b, r, cs, ds, m, n, k))
proof
  unfold RingMatrix
  exact rowReduced.function with *

theorem rowReduced.entry (A add zero neg mul one a b r : Set)
  (cs ds : List(A)) (m n k i j : Nat)
  requires ring : IsCommRing(A, add, zero, neg, mul, one)
  requires left : a ∈ A
  requires right : b ∈ A
  requires center : r ∈ A
  requires row : i < succ(m + n)
  requires column : j < succ(m + n)
  shows rowReduced(A, add, zero, neg, mul, one, a, b, r, cs, ds, m, n, k)[i,
      j] =
    boolChoice(memberTest(n, i),
      columnReduced(A, add, zero, neg, mul, one, a, b, r, cs, ds, m, n,
        m + n)[i, j],
      boolChoice(memberTest(n + k, i),
        listCoefficient{A}(zero, sylvesterRow{A}(zero, b, ds, sub(i, n)), j),
        columnReduced(A, add, zero, neg, mul, one, a, b, r, cs, ds, m, n,
          m + n)[i, j]))
proof
  have sumNat : Nat(succ(m + n)) by typecheck
  have rowRule := membership.of_Less at i, succ(m + n) with *
  have rowMember := rowRule with row
  have columnRule := membership.of_Less at j, succ(m + n) with *
  have columnMember := columnRule with column
  have pair := product.pair at i, j, succ(m + n), succ(m + n) with rowMember,
    columnMember
  have value := rowReduced.value at A, add, zero, neg, mul, one, a, b, r, cs,
    ds, m, n, k, (i, j) with *
  rw [value, fst.pair, snd.pair]
  rfl

theorem rowReduced.upper (A add zero neg mul one a b r : Set)
  (cs ds : List(A)) (m n k i j : Nat)
  requires ring : IsCommRing(A, add, zero, neg, mul, one)
  requires left : a ∈ A
  requires right : b ∈ A
  requires center : r ∈ A
  requires upper : i < n
  requires row : i < succ(m + n)
  requires column : j < succ(m + n)
  shows rowReduced(A, add, zero, neg, mul, one, a, b, r, cs, ds, m, n, k)[i,
      j] =
    columnReduced(A, add, zero, neg, mul, one, a, b, r, cs, ds, m, n,
      m + n)[i, j]
proof
  have entry := rowReduced.entry at A, add, zero, neg, mul, one, a, b, r, cs,
    ds, m, n, k, i, j with *
  have rowRule := membership.of_Less at i, n with *
  have rowMember := rowRule with upper
  have test := memberTest.true with rowMember
  rw [entry, test, boolChoice.true]
  rfl

theorem rowReduced.finished (A add zero neg mul one a b r : Set)
  (cs ds : List(A)) (m n k i j : Nat)
  requires ring : IsCommRing(A, add, zero, neg, mul, one)
  requires left : a ∈ A
  requires right : b ∈ A
  requires center : r ∈ A
  requires lower : n ≤ i
  requires done : i < n + k
  requires row : i < succ(m + n)
  requires column : j < succ(m + n)
  shows rowReduced(A, add, zero, neg, mul, one, a, b, r, cs, ds, m, n, k)[i,
      j] =
    listCoefficient{A}(zero, sylvesterRow{A}(zero, b, ds, sub(i, n)), j)
proof
  have entry := rowReduced.entry at A, add, zero, neg, mul, one, a, b, r, cs,
    ds, m, n, k, i, j with *
  have absent : ¬(i ∈ n)
    intro member
    have belowRule := Less.of_membership at i, n with *
    have below := belowRule with member
    have contradiction := LessEqual.not_Less with lower
    exact contradiction with below
  have doneRule := membership.of_Less at i, n + k with *
  have doneMember := doneRule with done
  have test := memberTest.false with absent
  have test2 := memberTest.true with doneMember
  rw [entry, test, boolChoice.false, test2, boolChoice.true]
  rfl

theorem rowReduced.pending (A add zero neg mul one a b r : Set)
  (cs ds : List(A)) (m n k i j : Nat)
  requires ring : IsCommRing(A, add, zero, neg, mul, one)
  requires left : a ∈ A
  requires right : b ∈ A
  requires center : r ∈ A
  requires pending : n + k ≤ i
  requires row : i < succ(m + n)
  requires column : j < succ(m + n)
  shows rowReduced(A, add, zero, neg, mul, one, a, b, r, cs, ds, m, n, k)[i,
      j] =
    columnReduced(A, add, zero, neg, mul, one, a, b, r, cs, ds, m, n,
      m + n)[i, j]
proof
  have entry := rowReduced.entry at A, add, zero, neg, mul, one, a, b, r, cs,
    ds, m, n, k, i, j with *
  have absent : ¬(i ∈ n)
    intro member
    have belowRule := Less.of_membership at i, n with *
    have below := belowRule with member
    arith
  have absent2 : ¬(i ∈ n + k)
    intro member
    have belowRule := Less.of_membership at i, n + k with *
    have below := belowRule with member
    have contradiction := LessEqual.not_Less with pending
    exact contradiction with below
  have test := memberTest.false with absent
  have test2 := memberTest.false with absent2
  rw [entry, test, boolChoice.false, test2, boolChoice.false]
  rfl

section Rows
variable (A add zero neg mul one a b r : Set)
notation ring R := (A, add, zero, neg, mul, one)
hypothesis ring : IsCommRing(R)
hypothesis left : a ∈ R
hypothesis right : b ∈ R
hypothesis center : r ∈ R

theorem rowReduced.initial (cs ds : List(A)) (m n : Nat)
  shows determinant(succ(m + n), R, rowReduced(A, add, zero, neg, mul, one,
      a, b, r, cs, ds, m, n, (0:N))) =
    determinant(succ(m + n), R, columnReduced(A, add, zero, neg, mul, one,
      a, b, r, cs, ds, m, n, m + n))
proof
  have sumNat : Nat(succ(m + n)) by typecheck
  have rows := rowReduced.matrix at A, add, zero, neg, mul, one, a, b, r, cs,
    ds, m, n, (0:N) with *
  have columns := columnReduced.matrix at A, add, zero, neg, mul, one, a, b,
    r, cs, ds, m, n, m + n with *
  have positions := natural.member at succ(m + n)
  have entries : ∀ i ∈ succ(m + n), ∀ j ∈ succ(m + n),
      rowReduced(A, add, zero, neg, mul, one, a, b, r, cs, ds, m, n, (0:N))[i,
        j] =
      columnReduced(A, add, zero, neg, mul, one, a, b, r, cs, ds, m, n,
        m + n)[i, j]
    intros i hi j hj
    have iNat := positions with i, hi
    have jNat := positions with j, hj
    have rowRule := Less.of_membership at i, succ(m + n) with *
    have row := rowRule with hi
    have columnRule := Less.of_membership at j, succ(m + n) with *
    have column := columnRule with hj
    have alternatives : i < n ∨ ¬(i < n) by tauto
    cases alternatives with upper | lower
    . exact rowReduced.upper at A, add, zero, neg, mul, one, a, b, r, cs, ds,
        m, n, (0:N), i, j with *
    . have atLeast := LessEqual.of_not_Less with lower
      have pending : n + (0:N) ≤ i
        rw add.right_unit
        exact atLeast
      exact rowReduced.pending at A, add, zero, neg, mul, one, a, b, r, cs,
        ds, m, n, (0:N), i, j with *
  exact determinant.congr with *

-- Each row operation keeps the determinant.
theorem rowReduced.step (cs ds : List(A)) (m n k : Nat)
  requires sizeC : length{A}(cs) = m
  requires sizeD : length{A}(ds) = n
  requires bound : k < m
  shows determinant(succ(m + n), R, rowReduced(A, add, zero, neg, mul, one,
      a, b, r, cs, ds, m, n, succ(k))) =
    determinant(succ(m + n), R, rowReduced(A, add, zero, neg, mul, one,
      a, b, r, cs, ds, m, n, k))
proof
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have negIn := IsRing.neg_closed with ordinary, center
  have sumNat : Nat(succ(m + n)) by typecheck
  have zeros := listReplicate.closed at A, zero, m with zeroIn
  have zerosLength := listReplicate.length at A, zero, m with zeroIn
  have padded : List(A, append{A}(ds, listReplicate(m, zero))) by typecheck
  have paddedLength : length{A}(append{A}(ds, listReplicate(m, zero))) = m + n
    rw [length.append, zerosLength, sizeD]
    rfl
  have matrixM := rowReduced.matrix at A, add, zero, neg, mul, one, a, b, r,
    cs, ds, m, n, k with *
  have matrixN := rowReduced.matrix at A, add, zero, neg, mul, one, a, b, r,
    cs, ds, m, n, succ(k) with *
  have rowBound : n + k < succ(m + n) by arith
  have rowRule := membership.of_Less at n + k, succ(m + n) with *
  have row := rowRule with rowBound
  have sourceBound : succ(n + k) < succ(m + n) by arith
  have sourceRule := membership.of_Less at succ(n + k), succ(m + n) with *
  have source := sourceRule with sourceBound
  have distinct : n + k ≠ succ(n + k)
    intro equal
    have below : n + k < succ(n + k) by arith
    rw ← equal at below
    exact Less.irreflexive at n + k with below
  have positions := natural.member at succ(m + n)
  have outside : ∀ c ∈ succ(m + n), ¬(c = n + k) → ∀ j ∈ succ(m + n),
      rowReduced(A, add, zero, neg, mul, one, a, b, r, cs, ds, m, n,
        succ(k))[c, j] =
      rowReduced(A, add, zero, neg, mul, one, a, b, r, cs, ds, m, n, k)[c, j]
    intros c hc different j hj
    have cNat := positions with c, hc
    have jNat := positions with j, hj
    have cRule := Less.of_membership at c, succ(m + n) with *
    have cBound := cRule with hc
    have jRule := Less.of_membership at j, succ(m + n) with *
    have jBound := jRule with hj
    have alternatives : c < n ∨ ¬(c < n) by tauto
    cases alternatives with upper | lower
    . have entryN := rowReduced.upper at A, add, zero, neg, mul, one, a, b, r,
        cs, ds, m, n, succ(k), c, j with *
      have entryM := rowReduced.upper at A, add, zero, neg, mul, one, a, b, r,
        cs, ds, m, n, k, c, j with *
      rw [entryN, entryM]
      rfl
    . have atLeast := LessEqual.of_not_Less with lower
      have split : c < n + k ∨ ¬(c < n + k) by tauto
      cases split with done | pending
      . have doneN : c < n + succ(k) by arith
        have entryN := rowReduced.finished at A, add, zero, neg, mul, one, a,
          b, r, cs, ds, m, n, succ(k), c, j with *
        have entryM := rowReduced.finished at A, add, zero, neg, mul, one, a,
          b, r, cs, ds, m, n, k, c, j with *
        rw [entryN, entryM]
        rfl
      . have pendingM := LessEqual.of_not_Less with pending
        have strict : n + k < c
          have shape := Less.trichotomy at n + k, c with *
          rcases shape with below | same | above
          . exact below
          . exfalso
            apply different
            symm
            exact same
          . exfalso
            have contradiction := LessEqual.not_Less with pendingM
            exact contradiction with above
        have pendingN : n + succ(k) ≤ c by arith
        have entryN := rowReduced.pending at A, add, zero, neg, mul, one, a,
          b, r, cs, ds, m, n, succ(k), c, j with *
        have entryM := rowReduced.pending at A, add, zero, neg, mul, one, a,
          b, r, cs, ds, m, n, k, c, j with *
        rw [entryN, entryM]
        rfl
  have entries : ∀ j ∈ succ(m + n),
      rowReduced(A, add, zero, neg, mul, one, a, b, r, cs, ds, m, n,
        succ(k))[n + k, j] =
      R[rowReduced(A, add, zero, neg, mul, one, a, b, r, cs, ds, m, n,
        k)[n + k, j] +
        -r * rowReduced(A, add, zero, neg, mul, one, a, b, r, cs, ds, m, n,
          k)[succ(n + k), j]]
    intros j hj
    have jNat := positions with j, hj
    have jRule := Less.of_membership at j, succ(m + n) with *
    have jBound := jRule with hj
    have atLeast : n ≤ n + k by arith
    have doneN : n + k < n + succ(k) by arith
    have pendingM : n + k ≤ n + k by arith
    have pendingNext : n + k ≤ succ(n + k) by arith
    have shapeK : n + k = n + k by rfl
    have indexK := sub.of_add at n + k, n, k with shapeK
    have shapeSucc : succ(n + k) = n + (succ(k) : Nat) by arith
    have indexSucc := sub.of_add at succ(n + k), n, (succ(k) : Nat) with
      shapeSucc
    have entryN := rowReduced.finished at A, add, zero, neg, mul, one, a, b,
      r, cs, ds, m, n, succ(k), n + k, j with *
    have entryM := rowReduced.pending at A, add, zero, neg, mul, one, a, b, r,
      cs, ds, m, n, k, n + k, j with *
    have entryNext := rowReduced.pending at A, add, zero, neg, mul, one, a, b,
      r, cs, ds, m, n, k, succ(n + k), j with *
    have atLeastNext : n ≤ succ(n + k) by arith
    rw [entryN, entryM, entryNext, indexK]
    have shape := Less.trichotomy at j, k with *
    rcases shape with before | same | after
    . have earlyNext : j < sub(succ(n + k), n)
        rw indexSucc
        arith
      have earlyM : j < sub(n + k, n)
        rw indexK
        exact before
      have valueM := columnReduced.lower_zero at A, add, zero, neg, mul, one,
        a, b, r, cs, ds, m, n, m + n, n + k, j with *
      have valueNext := columnReduced.lower_zero at A, add, zero, neg, mul,
        one, a, b, r, cs, ds, m, n, m + n, succ(n + k), j with *
      have outsideRow : j < k ∨ k + length{A}(ds) < j
        left
        exact before
      have rowEntry := sylvesterRow.coefficient_outside at A, zero, b, ds, k,
        j with zeroIn, right, outsideRow
      rw [rowEntry, valueM, valueNext]
      ring
    . rw same
      have kBound : k < succ(m + n) by arith
      have late : sub(n + k, n) ≤ k
        rw indexK
        arith
      have earlyNext : k < sub(succ(n + k), n)
        rw indexSucc
        arith
      have valueM := columnReduced.lower_value at A, add, zero, neg, mul, one,
        a, b, r, cs, ds, m, n, m + n, n + k, k with *
      have valueNext := columnReduced.lower_zero at A, add, zero, neg, mul,
        one, a, b, r, cs, ds, m, n, m + n, succ(n + k), k with *
      have shapeZero : k = k + (0:N) by arith
      have zeroSub := sub.of_add at k, k, (0:N) with shapeZero
      have initial := linearValue.initial at A, add, mul, b, r,
        append{A}(ds, listReplicate(m, zero)), m + n with *
      have lowerBound : k ≤ k by arith
      have upperBound : k ≤ k + length{A}(ds) by arith
      have rowEntry := sylvesterRow.coefficient at A, zero, b, ds, k, k with
        zeroIn, right, lowerBound, upperBound
      have shapeIndex : length{A}(ds) + k = k + length{A}(ds) by arith
      have index := sub.of_add at length{A}(ds) + k, k, length{A}(ds) with
        shapeIndex
      have leading := hornerCoefficient.leading at A, zero, b, ds with *
      rw [rowEntry, index, leading, valueM, indexK, zeroSub, initial,
        valueNext]
      ring
    . have lateM : sub(n + k, n) ≤ j
        rw indexK
        arith
      have lateNext : sub(succ(n + k), n) ≤ j
        rw indexSucc
        arith
      have valueM := columnReduced.lower_value at A, add, zero, neg, mul, one,
        a, b, r, cs, ds, m, n, m + n, n + k, j with *
      have valueNext := columnReduced.lower_value at A, add, zero, neg, mul,
        one, a, b, r, cs, ds, m, n, m + n, succ(n + k), j with *
      have atLeastSucc : (succ(k) : Nat) ≤ j by arith
      obtain ⟨u, uNat, splitU⟩ := LessEqual.exists_add with atLeastSucc
      have shapeU : j = k + (succ(u) : Nat) by arith
      have indexU := sub.of_add at j, k, (succ(u) : Nat) with shapeU
      have indexNext := sub.of_add at j, (succ(k) : Nat), u with splitU
      have small : u < m + n by arith
      have step := linearValue.step at A, add, zero, mul, b, r,
        append{A}(ds, listReplicate(m, zero)), m + n, u with *
      have paddedBound : (succ(u) : Nat) ≤ m + length{A}(ds)
        rw sizeD
        arith
      have rowEntry := sylvesterRow.padded_coefficient at A, add, zero, neg,
        mul, one, a, b, ds, m, k, u with ring, left, right, paddedBound
      rw sizeD at rowEntry
      have coefficientIn := hornerCoefficient.member at A, add, zero, neg,
        mul, one, b, append{A}(ds, listReplicate(m, zero)),
        sub(m + n, (succ(u) : Nat)) with ring, right
      have dropped := listDrop.closed at A,
        append{A}(ds, listReplicate(m, zero)), sub(m + n, u)
      have valueIn := hornerAt.closed at A, add, zero, neg, mul, one, b, r,
        listDrop{A}(sub(m + n, u), append{A}(ds, listReplicate(m, zero)))
        with *
      have valueU : linearValue{A}(add, mul, b, r,
          append{A}(ds, listReplicate(m, zero)), m + n, u) ∈ R
        unfold linearValue
        exact valueIn
      rw ← shapeU at rowEntry
      rw [rowEntry, valueM, indexK, indexU, step, valueNext, indexSucc,
        indexNext]
      ring
  exact determinant.row_add_multiple at A, add, zero, neg, mul, one,
    succ(m + n),
    rowReduced(A, add, zero, neg, mul, one, a, b, r, cs, ds, m, n, k),
    rowReduced(A, add, zero, neg, mul, one, a, b, r, cs, ds, m, n, succ(k)),
    n + k, succ(n + k), neg(r) with ring, matrixM, matrixN, row, source,
    distinct, negIn, outside, entries

theorem rowReduced.chain (cs ds : List(A)) (m n k : Nat)
  requires sizeC : length{A}(cs) = m
  requires sizeD : length{A}(ds) = n
  requires bound : k ≤ m
  shows determinant(succ(m + n), R, rowReduced(A, add, zero, neg, mul, one,
      a, b, r, cs, ds, m, n, k)) =
    determinant(succ(m + n), R, columnReduced(A, add, zero, neg, mul, one,
      a, b, r, cs, ds, m, n, m + n))
proof
  induction k
  | zero =>
    intro bound
    exact rowReduced.initial at A, add, zero, neg, mul, one, a, b, r, cs, ds,
      m, n with *
  | succ(j) using ih =>
    intro bound
    have smaller : j ≤ m by arith
    have strict : j < m by arith
    have step := rowReduced.step at A, add, zero, neg, mul, one, a, b, r, cs,
      ds, m, n, j with *
    have previous := ih with smaller
    rw [step, previous]
    rfl

end Rows

section Rings
variable (A add zero neg mul one a b : Set)
notation ring R := (A, add, zero, neg, mul, one)
hypothesis ring : IsCommRing(R)
hypothesis left : a ∈ R
hypothesis right : b ∈ R

-- The resultant of (X − r)·p with q is q(r) times the resultant of p and
-- q, where (X − r)·(a, cs) is the pair (a, hornerAffineProduct(a, −r, 1,
-- 0, cs)): the column operations turn the Sylvester matrix of (X − r)·p and
-- q into one whose rows of p are those of the Sylvester matrix of p and
-- q, the row operations restore the rows of q but the last, and the
-- last column then vanishes above its corner q(r).
theorem resultant.linear_factor (r : Set) (cs ds : List(A))
  requires center : r ∈ R
  shows resultant(R, a, hornerAffineProduct{A}(add, mul, a, neg(r), one, zero,
      cs), b, ds) =
    R[hornerAt{A}(add, mul, b, r, ds) * resultant(R, a, cs, b, ds)]
proof
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have negIn := IsRing.neg_closed with ordinary, center
  have esData := hornerAffineProduct.data at A, add, zero, neg, mul, one, a,
    neg(r), one, zero, cs with *
  have esList := esData.left
  have esLength := esData.right
  have sizeC : length{A}(cs) = length{A}(cs) by rfl
  have sizeD : length{A}(ds) = length{A}(ds) by rfl
  have sumNat : Nat(succ(length{A}(cs) + length{A}(ds))) by typecheck
  have smallNat : Nat(length{A}(cs) + length{A}(ds)) by typecheck
  have zeros := listReplicate.closed at A, zero, length{A}(cs) with zeroIn
  have zerosLength := listReplicate.length at A, zero, length{A}(cs) with
    zeroIn
  have padded : List(A, append{A}(ds, listReplicate(length{A}(cs), zero)))
    by typecheck
  have size : length{A}(hornerAffineProduct{A}(add, mul, a, neg(r), one, zero,
      cs)) + length{A}(ds) = succ(length{A}(cs) + length{A}(ds))
    rw esLength
    arith
  have columnsBound : length{A}(cs) + length{A}(ds) ≤
    length{A}(cs) + length{A}(ds) by arith
  have rowsBound : length{A}(cs) ≤ length{A}(cs) by arith
  have columns := columnReduced.chain at A, add, zero, neg, mul, one, a, b, r,
    cs, ds, length{A}(cs), length{A}(ds), length{A}(cs) + length{A}(ds) with
    ring, left, right, center, sizeC, sizeD, columnsBound
  have rows := rowReduced.chain at A, add, zero, neg, mul, one, a, b, r, cs,
    ds, length{A}(cs), length{A}(ds), length{A}(cs) with ring, left, right,
    center, sizeC, sizeD, rowsBound
  have matrixF := rowReduced.matrix at A, add, zero, neg, mul, one, a, b, r,
    cs, ds, length{A}(cs), length{A}(ds), length{A}(cs) with *
  have matrixS := sylvesterBlockMatrix.matrix at A, add, zero, neg, mul, one,
    a, b, cs, ds, length{A}(ds), length{A}(cs) + length{A}(ds) with *
  have positions := natural.member at length{A}(cs) + length{A}(ds)
  have lastBound : length{A}(cs) + length{A}(ds) <
    succ(length{A}(cs) + length{A}(ds)) by arith
  have column : ∀ i ∈ length{A}(cs) + length{A}(ds),
      rowReduced(A, add, zero, neg, mul, one, a, b, r, cs, ds, length{A}(cs),
        length{A}(ds), length{A}(cs))[i, length{A}(cs) + length{A}(ds)] = R[0]
    intros i hi
    have iNat := positions with i, hi
    have iRule := Less.of_membership at i, length{A}(cs) + length{A}(ds)
      with *
    have iBound := iRule with hi
    have row : i < succ(length{A}(cs) + length{A}(ds)) by arith
    have alternatives : i < length{A}(ds) ∨ ¬(i < length{A}(ds)) by tauto
    cases alternatives with upper | lower
    . have entry := rowReduced.upper at A, add, zero, neg, mul, one, a, b, r,
        cs, ds, length{A}(cs), length{A}(ds), length{A}(cs), i,
        length{A}(cs) + length{A}(ds) with *
      have reduced := columnReduced.upper at A, add, zero, neg, mul, one, a,
        b, r, cs, ds, length{A}(cs), length{A}(ds),
        length{A}(cs) + length{A}(ds), i, length{A}(cs) + length{A}(ds) with *
      have outsideRow : length{A}(cs) + length{A}(ds) < i ∨
          i + length{A}(cs) < length{A}(cs) + length{A}(ds)
        right
        arith
      have rowEntry := sylvesterRow.coefficient_outside at A, zero, a, cs, i,
        length{A}(cs) + length{A}(ds) with zeroIn, left, outsideRow
      rw [entry, reduced, rowEntry]
      rfl
    . have atLeast := LessEqual.of_not_Less with lower
      have done : i < length{A}(ds) + length{A}(cs) by arith
      have entry := rowReduced.finished at A, add, zero, neg, mul, one, a, b,
        r, cs, ds, length{A}(cs), length{A}(ds), length{A}(cs), i,
        length{A}(cs) + length{A}(ds) with *
      obtain ⟨e, eNat, splitE⟩ := LessEqual.exists_add with atLeast
      have index := sub.of_add at i, length{A}(ds), e with splitE
      have outsideRow : length{A}(cs) + length{A}(ds) < e ∨
          e + length{A}(ds) < length{A}(cs) + length{A}(ds)
        right
        arith
      have rowEntry := sylvesterRow.coefficient_outside at A, zero, b, ds, e,
        length{A}(cs) + length{A}(ds) with zeroIn, right, outsideRow
      rw [entry, index, rowEntry]
      rfl
  have entries : ∀ i ∈ length{A}(cs) + length{A}(ds),
      ∀ j ∈ length{A}(cs) + length{A}(ds),
      rowReduced(A, add, zero, neg, mul, one, a, b, r, cs, ds, length{A}(cs),
        length{A}(ds), length{A}(cs))[i, j] =
      sylvesterBlockMatrix(A, zero, a, b, cs, ds, length{A}(ds),
        length{A}(cs) + length{A}(ds))[i, j]
    intros i hi j hj
    have iNat := positions with i, hi
    have jNat := positions with j, hj
    have iRule := Less.of_membership at i, length{A}(cs) + length{A}(ds)
      with *
    have iBound := iRule with hi
    have jRule := Less.of_membership at j, length{A}(cs) + length{A}(ds)
      with *
    have jBound := jRule with hj
    have row : i < succ(length{A}(cs) + length{A}(ds)) by arith
    have column2 : j < succ(length{A}(cs) + length{A}(ds)) by arith
    have alternatives : i < length{A}(ds) ∨ ¬(i < length{A}(ds)) by tauto
    cases alternatives with upper | lower
    . have entry := rowReduced.upper at A, add, zero, neg, mul, one, a, b, r,
        cs, ds, length{A}(cs), length{A}(ds), length{A}(cs), i, j with *
      have reduced := columnReduced.upper at A, add, zero, neg, mul, one, a,
        b, r, cs, ds, length{A}(cs), length{A}(ds),
        length{A}(cs) + length{A}(ds), i, j with *
      have original := sylvesterBlockMatrix.entry_upper at A, add, zero, neg,
        mul, one, a, b, cs, ds, length{A}(ds),
        length{A}(cs) + length{A}(ds), i, j with *
      rw [entry, reduced, original]
      rfl
    . have atLeast := LessEqual.of_not_Less with lower
      have done : i < length{A}(ds) + length{A}(cs) by arith
      have entry := rowReduced.finished at A, add, zero, neg, mul, one, a, b,
        r, cs, ds, length{A}(cs), length{A}(ds), length{A}(cs), i, j with *
      have original := sylvesterBlockMatrix.entry_lower at A, add, zero, neg,
        mul, one, a, b, cs, ds, length{A}(ds),
        length{A}(cs) + length{A}(ds), i, j with *
      rw [entry, original]
      rfl
  have border := determinant.border at A, add, zero, neg, mul, one,
    length{A}(cs) + length{A}(ds),
    rowReduced(A, add, zero, neg, mul, one, a, b, r, cs, ds, length{A}(cs),
      length{A}(ds), length{A}(cs)),
    sylvesterBlockMatrix(A, zero, a, b, cs, ds, length{A}(ds),
      length{A}(cs) + length{A}(ds)) with ring, matrixF, matrixS, column,
    entries
  have corner : rowReduced(A, add, zero, neg, mul, one, a, b, r, cs, ds,
      length{A}(cs), length{A}(ds), length{A}(cs))[length{A}(cs) +
        length{A}(ds), length{A}(cs) + length{A}(ds)] =
      hornerAt{A}(add, mul, b, r, ds)
    have pending : length{A}(ds) + length{A}(cs) ≤
      length{A}(cs) + length{A}(ds) by arith
    have entry := rowReduced.pending at A, add, zero, neg, mul, one, a, b, r,
      cs, ds, length{A}(cs), length{A}(ds), length{A}(cs),
      length{A}(cs) + length{A}(ds), length{A}(cs) + length{A}(ds) with *
    have atLeast : length{A}(ds) ≤ length{A}(cs) + length{A}(ds) by arith
    have shapeM : length{A}(cs) + length{A}(ds) = length{A}(ds) + length{A}(cs)
      by arith
    have indexM := sub.of_add at length{A}(cs) + length{A}(ds), length{A}(ds),
      length{A}(cs) with shapeM
    have late : sub(length{A}(cs) + length{A}(ds), length{A}(ds)) ≤
        length{A}(cs) + length{A}(ds)
      rw indexM
      arith
    have reduced := columnReduced.lower_value at A, add, zero, neg, mul, one,
      a, b, r, cs, ds, length{A}(cs), length{A}(ds),
      length{A}(cs) + length{A}(ds), length{A}(cs) + length{A}(ds),
      length{A}(cs) + length{A}(ds) with *
    have shapeN : length{A}(cs) + length{A}(ds) = length{A}(cs) + length{A}(ds)
      by rfl
    have indexN := sub.of_add at length{A}(cs) + length{A}(ds), length{A}(cs),
      length{A}(ds) with shapeN
    have dropAll := listDrop.append_self at A, listReplicate(length{A}(cs),
      zero), ds with *
    rw zerosLength at dropAll
    rw [entry, reduced, indexM, indexN]
    unfold linearValue
    rw [indexM, dropAll]
    rfl
  unfold resultant
  unfold sylvesterMatrix
  rw [size, ← columns, ← rows, border, corner]
  rfl

end Rings

section Complexes
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

theorem complexLinearProduct.member (z : Set) (rs : List(ℂ))
  requires element : z ∈ ℂ
  shows complexLinearProduct(rs, z) ∈ ℂ
proof
  induction rs
  | List.nil =>
    rw complexLinearProduct
    typecheck
  | List.cons(r, rest) using ih =>
    have center : r ∈ ℂ by assumption
    have factor : ℂ[z + -r] ∈ ℂ by typecheck
    rw complexLinearProduct
    typecheck

theorem complexLinearProduct.zero_iff (z : Set) (rs : List(ℂ))
  requires element : z ∈ ℂ
  shows complexLinearProduct(rs, z) = ℂ[0] ↔ z ∈ listSupport{ℂ}(rs)
proof
  have field := complexes.is_field
  have nontrivial := complexes.nontrivial
  have distinct := Nontrivial.distinct with nontrivial
  have noZeroDivisors := IsField.no_zero_divisors with field
  unfold NoZeroDivisors at noZeroDivisors
  induction rs
  | List.nil =>
    rw [complexLinearProduct, listSupport.nil]
    constructor
    . intro vanish
      exfalso
      apply distinct
      symm
      exact vanish
    . intro member
      exfalso
      exact empty.membership with member
  | List.cons(r, rest) using ih =>
    have center : r ∈ ℂ by assumption
    have restList : List(ℂ, rest) by assumption
    have factor : ℂ[z + -r] ∈ ℂ by typecheck
    have productIn := complexLinearProduct.member at z, rest with element
    rw [complexLinearProduct, listSupport.cons, insert.membership]
    constructor
    . intro vanish
      have firstBinder := noZeroDivisors with factor
      have secondBinder := firstBinder with productIn
      have split := secondBinder with vanish
      cases split with first | second
      . left
        linear_combination first
      . right
        exact ih.forward with second
    . intro member
      cases member with same | inside
      . rw same
        ring
      . have vanish := ih.backward with inside
        rw vanish
        ring

theorem complexLinearList.data (rs : List(ℂ))
  shows List(ℂ, complexLinearList(rs)) ∧
    length{ℂ}(complexLinearList(rs)) = length{ℂ}(rs)
proof
  have ring := complexes.comm_ring
  have oneIn : ℂ[1] ∈ ℂ by typecheck
  have zeroIn : ℂ[0] ∈ ℂ by typecheck
  induction rs
  | List.nil =>
    rw complexLinearList
    constructor
    . typecheck
    . rfl
  | List.cons(r, rest) using ih =>
    have center : r ∈ ℂ by assumption
    have negIn : ℂ[-r] ∈ ℂ by typecheck
    have restList := ih.left
    have data := hornerAffineProduct.data at complexCarrier, complexAdd,
      complexZero, complexNeg, complexMul, complexOne, complexOne,
      complexNeg(r), complexOne, complexZero, complexLinearList(rest) with *
    rw [complexLinearList, length.cons, ← ih.right]
    exact data

theorem complexLinearList.value (z : Set) (rs : List(ℂ))
  requires element : z ∈ ℂ
  shows hornerAt{ℂ}(complexAdd, complexMul, ℂ[1], z, complexLinearList(rs))
    = complexLinearProduct(rs, z)
proof
  have ring := complexes.comm_ring
  have oneIn : ℂ[1] ∈ ℂ by typecheck
  have zeroIn : ℂ[0] ∈ ℂ by typecheck
  induction rs
  | List.nil =>
    rw [complexLinearList, complexLinearProduct]
    exact hornerAt.nil
  | List.cons(r, rest) using ih =>
    have center : r ∈ ℂ by assumption
    have negIn : ℂ[-r] ∈ ℂ by typecheck
    have restIn : List(ℂ, rest) by assumption
    have restData := complexLinearList.data at rest with restIn
    have restList := restData.left
    have productIn := complexLinearProduct.member at z, rest with element
    have expansion := hornerTranslate.affine_value at complexCarrier,
      complexAdd, complexZero, complexNeg, complexMul, complexOne, complexOne,
      complexNeg(r), z, complexZero, complexLinearList(rest) with *
    rw [complexLinearList, complexLinearProduct, expansion, ih]
    ring

-- A finite cover of ℂ by a list would give ∏ (X − x) + 1 no root.
theorem complexes.infinite
  shows ¬Finite(ℂ)
proof
  have ring := complexes.comm_ring
  have nontrivial := complexes.nontrivial
  have distinct := Nontrivial.distinct with nontrivial
  have oneIn : ℂ[1] ∈ ℂ by typecheck
  have zeroIn : ℂ[0] ∈ ℂ by typecheck
  have oneNonzero : ℂ[1] ≠ ℂ[0]
    intro equal
    apply distinct
    symm
    exact equal
  intro finite
  obtain ⟨xs, list, cover⟩ := Finite.list_cover with finite
  have data := complexLinearList.data at xs with list
  have lsList := data.left
  have shape := List.cases at complexCarrier, complexLinearList(xs) with lsList
  cases shape with empty | cons
  . have zeroCovered := cover with zeroIn
    have emptyLength : length{ℂ}(xs) = (0 : Nat)
      rw [← data.right, empty]
      exact length.nil
    have xsEmpty := length.eq_zero with list, emptyLength
    rw [xsEmpty, listSupport.nil] at zeroCovered
    exact empty.membership with zeroCovered
  . obtain ⟨c, cIn, tail, tailList, equal⟩ := cons
    have headIn : ℂ[c + 1] ∈ ℂ by typecheck
    have nonconstant := List.cons_ne_nil at complexCarrier, ℂ[c + 1], tail
      with tailList, headIn
    obtain ⟨a, aIn, root⟩ :=
      complexes.fundamental_theorem_of_algebra_general at ℂ[1],
        ℂ[c + 1] :: tail with oneIn, oneNonzero, nonconstant
    have value := complexLinearList.value at a, xs with aIn
    rw equal at value
    have covered := cover with aIn
    have vanish := (complexLinearProduct.zero_iff at a, xs with aIn).backward
      with covered
    rw hornerAt.cons at root
    rw hornerAt.cons at value
    have tailIn := hornerAt.closed at complexCarrier, complexAdd, complexZero,
      complexNeg, complexMul, complexOne, complexOne, a, tail with ring, oneIn,
      aIn
    apply distinct
    linear_combination value + vanish - root

-- Every pair with nonzero leading coefficient splits into linear factors,
-- by induction on the declared degree with the factor theorem.
theorem complexes.linear_factorization_of_length (a : Set) (n : Nat)
  (cs : List(ℂ))
  requires leading : a ∈ ℂ
  requires nonzero : a ≠ ℂ[0]
  requires size : length{ℂ}(cs) = n
  shows ∃ rs, List(ℂ, rs) ∧ length{ℂ}(rs) = length{ℂ}(cs) ∧
    ∀ z ∈ ℂ, hornerAt{ℂ}(complexAdd, complexMul, a, z, cs) =
      ℂ[a * complexLinearProduct(rs, z)]
proof
  have ring := complexes.comm_ring
  induction n generalizing cs
  | zero =>
    intros cs csList size
    have empty := length.eq_zero with csList, size
    have emptyList : List(ℂ, []) by typecheck
    refine ⟨[], emptyList, ?_, ?_⟩
    . rw empty
      rfl
    . intros z zIn
      rw [empty, complexLinearProduct, hornerAt.nil]
      ring
  | succ(k) using ih =>
    intros cs csList size
    have nonconstant : cs ≠ []
      intro empty
      rw [empty, length.nil] at size
      exact Naturals.disjoint.zero.succ at k with size
    obtain ⟨r, rIn, root⟩ :=
      complexes.fundamental_theorem_of_algebra_general at a, cs with leading,
        nonzero, nonconstant
    have shape := List.cases at complexCarrier, cs with csList
    cases shape with empty | cons
    . exfalso
      exact nonconstant with empty
    . obtain ⟨c, cIn, tail, tailList, equal⟩ := cons
      rw equal at root
      have quotientList := hornerQuotient.closed at complexCarrier, complexAdd,
        complexZero, complexNeg, complexMul, complexOne, a, r, tail with *
      have quotientLength := hornerQuotient.length at complexCarrier,
        complexAdd, complexZero, complexNeg, complexMul, complexOne, a, r, tail
        with *
      have tailSize : length{ℂ}(tail) = k
        rw [equal, length.cons] at size
        exact Naturals.injective.succ with size
      have quotientSize : length{ℂ}(hornerQuotient{ℂ}(complexAdd,
          complexMul, a, r, tail)) = k
        rw [quotientLength, tailSize]
        rfl
      obtain ⟨rs, rsList, rsLength, factored⟩ := ih with quotientList,
        quotientSize
      have consList : List(ℂ, r :: rs) by typecheck
      refine ⟨r :: rs, consList, ?_, ?_⟩
      . rw [equal, length.cons, length.cons, rsLength, quotientLength,
          tailSize]
        rfl
      . intros z zIn
        have division := factor.theorem at complexCarrier, complexAdd,
          complexZero, complexNeg, complexMul, complexOne, a, r, z, c, tail
          with ring, leading, rIn, zIn, cIn, root
        have quotientValue := factored with z, zIn
        have productIn := complexLinearProduct.member at z, rs with zIn
        rw [equal, division, quotientValue, complexLinearProduct]
        ring

-- Every pair with nonzero leading coefficient splits into linear factors.
theorem complexes.linear_factorization (a : Set) (cs : List(ℂ))
  requires leading : a ∈ ℂ
  requires nonzero : a ≠ ℂ[0]
  shows ∃ rs, List(ℂ, rs) ∧ length{ℂ}(rs) = length{ℂ}(cs) ∧
    ∀ z ∈ ℂ, hornerAt{ℂ}(complexAdd, complexMul, a, z, cs) =
      ℂ[a * complexLinearProduct(rs, z)]
proof
  have size : length{ℂ}(cs) = length{ℂ}(cs) by rfl
  exact complexes.linear_factorization_of_length with *

theorem complexValueProduct.member (b : Set) (ds rs : List(ℂ))
  requires leading : b ∈ ℂ
  shows complexValueProduct(b, ds, rs) ∈ ℂ
proof
  have ring := complexes.comm_ring
  induction rs
  | List.nil =>
    rw complexValueProduct
    typecheck
  | List.cons(r, rest) using ih =>
    have center : r ∈ ℂ by assumption
    have valueIn := hornerAt.closed at complexCarrier, complexAdd, complexZero,
      complexNeg, complexMul, complexOne, b, r, ds with ring, leading, center
    rw complexValueProduct
    typecheck

-- The product of the values vanishes exactly at a root of q among rs.
theorem complexValueProduct.zero_iff (b : Set) (ds rs : List(ℂ))
  requires leading : b ∈ ℂ
  shows complexValueProduct(b, ds, rs) = ℂ[0] ↔
    ∃ r ∈ listSupport{ℂ}(rs),
      hornerAt{ℂ}(complexAdd, complexMul, b, r, ds) = ℂ[0]
proof
  have ring := complexes.comm_ring
  have field := complexes.is_field
  have nontrivial := complexes.nontrivial
  have distinct := Nontrivial.distinct with nontrivial
  have noZeroDivisors := IsField.no_zero_divisors with field
  unfold NoZeroDivisors at noZeroDivisors
  induction rs
  | List.nil =>
    rw [complexValueProduct, listSupport.nil]
    constructor
    . intro vanish
      exfalso
      apply distinct
      symm
      exact vanish
    . intro witness
      obtain ⟨r, member, vanish⟩ := witness
      exfalso
      exact empty.membership with member
  | List.cons(r, rest) using ih =>
    have center : r ∈ ℂ by assumption
    have restList : List(ℂ, rest) by assumption
    have valueIn := hornerAt.closed at complexCarrier, complexAdd, complexZero,
      complexNeg, complexMul, complexOne, b, r, ds with ring, leading, center
    have productIn := complexValueProduct.member at b, ds, rest with leading
    rw [complexValueProduct, listSupport.cons]
    constructor
    . intro vanish
      have firstBinder := noZeroDivisors with valueIn
      have secondBinder := firstBinder with productIn
      have split := secondBinder with vanish
      cases split with first | second
      . have member : r ∈ insert(r, listSupport{ℂ}(rest))
          rw insert.membership
          left
          rfl
        refine ⟨r, member, first⟩
      . obtain ⟨s, sMember, sVanish⟩ := ih.forward with second
        have member : s ∈ insert(r, listSupport{ℂ}(rest))
          rw insert.membership
          right
          exact sMember
        refine ⟨s, member, sVanish⟩
    . intro witness
      obtain ⟨s, sMember, sVanish⟩ := witness
      rw insert.membership at sMember
      cases sMember with same | inside
      . rw same at sVanish
        rw sVanish
        ring
      . have vanish := ih.backward with ⟨s, inside, sVanish⟩
        rw vanish
        ring

-- The resultant is aⁿ times the product of q over the roots of p: by
-- induction on the roots, the pair is (X − r)·(a, a·ls) with ls the
-- linear list of the remaining roots, and resultant.linear_factor peels
-- off q(r).
theorem resultant.roots_formula (a b : Set) (cs ds rs : List(ℂ))
  requires leftLeading : a ∈ ℂ
  requires rightLeading : b ∈ ℂ
  requires factorization : ∀ z ∈ ℂ,
    hornerAt{ℂ}(complexAdd, complexMul, a, z,
      cs) = ℂ[a * complexLinearProduct(rs, z)]
  requires count : length{ℂ}(rs) = length{ℂ}(cs)
  shows resultant(ℂ, a, cs, b, ds) =
    ℂ[monoidPow(ℂ, a, length{ℂ}(ds)) * complexValueProduct(b, ds, rs)]
proof
  induction rs generalizing cs
  | List.nil =>
    intros cs csList factorization count
    have ring := complexes.comm_ring
    have ordinary := IsCommRing.ring with ring
    have multiplicative := IsRing.multiplicative with ordinary
    have powerIn := monoidPow.closed at complexCarrier, complexMul,
      complexOne, a, length{ℂ}(ds) with multiplicative, leftLeading
    rw length.nil at count
    have symmetric : length{ℂ}(cs) = (0 : Nat) by cc
    have empty := length.eq_zero with csList, symmetric
    have constant := resultant.constant_left at complexCarrier, complexAdd,
      complexZero, complexNeg, complexMul, complexOne, a, b, ds with ring,
      leftLeading, rightLeading
    rw [empty, complexValueProduct, constant]
    ring
  | List.cons(r, rest) using ih =>
    intros cs csList factorization count
    have ring := complexes.comm_ring
    have ordinary := IsCommRing.ring with ring
    have multiplicative := IsRing.multiplicative with ordinary
    have field := complexes.is_field
    have domain := IsField.integral_domain with field
    have infinite := complexes.infinite
    have oneIn : ℂ[1] ∈ ℂ by typecheck
    have zeroIn : ℂ[0] ∈ ℂ by typecheck
    have powerIn := monoidPow.closed at complexCarrier, complexMul,
      complexOne, a, length{ℂ}(ds) with multiplicative, leftLeading
    have center : r ∈ ℂ by assumption
    have restList : List(ℂ, rest) by assumption
    have negIn : ℂ[-r] ∈ ℂ by typecheck
    have lsData := complexLinearList.data at rest with restList
    have lsList := lsData.left
    have scaledData := hornerScale.data at complexCarrier, complexAdd,
      complexZero, complexNeg, complexMul, complexOne, a,
      complexLinearList(rest) with lsList, ring, leftLeading
    have scaledList := scaledData.left
    have quotientValues : ∀ z ∈ ℂ,
        hornerAt{ℂ}(complexAdd, complexMul, a, z,
          hornerScale{ℂ}(complexMul, a, complexLinearList(rest))) =
        ℂ[a * complexLinearProduct(rest, z)]
      intros z zIn
      have scaled := hornerScale.value at complexCarrier, complexAdd,
        complexZero, complexNeg, complexMul, complexOne, a, ℂ[1], z,
        complexLinearList(rest) with lsList, ring, leftLeading, oneIn, zIn
      have unit : ℂ[a * 1] = a by ring
      have value := complexLinearList.value at z, rest with zIn
      rw [unit, value] at scaled
      exact scaled
    have quotientCount : length{ℂ}(rest) =
        length{ℂ}(hornerScale{ℂ}(complexMul, a, complexLinearList(rest)))
      rw [scaledData.right, lsData.right]
      rfl
    have quotientFormula := ih with scaledList, quotientValues, quotientCount
    have affineData := hornerAffineProduct.data at complexCarrier, complexAdd,
      complexZero, complexNeg, complexMul, complexOne, a, complexNeg(r),
      complexOne, complexZero,
      hornerScale{ℂ}(complexMul, a, complexLinearList(rest)) with *
    have affineList := affineData.left
    have sameLength : length{ℂ}(cs) =
        length{ℂ}(hornerAffineProduct{ℂ}(complexAdd, complexMul, a,
          complexNeg(r), complexOne, complexZero,
          hornerScale{ℂ}(complexMul, a, complexLinearList(rest))))
      rw [affineData.right, ← quotientCount, ← count, length.cons]
      rfl
    have sameValues : ∀ z ∈ ℂ,
        hornerAt{ℂ}(complexAdd, complexMul, a, z, cs) =
        hornerAt{ℂ}(complexAdd, complexMul, a, z,
          hornerAffineProduct{ℂ}(complexAdd, complexMul, a, complexNeg(r),
            complexOne, complexZero,
            hornerScale{ℂ}(complexMul, a, complexLinearList(rest))))
      intros z zIn
      have expansion := hornerTranslate.affine_value at complexCarrier,
        complexAdd, complexZero, complexNeg, complexMul, complexOne, a,
        complexNeg(r), z, complexZero,
        hornerScale{ℂ}(complexMul, a, complexLinearList(rest)) with
        scaledList, ring, leftLeading, negIn, zIn, zeroIn
      have quotientValue := quotientValues with z, zIn
      have productIn := complexLinearProduct.member at z, rest with zIn
      have factored := factorization with z, zIn
      rw [expansion, quotientValue, factored, complexLinearProduct]
      ring
    have samePoly := hornerPoly.eq_of_values at complexCarrier, complexAdd,
      complexZero, complexNeg, complexMul, complexOne, a, a, cs,
      hornerAffineProduct{ℂ}(complexAdd, complexMul, a, complexNeg(r),
        complexOne, complexZero,
        hornerScale{ℂ}(complexMul, a, complexLinearList(rest))) with csList,
      affineList, domain, infinite, leftLeading, leftLeading, sameValues
    have sameList := hornerPoly.list_unique at complexCarrier, complexAdd,
      complexZero, complexNeg, complexMul, complexOne, a, cs,
      hornerAffineProduct{ℂ}(complexAdd, complexMul, a, complexNeg(r),
        complexOne, complexZero,
        hornerScale{ℂ}(complexMul, a, complexLinearList(rest))) with csList,
      affineList, ring, leftLeading, sameLength, samePoly
    have factor := resultant.linear_factor at complexCarrier, complexAdd,
      complexZero, complexNeg, complexMul, complexOne, a, b, r,
      hornerScale{ℂ}(complexMul, a, complexLinearList(rest)), ds with ring,
      leftLeading, rightLeading, center
    have valueIn := hornerAt.closed at complexCarrier, complexAdd, complexZero,
      complexNeg, complexMul, complexOne, b, r, ds with ring, rightLeading,
      center
    have productIn := complexValueProduct.member at b, ds, rest with
      rightLeading
    rw [sameList, factor, quotientFormula, complexValueProduct]
    ring

theorem resultant.zero_iff_common_root_complex (a b : Set) (cs ds : List(ℂ))
  requires leftLeading : a ∈ ℂ
  requires rightLeading : b ∈ ℂ
  requires leftNonzero : a ≠ ℂ[0]
  requires rightNonzero : b ≠ ℂ[0]
  shows resultant(ℂ, a, cs, b, ds) = ℂ[0] ↔
    ∃ z ∈ ℂ, hornerAt{ℂ}(complexAdd, complexMul, a, z, cs) = ℂ[0] ∧
      hornerAt{ℂ}(complexAdd, complexMul, b, z, ds) = ℂ[0]
proof
  have ring := complexes.comm_ring
  have ordinary := IsCommRing.ring with ring
  have multiplicative := IsRing.multiplicative with ordinary
  have field := complexes.is_field
  have noZeroDivisors := IsField.no_zero_divisors with field
  unfold NoZeroDivisors at noZeroDivisors
  have powerIn := monoidPow.closed at complexCarrier, complexMul, complexOne,
    a, length{ℂ}(ds) with multiplicative, leftLeading
  have powerNonzero := IsField.power_nonzero at complexCarrier, complexAdd,
    complexZero, complexNeg, complexMul, complexOne, a, length{ℂ}(ds) with
    field, leftLeading, leftNonzero
  obtain ⟨rs, rsList, rsLength, factorization⟩ :=
    complexes.linear_factorization at a, cs with leftLeading, leftNonzero
  have formula := resultant.roots_formula at a, b, cs, ds, rs with
    leftLeading, rightLeading, factorization, rsLength
  have productIn := complexValueProduct.member at b, ds, rs with rightLeading
  have support := listSupport.subset at complexCarrier, rs
  constructor
  . intro vanish
    rw formula at vanish
    have firstBinder := noZeroDivisors with powerIn
    have secondBinder := firstBinder with productIn
    have split := secondBinder with vanish
    cases split with powerZero | productZero
    . exfalso
      exact powerNonzero with powerZero
    . obtain ⟨r, member, rootQ⟩ :=
        (complexValueProduct.zero_iff at b, ds, rs with rightLeading).forward
        with productZero
      have rIn : r ∈ ℂ := support with member
      have zeroIff := complexLinearProduct.zero_iff at r, rs with rIn
      have linearZero := zeroIff.backward with member
      have factored := factorization with r, rIn
      have rootP : hornerAt{ℂ}(complexAdd, complexMul, a, r, cs) = ℂ[0]
        rw [factored, linearZero]
        ring
      refine ⟨r, rIn, rootP, rootQ⟩
  . intro witness
    obtain ⟨z, zIn, rootP, rootQ⟩ := witness
    have positive : 0 < length{ℂ}(cs) + length{ℂ}(ds)
      have nonconstant : cs ≠ []
        intro empty
        rw [empty, hornerAt.nil] at rootP
        exact leftNonzero with rootP
      have csPositive := length.positive_of_ne_nil at complexCarrier, cs with
        nonconstant
      arith
    exact resultant.eq_zero_of_common_root at complexCarrier, complexAdd,
      complexZero, complexNeg, complexMul, complexOne, a, b, z, cs, ds with
      ring, leftLeading, rightLeading, positive, zIn, rootP, rootQ

theorem realResultant.complex (a b : Real) (cs ds : List(ℝ))
  shows complexOfReal(resultant(R, a, cs, b, ds)) =
    resultant(ℂ, complexOfReal(a), listMap{ℝ}(complexOfReal, cs),
      complexOfReal(b), listMap{ℝ}(complexOfReal, ds))
proof
  have source := reals.comm_ring
  have target := complexes.comm_ring
  have hom := complexOfReal.hom
  have aIn : a ∈ ℝ by simp [Real]
  have bIn : b ∈ ℝ by simp [Real]
  exact resultant.map at ℝ, realAdd, realZero, realNeg, realMul, realOne,
    complexCarrier, complexAdd, complexZero, complexNeg, complexMul,
    complexOne, complexOfReal, a, b, cs, ds with source, target, hom, aIn, bIn

-- The real resultant vanishes exactly at a common complex root.
theorem realResultant.zero_iff_common_complex_root (a b : Real)
  (cs ds : List(ℝ))
  requires leftNonzero : a ≠ (0:R)
  requires rightNonzero : b ≠ (0:R)
  shows resultant(R, a, cs, b, ds) = (0:R) ↔
    ∃ z ∈ ℂ, hornerAt{ℂ}(complexAdd, complexMul, complexOfReal(a), z,
      listMap{ℝ}(complexOfReal, cs)) = ℂ[0] ∧
      hornerAt{ℂ}(complexAdd, complexMul, complexOfReal(b), z,
        listMap{ℝ}(complexOfReal, ds)) = ℂ[0]
proof
  have source := reals.comm_ring
  have function := complexOfReal.function
  have aIn : a ∈ ℝ by simp [Real]
  have bIn : b ∈ ℝ by simp [Real]
  have zeroReal : Real((0:R)) := realZero.real
  have aImage := FunctionBetween.apply_closed at complexOfReal, ℝ,
    complexCarrier, a with function, aIn
  have bImage := FunctionBetween.apply_closed at complexOfReal, ℝ,
    complexCarrier, b with function, bIn
  have zero := complexOfReal.zero
  have aNonzero : complexOfReal(a) ≠ ℂ[0]
    intro equal
    rw ← zero at equal
    exact leftNonzero with (complexOfReal.injective with equal)
  have bNonzero : complexOfReal(b) ≠ ℂ[0]
    intro equal
    rw ← zero at equal
    exact rightNonzero with (complexOfReal.injective with equal)
  have csList := complexOfReal.list at cs
  have dsList := complexOfReal.list at ds
  have complexIff := resultant.zero_iff_common_root_complex at
    complexOfReal(a), complexOfReal(b), listMap{ℝ}(complexOfReal, cs),
    listMap{ℝ}(complexOfReal, ds) with aImage, bImage, aNonzero, bNonzero
  have transported := realResultant.complex at a, b, cs, ds
  have resultantIn := resultant.closed at ℝ, realAdd, realZero, realNeg,
    realMul, realOne, a, b, cs, ds with source, aIn, bIn
  have resultantReal : Real(resultant(R, a, cs, b, ds)) by exact resultantIn
  rw [← complexIff, ← transported]
  constructor
  . intro vanish
    rw vanish
    exact zero
  . intro vanish
    rw ← zero at vanish
    exact complexOfReal.injective with vanish

end Complexes
