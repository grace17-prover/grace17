-- The number of sign variations of a finite list of reals, ignoring
-- zeros: the count of consecutive nonzero entries of opposite signs,
-- with its recursion laws, invariance under removing zeros, negation, and
-- positive scaling, and its bound by the length.
-- Part of the CAD blueprint.
-- Planned home: Real/SignVariations.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module CAD.SignVariations
import CAD.RealSign
import Grace.Cumulus.List.Filter
import Grace.Cumulus.Nat.Mod

def nonzeroReals : Set := { X ∈ ℝ | X ≠ (0:R) }
def negativeReals : Set := { X ∈ ℝ | X < (0:R) }

-- 1 when the product of the previous and the current entry is negative.
def signChangeIndicator (P X : Set) : Nat :=
  chooseNat(memberTest(negativeReals, realMulValue(P, X)), 1, 0)

def signChangesFrom (P : Set) (xs : List(ℝ)) → Nat
  | P, List.nil => 0
  | P, List.cons(X, rest) =>
      signChangeIndicator(P, X) + signChangesFrom(X, rest)
  descends xs

def signVariations (xs : List(ℝ)) : Nat :=
  signChangesFrom(realZero, listFilter{ℝ}(nonzeroReals, xs))

theorem nonzeroReals.of_nonzero (X : Real)
  requires nonzero : X ≠ 0
  shows X ∈ nonzeroReals
proof
  have inReals : X ∈ ℝ by simp [Real]
  apply nonzeroReals.membership.backward
  exact ⟨inReals, nonzero⟩

theorem nonzeroReals.nonzero (X : Set)
  requires member : X ∈ nonzeroReals
  shows X ≠ (0:R)
proof
  obtain ⟨inReals, nonzero⟩ := nonzeroReals.membership.forward with member
  exact nonzero

theorem nonzeroReals.not_zero
  shows ¬((0:R) ∈ nonzeroReals)
proof
  intro member
  obtain ⟨inReals, nonzero⟩ := nonzeroReals.membership.forward with member
  exact nonzero with rfl

theorem signChangeIndicator.one_iff (P X : Real)
  shows signChangeIndicator(P, X) = 1 ↔ P * X < 0
proof
  have productReal : Real(P * X) by typecheck
  have inReals : P * X ∈ ℝ by simp [Real]
  have same : realMulValue(P, X) = P * X by ring
  have alternatives : P * X < 0 ∨ ¬(P * X < 0) by tauto
  cases alternatives with negative | nonnegative
  . have member : P * X ∈ negativeReals
      apply negativeReals.membership.backward
      exact ⟨inReals, negative⟩
    have test := memberTest.true with member
    have value : signChangeIndicator(P, X) = 1
      unfold signChangeIndicator
      rw [same, test]
      simp [chooseNat]
    rw value
    constructor
    . intro one
      exact negative
    . intro less
      rfl
  . have absent : ¬(P * X ∈ negativeReals)
      intro member
      obtain ⟨real, negative⟩ := negativeReals.membership.forward with member
      exact nonnegative with negative
    have test := memberTest.false with absent
    have value : signChangeIndicator(P, X) = 0
      unfold signChangeIndicator
      rw [same, test]
      simp [chooseNat]
    rw value
    constructor
    . intro zeroOne
      exfalso
      arith
    . intro negative
      exfalso
      exact nonnegative with negative

theorem signChangeIndicator.zero_iff (P X : Real)
  shows signChangeIndicator(P, X) = 0 ↔ 0 ≤ P * X
proof
  have productReal : Real(P * X) by typecheck
  have inReals : P * X ∈ ℝ by simp [Real]
  have same : realMulValue(P, X) = P * X by ring
  have alternatives : P * X < 0 ∨ ¬(P * X < 0) by tauto
  cases alternatives with negative | nonnegative
  . have member : P * X ∈ negativeReals
      apply negativeReals.membership.backward
      exact ⟨inReals, negative⟩
    have test := memberTest.true with member
    have value : signChangeIndicator(P, X) = 1
      unfold signChangeIndicator
      rw [same, test]
      simp [chooseNat]
    rw value
    constructor
    . intro oneZero
      exfalso
      arith
    . intro nonneg
      exfalso
      linarith
  . have absent : ¬(P * X ∈ negativeReals)
      intro member
      obtain ⟨real, negative⟩ := negativeReals.membership.forward with member
      exact nonnegative with negative
    have test := memberTest.false with absent
    have value : signChangeIndicator(P, X) = 0
      unfold signChangeIndicator
      rw [same, test]
      simp [chooseNat]
    rw value
    constructor
    . intro zero
      exact realLe.of_not_less with nonnegative
    . intro nonneg
      rfl

theorem signChangeIndicator.le_one (P X : Real)
  shows signChangeIndicator(P, X) ≤ 1
proof
  have productReal : Real(P * X) by typecheck
  have alternatives : P * X < 0 ∨ ¬(P * X < 0) by tauto
  cases alternatives with negative | nonnegative
  . have value := signChangeIndicator.one_iff.backward with negative
    rw value
    arith
  . have nonneg := realLe.of_not_less with nonnegative
    have value := signChangeIndicator.zero_iff.backward with nonneg
    rw value
    arith

theorem signChangeIndicator.zero_left (X : Real)
  shows signChangeIndicator((0:R), X) = 0
proof
  have vanish : (0:R) * X = 0 by ring
  have nonneg : 0 ≤ (0:R) * X by linarith
  exact signChangeIndicator.zero_iff.backward with nonneg

-- The indicator depends on the sign of the product alone.
theorem signChangeIndicator.congr (P X Q Y : Real)
  requires same : realSign(P * X) = realSign(Q * Y)
  shows signChangeIndicator(P, X) = signChangeIndicator(Q, Y)
proof
  have firstReal : Real(P * X) by typecheck
  have secondReal : Real(Q * Y) by typecheck
  have alternatives : P * X < 0 ∨ ¬(P * X < 0) by tauto
  cases alternatives with negative | nonnegative
  . have firstSign := realSign.of_negative with negative
    rw firstSign at same
    symm at same
    have secondNegative := realSign.eq_neg_one_iff.forward with same
    have first := signChangeIndicator.one_iff.backward with negative
    have second := signChangeIndicator.one_iff.backward with secondNegative
    rw [first, second]
    rfl
  . have firstNonneg := realLe.of_not_less with nonnegative
    have secondNonneg : 0 ≤ Q * Y
      have split : Q * Y < 0 ∨ ¬(Q * Y < 0) by tauto
      cases split with secondNegative | secondNonnegative
      . have secondSign := realSign.of_negative with secondNegative
        rw secondSign at same
        have firstNegative := realSign.eq_neg_one_iff.forward with same
        exfalso
        linarith
      . exact realLe.of_not_less with secondNonnegative
    have first := signChangeIndicator.zero_iff.backward with firstNonneg
    have second := signChangeIndicator.zero_iff.backward with secondNonneg
    rw [first, second]
    rfl

theorem signChangesFrom.nil (P : Set)
  shows signChangesFrom(P, []) = 0
proof
  simp [signChangesFrom]

theorem signChangesFrom.cons (P X : Set) (xs : List(ℝ))
  requires element : X ∈ ℝ
  shows signChangesFrom(P, X :: xs) =
    signChangeIndicator(P, X) + signChangesFrom(X, xs)
proof
  simp [signChangesFrom]

-- Starting points of the same sign count the same changes.
theorem signChangesFrom.congr_head (P Q : Real) (xs : List(ℝ))
  requires same : realSign(P) = realSign(Q)
  shows signChangesFrom(P, xs) = signChangesFrom(Q, xs)
proof
  have shape := List.cases at ℝ, xs with *
  cases shape with empty | nonempty
  . rw [empty, signChangesFrom.nil, signChangesFrom.nil]
    rfl
  . obtain ⟨a, element, tail, tailList, equal⟩ := nonempty
    have aReal : Real(a) by exact element
    have products : realSign(P * a) = realSign(Q * a)
      rw [realSign.mul, realSign.mul, same]
      rfl
    have heads := signChangeIndicator.congr with products
    rw [equal, signChangesFrom.cons, signChangesFrom.cons, heads]
    rfl

theorem signChangesFrom.le_length (P : Real) (xs : List(ℝ))
  shows signChangesFrom(P, xs) ≤ length{ℝ}(xs)
proof
  induction xs generalizing P
  | List.nil =>
    intros P pReal
    rw [signChangesFrom.nil, length.nil]
    arith
  | List.cons(a, tail) using ih =>
    intros P pReal
    have element : a ∈ ℝ by assumption
    have aReal : Real(a) by exact element
    have head := signChangeIndicator.le_one at P, a with *
    have rest := ih with a, aReal
    have count : Nat(signChangesFrom(a, tail)) by typecheck
    have lengthNat : Nat(length{ℝ}(tail)) by typecheck
    rw [signChangesFrom.cons, length.cons]
    arith

theorem signVariations.nil
  shows signVariations([]) = 0
proof
  unfold signVariations
  rw [listFilter.nil, signChangesFrom.nil]
  rfl

theorem signVariations.singleton (X : Real)
  shows signVariations(X :: []) = 0
proof
  have element : X ∈ ℝ by simp [Real]
  have nilList : List(ℝ, []) by typecheck
  have alternatives : X = 0 ∨ X ≠ 0 by tauto
  unfold signVariations
  cases alternatives with zero | nonzero
  . have absent : ¬(X ∈ nonzeroReals)
      rw zero
      exact nonzeroReals.not_zero
    rw [listFilter.singleton_other, signChangesFrom.nil]
    rfl
  . have member := nonzeroReals.of_nonzero with nonzero
    have head := signChangeIndicator.zero_left at X with *
    rw [listFilter.singleton_member, signChangesFrom.cons, signChangesFrom.nil,
      head]
    arith

-- Zeros are ignored wherever they stand.
theorem signVariations.cons_zero (xs : List(ℝ))
  shows signVariations((0:R) :: xs) = signVariations(xs)
proof
  have element : (0:R) ∈ ℝ := realZero.real
  have absent := nonzeroReals.not_zero
  unfold signVariations
  rw listFilter.cons_other
  rfl

theorem signVariations.filter (xs : List(ℝ))
  shows signVariations(listFilter{ℝ}(nonzeroReals, xs)) = signVariations(xs)
proof
  unfold signVariations
  rw listFilter.idempotent
  rfl

theorem signVariations.cons_cons_same (X Y : Real) (xs : List(ℝ))
  requires same : 0 < X * Y
  shows signVariations(X :: Y :: xs) = signVariations(Y :: xs)
proof
  have xElement : X ∈ ℝ by simp [Real]
  have yElement : Y ∈ ℝ by simp [Real]
  have xNonzero : X ≠ 0
    intro zero
    rw zero at same
    have vanish : (0:R) * Y = 0 by ring
    linarith
  have yNonzero : Y ≠ 0
    intro zero
    rw zero at same
    have vanish : X * (0:R) = 0 by ring
    linarith
  have xMember := nonzeroReals.of_nonzero with xNonzero
  have yMember := nonzeroReals.of_nonzero with yNonzero
  have tailList : List(ℝ, Y :: xs) by typecheck
  have filtered := listFilter.closed at ℝ, nonzeroReals, xs with *
  have innerList : List(ℝ, Y :: listFilter{ℝ}(nonzeroReals, xs)) by typecheck
  have nonneg : 0 ≤ X * Y by linarith
  have middle := signChangeIndicator.zero_iff.backward with nonneg
  have headX := signChangeIndicator.zero_left at X with *
  have headY := signChangeIndicator.zero_left at Y with *
  have count : Nat(signChangesFrom(Y, listFilter{ℝ}(nonzeroReals, xs)))
    typecheck
  unfold signVariations
  rw [listFilter.cons_member, listFilter.cons_member, signChangesFrom.cons,
    signChangesFrom.cons, signChangesFrom.cons, middle, headX, headY]
  arith

theorem signVariations.cons_cons_opposite (X Y : Real) (xs : List(ℝ))
  requires opposite : X * Y < 0
  shows signVariations(X :: Y :: xs) = signVariations(Y :: xs) + 1
proof
  have xElement : X ∈ ℝ by simp [Real]
  have yElement : Y ∈ ℝ by simp [Real]
  have xNonzero : X ≠ 0
    intro zero
    rw zero at opposite
    have vanish : (0:R) * Y = 0 by ring
    linarith
  have yNonzero : Y ≠ 0
    intro zero
    rw zero at opposite
    have vanish : X * (0:R) = 0 by ring
    linarith
  have xMember := nonzeroReals.of_nonzero with xNonzero
  have yMember := nonzeroReals.of_nonzero with yNonzero
  have tailList : List(ℝ, Y :: xs) by typecheck
  have filtered := listFilter.closed at ℝ, nonzeroReals, xs with *
  have innerList : List(ℝ, Y :: listFilter{ℝ}(nonzeroReals, xs)) by typecheck
  have middle := signChangeIndicator.one_iff.backward with opposite
  have headX := signChangeIndicator.zero_left at X with *
  have headY := signChangeIndicator.zero_left at Y with *
  have count : Nat(signChangesFrom(Y, listFilter{ℝ}(nonzeroReals, xs)))
    typecheck
  unfold signVariations
  rw [listFilter.cons_member, listFilter.cons_member, signChangesFrom.cons,
    signChangesFrom.cons, signChangesFrom.cons, middle, headX, headY]
  arith

theorem signVariations.cons_cons_zero (X Y : Real) (xs : List(ℝ))
  shows signVariations(X :: (0:R) :: Y :: xs) = signVariations(X :: Y :: xs)
proof
  have xElement : X ∈ ℝ by simp [Real]
  have yElement : Y ∈ ℝ by simp [Real]
  have zeroElement : (0:R) ∈ ℝ := realZero.real
  have absent := nonzeroReals.not_zero
  have shortList : List(ℝ, Y :: xs) by typecheck
  have longList : List(ℝ, (0:R) :: Y :: xs) by typecheck
  have inner : listFilter{ℝ}(nonzeroReals, (0:R) :: Y :: xs) =
      listFilter{ℝ}(nonzeroReals, Y :: xs)
    exact listFilter.cons_other with zeroElement, absent
  have alternatives : X ∈ nonzeroReals ∨ ¬(X ∈ nonzeroReals) by tauto
  unfold signVariations
  cases alternatives with member | other
  . have left : listFilter{ℝ}(nonzeroReals, X :: (0:R) :: Y :: xs) =
        X :: listFilter{ℝ}(nonzeroReals, (0:R) :: Y :: xs)
      exact listFilter.cons_member at ℝ, nonzeroReals, X, (0:R) :: Y :: xs
        with *
    have right : listFilter{ℝ}(nonzeroReals, X :: Y :: xs) =
        X :: listFilter{ℝ}(nonzeroReals, Y :: xs)
      exact listFilter.cons_member at ℝ, nonzeroReals, X, Y :: xs with *
    rw [left, right, inner]
    rfl
  . have left : listFilter{ℝ}(nonzeroReals, X :: (0:R) :: Y :: xs) =
        listFilter{ℝ}(nonzeroReals, (0:R) :: Y :: xs)
      exact listFilter.cons_other at ℝ, nonzeroReals, X, (0:R) :: Y :: xs
        with *
    have right : listFilter{ℝ}(nonzeroReals, X :: Y :: xs) =
        listFilter{ℝ}(nonzeroReals, Y :: xs)
      exact listFilter.cons_other at ℝ, nonzeroReals, X, Y :: xs with *
    rw [left, right, inner]
    rfl

theorem nonzeroReals.neg_iff (X : Real)
  shows -X ∈ nonzeroReals ↔ X ∈ nonzeroReals
proof
  have negReal : Real(-X) by typecheck
  constructor
  . intro member
    have nonzero := nonzeroReals.nonzero with member
    have xNonzero : X ≠ 0
      intro zero
      rw zero at nonzero
      have vanish : -(0:R) = 0 by ring
      exact nonzero with vanish
    exact nonzeroReals.of_nonzero with xNonzero
  . intro member
    have nonzero := nonzeroReals.nonzero with member
    have negNonzero : -X ≠ 0
      intro zero
      have recovered : X = 0 by linarith
      exact nonzero with recovered
    exact nonzeroReals.of_nonzero with negNonzero

theorem listFilter.map_neg (xs : List(ℝ))
  shows listFilter{ℝ}(nonzeroReals, listMap{ℝ}(realNeg, xs)) =
    listMap{ℝ}(realNeg, listFilter{ℝ}(nonzeroReals, xs))
proof
  have function := realNeg.function
  induction xs
  | List.nil =>
    rw [listMap.nil, listFilter.nil, listMap.nil]
    rfl
  | List.cons(a, tail) using ih =>
    have element : a ∈ ℝ by assumption
    have aReal : Real(a) by exact element
    have negElement : -a ∈ ℝ := FunctionBetween.apply_closed with function,
      element
    have mapped := listMap.closed at ℝ, ℝ, realNeg, tail with *
    have filtered := listFilter.closed at ℝ, nonzeroReals, tail with *
    have negIff := nonzeroReals.neg_iff at a with *
    have alternatives : a ∈ nonzeroReals ∨ ¬(a ∈ nonzeroReals) by tauto
    rw listMap.cons
    cases alternatives with member | other
    . have negMember := negIff.backward with member
      rw [listFilter.cons_member, listFilter.cons_member, listMap.cons, ih]
      rfl
    . have negOther : ¬(-a ∈ nonzeroReals)
        intro negMember
        exact other with (negIff.forward with negMember)
      rw [listFilter.cons_other, listFilter.cons_other, ih]
      rfl

theorem signChangesFrom.neg (P : Real) (xs : List(ℝ))
  shows signChangesFrom(-P, listMap{ℝ}(realNeg, xs)) = signChangesFrom(P, xs)
proof
  have function := realNeg.function
  induction xs generalizing P
  | List.nil =>
    intros P pReal
    rw [listMap.nil, signChangesFrom.nil, signChangesFrom.nil]
    rfl
  | List.cons(a, tail) using ih =>
    intros P pReal
    have element : a ∈ ℝ by assumption
    have aReal : Real(a) by exact element
    have negElement : -a ∈ ℝ := FunctionBetween.apply_closed with function,
      element
    have negReal : Real(-P) by typecheck
    have mapped := listMap.closed at ℝ, ℝ, realNeg, tail with *
    have products : realSign(-P * -a) = realSign(P * a)
      have shape : -P * -a = P * a by ring
      rw shape
      rfl
    have heads := signChangeIndicator.congr with products
    have rest := ih with a, aReal
    rw [listMap.cons, signChangesFrom.cons, signChangesFrom.cons, heads, rest]
    rfl

theorem signVariations.neg (xs : List(ℝ))
  shows signVariations(listMap{ℝ}(realNeg, xs)) = signVariations(xs)
proof
  have filtered := listFilter.closed at ℝ, nonzeroReals, xs with *
  have zeroReal : Real((0:R)) by typecheck
  have zeroNeg : -(0:R) = (0:R) by ring
  have negated := signChangesFrom.neg at (0:R), listFilter{ℝ}(nonzeroReals, xs)
    with *
  rw zeroNeg at negated
  unfold signVariations
  rw listFilter.map_neg
  exact negated

-- Two lists of the same length whose entries have the same signs give
-- the same count from starting points of the same sign.
theorem signChangesFrom.filter_congr (P Q : Real) (xs ys : List(ℝ))
  requires same : realSign(P) = realSign(Q)
  requires sameLength : length{ℝ}(xs) = length{ℝ}(ys)
  requires signs : ∀ k, Nat(k) → k < length{ℝ}(xs) →
    realSign(listCoefficient{ℝ}((0:R), xs,
      k)) = realSign(listCoefficient{ℝ}((0:R), ys, k))
  shows signChangesFrom(P, listFilter{ℝ}(nonzeroReals, xs)) =
    signChangesFrom(Q, listFilter{ℝ}(nonzeroReals, ys))
proof
  induction xs generalizing ys P Q
  | List.nil =>
    intros P Q ys pReal qReal ysList same sameLength signs
    rw length.nil at sameLength
    symm at sameLength
    have empty := length.eq_zero with sameLength
    rw [empty, listFilter.nil, signChangesFrom.nil, signChangesFrom.nil]
    rfl
  | List.cons(a, tail) using ih =>
    intros P Q ys pReal qReal ysList same sameLength signs
    have element : a ∈ ℝ by assumption
    have aReal : Real(a) by exact element
    have shape := List.cases at ℝ, ys with *
    cases shape with empty | nonempty
    . rw [empty, length.nil, length.cons] at sameLength
      exfalso
      arith
    . obtain ⟨b, bElement, rest, restList, equal⟩ := nonempty
      have bReal : Real(b) by exact bElement
      rw equal at sameLength
      rw [length.cons, length.cons] at sameLength
      have restLength : length{ℝ}(tail) = length{ℝ}(rest)
        have tailNat : Nat(length{ℝ}(tail)) by typecheck
        have restNat : Nat(length{ℝ}(rest)) by typecheck
        arith
      rw equal at signs
      have zeroNat : Nat(0) by typecheck
      have zeroLess : 0 < length{ℝ}(a :: tail)
        rw length.cons
        arith
      have heads := signs with 0, zeroNat, zeroLess
      rw [listCoefficient.zero, listCoefficient.zero] at heads
      have restSigns : ∀ k, Nat(k) → k < length{ℝ}(tail) →
        realSign(listCoefficient{ℝ}((0:R), tail,
          k)) = realSign(listCoefficient{ℝ}((0:R), rest, k))
        intros k kNat kLess
        have succLess : succ(k) < length{ℝ}(a :: tail)
          rw length.cons
          arith
        have succNat := Naturals.constructor.succ at k with kNat
        have step := signs with succ(k), succNat, succLess
        rw [listCoefficient.succ, listCoefficient.succ] at step
        exact step
      rw equal
      have alternatives : a = 0 ∨ a ≠ 0 by tauto
      cases alternatives with aZero | aNonzero
      . have aSign := realSign.of_zero with aZero
        rw aSign at heads
        symm at heads
        have bZero := realSign.eq_zero_iff.forward with heads
        have aAbsent : ¬(a ∈ nonzeroReals)
          rw aZero
          exact nonzeroReals.not_zero
        have bAbsent : ¬(b ∈ nonzeroReals)
          rw bZero
          exact nonzeroReals.not_zero
        rw [listFilter.cons_other, listFilter.cons_other]
        exact ih with P, Q, rest, pReal, qReal, restList, same, restLength,
          restSigns
      . have bNonzero : b ≠ 0
          intro bZero
          have bSign := realSign.of_zero with bZero
          rw bSign at heads
          have aZero := realSign.eq_zero_iff.forward with heads
          exact aNonzero with aZero
        have aMember := nonzeroReals.of_nonzero with aNonzero
        have bMember := nonzeroReals.of_nonzero with bNonzero
        have filteredTail := listFilter.closed at ℝ, nonzeroReals, tail with *
        have filteredRest := listFilter.closed at ℝ, nonzeroReals, rest with *
        have products : realSign(P * a) = realSign(Q * b)
          rw [realSign.mul, realSign.mul, same, heads]
          rfl
        have first := signChangeIndicator.congr with products
        have tails := ih with a, b, rest, aReal, bReal, restList, heads,
          restLength, restSigns
        rw [listFilter.cons_member, listFilter.cons_member,
          signChangesFrom.cons, signChangesFrom.cons, first, tails]
        rfl

-- The count depends on the signs of the entries alone.
theorem signVariations.congr_signs (xs ys : List(ℝ))
  requires sameLength : length{ℝ}(xs) = length{ℝ}(ys)
  requires signs : ∀ k, Nat(k) → k < length{ℝ}(xs) →
    realSign(listCoefficient{ℝ}((0:R), xs,
      k)) = realSign(listCoefficient{ℝ}((0:R), ys, k))
  shows signVariations(xs) = signVariations(ys)
proof
  have zeroReal : Real((0:R)) by typecheck
  have same : realSign((0:R)) = realSign((0:R)) by rfl
  unfold signVariations
  exact signChangesFrom.filter_congr at (0:R), (0:R), xs, ys with *

theorem signVariations.le_length (xs : List(ℝ))
  shows signVariations(xs) ≤ length{ℝ}(xs)
proof
  have zeroReal : Real((0:R)) by typecheck
  have filtered := listFilter.closed at ℝ, nonzeroReals, xs with *
  have count := signChangesFrom.le_length at (0:R),
    listFilter{ℝ}(nonzeroReals, xs) with *
  have shorter := listFilter.length_le at ℝ, nonzeroReals, xs with *
  have countNat : Nat(signChangesFrom((0:R), listFilter{ℝ}(nonzeroReals, xs)))
    typecheck
  have filteredNat : Nat(length{ℝ}(listFilter{ℝ}(nonzeroReals, xs)))
    typecheck
  have lengthNat : Nat(length{ℝ}(xs)) by typecheck
  unfold signVariations
  arith

-- Replacing the head by a nonzero entry of the same sign changes nothing.
theorem signVariations.head_same_sign (X Y : Real) (xs : List(ℝ))
  requires same : 0 < X * Y
  shows signVariations(X :: xs) = signVariations(Y :: xs)
proof
  have xElement : X ∈ ℝ by simp [Real]
  have yElement : Y ∈ ℝ by simp [Real]
  have xNonzero : X ≠ 0
    intro zero
    rw zero at same
    have vanish : (0:R) * Y = 0 by ring
    linarith
  have yNonzero : Y ≠ 0
    intro zero
    rw zero at same
    have vanish : X * (0:R) = 0 by ring
    linarith
  have xMember := nonzeroReals.of_nonzero with xNonzero
  have yMember := nonzeroReals.of_nonzero with yNonzero
  have filtered := listFilter.closed at ℝ, nonzeroReals, xs with *
  have signs := realSign.eq_of_product_positive with same
  have tails := signChangesFrom.congr_head at X, Y,
    listFilter{ℝ}(nonzeroReals, xs) with *
  have headX := signChangeIndicator.zero_left at X with *
  have headY := signChangeIndicator.zero_left at Y with *
  unfold signVariations
  rw [listFilter.cons_member, listFilter.cons_member, signChangesFrom.cons,
