-- Highest vectors and Casimir bounds for unitarisable gl_n(ℂ)-modules: the
-- U(𝔨)-filtration M_s generated by a vector, the action of the compact
-- Casimir Ω_K on it, the inequality |ν|² + 2⟨ν, λ⟩ ≥ −n³ for K-highest
-- vectors of weight Λ + ν, existence of highest vectors in stable finite
-- dimensional subspaces, finite dimensionality of M_s, the growth bound
-- ‖Xy‖ ≤ (n + 1)⁴(L + 1 + s)‖X‖‖y‖ on M_s, orthogonality to all M_t, and
-- analytic vectors: a coefficient map killing every M_s vanishes.
-- Source: grh-compact/src/Lib/DiscreteSeries/Rigidity/CasimirBound.lean
-- (IsUnitaryCasimirGe, HCParam.casimirKValue, GlModule.adTwist,
-- GlModule.filtration, commute_E_casimirK, casimirK_one_adTwist,
-- filtration_mono, self_mem_filtration, E_mem_filtration_succ,
-- E_mem_filtration, casimirK_eq_smul_of_mem_filtration,
-- GlModule.generatedBy, abs_twoRho_le, two_mul_paramAddRho,
-- abs_lowestKType_le, HCParam.HasGap.mono, HasGap.signs_one, HasGap.neg,
-- lowestKType_neg, IsKHighest.casimirK_eq_smul, IsKHighest.casimir_bound),
-- Rigidity/HighestVectors.lean (HCParam.exists_highest_vector,
-- IsKHighest.finite_filtration), Rigidity/CasimirGrowth.lean
-- (IsKInvariantForm, IsKHighest.norm_apply_le_of_mem_filtration,
-- mem_orthogonal_filtration_of_casimirK), Rigidity/AnalyticVectors.lean
-- (IsKHighest.coeffMap_eq_zero, IsUnitaryRep.exists_innerProductSpace,
-- IsUnitaryRep.form_apply_eq_form_inv_apply,
-- IsDerivedAction.form_E_eq_sign_mul). Part of: "Lowest K-type and
-- Casimir value determine a discrete series coefficient; analytic
-- vectors (known result; see Lib.DiscreteSeries.Rigidity.CasimirGrowth)."
-- Not stated: the word calculus (GlModule.word, wordWeight,
-- E_word_eq_wordWeight_smul, filtration_le_of_word_mem) and
-- casimirK_bound_of_highest, IsKInvariantForm.mul_E,
-- sum_inner_casimirK, which are steps of the proofs of the growth bound.
-- Encoding. A unitarisable module is a complex inner product space
-- (H, ⟨·,·⟩, ‖·‖) (InnerProductSpace of GRH.Normed.InnerProduct, conjugate
-- linear in the first argument) with a gl_n(ℂ)-module structure ρ on it.
-- The filtration M_s is defined by recursion on s. The compact form of a
-- parameter (signs all 1) is the parameter with the constant sign vector.
-- Part of the GRH blueprint (layer 4, Lib/DiscreteSeries, stage S2).
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.DiscreteSeries.Rigidity
import GRH.DiscreteSeries.Representation

section DiscreteSeriesRigidity
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- Section: The Casimir inequality and K-weights
-- The full Casimir Ω = Σ_{a,b} E_ab E_ba (the source's casimirK 1).
def glCasimirFull (ι M ρ : Set) : Set := glCasimir(ι, M, ρ, allPairs(ι))

-- CasimirBound.lean, IsUnitaryCasimirGe l ρ: ⟨E_ab v, w⟩ = ε_aε_b⟨v, E_ba w⟩
-- and Re⟨y, Ωy⟩ ≥ (|λ|² − |ρ|²)‖y‖².
predicate IsUnitaryCasimirGe (ι ε l H inner norm ρ : Set) :=
  InnerProductSpace(H, complexRing, complexAbs, complexConj, complexOfReal, inner, norm) ∧
  IsGlModule(ι, H, ρ) ∧
  (∀ a ∈ ι, ∀ b ∈ ι, ∀ v ∈ Module.carrier(H), ∀ w ∈ Module.carrier(H),
    inner(glE(ι, ρ, a, b)(v), w) = ℂ[ε(a) * ε(b) * inner(v, glE(ι, ρ, b, a)(w))]) ∧
  (∀ y ∈ Module.carrier(H),
    R[casimirValue(ι, l) * norm(y) ^ 2] ≤ complexRe(inner(y, glCasimirFull(ι, H, ρ)(y))))

-- CasimirBound.lean, HCParam.casimirKValue l ν = Σ_a ν_a(ν_a + 2ρ_{c,a}).
def casimirKTerms (ι ε l ν : Set) : Set :=
  { (a, R[intReal(ν(a)) * (intReal(ν(a)) + intReal(twoRho(ι, l, sameSignPairs(ι, ε), a)))]) |
    a ∈ ι }

def casimirKValue (ι ε l ν : Set) : Set := realFiniteSum(casimirKTerms(ι, ε, l, ν), ι)

-- CasimirBound.lean, GlModule.adTwist g: X acts as gXg⁻¹.
def adTwist (ι ρ g : Set) : Set :=
  { (X, ρ(matMul(complexRing, ι, ι, ι, g, matMul(complexRing, ι, ι, ι, X,
      matInverse(complexRing, ι, g))))) | X ∈ cMatrices(ι) }

-- CasimirBound.lean, commute_E_casimirK: E_ab commutes with Ω_K for
-- ε_a = ε_b.
theorem glCasimirK.commute (ι ε M ρ a b v : Set)
  requires finite : Finite(ι)
  requires signs : SignsOn(ι, ε)
  requires glm : IsGlModule(ι, M, ρ)
  requires ha : a ∈ ι
  requires hb : b ∈ ι
  requires same : ε(a) = ε(b)
  requires hv : v ∈ Module.carrier(M)
  shows glE(ι, ρ, a, b)(glCasimirK(ι, ε, M, ρ)(v)) = glCasimirK(ι, ε, M, ρ)(glE(ι, ρ, a, b)(v))
proof
  sorry

-- CasimirBound.lean, casimirK_one_adTwist: Ω is invariant under twisting.
theorem glCasimirFull.adTwist (ι M ρ g v : Set)
  requires finite : Finite(ι)
  requires glm : IsGlModule(ι, M, ρ)
  requires hg : g ∈ invertibleMatrices(complexRing, ι)
  requires hv : v ∈ Module.carrier(M)
  shows glCasimirFull(ι, M, adTwist(ι, ρ, g))(v) = glCasimirFull(ι, M, ρ)(v)
proof
  sorry

-- Section: The filtration
-- U(𝔨)x: the least subspace containing x stable under the E_ab, ε_a = ε_b.
def compactStableSpan (ι ε M ρ x : Set) : Set :=
  { v ∈ Module.carrier(M) | ∀ W, SubmoduleOf(W, M, complexRing) → x ∈ W →
    (∀ a ∈ ι, ∀ b ∈ ι, ε(a) = ε(b) → ∀ w ∈ W, glE(ι, ρ, a, b)(w) ∈ W) → v ∈ W }

-- M_{s+1} = M_s + Σ_{a,b} E_ab M_s.
def filtrationStepGens (ι M ρ P : Set) : Set :=
  P ∪ { w ∈ Module.carrier(M) | ∃ a ∈ ι, ∃ b ∈ ι, ∃ v ∈ P, w = glE(ι, ρ, a, b)(v) }

-- CasimirBound.lean, GlModule.filtration ε x s.
def glFiltration (ι ε M ρ x : Set, s : Nat) → Set
  | ι, ε, M, ρ, x, zero => compactStableSpan(ι, ε, M, ρ, x)
  | ι, ε, M, ρ, x, succ(k) =>
    moduleSpan(M, complexRing, filtrationStepGens(ι, M, ρ, glFiltration(ι, ε, M, ρ, x, k)))

-- CasimirBound.lean, filtration_mono and self_mem_filtration.
theorem glFiltration.mono (ι ε M ρ x : Set, s t : Nat)
  requires finite : Finite(ι)
  requires glm : IsGlModule(ι, M, ρ)
  requires hx : x ∈ Module.carrier(M)
  requires le : (s:N) ≤ (t:N)
  shows x ∈ glFiltration(ι, ε, M, ρ, x, s) ∧
    glFiltration(ι, ε, M, ρ, x, s) ⊆ glFiltration(ι, ε, M, ρ, x, t)
proof
  sorry

-- CasimirBound.lean, E_mem_filtration_succ and E_mem_filtration.
theorem glFiltration.E_mem (ι ε M ρ x y a b : Set, s : Nat)
  requires finite : Finite(ι)
  requires glm : IsGlModule(ι, M, ρ)
  requires hx : x ∈ Module.carrier(M)
  requires hy : y ∈ glFiltration(ι, ε, M, ρ, x, s)
  requires ha : a ∈ ι
  requires hb : b ∈ ι
  shows glE(ι, ρ, a, b)(y) ∈ glFiltration(ι, ε, M, ρ, x, succ(s)) ∧
    (ε(a) = ε(b) → glE(ι, ρ, a, b)(y) ∈ glFiltration(ι, ε, M, ρ, x, s))
proof
  sorry

-- CasimirBound.lean, casimirK_eq_smul_of_mem_filtration: if Ω_K x = cx then
-- Ω_K y = cy on M_0.
theorem glFiltration.casimirK_eq_smul (ι ε M ρ x y c : Set)
  requires finite : Finite(ι)
  requires signs : SignsOn(ι, ε)
  requires glm : IsGlModule(ι, M, ρ)
  requires hx : x ∈ Module.carrier(M)
  requires hc : c ∈ complexCarrier
  requires eigen : glCasimirK(ι, ε, M, ρ)(x) = Module.smul(M)(c, x)
  requires hy : y ∈ glFiltration(ι, ε, M, ρ, x, 0)
  shows glCasimirK(ι, ε, M, ρ)(y) = Module.smul(M)(c, y)
proof
  sorry

-- CasimirBound.lean, GlModule.generatedBy x: U(𝔤)x, the M_0 of the
-- constant signs, a gl_n-submodule, on which Ω acts by c if Ωx = cx
-- (casimirK_generatedBy).
def onesSigns (ι : Set) : Set := ι × {complexOne}

def generatedBy (ι M ρ x : Set) : Set := glFiltration(ι, onesSigns(ι), M, ρ, x, 0)

theorem generatedBy.casimir (ι M ρ x y c : Set)
  requires finite : Finite(ι)
  requires glm : IsGlModule(ι, M, ρ)
  requires hx : x ∈ Module.carrier(M)
  requires hc : c ∈ complexCarrier
  requires eigen : glCasimirFull(ι, M, ρ)(x) = Module.smul(M)(c, x)
  requires hy : y ∈ generatedBy(ι, M, ρ, x)
  shows SubmoduleOf(generatedBy(ι, M, ρ, x), M, complexRing) ∧
    (∀ X ∈ cMatrices(ι), ρ(X)(y) ∈ generatedBy(ι, M, ρ, x)) ∧
    glCasimirFull(ι, M, ρ)(y) = Module.smul(M)(c, y)
proof
  sorry

-- Section: Parameters
-- CasimirBound.lean, abs_twoRho_le: |2ρ_i| ≤ n.
theorem twoRho.abs_le (ι l r i : Set)
  requires finite : Finite(ι)
  requires hl : (l : ι → ℤ)
  requires hr : r ⊆ ι × ι
  requires hi : i ∈ ι
  shows realAbs(intReal(twoRho(ι, l, r, i))) ≤ realNat(cardinality(ι))
proof
  sorry

-- CasimirBound.lean, two_mul_paramAddRho: 2μ_i = l_i + 2ρ_i for l
-- injective.
theorem paramAddRho.two_mul (ι l i : Set)
  requires finite : Finite(ι)
  requires hl : (l : ι → ℤ)
  requires injective : ∀ a ∈ ι, ∀ b ∈ ι, l(a) = l(b) → a = b
  requires hi : i ∈ ι
  shows integerAddValue(paramAddRho(ι, l)(i), paramAddRho(ι, l)(i)) =
    integerAddValue(l(i), twoRho(ι, l, allPairs(ι), i))
proof
  sorry

-- CasimirBound.lean, abs_lowestKType_le: |l_a| ≤ L for all a gives
-- |Λ_a| ≤ L + n.
theorem lowestKType.abs_le (ι ε l h : Set, L : Nat)
  requires finite : Finite(ι)
  requires gap : HasGap(ι, ε, l, h)
  requires bound : ∀ a ∈ ι, realAbs(intReal(l(a))) ≤ realNat(L)
  shows ∀ a ∈ ι, realAbs(intReal(lowestKType(ι, ε, l)(a))) ≤ realNat(add(L, cardinality(ι)))
proof
  sorry

-- CasimirBound.lean, HCParam.HasGap.mono, signs_one and neg.
theorem HasGap.mono (ι ε l h h2 : Set)
  requires gap : HasGap(ι, ε, l, h)
  requires hh2 : h2 ∈ ℝ
  requires le : (h2:R) ≤ (h:R)
  shows HasGap(ι, ε, l, h2)
proof
  sorry

theorem HasGap.signs_one (ι ε l h : Set)
  requires gap : HasGap(ι, ε, l, h)
  shows HasGap(ι, onesSigns(ι), l, h)
proof
  sorry

theorem HasGap.neg (ι ε l h : Set)
  requires gap : HasGap(ι, ε, l, h)
  shows HasGap(ι, ε, intVecNeg(ι, l), h)
proof
  sorry

-- CasimirBound.lean, lowestKType_neg: Λ(−λ) = −Λ(λ).
theorem lowestKType.neg (ι ε l h : Set)
  requires finite : Finite(ι)
  requires gap : HasGap(ι, ε, l, h)
  shows lowestKType(ι, ε, intVecNeg(ι, l)) = intVecNeg(ι, lowestKType(ι, ε, l))
proof
  sorry

-- CasimirBound.lean, IsKHighest.casimirK_eq_smul: Ω_K x = casimirKValue ν x.
theorem IsKHighest.casimirK_eq_smul (ι ε l h M ρ ν x : Set)
  requires finite : Finite(ι)
  requires signs : SignsOn(ι, ε)
  requires gap : HasGap(ι, ε, l, h)
  requires glm : IsGlModule(ι, M, ρ)
  requires hν : (ν : ι → ℤ)
  requires highest : IsKHighest(ι, ε, l, M, ρ, ν, x)
  shows glCasimirK(ι, ε, M, ρ)(x) = Module.smul(M)(complexOfReal(casimirKValue(ι, ε, l, ν)), x)
proof
  sorry

-- CasimirBound.lean, IsKHighest.casimir_bound: a K-highest x ≠ 0 of weight
-- Λ + ν in a unitarisable module has Σ_a (n² + ν_a(ν_a + l_a)) ≥ 0.
def casimirBoundTerms (ι l ν : Set) : Set :=
  { (a, R[realNat(cardinality(ι)) ^ 2 + intReal(ν(a)) * (intReal(ν(a)) + intReal(l(a)))]) |
    a ∈ ι }

theorem IsKHighest.casimir_bound (ι ε l h H inner norm ρ ν x : Set)
  requires finite : Finite(ι)
  requires signs : SignsOn(ι, ε)
  requires gap : HasGap(ι, ε, l, h)
  requires unitary : IsUnitaryCasimirGe(ι, ε, l, H, inner, norm, ρ)
  requires hν : (ν : ι → ℤ)
  requires highest : IsKHighest(ι, ε, l, H, ρ, intVecAdd(ι, lowestKType(ι, ε, l), ν), x)
  requires nonzero : x ≠ Module.zero(H)
  shows realZero ≤ realFiniteSum(casimirBoundTerms(ι, l, ν), ι)
proof
  sorry

-- Section: Highest vectors
-- HighestVectors.lean, HCParam.exists_highest_vector: a nonzero finite
-- dimensional subspace stable under the E_ab, ε_a = ε_b, contains a common
-- eigenvector v ≠ 0 of the E_aa that is compact primitive for l.
theorem exists_highest_vector (ι ε l H inner norm ρ W : Set)
  requires finite : Finite(ι)
  requires signs : SignsOn(ι, ε)
  requires hl : (l : ι → ℤ)
  requires space : InnerProductSpace(H, complexRing, complexAbs, complexConj, complexOfReal,
    inner, norm)
  requires glm : IsGlModule(ι, H, ρ)
  requires sub : SubmoduleOf(W, H, complexRing)
  requires findim : FiniteDimensionalModule(submoduleModule(H, complexRing, W), complexRing)
  requires nonzero : W ≠ {Module.zero(H)}
  requires stable : ∀ a ∈ ι, ∀ b ∈ ι, ε(a) = ε(b) → ∀ w ∈ W, glE(ι, ρ, a, b)(w) ∈ W
  shows ∃ μ ∈ functionSpace(ι, complexCarrier), ∃ v ∈ W, v ≠ Module.zero(H) ∧
    (∀ a ∈ ι, glE(ι, ρ, a, a)(v) = Module.smul(H)(μ(a), v)) ∧
    IsCompactPrimitive(ι, ε, l, H, ρ, v)
proof
  sorry

-- HighestVectors.lean, IsKHighest.finite_filtration: in a unitarisable
-- module every M_s of a K-highest vector is finite dimensional.
theorem IsKHighest.finite_filtration (ι ε l h H inner norm ρ ν x : Set, s : Nat)
  requires finite : Finite(ι)
  requires signs : SignsOn(ι, ε)
  requires gap : HasGap(ι, ε, l, h)
  requires unitary : IsUnitaryCasimirGe(ι, ε, l, H, inner, norm, ρ)
  requires hν : (ν : ι → ℤ)
  requires highest : IsKHighest(ι, ε, l, H, ρ, ν, x)
  shows FiniteDimensionalModule(submoduleModule(H, complexRing, glFiltration(ι, ε, H, ρ, x, s)),
    complexRing)
proof
  sorry

-- Section: Growth
-- CasimirGrowth.lean, IsKInvariantForm ε ρ J: some D commuting with the
-- E_cd, ε_c = ε_d, has Σ_i ⟨J_i u, J_i v⟩ = ⟨u, Dv⟩.
def jFormTerms (I inner Jf u v : Set) : Set := { (i, inner(Jf(i)(u), Jf(i)(v))) | i ∈ I }

predicate IsKInvariantForm (ι ε H inner ρ I Jf : Set) :=
  ∃ D ∈ functionSpace(Module.carrier(H), Module.carrier(H)),
    (∀ c ∈ ι, ∀ d ∈ ι, ε(c) = ε(d) → ∀ v ∈ Module.carrier(H),
      glE(ι, ρ, c, d)(D(v)) = D(glE(ι, ρ, c, d)(v))) ∧
    ∀ u ∈ Module.carrier(H), ∀ v ∈ Module.carrier(H),
      groupFiniteSum(complexAdditiveGroup, I, jFormTerms(I, inner, Jf, u, v)) = inner(u, D(v))

-- CasimirGrowth.lean, IsKHighest.norm_apply_le_of_mem_filtration: for y ∈
-- M_s and any X, Xy ∈ M_{s+1} and ‖Xy‖ ≤ (n + 1)⁴(L + 1 + s)‖X‖‖y‖.
theorem IsKHighest.norm_apply_le (ι ε l h H inner norm ρ ν x y X : Set, L s : Nat)
  requires finite : Finite(ι)
  requires nonempty : ι ≠ ∅
  requires signs : SignsOn(ι, ε)
  requires gap : HasGap(ι, ε, l, h)
  requires unitary : IsUnitaryCasimirGe(ι, ε, l, H, inner, norm, ρ)
  requires hν : (ν : ι → ℤ)
  requires highest : IsKHighest(ι, ε, l, H, ρ, ν, x)
  requires bound : ∀ a ∈ ι, realAbs(intReal(ν(a))) ≤ realNat(L)
  requires hy : y ∈ glFiltration(ι, ε, H, ρ, x, s)
  requires hX : X ∈ cMatrices(ι)
  shows ρ(X)(y) ∈ glFiltration(ι, ε, H, ρ, x, succ(s)) ∧
    norm(ρ(X)(y)) ≤ R[(realNat(cardinality(ι)) + 1) ^ 4 * (realNat(L) + 1 + realNat(s)) *
      matOpNorm(ι, X) * norm(y)]
proof
  sorry

-- CasimirGrowth.lean, mem_orthogonal_filtration_of_casimirK: for λ of gap
-- 500n³ + A and x K-highest of weight Λ, an Ω_K-eigenvector a (value θ
-- real, θ − casimirKValue Λ ≤ s) orthogonal to M_s is orthogonal to every
-- M_t.
theorem mem_orthogonal_filtration (ι ε l H inner norm ρ x θ a : Set, A s t : Nat)
  requires finite : Finite(ι)
  requires signs : SignsOn(ι, ε)
  requires gap : HasLargeGap(ι, ε, l, A)
  requires unitary : IsUnitaryCasimirGe(ι, ε, l, H, inner, norm, ρ)
  requires highest : IsKHighest(ι, ε, l, H, ρ, lowestKType(ι, ε, l), x)
  requires hθ : θ ∈ ℝ
  requires ha : a ∈ Module.carrier(H)
  requires eigen : glCasimirK(ι, ε, H, ρ)(a) = Module.smul(H)(complexOfReal(θ), a)
  requires level : R[θ - casimirKValue(ι, ε, l, lowestKType(ι, ε, l))] ≤ realNat(s)
  requires orth : ∀ y ∈ glFiltration(ι, ε, H, ρ, x, s), inner(a, y) = complexZero
  shows ∀ y ∈ glFiltration(ι, ε, H, ρ, x, t), inner(a, y) = complexZero
proof
  sorry

-- Section: Analytic vectors
-- AnalyticVectors.lean, IsKHighest.coeffMap_eq_zero: for x K-highest in a
-- unitarisable module and c a scalar coefficient map with |c_g(v)| ≤ D‖v‖,
-- if c_1 kills every M_s then c_g(x) = 0 for all g.
theorem IsKHighest.coeffMap_eq_zero (ι ε l h H inner norm ρ ν x c D g : Set)
  requires finite : Finite(ι)
  requires signs : SignsOn(ι, ε)
  requires gap : HasGap(ι, ε, l, h)
  requires unitary : IsUnitaryCasimirGe(ι, ε, l, H, inner, norm, ρ)
  requires hν : (ν : ι → ℤ)
  requires highest : IsKHighest(ι, ε, l, H, ρ, ν, x)
  requires linear : ∀ k ∈ signUnitaryMatrices(ι, ε), LinearMap(c(k), H, complexRing, complexSelfModule)
  requires coeff : IsCoeffMap(ι, signMatrix(complexRing, ι, ε), H, ρ, complexSelfModule, complexAbs, c)
  requires hD : D ∈ ℝ
  requires bounded : ∀ k ∈ signUnitaryMatrices(ι, ε), ∀ v ∈ Module.carrier(H),
    complexAbs(c(k)(v)) ≤ R[D * norm(v)]
  requires kills : ∀ s ∈ ℕ, ∀ v ∈ glFiltration(ι, ε, H, ρ, x, s),
    c(matOne(complexRing, ι))(v) = complexZero
  requires hg : g ∈ signUnitaryMatrices(ι, ε)
  shows c(g)(x) = complexZero
proof
  sorry

-- AnalyticVectors.lean, IsUnitaryRep.exists_innerProductSpace: the form B
-- makes X an inner product space on which π acts isometrically.
def formNorm (X B : Set) : Set := { (x, realSqrt(complexRe(B(x, x)))) | x ∈ Module.carrier(X) }

theorem IsUnitaryRep.inner_product (ι J X norm π B : Set, A : Nat)
  requires finite : Finite(ι)
  requires rep : IsUnitaryRep(ι, J, X, norm, A, π, B)
  shows InnerProductSpace(X, complexRing, complexAbs, complexConj, complexOfReal, B,
      formNorm(X, B)) ∧
    ∀ g ∈ unitaryOf(ι, J), ∀ x ∈ Module.carrier(X), formNorm(X, B)(π(g)(x)) = formNorm(X, B)(x)
proof
  sorry

-- AnalyticVectors.lean, IsUnitaryRep.form_apply_eq_form_inv_apply.
theorem IsUnitaryRep.form_inv (ι J X norm π B g x y : Set, A : Nat)
  requires finite : Finite(ι)
  requires rep : IsUnitaryRep(ι, J, X, norm, A, π, B)
  requires hg : g ∈ unitaryOf(ι, J)
  requires hx : x ∈ Module.carrier(X)
  requires hy : y ∈ Module.carrier(X)
  shows B(x, π(g)(y)) = B(π(matInverse(complexRing, ι, g))(x), y)
proof
  sorry

-- AnalyticVectors.lean, IsDerivedAction.form_E_eq_sign_mul: B(ι(E_ab v), ιw)
-- = ε_aε_b B(ιv, ι(E_ba w)).
theorem IsDerivedAction.form_E (ι ε X norm π B M e ρ a b v w : Set, A : Nat)
  requires finite : Finite(ι)
  requires signs : SignsOn(ι, ε)
  requires rep : IsUnitaryRep(ι, signMatrix(complexRing, ι, ε), X, norm, A, π, B)
  requires glm : IsGlModule(ι, M, ρ)
  requires he : LinearMap(e, M, complexRing, X)
  requires derived : IsDerivedAction(ι, signMatrix(complexRing, ι, ε), X, norm, π, M, e, ρ)
  requires ha : a ∈ ι
  requires hb : b ∈ ι
  requires hv : v ∈ Module.carrier(M)
  requires hw : w ∈ Module.carrier(M)
  shows B(e(glE(ι, ρ, a, b)(v)), e(w)) = ℂ[ε(a) * ε(b) * B(e(v), e(glE(ι, ρ, b, a)(w)))]
proof
  sorry

end DiscreteSeriesRigidity
