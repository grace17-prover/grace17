-- Polynomial volume growth in U(J) and the right regular representation:
-- for a group homomorphism j : S → U(J) and a right invariant measure ν on
-- S, the covering bound ν{‖j(s)y‖ ≤ R} ≤ K^{2n²} ν{‖j(s) − 1‖ ≤ 1/D}
-- (K ≥ 3DR²), and for j proper and c > 8n² the integrability of
-- (2/‖j(s)y‖)^c with integral at most 16^c ν{‖j(s) − 1‖ ≤ 1}; the right
-- regular representation of U(diag ε) on L² is a continuous unitary
-- representation.
-- Source: grh-compact/src/Lib/DiscreteSeries/Haar/RegularRepL2.lean
-- (measure_sublevel_ne_zero, measure_ball_le_covering,
-- measure_ball_ne_top_of_isProperMap, integral_decay_le,
-- lintegral_decay_le, rightRegularL2, isUnitaryRep_rightRegularL2,
-- isCompact_U_norm_le). Known result: "Haar measure of U(J) in Cayley
-- coordinates, volume of U(n), polynomial volume growth" (Hua, Harmonic
-- Analysis of Functions of Several Complex Variables in the Classical
-- Domains, ch. III; Macdonald, The volume of a compact Lie group).
-- STAND-IN: csDSL2, csDSL2Norm, csDSL2Inner for Mathlib's
-- MeasureTheory.Lp ℂ 2 (layer 3, Measure): square-integrable functions
-- modulo equality almost everywhere, with the L² norm and inner product.
-- The real one needs the Lp spaces of GRH.Measure with their completeness.
-- Encoding. S is a group with a topology XS and a measure ν on the Borel
-- sets of XS; a homomorphism j : S → U(J) is proper when preimages of
-- compact sets are compact.
-- Part of the GRH blueprint (layer 4, Lib/DiscreteSeries, stage S2).
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.DiscreteSeries.RegularRep
import GRH.DiscreteSeries.Representation

section DiscreteSeriesRegularRep
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- Section: Volume growth
-- {s : ‖j(s)y‖ ≤ R} and {s : ‖j(s) − 1‖ ≤ r}.
def normBallPre (ι S j y r : Set) : Set :=
  { s ∈ Group.carrier(S) | (matOpNorm(ι, matMul(complexRing, ι, ι, ι, j(s), y)):R) ≤ (r:R) }

def nearOnePre (ι S j r : Set) : Set :=
  { s ∈ Group.carrier(S) | (matOpNorm(ι, matSub(ι, j(s), matOne(complexRing, ι))):R) ≤ (r:R) }

-- RegularRepL2.lean, isCompact_U_norm_le: {g ∈ U(J) : ‖g‖ ≤ T} is compact.
def unitaryNormBall (ι J T : Set) : Set := { g ∈ unitaryOf(ι, J) | (matOpNorm(ι, g):R) ≤ (T:R) }

theorem unitaryNormBall.compact (ι J T : Set)
  requires finite : Finite(ι)
  requires herm : IsHermInvolution(ι, J)
  requires hT : T ∈ ℝ
  shows Compact(unitaryOfSpace(ι, J), unitaryNormBall(ι, J, T))
proof
  sorry

-- RegularRepL2.lean, measure_ball_le_covering: the covering bound.
theorem normBallPre.covering (ι J S XS ν j y D r K : Set)
  requires finite : Finite(ι)
  requires nonempty : ι ≠ ∅
  requires herm : IsHermInvolution(ι, J)
  requires top : TopologicalGroup(S, XS)
  requires measure : Measure(borelSpace(XS), ν)
  requires invariant : RightInvariant(S, XS, ν)
  requires hom : GroupHom(j, S, unitaryOfGroup(ι, J))
  requires continuous : j : XS ⇒ unitaryOfSpace(ι, J)
  requires hy : y ∈ unitaryOf(ι, J)
  requires hD : D ∈ ℝ
  requires hr : r ∈ ℝ
  requires hK : K ∈ ℝ
  requires oneD : realOne ≤ D
  requires oneR : realOne ≤ r
  requires big : R[3 * D * r ^ 2] ≤ K
  shows EnnLe(ν(normBallPre(ι, S, j, y, r)),
    ennMul(ennOfReal(R[K ^ mul(2, mul(cardinality(ι), cardinality(ι)))]),
      ν(nearOnePre(ι, S, j, realInvValue(D)))))
proof
  sorry

-- j is proper: preimages of compact sets are compact.
predicate ProperHom (ι J XS j : Set) :=
  ∀ C ⊆ unitaryOf(ι, J), Compact(unitaryOfSpace(ι, J), C) →
    Compact(XS, functionPreimage(j, TopologicalSpace.carrier(XS), C))

-- s ↦ (2/‖j(s)y‖)^c.
def decayFunction (ι S j y : Set, c : Nat) : Set :=
  { (s, R[realDiv(R[2], matOpNorm(ι, matMul(complexRing, ι, ι, ι, j(s), y))) ^ c]) |
    s ∈ Group.carrier(S) }

-- RegularRepL2.lean, integral_decay_le and lintegral_decay_le: for j proper,
-- ν right invariant and finite on compacts, n ≥ 1 and c > 8n²,
-- (2/‖j(s)y‖)^c is integrable with integral ≤ 16^c ν{‖j(s) − 1‖ ≤ 1}.
theorem decayFunction.integral_le (ι J S XS ν j y : Set, c : Nat)
  requires finite : Finite(ι)
  requires nonempty : ι ≠ ∅
  requires herm : IsHermInvolution(ι, J)
  requires top : TopologicalGroup(S, XS)
  requires measure : Measure(borelSpace(XS), ν)
  requires invariant : RightInvariant(S, XS, ν)
  requires compacts : FiniteOnCompacts(XS, ν)
  requires hom : GroupHom(j, S, unitaryOfGroup(ι, J))
  requires continuous : j : XS ⇒ unitaryOfSpace(ι, J)
  requires proper : ProperHom(ι, J, XS, j)
  requires hy : y ∈ unitaryOf(ι, J)
  requires hc : mul(8, mul(cardinality(ι), cardinality(ι))) < c
  shows RealIntegrable(borelSpace(XS), ν, decayFunction(ι, S, j, y, c)) ∧
    realMeasureIntegral(borelSpace(XS), ν, decayFunction(ι, S, j, y, c)) ≤
      R[16 ^ c * measureReal(ν, nearOnePre(ι, S, j, realOne))]
proof
  sorry

-- Section: The right regular representation on L²
-- STAND-IN for MeasureTheory.Lp ℂ 2 (volume) on U(diag ε): the square
-- integrable functions modulo the null ones, with norm and inner product.
def csDSL2Functions (ι ε : Set) : Set :=
  { f ∈ functionSpace(signUnitaryMatrices(ι, ε), complexCarrier) |
    SquareIntegrable(signBorel(ι, ε), signHaar(ι, ε), f) }

def csDSL2Null (ι ε : Set) : Set :=
  { f ∈ csDSL2Functions(ι, ε) |
    AEEqual(signBorel(ι, ε), signHaar(ι, ε), f, signUnitaryMatrices(ι, ε) × {complexZero}) }

def csDSL2 (ι ε : Set) : Set :=
  quotientModule(submoduleModule(coordinateModule(complexRing, signUnitaryMatrices(ι, ε)), complexRing, csDSL2Functions(ι, ε)),
    complexRing, csDSL2Null(ι, ε))

def csDSL2InnerValue (ι ε F G : Set) : Set :=
  ⋃({ c ∈ complexCarrier | ∃ f ∈ F, ∃ g ∈ G, c = l2Inner(signBorel(ι, ε), signHaar(ι, ε), f, g) })

def csDSL2Inner (ι ε : Set) : Set :=
  { (p, csDSL2InnerValue(ι, ε, fst(p), snd(p))) |
    p ∈ Module.carrier(csDSL2(ι, ε)) × Module.carrier(csDSL2(ι, ε)) }

def csDSL2Norm (ι ε : Set) : Set :=
  { (F, realSqrt(complexRe(csDSL2InnerValue(ι, ε, F, F)))) | F ∈ Module.carrier(csDSL2(ι, ε)) }

theorem csDSL2.inner_product (ι ε : Set)
  requires finite : Finite(ι)
  requires signs : SignsOn(ι, ε)
  shows InnerProductSpace(csDSL2(ι, ε), complexRing, complexAbs, complexConj, complexOfReal,
      csDSL2Inner(ι, ε), csDSL2Norm(ι, ε)) ∧
    BanachSpace(csDSL2(ι, ε), complexRing, complexAbs, csDSL2Norm(ι, ε))
proof
  sorry

-- RegularRepL2.lean, rightRegularL2: (R(g)f)(x) = f(xg), on classes.
def rightTranslateFn (ι g f : Set) : Set :=
  { (x, f(matMul(complexRing, ι, ι, ι, x, g))) | x ∈ domain(f) }

def rightRegularClass (ι ε g F : Set) : Set :=
  ⋃({ G ∈ Module.carrier(csDSL2(ι, ε)) | ∃ f ∈ F, rightTranslateFn(ι, g, f) ∈ G })

def rightRegularOp (ι ε g : Set) : Set :=
  { (F, rightRegularClass(ι, ε, g, F)) | F ∈ Module.carrier(csDSL2(ι, ε)) }

def rightRegularL2 (ι ε : Set) : Set :=
  { (g, rightRegularOp(ι, ε, g)) | g ∈ signUnitaryMatrices(ι, ε) }

-- RegularRepL2.lean, isUnitaryRep_rightRegularL2: unitary with exponent 0
-- for the L² inner product.
theorem rightRegularL2.unitary (ι ε : Set)
  requires finite : Finite(ι)
  requires signs : SignsOn(ι, ε)
  shows IsUnitaryRep(ι, signMatrix(complexRing, ι, ε), csDSL2(ι, ε), csDSL2Norm(ι, ε), 0,
    rightRegularL2(ι, ε), csDSL2Inner(ι, ε))
proof
  sorry

end DiscreteSeriesRegularRep
