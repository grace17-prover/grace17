-- Characters of the discrete series of U(p, q) on the compact Cartan
-- subgroup: Laurent polynomials evaluated on the torus, Weyl alternants and
-- antisymmetry, Weyl's character and denominator formulas for K =
-- U(p) × U(q), the multiplicity of a K-type in the discrete series, the
-- open orbit G·B, Weyl's dimension formula for U(n), and Harish-Chandra's
-- formula for the formal degree and the orbital integrals of e_λ.
-- Source: grh-compact/src/Lib/DiscreteSeries/Character/LaurentAlternants.lean
-- (torusEval, oppositePairs, alternant, IsWeylAntisymm, HCParam.rootProd,
-- HCParam.lowerCount, torusEval_alternant, eq_of_torusEval_eq,
-- isWeylAntisymm_alternant, torusEval_rootProd_noncompact,
-- alternant_coeff_of_isKDominant, exists_sign_isKDominant),
-- Character/KTypeMultiplicity.lean (HCParam.kTypeChar,
-- Orbital.weyl_character_kTypeChar, Orbital.weyl_denominator,
-- Orbital.integral_conj_kTypeChar, Orbital.exists_kType_multiplicity),
-- Character/SectorBound.lean (openOrbit, weyl_dimension_formula),
-- Character/FormalDegree.lean (Orbital.dotProduct_add_gain_le_comp_perm,
-- Orbital.harish_chandra_degree_and_orbital). Known results: "Weyl
-- character and dimension formulas for U(n) and products of unitary
-- groups" and "Discrete series character on the compact Cartan by orbital
-- integrals; formal degree."
-- Not stated: the density of Laurent polynomials (denseRange_torusEval),
-- leadingMonomials and rootProd_mem_leadingMonomials, the permutation
-- lemmas (torusEval_comp_perm, torusEval_comp_eq_mul_iff,
-- apply_comp_perm_of_conj_invariant), Orbital.exists_maxCompactU_of_blocks,
-- Orbital.exists_conj_diagTorusK, Orbital.integral_mul_conj_kTypeChar, the
-- sector bounds of SectorBound.lean (IsBorelMatrix.unitary_eq_of_mul_eq,
-- abs_det_lowerLiePart, isOpen_openOrbit_and_lintegral_le,
-- integral_haar_eq_integral_openOrbit, le_norm_weightMinors_twoPowDiagConj),
-- and the steps of FormalDegree.lean (IsConeSeriesMultiple,
-- exists_laurent_orbital_integral, offOrbitIntegral,
-- orbital_eq_char_sub_offOrbitIntegral, coeff_eq_zero_of_low_level);
-- WeylTrace.lean (trace_weylRep, Weyl's character formula for weylRep).
-- Encoding. A Laurent polynomial in the variables indexed by ι (the
-- source's ℂ[n → ℤ]) is a finitely supported function ℤ^ι → ℂ. The root
-- products ∏ (x_a − x_b) are stated through their values on the torus,
-- which determine a Laurent polynomial (eq_of_torusEval_eq). Permutation
-- signs are matPermSign of GRH.Matrix.Determinant. The compact form of a
-- parameter has the constant signs 1, for which K = U(n).
-- Part of the GRH blueprint (layer 4, Lib/DiscreteSeries, stage S2).
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.DiscreteSeries.Character
import GRH.DiscreteSeries.CuspKernel

section DiscreteSeriesCharacter
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- Section: Laurent polynomials on the torus
def intVectors (ι : Set) : Set := functionSpace(ι, ℤ)

def laurentSupport (ι P : Set) : Set := { ν ∈ intVectors(ι) | P(ν) ≠ complexZero }

def laurentPolys (ι : Set) : Set :=
  { P ∈ functionSpace(intVectors(ι), complexCarrier) | Finite(laurentSupport(ι, P)) }

-- The torus: tuples of complex numbers of modulus one.
def torusPoints (ι : Set) : Set :=
  { x ∈ functionSpace(ι, complexCarrier) | ∀ i ∈ ι, complexAbs(x(i)) = realOne }

-- LaurentAlternants.lean, torusEval x P = Σ_ν P_ν ∏_a x_a^{ν_a}.
def torusMonomialTerms (ι x ν : Set) : Set := { (a, complexZpow(x(a), ν(a))) | a ∈ ι }

def torusMonomial (ι x ν : Set) : Set := complexFiniteProduct(ι, torusMonomialTerms(ι, x, ν))

def torusEvalTerms (ι x P : Set) : Set :=
  { (ν, ℂ[P(ν) * torusMonomial(ι, x, ν)]) | ν ∈ laurentSupport(ι, P) }

def torusEval (ι x P : Set) : Set :=
  groupFiniteSum(complexAdditiveGroup, laurentSupport(ι, P), torusEvalTerms(ι, x, P))

-- LaurentAlternants.lean, eq_of_torusEval_eq.
theorem torusEval.injective (ι P Q : Set)
  requires finite : Finite(ι)
  requires hP : P ∈ laurentPolys(ι)
  requires hQ : Q ∈ laurentPolys(ι)
  requires same : ∀ x ∈ torusPoints(ι), torusEval(ι, x, P) = torusEval(ι, x, Q)
  shows P = Q
proof
  sorry

-- Section: Alternants
-- [a = b] as a complex number.
def complexDelta (a b : Set) : Set :=
  ⋃({ s ∈ complexCarrier | (a = b ∧ s = complexOne) ∨ (a ≠ b ∧ s = complexZero) })

-- The Weyl group of K: the permutations of ι preserving the signs.
def signPerms (ι ε : Set) : Set :=
  { w ∈ functionSpace(ι, ι) | BijectiveBetween(w, ι, ι) ∧ ∀ i ∈ ι, ε(w(i)) = ε(i) }

def permuted (ι ν w : Set) : Set := { (i, ν(w(i))) | i ∈ ι }

-- LaurentAlternants.lean, alternant ε ν = Σ_{w ∈ W_K} sgn(w) x^{ν∘w}.
def alternantPerms (ι ε ν γ : Set) : Set := { w ∈ signPerms(ι, ε) | permuted(ι, ν, w) = γ }

def permSignTerms (ι W : Set) : Set := { (w, matPermSign(complexRing, ι, w)) | w ∈ W }

def alternant (ι ε ν : Set) : Set :=
  { (γ, groupFiniteSum(complexAdditiveGroup, alternantPerms(ι, ε, ν, γ),
      permSignTerms(ι, alternantPerms(ι, ε, ν, γ)))) | γ ∈ intVectors(ι) }

-- LaurentAlternants.lean, IsWeylAntisymm ε t: t(γ∘w) = sgn(w) t(γ).
predicate IsWeylAntisymm (ι ε t : Set) :=
  ∀ w ∈ signPerms(ι, ε), ∀ γ ∈ intVectors(ι),
    t(permuted(ι, γ, w)) = ℂ[matPermSign(complexRing, ι, w) * t(γ)]

-- LaurentAlternants.lean, isWeylAntisymm_alternant.
theorem alternant.antisymm (ι ε ν : Set)
  requires finite : Finite(ι)
  requires signs : SignsOn(ι, ε)
  requires hν : ν ∈ intVectors(ι)
  shows alternant(ι, ε, ν) ∈ laurentPolys(ι) ∧ IsWeylAntisymm(ι, ε, alternant(ι, ε, ν))
proof
  sorry

-- LaurentAlternants.lean, torusEval_alternant: the alternant at x is the
-- determinant of (a, b) ↦ x_a^{ν_b} if ε_a = ε_b, and 0 otherwise.
def alternantEntry (ε x ν a b : Set) : Set :=
  ⋃({ c ∈ complexCarrier | (ε(a) = ε(b) ∧ c = complexZpow(x(a), ν(b))) ∨
    (ε(a) ≠ ε(b) ∧ c = complexZero) })

def alternantDetMatrix (ι ε x ν : Set) : Set :=
  { (q, alternantEntry(ε, x, ν, fst(q), snd(q))) | q ∈ ι × ι }

theorem alternant.torusEval (ι ε ν x : Set)
  requires finite : Finite(ι)
  requires signs : SignsOn(ι, ε)
  requires hν : ν ∈ intVectors(ι)
  requires hx : x ∈ torusPoints(ι)
  shows torusEval(ι, x, alternant(ι, ε, ν)) = matDet(complexRing, ι, alternantDetMatrix(ι, ε, x, ν))
proof
  sorry

-- LaurentAlternants.lean, HCParam.rootProd r and HCParam.lowerCount r: the
-- product of x_a − x_b over the pairs (a, b) ∈ P with l_b < l_a, at x, and
-- the number of such b for each a.
def rootPairs (l P : Set) : Set := { p ∈ P | integerLess(l(snd(p)), l(fst(p))) }

def rootPairTerms (x Q : Set) : Set := { (q, ℂ[x(fst(q)) - x(snd(q))]) | q ∈ Q }

def rootProdEval (x l P : Set) : Set := complexFiniteProduct(rootPairs(l, P), rootPairTerms(x, rootPairs(l, P)))

def lowerSet (ι l P a : Set) : Set := { b ∈ ι | (a, b) ∈ P ∧ integerLess(l(b), l(a)) }

def lowerCount (ι l P : Set) : Set := { (a, integerOfNat(cardinality(lowerSet(ι, l, P, a)))) | a ∈ ι }

-- LaurentAlternants.lean, oppositePairs ε and torusEval_rootProd_noncompact:
-- over the pairs of opposite sign the root product is ±∏_{ε_a = 1, ε_b ≠ 1}
-- (x_a − x_b).
def posNegPairs (ι ε : Set) : Set := { q ∈ ι × ι | ε(fst(q)) = complexOne ∧ ε(snd(q)) ≠ complexOne }

def orientationSign (l q : Set) : Set :=
  ⋃({ c ∈ complexCarrier | (integerLess(l(snd(q)), l(fst(q))) ∧ c = complexOne) ∨
    (¬integerLess(l(snd(q)), l(fst(q))) ∧ c = ℂ[-1]) })

def orientationTerms (l Q : Set) : Set := { (q, orientationSign(l, q)) | q ∈ Q }

theorem rootProd.noncompact (ι ε l x : Set)
  requires finite : Finite(ι)
  requires signs : SignsOn(ι, ε)
  requires hl : (l : ι → ℤ)
  requires injective : ∀ a ∈ ι, ∀ b ∈ ι, l(a) = l(b) → a = b
  requires hx : x ∈ torusPoints(ι)
  shows rootProdEval(x, l, oppositeSignPairs(ι, ε)) =
    ℂ[complexFiniteProduct(posNegPairs(ι, ε), orientationTerms(l, posNegPairs(ι, ε))) *
      complexFiniteProduct(posNegPairs(ι, ε), rootPairTerms(x, posNegPairs(ι, ε)))]
proof
  sorry

-- LaurentAlternants.lean, alternant_coeff_of_isKDominant: for ν, ν′
-- dominant for (ε, −l) and δ = lowerCount(=), the coefficient of x^{ν′+δ} in
-- the alternant of ν + δ is [ν′ = ν].
theorem alternant.coeff_dominant (ι ε l ν ν2 : Set)
  requires finite : Finite(ι)
  requires signs : SignsOn(ι, ε)
  requires hl : (l : ι → ℤ)
  requires injective : ∀ a ∈ ι, ∀ b ∈ ι, l(a) = l(b) → a = b
  requires hν : ν ∈ intVectors(ι)
  requires hν2 : ν2 ∈ intVectors(ι)
  requires dom : IsKDominant(ι, ε, intVecNeg(ι, l), ν)
  requires dom2 : IsKDominant(ι, ε, intVecNeg(ι, l), ν2)
  shows alternant(ι, ε, intVecAdd(ι, ν, lowerCount(ι, l, sameSignPairs(ι, ε))))(
      intVecAdd(ι, ν2, lowerCount(ι, l, sameSignPairs(ι, ε)))) = complexDelta(ν2, ν)
proof
  sorry

-- LaurentAlternants.lean, exists_sign_isKDominant: every γ is ±(a dominant
-- ν) + δ up to W_K for antisymmetric functions.
theorem alternant.exists_sign_dominant (ι ε l γ : Set)
  requires finite : Finite(ι)
  requires signs : SignsOn(ι, ε)
  requires hl : (l : ι → ℤ)
  requires injective : ∀ a ∈ ι, ∀ b ∈ ι, l(a) = l(b) → a = b
  requires hγ : γ ∈ intVectors(ι)
  shows ∃ s ∈ ℤ, ∃ ν ∈ intVectors(ι), IsKDominant(ι, ε, intVecNeg(ι, l), ν) ∧
    ∀ t ∈ functionSpace(intVectors(ι), complexCarrier), IsWeylAntisymm(ι, ε, t) →
      t(γ) = ℂ[intToComplex(s) * t(intVecAdd(ι, ν, lowerCount(ι, l, sameSignPairs(ι, ε))))]
proof
  sorry

-- Section: Characters of K
-- KTypeMultiplicity.lean, HCParam.kTypeChar ν: χ_ν(g) = c_ν⁻¹ ∫_K m_ν(y⁻¹gy) dy.
def kTypeCharIntegrand (ι ε ν g : Set) : Set :=
  { (y, weightMinors(ι, ν, matMul(complexRing, ι, ι, ι,
      matMul(complexRing, ι, ι, ι, matInverse(complexRing, ι, y), g), y))) | y ∈ maxCompactU(ι, ε) }

def kTypeChar (ι ε ν g : Set) : Set :=
  complexDiv(complexMeasureIntegral(maxCompactBorel(ι, ε), haarK(ι, ε), kTypeCharIntegrand(ι, ε, ν, g)),
    complexOfReal(kTypeNormSq(ι, ε, ν)))

-- KTypeMultiplicity.lean, Orbital.weyl_character_kTypeChar (Weyl's character
-- formula for K): χ_ν on the torus is a Laurent polynomial, and
-- ∏_{ε_a = ε_b, l_b < l_a} (x_a − x_b) χ_ν(x) = alternant(ν + δ)(x).
theorem kTypeChar.weyl_character (ι ε l ν : Set)
  requires finite : Finite(ι)
  requires signs : SignsOn(ι, ε)
  requires hl : (l : ι → ℤ)
  requires injective : ∀ a ∈ ι, ∀ b ∈ ι, l(a) = l(b) → a = b
  requires hν : ν ∈ intVectors(ι)
  requires dominant : IsKDominant(ι, ε, intVecNeg(ι, l), ν)
  shows (∃ P ∈ laurentPolys(ι), ∀ x ∈ torusPoints(ι),
      kTypeChar(ι, ε, ν, diagTorus(ι, x)) = torusEval(ι, x, P)) ∧
    ∀ x ∈ torusPoints(ι),
      ℂ[rootProdEval(x, l, sameSignPairs(ι, ε)) * kTypeChar(ι, ε, ν, diagTorus(ι, x))] =
        torusEval(ι, x, alternant(ι, ε, intVecAdd(ι, ν, lowerCount(ι, l, sameSignPairs(ι, ε)))))
proof
  sorry

-- KTypeMultiplicity.lean, Orbital.weyl_denominator: the compact root
-- product is the alternant of δ.
theorem rootProd.weyl_denominator (ι ε l x : Set)
  requires finite : Finite(ι)
  requires signs : SignsOn(ι, ε)
  requires hl : (l : ι → ℤ)
  requires injective : ∀ a ∈ ι, ∀ b ∈ ι, l(a) = l(b) → a = b
  requires hx : x ∈ torusPoints(ι)
  shows rootProdEval(x, l, sameSignPairs(ι, ε)) =
    torusEval(ι, x, alternant(ι, ε, lowerCount(ι, l, sameSignPairs(ι, ε))))
proof
  sorry

-- KTypeMultiplicity.lean, Orbital.integral_conj_kTypeChar: ∫_K conj χ_ν =
-- [ν = 0].
def conjKTypeChar (ι ε ν : Set) : Set :=
  { (k, complexConj(kTypeChar(ι, ε, ν, k))) | k ∈ maxCompactU(ι, ε) }

def zeroIntVector (ι : Set) : Set := ι × {integerZero}

theorem kTypeChar.integral_conj (ι ε ν : Set)
  requires finite : Finite(ι)
  requires signs : SignsOn(ι, ε)
  requires hν : ν ∈ intVectors(ι)
  shows complexMeasureIntegral(maxCompactBorel(ι, ε), haarK(ι, ε), conjKTypeChar(ι, ε, ν)) =
    complexDelta(ν, zeroIntVector(ι))
proof
  sorry

-- KTypeMultiplicity.lean, Orbital.exists_kType_multiplicity (multiplicity
-- of a K-type): for λ of gap 500n³ + A and ν dominant, R(g) = ∫_K
-- ψ_λ(g⁻¹kg) conj χ_ν(k) dk is integrable, deg_λ ∫ R = m ∈ ℕ, m = 1 for ν =
-- Λ, and m ≠ 0 only if ν − Λ lies in the root cone.
def multiplicityInner (ι ε l ν g : Set) : Set :=
  { (k, ℂ[dsCoeff(ι, ε, l, matMul(complexRing, ι, ι, ι,
      matMul(complexRing, ι, ι, ι, matInverse(complexRing, ι, g), k), g)) *
      complexConj(kTypeChar(ι, ε, ν, k))]) | k ∈ maxCompactU(ι, ε) }

def multiplicityFn (ι ε l ν : Set) : Set :=
  { (g, complexMeasureIntegral(maxCompactBorel(ι, ε), haarK(ι, ε), multiplicityInner(ι, ε, l, ν, g))) |
    g ∈ signUnitaryMatrices(ι, ε) }

theorem kType.multiplicity (ι ε l ν : Set, A : Nat)
  requires finite : Finite(ι)
  requires nonempty : ι ≠ ∅
  requires signs : SignsOn(ι, ε)
  requires gap : HasLargeGap(ι, ε, l, A)
  requires hν : ν ∈ intVectors(ι)
  requires dominant : IsKDominant(ι, ε, intVecNeg(ι, l), ν)
  shows ComplexIntegrable(signBorel(ι, ε), signHaar(ι, ε), multiplicityFn(ι, ε, l, ν)) ∧
    ∃ m ∈ ℕ, ℂ[complexOfReal(formalDegree(ι, ε, l)) *
        complexMeasureIntegral(signBorel(ι, ε), signHaar(ι, ε), multiplicityFn(ι, ε, l, ν))] =
      complexOfReal(realNat(m)) ∧
      (ν = lowestKType(ι, ε, l) → (m:N) = (1:N)) ∧
      ((m:N) ≠ (0:N) → intVecSub(ι, ν, lowestKType(ι, ε, l)) ∈ rootCone(ι, l))
proof
  sorry

-- Section: Dimension and formal degree
-- SectorBound.lean, openOrbit ε o: the matrices gb, g ∈ U(diag ε), b
-- invertible o-upper triangular.
def openOrbit (ι ε o : Set) : Set :=
  { y ∈ cMatrices(ι) | ∃ g ∈ signUnitaryMatrices(ι, ε), ∃ b ∈ cMatrices(ι),
    IsBorelMatrix(ι, o, b) ∧ y = matMul(complexRing, ι, ι, ι, g, b) }

-- SectorBound.lean, weyl_dimension_formula: for the compact form of a
-- parameter l = 2λ with a gap, (∏_{i<n} i!)/∫_{U(n)} |m_{λ−ρ}|² =
-- ∏_{λ_j < λ_i} (λ_i − λ_j).
theorem weyl_dimension_formula (ι l h : Set)
  requires finite : Finite(ι)
  requires gap : HasGap(ι, onesSigns(ι), l, h)
  shows realInvValue(kTypeNormSq(ι, onesSigns(ι), lowestKType(ι, onesSigns(ι), l))) =
    weylDimensionPoly(ι, l)
proof
  sorry

-- FormalDegree.lean, Orbital.dotProduct_add_gain_le_comp_perm
-- (rearrangement with a gain): ⟨o, b⟩ + |b_i − b_{w(i)}| ≤ ⟨o, b∘w⟩.
theorem rearrangement_gain (ι o b w i : Set)
  requires finite : Finite(ι)
  requires ho : (o : ι → ℤ)
  requires hb : (b : ι → ℤ)
  requires order : ∀ p ∈ ι, ∀ q ∈ ι, integerLess(b(q), b(p)) → integerLess(o(p), o(q))
  requires perm : BijectiveBetween(w, ι, ι)
  requires hi : i ∈ ι
  shows R[realFiniteSum(intDotTerms(ι, o, b), ι) + realAbs(R[intReal(b(i)) - intReal(b(w(i)))])] ≤
    realFiniteSum(intDotTerms(ι, o, permuted(ι, b, w)), ι)
proof
  sorry

-- FormalDegree.lean, Orbital.harish_chandra_degree_and_orbital
-- (Harish-Chandra): for λ of gap 500n³ + 10n⁵ and signature (p, q),
-- deg_λ = ∏_{λ_j<λ_i}(λ_i − λ_j)/∏_{i<n} i!, and for x on the torus with
-- distinct entries (−1)^{pq} Σ_{σ ∈ S_n} ∫_G e_λ(g⁻¹ diag(x∘σ) g) dg =
-- #{σ : ε∘σ = ε} · conj χ(x), χ the character of U(n) of highest weight
-- λ − ρ.
def allPerms (ι : Set) : Set := { w ∈ functionSpace(ι, ι) | BijectiveBetween(w, ι, ι) }

def orbitalIntegrand (ι ε l x : Set) : Set :=
  { (g, dsKernel(ι, ε, l, matMul(complexRing, ι, ι, ι,
      matMul(complexRing, ι, ι, ι, matInverse(complexRing, ι, g), diagTorus(ι, x)), g))) |
    g ∈ signUnitaryMatrices(ι, ε) }

def orbitalTerms (ι ε l x : Set) : Set :=
  { (σ, complexMeasureIntegral(signBorel(ι, ε), signHaar(ι, ε), orbitalIntegrand(ι, ε, l, permuted(ι, x, σ)))) |
    σ ∈ allPerms(ι) }

def degreeExponent (ι ε : Set) : Set := cardinality(posNegPairs(ι, ε))

theorem harish_chandra_degree_and_orbital (ι ε l : Set)
  requires finite : Finite(ι)
  requires nonempty : ι ≠ ∅
  requires signs : SignsOn(ι, ε)
  requires gap : HasGap(ι, ε, l, gapThreshold(ι, mul(10, pow(cardinality(ι), 5))))
  shows formalDegree(ι, ε, l) = weylDimensionPoly(ι, l) ∧
    ∀ x ∈ torusPoints(ι), (∀ a ∈ ι, ∀ b ∈ ι, x(a) = x(b) → a = b) →
      ℂ[ℂ[-1] ^ degreeExponent(ι, ε) *
        groupFiniteSum(complexAdditiveGroup, allPerms(ι), orbitalTerms(ι, ε, l, x))] =
      ℂ[complexOfReal(realNat(cardinality(signPerms(ι, ε)))) *
        complexConj(kTypeChar(ι, onesSigns(ι), lowestKType(ι, onesSigns(ι), l), diagTorus(ι, x)))]
proof
  sorry

end DiscreteSeriesCharacter
