-- The real Heisenberg datum of a signature: on ℂ^ι with signs ε, the
-- bicharacter β(x, y) = exp((y*εx − x*εy)/2), the Gaussian vacuum
-- exp(−|x|²/2), the sign projection P₊, the holomorphic coordinates ζ(x)
-- (x̄ᵢ where εᵢ = 1, xᵢ elsewhere), the creation and annihilation
-- operators on polynomials, principal minors, and Lebesgue measure on
-- ℂ^ι divided by π^|ι|; the complex Gaussian integral, linear changes
-- of variables, and Jacobi's complementary minor identity.
-- Source: grh-compact/src/Lib/General/LinearAlgebra/HuaIntegral.lean
-- (realHeis, realVac, posProj, holCoord, holCoord_eq, raiseOp, lowerOp,
-- glOp, heisDeriv, principalMinor, principalMinor_eq_det,
-- principalMinor_fromBlocks, jacobi_complementary_minor),
-- Lib/General/LinearAlgebra/HaarUnique.lean (realMeasure,
-- Matrix.IsAccretive, integral_gauss, lintegral_eq_det_mul,
-- star_dot_self_eq_sum, map_mulVec_haar). Part of: "General lemmas of
-- linear algebra and matrices (textbook or folklore)"; stated here, for
-- the Fock model of the Weil representation (GRH.Weil.Fock), until
-- GRH.General.LinearAlgebra2 exists.
-- Encoding. ℂ^ι is functionSpace(ι, ℂ) for a finite set ι, a group under
-- coordinatewise addition (Module.additive of the coordinate module)
-- with the product topology. Signs ε are the complex numbers ±1
-- (SignsOn, GRH.Adelic.QuotientMeasure). The source's normalised
-- Lebesgue measure is named by its normalisation: the Haar measure under
-- which ∫ |exp(−|x|²/2)|² = 1 (Lebesgue measure gives π^|ι|), unique by
-- HaarUnique.lean, addHaar_eq_of_integral_eq_one. A predicate on ι
-- (the source's p in principalMinor y p) is the subset S of ι where it
-- holds.
-- Part of the GRH blueprint (layer 4, Lib/DiscreteSeries, stage S2).
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.DiscreteSeries.Basic
import GRH.Weil.Unramified
import GRH.Polynomial.Multivariate
import GRH.Matrix.Groups

section DiscreteSeriesBasic
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- Section: The complex coordinate space
-- ℂ^ι, its module, additive group and product topology.
def cVectors (ι : Set) : Set := functionSpace(ι, complexCarrier)

def cVectorModule (ι : Set) : Set := coordinateModule(complexRing, ι)

def cVectorGroup (ι : Set) : Set := Module.additive(cVectorModule(ι))

def cVectorSpace (ι : Set) : Set := piSpace(ι, constantSpaces(ι, complexSpace))

-- The hermitian product x*y = Σᵢ x̄ᵢ yᵢ (star x ⬝ᵥ y) and the signed one
-- x*εy = Σᵢ εᵢ x̄ᵢ yᵢ (star x ⬝ᵥ signMatrix ε *ᵥ y).
def cDotTerms (ι x y : Set) : Set := { (i, ℂ[complexConj(x(i)) * y(i)]) | i ∈ ι }

def cDot (ι x y : Set) : Set := groupFiniteSum(complexAdditiveGroup, ι, cDotTerms(ι, x, y))

def cSignedDotTerms (ι ε x y : Set) : Set :=
  { (i, ℂ[ε(i) * (complexConj(x(i)) * y(i))]) | i ∈ ι }

def cSignedDot (ι ε x y : Set) : Set :=
  groupFiniteSum(complexAdditiveGroup, ι, cSignedDotTerms(ι, ε, x, y))

-- Section: The real Heisenberg datum
-- HuaIntegral.lean, realHeis ε: β(x, y) = exp((y*εx − x*εy)/2) on ℂ^ι.
def realHeis (ι ε : Set) : Set :=
  { (p, complexExp(complexDiv(ℂ[cSignedDot(ι, ε, snd(p), fst(p)) -
      cSignedDot(ι, ε, fst(p), snd(p))], ℂ[2]))) | p ∈ cVectors(ι) × cVectors(ι) }

-- HuaIntegral.lean, realVac: x ↦ exp(−(x*x)/2).
def realVac (ι : Set) : Set :=
  { (x, complexExp(complexDiv(ℂ[-cDot(ι, x, x)], ℂ[2]))) | x ∈ cVectors(ι) }

-- HuaIntegral.lean, posProj ε: the diagonal matrix with entry 1 where
-- εᵢ = 1 and 0 elsewhere.
def signIndicator (ε i : Set) : Set :=
  ⋃({ c ∈ complexCarrier | (ε(i) = complexOne ∧ c = complexOne) ∨
    (ε(i) ≠ complexOne ∧ c = complexZero) })

def posProjEntries (ι ε : Set) : Set := { (i, signIndicator(ε, i)) | i ∈ ι }

def posProj (ι ε : Set) : Set := matDiagonal(complexRing, ι, posProjEntries(ι, ε))

-- HuaIntegral.lean, holCoord ε x (holCoord_eq): the vector with
-- coordinate x̄ᵢ where εᵢ = 1 and xᵢ elsewhere.
def holCoordValue (ε x i : Set) : Set :=
  ⋃({ c ∈ complexCarrier | (ε(i) = complexOne ∧ c = complexConj(x(i))) ∨
    (ε(i) ≠ complexOne ∧ c = x(i)) })

def holCoord (ι ε x : Set) : Set := { (i, holCoordValue(ε, x, i)) | i ∈ ι }

-- HuaIntegral.lean, principalMinor y p: the determinant of the block of
-- the square matrix y on the indices S where p holds.
def principalBlock (y S : Set) : Set := { (q, y(q)) | q ∈ S × S }

def principalMinor (y S : Set) : Set := matDet(complexRing, S, principalBlock(y, S))

-- HaarUnique.lean, realMeasure ι: Lebesgue measure on ℂ^ι divided by
-- π^|ι|, the Haar measure giving the Gaussian |realVac|² = exp(−|x|²)
-- integral one.
def realMeasure (ι : Set) : Set :=
  ⋃({ μ ∈ 𝒫(borelSigma(cVectorSpace(ι)) × ennreal) |
    RegularHaarMeasure(cVectorGroup(ι), cVectorSpace(ι), μ) ∧
    hIntegral(cVectorSpace(ι), μ, vacuumNormSq(cVectorGroup(ι), realVac(ι))) = complexOne })

-- Section: Creation and annihilation operators
-- The polynomials ℂ[X_i, i ∈ ι] and their carrier.
def cPolys (ι : Set) : Set := Ring.carrier(polynomialRing(complexRing, ι))

-- Multiplication by X_a, and −∂/∂X_a.
def mulByVariable (ι a : Set) : Set :=
  { (P, call2(Ring.mul(polynomialRing(complexRing, ι)), X(complexRing, ι, a), P)) |
    P ∈ cPolys(ι) }

def negPartial (ι a : Set) : Set :=
  { (P, apply(Ring.neg(polynomialRing(complexRing, ι)),
      partialDerivative(complexRing, ι, a)(P))) | P ∈ cPolys(ι) }

-- HuaIntegral.lean, raiseOp ε a: multiplication by X_a if ε_a = 1, else
-- −∂/∂X_a; lowerOp ε a: ∂/∂X_a if ε_a = 1, else multiplication by X_a.
def raiseOp (ι ε a : Set) : Set :=
  ⋃({ T ∈ 𝒫(cPolys(ι) × cPolys(ι)) | (ε(a) = complexOne ∧ T = mulByVariable(ι, a)) ∨
    (ε(a) ≠ complexOne ∧ T = negPartial(ι, a)) })

def lowerOp (ι ε a : Set) : Set :=
  ⋃({ T ∈ 𝒫(cPolys(ι) × cPolys(ι)) |
    (ε(a) = complexOne ∧ T = partialDerivative(complexRing, ι, a)) ∨
    (ε(a) ≠ complexOne ∧ T = mulByVariable(ι, a)) })

-- HuaIntegral.lean, glOp ε a b = A_a ∘ B_b.
def glOp (ι ε a b P : Set) : Set := raiseOp(ι, ε, a)(lowerOp(ι, ε, b)(P))

-- HuaIntegral.lean, weilDeriv ε u: P ↦ Σ_{a,b} u_ab A_a B_b P.
def weilDerivTerms (ι ε u P : Set) : Set :=
  { (q, call2(Ring.mul(polynomialRing(complexRing, ι)),
      polynomialConstant(complexRing, ι)(u(q)), glOp(ι, ε, fst(q), snd(q), P))) | q ∈ ι × ι }

def weilDeriv (ι ε u P : Set) : Set :=
  groupFiniteSum(Ring.additive(polynomialRing(complexRing, ι)), ι × ι,
    weilDerivTerms(ι, ε, u, P))

-- HuaIntegral.lean, heisDeriv ε x: P ↦ Σᵢ (xᵢ A_i − conj(xᵢεᵢ) B_i) P.
def heisDerivTerms (ι ε x P : Set) : Set :=
  { (i, call2(Ring.add(polynomialRing(complexRing, ι)),
      call2(Ring.mul(polynomialRing(complexRing, ι)),
        polynomialConstant(complexRing, ι)(x(i)), raiseOp(ι, ε, i)(P)),
      apply(Ring.neg(polynomialRing(complexRing, ι)),
        call2(Ring.mul(polynomialRing(complexRing, ι)),
          polynomialConstant(complexRing, ι)(complexConj(ℂ[x(i) * ε(i)])),
          lowerOp(ι, ε, i)(P))))) | i ∈ ι }

def heisDeriv (ι ε x P : Set) : Set :=
  groupFiniteSum(Ring.additive(polynomialRing(complexRing, ι)), ι, heisDerivTerms(ι, ε, x, P))

-- Section: The Heisenberg datum, the vacuum and the measure
-- HuaIntegral.lean, realHeis: a Heisenberg datum on ℂ^ι.
theorem realHeis.heisenberg (ι ε : Set)
  requires finite : Finite(ι)
  requires signs : SignsOn(ι, ε)
  shows HeisenbergDatum(cVectorGroup(ι), cVectorSpace(ι), realHeis(ι, ε))
proof
  sorry

-- The value of β (by definition of realHeis).
theorem realHeis.apply (ι ε x y : Set)
  requires hx : x ∈ cVectors(ι)
  requires hy : y ∈ cVectors(ι)
  shows realHeis(ι, ε)(x, y) = complexExp(complexDiv(ℂ[cSignedDot(ι, ε, y, x) -
    cSignedDot(ι, ε, x, y)], ℂ[2]))
proof
  sorry

-- HaarUnique.lean: realMeasure is a regular Haar measure with the
-- Gaussian normalisation (Lebesgue measure gives ∫ exp(−|x|²) = π^|ι|),
-- and it is the only one (addHaar_eq_of_integral_eq_one).
theorem realMeasure.haar (ι : Set)
  requires finite : Finite(ι)
  shows RegularHaarMeasure(cVectorGroup(ι), cVectorSpace(ι), realMeasure(ι)) ∧
    hIntegral(cVectorSpace(ι), realMeasure(ι),
      vacuumNormSq(cVectorGroup(ι), realVac(ι))) = complexOne
proof
  sorry

theorem realMeasure.unique (ι μ : Set)
  requires finite : Finite(ι)
  requires haar : RegularHaarMeasure(cVectorGroup(ι), cVectorSpace(ι), μ)
  requires normalized : hIntegral(cVectorSpace(ι), μ,
    vacuumNormSq(cVectorGroup(ι), realVac(ι))) = complexOne
  shows μ = realMeasure(ι)
proof
  sorry

-- HaarUnique.lean, star_dot_self_eq_sum: x*x = Σᵢ |xᵢ|².
def absSqTerms (ι x : Set) : Set := { (i, R[complexAbs(x(i)) ^ 2]) | i ∈ ι }

theorem cDot.self (ι x : Set)
  requires finite : Finite(ι)
  requires hx : x ∈ cVectors(ι)
  shows cDot(ι, x, x) = complexOfReal(realFiniteSum(absSqTerms(ι, x), ι))
proof
  sorry

-- The zero vector of ℂ^ι.
def matZeroVector (ι : Set) : Set := ι × {complexZero}

-- HaarUnique.lean, Matrix.IsAccretive: A + Aᴴ is positive definite,
-- that is Re(v*Av) > 0 for every v ≠ 0.
predicate IsAccretive (ι A : Set) :=
  A ∈ matrixSpace(complexRing, ι, ι) ∧
  ∀ v ∈ cVectors(ι), v ≠ matZeroVector(ι) →
    realZero < complexRe(cDot(ι, v, mulVec(complexRing, ι, ι, A, v)))

-- The integrand x ↦ exp(−x*A(x − a)).
def gaussIntegrand (ι A a : Set) : Set :=
  { (x, complexExp(ℂ[-cDot(ι, x, mulVec(complexRing, ι, ι, A,
      vecAdd(complexRing, ι, x, vecSmul(complexRing, ι, ℂ[-1], a))))])) | x ∈ cVectors(ι) }

-- HaarUnique.lean, integral_gauss: for A accretive and any a,
-- ∫ exp(−x*A(x − a)) d realMeasure = (det A)⁻¹.
theorem realMeasure.integral_gauss (ι A a : Set)
  requires finite : Finite(ι)
  requires accretive : IsAccretive(ι, A)
  requires ha : a ∈ cVectors(ι)
  shows hIntegral(cVectorSpace(ι), realMeasure(ι), gaussIntegrand(ι, A, a)) =
    complexInv(matDet(complexRing, ι, A))
proof
  sorry

-- The function y ↦ g(Ay) for a matrix A.
def linearPullback (ι A g : Set) : Set :=
  { (y, g(mulVec(complexRing, ι, ι, A, y))) | y ∈ cVectors(ι) }

-- HaarUnique.lean, lintegral_eq_det_mul: for det A ≠ 0 and g ≥ 0,
-- ∫ g(y) dy = |det A|² ∫ g(Ay) dy (lower integrals).
theorem realMeasure.lintegral_linear (ι A g : Set)
  requires finite : Finite(ι)
  requires hA : A ∈ matrixSpace(complexRing, ι, ι)
  requires invertible : matDet(complexRing, ι, A) ≠ complexZero
  requires hg : FunctionBetween(g, cVectors(ι), ennreal)
  shows lintegral(borelSpace(cVectorSpace(ι)), realMeasure(ι), g) =
    ennMul(ennOfReal(R[complexAbs(matDet(complexRing, ι, A)) ^ 2]),
      lintegral(borelSpace(cVectorSpace(ι)), realMeasure(ι), linearPullback(ι, A, g)))
proof
  sorry

-- Section: Principal minors
-- HuaIntegral.lean, principalMinor_eq_det: det(1 − D(1 − y)), D the
-- diagonal indicator of S.
def setIndicator (S i : Set) : Set :=
  ⋃({ c ∈ complexCarrier | (i ∈ S ∧ c = complexOne) ∨ (i ∉ S ∧ c = complexZero) })

def indicatorEntries (ι S : Set) : Set := { (i, setIndicator(S, i)) | i ∈ ι }

def indicatorDiagonal (ι S : Set) : Set := matDiagonal(complexRing, ι, indicatorEntries(ι, S))

def matSub (ι A B : Set) : Set := matAdd(complexRing, ι, ι, A, matNeg(complexRing, ι, ι, B))

theorem principalMinor.eq_det (ι y S : Set)
  requires finite : Finite(ι)
  requires hy : y ∈ matrixSpace(complexRing, ι, ι)
  requires hS : S ⊆ ι
  shows principalMinor(y, S) = matDet(complexRing, ι, matSub(ι, matOne(complexRing, ι),
    matMul(complexRing, ι, ι, ι, indicatorDiagonal(ι, S),
      matSub(ι, matOne(complexRing, ι), y))))
proof
  sorry

-- HuaIntegral.lean, principalMinor_fromBlocks: for a block diagonal
-- matrix diag(x, y) on ι₁ ⊔ ι₂, the minor on S is the product of the
-- minors on the two parts of S.
theorem principalMinor.from_blocks (ι1 ι2 x y S : Set)
  requires finite1 : Finite(ι1)
  requires finite2 : Finite(ι2)
  requires hx : x ∈ matrixSpace(complexRing, ι1, ι1)
  requires hy : y ∈ matrixSpace(complexRing, ι2, ι2)
  requires hS : S ⊆ ι1 ⊎ ι2
  shows principalMinor(fromBlocks(complexRing, ι1, ι2, ι1, ι2, x,
      matZero(complexRing, ι1, ι2), matZero(complexRing, ι2, ι1), y), S) =
    ℂ[principalMinor(x, functionPreimage(leftInclusion(ι1, ι2), ι1, S)) *
      principalMinor(y, functionPreimage(rightInclusion(ι1, ι2), ι2, S))]
proof
  sorry

-- HuaIntegral.lean, jacobi_complementary_minor: for det x ≠ 0, the
-- minor of x⁻¹ on S is the minor of x on ι ∖ S divided by det x.
theorem principalMinor.jacobi (ι x S : Set)
  requires finite : Finite(ι)
  requires hx : x ∈ matrixSpace(complexRing, ι, ι)
  requires invertible : matDet(complexRing, ι, x) ≠ complexZero
  requires hS : S ⊆ ι
  shows principalMinor(matInverse(complexRing, ι, x), S) =
    complexDiv(principalMinor(x, ι ∖ S), matDet(complexRing, ι, x))
proof
  sorry

end DiscreteSeriesBasic
