-- Rigidity of discrete series coefficients: for λ of gap 500n³ + A, the
-- kernel e_λ = deg_λ ψ̄_λ is an idempotent; for a unitarisable Banach
-- representation π of U(p, q) with derivative ρ along ι and a K-highest
-- vector v of weight Λ with Ωv = cv, c ≥ |λ|² − |ρ|², the coefficient
-- B(ιv, π(g)ιv) is B(ιv, ιv)ψ_λ(g), π(f) fixes ιv whenever f ∗ e_λ = e_λ, and
-- c = |λ|² − |ρ|² when ιv ≠ 0.
-- Source: grh-compact/src/Lib/DiscreteSeries/Rigidity/KernelFixes.lean
-- (continuous_dsKernel, conj_dsKernel_neg, integratedRep,
-- IsKHighest.integral_conj_weightMinors_smul,
-- HasLargeGap.isIdempotentKernel_dsKernel,
-- HasLargeGap.exists_bump_conv_dsKernel, integratedRep_dsKernel_casimir,
-- integratedRep_eq_zero_of_notMem_rootCone, coeff_eq_dsCoeff_of_isKHighest,
-- integratedRep_fix_of_isKHighest, eq_casimirValue_of_ge). Known result:
-- "Lowest K-type and Casimir value determine a discrete series coefficient;
-- analytic vectors."
-- Not stated: re_integral_pos, integrable_smul_rep, map_integratedRep and
-- exists_integration_by_parts, steps of the proofs.
-- Encoding. π(f)x = ∫ f(g)π(g)x dg is the Bochner integral (banachIntegral
-- of GRH.Measure.Bochner) in the Banach space X; the source's integral of
-- operators (strongIntegral) is taken pointwise. Continuous linear
-- functionals φ on X are functions X → ℂ with ContinuousLinearMap.
-- Part of the GRH blueprint (layer 4, Lib/DiscreteSeries, stage S2).
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.DiscreteSeries.KernelFixes
import GRH.DiscreteSeries.CuspKernel

section DiscreteSeriesKernelFixes
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- Section: The kernel e_λ
-- KernelFixes.lean, continuous_dsKernel and conj_dsKernel_neg:
-- conj e_{−λ} = e_λ.
theorem dsKernel.conj_neg (ι ε l h x : Set)
  requires finite : Finite(ι)
  requires signs : SignsOn(ι, ε)
  requires gap : HasGap(ι, ε, l, h)
  requires hx : x ∈ signUnitaryMatrices(ι, ε)
  shows complexConj(dsKernel(ι, ε, intVecNeg(ι, l), x)) = dsKernel(ι, ε, l, x) ∧
    (dsKernelOn(ι, ε, l) : signUnitarySpace(ι, ε) ⇒ complexSpace)
proof
  sorry

-- KernelFixes.lean, HasLargeGap.isIdempotentKernel_dsKernel: e_λ is a
-- continuous integrable minimal idempotent.
theorem dsKernel.idempotent (ι ε l : Set, A : Nat)
  requires finite : Finite(ι)
  requires nonempty : ι ≠ ∅
  requires signs : SignsOn(ι, ε)
  requires gap : HasLargeGap(ι, ε, l, A)
  shows IsIdempotentKernel(signUnitaryGroup(ι, ε), signUnitarySpace(ι, ε), signHaar(ι, ε),
    dsKernelOn(ι, ε, l))
proof
  sorry

-- KernelFixes.lean, HasLargeGap.exists_bump_conv_dsKernel: some bump α
-- has ∫ α(x⁻¹) e_λ(x⁻¹g) dx = e_λ(g).
def bumpConvIntegrand (ι ε l α g : Set) : Set :=
  { (x, ℂ[α(matInverse(complexRing, ι, x)) *
      dsKernel(ι, ε, l, matMul(complexRing, ι, ι, ι, matInverse(complexRing, ι, x), g))]) |
    x ∈ signUnitaryMatrices(ι, ε) }

theorem dsKernel.exists_bump_conv (ι ε l : Set, A : Nat)
  requires finite : Finite(ι)
  requires nonempty : ι ≠ ∅
  requires signs : SignsOn(ι, ε)
  requires gap : HasLargeGap(ι, ε, l, A)
  shows ∃ α ∈ bumps(ι, ε), ∀ g ∈ signUnitaryMatrices(ι, ε),
    complexMeasureIntegral(signBorel(ι, ε), signHaar(ι, ε), bumpConvIntegrand(ι, ε, l, α, g)) =
      dsKernel(ι, ε, l, g)
proof
  sorry

-- Section: Integrated representations
-- KernelFixes.lean, integratedRep π f: x ↦ ∫ f(g)π(g)x dg.
def repIntegrand (ι ε X π f x : Set) : Set :=
  { (g, Module.smul(X)(f(g), π(g)(x))) | g ∈ signUnitaryMatrices(ι, ε) }

def integratedRep (ι ε X norm π f : Set) : Set :=
  { (x, banachIntegral(signBorel(ι, ε), signHaar(ι, ε), X, complexOfReal, norm,
      repIntegrand(ι, ε, X, π, f, x))) | x ∈ Module.carrier(X) }

-- KernelFixes.lean, IsKHighest.integral_conj_weightMinors_smul: for v
-- K-highest of K-dominant weight ν, ∫_K conj m_ν(k) φ(π(k)ιv) dk =
-- c_ν φ(ιv) for every continuous linear functional φ.
def kFunctionalIntegrand (ι ε ν φ π w : Set) : Set :=
  { (k, ℂ[complexConj(weightMinors(ι, ν, k)) * φ(π(k)(w))]) | k ∈ maxCompactU(ι, ε) }

theorem IsKHighest.k_projection (ι ε l h X norm π B M e ρ ν v φ : Set, A : Nat)
  requires finite : Finite(ι)
  requires signs : SignsOn(ι, ε)
  requires gap : HasGap(ι, ε, l, h)
  requires rep : IsUnitaryRep(ι, signMatrix(complexRing, ι, ε), X, norm, A, π, B)
  requires glm : IsGlModule(ι, M, ρ)
  requires he : LinearMap(e, M, complexRing, X)
  requires derived : IsDerivedAction(ι, signMatrix(complexRing, ι, ε), X, norm, π, M, e, ρ)
  requires hν : (ν : ι → ℤ)
  requires highest : IsKHighest(ι, ε, l, M, ρ, ν, v)
  requires dominant : IsKDominant(ι, ε, intVecNeg(ι, l), ν)
  requires hφ : ContinuousLinearMap(φ, X, norm, complexSelfModule, complexAbs, complexRing)
  shows complexMeasureIntegral(maxCompactBorel(ι, ε), haarK(ι, ε),
      kFunctionalIntegrand(ι, ε, ν, φ, π, e(v))) =
    ℂ[complexOfReal(kTypeNormSq(ι, ε, ν)) * φ(e(v))]
proof
  sorry

-- The common hypotheses of the rigidity theorems: λ of gap 500n³ + A,
-- π unitarisable of exponent A on a Banach space with derivative ρ along e,
-- v K-highest of weight Λ with e(Ωv) = c·e(v), c ≥ |λ|² − |ρ|².
predicate RigiditySetting (ι ε l X norm π B M e ρ v c : Set, A : Nat) :=
  Finite(ι) ∧ ι ≠ ∅ ∧ SignsOn(ι, ε) ∧ HasLargeGap(ι, ε, l, A) ∧
  BanachSpace(X, complexRing, complexAbs, norm) ∧
  IsUnitaryRep(ι, signMatrix(complexRing, ι, ε), X, norm, A, π, B) ∧
  IsGlModule(ι, M, ρ) ∧ LinearMap(e, M, complexRing, X) ∧
  IsDerivedAction(ι, signMatrix(complexRing, ι, ε), X, norm, π, M, e, ρ) ∧
  IsKHighest(ι, ε, l, M, ρ, lowestKType(ι, ε, l), v) ∧ c ∈ ℝ ∧
  e(glCasimirFull(ι, M, ρ)(v)) = Module.smul(X)(complexOfReal(c), e(v)) ∧
  casimirValue(ι, l) ≤ c

-- KernelFixes.lean, integratedRep_dsKernel_casimir: π(e_λ) e(Ωv) =
-- (|λ|² − |ρ|²) π(e_λ) e(v).
theorem integratedRep.casimir (ι ε l X norm π B M e ρ v c : Set, A : Nat)
  requires setting : RigiditySetting(ι, ε, l, X, norm, π, B, M, e, ρ, v, c, A)
  shows integratedRep(ι, ε, X, norm, π, dsKernelOn(ι, ε, l))(e(glCasimirFull(ι, M, ρ)(v))) =
    Module.smul(X)(complexOfReal(casimirValue(ι, l)),
      integratedRep(ι, ε, X, norm, π, dsKernelOn(ι, ε, l))(e(v)))
proof
  sorry

-- KernelFixes.lean, integratedRep_eq_zero_of_notMem_rootCone: π(e_λ) kills
-- π(y)e(w) for w K-highest of weight ν with ν − Λ outside the root cone.
theorem integratedRep.eq_zero_of_not_cone (ι ε l X norm π B M e ρ v c ν w y : Set, A : Nat)
  requires setting : RigiditySetting(ι, ε, l, X, norm, π, B, M, e, ρ, v, c, A)
  requires hν : (ν : ι → ℤ)
  requires highest : IsKHighest(ι, ε, l, M, ρ, ν, w)
  requires cone : intVecSub(ι, ν, lowestKType(ι, ε, l)) ∉ rootCone(ι, l)
  requires hy : y ∈ signUnitaryMatrices(ι, ε)
  shows integratedRep(ι, ε, X, norm, π, dsKernelOn(ι, ε, l))(π(y)(e(w))) = Module.zero(X)
proof
  sorry

-- KernelFixes.lean, coeff_eq_dsCoeff_of_isKHighest (rigidity):
-- B(ιv, π(g)ιv) = B(ιv, ιv) ψ_λ(g).
theorem rigidity.coeff_eq_dsCoeff (ι ε l X norm π B M e ρ v c g : Set, A : Nat)
  requires setting : RigiditySetting(ι, ε, l, X, norm, π, B, M, e, ρ, v, c, A)
  requires hg : g ∈ signUnitaryMatrices(ι, ε)
  shows B(e(v), π(g)(e(v))) = ℂ[B(e(v), e(v)) * dsCoeff(ι, ε, l, g)]
proof
  sorry

-- KernelFixes.lean, integratedRep_fix_of_isKHighest (rigidity): π(f) fixes
-- ιv when ‖g‖^A f is integrable and f ∗ e_λ = e_λ.
def normPowWeighted (ι ε f : Set, A : Nat) : Set :=
  { (g, ℂ[f(g) * complexOfReal(R[matOpNorm(ι, g) ^ A])]) | g ∈ signUnitaryMatrices(ι, ε) }

def kernelConvIntegrand (ι ε l f g : Set) : Set :=
  { (y, ℂ[f(y) * dsKernel(ι, ε, l, matMul(complexRing, ι, ι, ι, matInverse(complexRing, ι, y), g))]) |
    y ∈ signUnitaryMatrices(ι, ε) }

theorem rigidity.integratedRep_fix (ι ε l X norm π B M e ρ v c f : Set, A : Nat)
  requires setting : RigiditySetting(ι, ε, l, X, norm, π, B, M, e, ρ, v, c, A)
  requires hf : FunctionBetween(f, signUnitaryMatrices(ι, ε), complexCarrier)
  requires integrable : ComplexIntegrable(signBorel(ι, ε), signHaar(ι, ε), normPowWeighted(ι, ε, f, A))
  requires conv : ∀ g ∈ signUnitaryMatrices(ι, ε),
    complexMeasureIntegral(signBorel(ι, ε), signHaar(ι, ε), kernelConvIntegrand(ι, ε, l, f, g)) =
      dsKernel(ι, ε, l, g)
  shows integratedRep(ι, ε, X, norm, π, f)(e(v)) = e(v)
proof
  sorry

-- KernelFixes.lean, eq_casimirValue_of_ge (rigidity): if ιv ≠ 0 then
-- c = |λ|² − |ρ|².
theorem rigidity.eq_casimirValue (ι ε l X norm π B M e ρ v c : Set, A : Nat)
  requires setting : RigiditySetting(ι, ε, l, X, norm, π, B, M, e, ρ, v, c, A)
  requires nonzero : e(v) ≠ Module.zero(X)
  shows c = casimirValue(ι, l)
proof
  sorry

end DiscreteSeriesKernelFixes
