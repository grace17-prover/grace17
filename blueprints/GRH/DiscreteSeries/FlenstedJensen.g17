-- Flensted-Jensen's function ψ_λ, the coefficient of the lowest K-type of
-- a discrete series of U(p, q): independence of the splitting, analyticity,
-- ψ_λ(1) = 1, the polar formula, ψ_λ(g⁻¹) = ψ̄_λ(g) = ψ_{−λ}(g), ψ_λ = m_Λ
-- on K, smoothness, the Casimir eigenvalue Ωψ_λ = (|λ|² − |ρ|²)ψ_λ, the
-- K-type projection, and the decay |ψ_λ(g)| ≤ (2/‖g‖)^c for c ≤ the gap.
-- Source: grh-compact/src/Lib/DiscreteSeries/FlenstedJensen/FlenstedJensenInvariance.lean
-- (twoRho_lt_twoRho, analyticAt_matrix_inv, HCParam.analyticAt_dsCoeff,
-- HasGap.paramAddRho_lt_iff, HasGap.isKDominant_neg_paramAddRho,
-- HasGap.isKDominant_lowestKType, flenstedJensen_eq_of_accretive,
-- dsCoeff_eq_flenstedJensen), FlenstedJensen/PsiBasic.lean
-- (weightMinors_unitary_inv, dsCoeff_one, dsCoeff_polar, dsCoeff_inv,
-- dsCoeff_neg, dsCoeff_of_mem_maxCompactU), FlenstedJensen/PsiSmooth.lean
-- (HCParam.dsCoeffSmooth, continuous_dsCoeff),
-- FlenstedJensen/CasimirOnPsi.lean (exists_equiv_fin_lt_iff,
-- casimir_dsCoeffSmooth), FlenstedJensen/KTypeProjection.lean
-- (integral_conj_weightMinors_mul_dsCoeff), FlenstedJensen/PsiDecay.lean
-- (weightMinors_pos, norm_dsCoeff_sq_mul_det_pow_le_one,
-- norm_dsCoeff_le_pow). Known result: "Flensted-Jensen's function:
-- coefficient of the lowest K-type of a discrete series."
-- Not stated: fderiv_eq_of_borel_equivariant and
-- isAnalyticFamily_flenstedJensen, steps of the proofs.
-- Encoding. As in GRH.DiscreteSeries.Representation; ψ_λ is defined on all
-- complex matrices (dsCoeff) and analytic at the points of U(diag ε). A
-- complex number is positive when it is a positive real.
-- Part of the GRH blueprint (layer 4, Lib/DiscreteSeries, stage S2).
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.DiscreteSeries.FlenstedJensen
import GRH.DiscreteSeries.Holomorphic
import GRH.DiscreteSeries.RightDerivatives

section DiscreteSeriesFlenstedJensen
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- Section: Independence of the splitting
-- FlenstedJensenInvariance.lean, twoRho_lt_twoRho: l_a < l_b gives
-- 2ρ_a < 2ρ_b.
theorem twoRho.lt (ι l a b : Set)
  requires finite : Finite(ι)
  requires hl : (l : ι → ℤ)
  requires ha : a ∈ ι
  requires hb : b ∈ ι
  requires lt : integerLess(l(a), l(b))
  shows integerLess(twoRho(ι, l, allPairs(ι), a), twoRho(ι, l, allPairs(ι), b))
proof
  sorry

-- FlenstedJensenInvariance.lean, HasGap.paramAddRho_lt_iff.
theorem HasGap.paramAddRho_lt_iff (ι ε l h i j : Set)
  requires finite : Finite(ι)
  requires gap : HasGap(ι, ε, l, h)
  requires hi : i ∈ ι
  requires hj : j ∈ ι
  shows integerLess(paramAddRho(ι, l)(i), paramAddRho(ι, l)(j)) ↔ integerLess(l(i), l(j))
proof
  sorry

-- FlenstedJensenInvariance.lean, HasGap.isKDominant_neg_paramAddRho and
-- HasGap.isKDominant_lowestKType: −μ is dominant for (1, l) and Λ for (ε, −l).
theorem HasGap.dominant (ι ε l h : Set)
  requires finite : Finite(ι)
  requires gap : HasGap(ι, ε, l, h)
  shows IsKDominant(ι, onesSigns(ι), l, intVecNeg(ι, paramAddRho(ι, l))) ∧
    IsKDominant(ι, ε, intVecNeg(ι, l), lowestKType(ι, ε, l))
proof
  sorry

-- ψ_λ as a function on all matrices.
def dsCoeffMat (ι ε l : Set) : Set := { (g, dsCoeff(ι, ε, l, g)) | g ∈ cMatrices(ι) }

-- FlenstedJensenInvariance.lean, HCParam.analyticAt_dsCoeff: ψ_λ is complex
-- analytic at every point of U(diag ε).
theorem dsCoeff.analytic (ι ε l g : Set)
  requires finite : Finite(ι)
  requires signs : SignsOn(ι, ε)
  requires hl : (l : ι → ℤ)
  requires hg : g ∈ signUnitaryMatrices(ι, ε)
  shows CHolomorphicAt(ι × ι, dsCoeffMat(ι, ε, l), g)
proof
  sorry

-- FlenstedJensenInvariance.lean, flenstedJensen_eq_of_accretive: for a, b
-- block diagonal with a⁻¹g and b⁻¹g accretive, Ξ(b, b⁻¹g) = Ξ(a, a⁻¹g).
def leftDivide (ι a g : Set) : Set := matMul(complexRing, ι, ι, ι, matInverse(complexRing, ι, a), g)

theorem flenstedJensen.eq_of_accretive (ι ε l h g a b : Set)
  requires finite : Finite(ι)
  requires signs : SignsOn(ι, ε)
  requires gap : HasGap(ι, ε, l, h)
  requires hg : g ∈ cMatrices(ι)
  requires ha : a ∈ blockDiagAlg(ι, ε)
  requires accA : IsAccretive(ι, leftDivide(ι, a, g))
  requires hb : b ∈ blockDiagAlg(ι, ε)
  requires accB : IsAccretive(ι, leftDivide(ι, b, g))
  shows flenstedJensen(ι, ε, l, b, leftDivide(ι, b, g)) =
    flenstedJensen(ι, ε, l, a, leftDivide(ι, a, g))
proof
  sorry

-- FlenstedJensenInvariance.lean, dsCoeff_eq_flenstedJensen.
theorem dsCoeff.eq_flenstedJensen (ι ε l h g a : Set)
  requires finite : Finite(ι)
  requires signs : SignsOn(ι, ε)
  requires gap : HasGap(ι, ε, l, h)
  requires hg : g ∈ signUnitaryMatrices(ι, ε)
  requires ha : a ∈ blockDiagAlg(ι, ε)
  requires acc : IsAccretive(ι, leftDivide(ι, a, g))
  shows dsCoeff(ι, ε, l, g) = flenstedJensen(ι, ε, l, a, leftDivide(ι, a, g))
proof
  sorry

-- Section: Basic laws
-- PsiBasic.lean, weightMinors_unitary_inv: m_w(g⁻¹) = conj m_w(g) on
-- U(diag ε).
theorem weightMinors.unitary_inv (ι ε w g : Set)
  requires finite : Finite(ι)
  requires signs : SignsOn(ι, ε)
  requires hw : (w : ι → ℤ)
  requires hg : g ∈ signUnitaryMatrices(ι, ε)
  shows weightMinors(ι, w, matInverse(complexRing, ι, g)) = complexConj(weightMinors(ι, w, g))
proof
  sorry

-- PsiBasic.lean, dsCoeff_one: ψ_λ(1) = 1.
theorem dsCoeff.one (ι ε l h : Set)
  requires finite : Finite(ι)
  requires signs : SignsOn(ι, ε)
  requires gap : HasGap(ι, ε, l, h)
  shows dsCoeff(ι, ε, l, matOne(complexRing, ι)) = complexOne
proof
  sorry

-- A positive definite hermitian matrix.
predicate IsPosDefMatrix (ι z : Set) :=
  z ∈ cMatrices(ι) ∧ IsHermitianMatrix(complexRing, complexConj, ι, z) ∧
  ∀ v ∈ cVectors(ι), v ≠ matZeroVector(ι) →
    realZero < complexRe(cDot(ι, v, mulVec(complexRing, ι, ι, z, v)))

-- PsiBasic.lean, dsCoeff_polar: for p, q ∈ K and z ∈ U(diag ε) positive
-- definite, ψ_λ(pzq⁻¹) = c_Λ⁻¹ ∫_K m_Λ(pu) conj m_Λ(qu) / m_{−μ}(uᴴzu) du.
def dsPolarIntegrand (ι ε l p q z : Set) : Set :=
  { (u, complexDiv(ℂ[weightMinors(ι, lowestKType(ι, ε, l), matMul(complexRing, ι, ι, ι, p, u)) *
        complexConj(weightMinors(ι, lowestKType(ι, ε, l), matMul(complexRing, ι, ι, ι, q, u)))],
      weightMinors(ι, intVecNeg(ι, paramAddRho(ι, l)),
        gramMatrix(complexRing, complexConj, ι, ι, ι, z, u, u)))) | u ∈ maxCompactU(ι, ε) }

theorem dsCoeff.polar (ι ε l h p q z : Set)
  requires finite : Finite(ι)
  requires signs : SignsOn(ι, ε)
  requires gap : HasGap(ι, ε, l, h)
  requires hp : p ∈ maxCompactU(ι, ε)
  requires hq : q ∈ maxCompactU(ι, ε)
  requires hz : z ∈ signUnitaryMatrices(ι, ε)
  requires posdef : IsPosDefMatrix(ι, z)
  shows dsCoeff(ι, ε, l, matMul(complexRing, ι, ι, ι, matMul(complexRing, ι, ι, ι, p, z),
      matInverse(complexRing, ι, q))) =
    complexDiv(complexMeasureIntegral(maxCompactBorel(ι, ε), haarK(ι, ε),
        dsPolarIntegrand(ι, ε, l, p, q, z)),
      complexOfReal(kTypeNormSq(ι, ε, lowestKType(ι, ε, l))))
proof
  sorry

-- PsiBasic.lean, dsCoeff_inv and dsCoeff_neg: ψ_λ(g⁻¹) = conj ψ_λ(g) =
-- ψ_{−λ}(g).
theorem dsCoeff.inv_neg (ι ε l h g : Set)
  requires finite : Finite(ι)
  requires signs : SignsOn(ι, ε)
  requires gap : HasGap(ι, ε, l, h)
  requires hg : g ∈ signUnitaryMatrices(ι, ε)
  shows dsCoeff(ι, ε, l, matInverse(complexRing, ι, g)) = complexConj(dsCoeff(ι, ε, l, g)) ∧
    dsCoeff(ι, ε, intVecNeg(ι, l), g) = complexConj(dsCoeff(ι, ε, l, g))
proof
  sorry

-- PsiBasic.lean, dsCoeff_of_mem_maxCompactU: ψ_λ = m_Λ on K.
theorem dsCoeff.compact (ι ε l h k : Set)
  requires finite : Finite(ι)
  requires signs : SignsOn(ι, ε)
  requires gap : HasGap(ι, ε, l, h)
  requires hk : k ∈ maxCompactU(ι, ε)
  shows dsCoeff(ι, ε, l, k) = weightMinors(ι, lowestKType(ι, ε, l), k)
proof
  sorry

-- Section: Smoothness and the Casimir operator
-- PsiSmooth.lean, HCParam.dsCoeffSmooth: ψ_λ restricted to U(diag ε) is
-- smooth (and continuous).
theorem dsCoeff.smooth (ι ε l : Set)
  requires finite : Finite(ι)
  requires signs : SignsOn(ι, ε)
  requires hl : (l : ι → ℤ)
  shows dsCoeffOn(ι, ε, l) ∈ smoothU(ι, ε)
proof
  sorry

-- CasimirOnPsi.lean, casimir_dsCoeffSmooth: Ωψ_λ = (|λ|² − |ρ|²)ψ_λ for
-- Ω = Σ E_ab E_ba acting by right derivatives.
theorem dsCoeff.casimir (ι ε l h : Set)
  requires finite : Finite(ι)
  requires signs : SignsOn(ι, ε)
  requires gap : HasGap(ι, ε, l, h)
  shows glCasimirFull(ι, smoothUModule(ι, ε), rightDeriv(ι, ε))(dsCoeffOn(ι, ε, l)) =
    Module.smul(smoothUModule(ι, ε))(complexOfReal(casimirValue(ι, l)), dsCoeffOn(ι, ε, l))
proof
  sorry

-- Section: The K-type projection
-- KTypeProjection.lean, integral_conj_weightMinors_mul_dsCoeff: for ν
-- dominant for (ε, −l), equal to Λ or with ν − Λ outside the root cone,
-- ∫_K conj m_ν(k) ψ_λ(xkb) dk = c_Λ ψ_λ(x)ψ_λ(b) if ν = Λ, and 0 otherwise.
def kProjectionIntegrand (ι ε l ν x b : Set) : Set :=
  { (k, ℂ[complexConj(weightMinors(ι, ν, k)) * dsCoeff(ι, ε, l,
      matMul(complexRing, ι, ι, ι, matMul(complexRing, ι, ι, ι, x, k), b))]) | k ∈ maxCompactU(ι, ε) }

theorem dsCoeff.kType_projection (ι ε l h ν x b : Set)
  requires finite : Finite(ι)
  requires signs : SignsOn(ι, ε)
  requires gap : HasGap(ι, ε, l, h)
  requires hν : (ν : ι → ℤ)
  requires dominant : IsKDominant(ι, ε, intVecNeg(ι, l), ν)
  requires cone : ν = lowestKType(ι, ε, l) ∨ intVecSub(ι, ν, lowestKType(ι, ε, l)) ∉ rootCone(ι, l)
  requires hx : x ∈ signUnitaryMatrices(ι, ε)
  requires hb : b ∈ signUnitaryMatrices(ι, ε)
  shows (ν = lowestKType(ι, ε, l) → complexMeasureIntegral(maxCompactBorel(ι, ε), haarK(ι, ε),
      kProjectionIntegrand(ι, ε, l, ν, x, b)) =
      ℂ[complexOfReal(kTypeNormSq(ι, ε, lowestKType(ι, ε, l))) *
        (dsCoeff(ι, ε, l, x) * dsCoeff(ι, ε, l, b))]) ∧
    (ν ≠ lowestKType(ι, ε, l) → complexMeasureIntegral(maxCompactBorel(ι, ε), haarK(ι, ε),
      kProjectionIntegrand(ι, ε, l, ν, x, b)) = complexZero)
proof
  sorry

-- Section: Decay
-- PsiDecay.lean, weightMinors_pos: m_w(z) is a positive real for z
-- positive definite.
theorem weightMinors.pos (ι w z : Set)
  requires finite : Finite(ι)
  requires hw : (w : ι → ℤ)
  requires posdef : IsPosDefMatrix(ι, z)
  shows complexIm(weightMinors(ι, w, z)) = realZero ∧ realZero < complexRe(weightMinors(ι, w, z))
proof
  sorry

-- PsiDecay.lean, norm_dsCoeff_sq_mul_det_pow_le_one: for c ≤ h,
-- |ψ_λ(g)|² |det a_g|^c ≤ 1, a_g the block diagonal part of g.
theorem dsCoeff.sq_mul_det_pow_le_one (ι ε l h g : Set, c : Nat)
  requires finite : Finite(ι)
  requires signs : SignsOn(ι, ε)
  requires gap : HasGap(ι, ε, l, h)
  requires hc : realNat(c) ≤ h
  requires hg : g ∈ signUnitaryMatrices(ι, ε)
  shows R[complexAbs(dsCoeff(ι, ε, l, g)) ^ 2 *
    complexAbs(matDet(complexRing, ι, blockDiagPart(ι, ε, g))) ^ c] ≤ realOne
proof
  sorry

-- PsiDecay.lean, norm_dsCoeff_le_pow: |ψ_λ(g)| ≤ (2/‖g‖)^c for c ≤ h,
-- n ≥ 1.
theorem dsCoeff.le_pow (ι ε l h g : Set, c : Nat)
  requires finite : Finite(ι)
  requires nonempty : ι ≠ ∅
  requires signs : SignsOn(ι, ε)
  requires gap : HasGap(ι, ε, l, h)
  requires hc : realNat(c) ≤ h
  requires hg : g ∈ signUnitaryMatrices(ι, ε)
  shows complexAbs(dsCoeff(ι, ε, l, g)) ≤ R[realDiv(R[2], matOpNorm(ι, g)) ^ c]
proof
  sorry

end DiscreteSeriesFlenstedJensen
