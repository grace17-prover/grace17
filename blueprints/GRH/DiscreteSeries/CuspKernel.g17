-- Integrable discrete series of U(p, q) and their kernels: bounded
-- measurable functions, continuous integrable minimal idempotents e on a
-- locally compact group and the vanishing of ∫ e(g) f(xg) dg against
-- functions invariant under a contracted subgroup (coefficients of
-- integrable discrete series are cusp forms); the mean value property on
-- the circle; compactly supported smooth functions on U(p, q) and
-- smearing; the module D_λ = U(𝔤)ψ_λ, its K-highest generator, decay of its
-- elements, the formal degree, Schur orthogonality deg_λ ∫ ψ_λ(xya)ψ̄_λ(y)dy
-- = ψ_λ(x)ψ_λ(a), the embedding of D_λ in L²(U(p, q)) and its unitarity;
-- the tail bounds |ψ_λ(xg) − ψ_λ(x)| ≤ 100(n + L + 1)⁵‖g − 1‖ and the
-- integral of deg_λ (2/‖g‖)^c.
-- Source: grh-compact/src/Lib/DiscreteSeries/CuspKernel/CircleMean.lean
-- (IsBoundedMeasurable, IsIdempotentKernel,
-- IsIdempotentKernel.convolution_self, integral_idem_mul_eq_zero,
-- integral_toCircle, le_of_halving), CuspKernel/BumpConvolution.lean
-- (Bumps, bumpDeriv, smear, hasDerivAt_smear, rightDeriv_smear),
-- CuspKernel/SchurOrthogonality.lean (HCParam.DsModule, HCParam.dsAction,
-- HCParam.dsGenerator, isKHighest_dsGenerator, norm_dsCoeff_le_one,
-- integral_mul_dsCoeff_translate, exists_smear_dsCoeffSmooth_eq,
-- exists_decay_bound, formalDegree_pos,
-- integrable_norm_pow_smul_dsKernel, dsCoeff_schur_orthogonality, toL2,
-- toL2_spec, isUnitaryCasimirGe_dsAction), FlenstedJensen/TailBounds.lean
-- (norm_dsCoeff_sub_le, half_le_norm_dsCoeff, integral_tail_le). Known
-- result: "Schur orthogonality; coefficients of integrable discrete series
-- are cusp forms."
-- Not stated: the Fubini lemmas of CircleMean.lean (sq_lintegral_le,
-- MeasurePreserving.fubini, integral_skew_product, integral_conv,
-- integral_eq_of_circle_mean), measure_ball_le_integral_dsCoeff, and
-- BesselSchurBound.lean (convolve and the Schur bound
-- lintegral_sq_convolve for Bessel functions on S\G), which needs the
-- orbit measures of Lib/General/Measure not yet stated.
-- Encoding. A group G with topology X carries a measure μ on the Borel sets
-- of X; e ∗ f integrals are complexMeasureIntegral. D_λ is the U(𝔤)-span of
-- ψ_λ in the smooth functions (generatedBy of GRH.DiscreteSeries.Rigidity)
-- with the restricted action; its inner product is deg_λ ∫ ȳ z, carried
-- from L² (csDSL2 of GRH.DiscreteSeries.RegularRep).
-- Part of the GRH blueprint (layer 4, Lib/DiscreteSeries, stage S2).
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.DiscreteSeries.CuspKernel
import GRH.DiscreteSeries.FlenstedJensen
import GRH.DiscreteSeries.RegularRep

section DiscreteSeriesCuspKernel
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- Section: Idempotent kernels
-- CircleMean.lean, IsBoundedMeasurable F: measurable and bounded (complex
-- valued).
predicate IsBoundedMeasurable (X F : Set) :=
  Measurable(F, X, complexMeasurableSpace) ∧
  ∃ C ∈ ℝ, ∀ y ∈ MeasurableSpace.carrier(X), complexAbs(F(y)) ≤ C

-- z ↦ e(z) e((zx)⁻¹y).
def idemConvIntegrand (G e x y : Set) : Set :=
  { (z, ℂ[e(z) * e(Group.mul(G)(Group.inv(G)(Group.mul(G)(z, x)), y))]) | z ∈ Group.carrier(G) }

-- CircleMean.lean, IsIdempotentKernel e: continuous, integrable,
-- e(g⁻¹) = conj e(g), e(1) ≠ 0, ∫ e(z) e((zx)⁻¹y) dz = e(x⁻¹)e(y)/e(1).
predicate IsIdempotentKernel (G X μ e : Set) :=
  FunctionBetween(e, Group.carrier(G), complexCarrier) ∧ (e : X ⇒ complexSpace) ∧
  ComplexIntegrable(borelSpace(X), μ, e) ∧
  (∀ g ∈ Group.carrier(G), e(Group.inv(G)(g)) = complexConj(e(g))) ∧
  e(Group.one(G)) ≠ complexZero ∧
  ∀ x ∈ Group.carrier(G), ∀ y ∈ Group.carrier(G),
    complexMeasureIntegral(borelSpace(X), μ, idemConvIntegrand(G, e, x, y)) =
      ℂ[complexDiv(e(Group.inv(G)(x)), e(Group.one(G))) * e(y)]

def idemSelfIntegrand (G e y : Set) : Set :=
  { (z, ℂ[e(z) * e(Group.mul(G)(Group.inv(G)(z), y))]) | z ∈ Group.carrier(G) }

-- CircleMean.lean, IsIdempotentKernel.convolution_self: e ∗ e = e.
theorem IsIdempotentKernel.convolution_self (G X μ e y : Set)
  requires kernel : IsIdempotentKernel(G, X, μ, e)
  requires hy : y ∈ Group.carrier(G)
  shows complexMeasureIntegral(borelSpace(X), μ, idemSelfIntegrand(G, e, y)) = e(y)
proof
  sorry

-- CircleMean.lean, integral_idem_mul_eq_zero (cusp forms): let e be an
-- idempotent kernel with |e|ℓ integrable, H continuous real with
-- |H(xg) − H(x)| ≤ ℓ(g), D ≤ G × ℂˣ with H(zg) = H(g) − log|c| for (z, c) ∈ D,
-- and every neighbourhood W of 1 containing, for some c with |c| ≠ 1 and
-- every x, an element b with (xbx⁻¹, c) ∈ D. Then ∫ e(g) f(xg) dg = 0 for f
-- bounded continuous and invariant under {r : (r, 1) ∈ D}.
def kernelWeight (e ℓ G : Set) : Set :=
  { (g, complexOfReal(R[complexAbs(e(g)) * ℓ(g)])) | g ∈ Group.carrier(G) }

def kernelTranslateIntegrand (G e f x : Set) : Set :=
  { (g, ℂ[e(g) * f(Group.mul(G)(x, g))]) | g ∈ Group.carrier(G) }

theorem IsIdempotentKernel.integral_eq_zero (G X μ e H ℓ D f x : Set)
  requires locally : LocallyCompactGroup(G, X)
  requires second : SecondCountable(X)
  requires haar : HaarMeasure(G, X, μ)
  requires kernel : IsIdempotentKernel(G, X, μ, e)
  requires hℓ : FunctionBetween(ℓ, Group.carrier(G), ℝ)
  requires weight : ComplexIntegrable(borelSpace(X), μ, kernelWeight(e, ℓ, G))
  requires hH : FunctionBetween(H, Group.carrier(G), ℝ)
  requires contH : H : X ⇒ realTopology
  requires lipschitz : ∀ y ∈ Group.carrier(G), ∀ g ∈ Group.carrier(G),
    realAbs(R[H(Group.mul(G)(y, g)) - H(y)]) ≤ ℓ(g)
  requires hD : D ⊆ Group.carrier(G) × (complexCarrier ∖ {complexZero})
  requires dsub : ∀ p ∈ D, ∀ q ∈ D, (Group.mul(G)(fst(p), fst(q)), ℂ[snd(p) * snd(q)]) ∈ D
  requires shift : ∀ p ∈ D, ∀ g ∈ Group.carrier(G),
    H(Group.mul(G)(fst(p), g)) = R[-realLog(complexAbs(snd(p))) + H(g)]
  requires contract : ∀ W ⊆ Group.carrier(G), W ∈ TopologicalSpace.opens(X) →
    Group.one(G) ∈ W → ∃ c ∈ complexCarrier, c ≠ complexZero ∧ complexAbs(c) ≠ realOne ∧
      ∀ y ∈ Group.carrier(G), ∃ b ∈ W,
        (Group.mul(G)(Group.mul(G)(y, b), Group.inv(G)(y)), c) ∈ D
  requires hf : FunctionBetween(f, Group.carrier(G), complexCarrier)
  requires contf : f : X ⇒ complexSpace
  requires boundf : ∃ C ∈ ℝ, ∀ g ∈ Group.carrier(G), complexAbs(f(g)) ≤ C
  requires invariant : ∀ r ∈ Group.carrier(G), (r, complexOne) ∈ D →
    ∀ g ∈ Group.carrier(G), f(Group.mul(G)(r, g)) = f(g)
  requires hx : x ∈ Group.carrier(G)
  shows complexMeasureIntegral(borelSpace(X), μ, kernelTranslateIntegrand(G, e, f, x)) = complexZero
proof
  sorry

-- CircleMean.lean, integral_toCircle (mean value property): ∫₀¹ f(e^{2πiθ}) dθ
-- = f(0) for f complex differentiable on the closed unit disc.
def circleComposite (f : Set) : Set := { (θ, f(circlePoint(θ))) | θ ∈ ℝ }

theorem circle_mean_value (f : Set)
  requires analytic : ∀ s ∈ complexCarrier, complexAbs(s) ≤ realOne → ComplexAnalyticAt(f, s)
  shows complexIntervalIntegral(circleComposite(f), realZero, realOne) = f(complexZero)
proof
  sorry

-- CircleMean.lean, le_of_halving (maximum principle): f bounded above,
-- c ≥ 0, and for every upper bound M ≥ 0 each value ≤ M/2 or ≤ c; then
-- f ≤ c.
theorem le_of_halving (A f B c x : Set)
  requires hf : FunctionBetween(f, A, ℝ)
  requires hB : B ∈ ℝ
  requires bound : ∀ y ∈ A, f(y) ≤ B
  requires hc : c ∈ ℝ
  requires nonneg : realZero ≤ c
  requires halving : ∀ M ∈ ℝ, realZero ≤ M → (∀ y ∈ A, f(y) ≤ M) →
    ∀ y ∈ A, f(y) ≤ realDiv(M, R[2]) ∨ f(y) ≤ c
  requires hx : x ∈ A
  shows f(x) ≤ c
proof
  sorry

-- Section: Bumps and smearing
-- BumpConvolution.lean, Bumps ε: the compactly supported smooth functions.
def supportClosure (ι ε f : Set) : Set :=
  closure(signUnitarySpace(ι, ε), { g ∈ signUnitaryMatrices(ι, ε) | f(g) ≠ complexZero })

def bumps (ι ε : Set) : Set :=
  { f ∈ smoothU(ι, ε) | Compact(signUnitarySpace(ι, ε), supportClosure(ι, ε, f)) }

theorem bumps.submodule (ι ε : Set)
  requires finite : Finite(ι)
  requires signs : SignsOn(ι, ε)
  shows SubmoduleOf(bumps(ι, ε), smoothUModule(ι, ε), complexRing) ∧
    ∀ X ∈ cMatrices(ι), ∀ f ∈ bumps(ι, ε), rightDerivFn(ι, ε, X, f) ∈ bumps(ι, ε)
proof
  sorry

-- BumpConvolution.lean, smear F α = (g ↦ ∫ α(y⁻¹) F(gy) dy), for complex F.
def smearIntegrand (ι F α g : Set) : Set :=
  { (y, ℂ[α(matInverse(complexRing, ι, y)) * F(matMul(complexRing, ι, ι, ι, g, y))]) |
    y ∈ domain(α) }

def smear (ι ε F α : Set) : Set :=
  { (g, complexMeasureIntegral(signBorel(ι, ε), signHaar(ι, ε), smearIntegrand(ι, F, α, g))) |
    g ∈ signUnitaryMatrices(ι, ε) }

-- BumpConvolution.lean, rightDeriv_smear: derivatives fall on the test
-- function, X(smear F α) = smear F (Xα).
theorem smear.rightDeriv (ι ε F α X : Set)
  requires finite : Finite(ι)
  requires signs : SignsOn(ι, ε)
  requires hF : FunctionBetween(F, signUnitaryMatrices(ι, ε), complexCarrier)
  requires contF : F : signUnitarySpace(ι, ε) ⇒ complexSpace
  requires hα : α ∈ bumps(ι, ε)
  requires hX : X ∈ cMatrices(ι)
  requires smooth : smear(ι, ε, F, α) ∈ smoothU(ι, ε)
  shows smear(ι, ε, F, rightDerivFn(ι, ε, X, α)) = rightDerivFn(ι, ε, X, smear(ι, ε, F, α))
proof
  sorry

-- Section: The module D_λ
-- SchurOrthogonality.lean, HCParam.DsModule and dsAction: D_λ = U(𝔤)ψ_λ
-- with the right derivatives; dsGenerator = ψ_λ.
def dsModuleSet (ι ε l : Set) : Set :=
  generatedBy(ι, smoothUModule(ι, ε), rightDeriv(ι, ε), dsCoeffOn(ι, ε, l))

def dsModule (ι ε l : Set) : Set := submoduleModule(smoothUModule(ι, ε), complexRing, dsModuleSet(ι, ε, l))

def dsActionOn (ι ε l X : Set) : Set := restrict(rightDeriv(ι, ε)(X), dsModuleSet(ι, ε, l))

def dsAction (ι ε l : Set) : Set := { (X, dsActionOn(ι, ε, l, X)) | X ∈ cMatrices(ι) }

theorem dsAction.gl_module (ι ε l : Set)
  requires finite : Finite(ι)
  requires signs : SignsOn(ι, ε)
  requires hl : (l : ι → ℤ)
  shows IsGlModule(ι, dsModule(ι, ε, l), dsAction(ι, ε, l))
proof
  sorry

-- SchurOrthogonality.lean, isKHighest_dsGenerator: ψ_λ is K-highest of
-- weight Λ in D_λ.
theorem dsGenerator.highest (ι ε l h : Set)
  requires finite : Finite(ι)
  requires signs : SignsOn(ι, ε)
  requires gap : HasGap(ι, ε, l, h)
  shows IsKHighest(ι, ε, l, dsModule(ι, ε, l), dsAction(ι, ε, l), lowestKType(ι, ε, l),
    dsCoeffOn(ι, ε, l))
proof
  sorry

-- SchurOrthogonality.lean, norm_dsCoeff_le_one: |ψ_λ| ≤ 1.
theorem dsCoeff.abs_le_one (ι ε l h g : Set)
  requires finite : Finite(ι)
  requires signs : SignsOn(ι, ε)
  requires gap : HasGap(ι, ε, l, h)
  requires hg : g ∈ signUnitaryMatrices(ι, ε)
  shows complexAbs(dsCoeff(ι, ε, l, g)) ≤ realOne
proof
  sorry

-- SchurOrthogonality.lean, exists_smear_dsCoeffSmooth_eq: for n ≥ 1 and gap
-- 500n³ + A every f ∈ D_λ is smear ψ_λ β for a bump β.
theorem dsModule.exists_smear (ι ε l f : Set, A : Nat)
  requires finite : Finite(ι)
  requires nonempty : ι ≠ ∅
  requires signs : SignsOn(ι, ε)
  requires gap : HasLargeGap(ι, ε, l, A)
  requires hf : f ∈ dsModuleSet(ι, ε, l)
  shows ∃ β ∈ bumps(ι, ε), smear(ι, ε, dsCoeffOn(ι, ε, l), β) = f
proof
  sorry

-- SchurOrthogonality.lean, exists_decay_bound: |f(g)| ≤ K(2/‖g‖)^c on D_λ
-- for c ≤ 500n³ + A.
theorem dsModule.decay (ι ε l f : Set, A c : Nat)
  requires finite : Finite(ι)
  requires nonempty : ι ≠ ∅
  requires signs : SignsOn(ι, ε)
  requires gap : HasLargeGap(ι, ε, l, A)
  requires hf : f ∈ dsModuleSet(ι, ε, l)
  requires hc : realNat(c) ≤ (gapThreshold(ι, A):R)
  shows ∃ K ∈ ℝ, ∀ g ∈ signUnitaryMatrices(ι, ε),
    complexAbs(f(g)) ≤ R[K * realDiv(R[2], matOpNorm(ι, g)) ^ c]
proof
  sorry

-- SchurOrthogonality.lean, formalDegree_pos and
-- integrable_norm_pow_smul_dsKernel: deg_λ > 0 and ‖g‖^C e_λ(g) is
-- integrable for C ≤ A + 1.
def normPowKernel (ι ε l : Set, C : Nat) : Set :=
  { (g, ℂ[complexOfReal(R[matOpNorm(ι, g) ^ C]) * dsKernel(ι, ε, l, g)]) |
    g ∈ signUnitaryMatrices(ι, ε) }

theorem formalDegree.pos (ι ε l : Set, A C : Nat)
  requires finite : Finite(ι)
  requires nonempty : ι ≠ ∅
  requires signs : SignsOn(ι, ε)
  requires gap : HasLargeGap(ι, ε, l, A)
  requires hC : (C:N) ≤ (succ(A):N)
  shows realZero < formalDegree(ι, ε, l) ∧
    ComplexIntegrable(signBorel(ι, ε), signHaar(ι, ε), normPowKernel(ι, ε, l, C))
proof
  sorry

-- SchurOrthogonality.lean, integral_mul_dsCoeff_translate: if w is
-- integrable with ∫_K conj m_Λ(k) w(k⁻¹g) dk = c_Λ w(g), then
-- ∫ w(g)ψ_λ(xga) dg = ψ_λ(x) ∫ w(g)ψ_λ(ga) dg.
def kAverageIntegrand (ι ε l w g : Set) : Set :=
  { (k, ℂ[complexConj(weightMinors(ι, lowestKType(ι, ε, l), k)) *
      w(matMul(complexRing, ι, ι, ι, matInverse(complexRing, ι, k), g))]) | k ∈ maxCompactU(ι, ε) }

def dsTranslateIntegrand (ι ε l w x a : Set) : Set :=
  { (g, ℂ[w(g) * dsCoeff(ι, ε, l, matMul(complexRing, ι, ι, ι, matMul(complexRing, ι, ι, ι, x, g), a))]) |
    g ∈ signUnitaryMatrices(ι, ε) }

theorem dsCoeff.translate (ι ε l w x a : Set, A : Nat)
  requires finite : Finite(ι)
  requires signs : SignsOn(ι, ε)
  requires gap : HasLargeGap(ι, ε, l, A)
  requires integrable : ComplexIntegrable(signBorel(ι, ε), signHaar(ι, ε), w)
  requires kType : ∀ g ∈ signUnitaryMatrices(ι, ε),
    complexMeasureIntegral(maxCompactBorel(ι, ε), haarK(ι, ε), kAverageIntegrand(ι, ε, l, w, g)) =
      ℂ[complexOfReal(kTypeNormSq(ι, ε, lowestKType(ι, ε, l))) * w(g)]
  requires hx : x ∈ signUnitaryMatrices(ι, ε)
  requires ha : a ∈ signUnitaryMatrices(ι, ε)
  shows complexMeasureIntegral(signBorel(ι, ε), signHaar(ι, ε), dsTranslateIntegrand(ι, ε, l, w, x, a)) =
    ℂ[dsCoeff(ι, ε, l, x) * complexMeasureIntegral(signBorel(ι, ε), signHaar(ι, ε),
      dsTranslateIntegrand(ι, ε, l, w, matOne(complexRing, ι), a))]
proof
  sorry

-- SchurOrthogonality.lean, dsCoeff_schur_orthogonality (product formula):
-- deg_λ ∫ ψ_λ(xya) conj ψ_λ(y) dy = ψ_λ(x)ψ_λ(a).
def schurIntegrand (ι ε l x a : Set) : Set :=
  { (y, ℂ[dsCoeff(ι, ε, l, matMul(complexRing, ι, ι, ι, matMul(complexRing, ι, ι, ι, x, y), a)) *
      complexConj(dsCoeff(ι, ε, l, y))]) | y ∈ signUnitaryMatrices(ι, ε) }

theorem dsCoeff.schur_orthogonality (ι ε l x a : Set, A : Nat)
  requires finite : Finite(ι)
  requires nonempty : ι ≠ ∅
  requires signs : SignsOn(ι, ε)
  requires gap : HasLargeGap(ι, ε, l, A)
  requires hx : x ∈ signUnitaryMatrices(ι, ε)
  requires ha : a ∈ signUnitaryMatrices(ι, ε)
  shows ℂ[complexOfReal(formalDegree(ι, ε, l)) *
      complexMeasureIntegral(signBorel(ι, ε), signHaar(ι, ε), schurIntegrand(ι, ε, l, x, a))] =
    ℂ[dsCoeff(ι, ε, l, x) * dsCoeff(ι, ε, l, a)]
proof
  sorry

-- SchurOrthogonality.lean, toL2: f ↦ √deg_λ [f], D_λ → L².
def l2ClassOf (ι ε f : Set) : Set :=
  ⋃({ F ∈ Module.carrier(csDSL2(ι, ε)) | f ∈ F })

def toL2 (ι ε l : Set) : Set :=
  { (f, Module.smul(csDSL2(ι, ε))(complexOfReal(realSqrt(formalDegree(ι, ε, l))), l2ClassOf(ι, ε, f))) |
    f ∈ dsModuleSet(ι, ε, l) }

-- SchurOrthogonality.lean, toL2_spec: the action of D_λ differentiates the
-- right regular representation along toL2; ⟨toL2 ψ_λ, R(g) toL2 y⟩ = y(g);
-- ⟨toL2 y, R(x) toL2 z⟩ = deg_λ ∫ z(gx) conj y(g) dg.
def matrixCoeffIntegrand (ι ε y z x : Set) : Set :=
  { (g, ℂ[z(matMul(complexRing, ι, ι, ι, g, x)) * complexConj(y(g))]) | g ∈ signUnitaryMatrices(ι, ε) }

theorem toL2.spec (ι ε l : Set, A : Nat)
  requires finite : Finite(ι)
  requires nonempty : ι ≠ ∅
  requires signs : SignsOn(ι, ε)
  requires gap : HasLargeGap(ι, ε, l, A)
  shows IsDerivedAction(ι, signMatrix(complexRing, ι, ε), csDSL2(ι, ε), csDSL2Norm(ι, ε),
      rightRegularL2(ι, ε), dsModule(ι, ε, l), toL2(ι, ε, l), dsAction(ι, ε, l)) ∧
    (∀ y ∈ dsModuleSet(ι, ε, l), ∀ g ∈ signUnitaryMatrices(ι, ε),
      csDSL2Inner(ι, ε)(toL2(ι, ε, l)(dsCoeffOn(ι, ε, l)), rightRegularL2(ι, ε)(g)(toL2(ι, ε, l)(y))) =
        y(g)) ∧
    ∀ y ∈ dsModuleSet(ι, ε, l), ∀ z ∈ dsModuleSet(ι, ε, l), ∀ x ∈ signUnitaryMatrices(ι, ε),
      csDSL2Inner(ι, ε)(toL2(ι, ε, l)(y), rightRegularL2(ι, ε)(x)(toL2(ι, ε, l)(z))) =
        ℂ[complexOfReal(formalDegree(ι, ε, l)) *
          complexMeasureIntegral(signBorel(ι, ε), signHaar(ι, ε), matrixCoeffIntegrand(ι, ε, y, z, x))]
proof
  sorry

-- The inner product and norm of D_λ induced by toL2.
def dsInner (ι ε l : Set) : Set :=
  { (p, csDSL2Inner(ι, ε)(toL2(ι, ε, l)(fst(p)), toL2(ι, ε, l)(snd(p)))) |
    p ∈ dsModuleSet(ι, ε, l) × dsModuleSet(ι, ε, l) }

def dsNorm (ι ε l : Set) : Set :=
  { (f, csDSL2Norm(ι, ε)(toL2(ι, ε, l)(f))) | f ∈ dsModuleSet(ι, ε, l) }

-- SchurOrthogonality.lean, isUnitaryCasimirGe_dsAction: D_λ is
-- unitarisable with Ω ≥ |λ|² − |ρ|², ‖ψ_λ‖ = 1, and |y(g)| ≤ ‖y‖.
theorem dsAction.unitary (ι ε l : Set, A : Nat)
  requires finite : Finite(ι)
  requires nonempty : ι ≠ ∅
  requires signs : SignsOn(ι, ε)
  requires gap : HasLargeGap(ι, ε, l, A)
  shows IsUnitaryCasimirGe(ι, ε, l, dsModule(ι, ε, l), dsInner(ι, ε, l), dsNorm(ι, ε, l),
      dsAction(ι, ε, l)) ∧
    dsNorm(ι, ε, l)(dsCoeffOn(ι, ε, l)) = realOne ∧
    ∀ y ∈ dsModuleSet(ι, ε, l), ∀ g ∈ signUnitaryMatrices(ι, ε),
      complexAbs(y(g)) ≤ dsNorm(ι, ε, l)(y)
proof
  sorry

-- Section: Tail bounds
-- TailBounds.lean, norm_dsCoeff_sub_le: for gap 500n³ + B and |l_a| ≤ L,
-- |ψ_λ(xg) − ψ_λ(x)| ≤ 100(n + L + 1)⁵‖g − 1‖.
theorem dsCoeff.sub_le (ι ε l x g : Set, B L : Nat)
  requires finite : Finite(ι)
  requires nonempty : ι ≠ ∅
  requires signs : SignsOn(ι, ε)
  requires gap : HasLargeGap(ι, ε, l, B)
  requires bound : ∀ a ∈ ι, realAbs(intReal(l(a))) ≤ realNat(L)
  requires hx : x ∈ signUnitaryMatrices(ι, ε)
  requires hg : g ∈ signUnitaryMatrices(ι, ε)
  shows complexAbs(ℂ[dsCoeff(ι, ε, l, matMul(complexRing, ι, ι, ι, x, g)) - dsCoeff(ι, ε, l, x)]) ≤
    R[100 * (realNat(cardinality(ι)) + realNat(L) + 1) ^ 5 *
      matOpNorm(ι, matSub(ι, g, matOne(complexRing, ι)))]
proof
  sorry

-- TailBounds.lean, half_le_norm_dsCoeff: |ψ_λ(g)| ≥ ½ when
-- ‖g − 1‖ ≤ (200β⁵)⁻¹ and β ≥ n + L + 1.
theorem dsCoeff.half_le (ι ε l g β : Set, B L : Nat)
  requires finite : Finite(ι)
  requires nonempty : ι ≠ ∅
  requires signs : SignsOn(ι, ε)
  requires gap : HasLargeGap(ι, ε, l, B)
  requires bound : ∀ a ∈ ι, realAbs(intReal(l(a))) ≤ realNat(L)
  requires hβ : β ∈ ℝ
  requires big : R[realNat(cardinality(ι)) + realNat(L) + 1] ≤ β
  requires hg : g ∈ signUnitaryMatrices(ι, ε)
  requires near : matOpNorm(ι, matSub(ι, g, matOne(complexRing, ι))) ≤ realInvValue(R[200 * β ^ 5])
  shows realDiv(realOne, R[2]) ≤ complexAbs(dsCoeff(ι, ε, l, g))
proof
  sorry

-- TailBounds.lean, integral_tail_le: for c > 8n², deg_λ (2/‖g‖)^c is
-- integrable with integral ≤ 8(2000(n + L + 1)⁶)^{2n²} 2^c.
def tailFunction (ι ε l : Set, c : Nat) : Set :=
  { (g, R[formalDegree(ι, ε, l) * realDiv(R[2], matOpNorm(ι, g)) ^ c]) | g ∈ signUnitaryMatrices(ι, ε) }

theorem tailFunction.integral_le (ι ε l : Set, B L c : Nat)
  requires finite : Finite(ι)
  requires nonempty : ι ≠ ∅
  requires signs : SignsOn(ι, ε)
  requires gap : HasLargeGap(ι, ε, l, B)
  requires bound : ∀ a ∈ ι, realAbs(intReal(l(a))) ≤ realNat(L)
  requires hc : mul(8, mul(cardinality(ι), cardinality(ι))) < c
  shows RealIntegrable(signBorel(ι, ε), signHaar(ι, ε), tailFunction(ι, ε, l, c)) ∧
    realMeasureIntegral(signBorel(ι, ε), signHaar(ι, ε), tailFunction(ι, ε, l, c)) ≤
      R[8 * (2000 * (realNat(cardinality(ι)) + realNat(L) + 1) ^ 6) ^
        mul(2, mul(cardinality(ι), cardinality(ι))) * 2 ^ c]
proof
  sorry

end DiscreteSeriesCuspKernel
