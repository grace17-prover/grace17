-- Hermitian involutions J and their unitary groups U(J) = {g : gᴴJg = J}
-- with the topology of entries; the ℓ² operator norm of a complex
-- matrix and its laws on U(J) (|det g| = 1, ‖g⁻¹‖ = ‖g‖ ≥ 1); the real
-- coordinates of skew-hermitian matrices (skewOfReal, skewCoords) and the
-- unit scalars e^{it}·1.
-- Source: grh-compact/src/Lib/DiscreteSeries/Haar/UnitaryNorm.lean
-- (IsHermInvolution, skewOfReal, skewCoords, IsHermInvolution.det_ne_zero,
-- U.norm_det, U.norm_inv, U.one_le_norm), Haar/SkewCoordinates.lean
-- (skewCoords_skewOfReal, conjTranspose_skewOfReal, skewOfReal_skewCoords),
-- Haar/LogDerivative.lean (circleScalar). Part of: "Haar measure of U(J)
-- in Cayley coordinates, volume of U(n), polynomial volume growth (known
-- result; see Lib.DiscreteSeries.Haar.RegularRepL2)."
-- Not stated: LogDerivative.lean's logDerivU and its laws, the real
-- determinant of X ↦ PXQ (det_mulLeft_mulRight_real), of skew congruence
-- (abs_det_skew_congruence) and of block triangular maps, and the Gaussian
-- normalisation lemmas (HasGaussianIntegral.measurePreserving,
-- exists_measurePreserving_equiv), which serve the Cayley chart Jacobian of
-- GRH.DiscreteSeries.CayleyMeasure.
-- Encoding. A finite index set ι; matrices are matrixSpace(ℂ, ι, ι). U(J) is
-- formUnitaryMatrices of GRH.Matrix.Groups for complex conjugation, with
-- the subspace topology of the entries (as signUnitarySpace of
-- GRH.Weil.Fock, which is U(diag ε)). The operator norm is the ℓ² operator
-- norm (Matrix.Norms.L2Operator): ‖A‖² is the supremum of |Av|² over the
-- unit vectors v (stated for nonempty ι).
-- Part of the GRH blueprint (layer 4, Lib/DiscreteSeries, stage S2).
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.DiscreteSeries.Unitary
import GRH.Weil.Fock

section DiscreteSeriesUnitary
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- Section: Hermitian involutions and U(J)
-- Complex and real square matrices on ι.
def cMatrices (ι : Set) : Set := matrixSpace(complexRing, ι, ι)

def rMatrices (ι : Set) : Set := matrixSpace(realRing, ι, ι)

-- UnitaryNorm.lean, IsHermInvolution J: J* = J and J² = 1.
predicate IsHermInvolution (ι J : Set) :=
  J ∈ cMatrices(ι) ∧ IsHermitianMatrix(complexRing, complexConj, ι, J) ∧
  matMul(complexRing, ι, ι, ι, J, J) = matOne(complexRing, ι)

-- The source's U J: the group of g with gᴴJg = J, and its topology.
def unitaryOf (ι J : Set) : Set := formUnitaryMatrices(complexRing, complexConj, ι, J)

def unitaryOfGroup (ι J : Set) : Set := formUnitaryGroup(complexRing, complexConj, ι, J)

def unitaryOfSpace (ι J : Set) : Set :=
  subspace(piSpace(ι × ι, matrixEntrySpaces(ι)), unitaryOf(ι, J))

-- UnitaryNorm.lean, the instances: diag(ε) and 1 are hermitian involutions.
theorem IsHermInvolution.sign (ι ε : Set)
  requires finite : Finite(ι)
  requires signs : SignsOn(ι, ε)
  shows IsHermInvolution(ι, signMatrix(complexRing, ι, ε))
proof
  sorry

theorem IsHermInvolution.one (ι : Set)
  requires finite : Finite(ι)
  shows IsHermInvolution(ι, matOne(complexRing, ι))
proof
  sorry

-- UnitaryNorm.lean, IsHermInvolution.det_ne_zero.
theorem IsHermInvolution.det_ne_zero (ι J : Set)
  requires finite : Finite(ι)
  requires herm : IsHermInvolution(ι, J)
  shows matDet(complexRing, ι, J) ≠ complexZero
proof
  sorry

-- U(J) is a topological group under the topology of entries.
theorem unitaryOf.topological_group (ι J : Set)
  requires finite : Finite(ι)
  requires herm : IsHermInvolution(ι, J)
  shows TopologicalGroup(unitaryOfGroup(ι, J), unitaryOfSpace(ι, J))
proof
  sorry

-- Section: The operator norm
-- |Av|² over the unit vectors v; ‖A‖ = (sup |Av|²)^½.
def opNormSqValues (ι A : Set) : Set :=
  { r ∈ ℝ | ∃ v ∈ cVectors(ι), cDot(ι, v, v) = complexOne ∧
    r = complexRe(cDot(ι, mulVec(complexRing, ι, ι, A, v), mulVec(complexRing, ι, ι, A, v))) }

def matOpNorm (ι A : Set) : Set := realSqrt(realSup(opNormSqValues(ι, A)))

-- UnitaryNorm.lean, U.norm_det: |det g| = 1 on U(J).
theorem unitaryOf.abs_det (ι J g : Set)
  requires finite : Finite(ι)
  requires herm : IsHermInvolution(ι, J)
  requires hg : g ∈ unitaryOf(ι, J)
  shows complexAbs(matDet(complexRing, ι, g)) = realOne
proof
  sorry

-- UnitaryNorm.lean, U.norm_inv: ‖g⁻¹‖ = ‖g‖ on U(J).
theorem unitaryOf.opNorm_inv (ι J g : Set)
  requires finite : Finite(ι)
  requires herm : IsHermInvolution(ι, J)
  requires hg : g ∈ unitaryOf(ι, J)
  shows matOpNorm(ι, matInverse(complexRing, ι, g)) = matOpNorm(ι, g)
proof
  sorry

-- UnitaryNorm.lean, U.one_le_norm: 1 ≤ ‖g‖ for ι nonempty.
theorem unitaryOf.one_le_opNorm (ι J g : Set)
  requires finite : Finite(ι)
  requires nonempty : ι ≠ ∅
  requires herm : IsHermInvolution(ι, J)
  requires hg : g ∈ unitaryOf(ι, J)
  shows realOne ≤ matOpNorm(ι, g)
proof
  sorry

-- The operator norm is a norm, submultiplicative, and bounds the entries.
theorem matOpNorm.mul_le (ι A B : Set)
  requires finite : Finite(ι)
  requires nonempty : ι ≠ ∅
  requires hA : A ∈ cMatrices(ι)
  requires hB : B ∈ cMatrices(ι)
  shows matOpNorm(ι, matMul(complexRing, ι, ι, ι, A, B)) ≤
    R[matOpNorm(ι, A) * matOpNorm(ι, B)]
proof
  sorry

theorem matOpNorm.entry_le (ι A i j : Set)
  requires finite : Finite(ι)
  requires hA : A ∈ cMatrices(ι)
  requires hi : i ∈ ι
  requires hj : j ∈ ι
  shows complexAbs(A[i, j]) ≤ matOpNorm(ι, A)
proof
  sorry

-- Section: Real coordinates of skew-hermitian matrices
-- The imaginary unit and √2.
def unitI : Set := complexImagEmbed(realOne)

def complexSqrtTwo : Set := complexOfReal(realSqrt(R[2]))

-- UnitaryNorm.lean, skewOfReal y: the entry ((1+i)y_ab − (1−i)y_ba)/c with
-- c = 2 on the diagonal and √2 off it (i·y_aa on the diagonal).
def skewNumerator (y a b : Set) : Set :=
  ℂ[(1 + unitI) * complexOfReal(y[a, b]) - (1 - unitI) * complexOfReal(y[b, a])]

def skewEntry (y a b : Set) : Set :=
  ⋃({ c ∈ complexCarrier | (a = b ∧ c = complexDiv(skewNumerator(y, a, b), ℂ[2])) ∨
    (a ≠ b ∧ c = complexDiv(skewNumerator(y, a, b), complexSqrtTwo)) })

def skewOfReal (ι y : Set) : Set := { (q, skewEntry(y, fst(q), snd(q))) | q ∈ ι × ι }

-- UnitaryNorm.lean, skewCoords x: the entry Re x_ab + Im x_ab, divided by
-- √2 off the diagonal; a left inverse of skewOfReal.
def skewCoordEntry (x a b : Set) : Set :=
  ⋃({ r ∈ ℝ | (a = b ∧ r = R[complexRe(x[a, b]) + complexIm(x[a, b])]) ∨
    (a ≠ b ∧ r = realDiv(R[complexRe(x[a, b]) + complexIm(x[a, b])], realSqrt(R[2]))) })

def skewCoords (ι x : Set) : Set := { (q, skewCoordEntry(x, fst(q), snd(q))) | q ∈ ι × ι }

-- SkewCoordinates.lean, skewCoords_skewOfReal.
theorem skewCoords.skewOfReal (ι y : Set)
  requires hy : y ∈ rMatrices(ι)
  shows skewCoords(ι, skewOfReal(ι, y)) = y
proof
  sorry

-- SkewCoordinates.lean, conjTranspose_skewOfReal: skewOfReal y is
-- skew-hermitian.
theorem skewOfReal.conjTranspose (ι y : Set)
  requires hy : y ∈ rMatrices(ι)
  shows conjTranspose(complexRing, complexConj, ι, ι, skewOfReal(ι, y)) =
    matNeg(complexRing, ι, ι, skewOfReal(ι, y))
proof
  sorry

-- SkewCoordinates.lean, skewOfReal_skewCoords: on skew-hermitian x.
theorem skewOfReal.skewCoords (ι x : Set)
  requires hx : x ∈ cMatrices(ι)
  requires skew : conjTranspose(complexRing, complexConj, ι, ι, x) = matNeg(complexRing, ι, ι, x)
  shows skewOfReal(ι, skewCoords(ι, x)) = x
proof
  sorry

-- skewOfReal is real-linear: it sends y + t·z to skewOfReal y + t·skewOfReal z.
def realMatCombination (ι y t z : Set) : Set := { (q, R[y(q) + t * z(q)]) | q ∈ ι × ι }

theorem skewOfReal.real_linear (ι y t z : Set)
  requires hy : y ∈ rMatrices(ι)
  requires hz : z ∈ rMatrices(ι)
  requires ht : t ∈ ℝ
  shows skewOfReal(ι, realMatCombination(ι, y, t, z)) =
    matAdd(complexRing, ι, ι, skewOfReal(ι, y),
      matSmul(complexRing, ι, ι, complexOfReal(t), skewOfReal(ι, z)))
proof
  sorry

-- Section: Unit scalars
-- LogDerivative.lean, circleScalar t: e^{it}·1 in U(J).
def circleScalar (ι t : Set) : Set :=
  matScalar(complexRing, ι, complexExp(ℂ[complexOfReal(t) * unitI]))

theorem circleScalar.mem (ι J t : Set)
  requires finite : Finite(ι)
  requires herm : IsHermInvolution(ι, J)
  requires ht : t ∈ ℝ
  shows circleScalar(ι, t) ∈ unitaryOf(ι, J)
proof
  sorry

end DiscreteSeriesUnitary
