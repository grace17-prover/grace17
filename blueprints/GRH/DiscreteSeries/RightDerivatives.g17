-- Smooth functions on U(p, q) as a gl_n(ℂ)-module under complexified right
-- derivatives: Y ∈ Lie U(diag ε) acts by (Yf)(g) = d/dt f(g exp tY) at
-- t = 0, and X = A + iB (A, B ∈ Lie) by Af + iBf; the chain rule along
-- curves γ with γ′ = γX.
-- Source: grh-compact/src/Lib/DiscreteSeries/FlenstedJensen/RightDerivatives.lean
-- (SmoothMat, SmoothU, unitaryLiePart, eq_unitaryLiePart_add_I_smul,
-- rightDerivMat, rightDeriv, SmoothU.continuous, hasDerivAt_curve,
-- hasDerivAt_rightDeriv_expU, hasDerivAt_expU, continuous_expU). Part of:
-- "Flensted-Jensen's function: coefficient of the lowest K-type of a
-- discrete series (known result; see
-- Lib.DiscreteSeries.FlenstedJensen.KTypeProjection)."
-- Not stated: GlModule.onRange (the module structure on a range, a step of
-- the construction of rightDeriv), rightDeriv_eq_fderiv and
-- rightDeriv_comp_clm (vector-valued functions).
-- Encoding. The source's SmoothU ε E is the space of restrictions to
-- U(diag ε) of C^∞ functions on all matrices; here, for E = ℂ, it is the
-- largest class of continuous functions on U(diag ε) closed under the
-- derivatives along the one-parameter subgroups g ↦ g exp tY, Y ∈ Lie
-- U(diag ε), which is the same class since U(diag ε) is a closed embedded
-- submanifold. Matrix-valued curves are differentiated in ℂ^{ι×ι} with
-- its sup norm.
-- Part of the GRH blueprint (layer 4, Lib/DiscreteSeries, stage S2).
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.DiscreteSeries.RightDerivatives
import GRH.DiscreteSeries.Representation

section DiscreteSeriesRightDerivatives
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- Section: The Lie algebra parts
-- RightDerivatives.lean, unitaryLiePart ε X = ½(X − J⁻¹XᴴJ), J = diag ε.
def unitaryLiePart (ι ε X : Set) : Set :=
  matSmul(complexRing, ι, ι, complexDiv(complexOne, ℂ[2]), matSub(ι, X,
    matMul(complexRing, ι, ι, ι, matInverse(complexRing, ι, signMatrix(complexRing, ι, ε)),
      matMul(complexRing, ι, ι, ι, conjTranspose(complexRing, complexConj, ι, ι, X),
        signMatrix(complexRing, ι, ε)))))

-- −iX.
def negIMat (ι X : Set) : Set := matSmul(complexRing, ι, ι, ℂ[-unitI], X)

-- RightDerivatives.lean, unitaryLiePart lies in Lie U(diag ε), and
-- eq_unitaryLiePart_add_I_smul: X = A + iB with A, B the parts of X, −iX.
theorem unitaryLiePart.mem (ι ε X : Set)
  requires finite : Finite(ι)
  requires signs : SignsOn(ι, ε)
  requires hX : X ∈ cMatrices(ι)
  shows unitaryLiePart(ι, ε, X) ∈ unitaryLie(ι, signMatrix(complexRing, ι, ε))
proof
  sorry

theorem unitaryLiePart.decompose (ι ε X : Set)
  requires finite : Finite(ι)
  requires signs : SignsOn(ι, ε)
  requires hX : X ∈ cMatrices(ι)
  shows X = matAdd(complexRing, ι, ι, unitaryLiePart(ι, ε, X),
    matSmul(complexRing, ι, ι, unitI, unitaryLiePart(ι, ε, negIMat(ι, X))))
proof
  sorry

-- Section: Derivatives along one-parameter subgroups
-- t ↦ f(g exp tY).
def rightCurve (ι f g Y : Set) : Set :=
  { (t, f(matMul(complexRing, ι, ι, ι, g, matExp(ι, realSmulMat(ι, t, Y))))) | t ∈ ℝ }

-- The derivative at 0 of t ↦ f(g exp tY), and Yf.
def lieDerivAt (ι f g Y : Set) : Set :=
  ⋃({ D ∈ complexCarrier |
    HasCurveDeriv(complexSelfModule, complexAbs, rightCurve(ι, f, g, Y), D, realZero) })

def lieDeriv (ι ε Y f : Set) : Set :=
  { (g, lieDerivAt(ι, f, g, Y)) | g ∈ signUnitaryMatrices(ι, ε) }

-- RightDerivatives.lean, rightDeriv ε X f = Af + iBf, X = A + iB.
def rightDerivFn (ι ε X f : Set) : Set :=
  { (g, ℂ[lieDerivAt(ι, f, g, unitaryLiePart(ι, ε, X)) +
      unitI * lieDerivAt(ι, f, g, unitaryLiePart(ι, ε, negIMat(ι, X)))]) |
    g ∈ signUnitaryMatrices(ι, ε) }

-- A class S of continuous functions on U(diag ε) closed under the
-- derivatives along Lie U(diag ε).
predicate RightDerivClosed (ι ε S : Set) :=
  ∀ h ∈ S, FunctionBetween(h, signUnitaryMatrices(ι, ε), complexCarrier) ∧
    (h : signUnitarySpace(ι, ε) ⇒ complexSpace) ∧
    ∀ Y ∈ unitaryLie(ι, signMatrix(complexRing, ι, ε)), lieDeriv(ι, ε, Y, h) ∈ S ∧
      ∀ g ∈ signUnitaryMatrices(ι, ε), ∃ D ∈ complexCarrier,
        HasCurveDeriv(complexSelfModule, complexAbs, rightCurve(ι, h, g, Y), D, realZero)

-- RightDerivatives.lean, SmoothU ε ℂ: the smooth functions on U(diag ε),
-- and their ℂ-module.
def smoothU (ι ε : Set) : Set :=
  { f ∈ functionSpace(signUnitaryMatrices(ι, ε), complexCarrier) |
    ∃ S, f ∈ S ∧ RightDerivClosed(ι, ε, S) }

def smoothUFunctions (ι ε : Set) : Set :=
  coordinateModule(complexRing, signUnitaryMatrices(ι, ε))

def smoothUModule (ι ε : Set) : Set := submoduleModule(smoothUFunctions(ι, ε), complexRing, smoothU(ι, ε))

-- RightDerivatives.lean, rightDeriv ε ℂ: X ↦ (f ↦ Af + iBf) on SmoothU.
def rightDerivOn (ι ε X : Set) : Set := { (f, rightDerivFn(ι, ε, X, f)) | f ∈ smoothU(ι, ε) }

def rightDeriv (ι ε : Set) : Set := { (X, rightDerivOn(ι, ε, X)) | X ∈ cMatrices(ι) }

theorem smoothU.submodule (ι ε : Set)
  requires finite : Finite(ι)
  requires signs : SignsOn(ι, ε)
  shows SubmoduleOf(smoothU(ι, ε), smoothUFunctions(ι, ε), complexRing)
proof
  sorry

-- RightDerivatives.lean, rightDeriv: a gl_n(ℂ)-module.
theorem rightDeriv.gl_module (ι ε : Set)
  requires finite : Finite(ι)
  requires signs : SignsOn(ι, ε)
  shows IsGlModule(ι, smoothUModule(ι, ε), rightDeriv(ι, ε))
proof
  sorry

-- RightDerivatives.lean, SmoothU.continuous.
theorem smoothU.continuous (ι ε f : Set)
  requires finite : Finite(ι)
  requires signs : SignsOn(ι, ε)
  requires hf : f ∈ smoothU(ι, ε)
  shows f : signUnitarySpace(ι, ε) ⇒ complexSpace
proof
  sorry

-- Section: The chain rule
-- Matrices as the normed space ℂ^{ι×ι}.
def matCurveModule (ι : Set) : Set := coordinateModule(complexRing, ι × ι)

def matCurveNorm (ι : Set) : Set := supNormOn(ι × ι)

-- The composite t ↦ f(γ(t)) and the right derivative along a curve.
def composeCurve (f γ : Set) : Set := { (t, f(γ(t))) | t ∈ ℝ }

-- RightDerivatives.lean, hasDerivAt_curve: if γ′(t) = γ(t)X then
-- (f ∘ γ)′(t) = (Xf)(γ(t)).
theorem rightDeriv.curve (ι ε X f γ t : Set)
  requires finite : Finite(ι)
  requires signs : SignsOn(ι, ε)
  requires hX : X ∈ cMatrices(ι)
  requires hf : f ∈ smoothU(ι, ε)
  requires hγ : FunctionBetween(γ, ℝ, signUnitaryMatrices(ι, ε))
  requires deriv : HasCurveDeriv(matCurveModule(ι), matCurveNorm(ι), γ,
    matMul(complexRing, ι, ι, ι, γ(t), X), t)
  shows HasCurveDeriv(complexSelfModule, complexAbs, composeCurve(f, γ),
    rightDerivFn(ι, ε, X, f)(γ(t)), t)
proof
  sorry

-- RightDerivatives.lean, hasDerivAt_rightDeriv_expU: along t ↦ g exp tY,
-- Y ∈ Lie U(diag ε).
theorem rightDeriv.exp_curve (ι ε f g Y t : Set)
  requires finite : Finite(ι)
  requires signs : SignsOn(ι, ε)
  requires hf : f ∈ smoothU(ι, ε)
  requires hg : g ∈ signUnitaryMatrices(ι, ε)
  requires hY : Y ∈ unitaryLie(ι, signMatrix(complexRing, ι, ε))
  requires ht : t ∈ ℝ
  shows HasCurveDeriv(complexSelfModule, complexAbs, rightCurve(ι, f, g, Y),
    rightDerivFn(ι, ε, Y, f)(matMul(complexRing, ι, ι, ι, g, matExp(ι, realSmulMat(ι, t, Y)))), t)
proof
  sorry

-- RightDerivatives.lean, hasDerivAt_expU: d/dt g exp(tY) = g exp(tY) Y.
def expCurve (ι g Y : Set) : Set :=
  { (t, matMul(complexRing, ι, ι, ι, g, matExp(ι, realSmulMat(ι, t, Y)))) | t ∈ ℝ }

theorem matExp.curve_deriv (ι g Y t : Set)
  requires finite : Finite(ι)
  requires hg : g ∈ cMatrices(ι)
  requires hY : Y ∈ cMatrices(ι)
  requires ht : t ∈ ℝ
  shows HasCurveDeriv(matCurveModule(ι), matCurveNorm(ι), expCurve(ι, g, Y),
    matMul(complexRing, ι, ι, ι, expCurve(ι, g, Y)(t), Y), t)
proof
  sorry

end DiscreteSeriesRightDerivatives
