-- The parameters of the discrete series of U(p, q) and the objects built
-- on them: the Lie algebra of U(J) and the matrix exponential; products of
-- principal minors m_l(g); doubled Harish-Chandra parameters l = 2λ with a
-- gap, the lowest K-type Λ = λ + ρ − 2ρ_c and the Casimir value
-- |λ|² − |ρ|²; the maximal compact K = U(diag ε) ∩ U(n) with its Haar
-- probability; Flensted-Jensen's integral, the coefficient ψ_λ, the
-- formal degree deg_λ and the kernel e_λ = deg_λ ψ̄_λ; Borel matrices,
-- dominance and holomorphy of weight u; gl_n(ℂ)-modules, unitarisable
-- Banach representations of polynomial growth, derived actions, K-highest
-- vectors, the root cone, coefficient maps and Casimir operators.
-- Source: grh-compact/src/Lib/DiscreteSeries/FlenstedJensen/RepresentationDefs.lean
-- (unitaryLie, expU, weightMinors, gapThreshold, twoRho, paramAddRho,
-- weylDimensionPoly, maxCompactU, haarK, entryMask, blockDiagPart, HCParam,
-- HCParam.HasGap, HCParam.HasLargeGap, HCParam.lowestKType,
-- HCParam.casimirValue, HCParam.kTypeNormSq, HCParam.flenstedJensen,
-- HCParam.dsCoeff, HCParam.formalDegree, HCParam.dsKernel, negCount,
-- negCount_neg_add, negCount_sumElim, exists_equiv_of_card_neg, diagChar,
-- IsBorelMatrix, IsKDominant, IsPosFirstOrder, HasHolGap, blockDiagAlg,
-- IsHolOfWeight, holMinors, holMinorsPi, diagTorus, GlModule,
-- IsUnitaryRep, GlModule.E, IsDerivedAction, GlModule.IsCompactPrimitive,
-- HCParam.IsKHighest, HCParam.rootCone, GlModule.IsCoeffMap,
-- GlModule.casimir, GlModule.casimirK). Part of: "Flensted-Jensen's
-- function: coefficient of the lowest K-type of a discrete series (known
-- result; see Lib.DiscreteSeries.FlenstedJensen.KTypeProjection)" and
-- "Lowest K-type and Casimir value determine a discrete series
-- coefficient; analytic vectors (known result; see
-- Lib.DiscreteSeries.Rigidity.CasimirGrowth)."
-- Encoding. Signs ε are the complex numbers ±1 (SignsOn), and U(diag ε) is
-- signUnitaryMatrices of GRH.Weil.Fock with the Haar measure haarU of
-- GRH.DiscreteSeries.CayleyMeasure (the source's volume on USign ε).
-- Integer vectors l : ι → ℤ (the source's HCParam ε, an abbreviation for
-- n → ℤ) are functions into ℤ; a relation r on indices is a subset of
-- ι × ι. The source's ∏ᶠ over t ∈ ℤ in weightMinors is a finite product
-- over the t whose factor can differ from 1 (it is 1 elsewhere when
-- det g ≠ 0, the only case used). A family indexed by Φ of matrices is a
-- function on Φ; "analytic at z" for a function of finitely many complex
-- variables is complex differentiability on a neighbourhood of z (the
-- same thing, by Cauchy's formula). A gl_n(ℂ)-module is a ℂ-module M with
-- ρ : Mat_n(ℂ) → End M linear and bracket preserving. A Banach
-- representation is a normed ℂ-space (X, ‖·‖) with π from U(J) to its
-- continuous linear maps; the source's bounded sesquilinear form
-- B : X →L⋆ X →L ℂ is a function on pairs, conjugate linear in the first
-- argument. Derivatives along real curves t ↦ c(t) in X are
-- HasCurveDeriv: ‖c(t + s) − c(t) − s·D‖ = o(|s|).
-- Part of the GRH blueprint (layer 4, Lib/DiscreteSeries, stage S2).
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.DiscreteSeries.Representation
import GRH.DiscreteSeries.CayleyMeasure

section DiscreteSeriesRepresentation
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- Section: U(diag ε), its Lie algebra and the exponential
-- U(diag ε) with its Haar measure on the Borel sets.
def signHaar (ι ε : Set) : Set := haarU(ι, signMatrix(complexRing, ι, ε))

def signBorel (ι ε : Set) : Set := unitaryBorel(ι, signMatrix(complexRing, ι, ε))

-- RepresentationDefs.lean, unitaryLie J: X with XᴴJ + JX = 0.
def unitaryLie (ι J : Set) : Set :=
  { X ∈ cMatrices(ι) | matAdd(complexRing, ι, ι,
    matMul(complexRing, ι, ι, ι, conjTranspose(complexRing, complexConj, ι, ι, X), J),
    matMul(complexRing, ι, ι, ι, J, X)) = matZero(complexRing, ι, ι) }

-- The matrix exponential exp X = Σ X^k/k! (NormedSpace.exp), entrywise.
def matExpTerms (ι X q : Set) : Set :=
  { (k, complexDiv(matPow(complexRing, ι, X, k)(q), complexOfReal(realNat(factorial(k))))) |
    k ∈ ℕ }

def matExp (ι X : Set) : Set := { (q, complexTsum(matExpTerms(ι, X, q), ℕ)) | q ∈ ι × ι }

-- RepresentationDefs.lean, expU: exp X ∈ U(J) for X ∈ Lie U(J).
theorem matExp.unitary (ι J X : Set)
  requires finite : Finite(ι)
  requires hJ : J ∈ cMatrices(ι)
  requires hX : X ∈ unitaryLie(ι, J)
  shows matExp(ι, X) ∈ unitaryOf(ι, J)
proof
  sorry

-- tY for real t.
def realSmulMat (ι t Y : Set) : Set := matSmul(complexRing, ι, ι, complexOfReal(t), Y)

-- Section: Products of principal minors
-- The indices i with t ≤ lᵢ.
def superLevel (ι l t : Set) : Set := { i ∈ ι | integerLe(t, l(i)) }

-- RepresentationDefs.lean, weightMinors l g = ∏_{t ∈ ℤ} minor of g on
-- {t ≤ lᵢ}, each factor with t ≤ 0 divided by det g.
def weightMinorFactor (ι l g t : Set) : Set :=
  ⋃({ c ∈ complexCarrier |
    (integerLe(t, integerZero) ∧
      c = complexDiv(principalMinor(g, superLevel(ι, l, t)), matDet(complexRing, ι, g))) ∨
    (integerLess(integerZero, t) ∧ c = principalMinor(g, superLevel(ι, l, t))) })

-- The t where the factor can differ from 1: 0 < t ≤ max l, or min l < t ≤ 0.
def weightWindow (ι l : Set) : Set :=
  { t ∈ ℤ | (integerLess(integerZero, t) ∧ (∃ i ∈ ι, integerLe(t, l(i)))) ∨
    (integerLe(t, integerZero) ∧ (∃ i ∈ ι, integerLess(l(i), t))) }

def weightMinorTerms (ι l g : Set) : Set :=
  { (t, weightMinorFactor(ι, l, g, t)) | t ∈ weightWindow(ι, l) }

def weightMinors (ι l g : Set) : Set :=
  complexFiniteProduct(weightWindow(ι, l), weightMinorTerms(ι, l, g))

-- Section: Parameters
-- RepresentationDefs.lean, gapThreshold n A = 500n³ + A.
def gapThreshold (ι : Set, A : Nat) : Set :=
  R[500 * realNat(cardinality(ι)) ^ 3 + realNat(A)]

-- Relations on indices: all pairs, equal signs, different signs.
def allPairs (ι : Set) : Set := ι × ι

def sameSignPairs (ι ε : Set) : Set := { q ∈ ι × ι | ε(fst(q)) = ε(snd(q)) }

def oppositeSignPairs (ι ε : Set) : Set := { q ∈ ι × ι | ε(fst(q)) ≠ ε(snd(q)) }

-- RepresentationDefs.lean, twoRho l r i = #{j : r(i, j), l_j < l_i} −
-- #{j : r(i, j), l_i < l_j}.
def rootsBelow (ι l r i : Set) : Set := { j ∈ ι | (i, j) ∈ r ∧ integerLess(l(j), l(i)) }

def rootsAbove (ι l r i : Set) : Set := { j ∈ ι | (i, j) ∈ r ∧ integerLess(l(i), l(j)) }

def twoRho (ι l r i : Set) : Set :=
  integerClass(cardinality(rootsBelow(ι, l, r, i)), cardinality(rootsAbove(ι, l, r, i)))

def twoRhoVector (ι l r : Set) : Set := { (i, twoRho(ι, l, r, i)) | i ∈ ι }

-- ⌊x/2⌋ for an integer x.
def integerHalf (x : Set) : Set :=
  ⋃({ m ∈ ℤ | integerLe(integerAddValue(m, m), x) ∧
    integerLess(x, integerAddValue(integerAddValue(m, m), integerOfNat(2))) })

-- RepresentationDefs.lean, paramAddRho l i = ⌊(lᵢ + 2ρᵢ)/2⌋, μ = λ + ρ.
def paramAddRho (ι l : Set) : Set :=
  { (i, integerHalf(integerAddValue(l(i), twoRho(ι, l, allPairs(ι), i)))) | i ∈ ι }

-- The negation and sum of integer vectors, and the real value of an integer.
def intVecNeg (ι l : Set) : Set := { (i, integerNegValue(l(i))) | i ∈ ι }

def intVecAdd (ι l m : Set) : Set := { (i, integerAddValue(l(i), m(i))) | i ∈ ι }

def intVecSub (ι l m : Set) : Set := { (i, integerSubValue(l(i), m(i))) | i ∈ ι }

def intReal (z : Set) : Set := intCastMap(realRing)(z)

def intToComplex (z : Set) : Set := intCastMap(complexRing)(z)

-- RepresentationDefs.lean, weylDimensionPoly l =
-- (∏_{l_j < l_i} (l_i − l_j)/2) / ∏_{i<n} i!.
def realProduct (F w : Set) : Set :=
  finiteRingProduct(F, ℝ, realAdd, realZero, realNeg, realMul, realOne, w)

def descentPairs (ι l : Set) : Set := { q ∈ ι × ι | integerLess(l(snd(q)), l(fst(q))) }

def halfGapTerms (ι l : Set) : Set :=
  { (q, realDiv(intReal(integerSubValue(l(fst(q)), l(snd(q)))), R[2])) | q ∈ descentPairs(ι, l) }

def factorialReals : Set := { (i, realNat(factorial(i))) | i ∈ ℕ }

def weylDimensionPoly (ι l : Set) : Set :=
  realDiv(realProduct(descentPairs(ι, l), halfGapTerms(ι, l)),
    realProduct(cardinality(ι), factorialReals))

-- RepresentationDefs.lean, HCParam.HasGap: l = 2λ with distinct entries,
-- λ ∈ ((n − 1)/2 + ℤ)ⁿ, and |λᵢ − λⱼ| ≥ h whenever εᵢ ≠ εⱼ.
predicate HasGap (ι ε l h : Set) :=
  (l : ι → ℤ) ∧ h ∈ ℝ ∧ (∀ i ∈ ι, ∀ j ∈ ι, l(i) = l(j) → i = j) ∧
  (∀ i ∈ ι, ∃ m ∈ ℤ, integerAddValue(l(i), integerOfNat(cardinality(ι))) =
    integerAddValue(integerAddValue(m, m), integerOne)) ∧
  (∀ i ∈ ι, ∀ j ∈ ι, ε(i) ≠ ε(j) →
    R[2 * h] ≤ realAbs(R[intReal(l(i)) - intReal(l(j))]))

-- RepresentationDefs.lean, HCParam.HasLargeGap: gap 500n³ + A.
predicate HasLargeGap (ι ε l : Set, A : Nat) := HasGap(ι, ε, l, gapThreshold(ι, A))

-- RepresentationDefs.lean, HCParam.lowestKType: Λ = λ + ρ − 2ρ_c.
def lowestKType (ι ε l : Set) : Set :=
  { (i, integerSubValue(paramAddRho(ι, l)(i), twoRho(ι, l, sameSignPairs(ι, ε), i))) | i ∈ ι }

-- RepresentationDefs.lean, HCParam.casimirValue: Σᵢ (lᵢ² − (2ρᵢ)²)/4.
def casimirTerms (ι l : Set) : Set :=
  { (i, realDiv(R[intReal(l(i)) ^ 2 - intReal(twoRho(ι, l, allPairs(ι), i)) ^ 2], R[4])) |
    i ∈ ι }

def casimirValue (ι l : Set) : Set := realFiniteSum(casimirTerms(ι, l), ι)

-- Section: The maximal compact subgroup
-- RepresentationDefs.lean, maxCompactU ε = U(diag ε) ∩ U(n), its group,
-- topology, and haarK ε, its Haar measure of mass one.
def maxCompactU (ι ε : Set) : Set :=
  signUnitaryMatrices(ι, ε) ∩ unitaryOf(ι, matOne(complexRing, ι))

def maxCompactGroup (ι ε : Set) : Set := subgroupGroup(signUnitaryGroup(ι, ε), maxCompactU(ι, ε))

def maxCompactSpace (ι ε : Set) : Set := subspace(signUnitarySpace(ι, ε), maxCompactU(ι, ε))

def maxCompactBorel (ι ε : Set) : Set := borelSpace(maxCompactSpace(ι, ε))

def haarK (ι ε : Set) : Set :=
  haarMeasureNormalized(maxCompactGroup(ι, ε), maxCompactSpace(ι, ε), maxCompactU(ι, ε))

-- RepresentationDefs.lean, the CompactSpace instance, and haarK a Haar
-- probability measure.
theorem maxCompactU.compact (ι ε : Set)
  requires finite : Finite(ι)
  requires signs : SignsOn(ι, ε)
  shows Compact(maxCompactSpace(ι, ε), maxCompactU(ι, ε)) ∧
    RegularHaarMeasure(maxCompactGroup(ι, ε), maxCompactSpace(ι, ε), haarK(ι, ε)) ∧
    ProbabilityMeasure(maxCompactBorel(ι, ε), haarK(ι, ε))
proof
  sorry

-- RepresentationDefs.lean, entryMask r and blockDiagPart ε: keep the entries
-- (i, j) ∈ r (with εᵢ = εⱼ), zero elsewhere.
def entryMaskValue (r g q : Set) : Set :=
  ⋃({ c ∈ complexCarrier | (q ∈ r ∧ c = g(q)) ∨ (q ∉ r ∧ c = complexZero) })

def entryMask (ι r g : Set) : Set := { (q, entryMaskValue(r, g, q)) | q ∈ ι × ι }

def blockDiagPart (ι ε g : Set) : Set := entryMask(ι, sameSignPairs(ι, ε), g)

-- Section: Flensted-Jensen's function
-- RepresentationDefs.lean, HCParam.kTypeNormSq: c_w = ∫_K |m_w(k)|² dk.
def kTypeNormSqIntegrand (ι ε w : Set) : Set :=
  { (k, R[complexAbs(weightMinors(ι, w, k)) ^ 2]) | k ∈ maxCompactU(ι, ε) }

def kTypeNormSq (ι ε w : Set) : Set :=
  realMeasureIntegral(maxCompactBorel(ι, ε), haarK(ι, ε), kTypeNormSqIntegrand(ι, ε, w))

-- RepresentationDefs.lean, HCParam.flenstedJensen l g z =
-- c_Λ⁻¹ ∫_K m_Λ(gk) conj(m_Λ(k)) / m_{−μ}(kᴴzk) dk.
def flenstedJensenIntegrand (ι ε l g z : Set) : Set :=
  { (k, complexDiv(ℂ[weightMinors(ι, lowestKType(ι, ε, l), matMul(complexRing, ι, ι, ι, g, k)) *
        complexConj(weightMinors(ι, lowestKType(ι, ε, l), k))],
      weightMinors(ι, intVecNeg(ι, paramAddRho(ι, l)),
        gramMatrix(complexRing, complexConj, ι, ι, ι, z, k, k)))) | k ∈ maxCompactU(ι, ε) }

def flenstedJensen (ι ε l g z : Set) : Set :=
  complexDiv(complexMeasureIntegral(maxCompactBorel(ι, ε), haarK(ι, ε),
      flenstedJensenIntegrand(ι, ε, l, g, z)),
    complexOfReal(kTypeNormSq(ι, ε, lowestKType(ι, ε, l))))

-- RepresentationDefs.lean, HCParam.dsCoeff: ψ_λ(g) = Ξ(a, a⁻¹g), a the
-- block diagonal part of g.
def dsCoeff (ι ε l g : Set) : Set :=
  flenstedJensen(ι, ε, l, blockDiagPart(ι, ε, g),
    matMul(complexRing, ι, ι, ι, matInverse(complexRing, ι, blockDiagPart(ι, ε, g)), g))

def dsCoeffOn (ι ε l : Set) : Set := { (g, dsCoeff(ι, ε, l, g)) | g ∈ signUnitaryMatrices(ι, ε) }

-- RepresentationDefs.lean, HCParam.formalDegree: (∫_G |ψ_λ|²)⁻¹.
def dsCoeffNormSq (ι ε l : Set) : Set :=
  { (g, R[complexAbs(dsCoeff(ι, ε, l, g)) ^ 2]) | g ∈ signUnitaryMatrices(ι, ε) }

def formalDegree (ι ε l : Set) : Set :=
  realInvValue(realMeasureIntegral(signBorel(ι, ε), signHaar(ι, ε), dsCoeffNormSq(ι, ε, l)))

-- RepresentationDefs.lean, HCParam.dsKernel: e_λ = deg_λ ψ̄_λ.
def dsKernel (ι ε l g : Set) : Set :=
  ℂ[complexOfReal(formalDegree(ι, ε, l)) * complexConj(dsCoeff(ι, ε, l, g))]

def dsKernelOn (ι ε l : Set) : Set := { (g, dsKernel(ι, ε, l, g)) | g ∈ signUnitaryMatrices(ι, ε) }

-- Section: Counting signs
-- RepresentationDefs.lean, negCount a = #{i : aᵢ = −1}.
def negCount (ι a : Set) : Set := cardinality({ i ∈ ι | a(i) = ℂ[-1] })

def negSignsOf (ι a : Set) : Set := { (i, ℂ[-a(i)]) | i ∈ ι }

-- RepresentationDefs.lean, negCount_neg_add.
theorem negCount.neg_add (ι a : Set)
  requires finite : Finite(ι)
  requires signs : SignsOn(ι, a)
  shows add(negCount(ι, negSignsOf(ι, a)), negCount(ι, a)) = cardinality(ι)
proof
  sorry

-- RepresentationDefs.lean, exists_equiv_of_card_neg: equal sizes and
-- equal numbers of −1 give a bijection e with b ∘ e = a.
theorem negCount.exists_equiv (α a β b : Set)
  requires finite1 : Finite(α)
  requires finite2 : Finite(β)
  requires signs1 : SignsOn(α, a)
  requires signs2 : SignsOn(β, b)
  requires size : cardinality(α) = cardinality(β)
  requires negs : negCount(α, a) = negCount(β, b)
  shows ∃ e, BijectiveBetween(e, α, β) ∧ ∀ i ∈ α, b(e(i)) = a(i)
proof
  sorry

-- Section: Borel matrices, dominance and holomorphy
-- z^k for an integer k (z⁻¹ = 0 for z = 0, as in the source).
def complexZpow (z k : Set) : Set :=
  ⋃({ c ∈ complexCarrier | ∃ m ∈ ℕ,
    (k = integerOfNat(m) ∧ c = ℂ[z ^ m]) ∨
    (k = integerNegValue(integerOfNat(m)) ∧ c = ℂ[complexInv(z) ^ m]) })

-- RepresentationDefs.lean, diagChar w b = ∏ᵢ b_ii^{wᵢ}.
def diagCharTerms (ι w b : Set) : Set := { (i, complexZpow(b[i, i], w(i))) | i ∈ ι }

def diagChar (ι w b : Set) : Set := complexFiniteProduct(ι, diagCharTerms(ι, w, b))

-- RepresentationDefs.lean, IsBorelMatrix o b: invertible, and b_ij = 0
-- whenever o_j < o_i.
predicate IsBorelMatrix (ι o b : Set) :=
  b ∈ cMatrices(ι) ∧ (∀ i ∈ ι, ∀ j ∈ ι, integerLess(o(j), o(i)) → b[i, j] = complexZero) ∧
  matDet(complexRing, ι, b) ≠ complexZero

-- RepresentationDefs.lean, IsKDominant ε o w: w_j ≤ w_i when εᵢ = εⱼ and
-- oᵢ < oⱼ.
predicate IsKDominant (ι ε o w : Set) :=
  ∀ i ∈ ι, ∀ j ∈ ι, ε(i) = ε(j) → integerLess(o(i), o(j)) → integerLe(w(j), w(i))

-- RepresentationDefs.lean, IsPosFirstOrder: o injective, the indices of
-- sign +1 before those of sign −1.
predicate IsPosFirstOrder (ι ε o : Set) :=
  (∀ i ∈ ι, ∀ j ∈ ι, o(i) = o(j) → i = j) ∧
  (∀ i ∈ ι, ∀ j ∈ ι, ε(i) = complexOne → ε(j) = ℂ[-1] → integerLess(o(i), o(j)))

-- RepresentationDefs.lean, HasHolGap ε w γ: wᵢ + γ ≤ wⱼ for εᵢ = 1, εⱼ = −1.
predicate HasHolGap (ι ε w : Set, γ : Nat) :=
  ∀ i ∈ ι, ∀ j ∈ ι, ε(i) = complexOne → ε(j) = ℂ[-1] →
    integerLe(integerAddValue(w(i), integerOfNat(γ)), w(j))

-- RepresentationDefs.lean, blockDiagAlg ε: the matrices commuting with
-- diag ε.
def blockDiagAlg (ι ε : Set) : Set :=
  { b ∈ cMatrices(ι) | matMul(complexRing, ι, ι, ι, b, signMatrix(complexRing, ι, ε)) =
    matMul(complexRing, ι, ι, ι, signMatrix(complexRing, ι, ε), b) }

-- Holomorphy of a function of the complex variables indexed by a finite I:
-- complex differentiable on a sup-norm ball around z.
def supNormOn (I : Set) : Set := { (v, supNorm(I, complexAbs, v)) | v ∈ functionSpace(I, complexCarrier) }

predicate CHolomorphicAt (I F z : Set) :=
  z ∈ functionSpace(I, complexCarrier) ∧
  ∃ r ∈ ℝ, realZero < r ∧ ∀ w ∈ functionSpace(I, complexCarrier),
    (∀ i ∈ I, complexAbs(ℂ[w(i) - z(i)]) < r) →
      FDifferentiableAt(F, coordinateModule(complexRing, I), supNormOn(I),
        complexSelfModule, complexAbs, complexRing, w)

-- A family z : Φ → Mat_n(ℂ) as a point of ℂ^{Φ×(ι×ι)}; the pointwise
-- product (h_τ b_τ)_τ.
def matFamilyMul (ι h b : Set) : Set := { (τ, matMul(complexRing, ι, ι, ι, h(τ), b(τ))) | τ ∈ domain(h) }

def familyPoint (Φ ι z : Set) : Set := { (p, z(fst(p))(snd(p))) | p ∈ Φ × (ι × ι) }

def diagCharProductTerms (ι u b : Set) : Set := { (τ, diagChar(ι, u(τ), b(τ))) | τ ∈ domain(u) }

-- RepresentationDefs.lean, IsHolOfWeight o u F ε′: F on U(diag ε)^Φ is
-- holomorphic of weight u: some F′, analytic at every (h_τ b_τ)_τ, has
-- F′(hb) = ∏_τ b_τ^{u_τ} F(h), for b_τ invertible o-triangular and
-- h_τ, b_τ commuting with diag ε′.
predicate IsHolOfWeight (ι ε o Φ u F ε2 : Set) :=
  ∃ F2, ∀ h ∈ functionSpace(Φ, signUnitaryMatrices(ι, ε)), ∀ b ∈ functionSpace(Φ, cMatrices(ι)),
    (∀ τ ∈ Φ, IsBorelMatrix(ι, o, b(τ))) →
    (∀ τ ∈ Φ, h(τ) ∈ blockDiagAlg(ι, ε2) ∧ b(τ) ∈ blockDiagAlg(ι, ε2)) →
      CHolomorphicAt(Φ × (ι × ι), F2, familyPoint(Φ, ι, matFamilyMul(ι, h, b))) ∧
      F2(familyPoint(Φ, ι, matFamilyMul(ι, h, b))) =
        ℂ[complexFiniteProduct(Φ, diagCharProductTerms(ι, u, b)) * F(h)]

-- RepresentationDefs.lean, holMinors ε o b = m_{o + c·1₊}(b)/m_{c·1₊}(b),
-- c = 2Σ|o_j|.
def holAbsTerms (ι o : Set) : Set := { (i, integerAbs(o(i))) | i ∈ ι }

def holAbsTotal (ι o : Set) : Set :=
  finiteRingSum(ι, ℤ, integerAdd, integerZero, integerNeg, integerMul, integerOne,
    holAbsTerms(ι, o))

def holShiftValue (ι ε o i : Set) : Set :=
  ⋃({ c ∈ ℤ | (ε(i) = complexOne ∧
      c = integerAddValue(holAbsTotal(ι, o), holAbsTotal(ι, o))) ∨
    (ε(i) ≠ complexOne ∧ c = integerZero) })

def holShift (ι ε o : Set) : Set := { (i, holShiftValue(ι, ε, o, i)) | i ∈ ι }

def holMinors (ι ε o b : Set) : Set :=
  complexDiv(weightMinors(ι, intVecAdd(ι, o, holShift(ι, ε, o)), b),
    weightMinors(ι, holShift(ι, ε, o), b))

-- RepresentationDefs.lean, holMinorsPi ε u h = ∏_τ holMinors ε u_τ h_τ.
def holMinorsTerms (ι ε u h : Set) : Set := { (τ, holMinors(ι, ε, u(τ), h(τ))) | τ ∈ domain(u) }

def holMinorsPi (ι ε Φ u h : Set) : Set := complexFiniteProduct(Φ, holMinorsTerms(ι, ε, u, h))

-- RepresentationDefs.lean, diagTorus ε t = diag(t) for |tᵢ| = 1.
def diagTorus (ι t : Set) : Set := matDiagonal(complexRing, ι, t)

theorem diagTorus.mem (ι ε t : Set)
  requires finite : Finite(ι)
  requires signs : SignsOn(ι, ε)
  requires circle : (t : ι → complexCarrier)
  requires unit : ∀ i ∈ ι, complexAbs(t(i)) = realOne
  shows diagTorus(ι, t) ∈ signUnitaryMatrices(ι, ε)
proof
  sorry

-- Section: gl_n(ℂ)-modules
-- RepresentationDefs.lean, GlModule n M: ρ : Mat_n(ℂ) → End M ℂ-linear with
-- ρ(XY − YX) = ρ(X)ρ(Y) − ρ(Y)ρ(X).
def matBracket (ι X Y : Set) : Set :=
  matSub(ι, matMul(complexRing, ι, ι, ι, X, Y), matMul(complexRing, ι, ι, ι, Y, X))

predicate IsGlModule (ι M ρ : Set) :=
  Module(M, complexRing) ∧ FunctionBetween(ρ, cMatrices(ι),
    functionSpace(Module.carrier(M), Module.carrier(M))) ∧
  (∀ X ∈ cMatrices(ι), LinearMap(ρ(X), M, complexRing, M)) ∧
  (∀ X ∈ cMatrices(ι), ∀ Y ∈ cMatrices(ι), ∀ c ∈ complexCarrier, ∀ v ∈ Module.carrier(M),
    ρ(matAdd(complexRing, ι, ι, X, matSmul(complexRing, ι, ι, c, Y)))(v) =
      Module.add(M)(ρ(X)(v), Module.smul(M)(c, ρ(Y)(v)))) ∧
  (∀ X ∈ cMatrices(ι), ∀ Y ∈ cMatrices(ι), ∀ v ∈ Module.carrier(M),
    ρ(matBracket(ι, X, Y))(v) =
      Module.add(M)(ρ(X)(ρ(Y)(v)), Module.smul(M)(ℂ[-1], ρ(Y)(ρ(X)(v)))))

-- RepresentationDefs.lean, GlModule.E a b = ρ(E_ab).
def glE (ι ρ a b : Set) : Set := ρ(matSingle(complexRing, ι, ι, a, b, complexOne))

-- RepresentationDefs.lean, GlModule.casimir r = Σ_{r(a, b)} E_ab E_ba, and
-- casimirK ε for r the pairs of equal sign.
def casimirTermsAt (ι M ρ r v : Set) : Set := { (q, glE(ι, ρ, fst(q), snd(q))(glE(ι, ρ, snd(q), fst(q))(v))) | q ∈ r }

def glCasimir (ι M ρ r : Set) : Set :=
  { (v, groupFiniteSum(Module.additive(M), r, casimirTermsAt(ι, M, ρ, r, v))) |
    v ∈ Module.carrier(M) }

def glCasimirK (ι ε M ρ : Set) : Set := glCasimir(ι, M, ρ, sameSignPairs(ι, ε))

-- RepresentationDefs.lean, GlModule.IsCompactPrimitive: E_ab x = 0 when
-- ε_a = ε_b and l_b < l_a.
predicate IsCompactPrimitive (ι ε l M ρ x : Set) :=
  ∀ a ∈ ι, ∀ b ∈ ι, ε(a) = ε(b) → integerLess(l(b), l(a)) →
    glE(ι, ρ, a, b)(x) = Module.zero(M)

-- RepresentationDefs.lean, HCParam.IsKHighest ν x: E_aa x = ν_a x and x is
-- compact primitive for l.
predicate IsKHighest (ι ε l M ρ ν x : Set) :=
  x ∈ Module.carrier(M) ∧
  (∀ a ∈ ι, glE(ι, ρ, a, a)(x) = Module.smul(M)(intToComplex(ν(a)), x)) ∧
  IsCompactPrimitive(ι, ε, l, M, ρ, x)

-- RepresentationDefs.lean, HCParam.rootCone l: the integer β with
-- ⟨o, β⟩ ≤ 0 for every o with oᵢ < oⱼ whenever lⱼ < lᵢ.
def intDotTerms (ι o β : Set) : Set := { (i, R[intReal(o(i)) * intReal(β(i))]) | i ∈ ι }

def rootCone (ι l : Set) : Set :=
  { β ∈ functionSpace(ι, ℤ) | ∀ o ∈ functionSpace(ι, ℤ),
    (∀ i ∈ ι, ∀ j ∈ ι, integerLess(l(j), l(i)) → integerLess(o(i), o(j))) →
      realFiniteSum(intDotTerms(ι, o, β), ι) ≤ realZero }

-- Section: Representations and derived actions
-- The derivative D of a curve c : ℝ → X at t in a normed ℂ-space.
predicate HasCurveDeriv (X norm c D t : Set) :=
  t ∈ ℝ ∧ D ∈ Module.carrier(X) ∧ FunctionBetween(c, ℝ, Module.carrier(X)) ∧
  ∀ e ∈ ℝ, realZero < e → ∃ d ∈ ℝ, realZero < d ∧ ∀ s ∈ ℝ,
    realZero < realAbs(s) → realAbs(s) < d →
      norm(Module.add(X)(c(R[t + s]), Module.add(X)(Module.smul(X)(ℂ[-1], c(t)),
        Module.smul(X)(complexOfReal(R[-s]), D)))) ≤ R[e * realAbs(s)]

-- The orbit map g ↦ π(g)x.
def orbitMapOf (ι J π x : Set) : Set := { (g, π(g)(x)) | g ∈ unitaryOf(ι, J) }

-- RepresentationDefs.lean, IsUnitaryRep A π B: π : U(J) → End X a
-- homomorphism to continuous linear maps, strongly continuous, with
-- ‖π(g)‖ ≤ c‖g‖^A, and B a bounded hermitian positive definite
-- π-invariant form.
predicate IsUnitaryRep (ι J X norm : Set, A : Nat, π B : Set) :=
  NormedSpace(X, complexRing, complexAbs, norm) ∧
  FunctionBetween(π, unitaryOf(ι, J), functionSpace(Module.carrier(X), Module.carrier(X))) ∧
  (∀ g ∈ unitaryOf(ι, J), ContinuousLinearMap(π(g), X, norm, X, norm, complexRing)) ∧
  (∀ g ∈ unitaryOf(ι, J), ∀ h ∈ unitaryOf(ι, J), ∀ x ∈ Module.carrier(X),
    π(matMul(complexRing, ι, ι, ι, g, h))(x) = π(g)(π(h)(x))) ∧
  (∀ x ∈ Module.carrier(X), π(matOne(complexRing, ι))(x) = x) ∧
  (∀ x ∈ Module.carrier(X), orbitMapOf(ι, J, π, x) :
    unitaryOfSpace(ι, J) ⇒ spaceTopology(X, norm)) ∧
  FunctionBetween(B, Module.carrier(X) × Module.carrier(X), complexCarrier) ∧
  (∃ C ∈ ℝ, ∀ x ∈ Module.carrier(X), ∀ y ∈ Module.carrier(X),
    complexAbs(B(x, y)) ≤ R[C * norm(x) * norm(y)]) ∧
  (∀ x ∈ Module.carrier(X), ∀ y ∈ Module.carrier(X), ∀ z ∈ Module.carrier(X),
    ∀ c ∈ complexCarrier,
      B(x, Module.add(X)(y, Module.smul(X)(c, z))) = ℂ[B(x, y) + c * B(x, z)] ∧
      B(Module.add(X)(y, Module.smul(X)(c, z)), x) = ℂ[B(y, x) + complexConj(c) * B(z, x)]) ∧
  (∀ g ∈ unitaryOf(ι, J), ∀ x ∈ Module.carrier(X), ∀ y ∈ Module.carrier(X),
    B(π(g)(x), π(g)(y)) = B(x, y)) ∧
  (∀ x ∈ Module.carrier(X), ∀ y ∈ Module.carrier(X), complexConj(B(x, y)) = B(y, x)) ∧
  (∀ x ∈ Module.carrier(X), x ≠ Module.zero(X) → realZero < complexRe(B(x, x))) ∧
  (∃ c ∈ ℝ, ∀ g ∈ unitaryOf(ι, J), opNorm(π(g), X, norm, norm) ≤ R[c * matOpNorm(ι, g) ^ A])

-- The curve t ↦ π(exp tY) w.
def repCurve (ι π Y w : Set) : Set := { (t, π(matExp(ι, realSmulMat(ι, t, Y)))(w)) | t ∈ ℝ }

-- RepresentationDefs.lean, IsDerivedAction π ι ρ: d/dt π(exp tY) ι(v) at
-- t = 0 is ι(ρ(Y)v), for Y ∈ Lie U(J) and v ∈ M.
predicate IsDerivedAction (ι J X norm π M e ρ : Set) :=
  ∀ Y ∈ unitaryLie(ι, J), ∀ v ∈ Module.carrier(M),
    HasCurveDeriv(X, norm, repCurve(ι, π, Y, e(v)), e(ρ(Y)(v)), realZero)

-- RepresentationDefs.lean, GlModule.IsCoeffMap c: for Y ∈ Lie U(J), the
-- derivative of t ↦ c(g exp tY)v is c(g exp tY)(ρ(Y)v).
def coeffCurve (ι c g Y v : Set) : Set :=
  { (t, c(matMul(complexRing, ι, ι, ι, g, matExp(ι, realSmulMat(ι, t, Y))))(v)) | t ∈ ℝ }

predicate IsCoeffMap (ι J M ρ X norm c : Set) :=
  ∀ g ∈ unitaryOf(ι, J), ∀ Y ∈ unitaryLie(ι, J), ∀ v ∈ Module.carrier(M), ∀ t ∈ ℝ,
    HasCurveDeriv(X, norm, coeffCurve(ι, c, g, Y, v),
      c(matMul(complexRing, ι, ι, ι, g, matExp(ι, realSmulMat(ι, t, Y))))(ρ(Y)(v)), t)

end DiscreteSeriesRepresentation
