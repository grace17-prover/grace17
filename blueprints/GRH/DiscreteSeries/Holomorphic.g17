-- Holomorphic functions of weight u on U(p, q)^Φ and the holomorphic
-- discrete series: equivariance of products of minors under Borel
-- matrices, holomorphy of products of minors and of coefficient maps of
-- K-highest vectors, the torus law, circle means over diag(s^o), the
-- reproducing formulas ∫ F m̄ = (∫ |m|²) F(1) on K and on U(p, q)^Φ, the
-- characterisation F = F(1)·m^hol, and ψ_λ = m^hol_w for holomorphic
-- parameters.
-- Source: grh-compact/src/Lib/DiscreteSeries/Holomorphic/MinorEquivariance.lean
-- (IsHolOfWeight.sum, IsHolOfWeight.mul,
-- IsKDominant.weightMinors_mul_borel, weightMinors_oppBorel_mul),
-- Holomorphic/HolomorphicExtension.lean (IsHolOfWeight.continuous,
-- IsHolOfWeight.apply_mul_diagTorus, isHolOfWeight_weightMinors,
-- kTypeNormSq_pos, IsKHighest.isHolOfWeight_coeffMap,
-- IsHolOfWeight.circle_mean_weightMinors,
-- IsHolOfWeight.integral_mul_conj_weightMinors),
-- Holomorphic/HolomorphicMinor.lean (holMinorsPi_one,
-- isHolOfWeight_holMinorsPi, IsHolOfWeight.circle_mean_holMinorsPi,
-- IsHolOfWeight.integral_mul_conj_holMinorsPi,
-- IsHolOfWeight.eq_holMinorsPi_mul), Holomorphic/HolomorphicChamber.lean
-- (dsCoeff_eq_holMinors). Known result: "Holomorphic discrete series:
-- highest coefficient and reproducing property."
-- Not stated: the analytic-continuation steps of HolomorphicExtension.lean
-- (lowerMask, lowerLiePart, lowerLiePart_mem_unitaryLie,
-- exists_borel_chart, hasFDerivAt_of_rays, exists_analytic_path,
-- IsBorelMatrix.exists_eq_diagonal_exp,
-- eventually_exists_torus_entire_factor) and holMinors_ite_sign,
-- IsPosFirstOrder.isKDominant_shift.
-- STAND-IN: csDSPiMeasure for Mathlib's Measure.pi (layer 3, Measure): the
-- product measure on the functions Φ → X, given by its values on boxes of
-- finite measure (which determine it for σ-finite factors). The real one
-- needs finite products of measures with their uniqueness.
-- Encoding. As in GRH.DiscreteSeries.Representation. The circle mean over
-- UnitAddCircle (Haar probability) is ∫₀¹ dθ with s = e^{2πiθ}. A
-- multilinear form on the vectors x_τ is a function ℓ on families that is
-- ℂ-linear in each argument and bounded; families of coefficient maps c_τ
-- are functions on Φ.
-- Part of the GRH blueprint (layer 4, Lib/DiscreteSeries, stage S2).
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.DiscreteSeries.Holomorphic
import GRH.DiscreteSeries.Rigidity
import GRH.Calculus.Analytic

section DiscreteSeriesHolomorphic
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- Section: Equivariance of minors
-- MinorEquivariance.lean, IsKDominant.weightMinors_mul_borel: for o
-- injective, w K-dominant for o, x invertible and b block diagonal and
-- o-upper triangular, m_w(xb) = m_w(x) b^w.
theorem weightMinors.mul_borel (ι ε o w x b : Set)
  requires finite : Finite(ι)
  requires signs : SignsOn(ι, ε)
  requires injective : ∀ i ∈ ι, ∀ j ∈ ι, o(i) = o(j) → i = j
  requires dominant : IsKDominant(ι, ε, o, w)
  requires hx : x ∈ cMatrices(ι)
  requires invertible : matDet(complexRing, ι, x) ≠ complexZero
  requires block : b ∈ blockDiagAlg(ι, ε)
  requires borel : IsBorelMatrix(ι, o, b)
  shows weightMinors(ι, w, matMul(complexRing, ι, ι, ι, x, b)) =
    ℂ[weightMinors(ι, w, x) * diagChar(ι, w, b)]
proof
  sorry

-- MinorEquivariance.lean, IsKDominant.weightMinors_oppBorel_mul: for b
-- triangular for −o, m_w(bx) = b^w m_w(x).
theorem weightMinors.oppBorel_mul (ι ε o w x b : Set)
  requires finite : Finite(ι)
  requires signs : SignsOn(ι, ε)
  requires injective : ∀ i ∈ ι, ∀ j ∈ ι, o(i) = o(j) → i = j
  requires dominant : IsKDominant(ι, ε, o, w)
  requires hx : x ∈ cMatrices(ι)
  requires invertible : matDet(complexRing, ι, x) ≠ complexZero
  requires block : b ∈ blockDiagAlg(ι, ε)
  requires borel : IsBorelMatrix(ι, intVecNeg(ι, o), b)
  shows weightMinors(ι, w, matMul(complexRing, ι, ι, ι, b, x)) =
    ℂ[diagChar(ι, w, b) * weightMinors(ι, w, x)]
proof
  sorry

-- Section: Holomorphic functions of weight u
-- Sums and products of functions on U(diag ε)^Φ.
def familySumTerms (T c f h : Set) : Set := { (i, ℂ[c(i) * f(i)(h)]) | i ∈ T }

def familySum (T c f h : Set) : Set :=
  groupFiniteSum(complexAdditiveGroup, T, familySumTerms(T, c, f, h))

def familySumFn (ι ε Φ T c f : Set) : Set :=
  { (h, familySum(T, c, f, h)) | h ∈ functionSpace(Φ, signUnitaryMatrices(ι, ε)) }

def productFn (ι ε Φ F G : Set) : Set :=
  { (h, ℂ[F(h) * G(h)]) | h ∈ functionSpace(Φ, signUnitaryMatrices(ι, ε)) }

-- MinorEquivariance.lean, IsHolOfWeight.sum and IsHolOfWeight.mul.
theorem IsHolOfWeight.sum (ι ε o Φ u ε2 T c f : Set)
  requires finite : Finite(T)
  requires hc : (c : T → complexCarrier)
  requires hol : ∀ i ∈ T, IsHolOfWeight(ι, ε, o, Φ, u, f(i), ε2)
  shows IsHolOfWeight(ι, ε, o, Φ, u, familySumFn(ι, ε, Φ, T, c, f), ε2)
proof
  sorry

def weightSum (Φ ι u v : Set) : Set := { (τ, intVecAdd(ι, u(τ), v(τ))) | τ ∈ Φ }

theorem IsHolOfWeight.mul (ι ε o Φ u v F G ε2 : Set)
  requires finite : Finite(ι)
  requires injective : ∀ i ∈ ι, ∀ j ∈ ι, o(i) = o(j) → i = j
  requires holF : IsHolOfWeight(ι, ε, o, Φ, u, F, ε2)
  requires holG : IsHolOfWeight(ι, ε, o, Φ, v, G, ε2)
  shows IsHolOfWeight(ι, ε, o, Φ, weightSum(Φ, ι, u, v), productFn(ι, ε, Φ, F, G), ε2)
proof
  sorry

-- The product topology on U(diag ε)^Φ.
def familySpace (ι ε Φ : Set) : Set := piSpace(Φ, constantSpaces(Φ, signUnitarySpace(ι, ε)))

-- HolomorphicExtension.lean, IsHolOfWeight.continuous.
theorem IsHolOfWeight.continuous (ι ε o Φ u F : Set)
  requires finite : Finite(ι)
  requires finiteΦ : Finite(Φ)
  requires signs : SignsOn(ι, ε)
  requires injective : ∀ i ∈ ι, ∀ j ∈ ι, o(i) = o(j) → i = j
  requires hol : IsHolOfWeight(ι, ε, o, Φ, u, F, onesSigns(ι))
  shows F : familySpace(ι, ε, Φ) ⇒ complexSpace
proof
  sorry

-- The family h·diag(t) and the character ∏_{τ,i} t_i^{u_τ,i}.
def torusShift (ι h t : Set) : Set := { (τ, matMul(complexRing, ι, ι, ι, h(τ), diagTorus(ι, t))) | τ ∈ domain(h) }

def torusCharTerms (ι Φ u t : Set) : Set :=
  { (p, complexZpow(t(snd(p)), u(fst(p))(snd(p)))) | p ∈ Φ × ι }

-- HolomorphicExtension.lean, IsHolOfWeight.apply_mul_diagTorus:
-- F(h·diag t) = ∏_{τ,i} t_i^{u_τ,i} F(h).
theorem IsHolOfWeight.apply_mul_diagTorus (ι ε o Φ u F ε2 h t : Set)
  requires finite : Finite(ι)
  requires finiteΦ : Finite(Φ)
  requires signs : SignsOn(ι, ε)
  requires injective : ∀ i ∈ ι, ∀ j ∈ ι, o(i) = o(j) → i = j
  requires hol : IsHolOfWeight(ι, ε, o, Φ, u, F, ε2)
  requires hh : h ∈ functionSpace(Φ, signUnitaryMatrices(ι, ε))
  requires ht : (t : ι → complexCarrier)
  requires unit : ∀ i ∈ ι, complexAbs(t(i)) = realOne
  shows F(torusShift(ι, h, t)) = ℂ[complexFiniteProduct(Φ × ι, torusCharTerms(ι, Φ, u, t)) * F(h)]
proof
  sorry

-- HolomorphicExtension.lean, isHolOfWeight_weightMinors: for u_τ dominant
-- for (ε′, o) and a invertible, g ↦ ∏_τ m_{u_τ}(a g_τ) is holomorphic of
-- weight u.
def minorsProductTerms (ι u a g : Set) : Set :=
  { (τ, weightMinors(ι, u(τ), matMul(complexRing, ι, ι, ι, a, g(τ)))) | τ ∈ domain(u) }

def minorsProduct (ι ε Φ u a : Set) : Set :=
  { (g, complexFiniteProduct(Φ, minorsProductTerms(ι, u, a, g))) |
    g ∈ functionSpace(Φ, signUnitaryMatrices(ι, ε)) }

theorem minorsProduct.hol (ι ε ε2 o Φ u a : Set)
  requires finite : Finite(ι)
  requires finiteΦ : Finite(Φ)
  requires signs : SignsOn(ι, ε)
  requires injective : ∀ i ∈ ι, ∀ j ∈ ι, o(i) = o(j) → i = j
  requires dominant : ∀ τ ∈ Φ, IsKDominant(ι, ε2, o, u(τ))
  requires ha : a ∈ cMatrices(ι)
  requires invertible : matDet(complexRing, ι, a) ≠ complexZero
  shows IsHolOfWeight(ι, ε, o, Φ, u, minorsProduct(ι, ε, Φ, u, a), ε2)
proof
  sorry

-- HolomorphicExtension.lean, kTypeNormSq_pos: c_w > 0.
theorem kTypeNormSq.pos (ι ε w : Set)
  requires finite : Finite(ι)
  requires signs : SignsOn(ι, ε)
  requires hw : (w : ι → ℤ)
  shows realZero < kTypeNormSq(ι, ε, w)
proof
  sorry

-- HolomorphicExtension.lean, IsKHighest.isHolOfWeight_coeffMap: for x_τ of
-- weight u_τ killed by the E_ab with ε′_a = ε′_b, o_a < o_b, continuous
-- coefficient maps c_τ and a bounded multilinear form ℓ,
-- h ↦ ℓ((c_τ(h_τ)x_τ)_τ) is holomorphic of weight u for ε′.
def familyNorms (Φ norm v : Set) : Set := { (τ, norm(v(τ))) | τ ∈ Φ }

def updateValue (v τ y σ : Set) : Set :=
  ⋃({ z ∈ {y, v(σ)} | (σ = τ ∧ z = y) ∨ (σ ≠ τ ∧ z = v(σ)) })

def updateAt (v τ y : Set) : Set := { (σ, updateValue(v, τ, y, σ)) | σ ∈ domain(v) }

predicate BoundedMultilinear (Φ X norm ℓ : Set) :=
  FunctionBetween(ℓ, functionSpace(Φ, Module.carrier(X)), complexCarrier) ∧
  (∀ τ ∈ Φ, ∀ v ∈ functionSpace(Φ, Module.carrier(X)), ∀ y ∈ Module.carrier(X),
    ∀ c ∈ complexCarrier,
      ℓ(updateAt(v, τ, Module.add(X)(v(τ), Module.smul(X)(c, y)))) =
        ℂ[ℓ(v) + c * ℓ(updateAt(v, τ, y))]) ∧
  ∃ C ∈ ℝ, ∀ v ∈ functionSpace(Φ, Module.carrier(X)),
    complexAbs(ℓ(v)) ≤ R[C * realProduct(Φ, familyNorms(Φ, norm, v))]

def coeffValues (Φ c x h : Set) : Set := { (τ, c(τ)(h(τ))(x(τ))) | τ ∈ Φ }

def coeffFamilyFn (ι ε Φ ℓ c x : Set) : Set :=
  { (h, ℓ(coeffValues(Φ, c, x, h))) | h ∈ functionSpace(Φ, signUnitaryMatrices(ι, ε)) }

def coeffOrbit (ι ε c y : Set) : Set := { (g, c(g)(y)) | g ∈ signUnitaryMatrices(ι, ε) }

theorem IsKHighest.hol_coeffMap (ι ε ε2 o Φ u M ρ x c X norm ℓ : Set)
  requires finite : Finite(ι)
  requires finiteΦ : Finite(Φ)
  requires signs : SignsOn(ι, ε)
  requires signs2 : SignsOn(ι, ε2)
  requires injective : ∀ i ∈ ι, ∀ j ∈ ι, o(i) = o(j) → i = j
  requires space : BanachSpace(X, complexRing, complexAbs, norm)
  requires glm : ∀ τ ∈ Φ, IsGlModule(ι, M(τ), ρ(τ))
  requires highest : ∀ τ ∈ Φ, IsKHighest(ι, ε2, intVecNeg(ι, o), M(τ), ρ(τ), u(τ), x(τ))
  requires linear : ∀ τ ∈ Φ, ∀ g ∈ signUnitaryMatrices(ι, ε), LinearMap(c(τ)(g), M(τ), complexRing, X)
  requires coeff : ∀ τ ∈ Φ, IsCoeffMap(ι, signMatrix(complexRing, ι, ε), M(τ), ρ(τ), X, norm, c(τ))
  requires continuous : ∀ τ ∈ Φ, ∀ y ∈ Module.carrier(M(τ)),
    coeffOrbit(ι, ε, c(τ), y) : signUnitarySpace(ι, ε) ⇒ spaceTopology(X, norm)
  requires form : BoundedMultilinear(Φ, X, norm, ℓ)
  shows IsHolOfWeight(ι, ε, o, Φ, u, coeffFamilyFn(ι, ε, Φ, ℓ, c, x), ε2)
proof
  sorry

-- Section: Circle means
-- s^o for s on the unit circle, the family diag(s^o)g, and the integrand
-- F(diag(s^o)g) ∏ (s^{o_i})^{−u_τ,i} q(s) at s = e^{2πiθ}.
def circlePoint (θ : Set) : Set := complexExp(ℂ[complexOfReal(R[2 * realPi * θ]) * unitI])

def circlePowers (ι o s : Set) : Set := { (i, complexZpow(s, o(i))) | i ∈ ι }

def torusFamily (ι o s g : Set) : Set :=
  { (τ, matMul(complexRing, ι, ι, ι, diagTorus(ι, circlePowers(ι, o, s)), g(τ))) | τ ∈ domain(g) }

def circleWeightTerms (ι Φ o u s : Set) : Set :=
  { (p, complexZpow(complexZpow(s, o(snd(p))), u(fst(p))(snd(p)))) | p ∈ Φ × ι }

def circleMeanIntegrand (ι Φ o u F g q : Set) : Set :=
  { (θ, ℂ[F(torusFamily(ι, o, circlePoint(θ), g)) *
      (complexInv(complexFiniteProduct(Φ × ι, circleWeightTerms(ι, Φ, o, u, circlePoint(θ)))) *
        q(circlePoint(θ)))]) | θ ∈ ℝ }

def identityFamily (ι Φ : Set) : Set := Φ × {matOne(complexRing, ι)}

def minorsAt (ι u g : Set) : Set := { (τ, weightMinors(ι, u(τ), g(τ))) | τ ∈ domain(u) }

-- HolomorphicExtension.lean, IsHolOfWeight.circle_mean_weightMinors: for ε′
-- = 1 or ε, o injective, u dominant, g_τ block diagonal for ε′ and q
-- analytic on the closed disc, the mean is q(0) ∏_τ m_{u_τ}(g_τ) F(1).
theorem IsHolOfWeight.circle_mean_weightMinors (ι ε ε2 o Φ u F g q : Set)
  requires finite : Finite(ι)
  requires finiteΦ : Finite(Φ)
  requires signs : SignsOn(ι, ε)
  requires choice : ε2 = onesSigns(ι) ∨ ε2 = ε
  requires injective : ∀ i ∈ ι, ∀ j ∈ ι, o(i) = o(j) → i = j
  requires hol : IsHolOfWeight(ι, ε, o, Φ, u, F, ε2)
  requires dominant : ∀ τ ∈ Φ, IsKDominant(ι, ε2, o, u(τ))
  requires hg : g ∈ functionSpace(Φ, signUnitaryMatrices(ι, ε))
  requires block : ∀ τ ∈ Φ, g(τ) ∈ blockDiagAlg(ι, ε2)
  requires analytic : ∀ s ∈ complexCarrier, complexAbs(s) ≤ realOne → ComplexAnalyticAt(q, s)
  shows complexIntervalIntegral(circleMeanIntegrand(ι, Φ, o, u, F, g, q), realZero, realOne) =
    ℂ[q(complexZero) * complexFiniteProduct(Φ, minorsAt(ι, u, g)) * F(identityFamily(ι, Φ))]
proof
  sorry

-- HolomorphicExtension.lean, IsHolOfWeight.integral_mul_conj_weightMinors:
-- for F on U(diag ε) holomorphic of weight w for ε, continuous,
-- ∫_K F(k) conj m_w(k) dk = c_w F(1).
def singletonIndex : Set := {∅}

def kFamily (k : Set) : Set := singletonIndex × {k}

def kReproduceIntegrand (ι ε F w : Set) : Set :=
  { (k, ℂ[F(kFamily(k)) * complexConj(weightMinors(ι, w, k))]) | k ∈ maxCompactU(ι, ε) }

def constWeight (w : Set) : Set := singletonIndex × {w}

theorem IsHolOfWeight.integral_mul_conj_weightMinors (ι ε o w F : Set)
  requires finite : Finite(ι)
  requires signs : SignsOn(ι, ε)
  requires injective : ∀ i ∈ ι, ∀ j ∈ ι, o(i) = o(j) → i = j
  requires dominant : IsKDominant(ι, ε, o, w)
  requires hol : IsHolOfWeight(ι, ε, o, singletonIndex, constWeight(w), F, ε)
  requires continuous : F : familySpace(ι, ε, singletonIndex) ⇒ complexSpace
  shows complexMeasureIntegral(maxCompactBorel(ι, ε), haarK(ι, ε), kReproduceIntegrand(ι, ε, F, w)) =
    ℂ[complexOfReal(kTypeNormSq(ι, ε, w)) * F(identityFamily(ι, singletonIndex))]
proof
  sorry

-- Section: The holomorphic discrete series
-- STAND-IN for Mathlib's Measure.pi: the product measure on Φ → X.
def csDSBoxTerms (μ S : Set) : Set := { (τ, μ(S(τ))) | τ ∈ domain(S) }

def csDSPiMeasure (Φ X μ : Set) : Set :=
  ⋃({ m ∈ 𝒫(MeasurableSpace.sets(piMeasurableSpace(Φ, X)) × ennreal) |
    Measure(piMeasurableSpace(Φ, X), m) ∧
    ∀ S ∈ functionSpace(Φ, MeasurableSpace.sets(X)), (∀ τ ∈ Φ, μ(S(τ)) ≠ ennTop) →
      m(piSet(Φ, MeasurableSpace.carrier(X), S)) = realProduct(Φ, csDSBoxTerms(μ, S)) })

def familyBorel (ι ε Φ : Set) : Set := piMeasurableSpace(Φ, signBorel(ι, ε))

def familyHaar (ι ε Φ : Set) : Set := csDSPiMeasure(Φ, signBorel(ι, ε), signHaar(ι, ε))

-- HolomorphicMinor.lean, holMinorsPi_one.
theorem holMinorsPi.one (ι ε Φ u : Set)
  requires finite : Finite(ι)
  requires finiteΦ : Finite(Φ)
  requires signs : SignsOn(ι, ε)
  requires hu : ∀ τ ∈ Φ, (u(τ) : ι → ℤ)
  shows holMinorsPi(ι, ε, Φ, u, identityFamily(ι, Φ)) = complexOne
proof
  sorry

def holMinorsPiFn (ι ε Φ u : Set) : Set :=
  { (h, holMinorsPi(ι, ε, Φ, u, h)) | h ∈ functionSpace(Φ, signUnitaryMatrices(ι, ε)) }

-- HolomorphicMinor.lean, isHolOfWeight_holMinorsPi: for o injective with
-- the signs +1 first and every u_τ dominant, m^hol_u is holomorphic of
-- weight u.
theorem holMinorsPi.hol (ι ε o Φ u : Set)
  requires finite : Finite(ι)
  requires finiteΦ : Finite(Φ)
  requires signs : SignsOn(ι, ε)
  requires order : IsPosFirstOrder(ι, ε, o)
  requires dominant : ∀ τ ∈ Φ, IsKDominant(ι, ε, o, u(τ))
  shows IsHolOfWeight(ι, ε, o, Φ, u, holMinorsPiFn(ι, ε, Φ, u), onesSigns(ι))
proof
  sorry

-- HolomorphicMinor.lean, IsHolOfWeight.circle_mean_holMinorsPi: the mean of
-- F(diag(s^o)h) ∏ s^{−o_i u_τ,i} is m^hol_u(h) F(1).
def constOne : Set := { (s, complexOne) | s ∈ complexCarrier }

def circleMeanHolIntegrand (ι Φ o u F h : Set) : Set := circleMeanIntegrand(ι, Φ, o, u, F, h, constOne)

theorem IsHolOfWeight.circle_mean_holMinorsPi (ι ε o Φ u F h : Set)
  requires finite : Finite(ι)
  requires finiteΦ : Finite(Φ)
  requires signs : SignsOn(ι, ε)
  requires order : IsPosFirstOrder(ι, ε, o)
  requires dominant : ∀ τ ∈ Φ, IsKDominant(ι, ε, o, u(τ))
  requires hol : IsHolOfWeight(ι, ε, o, Φ, u, F, onesSigns(ι))
  requires hh : h ∈ functionSpace(Φ, signUnitaryMatrices(ι, ε))
  shows complexIntervalIntegral(circleMeanHolIntegrand(ι, Φ, o, u, F, h), realZero, realOne) =
    ℂ[holMinorsPi(ι, ε, Φ, u, h) * F(identityFamily(ι, Φ))]
proof
  sorry

-- HolomorphicMinor.lean, IsHolOfWeight.integral_mul_conj_holMinorsPi
-- (reproducing formula): ∫ F m̄ = (∫ |m|²) F(1), m = m^hol_u, when F m̄ is
-- integrable on U(diag ε)^Φ.
def holReproduceIntegrand (ι ε Φ u F : Set) : Set :=
  { (h, ℂ[F(h) * complexConj(holMinorsPi(ι, ε, Φ, u, h))]) |
    h ∈ functionSpace(Φ, signUnitaryMatrices(ι, ε)) }

def holMinorsNormSq (ι ε Φ u : Set) : Set :=
  { (h, R[complexAbs(holMinorsPi(ι, ε, Φ, u, h)) ^ 2]) |
    h ∈ functionSpace(Φ, signUnitaryMatrices(ι, ε)) }

theorem IsHolOfWeight.reproducing (ι ε o Φ u F : Set)
  requires finite : Finite(ι)
  requires finiteΦ : Finite(Φ)
  requires signs : SignsOn(ι, ε)
  requires order : IsPosFirstOrder(ι, ε, o)
  requires dominant : ∀ τ ∈ Φ, IsKDominant(ι, ε, o, u(τ))
  requires hol : IsHolOfWeight(ι, ε, o, Φ, u, F, onesSigns(ι))
  requires integrable : ComplexIntegrable(familyBorel(ι, ε, Φ), familyHaar(ι, ε, Φ),
    holReproduceIntegrand(ι, ε, Φ, u, F))
  shows complexMeasureIntegral(familyBorel(ι, ε, Φ), familyHaar(ι, ε, Φ),
      holReproduceIntegrand(ι, ε, Φ, u, F)) =
    ℂ[complexOfReal(realMeasureIntegral(familyBorel(ι, ε, Φ), familyHaar(ι, ε, Φ),
      holMinorsNormSq(ι, ε, Φ, u))) * F(identityFamily(ι, Φ))]
proof
  sorry

-- HolomorphicMinor.lean, IsHolOfWeight.eq_holMinorsPi_mul: if moreover
-- F(g⁻¹) = conj F(g), then F = F(1) m^hol_u.
def familyInverse (ι g : Set) : Set := { (τ, matInverse(complexRing, ι, g(τ))) | τ ∈ domain(g) }

theorem IsHolOfWeight.eq_holMinorsPi_mul (ι ε o Φ u F h : Set)
  requires finite : Finite(ι)
  requires finiteΦ : Finite(Φ)
  requires signs : SignsOn(ι, ε)
  requires order : IsPosFirstOrder(ι, ε, o)
  requires dominant : ∀ τ ∈ Φ, IsKDominant(ι, ε, o, u(τ))
  requires hol : IsHolOfWeight(ι, ε, o, Φ, u, F, onesSigns(ι))
  requires hermitian : ∀ g ∈ functionSpace(Φ, signUnitaryMatrices(ι, ε)),
    F(familyInverse(ι, g)) = complexConj(F(g))
  requires hh : h ∈ functionSpace(Φ, signUnitaryMatrices(ι, ε))
  shows F(h) = ℂ[holMinorsPi(ι, ε, Φ, u, h) * F(identityFamily(ι, Φ))]
proof
  sorry

-- HolomorphicChamber.lean, dsCoeff_eq_holMinors (holomorphic discrete
-- series): for o with the signs +1 first, w dominant with w_i + γ ≤ w_j
-- for ε_i = 1, ε_j = −1 and γ > 500n³ + A + n + 1, the parameter
-- l = 2w + 2ρ(−o) has gap 500n³ + A and ψ_λ = m^hol_w on U(diag ε).
def holParam (ι o w : Set) : Set :=
  { (i, integerAddValue(integerAddValue(w(i), w(i)), twoRho(ι, intVecNeg(ι, o), allPairs(ι), i))) |
    i ∈ ι }

theorem dsCoeff.eq_holMinors (ι ε o w : Set, A γ : Nat)
  requires finite : Finite(ι)
  requires nonempty : ι ≠ ∅
  requires signs : SignsOn(ι, ε)
  requires order : IsPosFirstOrder(ι, ε, o)
  requires hw : (w : ι → ℤ)
  requires dominant : IsKDominant(ι, ε, o, w)
  requires holGap : HasHolGap(ι, ε, w, γ)
  requires large : R[500 * realNat(cardinality(ι)) ^ 3 + realNat(A) + realNat(cardinality(ι)) + 1] <
    realNat(γ)
  shows HasLargeGap(ι, ε, holParam(ι, o, w), A) ∧
    ∀ g ∈ signUnitaryMatrices(ι, ε), dsCoeff(ι, ε, holParam(ι, o, w), g) = holMinors(ι, ε, w, g)
proof
  sorry

end DiscreteSeriesHolomorphic
