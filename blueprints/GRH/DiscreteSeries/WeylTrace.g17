-- Weyl's character formula for the rational representations S_κ ⊗ det^e of
-- products of general linear groups: if g_v ∈ GL_a(ℂ) has distinct
-- eigenvalues x_{v,0}, …, x_{v,a−1}, then tr(weylRep κ e g) times the
-- product of the Vandermonde determinants det(x_{v,i}^j) is the product of
-- the alternants det(x_{v,i}^{e_v + λ_{v,a−1−j} + j}), λ the weight of κ.
-- Source: grh-compact/src/Lib/DiscreteSeries/Character/WeylTrace.lean
-- (det_zpow_add, trace_weylRep). Known result: "Weyl character and
-- dimension formulas for U(n) and products of unitary groups."
-- Encoding. As in GRH.GLn.WeightRep: weylRep at the natural number a, the
-- family g on the finite set ι of invertible a × a matrices, κ the diagram
-- data and e : ι → ℤ; λ_{v,k} is diagramWeight(ι, a, κ)(v, k). The
-- eigenvalues are roots of matCharpoly, and the source's embedding
-- x_v : Fin a ↪ ℂ is an injective function on a.
-- Part of the GRH blueprint (layer 4, Lib/DiscreteSeries, stage S2).
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.DiscreteSeries.WeylTrace
import GRH.DiscreteSeries.Representation
import GRH.GLn.WeightRep

section DiscreteSeriesWeylTrace
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)

-- The Vandermonde matrix (x_i^j) and the alternant matrix
-- (x_i^{e + λ_{a−1−j} + j}) at the natural number a.
def vandermondeOf (a x : Set) : Set := { (q, ℂ[x(fst(q)) ^ snd(q)]) | q ∈ a × a }

def weylExponent (a κ e v j : Set) : Set :=
  integerAddValue(integerAddValue(e(v),
    integerOfNat(diagramWeight(domain(e), a, κ)((v, sub(predecessor(a), j))))), integerOfNat(j))

def weylAlternant (a κ e v x : Set) : Set :=
  { (q, complexZpow(x(fst(q)), weylExponent(a, κ, e, v, snd(q)))) | q ∈ a × a }

def vandermondeTerms (ι a x : Set) : Set := { (v, matDet(complexRing, a, vandermondeOf(a, x(v)))) | v ∈ ι }

def weylAlternantTerms (ι a κ e x : Set) : Set :=
  { (v, matDet(complexRing, a, weylAlternant(a, κ, e, v, x(v)))) | v ∈ ι }

-- WeylTrace.lean, trace_weylRep (Weyl's character formula).
theorem weylRep.trace (ι κ e g x : Set, a : Nat)
  requires finite : Finite(ι)
  requires he : (e : ι → ℤ)
  requires hg : g ∈ functionSpace(ι, invertibleMatrices(complexRing, a))
  requires hx : ∀ v ∈ ι, (x(v) : a → complexCarrier)
  requires distinct : ∀ v ∈ ι, ∀ i ∈ a, ∀ j ∈ a, x(v)(i) = x(v)(j) → i = j
  requires roots : ∀ v ∈ ι, ∀ i ∈ a,
    polyEval(complexRing, matCharpoly(complexRing, a, g(v)), x(v)(i)) = complexZero
  shows ℂ[matTrace(complexRing, weylIndexSet(ι, a, κ), weylRep(complexRing, ι, a, κ, e, g)) *
      complexFiniteProduct(ι, vandermondeTerms(ι, a, x))] =
    complexFiniteProduct(ι, weylAlternantTerms(ι, a, κ, e, x))
proof
  sorry

end DiscreteSeriesWeylTrace
