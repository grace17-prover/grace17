-- The theta correspondence of discrete series for real unitary dual pairs
-- (U(p, q), U(p′, q′)) in the Fock model: the oscillator actions of gl(R)
-- and gl(C) on polynomials in the variables X_rc, matched parameters,
-- harmonic and joint harmonic polynomials, Fischer's decomposition, the
-- existence and uniqueness of joint harmonics, Howe's counting argument,
-- and the local correspondence: π′(f) fixes π(e_λ)Φ, and π(e_λ)P lies in
-- the span of π′(α)π(e_λ)Φ.
-- Source: grh-compact/src/Lib/DiscreteSeries/Theta/OscillatorDefs.lean
-- (canonical_commutation, pairSign, FockDualPair, FockDualPair.std,
-- FockDualPair.swap, swap_swap, varSign, η, vacuumWeight, relWeight,
-- centredParam, oscRows, fockLaplacian, polarisation, IsMatchedPair,
-- IsHarmonic, IsRowHarmonic, IsPreJointHarmonic, IsJointHighest,
-- swap_oscRows_E, IsMatch, IsJointHarmonic),
-- Theta/FischerDecomposition.lean (IsMatch.swap, IsJointHarmonic.swap,
-- oscRows_E_eq_polarisation_sub, inner_X_mul, polyDegreeLE,
-- perpInDegree, fockLaplacian_eq_zero_of_isKHighest),
-- Theta/JointHarmonicUnique.lean (polarisation_eq_of_isCompactPrimitive,
-- IsJointHighest.isPreJointHarmonic, IsMatch.hasLargeGap,
-- IsMatch.lowestKType_sub_vacuumWeight_eq_neg, IsMatch.unique),
-- Theta/JointHarmonicExists.lean (IsMatch.exists_isJointHarmonic),
-- Theta/HoweArgument.lean (IsJointHarmonic.howe_argument),
-- Theta/LocalThetaCorrespondence.lean (swap, re_inner_integratedRep_pos,
-- isDerivedAction_integratedRep, integratedRep_fix,
-- exists_bump_integratedRep_eq). Known result: "Theta correspondence of
-- discrete series for real unitary dual pairs; joint harmonics."
-- Not stated: the layering construction of JointHarmonicExists.lean
-- (derivation_prod_det, IsLayering and its laws), the lemmas of
-- FischerDecomposition.lean on degrees (glOp_mem_polyDegreeLE,
-- eq_zero_of_mem_perpInDegree, fockLaplacian_eq_zero, mapsTo_perpInDegree)
-- and of JointHarmonicUnique.lean on sums (sum_cols_le_sum_rows,
-- sign_mul_lowestKType_sub_nonneg).
-- STAND-IN: csDSOscillatorRep, csDSOscillatorPair for OscillatorRep and
-- OscillatorPair of Lib/Weil/Fock/OscillatorPair.lean (not yet stated in
-- GRH.Weil.Fock): a unitarisable representation of U(ε) on the Fock space
-- of exponent |I|, derived along P ↦ v_P by the oscillator action, with
-- ⟨v_P, π(z)v_P⟩ > 0 for z positive definite and P ≠ 0 harmonic; a pair
-- of commuting ones for the rows and the columns. The real ones are
-- stated with the Fock model of GRH.Weil.Fock (detTwist, pairHom,
-- oscillatorPair_detTwist).
-- Encoding. The rows form a finite set Rw (the source's R) and the columns
-- a finite set C; the variables form a finite set I with a bijection
-- e : Rw × C → I; a FockDualPair is the tuple (σ, γ, γ′, e) with σ = ±1 and
-- γ, γ′ ∈ ℤ. Polynomials are cPolys(I) with the module of the polynomial
-- algebra; the Fischer product ⟨P, Q⟩ = Σ_m conj(P_m) Q_m m! (fischerTerms
-- of GRH.Weil.Fock). A gl(R)-module on polynomials is given by ρ as in
-- GRH.DiscreteSeries.Representation. Signs on R, C, I are complex ±1.
-- Part of the GRH blueprint (layer 4, Lib/DiscreteSeries, stage S2).
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.DiscreteSeries.Theta
import GRH.DiscreteSeries.KernelFixes

section DiscreteSeriesTheta
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- Section: Polynomials
-- The polynomial ring, its module, sums, scalars and products.
def polyRing (I : Set) : Set := polynomialRing(complexRing, I)

def polyModule (I : Set) : Set := algebraModule(polynomialAlgebra(complexRing, I))

def polyMul (I P Q : Set) : Set := call2(Ring.mul(polyRing(I)), P, Q)

def polyScale (I c P : Set) : Set := polyMul(I, polynomialConstant(complexRing, I)(c), P)

def polySum (I F w : Set) : Set := groupFiniteSum(Ring.additive(polyRing(I)), F, w)

def polyAdd (I P Q : Set) : Set := call2(Ring.add(polyRing(I)), P, Q)

def pDeriv (I a P : Set) : Set := partialDerivative(complexRing, I, a)(P)

-- OscillatorDefs.lean, canonical_commutation: A_a, A_b commute, B_a, B_b
-- commute, and B_a A_b = A_b B_a + δ_ab.
theorem canonical_commutation (I η a b P : Set)
  requires finite : Finite(I)
  requires signs : SignsOn(I, η)
  requires ha : a ∈ I
  requires hb : b ∈ I
  requires hP : P ∈ cPolys(I)
  shows raiseOp(I, η, a)(raiseOp(I, η, b)(P)) = raiseOp(I, η, b)(raiseOp(I, η, a)(P)) ∧
    lowerOp(I, η, a)(lowerOp(I, η, b)(P)) = lowerOp(I, η, b)(lowerOp(I, η, a)(P)) ∧
    (a = b → lowerOp(I, η, a)(raiseOp(I, η, b)(P)) =
      polyAdd(I, raiseOp(I, η, b)(lowerOp(I, η, a)(P)), P)) ∧
    (a ≠ b → lowerOp(I, η, a)(raiseOp(I, η, b)(P)) = raiseOp(I, η, b)(lowerOp(I, η, a)(P)))
proof
  sorry

-- Section: Dual pair data
-- OscillatorDefs.lean, FockDualPair: (σ, γ, γ′, e).
def fockDualPair (σ γ γ2 e : Set) : Set := (σ, (γ, (γ2, e)))

def dpSigma (T : Set) : Set := fst(T)

def dpGamma (T : Set) : Set := fst(snd(T))

def dpGamma2 (T : Set) : Set := fst(snd(snd(T)))

def dpVar (T : Set) : Set := snd(snd(snd(T)))

predicate IsFockDualPair (Rw C I T : Set) :=
  (dpSigma(T) = complexOne ∨ dpSigma(T) = ℂ[-1]) ∧ dpGamma(T) ∈ ℤ ∧ dpGamma2(T) ∈ ℤ ∧
  BijectiveBetween(dpVar(T), Rw × C, I)

-- OscillatorDefs.lean, FockDualPair.std γ γ′: σ = 1, γ, γ′ + |R|, I = R × C.
def dpStd (Rw C γ γ2 : Set) : Set :=
  fockDualPair(complexOne, γ, integerAddValue(γ2, integerOfNat(cardinality(Rw))), identity(Rw × C))

-- OscillatorDefs.lean, FockDualPair.swap: (−σ, γ′, γ, e ∘ swap).
def pairSwapVar (Rw C e : Set) : Set := { (p, e((snd(p), fst(p)))) | p ∈ C × Rw }

def dpSwap (Rw C T : Set) : Set :=
  fockDualPair(ℂ[-dpSigma(T)], dpGamma2(T), dpGamma(T), pairSwapVar(Rw, C, dpVar(T)))

-- OscillatorDefs.lean, swap_swap.
theorem dpSwap.swap (Rw C I T : Set)
  requires pair : IsFockDualPair(Rw, C, I, T)
  shows dpSwap(C, Rw, dpSwap(Rw, C, T)) = T
proof
  sorry

-- OscillatorDefs.lean, pairSign / varSign: σ ε_r ε′_c; η on I.
def varSign (T ε ε2 p : Set) : Set := ℂ[dpSigma(T) * ε(fst(p)) * ε2(snd(p))]

def dpEta (Rw C I T ε ε2 : Set) : Set :=
  { (i, varSign(T, ε, ε2, converse(dpVar(T), Rw × C, I)(i))) | i ∈ I }

-- OscillatorDefs.lean, vacuumWeight s = γ − #{c : σ s ε′_c ≠ 1}.
def unmatchedColumns (C T ε2 s : Set) : Set := { c ∈ C | ℂ[dpSigma(T) * s * ε2(c)] ≠ complexOne }

def vacuumWeight (C T ε2 s : Set) : Set :=
  integerSubValue(dpGamma(T), integerOfNat(cardinality(unmatchedColumns(C, T, ε2, s))))

-- OscillatorDefs.lean, relWeight r = Λ_r − vacuumWeight(ε_r).
def relWeight (Rw C T ε ε2 l r : Set) : Set :=
  integerSubValue(lowestKType(Rw, ε, l)(r), vacuumWeight(C, T, ε2, ε(r)))

-- OscillatorDefs.lean, centredParam r = l_r − 2γ + |C|.
def centredParam (C T l r : Set) : Set :=
  integerAddValue(integerSubValue(l(r), integerAddValue(dpGamma(T), dpGamma(T))),
    integerOfNat(cardinality(C)))

-- Section: The oscillator action
-- OscillatorDefs.lean, oscRows: E_ab ↦ s Σ_c A_(a,c) B_(b,c) + γ δ_ab, with
-- s = 1 if ε_a = ε_b and σ otherwise.
def oscScalar (T ε a b : Set) : Set :=
  ⋃({ s ∈ complexCarrier | (ε(a) = ε(b) ∧ s = complexOne) ∨ (ε(a) ≠ ε(b) ∧ s = dpSigma(T)) })

def oscColumnTerms (Rw C I T ε ε2 a b P : Set) : Set :=
  { (c, glOp(I, dpEta(Rw, C, I, T, ε, ε2), dpVar(T)((a, c)), dpVar(T)((b, c)), P)) | c ∈ C }

def kroneckerC (a b : Set) : Set :=
  ⋃({ s ∈ complexCarrier | (a = b ∧ s = complexOne) ∨ (a ≠ b ∧ s = complexZero) })

def oscEValue (Rw C I T ε ε2 a b P : Set) : Set :=
  polyAdd(I, polyScale(I, oscScalar(T, ε, a, b), polySum(I, C, oscColumnTerms(Rw, C, I, T, ε, ε2, a, b, P))),
    polyScale(I, ℂ[kroneckerC(a, b) * intToComplex(dpGamma(T))], P))

def oscMatrixTerms (Rw C I T ε ε2 Xm P : Set) : Set :=
  { (q, polyScale(I, Xm(q), oscEValue(Rw, C, I, T, ε, ε2, fst(q), snd(q), P))) | q ∈ Rw × Rw }

def oscRowsOn (Rw C I T ε ε2 Xm : Set) : Set :=
  { (P, polySum(I, Rw × Rw, oscMatrixTerms(Rw, C, I, T, ε, ε2, Xm, P))) | P ∈ cPolys(I) }

def oscRows (Rw C I T ε ε2 : Set) : Set :=
  { (Xm, oscRowsOn(Rw, C, I, T, ε, ε2, Xm)) | Xm ∈ cMatrices(Rw) }

-- The column action: oscRows of the swapped data.
def oscCols (Rw C I T ε ε2 : Set) : Set := oscRows(C, Rw, I, dpSwap(Rw, C, T), ε2, ε)

theorem oscRows.gl_module (Rw C I T ε ε2 : Set)
  requires finiteR : Finite(Rw)
  requires finiteC : Finite(C)
  requires signs : SignsOn(Rw, ε)
  requires signs2 : SignsOn(C, ε2)
  requires pair : IsFockDualPair(Rw, C, I, T)
  shows IsGlModule(Rw, polyModule(I), oscRows(Rw, C, I, T, ε, ε2)) ∧
    ∀ a ∈ Rw, ∀ b ∈ Rw, ∀ P ∈ cPolys(I),
      glE(Rw, oscRows(Rw, C, I, T, ε, ε2), a, b)(P) = oscEValue(Rw, C, I, T, ε, ε2, a, b, P)
proof
  sorry

-- OscillatorDefs.lean, swap_oscRows_E: in the column action E_ab acts by
-- −s Σ_r B_(r,a) A_(r,b) + γ′ δ_ab, s = 1 if ε′_a = ε′_b and σ otherwise.
def oscColumnRowTerms (Rw C I T ε ε2 a b P : Set) : Set :=
  { (r, lowerOp(I, dpEta(Rw, C, I, T, ε, ε2), dpVar(T)((r, a)))(
      raiseOp(I, dpEta(Rw, C, I, T, ε, ε2), dpVar(T)((r, b)))(P))) | r ∈ Rw }

theorem oscCols.E (Rw C I T ε ε2 a b P : Set)
  requires finiteR : Finite(Rw)
  requires finiteC : Finite(C)
  requires signs : SignsOn(Rw, ε)
  requires signs2 : SignsOn(C, ε2)
  requires pair : IsFockDualPair(Rw, C, I, T)
  requires ha : a ∈ C
  requires hb : b ∈ C
  requires hP : P ∈ cPolys(I)
  shows glE(C, oscCols(Rw, C, I, T, ε, ε2), a, b)(P) =
    polyAdd(I, polyScale(I, ℂ[-oscScalar(T, ε2, a, b)],
        polySum(I, Rw, oscColumnRowTerms(Rw, C, I, T, ε, ε2, a, b, P))),
      polyScale(I, ℂ[kroneckerC(a, b) * intToComplex(dpGamma2(T))], P))
proof
  sorry

-- OscillatorDefs.lean, fockLaplacian a b: Σ A_(a,c) B_(b,c) over the c with
-- X_ac of sign −1.
def negColumns (C T ε ε2 a : Set) : Set := { c ∈ C | varSign(T, ε, ε2, (a, c)) = ℂ[-1] }

def fockLaplacian (Rw C I T ε ε2 a b P : Set) : Set :=
  polySum(I, negColumns(C, T, ε, ε2, a), oscColumnTerms(Rw, C, I, T, ε, ε2, a, b, P))

-- OscillatorDefs.lean, polarisation P a b s: Σ X_ac ∂P/∂X_bc over the c with
-- X_bc of sign s.
def signColumns (C T ε ε2 b s : Set) : Set := { c ∈ C | varSign(T, ε, ε2, (b, c)) = s }

def polarisationTerms (C I T P a b : Set) : Set :=
  { (c, polyMul(I, X(complexRing, I, dpVar(T)((a, c))), pDeriv(I, dpVar(T)((b, c)), P))) | c ∈ C }

def polarisation (C I T ε ε2 P a b s : Set) : Set :=
  polySum(I, signColumns(C, T, ε, ε2, b, s), polarisationTerms(C, I, T, P, a, b))

-- FischerDecomposition.lean, oscRows_E_eq_polarisation_sub: for ε_a = ε_b,
-- E_ab P = pol(P, a, b, +1) − pol(P, b, a, −1) + δ_ab vacuumWeight(ε_a) P.
theorem oscRows.E_polarisation (Rw C I T ε ε2 a b P : Set)
  requires finiteR : Finite(Rw)
  requires finiteC : Finite(C)
  requires signs : SignsOn(Rw, ε)
  requires signs2 : SignsOn(C, ε2)
  requires pair : IsFockDualPair(Rw, C, I, T)
  requires ha : a ∈ Rw
  requires hb : b ∈ Rw
  requires same : ε(a) = ε(b)
  requires hP : P ∈ cPolys(I)
  shows glE(Rw, oscRows(Rw, C, I, T, ε, ε2), a, b)(P) =
    polyAdd(I, polyAdd(I, polarisation(C, I, T, ε, ε2, P, a, b, complexOne),
        polyScale(I, ℂ[-1], polarisation(C, I, T, ε, ε2, P, b, a, ℂ[-1]))),
      polyScale(I, ℂ[kroneckerC(a, b) * intToComplex(vacuumWeight(C, T, ε2, ε(a)))], P))
proof
  sorry

-- Section: Matching and harmonics
-- OscillatorDefs.lean, IsMatchedPair r c: ξ_r = −ξ′_c and
-- |(|R| − |C|)| < σ ε_r ε′_c ξ_r, with ξ = centredParam.
predicate IsMatchedPair (Rw C T ε ε2 l l2 r c : Set) :=
  centredParam(C, T, l, r) = integerNegValue(centredParam(Rw, dpSwap(Rw, C, T), l2, c)) ∧
  realAbs(R[realNat(cardinality(Rw)) - realNat(cardinality(C))]) <
    complexRe(ℂ[varSign(T, ε, ε2, (r, c)) * intToComplex(centredParam(C, T, l, r))])

-- OscillatorDefs.lean, IsHarmonic: ∂_ac ∂_bc Φ = 0 whenever ε_a ≠ ε_b.
predicate IsHarmonic (Rw C I T ε Φ : Set) :=
  ∀ a ∈ Rw, ∀ b ∈ Rw, ∀ c ∈ C, ε(a) ≠ ε(b) →
    pDeriv(I, dpVar(T)((a, c)), pDeriv(I, dpVar(T)((b, c)), Φ)) = Ring.zero(polyRing(I))

-- OscillatorDefs.lean, IsRowHarmonic: the Laplacians vanish on Φ.
predicate IsRowHarmonic (Rw C I T ε ε2 Φ : Set) :=
  ∀ a ∈ Rw, ∀ b ∈ Rw, ε(a) ≠ ε(b) → fockLaplacian(Rw, C, I, T, ε, ε2, a, b, Φ) = Ring.zero(polyRing(I))

-- OscillatorDefs.lean, IsPreJointHarmonic.
predicate IsPreJointHarmonic (Rw C I T ε ε2 l l2 Φ : Set) :=
  Φ ≠ Ring.zero(polyRing(I)) ∧
  IsCompactPrimitive(C, ε2, l2, polyModule(I), oscCols(Rw, C, I, T, ε, ε2), Φ) ∧
  IsRowHarmonic(Rw, C, I, T, ε, ε2, Φ) ∧
  IsKHighest(Rw, ε, l, polyModule(I), oscRows(Rw, C, I, T, ε, ε2), lowestKType(Rw, ε, l), Φ) ∧
  IsRowHarmonic(C, Rw, I, dpSwap(Rw, C, T), ε2, ε, Φ)

-- OscillatorDefs.lean, IsJointHighest ν ν′.
predicate IsJointHighest (Rw C I T ε ε2 l l2 Φ ν ν2 : Set) :=
  Φ ≠ Ring.zero(polyRing(I)) ∧
  IsKHighest(C, ε2, l2, polyModule(I), oscCols(Rw, C, I, T, ε, ε2), ν2, Φ) ∧
  IsHarmonic(Rw, C, I, T, ε, Φ) ∧
  IsKHighest(Rw, ε, l, polyModule(I), oscRows(Rw, C, I, T, ε, ε2), ν, Φ) ∧
  IsHarmonic(C, Rw, I, dpSwap(Rw, C, T), ε2, Φ)

-- OscillatorDefs.lean, IsMatch: gaps 500(n + n′)³, every row matched or
-- |ξ_r| < (n − n′)/2, and symmetrically for the columns.
def dualPairGap (Rw C : Set) : Set :=
  R[500 * (realNat(cardinality(Rw)) + realNat(cardinality(C))) ^ 3]

predicate IsMatch (Rw C I T ε ε2 l l2 : Set) :=
  HasGap(Rw, ε, l, dualPairGap(Rw, C)) ∧ HasGap(C, ε2, l2, dualPairGap(Rw, C)) ∧
  (∀ r ∈ Rw, (∃ c ∈ C, IsMatchedPair(Rw, C, T, ε, ε2, l, l2, r, c)) ∨
    realAbs(intReal(centredParam(C, T, l, r))) <
      R[realNat(cardinality(Rw)) - realNat(cardinality(C))]) ∧
  (∀ c ∈ C, (∃ r ∈ Rw, IsMatchedPair(Rw, C, T, ε, ε2, l, l2, r, c)) ∨
    realAbs(intReal(centredParam(Rw, dpSwap(Rw, C, T), l2, c))) <
      R[realNat(cardinality(C)) - realNat(cardinality(Rw))])

-- OscillatorDefs.lean, IsJointHarmonic: matched parameters and Φ jointly
-- highest of weights Λ, Λ′.
predicate IsJointHarmonic (Rw C I T ε ε2 l l2 Φ : Set) :=
  IsMatch(Rw, C, I, T, ε, ε2, l, l2) ∧
  IsJointHighest(Rw, C, I, T, ε, ε2, l, l2, Φ, lowestKType(Rw, ε, l), lowestKType(C, ε2, l2))

-- The standing hypotheses on a dual pair.
predicate DualPairSetting (Rw C I T ε ε2 : Set) :=
  Finite(Rw) ∧ Finite(C) ∧ Finite(I) ∧ SignsOn(Rw, ε) ∧ SignsOn(C, ε2) ∧ IsFockDualPair(Rw, C, I, T)

-- FischerDecomposition.lean, IsMatch.swap and IsJointHarmonic.swap.
theorem IsJointHarmonic.swap (Rw C I T ε ε2 l l2 Φ : Set)
  requires setting : DualPairSetting(Rw, C, I, T, ε, ε2)
  requires match : IsMatch(Rw, C, I, T, ε, ε2, l, l2)
  shows IsMatch(C, Rw, I, dpSwap(Rw, C, T), ε2, ε, l2, l) ∧
    (IsJointHarmonic(Rw, C, I, T, ε, ε2, l, l2, Φ) →
      IsJointHarmonic(C, Rw, I, dpSwap(Rw, C, T), ε2, ε, l2, l, Φ))
proof
  sorry

-- Section: The Fischer product and degrees
-- The Fischer product ⟨P, Q⟩ = Σ_m conj(P_m) Q_m m!.
def fischer (I P Q : Set) : Set :=
  groupFiniteSum(complexAdditiveGroup, mvSupport(complexRing, I, P), fischerTerms(I, P, Q))

-- FischerDecomposition.lean, inner_X_mul: ⟨X_b P, Q⟩ = ⟨P, ∂_b Q⟩.
theorem fischer.X_mul (I b P Q : Set)
  requires finite : Finite(I)
  requires hb : b ∈ I
  requires hP : P ∈ cPolys(I)
  requires hQ : Q ∈ cPolys(I)
  shows fischer(I, polyMul(I, X(complexRing, I, b), P), Q) = fischer(I, P, pDeriv(I, b, Q)) ∧
    fischer(I, P, polyMul(I, X(complexRing, I, b), Q)) = fischer(I, pDeriv(I, b, P), Q)
proof
  sorry

-- FischerDecomposition.lean, polyDegreeLE j: total degree at most j.
def dsMonomialDegreeTerms (I m : Set) : Set := { (i, realNat(m(i))) | i ∈ I }

def dsMonomialDegree (I m : Set) : Set := realFiniteSum(dsMonomialDegreeTerms(I, m), I)

def polyDegreeLE (I j : Set) : Set :=
  { P ∈ cPolys(I) | ∀ m ∈ mvSupport(complexRing, I, P), (dsMonomialDegree(I, m):R) ≤ (intReal(j):R) }

-- FischerDecomposition.lean, perpInDegree j G: degree ≤ j and orthogonal
-- to the elements of G of degree ≤ j.
def perpInDegree (I j G : Set) : Set :=
  { P ∈ polyDegreeLE(I, j) | ∀ Q ∈ polyDegreeLE(I, j) ∩ G, fischer(I, Q, P) = complexZero }

-- FischerDecomposition.lean, fockLaplacian_eq_zero_of_isKHighest: for P
-- K-highest of weight ν, if no nonzero Q_ab = fockLaplacian a b P with
-- ε_a ≠ ε_b is K-highest of weight ν − e_a + e_b, then P is row harmonic.
def intIndicator (i a : Set) : Set :=
  ⋃({ z ∈ ℤ | (i = a ∧ z = integerOne) ∨ (i ≠ a ∧ z = integerZero) })

def weightShift (Rw ν a b : Set) : Set :=
  { (i, integerSubValue(integerAddValue(ν(i), intIndicator(i, b)), intIndicator(i, a))) | i ∈ Rw }

theorem fockLaplacian.eq_zero_of_highest (Rw C I T ε ε2 l ν P : Set)
  requires setting : DualPairSetting(Rw, C, I, T, ε, ε2)
  requires hl : (l : Rw → ℤ)
  requires highest : IsKHighest(Rw, ε, l, polyModule(I), oscRows(Rw, C, I, T, ε, ε2), ν, P)
  requires none : ∀ a ∈ Rw, ∀ b ∈ Rw, ε(a) ≠ ε(b) →
    IsKHighest(Rw, ε, l, polyModule(I), oscRows(Rw, C, I, T, ε, ε2), weightShift(Rw, ν, a, b),
      fockLaplacian(Rw, C, I, T, ε, ε2, a, b, P)) →
    fockLaplacian(Rw, C, I, T, ε, ε2, a, b, P) = Ring.zero(polyRing(I))
  shows IsRowHarmonic(Rw, C, I, T, ε, ε2, P)
proof
  sorry

-- Section: Joint harmonics
-- JointHarmonicUnique.lean, IsJointHighest.isPreJointHarmonic.
theorem IsJointHighest.pre (Rw C I T ε ε2 l l2 Φ ν2 : Set)
  requires setting : DualPairSetting(Rw, C, I, T, ε, ε2)
  requires joint : IsJointHighest(Rw, C, I, T, ε, ε2, l, l2, Φ, lowestKType(Rw, ε, l), ν2)
  shows IsPreJointHarmonic(Rw, C, I, T, ε, ε2, l, l2, Φ)
proof
  sorry

-- JointHarmonicUnique.lean, IsMatch.hasLargeGap: gap 500n³ + A for A ≤ |I|.
theorem IsMatch.large_gap (Rw C I T ε ε2 l l2 : Set, A : Nat)
  requires setting : DualPairSetting(Rw, C, I, T, ε, ε2)
  requires match : IsMatch(Rw, C, I, T, ε, ε2, l, l2)
  requires hA : (A:N) ≤ (cardinality(I):N)
  shows HasLargeGap(Rw, ε, l, A)
proof
  sorry

-- JointHarmonicUnique.lean, IsMatch.lowestKType_sub_vacuumWeight_eq_neg:
-- matched r, c have Λ_r − v_r = −(Λ′_c − v′_c).
theorem IsMatch.relWeight_neg (Rw C I T ε ε2 l l2 r c : Set)
  requires setting : DualPairSetting(Rw, C, I, T, ε, ε2)
  requires match : IsMatch(Rw, C, I, T, ε, ε2, l, l2)
  requires hr : r ∈ Rw
  requires hc : c ∈ C
  requires matched : IsMatchedPair(Rw, C, T, ε, ε2, l, l2, r, c)
  shows relWeight(Rw, C, T, ε, ε2, l, r) =
    integerNegValue(relWeight(C, Rw, dpSwap(Rw, C, T), ε2, ε, l2, c))
proof
  sorry

-- JointHarmonicUnique.lean, IsMatch.unique: pre-joint harmonics are
-- proportional.
theorem IsMatch.unique (Rw C I T ε ε2 l l2 P Q : Set)
  requires setting : DualPairSetting(Rw, C, I, T, ε, ε2)
  requires match : IsMatch(Rw, C, I, T, ε, ε2, l, l2)
  requires hP : IsPreJointHarmonic(Rw, C, I, T, ε, ε2, l, l2, P)
  requires hQ : IsPreJointHarmonic(Rw, C, I, T, ε, ε2, l, l2, Q)
  shows ∃ c ∈ complexCarrier, P = polyScale(I, c, Q)
proof
  sorry

-- JointHarmonicExists.lean, IsMatch.exists_isJointHarmonic.
theorem IsMatch.exists_joint_harmonic (Rw C I T ε ε2 l l2 : Set)
  requires setting : DualPairSetting(Rw, C, I, T, ε, ε2)
  requires match : IsMatch(Rw, C, I, T, ε, ε2, l, l2)
  shows ∃ Φ ∈ cPolys(I), IsJointHarmonic(Rw, C, I, T, ε, ε2, l, l2, Φ)
proof
  sorry

-- HoweArgument.lean, IsJointHarmonic.howe_argument (Howe's count): a space
-- G of polynomials stable under the column action, containing a joint
-- harmonic y, all E_ba P with ε_a = ε_b, l_b < l_a, all E_aa P − Λ_a P, and
-- ρ(X)P for every row K-highest P whose weight minus Λ is outside the root
-- cone, is everything.
theorem IsJointHarmonic.howe (Rw C I T ε ε2 l l2 y G : Set)
  requires setting : DualPairSetting(Rw, C, I, T, ε, ε2)
  requires joint : IsJointHarmonic(Rw, C, I, T, ε, ε2, l, l2, y)
  requires sub : SubmoduleOf(G, polyModule(I), complexRing)
  requires stable : ∀ Xm ∈ cMatrices(C), ∀ P ∈ G, oscCols(Rw, C, I, T, ε, ε2)(Xm)(P) ∈ G
  requires hy : y ∈ G
  requires cone : ∀ ν ∈ functionSpace(Rw, ℤ), ∀ P ∈ cPolys(I), ∀ Xm ∈ cMatrices(Rw),
    IsKHighest(Rw, ε, l, polyModule(I), oscRows(Rw, C, I, T, ε, ε2), ν, P) →
    intVecSub(Rw, ν, lowestKType(Rw, ε, l)) ∉ rootCone(Rw, l) →
    oscRows(Rw, C, I, T, ε, ε2)(Xm)(P) ∈ G
  requires lowering : ∀ a ∈ Rw, ∀ b ∈ Rw, ε(a) = ε(b) → integerLess(l(b), l(a)) →
    ∀ P ∈ cPolys(I), glE(Rw, oscRows(Rw, C, I, T, ε, ε2), b, a)(P) ∈ G
  requires weights : ∀ a ∈ Rw, ∀ P ∈ cPolys(I),
    polyAdd(I, glE(Rw, oscRows(Rw, C, I, T, ε, ε2), a, a)(P),
      polyScale(I, ℂ[-intToComplex(lowestKType(Rw, ε, l)(a))], P)) ∈ G
  shows G = cPolys(I)
proof
  sorry

-- Section: The local theta correspondence
-- STAND-IN for OscillatorRep T π (Lib/Weil/Fock/OscillatorPair.lean).
def fockPolyVectorMap (I η : Set) : Set := polyVectorMap(I, η)

def fockInnerForm (I η : Set) : Set :=
  { (p, realInner(I, fst(p), snd(p))) |
    p ∈ Module.carrier(fockModule(I, η)) × Module.carrier(fockModule(I, η)) }

predicate csDSOscillatorRep (Rw C I T ε ε2 π : Set) :=
  IsUnitaryRep(Rw, signMatrix(complexRing, Rw, ε), fockModule(I, dpEta(Rw, C, I, T, ε, ε2)),
    fockNorm(I, dpEta(Rw, C, I, T, ε, ε2)), cardinality(I), π, fockInnerForm(I, dpEta(Rw, C, I, T, ε, ε2))) ∧
  IsDerivedAction(Rw, signMatrix(complexRing, Rw, ε), fockModule(I, dpEta(Rw, C, I, T, ε, ε2)),
    fockNorm(I, dpEta(Rw, C, I, T, ε, ε2)), π, polyModule(I),
    fockPolyVectorMap(I, dpEta(Rw, C, I, T, ε, ε2)), oscRows(Rw, C, I, T, ε, ε2)) ∧
  ∀ P ∈ cPolys(I), ∀ z ∈ signUnitaryMatrices(Rw, ε),
    P ≠ Ring.zero(polyRing(I)) → IsHarmonic(Rw, C, I, T, ε, P) → IsPosDefMatrix(Rw, z) →
      realZero < complexRe(realInner(I, polyVector(I, dpEta(Rw, C, I, T, ε, ε2), P),
        π(z)(polyVector(I, dpEta(Rw, C, I, T, ε, ε2), P))))

-- STAND-IN for OscillatorPair T π π′: commuting oscillator representations
-- for the rows and the columns.
predicate csDSOscillatorPair (Rw C I T ε ε2 π π2 : Set) :=
  csDSOscillatorRep(Rw, C, I, T, ε, ε2, π) ∧
  csDSOscillatorRep(C, Rw, I, dpSwap(Rw, C, T), ε2, ε, π2) ∧
  ∀ g ∈ signUnitaryMatrices(Rw, ε), ∀ h ∈ signUnitaryMatrices(C, ε2),
    ∀ v ∈ Module.carrier(fockModule(I, dpEta(Rw, C, I, T, ε, ε2))), π(g)(π2(h)(v)) = π2(h)(π(g)(v))

-- LocalThetaCorrespondence.lean, swap: π′, π is a pair for the swapped data.
theorem csDSOscillatorPair.swap (Rw C I T ε ε2 π π2 : Set)
  requires setting : DualPairSetting(Rw, C, I, T, ε, ε2)
  requires pair : csDSOscillatorPair(Rw, C, I, T, ε, ε2, π, π2)
  shows csDSOscillatorPair(C, Rw, I, dpSwap(Rw, C, T), ε2, ε, π2, π)
proof
  sorry

-- π(e_λ) on the Fock space, and its value at v_Φ.
def fockIntegrated (Rw C I T ε ε2 l π : Set) : Set :=
  integratedRep(Rw, ε, fockModule(I, dpEta(Rw, C, I, T, ε, ε2)), fockNorm(I, dpEta(Rw, C, I, T, ε, ε2)),
    π, dsKernelOn(Rw, ε, l))

def thetaVector (Rw C I T ε ε2 l π Φ : Set) : Set :=
  fockIntegrated(Rw, C, I, T, ε, ε2, l, π)(polyVector(I, dpEta(Rw, C, I, T, ε, ε2), Φ))

-- LocalThetaCorrespondence.lean, re_inner_integratedRep_pos:
-- Re⟨v_Φ, π(e_λ)v_Φ⟩ > 0.
theorem thetaVector.inner_pos (Rw C I T ε ε2 l l2 π π2 Φ : Set)
  requires setting : DualPairSetting(Rw, C, I, T, ε, ε2)
  requires nonempty : Rw ≠ ∅
  requires pair : csDSOscillatorPair(Rw, C, I, T, ε, ε2, π, π2)
  requires joint : IsJointHarmonic(Rw, C, I, T, ε, ε2, l, l2, Φ)
  shows realZero < complexRe(realInner(I, polyVector(I, dpEta(Rw, C, I, T, ε, ε2), Φ),
    thetaVector(Rw, C, I, T, ε, ε2, l, π, Φ)))
proof
  sorry

-- LocalThetaCorrespondence.lean, isDerivedAction_integratedRep: π′ is
-- differentiated along P ↦ π(e_λ)v_P by the column action.
def thetaMap (Rw C I T ε ε2 l π : Set) : Set :=
  { (P, thetaVector(Rw, C, I, T, ε, ε2, l, π, P)) | P ∈ cPolys(I) }

theorem thetaMap.derived (Rw C I T ε ε2 l l2 π π2 Φ : Set)
  requires setting : DualPairSetting(Rw, C, I, T, ε, ε2)
  requires nonempty : Rw ≠ ∅
  requires pair : csDSOscillatorPair(Rw, C, I, T, ε, ε2, π, π2)
  requires joint : IsJointHarmonic(Rw, C, I, T, ε, ε2, l, l2, Φ)
  shows IsDerivedAction(C, signMatrix(complexRing, C, ε2), fockModule(I, dpEta(Rw, C, I, T, ε, ε2)),
    fockNorm(I, dpEta(Rw, C, I, T, ε, ε2)), π2, polyModule(I), thetaMap(Rw, C, I, T, ε, ε2, l, π),
    oscCols(Rw, C, I, T, ε, ε2))
proof
  sorry

-- LocalThetaCorrespondence.lean, integratedRep_fix: for ranks ≥ 1, if
-- ‖g‖^{|I|} f is integrable on U(ε′) and f ∗ e_λ′ = e_λ′, then π′(f) fixes
-- π(e_λ)v_Φ.
theorem thetaVector.fix (Rw C I T ε ε2 l l2 π π2 Φ f : Set)
  requires setting : DualPairSetting(Rw, C, I, T, ε, ε2)
  requires nonemptyR : Rw ≠ ∅
  requires nonemptyC : C ≠ ∅
  requires pair : csDSOscillatorPair(Rw, C, I, T, ε, ε2, π, π2)
  requires joint : IsJointHarmonic(Rw, C, I, T, ε, ε2, l, l2, Φ)
  requires hf : FunctionBetween(f, signUnitaryMatrices(C, ε2), complexCarrier)
  requires integrable : ComplexIntegrable(signBorel(C, ε2), signHaar(C, ε2),
    normPowWeighted(C, ε2, f, cardinality(I)))
  requires conv : ∀ g ∈ signUnitaryMatrices(C, ε2),
    complexMeasureIntegral(signBorel(C, ε2), signHaar(C, ε2), kernelConvIntegrand(C, ε2, l2, f, g)) =
      dsKernel(C, ε2, l2, g)
  shows integratedRep(C, ε2, fockModule(I, dpEta(Rw, C, I, T, ε, ε2)),
      fockNorm(I, dpEta(Rw, C, I, T, ε, ε2)), π2, f)(thetaVector(Rw, C, I, T, ε, ε2, l, π, Φ)) =
    thetaVector(Rw, C, I, T, ε, ε2, l, π, Φ)
proof
  sorry

-- LocalThetaCorrespondence.lean, exists_bump_integratedRep_eq: for every
-- P, π(e_λ)v_P = π′(α̌)π(e_λ)v_Φ for some bump α on U(ε′).
def invertedFn (C f : Set) : Set := { (g, f(matInverse(complexRing, C, g))) | g ∈ domain(f) }

theorem thetaVector.exists_bump (Rw C I T ε ε2 l l2 π π2 Φ P : Set)
  requires setting : DualPairSetting(Rw, C, I, T, ε, ε2)
  requires nonemptyR : Rw ≠ ∅
  requires nonemptyC : C ≠ ∅
  requires pair : csDSOscillatorPair(Rw, C, I, T, ε, ε2, π, π2)
  requires joint : IsJointHarmonic(Rw, C, I, T, ε, ε2, l, l2, Φ)
  requires hP : P ∈ cPolys(I)
  shows ∃ α ∈ bumps(C, ε2), thetaVector(Rw, C, I, T, ε, ε2, l, π, P) =
    integratedRep(C, ε2, fockModule(I, dpEta(Rw, C, I, T, ε, ε2)),
      fockNorm(I, dpEta(Rw, C, I, T, ε, ε2)), π2, invertedFn(C, α))(thetaVector(Rw, C, I, T, ε, ε2, l, π, Φ))
proof
  sorry

end DiscreteSeriesTheta
