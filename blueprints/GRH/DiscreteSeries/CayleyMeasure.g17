-- The Haar measure of U(J) for a hermitian involution J, in Cayley
-- coordinates: the Cayley chart y ↦ (1 + X)(1 − X)⁻¹, X = ½J⁻¹S(y), S(y)
-- the skew-hermitian matrix with real coordinates y; the density
-- (|det J| |det(1 − X)|²)^(−n) divided by vol U(n) = ∏_{i<n} 2π^{i+1}/i!;
-- the image measure is a Haar measure, carried to that of U(J′) by every
-- map g ↦ agb with bᴴ(εJ)b = J′; U(n) has mass one; the measure is right
-- invariant.
-- Source: grh-compact/src/Lib/DiscreteSeries/Haar/CompactDualMeasure.lean
-- (cayleyDenom, cayleyChart, cayleyDensity, sphereDensity, volU, haarU,
-- volU_pos, det_cayleyDenom_one_ne_zero, cayleyChartInv,
-- cayleyChart_injOn, cayleyChart_cayleyChartInv, lintegral_eq_cayleyChart,
-- measurePreserving_haarU, the IsHaarMeasure instance),
-- Haar/HaarMass.lean (isProbabilityMeasure_haarU, the
-- IsMulRightInvariant instance). Part of: "Haar measure of U(J) in Cayley
-- coordinates, volume of U(n), polynomial volume growth (known result; see
-- Lib.DiscreteSeries.Haar.RegularRepL2)."
-- Not stated: the Jacobian lemmas of the chart (logDerivU_cayleyChart,
-- cayleyChart_jacobian, abs_det_logDerivU_cayleyChart,
-- Haar.lintegral_chart_rotate_le, lintegral_comp_le_haarU) and the
-- column chart of HaarColumnChart.lean and SphereFibreIntegral.lean
-- (skewColumnEquiv, lintegral_cayleyDensity_skewColumnEquiv), steps of
-- the proofs of measurePreserving_haarU and of the mass one.
-- Encoding. Real n × n matrices carry the product topology of ℝ^{ι×ι} and
-- Lebesgue measure, named by its normalisation as the regular Haar measure
-- with ∫ exp(−π Σ y_ab²) = 1 (the source's volume, HasGaussianIntegral).
-- The chart is defined on all real matrices, with value −1 where 1 − X is
-- singular (the source's inverse of a singular matrix is 0); the density
-- vanishes there, so the image measure is the source's haarU. Measures on
-- U(J) are on the Borel sets of unitaryOfSpace.
-- Part of the GRH blueprint (layer 4, Lib/DiscreteSeries, stage S2).
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.DiscreteSeries.CayleyMeasure
import GRH.DiscreteSeries.Unitary

section DiscreteSeriesCayleyMeasure
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- Section: Lebesgue measure on real matrices
-- ℝ^{ι×ι}: its additive group and product topology.
def rMatrixGroup (ι : Set) : Set := Module.additive(coordinateModule(realRing, ι × ι))

def rMatrixSpace (ι : Set) : Set := piSpace(ι × ι, constantSpaces(ι × ι, realTopology))

def rMatrixBorel (ι : Set) : Set := borelSpace(rMatrixSpace(ι))

-- y ↦ exp(−π Σ y_ab²), in [0, ∞].
def rMatrixSquares (ι y : Set) : Set := { (q, R[y(q) * y(q)]) | q ∈ ι × ι }

def rMatrixGaussian (ι : Set) : Set :=
  { (y, ennOfReal(realExp(R[-(realPi * realFiniteSum(rMatrixSquares(ι, y), ι × ι))]))) |
    y ∈ rMatrices(ι) }

-- Lebesgue measure on ℝ^{ι×ι}: the regular Haar measure with Gaussian
-- integral one.
def rMatrixMeasure (ι : Set) : Set :=
  ⋃({ μ ∈ 𝒫(borelSigma(rMatrixSpace(ι)) × ennreal) |
    RegularHaarMeasure(rMatrixGroup(ι), rMatrixSpace(ι), μ) ∧
    lintegral(rMatrixBorel(ι), μ, rMatrixGaussian(ι)) = realOne })

theorem rMatrixMeasure.haar (ι : Set)
  requires finite : Finite(ι)
  shows RegularHaarMeasure(rMatrixGroup(ι), rMatrixSpace(ι), rMatrixMeasure(ι)) ∧
    lintegral(rMatrixBorel(ι), rMatrixMeasure(ι), rMatrixGaussian(ι)) = realOne
proof
  sorry

-- Section: The Cayley chart
-- CompactDualMeasure.lean, cayleyDenom J y = 1 − ½J⁻¹S(y).
def cayleyDenom (ι J y : Set) : Set :=
  matSub(ι, matOne(complexRing, ι), matSmul(complexRing, ι, ι, complexDiv(complexOne, ℂ[2]),
    matMul(complexRing, ι, ι, ι, matInverse(complexRing, ι, J), skewOfReal(ι, y))))

-- The real matrices where 1 − X is invertible.
def cayleyDomain (ι J : Set) : Set :=
  { y ∈ rMatrices(ι) | matDet(complexRing, ι, cayleyDenom(ι, J, y)) ≠ complexZero }

-- CompactDualMeasure.lean, cayleyChart J y = 2(1 − X)⁻¹ − 1, and −1 where
-- 1 − X is singular.
def cayleyChart (ι J y : Set) : Set :=
  ⋃({ g ∈ cMatrices(ι) | (y ∈ cayleyDomain(ι, J) ∧
      g = matSub(ι, matSmul(complexRing, ι, ι, ℂ[2],
        matInverse(complexRing, ι, cayleyDenom(ι, J, y))), matOne(complexRing, ι))) ∨
    (y ∉ cayleyDomain(ι, J) ∧ g = matNeg(complexRing, ι, ι, matOne(complexRing, ι))) })

def cayleyChartMap (ι J : Set) : Set := { (y, cayleyChart(ι, J, y)) | y ∈ rMatrices(ι) }

-- CompactDualMeasure.lean, cayleyDensity J y =
-- ((|det J| |det(1 − X)|²)^n)⁻¹, n = |ι|.
def cayleyDensity (ι J y : Set) : Set :=
  realInvValue(R[(complexAbs(matDet(complexRing, ι, J)) *
    complexAbs(matDet(complexRing, ι, cayleyDenom(ι, J, y))) ^ 2) ^ cardinality(ι)])

-- CompactDualMeasure.lean, sphereDensity k r = 2π^k r^{k−1}/(k − 1)!, and
-- volU j = ∏_{i<j} sphereDensity (i + 1) 1, the volume of U(j).
def sphereDensity (k : Nat, r : Set) : Set :=
  R[2 * realPi ^ k * r ^ predecessor(k) / realNat(factorial(predecessor(k)))]

def volUFactors : Set := { (i, sphereDensity(succ(i), realOne)) | i ∈ ℕ }

def volU (j : Nat) : Set :=
  finiteRingProduct(j, ℝ, realAdd, realZero, realNeg, realMul, realOne, volUFactors)

theorem volU.pos (j : Nat)
  shows realZero < volU(j)
proof
  sorry

-- The density cayleyDensity/vol U(n) on the domain, 0 off it.
def haarDensityValue (ι J y : Set) : Set :=
  ⋃({ v ∈ ennreal |
    (y ∈ cayleyDomain(ι, J) ∧ v = ennOfReal(realDiv(cayleyDensity(ι, J, y), volU(cardinality(ι))))) ∨
    (y ∉ cayleyDomain(ι, J) ∧ v = ennOfReal(realZero)) })

def haarDensity (ι J : Set) : Set := { (y, haarDensityValue(ι, J, y)) | y ∈ rMatrices(ι) }

-- CompactDualMeasure.lean, haarU J: the image under the Cayley chart of
-- Lebesgue measure with density cayleyDensity/vol U(n) on the domain.
def unitaryBorel (ι J : Set) : Set := borelSpace(unitaryOfSpace(ι, J))

def haarU (ι J : Set) : Set :=
  mapMeasure(cayleyChartMap(ι, J), rMatrixBorel(ι),
    withDensity(rMatrixBorel(ι), rMatrixMeasure(ι), haarDensity(ι, J)), unitaryBorel(ι, J))

-- CompactDualMeasure.lean, the chart lands in U(J).
theorem cayleyChart.mem (ι J y : Set)
  requires finite : Finite(ι)
  requires herm : IsHermInvolution(ι, J)
  requires hy : y ∈ rMatrices(ι)
  shows cayleyChart(ι, J, y) ∈ unitaryOf(ι, J)
proof
  sorry

-- CompactDualMeasure.lean, det_cayleyDenom_one_ne_zero: for J = 1 the
-- domain is everything.
theorem cayleyDomain.one (ι : Set)
  requires finite : Finite(ι)
  shows cayleyDomain(ι, matOne(complexRing, ι)) = rMatrices(ι)
proof
  sorry

-- CompactDualMeasure.lean, cayleyChartInv g = skewCoords(2J(1 − 2(g + 1)⁻¹)).
def cayleyChartInv (ι J g : Set) : Set :=
  skewCoords(ι, matSmul(complexRing, ι, ι, ℂ[2], matMul(complexRing, ι, ι, ι, J,
    matSub(ι, matOne(complexRing, ι), matSmul(complexRing, ι, ι, ℂ[2],
      matInverse(complexRing, ι, matAdd(complexRing, ι, ι, g, matOne(complexRing, ι))))))))

-- CompactDualMeasure.lean, cayleyChart_injOn.
theorem cayleyChart.inj_on (ι J y z : Set)
  requires finite : Finite(ι)
  requires herm : IsHermInvolution(ι, J)
  requires hy : y ∈ cayleyDomain(ι, J)
  requires hz : z ∈ cayleyDomain(ι, J)
  requires same : cayleyChart(ι, J, y) = cayleyChart(ι, J, z)
  shows y = z
proof
  sorry

-- CompactDualMeasure.lean, cayleyChart_cayleyChartInv: where g + 1 is
-- invertible, g is the chart at cayleyChartInv g.
theorem cayleyChart.inverse (ι J g : Set)
  requires finite : Finite(ι)
  requires herm : IsHermInvolution(ι, J)
  requires hg : g ∈ unitaryOf(ι, J)
  requires unit : matDet(complexRing, ι, matAdd(complexRing, ι, ι, g, matOne(complexRing, ι))) ≠
    complexZero
  shows cayleyChartInv(ι, J, g) ∈ cayleyDomain(ι, J) ∧
    cayleyChart(ι, J, cayleyChartInv(ι, J, g)) = g
proof
  sorry

-- Section: The Haar measure of U(J)
-- y ↦ (cayleyDensity(y)/vol U(n)) f(cayleyChart y).
def cayleyIntegrand (ι J f : Set) : Set :=
  { (y, ennMul(ennOfReal(realDiv(cayleyDensity(ι, J, y), volU(cardinality(ι)))),
      f(cayleyChart(ι, J, y)))) | y ∈ rMatrices(ι) }

-- CompactDualMeasure.lean, lintegral_eq_cayleyChart (known result: Haar
-- measure of U(J) in Cayley coordinates).
theorem haarU.lintegral (ι J f : Set)
  requires finite : Finite(ι)
  requires herm : IsHermInvolution(ι, J)
  requires hf : FunctionBetween(f, unitaryOf(ι, J), ennreal)
  shows lintegral(unitaryBorel(ι, J), haarU(ι, J), f) =
    setLIntegral(rMatrixBorel(ι), rMatrixMeasure(ι), cayleyIntegrand(ι, J, f), cayleyDomain(ι, J))
proof
  sorry

-- CompactDualMeasure.lean, measurePreserving_haarU: J, J′ hermitian
-- involutions, a, b invertible, ε real nonzero with bᴴ(εJ)b = J′; a
-- bijection φ : U(J) → U(J′) given by g ↦ agb carries haarU J to haarU J′.
theorem haarU.measure_preserving (ι J J2 a b e φ : Set)
  requires finite : Finite(ι)
  requires herm : IsHermInvolution(ι, J)
  requires herm2 : IsHermInvolution(ι, J2)
  requires ha : a ∈ invertibleMatrices(complexRing, ι)
  requires hb : b ∈ invertibleMatrices(complexRing, ι)
  requires he : e ∈ ℝ
  requires nonzero : e ≠ realZero
  requires gram : gramMatrix(complexRing, complexConj, ι, ι, ι,
    matSmul(complexRing, ι, ι, complexOfReal(e), J), b, b) = J2
  requires bij : BijectiveBetween(φ, unitaryOf(ι, J), unitaryOf(ι, J2))
  requires hφ : ∀ g ∈ unitaryOf(ι, J),
    φ(g) = matMul(complexRing, ι, ι, ι, matMul(complexRing, ι, ι, ι, a, g), b)
  shows MeasurePreserving(φ, unitaryBorel(ι, J), haarU(ι, J), unitaryBorel(ι, J2), haarU(ι, J2))
proof
  sorry

-- CompactDualMeasure.lean, the IsHaarMeasure instance: haarU J is a Haar
-- measure on U(J).
theorem haarU.haar (ι J : Set)
  requires finite : Finite(ι)
  requires herm : IsHermInvolution(ι, J)
  shows HaarMeasure(unitaryOfGroup(ι, J), unitaryOfSpace(ι, J), haarU(ι, J))
proof
  sorry

-- HaarMass.lean, isProbabilityMeasure_haarU: U(n) has mass one (known
-- result: volume of U(n)).
theorem haarU.mass_one (ι : Set)
  requires finite : Finite(ι)
  shows ProbabilityMeasure(unitaryBorel(ι, matOne(complexRing, ι)), haarU(ι, matOne(complexRing, ι)))
proof
  sorry

-- HaarMass.lean, the IsMulRightInvariant instance.
theorem haarU.right_invariant (ι J : Set)
  requires finite : Finite(ι)
  requires herm : IsHermInvolution(ι, J)
  shows RightInvariant(unitaryOfGroup(ι, J), unitaryOfSpace(ι, J), haarU(ι, J))
proof
  sorry

end DiscreteSeriesCayleyMeasure
