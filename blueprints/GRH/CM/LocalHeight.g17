-- Local heights on CM curves at a p-adic place ι : ℂ → ℂ_p: integrality
-- of a₁ and good reduction, the naive height h = max(|ισ|, |ιθ|), Tate's
-- trick for translates along isogenies, the ring 𝔬[[φ]] and its stability
-- under d/dz, the integrality principle for sections, integrality of
-- isogenies and of rescaled translates, Galois conjugation of sections,
-- and Euler's addition formula in integral form.
-- Source: grh-compact/src/Lib/CM/LocalHeight/IntegralParameter.lean
-- (padicValNat_factorial_mem_Icc, CMLattice.norm_disc_eq_one,
-- CMLattice.norm_a₁_le_one, CMLattice.naiveHeight,
-- CMLattice.norm_monomialSection_le,
-- CMLattice.norm_translate_le_naiveHeight_pow, IsSeriesGenerator,
-- CMLattice.deriv_mem_phiSeriesRing, isSeriesGenerator_translatedWpDeriv),
-- Lib/CM/LocalHeight/IsogenyIntegrality.lean (thetaQuotient,
-- exists_conjugate_section, exists_val_coeff_le_val_eval,
-- CMLattice.exists_eq_theta_pow_mul_of_norm_le,
-- CMLattice.rescale_translate_eq_theta_pow_mul,
-- CMLattice.rescale_translatedWpDeriv_mem, CMLattice.norm_le_one_of_isogeny),
-- Lib/CM/LocalHeight/EulerAdditionFormula.lean (multiPhiRing,
-- translatedWpDeriv_add_mem_multiPhiRing).
-- Encoding. A p-adic place is ι = (Ω, ιₚ) (GRH.General.PadicPlace); the
-- source's ‖ιₚ x‖ is padicPlaceNorm(p, ι, x). Series over ℂ_p are
-- powerSeriesCarrier(placeCp(p, ι)) with the ring powerSeriesRing; σf for
-- a series f is seriesMap. The source's θ′/σθ = taylor(θ′)·(σ taylor θ)⁻¹
-- (thetaQuotient) is the unique series Q with Q·σ(taylor θ) = taylor θ′
-- (σ taylor θ has constant term 1). The ring 𝔬[[φ(u), φ(w)]] in two
-- variables (multiPhiRing for μ = 1) is the set of G(φ(u), φ(w)), G an
-- integral series in two variables, written as mvSeriesSubstitution.
-- Part of the GRH blueprint (layer 4, Lib/CM, stage S3).
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.CM.LocalHeight
import GRH.CM.CurveTheta

section LocalHeight
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- Section: Legendre's formula
-- IntegralParameter.lean, padicValNat_factorial_mem_Icc: for n < p^K,
-- n/(p−1) − K ≤ v_p(n!) ≤ n/(p−1).
theorem padicValNat.factorial_bounds (p n K : Nat)
  requires prime : Prime(p)
  requires small : n < pow(p, K)
  shows RealLe(R[realNat(n) / (realNat(p) - 1) - realNat(K)], realNat(padicValNat(p, n !))) ∧
    RealLe(realNat(padicValNat(p, n !)), R[realNat(n) / (realNat(p) - 1)])
proof
  sorry

-- Section: Integrality and the naive height
-- IntegralParameter.lean, CMLattice.norm_disc_eq_one and norm_a₁_le_one:
-- a₁⁴ − 64 is a unit and a₁ is integral at every p-adic place (good
-- reduction everywhere).
theorem IsCMLattice.integral (C p ι : Set) (d : Nat)
  requires cm : IsCMLattice(d, C)
  requires sevenEight : PrimeSevenModEight(d)
  requires prime : Prime(p)
  requires place : ι ∈ padicPlaces(p)
  shows padicPlaceNorm(p, ι, ℂ[C.a1 ^ 4 - 64]) = realOne ∧
    RealLe(padicPlaceNorm(p, ι, C.a1), realOne)
proof
  sorry

-- IntegralParameter.lean, CMLattice.naiveHeight: h(w) = max(|ισ(w)|, |ιθ(w)|).
def realMaxOf (a b : Set) : Set :=
  ⋃({ c ∈ ℝ | (RealLe(a, b) ∧ c = b) ∨ (¬RealLe(a, b) ∧ c = a) })

def cmNaiveHeight (p ι C w : Set) : Set :=
  realMaxOf(padicPlaceNorm(p, ι, cmSigma(C)(w)), padicPlaceNorm(p, ι, cmTheta(C)(w)))

-- IntegralParameter.lean, CMLattice.norm_monomialSection_le:
-- |ι(θ^a σ^{2b} G^c)(w)| ≤ h(w)^{a+2b+3c}.
theorem monomialSection.norm_le (C p ι x w : Set) (d : Nat)
  requires cm : IsCMLattice(d, C)
  requires sevenEight : PrimeSevenModEight(d)
  requires prime : Prime(p)
  requires place : ι ∈ padicPlaces(p)
  requires hx : x ∈ ℕ × (ℕ × ℕ)
  requires hw : w ∈ complexCarrier
  shows RealLe(padicPlaceNorm(p, ι, monomialSection(C, x)(w)),
    realRpow(cmNaiveHeight(p, ι, C, w), realNat(cmMonomialDeg(x))))
proof
  sorry

-- IntegralParameter.lean, CMLattice.norm_translate_le_naiveHeight_pow
-- (Tate's trick): for an isogeny a : C → C′ of degree N, y with ny ∈ Λ′
-- (n ≠ 0), and |ιg| ≤ h′^m on ℂ, |ι((U′^m_y g)(az))| ≤ h(z)^{mN}.
theorem twistedTranslate.norm_le_height (C D p ι a N y g z : Set) (d n m : Nat)
  requires cm : IsCMLattice(d, C)
  requires cm2 : IsCMLattice(d, D)
  requires sevenEight : PrimeSevenModEight(d)
  requires prime : Prime(p)
  requires place : ι ∈ padicPlaces(p)
  requires isogeny : IsCMIsogeny(C, D, a, N)
  requires hy : y ∈ complexCarrier
  requires nonzero : n ≠ (0:N)
  requires torsion : ℂ[intComplex(n) * y] ∈ cmLattice(D)
  requires hg : g ∈ functionSpace(complexCarrier, complexCarrier)
  requires bound : ∀ w ∈ complexCarrier,
    RealLe(padicPlaceNorm(p, ι, g(w)), realRpow(cmNaiveHeight(p, ι, D, w), realNat(m)))
  requires hz : z ∈ complexCarrier
  shows RealLe(padicPlaceNorm(p, ι, twistedTranslate(D, m, y, g)(ℂ[a * z])),
    realRpow(cmNaiveHeight(p, ι, C, z), realNat(mul(m, N))))
proof
  sorry

-- Section: The ring 𝔬[[φ]]
-- IntegralParameter.lean, IsSeriesGenerator A T: T = X + ⋯ and A consists
-- exactly of the g(T), g integral.
predicate IsSeriesGenerator (p ι A T : Set) :=
  T ∈ powerSeriesCarrier(placeCp(p, ι)) ∧ T(0) = Ring.zero(placeCp(p, ι)) ∧
  T(1) = Ring.one(placeCp(p, ι)) ∧
  ∀ f, f ∈ A ↔ (∃ g ∈ integralSeries(p, ι), f = seriesSubst(placeCp(p, ι), g, T))

-- IntegralParameter.lean, isSeriesGenerator_translatedWpDeriv and
-- CMLattice.deriv_mem_phiSeriesRing: φ generates 𝔬[[φ]], the Taylor series
-- of ξ lies in it, and 𝔬[[φ]] is stable under d/dz.
theorem phiSeriesRing.facts (C p ι f : Set) (d : Nat)
  requires cm : IsCMLattice(d, C)
  requires sevenEight : PrimeSevenModEight(d)
  requires prime : Prime(p)
  requires place : ι ∈ padicPlaces(p)
  requires hf : f ∈ phiSeriesRing(p, ι, C)
  shows IsSeriesGenerator(p, ι, phiSeriesRing(p, ι, C), taylorVia(p, ι, translatedWpDeriv(C))) ∧
    taylorVia(p, ι, translatedWp(C)) ∈ phiSeriesRing(p, ι, C) ∧
    seriesDerivative(placeCp(p, ι), f) ∈ phiSeriesRing(p, ι, C)
proof
  sorry

-- θ^N u for a series u.
def thetaPowTimes (p ι C u : Set) (N : Nat) : Set :=
  call2(Ring.mul(powerSeriesRing(placeCp(p, ι))),
    Ring.pow(powerSeriesRing(placeCp(p, ι)), taylorVia(p, ι, cmTheta(C)), N), u)

-- An even function: f(−z) = f(z).
predicate EvenFunction (f : Set) := ∀ z ∈ complexCarrier, f(ℂ[-z]) = f(z)

-- P(ξ) for a polynomial P over ℂ, read in ℂ_p.
def polySeriesTerms (p ι P F : Set) : Set :=
  { (k, call2(Ring.mul(powerSeriesRing(placeCp(p, ι))),
      seriesConstant(placeCp(p, ι), placeHom(ι)(polyCoeff(P, k))),
      Ring.pow(powerSeriesRing(placeCp(p, ι)), F, k))) | k ∈ ℕ }

-- IsogenyIntegrality.lean, CMLattice.exists_eq_theta_pow_mul_of_norm_le
-- (integrality principle): a section f of degree m with |ιf| ≤ h^m has
-- series θ^m u, u ∈ 𝔬[[φ]]; for even f, u = (ιP)(ξ) for a polynomial P
-- with integral coefficients (of degree below D), and f(t) = P_{m/2} σ(t)^m
-- for m even.
theorem cmSections.integrality (C p ι f : Set) (d m : Nat)
  requires cm : IsCMLattice(d, C)
  requires sevenEight : PrimeSevenModEight(d)
  requires prime : Prime(p)
  requires place : ι ∈ padicPlaces(p)
  requires hf : f ∈ cmSections(C, m)
  requires bound : ∀ z ∈ complexCarrier,
    RealLe(padicPlaceNorm(p, ι, f(z)), realRpow(cmNaiveHeight(p, ι, C, z), realNat(m)))
  shows ∃ u ∈ phiSeriesRing(p, ι, C), taylorVia(p, ι, f) = thetaPowTimes(p, ι, C, u, m) ∧
    (EvenFunction(f) → ∃ P ∈ Ring.carrier(polynomialRing(complexRing, {0})), ∃ D ∈ ℕ,
      (∀ k ∈ ℕ, RealLe(padicPlaceNorm(p, ι, polyCoeff(P, k)), realOne)) ∧
      (∀ k ∈ ℕ, D ⊆ k → polyCoeff(P, k) = complexZero) ∧
      u = groupFiniteSum(Ring.additive(powerSeriesRing(placeCp(p, ι))), D,
        polySeriesTerms(p, ι, P, taylorVia(p, ι, translatedWp(C)))) ∧
      (∀ j ∈ ℕ, m = mul(2, j) →
        f(C.t) = ℂ[polyCoeff(P, j) * cmSigma(C)(C.t) ^ m]))
proof
  sorry

-- IsogenyIntegrality.lean, CMLattice.rescale_translate_eq_theta_pow_mul:
-- for 0 ≠ δ with conj δ an isogeny of degree N of Λ and δy ∈ Λ, the series
-- (U_yθ)(δ̄z), read in ℂ_p, lies in θ^N 𝔬[[φ]].
theorem twistedTranslate.rescale_mem (C p ι δ y : Set) (d N : Nat)
  requires cm : IsCMLattice(d, C)
  requires sevenEight : PrimeSevenModEight(d)
  requires prime : Prime(p)
  requires place : ι ∈ padicPlaces(p)
  requires isogeny : IsCMIsogeny(C, C, complexConj(δ), N)
  requires nonzero : δ ≠ complexZero
  requires hy : y ∈ complexCarrier
  requires torsion : ℂ[δ * y] ∈ cmLattice(C)
  shows ∃ u ∈ phiSeriesRing(p, ι, C),
    seriesRescale(placeCp(p, ι), placeHom(ι)(complexConj(δ)),
      taylorVia(p, ι, twistedTranslate(C, (1:N), y, cmTheta(C)))) = thetaPowTimes(p, ι, C, u, N)
proof
  sorry

-- IsogenyIntegrality.lean, CMLattice.rescale_translatedWpDeriv_mem and
-- norm_le_one_of_isogeny: for an isogeny a : C → C′ of degree N, a is
-- integral, φ′(az) ∈ 𝔬[[φ]] and θ′(az) ∈ θ^N 𝔬[[φ]], read in ℂ_p.
theorem cmIsogeny.integral (C D p ι a : Set) (d N : Nat)
  requires cm : IsCMLattice(d, C)
  requires cm2 : IsCMLattice(d, D)
  requires sevenEight : PrimeSevenModEight(d)
  requires prime : Prime(p)
  requires place : ι ∈ padicPlaces(p)
  requires isogeny : IsCMIsogeny(C, D, a, N)
  shows RealLe(padicPlaceNorm(p, ι, a), realOne) ∧
    seriesRescale(placeCp(p, ι), placeHom(ι)(a), taylorVia(p, ι, translatedWpDeriv(D))) ∈
      phiSeriesRing(p, ι, C) ∧
    (∃ v ∈ phiSeriesRing(p, ι, C),
      seriesRescale(placeCp(p, ι), placeHom(ι)(a), taylorVia(p, ι, cmTheta(D))) =
        thetaPowTimes(p, ι, C, v, N))
proof
  sorry

-- Section: Galois conjugation of sections
-- IsogenyIntegrality.lean, thetaQuotient C σ C′ = θ′/σθ: the unique series
-- Q over ℂ with Q · σ(taylor θ) = taylor θ′.
def complexSeriesRing : Set := powerSeriesRing(complexRing)

def thetaQuotient (C σ D : Set) : Set :=
  ⋃({ Q ∈ powerSeriesCarrier(complexRing) |
    call2(Ring.mul(complexSeriesRing), Q,
      seriesMap(complexRing, complexRing, σ)(taylorAtZero(cmTheta(C)))) =
      taylorAtZero(cmTheta(D)) })

-- IsogenyIntegrality.lean, exists_conjugate_section: if a₁(C′) = σ(a₁(C)),
-- each z has y and μ ≠ 0 (y = t when θ′(z) = 0) such that every section f
-- of degree m of C has a section g of degree m of C′ with series
-- (θ′/σθ)^m σ(taylor f) and g(z) = μ^m σ(f(y)).
theorem cmSections.conjugate (C D σ z : Set) (d d2 : Nat)
  requires cm : IsCMLattice(d, C)
  requires cm2 : IsCMLattice(d2, D)
  requires aut : σ ∈ complexAutomorphisms
  requires conj : D.a1 = σ(C.a1)
  requires hz : z ∈ complexCarrier
  shows ∃ y ∈ complexCarrier, ∃ μ ∈ complexCarrier, μ ≠ complexZero ∧
    (cmTheta(D)(z) = complexZero → y = C.t) ∧
    ∀ m ∈ ℕ, ∀ f ∈ cmSections(C, m), ∃ g ∈ cmSections(D, m),
      taylorAtZero(g) = call2(Ring.mul(complexSeriesRing),
        Ring.pow(complexSeriesRing, thetaQuotient(C, σ, D), m),
        seriesMap(complexRing, complexRing, σ)(taylorAtZero(f))) ∧
      g(z) = ℂ[μ ^ m * σ(f(y))]
proof
  sorry

-- Section: Points of small valuation
-- IsogenyIntegrality.lean, exists_val_coeff_le_val_eval (over ℂ_p with its
-- norm): finitely many polynomials f_i over ℂ_p in variables I have a common
-- point y with integral coordinates such that every coefficient c of f_i
-- satisfies |c| ≤ |f_i(y)|.
theorem cpPolynomials.exists_point (p ι I F : Set) (k : Nat)
  requires prime : Prime(p)
  requires place : ι ∈ padicPlaces(p)
  requires polys : FunctionBetween(F, k, Ring.carrier(polynomialRing(placeCp(p, ι), I)))
  shows ∃ y ∈ functionSpace(I, placeCpIntegers(p, ι)), ∀ i ∈ k, ∀ c ∈ monomials(I),
    RealLe(placeCpNorm(p, ι)(F(i)(c)),
      placeCpNorm(p, ι)(evaluationAt(placeCp(p, ι), I, y)(F(i))))
proof
  sorry

-- Section: Euler's addition formula
-- φ(u + w) and 𝔬[[φ(u), φ(w)]] in the two variables {0, 1}
-- (EulerAdditionFormula.lean, multiPhiRing with μ = 1): G(φ(u), φ(w)) for
-- G an integral series in two variables, φ(u) = φ substituted into X₀.
def twoVariables : Set := 2

def unitEntry (R i j : Set) : Set :=
  ⋃({ a ∈ Ring.carrier(R) | (j = i ∧ a = Ring.one(R)) ∨ (j ≠ i ∧ a = Ring.zero(R)) })

def unitVector (R I i : Set) : Set := { (j, unitEntry(R, i, j)) | j ∈ I }

def onesVector (R I : Set) : Set := { (j, Ring.one(R)) | j ∈ I }

def phiInVariable (p ι C i : Set) : Set :=
  linearSubst(placeCp(p, ι), twoVariables, taylorVia(p, ι, translatedWpDeriv(C)),
    unitVector(placeCp(p, ι), twoVariables, i))

def phiOfSum (p ι C : Set) : Set :=
  linearSubst(placeCp(p, ι), twoVariables, taylorVia(p, ι, translatedWpDeriv(C)),
    onesVector(placeCp(p, ι), twoVariables))

-- The monomials of degree at most that of k.
def boundedMonomials (I k : Set) : Set :=
  { m ∈ monomials(I) | RealLe(realNat(monomialDegree(I, m)), realNat(monomialDegree(I, k))) }

-- G(φ(u), φ(w)) coefficientwise: Σ_m G_m φ(u)^{m₀} φ(w)^{m₁}, a sum that
-- is finite in each coefficient (φ has no constant term).
def phiPairTerms (p ι C G k : Set) : Set :=
  { (m, call2(Ring.mul(placeCp(p, ι)), G(m),
      call2(Ring.mul(mvPowerSeriesRing(placeCp(p, ι), twoVariables)),
        Ring.pow(mvPowerSeriesRing(placeCp(p, ι), twoVariables), phiInVariable(p, ι, C, 0), m(0)),
        Ring.pow(mvPowerSeriesRing(placeCp(p, ι), twoVariables), phiInVariable(p, ι, C, 1), m(1)))(k))) |
    m ∈ boundedMonomials(twoVariables, k) }

def multiPhiRing (p ι C : Set) : Set :=
  { F ∈ mvSeriesCarrier(placeCp(p, ι), twoVariables) |
    ∃ G ∈ integralMvSeries(p, ι, twoVariables), ∀ k ∈ monomials(twoVariables),
      F(k) = groupFiniteSum(Ring.additive(placeCp(p, ι)), domain(phiPairTerms(p, ι, C, G, k)),
        phiPairTerms(p, ι, C, G, k)) }

-- EulerAdditionFormula.lean, translatedWpDeriv_add_mem_multiPhiRing (Euler's
-- addition formula, integral form): φ(u + w) ∈ 𝔬[[φ(u), φ(w)]].
theorem phiOfSum.mem (C p ι : Set) (d : Nat)
  requires cm : IsCMLattice(d, C)
  requires sevenEight : PrimeSevenModEight(d)
  requires prime : Prime(p)
  requires place : ι ∈ padicPlaces(p)
  shows phiOfSum(p, ι, C) ∈ multiPhiRing(p, ι, C)
proof
  sorry

end LocalHeight
