-- Heights of formal groups and the transcendental inputs of the CM
-- theory: Kronecker's first limit formula, the p-adic logarithm of θ,
-- genus theory (the class number of ℚ(√−d) is odd), the Chowla–Selberg
-- formula in logarithmic form, the height of the formal group of a CM
-- curve at non-split primes, and unit coefficients of endomorphisms of
-- the formal group.
-- Source: grh-compact/src/Lib/CM/KroneckerLimit/LogTheta.lean
-- (kronecker_limit, normPairClosure, CMLattice.exists_log_theta),
-- Lib/CM/Genus/QuadraticZeta.lean (classGroup_sq_bijective),
-- Lib/CM/FormalGroup/FormalHeight.lean (CMLattice.chowla_selberg,
-- CMLattice.one_le_norm_coeff_translatedWp_nonsplit,
-- CMLattice.exists_unit_coeff_degree_le).
-- Not stated: QuadraticZeta.lean's isAlgebraic_of_padic (field
-- isomorphisms ℂ ≅ Q̄₂), FormalHeight.lean's hasSum_ideal_classes (a lemma
-- on ideal classes of general number fields) and
-- complex_multiplication_theta (its adelic clustering clause needs the
-- finite adeles of K as a number-field record); the soft main theorem
-- (GRH.CM.MainTheorem, exists_taylorVia_twistedTranslate_theta) is
-- stated.
-- Encoding. K = ℚ(√−d) is read inside ℂ (GRH.CM.CurveTheta): its
-- fractional ideals are QuadFractionalIdeal, the product of two is the set
-- of finite sums of products, and the class group statement
-- (classGroup_sq_bijective: squaring is a bijection of the finite class
-- group) is stated as injectivity: a fractional ideal with principal
-- square is principal. Euler's constant γ is Re ζ̃(1) (the constant term of
-- ζ at 1, as in chowlaSelbergConst). Right derivatives are written with
-- ε and δ. The Chowla–Selberg unit (ChowlaSelbergUnit, used by layer 5) is
-- moved here from GRH.Proof.Curve.PeriodDefs under the same name.
-- Part of the GRH blueprint (layer 4, Lib/CM, stage S3).
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.CM.FormalGroup
import GRH.CM.LocalHeight

section FormalGroup
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- Section: Kronecker's first limit formula
-- Euler's constant γ (the real part of the constant term of ζ at 1).
def eulerConstantCM : Set := complexRe(riemannZetaRegular(ℂ[1]))

-- F has right derivative D at a: (F(s) − F(a))/(s − a) → D as s → a⁺.
predicate RightDerivativeAt (F D a : Set) :=
  ∀ ε ∈ ℝ, realZero < ε → ∃ δ ∈ ℝ, realZero < δ ∧ ∀ s ∈ ℝ, (a:R) < s → (s:R) < R[a + δ] →
    (abs(R[(F(s) - F(a)) / (s - a) - D]):R) < ε

-- The terms (s − 1)(|l|²/(kA))^{−s}, l ∈ Λ ∖ 0.
def kroneckerTerms (ω1 ω2 k s : Set) : Set :=
  { (l, R[(s - 1) * realRpow(R[complexAbs(l) ^ 2 / (k * periodArea(ω1, ω2))], R[-s])]) |
    l ∈ periodLattice(ω1, ω2) ∖ {complexZero} }

-- LogTheta.lean, kronecker_limit: for k > 0 some F with F(1) = πk and
-- F(s) = Σ_{l ≠ 0} (s − 1)(|l|²/(kA))^{−s} on (1, 2) has right derivative
-- F(1)(2γ − log(A/(kπ²)) − log|Δ|/6) at 1, Δ = g₂³ − 27g₃².
theorem periodLattice.kronecker_limit (ω1 ω2 k : Set)
  requires pair : PeriodPairOf(ω1, ω2)
  requires hk : k ∈ ℝ
  requires positive : realZero < k
  shows ∃ F ∈ functionSpace(ℝ, ℝ), F(realOne) = R[realPi * k] ∧
    RightDerivativeAt(F, R[F(realOne) * (2 * eulerConstantCM -
      realLog(R[periodArea(ω1, ω2) / k / (realPi * realPi)]) -
      realLog(complexAbs(ℂ[weierstrassG2(periodLattice(ω1, ω2)) ^ 3 -
        27 * weierstrassG3(periodLattice(ω1, ω2)) ^ 2])) / 6)], realOne) ∧
    ∀ s ∈ ℝ, realOne < s → (s:R) < R[2] →
      RealHasSum(kroneckerTerms(ω1, ω2, k, s), periodLattice(ω1, ω2) ∖ {complexZero}, F(s))
proof
  sorry

-- Section: The logarithm of θ
-- The pairs (ι(a), ι(a ā)) for a ∈ 𝓞_K, and LogTheta.lean,
-- normPairClosure: their closure in ℂ_p × ℂ_p.
def normPairs (p ι : Set) (d : Nat) : Set :=
  { q ∈ Ring.carrier(placeCp(p, ι)) × Ring.carrier(placeCp(p, ι)) | ∃ a ∈ quadIntegers(d),
    q = (placeHom(ι)(a), placeHom(ι)(ℂ[a * complexConj(a)])) }

predicate InNormPairClosure (p ι x : Set) (d : Nat) :=
  x ∈ Ring.carrier(placeCp(p, ι)) × Ring.carrier(placeCp(p, ι)) ∧
  ∀ ε ∈ ℝ, realZero < ε → ∃ q ∈ normPairs(p, ι, d),
    (placeCpNorm(p, ι)(call2(Ring.add(placeCp(p, ι)), fst(x),
      apply(Ring.neg(placeCp(p, ι)), fst(q)))):R) < ε ∧
    (placeCpNorm(p, ι)(call2(Ring.add(placeCp(p, ι)), snd(x),
      apply(Ring.neg(placeCp(p, ι)), snd(q)))):R) < ε

-- Series operations over ℂ_p used below: c·L, L − L′, the derivative and
-- exp(L) (expSubst in one variable).
def cpSeriesRing (p ι : Set) : Set := powerSeriesRing(placeCp(p, ι))

def cpSeriesScale (p ι c L : Set) : Set :=
  call2(Ring.mul(cpSeriesRing(p, ι)), seriesConstant(placeCp(p, ι), c), L)

def cpSeriesSub (p ι L M : Set) : Set :=
  call2(Ring.add(cpSeriesRing(p, ι)), L, apply(Ring.neg(cpSeriesRing(p, ι)), M))

def cpSeriesExp (p ι L : Set) : Set := seriesSubst(placeCp(p, ι), seriesExp(placeCp(p, ι)), L)

-- LogTheta.lean, CMLattice.exists_log_theta: in ℂ_p, θ = exp(−L) with
-- L = O(z²), L″ = L₂ + ξ and √−d L₂ integral; for each (a, N) in the
-- closure of the pairs (ιδ, ι(δδ̄)), φ(az), exp(NL)θ(az) and
-- (NL − L(az))′ lie in 𝔬[[φ]].
theorem cmTheta.exists_log (C p ι : Set) (d : Nat)
  requires cm : IsCMLattice(d, C)
  requires sevenEight : PrimeSevenModEight(d)
  requires prime : Prime(p)
  requires place : ι ∈ padicPlaces(p)
  shows ∃ L ∈ powerSeriesCarrier(placeCp(p, ι)), ∃ L2 ∈ Ring.carrier(placeCp(p, ι)),
    L(0) = Ring.zero(placeCp(p, ι)) ∧ L(1) = Ring.zero(placeCp(p, ι)) ∧
    taylorVia(p, ι, cmTheta(C)) = cpSeriesExp(p, ι, apply(Ring.neg(cpSeriesRing(p, ι)), L)) ∧
    seriesDerivative(placeCp(p, ι), seriesDerivative(placeCp(p, ι), L)) =
      call2(Ring.add(cpSeriesRing(p, ι)), seriesConstant(placeCp(p, ι), L2),
        taylorVia(p, ι, translatedWp(C))) ∧
    RealLe(placeCpNorm(p, ι)(call2(Ring.mul(placeCp(p, ι)), placeHom(ι)(sqrtNegD(d)), L2)),
      realOne) ∧
    ∀ x, InNormPairClosure(p, ι, x, d) →
      seriesRescale(placeCp(p, ι), fst(x), taylorVia(p, ι, translatedWpDeriv(C))) ∈
        phiSeriesRing(p, ι, C) ∧
      call2(Ring.mul(cpSeriesRing(p, ι)), cpSeriesExp(p, ι, cpSeriesScale(p, ι, snd(x), L)),
        seriesRescale(placeCp(p, ι), fst(x), taylorVia(p, ι, cmTheta(C)))) ∈
        phiSeriesRing(p, ι, C) ∧
      seriesDerivative(placeCp(p, ι), cpSeriesSub(p, ι, cpSeriesScale(p, ι, snd(x), L),
        seriesRescale(placeCp(p, ι), fst(x), L))) ∈ phiSeriesRing(p, ι, C)
proof
  sorry

-- Section: Genus theory
-- The product of two fractional ideals of K: the finite sums Σ aᵢbᵢ.
def idealProductTerms (a b : Set) : Set := { (i, ℂ[a(i) * b(i)]) | i ∈ domain(a) }

def quadIdealMul (𝔞 𝔟 : Set) : Set :=
  { z ∈ complexCarrier | ∃ k ∈ ℕ, ∃ a ∈ functionSpace(k, 𝔞), ∃ b ∈ functionSpace(k, 𝔟),
    z = groupFiniteSum(complexAdditiveGroup, k, idealProductTerms(a, b)) }

-- A principal fractional ideal x𝓞_K, x ∈ K ∖ 0.
predicate QuadPrincipal (d : Nat, 𝔞 : Set) :=
  ∃ x ∈ quadFieldInC(d), x ≠ complexZero ∧ 𝔞 = scaledSet(x, quadIntegers(d))

-- QuadraticZeta.lean, classGroup_sq_bijective (genus theory: the class
-- number of ℚ(√−d) is odd for a prime d ≡ 7 mod 8): an ideal class whose
-- square is trivial is trivial.
theorem QuadFractionalIdeal.principal_of_sq (𝔞 : Set) (d : Nat)
  requires sevenEight : PrimeSevenModEight(d)
  requires ideal : QuadFractionalIdeal(d, 𝔞)
  requires square : QuadPrincipal(d, quadIdealMul(𝔞, 𝔞))
  shows QuadPrincipal(d, 𝔞)
proof
  sorry

-- Section: Chowla–Selberg
-- FormalHeight.lean, CMLattice.chowla_selberg: u is a unit at every
-- p-adic place, and area(C^σ)|σu|² = π e^{γ − Re L′/L(1, χ_K)} 2π/√d for
-- every σ ∈ Aut(ℂ/K) and conjugate C^σ.
predicate ChowlaSelbergUnit (d : Nat, C u : Set) :=
  u ∈ complexCarrier ∧
  (∀ p ∈ ℕ, Prime(p) → ∀ ι ∈ padicPlaces(p),
    padicPlaceNorm(p, ι, u) = realOne) ∧
  (∀ σ ∈ galoisOverK(d), ∀ Cσ, IsGalConjugate(d, σ, C, Cσ) →
    R[cmArea(Cσ) * complexAbs(σ(u)) ^ 2] =
      R[realPi * realExp(chowlaSelbergConst(d)) *
        (2 * realPi / realSqrt(realNat(d)))])

-- FormalHeight.lean, CMLattice.chowla_selberg (Chowla–Selberg formula in
-- logarithmic form): such a unit exists.
theorem ChowlaSelbergUnit.exists (C : Set) (d : Nat)
  requires sevenEight : PrimeSevenModEight(d)
  requires cm : IsCMLattice(d, C)
  shows ∃ u, ChowlaSelbergUnit(d, C, u)
proof
  sorry

-- Section: The height of the formal group
-- FormalHeight.lean, CMLattice.one_le_norm_coeff_translatedWp_nonsplit: if
-- every f ∈ 𝔬[[φ]] has |coefficient of z^{p−1} in f′| < 1, then the
-- coefficient of z^{p−1} in ιξ has norm at least 1, and p does not split in
-- K (χ_K(p) = (p/d) ≠ 1).
theorem translatedWp.coeff_nonsplit (C p ι : Set) (d : Nat)
  requires cm : IsCMLattice(d, C)
  requires sevenEight : PrimeSevenModEight(d)
  requires prime : Prime(p)
  requires place : ι ∈ padicPlaces(p)
  requires small : ∀ f ∈ phiSeriesRing(p, ι, C),
    (placeCpNorm(p, ι)(seriesDerivative(placeCp(p, ι), f)(sub(p, 1))):R) < realOne
  shows RealLe(realOne, placeCpNorm(p, ι)(taylorVia(p, ι, translatedWp(C))(sub(p, 1)))) ∧
    legendreSign(d, integerOfNat(p)) ≠ realOne
proof
  sorry

-- FormalHeight.lean, CMLattice.exists_unit_coeff_degree_le: let Z = X + ⋯
-- with f(Z) integral for f ∈ 𝔬[[φ]], a : Λ → Λ an isogeny of odd degree q,
-- and g integral without constant term with Z(g) = ι(a)Z. Then g has a
-- coefficient of norm 1 in some degree n ≤ q.
theorem formalEndomorphism.unit_coeff (C p ι Z a g : Set) (d q : Nat)
  requires cm : IsCMLattice(d, C)
  requires sevenEight : PrimeSevenModEight(d)
  requires prime : Prime(p)
  requires place : ι ∈ padicPlaces(p)
  requires hZ : Z ∈ powerSeriesCarrier(placeCp(p, ι))
  requires zero : Z(0) = Ring.zero(placeCp(p, ι))
  requires one : Z(1) = Ring.one(placeCp(p, ι))
  requires integralZ : ∀ f ∈ phiSeriesRing(p, ι, C),
    seriesSubst(placeCp(p, ι), f, Z) ∈ integralSeries(p, ι)
  requires isogeny : IsCMIsogeny(C, C, a, q)
  requires odd : q % 2 = (1:N)
  requires hg : g ∈ integralSeries(p, ι)
  requires zeroG : g(0) = Ring.zero(placeCp(p, ι))
  requires endo : seriesSubst(placeCp(p, ι), Z, g) = cpSeriesScale(p, ι, placeHom(ι)(a), Z)
  shows ∃ n ∈ ℕ, n ≤ q ∧ placeCpNorm(p, ι)(g(n)) = realOne
proof
  sorry

end FormalGroup
