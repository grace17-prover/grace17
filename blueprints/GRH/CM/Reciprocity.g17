-- Galois action on the finite Weil representation: the factor σΔ(g)/Δ(g)
-- of a finite unitary point and its square, and a σ-semilinear map of the
-- finite part 𝒲_f intertwining the Heisenberg translations up to a scalar
-- b intertwines the finite Weil representation up to that factor and
-- sends the vacuum to a multiple of a scalar translate of it.
-- Source: grh-compact/src/Lib/CM/Reciprocity/SemilinearWeilLaw.lean
-- (multiplierRatio, multiplierRatio_sq, Space.semilinear_intertwines_weil).
-- Encoding. A point g ∈ G_f acts through the adelic point (1, g), whose
-- infinite components are the identity (finiteToAdelic); Δ = glMultiplier
-- (the source's finMultiplier) for the splitting character υ, and
-- υ(det g) is υ at the idele (1, det g). A σ-semilinear map L of 𝒲_f is a
-- function with L(f + f′) = Lf + Lf′ and L(cf) = σ(c)Lf. Not stated: the
-- last clause of Space.semilinear_intertwines_weil (L on the Schwartz–Bruhat
-- vectors Ψ ⊗ vac above a conjugation-disjoint set R of places), which
-- needs the naming map V.name of Lib/Weil/Lift.
-- Part of the GRH blueprint (layer 4, Lib/CM, stage S4).
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.CM.Reciprocity
import GRH.Weil.Operators

section Reciprocity
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)

-- The adelic point (1, g) of a finite point g.
def finiteToAdelic (W n g : Set) : Set :=
  { (q, (fst(matOne(cmAdeleRing(WeilDatum.field(W), WeilDatum.cmType(W)), n)(q)), g(q))) |
    q ∈ n × n }

-- SemilinearWeilLaw.lean, multiplierRatio σ g = σ(Δ(g))/Δ(g).
def multiplierRatio (W υ n σ g : Set) : Set :=
  complexDiv(σ(glMultiplier(W, υ, n, g)), glMultiplier(W, υ, n, g))

-- υ(det g) at the idele (1, det g).
def upsilonDet (W υ n g : Set) : Set :=
  υ(finIdele(W, matDet(finiteAdeleRing(WeilDatum.field(W)), n, g)))

-- SemilinearWeilLaw.lean, multiplierRatio_sq: (σΔ(g)/Δ(g))² =
-- υ(det g)/σ(υ(det g)) for a ring endomorphism σ of ℂ.
theorem multiplierRatio.sq (W υ n σ g : Set)
  requires splitting : SplittingChar(W, υ)
  requires finite : Finite(n)
  requires hσ : RingHom(σ, complexRing, complexRing)
  requires hg : g ∈ gfMatrices(WeilDatum.field(W), n)
  shows ℂ[multiplierRatio(W, υ, n, σ, g) ^ 2] =
    complexDiv(upsilonDet(W, υ, n, g), σ(upsilonDet(W, υ, n, g)))
proof
  sorry

-- A σ-semilinear map of the finite part of V.
predicate SemilinearOnFinitePart (V σ L : Set) :=
  (L : spaceFinitePart(V) → spaceFinitePart(V)) ∧
  (∀ f ∈ spaceFinitePart(V), ∀ f2 ∈ spaceFinitePart(V),
    L(call2(Module.add(spaceModule(V)), f, f2)) = call2(Module.add(spaceModule(V)), L(f), L(f2))) ∧
  (∀ c ∈ complexCarrier, ∀ f ∈ spaceFinitePart(V),
    L(Module.smul(spaceModule(V))(c, f)) = Module.smul(spaceModule(V))(σ(c), L(f)))

-- b x for b ∈ 𝔸_f and x ∈ 𝔸_fⁿ, the scalar matrix z·1, and ω(g)f.
def finVecScale (W n b x : Set) : Set :=
  { (i, finMul(WeilDatum.field(W), b, x(i))) | i ∈ n }

def finScalarMatrix (W n z : Set) : Set :=
  matScalar(finiteAdeleRing(WeilDatum.field(W)), n, z)

def omegaFin (V υ g f : Set) : Set :=
  dataOmega(ThetaSpace.weil(V), υ, ThetaSpace.rank(V), ThetaSpace.signs(V),
    finiteToAdelic(ThetaSpace.weil(V), ThetaSpace.rank(V), g))(f)

-- SemilinearWeilLaw.lean, Space.semilinear_intertwines_weil (the Galois
-- action on the finite Weil representation): let L be σ-semilinear on 𝒲_f
-- with Lϱ(x) = ϱ(bx)L and σψ₀(z) = ψ₀(b b̄ z). Then b is a unit, and some
-- c and unitary z ∈ 𝔸_f (z z̄ = 1) have L vac = c ω(z·1) vac and
-- Lω(g) = (σΔ(g)/Δ(g)) ω(g) L on 𝒲_f.
theorem semilinear.intertwines_weil (V υ σ L b : Set)
  requires space : IsThetaSpace(V)
  requires splitting : SplittingChar(ThetaSpace.weil(V), υ)
  requires hσ : RingHom(σ, complexRing, complexRing)
  requires semilinear : SemilinearOnFinitePart(V, σ, L)
  requires hb : b ∈ finAdeles(WeilDatum.field(ThetaSpace.weil(V)))
  requires psi : ∀ z ∈ finAdeles(WeilDatum.field(ThetaSpace.weil(V))),
    σ(psiZero(ThetaSpace.weil(V), z)) = psiZero(ThetaSpace.weil(V),
      finMul(WeilDatum.field(ThetaSpace.weil(V)),
        finMul(WeilDatum.field(ThetaSpace.weil(V)), b,
          finStar(WeilDatum.field(ThetaSpace.weil(V)))(b)), z))
  requires heis : ∀ f ∈ spaceFinitePart(V), ∀ x ∈ spaceFinVectors(V),
    L(spaceHeis(V, spaceFinVec(V, x), f)) =
      spaceHeis(V, spaceFinVec(V, finVecScale(ThetaSpace.weil(V), ThetaSpace.rank(V), b, x)), L(f))
  shows b ∈ ringUnits(finiteAdeleRing(WeilDatum.field(ThetaSpace.weil(V)))) ∧
    ∃ c ∈ complexCarrier, ∃ z ∈ finAdeles(WeilDatum.field(ThetaSpace.weil(V))),
      finMul(WeilDatum.field(ThetaSpace.weil(V)), z,
        finStar(WeilDatum.field(ThetaSpace.weil(V)))(z)) =
        finOne(WeilDatum.field(ThetaSpace.weil(V))) ∧
      L(spaceVacuum(V)) = Module.smul(spaceModule(V))(c, omegaFin(V, υ,
        finScalarMatrix(ThetaSpace.weil(V), ThetaSpace.rank(V), z), spaceVacuum(V))) ∧
      ∀ f ∈ spaceFinitePart(V), ∀ g ∈ gfMatrices(WeilDatum.field(ThetaSpace.weil(V)),
          ThetaSpace.rank(V)),
        L(omegaFin(V, υ, g, f)) = Module.smul(spaceModule(V))(
          multiplierRatio(ThetaSpace.weil(V), υ, ThetaSpace.rank(V), σ, g), omegaFin(V, υ, g, L(f)))
proof
  sorry

end Reciprocity
