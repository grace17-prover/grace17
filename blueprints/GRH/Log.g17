-- Logarithms and powers. The natural logarithm on (0, ∞) as the inverse
-- of the real exponential, with its laws; the principal argument in
-- (−π, π] and the principal logarithm on ℂ ∖ {0}, continuous on
-- ℂ ∖ (−∞, 0]; the real power x^σ = e^(σ log x) and the complex power
-- x^s = exp(s log x) for real x > 0 and complex s, with
-- x^(s + t) = x^s x^t, (xy)^s = x^s y^s, and |x^s| = x^(re s); and the
-- powers n^(−s) of the positive integers.
-- Part of the GRH blueprint.
-- Planned home: Complex/Log, Complex/Power.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Log
import GRH.Trig

section Logarithms
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- Section: Definitions
-- log x is the real number whose exponential is x, for x > 0. The value
-- at x ≤ 0 is set to 0, so that realLog is a function ℝ → ℝ; no theorem
-- relies on it.
defunique realLogValue (X : Real) (Y ∈ ℝ) :=
  (R[0] < X ∧ realExp(Y) = X) ∨ (X ≤ R[0] ∧ Y = R[0])
proof
  have split := realLess.trichotomy at R[0], X
  cases split with positive | rest
  . obtain ⟨Y, hY, value⟩ := realExp.onto_positive at X with positive
    refine ⟨Y, hY, ?_⟩
    left
    exact ⟨positive, value⟩
  . have nonpositive : X ≤ R[0]
      cases rest with same | negative
      . linarith
      . linarith
    have zeroReal : R[0] ∈ ℝ by typecheck
    refine ⟨R[0], zeroReal, ?_⟩
    right
    exact ⟨nonpositive, rfl⟩
uniqueness
  intros Y hY first Z hZ second
  have typedY : Real(Y) by typecheck
  have typedZ : Real(Z) by typecheck
  cases first with logY | zeroY
  . obtain ⟨positive, expY⟩ := logY
    cases second with logZ | zeroZ
    . obtain ⟨_, expZ⟩ := logZ
      have same : realExp(Y) = realExp(Z) by cc
      exact realExp.injective with same
    . obtain ⟨nonpositive, _⟩ := zeroZ
      exfalso
      linarith
  . obtain ⟨nonpositive, valueY⟩ := zeroY
    cases second with logZ | zeroZ
    . obtain ⟨positive, _⟩ := logZ
      exfalso
      linarith
    . obtain ⟨_, valueZ⟩ := zeroZ
      cc

defgraph realLog (X ∈ ℝ) : ℝ := realLogValue(X)
proof
  have selected := realLogValue.selected at X
  exact selected.left

-- The principal argument of z ≠ 0 is the θ in (−π, π] with
-- z = |z| (cos θ + i sin θ); the argument of 0 is set to 0.
defunique complexArgValue (z : Set) (θ ∈ ℝ) :=
  (z = ℂ[0] ∧ θ = R[0]) ∨
  (z ≠ ℂ[0] ∧ R[-realPi] < θ ∧ θ ≤ realPi ∧
    complexRe(z) = R[complexAbs(z) * realCos(θ)] ∧
    complexIm(z) = R[complexAbs(z) * realSin(θ)])
requires hz : z ∈ complexCarrier
proof
  have split : z = ℂ[0] ∨ z ≠ ℂ[0] by tauto
  cases split with zero | nonzero
  . have zeroReal : R[0] ∈ ℝ by typecheck
    refine ⟨R[0], zeroReal, ?_⟩
    left
    exact ⟨zero, rfl⟩
  . have positive := complexAbs.positive with hz, nonzero
    have absNonzero : complexAbs(z) ≠ R[0] by linarith
    have inverse := realInvValue.mul_right with absNonzero
    have reReal := complexRe.real with hz
    have imReal := complexIm.real with hz
    have typedRe : Real(complexRe(z)) by typecheck
    have typedIm : Real(complexIm(z)) by typecheck
    have parts := complexNormSquared.parts with hz
    have square := complexAbs.square with hz
    have invReal : realInvValue(complexAbs(z)) ∈ ℝ by typecheck
    have unit : R[complexRe(z) * realInvValue(complexAbs(z)) *
        (complexRe(z) * realInvValue(complexAbs(z))) +
        complexIm(z) * realInvValue(complexAbs(z)) *
        (complexIm(z) * realInvValue(complexAbs(z)))] = R[1] by
      linear_combination (-(realInvValue(complexAbs(z)) *
          realInvValue(complexAbs(z)))) * parts -
        (realInvValue(complexAbs(z)) * realInvValue(complexAbs(z))) * square +
        (complexAbs(z) * realInvValue(complexAbs(z)) + 1) * inverse
    obtain ⟨θ, hθ, lower, upper, cosValue, sinValue⟩ :=
      realCos.unit_circle with unit
    refine ⟨θ, hθ, ?_⟩
    right
    refine ⟨nonzero, lower, upper, ?_, ?_⟩
    . rw cosValue
      linear_combination (-complexRe(z)) * inverse
    . rw sinValue
      linear_combination (-complexIm(z)) * inverse
uniqueness
  intros θ hθ first φ hφ second
  have typedθ : Real(θ) by typecheck
  have typedφ : Real(φ) by typecheck
  cases first with zeroθ | polarθ
  . obtain ⟨zero, valueθ⟩ := zeroθ
    cases second with zeroφ | polarφ
    . obtain ⟨_, valueφ⟩ := zeroφ
      cc
    . obtain ⟨nonzero, _⟩ := polarφ
      exfalso
      exact nonzero with zero
  . obtain ⟨nonzero, lowerθ, upperθ, reθ, imθ⟩ := polarθ
    cases second with zeroφ | polarφ
    . obtain ⟨zero, _⟩ := zeroφ
      exfalso
      exact nonzero with zero
    . obtain ⟨_, lowerφ, upperφ, reφ, imφ⟩ := polarφ
      have positive := complexAbs.positive with hz, nonzero
      have absNonzero : complexAbs(z) ≠ R[0] by linarith
      have inverse := realInvValue.mul_right with absNonzero
      have invReal : realInvValue(complexAbs(z)) ∈ ℝ by typecheck
      have sameCos : realCos(θ) = realCos(φ) by
        linear_combination realInvValue(complexAbs(z)) * (reφ - reθ) +
          (realCos(φ) - realCos(θ)) * inverse
      have sameSin : realSin(θ) = realSin(φ) by
        linear_combination realInvValue(complexAbs(z)) * (imφ - imθ) +
          (realSin(φ) - realSin(θ)) * inverse
      exact realCos.unit_circle_unique with lowerθ, upperθ, lowerφ, upperφ,
        sameCos, sameSin

defgraph complexArg (z ∈ complexCarrier) : ℝ := complexArgValue(z)
proof
  have selected := complexArgValue.selected with member
  exact selected.left

-- The principal logarithm log z = log |z| + i arg z; log 0 = 0.
defgraph complexLog (z ∈ complexCarrier) : complexCarrier :=
    (realLog(complexAbs(z)), complexArg(z))
proof
  have logReal : Real(realLog(complexAbs(z))) by typecheck
  have argReal : Real(complexArg(z)) by typecheck
  exact complexCarrier.pair at realLog(complexAbs(z)), complexArg(z) with
    logReal, argReal

-- The slit plane ℂ ∖ (−∞, 0], where the principal logarithm is continuous
-- and holomorphic.
def slitPlane : Set :=
  { z ∈ complexCarrier | ¬(complexIm(z) = realZero ∧
      complexRe(z) ≤ realZero) }

def complexNonzero : Set := { z ∈ complexCarrier | z ≠ complexZero }

-- The real power x^σ = e^(σ log x), for x > 0 and real σ.
def realRpow (X S : Real) : Real := realExp(R[S * realLog(X)])
proof
  unfold realRpow
  typecheck

-- The complex power x^s = exp(s log x), for x > 0 and complex s, and the
-- map s ↦ x^s.
def realCpow (X s : Set) : Set :=
  complexExp(ℂ[s * complexOfReal(realLog(X))])

defgraph realCpowMap (X : Set) (s ∈ complexCarrier) : complexCarrier :=
    realCpow(X, s)
requires positive : X ∈ positiveReals
proof
  obtain ⟨realX, _⟩ := positiveReals.membership.forward with positive
  have typedX : Real(X) by typecheck
  unfold realCpow
  typecheck

-- Section: The real logarithm
theorem realLog.real (X : Real)
  shows realLog(X) ∈ ℝ
proof
  typecheck

-- At x ≤ 0 the logarithm takes its default value 0.
theorem realLog.nonpositive (X : Real)
  requires nonpositive : X ≤ R[0]
  shows realLog(X) = R[0]
proof
  have xMember : X ∈ ℝ by typecheck
  obtain ⟨_, property⟩ := realLogValue.selected at X
  rw realLog.value with xMember
  cases property with logX | zeroX
  . obtain ⟨positive, _⟩ := logX
    exfalso
    linarith
  . obtain ⟨_, value⟩ := zeroX
    exact value

theorem realLog.exp (X : Real)
  requires positive : R[0] < X
  shows realExp(realLog(X)) = X
proof
  have xMember : X ∈ ℝ by typecheck
  obtain ⟨_, property⟩ := realLogValue.selected at X
  rw realLog.value with xMember
  cases property with logX | zeroX
  . obtain ⟨_, value⟩ := logX
    exact value
  . obtain ⟨nonpositive, _⟩ := zeroX
    exfalso
    linarith

theorem realLog.of_exp (X : Real)
  shows realLog(realExp(X)) = X
proof
  have positive := realExp.positive at X
  have expReal : Real(realExp(X)) by typecheck
  have value := realLog.exp at realExp(X) with positive
  have logReal : Real(realLog(realExp(X))) by typecheck
  exact realExp.injective with value

theorem realLog.one
  shows realLog(R[1]) = R[0]
proof
  rw [← realExp.zero, realLog.of_exp]

theorem realLog.mul (X Y : Real)
  requires positiveX : R[0] < X
  requires positiveY : R[0] < Y
  shows realLog(R[X * Y]) = R[realLog(X) + realLog(Y)]
proof
  have product : R[X * Y] = realExp(R[realLog(X) + realLog(Y)])
    rw [realExp.add, (realLog.exp with positiveX), (realLog.exp with positiveY)]
  rw [product, realLog.of_exp]

theorem realLog.inv (X : Real)
  requires positive : R[0] < X
  shows realLog(R[1 / X]) = R[-realLog(X)]
proof
  have inverse : R[1 / X] = realExp(R[-realLog(X)])
    rw [realExp.neg, (realLog.exp with positive)]
  rw [inverse, realLog.of_exp]

theorem realLog.div (X Y : Real)
  requires positiveX : R[0] < X
  requires positiveY : R[0] < Y
  shows realLog(R[X / Y]) = R[realLog(X) - realLog(Y)]
proof
  have quotient : R[X / Y] = realExp(R[realLog(X) + -realLog(Y)])
    rw [realExp.add, realExp.neg, (realLog.exp with positiveX),
      (realLog.exp with positiveY), realDiv.eq_mul_inv, realDiv.eq_mul_inv]
    ring
  rw [quotient, realLog.of_exp]

theorem realLog.pow (X : Real) (n : Nat)
  requires positive : R[0] < X
  shows realLog(R[X ^ n]) = R[realNat(n) * realLog(X)]
proof
  have power : R[X ^ n] = realExp(R[realNat(n) * realLog(X)])
    rw [realExp.nat_mul, (realLog.exp with positive)]
  rw [power, realLog.of_exp]

theorem realLog.strictly_increasing (X Y : Real)
  requires positive : R[0] < X
  requires less : X < Y
  shows realLog(X) < realLog(Y)
proof
  have positiveY : R[0] < Y by linarith
  by_contra notLess
  have le : realLog(Y) ≤ realLog(X) by linarith
  have monotone := (realExp.le_iff at realLog(Y), realLog(X)).backward with le
  rw [(realLog.exp with positive), (realLog.exp with positiveY)] at monotone
  linarith

theorem realLog.positive_iff (X : Real)
  requires positive : R[0] < X
  shows R[0] < realLog(X) ↔ R[1] < X
proof
  constructor
  . intro logPositive
    have increasing := realExp.strictly_increasing with logPositive
    rw [realExp.zero, (realLog.exp with positive)] at increasing
    exact increasing
  . intro above
    have one : R[0] < R[1] by linarith
    have increasing := realLog.strictly_increasing with one, above
    rwa realLog.one at increasing

theorem realLog.nonnegative (X : Real)
  requires atLeastOne : R[1] ≤ X
  shows R[0] ≤ realLog(X)
proof
  have positive : R[0] < X by linarith
  by_contra negative
  have below : realLog(X) < R[0] by linarith
  have increasing := realExp.strictly_increasing with below
  rw [realExp.zero, (realLog.exp with positive)] at increasing
  linarith

theorem realLog.le_sub_one (X : Real)
  requires positive : R[0] < X
  shows realLog(X) ≤ R[X - 1]
proof
  have bound := realExp.one_add_le at realLog(X)
  rw (realLog.exp with positive) at bound
  linarith

theorem realLog.continuous_at (X : Real)
  requires positive : R[0] < X
  shows ContinuousAt(realLog, X)
proof
  sorry

theorem realLog.derivative (X : Real)
  requires positive : R[0] < X
  shows HasDerivativeAt(realLog, R[1 / X], X)
proof
  sorry

theorem realLog.bijective
  shows BijectiveBetween(restrict(realLog, positiveReals), positiveReals, ℝ)
proof
  sorry

-- Section: The principal argument and logarithm
theorem complexNonzero.member (z : Set)
  shows z ∈ complexNonzero ↔ z ∈ ℂ ∧ z ≠ ℂ[0]
proof
  exact complexNonzero.membership at z

theorem slitPlane.nonzero (z : Set)
  requires hz : z ∈ slitPlane
  shows z ∈ complexNonzero
proof
  obtain ⟨member, notSlit⟩ := slitPlane.membership.forward with hz
  apply complexNonzero.membership.backward
  refine ⟨member, ?_⟩
  intro zero
  apply notSlit
  rw zero
  unfold complexZero
  unfold complexRe
  unfold complexIm
  rw [fst.pair, snd.pair]
  constructor
  . rfl
  . linarith

theorem slitPlane.positive_real (X : Real)
  requires positive : R[0] < X
  shows complexOfReal(X) ∈ slitPlane
proof
  have member : complexOfReal(X) ∈ ℂ by typecheck
  apply slitPlane.membership.backward
  refine ⟨member, ?_⟩
  intro slit
  obtain ⟨_, nonpositive⟩ := slit
  rw complexOfReal.re at nonpositive
  linarith

-- The defining property of the argument, and z = (|z| cos arg z, |z| sin arg z).
theorem complexArg.spec (z : Set)
  requires hz : z ∈ ℂ
  shows (z = ℂ[0] ∧ complexArg(z) = R[0]) ∨ (z ≠ ℂ[0] ∧
    R[-realPi] < complexArg(z) ∧ complexArg(z) ≤ realPi ∧
    complexRe(z) = R[complexAbs(z) * realCos(complexArg(z))] ∧
    complexIm(z) = R[complexAbs(z) * realSin(complexArg(z))])
proof
  obtain ⟨_, property⟩ := complexArgValue.selected with hz
  rw complexArg.value with hz
  exact property

theorem complexArg.coordinates (z : Set)
  requires hz : z ∈ ℂ
  shows z = (R[complexAbs(z) * realCos(complexArg(z))],
    R[complexAbs(z) * realSin(complexArg(z))])
proof
  have spec := complexArg.spec with hz
  cases spec with zeroCase | polar
  . obtain ⟨zero, argZero⟩ := zeroCase
    have absZero := (complexAbs.zero_iff with hz).backward with zero
    rw [argZero, absZero]
    have first : R[0 * realCos(R[0])] = R[0] by ring
    have second : R[0 * realSin(R[0])] = R[0] by ring
    rw [first, second, zero]
    unfold complexZero
    rfl
  . obtain ⟨_, _, _, re, im⟩ := polar
    rw [← re, ← im]
    exact complex.ext with hz

-- r e^(iθ) = (r cos θ, r sin θ), whose modulus is r when r ≥ 0.
theorem complex.polar_form (r θ : Real)
  shows ℂ[complexOfReal(r) *
    complexExp(complexImaginaryUnit * complexOfReal(θ))] =
    (R[r * realCos(θ)], R[r * realSin(θ)])
proof
  have rMember : r ∈ ℝ by typecheck
  have cosReal : realCos(θ) ∈ ℝ by typecheck
  have sinReal : realSin(θ) ∈ ℝ by typecheck
  rw [complexExp.euler, (complexOfReal.value at r with rMember),
    complexMul.pair]
  have first : R[r * realCos(θ) + -(0 * realSin(θ))] = R[r * realCos(θ)]
    by ring
  have second : R[r * realSin(θ) + 0 * realCos(θ)] = R[r * realSin(θ)]
    by ring
  rw [first, second]

theorem complex.polar_abs (z : Set) (r θ : Real)
  requires positive : R[0] < r
  requires shape : z = (R[r * realCos(θ)], R[r * realSin(θ)])
  shows complexAbs(z) = r
proof
  have zMember : z ∈ ℂ
    rw shape
    typecheck
  have square := complexAbs.square with zMember
  have identity := realSin.square_add_cos_square at θ
  rw [shape, complexNormSquared.pair] at square
  have nonnegative := complexAbs.nonnegative with zMember
  have rNonnegative : R[0] ≤ r by linarith
  have squares : R[complexAbs(z) * complexAbs(z)] = R[r * r]
    rw shape
    linear_combination square + (r * r) * identity
  exact realMulValue.eq_of_square_eq with nonnegative, rNonnegative, squares

theorem complexArg.real (z : Set)
  requires hz : z ∈ ℂ
  shows complexArg(z) ∈ ℝ
proof
  typecheck

theorem complexArg.bounds (z : Set)
  requires hz : z ∈ ℂ
  shows R[-realPi] < complexArg(z) ∧ complexArg(z) ≤ realPi
proof
  have spec := complexArg.spec with hz
  have piPositive := realPi.positive
  cases spec with zeroCase | polar
  . obtain ⟨_, argZero⟩ := zeroCase
    rw argZero
    constructor
    . linarith
    . linarith
  . obtain ⟨_, lower, upper, _, _⟩ := polar
    exact ⟨lower, upper⟩

theorem complexArg.zero
  shows complexArg(ℂ[0]) = R[0]
proof
  have zeroMember : ℂ[0] ∈ ℂ by typecheck
  have spec := complexArg.spec with zeroMember
  cases spec with zeroCase | polar
  . obtain ⟨_, argZero⟩ := zeroCase
    exact argZero
  . obtain ⟨nonzero, _⟩ := polar
    exfalso
    exact nonzero with rfl

theorem complexArg.polar (z : Set)
  requires hz : z ∈ ℂ
  shows z = ℂ[complexOfReal(complexAbs(z)) *
    complexExp(complexImaginaryUnit * complexOfReal(complexArg(z)))]
proof
  have coordinates := complexArg.coordinates with hz
  have absReal : complexAbs(z) ∈ ℝ by typecheck
  have argReal : complexArg(z) ∈ ℝ by typecheck
  have cosReal : realCos(complexArg(z)) ∈ ℝ by typecheck
  have sinReal : realSin(complexArg(z)) ∈ ℝ by typecheck
  rw [complexExp.euler, (complexOfReal.value at complexAbs(z) with absReal),
    complexMul.pair]
  have first : R[complexAbs(z) * realCos(complexArg(z)) +
      -(0 * realSin(complexArg(z)))] =
    R[complexAbs(z) * realCos(complexArg(z))] by ring
  have second : R[complexAbs(z) * realSin(complexArg(z)) +
      0 * realCos(complexArg(z))] =
    R[complexAbs(z) * realSin(complexArg(z))] by ring
  rw [first, second]
  exact coordinates

-- The argument is the unique angle in (−π, π] of the polar form.
theorem complexArg.unique (z : Set) (r θ : Real)
  requires positive : R[0] < r
  requires lower : R[-realPi] < θ
  requires upper : θ ≤ realPi
  requires polar : z = ℂ[complexOfReal(r) *
    complexExp(complexImaginaryUnit * complexOfReal(θ))]
  shows complexArg(z) = θ
proof
  have shape := complex.polar_form at r, θ
  rw ← polar at shape
  have zMember : z ∈ ℂ
    rw shape
    typecheck
  have absValue := complex.polar_abs with positive, shape
  have piPositive := realPi.positive
  have nonzero : z ≠ ℂ[0]
    intro zero
    have absZero := (complexAbs.zero_iff with zMember).backward with zero
    linarith
  have reValue : complexRe(z) = R[complexAbs(z) * realCos(θ)]
    rw [absValue, shape]
    unfold complexRe
    rw fst.pair
  have imValue : complexIm(z) = R[complexAbs(z) * realSin(θ)]
    rw [absValue, shape]
    unfold complexIm
    rw snd.pair
  have θMember : θ ∈ ℝ by typecheck
  have property : (z = ℂ[0] ∧ θ = R[0]) ∨ (z ≠ ℂ[0] ∧ R[-realPi] < θ ∧
      θ ≤ realPi ∧ complexRe(z) = R[complexAbs(z) * realCos(θ)] ∧
      complexIm(z) = R[complexAbs(z) * realSin(θ)])
    right
    exact ⟨nonzero, lower, upper, reValue, imValue⟩
  obtain ⟨argMember, argProperty⟩ := complexArgValue.selected with zMember
  have unique := complexArgValue.unique
  have first := unique with z, zMember
  have second := first with complexArgValue(z), argMember, argProperty
  have same := second with θ, θMember, property
  rw complexArg.value with zMember
  exact same

theorem complexArg.positive_real (X : Real)
  requires positive : R[0] < X
  shows complexArg(complexOfReal(X)) = R[0]
proof
  have iMember := complexImaginaryUnit.member
  have xMember : complexOfReal(X) ∈ ℂ by typecheck
  have piPositive := realPi.positive
  have lower : R[-realPi] < R[0] by linarith
  have upper : R[0] ≤ realPi by linarith
  have polar : complexOfReal(X) = ℂ[complexOfReal(X) *
      complexExp(complexImaginaryUnit * complexOfReal(R[0]))]
    have product : ℂ[complexImaginaryUnit * 0] = ℂ[0] by ring
    rw [complexOfReal.zero, product, complexExp.zero]
    ring
  exact complexArg.unique at complexOfReal(X), X, R[0] with positive, lower,
    upper, polar

theorem complexArg.negative_real (X : Real)
  requires negative : X < R[0]
  shows complexArg(complexOfReal(X)) = realPi
proof
  have xMember : complexOfReal(X) ∈ ℂ by typecheck
  have piPositive := realPi.positive
  have positive : R[0] < R[-X] by linarith
  have lower : R[-realPi] < realPi by linarith
  have upper : realPi ≤ realPi by linarith
  have polar : complexOfReal(X) = ℂ[complexOfReal(R[-X]) *
      complexExp(complexImaginaryUnit * complexOfReal(realPi))]
    rw [complexExp.i_pi, complexOfReal.neg]
    ring
  exact complexArg.unique at complexOfReal(X), R[-X], realPi with positive,
    lower, upper, polar

theorem complexArg.slit_bounds (z : Set)
  requires hz : z ∈ slitPlane
  shows R[-realPi] < complexArg(z) ∧ complexArg(z) < realPi
proof
  obtain ⟨member, notSlit⟩ := slitPlane.membership.forward with hz
  obtain ⟨lower, upper⟩ := complexArg.bounds with member
  refine ⟨lower, ?_⟩
  by_contra notBelow
  have same : complexArg(z) = realPi by linarith
  have coordinates := complexArg.coordinates with member
  rw [same, realCos.pi, realSin.pi] at coordinates
  have nonnegative := complexAbs.nonnegative with member
  apply notSlit
  rw coordinates
  unfold complexIm
  unfold complexRe
  rw [fst.pair, snd.pair]
  have negative : R[complexAbs(z) * -1] = R[-complexAbs(z)] by ring
  rw negative
  constructor
  . ring
  . linarith

theorem complexLog.member (z : Set)
  requires hz : z ∈ ℂ
  shows complexLog(z) ∈ ℂ
proof
  typecheck

theorem complexLog.re (z : Set)
  requires hz : z ∈ ℂ
  shows complexRe(complexLog(z)) = realLog(complexAbs(z))
proof
  rw complexLog.value with hz
  unfold complexRe
  rw fst.pair

theorem complexLog.im (z : Set)
  requires hz : z ∈ ℂ
  shows complexIm(complexLog(z)) = complexArg(z)
proof
  rw complexLog.value with hz
  unfold complexIm
  rw snd.pair

theorem complexLog.zero
  shows complexLog(ℂ[0]) = ℂ[0]
proof
  have zeroMember : ℂ[0] ∈ ℂ by typecheck
  have absZero := (complexAbs.zero_iff with zeroMember).backward with rfl
  have nonpositive : R[0] ≤ R[0] by linarith
  rw [complexLog.value with zeroMember, absZero, complexArg.zero,
    (realLog.nonpositive with nonpositive)]
  unfold complexZero
  rfl

theorem complexLog.exp (z : Set)
  requires hz : z ∈ ℂ
  requires nonzero : z ≠ ℂ[0]
  shows complexExp(complexLog(z)) = z
proof
  have logMember : complexLog(z) ∈ ℂ by typecheck
  have positive := complexAbs.positive with hz, nonzero
  rw [complexExp.polar with logMember, complexLog.re with hz,
    complexLog.im with hz, (realLog.exp with positive)]
  symm
  exact complexArg.coordinates with hz

theorem complexLog.of_exp (z : Set)
  requires hz : z ∈ ℂ
  requires lower : R[-realPi] < complexIm(z)
  requires upper : complexIm(z) ≤ realPi
  shows complexLog(complexExp(z)) = z
proof
  have iMember := complexImaginaryUnit.member
  have expMember : complexExp(z) ∈ ℂ by typecheck
  have reReal := complexRe.real with hz
  have imReal := complexIm.real with hz
  have typedRe : Real(complexRe(z)) by typecheck
  have typedIm : Real(complexIm(z)) by typecheck
  have positive := realExp.positive at complexRe(z)
  have modulus := complexExp.abs with hz
  have reMember : complexOfReal(complexRe(z)) ∈ ℂ by typecheck
  have imMember : ℂ[complexImaginaryUnit * complexOfReal(complexIm(z))] ∈ ℂ
    by typecheck
  have polar : complexExp(z) = ℂ[complexOfReal(realExp(complexRe(z))) *
      complexExp(complexImaginaryUnit * complexOfReal(complexIm(z)))]
    have sum := complexExp.add with reMember, imMember
    rw [← complex.re_add_im with hz, complexExp.of_real] at sum
    exact sum
  have argValue := complexArg.unique at complexExp(z), realExp(complexRe(z)),
    complexIm(z) with positive, lower, upper, polar
  rw [complexLog.value with expMember, modulus, realLog.of_exp, argValue]
  symm
  exact complex.ext with hz

theorem complexLog.of_real (X : Real)
  requires positive : R[0] < X
  shows complexLog(complexOfReal(X)) = complexOfReal(realLog(X))
proof
  have xMember : complexOfReal(X) ∈ ℂ by typecheck
  have nonnegative : R[0] ≤ X by linarith
  have logReal : realLog(X) ∈ ℝ by typecheck
  rw [complexLog.value with xMember, complexAbs.of_real,
    (abs.of_nonnegative with nonnegative), (complexArg.positive_real with
    positive), (complexOfReal.value at realLog(X) with logReal)]

theorem complexLog.one
  shows complexLog(ℂ[1]) = ℂ[0]
proof
  have positive : R[0] < R[1] by linarith
  rw [← complexOfReal.one, (complexLog.of_real with positive), realLog.one,
    complexOfReal.zero]

theorem complexLog.continuous_at (z : Set)
  requires hz : z ∈ slitPlane
  shows ComplexContinuousAt(complexLog, z)
proof
  sorry

-- Section: Real powers
theorem realRpow.real (X S : Real)
  shows realRpow(X, S) ∈ ℝ
proof
  sorry

theorem realRpow.positive (X S : Real)
  shows R[0] < realRpow(X, S)
proof
  sorry

theorem realRpow.zero (X : Real)
  shows realRpow(X, R[0]) = R[1]
proof
  sorry

theorem realRpow.one (X : Real)
  requires positive : R[0] < X
  shows realRpow(X, R[1]) = X
proof
  sorry

theorem realRpow.one_base (S : Real)
  shows realRpow(R[1], S) = R[1]
proof
  sorry

theorem realRpow.nat (X : Real) (n : Nat)
  requires positive : R[0] < X
  shows realRpow(X, realNat(n)) = R[X ^ n]
proof
  sorry

theorem realRpow.add (X S T : Real)
  requires positive : R[0] < X
  shows realRpow(X, R[S + T]) = R[realRpow(X, S) * realRpow(X, T)]
proof
  sorry

theorem realRpow.neg (X S : Real)
  requires positive : R[0] < X
  shows realRpow(X, R[-S]) = R[1 / realRpow(X, S)]
proof
  sorry

theorem realRpow.mul_base (X Y S : Real)
  requires positiveX : R[0] < X
  requires positiveY : R[0] < Y
  shows realRpow(R[X * Y], S) = R[realRpow(X, S) * realRpow(Y, S)]
proof
  sorry

theorem realRpow.mul_exponent (X S T : Real)
  requires positive : R[0] < X
  shows realRpow(realRpow(X, S), T) = realRpow(X, R[S * T])
proof
  sorry

theorem realRpow.log (X S : Real)
  requires positive : R[0] < X
  shows realLog(realRpow(X, S)) = R[S * realLog(X)]
proof
  sorry

-- x ↦ x^σ is increasing for σ > 0.
theorem realRpow.lt_of_base (X Y S : Real)
  requires positive : R[0] < X
  requires less : X < Y
  requires exponent : R[0] < S
  shows realRpow(X, S) < realRpow(Y, S)
proof
  sorry

-- σ ↦ x^σ is increasing for x > 1.
theorem realRpow.lt_of_exponent (X S T : Real)
  requires base : R[1] < X
  requires less : S < T
  shows realRpow(X, S) < realRpow(X, T)
proof
  sorry

-- Section: Complex powers of positive reals
theorem realCpow.member (X : Real) (s : Set)
  requires hs : s ∈ ℂ
  shows realCpow(X, s) ∈ ℂ
proof
  sorry

theorem realCpow.nonzero (X : Real) (s : Set)
  requires hs : s ∈ ℂ
  shows realCpow(X, s) ≠ ℂ[0]
proof
  sorry

theorem realCpow.zero (X : Real)
  shows realCpow(X, ℂ[0]) = ℂ[1]
proof
  sorry

theorem realCpow.one (X : Real)
  requires positive : R[0] < X
  shows realCpow(X, ℂ[1]) = complexOfReal(X)
proof
  sorry

theorem realCpow.one_base (s : Set)
  requires hs : s ∈ ℂ
  shows realCpow(R[1], s) = ℂ[1]
proof
  sorry

theorem realCpow.of_real (X S : Real)
  shows realCpow(X, complexOfReal(S)) = complexOfReal(realRpow(X, S))
proof
  sorry

theorem realCpow.nat (X : Real) (n : Nat)
  requires positive : R[0] < X
  shows realCpow(X, complexOfReal(realNat(n))) = ℂ[complexOfReal(X) ^ n]
proof
  sorry

-- x^(s + t) = x^s x^t.
theorem realCpow.add (X : Real) (s t : Set)
  requires hs : s ∈ ℂ
  requires ht : t ∈ ℂ
  shows realCpow(X, ℂ[s + t]) = ℂ[realCpow(X, s) * realCpow(X, t)]
proof
  sorry

theorem realCpow.neg (X : Real) (s : Set)
  requires hs : s ∈ ℂ
  shows realCpow(X, ℂ[-s]) = complexInv(realCpow(X, s))
proof
  sorry

-- (xy)^s = x^s y^s.
theorem realCpow.mul_base (X Y : Real) (s : Set)
  requires positiveX : R[0] < X
  requires positiveY : R[0] < Y
  requires hs : s ∈ ℂ
  shows realCpow(R[X * Y], s) = ℂ[realCpow(X, s) * realCpow(Y, s)]
proof
  sorry

-- (x^σ)^s = x^(σ s) for real σ.
theorem realCpow.rpow_base (X S : Real) (s : Set)
  requires positive : R[0] < X
  requires hs : s ∈ ℂ
  shows realCpow(realRpow(X, S), s) =
    realCpow(X, ℂ[complexOfReal(S) * s])
proof
  sorry

-- |x^s| = x^(re s).
theorem realCpow.abs (X : Real) (s : Set)
  requires positive : R[0] < X
  requires hs : s ∈ ℂ
  shows complexAbs(realCpow(X, s)) = realRpow(X, complexRe(s))
proof
  sorry

theorem realCpow.conj (X : Real) (s : Set)
  requires hs : s ∈ ℂ
  shows complexConj(realCpow(X, s)) = realCpow(X, complexConj(s))
proof
  sorry

-- x^(iθ) lies on the unit circle.
theorem realCpow.i_mul (X θ : Real)
  requires positive : R[0] < X
  shows realCpow(X, ℂ[complexImaginaryUnit * complexOfReal(θ)]) =
    (realCos(R[θ * realLog(X)]), realSin(R[θ * realLog(X)]))
proof
  sorry

theorem realCpowMap.continuous (X : Set)
  requires positive : X ∈ positiveReals
  shows ComplexContinuous(realCpowMap(X))
proof
  sorry

-- Section: The powers n^(−s)
theorem realCpow.nat_neg_abs (n : Nat) (s : Set)
  requires positive : 1 ≤ n
  requires hs : s ∈ ℂ
  shows complexAbs(realCpow(realNat(n), ℂ[-s])) =
    realRpow(realNat(n), R[-complexRe(s)])
proof
  sorry

theorem realCpow.nat_neg_mul (m n : Nat) (s : Set)
  requires positiveM : 1 ≤ m
  requires positiveN : 1 ≤ n
  requires hs : s ∈ ℂ
  shows realCpow(realNat(m * n), ℂ[-s]) =
    ℂ[realCpow(realNat(m), ℂ[-s]) * realCpow(realNat(n), ℂ[-s])]
proof
  sorry

theorem realCpow.nat_neg_one (s : Set)
  requires hs : s ∈ ℂ
  shows realCpow(realNat(1), ℂ[-s]) = ℂ[1]
proof
  sorry

theorem realCpow.nat_neg_nat (m n : Nat)
  requires positive : 1 ≤ n
  shows realCpow(realNat(n), ℂ[-complexOfReal(realNat(m))]) =
    complexOfReal(R[1 / realNat(n) ^ m])
proof
  sorry

-- n^(−σ) ≤ 1 for n ≥ 1 and σ ≥ 0.
theorem realRpow.nat_neg_le_one (n : Nat) (S : Real)
  requires positive : 1 ≤ n
  requires nonnegative : R[0] ≤ S
  shows realRpow(realNat(n), R[-S]) ≤ R[1]
proof
  sorry

end Logarithms
