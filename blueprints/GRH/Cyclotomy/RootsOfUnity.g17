-- Roots of unity and cyclotomic polynomials: the n-th roots of unity of a
-- commutative ring as a subgroup of its units, primitive roots of unity
-- and their powers, the cyclic structure of μ_n in a domain, the count
-- of primitive roots, the vanishing of 1 + ζ + … + ζ^(k−1), existence
-- of primitive roots in algebraically closed and finite fields, the
-- integer cast ℤ → R, and the cyclotomic polynomials Φ_n: defined over
-- ℤ through the primitive n-th roots of unity in ℂ and mapped to every
-- ring, monic of degree φ(n), Π_{d ∣ n} Φ_d = X^n − 1, their roots, and
-- their values at 1.
-- Part of the GRH blueprint.
-- Planned home: Algebra/Field/RootsOfUnity and Algebra/Polynomial/Cyclotomic.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Cyclotomy.RootsOfUnity
import GRH.Field.Finite
import Grace.Cumulus.NumberTheory.Euler
import Grace.Cumulus.Complex.Field

-- Section: Definitions
-- The cast ℤ → R (Int.cast, Int.castRingHom R): m − k ↦ m · 1 − k · 1.
def intCastHom (R : Set) : Set :=
  { u ∈ ℤ × Ring.carrier(R) | ∃ m ∈ ℕ, ∃ k ∈ ℕ,
    fst(u) = integerAddValue(integerOfNat(m), integerNegValue(integerOfNat(k))) ∧
    snd(u) = Ring.sub(R, natCast(R, m), natCast(R, k)) }

-- The n-th roots of unity, as a subset of the units (rootsOfUnity n R,
-- a subgroup of Rˣ).
def rootsOfUnity (R : Set, n : Nat) : Set :=
  { x ∈ ringUnits(R) | Ring.pow(R, x, n) = Ring.one(R) }

-- ζ is a primitive k-th root of unity (IsPrimitiveRoot ζ k): ζ^k = 1 and
-- ζ^l = 1 only for k ∣ l. For k = 0 this says ζ has infinite order, as
-- in Mathlib.
predicate IsPrimitiveRoot (R ζ : Set, k : Nat) :=
  ζ ∈ Ring.carrier(R) ∧ Ring.pow(R, ζ, k) = Ring.one(R) ∧
  (∀ l ∈ ℕ, Ring.pow(R, ζ, l) = Ring.one(R) → k ∣ l)

-- The primitive k-th roots (primitiveRoots k R; empty for k = 0).
def primitiveRoots (R : Set, k : Nat) : Set :=
  { ζ ∈ Ring.carrier(R) | 0 < k ∧ IsPrimitiveRoot(R, ζ, k) }

-- R has enough n-th roots of unity: a primitive one exists and μ_n is
-- cyclic (HasEnoughRootsOfUnity R n).
predicate HasEnoughRootsOfUnity (R : Set, n : Nat) :=
  (∃ ζ ∈ Ring.carrier(R), IsPrimitiveRoot(R, ζ, n)) ∧
  (∃ g ∈ rootsOfUnity(R, n), ∀ x ∈ rootsOfUnity(R, n), ∃ i ∈ ℕ, x = Ring.pow(R, g, i))

-- The family i ↦ ζ^i on k = {0, …, k − 1}, for Σ_{i<k} ζ^i.
def rootPowerFamily (R ζ : Set, k : Nat) : Set := { (i, Ring.pow(R, ζ, i)) | i ∈ k }

-- X^n − 1 over R.
def polyXPowSubOne (R : Set, n : Nat) : Set :=
  Ring.sub(polynomialRing(R, {0}), Ring.pow(polynomialRing(R, {0}), polyX(R), n),
    Ring.one(polynomialRing(R, {0})))

-- The factors X − μ over a set S of points of R.
def linearFactorsOver (R S : Set) : Set := { (μ, polyXSubC(R, μ)) | μ ∈ S }

-- The factors X − ζ over the primitive n-th roots of unity in ℂ.
def complexCyclotomicFactors (n : Nat) : Set :=
  { (ζ, polyXSubC(complexRing, ζ)) | ζ ∈ primitiveRoots(complexRing, n) }

-- Helpers: the integer m − k is the class of (m, k), and intCastHom(R) is
-- the function [(m, k)] ↦ m · 1 − k · 1 on ℤ.
theorem tkJ.intCast.class_eq (m k : Nat)
  shows integerAddValue(integerOfNat(m), integerNegValue(integerOfNat(k))) =
    integerClass(m, k)
proof
  unfold integerOfNat
  rw integerNegValue.classes
  unfold integerClassNeg
  rw integerAddValue.classes
  unfold integerClassSum
  have left := add.right_unit at m
  have right := add.left_unit at k
  rw [left, right]

theorem tkJ.intCast.mem_iff (R z y : Set)
  shows (z, y) ∈ intCastHom(R) ↔ (z ∈ ℤ ∧ y ∈ Ring.carrier(R) ∧
    (∃ m ∈ ℕ, ∃ k ∈ ℕ, z = integerClass(m, k) ∧
      y = Ring.sub(R, natCast(R, m), natCast(R, k))))
proof
  constructor
  . intro h
    obtain ⟨uIn, m, mN, k, kN, e1, e2⟩ := intCastHom.membership.forward with h
    have pm := product.pair_membership at z, y, ℤ, Ring.carrier(R)
    obtain ⟨zIn, yIn⟩ := pm.forward with uIn
    rw fst.pair at e1
    rw snd.pair at e2
    have mNat := nat.omega.backward with mN
    have kNat := nat.omega.backward with kN
    have cl := tkJ.intCast.class_eq at m, k
    rw cl at e1
    exact ⟨zIn, yIn, m, mN, k, kN, e1, e2⟩
  . intro h
    obtain ⟨zIn, yIn, m, mN, k, kN, e1, e2⟩ := h
    have mNat := nat.omega.backward with mN
    have kNat := nat.omega.backward with kN
    have uIn := product.pair at z, y, ℤ, Ring.carrier(R) with zIn, yIn
    apply intCastHom.membership.backward
    have cl := tkJ.intCast.class_eq at m, k
    refine ⟨uIn, m, mN, k, kN, ?_, ?_⟩
    . rw [fst.pair, cl]
      exact e1
    . rw snd.pair
      exact e2

theorem tkJ.intCast.function (R : Set)
  requires comm : CommRing(R)
  shows intCastHom(R) : ℤ → Ring.carrier(R)
proof
  have ringR := CommRing.to_ring with comm
  apply tkJ.fin_graph_function
  . intros u uIn
    obtain ⟨b, _⟩ := intCastHom.membership.forward with uIn
    exact b
  . intros x y z hy hz
    have iy := tkJ.intCast.mem_iff at R, x, y
    obtain ⟨_, _, m, mN, k, kN, e1, e2⟩ := iy.forward with hy
    have iz := tkJ.intCast.mem_iff at R, x, z
    obtain ⟨_, _, m2, m2N, k2, k2N, f1, f2⟩ := iz.forward with hz
    have mNat := nat.omega.backward with mN
    have kNat := nat.omega.backward with kN
    have m2Nat := nat.omega.backward with m2N
    have k2Nat := nat.omega.backward with k2N
    rw e1 at f1
    have eqv := integerClass.equivalent_of_eq at m, k, m2, k2 with f1
    have c1 := tkJ.natCast.add at R, m, k2 with ringR
    have c2 := tkJ.natCast.add at R, m2, k with ringR
    rw eqv at c1
    rw c1 at c2
    have i1 := tkJ.natCast.mem at R, m with ringR
    have i2 := tkJ.natCast.mem at R, k with ringR
    have i3 := tkJ.natCast.mem at R, m2 with ringR
    have i4 := tkJ.natCast.mem at R, k2 with ringR
    rw [e2, f2]
    linear_combination c2
  . intros z zIn
    have zI : Integer(z) by settle with Integer
    obtain ⟨m, mNat, k, kNat, e⟩ := Integer.representatives at z with zI
    have i1 := tkJ.natCast.mem at R, m with ringR
    have i2 := tkJ.natCast.mem at R, k with ringR
    have yIn : Ring.sub(R, natCast(R, m), natCast(R, k)) ∈ Ring.carrier(R) by typecheck
    refine ⟨Ring.sub(R, natCast(R, m), natCast(R, k)), yIn, ?_⟩
    have iff := tkJ.intCast.mem_iff at R, z, Ring.sub(R, natCast(R, m), natCast(R, k))
    apply iff.backward
    have mN : m ∈ ℕ by typecheck
    have kN : k ∈ ℕ by typecheck
    exact ⟨zIn, yIn, m, mN, k, kN, e, rfl⟩

theorem tkJ.intCast.value (R : Set) (m k : Nat)
  requires comm : CommRing(R)
  shows intCastHom(R)(integerClass(m, k)) = Ring.sub(R, natCast(R, m), natCast(R, k))
proof
  have ringR := CommRing.to_ring with comm
  have fun := tkJ.intCast.function at R with comm
  have zI := integerClass.integer at m, k
  have zIn : integerClass(m, k) ∈ ℤ by settle with Integer
  have i1 := tkJ.natCast.mem at R, m with ringR
  have i2 := tkJ.natCast.mem at R, k with ringR
  have yIn : Ring.sub(R, natCast(R, m), natCast(R, k)) ∈ Ring.carrier(R) by typecheck
  have rel : relates(intCastHom(R), integerClass(m, k), Ring.sub(R, natCast(R, m), natCast(R, k)))
    unfold relates
    have iff := tkJ.intCast.mem_iff at R, integerClass(m, k), Ring.sub(R, natCast(R, m), natCast(R, k))
    apply iff.backward
    have mN : m ∈ ℕ by typecheck
    have kN : k ∈ ℕ by typecheck
    exact ⟨zIn, yIn, m, mN, k, kN, rfl, rfl⟩
  exact FunctionBetween.apply_value with fun, zIn, rel

-- Helper: the class of (m, k) is m − k in the bundled ℤ.
theorem tkJ.intCast.class_sub (m k : Nat)
  shows integerClass(m, k) =
    Ring.sub(integerRing, natCast(integerRing, m), natCast(integerRing, k))
proof
  rw [(tkJ.integerRing.natCast at m), (tkJ.integerRing.natCast at k)]
  have mZ : integerOfNat(m) ∈ ℤ by typecheck
  have kZ : integerOfNat(k) ∈ ℤ by typecheck
  rw (tkJ.integerRing.sub_value at integerOfNat(m), integerOfNat(k) with mZ, kZ)
  rw tkJ.intCast.class_eq

theorem tkJ.intCast.hom (R : Set)
  requires comm : CommRing(R)
  shows intCastHom(R) : integerRing →+* R
proof
  have ringR := CommRing.to_ring with comm
  have zr := tkJ.integerRing.comm
  have ringZ := CommRing.to_ring with zr
  have fun := tkJ.intCast.function at R with comm
  have funZ : intCastHom(R) : Ring.carrier(integerRing) → Ring.carrier(R)
    rw tkJ.integerRing.carrier
    exact fun
  have zero : intCastHom(R)(Ring.zero(integerRing)) = Ring.zero(R)
    rw tkJ.integerRing.zero
    unfold integerZero
    rw (tkJ.intCast.value at R, 0, 0 with comm)
    rw tkJ.natCast.zero
    ring
  have one : intCastHom(R)(Ring.one(integerRing)) = Ring.one(R)
    rw tkJ.integerRing.one
    unfold integerOne
    unfold integerOfNat
    rw (tkJ.intCast.value at R, 1, 0 with comm)
    rw [tkJ.natCast.zero, (tkJ.natCast.one at R with ringR)]
    ring
  have neg : ∀ x ∈ Ring.carrier(integerRing), intCastHom(R)(apply(Ring.neg(integerRing), x)) =
      apply(Ring.neg(R), intCastHom(R)(x))
    rw [tkJ.integerRing.carrier, tkJ.integerRing.neg]
    intros x xIn
    have xI : Integer(x) by settle with Integer
    obtain ⟨m, mNat, k, kNat, e⟩ := Integer.representatives at x with xI
    rw (integerNegValue.notation at x)
    rw e
    rw integerNegValue.classes
    unfold integerClassNeg
    rw [(tkJ.intCast.value at R, k, m with comm), (tkJ.intCast.value at R, m, k with comm)]
    have i1 := tkJ.natCast.mem at R, m with ringR
    have i2 := tkJ.natCast.mem at R, k with ringR
    ring
  have add : ∀ x ∈ Ring.carrier(integerRing), ∀ y ∈ Ring.carrier(integerRing),
      intCastHom(R)(call2(Ring.add(integerRing), x, y)) =
        call2(Ring.add(R), intCastHom(R)(x), intCastHom(R)(y))
    rw [tkJ.integerRing.carrier, tkJ.integerRing.add]
    intros x xIn y yIn
    have xI : Integer(x) by settle with Integer
    have yI : Integer(y) by settle with Integer
    rw (integerAddValue.notation at x, y)
    obtain ⟨m, mNat, k, kNat, e⟩ := Integer.representatives at x with xI
    obtain ⟨m2, m2Nat, k2, k2Nat, f⟩ := Integer.representatives at y with yI
    rw [e, f]
    rw integerAddValue.classes
    unfold integerClassSum
    rw [(tkJ.intCast.value at R, m + m2, k + k2 with comm), (tkJ.intCast.value at R, m, k with comm), (tkJ.intCast.value at R, m2, k2 with comm)]
    rw [(tkJ.natCast.add at R, m, m2 with ringR), (tkJ.natCast.add at R, k, k2 with ringR)]
    have i1 := tkJ.natCast.mem at R, m with ringR
    have i2 := tkJ.natCast.mem at R, k with ringR
    have i3 := tkJ.natCast.mem at R, m2 with ringR
    have i4 := tkJ.natCast.mem at R, k2 with ringR
    ring
  have mul : ∀ x ∈ Ring.carrier(integerRing), ∀ y ∈ Ring.carrier(integerRing),
      intCastHom(R)(call2(Ring.mul(integerRing), x, y)) =
        call2(Ring.mul(R), intCastHom(R)(x), intCastHom(R)(y))
    rw [tkJ.integerRing.carrier, tkJ.integerRing.mul]
    intros x xIn y yIn
    have xI : Integer(x) by settle with Integer
    have yI : Integer(y) by settle with Integer
    rw (integerMulValue.notation at x, y)
    obtain ⟨m, mNat, k, kNat, e⟩ := Integer.representatives at x with xI
    obtain ⟨m2, m2Nat, k2, k2Nat, f⟩ := Integer.representatives at y with yI
    rw [e, f]
    rw integerMulValue.classes
    unfold integerClassMul
    rw [(tkJ.intCast.value at R, m * m2 + k * k2, m * k2 + k * m2 with comm), (tkJ.intCast.value at R, m, k with comm), (tkJ.intCast.value at R, m2, k2 with comm)]
    rw [(tkJ.natCast.add at R, m * m2, k * k2 with ringR), (tkJ.natCast.add at R, m * k2, k * m2 with ringR)]
    rw [(tkJ.natCast.mul at R, m, m2 with comm), (tkJ.natCast.mul at R, k, k2 with comm), (tkJ.natCast.mul at R, m, k2 with comm), (tkJ.natCast.mul at R, k, m2 with comm)]
    have i1 := tkJ.natCast.mem at R, m with ringR
    have i2 := tkJ.natCast.mem at R, k with ringR
    have i3 := tkJ.natCast.mem at R, m2 with ringR
    have i4 := tkJ.natCast.mem at R, k2 with ringR
    ring
  unfold RingHom
  exact ⟨ringZ, ringR, funZ, zero, one, neg, add, mul⟩

-- Helpers: n · 1 ≠ 0 in ℂ for n ≥ 1, so the integer cast into ℂ is
-- injective.
theorem tkJ.complex.natCast_lt (a b : Nat)
  requires below : a < b
  shows natCast(complexRing, a) ≠ natCast(complexRing, b)
proof
  have comm := complexRing.comm_ring
  have ringC := CommRing.to_ring with comm
  intro e
  obtain ⟨d, dNat, bd⟩ := Less.exists_add_one at a, b with below
  have bd2 : b = a + (d + 1) by arith
  rw bd2 at e
  rw (tkJ.natCast.add at complexRing, a, d + 1 with ringC) at e
  have i1 := tkJ.natCast.mem at complexRing, a with ringC
  have i2 := tkJ.natCast.mem at complexRing, d + 1 with ringC
  have z : natCast(complexRing, d + 1) = Ring.zero(complexRing)
    linear_combination -1 * e
  have pos : 0 < d + 1 by arith
  have ne := complexNumeral.nonzero at d + 1 with pos
  unfold natCast at z
  rw [complexRing.addOf, complexRing.zeroOf, complexRing.oneOf] at z
  exact ne with z

theorem tkJ.complex.natCast_injective (a b : Nat)
  requires same : natCast(complexRing, a) = natCast(complexRing, b)
  shows a = b
proof
  have tri := Less.trichotomy at a, b with *
  cases tri with lt | rest
  . exfalso
    have ne := tkJ.complex.natCast_lt at a, b with lt
    exact ne with same
  . cases rest with eq | gt
    . exact eq
    . exfalso
      have ne := tkJ.complex.natCast_lt at b, a with gt
      apply ne
      symm
      exact same

theorem tkJ.intCast.complex_injective
  shows InjectiveBetween(intCastHom(complexRing), ℤ, Ring.carrier(complexRing))
proof
  have comm := complexRing.comm_ring
  have ringC := CommRing.to_ring with comm
  have fun := tkJ.intCast.function at complexRing with comm
  apply Injective.of_pointwise with fun
  intros x xIn y yIn e
  have xI : Integer(x) by settle with Integer
  have yI : Integer(y) by settle with Integer
  obtain ⟨m, mNat, k, kNat, ex⟩ := Integer.representatives at x with xI
  obtain ⟨m2, m2Nat, k2, k2Nat, ey⟩ := Integer.representatives at y with yI
  rw [ex, ey] at e
  rw [(tkJ.intCast.value at complexRing, m, k with comm), (tkJ.intCast.value at complexRing, m2, k2 with comm)] at e
  have i1 := tkJ.natCast.mem at complexRing, m with ringC
  have i2 := tkJ.natCast.mem at complexRing, k with ringC
  have i3 := tkJ.natCast.mem at complexRing, m2 with ringC
  have i4 := tkJ.natCast.mem at complexRing, k2 with ringC
  have c1 := tkJ.natCast.add at complexRing, m, k2 with ringC
  have c2 := tkJ.natCast.add at complexRing, m2, k with ringC
  have s : natCast(complexRing, m + k2) = natCast(complexRing, m2 + k)
    rw [c1, c2]
    linear_combination e
  have nat := tkJ.complex.natCast_injective at m + k2, m2 + k with s
  rw [ex, ey]
  apply integerClass.eq
  arith

-- Φ_n over ℤ (Polynomial.cyclotomic n ℤ): the polynomial with integer
-- coefficients whose image in ℂ[X] is Π (X − ζ) over the primitive n-th
-- roots of unity ζ ∈ ℂ, for n ≥ 1. Mathlib chooses the integer
-- polynomial from int_coeff_of_cyclotomic'; here it is the unique one,
-- with no choice. Mathlib's cyclotomic 0 R = 1 is not part of the
-- definition.
defunique cyclotomicInt (n : Nat) (P ∈ uniPolys(integerRing)) :=
  polyMap(integerRing, complexRing, intCastHom(complexRing))(P) =
    finiteRingProduct(primitiveRoots(complexRing, n), uniPolys(complexRing),
      Ring.add(polynomialRing(complexRing, {0})), Ring.zero(polynomialRing(complexRing, {0})),
      Ring.neg(polynomialRing(complexRing, {0})), Ring.mul(polynomialRing(complexRing, {0})),
      Ring.one(polynomialRing(complexRing, {0})), complexCyclotomicFactors(n))
requires positive : 0 < n
proof
  sorry
uniqueness
  intros P hP eP Q hQ eQ
  have zr := tkJ.integerRing.comm
  have polysZ := polynomialRing.comm_ring at integerRing, {0} with zr
  have comm := complexRing.comm_ring
  have hom := tkJ.intCast.hom at complexRing with comm
  have inj := tkJ.intCast.complex_injective
  rw ← tkJ.integerRing.carrier at inj
  have pinj := polyMap.injective at integerRing, complexRing, intCastHom(complexRing) with zr, polysZ, comm, hom, inj
  rw ← eQ at eP
  unfold uniPolys at hP
  unfold uniPolys at hQ
  exact tkJ.injective_apply at polyMap(integerRing, complexRing, intCastHom(complexRing)), Ring.carrier(polynomialRing(integerRing, {0})), Ring.carrier(polynomialRing(complexRing, {0})), P, Q with pinj, hP, hQ, eP

-- Φ_n over a commutative ring R: the image of Φ_n over ℤ
-- (Polynomial.cyclotomic n R = map (Int.castRingHom R) (cyclotomic n ℤ),
-- Polynomial.map_cyclotomic_int).
def cyclotomic (R : Set, n : Nat) : Set :=
  polyMap(integerRing, R, intCastHom(R))(cyclotomicInt(n))

-- The positive divisors of n (Nat.divisors n), and the family d ↦ Φ_d
-- over them.
def positiveDivisors (n : Nat) : Set := { e ∈ ℕ | 0 < e ∧ e ∣ n }

def cyclotomicDivisorFamily (R : Set, n : Nat) : Set :=
  { (d, cyclotomic(R, d)) | d ∈ positiveDivisors(n) }

-- Section: The integer cast
section IntCast
variable (R : Set)
hypothesis comm : CommRing(R)

-- Int.castRingHom: a ring homomorphism, the only one ℤ → R
-- (RingHom.ext_int), and it extends the natural cast (Int.cast_natCast).
theorem intCastHom.hom
  shows intCastHom(R) : integerRing →+* R
proof
  exact tkJ.intCast.hom at R with comm

theorem intCastHom.unique (f : Set)
  requires hom : f : integerRing →+* R
  shows f = intCastHom(R)
proof
  have ringR := CommRing.to_ring with comm
  have zr := tkJ.integerRing.comm
  have ringZ := CommRing.to_ring with zr
  have fun := tkJ.intCast.function at R with comm
  have homCopy := hom
  obtain ⟨_, _, ff, _⟩ := homCopy
  rw tkJ.integerRing.carrier at ff
  have same : ∀ x ∈ ℤ, f(x) = intCastHom(R)(x)
    intros x xIn
    have xI : Integer(x) by settle with Integer
    obtain ⟨m, mNat, k, kNat, e⟩ := Integer.representatives at x with xI
    rw e
    rw (tkJ.intCast.value at R, m, k with comm)
    rw (tkJ.intCast.class_sub at m, k)
    have a := tkJ.natCast.mem at integerRing, m with ringZ
    have b := tkJ.natCast.mem at integerRing, k with ringZ
    rw (RingHom.map_sub at f, integerRing, R, natCast(integerRing, m), natCast(integerRing, k) with hom, a, b)
    rw [(tkJ.hom_natCast at f, integerRing, R, m with hom), (tkJ.hom_natCast at f, integerRing, R, k with hom)]
  exact FunctionBetween.ext with ff, fun, same

theorem intCastHom.nat (n : Nat)
  shows intCastHom(R)(integerOfNat(n)) = natCast(R, n)
proof
  have ringR := CommRing.to_ring with comm
  unfold integerOfNat
  rw (tkJ.intCast.value at R, n, 0 with comm)
  rw tkJ.natCast.zero
  have i1 := tkJ.natCast.mem at R, n with ringR
  ring

-- CharP.intCast_eq_zero_iff: in characteristic n the integer a maps to
-- 0 iff n ∣ a; the cast factors through ZMod n.
theorem intCastHom.eq_zero_iff (a : Set) (n : Nat)
  requires char : CharP(R, n)
  requires integer : a ∈ ℤ
  shows intCastHom(R)(a) = Ring.zero(R) ↔ IntegerDivides(integerOfNat(n), a)
proof
  have ringR := CommRing.to_ring with comm
  have charCopy := char
  obtain ⟨_, charLaw⟩ := charCopy
  have aI : Integer(a) by settle with Integer
  obtain ⟨m, mNat, k, kNat, e⟩ := Integer.representatives at a with aI
  rw e
  rw (tkJ.intCast.value at R, m, k with comm)
  have tot := LessEqual.total at k, m
  cases tot with km | mk
  . obtain ⟨d, dNat, md⟩ := LessEqual.exists_add at k, m with km
    have cls : integerClass(m, k) = integerOfNat(d)
      unfold integerOfNat
      apply integerClass.eq
      rw md
      arith
    rw cls
    rw [md, (tkJ.natCast.add at R, k, d with ringR)]
    have i1 := tkJ.natCast.mem at R, k with ringR
    have i2 := tkJ.natCast.mem at R, d with ringR
    have s : (natCast(R, k) + natCast(R, d)) - natCast(R, k) = natCast(R, d) by ring
    rw s
    have dIn : d ∈ ℕ by typecheck
    have law := charLaw with d, dIn
    have br := IntegerDivides.ofNat_iff at n, d
    constructor
    . intro h
      have dv := law.forward with h
      exact br.backward with dv
    . intro h
      have dv := br.forward with h
      exact law.backward with dv
  . obtain ⟨d, dNat, kd⟩ := LessEqual.exists_add at m, k with mk
    have cls : integerClass(m, k) = integerNegativeOfNat(d)
      unfold integerNegativeOfNat
      apply integerClass.eq
      rw kd
      arith
    rw cls
    rw integerNegativeOfNat.eq_neg
    rw [kd, (tkJ.natCast.add at R, m, d with ringR)]
    have i1 := tkJ.natCast.mem at R, m with ringR
    have i2 := tkJ.natCast.mem at R, d with ringR
    have s : natCast(R, m) - (natCast(R, m) + natCast(R, d)) = -natCast(R, d) by ring
    rw s
    have dIn : d ∈ ℕ by typecheck
    have law := charLaw with d, dIn
    have br := IntegerDivides.ofNat_iff at n, d
    have nb := IntegerDivides.neg_right_iff at integerOfNat(n), integerOfNat(d)
    constructor
    . intro h
      have h2 : natCast(R, d) = R[0]
        have t : natCast(R, d) = -(-natCast(R, d)) by ring
        rw [t, h]
        ring
      have dv := law.forward with h2
      have idv := br.backward with dv
      exact nb.backward with idv
    . intro h
      have idv := nb.forward with h
      have dv := br.forward with idv
      have z := law.backward with dv
      rw z
      ring

-- ZMod.intCast_cast, ZMod.cast: on ZMod n the integer cast is the
-- quotient map.
theorem intCastHom.zmod (n : Nat)
  shows intCastHom(zmod(n)) = zmodCast(n)
proof
  have basics := tkJ.zmod.comm_ring at n
  obtain ⟨zc, hom, _⟩ := basics
  have u := intCastHom.unique at zmod(n), zmodCast(n) with zc, hom
  symm
  exact u

end IntCast

-- Helpers: the residues below m coprime to n as a set, counted by the
-- totient list.
def tkJCoprimeBelow (n m : Nat) : Set := { i ∈ m | gcd(i, n) = 1 }

theorem tkJ.coprimeBelow.card (n m : Nat)
  shows HasCardinality(tkJCoprimeBelow(n, m), length{ℕ}(unitsBelow(n, m)))
proof
  induction m
  | zero =>
    have empty : tkJCoprimeBelow(n, 0) = ∅
      ext x
      constructor
      . intro hx
        obtain ⟨x0, _⟩ := tkJCoprimeBelow.membership.forward with hx
        rw nat.zero at x0
        exact x0
      . intro hx
        exfalso
        exact set.empty with hx
    rw [empty, unitsBelow.zero, length.nil]
    exact HasCardinality.empty_set
  | succ(j) using ih =>
    have si := natural.successor_as_insert at j
    have test : gcd(j, n) = 1 ∨ gcd(j, n) ≠ 1 by tauto
    cases test with cop | notCop
    . have step := unitsBelow.succ_unit at n, j with cop
      rw step
      have jN : j ∈ ℕ by typecheck
      have len := length.cons at ℕ, j, unitsBelow(n, j) with jN
      rw len
      have same : tkJCoprimeBelow(n, succ(j)) = insert(j, tkJCoprimeBelow(n, j))
        ext x
        constructor
        . intro hx
          obtain ⟨xs, xc⟩ := tkJCoprimeBelow.membership.forward with hx
          rw si at xs
          have iff := insert.membership at x, j, j
          have split := iff.forward with xs
          cases split with xj | xIn
          . rw xj
            exact insert.self at j, tkJCoprimeBelow(n, j)
          . have mem : x ∈ tkJCoprimeBelow(n, j)
              apply tkJCoprimeBelow.membership.backward
              exact ⟨xIn, xc⟩
            exact insert.contains with mem
        . intro hx
          have iff := insert.membership at x, j, tkJCoprimeBelow(n, j)
          have split := iff.forward with hx
          cases split with xj | xIn
          . rw xj
            have js : j ∈ succ(j)
              rw si
              exact insert.self at j, j
            apply tkJCoprimeBelow.membership.backward
            exact ⟨js, cop⟩
          . obtain ⟨xj, xc⟩ := tkJCoprimeBelow.membership.forward with xIn
            have xs := membership.into_successor at x, j with xj
            apply tkJCoprimeBelow.membership.backward
            exact ⟨xs, xc⟩
      have fresh : ¬(j ∈ tkJCoprimeBelow(n, j))
        intro h
        obtain ⟨jj, _⟩ := tkJCoprimeBelow.membership.forward with h
        exact membership.irreflexive at j with jj
      rw same
      exact HasCardinality.insert_fresh with ih, fresh
    . have step := unitsBelow.succ_other at n, j with notCop
      rw step
      have same : tkJCoprimeBelow(n, succ(j)) = tkJCoprimeBelow(n, j)
        ext x
        constructor
        . intro hx
          obtain ⟨xs, xc⟩ := tkJCoprimeBelow.membership.forward with hx
          rw si at xs
          have iff := insert.membership at x, j, j
          have split := iff.forward with xs
          cases split with xj | xIn
          . exfalso
            rw xj at xc
            exact notCop with xc
          . apply tkJCoprimeBelow.membership.backward
            exact ⟨xIn, xc⟩
        . intro hx
          obtain ⟨xj, xc⟩ := tkJCoprimeBelow.membership.forward with hx
          have xs := membership.into_successor at x, j with xj
          apply tkJCoprimeBelow.membership.backward
          exact ⟨xs, xc⟩
      rw same
      exact ih

-- Helpers for cyclicity: n = p^e · k with p ∤ k, and when l ∤ m some
-- prime occurs to a higher power in l than in m.
theorem tkJ.nat.prime_split_bounded (p N : Nat)
  requires prime : Prime(p)
  shows ∀ n ∈ ℕ, 0 < n → n ≤ N → ∃ e ∈ ℕ, ∃ k ∈ ℕ, n = p ^ e * k ∧ ¬(p ∣ k)
proof
  have p1 := Prime.greater_than_one with prime
  induction N
  | zero =>
    intros n nIn pos le
    exfalso
    have nNat := nat.omega.backward with nIn
    arith
  | succ(M) using ih =>
    intros n nIn pos le
    have nNat := nat.omega.backward with nIn
    by_cases d : p ∣ n
    . obtain ⟨n1, n1Nat, e1⟩ := d
      have n1pos : 0 < n1
        by_contra z
        have z0 : n1 = 0 by arith
        rw z0 at e1
        rw mul.right_zero at e1
        arith
      obtain ⟨c, cNat, pc⟩ := Less.exists_add_one at 1, p with p1
      have e2 : n = n1 + (n1 + c * n1)
        rw ← e1
        rw pc
        ring
      have le2 : n1 ≤ M by arith
      have n1In : n1 ∈ ℕ by typecheck
      obtain ⟨e, eIn, k, kIn, shape, nd⟩ := ih with n1, n1In, n1pos, le2
      have eNat := nat.omega.backward with eIn
      have kNat := nat.omega.backward with kIn
      have eSIn : e + 1 ∈ ℕ by typecheck
      refine ⟨e + 1, eSIn, k, kIn, ?_, nd⟩
      rw ← e1
      rw shape
      rw pow.add_one
      ring
    . have zIn : 0 ∈ ℕ by typecheck
      refine ⟨0, zIn, n, nIn, ?_, d⟩
      rw pow.zero
      ring

theorem tkJ.nat.prime_split (p n : Nat)
  requires prime : Prime(p)
  requires positive : 0 < n
  shows ∃ e ∈ ℕ, ∃ k ∈ ℕ, n = p ^ e * k ∧ ¬(p ∣ k)
proof
  have h := tkJ.nat.prime_split_bounded at p, n with prime
  have nIn : n ∈ ℕ by typecheck
  have le : n ≤ n by arith
  exact h with n, nIn, positive, le

theorem tkJ.nat.prime_pow_dvd_cancel (p a e : Nat)
  requires prime : Prime(p)
  requires notDivides : ¬(p ∣ a)
  shows ∀ t, Nat(t) → p ^ e ∣ a * t → p ^ e ∣ t
proof
  have p1 := Prime.greater_than_one with prime
  have pNz : p ≠ 0 by arith
  induction e
  | zero =>
    intros t tNat h
    rw pow.zero
    exact one.divides at t
  | succ(k) using ih =>
    intros t tNat h
    have shift := add.right_one at k with *
    rw ← shift at h
    rw ← shift
    rw pow.add_one at h
    rw pow.add_one
    have pk : p ∣ p * p ^ k
      witness p ^ k
      rfl
    have pat := divides.transitive with pk, h
    have split := Prime.divides_mul at p, a, t with prime, pat
    cases split with pa | ptd
    . exfalso
      exact notDivides with pa
    . obtain ⟨t1, t1Nat, tt⟩ := ptd
      rw ← tt at h
      have h2 : p * p ^ k ∣ p * (a * t1)
        have e : a * (p * t1) = p * (a * t1) by ring
        rw ← e
        exact h
      have cancel := divides.mul_cancel_left at p, p ^ k, a * t1 with pNz
      have h3 := cancel.forward with h2
      have r := ih with t1, t1Nat, h3
      rw ← tt
      have back := divides.mul_cancel_left at p, p ^ k, t1 with pNz
      exact back.backward with r

theorem tkJ.nat.prime_dvd_pow (q p e : Nat)
  requires prime : Prime(q)
  shows q ∣ p ^ e → q ∣ p
proof
  induction e
  | zero =>
    intro h
    exfalso
    have q1 := Prime.greater_than_one with prime
    rw pow.zero at h
    have qNat := Prime.natural at q with prime
    have one := divides.one_only at q with qNat, h
    arith
  | succ(k) using ih =>
    intro h
    have shift := add.right_one at k with *
    rw ← shift at h
    rw pow.add_one at h
    have split := Prime.divides_mul at q, p, p ^ k with prime, h
    cases split with a | b
    . exact a
    . exact ih with b

theorem tkJ.nat.coprime_prime_pow (p a e : Nat)
  requires prime : Prime(p)
  requires notDivides : ¬(p ∣ a)
  shows gcd(a, p ^ e) = 1
proof
  have p1 := Prime.greater_than_one with prime
  have dl := gcd.divides_left at a, p ^ e
  have dr := gcd.divides_right at a, p ^ e
  by_contra ne1
  have dNz : gcd(a, p ^ e) ≠ 0
    intro z
    rw z at dr
    have pz := zero.divides_only_zero at p ^ e with dr
    have pp : 0 < p by arith
    have pos := pow.positive at p, e with pp
    arith
  have big : 1 < gcd(a, p ^ e) by arith
  obtain ⟨q, primeQ, qd⟩ := natural.exists_prime_divisor at gcd(a, p ^ e) with big
  have qNat := Prime.natural at q with primeQ
  have qa := divides.transitive with qd, dl
  have qpe := divides.transitive with qd, dr
  have qp0 := tkJ.nat.prime_dvd_pow at q, p, e with primeQ
  have qp := qp0 with qpe
  have same := Prime.divides_prime at q, p with primeQ, prime, qp
  rw same at qa
  exact notDivides with qa

theorem tkJ.nat.bad_prime_bounded (m N : Nat)
  requires positive : 0 < m
  shows ∀ l ∈ ℕ, 0 < l → l ≤ N → ¬(l ∣ m) → ∃ p, Prime(p) ∧ ∃ e ∈ ℕ,
    ∃ f ∈ ℕ, ∃ l0 ∈ ℕ, ∃ m0 ∈ ℕ, l = p ^ e * l0 ∧ m = p ^ f * m0 ∧
      ¬(p ∣ m0) ∧ f < e
proof
  induction N
  | zero =>
    intros l lIn pos le nd
    exfalso
    have lNat := nat.omega.backward with lIn
    arith
  | succ(M) using ih =>
    intros l lIn pos le nd
    have lNat := nat.omega.backward with lIn
    have lBig : 1 < l
      by_contra small
      have one : l = 1 by arith
      apply nd
      rw one
      exact one.divides at m
    obtain ⟨p, prime, pl⟩ := natural.exists_prime_divisor at l with lBig
    have p1 := Prime.greater_than_one with prime
    have pNat := Prime.natural at p with prime
    obtain ⟨e, eIn, l0, l0In, ls, pl0⟩ := tkJ.nat.prime_split at p, l with prime, pos
    obtain ⟨f, fIn, m0, m0In, ms, pm0⟩ := tkJ.nat.prime_split at p, m with prime, positive
    have eNat := nat.omega.backward with eIn
    have fNat := nat.omega.backward with fIn
    have l0Nat := nat.omega.backward with l0In
    have m0Nat := nat.omega.backward with m0In
    have tot := Less.trichotomy at f, e with *
    cases tot with fe | rest
    . exact ⟨p, prime, e, eIn, f, fIn, l0, l0In, m0, m0In, ls, ms, pm0, fe⟩
    . have ef : e ≤ f
        cases rest with same | gt
        . arith
        . arith
      have ePos : 0 < e
        by_contra z
        have e0 : e = 0 by arith
        rw e0 at ls
        rw pow.zero at ls
        have same : l = l0 by rw ls; ring
        rw same at pl
        exact pl0 with pl
      have l0pos : 0 < l0
        by_contra z
        have z0 : l0 = 0 by arith
        rw z0 at ls
        rw mul.right_zero at ls
        arith
      have l0nd : ¬(l0 ∣ m)
        intro l0m
        have pe : p ^ e ∣ m
          have a := divides.pow_of_le at p, e, f with ef
          have b : p ^ f ∣ m
            witness m0
            symm
            exact ms
          exact divides.transitive with a, b
        obtain ⟨t, tNat, mt⟩ := l0m
        rw ← mt at pe
        have pt0 := tkJ.nat.prime_pow_dvd_cancel at p, l0, e with prime, pl0
        have pt := pt0 with t, tNat, pe
        obtain ⟨u, uNat, tu⟩ := pt
        have lm : p ^ e * l0 ∣ m
          witness u
          rw [← mt, ← tu]
          ring
        rw ← ls at lm
        exact nd with lm
      obtain ⟨c, cNat, ec⟩ := Less.exists_add_one at 0, e with ePos
      have ec2 : e = c + 1 by arith
      have big := pow.one_lt at p, c with p1
      rw ← ec2 at big
      have peNat : Nat(p ^ e) by typecheck
      obtain ⟨g, gNat, pg⟩ := Less.exists_add_one at 1, p ^ e with big
      have l0lt : l0 < l
        rw ls
        rw pg
        have t : (1 + g + 1) * l0 = l0 + (l0 + g * l0) by ring
        rw t
        arith
      have le2 : l0 ≤ M by arith
      obtain ⟨q, primeQ, e2, e2In, f2, f2In, l1, l1In, m1, m1In, l0s, ms2, qm1, fe2⟩ := ih with l0, l0In, l0pos, le2, l0nd
      have l1Nat := nat.omega.backward with l1In
      have newIn : p ^ e * l1 ∈ ℕ by typecheck
      have newShape : l = q ^ e2 * (p ^ e * l1)
        rw [ls, l0s]
        ring
      exact ⟨q, primeQ, e2, e2In, f2, f2In, p ^ e * l1, newIn, m1, m1In, newShape, ms2, qm1, fe2⟩

-- The positive exponents e with x^e = 1, for the order of x.
def tkJPowOneSet (R x : Set) : Set :=
  { e ∈ ℕ | 0 < e ∧ Ring.pow(R, x, e) = Ring.one(R) }

-- The gaps n − e for the orders e of elements of μ_n, for a largest order.
def tkJOrderGaps (R : Set, n : Nat) : Set :=
  { k ∈ ℕ | ∃ x ∈ rootsOfUnity(R, n), ∃ e ∈ ℕ, IsPrimitiveRoot(R, x, e) ∧ e + k = n }

-- Section: Roots of unity
section Roots
variable (R : Set)
hypothesis comm : CommRing(R)

-- rootsOfUnity is a subgroup of Rˣ; mem_rootsOfUnity',
-- rootsOfUnity.mkOfPowEq: for n ≥ 1, x ∈ μ_n iff x^n = 1.
theorem rootsOfUnity.subgroup (n : Nat)
  shows Subgroup(rootsOfUnity(R, n), unitGroup(R))
proof
  have fin := Finite.empty
  have ringR := CommRing.to_ring with comm
  have group := unitGroup.group at R, ∅ with comm, fin
  have carrierEq := unitGroup.carrier_eq at R, ∅ with comm, fin
  have oneEq := unitGroup.one_eq at R, ∅ with comm, fin
  have inside : rootsOfUnity(R, n) ⊆ Group.carrier(unitGroup(R))
    rw carrierEq
    intros x hx
    obtain ⟨xIn, _⟩ := rootsOfUnity.membership.forward with hx
    exact xIn
  have oneIn : Group.one(unitGroup(R)) ∈ rootsOfUnity(R, n)
    rw oneEq
    have u := ringUnits.of_unit at R, ∅, R.one with comm, fin, (RingUnit.one at R with comm)
    have p := Ring.one_pow at R, n with ringR
    exact rootsOfUnity.membership.backward at R, n, R.one with ⟨u, p⟩
  have mulIn : ∀ x y ∈ rootsOfUnity(R, n),
      call2(Group.mul(unitGroup(R)), x, y) ∈ rootsOfUnity(R, n)
    intros x hx y hy
    obtain ⟨xu, xp⟩ := rootsOfUnity.membership.forward with hx
    obtain ⟨yu, yp⟩ := rootsOfUnity.membership.forward with hy
    have m := unitGroup.mul_eq at R, ∅, x, y with comm, fin, xu, yu
    rw m
    obtain ⟨xIn, xU⟩ := ringUnits.unit at R, ∅, x with comm, fin, xu
    obtain ⟨yIn, yU⟩ := ringUnits.unit at R, ∅, y with comm, fin, yu
    have u := RingUnit.mul at R, x, y with comm, xU, yU
    have uIn := ringUnits.of_unit at R, ∅, x * y with comm, fin, u
    have p := Ring.mul_pow_comm at R, x, y, n with comm
    rw [xp, yp] at p
    have p2 : (x * y) ^ n = R[1]
      rw p
      ring
    exact rootsOfUnity.membership.backward at R, n, x * y with ⟨uIn, p2⟩
  have invIn : ∀ x ∈ rootsOfUnity(R, n),
      apply(Group.inv(unitGroup(R)), x) ∈ rootsOfUnity(R, n)
    intros x hx
    obtain ⟨xu, xp⟩ := rootsOfUnity.membership.forward with hx
    obtain ⟨xIn, xU⟩ := ringUnits.unit at R, ∅, x with comm, fin, xu
    have values : ∀ a ∈ ringUnits(R), ringInverse(R, a) ∈ ringUnits(R)
      intros a ha
      obtain ⟨_, ua⟩ := ringUnits.unit at R, ∅, a with comm, fin, ha
      have u := RingUnit.inverse at R, ∅, a with comm, fin, ua
      exact ringUnits.of_unit at R, ∅, ringInverse(R, a) with comm, fin, u
    have invEq : Group.inv(unitGroup(R)) = unitInverseMap(R) by simp [unitGroup, Group.mk.inv]
    rw invEq
    have v := unitInverseMap.graph_apply at R, x with values, xu
    rw v
    have iIn := values with x, xu
    have iR := ringInverse.mem at R, x with comm, xU
    have law := ringInverse.mul_right at R, x with comm, xU
    have p := Ring.mul_pow_comm at R, x, ringInverse(R, x), n with comm
    rw law at p
    have one := Ring.one_pow at R, n with ringR
    rw [one, xp] at p
    have q : R[1] * ringInverse(R, x) ^ n = ringInverse(R, x) ^ n by ring
    rw q at p
    have p2 : ringInverse(R, x) ^ n = R[1]
      symm
      exact p
    exact rootsOfUnity.membership.backward at R, n, ringInverse(R, x) with ⟨iIn, p2⟩
  exact ⟨group, inside, oneIn, mulIn, invIn⟩

theorem rootsOfUnity.mem_iff (x : Set) (n : Nat)
  requires positive : 0 < n
  requires member : x ∈ Ring.carrier(R)
  shows x ∈ rootsOfUnity(R, n) ↔ Ring.pow(R, x, n) = Ring.one(R)
proof
  constructor
  . intro h
    obtain ⟨_, eq⟩ := rootsOfUnity.membership.forward with h
    exact eq
  . intro h
    have unit := RingUnit.of_pow_eq_one at R, x, n with comm, member, positive, h
    have unitIn := ringUnits.mem_of_unit at R, x with comm, unit
    exact rootsOfUnity.membership.backward at R, n, x with ⟨unitIn, h⟩

-- IsPrimitiveRoot.pow_eq_one_iff_dvd and uniqueness of the order
-- (IsPrimitiveRoot.unique, IsPrimitiveRoot.eq_orderOf).
theorem IsPrimitiveRoot.pow_eq_one_iff_dvd (ζ : Set) (k l : Nat)
  requires primitive : IsPrimitiveRoot(R, ζ, k)
  shows Ring.pow(R, ζ, l) = Ring.one(R) ↔ k ∣ l
proof
  obtain ⟨zIn, kOne, minimal⟩ := primitive
  constructor
  . intro h
    have lIn : l ∈ ℕ by typecheck
    exact minimal with l, lIn, h
  . intro d
    obtain ⟨m, mNat, eq⟩ := d
    rw ← eq
    have ringR := CommRing.to_ring with comm
    have s := Ring.pow_mul at R, ζ, k, m with ringR
    rw [s, kOne]
    exact Ring.one_pow at R, m with ringR

theorem IsPrimitiveRoot.unique (ζ : Set) (k l : Nat)
  requires first : IsPrimitiveRoot(R, ζ, k)
  requires second : IsPrimitiveRoot(R, ζ, l)
  shows k = l
proof
  have firstCopy := first
  have secondCopy := second
  obtain ⟨_, kOne, kMin⟩ := firstCopy
  obtain ⟨_, lOne, lMin⟩ := secondCopy
  have lIn : l ∈ ℕ by typecheck
  have kIn : k ∈ ℕ by typecheck
  have kl := kMin with l, lIn, lOne
  have lk := lMin with k, kIn, kOne
  exact divides.antisymmetric with kl, lk

-- IsPrimitiveRoot.isUnit, coe_units_iff: a primitive k-th root with
-- k ≥ 1 is a k-th root of unity.
theorem IsPrimitiveRoot.mem_roots (ζ : Set) (k : Nat)
  requires primitive : IsPrimitiveRoot(R, ζ, k)
  requires positive : 0 < k
  shows RingUnit(R, ζ) ∧ ζ ∈ rootsOfUnity(R, k)
proof
  have primitiveCopy := primitive
  obtain ⟨zIn, kOne, _⟩ := primitiveCopy
  have unit := RingUnit.of_pow_eq_one at R, ζ, k with comm, zIn, positive, kOne
  have iff := rootsOfUnity.mem_iff at R, ζ, k with comm, positive, zIn
  have mem := iff.backward with kOne
  exact ⟨unit, mem⟩

-- IsPrimitiveRoot.pow_ne_one_of_pos_of_lt, IsPrimitiveRoot.pow_inj,
-- IsPrimitiveRoot.injOn_pow.
theorem IsPrimitiveRoot.pow_ne_one (ζ : Set) (k l : Nat)
  requires primitive : IsPrimitiveRoot(R, ζ, k)
  requires positive : 0 < l
  requires below : l < k
  shows Ring.pow(R, ζ, l) ≠ Ring.one(R)
proof
  intro h
  have iff := IsPrimitiveRoot.pow_eq_one_iff_dvd at R, ζ, k, l with comm, primitive
  have d := iff.forward with h
  have lNonzero : l ≠ 0 by arith
  have le := divides.le at k, l with d, lNonzero
  arith

theorem tkJ.primitive.pow_inj_lt (ζ : Set) (k i j : Nat)
  requires primitive : IsPrimitiveRoot(R, ζ, k)
  requires first : i < j
  requires second : j < k
  requires equal : Ring.pow(R, ζ, i) = Ring.pow(R, ζ, j)
  shows ⊥
proof
  have ringR := CommRing.to_ring with comm
  have primitiveCopy := primitive
  obtain ⟨zIn, kOne, _⟩ := primitiveCopy
  obtain ⟨d, dNat, jEq⟩ := Less.exists_add_one at i, j with first
  have ik : i ≤ k by arith
  obtain ⟨e, eNat, kEq⟩ := LessEqual.exists_add at i, k with ik
  have jEq2 : j = i + (d + 1) by arith
  rw jEq2 at equal
  have sj := Ring.pow_add at R, ζ, i, d + 1 with ringR
  rw sj at equal
  have sk := Ring.pow_add at R, ζ, i, e with ringR
  rw ← kEq at sk
  rw kOne at sk
  have step : ζ ^ (d + 1) = R[1]
    linear_combination (ζ ^ (d + 1) - R[1]) * sk - ζ ^ e * equal
  have iff := IsPrimitiveRoot.pow_eq_one_iff_dvd at R, ζ, k, d + 1 with comm, primitive
  have dv := iff.forward with step
  have nz : d + 1 ≠ 0 by arith
  have le := divides.le at k, d + 1 with dv, nz
  arith

theorem IsPrimitiveRoot.pow_inj (ζ : Set) (k i j : Nat)
  requires primitive : IsPrimitiveRoot(R, ζ, k)
  requires first : i < k
  requires second : j < k
  requires equal : Ring.pow(R, ζ, i) = Ring.pow(R, ζ, j)
  shows i = j
proof
  have tri := Less.trichotomy at i, j with *
  cases tri with lt | rest
  . exfalso
    exact tkJ.primitive.pow_inj_lt at R, ζ, k, i, j with comm, primitive, lt, second, equal
  . cases rest with same | gt
    . exact same
    . exfalso
      have flipped : Ring.pow(R, ζ, j) = Ring.pow(R, ζ, i) by symm; exact equal
      exact tkJ.primitive.pow_inj_lt at R, ζ, k, j, i with comm, primitive, gt, first, flipped

-- IsPrimitiveRoot.pow_of_coprime, IsPrimitiveRoot.pow_iff_coprime:
-- ζ^i is a primitive k-th root iff gcd(i, k) = 1.
theorem IsPrimitiveRoot.pow_iff_coprime (ζ : Set) (k i : Nat)
  requires primitive : IsPrimitiveRoot(R, ζ, k)
  requires positive : 0 < k
  shows IsPrimitiveRoot(R, Ring.pow(R, ζ, i), k) ↔ gcd(i, k) = 1
proof
  have ringR := CommRing.to_ring with comm
  have primitiveCopy := primitive
  obtain ⟨zIn, kOne, minimal⟩ := primitiveCopy
  have kNz : k ≠ 0 by arith
  constructor
  . intro h
    have hCopy := h
    obtain ⟨_, _, minI⟩ := hCopy
    obtain ⟨a, aNat, ga⟩ := gcd.divides_left at i, k
    obtain ⟨b, bNat, gb⟩ := gcd.divides_right at i, k
    have pb : Ring.pow(R, Ring.pow(R, ζ, i), b) = Ring.one(R)
      have s := Ring.pow_mul at R, ζ, i, b with ringR
      rw ← s
      have e1 : i * b = (gcd(i, k) * a) * b
        rw ga
      have e2 : (gcd(i, k) * a) * b = (gcd(i, k) * b) * a by ring
      have e : i * b = k * a
        rw [e1, e2, gb]
      rw e
      have s2 := Ring.pow_mul at R, ζ, k, a with ringR
      rw [s2, kOne]
      exact Ring.one_pow at R, a with ringR
    have bIn : b ∈ ℕ by typecheck
    have kb := minI with b, bIn, pb
    have bk : b ∣ k
      witness gcd(i, k)
      rw ← gb
      ring
    have same := divides.antisymmetric at k, b with kb, bk
    rw ← same at gb
    have products : k * gcd(i, k) = k * 1
      have c1 : k * gcd(i, k) = gcd(i, k) * k by ring
      rw [c1, gb]
      ring
    exact mul.left_cancel_positive at gcd(i, k), 1, k with kNz, products
  . intro cop
    have pIn : Ring.pow(R, ζ, i) ∈ Ring.carrier(R) by typecheck
    have pk : Ring.pow(R, Ring.pow(R, ζ, i), k) = Ring.one(R)
      have s := Ring.pow_mul at R, ζ, i, k with ringR
      rw ← s
      have e : i * k = k * i by ring
      rw e
      have s2 := Ring.pow_mul at R, ζ, k, i with ringR
      rw [s2, kOne]
      exact Ring.one_pow at R, i with ringR
    have minP : ∀ l ∈ ℕ, Ring.pow(R, Ring.pow(R, ζ, i), l) = Ring.one(R) → k ∣ l
      intros l hl hpow
      have s := Ring.pow_mul at R, ζ, i, l with ringR
      rw ← s at hpow
      have ilIn : i * l ∈ ℕ by typecheck
      have dv := minimal with i * l, ilIn, hpow
      exact coprime.cancel at i, k, l with cop, dv
    exact ⟨pIn, pk, minP⟩

-- IsPrimitiveRoot.pow_of_dvd: for k = d m with d ≥ 1, ζ^d is a primitive
-- m-th root.
theorem IsPrimitiveRoot.pow_of_dvd (ζ : Set) (d m : Nat)
  requires primitive : IsPrimitiveRoot(R, ζ, d * m)
  requires positive : 0 < d
  shows IsPrimitiveRoot(R, Ring.pow(R, ζ, d), m)
proof
  have ringR := CommRing.to_ring with comm
  have primitiveCopy := primitive
  obtain ⟨zIn, kOne, minimal⟩ := primitiveCopy
  have pIn : Ring.pow(R, ζ, d) ∈ Ring.carrier(R) by typecheck
  have split : ∀ l ∈ ℕ, Ring.pow(R, Ring.pow(R, ζ, d), l) = Ring.pow(R, ζ, d * l)
    intros l hl
    have s := Ring.pow_mul at R, ζ, d, l with ringR
    symm
    exact s
  have mIn : m ∈ ℕ by typecheck
  have mOne : Ring.pow(R, Ring.pow(R, ζ, d), m) = Ring.one(R)
    have s := split with m, mIn
    rw s
    exact kOne
  have minR : ∀ l ∈ ℕ, Ring.pow(R, Ring.pow(R, ζ, d), l) = Ring.one(R) → m ∣ l
    intros l hl hpow
    have s := split with l, hl
    rw s at hpow
    have dlIn : d * l ∈ ℕ by typecheck
    have dv := minimal with d * l, dlIn, hpow
    have nz : d ≠ 0 by arith
    have cancel := divides.mul_cancel_left at d, m, l with nz
    exact cancel.forward with dv
  exact ⟨pIn, mOne, minR⟩

-- IsPrimitiveRoot.map_of_injective, IsPrimitiveRoot.of_map_of_injective.
theorem IsPrimitiveRoot.map_iff (S f ζ : Set) (k : Nat)
  requires hom : f : R →+* S
  requires injective : InjectiveBetween(f, Ring.carrier(R), Ring.carrier(S))
  requires member : ζ ∈ Ring.carrier(R)
  shows IsPrimitiveRoot(S, f(ζ), k) ↔ IsPrimitiveRoot(R, ζ, k)
proof
  have oneIn : Ring.one(R) ∈ Ring.carrier(R) by typecheck
  have one := RingHom.map_one with hom
  have fzIn : f(ζ) ∈ Ring.carrier(S) := RingHom.map_mem with hom, member
  have powIff : ∀ l ∈ ℕ, (Ring.pow(S, f(ζ), l) = Ring.one(S) ↔ Ring.pow(R, ζ, l) = Ring.one(R))
    intros l hl
    have mapped := tkJ.hom_pow at f, R, S, ζ, l with hom, member
    constructor
    . intro h
      rw ← mapped at h
      rw ← one at h
      have pIn : Ring.pow(R, ζ, l) ∈ Ring.carrier(R) by typecheck
      exact tkJ.injective_apply at f, Ring.carrier(R), Ring.carrier(S), Ring.pow(R, ζ, l), Ring.one(R) with injective, pIn, oneIn, h
    . intro h
      rw [← mapped, h, one]
  have kIn : k ∈ ℕ by typecheck
  have kIff := powIff with k, kIn
  constructor
  . intro h
    obtain ⟨_, kOne, minimal⟩ := h
    have kR := kIff.forward with kOne
    have minR : ∀ l ∈ ℕ, Ring.pow(R, ζ, l) = Ring.one(R) → k ∣ l
      intros l hl hpow
      have lIff := powIff with l, hl
      have lS := lIff.backward with hpow
      exact minimal with l, hl, lS
    exact ⟨member, kR, minR⟩
  . intro h
    obtain ⟨_, kOne, minimal⟩ := h
    have kS := kIff.backward with kOne
    have minS : ∀ l ∈ ℕ, Ring.pow(S, f(ζ), l) = Ring.one(S) → k ∣ l
      intros l hl hpow
      have lIff := powIff with l, hl
      have lR := lIff.forward with hpow
      exact minimal with l, hl, lR
    exact ⟨fzIn, kS, minS⟩

-- Helper: X^n − 1 for n ≥ 1: a monic polynomial, nonzero of degree n
-- over a nontrivial ring, with value b^n − 1 at b.
theorem tkJ.polyXPowSubOne.facts (N : Nat)
  requires positive : 0 < N
  shows polyXPowSubOne(R, N) ∈ Ring.carrier(polynomialRing(R, {0})) ∧
    PolyMonic(R, polyXPowSubOne(R, N)) ∧
    (Ring.zero(R) ≠ Ring.one(R) →
      polyXPowSubOne(R, N) ≠ Ring.zero(polynomialRing(R, {0})) ∧
      polyNatDegree(R, polyXPowSubOne(R, N)) = N) ∧
    (∀ b ∈ Ring.carrier(R), polyEval(R, polyXPowSubOne(R, N), b) =
      Ring.sub(R, Ring.pow(R, b, N), Ring.one(R)))
proof
  have ring := CommRing.to_ring with comm
  have polys := polynomialRing.comm_ring at R, {0} with comm
  have pr := CommRing.to_ring with polys
  have oK : Ring.one(R) ∈ Ring.carrier(R) by typecheck
  have chom := polyC.hom at R with comm, polys
  have cOne := RingHom.map_one with chom
  have cEq : polyC(R, Ring.one(R)) = Ring.one(polynomialRing(R, {0}))
    unfold polyC
    exact cOne
  have shape : polyXPowSubOne(R, N) = Ring.sub(polynomialRing(R, {0}),
      Ring.pow(polynomialRing(R, {0}), polyX(R), N), polyC(R, Ring.one(R)))
    unfold polyXPowSubOne
    rw cEq
  rw shape
  have nN : N ∈ ℕ by typecheck
  have xIn := polyX.mem at R with comm, polys
  have cIn := polyC.mem at R, Ring.one(R) with comm, polys, oK
  have xq : Ring.pow(polynomialRing(R, {0}), polyX(R), N) ∈ Ring.carrier(polynomialRing(R, {0})) by typecheck
  have fIn : Ring.sub(polynomialRing(R, {0}), Ring.pow(polynomialRing(R, {0}), polyX(R), N), polyC(R, Ring.one(R))) ∈ Ring.carrier(polynomialRing(R, {0})) by typecheck
  have coeff : ∀ k ∈ ℕ, polyCoeff(Ring.sub(polynomialRing(R, {0}), Ring.pow(polynomialRing(R, {0}), polyX(R), N), polyC(R, Ring.one(R))), k) = polyCoeff(Ring.pow(polynomialRing(R, {0}), polyX(R), N), k) - polyCoeff(polyC(R, Ring.one(R)), k)
    intros k hk
    have kNat := nat.omega.backward with hk
    exact uni.coeff_sub at R, Ring.pow(polynomialRing(R, {0}), polyX(R), N), polyC(R, Ring.one(R)), k with comm, polys, xq, cIn
  have top : polyCoeff(Ring.sub(polynomialRing(R, {0}), Ring.pow(polynomialRing(R, {0}), polyX(R), N), polyC(R, Ring.one(R))), N) = Ring.one(R)
    rw (coeff with N, nN)
    rw (uni.X_pow at R, N with comm, polys)
    have en : N = N by rfl
    rw ((uni.term_coeff at R, Ring.one(R), N, N with comm, polys, oK).left with en)
    have n0 : N ≠ 0 by arith
    rw ((polyC.coeff at R, Ring.one(R), N with comm, polys, oK).right with n0)
    ring
  have vanish : ∀ k ∈ ℕ, N < k → polyCoeff(Ring.sub(polynomialRing(R, {0}), Ring.pow(polynomialRing(R, {0}), polyX(R), N), polyC(R, Ring.one(R))), k) = Ring.zero(R)
    intros k hk lt
    have kNat := nat.omega.backward with hk
    rw (coeff with k, hk)
    rw (uni.X_pow at R, N with comm, polys)
    have kn : k ≠ N by arith
    have k0 : k ≠ 0 by arith
    rw ((uni.term_coeff at R, Ring.one(R), N, k with comm, polys, oK).right with kn)
    rw ((polyC.coeff at R, Ring.one(R), k with comm, polys, oK).right with k0)
    ring
  have r := uni.monic_of at R, Ring.sub(polynomialRing(R, {0}), Ring.pow(polynomialRing(R, {0}), polyX(R), N), polyC(R, Ring.one(R))), N with comm, polys, fIn, top, vanish
  obtain ⟨monic, degImp⟩ := r
  have nzImp : Ring.zero(R) ≠ Ring.one(R) → Ring.sub(polynomialRing(R, {0}), Ring.pow(polynomialRing(R, {0}), polyX(R), N), polyC(R, Ring.one(R))) ≠ Ring.zero(polynomialRing(R, {0})) ∧ polyNatDegree(R, Ring.sub(polynomialRing(R, {0}), Ring.pow(polynomialRing(R, {0}), polyX(R), N), polyC(R, Ring.one(R)))) = N
    intro nt
    have deg := degImp with nt
    have nz := PolyMonic.ne_zero at R, Ring.sub(polynomialRing(R, {0}), Ring.pow(polynomialRing(R, {0}), polyX(R), N), polyC(R, Ring.one(R))) with comm, polys, fIn, nt, monic
    exact ⟨nz, deg⟩
  have ev : ∀ b ∈ Ring.carrier(R), polyEval(R, Ring.sub(polynomialRing(R, {0}), Ring.pow(polynomialRing(R, {0}), polyX(R), N), polyC(R, Ring.one(R))), b) = Ring.sub(R, Ring.pow(R, b, N), Ring.one(R))
    intros b bK
    have h := polyEval.hom at R, b with comm, polys, bK
    have e1 := polyEval.X at R, b with comm, polys, bK
    have e2 := polyEval.C at R, Ring.one(R), b with comm, polys, oK, bK
    unfold polyEval at e1
    unfold polyEval at e2
    unfold polyEval
    rw (RingHom.map_sub at evaluationAt(R, {0}, constantFunction({0}, Ring.carrier(R), b)), polynomialRing(R, {0}), R, Ring.pow(polynomialRing(R, {0}), polyX(R), N), polyC(R, Ring.one(R)) with h, xq, cIn)
    rw (tkJ.hom_pow at evaluationAt(R, {0}, constantFunction({0}, Ring.carrier(R), b)), polynomialRing(R, {0}), R, polyX(R), N with h, xIn)
    rw [e1, e2]
  refine ⟨fIn, monic, nzImp, ?_⟩
  intros b hb
  rw shape
  exact ev with b, hb

-- Helper: X^n − 1 evaluated along a ring homomorphism at x is x^n − 1.
theorem tkJ.polyXPowSubOne.eval2 (S f x : Set) (N : Nat)
  requires target : CommRing(S)
  requires hom : f : R →+* S
  requires point : x ∈ Ring.carrier(S)
  shows polyEval2(R, S, f, x, polyXPowSubOne(R, N)) =
    Ring.sub(S, Ring.pow(S, x, N), Ring.one(S))
proof
  have polys := polynomialRing.comm_ring at R, {0} with comm
  have pr := CommRing.to_ring with polys
  have h := polyEval2.hom at R, S, f, x with comm, polys, target, hom, point
  have xIn := polyX.mem at R with comm, polys
  have xq : Ring.pow(polynomialRing(R, {0}), polyX(R), N) ∈ Ring.carrier(polynomialRing(R, {0})) by typecheck
  have oneIn : Ring.one(polynomialRing(R, {0})) ∈ Ring.carrier(polynomialRing(R, {0})) by typecheck
  have eX := polyEval2.X at R, S, f, x with comm, polys, target, hom, point
  unfold polyEval2 at eX
  unfold polyXPowSubOne
  unfold polyEval2
  rw (RingHom.map_sub at evaluationHom(R, S, {0}, f, constantFunction({0}, Ring.carrier(S), x)), polynomialRing(R, {0}), S, Ring.pow(polynomialRing(R, {0}), polyX(R), N), Ring.one(polynomialRing(R, {0})) with h, xq, oneIn)
  rw (tkJ.hom_pow at evaluationHom(R, S, {0}, f, constantFunction({0}, Ring.carrier(S), x)), polynomialRing(R, {0}), S, polyX(R), N with h, xIn)
  rw eX
  rw (RingHom.map_one with h)

-- IsPrimitiveRoot.isIntegral: a root of unity is integral over the base
-- of any algebra containing it.
theorem IsPrimitiveRoot.integral (E ζ : Set) (k : Nat)
  requires algebra : Algebra(E)
  requires ring : Algebra.ring(E) = R
  requires primitive : IsPrimitiveRoot(R, ζ, k)
  requires positive : 0 < k
  shows IntegralElement(E, ζ)
proof
  have base := Algebra.base_comm_ring at E with algebra
  have ringE := Algebra.comm_ring at E with algebra
  have sh := Algebra.structure_hom at E with algebra
  have primitiveCopy := primitive
  obtain ⟨zIn, kOne, _⟩ := primitiveCopy
  have zE : ζ ∈ Ring.carrier(Algebra.ring(E))
    rw ring
    exact zIn
  have pt : ζ ∈ algebraCarrier(E)
    unfold algebraCarrier
    exact zE
  have facts := tkJ.polyXPowSubOne.facts at Algebra.base(E), k with base, positive
  obtain ⟨pIn, monic, _, _⟩ := facts
  have ev := tkJ.polyXPowSubOne.eval2 at Algebra.base(E), Algebra.ring(E), Algebra.map(E), ζ, k with base, ringE, sh, zE
  have value : polyAeval(E, ζ, polyXPowSubOne(Algebra.base(E), k)) = Ring.zero(Algebra.ring(E))
    unfold polyAeval
    rw ev
    rw ring
    rw kOne
    ring
  unfold IntegralElement
  refine ⟨algebra, pt, polyXPowSubOne(Algebra.base(E), k), monic, value⟩

-- Section: Roots of unity in a domain
-- card_rootsOfUnity: μ_n has at most n elements; it is cyclic
-- (rootsOfUnity.isCyclic).
theorem rootsOfUnity.card_le (n : Nat)
  requires domain : IntegralDomain(R)
  requires positive : 0 < n
  shows Finite(rootsOfUnity(R, n)) ∧ cardinality(rootsOfUnity(R, n)) ≤ n
proof
  have dom := domain
  obtain ⟨_, nt, _⟩ := dom
  have facts := tkJ.polyXPowSubOne.facts at R, n with comm, positive
  obtain ⟨fIn, _, nzImp, ev⟩ := facts
  obtain ⟨nz, deg⟩ := nzImp with nt
  have polys := polynomialRing.comm_ring at R, {0} with comm
  have sub : rootsOfUnity(R, n) ⊆ polyRootSet(R, polyXPowSubOne(R, n))
    intros x hx
    obtain ⟨xu, xp⟩ := rootsOfUnity.membership.forward with hx
    obtain ⟨xIn, _⟩ := ringUnits.membership.forward with xu
    apply polyRootSet.membership.backward
    refine ⟨xIn, ?_⟩
    rw (ev with x, xIn)
    rw xp
    ring
  have finRoots := polyRootSet.finite at R, polyXPowSubOne(R, n) with domain, polys, fIn, nz
  have fin := Finite.subset at rootsOfUnity(R, n), polyRootSet(R, polyXPowSubOne(R, n)) with finRoots, sub
  have hc := cardinality.correct with fin
  have le := polyRootSet.card_le at R, polyXPowSubOne(R, n), rootsOfUnity(R, n), cardinality(rootsOfUnity(R, n)) with domain, polys, fIn, nz, sub, hc
  rw deg at le
  exact ⟨fin, le⟩

-- Helpers for cyclicity: an element with x^n = 1 has an order e ≤ n, and
-- elements of coprime orders m and l multiply to one of order m l.
theorem tkJ.order.exists (x : Set) (n : Nat)
  requires member : x ∈ Ring.carrier(R)
  requires positive : 0 < n
  requires root : Ring.pow(R, x, n) = Ring.one(R)
  shows ∃ e ∈ ℕ, 0 < e ∧ e ≤ n ∧ IsPrimitiveRoot(R, x, e)
proof
  have ringR := CommRing.to_ring with comm
  have nN : n ∈ ℕ by typecheck
  have nIn : n ∈ tkJPowOneSet(R, x)
    apply tkJPowOneSet.membership.backward
    exact ⟨nN, positive, root⟩
  have inhabited : Nonempty(tkJPowOneSet(R, x)) := ⟨n, nIn⟩
  have naturals : tkJPowOneSet(R, x) ⊆ ℕ
    intros e he
    obtain ⟨eN, _⟩ := tkJPowOneSet.membership.forward with he
    exact eN
  have least := leastNatural.member at tkJPowOneSet(R, x) with inhabited, naturals
  obtain ⟨e0N, e0pos, e0one⟩ := tkJPowOneSet.membership.forward with least
  have e0Nat := nat.omega.backward with e0N
  have le := leastNatural.least at tkJPowOneSet(R, x), n with inhabited, naturals, nIn
  have minimal : ∀ l ∈ ℕ, Ring.pow(R, x, l) = Ring.one(R) → leastNatural(tkJPowOneSet(R, x)) ∣ l
    intros l lIn hl
    have lNat := nat.omega.backward with lIn
    have nz : leastNatural(tkJPowOneSet(R, x)) ≠ 0 by arith
    obtain ⟨q, qNat, lq⟩ := mod.equation at l, leastNatural(tkJPowOneSet(R, x)) with nz
    have rlt := mod.less at l, leastNatural(tkJPowOneSet(R, x)) with nz
    have rNat : Nat(l % leastNatural(tkJPowOneSet(R, x))) by typecheck
    have split := Ring.pow_add at R, x, leastNatural(tkJPowOneSet(R, x)) * q, l % leastNatural(tkJPowOneSet(R, x)) with ringR, member
    rw ← lq at split
    rw (Ring.pow_mul at R, x, leastNatural(tkJPowOneSet(R, x)), q with ringR, member) at split
    rw [e0one, (Ring.one_pow at R, q with ringR), hl] at split
    have rIn : Ring.pow(R, x, l % leastNatural(tkJPowOneSet(R, x))) ∈ R.carrier by typecheck
    have rOne : Ring.pow(R, x, l % leastNatural(tkJPowOneSet(R, x))) = R[1]
      have t : R[1] * Ring.pow(R, x, l % leastNatural(tkJPowOneSet(R, x))) = Ring.pow(R, x, l % leastNatural(tkJPowOneSet(R, x))) by ring
      rw t at split
      symm
      exact split
    have rZero : l % leastNatural(tkJPowOneSet(R, x)) = 0
      by_contra rnz
      have rpos : 0 < l % leastNatural(tkJPowOneSet(R, x)) by arith
      have rN : l % leastNatural(tkJPowOneSet(R, x)) ∈ ℕ by typecheck
      have rS : l % leastNatural(tkJPowOneSet(R, x)) ∈ tkJPowOneSet(R, x)
        apply tkJPowOneSet.membership.backward
        exact ⟨rN, rpos, rOne⟩
      have le2 := leastNatural.least at tkJPowOneSet(R, x), l % leastNatural(tkJPowOneSet(R, x)) with inhabited, naturals, rS
      arith
    rw rZero at lq
    witness q
    rw lq
    ring
  have prim : IsPrimitiveRoot(R, x, leastNatural(tkJPowOneSet(R, x)))
    exact ⟨member, e0one, minimal⟩
  exact ⟨leastNatural(tkJPowOneSet(R, x)), e0N, e0pos, le, prim⟩

theorem tkJ.primitive.mul_coprime (a b : Set) (m l : Nat)
  requires first : IsPrimitiveRoot(R, a, m)
  requires second : IsPrimitiveRoot(R, b, l)
  requires coprime : gcd(m, l) = 1
  shows IsPrimitiveRoot(R, a * b, m * l)
proof
  have ringR := CommRing.to_ring with comm
  have fc := first
  obtain ⟨aIn, aOne, aMin⟩ := fc
  have sc := second
  obtain ⟨bIn, bOne, bMin⟩ := sc
  have abIn : a * b ∈ R.carrier by typecheck
  have aPow : ∀ t ∈ ℕ, Ring.pow(R, a, m * t) = R[1]
    intros t tIn
    have tNat := nat.omega.backward with tIn
    rw (Ring.pow_mul at R, a, m, t with ringR, aIn)
    rw aOne
    exact Ring.one_pow at R, t with ringR
  have bPow : ∀ t ∈ ℕ, Ring.pow(R, b, l * t) = R[1]
    intros t tIn
    have tNat := nat.omega.backward with tIn
    rw (Ring.pow_mul at R, b, l, t with ringR, bIn)
    rw bOne
    exact Ring.one_pow at R, t with ringR
  have mIn : m ∈ ℕ by typecheck
  have lIn : l ∈ ℕ by typecheck
  have one : Ring.pow(R, a * b, m * l) = R[1]
    rw (Ring.mul_pow_comm at R, a, b, m * l with comm)
    have e : m * l = l * m by ring
    rw (aPow with l, lIn)
    rw e
    rw (bPow with m, mIn)
    ring
  have minimal : ∀ t ∈ ℕ, Ring.pow(R, a * b, t) = R[1] → m * l ∣ t
    intros t tIn ht
    have tNat := nat.omega.backward with tIn
    have bt : Ring.pow(R, b, m * t) = R[1]
      have s := Ring.pow_mul at R, a * b, t, m with ringR, abIn
      rw [ht, (Ring.one_pow at R, m with ringR)] at s
      have e : t * m = m * t by ring
      rw e at s
      rw (Ring.mul_pow_comm at R, a, b, m * t with comm) at s
      rw (aPow with t, tIn) at s
      have bIn2 : Ring.pow(R, b, m * t) ∈ R.carrier by typecheck
      have u : R[1] * Ring.pow(R, b, m * t) = Ring.pow(R, b, m * t) by ring
      rw u at s
      exact s
    have at2 : Ring.pow(R, a, l * t) = R[1]
      have s := Ring.pow_mul at R, a * b, t, l with ringR, abIn
      rw [ht, (Ring.one_pow at R, l with ringR)] at s
      have e : t * l = l * t by ring
      rw e at s
      rw (Ring.mul_pow_comm at R, a, b, l * t with comm) at s
      rw (bPow with t, tIn) at s
      have aIn2 : Ring.pow(R, a, l * t) ∈ R.carrier by typecheck
      have u : Ring.pow(R, a, l * t) * R[1] = Ring.pow(R, a, l * t) by ring
      rw u at s
      exact s
    have mtIn : m * t ∈ ℕ by typecheck
    have ltIn : l * t ∈ ℕ by typecheck
    have ldiv := bMin with m * t, mtIn, bt
    have mdiv := aMin with l * t, ltIn, at2
    have lt := coprime.cancel at m, l, t with coprime, ldiv
    have cop2 : gcd(l, m) = 1
      rw (gcd.commutative at l, m)
      exact coprime
    have mt := coprime.cancel at l, m, t with cop2, mdiv
    obtain ⟨u, uNat, tu⟩ := mt
    rw ← tu at lt
    have lu := coprime.cancel at m, l, u with coprime, lt
    obtain ⟨v, vNat, uv⟩ := lu
    witness v
    rw [← tu, ← uv]
    ring
  exact ⟨abIn, one, minimal⟩

theorem tkJ.roots.max_order (n : Nat)
  requires domain : IntegralDomain(R)
  requires positive : 0 < n
  shows ∃ a ∈ rootsOfUnity(R, n), ∃ m ∈ ℕ, 0 < m ∧ IsPrimitiveRoot(R, a, m) ∧
    (∀ x ∈ rootsOfUnity(R, n), ∀ e ∈ ℕ, IsPrimitiveRoot(R, x, e) → e ≤ m)
proof
  have ringR := CommRing.to_ring with comm
  have oneIn : R[1] ∈ R.carrier by typecheck
  have onePow := Ring.one_pow at R, n with ringR
  have oneRoots : R[1] ∈ rootsOfUnity(R, n)
    have iff := rootsOfUnity.mem_iff at R, R[1], n with comm, positive, oneIn
    exact iff.backward with onePow
  have onePrim : IsPrimitiveRoot(R, R[1], 1)
    have p1 := Ring.pow_one at R, R[1] with ringR, oneIn
    have every : ∀ l ∈ ℕ, Ring.pow(R, R[1], l) = R[1] → 1 ∣ l
      intros l lIn h
      have lNat := nat.omega.backward with lIn
      exact one.divides at l
    exact ⟨oneIn, p1, every⟩
  obtain ⟨c, cNat, nc⟩ := Less.exists_add_one at 0, n with positive
  have cIn : c ∈ ℕ by typecheck
  have oneN : 1 ∈ ℕ by typecheck
  have cGap : c ∈ tkJOrderGaps(R, n)
    apply tkJOrderGaps.membership.backward
    have e : 1 + c = n by arith
    exact ⟨cIn, R[1], oneRoots, 1, oneN, onePrim, e⟩
  have inhabited : Nonempty(tkJOrderGaps(R, n)) := ⟨c, cGap⟩
  have naturals : tkJOrderGaps(R, n) ⊆ ℕ
    intros k hk
    obtain ⟨kN, _⟩ := tkJOrderGaps.membership.forward with hk
    exact kN
  have least := leastNatural.member at tkJOrderGaps(R, n) with inhabited, naturals
  obtain ⟨k0N, a, aIn, m, mIn, aPrim, mk⟩ := tkJOrderGaps.membership.forward with least
  have mNat := nat.omega.backward with mIn
  have k0Nat := nat.omega.backward with k0N
  have mPos : 0 < m
    by_contra z
    have m0 : m = 0 by arith
    rw m0 at aPrim
    obtain ⟨_, _, aMin⟩ := aPrim
    obtain ⟨_, ap⟩ := rootsOfUnity.membership.forward with aIn
    have nIn : n ∈ ℕ by typecheck
    have zd := aMin with n, nIn, ap
    have nz := zero.divides_only_zero at n with zd
    arith
  have maximal : ∀ x ∈ rootsOfUnity(R, n), ∀ e ∈ ℕ, IsPrimitiveRoot(R, x, e) → e ≤ m
    intros x hx e eIn xPrim
    have eNat := nat.omega.backward with eIn
    obtain ⟨_, xp⟩ := rootsOfUnity.membership.forward with hx
    have iff := IsPrimitiveRoot.pow_eq_one_iff_dvd at R, x, e, n with comm, xPrim
    have en := iff.forward with xp
    have nNz : n ≠ 0 by arith
    have le := divides.le at e, n with en, nNz
    obtain ⟨k, kNat, nk⟩ := LessEqual.exists_add at e, n with le
    have kIn : k ∈ ℕ by typecheck
    have kGap : k ∈ tkJOrderGaps(R, n)
      apply tkJOrderGaps.membership.backward
      have e2 : e + k = n by arith
      exact ⟨kIn, x, hx, e, eIn, xPrim, e2⟩
    have le2 := leastNatural.least at tkJOrderGaps(R, n), k with inhabited, naturals, kGap
    arith
  exact ⟨a, aIn, m, mIn, mPos, aPrim, maximal⟩

-- Helpers: the family i ↦ ζ^i.
theorem tkJ.rootPowerFamily.function (ζ : Set) (k : Nat)
  requires member : ζ ∈ Ring.carrier(R)
  shows rootPowerFamily(R, ζ, k) : k → Ring.carrier(R)
proof
  have ringR := CommRing.to_ring with comm
  apply tkJ.fin_graph_function
  . intros u uIn
    obtain ⟨i, iIn, e⟩ := rootPowerFamily.membership.forward with uIn
    have iNat := natural.member at k with iIn
    have pIn : Ring.pow(R, ζ, i) ∈ Ring.carrier(R) := Ring.pow_mem at R, ζ, i with ringR, member
    rw ← e
    exact product.pair with iIn, pIn
  . intros x y z hy hz
    obtain ⟨a, aIn, ea⟩ := rootPowerFamily.membership.forward with hy
    obtain ⟨b, bIn, eb⟩ := rootPowerFamily.membership.forward with hz
    obtain ⟨xa, ya⟩ := orderedPair.injective with ea
    obtain ⟨xb, zb⟩ := orderedPair.injective with eb
    rw [← ya, ← zb, xa, xb]
  . intros i iIn
    have iNat := natural.member at k with iIn
    have pIn : Ring.pow(R, ζ, i) ∈ Ring.carrier(R) := Ring.pow_mem at R, ζ, i with ringR, member
    refine ⟨Ring.pow(R, ζ, i), pIn, ?_⟩
    apply rootPowerFamily.membership.backward
    exact ⟨i, iIn, rfl⟩

theorem tkJ.rootPowerFamily.apply (ζ : Set) (k i : Nat)
  requires member : ζ ∈ Ring.carrier(R)
  requires index : i ∈ k
  shows rootPowerFamily(R, ζ, k)(i) = Ring.pow(R, ζ, i)
proof
  have fun := tkJ.rootPowerFamily.function at R, ζ, k with comm, member
  have rel : relates(rootPowerFamily(R, ζ, k), i, Ring.pow(R, ζ, i))
    unfold relates
    apply rootPowerFamily.membership.backward
    exact ⟨i, index, rfl⟩
  exact FunctionBetween.apply_value with fun, index, rel

-- Helper: for a primitive k-th root ζ in a domain, i ↦ ζ^i maps k onto
-- μ_k, which has exactly k elements.
theorem tkJ.primitive.powers_onto (ζ : Set) (k : Nat)
  requires domain : IntegralDomain(R)
  requires primitive : IsPrimitiveRoot(R, ζ, k)
  requires positive : 0 < k
  shows functionImage(rootPowerFamily(R, ζ, k), k, rootsOfUnity(R, k)) = rootsOfUnity(R, k) ∧
    cardinality(rootsOfUnity(R, k)) = k ∧ Finite(rootsOfUnity(R, k))
proof
  have ringR := CommRing.to_ring with comm
  have primitiveCopy := primitive
  obtain ⟨zIn, kOne, _⟩ := primitiveCopy
  have fun := tkJ.rootPowerFamily.function at R, ζ, k with comm, zIn
  have inRoots : ∀ i ∈ k, rootPowerFamily(R, ζ, k)(i) ∈ rootsOfUnity(R, k)
    intros i hi
    have iNat := natural.member at k with hi
    have val := tkJ.rootPowerFamily.apply at R, ζ, k, i with comm, zIn, hi
    rw val
    have pIn : Ring.pow(R, ζ, i) ∈ Ring.carrier(R) by typecheck
    have iff := rootsOfUnity.mem_iff at R, Ring.pow(R, ζ, i), k with comm, positive, pIn
    apply iff.backward
    have s := Ring.pow_mul at R, ζ, i, k with ringR
    rw ← s
    have e : i * k = k * i by ring
    rw e
    have s2 := Ring.pow_mul at R, ζ, k, i with ringR
    rw [s2, kOne]
    exact Ring.one_pow at R, i with ringR
  have fun2 := FunctionBetween.codomain_of_values with fun, inRoots
  have inj : InjectiveBetween(rootPowerFamily(R, ζ, k), k, rootsOfUnity(R, k))
    apply Injective.of_pointwise with fun2
    intros i hi j hj e
    have iNat := natural.member at k with hi
    have jNat := natural.member at k with hj
    rw (tkJ.rootPowerFamily.apply at R, ζ, k, i with comm, zIn, hi) at e
    rw (tkJ.rootPowerFamily.apply at R, ζ, k, j with comm, zIn, hj) at e
    have il := Less.of_membership at i, k
    have ilt := il with hi
    have jl := Less.of_membership at j, k
    have jlt := jl with hj
    exact IsPrimitiveRoot.pow_inj at R, ζ, k, i, j with comm, primitive, ilt, jlt, e
  have finK := Finite.natural at k
  have self : k ⊆ k := Subset.reflexive at k
  have cardImg := cardinality.injective_image at rootPowerFamily(R, ζ, k), k, rootsOfUnity(R, k), k with inj, self, finK
  have cardK := cardinality.natural at k
  have bound := rootsOfUnity.card_le at R, k with comm, domain, positive
  obtain ⟨finR, le⟩ := bound
  have sub := functionImage.subset at rootPowerFamily(R, ζ, k), k, rootsOfUnity(R, k)
  have mono := cardinality.monotone at functionImage(rootPowerFamily(R, ζ, k), k, rootsOfUnity(R, k)), rootsOfUnity(R, k) with finR, sub
  rw [cardImg, cardK] at mono
  have cNat := cardinality.nat with finR
  have cardR : cardinality(rootsOfUnity(R, k)) = k by arith
  have same : cardinality(functionImage(rootPowerFamily(R, ζ, k), k, rootsOfUnity(R, k))) = cardinality(rootsOfUnity(R, k))
    rw [cardImg, cardK, cardR]
  have eq := cardinality.eq_subset at functionImage(rootPowerFamily(R, ζ, k), k, rootsOfUnity(R, k)), rootsOfUnity(R, k) with finR, sub, same
  exact ⟨eq, cardR, finR⟩

-- IsPrimitiveRoot.eq_pow_of_pow_eq_one, IsPrimitiveRoot.zpowers_eq,
-- IsPrimitiveRoot.nthRoots_eq: the k-th roots of unity are the powers
-- ζ^i, i < k, of a primitive one.
theorem IsPrimitiveRoot.eq_pow_of_pow_eq_one (ζ ξ : Set) (k : Nat)
  requires domain : IntegralDomain(R)
  requires primitive : IsPrimitiveRoot(R, ζ, k)
  requires positive : 0 < k
  requires member : ξ ∈ Ring.carrier(R)
  requires root : Ring.pow(R, ξ, k) = Ring.one(R)
  shows ∃ i ∈ ℕ, i < k ∧ ξ = Ring.pow(R, ζ, i)
proof
  have onto := tkJ.primitive.powers_onto at R, ζ, k with comm, domain, primitive, positive
  obtain ⟨img, _, _⟩ := onto
  have iff := rootsOfUnity.mem_iff at R, ξ, k with comm, positive, member
  have xiIn := iff.backward with root
  rw ← img at xiIn
  obtain ⟨_, i, iIn, e⟩ := functionImage.membership.forward with xiIn
  have primitiveCopy := primitive
  obtain ⟨zIn, _, _⟩ := primitiveCopy
  have iNat := natural.member at k with iIn
  rw (tkJ.rootPowerFamily.apply at R, ζ, k, i with comm, zIn, iIn) at e
  have il := Less.of_membership at i, k
  have ilt := il with iIn
  have iN : i ∈ ℕ by typecheck
  exact ⟨i, iN, ilt, e⟩

-- rootsOfUnity.isCyclic: μ_n is cyclic in a domain.
theorem rootsOfUnity.cyclic (n : Nat)
  requires domain : IntegralDomain(R)
  requires positive : 0 < n
  shows ∃ g ∈ rootsOfUnity(R, n), ∀ x ∈ rootsOfUnity(R, n), ∃ i ∈ ℕ,
    x = Ring.pow(R, g, i)
proof
  have ringR := CommRing.to_ring with comm
  obtain ⟨a, aIn, m, mIn, mPos, aPrim, maxm⟩ := tkJ.roots.max_order at R, n with comm, domain, positive
  have mNat := nat.omega.backward with mIn
  have aCopy := aPrim
  obtain ⟨aR, aOne, _⟩ := aCopy
  have powRoot : ∀ y ∈ rootsOfUnity(R, n), ∀ i ∈ ℕ, Ring.pow(R, y, i) ∈ rootsOfUnity(R, n)
    intros y hy i iIn
    have iNat := nat.omega.backward with iIn
    obtain ⟨yu, yp⟩ := rootsOfUnity.membership.forward with hy
    obtain ⟨yR, _⟩ := ringUnits.membership.forward with yu
    have pIn : Ring.pow(R, y, i) ∈ R.carrier by typecheck
    have iff := rootsOfUnity.mem_iff at R, Ring.pow(R, y, i), n with comm, positive, pIn
    apply iff.backward
    rw ← (Ring.pow_mul at R, y, i, n with ringR, yR)
    have e : i * n = n * i by ring
    rw e
    rw (Ring.pow_mul at R, y, n, i with ringR, yR)
    rw yp
    exact Ring.one_pow at R, i with ringR
  have mulRoot : ∀ y ∈ rootsOfUnity(R, n), ∀ z ∈ rootsOfUnity(R, n), y * z ∈ rootsOfUnity(R, n)
    intros y hy z hz
    obtain ⟨yu, yp⟩ := rootsOfUnity.membership.forward with hy
    obtain ⟨yR, _⟩ := ringUnits.membership.forward with yu
    obtain ⟨zu, zp⟩ := rootsOfUnity.membership.forward with hz
    obtain ⟨zR, _⟩ := ringUnits.membership.forward with zu
    have pIn : y * z ∈ R.carrier by typecheck
    have iff := rootsOfUnity.mem_iff at R, y * z, n with comm, positive, pIn
    apply iff.backward
    rw (Ring.mul_pow_comm at R, y, z, n with comm)
    rw [yp, zp]
    ring
  have all : ∀ x ∈ rootsOfUnity(R, n), Ring.pow(R, x, m) = R[1]
    intros x hx
    obtain ⟨xu, xp⟩ := rootsOfUnity.membership.forward with hx
    obtain ⟨xR, _⟩ := ringUnits.membership.forward with xu
    obtain ⟨l, lIn, lPos, _, xPrim⟩ := tkJ.order.exists at R, x, n with comm, xR, positive, xp
    have lNat := nat.omega.backward with lIn
    by_cases dv : l ∣ m
    . have iff := IsPrimitiveRoot.pow_eq_one_iff_dvd at R, x, l, m with comm, xPrim
      exact iff.backward with dv
    . exfalso
      have bp := tkJ.nat.bad_prime_bounded at m, l with mPos
      have lle : l ≤ l by arith
      obtain ⟨p, prime, e, eIn, f, fIn, l0, l0In, m0, m0In, ls, ms, pm0, fe⟩ := bp with l, lIn, lPos, lle, dv
      have pNat := Prime.natural at p with prime
      have p1 := Prime.greater_than_one with prime
      have eNat := nat.omega.backward with eIn
      have fNat := nat.omega.backward with fIn
      have l0Nat := nat.omega.backward with l0In
      have m0Nat := nat.omega.backward with m0In
      have pp : 0 < p by arith
      have pfPos := pow.positive at p, f with pp
      have m0Pos : 0 < m0
        by_contra z
        have z0 : m0 = 0 by arith
        rw z0 at ms
        rw mul.right_zero at ms
        arith
      have l0Pos : 0 < l0
        by_contra z
        have z0 : l0 = 0 by arith
        rw z0 at ls
        rw mul.right_zero at ls
        arith
      have aPrim2 := aPrim
      rw ms at aPrim2
      have aPow := IsPrimitiveRoot.pow_of_dvd at R, a, p ^ f, m0 with comm, aPrim2, pfPos
      have xPrim2 := xPrim
      have lswap : l = l0 * p ^ e
        rw ls
        ring
      rw lswap at xPrim2
      have xPow := IsPrimitiveRoot.pow_of_dvd at R, x, l0, p ^ e with comm, xPrim2, l0Pos
      have cop := tkJ.nat.coprime_prime_pow at p, m0, e with prime, pm0
      have prod := tkJ.primitive.mul_coprime at R, Ring.pow(R, a, p ^ f), Ring.pow(R, x, l0), m0, p ^ e with comm, aPow, xPow, cop
      have pfIn : p ^ f ∈ ℕ by typecheck
      have l0In2 : l0 ∈ ℕ by typecheck
      have ap := powRoot with a, aIn, p ^ f, pfIn
      have xpw := powRoot with x, hx, l0, l0In2
      have cIn := mulRoot with Ring.pow(R, a, p ^ f), ap, Ring.pow(R, x, l0), xpw
      have mpIn : m0 * p ^ e ∈ ℕ by typecheck
      have bound := maxm with Ring.pow(R, a, p ^ f) * Ring.pow(R, x, l0), cIn, m0 * p ^ e, mpIn, prod
      have strict := pow.exponent_strict at p, f, e with p1, fe
      obtain ⟨g, gNat, pg⟩ := Less.exists_add_one at p ^ f, p ^ e with strict
      rw pg at bound
      rw ms at bound
      have t : m0 * (p ^ f + g + 1) = p ^ f * m0 + (m0 * g + m0) by ring
      rw t at bound
      arith
  have gen : ∀ x ∈ rootsOfUnity(R, n), ∃ i ∈ ℕ, x = Ring.pow(R, a, i)
    intros x hx
    obtain ⟨xu, _⟩ := rootsOfUnity.membership.forward with hx
    obtain ⟨xR, _⟩ := ringUnits.membership.forward with xu
    have xm := all with x, hx
    obtain ⟨i, iN, _, e⟩ := IsPrimitiveRoot.eq_pow_of_pow_eq_one at R, a, x, m with comm, domain, aPrim, mPos, xR, xm
    exact ⟨i, iN, e⟩
  exact ⟨a, aIn, gen⟩

-- With a primitive k-th root, μ_k has exactly k elements and R has
-- enough k-th roots (HasEnoughRootsOfUnity.natCard_rootsOfUnity,
-- IsPrimitiveRoot.card_rootsOfUnity).
theorem IsPrimitiveRoot.card_roots (ζ : Set) (k : Nat)
  requires domain : IntegralDomain(R)
  requires primitive : IsPrimitiveRoot(R, ζ, k)
  requires positive : 0 < k
  shows HasCardinality(rootsOfUnity(R, k), k) ∧ HasEnoughRootsOfUnity(R, k)
proof
  have onto := tkJ.primitive.powers_onto at R, ζ, k with comm, domain, primitive, positive
  obtain ⟨img, cardR, finR⟩ := onto
  have hc := cardinality.correct with finR
  rw cardR at hc
  have primitiveCopy := primitive
  obtain ⟨zIn, kOne, _⟩ := primitiveCopy
  have mr := IsPrimitiveRoot.mem_roots at R, ζ, k with comm, primitive, positive
  obtain ⟨_, zRoots⟩ := mr
  have gen : ∀ x ∈ rootsOfUnity(R, k), ∃ i ∈ ℕ, x = Ring.pow(R, ζ, i)
    intros x hx
    obtain ⟨xu, xp⟩ := rootsOfUnity.membership.forward with hx
    obtain ⟨xIn, _⟩ := ringUnits.membership.forward with xu
    obtain ⟨i, iN, _, e⟩ := IsPrimitiveRoot.eq_pow_of_pow_eq_one at R, ζ, x, k with comm, domain, primitive, positive, xIn, xp
    exact ⟨i, iN, e⟩
  have enough : HasEnoughRootsOfUnity(R, k)
    unfold HasEnoughRootsOfUnity
    exact ⟨⟨ζ, zIn, primitive⟩, ⟨ζ, zRoots, gen⟩⟩
  exact ⟨hc, enough⟩

-- Helper: i ↦ ζ^i is injective on k.
theorem tkJ.primitive.powers_inj (ζ : Set) (k : Nat)
  requires primitive : IsPrimitiveRoot(R, ζ, k)
  shows InjectiveBetween(rootPowerFamily(R, ζ, k), k, Ring.carrier(R))
proof
  have primitiveCopy := primitive
  obtain ⟨zIn, _, _⟩ := primitiveCopy
  have fun := tkJ.rootPowerFamily.function at R, ζ, k with comm, zIn
  apply Injective.of_pointwise with fun
  intros i hi j hj e
  have iNat := natural.member at k with hi
  have jNat := natural.member at k with hj
  rw (tkJ.rootPowerFamily.apply at R, ζ, k, i with comm, zIn, hi) at e
  rw (tkJ.rootPowerFamily.apply at R, ζ, k, j with comm, zIn, hj) at e
  have il := Less.of_membership at i, k
  have ilt := il with hi
  have jl := Less.of_membership at j, k
  have jlt := jl with hj
  exact IsPrimitiveRoot.pow_inj at R, ζ, k, i, j with comm, primitive, ilt, jlt, e

-- IsPrimitiveRoot.card_primitiveRoots: φ(k) primitive k-th roots.
theorem IsPrimitiveRoot.card_primitiveRoots (ζ : Set) (k : Nat)
  requires domain : IntegralDomain(R)
  requires primitive : IsPrimitiveRoot(R, ζ, k)
  requires positive : 0 < k
  shows HasCardinality(primitiveRoots(R, k), totient(k))
proof
  have primitiveCopy := primitive
  obtain ⟨zIn, kOne, _⟩ := primitiveCopy
  have inj := tkJ.primitive.powers_inj at R, ζ, k with comm, primitive
  have fun := tkJ.rootPowerFamily.function at R, ζ, k with comm, zIn
  have cSub : tkJCoprimeBelow(k, k) ⊆ k
    intros i hi
    obtain ⟨ik, _⟩ := tkJCoprimeBelow.membership.forward with hi
    exact ik
  have cCount := tkJ.coprimeBelow.card at k, k
  have cFin := Finite.from_cardinality with cCount
  have cardImg := cardinality.injective_image at rootPowerFamily(R, ζ, k), k, Ring.carrier(R), tkJCoprimeBelow(k, k) with inj, cSub, cFin
  have cardC := cardinality.eq_of_has with cCount
  have same : functionImage(rootPowerFamily(R, ζ, k), tkJCoprimeBelow(k, k), Ring.carrier(R)) = primitiveRoots(R, k)
    ext y
    constructor
    . intro hy
      obtain ⟨yIn, i, iC, e⟩ := functionImage.membership.forward with hy
      obtain ⟨ik, cop⟩ := tkJCoprimeBelow.membership.forward with iC
      have iNat := natural.member at k with ik
      rw (tkJ.rootPowerFamily.apply at R, ζ, k, i with comm, zIn, ik) at e
      have iff := IsPrimitiveRoot.pow_iff_coprime at R, ζ, k, i with comm, primitive, positive
      have prim := iff.backward with cop
      rw ← e at prim
      exact primitiveRoots.membership.backward at R, k, y with ⟨yIn, positive, prim⟩
    . intro hy
      obtain ⟨yIn, _, prim⟩ := primitiveRoots.membership.forward with hy
      have primCopy := prim
      obtain ⟨_, yOne, _⟩ := primCopy
      obtain ⟨i, iN, ilt, e⟩ := IsPrimitiveRoot.eq_pow_of_pow_eq_one at R, ζ, y, k with comm, domain, primitive, positive, yIn, yOne
      have iNat : Nat(i) by typecheck
      have back := membership.of_Less at i, k with *
      have ik := back with ilt
      rw e at prim
      have iff := IsPrimitiveRoot.pow_iff_coprime at R, ζ, k, i with comm, primitive, positive
      have cop := iff.forward with prim
      have iC : i ∈ tkJCoprimeBelow(k, k)
        apply tkJCoprimeBelow.membership.backward
        exact ⟨ik, cop⟩
      have val := tkJ.rootPowerFamily.apply at R, ζ, k, i with comm, zIn, ik
      rw ← val at e
      exact functionImage.membership.backward at rootPowerFamily(R, ζ, k), tkJCoprimeBelow(k, k), Ring.carrier(R), y with ⟨yIn, i, iC, e⟩
  have onto := tkJ.primitive.powers_onto at R, ζ, k with comm, domain, primitive, positive
  obtain ⟨_, _, finR⟩ := onto
  have pSub : primitiveRoots(R, k) ⊆ rootsOfUnity(R, k)
    intros y hy
    obtain ⟨yIn, _, prim⟩ := primitiveRoots.membership.forward with hy
    have mr := IsPrimitiveRoot.mem_roots at R, y, k with comm, prim, positive
    exact mr.right
  have pFin := Finite.subset at primitiveRoots(R, k), rootsOfUnity(R, k) with finR, pSub
  have hc := cardinality.correct with pFin
  rw [← same, cardImg, cardC] at hc
  unfold totient
  rw ← same
  exact hc

-- Helper: the geometric sum (ζ − 1) Σ_{i<j} ζ^i = ζ^j − 1.
theorem tkJ.geom.indexed (ζ : Set) (k j : Nat)
  requires member : ζ ∈ Ring.carrier(R)
  shows j ≤ k → (ζ - R[1]) * indexedRingSum(rootPowerFamily(R, ζ, k), identity(k),
    Ring.add(R), Ring.zero(R), j) = ζ ^ j - R[1]
proof
  have ringR := CommRing.to_ring with comm
  have parts := CommRing.parts with comm
  have weights := tkJ.rootPowerFamily.function at R, ζ, k with comm, member
  induction j
  | zero =>
    intro le
    simp [indexedRingSum]
    have z := Ring.pow_zero at R, ζ with ringR
    rw z
    ring
  | succ(i) using ih =>
    intro le
    have le2 : i ≤ k by arith
    have prev := ih with le2
    have lt : i < k by arith
    have iIn := membership.of_Less at i, k with *
    have iMem := iIn with lt
    have idv := identity.apply at i, k with iMem
    have val := tkJ.rootPowerFamily.apply at R, ζ, k, i with comm, member, iMem
    simp [indexedRingSum]
    have shift := add.right_one at i with *
    rw ← shift
    have ps := Ring.pow_succ at R, ζ, i with ringR
    rw ps
    have values : WeightedValues(rootPowerFamily(R, ζ, k), identity(k), Ring.carrier(R), i)
      unfold WeightedValues
      intros x hx
      have xNat := natural.member at i with hx
      have xl := Less.of_membership at x, i
      have xlt := xl with hx
      have xk : x < k by arith
      have back := membership.of_Less at x, k with *
      have xIn := back with xk
      have idx := identity.apply at x, k with xIn
      rw idx
      exact FunctionBetween.apply_closed with weights, xIn
    have sIn := indexedRingSum.closed at Ring.carrier(R), Ring.add(R), Ring.zero(R), Ring.neg(R), Ring.mul(R), Ring.one(R), rootPowerFamily(R, ζ, k), identity(k), i with parts
    have sMem := sIn with values
    linear_combination prev

-- IsPrimitiveRoot.geom_sum_eq_zero: Σ_{i<k} ζ^i = 0 for k > 1.
theorem IsPrimitiveRoot.geom_sum_eq_zero (ζ : Set) (k : Nat)
  requires domain : IntegralDomain(R)
  requires primitive : IsPrimitiveRoot(R, ζ, k)
  requires large : 1 < k
  shows finiteRingSum(k, Ring.carrier(R), Ring.add(R), Ring.zero(R), Ring.neg(R),
    Ring.mul(R), Ring.one(R), rootPowerFamily(R, ζ, k)) = Ring.zero(R)
proof
  have ringR := CommRing.to_ring with comm
  have parts := CommRing.parts with comm
  have primitiveCopy := primitive
  obtain ⟨zIn, kOne, _⟩ := primitiveCopy
  have weights := tkJ.rootPowerFamily.function at R, ζ, k with comm, zIn
  have bij := identity.bijective at k
  have enum := finiteRingSum.enumeration at k, Ring.carrier(R), Ring.add(R), Ring.zero(R), Ring.neg(R), Ring.mul(R), Ring.one(R), rootPowerFamily(R, ζ, k), identity(k), k with parts, weights, bij
  rw enum
  have le : k ≤ k by arith
  have geo := tkJ.geom.indexed at R, ζ, k, k with comm, zIn
  have g := geo with le
  rw kOne at g
  have sIn : indexedRingSum(rootPowerFamily(R, ζ, k), identity(k), Ring.add(R), Ring.zero(R), k) ∈ Ring.carrier(R)
    rw ← enum
    exact finiteRingSum.closed with parts, (Finite.natural at k), weights
  have pos : 0 < 1 by arith
  have ne := IsPrimitiveRoot.pow_ne_one at R, ζ, k, 1 with comm, primitive, pos, large
  have p1 := Ring.pow_one at R, ζ with ringR
  rw p1 at ne
  have dIn : ζ - R[1] ∈ R.carrier by typecheck
  have prod : (ζ - R[1]) * indexedRingSum(rootPowerFamily(R, ζ, k), identity(k), Ring.add(R), Ring.zero(R), k) = R[0]
    rw g
    ring
  have iff := IntegralDomain.mul_eq_zero at R, ζ - R[1], indexedRingSum(rootPowerFamily(R, ζ, k), identity(k), Ring.add(R), Ring.zero(R), k) with domain, dIn, sIn
  have split := iff.forward with prod
  cases split with a | b
  . exfalso
    apply ne
    have back : ζ = (ζ - R[1]) + R[1] by ring
    rw [back, a]
    ring
  . exact b

-- IsPrimitiveRoot.eq_neg_one_of_two_right: a primitive square root of 1
-- is −1.
theorem IsPrimitiveRoot.eq_neg_one (ζ : Set)
  requires domain : IntegralDomain(R)
  requires primitive : IsPrimitiveRoot(R, ζ, 2)
  shows ζ = apply(Ring.neg(R), Ring.one(R))
proof
  have ringR := CommRing.to_ring with comm
  have primitiveCopy := primitive
  obtain ⟨zIn, two, _⟩ := primitiveCopy
  have pos : 0 < 1 by arith
  have lt : 1 < 2 by arith
  have ne := IsPrimitiveRoot.pow_ne_one at R, ζ, 2, 1 with comm, primitive, pos, lt
  have p1 := Ring.pow_one at R, ζ with ringR
  rw p1 at ne
  have prod : (ζ - R[1]) * (ζ + R[1]) = R[0]
    have expand : (ζ - R[1]) * (ζ + R[1]) = ζ ^ 2 - R[1] by ring
    rw [expand, two]
    ring
  have z1In : ζ - R[1] ∈ R.carrier by typecheck
  have z2In : ζ + R[1] ∈ R.carrier by typecheck
  have iff := IntegralDomain.mul_eq_zero at R, ζ - R[1], ζ + R[1] with domain, z1In, z2In
  have split := iff.forward with prod
  cases split with a | b
  . exfalso
    apply ne
    have back : ζ = (ζ - R[1]) + R[1] by ring
    rw [back, a]
    ring
  . have back : ζ = (ζ + R[1]) - R[1] by ring
    rw [back, b]
    ring

-- rootsOfUnity.integer_power_of_ringEquiv: a ring automorphism acts on
-- μ_n as a power map, ζ ↦ ζ^j for one j.
theorem rootsOfUnity.automorphism_power (σ : Set) (n : Nat)
  requires domain : IntegralDomain(R)
  requires positive : 0 < n
  requires automorphism : σ : R ≃+* R
  shows ∃ j ∈ ℕ, ∀ ζ ∈ rootsOfUnity(R, n), σ(ζ) = Ring.pow(R, ζ, j)
proof
  sorry

end Roots

-- Section: Primitive roots in fields
section Fields
variable (K : Set)
hypothesis field : Field(K)

-- Polynomial.X_pow_sub_one_separable_iff: X^n − 1 is separable iff
-- n · 1 ≠ 0.
theorem polyXPowSubOne.separable_iff (n : Nat)
  shows PolySeparable(K, polyXPowSubOne(K, n)) ↔ natCast(K, n) ≠ Ring.zero(K)
proof
  sorry

-- IsAlgClosed.hasEnoughRootsOfUnity (AlgebraicClosure.hasEnoughRootsOfUnity):
-- an algebraically closed field has a primitive n-th root when n · 1 ≠ 0.
theorem AlgebraicallyClosed.primitive_root (n : Nat)
  requires closed : AlgebraicallyClosed(K)
  requires positive : 0 < n
  requires unit : natCast(K, n) ≠ Ring.zero(K)
  shows HasEnoughRootsOfUnity(K, n)
proof
  sorry

-- A finite field with q elements has a primitive n-th root iff n ∣ q − 1
-- (FiniteField.exists_primitive_root via the cyclic unit group).
theorem FiniteField.primitive_root_iff (n : Nat)
  requires finite : FiniteField(K)
  requires positive : 0 < n
  shows (∃ ζ ∈ Ring.carrier(K), IsPrimitiveRoot(K, ζ, n)) ↔
    n ∣ cardinality(Ring.carrier(K)) - 1
proof
  sorry

-- Complex.isPrimitiveRoot_exp: ℂ has primitive n-th roots for n ≥ 1.
theorem complexRing.primitive_root (n : Nat)
  requires positive : 0 < n
  shows HasEnoughRootsOfUnity(complexRing, n)
proof
  sorry

end Fields

-- Section: Cyclotomic polynomials
section Cyclotomic
variable (R : Set)
hypothesis comm : CommRing(R)

-- Over ℤ: Φ_n is monic of degree φ(n), with integer coefficients, and
-- over ℂ the product of X − ζ over the primitive roots
-- (Polynomial.cyclotomic.monic, Polynomial.natDegree_cyclotomic,
-- Polynomial.cyclotomic'_eq_X_pow_sub_one_div, int_cyclotomic_spec).
theorem cyclotomicInt.spec (n : Nat)
  requires positive : 0 < n
  shows cyclotomicInt(n) ∈ uniPolys(integerRing) ∧
    PolyMonic(integerRing, cyclotomicInt(n)) ∧
    polyNatDegree(integerRing, cyclotomicInt(n)) = totient(n)
proof
  sorry

-- Polynomial.cyclotomic.monic, Polynomial.natDegree_cyclotomic.
theorem cyclotomic.monic (n : Nat)
  requires positive : 0 < n
  requires nontrivial : Ring.zero(R) ≠ Ring.one(R)
  shows PolyMonic(R, cyclotomic(R, n)) ∧ polyNatDegree(R, cyclotomic(R, n)) = totient(n)
proof
  sorry

-- Polynomial.map_cyclotomic: ring homomorphisms map Φ_n to Φ_n.
theorem cyclotomic.map (S f : Set) (n : Nat)
  requires hom : f : R →+* S
  requires positive : 0 < n
  shows polyMap(R, S, f)(cyclotomic(R, n)) = cyclotomic(S, n)
proof
  sorry

-- Polynomial.prod_cyclotomic_eq_X_pow_sub_one: Π_{d ∣ n} Φ_d = X^n − 1,
-- and Polynomial.cyclotomic.dvd_X_pow_sub_one.
theorem cyclotomic.prod_divisors (n : Nat)
  requires positive : 0 < n
  shows finiteRingProduct(positiveDivisors(n), uniPolys(R),
      Ring.add(polynomialRing(R, {0})), Ring.zero(polynomialRing(R, {0})),
      Ring.neg(polynomialRing(R, {0})), Ring.mul(polynomialRing(R, {0})),
      Ring.one(polynomialRing(R, {0})), cyclotomicDivisorFamily(R, n)) =
    polyXPowSubOne(R, n)
proof
  sorry

theorem cyclotomic.dvd_X_pow_sub_one (n : Nat)
  requires positive : 0 < n
  shows RingDvd(polynomialRing(R, {0}), cyclotomic(R, n), polyXPowSubOne(R, n))
proof
  sorry

-- Polynomial.cyclotomic_prime: Φ_p = 1 + X + … + X^(p−1).
theorem cyclotomic.prime (p : Nat)
  requires prime : Prime(p)
  shows cyclotomic(R, p) = finiteRingSum(p, uniPolys(R),
    Ring.add(polynomialRing(R, {0})), Ring.zero(polynomialRing(R, {0})),
    Ring.neg(polynomialRing(R, {0})), Ring.mul(polynomialRing(R, {0})),
    Ring.one(polynomialRing(R, {0})), rootPowerFamily(polynomialRing(R, {0}), polyX(R), p))
proof
  sorry

-- Polynomial.isRoot_of_unity_of_root_cyclotomic: roots of Φ_n are n-th
-- roots of unity.
theorem cyclotomic.root_pow_eq_one (μ : Set) (n : Nat)
  requires positive : 0 < n
  requires root : PolyIsRoot(R, cyclotomic(R, n), μ)
  shows Ring.pow(R, μ, n) = Ring.one(R)
proof
  sorry

-- Polynomial.isRoot_cyclotomic_iff: in a domain with n · 1 ≠ 0, the
-- roots of Φ_n are the primitive n-th roots; IsPrimitiveRoot.isRoot_cyclotomic.
theorem cyclotomic.root_iff (μ : Set) (n : Nat)
  requires domain : IntegralDomain(R)
  requires positive : 0 < n
  requires unit : natCast(R, n) ≠ Ring.zero(R)
  requires member : μ ∈ Ring.carrier(R)
  shows PolyIsRoot(R, cyclotomic(R, n), μ) ↔ IsPrimitiveRoot(R, μ, n)
proof
  sorry

theorem IsPrimitiveRoot.root_cyclotomic (μ : Set) (n : Nat)
  requires domain : IntegralDomain(R)
  requires positive : 0 < n
  requires primitive : IsPrimitiveRoot(R, μ, n)
  shows PolyIsRoot(R, cyclotomic(R, n), μ)
proof
  sorry

-- Polynomial.cyclotomic_eq_prod_X_sub_primitiveRoots: with a primitive
-- n-th root in a domain, Φ_n = Π (X − μ) over the primitive roots.
theorem cyclotomic.eq_prod_primitive_roots (ζ : Set) (n : Nat)
  requires domain : IntegralDomain(R)
  requires positive : 0 < n
  requires primitive : IsPrimitiveRoot(R, ζ, n)
  shows cyclotomic(R, n) = finiteRingProduct(primitiveRoots(R, n), uniPolys(R),
    Ring.add(polynomialRing(R, {0})), Ring.zero(polynomialRing(R, {0})),
    Ring.neg(polynomialRing(R, {0})), Ring.mul(polynomialRing(R, {0})),
    Ring.one(polynomialRing(R, {0})), linearFactorsOver(R, primitiveRoots(R, n)))
proof
  sorry

-- Polynomial.cyclotomic_expand_eq_cyclotomic_mul: for p prime not
-- dividing n, Φ_n(X^p) = Φ_{np}(X) Φ_n(X).
theorem cyclotomic.expand_prime (p n : Nat)
  requires prime : Prime(p)
  requires positive : 0 < n
  requires coprime : ¬(p ∣ n)
  shows polyComp(R, cyclotomic(R, n), Ring.pow(polynomialRing(R, {0}), polyX(R), p)) =
    call2(Ring.mul(polynomialRing(R, {0})), cyclotomic(R, n * p), cyclotomic(R, n))
proof
  sorry

-- Polynomial.isRoot_cyclotomic_prime_pow_mul_iff_of_charP: in a domain
-- of characteristic p with p ∤ m, the roots of Φ_{p^k m}, k ≥ 1, are the
-- primitive m-th roots.
theorem cyclotomic.root_prime_pow_mul_iff (μ : Set) (p k m : Nat)
  requires domain : IntegralDomain(R)
  requires char : CharP(R, p)
  requires prime : Prime(p)
  requires positive : 0 < m
  requires coprime : ¬(p ∣ m)
  requires member : μ ∈ Ring.carrier(R)
  shows PolyIsRoot(R, cyclotomic(R, p ^ k * m), μ) ↔ IsPrimitiveRoot(R, μ, m)
proof
  sorry

end Cyclotomic

-- Section: Values at 1
-- Polynomial.eval_one_cyclotomic_prime, eval_one_cyclotomic_prime_pow:
-- Φ_{p^(k+1)}(1) = p; Polynomial.eval_one_cyclotomic_not_prime_pow:
-- Φ_n(1) = 1 when n > 1 is not a prime power.
theorem cyclotomicInt.eval_one_prime_pow (p k : Nat)
  requires prime : Prime(p)
  shows polyEval(integerRing, cyclotomicInt(p ^ (k + 1)), integerOne) = integerOfNat(p)
proof
  sorry

theorem cyclotomicInt.eval_one_not_prime_pow (n : Nat)
  requires large : 1 < n
  requires notPower : ∀ p ∈ ℕ, ∀ k ∈ ℕ, Prime(p) → n ≠ p ^ k
  shows polyEval(integerRing, cyclotomicInt(n), integerOne) = integerOne
proof
  sorry
