-- Roots of unity and cyclotomic polynomials: the n-th roots of unity of a
-- commutative ring as a subgroup of its units, primitive roots of unity
-- and their powers, the cyclic structure of μ_n in a domain, the count
-- of primitive roots, the vanishing of 1 + ζ + … + ζ^(k−1), existence
-- of primitive roots in algebraically closed and finite fields, the
-- integer cast ℤ → R, and the cyclotomic polynomials Φ_n: defined over
-- ℤ through the primitive n-th roots of unity in ℂ and mapped to every
-- ring, monic of degree φ(n), Π_{d ∣ n} Φ_d = X^n − 1, their roots, and
-- their values at 1.
-- Part of the GRH blueprint.
-- Planned home: Algebra/Field/RootsOfUnity and Algebra/Polynomial/Cyclotomic.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Cyclotomy.RootsOfUnity
import GRH.Field.Finite
import Grace.Cumulus.NumberTheory.Euler
import Grace.Cumulus.Complex.Field

-- Section: Definitions
-- The cast ℤ → R (Int.cast, Int.castRingHom R): m − k ↦ m · 1 − k · 1.
def intCastHom (R : Set) : Set :=
  { u ∈ ℤ × Ring.carrier(R) | ∃ m ∈ ℕ, ∃ k ∈ ℕ,
    fst(u) = integerAddValue(integerOfNat(m), integerNegValue(integerOfNat(k))) ∧
    snd(u) = Ring.sub(R, natCast(R, m), natCast(R, k)) }

-- The n-th roots of unity, as a subset of the units (rootsOfUnity n R,
-- a subgroup of Rˣ).
def rootsOfUnity (R : Set, n : Nat) : Set :=
  { x ∈ ringUnits(R) | Ring.pow(R, x, n) = Ring.one(R) }

-- ζ is a primitive k-th root of unity (IsPrimitiveRoot ζ k): ζ^k = 1 and
-- ζ^l = 1 only for k ∣ l. For k = 0 this says ζ has infinite order, as
-- in Mathlib.
predicate IsPrimitiveRoot (R ζ : Set, k : Nat) :=
  ζ ∈ Ring.carrier(R) ∧ Ring.pow(R, ζ, k) = Ring.one(R) ∧
  (∀ l ∈ ℕ, Ring.pow(R, ζ, l) = Ring.one(R) → k ∣ l)

-- The primitive k-th roots (primitiveRoots k R; empty for k = 0).
def primitiveRoots (R : Set, k : Nat) : Set :=
  { ζ ∈ Ring.carrier(R) | 0 < k ∧ IsPrimitiveRoot(R, ζ, k) }

-- R has enough n-th roots of unity: a primitive one exists and μ_n is
-- cyclic (HasEnoughRootsOfUnity R n).
predicate HasEnoughRootsOfUnity (R : Set, n : Nat) :=
  (∃ ζ ∈ Ring.carrier(R), IsPrimitiveRoot(R, ζ, n)) ∧
  (∃ g ∈ rootsOfUnity(R, n), ∀ x ∈ rootsOfUnity(R, n), ∃ i ∈ ℕ, x = Ring.pow(R, g, i))

-- The family i ↦ ζ^i on k = {0, …, k − 1}, for Σ_{i<k} ζ^i.
def rootPowerFamily (R ζ : Set, k : Nat) : Set := { (i, Ring.pow(R, ζ, i)) | i ∈ k }

-- X^n − 1 over R.
def polyXPowSubOne (R : Set, n : Nat) : Set :=
  Ring.sub(polynomialRing(R, {0}), Ring.pow(polynomialRing(R, {0}), polyX(R), n),
    Ring.one(polynomialRing(R, {0})))

-- The factors X − μ over a set S of points of R.
def linearFactorsOver (R S : Set) : Set := { (μ, polyXSubC(R, μ)) | μ ∈ S }

-- The factors X − ζ over the primitive n-th roots of unity in ℂ.
def complexCyclotomicFactors (n : Nat) : Set :=
  { (ζ, polyXSubC(complexRing, ζ)) | ζ ∈ primitiveRoots(complexRing, n) }

-- Φ_n over ℤ (Polynomial.cyclotomic n ℤ): the polynomial with integer
-- coefficients whose image in ℂ[X] is Π (X − ζ) over the primitive n-th
-- roots of unity ζ ∈ ℂ, for n ≥ 1. Mathlib chooses the integer
-- polynomial from int_coeff_of_cyclotomic'; here it is the unique one,
-- with no choice. Mathlib's cyclotomic 0 R = 1 is not part of the
-- definition.
defunique cyclotomicInt (n : Nat) (P ∈ uniPolys(integerRing)) :=
  polyMap(integerRing, complexRing, intCastHom(complexRing))(P) =
    finiteRingProduct(primitiveRoots(complexRing, n), uniPolys(complexRing),
      Ring.add(polynomialRing(complexRing, {0})), Ring.zero(polynomialRing(complexRing, {0})),
      Ring.neg(polynomialRing(complexRing, {0})), Ring.mul(polynomialRing(complexRing, {0})),
      Ring.one(polynomialRing(complexRing, {0})), complexCyclotomicFactors(n))
requires positive : 0 < n
proof
  sorry
uniqueness
  sorry

-- Φ_n over a commutative ring R: the image of Φ_n over ℤ
-- (Polynomial.cyclotomic n R = map (Int.castRingHom R) (cyclotomic n ℤ),
-- Polynomial.map_cyclotomic_int).
def cyclotomic (R : Set, n : Nat) : Set :=
  polyMap(integerRing, R, intCastHom(R))(cyclotomicInt(n))

-- The positive divisors of n (Nat.divisors n), and the family d ↦ Φ_d
-- over them.
def positiveDivisors (n : Nat) : Set := { e ∈ ℕ | 0 < e ∧ e ∣ n }

def cyclotomicDivisorFamily (R : Set, n : Nat) : Set :=
  { (d, cyclotomic(R, d)) | d ∈ positiveDivisors(n) }

-- Section: The integer cast
section IntCast
variable (R : Set)
hypothesis comm : CommRing(R)

-- Int.castRingHom: a ring homomorphism, the only one ℤ → R
-- (RingHom.ext_int), and it extends the natural cast (Int.cast_natCast).
theorem intCastHom.hom
  shows intCastHom(R) : integerRing →+* R
proof
  sorry

theorem intCastHom.unique (f : Set)
  requires hom : f : integerRing →+* R
  shows f = intCastHom(R)
proof
  sorry

theorem intCastHom.nat (n : Nat)
  shows intCastHom(R)(integerOfNat(n)) = natCast(R, n)
proof
  sorry

-- CharP.intCast_eq_zero_iff: in characteristic n the integer a maps to
-- 0 iff n ∣ a; the cast factors through ZMod n.
theorem intCastHom.eq_zero_iff (a : Set) (n : Nat)
  requires char : CharP(R, n)
  requires integer : a ∈ ℤ
  shows intCastHom(R)(a) = Ring.zero(R) ↔ IntegerDivides(integerOfNat(n), a)
proof
  sorry

-- ZMod.intCast_cast, ZMod.cast: on ZMod n the integer cast is the
-- quotient map.
theorem intCastHom.zmod (n : Nat)
  shows intCastHom(zmod(n)) = zmodCast(n)
proof
  sorry

end IntCast

-- Section: Roots of unity
section Roots
variable (R : Set)
hypothesis comm : CommRing(R)

-- rootsOfUnity is a subgroup of Rˣ; mem_rootsOfUnity',
-- rootsOfUnity.mkOfPowEq: for n ≥ 1, x ∈ μ_n iff x^n = 1.
theorem rootsOfUnity.subgroup (n : Nat)
  shows Subgroup(rootsOfUnity(R, n), unitGroup(R))
proof
  have fin := Finite.empty
  have ringR := CommRing.to_ring with comm
  have group := unitGroup.group at R, ∅ with comm, fin
  have carrierEq := unitGroup.carrier_eq at R, ∅ with comm, fin
  have oneEq := unitGroup.one_eq at R, ∅ with comm, fin
  have inside : rootsOfUnity(R, n) ⊆ Group.carrier(unitGroup(R))
    rw carrierEq
    intros x hx
    obtain ⟨xIn, _⟩ := rootsOfUnity.membership.forward with hx
    exact xIn
  have oneIn : Group.one(unitGroup(R)) ∈ rootsOfUnity(R, n)
    rw oneEq
    have u := ringUnits.of_unit at R, ∅, R.one with comm, fin, (RingUnit.one at R with comm)
    have p := Ring.one_pow at R, n with ringR
    exact rootsOfUnity.membership.backward at R, n, R.one with ⟨u, p⟩
  have mulIn : ∀ x y ∈ rootsOfUnity(R, n),
      call2(Group.mul(unitGroup(R)), x, y) ∈ rootsOfUnity(R, n)
    intros x hx y hy
    obtain ⟨xu, xp⟩ := rootsOfUnity.membership.forward with hx
    obtain ⟨yu, yp⟩ := rootsOfUnity.membership.forward with hy
    have m := unitGroup.mul_eq at R, ∅, x, y with comm, fin, xu, yu
    rw m
    obtain ⟨xIn, xU⟩ := ringUnits.unit at R, ∅, x with comm, fin, xu
    obtain ⟨yIn, yU⟩ := ringUnits.unit at R, ∅, y with comm, fin, yu
    have u := RingUnit.mul at R, x, y with comm, xU, yU
    have uIn := ringUnits.of_unit at R, ∅, x * y with comm, fin, u
    have p := Ring.mul_pow_comm at R, x, y, n with comm
    rw [xp, yp] at p
    have p2 : (x * y) ^ n = R[1]
      rw p
      ring
    exact rootsOfUnity.membership.backward at R, n, x * y with ⟨uIn, p2⟩
  have invIn : ∀ x ∈ rootsOfUnity(R, n),
      apply(Group.inv(unitGroup(R)), x) ∈ rootsOfUnity(R, n)
    intros x hx
    obtain ⟨xu, xp⟩ := rootsOfUnity.membership.forward with hx
    obtain ⟨xIn, xU⟩ := ringUnits.unit at R, ∅, x with comm, fin, xu
    have values : ∀ a ∈ ringUnits(R), ringInverse(R, a) ∈ ringUnits(R)
      intros a ha
      obtain ⟨_, ua⟩ := ringUnits.unit at R, ∅, a with comm, fin, ha
      have u := RingUnit.inverse at R, ∅, a with comm, fin, ua
      exact ringUnits.of_unit at R, ∅, ringInverse(R, a) with comm, fin, u
    have invEq : Group.inv(unitGroup(R)) = unitInverseMap(R) by simp [unitGroup, Group.mk.inv]
    rw invEq
    have v := unitInverseMap.graph_apply at R, x with values, xu
    rw v
    have iIn := values with x, xu
    have iR := ringInverse.mem at R, x with comm, xU
    have law := ringInverse.mul_right at R, x with comm, xU
    have p := Ring.mul_pow_comm at R, x, ringInverse(R, x), n with comm
    rw law at p
    have one := Ring.one_pow at R, n with ringR
    rw [one, xp] at p
    have q : R[1] * ringInverse(R, x) ^ n = ringInverse(R, x) ^ n by ring
    rw q at p
    have p2 : ringInverse(R, x) ^ n = R[1]
      symm
      exact p
    exact rootsOfUnity.membership.backward at R, n, ringInverse(R, x) with ⟨iIn, p2⟩
  exact ⟨group, inside, oneIn, mulIn, invIn⟩

theorem rootsOfUnity.mem_iff (x : Set) (n : Nat)
  requires positive : 0 < n
  requires member : x ∈ Ring.carrier(R)
  shows x ∈ rootsOfUnity(R, n) ↔ Ring.pow(R, x, n) = Ring.one(R)
proof
  constructor
  . intro h
    obtain ⟨_, eq⟩ := rootsOfUnity.membership.forward with h
    exact eq
  . intro h
    have unit := RingUnit.of_pow_eq_one at R, x, n with comm, member, positive, h
    have unitIn := ringUnits.mem_of_unit at R, x with comm, unit
    exact rootsOfUnity.membership.backward at R, n, x with ⟨unitIn, h⟩

-- IsPrimitiveRoot.pow_eq_one_iff_dvd and uniqueness of the order
-- (IsPrimitiveRoot.unique, IsPrimitiveRoot.eq_orderOf).
theorem IsPrimitiveRoot.pow_eq_one_iff_dvd (ζ : Set) (k l : Nat)
  requires primitive : IsPrimitiveRoot(R, ζ, k)
  shows Ring.pow(R, ζ, l) = Ring.one(R) ↔ k ∣ l
proof
  obtain ⟨zIn, kOne, minimal⟩ := primitive
  constructor
  . intro h
    have lIn : l ∈ ℕ by typecheck
    exact minimal with l, lIn, h
  . intro d
    obtain ⟨m, mNat, eq⟩ := d
    rw ← eq
    have ringR := CommRing.to_ring with comm
    have s := Ring.pow_mul at R, ζ, k, m with ringR
    rw [s, kOne]
    exact Ring.one_pow at R, m with ringR

theorem IsPrimitiveRoot.unique (ζ : Set) (k l : Nat)
  requires first : IsPrimitiveRoot(R, ζ, k)
  requires second : IsPrimitiveRoot(R, ζ, l)
  shows k = l
proof
  have firstCopy := first
  have secondCopy := second
  obtain ⟨_, kOne, kMin⟩ := firstCopy
  obtain ⟨_, lOne, lMin⟩ := secondCopy
  have lIn : l ∈ ℕ by typecheck
  have kIn : k ∈ ℕ by typecheck
  have kl := kMin with l, lIn, lOne
  have lk := lMin with k, kIn, kOne
  exact divides.antisymmetric with kl, lk

-- IsPrimitiveRoot.isUnit, coe_units_iff: a primitive k-th root with
-- k ≥ 1 is a k-th root of unity.
theorem IsPrimitiveRoot.mem_roots (ζ : Set) (k : Nat)
  requires primitive : IsPrimitiveRoot(R, ζ, k)
  requires positive : 0 < k
  shows RingUnit(R, ζ) ∧ ζ ∈ rootsOfUnity(R, k)
proof
  have primitiveCopy := primitive
  obtain ⟨zIn, kOne, _⟩ := primitiveCopy
  have unit := RingUnit.of_pow_eq_one at R, ζ, k with comm, zIn, positive, kOne
  have iff := rootsOfUnity.mem_iff at R, ζ, k with comm, positive, zIn
  have mem := iff.backward with kOne
  exact ⟨unit, mem⟩

-- IsPrimitiveRoot.pow_ne_one_of_pos_of_lt, IsPrimitiveRoot.pow_inj,
-- IsPrimitiveRoot.injOn_pow.
theorem IsPrimitiveRoot.pow_ne_one (ζ : Set) (k l : Nat)
  requires primitive : IsPrimitiveRoot(R, ζ, k)
  requires positive : 0 < l
  requires below : l < k
  shows Ring.pow(R, ζ, l) ≠ Ring.one(R)
proof
  intro h
  have iff := IsPrimitiveRoot.pow_eq_one_iff_dvd at R, ζ, k, l with comm, primitive
  have d := iff.forward with h
  have lNonzero : l ≠ 0 by arith
  have le := divides.le at k, l with d, lNonzero
  arith

theorem tkJ.primitive.pow_inj_lt (ζ : Set) (k i j : Nat)
  requires primitive : IsPrimitiveRoot(R, ζ, k)
  requires first : i < j
  requires second : j < k
  requires equal : Ring.pow(R, ζ, i) = Ring.pow(R, ζ, j)
  shows ⊥
proof
  have ringR := CommRing.to_ring with comm
  have primitiveCopy := primitive
  obtain ⟨zIn, kOne, _⟩ := primitiveCopy
  obtain ⟨d, dNat, jEq⟩ := Less.exists_add_one at i, j with first
  have ik : i ≤ k by arith
  obtain ⟨e, eNat, kEq⟩ := LessEqual.exists_add at i, k with ik
  have jEq2 : j = i + (d + 1) by arith
  rw jEq2 at equal
  have sj := Ring.pow_add at R, ζ, i, d + 1 with ringR
  rw sj at equal
  have sk := Ring.pow_add at R, ζ, i, e with ringR
  rw ← kEq at sk
  rw kOne at sk
  have step : ζ ^ (d + 1) = R[1]
    linear_combination (ζ ^ (d + 1) - R[1]) * sk - ζ ^ e * equal
  have iff := IsPrimitiveRoot.pow_eq_one_iff_dvd at R, ζ, k, d + 1 with comm, primitive
  have dv := iff.forward with step
  have nz : d + 1 ≠ 0 by arith
  have le := divides.le at k, d + 1 with dv, nz
  arith

theorem IsPrimitiveRoot.pow_inj (ζ : Set) (k i j : Nat)
  requires primitive : IsPrimitiveRoot(R, ζ, k)
  requires first : i < k
  requires second : j < k
  requires equal : Ring.pow(R, ζ, i) = Ring.pow(R, ζ, j)
  shows i = j
proof
  have tri := Less.trichotomy at i, j with *
  cases tri with lt | rest
  . exfalso
    exact tkJ.primitive.pow_inj_lt at R, ζ, k, i, j with comm, primitive, lt, second, equal
  . cases rest with same | gt
    . exact same
    . exfalso
      have flipped : Ring.pow(R, ζ, j) = Ring.pow(R, ζ, i) by symm; exact equal
      exact tkJ.primitive.pow_inj_lt at R, ζ, k, j, i with comm, primitive, gt, first, flipped

-- IsPrimitiveRoot.pow_of_coprime, IsPrimitiveRoot.pow_iff_coprime:
-- ζ^i is a primitive k-th root iff gcd(i, k) = 1.
theorem IsPrimitiveRoot.pow_iff_coprime (ζ : Set) (k i : Nat)
  requires primitive : IsPrimitiveRoot(R, ζ, k)
  requires positive : 0 < k
  shows IsPrimitiveRoot(R, Ring.pow(R, ζ, i), k) ↔ gcd(i, k) = 1
proof
  sorry

-- IsPrimitiveRoot.pow_of_dvd: for k = d m with d ≥ 1, ζ^d is a primitive
-- m-th root.
theorem IsPrimitiveRoot.pow_of_dvd (ζ : Set) (d m : Nat)
  requires primitive : IsPrimitiveRoot(R, ζ, d * m)
  requires positive : 0 < d
  shows IsPrimitiveRoot(R, Ring.pow(R, ζ, d), m)
proof
  have ringR := CommRing.to_ring with comm
  have primitiveCopy := primitive
  obtain ⟨zIn, kOne, minimal⟩ := primitiveCopy
  have pIn : Ring.pow(R, ζ, d) ∈ Ring.carrier(R) by typecheck
  have split : ∀ l ∈ ℕ, Ring.pow(R, Ring.pow(R, ζ, d), l) = Ring.pow(R, ζ, d * l)
    intros l hl
    have s := Ring.pow_mul at R, ζ, d, l with ringR
    symm
    exact s
  have mIn : m ∈ ℕ by typecheck
  have mOne : Ring.pow(R, Ring.pow(R, ζ, d), m) = Ring.one(R)
    have s := split with m, mIn
    rw s
    exact kOne
  have minR : ∀ l ∈ ℕ, Ring.pow(R, Ring.pow(R, ζ, d), l) = Ring.one(R) → m ∣ l
    intros l hl hpow
    have s := split with l, hl
    rw s at hpow
    have dlIn : d * l ∈ ℕ by typecheck
    have dv := minimal with d * l, dlIn, hpow
    have nz : d ≠ 0 by arith
    have cancel := divides.mul_cancel_left at d, m, l with nz
    exact cancel.forward with dv
  exact ⟨pIn, mOne, minR⟩

-- IsPrimitiveRoot.map_of_injective, IsPrimitiveRoot.of_map_of_injective.
theorem IsPrimitiveRoot.map_iff (S f ζ : Set) (k : Nat)
  requires hom : f : R →+* S
  requires injective : InjectiveBetween(f, Ring.carrier(R), Ring.carrier(S))
  requires member : ζ ∈ Ring.carrier(R)
  shows IsPrimitiveRoot(S, f(ζ), k) ↔ IsPrimitiveRoot(R, ζ, k)
proof
  have oneIn : Ring.one(R) ∈ Ring.carrier(R) by typecheck
  have one := RingHom.map_one with hom
  have fzIn : f(ζ) ∈ Ring.carrier(S) := RingHom.map_mem with hom, member
  have powIff : ∀ l ∈ ℕ, (Ring.pow(S, f(ζ), l) = Ring.one(S) ↔ Ring.pow(R, ζ, l) = Ring.one(R))
    intros l hl
    have mapped := tkJ.hom_pow at f, R, S, ζ, l with hom, member
    constructor
    . intro h
      rw ← mapped at h
      rw ← one at h
      have pIn : Ring.pow(R, ζ, l) ∈ Ring.carrier(R) by typecheck
      exact tkJ.injective_apply at f, Ring.carrier(R), Ring.carrier(S), Ring.pow(R, ζ, l), Ring.one(R) with injective, pIn, oneIn, h
    . intro h
      rw [← mapped, h, one]
  have kIn : k ∈ ℕ by typecheck
  have kIff := powIff with k, kIn
  constructor
  . intro h
    obtain ⟨_, kOne, minimal⟩ := h
    have kR := kIff.forward with kOne
    have minR : ∀ l ∈ ℕ, Ring.pow(R, ζ, l) = Ring.one(R) → k ∣ l
      intros l hl hpow
      have lIff := powIff with l, hl
      have lS := lIff.backward with hpow
      exact minimal with l, hl, lS
    exact ⟨member, kR, minR⟩
  . intro h
    obtain ⟨_, kOne, minimal⟩ := h
    have kS := kIff.backward with kOne
    have minS : ∀ l ∈ ℕ, Ring.pow(S, f(ζ), l) = Ring.one(S) → k ∣ l
      intros l hl hpow
      have lIff := powIff with l, hl
      have lR := lIff.forward with hpow
      exact minimal with l, hl, lR
    exact ⟨fzIn, kS, minS⟩

-- IsPrimitiveRoot.isIntegral: a root of unity is integral over the base
-- of any algebra containing it.
theorem IsPrimitiveRoot.integral (E ζ : Set) (k : Nat)
  requires algebra : Algebra(E)
  requires ring : Algebra.ring(E) = R
  requires primitive : IsPrimitiveRoot(R, ζ, k)
  requires positive : 0 < k
  shows IntegralElement(E, ζ)
proof
  sorry

-- Section: Roots of unity in a domain
-- card_rootsOfUnity: μ_n has at most n elements; it is cyclic
-- (rootsOfUnity.isCyclic).
theorem rootsOfUnity.card_le (n : Nat)
  requires domain : IntegralDomain(R)
  requires positive : 0 < n
  shows Finite(rootsOfUnity(R, n)) ∧ cardinality(rootsOfUnity(R, n)) ≤ n
proof
  sorry

theorem rootsOfUnity.cyclic (n : Nat)
  requires domain : IntegralDomain(R)
  requires positive : 0 < n
  shows ∃ g ∈ rootsOfUnity(R, n), ∀ x ∈ rootsOfUnity(R, n), ∃ i ∈ ℕ,
    x = Ring.pow(R, g, i)
proof
  sorry

-- IsPrimitiveRoot.eq_pow_of_pow_eq_one, IsPrimitiveRoot.zpowers_eq,
-- IsPrimitiveRoot.nthRoots_eq: the k-th roots of unity are the powers
-- ζ^i, i < k, of a primitive one.
theorem IsPrimitiveRoot.eq_pow_of_pow_eq_one (ζ ξ : Set) (k : Nat)
  requires domain : IntegralDomain(R)
  requires primitive : IsPrimitiveRoot(R, ζ, k)
  requires positive : 0 < k
  requires member : ξ ∈ Ring.carrier(R)
  requires root : Ring.pow(R, ξ, k) = Ring.one(R)
  shows ∃ i ∈ ℕ, i < k ∧ ξ = Ring.pow(R, ζ, i)
proof
  sorry

-- With a primitive k-th root, μ_k has exactly k elements and R has
-- enough k-th roots (HasEnoughRootsOfUnity.natCard_rootsOfUnity,
-- IsPrimitiveRoot.card_rootsOfUnity).
theorem IsPrimitiveRoot.card_roots (ζ : Set) (k : Nat)
  requires domain : IntegralDomain(R)
  requires primitive : IsPrimitiveRoot(R, ζ, k)
  requires positive : 0 < k
  shows HasCardinality(rootsOfUnity(R, k), k) ∧ HasEnoughRootsOfUnity(R, k)
proof
  sorry

-- IsPrimitiveRoot.card_primitiveRoots: φ(k) primitive k-th roots.
theorem IsPrimitiveRoot.card_primitiveRoots (ζ : Set) (k : Nat)
  requires domain : IntegralDomain(R)
  requires primitive : IsPrimitiveRoot(R, ζ, k)
  requires positive : 0 < k
  shows HasCardinality(primitiveRoots(R, k), totient(k))
proof
  sorry

-- IsPrimitiveRoot.geom_sum_eq_zero: Σ_{i<k} ζ^i = 0 for k > 1.
theorem IsPrimitiveRoot.geom_sum_eq_zero (ζ : Set) (k : Nat)
  requires domain : IntegralDomain(R)
  requires primitive : IsPrimitiveRoot(R, ζ, k)
  requires large : 1 < k
  shows finiteRingSum(k, Ring.carrier(R), Ring.add(R), Ring.zero(R), Ring.neg(R),
    Ring.mul(R), Ring.one(R), rootPowerFamily(R, ζ, k)) = Ring.zero(R)
proof
  sorry

-- IsPrimitiveRoot.eq_neg_one_of_two_right: a primitive square root of 1
-- is −1.
theorem IsPrimitiveRoot.eq_neg_one (ζ : Set)
  requires domain : IntegralDomain(R)
  requires primitive : IsPrimitiveRoot(R, ζ, 2)
  shows ζ = apply(Ring.neg(R), Ring.one(R))
proof
  have ringR := CommRing.to_ring with comm
  have primitiveCopy := primitive
  obtain ⟨zIn, two, _⟩ := primitiveCopy
  have pos : 0 < 1 by arith
  have lt : 1 < 2 by arith
  have ne := IsPrimitiveRoot.pow_ne_one at R, ζ, 2, 1 with comm, primitive, pos, lt
  have p1 := Ring.pow_one at R, ζ with ringR
  rw p1 at ne
  have prod : (ζ - R[1]) * (ζ + R[1]) = R[0]
    have expand : (ζ - R[1]) * (ζ + R[1]) = ζ ^ 2 - R[1] by ring
    rw [expand, two]
    ring
  have z1In : ζ - R[1] ∈ R.carrier by typecheck
  have z2In : ζ + R[1] ∈ R.carrier by typecheck
  have iff := IntegralDomain.mul_eq_zero at R, ζ - R[1], ζ + R[1] with domain, z1In, z2In
  have split := iff.forward with prod
  cases split with a | b
  . exfalso
    apply ne
    have back : ζ = (ζ - R[1]) + R[1] by ring
    rw [back, a]
    ring
  . have back : ζ = (ζ + R[1]) - R[1] by ring
    rw [back, b]
    ring

-- rootsOfUnity.integer_power_of_ringEquiv: a ring automorphism acts on
-- μ_n as a power map, ζ ↦ ζ^j for one j.
theorem rootsOfUnity.automorphism_power (σ : Set) (n : Nat)
  requires domain : IntegralDomain(R)
  requires positive : 0 < n
  requires automorphism : σ : R ≃+* R
  shows ∃ j ∈ ℕ, ∀ ζ ∈ rootsOfUnity(R, n), σ(ζ) = Ring.pow(R, ζ, j)
proof
  sorry

end Roots

-- Section: Primitive roots in fields
section Fields
variable (K : Set)
hypothesis field : Field(K)

-- Polynomial.X_pow_sub_one_separable_iff: X^n − 1 is separable iff
-- n · 1 ≠ 0.
theorem polyXPowSubOne.separable_iff (n : Nat)
  shows PolySeparable(K, polyXPowSubOne(K, n)) ↔ natCast(K, n) ≠ Ring.zero(K)
proof
  sorry

-- IsAlgClosed.hasEnoughRootsOfUnity (AlgebraicClosure.hasEnoughRootsOfUnity):
-- an algebraically closed field has a primitive n-th root when n · 1 ≠ 0.
theorem AlgebraicallyClosed.primitive_root (n : Nat)
  requires closed : AlgebraicallyClosed(K)
  requires positive : 0 < n
  requires unit : natCast(K, n) ≠ Ring.zero(K)
  shows HasEnoughRootsOfUnity(K, n)
proof
  sorry

-- A finite field with q elements has a primitive n-th root iff n ∣ q − 1
-- (FiniteField.exists_primitive_root via the cyclic unit group).
theorem FiniteField.primitive_root_iff (n : Nat)
  requires finite : FiniteField(K)
  requires positive : 0 < n
  shows (∃ ζ ∈ Ring.carrier(K), IsPrimitiveRoot(K, ζ, n)) ↔
    n ∣ cardinality(Ring.carrier(K)) - 1
proof
  sorry

-- Complex.isPrimitiveRoot_exp: ℂ has primitive n-th roots for n ≥ 1.
theorem complexRing.primitive_root (n : Nat)
  requires positive : 0 < n
  shows HasEnoughRootsOfUnity(complexRing, n)
proof
  sorry

end Fields

-- Section: Cyclotomic polynomials
section Cyclotomic
variable (R : Set)
hypothesis comm : CommRing(R)

-- Over ℤ: Φ_n is monic of degree φ(n), with integer coefficients, and
-- over ℂ the product of X − ζ over the primitive roots
-- (Polynomial.cyclotomic.monic, Polynomial.natDegree_cyclotomic,
-- Polynomial.cyclotomic'_eq_X_pow_sub_one_div, int_cyclotomic_spec).
theorem cyclotomicInt.spec (n : Nat)
  requires positive : 0 < n
  shows cyclotomicInt(n) ∈ uniPolys(integerRing) ∧
    PolyMonic(integerRing, cyclotomicInt(n)) ∧
    polyNatDegree(integerRing, cyclotomicInt(n)) = totient(n)
proof
  sorry

-- Polynomial.cyclotomic.monic, Polynomial.natDegree_cyclotomic.
theorem cyclotomic.monic (n : Nat)
  requires positive : 0 < n
  requires nontrivial : Ring.zero(R) ≠ Ring.one(R)
  shows PolyMonic(R, cyclotomic(R, n)) ∧ polyNatDegree(R, cyclotomic(R, n)) = totient(n)
proof
  sorry

-- Polynomial.map_cyclotomic: ring homomorphisms map Φ_n to Φ_n.
theorem cyclotomic.map (S f : Set) (n : Nat)
  requires hom : f : R →+* S
  requires positive : 0 < n
  shows polyMap(R, S, f)(cyclotomic(R, n)) = cyclotomic(S, n)
proof
  sorry

-- Polynomial.prod_cyclotomic_eq_X_pow_sub_one: Π_{d ∣ n} Φ_d = X^n − 1,
-- and Polynomial.cyclotomic.dvd_X_pow_sub_one.
theorem cyclotomic.prod_divisors (n : Nat)
  requires positive : 0 < n
  shows finiteRingProduct(positiveDivisors(n), uniPolys(R),
      Ring.add(polynomialRing(R, {0})), Ring.zero(polynomialRing(R, {0})),
      Ring.neg(polynomialRing(R, {0})), Ring.mul(polynomialRing(R, {0})),
      Ring.one(polynomialRing(R, {0})), cyclotomicDivisorFamily(R, n)) =
    polyXPowSubOne(R, n)
proof
  sorry

theorem cyclotomic.dvd_X_pow_sub_one (n : Nat)
  requires positive : 0 < n
  shows RingDvd(polynomialRing(R, {0}), cyclotomic(R, n), polyXPowSubOne(R, n))
proof
  sorry

-- Polynomial.cyclotomic_prime: Φ_p = 1 + X + … + X^(p−1).
theorem cyclotomic.prime (p : Nat)
  requires prime : Prime(p)
  shows cyclotomic(R, p) = finiteRingSum(p, uniPolys(R),
    Ring.add(polynomialRing(R, {0})), Ring.zero(polynomialRing(R, {0})),
    Ring.neg(polynomialRing(R, {0})), Ring.mul(polynomialRing(R, {0})),
    Ring.one(polynomialRing(R, {0})), rootPowerFamily(polynomialRing(R, {0}), polyX(R), p))
proof
  sorry

-- Polynomial.isRoot_of_unity_of_root_cyclotomic: roots of Φ_n are n-th
-- roots of unity.
theorem cyclotomic.root_pow_eq_one (μ : Set) (n : Nat)
  requires positive : 0 < n
  requires root : PolyIsRoot(R, cyclotomic(R, n), μ)
  shows Ring.pow(R, μ, n) = Ring.one(R)
proof
  sorry

-- Polynomial.isRoot_cyclotomic_iff: in a domain with n · 1 ≠ 0, the
-- roots of Φ_n are the primitive n-th roots; IsPrimitiveRoot.isRoot_cyclotomic.
theorem cyclotomic.root_iff (μ : Set) (n : Nat)
  requires domain : IntegralDomain(R)
  requires positive : 0 < n
  requires unit : natCast(R, n) ≠ Ring.zero(R)
  requires member : μ ∈ Ring.carrier(R)
  shows PolyIsRoot(R, cyclotomic(R, n), μ) ↔ IsPrimitiveRoot(R, μ, n)
proof
  sorry

theorem IsPrimitiveRoot.root_cyclotomic (μ : Set) (n : Nat)
  requires domain : IntegralDomain(R)
  requires positive : 0 < n
  requires primitive : IsPrimitiveRoot(R, μ, n)
  shows PolyIsRoot(R, cyclotomic(R, n), μ)
proof
  sorry

-- Polynomial.cyclotomic_eq_prod_X_sub_primitiveRoots: with a primitive
-- n-th root in a domain, Φ_n = Π (X − μ) over the primitive roots.
theorem cyclotomic.eq_prod_primitive_roots (ζ : Set) (n : Nat)
  requires domain : IntegralDomain(R)
  requires positive : 0 < n
  requires primitive : IsPrimitiveRoot(R, ζ, n)
  shows cyclotomic(R, n) = finiteRingProduct(primitiveRoots(R, n), uniPolys(R),
    Ring.add(polynomialRing(R, {0})), Ring.zero(polynomialRing(R, {0})),
    Ring.neg(polynomialRing(R, {0})), Ring.mul(polynomialRing(R, {0})),
    Ring.one(polynomialRing(R, {0})), linearFactorsOver(R, primitiveRoots(R, n)))
proof
  sorry

-- Polynomial.cyclotomic_expand_eq_cyclotomic_mul: for p prime not
-- dividing n, Φ_n(X^p) = Φ_{np}(X) Φ_n(X).
theorem cyclotomic.expand_prime (p n : Nat)
  requires prime : Prime(p)
  requires positive : 0 < n
  requires coprime : ¬(p ∣ n)
  shows polyComp(R, cyclotomic(R, n), Ring.pow(polynomialRing(R, {0}), polyX(R), p)) =
    call2(Ring.mul(polynomialRing(R, {0})), cyclotomic(R, n * p), cyclotomic(R, n))
proof
  sorry

-- Polynomial.isRoot_cyclotomic_prime_pow_mul_iff_of_charP: in a domain
-- of characteristic p with p ∤ m, the roots of Φ_{p^k m}, k ≥ 1, are the
-- primitive m-th roots.
theorem cyclotomic.root_prime_pow_mul_iff (μ : Set) (p k m : Nat)
  requires domain : IntegralDomain(R)
  requires char : CharP(R, p)
  requires prime : Prime(p)
  requires positive : 0 < m
  requires coprime : ¬(p ∣ m)
  requires member : μ ∈ Ring.carrier(R)
  shows PolyIsRoot(R, cyclotomic(R, p ^ k * m), μ) ↔ IsPrimitiveRoot(R, μ, m)
proof
  sorry

end Cyclotomic

-- Section: Values at 1
-- Polynomial.eval_one_cyclotomic_prime, eval_one_cyclotomic_prime_pow:
-- Φ_{p^(k+1)}(1) = p; Polynomial.eval_one_cyclotomic_not_prime_pow:
-- Φ_n(1) = 1 when n > 1 is not a prime power.
theorem cyclotomicInt.eval_one_prime_pow (p k : Nat)
  requires prime : Prime(p)
  shows polyEval(integerRing, cyclotomicInt(p ^ (k + 1)), integerOne) = integerOfNat(p)
proof
  sorry

theorem cyclotomicInt.eval_one_not_prime_pow (n : Nat)
  requires large : 1 < n
  requires notPower : ∀ p ∈ ℕ, ∀ k ∈ ℕ, Prime(p) → n ≠ p ^ k
  shows polyEval(integerRing, cyclotomicInt(n), integerOne) = integerOne
proof
  sorry
