-- Cyclotomic extensions: ℚ as a bundled field, the predicate that B is
-- generated over A by n-th roots of unity for n in a set S, containing
-- primitive ones (IsCyclotomicExtension), existence and uniqueness of
-- cyclotomic fields, K(ζ) as a cyclotomic extension, Galois and abelian
-- Galois groups embedding into (ℤ/nℤ)ˣ, irreducibility of Φ_n over ℚ,
-- [ℚ(ζ_n) : ℚ] = φ(n), and the modular cyclotomic character of a ring
-- automorphism, locally constant on the Krull topology.
-- Part of the GRH blueprint.
-- Planned home: NumberTheory/Cyclotomic/Basic.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Cyclotomy.Fields
import GRH.Cyclotomy.RootsOfUnity
import GRH.Field.InfiniteGalois

-- Section: Definitions
-- ℚ as a bundled field (Mathlib's Rat with its Field instance).
def rationalRing : Set :=
  Ring.mk(ℚ, rationalAdd, rationalZero, rationalNeg, rationalMul, rationalOne)

-- The roots of unity of order in S: x with x^n = 1 for some n ∈ S, n ≥ 1.
def cyclotomicGenerators (E S : Set) : Set :=
  { x ∈ algebraCarrier(E) | ∃ n ∈ S, 0 < n ∧
    Ring.pow(Algebra.ring(E), x, n) = Ring.one(Algebra.ring(E)) }

-- B is an S-cyclotomic extension of A (IsCyclotomicExtension S A B), for
-- S ⊆ ℕ: B has a primitive n-th root of unity for each n ∈ S, n ≥ 1, and
-- is generated as an A-algebra by the roots of unity of order in S.
-- Here E is any Cumulus algebra B over A.
predicate IsCyclotomicExtension (S E : Set) :=
  Algebra(E) ∧ S ⊆ ℕ ∧
  (∀ n ∈ S, 0 < n → (∃ ζ ∈ algebraCarrier(E), IsPrimitiveRoot(Algebra.ring(E), ζ, n))) ∧
  adjoinOf(E, cyclotomicGenerators(E, S)) = algebraCarrier(E)

-- The ring automorphisms of R (R ≃+* R).
def ringAutomorphisms (R : Set) : Set :=
  { σ ∈ functionSpace(Ring.carrier(R), Ring.carrier(R)) | RingIso(σ, R, R) }

-- Helpers: when μ_n has n elements in a domain, exponents below n are
-- told apart by their action on μ_n.
theorem tkJ.roots.pow_lt (L : Set) (n a b : Nat)
  requires comm : CommRing(L)
  requires domain : IntegralDomain(L)
  requires count : HasCardinality(rootsOfUnity(L, n), n)
  requires below : a < b
  requires bounded : b < n
  requires same : ∀ ζ ∈ rootsOfUnity(L, n), Ring.pow(L, ζ, a) = Ring.pow(L, ζ, b)
  shows ⊥
proof
  have ringL := CommRing.to_ring with comm
  obtain ⟨d, dNat, bd⟩ := Less.exists_add_one at a, b with below
  have an : a ≤ n by arith
  obtain ⟨e, eNat, ne⟩ := LessEqual.exists_add at a, n with an
  have dPos : 0 < d + 1 by arith
  have sub : rootsOfUnity(L, n) ⊆ rootsOfUnity(L, d + 1)
    intros x hx
    obtain ⟨xu, xp⟩ := rootsOfUnity.membership.forward with hx
    obtain ⟨xIn, _⟩ := ringUnits.membership.forward with xu
    have eq := same with x, hx
    have bd2 : b = a + (d + 1) by arith
    rw bd2 at eq
    rw (Ring.pow_add at L, x, a, d + 1 with ringL, xIn) at eq
    have sk := Ring.pow_add at L, x, a, e with ringL, xIn
    rw ← ne at sk
    rw xp at sk
    have p1In : Ring.pow(L, x, d + 1) ∈ Ring.carrier(L) := Ring.pow_mem at L, x, d + 1 with ringL, xIn
    have p2In : Ring.pow(L, x, e) ∈ Ring.carrier(L) := Ring.pow_mem at L, x, e with ringL, xIn
    have p3In : Ring.pow(L, x, a) ∈ Ring.carrier(L) := Ring.pow_mem at L, x, a with ringL, xIn
    have step : Ring.pow(L, x, d + 1) = Ring.one(L)
      linear_combination (Ring.pow(L, x, d + 1) - Ring.one(L)) * sk - Ring.pow(L, x, e) * eq
    exact rootsOfUnity.membership.backward at L, d + 1, x with ⟨xu, step⟩
  have bound := rootsOfUnity.card_le at L, d + 1 with comm, domain, dPos
  obtain ⟨fin, le⟩ := bound
  have mono := cardinality.monotone at rootsOfUnity(L, n), rootsOfUnity(L, d + 1) with fin, sub
  have cn := cardinality.eq_of_has with count
  rw cn at mono
  arith

theorem tkJ.roots.pow_eq (L : Set) (n a b : Nat)
  requires comm : CommRing(L)
  requires domain : IntegralDomain(L)
  requires count : HasCardinality(rootsOfUnity(L, n), n)
  requires firstBound : a < n
  requires secondBound : b < n
  requires same : ∀ ζ ∈ rootsOfUnity(L, n), Ring.pow(L, ζ, a) = Ring.pow(L, ζ, b)
  shows a = b
proof
  have tri := Less.trichotomy at a, b with *
  cases tri with lt | rest
  . exfalso
    exact tkJ.roots.pow_lt at L, n, a, b with comm, domain, count, lt, secondBound, same
  . cases rest with eq | gt
    . exact eq
    . exfalso
      have flipped : ∀ ζ ∈ rootsOfUnity(L, n), Ring.pow(L, ζ, b) = Ring.pow(L, ζ, a)
        intros ζ hz
        have s := same with ζ, hz
        symm
        exact s
      exact tkJ.roots.pow_lt at L, n, b, a with comm, domain, count, gt, firstBound, flipped

-- The modular cyclotomic character (modularCyclotomicCharacter): when
-- the n-th roots of unity of L number n, a ring automorphism σ acts on
-- them as ζ ↦ ζ^j for a unique j ∈ ℤ/nℤ. The value is that unique class
-- (Mathlib's modularCyclotomicCharacter.aux is a chosen integer; the
-- class is unique, so no choice is made).
defunique cyclotomicCharValue (L : Set, n : Nat, σ : Set) (j ∈ Ring.carrier(zmod(n))) :=
  ∀ ζ ∈ rootsOfUnity(L, n), σ(ζ) = Ring.pow(L, ζ, zmodVal(n, j))
requires domain : IntegralDomain(L)
requires positive : 0 < n
requires count : HasCardinality(rootsOfUnity(L, n), n)
requires automorphism : σ ∈ ringAutomorphisms(L)
proof
  have comm := IntegralDomain.comm_ring at L with domain
  have ringL := CommRing.to_ring with comm
  obtain ⟨_, iso⟩ := ringAutomorphisms.membership.forward with automorphism
  obtain ⟨j, jIn, act⟩ := rootsOfUnity.automorphism_power at L, σ, n with comm, domain, positive, iso
  have jNat := nat.omega.backward with jIn
  have jZ : integerOfNat(j) ∈ ℤ by typecheck
  have cIn := tkJ.zmod.cast_mem at n, integerOfNat(j) with jZ
  witness zmodCast(n)(integerOfNat(j))
  refine ⟨cIn, ?_⟩
  intros ζ hz
  rw (zmodVal.nat_cast at n, j with positive)
  rw (integerMod.ofNat at j, n with positive)
  rw (act with ζ, hz)
  obtain ⟨zu, zp⟩ := rootsOfUnity.membership.forward with hz
  obtain ⟨zL, _⟩ := ringUnits.membership.forward with zu
  have nz : n ≠ 0 by arith
  obtain ⟨q, qNat, jq⟩ := mod.equation at j, n with nz
  have rNat : Nat(j % n) by typecheck
  have e := Ring.pow_add at L, ζ, n * q, j % n with ringL, zL
  rw ← jq at e
  rw (Ring.pow_mul at L, ζ, n, q with ringL, zL) at e
  rw [zp, (Ring.one_pow at L, q with ringL)] at e
  rw e
  have pIn : Ring.pow(L, ζ, j % n) ∈ Ring.carrier(L) := Ring.pow_mem at L, ζ, j % n with ringL, zL
  ring
uniqueness
  intros j hj ej k hk ek
  have comm := IntegralDomain.comm_ring at L with domain
  have sj := zmodVal.spec at n, j with positive, hj
  obtain ⟨jlt, _⟩ := sj
  have sk := zmodVal.spec at n, k with positive, hk
  obtain ⟨klt, _⟩ := sk
  have selJ := zmodVal.selected at n, j with positive, hj
  have jN := nat.omega.backward with selJ.left
  have selK := zmodVal.selected at n, k with positive, hk
  have kN := nat.omega.backward with selK.left
  have same : ∀ ζ ∈ rootsOfUnity(L, n), Ring.pow(L, ζ, zmodVal(n, j)) = Ring.pow(L, ζ, zmodVal(n, k))
    intros ζ hz
    have a := ej with ζ, hz
    have b := ek with ζ, hz
    rw a at b
    exact b
  have eq := tkJ.roots.pow_eq at L, n, zmodVal(n, j), zmodVal(n, k) with comm, domain, count, jlt, klt, same
  have inj := zmodVal.injective at n with positive
  exact inj with j, hj, k, hk, eq

def modularCyclotomicCharacter (L : Set, n : Nat) : Set :=
  { (σ, cyclotomicCharValue(L, n, σ)) | σ ∈ ringAutomorphisms(L) }

-- Helpers: n · 1 in ℚ is the fraction n/1.
theorem tkJ.rational.ringNat (n : Nat)
  shows ringNat(rationalAdd, rationalZero, rationalOne, n) = rationalClass(n, 0, 1)
proof
  induction n
  | zero =>
    rw ringNat.zero
    unfold rationalZero
    rfl
  | succ(k) using ih =>
    rw ringNat.succ
    rw ih
    unfold rationalOne
    rw rationalAddValue.notation
    have one : 1 ≠ 0 by arith
    rw (rationalAddValue.classes at k, 0, 1, 1, 0, 1 with one, one)
    unfold rationalClassSum
    apply rationalClass.eq
    . arith
    . exact one
    . arith

theorem tkJ.rational.natCast (n : Nat)
  shows natCast(rationalRing, n) = rationalClass(n, 0, 1)
proof
  have addEq : Ring.add(rationalRing) = rationalAdd by simp [rationalRing, Ring.mk.add]
  have zeroEq : Ring.zero(rationalRing) = rationalZero by simp [rationalRing, Ring.mk.zero]
  have oneEq : Ring.one(rationalRing) = rationalOne by simp [rationalRing, Ring.mk.one]
  unfold natCast
  rw [addEq, zeroEq, oneEq]
  exact tkJ.rational.ringNat at n

-- Section: The rationals
-- ℚ is a field of characteristic zero (Rat.instField, algebraRat.charZero).
theorem rationalRing.field
  shows Field(rationalRing) ∧ CharP(rationalRing, 0)
proof
  have parts := rationals.comm_ring
  have lt := Grace.Cumulus.Rat.OrderedOperations.rationalZero.lt_one
  have zIn : rationalZero ∈ ℚ by typecheck
  have oIn : rationalOne ∈ ℚ by typecheck
  have nt : Nontrivial(ℚ, rationalZero, rationalOne)
    unfold Nontrivial
    refine ⟨zIn, oIn, ?_⟩
    intro e
    rw e at lt
    exact rationalLess.irreflexive at rationalOne with lt
  have inv : ∀ x ∈ ℚ, x ≠ rationalZero → ∃ y, IsInverse(ℚ, rationalMul, rationalOne, x, y)
    intros x xIn nz
    have xR : Rational(x) by typecheck
    have tri := rationalLess.trichotomy at rationalZero, x
    cases tri with pos | rest
    . obtain ⟨y, yIn, _, prod⟩ := rationalMulValue.exists_positive_inverse at x with pos
      have yR : Rational(y) by typecheck
      witness y
      unfold IsInverse
      refine ⟨xIn, yIn, ?_, ?_⟩
      . have c := rationalMulValue.commutative at y, x with yR, xR
        rw c
        exact prod
      . exact prod
    . cases rest with eq | neg
      . exfalso
        apply nz
        symm
        exact eq
      . have p := rationalLess.neg_reverse at x, rationalZero with neg
        have zR : Rational(rationalZero) by typecheck
        have nz0 : rationalNegValue(rationalZero) = rationalZero by ring
        simp [rationalNegValue.notation] at p
        rw nz0 at p
        have nxR : Rational(rationalNegValue(x)) by typecheck
        obtain ⟨y, yIn, _, prod⟩ := rationalMulValue.exists_positive_inverse at rationalNegValue(x) with p
        rw rationalMulValue.notation at prod
        have yR : Rational(y) by typecheck
        have nyIn : rationalNegValue(y) ∈ ℚ by typecheck
        have nyR : Rational(rationalNegValue(y)) by typecheck
        have prod2 : rationalMulValue(x, rationalNegValue(y)) = rationalOne
          have t : rationalMulValue(x, rationalNegValue(y)) = rationalMulValue(rationalNegValue(x), y) by ring
          rw t
          exact prod
        witness rationalNegValue(y)
        unfold IsInverse
        refine ⟨xIn, nyIn, ?_, ?_⟩
        . have c := rationalMulValue.commutative at rationalNegValue(y), x with nyR, xR
          rw c
          rw rationalMulValue.notation
          exact prod2
        . rw rationalMulValue.notation
          exact prod2
  have isField : IsField(ℚ, rationalAdd, rationalZero, rationalNeg, rationalMul, rationalOne)
    unfold IsField
    exact ⟨parts, nt, inv⟩
  have field : Field(rationalRing)
    unfold rationalRing
    exact Field.of_parts with isField
  have comm := Field.to_comm_ring at rationalRing with field
  have ringQ := CommRing.to_ring with comm
  have char : CharP(rationalRing, 0)
    unfold CharP
    refine ⟨ringQ, ?_⟩
    intros n nIn
    have nNat := nat.omega.backward with nIn
    rw (tkJ.rational.natCast at n)
    constructor
    . intro h
      have shape := natural.zero_or_successor at n with *
      cases shape with zero | successor
      . rw zero
        exact divides.zero at 0
      . exfalso
        obtain ⟨j, jNat, step⟩ := successor
        rw step at h
        have pos := rationalLess.positive_natural_successor at j
        have zeroEq : Ring.zero(rationalRing) = rationalZero by simp [rationalRing, Ring.mk.zero]
        rw zeroEq at h
        rw h at pos
        have irr := rationalLess.irreflexive at rationalZero
        exact irr with pos
    . intro d
      have z := zero.divides_only_zero at n with d
      rw z
      have zeroEq : Ring.zero(rationalRing) = rationalZero by simp [rationalRing, Ring.mk.zero]
      rw zeroEq
      unfold rationalZero
      rfl
  exact ⟨field, char⟩

-- Polynomial.cyclotomic.irreducible_rat: Φ_n is irreducible over ℚ.
theorem cyclotomic.irreducible_rat (n : Nat)
  requires positive : 0 < n
  shows RingIrreducible(polynomialRing(rationalRing, {0}), cyclotomic(rationalRing, n))
proof
  sorry

-- Section: The modular cyclotomic character
section Character
variable (L : Set) (n : Nat)
hypothesis domain : IntegralDomain(L)
hypothesis positive : 0 < n
hypothesis count : HasCardinality(rootsOfUnity(L, n), n)

-- Helpers: μ_n has a primitive n-th root when it has n elements, the
-- character as a function, and its values are units.
theorem tkJ.character.primitive
  shows ∃ g ∈ rootsOfUnity(L, n), IsPrimitiveRoot(L, g, n)
proof
  have comm := IntegralDomain.comm_ring at L with domain
  have ringL := CommRing.to_ring with comm
  obtain ⟨g, gIn, gen⟩ := rootsOfUnity.cyclic at L, n with comm, domain, positive
  obtain ⟨gu, gp⟩ := rootsOfUnity.membership.forward with gIn
  obtain ⟨gL, _⟩ := ringUnits.membership.forward with gu
  obtain ⟨e, eIn, ePos, eLe, gPrim⟩ := tkJ.order.exists at L, g, n with comm, gL, positive, gp
  have eNat := nat.omega.backward with eIn
  have gCopy := gPrim
  obtain ⟨_, ge, _⟩ := gCopy
  have sub : rootsOfUnity(L, n) ⊆ rootsOfUnity(L, e)
    intros x hx
    obtain ⟨xu, _⟩ := rootsOfUnity.membership.forward with hx
    obtain ⟨xL, _⟩ := ringUnits.membership.forward with xu
    obtain ⟨i, iIn, xi⟩ := gen with x, hx
    have iNat := nat.omega.backward with iIn
    have iffe := rootsOfUnity.mem_iff at L, x, e with comm, ePos, xL
    apply iffe.backward
    rw xi
    rw ← (Ring.pow_mul at L, g, i, e with ringL, gL)
    have ie : i * e = e * i by ring
    rw ie
    rw (Ring.pow_mul at L, g, e, i with ringL, gL)
    rw ge
    exact Ring.one_pow at L, i with ringL
  have bound := rootsOfUnity.card_le at L, e with comm, domain, ePos
  obtain ⟨finE, le⟩ := bound
  have mono := cardinality.monotone at rootsOfUnity(L, n), rootsOfUnity(L, e) with finE, sub
  have cn := cardinality.eq_of_has with count
  rw cn at mono
  have eNat2 := cardinality.nat with finE
  have eq : e = n by arith
  rw eq at gPrim
  exact ⟨g, gIn, gPrim⟩

theorem tkJ.character.function
  shows modularCyclotomicCharacter(L, n) : ringAutomorphisms(L) → Ring.carrier(zmod(n))
proof
  apply tkJ.fin_graph_function
  . intros u uIn
    obtain ⟨σ, σIn, e⟩ := modularCyclotomicCharacter.membership.forward with uIn
    have sel := cyclotomicCharValue.selected at L, n, σ with domain, positive, count, σIn
    rw ← e
    exact product.pair with σIn, sel.left
  . intros x y z hy hz
    obtain ⟨a, aIn, ea⟩ := modularCyclotomicCharacter.membership.forward with hy
    obtain ⟨b, bIn, eb⟩ := modularCyclotomicCharacter.membership.forward with hz
    obtain ⟨xa, ya⟩ := orderedPair.injective with ea
    obtain ⟨xb, zb⟩ := orderedPair.injective with eb
    rw [← ya, ← zb, xa, xb]
  . intros σ σIn
    have sel := cyclotomicCharValue.selected at L, n, σ with domain, positive, count, σIn
    refine ⟨cyclotomicCharValue(L, n, σ), sel.left, ?_⟩
    apply modularCyclotomicCharacter.membership.backward
    exact ⟨σ, σIn, rfl⟩

theorem tkJ.character.apply (σ : Set)
  requires automorphism : σ ∈ ringAutomorphisms(L)
  shows modularCyclotomicCharacter(L, n)(σ) = cyclotomicCharValue(L, n, σ)
proof
  have fun := tkJ.character.function at L, n with domain, positive, count
  have rel : relates(modularCyclotomicCharacter(L, n), σ, cyclotomicCharValue(L, n, σ))
    unfold relates
    apply modularCyclotomicCharacter.membership.backward
    exact ⟨σ, automorphism, rfl⟩
  exact FunctionBetween.apply_value with fun, automorphism, rel

theorem tkJ.character.unit (σ : Set)
  requires automorphism : σ ∈ ringAutomorphisms(L)
  shows cyclotomicCharValue(L, n, σ) ∈ ringUnits(zmod(n))
proof
  have comm := IntegralDomain.comm_ring at L with domain
  have sel := cyclotomicCharValue.selected at L, n, σ with domain, positive, count, automorphism
  obtain ⟨jIn, act⟩ := sel
  obtain ⟨g, gIn, gPrim⟩ := tkJ.character.primitive at L, n with domain, positive, count
  obtain ⟨_, iso⟩ := ringAutomorphisms.membership.forward with automorphism
  have hom := RingIso.hom_of at σ, L, L with iso
  have bij := RingIso.bijective_of at σ, L, L with iso
  have inj := Bijective.injective with bij
  have gCopy := gPrim
  obtain ⟨gL, _, _⟩ := gCopy
  have mi := IsPrimitiveRoot.map_iff at L, L, σ, g, n with comm, hom, inj, gL
  have sg := mi.backward with gPrim
  rw (act with g, gIn) at sg
  have spec := zmodVal.spec at n, cyclotomicCharValue(L, n, σ) with positive, jIn
  obtain ⟨vlt, vcast⟩ := spec
  have selV := zmodVal.selected at n, cyclotomicCharValue(L, n, σ) with positive, jIn
  have vNat := nat.omega.backward with selV.left
  have pc := IsPrimitiveRoot.pow_iff_coprime at L, g, n, zmodVal(n, cyclotomicCharValue(L, n, σ)) with comm, gPrim, positive
  have cop := pc.forward with sg
  have vZ : integerOfNat(zmodVal(n, cyclotomicCharValue(L, n, σ))) ∈ ℤ by typecheck
  have ui := zmod.unit_iff_coprime at n, integerOfNat(zmodVal(n, cyclotomicCharValue(L, n, σ))) with vZ
  have icop : IntegerCoprime(integerOfNat(zmodVal(n, cyclotomicCharValue(L, n, σ))), integerOfNat(n))
    unfold IntegerCoprime
    rw integerGCD.ofNat
    exact cop
  have u := ui.backward with icop
  rw vcast at u
  have uCopy := u
  obtain ⟨cIn, _⟩ := uCopy
  apply ringUnits.membership.backward
  exact ⟨cIn, u⟩

-- modularCyclotomicCharacter.spec: σ(ζ) = ζ^j on μ_n, with j a unit of
-- ℤ/nℤ, and the character is a homomorphism Aut(L) → (ℤ/nℤ)ˣ
-- (modularCyclotomicCharacter, MonoidHom).
theorem modularCyclotomicCharacter.spec (σ ζ : Set)
  requires automorphism : σ ∈ ringAutomorphisms(L)
  requires root : ζ ∈ rootsOfUnity(L, n)
  shows modularCyclotomicCharacter(L, n)(σ) ∈ ringUnits(zmod(n)) ∧
    σ(ζ) = Ring.pow(L, ζ, zmodVal(n, modularCyclotomicCharacter(L, n)(σ)))
proof
  have ap := tkJ.character.apply at L, n, σ with domain, positive, count, automorphism
  rw ap
  have unit := tkJ.character.unit at L, n, σ with domain, positive, count, automorphism
  have sel := cyclotomicCharValue.selected at L, n, σ with domain, positive, count, automorphism
  obtain ⟨_, act⟩ := sel
  have v := act with ζ, root
  exact ⟨unit, v⟩

theorem modularCyclotomicCharacter.mul (σ τ : Set)
  requires first : σ ∈ ringAutomorphisms(L)
  requires second : τ ∈ ringAutomorphisms(L)
  shows modularCyclotomicCharacter(L, n)(compose(σ, τ, Ring.carrier(L),
      Ring.carrier(L), Ring.carrier(L))) =
    call2(Ring.mul(zmod(n)), modularCyclotomicCharacter(L, n)(σ),
      modularCyclotomicCharacter(L, n)(τ))
proof
  have comm := IntegralDomain.comm_ring at L with domain
  have ringL := CommRing.to_ring with comm
  obtain ⟨_, σIso⟩ := ringAutomorphisms.membership.forward with first
  obtain ⟨_, τIso⟩ := ringAutomorphisms.membership.forward with second
  have σHom := RingIso.hom_of at σ, L, L with σIso
  have τHom := RingIso.hom_of at τ, L, L with τIso
  have σBij := RingIso.bijective_of at σ, L, L with σIso
  have τBij := RingIso.bijective_of at τ, L, L with τIso
  have σc := σHom
  obtain ⟨_, _, σFun, _⟩ := σc
  have τc := τHom
  obtain ⟨_, _, τFun, _⟩ := τc
  have compHom := RingHom.comp at τ, σ, L, L, L with comm, τHom, σHom
  have compBij := compose.bijective at σ, τ, Ring.carrier(L), Ring.carrier(L), Ring.carrier(L) with τBij, σBij
  have cc := compHom
  obtain ⟨_, _, compFun, _⟩ := cc
  have compIn : compose(σ, τ, Ring.carrier(L), Ring.carrier(L), Ring.carrier(L)) ∈ ringAutomorphisms(L)
    apply ringAutomorphisms.membership.backward
    have fs := functionSpace.mem_iff at compose(σ, τ, Ring.carrier(L), Ring.carrier(L), Ring.carrier(L)), Ring.carrier(L), Ring.carrier(L)
    have inFs := fs.backward with compFun
    have iso : RingIso(compose(σ, τ, Ring.carrier(L), Ring.carrier(L), Ring.carrier(L)), L, L)
      exact ⟨compHom, compBij⟩
    exact ⟨inFs, iso⟩
  rw (tkJ.character.apply at L, n, compose(σ, τ, Ring.carrier(L), Ring.carrier(L), Ring.carrier(L)) with domain, positive, count, compIn)
  rw (tkJ.character.apply at L, n, σ with domain, positive, count, first)
  rw (tkJ.character.apply at L, n, τ with domain, positive, count, second)
  have selS := cyclotomicCharValue.selected at L, n, σ with domain, positive, count, first
  obtain ⟨sIn, actS⟩ := selS
  have selT := cyclotomicCharValue.selected at L, n, τ with domain, positive, count, second
  obtain ⟨tIn, actT⟩ := selT
  have selC := cyclotomicCharValue.selected at L, n, compose(σ, τ, Ring.carrier(L), Ring.carrier(L), Ring.carrier(L)) with domain, positive, count, compIn
  obtain ⟨cIn, actC⟩ := selC
  have zb := tkJ.zmod.comm_ring at n
  obtain ⟨zc, _, _⟩ := zb
  have zr := CommRing.to_ring with zc
  have pIn : call2(Ring.mul(zmod(n)), cyclotomicCharValue(L, n, σ), cyclotomicCharValue(L, n, τ)) ∈ Ring.carrier(zmod(n)) by typecheck
  have vS := zmodVal.selected at n, cyclotomicCharValue(L, n, σ) with positive, sIn
  have aNat := nat.omega.backward with vS.left
  have vT := zmodVal.selected at n, cyclotomicCharValue(L, n, τ) with positive, tIn
  have bNat := nat.omega.backward with vT.left
  have vC := zmodVal.selected at n, cyclotomicCharValue(L, n, compose(σ, τ, Ring.carrier(L), Ring.carrier(L), Ring.carrier(L))) with positive, cIn
  have cNat := nat.omega.backward with vC.left
  have vP := zmodVal.selected at n, call2(Ring.mul(zmod(n)), cyclotomicCharValue(L, n, σ), cyclotomicCharValue(L, n, τ)) with positive, pIn
  have pNat := nat.omega.backward with vP.left
  have cLt := (zmodVal.spec at n, cyclotomicCharValue(L, n, compose(σ, τ, Ring.carrier(L), Ring.carrier(L), Ring.carrier(L))) with positive, cIn).left
  have pLt := (zmodVal.spec at n, call2(Ring.mul(zmod(n)), cyclotomicCharValue(L, n, σ), cyclotomicCharValue(L, n, τ)) with positive, pIn).left
  have pv := zmodVal.mul at n, cyclotomicCharValue(L, n, σ), cyclotomicCharValue(L, n, τ) with positive, sIn, tIn
  rw (integerMod.ofNat at zmodVal(n, cyclotomicCharValue(L, n, σ)) * zmodVal(n, cyclotomicCharValue(L, n, τ)), n with positive) at pv
  have same : ∀ ζ ∈ rootsOfUnity(L, n), Ring.pow(L, ζ, zmodVal(n, cyclotomicCharValue(L, n, compose(σ, τ, Ring.carrier(L), Ring.carrier(L), Ring.carrier(L))))) = Ring.pow(L, ζ, zmodVal(n, call2(Ring.mul(zmod(n)), cyclotomicCharValue(L, n, σ), cyclotomicCharValue(L, n, τ))))
    intros ζ hz
    obtain ⟨zu, zp⟩ := rootsOfUnity.membership.forward with hz
    obtain ⟨zL, _⟩ := ringUnits.membership.forward with zu
    rw ← (actC with ζ, hz)
    rw (compose.apply at σ, τ, Ring.carrier(L), Ring.carrier(L), Ring.carrier(L), ζ with τFun, σFun, zL)
    rw (actT with ζ, hz)
    rw (tkJ.hom_pow at σ, L, L, ζ, zmodVal(n, cyclotomicCharValue(L, n, τ)) with σHom, zL)
    rw (actS with ζ, hz)
    rw ← (Ring.pow_mul at L, ζ, zmodVal(n, cyclotomicCharValue(L, n, σ)), zmodVal(n, cyclotomicCharValue(L, n, τ)) with ringL, zL)
    rw pv
    have nz : n ≠ 0 by arith
    obtain ⟨q, qNat, mq⟩ := mod.equation at zmodVal(n, cyclotomicCharValue(L, n, σ)) * zmodVal(n, cyclotomicCharValue(L, n, τ)), n with nz
    have rNat : Nat((zmodVal(n, cyclotomicCharValue(L, n, σ)) * zmodVal(n, cyclotomicCharValue(L, n, τ))) % n) by typecheck
    have e := Ring.pow_add at L, ζ, n * q, (zmodVal(n, cyclotomicCharValue(L, n, σ)) * zmodVal(n, cyclotomicCharValue(L, n, τ))) % n with ringL, zL
    rw ← mq at e
    rw (Ring.pow_mul at L, ζ, n, q with ringL, zL) at e
    rw [zp, (Ring.one_pow at L, q with ringL)] at e
    rw e
    have rIn : Ring.pow(L, ζ, (zmodVal(n, cyclotomicCharValue(L, n, σ)) * zmodVal(n, cyclotomicCharValue(L, n, τ))) % n) ∈ Ring.carrier(L) := Ring.pow_mem at L, ζ, (zmodVal(n, cyclotomicCharValue(L, n, σ)) * zmodVal(n, cyclotomicCharValue(L, n, τ))) % n with ringL, zL
    ring
  have eqv := tkJ.roots.pow_eq at L, n, zmodVal(n, cyclotomicCharValue(L, n, compose(σ, τ, Ring.carrier(L), Ring.carrier(L), Ring.carrier(L)))), zmodVal(n, call2(Ring.mul(zmod(n)), cyclotomicCharValue(L, n, σ), cyclotomicCharValue(L, n, τ))) with comm, domain, count, cLt, pLt, same
  have inj := zmodVal.injective at n with positive
  exact inj with cyclotomicCharValue(L, n, compose(σ, τ, Ring.carrier(L), Ring.carrier(L), Ring.carrier(L))), cIn, call2(Ring.mul(zmod(n)), cyclotomicCharValue(L, n, σ), cyclotomicCharValue(L, n, τ)), pIn, eqv

-- Algebra automorphisms are ring automorphisms; restricted to Gal(L/K)
-- the character is a homomorphism to (ℤ/nℤ)ˣ, locally constant for the
-- Krull topology when L/K is algebraic (the continuity behind
-- cyclotomicCharacter.continuous, at the finite level n).
theorem modularCyclotomicCharacter.galois_hom (E : Set)
  requires extension : FieldExtension(E)
  requires ring : Algebra.ring(E) = L
  shows algebraAutomorphisms(E) ⊆ ringAutomorphisms(L) ∧
    GroupHom(restrict(modularCyclotomicCharacter(L, n), algebraAutomorphisms(E)),
      galoisGroup(E), unitGroup(zmod(n)))
proof
  have sub : algebraAutomorphisms(E) ⊆ ringAutomorphisms(L)
    intros σ hσ
    have h := tkJ.aut_ring_hom at E, σ with hσ
    have b := tkJ.aut_bijective at E, σ with hσ
    have f := tkJ.aut_function at E, σ with hσ
    unfold algebraCarrier at b
    unfold algebraCarrier at f
    rw ring at h
    rw ring at b
    rw ring at f
    apply ringAutomorphisms.membership.backward
    have fs := functionSpace.mem_iff at σ, Ring.carrier(L), Ring.carrier(L)
    have inFs := fs.backward with f
    have iso : RingIso(σ, L, L)
      exact ⟨h, b⟩
    exact ⟨inFs, iso⟩
  have zb := tkJ.zmod.comm_ring at n
  obtain ⟨zc, _, _⟩ := zb
  have fin := Finite.empty
  have unitG := unitGroup.group at zmod(n), ∅ with zc, fin
  have gal := galoisGroup.group at E with extension
  have chiFun := tkJ.character.function at L, n with domain, positive, count
  have closed : ∀ x ∈ algebraAutomorphisms(E), modularCyclotomicCharacter(L, n)(x) ∈ ringUnits(zmod(n))
    intros σ hσ
    have r := sub with σ, hσ
    rw (tkJ.character.apply at L, n, σ with domain, positive, count, r)
    exact tkJ.character.unit at L, n, σ with domain, positive, count, r
  have rf := restrict.function at modularCyclotomicCharacter(L, n), ringAutomorphisms(L), Ring.carrier(zmod(n)), algebraAutomorphisms(E), ringUnits(zmod(n)) with chiFun, sub, closed
  have resApply : ∀ x ∈ algebraAutomorphisms(E), restrict(modularCyclotomicCharacter(L, n), algebraAutomorphisms(E))(x) = modularCyclotomicCharacter(L, n)(x)
    intros x hx
    exact restrict.apply at modularCyclotomicCharacter(L, n), ringAutomorphisms(L), Ring.carrier(zmod(n)), algebraAutomorphisms(E), ringUnits(zmod(n)), x with chiFun, sub, closed, hx
  have hom : GroupHom(restrict(modularCyclotomicCharacter(L, n), algebraAutomorphisms(E)), galoisGroup(E), unitGroup(zmod(n)))
    unfold GroupHom
    rw [tkJ.galois_carrier, (unitGroup.carrier_eq at zmod(n), ∅ with zc, fin)]
    refine ⟨gal, unitG, rf, ?_⟩
    intros x hx y hy
    rw tkJ.galois_carrier at hx
    rw tkJ.galois_carrier at hy
    have compF := tkJ.autComposition_function at E
    have pairIn := product.pair at x, y, algebraAutomorphisms(E), algebraAutomorphisms(E) with hx, hy
    have compIn0 := FunctionBetween.apply_closed with compF, pairIn
    have compIn : call2(autComposition(E), x, y) ∈ algebraAutomorphisms(E)
      unfold call2
      exact compIn0
    rw (tkJ.galois_mul at E)
    have r0 := resApply with call2(autComposition(E), x, y), compIn
    rw r0
    rw (resApply with x, hx)
    rw (resApply with y, hy)
    have cx := closed with x, hx
    have cy := closed with y, hy
    rw (unitGroup.mul_eq at zmod(n), ∅, modularCyclotomicCharacter(L, n)(x), modularCyclotomicCharacter(L, n)(y) with zc, fin, cx, cy)
    rw (tkJ.autComposition_apply at E, x, y with hx, hy)
    unfold algebraCarrier
    rw ring
    have sx := sub with x, hx
    have sy := sub with y, hy
    exact modularCyclotomicCharacter.mul at L, n, x, y with domain, positive, count, sx, sy
  exact ⟨sub, hom⟩

-- Helpers: an automorphism fixing μ_n has character 1, and the roots of
-- unity are integral.
theorem tkJ.character.fixes_roots (σ : Set)
  requires automorphism : σ ∈ ringAutomorphisms(L)
  requires fixes : ∀ ζ ∈ rootsOfUnity(L, n), σ(ζ) = ζ
  shows cyclotomicCharValue(L, n, σ) = Ring.one(zmod(n))
proof
  have comm := IntegralDomain.comm_ring at L with domain
  have ringL := CommRing.to_ring with comm
  have sel := cyclotomicCharValue.selected at L, n, σ with domain, positive, count, automorphism
  obtain ⟨jIn, act⟩ := sel
  have zb := tkJ.zmod.comm_ring at n
  obtain ⟨zc, _, _⟩ := zb
  have zr := CommRing.to_ring with zc
  have oneIn : Ring.one(zmod(n)) ∈ Ring.carrier(zmod(n)) by typecheck
  have oneVal : zmodVal(n, Ring.one(zmod(n))) = 1 % n
    rw ← (tkJ.zmodCast.one at n)
    unfold integerOne
    rw (zmodVal.nat_cast at n, 1 with positive)
    rw (integerMod.ofNat at 1, n with positive)
  have sj := zmodVal.spec at n, cyclotomicCharValue(L, n, σ) with positive, jIn
  obtain ⟨jlt, _⟩ := sj
  have so := zmodVal.spec at n, Ring.one(zmod(n)) with positive, oneIn
  obtain ⟨olt, _⟩ := so
  have selJ := zmodVal.selected at n, cyclotomicCharValue(L, n, σ) with positive, jIn
  have jN := nat.omega.backward with selJ.left
  have selO := zmodVal.selected at n, Ring.one(zmod(n)) with positive, oneIn
  have oN := nat.omega.backward with selO.left
  have nz : n ≠ 0 by arith
  have same : ∀ ζ ∈ rootsOfUnity(L, n), Ring.pow(L, ζ, zmodVal(n, cyclotomicCharValue(L, n, σ))) = Ring.pow(L, ζ, zmodVal(n, Ring.one(zmod(n))))
    intros ζ hz
    rw ← (act with ζ, hz)
    rw (fixes with ζ, hz)
    rw oneVal
    obtain ⟨zu, zp⟩ := rootsOfUnity.membership.forward with hz
    obtain ⟨zL, _⟩ := ringUnits.membership.forward with zu
    obtain ⟨q, qNat, mq⟩ := mod.equation at 1, n with nz
    have rNat : Nat(1 % n) by typecheck
    have e := Ring.pow_add at L, ζ, n * q, 1 % n with ringL, zL
    rw ← mq at e
    rw (Ring.pow_mul at L, ζ, n, q with ringL, zL) at e
    rw [zp, (Ring.one_pow at L, q with ringL)] at e
    rw (Ring.pow_one at L, ζ with ringL, zL) at e
    have rIn : Ring.pow(L, ζ, 1 % n) ∈ Ring.carrier(L) := Ring.pow_mem at L, ζ, 1 % n with ringL, zL
    have t : call2(Ring.mul(L), Ring.one(L), Ring.pow(L, ζ, 1 % n)) = Ring.pow(L, ζ, 1 % n) by ring
    rw t at e
    exact e
  have eqv := tkJ.roots.pow_eq at L, n, zmodVal(n, cyclotomicCharValue(L, n, σ)), zmodVal(n, Ring.one(zmod(n))) with comm, domain, count, jlt, olt, same
  have inj := zmodVal.injective at n with positive
  exact inj with cyclotomicCharValue(L, n, σ), jIn, Ring.one(zmod(n)), oneIn, eqv

theorem modularCyclotomicCharacter.locally_constant (E : Set)
  requires algebraic : AlgebraicExtension(E)
  requires ring : Algebra.ring(E) = L
  shows IsLocallyConstant(restrict(modularCyclotomicCharacter(L, n),
    algebraAutomorphisms(E)), krullTopology(E))
proof
  have comm := IntegralDomain.comm_ring at L with domain
  have ringL := CommRing.to_ring with comm
  have alg := algebraic
  obtain ⟨extension, _⟩ := alg
  have ext2 := extension
  obtain ⟨algebra, _, _⟩ := ext2
  have gh := modularCyclotomicCharacter.galois_hom at L, n, E with domain, positive, count, extension, ring
  obtain ⟨sub, _⟩ := gh
  have tg := krullTopology.topological_group at E with extension
  obtain ⟨ts, _⟩ := tg
  have carrierOf : TopologicalSpace.carrier(krullTopology(E)) = algebraAutomorphisms(E)
    simp [krullTopology, TopologicalSpace.mk.carrier]
  have opensOf : TopologicalSpace.opens(krullTopology(E)) = krullOpens(E)
    simp [krullTopology, TopologicalSpace.mk.opens]
  have muSub : rootsOfUnity(L, n) ⊆ algebraCarrier(E)
    intros x hx
    obtain ⟨xu, _⟩ := rootsOfUnity.membership.forward with hx
    obtain ⟨xL, _⟩ := ringUnits.membership.forward with xu
    unfold algebraCarrier
    rw ring
    exact xL
  have finMu := Finite.from_cardinality with count
  have integral : ∀ x ∈ rootsOfUnity(L, n), IntegralElement(E, x)
    intros x hx
    obtain ⟨xu, xp⟩ := rootsOfUnity.membership.forward with hx
    obtain ⟨xL, _⟩ := ringUnits.membership.forward with xu
    obtain ⟨e, eIn, ePos, _, xPrim⟩ := tkJ.order.exists at L, x, n with comm, xL, positive, xp
    have eNat := nat.omega.backward with eIn
    exact IsPrimitiveRoot.integral at L, E, x, e with comm, algebra, ring, xPrim, ePos
  have finF := fieldAdjoin.finite_of_finite at E, rootsOfUnity(L, n) with extension, muSub, finMu, integral
  have inter := fieldAdjoin.intermediate at E, rootsOfUnity(L, n) with extension, muSub
  have pwF := (tkJ.intermediate_member at E, fieldAdjoin(E, rootsOfUnity(L, n))).backward with inter
  have Fmem : fieldAdjoin(E, rootsOfUnity(L, n)) ∈ finiteSubfields(E)
    apply finiteSubfields.membership.backward
    exact ⟨pwF, finF⟩
  have muF := fieldAdjoin.subset_adjoin at E, rootsOfUnity(L, n) with extension, muSub
  have chiFun := tkJ.character.function at L, n with domain, positive, count
  have closed : ∀ x ∈ algebraAutomorphisms(E), modularCyclotomicCharacter(L, n)(x) ∈ Ring.carrier(zmod(n))
    intros x hx
    have r := sub with x, hx
    exact FunctionBetween.apply_closed with chiFun, r
  have resApply : ∀ x ∈ algebraAutomorphisms(E), restrict(modularCyclotomicCharacter(L, n), algebraAutomorphisms(E))(x) = modularCyclotomicCharacter(L, n)(x)
    intros x hx
    exact restrict.apply at modularCyclotomicCharacter(L, n), ringAutomorphisms(L), Ring.carrier(zmod(n)), algebraAutomorphisms(E), Ring.carrier(zmod(n)), x with chiFun, sub, closed, hx
  have zb := tkJ.zmod.comm_ring at n
  obtain ⟨zc, _, _⟩ := zb
  unfold IsLocallyConstant
  refine ⟨ts, ?_⟩
  intros B
  rw [carrierOf, opensOf]
  have bounded := functionPreimage.subset at restrict(modularCyclotomicCharacter(L, n), algebraAutomorphisms(E)), algebraAutomorphisms(E), B
  have pw := (powerset.membership_iff at functionPreimage(restrict(modularCyclotomicCharacter(L, n), algebraAutomorphisms(E)), algebraAutomorphisms(E), B), algebraAutomorphisms(E)).backward with bounded
  apply krullOpens.membership.backward
  refine ⟨pw, ?_⟩
  intros σ σIn
  refine ⟨fieldAdjoin(E, rootsOfUnity(L, n)), Fmem, ?_⟩
  intros y yIn
  obtain ⟨τ, τIn, yEq⟩ := autCoset.membership.forward with yIn
  obtain ⟨τA, τFix⟩ := fixingSubgroup.membership.forward with τIn
  obtain ⟨σA, σB⟩ := functionPreimage.membership.forward with σIn
  rw [← yEq, tkJ.galois_mul, (tkJ.autComposition_apply at E, σ, τ with σA, τA)]
  have mem := tkJ.aut_compose_mem at E, σ, τ with σA, τA
  apply functionPreimage.membership.backward
  refine ⟨mem, ?_⟩
  rw (resApply with compose(σ, τ, algebraCarrier(E), algebraCarrier(E), algebraCarrier(E)), mem)
  rw (resApply with σ, σA) at σB
  have sσ := sub with σ, σA
  have sτ := sub with τ, τA
  have m := modularCyclotomicCharacter.mul at L, n, σ, τ with domain, positive, count, sσ, sτ
  have ac : algebraCarrier(E) = Ring.carrier(L)
    unfold algebraCarrier
    rw ring
  rw ac
  rw m
  have τfixes : ∀ ζ ∈ rootsOfUnity(L, n), τ(ζ) = ζ
    intros ζ hz
    have zF := muF with ζ, hz
    exact τFix with ζ, zF
  have one := tkJ.character.fixes_roots at L, n, τ with domain, positive, count, sτ, τfixes
  rw (tkJ.character.apply at L, n, τ with domain, positive, count, sτ)
  rw one
  have cIn := FunctionBetween.apply_closed with chiFun, sσ
  have zr := CommRing.to_ring with zc
  have t : call2(Ring.mul(zmod(n)), modularCyclotomicCharacter(L, n)(σ), Ring.one(zmod(n))) = modularCyclotomicCharacter(L, n)(σ) by ring
  rw t
  exact σB

end Character

-- The points where two maps agree.
def tkJEqualizer (f g A : Set) : Set := { x ∈ A | f(x) = g(x) }

-- Helper: a subring contains the powers of its elements.
theorem tkJ.subring.pow_mem (R S x : Set) (k : Nat)
  requires ring : Ring(R)
  requires subring : IsSubring(Ring.carrier(R), Ring.add(R), Ring.zero(R),
    Ring.neg(R), Ring.mul(R), Ring.one(R), S)
  requires member : x ∈ S
  shows Ring.pow(R, x, k) ∈ S
proof
  have inside := IsSubring.subset_carrier with subring
  have xR := inside with x, member
  induction k
  | zero =>
    rw (Ring.pow_zero at R, x with ring, xR)
    exact IsSubring.one_closed with subring
  | succ(j) using ih =>
    have shift := add.right_one at j with *
    rw ← shift
    rw (Ring.pow_succ at R, x, j with ring, xR)
    have mc := IsSubring.mul_closed with subring
    unfold ClosedBinary at mc
    exact mc with Ring.pow(R, x, j), ih, x, member

-- Section: Cyclotomic extensions of fields
section CyclotomicFields
variable (E : Set)
hypothesis extension : FieldExtension(E)

-- IsCyclotomicExtension.zeta_spec: a primitive n-th root ζ of a
-- {n}-cyclotomic extension, and IsCyclotomicExtension.adjoin_primitive_root_eq_top:
-- L = K(ζ).
theorem IsCyclotomicExtension.zeta_spec (n : Nat)
  requires positive : 0 < n
  requires cyclotomic : IsCyclotomicExtension({n}, E)
  shows ∃ ζ ∈ algebraCarrier(E), IsPrimitiveRoot(Algebra.ring(E), ζ, n)
proof
  have c := cyclotomic
  obtain ⟨_, _, prim, _⟩ := c
  have nIn : n ∈ {n} := singleton.membership.backward at n, n with rfl
  exact prim with n, nIn, positive

theorem IsCyclotomicExtension.adjoin_primitive_root (ζ : Set) (n : Nat)
  requires positive : 0 < n
  requires cyclotomic : IsCyclotomicExtension({n}, E)
  requires primitive : IsPrimitiveRoot(Algebra.ring(E), ζ, n)
  shows fieldAdjoin(E, {ζ}) = algebraCarrier(E) ∧ adjoinOf(E, {ζ}) = algebraCarrier(E)
proof
  have ext := extension
  obtain ⟨algebra, _, fieldL⟩ := ext
  have commL := Field.to_comm_ring at Algebra.ring(E) with fieldL
  have ringL := CommRing.to_ring with commL
  have domL := Field.domain at Algebra.ring(E) with fieldL
  have c := cyclotomic
  obtain ⟨_, _, _, top⟩ := c
  have primCopy := primitive
  obtain ⟨zIn, _, _⟩ := primCopy
  have zSub : {ζ} ⊆ algebraCarrier(E)
    intros x hx
    have e := singleton.membership.forward with hx
    rw e
    unfold algebraCarrier
    exact zIn
  have adj := adjoinOf.subalgebra at E, {ζ} with algebra, zSub
  obtain ⟨sub, contains⟩ := adj
  have subCopy := sub
  obtain ⟨_, subalg⟩ := subCopy
  obtain ⟨subring, _⟩ := subalg
  unfold algebraCarrier at subring
  have zs : ζ ∈ {ζ} := singleton.membership.backward at ζ, ζ with rfl
  have zA := contains with ζ, zs
  have gensBounded : cyclotomicGenerators(E, {n}) ⊆ algebraCarrier(E)
    intros x hx
    obtain ⟨xIn, _⟩ := cyclotomicGenerators.membership.forward with hx
    exact xIn
  have gens : cyclotomicGenerators(E, {n}) ⊆ adjoinOf(E, {ζ})
    intros x hx
    obtain ⟨xIn, m, mIn, mPos, xm⟩ := cyclotomicGenerators.membership.forward with hx
    have mn := singleton.membership.forward with mIn
    rw mn at xm
    unfold algebraCarrier at xIn
    obtain ⟨i, iN, _, e⟩ := IsPrimitiveRoot.eq_pow_of_pow_eq_one at Algebra.ring(E), ζ, x, n with commL, domL, primitive, positive, xIn, xm
    have iNat := nat.omega.backward with iN
    rw e
    exact tkJ.subring.pow_mem at Algebra.ring(E), adjoinOf(E, {ζ}), ζ, i with ringL, subring, zA
  have least := adjoinOf.least at E, cyclotomicGenerators(E, {n}), adjoinOf(E, {ζ}) with algebra, gensBounded, sub
  have le := least.backward with gens
  rw top at le
  have adjBounded := IsSubring.subset_carrier with subring
  have adjBounded2 : adjoinOf(E, {ζ}) ⊆ algebraCarrier(E)
    unfold algebraCarrier
    exact adjBounded
  have adjEq := Subset.antisymmetric with adjBounded2, le
  have inter := fieldAdjoin.intermediate at E, {ζ} with extension, zSub
  obtain ⟨_, subF, _⟩ := inter
  have fs := fieldAdjoin.subset_adjoin at E, {ζ} with extension, zSub
  have least2 := adjoinOf.least at E, {ζ}, fieldAdjoin(E, {ζ}) with algebra, zSub, subF
  have le2 := least2.backward with fs
  rw adjEq at le2
  have fBounded : fieldAdjoin(E, {ζ}) ⊆ algebraCarrier(E)
    intros x hx
    obtain ⟨xIn, _⟩ := fieldAdjoin.membership.forward with hx
    exact xIn
  have fEq := Subset.antisymmetric with fBounded, le2
  exact ⟨fEq, adjEq⟩

-- IntermediateField.isCyclotomicExtension_adjoin_of_exists_isPrimitiveRoot,
-- IsPrimitiveRoot.intermediateField_adjoin_isCyclotomicExtension: K(ζ)
-- is {n}-cyclotomic over K.
theorem IsPrimitiveRoot.adjoin_cyclotomic (ζ : Set) (n : Nat)
  requires positive : 0 < n
  requires primitive : IsPrimitiveRoot(Algebra.ring(E), ζ, n)
  shows IsCyclotomicExtension({n}, subextension(E, fieldAdjoin(E, {ζ})))
proof
  have ext := extension
  obtain ⟨algebra, _, fieldL⟩ := ext
  have commL := Field.to_comm_ring at Algebra.ring(E) with fieldL
  have ringL := CommRing.to_ring with commL
  have primCopy := primitive
  obtain ⟨zIn, zOne, _⟩ := primCopy
  have zSub : {ζ} ⊆ algebraCarrier(E)
    intros x hx
    have e := singleton.membership.forward with hx
    rw e
    unfold algebraCarrier
    exact zIn
  have inter := fieldAdjoin.intermediate at E, {ζ} with extension, zSub
  have alg2 := tkJ.subextension_algebra at E, fieldAdjoin(E, {ζ}) with inter
  have fe := IntermediateField.subextension_field at E, fieldAdjoin(E, {ζ}) with extension, inter
  obtain ⟨fe2, _⟩ := fe
  have fe2c := fe2
  obtain ⟨_, _, field2⟩ := fe2c
  have comm2 := Field.to_comm_ring at Algebra.ring(subextension(E, fieldAdjoin(E, {ζ}))) with field2
  have zs : ζ ∈ {ζ} := singleton.membership.backward at ζ, ζ with rfl
  have zF := (fieldAdjoin.subset_adjoin at E, {ζ} with extension, zSub) with ζ, zs
  have incl := tkJ.sub_inclusion_hom at E, fieldAdjoin(E, {ζ}) with extension, inter
  have inclRing := AlgebraHom.ring_hom at identity(fieldAdjoin(E, {ζ})), subextension(E, fieldAdjoin(E, {ζ})), E with incl
  have ic := inclRing
  obtain ⟨_, _, inclFun, _⟩ := ic
  have carrier2 : Ring.carrier(Algebra.ring(subextension(E, fieldAdjoin(E, {ζ})))) = fieldAdjoin(E, {ζ})
    have c := tkJ.sub_carrier at E, fieldAdjoin(E, {ζ})
    unfold algebraCarrier at c
    exact c
  have zF2 : ζ ∈ Ring.carrier(Algebra.ring(subextension(E, fieldAdjoin(E, {ζ}))))
    rw carrier2
    exact zF
  have inj : InjectiveBetween(identity(fieldAdjoin(E, {ζ})), Ring.carrier(Algebra.ring(subextension(E, fieldAdjoin(E, {ζ})))), Ring.carrier(Algebra.ring(E)))
    apply Injective.of_pointwise with inclFun
    intros x hx y hy e
    rw carrier2 at hx
    rw carrier2 at hy
    rw [(identity.apply at x, fieldAdjoin(E, {ζ}) with hx), (identity.apply at y, fieldAdjoin(E, {ζ}) with hy)] at e
    exact e
  have mi := IsPrimitiveRoot.map_iff at Algebra.ring(subextension(E, fieldAdjoin(E, {ζ}))), Algebra.ring(E), identity(fieldAdjoin(E, {ζ})), ζ, n with comm2, inclRing, inj, zF2
  rw (identity.apply at ζ, fieldAdjoin(E, {ζ}) with zF) at mi
  have prim2 := mi.forward with primitive
  have nSub : {n} ⊆ ℕ
    intros x hx
    have e := singleton.membership.forward with hx
    rw e
    typecheck
  have nIn : n ∈ {n} := singleton.membership.backward at n, n with rfl
  have hasPrim : ∀ m ∈ {n}, 0 < m → (∃ z ∈ algebraCarrier(subextension(E, fieldAdjoin(E, {ζ}))), IsPrimitiveRoot(Algebra.ring(subextension(E, fieldAdjoin(E, {ζ}))), z, m))
    intros m hm mpos
    have e := singleton.membership.forward with hm
    rw e
    have zA : ζ ∈ algebraCarrier(subextension(E, fieldAdjoin(E, {ζ})))
      unfold algebraCarrier
      exact zF2
    exact ⟨ζ, zA, prim2⟩
  have gensBound : cyclotomicGenerators(subextension(E, fieldAdjoin(E, {ζ})), {n}) ⊆ algebraCarrier(subextension(E, fieldAdjoin(E, {ζ})))
    intros x hx
    obtain ⟨xIn, _⟩ := cyclotomicGenerators.membership.forward with hx
    exact xIn
  have sa := adjoinOf.subalgebra at subextension(E, fieldAdjoin(E, {ζ})), cyclotomicGenerators(subextension(E, fieldAdjoin(E, {ζ})), {n}) with alg2, gensBound
  obtain ⟨sub2, contains2⟩ := sa
  have sub2c := sub2
  obtain ⟨_, subalg⟩ := sub2c
  obtain ⟨subring, imageSub⟩ := subalg
  have upper := IsSubring.subset_carrier with subring
  have zG : ζ ∈ cyclotomicGenerators(subextension(E, fieldAdjoin(E, {ζ})), {n})
    apply cyclotomicGenerators.membership.backward
    have zA : ζ ∈ algebraCarrier(subextension(E, fieldAdjoin(E, {ζ})))
      unfold algebraCarrier
      exact zF2
    have p2c := prim2
    obtain ⟨_, z2One, _⟩ := p2c
    exact ⟨zA, n, nIn, positive, z2One⟩
  have zP := contains2 with ζ, zG
  have integ := IsPrimitiveRoot.integral at Algebra.ring(E), E, ζ, n with commL, algebra, rfl, primitive, positive
  have allInt : ∀ x ∈ {ζ}, IntegralElement(E, x)
    intros x hx
    have e := singleton.membership.forward with hx
    rw e
    exact integ
  have fa := fieldAdjoin.eq_algebra_adjoin at E, {ζ} with extension, zSub, allInt
  have addOf : Ring.add(Algebra.ring(subextension(E, fieldAdjoin(E, {ζ})))) = restrict(Ring.add(Algebra.ring(E)), fieldAdjoin(E, {ζ}) × fieldAdjoin(E, {ζ}))
    rw tkJ.sub_ring
    simp [subringRing, Ring.mk.add]
  have mulOf : Ring.mul(Algebra.ring(subextension(E, fieldAdjoin(E, {ζ})))) = restrict(Ring.mul(Algebra.ring(E)), fieldAdjoin(E, {ζ}) × fieldAdjoin(E, {ζ}))
    rw tkJ.sub_ring
    simp [subringRing, Ring.mk.mul]
  have parts := CommRing.parts with commL
  have ringParts := IsCommRing.ring with parts
  obtain ⟨ab, mulmon, _⟩ := ringParts
  obtain ⟨grp, _⟩ := ab
  obtain ⟨amon, _⟩ := grp
  obtain ⟨asemi, _⟩ := amon
  obtain ⟨amagma, _⟩ := asemi
  obtain ⟨msemi, _⟩ := mulmon
  obtain ⟨mmagma, _⟩ := msemi
  unfold IsMagma at amagma
  unfold IsMagma at mmagma
  have Fsub : fieldAdjoin(E, {ζ}) ⊆ Ring.carrier(Algebra.ring(E))
    intros x hx
    obtain ⟨xIn, _⟩ := fieldAdjoin.membership.forward with hx
    unfold algebraCarrier at xIn
    exact xIn
  have upper2 := upper
  unfold algebraCarrier at upper2
  rw carrier2 at upper2
  have scalars : ∀ r ∈ Ring.carrier(Algebra.base(E)), Algebra.map(E)(r) ∈ adjoinOf(subextension(E, fieldAdjoin(E, {ζ})), cyclotomicGenerators(subextension(E, fieldAdjoin(E, {ζ})), {n}))
    intros r rIn
    have sh := tkJ.sub_structure_hom at E, fieldAdjoin(E, {ζ}) with extension, inter
    obtain ⟨_, _, shFun, _⟩ := sh
    have v := functionImage.value at Algebra.map(E), Ring.carrier(Algebra.base(E)), Ring.carrier(subringRing(Algebra.ring(E), fieldAdjoin(E, {ζ}))), r with shFun, rIn
    rw [tkJ.sub_map, tkJ.sub_base] at imageSub
    unfold algebraCarrier at imageSub
    rw tkJ.sub_ring at imageSub
    exact imageSub with Algebra.map(E)(r), v
  have sums : ∀ x ∈ adjoinOf(subextension(E, fieldAdjoin(E, {ζ})), cyclotomicGenerators(subextension(E, fieldAdjoin(E, {ζ})), {n})) ∩ algebraCarrier(E), ∀ y ∈ adjoinOf(subextension(E, fieldAdjoin(E, {ζ})), cyclotomicGenerators(subextension(E, fieldAdjoin(E, {ζ})), {n})) ∩ algebraCarrier(E), call2(Ring.add(Algebra.ring(E)), x, y) ∈ adjoinOf(subextension(E, fieldAdjoin(E, {ζ})), cyclotomicGenerators(subextension(E, fieldAdjoin(E, {ζ})), {n}))
    intros x hx y hy
    obtain ⟨xP, _⟩ := intersection.membership.forward with hx
    obtain ⟨yP, _⟩ := intersection.membership.forward with hy
    have xF := upper2 with x, xP
    have yF := upper2 with y, yP
    have ac := IsSubring.add_closed with subring
    unfold ClosedBinary at ac
    have s := ac with x, xP, y, yP
    rw addOf at s
    rw (restrict.call2 at Ring.add(Algebra.ring(E)), Ring.carrier(Algebra.ring(E)), Ring.carrier(Algebra.ring(E)), fieldAdjoin(E, {ζ}), x, y with amagma, Fsub, xF, yF) at s
    exact s
  have products : ∀ x ∈ adjoinOf(subextension(E, fieldAdjoin(E, {ζ})), cyclotomicGenerators(subextension(E, fieldAdjoin(E, {ζ})), {n})) ∩ algebraCarrier(E), ∀ y ∈ adjoinOf(subextension(E, fieldAdjoin(E, {ζ})), cyclotomicGenerators(subextension(E, fieldAdjoin(E, {ζ})), {n})) ∩ algebraCarrier(E), call2(Ring.mul(Algebra.ring(E)), x, y) ∈ adjoinOf(subextension(E, fieldAdjoin(E, {ζ})), cyclotomicGenerators(subextension(E, fieldAdjoin(E, {ζ})), {n}))
    intros x hx y hy
    obtain ⟨xP, _⟩ := intersection.membership.forward with hx
    obtain ⟨yP, _⟩ := intersection.membership.forward with hy
    have xF := upper2 with x, xP
    have yF := upper2 with y, yP
    have mc := IsSubring.mul_closed with subring
    unfold ClosedBinary at mc
    have s := mc with x, xP, y, yP
    rw mulOf at s
    rw (restrict.call2 at Ring.mul(Algebra.ring(E)), Ring.carrier(Algebra.ring(E)), Ring.carrier(Algebra.ring(E)), fieldAdjoin(E, {ζ}), x, y with mmagma, Fsub, xF, yF) at s
    exact s
  have gens : {ζ} ⊆ adjoinOf(subextension(E, fieldAdjoin(E, {ζ})), cyclotomicGenerators(subextension(E, fieldAdjoin(E, {ζ})), {n}))
    intros x hx
    have e := singleton.membership.forward with hx
    rw e
    exact zP
  have ind := adjoinOf.induction at E, {ζ}, adjoinOf(subextension(E, fieldAdjoin(E, {ζ})), cyclotomicGenerators(subextension(E, fieldAdjoin(E, {ζ})), {n})) with algebra, zSub, gens, scalars, sums, products
  rw ← fa at ind
  have lower : algebraCarrier(subextension(E, fieldAdjoin(E, {ζ}))) ⊆ adjoinOf(subextension(E, fieldAdjoin(E, {ζ})), cyclotomicGenerators(subextension(E, fieldAdjoin(E, {ζ})), {n}))
    rw tkJ.sub_carrier
    exact ind
  have eqA := Subset.antisymmetric with upper, lower
  unfold IsCyclotomicExtension
  exact ⟨alg2, nSub, hasPrim, eqA⟩

-- IsCyclotomicExtension of S ⊆ T: an extension cyclotomic for {m}
-- contains primitive n-th roots for n ∣ m (IsCyclotomicExtension.le_of_dvd
-- in its consequence for roots).
theorem IsCyclotomicExtension.primitive_of_dvd (m n : Nat)
  requires positive : 0 < n
  requires divides : n ∣ m
  requires largePositive : 0 < m
  requires cyclotomic : IsCyclotomicExtension({m}, E)
  shows ∃ ζ ∈ algebraCarrier(E), IsPrimitiveRoot(Algebra.ring(E), ζ, n)
proof
  have ext := extension
  obtain ⟨algebra, _, fieldL⟩ := ext
  have commL := Field.to_comm_ring at Algebra.ring(E) with fieldL
  obtain ⟨ζ, zIn, prim⟩ := IsCyclotomicExtension.zeta_spec at E, m with extension, largePositive, cyclotomic
  obtain ⟨q, qNat, e⟩ := divides
  have shape : m = q * n
    rw ← e
    ring
  rw shape at prim
  have qPos : 0 < q
    by_contra none
    have q0 : q = 0 by arith
    rw q0 at shape
    arith
  have p := IsPrimitiveRoot.pow_of_dvd at Algebra.ring(E), ζ, q, n with commL, prim, qPos
  have pIn : Ring.pow(Algebra.ring(E), ζ, q) ∈ algebraCarrier(E)
    unfold algebraCarrier at zIn
    unfold algebraCarrier
    have ringL := CommRing.to_ring with commL
    exact Ring.pow_mem at Algebra.ring(E), ζ, q with ringL, zIn
  exact ⟨Ring.pow(Algebra.ring(E), ζ, q), pIn, p⟩

-- A finite set S of orders, invertible in K, gives a finite Galois
-- extension with abelian Galois group (IsCyclotomicExtension.finiteDimensional,
-- IsCyclotomicExtension.isGalois, IsCyclotomicExtension.isAbelianGalois).
theorem IsCyclotomicExtension.finite_galois (S : Set)
  requires cyclotomic : IsCyclotomicExtension(S, E)
  requires finite : Finite(S)
  requires invertible : ∀ n ∈ S, natCast(Algebra.base(E), n) ≠ Ring.zero(Algebra.base(E))
  shows FiniteExtension(E) ∧ GaloisExtension(E) ∧ AbelianGroup(galoisGroup(E))
proof
  sorry

-- The cyclotomic polynomial splits in an {n}-cyclotomic extension and
-- generates it: L is a splitting field of Φ_n (IsCyclotomicExtension.splitting_field_cyclotomic).
theorem IsCyclotomicExtension.splitting_field (n : Nat)
  requires positive : 0 < n
  requires cyclotomic : IsCyclotomicExtension({n}, E)
  requires invertible : natCast(Algebra.base(E), n) ≠ Ring.zero(Algebra.base(E))
  shows IsSplittingField(E, cyclotomic(Algebra.base(E), n))
proof
  sorry

-- CyclotomicField n K with CyclotomicField.isCyclotomicExtension: a
-- {n}-cyclotomic extension exists when n · 1 ≠ 0 in K (stated as
-- existence; no field is chosen), unique up to K-isomorphism
-- (IsCyclotomicExtension.algEquiv).
theorem IsCyclotomicExtension.exists (n : Nat)
  requires positive : 0 < n
  requires invertible : natCast(Algebra.base(E), n) ≠ Ring.zero(Algebra.base(E))
  shows ∃ E2, Algebra.base(E2) = Algebra.base(E) ∧ FieldExtension(E2) ∧
    IsCyclotomicExtension({n}, E2)
proof
  sorry

theorem IsCyclotomicExtension.unique (E2 : Set) (n : Nat)
  requires positive : 0 < n
  requires second : FieldExtension(E2)
  requires sameBase : Algebra.base(E2) = Algebra.base(E)
  requires first : IsCyclotomicExtension({n}, E)
  requires secondCyclotomic : IsCyclotomicExtension({n}, E2)
  shows ∃ f, f : E ≃ₐ E2
proof
  sorry

-- IsCyclotomicExtension.autEquivPow: when Φ_n is irreducible over K,
-- σ ↦ (the j with σ(ζ) = ζ^j) is an isomorphism Gal(L/K) ≅ (ℤ/nℤ)ˣ;
-- in general it is an injective homomorphism
-- (IsPrimitiveRoot.autToPow_injective).
theorem IsCyclotomicExtension.character_injective (n : Nat)
  requires positive : 0 < n
  requires cyclotomic : IsCyclotomicExtension({n}, E)
  requires invertible : natCast(Algebra.base(E), n) ≠ Ring.zero(Algebra.base(E))
  shows GroupHom(restrict(modularCyclotomicCharacter(Algebra.ring(E), n),
      algebraAutomorphisms(E)), galoisGroup(E), unitGroup(zmod(n))) ∧
    InjectiveBetween(restrict(modularCyclotomicCharacter(Algebra.ring(E), n),
      algebraAutomorphisms(E)), algebraAutomorphisms(E), ringUnits(zmod(n)))
proof
  have ext := extension
  obtain ⟨algebra, _, fieldL⟩ := ext
  have commL := Field.to_comm_ring at Algebra.ring(E) with fieldL
  have ringL := CommRing.to_ring with commL
  have domL := Field.domain at Algebra.ring(E) with fieldL
  obtain ⟨ζ, zIn, prim⟩ := IsCyclotomicExtension.zeta_spec at E, n with extension, positive, cyclotomic
  have cr := IsPrimitiveRoot.card_roots at Algebra.ring(E), ζ, n with commL, domL, prim, positive
  obtain ⟨count, _⟩ := cr
  have same : Algebra.ring(E) = Algebra.ring(E) by rfl
  have gh := modularCyclotomicCharacter.galois_hom at Algebra.ring(E), n, E with domL, positive, count, extension, same
  obtain ⟨sub, hom⟩ := gh
  refine ⟨hom, ?_⟩
  have zb := tkJ.zmod.comm_ring at n
  obtain ⟨zc, _, _⟩ := zb
  have fin := Finite.empty
  have hc := hom
  obtain ⟨_, _, fun, _⟩ := hc
  rw tkJ.galois_carrier at fun
  rw (unitGroup.carrier_eq at zmod(n), ∅ with zc, fin) at fun
  have chiFun := tkJ.character.function at Algebra.ring(E), n with domL, positive, count
  have closed : ∀ x ∈ algebraAutomorphisms(E), modularCyclotomicCharacter(Algebra.ring(E), n)(x) ∈ Ring.carrier(zmod(n))
    intros x hx
    have r := sub with x, hx
    exact FunctionBetween.apply_closed with chiFun, r
  apply Injective.of_pointwise with fun
  intros σ hσ τ hτ e
  have rs := restrict.apply at modularCyclotomicCharacter(Algebra.ring(E), n), ringAutomorphisms(Algebra.ring(E)), Ring.carrier(zmod(n)), algebraAutomorphisms(E), Ring.carrier(zmod(n)), σ with chiFun, sub, closed, hσ
  have rt := restrict.apply at modularCyclotomicCharacter(Algebra.ring(E), n), ringAutomorphisms(Algebra.ring(E)), Ring.carrier(zmod(n)), algebraAutomorphisms(E), Ring.carrier(zmod(n)), τ with chiFun, sub, closed, hτ
  rw [rs, rt] at e
  have sσ := sub with σ, hσ
  have sτ := sub with τ, hτ
  rw (tkJ.character.apply at Algebra.ring(E), n, σ with domL, positive, count, sσ) at e
  rw (tkJ.character.apply at Algebra.ring(E), n, τ with domL, positive, count, sτ) at e
  have selS := cyclotomicCharValue.selected at Algebra.ring(E), n, σ with domL, positive, count, sσ
  obtain ⟨_, actS⟩ := selS
  have selT := cyclotomicCharValue.selected at Algebra.ring(E), n, τ with domL, positive, count, sτ
  obtain ⟨_, actT⟩ := selT
  have mr := IsPrimitiveRoot.mem_roots at Algebra.ring(E), ζ, n with commL, prim, positive
  obtain ⟨_, zRoot⟩ := mr
  have zAgree : σ(ζ) = τ(ζ)
    rw [(actS with ζ, zRoot), (actT with ζ, zRoot), e]
  have σh := tkJ.aut_member at E, σ
  have σIso := σh.forward with hσ
  obtain ⟨σAlg, _⟩ := σIso
  have τh := tkJ.aut_member at E, τ
  have τIso := τh.forward with hτ
  obtain ⟨τAlg, _⟩ := τIso
  have σc := σAlg
  obtain ⟨_, _, _, σRing, σFix⟩ := σc
  have τc := τAlg
  obtain ⟨_, _, _, τRing, τFix⟩ := τc
  have adj := IsCyclotomicExtension.adjoin_primitive_root at E, ζ, n with extension, positive, cyclotomic, prim
  obtain ⟨_, adjEq⟩ := adj
  have zSub : {ζ} ⊆ algebraCarrier(E)
    intros x hx
    have ex := singleton.membership.forward with hx
    rw ex
    exact zIn
  have gens : {ζ} ⊆ tkJEqualizer(σ, τ, algebraCarrier(E))
    intros x hx
    have ex := singleton.membership.forward with hx
    rw ex
    apply tkJEqualizer.membership.backward
    exact ⟨zIn, zAgree⟩
  have sh := Algebra.structure_hom at E with algebra
  have scalars : ∀ r ∈ Ring.carrier(Algebra.base(E)), Algebra.map(E)(r) ∈ tkJEqualizer(σ, τ, algebraCarrier(E))
    intros r rIn
    have mIn0 : Algebra.map(E)(r) ∈ Ring.carrier(Algebra.ring(E)) := RingHom.map_mem with sh, rIn
    have mIn : Algebra.map(E)(r) ∈ algebraCarrier(E)
      unfold algebraCarrier
      exact mIn0
    apply tkJEqualizer.membership.backward
    have a1 := σFix with r, rIn
    have a2 := τFix with r, rIn
    refine ⟨mIn, ?_⟩
    rw [a1, a2]
  have sums : ∀ x ∈ tkJEqualizer(σ, τ, algebraCarrier(E)) ∩ algebraCarrier(E), ∀ y ∈ tkJEqualizer(σ, τ, algebraCarrier(E)) ∩ algebraCarrier(E), call2(Ring.add(Algebra.ring(E)), x, y) ∈ tkJEqualizer(σ, τ, algebraCarrier(E))
    intros x hx y hy
    have hx2 := intersection.membership.forward with hx
    obtain ⟨xP, _⟩ := hx2
    have hy2 := intersection.membership.forward with hy
    obtain ⟨yP, _⟩ := hy2
    obtain ⟨xL, xe⟩ := tkJEqualizer.membership.forward with xP
    obtain ⟨yL, ye⟩ := tkJEqualizer.membership.forward with yP
    unfold algebraCarrier at xL
    unfold algebraCarrier at yL
    have sIn : call2(Ring.add(Algebra.ring(E)), x, y) ∈ algebraCarrier(E)
      unfold algebraCarrier
      typecheck
    apply tkJEqualizer.membership.backward
    refine ⟨sIn, ?_⟩
    rw (RingHom.map_add at σ, Algebra.ring(E), Algebra.ring(E), x, y with σRing, xL, yL)
    rw (RingHom.map_add at τ, Algebra.ring(E), Algebra.ring(E), x, y with τRing, xL, yL)
    rw [xe, ye]
  have products : ∀ x ∈ tkJEqualizer(σ, τ, algebraCarrier(E)) ∩ algebraCarrier(E), ∀ y ∈ tkJEqualizer(σ, τ, algebraCarrier(E)) ∩ algebraCarrier(E), call2(Ring.mul(Algebra.ring(E)), x, y) ∈ tkJEqualizer(σ, τ, algebraCarrier(E))
    intros x hx y hy
    have hx2 := intersection.membership.forward with hx
    obtain ⟨xP, _⟩ := hx2
    have hy2 := intersection.membership.forward with hy
    obtain ⟨yP, _⟩ := hy2
    obtain ⟨xL, xe⟩ := tkJEqualizer.membership.forward with xP
    obtain ⟨yL, ye⟩ := tkJEqualizer.membership.forward with yP
    unfold algebraCarrier at xL
    unfold algebraCarrier at yL
    have sIn : call2(Ring.mul(Algebra.ring(E)), x, y) ∈ algebraCarrier(E)
      unfold algebraCarrier
      typecheck
    apply tkJEqualizer.membership.backward
    refine ⟨sIn, ?_⟩
    rw (RingHom.map_mul at σ, Algebra.ring(E), Algebra.ring(E), x, y with σRing, xL, yL)
    rw (RingHom.map_mul at τ, Algebra.ring(E), Algebra.ring(E), x, y with τRing, xL, yL)
    rw [xe, ye]
  have ind := adjoinOf.induction at E, {ζ}, tkJEqualizer(σ, τ, algebraCarrier(E)) with algebra, zSub, gens, scalars, sums, products
  rw adjEq at ind
  have agree : ∀ x ∈ algebraCarrier(E), σ(x) = τ(x)
    intros x hx
    have xP := ind with x, hx
    obtain ⟨_, xe⟩ := tkJEqualizer.membership.forward with xP
    exact xe
  exact galoisGroup.ext at E, σ, τ with extension, hσ, hτ, agree

theorem IsCyclotomicExtension.aut_equiv_pow (n : Nat)
  requires positive : 0 < n
  requires cyclotomic : IsCyclotomicExtension({n}, E)
  requires invertible : natCast(Algebra.base(E), n) ≠ Ring.zero(Algebra.base(E))
  requires irreducible : RingIrreducible(polynomialRing(Algebra.base(E), {0}),
    cyclotomic(Algebra.base(E), n))
  shows GroupIso(restrict(modularCyclotomicCharacter(Algebra.ring(E), n),
    algebraAutomorphisms(E)), galoisGroup(E), unitGroup(zmod(n)))
proof
  sorry

end CyclotomicFields

-- Section: Over ℚ
section Rationals
variable (E : Set)
hypothesis extension : FieldExtension(E)
hypothesis base : Algebra.base(E) = rationalRing

-- Polynomial.cyclotomic_eq_minpoly (over ℚ, with minpoly.isIntegrallyClosed_eq_field_fractions):
-- the minimal polynomial over ℚ of a primitive n-th root is Φ_n.
theorem cyclotomic.eq_minpoly (ζ : Set) (n : Nat)
  requires positive : 0 < n
  requires primitive : IsPrimitiveRoot(Algebra.ring(E), ζ, n)
  shows IntegralElement(E, ζ) ∧ minpoly(E, ζ) = cyclotomic(rationalRing, n)
proof
  sorry

-- IsCyclotomicExtension.Rat.finrank: [ℚ(ζ_n) : ℚ] = φ(n); the Galois
-- group is (ℤ/nℤ)ˣ (autEquivPow with irreducible_rat).
theorem IsCyclotomicExtension.Rat.finrank (n : Nat)
  requires positive : 0 < n
  requires cyclotomic : IsCyclotomicExtension({n}, E)
  shows FiniteExtension(E) ∧ extensionDegree(E) = totient(n) ∧
    GroupIso(restrict(modularCyclotomicCharacter(Algebra.ring(E), n),
      algebraAutomorphisms(E)), galoisGroup(E), unitGroup(zmod(n)))
proof
  sorry

end Rationals
