-- Cyclotomic extensions: ℚ as a bundled field, the predicate that B is
-- generated over A by n-th roots of unity for n in a set S, containing
-- primitive ones (IsCyclotomicExtension), existence and uniqueness of
-- cyclotomic fields, K(ζ) as a cyclotomic extension, Galois and abelian
-- Galois groups embedding into (ℤ/nℤ)ˣ, irreducibility of Φ_n over ℚ,
-- [ℚ(ζ_n) : ℚ] = φ(n), and the modular cyclotomic character of a ring
-- automorphism, locally constant on the Krull topology.
-- Part of the GRH blueprint.
-- Planned home: NumberTheory/Cyclotomic/Basic.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Cyclotomy.Fields
import GRH.Cyclotomy.RootsOfUnity
import GRH.Field.InfiniteGalois

-- Section: Definitions
-- ℚ as a bundled field (Mathlib's Rat with its Field instance).
def rationalRing : Set :=
  Ring.mk(ℚ, rationalAdd, rationalZero, rationalNeg, rationalMul, rationalOne)

-- The roots of unity of order in S: x with x^n = 1 for some n ∈ S, n ≥ 1.
def cyclotomicGenerators (E S : Set) : Set :=
  { x ∈ algebraCarrier(E) | ∃ n ∈ S, 0 < n ∧
    Ring.pow(Algebra.ring(E), x, n) = Ring.one(Algebra.ring(E)) }

-- B is an S-cyclotomic extension of A (IsCyclotomicExtension S A B), for
-- S ⊆ ℕ: B has a primitive n-th root of unity for each n ∈ S, n ≥ 1, and
-- is generated as an A-algebra by the roots of unity of order in S.
-- Here E is any Cumulus algebra B over A.
predicate IsCyclotomicExtension (S E : Set) :=
  Algebra(E) ∧ S ⊆ ℕ ∧
  (∀ n ∈ S, 0 < n → (∃ ζ ∈ algebraCarrier(E), IsPrimitiveRoot(Algebra.ring(E), ζ, n))) ∧
  adjoinOf(E, cyclotomicGenerators(E, S)) = algebraCarrier(E)

-- The ring automorphisms of R (R ≃+* R).
def ringAutomorphisms (R : Set) : Set :=
  { σ ∈ functionSpace(Ring.carrier(R), Ring.carrier(R)) | RingIso(σ, R, R) }

-- Helpers: when μ_n has n elements in a domain, exponents below n are
-- told apart by their action on μ_n.
theorem tkJ.roots.pow_lt (L : Set) (n a b : Nat)
  requires comm : CommRing(L)
  requires domain : IntegralDomain(L)
  requires count : HasCardinality(rootsOfUnity(L, n), n)
  requires below : a < b
  requires bounded : b < n
  requires same : ∀ ζ ∈ rootsOfUnity(L, n), Ring.pow(L, ζ, a) = Ring.pow(L, ζ, b)
  shows ⊥
proof
  have ringL := CommRing.to_ring with comm
  obtain ⟨d, dNat, bd⟩ := Less.exists_add_one at a, b with below
  have an : a ≤ n by arith
  obtain ⟨e, eNat, ne⟩ := LessEqual.exists_add at a, n with an
  have dPos : 0 < d + 1 by arith
  have sub : rootsOfUnity(L, n) ⊆ rootsOfUnity(L, d + 1)
    intros x hx
    obtain ⟨xu, xp⟩ := rootsOfUnity.membership.forward with hx
    obtain ⟨xIn, _⟩ := ringUnits.membership.forward with xu
    have eq := same with x, hx
    have bd2 : b = a + (d + 1) by arith
    rw bd2 at eq
    rw (Ring.pow_add at L, x, a, d + 1 with ringL, xIn) at eq
    have sk := Ring.pow_add at L, x, a, e with ringL, xIn
    rw ← ne at sk
    rw xp at sk
    have p1In : Ring.pow(L, x, d + 1) ∈ Ring.carrier(L) := Ring.pow_mem at L, x, d + 1 with ringL, xIn
    have p2In : Ring.pow(L, x, e) ∈ Ring.carrier(L) := Ring.pow_mem at L, x, e with ringL, xIn
    have p3In : Ring.pow(L, x, a) ∈ Ring.carrier(L) := Ring.pow_mem at L, x, a with ringL, xIn
    have step : Ring.pow(L, x, d + 1) = Ring.one(L)
      linear_combination (Ring.pow(L, x, d + 1) - Ring.one(L)) * sk - Ring.pow(L, x, e) * eq
    exact rootsOfUnity.membership.backward at L, d + 1, x with ⟨xu, step⟩
  have bound := rootsOfUnity.card_le at L, d + 1 with comm, domain, dPos
  obtain ⟨fin, le⟩ := bound
  have mono := cardinality.monotone at rootsOfUnity(L, n), rootsOfUnity(L, d + 1) with fin, sub
  have cn := cardinality.eq_of_has with count
  rw cn at mono
  arith

theorem tkJ.roots.pow_eq (L : Set) (n a b : Nat)
  requires comm : CommRing(L)
  requires domain : IntegralDomain(L)
  requires count : HasCardinality(rootsOfUnity(L, n), n)
  requires firstBound : a < n
  requires secondBound : b < n
  requires same : ∀ ζ ∈ rootsOfUnity(L, n), Ring.pow(L, ζ, a) = Ring.pow(L, ζ, b)
  shows a = b
proof
  have tri := Less.trichotomy at a, b with *
  cases tri with lt | rest
  . exfalso
    exact tkJ.roots.pow_lt at L, n, a, b with comm, domain, count, lt, secondBound, same
  . cases rest with eq | gt
    . exact eq
    . exfalso
      have flipped : ∀ ζ ∈ rootsOfUnity(L, n), Ring.pow(L, ζ, b) = Ring.pow(L, ζ, a)
        intros ζ hz
        have s := same with ζ, hz
        symm
        exact s
      exact tkJ.roots.pow_lt at L, n, b, a with comm, domain, count, gt, firstBound, flipped

-- The modular cyclotomic character (modularCyclotomicCharacter): when
-- the n-th roots of unity of L number n, a ring automorphism σ acts on
-- them as ζ ↦ ζ^j for a unique j ∈ ℤ/nℤ. The value is that unique class
-- (Mathlib's modularCyclotomicCharacter.aux is a chosen integer; the
-- class is unique, so no choice is made).
defunique cyclotomicCharValue (L : Set, n : Nat, σ : Set) (j ∈ Ring.carrier(zmod(n))) :=
  ∀ ζ ∈ rootsOfUnity(L, n), σ(ζ) = Ring.pow(L, ζ, zmodVal(n, j))
requires domain : IntegralDomain(L)
requires positive : 0 < n
requires count : HasCardinality(rootsOfUnity(L, n), n)
requires automorphism : σ ∈ ringAutomorphisms(L)
proof
  have comm := IntegralDomain.comm_ring at L with domain
  have ringL := CommRing.to_ring with comm
  obtain ⟨_, iso⟩ := ringAutomorphisms.membership.forward with automorphism
  obtain ⟨j, jIn, act⟩ := rootsOfUnity.automorphism_power at L, σ, n with comm, domain, positive, iso
  have jNat := nat.omega.backward with jIn
  have jZ : integerOfNat(j) ∈ ℤ by typecheck
  have cIn := tkJ.zmod.cast_mem at n, integerOfNat(j) with jZ
  witness zmodCast(n)(integerOfNat(j))
  refine ⟨cIn, ?_⟩
  intros ζ hz
  rw (zmodVal.nat_cast at n, j with positive)
  rw (integerMod.ofNat at j, n with positive)
  rw (act with ζ, hz)
  obtain ⟨zu, zp⟩ := rootsOfUnity.membership.forward with hz
  obtain ⟨zL, _⟩ := ringUnits.membership.forward with zu
  have nz : n ≠ 0 by arith
  obtain ⟨q, qNat, jq⟩ := mod.equation at j, n with nz
  have rNat : Nat(j % n) by typecheck
  have e := Ring.pow_add at L, ζ, n * q, j % n with ringL, zL
  rw ← jq at e
  rw (Ring.pow_mul at L, ζ, n, q with ringL, zL) at e
  rw [zp, (Ring.one_pow at L, q with ringL)] at e
  rw e
  have pIn : Ring.pow(L, ζ, j % n) ∈ Ring.carrier(L) := Ring.pow_mem at L, ζ, j % n with ringL, zL
  ring
uniqueness
  intros j hj ej k hk ek
  have comm := IntegralDomain.comm_ring at L with domain
  have sj := zmodVal.spec at n, j with positive, hj
  obtain ⟨jlt, _⟩ := sj
  have sk := zmodVal.spec at n, k with positive, hk
  obtain ⟨klt, _⟩ := sk
  have selJ := zmodVal.selected at n, j with positive, hj
  have jN := nat.omega.backward with selJ.left
  have selK := zmodVal.selected at n, k with positive, hk
  have kN := nat.omega.backward with selK.left
  have same : ∀ ζ ∈ rootsOfUnity(L, n), Ring.pow(L, ζ, zmodVal(n, j)) = Ring.pow(L, ζ, zmodVal(n, k))
    intros ζ hz
    have a := ej with ζ, hz
    have b := ek with ζ, hz
    rw a at b
    exact b
  have eq := tkJ.roots.pow_eq at L, n, zmodVal(n, j), zmodVal(n, k) with comm, domain, count, jlt, klt, same
  have inj := zmodVal.injective at n with positive
  exact inj with j, hj, k, hk, eq

def modularCyclotomicCharacter (L : Set, n : Nat) : Set :=
  { (σ, cyclotomicCharValue(L, n, σ)) | σ ∈ ringAutomorphisms(L) }

-- Helpers: n · 1 in ℚ is the fraction n/1.
theorem tkJ.rational.ringNat (n : Nat)
  shows ringNat(rationalAdd, rationalZero, rationalOne, n) = rationalClass(n, 0, 1)
proof
  induction n
  | zero =>
    rw ringNat.zero
    unfold rationalZero
    rfl
  | succ(k) using ih =>
    rw ringNat.succ
    rw ih
    unfold rationalOne
    rw rationalAddValue.notation
    have one : 1 ≠ 0 by arith
    rw (rationalAddValue.classes at k, 0, 1, 1, 0, 1 with one, one)
    unfold rationalClassSum
    apply rationalClass.eq
    . arith
    . exact one
    . arith

theorem tkJ.rational.natCast (n : Nat)
  shows natCast(rationalRing, n) = rationalClass(n, 0, 1)
proof
  have addEq : Ring.add(rationalRing) = rationalAdd by simp [rationalRing, Ring.mk.add]
  have zeroEq : Ring.zero(rationalRing) = rationalZero by simp [rationalRing, Ring.mk.zero]
  have oneEq : Ring.one(rationalRing) = rationalOne by simp [rationalRing, Ring.mk.one]
  unfold natCast
  rw [addEq, zeroEq, oneEq]
  exact tkJ.rational.ringNat at n

-- Section: The rationals
-- ℚ is a field of characteristic zero (Rat.instField, algebraRat.charZero).
theorem rationalRing.field
  shows Field(rationalRing) ∧ CharP(rationalRing, 0)
proof
  have parts := rationals.comm_ring
  have lt := Grace.Cumulus.Rat.OrderedOperations.rationalZero.lt_one
  have zIn : rationalZero ∈ ℚ by typecheck
  have oIn : rationalOne ∈ ℚ by typecheck
  have nt : Nontrivial(ℚ, rationalZero, rationalOne)
    unfold Nontrivial
    refine ⟨zIn, oIn, ?_⟩
    intro e
    rw e at lt
    exact rationalLess.irreflexive at rationalOne with lt
  have inv : ∀ x ∈ ℚ, x ≠ rationalZero → ∃ y, IsInverse(ℚ, rationalMul, rationalOne, x, y)
    intros x xIn nz
    have xR : Rational(x) by typecheck
    have tri := rationalLess.trichotomy at rationalZero, x
    cases tri with pos | rest
    . obtain ⟨y, yIn, _, prod⟩ := rationalMulValue.exists_positive_inverse at x with pos
      have yR : Rational(y) by typecheck
      witness y
      unfold IsInverse
      refine ⟨xIn, yIn, ?_, ?_⟩
      . have c := rationalMulValue.commutative at y, x with yR, xR
        rw c
        exact prod
      . exact prod
    . cases rest with eq | neg
      . exfalso
        apply nz
        symm
        exact eq
      . have p := rationalLess.neg_reverse at x, rationalZero with neg
        have zR : Rational(rationalZero) by typecheck
        have nz0 : rationalNegValue(rationalZero) = rationalZero by ring
        simp [rationalNegValue.notation] at p
        rw nz0 at p
        have nxR : Rational(rationalNegValue(x)) by typecheck
        obtain ⟨y, yIn, _, prod⟩ := rationalMulValue.exists_positive_inverse at rationalNegValue(x) with p
        rw rationalMulValue.notation at prod
        have yR : Rational(y) by typecheck
        have nyIn : rationalNegValue(y) ∈ ℚ by typecheck
        have nyR : Rational(rationalNegValue(y)) by typecheck
        have prod2 : rationalMulValue(x, rationalNegValue(y)) = rationalOne
          have t : rationalMulValue(x, rationalNegValue(y)) = rationalMulValue(rationalNegValue(x), y) by ring
          rw t
          exact prod
        witness rationalNegValue(y)
        unfold IsInverse
        refine ⟨xIn, nyIn, ?_, ?_⟩
        . have c := rationalMulValue.commutative at rationalNegValue(y), x with nyR, xR
          rw c
          rw rationalMulValue.notation
          exact prod2
        . rw rationalMulValue.notation
          exact prod2
  have isField : IsField(ℚ, rationalAdd, rationalZero, rationalNeg, rationalMul, rationalOne)
    unfold IsField
    exact ⟨parts, nt, inv⟩
  have field : Field(rationalRing)
    unfold rationalRing
    exact Field.of_parts with isField
  have comm := Field.to_comm_ring at rationalRing with field
  have ringQ := CommRing.to_ring with comm
  have char : CharP(rationalRing, 0)
    unfold CharP
    refine ⟨ringQ, ?_⟩
    intros n nIn
    have nNat := nat.omega.backward with nIn
    rw (tkJ.rational.natCast at n)
    constructor
    . intro h
      have shape := natural.zero_or_successor at n with *
      cases shape with zero | successor
      . rw zero
        exact divides.zero at 0
      . exfalso
        obtain ⟨j, jNat, step⟩ := successor
        rw step at h
        have pos := rationalLess.positive_natural_successor at j
        have zeroEq : Ring.zero(rationalRing) = rationalZero by simp [rationalRing, Ring.mk.zero]
        rw zeroEq at h
        rw h at pos
        have irr := rationalLess.irreflexive at rationalZero
        exact irr with pos
    . intro d
      have z := zero.divides_only_zero at n with d
      rw z
      have zeroEq : Ring.zero(rationalRing) = rationalZero by simp [rationalRing, Ring.mk.zero]
      rw zeroEq
      unfold rationalZero
      rfl
  exact ⟨field, char⟩

-- Polynomial.cyclotomic.irreducible_rat: Φ_n is irreducible over ℚ.
theorem cyclotomic.irreducible_rat (n : Nat)
  requires positive : 0 < n
  shows RingIrreducible(polynomialRing(rationalRing, {0}), cyclotomic(rationalRing, n))
proof
  sorry

-- Helper: a subring contains the powers of its elements.
theorem tkJ.subring.pow_mem (R S x : Set) (k : Nat)
  requires ring : Ring(R)
  requires subring : IsSubring(Ring.carrier(R), Ring.add(R), Ring.zero(R),
    Ring.neg(R), Ring.mul(R), Ring.one(R), S)
  requires member : x ∈ S
  shows Ring.pow(R, x, k) ∈ S
proof
  have inside := IsSubring.subset_carrier with subring
  have xR := inside with x, member
  induction k
  | zero =>
    rw (Ring.pow_zero at R, x with ring, xR)
    exact IsSubring.one_closed with subring
  | succ(j) using ih =>
    have shift := add.right_one at j with *
    rw ← shift
    rw (Ring.pow_succ at R, x, j with ring, xR)
    have mc := IsSubring.mul_closed with subring
    unfold ClosedBinary at mc
    exact mc with Ring.pow(R, x, j), ih, x, member

-- Section: Cyclotomic extensions of fields
section CyclotomicFields
variable (E : Set)
hypothesis extension : FieldExtension(E)

-- IsCyclotomicExtension.zeta_spec: a primitive n-th root ζ of a
-- {n}-cyclotomic extension, and IsCyclotomicExtension.adjoin_primitive_root_eq_top:
-- L = K(ζ).
theorem IsCyclotomicExtension.zeta_spec (n : Nat)
  requires positive : 0 < n
  requires cyclotomic : IsCyclotomicExtension({n}, E)
  shows ∃ ζ ∈ algebraCarrier(E), IsPrimitiveRoot(Algebra.ring(E), ζ, n)
proof
  have c := cyclotomic
  obtain ⟨_, _, prim, _⟩ := c
  have nIn : n ∈ {n} := singleton.membership.backward at n, n with rfl
  exact prim with n, nIn, positive

theorem IsCyclotomicExtension.adjoin_primitive_root (ζ : Set) (n : Nat)
  requires positive : 0 < n
  requires cyclotomic : IsCyclotomicExtension({n}, E)
  requires primitive : IsPrimitiveRoot(Algebra.ring(E), ζ, n)
  shows fieldAdjoin(E, {ζ}) = algebraCarrier(E) ∧ adjoinOf(E, {ζ}) = algebraCarrier(E)
proof
  have ext := extension
  obtain ⟨algebra, _, fieldL⟩ := ext
  have commL := Field.to_comm_ring at Algebra.ring(E) with fieldL
  have ringL := CommRing.to_ring with commL
  have domL := Field.domain at Algebra.ring(E) with fieldL
  have c := cyclotomic
  obtain ⟨_, _, _, top⟩ := c
  have primCopy := primitive
  obtain ⟨zIn, _, _⟩ := primCopy
  have zSub : {ζ} ⊆ algebraCarrier(E)
    intros x hx
    have e := singleton.membership.forward with hx
    rw e
    unfold algebraCarrier
    exact zIn
  have adj := adjoinOf.subalgebra at E, {ζ} with algebra, zSub
  obtain ⟨sub, contains⟩ := adj
  have subCopy := sub
  obtain ⟨_, subalg⟩ := subCopy
  obtain ⟨subring, _⟩ := subalg
  unfold algebraCarrier at subring
  have zs : ζ ∈ {ζ} := singleton.membership.backward at ζ, ζ with rfl
  have zA := contains with ζ, zs
  have gensBounded : cyclotomicGenerators(E, {n}) ⊆ algebraCarrier(E)
    intros x hx
    obtain ⟨xIn, _⟩ := cyclotomicGenerators.membership.forward with hx
    exact xIn
  have gens : cyclotomicGenerators(E, {n}) ⊆ adjoinOf(E, {ζ})
    intros x hx
    obtain ⟨xIn, m, mIn, mPos, xm⟩ := cyclotomicGenerators.membership.forward with hx
    have mn := singleton.membership.forward with mIn
    rw mn at xm
    unfold algebraCarrier at xIn
    obtain ⟨i, iN, _, e⟩ := IsPrimitiveRoot.eq_pow_of_pow_eq_one at Algebra.ring(E), ζ, x, n with commL, domL, primitive, positive, xIn, xm
    have iNat := nat.omega.backward with iN
    rw e
    exact tkJ.subring.pow_mem at Algebra.ring(E), adjoinOf(E, {ζ}), ζ, i with ringL, subring, zA
  have least := adjoinOf.least at E, cyclotomicGenerators(E, {n}), adjoinOf(E, {ζ}) with algebra, gensBounded, sub
  have le := least.backward with gens
  rw top at le
  have adjBounded := IsSubring.subset_carrier with subring
  have adjBounded2 : adjoinOf(E, {ζ}) ⊆ algebraCarrier(E)
    unfold algebraCarrier
    exact adjBounded
  have adjEq := Subset.antisymmetric with adjBounded2, le
  have inter := fieldAdjoin.intermediate at E, {ζ} with extension, zSub
  obtain ⟨_, subF, _⟩ := inter
  have fs := fieldAdjoin.subset_adjoin at E, {ζ} with extension, zSub
  have least2 := adjoinOf.least at E, {ζ}, fieldAdjoin(E, {ζ}) with algebra, zSub, subF
  have le2 := least2.backward with fs
  rw adjEq at le2
  have fBounded : fieldAdjoin(E, {ζ}) ⊆ algebraCarrier(E)
    intros x hx
    obtain ⟨xIn, _⟩ := fieldAdjoin.membership.forward with hx
    exact xIn
  have fEq := Subset.antisymmetric with fBounded, le2
  exact ⟨fEq, adjEq⟩

-- IntermediateField.isCyclotomicExtension_adjoin_of_exists_isPrimitiveRoot,
-- IsPrimitiveRoot.intermediateField_adjoin_isCyclotomicExtension: K(ζ)
-- is {n}-cyclotomic over K.
theorem IsPrimitiveRoot.adjoin_cyclotomic (ζ : Set) (n : Nat)
  requires positive : 0 < n
  requires primitive : IsPrimitiveRoot(Algebra.ring(E), ζ, n)
  shows IsCyclotomicExtension({n}, subextension(E, fieldAdjoin(E, {ζ})))
proof
  sorry

-- IsCyclotomicExtension of S ⊆ T: an extension cyclotomic for {m}
-- contains primitive n-th roots for n ∣ m (IsCyclotomicExtension.le_of_dvd
-- in its consequence for roots).
theorem IsCyclotomicExtension.primitive_of_dvd (m n : Nat)
  requires positive : 0 < n
  requires divides : n ∣ m
  requires largePositive : 0 < m
  requires cyclotomic : IsCyclotomicExtension({m}, E)
  shows ∃ ζ ∈ algebraCarrier(E), IsPrimitiveRoot(Algebra.ring(E), ζ, n)
proof
  have ext := extension
  obtain ⟨algebra, _, fieldL⟩ := ext
  have commL := Field.to_comm_ring at Algebra.ring(E) with fieldL
  obtain ⟨ζ, zIn, prim⟩ := IsCyclotomicExtension.zeta_spec at E, m with extension, largePositive, cyclotomic
  obtain ⟨q, qNat, e⟩ := divides
  have shape : m = q * n
    rw ← e
    ring
  rw shape at prim
  have qPos : 0 < q
    by_contra none
    have q0 : q = 0 by arith
    rw q0 at shape
    arith
  have p := IsPrimitiveRoot.pow_of_dvd at Algebra.ring(E), ζ, q, n with commL, prim, qPos
  have pIn : Ring.pow(Algebra.ring(E), ζ, q) ∈ algebraCarrier(E)
    unfold algebraCarrier at zIn
    unfold algebraCarrier
    have ringL := CommRing.to_ring with commL
    exact Ring.pow_mem at Algebra.ring(E), ζ, q with ringL, zIn
  exact ⟨Ring.pow(Algebra.ring(E), ζ, q), pIn, p⟩

-- A finite set S of orders, invertible in K, gives a finite Galois
-- extension with abelian Galois group (IsCyclotomicExtension.finiteDimensional,
-- IsCyclotomicExtension.isGalois, IsCyclotomicExtension.isAbelianGalois).
theorem IsCyclotomicExtension.finite_galois (S : Set)
  requires cyclotomic : IsCyclotomicExtension(S, E)
  requires finite : Finite(S)
  requires invertible : ∀ n ∈ S, natCast(Algebra.base(E), n) ≠ Ring.zero(Algebra.base(E))
  shows FiniteExtension(E) ∧ GaloisExtension(E) ∧ AbelianGroup(galoisGroup(E))
proof
  sorry

-- The cyclotomic polynomial splits in an {n}-cyclotomic extension and
-- generates it: L is a splitting field of Φ_n (IsCyclotomicExtension.splitting_field_cyclotomic).
theorem IsCyclotomicExtension.splitting_field (n : Nat)
  requires positive : 0 < n
  requires cyclotomic : IsCyclotomicExtension({n}, E)
  requires invertible : natCast(Algebra.base(E), n) ≠ Ring.zero(Algebra.base(E))
  shows IsSplittingField(E, cyclotomic(Algebra.base(E), n))
proof
  sorry

-- CyclotomicField n K with CyclotomicField.isCyclotomicExtension: a
-- {n}-cyclotomic extension exists when n · 1 ≠ 0 in K (stated as
-- existence; no field is chosen), unique up to K-isomorphism
-- (IsCyclotomicExtension.algEquiv).
theorem IsCyclotomicExtension.exists (n : Nat)
  requires positive : 0 < n
  requires invertible : natCast(Algebra.base(E), n) ≠ Ring.zero(Algebra.base(E))
  shows ∃ E2, Algebra.base(E2) = Algebra.base(E) ∧ FieldExtension(E2) ∧
    IsCyclotomicExtension({n}, E2)
proof
  sorry

theorem IsCyclotomicExtension.unique (E2 : Set) (n : Nat)
  requires positive : 0 < n
  requires second : FieldExtension(E2)
  requires sameBase : Algebra.base(E2) = Algebra.base(E)
  requires first : IsCyclotomicExtension({n}, E)
  requires secondCyclotomic : IsCyclotomicExtension({n}, E2)
  shows ∃ f, f : E ≃ₐ E2
proof
  sorry

-- IsCyclotomicExtension.autEquivPow: when Φ_n is irreducible over K,
-- σ ↦ (the j with σ(ζ) = ζ^j) is an isomorphism Gal(L/K) ≅ (ℤ/nℤ)ˣ;
-- in general it is an injective homomorphism
-- (IsPrimitiveRoot.autToPow_injective).
theorem IsCyclotomicExtension.character_injective (n : Nat)
  requires positive : 0 < n
  requires cyclotomic : IsCyclotomicExtension({n}, E)
  requires invertible : natCast(Algebra.base(E), n) ≠ Ring.zero(Algebra.base(E))
  shows GroupHom(restrict(modularCyclotomicCharacter(Algebra.ring(E), n),
      algebraAutomorphisms(E)), galoisGroup(E), unitGroup(zmod(n))) ∧
    InjectiveBetween(restrict(modularCyclotomicCharacter(Algebra.ring(E), n),
      algebraAutomorphisms(E)), algebraAutomorphisms(E), ringUnits(zmod(n)))
proof
  sorry

theorem IsCyclotomicExtension.aut_equiv_pow (n : Nat)
  requires positive : 0 < n
  requires cyclotomic : IsCyclotomicExtension({n}, E)
  requires invertible : natCast(Algebra.base(E), n) ≠ Ring.zero(Algebra.base(E))
  requires irreducible : RingIrreducible(polynomialRing(Algebra.base(E), {0}),
    cyclotomic(Algebra.base(E), n))
  shows GroupIso(restrict(modularCyclotomicCharacter(Algebra.ring(E), n),
    algebraAutomorphisms(E)), galoisGroup(E), unitGroup(zmod(n)))
proof
  sorry

end CyclotomicFields

-- Section: Over ℚ
section Rationals
variable (E : Set)
hypothesis extension : FieldExtension(E)
hypothesis base : Algebra.base(E) = rationalRing

-- Polynomial.cyclotomic_eq_minpoly (over ℚ, with minpoly.isIntegrallyClosed_eq_field_fractions):
-- the minimal polynomial over ℚ of a primitive n-th root is Φ_n.
theorem cyclotomic.eq_minpoly (ζ : Set) (n : Nat)
  requires positive : 0 < n
  requires primitive : IsPrimitiveRoot(Algebra.ring(E), ζ, n)
  shows IntegralElement(E, ζ) ∧ minpoly(E, ζ) = cyclotomic(rationalRing, n)
proof
  sorry

-- IsCyclotomicExtension.Rat.finrank: [ℚ(ζ_n) : ℚ] = φ(n); the Galois
-- group is (ℤ/nℤ)ˣ (autEquivPow with irreducible_rat).
theorem IsCyclotomicExtension.Rat.finrank (n : Nat)
  requires positive : 0 < n
  requires cyclotomic : IsCyclotomicExtension({n}, E)
  shows FiniteExtension(E) ∧ extensionDegree(E) = totient(n) ∧
    GroupIso(restrict(modularCyclotomicCharacter(Algebra.ring(E), n),
      algebraAutomorphisms(E)), galoisGroup(E), unitGroup(zmod(n)))
proof
  sorry

end Rationals

-- Section: The modular cyclotomic character
section Character
variable (L : Set) (n : Nat)
hypothesis domain : IntegralDomain(L)
hypothesis positive : 0 < n
hypothesis count : HasCardinality(rootsOfUnity(L, n), n)

-- Helpers: μ_n has a primitive n-th root when it has n elements, the
-- character as a function, and its values are units.
theorem tkJ.character.primitive
  shows ∃ g ∈ rootsOfUnity(L, n), IsPrimitiveRoot(L, g, n)
proof
  have comm := IntegralDomain.comm_ring at L with domain
  have ringL := CommRing.to_ring with comm
  obtain ⟨g, gIn, gen⟩ := rootsOfUnity.cyclic at L, n with comm, domain, positive
  obtain ⟨gu, gp⟩ := rootsOfUnity.membership.forward with gIn
  obtain ⟨gL, _⟩ := ringUnits.membership.forward with gu
  obtain ⟨e, eIn, ePos, eLe, gPrim⟩ := tkJ.order.exists at L, g, n with comm, gL, positive, gp
  have eNat := nat.omega.backward with eIn
  have gCopy := gPrim
  obtain ⟨_, ge, _⟩ := gCopy
  have sub : rootsOfUnity(L, n) ⊆ rootsOfUnity(L, e)
    intros x hx
    obtain ⟨xu, _⟩ := rootsOfUnity.membership.forward with hx
    obtain ⟨xL, _⟩ := ringUnits.membership.forward with xu
    obtain ⟨i, iIn, xi⟩ := gen with x, hx
    have iNat := nat.omega.backward with iIn
    have iffe := rootsOfUnity.mem_iff at L, x, e with comm, ePos, xL
    apply iffe.backward
    rw xi
    rw ← (Ring.pow_mul at L, g, i, e with ringL, gL)
    have ie : i * e = e * i by ring
    rw ie
    rw (Ring.pow_mul at L, g, e, i with ringL, gL)
    rw ge
    exact Ring.one_pow at L, i with ringL
  have bound := rootsOfUnity.card_le at L, e with comm, domain, ePos
  obtain ⟨finE, le⟩ := bound
  have mono := cardinality.monotone at rootsOfUnity(L, n), rootsOfUnity(L, e) with finE, sub
  have cn := cardinality.eq_of_has with count
  rw cn at mono
  have eNat2 := cardinality.nat with finE
  have eq : e = n by arith
  rw eq at gPrim
  exact ⟨g, gIn, gPrim⟩

theorem tkJ.character.function
  shows modularCyclotomicCharacter(L, n) : ringAutomorphisms(L) → Ring.carrier(zmod(n))
proof
  apply tkJ.fin_graph_function
  . intros u uIn
    obtain ⟨σ, σIn, e⟩ := modularCyclotomicCharacter.membership.forward with uIn
    have sel := cyclotomicCharValue.selected at L, n, σ with domain, positive, count, σIn
    rw ← e
    exact product.pair with σIn, sel.left
  . intros x y z hy hz
    obtain ⟨a, aIn, ea⟩ := modularCyclotomicCharacter.membership.forward with hy
    obtain ⟨b, bIn, eb⟩ := modularCyclotomicCharacter.membership.forward with hz
    obtain ⟨xa, ya⟩ := orderedPair.injective with ea
    obtain ⟨xb, zb⟩ := orderedPair.injective with eb
    rw [← ya, ← zb, xa, xb]
  . intros σ σIn
    have sel := cyclotomicCharValue.selected at L, n, σ with domain, positive, count, σIn
    refine ⟨cyclotomicCharValue(L, n, σ), sel.left, ?_⟩
    apply modularCyclotomicCharacter.membership.backward
    exact ⟨σ, σIn, rfl⟩

theorem tkJ.character.apply (σ : Set)
  requires automorphism : σ ∈ ringAutomorphisms(L)
  shows modularCyclotomicCharacter(L, n)(σ) = cyclotomicCharValue(L, n, σ)
proof
  have fun := tkJ.character.function at L, n with domain, positive, count
  have rel : relates(modularCyclotomicCharacter(L, n), σ, cyclotomicCharValue(L, n, σ))
    unfold relates
    apply modularCyclotomicCharacter.membership.backward
    exact ⟨σ, automorphism, rfl⟩
  exact FunctionBetween.apply_value with fun, automorphism, rel

theorem tkJ.character.unit (σ : Set)
  requires automorphism : σ ∈ ringAutomorphisms(L)
  shows cyclotomicCharValue(L, n, σ) ∈ ringUnits(zmod(n))
proof
  have comm := IntegralDomain.comm_ring at L with domain
  have sel := cyclotomicCharValue.selected at L, n, σ with domain, positive, count, automorphism
  obtain ⟨jIn, act⟩ := sel
  obtain ⟨g, gIn, gPrim⟩ := tkJ.character.primitive at L, n with domain, positive, count
  obtain ⟨_, iso⟩ := ringAutomorphisms.membership.forward with automorphism
  have hom := RingIso.hom_of at σ, L, L with iso
  have bij := RingIso.bijective_of at σ, L, L with iso
  have inj := Bijective.injective with bij
  have gCopy := gPrim
  obtain ⟨gL, _, _⟩ := gCopy
  have mi := IsPrimitiveRoot.map_iff at L, L, σ, g, n with comm, hom, inj, gL
  have sg := mi.backward with gPrim
  rw (act with g, gIn) at sg
  have spec := zmodVal.spec at n, cyclotomicCharValue(L, n, σ) with positive, jIn
  obtain ⟨vlt, vcast⟩ := spec
  have selV := zmodVal.selected at n, cyclotomicCharValue(L, n, σ) with positive, jIn
  have vNat := nat.omega.backward with selV.left
  have pc := IsPrimitiveRoot.pow_iff_coprime at L, g, n, zmodVal(n, cyclotomicCharValue(L, n, σ)) with comm, gPrim, positive
  have cop := pc.forward with sg
  have vZ : integerOfNat(zmodVal(n, cyclotomicCharValue(L, n, σ))) ∈ ℤ by typecheck
  have ui := zmod.unit_iff_coprime at n, integerOfNat(zmodVal(n, cyclotomicCharValue(L, n, σ))) with vZ
  have icop : IntegerCoprime(integerOfNat(zmodVal(n, cyclotomicCharValue(L, n, σ))), integerOfNat(n))
    unfold IntegerCoprime
    rw integerGCD.ofNat
    exact cop
  have u := ui.backward with icop
  rw vcast at u
  have uCopy := u
  obtain ⟨cIn, _⟩ := uCopy
  apply ringUnits.membership.backward
  exact ⟨cIn, u⟩

-- modularCyclotomicCharacter.spec: σ(ζ) = ζ^j on μ_n, with j a unit of
-- ℤ/nℤ, and the character is a homomorphism Aut(L) → (ℤ/nℤ)ˣ
-- (modularCyclotomicCharacter, MonoidHom).
theorem modularCyclotomicCharacter.spec (σ ζ : Set)
  requires automorphism : σ ∈ ringAutomorphisms(L)
  requires root : ζ ∈ rootsOfUnity(L, n)
  shows modularCyclotomicCharacter(L, n)(σ) ∈ ringUnits(zmod(n)) ∧
    σ(ζ) = Ring.pow(L, ζ, zmodVal(n, modularCyclotomicCharacter(L, n)(σ)))
proof
  have ap := tkJ.character.apply at L, n, σ with domain, positive, count, automorphism
  rw ap
  have unit := tkJ.character.unit at L, n, σ with domain, positive, count, automorphism
  have sel := cyclotomicCharValue.selected at L, n, σ with domain, positive, count, automorphism
  obtain ⟨_, act⟩ := sel
  have v := act with ζ, root
  exact ⟨unit, v⟩

theorem modularCyclotomicCharacter.mul (σ τ : Set)
  requires first : σ ∈ ringAutomorphisms(L)
  requires second : τ ∈ ringAutomorphisms(L)
  shows modularCyclotomicCharacter(L, n)(compose(σ, τ, Ring.carrier(L),
      Ring.carrier(L), Ring.carrier(L))) =
    call2(Ring.mul(zmod(n)), modularCyclotomicCharacter(L, n)(σ),
      modularCyclotomicCharacter(L, n)(τ))
proof
  sorry

-- Algebra automorphisms are ring automorphisms; restricted to Gal(L/K)
-- the character is a homomorphism to (ℤ/nℤ)ˣ, locally constant for the
-- Krull topology when L/K is algebraic (the continuity behind
-- cyclotomicCharacter.continuous, at the finite level n).
theorem modularCyclotomicCharacter.galois_hom (E : Set)
  requires extension : FieldExtension(E)
  requires ring : Algebra.ring(E) = L
  shows algebraAutomorphisms(E) ⊆ ringAutomorphisms(L) ∧
    GroupHom(restrict(modularCyclotomicCharacter(L, n), algebraAutomorphisms(E)),
      galoisGroup(E), unitGroup(zmod(n)))
proof
  sorry

theorem modularCyclotomicCharacter.locally_constant (E : Set)
  requires algebraic : AlgebraicExtension(E)
  requires ring : Algebra.ring(E) = L
  shows IsLocallyConstant(restrict(modularCyclotomicCharacter(L, n),
    algebraAutomorphisms(E)), krullTopology(E))
proof
  sorry

end Character
