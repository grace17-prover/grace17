-- Cyclotomic extensions: ℚ as a bundled field, the predicate that B is
-- generated over A by n-th roots of unity for n in a set S, containing
-- primitive ones (IsCyclotomicExtension), existence and uniqueness of
-- cyclotomic fields, K(ζ) as a cyclotomic extension, Galois and abelian
-- Galois groups embedding into (ℤ/nℤ)ˣ, irreducibility of Φ_n over ℚ,
-- [ℚ(ζ_n) : ℚ] = φ(n), and the modular cyclotomic character of a ring
-- automorphism, locally constant on the Krull topology.
-- Part of the GRH blueprint.
-- Planned home: NumberTheory/Cyclotomic/Basic.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Cyclotomy.Fields
import GRH.Cyclotomy.RootsOfUnity
import GRH.Field.InfiniteGalois

-- Section: Definitions
-- ℚ as a bundled field (Mathlib's Rat with its Field instance).
def rationalRing : Set :=
  Ring.mk(ℚ, rationalAdd, rationalZero, rationalNeg, rationalMul, rationalOne)

-- The roots of unity of order in S: x with x^n = 1 for some n ∈ S, n ≥ 1.
def cyclotomicGenerators (E S : Set) : Set :=
  { x ∈ algebraCarrier(E) | ∃ n ∈ S, 0 < n ∧
    Ring.pow(Algebra.ring(E), x, n) = Ring.one(Algebra.ring(E)) }

-- B is an S-cyclotomic extension of A (IsCyclotomicExtension S A B), for
-- S ⊆ ℕ: B has a primitive n-th root of unity for each n ∈ S, n ≥ 1, and
-- is generated as an A-algebra by the roots of unity of order in S.
-- Here E is any Cumulus algebra B over A.
predicate IsCyclotomicExtension (S E : Set) :=
  Algebra(E) ∧ S ⊆ ℕ ∧
  (∀ n ∈ S, 0 < n → (∃ ζ ∈ algebraCarrier(E), IsPrimitiveRoot(Algebra.ring(E), ζ, n))) ∧
  adjoinOf(E, cyclotomicGenerators(E, S)) = algebraCarrier(E)

-- The ring automorphisms of R (R ≃+* R).
def ringAutomorphisms (R : Set) : Set :=
  { σ ∈ functionSpace(Ring.carrier(R), Ring.carrier(R)) | RingIso(σ, R, R) }

-- The modular cyclotomic character (modularCyclotomicCharacter): when
-- the n-th roots of unity of L number n, a ring automorphism σ acts on
-- them as ζ ↦ ζ^j for a unique j ∈ ℤ/nℤ. The value is that unique class
-- (Mathlib's modularCyclotomicCharacter.aux is a chosen integer; the
-- class is unique, so no choice is made).
defunique cyclotomicCharValue (L : Set, n : Nat, σ : Set) (j ∈ Ring.carrier(zmod(n))) :=
  ∀ ζ ∈ rootsOfUnity(L, n), σ(ζ) = Ring.pow(L, ζ, zmodVal(n, j))
requires domain : IntegralDomain(L)
requires positive : 0 < n
requires count : HasCardinality(rootsOfUnity(L, n), n)
requires automorphism : σ ∈ ringAutomorphisms(L)
proof
  sorry
uniqueness
  sorry

def modularCyclotomicCharacter (L : Set, n : Nat) : Set :=
  { (σ, cyclotomicCharValue(L, n, σ)) | σ ∈ ringAutomorphisms(L) }

-- Section: The rationals
-- ℚ is a field of characteristic zero (Rat.instField, algebraRat.charZero).
theorem rationalRing.field
  shows Field(rationalRing) ∧ CharP(rationalRing, 0)
proof
  sorry

-- Polynomial.cyclotomic.irreducible_rat: Φ_n is irreducible over ℚ.
theorem cyclotomic.irreducible_rat (n : Nat)
  requires positive : 0 < n
  shows RingIrreducible(polynomialRing(rationalRing, {0}), cyclotomic(rationalRing, n))
proof
  sorry

-- Section: Cyclotomic extensions of fields
section CyclotomicFields
variable (E : Set)
hypothesis extension : FieldExtension(E)

-- IsCyclotomicExtension.zeta_spec: a primitive n-th root ζ of a
-- {n}-cyclotomic extension, and IsCyclotomicExtension.adjoin_primitive_root_eq_top:
-- L = K(ζ).
theorem IsCyclotomicExtension.zeta_spec (n : Nat)
  requires positive : 0 < n
  requires cyclotomic : IsCyclotomicExtension({n}, E)
  shows ∃ ζ ∈ algebraCarrier(E), IsPrimitiveRoot(Algebra.ring(E), ζ, n)
proof
  sorry

theorem IsCyclotomicExtension.adjoin_primitive_root (ζ : Set) (n : Nat)
  requires positive : 0 < n
  requires cyclotomic : IsCyclotomicExtension({n}, E)
  requires primitive : IsPrimitiveRoot(Algebra.ring(E), ζ, n)
  shows fieldAdjoin(E, {ζ}) = algebraCarrier(E) ∧ adjoinOf(E, {ζ}) = algebraCarrier(E)
proof
  sorry

-- IntermediateField.isCyclotomicExtension_adjoin_of_exists_isPrimitiveRoot,
-- IsPrimitiveRoot.intermediateField_adjoin_isCyclotomicExtension: K(ζ)
-- is {n}-cyclotomic over K.
theorem IsPrimitiveRoot.adjoin_cyclotomic (ζ : Set) (n : Nat)
  requires positive : 0 < n
  requires primitive : IsPrimitiveRoot(Algebra.ring(E), ζ, n)
  shows IsCyclotomicExtension({n}, subextension(E, fieldAdjoin(E, {ζ})))
proof
  sorry

-- IsCyclotomicExtension of S ⊆ T: an extension cyclotomic for {m}
-- contains primitive n-th roots for n ∣ m (IsCyclotomicExtension.le_of_dvd
-- in its consequence for roots).
theorem IsCyclotomicExtension.primitive_of_dvd (m n : Nat)
  requires positive : 0 < n
  requires divides : n ∣ m
  requires largePositive : 0 < m
  requires cyclotomic : IsCyclotomicExtension({m}, E)
  shows ∃ ζ ∈ algebraCarrier(E), IsPrimitiveRoot(Algebra.ring(E), ζ, n)
proof
  sorry

-- A finite set S of orders, invertible in K, gives a finite Galois
-- extension with abelian Galois group (IsCyclotomicExtension.finiteDimensional,
-- IsCyclotomicExtension.isGalois, IsCyclotomicExtension.isAbelianGalois).
theorem IsCyclotomicExtension.finite_galois (S : Set)
  requires cyclotomic : IsCyclotomicExtension(S, E)
  requires finite : Finite(S)
  requires invertible : ∀ n ∈ S, natCast(Algebra.base(E), n) ≠ Ring.zero(Algebra.base(E))
  shows FiniteExtension(E) ∧ GaloisExtension(E) ∧ AbelianGroup(galoisGroup(E))
proof
  sorry

-- The cyclotomic polynomial splits in an {n}-cyclotomic extension and
-- generates it: L is a splitting field of Φ_n (IsCyclotomicExtension.splitting_field_cyclotomic).
theorem IsCyclotomicExtension.splitting_field (n : Nat)
  requires positive : 0 < n
  requires cyclotomic : IsCyclotomicExtension({n}, E)
  requires invertible : natCast(Algebra.base(E), n) ≠ Ring.zero(Algebra.base(E))
  shows IsSplittingField(E, cyclotomic(Algebra.base(E), n))
proof
  sorry

-- CyclotomicField n K with CyclotomicField.isCyclotomicExtension: a
-- {n}-cyclotomic extension exists when n · 1 ≠ 0 in K (stated as
-- existence; no field is chosen), unique up to K-isomorphism
-- (IsCyclotomicExtension.algEquiv).
theorem IsCyclotomicExtension.exists (n : Nat)
  requires positive : 0 < n
  requires invertible : natCast(Algebra.base(E), n) ≠ Ring.zero(Algebra.base(E))
  shows ∃ E2, Algebra.base(E2) = Algebra.base(E) ∧ FieldExtension(E2) ∧
    IsCyclotomicExtension({n}, E2)
proof
  sorry

theorem IsCyclotomicExtension.unique (E2 : Set) (n : Nat)
  requires positive : 0 < n
  requires second : FieldExtension(E2)
  requires sameBase : Algebra.base(E2) = Algebra.base(E)
  requires first : IsCyclotomicExtension({n}, E)
  requires secondCyclotomic : IsCyclotomicExtension({n}, E2)
  shows ∃ f, f : E ≃ₐ E2
proof
  sorry

-- IsCyclotomicExtension.autEquivPow: when Φ_n is irreducible over K,
-- σ ↦ (the j with σ(ζ) = ζ^j) is an isomorphism Gal(L/K) ≅ (ℤ/nℤ)ˣ;
-- in general it is an injective homomorphism
-- (IsPrimitiveRoot.autToPow_injective).
theorem IsCyclotomicExtension.character_injective (n : Nat)
  requires positive : 0 < n
  requires cyclotomic : IsCyclotomicExtension({n}, E)
  requires invertible : natCast(Algebra.base(E), n) ≠ Ring.zero(Algebra.base(E))
  shows GroupHom(restrict(modularCyclotomicCharacter(Algebra.ring(E), n),
      algebraAutomorphisms(E)), galoisGroup(E), unitGroup(zmod(n))) ∧
    InjectiveBetween(restrict(modularCyclotomicCharacter(Algebra.ring(E), n),
      algebraAutomorphisms(E)), algebraAutomorphisms(E), ringUnits(zmod(n)))
proof
  sorry

theorem IsCyclotomicExtension.aut_equiv_pow (n : Nat)
  requires positive : 0 < n
  requires cyclotomic : IsCyclotomicExtension({n}, E)
  requires invertible : natCast(Algebra.base(E), n) ≠ Ring.zero(Algebra.base(E))
  requires irreducible : RingIrreducible(polynomialRing(Algebra.base(E), {0}),
    cyclotomic(Algebra.base(E), n))
  shows GroupIso(restrict(modularCyclotomicCharacter(Algebra.ring(E), n),
    algebraAutomorphisms(E)), galoisGroup(E), unitGroup(zmod(n)))
proof
  sorry

end CyclotomicFields

-- Section: Over ℚ
section Rationals
variable (E : Set)
hypothesis extension : FieldExtension(E)
hypothesis base : Algebra.base(E) = rationalRing

-- Polynomial.cyclotomic_eq_minpoly (over ℚ, with minpoly.isIntegrallyClosed_eq_field_fractions):
-- the minimal polynomial over ℚ of a primitive n-th root is Φ_n.
theorem cyclotomic.eq_minpoly (ζ : Set) (n : Nat)
  requires positive : 0 < n
  requires primitive : IsPrimitiveRoot(Algebra.ring(E), ζ, n)
  shows IntegralElement(E, ζ) ∧ minpoly(E, ζ) = cyclotomic(rationalRing, n)
proof
  sorry

-- IsCyclotomicExtension.Rat.finrank: [ℚ(ζ_n) : ℚ] = φ(n); the Galois
-- group is (ℤ/nℤ)ˣ (autEquivPow with irreducible_rat).
theorem IsCyclotomicExtension.Rat.finrank (n : Nat)
  requires positive : 0 < n
  requires cyclotomic : IsCyclotomicExtension({n}, E)
  shows FiniteExtension(E) ∧ extensionDegree(E) = totient(n) ∧
    GroupIso(restrict(modularCyclotomicCharacter(Algebra.ring(E), n),
      algebraAutomorphisms(E)), galoisGroup(E), unitGroup(zmod(n)))
proof
  sorry

end Rationals

-- Section: The modular cyclotomic character
section Character
variable (L : Set) (n : Nat)
hypothesis domain : IntegralDomain(L)
hypothesis positive : 0 < n
hypothesis count : HasCardinality(rootsOfUnity(L, n), n)

-- modularCyclotomicCharacter.spec: σ(ζ) = ζ^j on μ_n, with j a unit of
-- ℤ/nℤ, and the character is a homomorphism Aut(L) → (ℤ/nℤ)ˣ
-- (modularCyclotomicCharacter, MonoidHom).
theorem modularCyclotomicCharacter.spec (σ ζ : Set)
  requires automorphism : σ ∈ ringAutomorphisms(L)
  requires root : ζ ∈ rootsOfUnity(L, n)
  shows modularCyclotomicCharacter(L, n)(σ) ∈ ringUnits(zmod(n)) ∧
    σ(ζ) = Ring.pow(L, ζ, zmodVal(n, modularCyclotomicCharacter(L, n)(σ)))
proof
  sorry

theorem modularCyclotomicCharacter.mul (σ τ : Set)
  requires first : σ ∈ ringAutomorphisms(L)
  requires second : τ ∈ ringAutomorphisms(L)
  shows modularCyclotomicCharacter(L, n)(compose(σ, τ, Ring.carrier(L),
      Ring.carrier(L), Ring.carrier(L))) =
    call2(Ring.mul(zmod(n)), modularCyclotomicCharacter(L, n)(σ),
      modularCyclotomicCharacter(L, n)(τ))
proof
  sorry

-- Algebra automorphisms are ring automorphisms; restricted to Gal(L/K)
-- the character is a homomorphism to (ℤ/nℤ)ˣ, locally constant for the
-- Krull topology when L/K is algebraic (the continuity behind
-- cyclotomicCharacter.continuous, at the finite level n).
theorem modularCyclotomicCharacter.galois_hom (E : Set)
  requires extension : FieldExtension(E)
  requires ring : Algebra.ring(E) = L
  shows algebraAutomorphisms(E) ⊆ ringAutomorphisms(L) ∧
    GroupHom(restrict(modularCyclotomicCharacter(L, n), algebraAutomorphisms(E)),
      galoisGroup(E), unitGroup(zmod(n)))
proof
  sorry

theorem modularCyclotomicCharacter.locally_constant (E : Set)
  requires algebraic : AlgebraicExtension(E)
  requires ring : Algebra.ring(E) = L
  shows IsLocallyConstant(restrict(modularCyclotomicCharacter(L, n),
    algebraAutomorphisms(E)), krullTopology(E))
proof
  sorry

end Character
