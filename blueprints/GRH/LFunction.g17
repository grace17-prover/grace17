-- Dirichlet L-functions. For N ≥ 1 and a Dirichlet character χ modulo N,
-- L(s, χ) = N^(−s) Σ_{j=1}^{N} χ(j) ζ(s, j/N) on all of ℂ, as Mathlib's
-- DirichletCharacter.LFunction (through ZMod.LFunction, the residue 0
-- represented by a = 1). For re s > 1 it is Σ_{n≥1} χ(n) n^(−s),
-- absolutely convergent, and the Euler product; it is holomorphic on ℂ for
-- χ non-principal and on ℂ ∖ {1} for χ principal; L(1, χ) is the value
-- of the continuous extension and is nonzero for χ non-principal; L(·, 1)
-- modulo 1 is ζ; and inducing from a divisor of N multiplies by the Euler
-- factors at the primes dividing N.
-- Part of the GRH blueprint.
-- Planned home: NumberTheory/Zeta/Dirichlet.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.LFunction
import GRH.Zeta
import GRH.DirichletCharacter

section LFunctions
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- Section: Definitions
-- The terms χ(j + 1) ζ(s, (j + 1)/N), j = 0, …, N − 1, of the Hurwitz
-- decomposition; the last, j + 1 = N, is χ(N) ζ(s, 1) = χ(0) ζ(s).
defgraph lFunctionTerms (N : Nat, χ s : Set) (j ∈ ℕ) : complexCarrier :=
  ℂ[χ(integerOfNat(j + 1)) * hurwitzZeta(s, R[realNat(j + 1) / realNat(N)])]
requires values : FunctionBetween(χ, ℤ, complexCarrier)
requires hs : s ∈ complexCarrier
proof
  have jNat := nat.omega.backward with member
  have index : integerOfNat(j + 1) ∈ ℤ by typecheck
  have value := FunctionBetween.apply_closed with values, index
  have point : Real(R[realNat(j + 1) / realNat(N)]) by typecheck
  have zeta := hurwitzZeta.member at s, R[realNat(j + 1) / realNat(N)] with hs
  typecheck

-- L(s, χ) = N^(−s) Σ_{j=1}^{N} χ(j) ζ(s, j/N). At s = 1 each ζ(1, j/N) is
-- the constant term hurwitzZeta.regular(j/N), so
-- L(1, χ) = N^(−1) Σ_{j=1}^{N} χ(j) hurwitzZeta.regular(j/N); for χ
-- non-principal Σ_j χ(j) = 0, the poles cancel, and this is the value of
-- the continuous extension (`LFunction.at_one`). For χ principal, s = 1 is
-- a pole and the value there is not read by any theorem.
def LFunction (N : Nat, χ s : Set) : Set :=
  ℂ[realCpow(realNat(N), ℂ[-s]) *
    complexPartialSum(lFunctionTerms(N, χ, s), N)]

-- L(s, χ) is a complex number.
theorem LFunction.closed (N : Nat) (χ s : Set)
  requires values : FunctionBetween(χ, ℤ, complexCarrier)
  requires hs : s ∈ complexCarrier
  shows LFunction(N, χ, s) ∈ complexCarrier
proof
  have terms := lFunctionTerms.function at N, χ, s with values, hs
  have sequence : ComplexSequence(lFunctionTerms(N, χ, s)) by exact terms
  have sum := complexPartialSum.member at lFunctionTerms(N, χ, s), N with
    sequence
  have negative : ℂ[-s] ∈ ℂ by typecheck
  have power := realCpow.member at realNat(N), ℂ[-s] with negative
  unfold LFunction
  typecheck

-- s ↦ L(s, χ) as a function on ℂ.
defgraph LFunctionMap (N : Nat, χ : Set) (s ∈ complexCarrier) :
    complexCarrier := LFunction(N, χ, s)
requires values : FunctionBetween(χ, ℤ, complexCarrier)
proof
  exact LFunction.closed with values, member

-- The terms χ(n) n^(−s), n = 1, 2, …, indexed from 0 as n + 1.
defgraph dirichletSeriesTerms (χ s : Set) (n ∈ ℕ) : complexCarrier :=
  ℂ[χ(integerOfNat(n + 1)) * realCpow(realNat(n + 1), ℂ[-s])]
requires values : FunctionBetween(χ, ℤ, complexCarrier)
requires hs : s ∈ complexCarrier
proof
  have nNat := nat.omega.backward with member
  have index : integerOfNat(n + 1) ∈ ℤ by typecheck
  have value := FunctionBetween.apply_closed with values, index
  have negative : ℂ[-s] ∈ ℂ by typecheck
  have power := realCpow.member at realNat(n + 1), ℂ[-s] with negative
  typecheck

-- The Euler factor (1 − χ(p) p^(−s))⁻¹ at a prime p, 1 at the other
-- naturals, and the partial products over the primes p < n.
defunique lEulerFactor (χ s : Set, p : Nat) (w ∈ complexCarrier) :=
  (Prime(p) → w = complexInv(ℂ[1 - χ(integerOfNat(p)) *
    realCpow(realNat(p), ℂ[-s])])) ∧
  (¬Prime(p) → w = ℂ[1])
requires values : FunctionBetween(χ, ℤ, complexCarrier)
requires hs : s ∈ complexCarrier
proof
  have index : integerOfNat(p) ∈ ℤ by typecheck
  have value := FunctionBetween.apply_closed with values, index
  have negative : ℂ[-s] ∈ ℂ by typecheck
  have power := realCpow.member at realNat(p), ℂ[-s] with negative
  have difference : ℂ[1 - χ(integerOfNat(p)) * realCpow(realNat(p), ℂ[-s])] ∈ ℂ
    by typecheck
  have inverse := complexInv.member with difference
  have one := complexOne.member
  by_cases prime : Prime(p)
  . witness complexInv(ℂ[1 - χ(integerOfNat(p)) * realCpow(realNat(p),
      ℂ[-s])])
    refine ⟨inverse, ?_, ?_⟩
    . intro isPrime
      rfl
    . intro notPrime
      exfalso
      exact notPrime with prime
  . witness ℂ[1]
    refine ⟨one, ?_, ?_⟩
    . intro isPrime
      exfalso
      exact prime with isPrime
    . intro notPrime
      rfl
uniqueness
  intros w wMember wValue v vMember vValue
  obtain ⟨wPrime, wOther⟩ := wValue
  obtain ⟨vPrime, vOther⟩ := vValue
  by_cases prime : Prime(p)
  . rw [(wPrime with prime), (vPrime with prime)]
  . rw [(wOther with prime), (vOther with prime)]

def lEulerProduct (χ s : Set) (n : Nat) → Set
  | χ, s, zero => complexOne
  | χ, s, succ(k) => complexMul(lEulerProduct(χ, s, k), lEulerFactor(χ, s, k))

theorem lEulerProduct.member (χ s : Set) (n : Nat)
  requires values : FunctionBetween(χ, ℤ, complexCarrier)
  requires hs : s ∈ complexCarrier
  shows lEulerProduct(χ, s, n) ∈ complexCarrier
proof
  induction n
  | zero =>
    rw lEulerProduct
    exact complexOne.member
  | succ(k) using ih =>
    obtain ⟨factor, _⟩ := lEulerFactor.selected at χ, s, k with values, hs
    rw lEulerProduct
    typecheck

defgraph lEulerProducts (χ s : Set) (n ∈ ℕ) : complexCarrier :=
    lEulerProduct(χ, s, n)
requires values : FunctionBetween(χ, ℤ, complexCarrier)
requires hs : s ∈ complexCarrier
proof
  have nNat := nat.omega.backward with member
  exact lEulerProduct.member with values, hs

-- The factor 1 − ψ(p) p^(−s) at a prime p dividing N, 1 at the other
-- naturals, and the product ∏_{p ∣ N} (1 − ψ(p) p^(−s)) over the primes
-- dividing N (all of them are at most N).
defunique levelFactor (N : Nat, ψ s : Set, p : Nat) (w ∈ complexCarrier) :=
  (Prime(p) ∧ p ∣ N → w = ℂ[1 - ψ(integerOfNat(p)) *
    realCpow(realNat(p), ℂ[-s])]) ∧
  (¬(Prime(p) ∧ p ∣ N) → w = ℂ[1])
requires values : FunctionBetween(ψ, ℤ, complexCarrier)
requires hs : s ∈ complexCarrier
proof
  have index : integerOfNat(p) ∈ ℤ by typecheck
  have value := FunctionBetween.apply_closed with values, index
  have negative : ℂ[-s] ∈ ℂ by typecheck
  have power := realCpow.member at realNat(p), ℂ[-s] with negative
  have difference : ℂ[1 - ψ(integerOfNat(p)) * realCpow(realNat(p), ℂ[-s])] ∈ ℂ
    by typecheck
  have one := complexOne.member
  by_cases dividing : Prime(p) ∧ p ∣ N
  . witness ℂ[1 - ψ(integerOfNat(p)) * realCpow(realNat(p), ℂ[-s])]
    refine ⟨difference, ?_, ?_⟩
    . intro yes
      rfl
    . intro no
      exfalso
      exact no with dividing
  . witness ℂ[1]
    refine ⟨one, ?_, ?_⟩
    . intro yes
      exfalso
      exact dividing with yes
    . intro no
      rfl
uniqueness
  intros w wMember wValue v vMember vValue
  obtain ⟨wYes, wNo⟩ := wValue
  obtain ⟨vYes, vNo⟩ := vValue
  by_cases dividing : Prime(p) ∧ p ∣ N
  . rw [(wYes with dividing), (vYes with dividing)]
  . rw [(wNo with dividing), (vNo with dividing)]

def levelProduct (N : Nat, ψ s : Set) (n : Nat) → Set
  | N, ψ, s, zero => complexOne
  | N, ψ, s, succ(k) => complexMul(levelProduct(N, ψ, s, k),
      levelFactor(N, ψ, s, k))

-- The values χ(j + 1), and the terms χ(j + 1) (ζ(s, (j + 1)/N) − 1/(s − 1))
-- of the regular part, with their partial sums as functions of s.
defgraph characterShift (χ : Set) (j ∈ ℕ) : complexCarrier :=
    χ(integerOfNat(j + 1))
requires values : FunctionBetween(χ, ℤ, complexCarrier)
proof
  have jNat := nat.omega.backward with member
  have index : integerOfNat(j + 1) ∈ ℤ by typecheck
  exact FunctionBetween.apply_closed with values, index

defgraph lRegularTerms (N : Nat, χ s : Set) (j ∈ ℕ) : complexCarrier :=
  ℂ[χ(integerOfNat(j + 1)) *
    hurwitzZetaRegularMap(R[realNat(j + 1) / realNat(N)])(s)]
requires values : FunctionBetween(χ, ℤ, complexCarrier)
requires hs : s ∈ complexCarrier
proof
  have jNat := nat.omega.backward with member
  have index : integerOfNat(j + 1) ∈ ℤ by typecheck
  have value := FunctionBetween.apply_closed with values, index
  have point : Real(R[realNat(j + 1) / realNat(N)]) by typecheck
  have regular := FunctionBetween.apply_closed with
    (hurwitzZetaRegularMap.function at R[realNat(j + 1) / realNat(N)]), hs
  typecheck

defgraph lRegularSumMap (N : Nat, χ : Set, n : Nat) (s ∈ complexCarrier) :
    complexCarrier := complexPartialSum(lRegularTerms(N, χ, s), n)
requires values : FunctionBetween(χ, ℤ, complexCarrier)
proof
  have terms := lRegularTerms.function at N, χ, s with values, member
  have sequence : ComplexSequence(lRegularTerms(N, χ, s)) by exact terms
  exact complexPartialSum.member at lRegularTerms(N, χ, s), n with sequence

-- Section: Facts
-- Section: The Hurwitz decomposition
-- Σ_{j<n} χ(j + 1) ζ(s, (j + 1)/N) splits into the regular parts and
-- (Σ_{j<n} χ(j + 1)) / (s − 1), at every s (at s = 1, 1/0 = 0).
theorem lFunctionTerms.split (N : Nat) (χ s : Set) (n : Nat)
  requires values : FunctionBetween(χ, ℤ, complexCarrier)
  requires hs : s ∈ ℂ
  shows complexPartialSum(lFunctionTerms(N, χ, s), n) =
    ℂ[complexPartialSum(lRegularTerms(N, χ, s), n) +
      complexPartialSum(characterShift(χ), n) * complexDiv(ℂ[1], ℂ[s - 1])]
proof
  have shifted : ℂ[s - 1] ∈ ℂ by typecheck
  have inverse := complexInv.member with shifted
  induction n
  | zero =>
    rw [complexPartialSum.zero, complexPartialSum.zero,
      complexPartialSum.zero]
    unfold complexDiv
    ring
  | succ(j) using ih =>
    have jMember : j ∈ ℕ := nat.omega.forward at j with *
    have index : integerOfNat(j + 1) ∈ ℤ by typecheck
    have value := FunctionBetween.apply_closed with values, index
    have point : Real(R[realNat(j + 1) / realNat(N)]) by typecheck
    have zeta := hurwitzZeta.member at s, R[realNat(j + 1) / realNat(N)] with hs
    have regularSequence := lRegularTerms.function at N, χ, s with values, hs
    have regularSum := complexPartialSum.member at lRegularTerms(N, χ, s), j
      with regularSequence
    have shiftSequence := characterShift.function with values
    have shiftSum := complexPartialSum.member at characterShift(χ), j with
      shiftSequence
    rw [complexPartialSum.succ, complexPartialSum.succ, complexPartialSum.succ,
      ih, (lFunctionTerms.value with values, hs, jMember),
      (lRegularTerms.value with values, hs, jMember),
      (characterShift.value with values, jMember),
      (hurwitzZetaRegularMap.value with hs)]
    unfold complexDiv
    ring

-- The pair form of addition used by characterSum is ring addition.
theorem complexAdd.pair_eq (x y : Set)
  shows complexAdd((x, y)) = ℂ[x + y]
proof
  unfold call2
  rfl

-- Σ_{j<n} χ(j + 1) = Σ_{k<n+1} χ(k) − χ(0).
theorem characterShift.partial (N : Nat) (χ : Set) (n : Nat)
  requires character : DirichletCharacter(N, χ)
  shows complexPartialSum(characterShift(χ), n) =
    ℂ[characterSum(χ, succ(n)) - χ(integerOfNat(0))]
proof
  have values := DirichletCharacter.function with character
  have zeroIndex : integerOfNat(0) ∈ ℤ by typecheck
  have zeroValue := FunctionBetween.apply_closed with values, zeroIndex
  induction n
  | zero =>
    rw [complexPartialSum.zero, characterSum.succ, characterSum.zero,
      complexAdd.pair_eq]
    ring
  | succ(k) using ih =>
    have kMember : k ∈ ℕ := nat.omega.forward at k with *
    have closed := characterSum.closed at N, χ, succ(k) with character
    have closedK := characterSum.closed at N, χ, k with character
    have kIndex : integerOfNat(k) ∈ ℤ by typecheck
    have kValue := FunctionBetween.apply_closed with values, kIndex
    have index : integerOfNat(k + 1) ∈ ℤ by typecheck
    have value := FunctionBetween.apply_closed with values, index
    have one : k + 1 = succ(k) := add.right_one with *
    rw [complexPartialSum.succ, ih, (characterSum.succ at χ, succ(k)),
      (characterShift.value with values, kMember), one, complexAdd.pair_eq]
    ring

-- Σ_{j<N} χ(j + 1) = Σ_{k<N} χ(k).
theorem characterShift.sum (N : Nat) (χ : Set)
  requires character : DirichletCharacter(N, χ)
  shows complexPartialSum(characterShift(χ), N) = characterSum(χ, N)
proof
  have values := DirichletCharacter.function with character
  have zeroIndex : integerOfNat(0) ∈ ℤ by typecheck
  have zeroValue := FunctionBetween.apply_closed with values, zeroIndex
  have nMember : N ∈ ℕ := nat.omega.forward at N with *
  have periodic := DirichletCharacter.periodic with character, zeroIndex
  have zeroSum := integerOfNat.add at 0, N
  have same : 0 + N = N by arith
  rw same at zeroSum
  rw ← zeroSum at periodic
  have closed := characterSum.closed at N, χ, N with character
  rw [(characterShift.partial at N, χ, N with character), characterSum.succ,
    periodic, complexAdd.pair_eq]
  ring

theorem LFunctionMap.apply (N : Nat) (χ s : Set)
  requires values : FunctionBetween(χ, ℤ, complexCarrier)
  requires hs : s ∈ ℂ
  shows LFunctionMap(N, χ)(s) = LFunction(N, χ, s)
proof
  exact LFunctionMap.value at N, χ, s with values, hs

theorem LFunction.member (N : Nat) (χ s : Set)
  requires character : DirichletCharacter(N, χ)
  requires hs : s ∈ ℂ
  shows LFunction(N, χ, s) ∈ ℂ
proof
  have values := DirichletCharacter.function with character
  exact LFunction.closed with values, hs

-- A quotient of positive reals is positive.
theorem real.div_positive (A B : Real)
  requires positiveA : R[0] < A
  requires positiveB : R[0] < B
  shows R[0] < R[A / B]
proof
  have nonzero : B ≠ R[0] by linarith
  have cancel := realDiv.mul_right at A, B with nonzero
  have quotientReal : Real(R[A / B]) by typecheck
  by_contra notPositive
  have nonpositive : R[A / B] ≤ R[0] by linarith
  have scaled := realLe.mul_right_of_nonnegative with nonpositive,
    (realLess.implies_le with positiveB)
  have zero : R[0 * B] = R[0] by ring
  linarith

-- The regular part Σ_{j<n} χ(j + 1)(ζ(s, (j + 1)/N) − 1/(s − 1)) is entire.
theorem lRegularSumMap.holomorphic (N : Nat) (χ : Set) (n : Nat) (U : Set)
  requires positive : 1 ≤ N
  requires values : FunctionBetween(χ, ℤ, complexCarrier)
  requires isOpen : ComplexOpen(U)
  shows HolomorphicOn(lRegularSumMap(N, χ, n), U)
proof
  have inside := ComplexOpen.subset with isOpen
  have whole := ComplexOpen.whole
  induction n
  | zero =>
    have zero : ℂ[0] ∈ ℂ by typecheck
    apply HolomorphicOn.const_formula with isOpen, zero
    intros z hz
    rw [(lRegularSumMap.value with values, (inside with z, hz)),
      complexPartialSum.zero]
  | succ(j) using ih =>
    have jMember : j ∈ ℕ := nat.omega.forward at j with *
    have index : integerOfNat(j + 1) ∈ ℤ by typecheck
    have value := FunctionBetween.apply_closed with values, index
    have numerator : R[0] < realNat(j + 1)
      have nonzero : j + 1 ≠ (0:N) by arith
      exact realNat.positive with nonzero
    have denominator : R[0] < realNat(N)
      have nonzero : N ≠ (0:N) by arith
      exact realNat.positive with nonzero
    have point := real.div_positive with numerator, denominator
    have regular := hurwitzZetaRegularMap.holomorphic at
      R[realNat(j + 1) / realNat(N)] with point
    have regularU := HolomorphicOn.mono with regular, isOpen, inside
    have constant := HolomorphicOn.const with isOpen, value
    have term := HolomorphicOn.mul with constant, regularU
    have constantCopy := constant
    have regularCopy := regularU
    obtain ⟨_, valuesConstant, _⟩ := constantCopy
    obtain ⟨_, valuesRegular, _⟩ := regularCopy
    apply HolomorphicOn.add_formula with ih, term
    intros z hz
    have zMember := inside with z, hz
    rw [(lRegularSumMap.value with values, zMember), complexPartialSum.succ,
      (lRegularTerms.value with values, zMember, jMember),
      (complexFunctionMul.value with valuesConstant, valuesRegular, hz),
      (complexFunctionConst.value with value, hz)]

-- L(s, χ) = N^(−s) (Σ_{j<N} χ(j + 1) R_{(j+1)/N}(s) + Σ_{k<N} χ(k)/(s − 1)).
theorem LFunction.decomposition (N : Nat) (χ s : Set)
  requires character : DirichletCharacter(N, χ)
  requires hs : s ∈ ℂ
  shows LFunction(N, χ, s) = ℂ[realCpow(realNat(N), ℂ[-s]) *
    (lRegularSumMap(N, χ, N)(s) + characterSum(χ, N) *
      complexDiv(ℂ[1], ℂ[s - 1]))]
proof
  have values := DirichletCharacter.function with character
  unfold LFunction
  rw [(lFunctionTerms.split with values, hs), (characterShift.sum with
    character), (lRegularSumMap.value with values, hs)]

-- Section: The Dirichlet series
-- The column sums Σ_{j<J} χ(j + 1) N^(−s) ((j + 1)/N + m)^(−s), m = 0, 1, …
defgraph lColumnStep (N : Nat, χ s : Set, m : Nat) (j ∈ ℕ) : complexCarrier :=
  ℂ[χ(integerOfNat(j + 1)) * realCpow(realNat(N), ℂ[-s]) *
    hurwitzSeriesTerms(s, R[realNat(j + 1) / realNat(N)])(m)]
requires values : FunctionBetween(χ, ℤ, complexCarrier)
requires hs : s ∈ complexCarrier
proof
  have jNat := nat.omega.backward with member
  have index : integerOfNat(j + 1) ∈ ℤ by typecheck
  have value := FunctionBetween.apply_closed with values, index
  have negative : ℂ[-s] ∈ ℂ by typecheck
  have power := realCpow.member at realNat(N), ℂ[-s] with negative
  have mMember : m ∈ ℕ := nat.omega.forward at m with *
  have term := FunctionBetween.apply_closed with
    (hurwitzSeriesTerms.function at s, R[realNat(j + 1) / realNat(N)] with hs),
    mMember
  typecheck

defgraph lColumnPartial (N : Nat, χ s : Set, J : Nat) (m ∈ ℕ) :
    complexCarrier := complexPartialSum(lColumnStep(N, χ, s, m), J)
requires values : FunctionBetween(χ, ℤ, complexCarrier)
requires hs : s ∈ complexCarrier
proof
  have mNat := nat.omega.backward with member
  have steps := lColumnStep.function at N, χ, s, m with values, hs
  have sequence : ComplexSequence(lColumnStep(N, χ, s, m)) by exact steps
  exact complexPartialSum.member at lColumnStep(N, χ, s, m), J with sequence

-- Each column is a scaled Hurwitz series, so the column sums converge.
theorem lColumnPartial.sums (N : Nat) (χ s : Set) (J : Nat)
  requires positive : 1 ≤ N
  requires values : FunctionBetween(χ, ℤ, complexCarrier)
  requires hs : s ∈ ℂ
  requires halfPlane : realOne < complexRe(s)
  shows ComplexSumsTo(lColumnPartial(N, χ, s, J),
    ℂ[realCpow(realNat(N), ℂ[-s]) * complexPartialSum(lFunctionTerms(N, χ, s),
      J)])
proof
  have negative : ℂ[-s] ∈ ℂ by typecheck
  have power := realCpow.member at realNat(N), ℂ[-s] with negative
  induction J
  | zero =>
    have columns := lColumnPartial.function at N, χ, s, 0 with values, hs
    have sequence : ComplexSequence(lColumnPartial(N, χ, s, 0))
      by exact columns
    have vanishing : ∀ n ∈ ℕ, (0:N) < n → lColumnPartial(N, χ, s, 0)(n) = ℂ[0]
      intros n nMember positiveN
      have nNat := nat.omega.backward with nMember
      rw [(lColumnPartial.value at N, χ, s, 0, n with values, hs),
        complexPartialSum.zero]
    have sums := ComplexSumsTo.first_only with sequence, vanishing
    have zeroMember : (0:N) ∈ ℕ := nat.omega.forward at (0:N) with *
    rw [(lColumnPartial.value at N, χ, s, 0, (0:N) with values, hs),
      complexPartialSum.zero] at sums
    rw complexPartialSum.zero
    have zero : ℂ[realCpow(realNat(N), ℂ[-s]) * 0] = ℂ[0] by ring
    rwa zero
  | succ(j) using ih =>
    have jMember : j ∈ ℕ := nat.omega.forward at j with *
    have index : integerOfNat(j + 1) ∈ ℤ by typecheck
    have value := FunctionBetween.apply_closed with values, index
    have numerator : R[0] < realNat(j + 1)
      have nonzero : j + 1 ≠ (0:N) by arith
      exact realNat.positive with nonzero
    have denominator : R[0] < realNat(N)
      have nonzero : N ≠ (0:N) by arith
      exact realNat.positive with nonzero
    have point := real.div_positive with numerator, denominator
    obtain ⟨hurwitz, _⟩ := hurwitzZeta.series at s, R[realNat(j + 1) /
      realNat(N)] with point, hs, halfPlane
    have zeroSeries := complexZeroSeries.sums
    have scale : ℂ[-(χ(integerOfNat(j + 1)) *
      realCpow(realNat(N), ℂ[-s]))] ∈ ℂ by typecheck
    have columns := lColumnPartial.function at N, χ, s, succ(j) with values,
      hs
    have sequence : ComplexSequence(lColumnPartial(N, χ, s, succ(j)))
      by exact columns
    have terms : ∀ m ∈ ℕ, lColumnPartial(N, χ, s, succ(j))(m) =
        ℂ[lColumnPartial(N, χ, s, j)(m) - complexFunctionConst(ℂ[0], ℕ)(m) -
          -(χ(integerOfNat(j + 1)) * realCpow(realNat(N), ℂ[-s])) *
          hurwitzSeriesTerms(s, R[realNat(j + 1) / realNat(N)])(m)]
      intros m mMember
      have mNat := nat.omega.backward with mMember
      have zero : ℂ[0] ∈ ℂ by typecheck
      have steps := lColumnStep.function at N, χ, s, m with values, hs
      have stepSequence : ComplexSequence(lColumnStep(N, χ, s, m))
        by exact steps
      have previous := complexPartialSum.member at lColumnStep(N, χ, s, m), j
        with stepSequence
      have term := FunctionBetween.apply_closed with
        (hurwitzSeriesTerms.function at s, R[realNat(j + 1) / realNat(N)] with
          hs), mMember
      rw [(lColumnPartial.value at N, χ, s, succ(j), m with values, hs),
        (lColumnPartial.value at N, χ, s, j, m with values, hs),
        complexPartialSum.succ, (lColumnStep.value at N, χ, s, m, j with values,
        hs),
        (complexFunctionConst.value with zero, mMember)]
      ring
    have combined := ComplexSumsTo.combination with ih, zeroSeries, hurwitz,
      scale, sequence, terms
    have zeta := hurwitzZeta.member at s, R[realNat(j + 1) / realNat(N)] with hs
    have lTerms := lFunctionTerms.function at N, χ, s with values, hs
    have lSequence : ComplexSequence(lFunctionTerms(N, χ, s)) by exact lTerms
    have previousSum := complexPartialSum.member at lFunctionTerms(N, χ, s), j
      with lSequence
    rw [complexPartialSum.succ, (lFunctionTerms.value with values, hs,
      jMember)]
    have shape : ℂ[realCpow(realNat(N), ℂ[-s]) *
        complexPartialSum(lFunctionTerms(N, χ, s), j) - 0 -
        -(χ(integerOfNat(j + 1)) * realCpow(realNat(N), ℂ[-s])) *
        hurwitzZeta(s, R[realNat(j + 1) / realNat(N)])] =
      ℂ[realCpow(realNat(N), ℂ[-s]) *
        (complexPartialSum(lFunctionTerms(N, χ, s), j) +
        χ(integerOfNat(j + 1)) * hurwitzZeta(s, R[realNat(j + 1) /
          realNat(N)]))] by ring
    rwa shape at combined

-- The block of N terms of the Dirichlet series starting at M N is the
-- column sum at M.
theorem dirichletSeriesTerms.block (N : Nat) (χ s : Set) (M : Nat)
  requires positive : 1 ≤ N
  requires character : DirichletCharacter(N, χ)
  requires hs : s ∈ ℂ
  shows complexBlock(dirichletSeriesTerms(χ, s), M * N) =
    lColumnStep(N, χ, s, M)
proof
  have values := DirichletCharacter.function with character
  have terms := dirichletSeriesTerms.function at χ, s with values, hs
  have sequence : ComplexSequence(dirichletSeriesTerms(χ, s)) by exact terms
  have block := complexBlock.function at dirichletSeriesTerms(χ, s), M * N
    with sequence
  have steps := lColumnStep.function at N, χ, s, M with values, hs
  apply FunctionBetween.ext with block, steps
  intros j jMember
  have jNat := nat.omega.backward with jMember
  have negative : ℂ[-s] ∈ ℂ by typecheck
  rw [(complexBlock.value with sequence, jMember),
    (dirichletSeriesTerms.value at χ, s, M * N + j with values, hs),
    (lColumnStep.value at N, χ, s, M, j with values, hs),
    (hurwitzSeriesTerms.value at s, R[realNat(j + 1) / realNat(N)], M with hs)]
  -- The character is periodic.
  have shift := DirichletCharacter.shift_natural at N, χ, M with character
  have index : integerOfNat(j + 1) ∈ ℤ by typecheck
  have periodic := shift with integerOfNat(j + 1), index
  have natural : M * N + j + 1 = j + 1 + N * M by arith
  rw [← integerOfNat.mul, ← integerOfNat.add, ← natural] at periodic
  rw periodic
  -- The powers multiply.
  have nPositive : R[0] < realNat(N)
    have nonzero : N ≠ (0:N) by arith
    exact realNat.positive with nonzero
  have nNonzero : realNat(N) ≠ R[0] by linarith
  have numerator : R[0] < realNat(j + 1)
    have nonzero : j + 1 ≠ (0:N) by arith
    exact realNat.positive with nonzero
  have quotient := real.div_positive with numerator, nPositive
  have mNonnegative := realNat.nonnegative at M
  have pointPositive : R[0] < R[realNat(M) + realNat(j + 1) / realNat(N)]
    by linarith
  have product := realCpow.mul_base with nPositive, pointPositive, negative
  have cancel := realDiv.mul_right at realNat(j + 1), realNat(N) with nNonzero
  have point : R[realNat(N) * (realNat(M) + realNat(j + 1) / realNat(N))] =
      realNat(M * N + j + 1)
    have target : realNat(M * N + j + 1) = R[realNat(M) * realNat(N) +
        realNat(j) + 1]
      rw [realNat.add, realNat.add, realNat.mul, realNat.one]
    have oneReal : realNat(j + 1) = R[realNat(j) + 1]
      rw [realNat.add, realNat.one]
    rw [target, oneReal]
    rw oneReal at cancel
    linear_combination cancel
  rw point at product
  rw product
  have value := FunctionBetween.apply_closed with values, index
  have first := realCpow.member at realNat(N), ℂ[-s] with negative
  have second := realCpow.member at R[realNat(M) + realNat(j + 1) /
    realNat(N)], ℂ[-s] with negative
  ring

-- Σ_{k<MN} χ(k + 1)(k + 1)^(−s) is the M-th partial sum of the columns.
theorem dirichletSeriesTerms.blocks (N : Nat) (χ s : Set) (M : Nat)
  requires positive : 1 ≤ N
  requires character : DirichletCharacter(N, χ)
  requires hs : s ∈ ℂ
  shows complexPartialSum(dirichletSeriesTerms(χ, s), M * N) =
    complexPartialSum(lColumnPartial(N, χ, s, N), M)
proof
  have values := DirichletCharacter.function with character
  have terms := dirichletSeriesTerms.function at χ, s with values, hs
  have sequence : ComplexSequence(dirichletSeriesTerms(χ, s)) by exact terms
  induction M
  | zero =>
    have zero : (0:N) * N = (0:N) by arith
    rw [zero, complexPartialSum.zero, complexPartialSum.zero]
  | succ(k) using ih =>
    have succNat : Nat(succ(k)) by typecheck
    have kMember : k ∈ ℕ := nat.omega.forward at k with *
    have index : succ(k) * N = k * N + N by arith
    rw [index, (complexPartialSum.block with sequence), ih,
      (dirichletSeriesTerms.block with positive, character, hs),
      complexPartialSum.succ, (lColumnPartial.value at N, χ, s, N, k with
      values, hs)]

-- For re s > 1, L(s, χ) = Σ_{n≥1} χ(n) n^(−s), absolutely convergent.
theorem LFunction.series (N : Nat) (χ s : Set)
  requires positive : 1 ≤ N
  requires character : DirichletCharacter(N, χ)
  requires hs : s ∈ ℂ
  requires halfPlane : realOne < complexRe(s)
  shows ComplexSumsTo(dirichletSeriesTerms(χ, s), LFunction(N, χ, s)) ∧
    ComplexAbsolutelySummable(dirichletSeriesTerms(χ, s))
proof
  have values := DirichletCharacter.function with character
  have positiveN : 0 < N by arith
  have terms := dirichletSeriesTerms.function at χ, s with values, hs
  have sequence : ComplexSequence(dirichletSeriesTerms(χ, s)) by exact terms
  -- Absolute convergence, against Σ n^(−σ).
  obtain ⟨_, absoluteZeta⟩ := zeta.series with hs, halfPlane
  obtain ⟨zetaSequence, zetaSummable⟩ := absoluteZeta
  have negative : ℂ[-s] ∈ ℂ by typecheck
  have bound : ∀ k ∈ ℕ, complexAbs(dirichletSeriesTerms(χ, s)(k)) ≤
      complexAbsSequence(zetaSeriesTerms(s))(k)
    intros k kMember
    have kNat := nat.omega.backward with kMember
    have index : integerOfNat(k + 1) ∈ ℤ by typecheck
    have value := FunctionBetween.apply_closed with values, index
    have power := realCpow.member at realNat(k + 1), ℂ[-s] with negative
    rw [(dirichletSeriesTerms.value at χ, s, k with values, hs),
      (complexAbsSequence.value with zetaSequence),
      (zetaSeriesTerms.value with hs, kMember), (complexAbs.mul with value,
      power)]
    have normBound := DirichletCharacter.norm_le_one with character,
      positiveN, index
    rw ← (complexAbs.square with value) at normBound
    have valueAbs := complexAbs.nonnegative with value
    have valueAbsReal := complexAbs.real with value
    have oneNonnegative : R[0] ≤ R[1] by linarith
    have unitSquare : R[1 * 1] = R[1] by ring
    have squares : R[complexAbs(χ(integerOfNat(k + 1))) *
      complexAbs(χ(integerOfNat(k + 1)))] ≤ R[1 * 1] by linarith
    have atMostOne := realMulValue.le_of_square_le with valueAbs,
      oneNonnegative, squares
    have powerAbs := complexAbs.nonnegative with power
    have scaled := realLe.mul_right_of_nonnegative with atMostOne, powerAbs
    have unit : R[1 * complexAbs(realCpow(realNat(k + 1), ℂ[-s]))] =
      complexAbs(realCpow(realNat(k + 1), ℂ[-s])) by ring
    linarith
  have absolute := ComplexAbsolutelySummable.of_bound with sequence,
    zetaSummable, bound
  refine ⟨?_, absolute⟩
  have summable := ComplexAbsolutelySummable.summable with absolute
  obtain ⟨S, sMember, sums⟩ := summable
  -- The column sums converge to L(s, χ), and they are partial sums of the
  -- series at the multiples of N.
  have columns := lColumnPartial.sums at N, χ, s, N with positive, values, hs,
    halfPlane
  have lMember := LFunction.closed with values, hs
  have sameLimit : S = LFunction(N, χ, s)
    apply complex.eq_of_common_near with sMember, lMember
    intros e eMember ePositive
    have sumsCopy := sums
    obtain ⟨_, convergesS⟩ := sumsCopy
    have prefixes := complexPrefixSums.function with sequence
    have prefixSequence : ComplexSequence(complexPrefixSums(
      dirichletSeriesTerms(χ, s))) by exact prefixes
    obtain ⟨K, kMember, nearS⟩ := (ComplexConvergesTo.iff_abs with
      prefixSequence, sMember).forward with convergesS, e, eMember, ePositive
    have columnsCopy := columns
    obtain ⟨columnSequence, convergesL⟩ := columnsCopy
    have columnPrefixes := complexPrefixSums.function with columnSequence
    have columnPrefixSequence : ComplexSequence(complexPrefixSums(
      lColumnPartial(N, χ, s, N))) by exact columnPrefixes
    unfold LFunction at lMember
    obtain ⟨M0, m0Member, nearL⟩ := (ComplexConvergesTo.iff_abs with
      columnPrefixSequence, lMember).forward with convergesL, e, eMember,
      ePositive
    have kNat := nat.omega.backward with kMember
    have m0Nat := nat.omega.backward with m0Member
    obtain ⟨P, pNat, nSplit⟩ := LessEqual.exists_add with positive
    have mMember : K + M0 ∈ ℕ by typecheck
    have productMember : (K + M0) * N ∈ ℕ by typecheck
    have laterL : M0 ≤ K + M0 by arith
    have laterS : K ≤ (K + M0) * N
      rw nSplit
      have expand : (K + M0) * (1 + P) = K + M0 + (K + M0) * P by arith
      rw expand
      arith
    have closeS := nearS with (K + M0) * N, productMember, laterS
    have closeL := nearL with K + M0, mMember, laterL
    rw (complexPrefixSums.value with sequence) at closeS
    rw (complexPrefixSums.value with columnSequence) at closeL
    rw ← (dirichletSeriesTerms.blocks with positive, character, hs) at closeL
    have partialMember := complexPartialSum.member at
      dirichletSeriesTerms(χ, s), (K + M0) * N with sequence
    refine ⟨complexPartialSum(dirichletSeriesTerms(χ, s), (K + M0) * N),
      partialMember, closeS, ?_⟩
    unfold LFunction
    exact closeL
  rwa sameLimit at sums

-- L(·, χ) is holomorphic on ℂ ∖ {1} for every χ.
theorem LFunction.holomorphic_off_one (N : Nat) (χ : Set)
  requires positive : 1 ≤ N
  requires character : DirichletCharacter(N, χ)
  shows HolomorphicOn(LFunctionMap(N, χ), complexCarrier ∖ {ℂ[1]})
proof
  have values := DirichletCharacter.function with character
  have one := complexOne.member
  have isOpen := complexPunctured.open with one
  have inside := ComplexOpen.subset with isOpen
  have zero : ℂ[0] ∈ ℂ by typecheck
  have minusOne : ℂ[-1] ∈ ℂ by typecheck
  have sumMember := characterSum.closed at N, χ, N with character
  have power := affinePower.holomorphic at realNat(N), ℂ[0], ℂ[-1],
    complexCarrier ∖ {ℂ[1]} with zero, minusOne, isOpen, inside
  have regular := lRegularSumMap.holomorphic at N, χ, N, complexCarrier ∖
    {ℂ[1]} with positive, values, isOpen
  have identity := HolomorphicOn.id with isOpen
  have shiftConstant := HolomorphicOn.const with isOpen, minusOne
  have shiftedMap := HolomorphicOn.add with identity, shiftConstant
  have unitConstant := HolomorphicOn.const with isOpen, one
  have identityCopy := identity
  have shiftConstantCopy := shiftConstant
  obtain ⟨_, valuesId, _⟩ := identityCopy
  obtain ⟨_, valuesShift, _⟩ := shiftConstantCopy
  have shiftedNonzero : ∀ z ∈ complexCarrier ∖ {ℂ[1]},
      complexFunctionAdd(complexFunctionId(complexCarrier ∖ {ℂ[1]}),
      complexFunctionConst(ℂ[-1], complexCarrier ∖ {ℂ[1]}),
      complexCarrier ∖ {ℂ[1]})(z) ≠ ℂ[0]
    intros z hz
    have zMember := inside with z, hz
    rw [(complexFunctionAdd.value with valuesId, valuesShift, hz),
      (complexFunctionId.value with inside, hz),
      (complexFunctionConst.value with minusOne, hz)]
    intro vanishes
    obtain ⟨_, notSingleton⟩ := hz
    apply notSingleton
    have same : z = ℂ[1] by linear_combination vanishes
    rw same
    exact singleton.self at ℂ[1]
  have reciprocal := HolomorphicOn.div with unitConstant, shiftedMap,
    shiftedNonzero
  have sumConstant := HolomorphicOn.const with isOpen, sumMember
  have scaled := HolomorphicOn.mul with sumConstant, reciprocal
  have bracket := HolomorphicOn.add with regular, scaled
  have unitCopy := unitConstant
  have shiftedCopy := shiftedMap
  have reciprocalCopy := reciprocal
  have sumConstantCopy := sumConstant
  have regularCopy := regular
  have scaledCopy := scaled
  obtain ⟨_, valuesUnit, _⟩ := unitCopy
  obtain ⟨_, valuesShifted, _⟩ := shiftedCopy
  obtain ⟨_, valuesReciprocal, _⟩ := reciprocalCopy
  obtain ⟨_, valuesSum, _⟩ := sumConstantCopy
  obtain ⟨_, valuesRegular, _⟩ := regularCopy
  obtain ⟨_, valuesScaled, _⟩ := scaledCopy
  apply HolomorphicOn.mul_formula with power, bracket
  intros z hz
  have zMember := inside with z, hz
  have exponent : ℂ[0 + -1 * z] = ℂ[-z] by ring
  rw [(LFunctionMap.apply with values, zMember), (LFunction.decomposition with
    character, zMember), (affinePower.value with zero, minusOne, zMember),
    exponent, (complexFunctionAdd.value with valuesRegular, valuesScaled, hz),
    (complexFunctionMul.value with valuesSum, valuesReciprocal, hz),
    (complexFunctionConst.value with sumMember, hz),
    (complexFunctionDiv.value with valuesUnit, valuesShifted, hz),
    (complexFunctionConst.value with one, hz),
    (complexFunctionAdd.value with valuesId, valuesShift, hz),
    (complexFunctionId.value with inside, hz),
    (complexFunctionConst.value with minusOne, hz)]

-- For χ non-principal the pole cancels: L(·, χ) is entire.
theorem LFunction.holomorphic (N : Nat) (χ : Set)
  requires positive : 1 ≤ N
  requires character : DirichletCharacter(N, χ)
  requires nonPrincipal : χ ≠ principalCharacter(N)
  shows HolomorphicOn(LFunctionMap(N, χ), complexCarrier)
proof
  have values := DirichletCharacter.function with character
  have whole := ComplexOpen.whole
  have inside := ComplexOpen.subset with whole
  have zero : ℂ[0] ∈ ℂ by typecheck
  have minusOne : ℂ[-1] ∈ ℂ by typecheck
  have positiveN : 0 < N by arith
  have vanishing := characterSum.non_principal with character, positiveN,
    nonPrincipal
  have power := affinePower.holomorphic at realNat(N), ℂ[0], ℂ[-1],
    complexCarrier with zero, minusOne, whole, inside
  have regular := lRegularSumMap.holomorphic at N, χ, N, complexCarrier with
    positive, values, whole
  apply HolomorphicOn.mul_formula with power, regular
  intros z hz
  have exponent : ℂ[0 + -1 * z] = ℂ[-z] by ring
  have regularValue := FunctionBetween.apply_closed with
    (lRegularSumMap.function at N, χ, N with values), hz
  have shifted : ℂ[z - 1] ∈ ℂ by typecheck
  have inverse := complexInv.member with shifted
  rw [(LFunctionMap.apply with values, hz), (LFunction.decomposition with
    character, hz), vanishing, (affinePower.value with zero, minusOne, hz),
    exponent]
  unfold complexDiv
  ring

-- For χ non-principal, L(s, χ) → L(1, χ) as s → 1.
theorem LFunction.at_one (N : Nat) (χ : Set)
  requires positive : 1 ≤ N
  requires character : DirichletCharacter(N, χ)
  requires nonPrincipal : χ ≠ principalCharacter(N)
  shows ∀ e ∈ ℝ, R[0] < e → ∃ d ∈ ℝ, R[0] < d ∧
    (∀ s ∈ ℂ, s ≠ ℂ[1] → complexAbs(ℂ[s - 1]) < d →
      complexAbs(ℂ[LFunction(N, χ, s) - LFunction(N, χ, ℂ[1])]) < e)
proof
  have values := DirichletCharacter.function with character
  have holomorphic := LFunction.holomorphic with positive, character,
    nonPrincipal
  have continuous := HolomorphicOn.continuous with holomorphic
  obtain ⟨_, _, close⟩ := continuous
  have one := complexOne.member
  intros e eMember ePositive
  obtain ⟨d, dReal, dPositive, near⟩ := close with ℂ[1], one, e, eMember,
    ePositive
  refine ⟨d, dReal, dPositive, ?_⟩
  intros s hs notOne small
  have estimate := near with s, hs, small
  rw [(LFunctionMap.apply with values, hs), (LFunctionMap.apply with values,
    one)] at estimate
  exact estimate

-- For χ principal the pole at 1 is simple with residue φ(N)/N.
theorem LFunction.principal_residue (N : Nat)
  requires positive : 1 ≤ N
  shows ∀ e ∈ ℝ, R[0] < e → ∃ d ∈ ℝ, R[0] < d ∧
    (∀ s ∈ ℂ, s ≠ ℂ[1] → complexAbs(ℂ[s - 1]) < d →
      complexAbs(ℂ[(s - 1) * LFunction(N, principalCharacter(N), s) -
        complexOfReal(R[realNat(totient(N)) / realNat(N)])]) < e)
proof
  have character := principalCharacter.character at N
  have values := DirichletCharacter.function with character
  have whole := ComplexOpen.whole
  have inside := ComplexOpen.subset with whole
  have one := complexOne.member
  have zero : ℂ[0] ∈ ℂ by typecheck
  have minusOne : ℂ[-1] ∈ ℂ by typecheck
  have positiveN : 0 < N by arith
  have total := characterSum.principal with positiveN
  rw ← complexOfReal.nat at total
  have totalMember := complexOfReal.mem at realNat(totient(N))
  -- G(s) = N^(−s) ((s − 1) R(s) + φ(N)) is entire.
  have power := affinePower.holomorphic at realNat(N), ℂ[0], ℂ[-1],
    complexCarrier with zero, minusOne, whole, inside
  have regular := lRegularSumMap.holomorphic at N, principalCharacter(N), N, complexCarrier
    with positive, values, whole
  have identity := HolomorphicOn.id with whole
  have shiftConstant := HolomorphicOn.const with whole, minusOne
  have shiftedMap := HolomorphicOn.add with identity, shiftConstant
  have product := HolomorphicOn.mul with shiftedMap, regular
  have totalConstant := HolomorphicOn.const with whole, totalMember
  have bracket := HolomorphicOn.add with product, totalConstant
  have full := HolomorphicOn.mul with power, bracket
  have powerCopy := power
  have regularCopy := regular
  have identityCopy := identity
  have shiftConstantCopy := shiftConstant
  have shiftedCopy := shiftedMap
  have productCopy := product
  have totalCopy := totalConstant
  have bracketCopy := bracket
  obtain ⟨_, valuesPower, _⟩ := powerCopy
  obtain ⟨_, valuesRegular, _⟩ := regularCopy
  obtain ⟨_, valuesId, _⟩ := identityCopy
  obtain ⟨_, valuesShift, _⟩ := shiftConstantCopy
  obtain ⟨_, valuesShifted, _⟩ := shiftedCopy
  obtain ⟨_, valuesProduct, _⟩ := productCopy
  obtain ⟨_, valuesTotal, _⟩ := totalCopy
  obtain ⟨_, valuesBracket, _⟩ := bracketCopy
  have formula : ∀ z ∈ ℂ, complexFunctionMul(affinePower(realNat(N), ℂ[0],
      ℂ[-1]), complexFunctionAdd(complexFunctionMul(complexFunctionAdd(
      complexFunctionId(complexCarrier), complexFunctionConst(ℂ[-1],
      complexCarrier), complexCarrier), lRegularSumMap(N, principalCharacter(N), N),
      complexCarrier), complexFunctionConst(complexOfReal(realNat(totient(N))),
      complexCarrier), complexCarrier), complexCarrier)(z) =
      ℂ[realCpow(realNat(N), ℂ[-z]) * ((z - 1) * lRegularSumMap(N, principalCharacter(N), N)(z) +
        complexOfReal(realNat(totient(N))))]
    intros z hz
    have exponent : ℂ[0 + -1 * z] = ℂ[-z] by ring
    rw [(complexFunctionMul.value with valuesPower, valuesBracket, hz),
      (complexFunctionAdd.value with valuesProduct, valuesTotal, hz),
      (complexFunctionMul.value with valuesShifted, valuesRegular, hz),
      (complexFunctionAdd.value with valuesId, valuesShift, hz),
      (complexFunctionId.value with inside, hz),
      (complexFunctionConst.value with minusOne, hz),
      (complexFunctionConst.value with totalMember, hz),
      (affinePower.value with zero, minusOne, hz), exponent]
  have continuous := HolomorphicOn.continuous with full
  obtain ⟨_, _, close⟩ := continuous
  intros e eMember ePositive
  obtain ⟨d, dReal, dPositive, near⟩ := close with ℂ[1], one, e, eMember,
    ePositive
  refine ⟨d, dReal, dPositive, ?_⟩
  intros s hs notOne small
  have estimate := near with s, hs, small
  rw [(formula with s, hs), (formula with ℂ[1], one)] at estimate
  -- (s − 1) L(s) = G(s) and G(1) = φ(N)/N.
  have shifted : ℂ[s - 1] ∈ ℂ by typecheck
  have shiftedNonzero : ℂ[s - 1] ≠ ℂ[0]
    intro vanishes
    apply notOne
    linear_combination vanishes
  have cancel := complexInv.mul_cancel with shifted, shiftedNonzero
  have regularS := FunctionBetween.apply_closed with
    (lRegularSumMap.function at N, principalCharacter(N), N with values), hs
  have powerS := realCpow.member at realNat(N), ℂ[-s]
  have atS : ℂ[(s - 1) * LFunction(N, principalCharacter(N), s)] =
      ℂ[realCpow(realNat(N), ℂ[-s]) * ((s - 1) * lRegularSumMap(N, principalCharacter(N), N)(s) +
        complexOfReal(realNat(totient(N))))]
    rw [(LFunction.decomposition with character, hs), total]
    unfold complexDiv
    linear_combination (realCpow(realNat(N), ℂ[-s]) *
      complexOfReal(realNat(totient(N)))) * cancel
  have regularOne := FunctionBetween.apply_closed with
    (lRegularSumMap.function at N, principalCharacter(N), N with values), one
  have zeroShift : ℂ[1 - 1] = ℂ[0] by ring
  have nNonzero : realNat(N) ≠ R[0]
    have nonzero : N ≠ (0:N) by arith
    exact realNat.ne_zero with nonzero
  have nPositive : R[0] < realNat(N)
    have nonzero : N ≠ (0:N) by arith
    exact realNat.positive with nonzero
  have atOne : ℂ[realCpow(realNat(N), ℂ[-1]) * ((1 - 1) *
      lRegularSumMap(N, principalCharacter(N), N)(ℂ[1]) + complexOfReal(realNat(totient(N))))] =
      complexOfReal(R[realNat(totient(N)) / realNat(N)])
    have minus : ℂ[-1] = complexOfReal(R[-1])
      rw [complexOfReal.neg, complexOfReal.one]
    rw [zeroShift, minus, realCpow.of_real, (realRpow.neg with nPositive),
      (realRpow.one with nPositive)]
    have quotient : R[realNat(totient(N)) / realNat(N)] =
        R[1 / realNat(N) * realNat(totient(N))]
      rw [realDiv.eq_mul_inv, realDiv.eq_mul_inv]
      have inverse := realInvValue.real at realNat(N)
      ring
    rw [quotient, complexOfReal.mul]
    have inverseMember := complexOfReal.mem at R[1 / realNat(N)]
    ring
  rw [atS, ← atOne]
  exact estimate

-- Modulo 1 the only character is 1, and L(s, 1) = ζ(s) everywhere.
theorem LFunction.principal_one (χ s : Set)
  requires character : DirichletCharacter(1, χ)
  requires hs : s ∈ ℂ
  shows LFunction(1, χ, s) = riemannZeta(s)
proof
  have values := DirichletCharacter.function with character
  have index : integerOfNat(0 + 1) ∈ ℤ by typecheck
  have unit := DirichletCharacter.modulus_one with character, index
  have zeroMember : (0:N) ∈ ℕ := nat.omega.forward at (0:N) with *
  have oneNonzero : R[1] ≠ R[0] by linarith
  have quotient := realDiv.mul_right at R[1], R[1] with oneNonzero
  have point : R[realNat(0 + 1) / realNat(1)] = R[1]
    rw [natural.zero_add_one, realNat.one]
    linear_combination quotient
  unfold LFunction
  rw [natural.one_succ, complexPartialSum.succ, complexPartialSum.zero,
    (lFunctionTerms.value with values, hs, zeroMember), unit, point,
    ← natural.one_succ, (realCpow.nat_neg_one with hs)]
  have zeta := riemannZeta.member with hs
  unfold riemannZeta at zeta
  unfold riemannZeta
  ring

-- |χ(a)| ≤ 1.
theorem DirichletCharacter.abs_le_one (N : Nat) (χ a : Set)
  requires character : DirichletCharacter(N, χ)
  requires positive : 0 < N
  requires integer : a ∈ ℤ
  shows complexAbs(χ(a)) ≤ R[1]
proof
  have values := DirichletCharacter.function with character
  have value := FunctionBetween.apply_closed with values, integer
  have normBound := DirichletCharacter.norm_le_one with character, positive,
    integer
  rw ← (complexAbs.square with value) at normBound
  have valueAbs := complexAbs.nonnegative with value
  have valueAbsReal := complexAbs.real with value
  have oneNonnegative : R[0] ≤ R[1] by linarith
  have unitSquare : R[1 * 1] = R[1] by ring
  have squares : R[complexAbs(χ(a)) * complexAbs(χ(a))] ≤ R[1 * 1]
    by linarith
  exact realMulValue.le_of_square_le with valueAbs, oneNonnegative, squares

-- χ(q m) (q m)^(−s) = χ(q) q^(−s) χ(m) m^(−s), in the shifted indexing.
theorem dirichletSeriesTerms.multiplicative (N : Nat) (χ s : Set)
  requires character : DirichletCharacter(N, χ)
  requires hs : s ∈ ℂ
  shows ∀ r ∈ ℕ, ∀ j ∈ ℕ, dirichletSeriesTerms(χ, s)((r + 1) * j + r) =
    ℂ[dirichletSeriesTerms(χ, s)(r) * dirichletSeriesTerms(χ, s)(j)]
proof
  have values := DirichletCharacter.function with character
  have negative : ℂ[-s] ∈ ℂ by typecheck
  intros r rMember j jMember
  have rNat := nat.omega.backward with rMember
  have jNat := nat.omega.backward with jMember
  have position : (r + 1) * j + r ∈ ℕ by typecheck
  have index : (r + 1) * j + r + 1 = (r + 1) * (j + 1) by arith
  have positiveR : 1 ≤ r + 1 by arith
  have positiveJ : 1 ≤ j + 1 by arith
  have rInteger : integerOfNat(r + 1) ∈ ℤ by typecheck
  have jInteger : integerOfNat(j + 1) ∈ ℤ by typecheck
  have rValue := FunctionBetween.apply_closed with values, rInteger
  have jValue := FunctionBetween.apply_closed with values, jInteger
  have rPower := realCpow.member at realNat(r + 1), ℂ[-s] with negative
  have jPower := realCpow.member at realNat(j + 1), ℂ[-s] with negative
  rw [(dirichletSeriesTerms.value with values, hs, position),
    (dirichletSeriesTerms.value with values, hs, rMember),
    (dirichletSeriesTerms.value with values, hs, jMember), index,
    (realCpow.nat_neg_mul with positiveR, positiveJ, hs), integerOfNat.mul,
    (DirichletCharacter.mul with character, rInteger, jInteger)]
  ring

-- The hypotheses of the sieve for L(s, χ): t(n) = χ(n + 1) (n + 1)^(−s).
theorem LFunction.euler_sieve (N : Nat) (χ s : Set)
  requires positive : 1 ≤ N
  requires character : DirichletCharacter(N, χ)
  requires hs : s ∈ ℂ
  requires halfPlane : realOne < complexRe(s)
  shows ComplexConvergesTo(lEulerProducts(χ, s), LFunction(N, χ, s)) ∧
    LFunction(N, χ, s) ≠ ℂ[0]
proof
  have values := DirichletCharacter.function with character
  have positiveN : 0 < N by arith
  obtain ⟨sums, absolute⟩ := LFunction.series with positive, character, hs,
    halfPlane
  have products := lEulerProducts.function with values, hs
  have sequenceE : ComplexSequence(lEulerProducts(χ, s)) by exact products
  have negative : ℂ[-s] ∈ ℂ by typecheck
  have zeroMember : (0:N) ∈ ℕ := nat.omega.forward at (0:N) with *
  have first : dirichletSeriesTerms(χ, s)((0:N)) = ℂ[1]
    rw [(dirichletSeriesTerms.value with values, hs, zeroMember),
      natural.zero_add_one, (realCpow.nat_neg_one with hs), integerOfNat.one,
      (DirichletCharacter.one with character)]
    ring
  have multiplicativeAll := dirichletSeriesTerms.multiplicative with
    character, hs
  have multiplicative : ∀ r ∈ ℕ, Prime(r + 1) → (∀ j ∈ ℕ,
      dirichletSeriesTerms(χ, s)((r + 1) * j + r) =
        ℂ[dirichletSeriesTerms(χ, s)(r) * dirichletSeriesTerms(χ, s)(j)])
    intros r rMember prime
    exact multiplicativeAll with r, rMember
  have notOne : ∀ r ∈ ℕ, Prime(r + 1) → dirichletSeriesTerms(χ, s)(r) ≠ ℂ[1]
    intros r rMember prime isOne
    have rNat := nat.omega.backward with rMember
    have above := Prime.greater_than_one with prime
    have positiveR : 1 ≤ r + 1 by arith
    have rInteger : integerOfNat(r + 1) ∈ ℤ by typecheck
    have rValue := FunctionBetween.apply_closed with values, rInteger
    have rPower := realCpow.member at realNat(r + 1), ℂ[-s] with negative
    rw [(dirichletSeriesTerms.value with values, hs, rMember)] at isOne
    have size := complexAbs.mul with rValue, rPower
    rw [isOne, complexAbs.one, (realCpow.nat_neg_abs with positiveR, hs)] at
      size
    have valueBound := DirichletCharacter.abs_le_one with character,
      positiveN, rInteger
    have valueAbs := complexAbs.nonnegative with rValue
    have base := realNat.lt_of_lt with above
    rw realNat.one at base
    have reS : Real(complexRe(s)) by typecheck
    have exponent : R[-complexRe(s)] < R[0] by linarith
    have smaller := realRpow.lt_of_exponent with base, exponent
    rw realRpow.zero at smaller
    have powerPositive := realRpow.positive at realNat(r + 1),
      R[-complexRe(s)]
    have scaled := realLe.mul_right_of_nonnegative with valueBound,
      (realLess.implies_le with powerPositive)
    have valueReal := complexAbs.real with rValue
    have powerReal := realRpow.real at realNat(r + 1), R[-complexRe(s)]
    have unit : R[1 * realRpow(realNat(r + 1), R[-complexRe(s)])] =
      realRpow(realNat(r + 1), R[-complexRe(s)]) by ring
    linarith
  have start : lEulerProducts(χ, s)((0:N)) = ℂ[1]
    rw [(lEulerProducts.value with values, hs, zeroMember), lEulerProduct]
  have primeStep : ∀ r ∈ ℕ, Prime(r + 1) →
      lEulerProducts(χ, s)(r + 1 + 1) = ℂ[lEulerProducts(χ, s)(r + 1) *
        complexInv(ℂ[1 - dirichletSeriesTerms(χ, s)(r)])]
    intros r rMember prime
    have rNat := nat.omega.backward with rMember
    have here : r + 1 ∈ ℕ by typecheck
    have next : r + 1 + 1 ∈ ℕ by typecheck
    obtain ⟨_, primeValue, _⟩ := lEulerFactor.selected at χ, s, r + 1 with
      values, hs
    have index : r + 1 + 1 = succ(r + 1) by arith
    rw [(lEulerProducts.value with values, hs, next),
      (lEulerProducts.value with values, hs, here),
      (dirichletSeriesTerms.value with values, hs, rMember), index,
      lEulerProduct, (primeValue with prime)]
  have otherStep : ∀ k ∈ ℕ, ¬Prime(k) →
      lEulerProducts(χ, s)(k + 1) = lEulerProducts(χ, s)(k)
    intros k kMember notPrime
    have kNat := nat.omega.backward with kMember
    have next : k + 1 ∈ ℕ by typecheck
    obtain ⟨_, _, otherValue⟩ := lEulerFactor.selected at χ, s, k with values,
      hs
    have index : k + 1 = succ(k) by arith
    have product := lEulerProduct.member at χ, s, k with values, hs
    rw [(lEulerProducts.value with values, hs, next),
      (lEulerProducts.value with values, hs, kMember), index, lEulerProduct,
      (otherValue with notPrime)]
    ring
  exact ComplexConvergesTo.euler_sieve with absolute, sums, first,
    multiplicative, notOne, sequenceE, start, primeStep, otherStep

-- The Euler product: for re s > 1, ∏_{p < n} (1 − χ(p) p^(−s))⁻¹ → L(s, χ).
theorem LFunction.euler_product (N : Nat) (χ s : Set)
  requires positive : 1 ≤ N
  requires character : DirichletCharacter(N, χ)
  requires hs : s ∈ ℂ
  requires halfPlane : realOne < complexRe(s)
  shows ComplexConvergesTo(lEulerProducts(χ, s), LFunction(N, χ, s))
proof
  obtain ⟨converges, _⟩ := LFunction.euler_sieve with positive, character, hs,
    halfPlane
  exact converges

theorem LFunction.nonzero_re_gt_one (N : Nat) (χ s : Set)
  requires positive : 1 ≤ N
  requires character : DirichletCharacter(N, χ)
  requires hs : s ∈ ℂ
  requires halfPlane : realOne < complexRe(s)
  shows LFunction(N, χ, s) ≠ ℂ[0]
proof
  obtain ⟨_, nonzero⟩ := LFunction.euler_sieve with positive, character, hs,
    halfPlane
  exact nonzero

-- Section: The 3–4–1 inequality for L-functions
-- χ², the pointwise square of a character.
defgraph characterSquare (χ : Set) (a ∈ ℤ) : complexCarrier :=
    ℂ[χ(a) * χ(a)]
requires values : FunctionBetween(χ, ℤ, complexCarrier)
proof
  have value := FunctionBetween.apply_closed with values, member
  typecheck

theorem characterSquare.character (N : Nat) (χ : Set)
  requires character : DirichletCharacter(N, χ)
  shows DirichletCharacter(N, characterSquare(χ))
proof
  have values := DirichletCharacter.function with character
  have characterCopy := character
  obtain ⟨_, periodic, one, multiplicative, vanishing⟩ := characterCopy
  have function := characterSquare.function with values
  unfold DirichletCharacter
  refine ⟨function, ?_, ?_, ?_, ?_⟩
  . intros a aInteger
    have shifted : integerAddValue(a, integerOfNat(N)) ∈ ℤ by typecheck
    rw [(characterSquare.value with values, shifted),
      (characterSquare.value with values, aInteger), (periodic with a,
      aInteger)]
  . have oneInteger : integerOne ∈ ℤ by typecheck
    rw [(characterSquare.value with values, oneInteger), one]
    ring
  . intros a aInteger b bInteger
    have product : integerMulValue(a, b) ∈ ℤ by typecheck
    have aValue := FunctionBetween.apply_closed with values, aInteger
    have bValue := FunctionBetween.apply_closed with values, bInteger
    rw [(characterSquare.value with values, product),
      (characterSquare.value with values, aInteger),
      (characterSquare.value with values, bInteger), (multiplicative with a,
      aInteger, b, bInteger)]
    ring
  . intros a aInteger notCoprime
    rw [(characterSquare.value with values, aInteger), (vanishing with a,
      aInteger, notCoprime)]
    ring

-- For re s = 1 and e > 0:
-- |L(1 + e, χ₀)|⁶ |L(s + e, χ)|⁸ |L(2s − 1 + e, χ²)|² ≥ 1.
theorem LFunction.three_four_one (N : Nat) (χ s : Set) (e : Real)
  requires positive : 1 ≤ N
  requires character : DirichletCharacter(N, χ)
  requires hs : s ∈ ℂ
  requires onLine : complexRe(s) = R[1]
  requires ePositive : R[0] < e
  shows R[1] ≤ R[complexNormSquared(LFunction(N, principalCharacter(N),
    complexOfReal(R[1 + e]))) ^ 3 *
    complexNormSquared(LFunction(N, χ, ℂ[s + complexOfReal(e)])) ^ 4 *
    complexNormSquared(LFunction(N, characterSquare(χ),
    ℂ[s + s - 1 + complexOfReal(e)]))]
proof
  have positiveN : 0 < N by arith
  have principal := principalCharacter.character at N
  have square := characterSquare.character with character
  have values0 := DirichletCharacter.function with principal
  have values1 := DirichletCharacter.function with character
  have values2 := DirichletCharacter.function with square
  have eMember := complexOfReal.mem at e
  have aMember := complexOfReal.mem at R[1 + e]
  have bMember : ℂ[s + complexOfReal(e)] ∈ ℂ by typecheck
  have cMember : ℂ[s + s - 1 + complexOfReal(e)] ∈ ℂ by typecheck
  have one := complexOne.member
  have reOne : complexRe(ℂ[1]) = R[1]
    rw [← complexOfReal.one, complexOfReal.re]
  have reA : realOne < complexRe(complexOfReal(R[1 + e]))
    rw complexOfReal.re
    linarith
  have reB : realOne < complexRe(ℂ[s + complexOfReal(e)])
    rw [(complexRe.add with hs, eMember), onLine, complexOfReal.re]
    linarith
  have twoS : ℂ[s + s] ∈ ℂ by typecheck
  have twoSMinus : ℂ[s + s - 1] ∈ ℂ by typecheck
  have reC : realOne < complexRe(ℂ[s + s - 1 + complexOfReal(e)])
    rw [(complexRe.add with twoSMinus, eMember), (complexRe.sub with twoS, one),
      (complexRe.add with hs, hs), onLine, reOne, complexOfReal.re]
    linarith
  have euler1 := LFunction.euler_product with positive, principal, aMember,
    reA
  have euler2 := LFunction.euler_product with positive, character, bMember,
    reB
  have euler3 := LFunction.euler_product with positive, square, cMember, reC
  apply eulerProducts.three_four_one_limit with euler1, euler2, euler3
  intros n nMember
  have nNat := nat.omega.backward with nMember
  have zeroMember : (0:N) ∈ ℕ := nat.omega.forward at (0:N) with *
  have start1 : lEulerProducts(principalCharacter(N),
      complexOfReal(R[1 + e]))((0:N)) = ℂ[1]
    rw [(lEulerProducts.value with values0, aMember, zeroMember), lEulerProduct]
  have start2 : lEulerProducts(χ, ℂ[s + complexOfReal(e)])((0:N)) = ℂ[1]
    rw [(lEulerProducts.value with values1, bMember, zeroMember), lEulerProduct]
  have start3 : lEulerProducts(characterSquare(χ),
      ℂ[s + s - 1 + complexOfReal(e)])((0:N)) = ℂ[1]
    rw [(lEulerProducts.value with values2, cMember, zeroMember), lEulerProduct]
  have values : ∀ k ∈ ℕ, lEulerProducts(principalCharacter(N),
      complexOfReal(R[1 + e]))(k) ∈ ℂ ∧
      lEulerProducts(χ, ℂ[s + complexOfReal(e)])(k) ∈ ℂ ∧
      lEulerProducts(characterSquare(χ), ℂ[s + s - 1 +
        complexOfReal(e)])(k) ∈ ℂ
    intros k kMember
    have p1 := lEulerProducts.function with values0, aMember
    have p2 := lEulerProducts.function with values1, bMember
    have p3 := lEulerProducts.function with values2, cMember
    exact ⟨(FunctionBetween.apply_closed with p1, kMember),
      (FunctionBetween.apply_closed with p2, kMember),
      (FunctionBetween.apply_closed with p3, kMember)⟩
  have step : ∀ k ∈ ℕ, ∃ f1 ∈ ℂ, ∃ f2 ∈ ℂ, ∃ f3 ∈ ℂ,
      lEulerProducts(principalCharacter(N), complexOfReal(R[1 + e]))(k + 1) =
        ℂ[lEulerProducts(principalCharacter(N),
        complexOfReal(R[1 + e]))(k) * f1] ∧
      lEulerProducts(χ, ℂ[s + complexOfReal(e)])(k + 1) =
        ℂ[lEulerProducts(χ, ℂ[s + complexOfReal(e)])(k) * f2] ∧
      lEulerProducts(characterSquare(χ),
        ℂ[s + s - 1 + complexOfReal(e)])(k + 1) =
        ℂ[lEulerProducts(characterSquare(χ),
        ℂ[s + s - 1 + complexOfReal(e)])(k) * f3] ∧
      R[1] ≤ R[complexNormSquared(f1) ^ 3 * complexNormSquared(f2) ^ 4 *
        complexNormSquared(f3)]
    intros k kMember
    have kNat := nat.omega.backward with kMember
    have next : k + 1 ∈ ℕ by typecheck
    have index : k + 1 = succ(k) by arith
    obtain ⟨factor1, prime1, other1⟩ := lEulerFactor.selected at
      principalCharacter(N), complexOfReal(R[1 + e]), k with values0, aMember
    obtain ⟨factor2, prime2, other2⟩ := lEulerFactor.selected at
      χ, ℂ[s + complexOfReal(e)], k with values1, bMember
    obtain ⟨factor3, prime3, other3⟩ := lEulerFactor.selected at
      characterSquare(χ), ℂ[s + s - 1 + complexOfReal(e)], k with values2,
      cMember
    refine ⟨lEulerFactor(principalCharacter(N), complexOfReal(R[1 + e]), k),
      factor1, lEulerFactor(χ, ℂ[s + complexOfReal(e)], k), factor2,
      lEulerFactor(characterSquare(χ), ℂ[s + s - 1 + complexOfReal(e)], k),
      factor3, ?_, ?_, ?_, ?_⟩
    . rw [(lEulerProducts.value with values0, aMember, next),
        (lEulerProducts.value with values0, aMember, kMember), index,
        lEulerProduct]
    . rw [(lEulerProducts.value with values1, bMember, next),
        (lEulerProducts.value with values1, bMember, kMember), index,
        lEulerProduct]
    . rw [(lEulerProducts.value with values2, cMember, next),
        (lEulerProducts.value with values2, cMember, kMember), index,
        lEulerProduct]
    . by_cases prime : Prime(k)
      . rw [(prime1 with prime), (prime2 with prime), (prime3 with prime)]
        have kInteger : integerOfNat(k) ∈ ℤ by typecheck
        have above := Prime.greater_than_one with prime
        have base := realNat.lt_of_lt with above
        rw realNat.one at base
        have basePositive : R[0] < realNat(k) by linarith
        have negA : ℂ[-complexOfReal(R[1 + e])] ∈ ℂ by typecheck
        have negB : ℂ[-(s + complexOfReal(e))] ∈ ℂ by typecheck
        have negC : ℂ[-(s + s - 1 + complexOfReal(e))] ∈ ℂ by typecheck
        have powerAMember := realCpow.member at realNat(k),
          ℂ[-complexOfReal(R[1 + e])] with negA
        have powerBMember := realCpow.member at realNat(k),
          ℂ[-(s + complexOfReal(e))] with negB
        have powerCMember := realCpow.member at realNat(k),
          ℂ[-(s + s - 1 + complexOfReal(e))] with negC
        have chiValue := FunctionBetween.apply_closed with values1, kInteger
        rw (characterSquare.value with values1, kInteger)
        by_cases coprime : IntegerCoprime(integerOfNat(k), integerOfNat(N))
        . rw (principalCharacter.coprime with kInteger, coprime)
          have shift : ℂ[-(s - 1)] ∈ ℂ by typecheck
          have negAShift : ℂ[-complexOfReal(R[1 + e]) + -(s - 1)] ∈ ℂ
            by typecheck
          have powerA : realCpow(realNat(k), ℂ[-complexOfReal(R[1 + e])]) =
              complexOfReal(realRpow(realNat(k), R[-(1 + e)]))
            rw [← complexOfReal.neg, realCpow.of_real]
          have exponentB : ℂ[-(s + complexOfReal(e))] =
              ℂ[-complexOfReal(R[1 + e]) + -(s - 1)]
            rw [complexOfReal.add, complexOfReal.one]
            ring
          have exponentC : ℂ[-(s + s - 1 + complexOfReal(e))] =
              ℂ[-complexOfReal(R[1 + e]) + -(s - 1) + -(s - 1)]
            rw [complexOfReal.add, complexOfReal.one]
            ring
          have wMember := realCpow.member at realNat(k), ℂ[-(s - 1)] with
            shift
          rw [exponentB, exponentC, (realCpow.add with negAShift, shift),
            (realCpow.add with negA, shift), powerA]
          have regroupA : ℂ[1 - complexOne * complexOfReal(realRpow(realNat(k),
              R[-(1 + e)]))] =
            ℂ[1 - complexOfReal(realRpow(realNat(k), R[-(1 + e)]))] by ring
          have regroupB : ℂ[1 - χ(integerOfNat(k)) *
              (complexOfReal(realRpow(realNat(k), R[-(1 + e)])) *
              realCpow(realNat(k), ℂ[-(s - 1)]))] =
            ℂ[1 - complexOfReal(realRpow(realNat(k), R[-(1 + e)])) *
              (χ(integerOfNat(k)) * realCpow(realNat(k), ℂ[-(s - 1)]))]
            by ring
          have regroupC : ℂ[1 - χ(integerOfNat(k)) * χ(integerOfNat(k)) *
              (complexOfReal(realRpow(realNat(k), R[-(1 + e)])) *
              realCpow(realNat(k), ℂ[-(s - 1)]) *
              realCpow(realNat(k), ℂ[-(s - 1)]))] =
            ℂ[1 - complexOfReal(realRpow(realNat(k), R[-(1 + e)])) *
              ((χ(integerOfNat(k)) * realCpow(realNat(k), ℂ[-(s - 1)])) *
              (χ(integerOfNat(k)) * realCpow(realNat(k), ℂ[-(s - 1)])))]
            by ring
          rw [regroupA, regroupB, regroupC]
          have xReal := realRpow.real at realNat(k), R[-(1 + e)]
          have xPositive := realRpow.positive at realNat(k), R[-(1 + e)]
          have xNonnegative : R[0] ≤ realRpow(realNat(k), R[-(1 + e)]) by
            linarith
          have exponent : R[-(1 + e)] < R[0] by linarith
          have smaller := realRpow.lt_of_exponent with base, exponent
          rw realRpow.zero at smaller
          have xMember : realRpow(realNat(k), R[-(1 + e)]) ∈ ℝ by typecheck
          have unitW : complexAbs(realCpow(realNat(k), ℂ[-(s - 1)])) = R[1]
            have sMinus : ℂ[s - 1] ∈ ℂ by typecheck
            rw [(realCpow.abs with basePositive, shift), (complexRe.neg with
              sMinus), (complexRe.sub with hs, one), onLine, reOne]
            have zero : R[-(1 - 1)] = R[0] by ring
            rw [zero, realRpow.zero]
          have normChi := DirichletCharacter.norm_coprime with character,
            positiveN, kInteger, coprime
          rw ← (complexAbs.square with chiValue) at normChi
          have chiAbs := complexAbs.nonnegative with chiValue
          have chiAbsReal := complexAbs.real with chiValue
          have unitChi : complexAbs(χ(integerOfNat(k))) = R[1]
            have sign := realLess.trichotomy at complexAbs(χ(integerOfNat(k))),
              R[1]
            rcases sign with less | same | more
            . exfalso
              have chiSquare := realLe.mul_left_of_nonnegative with
                (realLess.implies_le with less), chiAbs
              have unit : R[complexAbs(χ(integerOfNat(k))) * 1] =
                complexAbs(χ(integerOfNat(k))) by ring
              linarith
            . exact same
            . exfalso
              have chiSquare := realLe.mul_right_of_nonnegative with
                (realLess.implies_le with more), chiAbs
              have unit : R[1 * complexAbs(χ(integerOfNat(k)))] =
                complexAbs(χ(integerOfNat(k))) by ring
              linarith
          have wwMember : ℂ[χ(integerOfNat(k)) *
            realCpow(realNat(k), ℂ[-(s - 1)])] ∈ ℂ by typecheck
          have unitProduct : complexAbs(ℂ[χ(integerOfNat(k)) *
              realCpow(realNat(k), ℂ[-(s - 1)])]) = R[1]
            rw [(complexAbs.mul with chiValue, wMember), unitChi, unitW]
            ring
          exact eulerFactor.three_four_one with xMember, xNonnegative, smaller,
            wwMember, unitProduct
        . rw [(principalCharacter.not_coprime with kInteger, coprime),
            (DirichletCharacter.not_coprime with character, kInteger,
            coprime)]
          have trivial1 : ℂ[1 - complexZero * realCpow(realNat(k),
            ℂ[-complexOfReal(R[1 + e])])] = ℂ[1] by ring
          have trivial2 : ℂ[1 - complexZero * realCpow(realNat(k),
            ℂ[-(s + complexOfReal(e))])] = ℂ[1] by ring
          have trivial3 : ℂ[1 - complexZero * complexZero *
            realCpow(realNat(k), ℂ[-(s + s - 1 + complexOfReal(e))])] = ℂ[1]
            by ring
          have oneNonzero : ℂ[1] ≠ ℂ[0]
            intro vanish
            have size := complexAbs.one
            rw [vanish, complexAbs.zero] at size
            linarith
          have cancel := complexInv.mul_cancel with one, oneNonzero
          have inverseOne : complexInv(ℂ[1]) = ℂ[1]
            have inverse := complexInv.member with one
            linear_combination cancel
          rw [trivial1, trivial2, trivial3, inverseOne, complexNormSquared.one]
          have unit : R[1 ^ 3 * 1 ^ 4 * 1] = R[1] by ring
          rw unit
          exact realLe.reflexive at R[1]
      . rw [(other1 with prime), (other2 with prime), (other3 with prime),
          complexNormSquared.one]
        have unit : R[1 ^ 3 * 1 ^ 4 * 1] = R[1] by ring
        rw unit
        exact realLe.reflexive at R[1]
  exact eulerProducts.three_four_one_partial at
    lEulerProducts(principalCharacter(N), complexOfReal(R[1 + e])),
    lEulerProducts(χ, ℂ[s + complexOfReal(e)]),
    lEulerProducts(characterSquare(χ), ℂ[s + s - 1 + complexOfReal(e)]), n
    with start1, start2, start3, step, values

-- The 3–4–1 argument on an open set U where L(·, χ) and L(·, χ²) are
-- holomorphic: L(·, χ) cannot vanish at a point s of U on re s = 1 when
-- 2s − 1 and the points s + e, 2s − 1 + e (e > 0) lie in U.
theorem LFunction.three_four_one_zero (N : Nat) (χ s U : Set)
  requires positive : 1 ≤ N
  requires character : DirichletCharacter(N, χ)
  requires hs : s ∈ ℂ
  requires onLine : complexRe(s) = R[1]
  requires vanish : LFunction(N, χ, s) = ℂ[0]
  requires holomorphic : HolomorphicOn(LFunctionMap(N, χ), U)
  requires holomorphicSquare : HolomorphicOn(LFunctionMap(N,
    characterSquare(χ)), U)
  requires sU : s ∈ U
  requires c0U : ℂ[s + s - 1] ∈ U
  requires shifted : ∀ e ∈ ℝ, R[0] < e → ℂ[s + complexOfReal(e)] ∈ U ∧
    ℂ[s + s - 1 + complexOfReal(e)] ∈ U
  shows false
proof
  have one := complexOne.member
  have principal := principalCharacter.character at N
  have square := characterSquare.character with character
  have values0 := DirichletCharacter.function with principal
  have values1 := DirichletCharacter.function with character
  have values2 := DirichletCharacter.function with square
  have c0 : ℂ[s + s - 1] ∈ ℂ by typecheck
  -- L(·, χ) vanishes to first order at s, L(·, χ²) is bounded near
  -- 2s − 1, and L(·, χ₀) has a simple pole at 1
  obtain ⟨D1, d1Member, derivative1⟩ := HolomorphicOn.differentiable with
    holomorphic, sU
  obtain ⟨r1, r1Real, r1Positive, lipschitz1⟩ :=
    HasComplexDerivativeAt.lipschitz with derivative1
  obtain ⟨D2, d2Member, derivative2⟩ := HolomorphicOn.differentiable with
    holomorphicSquare, c0U
  obtain ⟨r2, r2Real, r2Positive, lipschitz2⟩ :=
    HasComplexDerivativeAt.lipschitz with derivative2
  have oneReal : R[1] ∈ ℝ by typecheck
  have onePositive : R[0] < R[1] by linarith
  have residue := LFunction.principal_residue with positive
  obtain ⟨r3, r3Real, r3Positive, pole⟩ := residue with R[1], oneReal,
    onePositive
  have phi := complexOfReal.mem at R[realNat(totient(N)) / realNat(N)]
  have phiAbs := complexAbs.nonnegative with phi
  have phiReal := complexAbs.real with phi
  have d1Abs := complexAbs.nonnegative with d1Member
  have d1Real := complexAbs.real with d1Member
  have d2Abs := complexAbs.nonnegative with d2Member
  have d2Real := complexAbs.real with d2Member
  have zetaC0 := LFunction.member with square, c0
  have c0Abs := complexAbs.nonnegative with zetaC0
  have c0Real := complexAbs.real with zetaC0
  have kNonnegative : R[0] ≤ R[1 + complexAbs(D1)] by linarith
  have mNonnegative : R[0] ≤ R[complexAbs(LFunction(N, characterSquare(χ), ℂ[s + s - 1])) + (1 +
    complexAbs(D2))] by linarith
  have k2 := realMulValue.nonnegative with kNonnegative, kNonnegative
  have k4 := realMulValue.nonnegative with k2, k2
  have m2 := realMulValue.nonnegative with mNonnegative, mNonnegative
  have twoReal : R[0] ≤ R[1 + complexAbs(complexOfReal(R[realNat(totient(N)) / realNat(N)]))] by
    linarith
  have twoSquare := realMulValue.nonnegative with twoReal, twoReal
  have twoFourth := realMulValue.nonnegative with twoSquare, twoSquare
  have sixtyFour := realMulValue.nonnegative with twoFourth, twoSquare
  have weight1 := realMulValue.nonnegative with sixtyFour, k4
  have weight2 := realMulValue.nonnegative with weight1, k4
  have weight := realMulValue.nonnegative with weight2, m2
  obtain ⟨g, gReal, gPositive, gSmall⟩ := real.small_multiple with weight,
    onePositive
  obtain ⟨q1, q1Real, q1Positive, q1r1, q1r2⟩ := positiveRadius.common with
    r1Positive, r2Positive
  obtain ⟨q2, q2Real, q2Positive, q2q1, q2r3⟩ := positiveRadius.common with
    q1Positive, r3Positive
  obtain ⟨q3, q3Real, q3Positive, q3q2, q3g⟩ := positiveRadius.common with
    q2Positive, gPositive
  obtain ⟨q4, q4Real, q4Positive, q4q3, q4One⟩ := positiveRadius.common with
    q3Positive, onePositive
  have twoNonnegative : R[0] ≤ R[2] by linarith
  obtain ⟨e, eReal, ePositive, eSmall⟩ := real.small_multiple with
    twoNonnegative, q4Positive
  have eTyped : Real(e) by typecheck
  have eBelow : e < q4 by linarith
  -- the three points
  have eMember := complexOfReal.mem at e
  have aMember := complexOfReal.mem at R[1 + e]
  have bMember : ℂ[s + complexOfReal(e)] ∈ ℂ by typecheck
  have cMember : ℂ[s + s - 1 + complexOfReal(e)] ∈ ℂ by typecheck
  obtain ⟨bU, cU⟩ := shifted with e, eReal, ePositive
  have main := LFunction.three_four_one with positive, character, hs, onLine,
    ePositive
  have zetaA := LFunction.member with principal, aMember
  have zetaB := LFunction.member with character, bMember
  have zetaC := LFunction.member with square, cMember
  rw [← (complexAbs.square with zetaA), ← (complexAbs.square with zetaB),
    ← (complexAbs.square with zetaC)] at main
  have eAbs : complexAbs(complexOfReal(e)) = e
    rw [complexAbs.of_real, (abs.of_nonnegative with
      (realLess.implies_le with ePositive))]
  -- the pole: e |L(1 + e, χ₀)| ≤ 1 + φ(N)/N
  have aShift : ℂ[complexOfReal(R[1 + e]) - 1] = complexOfReal(e)
    rw [complexOfReal.add, complexOfReal.one]
    ring
  have aNotOne : complexOfReal(R[1 + e]) ≠ ℂ[1]
    intro same
    have re := complexOfReal.re at R[1 + e]
    rw [same, ← complexOfReal.one, complexOfReal.re] at re
    linarith
  have aClose : complexAbs(ℂ[complexOfReal(R[1 + e]) - 1]) < r3
    rw [aShift, eAbs]
    linarith
  have poleBound := pole with complexOfReal(R[1 + e]), aMember, aNotOne, aClose
  rw aShift at poleBound
  have difference : ℂ[complexOfReal(e) * LFunction(N, principalCharacter(N), complexOfReal(R[1 + e])) -
    complexOfReal(R[realNat(totient(N)) / realNat(N)])] ∈ ℂ by typecheck
  have poleTriangle := complexAbs.triangle with difference, phi
  have poleShape : ℂ[complexOfReal(e) * LFunction(N, principalCharacter(N), complexOfReal(R[1 + e])) -
      complexOfReal(R[realNat(totient(N)) / realNat(N)]) + complexOfReal(R[realNat(totient(N)) / realNat(N)])] =
    ℂ[complexOfReal(e) * LFunction(N, principalCharacter(N), complexOfReal(R[1 + e]))] by ring
  rw [poleShape, (complexAbs.mul with eMember, zetaA), eAbs] at poleTriangle
  have aAbs := complexAbs.nonnegative with zetaA
  have aReal := complexAbs.real with zetaA
  have differenceReal := complexAbs.real with difference
  have commute : R[e * complexAbs(LFunction(N, principalCharacter(N), complexOfReal(R[1 + e])))] =
    R[complexAbs(LFunction(N, principalCharacter(N), complexOfReal(R[1 + e]))) * e] by ring
  have poleOrder : R[complexAbs(LFunction(N, principalCharacter(N), complexOfReal(R[1 + e]))) * e] ≤
    R[1 + complexAbs(complexOfReal(R[realNat(totient(N)) / realNat(N)]))] by linarith
  -- the zero: |L(s + e, χ)| ≤ (1 + |L'(s, χ)|) e
  have bShift : ℂ[ℂ[s + complexOfReal(e)] - s] = complexOfReal(e) by ring
  have bClose : complexAbs(ℂ[ℂ[s + complexOfReal(e)] - s]) < r1
    rw [bShift, eAbs]
    linarith
  have zeroBound := lipschitz1 with ℂ[s + complexOfReal(e)], bU, bClose
  rw [bShift, eAbs, (LFunctionMap.apply with values1, bMember),
    (LFunctionMap.apply with values1, hs), vanish] at zeroBound
  have bValue : ℂ[LFunction(N, χ, ℂ[s + complexOfReal(e)]) - 0] =
    LFunction(N, χ, ℂ[s + complexOfReal(e)]) by ring
  rw bValue at zeroBound
  -- the bounded factor: |L(2s − 1 + e, χ²)| ≤ |L(2s − 1, χ²)| + (1 + |L'|)
  have cShift : ℂ[ℂ[s + s - 1 + complexOfReal(e)] - ℂ[s + s - 1]] =
    complexOfReal(e) by ring
  have cClose : complexAbs(ℂ[ℂ[s + s - 1 + complexOfReal(e)] -
      ℂ[s + s - 1]]) < r2
    rw [cShift, eAbs]
    linarith
  have boundedChange := lipschitz2 with ℂ[s + s - 1 + complexOfReal(e)], cU,
    cClose
  rw [cShift, eAbs, (LFunctionMap.apply with values2, cMember),
    (LFunctionMap.apply with values2, c0)] at boundedChange
  have change : ℂ[LFunction(N, characterSquare(χ), ℂ[s + s - 1 + complexOfReal(e)]) -
    LFunction(N, characterSquare(χ), ℂ[s + s - 1])] ∈ ℂ by typecheck
  have cTriangle := complexAbs.triangle with change, zetaC0
  have cShape : ℂ[LFunction(N, characterSquare(χ), ℂ[s + s - 1 + complexOfReal(e)]) -
      LFunction(N, characterSquare(χ), ℂ[s + s - 1]) + LFunction(N, characterSquare(χ), ℂ[s + s - 1])] =
    LFunction(N, characterSquare(χ), ℂ[s + s - 1 + complexOfReal(e)]) by ring
  rw cShape at cTriangle
  have eAtMostOne : e ≤ R[1] by linarith
  have kd2 : R[0] ≤ R[1 + complexAbs(D2)] by linarith
  have kd2e := realLe.mul_left_of_nonnegative with eAtMostOne, kd2
  have unitK : R[(1 + complexAbs(D2)) * 1] = R[1 + complexAbs(D2)] by ring
  have changeReal := complexAbs.real with change
  have cAbs := complexAbs.nonnegative with zetaC
  have cReal := complexAbs.real with zetaC
  have boundedOrder : complexAbs(LFunction(N, characterSquare(χ),
      ℂ[s + s - 1 + complexOfReal(e)])) ≤ R[complexAbs(LFunction(N, characterSquare(χ), ℂ[s + s - 1])) +
      (1 + complexAbs(D2))] by linarith
  -- combine
  have bAbs := complexAbs.nonnegative with zetaB
  have orders := real.three_four_one_orders with aAbs, bAbs, cAbs, ePositive,
    poleOrder, zeroBound, boundedOrder, main
  have eg : e ≤ g by linarith
  exact real.three_four_one_small with weight, ePositive, eAtMostOne, eg,
    gSmall, orders

-- L(1, χ) ≠ 0 when χ² is not principal: the 3–4–1 argument at s = 1,
-- where L(·, χ) and L(·, χ²) are entire.
theorem LFunction.nonzero_one_of_square (N : Nat) (χ : Set)
  requires positive : 1 ≤ N
  requires character : DirichletCharacter(N, χ)
  requires nonPrincipal : χ ≠ principalCharacter(N)
  requires squareNonPrincipal : characterSquare(χ) ≠ principalCharacter(N)
  shows LFunction(N, χ, ℂ[1]) ≠ ℂ[0]
proof
  intro vanish
  have square := characterSquare.character with character
  have one := complexOne.member
  have onLine : complexRe(ℂ[1]) = R[1]
    rw [← complexOfReal.one, complexOfReal.re]
  have holomorphic := LFunction.holomorphic with positive, character,
    nonPrincipal
  have holomorphicSquare := LFunction.holomorphic with positive, square,
    squareNonPrincipal
  have c0 : ℂ[1 + 1 - 1] ∈ ℂ by typecheck
  have shifted : ∀ e ∈ ℝ, R[0] < e → ℂ[1 + complexOfReal(e)] ∈ ℂ ∧
      ℂ[1 + 1 - 1 + complexOfReal(e)] ∈ ℂ
    intros e eReal ePositive
    have eTyped : Real(e) by typecheck
    have eMember := complexOfReal.mem at e
    have bMember : ℂ[1 + complexOfReal(e)] ∈ ℂ by typecheck
    have cMember : ℂ[1 + 1 - 1 + complexOfReal(e)] ∈ ℂ by typecheck
    exact ⟨bMember, cMember⟩
  exact LFunction.three_four_one_zero with positive, character, one, onLine,
    vanish, holomorphic, holomorphicSquare, one, c0, shifted

-- Dirichlet's theorem: L(1, χ) ≠ 0 for χ non-principal.
theorem LFunction.nonzero_one (N : Nat) (χ : Set)
  requires positive : 1 ≤ N
  requires character : DirichletCharacter(N, χ)
  requires nonPrincipal : χ ≠ principalCharacter(N)
  shows LFunction(N, χ, ℂ[1]) ≠ ℂ[0]
proof
  by_cases real : characterSquare(χ) = principalCharacter(N)
  . -- χ real: positivity of the coefficients Σ_{d ∣ n} χ(d) of ζ(s) L(s, χ)
    -- (Landau), not yet formalized.
    sorry
  . exact LFunction.nonzero_one_of_square with positive, character,
      nonPrincipal, real

-- No zero on re s ≥ 1, the pole of the principal character excepted.
theorem LFunction.nonzero_re_ge_one (N : Nat) (χ s : Set)
  requires positive : 1 ≤ N
  requires character : DirichletCharacter(N, χ)
  requires hs : s ∈ ℂ
  requires halfPlane : realOne ≤ complexRe(s)
  requires notPole : χ ≠ principalCharacter(N) ∨ s ≠ ℂ[1]
  shows LFunction(N, χ, s) ≠ ℂ[0]
proof
  have reReal := complexRe.real with hs
  by_cases strict : realOne < complexRe(s)
  . exact LFunction.nonzero_re_gt_one with positive, character, hs, strict
  have onLine : complexRe(s) = R[1] by linarith
  by_cases atOne : s = ℂ[1]
  . cases notPole with nonPrincipal | notOne
    . rw atOne
      exact LFunction.nonzero_one with positive, character, nonPrincipal
    . exfalso
      exact notOne with atOne
  have notOne : s ≠ ℂ[1] := atOne
  intro vanish
  have one := complexOne.member
  have square := characterSquare.character with character
  have holomorphic := LFunction.holomorphic_off_one with positive, character
  have holomorphicSquare := LFunction.holomorphic_off_one with positive,
    square
  have sU : s ∈ complexCarrier ∖ {ℂ[1]}
    refine ⟨hs, ?_⟩
    intro single
    exact notOne with ((singleton.membership at s, ℂ[1]).forward with single)
  have c0 : ℂ[s + s - 1] ∈ ℂ by typecheck
  have c0U : ℂ[s + s - 1] ∈ complexCarrier ∖ {ℂ[1]}
    refine ⟨c0, ?_⟩
    intro single
    have same := (singleton.membership at ℂ[s + s - 1], ℂ[1]).forward with
      single
    have two : ℂ[2] ∈ ℂ by typecheck
    have twoNonzero : ℂ[2] ≠ ℂ[0]
      intro twoVanish
      have re := complexOfReal.re at R[2]
      rw [complexOfReal.two, twoVanish, ← complexOfReal.zero, complexOfReal.re]
        at re
      linarith
    have cancel := complexInv.mul_cancel with two, twoNonzero
    have half := complexInv.member with two
    apply notOne
    linear_combination complexInv(ℂ[2]) * same - (s - 1) * cancel
  have shifted : ∀ e ∈ ℝ, R[0] < e → ℂ[s + complexOfReal(e)] ∈
      complexCarrier ∖ {ℂ[1]} ∧ ℂ[s + s - 1 + complexOfReal(e)] ∈
      complexCarrier ∖ {ℂ[1]}
    intros e eReal ePositive
    have eTyped : Real(e) by typecheck
    have eMember := complexOfReal.mem at e
    have bMember : ℂ[s + complexOfReal(e)] ∈ ℂ by typecheck
    have cMember : ℂ[s + s - 1 + complexOfReal(e)] ∈ ℂ by typecheck
    constructor
    . refine ⟨bMember, ?_⟩
      intro single
      have same := (singleton.membership at ℂ[s + complexOfReal(e)],
        ℂ[1]).forward with single
      have re := complexRe.add with hs, eMember
      rw [same, ← complexOfReal.one, complexOfReal.re, onLine,
        complexOfReal.re] at re
      linarith
    . refine ⟨cMember, ?_⟩
      intro single
      have same := (singleton.membership at ℂ[s + s - 1 + complexOfReal(e)],
        ℂ[1]).forward with single
      have twoS : ℂ[s + s] ∈ ℂ by typecheck
      have re := complexRe.add with c0, eMember
      rw [same, (complexRe.sub with twoS, one), (complexRe.add with hs, hs),
        ← complexOfReal.one, complexOfReal.re, onLine, complexOfReal.re] at re
      linarith
  exact LFunction.three_four_one_zero with positive, character, hs, onLine,
    vanish, holomorphic, holomorphicSquare, sU, c0U, shifted


-- Section: Change of level
-- The divisors of N, the primes the change of level sifts out.
def naturalDivisors (N : Nat) : Set := { p ∈ ℕ | p ∣ N }

-- A divisor of N ≥ 1 is at least 1.
theorem divides.one_le (d N : Nat)
  requires positive : 1 ≤ N
  requires divides : d ∣ N
  shows 1 ≤ d
proof
  by_contra small
  have zero : d = (0:N) by arith
  rw zero at divides
  have nZero := zero.divides_only_zero with *
  arith

-- k + 1 ≥ 1 has no prime factor dividing N exactly when it is coprime
-- to N.
theorem SieveRough.coprime (N m : Nat)
  requires positive : 1 ≤ N
  shows SieveRough(naturalDivisors(N), N + 1, m) ↔
    IntegerCoprime(integerOfNat(m), integerOfNat(N))
proof
  have nonzeroN : N ≠ (0:N) by arith
  have ofNat := integerGCD.ofNat at m, N
  constructor
  . intro rough
    unfold IntegerCoprime
    rw ofNat
    have left := gcd.divides_left at m, N
    have right := gcd.divides_right at m, N
    by_contra notOne
    have gNonzero : gcd(m, N) ≠ (0:N)
      intro zero
      rw zero at right
      have nZero := zero.divides_only_zero with *
      exact nonzeroN with nZero
    have above : 1 < gcd(m, N) by arith
    obtain ⟨p, prime, divides⟩ := natural.exists_prime_divisor at gcd(m, N)
      with above
    have pNat := Prime.natural with prime
    have dividesM := divides.transitive with divides, left
    have dividesN := divides.transitive with divides, right
    have bound := divides.le with dividesN, nonzeroN
    have below : p < N + 1 by arith
    have pMember : p ∈ ℕ := nat.omega.forward at p with *
    have inP : p ∈ naturalDivisors(N) :=
      naturalDivisors.membership.backward with ⟨pMember, dividesN⟩
    exact rough with p, prime, inP, below, dividesM
  . intro coprime
    unfold IntegerCoprime at coprime
    rw ofNat at coprime
    unfold SieveRough
    intros p prime inP below dividesM
    obtain ⟨pMember, dividesN⟩ := naturalDivisors.membership.forward with inP
    have pNat := Prime.natural with prime
    obtain ⟨_, _, greatest⟩ := gcd.correct at m, N
    have dividesG := greatest with p, pNat, dividesM, dividesN
    rw coprime at dividesG
    have oneNonzero : (1:N) ≠ (0:N) by arith
    have bound := divides.le with dividesG, oneNonzero
    have above := Prime.greater_than_one with prime
    arith

theorem levelProduct.member (N : Nat) (ψ s : Set) (n : Nat)
  requires values : FunctionBetween(ψ, ℤ, complexCarrier)
  requires hs : s ∈ complexCarrier
  shows levelProduct(N, ψ, s, n) ∈ complexCarrier
proof
  induction n
  | zero =>
    rw levelProduct
    exact complexOne.member
  | succ(k) using ih =>
    obtain ⟨factor, _⟩ := levelFactor.selected at N, ψ, s, k with values, hs
    rw levelProduct
    typecheck

defgraph levelProductMap (N : Nat, ψ : Set, n : Nat) (s ∈ complexCarrier) :
    complexCarrier := levelProduct(N, ψ, s, n)
requires values : FunctionBetween(ψ, ℤ, complexCarrier)
proof
  exact levelProduct.member with values, member

-- Sifting the Dirichlet series of ψ by the primes below n dividing N
-- multiplies its sum by the partial product of the level factors.
theorem LFunction.level_stage (N d : Nat) (ψ s : Set) (n : Nat)
  requires dPositive : 1 ≤ d
  requires character : DirichletCharacter(d, ψ)
  requires hs : s ∈ ℂ
  requires halfPlane : realOne < complexRe(s)
  shows ComplexSumsTo(sieveTerms(dirichletSeriesTerms(ψ, s),
    naturalDivisors(N), n), ℂ[LFunction(d, ψ, s) * levelProduct(N, ψ, s, n)])
proof
  induction n
  | zero =>
    obtain ⟨sums, absolute⟩ := LFunction.series with dPositive, character,
      hs, halfPlane
    obtain ⟨sequence, _⟩ := absolute
    have values := DirichletCharacter.function with character
    have lMember := LFunction.closed at d, ψ, s with values, hs
    rw [(sieveTerms.start with sequence), levelProduct]
    have same : ℂ[LFunction(d, ψ, s) * complexOne] = LFunction(d, ψ, s)
      by ring
    rw same
    exact sums
  | succ(k) using ih =>
    obtain ⟨_, absolute⟩ := LFunction.series with dPositive, character, hs,
      halfPlane
    have absoluteCopy := absolute
    obtain ⟨sequence, _⟩ := absoluteCopy
    have values := DirichletCharacter.function with character
    have lMember := LFunction.closed at d, ψ, s with values, hs
    have kMember : k ∈ ℕ := nat.omega.forward at k with *
    have product := levelProduct.member at N, ψ, s, k with values, hs
    obtain ⟨_, yes, no⟩ := levelFactor.selected at N, ψ, s, k with values, hs
    have index : succ(k) = k + 1 by arith
    rw levelProduct
    rw index
    by_cases both : Prime(k) ∧ k ∈ naturalDivisors(N)
    . obtain ⟨prime, inP⟩ := both
      obtain ⟨_, dividesN⟩ := naturalDivisors.membership.forward with inP
      have factor := yes with ⟨prime, dividesN⟩
      have above := Prime.greater_than_one with prime
      have atLeast : 1 ≤ k by arith
      obtain ⟨r, rNat, split⟩ := LessEqual.exists_add with atLeast
      have shape : k = r + 1 by arith
      rw shape at prime
      rw shape at inP
      rw shape at ih
      rw shape at factor
      rw shape
      have rMember : r ∈ ℕ := nat.omega.forward at r with *
      have multiplicative := dirichletSeriesTerms.multiplicative with
        character, hs
      have step := sieveTerms.step at dirichletSeriesTerms(ψ, s),
        naturalDivisors(N), ℂ[LFunction(d, ψ, s) * levelProduct(N, ψ, s,
        r + 1)], r with absolute, prime, inP, (multiplicative with r,
        rMember), ih
      rw (dirichletSeriesTerms.value with values, hs, rMember) at step
      rw factor
      have rIndex : integerOfNat(r + 1) ∈ ℤ by typecheck
      have value := FunctionBetween.apply_closed with values, rIndex
      have negative : ℂ[-s] ∈ ℂ by typecheck
      have power := realCpow.member at realNat(r + 1), ℂ[-s] with negative
      have productR := levelProduct.member at N, ψ, s, r + 1 with values, hs
      have same : ℂ[LFunction(d, ψ, s) * (levelProduct(N, ψ, s, r + 1) *
          (1 - ψ(integerOfNat(r + 1)) * realCpow(realNat(r + 1), ℂ[-s])))] =
        ℂ[(1 - ψ(integerOfNat(r + 1)) * realCpow(realNat(r + 1), ℂ[-s])) *
          (LFunction(d, ψ, s) * levelProduct(N, ψ, s, r + 1))] by ring
      rw same
      exact step
    . have notBoth : ¬(Prime(k) ∧ k ∣ N)
        intro pair
        obtain ⟨prime, dividesN⟩ := pair
        apply both
        exact ⟨prime, (naturalDivisors.membership.backward with
          ⟨kMember, dividesN⟩)⟩
      rw [(no with notBoth), (sieveTerms.skip with sequence, both)]
      have same : ℂ[LFunction(d, ψ, s) * (levelProduct(N, ψ, s, k) * 1)] =
        ℂ[LFunction(d, ψ, s) * levelProduct(N, ψ, s, k)] by ring
      rw same
      exact ih

-- The change of level for re s > 1, by the sieve.
theorem LFunction.changeLevel_right (N d : Nat) (ψ s : Set)
  requires positive : 1 ≤ N
  requires divides : d ∣ N
  requires character : DirichletCharacter(d, ψ)
  requires hs : s ∈ ℂ
  requires halfPlane : realOne < complexRe(s)
  shows LFunction(N, changeLevel(N, ψ), s) =
    ℂ[LFunction(d, ψ, s) * levelProduct(N, ψ, s, succ(N))]
proof
  have dPositive := divides.one_le with positive, divides
  have values := DirichletCharacter.function with character
  have induced := changeLevel.character with divides, character
  have inducedValues := DirichletCharacter.function with induced
  have stage := LFunction.level_stage at N, d, ψ, s, N + 1 with dPositive,
    character, hs, halfPlane
  obtain ⟨inducedSums, _⟩ := LFunction.series at N, changeLevel(N, ψ), s with
    positive, induced, hs, halfPlane
  have terms := dirichletSeriesTerms.function at ψ, s with values, hs
  have sequence : ComplexSequence(dirichletSeriesTerms(ψ, s)) by exact terms
  have sieved := sieveTerms.function at dirichletSeriesTerms(ψ, s),
    naturalDivisors(N), N + 1 with sequence
  have inducedTerms := dirichletSeriesTerms.function at changeLevel(N, ψ), s
    with inducedValues, hs
  have same : sieveTerms(dirichletSeriesTerms(ψ, s), naturalDivisors(N),
      N + 1) = dirichletSeriesTerms(changeLevel(N, ψ), s)
    apply FunctionBetween.ext with sieved, inducedTerms
    intros k kMember
    have kNat := nat.omega.backward with kMember
    have index : integerOfNat(k + 1) ∈ ℤ by typecheck
    have value := FunctionBetween.apply_closed with values, index
    have negative : ℂ[-s] ∈ ℂ by typecheck
    have power := realCpow.member at realNat(k + 1), ℂ[-s] with negative
    have coprimeIff := SieveRough.coprime at N, k + 1 with positive
    rw (dirichletSeriesTerms.value at changeLevel(N, ψ), s, k with
      inducedValues, hs, kMember)
    by_cases rough : SieveRough(naturalDivisors(N), N + 1, k + 1)
    . have coprime := coprimeIff.forward with rough
      rw [(sieveTerms.rough with sequence, rough),
        (dirichletSeriesTerms.value at ψ, s, k with values, hs, kMember),
        (changeLevel.coprime with index, coprime, value)]
    . have notCoprime : ¬IntegerCoprime(integerOfNat(k + 1), integerOfNat(N))
        intro coprime
        exact rough with (coprimeIff.backward with coprime)
      rw [(sieveTerms.sifted with sequence, rough),
        (changeLevel.not_coprime with index, notCoprime)]
      ring
  rw same at stage
  have next : succ(N) = N + 1 by arith
  rw next
  exact ComplexSumsTo.unique with inducedSums, stage

-- s ↦ ∏_{p < n, p ∣ N} (1 − ψ(p) p^(−s)) is entire.
theorem levelProductMap.holomorphic (N : Nat) (ψ : Set) (n : Nat)
  requires values : FunctionBetween(ψ, ℤ, complexCarrier)
  shows HolomorphicOn(levelProductMap(N, ψ, n), complexCarrier)
proof
  induction n
  | zero =>
    have whole := ComplexOpen.whole
    have one := complexOne.member
    apply HolomorphicOn.const_formula with whole, one
    intros z hz
    rw [(levelProductMap.value at N, ψ, 0, z with values, hz), levelProduct]
  | succ(k) using ih =>
    have whole := ComplexOpen.whole
    have inside := ComplexOpen.subset with whole
    have one := complexOne.member
    have factorMap : ∃ g, HolomorphicOn(g, complexCarrier) ∧
        (∀ z ∈ complexCarrier, g(z) = levelFactor(N, ψ, z, k))
      by_cases both : Prime(k) ∧ k ∣ N
      . have index : integerOfNat(k) ∈ ℤ by typecheck
        have value := FunctionBetween.apply_closed with values, index
        have scale : ℂ[-ψ(integerOfNat(k))] ∈ ℂ by typecheck
        have zero : ℂ[0] ∈ ℂ by typecheck
        have minusOne : ℂ[-1] ∈ ℂ by typecheck
        have power := affinePower.holomorphic at realNat(k), ℂ[0], ℂ[-1],
          complexCarrier with zero, minusOne, whole, inside
        have scaleMap := HolomorphicOn.const with whole, scale
        have scaled := HolomorphicOn.mul with scaleMap, power
        have unit := HolomorphicOn.const with whole, one
        have sum := HolomorphicOn.add with unit, scaled
        have powerCopy := power
        have scaleCopy := scaleMap
        have scaledCopy := scaled
        have unitCopy := unit
        obtain ⟨_, valuesPower, _⟩ := powerCopy
        obtain ⟨_, valuesScale, _⟩ := scaleCopy
        obtain ⟨_, valuesScaled, _⟩ := scaledCopy
        obtain ⟨_, valuesUnit, _⟩ := unitCopy
        refine ⟨complexFunctionAdd(complexFunctionConst(ℂ[1], complexCarrier),
          complexFunctionMul(complexFunctionConst(ℂ[-ψ(integerOfNat(k))],
          complexCarrier), affinePower(realNat(k), ℂ[0], ℂ[-1]),
          complexCarrier), complexCarrier), sum, ?_⟩
        intros z hz
        obtain ⟨_, yes, _⟩ := levelFactor.selected at N, ψ, z, k with values,
          hz
        have exponent : ℂ[0 + -1 * z] = ℂ[-z] by ring
        have negative : ℂ[-z] ∈ ℂ by typecheck
        have powerValue := realCpow.member at realNat(k), ℂ[-z] with negative
        rw [(yes with both), (complexFunctionAdd.value with valuesUnit,
          valuesScaled, hz), (complexFunctionConst.value with one, hz),
          (complexFunctionMul.value with valuesScale, valuesPower, hz),
          (complexFunctionConst.value with scale, hz),
          (affinePower.value with zero, minusOne, hz), exponent]
        ring
      . have unit := HolomorphicOn.const with whole, one
        refine ⟨complexFunctionConst(ℂ[1], complexCarrier), unit, ?_⟩
        intros z hz
        obtain ⟨_, _, no⟩ := levelFactor.selected at N, ψ, z, k with values, hz
        rw [(no with both), (complexFunctionConst.value with one, hz)]
    obtain ⟨g, holomorphicG, valueG⟩ := factorMap
    apply HolomorphicOn.mul_formula with ih, holomorphicG
    intros z hz
    rw [(levelProductMap.value at N, ψ, succ(k), z with values, hz),
      (levelProductMap.value at N, ψ, k, z with values, hz), levelProduct,
      (valueG with z, hz)]

-- The change of level on a connected open set containing re s > 1 where
-- both L-functions are holomorphic, by the identity theorem.
theorem LFunction.changeLevel_on (N d : Nat) (ψ U s : Set)
  requires positive : 1 ≤ N
  requires divides : d ∣ N
  requires character : DirichletCharacter(d, ψ)
  requires holomorphicN : HolomorphicOn(LFunctionMap(N, changeLevel(N, ψ)), U)
  requires holomorphicD : HolomorphicOn(LFunctionMap(d, ψ), U)
  requires connected : ComplexConnected(U)
  requires halfPlane : rightHalfPlane(R[1]) ⊆ U
  requires hs : s ∈ U
  shows LFunction(N, changeLevel(N, ψ), s) =
    ℂ[LFunction(d, ψ, s) * levelProduct(N, ψ, s, succ(N))]
proof
  have values := DirichletCharacter.function with character
  have induced := changeLevel.character with divides, character
  have inducedValues := DirichletCharacter.function with induced
  have holomorphicCopy := holomorphicD
  obtain ⟨isOpen, valuesD, _⟩ := holomorphicCopy
  have inside := ComplexOpen.subset with isOpen
  have product := levelProductMap.holomorphic at N, ψ, succ(N) with values
  have productU := HolomorphicOn.mono with product, isOpen, inside
  have productCopy := productU
  obtain ⟨_, valuesProduct, _⟩ := productCopy
  have right := HolomorphicOn.mul with holomorphicD, productU
  have halfOpen := rightHalfPlane.open at R[1]
  have twoPoint : complexOfReal(R[2]) ∈ rightHalfPlane(R[1])
    apply rightHalfPlane.membership.backward
    refine ⟨(complexOfReal.mem at R[2]), ?_⟩
    rw complexOfReal.re
    linarith
  have nonempty : ∃ v, v ∈ rightHalfPlane(R[1]) :=
    ⟨complexOfReal(R[2]), twoPoint⟩
  have agree : ∀ z ∈ rightHalfPlane(R[1]),
      LFunctionMap(N, changeLevel(N, ψ))(z) = complexFunctionMul(
        LFunctionMap(d, ψ), levelProductMap(N, ψ, succ(N)), U)(z)
    intros z hz
    obtain ⟨zMember, zHalfPlane⟩ := rightHalfPlane.membership.forward with hz
    have zRight : realOne < complexRe(z) by exact zHalfPlane
    have zU := halfPlane with z, hz
    rw [(LFunctionMap.apply with inducedValues, zMember),
      (complexFunctionMul.value with valuesD, valuesProduct, zU),
      (LFunctionMap.apply with values, zMember),
      (levelProductMap.value with values, zMember)]
    exact LFunction.changeLevel_right with positive, divides, character,
      zMember, zRight
  have identity := holomorphic.identity with holomorphicN, right, connected,
    halfOpen, nonempty, halfPlane, agree
  have atS := identity with s, hs
  have sMember := inside with s, hs
  rw [(LFunctionMap.apply with inducedValues, sMember),
    (complexFunctionMul.value with valuesD, valuesProduct, hs),
    (LFunctionMap.apply with values, sMember),
    (levelProductMap.value with values, sMember)] at atS
  exact atS

-- The induced character is principal exactly when ψ is.
theorem changeLevel.principal_iff (N d : Nat) (ψ : Set)
  requires positive : 1 ≤ N
  requires divides : d ∣ N
  requires character : DirichletCharacter(d, ψ)
  shows changeLevel(N, ψ) = principalCharacter(N) ↔
    ψ = principalCharacter(d)
proof
  have induced := changeLevel.character with divides, character
  have valuesψ := DirichletCharacter.function with character
  have positiveN : 0 < N by arith
  have levelDivides := IntegerDivides.of_natural with divides
  have dInteger : integerOfNat(d) ∈ ℤ by typecheck
  have nInteger : integerOfNat(N) ∈ ℤ by typecheck
  constructor
  . intro principal
    apply (principalCharacter.eq_iff with character).backward
    intros a aInteger coprime
    obtain ⟨x, xInteger, congruent, xCoprime⟩ := IntegerCoprime.lift at d, N, a
      with aInteger, coprime, positiveN
    have same := DirichletCharacter.congruent with character, xInteger,
      aInteger, congruent
    have xValue := FunctionBetween.apply_closed with valuesψ, xInteger
    have lifted := changeLevel.coprime with xInteger, xCoprime, xValue
    rw [principal, (principalCharacter.coprime with xInteger, xCoprime)]
      at lifted
    rw [← same, ← lifted]
  . intro principal
    apply (principalCharacter.eq_iff with induced).backward
    intros a aInteger coprime
    have aValue := FunctionBetween.apply_closed with valuesψ, aInteger
    have coprimeD := IntegerCoprime.of_divides with aInteger, nInteger,
      dInteger, levelDivides, coprime
    rw [(changeLevel.coprime with aInteger, coprime, aValue), principal,
      (principalCharacter.coprime with aInteger, coprimeD)]

-- Change of level: for ψ modulo a divisor d of N, inducing ψ to N
-- multiplies L(s, ψ) by ∏_{p ∣ N} (1 − ψ(p) p^(−s)), away from the pole
-- (Mathlib's DirichletCharacter.LFunction_changeLevel). With ψ primitive
-- this relates every L-function to a primitive one.
theorem LFunction.changeLevel (N d : Nat) (ψ s : Set)
  requires positive : 1 ≤ N
  requires divides : d ∣ N
  requires character : DirichletCharacter(d, ψ)
  requires hs : s ∈ ℂ
  requires notPole : ψ ≠ principalCharacter(d) ∨ s ≠ ℂ[1]
  shows LFunction(N, changeLevel(N, ψ), s) =
    ℂ[LFunction(d, ψ, s) * levelProduct(N, ψ, s, succ(N))]
proof
  have dPositive := divides.one_le with positive, divides
  have induced := changeLevel.character with divides, character
  cases notPole with nonPrincipal | notOne
  . have inducedNonPrincipal : changeLevel(N, ψ) ≠ principalCharacter(N)
      intro principal
      apply nonPrincipal
      exact (changeLevel.principal_iff with positive, divides,
        character).forward with principal
    have holomorphicN := LFunction.holomorphic with positive, induced,
      inducedNonPrincipal
    have holomorphicD := LFunction.holomorphic with dPositive, character,
      nonPrincipal
    have connected := ComplexConnected.whole
    have halfPlane : rightHalfPlane(R[1]) ⊆ complexCarrier
      intros z hz
      obtain ⟨zMember, _⟩ := rightHalfPlane.membership.forward with hz
      exact zMember
    exact LFunction.changeLevel_on with positive, divides, character,
      holomorphicN, holomorphicD, connected, halfPlane, hs
  . have one := complexOne.member
    have holomorphicN := LFunction.holomorphic_off_one with positive, induced
    have holomorphicD := LFunction.holomorphic_off_one with dPositive,
      character
    have connected := complexPunctured.connected with one
    have halfPlane : rightHalfPlane(R[1]) ⊆ complexCarrier ∖ {ℂ[1]}
      intros z hz
      obtain ⟨zMember, zRight⟩ := rightHalfPlane.membership.forward with hz
      refine ⟨zMember, ?_⟩
      intro single
      have same := (singleton.membership at z, ℂ[1]).forward with single
      rw [same, ← complexOfReal.one, complexOfReal.re] at zRight
      linarith
    have sU : s ∈ complexCarrier ∖ {ℂ[1]}
      refine ⟨hs, ?_⟩
      intro single
      apply notOne
      exact (singleton.membership at s, ℂ[1]).forward with single
    exact LFunction.changeLevel_on with positive, divides, character,
      holomorphicN, holomorphicD, connected, halfPlane, sU

end LFunctions
