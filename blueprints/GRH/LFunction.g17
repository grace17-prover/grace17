-- Dirichlet L-functions. For N ≥ 1 and a Dirichlet character χ modulo N,
-- L(s, χ) = N^(−s) Σ_{j=1}^{N} χ(j) ζ(s, j/N) on all of ℂ, as Mathlib's
-- DirichletCharacter.LFunction (through ZMod.LFunction, the residue 0
-- represented by a = 1). For re s > 1 it is Σ_{n≥1} χ(n) n^(−s),
-- absolutely convergent, and the Euler product; it is holomorphic on ℂ for
-- χ non-principal and on ℂ ∖ {1} for χ principal; L(1, χ) is the value
-- of the continuous extension and is nonzero for χ non-principal; L(·, 1)
-- modulo 1 is ζ; and inducing from a divisor of N multiplies by the Euler
-- factors at the primes dividing N.
-- Part of the GRH blueprint.
-- Planned home: NumberTheory/Zeta/Dirichlet.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.LFunction
import GRH.Zeta
import GRH.DirichletCharacter

section LFunctions
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- Section: Definitions
-- The terms χ(j + 1) ζ(s, (j + 1)/N), j = 0, …, N − 1, of the Hurwitz
-- decomposition; the last, j + 1 = N, is χ(N) ζ(s, 1) = χ(0) ζ(s).
defgraph lFunctionTerms (N : Nat, χ s : Set) (j ∈ ℕ) : complexCarrier :=
  ℂ[χ(integerOfNat(j + 1)) * hurwitzZeta(s, R[realNat(j + 1) / realNat(N)])]
requires values : FunctionBetween(χ, ℤ, complexCarrier)
requires hs : s ∈ complexCarrier
proof
  sorry

-- L(s, χ) = N^(−s) Σ_{j=1}^{N} χ(j) ζ(s, j/N). At s = 1 each ζ(1, j/N) is
-- the constant term hurwitzZeta.regular(j/N), so
-- L(1, χ) = N^(−1) Σ_{j=1}^{N} χ(j) hurwitzZeta.regular(j/N); for χ
-- non-principal Σ_j χ(j) = 0, the poles cancel, and this is the value of
-- the continuous extension (`LFunction.at_one`). For χ principal, s = 1 is
-- a pole and the value there is not read by any theorem.
def LFunction (N : Nat, χ s : Set) : Set :=
  ℂ[realCpow(realNat(N), ℂ[-s]) *
    complexPartialSum(lFunctionTerms(N, χ, s), N)]

-- s ↦ L(s, χ) as a function on ℂ.
defgraph LFunctionMap (N : Nat, χ : Set) (s ∈ complexCarrier) :
    complexCarrier := LFunction(N, χ, s)
requires values : FunctionBetween(χ, ℤ, complexCarrier)
proof
  sorry

-- The terms χ(n) n^(−s), n = 1, 2, …, indexed from 0 as n + 1.
defgraph dirichletSeriesTerms (χ s : Set) (n ∈ ℕ) : complexCarrier :=
  ℂ[χ(integerOfNat(n + 1)) * realCpow(realNat(n + 1), ℂ[-s])]
requires values : FunctionBetween(χ, ℤ, complexCarrier)
requires hs : s ∈ complexCarrier
proof
  sorry

-- The Euler factor (1 − χ(p) p^(−s))⁻¹ at a prime p, 1 at the other
-- naturals, and the partial products over the primes p < n.
defunique lEulerFactor (χ s : Set, p : Nat) (w ∈ complexCarrier) :=
  (Prime(p) → w = complexInv(ℂ[1 - χ(integerOfNat(p)) *
    realCpow(realNat(p), ℂ[-s])])) ∧
  (¬Prime(p) → w = ℂ[1])
requires values : FunctionBetween(χ, ℤ, complexCarrier)
requires hs : s ∈ complexCarrier
proof
  sorry
uniqueness
  sorry

def lEulerProduct (χ s : Set) (n : Nat) → Set
  | χ, s, zero => complexOne
  | χ, s, succ(k) => complexMul(lEulerProduct(χ, s, k), lEulerFactor(χ, s, k))

defgraph lEulerProducts (χ s : Set) (n ∈ ℕ) : complexCarrier :=
    lEulerProduct(χ, s, n)
requires values : FunctionBetween(χ, ℤ, complexCarrier)
requires hs : s ∈ complexCarrier
proof
  sorry

-- The factor 1 − ψ(p) p^(−s) at a prime p dividing N, 1 at the other
-- naturals, and the product ∏_{p ∣ N} (1 − ψ(p) p^(−s)) over the primes
-- dividing N (all of them are at most N).
defunique levelFactor (N : Nat, ψ s : Set, p : Nat) (w ∈ complexCarrier) :=
  (Prime(p) ∧ p ∣ N → w = ℂ[1 - ψ(integerOfNat(p)) *
    realCpow(realNat(p), ℂ[-s])]) ∧
  (¬(Prime(p) ∧ p ∣ N) → w = ℂ[1])
requires values : FunctionBetween(ψ, ℤ, complexCarrier)
requires hs : s ∈ complexCarrier
proof
  sorry
uniqueness
  sorry

def levelProduct (N : Nat, ψ s : Set) (n : Nat) → Set
  | N, ψ, s, zero => complexOne
  | N, ψ, s, succ(k) => complexMul(levelProduct(N, ψ, s, k),
      levelFactor(N, ψ, s, k))

-- Section: Facts
theorem LFunctionMap.apply (N : Nat) (χ s : Set)
  requires values : FunctionBetween(χ, ℤ, complexCarrier)
  requires hs : s ∈ ℂ
  shows LFunctionMap(N, χ)(s) = LFunction(N, χ, s)
proof
  exact LFunctionMap.value at N, χ, s with values, hs

theorem LFunction.member (N : Nat) (χ s : Set)
  requires character : DirichletCharacter(N, χ)
  requires hs : s ∈ ℂ
  shows LFunction(N, χ, s) ∈ ℂ
proof
  sorry

-- For re s > 1, L(s, χ) = Σ_{n≥1} χ(n) n^(−s), absolutely convergent.
theorem LFunction.series (N : Nat) (χ s : Set)
  requires positive : 1 ≤ N
  requires character : DirichletCharacter(N, χ)
  requires hs : s ∈ ℂ
  requires halfPlane : realOne < complexRe(s)
  shows ComplexSumsTo(dirichletSeriesTerms(χ, s), LFunction(N, χ, s)) ∧
    ComplexAbsolutelySummable(dirichletSeriesTerms(χ, s))
proof
  sorry

-- L(·, χ) is holomorphic on ℂ ∖ {1} for every χ.
theorem LFunction.holomorphic_off_one (N : Nat) (χ : Set)
  requires positive : 1 ≤ N
  requires character : DirichletCharacter(N, χ)
  shows HolomorphicOn(LFunctionMap(N, χ), complexCarrier ∖ {ℂ[1]})
proof
  sorry

-- For χ non-principal the pole cancels: L(·, χ) is entire.
theorem LFunction.holomorphic (N : Nat) (χ : Set)
  requires positive : 1 ≤ N
  requires character : DirichletCharacter(N, χ)
  requires nonPrincipal : χ ≠ principalCharacter(N)
  shows HolomorphicOn(LFunctionMap(N, χ), complexCarrier)
proof
  sorry

-- For χ non-principal, L(s, χ) → L(1, χ) as s → 1.
theorem LFunction.at_one (N : Nat) (χ : Set)
  requires positive : 1 ≤ N
  requires character : DirichletCharacter(N, χ)
  requires nonPrincipal : χ ≠ principalCharacter(N)
  shows ∀ e ∈ ℝ, R[0] < e → ∃ d ∈ ℝ, R[0] < d ∧
    (∀ s ∈ ℂ, s ≠ ℂ[1] → complexAbs(ℂ[s - 1]) < d →
      complexAbs(ℂ[LFunction(N, χ, s) - LFunction(N, χ, ℂ[1])]) < e)
proof
  sorry

-- For χ principal the pole at 1 is simple with residue φ(N)/N.
theorem LFunction.principal_residue (N : Nat)
  requires positive : 1 ≤ N
  shows ∀ e ∈ ℝ, R[0] < e → ∃ d ∈ ℝ, R[0] < d ∧
    (∀ s ∈ ℂ, s ≠ ℂ[1] → complexAbs(ℂ[s - 1]) < d →
      complexAbs(ℂ[(s - 1) * LFunction(N, principalCharacter(N), s) -
        complexOfReal(R[realNat(totient(N)) / realNat(N)])]) < e)
proof
  sorry

-- Modulo 1 the only character is 1, and L(s, 1) = ζ(s) everywhere.
theorem LFunction.principal_one (χ s : Set)
  requires character : DirichletCharacter(1, χ)
  requires hs : s ∈ ℂ
  shows LFunction(1, χ, s) = riemannZeta(s)
proof
  sorry

-- The Euler product: for re s > 1, ∏_{p < n} (1 − χ(p) p^(−s))⁻¹ → L(s, χ).
theorem LFunction.euler_product (N : Nat) (χ s : Set)
  requires positive : 1 ≤ N
  requires character : DirichletCharacter(N, χ)
  requires hs : s ∈ ℂ
  requires halfPlane : realOne < complexRe(s)
  shows ComplexConvergesTo(lEulerProducts(χ, s), LFunction(N, χ, s))
proof
  sorry

theorem LFunction.nonzero_re_gt_one (N : Nat) (χ s : Set)
  requires positive : 1 ≤ N
  requires character : DirichletCharacter(N, χ)
  requires hs : s ∈ ℂ
  requires halfPlane : realOne < complexRe(s)
  shows LFunction(N, χ, s) ≠ ℂ[0]
proof
  sorry

-- Dirichlet's theorem: L(1, χ) ≠ 0 for χ non-principal.
theorem LFunction.nonzero_one (N : Nat) (χ : Set)
  requires positive : 1 ≤ N
  requires character : DirichletCharacter(N, χ)
  requires nonPrincipal : χ ≠ principalCharacter(N)
  shows LFunction(N, χ, ℂ[1]) ≠ ℂ[0]
proof
  sorry

-- No zero on re s ≥ 1, the pole of the principal character excepted.
theorem LFunction.nonzero_re_ge_one (N : Nat) (χ s : Set)
  requires positive : 1 ≤ N
  requires character : DirichletCharacter(N, χ)
  requires hs : s ∈ ℂ
  requires halfPlane : realOne ≤ complexRe(s)
  requires notPole : χ ≠ principalCharacter(N) ∨ s ≠ ℂ[1]
  shows LFunction(N, χ, s) ≠ ℂ[0]
proof
  sorry

-- Change of level: for ψ modulo a divisor d of N, inducing ψ to N
-- multiplies L(s, ψ) by ∏_{p ∣ N} (1 − ψ(p) p^(−s)), away from the pole
-- (Mathlib's DirichletCharacter.LFunction_changeLevel). With ψ primitive
-- this relates every L-function to a primitive one.
theorem LFunction.changeLevel (N d : Nat) (ψ s : Set)
  requires positive : 1 ≤ N
  requires divides : d ∣ N
  requires character : DirichletCharacter(d, ψ)
  requires hs : s ∈ ℂ
  requires notPole : ψ ≠ principalCharacter(d) ∨ s ≠ ℂ[1]
  shows LFunction(N, changeLevel(N, ψ), s) =
    ℂ[LFunction(d, ψ, s) * levelProduct(N, ψ, s, succ(N))]
proof
  sorry

-- The induced character is principal exactly when ψ is.
theorem changeLevel.principal_iff (N d : Nat) (ψ : Set)
  requires positive : 1 ≤ N
  requires divides : d ∣ N
  requires character : DirichletCharacter(d, ψ)
  shows changeLevel(N, ψ) = principalCharacter(N) ↔
    ψ = principalCharacter(d)
proof
  sorry

end LFunctions
