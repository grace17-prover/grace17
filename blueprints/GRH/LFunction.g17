-- Dirichlet L-functions. For N ≥ 1 and a Dirichlet character χ modulo N,
-- L(s, χ) = N^(−s) Σ_{j=1}^{N} χ(j) ζ(s, j/N) on all of ℂ, as Mathlib's
-- DirichletCharacter.LFunction (through ZMod.LFunction, the residue 0
-- represented by a = 1). For re s > 1 it is Σ_{n≥1} χ(n) n^(−s),
-- absolutely convergent, and the Euler product; it is holomorphic on ℂ for
-- χ non-principal and on ℂ ∖ {1} for χ principal; L(1, χ) is the value
-- of the continuous extension and is nonzero for χ non-principal; L(·, 1)
-- modulo 1 is ζ; and inducing from a divisor of N multiplies by the Euler
-- factors at the primes dividing N.
-- Part of the GRH blueprint.
-- Planned home: NumberTheory/Zeta/Dirichlet.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.LFunction
import GRH.Zeta
import GRH.DirichletCharacter

section LFunctions
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- Section: Definitions
-- The terms χ(j + 1) ζ(s, (j + 1)/N), j = 0, …, N − 1, of the Hurwitz
-- decomposition; the last, j + 1 = N, is χ(N) ζ(s, 1) = χ(0) ζ(s).
defgraph lFunctionTerms (N : Nat, χ s : Set) (j ∈ ℕ) : complexCarrier :=
  ℂ[χ(integerOfNat(j + 1)) * hurwitzZeta(s, R[realNat(j + 1) / realNat(N)])]
requires values : FunctionBetween(χ, ℤ, complexCarrier)
requires hs : s ∈ complexCarrier
proof
  have jNat := nat.omega.backward with member
  have index : integerOfNat(j + 1) ∈ ℤ by typecheck
  have value := FunctionBetween.apply_closed with values, index
  have point : Real(R[realNat(j + 1) / realNat(N)]) by typecheck
  have zeta := hurwitzZeta.member at s, R[realNat(j + 1) / realNat(N)] with hs
  typecheck

-- L(s, χ) = N^(−s) Σ_{j=1}^{N} χ(j) ζ(s, j/N). At s = 1 each ζ(1, j/N) is
-- the constant term hurwitzZeta.regular(j/N), so
-- L(1, χ) = N^(−1) Σ_{j=1}^{N} χ(j) hurwitzZeta.regular(j/N); for χ
-- non-principal Σ_j χ(j) = 0, the poles cancel, and this is the value of
-- the continuous extension (`LFunction.at_one`). For χ principal, s = 1 is
-- a pole and the value there is not read by any theorem.
def LFunction (N : Nat, χ s : Set) : Set :=
  ℂ[realCpow(realNat(N), ℂ[-s]) *
    complexPartialSum(lFunctionTerms(N, χ, s), N)]

-- L(s, χ) is a complex number.
theorem LFunction.closed (N : Nat) (χ s : Set)
  requires values : FunctionBetween(χ, ℤ, complexCarrier)
  requires hs : s ∈ complexCarrier
  shows LFunction(N, χ, s) ∈ complexCarrier
proof
  have terms := lFunctionTerms.function at N, χ, s with values, hs
  have sequence : ComplexSequence(lFunctionTerms(N, χ, s)) by exact terms
  have sum := complexPartialSum.member at lFunctionTerms(N, χ, s), N with
    sequence
  have negative : ℂ[-s] ∈ ℂ by typecheck
  have power := realCpow.member at realNat(N), ℂ[-s] with negative
  unfold LFunction
  typecheck

-- s ↦ L(s, χ) as a function on ℂ.
defgraph LFunctionMap (N : Nat, χ : Set) (s ∈ complexCarrier) :
    complexCarrier := LFunction(N, χ, s)
requires values : FunctionBetween(χ, ℤ, complexCarrier)
proof
  exact LFunction.closed with values, member

-- The terms χ(n) n^(−s), n = 1, 2, …, indexed from 0 as n + 1.
defgraph dirichletSeriesTerms (χ s : Set) (n ∈ ℕ) : complexCarrier :=
  ℂ[χ(integerOfNat(n + 1)) * realCpow(realNat(n + 1), ℂ[-s])]
requires values : FunctionBetween(χ, ℤ, complexCarrier)
requires hs : s ∈ complexCarrier
proof
  have nNat := nat.omega.backward with member
  have index : integerOfNat(n + 1) ∈ ℤ by typecheck
  have value := FunctionBetween.apply_closed with values, index
  have negative : ℂ[-s] ∈ ℂ by typecheck
  have power := realCpow.member at realNat(n + 1), ℂ[-s] with negative
  typecheck

-- The Euler factor (1 − χ(p) p^(−s))⁻¹ at a prime p, 1 at the other
-- naturals, and the partial products over the primes p < n.
defunique lEulerFactor (χ s : Set, p : Nat) (w ∈ complexCarrier) :=
  (Prime(p) → w = complexInv(ℂ[1 - χ(integerOfNat(p)) *
    realCpow(realNat(p), ℂ[-s])])) ∧
  (¬Prime(p) → w = ℂ[1])
requires values : FunctionBetween(χ, ℤ, complexCarrier)
requires hs : s ∈ complexCarrier
proof
  have index : integerOfNat(p) ∈ ℤ by typecheck
  have value := FunctionBetween.apply_closed with values, index
  have negative : ℂ[-s] ∈ ℂ by typecheck
  have power := realCpow.member at realNat(p), ℂ[-s] with negative
  have difference : ℂ[1 - χ(integerOfNat(p)) * realCpow(realNat(p), ℂ[-s])] ∈ ℂ
    by typecheck
  have inverse := complexInv.member with difference
  have one := complexOne.member
  by_cases prime : Prime(p)
  . witness complexInv(ℂ[1 - χ(integerOfNat(p)) * realCpow(realNat(p),
      ℂ[-s])])
    refine ⟨inverse, ?_, ?_⟩
    . intro isPrime
      rfl
    . intro notPrime
      exfalso
      exact notPrime with prime
  . witness ℂ[1]
    refine ⟨one, ?_, ?_⟩
    . intro isPrime
      exfalso
      exact prime with isPrime
    . intro notPrime
      rfl
uniqueness
  intros w wMember wValue v vMember vValue
  obtain ⟨wPrime, wOther⟩ := wValue
  obtain ⟨vPrime, vOther⟩ := vValue
  by_cases prime : Prime(p)
  . rw [(wPrime with prime), (vPrime with prime)]
  . rw [(wOther with prime), (vOther with prime)]

def lEulerProduct (χ s : Set) (n : Nat) → Set
  | χ, s, zero => complexOne
  | χ, s, succ(k) => complexMul(lEulerProduct(χ, s, k), lEulerFactor(χ, s, k))

theorem lEulerProduct.member (χ s : Set) (n : Nat)
  requires values : FunctionBetween(χ, ℤ, complexCarrier)
  requires hs : s ∈ complexCarrier
  shows lEulerProduct(χ, s, n) ∈ complexCarrier
proof
  induction n
  | zero =>
    rw lEulerProduct
    exact complexOne.member
  | succ(k) using ih =>
    obtain ⟨factor, _⟩ := lEulerFactor.selected at χ, s, k with values, hs
    rw lEulerProduct
    typecheck

defgraph lEulerProducts (χ s : Set) (n ∈ ℕ) : complexCarrier :=
    lEulerProduct(χ, s, n)
requires values : FunctionBetween(χ, ℤ, complexCarrier)
requires hs : s ∈ complexCarrier
proof
  have nNat := nat.omega.backward with member
  exact lEulerProduct.member with values, hs

-- The factor 1 − ψ(p) p^(−s) at a prime p dividing N, 1 at the other
-- naturals, and the product ∏_{p ∣ N} (1 − ψ(p) p^(−s)) over the primes
-- dividing N (all of them are at most N).
defunique levelFactor (N : Nat, ψ s : Set, p : Nat) (w ∈ complexCarrier) :=
  (Prime(p) ∧ p ∣ N → w = ℂ[1 - ψ(integerOfNat(p)) *
    realCpow(realNat(p), ℂ[-s])]) ∧
  (¬(Prime(p) ∧ p ∣ N) → w = ℂ[1])
requires values : FunctionBetween(ψ, ℤ, complexCarrier)
requires hs : s ∈ complexCarrier
proof
  have index : integerOfNat(p) ∈ ℤ by typecheck
  have value := FunctionBetween.apply_closed with values, index
  have negative : ℂ[-s] ∈ ℂ by typecheck
  have power := realCpow.member at realNat(p), ℂ[-s] with negative
  have difference : ℂ[1 - ψ(integerOfNat(p)) * realCpow(realNat(p), ℂ[-s])] ∈ ℂ
    by typecheck
  have one := complexOne.member
  by_cases dividing : Prime(p) ∧ p ∣ N
  . witness ℂ[1 - ψ(integerOfNat(p)) * realCpow(realNat(p), ℂ[-s])]
    refine ⟨difference, ?_, ?_⟩
    . intro yes
      rfl
    . intro no
      exfalso
      exact no with dividing
  . witness ℂ[1]
    refine ⟨one, ?_, ?_⟩
    . intro yes
      exfalso
      exact dividing with yes
    . intro no
      rfl
uniqueness
  intros w wMember wValue v vMember vValue
  obtain ⟨wYes, wNo⟩ := wValue
  obtain ⟨vYes, vNo⟩ := vValue
  by_cases dividing : Prime(p) ∧ p ∣ N
  . rw [(wYes with dividing), (vYes with dividing)]
  . rw [(wNo with dividing), (vNo with dividing)]

def levelProduct (N : Nat, ψ s : Set) (n : Nat) → Set
  | N, ψ, s, zero => complexOne
  | N, ψ, s, succ(k) => complexMul(levelProduct(N, ψ, s, k),
      levelFactor(N, ψ, s, k))

-- The values χ(j + 1), and the terms χ(j + 1) (ζ(s, (j + 1)/N) − 1/(s − 1))
-- of the regular part, with their partial sums as functions of s.
defgraph characterSuccValues (χ : Set) (j ∈ ℕ) : complexCarrier :=
    χ(integerOfNat(j + 1))
requires values : FunctionBetween(χ, ℤ, complexCarrier)
proof
  have jNat := nat.omega.backward with member
  have index : integerOfNat(j + 1) ∈ ℤ by typecheck
  exact FunctionBetween.apply_closed with values, index

defgraph lRegularTerms (N : Nat, χ s : Set) (j ∈ ℕ) : complexCarrier :=
  ℂ[χ(integerOfNat(j + 1)) *
    hurwitzZetaRegularMap(R[realNat(j + 1) / realNat(N)])(s)]
requires values : FunctionBetween(χ, ℤ, complexCarrier)
requires hs : s ∈ complexCarrier
proof
  have jNat := nat.omega.backward with member
  have index : integerOfNat(j + 1) ∈ ℤ by typecheck
  have value := FunctionBetween.apply_closed with values, index
  have point : Real(R[realNat(j + 1) / realNat(N)]) by typecheck
  have regular := FunctionBetween.apply_closed with
    (hurwitzZetaRegularMap.function at R[realNat(j + 1) / realNat(N)]), hs
  typecheck

defgraph lRegularSumMap (N : Nat, χ : Set, n : Nat) (s ∈ complexCarrier) :
    complexCarrier := complexPartialSum(lRegularTerms(N, χ, s), n)
requires values : FunctionBetween(χ, ℤ, complexCarrier)
proof
  have terms := lRegularTerms.function at N, χ, s with values, member
  have sequence : ComplexSequence(lRegularTerms(N, χ, s)) by exact terms
  exact complexPartialSum.member at lRegularTerms(N, χ, s), n with sequence

-- Section: Facts
-- Section: The Hurwitz decomposition
-- Σ_{j<n} χ(j + 1) ζ(s, (j + 1)/N) splits into the regular parts and
-- (Σ_{j<n} χ(j + 1)) / (s − 1), at every s (at s = 1, 1/0 = 0).
theorem lFunctionTerms.split (N : Nat) (χ s : Set) (n : Nat)
  requires values : FunctionBetween(χ, ℤ, complexCarrier)
  requires hs : s ∈ ℂ
  shows complexPartialSum(lFunctionTerms(N, χ, s), n) =
    ℂ[complexPartialSum(lRegularTerms(N, χ, s), n) +
      complexPartialSum(characterSuccValues(χ), n) * complexDiv(ℂ[1], ℂ[s - 1])]
proof
  have shifted : ℂ[s - 1] ∈ ℂ by typecheck
  have inverse := complexInv.member with shifted
  induction n
  | zero =>
    rw [complexPartialSum.zero, complexPartialSum.zero,
      complexPartialSum.zero]
    unfold complexDiv
    ring
  | succ(j) using ih =>
    have jMember : j ∈ ℕ := nat.omega.forward at j with *
    have index : integerOfNat(j + 1) ∈ ℤ by typecheck
    have value := FunctionBetween.apply_closed with values, index
    have point : Real(R[realNat(j + 1) / realNat(N)]) by typecheck
    have zeta := hurwitzZeta.member at s, R[realNat(j + 1) / realNat(N)] with hs
    have regularSequence := lRegularTerms.function at N, χ, s with values, hs
    have regularSum := complexPartialSum.member at lRegularTerms(N, χ, s), j
      with regularSequence
    have shiftSequence := characterSuccValues.function with values
    have shiftSum := complexPartialSum.member at characterSuccValues(χ), j with
      shiftSequence
    rw [complexPartialSum.succ, complexPartialSum.succ, complexPartialSum.succ,
      ih, (lFunctionTerms.value with values, hs, jMember),
      (lRegularTerms.value with values, hs, jMember),
      (characterSuccValues.value with values, jMember),
      (hurwitzZetaRegularMap.value with hs)]
    unfold complexDiv
    ring

-- The pair form of addition used by characterSum is ring addition.
theorem complexAdd.pair_eq (x y : Set)
  shows complexAdd((x, y)) = ℂ[x + y]
proof
  unfold call2
  rfl

-- Σ_{j<n} χ(j + 1) = Σ_{k<n+1} χ(k) − χ(0).
theorem characterSuccValues.partial (N : Nat) (χ : Set) (n : Nat)
  requires character : DirichletCharacter(N, χ)
  shows complexPartialSum(characterSuccValues(χ), n) =
    ℂ[characterSum(χ, succ(n)) - χ(integerOfNat(0))]
proof
  have values := DirichletCharacter.function with character
  have zeroIndex : integerOfNat(0) ∈ ℤ by typecheck
  have zeroValue := FunctionBetween.apply_closed with values, zeroIndex
  induction n
  | zero =>
    rw [complexPartialSum.zero, characterSum.succ, characterSum.zero,
      complexAdd.pair_eq]
    ring
  | succ(k) using ih =>
    have kMember : k ∈ ℕ := nat.omega.forward at k with *
    have closed := characterSum.closed at N, χ, succ(k) with character
    have closedK := characterSum.closed at N, χ, k with character
    have kIndex : integerOfNat(k) ∈ ℤ by typecheck
    have kValue := FunctionBetween.apply_closed with values, kIndex
    have index : integerOfNat(k + 1) ∈ ℤ by typecheck
    have value := FunctionBetween.apply_closed with values, index
    have one : k + 1 = succ(k) := add.right_one with *
    rw [complexPartialSum.succ, ih, (characterSum.succ at χ, succ(k)),
      (characterSuccValues.value with values, kMember), one, complexAdd.pair_eq]
    ring

-- Σ_{j<N} χ(j + 1) = Σ_{k<N} χ(k).
theorem characterSuccValues.sum (N : Nat) (χ : Set)
  requires character : DirichletCharacter(N, χ)
  shows complexPartialSum(characterSuccValues(χ), N) = characterSum(χ, N)
proof
  have values := DirichletCharacter.function with character
  have zeroIndex : integerOfNat(0) ∈ ℤ by typecheck
  have zeroValue := FunctionBetween.apply_closed with values, zeroIndex
  have nMember : N ∈ ℕ := nat.omega.forward at N with *
  have periodic := DirichletCharacter.periodic with character, zeroIndex
  have zeroSum := integerOfNat.add at 0, N
  have same : 0 + N = N by arith
  rw same at zeroSum
  rw ← zeroSum at periodic
  have closed := characterSum.closed at N, χ, N with character
  rw [(characterSuccValues.partial at N, χ, N with character), characterSum.succ,
    periodic, complexAdd.pair_eq]
  ring

theorem LFunctionMap.apply (N : Nat) (χ s : Set)
  requires values : FunctionBetween(χ, ℤ, complexCarrier)
  requires hs : s ∈ ℂ
  shows LFunctionMap(N, χ)(s) = LFunction(N, χ, s)
proof
  exact LFunctionMap.value at N, χ, s with values, hs

theorem LFunction.member (N : Nat) (χ s : Set)
  requires character : DirichletCharacter(N, χ)
  requires hs : s ∈ ℂ
  shows LFunction(N, χ, s) ∈ ℂ
proof
  have values := DirichletCharacter.function with character
  exact LFunction.closed with values, hs

-- A quotient of positive reals is positive.
theorem real.div_positive (A B : Real)
  requires positiveA : R[0] < A
  requires positiveB : R[0] < B
  shows R[0] < R[A / B]
proof
  have nonzero : B ≠ R[0] by linarith
  have cancel := realDiv.mul_right at A, B with nonzero
  have quotientReal : Real(R[A / B]) by typecheck
  by_contra notPositive
  have nonpositive : R[A / B] ≤ R[0] by linarith
  have scaled := realLe.mul_right_of_nonnegative with nonpositive,
    (realLess.implies_le with positiveB)
  have zero : R[0 * B] = R[0] by ring
  linarith

-- The regular part Σ_{j<n} χ(j + 1)(ζ(s, (j + 1)/N) − 1/(s − 1)) is entire.
theorem lRegularSumMap.holomorphic (N : Nat) (χ : Set) (n : Nat) (U : Set)
  requires positive : 1 ≤ N
  requires values : FunctionBetween(χ, ℤ, complexCarrier)
  requires isOpen : ComplexOpen(U)
  shows HolomorphicOn(lRegularSumMap(N, χ, n), U)
proof
  have inside := ComplexOpen.subset with isOpen
  have whole := ComplexOpen.whole
  induction n
  | zero =>
    have zero : ℂ[0] ∈ ℂ by typecheck
    apply HolomorphicOn.const_formula with isOpen, zero
    intros z hz
    rw [(lRegularSumMap.value with values, (inside with z, hz)),
      complexPartialSum.zero]
  | succ(j) using ih =>
    have jMember : j ∈ ℕ := nat.omega.forward at j with *
    have index : integerOfNat(j + 1) ∈ ℤ by typecheck
    have value := FunctionBetween.apply_closed with values, index
    have numerator : R[0] < realNat(j + 1)
      have nonzero : j + 1 ≠ (0:N) by arith
      exact realNat.positive with nonzero
    have denominator : R[0] < realNat(N)
      have nonzero : N ≠ (0:N) by arith
      exact realNat.positive with nonzero
    have point := real.div_positive with numerator, denominator
    have regular := hurwitzZetaRegularMap.holomorphic at
      R[realNat(j + 1) / realNat(N)] with point
    have regularU := HolomorphicOn.mono with regular, isOpen, inside
    have constant := HolomorphicOn.const with isOpen, value
    have term := HolomorphicOn.mul with constant, regularU
    have constantCopy := constant
    have regularCopy := regularU
    obtain ⟨_, valuesConstant, _⟩ := constantCopy
    obtain ⟨_, valuesRegular, _⟩ := regularCopy
    apply HolomorphicOn.add_formula with ih, term
    intros z hz
    have zMember := inside with z, hz
    rw [(lRegularSumMap.value with values, zMember), complexPartialSum.succ,
      (lRegularTerms.value with values, zMember, jMember),
      (complexFunctionMul.value with valuesConstant, valuesRegular, hz),
      (complexFunctionConst.value with value, hz)]

-- L(s, χ) = N^(−s) (Σ_{j<N} χ(j + 1) R_{(j+1)/N}(s) + Σ_{k<N} χ(k)/(s − 1)).
theorem LFunction.decomposition (N : Nat) (χ s : Set)
  requires character : DirichletCharacter(N, χ)
  requires hs : s ∈ ℂ
  shows LFunction(N, χ, s) = ℂ[realCpow(realNat(N), ℂ[-s]) *
    (lRegularSumMap(N, χ, N)(s) + characterSum(χ, N) *
      complexDiv(ℂ[1], ℂ[s - 1]))]
proof
  have values := DirichletCharacter.function with character
  unfold LFunction
  rw [(lFunctionTerms.split with values, hs), (characterSuccValues.sum with
    character), (lRegularSumMap.value with values, hs)]

-- Section: The Dirichlet series
-- The column sums Σ_{j<J} χ(j + 1) N^(−s) ((j + 1)/N + m)^(−s), m = 0, 1, …
defgraph lColumnStep (N : Nat, χ s : Set, m : Nat) (j ∈ ℕ) : complexCarrier :=
  ℂ[χ(integerOfNat(j + 1)) * realCpow(realNat(N), ℂ[-s]) *
    hurwitzSeriesTerms(s, R[realNat(j + 1) / realNat(N)])(m)]
requires values : FunctionBetween(χ, ℤ, complexCarrier)
requires hs : s ∈ complexCarrier
proof
  have jNat := nat.omega.backward with member
  have index : integerOfNat(j + 1) ∈ ℤ by typecheck
  have value := FunctionBetween.apply_closed with values, index
  have negative : ℂ[-s] ∈ ℂ by typecheck
  have power := realCpow.member at realNat(N), ℂ[-s] with negative
  have mMember : m ∈ ℕ := nat.omega.forward at m with *
  have term := FunctionBetween.apply_closed with
    (hurwitzSeriesTerms.function at s, R[realNat(j + 1) / realNat(N)] with hs),
    mMember
  typecheck

defgraph lColumnPartial (N : Nat, χ s : Set, J : Nat) (m ∈ ℕ) :
    complexCarrier := complexPartialSum(lColumnStep(N, χ, s, m), J)
requires values : FunctionBetween(χ, ℤ, complexCarrier)
requires hs : s ∈ complexCarrier
proof
  have mNat := nat.omega.backward with member
  have steps := lColumnStep.function at N, χ, s, m with values, hs
  have sequence : ComplexSequence(lColumnStep(N, χ, s, m)) by exact steps
  exact complexPartialSum.member at lColumnStep(N, χ, s, m), J with sequence

-- Each column is a scaled Hurwitz series, so the column sums converge.
theorem lColumnPartial.sums (N : Nat) (χ s : Set) (J : Nat)
  requires positive : 1 ≤ N
  requires values : FunctionBetween(χ, ℤ, complexCarrier)
  requires hs : s ∈ ℂ
  requires halfPlane : realOne < complexRe(s)
  shows ComplexSumsTo(lColumnPartial(N, χ, s, J),
    ℂ[realCpow(realNat(N), ℂ[-s]) * complexPartialSum(lFunctionTerms(N, χ, s),
      J)])
proof
  have negative : ℂ[-s] ∈ ℂ by typecheck
  have power := realCpow.member at realNat(N), ℂ[-s] with negative
  induction J
  | zero =>
    have columns := lColumnPartial.function at N, χ, s, 0 with values, hs
    have sequence : ComplexSequence(lColumnPartial(N, χ, s, 0))
      by exact columns
    have vanishing : ∀ n ∈ ℕ, (0:N) < n → lColumnPartial(N, χ, s, 0)(n) = ℂ[0]
      intros n nMember positiveN
      have nNat := nat.omega.backward with nMember
      rw [(lColumnPartial.value at N, χ, s, 0, n with values, hs),
        complexPartialSum.zero]
    have sums := ComplexSumsTo.first_only with sequence, vanishing
    have zeroMember : (0:N) ∈ ℕ := nat.omega.forward at (0:N) with *
    rw [(lColumnPartial.value at N, χ, s, 0, (0:N) with values, hs),
      complexPartialSum.zero] at sums
    rw complexPartialSum.zero
    have zero : ℂ[realCpow(realNat(N), ℂ[-s]) * 0] = ℂ[0] by ring
    rwa zero
  | succ(j) using ih =>
    have jMember : j ∈ ℕ := nat.omega.forward at j with *
    have index : integerOfNat(j + 1) ∈ ℤ by typecheck
    have value := FunctionBetween.apply_closed with values, index
    have numerator : R[0] < realNat(j + 1)
      have nonzero : j + 1 ≠ (0:N) by arith
      exact realNat.positive with nonzero
    have denominator : R[0] < realNat(N)
      have nonzero : N ≠ (0:N) by arith
      exact realNat.positive with nonzero
    have point := real.div_positive with numerator, denominator
    obtain ⟨hurwitz, _⟩ := hurwitzZeta.series at s, R[realNat(j + 1) /
      realNat(N)] with point, hs, halfPlane
    have zeroSeries := complexZeroSeries.sums
    have scale : ℂ[-(χ(integerOfNat(j + 1)) *
      realCpow(realNat(N), ℂ[-s]))] ∈ ℂ by typecheck
    have columns := lColumnPartial.function at N, χ, s, succ(j) with values,
      hs
    have sequence : ComplexSequence(lColumnPartial(N, χ, s, succ(j)))
      by exact columns
    have terms : ∀ m ∈ ℕ, lColumnPartial(N, χ, s, succ(j))(m) =
        ℂ[lColumnPartial(N, χ, s, j)(m) - complexFunctionConst(ℂ[0], ℕ)(m) -
          -(χ(integerOfNat(j + 1)) * realCpow(realNat(N), ℂ[-s])) *
          hurwitzSeriesTerms(s, R[realNat(j + 1) / realNat(N)])(m)]
      intros m mMember
      have mNat := nat.omega.backward with mMember
      have zero : ℂ[0] ∈ ℂ by typecheck
      have steps := lColumnStep.function at N, χ, s, m with values, hs
      have stepSequence : ComplexSequence(lColumnStep(N, χ, s, m))
        by exact steps
      have previous := complexPartialSum.member at lColumnStep(N, χ, s, m), j
        with stepSequence
      have term := FunctionBetween.apply_closed with
        (hurwitzSeriesTerms.function at s, R[realNat(j + 1) / realNat(N)] with
          hs), mMember
      rw [(lColumnPartial.value at N, χ, s, succ(j), m with values, hs),
        (lColumnPartial.value at N, χ, s, j, m with values, hs),
        complexPartialSum.succ, (lColumnStep.value at N, χ, s, m, j with values,
        hs),
        (complexFunctionConst.value with zero, mMember)]
      ring
    have combined := ComplexSumsTo.combination with ih, zeroSeries, hurwitz,
      scale, sequence, terms
    have zeta := hurwitzZeta.member at s, R[realNat(j + 1) / realNat(N)] with hs
    have lTerms := lFunctionTerms.function at N, χ, s with values, hs
    have lSequence : ComplexSequence(lFunctionTerms(N, χ, s)) by exact lTerms
    have previousSum := complexPartialSum.member at lFunctionTerms(N, χ, s), j
      with lSequence
    rw [complexPartialSum.succ, (lFunctionTerms.value with values, hs,
      jMember)]
    have shape : ℂ[realCpow(realNat(N), ℂ[-s]) *
        complexPartialSum(lFunctionTerms(N, χ, s), j) - 0 -
        -(χ(integerOfNat(j + 1)) * realCpow(realNat(N), ℂ[-s])) *
        hurwitzZeta(s, R[realNat(j + 1) / realNat(N)])] =
      ℂ[realCpow(realNat(N), ℂ[-s]) *
        (complexPartialSum(lFunctionTerms(N, χ, s), j) +
        χ(integerOfNat(j + 1)) * hurwitzZeta(s, R[realNat(j + 1) /
          realNat(N)]))] by ring
    rwa shape at combined

-- The block of N terms of the Dirichlet series starting at M N is the
-- column sum at M.
theorem dirichletSeriesTerms.block (N : Nat) (χ s : Set) (M : Nat)
  requires positive : 1 ≤ N
  requires character : DirichletCharacter(N, χ)
  requires hs : s ∈ ℂ
  shows complexBlock(dirichletSeriesTerms(χ, s), M * N) =
    lColumnStep(N, χ, s, M)
proof
  have values := DirichletCharacter.function with character
  have terms := dirichletSeriesTerms.function at χ, s with values, hs
  have sequence : ComplexSequence(dirichletSeriesTerms(χ, s)) by exact terms
  have block := complexBlock.function at dirichletSeriesTerms(χ, s), M * N
    with sequence
  have steps := lColumnStep.function at N, χ, s, M with values, hs
  apply FunctionBetween.ext with block, steps
  intros j jMember
  have jNat := nat.omega.backward with jMember
  have negative : ℂ[-s] ∈ ℂ by typecheck
  rw [(complexBlock.value with sequence, jMember),
    (dirichletSeriesTerms.value at χ, s, M * N + j with values, hs),
    (lColumnStep.value at N, χ, s, M, j with values, hs),
    (hurwitzSeriesTerms.value at s, R[realNat(j + 1) / realNat(N)], M with hs)]
  -- The character is periodic.
  have shift := DirichletCharacter.shift_natural at N, χ, M with character
  have index : integerOfNat(j + 1) ∈ ℤ by typecheck
  have periodic := shift with integerOfNat(j + 1), index
  have natural : M * N + j + 1 = j + 1 + N * M by arith
  rw [← integerOfNat.mul, ← integerOfNat.add, ← natural] at periodic
  rw periodic
  -- The powers multiply.
  have nPositive : R[0] < realNat(N)
    have nonzero : N ≠ (0:N) by arith
    exact realNat.positive with nonzero
  have nNonzero : realNat(N) ≠ R[0] by linarith
  have numerator : R[0] < realNat(j + 1)
    have nonzero : j + 1 ≠ (0:N) by arith
    exact realNat.positive with nonzero
  have quotient := real.div_positive with numerator, nPositive
  have mNonnegative := realNat.nonnegative at M
  have pointPositive : R[0] < R[realNat(M) + realNat(j + 1) / realNat(N)]
    by linarith
  have product := realCpow.mul_base with nPositive, pointPositive, negative
  have cancel := realDiv.mul_right at realNat(j + 1), realNat(N) with nNonzero
  have point : R[realNat(N) * (realNat(M) + realNat(j + 1) / realNat(N))] =
      realNat(M * N + j + 1)
    have target : realNat(M * N + j + 1) = R[realNat(M) * realNat(N) +
        realNat(j) + 1]
      rw [realNat.add, realNat.add, realNat.mul, realNat.one]
    have oneReal : realNat(j + 1) = R[realNat(j) + 1]
      rw [realNat.add, realNat.one]
    rw [target, oneReal]
    rw oneReal at cancel
    linear_combination cancel
  rw point at product
  rw product
  have value := FunctionBetween.apply_closed with values, index
  have first := realCpow.member at realNat(N), ℂ[-s] with negative
  have second := realCpow.member at R[realNat(M) + realNat(j + 1) /
    realNat(N)], ℂ[-s] with negative
  ring

-- Σ_{k<MN} χ(k + 1)(k + 1)^(−s) is the M-th partial sum of the columns.
theorem dirichletSeriesTerms.blocks (N : Nat) (χ s : Set) (M : Nat)
  requires positive : 1 ≤ N
  requires character : DirichletCharacter(N, χ)
  requires hs : s ∈ ℂ
  shows complexPartialSum(dirichletSeriesTerms(χ, s), M * N) =
    complexPartialSum(lColumnPartial(N, χ, s, N), M)
proof
  have values := DirichletCharacter.function with character
  have terms := dirichletSeriesTerms.function at χ, s with values, hs
  have sequence : ComplexSequence(dirichletSeriesTerms(χ, s)) by exact terms
  induction M
  | zero =>
    have zero : (0:N) * N = (0:N) by arith
    rw [zero, complexPartialSum.zero, complexPartialSum.zero]
  | succ(k) using ih =>
    have succNat : Nat(succ(k)) by typecheck
    have kMember : k ∈ ℕ := nat.omega.forward at k with *
    have index : succ(k) * N = k * N + N by arith
    rw [index, (complexPartialSum.block with sequence), ih,
      (dirichletSeriesTerms.block with positive, character, hs),
      complexPartialSum.succ, (lColumnPartial.value at N, χ, s, N, k with
      values, hs)]

-- For re s > 1, L(s, χ) = Σ_{n≥1} χ(n) n^(−s), absolutely convergent.
theorem LFunction.series (N : Nat) (χ s : Set)
  requires positive : 1 ≤ N
  requires character : DirichletCharacter(N, χ)
  requires hs : s ∈ ℂ
  requires halfPlane : realOne < complexRe(s)
  shows ComplexSumsTo(dirichletSeriesTerms(χ, s), LFunction(N, χ, s)) ∧
    ComplexAbsolutelySummable(dirichletSeriesTerms(χ, s))
proof
  have values := DirichletCharacter.function with character
  have positiveN : 0 < N by arith
  have terms := dirichletSeriesTerms.function at χ, s with values, hs
  have sequence : ComplexSequence(dirichletSeriesTerms(χ, s)) by exact terms
  -- Absolute convergence, against Σ n^(−σ).
  obtain ⟨_, absoluteZeta⟩ := zeta.series with hs, halfPlane
  obtain ⟨zetaSequence, zetaSummable⟩ := absoluteZeta
  have negative : ℂ[-s] ∈ ℂ by typecheck
  have bound : ∀ k ∈ ℕ, complexAbs(dirichletSeriesTerms(χ, s)(k)) ≤
      complexAbsSequence(zetaSeriesTerms(s))(k)
    intros k kMember
    have kNat := nat.omega.backward with kMember
    have index : integerOfNat(k + 1) ∈ ℤ by typecheck
    have value := FunctionBetween.apply_closed with values, index
    have power := realCpow.member at realNat(k + 1), ℂ[-s] with negative
    rw [(dirichletSeriesTerms.value at χ, s, k with values, hs),
      (complexAbsSequence.value with zetaSequence),
      (zetaSeriesTerms.value with hs, kMember), (complexAbs.mul with value,
      power)]
    have normBound := DirichletCharacter.norm_le_one with character,
      positiveN, index
    rw ← (complexAbs.square with value) at normBound
    have valueAbs := complexAbs.nonnegative with value
    have valueAbsReal := complexAbs.real with value
    have oneNonnegative : R[0] ≤ R[1] by linarith
    have unitSquare : R[1 * 1] = R[1] by ring
    have squares : R[complexAbs(χ(integerOfNat(k + 1))) *
      complexAbs(χ(integerOfNat(k + 1)))] ≤ R[1 * 1] by linarith
    have atMostOne := realMulValue.le_of_square_le with valueAbs,
      oneNonnegative, squares
    have powerAbs := complexAbs.nonnegative with power
    have scaled := realLe.mul_right_of_nonnegative with atMostOne, powerAbs
    have unit : R[1 * complexAbs(realCpow(realNat(k + 1), ℂ[-s]))] =
      complexAbs(realCpow(realNat(k + 1), ℂ[-s])) by ring
    linarith
  have absolute := ComplexAbsolutelySummable.of_bound with sequence,
    zetaSummable, bound
  refine ⟨?_, absolute⟩
  have summable := ComplexAbsolutelySummable.summable with absolute
  obtain ⟨S, sMember, sums⟩ := summable
  -- The column sums converge to L(s, χ), and they are partial sums of the
  -- series at the multiples of N.
  have columns := lColumnPartial.sums at N, χ, s, N with positive, values, hs,
    halfPlane
  have lMember := LFunction.closed with values, hs
  have sameLimit : S = LFunction(N, χ, s)
    apply complex.eq_of_common_near with sMember, lMember
    intros e eMember ePositive
    have sumsCopy := sums
    obtain ⟨_, convergesS⟩ := sumsCopy
    have prefixes := complexPrefixSums.function with sequence
    have prefixSequence : ComplexSequence(complexPrefixSums(
      dirichletSeriesTerms(χ, s))) by exact prefixes
    obtain ⟨K, kMember, nearS⟩ := (ComplexConvergesTo.iff_abs with
      prefixSequence, sMember).forward with convergesS, e, eMember, ePositive
    have columnsCopy := columns
    obtain ⟨columnSequence, convergesL⟩ := columnsCopy
    have columnPrefixes := complexPrefixSums.function with columnSequence
    have columnPrefixSequence : ComplexSequence(complexPrefixSums(
      lColumnPartial(N, χ, s, N))) by exact columnPrefixes
    unfold LFunction at lMember
    obtain ⟨M0, m0Member, nearL⟩ := (ComplexConvergesTo.iff_abs with
      columnPrefixSequence, lMember).forward with convergesL, e, eMember,
      ePositive
    have kNat := nat.omega.backward with kMember
    have m0Nat := nat.omega.backward with m0Member
    obtain ⟨P, pNat, nSplit⟩ := LessEqual.exists_add with positive
    have mMember : K + M0 ∈ ℕ by typecheck
    have productMember : (K + M0) * N ∈ ℕ by typecheck
    have laterL : M0 ≤ K + M0 by arith
    have laterS : K ≤ (K + M0) * N
      rw nSplit
      have expand : (K + M0) * (1 + P) = K + M0 + (K + M0) * P by arith
      rw expand
      arith
    have closeS := nearS with (K + M0) * N, productMember, laterS
    have closeL := nearL with K + M0, mMember, laterL
    rw (complexPrefixSums.value with sequence) at closeS
    rw (complexPrefixSums.value with columnSequence) at closeL
    rw ← (dirichletSeriesTerms.blocks with positive, character, hs) at closeL
    have partialMember := complexPartialSum.member at
      dirichletSeriesTerms(χ, s), (K + M0) * N with sequence
    refine ⟨complexPartialSum(dirichletSeriesTerms(χ, s), (K + M0) * N),
      partialMember, closeS, ?_⟩
    unfold LFunction
    exact closeL
  rwa sameLimit at sums

-- L(·, χ) is holomorphic on ℂ ∖ {1} for every χ.
theorem LFunction.holomorphic_off_one (N : Nat) (χ : Set)
  requires positive : 1 ≤ N
  requires character : DirichletCharacter(N, χ)
  shows HolomorphicOn(LFunctionMap(N, χ), complexCarrier ∖ {ℂ[1]})
proof
  have values := DirichletCharacter.function with character
  have one := complexOne.member
  have isOpen := complexPunctured.open with one
  have inside := ComplexOpen.subset with isOpen
  have zero : ℂ[0] ∈ ℂ by typecheck
  have minusOne : ℂ[-1] ∈ ℂ by typecheck
  have sumMember := characterSum.closed at N, χ, N with character
  have power := affinePower.holomorphic at realNat(N), ℂ[0], ℂ[-1],
    complexCarrier ∖ {ℂ[1]} with zero, minusOne, isOpen, inside
  have regular := lRegularSumMap.holomorphic at N, χ, N, complexCarrier ∖
    {ℂ[1]} with positive, values, isOpen
  have identity := HolomorphicOn.id with isOpen
  have shiftConstant := HolomorphicOn.const with isOpen, minusOne
  have shiftedMap := HolomorphicOn.add with identity, shiftConstant
  have unitConstant := HolomorphicOn.const with isOpen, one
  have identityCopy := identity
  have shiftConstantCopy := shiftConstant
  obtain ⟨_, valuesId, _⟩ := identityCopy
  obtain ⟨_, valuesShift, _⟩ := shiftConstantCopy
  have shiftedNonzero : ∀ z ∈ complexCarrier ∖ {ℂ[1]},
      complexFunctionAdd(complexFunctionId(complexCarrier ∖ {ℂ[1]}),
      complexFunctionConst(ℂ[-1], complexCarrier ∖ {ℂ[1]}),
      complexCarrier ∖ {ℂ[1]})(z) ≠ ℂ[0]
    intros z hz
    have zMember := inside with z, hz
    rw [(complexFunctionAdd.value with valuesId, valuesShift, hz),
      (complexFunctionId.value with inside, hz),
      (complexFunctionConst.value with minusOne, hz)]
    intro vanishes
    obtain ⟨_, notSingleton⟩ := hz
    apply notSingleton
    have same : z = ℂ[1] by linear_combination vanishes
    rw same
    exact singleton.self at ℂ[1]
  have reciprocal := HolomorphicOn.div with unitConstant, shiftedMap,
    shiftedNonzero
  have sumConstant := HolomorphicOn.const with isOpen, sumMember
  have scaled := HolomorphicOn.mul with sumConstant, reciprocal
  have bracket := HolomorphicOn.add with regular, scaled
  have unitCopy := unitConstant
  have shiftedCopy := shiftedMap
  have reciprocalCopy := reciprocal
  have sumConstantCopy := sumConstant
  have regularCopy := regular
  have scaledCopy := scaled
  obtain ⟨_, valuesUnit, _⟩ := unitCopy
  obtain ⟨_, valuesShifted, _⟩ := shiftedCopy
  obtain ⟨_, valuesReciprocal, _⟩ := reciprocalCopy
  obtain ⟨_, valuesSum, _⟩ := sumConstantCopy
  obtain ⟨_, valuesRegular, _⟩ := regularCopy
  obtain ⟨_, valuesScaled, _⟩ := scaledCopy
  apply HolomorphicOn.mul_formula with power, bracket
  intros z hz
  have zMember := inside with z, hz
  have exponent : ℂ[0 + -1 * z] = ℂ[-z] by ring
  rw [(LFunctionMap.apply with values, zMember), (LFunction.decomposition with
    character, zMember), (affinePower.value with zero, minusOne, zMember),
    exponent, (complexFunctionAdd.value with valuesRegular, valuesScaled, hz),
    (complexFunctionMul.value with valuesSum, valuesReciprocal, hz),
    (complexFunctionConst.value with sumMember, hz),
    (complexFunctionDiv.value with valuesUnit, valuesShifted, hz),
    (complexFunctionConst.value with one, hz),
    (complexFunctionAdd.value with valuesId, valuesShift, hz),
    (complexFunctionId.value with inside, hz),
    (complexFunctionConst.value with minusOne, hz)]

-- For χ non-principal the pole cancels: L(·, χ) is entire.
theorem LFunction.holomorphic (N : Nat) (χ : Set)
  requires positive : 1 ≤ N
  requires character : DirichletCharacter(N, χ)
  requires nonPrincipal : χ ≠ principalCharacter(N)
  shows HolomorphicOn(LFunctionMap(N, χ), complexCarrier)
proof
  have values := DirichletCharacter.function with character
  have whole := ComplexOpen.whole
  have inside := ComplexOpen.subset with whole
  have zero : ℂ[0] ∈ ℂ by typecheck
  have minusOne : ℂ[-1] ∈ ℂ by typecheck
  have positiveN : 0 < N by arith
  have vanishing := characterSum.non_principal with character, positiveN,
    nonPrincipal
  have power := affinePower.holomorphic at realNat(N), ℂ[0], ℂ[-1],
    complexCarrier with zero, minusOne, whole, inside
  have regular := lRegularSumMap.holomorphic at N, χ, N, complexCarrier with
    positive, values, whole
  apply HolomorphicOn.mul_formula with power, regular
  intros z hz
  have exponent : ℂ[0 + -1 * z] = ℂ[-z] by ring
  have regularValue := FunctionBetween.apply_closed with
    (lRegularSumMap.function at N, χ, N with values), hz
  have shifted : ℂ[z - 1] ∈ ℂ by typecheck
  have inverse := complexInv.member with shifted
  rw [(LFunctionMap.apply with values, hz), (LFunction.decomposition with
    character, hz), vanishing, (affinePower.value with zero, minusOne, hz),
    exponent]
  unfold complexDiv
  ring

-- For χ non-principal, L(s, χ) → L(1, χ) as s → 1.
theorem LFunction.at_one (N : Nat) (χ : Set)
  requires positive : 1 ≤ N
  requires character : DirichletCharacter(N, χ)
  requires nonPrincipal : χ ≠ principalCharacter(N)
  shows ∀ e ∈ ℝ, R[0] < e → ∃ d ∈ ℝ, R[0] < d ∧
    (∀ s ∈ ℂ, s ≠ ℂ[1] → complexAbs(ℂ[s - 1]) < d →
      complexAbs(ℂ[LFunction(N, χ, s) - LFunction(N, χ, ℂ[1])]) < e)
proof
  have values := DirichletCharacter.function with character
  have holomorphic := LFunction.holomorphic with positive, character,
    nonPrincipal
  have continuous := HolomorphicOn.continuous with holomorphic
  obtain ⟨_, _, close⟩ := continuous
  have one := complexOne.member
  intros e eMember ePositive
  obtain ⟨d, dReal, dPositive, near⟩ := close with ℂ[1], one, e, eMember,
    ePositive
  refine ⟨d, dReal, dPositive, ?_⟩
  intros s hs notOne small
  have estimate := near with s, hs, small
  rw [(LFunctionMap.apply with values, hs), (LFunctionMap.apply with values,
    one)] at estimate
  exact estimate

-- For χ principal the pole at 1 is simple with residue φ(N)/N.
theorem LFunction.principal_residue (N : Nat)
  requires positive : 1 ≤ N
  shows ∀ e ∈ ℝ, R[0] < e → ∃ d ∈ ℝ, R[0] < d ∧
    (∀ s ∈ ℂ, s ≠ ℂ[1] → complexAbs(ℂ[s - 1]) < d →
      complexAbs(ℂ[(s - 1) * LFunction(N, principalCharacter(N), s) -
        complexOfReal(R[realNat(totient(N)) / realNat(N)])]) < e)
proof
  have character := principalCharacter.character at N
  have values := DirichletCharacter.function with character
  have whole := ComplexOpen.whole
  have inside := ComplexOpen.subset with whole
  have one := complexOne.member
  have zero : ℂ[0] ∈ ℂ by typecheck
  have minusOne : ℂ[-1] ∈ ℂ by typecheck
  have positiveN : 0 < N by arith
  have total := characterSum.principal with positiveN
  rw ← complexOfReal.nat at total
  have totalMember := complexOfReal.mem at realNat(totient(N))
  -- G(s) = N^(−s) ((s − 1) R(s) + φ(N)) is entire.
  have power := affinePower.holomorphic at realNat(N), ℂ[0], ℂ[-1],
    complexCarrier with zero, minusOne, whole, inside
  have regular := lRegularSumMap.holomorphic at N, principalCharacter(N), N, complexCarrier
    with positive, values, whole
  have identity := HolomorphicOn.id with whole
  have shiftConstant := HolomorphicOn.const with whole, minusOne
  have shiftedMap := HolomorphicOn.add with identity, shiftConstant
  have product := HolomorphicOn.mul with shiftedMap, regular
  have totalConstant := HolomorphicOn.const with whole, totalMember
  have bracket := HolomorphicOn.add with product, totalConstant
  have full := HolomorphicOn.mul with power, bracket
  have powerCopy := power
  have regularCopy := regular
  have identityCopy := identity
  have shiftConstantCopy := shiftConstant
  have shiftedCopy := shiftedMap
  have productCopy := product
  have totalCopy := totalConstant
  have bracketCopy := bracket
  obtain ⟨_, valuesPower, _⟩ := powerCopy
  obtain ⟨_, valuesRegular, _⟩ := regularCopy
  obtain ⟨_, valuesId, _⟩ := identityCopy
  obtain ⟨_, valuesShift, _⟩ := shiftConstantCopy
  obtain ⟨_, valuesShifted, _⟩ := shiftedCopy
  obtain ⟨_, valuesProduct, _⟩ := productCopy
  obtain ⟨_, valuesTotal, _⟩ := totalCopy
  obtain ⟨_, valuesBracket, _⟩ := bracketCopy
  have formula : ∀ z ∈ ℂ, complexFunctionMul(affinePower(realNat(N), ℂ[0],
      ℂ[-1]), complexFunctionAdd(complexFunctionMul(complexFunctionAdd(
      complexFunctionId(complexCarrier), complexFunctionConst(ℂ[-1],
      complexCarrier), complexCarrier), lRegularSumMap(N, principalCharacter(N), N),
      complexCarrier), complexFunctionConst(complexOfReal(realNat(totient(N))),
      complexCarrier), complexCarrier), complexCarrier)(z) =
      ℂ[realCpow(realNat(N), ℂ[-z]) * ((z - 1) * lRegularSumMap(N, principalCharacter(N), N)(z) +
        complexOfReal(realNat(totient(N))))]
    intros z hz
    have exponent : ℂ[0 + -1 * z] = ℂ[-z] by ring
    rw [(complexFunctionMul.value with valuesPower, valuesBracket, hz),
      (complexFunctionAdd.value with valuesProduct, valuesTotal, hz),
      (complexFunctionMul.value with valuesShifted, valuesRegular, hz),
      (complexFunctionAdd.value with valuesId, valuesShift, hz),
      (complexFunctionId.value with inside, hz),
      (complexFunctionConst.value with minusOne, hz),
      (complexFunctionConst.value with totalMember, hz),
      (affinePower.value with zero, minusOne, hz), exponent]
  have continuous := HolomorphicOn.continuous with full
  obtain ⟨_, _, close⟩ := continuous
  intros e eMember ePositive
  obtain ⟨d, dReal, dPositive, near⟩ := close with ℂ[1], one, e, eMember,
    ePositive
  refine ⟨d, dReal, dPositive, ?_⟩
  intros s hs notOne small
  have estimate := near with s, hs, small
  rw [(formula with s, hs), (formula with ℂ[1], one)] at estimate
  -- (s − 1) L(s) = G(s) and G(1) = φ(N)/N.
  have shifted : ℂ[s - 1] ∈ ℂ by typecheck
  have shiftedNonzero : ℂ[s - 1] ≠ ℂ[0]
    intro vanishes
    apply notOne
    linear_combination vanishes
  have cancel := complexInv.mul_cancel with shifted, shiftedNonzero
  have regularS := FunctionBetween.apply_closed with
    (lRegularSumMap.function at N, principalCharacter(N), N with values), hs
  have powerS := realCpow.member at realNat(N), ℂ[-s]
  have atS : ℂ[(s - 1) * LFunction(N, principalCharacter(N), s)] =
      ℂ[realCpow(realNat(N), ℂ[-s]) * ((s - 1) * lRegularSumMap(N, principalCharacter(N), N)(s) +
        complexOfReal(realNat(totient(N))))]
    rw [(LFunction.decomposition with character, hs), total]
    unfold complexDiv
    linear_combination (realCpow(realNat(N), ℂ[-s]) *
      complexOfReal(realNat(totient(N)))) * cancel
  have regularOne := FunctionBetween.apply_closed with
    (lRegularSumMap.function at N, principalCharacter(N), N with values), one
  have zeroShift : ℂ[1 - 1] = ℂ[0] by ring
  have nNonzero : realNat(N) ≠ R[0]
    have nonzero : N ≠ (0:N) by arith
    exact realNat.ne_zero with nonzero
  have nPositive : R[0] < realNat(N)
    have nonzero : N ≠ (0:N) by arith
    exact realNat.positive with nonzero
  have atOne : ℂ[realCpow(realNat(N), ℂ[-1]) * ((1 - 1) *
      lRegularSumMap(N, principalCharacter(N), N)(ℂ[1]) + complexOfReal(realNat(totient(N))))] =
      complexOfReal(R[realNat(totient(N)) / realNat(N)])
    have minus : ℂ[-1] = complexOfReal(R[-1])
      rw [complexOfReal.neg, complexOfReal.one]
    rw [zeroShift, minus, realCpow.of_real, (realRpow.neg with nPositive),
      (realRpow.one with nPositive)]
    have quotient : R[realNat(totient(N)) / realNat(N)] =
        R[1 / realNat(N) * realNat(totient(N))]
      rw [realDiv.eq_mul_inv, realDiv.eq_mul_inv]
      have inverse := realInvValue.real at realNat(N)
      ring
    rw [quotient, complexOfReal.mul]
    have inverseMember := complexOfReal.mem at R[1 / realNat(N)]
    ring
  rw [atS, ← atOne]
  exact estimate

-- Modulo 1 the only character is 1, and L(s, 1) = ζ(s) everywhere.
theorem LFunction.principal_one (χ s : Set)
  requires character : DirichletCharacter(1, χ)
  requires hs : s ∈ ℂ
  shows LFunction(1, χ, s) = riemannZeta(s)
proof
  have values := DirichletCharacter.function with character
  have index : integerOfNat(0 + 1) ∈ ℤ by typecheck
  have unit := DirichletCharacter.modulus_one with character, index
  have zeroMember : (0:N) ∈ ℕ := nat.omega.forward at (0:N) with *
  have oneNonzero : R[1] ≠ R[0] by linarith
  have quotient := realDiv.mul_right at R[1], R[1] with oneNonzero
  have point : R[realNat(0 + 1) / realNat(1)] = R[1]
    rw [natural.zero_add_one, realNat.one]
    linear_combination quotient
  unfold LFunction
  rw [natural.one_succ, complexPartialSum.succ, complexPartialSum.zero,
    (lFunctionTerms.value with values, hs, zeroMember), unit, point,
    ← natural.one_succ, (realCpow.nat_neg_one with hs)]
  have zeta := riemannZeta.member with hs
  unfold riemannZeta at zeta
  unfold riemannZeta
  ring

-- |χ(a)| ≤ 1.
theorem DirichletCharacter.abs_le_one (N : Nat) (χ a : Set)
  requires character : DirichletCharacter(N, χ)
  requires positive : 0 < N
  requires integer : a ∈ ℤ
  shows complexAbs(χ(a)) ≤ R[1]
proof
  have values := DirichletCharacter.function with character
  have value := FunctionBetween.apply_closed with values, integer
  have normBound := DirichletCharacter.norm_le_one with character, positive,
    integer
  rw ← (complexAbs.square with value) at normBound
  have valueAbs := complexAbs.nonnegative with value
  have valueAbsReal := complexAbs.real with value
  have oneNonnegative : R[0] ≤ R[1] by linarith
  have unitSquare : R[1 * 1] = R[1] by ring
  have squares : R[complexAbs(χ(a)) * complexAbs(χ(a))] ≤ R[1 * 1]
    by linarith
  exact realMulValue.le_of_square_le with valueAbs, oneNonnegative, squares

-- χ(q m) (q m)^(−s) = χ(q) q^(−s) χ(m) m^(−s), in the shifted indexing.
theorem dirichletSeriesTerms.multiplicative (N : Nat) (χ s : Set)
  requires character : DirichletCharacter(N, χ)
  requires hs : s ∈ ℂ
  shows ∀ r ∈ ℕ, ∀ j ∈ ℕ, dirichletSeriesTerms(χ, s)((r + 1) * j + r) =
    ℂ[dirichletSeriesTerms(χ, s)(r) * dirichletSeriesTerms(χ, s)(j)]
proof
  have values := DirichletCharacter.function with character
  have negative : ℂ[-s] ∈ ℂ by typecheck
  intros r rMember j jMember
  have rNat := nat.omega.backward with rMember
  have jNat := nat.omega.backward with jMember
  have position : (r + 1) * j + r ∈ ℕ by typecheck
  have index : (r + 1) * j + r + 1 = (r + 1) * (j + 1) by arith
  have positiveR : 1 ≤ r + 1 by arith
  have positiveJ : 1 ≤ j + 1 by arith
  have rInteger : integerOfNat(r + 1) ∈ ℤ by typecheck
  have jInteger : integerOfNat(j + 1) ∈ ℤ by typecheck
  have rValue := FunctionBetween.apply_closed with values, rInteger
  have jValue := FunctionBetween.apply_closed with values, jInteger
  have rPower := realCpow.member at realNat(r + 1), ℂ[-s] with negative
  have jPower := realCpow.member at realNat(j + 1), ℂ[-s] with negative
  rw [(dirichletSeriesTerms.value with values, hs, position),
    (dirichletSeriesTerms.value with values, hs, rMember),
    (dirichletSeriesTerms.value with values, hs, jMember), index,
    (realCpow.nat_neg_mul with positiveR, positiveJ, hs), integerOfNat.mul,
    (DirichletCharacter.mul with character, rInteger, jInteger)]
  ring

-- The hypotheses of the sieve for L(s, χ): t(n) = χ(n + 1) (n + 1)^(−s).
theorem LFunction.euler_sieve (N : Nat) (χ s : Set)
  requires positive : 1 ≤ N
  requires character : DirichletCharacter(N, χ)
  requires hs : s ∈ ℂ
  requires halfPlane : realOne < complexRe(s)
  shows ComplexConvergesTo(lEulerProducts(χ, s), LFunction(N, χ, s)) ∧
    LFunction(N, χ, s) ≠ ℂ[0]
proof
  have values := DirichletCharacter.function with character
  have positiveN : 0 < N by arith
  obtain ⟨sums, absolute⟩ := LFunction.series with positive, character, hs,
    halfPlane
  have products := lEulerProducts.function with values, hs
  have sequenceE : ComplexSequence(lEulerProducts(χ, s)) by exact products
  have negative : ℂ[-s] ∈ ℂ by typecheck
  have zeroMember : (0:N) ∈ ℕ := nat.omega.forward at (0:N) with *
  have first : dirichletSeriesTerms(χ, s)((0:N)) = ℂ[1]
    rw [(dirichletSeriesTerms.value with values, hs, zeroMember),
      natural.zero_add_one, (realCpow.nat_neg_one with hs), integerOfNat.one,
      (DirichletCharacter.one with character)]
    ring
  have multiplicativeAll := dirichletSeriesTerms.multiplicative with
    character, hs
  have multiplicative : ∀ r ∈ ℕ, Prime(r + 1) → (∀ j ∈ ℕ,
      dirichletSeriesTerms(χ, s)((r + 1) * j + r) =
        ℂ[dirichletSeriesTerms(χ, s)(r) * dirichletSeriesTerms(χ, s)(j)])
    intros r rMember prime
    exact multiplicativeAll with r, rMember
  have notOne : ∀ r ∈ ℕ, Prime(r + 1) → dirichletSeriesTerms(χ, s)(r) ≠ ℂ[1]
    intros r rMember prime isOne
    have rNat := nat.omega.backward with rMember
    have above := Prime.greater_than_one with prime
    have positiveR : 1 ≤ r + 1 by arith
    have rInteger : integerOfNat(r + 1) ∈ ℤ by typecheck
    have rValue := FunctionBetween.apply_closed with values, rInteger
    have rPower := realCpow.member at realNat(r + 1), ℂ[-s] with negative
    rw [(dirichletSeriesTerms.value with values, hs, rMember)] at isOne
    have size := complexAbs.mul with rValue, rPower
    rw [isOne, complexAbs.one, (realCpow.nat_neg_abs with positiveR, hs)] at
      size
    have valueBound := DirichletCharacter.abs_le_one with character,
      positiveN, rInteger
    have valueAbs := complexAbs.nonnegative with rValue
    have base := realNat.lt_of_lt with above
    rw realNat.one at base
    have reS : Real(complexRe(s)) by typecheck
    have exponent : R[-complexRe(s)] < R[0] by linarith
    have smaller := realRpow.lt_of_exponent with base, exponent
    rw realRpow.zero at smaller
    have powerPositive := realRpow.positive at realNat(r + 1),
      R[-complexRe(s)]
    have scaled := realLe.mul_right_of_nonnegative with valueBound,
      (realLess.implies_le with powerPositive)
    have valueReal := complexAbs.real with rValue
    have powerReal := realRpow.real at realNat(r + 1), R[-complexRe(s)]
    have unit : R[1 * realRpow(realNat(r + 1), R[-complexRe(s)])] =
      realRpow(realNat(r + 1), R[-complexRe(s)]) by ring
    linarith
  have start : lEulerProducts(χ, s)((0:N)) = ℂ[1]
    rw [(lEulerProducts.value with values, hs, zeroMember), lEulerProduct]
  have primeStep : ∀ r ∈ ℕ, Prime(r + 1) →
      lEulerProducts(χ, s)(r + 1 + 1) = ℂ[lEulerProducts(χ, s)(r + 1) *
        complexInv(ℂ[1 - dirichletSeriesTerms(χ, s)(r)])]
    intros r rMember prime
    have rNat := nat.omega.backward with rMember
    have here : r + 1 ∈ ℕ by typecheck
    have next : r + 1 + 1 ∈ ℕ by typecheck
    obtain ⟨_, primeValue, _⟩ := lEulerFactor.selected at χ, s, r + 1 with
      values, hs
    have index : r + 1 + 1 = succ(r + 1) by arith
    rw [(lEulerProducts.value with values, hs, next),
      (lEulerProducts.value with values, hs, here),
      (dirichletSeriesTerms.value with values, hs, rMember), index,
      lEulerProduct, (primeValue with prime)]
  have otherStep : ∀ k ∈ ℕ, ¬Prime(k) →
      lEulerProducts(χ, s)(k + 1) = lEulerProducts(χ, s)(k)
    intros k kMember notPrime
    have kNat := nat.omega.backward with kMember
    have next : k + 1 ∈ ℕ by typecheck
    obtain ⟨_, _, otherValue⟩ := lEulerFactor.selected at χ, s, k with values,
      hs
    have index : k + 1 = succ(k) by arith
    have product := lEulerProduct.member at χ, s, k with values, hs
    rw [(lEulerProducts.value with values, hs, next),
      (lEulerProducts.value with values, hs, kMember), index, lEulerProduct,
      (otherValue with notPrime)]
    ring
  exact ComplexConvergesTo.euler_sieve with absolute, sums, first,
    multiplicative, notOne, sequenceE, start, primeStep, otherStep

-- The Euler product: for re s > 1, ∏_{p < n} (1 − χ(p) p^(−s))⁻¹ → L(s, χ).
theorem LFunction.euler_product (N : Nat) (χ s : Set)
  requires positive : 1 ≤ N
  requires character : DirichletCharacter(N, χ)
  requires hs : s ∈ ℂ
  requires halfPlane : realOne < complexRe(s)
  shows ComplexConvergesTo(lEulerProducts(χ, s), LFunction(N, χ, s))
proof
  obtain ⟨converges, _⟩ := LFunction.euler_sieve with positive, character, hs,
    halfPlane
  exact converges

theorem LFunction.nonzero_re_gt_one (N : Nat) (χ s : Set)
  requires positive : 1 ≤ N
  requires character : DirichletCharacter(N, χ)
  requires hs : s ∈ ℂ
  requires halfPlane : realOne < complexRe(s)
  shows LFunction(N, χ, s) ≠ ℂ[0]
proof
  obtain ⟨_, nonzero⟩ := LFunction.euler_sieve with positive, character, hs,
    halfPlane
  exact nonzero

-- Section: The 3–4–1 inequality for L-functions
-- χ², the pointwise square of a character.
defgraph characterSquare (χ : Set) (a ∈ ℤ) : complexCarrier :=
    ℂ[χ(a) * χ(a)]
requires values : FunctionBetween(χ, ℤ, complexCarrier)
proof
  have value := FunctionBetween.apply_closed with values, member
  typecheck

theorem characterSquare.character (N : Nat) (χ : Set)
  requires character : DirichletCharacter(N, χ)
  shows DirichletCharacter(N, characterSquare(χ))
proof
  have values := DirichletCharacter.function with character
  have characterCopy := character
  obtain ⟨_, periodic, one, multiplicative, vanishing⟩ := characterCopy
  have function := characterSquare.function with values
  unfold DirichletCharacter
  refine ⟨function, ?_, ?_, ?_, ?_⟩
  . intros a aInteger
    have shifted : integerAddValue(a, integerOfNat(N)) ∈ ℤ by typecheck
    rw [(characterSquare.value with values, shifted),
      (characterSquare.value with values, aInteger), (periodic with a,
      aInteger)]
  . have oneInteger : integerOne ∈ ℤ by typecheck
    rw [(characterSquare.value with values, oneInteger), one]
    ring
  . intros a aInteger b bInteger
    have product : integerMulValue(a, b) ∈ ℤ by typecheck
    have aValue := FunctionBetween.apply_closed with values, aInteger
    have bValue := FunctionBetween.apply_closed with values, bInteger
    rw [(characterSquare.value with values, product),
      (characterSquare.value with values, aInteger),
      (characterSquare.value with values, bInteger), (multiplicative with a,
      aInteger, b, bInteger)]
    ring
  . intros a aInteger notCoprime
    rw [(characterSquare.value with values, aInteger), (vanishing with a,
      aInteger, notCoprime)]
    ring

-- For re s = 1 and e > 0:
-- |L(1 + e, χ₀)|⁶ |L(s + e, χ)|⁸ |L(2s − 1 + e, χ²)|² ≥ 1.
theorem LFunction.three_four_one (N : Nat) (χ s : Set) (e : Real)
  requires positive : 1 ≤ N
  requires character : DirichletCharacter(N, χ)
  requires hs : s ∈ ℂ
  requires onLine : complexRe(s) = R[1]
  requires ePositive : R[0] < e
  shows R[1] ≤ R[complexNormSquared(LFunction(N, principalCharacter(N),
    complexOfReal(R[1 + e]))) ^ 3 *
    complexNormSquared(LFunction(N, χ, ℂ[s + complexOfReal(e)])) ^ 4 *
    complexNormSquared(LFunction(N, characterSquare(χ),
    ℂ[s + s - 1 + complexOfReal(e)]))]
proof
  have positiveN : 0 < N by arith
  have principal := principalCharacter.character at N
  have square := characterSquare.character with character
  have values0 := DirichletCharacter.function with principal
  have values1 := DirichletCharacter.function with character
  have values2 := DirichletCharacter.function with square
  have eMember := complexOfReal.mem at e
  have aMember := complexOfReal.mem at R[1 + e]
  have bMember : ℂ[s + complexOfReal(e)] ∈ ℂ by typecheck
  have cMember : ℂ[s + s - 1 + complexOfReal(e)] ∈ ℂ by typecheck
  have one := complexOne.member
  have reOne : complexRe(ℂ[1]) = R[1]
    rw [← complexOfReal.one, complexOfReal.re]
  have reA : realOne < complexRe(complexOfReal(R[1 + e]))
    rw complexOfReal.re
    linarith
  have reB : realOne < complexRe(ℂ[s + complexOfReal(e)])
    rw [(complexRe.add with hs, eMember), onLine, complexOfReal.re]
    linarith
  have twoS : ℂ[s + s] ∈ ℂ by typecheck
  have twoSMinus : ℂ[s + s - 1] ∈ ℂ by typecheck
  have reC : realOne < complexRe(ℂ[s + s - 1 + complexOfReal(e)])
    rw [(complexRe.add with twoSMinus, eMember), (complexRe.sub with twoS, one),
      (complexRe.add with hs, hs), onLine, reOne, complexOfReal.re]
    linarith
  have euler1 := LFunction.euler_product with positive, principal, aMember,
    reA
  have euler2 := LFunction.euler_product with positive, character, bMember,
    reB
  have euler3 := LFunction.euler_product with positive, square, cMember, reC
  apply eulerProducts.three_four_one_limit with euler1, euler2, euler3
  intros n nMember
  have nNat := nat.omega.backward with nMember
  have zeroMember : (0:N) ∈ ℕ := nat.omega.forward at (0:N) with *
  have start1 : lEulerProducts(principalCharacter(N),
      complexOfReal(R[1 + e]))((0:N)) = ℂ[1]
    rw [(lEulerProducts.value with values0, aMember, zeroMember), lEulerProduct]
  have start2 : lEulerProducts(χ, ℂ[s + complexOfReal(e)])((0:N)) = ℂ[1]
    rw [(lEulerProducts.value with values1, bMember, zeroMember), lEulerProduct]
  have start3 : lEulerProducts(characterSquare(χ),
      ℂ[s + s - 1 + complexOfReal(e)])((0:N)) = ℂ[1]
    rw [(lEulerProducts.value with values2, cMember, zeroMember), lEulerProduct]
  have values : ∀ k ∈ ℕ, lEulerProducts(principalCharacter(N),
      complexOfReal(R[1 + e]))(k) ∈ ℂ ∧
      lEulerProducts(χ, ℂ[s + complexOfReal(e)])(k) ∈ ℂ ∧
      lEulerProducts(characterSquare(χ), ℂ[s + s - 1 +
        complexOfReal(e)])(k) ∈ ℂ
    intros k kMember
    have p1 := lEulerProducts.function with values0, aMember
    have p2 := lEulerProducts.function with values1, bMember
    have p3 := lEulerProducts.function with values2, cMember
    exact ⟨(FunctionBetween.apply_closed with p1, kMember),
      (FunctionBetween.apply_closed with p2, kMember),
      (FunctionBetween.apply_closed with p3, kMember)⟩
  have step : ∀ k ∈ ℕ, ∃ f1 ∈ ℂ, ∃ f2 ∈ ℂ, ∃ f3 ∈ ℂ,
      lEulerProducts(principalCharacter(N), complexOfReal(R[1 + e]))(k + 1) =
        ℂ[lEulerProducts(principalCharacter(N),
        complexOfReal(R[1 + e]))(k) * f1] ∧
      lEulerProducts(χ, ℂ[s + complexOfReal(e)])(k + 1) =
        ℂ[lEulerProducts(χ, ℂ[s + complexOfReal(e)])(k) * f2] ∧
      lEulerProducts(characterSquare(χ),
        ℂ[s + s - 1 + complexOfReal(e)])(k + 1) =
        ℂ[lEulerProducts(characterSquare(χ),
        ℂ[s + s - 1 + complexOfReal(e)])(k) * f3] ∧
      R[1] ≤ R[complexNormSquared(f1) ^ 3 * complexNormSquared(f2) ^ 4 *
        complexNormSquared(f3)]
    intros k kMember
    have kNat := nat.omega.backward with kMember
    have next : k + 1 ∈ ℕ by typecheck
    have index : k + 1 = succ(k) by arith
    obtain ⟨factor1, prime1, other1⟩ := lEulerFactor.selected at
      principalCharacter(N), complexOfReal(R[1 + e]), k with values0, aMember
    obtain ⟨factor2, prime2, other2⟩ := lEulerFactor.selected at
      χ, ℂ[s + complexOfReal(e)], k with values1, bMember
    obtain ⟨factor3, prime3, other3⟩ := lEulerFactor.selected at
      characterSquare(χ), ℂ[s + s - 1 + complexOfReal(e)], k with values2,
      cMember
    refine ⟨lEulerFactor(principalCharacter(N), complexOfReal(R[1 + e]), k),
      factor1, lEulerFactor(χ, ℂ[s + complexOfReal(e)], k), factor2,
      lEulerFactor(characterSquare(χ), ℂ[s + s - 1 + complexOfReal(e)], k),
      factor3, ?_, ?_, ?_, ?_⟩
    . rw [(lEulerProducts.value with values0, aMember, next),
        (lEulerProducts.value with values0, aMember, kMember), index,
        lEulerProduct]
    . rw [(lEulerProducts.value with values1, bMember, next),
        (lEulerProducts.value with values1, bMember, kMember), index,
        lEulerProduct]
    . rw [(lEulerProducts.value with values2, cMember, next),
        (lEulerProducts.value with values2, cMember, kMember), index,
        lEulerProduct]
    . by_cases prime : Prime(k)
      . rw [(prime1 with prime), (prime2 with prime), (prime3 with prime)]
        have kInteger : integerOfNat(k) ∈ ℤ by typecheck
        have above := Prime.greater_than_one with prime
        have base := realNat.lt_of_lt with above
        rw realNat.one at base
        have basePositive : R[0] < realNat(k) by linarith
        have negA : ℂ[-complexOfReal(R[1 + e])] ∈ ℂ by typecheck
        have negB : ℂ[-(s + complexOfReal(e))] ∈ ℂ by typecheck
        have negC : ℂ[-(s + s - 1 + complexOfReal(e))] ∈ ℂ by typecheck
        have powerAMember := realCpow.member at realNat(k),
          ℂ[-complexOfReal(R[1 + e])] with negA
        have powerBMember := realCpow.member at realNat(k),
          ℂ[-(s + complexOfReal(e))] with negB
        have powerCMember := realCpow.member at realNat(k),
          ℂ[-(s + s - 1 + complexOfReal(e))] with negC
        have chiValue := FunctionBetween.apply_closed with values1, kInteger
        rw (characterSquare.value with values1, kInteger)
        by_cases coprime : IntegerCoprime(integerOfNat(k), integerOfNat(N))
        . rw (principalCharacter.coprime with kInteger, coprime)
          have shift : ℂ[-(s - 1)] ∈ ℂ by typecheck
          have negAShift : ℂ[-complexOfReal(R[1 + e]) + -(s - 1)] ∈ ℂ
            by typecheck
          have powerA : realCpow(realNat(k), ℂ[-complexOfReal(R[1 + e])]) =
              complexOfReal(realRpow(realNat(k), R[-(1 + e)]))
            rw [← complexOfReal.neg, realCpow.of_real]
          have exponentB : ℂ[-(s + complexOfReal(e))] =
              ℂ[-complexOfReal(R[1 + e]) + -(s - 1)]
            rw [complexOfReal.add, complexOfReal.one]
            ring
          have exponentC : ℂ[-(s + s - 1 + complexOfReal(e))] =
              ℂ[-complexOfReal(R[1 + e]) + -(s - 1) + -(s - 1)]
            rw [complexOfReal.add, complexOfReal.one]
            ring
          have wMember := realCpow.member at realNat(k), ℂ[-(s - 1)] with
            shift
          rw [exponentB, exponentC, (realCpow.add with negAShift, shift),
            (realCpow.add with negA, shift), powerA]
          have regroupA : ℂ[1 - complexOne * complexOfReal(realRpow(realNat(k),
              R[-(1 + e)]))] =
            ℂ[1 - complexOfReal(realRpow(realNat(k), R[-(1 + e)]))] by ring
          have regroupB : ℂ[1 - χ(integerOfNat(k)) *
              (complexOfReal(realRpow(realNat(k), R[-(1 + e)])) *
              realCpow(realNat(k), ℂ[-(s - 1)]))] =
            ℂ[1 - complexOfReal(realRpow(realNat(k), R[-(1 + e)])) *
              (χ(integerOfNat(k)) * realCpow(realNat(k), ℂ[-(s - 1)]))]
            by ring
          have regroupC : ℂ[1 - χ(integerOfNat(k)) * χ(integerOfNat(k)) *
              (complexOfReal(realRpow(realNat(k), R[-(1 + e)])) *
              realCpow(realNat(k), ℂ[-(s - 1)]) *
              realCpow(realNat(k), ℂ[-(s - 1)]))] =
            ℂ[1 - complexOfReal(realRpow(realNat(k), R[-(1 + e)])) *
              ((χ(integerOfNat(k)) * realCpow(realNat(k), ℂ[-(s - 1)])) *
              (χ(integerOfNat(k)) * realCpow(realNat(k), ℂ[-(s - 1)])))]
            by ring
          rw [regroupA, regroupB, regroupC]
          have xReal := realRpow.real at realNat(k), R[-(1 + e)]
          have xPositive := realRpow.positive at realNat(k), R[-(1 + e)]
          have xNonnegative : R[0] ≤ realRpow(realNat(k), R[-(1 + e)]) by
            linarith
          have exponent : R[-(1 + e)] < R[0] by linarith
          have smaller := realRpow.lt_of_exponent with base, exponent
          rw realRpow.zero at smaller
          have xMember : realRpow(realNat(k), R[-(1 + e)]) ∈ ℝ by typecheck
          have unitW : complexAbs(realCpow(realNat(k), ℂ[-(s - 1)])) = R[1]
            have sMinus : ℂ[s - 1] ∈ ℂ by typecheck
            rw [(realCpow.abs with basePositive, shift), (complexRe.neg with
              sMinus), (complexRe.sub with hs, one), onLine, reOne]
            have zero : R[-(1 - 1)] = R[0] by ring
            rw [zero, realRpow.zero]
          have normChi := DirichletCharacter.norm_coprime with character,
            positiveN, kInteger, coprime
          rw ← (complexAbs.square with chiValue) at normChi
          have chiAbs := complexAbs.nonnegative with chiValue
          have chiAbsReal := complexAbs.real with chiValue
          have unitChi : complexAbs(χ(integerOfNat(k))) = R[1]
            have sign := realLess.trichotomy at complexAbs(χ(integerOfNat(k))),
              R[1]
            rcases sign with less | same | more
            . exfalso
              have chiSquare := realLe.mul_left_of_nonnegative with
                (realLess.implies_le with less), chiAbs
              have unit : R[complexAbs(χ(integerOfNat(k))) * 1] =
                complexAbs(χ(integerOfNat(k))) by ring
              linarith
            . exact same
            . exfalso
              have chiSquare := realLe.mul_right_of_nonnegative with
                (realLess.implies_le with more), chiAbs
              have unit : R[1 * complexAbs(χ(integerOfNat(k)))] =
                complexAbs(χ(integerOfNat(k))) by ring
              linarith
          have wwMember : ℂ[χ(integerOfNat(k)) *
            realCpow(realNat(k), ℂ[-(s - 1)])] ∈ ℂ by typecheck
          have unitProduct : complexAbs(ℂ[χ(integerOfNat(k)) *
              realCpow(realNat(k), ℂ[-(s - 1)])]) = R[1]
            rw [(complexAbs.mul with chiValue, wMember), unitChi, unitW]
            ring
          exact eulerFactor.three_four_one with xMember, xNonnegative, smaller,
            wwMember, unitProduct
        . rw [(principalCharacter.not_coprime with kInteger, coprime),
            (DirichletCharacter.not_coprime with character, kInteger,
            coprime)]
          have trivial1 : ℂ[1 - complexZero * realCpow(realNat(k),
            ℂ[-complexOfReal(R[1 + e])])] = ℂ[1] by ring
          have trivial2 : ℂ[1 - complexZero * realCpow(realNat(k),
            ℂ[-(s + complexOfReal(e))])] = ℂ[1] by ring
          have trivial3 : ℂ[1 - complexZero * complexZero *
            realCpow(realNat(k), ℂ[-(s + s - 1 + complexOfReal(e))])] = ℂ[1]
            by ring
          have oneNonzero : ℂ[1] ≠ ℂ[0]
            intro vanish
            have size := complexAbs.one
            rw [vanish, complexAbs.zero] at size
            linarith
          have cancel := complexInv.mul_cancel with one, oneNonzero
          have inverseOne : complexInv(ℂ[1]) = ℂ[1]
            have inverse := complexInv.member with one
            linear_combination cancel
          rw [trivial1, trivial2, trivial3, inverseOne, complexNormSquared.one]
          have unit : R[1 ^ 3 * 1 ^ 4 * 1] = R[1] by ring
          rw unit
          exact realLe.reflexive at R[1]
      . rw [(other1 with prime), (other2 with prime), (other3 with prime),
          complexNormSquared.one]
        have unit : R[1 ^ 3 * 1 ^ 4 * 1] = R[1] by ring
        rw unit
        exact realLe.reflexive at R[1]
  exact eulerProducts.three_four_one_partial at
    lEulerProducts(principalCharacter(N), complexOfReal(R[1 + e])),
    lEulerProducts(χ, ℂ[s + complexOfReal(e)]),
    lEulerProducts(characterSquare(χ), ℂ[s + s - 1 + complexOfReal(e)]), n
    with start1, start2, start3, step, values

-- The 3–4–1 argument on an open set U where L(·, χ) and L(·, χ²) are
-- holomorphic: L(·, χ) cannot vanish at a point s of U on re s = 1 when
-- 2s − 1 and the points s + e, 2s − 1 + e (e > 0) lie in U.
theorem LFunction.three_four_one_zero (N : Nat) (χ s U : Set)
  requires positive : 1 ≤ N
  requires character : DirichletCharacter(N, χ)
  requires hs : s ∈ ℂ
  requires onLine : complexRe(s) = R[1]
  requires vanish : LFunction(N, χ, s) = ℂ[0]
  requires holomorphic : HolomorphicOn(LFunctionMap(N, χ), U)
  requires holomorphicSquare : HolomorphicOn(LFunctionMap(N,
    characterSquare(χ)), U)
  requires sU : s ∈ U
  requires c0U : ℂ[s + s - 1] ∈ U
  requires shifted : ∀ e ∈ ℝ, R[0] < e → ℂ[s + complexOfReal(e)] ∈ U ∧
    ℂ[s + s - 1 + complexOfReal(e)] ∈ U
  shows false
proof
  have one := complexOne.member
  have principal := principalCharacter.character at N
  have square := characterSquare.character with character
  have values0 := DirichletCharacter.function with principal
  have values1 := DirichletCharacter.function with character
  have values2 := DirichletCharacter.function with square
  have c0 : ℂ[s + s - 1] ∈ ℂ by typecheck
  -- L(·, χ) vanishes to first order at s, L(·, χ²) is bounded near
  -- 2s − 1, and L(·, χ₀) has a simple pole at 1
  obtain ⟨D1, d1Member, derivative1⟩ := HolomorphicOn.differentiable with
    holomorphic, sU
  obtain ⟨r1, r1Real, r1Positive, lipschitz1⟩ :=
    HasComplexDerivativeAt.lipschitz with derivative1
  obtain ⟨D2, d2Member, derivative2⟩ := HolomorphicOn.differentiable with
    holomorphicSquare, c0U
  obtain ⟨r2, r2Real, r2Positive, lipschitz2⟩ :=
    HasComplexDerivativeAt.lipschitz with derivative2
  have oneReal : R[1] ∈ ℝ by typecheck
  have onePositive : R[0] < R[1] by linarith
  have residue := LFunction.principal_residue with positive
  obtain ⟨r3, r3Real, r3Positive, pole⟩ := residue with R[1], oneReal,
    onePositive
  have phi := complexOfReal.mem at R[realNat(totient(N)) / realNat(N)]
  have phiAbs := complexAbs.nonnegative with phi
  have phiReal := complexAbs.real with phi
  have d1Abs := complexAbs.nonnegative with d1Member
  have d1Real := complexAbs.real with d1Member
  have d2Abs := complexAbs.nonnegative with d2Member
  have d2Real := complexAbs.real with d2Member
  have zetaC0 := LFunction.member with square, c0
  have c0Abs := complexAbs.nonnegative with zetaC0
  have c0Real := complexAbs.real with zetaC0
  have kNonnegative : R[0] ≤ R[1 + complexAbs(D1)] by linarith
  have mNonnegative : R[0] ≤ R[complexAbs(LFunction(N, characterSquare(χ), ℂ[s + s - 1])) + (1 +
    complexAbs(D2))] by linarith
  have k2 := realMulValue.nonnegative with kNonnegative, kNonnegative
  have k4 := realMulValue.nonnegative with k2, k2
  have m2 := realMulValue.nonnegative with mNonnegative, mNonnegative
  have twoReal : R[0] ≤ R[1 + complexAbs(complexOfReal(R[realNat(totient(N)) / realNat(N)]))] by
    linarith
  have twoSquare := realMulValue.nonnegative with twoReal, twoReal
  have twoFourth := realMulValue.nonnegative with twoSquare, twoSquare
  have sixtyFour := realMulValue.nonnegative with twoFourth, twoSquare
  have weight1 := realMulValue.nonnegative with sixtyFour, k4
  have weight2 := realMulValue.nonnegative with weight1, k4
  have weight := realMulValue.nonnegative with weight2, m2
  obtain ⟨g, gReal, gPositive, gSmall⟩ := real.small_multiple with weight,
    onePositive
  obtain ⟨q1, q1Real, q1Positive, q1r1, q1r2⟩ := positiveRadius.common with
    r1Positive, r2Positive
  obtain ⟨q2, q2Real, q2Positive, q2q1, q2r3⟩ := positiveRadius.common with
    q1Positive, r3Positive
  obtain ⟨q3, q3Real, q3Positive, q3q2, q3g⟩ := positiveRadius.common with
    q2Positive, gPositive
  obtain ⟨q4, q4Real, q4Positive, q4q3, q4One⟩ := positiveRadius.common with
    q3Positive, onePositive
  have twoNonnegative : R[0] ≤ R[2] by linarith
  obtain ⟨e, eReal, ePositive, eSmall⟩ := real.small_multiple with
    twoNonnegative, q4Positive
  have eTyped : Real(e) by typecheck
  have eBelow : e < q4 by linarith
  -- the three points
  have eMember := complexOfReal.mem at e
  have aMember := complexOfReal.mem at R[1 + e]
  have bMember : ℂ[s + complexOfReal(e)] ∈ ℂ by typecheck
  have cMember : ℂ[s + s - 1 + complexOfReal(e)] ∈ ℂ by typecheck
  obtain ⟨bU, cU⟩ := shifted with e, eReal, ePositive
  have main := LFunction.three_four_one with positive, character, hs, onLine,
    ePositive
  have zetaA := LFunction.member with principal, aMember
  have zetaB := LFunction.member with character, bMember
  have zetaC := LFunction.member with square, cMember
  rw [← (complexAbs.square with zetaA), ← (complexAbs.square with zetaB),
    ← (complexAbs.square with zetaC)] at main
  have eAbs : complexAbs(complexOfReal(e)) = e
    rw [complexAbs.of_real, (abs.of_nonnegative with
      (realLess.implies_le with ePositive))]
  -- the pole: e |L(1 + e, χ₀)| ≤ 1 + φ(N)/N
  have aShift : ℂ[complexOfReal(R[1 + e]) - 1] = complexOfReal(e)
    rw [complexOfReal.add, complexOfReal.one]
    ring
  have aNotOne : complexOfReal(R[1 + e]) ≠ ℂ[1]
    intro same
    have re := complexOfReal.re at R[1 + e]
    rw [same, ← complexOfReal.one, complexOfReal.re] at re
    linarith
  have aClose : complexAbs(ℂ[complexOfReal(R[1 + e]) - 1]) < r3
    rw [aShift, eAbs]
    linarith
  have poleBound := pole with complexOfReal(R[1 + e]), aMember, aNotOne, aClose
  rw aShift at poleBound
  have difference : ℂ[complexOfReal(e) * LFunction(N, principalCharacter(N), complexOfReal(R[1 + e])) -
    complexOfReal(R[realNat(totient(N)) / realNat(N)])] ∈ ℂ by typecheck
  have poleTriangle := complexAbs.triangle with difference, phi
  have poleShape : ℂ[complexOfReal(e) * LFunction(N, principalCharacter(N), complexOfReal(R[1 + e])) -
      complexOfReal(R[realNat(totient(N)) / realNat(N)]) + complexOfReal(R[realNat(totient(N)) / realNat(N)])] =
    ℂ[complexOfReal(e) * LFunction(N, principalCharacter(N), complexOfReal(R[1 + e]))] by ring
  rw [poleShape, (complexAbs.mul with eMember, zetaA), eAbs] at poleTriangle
  have aAbs := complexAbs.nonnegative with zetaA
  have aReal := complexAbs.real with zetaA
  have differenceReal := complexAbs.real with difference
  have commute : R[e * complexAbs(LFunction(N, principalCharacter(N), complexOfReal(R[1 + e])))] =
    R[complexAbs(LFunction(N, principalCharacter(N), complexOfReal(R[1 + e]))) * e] by ring
  have poleOrder : R[complexAbs(LFunction(N, principalCharacter(N), complexOfReal(R[1 + e]))) * e] ≤
    R[1 + complexAbs(complexOfReal(R[realNat(totient(N)) / realNat(N)]))] by linarith
  -- the zero: |L(s + e, χ)| ≤ (1 + |L'(s, χ)|) e
  have bShift : ℂ[ℂ[s + complexOfReal(e)] - s] = complexOfReal(e) by ring
  have bClose : complexAbs(ℂ[ℂ[s + complexOfReal(e)] - s]) < r1
    rw [bShift, eAbs]
    linarith
  have zeroBound := lipschitz1 with ℂ[s + complexOfReal(e)], bU, bClose
  rw [bShift, eAbs, (LFunctionMap.apply with values1, bMember),
    (LFunctionMap.apply with values1, hs), vanish] at zeroBound
  have bValue : ℂ[LFunction(N, χ, ℂ[s + complexOfReal(e)]) - 0] =
    LFunction(N, χ, ℂ[s + complexOfReal(e)]) by ring
  rw bValue at zeroBound
  -- the bounded factor: |L(2s − 1 + e, χ²)| ≤ |L(2s − 1, χ²)| + (1 + |L'|)
  have cShift : ℂ[ℂ[s + s - 1 + complexOfReal(e)] - ℂ[s + s - 1]] =
    complexOfReal(e) by ring
  have cClose : complexAbs(ℂ[ℂ[s + s - 1 + complexOfReal(e)] -
      ℂ[s + s - 1]]) < r2
    rw [cShift, eAbs]
    linarith
  have boundedChange := lipschitz2 with ℂ[s + s - 1 + complexOfReal(e)], cU,
    cClose
  rw [cShift, eAbs, (LFunctionMap.apply with values2, cMember),
    (LFunctionMap.apply with values2, c0)] at boundedChange
  have change : ℂ[LFunction(N, characterSquare(χ), ℂ[s + s - 1 + complexOfReal(e)]) -
    LFunction(N, characterSquare(χ), ℂ[s + s - 1])] ∈ ℂ by typecheck
  have cTriangle := complexAbs.triangle with change, zetaC0
  have cShape : ℂ[LFunction(N, characterSquare(χ), ℂ[s + s - 1 + complexOfReal(e)]) -
      LFunction(N, characterSquare(χ), ℂ[s + s - 1]) + LFunction(N, characterSquare(χ), ℂ[s + s - 1])] =
    LFunction(N, characterSquare(χ), ℂ[s + s - 1 + complexOfReal(e)]) by ring
  rw cShape at cTriangle
  have eAtMostOne : e ≤ R[1] by linarith
  have kd2 : R[0] ≤ R[1 + complexAbs(D2)] by linarith
  have kd2e := realLe.mul_left_of_nonnegative with eAtMostOne, kd2
  have unitK : R[(1 + complexAbs(D2)) * 1] = R[1 + complexAbs(D2)] by ring
  have changeReal := complexAbs.real with change
  have cAbs := complexAbs.nonnegative with zetaC
  have cReal := complexAbs.real with zetaC
  have boundedOrder : complexAbs(LFunction(N, characterSquare(χ),
      ℂ[s + s - 1 + complexOfReal(e)])) ≤ R[complexAbs(LFunction(N, characterSquare(χ), ℂ[s + s - 1])) +
      (1 + complexAbs(D2))] by linarith
  -- combine
  have bAbs := complexAbs.nonnegative with zetaB
  have orders := real.three_four_one_orders with aAbs, bAbs, cAbs, ePositive,
    poleOrder, zeroBound, boundedOrder, main
  have eg : e ≤ g by linarith
  exact real.three_four_one_small with weight, ePositive, eAtMostOne, eg,
    gSmall, orders

-- L(1, χ) ≠ 0 when χ² is not principal: the 3–4–1 argument at s = 1,
-- where L(·, χ) and L(·, χ²) are entire.
theorem LFunction.nonzero_one_of_square (N : Nat) (χ : Set)
  requires positive : 1 ≤ N
  requires character : DirichletCharacter(N, χ)
  requires nonPrincipal : χ ≠ principalCharacter(N)
  requires squareNonPrincipal : characterSquare(χ) ≠ principalCharacter(N)
  shows LFunction(N, χ, ℂ[1]) ≠ ℂ[0]
proof
  intro vanish
  have square := characterSquare.character with character
  have one := complexOne.member
  have onLine : complexRe(ℂ[1]) = R[1]
    rw [← complexOfReal.one, complexOfReal.re]
  have holomorphic := LFunction.holomorphic with positive, character,
    nonPrincipal
  have holomorphicSquare := LFunction.holomorphic with positive, square,
    squareNonPrincipal
  have c0 : ℂ[1 + 1 - 1] ∈ ℂ by typecheck
  have shifted : ∀ e ∈ ℝ, R[0] < e → ℂ[1 + complexOfReal(e)] ∈ ℂ ∧
      ℂ[1 + 1 - 1 + complexOfReal(e)] ∈ ℂ
    intros e eReal ePositive
    have eTyped : Real(e) by typecheck
    have eMember := complexOfReal.mem at e
    have bMember : ℂ[1 + complexOfReal(e)] ∈ ℂ by typecheck
    have cMember : ℂ[1 + 1 - 1 + complexOfReal(e)] ∈ ℂ by typecheck
    exact ⟨bMember, cMember⟩
  exact LFunction.three_four_one_zero with positive, character, one, onLine,
    vanish, holomorphic, holomorphicSquare, one, c0, shifted

-- Section: L(1, χ) as the sum of Σ χ(n)/n
-- ζ(s, a) = Σ_{m<M} (m + a)^(−s) + ζ(s, M + a), at every s.
theorem hurwitzZeta.shift_partial (s : Set) (a : Real) (M : Nat)
  requires positive : R[0] < a
  requires hs : s ∈ ℂ
  shows hurwitzZeta(s, a) = ℂ[complexPartialSum(hurwitzSeriesTerms(s, a), M) +
    hurwitzZeta(s, R[realNat(M) + a])]
proof
  induction M
  | zero =>
    have start : R[realNat(0) + a] = a
      rw realNat.zero
      ring
    have zeta := hurwitzZeta.member at s, a with hs
    rw [complexPartialSum.zero, start]
    ring
  | succ(m) using ih =>
    have mMember : m ∈ ℕ := nat.omega.forward at m with *
    have mNonnegative := realNat.nonnegative at m
    have shiftedPositive : R[0] < R[realNat(m) + a] by linarith
    have shift := hurwitzZeta.shift with shiftedPositive, hs
    have next : R[realNat(m) + a + 1] = R[realNat(succ(m)) + a]
      rw realNat.succ_add
      ring
    rw next at shift
    have terms := hurwitzSeriesTerms.function at s, a with hs
    have sequence : ComplexSequence(hurwitzSeriesTerms(s, a)) by exact terms
    have previous := complexPartialSum.member at hurwitzSeriesTerms(s, a), m
      with sequence
    have negative : ℂ[-s] ∈ ℂ by typecheck
    have power := realCpow.member at R[realNat(m) + a], ℂ[-s] with negative
    have zetaNext := hurwitzZeta.member at s, R[realNat(succ(m)) + a] with hs
    rw [ih, shift, complexPartialSum.succ,
      (hurwitzSeriesTerms.value at s, a, m with hs)]
    ring

-- The terms χ(j + 1) ζ(s, M + (j + 1)/N) of the tail after M N terms.
defgraph lTailTerms (N : Nat, χ s : Set, M : Nat) (j ∈ ℕ) : complexCarrier :=
  ℂ[χ(integerOfNat(j + 1)) *
    hurwitzZeta(s, R[realNat(M) + realNat(j + 1) / realNat(N)])]
requires values : FunctionBetween(χ, ℤ, complexCarrier)
requires hs : s ∈ complexCarrier
proof
  have jNat := nat.omega.backward with member
  have index : integerOfNat(j + 1) ∈ ℤ by typecheck
  have value := FunctionBetween.apply_closed with values, index
  have zeta := hurwitzZeta.member at s,
    R[realNat(M) + realNat(j + 1) / realNat(N)] with hs
  typecheck

-- One column step: the tail at M is the column sum at M plus the tail at
-- M + 1.
theorem lTailTerms.step (N : Nat) (χ s : Set) (M J : Nat)
  requires positive : 1 ≤ N
  requires values : FunctionBetween(χ, ℤ, complexCarrier)
  requires hs : s ∈ ℂ
  shows ℂ[realCpow(realNat(N), ℂ[-s]) *
      complexPartialSum(lTailTerms(N, χ, s, M), J)] =
    ℂ[lColumnPartial(N, χ, s, J)(M) + realCpow(realNat(N), ℂ[-s]) *
      complexPartialSum(lTailTerms(N, χ, s, succ(M)), J)]
proof
  have negative : ℂ[-s] ∈ ℂ by typecheck
  have power := realCpow.member at realNat(N), ℂ[-s] with negative
  have mMember : M ∈ ℕ := nat.omega.forward at M with *
  induction J
  | zero =>
    rw [complexPartialSum.zero, complexPartialSum.zero,
      (lColumnPartial.value at N, χ, s, 0, M with values, hs),
      complexPartialSum.zero]
    ring
  | succ(j) using ih =>
    have jMember : j ∈ ℕ := nat.omega.forward at j with *
    have index : integerOfNat(j + 1) ∈ ℤ by typecheck
    have value := FunctionBetween.apply_closed with values, index
    have numerator : R[0] < realNat(j + 1)
      have nonzero : j + 1 ≠ (0:N) by arith
      exact realNat.positive with nonzero
    have denominator : R[0] < realNat(N)
      have nonzero : N ≠ (0:N) by arith
      exact realNat.positive with nonzero
    have point := real.div_positive with numerator, denominator
    have shifted := hurwitzZeta.shift_partial at s,
      R[realNat(j + 1) / realNat(N)], succ(M) with point, hs
    have shiftedM := hurwitzZeta.shift_partial at s,
      R[realNat(j + 1) / realNat(N)], M with point, hs
    have terms := hurwitzSeriesTerms.function at s,
      R[realNat(j + 1) / realNat(N)] with hs
    have sequence : ComplexSequence(hurwitzSeriesTerms(s,
      R[realNat(j + 1) / realNat(N)])) by exact terms
    rw [complexPartialSum.succ, shiftedM] at shifted
    have tailSequence := lTailTerms.function at N, χ, s, M with values, hs
    have tailSequenceNext := lTailTerms.function at N, χ, s, succ(M) with
      values, hs
    have stepSequence := lColumnStep.function at N, χ, s, M with values, hs
    have tailSum := complexPartialSum.member at lTailTerms(N, χ, s, M), j with
      tailSequence
    have tailSumNext := complexPartialSum.member at
      lTailTerms(N, χ, s, succ(M)), j with tailSequenceNext
    have stepSum := complexPartialSum.member at lColumnStep(N, χ, s, M), j with
      stepSequence
    have partialM := complexPartialSum.member at hurwitzSeriesTerms(s,
      R[realNat(j + 1) / realNat(N)]), M with sequence
    have term := FunctionBetween.apply_closed with terms, mMember
    have zetaM := hurwitzZeta.member at s,
      R[realNat(M) + realNat(j + 1) / realNat(N)] with hs
    have zetaNext := hurwitzZeta.member at s,
      R[realNat(succ(M)) + realNat(j + 1) / realNat(N)] with hs
    rw (lColumnPartial.value at N, χ, s, j, M with values, hs) at ih
    rw [complexPartialSum.succ, complexPartialSum.succ,
      (lColumnPartial.value at N, χ, s, succ(j), M with values, hs),
      complexPartialSum.succ, (lTailTerms.value at N, χ, s, M, j with values,
      hs, jMember), (lTailTerms.value at N, χ, s, succ(M), j with values, hs,
      jMember), (lColumnStep.value at N, χ, s, M, j with values, hs, jMember)]
    linear_combination ih + χ(integerOfNat(j + 1)) *
      realCpow(realNat(N), ℂ[-s]) * shifted

-- L(s, χ) = Σ_{k<MN} χ(k + 1)(k + 1)^(−s) + N^(−s) Σ_{j<N} χ(j + 1)
-- ζ(s, M + (j + 1)/N), at every s.
theorem LFunction.tail (N : Nat) (χ s : Set) (M : Nat)
  requires positive : 1 ≤ N
  requires character : DirichletCharacter(N, χ)
  requires hs : s ∈ ℂ
  shows LFunction(N, χ, s) =
    ℂ[complexPartialSum(dirichletSeriesTerms(χ, s), M * N) +
      realCpow(realNat(N), ℂ[-s]) *
        complexPartialSum(lTailTerms(N, χ, s, M), N)]
proof
  have values := DirichletCharacter.function with character
  have negative : ℂ[-s] ∈ ℂ by typecheck
  have power := realCpow.member at realNat(N), ℂ[-s] with negative
  induction M
  | zero =>
    have start := lTailTerms.function at N, χ, s, 0 with values, hs
    have terms := lFunctionTerms.function at N, χ, s with values, hs
    have same : lTailTerms(N, χ, s, 0) = lFunctionTerms(N, χ, s)
      apply FunctionBetween.ext with start, terms
      intros j jMember
      have jNat := nat.omega.backward with jMember
      have point : R[realNat(0) + realNat(j + 1) / realNat(N)] =
          R[realNat(j + 1) / realNat(N)]
        rw realNat.zero
        ring
      rw [(lTailTerms.value at N, χ, s, 0, j with values, hs, jMember),
        (lFunctionTerms.value at N, χ, s, j with values, hs, jMember), point]
    have zero : (0:N) * N = (0:N) by arith
    have sequence : ComplexSequence(lFunctionTerms(N, χ, s)) by exact terms
    have sum := complexPartialSum.member at lFunctionTerms(N, χ, s), N with
      sequence
    unfold LFunction
    rw [same, zero, complexPartialSum.zero]
    ring
  | succ(m) using ih =>
    have step := lTailTerms.step at N, χ, s, m, N with positive, values, hs
    have blocks := dirichletSeriesTerms.blocks at N, χ, s, succ(m) with
      positive, character, hs
    have blocksM := dirichletSeriesTerms.blocks at N, χ, s, m with
      positive, character, hs
    have columns := lColumnPartial.function at N, χ, s, N with values, hs
    have columnSequence : ComplexSequence(lColumnPartial(N, χ, s, N))
      by exact columns
    have columnSum := complexPartialSum.member at lColumnPartial(N, χ, s, N),
      m with columnSequence
    have mMember : m ∈ ℕ := nat.omega.forward at m with *
    have column := FunctionBetween.apply_closed with columns, mMember
    have tails := lTailTerms.function at N, χ, s, succ(m) with values, hs
    have tailSequence : ComplexSequence(lTailTerms(N, χ, s, succ(m)))
      by exact tails
    have tailSum := complexPartialSum.member at lTailTerms(N, χ, s, succ(m)),
      N with tailSequence
    rw [blocksM] at ih
    rw [blocks, complexPartialSum.succ, ih, step]
    ring

-- For real S > 1, re ζ(S, ·) is antitone on (0, ∞): term by term.
theorem hurwitzZeta.re_antitone (S a b : Real)
  requires halfPlane : R[1] < S
  requires positive : R[0] < a
  requires ordered : a ≤ b
  shows (complexRe(hurwitzZeta(complexOfReal(S), b)):R) ≤
    (complexRe(hurwitzZeta(complexOfReal(S), a)):R)
proof
  have hs := complexOfReal.mem at S
  have positiveB : R[0] < b by linarith
  have re : realOne < complexRe(complexOfReal(S))
    rw complexOfReal.re
    exact halfPlane
  obtain ⟨sumsA, _⟩ := hurwitzZeta.series at complexOfReal(S), a with
    positive, hs, re
  obtain ⟨sumsB, _⟩ := hurwitzZeta.series at complexOfReal(S), b with
    positiveB, hs, re
  have realA := ComplexSumsTo.re with sumsA
  have realB := ComplexSumsTo.re with sumsB
  have below : PointwiseLE(complexSequenceX(hurwitzSeriesTerms(
      complexOfReal(S), b)), complexSequenceX(hurwitzSeriesTerms(
      complexOfReal(S), a)))
    intros n nMember
    apply realLe.characterization.forward
    have nNat := nat.omega.backward with nMember
    have termsA := hurwitzSeriesTerms.function at complexOfReal(S), a with hs
    have termsB := hurwitzSeriesTerms.function at complexOfReal(S), b with hs
    have sequenceA : ComplexSequence(hurwitzSeriesTerms(complexOfReal(S), a))
      by exact termsA
    have sequenceB : ComplexSequence(hurwitzSeriesTerms(complexOfReal(S), b))
      by exact termsB
    have exponent : ℂ[-complexOfReal(S)] = complexOfReal(R[-S])
      rw complexOfReal.neg
    have nonnegative := realNat.nonnegative at n
    have baseA : R[0] < R[realNat(n) + a] by linarith
    have pointA := complexOfReal.mem at realRpow(R[realNat(n) + a], R[-S])
    have pointB := complexOfReal.mem at realRpow(R[realNat(n) + b], R[-S])
    rw [(complexSequenceX.value with sequenceA, nMember),
      (complexSequenceX.value with sequenceB, nMember),
      (hurwitzSeriesTerms.value at complexOfReal(S), a, n with hs),
      (hurwitzSeriesTerms.value at complexOfReal(S), b, n with hs), exponent,
      realCpow.of_real, realCpow.of_real, (complexRe.x with pointA),
      (complexRe.x with pointB), complexOfReal.re, complexOfReal.re]
    by_cases same : a = b
    . rw same
      exact realLe.reflexive
    . have less : a < b
        by_contra notLess
        have reverse : b ≤ a by linarith
        exact same with (realLe.antisymmetric with ordered, reverse)
      have bases : R[realNat(n) + a] < R[realNat(n) + b] by linarith
      have negativeS : R[-S] < R[0] by linarith
      have strict := realRpow.lt_of_base_neg with baseA, bases, negativeS
      exact realLess.implies_le with strict
  have compared := SumsTo.le_of_le_terms with realB, realA, below
  have zetaA := hurwitzZeta.member at complexOfReal(S), a with hs
  have zetaB := hurwitzZeta.member at complexOfReal(S), b with hs
  have reA := complexRe.real with zetaA
  have reB := complexRe.real with zetaB
  linarith

-- The constant term at the pole is antitone too: re ζ_reg(b) ≤ re ζ_reg(a)
-- for 0 < a ≤ b, as the limit of re (ζ(S, ·) − 1/(S − 1)) as S → 1⁺.
theorem hurwitzZeta.regular_antitone (a b : Real)
  requires positive : R[0] < a
  requires ordered : a ≤ b
  shows (complexRe(hurwitzZeta.regular(b)):R) ≤
    (complexRe(hurwitzZeta.regular(a)):R)
proof
  have positiveB : R[0] < b by linarith
  have regularA := hurwitzRegularEulerMaclaurin.closed at 1, a
  have regularB := hurwitzRegularEulerMaclaurin.closed at 1, b
  unfold hurwitzZeta.regular
  have reA := complexRe.real with regularA
  have reB := complexRe.real with regularB
  apply real.le_of_forall_lt
  intros e eMember ePositive
  have eReal : Real(e) by exact eMember
  have halfPositive : R[0] < R[e / 2] by linarith
  have halfMember : R[e / 2] ∈ ℝ by typecheck
  obtain ⟨dA, dAMember, dAPositive, nearA⟩ := hurwitzZeta.pole at a with
    positive, R[e / 2], halfMember, halfPositive
  obtain ⟨dB, dBMember, dBPositive, nearB⟩ := hurwitzZeta.pole at b with
    positiveB, R[e / 2], halfMember, halfPositive
  have dAReal : Real(dA) by exact dAMember
  have dBReal : Real(dB) by exact dBMember
  have exists : ∃ t ∈ ℝ, R[0] < t ∧ t < dA ∧ t < dB
    by_cases smaller : dA ≤ dB
    . have tMember : R[dA / 2] ∈ ℝ by typecheck
      refine ⟨R[dA / 2], tMember, ?_, ?_, ?_⟩
      . linarith
      . linarith
      . linarith
    . have tMember : R[dB / 2] ∈ ℝ by typecheck
      refine ⟨R[dB / 2], tMember, ?_, ?_, ?_⟩
      . linarith
      . linarith
      . linarith
  obtain ⟨t, tMember, tPositive, tBelowA, tBelowB⟩ := exists
  have tReal : Real(t) by exact tMember
  have sMember := complexOfReal.mem at R[1 + t]
  have tComplex := complexOfReal.mem at t
  have shift : ℂ[complexOfReal(R[1 + t]) - 1] = complexOfReal(t)
    rw [complexOfReal.add, complexOfReal.one]
    ring
  have tNonnegative : R[0] ≤ t by linarith
  have distance : complexAbs(ℂ[complexOfReal(R[1 + t]) - 1]) = t
    rw [shift, complexAbs.of_real, (abs.of_nonnegative with tNonnegative)]
  have notOne : complexOfReal(R[1 + t]) ≠ ℂ[1]
    intro same
    have re := complexOfReal.re at R[1 + t]
    rw [same, ← complexOfReal.one, complexOfReal.re] at re
    linarith
  have smallA : complexAbs(ℂ[complexOfReal(R[1 + t]) - 1]) < dA
    rw distance
    exact tBelowA
  have smallB : complexAbs(ℂ[complexOfReal(R[1 + t]) - 1]) < dB
    rw distance
    exact tBelowB
  have closeA := nearA with complexOfReal(R[1 + t]), sMember, notOne, smallA
  have closeB := nearB with complexOfReal(R[1 + t]), sMember, notOne, smallB
  have one := complexOne.member
  have shifted : ℂ[complexOfReal(R[1 + t]) - 1] ∈ ℂ by typecheck
  have inverse := complexInv.member with shifted
  have pole : complexDiv(ℂ[1], ℂ[complexOfReal(R[1 + t]) - 1]) ∈ ℂ
    unfold complexDiv
    typecheck
  have zetaA := hurwitzZeta.member at complexOfReal(R[1 + t]), a with sMember
  have zetaB := hurwitzZeta.member at complexOfReal(R[1 + t]), b with sMember
  have offA : ℂ[hurwitzZeta(complexOfReal(R[1 + t]), a) -
    complexDiv(ℂ[1], ℂ[complexOfReal(R[1 + t]) - 1])] ∈ ℂ by typecheck
  have offB : ℂ[hurwitzZeta(complexOfReal(R[1 + t]), b) -
    complexDiv(ℂ[1], ℂ[complexOfReal(R[1 + t]) - 1])] ∈ ℂ by typecheck
  unfold hurwitzZeta.regular at closeA
  unfold hurwitzZeta.regular at closeB
  have boundA := complexRe.sub_bound with offA, regularA
  have boundB := complexRe.sub_bound with regularB, offB
  have symmetric := complexAbs.dist_symm with regularB, offB
  rw symmetric at boundB
  rw [(complexRe.sub with zetaA, pole)] at boundA
  rw [(complexRe.sub with zetaB, pole)] at boundB
  have aboveOne : R[1] < R[1 + t] by linarith
  have antitone := hurwitzZeta.re_antitone with aboveOne, positive, ordered
  have zetaReA := complexRe.real with zetaA
  have zetaReB := complexRe.real with zetaB
  have poleRe := complexRe.real with pole
  linarith

-- The constant term is a real number.
theorem hurwitzZeta.regular_of_real (a : Real)
  shows hurwitzZeta.regular(a) =
    complexOfReal(complexRe(hurwitzZeta.regular(a)))
proof
  have member := hurwitzRegularEulerMaclaurin.closed at 1, a
  have imaginary := hurwitzZeta.regular_real at a
  unfold hurwitzZeta.regular at imaginary
  unfold hurwitzZeta.regular
  have reReal := complexRe.real with member
  have point := complexOfReal.mem at
    complexRe(hurwitzRegularEulerMaclaurin(1, a))
  apply complex.eq_of_parts with member, point
  . rw complexOfReal.re
  . rw [complexOfReal.im, imaginary]

-- ζ_reg(M) = 1/M + ζ_reg(M + 1), in real parts, for M ≥ 1.
theorem hurwitzZeta.regular_shift (M : Nat)
  requires positive : 1 ≤ M
  shows (complexRe(hurwitzZeta.regular(realNat(M))):R) =
    R[1 / realNat(M) + complexRe(hurwitzZeta.regular(R[realNat(M) + 1]))]
proof
  have mPositive : R[0] < realNat(M)
    have nonzero : M ≠ (0:N) by arith
    exact realNat.positive with nonzero
  have one := complexOne.member
  have shift := hurwitzZeta.shift at ℂ[1], realNat(M) with mPositive, one
  rw [hurwitzZeta.at_one, hurwitzZeta.at_one] at shift
  have minus : ℂ[-1] = complexOfReal(R[-1])
    rw [complexOfReal.neg, complexOfReal.one]
  rw [minus, realCpow.of_real, (realRpow.neg with mPositive),
    (realRpow.one with mPositive)] at shift
  have power := complexOfReal.mem at R[1 / realNat(M)]
  have next := hurwitzRegularEulerMaclaurin.closed at 1, R[realNat(M) + 1]
  have nextMember : hurwitzZeta.regular(R[realNat(M) + 1]) ∈ ℂ
    unfold hurwitzZeta.regular
    exact next
  rw [shift, (complexRe.add with power, nextMember), complexOfReal.re]

-- 0 ≤ ζ_reg(M + b) − ζ_reg(M + 1) ≤ 1/M for M ≥ 1 and 0 < b ≤ 1.
theorem hurwitzZeta.regular_step (M : Nat) (b : Real)
  requires positiveM : 1 ≤ M
  requires positiveB : R[0] < b
  requires atMostOne : b ≤ R[1]
  shows complexAbs(ℂ[hurwitzZeta.regular(R[realNat(M) + b]) -
    hurwitzZeta.regular(R[realNat(M) + 1])]) ≤ R[1 / realNat(M)]
proof
  have mPositive : R[0] < realNat(M)
    have nonzero : M ≠ (0:N) by arith
    exact realNat.positive with nonzero
  have pointPositive : R[0] < R[realNat(M) + b] by linarith
  have upper : R[realNat(M) + b] ≤ R[realNat(M) + 1] by linarith
  have lower : realNat(M) ≤ R[realNat(M) + b] by linarith
  have first := hurwitzZeta.regular_antitone with pointPositive, upper
  have second := hurwitzZeta.regular_antitone with mPositive, lower
  have shift := hurwitzZeta.regular_shift with positiveM
  have x := hurwitzRegularEulerMaclaurin.closed at 1, R[realNat(M) + b]
  have y := hurwitzRegularEulerMaclaurin.closed at 1, R[realNat(M) + 1]
  have z := hurwitzRegularEulerMaclaurin.closed at 1, realNat(M)
  have xReal := complexRe.real with x
  have yReal := complexRe.real with y
  have zReal := complexRe.real with z
  rw [(hurwitzZeta.regular_of_real at R[realNat(M) + b]),
    (hurwitzZeta.regular_of_real at R[realNat(M) + 1])]
  unfold hurwitzZeta.regular at first
  unfold hurwitzZeta.regular at second
  unfold hurwitzZeta.regular at shift
  unfold hurwitzZeta.regular
  rw [← complexOfReal.sub, complexAbs.of_real]
  have nonnegative : R[0] ≤ R[complexRe(hurwitzRegularEulerMaclaurin(1,
    R[realNat(M) + b])) - complexRe(hurwitzRegularEulerMaclaurin(1,
    R[realNat(M) + 1]))] by linarith
  rw (abs.of_nonnegative with nonnegative)
  linarith

-- A/B ≤ 1 for 0 < B and A ≤ B.
theorem real.div_le_one (A B : Real)
  requires positive : R[0] < B
  requires below : A ≤ B
  shows R[A / B] ≤ R[1]
proof
  have nonzero : B ≠ R[0] by linarith
  have cancel := realDiv.mul_right at A, B with nonzero
  have quotientReal : Real(R[A / B]) by typecheck
  by_contra above
  have greater : R[1] < R[A / B] by linarith
  have excess : R[0] < R[A / B - 1] by linarith
  have product := realLess.mul_left_of_positive with positive, excess
  have zero : R[(A / B - 1) * 0] = R[0] by ring
  have expand : R[(A / B - 1) * B] = R[A / B * B - B] by ring
  linarith

-- Σ_{j<J} χ(j + 1) (ζ_reg(M + (j + 1)/N) − ζ_reg(M + 1)) is at most J/M in
-- absolute value, for J ≤ N.
theorem lTailTerms.one_bound (N : Nat) (χ : Set) (M J : Nat)
  requires positive : 1 ≤ N
  requires character : DirichletCharacter(N, χ)
  requires positiveM : 1 ≤ M
  shows J ≤ N → complexAbs(ℂ[complexPartialSum(lTailTerms(N, χ, ℂ[1], M), J) -
    hurwitzZeta.regular(R[realNat(M) + 1]) *
      complexPartialSum(characterSuccValues(χ), J)]) ≤ R[realNat(J) / realNat(M)]
proof
  induction J
  | zero =>
    intro below
    have regular := hurwitzRegularEulerMaclaurin.closed at 1, R[realNat(M) + 1]
    have regularMember : hurwitzZeta.regular(R[realNat(M) + 1]) ∈ ℂ
      unfold hurwitzZeta.regular
      exact regular
    have zero : complexAbs(ℂ[0 - hurwitzZeta.regular(R[realNat(M) + 1]) * 0])
        = R[0]
      have same : ℂ[0 - hurwitzZeta.regular(R[realNat(M) + 1]) * 0] = ℂ[0]
        by ring
      rw [same, ← complexOfReal.zero, complexAbs.of_real, abs.zero]
    have quotient : R[realNat(0) / realNat(M)] = R[0]
      rw [realNat.zero, realDiv.eq_mul_inv]
      have inverse := realInvValue.real at realNat(M)
      ring
    rw [complexPartialSum.zero, complexPartialSum.zero, zero, quotient]
    exact realLe.reflexive
  | succ(j) using ih =>
    intro below
    have values := DirichletCharacter.function with character
    have one := complexOne.member
    have positiveN : 0 < N by arith
    have mPositive : R[0] < realNat(M)
      have nonzero : M ≠ (0:N) by arith
      exact realNat.positive with nonzero
    have nPositive : R[0] < realNat(N)
      have nonzero : N ≠ (0:N) by arith
      exact realNat.positive with nonzero
    have regular := hurwitzRegularEulerMaclaurin.closed at 1, R[realNat(M) + 1]
    have regularMember : hurwitzZeta.regular(R[realNat(M) + 1]) ∈ ℂ
      unfold hurwitzZeta.regular
      exact regular
    have tails := lTailTerms.function at N, χ, ℂ[1], M with values, one
    have tailSequence : ComplexSequence(lTailTerms(N, χ, ℂ[1], M))
      by exact tails
    have shifts := characterSuccValues.function with values
    have shiftSequence : ComplexSequence(characterSuccValues(χ)) by exact shifts
    have earlier : j ≤ N by arith
    have previous := ih with earlier
    have jMember : j ∈ ℕ := nat.omega.forward at j with *
    have index : integerOfNat(j + 1) ∈ ℤ by typecheck
    have value := FunctionBetween.apply_closed with values, index
    have numerator : R[0] < realNat(j + 1)
      have nonzero : j + 1 ≠ (0:N) by arith
      exact realNat.positive with nonzero
    have point := real.div_positive with numerator, nPositive
    have atMost : j + 1 ≤ N by arith
    have numeratorBelow := realNat.le_of_natural_le with atMost
    have pointBelow := real.div_le_one with nPositive, numeratorBelow
    have step := hurwitzZeta.regular_step with positiveM, point, pointBelow
    have characterBound := DirichletCharacter.abs_le_one with character,
      positiveN, index
    have pointRegular := hurwitzRegularEulerMaclaurin.closed at 1,
      R[realNat(M) + realNat(j + 1) / realNat(N)]
    have pointMember : hurwitzZeta.regular(R[realNat(M) +
        realNat(j + 1) / realNat(N)]) ∈ ℂ
      unfold hurwitzZeta.regular
      exact pointRegular
    have difference : ℂ[hurwitzZeta.regular(R[realNat(M) +
      realNat(j + 1) / realNat(N)]) - hurwitzZeta.regular(R[realNat(M) + 1])]
      ∈ ℂ by typecheck
    have tailSum := complexPartialSum.member at lTailTerms(N, χ, ℂ[1], M), j
      with tailSequence
    have shiftSum := complexPartialSum.member at characterSuccValues(χ), j with
      shiftSequence
    have rest : ℂ[complexPartialSum(lTailTerms(N, χ, ℂ[1], M), j) -
      hurwitzZeta.regular(R[realNat(M) + 1]) *
      complexPartialSum(characterSuccValues(χ), j)] ∈ ℂ by typecheck
    have term : ℂ[χ(integerOfNat(j + 1)) * (hurwitzZeta.regular(R[realNat(M) +
      realNat(j + 1) / realNat(N)]) - hurwitzZeta.regular(R[realNat(M) + 1]))]
      ∈ ℂ by typecheck
    have regroup : ℂ[complexPartialSum(lTailTerms(N, χ, ℂ[1], M), succ(j)) -
        hurwitzZeta.regular(R[realNat(M) + 1]) *
        complexPartialSum(characterSuccValues(χ), succ(j))] =
      ℂ[ℂ[complexPartialSum(lTailTerms(N, χ, ℂ[1], M), j) -
        hurwitzZeta.regular(R[realNat(M) + 1]) *
        complexPartialSum(characterSuccValues(χ), j)] +
        χ(integerOfNat(j + 1)) * (hurwitzZeta.regular(R[realNat(M) +
        realNat(j + 1) / realNat(N)]) - hurwitzZeta.regular(R[realNat(M) + 1]))]
      rw [complexPartialSum.succ, complexPartialSum.succ,
        (lTailTerms.value at N, χ, ℂ[1], M, j with values, one, jMember),
        (characterSuccValues.value with values, jMember), hurwitzZeta.at_one]
      ring
    have triangle := complexAbs.triangle with rest, term
    rw [(complexAbs.mul with value, difference)] at triangle
    have differenceAbs := complexAbs.nonnegative with difference
    have characterAbs := complexAbs.nonnegative with value
    have differenceReal := complexAbs.real with difference
    have characterReal := complexAbs.real with value
    have scaled := realLe.mul_right_of_nonnegative with characterBound,
      differenceAbs
    have quotient : R[realNat(succ(j)) / realNat(M)] =
        R[realNat(j) / realNat(M) + 1 / realNat(M)]
      rw [realNat.succ_add, realDiv.eq_mul_inv, realDiv.eq_mul_inv,
        realDiv.eq_mul_inv]
      have inverse := realInvValue.real at realNat(M)
      ring
    have oneQuotient : Real(R[1 / realNat(M)]) by typecheck
    have jQuotient : Real(R[realNat(j) / realNat(M)]) by typecheck
    have restReal := complexAbs.real with rest
    have termReal := complexAbs.real with term
    rw [regroup, quotient]
    have unit : R[1 * complexAbs(ℂ[hurwitzZeta.regular(R[realNat(M) +
      realNat(j + 1) / realNat(N)]) - hurwitzZeta.regular(R[realNat(M) + 1])])]
      = complexAbs(ℂ[hurwitzZeta.regular(R[realNat(M) +
      realNat(j + 1) / realNat(N)]) - hurwitzZeta.regular(R[realNat(M) + 1])])
      by ring
    linarith

-- For χ non-principal and M ≥ 1, the partial sum of Σ χ(n)/n to M N is
-- within 1/M of L(1, χ).
theorem LFunction.one_partial (N : Nat) (χ : Set) (M : Nat)
  requires positive : 1 ≤ N
  requires character : DirichletCharacter(N, χ)
  requires nonPrincipal : χ ≠ principalCharacter(N)
  requires positiveM : 1 ≤ M
  shows complexAbs(ℂ[LFunction(N, χ, ℂ[1]) -
    complexPartialSum(dirichletSeriesTerms(χ, ℂ[1]), M * N)]) ≤
    R[1 / realNat(M)]
proof
  have values := DirichletCharacter.function with character
  have one := complexOne.member
  have positiveN : 0 < N by arith
  have mPositive : R[0] < realNat(M)
    have nonzero : M ≠ (0:N) by arith
    exact realNat.positive with nonzero
  have nPositive : R[0] < realNat(N)
    have nonzero : N ≠ (0:N) by arith
    exact realNat.positive with nonzero
  have tail := LFunction.tail at N, χ, ℂ[1], M with positive, character, one
  have atMost : N ≤ N by arith
  have bound := lTailTerms.one_bound at N, χ, M, N with positive, character,
    positiveM, atMost
  rw [(characterSuccValues.sum with character), (characterSum.non_principal with
    character, positiveN, nonPrincipal)] at bound
  have regular := hurwitzRegularEulerMaclaurin.closed at 1, R[realNat(M) + 1]
  have regularMember : hurwitzZeta.regular(R[realNat(M) + 1]) ∈ ℂ
    unfold hurwitzZeta.regular
    exact regular
  have tails := lTailTerms.function at N, χ, ℂ[1], M with values, one
  have tailSequence : ComplexSequence(lTailTerms(N, χ, ℂ[1], M))
    by exact tails
  have tailSum := complexPartialSum.member at lTailTerms(N, χ, ℂ[1], M), N
    with tailSequence
  have terms := dirichletSeriesTerms.function at χ, ℂ[1] with values, one
  have sequence : ComplexSequence(dirichletSeriesTerms(χ, ℂ[1]))
    by exact terms
  have partial := complexPartialSum.member at dirichletSeriesTerms(χ, ℂ[1]),
    M * N with sequence
  have clean : ℂ[complexPartialSum(lTailTerms(N, χ, ℂ[1], M), N) -
      hurwitzZeta.regular(R[realNat(M) + 1]) * complexZero] =
      complexPartialSum(lTailTerms(N, χ, ℂ[1], M), N)
    ring
  rw clean at bound
  have minus : ℂ[-1] = complexOfReal(R[-1])
    rw [complexOfReal.neg, complexOfReal.one]
  rw [minus, realCpow.of_real, (realRpow.neg with nPositive),
    (realRpow.one with nPositive)] at tail
  have scale := complexOfReal.mem at R[1 / realNat(N)]
  have difference : ℂ[LFunction(N, χ, ℂ[1]) -
      complexPartialSum(dirichletSeriesTerms(χ, ℂ[1]), M * N)] =
      ℂ[complexOfReal(R[1 / realNat(N)]) *
        complexPartialSum(lTailTerms(N, χ, ℂ[1], M), N)]
    rw tail
    ring
  rw [difference, (complexAbs.mul with scale, tailSum), complexAbs.of_real]
  have unitPositive : R[0] < R[1] by linarith
  have quotient := real.div_positive with unitPositive, nPositive
  have scaleNonnegative : R[0] ≤ R[1 / realNat(N)] by linarith
  rw (abs.of_nonnegative with scaleNonnegative)
  have scaled := realLe.mul_left_of_nonnegative with bound, scaleNonnegative
  have nNonzero : realNat(N) ≠ R[0] by linarith
  have cancel := realDiv.mul_right at R[1], realNat(N) with nNonzero
  have target : R[1 / realNat(N) * (realNat(N) / realNat(M))] =
      R[1 / realNat(M)]
    have inverseM := realInvValue.real at realNat(M)
    rw [(realDiv.eq_mul_inv at realNat(N), realNat(M)),
      (realDiv.eq_mul_inv at R[1], realNat(M))]
    linear_combination realInvValue(realNat(M)) * cancel
  linarith

-- Section: Real characters
-- A real character: χ² principal makes each value 0, 1 or −1.
theorem characterSquare.values (N : Nat) (χ a : Set)
  requires character : DirichletCharacter(N, χ)
  requires square : characterSquare(χ) = principalCharacter(N)
  requires integer : a ∈ ℤ
  shows χ(a) = complexOfReal(complexRe(χ(a))) ∧
    (complexRe(χ(a)) = R[0] ∨ complexRe(χ(a)) = R[1] ∨
      complexRe(χ(a)) = R[-1])
proof
  have values := DirichletCharacter.function with character
  have value := FunctionBetween.apply_closed with values, integer
  have squared := characterSquare.value with values, integer
  rw square at squared
  have reSquare := complexRe.mul with value, value
  have imSquare := complexIm.mul with value, value
  rw ← squared at reSquare
  rw ← squared at imSquare
  have x := complexRe.real with value
  have y := complexIm.real with value
  have xx := NonnegativeReal.le with
    (realMulValue.square_nonnegative_real at complexRe(χ(a)))
  have yy := NonnegativeReal.le with
    (realMulValue.square_nonnegative_real at complexIm(χ(a)))
  -- The principal value c is 0 or 1: re c = x² − y², im c = 2 x y = 0.
  have cases : (R[complexRe(χ(a)) * complexRe(χ(a)) -
      complexIm(χ(a)) * complexIm(χ(a))] = R[0] ∨
      R[complexRe(χ(a)) * complexRe(χ(a)) -
      complexIm(χ(a)) * complexIm(χ(a))] = R[1]) ∧
      R[complexRe(χ(a)) * complexIm(χ(a)) +
      complexIm(χ(a)) * complexRe(χ(a))] = R[0]
    by_cases coprime : IntegerCoprime(a, integerOfNat(N))
    . have unit := principalCharacter.coprime with integer, coprime
      rw unit at reSquare
      rw unit at imSquare
      rw [← complexOfReal.one, complexOfReal.re] at reSquare
      rw [← complexOfReal.one, complexOfReal.im] at imSquare
      refine ⟨?_, ?_⟩
      . right
        rw ← reSquare
      . rw ← imSquare
    . have zero := principalCharacter.not_coprime with integer, coprime
      rw zero at reSquare
      rw zero at imSquare
      rw [← complexOfReal.zero, complexOfReal.re] at reSquare
      rw [← complexOfReal.zero, complexOfReal.im] at imSquare
      refine ⟨?_, ?_⟩
      . left
        rw ← reSquare
      . rw ← imSquare
  obtain ⟨realCases, imaginary⟩ := cases
  have twice : R[2 * (complexRe(χ(a)) * complexIm(χ(a)))] = R[0]
    by linear_combination imaginary
  have product : R[complexRe(χ(a)) * complexIm(χ(a))] = R[0] by linarith
  have imaginaryZero : complexIm(χ(a)) = R[0]
    have split := realMulValue.eq_zero_or with product
    cases split with xZero | yZero
    . have xxZero : R[complexRe(χ(a)) * complexRe(χ(a))] = R[0]
        rw xZero
        ring
      have yySmall : R[complexIm(χ(a)) * complexIm(χ(a))] ≤ R[0]
        cases realCases with zero | one
        . linarith
        . linarith
      have yyZero : R[complexIm(χ(a)) * complexIm(χ(a))] = R[0] by linarith
      have again := realMulValue.eq_zero_or with yyZero
      cases again with first | second
      . exact first
      . exact second
    . exact yZero
  rw imaginaryZero at realCases
  have point := complexOfReal.mem at complexRe(χ(a))
  have same : χ(a) = complexOfReal(complexRe(χ(a)))
    apply complex.eq_of_parts with value, point
    . rw complexOfReal.re
    . rw [complexOfReal.im, imaginaryZero]
  refine ⟨same, ?_⟩
  cases realCases with zero | one
  . left
    have squareZero : R[complexRe(χ(a)) * complexRe(χ(a))] = R[0]
      by linear_combination zero
    have split := realMulValue.eq_zero_or with squareZero
    cases split with first | second
    . exact first
    . exact second
  . right
    have factored : R[(complexRe(χ(a)) - 1) * (complexRe(χ(a)) + 1)] = R[0]
      by linear_combination one
    have split := realMulValue.eq_zero_or with factored
    cases split with minus | plus
    . left
      linarith
    . right
      linarith

-- Section: square roots of consecutive naturals
-- With a = √J, b = √(J + 1): b² = a² + 1.
-- 1/b ≤ 2(b − a).
theorem sqrtStep.lower (a b : Real)
  requires nonnegativeA : R[0] ≤ a
  requires positiveB : R[0] < b
  requires step : R[b * b] = R[a * a + 1]
  shows realInvValue(b) ≤ R[2 * (b - a)]
proof
  have square : R[0] ≤ R[(b - a) * (b - a)] := NonnegativeReal.le with
    (realMulValue.square_nonnegative_real at R[b - a])
  have expand : R[b * (2 * (b - a)) - 1] = R[(b - a) * (b - a)]
    by linear_combination step
  have product : R[1] ≤ R[b * (2 * (b - a))] by linarith
  have inverse := realInvValue.real at b
  have nonzero : b ≠ R[0] by linarith
  have cancel := realInvValue.mul_right with nonzero
  have inversePositive := realInvValue.positive with positiveB
  have inverseNonnegative : R[0] ≤ realInvValue(b) by linarith
  have scaled := realLe.mul_left_of_nonnegative with product,
    inverseNonnegative
  have left : R[realInvValue(b) * 1] = realInvValue(b) by ring
  have right : R[realInvValue(b) * (b * (2 * (b - a)))] = R[2 * (b - a)]
    by linear_combination (2 * (b - a)) * cancel
  linarith

-- 2(b − a) ≤ 1/a for a > 0.
theorem sqrtStep.upper (a b : Real)
  requires positiveA : R[0] < a
  requires step : R[b * b] = R[a * a + 1]
  shows R[2 * (b - a)] ≤ realInvValue(a)
proof
  have square : R[0] ≤ R[(b - a) * (b - a)] := NonnegativeReal.le with
    (realMulValue.square_nonnegative_real at R[b - a])
  have expand : R[1 - a * (2 * (b - a))] = R[(b - a) * (b - a)]
    by linear_combination (-1) * step
  have product : R[a * (2 * (b - a))] ≤ R[1] by linarith
  have inverse := realInvValue.real at a
  have nonzero : a ≠ R[0] by linarith
  have cancel := realInvValue.mul_right with nonzero
  have inversePositive := realInvValue.positive with positiveA
  have inverseNonnegative : R[0] ≤ realInvValue(a) by linarith
  have scaled := realLe.mul_left_of_nonnegative with product,
    inverseNonnegative
  have left : R[realInvValue(a) * (a * (2 * (b - a)))] = R[2 * (b - a)]
    by linear_combination (2 * (b - a)) * cancel
  have right : R[realInvValue(a) * 1] = realInvValue(a) by ring
  linarith

-- 4(b − a) ≤ 1/a + 1/b for a, b > 0.
theorem sqrtStep.convex (a b : Real)
  requires positiveA : R[0] < a
  requires positiveB : R[0] < b
  requires step : R[b * b] = R[a * a + 1]
  shows R[4 * (b - a)] ≤ R[realInvValue(a) + realInvValue(b)]
proof
  -- (a + b) − 4ab(b − a) = (a + b)(b − a)((a + b) − 4ab(b − a))... with
  -- (b − a)(b + a) = 1 this is (b − a)(a − b)² ≥ 0.
  have square : R[0] ≤ R[(b - a) * (b - a)] := NonnegativeReal.le with
    (realMulValue.square_nonnegative_real at R[b - a])
  have gap : R[0] ≤ R[b - a]
    by_contra notGap
    have below : b < a by linarith
    have first := realLess.mul_left_of_positive with below, positiveB
    have second := realLess.mul_right_of_positive with below, positiveA
    linarith
  have cubic := realLe.mul_left_of_nonnegative with square, gap
  have expand : R[(a + b) - a * b * (4 * (b - a))] =
      R[(b - a) * ((b - a) * (b - a))]
    by linear_combination (-(a + b)) * step
  have zero : R[(b - a) * 0] = R[0] by ring
  have positive : R[a * b * (4 * (b - a))] ≤ R[a + b] by linarith
  have inverseA := realInvValue.real at a
  have inverseB := realInvValue.real at b
  have nonzeroA : a ≠ R[0] by linarith
  have nonzeroB : b ≠ R[0] by linarith
  have cancelA := realInvValue.mul_right with nonzeroA
  have cancelB := realInvValue.mul_right with nonzeroB
  have inverseAPositive := realInvValue.positive with positiveA
  have inverseBPositive := realInvValue.positive with positiveB
  have scale : R[0] ≤ R[realInvValue(a) * realInvValue(b)]
    have product := realLess.mul_left_of_positive with inverseBPositive,
      inverseAPositive
    have zeroProduct : R[realInvValue(a) * 0] = R[0] by ring
    linarith
  have scaled := realLe.mul_left_of_nonnegative with positive, scale
  have left : R[realInvValue(a) * realInvValue(b) *
      (a * b * (4 * (b - a)))] = R[4 * (b - a)]
    by linear_combination (4 * (b - a) * b * realInvValue(b)) * cancelA +
      (4 * (b - a)) * cancelB
  have right : R[realInvValue(a) * realInvValue(b) * (a + b)] =
      R[realInvValue(a) + realInvValue(b)]
    by linear_combination realInvValue(b) * cancelA +
      realInvValue(a) * cancelB
  linarith

-- The square root determined by a nonnegative root.
theorem realSqrt.eq_of_square (X T : Real)
  requires nonnegative : R[0] ≤ T
  requires square : R[T * T] = X
  shows realSqrt(X) = T
proof
  have xNonnegative : R[0] ≤ X
    have product := NonnegativeReal.le with
      (realMulValue.square_nonnegative_real at T)
    rw square at product
    exact product
  have typed := NonnegativeReal.of_le with xNonnegative
  have same := sqrt.unique with nonnegative, square
  unfold sqrt at same
  symm
  exact same

-- 1/√n, with the value 0 at n = 0.
defgraph rootInverse (n ∈ ℕ) : ℝ := realInvValue(realSqrt(realNat(n)))
proof
  have nNat := nat.omega.backward with member
  have nonnegative := realNat.nonnegative at n
  have root := realSqrt.real with nonnegative
  exact realInvValue.real at realSqrt(realNat(n))

theorem rootInverse.sequence
  shows RealSequence(rootInverse)
proof
  unfold RealSequence
  exact rootInverse.function

theorem natSqrt.zero
  shows realSqrt(realNat(0)) = R[0]
proof
  have nonnegative : R[0] ≤ R[0] by linarith
  have square : R[0 * 0] = realNat(0)
    rw realNat.zero
    ring
  exact realSqrt.eq_of_square with nonnegative, square

theorem natSqrt.one
  shows realSqrt(realNat(1)) = R[1]
proof
  have nonnegative : R[0] ≤ R[1] by linarith
  have square : R[1 * 1] = realNat(1)
    rw realNat.one
    ring
  exact realSqrt.eq_of_square with nonnegative, square

theorem rootInverse.zero
  shows rootInverse(0) = R[0]
proof
  have zeroMember : (0:N) ∈ ℕ := nat.omega.forward at (0:N) with *
  rw [(rootInverse.value with zeroMember), natSqrt.zero, realInvValue.zero]

theorem rootInverse.one
  shows rootInverse(1) = R[1]
proof
  have oneMember : (1:N) ∈ ℕ := nat.omega.forward at (1:N) with *
  rw [(rootInverse.value with oneMember), natSqrt.one, realInvValue.one]

-- √J for a natural J, and the step to J + 1.
theorem natSqrt.facts (J : Nat)
  shows Real(realSqrt(realNat(J))) ∧ R[0] ≤ realSqrt(realNat(J)) ∧
    R[realSqrt(realNat(J)) * realSqrt(realNat(J))] = realNat(J)
proof
  have nonnegative := realNat.nonnegative at J
  have root := realSqrt.real with nonnegative
  have rootNonnegative := realSqrt.nonneg with nonnegative
  have square := realSqrt.square with nonnegative
  exact ⟨root, rootNonnegative, square⟩

theorem natSqrt.positive (J : Nat)
  requires positive : 1 ≤ J
  shows R[0] < realSqrt(realNat(J))
proof
  obtain ⟨root, nonnegative, square⟩ := natSqrt.facts at J
  have jPositive : R[0] < realNat(J)
    have nonzero : J ≠ (0:N) by arith
    exact realNat.positive with nonzero
  by_contra notPositive
  have zero : realSqrt(realNat(J)) = R[0] by linarith
  rw zero at square
  have collapse : R[0 * 0] = R[0] by ring
  linarith

theorem natSqrt.succ_square (J : Nat)
  shows R[realSqrt(realNat(succ(J))) * realSqrt(realNat(succ(J)))] =
    R[realSqrt(realNat(J)) * realSqrt(realNat(J)) + 1]
proof
  obtain ⟨_, _, square⟩ := natSqrt.facts at J
  obtain ⟨_, _, squareNext⟩ := natSqrt.facts at succ(J)
  rw [squareNext, square, realNat.succ_add]

theorem rootInverse.apply (J : Nat)
  shows rootInverse(J) = realInvValue(realSqrt(realNat(J)))
proof
  have member : J ∈ ℕ := nat.omega.forward at J with *
  exact rootInverse.value with member

-- s(J) = Σ_{e ≤ J} 1/√e.
def rootInverseSum (J : Nat) : Set := realPartialSum(rootInverse, succ(J))

theorem rootInverseSum.real (J : Nat)
  shows Real(rootInverseSum(J))
proof
  unfold rootInverseSum
  exact realPartialSum.real with rootInverse.sequence

theorem rootInverseSum.succ (J : Nat)
  shows rootInverseSum(succ(J)) =
    R[rootInverseSum(J) + rootInverse(succ(J))]
proof
  unfold rootInverseSum
  rw realPartialSum.succ at rootInverse, succ(J)
  have sequence := rootInverse.sequence
  have sum := realPartialSum.real at rootInverse, succ(J) with sequence
  have term := RealSequence.value at rootInverse, succ(J) with sequence
  ring

-- s(J) − 2√J is antitone.
theorem rootInverseSum.step_down (J : Nat)
  shows R[rootInverseSum(succ(J)) - 2 * realSqrt(realNat(succ(J)))] ≤
    R[rootInverseSum(J) - 2 * realSqrt(realNat(J))]
proof
  obtain ⟨a, aNonnegative, _⟩ := natSqrt.facts at J
  obtain ⟨b, _, _⟩ := natSqrt.facts at succ(J)
  have one : 1 ≤ succ(J) by arith
  have bPositive := natSqrt.positive with one
  have step := natSqrt.succ_square at J
  have lower := sqrtStep.lower with aNonnegative, bPositive, step
  have sum := rootInverseSum.real at J
  rw [rootInverseSum.succ, rootInverse.apply]
  have inverse := realInvValue.real at realSqrt(realNat(succ(J)))
  linarith

-- s(J) − 2√J − 1/(2√J) is monotone for J ≥ 1.
theorem rootInverseSum.step_up (J : Nat)
  requires positive : 1 ≤ J
  shows R[rootInverseSum(J) - 2 * realSqrt(realNat(J)) - rootInverse(J) / 2]
    ≤ R[rootInverseSum(succ(J)) - 2 * realSqrt(realNat(succ(J))) -
      rootInverse(succ(J)) / 2]
proof
  obtain ⟨a, _, _⟩ := natSqrt.facts at J
  obtain ⟨b, _, _⟩ := natSqrt.facts at succ(J)
  have one : 1 ≤ succ(J) by arith
  have aPositive := natSqrt.positive with positive
  have bPositive := natSqrt.positive with one
  have step := natSqrt.succ_square at J
  have convex := sqrtStep.convex with aPositive, bPositive, step
  have sum := rootInverseSum.real at J
  rw [rootInverseSum.succ, rootInverse.apply, rootInverse.apply]
  have inverseA := realInvValue.real at realSqrt(realNat(J))
  have inverseB := realInvValue.real at realSqrt(realNat(succ(J)))
  linarith

theorem rootInverseSum.antitone (J k : Nat)
  shows R[rootInverseSum(J + k) - 2 * realSqrt(realNat(J + k))] ≤
    R[rootInverseSum(J) - 2 * realSqrt(realNat(J))]
proof
  induction k
  | zero =>
    have same : J + 0 = J by arith
    rw same
    have sum := rootInverseSum.real at J
    obtain ⟨root, _, _⟩ := natSqrt.facts at J
    linarith
  | succ(m) using ih =>
    have mNat : Nat(m) by typecheck
    have same : add(J, succ(m)) = succ(add(J, m)) by arith
    rw same
    have step := rootInverseSum.step_down at J + m
    linarith

theorem rootInverseSum.corrected_monotone (J k : Nat)
  requires positive : 1 ≤ J
  shows R[rootInverseSum(J) - 2 * realSqrt(realNat(J)) - rootInverse(J) / 2]
    ≤ R[rootInverseSum(J + k) - 2 * realSqrt(realNat(J + k)) -
      rootInverse(J + k) / 2]
proof
  induction k
  | zero =>
    have same : J + 0 = J by arith
    rw same
    have sum := rootInverseSum.real at J
    obtain ⟨root, _, _⟩ := natSqrt.facts at J
    have inverse := RealSequence.value at rootInverse, J with
      rootInverse.sequence
    linarith
  | succ(m) using ih =>
    have mNat : Nat(m) by typecheck
    have same : add(J, succ(m)) = succ(add(J, m)) by arith
    rw same
    have atLeast : 1 ≤ J + m by arith
    have step := rootInverseSum.step_up at J + m with atLeast
    linarith

theorem rootInverse.nonnegative (n : Nat)
  shows R[0] ≤ rootInverse(n)
proof
  obtain ⟨root, rootNonnegative, _⟩ := natSqrt.facts at n
  rw rootInverse.apply
  by_cases zero : realSqrt(realNat(n)) = R[0]
  . rw [zero, realInvValue.zero]
    linarith
  . have positive : R[0] < realSqrt(realNat(n))
      by_contra notPositive
      have atMost : realSqrt(realNat(n)) ≤ R[0] by linarith
      exact zero with (realLe.antisymmetric with atMost, rootNonnegative)
    have inverse := realInvValue.positive with positive
    linarith

-- For 1 ≤ J ≤ X: r(X) ≤ r(J) ≤ r(X) + 1/(2√J), r = s − 2√·.
theorem rootInverseSum.window (J X : Nat)
  requires positive : 1 ≤ J
  requires ordered : J ≤ X
  shows R[rootInverseSum(X) - 2 * realSqrt(realNat(X))] ≤
      R[rootInverseSum(J) - 2 * realSqrt(realNat(J))] ∧
    R[rootInverseSum(J) - 2 * realSqrt(realNat(J))] ≤
      R[rootInverseSum(X) - 2 * realSqrt(realNat(X)) + rootInverse(J) / 2]
proof
  obtain ⟨k, kNat, shape⟩ := LessEqual.exists_add with ordered
  have down := rootInverseSum.antitone at J, k
  have up := rootInverseSum.corrected_monotone at J, k with positive
  rw ← shape at down
  rw ← shape at up
  have last := rootInverse.nonnegative at X
  constructor
  . exact down
  . linarith

-- −2 ≤ r(X) ≤ 0 for X ≥ 1.
theorem rootInverseSum.remainder_bounds (X : Nat)
  requires positive : 1 ≤ X
  shows R[-2] ≤ R[rootInverseSum(X) - 2 * realSqrt(realNat(X))] ∧
    R[rootInverseSum(X) - 2 * realSqrt(realNat(X))] ≤ R[0]
proof
  have zeroSum : rootInverseSum(0) = R[0]
    unfold rootInverseSum
    rw [realPartialSum.succ, realPartialSum.zero, rootInverse.zero]
    ring
  have oneSum : rootInverseSum(succ(0)) = R[1]
    rw [rootInverseSum.succ, zeroSum, ← natural.one_succ, rootInverse.one]
    ring
  have below := rootInverseSum.antitone at 0, X
  have zeroX : 0 + X = X by arith
  rw [zeroX, zeroSum, natSqrt.zero] at below
  have unit : 1 ≤ 1 by arith
  obtain ⟨_, atLeast⟩ := rootInverseSum.window at 1, X with unit, positive
  rw [natSqrt.one, rootInverse.one, natural.one_succ, oneSum] at atLeast
  constructor
  . linarith
  . linarith

-- Section: Abel summation
-- Abel summation: partial sums of u bounded by B and w antitone and
-- nonnegative give |Σ_{i<n} u(i) w(i)| ≤ B w((0:N)). The invariant is
-- |Σ_{i<n} u(i) w(i) − U(n) w(n)| ≤ B (w((0:N)) − w(n)), U the partial sums.
theorem realPartialSum.abel_invariant (u w t : Set) (B : Real) (n : Nat)
  requires sequenceU : RealSequence(u)
  requires sequenceW : RealSequence(w)
  requires sequenceT : RealSequence(t)
  requires products : ∀ i ∈ ℕ, (t(i):R) = R[u(i) * w(i)]
  requires bounded : ∀ j ∈ ℕ, abs(realPartialSum(u, j)) ≤ B
  requires antitone : ∀ i ∈ ℕ, (w(succ(i)):R) ≤ (w(i):R)
  shows R[-(B * (w((0:N)) - w(n)))] ≤
      R[realPartialSum(t, n) - realPartialSum(u, n) * w(n)] ∧
    R[realPartialSum(t, n) - realPartialSum(u, n) * w(n)] ≤
      R[B * (w((0:N)) - w(n))]
proof
  have zeroMember : (0:N) ∈ ℕ := nat.omega.forward at (0:N) with *
  induction n
  | zero =>
    have w0 := RealSequence.value at w, 0 with sequenceW
    rw [realPartialSum.zero, realPartialSum.zero]
    constructor
    . have zero : R[-(B * (w((0:N)) - w((0:N))))] = R[0 - 0 * w((0:N))] by ring
      rw zero
      exact realLe.reflexive
    . have zero : R[B * (w((0:N)) - w((0:N)))] = R[0 - 0 * w((0:N))] by ring
      rw zero
      exact realLe.reflexive
  | succ(m) using ih =>
    obtain ⟨lowerPrev, upperPrev⟩ := ih
    have mMember : m ∈ ℕ := nat.omega.forward at m with *
    have succMember : succ(m) ∈ ℕ := nat.omega.forward at succ(m) with *
    have um := RealSequence.value at u, m with sequenceU
    have wm := RealSequence.value at w, m with sequenceW
    have wNext := RealSequence.value at w, succ(m) with sequenceW
    have w0 := RealSequence.value at w, 0 with sequenceW
    have tm := RealSequence.value at t, m with sequenceT
    have sumT := realPartialSum.real at t, m with sequenceT
    have sumU := realPartialSum.real at u, m with sequenceU
    have sumUNext := realPartialSum.real at u, succ(m) with sequenceU
    have product := products with m, mMember
    have bound := bounded with succ(m), succMember
    have step := antitone with m, mMember
    have gap : R[0] ≤ R[w(m) - w(succ(m))] by linarith
    have upperU := abs.upper at realPartialSum(u, succ(m))
    have lowerU := abs.upper_neg at realPartialSum(u, succ(m))
    have absReal := abs.real at realPartialSum(u, succ(m))
    have atMost : realPartialSum(u, succ(m)) ≤ B by linarith
    have atLeast : R[-B] ≤ realPartialSum(u, succ(m)) by linarith
    have upperProduct := realLe.mul_right_of_nonnegative with atMost, gap
    have lowerProduct := realLe.mul_right_of_nonnegative with atLeast, gap
    have nextU : realPartialSum(u, succ(m)) = R[realPartialSum(u, m) + u(m)]
      rw realPartialSum.succ
      ring
    have nextT : realPartialSum(t, succ(m)) = R[realPartialSum(t, m) + t(m)]
      rw realPartialSum.succ
      ring
    have shape : R[realPartialSum(t, succ(m)) - realPartialSum(u, succ(m)) *
        w(succ(m))] = R[(realPartialSum(t, m) - realPartialSum(u, m) * w(m)) +
        realPartialSum(u, succ(m)) * (w(m) - w(succ(m)))]
      rw [nextT, product]
      rw nextU
      ring
    rw shape
    have total : R[B * (w((0:N)) - w(m)) + B * (w(m) - w(succ(m)))] =
      R[B * (w((0:N)) - w(succ(m)))] by ring
    have negated : R[-B * (w(m) - w(succ(m)))] =
      R[-(B * (w(m) - w(succ(m))))] by ring
    have negatedTotal : R[-(B * (w((0:N)) - w(succ(m))))] =
      R[-(B * (w((0:N)) - w(m))) + -(B * (w(m) - w(succ(m))))] by ring
    constructor
    . linarith
    . linarith

theorem realPartialSum.abel_bound (u w t : Set) (B : Real) (n : Nat)
  requires sequenceU : RealSequence(u)
  requires sequenceW : RealSequence(w)
  requires sequenceT : RealSequence(t)
  requires products : ∀ i ∈ ℕ, (t(i):R) = R[u(i) * w(i)]
  requires bounded : ∀ j ∈ ℕ, abs(realPartialSum(u, j)) ≤ B
  requires antitone : ∀ i ∈ ℕ, (w(succ(i)):R) ≤ (w(i):R)
  requires nonnegative : ∀ i ∈ ℕ, R[0] ≤ (w(i):R)
  shows abs(realPartialSum(t, n)) ≤ R[B * w((0:N))]
proof
  obtain ⟨lower, upper⟩ := realPartialSum.abel_invariant at u, w, t, B, n with
    sequenceU, sequenceW, sequenceT, products, bounded, antitone
  have nMember : n ∈ ℕ := nat.omega.forward at n with *
  have wn := RealSequence.value at w, n with sequenceW
  have w0 := RealSequence.value at w, 0 with sequenceW
  have sumT := realPartialSum.real at t, n with sequenceT
  have sumU := realPartialSum.real at u, n with sequenceU
  have bound := bounded with n, nMember
  have last := nonnegative with n, nMember
  have upperU := abs.upper at realPartialSum(u, n)
  have lowerU := abs.upper_neg at realPartialSum(u, n)
  have absReal := abs.real at realPartialSum(u, n)
  have atMost : realPartialSum(u, n) ≤ B by linarith
  have atLeast : R[-B] ≤ realPartialSum(u, n) by linarith
  have upperProduct := realLe.mul_right_of_nonnegative with atMost, last
  have lowerProduct := realLe.mul_right_of_nonnegative with atLeast, last
  have expandUpper : R[B * (w((0:N)) - w(n))] = R[B * w((0:N)) - B * w(n)]
    by ring
  have expandLower : R[-(B * (w((0:N)) - w(n)))] =
    R[-(B * w((0:N))) + B * w(n)] by ring
  have negated : R[-B * w(n)] = R[-(B * w(n))] by ring
  apply abs.le_of_bounds
  . linarith
  . linarith

-- Section: Divisor sums of a real character
-- The indicator of a set, and a real sequence masked by it.
defunique setIndicator (S d : Set) (w ∈ ℝ) :=
  (d ∈ S → w = R[1]) ∧ (¬(d ∈ S) → w = R[0])
proof
  by_cases inside : d ∈ S
  . have one : R[1] ∈ ℝ by typecheck
    witness R[1]
    refine ⟨one, ?_, ?_⟩
    . intro yes
      rfl
    . intro no
      exfalso
      exact no with inside
  . have zero : R[0] ∈ ℝ by typecheck
    witness R[0]
    refine ⟨zero, ?_, ?_⟩
    . intro yes
      exfalso
      exact inside with yes
    . intro no
      rfl
uniqueness
  intros w wMember wValue v vMember vValue
  obtain ⟨wIn, wOut⟩ := wValue
  obtain ⟨vIn, vOut⟩ := vValue
  by_cases inside : d ∈ S
  . rw [(wIn with inside), (vIn with inside)]
  . rw [(wOut with inside), (vOut with inside)]

defgraph maskedTerms (S u : Set) (d ∈ ℕ) : ℝ := R[setIndicator(S, d) * u(d)]
requires sequence : RealSequence(u)
proof
  have dNat := nat.omega.backward with member
  obtain ⟨indicator, _⟩ := setIndicator.selected at S, d
  have value := RealSequence.value at u, d with sequence
  typecheck

theorem maskedTerms.sequence (S u : Set)
  requires sequence : RealSequence(u)
  shows RealSequence(maskedTerms(S, u))
proof
  unfold RealSequence
  exact maskedTerms.function with sequence

theorem maskedTerms.inside (S u : Set) (d : Nat)
  requires sequence : RealSequence(u)
  requires inside : d ∈ S
  shows maskedTerms(S, u)(d) = u(d)
proof
  have member : d ∈ ℕ := nat.omega.forward at d with *
  obtain ⟨_, yes, _⟩ := setIndicator.selected at S, d
  have value := RealSequence.value at u, d with sequence
  rw [(maskedTerms.value with sequence, member), (yes with inside)]
  ring

theorem maskedTerms.outside (S u : Set) (d : Nat)
  requires sequence : RealSequence(u)
  requires outside : ¬(d ∈ S)
  shows maskedTerms(S, u)(d) = R[0]
proof
  have member : d ∈ ℕ := nat.omega.forward at d with *
  obtain ⟨_, _, no⟩ := setIndicator.selected at S, d
  have value := RealSequence.value at u, d with sequence
  rw [(maskedTerms.value with sequence, member), (no with outside)]
  ring

-- Masks that agree below L give the same partial sum.
theorem maskedTerms.congr (S T u : Set) (L : Nat)
  requires sequence : RealSequence(u)
  requires agree : ∀ d ∈ ℕ, d < L → (d ∈ S ↔ d ∈ T)
  shows realPartialSum(maskedTerms(S, u), L) =
    realPartialSum(maskedTerms(T, u), L)
proof
  have maskedS := maskedTerms.sequence at S, u with sequence
  have maskedT := maskedTerms.sequence at T, u with sequence
  apply realPartialSum.eq_prefix with maskedS, maskedT
  intros d dMember below
  have dNat := nat.omega.backward with dMember
  have same := agree with d, dMember, below
  by_cases inside : d ∈ S
  . have insideT := same.forward with inside
    rw [(maskedTerms.inside with sequence, inside),
      (maskedTerms.inside with sequence, insideT)]
  . have outsideT : ¬(d ∈ T)
      intro insideT
      exact inside with (same.backward with insideT)
    rw [(maskedTerms.outside with sequence, inside),
      (maskedTerms.outside with sequence, outsideT)]

-- A mask that splits into two disjoint masks splits the sum.
theorem maskedTerms.split (S E F u : Set) (L : Nat)
  requires sequence : RealSequence(u)
  shows (∀ d ∈ ℕ, d < L → ((d ∈ S ↔ d ∈ E ∨ d ∈ F) ∧ ¬(d ∈ E ∧ d ∈ F))) →
    realPartialSum(maskedTerms(S, u), L) =
      R[realPartialSum(maskedTerms(E, u), L) +
        realPartialSum(maskedTerms(F, u), L)]
proof
  have maskedS := maskedTerms.sequence at S, u with sequence
  have maskedE := maskedTerms.sequence at E, u with sequence
  have maskedF := maskedTerms.sequence at F, u with sequence
  induction L
  | zero =>
    intro cover
    rw [realPartialSum.zero, realPartialSum.zero, realPartialSum.zero]
    ring
  | succ(m) using ih =>
    intro cover
    have earlier : ∀ d ∈ ℕ, d < m → ((d ∈ S ↔ d ∈ E ∨ d ∈ F) ∧
        ¬(d ∈ E ∧ d ∈ F))
      intros d dMember below
      have wider : d < succ(m) by arith
      exact cover with d, dMember, wider
    have previous := ih with earlier
    have mMember : m ∈ ℕ := nat.omega.forward at m with *
    have last : m < succ(m) by arith
    obtain ⟨same, disjoint⟩ := cover with m, mMember, last
    have sumS := realPartialSum.real at maskedTerms(S, u), m with maskedS
    have sumE := realPartialSum.real at maskedTerms(E, u), m with maskedE
    have sumF := realPartialSum.real at maskedTerms(F, u), m with maskedF
    have value := RealSequence.value at u, m with sequence
    have step : maskedTerms(S, u)(m) =
        R[maskedTerms(E, u)(m) + maskedTerms(F, u)(m)]
      by_cases inE : m ∈ E
      . have notF : ¬(m ∈ F)
          intro inF
          exact disjoint with ⟨inE, inF⟩
        have either : m ∈ E ∨ m ∈ F
          left
          exact inE
        have inS := same.backward with either
        rw [(maskedTerms.inside with sequence, inS),
          (maskedTerms.inside with sequence, inE),
          (maskedTerms.outside with sequence, notF)]
        ring
      . by_cases inF : m ∈ F
        . have either : m ∈ E ∨ m ∈ F
            right
            exact inF
          have inS := same.backward with either
          rw [(maskedTerms.inside with sequence, inS),
            (maskedTerms.outside with sequence, inE),
            (maskedTerms.inside with sequence, inF)]
          ring
        . have notS : ¬(m ∈ S)
            intro inS
            have either := same.forward with inS
            cases either with left | right
            . exact inE with left
            . exact inF with right
          rw [(maskedTerms.outside with sequence, notS),
            (maskedTerms.outside with sequence, inE),
            (maskedTerms.outside with sequence, inF)]
          ring
    rw [realPartialSum.succ, realPartialSum.succ, realPartialSum.succ,
      previous, step]
    ring

-- A mask empty from L on adds nothing past L.
theorem maskedTerms.range (S u : Set) (L k : Nat)
  requires sequence : RealSequence(u)
  requires beyond : ∀ d ∈ ℕ, L ≤ d → ¬(d ∈ S)
  shows realPartialSum(maskedTerms(S, u), L + k) =
    realPartialSum(maskedTerms(S, u), L)
proof
  induction k
  | zero =>
    have same : L + 0 = L by arith
    rw same
  | succ(m) using ih =>
    have mNat : Nat(m) by typecheck
    have shape : add(L, succ(m)) = succ(add(L, m)) by arith
    have position : add(L, m) ∈ ℕ by typecheck
    have later : L ≤ add(L, m) by arith
    have outside := beyond with add(L, m), position, later
    rw [shape, realPartialSum.succ, ih,
      (maskedTerms.outside with sequence, outside)]
    have masked := maskedTerms.sequence at S, u with sequence
    have sum := realPartialSum.real at maskedTerms(S, u), L with masked
    ring

-- A partial sum whose terms vanish after the first is the first term.
theorem realPartialSum.first_only (g : Set) (n : Nat)
  requires sequence : RealSequence(g)
  shows 1 ≤ n → (∀ i ∈ ℕ, 1 ≤ i → i < n → (g(i):R) = R[0]) →
    realPartialSum(g, n) = g((0:N))
proof
  induction n
  | zero =>
    intro positive
    exfalso
    arith
  | succ(m) using ih =>
    intros positive vanish
    have zeroValue := RealSequence.value at g, (0:N) with sequence
    by_cases empty : m = (0:N)
    . rw [empty, realPartialSum.succ, realPartialSum.zero]
      ring
    . have mPositive : 1 ≤ m by arith
      have earlier : ∀ i ∈ ℕ, 1 ≤ i → i < m → (g(i):R) = R[0]
        intros i iMember iPositive below
        have wider : i < succ(m) by arith
        exact vanish with i, iMember, iPositive, wider
      have previous := ih with mPositive, earlier
      have mMember : m ∈ ℕ := nat.omega.forward at m with *
      have last : m < succ(m) by arith
      have lastZero := vanish with m, mMember, mPositive, last
      rw [realPartialSum.succ, previous, lastZero]
      ring

-- The terms at the multiples of p.
defgraph dilatedTerms (T : Set, p : Nat) (j ∈ ℕ) : ℝ := T(p * j)
requires sequence : RealSequence(T)
proof
  have jNat := nat.omega.backward with member
  exact RealSequence.value at T, p * j with sequence

-- A sequence supported on the multiples of p sums over [0, pL) as its
-- dilation sums over [0, L).
theorem realPartialSum.multiples (T : Set) (p L : Nat)
  requires sequence : RealSequence(T)
  requires positive : 1 ≤ p
  requires sparse : ∀ d ∈ ℕ, ¬(p ∣ d) → (T(d):R) = R[0]
  shows realPartialSum(T, p * L) = realPartialSum(dilatedTerms(T, p), L)
proof
  have dilated := dilatedTerms.function at T, p with sequence
  have dilatedSequence : RealSequence(dilatedTerms(T, p)) by exact dilated
  induction L
  | zero =>
    have zero : p * (0:N) = (0:N) by arith
    rw [zero, realPartialSum.zero, realPartialSum.zero]
  | succ(m) using ih =>
    have mNat : Nat(m) by typecheck
    have shape : mul(p, succ(m)) = add(mul(p, m), p) by arith
    have shifted := shiftedRealSequence.sequence at T, p * m with sequence
    have block := realPartialSum.first_only at shiftedRealSequence(T, p * m), p
      with shifted
    have vanish : ∀ i ∈ ℕ, 1 ≤ i → i < p →
        (shiftedRealSequence(T, p * m)(i):R) = R[0]
      intros i iMember iPositive below
      have iNat := nat.omega.backward with iMember
      rw (shiftedRealSequence.value with sequence, iMember)
      have position : add(p * m, i) ∈ ℕ by typecheck
      apply sparse with add(p * m, i), position
      intro divides
      have multiple := divides.mul_left_self at p, m
      have cancel := (divides.add_right_iff at p, p * m, i with
        multiple).forward with divides
      have nonzero : i ≠ (0:N) by arith
      have atMost := divides.le with cancel, nonzero
      arith
    have first := block with positive, vanish
    have zeroMember : (0:N) ∈ ℕ := nat.omega.forward at (0:N) with *
    have mMember : m ∈ ℕ := nat.omega.forward at m with *
    have offset : add(p * m, (0:N)) = p * m by arith
    rw [(shiftedRealSequence.value with sequence, zeroMember), offset] at first
    rw [shape, (realPartialSum.split_at with sequence), first, ih,
      realPartialSum.succ, (dilatedTerms.value with sequence, mMember)]
    have sum := realPartialSum.real at dilatedTerms(T, p), m with
      dilatedSequence
    have term := RealSequence.value at T, p * m with sequence
    ring

-- Termwise proportional sequences have proportional partial sums.
theorem realPartialSum.eq_scaled (v w : Set) (c : Real) (n : Nat)
  requires sequenceV : RealSequence(v)
  requires sequenceW : RealSequence(w)
  shows (∀ j ∈ ℕ, j < n → (v(j):R) = R[c * w(j)]) →
    realPartialSum(v, n) = R[c * realPartialSum(w, n)]
proof
  induction n
  | zero =>
    intro same
    rw [realPartialSum.zero, realPartialSum.zero]
    ring
  | succ(m) using ih =>
    intro same
    have earlier : ∀ j ∈ ℕ, j < m → (v(j):R) = R[c * w(j)]
      intros j jMember below
      have wider : j < succ(m) by arith
      exact same with j, jMember, wider
    have previous := ih with earlier
    have mMember : m ∈ ℕ := nat.omega.forward at m with *
    have last : m < succ(m) by arith
    have lastSame := same with m, mMember, last
    have sumW := realPartialSum.real at w, m with sequenceW
    have term := RealSequence.value at w, m with sequenceW
    rw [realPartialSum.succ, realPartialSum.succ, previous, lastSame]
    ring

-- The divisors of x, those prime to p, and those divisible by p.
def divisorSet (x : Nat) : Set := { d ∈ ℕ | d ∣ x }
def coprimeDivisorSet (x p : Nat) : Set := { d ∈ ℕ | d ∣ x ∧ ¬(p ∣ d) }
def multipleDivisorSet (x p : Nat) : Set := { d ∈ ℕ | d ∣ x ∧ p ∣ d }

-- Σ_{d ∣ x} u(d), over d ≤ x.
def divisorSumReal (u : Set, x : Nat) : Set :=
  realPartialSum(maskedTerms(divisorSet(x), u), succ(x))

-- No divisor of x ≥ 1 exceeds x.
theorem divisorSet.beyond (x : Nat)
  requires positive : 1 ≤ x
  shows ∀ d ∈ ℕ, succ(x) ≤ d → ¬(d ∈ divisorSet(x))
proof
  intros d dMember later inside
  have dNat := nat.omega.backward with dMember
  obtain ⟨_, divides⟩ := divisorSet.membership.forward with inside
  have nonzero : x ≠ (0:N) by arith
  have atMost := divides.le with divides, nonzero
  arith

-- Σ_{d ∣ px} u(d) = Σ_{d ∣ px, p ∤ d} u(d) + u(p) Σ_{d ∣ x} u(d).
theorem divisorSumReal.prime_step (u : Set) (p x : Nat)
  requires sequence : RealSequence(u)
  requires multiplicative : ∀ a ∈ ℕ, ∀ b ∈ ℕ, (u(a * b):R) = R[u(a) * u(b)]
  requires prime : Prime(p)
  requires positive : 1 ≤ x
  shows divisorSumReal(u, p * x) =
    R[realPartialSum(maskedTerms(coprimeDivisorSet(p * x, p), u),
      succ(p * x)) + u(p) * divisorSumReal(u, x)]
proof
  have primeCopy := prime
  obtain ⟨oneBelow, _⟩ := primeCopy
  have two := Less.of_membership with oneBelow
  have pPositive : 1 ≤ p by arith
  have pNonzero : p ≠ (0:N) by arith
  obtain ⟨q, qNat, pShape⟩ := LessEqual.exists_add with pPositive
  have productPositive : 1 ≤ p * x
    have scaled := LessEqual.mul_left at 1, x, p with positive
    arith
  have total : add(succ(p * x), q) = mul(p, succ(x))
    rw pShape
    arith
  have beyondD := divisorSet.beyond with productPositive
  have maskedD := maskedTerms.sequence at divisorSet(p * x), u with sequence
  have maskedE := maskedTerms.sequence at coprimeDivisorSet(p * x, p), u with
    sequence
  have maskedF := maskedTerms.sequence at multipleDivisorSet(p * x, p), u
    with sequence
  have maskedX := maskedTerms.sequence at divisorSet(x), u with sequence
  -- Extend the range to p (x + 1).
  have extendD := maskedTerms.range at divisorSet(p * x), u, succ(p * x), q
    with sequence, beyondD
  have beyondE : ∀ d ∈ ℕ, succ(p * x) ≤ d →
      ¬(d ∈ coprimeDivisorSet(p * x, p))
    intros d dMember later inside
    obtain ⟨_, divides, _⟩ := coprimeDivisorSet.membership.forward with inside
    have inD : d ∈ divisorSet(p * x)
      exact divisorSet.membership.backward with ⟨dMember, divides⟩
    exact beyondD with d, dMember, later, inD
  have extendE := maskedTerms.range at coprimeDivisorSet(p * x, p), u,
    succ(p * x), q with sequence, beyondE
  rw total at extendD
  rw total at extendE
  -- Split the divisors by divisibility by p.
  have split := maskedTerms.split at divisorSet(p * x),
    coprimeDivisorSet(p * x, p), multipleDivisorSet(p * x, p), u,
    mul(p, succ(x)) with sequence
  have cover : ∀ d ∈ ℕ, d < mul(p, succ(x)) →
      ((d ∈ divisorSet(p * x) ↔ d ∈ coprimeDivisorSet(p * x, p) ∨
        d ∈ multipleDivisorSet(p * x, p)) ∧
      ¬(d ∈ coprimeDivisorSet(p * x, p) ∧ d ∈ multipleDivisorSet(p * x, p)))
    intros d dMember below
    constructor
    . constructor
      . intro inD
        obtain ⟨_, divides⟩ := divisorSet.membership.forward with inD
        by_cases multiple : p ∣ d
        . right
          exact multipleDivisorSet.membership.backward with
            ⟨dMember, divides, multiple⟩
        . left
          exact coprimeDivisorSet.membership.backward with
            ⟨dMember, divides, multiple⟩
      . intro either
        cases either with inE | inF
        . obtain ⟨_, divides, _⟩ := coprimeDivisorSet.membership.forward with
            inE
          exact divisorSet.membership.backward with ⟨dMember, divides⟩
        . obtain ⟨_, divides, _⟩ := multipleDivisorSet.membership.forward
            with inF
          exact divisorSet.membership.backward with ⟨dMember, divides⟩
    . intro both
      obtain ⟨inE, inF⟩ := both
      obtain ⟨_, _, notMultiple⟩ := coprimeDivisorSet.membership.forward with
        inE
      obtain ⟨_, _, multiple⟩ := multipleDivisorSet.membership.forward with inF
      exact notMultiple with multiple
  have splitSum := split with cover
  -- The multiples of p are the dilation of the divisors of x.
  have sparse : ∀ d ∈ ℕ, ¬(p ∣ d) →
      (maskedTerms(multipleDivisorSet(p * x, p), u)(d):R) = R[0]
    intros d dMember notMultiple
    have dNat := nat.omega.backward with dMember
    have outside : ¬(d ∈ multipleDivisorSet(p * x, p))
      intro inside
      obtain ⟨_, _, multiple⟩ := multipleDivisorSet.membership.forward with
        inside
      exact notMultiple with multiple
    exact maskedTerms.outside with sequence, outside
  have dilation := realPartialSum.multiples at
    maskedTerms(multipleDivisorSet(p * x, p), u), p, succ(x) with maskedF,
    pPositive, sparse
  have dilated := dilatedTerms.function at
    maskedTerms(multipleDivisorSet(p * x, p), u), p with maskedF
  have dilatedSequence : RealSequence(dilatedTerms(
    maskedTerms(multipleDivisorSet(p * x, p), u), p)) by exact dilated
  have pReal := RealSequence.value at u, p with sequence
  have scaled := realPartialSum.eq_scaled at dilatedTerms(
    maskedTerms(multipleDivisorSet(p * x, p), u), p),
    maskedTerms(divisorSet(x), u), u(p), succ(x) with dilatedSequence,
    maskedX
  have pointwise : ∀ j ∈ ℕ, j < succ(x) →
      (dilatedTerms(maskedTerms(multipleDivisorSet(p * x, p), u), p)(j):R) =
      R[u(p) * maskedTerms(divisorSet(x), u)(j)]
    intros j jMember below
    have jNat := nat.omega.backward with jMember
    have pMember : p ∈ ℕ := nat.omega.forward at p with *
    have productMember : p * j ∈ ℕ by typecheck
    rw (dilatedTerms.value with maskedF, jMember)
    by_cases divides : j ∣ x
    . have scaledDivides := (divides.mul_cancel_left at p, j, x with
        pNonzero).backward with divides
      have multiple := divides.mul_left_self at p, j
      have inF := multipleDivisorSet.membership.backward with
        ⟨productMember, scaledDivides, multiple⟩
      have inD := divisorSet.membership.backward with ⟨jMember, divides⟩
      rw [(maskedTerms.inside with sequence, inF),
        (maskedTerms.inside with sequence, inD),
        (multiplicative with p, pMember, j, jMember)]
    . have outF : ¬(p * j ∈ multipleDivisorSet(p * x, p))
        intro inF
        obtain ⟨_, scaledDivides, _⟩ := multipleDivisorSet.membership.forward
          with inF
        exact divides with ((divides.mul_cancel_left at p, j, x with
          pNonzero).forward with scaledDivides)
      have outD : ¬(j ∈ divisorSet(x))
        intro inD
        obtain ⟨_, again⟩ := divisorSet.membership.forward with inD
        exact divides with again
      rw [(maskedTerms.outside with sequence, outF),
        (maskedTerms.outside with sequence, outD)]
      ring
  have dilatedSum := scaled with pointwise
  unfold divisorSumReal
  rw [← extendD, splitSum, extendE, dilation, dilatedSum]

-- For p prime and y ≥ 1, the divisors of p y prime to p are those of y.
theorem coprimeDivisorSet.prime_invariant (u : Set) (p y : Nat)
  requires sequence : RealSequence(u)
  requires prime : Prime(p)
  requires positive : 1 ≤ y
  shows realPartialSum(maskedTerms(coprimeDivisorSet(p * y, p), u),
      succ(p * y)) =
    realPartialSum(maskedTerms(coprimeDivisorSet(y, p), u), succ(y))
proof
  have primeCopy := prime
  obtain ⟨oneBelow, _⟩ := primeCopy
  have two := Less.of_membership with oneBelow
  have agree : ∀ d ∈ ℕ, d < succ(p * y) →
      (d ∈ coprimeDivisorSet(p * y, p) ↔ d ∈ coprimeDivisorSet(y, p))
    intros d dMember below
    have dNat := nat.omega.backward with dMember
    constructor
    . intro inside
      obtain ⟨_, divides, notMultiple⟩ :=
        coprimeDivisorSet.membership.forward with inside
      have certificate := Prime.coprime_of_not_divides with prime, notMultiple
      have coprime := gcd.unique with certificate
      have cancel := coprime.cancel at p, d, y with coprime, divides
      exact coprimeDivisorSet.membership.backward with
        ⟨dMember, cancel, notMultiple⟩
    . intro inside
      obtain ⟨_, divides, notMultiple⟩ :=
        coprimeDivisorSet.membership.forward with inside
      have multiple := divides.mul_right_self at y, p
      have wider := divides.transitive with divides, multiple
      exact coprimeDivisorSet.membership.backward with
        ⟨dMember, wider, notMultiple⟩
  have congruent := maskedTerms.congr at coprimeDivisorSet(p * y, p),
    coprimeDivisorSet(y, p), u, succ(p * y) with sequence, agree
  have beyondD := divisorSet.beyond with positive
  have beyond : ∀ d ∈ ℕ, succ(y) ≤ d → ¬(d ∈ coprimeDivisorSet(y, p))
    intros d dMember later inside
    obtain ⟨_, divides, _⟩ := coprimeDivisorSet.membership.forward with inside
    have inD := divisorSet.membership.backward with ⟨dMember, divides⟩
    exact beyondD with d, dMember, later, inD
  have larger : succ(y) ≤ succ(p * y)
    have onep : 1 ≤ p by arith
    have scaled := LessEqual.mul_left at 1, p, y with onep
    have commute : y * p = p * y by ring
    have unit : y * 1 = y by ring
    rw [commute, unit] at scaled
    arith
  obtain ⟨k, kNat, shape⟩ := LessEqual.exists_add with larger
  have range := maskedTerms.range at coprimeDivisorSet(y, p), u, succ(y), k
    with sequence, beyond
  rw [congruent, shape, range]

-- For p ∤ m every divisor of m is prime to p.
theorem coprimeDivisorSet.of_coprime (u : Set) (p m : Nat)
  requires sequence : RealSequence(u)
  requires coprime : ¬(p ∣ m)
  shows realPartialSum(maskedTerms(coprimeDivisorSet(m, p), u), succ(m)) =
    divisorSumReal(u, m)
proof
  have agree : ∀ d ∈ ℕ, d < succ(m) →
      (d ∈ coprimeDivisorSet(m, p) ↔ d ∈ divisorSet(m))
    intros d dMember below
    have dNat := nat.omega.backward with dMember
    constructor
    . intro inside
      obtain ⟨_, divides, _⟩ := coprimeDivisorSet.membership.forward with inside
      exact divisorSet.membership.backward with ⟨dMember, divides⟩
    . intro inside
      obtain ⟨_, divides⟩ := divisorSet.membership.forward with inside
      have notMultiple : ¬(p ∣ d)
        intro multiple
        exact coprime with (divides.transitive with multiple, divides)
      exact coprimeDivisorSet.membership.backward with
        ⟨dMember, divides, notMultiple⟩
  unfold divisorSumReal
  exact maskedTerms.congr with sequence, agree

-- The divisors of p^k m prime to p are those of m.
theorem coprimeDivisorSet.prime_power (u : Set) (p m k : Nat)
  requires sequence : RealSequence(u)
  requires prime : Prime(p)
  requires positive : 1 ≤ m
  shows realPartialSum(maskedTerms(coprimeDivisorSet(mul(pow(p, k), m), p), u),
      succ(mul(pow(p, k), m))) =
    realPartialSum(maskedTerms(coprimeDivisorSet(m, p), u), succ(m))
proof
  have primeCopy := prime
  obtain ⟨oneBelow, _⟩ := primeCopy
  have two := Less.of_membership with oneBelow
  have pPositive : 0 < p by arith
  induction k
  | zero =>
    have shape : mul(pow(p, (0:N)), m) = m
      rw pow.zero
      ring
    rw shape
  | succ(j) using ih =>
    have jNat : Nat(j) by typecheck
    have power := pow.positive at p, j with pPositive
    have productPositive : 1 ≤ mul(pow(p, j), m)
      have scaled := LessEqual.mul_left at 1, m, pow(p, j) with positive
      have unit : mul(pow(p, j), 1) = pow(p, j) by ring
      rw unit at scaled
      arith
    have shape : mul(pow(p, succ(j)), m) = p * (mul(pow(p, j), m))
      have succ : succ(j) = j + 1 by arith
      rw [succ, pow.add_one]
      ring
    have step := coprimeDivisorSet.prime_invariant at u, p,
      mul(pow(p, j), m) with sequence, prime, productPositive
    rw [shape, step, ih]

-- The recursion G(t, 0) = 1, G(t, k + 1) = 1 + t G(t, k): G(t, k) = 1 + t
-- + ⋯ + t^k.
def signGeometric (t : Set) (k : Nat) → Set
  | t, zero => realOne
  | t, succ(j) => R[1 + t * signGeometric(t, j)]

theorem signGeometric.real (t : Real) (k : Nat)
  shows Real(signGeometric(t, k))
proof
  induction k
  | zero =>
    rw signGeometric
    typecheck
  | succ(j) using ih =>
    rw signGeometric
    typecheck

theorem divisorSumReal.real (u : Set) (x : Nat)
  requires sequence : RealSequence(u)
  shows Real(divisorSumReal(u, x))
proof
  have masked := maskedTerms.sequence at divisorSet(x), u with sequence
  unfold divisorSumReal
  exact realPartialSum.real with masked

-- Σ_{d ∣ p^k m} u(d) = G(u(p), k) Σ_{d ∣ m} u(d) for p ∤ m.
theorem divisorSumReal.prime_power (u : Set) (p m k : Nat)
  requires sequence : RealSequence(u)
  requires multiplicative : ∀ a ∈ ℕ, ∀ b ∈ ℕ, (u(a * b):R) = R[u(a) * u(b)]
  requires prime : Prime(p)
  requires positive : 1 ≤ m
  requires coprime : ¬(p ∣ m)
  shows divisorSumReal(u, mul(pow(p, k), m)) =
    R[signGeometric(u(p), k) * divisorSumReal(u, m)]
proof
  have primeCopy := prime
  obtain ⟨oneBelow, _⟩ := primeCopy
  have two := Less.of_membership with oneBelow
  have pPositive : 0 < p by arith
  have pReal := RealSequence.value at u, p with sequence
  have sumM := divisorSumReal.real at u, m with sequence
  have restM := coprimeDivisorSet.of_coprime at u, p, m with sequence, coprime
  induction k
  | zero =>
    have shape : mul(pow(p, (0:N)), m) = m
      rw pow.zero
      ring
    rw [shape, signGeometric]
    ring
  | succ(j) using ih =>
    have jNat : Nat(j) by typecheck
    have power := pow.positive at p, j with pPositive
    have productPositive : 1 ≤ mul(pow(p, j), m)
      have scaled := LessEqual.mul_left at 1, m, pow(p, j) with positive
      have unit : mul(pow(p, j), 1) = pow(p, j) by ring
      rw unit at scaled
      arith
    have shape : mul(pow(p, succ(j)), m) = p * mul(pow(p, j), m)
      have succ : succ(j) = j + 1 by arith
      rw [succ, pow.add_one]
      ring
    have step := divisorSumReal.prime_step at u, p, mul(pow(p, j), m) with
      sequence, multiplicative, prime, productPositive
    have rest := coprimeDivisorSet.prime_power at u, p, m, succ(j) with
      sequence, prime, positive
    rw shape at rest
    have geometric := signGeometric.real at u(p), j
    rw [shape, step, rest, restM, ih, signGeometric]
    ring

-- For t ∈ {0, 1, −1}: G(t, k) ≥ 1 if t = 1 and G(t, k) ∈ {0, 1} otherwise;
-- so G(t, k) ≥ 0, and G(t, 2j) ≥ 1.
theorem signGeometric.cases (t : Real) (k : Nat)
  requires values : t = R[0] ∨ t = R[1] ∨ t = R[-1]
  shows (t = R[1] → R[1] ≤ signGeometric(t, k)) ∧
    (¬(t = R[1]) → signGeometric(t, k) = R[0] ∨ signGeometric(t, k) = R[1])
proof
  induction k
  | zero =>
    rw signGeometric
    constructor
    . intro one
      linarith
    . intro notOne
      right
      rfl
  | succ(j) using ih =>
    obtain ⟨ifOne, ifOther⟩ := ih
    have previous := signGeometric.real at t, j
    rw signGeometric
    constructor
    . intro one
      have atLeast := ifOne with one
      have product : R[t * signGeometric(t, j)] = signGeometric(t, j)
        by linear_combination signGeometric(t, j) * one
      linarith
    . intro notOne
      have either := ifOther with notOne
      cases values with zero | rest
      . right
        linear_combination signGeometric(t, j) * zero
      . cases rest with one | minus
        . exfalso
          exact notOne with one
        . cases either with low | high
          . right
            linear_combination t * low
          . left
            linear_combination minus + t * high

theorem signGeometric.nonnegative (t : Real) (k : Nat)
  requires values : t = R[0] ∨ t = R[1] ∨ t = R[-1]
  shows R[0] ≤ signGeometric(t, k)
proof
  obtain ⟨ifOne, ifOther⟩ := signGeometric.cases at t, k with values
  by_cases one : t = R[1]
  . have atLeast := ifOne with one
    linarith
  . have either := ifOther with one
    cases either with low | high
    . rw low
      linarith
    . rw high
      linarith

theorem signGeometric.even (t : Real) (j : Nat)
  requires values : t = R[0] ∨ t = R[1] ∨ t = R[-1]
  shows R[1] ≤ signGeometric(t, mul(2, j))
proof
  induction j
  | zero =>
    have zero : mul(2, (0:N)) = (0:N) by arith
    rw [zero, signGeometric]
    linarith
  | succ(i) using ih =>
    have iNat : Nat(i) by typecheck
    have shape : mul(2, succ(i)) = succ(succ(mul(2, i))) by arith
    have previous := signGeometric.real at t, mul(2, i)
    rw [shape, signGeometric, signGeometric]
    cases values with zero | rest
    . have same : R[1 + t * (1 + t * signGeometric(t, mul(2, i)))] = R[1]
        linear_combination (1 + t * signGeometric(t, mul(2, i))) * zero
      linarith
    . cases rest with one | minus
      . have same : R[1 + t * (1 + t * signGeometric(t, mul(2, i)))] =
            R[2 + signGeometric(t, mul(2, i))]
          linear_combination (1 + (t + 1) * signGeometric(t, mul(2, i))) *
            one
        linarith
      . have same : R[1 + t * (1 + t * signGeometric(t, mul(2, i)))] =
            signGeometric(t, mul(2, i))
          linear_combination (1 + (t - 1) * signGeometric(t, mul(2, i))) *
            minus
        linarith

-- Every n ≥ 1 is p^k m with p ∤ m (p ≥ 2), by induction on a bound for n.
theorem natural.prime_part_bounded (p B : Nat)
  requires two : 2 ≤ p
  shows ∀ n ∈ ℕ, 1 ≤ n → n ≤ B →
    ∃ k, Nat(k) ∧ ∃ m, Nat(m) ∧ n = mul(pow(p, k), m) ∧ ¬(p ∣ m)
proof
  induction B
  | zero =>
    intros n nMember positive atMost
    have nNat := nat.omega.backward with nMember
    exfalso
    arith
  | succ(b) using ih =>
    intros n nMember positive atMost
    have nNat := nat.omega.backward with nMember
    by_cases divides : p ∣ n
    . obtain ⟨c, cNat, shape⟩ := divides
      have cPositive : 1 ≤ c
        by_contra zero
        have cZero : c = (0:N) by arith
        rw cZero at shape
        have product : mul(p, (0:N)) = (0:N) by arith
        rw product at shape
        arith
      have doubled := LessEqual.mul_left at 2, p, c with two
      have commute : mul(c, p) = mul(p, c) by ring
      have cBelow : c ≤ b
        have twice : mul(c, 2) = c + c by ring
        rw [twice, commute, shape] at doubled
        arith
      have cMember : c ∈ ℕ := nat.omega.forward at c with *
      obtain ⟨k, kNat, m, mNat, cShape, notDivides⟩ := ih with c, cMember,
        cPositive, cBelow
      have kNext : Nat(succ(k)) by typecheck
      refine ⟨succ(k), kNext, m, mNat, ?_, notDivides⟩
      have succ : succ(k) = k + 1 by arith
      rw [succ, pow.add_one, ← shape, cShape]
      ring
    . have zeroNat : Nat((0:N)) by typecheck
      refine ⟨(0:N), zeroNat, n, nNat, ?_, divides⟩
      rw pow.zero
      ring

theorem natural.prime_part (p n : Nat)
  requires two : 2 ≤ p
  requires positive : 1 ≤ n
  shows ∃ k, Nat(k) ∧ ∃ m, Nat(m) ∧ n = mul(pow(p, k), m) ∧ ¬(p ∣ m)
proof
  have nMember : n ∈ ℕ := nat.omega.forward at n with *
  have atMost : n ≤ n by arith
  exact natural.prime_part_bounded at p, n with two, n, nMember, positive,
    atMost

-- A completely multiplicative real sequence with values in {0, 1, −1} and
-- u(1) = 1: a real character on the naturals.
predicate SignCharacter (u : Set) :=
  RealSequence(u) ∧ (u((1:N)):R) = R[1] ∧
  (∀ a ∈ ℕ, ∀ b ∈ ℕ, (u(a * b):R) = R[u(a) * u(b)]) ∧
  (∀ n ∈ ℕ, (u(n):R) = R[0] ∨ (u(n):R) = R[1] ∨ (u(n):R) = R[-1])

theorem divisorSumReal.one (u : Set)
  requires sequence : RealSequence(u)
  shows divisorSumReal(u, 1) = u((1:N))
proof
  have zeroOut : ¬((0:N) ∈ divisorSet(1))
    intro inside
    obtain ⟨_, divides⟩ := divisorSet.membership.forward with inside
    obtain ⟨c, cNat, shape⟩ := divides
    have product : mul((0:N), c) = (0:N) by arith
    rw product at shape
    arith
  have oneMember : (1:N) ∈ ℕ := nat.omega.forward at (1:N) with *
  have oneIn : (1:N) ∈ divisorSet(1)
    have self := divides.reflexive at 1
    exact divisorSet.membership.backward with ⟨oneMember, self⟩
  have value := RealSequence.value at u, (1:N) with sequence
  unfold divisorSumReal
  rw [natural.one_succ, realPartialSum.succ, realPartialSum.succ,
    realPartialSum.zero, (maskedTerms.outside with sequence, zeroOut),
    ← natural.one_succ, (maskedTerms.inside with sequence, oneIn)]
  ring

-- n = p^k m with k ≥ 1 and p ∤ m: m ≥ 1 and m < n.
theorem natural.prime_part_smaller (p n k m : Nat)
  requires two : 2 ≤ p
  requires positive : 1 ≤ n
  requires shape : n = mul(pow(p, k), m)
  requires divides : p ∣ n
  requires coprime : ¬(p ∣ m)
  shows 1 ≤ k ∧ 1 ≤ m ∧ m < n
proof
  have kPositive : 1 ≤ k
    by_contra zero
    have kZero : k = (0:N) by arith
    rw [kZero, pow.zero] at shape
    have unit : mul(1, m) = m by ring
    rw unit at shape
    rw shape at divides
    exact coprime with divides
  have mPositive : 1 ≤ m
    by_contra zero
    have mZero : m = (0:N) by arith
    rw mZero at shape
    have product : mul(pow(p, k), (0:N)) = (0:N) by ring
    rw product at shape
    arith
  obtain ⟨j, jNat, kShape⟩ := LessEqual.exists_add with kPositive
  have pPositive : 0 < p by arith
  have power := pow.positive at p, j with pPositive
  have powerShape : pow(p, k) = mul(p, pow(p, j))
    rw kShape
    have commute : 1 + j = j + 1 by arith
    rw [commute, pow.add_one]
  rw powerShape at shape
  have atLeast := LessEqual.mul_left at 1, pow(p, j), m with power
  have twice := LessEqual.mul_left at 2, p, mul(pow(p, j), m) with two
  have regroup : mul(mul(p, pow(p, j)), m) = mul(p, mul(pow(p, j), m))
    by ring
  have commute : mul(mul(pow(p, j), m), 2) = mul(2, mul(pow(p, j), m))
    by ring
  have commuteP : mul(mul(pow(p, j), m), p) = mul(p, mul(pow(p, j), m))
    by ring
  have unit : mul(m, 1) = m by ring
  have commuteM : mul(m, pow(p, j)) = mul(pow(p, j), m) by ring
  rw [unit, commuteM] at atLeast
  rw [commute, commuteP] at twice
  rw regroup at shape
  refine ⟨kPositive, mPositive, ?_⟩
  arith

-- Σ_{d ∣ n} u(d) ≥ 0 for n ≥ 1, by induction on a bound for n.
theorem divisorSumReal.nonnegative_bounded (u : Set) (B : Nat)
  requires character : SignCharacter(u)
  shows ∀ n ∈ ℕ, 1 ≤ n → n ≤ B → R[0] ≤ divisorSumReal(u, n)
proof
  have characterCopy := character
  obtain ⟨sequence, one, multiplicative, values⟩ := characterCopy
  induction B
  | zero =>
    intros n nMember positive atMost
    have nNat := nat.omega.backward with nMember
    exfalso
    arith
  | succ(b) using ih =>
    intros n nMember positive atMost
    have nNat := nat.omega.backward with nMember
    by_cases unit : n = (1:N)
    . rw [unit, (divisorSumReal.one with sequence), one]
      linarith
    . have aboveOne : 1 < n by arith
      obtain ⟨p, prime, divides⟩ := natural.exists_prime_divisor with aboveOne
      have primeCopy := prime
      obtain ⟨oneBelow, _⟩ := primeCopy
      have two := Less.of_membership with oneBelow
      have twoLe : 2 ≤ p by arith
      obtain ⟨k, kNat, m, mNat, shape, coprime⟩ := natural.prime_part with
        twoLe, positive
      obtain ⟨kPositive, mPositive, smaller⟩ := natural.prime_part_smaller with
        twoLe, positive, shape, divides, coprime
      have mMember : m ∈ ℕ := nat.omega.forward at m with *
      have mBelow : m ≤ b by arith
      have previous := ih with m, mMember, mPositive, mBelow
      have pMember : p ∈ ℕ := nat.omega.forward at p with *
      have geometric := signGeometric.nonnegative at u(p), k with
        (values with p, pMember)
      rw [shape, (divisorSumReal.prime_power with sequence, multiplicative,
        prime, mPositive, coprime)]
      exact realMulValue.nonnegative with geometric, previous

theorem divisorSumReal.nonnegative (u : Set) (n : Nat)
  requires character : SignCharacter(u)
  requires positive : 1 ≤ n
  shows R[0] ≤ divisorSumReal(u, n)
proof
  have nMember : n ∈ ℕ := nat.omega.forward at n with *
  have atMost : n ≤ n by arith
  exact divisorSumReal.nonnegative_bounded at u, n with character, n, nMember,
    positive, atMost

-- Σ_{d ∣ m²} u(d) ≥ 1 for m ≥ 1.
theorem divisorSumReal.square_bounded (u : Set) (B : Nat)
  requires character : SignCharacter(u)
  shows ∀ m ∈ ℕ, 1 ≤ m → m ≤ B → R[1] ≤ divisorSumReal(u, m * m)
proof
  have characterCopy := character
  obtain ⟨sequence, one, multiplicative, values⟩ := characterCopy
  induction B
  | zero =>
    intros m mMember positive atMost
    have mNat := nat.omega.backward with mMember
    exfalso
    arith
  | succ(b) using ih =>
    intros m mMember positive atMost
    have mNat := nat.omega.backward with mMember
    by_cases unit : m = (1:N)
    . have square : m * m = (1:N)
        rw unit
        ring
      rw [square, (divisorSumReal.one with sequence), one]
      linarith
    . have aboveOne : 1 < m by arith
      obtain ⟨p, prime, divides⟩ := natural.exists_prime_divisor with aboveOne
      have primeCopy := prime
      obtain ⟨oneBelow, _⟩ := primeCopy
      have two := Less.of_membership with oneBelow
      have twoLe : 2 ≤ p by arith
      obtain ⟨k, kNat, r, rNat, shape, coprime⟩ := natural.prime_part with
        twoLe, positive
      obtain ⟨kPositive, rPositive, smaller⟩ := natural.prime_part_smaller with
        twoLe, positive, shape, divides, coprime
      have rMember : r ∈ ℕ := nat.omega.forward at r with *
      have rBelow : r ≤ b by arith
      have previous := ih with r, rMember, rPositive, rBelow
      have pMember : p ∈ ℕ := nat.omega.forward at p with *
      have geometric := signGeometric.even at u(p), k with
        (values with p, pMember)
      have squareShape : m * m = mul(pow(p, mul(2, k)), r * r)
        have double : mul(2, k) = add(k, k) by arith
        rw [shape, double, pow.add]
        ring
      have squareCoprime : ¬(p ∣ r * r)
        intro both
        have either := Prime.divides_mul with prime, both
        cases either with left | right
        . exact coprime with left
        . exact coprime with right
      have squarePositive : 1 ≤ r * r
        have scaled := LessEqual.mul_left at 1, r, r with rPositive
        have unitR : r * 1 = r by ring
        rw unitR at scaled
        arith
      rw [squareShape, (divisorSumReal.prime_power with sequence,
        multiplicative, prime, squarePositive, squareCoprime)]
      have geometricReal := signGeometric.real at u(p), mul(2, k)
      have sumReal := divisorSumReal.real at u, r * r with sequence
      have excessG : R[0] ≤ R[signGeometric(u(p), mul(2, k)) - 1] by linarith
      have sumNonnegative : R[0] ≤ divisorSumReal(u, r * r) by linarith
      have product := realMulValue.nonnegative with excessG, sumNonnegative
      have expand : R[(signGeometric(u(p), mul(2, k)) - 1) *
          divisorSumReal(u, r * r)] =
        R[signGeometric(u(p), mul(2, k)) * divisorSumReal(u, r * r) -
          divisorSumReal(u, r * r)] by ring
      linarith

theorem divisorSumReal.square (u : Set) (m : Nat)
  requires character : SignCharacter(u)
  requires positive : 1 ≤ m
  shows R[1] ≤ divisorSumReal(u, m * m)
proof
  have mMember : m ∈ ℕ := nat.omega.forward at m with *
  have atMost : m ≤ m by arith
  exact divisorSumReal.square_bounded at u, m with character, m, mMember,
    positive, atMost

-- Section: The hyperbola sum Σ_{n ≤ X} (1/√n) Σ_{d ∣ n} χ(d)
-- n ↦ re χ(n) on the naturals.
defgraph realCharacter (χ : Set) (n ∈ ℕ) : ℝ :=
    complexRe(χ(integerOfNat(n)))
requires values : FunctionBetween(χ, ℤ, complexCarrier)
proof
  have nNat := nat.omega.backward with member
  have index : integerOfNat(n) ∈ ℤ by typecheck
  have value := FunctionBetween.apply_closed with values, index
  exact complexRe.real with value

theorem realCharacter.apply (N : Nat) (χ : Set) (n : Nat)
  requires character : DirichletCharacter(N, χ)
  shows realCharacter(χ)(n) = complexRe(χ(integerOfNat(n)))
proof
  have values := DirichletCharacter.function with character
  have member : n ∈ ℕ := nat.omega.forward at n with *
  exact realCharacter.value with values, member

-- For χ real, χ(n) = re χ(n), and n ↦ re χ(n) is a sign character.
theorem realCharacter.of_real (N : Nat) (χ : Set) (n : Nat)
  requires character : DirichletCharacter(N, χ)
  requires square : characterSquare(χ) = principalCharacter(N)
  shows χ(integerOfNat(n)) = complexOfReal(realCharacter(χ)(n))
proof
  have index : integerOfNat(n) ∈ ℤ by typecheck
  obtain ⟨same, _⟩ := characterSquare.values with character, square, index
  rw (realCharacter.apply with character)
  exact same

theorem realCharacter.sign (N : Nat) (χ : Set)
  requires character : DirichletCharacter(N, χ)
  requires square : characterSquare(χ) = principalCharacter(N)
  shows SignCharacter(realCharacter(χ))
proof
  have values := DirichletCharacter.function with character
  have function := realCharacter.function with values
  have sequence : RealSequence(realCharacter(χ)) by exact function
  unfold SignCharacter
  refine ⟨sequence, ?_, ?_, ?_⟩
  . rw [(realCharacter.apply with character), integerOfNat.one,
      (DirichletCharacter.one with character), ← complexOfReal.one,
      complexOfReal.re]
  . intros a aMember b bMember
    have aNat := nat.omega.backward with aMember
    have bNat := nat.omega.backward with bMember
    have aIndex : integerOfNat(a) ∈ ℤ by typecheck
    have bIndex : integerOfNat(b) ∈ ℤ by typecheck
    have aReal := RealSequence.value at realCharacter(χ), a with sequence
    have bReal := RealSequence.value at realCharacter(χ), b with sequence
    rw [(realCharacter.apply at N, χ, a * b with character), integerOfNat.mul,
      (DirichletCharacter.mul with character, aIndex, bIndex),
      (realCharacter.of_real at N, χ, a with character, square),
      (realCharacter.of_real at N, χ, b with character, square),
      ← complexOfReal.mul, complexOfReal.re]
  . intros n nMember
    have nNat := nat.omega.backward with nMember
    have index : integerOfNat(n) ∈ ℤ by typecheck
    obtain ⟨_, cases⟩ := characterSquare.values with character, square, index
    rw (realCharacter.apply with character)
    exact cases

-- Σ_{k<n} re χ(k) = re Σ_{k<n} χ(k).
theorem realCharacter.partial (N : Nat) (χ : Set) (n : Nat)
  requires character : DirichletCharacter(N, χ)
  shows realPartialSum(realCharacter(χ), n) = complexRe(characterSum(χ, n))
proof
  have values := DirichletCharacter.function with character
  induction n
  | zero =>
    rw [realPartialSum.zero, characterSum.zero, ← complexOfReal.zero,
      complexOfReal.re]
  | succ(k) using ih =>
    have sum := characterSum.closed at N, χ, k with character
    have index : integerOfNat(k) ∈ ℤ by typecheck
    have value := FunctionBetween.apply_closed with values, index
    have sumRe := complexRe.real with sum
    have valueRe := complexRe.real with value
    rw [realPartialSum.succ, ih, (realCharacter.apply with character),
      characterSum.succ, complexAdd.pair_eq, (complexRe.add with sum, value)]
    ring

-- |Σ_{k<n} re χ(k)| ≤ N for χ non-principal.
theorem realCharacter.bounded (N : Nat) (χ : Set) (n : Nat)
  requires positive : 1 ≤ N
  requires character : DirichletCharacter(N, χ)
  requires nonPrincipal : χ ≠ principalCharacter(N)
  shows abs(realPartialSum(realCharacter(χ), n)) ≤ realNat(N)
proof
  have positiveN : 0 < N by arith
  have sum := characterSum.closed at N, χ, n with character
  have norm := characterSum.non_principal_bounded at N, n, χ with character,
    positiveN, nonPrincipal
  rw [← (complexAbs.square with sum), realNat.mul] at norm
  have absNonnegative := complexAbs.nonnegative with sum
  have absReal := complexAbs.real with sum
  have nNonnegative := realNat.nonnegative at N
  have absBound := realMulValue.le_of_square_le with absNonnegative,
    nNonnegative, norm
  have reBound := complexAbs.re_le with sum
  rw (realCharacter.partial with character)
  linarith

theorem rootInverse.real (n : Nat)
  shows Real(rootInverse(n))
proof
  exact RealSequence.value at rootInverse, n with rootInverse.sequence

-- (1/√n)² = 1/n, also at n = 0.
theorem rootInverse.square (n : Nat)
  shows R[rootInverse(n) * rootInverse(n)] = realInvValue(realNat(n))
proof
  obtain ⟨root, rootNonnegative, square⟩ := natSqrt.facts at n
  rw rootInverse.apply
  by_cases zero : n = (0:N)
  . rw [zero, natSqrt.zero, realNat.zero, realInvValue.zero]
    ring
  . have positive : 1 ≤ n by arith
    have rootPositive := natSqrt.positive with positive
    have nonzero : realSqrt(realNat(n)) ≠ R[0] by linarith
    have product := realInvValue.mul with nonzero, nonzero
    rw [← product, square]

-- The weights 1/n and 1/√n of the two series, with the character.
theorem characterWeights.sequences (N : Nat) (χ : Set)
  requires character : DirichletCharacter(N, χ)
  shows RealSequence(mulSequence(realCharacter(χ), rootInverse)) ∧
    RealSequence(mulSequence(rootInverse, rootInverse)) ∧
    RealSequence(mulSequence(realCharacter(χ),
      mulSequence(rootInverse, rootInverse)))
proof
  have values := DirichletCharacter.function with character
  have function := realCharacter.function with values
  have sequence : RealSequence(realCharacter(χ)) by exact function
  have root := rootInverse.sequence
  have squares := mulSequence.sequence with root, root
  have first := mulSequence.sequence with sequence, root
  have second := mulSequence.sequence with sequence, squares
  exact ⟨first, squares, second⟩

-- Σ_{k<n} χ(k + 1)/(k + 1) = Σ_{d ≤ n} re χ(d)/d for χ real.
theorem dirichletSeriesTerms.one_real (N : Nat) (χ : Set) (n : Nat)
  requires character : DirichletCharacter(N, χ)
  requires square : characterSquare(χ) = principalCharacter(N)
  shows complexPartialSum(dirichletSeriesTerms(χ, ℂ[1]), n) =
    complexOfReal(realPartialSum(mulSequence(realCharacter(χ),
      mulSequence(rootInverse, rootInverse)), succ(n)))
proof
  have values := DirichletCharacter.function with character
  have one := complexOne.member
  obtain ⟨_, squares, weighted⟩ := characterWeights.sequences with character
  have function := realCharacter.function with values
  have sequence : RealSequence(realCharacter(χ)) by exact function
  have root := rootInverse.sequence
  induction n
  | zero =>
    have zeroCharacter := RealSequence.value at realCharacter(χ), (0:N) with
      sequence
    have zeroRoot := rootInverse.real at (0:N)
    have zeroSquare := RealSequence.value at mulSequence(rootInverse,
      rootInverse), (0:N) with squares
    rw [complexPartialSum.zero, realPartialSum.succ, realPartialSum.zero,
      (mulSequence.value with sequence, squares, zeroCharacter, zeroSquare),
      (mulSequence.value with root, root, zeroRoot, zeroRoot),
      rootInverse.square, realNat.zero, realInvValue.zero]
    have zero : realAddValue(R[0], R[realCharacter(χ)((0:N)) * 0]) = R[0]
      by ring
    rw [zero, complexOfReal.zero]
  | succ(k) using ih =>
    have kMember : k ∈ ℕ := nat.omega.forward at k with *
    have index : succ(k) = k + 1 by arith
    have next := RealSequence.value at realCharacter(χ), succ(k) with sequence
    have nextRoot := rootInverse.real at succ(k)
    have nextSquare := RealSequence.value at mulSequence(rootInverse,
      rootInverse), succ(k) with squares
    have previous := realPartialSum.real at mulSequence(realCharacter(χ),
      mulSequence(rootInverse, rootInverse)), succ(k) with weighted
    have nPositive : R[0] < realNat(succ(k))
      have nonzero : succ(k) ≠ (0:N) by arith
      exact realNat.positive with nonzero
    have minus : ℂ[-1] = complexOfReal(R[-1])
      rw [complexOfReal.neg, complexOfReal.one]
    have power : realCpow(realNat(succ(k)), ℂ[-1]) =
        complexOfReal(realInvValue(realNat(succ(k))))
      rw [minus, realCpow.of_real, (realRpow.neg with nPositive),
        (realRpow.one with nPositive), realDiv.eq_mul_inv]
      have inverse := realInvValue.real at realNat(succ(k))
      have unit : R[1 * realInvValue(realNat(succ(k)))] =
        realInvValue(realNat(succ(k))) by ring
      rw unit
    have inverse := realInvValue.real at realNat(succ(k))
    rw [complexPartialSum.succ, ih, (dirichletSeriesTerms.value at χ, ℂ[1], k
      with values, one, kMember), ← index, power,
      (realCharacter.of_real at N, χ, succ(k) with character, square),
      (realPartialSum.succ at mulSequence(realCharacter(χ),
      mulSequence(rootInverse, rootInverse)), succ(k)),
      (mulSequence.value with sequence, squares, next, nextSquare),
      (mulSequence.value with root, root, nextRoot, nextRoot),
      rootInverse.square]
    have sum : realAddValue(realPartialSum(mulSequence(realCharacter(χ),
        mulSequence(rootInverse, rootInverse)), succ(k)),
        R[realCharacter(χ)(succ(k)) * realInvValue(realNat(succ(k)))]) =
      R[realPartialSum(mulSequence(realCharacter(χ),
        mulSequence(rootInverse, rootInverse)), succ(k)) +
        realCharacter(χ)(succ(k)) * realInvValue(realNat(succ(k)))] by ring
    rw [sum, complexOfReal.add, complexOfReal.mul]

-- Abel summation from k on: |Σ_{k ≤ i < k + n} u(i) w(i)| ≤ 2 B w(k) when
-- the partial sums of u are bounded by B and w is antitone and nonnegative
-- from k on.
theorem realPartialSum.tail_abel (u w : Set) (B : Real) (k n : Nat)
  requires sequenceU : RealSequence(u)
  requires sequenceW : RealSequence(w)
  requires bounded : ∀ j ∈ ℕ, abs(realPartialSum(u, j)) ≤ B
  requires antitone : ∀ i ∈ ℕ, k ≤ i → (w(succ(i)):R) ≤ (w(i):R)
  requires nonnegative : ∀ i ∈ ℕ, k ≤ i → R[0] ≤ (w(i):R)
  shows abs(realPartialSum(shiftedRealSequence(mulSequence(u, w), k), n)) ≤
    R[2 * B * w(k)]
proof
  have products := mulSequence.sequence with sequenceU, sequenceW
  have shiftedU := shiftedRealSequence.sequence at u, k with sequenceU
  have shiftedW := shiftedRealSequence.sequence at w, k with sequenceW
  have shiftedT := shiftedRealSequence.sequence at mulSequence(u, w), k with
    products
  have kMember : k ∈ ℕ := nat.omega.forward at k with *
  have productValues : ∀ i ∈ ℕ, (shiftedRealSequence(mulSequence(u, w), k)(i):R)
      = R[shiftedRealSequence(u, k)(i) * shiftedRealSequence(w, k)(i)]
    intros i iMember
    have iNat := nat.omega.backward with iMember
    have uValue := RealSequence.value at u, add(k, i) with sequenceU
    have wValue := RealSequence.value at w, add(k, i) with sequenceW
    rw [(shiftedRealSequence.value with products, iMember),
      (shiftedRealSequence.value with sequenceU, iMember),
      (shiftedRealSequence.value with sequenceW, iMember),
      (mulSequence.value with sequenceU, sequenceW, uValue, wValue)]
  have shiftedBounded : ∀ j ∈ ℕ,
      abs(realPartialSum(shiftedRealSequence(u, k), j)) ≤ R[2 * B]
    intros j jMember
    have jNat := nat.omega.backward with jMember
    have total : add(k, j) ∈ ℕ by typecheck
    rw (realPartialSum.tail with sequenceU)
    have far := bounded with add(k, j), total
    have near := bounded with k, kMember
    have farSum := realPartialSum.real at u, add(k, j) with sequenceU
    have nearSum := realPartialSum.real at u, k with sequenceU
    have farUpper := abs.upper at realPartialSum(u, add(k, j))
    have farLower := abs.upper_neg at realPartialSum(u, add(k, j))
    have nearUpper := abs.upper at realPartialSum(u, k)
    have nearLower := abs.upper_neg at realPartialSum(u, k)
    have farAbs := abs.real at realPartialSum(u, add(k, j))
    have nearAbs := abs.real at realPartialSum(u, k)
    apply abs.le_of_bounds
    . linarith
    . linarith
  have shiftedAntitone : ∀ i ∈ ℕ, (shiftedRealSequence(w, k)(succ(i)):R) ≤
      (shiftedRealSequence(w, k)(i):R)
    intros i iMember
    have iNat := nat.omega.backward with iMember
    have next : succ(i) ∈ ℕ by typecheck
    have position : add(k, i) ∈ ℕ by typecheck
    have later : k ≤ add(k, i) by arith
    have step := antitone with add(k, i), position, later
    have shape : add(k, succ(i)) = succ(add(k, i)) by arith
    rw [(shiftedRealSequence.value with sequenceW, next),
      (shiftedRealSequence.value with sequenceW, iMember), shape]
    exact step
  have shiftedNonnegative : ∀ i ∈ ℕ, R[0] ≤ (shiftedRealSequence(w, k)(i):R)
    intros i iMember
    have iNat := nat.omega.backward with iMember
    have position : add(k, i) ∈ ℕ by typecheck
    have later : k ≤ add(k, i) by arith
    rw (shiftedRealSequence.value with sequenceW, iMember)
    exact nonnegative with add(k, i), position, later
  have bound := realPartialSum.abel_bound at shiftedRealSequence(u, k),
    shiftedRealSequence(w, k), shiftedRealSequence(mulSequence(u, w), k),
    R[2 * B], n with shiftedU, shiftedW, shiftedT, productValues,
    shiftedBounded, shiftedAntitone, shiftedNonnegative
  have zeroMember : (0:N) ∈ ℕ := nat.omega.forward at (0:N) with *
  have offset : add(k, (0:N)) = k by arith
  rw [(shiftedRealSequence.value with sequenceW, zeroMember), offset] at bound
  exact bound

-- ⌊(X + 1)/d⌋ = ⌊X/d⌋ + 1 when d ∣ X + 1, and ⌊X/d⌋ otherwise (d ≥ 1).
theorem quotientNat.succ_divides (X d : Nat)
  requires positive : 1 ≤ d
  requires divides : d ∣ succ(X)
  shows quotientNat(succ(X), d) = succ(quotientNat(X, d)) ∧
    d * succ(quotientNat(X, d)) = succ(X)
proof
  have nonzero : d ≠ (0:N) by arith
  have qNat := quotientNat.natural at d, X
  have qNextNat := quotientNat.natural at d, succ(X)
  obtain ⟨c, cNat, shape⟩ := divides
  have cPositive : 1 ≤ c
    by_contra zero
    have cZero : c = (0:N) by arith
    rw cZero at shape
    have product : mul(d, (0:N)) = (0:N) by ring
    rw product at shape
    arith
  obtain ⟨b, bNat, cShape⟩ := LessEqual.exists_add with cPositive
  have expand : mul(d, 1 + b) = d + mul(d, b) by ring
  rw [cShape, expand] at shape
  -- b = ⌊X/d⌋.
  have bBelow : b ≤ quotientNat(X, d)
    have bound : d * b ≤ X by arith
    exact (quotientNat.le_iff at d, X, b with nonzero).backward with bound
  have bAbove : quotientNat(X, d) ≤ b
    have self : quotientNat(X, d) ≤ quotientNat(X, d) by arith
    have bound := (quotientNat.le_iff at d, X, quotientNat(X, d) with
      nonzero).forward with self
    by_contra above
    have step : 1 + b ≤ quotientNat(X, d) by arith
    have scaled := LessEqual.mul_left at 1 + b, quotientNat(X, d), d with step
    rw expand at scaled
    arith
  have bSame : b = quotientNat(X, d) by arith
  -- c = ⌊(X + 1)/d⌋.
  have cBelow : 1 + b ≤ quotientNat(succ(X), d)
    have bound : d * (1 + b) ≤ succ(X)
      rw expand
      arith
    exact (quotientNat.le_iff at d, succ(X), 1 + b with nonzero).backward with
      bound
  have cAbove : quotientNat(succ(X), d) ≤ 1 + b
    have self : quotientNat(succ(X), d) ≤ quotientNat(succ(X), d) by arith
    have bound := (quotientNat.le_iff at d, succ(X), quotientNat(succ(X), d)
      with nonzero).forward with self
    by_contra above
    have step : 2 + b ≤ quotientNat(succ(X), d) by arith
    have scaled := LessEqual.mul_left at 2 + b, quotientNat(succ(X), d), d
      with step
    have expandTwo : mul(d, 2 + b) = d + d + mul(d, b) by ring
    rw expandTwo at scaled
    arith
  have next : quotientNat(succ(X), d) = succ(quotientNat(X, d)) by arith
  refine ⟨next, ?_⟩
  have shapeSucc : succ(quotientNat(X, d)) = 1 + b by arith
  rw [shapeSucc, expand]
  exact shape

theorem quotientNat.succ_not_divides (X d : Nat)
  requires positive : 1 ≤ d
  requires notDivides : ¬(d ∣ succ(X))
  shows quotientNat(succ(X), d) = quotientNat(X, d)
proof
  have nonzero : d ≠ (0:N) by arith
  have qNat := quotientNat.natural at d, X
  have qNextNat := quotientNat.natural at d, succ(X)
  have below : quotientNat(X, d) ≤ quotientNat(succ(X), d)
    have self : quotientNat(X, d) ≤ quotientNat(X, d) by arith
    have bound := (quotientNat.le_iff at d, X, quotientNat(X, d) with
      nonzero).forward with self
    have wider : d * quotientNat(X, d) ≤ succ(X) by arith
    exact (quotientNat.le_iff at d, succ(X), quotientNat(X, d) with
      nonzero).backward with wider
  have above : quotientNat(succ(X), d) ≤ quotientNat(X, d)
    have self : quotientNat(succ(X), d) ≤ quotientNat(succ(X), d) by arith
    have bound := (quotientNat.le_iff at d, succ(X), quotientNat(succ(X), d)
      with nonzero).forward with self
    by_cases exact : d * quotientNat(succ(X), d) = succ(X)
    . exfalso
      apply notDivides
      exact ⟨quotientNat(succ(X), d), qNextNat, exact⟩
    . have smaller : d * quotientNat(succ(X), d) ≤ X by arith
      exact (quotientNat.le_iff at d, X, quotientNat(succ(X), d) with
        nonzero).backward with smaller
  arith

-- 1/√(ab) = (1/√a)(1/√b).
theorem rootInverse.mul (a b : Nat)
  shows rootInverse(a * b) = R[rootInverse(a) * rootInverse(b)]
proof
  obtain ⟨rootA, nonnegativeA, squareA⟩ := natSqrt.facts at a
  obtain ⟨rootB, nonnegativeB, squareB⟩ := natSqrt.facts at b
  have productNonnegative := realMulValue.nonnegative with nonnegativeA,
    nonnegativeB
  have productSquare : R[(realSqrt(realNat(a)) * realSqrt(realNat(b))) *
      (realSqrt(realNat(a)) * realSqrt(realNat(b)))] = realNat(a * b)
    rw realNat.mul
    have regroup : R[(realSqrt(realNat(a)) * realSqrt(realNat(b))) *
        (realSqrt(realNat(a)) * realSqrt(realNat(b)))] =
      R[(realSqrt(realNat(a)) * realSqrt(realNat(a))) *
        (realSqrt(realNat(b)) * realSqrt(realNat(b)))] by ring
    rw [regroup, squareA, squareB]
  have root := realSqrt.eq_of_square with productNonnegative, productSquare
  rw [rootInverse.apply, rootInverse.apply, rootInverse.apply, root]
  by_cases zeroA : realSqrt(realNat(a)) = R[0]
  . rw [zeroA, realInvValue.zero]
    have zero : R[0 * realSqrt(realNat(b))] = R[0] by ring
    rw [zero, realInvValue.zero]
    have inverse := realInvValue.real at realSqrt(realNat(b))
    ring
  . by_cases zeroB : realSqrt(realNat(b)) = R[0]
    . rw [zeroB, realInvValue.zero]
      have zero : R[realSqrt(realNat(a)) * 0] = R[0] by ring
      rw [zero, realInvValue.zero]
      have inverse := realInvValue.real at realSqrt(realNat(a))
      ring
    . exact realInvValue.mul with zeroA, zeroB

-- B(q) = Σ_{e ≤ q} 1/√e is monotone.
theorem rootInverseSum.monotone (q k : Nat)
  shows rootInverseSum(q) ≤ rootInverseSum(q + k)
proof
  induction k
  | zero =>
    have same : q + (0:N) = q by arith
    rw same
    have sum := rootInverseSum.real at q
    linarith
  | succ(m) using ih =>
    have mNat : Nat(m) by typecheck
    have shape : add(q, succ(m)) = succ(add(q, m)) by arith
    rw [shape, rootInverseSum.succ]
    have term := rootInverse.nonnegative at succ(add(q, m))
    have sum := rootInverseSum.real at add(q, m)
    linarith

-- The weights d ↦ (1/√d) B(⌊X/d⌋) of the hyperbola sum.
defgraph hyperbolaWeights (X : Nat) (d ∈ ℕ) : ℝ :=
    R[rootInverse(d) * rootInverseSum(quotientNat(X, d))]
proof
  have dNat := nat.omega.backward with member
  have qNat := quotientNat.natural at d, X
  have root := rootInverse.real at d
  have sum := rootInverseSum.real at quotientNat(X, d)
  typecheck

theorem hyperbolaWeights.apply (X d : Nat)
  shows hyperbolaWeights(X)(d) =
    R[rootInverse(d) * rootInverseSum(quotientNat(X, d))]
proof
  have member : d ∈ ℕ := nat.omega.forward at d with *
  exact hyperbolaWeights.value with member

theorem hyperbolaWeights.sequence (X : Nat)
  shows RealSequence(hyperbolaWeights(X))
proof
  unfold RealSequence
  exact hyperbolaWeights.function at X

-- n ↦ Σ_{d ∣ n} u(d) as a sequence.
defgraph divisorSums (u : Set) (n ∈ ℕ) : ℝ := divisorSumReal(u, n)
requires sequence : RealSequence(u)
proof
  have nNat := nat.omega.backward with member
  exact divisorSumReal.real with sequence

-- Termwise v = w + c z gives Σ v = Σ w + c Σ z.
theorem realPartialSum.eq_add_scaled (v w z : Set) (c : Real) (n : Nat)
  requires sequenceV : RealSequence(v)
  requires sequenceW : RealSequence(w)
  requires sequenceZ : RealSequence(z)
  shows (∀ j ∈ ℕ, j < n → (v(j):R) = R[w(j) + c * z(j)]) →
    realPartialSum(v, n) = R[realPartialSum(w, n) + c * realPartialSum(z, n)]
proof
  induction n
  | zero =>
    intro same
    rw [realPartialSum.zero, realPartialSum.zero, realPartialSum.zero]
    ring
  | succ(m) using ih =>
    intro same
    have earlier : ∀ j ∈ ℕ, j < m → (v(j):R) = R[w(j) + c * z(j)]
      intros j jMember below
      have wider : j < succ(m) by arith
      exact same with j, jMember, wider
    have previous := ih with earlier
    have mMember : m ∈ ℕ := nat.omega.forward at m with *
    have last : m < succ(m) by arith
    have lastSame := same with m, mMember, last
    have sumW := realPartialSum.real at w, m with sequenceW
    have sumZ := realPartialSum.real at z, m with sequenceZ
    have termW := RealSequence.value at w, m with sequenceW
    have termZ := RealSequence.value at z, m with sequenceZ
    rw [realPartialSum.succ, realPartialSum.succ, realPartialSum.succ,
      previous, lastSame]
    ring

theorem rootInverseSum.one
  shows rootInverseSum(succ((0:N))) = R[1]
proof
  have zeroSum : rootInverseSum((0:N)) = R[0]
    unfold rootInverseSum
    rw [realPartialSum.succ, realPartialSum.zero, rootInverse.zero]
    ring
  rw [rootInverseSum.succ, zeroSum, ← natural.one_succ, rootInverse.one]
  ring

-- Passing from X to X + 1 adds 1/√(X + 1) at each divisor of X + 1.
theorem hyperbolaWeights.step (u : Set) (X j : Nat)
  requires sequence : RealSequence(u)
  shows (mulSequence(u, hyperbolaWeights(succ(X)))(j):R) =
    R[mulSequence(u, hyperbolaWeights(X))(j) +
      rootInverse(succ(X)) * maskedTerms(divisorSet(succ(X)), u)(j)]
proof
  have weightsNext := hyperbolaWeights.sequence at succ(X)
  have weights := hyperbolaWeights.sequence at X
  have uValue := RealSequence.value at u, j with sequence
  have next := RealSequence.value at hyperbolaWeights(succ(X)), j with
    weightsNext
  have current := RealSequence.value at hyperbolaWeights(X), j with weights
  have jMember : j ∈ ℕ := nat.omega.forward at j with *
  have qNat := quotientNat.natural at j, X
  have qNextNat := quotientNat.natural at j, succ(X)
  have sum := rootInverseSum.real at quotientNat(X, j)
  have sumNext := rootInverseSum.real at quotientNat(succ(X), j)
  have rootNext := rootInverse.real at succ(X)
  rw [(mulSequence.value with sequence, weightsNext, uValue, next),
    (mulSequence.value with sequence, weights, uValue, current),
    hyperbolaWeights.apply, hyperbolaWeights.apply]
  by_cases zero : j = (0:N)
  . have outside : ¬(j ∈ divisorSet(succ(X)))
      intro inside
      obtain ⟨_, divides⟩ := divisorSet.membership.forward with inside
      rw zero at divides
      obtain ⟨c, cNat, shape⟩ := divides
      have product : mul((0:N), c) = (0:N) by arith
      rw product at shape
      arith
    rw [(maskedTerms.outside with sequence, outside), zero, rootInverse.zero]
    ring
  . have positive : 1 ≤ j by arith
    have root := rootInverse.real at j
    by_cases divides : j ∣ succ(X)
    . obtain ⟨quotient, product⟩ := quotientNat.succ_divides with positive,
        divides
      have inside := divisorSet.membership.backward with ⟨jMember, divides⟩
      have multiplied := rootInverse.mul at j, succ(quotientNat(X, j))
      rw product at multiplied
      have rootQuotient := rootInverse.real at succ(quotientNat(X, j))
      rw [(maskedTerms.inside with sequence, inside), quotient,
        rootInverseSum.succ, multiplied]
      ring
    . have same := quotientNat.succ_not_divides with positive, divides
      have outside : ¬(j ∈ divisorSet(succ(X)))
        intro inside
        obtain ⟨_, again⟩ := divisorSet.membership.forward with inside
        exact divides with again
      rw [(maskedTerms.outside with sequence, outside), same]
      ring

-- The hyperbola identity: Σ_{d ≤ X} u(d) (1/√d) B(⌊X/d⌋) =
-- Σ_{n ≤ X} (1/√n) Σ_{d ∣ n} u(d).
theorem hyperbola.divisor_form (u : Set) (X : Nat)
  requires sequence : RealSequence(u)
  shows realPartialSum(mulSequence(u, hyperbolaWeights(X)), succ(X)) =
    realPartialSum(mulSequence(rootInverse, divisorSums(u)), succ(X))
proof
  induction X
  | zero =>
    have root := rootInverse.sequence
    have sums := divisorSums.function at u with sequence
    have sumsSequence : RealSequence(divisorSums(u)) by exact sums
    have right := mulSequence.sequence with root, sumsSequence
    have weights := hyperbolaWeights.sequence at (0:N)
    have left := mulSequence.sequence with sequence, weights
    have zeroMember : (0:N) ∈ ℕ := nat.omega.forward at (0:N) with *
    have uValue := RealSequence.value at u, (0:N) with sequence
    have weight := RealSequence.value at hyperbolaWeights((0:N)), (0:N) with
      weights
    have rootZero := rootInverse.real at (0:N)
    have sumZero := RealSequence.value at divisorSums(u), (0:N) with
      sumsSequence
    have qNat := quotientNat.natural at (0:N), (0:N)
    have sum := rootInverseSum.real at quotientNat((0:N), (0:N))
    rw [realPartialSum.succ, realPartialSum.succ, realPartialSum.zero,
      realPartialSum.zero, (mulSequence.value with sequence, weights, uValue,
      weight), (mulSequence.value with root, sumsSequence, rootZero, sumZero),
      hyperbolaWeights.apply, rootInverse.zero]
    ring
  | succ(Y) using ih =>
    have root := rootInverse.sequence
    have sums := divisorSums.function at u with sequence
    have sumsSequence : RealSequence(divisorSums(u)) by exact sums
    have right := mulSequence.sequence with root, sumsSequence
    have weights := hyperbolaWeights.sequence at Y
    have weightsNext := hyperbolaWeights.sequence at succ(Y)
    have left := mulSequence.sequence with sequence, weights
    have leftNext := mulSequence.sequence with sequence, weightsNext
    have masked := maskedTerms.sequence at divisorSet(succ(Y)), u with
      sequence
    have pointwise : ∀ j ∈ ℕ, j < succ(succ(Y)) →
        (mulSequence(u, hyperbolaWeights(succ(Y)))(j):R) =
        R[mulSequence(u, hyperbolaWeights(Y))(j) +
          rootInverse(succ(Y)) * maskedTerms(divisorSet(succ(Y)), u)(j)]
      intros j jMember below
      have jNat := nat.omega.backward with jMember
      exact hyperbolaWeights.step at u, Y, j with sequence
    have rootNext := rootInverse.real at succ(Y)
    have split := realPartialSum.eq_add_scaled at
      mulSequence(u, hyperbolaWeights(succ(Y))),
      mulSequence(u, hyperbolaWeights(Y)),
      maskedTerms(divisorSet(succ(Y)), u), rootInverse(succ(Y)),
      succ(succ(Y)) with leftNext, left, masked, pointwise
    -- The old weights vanish at Y + 1: ⌊Y/(Y + 1)⌋ = 0 and B(0) = 0.
    have lastOld : mulSequence(u, hyperbolaWeights(Y))(succ(Y)) = R[0]
      have uValue := RealSequence.value at u, succ(Y) with sequence
      have weight := RealSequence.value at hyperbolaWeights(Y), succ(Y) with
        weights
      have nonzero : succ(Y) ≠ (0:N) by arith
      have quotient : quotientNat(Y, succ(Y)) = (0:N)
        have qNat := quotientNat.natural at succ(Y), Y
        by_contra positive
        have atLeast : 1 ≤ quotientNat(Y, succ(Y)) by arith
        have bound := (quotientNat.le_iff at succ(Y), Y, 1 with
          nonzero).forward with atLeast
        arith
      have zeroSum : rootInverseSum((0:N)) = R[0]
        unfold rootInverseSum
        rw [realPartialSum.succ, realPartialSum.zero, rootInverse.zero]
        ring
      have rootValue := rootInverse.real at succ(Y)
      rw [(mulSequence.value with sequence, weights, uValue, weight),
        hyperbolaWeights.apply, quotient, zeroSum]
      ring
    have sumNext := RealSequence.value at divisorSums(u), succ(Y) with
      sumsSequence
    have nextMember : succ(Y) ∈ ℕ := nat.omega.forward at succ(Y) with *
    have previous := realPartialSum.real at mulSequence(u, hyperbolaWeights(Y)),
      succ(Y) with left
    have previousRight := realPartialSum.real at mulSequence(rootInverse,
      divisorSums(u)), succ(Y) with right
    have divisorTotal := divisorSumReal.real at u, succ(Y) with sequence
    rw [split, (realPartialSum.succ at mulSequence(u, hyperbolaWeights(Y)),
      succ(Y)), lastOld, ih, (realPartialSum.succ at mulSequence(rootInverse,
      divisorSums(u)), succ(Y)), (mulSequence.value with root, sumsSequence,
      rootNext, sumNext), (divisorSums.value with sequence, nextMember)]
    unfold divisorSumReal
    ring

-- Section: The estimates for a real character
-- √(K²) = K.
theorem natSqrt.square (K : Nat)
  shows realSqrt(realNat(K * K)) = realNat(K)
proof
  have nonnegative := realNat.nonnegative at K
  have square : R[realNat(K) * realNat(K)] = realNat(K * K)
    rw realNat.mul
  exact realSqrt.eq_of_square with nonnegative, square

-- √d (1/√d) = 1 for d ≥ 1.
theorem rootInverse.cancel (d : Nat)
  requires positive : 1 ≤ d
  shows R[realSqrt(realNat(d)) * rootInverse(d)] = R[1]
proof
  have rootPositive := natSqrt.positive with positive
  have nonzero : realSqrt(realNat(d)) ≠ R[0] by linarith
  rw rootInverse.apply
  exact realInvValue.mul_right with nonzero

-- For 1 ≤ d ≤ K and J = ⌊K²/d⌋: 2√J ≤ 2K/√d ≤ 2√J + 1/√J.
theorem hyperbola.root_window (K d : Nat)
  requires positiveD : 1 ≤ d
  requires below : d ≤ K
  shows R[2 * realSqrt(realNat(quotientNat(K * K, d)))] ≤
      R[2 * realNat(K) * rootInverse(d)] ∧
    R[2 * realNat(K) * rootInverse(d)] ≤
      R[2 * realSqrt(realNat(quotientNat(K * K, d))) +
        rootInverse(quotientNat(K * K, d))]
proof
  have nonzero : d ≠ (0:N) by arith
  have jNat := quotientNat.natural at d, K * K
  have self : quotientNat(K * K, d) ≤ quotientNat(K * K, d) by arith
  have lower := (quotientNat.le_iff at d, K * K, quotientNat(K * K, d) with
    nonzero).forward with self
  have notNext : ¬(succ(quotientNat(K * K, d)) ≤ quotientNat(K * K, d)) by
    arith
  have upper : K * K < mul(d, succ(quotientNat(K * K, d)))
    by_contra notUpper
    have atMost : mul(d, succ(quotientNat(K * K, d))) ≤ K * K by arith
    exact notNext with ((quotientNat.le_iff at d, K * K,
      succ(quotientNat(K * K, d)) with nonzero).backward with atMost)
  have jPositive : 1 ≤ quotientNat(K * K, d)
    have bound : d * K ≤ K * K
      exact LessEqual.mul_right at d, K, K with below
    have atLeast := (quotientNat.le_iff at d, K * K, K with nonzero).backward
      with bound
    have kPositive : 1 ≤ K by arith
    arith
  obtain ⟨a, aNonnegative, aSquare⟩ := natSqrt.facts at quotientNat(K * K, d)
  obtain ⟨b, bNonnegative, bSquare⟩ := natSqrt.facts at
    succ(quotientNat(K * K, d))
  obtain ⟨sd, sNonnegative, sSquare⟩ := natSqrt.facts at d
  have kNonnegative := realNat.nonnegative at K
  have cancel := rootInverse.cancel with positiveD
  have rootD := rootInverse.real at d
  have rootJ := rootInverse.real at quotientNat(K * K, d)
  have rootDNonnegative := rootInverse.nonnegative at d
  have aPositive := natSqrt.positive with jPositive
  -- a √d ≤ K and K ≤ b √d, comparing squares.
  have lowerReal := realNat.le_of_natural_le with lower
  rw [realNat.mul, realNat.mul] at lowerReal
  have upperStep : succ(K * K) ≤ mul(d, succ(quotientNat(K * K, d))) by arith
  have upperReal := realNat.le_of_natural_le with upperStep
  have leftValue : realNat(succ(K * K)) = R[realNat(K) * realNat(K) + 1]
    rw [realNat.succ_add, realNat.mul]
  have rightValue : realNat(mul(d, succ(quotientNat(K * K, d)))) =
      R[realNat(d) * realNat(quotientNat(K * K, d)) + realNat(d)]
    rw [realNat.mul, realNat.succ_add]
    have jReal := realNat.real at quotientNat(K * K, d)
    have dReal := realNat.real at d
    ring
  have productA := realMulValue.nonnegative with aNonnegative, sNonnegative
  have productB := realMulValue.nonnegative with bNonnegative, sNonnegative
  have squareA : R[(realSqrt(realNat(quotientNat(K * K, d))) *
      realSqrt(realNat(d))) * (realSqrt(realNat(quotientNat(K * K, d))) *
      realSqrt(realNat(d)))] ≤ R[realNat(K) * realNat(K)]
    have regroup : R[(realSqrt(realNat(quotientNat(K * K, d))) *
        realSqrt(realNat(d))) * (realSqrt(realNat(quotientNat(K * K, d))) *
        realSqrt(realNat(d)))] = R[(realSqrt(realNat(quotientNat(K * K, d))) *
        realSqrt(realNat(quotientNat(K * K, d)))) * (realSqrt(realNat(d)) *
        realSqrt(realNat(d)))] by ring
    rw [regroup, aSquare, sSquare]
    have commute : R[realNat(quotientNat(K * K, d)) * realNat(d)] =
      R[realNat(d) * realNat(quotientNat(K * K, d))] by ring
    rw commute
    exact lowerReal
  have aBound := realMulValue.le_of_square_le with productA, kNonnegative,
    squareA
  have squareB : R[realNat(K) * realNat(K)] ≤
      R[(realSqrt(realNat(succ(quotientNat(K * K, d)))) *
      realSqrt(realNat(d))) * (realSqrt(realNat(succ(quotientNat(K * K, d)))) *
      realSqrt(realNat(d)))]
    have regroup : R[(realSqrt(realNat(succ(quotientNat(K * K, d)))) *
        realSqrt(realNat(d))) * (realSqrt(realNat(succ(quotientNat(K * K, d))))
        * realSqrt(realNat(d)))] =
      R[(realSqrt(realNat(succ(quotientNat(K * K, d)))) *
        realSqrt(realNat(succ(quotientNat(K * K, d))))) *
        (realSqrt(realNat(d)) * realSqrt(realNat(d)))] by ring
    rw [regroup, bSquare, sSquare, realNat.succ_add]
    have expand : R[(realNat(quotientNat(K * K, d)) + 1) * realNat(d)] =
      R[realNat(d) * realNat(quotientNat(K * K, d)) + realNat(d)] by ring
    linarith
  have bBound := realMulValue.le_of_square_le with kNonnegative, productB,
    squareB
  -- Divide by √d.
  have scaledA := realLe.mul_right_of_nonnegative with aBound, rootDNonnegative
  have scaledB := realLe.mul_right_of_nonnegative with bBound, rootDNonnegative
  have unitA : R[realSqrt(realNat(quotientNat(K * K, d))) *
      realSqrt(realNat(d)) * rootInverse(d)] =
      realSqrt(realNat(quotientNat(K * K, d)))
    by linear_combination realSqrt(realNat(quotientNat(K * K, d))) * cancel
  have unitB : R[realSqrt(realNat(succ(quotientNat(K * K, d)))) *
      realSqrt(realNat(d)) * rootInverse(d)] =
      realSqrt(realNat(succ(quotientNat(K * K, d))))
    by linear_combination realSqrt(realNat(succ(quotientNat(K * K, d)))) *
      cancel
  have step := natSqrt.succ_square at quotientNat(K * K, d)
  have gap := sqrtStep.upper with aPositive, step
  rw ← rootInverse.apply at gap
  have first : realSqrt(realNat(quotientNat(K * K, d))) ≤
    R[realNat(K) * rootInverse(d)] by linarith
  have second : R[realNat(K) * rootInverse(d)] ≤
    realSqrt(realNat(succ(quotientNat(K * K, d)))) by linarith
  have regroup : R[2 * realNat(K) * rootInverse(d)] =
    R[2 * (realNat(K) * rootInverse(d))] by ring
  rw regroup
  constructor
  . linarith
  . linarith

-- For 1 ≤ d ≤ K and J = ⌊K²/d⌋: (1/√d)(1/√J) ≤ 2/K, since 2 d J ≥ K².
theorem hyperbola.root_product (K d : Nat)
  requires positiveD : 1 ≤ d
  requires below : d ≤ K
  shows R[rootInverse(d) * rootInverse(quotientNat(K * K, d))] ≤
    R[2 * realInvValue(realNat(K))]
proof
  have nonzero : d ≠ (0:N) by arith
  have jNat := quotientNat.natural at d, K * K
  have self : quotientNat(K * K, d) ≤ quotientNat(K * K, d) by arith
  have notNext : ¬(succ(quotientNat(K * K, d)) ≤ quotientNat(K * K, d)) by
    arith
  have upper : succ(K * K) ≤ mul(d, succ(quotientNat(K * K, d)))
    by_contra notUpper
    have atMost : mul(d, succ(quotientNat(K * K, d))) ≤ K * K by arith
    exact notNext with ((quotientNat.le_iff at d, K * K,
      succ(quotientNat(K * K, d)) with nonzero).backward with atMost)
  have upperReal := realNat.le_of_natural_le with upper
  have leftValue : realNat(succ(K * K)) = R[realNat(K) * realNat(K) + 1]
    rw [realNat.succ_add, realNat.mul]
  have rightValue : realNat(mul(d, succ(quotientNat(K * K, d)))) =
      R[realNat(d * quotientNat(K * K, d)) + realNat(d)]
    rw [realNat.mul, realNat.succ_add, realNat.mul]
    have jReal := realNat.real at quotientNat(K * K, d)
    have dReal := realNat.real at d
    ring
  have dBelow := realNat.le_of_natural_le with below
  have kReal := realNat.real at K
  have square := NonnegativeReal.le with
    (realMulValue.square_nonnegative_real at R[realNat(K) - 1])
  have expandSquare : R[(realNat(K) - 1) * (realNat(K) - 1)] =
    R[realNat(K) * realNat(K) - 2 * realNat(K) + 1] by ring
  have productReal := realNat.real at d * quotientNat(K * K, d)
  have twice : R[realNat(K) * realNat(K)] ≤
      R[2 * realNat(d * quotientNat(K * K, d))] by linarith
  -- y = K (1/√(dJ)) has y² = K²/(dJ) ≤ 2.
  have productPositive : 1 ≤ d * quotientNat(K * K, d)
    have kPositive : 1 ≤ K by arith
    have bound : d * K ≤ K * K := LessEqual.mul_right at d, K, K with below
    have atLeast := (quotientNat.le_iff at d, K * K, K with nonzero).backward
      with bound
    have scaled := LessEqual.mul_left at 1, quotientNat(K * K, d), d with
      (LessEqual.transitive with kPositive, atLeast)
    arith
  have pPositive : R[0] < realNat(d * quotientNat(K * K, d))
    have pNonzero : d * quotientNat(K * K, d) ≠ (0:N) by arith
    exact realNat.positive with pNonzero
  have pNonzero : realNat(d * quotientNat(K * K, d)) ≠ R[0] by linarith
  have cancel := realInvValue.mul_right with pNonzero
  have inversePositive := realInvValue.positive with pPositive
  have inverseNonnegative : R[0] ≤
    realInvValue(realNat(d * quotientNat(K * K, d))) by linarith
  have gapNonnegative : R[0] ≤ R[2 * realNat(d * quotientNat(K * K, d)) -
    realNat(K) * realNat(K)] by linarith
  have gapProduct := realMulValue.nonnegative with inverseNonnegative,
    gapNonnegative
  have expandGap : R[realInvValue(realNat(d * quotientNat(K * K, d))) *
      (2 * realNat(d * quotientNat(K * K, d)) - realNat(K) * realNat(K))] =
      R[2 - realNat(K) * realNat(K) *
        realInvValue(realNat(d * quotientNat(K * K, d)))]
    by linear_combination 2 * cancel
  have root := rootInverse.mul at d, quotientNat(K * K, d)
  have rootSquare := rootInverse.square at d * quotientNat(K * K, d)
  have rootP := rootInverse.real at d * quotientNat(K * K, d)
  have rootPNonnegative := rootInverse.nonnegative at d * quotientNat(K * K, d)
  have kNonnegative := realNat.nonnegative at K
  have yNonnegative := realMulValue.nonnegative with kNonnegative,
    rootPNonnegative
  have two : R[0] ≤ R[2] by linarith
  have ySquare : R[(realNat(K) * rootInverse(d * quotientNat(K * K, d))) *
      (realNat(K) * rootInverse(d * quotientNat(K * K, d)))] ≤ R[2 * 2]
    have regroup : R[(realNat(K) * rootInverse(d * quotientNat(K * K, d))) *
        (realNat(K) * rootInverse(d * quotientNat(K * K, d)))] =
      R[realNat(K) * realNat(K) * (rootInverse(d * quotientNat(K * K, d)) *
        rootInverse(d * quotientNat(K * K, d)))] by ring
    rw [regroup, rootSquare]
    linarith
  have yBound := realMulValue.le_of_square_le with yNonnegative, two, ySquare
  have kPositive : R[0] < realNat(K)
    have kNonzero : K ≠ (0:N) by arith
    exact realNat.positive with kNonzero
  have kNonzero : realNat(K) ≠ R[0] by linarith
  have kCancel := realInvValue.mul_right with kNonzero
  have kInverse := realInvValue.positive with kPositive
  have kInverseNonnegative : R[0] ≤ realInvValue(realNat(K)) by linarith
  have scaled := realLe.mul_right_of_nonnegative with yBound,
    kInverseNonnegative
  have unit : R[realNat(K) * rootInverse(d * quotientNat(K * K, d)) *
      realInvValue(realNat(K))] = rootInverse(d * quotientNat(K * K, d))
    by linear_combination rootInverse(d * quotientNat(K * K, d)) * kCancel
  rw ← root
  linarith

-- |t x| ≤ e for t ∈ {0, 1, −1} and |x| ≤ e.
theorem sign.mul_bound (t x e : Real)
  requires values : t = R[0] ∨ t = R[1] ∨ t = R[-1]
  requires low : R[-e] ≤ x
  requires high : x ≤ e
  shows abs(R[t * x]) ≤ e
proof
  have product : R[t * x] = R[0] ∨ R[t * x] = x ∨ R[t * x] = R[-x]
    cases values with zero | rest
    . left
      linear_combination x * zero
    . cases rest with one | minus
      . right
        left
        linear_combination x * one
      . right
        right
        linear_combination x * minus
  apply abs.le_of_bounds
  . cases product with zero | rest
    . linarith
    . cases rest with same | negated
      . linarith
      . linarith
  . cases product with zero | rest
    . linarith
    . cases rest with same | negated
      . linarith
      . linarith

-- For 1 ≤ d ≤ K: u(d) (1/√d) B(⌊K²/d⌋) is 2K u(d)/d + (B(K²) − 2K) u(d)/√d
-- up to 2/K.
theorem hyperbola.term_near (u : Set) (K d : Nat)
  requires character : SignCharacter(u)
  requires positiveD : 1 ≤ d
  requires below : d ≤ K
  shows abs(R[mulSequence(u, hyperbolaWeights(K * K))(d) -
    2 * realNat(K) * mulSequence(u, mulSequence(rootInverse, rootInverse))(d) -
    (rootInverseSum(K * K) - 2 * realNat(K)) * mulSequence(u, rootInverse)(d)])
    ≤ R[2 * realInvValue(realNat(K))]
proof
  have characterCopy := character
  obtain ⟨sequence, _, _, values⟩ := characterCopy
  have nonzero : d ≠ (0:N) by arith
  have root := rootInverse.sequence
  have squares := mulSequence.sequence with root, root
  have weights := hyperbolaWeights.sequence at K * K
  have dMember : d ∈ ℕ := nat.omega.forward at d with *
  have uValue := RealSequence.value at u, d with sequence
  have rootD := rootInverse.real at d
  have squareD := RealSequence.value at mulSequence(rootInverse, rootInverse),
    d with squares
  have weightD := RealSequence.value at hyperbolaWeights(K * K), d with weights
  rw [(mulSequence.value with sequence, weights, uValue, weightD),
    (mulSequence.value with sequence, squares, uValue, squareD),
    (mulSequence.value with root, root, rootD, rootD),
    (mulSequence.value with sequence, root, uValue, rootD),
    hyperbolaWeights.apply]
  -- J = ⌊K²/d⌋ lies in [1, K²].
  have jNat := quotientNat.natural at d, K * K
  have self : quotientNat(K * K, d) ≤ quotientNat(K * K, d) by arith
  have lower := (quotientNat.le_iff at d, K * K, quotientNat(K * K, d) with
    nonzero).forward with self
  have jPositive : 1 ≤ quotientNat(K * K, d)
    have bound : d * K ≤ K * K := LessEqual.mul_right at d, K, K with below
    have atLeast := (quotientNat.le_iff at d, K * K, K with nonzero).backward
      with bound
    have kPositive : 1 ≤ K by arith
    arith
  have jBelow : quotientNat(K * K, d) ≤ K * K
    have scaled := LessEqual.mul_right at 1, d, quotientNat(K * K, d) with
      positiveD
    arith
  obtain ⟨windowLow, windowHigh⟩ := rootInverseSum.window with jPositive,
    jBelow
  rw natSqrt.square at windowLow
  rw natSqrt.square at windowHigh
  obtain ⟨rootLow, rootHigh⟩ := hyperbola.root_window with positiveD, below
  have product := hyperbola.root_product with positiveD, below
  -- δ = B(J) − 2K/√d − (B(K²) − 2K) lies in [−1/√J, 1/√J].
  have rootJ := rootInverse.real at quotientNat(K * K, d)
  have rootJNonnegative := rootInverse.nonnegative at quotientNat(K * K, d)
  have rootDNonnegative := rootInverse.nonnegative at d
  have sumJ := rootInverseSum.real at quotientNat(K * K, d)
  have sumX := rootInverseSum.real at K * K
  obtain ⟨sqrtJ, _, _⟩ := natSqrt.facts at quotientNat(K * K, d)
  have kReal := realNat.real at K
  have deltaLow : R[-rootInverse(quotientNat(K * K, d))] ≤
      R[rootInverseSum(quotientNat(K * K, d)) - 2 * realNat(K) * rootInverse(d)
        - (rootInverseSum(K * K) - 2 * realNat(K))] by linarith
  have deltaHigh : R[rootInverseSum(quotientNat(K * K, d)) -
      2 * realNat(K) * rootInverse(d) - (rootInverseSum(K * K) -
      2 * realNat(K))] ≤ rootInverse(quotientNat(K * K, d)) by linarith
  have scaledLow := realLe.mul_left_of_nonnegative with deltaLow,
    rootDNonnegative
  have scaledHigh := realLe.mul_left_of_nonnegative with deltaHigh,
    rootDNonnegative
  have negated : R[rootInverse(d) * -rootInverse(quotientNat(K * K, d))] =
    R[-(rootInverse(d) * rootInverse(quotientNat(K * K, d)))] by ring
  have expression : R[u(d) * (rootInverse(d) *
      rootInverseSum(quotientNat(K * K, d))) - 2 * realNat(K) * (u(d) *
      (rootInverse(d) * rootInverse(d))) - (rootInverseSum(K * K) -
      2 * realNat(K)) * (u(d) * rootInverse(d))] =
    R[u(d) * (rootInverse(d) * (rootInverseSum(quotientNat(K * K, d)) -
      2 * realNat(K) * rootInverse(d) - (rootInverseSum(K * K) -
      2 * realNat(K))))] by ring
  rw expression
  have inverseK := realInvValue.real at realNat(K)
  have productReal : Real(R[rootInverse(d) *
    (rootInverseSum(quotientNat(K * K, d)) - 2 * realNat(K) * rootInverse(d) -
    (rootInverseSum(K * K) - 2 * realNat(K)))]) by typecheck
  have low : R[-(2 * realInvValue(realNat(K)))] ≤ R[rootInverse(d) *
      (rootInverseSum(quotientNat(K * K, d)) - 2 * realNat(K) * rootInverse(d)
      - (rootInverseSum(K * K) - 2 * realNat(K)))] by linarith
  have high : R[rootInverse(d) * (rootInverseSum(quotientNat(K * K, d)) -
      2 * realNat(K) * rootInverse(d) - (rootInverseSum(K * K) -
      2 * realNat(K)))] ≤ R[2 * realInvValue(realNat(K))] by linarith
  have cases := values with d, dMember
  exact sign.mul_bound with cases, low, high

-- Termwise |v − c₁ w₁ − c₂ w₂| ≤ E below n sums to n E.
theorem realPartialSum.approx (v w z : Set) (b c E : Real) (n : Nat)
  requires sequenceV : RealSequence(v)
  requires sequenceW : RealSequence(w)
  requires sequenceZ : RealSequence(z)
  shows (∀ j ∈ ℕ, j < n → abs(R[v(j) - b * w(j) - c * z(j)]) ≤ E) →
    abs(R[realPartialSum(v, n) - b * realPartialSum(w, n) -
      c * realPartialSum(z, n)]) ≤ R[realNat(n) * E]
proof
  induction n
  | zero =>
    intro bound
    rw [realPartialSum.zero, realPartialSum.zero, realPartialSum.zero,
      realNat.zero]
    have zero : R[0 - b * 0 - c * 0] = R[0] by ring
    have zeroE : R[0 * E] = R[0] by ring
    rw [zero, zeroE, abs.zero]
    linarith
  | succ(m) using ih =>
    intro bound
    have earlier : ∀ j ∈ ℕ, j < m → abs(R[v(j) - b * w(j) - c * z(j)]) ≤ E
      intros j jMember below
      have wider : j < succ(m) by arith
      exact bound with j, jMember, wider
    have previous := ih with earlier
    have mMember : m ∈ ℕ := nat.omega.forward at m with *
    have last : m < succ(m) by arith
    have lastBound := bound with m, mMember, last
    have sumV := realPartialSum.real at v, m with sequenceV
    have sumW := realPartialSum.real at w, m with sequenceW
    have sumZ := realPartialSum.real at z, m with sequenceZ
    have termV := RealSequence.value at v, m with sequenceV
    have termW := RealSequence.value at w, m with sequenceW
    have termZ := RealSequence.value at z, m with sequenceZ
    have shape : R[realAddValue(realPartialSum(v, m), v(m)) -
        b * realAddValue(realPartialSum(w, m), w(m)) -
        c * realAddValue(realPartialSum(z, m), z(m))] =
      R[(realPartialSum(v, m) - b * realPartialSum(w, m) -
        c * realPartialSum(z, m)) + (v(m) - b * w(m) - c * z(m))] by ring
    rw [realPartialSum.succ, realPartialSum.succ, realPartialSum.succ, shape,
      realNat.succ_add]
    have triangle := abs.triangle at R[realPartialSum(v, m) -
      b * realPartialSum(w, m) - c * realPartialSum(z, m)],
      R[v(m) - b * w(m) - c * z(m)]
    have expand : R[(realNat(m) + 1) * E] = R[realNat(m) * E + E] by ring
    rw expand
    linarith

-- The part d ≤ K of the hyperbola sum at X = K².
theorem hyperbola.near_part (u : Set) (K : Nat)
  requires character : SignCharacter(u)
  requires positive : 1 ≤ K
  shows abs(R[realPartialSum(mulSequence(u, hyperbolaWeights(K * K)), succ(K))
    - 2 * realNat(K) * realPartialSum(mulSequence(u,
      mulSequence(rootInverse, rootInverse)), succ(K)) -
    (rootInverseSum(K * K) - 2 * realNat(K)) *
      realPartialSum(mulSequence(u, rootInverse), succ(K))]) ≤ R[4]
proof
  have characterCopy := character
  obtain ⟨sequence, _, _, _⟩ := characterCopy
  have root := rootInverse.sequence
  have squares := mulSequence.sequence with root, root
  have weights := hyperbolaWeights.sequence at K * K
  have first := mulSequence.sequence with sequence, weights
  have second := mulSequence.sequence with sequence, squares
  have third := mulSequence.sequence with sequence, root
  have kPositive : R[0] < realNat(K)
    have kNonzero : K ≠ (0:N) by arith
    exact realNat.positive with kNonzero
  have kNonzero : realNat(K) ≠ R[0] by linarith
  have kCancel := realInvValue.mul_right with kNonzero
  have kInverse := realInvValue.positive with kPositive
  have sumX := rootInverseSum.real at K * K
  have kReal := realNat.real at K
  have approx := realPartialSum.approx at mulSequence(u,
    hyperbolaWeights(K * K)), mulSequence(u, mulSequence(rootInverse,
    rootInverse)), mulSequence(u, rootInverse), R[2 * realNat(K)],
    R[rootInverseSum(K * K) - 2 * realNat(K)],
    R[2 * realInvValue(realNat(K))], succ(K) with first, second, third
  have terms : ∀ j ∈ ℕ, j < succ(K) → abs(R[mulSequence(u,
      hyperbolaWeights(K * K))(j) - 2 * realNat(K) * mulSequence(u,
      mulSequence(rootInverse, rootInverse))(j) - (rootInverseSum(K * K) -
      2 * realNat(K)) * mulSequence(u, rootInverse)(j)]) ≤
      R[2 * realInvValue(realNat(K))]
    intros j jMember below
    have jNat := nat.omega.backward with jMember
    by_cases zero : j = (0:N)
    . have uValue := RealSequence.value at u, j with sequence
      have rootJ := rootInverse.real at j
      have squareJ := RealSequence.value at mulSequence(rootInverse,
        rootInverse), j with squares
      have weightJ := RealSequence.value at hyperbolaWeights(K * K), j with
        weights
      have qNat := quotientNat.natural at j, K * K
      have sumJ := rootInverseSum.real at quotientNat(K * K, j)
      rw [(mulSequence.value with sequence, weights, uValue, weightJ),
        (mulSequence.value with sequence, squares, uValue, squareJ),
        (mulSequence.value with root, root, rootJ, rootJ),
        (mulSequence.value with sequence, root, uValue, rootJ),
        hyperbolaWeights.apply, zero, rootInverse.zero]
      have vanish : R[u((0:N)) * (0 * rootInverseSum(quotientNat(K * K,
          (0:N)))) - 2 * realNat(K) * (u((0:N)) * (0 * 0)) -
          (rootInverseSum(K * K) - 2 * realNat(K)) * (u((0:N)) * 0)] = R[0]
        rw zero at uValue
        rw zero at sumJ
        ring
      rw [vanish, abs.zero]
      linarith
    . have jPositive : 1 ≤ j by arith
      have jBelow : j ≤ K by arith
      exact hyperbola.term_near with character, jPositive, jBelow
  have bound := approx with terms
  have total : R[realNat(succ(K)) * (2 * realInvValue(realNat(K)))] ≤ R[4]
    rw realNat.succ_add
    have expand : R[(realNat(K) + 1) * (2 * realInvValue(realNat(K)))] =
        R[2 + 2 * realInvValue(realNat(K))]
      by linear_combination 2 * kCancel
    have oneLe : R[1] ≤ realNat(K)
      have cast := realNat.le_of_natural_le with positive
      rw realNat.one at cast
      exact cast
    have onePositive : R[0] < R[1] by linarith
    have inverseLe := realInvValue.antitone_le with onePositive, oneLe
    rw realInvValue.one at inverseLe
    rw expand
    linarith
  linarith

-- 1/√· is antitone from 1 on.
theorem rootInverse.antitone (i : Nat)
  requires positive : 1 ≤ i
  shows rootInverse(succ(i)) ≤ rootInverse(i)
proof
  obtain ⟨a, aNonnegative, aSquare⟩ := natSqrt.facts at i
  obtain ⟨b, bNonnegative, bSquare⟩ := natSqrt.facts at succ(i)
  have aPositive := natSqrt.positive with positive
  have step := natSqrt.succ_square at i
  have squares : R[realSqrt(realNat(i)) * realSqrt(realNat(i))] ≤
    R[realSqrt(realNat(succ(i))) * realSqrt(realNat(succ(i)))] by linarith
  have rootLe := realMulValue.le_of_square_le with aNonnegative, bNonnegative,
    squares
  have inverse := realInvValue.antitone_le with aPositive, rootLe
  rw [rootInverse.apply, rootInverse.apply]
  exact inverse

-- ⌊X/d⌋ is antitone in d ≥ 1.
theorem quotientNat.antitone (X d : Nat)
  requires positive : 1 ≤ d
  shows quotientNat(X, succ(d)) ≤ quotientNat(X, d)
proof
  have nonzero : d ≠ (0:N) by arith
  have nonzeroNext : succ(d) ≠ (0:N) by arith
  have qNat := quotientNat.natural at succ(d), X
  have self : quotientNat(X, succ(d)) ≤ quotientNat(X, succ(d)) by arith
  have bound := (quotientNat.le_iff at succ(d), X, quotientNat(X, succ(d))
    with nonzeroNext).forward with self
  have smaller : d * quotientNat(X, succ(d)) ≤ X
    have expand : mul(succ(d), quotientNat(X, succ(d))) =
      d * quotientNat(X, succ(d)) + quotientNat(X, succ(d)) by ring
    rw expand at bound
    arith
  exact (quotientNat.le_iff at d, X, quotientNat(X, succ(d)) with
    nonzero).backward with smaller

-- The hyperbola weights are nonnegative, and antitone from 1 on.
theorem hyperbolaWeights.nonnegative (X d : Nat)
  shows R[0] ≤ hyperbolaWeights(X)(d)
proof
  have qNat := quotientNat.natural at d, X
  have root := rootInverse.nonnegative at d
  have sum := rootInverseSum.monotone at (0:N), quotientNat(X, d)
  have zeroSum : rootInverseSum((0:N)) = R[0]
    unfold rootInverseSum
    rw [realPartialSum.succ, realPartialSum.zero, rootInverse.zero]
    ring
  have zeroAdd : add((0:N), quotientNat(X, d)) = quotientNat(X, d) by arith
  rw [zeroSum, zeroAdd] at sum
  rw hyperbolaWeights.apply
  exact realMulValue.nonnegative with root, sum

theorem hyperbolaWeights.antitone (X d : Nat)
  requires positive : 1 ≤ d
  shows hyperbolaWeights(X)(succ(d)) ≤ hyperbolaWeights(X)(d)
proof
  have qNat := quotientNat.natural at d, X
  have qNextNat := quotientNat.natural at succ(d), X
  have quotient := quotientNat.antitone at X, d with positive
  obtain ⟨k, kNat, shape⟩ := LessEqual.exists_add with quotient
  have sums := rootInverseSum.monotone at quotientNat(X, succ(d)), k
  rw ← shape at sums
  have rootStep := rootInverse.antitone with positive
  have rootNext := rootInverse.nonnegative at succ(d)
  have sumNext := hyperbolaWeights.nonnegative at X, succ(d)
  rw hyperbolaWeights.apply at sumNext
  have zeroSum : rootInverseSum((0:N)) = R[0]
    unfold rootInverseSum
    rw [realPartialSum.succ, realPartialSum.zero, rootInverse.zero]
    ring
  have sumNextNonnegative := rootInverseSum.monotone at (0:N),
    quotientNat(X, succ(d))
  have zeroAdd : add((0:N), quotientNat(X, succ(d))) = quotientNat(X, succ(d))
    by arith
  rw [zeroSum, zeroAdd] at sumNextNonnegative
  have first := realLe.mul_left_of_nonnegative with sums, rootNext
  have second := realLe.mul_right_of_nonnegative with rootStep,
    (realLe.transitive with sumNextNonnegative, sums)
  rw [hyperbolaWeights.apply, hyperbolaWeights.apply]
  linarith

-- The weight at K + 1 for X = K² is at most 2.
theorem hyperbolaWeights.first_far (K : Nat)
  requires positive : 1 ≤ K
  shows hyperbolaWeights(K * K)(succ(K)) ≤ R[2]
proof
  have nonzero : succ(K) ≠ (0:N) by arith
  have qNat := quotientNat.natural at succ(K), K * K
  have quotient : quotientNat(K * K, succ(K)) ≤ K
    by_contra above
    have step : succ(K) ≤ quotientNat(K * K, succ(K)) by arith
    have bound := (quotientNat.le_iff at succ(K), K * K, succ(K) with
      nonzero).forward with step
    have expand : mul(succ(K), succ(K)) = K * K + K + K + 1 by ring
    rw expand at bound
    arith
  obtain ⟨k, kNat, shape⟩ := LessEqual.exists_add with quotient
  have sums := rootInverseSum.monotone at quotientNat(K * K, succ(K)), k
  rw ← shape at sums
  obtain ⟨_, remainder⟩ := rootInverseSum.remainder_bounds with positive
  obtain ⟨a, aNonnegative, aSquare⟩ := natSqrt.facts at K
  obtain ⟨b, bNonnegative, bSquare⟩ := natSqrt.facts at succ(K)
  have step := natSqrt.succ_square at K
  have squares : R[realSqrt(realNat(K)) * realSqrt(realNat(K))] ≤
    R[realSqrt(realNat(succ(K))) * realSqrt(realNat(succ(K)))] by linarith
  have rootLe := realMulValue.le_of_square_le with aNonnegative, bNonnegative,
    squares
  have one : 1 ≤ succ(K) by arith
  have cancel := rootInverse.cancel with one
  have rootNext := rootInverse.nonnegative at succ(K)
  have rootNextReal := rootInverse.real at succ(K)
  have sumQ := rootInverseSum.real at quotientNat(K * K, succ(K))
  have sumK := rootInverseSum.real at K
  have sumBound : rootInverseSum(quotientNat(K * K, succ(K))) ≤
    R[2 * realSqrt(realNat(succ(K)))] by linarith
  have scaled := realLe.mul_left_of_nonnegative with sumBound, rootNext
  have unit : R[rootInverse(succ(K)) * (2 * realSqrt(realNat(succ(K))))] =
    R[2] by linear_combination 2 * cancel
  rw hyperbolaWeights.apply
  linarith

-- The part d > K of the hyperbola sum at X = K² is at most 4B, B a bound
-- for the partial sums of u.
theorem hyperbola.far_part (u : Set) (B : Real) (K n : Nat)
  requires sequence : RealSequence(u)
  requires bounded : ∀ j ∈ ℕ, abs(realPartialSum(u, j)) ≤ B
  requires positive : 1 ≤ K
  shows abs(realPartialSum(shiftedRealSequence(mulSequence(u,
    hyperbolaWeights(K * K)), succ(K)), n)) ≤ R[4 * B]
proof
  have weights := hyperbolaWeights.sequence at K * K
  have antitone : ∀ i ∈ ℕ, succ(K) ≤ i →
      (hyperbolaWeights(K * K)(succ(i)):R) ≤ (hyperbolaWeights(K * K)(i):R)
    intros i iMember later
    have iNat := nat.omega.backward with iMember
    have iPositive : 1 ≤ i by arith
    exact hyperbolaWeights.antitone at K * K, i with iPositive
  have nonnegative : ∀ i ∈ ℕ, succ(K) ≤ i →
      R[0] ≤ (hyperbolaWeights(K * K)(i):R)
    intros i iMember later
    have iNat := nat.omega.backward with iMember
    exact hyperbolaWeights.nonnegative at K * K, i
  have abel := realPartialSum.tail_abel at u, hyperbolaWeights(K * K), B,
    succ(K), n with sequence, weights, bounded, antitone, nonnegative
  have zeroMember : (0:N) ∈ ℕ := nat.omega.forward at (0:N) with *
  have bZero := bounded with (0:N), zeroMember
  rw [realPartialSum.zero, abs.zero] at bZero
  have first := hyperbolaWeights.first_far with positive
  have weight := hyperbolaWeights.nonnegative at K * K, succ(K)
  have bNonnegative : R[0] ≤ R[2 * B] by linarith
  have scaled := realLe.mul_left_of_nonnegative with first, bNonnegative
  linarith

-- |Σ_{d ≤ K} u(d)/√d| ≤ 2B.
theorem rootInverse.weighted_bound (u : Set) (B : Real) (K : Nat)
  requires sequence : RealSequence(u)
  requires bounded : ∀ j ∈ ℕ, abs(realPartialSum(u, j)) ≤ B
  shows abs(realPartialSum(mulSequence(u, rootInverse), succ(K))) ≤ R[2 * B]
proof
  have root := rootInverse.sequence
  have products := mulSequence.sequence with sequence, root
  have antitone : ∀ i ∈ ℕ, 1 ≤ i → (rootInverse(succ(i)):R) ≤
      (rootInverse(i):R)
    intros i iMember later
    have iNat := nat.omega.backward with iMember
    exact rootInverse.antitone with later
  have nonnegative : ∀ i ∈ ℕ, 1 ≤ i → R[0] ≤ (rootInverse(i):R)
    intros i iMember later
    have iNat := nat.omega.backward with iMember
    exact rootInverse.nonnegative at i
  have abel := realPartialSum.tail_abel at u, rootInverse, B, 1, K with
    sequence, root, bounded, antitone, nonnegative
  rw rootInverse.one at abel
  have shape : succ(K) = add(1, K) by arith
  have uZero := RealSequence.value at u, (0:N) with sequence
  have rootZero := rootInverse.real at (0:N)
  rw [shape, (realPartialSum.split_at with products), realPartialSum.succ,
    realPartialSum.zero, (mulSequence.value with sequence, root, uZero,
    rootZero), rootInverse.zero]
  have tail := realPartialSum.real at shiftedRealSequence(mulSequence(u,
    rootInverse), 1), K with (shiftedRealSequence.sequence with products)
  have zero : R[realAddValue(R[0], R[u((0:N)) * 0]) +
      realPartialSum(shiftedRealSequence(mulSequence(u, rootInverse), 1), K)]
      = realPartialSum(shiftedRealSequence(mulSequence(u, rootInverse), 1), K)
    by ring
  rw zero
  have unit : R[2 * B * 1] = R[2 * B] by ring
  rw unit at abel
  exact abel

-- If L(1, χ) = 0 for χ real, then |Σ_{d ≤ K} χ(d)/d| ≤ (1 + 2N)/K.
theorem LFunction.one_vanishing_partial (N : Nat) (χ : Set) (K : Nat)
  requires positive : 1 ≤ N
  requires character : DirichletCharacter(N, χ)
  requires nonPrincipal : χ ≠ principalCharacter(N)
  requires square : characterSquare(χ) = principalCharacter(N)
  requires vanish : LFunction(N, χ, ℂ[1]) = ℂ[0]
  requires positiveK : 1 ≤ K
  shows abs(realPartialSum(mulSequence(realCharacter(χ),
    mulSequence(rootInverse, rootInverse)), succ(K))) ≤
    R[(1 + 2 * realNat(N)) * realInvValue(realNat(K))]
proof
  obtain ⟨_, squares, weighted⟩ := characterWeights.sequences with character
  have values := DirichletCharacter.function with character
  have function := realCharacter.function with values
  have sequence : RealSequence(realCharacter(χ)) by exact function
  have bounded : ∀ j ∈ ℕ, abs(realPartialSum(realCharacter(χ), j)) ≤
      realNat(N)
    intros j jMember
    have jNat := nat.omega.backward with jMember
    exact realCharacter.bounded with positive, character, nonPrincipal
  -- The partial sum to K N is within 1/K of L(1, χ) = 0.
  have partial := LFunction.one_partial at N, χ, K with positive, character,
    nonPrincipal, positiveK
  rw [vanish, (dirichletSeriesTerms.one_real with character, square)] at
    partial
  have total := realPartialSum.real at mulSequence(realCharacter(χ),
    mulSequence(rootInverse, rootInverse)), succ(K * N) with weighted
  have negate : ℂ[0 - complexOfReal(realPartialSum(mulSequence(
      realCharacter(χ), mulSequence(rootInverse, rootInverse)),
      succ(K * N)))] = complexOfReal(R[-realPartialSum(mulSequence(
      realCharacter(χ), mulSequence(rootInverse, rootInverse)),
      succ(K * N))])
    rw complexOfReal.neg
    ring
  rw [negate, complexAbs.of_real, abs.neg] at partial
  -- The terms from K + 1 to K N are at most 2N/(K + 1), by Abel summation.
  have atMost : succ(K) ≤ succ(K * N)
    have scaled := LessEqual.mul_left at 1, N, K with positive
    have unit : K * 1 = K by ring
    rw unit at scaled
    arith
  obtain ⟨m, mNat, shape⟩ := LessEqual.exists_add with atMost
  rw [shape, (realPartialSum.split_at with weighted)] at partial
  have antitone : ∀ i ∈ ℕ, succ(K) ≤ i →
      (mulSequence(rootInverse, rootInverse)(succ(i)):R) ≤
      (mulSequence(rootInverse, rootInverse)(i):R)
    intros i iMember later
    have iNat := nat.omega.backward with iMember
    have root := rootInverse.sequence
    have rootI := rootInverse.real at i
    have rootNext := rootInverse.real at succ(i)
    rw [(mulSequence.value with root, root, rootNext, rootNext),
      (mulSequence.value with root, root, rootI, rootI), rootInverse.square,
      rootInverse.square]
    have iPositive : R[0] < realNat(i)
      have iNonzero : i ≠ (0:N) by arith
      exact realNat.positive with iNonzero
    have next : i ≤ succ(i) by arith
    have step := realNat.le_of_natural_le with next
    exact realInvValue.antitone_le with iPositive, step
  have nonnegative : ∀ i ∈ ℕ, succ(K) ≤ i →
      R[0] ≤ (mulSequence(rootInverse, rootInverse)(i):R)
    intros i iMember later
    have iNat := nat.omega.backward with iMember
    have root := rootInverse.sequence
    have rootI := rootInverse.real at i
    have rootNonnegative := rootInverse.nonnegative at i
    rw (mulSequence.value with root, root, rootI, rootI)
    exact realMulValue.nonnegative with rootNonnegative, rootNonnegative
  have abel := realPartialSum.tail_abel at realCharacter(χ),
    mulSequence(rootInverse, rootInverse), realNat(N), succ(K), m with
    sequence, squares, bounded, antitone, nonnegative
  have root := rootInverse.sequence
  have rootK := rootInverse.real at succ(K)
  rw [(mulSequence.value with root, root, rootK, rootK), rootInverse.square]
    at abel
  -- 1/(K + 1) ≤ 1/K.
  have kPositive : R[0] < realNat(K)
    have kNonzero : K ≠ (0:N) by arith
    exact realNat.positive with kNonzero
  have next : K ≤ succ(K) by arith
  have kStep := realNat.le_of_natural_le with next
  have inverseStep := realInvValue.antitone_le with kPositive, kStep
  have nNonnegative := realNat.nonnegative at N
  have twoN : R[0] ≤ R[2 * realNat(N)] by linarith
  have scaledStep := realLe.mul_left_of_nonnegative with inverseStep, twoN
  have kNonzero : realNat(K) ≠ R[0] by linarith
  have oneOverK : R[1 / realNat(K)] = realInvValue(realNat(K))
    rw realDiv.eq_mul_inv
    have inverse := realInvValue.real at realNat(K)
    ring
  rw oneOverK at partial
  have head := realPartialSum.real at mulSequence(realCharacter(χ),
    mulSequence(rootInverse, rootInverse)), succ(K) with weighted
  have tail := realPartialSum.real at shiftedRealSequence(mulSequence(
    realCharacter(χ), mulSequence(rootInverse, rootInverse)), succ(K)), m
    with (shiftedRealSequence.sequence with weighted)
  have triangle := abs.triangle at R[realPartialSum(mulSequence(
    realCharacter(χ), mulSequence(rootInverse, rootInverse)), succ(K)) +
    realPartialSum(shiftedRealSequence(mulSequence(realCharacter(χ),
    mulSequence(rootInverse, rootInverse)), succ(K)), m)],
    R[-realPartialSum(shiftedRealSequence(mulSequence(realCharacter(χ),
    mulSequence(rootInverse, rootInverse)), succ(K)), m)]
  rw abs.neg at triangle
  have collapse : R[realPartialSum(mulSequence(realCharacter(χ),
      mulSequence(rootInverse, rootInverse)), succ(K)) +
      realPartialSum(shiftedRealSequence(mulSequence(realCharacter(χ),
      mulSequence(rootInverse, rootInverse)), succ(K)), m) +
      -realPartialSum(shiftedRealSequence(mulSequence(realCharacter(χ),
      mulSequence(rootInverse, rootInverse)), succ(K)), m)] =
    realPartialSum(mulSequence(realCharacter(χ), mulSequence(rootInverse,
      rootInverse)), succ(K)) by ring
  rw collapse at triangle
  have expand : R[(1 + 2 * realNat(N)) * realInvValue(realNat(K))] =
    R[realInvValue(realNat(K)) + 2 * realNat(N) * realInvValue(realNat(K))]
    by ring
  rw expand
  linarith

-- The terms of a sequence at the squares.
defgraph squareTerms (g : Set) (m ∈ ℕ) : ℝ := g(m * m)
requires sequence : RealSequence(g)
proof
  have mNat := nat.omega.backward with member
  exact RealSequence.value at g, m * m with sequence

-- A sum of nonnegative terms up to K² dominates its terms at the squares.
theorem realPartialSum.squares (g : Set) (K : Nat)
  requires sequence : RealSequence(g)
  requires nonnegative : ∀ n ∈ ℕ, R[0] ≤ (g(n):R)
  shows realPartialSum(squareTerms(g), succ(K)) ≤
    realPartialSum(g, succ(K * K))
proof
  have terms := squareTerms.function at g with sequence
  have squares : RealSequence(squareTerms(g)) by exact terms
  induction K
  | zero =>
    have zeroMember : (0:N) ∈ ℕ := nat.omega.forward at (0:N) with *
    have zero : (0:N) * (0:N) = (0:N) by arith
    rw [realPartialSum.succ, realPartialSum.succ, realPartialSum.zero,
      realPartialSum.zero, (squareTerms.value with sequence, zeroMember), zero]
    have value := RealSequence.value at g, (0:N) with sequence
    linarith
  | succ(k) using ih =>
    have kNat : Nat(k) by typecheck
    have kMember : succ(k) ∈ ℕ := nat.omega.forward at succ(k) with *
    have shape : succ(mul(succ(k), succ(k))) = add(succ(k * k), k + k + 1)
      by ring
    have shifted := shiftedRealSequence.sequence at g, succ(k * k) with
      sequence
    have tailNonnegative := realPartialSum.nonnegative_prefix at
      shiftedRealSequence(g, succ(k * k)), k + k with shifted
    have allNonnegative : ∀ i ∈ k + k, R[0] ≤
        (shiftedRealSequence(g, succ(k * k))(i):R)
      intros i iIn
      have iNat := natural.member at k + k with iIn
      have iMember : i ∈ ℕ := nat.omega.forward at i with *
      have position : add(succ(k * k), i) ∈ ℕ by typecheck
      rw (shiftedRealSequence.value with sequence, iMember)
      exact nonnegative with add(succ(k * k), i), position
    have restNonnegative := tailNonnegative with allNonnegative
    have lastMember : k + k ∈ ℕ by typecheck
    have last : add(succ(k * k), k + k) = mul(succ(k), succ(k)) by ring
    have previous := realPartialSum.real at squareTerms(g), succ(k) with
      squares
    have previousG := realPartialSum.real at g, succ(k * k) with sequence
    have rest := realPartialSum.real at shiftedRealSequence(g, succ(k * k)),
      k + k with shifted
    have lastValue := RealSequence.value at g, mul(succ(k), succ(k)) with
      sequence
    have kk : k + k + 1 = succ(k + k) by arith
    rw [(realPartialSum.succ at squareTerms(g), succ(k)),
      (squareTerms.value with sequence, kMember), shape,
      (realPartialSum.split_at with sequence), kk,
      (realPartialSum.succ at shiftedRealSequence(g, succ(k * k)), k + k),
      (shiftedRealSequence.value at g, succ(k * k), k + k with sequence,
      lastMember), last]
    linarith

-- Σ_{n ≤ K²} (1/√n) Σ_{d ∣ n} u(d) ≥ Σ_{m ≤ K} 1/m, as Σ_{d ∣ m²} u(d) ≥ 1.
theorem divisorSums.harmonic_lower (u : Set) (K : Nat)
  requires character : SignCharacter(u)
  shows realPartialSum(harmonicTerms, K) ≤
    realPartialSum(mulSequence(rootInverse, divisorSums(u)), succ(K * K))
proof
  have characterCopy := character
  obtain ⟨sequence, _, _, _⟩ := characterCopy
  have root := rootInverse.sequence
  have sums := divisorSums.function at u with sequence
  have sumsSequence : RealSequence(divisorSums(u)) by exact sums
  have products := mulSequence.sequence with root, sumsSequence
  have nonnegative : ∀ n ∈ ℕ, R[0] ≤
      (mulSequence(rootInverse, divisorSums(u))(n):R)
    intros n nMember
    have nNat := nat.omega.backward with nMember
    have rootN := rootInverse.real at n
    have sumN := RealSequence.value at divisorSums(u), n with sumsSequence
    rw [(mulSequence.value with root, sumsSequence, rootN, sumN),
      (divisorSums.value with sequence, nMember)]
    by_cases zero : n = (0:N)
    . rw [zero, rootInverse.zero]
      have sumZero := divisorSumReal.real at u, (0:N) with sequence
      have product : R[0 * divisorSumReal(u, (0:N))] = R[0] by ring
      rw product
      linarith
    . have nPositive : 1 ≤ n by arith
      have rootNonnegative := rootInverse.nonnegative at n
      have sumNonnegative := divisorSumReal.nonnegative with character,
        nPositive
      exact realMulValue.nonnegative with rootNonnegative, sumNonnegative
  have dominated := realPartialSum.squares at mulSequence(rootInverse,
    divisorSums(u)), K with products, nonnegative
  have terms := squareTerms.function at mulSequence(rootInverse,
    divisorSums(u)) with products
  have squares : RealSequence(squareTerms(mulSequence(rootInverse,
    divisorSums(u)))) by exact terms
  have shifted := shiftedRealSequence.sequence at squareTerms(mulSequence(
    rootInverse, divisorSums(u))), 1 with squares
  have shape : succ(K) = add(1, K) by arith
  rw [shape, (realPartialSum.split_at with squares)] at dominated
  have harmonic := harmonicTerms.sequence
  have compare := realPartialSum.le_scaled at harmonicTerms,
    shiftedRealSequence(squareTerms(mulSequence(rootInverse,
    divisorSums(u))), 1), R[1], K with harmonic, shifted
  have pointwise : ∀ i ∈ ℕ, i < K → (harmonicTerms[i]:R) ≤
      R[1 * shiftedRealSequence(squareTerms(mulSequence(rootInverse,
      divisorSums(u))), 1)[i]]
    intros i iMember below
    have iNat := nat.omega.backward with iMember
    have mMember : add(1, i) ∈ ℕ by typecheck
    have squareMember : add(1, i) * add(1, i) ∈ ℕ by typecheck
    have positiveM : 1 ≤ add(1, i) by arith
    have rootSquare := rootInverse.real at add(1, i) * add(1, i)
    have sumSquare := RealSequence.value at divisorSums(u),
      add(1, i) * add(1, i) with sumsSequence
    have atLeast := divisorSumReal.square with character, positiveM
    rw [(shiftedRealSequence.value with squares, iMember),
      (squareTerms.value with products, mMember),
      (mulSequence.value with root, sumsSequence, rootSquare, sumSquare),
      (divisorSums.value with sequence, squareMember),
      (harmonicTerms.value with iMember), rootInverse.mul, rootInverse.square,
      realNat.add, realNat.one]
    have inverse := realInvValue.real at R[1 + realNat(i)]
    have iPositive : R[0] < R[1 + realNat(i)]
      have iNonnegative := realNat.nonnegative at i
      linarith
    have inverseNonnegative : R[0] ≤ realInvValue(R[1 + realNat(i)])
      have positiveInverse := realInvValue.positive with iPositive
      linarith
    have scaled := realLe.mul_left_of_nonnegative with atLeast,
      inverseNonnegative
    have commute : R[realNat(i) + 1] = R[1 + realNat(i)] by ring
    rw commute
    have sumReal := divisorSumReal.real at u, add(1, i) * add(1, i) with
      sequence
    have left : R[realInvValue(R[1 + realNat(i)]) * 1] =
      realInvValue(R[1 + realNat(i)]) by ring
    have right : R[1 * (realInvValue(R[1 + realNat(i)]) *
        divisorSumReal(u, add(1, i) * add(1, i)))] =
      R[realInvValue(R[1 + realNat(i)]) *
        divisorSumReal(u, add(1, i) * add(1, i))] by ring
    rw right
    linarith
  have bound := compare with pointwise
  have zeroMember : (0:N) ∈ ℕ := nat.omega.forward at (0:N) with *
  have rootZero := rootInverse.real at (0:N)
  have sumZero := RealSequence.value at divisorSums(u), (0:N) with
    sumsSequence
  have zeroSquare : (0:N) * (0:N) = (0:N) by arith
  rw [realPartialSum.succ, realPartialSum.zero,
    (squareTerms.value with products, zeroMember), zeroSquare,
    (mulSequence.value with root, sumsSequence, rootZero, sumZero),
    rootInverse.zero] at dominated
  have sumZeroReal := divisorSumReal.real at u, (0:N) with sequence
  have tail := realPartialSum.real at shiftedRealSequence(squareTerms(
    mulSequence(rootInverse, divisorSums(u))), 1), K with shifted
  have harmonicSum := realPartialSum.real at harmonicTerms, K with harmonic
  have zeroTerm : realAddValue(R[0], R[0 * divisorSums(u)((0:N))]) = R[0]
    by ring
  rw zeroTerm at dominated
  have unit : R[1 * realPartialSum(shiftedRealSequence(squareTerms(
      mulSequence(rootInverse, divisorSums(u))), 1), K)] =
    realPartialSum(shiftedRealSequence(squareTerms(mulSequence(rootInverse,
      divisorSums(u))), 1), K) by ring
  have total := realPartialSum.real at mulSequence(rootInverse,
    divisorSums(u)), succ(K * K) with products
  linarith

-- The arithmetic of the final estimate: with |P − 2kS₁ − rS₂| ≤ 4,
-- |T| ≤ 4n, |S₁| ≤ (1 + 2n)/k, |S₂| ≤ 2n and −2 ≤ r ≤ 0, P + T ≤ 6 + 12n.
theorem hyperbola.arithmetic (P T S r k c n : Real) (Q : Real)
  requires near : abs(R[P - 2 * k * S - r * Q]) ≤ R[4]
  requires far : abs(T) ≤ R[4 * n]
  requires first : abs(S) ≤ R[(1 + 2 * n) * c]
  requires second : abs(Q) ≤ R[2 * n]
  requires low : R[-2] ≤ r
  requires high : r ≤ R[0]
  requires inverse : R[k * c] = R[1]
  requires positive : R[0] < k
  requires nonnegative : R[0] ≤ n
  shows R[P + T] ≤ R[6 + 12 * n]
proof
  have sUpper := abs.upper at S
  have sAbs := abs.real at S
  have sBound : S ≤ R[(1 + 2 * n) * c] by linarith
  have twoK : R[0] ≤ R[2 * k] by linarith
  have p1 := realLe.mul_left_of_nonnegative with sBound, twoK
  have e1 : R[2 * k * ((1 + 2 * n) * c)] = R[2 + 4 * n]
    by linear_combination (2 * (1 + 2 * n)) * inverse
  have qLower := abs.upper_neg at Q
  have qAbs := abs.real at Q
  have negQ : R[-Q] ≤ R[2 * n] by linarith
  have negR : R[0] ≤ R[-r] by linarith
  have negRBelow : R[-r] ≤ R[2] by linarith
  have twoN : R[0] ≤ R[2 * n] by linarith
  have q1 := realLe.mul_left_of_nonnegative with negQ, negR
  have q2 := realLe.mul_right_of_nonnegative with negRBelow, twoN
  have e2 : R[-r * -Q] = R[r * Q] by ring
  have nearUpper := abs.upper at R[P - 2 * k * S - r * Q]
  have farUpper := abs.upper at T
  have nearAbs := abs.real at R[P - 2 * k * S - r * Q]
  have farAbs := abs.real at T
  linarith

-- L(1, χ) ≠ 0 for χ real and non-principal: otherwise the hyperbola sum
-- Σ_{n ≤ K²} (1/√n) Σ_{d ∣ n} χ(d) would stay bounded while dominating the
-- harmonic sums Σ_{m ≤ K} 1/m.
theorem LFunction.nonzero_one_real (N : Nat) (χ : Set)
  requires positive : 1 ≤ N
  requires character : DirichletCharacter(N, χ)
  requires nonPrincipal : χ ≠ principalCharacter(N)
  requires square : characterSquare(χ) = principalCharacter(N)
  shows LFunction(N, χ, ℂ[1]) ≠ ℂ[0]
proof
  intro vanish
  have sign := realCharacter.sign with character, square
  have signCopy := sign
  obtain ⟨sequence, _, _, _⟩ := signCopy
  have bounded : ∀ j ∈ ℕ, abs(realPartialSum(realCharacter(χ), j)) ≤
      realNat(N)
    intros j jMember
    have jNat := nat.omega.backward with jMember
    exact realCharacter.bounded with positive, character, nonPrincipal
  have nNonnegative := realNat.nonnegative at N
  obtain ⟨K, kNat, big⟩ := harmonicSeries.unbounded at R[6 + 12 * realNat(N)]
  have kPositive : 1 ≤ K
    by_contra zero
    have kZero : K = (0:N) by arith
    rw [kZero, realPartialSum.zero] at big
    linarith
  -- The lower bound.
  have lower := divisorSums.harmonic_lower at realCharacter(χ), K with sign
  -- The upper bound: split the hyperbola sum at d = K.
  have core := hyperbola.divisor_form at realCharacter(χ), K * K with sequence
  have atMost : succ(K) ≤ succ(K * K)
    have scaled := LessEqual.mul_left at 1, K, K with kPositive
    have unit : K * 1 = K by ring
    rw unit at scaled
    arith
  obtain ⟨m, mNat, shape⟩ := LessEqual.exists_add with atMost
  have weights := hyperbolaWeights.sequence at K * K
  have products := mulSequence.sequence with sequence, weights
  rw [shape, (realPartialSum.split_at with products), ← shape] at core
  have far := hyperbola.far_part at realCharacter(χ), realNat(N), K, m with
    sequence, bounded, kPositive
  have near := hyperbola.near_part at realCharacter(χ), K with sign, kPositive
  have first := LFunction.one_vanishing_partial at N, χ, K with positive,
    character, nonPrincipal, square, vanish, kPositive
  have second := rootInverse.weighted_bound at realCharacter(χ), realNat(N), K
    with sequence, bounded
  have kSquare : 1 ≤ K * K
    have scaled := LessEqual.mul_left at 1, K, K with kPositive
    arith
  obtain ⟨remainderLow, remainderHigh⟩ := rootInverseSum.remainder_bounds with
    kSquare
  rw natSqrt.square at remainderLow
  rw natSqrt.square at remainderHigh
  have kPositiveReal : R[0] < realNat(K)
    have kNonzero : K ≠ (0:N) by arith
    exact realNat.positive with kNonzero
  have kNonzero : realNat(K) ≠ R[0] by linarith
  have kCancel := realInvValue.mul_right with kNonzero
  have total := hyperbola.arithmetic with near, far, first, second,
    remainderLow, remainderHigh, kCancel, kPositiveReal, nNonnegative
  linarith

-- Dirichlet's theorem: L(1, χ) ≠ 0 for χ non-principal.
theorem LFunction.nonzero_one (N : Nat) (χ : Set)
  requires positive : 1 ≤ N
  requires character : DirichletCharacter(N, χ)
  requires nonPrincipal : χ ≠ principalCharacter(N)
  shows LFunction(N, χ, ℂ[1]) ≠ ℂ[0]
proof
  by_cases real : characterSquare(χ) = principalCharacter(N)
  . exact LFunction.nonzero_one_real with positive, character, nonPrincipal,
      real
  . exact LFunction.nonzero_one_of_square with positive, character,
      nonPrincipal, real

-- No zero on re s ≥ 1, the pole of the principal character excepted.
theorem LFunction.nonzero_re_ge_one (N : Nat) (χ s : Set)
  requires positive : 1 ≤ N
  requires character : DirichletCharacter(N, χ)
  requires hs : s ∈ ℂ
  requires halfPlane : realOne ≤ complexRe(s)
  requires notPole : χ ≠ principalCharacter(N) ∨ s ≠ ℂ[1]
  shows LFunction(N, χ, s) ≠ ℂ[0]
proof
  have reReal := complexRe.real with hs
  by_cases strict : realOne < complexRe(s)
  . exact LFunction.nonzero_re_gt_one with positive, character, hs, strict
  have onLine : complexRe(s) = R[1] by linarith
  by_cases atOne : s = ℂ[1]
  . cases notPole with nonPrincipal | notOne
    . rw atOne
      exact LFunction.nonzero_one with positive, character, nonPrincipal
    . exfalso
      exact notOne with atOne
  have notOne : s ≠ ℂ[1] := atOne
  intro vanish
  have one := complexOne.member
  have square := characterSquare.character with character
  have holomorphic := LFunction.holomorphic_off_one with positive, character
  have holomorphicSquare := LFunction.holomorphic_off_one with positive,
    square
  have sU : s ∈ complexCarrier ∖ {ℂ[1]}
    refine ⟨hs, ?_⟩
    intro single
    exact notOne with ((singleton.membership at s, ℂ[1]).forward with single)
  have c0 : ℂ[s + s - 1] ∈ ℂ by typecheck
  have c0U : ℂ[s + s - 1] ∈ complexCarrier ∖ {ℂ[1]}
    refine ⟨c0, ?_⟩
    intro single
    have same := (singleton.membership at ℂ[s + s - 1], ℂ[1]).forward with
      single
    have two : ℂ[2] ∈ ℂ by typecheck
    have twoNonzero : ℂ[2] ≠ ℂ[0]
      intro twoVanish
      have re := complexOfReal.re at R[2]
      rw [complexOfReal.two, twoVanish, ← complexOfReal.zero, complexOfReal.re]
        at re
      linarith
    have cancel := complexInv.mul_cancel with two, twoNonzero
    have half := complexInv.member with two
    apply notOne
    linear_combination complexInv(ℂ[2]) * same - (s - 1) * cancel
  have shifted : ∀ e ∈ ℝ, R[0] < e → ℂ[s + complexOfReal(e)] ∈
      complexCarrier ∖ {ℂ[1]} ∧ ℂ[s + s - 1 + complexOfReal(e)] ∈
      complexCarrier ∖ {ℂ[1]}
    intros e eReal ePositive
    have eTyped : Real(e) by typecheck
    have eMember := complexOfReal.mem at e
    have bMember : ℂ[s + complexOfReal(e)] ∈ ℂ by typecheck
    have cMember : ℂ[s + s - 1 + complexOfReal(e)] ∈ ℂ by typecheck
    constructor
    . refine ⟨bMember, ?_⟩
      intro single
      have same := (singleton.membership at ℂ[s + complexOfReal(e)],
        ℂ[1]).forward with single
      have re := complexRe.add with hs, eMember
      rw [same, ← complexOfReal.one, complexOfReal.re, onLine,
        complexOfReal.re] at re
      linarith
    . refine ⟨cMember, ?_⟩
      intro single
      have same := (singleton.membership at ℂ[s + s - 1 + complexOfReal(e)],
        ℂ[1]).forward with single
      have twoS : ℂ[s + s] ∈ ℂ by typecheck
      have re := complexRe.add with c0, eMember
      rw [same, (complexRe.sub with twoS, one), (complexRe.add with hs, hs),
        ← complexOfReal.one, complexOfReal.re, onLine, complexOfReal.re] at re
      linarith
  exact LFunction.three_four_one_zero with positive, character, hs, onLine,
    vanish, holomorphic, holomorphicSquare, sU, c0U, shifted


-- Section: Change of level
-- The divisors of N, the primes the change of level sifts out.
def naturalDivisors (N : Nat) : Set := { p ∈ ℕ | p ∣ N }

-- A divisor of N ≥ 1 is at least 1.
theorem divides.one_le (d N : Nat)
  requires positive : 1 ≤ N
  requires divides : d ∣ N
  shows 1 ≤ d
proof
  by_contra small
  have zero : d = (0:N) by arith
  rw zero at divides
  have nZero := zero.divides_only_zero with *
  arith

-- k + 1 ≥ 1 has no prime factor dividing N exactly when it is coprime
-- to N.
theorem SieveRough.coprime (N m : Nat)
  requires positive : 1 ≤ N
  shows SieveRough(naturalDivisors(N), N + 1, m) ↔
    IntegerCoprime(integerOfNat(m), integerOfNat(N))
proof
  have nonzeroN : N ≠ (0:N) by arith
  have ofNat := integerGCD.ofNat at m, N
  constructor
  . intro rough
    unfold IntegerCoprime
    rw ofNat
    have left := gcd.divides_left at m, N
    have right := gcd.divides_right at m, N
    by_contra notOne
    have gNonzero : gcd(m, N) ≠ (0:N)
      intro zero
      rw zero at right
      have nZero := zero.divides_only_zero with *
      exact nonzeroN with nZero
    have above : 1 < gcd(m, N) by arith
    obtain ⟨p, prime, divides⟩ := natural.exists_prime_divisor at gcd(m, N)
      with above
    have pNat := Prime.natural with prime
    have dividesM := divides.transitive with divides, left
    have dividesN := divides.transitive with divides, right
    have bound := divides.le with dividesN, nonzeroN
    have below : p < N + 1 by arith
    have pMember : p ∈ ℕ := nat.omega.forward at p with *
    have inP : p ∈ naturalDivisors(N) :=
      naturalDivisors.membership.backward with ⟨pMember, dividesN⟩
    exact rough with p, prime, inP, below, dividesM
  . intro coprime
    unfold IntegerCoprime at coprime
    rw ofNat at coprime
    unfold SieveRough
    intros p prime inP below dividesM
    obtain ⟨pMember, dividesN⟩ := naturalDivisors.membership.forward with inP
    have pNat := Prime.natural with prime
    obtain ⟨_, _, greatest⟩ := gcd.correct at m, N
    have dividesG := greatest with p, pNat, dividesM, dividesN
    rw coprime at dividesG
    have oneNonzero : (1:N) ≠ (0:N) by arith
    have bound := divides.le with dividesG, oneNonzero
    have above := Prime.greater_than_one with prime
    arith

theorem levelProduct.member (N : Nat) (ψ s : Set) (n : Nat)
  requires values : FunctionBetween(ψ, ℤ, complexCarrier)
  requires hs : s ∈ complexCarrier
  shows levelProduct(N, ψ, s, n) ∈ complexCarrier
proof
  induction n
  | zero =>
    rw levelProduct
    exact complexOne.member
  | succ(k) using ih =>
    obtain ⟨factor, _⟩ := levelFactor.selected at N, ψ, s, k with values, hs
    rw levelProduct
    typecheck

defgraph levelProductMap (N : Nat, ψ : Set, n : Nat) (s ∈ complexCarrier) :
    complexCarrier := levelProduct(N, ψ, s, n)
requires values : FunctionBetween(ψ, ℤ, complexCarrier)
proof
  exact levelProduct.member with values, member

-- Sifting the Dirichlet series of ψ by the primes below n dividing N
-- multiplies its sum by the partial product of the level factors.
theorem LFunction.level_stage (N d : Nat) (ψ s : Set) (n : Nat)
  requires dPositive : 1 ≤ d
  requires character : DirichletCharacter(d, ψ)
  requires hs : s ∈ ℂ
  requires halfPlane : realOne < complexRe(s)
  shows ComplexSumsTo(sieveTerms(dirichletSeriesTerms(ψ, s),
    naturalDivisors(N), n), ℂ[LFunction(d, ψ, s) * levelProduct(N, ψ, s, n)])
proof
  induction n
  | zero =>
    obtain ⟨sums, absolute⟩ := LFunction.series with dPositive, character,
      hs, halfPlane
    obtain ⟨sequence, _⟩ := absolute
    have values := DirichletCharacter.function with character
    have lMember := LFunction.closed at d, ψ, s with values, hs
    rw [(sieveTerms.start with sequence), levelProduct]
    have same : ℂ[LFunction(d, ψ, s) * complexOne] = LFunction(d, ψ, s)
      by ring
    rw same
    exact sums
  | succ(k) using ih =>
    obtain ⟨_, absolute⟩ := LFunction.series with dPositive, character, hs,
      halfPlane
    have absoluteCopy := absolute
    obtain ⟨sequence, _⟩ := absoluteCopy
    have values := DirichletCharacter.function with character
    have lMember := LFunction.closed at d, ψ, s with values, hs
    have kMember : k ∈ ℕ := nat.omega.forward at k with *
    have product := levelProduct.member at N, ψ, s, k with values, hs
    obtain ⟨_, yes, no⟩ := levelFactor.selected at N, ψ, s, k with values, hs
    have index : succ(k) = k + 1 by arith
    rw levelProduct
    rw index
    by_cases both : Prime(k) ∧ k ∈ naturalDivisors(N)
    . obtain ⟨prime, inP⟩ := both
      obtain ⟨_, dividesN⟩ := naturalDivisors.membership.forward with inP
      have factor := yes with ⟨prime, dividesN⟩
      have above := Prime.greater_than_one with prime
      have atLeast : 1 ≤ k by arith
      obtain ⟨r, rNat, split⟩ := LessEqual.exists_add with atLeast
      have shape : k = r + 1 by arith
      rw shape at prime
      rw shape at inP
      rw shape at ih
      rw shape at factor
      rw shape
      have rMember : r ∈ ℕ := nat.omega.forward at r with *
      have multiplicative := dirichletSeriesTerms.multiplicative with
        character, hs
      have step := sieveTerms.step at dirichletSeriesTerms(ψ, s),
        naturalDivisors(N), ℂ[LFunction(d, ψ, s) * levelProduct(N, ψ, s,
        r + 1)], r with absolute, prime, inP, (multiplicative with r,
        rMember), ih
      rw (dirichletSeriesTerms.value with values, hs, rMember) at step
      rw factor
      have rIndex : integerOfNat(r + 1) ∈ ℤ by typecheck
      have value := FunctionBetween.apply_closed with values, rIndex
      have negative : ℂ[-s] ∈ ℂ by typecheck
      have power := realCpow.member at realNat(r + 1), ℂ[-s] with negative
      have productR := levelProduct.member at N, ψ, s, r + 1 with values, hs
      have same : ℂ[LFunction(d, ψ, s) * (levelProduct(N, ψ, s, r + 1) *
          (1 - ψ(integerOfNat(r + 1)) * realCpow(realNat(r + 1), ℂ[-s])))] =
        ℂ[(1 - ψ(integerOfNat(r + 1)) * realCpow(realNat(r + 1), ℂ[-s])) *
          (LFunction(d, ψ, s) * levelProduct(N, ψ, s, r + 1))] by ring
      rw same
      exact step
    . have notBoth : ¬(Prime(k) ∧ k ∣ N)
        intro pair
        obtain ⟨prime, dividesN⟩ := pair
        apply both
        exact ⟨prime, (naturalDivisors.membership.backward with
          ⟨kMember, dividesN⟩)⟩
      rw [(no with notBoth), (sieveTerms.skip with sequence, both)]
      have same : ℂ[LFunction(d, ψ, s) * (levelProduct(N, ψ, s, k) * 1)] =
        ℂ[LFunction(d, ψ, s) * levelProduct(N, ψ, s, k)] by ring
      rw same
      exact ih

-- The change of level for re s > 1, by the sieve.
theorem LFunction.changeLevel_right (N d : Nat) (ψ s : Set)
  requires positive : 1 ≤ N
  requires divides : d ∣ N
  requires character : DirichletCharacter(d, ψ)
  requires hs : s ∈ ℂ
  requires halfPlane : realOne < complexRe(s)
  shows LFunction(N, changeLevel(N, ψ), s) =
    ℂ[LFunction(d, ψ, s) * levelProduct(N, ψ, s, succ(N))]
proof
  have dPositive := divides.one_le with positive, divides
  have values := DirichletCharacter.function with character
  have induced := changeLevel.character with divides, character
  have inducedValues := DirichletCharacter.function with induced
  have stage := LFunction.level_stage at N, d, ψ, s, N + 1 with dPositive,
    character, hs, halfPlane
  obtain ⟨inducedSums, _⟩ := LFunction.series at N, changeLevel(N, ψ), s with
    positive, induced, hs, halfPlane
  have terms := dirichletSeriesTerms.function at ψ, s with values, hs
  have sequence : ComplexSequence(dirichletSeriesTerms(ψ, s)) by exact terms
  have sieved := sieveTerms.function at dirichletSeriesTerms(ψ, s),
    naturalDivisors(N), N + 1 with sequence
  have inducedTerms := dirichletSeriesTerms.function at changeLevel(N, ψ), s
    with inducedValues, hs
  have same : sieveTerms(dirichletSeriesTerms(ψ, s), naturalDivisors(N),
      N + 1) = dirichletSeriesTerms(changeLevel(N, ψ), s)
    apply FunctionBetween.ext with sieved, inducedTerms
    intros k kMember
    have kNat := nat.omega.backward with kMember
    have index : integerOfNat(k + 1) ∈ ℤ by typecheck
    have value := FunctionBetween.apply_closed with values, index
    have negative : ℂ[-s] ∈ ℂ by typecheck
    have power := realCpow.member at realNat(k + 1), ℂ[-s] with negative
    have coprimeIff := SieveRough.coprime at N, k + 1 with positive
    rw (dirichletSeriesTerms.value at changeLevel(N, ψ), s, k with
      inducedValues, hs, kMember)
    by_cases rough : SieveRough(naturalDivisors(N), N + 1, k + 1)
    . have coprime := coprimeIff.forward with rough
      rw [(sieveTerms.rough with sequence, rough),
        (dirichletSeriesTerms.value at ψ, s, k with values, hs, kMember),
        (changeLevel.coprime with index, coprime, value)]
    . have notCoprime : ¬IntegerCoprime(integerOfNat(k + 1), integerOfNat(N))
        intro coprime
        exact rough with (coprimeIff.backward with coprime)
      rw [(sieveTerms.sifted with sequence, rough),
        (changeLevel.not_coprime with index, notCoprime)]
      ring
  rw same at stage
  have next : succ(N) = N + 1 by arith
  rw next
  exact ComplexSumsTo.unique with inducedSums, stage

-- s ↦ ∏_{p < n, p ∣ N} (1 − ψ(p) p^(−s)) is entire.
theorem levelProductMap.holomorphic (N : Nat) (ψ : Set) (n : Nat)
  requires values : FunctionBetween(ψ, ℤ, complexCarrier)
  shows HolomorphicOn(levelProductMap(N, ψ, n), complexCarrier)
proof
  induction n
  | zero =>
    have whole := ComplexOpen.whole
    have one := complexOne.member
    apply HolomorphicOn.const_formula with whole, one
    intros z hz
    rw [(levelProductMap.value at N, ψ, 0, z with values, hz), levelProduct]
  | succ(k) using ih =>
    have whole := ComplexOpen.whole
    have inside := ComplexOpen.subset with whole
    have one := complexOne.member
    have factorMap : ∃ g, HolomorphicOn(g, complexCarrier) ∧
        (∀ z ∈ complexCarrier, g(z) = levelFactor(N, ψ, z, k))
      by_cases both : Prime(k) ∧ k ∣ N
      . have index : integerOfNat(k) ∈ ℤ by typecheck
        have value := FunctionBetween.apply_closed with values, index
        have scale : ℂ[-ψ(integerOfNat(k))] ∈ ℂ by typecheck
        have zero : ℂ[0] ∈ ℂ by typecheck
        have minusOne : ℂ[-1] ∈ ℂ by typecheck
        have power := affinePower.holomorphic at realNat(k), ℂ[0], ℂ[-1],
          complexCarrier with zero, minusOne, whole, inside
        have scaleMap := HolomorphicOn.const with whole, scale
        have scaled := HolomorphicOn.mul with scaleMap, power
        have unit := HolomorphicOn.const with whole, one
        have sum := HolomorphicOn.add with unit, scaled
        have powerCopy := power
        have scaleCopy := scaleMap
        have scaledCopy := scaled
        have unitCopy := unit
        obtain ⟨_, valuesPower, _⟩ := powerCopy
        obtain ⟨_, valuesScale, _⟩ := scaleCopy
        obtain ⟨_, valuesScaled, _⟩ := scaledCopy
        obtain ⟨_, valuesUnit, _⟩ := unitCopy
        refine ⟨complexFunctionAdd(complexFunctionConst(ℂ[1], complexCarrier),
          complexFunctionMul(complexFunctionConst(ℂ[-ψ(integerOfNat(k))],
          complexCarrier), affinePower(realNat(k), ℂ[0], ℂ[-1]),
          complexCarrier), complexCarrier), sum, ?_⟩
        intros z hz
        obtain ⟨_, yes, _⟩ := levelFactor.selected at N, ψ, z, k with values,
          hz
        have exponent : ℂ[0 + -1 * z] = ℂ[-z] by ring
        have negative : ℂ[-z] ∈ ℂ by typecheck
        have powerValue := realCpow.member at realNat(k), ℂ[-z] with negative
        rw [(yes with both), (complexFunctionAdd.value with valuesUnit,
          valuesScaled, hz), (complexFunctionConst.value with one, hz),
          (complexFunctionMul.value with valuesScale, valuesPower, hz),
          (complexFunctionConst.value with scale, hz),
          (affinePower.value with zero, minusOne, hz), exponent]
        ring
      . have unit := HolomorphicOn.const with whole, one
        refine ⟨complexFunctionConst(ℂ[1], complexCarrier), unit, ?_⟩
        intros z hz
        obtain ⟨_, _, no⟩ := levelFactor.selected at N, ψ, z, k with values, hz
        rw [(no with both), (complexFunctionConst.value with one, hz)]
    obtain ⟨g, holomorphicG, valueG⟩ := factorMap
    apply HolomorphicOn.mul_formula with ih, holomorphicG
    intros z hz
    rw [(levelProductMap.value at N, ψ, succ(k), z with values, hz),
      (levelProductMap.value at N, ψ, k, z with values, hz), levelProduct,
      (valueG with z, hz)]

-- The change of level on a connected open set containing re s > 1 where
-- both L-functions are holomorphic, by the identity theorem.
theorem LFunction.changeLevel_on (N d : Nat) (ψ U s : Set)
  requires positive : 1 ≤ N
  requires divides : d ∣ N
  requires character : DirichletCharacter(d, ψ)
  requires holomorphicN : HolomorphicOn(LFunctionMap(N, changeLevel(N, ψ)), U)
  requires holomorphicD : HolomorphicOn(LFunctionMap(d, ψ), U)
  requires connected : ComplexConnected(U)
  requires halfPlane : rightHalfPlane(R[1]) ⊆ U
  requires hs : s ∈ U
  shows LFunction(N, changeLevel(N, ψ), s) =
    ℂ[LFunction(d, ψ, s) * levelProduct(N, ψ, s, succ(N))]
proof
  have values := DirichletCharacter.function with character
  have induced := changeLevel.character with divides, character
  have inducedValues := DirichletCharacter.function with induced
  have holomorphicCopy := holomorphicD
  obtain ⟨isOpen, valuesD, _⟩ := holomorphicCopy
  have inside := ComplexOpen.subset with isOpen
  have product := levelProductMap.holomorphic at N, ψ, succ(N) with values
  have productU := HolomorphicOn.mono with product, isOpen, inside
  have productCopy := productU
  obtain ⟨_, valuesProduct, _⟩ := productCopy
  have right := HolomorphicOn.mul with holomorphicD, productU
  have halfOpen := rightHalfPlane.open at R[1]
  have twoPoint : complexOfReal(R[2]) ∈ rightHalfPlane(R[1])
    apply rightHalfPlane.membership.backward
    refine ⟨(complexOfReal.mem at R[2]), ?_⟩
    rw complexOfReal.re
    linarith
  have nonempty : ∃ v, v ∈ rightHalfPlane(R[1]) :=
    ⟨complexOfReal(R[2]), twoPoint⟩
  have agree : ∀ z ∈ rightHalfPlane(R[1]),
      LFunctionMap(N, changeLevel(N, ψ))(z) = complexFunctionMul(
        LFunctionMap(d, ψ), levelProductMap(N, ψ, succ(N)), U)(z)
    intros z hz
    obtain ⟨zMember, zHalfPlane⟩ := rightHalfPlane.membership.forward with hz
    have zRight : realOne < complexRe(z) by exact zHalfPlane
    have zU := halfPlane with z, hz
    rw [(LFunctionMap.apply with inducedValues, zMember),
      (complexFunctionMul.value with valuesD, valuesProduct, zU),
      (LFunctionMap.apply with values, zMember),
      (levelProductMap.value with values, zMember)]
    exact LFunction.changeLevel_right with positive, divides, character,
      zMember, zRight
  have identity := holomorphic.identity with holomorphicN, right, connected,
    halfOpen, nonempty, halfPlane, agree
  have atS := identity with s, hs
  have sMember := inside with s, hs
  rw [(LFunctionMap.apply with inducedValues, sMember),
    (complexFunctionMul.value with valuesD, valuesProduct, hs),
    (LFunctionMap.apply with values, sMember),
    (levelProductMap.value with values, sMember)] at atS
  exact atS

-- The induced character is principal exactly when ψ is.
theorem changeLevel.principal_iff (N d : Nat) (ψ : Set)
  requires positive : 1 ≤ N
  requires divides : d ∣ N
  requires character : DirichletCharacter(d, ψ)
  shows changeLevel(N, ψ) = principalCharacter(N) ↔
    ψ = principalCharacter(d)
proof
  have induced := changeLevel.character with divides, character
  have valuesψ := DirichletCharacter.function with character
  have positiveN : 0 < N by arith
  have levelDivides := IntegerDivides.of_natural with divides
  have dInteger : integerOfNat(d) ∈ ℤ by typecheck
  have nInteger : integerOfNat(N) ∈ ℤ by typecheck
  constructor
  . intro principal
    apply (principalCharacter.eq_iff with character).backward
    intros a aInteger coprime
    obtain ⟨x, xInteger, congruent, xCoprime⟩ := IntegerCoprime.lift at d, N, a
      with aInteger, coprime, positiveN
    have same := DirichletCharacter.congruent with character, xInteger,
      aInteger, congruent
    have xValue := FunctionBetween.apply_closed with valuesψ, xInteger
    have lifted := changeLevel.coprime with xInteger, xCoprime, xValue
    rw [principal, (principalCharacter.coprime with xInteger, xCoprime)]
      at lifted
    rw [← same, ← lifted]
  . intro principal
    apply (principalCharacter.eq_iff with induced).backward
    intros a aInteger coprime
    have aValue := FunctionBetween.apply_closed with valuesψ, aInteger
    have coprimeD := IntegerCoprime.of_divides with aInteger, nInteger,
      dInteger, levelDivides, coprime
    rw [(changeLevel.coprime with aInteger, coprime, aValue), principal,
      (principalCharacter.coprime with aInteger, coprimeD)]

-- Change of level: for ψ modulo a divisor d of N, inducing ψ to N
-- multiplies L(s, ψ) by ∏_{p ∣ N} (1 − ψ(p) p^(−s)), away from the pole
-- (Mathlib's DirichletCharacter.LFunction_changeLevel). With ψ primitive
-- this relates every L-function to a primitive one.
theorem LFunction.changeLevel (N d : Nat) (ψ s : Set)
  requires positive : 1 ≤ N
  requires divides : d ∣ N
  requires character : DirichletCharacter(d, ψ)
  requires hs : s ∈ ℂ
  requires notPole : ψ ≠ principalCharacter(d) ∨ s ≠ ℂ[1]
  shows LFunction(N, changeLevel(N, ψ), s) =
    ℂ[LFunction(d, ψ, s) * levelProduct(N, ψ, s, succ(N))]
proof
  have dPositive := divides.one_le with positive, divides
  have induced := changeLevel.character with divides, character
  cases notPole with nonPrincipal | notOne
  . have inducedNonPrincipal : changeLevel(N, ψ) ≠ principalCharacter(N)
      intro principal
      apply nonPrincipal
      exact (changeLevel.principal_iff with positive, divides,
        character).forward with principal
    have holomorphicN := LFunction.holomorphic with positive, induced,
      inducedNonPrincipal
    have holomorphicD := LFunction.holomorphic with dPositive, character,
      nonPrincipal
    have connected := ComplexConnected.whole
    have halfPlane : rightHalfPlane(R[1]) ⊆ complexCarrier
      intros z hz
      obtain ⟨zMember, _⟩ := rightHalfPlane.membership.forward with hz
      exact zMember
    exact LFunction.changeLevel_on with positive, divides, character,
      holomorphicN, holomorphicD, connected, halfPlane, hs
  . have one := complexOne.member
    have holomorphicN := LFunction.holomorphic_off_one with positive, induced
    have holomorphicD := LFunction.holomorphic_off_one with dPositive,
      character
    have connected := complexPunctured.connected with one
    have halfPlane : rightHalfPlane(R[1]) ⊆ complexCarrier ∖ {ℂ[1]}
      intros z hz
      obtain ⟨zMember, zRight⟩ := rightHalfPlane.membership.forward with hz
      refine ⟨zMember, ?_⟩
      intro single
      have same := (singleton.membership at z, ℂ[1]).forward with single
      rw [same, ← complexOfReal.one, complexOfReal.re] at zRight
      linarith
    have sU : s ∈ complexCarrier ∖ {ℂ[1]}
      refine ⟨hs, ?_⟩
      intro single
      apply notOne
      exact (singleton.membership at s, ℂ[1]).forward with single
    exact LFunction.changeLevel_on with positive, divides, character,
      holomorphicN, holomorphicD, connected, halfPlane, sU

end LFunctions
