-- The Riemann Hypothesis and the Generalized Riemann Hypothesis for
-- Dirichlet L-functions, stated as the source states them: the
-- propositions of grh-compact/src/Statements.lean and Mathlib's
-- RiemannHypothesis, and the five theorems of grh-compact/src/Main.lean.
-- The half-plane form of GRH, nonvanishing of every L(s, χ) on re s > 1/2,
-- is the one admitted theorem of the argument (New.grh); the others follow
-- from it through the two deductions of New/Main.lean, proved here from
-- the functional equations of GRH.FunctionalEquation.
-- Part of the GRH blueprint.
-- Planned home: NumberTheory/GRH.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Statements
import GRH.LFunction
import GRH.FunctionalEquation

section Statements
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- Section: The propositions
-- Mathlib's RiemannHypothesis: every zero s of ζ that is not a trivial
-- zero −2(n + 1) and not s = 1 has re s = 1/2. The natural n is cast into
-- ℂ as complexOfReal(realNat(n)).
predicate RiemannHypothesis :=
  ∀ s ∈ complexCarrier, riemannZeta(s) = ℂ[0] →
    ¬(∃ n ∈ ℕ, s = ℂ[-2 * (complexOfReal(realNat(n)) + 1)]) →
    s ≠ ℂ[1] → complexRe(s) = R[1 / 2]

-- Statements.lean, RiemannZetaZerosOnLine: the same proposition.
predicate RiemannZetaZerosOnLine :=
  ∀ s ∈ complexCarrier, riemannZeta(s) = ℂ[0] →
    ¬(∃ n ∈ ℕ, s = ℂ[-2 * (complexOfReal(realNat(n)) + 1)]) →
    s ≠ ℂ[1] → complexRe(s) = R[1 / 2]

-- Statements.lean, DirichletLNonvanishingRightOfHalf. Mathlib's χ ≠ 1 is
-- "χ is not the trivial character modulo N", the character that is 1 on
-- the units of ℤ/Nℤ and 0 elsewhere: here χ ≠ principalCharacter(N), two
-- functions on ℤ that differ at some integer (`principalCharacter.eq_iff`).
-- [NeZero N] is 1 ≤ N.
predicate DirichletLNonvanishingRightOfHalf :=
  ∀ N ∈ ℕ, 1 ≤ N → ∀ χ, DirichletCharacter(N, χ) → ∀ s ∈ complexCarrier,
    R[1 / 2] < complexRe(s) → (χ ≠ principalCharacter(N) ∨ s ≠ ℂ[1]) →
    LFunction(N, χ, s) ≠ ℂ[0]

-- Statements.lean, DirichletLZerosOnLine.
predicate DirichletLZerosOnLine :=
  ∀ N ∈ ℕ, 1 ≤ N → ∀ χ, DirichletCharacter(N, χ) → ∀ s ∈ complexCarrier,
    realZero < complexRe(s) → complexRe(s) < realOne →
    LFunction(N, χ, s) = ℂ[0] → complexRe(s) = R[1 / 2]

-- Statements.lean, PrimitiveDirichletLZerosOnLine.
predicate PrimitiveDirichletLZerosOnLine :=
  ∀ N ∈ ℕ, 1 ≤ N → ∀ χ, DirichletCharacter(N, χ) →
    PrimitiveCharacter(N, χ) → ∀ s ∈ complexCarrier,
    realZero < complexRe(s) → complexRe(s) < realOne →
    LFunction(N, χ, s) = ℂ[0] → complexRe(s) = R[1 / 2]

-- Section: The argument
-- New/Main.lean, New.grh: no Dirichlet L-function vanishes on re s > 1/2,
-- the pole of the principal character excepted.
theorem LFunction.nonzero_right_of_half
  shows DirichletLNonvanishingRightOfHalf()
proof
  sorry

-- New/Main.lean, New.zeta_zeros_on_line: the Riemann Hypothesis from the
-- half-plane form, through ζ = L(·, 1) modulo 1, the functional equation
-- ξ(s) = ξ(1 − s), and the trivial zeros as the poles of Γ_ℝ.
theorem riemannHypothesis.of_grh
  requires grh : DirichletLNonvanishingRightOfHalf()
  shows RiemannZetaZerosOnLine()
proof
  unfold DirichletLNonvanishingRightOfHalf at grh
  unfold RiemannZetaZerosOnLine
  intros s hs zero notTrivial notOne
  -- ζ is L(·, 1) modulo 1, so ζ(w) ≠ 0 for re w > 1/2 and w ≠ 1.
  have character := principalCharacter.character at 1
  have oneNat : (1:N) ∈ ℕ by typecheck
  have oneLe : (1:N) ≤ (1:N) by arith
  have atOne := grh with oneNat, oneLe
  have right : ∀ w ∈ ℂ, R[1 / 2] < complexRe(w) → w ≠ ℂ[1] →
      riemannZeta(w) ≠ ℂ[0]
    intros w hw above notOneW
    have notPole : principalCharacter(1) ≠ principalCharacter(1) ∨ w ≠ ℂ[1]
      right
      exact notOneW
    have nonzero := atOne at principalCharacter(1) with character, hw,
      above, notPole
    rwa (LFunction.principal_one with character, hw) at nonzero
  have halves := realHalf.add_self
  have reReal := complexRe.real with hs
  have halfReal : R[1 / 2] ∈ ℝ by typecheck
  have order := realLess.trichotomy at complexRe(s), R[1 / 2]
  cases order with below | rest
  . -- re s < 1/2: on re s ≤ 0 the zero is trivial; in the strip it
    -- reflects to a zero at 1 − s with re(1 − s) > 1/2.
    exfalso
    have zeroReal : realZero ∈ ℝ by typecheck
    have sign := realLess.trichotomy at complexRe(s), realZero
    cases sign with negative | nonnegative
    . have left : complexRe(s) ≤ realZero by linarith
      have trivial := zeta.zeros_left with hs, left, zero
      exact notTrivial with trivial
    . cases nonnegative with vanishing | lower
      . have left : complexRe(s) ≤ realZero by linarith
        have trivial := zeta.zeros_left with hs, left, zero
        exact notTrivial with trivial
      . have upper : complexRe(s) < realOne by linarith
        have reflectedZero := zeta.zero_reflect with hs, lower, upper, zero
        have reflected : ℂ[1 - s] ∈ ℂ by typecheck
        have reflectedRe := complexRe.one_sub with hs
        have above : R[1 / 2] < complexRe(ℂ[1 - s])
          rw reflectedRe
          linarith
        have reflectedBelow : complexRe(ℂ[1 - s]) < realOne
          rw reflectedRe
          linarith
        have reflectedNotOne := complex.ne_one_of_re_lt with reflectedBelow
        exact (right with reflected, above, reflectedNotOne) with reflectedZero
  . cases rest with onLine | above
    . exact onLine
    . exfalso
      exact (right with hs, above, notOne) with zero

-- New/Main.lean, New.zeros_on_line: zeros in the critical strip lie on the
-- line, from nonvanishing on re s > 1/2 for χ and for χ̄ and the
-- functional equation of L(s, χ) relating s to 1 − s.
theorem LFunction.zeros_on_line.of_grh
  requires grh : DirichletLNonvanishingRightOfHalf()
  shows DirichletLZerosOnLine()
proof
  unfold DirichletLNonvanishingRightOfHalf at grh
  unfold DirichletLZerosOnLine
  intros N hN positive χ character s hs lower upper zero
  have notOne := complex.ne_one_of_re_lt with upper
  have halves := realHalf.add_self
  have reReal := complexRe.real with hs
  have halfReal : R[1 / 2] ∈ ℝ by typecheck
  have order := realLess.trichotomy at complexRe(s), R[1 / 2]
  cases order with below | rest
  . -- re s < 1/2: pass to the primitive character ψ inducing χ, whose
    -- L-function vanishes at s too since the level factors do not; then
    -- L(1 − s, ψ̄) = 0 with re(1 − s) > 1/2.
    exfalso
    have nPositive : 0 < N by arith
    obtain ⟨ψ, primitiveCharacter, primitive, induced⟩ :=
      DirichletCharacter.primitive_induced with character, nPositive
    have conductorPositive := conductor.positive with character, nPositive
    have conductorNat := conductor.natural with character
    have dividing := conductor.dvd with character
    have conductorOne : 1 ≤ conductor(N, χ) by arith
    have notPole : ψ ≠ principalCharacter(conductor(N, χ)) ∨ s ≠ ℂ[1]
      right
      exact notOne
    have change := LFunction.changeLevel with positive, dividing,
      primitiveCharacter, hs, notPole
    rw [← induced, zero] at change
    have values := DirichletCharacter.function with primitiveCharacter
    have primitiveValue := LFunction.closed at conductor(N, χ), ψ, s with
      values, hs
    have factors := levelProduct.member at N, ψ, s, succ(N) with values, hs
    have factorsNonzero := levelProduct.nonzero at N, conductor(N, χ), ψ, s,
      succ(N) with primitiveCharacter, hs, lower
    have product : ℂ[levelProduct(N, ψ, s, succ(N)) *
        LFunction(conductor(N, χ), ψ, s)] = ℂ[0]
      linear_combination -change
    have primitiveZero := complexMul.zero_factor with factors,
      primitiveValue, factorsNonzero, product
    have reflectedZero := LFunction.zero_reflect with conductorOne,
      primitiveCharacter, primitive, hs, lower, upper, primitiveZero
    have conjugate := conjCharacter.character with primitiveCharacter
    have reflected : ℂ[1 - s] ∈ ℂ by typecheck
    have reflectedRe := complexRe.one_sub with hs
    have above : R[1 / 2] < complexRe(ℂ[1 - s])
      rw reflectedRe
      linarith
    have reflectedBelow : complexRe(ℂ[1 - s]) < realOne
      rw reflectedRe
      linarith
    have reflectedNotOne := complex.ne_one_of_re_lt with reflectedBelow
    have reflectedNotPole : conjCharacter(ψ) ≠
        principalCharacter(conductor(N, χ)) ∨ ℂ[1 - s] ≠ ℂ[1]
      right
      exact reflectedNotOne
    have atLevel := grh with conductorNat, conductorOne
    have atCharacter := atLevel at conjCharacter(ψ) with conjugate
    have nonzero := atCharacter with reflected, above, reflectedNotPole
    exact nonzero with reflectedZero
  . cases rest with onLine | above
    . exact onLine
    . exfalso
      have notPole : χ ≠ principalCharacter(N) ∨ s ≠ ℂ[1]
        right
        exact notOne
      have atLevel := grh with hN, positive
      have atCharacter := atLevel at χ with character
      have nonzero := atCharacter with hs, above, notPole
      exact nonzero with zero

-- Section: The theorems
-- Main.lean, riemannHypothesis : RiemannHypothesis.
theorem riemannHypothesis
  shows RiemannHypothesis()
proof
  have grh := LFunction.nonzero_right_of_half
  have zeros := riemannHypothesis.of_grh with grh
  unfold RiemannHypothesis
  unfold RiemannZetaZerosOnLine at zeros
  exact zeros

-- Main.lean, riemannZeta_eq_zero_re : RiemannZetaZerosOnLine.
theorem zeta.zeros_on_line
  shows RiemannZetaZerosOnLine()
proof
  have grh := LFunction.nonzero_right_of_half
  exact riemannHypothesis.of_grh with grh

-- Main.lean, LFunction_ne_zero_of_half_lt_re is
-- LFunction.nonzero_right_of_half above.

-- Main.lean, LFunction_eq_zero_re : DirichletLZerosOnLine.
theorem LFunction.zeros_on_line
  shows DirichletLZerosOnLine()
proof
  have grh := LFunction.nonzero_right_of_half
  exact LFunction.zeros_on_line.of_grh with grh

-- Main.lean, LFunction_eq_zero_re_of_isPrimitive :
-- PrimitiveDirichletLZerosOnLine, the case of primitive characters.
theorem LFunction.zeros_on_line_primitive
  shows PrimitiveDirichletLZerosOnLine()
proof
  have zeros := LFunction.zeros_on_line
  unfold DirichletLZerosOnLine at zeros
  unfold PrimitiveDirichletLZerosOnLine
  intros N hN positive χ character primitive s hs lower upper zero
  have atLevel := zeros with hN, positive
  have atCharacter := atLevel at χ with character
  exact atCharacter with hs, lower, upper, zero

end Statements
