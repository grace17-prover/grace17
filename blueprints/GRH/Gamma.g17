-- The Gamma function on ℂ minus the nonpositive integers, through its
-- reciprocal, the entire function given by Gauss's limit
-- 1/Γ(s) = lim n^(−s) s(s + 1)⋯(s + n)/n!: the functional equation
-- Γ(s + 1) = sΓ(s), Γ(1) = 1, Γ(n + 1) = n!, Γ(1/2) = √π, holomorphy off
-- the poles, 1/Γ entire with zeros exactly at the poles, the reflection
-- and duplication formulas, and Euler's integral for re s > 0.
-- Part of the GRH blueprint.
-- Planned home: Complex/Gamma.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Gamma
import GRH.Hurwitz
import Grace.Cumulus.Real.Analysis.TriangularSeries

section Gamma
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- Section: Definitions
-- The poles 0, −1, −2, … of Γ, and the domain ℂ ∖ {0, −1, −2, …}.
def gammaPoles : Set :=
  { z ∈ complexCarrier | ∃ n ∈ ℕ, z = ℂ[-complexOfReal(realNat(n))] }

def gammaDomain : Set := complexCarrier ∖ gammaPoles

-- The terms of Gauss's limit, m^(−s) s(s + 1)⋯(s + m)/m! for m = n + 1,
-- indexed from n = 0.
defgraph reciprocalGammaTerms (s : Set) (n ∈ ℕ) : complexCarrier :=
  ℂ[realCpow(realNat(n + 1), ℂ[-s]) * risingFactorial(s, n + 2) *
    complexOfReal(R[1 / factorial(n + 1)])]
requires hs : s ∈ complexCarrier
proof
  have nNat := nat.omega.backward at n with member
  have negative : ℂ[-s] ∈ ℂ by typecheck
  have power := realCpow.member at realNat(n + 1), ℂ[-s] with negative
  have rising := risingFactorial.closed at s, n + 2 with hs
  have coefficient : R[1 / factorial(n + 1)] ∈ ℝ by typecheck
  have cast := FunctionBetween.apply_closed with complexOfReal.function,
    coefficient
  typecheck

-- 1/Γ(s) is the limit of Gauss's sequence. The sequence converges for
-- every complex s (`reciprocalGamma.converges`); the second alternative
-- makes the definition total without assuming it.
defunique reciprocalGamma (s : Set) (w ∈ complexCarrier) :=
  ComplexConvergesTo(reciprocalGammaTerms(s), w) ∨
  (¬(∃ v ∈ complexCarrier, ComplexConvergesTo(reciprocalGammaTerms(s), v)) ∧
    w = complexZero)
proof
  by_cases converges :
      ∃ v ∈ complexCarrier, ComplexConvergesTo(reciprocalGammaTerms(s), v)
  . obtain ⟨v, hv, limit⟩ := converges
    refine ⟨v, hv, ?_⟩
    left
    exact limit
  . refine ⟨complexZero, complexZero.member, ?_⟩
    right
    exact ⟨converges, rfl⟩
uniqueness
  intros w wMember wValue v vMember vValue
  cases wValue with wLimit | wDefault
  . cases vValue with vLimit | vDefault
    . exact ComplexConvergesTo.unique with wLimit, vLimit
    . obtain ⟨none, _⟩ := vDefault
      exfalso
      exact none with ⟨w, wMember, wLimit⟩
  . obtain ⟨none, wZero⟩ := wDefault
    cases vValue with vLimit | vDefault
    . exfalso
      exact none with ⟨v, vMember, vLimit⟩
    . obtain ⟨_, vZero⟩ := vDefault
      rw [wZero, vZero]

-- Γ(s) = 1/(1/Γ(s)); at the poles, where 1/Γ vanishes, this is 0⁻¹ = 0,
-- a value no theorem reads.
def Gamma (s : Set) : Set := complexInv(reciprocalGamma(s))

-- 1/Γ as a function on ℂ, and Γ as a function on ℂ ∖ {0, −1, −2, …}.
defgraph reciprocalGammaMap (s ∈ complexCarrier) : complexCarrier :=
    reciprocalGamma(s)
proof
  obtain ⟨value, _⟩ := reciprocalGamma.selected at s
  exact value

defgraph GammaMap (s ∈ gammaDomain) : complexCarrier := Gamma(s)
proof
  unfold Gamma
  obtain ⟨value, _⟩ := reciprocalGamma.selected at s
  exact complexInv.member with value

-- The integrand t^(s−1) e^(−t) of Euler's integral, as a complex function
-- of the real variable t; only t > 0 is read.
defgraph eulerIntegrand (s : Set) (X ∈ ℝ) : complexCarrier :=
  ℂ[realCpow(X, ℂ[s - 1]) * complexOfReal(realExp(R[-X]))]
requires hs : s ∈ complexCarrier
proof
  have shifted : ℂ[s - 1] ∈ ℂ by typecheck
  have power := realCpow.member at X, ℂ[s - 1] with shifted
  typecheck

-- Section: The domain
theorem gammaDomain.subset
  shows gammaDomain ⊆ complexCarrier
proof
  intros z hz
  unfold gammaDomain at hz
  exact hz.left

-- A point of the open right half-plane is not a pole.
theorem gammaDomain.of_re_positive (s : Set)
  requires hs : s ∈ ℂ
  requires positive : realZero < complexRe(s)
  shows s ∈ gammaDomain
proof
  unfold gammaDomain
  refine ⟨hs, ?_⟩
  intro pole
  obtain ⟨_, n, hn, shape⟩ := pole
  have nNat := nat.omega.backward at n with hn
  have cast : complexOfReal(realNat(n)) ∈ ℂ by typecheck
  have re := complexRe.neg with cast
  rw [← shape, complexOfReal.re] at re
  have nonnegative := realNat.nonnegative at n
  linarith

-- Every real x is at distance at least 1 from all of 0, −1, −2, … but two
-- consecutive ones −k and −(k + 1).
theorem gammaPoles.spacing (X : Real)
  shows ∃ k ∈ ℕ, ∀ n ∈ ℕ, n ≠ k → n ≠ k + 1 →
    R[1] ≤ abs(R[X + realNat(n)])
proof
  have generic : ∀ k ∈ ℕ, realNat(k) ≤ R[-X] → R[-X] < R[realNat(k) + 1] →
      ∀ n ∈ ℕ, n ≠ k → n ≠ k + 1 → R[1] ≤ abs(R[X + realNat(n)])
    intros k hk lower upper n hn first second
    have kNat := nat.omega.backward at k with hk
    have nNat := nat.omega.backward at n with hn
    have bounds := abs.upper at R[X + realNat(n)]
    have boundsNeg := abs.upper_neg at R[X + realNat(n)]
    by_cases below : n < k
    . have step : n + 1 ≤ k by arith
      have cast := realNat.monotone with step
      rw [realNat.add, realNat.one] at cast
      linarith
    . have ge : k ≤ n by arith
      have gt : k < n by arith
      have gt1 : k + 1 ≤ n by arith
      have gt2 : k + 1 < n by arith
      have step : k + 2 ≤ n by arith
      have cast := realNat.monotone with step
      rw [realNat.add, realNat.two] at cast
      linarith
  by_cases nonnegative : R[0] ≤ R[-X]
  . have kNat := realFloor.natural with nonnegative
    have lower := realFloor.le with nonnegative
    have upper := realFloor.lt with nonnegative
    have kMember : realFloor(R[-X]) ∈ ℕ by typecheck
    refine ⟨realFloor(R[-X]), kMember, ?_⟩
    exact generic with realFloor(R[-X]), kMember, lower, upper
  . have positive := realLess.of_not_le with nonnegative
    have zero : (0:N) ∈ ℕ by typecheck
    refine ⟨(0:N), zero, ?_⟩
    intros n hn first second
    have nNat := nat.omega.backward at n with hn
    have bounds := abs.upper at R[X + realNat(n)]
    have positiveN : (1:N) ≤ n by arith
    have simplify : (0:N) + 1 = (1:N) by arith
    rw simplify at second
    have step : 2 ≤ n by arith
    have cast := realNat.monotone with step
    rw realNat.two at cast
    linarith

theorem gammaDomain.open
  shows ComplexOpen(gammaDomain)
proof
  have inside := gammaDomain.subset
  apply ComplexOpen.of_disks with inside
  intros z hz
  have zMember := inside with z, hz
  have notPole : ¬(z ∈ gammaPoles)
    unfold gammaDomain at hz
    exact hz.right
  obtain ⟨k, hk, spacing⟩ := gammaPoles.spacing at complexRe(z)
  have kNat := nat.omega.backward at k with hk
  have nearPole : ∀ n ∈ ℕ, R[0] < complexAbs(ℂ[z + complexOfReal(realNat(n))])
    intros n hn
    have nNat := nat.omega.backward at n with hn
    have sum : ℂ[z + complexOfReal(realNat(n))] ∈ ℂ by typecheck
    have nonzero : ℂ[z + complexOfReal(realNat(n))] ≠ ℂ[0]
      intro zero
      apply notPole
      apply gammaPoles.membership.backward
      refine ⟨zMember, n, hn, ?_⟩
      have same : z = ℂ[(z + complexOfReal(realNat(n))) -
        complexOfReal(realNat(n))] by ring
      rw [same, zero]
      ring
    exact complexAbs.positive with sum, nonzero
  have k1 : k + 1 ∈ ℕ by typecheck
  have firstPositive := nearPole with k, hk
  have secondPositive := nearPole with k + 1, k1
  have firstReal : complexAbs(ℂ[z + complexOfReal(realNat(k))]) ∈ ℝ by
    typecheck
  have secondReal : complexAbs(ℂ[z + complexOfReal(realNat(k + 1))]) ∈ ℝ by
    typecheck
  obtain ⟨r1, hr1, r1Positive, r1First, r1Second⟩ := realRadius.common with
    firstReal, secondReal, firstPositive, secondPositive
  have one : R[1] ∈ ℝ by typecheck
  have onePositive : R[0] < R[1] by linarith
  obtain ⟨r, hr, rPositive, rBelow, rOne⟩ := realRadius.common with hr1, one,
    r1Positive, onePositive
  refine ⟨r, hr, rPositive, ?_⟩
  intros w hw
  obtain ⟨wMember, close⟩ := complexDisk.membership.forward with hw
  unfold gammaDomain
  refine ⟨wMember, ?_⟩
  intro pole
  obtain ⟨_, n, hn, shape⟩ := gammaPoles.membership.forward with pole
  have nNat := nat.omega.backward at n with hn
  have cast : complexOfReal(realNat(n)) ∈ ℂ by typecheck
  have difference : ℂ[w - z] = ℂ[-(z + complexOfReal(realNat(n)))]
    rw shape
    ring
  have sum : ℂ[z + complexOfReal(realNat(n))] ∈ ℂ by typecheck
  rw [difference, (complexAbs.neg with sum)] at close
  by_cases atK : n = k
  . rw atK at close
    linarith
  . by_cases atK1 : n = k + 1
    . rw atK1 at close
      linarith
    . have far := spacing with n, hn, atK, atK1
      have reBound := complexAbs.re_le with sum
      have reSum : complexRe(ℂ[z + complexOfReal(realNat(n))]) =
          R[complexRe(z) + realNat(n)]
        rw [(complexRe.add with zMember, cast), complexOfReal.re]
      rw reSum at reBound
      linarith

-- The open upper and lower half-planes.
def complexUpperHalf : Set := { z ∈ complexCarrier | realZero < complexIm(z) }

def complexLowerHalf : Set := { z ∈ complexCarrier | complexIm(z) < realZero }

-- The connected subsets of the domain through the point 1 + i.
def gammaDomainPieces : Set :=
  { A ∈ 𝒫(gammaDomain) | ComplexConnected(A) ∧ (R[1], R[1]) ∈ A }

theorem complexUpperHalf.connected
  shows ComplexConnected(complexUpperHalf)
proof
  have inside : complexUpperHalf ⊆ ℂ
    intros z hz
    exact (complexUpperHalf.membership.forward with hz).left
  have one : R[1] ∈ ℝ by typecheck
  have zero : R[0] ∈ ℝ by typecheck
  have pMember : (R[0], R[1]) ∈ ℂ by typecheck
  have center : (R[0], R[1]) ∈ complexUpperHalf
    apply complexUpperHalf.membership.backward
    refine ⟨pMember, ?_⟩
    rw complexPoint.im
    linarith
  apply ComplexConnected.of_star with inside, center
  intros q hq t ht lower upper
  obtain ⟨qMember, qPositive⟩ := complexUpperHalf.membership.forward with hq
  have imQ := complexIm.real with qMember
  have point : ℂ[(R[0], R[1]) + complexOfReal(t) * (q - (R[0], R[1]))] ∈ ℂ by
    typecheck
  apply complexUpperHalf.membership.backward
  refine ⟨point, ?_⟩
  rw [(segment.im with pMember, qMember, ht), complexPoint.im]
  have qNonnegative : R[0] ≤ complexIm(q) by linarith
  have product := realMulValue.nonnegative with lower, qNonnegative
  have expand : R[1 + t * (complexIm(q) - 1)] =
    R[(1 - t) + t * complexIm(q)] by ring
  rw expand
  by_cases below : t < R[1]
  . linarith
  . have atOne : t = R[1] by linarith
    have same : R[t * complexIm(q)] = complexIm(q)
      rw atOne
      ring
    linarith

theorem complexLowerHalf.connected
  shows ComplexConnected(complexLowerHalf)
proof
  have inside : complexLowerHalf ⊆ ℂ
    intros z hz
    exact (complexLowerHalf.membership.forward with hz).left
  have one : R[-1] ∈ ℝ by typecheck
  have zero : R[0] ∈ ℝ by typecheck
  have pMember : (R[0], R[-1]) ∈ ℂ by typecheck
  have center : (R[0], R[-1]) ∈ complexLowerHalf
    apply complexLowerHalf.membership.backward
    refine ⟨pMember, ?_⟩
    rw complexPoint.im
    linarith
  apply ComplexConnected.of_star with inside, center
  intros q hq t ht lower upper
  obtain ⟨qMember, qNegative⟩ := complexLowerHalf.membership.forward with hq
  have imQ := complexIm.real with qMember
  have point : ℂ[(R[0], R[-1]) + complexOfReal(t) * (q - (R[0], R[-1]))] ∈ ℂ
    by typecheck
  apply complexLowerHalf.membership.backward
  refine ⟨point, ?_⟩
  rw [(segment.im with pMember, qMember, ht), complexPoint.im]
  have flipped : R[0] ≤ R[-complexIm(q)] by linarith
  have product := realMulValue.nonnegative with lower, flipped
  have negated : R[t * -complexIm(q)] = R[-(t * complexIm(q))] by ring
  rw negated at product
  have expand : R[-1 + t * (complexIm(q) - -1)] =
    R[-(1 - t) + t * complexIm(q)] by ring
  rw expand
  by_cases below : t < R[1]
  . linarith
  . have atOne : t = R[1] by linarith
    have same : R[t * complexIm(q)] = complexIm(q)
      rw atOne
      ring
    linarith

-- A point off the real axis is not a pole.
theorem gammaDomain.of_im_nonzero (z : Set)
  requires hz : z ∈ ℂ
  requires offAxis : complexIm(z) ≠ R[0]
  shows z ∈ gammaDomain
proof
  unfold gammaDomain
  refine ⟨hz, ?_⟩
  intro pole
  obtain ⟨_, n, hn, shape⟩ := gammaPoles.membership.forward with pole
  have nNat := nat.omega.backward at n with hn
  have cast : complexOfReal(realNat(n)) ∈ ℂ by typecheck
  apply offAxis
  rw [shape, (complexIm.neg with cast), complexOfReal.im]
  ring

theorem gammaDomain.connected
  shows ComplexConnected(gammaDomain)
proof
  have one : R[1] ∈ ℝ by typecheck
  have negOne : R[-1] ∈ ℝ by typecheck
  have upper := complexUpperHalf.connected
  have lower := complexLowerHalf.connected
  have right := rightHalfPlane.connected at R[0]
  have pMember : (R[1], R[1]) ∈ ℂ by typecheck
  have qMember : (R[1], R[-1]) ∈ ℂ by typecheck
  have pUpper : (R[1], R[1]) ∈ complexUpperHalf
    apply complexUpperHalf.membership.backward
    refine ⟨pMember, ?_⟩
    rw complexPoint.im
    linarith
  have pRight : (R[1], R[1]) ∈ rightHalfPlane(R[0])
    apply rightHalfPlane.membership.backward
    refine ⟨pMember, ?_⟩
    rw complexPoint.re
    linarith
  have qLower : (R[1], R[-1]) ∈ complexLowerHalf
    apply complexLowerHalf.membership.backward
    refine ⟨qMember, ?_⟩
    rw complexPoint.im
    linarith
  have qRight : (R[1], R[-1]) ∈ rightHalfPlane(R[0])
    apply rightHalfPlane.membership.backward
    refine ⟨qMember, ?_⟩
    rw complexPoint.re
    linarith
  have meetsFirst : Nonempty(complexUpperHalf ∩ rightHalfPlane(R[0]))
    exact ⟨(R[1], R[1]),
      (intersection.membership.backward with ⟨pUpper, pRight⟩)⟩
  have first := IsConnectedSubset.union2 with upper, right, meetsFirst
  have qFirst : (R[1], R[-1]) ∈ complexUpperHalf ∪ rightHalfPlane(R[0])
    apply union2.membership.backward
    right
    exact qRight
  have meetsSecond : Nonempty((complexUpperHalf ∪ rightHalfPlane(R[0])) ∩
      complexLowerHalf)
    exact ⟨(R[1], R[-1]),
      (intersection.membership.backward with ⟨qFirst, qLower⟩)⟩
  have core := IsConnectedSubset.union2 with first, lower, meetsSecond
  -- The core (upper ∪ right) ∪ lower lies in the domain.
  have coreInside : (complexUpperHalf ∪ rightHalfPlane(R[0])) ∪
      complexLowerHalf ⊆ gammaDomain
    intros w hw
    cases (union2.membership.forward with hw) with wFirst | wLower
    . cases (union2.membership.forward with wFirst) with wUpper | wRight
      . obtain ⟨wMember, positive⟩ := complexUpperHalf.membership.forward with
          wUpper
        have offAxis : complexIm(w) ≠ R[0]
          intro zero
          rw zero at positive
          linarith
        exact gammaDomain.of_im_nonzero with wMember, offAxis
      . obtain ⟨wMember, positive⟩ := rightHalfPlane.membership.forward with
          wRight
        exact gammaDomain.of_re_positive with wMember, positive
    . obtain ⟨wMember, negative⟩ := complexLowerHalf.membership.forward with
        wLower
      have offAxis : complexIm(w) ≠ R[0]
        intro zero
        rw zero at negative
        linarith
      exact gammaDomain.of_im_nonzero with wMember, offAxis
  have pCore : (R[1], R[1]) ∈ (complexUpperHalf ∪ rightHalfPlane(R[0])) ∪
      complexLowerHalf
    apply union2.membership.backward
    left
    apply union2.membership.backward
    left
    exact pUpper
  have pieces := IsConnectedSubset.union_family at complexCarrier,
    complexTopology, gammaDomainPieces, (R[1], R[1])
  have connectedPieces : ∀ A ∈ gammaDomainPieces,
      IsConnectedSubset(complexCarrier, complexTopology, A)
    intros A hA
    have parts := gammaDomainPieces.membership.forward with hA
    exact parts.right.left
  have commonPieces : ∀ A ∈ gammaDomainPieces, (R[1], R[1]) ∈ A
    intros A hA
    have parts := gammaDomainPieces.membership.forward with hA
    exact parts.right.right
  have unionConnected := pieces with connectedPieces, commonPieces
  have isOpen := gammaDomain.open
  have equal : ⋃(gammaDomainPieces) = gammaDomain
    apply Subset.antisymmetric
    . intros z hz
      obtain ⟨A, hA, zA⟩ := union.membership.forward with hz
      have parts := gammaDomainPieces.membership.forward with hA
      have sub := powerset.membership_iff.forward with parts.left
      exact sub with z, zA
    . intros z hz
      have zMember := gammaDomain.subset with z, hz
      obtain ⟨ρ, hρ, ρPositive, disk⟩ := ComplexOpen.disk with isOpen, hz
      have diskConnected := complexDisk.connected with zMember, hρ
      have meets : Nonempty(((complexUpperHalf ∪ rightHalfPlane(R[0])) ∪
          complexLowerHalf) ∩ complexDisk(z, ρ))
        have zero : ℂ[z - z] = ℂ[0] by ring
        have zDisk : z ∈ complexDisk(z, ρ)
          apply complexDisk.membership.backward
          refine ⟨zMember, ?_⟩
          rw [zero, complexAbs.zero]
          exact ρPositive
        have imZ := complexIm.real with zMember
        by_cases negative : complexIm(z) < R[0]
        . have zLower : z ∈ complexLowerHalf
            exact complexLowerHalf.membership.backward with ⟨zMember, negative⟩
          have zCore : z ∈ (complexUpperHalf ∪ rightHalfPlane(R[0])) ∪
              complexLowerHalf
            apply union2.membership.backward
            right
            exact zLower
          exact ⟨z, (intersection.membership.backward with ⟨zCore, zDisk⟩)⟩
        . have iMember := complexImaginaryUnit.member
          have halfReal : half(ρ) ∈ ℝ by typecheck
          have halfPositive := half.positive with ρPositive
          have halfBelow := half.lt_self with ρPositive
          have shiftMember : ℂ[z + complexImaginaryUnit * complexOfReal(half(ρ))]
            ∈ ℂ by typecheck
          have imI : complexIm(complexImaginaryUnit) = R[1]
            unfold complexImaginaryUnit
            unfold complexIm
            rw snd.pair
          have reI : complexRe(complexImaginaryUnit) = R[0]
            unfold complexImaginaryUnit
            unfold complexRe
            rw fst.pair
          have castMember : complexOfReal(half(ρ)) ∈ ℂ by typecheck
          have productMember : ℂ[complexImaginaryUnit * complexOfReal(half(ρ))]
            ∈ ℂ by typecheck
          have imShift : complexIm(ℂ[z + complexImaginaryUnit *
              complexOfReal(half(ρ))]) = R[complexIm(z) + half(ρ)]
            rw [(complexIm.add with zMember, productMember),
              (complexIm.mul with iMember, castMember), imI, reI,
              complexOfReal.re, complexOfReal.im]
            ring
          have shiftUpper : ℂ[z + complexImaginaryUnit * complexOfReal(half(ρ))]
              ∈ complexUpperHalf
            apply complexUpperHalf.membership.backward
            refine ⟨shiftMember, ?_⟩
            rw imShift
            linarith
          have shiftCore : ℂ[z + complexImaginaryUnit * complexOfReal(half(ρ))]
              ∈ (complexUpperHalf ∪ rightHalfPlane(R[0])) ∪ complexLowerHalf
            apply union2.membership.backward
            left
            apply union2.membership.backward
            left
            exact shiftUpper
          have shiftDisk : ℂ[z + complexImaginaryUnit * complexOfReal(half(ρ))]
              ∈ complexDisk(z, ρ)
            apply complexDisk.membership.backward
            refine ⟨shiftMember, ?_⟩
            have same : ℂ[(z + complexImaginaryUnit * complexOfReal(half(ρ))) -
                z] = ℂ[complexImaginaryUnit * complexOfReal(half(ρ))] by ring
            have halfNonnegative : R[0] ≤ half(ρ) by linarith
            rw [same, (complexAbs.mul with iMember, castMember),
              complexAbs.imaginary, complexAbs.of_real,
              (abs.of_nonnegative with halfNonnegative)]
            have unit : R[1 * half(ρ)] = half(ρ) by ring
            rw unit
            exact halfBelow
          exact ⟨ℂ[z + complexImaginaryUnit * complexOfReal(half(ρ))],
            (intersection.membership.backward with ⟨shiftCore, shiftDisk⟩)⟩
      have piece := IsConnectedSubset.union2 with core, diskConnected, meets
      have pieceInside : ((complexUpperHalf ∪ rightHalfPlane(R[0])) ∪
          complexLowerHalf) ∪ complexDisk(z, ρ) ⊆ gammaDomain
        intros w hw
        cases (union2.membership.forward with hw) with wCore | wDisk
        . exact coreInside with w, wCore
        . exact disk with w, wDisk
      have pPiece : (R[1], R[1]) ∈ ((complexUpperHalf ∪ rightHalfPlane(R[0])) ∪
          complexLowerHalf) ∪ complexDisk(z, ρ)
        apply union2.membership.backward
        left
        exact pCore
      have zPiece : z ∈ ((complexUpperHalf ∪ rightHalfPlane(R[0])) ∪
          complexLowerHalf) ∪ complexDisk(z, ρ)
        apply union2.membership.backward
        right
        have zero : ℂ[z - z] = ℂ[0] by ring
        apply complexDisk.membership.backward
        refine ⟨zMember, ?_⟩
        rw [zero, complexAbs.zero]
        exact ρPositive
      have member : ((complexUpperHalf ∪ rightHalfPlane(R[0])) ∪
          complexLowerHalf) ∪ complexDisk(z, ρ) ∈ gammaDomainPieces
        apply gammaDomainPieces.membership.backward
        refine ⟨(powerset.membership_iff.backward with pieceInside), piece,
          pPiece⟩
      exact union.membership.backward with ⟨((complexUpperHalf ∪
        rightHalfPlane(R[0])) ∪ complexLowerHalf) ∪ complexDisk(z, ρ), member,
        zPiece⟩
  unfold ComplexConnected
  rw ← equal
  exact unionConnected

-- Section: Gauss's sequence
-- Products of nonnegative bounds.
theorem gammaReal.mul_le (A B C D : Real)
  requires nonnegativeA : R[0] ≤ A
  requires ab : A ≤ B
  requires nonnegativeC : R[0] ≤ C
  requires cd : C ≤ D
  shows R[A * C] ≤ R[B * D]
proof
  have first := realLe.mul_right_of_nonnegative with ab, nonnegativeC
  have nonnegativeB : R[0] ≤ B by linarith
  have second := realLe.mul_left_of_nonnegative with cd, nonnegativeB
  linarith

-- |e^w| ≤ e^B when |w| ≤ B.
theorem complexExp.abs_le (w : Set) (B : Real)
  requires hw : w ∈ ℂ
  requires bound : complexAbs(w) ≤ B
  shows complexAbs(complexExp(w)) ≤ realExp(B)
proof
  have reReal := complexRe.real with hw
  have reBound := complexAbs.re_le with hw
  have upper := abs.upper at complexRe(w)
  have below : complexRe(w) ≤ B by linarith
  rw (complexExp.abs with hw)
  exact (realExp.le_iff at complexRe(w), B).backward with below

-- The constant of the factor bound below.
def gaussConstant (B : Real) : Real :=
  R[realExp(B) * (2 * B * B + B + 2 * B * B * (1 + B + realExp(B)))]
proof
  unfold gaussConstant
  typecheck

-- The ratio of consecutive terms of Gauss's sequence is
-- e^(−s L) (1 + s c) with 1/(n + 2) = c ≤ L ≤ h = 1/(n + 1); it is
-- 1 + O(h − c) uniformly for |s| ≤ B.
theorem gaussFactor.bound (s : Set) (B h c L : Real)
  requires hs : s ∈ ℂ
  requires sBound : complexAbs(s) ≤ B
  requires cPositive : R[0] < c
  requires cL : c ≤ L
  requires Lh : L ≤ h
  requires hTwice : h ≤ R[2 * c]
  requires hOne : h ≤ R[1]
  requires product : R[h * c] = R[h - c]
  shows complexAbs(ℂ[complexExp(ℂ[-(s * complexOfReal(L))]) *
      (1 + s * complexOfReal(c)) - 1]) ≤ R[gaussConstant(B) * (h - c)]
proof
  have sAbs := complexAbs.nonnegative with hs
  have sAbsReal : complexAbs(s) ∈ ℝ by typecheck
  have RNonnegative : R[0] ≤ B by linarith
  have LNonnegative : R[0] ≤ L by linarith
  have hNonnegative : R[0] ≤ h by linarith
  have gap : R[0] ≤ R[h - c] by linarith
  have LMember : complexOfReal(L) ∈ ℂ by typecheck
  have cMember : complexOfReal(c) ∈ ℂ by typecheck
  have zMember : ℂ[s * complexOfReal(L)] ∈ ℂ by typecheck
  have negMember : ℂ[-(s * complexOfReal(L))] ∈ ℂ by typecheck
  have expMember : complexExp(ℂ[s * complexOfReal(L)]) ∈ ℂ by typecheck
  have expNegMember : complexExp(ℂ[-(s * complexOfReal(L))]) ∈ ℂ by typecheck
  -- |z| ≤ B h ≤ B for z = s L.
  have zAbs : complexAbs(ℂ[s * complexOfReal(L)]) = R[complexAbs(s) * L]
    rw [(complexAbs.mul with hs, LMember), complexAbs.of_real,
      (abs.of_nonnegative with LNonnegative)]
  have zRh := gammaReal.mul_le with sAbs, sBound, LNonnegative, Lh
  have RhR := realLe.mul_left_of_nonnegative with hOne, RNonnegative
  have unit : R[B * 1] = B by ring
  rw unit at RhR
  have zBound : complexAbs(ℂ[s * complexOfReal(L)]) ≤ B by linarith
  have negBound : complexAbs(ℂ[-(s * complexOfReal(L))]) ≤ B
    rw (complexAbs.neg with zMember)
    exact zBound
  have expNegBound := complexExp.abs_le with negMember, negBound
  have expBound := complexExp.abs_le with zMember, zBound
  have expNegNonnegative := complexAbs.nonnegative with expNegMember
  -- e^(−z) (1 + s c) − 1 = e^(−z) ((1 + z − e^z) + s (c − L)).
  have cancel : ℂ[complexExp(ℂ[-(s * complexOfReal(L))]) *
      complexExp(ℂ[s * complexOfReal(L)])] = ℂ[1]
    rw ← (complexExp.add with negMember, zMember)
    have zero : ℂ[-(s * complexOfReal(L)) + s * complexOfReal(L)] = ℂ[0] by
      ring
    rw [zero, complexExp.zero]
  have identity : ℂ[complexExp(ℂ[-(s * complexOfReal(L))]) *
      (1 + s * complexOfReal(c)) - 1] =
      ℂ[complexExp(ℂ[-(s * complexOfReal(L))]) *
        ((1 + s * complexOfReal(L) - complexExp(ℂ[s * complexOfReal(L)])) +
          s * (complexOfReal(c) - complexOfReal(L)))] by
    linear_combination cancel
  rw identity
  have firstMember : ℂ[1 + s * complexOfReal(L) -
    complexExp(ℂ[s * complexOfReal(L)])] ∈ ℂ by typecheck
  have secondMember : ℂ[s * (complexOfReal(c) - complexOfReal(L))] ∈ ℂ by
    typecheck
  have sumMember : ℂ[(1 + s * complexOfReal(L) -
    complexExp(ℂ[s * complexOfReal(L)])) +
      s * (complexOfReal(c) - complexOfReal(L))] ∈ ℂ by typecheck
  rw (complexAbs.mul with expNegMember, sumMember)
  have triangle := complexAbs.triangle with firstMember, secondMember
  have firstNonnegative := complexAbs.nonnegative with firstMember
  have secondNonnegative := complexAbs.nonnegative with secondMember
  -- |s (c − L)| ≤ B (h − c).
  have difference : ℂ[complexOfReal(c) - complexOfReal(L)] =
      complexOfReal(R[c - L])
    rw [complexOfReal.sub]
  have differenceMember : complexOfReal(R[c - L]) ∈ ℂ by typecheck
  have absDifference : abs(R[c - L]) = R[L - c]
    have nonpositive : R[c - L] ≤ R[0] by linarith
    rw (abs.of_nonpositive with nonpositive)
    ring
  have differenceBound : abs(R[c - L]) ≤ R[h - c]
    rw absDifference
    linarith
  have differenceNonnegative := abs.nonnegative at R[c - L]
  have secondBound : complexAbs(ℂ[s * (complexOfReal(c) - complexOfReal(L))])
      ≤ R[B * (h - c)]
    rw [difference, (complexAbs.mul with hs, differenceMember),
      complexAbs.of_real]
    exact gammaReal.mul_le with sAbs, sBound, differenceNonnegative,
      differenceBound
  have extraNonnegative : R[0] ≤ R[2 * B * B * (1 + B + realExp(B)) * (h - c)]
    have expPositive := realExp.positive at B
    have RR := realMulValue.nonnegative with RNonnegative, RNonnegative
    have inner : R[0] ≤ R[1 + B + realExp(B)] by linarith
    have three := realMulValue.nonnegative with RR, inner
    have four := realMulValue.nonnegative with three, gap
    have same : R[2 * B * B * (1 + B + realExp(B)) * (h - c)] =
      R[2 * (B * B * (1 + B + realExp(B)) * (h - c))] by ring
    rw same
    linarith
  have firstBound : complexAbs(ℂ[1 + s * complexOfReal(L) -
      complexExp(ℂ[s * complexOfReal(L)])]) ≤
      R[(2 * B * B + 2 * B * B * (1 + B + realExp(B))) * (h - c)]
    have flipped : ℂ[1 + s * complexOfReal(L) -
        complexExp(ℂ[s * complexOfReal(L)])] =
        ℂ[-(complexExp(ℂ[s * complexOfReal(L)]) - 1 - s * complexOfReal(L))] by
      ring
    have taylorMember : ℂ[complexExp(ℂ[s * complexOfReal(L)]) - 1 -
      s * complexOfReal(L)] ∈ ℂ by typecheck
    rw [flipped, (complexAbs.neg with taylorMember)]
    have hh := realLe.mul_left_of_nonnegative with hTwice, hNonnegative
    have hhGap : R[h * h] ≤ R[2 * (h - c)]
      have same : R[h * (2 * c)] = R[2 * (h * c)] by ring
      rw [same, product] at hh
      exact hh
    have RR := realMulValue.nonnegative with RNonnegative, RNonnegative
    have scaled := realLe.mul_left_of_nonnegative with hhGap, RR
    have zNonnegative := complexAbs.nonnegative with zMember
    have zAbsReal : complexAbs(ℂ[s * complexOfReal(L)]) ∈ ℝ by typecheck
    by_cases small : complexAbs(ℂ[s * complexOfReal(L)]) ≤ R[1]
    . have taylor := complexExp.quadratic_estimate with zMember, small
      have zRh2 : complexAbs(ℂ[s * complexOfReal(L)]) ≤ R[B * h] by linarith
      have square := gammaReal.mul_le with zNonnegative, zRh2, zNonnegative,
        zRh2
      have regroup : R[(B * h) * (B * h)] = R[(B * B) * (h * h)] by ring
      rw regroup at square
      have expand : R[(B * B) * (2 * (h - c))] =
        R[2 * B * B * (h - c)] by ring
      rw expand at scaled
      have split : R[(2 * B * B + 2 * B * B * (1 + B + realExp(B))) *
          (h - c)] = R[2 * B * B * (h - c) +
          2 * B * B * (1 + B + realExp(B)) * (h - c)] by ring
      rw split
      linarith
    . have large := realLess.of_not_le with small
      have Rh1 : R[1] < R[B * h] by linarith
      have RhPositive : R[0] < R[B * h] by linarith
      have squareLarge := realLess.mul_left_of_positive with Rh1, RhPositive
      have one1 : R[(B * h) * 1] = R[B * h] by ring
      rw one1 at squareLarge
      have regroup : R[(B * h) * (B * h)] = R[(B * B) * (h * h)] by ring
      rw regroup at squareLarge
      have expand : R[(B * B) * (2 * (h - c))] =
        R[2 * B * B * (h - c)] by ring
      rw expand at scaled
      have oneBelow : R[1] < R[2 * B * B * (h - c)] by linarith
      have crude : complexAbs(ℂ[complexExp(ℂ[s * complexOfReal(L)]) - 1 -
          s * complexOfReal(L)]) ≤ R[realExp(B) + 1 + B]
        have oneMember := complexOne.member
        have expMinusOne : ℂ[complexExp(ℂ[s * complexOfReal(L)]) - 1] ∈ ℂ by
          typecheck
        have step1 := complexAbs.sub_le with expMinusOne, zMember
        have step2 := complexAbs.sub_le with expMember, oneMember
        rw complexAbs.one at step2
        linarith
      have constantNonnegative : R[0] ≤ R[1 + B + realExp(B)]
        have expPositive := realExp.positive at B
        linarith
      have oneBelowLe : R[1] ≤ R[2 * B * B * (h - c)] by linarith
      have scaledLarge := realLe.mul_left_of_nonnegative with oneBelowLe,
        constantNonnegative
      have expand2 : R[(1 + B + realExp(B)) * (2 * B * B * (h - c))] =
        R[2 * B * B * (1 + B + realExp(B)) * (h - c)] by ring
      rw expand2 at scaledLarge
      have unit2 : R[(1 + B + realExp(B)) * 1] = R[1 + B + realExp(B)] by ring
      rw unit2 at scaledLarge
      have twoRR := realMulValue.nonnegative with RR, gap
      have same : R[2 * B * B * (h - c)] = R[2 * ((B * B) * (h - c))] by ring
      have split : R[(2 * B * B + 2 * B * B * (1 + B + realExp(B))) *
          (h - c)] = R[2 * B * B * (h - c) +
          2 * B * B * (1 + B + realExp(B)) * (h - c)] by ring
      rw split
      linarith
  have sumBound : R[complexAbs(ℂ[1 + s * complexOfReal(L) -
      complexExp(ℂ[s * complexOfReal(L)])]) +
      complexAbs(ℂ[s * (complexOfReal(c) - complexOfReal(L))])] ≤
      R[(2 * B * B + B + 2 * B * B * (1 + B + realExp(B))) * (h - c)]
    have split : R[(2 * B * B + B + 2 * B * B * (1 + B + realExp(B))) *
        (h - c)] = R[(2 * B * B + 2 * B * B * (1 + B + realExp(B))) *
        (h - c) + B * (h - c)] by ring
    rw split
    linarith
  have totalBound : complexAbs(ℂ[(1 + s * complexOfReal(L) -
      complexExp(ℂ[s * complexOfReal(L)])) +
      s * (complexOfReal(c) - complexOfReal(L))]) ≤
      R[(2 * B * B + B + 2 * B * B * (1 + B + realExp(B))) * (h - c)] by
    linarith
  have totalNonnegative := complexAbs.nonnegative with sumMember
  have final := gammaReal.mul_le with expNegNonnegative, expNegBound,
    totalNonnegative, totalBound
  unfold gaussConstant
  have regroup : R[realExp(B) * ((2 * B * B + B + 2 * B * B *
      (1 + B + realExp(B))) * (h - c))] = R[realExp(B) * (2 * B * B + B +
      2 * B * B * (1 + B + realExp(B))) * (h - c)] by ring
  rw regroup at final
  exact final

-- log(n + 2) − log(n + 1), between 1/(n + 2) and 1/(n + 1).
def gaussLogStep (n : Nat) : Real :=
  R[realLog(realNat(n + 2)) - realLog(realNat(n + 1))]
proof
  unfold gaussLogStep
  typecheck

-- The ratio of consecutive terms of Gauss's sequence.
def gaussFactor (s : Set) (n : Nat) : Set :=
  ℂ[complexExp(ℂ[-(s * complexOfReal(gaussLogStep(n)))]) *
    (1 + s * complexOfReal(R[1 / realNat(n + 2)]))]

theorem realNat.add_two (n : Nat)
  shows realNat(n + 2) = R[realNat(n) + 2]
proof
  rw [realNat.add, realNat.two]

theorem reciprocalGammaTerms.step (s : Set) (n : Nat)
  requires hs : s ∈ ℂ
  shows reciprocalGammaTerms(s)(n + 1) =
    ℂ[reciprocalGammaTerms(s)(n) * gaussFactor(s, n)]
proof
  have nMember : n ∈ ℕ by typecheck
  have n1Member : n + 1 ∈ ℕ by typecheck
  rw [(reciprocalGammaTerms.value with hs, n1Member),
    (reciprocalGammaTerms.value with hs, nMember)]
  have e1 : n + 1 + 1 = n + 2 by arith
  have e2 : n + 1 + 2 = succ(n + 2) by arith
  rw [e1, e2, risingFactorial.succ]
  unfold realCpow
  unfold gaussFactor
  unfold gaussLogStep
  have aMember : complexOfReal(realLog(realNat(n + 1))) ∈ ℂ by typecheck
  have lMember : complexOfReal(R[realLog(realNat(n + 2)) -
    realLog(realNat(n + 1))]) ∈ ℂ by typecheck
  have split : ℂ[-s * complexOfReal(realLog(realNat(n + 2)))] =
      ℂ[-s * complexOfReal(realLog(realNat(n + 1))) +
        -(s * complexOfReal(R[realLog(realNat(n + 2)) -
          realLog(realNat(n + 1))]))]
    rw complexOfReal.sub
    have bMember : complexOfReal(realLog(realNat(n + 2))) ∈ ℂ by typecheck
    ring
  have firstMember : ℂ[-s * complexOfReal(realLog(realNat(n + 1)))] ∈ ℂ by
    typecheck
  have secondMember : ℂ[-(s * complexOfReal(R[realLog(realNat(n + 2)) -
    realLog(realNat(n + 1))]))] ∈ ℂ by typecheck
  rw [split, (complexExp.add with firstMember, secondMember)]
  -- 1/(n + 2)! = 1/(n + 1)! · 1/(n + 2).
  have fact := realNat.factorial_succ at n + 1
  rw e1 at fact
  have shift : realNat(n + 2) = R[realNat(n + 1) + 1]
    rw [realNat.add_two, realNat.add, realNat.one]
    ring
  have factorialPositive := realNat.factorial_pos at n + 1
  have nonzeroFactorial : realNat((n + 1)!) ≠ R[0] by linarith
  have positive := realNat.successor_positive at n + 1
  have nonzeroN : R[realNat(n + 1) + 1] ≠ R[0] by linarith
  have recip : R[1 / realNat((n + 2)!)] =
      R[(1 / realNat((n + 1)!)) * (1 / realNat(n + 2))]
    rw [fact, shift, realDiv.eq_mul_inv, realDiv.eq_mul_inv,
      realDiv.eq_mul_inv, (realInvValue.mul with nonzeroN, nonzeroFactorial)]
    ring
  rw [recip, complexOfReal.mul]
  have nonzeroN2 : realNat(n + 2) ≠ R[0]
    rw shift
    exact nonzeroN
  have cancelN : ℂ[complexOfReal(realNat(n + 2)) *
      complexOfReal(R[1 / realNat(n + 2)])] = ℂ[1]
    rw [← complexOfReal.mul, (realDiv.mul_left with nonzeroN2), complexOfReal.one]
  have expA : complexExp(ℂ[-s * complexOfReal(realLog(realNat(n + 1)))]) ∈ ℂ
    by typecheck
  have expL : complexExp(ℂ[-(s * complexOfReal(R[realLog(realNat(n + 2)) -
    realLog(realNat(n + 1))]))]) ∈ ℂ by typecheck
  have rising := risingFactorial.member at s, n + 2 with hs
  have c1 : complexOfReal(R[1 / realNat((n + 1)!)]) ∈ ℂ by typecheck
  have c2 : complexOfReal(R[1 / realNat(n + 2)]) ∈ ℂ by typecheck
  have nC : complexOfReal(realNat(n + 2)) ∈ ℂ by typecheck
  linear_combination (complexExp(ℂ[-s * complexOfReal(realLog(realNat(n +
    1)))]) * complexExp(ℂ[-(s * complexOfReal(R[realLog(realNat(n + 2)) -
    realLog(realNat(n + 1))]))]) * risingFactorial(s, n + 2) *
    complexOfReal(R[1 / realNat((n + 1)!)])) * cancelN

-- With h = 1/(n + 1) and c = 1/(n + 2): 0 < c ≤ h ≤ 2c, h ≤ 1, hc = h − c.
theorem gaussGap.facts (n : Nat)
  shows R[0] < R[1 / realNat(n + 2)] ∧
    R[1 / realNat(n + 2)] ≤ R[1 / realNat(n + 1)] ∧
    R[1 / realNat(n + 1)] ≤ R[2 * (1 / realNat(n + 2))] ∧
    R[1 / realNat(n + 1)] ≤ R[1] ∧
    R[(1 / realNat(n + 1)) * (1 / realNat(n + 2))] =
      R[1 / realNat(n + 1) - 1 / realNat(n + 2)]
proof
  have shift : realNat(n + 2) = R[realNat(n + 1) + 1]
    rw [realNat.add_two, realNat.add, realNat.one]
    ring
  rw shift
  have positive := realNat.successor_positive at n
  have successor : realNat(n + 1) = R[realNat(n) + 1]
    rw [realNat.add, realNat.one]
  have zeroLe := realNat.zero_le at n
  have atLeastOne : R[1] ≤ realNat(n + 1) by linarith
  have aPositive : R[0] < realNat(n + 1) by linarith
  have bPositive : R[0] < R[realNat(n + 1) + 1] by linarith
  have aNonzero : realNat(n + 1) ≠ R[0] by linarith
  have bNonzero : R[realNat(n + 1) + 1] ≠ R[0] by linarith
  have e1 := realDiv.mul_left at R[1], realNat(n + 1) with aNonzero
  have e2 := realDiv.mul_left at R[1], R[realNat(n + 1) + 1] with bNonzero
  have hPositive : R[0] < R[1 / realNat(n + 1)]
    rw realDiv.eq_mul_inv
    have inverse := realInvValue.positive with aPositive
    have same : R[1 * realInvValue(realNat(n + 1))] =
      realInvValue(realNat(n + 1)) by ring
    rw same
    exact inverse
  have cPositive : R[0] < R[1 / (realNat(n + 1) + 1)]
    rw realDiv.eq_mul_inv
    have inverse := realInvValue.positive with bPositive
    have same : R[1 * realInvValue(R[realNat(n + 1) + 1])] =
      realInvValue(R[realNat(n + 1) + 1]) by ring
    rw same
    exact inverse
  have product : R[(1 / realNat(n + 1)) * (1 / (realNat(n + 1) + 1))] =
      R[1 / realNat(n + 1) - 1 / (realNat(n + 1) + 1)] by
    linear_combination R[1 / realNat(n + 1)] * e2 - R[1 / (realNat(n + 1) +
      1)] * e1
  have hc := realMulValue.positive with hPositive, cPositive
  have aMinus : R[0] ≤ R[realNat(n + 1) - 1] by linarith
  have hcNonnegative : R[0] ≤ R[(1 / realNat(n + 1)) *
    (1 / (realNat(n + 1) + 1))] by linarith
  have twice := realMulValue.nonnegative with hcNonnegative, aMinus
  have twiceForm : R[(1 / realNat(n + 1)) * (1 / (realNat(n + 1) + 1)) *
      (realNat(n + 1) - 1)] = R[2 * (1 / (realNat(n + 1) + 1)) -
      1 / realNat(n + 1)] by
    linear_combination R[1 / (realNat(n + 1) + 1)] * e1 - product
  have hNonnegative : R[0] ≤ R[1 / realNat(n + 1)] by linarith
  have hScaled := realMulValue.nonnegative with hNonnegative, aMinus
  have hForm : R[(1 / realNat(n + 1)) * (realNat(n + 1) - 1)] =
    R[1 - 1 / realNat(n + 1)] by linear_combination e1
  have hOne : R[1 / realNat(n + 1)] ≤ R[1] by linarith
  refine ⟨cPositive, ?_, ?_, hOne, product⟩
  . linarith
  . linarith

-- 1/Γ's sequence terms change by the factor bound.
theorem gaussFactor.close (s : Set) (B : Real) (n : Nat)
  requires hs : s ∈ ℂ
  requires sBound : complexAbs(s) ≤ B
  shows complexAbs(ℂ[gaussFactor(s, n) - 1]) ≤
    R[gaussConstant(B) * (1 / realNat(n + 1) - 1 / realNat(n + 2))]
proof
  obtain ⟨cPositive, ch, hTwice, hOne, product⟩ := gaussGap.facts at n
  have shift : realNat(n + 2) = R[realNat(n + 1) + 1]
    rw [realNat.add_two, realNat.add, realNat.one]
    ring
  have zeroLe := realNat.zero_le at n
  have successor : realNat(n + 1) = R[realNat(n) + 1]
    rw [realNat.add, realNat.one]
  have aPositive : R[0] < realNat(n + 1) by linarith
  have bPositive : R[0] < R[realNat(n + 1) + 1] by linarith
  obtain ⟨lower, upper⟩ := realLog.increment_bounds at realNat(n + 1), R[1]
    with aPositive, bPositive
  rw ← shift at lower
  rw ← shift at upper
  have one1 : R[1 * (1 / realNat(n + 2))] = R[1 / realNat(n + 2)] by ring
  have one2 : R[1 * (1 / realNat(n + 1))] = R[1 / realNat(n + 1)] by ring
  rw one1 at lower
  rw one2 at upper
  have cL : R[1 / realNat(n + 2)] ≤ gaussLogStep(n)
    unfold gaussLogStep
    exact lower
  have Lh : gaussLogStep(n) ≤ R[1 / realNat(n + 1)]
    unfold gaussLogStep
    exact upper
  unfold gaussFactor
  exact gaussFactor.bound with hs, sBound, cPositive, cL, Lh, hTwice, hOne,
    product

-- If |u(n + 1) − u(n)| ≤ |u(n)| K (1/(n + 1) − 1/(n + 2)) for all n, then
-- |u(N + j) − u(N)| ≤ |u(N)| (e^(K (1/(N + 1) − 1/(N + j + 1))) − 1).
theorem gaussSequence.propagate (u : Set) (K : Real) (N j : Nat)
  requires values : ∀ n ∈ ℕ, u(n) ∈ ℂ
  requires KNonnegative : R[0] ≤ K
  requires step : ∀ n ∈ ℕ, complexAbs(ℂ[u(n + 1) - u(n)]) ≤
    R[complexAbs(u(n)) * (K * (1 / realNat(n + 1) - 1 / realNat(n + 2)))]
  shows complexAbs(ℂ[u(N + j) - u(N)]) ≤ R[complexAbs(u(N)) *
    (realExp(R[K * (1 / realNat(N + 1) - 1 / realNat(N + j + 1))]) - 1)]
proof
  have NMember : N ∈ ℕ by typecheck
  have uN := values with N, NMember
  have uNNonnegative := complexAbs.nonnegative with uN
  induction j
  | zero =>
    have e0 : N + 0 = N by arith
    rw e0
    have zero : ℂ[u(N) - u(N)] = ℂ[0] by ring
    have gap : R[K * (1 / realNat(N + 1) - 1 / realNat(N + 1))] = R[0] by ring
    rw [zero, complexAbs.zero, gap, realExp.zero]
    have collapse : R[complexAbs(u(N)) * (1 - 1)] = R[0] by ring
    rw collapse
    linarith
  | succ(k) using ih =>
    have mMember : N + k ∈ ℕ by typecheck
    have e1 := add.right_one at N + k
    have e2 : N + k + 1 + 1 = N + k + 2 by arith
    rw [add.succ_right, ← e1, e2]
    have uM := values with N + k, mMember
    have m1Member : N + k + 1 ∈ ℕ by typecheck
    have uM1 := values with N + k + 1, m1Member
    obtain ⟨_, ch, _, _, _⟩ := gaussGap.facts at N + k
    have gapNonnegative : R[0] ≤ R[1 / realNat(N + k + 1) -
      1 / realNat(N + k + 2)] by linarith
    have xNonnegative := realMulValue.nonnegative with KNonnegative,
      gapNonnegative
    have stepM := step with N + k, mMember
    have previous : ℂ[u(N + k) - u(N)] ∈ ℂ by typecheck
    have increment : ℂ[u(N + k + 1) - u(N + k)] ∈ ℂ by typecheck
    have split : ℂ[u(N + k + 1) - u(N)] =
      ℂ[(u(N + k) - u(N)) + (u(N + k + 1) - u(N + k))] by ring
    rw split
    have triangle := complexAbs.triangle with previous, increment
    have uMSplit : u(N + k) = ℂ[(u(N + k) - u(N)) + u(N)] by ring
    have uMTriangle := complexAbs.triangle with previous, uN
    rw ← uMSplit at uMTriangle
    have uMNonnegative := complexAbs.nonnegative with uM
    have T : R[K * (1 / realNat(N + 1) - 1 / realNat(N + k + 1))] ∈ ℝ by
      typecheck
    have expT := realExp.positive at R[K * (1 / realNat(N + 1) -
      1 / realNat(N + k + 1))]
    have absN : complexAbs(u(N)) ∈ ℝ by typecheck
    have absM : complexAbs(u(N + k)) ∈ ℝ by typecheck
    have absPrevious : complexAbs(ℂ[u(N + k) - u(N)]) ∈ ℝ by typecheck
    have absIncrement : complexAbs(ℂ[u(N + k + 1) - u(N + k)]) ∈ ℝ by
      typecheck
    have expTReal : realExp(R[K * (1 / realNat(N + 1) -
      1 / realNat(N + k + 1))]) ∈ ℝ by typecheck
    have distribute : R[complexAbs(u(N)) * (realExp(R[K * (1 / realNat(N + 1) -
        1 / realNat(N + k + 1))]) - 1)] = R[complexAbs(u(N)) *
        realExp(R[K * (1 / realNat(N + 1) - 1 / realNat(N + k + 1))]) -
        complexAbs(u(N))] by ring
    rw distribute at ih
    have uMBound : complexAbs(u(N + k)) ≤ R[complexAbs(u(N)) *
        realExp(R[K * (1 / realNat(N + 1) - 1 / realNat(N + k + 1))])] by
      linarith
    have scaled := realLe.mul_right_of_nonnegative with uMBound, xNonnegative
    have onePlus := realExp.one_add_le at R[K * (1 / realNat(N + k + 1) -
      1 / realNat(N + k + 2))]
    have expTNonnegative : R[0] ≤ realExp(R[K * (1 / realNat(N + 1) -
      1 / realNat(N + k + 1))]) by linarith
    have grown := realLe.mul_left_of_nonnegative with onePlus, expTNonnegative
    have sum := realExp.add at R[K * (1 / realNat(N + 1) -
      1 / realNat(N + k + 1))], R[K * (1 / realNat(N + k + 1) -
      1 / realNat(N + k + 2))]
    have exponent : R[K * (1 / realNat(N + 1) - 1 / realNat(N + k + 1)) +
        K * (1 / realNat(N + k + 1) - 1 / realNat(N + k + 2))] =
      R[K * (1 / realNat(N + 1) - 1 / realNat(N + k + 2))] by ring
    rw exponent at sum
    rw ← sum at grown
    have grownScaled := realLe.mul_left_of_nonnegative with grown,
      uNNonnegative
    have xReal : R[K * (1 / realNat(N + k + 1) - 1 / realNat(N + k + 2))] ∈ ℝ
      by typecheck
    have expNext : realExp(R[K * (1 / realNat(N + 1) -
      1 / realNat(N + k + 2))]) ∈ ℝ by typecheck
    have d1 : R[complexAbs(u(N)) * (realExp(R[K * (1 / realNat(N + 1) -
        1 / realNat(N + k + 1))]) * (1 + K * (1 / realNat(N + k + 1) -
        1 / realNat(N + k + 2))))] = R[complexAbs(u(N)) *
        realExp(R[K * (1 / realNat(N + 1) - 1 / realNat(N + k + 1))]) +
        (complexAbs(u(N)) * realExp(R[K * (1 / realNat(N + 1) -
        1 / realNat(N + k + 1))])) * (K * (1 / realNat(N + k + 1) -
        1 / realNat(N + k + 2)))] by ring
    rw d1 at grownScaled
    have d2 : R[complexAbs(u(N)) * (realExp(R[K * (1 / realNat(N + 1) -
        1 / realNat(N + k + 2))]) - 1)] = R[complexAbs(u(N)) *
        realExp(R[K * (1 / realNat(N + 1) - 1 / realNat(N + k + 2))]) -
        complexAbs(u(N))] by ring
    rw d2
    linarith

theorem reciprocalGammaTerms.member (s : Set) (n : Nat)
  requires hs : s ∈ ℂ
  shows reciprocalGammaTerms(s)(n) ∈ ℂ
proof
  have nMember : n ∈ ℕ by typecheck
  exact FunctionBetween.apply_closed with
    (reciprocalGammaTerms.function with hs), nMember

-- The first term is s (s + 1).
theorem reciprocalGammaTerms.zero (s : Set)
  requires hs : s ∈ ℂ
  shows reciprocalGammaTerms(s)((0:N)) = ℂ[s * (s + 1)]
proof
  have zero : (0:N) ∈ ℕ by typecheck
  rw (reciprocalGammaTerms.value with hs, zero)
  have e1 : (0:N) + 1 = (1:N) by arith
  have fact := realNat.factorial_succ at (0:N)
  have fact0 : realNat((0:N)!) = R[1]
    rw factorial
    rw ← natural.one_succ
    exact realNat.one
  rw [fact, fact0, natural.two_succ, risingFactorial.succ,
    natural.one_succ, risingFactorial.succ, risingFactorial.zero,
    ← natural.one_succ, e1, (realCpow.nat_neg_one with hs), realNat.one]
  rw realNat.zero
  have collapse : R[(0 + 1) * 1] = R[1] by ring
  rw [collapse, realDiv.one_right, complexOfReal.one, complexOfReal.zero]
  ring

theorem gaussConstant.nonnegative (B : Real)
  requires nonnegative : R[0] ≤ B
  shows R[0] ≤ gaussConstant(B)
proof
  have expPositive := realExp.positive at B
  have BB := realMulValue.nonnegative with nonnegative, nonnegative
  have inner : R[0] ≤ R[1 + B + realExp(B)] by linarith
  have three := realMulValue.nonnegative with BB, inner
  have sum : R[0] ≤ R[2 * B * B + B + 2 * B * B * (1 + B + realExp(B))]
    have same : R[2 * B * B + B + 2 * B * B * (1 + B + realExp(B))] =
      R[2 * (B * B) + B + 2 * (B * B * (1 + B + realExp(B)))] by ring
    rw same
    linarith
  have expNonnegative : R[0] ≤ realExp(B) by linarith
  have product := realMulValue.nonnegative with expNonnegative, sum
  unfold gaussConstant
  exact product

-- |u(n + 1) − u(n)| ≤ |u(n)| K (1/(n + 1) − 1/(n + 2)) for Gauss's sequence.
theorem reciprocalGammaTerms.step_bound (s : Set) (B : Real) (n : Nat)
  requires hs : s ∈ ℂ
  requires sBound : complexAbs(s) ≤ B
  shows complexAbs(ℂ[reciprocalGammaTerms(s)(n + 1) -
      reciprocalGammaTerms(s)(n)]) ≤ R[complexAbs(reciprocalGammaTerms(s)(n)) *
      (gaussConstant(B) * (1 / realNat(n + 1) - 1 / realNat(n + 2)))]
proof
  have term := reciprocalGammaTerms.member at s, n with hs
  have factor : gaussFactor(s, n) ∈ ℂ
    unfold gaussFactor
    typecheck
  have shape : ℂ[reciprocalGammaTerms(s)(n) * gaussFactor(s, n) -
      reciprocalGammaTerms(s)(n)] =
      ℂ[reciprocalGammaTerms(s)(n) * (gaussFactor(s, n) - 1)] by ring
  have difference : ℂ[gaussFactor(s, n) - 1] ∈ ℂ by typecheck
  rw [(reciprocalGammaTerms.step with hs), shape,
    (complexAbs.mul with term, difference)]
  have close := gaussFactor.close at s, B, n with hs, sBound
  have nonnegative := complexAbs.nonnegative with term
  exact realLe.mul_left_of_nonnegative with close, nonnegative

-- |u(n)| ≤ B (B + 1) e^K for |s| ≤ B.
theorem reciprocalGammaTerms.bound (s : Set) (B : Real) (n : Nat)
  requires hs : s ∈ ℂ
  requires sBound : complexAbs(s) ≤ B
  shows complexAbs(reciprocalGammaTerms(s)(n)) ≤
    R[B * (B + 1) * realExp(gaussConstant(B))]
proof
  have sNonnegative := complexAbs.nonnegative with hs
  have BNonnegative : R[0] ≤ B by linarith
  have KNonnegative := gaussConstant.nonnegative with BNonnegative
  have values : ∀ m ∈ ℕ, reciprocalGammaTerms(s)(m) ∈ ℂ
    intros m hm
    have mNat := nat.omega.backward at m with hm
    exact reciprocalGammaTerms.member at s, m with hs
  have step : ∀ m ∈ ℕ, complexAbs(ℂ[reciprocalGammaTerms(s)(m + 1) -
      reciprocalGammaTerms(s)(m)]) ≤ R[complexAbs(reciprocalGammaTerms(s)(m)) *
      (gaussConstant(B) * (1 / realNat(m + 1) - 1 / realNat(m + 2)))]
    intros m hm
    have mNat := nat.omega.backward at m with hm
    exact reciprocalGammaTerms.step_bound at s, B, m with hs, sBound
  have spread := gaussSequence.propagate at reciprocalGammaTerms(s),
    gaussConstant(B), 0, n with values, KNonnegative, step
  have e0 : (0:N) + n = n by arith
  have e1 : (0:N) + 1 = (1:N) by arith
  rw [e0, e1, realNat.one] at spread
  -- The exponent is at most K.
  obtain ⟨cPositive, _, _, _, _⟩ := gaussGap.facts at n
  have hPositive : R[0] < R[1 / realNat(n + 1)]
    obtain ⟨_, ch, _, _, _⟩ := gaussGap.facts at n
    linarith
  rw realDiv.one_right at spread
  have exponent : R[gaussConstant(B) * (1 - 1 / realNat(n + 1))] ≤
      gaussConstant(B)
    have hNonnegative : R[0] ≤ R[1 / realNat(n + 1)] by linarith
    have product := realMulValue.nonnegative with KNonnegative, hNonnegative
    have same : R[gaussConstant(B) * (1 - 1 / realNat(n + 1))] =
      R[gaussConstant(B) - gaussConstant(B) * (1 / realNat(n + 1))] by ring
    rw same
    linarith
  have expMonotone := (realExp.le_iff at R[gaussConstant(B) *
    (1 - 1 / realNat(n + 1))], gaussConstant(B)).backward with exponent
  have zero := reciprocalGammaTerms.member at s, (0:N) with hs
  have zeroNonnegative := complexAbs.nonnegative with zero
  have widened := realLe.mul_left_of_nonnegative with expMonotone,
    zeroNonnegative
  have term := reciprocalGammaTerms.member at s, n with hs
  have differenceMember : ℂ[reciprocalGammaTerms(s)(n) -
    reciprocalGammaTerms(s)((0:N))] ∈ ℂ by typecheck
  have split : reciprocalGammaTerms(s)(n) = ℂ[(reciprocalGammaTerms(s)(n) -
    reciprocalGammaTerms(s)((0:N))) + reciprocalGammaTerms(s)((0:N))] by ring
  have triangle := complexAbs.triangle with differenceMember, zero
  rw ← split at triangle
  -- |u(0)| = |s| |s + 1| ≤ B (B + 1).
  have oneMember := complexOne.member
  have shifted : ℂ[s + 1] ∈ ℂ by typecheck
  have shiftedBound := complexAbs.triangle with hs, oneMember
  rw complexAbs.one at shiftedBound
  have shiftedUpper : complexAbs(ℂ[s + 1]) ≤ R[B + 1] by linarith
  have shiftedNonnegative := complexAbs.nonnegative with shifted
  have zeroBound := gammaReal.mul_le with sNonnegative, sBound,
    shiftedNonnegative, shiftedUpper
  rw [← (complexAbs.mul with hs, shifted), ← (reciprocalGammaTerms.zero with hs)]
    at zeroBound
  have expK := realExp.positive at gaussConstant(B)
  have expKNonnegative : R[0] ≤ realExp(gaussConstant(B)) by linarith
  have scaled := realLe.mul_right_of_nonnegative with zeroBound,
    expKNonnegative
  have absZero : complexAbs(reciprocalGammaTerms(s)((0:N))) ∈ ℝ by typecheck
  have expT : realExp(R[gaussConstant(B) * (1 - 1 / realNat(n + 1))]) ∈ ℝ by
    typecheck
  have distribute : R[complexAbs(reciprocalGammaTerms(s)((0:N))) *
      (realExp(R[gaussConstant(B) * (1 - 1 / realNat(n + 1))]) - 1)] =
      R[complexAbs(reciprocalGammaTerms(s)((0:N))) *
      realExp(R[gaussConstant(B) * (1 - 1 / realNat(n + 1))]) -
      complexAbs(reciprocalGammaTerms(s)((0:N)))] by ring
  rw distribute at spread
  linarith

-- The terms of Gauss's sequence as functions of s, and their successive
-- differences.
defgraph gaussMap (n : Nat) (z ∈ complexCarrier) : complexCarrier :=
    reciprocalGammaTerms(z)(n)
proof
  exact reciprocalGammaTerms.member at z, n with member

defgraph gaussDifference (n : Nat) (z ∈ complexCarrier) : complexCarrier :=
    ℂ[reciprocalGammaTerms(z)(n + 1) - reciprocalGammaTerms(z)(n)]
proof
  have next := reciprocalGammaTerms.member at z, n + 1 with member
  have this := reciprocalGammaTerms.member at z, n with member
  typecheck

defgraph gaussDifferences (n ∈ ℕ) : 𝒫(complexCarrier × complexCarrier) :=
    gaussDifference(n)
proof
  have nNat := nat.omega.backward with member
  obtain ⟨relation, _⟩ := gaussDifference.function at n
  exact powerset.membership_iff.backward with relation

theorem gaussMap.holomorphic (n : Nat)
  shows HolomorphicOn(gaussMap(n), complexCarrier)
proof
  have isOpen := ComplexOpen.whole
  have inside := ComplexOpen.subset with isOpen
  have zero : ℂ[0] ∈ ℂ by typecheck
  have minusOne : ℂ[-1] ∈ ℂ by typecheck
  have power := affinePower.holomorphic at realNat(n + 1), ℂ[0], ℂ[-1],
    complexCarrier with zero, minusOne, isOpen, inside
  have rising := risingMap.holomorphic at n + 2, complexCarrier with isOpen
  have scale := complexOfReal.mem at R[1 / factorial(n + 1)]
  have constant := HolomorphicOn.const with isOpen, scale
  have product := HolomorphicOn.mul with power, rising
  obtain ⟨_, valuesPower, _⟩ := power
  obtain ⟨_, valuesRising, _⟩ := rising
  obtain ⟨_, valuesConstant, _⟩ := constant
  apply HolomorphicOn.mul_formula with product, constant
  intros z hz
  have nMember : n ∈ ℕ by typecheck
  have exponent : ℂ[0 + -1 * z] = ℂ[-z] by ring
  rw [(gaussMap.value with hz), (reciprocalGammaTerms.value with hz, nMember),
    (complexFunctionMul.value with valuesPower, valuesRising, hz),
    (affinePower.value with zero, minusOne, hz), (risingMap.value with hz),
    (complexFunctionConst.value with scale, hz), exponent]

theorem gaussDifference.holomorphic (n : Nat)
  shows HolomorphicOn(gaussDifference(n), complexCarrier)
proof
  have next := gaussMap.holomorphic at n + 1
  have this := gaussMap.holomorphic at n
  have negated := HolomorphicOn.neg with this
  obtain ⟨_, valuesThis, _⟩ := this
  apply HolomorphicOn.add_formula with next, negated
  intros z hz
  rw [(gaussDifference.value with hz),
    (complexFunctionNeg.value with valuesThis, hz), (gaussMap.value with hz),
    (gaussMap.value with hz)]
  have first := reciprocalGammaTerms.member at z, n + 1 with hz
  have second := reciprocalGammaTerms.member at z, n with hz
  ring

-- 1/(n + 1) − 1/(n + 2) is at most the n-th triangular reciprocal
-- 2/((n + 1)(n + 2)).
theorem gaussGap.le_triangular (n : Nat)
  shows R[1 / realNat(n + 1) - 1 / realNat(n + 2)] ≤
    (triangularReciprocals(n):R)
proof
  have nMember : n ∈ ℕ by typecheck
  obtain ⟨cPositive, ch, _, _, product⟩ := gaussGap.facts at n
  have successor : realNat(n + 1) = R[realNat(n) + 1]
    rw [realNat.add, realNat.one]
  have zeroLe := realNat.zero_le at n
  have aNonzero : R[realNat(n) + 1] ≠ R[0] by linarith
  have bNonzero : R[realNat(n) + 2] ≠ R[0] by linarith
  have triangular : (triangularReciprocals(n):R) =
      R[2 * ((1 / realNat(n + 1)) * (1 / realNat(n + 2)))]
    rw [(triangularReciprocals.value with nMember), successor, realNat.add_two,
      realDiv.eq_mul_inv, realDiv.eq_mul_inv, realDiv.eq_mul_inv,
      (realInvValue.mul with aNonzero, bNonzero)]
    ring
  rw [triangular, product]
  linarith

-- On a compact set the differences are dominated by a summable sequence.
theorem gaussDifferences.dominated (K : Set)
  requires inside : K ⊆ ℂ
  requires compact : ComplexCompact(K)
  shows ∃ M, Summable(M) ∧
    (∀ n ∈ ℕ, ∀ z ∈ K, complexAbs(gaussDifferences(n)(z)) ≤ M(n))
proof
  have isOpen := ComplexOpen.whole
  have whole := Subset.reflexive at complexCarrier
  have identity := HolomorphicOn.id with isOpen
  have continuous := HolomorphicOn.continuous with identity
  have continuousK := ComplexContinuousOn.mono with continuous, inside
  obtain ⟨B0, hB0, bound⟩ := ComplexContinuousOn.abs_bounded with
    continuousK, compact
  have absB0 := abs.upper at B0
  have BNonnegative := abs.nonnegative at B0
  have zBound : ∀ z ∈ K, complexAbs(z) ≤ abs(B0)
    intros z hz
    have zMember := inside with z, hz
    have value := bound with z, hz
    rw (complexFunctionId.value with whole, zMember) at value
    linarith
  have KNonnegative := gaussConstant.nonnegative with BNonnegative
  have expPositive := realExp.positive at gaussConstant(abs(B0))
  have BB : R[0] ≤ R[abs(B0) * (abs(B0) + 1)]
    have shifted : R[0] ≤ R[abs(B0) + 1] by linarith
    exact realMulValue.nonnegative with BNonnegative, shifted
  have expNonnegative : R[0] ≤ realExp(gaussConstant(abs(B0))) by linarith
  have BBE := realMulValue.nonnegative with BB, expNonnegative
  have CNonnegative := realMulValue.nonnegative with BBE, KNonnegative
  have CReal : R[abs(B0) * (abs(B0) + 1) * realExp(gaussConstant(abs(B0))) *
    gaussConstant(abs(B0))] ∈ ℝ by typecheck
  have triangularSummable := SumsTo.summable with
    triangularReciprocals.sums_to
  have summable := Summable.scale at triangularReciprocals,
    R[abs(B0) * (abs(B0) + 1) * realExp(gaussConstant(abs(B0))) *
    gaussConstant(abs(B0))] with triangularSummable
  refine ⟨mulSequence(constantSequence(R[abs(B0) * (abs(B0) + 1) *
    realExp(gaussConstant(abs(B0))) * gaussConstant(abs(B0))]),
    triangularReciprocals), summable, ?_⟩
  intros n hn z hz
  have nNat := nat.omega.backward at n with hn
  have zMember := inside with z, hz
  have constantSeq := constantSequence.sequence at R[abs(B0) * (abs(B0) + 1) *
    realExp(gaussConstant(abs(B0))) * gaussConstant(abs(B0))]
  have triangularSeq := triangularReciprocals.sequence
  have constantValue := constantSequence.value at R[abs(B0) * (abs(B0) + 1) *
    realExp(gaussConstant(abs(B0))) * gaussConstant(abs(B0))], n
  have triangularReal : Real(triangularReciprocals(n)) by typecheck
  rw [(gaussDifferences.value with hn), (gaussDifference.value with zMember),
    (mulSequence.value at constantSequence(R[abs(B0) * (abs(B0) + 1) *
      realExp(gaussConstant(abs(B0))) * gaussConstant(abs(B0))]),
      triangularReciprocals, n with constantSeq, triangularSeq), constantValue]
  have zB := zBound with z, hz
  have step := reciprocalGammaTerms.step_bound at z, abs(B0), n with zMember, zB
  have termBound := reciprocalGammaTerms.bound at z, abs(B0), n with zMember, zB
  obtain ⟨_, ch, _, _, _⟩ := gaussGap.facts at n
  have gapNonnegative : R[0] ≤ R[1 / realNat(n + 1) - 1 / realNat(n + 2)] by
    linarith
  have xNonnegative := realMulValue.nonnegative with KNonnegative,
    gapNonnegative
  have scaled := realLe.mul_right_of_nonnegative with termBound, xNonnegative
  have triangular := gaussGap.le_triangular at n
  have widened := realLe.mul_left_of_nonnegative with triangular, CNonnegative
  have regroup : R[(abs(B0) * (abs(B0) + 1) * realExp(gaussConstant(abs(B0))))
      * (gaussConstant(abs(B0)) * (1 / realNat(n + 1) - 1 / realNat(n + 2)))] =
      R[(abs(B0) * (abs(B0) + 1) * realExp(gaussConstant(abs(B0))) *
      gaussConstant(abs(B0))) * (1 / realNat(n + 1) - 1 / realNat(n + 2))] by
    ring
  rw regroup at scaled
  linarith

-- The series of differences converges, locally uniformly, to a function
-- holomorphic on ℂ.
theorem gaussDifferences.series
  shows (∀ z ∈ ℂ, ComplexSummable(complexValueSequence(gaussDifferences, z)))
    ∧ HolomorphicOn(complexFunctionSeries(gaussDifferences, complexCarrier),
      complexCarrier)
proof
  have holomorphic : ∀ n ∈ ℕ, HolomorphicOn(gaussDifferences(n), complexCarrier)
    intros n hn
    have nNat := nat.omega.backward at n with hn
    rw (gaussDifferences.value with hn)
    exact gaussDifference.holomorphic at n
  have dominated : ∀ K, K ⊆ ℂ → ComplexCompact(K) →
      (∃ M, Summable(M) ∧
        (∀ n ∈ ℕ, ∀ z ∈ K, complexAbs(gaussDifferences(n)(z)) ≤ M(n)))
    intros K inside compact
    exact gaussDifferences.dominated with inside, compact
  exact HolomorphicOn.series with holomorphic, dominated

-- The partial sums of the differences telescope.
theorem gaussDifferences.partial (z : Set) (n : Nat)
  requires hz : z ∈ ℂ
  shows complexPartialSum(complexValueSequence(gaussDifferences, z), n) =
    ℂ[reciprocalGammaTerms(z)(n) - reciprocalGammaTerms(z)((0:N))]
proof
  induction n
  | zero =>
    have zero := reciprocalGammaTerms.member at z, (0:N) with hz
    rw complexPartialSum.zero
    ring
  | succ(k) using ih =>
    have values : ∀ m ∈ ℕ, gaussDifferences(m)(z) ∈ ℂ
      intros m hm
      have mNat := nat.omega.backward at m with hm
      rw [(gaussDifferences.value with hm), (gaussDifference.value with hz)]
      have next := reciprocalGammaTerms.member at z, m + 1 with hz
      have this := reciprocalGammaTerms.member at z, m with hz
      typecheck
    have zero := reciprocalGammaTerms.member at z, (0:N) with hz
    have kMember : k ∈ ℕ by typecheck
    have e1 := add.right_one at k
    rw [complexPartialSum.succ, ih, (complexValueSequence.value with values,
      kMember), (gaussDifferences.value with kMember),
      (gaussDifference.value with hz), e1]
    have next := reciprocalGammaTerms.member at z, succ(k) with hz
    have this := reciprocalGammaTerms.member at z, k with hz
    ring

-- Gauss's sequence converges to u(0) + Σ (u(n + 1) − u(n)).
theorem reciprocalGammaTerms.converges (s : Set)
  requires hs : s ∈ ℂ
  shows ComplexConvergesTo(reciprocalGammaTerms(s),
    ℂ[reciprocalGammaTerms(s)((0:N)) +
      complexFunctionSeries(gaussDifferences, complexCarrier)(s)])
proof
  obtain ⟨summable, _⟩ := gaussDifferences.series
  have summableS := summable with s, hs
  have values : ∀ m ∈ ℕ, gaussDifferences(m)(s) ∈ ℂ
    intros m hm
    have mNat := nat.omega.backward at m with hm
    rw [(gaussDifferences.value with hm), (gaussDifference.value with hs)]
    have next := reciprocalGammaTerms.member at s, m + 1 with hs
    have this := reciprocalGammaTerms.member at s, m with hs
    typecheck
  have sequenceV := complexValueSequence.function with values
  rw (complexFunctionSeries.value with summable, hs)
  obtain ⟨sumMember, sums⟩ := complexSeriesSum.selected with summableS
  have close := (ComplexSumsTo.iff_partial with sequenceV, sumMember).forward
    with sums
  have zero := reciprocalGammaTerms.member at s, (0:N) with hs
  have limitMember : ℂ[reciprocalGammaTerms(s)((0:N)) +
    complexSeriesSum(complexValueSequence(gaussDifferences, s))] ∈ ℂ by
    typecheck
  have sequence : ComplexSequence(reciprocalGammaTerms(s)) by
    exact reciprocalGammaTerms.function with hs
  apply (ComplexConvergesTo.iff_abs with sequence, limitMember).backward
  intros e he ePositive
  obtain ⟨N, hN, after⟩ := close with e, he, ePositive
  refine ⟨N, hN, ?_⟩
  intros n hn le
  have nNat := nat.omega.backward at n with hn
  have near := after with n, hn, le
  rw (gaussDifferences.partial at s, n with hs) at near
  have term := reciprocalGammaTerms.member at s, n with hs
  have same : ℂ[(reciprocalGammaTerms(s)(n) - reciprocalGammaTerms(s)((0:N))) -
      complexSeriesSum(complexValueSequence(gaussDifferences, s))] =
      ℂ[reciprocalGammaTerms(s)(n) - (reciprocalGammaTerms(s)((0:N)) +
      complexSeriesSum(complexValueSequence(gaussDifferences, s)))] by ring
  rw same at near
  exact near

-- Section: Zeros of Gauss's sequence
theorem gammaComplex.mul_nonzero (x y : Set)
  requires hx : x ∈ ℂ
  requires hy : y ∈ ℂ
  requires nonzeroX : x ≠ ℂ[0]
  requires nonzeroY : y ≠ ℂ[0]
  shows ℂ[x * y] ≠ ℂ[0]
proof
  intro zero
  have px := complexAbs.positive with hx, nonzeroX
  have py := complexAbs.positive with hy, nonzeroY
  have product := realMulValue.positive with px, py
  rw [← (complexAbs.mul with hx, hy), zero, complexAbs.zero] at product
  linarith

theorem gammaComplex.one_nonzero
  shows ℂ[1] ≠ ℂ[0]
proof
  intro same
  have one := complexAbs.one
  rw [same, complexAbs.zero] at one
  have positive : R[0] < R[1] by linarith
  linarith

-- Off the poles the rising factorials do not vanish.
theorem risingFactorial.nonzero (s : Set) (j : Nat)
  requires hs : s ∈ ℂ
  requires notPole : ¬(s ∈ gammaPoles)
  shows risingFactorial(s, j) ≠ ℂ[0]
proof
  induction j
  | zero =>
    rw risingFactorial.zero
    exact gammaComplex.one_nonzero
  | succ(k) using ih =>
    rw risingFactorial.succ
    have rising := risingFactorial.member at s, k with hs
    have cast : complexOfReal(realNat(k)) ∈ ℂ by typecheck
    have shifted : ℂ[s + complexOfReal(realNat(k))] ∈ ℂ by typecheck
    have shiftedNonzero : ℂ[s + complexOfReal(realNat(k))] ≠ ℂ[0]
      intro zero
      apply notPole
      have kMember : k ∈ ℕ by typecheck
      apply gammaPoles.membership.backward
      refine ⟨hs, k, kMember, ?_⟩
      have same : s = ℂ[(s + complexOfReal(realNat(k))) -
        complexOfReal(realNat(k))] by ring
      rw [same, zero]
      ring
    exact gammaComplex.mul_nonzero with rising, shifted, ih, shiftedNonzero

theorem reciprocalGammaTerms.nonzero (s : Set) (n : Nat)
  requires hs : s ∈ ℂ
  requires notPole : ¬(s ∈ gammaPoles)
  shows reciprocalGammaTerms(s)(n) ≠ ℂ[0]
proof
  have nMember : n ∈ ℕ by typecheck
  rw (reciprocalGammaTerms.value with hs, nMember)
  have negative : ℂ[-s] ∈ ℂ by typecheck
  have power := realCpow.member at realNat(n + 1), ℂ[-s] with negative
  have powerNonzero := realCpow.nonzero at realNat(n + 1), ℂ[-s] with negative
  have rising := risingFactorial.member at s, n + 2 with hs
  have risingNonzero := risingFactorial.nonzero at s, n + 2 with hs, notPole
  have factorialPositive := realNat.factorial_pos at n + 1
  have coefficientPositive : R[0] < R[1 / realNat((n + 1)!)]
    rw realDiv.eq_mul_inv
    have inverse := realInvValue.positive with factorialPositive
    have same : R[1 * realInvValue(realNat((n + 1)!))] =
      realInvValue(realNat((n + 1)!)) by ring
    rw same
    exact inverse
  have coefficient : complexOfReal(R[1 / realNat((n + 1)!)]) ∈ ℂ by typecheck
  have coefficientNonzero : complexOfReal(R[1 / realNat((n + 1)!)]) ≠ ℂ[0]
    intro zero
    have absolute := complexAbs.of_real at R[1 / realNat((n + 1)!)]
    rw [zero, complexAbs.zero] at absolute
    have upper := abs.upper at R[1 / realNat((n + 1)!)]
    linarith
  have first := gammaComplex.mul_nonzero with power, rising, powerNonzero,
    risingNonzero
  have product : ℂ[realCpow(realNat(n + 1), ℂ[-s]) * risingFactorial(s, n + 2)]
    ∈ ℂ by typecheck
  exact gammaComplex.mul_nonzero with product, coefficient, first,
    coefficientNonzero

-- Section: The functional equation of Gauss's sequence
-- C/(n + 1) is eventually below any e > 0.
theorem gammaReal.eventually_small (C e : Real)
  requires nonnegative : R[0] ≤ C
  requires positive : R[0] < e
  shows ∃ N ∈ ℕ, ∀ n ∈ ℕ, N ≤ n → R[C * (1 / realNat(n + 1))] < e
proof
  have eNonzero : e ≠ R[0] by linarith
  have inverse := realInvValue.positive with positive
  have cancelE := realInvValue.mul_right with eNonzero
  obtain ⟨N, NNat, big⟩ := Real.below_natural at R[C * realInvValue(e)]
  have NMember : N ∈ ℕ by typecheck
  refine ⟨N, NMember, ?_⟩
  intros n hn le
  have nNat := nat.omega.backward at n with hn
  have monotone := realNat.monotone with le
  have successor : realNat(n + 1) = R[realNat(n) + 1]
    rw [realNat.add, realNat.one]
  have zeroLe := realNat.zero_le at n
  have mPositive : R[0] < realNat(n + 1) by linarith
  have mNonzero : realNat(n + 1) ≠ R[0] by linarith
  have cancelM := realDiv.mul_left at R[1], realNat(n + 1) with mNonzero
  obtain ⟨hPositive, ch, _, _, _⟩ := gaussGap.facts at n
  have hPos : R[0] < R[1 / realNat(n + 1)] by linarith
  have below : R[C * realInvValue(e)] < realNat(n + 1) by linarith
  have scaledE := realLess.mul_right_of_positive with below, positive
  have collapse : R[(C * realInvValue(e)) * e] = C
    have regroup : R[(C * realInvValue(e)) * e] =
      R[C * (e * realInvValue(e))] by ring
    rw [regroup, cancelE]
    ring
  rw collapse at scaledE
  have scaledH := realLess.mul_right_of_positive with scaledE, hPos
  have collapse2 : R[(realNat(n + 1) * e) * (1 / realNat(n + 1))] = e
    have regroup : R[(realNat(n + 1) * e) * (1 / realNat(n + 1))] =
      R[e * (realNat(n + 1) * (1 / realNat(n + 1)))] by ring
    rw [regroup, cancelM]
    ring
  rw collapse2 at scaledH
  exact scaledH

-- (s)_(j + 1) = s (s + 1)_j.
theorem risingFactorial.shift (s : Set) (j : Nat)
  requires hs : s ∈ ℂ
  shows risingFactorial(s, succ(j)) = ℂ[s * risingFactorial(ℂ[s + 1], j)]
proof
  have shifted : ℂ[s + 1] ∈ ℂ by typecheck
  induction j
  | zero =>
    rw [risingFactorial.succ, risingFactorial.zero, risingFactorial.zero,
      realNat.zero, complexOfReal.zero]
    ring
  | succ(k) using ih =>
    have cast : complexOfReal(realNat(k)) ∈ ℂ by typecheck
    have rising := risingFactorial.member at ℂ[s + 1], k with shifted
    have e1 := add.right_one at k
    rw [risingFactorial.succ, ih, (risingFactorial.succ at ℂ[s + 1], k), ← e1,
      realNat.add, realNat.one, complexOfReal.add, complexOfReal.one]
    ring

-- s u_(s+1)(n) = u_s(n) (1 + (s + 1)/(n + 1)).
theorem reciprocalGammaTerms.shift (s : Set) (n : Nat)
  requires hs : s ∈ ℂ
  shows ℂ[s * reciprocalGammaTerms(ℂ[s + 1])(n)] =
    ℂ[reciprocalGammaTerms(s)(n) + reciprocalGammaTerms(s)(n) *
      ((s + 1) * complexOfReal(R[1 / realNat(n + 1)]))]
proof
  have nMember : n ∈ ℕ by typecheck
  have shifted : ℂ[s + 1] ∈ ℂ by typecheck
  rw [(reciprocalGammaTerms.value with shifted, nMember),
    (reciprocalGammaTerms.value with hs, nMember)]
  have argument : ℂ[-(s + 1)] = ℂ[-s + -1] by ring
  have negative : ℂ[-s] ∈ ℂ by typecheck
  have minusOne : ℂ[-1] ∈ ℂ by typecheck
  have atLeast : (1:N) ≤ n + 1 by arith
  have power := realCpow.nat_neg_nat at 1, n + 1 with atLeast
  rw [realNat.one, complexOfReal.one] at power
  have pow1 : R[realNat(n + 1) ^ 1] = realNat(n + 1) by ring
  rw pow1 at power
  rw [argument, (realCpow.add at realNat(n + 1), ℂ[-s], ℂ[-1] with negative,
    minusOne), power]
  have shiftRising := risingFactorial.shift at s, n + 2 with hs
  rw risingFactorial.succ at shiftRising
  have successor : realNat(n + 2) = R[realNat(n + 1) + 1]
    rw [realNat.add_two, realNat.add, realNat.one]
    ring
  have zeroLe := realNat.zero_le at n
  have mSuccessor : realNat(n + 1) = R[realNat(n) + 1]
    rw [realNat.add, realNat.one]
  have mNonzero : realNat(n + 1) ≠ R[0] by linarith
  have cancelM := realDiv.mul_left at R[1], realNat(n + 1) with mNonzero
  have scaleFact : ℂ[complexOfReal(realNat(n + 2)) *
      complexOfReal(R[1 / realNat(n + 1)])] =
      ℂ[1 + complexOfReal(R[1 / realNat(n + 1)])]
    rw [← complexOfReal.mul, successor]
    have realFact : R[(realNat(n + 1) + 1) * (1 / realNat(n + 1))] =
        R[1 + 1 / realNat(n + 1)]
      have expand : R[(realNat(n + 1) + 1) * (1 / realNat(n + 1))] =
        R[realNat(n + 1) * (1 / realNat(n + 1)) + 1 / realNat(n + 1)] by ring
      rw [expand, cancelM]
    rw [realFact, complexOfReal.add, complexOfReal.one]
  have P : realCpow(realNat(n + 1), ℂ[-s]) ∈ ℂ by
    exact realCpow.member at realNat(n + 1), ℂ[-s] with negative
  have Q : complexOfReal(R[1 / realNat(n + 1)]) ∈ ℂ by typecheck
  have R1 := risingFactorial.member at ℂ[s + 1], n + 2 with shifted
  have R0 := risingFactorial.member at s, n + 2 with hs
  have c : complexOfReal(R[1 / realNat((n + 1)!)]) ∈ ℂ by typecheck
  have N2 : complexOfReal(realNat(n + 2)) ∈ ℂ by typecheck
  linear_combination (realCpow(realNat(n + 1), ℂ[-s]) * risingFactorial(s, n + 2) *
    complexOfReal(R[1 / realNat((n + 1)!)])) * scaleFact -
    (realCpow(realNat(n + 1), ℂ[-s]) *
    complexOfReal(R[1 / realNat(n + 1)]) *
    complexOfReal(R[1 / realNat((n + 1)!)])) * shiftRising

-- Section: Wallis's integrals
-- The functions x ↦ sinⁿ x, as pointwise products.
def sinPow (n : Nat) → Set
  | zero => constantRealFunction(realOne)
  | succ(k) => pointwiseMul(realSin, sinPow(k))

theorem sinPow.zero
  shows sinPow(0) = constantRealFunction(R[1])
proof
  rw sinPow
  rfl

theorem sinPow.succ (n : Nat)
  shows sinPow(succ(n)) = pointwiseMul(realSin, sinPow(n))
proof
  rw sinPow
  rfl

theorem sinPow.function (n : Nat)
  shows sinPow(n) : ℝ → ℝ
proof
  induction n
  | zero =>
    rw sinPow.zero
    exact constantRealFunction.function at R[1]
  | succ(k) using ih =>
    rw sinPow.succ
    exact pointwiseMul.function with realSin.function, ih

theorem sinPow.continuous (n : Nat)
  shows Continuous(sinPow(n))
proof
  induction n
  | zero =>
    rw sinPow.zero
    exact constantRealFunction.continuous at R[1]
  | succ(k) using ih =>
    rw sinPow.succ
    exact Continuous.mul with realSin.continuous, ih

theorem sinPow.real (n : Nat) (X : Real)
  shows sinPow(n)(X) ∈ ℝ
proof
  have xMember : X ∈ ℝ by typecheck
  exact FunctionBetween.apply_closed with (sinPow.function at n), xMember

theorem sinPow.value_zero (X : Real)
  shows sinPow(0)(X) = R[1]
proof
  rw [sinPow.zero, constantRealFunction.value]

theorem sinPow.value_succ (n : Nat) (X : Real)
  shows sinPow(succ(n))(X) = R[realSin(X) * sinPow(n)(X)]
proof
  have function := sinPow.function at n
  have value := sinPow.real at n, X
  have sinReal : realSin(X) ∈ ℝ by typecheck
  rw [sinPow.succ, (pointwiseMul.value with realSin.function, function)]

-- (sin^(n+1))' = (n + 1) cos · sinⁿ.
theorem sinPow.derivative (n : Nat) (X : Real)
  shows HasDerivativeAt(sinPow(succ(n)),
    R[(realNat(n) + 1) * realCos(X) * sinPow(n)(X)], X)
proof
  have sinReal : realSin(X) ∈ ℝ by typecheck
  have cosReal : realCos(X) ∈ ℝ by typecheck
  induction n
  | zero =>
    rw sinPow.succ
    have constant := constantRealFunction.has_derivative_at at R[1], X
    have zeroFunction := sinPow.function at 0
    rw ← sinPow.zero at constant
    have value := sinPow.real at 0, X
    have product := HasDerivativeAt.mul_value with (realSin.derivative at X),
      constant
    apply HasDerivativeAt.congr_value with product
    rw [sinPow.value_zero, realNat.zero]
    ring
  | succ(k) using ih =>
    have value := sinPow.real at succ(k), X
    have previous := sinPow.real at k, X
    rw sinPow.succ at succ(k)
    have product := HasDerivativeAt.mul_value with (realSin.derivative at X), ih
    apply HasDerivativeAt.congr_value with product
    have e1 := add.right_one at k
    rw [sinPow.value_succ, ← e1, realNat.add, realNat.one]
    ring

-- Iₙ = ∫₀^(π/2) sinⁿ x dx.
def wallisIntegral (n : Nat) : Real :=
  riemannIntegral(sinPow(n), R[0], realHalfPi)
proof
  unfold wallisIntegral
  typecheck

theorem sinPow.continuous_on (n : Nat)
  shows ContinuousOn(sinPow(n), closedInterval(R[0], realHalfPi))
proof
  exact Continuous.continuous_on with (sinPow.continuous at n),
    (closedInterval.subset_reals at R[0], realHalfPi)

theorem wallisIntegral.has_integral (n : Nat)
  shows HasRiemannIntegral(sinPow(n), R[0], realHalfPi, wallisIntegral(n))
proof
  have positive := realHalfPi.positive
  have ordered : R[0] ≤ realHalfPi by linarith
  unfold wallisIntegral
  exact riemannIntegral.continuous with ordered, (sinPow.continuous_on at n)

theorem wallisIntegral.zero
  shows wallisIntegral(0) = realHalfPi
proof
  have positive := realHalfPi.positive
  have ordered : R[0] ≤ realHalfPi by linarith
  unfold wallisIntegral
  rw [sinPow.zero, (riemannIntegral.constant with ordered)]
  ring

theorem wallisIntegral.one
  shows wallisIntegral(1) = R[1]
proof
  have positive := realHalfPi.positive
  have ordered : R[0] ≤ realHalfPi by linarith
  have negCos := pointwiseNeg.function with realCos.function
  have continuousF := Continuous.continuous_on with
    (Continuous.neg with realCos.continuous),
    (closedInterval.subset_reals at R[0], realHalfPi)
  have derivative : ∀ X ∈ ℝ, R[0] < X → X < realHalfPi →
      HasDerivativeAt(pointwiseNeg(realCos), sinPow(1)(X), X)
    intros X hX lower upper
    have typedX : Real(X) by exact hX
    have negated := HasDerivativeAt.neg with (realCos.derivative at X)
    apply HasDerivativeAt.congr_value with negated
    rw [natural.one_succ, sinPow.value_succ, sinPow.value_zero]
    have sinReal : realSin(X) ∈ ℝ by typecheck
    ring
  unfold wallisIntegral
  rw [(riemannIntegral.of_continuous_derivative with ordered,
    (sinPow.function at 1), continuousF, derivative,
    (sinPow.continuous_on at 1))]
  have halfReal : realHalfPi ∈ ℝ by typecheck
  have zeroReal : R[0] ∈ ℝ by typecheck
  have cosHalf : realCos(realHalfPi) ∈ ℝ by typecheck
  have cosZero : realCos(R[0]) ∈ ℝ by typecheck
  rw [(pointwiseNeg.value at realCos, realHalfPi with realCos.function),
    (pointwiseNeg.value at realCos, R[0] with realCos.function),
    realHalfPi.cos, realCos.zero]
  ring

-- On [0, π/2], 0 ≤ sin^(n+1) ≤ sinⁿ.
theorem sinPow.nonnegative (n : Nat) (X : Real)
  requires lower : R[0] ≤ X
  requires upper : X ≤ realHalfPi
  shows R[0] ≤ sinPow(n)(X)
proof
  induction n
  | zero =>
    rw sinPow.value_zero
    linarith
  | succ(k) using ih =>
    have halfPositive := realHalfPi.positive
    have belowPi : X ≤ realPi
      unfold realPi
      linarith
    have sinNonnegative := realSin.nonnegative_upto_pi with lower, belowPi
    rw sinPow.value_succ
    exact realMulValue.nonnegative with sinNonnegative, ih

theorem sinPow.bounds (n : Nat) (X : Real)
  requires lower : R[0] ≤ X
  requires upper : X ≤ realHalfPi
  shows R[0] ≤ sinPow(n)(X) ∧ sinPow(succ(n))(X) ≤ sinPow(n)(X)
proof
  have sinAbs := realSin.abs_le_one at X
  have sinUpper := abs.upper at realSin(X)
  have sinBelow : realSin(X) ≤ R[1] by linarith
  have nonnegative := sinPow.nonnegative at n, X with lower, upper
  refine ⟨nonnegative, ?_⟩
  rw sinPow.value_succ
  have value := sinPow.real at n, X
  have scaled := realLe.mul_right_of_nonnegative with sinBelow, nonnegative
  have unit : R[1 * sinPow(n)(X)] = sinPow(n)(X) by ring
  rw unit at scaled
  exact scaled

theorem wallisIntegral.antitone (n : Nat)
  shows wallisIntegral(succ(n)) ≤ wallisIntegral(n) ∧
    R[0] ≤ wallisIntegral(n)
proof
  have first := wallisIntegral.has_integral at succ(n)
  have second := wallisIntegral.has_integral at n
  have positive := realHalfPi.positive
  have ordered : R[0] ≤ realHalfPi by linarith
  have zeroIntegral := HasRiemannIntegral.constant at R[0], realHalfPi, R[0]
    with ordered
  have bound : ∀ X ∈ closedInterval(R[0], realHalfPi),
      sinPow(succ(n))(X) ≤ sinPow(n)(X)
    intros X hX
    obtain ⟨xReal, lower, upper⟩ := closedInterval.membership.forward with hX
    have typedX : Real(X) by exact xReal
    obtain ⟨_, below⟩ := sinPow.bounds at n, X with lower, upper
    exact below
  have zeroBound : ∀ X ∈ closedInterval(R[0], realHalfPi),
      constantFunction(ℝ, ℝ, R[0])(X) ≤ sinPow(n)(X)
    intros X hX
    obtain ⟨xReal, lower, upper⟩ := closedInterval.membership.forward with hX
    have typedX : Real(X) by exact xReal
    obtain ⟨above, _⟩ := sinPow.bounds at n, X with lower, upper
    have constant := constantRealFunction.value at R[0], X
    unfold constantRealFunction at constant
    rw constant
    exact above
  have monotone := HasRiemannIntegral.mono with first, second, bound
  have nonnegative := HasRiemannIntegral.mono with zeroIntegral, second,
    zeroBound
  ring_nf at nonnegative
  exact ⟨monotone, nonnegative⟩

-- (n + 2) I_(n+2) = (n + 1) Iₙ, integrating (cos · sin^(n+1))'.
theorem wallisIntegral.step (n : Nat)
  shows R[(realNat(n) + 2) * wallisIntegral(succ(succ(n)))] =
    R[(realNat(n) + 1) * wallisIntegral(n)]
proof
  have positive := realHalfPi.positive
  have ordered : R[0] ≤ realHalfPi by linarith
  have functionN := sinPow.function at n
  have functionN1 := sinPow.function at succ(n)
  have functionN2 := sinPow.function at succ(succ(n))
  have aFunction := constantRealFunction.function at R[realNat(n) + 1]
  have bFunction := constantRealFunction.function at R[-(realNat(n) + 2)]
  have first := pointwiseMul.function with aFunction, functionN
  have second := pointwiseMul.function with bFunction, functionN2
  have combination := pointwiseAdd.function with first, second
  have values : ∀ X ∈ ℝ, pointwiseAdd(pointwiseMul(constantRealFunction(
      R[realNat(n) + 1]), sinPow(n)), pointwiseMul(constantRealFunction(
      R[-(realNat(n) + 2)]), sinPow(succ(succ(n)))))(X) =
      R[(realNat(n) + 1) * sinPow(n)(X) +
        -(realNat(n) + 2) * sinPow(succ(succ(n)))(X)]
    intros X hX
    have typedX : Real(X) by exact hX
    have v0 := sinPow.real at n, X
    have v2 := sinPow.real at succ(succ(n)), X
    have aValue := constantRealFunction.value at R[realNat(n) + 1], X
    have bValue := constantRealFunction.value at R[-(realNat(n) + 2)], X
    have firstReal : pointwiseMul(constantRealFunction(R[realNat(n) + 1]),
        sinPow(n))(X) ∈ ℝ
      exact FunctionBetween.apply_closed with first, hX
    have secondReal : pointwiseMul(constantRealFunction(
        R[-(realNat(n) + 2)]), sinPow(succ(succ(n))))(X) ∈ ℝ
      exact FunctionBetween.apply_closed with second, hX
    rw [(pointwiseAdd.value with first, second),
      (pointwiseMul.value with aFunction, functionN),
      (pointwiseMul.value with bFunction, functionN2), aValue, bValue]
  have continuousCombination := Continuous.continuous_on with
    (Continuous.add with (Continuous.mul with (constantRealFunction.continuous
      at R[realNat(n) + 1]), (sinPow.continuous at n)),
      (Continuous.mul with (constantRealFunction.continuous at
      R[-(realNat(n) + 2)]), (sinPow.continuous at succ(succ(n))))),
    (closedInterval.subset_reals at R[0], realHalfPi)
  -- The primitive cos · sin^(n+1).
  have primitiveFunction := pointwiseMul.function with realCos.function,
    functionN1
  have continuousPrimitive := Continuous.continuous_on with
    (Continuous.mul with realCos.continuous, (sinPow.continuous at succ(n))),
    (closedInterval.subset_reals at R[0], realHalfPi)
  have derivative : ∀ X ∈ ℝ, R[0] < X → X < realHalfPi →
      HasDerivativeAt(pointwiseMul(realCos, sinPow(succ(n))),
        pointwiseAdd(pointwiseMul(constantRealFunction(R[realNat(n) + 1]),
        sinPow(n)), pointwiseMul(constantRealFunction(R[-(realNat(n) + 2)]),
        sinPow(succ(succ(n)))))(X), X)
    intros X hX lower upper
    have typedX : Real(X) by exact hX
    have sinReal : realSin(X) ∈ ℝ by typecheck
    have cosReal : realCos(X) ∈ ℝ by typecheck
    have v0 := sinPow.real at n, X
    have v1 := sinPow.real at succ(n), X
    have product := HasDerivativeAt.mul_value with (realCos.derivative at X),
      (sinPow.derivative at n, X)
    apply HasDerivativeAt.congr_value with product
    rw [(values with X, hX), sinPow.value_succ, sinPow.value_succ,
      sinPow.value_succ]
    have pythagoras := realSin.square_add_cos_square at X
    linear_combination ((realNat(n) + 1) * sinPow(n)(X)) * pythagoras
  have fundamental := riemannIntegral.of_continuous_derivative with ordered,
    combination, continuousPrimitive, derivative, continuousCombination
  have halfReal : realHalfPi ∈ ℝ by typecheck
  have zeroReal : R[0] ∈ ℝ by typecheck
  have v1Half := sinPow.real at succ(n), realHalfPi
  have v1Zero := sinPow.real at succ(n), R[0]
  have v0Zero := sinPow.real at n, R[0]
  rw [(pointwiseMul.value at realCos, sinPow(succ(n)), realHalfPi with
    realCos.function, functionN1), (pointwiseMul.value at realCos,
    sinPow(succ(n)), R[0] with realCos.function, functionN1), realHalfPi.cos,
    realCos.zero, (sinPow.value_succ at n, R[0]), realSin.zero] at fundamental
  have integrable0 := ContinuousOn.integrable_interval with ordered,
    (sinPow.continuous_on at n)
  have integrable2 := ContinuousOn.integrable_interval with ordered,
    (sinPow.continuous_on at succ(succ(n)))
  obtain ⟨_, linear⟩ := riemannIntegral.linear with integrable0, integrable2,
    combination, values
  rw fundamental at linear
  unfold wallisIntegral
  have i0 : riemannIntegral(sinPow(n), R[0], realHalfPi) ∈ ℝ by typecheck
  have i2 : riemannIntegral(sinPow(succ(succ(n))), R[0], realHalfPi) ∈ ℝ by
    typecheck
  ring_nf at linear
  linear_combination linear

-- (n + 1) Iₙ I_(n+1) = π/2.
theorem wallisIntegral.product (n : Nat)
  shows R[(realNat(n) + 1) * wallisIntegral(n) * wallisIntegral(succ(n))] =
    realHalfPi
proof
  induction n
  | zero =>
    rw [realNat.zero, ← natural.one_succ, wallisIntegral.zero,
      wallisIntegral.one]
    ring
  | succ(k) using ih =>
    have step := wallisIntegral.step at k
    have e1 := add.right_one at k
    have i1 : wallisIntegral(succ(k)) ∈ ℝ by typecheck
    have i0 : wallisIntegral(k) ∈ ℝ by typecheck
    have i2 : wallisIntegral(succ(succ(k))) ∈ ℝ by typecheck
    rw [← e1, realNat.add, realNat.one]
    rw ← e1 at step
    rw ← e1 at ih
    linear_combination wallisIntegral(k + 1) * step + ih

-- (1/2)(3/2)⋯(m + 1/2)/m! · I_(2m+1) = 1/2.
theorem wallisIntegral.gauss (m : Nat)
  shows ℂ[risingFactorial(complexOfReal(R[1 / 2]), m + 1) *
      complexOfReal(R[1 / realNat(m!)]) *
      complexOfReal(wallisIntegral(2 * m + 1))] = complexOfReal(R[1 / 2])
proof
  induction m
  | zero =>
    have hfMember : complexOfReal(R[1 / 2]) ∈ ℂ by typecheck
    have fact0 : realNat((0:N)!) = R[1]
      rw factorial
      rw ← natural.one_succ
      exact realNat.one
    rw [mul.right_zero, add.left_unit, wallisIntegral.one,
      natural.one_succ, risingFactorial.succ, risingFactorial.zero, fact0,
      realNat.zero, complexOfReal.zero, realDiv.one_right, complexOfReal.one]
    ring
  | succ(k) using ih =>
    have hfMember : complexOfReal(R[1 / 2]) ∈ ℂ by typecheck
    have e1 : succ(k) + (1:N) = succ(k + (1:N)) by arith
    have e2 : (2:N) * succ(k) + (1:N) = succ(succ((2:N) * k + (1:N))) by arith
    have e3 := add.right_one at k
    rw [e1, risingFactorial.succ, e2, ← e3]
    have step := wallisIntegral.step at 2 * k + 1
    have odd : realNat(2 * k + 1) = R[2 * realNat(k) + 1]
      rw [realNat.add, realNat.mul, realNat.two, realNat.one]
    rw odd at step
    have successor : realNat(k + 1) = R[realNat(k) + 1]
      rw [realNat.add, realNat.one]
    have fact := realNat.factorial_succ at k
    have zeroLe := realNat.zero_le at k
    have kPositive : R[0] < R[realNat(k) + 1] by linarith
    have kNonzero : R[realNat(k) + 1] ≠ R[0] by linarith
    have factorialPositive := realNat.factorial_pos at k
    have factorialNonzero : realNat(k!) ≠ R[0] by linarith
    have recip : R[1 / realNat((k + 1)!)] =
        R[(1 / realNat(k!)) * (1 / (realNat(k) + 1))]
      rw [fact, realDiv.eq_mul_inv, realDiv.eq_mul_inv, realDiv.eq_mul_inv,
        (realInvValue.mul with kNonzero, factorialNonzero)]
      ring
    have cancelK := realDiv.mul_left at R[1], R[realNat(k) + 1] with kNonzero
    have i0 : wallisIntegral(2 * k + 1) ∈ ℝ by typecheck
    have i2 : wallisIntegral(succ(succ(2 * k + 1))) ∈ ℝ by typecheck
    have c0 : R[1 / realNat(k!)] ∈ ℝ by typecheck
    have h0 : R[1 / (realNat(k) + 1)] ∈ ℝ by typecheck
    have realStep : R[(1 / realNat((k + 1)!)) *
        wallisIntegral(succ(succ(2 * k + 1))) * (1 / 2 + (realNat(k) + 1))] =
        R[(1 / realNat(k!)) * wallisIntegral(2 * k + 1)]
      rw recip
      linear_combination (R[1 / 2] * (1 / realNat(k!)) *
        (1 / (realNat(k) + 1))) * step + (R[(1 / realNat(k!)) *
        wallisIntegral(2 * k + 1)]) * cancelK
    have lifted : complexOfReal(R[(1 / realNat((k + 1)!)) *
        wallisIntegral(succ(succ(2 * k + 1))) * (1 / 2 + (realNat(k) + 1))]) =
        complexOfReal(R[(1 / realNat(k!)) * wallisIntegral(2 * k + 1)]) by
      rw realStep
    rw [complexOfReal.mul, complexOfReal.mul, complexOfReal.add,
      complexOfReal.mul] at lifted
    rw successor
    have rising := risingFactorial.member at complexOfReal(R[1 / 2]), k + 1
      with hfMember
    have kCast : complexOfReal(R[realNat(k) + 1]) ∈ ℂ by typecheck
    have cNext : complexOfReal(R[1 / realNat((k + 1)!)]) ∈ ℂ by typecheck
    have iNext : complexOfReal(wallisIntegral(succ(succ(2 * k + 1)))) ∈ ℂ by
      typecheck
    have cThis : complexOfReal(R[1 / realNat(k!)]) ∈ ℂ by typecheck
    have iThis : complexOfReal(wallisIntegral(2 * k + 1)) ∈ ℂ by typecheck
    linear_combination risingFactorial(complexOfReal(R[1 / 2]), k + 1) *
      lifted + ih

-- With J = I_(2a+3) ≤ E = I_(2a+2) ≤ O = I_(2a+1), (2a + 3) J = (2a + 2) O and
-- (2a + 3) E J = π/2, the quantity 4 (a + 1) J² lies within 4 (π/2)/(a + 1)
-- below π.
theorem wallis.squeeze (a H O E J h : Real)
  requires aNonnegative : R[0] ≤ a
  requires JNonnegative : R[0] ≤ J
  requires JE : J ≤ E
  requires EO : E ≤ O
  requires stepEq : R[(2 * a + 3) * J] = R[(2 * a + 2) * O]
  requires productEq : R[(2 * a + 3) * E * J] = H
  requires hNonnegative : R[0] ≤ h
  requires hFact : R[(a + 1) * h] = R[1]
  shows R[0] ≤ R[2 * H - 4 * (a + 1) * J * J] ∧
    R[2 * H - 4 * (a + 1) * J * J] ≤ R[4 * H * h]
proof
  have scale : R[0] ≤ R[(2 * a + 3) * J]
    have factor : R[0] ≤ R[2 * a + 3] by linarith
    exact realMulValue.nonnegative with factor, JNonnegative
  have JJ := realMulValue.nonnegative with JNonnegative, JNonnegative
  have upper := realLe.mul_left_of_nonnegative with JE, scale
  have lowerBound : R[0] ≤ R[2 * H - 4 * (a + 1) * J * J]
    have expand1 : R[(2 * a + 3) * J * J] = R[2 * (a * (J * J)) + 3 * (J * J)]
      by ring
    have expand2 : R[(2 * a + 3) * J * E] = R[(2 * a + 3) * E * J] by ring
    rw [expand2, productEq] at upper
    have expand3 : R[2 * H - 4 * (a + 1) * J * J] =
      R[2 * H - 4 * (a * (J * J)) - 4 * (J * J)] by ring
    rw expand3
    have expand4 : R[(2 * a + 3) * J * J] =
      R[2 * (a * (J * J)) + 3 * (J * J)] by ring
    rw expand4 at upper
    linarith
  refine ⟨lowerBound, ?_⟩
  -- (2a + 2) H ≤ (2a + 3)² J².
  have middle := realLe.mul_left_of_nonnegative with EO, scale
  have swap : R[(2 * a + 3) * J * E] = R[(2 * a + 3) * E * J] by ring
  rw [swap, productEq] at middle
  have factor2 : R[0] ≤ R[2 * a + 2] by linarith
  have scaled := realLe.mul_left_of_nonnegative with middle, factor2
  have combine : R[(2 * a + 2) * ((2 * a + 3) * J * O)] =
      R[((2 * a + 3) * J) * ((2 * a + 2) * O)] by ring
  rw [combine, ← stepEq] at scaled
  -- (2a + 3)² (2H − y) ≤ 4H (2a + 3).
  have factor4 : R[0] ≤ R[2 * (2 * a + 2)] by linarith
  have twice := realLe.mul_left_of_nonnegative with scaled, factor4
  have HNonnegative : R[0] ≤ H
    have EJ := realMulValue.nonnegative with JNonnegative, JNonnegative
    have up := realLe.mul_left_of_nonnegative with JE, scale
    have same : R[(2 * a + 3) * J * E] = R[(2 * a + 3) * E * J] by ring
    rw [same, productEq] at up
    have expand : R[(2 * a + 3) * J * J] =
      R[2 * (a * (J * J)) + 3 * (J * J)] by ring
    rw expand at up
    have aJJ := realMulValue.nonnegative with aNonnegative, EJ
    linarith
  have identity : R[((2 * a + 3) * (2 * H - 4 * (a + 1) * J * J)) *
      (2 * a + 3)] = R[2 * H * ((2 * a + 3) * (2 * a + 3)) -
      2 * (2 * a + 2) * (((2 * a + 3) * J) * ((2 * a + 3) * J))] by ring
  have expandTwice : R[2 * (2 * a + 2) * ((2 * a + 2) * H)] =
    R[2 * H * ((2 * a + 2) * (2 * a + 2))] by ring
  rw expandTwice at twice
  have target : R[4 * H * (2 * a + 3)] = R[2 * H * ((2 * a + 3) * (2 * a + 3))
    - 2 * H * ((2 * a + 2) * (2 * a + 2)) + 2 * H] by ring
  have cancelled : R[((2 * a + 3) * (2 * H - 4 * (a + 1) * J * J)) *
      (2 * a + 3)] ≤ R[4 * H * (2 * a + 3)] by linarith
  have positive : R[0] < R[2 * a + 3] by linarith
  have reduced := realLe.mul_right_cancel_positive with positive, cancelled
  -- Multiply by h, using (2a + 3) h = 2 + h.
  have byH := realLe.mul_right_of_nonnegative with reduced, hNonnegative
  have shape : R[((2 * a + 3) * (2 * H - 4 * (a + 1) * J * J)) * h] =
      R[(2 * H - 4 * (a + 1) * J * J) * (2 * ((a + 1) * h) + h)] by ring
  rw [shape, hFact] at byH
  have extra := realMulValue.nonnegative with lowerBound, hNonnegative
  have expand : R[(2 * H - 4 * (a + 1) * J * J) * (2 * 1 + h)] =
    R[2 * (2 * H - 4 * (a + 1) * J * J) + (2 * H - 4 * (a + 1) * J * J) * h]
    by ring
  rw expand at byH
  have HH := realMulValue.nonnegative with HNonnegative, hNonnegative
  have final : R[4 * H * h] = R[4 * (H * h)] by ring
  rw final
  linarith

theorem complexHalf.double
  shows ℂ[2 * complexOfReal(R[1 / 2])] = ℂ[1]
proof
  have hf : complexOfReal(R[1 / 2]) ∈ ℂ by typecheck
  have sum : ℂ[complexOfReal(R[1 / 2]) + complexOfReal(R[1 / 2])] = ℂ[1]
    rw ← complexOfReal.add
    have half : R[1 / 2 + 1 / 2] = R[1] by ring
    rw [half, complexOfReal.one]
  linear_combination sum

-- u_(1/2)(n)² · 4 (n + 1) I_(2n+3)² = 1.
theorem reciprocalGammaTerms.half_square (n : Nat)
  shows ℂ[reciprocalGammaTerms(complexOfReal(R[1 / 2]))(n) *
      reciprocalGammaTerms(complexOfReal(R[1 / 2]))(n) *
      (4 * complexOfReal(realNat(n + 1)) *
        complexOfReal(wallisIntegral(2 * (n + 1) + 1)) *
        complexOfReal(wallisIntegral(2 * (n + 1) + 1)))] = ℂ[1]
proof
  have hf : complexOfReal(R[1 / 2]) ∈ ℂ by typecheck
  have nMember : n ∈ ℕ by typecheck
  rw (reciprocalGammaTerms.value with hf, nMember)
  have gauss := wallisIntegral.gauss at n + 1
  have e1 : n + 1 + 1 = n + 2 by arith
  rw e1 at gauss
  have double := complexHalf.double
  have negative : ℂ[-complexOfReal(R[1 / 2])] ∈ ℂ by typecheck
  have powerMember := realCpow.member at realNat(n + 1),
    ℂ[-complexOfReal(R[1 / 2])] with negative
  have atLeast : (1:N) ≤ n + 1 by arith
  have inverse := realCpow.nat_neg_nat at 1, n + 1 with atLeast
  have pow1 : R[realNat(n + 1) ^ 1] = realNat(n + 1) by ring
  rw [pow1, realNat.one, complexOfReal.one] at inverse
  have exponent : ℂ[-complexOfReal(R[1 / 2]) + -complexOfReal(R[1 / 2])] =
      ℂ[-1] by
    linear_combination (-1) * double
  have power : ℂ[realCpow(realNat(n + 1), ℂ[-complexOfReal(R[1 / 2])]) *
      realCpow(realNat(n + 1), ℂ[-complexOfReal(R[1 / 2])])] =
      complexOfReal(R[1 / realNat(n + 1)])
    rw [← (realCpow.add at realNat(n + 1), ℂ[-complexOfReal(R[1 / 2])],
      ℂ[-complexOfReal(R[1 / 2])] with negative, negative), exponent, inverse]
  have zeroLe := realNat.zero_le at n
  have successor : realNat(n + 1) = R[realNat(n) + 1]
    rw [realNat.add, realNat.one]
  have mNonzero : realNat(n + 1) ≠ R[0] by linarith
  have cancelReal := realDiv.mul_left at R[1], realNat(n + 1) with mNonzero
  have cancel : ℂ[complexOfReal(realNat(n + 1)) *
      complexOfReal(R[1 / realNat(n + 1)])] = ℂ[1]
    rw [← complexOfReal.mul, cancelReal, complexOfReal.one]
  have rising := risingFactorial.member at complexOfReal(R[1 / 2]), n + 2
    with hf
  have c : complexOfReal(R[1 / realNat((n + 1)!)]) ∈ ℂ by typecheck
  have I : complexOfReal(wallisIntegral(2 * (n + 1) + 1)) ∈ ℂ by typecheck
  have M : complexOfReal(realNat(n + 1)) ∈ ℂ by typecheck
  have q : complexOfReal(R[1 / realNat(n + 1)]) ∈ ℂ by typecheck
  linear_combination (4 * complexOfReal(realNat(n + 1)) *
      (risingFactorial(complexOfReal(R[1 / 2]), n + 2) *
        complexOfReal(R[1 / realNat((n + 1)!)]) *
        complexOfReal(wallisIntegral(2 * (n + 1) + 1))) *
      (risingFactorial(complexOfReal(R[1 / 2]), n + 2) *
        complexOfReal(R[1 / realNat((n + 1)!)]) *
        complexOfReal(wallisIntegral(2 * (n + 1) + 1)))) * power +
    (4 * complexOfReal(realNat(n + 1)) *
      complexOfReal(R[1 / realNat(n + 1)]) *
      (risingFactorial(complexOfReal(R[1 / 2]), n + 2) *
        complexOfReal(R[1 / realNat((n + 1)!)]) *
        complexOfReal(wallisIntegral(2 * (n + 1) + 1)) +
        complexOfReal(R[1 / 2]))) * gauss +
    (4 * complexOfReal(R[1 / 2]) * complexOfReal(R[1 / 2])) * cancel +
    (2 * complexOfReal(R[1 / 2]) + 1) * double

-- If g² X = 1 with g arbitrarily close to r and X to P, then P r² = 1.
theorem complex.eq_of_approx (r P : Set)
  requires hr : r ∈ ℂ
  requires hP : P ∈ ℂ
  requires approx : ∀ e ∈ ℝ, R[0] < e → ∃ g ∈ ℂ, ∃ X ∈ ℂ,
    ℂ[g * g * X] = ℂ[1] ∧ complexAbs(ℂ[g - r]) < e ∧
    complexAbs(ℂ[P - X]) < e
  shows ℂ[P * r * r] = ℂ[1]
proof
  by_contra different
  have diffMember : ℂ[P * r * r - 1] ∈ ℂ by typecheck
  have nonzero : ℂ[P * r * r - 1] ≠ ℂ[0]
    intro zero
    apply different
    linear_combination zero
  have DPositive := complexAbs.positive with diffMember, nonzero
  have DReal : complexAbs(ℂ[P * r * r - 1]) ∈ ℝ by typecheck
  have rAbs := complexAbs.nonnegative with hr
  have PAbs := complexAbs.nonnegative with hP
  have rReal : complexAbs(r) ∈ ℝ by typecheck
  have PReal : complexAbs(P) ∈ ℝ by typecheck
  -- K = |r|² + (|P| + 1)(2|r| + 1).
  have rr := realMulValue.nonnegative with rAbs, rAbs
  have P1 : R[0] ≤ R[complexAbs(P) + 1] by linarith
  have r1 : R[0] ≤ R[2 * complexAbs(r) + 1] by linarith
  have Pr := realMulValue.nonnegative with P1, r1
  have KPositive : R[0] < R[complexAbs(r) * complexAbs(r) +
    (complexAbs(P) + 1) * (2 * complexAbs(r) + 1) + 1] by linarith
  have KNonzero : R[complexAbs(r) * complexAbs(r) +
    (complexAbs(P) + 1) * (2 * complexAbs(r) + 1) + 1] ≠ R[0] by linarith
  have inverse := realInvValue.positive with KPositive
  have cancel := realInvValue.mul_right with KNonzero
  have e0Positive := realMulValue.positive with DPositive, inverse
  have e0Real : R[complexAbs(ℂ[P * r * r - 1]) * realInvValue(R[complexAbs(r) *
    complexAbs(r) + (complexAbs(P) + 1) * (2 * complexAbs(r) + 1) + 1])] ∈ ℝ
    by typecheck
  have one : R[1] ∈ ℝ by typecheck
  have onePositive : R[0] < R[1] by linarith
  obtain ⟨e, he, ePositive, eSmall, eOne⟩ := realRadius.common with e0Real,
    one, e0Positive, onePositive
  obtain ⟨g, hg, X, hX, product, gClose, XClose⟩ := approx with e, he,
    ePositive
  -- P r² − 1 = (P − X) r² + X (r − g)(r + g).
  have split : ℂ[P * r * r - 1] = ℂ[(P - X) * r * r + X * (r - g) * (r + g)] by
    linear_combination product
  have first : ℂ[(P - X) * r * r] ∈ ℂ by typecheck
  have second : ℂ[X * (r - g) * (r + g)] ∈ ℂ by typecheck
  have triangle := complexAbs.triangle with first, second
  rw ← split at triangle
  have PX : ℂ[P - X] ∈ ℂ by typecheck
  have rg : ℂ[r - g] ∈ ℂ by typecheck
  have rpg : ℂ[r + g] ∈ ℂ by typecheck
  have PXr : ℂ[(P - X) * r] ∈ ℂ by typecheck
  have Xrg : ℂ[X * (r - g)] ∈ ℂ by typecheck
  rw [(complexAbs.mul with PXr, hr), (complexAbs.mul with PX, hr)] at triangle
  rw [(complexAbs.mul with Xrg, rpg), (complexAbs.mul with hX, rg)] at triangle
  -- The factors.
  have PXNonnegative := complexAbs.nonnegative with PX
  have PXBound : complexAbs(ℂ[P - X]) ≤ e by linarith
  have firstBound := realLe.mul_right_of_nonnegative with PXBound, rr
  have firstRegroup : R[complexAbs(ℂ[P - X]) * complexAbs(r) * complexAbs(r)] =
    R[complexAbs(ℂ[P - X]) * (complexAbs(r) * complexAbs(r))] by ring
  rw firstRegroup at triangle
  have XNonnegative := complexAbs.nonnegative with hX
  have XSplit : X = ℂ[P - (P - X)] by ring
  have XTriangle := complexAbs.sub_le with hP, PX
  rw ← XSplit at XTriangle
  have XBound : complexAbs(X) ≤ R[complexAbs(P) + 1] by linarith
  have rgSymmetric := complexAbs.dist_symm with hr, hg
  have rgNonnegative := complexAbs.nonnegative with rg
  have rgBound : complexAbs(ℂ[r - g]) ≤ e by linarith
  have gSplit : ℂ[r + g] = ℂ[2 * r - (r - g)] by ring
  have twoR : ℂ[2 * r] ∈ ℂ by typecheck
  have gTriangle := complexAbs.sub_le with twoR, rg
  rw ← gSplit at gTriangle
  have twoRAbs : complexAbs(ℂ[2 * r]) = R[2 * complexAbs(r)]
    have two : ℂ[2] ∈ ℂ by typecheck
    rw (complexAbs.mul with two, hr)
    have twoCast : ℂ[2] = complexOfReal(R[2])
      rw [← complexOfReal.one]
      have same : R[2] = R[1 + 1] by ring
      rw [same, complexOfReal.add, complexOfReal.one]
      ring
    rw [twoCast, complexAbs.of_real]
    have twoNonnegative : R[0] ≤ R[2] by linarith
    rw (abs.of_nonnegative with twoNonnegative)
  rw twoRAbs at gTriangle
  have rpgBound : complexAbs(ℂ[r + g]) ≤ R[2 * complexAbs(r) + 1] by linarith
  have rpgNonnegative := complexAbs.nonnegative with rpg
  have Xrg1 := gammaReal.mul_le with XNonnegative, XBound, rgNonnegative,
    rgBound
  have XrgNonnegative := realMulValue.nonnegative with XNonnegative,
    rgNonnegative
  have Xrg2 := gammaReal.mul_le with XrgNonnegative, Xrg1, rpgNonnegative,
    rpgBound
  -- Altogether |P r² − 1| ≤ e (K − 1) < e K ≤ D.
  have KNonnegative : R[0] ≤ R[complexAbs(r) * complexAbs(r) +
    (complexAbs(P) + 1) * (2 * complexAbs(r) + 1) + 1] by linarith
  have eK := realLe.mul_right_of_nonnegative with eSmall, KNonnegative
  have collapse : R[(complexAbs(ℂ[P * r * r - 1]) * realInvValue(R[complexAbs(r)
      * complexAbs(r) + (complexAbs(P) + 1) * (2 * complexAbs(r) + 1) + 1])) *
      (complexAbs(r) * complexAbs(r) + (complexAbs(P) + 1) *
      (2 * complexAbs(r) + 1) + 1)] = R[complexAbs(ℂ[P * r * r - 1]) *
      ((complexAbs(r) * complexAbs(r) + (complexAbs(P) + 1) *
      (2 * complexAbs(r) + 1) + 1) * realInvValue(R[complexAbs(r) *
      complexAbs(r) + (complexAbs(P) + 1) * (2 * complexAbs(r) + 1) + 1]))]
    by ring
  rw [collapse, cancel] at eK
  have expandK : R[e * (complexAbs(r) * complexAbs(r) + (complexAbs(P) + 1) *
      (2 * complexAbs(r) + 1) + 1)] = R[e * (complexAbs(r) * complexAbs(r)) +
      ((complexAbs(P) + 1) * e) * (2 * complexAbs(r) + 1) + e] by ring
  rw expandK at eK
  have unit : R[complexAbs(ℂ[P * r * r - 1]) * 1] =
    complexAbs(ℂ[P * r * r - 1]) by ring
  rw unit at eK
  linarith

theorem complexOfReal.four
  shows complexOfReal(R[4]) = ℂ[4]
proof
  have same : R[4] = R[1 + 1 + 1 + 1] by ring
  rw [same, complexOfReal.add, complexOfReal.add, complexOfReal.add,
    complexOfReal.one]
  ring

theorem wallisIntegral.positive (n : Nat)
  shows R[0] < wallisIntegral(n)
proof
  obtain ⟨_, nonnegative⟩ := wallisIntegral.antitone at n
  have product := wallisIntegral.product at n
  have halfPositive := realHalfPi.positive
  by_contra notPositive
  have zero : wallisIntegral(n) = R[0] by linarith
  rw zero at product
  have i1 : wallisIntegral(succ(n)) ∈ ℝ by typecheck
  have collapse : R[(realNat(n) + 1) * 0 * wallisIntegral(succ(n))] = R[0] by
    ring
  rw collapse at product
  linarith

-- Gauss's sequence at 1/2 is real and positive.
theorem reciprocalGammaTerms.half_positive (n : Nat)
  shows ∃ t ∈ ℝ, R[0] < t ∧
    reciprocalGammaTerms(complexOfReal(R[1 / 2]))(n) = complexOfReal(t)
proof
  have hf : complexOfReal(R[1 / 2]) ∈ ℂ by typecheck
  have nMember : n ∈ ℕ by typecheck
  have gauss := wallisIntegral.gauss at n + 1
  have e1 : n + 1 + 1 = n + 2 by arith
  rw e1 at gauss
  have IPositive := wallisIntegral.positive at 2 * (n + 1) + 1
  have INonzero : wallisIntegral(2 * (n + 1) + 1) ≠ R[0] by linarith
  have cancelReal := realDiv.mul_left at R[1],
    wallisIntegral(2 * (n + 1) + 1) with INonzero
  have cancel : ℂ[complexOfReal(wallisIntegral(2 * (n + 1) + 1)) *
      complexOfReal(R[1 / wallisIntegral(2 * (n + 1) + 1)])] = ℂ[1]
    rw [← complexOfReal.mul, cancelReal, complexOfReal.one]
  have power : realCpow(realNat(n + 1), ℂ[-complexOfReal(R[1 / 2])]) =
      complexOfReal(realExp(R[-(1 / 2) * realLog(realNat(n + 1))]))
    unfold realCpow
    rw [← complexOfReal.neg, ← complexOfReal.mul, complexExp.of_real]
  have expPositive := realExp.positive at R[-(1 / 2) * realLog(realNat(n + 1))]
  have inversePositive : R[0] < R[1 / wallisIntegral(2 * (n + 1) + 1)]
    rw realDiv.eq_mul_inv
    have inverse := realInvValue.positive with IPositive
    have same : R[1 * realInvValue(wallisIntegral(2 * (n + 1) + 1))] =
      realInvValue(wallisIntegral(2 * (n + 1) + 1)) by ring
    rw same
    exact inverse
  have halfPositive : R[0] < R[1 / 2] by linarith
  have halfInverse := realMulValue.positive with halfPositive, inversePositive
  have tPositive := realMulValue.positive with expPositive, halfInverse
  have tReal : R[realExp(R[-(1 / 2) * realLog(realNat(n + 1))]) * ((1 / 2) *
    (1 / wallisIntegral(2 * (n + 1) + 1)))] ∈ ℝ by typecheck
  refine ⟨R[realExp(R[-(1 / 2) * realLog(realNat(n + 1))]) * ((1 / 2) *
    (1 / wallisIntegral(2 * (n + 1) + 1)))], tReal, tPositive, ?_⟩
  rw [(reciprocalGammaTerms.value with hf, nMember), power, complexOfReal.mul,
    complexOfReal.mul]
  have E : complexOfReal(realExp(R[-(1 / 2) * realLog(realNat(n + 1))])) ∈ ℂ
    by typecheck
  have rising := risingFactorial.member at complexOfReal(R[1 / 2]), n + 2
    with hf
  have c : complexOfReal(R[1 / realNat((n + 1)!)]) ∈ ℂ by typecheck
  have I : complexOfReal(wallisIntegral(2 * (n + 1) + 1)) ∈ ℂ by typecheck
  have J : complexOfReal(R[1 / wallisIntegral(2 * (n + 1) + 1)]) ∈ ℂ by
    typecheck
  linear_combination (complexOfReal(realExp(R[-(1 / 2) *
    realLog(realNat(n + 1))])) * complexOfReal(R[1 / wallisIntegral(2 * (n + 1)
    + 1)])) * gauss - (complexOfReal(realExp(R[-(1 / 2) *
    realLog(realNat(n + 1))])) * risingFactorial(complexOfReal(R[1 / 2]),
    n + 2) * complexOfReal(R[1 / realNat((n + 1)!)])) * cancel

-- A nonnegative square root is the square root.
theorem gammaReal.sqrt_unique (T X : Real)
  requires nonnegative : R[0] ≤ T
  requires square : R[T * T] = X
  shows T = realSqrt(X)
proof
  have XNonnegative : R[0] ≤ X
    have product := realMulValue.nonnegative with nonnegative, nonnegative
    linarith
  have SNonnegative := realSqrt.nonneg with XNonnegative
  have SSquare := realSqrt.square with XNonnegative
  have SReal : realSqrt(X) ∈ ℝ by typecheck
  by_contra different
  by_cases below : T < realSqrt(X)
  . have SPositive : R[0] < realSqrt(X) by linarith
    have belowLe : T ≤ realSqrt(X) by linarith
    have first := realLe.mul_left_of_nonnegative with belowLe, nonnegative
    have second := realLess.mul_right_of_positive with below, SPositive
    linarith
  . have above : realSqrt(X) < T
      have notEqual : T ≠ realSqrt(X) by exact different
      have le : realSqrt(X) ≤ T by linarith
      by_contra notAbove
      have same : T = realSqrt(X) by linarith
      exact notEqual with same
    have TPositive : R[0] < T by linarith
    have aboveLe : realSqrt(X) ≤ T by linarith
    have first := realLe.mul_left_of_nonnegative with aboveLe, SNonnegative
    have second := realLess.mul_right_of_positive with above, TPositive
    have swap : R[realSqrt(X) * T] = R[T * realSqrt(X)] by ring
    linarith

-- A product with a positive factor vanishes only with the other factor.
theorem gammaReal.zero_of_mul (A B : Real)
  requires positive : R[0] < A
  requires product : R[A * B] = R[0]
  shows B = R[0]
proof
  by_contra nonzero
  by_cases negative : B < R[0]
  . have flipped : R[0] < R[-B] by linarith
    have bad := realMulValue.positive with positive, flipped
    have same : R[A * -B] = R[-(A * B)] by ring
    rw [same, product] at bad
    linarith
  . have positiveB : R[0] < B
      by_contra notPositive
      have zero : B = R[0] by linarith
      exact nonzero with zero
    have bad := realMulValue.positive with positive, positiveB
    rw product at bad
    linarith

theorem gammaReal.square_positive (A : Real)
  requires nonzero : A ≠ R[0]
  shows R[0] < R[A * A]
proof
  by_cases negative : A < R[0]
  . have flipped : R[0] < R[-A] by linarith
    have product := realMulValue.positive with flipped, flipped
    have same : R[-A * -A] = R[A * A] by ring
    rw same at product
    exact product
  . have positiveA : R[0] < A
      by_contra notPositive
      have zero : A = R[0] by linarith
      exact nonzero with zero
    exact realMulValue.positive with positiveA, positiveA

theorem gammaReal.square_nonnegative (A : Real)
  shows R[0] ≤ R[A * A]
proof
  by_cases zero : A = R[0]
  . rw zero
    have same : R[0 * 0] = R[0] by ring
    rw same
    exact realLe.reflexive at R[0]
  . have positive := gammaReal.square_positive with zero
    linarith

-- Section: Legendre's duplication
-- (2z)_(2j) = c_j (z)_j (z + 1/2)_j with c_j independent of z (c_j = 4^j).
theorem risingFactorial.doubling (j : Nat)
  shows ∃ c ∈ ℂ, ∀ z ∈ ℂ, risingFactorial(ℂ[2 * z], 2 * j) =
    ℂ[c * risingFactorial(z, j) *
      risingFactorial(ℂ[z + complexOfReal(R[1 / 2])], j)]
proof
  induction j
  | zero =>
    have one := complexOne.member
    refine ⟨ℂ[1], one, ?_⟩
    intros z hz
    have e0 : (2:N) * (0:N) = (0:N) by arith
    rw [e0, risingFactorial.zero, risingFactorial.zero, risingFactorial.zero]
    ring
  | succ(k) using ih =>
    obtain ⟨c, hc, formula⟩ := ih
    have four : ℂ[4 * c] ∈ ℂ by typecheck
    refine ⟨ℂ[4 * c], four, ?_⟩
    intros z hz
    have e1 : (2:N) * succ(k) = succ(succ((2:N) * k)) by arith
    have e2 := add.right_one at (2:N) * k
    have double : ℂ[2 * z] ∈ ℂ by typecheck
    have hf : complexOfReal(R[1 / 2]) ∈ ℂ by typecheck
    have shifted : ℂ[z + complexOfReal(R[1 / 2])] ∈ ℂ by typecheck
    rw [e1, risingFactorial.succ, risingFactorial.succ, (formula with z, hz),
      risingFactorial.succ, risingFactorial.succ, ← e2, realNat.add,
      realNat.mul, realNat.two, realNat.one, complexOfReal.add,
      complexOfReal.mul, complexOfReal.one]
    have two : complexOfReal(R[2]) = ℂ[2]
      have same : R[2] = R[1 + 1] by ring
      rw [same, complexOfReal.add, complexOfReal.one]
      ring
    have halfDouble := complexHalf.double
    rw two
    have kCast : complexOfReal(realNat(k)) ∈ ℂ by typecheck
    have r1 := risingFactorial.member at z, k with hz
    have r2 := risingFactorial.member at ℂ[z + complexOfReal(R[1 / 2])], k with
      shifted
    linear_combination (-(c * risingFactorial(z, k) * risingFactorial(ℂ[z +
      complexOfReal(R[1 / 2])], k) * (2 * z + 2 *
      complexOfReal(realNat(k))))) * halfDouble

-- Gauss's terms at 2z against those at z and z + 1/2, up to a constant
-- independent of z.
theorem reciprocalGammaTerms.doubling (n : Nat)
  shows ∃ c ∈ ℂ, ∀ z ∈ ℂ,
    ℂ[reciprocalGammaTerms(ℂ[2 * z])(2 * n + 2) *
      realCpow(realNat(n + 1), ℂ[-z]) *
      realCpow(realNat(n + 1), ℂ[-(z + complexOfReal(R[1 / 2]))]) *
      complexOfReal(R[1 / realNat((n + 1)!)]) *
      complexOfReal(R[1 / realNat((n + 1)!)])] =
    ℂ[c * realCpow(realNat(2 * n + 3), ℂ[-(2 * z)]) *
      reciprocalGammaTerms(z)(n) *
      reciprocalGammaTerms(ℂ[z + complexOfReal(R[1 / 2])])(n)]
proof
  obtain ⟨c0, hc0, formula⟩ := risingFactorial.doubling at n + 2
  have f2 : complexOfReal(R[1 / realNat((2 * n + 3)!)]) ∈ ℂ by typecheck
  have cMember : ℂ[c0 * complexOfReal(R[1 / realNat((2 * n + 3)!)])] ∈ ℂ by
    typecheck
  refine ⟨ℂ[c0 * complexOfReal(R[1 / realNat((2 * n + 3)!)])], cMember, ?_⟩
  intros z hz
  have double : ℂ[2 * z] ∈ ℂ by typecheck
  have hf : complexOfReal(R[1 / 2]) ∈ ℂ by typecheck
  have shifted : ℂ[z + complexOfReal(R[1 / 2])] ∈ ℂ by typecheck
  have nMember : n ∈ ℕ by typecheck
  have mMember : 2 * n + 2 ∈ ℕ by typecheck
  have e1 : 2 * n + 2 + 1 = 2 * n + 3 by arith
  have e2 : 2 * n + 2 + 2 = 2 * (n + 2) by arith
  rw [(reciprocalGammaTerms.value with double, mMember),
    (reciprocalGammaTerms.value with hz, nMember),
    (reciprocalGammaTerms.value with shifted, nMember), e1, e2,
    (formula with z, hz)]
  have negDouble : ℂ[-(2 * z)] ∈ ℂ by typecheck
  have P2 := realCpow.member at realNat(2 * n + 3), ℂ[-(2 * z)] with negDouble
  have negZ : ℂ[-z] ∈ ℂ by typecheck
  have negShift : ℂ[-(z + complexOfReal(R[1 / 2]))] ∈ ℂ by typecheck
  have P1 := realCpow.member at realNat(n + 1), ℂ[-z] with negZ
  have P1h := realCpow.member at realNat(n + 1),
    ℂ[-(z + complexOfReal(R[1 / 2]))] with negShift
  have r1 := risingFactorial.member at z, n + 2 with hz
  have r2 := risingFactorial.member at ℂ[z + complexOfReal(R[1 / 2])], n + 2
    with shifted
  have f1 : complexOfReal(R[1 / realNat((n + 1)!)]) ∈ ℂ by typecheck
  have negativeDouble : ℂ[-(2 * z)] = ℂ[-2 * z] by ring
  ring

-- Products and the subsequence n ↦ 2n + 2 of complex sequences.
defgraph complexSeqMul (u v : Set) (n ∈ ℕ) : complexCarrier := ℂ[u(n) * v(n)]
requires sequenceU : ComplexSequence(u)
requires sequenceV : ComplexSequence(v)
proof
  have functionU : u : ℕ → ℂ by exact sequenceU
  have functionV : v : ℕ → ℂ by exact sequenceV
  have un := FunctionBetween.apply_closed with functionU, member
  have vn := FunctionBetween.apply_closed with functionV, member
  typecheck

defgraph doubledTerms (u : Set) (n ∈ ℕ) : complexCarrier := u(2 * n + 2)
requires sequenceU : ComplexSequence(u)
proof
  have functionU : u : ℕ → ℂ by exact sequenceU
  have nNat := nat.omega.backward with member
  have index : 2 * n + 2 ∈ ℕ by typecheck
  exact FunctionBetween.apply_closed with functionU, index

theorem ComplexConvergesTo.doubled (u a : Set)
  requires converges : ComplexConvergesTo(u, a)
  shows ComplexConvergesTo(doubledTerms(u), a)
proof
  have convergesAgain := converges
  obtain ⟨sequenceU, ha, _, _⟩ := convergesAgain
  have close := (ComplexConvergesTo.iff_abs with sequenceU, ha).forward with
    converges
  have sequence : ComplexSequence(doubledTerms(u)) by
    exact doubledTerms.function with sequenceU
  apply (ComplexConvergesTo.iff_abs with sequence, ha).backward
  intros e he ePositive
  obtain ⟨N, hN, after⟩ := close with e, he, ePositive
  refine ⟨N, hN, ?_⟩
  intros n hn le
  have nNat := nat.omega.backward at n with hn
  have NNat := nat.omega.backward at N with hN
  have index : 2 * n + 2 ∈ ℕ by typecheck
  have later : N ≤ 2 * n + 2 by arith
  rw (doubledTerms.value with sequenceU, hn)
  exact after with 2 * n + 2, index, later

theorem ComplexConvergesTo.mul (u v a b : Set)
  requires convergesU : ComplexConvergesTo(u, a)
  requires convergesV : ComplexConvergesTo(v, b)
  shows ComplexConvergesTo(complexSeqMul(u, v), ℂ[a * b])
proof
  have copyU := convergesU
  have copyV := convergesV
  obtain ⟨sequenceU, ha, _, _⟩ := copyU
  obtain ⟨sequenceV, hb, _, _⟩ := copyV
  have functionU : u : ℕ → ℂ by exact sequenceU
  have functionV : v : ℕ → ℂ by exact sequenceV
  have closeU := (ComplexConvergesTo.iff_abs with sequenceU, ha).forward with
    convergesU
  have closeV := (ComplexConvergesTo.iff_abs with sequenceV, hb).forward with
    convergesV
  have sequence : ComplexSequence(complexSeqMul(u, v)) by
    exact complexSeqMul.function with sequenceU, sequenceV
  have product : ℂ[a * b] ∈ ℂ by typecheck
  apply (ComplexConvergesTo.iff_abs with sequence, product).backward
  intros e he ePositive
  have aNonnegative := complexAbs.nonnegative with ha
  have bNonnegative := complexAbs.nonnegative with hb
  have aReal : complexAbs(a) ∈ ℝ by typecheck
  have bReal : complexAbs(b) ∈ ℝ by typecheck
  have KPositive : R[0] < R[complexAbs(a) + complexAbs(b) + 2] by linarith
  have KNonzero : R[complexAbs(a) + complexAbs(b) + 2] ≠ R[0] by linarith
  have inverse := realInvValue.positive with KPositive
  have cancel := realInvValue.mul_right with KNonzero
  have e0Positive := realMulValue.positive with ePositive, inverse
  have e0Real : R[e * realInvValue(R[complexAbs(a) + complexAbs(b) + 2])] ∈ ℝ
    by typecheck
  have one : R[1] ∈ ℝ by typecheck
  have onePositive : R[0] < R[1] by linarith
  obtain ⟨d, hd, dPositive, dSmall, dOne⟩ := realRadius.common with e0Real,
    one, e0Positive, onePositive
  obtain ⟨N1, hN1, after1⟩ := closeU with d, hd, dPositive
  obtain ⟨N2, hN2, after2⟩ := closeV with d, hd, dPositive
  have N1Nat := nat.omega.backward at N1 with hN1
  have N2Nat := nat.omega.backward at N2 with hN2
  have NMember : N1 + N2 ∈ ℕ by typecheck
  refine ⟨N1 + N2, NMember, ?_⟩
  intros n hn le
  have nNat := nat.omega.backward at n with hn
  have le1 : N1 ≤ n by arith
  have le2 : N2 ≤ n by arith
  have nearU := after1 with n, hn, le1
  have nearV := after2 with n, hn, le2
  have un := FunctionBetween.apply_closed with functionU, hn
  have vn := FunctionBetween.apply_closed with functionV, hn
  rw (complexSeqMul.value with sequenceU, sequenceV, hn)
  -- uv − ab = (u − a) v + a (v − b).
  have split : ℂ[u(n) * v(n) - a * b] =
    ℂ[(u(n) - a) * v(n) + a * (v(n) - b)] by ring
  have du : ℂ[u(n) - a] ∈ ℂ by typecheck
  have dv : ℂ[v(n) - b] ∈ ℂ by typecheck
  have first : ℂ[(u(n) - a) * v(n)] ∈ ℂ by typecheck
  have second : ℂ[a * (v(n) - b)] ∈ ℂ by typecheck
  have triangle := complexAbs.triangle with first, second
  rw [← split, (complexAbs.mul with du, vn), (complexAbs.mul with ha, dv)]
    at triangle
  have vSplit : v(n) = ℂ[(v(n) - b) + b] by ring
  have vTriangle := complexAbs.triangle with dv, hb
  rw ← vSplit at vTriangle
  have duNonnegative := complexAbs.nonnegative with du
  have dvNonnegative := complexAbs.nonnegative with dv
  have vNonnegative := complexAbs.nonnegative with vn
  have duBound : complexAbs(ℂ[u(n) - a]) ≤ d by linarith
  have dvBound : complexAbs(ℂ[v(n) - b]) ≤ d by linarith
  have vBound : complexAbs(v(n)) ≤ R[complexAbs(b) + 1] by linarith
  have firstBound := gammaReal.mul_le with duNonnegative, duBound,
    vNonnegative, vBound
  have secondBound := realLe.mul_left_of_nonnegative with dvBound,
    aNonnegative
  have total : R[complexAbs(ℂ[u(n) - a]) * complexAbs(v(n)) + complexAbs(a) *
      complexAbs(ℂ[v(n) - b])] ≤ R[d * (complexAbs(a) + complexAbs(b) + 2) - d]
    have expand : R[d * (complexAbs(a) + complexAbs(b) + 2) - d] =
      R[d * (complexAbs(b) + 1) + complexAbs(a) * d] by ring
    rw expand
    linarith
  have KNonnegative : R[0] ≤ R[complexAbs(a) + complexAbs(b) + 2] by linarith
  have scaled := realLe.mul_right_of_nonnegative with dSmall, KNonnegative
  have collapse : R[(e * realInvValue(R[complexAbs(a) + complexAbs(b) + 2])) *
      (complexAbs(a) + complexAbs(b) + 2)] = R[e * ((complexAbs(a) +
      complexAbs(b) + 2) * realInvValue(R[complexAbs(a) + complexAbs(b) + 2]))]
    by ring
  rw [collapse, cancel] at scaled
  have unit : R[e * 1] = e by ring
  rw unit at scaled
  linarith

-- The weights (2n + 3)^(2s−1) (n + 1)^(1−2s), which tend to 2^(2s−1).
defgraph gaussDoublingWeight (s : Set) (n ∈ ℕ) : complexCarrier :=
  ℂ[realCpow(realNat(2 * n + 3), ℂ[2 * s - 1]) *
    realCpow(realNat(n + 1), ℂ[1 - 2 * s])]
requires hs : s ∈ complexCarrier
proof
  have nNat := nat.omega.backward with member
  have first : ℂ[2 * s - 1] ∈ ℂ by typecheck
  have second : ℂ[1 - 2 * s] ∈ ℂ by typecheck
  have p1 := realCpow.member at realNat(2 * n + 3), ℂ[2 * s - 1] with first
  have p2 := realCpow.member at realNat(n + 1), ℂ[1 - 2 * s] with second
  typecheck

-- 0 ≤ log(2n + 3) − log(n + 1) − log 2 ≤ 1/(n + 1).
theorem gaussDoublingWeight.log_gap (n : Nat)
  shows R[0] ≤ R[realLog(realNat(2 * n + 3)) - realLog(realNat(n + 1)) -
      realLog(R[2])] ∧
    R[realLog(realNat(2 * n + 3)) - realLog(realNat(n + 1)) - realLog(R[2])] ≤
      R[1 / realNat(n + 1)]
proof
  have zeroLe := realNat.zero_le at n
  have successor : realNat(n + 1) = R[realNat(n) + 1]
    rw [realNat.add, realNat.one]
  have aPositive : R[0] < realNat(n + 1) by linarith
  have twoPositive : R[0] < R[2] by linarith
  have even : realNat(2 * n + 3) = R[2 * realNat(n + 1) + 1]
    have e3 : 2 * n + 3 = succ(2 * (n + 1)) by arith
    rw [e3, realNat.successor, realNat.mul, realNat.two]
  have logProduct := realLog.mul with twoPositive, aPositive
  have XPositive : R[0] < R[2 * realNat(n + 1)] by linarith
  have shifted : R[0] < R[2 * realNat(n + 1) + 1] by linarith
  obtain ⟨lower, upper⟩ := realLog.increment_bounds at R[2 * realNat(n + 1)],
    R[1] with XPositive, shifted
  rw [even]
  have inverseLower : R[0] ≤ R[1 * (1 / (2 * realNat(n + 1) + 1))]
    rw realDiv.eq_mul_inv
    have positive := realInvValue.positive with shifted
    have same : R[1 * (1 * realInvValue(R[2 * realNat(n + 1) + 1]))] =
      realInvValue(R[2 * realNat(n + 1) + 1]) by ring
    rw same
    linarith
  have aNonzero : realNat(n + 1) ≠ R[0] by linarith
  have twoNonzero : R[2] ≠ R[0] by linarith
  have halfInverse : R[1 * (1 / (2 * realNat(n + 1)))] ≤ R[1 / realNat(n + 1)]
    rw [realDiv.eq_mul_inv, realDiv.eq_mul_inv,
      (realInvValue.mul with twoNonzero, aNonzero)]
    have hPositive := realInvValue.positive with aPositive
    have twoInverse := realInvValue.mul_right with twoNonzero
    have half : R[realInvValue(R[2])] = R[1 / 2]
      have expand : R[1 / 2] = R[1 * realInvValue(R[2])] by
        rw realDiv.eq_mul_inv
      rw expand
      ring
    rw half
    have lhs : R[1 * (1 * (1 / 2 * realInvValue(realNat(n + 1))))] =
      R[realInvValue(realNat(n + 1)) / 2] by ring
    have rhs : R[1 * realInvValue(realNat(n + 1))] =
      realInvValue(realNat(n + 1)) by ring
    rw [lhs, rhs]
    linarith
  constructor
  . linarith
  . linarith

theorem gaussDoublingWeight.converges (s : Set)
  requires hs : s ∈ ℂ
  shows ComplexConvergesTo(gaussDoublingWeight(s),
    realCpow(R[2], ℂ[2 * s - 1]))
proof
  have w : ℂ[2 * s - 1] ∈ ℂ by typecheck
  have limitMember := realCpow.member at R[2], ℂ[2 * s - 1] with w
  have sequence : ComplexSequence(gaussDoublingWeight(s)) by
    exact gaussDoublingWeight.function with hs
  apply (ComplexConvergesTo.iff_abs with sequence, limitMember).backward
  intros e he ePositive
  have wNonnegative := complexAbs.nonnegative with w
  have wReal : complexAbs(ℂ[2 * s - 1]) ∈ ℝ by typecheck
  have pNonnegative := complexAbs.nonnegative with limitMember
  have pReal : complexAbs(realCpow(R[2], ℂ[2 * s - 1])) ∈ ℝ by typecheck
  have onePositive : R[0] < R[1] by linarith
  obtain ⟨N1, hN1, after1⟩ := gammaReal.eventually_small with wNonnegative,
    onePositive
  have CNonnegative : R[0] ≤ R[2 * complexAbs(realCpow(R[2], ℂ[2 * s - 1])) *
      complexAbs(ℂ[2 * s - 1])]
    have product := realMulValue.nonnegative with pNonnegative, wNonnegative
    have same : R[2 * complexAbs(realCpow(R[2], ℂ[2 * s - 1])) *
      complexAbs(ℂ[2 * s - 1])] = R[2 * (complexAbs(realCpow(R[2],
      ℂ[2 * s - 1])) * complexAbs(ℂ[2 * s - 1]))] by ring
    rw same
    linarith
  obtain ⟨N2, hN2, after2⟩ := gammaReal.eventually_small with CNonnegative,
    ePositive
  have N1Nat := nat.omega.backward at N1 with hN1
  have N2Nat := nat.omega.backward at N2 with hN2
  have NMember : N1 + N2 ∈ ℕ by typecheck
  refine ⟨N1 + N2, NMember, ?_⟩
  intros n hn le
  have nNat := nat.omega.backward at n with hn
  have le1 : N1 ≤ n by arith
  have le2 : N2 ≤ n by arith
  have small1 := after1 with n, hn, le1
  have small2 := after2 with n, hn, le2
  obtain ⟨gapLower, gapUpper⟩ := gaussDoublingWeight.log_gap at n
  -- W(n) = 2^w e^(w δ) with δ the gap above.
  have deltaMember : complexOfReal(R[realLog(realNat(2 * n + 3)) -
    realLog(realNat(n + 1)) - realLog(R[2])]) ∈ ℂ by typecheck
  have u : ℂ[(2 * s - 1) * complexOfReal(R[realLog(realNat(2 * n + 3)) -
    realLog(realNat(n + 1)) - realLog(R[2])])] ∈ ℂ by typecheck
  have shape : gaussDoublingWeight(s)(n) = ℂ[realCpow(R[2], ℂ[2 * s - 1]) *
      complexExp(ℂ[(2 * s - 1) * complexOfReal(R[realLog(realNat(2 * n + 3)) -
      realLog(realNat(n + 1)) - realLog(R[2])])])]
    rw (gaussDoublingWeight.value with hs, hn)
    unfold realCpow
    have a : ℂ[(2 * s - 1) * complexOfReal(realLog(realNat(2 * n + 3)))] ∈ ℂ
      by typecheck
    have b : ℂ[(1 - 2 * s) * complexOfReal(realLog(realNat(n + 1)))] ∈ ℂ by
      typecheck
    have c : ℂ[(2 * s - 1) * complexOfReal(realLog(R[2]))] ∈ ℂ by typecheck
    rw [← (complexExp.add with a, b), ← (complexExp.add with c, u)]
    rw [complexOfReal.sub, complexOfReal.sub]
    have l3 : complexOfReal(realLog(realNat(2 * n + 3))) ∈ ℂ by typecheck
    have l1 : complexOfReal(realLog(realNat(n + 1))) ∈ ℂ by typecheck
    have l2 : complexOfReal(realLog(R[2])) ∈ ℂ by typecheck
    have same : ℂ[(2 * s - 1) * complexOfReal(realLog(realNat(2 * n + 3))) +
        (1 - 2 * s) * complexOfReal(realLog(realNat(n + 1)))] =
        ℂ[(2 * s - 1) * complexOfReal(realLog(R[2])) + (2 * s - 1) *
        (complexOfReal(realLog(realNat(2 * n + 3))) -
        complexOfReal(realLog(realNat(n + 1))) -
        complexOfReal(realLog(R[2])))] by ring
    rw same
  rw shape
  have expU := complexExp.member with u
  have oneMember := complexOne.member
  have factor : ℂ[complexExp(ℂ[(2 * s - 1) * complexOfReal(R[realLog(realNat(2 *
      n + 3)) - realLog(realNat(n + 1)) - realLog(R[2])])]) - 1] ∈ ℂ by
    typecheck
  have regroup : ℂ[realCpow(R[2], ℂ[2 * s - 1]) * complexExp(ℂ[(2 * s - 1) *
      complexOfReal(R[realLog(realNat(2 * n + 3)) - realLog(realNat(n + 1)) -
      realLog(R[2])])]) - realCpow(R[2], ℂ[2 * s - 1])] =
      ℂ[realCpow(R[2], ℂ[2 * s - 1]) * (complexExp(ℂ[(2 * s - 1) *
      complexOfReal(R[realLog(realNat(2 * n + 3)) - realLog(realNat(n + 1)) -
      realLog(R[2])])]) - 1)] by ring
  rw [regroup, (complexAbs.mul with limitMember, factor)]
  -- |u| ≤ |w|/(n + 1) < 1.
  have uAbs : complexAbs(ℂ[(2 * s - 1) * complexOfReal(R[realLog(realNat(2 * n +
      3)) - realLog(realNat(n + 1)) - realLog(R[2])])]) ≤
      R[complexAbs(ℂ[2 * s - 1]) * (1 / realNat(n + 1))]
    rw [(complexAbs.mul with w, deltaMember), complexAbs.of_real,
      (abs.of_nonnegative with gapLower)]
    exact realLe.mul_left_of_nonnegative with gapUpper, wNonnegative
  have unit : R[complexAbs(ℂ[2 * s - 1]) * (1 / realNat(n + 1))] < R[1] by
    linarith
  have uSmall : complexAbs(ℂ[(2 * s - 1) * complexOfReal(R[realLog(realNat(2 *
      n + 3)) - realLog(realNat(n + 1)) - realLog(R[2])])]) ≤ R[1] by linarith
  have taylor := complexExp.quadratic_estimate with u, uSmall
  have uNonnegative := complexAbs.nonnegative with u
  have square := realLe.mul_left_of_nonnegative with uSmall, uNonnegative
  have taylorMember : ℂ[complexExp(ℂ[(2 * s - 1) *
    complexOfReal(R[realLog(realNat(2 * n + 3)) - realLog(realNat(n + 1)) -
    realLog(R[2])])]) - 1 - (2 * s - 1) * complexOfReal(R[realLog(realNat(2 *
    n + 3)) - realLog(realNat(n + 1)) - realLog(R[2])])] ∈ ℂ by typecheck
  have split : ℂ[complexExp(ℂ[(2 * s - 1) *
      complexOfReal(R[realLog(realNat(2 * n + 3)) - realLog(realNat(n + 1)) -
      realLog(R[2])])]) - 1] = ℂ[(complexExp(ℂ[(2 * s - 1) *
      complexOfReal(R[realLog(realNat(2 * n + 3)) - realLog(realNat(n + 1)) -
      realLog(R[2])])]) - 1 - (2 * s - 1) * complexOfReal(R[realLog(realNat(2 *
      n + 3)) - realLog(realNat(n + 1)) - realLog(R[2])])) + (2 * s - 1) *
      complexOfReal(R[realLog(realNat(2 * n + 3)) - realLog(realNat(n + 1)) -
      realLog(R[2])])] by ring
  have triangle := complexAbs.triangle with taylorMember, u
  rw ← split at triangle
  have unitU : R[complexAbs(ℂ[(2 * s - 1) * complexOfReal(R[realLog(realNat(2 *
      n + 3)) - realLog(realNat(n + 1)) - realLog(R[2])])]) * 1] =
      complexAbs(ℂ[(2 * s - 1) * complexOfReal(R[realLog(realNat(2 * n + 3)) -
      realLog(realNat(n + 1)) - realLog(R[2])])]) by ring
  rw unitU at square
  have factorBound : complexAbs(ℂ[complexExp(ℂ[(2 * s - 1) *
      complexOfReal(R[realLog(realNat(2 * n + 3)) - realLog(realNat(n + 1)) -
      realLog(R[2])])]) - 1]) ≤ R[2 * (complexAbs(ℂ[2 * s - 1]) *
      (1 / realNat(n + 1)))] by linarith
  have final := realLe.mul_left_of_nonnegative with factorBound, pNonnegative
  have regroup2 : R[complexAbs(realCpow(R[2], ℂ[2 * s - 1])) *
      (2 * (complexAbs(ℂ[2 * s - 1]) * (1 / realNat(n + 1))))] =
      R[2 * complexAbs(realCpow(R[2], ℂ[2 * s - 1])) *
      complexAbs(ℂ[2 * s - 1]) * (1 / realNat(n + 1))] by ring
  rw regroup2 at final
  linarith

-- Section: The reciprocal Gamma function
theorem reciprocalGamma.member (s : Set)
  shows reciprocalGamma(s) ∈ ℂ
proof
  obtain ⟨value, _⟩ := reciprocalGamma.selected at s
  exact value

-- Gauss's limit converges for every s.
theorem reciprocalGamma.converges (s : Set)
  requires hs : s ∈ ℂ
  shows ComplexConvergesTo(reciprocalGammaTerms(s), reciprocalGamma(s))
proof
  have limit := reciprocalGammaTerms.converges with hs
  have zero := reciprocalGammaTerms.member at s, (0:N) with hs
  obtain ⟨summable, holomorphic⟩ := gaussDifferences.series
  have seriesMember := holomorphic.right.left with s, hs
  have limitMember : ℂ[reciprocalGammaTerms(s)((0:N)) +
    complexFunctionSeries(gaussDifferences, complexCarrier)(s)] ∈ ℂ by
    typecheck
  obtain ⟨_, property⟩ := reciprocalGamma.selected at s
  cases property with converges | default
  . exact converges
  . obtain ⟨none, _⟩ := default
    exfalso
    exact none with ⟨ℂ[reciprocalGammaTerms(s)((0:N)) +
      complexFunctionSeries(gaussDifferences, complexCarrier)(s)],
      limitMember, limit⟩

-- 1/Γ(s) = u(0) + Σ (u(n + 1) − u(n)).
theorem reciprocalGamma.series (s : Set)
  requires hs : s ∈ ℂ
  shows reciprocalGamma(s) = ℂ[reciprocalGammaTerms(s)((0:N)) +
    complexFunctionSeries(gaussDifferences, complexCarrier)(s)]
proof
  have first := reciprocalGamma.converges with hs
  have second := reciprocalGammaTerms.converges with hs
  exact ComplexConvergesTo.unique with first, second

-- 1/Γ is entire.
theorem reciprocalGamma.holomorphic
  shows HolomorphicOn(reciprocalGammaMap, complexCarrier)
proof
  obtain ⟨_, series⟩ := gaussDifferences.series
  have first := gaussMap.holomorphic at (0:N)
  apply HolomorphicOn.add_formula with first, series
  intros z hz
  rw [(reciprocalGammaMap.value with hz), (gaussMap.value with hz),
    (reciprocalGamma.series with hz)]

-- 1/Γ vanishes exactly at the poles 0, −1, −2, ….
theorem reciprocalGamma.zero_iff (s : Set)
  requires hs : s ∈ ℂ
  shows reciprocalGamma(s) = ℂ[0] ↔ s ∈ gammaPoles
proof
  have limit := reciprocalGamma.converges with hs
  have sequence : ComplexSequence(reciprocalGammaTerms(s)) by
    exact reciprocalGammaTerms.function with hs
  constructor
  . intro zero
    by_contra notPole
    -- Far out, Gauss's sequence stays within a third of |u(N)| of u(N).
    have sNonnegative := complexAbs.nonnegative with hs
    have sReal : complexAbs(s) ∈ ℝ by typecheck
    have sBound : complexAbs(s) ≤ complexAbs(s) by linarith
    have KNonnegative := gaussConstant.nonnegative with sNonnegative
    have KReal : gaussConstant(complexAbs(s)) ∈ ℝ by typecheck
    obtain ⟨N, NNat, big⟩ := Real.below_natural at
      R[4 * gaussConstant(complexAbs(s))]
    have NMember : N ∈ ℕ by typecheck
    have successor : realNat(N + 1) = R[realNat(N) + 1]
      rw [realNat.add, realNat.one]
    have NNonnegative := realNat.zero_le at N
    have NPositive : R[0] < realNat(N + 1) by linarith
    have NNonzero : realNat(N + 1) ≠ R[0] by linarith
    have cancel := realDiv.mul_left at R[1], realNat(N + 1) with NNonzero
    obtain ⟨_, ch, _, _, _⟩ := gaussGap.facts at N
    obtain ⟨cPositive, _, _, _, _⟩ := gaussGap.facts at N
    have hPositive : R[0] < R[1 / realNat(N + 1)] by linarith
    have bigger : R[4 * gaussConstant(complexAbs(s))] < realNat(N + 1) by
      linarith
    have scaled := realLess.mul_right_of_positive with bigger, hPositive
    have small : R[gaussConstant(complexAbs(s)) * (1 / realNat(N + 1))] <
        R[1 / 4]
      have regroup : R[(4 * gaussConstant(complexAbs(s))) *
          (1 / realNat(N + 1))] = R[4 * (gaussConstant(complexAbs(s)) *
          (1 / realNat(N + 1)))] by ring
      rw [regroup, cancel] at scaled
      linarith
    have quarter : R[0] ≤ R[1 / 4] by linarith
    have quarterBelow : R[1 / 4] < R[1] by linarith
    have geometric := realExp.geometric_bound with quarter, quarterBelow
    have expQuarter := realExp.positive at R[1 / 4]
    have expand : R[(1 - 1 / 4) * realExp(R[1 / 4])] =
      R[3 * realExp(R[1 / 4]) / 4] by ring
    rw expand at geometric
    have quarterBound : realExp(R[1 / 4]) ≤ R[4 / 3] by linarith
    have values : ∀ m ∈ ℕ, reciprocalGammaTerms(s)(m) ∈ ℂ
      intros m hm
      have mNat := nat.omega.backward at m with hm
      exact reciprocalGammaTerms.member at s, m with hs
    have step : ∀ m ∈ ℕ, complexAbs(ℂ[reciprocalGammaTerms(s)(m + 1) -
        reciprocalGammaTerms(s)(m)]) ≤
        R[complexAbs(reciprocalGammaTerms(s)(m)) *
        (gaussConstant(complexAbs(s)) * (1 / realNat(m + 1) -
          1 / realNat(m + 2)))]
      intros m hm
      have mNat := nat.omega.backward at m with hm
      exact reciprocalGammaTerms.step_bound at s, complexAbs(s), m with hs,
        sBound
    have uN := reciprocalGammaTerms.member at s, N with hs
    have uNNonnegative := complexAbs.nonnegative with uN
    have bound : ∀ n ∈ ℕ, N ≤ n → complexAbs(ℂ[reciprocalGammaTerms(s)(n) -
        reciprocalGammaTerms(s)(N)]) ≤
        R[complexAbs(reciprocalGammaTerms(s)(N)) * (1 / 3)]
      intros n hn le
      have nNat := nat.omega.backward at n with hn
      have back := sub.add_of_le with le
      have spread := gaussSequence.propagate at reciprocalGammaTerms(s),
        gaussConstant(complexAbs(s)), N, n - N with values, KNonnegative, step
      rw back at spread
      obtain ⟨_, _, _, _, _⟩ := gaussGap.facts at n
      obtain ⟨lastPositive, lastCh, _, _, _⟩ := gaussGap.facts at n
      have lastNonnegative : R[0] ≤ R[1 / realNat(n + 1)] by linarith
      have tail := realMulValue.nonnegative with KNonnegative, lastNonnegative
      have exponent : R[gaussConstant(complexAbs(s)) * (1 / realNat(N + 1) -
          1 / realNat(n + 1))] ≤ R[1 / 4]
        have same : R[gaussConstant(complexAbs(s)) * (1 / realNat(N + 1) -
            1 / realNat(n + 1))] = R[gaussConstant(complexAbs(s)) *
            (1 / realNat(N + 1)) - gaussConstant(complexAbs(s)) *
            (1 / realNat(n + 1))] by ring
        rw same
        linarith
      have monotone := (realExp.le_iff at R[gaussConstant(complexAbs(s)) *
        (1 / realNat(N + 1) - 1 / realNat(n + 1))], R[1 / 4]).backward with
        exponent
      have third : R[realExp(R[gaussConstant(complexAbs(s)) *
          (1 / realNat(N + 1) - 1 / realNat(n + 1))]) - 1] ≤ R[1 / 3] by
        linarith
      have scaledThird := realLe.mul_left_of_nonnegative with third,
        uNNonnegative
      linarith
    have estimate := ComplexConvergesTo.abs_le with limit, uN, bound
    rw zero at estimate
    have flip : ℂ[0 - reciprocalGammaTerms(s)(N)] =
      ℂ[-reciprocalGammaTerms(s)(N)] by ring
    rw [flip, (complexAbs.neg with uN)] at estimate
    have nonzero := reciprocalGammaTerms.nonzero at s, N with hs, notPole
    have positive := complexAbs.positive with uN, nonzero
    have absReal : complexAbs(reciprocalGammaTerms(s)(N)) ∈ ℝ by typecheck
    have third : R[complexAbs(reciprocalGammaTerms(s)(N)) * (1 / 3)] =
      R[complexAbs(reciprocalGammaTerms(s)(N)) / 3] by ring
    rw third at estimate
    have contradiction : complexAbs(reciprocalGammaTerms(s)(N)) ≤ R[0] by
      linarith
    linarith
  . intro pole
    obtain ⟨_, k, hk, shape⟩ := gammaPoles.membership.forward with pole
    have kNat := nat.omega.backward at k with hk
    have zeroMember : ℂ[0] ∈ ℂ by typecheck
    have toZero : ComplexConvergesTo(reciprocalGammaTerms(s), ℂ[0])
      apply (ComplexConvergesTo.iff_abs with sequence, zeroMember).backward
      intros e he ePositive
      refine ⟨k, hk, ?_⟩
      intros n hn le
      have nNat := nat.omega.backward at n with hn
      have large : k < n + 2 by arith
      have vanish := risingFactorial.neg_nat at k, n + 2 with large
      rw [(reciprocalGammaTerms.value with hs, hn), shape, vanish]
      have negative : ℂ[-(-complexOfReal(realNat(k)))] ∈ ℂ by typecheck
      have power := realCpow.member at realNat(n + 1),
        ℂ[-(-complexOfReal(realNat(k)))] with negative
      have coefficient : complexOfReal(R[1 / realNat((n + 1)!)]) ∈ ℂ by
        typecheck
      have collapse : ℂ[realCpow(realNat(n + 1),
          ℂ[-(-complexOfReal(realNat(k)))]) * 0 *
          complexOfReal(R[1 / realNat((n + 1)!)]) - 0] = ℂ[0] by ring
      rw [collapse, complexAbs.zero]
      exact ePositive
    exact ComplexConvergesTo.unique with limit, toZero

-- 1/Γ(s) = s · 1/Γ(s + 1), everywhere.
theorem reciprocalGamma.succ (s : Set)
  requires hs : s ∈ ℂ
  shows reciprocalGamma(s) = ℂ[s * reciprocalGamma(s + 1)]
proof
  have shifted : ℂ[s + 1] ∈ ℂ by typecheck
  have limitS := reciprocalGamma.converges with hs
  have limitT := reciprocalGamma.converges with shifted
  have sequenceS : ComplexSequence(reciprocalGammaTerms(s)) by
    exact reciprocalGammaTerms.function with hs
  have sequenceT : ComplexSequence(reciprocalGammaTerms(ℂ[s + 1])) by
    exact reciprocalGammaTerms.function with shifted
  have L := reciprocalGamma.member at s
  have L1 := reciprocalGamma.member at ℂ[s + 1]
  have closeS := (ComplexConvergesTo.iff_abs with sequenceS, L).forward with
    limitS
  have closeT := (ComplexConvergesTo.iff_abs with sequenceT, L1).forward with
    limitT
  by_contra different
  have diffMember : ℂ[reciprocalGamma(s) - s * reciprocalGamma(ℂ[s + 1])] ∈ ℂ
    by typecheck
  have nonzero : ℂ[reciprocalGamma(s) - s * reciprocalGamma(ℂ[s + 1])] ≠ ℂ[0]
    intro zero
    apply different
    have same : reciprocalGamma(s) = ℂ[(reciprocalGamma(s) -
      s * reciprocalGamma(ℂ[s + 1])) + s * reciprocalGamma(ℂ[s + 1])] by ring
    rw [same, zero]
    ring
  have dPositive := complexAbs.positive with diffMember, nonzero
  have dReal : complexAbs(ℂ[reciprocalGamma(s) - s * reciprocalGamma(ℂ[s +
    1])]) ∈ ℝ by typecheck
  have thirdPositive : R[0] < R[complexAbs(ℂ[reciprocalGamma(s) -
    s * reciprocalGamma(ℂ[s + 1])]) / 3] by linarith
  have thirdReal : R[complexAbs(ℂ[reciprocalGamma(s) -
    s * reciprocalGamma(ℂ[s + 1])]) / 3] ∈ ℝ by typecheck
  obtain ⟨N1, hN1, after1⟩ := closeS with R[complexAbs(ℂ[reciprocalGamma(s) -
    s * reciprocalGamma(ℂ[s + 1])]) / 3], thirdReal, thirdPositive
  -- |s| |u_(s+1)(n) − 1/Γ(s + 1)| < d/3 eventually.
  have sNonnegative := complexAbs.nonnegative with hs
  have sReal : complexAbs(s) ∈ ℝ by typecheck
  have sPlusPositive : R[0] < R[complexAbs(s) + 1] by linarith
  have sPlusNonzero : R[complexAbs(s) + 1] ≠ R[0] by linarith
  have inverse := realInvValue.positive with sPlusPositive
  have cancel := realInvValue.mul_right with sPlusNonzero
  have epsPositive := realMulValue.positive with thirdPositive, inverse
  have epsReal : R[(complexAbs(ℂ[reciprocalGamma(s) -
    s * reciprocalGamma(ℂ[s + 1])]) / 3) *
    realInvValue(R[complexAbs(s) + 1])] ∈ ℝ by typecheck
  obtain ⟨N2, hN2, after2⟩ := closeT with R[(complexAbs(ℂ[reciprocalGamma(s) -
    s * reciprocalGamma(ℂ[s + 1])]) / 3) *
    realInvValue(R[complexAbs(s) + 1])], epsReal, epsPositive
  -- The correction u_s(n) (s + 1)/(n + 1) is eventually below d/3.
  have sBound : complexAbs(s) ≤ complexAbs(s) by linarith
  have BNonnegative : R[0] ≤ R[complexAbs(s) * (complexAbs(s) + 1) *
      realExp(gaussConstant(complexAbs(s)))]
    have expPositive := realExp.positive at gaussConstant(complexAbs(s))
    have sPlus : R[0] ≤ R[complexAbs(s) + 1] by linarith
    have first := realMulValue.nonnegative with sNonnegative, sPlus
    have expNonnegative : R[0] ≤ realExp(gaussConstant(complexAbs(s))) by
      linarith
    exact realMulValue.nonnegative with first, expNonnegative
  have shiftNonnegative := complexAbs.nonnegative with shifted
  have CNonnegative := realMulValue.nonnegative with BNonnegative,
    shiftNonnegative
  obtain ⟨N3, hN3, after3⟩ := gammaReal.eventually_small at
    R[complexAbs(s) * (complexAbs(s) + 1) *
      realExp(gaussConstant(complexAbs(s))) * complexAbs(ℂ[s + 1])],
    R[complexAbs(ℂ[reciprocalGamma(s) - s * reciprocalGamma(ℂ[s + 1])]) / 3]
    with CNonnegative, thirdPositive
  have N1Nat := nat.omega.backward at N1 with hN1
  have N2Nat := nat.omega.backward at N2 with hN2
  have N3Nat := nat.omega.backward at N3 with hN3
  have nMember : N1 + N2 + N3 ∈ ℕ by typecheck
  have le1 : N1 ≤ N1 + N2 + N3 by arith
  have le2 : N2 ≤ N1 + N2 + N3 by arith
  have le3 : N3 ≤ N1 + N2 + N3 by arith
  have near1 := after1 with N1 + N2 + N3, nMember, le1
  have near2 := after2 with N1 + N2 + N3, nMember, le2
  have near3 := after3 with N1 + N2 + N3, nMember, le3
  have identity := reciprocalGammaTerms.shift at s, N1 + N2 + N3 with hs
  have u := reciprocalGammaTerms.member at s, N1 + N2 + N3 with hs
  have v := reciprocalGammaTerms.member at ℂ[s + 1], N1 + N2 + N3 with shifted
  have Q : complexOfReal(R[1 / realNat(N1 + N2 + N3 + 1)]) ∈ ℂ by typecheck
  have A : ℂ[reciprocalGamma(s) - reciprocalGammaTerms(s)(N1 + N2 + N3)] ∈ ℂ
    by typecheck
  have Bt : ℂ[-(reciprocalGammaTerms(s)(N1 + N2 + N3) *
    ((s + 1) * complexOfReal(R[1 / realNat(N1 + N2 + N3 + 1)])))] ∈ ℂ by
    typecheck
  have Ct : ℂ[s * (reciprocalGammaTerms(ℂ[s + 1])(N1 + N2 + N3) -
    reciprocalGamma(ℂ[s + 1]))] ∈ ℂ by typecheck
  have split : ℂ[reciprocalGamma(s) - s * reciprocalGamma(ℂ[s + 1])] =
      ℂ[(reciprocalGamma(s) - reciprocalGammaTerms(s)(N1 + N2 + N3)) +
      -(reciprocalGammaTerms(s)(N1 + N2 + N3) *
        ((s + 1) * complexOfReal(R[1 / realNat(N1 + N2 + N3 + 1)]))) +
      s * (reciprocalGammaTerms(ℂ[s + 1])(N1 + N2 + N3) -
        reciprocalGamma(ℂ[s + 1]))] by
    linear_combination (-1) * identity
  have AB : ℂ[(reciprocalGamma(s) - reciprocalGammaTerms(s)(N1 + N2 + N3)) +
    -(reciprocalGammaTerms(s)(N1 + N2 + N3) *
      ((s + 1) * complexOfReal(R[1 / realNat(N1 + N2 + N3 + 1)])))] ∈ ℂ by
    typecheck
  have triangle1 := complexAbs.triangle with AB, Ct
  have triangle2 := complexAbs.triangle with A, Bt
  rw ← split at triangle1
  -- The three pieces.
  have symmetric := complexAbs.dist_symm with L, u
  have productMember : ℂ[reciprocalGammaTerms(s)(N1 + N2 + N3) *
    ((s + 1) * complexOfReal(R[1 / realNat(N1 + N2 + N3 + 1)]))] ∈ ℂ by
    typecheck
  have factorMember : ℂ[(s + 1) * complexOfReal(R[1 / realNat(N1 + N2 + N3 +
    1)])] ∈ ℂ by typecheck
  obtain ⟨_, ch, _, _, _⟩ := gaussGap.facts at N1 + N2 + N3
  obtain ⟨cPositive, _, _, _, _⟩ := gaussGap.facts at N1 + N2 + N3
  have hNonnegative : R[0] ≤ R[1 / realNat(N1 + N2 + N3 + 1)] by linarith
  have middle : complexAbs(ℂ[-(reciprocalGammaTerms(s)(N1 + N2 + N3) *
      ((s + 1) * complexOfReal(R[1 / realNat(N1 + N2 + N3 + 1)])))]) ≤
      R[complexAbs(s) * (complexAbs(s) + 1) *
      realExp(gaussConstant(complexAbs(s))) * complexAbs(ℂ[s + 1]) *
      (1 / realNat(N1 + N2 + N3 + 1))]
    rw [(complexAbs.neg with productMember), (complexAbs.mul with u,
      factorMember), (complexAbs.mul with shifted, Q), complexAbs.of_real,
      (abs.of_nonnegative with hNonnegative)]
    have termBound := reciprocalGammaTerms.bound at s, complexAbs(s),
      N1 + N2 + N3 with hs, sBound
    have uNonnegative := complexAbs.nonnegative with u
    have factorNonnegative := realMulValue.nonnegative with shiftNonnegative,
      hNonnegative
    have scaled := gammaReal.mul_le with uNonnegative, termBound,
      factorNonnegative, (realLe.reflexive at R[complexAbs(ℂ[s + 1]) *
      (1 / realNat(N1 + N2 + N3 + 1))])
    have regroup : R[(complexAbs(s) * (complexAbs(s) + 1) *
        realExp(gaussConstant(complexAbs(s)))) * (complexAbs(ℂ[s + 1]) *
        (1 / realNat(N1 + N2 + N3 + 1)))] = R[complexAbs(s) *
        (complexAbs(s) + 1) * realExp(gaussConstant(complexAbs(s))) *
        complexAbs(ℂ[s + 1]) * (1 / realNat(N1 + N2 + N3 + 1))] by ring
    rw regroup at scaled
    exact scaled
  have vDifference : ℂ[reciprocalGammaTerms(ℂ[s + 1])(N1 + N2 + N3) -
    reciprocalGamma(ℂ[s + 1])] ∈ ℂ by typecheck
  have last : complexAbs(ℂ[s * (reciprocalGammaTerms(ℂ[s + 1])(N1 + N2 + N3) -
      reciprocalGamma(ℂ[s + 1]))]) <
      R[complexAbs(ℂ[reciprocalGamma(s) - s * reciprocalGamma(ℂ[s + 1])]) / 3]
    rw (complexAbs.mul with hs, vDifference)
    have vNonnegative := complexAbs.nonnegative with vDifference
    have sBelow : complexAbs(s) ≤ R[complexAbs(s) + 1] by linarith
    have widened := realLe.mul_right_of_nonnegative with sBelow, vNonnegative
    have strict := realLess.mul_left_of_positive with near2, sPlusPositive
    have collapse : R[(complexAbs(s) + 1) * ((complexAbs(ℂ[reciprocalGamma(s) -
        s * reciprocalGamma(ℂ[s + 1])]) / 3) *
        realInvValue(R[complexAbs(s) + 1]))] =
        R[(complexAbs(ℂ[reciprocalGamma(s) - s * reciprocalGamma(ℂ[s + 1])]) /
        3) * ((complexAbs(s) + 1) * realInvValue(R[complexAbs(s) + 1]))] by ring
    rw [collapse, cancel] at strict
    have unit : R[(complexAbs(ℂ[reciprocalGamma(s) - s * reciprocalGamma(ℂ[s +
        1])]) / 3) * 1] = R[complexAbs(ℂ[reciprocalGamma(s) -
        s * reciprocalGamma(ℂ[s + 1])]) / 3] by ring
    rw unit at strict
    linarith
  linarith

theorem reciprocalGamma.one
  shows reciprocalGamma(ℂ[1]) = ℂ[1]
proof
  have oneMember := complexOne.member
  have limit := reciprocalGamma.converges with oneMember
  have sequence : ComplexSequence(reciprocalGammaTerms(ℂ[1])) by
    exact reciprocalGammaTerms.function with oneMember
  have toOne : ComplexConvergesTo(reciprocalGammaTerms(ℂ[1]), ℂ[1])
    apply (ComplexConvergesTo.iff_abs with sequence, oneMember).backward
    intros e he ePositive
    have oneNonnegative : R[0] ≤ R[1] by linarith
    obtain ⟨N, hN, after⟩ := gammaReal.eventually_small with oneNonnegative,
      ePositive
    refine ⟨N, hN, ?_⟩
    intros n hn le
    have nNat := nat.omega.backward at n with hn
    have small := after with n, hn, le
    -- u_1(n) = (1/(n + 1)) (n + 2)!/(n + 1)! = 1 + 1/(n + 1).
    have atLeast : (1:N) ≤ n + 1 by arith
    have power := realCpow.nat_neg_nat at 1, n + 1 with atLeast
    rw [realNat.one, complexOfReal.one] at power
    have pow1 : R[realNat(n + 1) ^ 1] = realNat(n + 1) by ring
    rw pow1 at power
    have e1 : n + 2 = n + 1 + 1 by arith
    have fact := realNat.factorial_succ at n + 1
    have zeroLe := realNat.zero_le at n
    have successor : realNat(n + 1) = R[realNat(n) + 1]
      rw [realNat.add, realNat.one]
    have mNonzero : realNat(n + 1) ≠ R[0] by linarith
    have factorialPositive := realNat.factorial_pos at n + 1
    have factorialNonzero : realNat((n + 1)!) ≠ R[0] by linarith
    have cancelM := realDiv.mul_left at R[1], realNat(n + 1) with mNonzero
    have cancelF := realDiv.mul_left at R[1], realNat((n + 1)!) with
      factorialNonzero
    have value : reciprocalGammaTerms(ℂ[1])(n) =
        complexOfReal(R[1 + 1 / realNat(n + 1)])
      rw [(reciprocalGammaTerms.value with oneMember, hn), power,
        risingFactorial.one, e1, fact, ← complexOfReal.mul,
        ← complexOfReal.mul]
      have realValue : R[(1 / realNat(n + 1)) * ((realNat(n + 1) + 1) *
          realNat((n + 1)!)) * (1 / realNat((n + 1)!))] =
          R[1 + 1 / realNat(n + 1)]
        have regroup : R[(1 / realNat(n + 1)) * ((realNat(n + 1) + 1) *
            realNat((n + 1)!)) * (1 / realNat((n + 1)!))] =
            R[(realNat(n + 1) * (1 / realNat(n + 1)) + 1 / realNat(n + 1)) *
            (realNat((n + 1)!) * (1 / realNat((n + 1)!)))] by ring
        rw [regroup, cancelM, cancelF]
        ring
      rw realValue
    obtain ⟨_, ch, _, _, _⟩ := gaussGap.facts at n
    obtain ⟨cPositive, _, _, _, _⟩ := gaussGap.facts at n
    have hNonnegative : R[0] ≤ R[1 / realNat(n + 1)] by linarith
    have difference : ℂ[complexOfReal(R[1 + 1 / realNat(n + 1)]) - 1] =
        complexOfReal(R[1 / realNat(n + 1)])
      rw [complexOfReal.add, complexOfReal.one]
      have cast : complexOfReal(R[1 / realNat(n + 1)]) ∈ ℂ by typecheck
      ring
    rw [value, difference, complexAbs.of_real, (abs.of_nonnegative with
      hNonnegative)]
    have unit : R[1 * (1 / realNat(n + 1))] = R[1 / realNat(n + 1)] by ring
    rw unit at small
    exact small
  exact ComplexConvergesTo.unique with limit, toOne

-- π (1/Γ(1/2))² = 1, by Wallis's squeeze.
theorem reciprocalGamma.half_square
  shows ℂ[complexOfReal(realPi) * reciprocalGamma(complexOfReal(R[1 / 2])) *
    reciprocalGamma(complexOfReal(R[1 / 2]))] = ℂ[1]
proof
  have hf : complexOfReal(R[1 / 2]) ∈ ℂ by typecheck
  have limit := reciprocalGamma.converges with hf
  have sequence : ComplexSequence(reciprocalGammaTerms(complexOfReal(R[1 / 2])))
    by exact reciprocalGammaTerms.function with hf
  have r := reciprocalGamma.member at complexOfReal(R[1 / 2])
  have piMember : complexOfReal(realPi) ∈ ℂ by typecheck
  have close := (ComplexConvergesTo.iff_abs with sequence, r).forward with
    limit
  apply complex.eq_of_approx with r, piMember
  intros e he ePositive
  obtain ⟨N1, hN1, after1⟩ := close with e, he, ePositive
  have halfPositive := realHalfPi.positive
  have fourH : R[0] ≤ R[4 * realHalfPi] by linarith
  obtain ⟨N2, hN2, after2⟩ := gammaReal.eventually_small with fourH,
    ePositive
  have N1Nat := nat.omega.backward at N1 with hN1
  have N2Nat := nat.omega.backward at N2 with hN2
  have nMember : N1 + N2 ∈ ℕ by typecheck
  have le1 : N1 ≤ N1 + N2 by arith
  have le2 : N2 ≤ N1 + N2 by arith
  have near := after1 with N1 + N2, nMember, le1
  have small := after2 with N1 + N2, nMember, le2
  have product := reciprocalGammaTerms.half_square at N1 + N2
  have g := reciprocalGammaTerms.member at complexOfReal(R[1 / 2]), N1 + N2
    with hf
  have XMember : ℂ[4 * complexOfReal(realNat(N1 + N2 + 1)) *
    complexOfReal(wallisIntegral(2 * (N1 + N2 + 1) + 1)) *
    complexOfReal(wallisIntegral(2 * (N1 + N2 + 1) + 1))] ∈ ℂ by typecheck
  refine ⟨reciprocalGammaTerms(complexOfReal(R[1 / 2]))(N1 + N2), g,
    ℂ[4 * complexOfReal(realNat(N1 + N2 + 1)) *
    complexOfReal(wallisIntegral(2 * (N1 + N2 + 1) + 1)) *
    complexOfReal(wallisIntegral(2 * (N1 + N2 + 1) + 1))], XMember, ?_, near,
    ?_⟩
  . have regroup : ℂ[reciprocalGammaTerms(complexOfReal(R[1 / 2]))(N1 + N2) *
        reciprocalGammaTerms(complexOfReal(R[1 / 2]))(N1 + N2) *
        (4 * complexOfReal(realNat(N1 + N2 + 1)) *
        complexOfReal(wallisIntegral(2 * (N1 + N2 + 1) + 1)) *
        complexOfReal(wallisIntegral(2 * (N1 + N2 + 1) + 1)))] =
        ℂ[reciprocalGammaTerms(complexOfReal(R[1 / 2]))(N1 + N2) *
        reciprocalGammaTerms(complexOfReal(R[1 / 2]))(N1 + N2) *
        (4 * complexOfReal(realNat(N1 + N2 + 1)) *
        complexOfReal(wallisIntegral(2 * (N1 + N2 + 1) + 1)) *
        complexOfReal(wallisIntegral(2 * (N1 + N2 + 1) + 1)))] by rfl
    exact product
  . -- The squeeze at n = N1 + N2.
    have a := realNat.zero_le at N1 + N2
    have e1 : succ(2 * (N1 + N2) + 2) = 2 * (N1 + N2 + 1) + 1 by arith
    have e2 : succ(2 * (N1 + N2) + 1) = 2 * (N1 + N2) + 2 by arith
    have e3 : succ(succ(2 * (N1 + N2) + 1)) = 2 * (N1 + N2 + 1) + 1 by arith
    obtain ⟨JE, _⟩ := wallisIntegral.antitone at 2 * (N1 + N2) + 2
    obtain ⟨EO, _⟩ := wallisIntegral.antitone at 2 * (N1 + N2) + 1
    obtain ⟨_, JNonnegative⟩ := wallisIntegral.antitone at
      2 * (N1 + N2 + 1) + 1
    rw e1 at JE
    rw e2 at EO
    have step := wallisIntegral.step at 2 * (N1 + N2) + 1
    rw e3 at step
    have pairProduct := wallisIntegral.product at 2 * (N1 + N2) + 2
    rw e1 at pairProduct
    have odd : realNat(2 * (N1 + N2) + 1) = R[2 * realNat(N1 + N2) + 1]
      rw [realNat.add, realNat.mul, realNat.two, realNat.one]
    have even : realNat(2 * (N1 + N2) + 2) = R[2 * realNat(N1 + N2) + 2]
      rw [realNat.add, realNat.mul, realNat.two]
    rw odd at step
    rw even at pairProduct
    have stepEq : R[(2 * realNat(N1 + N2) + 3) *
        wallisIntegral(2 * (N1 + N2 + 1) + 1)] = R[(2 * realNat(N1 + N2) + 2)
        * wallisIntegral(2 * (N1 + N2) + 1)]
      have i0 : wallisIntegral(2 * (N1 + N2) + 1) ∈ ℝ by typecheck
      have i2 : wallisIntegral(2 * (N1 + N2 + 1) + 1) ∈ ℝ by typecheck
      linear_combination step
    have productEq : R[(2 * realNat(N1 + N2) + 3) *
        wallisIntegral(2 * (N1 + N2) + 2) *
        wallisIntegral(2 * (N1 + N2 + 1) + 1)] = realHalfPi
      have i1 : wallisIntegral(2 * (N1 + N2) + 2) ∈ ℝ by typecheck
      have i2 : wallisIntegral(2 * (N1 + N2 + 1) + 1) ∈ ℝ by typecheck
      linear_combination pairProduct
    have successor : realNat(N1 + N2 + 1) = R[realNat(N1 + N2) + 1]
      rw [realNat.add, realNat.one]
    obtain ⟨hPositive, ch, _, _, _⟩ := gaussGap.facts at N1 + N2
    have hNonnegative : R[0] ≤ R[1 / realNat(N1 + N2 + 1)] by linarith
    have mNonzero : realNat(N1 + N2 + 1) ≠ R[0] by linarith
    have hFact0 := realDiv.mul_left at R[1], realNat(N1 + N2 + 1) with mNonzero
    have hFact : R[(realNat(N1 + N2) + 1) * (1 / realNat(N1 + N2 + 1))] = R[1]
      rw ← successor
      exact hFact0
    obtain ⟨lower, upper⟩ := wallis.squeeze with a, JNonnegative, JE, EO,
      stepEq, productEq, hNonnegative, hFact
    -- |π − X| = 2 (π/2) − 4 (n + 1) J².
    have cast : ℂ[complexOfReal(realPi) - 4 * complexOfReal(realNat(N1 + N2 +
        1)) * complexOfReal(wallisIntegral(2 * (N1 + N2 + 1) + 1)) *
        complexOfReal(wallisIntegral(2 * (N1 + N2 + 1) + 1))] =
        complexOfReal(R[2 * realHalfPi - 4 * (realNat(N1 + N2) + 1) *
        wallisIntegral(2 * (N1 + N2 + 1) + 1) *
        wallisIntegral(2 * (N1 + N2 + 1) + 1)])
      unfold realPi
      rw [successor, complexOfReal.sub, complexOfReal.mul, complexOfReal.mul,
        complexOfReal.mul, complexOfReal.mul, complexOfReal.four]
    rw [cast, complexAbs.of_real, (abs.of_nonnegative with lower)]
    have unit : R[4 * realHalfPi * (1 / realNat(N1 + N2 + 1))] =
      R[4 * realHalfPi * (1 / realNat(N1 + N2 + 1))] by rfl
    linarith

-- Section: The Gamma function
theorem Gamma.member (s : Set)
  shows Gamma(s) ∈ ℂ
proof
  unfold Gamma
  have value := reciprocalGamma.member at s
  exact complexInv.member with value

-- Γ has no zeros.
theorem Gamma.nonzero (s : Set)
  requires hs : s ∈ gammaDomain
  shows Gamma(s) ≠ ℂ[0]
proof
  have inDomain := hs
  unfold gammaDomain at inDomain
  have sMember := inDomain.left
  have notPole := inDomain.right
  have value := reciprocalGamma.member at s
  have nonzero : reciprocalGamma(s) ≠ ℂ[0]
    intro zero
    have pole := (reciprocalGamma.zero_iff with sMember).forward with zero
    exact notPole with pole
  unfold Gamma
  exact complexInv.nonzero with value, nonzero

theorem Gamma.mul_reciprocal (s : Set)
  requires hs : s ∈ gammaDomain
  shows ℂ[Gamma(s) * reciprocalGamma(s)] = ℂ[1]
proof
  have inDomain := hs
  unfold gammaDomain at inDomain
  have sMember := inDomain.left
  have notPole := inDomain.right
  have value := reciprocalGamma.member at s
  have nonzero : reciprocalGamma(s) ≠ ℂ[0]
    intro zero
    have pole := (reciprocalGamma.zero_iff with sMember).forward with zero
    exact notPole with pole
  have cancel := complexInv.mul_cancel with value, nonzero
  have inverse := complexInv.member with value
  unfold Gamma
  linear_combination cancel

-- Γ is holomorphic off its poles.
theorem Gamma.holomorphic
  shows HolomorphicOn(GammaMap, gammaDomain)
proof
  have isOpen := gammaDomain.open
  have inside := gammaDomain.subset
  have whole := reciprocalGamma.holomorphic
  have restricted := HolomorphicOn.mono with whole, isOpen, inside
  have one := complexOne.member
  have constant := HolomorphicOn.const with isOpen, one
  have nonvanishing : ∀ z ∈ gammaDomain, reciprocalGammaMap(z) ≠ ℂ[0]
    intros z hz
    have zMember := inside with z, hz
    rw (reciprocalGammaMap.value with zMember)
    have notPole : ¬(z ∈ gammaPoles)
      unfold gammaDomain at hz
      exact hz.right
    intro zero
    exact notPole with ((reciprocalGamma.zero_iff with zMember).forward with
      zero)
  have quotient := HolomorphicOn.div with constant, restricted, nonvanishing
  obtain ⟨_, valuesConstant, _⟩ := constant
  obtain ⟨_, valuesRestricted, _⟩ := restricted
  apply HolomorphicOn.congr with quotient
  intros z hz
  have zMember := inside with z, hz
  have value := reciprocalGamma.member at z
  have inverse := complexInv.member with value
  rw [(complexFunctionDiv.value with valuesConstant, valuesRestricted, hz),
    (complexFunctionConst.value with one, hz),
    (reciprocalGammaMap.value with zMember), (GammaMap.value with hz)]
  unfold Gamma
  unfold complexDiv
  ring

-- Γ(s + 1) = sΓ(s).
theorem Gamma.succ (s : Set)
  requires hs : s ∈ gammaDomain
  shows Gamma(ℂ[s + 1]) = ℂ[s * Gamma(s)]
proof
  have inDomain := hs
  unfold gammaDomain at inDomain
  have sMember := inDomain.left
  have notPole := inDomain.right
  have value := reciprocalGamma.member at s
  have nonzero : reciprocalGamma(s) ≠ ℂ[0]
    intro zero
    exact notPole with ((reciprocalGamma.zero_iff with sMember).forward with
      zero)
  have shift := reciprocalGamma.succ with sMember
  have shifted : ℂ[s + 1] ∈ ℂ by typecheck
  have valueShifted := reciprocalGamma.member at ℂ[s + 1]
  have cancel := complexInv.mul_cancel with value, nonzero
  have inverse := complexInv.member with value
  have product : ℂ[reciprocalGamma(ℂ[s + 1]) * (s * complexInv(reciprocalGamma(s)))]
      = ℂ[1]
    have regroup : ℂ[reciprocalGamma(ℂ[s + 1]) * (s *
        complexInv(reciprocalGamma(s)))] = ℂ[(s * reciprocalGamma(ℂ[s + 1])) *
        complexInv(reciprocalGamma(s))] by ring
    rw [regroup, ← shift, cancel]
  have target : ℂ[s * complexInv(reciprocalGamma(s))] ∈ ℂ by typecheck
  unfold Gamma
  exact GRH.Trig.complexInv.unique with valueShifted, target, product

theorem Gamma.one
  shows Gamma(ℂ[1]) = ℂ[1]
proof
  have one := reciprocalGamma.one
  have oneMember := complexOne.member
  have product : ℂ[1 * 1] = ℂ[1] by ring
  unfold Gamma
  rw one
  exact GRH.Trig.complexInv.unique with oneMember, oneMember, product

-- Γ(n + 1) = n!.
theorem Gamma.nat (n : Nat)
  shows Gamma(complexOfReal(realNat(n + 1))) =
    complexOfReal(realNat(factorial(n)))
proof
  induction n
  | zero =>
    have e1 : (0:N) + 1 = (1:N) by arith
    have fact0 : realNat((0:N)!) = R[1]
      rw factorial
      rw ← natural.one_succ
      exact realNat.one
    rw [e1, realNat.one, complexOfReal.one, fact0, complexOfReal.one]
    exact Gamma.one
  | succ(k) using ih =>
    have e1 := add.right_one at k
    have cast : complexOfReal(realNat(k + 1)) ∈ ℂ by typecheck
    have positive := realNat.successor_positive at k
    have successor : realNat(k + 1) = R[realNat(k) + 1]
      rw [realNat.add, realNat.one]
    have re : complexRe(complexOfReal(realNat(k + 1))) = realNat(k + 1) by
      rw complexOfReal.re
    have rePositive : realZero < complexRe(complexOfReal(realNat(k + 1)))
      rw re
      linarith
    have inDomain := gammaDomain.of_re_positive with cast, rePositive
    have step := Gamma.succ with inDomain
    have shift : complexOfReal(realNat(succ(k) + 1)) =
        ℂ[complexOfReal(realNat(k + 1)) + 1]
      rw [← e1, realNat.add, realNat.one, complexOfReal.add, complexOfReal.one]
    have fact := realNat.factorial_succ at k
    rw [shift, step, ← e1, ih, fact, complexOfReal.mul, successor,
      complexOfReal.add, complexOfReal.one]

-- Γ(1/2) = √π, so Γ(1/2)² = π.
theorem Gamma.half
  shows Gamma(complexOfReal(R[1 / 2])) = complexOfReal(realSqrt(realPi))
proof
  have hf : complexOfReal(R[1 / 2]) ∈ ℂ by typecheck
  have hs := reciprocalGamma.half_square
  have r := reciprocalGamma.member at complexOfReal(R[1 / 2])
  have piMember : complexOfReal(realPi) ∈ ℂ by typecheck
  have piPositive := realPi.positive
  have xReal := complexRe.real with r
  have yReal := complexIm.real with r
  -- Real and imaginary parts of π r² = 1.
  have product : ℂ[complexOfReal(realPi) * reciprocalGamma(complexOfReal(R[1 /
    2]))] ∈ ℂ by typecheck
  have reEq : complexRe(ℂ[complexOfReal(realPi) *
      reciprocalGamma(complexOfReal(R[1 / 2])) *
      reciprocalGamma(complexOfReal(R[1 / 2]))]) = complexRe(ℂ[1]) by rw hs
  have imEq : complexIm(ℂ[complexOfReal(realPi) *
      reciprocalGamma(complexOfReal(R[1 / 2])) *
      reciprocalGamma(complexOfReal(R[1 / 2]))]) = complexIm(ℂ[1]) by rw hs
  rw [(complexRe.mul with product, r), (complexRe.mul with piMember, r),
    (complexIm.mul with piMember, r), complexOfReal.re, complexOfReal.im,
    ← complexOfReal.one, complexOfReal.re] at reEq
  rw [(complexIm.mul with product, r), (complexRe.mul with piMember, r),
    (complexIm.mul with piMember, r), complexOfReal.re, complexOfReal.im,
    ← complexOfReal.one, complexOfReal.im] at imEq
  have twoPi : R[0] < R[2 * realPi] by linarith
  have xyProduct : R[(2 * realPi) * (complexRe(reciprocalGamma(complexOfReal(R[1
      / 2]))) * complexIm(reciprocalGamma(complexOfReal(R[1 / 2]))))] = R[0] by
    linear_combination imEq
  have xy := gammaReal.zero_of_mul with twoPi, xyProduct
  have xNonzero : complexRe(reciprocalGamma(complexOfReal(R[1 / 2]))) ≠ R[0]
    intro zero
    rw zero at reEq
    have yy := gammaReal.square_nonnegative at
      complexIm(reciprocalGamma(complexOfReal(R[1 / 2])))
    have piNonnegative : R[0] ≤ realPi by linarith
    have scaled := realMulValue.nonnegative with piNonnegative, yy
    have expand : R[(realPi * 0 - 0 * complexIm(reciprocalGamma(complexOfReal(R[1
        / 2])))) * 0 - (realPi * complexIm(reciprocalGamma(complexOfReal(R[1 /
        2]))) + 0 * 0) * complexIm(reciprocalGamma(complexOfReal(R[1 / 2])))] =
        R[-(realPi * (complexIm(reciprocalGamma(complexOfReal(R[1 / 2]))) *
        complexIm(reciprocalGamma(complexOfReal(R[1 / 2])))))] by ring
    rw expand at reEq
    linarith
  have xx := gammaReal.square_positive with xNonzero
  have xyFlip : R[(complexRe(reciprocalGamma(complexOfReal(R[1 / 2]))) *
      complexRe(reciprocalGamma(complexOfReal(R[1 / 2])))) *
      complexIm(reciprocalGamma(complexOfReal(R[1 / 2])))] = R[0]
    have same : R[(complexRe(reciprocalGamma(complexOfReal(R[1 / 2]))) *
        complexRe(reciprocalGamma(complexOfReal(R[1 / 2])))) *
        complexIm(reciprocalGamma(complexOfReal(R[1 / 2])))] =
        R[complexRe(reciprocalGamma(complexOfReal(R[1 / 2]))) *
        (complexRe(reciprocalGamma(complexOfReal(R[1 / 2]))) *
        complexIm(reciprocalGamma(complexOfReal(R[1 / 2]))))] by ring
    rw [same, xy]
    ring
  have yZero := gammaReal.zero_of_mul with xx, xyFlip
  -- r = x is real.
  have realShape : reciprocalGamma(complexOfReal(R[1 / 2])) =
      complexOfReal(complexRe(reciprocalGamma(complexOfReal(R[1 / 2]))))
    have ext := complex.ext with r
    rw [yZero, complexPoint.eq, complexOfReal.zero] at ext
    have iMember := complexImaginaryUnit.member
    have cast : complexOfReal(complexRe(reciprocalGamma(complexOfReal(R[1 /
      2])))) ∈ ℂ by typecheck
    have tail : ℂ[complexOfReal(complexRe(reciprocalGamma(complexOfReal(R[1 /
        2])))) + complexImaginaryUnit * 0] =
        complexOfReal(complexRe(reciprocalGamma(complexOfReal(R[1 / 2])))) by
      ring
    rw tail at ext
    exact ext
  -- π x² = 1.
  rw yZero at reEq
  have piXX : R[realPi * (complexRe(reciprocalGamma(complexOfReal(R[1 / 2]))) *
      complexRe(reciprocalGamma(complexOfReal(R[1 / 2]))))] = R[1] by
    linear_combination reEq
  -- x > 0, since Gauss's sequence is positive.
  have limit := reciprocalGamma.converges with hf
  have sequence : ComplexSequence(reciprocalGammaTerms(complexOfReal(R[1 / 2])))
    by exact reciprocalGammaTerms.function with hf
  have close := (ComplexConvergesTo.iff_abs with sequence, r).forward with
    limit
  have absPositive : R[0] < abs(complexRe(reciprocalGamma(complexOfReal(R[1 /
      2]))))
    have upper := abs.upper at complexRe(reciprocalGamma(complexOfReal(R[1 /
      2])))
    have upperNeg := abs.upper_neg at complexRe(reciprocalGamma(
      complexOfReal(R[1 / 2])))
    by_contra notPositive
    have zero : complexRe(reciprocalGamma(complexOfReal(R[1 / 2]))) = R[0] by
      linarith
    exact xNonzero with zero
  have absReal : abs(complexRe(reciprocalGamma(complexOfReal(R[1 / 2])))) ∈ ℝ
    by typecheck
  obtain ⟨N, hN, after⟩ := close with abs(complexRe(reciprocalGamma(
    complexOfReal(R[1 / 2])))), absReal, absPositive
  have NNat := nat.omega.backward at N with hN
  have le : N ≤ N by arith
  have near := after with N, hN, le
  obtain ⟨t, ht, tPositive, tShape⟩ := reciprocalGammaTerms.half_positive at N
  rw [tShape, realShape, ← complexOfReal.sub, complexAbs.of_real,
    complexOfReal.re] at near
  have nearUpper := abs.upper at R[t - complexRe(reciprocalGamma(
    complexOfReal(R[1 / 2])))]
  have xPositive : R[0] < complexRe(reciprocalGamma(complexOfReal(R[1 / 2])))
    by_contra notPositive
    have nonpositive : complexRe(reciprocalGamma(complexOfReal(R[1 / 2]))) ≤
      R[0] by linarith
    rw (abs.of_nonpositive with nonpositive) at near
    linarith
  -- Γ(1/2) = 1/x = √π.
  have cancelReal := realDiv.mul_left at R[1],
    complexRe(reciprocalGamma(complexOfReal(R[1 / 2]))) with xNonzero
  have inverse : R[(1 / complexRe(reciprocalGamma(complexOfReal(R[1 / 2])))) *
      (1 / complexRe(reciprocalGamma(complexOfReal(R[1 / 2]))))] = realPi
    have i1 : R[1 / complexRe(reciprocalGamma(complexOfReal(R[1 / 2])))] ∈ ℝ by
      typecheck
    linear_combination (-(R[1 / complexRe(reciprocalGamma(complexOfReal(R[1 /
      2])))] * R[1 / complexRe(reciprocalGamma(complexOfReal(R[1 / 2])))])) *
      piXX + (realPi * (R[complexRe(reciprocalGamma(complexOfReal(R[1 / 2]))) *
      (1 / complexRe(reciprocalGamma(complexOfReal(R[1 / 2]))))] + 1)) *
      cancelReal
  have inversePositive : R[0] ≤ R[1 / complexRe(reciprocalGamma(complexOfReal(R[1
      / 2])))]
    rw realDiv.eq_mul_inv
    have positive := realInvValue.positive with xPositive
    have same : R[1 * realInvValue(complexRe(reciprocalGamma(complexOfReal(R[1 /
      2]))))] = realInvValue(complexRe(reciprocalGamma(complexOfReal(R[1 /
      2])))) by ring
    rw same
    linarith
  have root := gammaReal.sqrt_unique with inversePositive, inverse
  unfold Gamma
  rw [realShape, (complexInv.of_real with xNonzero), root]

-- The duplication formula for 1/Γ, everywhere:
-- 1/Γ(2s) = 2^(1−2s) √π (1/Γ(s)) (1/Γ(s + 1/2)).
theorem reciprocalGamma.duplication (s : Set)
  requires hs : s ∈ ℂ
  shows reciprocalGamma(ℂ[2 * s]) =
    ℂ[realCpow(R[2], ℂ[1 - 2 * s]) * complexOfReal(realSqrt(realPi)) *
      reciprocalGamma(s) * reciprocalGamma(s + complexOfReal(R[1 / 2]))]
proof
  have hf : complexOfReal(R[1 / 2]) ∈ ℂ by typecheck
  have double : ℂ[2 * s] ∈ ℂ by typecheck
  have shifted : ℂ[s + complexOfReal(R[1 / 2])] ∈ ℂ by typecheck
  have oneMember := complexOne.member
  have halfDouble := complexHalf.double
  -- The seven sequences and their limits.
  have limitU := ComplexConvergesTo.doubled with
    (reciprocalGamma.converges with double)
  have limitH := reciprocalGamma.converges with hf
  have limitOne := reciprocalGamma.converges with oneMember
  have limitW := gaussDoublingWeight.converges with hs
  have limitS := reciprocalGamma.converges with hs
  have limitT := reciprocalGamma.converges with shifted
  have limitOneDoubled := ComplexConvergesTo.doubled with
    (reciprocalGamma.converges with oneMember)
  have left := ComplexConvergesTo.mul with
    (ComplexConvergesTo.mul with (ComplexConvergesTo.mul with limitU, limitH),
      limitOne), limitW
  have right := ComplexConvergesTo.mul with
    (ComplexConvergesTo.mul with limitS, limitT), limitOneDoubled
  -- The two product sequences agree term by term.
  have sequenceU : ComplexSequence(reciprocalGammaTerms(ℂ[2 * s])) by
    exact reciprocalGammaTerms.function with double
  have sequenceH : ComplexSequence(reciprocalGammaTerms(complexOfReal(R[1 /
    2]))) by exact reciprocalGammaTerms.function with hf
  have sequenceOne : ComplexSequence(reciprocalGammaTerms(ℂ[1])) by
    exact reciprocalGammaTerms.function with oneMember
  have sequenceW : ComplexSequence(gaussDoublingWeight(s)) by
    exact gaussDoublingWeight.function with hs
  have sequenceS : ComplexSequence(reciprocalGammaTerms(s)) by
    exact reciprocalGammaTerms.function with hs
  have sequenceT : ComplexSequence(reciprocalGammaTerms(ℂ[s +
    complexOfReal(R[1 / 2])])) by exact reciprocalGammaTerms.function with
    shifted
  have sequenceDU : ComplexSequence(doubledTerms(reciprocalGammaTerms(ℂ[2 *
    s]))) by exact doubledTerms.function with sequenceU
  have sequenceDOne : ComplexSequence(doubledTerms(reciprocalGammaTerms(ℂ[1])))
    by exact doubledTerms.function with sequenceOne
  have m1 : ComplexSequence(complexSeqMul(doubledTerms(reciprocalGammaTerms(ℂ[2
    * s])), reciprocalGammaTerms(complexOfReal(R[1 / 2])))) by
    exact complexSeqMul.function with sequenceDU, sequenceH
  have m2 : ComplexSequence(complexSeqMul(complexSeqMul(doubledTerms(
    reciprocalGammaTerms(ℂ[2 * s])), reciprocalGammaTerms(complexOfReal(R[1 /
    2]))), reciprocalGammaTerms(ℂ[1]))) by
    exact complexSeqMul.function with m1, sequenceOne
  have m3 : ComplexSequence(complexSeqMul(complexSeqMul(complexSeqMul(
    doubledTerms(reciprocalGammaTerms(ℂ[2 * s])),
    reciprocalGammaTerms(complexOfReal(R[1 / 2]))), reciprocalGammaTerms(ℂ[1])),
    gaussDoublingWeight(s))) by exact complexSeqMul.function with m2, sequenceW
  have m4 : ComplexSequence(complexSeqMul(reciprocalGammaTerms(s),
    reciprocalGammaTerms(ℂ[s + complexOfReal(R[1 / 2])]))) by
    exact complexSeqMul.function with sequenceS, sequenceT
  have m5 : ComplexSequence(complexSeqMul(complexSeqMul(reciprocalGammaTerms(s),
    reciprocalGammaTerms(ℂ[s + complexOfReal(R[1 / 2])])),
    doubledTerms(reciprocalGammaTerms(ℂ[1])))) by
    exact complexSeqMul.function with m4, sequenceDOne
  have function3 : complexSeqMul(complexSeqMul(complexSeqMul(
    doubledTerms(reciprocalGammaTerms(ℂ[2 * s])),
    reciprocalGammaTerms(complexOfReal(R[1 / 2]))), reciprocalGammaTerms(ℂ[1])),
    gaussDoublingWeight(s)) : ℕ → ℂ by exact m3
  have function5 : complexSeqMul(complexSeqMul(reciprocalGammaTerms(s),
    reciprocalGammaTerms(ℂ[s + complexOfReal(R[1 / 2])])),
    doubledTerms(reciprocalGammaTerms(ℂ[1]))) : ℕ → ℂ by exact m5
  have same : complexSeqMul(complexSeqMul(complexSeqMul(
      doubledTerms(reciprocalGammaTerms(ℂ[2 * s])),
      reciprocalGammaTerms(complexOfReal(R[1 / 2]))),
      reciprocalGammaTerms(ℂ[1])), gaussDoublingWeight(s)) =
      complexSeqMul(complexSeqMul(reciprocalGammaTerms(s),
      reciprocalGammaTerms(ℂ[s + complexOfReal(R[1 / 2])])),
      doubledTerms(reciprocalGammaTerms(ℂ[1])))
    apply FunctionBetween.ext with function3, function5
    intros n hn
    have nNat := nat.omega.backward at n with hn
    rw [(complexSeqMul.value with m2, sequenceW, hn),
      (complexSeqMul.value with m1, sequenceOne, hn),
      (complexSeqMul.value with sequenceDU, sequenceH, hn),
      (doubledTerms.value with sequenceU, hn),
      (complexSeqMul.value with m4, sequenceDOne, hn),
      (complexSeqMul.value with sequenceS, sequenceT, hn),
      (doubledTerms.value with sequenceOne, hn),
      (gaussDoublingWeight.value with hs, hn)]
    obtain ⟨c, hc, formula⟩ := reciprocalGammaTerms.doubling at n
    have atS := formula with s, hs
    have atH := formula with complexOfReal(R[1 / 2]), hf
    have twoHalf : ℂ[2 * complexOfReal(R[1 / 2])] = ℂ[1] by
      exact halfDouble
    have halfHalf : ℂ[complexOfReal(R[1 / 2]) + complexOfReal(R[1 / 2])] =
      ℂ[1] by linear_combination halfDouble
    rw [twoHalf, halfHalf] at atH
    -- The weight relation between the powers.
    have negS : ℂ[-s] ∈ ℂ by typecheck
    have negT : ℂ[-(s + complexOfReal(R[1 / 2]))] ∈ ℂ by typecheck
    have negH : ℂ[-complexOfReal(R[1 / 2])] ∈ ℂ by typecheck
    have negOne : ℂ[-1] ∈ ℂ by typecheck
    have negDouble : ℂ[-(2 * s)] ∈ ℂ by typecheck
    have wMember : ℂ[2 * s - 1] ∈ ℂ by typecheck
    have vMember : ℂ[1 - 2 * s] ∈ ℂ by typecheck
    have negHH : ℂ[-complexOfReal(R[1 / 2]) + -1] ∈ ℂ by typecheck
    have c1 := realCpow.add at realNat(n + 1), ℂ[-s],
      ℂ[-(s + complexOfReal(R[1 / 2]))] with negS, negT
    have c2 := realCpow.add at realNat(n + 1), ℂ[-complexOfReal(R[1 / 2]) + -1],
      ℂ[1 - 2 * s] with negHH, vMember
    have c3 := realCpow.add at realNat(n + 1), ℂ[-complexOfReal(R[1 / 2])],
      ℂ[-1] with negH, negOne
    have c4 := realCpow.add at realNat(2 * n + 3), ℂ[-(2 * s)], ℂ[2 * s - 1]
      with negDouble, wMember
    have expN : ℂ[-s + -(s + complexOfReal(R[1 / 2]))] =
        ℂ[(-complexOfReal(R[1 / 2]) + -1) + (1 - 2 * s)] by ring
    have expM : ℂ[-1] = ℂ[-(2 * s) + (2 * s - 1)] by ring
    rw expN at c1
    have mM : realCpow(realNat(2 * n + 3), ℂ[-1]) =
        realCpow(realNat(2 * n + 3), ℂ[-(2 * s) + (2 * s - 1)]) by
      rw ← expM
    -- Members.
    have Xs := reciprocalGammaTerms.member at ℂ[2 * s], 2 * n + 2 with double
    have Xh := reciprocalGammaTerms.member at ℂ[1], 2 * n + 2 with oneMember
    have gs := reciprocalGammaTerms.member at s, n with hs
    have gt := reciprocalGammaTerms.member at ℂ[s + complexOfReal(R[1 / 2])], n
      with shifted
    have gh := reciprocalGammaTerms.member at complexOfReal(R[1 / 2]), n with hf
    have g1 := reciprocalGammaTerms.member at ℂ[1], n with oneMember
    have P1s := realCpow.member at realNat(n + 1), ℂ[-s] with negS
    have P1t := realCpow.member at realNat(n + 1),
      ℂ[-(s + complexOfReal(R[1 / 2]))] with negT
    have P1h := realCpow.member at realNat(n + 1), ℂ[-complexOfReal(R[1 / 2])]
      with negH
    have P1hh := realCpow.member at realNat(n + 1), ℂ[-1] with negOne
    have P2s := realCpow.member at realNat(2 * n + 3), ℂ[-(2 * s)] with
      negDouble
    have P2h := realCpow.member at realNat(2 * n + 3), ℂ[-1] with negOne
    have QM := realCpow.member at realNat(2 * n + 3), ℂ[2 * s - 1] with wMember
    have QN := realCpow.member at realNat(n + 1), ℂ[1 - 2 * s] with vMember
    have f : complexOfReal(R[1 / realNat((n + 1)!)]) ∈ ℂ by typecheck
    have weight : ℂ[realCpow(realNat(n + 1), ℂ[-s]) *
        realCpow(realNat(n + 1), ℂ[-(s + complexOfReal(R[1 / 2]))]) *
        realCpow(realNat(2 * n + 3), ℂ[-1])] =
        ℂ[realCpow(realNat(n + 1), ℂ[-complexOfReal(R[1 / 2])]) *
        realCpow(realNat(n + 1), ℂ[-1]) *
        realCpow(realNat(2 * n + 3), ℂ[-(2 * s)]) *
        (realCpow(realNat(2 * n + 3), ℂ[2 * s - 1]) *
        realCpow(realNat(n + 1), ℂ[1 - 2 * s]))] by
      linear_combination (-realCpow(realNat(2 * n + 3), ℂ[-1])) * c1 +
        realCpow(realNat(2 * n + 3), ℂ[-1]) * c2 +
        (realCpow(realNat(2 * n + 3), ℂ[-1]) *
          realCpow(realNat(n + 1), ℂ[1 - 2 * s])) * c3 +
        (realCpow(realNat(n + 1), ℂ[-complexOfReal(R[1 / 2])]) *
          realCpow(realNat(n + 1), ℂ[-1]) *
          realCpow(realNat(n + 1), ℂ[1 - 2 * s])) * mM +
        (realCpow(realNat(n + 1), ℂ[-complexOfReal(R[1 / 2])]) *
          realCpow(realNat(n + 1), ℂ[-1]) *
          realCpow(realNat(n + 1), ℂ[1 - 2 * s])) * c4
    have zero : ℂ[(realCpow(realNat(n + 1), ℂ[-complexOfReal(R[1 / 2])]) *
        realCpow(realNat(n + 1), ℂ[-1]) *
        realCpow(realNat(2 * n + 3), ℂ[-(2 * s)]) *
        complexOfReal(R[1 / realNat((n + 1)!)]) *
        complexOfReal(R[1 / realNat((n + 1)!)])) *
        (reciprocalGammaTerms(ℂ[2 * s])(2 * n + 2) *
        reciprocalGammaTerms(complexOfReal(R[1 / 2]))(n) *
        reciprocalGammaTerms(ℂ[1])(n) *
        (realCpow(realNat(2 * n + 3), ℂ[2 * s - 1]) *
        realCpow(realNat(n + 1), ℂ[1 - 2 * s])) -
        reciprocalGammaTerms(s)(n) *
        reciprocalGammaTerms(ℂ[s + complexOfReal(R[1 / 2])])(n) *
        reciprocalGammaTerms(ℂ[1])(2 * n + 2))] = ℂ[0] by
      linear_combination (reciprocalGammaTerms(complexOfReal(R[1 / 2]))(n) *
        reciprocalGammaTerms(ℂ[1])(n) *
        realCpow(realNat(2 * n + 3), ℂ[-1])) * atS -
        (reciprocalGammaTerms(s)(n) *
        reciprocalGammaTerms(ℂ[s + complexOfReal(R[1 / 2])])(n) *
        realCpow(realNat(2 * n + 3), ℂ[-(2 * s)])) * atH -
        (reciprocalGammaTerms(ℂ[2 * s])(2 * n + 2) *
        reciprocalGammaTerms(complexOfReal(R[1 / 2]))(n) *
        reciprocalGammaTerms(ℂ[1])(n) *
        complexOfReal(R[1 / realNat((n + 1)!)]) *
        complexOfReal(R[1 / realNat((n + 1)!)])) * weight
    have n1 := realCpow.nonzero at realNat(n + 1), ℂ[-complexOfReal(R[1 / 2])]
      with negH
    have n2 := realCpow.nonzero at realNat(n + 1), ℂ[-1] with negOne
    have n3 := realCpow.nonzero at realNat(2 * n + 3), ℂ[-(2 * s)] with
      negDouble
    have factorialPositive := realNat.factorial_pos at n + 1
    have fNonzero : complexOfReal(R[1 / realNat((n + 1)!)]) ≠ ℂ[0]
      intro fZero
      have positive : R[0] < R[1 / realNat((n + 1)!)]
        rw realDiv.eq_mul_inv
        have inverse := realInvValue.positive with factorialPositive
        have same1 : R[1 * realInvValue(realNat((n + 1)!))] =
          realInvValue(realNat((n + 1)!)) by ring
        rw same1
        exact inverse
      have absolute := complexAbs.of_real at R[1 / realNat((n + 1)!)]
      rw [fZero, complexAbs.zero] at absolute
      have upper := abs.upper at R[1 / realNat((n + 1)!)]
      linarith
    have k1 : ℂ[realCpow(realNat(n + 1), ℂ[-complexOfReal(R[1 / 2])]) *
      realCpow(realNat(n + 1), ℂ[-1])] ∈ ℂ by typecheck
    have kn1 := gammaComplex.mul_nonzero with P1h, P1hh, n1, n2
    have k2 : ℂ[realCpow(realNat(n + 1), ℂ[-complexOfReal(R[1 / 2])]) *
      realCpow(realNat(n + 1), ℂ[-1]) * realCpow(realNat(2 * n + 3),
      ℂ[-(2 * s)])] ∈ ℂ by typecheck
    have kn2 := gammaComplex.mul_nonzero with k1, P2s, kn1, n3
    have k3 : ℂ[realCpow(realNat(n + 1), ℂ[-complexOfReal(R[1 / 2])]) *
      realCpow(realNat(n + 1), ℂ[-1]) * realCpow(realNat(2 * n + 3),
      ℂ[-(2 * s)]) * complexOfReal(R[1 / realNat((n + 1)!)])] ∈ ℂ by typecheck
    have kn3 := gammaComplex.mul_nonzero with k2, f, kn2, fNonzero
    have k4 : ℂ[realCpow(realNat(n + 1), ℂ[-complexOfReal(R[1 / 2])]) *
      realCpow(realNat(n + 1), ℂ[-1]) * realCpow(realNat(2 * n + 3),
      ℂ[-(2 * s)]) * complexOfReal(R[1 / realNat((n + 1)!)]) *
      complexOfReal(R[1 / realNat((n + 1)!)])] ∈ ℂ by typecheck
    have kn4 := gammaComplex.mul_nonzero with k3, f, kn3, fNonzero
    have differenceMember : ℂ[reciprocalGammaTerms(ℂ[2 * s])(2 * n + 2) *
        reciprocalGammaTerms(complexOfReal(R[1 / 2]))(n) *
        reciprocalGammaTerms(ℂ[1])(n) *
        (realCpow(realNat(2 * n + 3), ℂ[2 * s - 1]) *
        realCpow(realNat(n + 1), ℂ[1 - 2 * s])) -
        reciprocalGammaTerms(s)(n) *
        reciprocalGammaTerms(ℂ[s + complexOfReal(R[1 / 2])])(n) *
        reciprocalGammaTerms(ℂ[1])(2 * n + 2)] ∈ ℂ by typecheck
    have vanish := complexMul.cancel_left with k4, differenceMember, kn4, zero
    linear_combination vanish
  -- Compare the limits.
  rw same at left
  have equation := ComplexConvergesTo.unique with left, right
  rw reciprocalGamma.one at equation
  have half := Gamma.half
  have halfDomain : complexOfReal(R[1 / 2]) ∈ gammaDomain
    have re : complexRe(complexOfReal(R[1 / 2])) = R[1 / 2] by
      rw complexOfReal.re
    have positive : realZero < complexRe(complexOfReal(R[1 / 2]))
      rw re
      linarith
    exact gammaDomain.of_re_positive with hf, positive
  have inverseHalf := Gamma.mul_reciprocal with halfDomain
  rw half at inverseHalf
  have w : ℂ[2 * s - 1] ∈ ℂ by typecheck
  have v : ℂ[1 - 2 * s] ∈ ℂ by typecheck
  have powers := realCpow.add at R[2], ℂ[1 - 2 * s], ℂ[2 * s - 1] with v, w
  have exponentZero : ℂ[(1 - 2 * s) + (2 * s - 1)] = ℂ[0] by ring
  rw [exponentZero, realCpow.zero] at powers
  have rU := reciprocalGamma.member at ℂ[2 * s]
  have rH := reciprocalGamma.member at complexOfReal(R[1 / 2])
  have rS := reciprocalGamma.member at s
  have rT := reciprocalGamma.member at ℂ[s + complexOfReal(R[1 / 2])]
  have root : complexOfReal(realSqrt(realPi)) ∈ ℂ by typecheck
  have pw := realCpow.member at R[2], ℂ[2 * s - 1] with w
  have pv := realCpow.member at R[2], ℂ[1 - 2 * s] with v
  linear_combination reciprocalGamma(ℂ[2 * s]) * powers -
    (reciprocalGamma(ℂ[2 * s]) * realCpow(R[2], ℂ[1 - 2 * s]) *
    realCpow(R[2], ℂ[2 * s - 1])) * inverseHalf +
    (realCpow(R[2], ℂ[1 - 2 * s]) * complexOfReal(realSqrt(realPi))) * equation

theorem Gamma.half_square
  shows ℂ[Gamma(complexOfReal(R[1 / 2])) * Gamma(complexOfReal(R[1 / 2]))] =
    complexOfReal(realPi)
proof
  have hs := reciprocalGamma.half_square
  have r := reciprocalGamma.member at complexOfReal(R[1 / 2])
  have nonzero : reciprocalGamma(complexOfReal(R[1 / 2])) ≠ ℂ[0]
    intro zero
    rw zero at hs
    have collapse : ℂ[complexOfReal(realPi) * 0 * 0] = ℂ[0] by
      have piMember : complexOfReal(realPi) ∈ ℂ by typecheck
      ring
    rw collapse at hs
    symm at hs
    exact gammaComplex.one_nonzero with hs
  have cancel := complexInv.mul_cancel with r, nonzero
  have inverse := complexInv.member with r
  have piMember : complexOfReal(realPi) ∈ ℂ by typecheck
  unfold Gamma
  linear_combination (-(complexInv(reciprocalGamma(complexOfReal(R[1 / 2]))) *
    complexInv(reciprocalGamma(complexOfReal(R[1 / 2]))))) * hs +
    (complexOfReal(realPi) * (reciprocalGamma(complexOfReal(R[1 / 2])) *
    complexInv(reciprocalGamma(complexOfReal(R[1 / 2]))) + 1)) * cancel

-- Section: The reflection formula
-- A function continuous on a disk and differentiable there except at one
-- point is holomorphic on the disk: it is the derivative of its primitive.
theorem HolomorphicOn.of_continuous_except (g a s p : Set)
  requires values : ComplexValuedOn(g, complexCarrier)
  requires ha : a ∈ ℂ
  requires hs : s ∈ ℝ
  requires continuous : ComplexContinuousOn(g, complexDisk(a, s))
  requires hp : p ∈ ℂ
  requires differentiable : ∀ w ∈ complexDisk(a, s), w ≠ p →
    ComplexDifferentiableAt(g, complexDisk(a, s), w)
  shows HolomorphicOn(g, complexDisk(a, s))
proof
  have isOpen := complexDisk.open with ha, hs
  have inside := complexDisk.subset at a, s
  have primitive : ∀ z ∈ complexDisk(a, s), HasComplexDerivativeAt(
      diskPrimitive(g, a), complexDisk(a, s), g(z), z)
    intros z hz
    exact diskPrimitive.has_derivative with values, ha, hs, continuous, hp,
      differentiable, hz
  have holomorphicP : HolomorphicOn(diskPrimitive(g, a), complexDisk(a, s))
    refine ⟨isOpen, ?_, ?_⟩
    . intros z hz
      have zMember := inside with z, hz
      exact FunctionBetween.apply_closed with
        (diskPrimitive.function with ha), zMember
    . intros z hz
      have zMember := inside with z, hz
      have gz := values with z, zMember
      exact ⟨g(z), gz, (primitive with z, hz)⟩
  have derivative := HolomorphicOn.deriv with holomorphicP
  apply HolomorphicOn.congr with derivative
  intros z hz
  have here := complexDeriv.has_derivative with holomorphicP, hz
  exact HasComplexDerivativeAt.unique with here, (primitive with z, hz)

-- For f entire, the slope (f(w) − f(a))/(w − a), with the value f'(a) at
-- a, is entire.
theorem slopeFunction.holomorphic (f a : Set)
  requires holomorphic : HolomorphicOn(f, complexCarrier)
  requires ha : a ∈ ℂ
  shows HolomorphicOn(slopeFunction(f, a,
    complexDeriv(f, complexCarrier)(a)), complexCarrier)
proof
  have copy := holomorphic
  obtain ⟨_, values, _⟩ := copy
  have derivative := complexDeriv.has_derivative with holomorphic, ha
  have copyD := derivative
  obtain ⟨_, _, hD, _, _⟩ := copyD
  have continuous := slopeFunction.continuous with values, holomorphic,
    derivative
  have copyC := continuous
  obtain ⟨_, slopeValues, _⟩ := copyC
  have whole := ComplexOpen.whole
  apply HolomorphicOn.of_local with whole
  intros w hw
  have one : R[1] ∈ ℝ by typecheck
  have onePositive : R[0] < R[1] by linarith
  have isOpen := complexDisk.open with hw, one
  have center := complexDisk.center with hw, one, onePositive
  have inside := complexDisk.subset at w, R[1]
  refine ⟨complexDisk(w, R[1]), isOpen, center, inside, ?_⟩
  have restricted := ComplexContinuousOn.mono with continuous, inside
  apply HolomorphicOn.of_continuous_except with slopeValues, hw, one,
    restricted, ha
  intros z hz distinct
  have zMember := inside with z, hz
  have here := slopeFunction.differentiable with values, holomorphic, ha, hD,
    zMember, distinct
  obtain ⟨E, hE, atZ⟩ := here
  exact ⟨E, hE, (HasComplexDerivativeAt.mono with atZ, isOpen, inside, hz)⟩

-- The composite s ↦ f(c s + b) of a function on ℂ with an affine map.
defgraph affineComp (f c b : Set) (s ∈ complexCarrier) : complexCarrier :=
    f(ℂ[c * s + b])
requires values : ComplexValuedOn(f, complexCarrier)
requires hc : c ∈ complexCarrier
requires hb : b ∈ complexCarrier
proof
  have point : ℂ[c * s + b] ∈ ℂ by typecheck
  exact values with point

-- The chain rule for an affine inner function.
theorem affineComp.has_derivative (f c b D s : Set)
  requires values : ComplexValuedOn(f, complexCarrier)
  requires hc : c ∈ ℂ
  requires hb : b ∈ ℂ
  requires hs : s ∈ ℂ
  requires derivative : HasComplexDerivativeAt(f, complexCarrier, D,
    ℂ[c * s + b])
  shows HasComplexDerivativeAt(affineComp(f, c, b), complexCarrier,
    ℂ[c * D], s)
proof
  have zero : ℂ[0] ∈ ℂ by typecheck
  have inner := affineFunction.has_derivative with hb, hc, zero, hs
  have point : affineFunction(b, c, ℂ[0])(s) = ℂ[c * s + b]
    rw (affineFunction.value with hb, hc, zero, hs)
    ring
  rw ← point at derivative
  have maps : ∀ z ∈ ℂ, affineFunction(b, c, ℂ[0])(z) ∈ ℂ
    intros z hz
    exact FunctionBetween.apply_closed with
      (affineFunction.function with hb, hc, zero), hz
  have composite := HasComplexDerivativeAt.comp with inner, derivative, maps
  have copy := derivative
  obtain ⟨_, _, hD, _, _⟩ := copy
  have swap : ℂ[D * c] = ℂ[c * D] by ring
  rw swap at composite
  apply HasComplexDerivativeAt.congr with composite
  intros z hz
  have inside : ∀ z ∈ ℂ, f(affineFunction(b, c, ℂ[0])(z)) ∈ ℂ
    intros w hw
    exact values with (maps with w, hw)
  rw [(complexFunctionComp.value with inside, hz),
    (affineComp.value with values, hc, hb, hz),
    (affineFunction.value with hb, hc, zero, hz)]
  have same : ℂ[b + c * (z - 0)] = ℂ[c * z + b] by ring
  rw same

theorem affineComp.holomorphic (f c b : Set)
  requires holomorphic : HolomorphicOn(f, complexCarrier)
  requires hc : c ∈ ℂ
  requires hb : b ∈ ℂ
  shows HolomorphicOn(affineComp(f, c, b), complexCarrier)
proof
  have copy := holomorphic
  obtain ⟨whole, values, _⟩ := copy
  refine ⟨whole, ?_, ?_⟩
  . intros z hz
    exact FunctionBetween.apply_closed with
      (affineComp.function with values, hc, hb), hz
  . intros z hz
    have point : ℂ[c * z + b] ∈ ℂ by typecheck
    have derivative := complexDeriv.has_derivative with holomorphic, point
    have copyD := derivative
    obtain ⟨_, _, hD, _, _⟩ := copyD
    have product : ℂ[c * complexDeriv(f, complexCarrier)(ℂ[c * z + b])] ∈ ℂ
      by typecheck
    exact ⟨ℂ[c * complexDeriv(f, complexCarrier)(ℂ[c * z + b])], product,
      (affineComp.has_derivative with values, hc, hb, hz, derivative)⟩

-- A real function with derivative 0 everywhere takes its value at 0
-- everywhere.
theorem HasDerivativeAt.eq_value_zero (F : Set) (X : Real)
  requires derivative : ∀ C ∈ ℝ, HasDerivativeAt(F, (0:R), C)
  shows F(X) = F(R[0])
proof
  have sign := realLess.trichotomy at X, R[0]
  rcases sign with below | same | above
  . exact HasDerivativeAt.constant_of_zero with below, derivative
  . rw same
  . have flipped := HasDerivativeAt.constant_of_zero with above, derivative
    rw flipped

-- An entire function whose derivative vanishes on the real line is
-- constant there.
theorem HolomorphicOn.real_constant (f : Set)
  requires holomorphic : HolomorphicOn(f, complexCarrier)
  requires flat : ∀ X ∈ ℝ,
    complexDeriv(f, complexCarrier)(complexOfReal(X)) = ℂ[0]
  shows ∀ X ∈ ℝ, f(complexOfReal(X)) = f(ℂ[0])
proof
  have copy := holomorphic
  obtain ⟨_, values, _⟩ := copy
  have zeroReal : R[0] ∈ ℝ by typecheck
  have pathFunction := horizontalPath.function at R[0]
  have onPath : ∀ Y ∈ ℝ, horizontalPath(R[0])(Y) = complexOfReal(Y)
    intros Y hY
    rw [(horizontalPath.value at R[0], Y with hY),
      (complexOfReal.value with hY)]
  have inside : ∀ Y ∈ ℝ, horizontalPath(R[0])(Y) ∈ ℂ
    intros Y hY
    exact FunctionBetween.apply_closed with pathFunction, hY
  have pathValues : ∀ Y ∈ ℝ, f(horizontalPath(R[0])(Y)) ∈ ℂ
    intros Y hY
    exact values with (inside with Y, hY)
  have formula : ∀ Y ∈ ℝ, complexFunctionComp(f, horizontalPath(R[0]), ℝ)(Y)
      = f(horizontalPath(R[0])(Y))
    intros Y hY
    exact complexFunctionComp.value with pathValues, hY
  have flatPath : ∀ C ∈ ℝ, HasPathDerivative(
      complexFunctionComp(f, horizontalPath(R[0]), ℝ), ℂ[0 * 1], C)
    intros C hC
    have point : complexOfReal(C) ∈ ℂ by typecheck
    have derivative := complexDeriv.has_derivative with holomorphic, point
    rw [(flat with C, hC), ← (onPath with C, hC)] at derivative
    have path := horizontalPath.derivative at R[0], C
    exact HasPathDerivative.comp with derivative, path, inside, formula
  have zeroValue : ℂ[0 * 1] = complexOfReal(R[0])
    rw complexOfReal.zero
    ring
  have flatRe : ∀ C ∈ ℝ, HasDerivativeAt(pathRe(
      complexFunctionComp(f, horizontalPath(R[0]), ℝ)), (0:R), C)
    intros C hC
    have parts := HasPathDerivative.parts with (flatPath with C, hC)
    have reD := parts.left
    rwa [zeroValue, complexOfReal.re] at reD
  have flatIm : ∀ C ∈ ℝ, HasDerivativeAt(pathIm(
      complexFunctionComp(f, horizontalPath(R[0]), ℝ)), (0:R), C)
    intros C hC
    have parts := HasPathDerivative.parts with (flatPath with C, hC)
    have imD := parts.right
    rwa [zeroValue, complexOfReal.im] at imD
  have φValues : ComplexValuedOn(
      complexFunctionComp(f, horizontalPath(R[0]), ℝ), ℝ)
    intros Y hY
    rw (formula with Y, hY)
    exact pathValues with Y, hY
  intros X hX
  have reSame := HasDerivativeAt.eq_value_zero at
    pathRe(complexFunctionComp(f, horizontalPath(R[0]), ℝ)), X with flatRe
  have imSame := HasDerivativeAt.eq_value_zero at
    pathIm(complexFunctionComp(f, horizontalPath(R[0]), ℝ)), X with flatIm
  rw [(pathRe.value with φValues, hX), (pathRe.value with φValues, zeroReal),
    (formula with X, hX), (formula with R[0], zeroReal), (onPath with X, hX),
    (onPath with R[0], zeroReal), complexOfReal.zero] at reSame
  rw [(pathIm.value with φValues, hX), (pathIm.value with φValues, zeroReal),
    (formula with X, hX), (formula with R[0], zeroReal), (onPath with X, hX),
    (onPath with R[0], zeroReal), complexOfReal.zero] at imSame
  have point : complexOfReal(X) ∈ ℂ by typecheck
  have zeroMember : ℂ[0] ∈ ℂ by typecheck
  exact complex.eq_of_parts with (values with point), (values with zeroMember),
    reSame, imSame

-- The real points of (0, 1/2), where two entire functions are compared.
def halfSegment : Set :=
  { z ∈ complexCarrier | ∃ X ∈ ℝ, R[0] < X ∧ X < R[1 / 2] ∧
    z = complexOfReal(X) }

-- Two entire functions that agree on the real points of (0, 1/2) agree
-- everywhere.
theorem HolomorphicOn.eq_of_segment (f g : Set)
  requires holomorphicF : HolomorphicOn(f, complexCarrier)
  requires holomorphicG : HolomorphicOn(g, complexCarrier)
  requires agree : ∀ X ∈ ℝ, R[0] < X → X < R[1 / 2] →
    f(complexOfReal(X)) = g(complexOfReal(X))
  shows ∀ z ∈ ℂ, f(z) = g(z)
proof
  have connected := ComplexConnected.whole
  have inside : halfSegment ⊆ complexCarrier
    intros z hz
    obtain ⟨zMember, _⟩ := halfSegment.membership.forward with hz
    exact zMember
  have center : complexOfReal(R[1 / 4]) ∈ ℂ by typecheck
  apply holomorphic.identity_accumulation with holomorphicF, holomorphicG,
    connected, inside, center
  . intros r hr rPositive
    have eighth : R[1 / 8] ∈ ℝ by typecheck
    have eighthPositive : R[0] < R[1 / 8] by linarith
    obtain ⟨t, ht, tPositive, belowR, belowEighth⟩ := realRadius.common with
      hr, eighth, rPositive, eighthPositive
    have halfT := half.add_self at t
    have halfReal := half.real at t
    have halfPositive : R[0] < half(t) by linarith
    have sampleReal : R[1 / 4 + half(t)] ∈ ℝ by typecheck
    have sample : complexOfReal(R[1 / 4 + half(t)]) ∈ halfSegment
      apply halfSegment.membership.backward
      have member : complexOfReal(R[1 / 4 + half(t)]) ∈ ℂ by typecheck
      refine ⟨member, R[1 / 4 + half(t)], sampleReal, ?_, ?_, rfl⟩
      . linarith
      . linarith
    refine ⟨complexOfReal(R[1 / 4 + half(t)]), sample, ?_, ?_⟩
    . intro same
      have equal := complexOfReal.injective with same
      linarith
    . rw [← complexOfReal.sub, complexAbs.of_real]
      have difference : R[1 / 4 + half(t) - 1 / 4] = half(t) by ring
      rw difference
      have nonnegative : R[0] ≤ half(t) by linarith
      rw (abs.of_nonnegative with nonnegative)
      linarith
  . intros z hz
    obtain ⟨_, X, hX, positive, below, shape⟩ :=
      halfSegment.membership.forward with hz
    rw shape
    exact agree with X, hX, positive, below

-- h(s) = π (1/Γ(s)) (1/Γ(1 − s)) and S(s) = sin(πs), entire functions that
-- the reflection formula identifies.
defgraph reflectionProduct (s ∈ complexCarrier) : complexCarrier :=
    ℂ[complexOfReal(realPi) * reciprocalGamma(s) * reciprocalGamma(1 - s)]
proof
  have first := reciprocalGamma.member at s
  have second := reciprocalGamma.member at ℂ[1 - s]
  typecheck

defgraph sinPi (s ∈ complexCarrier) : complexCarrier :=
    complexSin(ℂ[complexOfReal(realPi) * s])
proof
  have point : ℂ[complexOfReal(realPi) * s] ∈ ℂ by typecheck
  exact complexSin.member with point

-- h(s) = s · π (1/Γ(s + 1)) (1/Γ(1 − s)).
theorem reflectionProduct.factor (s : Set)
  requires hs : s ∈ ℂ
  shows reflectionProduct(s) = ℂ[s * (complexOfReal(realPi) *
    reciprocalGamma(s + 1) * reciprocalGamma(1 - s))]
proof
  have succ := reciprocalGamma.succ with hs
  have first := reciprocalGamma.member at ℂ[s + 1]
  have second := reciprocalGamma.member at ℂ[1 - s]
  have piMember : complexOfReal(realPi) ∈ ℂ by typecheck
  rw (reflectionProduct.value with hs)
  linear_combination (complexOfReal(realPi) * reciprocalGamma(ℂ[1 - s])) *
    succ

-- h is entire, with h'(0) = π.
theorem reflectionProduct.analytic
  shows HolomorphicOn(reflectionProduct, complexCarrier) ∧
    HasComplexDerivativeAt(reflectionProduct, complexCarrier,
      complexOfReal(realPi), ℂ[0])
proof
  have whole := ComplexOpen.whole
  have sub : complexCarrier ⊆ complexCarrier
    intros z hz
    exact hz
  have piMember : complexOfReal(realPi) ∈ ℂ by typecheck
  have one : ℂ[1] ∈ ℂ by typecheck
  have minusOne : ℂ[-1] ∈ ℂ by typecheck
  have r := reciprocalGamma.holomorphic
  have copyR := r
  obtain ⟨_, rValues, _⟩ := copyR
  have constant := HolomorphicOn.const with whole, piMember
  have copyC := constant
  obtain ⟨_, cValues, _⟩ := copyC
  have shifted := affineComp.holomorphic with r, one, one
  have copyS := shifted
  obtain ⟨_, sValues, _⟩ := copyS
  have reflected := affineComp.holomorphic with r, minusOne, one
  have copyF := reflected
  obtain ⟨_, fValues, _⟩ := copyF
  have firstProduct := HolomorphicOn.mul with constant, shifted
  have copyP := firstProduct
  obtain ⟨_, pValues, _⟩ := copyP
  have kHolomorphic := HolomorphicOn.mul with firstProduct, reflected
  have copyK := kHolomorphic
  obtain ⟨_, kValues, _⟩ := copyK
  have identity := HolomorphicOn.id with whole
  have copyI := identity
  obtain ⟨_, iValues, _⟩ := copyI
  have product := HolomorphicOn.mul with identity, kHolomorphic
  -- K(z) = π (1/Γ(z + 1)) (1/Γ(1 − z)), and h = id · K.
  have kValue : ∀ z ∈ ℂ, complexFunctionMul(complexFunctionMul(
      complexFunctionConst(complexOfReal(realPi), complexCarrier),
      affineComp(reciprocalGammaMap, ℂ[1], ℂ[1]), complexCarrier),
      affineComp(reciprocalGammaMap, ℂ[-1], ℂ[1]), complexCarrier)(z) =
      ℂ[complexOfReal(realPi) * reciprocalGamma(z + 1) *
        reciprocalGamma(1 - z)]
    intros z hz
    have shiftPoint : ℂ[1 * z + 1] ∈ ℂ by typecheck
    have flipPoint : ℂ[-1 * z + 1] ∈ ℂ by typecheck
    rw [(complexFunctionMul.value with pValues, fValues, hz),
      (complexFunctionMul.value with cValues, sValues, hz),
      (complexFunctionConst.value with piMember, hz),
      (affineComp.value with rValues, one, one, hz),
      (affineComp.value with rValues, minusOne, one, hz),
      (reciprocalGammaMap.value with shiftPoint),
      (reciprocalGammaMap.value with flipPoint)]
    have shiftSame : ℂ[1 * z + 1] = ℂ[z + 1] by ring
    have flipSame : ℂ[-1 * z + 1] = ℂ[1 - z] by ring
    rw [shiftSame, flipSame]
  have agree : ∀ z ∈ ℂ, complexFunctionMul(complexFunctionId(complexCarrier),
      complexFunctionMul(complexFunctionMul(
      complexFunctionConst(complexOfReal(realPi), complexCarrier),
      affineComp(reciprocalGammaMap, ℂ[1], ℂ[1]), complexCarrier),
      affineComp(reciprocalGammaMap, ℂ[-1], ℂ[1]), complexCarrier),
      complexCarrier)(z) = reflectionProduct(z)
    intros z hz
    rw [(complexFunctionMul.value with iValues, kValues, hz),
      (complexFunctionId.value with sub, hz), (kValue with z, hz),
      (reflectionProduct.factor with hz)]
  have holomorphic := HolomorphicOn.congr with product, agree
  refine ⟨holomorphic, ?_⟩
  have zero : ℂ[0] ∈ ℂ by typecheck
  have idDerivative := HasComplexDerivativeAt.id with whole, zero
  have kDerivative := complexDeriv.has_derivative with kHolomorphic, zero
  have productDerivative := HasComplexDerivativeAt.mul with idDerivative,
    kDerivative
  have derivative := HasComplexDerivativeAt.congr with productDerivative, agree
  have copyD := kDerivative
  obtain ⟨_, _, kD, _, _⟩ := copyD
  rw [(kValue with ℂ[0], zero), (complexFunctionId.value with sub, zero)]
    at derivative
  have oneSum : ℂ[0 + 1] = ℂ[1] by ring
  have oneDiff : ℂ[1 - 0] = ℂ[1] by ring
  rw [oneSum, oneDiff, reciprocalGamma.one] at derivative
  have value : ℂ[1 * (complexOfReal(realPi) * 1 * 1) +
      0 * complexDeriv(complexFunctionMul(complexFunctionMul(
      complexFunctionConst(complexOfReal(realPi), complexCarrier),
      affineComp(reciprocalGammaMap, ℂ[1], ℂ[1]), complexCarrier),
      affineComp(reciprocalGammaMap, ℂ[-1], ℂ[1]), complexCarrier),
      complexCarrier)(ℂ[0])] = complexOfReal(realPi) by ring
  rwa value at derivative

-- S is entire, with S'(s) = π cos(πs).
theorem sinPi.has_derivative (s : Set)
  requires hs : s ∈ ℂ
  shows HasComplexDerivativeAt(sinPi, complexCarrier,
    ℂ[complexOfReal(realPi) * complexCos(ℂ[complexOfReal(realPi) * s])], s)
proof
  have piMember : complexOfReal(realPi) ∈ ℂ by typecheck
  have zero : ℂ[0] ∈ ℂ by typecheck
  have values : ComplexValuedOn(complexSin, complexCarrier)
    intros z hz
    exact complexSin.member with hz
  have point : ℂ[complexOfReal(realPi) * s + 0] ∈ ℂ by typecheck
  have inner := complexSin.has_derivative with point
  have composite := affineComp.has_derivative with values, piMember, zero, hs,
    inner
  have same : ℂ[complexOfReal(realPi) * s + 0] =
    ℂ[complexOfReal(realPi) * s] by ring
  rw same at composite
  apply HasComplexDerivativeAt.congr with composite
  intros z hz
  rw [(affineComp.value with values, piMember, zero, hz),
    (sinPi.value with hz)]
  have sameZ : ℂ[complexOfReal(realPi) * z + 0] =
    ℂ[complexOfReal(realPi) * z] by ring
  rw sameZ

theorem sinPi.holomorphic
  shows HolomorphicOn(sinPi, complexCarrier)
proof
  have whole := ComplexOpen.whole
  refine ⟨whole, ?_, ?_⟩
  . intros z hz
    exact FunctionBetween.apply_closed with sinPi.function, hz
  . intros z hz
    have derivative := sinPi.has_derivative with hz
    have value : ℂ[complexOfReal(realPi) *
      complexCos(ℂ[complexOfReal(realPi) * z])] ∈ ℂ by typecheck
    exact ⟨ℂ[complexOfReal(realPi) * complexCos(ℂ[complexOfReal(realPi) * z])],
      value, derivative⟩

-- h(s + 1) = −h(s) and h(−s) = −h(s).
theorem reflectionProduct.shift (s : Set)
  requires hs : s ∈ ℂ
  shows reflectionProduct(ℂ[s + 1]) = ℂ[-reflectionProduct(s)]
proof
  have shifted : ℂ[s + 1] ∈ ℂ by typecheck
  have negated : ℂ[-s] ∈ ℂ by typecheck
  have succS := reciprocalGamma.succ with hs
  have succN := reciprocalGamma.succ with negated
  have back : ℂ[-s + 1] = ℂ[1 - s] by ring
  rw back at succN
  have shape : ℂ[1 - (s + 1)] = ℂ[-s] by ring
  rw [(reflectionProduct.value with shifted), (reflectionProduct.value with hs),
    shape]
  have r1 := reciprocalGamma.member at s
  have r2 := reciprocalGamma.member at ℂ[s + 1]
  have r3 := reciprocalGamma.member at ℂ[-s]
  have r4 := reciprocalGamma.member at ℂ[1 - s]
  have piMember : complexOfReal(realPi) ∈ ℂ by typecheck
  linear_combination (complexOfReal(realPi) * reciprocalGamma(ℂ[s + 1])) *
    succN + (complexOfReal(realPi) * reciprocalGamma(ℂ[1 - s])) * succS

theorem reflectionProduct.neg (s : Set)
  requires hs : s ∈ ℂ
  shows reflectionProduct(ℂ[-s]) = ℂ[-reflectionProduct(s)]
proof
  have negated : ℂ[-s] ∈ ℂ by typecheck
  have succS := reciprocalGamma.succ with hs
  have succN := reciprocalGamma.succ with negated
  have back : ℂ[-s + 1] = ℂ[1 - s] by ring
  rw back at succN
  have shape : ℂ[1 - -s] = ℂ[s + 1] by ring
  rw [(reflectionProduct.value with negated), (reflectionProduct.value with hs),
    shape]
  have r1 := reciprocalGamma.member at s
  have r2 := reciprocalGamma.member at ℂ[s + 1]
  have r3 := reciprocalGamma.member at ℂ[-s]
  have r4 := reciprocalGamma.member at ℂ[1 - s]
  have piMember : complexOfReal(realPi) ∈ ℂ by typecheck
  linear_combination (complexOfReal(realPi) * reciprocalGamma(ℂ[s + 1])) *
    succN + (complexOfReal(realPi) * reciprocalGamma(ℂ[1 - s])) * succS

-- h(2s) = 2 h(s) h(s + 1/2), from Legendre's duplication formula.
theorem reflectionProduct.double (s : Set)
  requires hs : s ∈ ℂ
  shows reflectionProduct(ℂ[2 * s]) = ℂ[2 * reflectionProduct(s) *
    reflectionProduct(s + complexOfReal(R[1 / 2]))]
proof
  have hf : complexOfReal(R[1 / 2]) ∈ ℂ by typecheck
  have halfDouble := complexHalf.double
  have double : ℂ[2 * s] ∈ ℂ by typecheck
  have shifted : ℂ[s + complexOfReal(R[1 / 2])] ∈ ℂ by typecheck
  have reflected : ℂ[complexOfReal(R[1 / 2]) - s] ∈ ℂ by typecheck
  have first := reciprocalGamma.duplication with hs
  have second := reciprocalGamma.duplication with reflected
  have e1 : ℂ[2 * (complexOfReal(R[1 / 2]) - s)] = ℂ[1 - 2 * s] by
    linear_combination halfDouble
  have e2 : ℂ[1 - 2 * (complexOfReal(R[1 / 2]) - s)] = ℂ[2 * s] by
    linear_combination (-1) * halfDouble
  have e3 : ℂ[complexOfReal(R[1 / 2]) - s + complexOfReal(R[1 / 2])] =
    ℂ[1 - s] by linear_combination halfDouble
  rw [e2, e1, e3] at second
  have e4 : ℂ[1 - (s + complexOfReal(R[1 / 2]))] =
    ℂ[complexOfReal(R[1 / 2]) - s] by linear_combination (-1) * halfDouble
  rw [(reflectionProduct.value with double), (reflectionProduct.value with hs),
    (reflectionProduct.value with shifted), e4]
  -- 2^(1−2s) 2^(2s) = 2 and √π √π = π.
  have v : ℂ[1 - 2 * s] ∈ ℂ by typecheck
  have powers := realCpow.add at R[2], ℂ[1 - 2 * s], ℂ[2 * s] with v, double
  have exponent : ℂ[1 - 2 * s + 2 * s] = ℂ[1] by ring
  have twoPositive : R[0] < R[2] by linarith
  rw [exponent, (realCpow.one with twoPositive), complexOfReal.two] at powers
  have piPositive := realPi.positive
  have piNonnegative : R[0] ≤ realPi by linarith
  have rootSquare := realSqrt.square with piNonnegative
  have root : ℂ[complexOfReal(realSqrt(realPi)) *
      complexOfReal(realSqrt(realPi))] = complexOfReal(realPi)
    rw [← complexOfReal.mul, rootSquare]
  have p1 := realCpow.member at R[2], ℂ[1 - 2 * s] with v
  have p2 := realCpow.member at R[2], ℂ[2 * s] with double
  have q : complexOfReal(realSqrt(realPi)) ∈ ℂ by typecheck
  have piMember : complexOfReal(realPi) ∈ ℂ by typecheck
  have r1 := reciprocalGamma.member at s
  have r2 := reciprocalGamma.member at ℂ[1 - s]
  have r3 := reciprocalGamma.member at ℂ[s + complexOfReal(R[1 / 2])]
  have r4 := reciprocalGamma.member at ℂ[complexOfReal(R[1 / 2]) - s]
  have r5 := reciprocalGamma.member at ℂ[2 * s]
  have r6 := reciprocalGamma.member at ℂ[1 - 2 * s]
  linear_combination (complexOfReal(realPi) * reciprocalGamma(ℂ[1 - 2 * s])) *
    first + (complexOfReal(realPi) * realCpow(R[2], ℂ[1 - 2 * s]) *
    complexOfReal(realSqrt(realPi)) * reciprocalGamma(s) *
    reciprocalGamma(ℂ[s + complexOfReal(R[1 / 2])])) * second +
    (-(complexOfReal(realPi) * complexOfReal(realSqrt(realPi)) *
    complexOfReal(realSqrt(realPi)) * reciprocalGamma(s) *
    reciprocalGamma(ℂ[s + complexOfReal(R[1 / 2])]) *
    reciprocalGamma(ℂ[complexOfReal(R[1 / 2]) - s]) *
    reciprocalGamma(ℂ[1 - s]))) * powers +
    (2 * complexOfReal(realPi) * reciprocalGamma(s) *
    reciprocalGamma(ℂ[s + complexOfReal(R[1 / 2])]) *
    reciprocalGamma(ℂ[complexOfReal(R[1 / 2]) - s]) *
    reciprocalGamma(ℂ[1 - s])) * root

-- sin(π) = 0, cos(π) = −1, sin(π/2) = 1, cos(π/2) = 0 as complex values.
theorem complexSin.pi_values
  shows complexSin(complexOfReal(realPi)) = ℂ[0] ∧
    complexCos(complexOfReal(realPi)) = ℂ[-1] ∧
    complexSin(ℂ[complexOfReal(realPi) * complexOfReal(R[1 / 2])]) = ℂ[1] ∧
    complexCos(ℂ[complexOfReal(realPi) * complexOfReal(R[1 / 2])]) = ℂ[0]
proof
  have halfPi : ℂ[complexOfReal(realPi) * complexOfReal(R[1 / 2])] =
      complexOfReal(realHalfPi)
    rw ← complexOfReal.mul
    unfold realPi
    have same : R[2 * realHalfPi * (1 / 2)] = realHalfPi by ring
    rw same
  rw [halfPi, realSin.of_real, realCos.of_real, realSin.of_real,
    realCos.of_real, realSin.pi, realCos.pi, realSin.half_pi, realHalfPi.cos,
    complexOfReal.zero, complexOfReal.one, complexOfReal.neg,
    complexOfReal.one]
  exact ⟨rfl, rfl, rfl, rfl⟩

-- S(s + 1) = −S(s), S(−s) = −S(s), S(s + 1/2) = cos(πs), and
-- S(2s) = 2 S(s) S(s + 1/2).
theorem sinPi.shift (s : Set)
  requires hs : s ∈ ℂ
  shows sinPi(ℂ[s + 1]) = ℂ[-sinPi(s)]
proof
  have shifted : ℂ[s + 1] ∈ ℂ by typecheck
  have values := complexSin.pi_values
  obtain ⟨sinPiZero, cosPi, _, _⟩ := values
  have piMember : complexOfReal(realPi) ∈ ℂ by typecheck
  have point : ℂ[complexOfReal(realPi) * s] ∈ ℂ by typecheck
  have shape : ℂ[complexOfReal(realPi) * (s + 1)] =
    ℂ[complexOfReal(realPi) * s + complexOfReal(realPi)] by ring
  rw [(sinPi.value with shifted), (sinPi.value with hs), shape,
    (complexSin.add with point, piMember), sinPiZero, cosPi]
  have sinMember := complexSin.member with point
  have cosMember := complexCos.member with point
  ring

theorem sinPi.neg (s : Set)
  requires hs : s ∈ ℂ
  shows sinPi(ℂ[-s]) = ℂ[-sinPi(s)]
proof
  have negated : ℂ[-s] ∈ ℂ by typecheck
  have point : ℂ[complexOfReal(realPi) * s] ∈ ℂ by typecheck
  have shape : ℂ[complexOfReal(realPi) * -s] =
    ℂ[-(complexOfReal(realPi) * s)] by ring
  rw [(sinPi.value with negated), (sinPi.value with hs), shape,
    (complexSin.neg with point)]

theorem sinPi.half_shift (s : Set)
  requires hs : s ∈ ℂ
  shows sinPi(ℂ[s + complexOfReal(R[1 / 2])]) =
    complexCos(ℂ[complexOfReal(realPi) * s])
proof
  have shifted : ℂ[s + complexOfReal(R[1 / 2])] ∈ ℂ by typecheck
  have values := complexSin.pi_values
  obtain ⟨_, _, sinHalf, cosHalf⟩ := values
  have point : ℂ[complexOfReal(realPi) * s] ∈ ℂ by typecheck
  have halfPoint : ℂ[complexOfReal(realPi) * complexOfReal(R[1 / 2])] ∈ ℂ
    by typecheck
  have shape : ℂ[complexOfReal(realPi) * (s + complexOfReal(R[1 / 2]))] =
    ℂ[complexOfReal(realPi) * s +
      complexOfReal(realPi) * complexOfReal(R[1 / 2])] by ring
  rw [(sinPi.value with shifted), shape,
    (complexSin.add with point, halfPoint), sinHalf, cosHalf]
  have sinMember := complexSin.member with point
  have cosMember := complexCos.member with point
  ring

theorem sinPi.double (s : Set)
  requires hs : s ∈ ℂ
  shows sinPi(ℂ[2 * s]) = ℂ[2 * sinPi(s) *
    sinPi(s + complexOfReal(R[1 / 2]))]
proof
  have double : ℂ[2 * s] ∈ ℂ by typecheck
  have point : ℂ[complexOfReal(realPi) * s] ∈ ℂ by typecheck
  have shape : ℂ[complexOfReal(realPi) * (2 * s)] =
    ℂ[complexOfReal(realPi) * s + complexOfReal(realPi) * s] by ring
  rw [(sinPi.half_shift with hs), (sinPi.value with double),
    (sinPi.value with hs), shape, (complexSin.add with point, point)]
  have sinMember := complexSin.member with point
  have cosMember := complexCos.member with point
  ring

-- The zeros of S are the integers m − n.
theorem sinPi.zero_shape (a : Set)
  requires ha : a ∈ ℂ
  requires zero : sinPi(a) = ℂ[0]
  shows ∃ m ∈ ℕ, ∃ n ∈ ℕ,
    a = ℂ[complexOfReal(realNat(m)) - complexOfReal(realNat(n))]
proof
  have iMember := complexImaginaryUnit.member
  have iSquare := complexImaginaryUnit.square
  have piMember : complexOfReal(realPi) ∈ ℂ by typecheck
  have point : ℂ[complexOfReal(realPi) * a] ∈ ℂ by typecheck
  have inner : ℂ[complexImaginaryUnit * (complexOfReal(realPi) * a)] ∈ ℂ by
    typecheck
  have negInner : ℂ[-(complexImaginaryUnit * (complexOfReal(realPi) * a))]
    ∈ ℂ by typecheck
  rw [(sinPi.value with ha), (complexSin.formula with point)] at zero
  have two : ℂ[2] ∈ ℂ by typecheck
  have twoNonzero : ℂ[2] ≠ ℂ[0]
    intro same
    rw [← complexOfReal.two, ← complexOfReal.zero] at same
    have equalReal := complexOfReal.injective with same
    linarith
  have cancel := complexInv.mul_cancel with two, twoNonzero
  have inverse := complexInv.member with two
  have e1 := complexExp.member with inner
  have e2 := complexExp.member with negInner
  -- e^(iπa) = e^(−iπa), so e^(2iπa) = 1.
  have equal : ℂ[complexExp(complexImaginaryUnit * (complexOfReal(realPi) * a))
      - complexExp(-(complexImaginaryUnit * (complexOfReal(realPi) * a)))] =
      ℂ[0] by
    linear_combination (2 * complexImaginaryUnit) * zero +
      (2 * complexInv(ℂ[2]) *
      (complexExp(complexImaginaryUnit * (complexOfReal(realPi) * a)) -
      complexExp(-(complexImaginaryUnit * (complexOfReal(realPi) * a))))) *
      iSquare -
      (complexExp(complexImaginaryUnit * (complexOfReal(realPi) * a)) -
      complexExp(-(complexImaginaryUnit * (complexOfReal(realPi) * a)))) *
      cancel
  have product := complexExp.neg with inner
  have doubled := complexExp.add with inner, inner
  have exponentOne : complexExp(ℂ[complexImaginaryUnit *
      (complexOfReal(realPi) * a) + complexImaginaryUnit *
      (complexOfReal(realPi) * a)]) = ℂ[1]
    rw doubled
    linear_combination complexExp(ℂ[complexImaginaryUnit *
      (complexOfReal(realPi) * a)]) * equal + product
  have sum : ℂ[complexImaginaryUnit * (complexOfReal(realPi) * a) +
      complexImaginaryUnit * (complexOfReal(realPi) * a)] ∈ ℂ by typecheck
  obtain ⟨k, hk, shape⟩ := (complexExp.eq_one_iff with sum).forward with
    exponentOne
  have kReal : realInt(k) ∈ ℝ by typecheck
  rw [complexOfReal.mul, complexOfReal.mul, complexOfReal.two] at shape
  have kMember : complexOfReal(realInt(k)) ∈ ℂ by typecheck
  -- 2iπ (a − k) = 0 with 2iπ ≠ 0.
  have piNonzero : complexOfReal(realPi) ≠ ℂ[0]
    intro same
    rw ← complexOfReal.zero at same
    have equalReal := complexOfReal.injective with same
    have positive := realPi.positive
    linarith
  have iNonzero : complexImaginaryUnit ≠ ℂ[0]
    intro same
    rw same at iSquare
    have one := gammaComplex.one_nonzero
    apply one
    linear_combination iSquare
  have first := gammaComplex.mul_nonzero with two, iMember, twoNonzero,
    iNonzero
  have twoI : ℂ[2 * complexImaginaryUnit] ∈ ℂ by typecheck
  have factor := gammaComplex.mul_nonzero with twoI, piMember, first,
    piNonzero
  have difference : ℂ[a - complexOfReal(realInt(k))] ∈ ℂ by typecheck
  have vanish : ℂ[(2 * complexImaginaryUnit * complexOfReal(realPi)) *
      (a - complexOfReal(realInt(k)))] = ℂ[0] by
    linear_combination shape
  have coefficient : ℂ[2 * complexImaginaryUnit * complexOfReal(realPi)] ∈ ℂ
    by typecheck
  have zeroDiff := GRH.Holomorphic.complexMul.cancel_left with coefficient,
    difference, factor, vanish
  have image : ∃ z ∈ ℤ, realInt(k) = realInt(z) := ⟨k, hk, rfl⟩
  obtain ⟨m, hm, n, hn, kShape⟩ := realInt.range.forward with image
  refine ⟨m, hm, n, hn, ?_⟩
  have natM : Nat(m) := nat.omega.backward with hm
  have natN : Nat(n) := nat.omega.backward with hn
  have realM : realNat(m) ∈ ℝ by typecheck
  have realN : realNat(n) ∈ ℝ by typecheck
  have kValue : realInt(k) = R[realNat(m) - realNat(n)] by linarith
  rw [kValue, complexOfReal.sub] at zeroDiff
  linear_combination zeroDiff

-- S vanishes at the naturals.
theorem sinPi.nat (n : Nat)
  shows sinPi(complexOfReal(realNat(n))) = ℂ[0]
proof
  have point : complexOfReal(realNat(n)) ∈ ℂ by typecheck
  have shape : ℂ[complexOfReal(realPi) * complexOfReal(realNat(n))] =
      complexOfReal(R[realNat(n) * realPi])
    rw complexOfReal.mul
    have piMember : complexOfReal(realPi) ∈ ℂ by typecheck
    ring
  rw [(sinPi.value with point), shape, realSin.of_real, realSin.nat_pi,
    complexOfReal.zero]

-- h vanishes at the integers m − n.
theorem reflectionProduct.integer (m n : Nat)
  shows reflectionProduct(ℂ[complexOfReal(realNat(m)) -
    complexOfReal(realNat(n))]) = ℂ[0]
proof
  induction m
  | zero =>
    have hn : n ∈ ℕ by typecheck
    have shape : ℂ[complexOfReal(realNat(0)) - complexOfReal(realNat(n))] =
        ℂ[-complexOfReal(realNat(n))]
      rw [realNat.zero, complexOfReal.zero]
      have cast : complexOfReal(realNat(n)) ∈ ℂ by typecheck
      ring
    have point : ℂ[-complexOfReal(realNat(n))] ∈ ℂ by typecheck
    have pole : ℂ[-complexOfReal(realNat(n))] ∈ gammaPoles
      apply gammaPoles.membership.backward
      exact ⟨point, n, hn, rfl⟩
    have vanish := (reciprocalGamma.zero_iff with point).backward with pole
    have second := reciprocalGamma.member at ℂ[1 - -complexOfReal(realNat(n))]
    rw [shape, (reflectionProduct.value with point), vanish]
    ring
  | succ(k) using ih =>
    have point : ℂ[complexOfReal(realNat(k)) - complexOfReal(realNat(n))] ∈ ℂ
      by typecheck
    have shape : ℂ[complexOfReal(realNat(succ(k))) -
        complexOfReal(realNat(n))] =
        ℂ[(complexOfReal(realNat(k)) - complexOfReal(realNat(n))) + 1]
      rw complexOfReal.nat_succ
      have castK : complexOfReal(realNat(k)) ∈ ℂ by typecheck
      have castN : complexOfReal(realNat(n)) ∈ ℂ by typecheck
      ring
    rw [shape, (reflectionProduct.shift with point), ih]
    ring

-- The zeros of h lie among those of S.
theorem reflectionProduct.zero_sin (s : Set)
  requires hs : s ∈ ℂ
  requires zero : reflectionProduct(s) = ℂ[0]
  shows sinPi(s) = ℂ[0]
proof
  rw (reflectionProduct.value with hs) at zero
  have piMember : complexOfReal(realPi) ∈ ℂ by typecheck
  have reflected : ℂ[1 - s] ∈ ℂ by typecheck
  have r1 := reciprocalGamma.member at s
  have r2 := reciprocalGamma.member at ℂ[1 - s]
  by_cases first : reciprocalGamma(s) = ℂ[0]
  . have pole := (reciprocalGamma.zero_iff with hs).forward with first
    obtain ⟨_, n, hn, shape⟩ := gammaPoles.membership.forward with pole
    have natN : Nat(n) := nat.omega.backward with hn
    have point : complexOfReal(realNat(n)) ∈ ℂ by typecheck
    rw [shape, (sinPi.neg with point), sinPi.nat]
    ring
  . by_cases second : reciprocalGamma(ℂ[1 - s]) = ℂ[0]
    . have pole := (reciprocalGamma.zero_iff with reflected).forward with
        second
      obtain ⟨_, n, hn, shape⟩ := gammaPoles.membership.forward with pole
      have natN : Nat(n) := nat.omega.backward with hn
      have point : complexOfReal(realNat(n)) ∈ ℂ by typecheck
      have sShape : s = ℂ[complexOfReal(realNat(n)) + 1] by
        linear_combination (-1) * shape
      rw [sShape, (sinPi.shift with point), sinPi.nat]
      ring
    . exfalso
      have piNonzero : complexOfReal(realPi) ≠ ℂ[0]
        intro same
        rw ← complexOfReal.zero at same
        have equalReal := complexOfReal.injective with same
        have positive := realPi.positive
        linarith
      have partial := gammaComplex.mul_nonzero with piMember, r1, piNonzero,
        first
      have product : ℂ[complexOfReal(realPi) * reciprocalGamma(s)] ∈ ℂ by
        typecheck
      have whole := gammaComplex.mul_nonzero with product, r2, partial, second
      exact whole with zero

-- A continuous function on ℂ that does not vanish at a does not vanish on a
-- disk about a.
theorem HolomorphicOn.nonzero_near (f a : Set)
  requires holomorphic : HolomorphicOn(f, complexCarrier)
  requires ha : a ∈ ℂ
  requires nonzero : f(a) ≠ ℂ[0]
  shows ∃ d ∈ ℝ, R[0] < d ∧ (∀ w ∈ complexDisk(a, d), f(w) ≠ ℂ[0])
proof
  have continuous := HolomorphicOn.continuous with holomorphic
  obtain ⟨_, values, close⟩ := continuous
  have fa := values with a, ha
  have positive := complexAbs.positive with fa, nonzero
  have absReal := complexAbs.real with fa
  obtain ⟨d, hd, dPositive, near⟩ := close with a, ha, complexAbs(f(a)),
    absReal, positive
  refine ⟨d, hd, dPositive, ?_⟩
  intros w hw zero
  obtain ⟨wMember, wNear⟩ := complexDisk.membership.forward with hw
  have bound := near with w, wMember, wNear
  rw zero at bound
  have same : ℂ[0 - f(a)] = ℂ[-f(a)] by ring
  rw [same, (complexAbs.neg with fa)] at bound
  have irreflexive := realLess.irreflexive_on
  exact irreflexive with complexAbs(f(a)), bound

-- A function that is a quotient N/M of entire functions on a disk where M
-- does not vanish is holomorphic on that disk.
theorem HolomorphicOn.local_quotient (q N M a d : Set)
  requires holomorphicN : HolomorphicOn(N, complexCarrier)
  requires holomorphicM : HolomorphicOn(M, complexCarrier)
  requires ha : a ∈ ℂ
  requires hd : d ∈ ℝ
  requires positive : R[0] < d
  requires nonvanishing : ∀ w ∈ complexDisk(a, d), M(w) ≠ ℂ[0]
  requires agree : ∀ w ∈ complexDisk(a, d), q(w) = complexDiv(N(w), M(w))
  shows ∃ V, ComplexOpen(V) ∧ a ∈ V ∧ V ⊆ complexCarrier ∧
    HolomorphicOn(q, V)
proof
  have isOpen := complexDisk.open with ha, hd
  have center := complexDisk.center with ha, hd, positive
  have inside := complexDisk.subset at a, d
  have n := HolomorphicOn.mono with holomorphicN, isOpen, inside
  have m := HolomorphicOn.mono with holomorphicM, isOpen, inside
  have quotient := HolomorphicOn.div with n, m, nonvanishing
  obtain ⟨_, nValues, _⟩ := n
  obtain ⟨_, mValues, _⟩ := m
  refine ⟨complexDisk(a, d), isOpen, center, inside, ?_⟩
  apply HolomorphicOn.congr with quotient
  intros w hw
  rw [(complexFunctionDiv.value with nValues, mValues, hw), (agree with w, hw)]

-- The quotient q = h/S, with the value h'(a)/S'(a) at the zeros a of S.
defunique reflectionQuotientValue (s : Set) (v ∈ complexCarrier) :=
  (sinPi(s) ≠ ℂ[0] → v = complexDiv(reflectionProduct(s), sinPi(s))) ∧
  (sinPi(s) = ℂ[0] → v = complexDiv(
    complexDeriv(reflectionProduct, complexCarrier)(s),
    ℂ[complexOfReal(realPi) * complexCos(ℂ[complexOfReal(realPi) * s])]))
requires hs : s ∈ complexCarrier
proof
  have analytic := reflectionProduct.analytic
  obtain ⟨holomorphic, _⟩ := analytic
  have hValue := FunctionBetween.apply_closed with reflectionProduct.function,
    hs
  have sValue := FunctionBetween.apply_closed with sinPi.function, hs
  have dValue := FunctionBetween.apply_closed with
    (complexDeriv.function with holomorphic), hs
  have point : ℂ[complexOfReal(realPi) * s] ∈ ℂ by typecheck
  have cosValue := complexCos.member with point
  have slope : ℂ[complexOfReal(realPi) *
    complexCos(ℂ[complexOfReal(realPi) * s])] ∈ ℂ by typecheck
  by_cases zero : sinPi(s) = ℂ[0]
  . have inverse := complexInv.member with slope
    have member : complexDiv(complexDeriv(reflectionProduct, complexCarrier)(s),
        ℂ[complexOfReal(realPi) * complexCos(ℂ[complexOfReal(realPi) * s])])
        ∈ ℂ
      unfold complexDiv
      typecheck
    refine ⟨complexDiv(complexDeriv(reflectionProduct, complexCarrier)(s),
      ℂ[complexOfReal(realPi) * complexCos(ℂ[complexOfReal(realPi) * s])]),
      member, ?_, ?_⟩
    . intro nonzero
      exfalso
      exact nonzero with zero
    . intro _
      rfl
  . have inverse := complexInv.member with sValue
    have member : complexDiv(reflectionProduct(s), sinPi(s)) ∈ ℂ
      unfold complexDiv
      typecheck
    refine ⟨complexDiv(reflectionProduct(s), sinPi(s)), member, ?_, ?_⟩
    . intro _
      rfl
    . intro same
      exfalso
      exact zero with same
uniqueness
  intros v hv first w hw second
  obtain ⟨away1, at1⟩ := first
  obtain ⟨away2, at2⟩ := second
  by_cases zero : sinPi(s) = ℂ[0]
  . rw [(at1 with zero), (at2 with zero)]
  . rw [(away1 with zero), (away2 with zero)]

defgraph reflectionQuotient (s ∈ complexCarrier) : complexCarrier :=
    reflectionQuotientValue(s)
proof
  have selected := reflectionQuotientValue.selected with member
  exact selected.left

theorem reflectionQuotient.away (s : Set)
  requires hs : s ∈ ℂ
  requires nonzero : sinPi(s) ≠ ℂ[0]
  shows reflectionQuotient(s) = complexDiv(reflectionProduct(s), sinPi(s))
proof
  have selected := reflectionQuotientValue.selected with hs
  obtain ⟨_, away, _⟩ := selected
  rw (reflectionQuotient.value with hs)
  exact away with nonzero

theorem reflectionQuotient.at_zero (s : Set)
  requires hs : s ∈ ℂ
  requires zero : sinPi(s) = ℂ[0]
  shows reflectionQuotient(s) = complexDiv(
    complexDeriv(reflectionProduct, complexCarrier)(s),
    ℂ[complexOfReal(realPi) * complexCos(ℂ[complexOfReal(realPi) * s])])
proof
  have selected := reflectionQuotientValue.selected with hs
  obtain ⟨_, _, atZero⟩ := selected
  rw (reflectionQuotient.value with hs)
  exact atZero with zero

-- S'(a) = π cos(πa) ≠ 0 at a zero a of S.
theorem sinPi.slope_nonzero (a : Set)
  requires ha : a ∈ ℂ
  requires zero : sinPi(a) = ℂ[0]
  shows ℂ[complexOfReal(realPi) * complexCos(ℂ[complexOfReal(realPi) * a])]
    ≠ ℂ[0]
proof
  have point : ℂ[complexOfReal(realPi) * a] ∈ ℂ by typecheck
  have piMember : complexOfReal(realPi) ∈ ℂ by typecheck
  have identity := complexSin.square_add_cos_square with point
  rw [(sinPi.value with ha)] at zero
  rw zero at identity
  have cosMember := complexCos.member with point
  have cosNonzero : complexCos(ℂ[complexOfReal(realPi) * a]) ≠ ℂ[0]
    intro same
    rw same at identity
    have one := gammaComplex.one_nonzero
    apply one
    linear_combination (-1) * identity
  have piNonzero : complexOfReal(realPi) ≠ ℂ[0]
    intro same
    rw ← complexOfReal.zero at same
    have equalReal := complexOfReal.injective with same
    have positive := realPi.positive
    linarith
  exact gammaComplex.mul_nonzero with piMember, cosMember, piNonzero,
    cosNonzero

-- q is entire: near a zero a of S, q = H/Σ for the slopes H, Σ of h and S
-- at a.
theorem reflectionQuotient.holomorphic
  shows HolomorphicOn(reflectionQuotient, complexCarrier)
proof
  have analytic := reflectionProduct.analytic
  obtain ⟨hHolomorphic, _⟩ := analytic
  have sHolomorphic := sinPi.holomorphic
  have copyH := hHolomorphic
  obtain ⟨_, hValues, _⟩ := copyH
  have copyS := sHolomorphic
  obtain ⟨_, sValues, _⟩ := copyS
  have whole := ComplexOpen.whole
  apply HolomorphicOn.of_local with whole
  intros a ha
  by_cases zero : sinPi(a) = ℂ[0]
  . have slopeH := slopeFunction.holomorphic with hHolomorphic, ha
    have slopeS := slopeFunction.holomorphic with sHolomorphic, ha
    have derivativeH := complexDeriv.has_derivative with hHolomorphic, ha
    have copyDH := derivativeH
    obtain ⟨_, _, hD, _, _⟩ := copyDH
    have derivativeS := complexDeriv.has_derivative with sHolomorphic, ha
    have copyDS := derivativeS
    obtain ⟨_, _, sD, _, _⟩ := copyDS
    have sSame := HasComplexDerivativeAt.unique with derivativeS,
      (sinPi.has_derivative with ha)
    have slopeNonzero := sinPi.slope_nonzero with ha, zero
    have centerS := slopeFunction.center with sValues, ha, sD
    have centerH := slopeFunction.center with hValues, ha, hD
    have sigmaNonzero : slopeFunction(sinPi, a,
        complexDeriv(sinPi, complexCarrier)(a))(a) ≠ ℂ[0]
      rwa [centerS, sSame]
    obtain ⟨d, hd, dPositive, near⟩ := HolomorphicOn.nonzero_near with slopeS,
      ha, sigmaNonzero
    obtain ⟨m, hm, n, hn, shape⟩ := sinPi.zero_shape with ha, zero
    have natM : Nat(m) := nat.omega.backward with hm
    have natN : Nat(n) := nat.omega.backward with hn
    have hZero := reflectionProduct.integer at m, n
    rw ← shape at hZero
    apply HolomorphicOn.local_quotient with slopeH, slopeS, ha, hd, dPositive,
      near
    intros w hw
    obtain ⟨wMember, _⟩ := complexDisk.membership.forward with hw
    have equal : w = a ∨ w ≠ a by tauto
    cases equal with same | distinct
    . rw [same, (reflectionQuotient.at_zero with ha, zero), centerH, centerS,
        sSame]
    . have punctured : w ∈ complexCarrier ∖ {a}
        apply difference.membership.backward
        refine ⟨wMember, ?_⟩
        intro member
        exact distinct with (singleton.membership.forward with member)
      have sigmaW := near with w, hw
      have awayH := slopeFunction.away with hValues, ha, hD, punctured
      have awayS := slopeFunction.away with sValues, ha, sD, punctured
      rw [hZero] at awayH
      rw [zero] at awayS
      have hValueW := hValues with w, wMember
      have sw := sValues with w, wMember
      have difference : ℂ[w - a] ∈ ℂ by typecheck
      have inverse := complexInv.member with difference
      have sNonzero : sinPi(w) ≠ ℂ[0]
        intro vanish
        rw vanish at awayS
        apply sigmaW
        rw awayS
        ring
      rw (reflectionQuotient.away with wMember, sNonzero)
      have cancelA := complexDiv.mul_cancel with hValueW, sw, sNonzero
      have sigmaMember := FunctionBetween.apply_closed with
        (slopeFunction.function with sValues, ha, sD), wMember
      have etaMember := FunctionBetween.apply_closed with
        (slopeFunction.function with hValues, ha, hD), wMember
      have cancelB := complexDiv.mul_cancel with etaMember, sigmaMember,
        sigmaW
      have divA : complexDiv(reflectionProduct(w), sinPi(w)) ∈ ℂ
        have inv := complexInv.member with sw
        unfold complexDiv
        typecheck
      have divB : complexDiv(slopeFunction(reflectionProduct, a,
          complexDeriv(reflectionProduct, complexCarrier)(a))(w),
          slopeFunction(sinPi, a, complexDeriv(sinPi, complexCarrier)(a))(w))
          ∈ ℂ
        have inv := complexInv.member with sigmaMember
        unfold complexDiv
        typecheck
      have gap : ℂ[complexDiv(reflectionProduct(w), sinPi(w)) -
        complexDiv(slopeFunction(reflectionProduct, a,
          complexDeriv(reflectionProduct, complexCarrier)(a))(w),
          slopeFunction(sinPi, a, complexDeriv(sinPi, complexCarrier)(a))(w))]
          ∈ ℂ by typecheck
      have product : ℂ[slopeFunction(sinPi, a,
          complexDeriv(sinPi, complexCarrier)(a))(w) *
          (complexDiv(reflectionProduct(w), sinPi(w)) -
          complexDiv(slopeFunction(reflectionProduct, a,
          complexDeriv(reflectionProduct, complexCarrier)(a))(w),
          slopeFunction(sinPi, a, complexDeriv(sinPi, complexCarrier)(a))(w)))]
          = ℂ[0]
        linear_combination complexDiv(reflectionProduct(w), sinPi(w)) *
          awayS + complexInv(ℂ[w - a]) * cancelA - awayH - cancelB
      have vanish := GRH.Holomorphic.complexMul.cancel_left with sigmaMember,
        gap, sigmaW, product
      linear_combination vanish
  . obtain ⟨d, hd, dPositive, near⟩ := HolomorphicOn.nonzero_near with
      sHolomorphic, ha, zero
    apply HolomorphicOn.local_quotient with hHolomorphic, sHolomorphic, ha, hd,
      dPositive, near
    intros w hw
    obtain ⟨wMember, _⟩ := complexDisk.membership.forward with hw
    exact reflectionQuotient.away with wMember, (near with w, hw)

-- S does not vanish at the real points of (0, 1).
theorem sinPi.segment_nonzero (X : Real)
  requires positive : R[0] < X
  requires below : X < R[1]
  shows sinPi(complexOfReal(X)) ≠ ℂ[0]
proof
  have point : complexOfReal(X) ∈ ℂ by typecheck
  have piPositive := realPi.positive
  have lower := realLess.mul_right_of_positive with positive, piPositive
  have upper := realLess.mul_right_of_positive with below, piPositive
  have zeroProduct : R[0 * realPi] = R[0] by ring
  have oneProduct : R[1 * realPi] = realPi by ring
  have lowerAngle : R[0] < R[X * realPi] by linarith
  have upperAngle : R[X * realPi] < realPi by linarith
  have sinPositive := realSin.positive_below_pi with lowerAngle, upperAngle
  have shape : ℂ[complexOfReal(realPi) * complexOfReal(X)] =
      complexOfReal(R[X * realPi])
    rw complexOfReal.mul
    have piMember : complexOfReal(realPi) ∈ ℂ by typecheck
    ring
  rw [(sinPi.value with point), shape, realSin.of_real]
  intro zero
  rw ← complexOfReal.zero at zero
  have equal := complexOfReal.injective with zero
  linarith

-- q(s + 1) = q(s), q(−s) = q(s), and q(2s) = q(s) q(s + 1/2), everywhere:
-- on (0, 1/2) from the relations of h and S, and then by the identity
-- theorem.
theorem reflectionQuotient.relations
  shows (∀ s ∈ ℂ, reflectionQuotient(ℂ[s + 1]) = reflectionQuotient(s)) ∧
    (∀ s ∈ ℂ, reflectionQuotient(ℂ[-s]) = reflectionQuotient(s)) ∧
    (∀ s ∈ ℂ, reflectionQuotient(ℂ[2 * s]) = ℂ[reflectionQuotient(s) *
      reflectionQuotient(s + complexOfReal(R[1 / 2]))])
proof
  have q := reflectionQuotient.holomorphic
  have copyQ := q
  obtain ⟨whole, values, _⟩ := copyQ
  have one : ℂ[1] ∈ ℂ by typecheck
  have minusOne : ℂ[-1] ∈ ℂ by typecheck
  have two : ℂ[2] ∈ ℂ by typecheck
  have zero : ℂ[0] ∈ ℂ by typecheck
  have hf : complexOfReal(R[1 / 2]) ∈ ℂ by typecheck
  have halfDouble := complexHalf.double
  have values2 : ComplexValuedOn(reflectionProduct, complexCarrier)
    intros z hz
    exact FunctionBetween.apply_closed with reflectionProduct.function, hz
  have valuesS : ComplexValuedOn(sinPi, complexCarrier)
    intros z hz
    exact FunctionBetween.apply_closed with sinPi.function, hz
  refine ⟨?_, ?_, ?_⟩
  . have shifted := affineComp.holomorphic with q, one, one
    have segment : ∀ X ∈ ℝ, R[0] < X → X < R[1 / 2] →
        affineComp(reflectionQuotient, ℂ[1], ℂ[1])(complexOfReal(X)) =
        reflectionQuotient(complexOfReal(X))
      intros X hX positive below
      have point : complexOfReal(X) ∈ ℂ by typecheck
      have shiftedPoint : ℂ[complexOfReal(X) + 1] ∈ ℂ by typecheck
      have belowOne : X < R[1] by linarith
      have nonzero := sinPi.segment_nonzero with positive, belowOne
      have shiftS := sinPi.shift with point
      have shiftH := reflectionProduct.shift with point
      have nonzeroShifted : sinPi(ℂ[complexOfReal(X) + 1]) ≠ ℂ[0]
        intro vanish
        apply nonzero
        rw vanish at shiftS
        linear_combination shiftS
      have shape : ℂ[1 * complexOfReal(X) + 1] = ℂ[complexOfReal(X) + 1] by
        ring
      have sX := valuesS with complexOfReal(X), point
      have hValue := values2 with complexOfReal(X), point
      rw [(affineComp.value with values, one, one, point), shape,
        (reflectionQuotient.away with shiftedPoint, nonzeroShifted),
        (reflectionQuotient.away with point, nonzero), shiftS, shiftH]
      unfold complexDiv
      rw (complexInv.neg with sX)
      have inverse := complexInv.member with sX
      ring
    have agree := HolomorphicOn.eq_of_segment with shifted, q, segment
    intros s hs
    have same := agree with s, hs
    rw (affineComp.value with values, one, one, hs) at same
    have shape : ℂ[1 * s + 1] = ℂ[s + 1] by ring
    rwa shape at same
  . have flipped := affineComp.holomorphic with q, minusOne, zero
    have segment : ∀ X ∈ ℝ, R[0] < X → X < R[1 / 2] →
        affineComp(reflectionQuotient, ℂ[-1], ℂ[0])(complexOfReal(X)) =
        reflectionQuotient(complexOfReal(X))
      intros X hX positive below
      have point : complexOfReal(X) ∈ ℂ by typecheck
      have flippedPoint : ℂ[-complexOfReal(X)] ∈ ℂ by typecheck
      have belowOne : X < R[1] by linarith
      have nonzero := sinPi.segment_nonzero with positive, belowOne
      have negS := sinPi.neg with point
      have negH := reflectionProduct.neg with point
      have nonzeroFlipped : sinPi(ℂ[-complexOfReal(X)]) ≠ ℂ[0]
        intro vanish
        apply nonzero
        rw vanish at negS
        linear_combination negS
      have shape : ℂ[-1 * complexOfReal(X) + 0] = ℂ[-complexOfReal(X)] by
        ring
      have sX := valuesS with complexOfReal(X), point
      rw [(affineComp.value with values, minusOne, zero, point), shape,
        (reflectionQuotient.away with flippedPoint, nonzeroFlipped),
        (reflectionQuotient.away with point, nonzero), negS, negH]
      unfold complexDiv
      rw (complexInv.neg with sX)
      have inverse := complexInv.member with sX
      have hValue := values2 with complexOfReal(X), point
      ring
    have agree := HolomorphicOn.eq_of_segment with flipped, q, segment
    intros s hs
    have same := agree with s, hs
    rw (affineComp.value with values, minusOne, zero, hs) at same
    have shape : ℂ[-1 * s + 0] = ℂ[-s] by ring
    rwa shape at same
  . have doubled := affineComp.holomorphic with q, two, zero
    have halfShifted := affineComp.holomorphic with q, one, hf
    have product := HolomorphicOn.mul with q, halfShifted
    have copyH := halfShifted
    obtain ⟨_, valuesHalf, _⟩ := copyH
    have segment : ∀ X ∈ ℝ, R[0] < X → X < R[1 / 2] →
        affineComp(reflectionQuotient, ℂ[2], ℂ[0])(complexOfReal(X)) =
        complexFunctionMul(reflectionQuotient, affineComp(reflectionQuotient,
        ℂ[1], complexOfReal(R[1 / 2])), complexCarrier)(complexOfReal(X))
      intros X hX positive below
      have point : complexOfReal(X) ∈ ℂ by typecheck
      have doublePoint : ℂ[2 * complexOfReal(X)] ∈ ℂ by typecheck
      have halfPoint : ℂ[complexOfReal(X) + complexOfReal(R[1 / 2])] ∈ ℂ by
        typecheck
      have belowOne : X < R[1] by linarith
      have nonzero1 := sinPi.segment_nonzero with positive, belowOne
      have doubleReal : R[2 * X] ∈ ℝ by typecheck
      have doublePositive : R[0] < R[2 * X] by linarith
      have doubleBelow : R[2 * X] < R[1] by linarith
      have nonzero2 := sinPi.segment_nonzero with doublePositive, doubleBelow
      have halfReal : R[X + 1 / 2] ∈ ℝ by typecheck
      have halfPositive : R[0] < R[X + 1 / 2] by linarith
      have halfBelow : R[X + 1 / 2] < R[1] by linarith
      have nonzero3 := sinPi.segment_nonzero with halfPositive, halfBelow
      rw [complexOfReal.mul, complexOfReal.two] at nonzero2
      rw complexOfReal.add at nonzero3
      have shape1 : ℂ[2 * complexOfReal(X) + 0] = ℂ[2 * complexOfReal(X)] by
        ring
      have shape2 : ℂ[1 * complexOfReal(X) + complexOfReal(R[1 / 2])] =
        ℂ[complexOfReal(X) + complexOfReal(R[1 / 2])] by ring
      rw [(affineComp.value with values, two, zero, point), shape1,
        (complexFunctionMul.value with values, valuesHalf, point),
        (affineComp.value with values, one, hf, point), shape2,
        (reflectionQuotient.away with doublePoint, nonzero2),
        (reflectionQuotient.away with point, nonzero1),
        (reflectionQuotient.away with halfPoint, nonzero3),
        (sinPi.double with point), (reflectionProduct.double with point)]
      have s1 := valuesS with complexOfReal(X), point
      have s3 := valuesS with ℂ[complexOfReal(X) + complexOfReal(R[1 / 2])],
        halfPoint
      have h1 := values2 with complexOfReal(X), point
      have h3 := values2 with ℂ[complexOfReal(X) + complexOfReal(R[1 / 2])],
        halfPoint
      have twoS1 : ℂ[2 * sinPi(complexOfReal(X))] ∈ ℂ by typecheck
      unfold complexDiv
      rw [(complexInv.mul with twoS1, s3), (complexInv.mul with two, s1)]
      have twoNonzero : ℂ[2] ≠ ℂ[0]
        intro same
        rw [← complexOfReal.two, ← complexOfReal.zero] at same
        have equalReal := complexOfReal.injective with same
        linarith
      have cancel := complexInv.mul_cancel with two, twoNonzero
      have i1 := complexInv.member with s1
      have i2 := complexInv.member with two
      have i3 := complexInv.member with s3
      linear_combination (reflectionProduct(complexOfReal(X)) *
        reflectionProduct(ℂ[complexOfReal(X) + complexOfReal(R[1 / 2])]) *
        complexInv(sinPi(complexOfReal(X))) *
        complexInv(sinPi(ℂ[complexOfReal(X) + complexOfReal(R[1 / 2])]))) *
        cancel
    have agree := HolomorphicOn.eq_of_segment with doubled, product, segment
    intros s hs
    have same := agree with s, hs
    rw [(affineComp.value with values, two, zero, hs),
      (complexFunctionMul.value with values, valuesHalf, hs),
      (affineComp.value with values, one, hf, hs)] at same
    have shape1 : ℂ[2 * s + 0] = ℂ[2 * s] by ring
    have shape2 : ℂ[1 * s + complexOfReal(R[1 / 2])] =
      ℂ[s + complexOfReal(R[1 / 2])] by ring
    rwa [shape1, shape2] at same

-- q(0) = h'(0)/S'(0) = 1.
theorem reflectionQuotient.zero
  shows reflectionQuotient(ℂ[0]) = ℂ[1]
proof
  have zero : ℂ[0] ∈ ℂ by typecheck
  have piMember : complexOfReal(realPi) ∈ ℂ by typecheck
  have shape : ℂ[complexOfReal(realPi) * 0] = ℂ[0] by ring
  have sZero : sinPi(ℂ[0]) = ℂ[0]
    rw [(sinPi.value with zero), shape, complexSin.zero]
  rw (reflectionQuotient.at_zero with zero, sZero)
  have analytic := reflectionProduct.analytic
  obtain ⟨holomorphic, derivative⟩ := analytic
  have here := complexDeriv.has_derivative with holomorphic, zero
  have same := HasComplexDerivativeAt.unique with here, derivative
  have unit : ℂ[complexOfReal(realPi) * 1] = complexOfReal(realPi) by ring
  rw [same, shape, complexCos.zero, unit]
  have piNonzero : complexOfReal(realPi) ≠ ℂ[0]
    intro vanish
    rw ← complexOfReal.zero at vanish
    have equalReal := complexOfReal.injective with vanish
    have positive := realPi.positive
    linarith
  unfold complexDiv
  exact complexInv.mul_cancel with piMember, piNonzero

-- q(s + n) = q(s) for n natural.
theorem reflectionQuotient.shift_nat (s : Set) (n : Nat)
  requires hs : s ∈ ℂ
  shows reflectionQuotient(ℂ[s + complexOfReal(realNat(n))]) =
    reflectionQuotient(s)
proof
  induction n
  | zero =>
    rw [realNat.zero, complexOfReal.zero]
    have shape : ℂ[s + 0] = s by ring
    rw shape
  | succ(k) using ih =>
    have relations := reflectionQuotient.relations
    obtain ⟨periodic, _, _⟩ := relations
    have point : ℂ[s + complexOfReal(realNat(k))] ∈ ℂ by typecheck
    have cast : complexOfReal(realNat(k)) ∈ ℂ by typecheck
    rw complexOfReal.nat_succ
    have shape : ℂ[s + (complexOfReal(realNat(k)) + 1)] =
      ℂ[(s + complexOfReal(realNat(k))) + 1] by ring
    rw [shape, (periodic with ℂ[s + complexOfReal(realNat(k))], point), ih]

-- q has no zeros.
theorem reflectionQuotient.nonzero (s : Set)
  requires hs : s ∈ ℂ
  shows reflectionQuotient(s) ≠ ℂ[0]
proof
  by_cases zero : sinPi(s) = ℂ[0]
  . obtain ⟨m, hm, n, hn, shape⟩ := sinPi.zero_shape with hs, zero
    have natM : Nat(m) := nat.omega.backward with hm
    have natN : Nat(n) := nat.omega.backward with hn
    have back := reflectionQuotient.shift_nat at s, n with hs
    have castM : complexOfReal(realNat(m)) ∈ ℂ by typecheck
    have castN : complexOfReal(realNat(n)) ∈ ℂ by typecheck
    have sum : ℂ[s + complexOfReal(realNat(n))] =
        ℂ[0 + complexOfReal(realNat(m))]
      rw shape
      ring
    rw sum at back
    have zeroMember : ℂ[0] ∈ ℂ by typecheck
    have up := reflectionQuotient.shift_nat at ℂ[0], m with zeroMember
    rw [up, reflectionQuotient.zero] at back
    rw ← back
    exact gammaComplex.one_nonzero
  . rw (reflectionQuotient.away with hs, zero)
    have hValue := FunctionBetween.apply_closed with
      reflectionProduct.function, hs
    have sValue := FunctionBetween.apply_closed with sinPi.function, hs
    have hNonzero : reflectionProduct(s) ≠ ℂ[0]
      intro vanish
      exact zero with (reflectionProduct.zero_sin with hs, vanish)
    have inverse := complexInv.member with sValue
    have inverseNonzero := complexInv.nonzero with sValue, zero
    unfold complexDiv
    exact gammaComplex.mul_nonzero with hValue, inverse, hNonzero,
      inverseNonzero

-- The logarithmic derivative g = q'/q, entire since q has no zeros.
def reflectionLogDeriv : Set :=
  complexFunctionDiv(complexDeriv(reflectionQuotient, complexCarrier),
    reflectionQuotient, complexCarrier)

theorem reflectionLogDeriv.holomorphic
  shows HolomorphicOn(reflectionLogDeriv, complexCarrier) ∧
    (∀ z ∈ ℂ, reflectionLogDeriv(z) = complexDiv(
      complexDeriv(reflectionQuotient, complexCarrier)(z),
      reflectionQuotient(z)))
proof
  have q := reflectionQuotient.holomorphic
  have derivative := HolomorphicOn.deriv with q
  have nonvanishing : ∀ z ∈ ℂ, reflectionQuotient(z) ≠ ℂ[0]
    intros z hz
    exact reflectionQuotient.nonzero with hz
  have quotient := HolomorphicOn.div with derivative, q, nonvanishing
  obtain ⟨_, dValues, _⟩ := derivative
  obtain ⟨_, qValues, _⟩ := q
  unfold reflectionLogDeriv
  refine ⟨quotient, ?_⟩
  intros z hz
  exact complexFunctionDiv.value with dValues, qValues, hz

-- q'(0) = 0, since q is even.
theorem reflectionQuotient.deriv_zero
  shows complexDeriv(reflectionQuotient, complexCarrier)(ℂ[0]) = ℂ[0]
proof
  have q := reflectionQuotient.holomorphic
  have copyQ := q
  obtain ⟨_, values, _⟩ := copyQ
  have relations := reflectionQuotient.relations
  obtain ⟨_, even, _⟩ := relations
  have minusOne : ℂ[-1] ∈ ℂ by typecheck
  have zero : ℂ[0] ∈ ℂ by typecheck
  have shape : ℂ[-1 * 0 + 0] = ℂ[0] by ring
  have here := complexDeriv.has_derivative with q, zero
  have inner := here
  rw ← shape at inner
  have flipped := affineComp.has_derivative with values, minusOne, zero, zero,
    inner
  have agree : ∀ z ∈ ℂ, reflectionQuotient(z) =
      affineComp(reflectionQuotient, ℂ[-1], ℂ[0])(z)
    intros z hz
    rw (affineComp.value with values, minusOne, zero, hz)
    have shapeZ : ℂ[-1 * z + 0] = ℂ[-z] by ring
    rw [shapeZ, (even with z, hz)]
  have moved := HasComplexDerivativeAt.congr with here, agree
  have equal := HasComplexDerivativeAt.unique with moved, flipped
  rw shape at equal
  have halfDouble := complexHalf.double
  have hf : complexOfReal(R[1 / 2]) ∈ ℂ by typecheck
  have value := FunctionBetween.apply_closed with
    (complexDeriv.function with q), zero
  linear_combination complexOfReal(R[1 / 2]) * equal -
    complexDeriv(reflectionQuotient, complexCarrier)(ℂ[0]) * halfDouble

-- 2 g(2s) = g(s) + g(s + 1/2), from q(2s) = q(s) q(s + 1/2).
theorem reflectionLogDeriv.double (s : Set)
  requires hs : s ∈ ℂ
  shows ℂ[2 * reflectionLogDeriv(ℂ[2 * s])] = ℂ[reflectionLogDeriv(s) +
    reflectionLogDeriv(s + complexOfReal(R[1 / 2]))]
proof
  have q := reflectionQuotient.holomorphic
  have copyQ := q
  obtain ⟨_, values, _⟩ := copyQ
  have relations := reflectionQuotient.relations
  obtain ⟨_, _, double⟩ := relations
  have logDeriv := reflectionLogDeriv.holomorphic
  obtain ⟨_, gValue⟩ := logDeriv
  have one : ℂ[1] ∈ ℂ by typecheck
  have two : ℂ[2] ∈ ℂ by typecheck
  have zero : ℂ[0] ∈ ℂ by typecheck
  have hf : complexOfReal(R[1 / 2]) ∈ ℂ by typecheck
  have doublePoint : ℂ[2 * s] ∈ ℂ by typecheck
  have halfPoint : ℂ[s + complexOfReal(R[1 / 2])] ∈ ℂ by typecheck
  have shape1 : ℂ[2 * s + 0] = ℂ[2 * s] by ring
  have shape2 : ℂ[1 * s + complexOfReal(R[1 / 2])] =
    ℂ[s + complexOfReal(R[1 / 2])] by ring
  have atDouble := complexDeriv.has_derivative with q, doublePoint
  rw ← shape1 at atDouble
  have atHalf := complexDeriv.has_derivative with q, halfPoint
  rw ← shape2 at atHalf
  have dA := affineComp.has_derivative with values, two, zero, hs, atDouble
  have dHalf := affineComp.has_derivative with values, one, hf, hs, atHalf
  have dQ := complexDeriv.has_derivative with q, hs
  have dB := HasComplexDerivativeAt.mul with dQ, dHalf
  have halfShifted := affineComp.holomorphic with q, one, hf
  obtain ⟨_, valuesHalf, _⟩ := halfShifted
  have agree : ∀ z ∈ ℂ, complexFunctionMul(reflectionQuotient,
      affineComp(reflectionQuotient, ℂ[1], complexOfReal(R[1 / 2])),
      complexCarrier)(z) = affineComp(reflectionQuotient, ℂ[2], ℂ[0])(z)
    intros z hz
    rw [(complexFunctionMul.value with values, valuesHalf, hz),
      (affineComp.value with values, one, hf, hz),
      (affineComp.value with values, two, zero, hz)]
    have shapeA : ℂ[2 * z + 0] = ℂ[2 * z] by ring
    have shapeB : ℂ[1 * z + complexOfReal(R[1 / 2])] =
      ℂ[z + complexOfReal(R[1 / 2])] by ring
    rw [shapeA, shapeB, (double with z, hz)]
  have moved := HasComplexDerivativeAt.congr with dB, agree
  have equal := HasComplexDerivativeAt.unique with moved, dA
  rw [(affineComp.value with values, one, hf, hs), shape1, shape2] at equal
  rw [(gValue with ℂ[2 * s], doublePoint), (gValue with s, hs),
    (gValue with ℂ[s + complexOfReal(R[1 / 2])], halfPoint),
    (double with s, hs)]
  have qs := values with s, hs
  have qh := values with ℂ[s + complexOfReal(R[1 / 2])], halfPoint
  have ns := reflectionQuotient.nonzero with hs
  have nh := reflectionQuotient.nonzero with halfPoint
  have cs := complexInv.mul_cancel with qs, ns
  have ch := complexInv.mul_cancel with qh, nh
  have is := complexInv.member with qs
  have ih := complexInv.member with qh
  have dFunction := complexDeriv.function with q
  have d1 := FunctionBetween.apply_closed with dFunction, hs
  have d2 := FunctionBetween.apply_closed with dFunction, doublePoint
  have d3 := FunctionBetween.apply_closed with dFunction, halfPoint
  unfold complexDiv
  rw (complexInv.mul with qs, qh)
  linear_combination (-(complexInv(reflectionQuotient(s)) *
    complexInv(reflectionQuotient(ℂ[s + complexOfReal(R[1 / 2])])))) * equal +
    (complexDeriv(reflectionQuotient, complexCarrier)(s) *
    complexInv(reflectionQuotient(s))) * ch +
    (complexDeriv(reflectionQuotient, complexCarrier)(
    ℂ[s + complexOfReal(R[1 / 2])]) *
    complexInv(reflectionQuotient(ℂ[s + complexOfReal(R[1 / 2])]))) * cs

-- 4 g'(2s) = g'(s) + g'(s + 1/2).
theorem reflectionLogDeriv.deriv_double (s : Set)
  requires hs : s ∈ ℂ
  shows ℂ[4 * complexDeriv(reflectionLogDeriv, complexCarrier)(ℂ[2 * s])] =
    ℂ[complexDeriv(reflectionLogDeriv, complexCarrier)(s) +
      complexDeriv(reflectionLogDeriv, complexCarrier)(
        s + complexOfReal(R[1 / 2]))]
proof
  have logDeriv := reflectionLogDeriv.holomorphic
  obtain ⟨g, _⟩ := logDeriv
  have copyG := g
  obtain ⟨_, values, _⟩ := copyG
  have one : ℂ[1] ∈ ℂ by typecheck
  have two : ℂ[2] ∈ ℂ by typecheck
  have zero : ℂ[0] ∈ ℂ by typecheck
  have hf : complexOfReal(R[1 / 2]) ∈ ℂ by typecheck
  have doublePoint : ℂ[2 * s] ∈ ℂ by typecheck
  have halfPoint : ℂ[s + complexOfReal(R[1 / 2])] ∈ ℂ by typecheck
  have shape1 : ℂ[2 * s + 0] = ℂ[2 * s] by ring
  have shape2 : ℂ[1 * s + complexOfReal(R[1 / 2])] =
    ℂ[s + complexOfReal(R[1 / 2])] by ring
  have atDouble := complexDeriv.has_derivative with g, doublePoint
  rw ← shape1 at atDouble
  have atHalf := complexDeriv.has_derivative with g, halfPoint
  rw ← shape2 at atHalf
  have dA := affineComp.has_derivative with values, two, zero, hs, atDouble
  have dHalf := affineComp.has_derivative with values, one, hf, hs, atHalf
  have dG := complexDeriv.has_derivative with g, hs
  have dB := HasComplexDerivativeAt.add with dG, dHalf
  have halfShifted := affineComp.holomorphic with g, one, hf
  obtain ⟨_, valuesHalf, _⟩ := halfShifted
  have formula : ∀ u ∈ ℂ, complexFunctionAdd(reflectionLogDeriv,
      affineComp(reflectionLogDeriv, ℂ[1], complexOfReal(R[1 / 2])),
      complexCarrier)(u) =
      ℂ[0 + 2 * affineComp(reflectionLogDeriv, ℂ[2], ℂ[0])(u)]
    intros u hu
    rw [(complexFunctionAdd.value with values, valuesHalf, hu),
      (affineComp.value with values, one, hf, hu),
      (affineComp.value with values, two, zero, hu)]
    have shapeA : ℂ[2 * u + 0] = ℂ[2 * u] by ring
    have shapeB : ℂ[1 * u + complexOfReal(R[1 / 2])] =
      ℂ[u + complexOfReal(R[1 / 2])] by ring
    rw [shapeA, shapeB, ← (reflectionLogDeriv.double with hu)]
    have doubleU : ℂ[2 * u] ∈ ℂ by typecheck
    have value := values with ℂ[2 * u], doubleU
    ring
  have scaled := HasComplexDerivativeAt.affine_image with dA, zero, two,
    formula
  have equal := HasComplexDerivativeAt.unique with dB, scaled
  rw [shape1, shape2] at equal
  have kValue := FunctionBetween.apply_closed with
    (complexDeriv.function with g), doublePoint
  linear_combination (-1) * equal

-- The closed disk K about 1/2 of radius 1/2 contains z/2 and z/2 + 1/2 with
-- z.
theorem complexClosedDisk.halves (z : Set)
  requires hz : z ∈ complexClosedDisk(complexOfReal(R[1 / 2]), R[1 / 2])
  shows ℂ[complexOfReal(R[1 / 2]) * z] ∈
      complexClosedDisk(complexOfReal(R[1 / 2]), R[1 / 2]) ∧
    ℂ[complexOfReal(R[1 / 2]) * z + complexOfReal(R[1 / 2])] ∈
      complexClosedDisk(complexOfReal(R[1 / 2]), R[1 / 2])
proof
  obtain ⟨zMember, near⟩ := complexClosedDisk.membership.forward with hz
  have hc : complexOfReal(R[1 / 2]) ∈ ℂ by typecheck
  have halfDouble := complexHalf.double
  have difference : ℂ[z - complexOfReal(R[1 / 2])] ∈ ℂ by typecheck
  have square : ℂ[complexOfReal(R[1 / 2]) * complexOfReal(R[1 / 2])] ∈ ℂ by
    typecheck
  have halfNonnegative : R[0] ≤ R[1 / 2] by linarith
  have absC : complexAbs(complexOfReal(R[1 / 2])) = R[1 / 2]
    rw [complexAbs.of_real, (abs.of_nonnegative with halfNonnegative)]
  have absSquare : complexAbs(ℂ[complexOfReal(R[1 / 2]) *
      complexOfReal(R[1 / 2])]) = R[1 / 4]
    rw [(complexAbs.mul with hc, hc), absC]
    ring
  have scaled : complexAbs(ℂ[complexOfReal(R[1 / 2]) *
      (z - complexOfReal(R[1 / 2]))]) =
      R[1 / 2 * complexAbs(ℂ[z - complexOfReal(R[1 / 2])])]
    rw [(complexAbs.mul with hc, difference), absC]
  have scaledMember : ℂ[complexOfReal(R[1 / 2]) *
    (z - complexOfReal(R[1 / 2]))] ∈ ℂ by typecheck
  have negSquare : ℂ[-(complexOfReal(R[1 / 2]) * complexOfReal(R[1 / 2]))]
    ∈ ℂ by typecheck
  have nearReal := complexAbs.real with difference
  refine ⟨?_, ?_⟩
  . apply complexClosedDisk.membership.backward
    have point : ℂ[complexOfReal(R[1 / 2]) * z] ∈ ℂ by typecheck
    refine ⟨point, ?_⟩
    have shape : ℂ[complexOfReal(R[1 / 2]) * z - complexOfReal(R[1 / 2])] =
        ℂ[complexOfReal(R[1 / 2]) * (z - complexOfReal(R[1 / 2])) +
        -(complexOfReal(R[1 / 2]) * complexOfReal(R[1 / 2]))] by
      linear_combination complexOfReal(R[1 / 2]) * halfDouble
    rw shape
    have triangle := complexAbs.triangle with scaledMember, negSquare
    rw [(complexAbs.neg with square), absSquare, scaled] at triangle
    have halfNear := realLe.mul_left_of_nonnegative with near, halfNonnegative
    have quarter : R[1 / 2 * (1 / 2)] = R[1 / 4] by ring
    linarith
  . apply complexClosedDisk.membership.backward
    have point : ℂ[complexOfReal(R[1 / 2]) * z + complexOfReal(R[1 / 2])] ∈ ℂ
      by typecheck
    refine ⟨point, ?_⟩
    have shape : ℂ[complexOfReal(R[1 / 2]) * z + complexOfReal(R[1 / 2]) -
        complexOfReal(R[1 / 2])] =
        ℂ[complexOfReal(R[1 / 2]) * (z - complexOfReal(R[1 / 2])) +
        complexOfReal(R[1 / 2]) * complexOfReal(R[1 / 2])] by ring
    rw shape
    have triangle := complexAbs.triangle with scaledMember, square
    rw [absSquare, scaled] at triangle
    have halfNear := realLe.mul_left_of_nonnegative with near, halfNonnegative
    have quarter : R[1 / 2 * (1 / 2)] = R[1 / 4] by ring
    linarith

-- Herglotz's step: a bound B for |g'| on K improves to B/2ⁿ.
theorem reflectionLogDeriv.deriv_shrink (B : Real) (n : Nat)
  requires bound : ∀ z ∈ complexClosedDisk(complexOfReal(R[1 / 2]), R[1 / 2]),
    complexAbs(complexDeriv(reflectionLogDeriv, complexCarrier)(z)) ≤ B
  shows ∀ z ∈ complexClosedDisk(complexOfReal(R[1 / 2]), R[1 / 2]),
    complexAbs(complexDeriv(reflectionLogDeriv, complexCarrier)(z)) ≤
      R[B * half(R[1]) ^ n]
proof
  induction n
  | zero =>
    intros z hz
    rw realRingPow.zero
    have unit : R[B * 1] = B by ring
    rw unit
    exact bound with z, hz
  | succ(m) using ih =>
    intros z hz
    have logDeriv := reflectionLogDeriv.holomorphic
    obtain ⟨g, _⟩ := logDeriv
    have kFunction := complexDeriv.function with g
    obtain ⟨zMember, _⟩ := complexClosedDisk.membership.forward with hz
    have halves := complexClosedDisk.halves with hz
    obtain ⟨first, second⟩ := halves
    have hc : complexOfReal(R[1 / 2]) ∈ ℂ by typecheck
    have point : ℂ[complexOfReal(R[1 / 2]) * z] ∈ ℂ by typecheck
    have relation := reflectionLogDeriv.deriv_double with point
    have halfDouble := complexHalf.double
    have back : ℂ[2 * (complexOfReal(R[1 / 2]) * z)] = z by
      linear_combination z * halfDouble
    rw back at relation
    have pointTwo : ℂ[complexOfReal(R[1 / 2]) * z + complexOfReal(R[1 / 2])]
      ∈ ℂ by typecheck
    have k0 := FunctionBetween.apply_closed with kFunction, zMember
    have k1 := FunctionBetween.apply_closed with kFunction, point
    have k2 := FunctionBetween.apply_closed with kFunction, pointTwo
    have four : ℂ[4] ∈ ℂ by typecheck
    have absFour : complexAbs(ℂ[4]) = R[4]
      rw [← complexOfReal.four, complexAbs.of_real]
      have nonnegative : R[0] ≤ R[4] by linarith
      rw (abs.of_nonnegative with nonnegative)
    have lhs := complexAbs.mul with four, k0
    rw [absFour, relation] at lhs
    have triangle := complexAbs.triangle with k1, k2
    have b1 := ih with ℂ[complexOfReal(R[1 / 2]) * z], first
    have b2 := ih with ℂ[complexOfReal(R[1 / 2]) * z +
      complexOfReal(R[1 / 2])], second
    rw realRingPow.succ
    have halfOne := half.add_self at R[1]
    have halfReal := half.real at R[1]
    have powReal : R[half(R[1]) ^ m] ∈ ℝ by typecheck
    have regroup : R[B * (half(R[1]) * half(R[1]) ^ m)] =
      R[(B * half(R[1]) ^ m) * half(R[1])] by ring
    have twice : R[(B * half(R[1]) ^ m) * half(R[1]) +
        (B * half(R[1]) ^ m) * half(R[1])] = R[B * half(R[1]) ^ m] by
      linear_combination (B * half(R[1]) ^ m) * halfOne
    rw regroup
    have r0 := complexAbs.real with k0
    have r1 := complexAbs.real with k1
    have r2 := complexAbs.real with k2
    linarith

-- Herglotz's lemma: g' vanishes on K, hence everywhere.
theorem reflectionLogDeriv.deriv_vanishes
  shows ∀ z ∈ ℂ, complexDeriv(reflectionLogDeriv, complexCarrier)(z) = ℂ[0]
proof
  have logDeriv := reflectionLogDeriv.holomorphic
  obtain ⟨g, _⟩ := logDeriv
  have k := HolomorphicOn.deriv with g
  have kFunction := complexDeriv.function with g
  have continuous := HolomorphicOn.continuous with k
  have hc : complexOfReal(R[1 / 2]) ∈ ℂ by typecheck
  have halfReal : R[1 / 2] ∈ ℝ by typecheck
  have inside : complexClosedDisk(complexOfReal(R[1 / 2]), R[1 / 2]) ⊆
      complexCarrier
    intros z hz
    obtain ⟨zMember, _⟩ := complexClosedDisk.membership.forward with hz
    exact zMember
  have restricted := ComplexContinuousOn.mono with continuous, inside
  have compact := complexClosedDisk.compact with hc, halfReal
  obtain ⟨B, hB, bound⟩ := ComplexContinuousOn.abs_bounded with restricted,
    compact
  have vanishK : ∀ z ∈ complexClosedDisk(complexOfReal(R[1 / 2]), R[1 / 2]),
      complexDeriv(reflectionLogDeriv, complexCarrier)(z) = ℂ[0]
    intros z hz
    have zMember := inside with z, hz
    have kz := FunctionBetween.apply_closed with kFunction, zMember
    have absReal := complexAbs.real with kz
    have absNonnegative := complexAbs.nonnegative with kz
    apply (complexAbs.zero_iff with kz).forward
    by_contra nonzero
    have positive : R[0] < complexAbs(complexDeriv(reflectionLogDeriv,
        complexCarrier)(z))
      by_contra notPositive
      apply nonzero
      linarith
    have atZ := bound with z, hz
    have bPositive : R[0] < B by linarith
    have bNonzero : B ≠ R[0] by linarith
    have ratioReal : R[complexAbs(complexDeriv(reflectionLogDeriv,
      complexCarrier)(z)) / B] ∈ ℝ by typecheck
    have cancel := realDiv.mul_right at complexAbs(complexDeriv(
      reflectionLogDeriv, complexCarrier)(z)), B with bNonzero
    have ratioPositive : R[0] < R[complexAbs(complexDeriv(reflectionLogDeriv,
        complexCarrier)(z)) / B]
      by_contra notPositive
      have nonpositive : R[complexAbs(complexDeriv(reflectionLogDeriv,
        complexCarrier)(z)) / B] ≤ R[0] by linarith
      have scaled := realLe.mul_right_of_nonnegative with nonpositive,
        (realLess.implies_le with bPositive)
      have zeroProduct : R[0 * B] = R[0] by ring
      linarith
    obtain ⟨N, hN, small⟩ := realRingPow.half_small with ratioPositive
    have natN : Nat(N) := nat.omega.backward with hN
    have shrunk := reflectionLogDeriv.deriv_shrink at B, N with bound
    have atN := shrunk with z, hz
    have scaled := realLess.mul_right_of_positive with small, bPositive
    have powReal : R[half(R[1]) ^ N] ∈ ℝ by typecheck
    have swap : R[B * half(R[1]) ^ N] = R[half(R[1]) ^ N * B] by ring
    linarith
  have zero : ℂ[0] ∈ ℂ by typecheck
  have whole := ComplexOpen.whole
  have connected := ComplexConnected.whole
  have constant := HolomorphicOn.const with whole, zero
  have oneReal : R[1] ∈ ℝ by typecheck
  have halfBelow : R[1 / 2] < R[1] by linarith
  have nested := complexDisk.mono_closed with hc, halfReal, oneReal, halfBelow
  obtain ⟨openInClosed, _⟩ := nested
  have isOpen := complexDisk.open with hc, halfReal
  have halfPositive : R[0] < R[1 / 2] by linarith
  have center := complexDisk.center with hc, halfReal, halfPositive
  have openInside := complexDisk.subset at complexOfReal(R[1 / 2]), R[1 / 2]
  have onDisk : ∀ z ∈ complexDisk(complexOfReal(R[1 / 2]), R[1 / 2]),
      complexDeriv(reflectionLogDeriv, complexCarrier)(z) =
      complexFunctionConst(ℂ[0], complexCarrier)(z)
    intros z hz
    rw (complexFunctionConst.value with zero, (openInside with z, hz))
    exact vanishK with z, (openInClosed with z, hz)
  have nonempty : ∃ v, v ∈ complexDisk(complexOfReal(R[1 / 2]), R[1 / 2]) :=
    ⟨complexOfReal(R[1 / 2]), center⟩
  have agree := holomorphic.identity with k, constant, connected, isOpen,
    nonempty, openInside, onDisk
  intros z hz
  have same := agree with z, hz
  rwa (complexFunctionConst.value with zero, hz) at same

-- h = S: g' = 0 makes g constant on ℝ, equal to g(0) = 0; then q' = g q
-- vanishes on ℝ, so q = q(0) = 1 there, and h = S on (0, 1/2).
theorem reflectionProduct.eq_sin (s : Set)
  requires hs : s ∈ ℂ
  shows reflectionProduct(s) = sinPi(s)
proof
  have logDeriv := reflectionLogDeriv.holomorphic
  obtain ⟨g, gValue⟩ := logDeriv
  have kZero := reflectionLogDeriv.deriv_vanishes
  have flatG : ∀ X ∈ ℝ, complexDeriv(reflectionLogDeriv, complexCarrier)(
      complexOfReal(X)) = ℂ[0]
    intros X hX
    have point : complexOfReal(X) ∈ ℂ by typecheck
    exact kZero with complexOfReal(X), point
  have constantG := HolomorphicOn.real_constant with g, flatG
  have zero : ℂ[0] ∈ ℂ by typecheck
  have q := reflectionQuotient.holomorphic
  have copyQ := q
  obtain ⟨_, values, _⟩ := copyQ
  have q0 := values with ℂ[0], zero
  have gZero : reflectionLogDeriv(ℂ[0]) = ℂ[0]
    rw [(gValue with ℂ[0], zero), reflectionQuotient.deriv_zero]
    unfold complexDiv
    have inverse := complexInv.member with q0
    ring
  have dFunction := complexDeriv.function with q
  have flatQ : ∀ X ∈ ℝ, complexDeriv(reflectionQuotient, complexCarrier)(
      complexOfReal(X)) = ℂ[0]
    intros X hX
    have point : complexOfReal(X) ∈ ℂ by typecheck
    have gX := constantG with X, hX
    rw [gZero, (gValue with complexOfReal(X), point)] at gX
    unfold complexDiv at gX
    have qx := values with complexOfReal(X), point
    have nonzero := reflectionQuotient.nonzero with point
    have cancel := complexInv.mul_cancel with qx, nonzero
    have dx := FunctionBetween.apply_closed with dFunction, point
    have inverse := complexInv.member with qx
    linear_combination reflectionQuotient(complexOfReal(X)) * gX -
      complexDeriv(reflectionQuotient, complexCarrier)(complexOfReal(X)) *
      cancel
  have constantQ := HolomorphicOn.real_constant with q, flatQ
  rw reflectionQuotient.zero at constantQ
  have analytic := reflectionProduct.analytic
  obtain ⟨hHolomorphic, _⟩ := analytic
  have sHolomorphic := sinPi.holomorphic
  have segment : ∀ X ∈ ℝ, R[0] < X → X < R[1 / 2] →
      reflectionProduct(complexOfReal(X)) = sinPi(complexOfReal(X))
    intros X hX positive below
    have point : complexOfReal(X) ∈ ℂ by typecheck
    have belowOne : X < R[1] by linarith
    have nonzero := sinPi.segment_nonzero with positive, belowOne
    have one := constantQ with X, hX
    rw (reflectionQuotient.away with point, nonzero) at one
    have hx := FunctionBetween.apply_closed with reflectionProduct.function,
      point
    have sx := FunctionBetween.apply_closed with sinPi.function, point
    have cancel := complexDiv.mul_cancel with hx, sx, nonzero
    rw one at cancel
    linear_combination (-1) * cancel
  have agree := HolomorphicOn.eq_of_segment with hHolomorphic, sHolomorphic,
    segment
  exact agree with s, hs

-- The reflection formula for 1/Γ, everywhere:
-- (1/Γ(s)) (1/Γ(1 − s)) = sin(πs)/π.
theorem reciprocalGamma.reflection (s : Set)
  requires hs : s ∈ ℂ
  shows ℂ[reciprocalGamma(s) * reciprocalGamma(1 - s)] =
    complexDiv(complexSin(ℂ[complexOfReal(realPi) * s]),
      complexOfReal(realPi))
proof
  have equal := reflectionProduct.eq_sin with hs
  rw [(reflectionProduct.value with hs), (sinPi.value with hs)] at equal
  have piMember : complexOfReal(realPi) ∈ ℂ by typecheck
  have piNonzero : complexOfReal(realPi) ≠ ℂ[0]
    intro vanish
    rw ← complexOfReal.zero at vanish
    have equalReal := complexOfReal.injective with vanish
    have positive := realPi.positive
    linarith
  have cancel := complexInv.mul_cancel with piMember, piNonzero
  have inverse := complexInv.member with piMember
  have r1 := reciprocalGamma.member at s
  have r2 := reciprocalGamma.member at ℂ[1 - s]
  have point : ℂ[complexOfReal(realPi) * s] ∈ ℂ by typecheck
  have sinMember := complexSin.member with point
  unfold complexDiv
  linear_combination complexInv(complexOfReal(realPi)) * equal -
    (reciprocalGamma(s) * reciprocalGamma(ℂ[1 - s])) * cancel

-- The reflection formula Γ(s)Γ(1 − s) = π/sin(πs), s not an integer.
theorem Gamma.reflection (s : Set)
  requires hs : s ∈ gammaDomain
  requires reflected : ℂ[1 - s] ∈ gammaDomain
  shows ℂ[Gamma(s) * Gamma(1 - s)] =
    complexDiv(complexOfReal(realPi),
      complexSin(ℂ[complexOfReal(realPi) * s]))
proof
  have inDomain := hs
  unfold gammaDomain at inDomain
  have sMember := inDomain.left
  have notPole := inDomain.right
  have inReflected := reflected
  unfold gammaDomain at inReflected
  have tMember := inReflected.left
  have notPoleT := inReflected.right
  have a := reciprocalGamma.member at s
  have b := reciprocalGamma.member at ℂ[1 - s]
  have aNonzero : reciprocalGamma(s) ≠ ℂ[0]
    intro zero
    exact notPole with ((reciprocalGamma.zero_iff with sMember).forward with
      zero)
  have bNonzero : reciprocalGamma(ℂ[1 - s]) ≠ ℂ[0]
    intro zero
    exact notPoleT with ((reciprocalGamma.zero_iff with tMember).forward with
      zero)
  have equal := reflectionProduct.eq_sin with sMember
  rw [(reflectionProduct.value with sMember), (sinPi.value with sMember)]
    at equal
  have piMember : complexOfReal(realPi) ∈ ℂ by typecheck
  have piNonzero : complexOfReal(realPi) ≠ ℂ[0]
    intro vanish
    rw ← complexOfReal.zero at vanish
    have equalReal := complexOfReal.injective with vanish
    have positive := realPi.positive
    linarith
  have point : ℂ[complexOfReal(realPi) * s] ∈ ℂ by typecheck
  have sinMember := complexSin.member with point
  have partial := gammaComplex.mul_nonzero with piMember, a, piNonzero,
    aNonzero
  have product : ℂ[complexOfReal(realPi) * reciprocalGamma(s)] ∈ ℂ by
    typecheck
  have whole := gammaComplex.mul_nonzero with product, b, partial, bNonzero
  have sinNonzero : complexSin(ℂ[complexOfReal(realPi) * s]) ≠ ℂ[0]
    rw ← equal
    exact whole
  have ca := complexInv.mul_cancel with a, aNonzero
  have cb := complexInv.mul_cancel with b, bNonzero
  have cS := complexInv.mul_cancel with sinMember, sinNonzero
  have ia := complexInv.member with a
  have ib := complexInv.member with b
  have iS := complexInv.member with sinMember
  unfold Gamma
  unfold complexDiv
  linear_combination (-(complexInv(reciprocalGamma(s)) *
    complexInv(reciprocalGamma(ℂ[1 - s])))) * cS -
    (complexInv(reciprocalGamma(s)) * complexInv(reciprocalGamma(ℂ[1 - s])) *
    complexInv(complexSin(ℂ[complexOfReal(realPi) * s]))) * equal +
    (complexOfReal(realPi) *
    complexInv(complexSin(ℂ[complexOfReal(realPi) * s])) *
    complexInv(reciprocalGamma(ℂ[1 - s])) * reciprocalGamma(ℂ[1 - s])) * ca +
    (complexOfReal(realPi) *
    complexInv(complexSin(ℂ[complexOfReal(realPi) * s]))) * cb

-- Section: Duplication and Euler's integral
-- Legendre's duplication formula for s ∈ ℂ with 2s not a pole.
theorem Gamma.duplication_of_member (s : Set)
  requires member : s ∈ ℂ
  requires hs : ℂ[2 * s] ∈ gammaDomain
  shows ℂ[Gamma(s) * Gamma(s + complexOfReal(R[1 / 2]))] =
    ℂ[realCpow(R[2], ℂ[1 - 2 * s]) * complexOfReal(realSqrt(realPi)) *
      Gamma(ℂ[2 * s])]
proof
  have hf : complexOfReal(R[1 / 2]) ∈ ℂ by typecheck
  have double : ℂ[2 * s] ∈ ℂ by typecheck
  have shifted : ℂ[s + complexOfReal(R[1 / 2])] ∈ ℂ by typecheck
  have halfDouble := complexHalf.double
  have notPoleU : ¬(ℂ[2 * s] ∈ gammaPoles)
    have inDomain := hs
    unfold gammaDomain at inDomain
    exact inDomain.right
  -- s and s + 1/2 are not poles either.
  have notPoleS : ¬(s ∈ gammaPoles)
    intro pole
    obtain ⟨_, k, hk, shape⟩ := gammaPoles.membership.forward with pole
    have kNat := nat.omega.backward at k with hk
    apply notPoleU
    have twoK : 2 * k ∈ ℕ by typecheck
    apply gammaPoles.membership.backward
    refine ⟨double, 2 * k, twoK, ?_⟩
    rw [shape, realNat.mul, realNat.two, complexOfReal.mul]
    have two : complexOfReal(R[2]) = ℂ[2]
      have same : R[2] = R[1 + 1] by ring
      rw [same, complexOfReal.add, complexOfReal.one]
      ring
    rw two
    have cast : complexOfReal(realNat(k)) ∈ ℂ by typecheck
    ring
  have notPoleT : ¬(ℂ[s + complexOfReal(R[1 / 2])] ∈ gammaPoles)
    intro pole
    obtain ⟨_, k, hk, shape⟩ := gammaPoles.membership.forward with pole
    have kNat := nat.omega.backward at k with hk
    apply notPoleU
    have index : 2 * k + 1 ∈ ℕ by typecheck
    apply gammaPoles.membership.backward
    refine ⟨double, 2 * k + 1, index, ?_⟩
    have sShape : s = ℂ[-complexOfReal(realNat(k)) - complexOfReal(R[1 / 2])]
      linear_combination shape
    rw [sShape, realNat.add, realNat.mul, realNat.two, realNat.one,
      complexOfReal.add, complexOfReal.mul, complexOfReal.one]
    have two : complexOfReal(R[2]) = ℂ[2]
      have same : R[2] = R[1 + 1] by ring
      rw [same, complexOfReal.add, complexOfReal.one]
      ring
    rw two
    have cast : complexOfReal(realNat(k)) ∈ ℂ by typecheck
    linear_combination (-1) * halfDouble
  have rU := reciprocalGamma.member at ℂ[2 * s]
  have rS := reciprocalGamma.member at s
  have rT := reciprocalGamma.member at ℂ[s + complexOfReal(R[1 / 2])]
  have nU : reciprocalGamma(ℂ[2 * s]) ≠ ℂ[0]
    intro zero
    exact notPoleU with ((reciprocalGamma.zero_iff with double).forward with
      zero)
  have nS : reciprocalGamma(s) ≠ ℂ[0]
    intro zero
    exact notPoleS with ((reciprocalGamma.zero_iff with member).forward with
      zero)
  have nT : reciprocalGamma(ℂ[s + complexOfReal(R[1 / 2])]) ≠ ℂ[0]
    intro zero
    exact notPoleT with ((reciprocalGamma.zero_iff with shifted).forward with
      zero)
  have cU := complexInv.mul_cancel with rU, nU
  have cS := complexInv.mul_cancel with rS, nS
  have cT := complexInv.mul_cancel with rT, nT
  have iU := complexInv.member with rU
  have iS := complexInv.member with rS
  have iT := complexInv.member with rT
  have duplication := reciprocalGamma.duplication with member
  have v : ℂ[1 - 2 * s] ∈ ℂ by typecheck
  have power := realCpow.member at R[2], ℂ[1 - 2 * s] with v
  have root : complexOfReal(realSqrt(realPi)) ∈ ℂ by typecheck
  unfold Gamma
  linear_combination (complexInv(reciprocalGamma(s)) *
    complexInv(reciprocalGamma(ℂ[s + complexOfReal(R[1 / 2])])) *
    complexInv(reciprocalGamma(ℂ[2 * s]))) * duplication -
    (complexInv(reciprocalGamma(s)) *
    complexInv(reciprocalGamma(ℂ[s + complexOfReal(R[1 / 2])]))) * cU +
    (realCpow(R[2], ℂ[1 - 2 * s]) * complexOfReal(realSqrt(realPi)) *
    complexInv(reciprocalGamma(ℂ[2 * s])) *
    reciprocalGamma(ℂ[s + complexOfReal(R[1 / 2])]) *
    complexInv(reciprocalGamma(ℂ[s + complexOfReal(R[1 / 2])]))) * cS +
    (realCpow(R[2], ℂ[1 - 2 * s]) * complexOfReal(realSqrt(realPi)) *
    complexInv(reciprocalGamma(ℂ[2 * s]))) * cT

-- Legendre's duplication formula Γ(s)Γ(s + 1/2) = 2^(1−2s) √π Γ(2s),
-- for complex s with 2s not a pole.
theorem Gamma.duplication (s : Set)
  requires member : s ∈ ℂ
  requires hs : ℂ[2 * s] ∈ gammaDomain
  shows ℂ[Gamma(s) * Gamma(s + complexOfReal(R[1 / 2]))] =
    ℂ[realCpow(R[2], ℂ[1 - 2 * s]) * complexOfReal(realSqrt(realPi)) *
      Gamma(ℂ[2 * s])]
proof
  exact Gamma.duplication_of_member with member, hs

-- Euler's integral: for re s > 0, Γ(s) = ∫₀^∞ t^(s−1) e^(−t) dt, as the
-- limit of the improper integrals over [A, ∞) as A → 0⁺.
theorem Gamma.euler_integral (s : Set)
  requires hs : s ∈ ℂ
  requires positive : realZero < complexRe(s)
  shows ∀ e ∈ ℝ, R[0] < e → ∃ d ∈ ℝ, R[0] < d ∧
    (∀ A ∈ ℝ, R[0] < A → A < d → ∃ I ∈ ℂ,
      HasComplexImproperIntegral(eulerIntegrand(s), A, I) ∧
      complexAbs(ℂ[I - Gamma(s)]) < e)
proof
  sorry

end Gamma
