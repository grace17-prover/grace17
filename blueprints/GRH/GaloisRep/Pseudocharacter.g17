-- Pseudocharacters: semisimplicity as nondegeneracy of the trace form on
-- the span of a matrix representation, twists by characters, cancelling
-- characters from two semisimple representations, traces of powers and
-- characteristic polynomials over an algebraically closed field of
-- characteristic zero, Newton's polynomials, functions satisfying all
-- trace identities are traces (Procesi, Taylor), products of matrix
-- algebras and their matrix units, intertwiners, Wedderburn–Clifford,
-- Clifford's theorem and the Brauer–Nesbitt theorem.
-- Source: grh-compact/src/Lib/GaloisRep/Pseudocharacter/FibreSum.lean
-- (twistByChar, IsTraceNondeg.twist, IsTraceNondeg.exists_cancel_chars,
-- det_aeval_neg_eq_prod_roots, trace_pow_eq_sum_roots,
-- charpoly_eq_mul_of_trace_pow_add, newtonPoly, eval_newtonPoly,
-- exists_rep_of_pseudo), Pseudocharacter/SemisimpleReps.lean (PiMat,
-- blockDiagonalAlgHom, piMatrixUnit, sum_piMatrixUnit,
-- trace_of_idempotent, isIdempotentElem_map_piMatrixUnit,
-- IsTraceNondeg.of_span_piMat, exists_rep_of_trace, intertwiner,
-- intertwiner_mul_piMatrixUnit, mul_intertwiner, exists_piMat_retract,
-- HasSemiprimeSpan, exists_wedderburn, IsTraceNondeg.hasSemiprimeSpan,
-- IsTraceNondeg.comp, IsTraceNondeg.exists_conj_of_trace_eq). The
-- analytic half of FibreSum.lean is GRH.GaloisRep.PseudoLimits.
-- Encoding. A matrix representation of the group record G of rank n
-- over the field k is a group homomorphism r : G → GLₙ(k)
-- (generalLinearGroup(k, n), whose elements are the matrices). Index
-- sets are finite sets; a family d of sizes indexed by the finite set m
-- gives the ring Π_{i∈m} M_{d(i)}(k) (the source's PiMat k d, with m for
-- Fin m). A finite-dimensional k-algebra B is a Cumulus algebra with base
-- k, and a monoid homomorphism ρ : G → B is a function with ρ(1) = 1 and
-- ρ(gh) = ρ(g)ρ(h). Multisets of roots are families α : n → k with
-- charpoly = Π (X − α_i).
-- Part of the GRH blueprint (layer 4, Lib/GaloisRep, plan group S1
-- GRH.GaloisRep.Pseudocharacter).
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.GaloisRep.Pseudocharacter
import GRH.Matrix.Spectral
import GRH.Matrix.Groups
import GRH.NumberField.Basic

section Pseudocharacter

-- Section: Trace-nondegenerate representations
-- The span of r(G) in the matrices Mₙ(k).
def csGRRepSpan (G k n r : Set) : Set :=
  moduleSpan(matrixModule(k, n, n), k, functionImage(r, Group.carrier(G), matrixSpace(k, n, n)))

-- STAND-IN for General/LinearAlgebra/CommonEigenvectors.lean,
-- IsTraceNondeg r: every x in the span of r(G) with tr(x r(g)) = 0 for
-- all g is zero (semisimplicity, in characteristic zero).
predicate csGRIsTraceNondeg (G k n r : Set) :=
  ∀ x ∈ csGRRepSpan(G, k, n, r),
    (∀ g ∈ Group.carrier(G), matTrace(k, n, matMul(k, n, n, n, x, r(g))) = Ring.zero(k)) →
    x = matZero(k, n, n)

-- The trace function g ↦ tr r(g).
def csGRTraceFn (G k n r : Set) : Set :=
  { (g, matTrace(k, n, r(g))) | g ∈ Group.carrier(G) }

-- A character μ : G → k^× (a homomorphism to the unit group).
predicate csGRIsCharacter (G k μ : Set) := GroupHom(μ, G, unitGroup(k))

-- FibreSum.lean, twistByChar μ R: the representation g ↦ μ(g) R(g).
def twistByChar (G k n μ R : Set) : Set :=
  { (g, matSmul(k, n, n, μ(g), R(g))) | g ∈ Group.carrier(G) }

-- The sum Σ_{j∈t} ψ_j(g) of a finite family of characters at g.
def csGRCharFamilyValues (t ψ g : Set) : Set := { (j, ψ(j)(g)) | j ∈ t }

def csGRCharFamilySum (k t ψ g : Set) : Set :=
  finiteRingSum(t, Ring.carrier(k), Ring.add(k), Ring.zero(k), Ring.neg(k), Ring.mul(k),
    Ring.one(k), csGRCharFamilyValues(t, ψ, g))

-- FibreSum.lean, IsTraceNondeg.twist.
theorem twistByChar.trace_nondeg (G k n μ R : Set)
  requires field : Field(k)
  requires finite : Finite(n)
  requires hom : GroupHom(R, G, generalLinearGroup(k, n))
  requires semisimple : csGRIsTraceNondeg(G, k, n, R)
  requires character : csGRIsCharacter(G, k, μ)
  shows GroupHom(twistByChar(G, k, n, μ, R), G, generalLinearGroup(k, n)) ∧
    csGRIsTraceNondeg(G, k, n, twistByChar(G, k, n, μ, R))
proof
  sorry

-- FibreSum.lean, IsTraceNondeg.exists_cancel_chars: over k algebraically
-- closed of characteristic 0, let r₀, r₁ be semisimple of rank |n| + |t|
-- with tr rᵢ(g) = T(g) + Σ_j ψᵢⱼ(g), no ψ₀ᵢ equal to a ψ₁ⱼ. Then T is the
-- trace of a semisimple representation of rank |n|.
theorem csGRIsTraceNondeg.exists_cancel_chars (G k m n t r ψ T : Set)
  requires closed : AlgebraicallyClosed(k)
  requires charZero : CharZero(k)
  requires finiteN : Finite(n)
  requires finiteT : Finite(t)
  requires sizes : ∃ a ∈ ℕ, ∃ b ∈ ℕ, HasCardinality(n, a) ∧ HasCardinality(t, b) ∧
    HasCardinality(m, a + b)
  requires homs : ∀ i ∈ 2, GroupHom(r(i), G, generalLinearGroup(k, m))
  requires semisimple : ∀ i ∈ 2, csGRIsTraceNondeg(G, k, m, r(i))
  requires characters : ∀ i ∈ 2, ∀ j ∈ t, csGRIsCharacter(G, k, ψ(i)(j))
  requires distinct : ∀ i ∈ t, ∀ j ∈ t, ψ(0)(i) ≠ ψ(1)(j)
  requires values : FunctionBetween(T, Group.carrier(G), Ring.carrier(k))
  requires traces : ∀ i ∈ 2, ∀ g ∈ Group.carrier(G),
    matTrace(k, m, r(i)(g)) = call2(Ring.add(k), T(g), csGRCharFamilySum(k, t, ψ(i), g))
  shows ∃ s, GroupHom(s, G, generalLinearGroup(k, n)) ∧ csGRIsTraceNondeg(G, k, n, s) ∧
    (∀ g ∈ Group.carrier(G), T(g) = matTrace(k, n, s(g)))
proof
  sorry

-- Section: Traces of powers and characteristic polynomials
-- The family α : n → k lists the roots of the characteristic polynomial
-- of A with multiplicity: charpoly A = Π_i (X − α_i).
predicate csGRCharpolyRoots (k n A α : Set) :=
  FunctionBetween(α, n, Ring.carrier(k)) ∧ matCharpoly(k, n, A) = linearFactorProduct(k, n, α)

-- The power sum Σ_i α_i^m.
def csGRPowerSumValues (k n α : Set, m : Nat) : Set := { (i, Ring.pow(k, α(i), m)) | i ∈ n }

def csGRPowerSum (k n α : Set, m : Nat) : Set :=
  finiteRingSum(n, Ring.carrier(k), Ring.add(k), Ring.zero(k), Ring.neg(k), Ring.mul(k),
    Ring.one(k), csGRPowerSumValues(k, n, α, m))

-- Over an algebraically closed field the roots exist (Matrix.charpoly
-- splits; the multiset A.charpoly.roots of the source).
theorem csGRCharpolyRoots.exists (k n A : Set)
  requires closed : AlgebraicallyClosed(k)
  requires finite : Finite(n)
  requires matrix : A ∈ matrixSpace(k, n, n)
  shows ∃ α, csGRCharpolyRoots(k, n, A, α)
proof
  sorry

-- The value q(−x) for x ∈ k, and the product Π_i q(−α_i).
def csGRNegEvalValues (k n q α : Set) : Set :=
  { (i, polyEval(k, q, apply(Ring.neg(k), α(i)))) | i ∈ n }

-- FibreSum.lean, det_aeval_neg_eq_prod_roots: det q(−A) = Π q(−α_i).
theorem matDet.polyEval_neg_eq_prod_roots (k n A α q : Set)
  requires closed : AlgebraicallyClosed(k)
  requires finite : Finite(n)
  requires matrix : A ∈ matrixSpace(k, n, n)
  requires roots : csGRCharpolyRoots(k, n, A, α)
  requires poly : q ∈ Ring.carrier(polynomialRing(k, {0}))
  shows matDet(k, n, matPolyEval(k, n, matNeg(k, n, n, A), q)) =
    finiteRingProduct(n, Ring.carrier(k), Ring.add(k), Ring.zero(k), Ring.neg(k),
      Ring.mul(k), Ring.one(k), csGRNegEvalValues(k, n, q, α))
proof
  sorry

-- FibreSum.lean, trace_pow_eq_sum_roots: tr A^m = Σ α_i^m.
theorem matTrace.pow_eq_sum_roots (k n A α : Set, m : Nat)
  requires closed : AlgebraicallyClosed(k)
  requires finite : Finite(n)
  requires matrix : A ∈ matrixSpace(k, n, n)
  requires roots : csGRCharpolyRoots(k, n, A, α)
  shows matTrace(k, n, matPow(k, n, A, m)) = csGRPowerSum(k, n, α, m)
proof
  sorry

-- FibreSum.lean, charpoly_eq_mul_of_trace_pow_add: if tr A^m = tr B^m +
-- Σ_{e∈S} α_e^m for all m, then charpoly A = charpoly B · Π_{e∈S} (X − α_e).
theorem matCharpoly.eq_mul_of_trace_pow_add (k n r A B S α : Set)
  requires closed : AlgebraicallyClosed(k)
  requires charZero : CharZero(k)
  requires finiteN : Finite(n)
  requires finiteR : Finite(r)
  requires finiteS : Finite(S)
  requires matrixA : A ∈ matrixSpace(k, n, n)
  requires matrixB : B ∈ matrixSpace(k, r, r)
  requires family : FunctionBetween(α, S, Ring.carrier(k))
  requires traces : ∀ m ∈ ℕ, matTrace(k, n, matPow(k, n, A, m)) =
    call2(Ring.add(k), matTrace(k, r, matPow(k, r, B, m)), csGRPowerSum(k, S, α, m))
  shows matCharpoly(k, n, A) = call2(Ring.mul(polynomialRing(k, {0})),
    matCharpoly(k, r, B), linearFactorProduct(k, S, α))
proof
  sorry

-- Section: Newton's polynomials
-- FibreSum.lean, newtonPoly: the polynomials N(j, m) over k in the
-- variables X₀, X₁, … with N(0, m) = 1 and N(j+1, m) = X_m N(j, 1) −
-- j N(j, m+1), as the unique family on ℕ × ℕ with these equations.
defunique newtonPoly (k : Set) (N ∈ functionSpace(ℕ × ℕ, Ring.carrier(polynomialRing(k, ℕ)))) :=
  (∀ m ∈ ℕ, N((0, m)) = Ring.one(polynomialRing(k, ℕ))) ∧
  (∀ j ∈ ℕ, ∀ m ∈ ℕ, N((succ(j), m)) =
    Ring.sub(polynomialRing(k, ℕ),
      call2(Ring.mul(polynomialRing(k, ℕ)), X(k, ℕ, m), N((j, 1))),
      call2(Ring.mul(polynomialRing(k, ℕ)), natCast(polynomialRing(k, ℕ), j), N((j, succ(m))))))
requires ring : CommRing(k)
proof
  sorry
uniqueness
  sorry

-- The power sums m ↦ Σ_i s_i^m as values of the variables, and the
-- elementary symmetric function e_j(s) = Σ_{T⊆n, |T|=j} Π_{i∈T} s_i.
def csGRPowerSumPoint (k n s : Set) : Set := { (m, csGRPowerSum(k, n, s, m)) | m ∈ ℕ }

def csGRSubsetsOfCard (n : Set, j : Nat) : Set := { T ∈ 𝒫(n) | HasCardinality(T, j) }

def csGREsymmTerms (k n s : Set, j : Nat) : Set :=
  { (T, finiteRingProduct(T, Ring.carrier(k), Ring.add(k), Ring.zero(k), Ring.neg(k),
      Ring.mul(k), Ring.one(k), restrict(s, T))) | T ∈ csGRSubsetsOfCard(n, j) }

def csGREsymmOf (k n s : Set, j : Nat) : Set :=
  finiteRingSum(csGRSubsetsOfCard(n, j), Ring.carrier(k), Ring.add(k),
    Ring.zero(k), Ring.neg(k), Ring.mul(k), Ring.one(k), csGREsymmTerms(k, n, s, j))

-- FibreSum.lean, eval_newtonPoly: N(j, 1) at the power sums of s is
-- j! e_j(s).
theorem newtonPoly.eval_power_sums (k n s : Set, j : Nat)
  requires field : Field(k)
  requires finite : Finite(n)
  requires family : FunctionBetween(s, n, Ring.carrier(k))
  shows evaluationAt(k, ℕ, csGRPowerSumPoint(k, n, s))(newtonPoly(k)((j, 1))) =
    call2(Ring.mul(k), natCast(k, factorial(j)), csGREsymmOf(k, n, s, j))
proof
  sorry

-- Section: Functions satisfying the trace identities
-- FibreSum.lean, exists_rep_of_pseudo (Procesi, Taylor): over k
-- algebraically closed of characteristic 0, a function T : G → k
-- satisfying every polynomial identity (in variables indexed by G) that
-- holds among the traces of all homomorphisms G → GLₙ(k) is the trace of
-- a semisimple representation G → GLₙ(k).
theorem exists_rep_of_pseudo (G k n T : Set)
  requires closed : AlgebraicallyClosed(k)
  requires charZero : CharZero(k)
  requires finite : Finite(n)
  requires values : FunctionBetween(T, Group.carrier(G), Ring.carrier(k))
  requires identities : ∀ B ∈ Ring.carrier(polynomialRing(k, Group.carrier(G))),
    (∀ x, GroupHom(x, G, generalLinearGroup(k, n)) →
      evaluationAt(k, Group.carrier(G), csGRTraceFn(G, k, n, x))(B) = Ring.zero(k)) →
    evaluationAt(k, Group.carrier(G), T)(B) = Ring.zero(k)
  shows ∃ r, GroupHom(r, G, generalLinearGroup(k, n)) ∧ csGRIsTraceNondeg(G, k, n, r) ∧
    (∀ g ∈ Group.carrier(G), matTrace(k, n, r(g)) = T(g))
proof
  sorry

-- Section: Products of matrix algebras
-- The k-algebra Mₙ(k), with a ↦ a·1.
def csGRMatScalarMap (k n : Set) : Set := { (a, matScalar(k, n, a)) | a ∈ Ring.carrier(k) }

def csGRMatAlgebra (k n : Set) : Set :=
  Algebra.mk(k, squareMatrixRing(k, n), csGRMatScalarMap(k, n))

-- SemisimpleReps.lean, PiMat k d: the ring Π_{i∈m} M_{d(i)}(k) and the
-- k-algebra structure a ↦ (a·1)_i.
def piMatRings (k m d : Set) : Set := { (i, squareMatrixRing(k, d(i))) | i ∈ m }

def piMatRing (k m d : Set) : Set := piRing(m, piMatRings(k, m, d))

def piMatScalar (k m d a : Set) : Set := { (i, matScalar(k, d(i), a)) | i ∈ m }

def piMatScalarMap (k m d : Set) : Set := { (a, piMatScalar(k, m, d, a)) | a ∈ Ring.carrier(k) }

def piMatAlgebra (k m d : Set) : Set := Algebra.mk(k, piMatRing(k, m, d), piMatScalarMap(k, m, d))

-- SemisimpleReps.lean, piMatrixUnit i a b: the matrix unit E_ab in the
-- factor i and 0 in the others.
def piMatrixUnitAt (k d i a b j : Set) : Set :=
  ⋃({ M ∈ matrixSpace(k, d(j), d(j)) |
    (j = i ∧ M = matSingle(k, d(j), d(j), a, b, Ring.one(k))) ∨
    (j ≠ i ∧ M = matZero(k, d(j), d(j))) })

def piMatrixUnit (k m d i a b : Set) : Set :=
  { (j, piMatrixUnitAt(k, d, i, a, b, j)) | j ∈ m }

-- The sizes are positive naturals.
predicate csGRPositiveSizes (m d : Set) := Finite(m) ∧ (∀ i ∈ m, d(i) ∈ ℕ ∧ d(i) ≠ 0)

-- The pairs (i, a) with i ∈ m and a < d(i).
def piMatIndexPairs (m d : Set) : Set := { q ∈ m × ⋃(functionImage(d, m, ℕ)) | snd(q) ∈ d(fst(q)) }

-- SemisimpleReps.lean, sum_piMatrixUnit: Σ_i Σ_a E^i_aa = 1.
def piMatrixUnitDiagonal (k m d : Set) : Set :=
  { (q, piMatrixUnit(k, m, d, fst(q), snd(q), snd(q))) | q ∈ piMatIndexPairs(m, d) }

theorem piMatrixUnit.sum_diagonal (k m d : Set)
  requires field : Field(k)
  requires sizes : csGRPositiveSizes(m, d)
  shows finiteRingSum(piMatIndexPairs(m, d), Ring.carrier(piMatRing(k, m, d)),
    Ring.add(piMatRing(k, m, d)), Ring.zero(piMatRing(k, m, d)),
    Ring.neg(piMatRing(k, m, d)), Ring.mul(piMatRing(k, m, d)),
    Ring.one(piMatRing(k, m, d)), piMatrixUnitDiagonal(k, m, d)) =
    Ring.one(piMatRing(k, m, d))
proof
  sorry

-- The rank of a matrix: the least r with A = P Q for P of size n × r and
-- Q of size r × n.
def matRankCandidates (k n A : Set) : Set :=
  { r ∈ ℕ | ∃ P ∈ matrixSpace(k, n, r), ∃ Q ∈ matrixSpace(k, r, n),
    A = matMul(k, n, r, n, P, Q) }

def csGRMatRank (k n A : Set) : Set := ⋂(matRankCandidates(k, n, A))

-- SemisimpleReps.lean, trace_of_idempotent: for p idempotent, tr p is the
-- rank of p, and p = 0 iff tr p = 0 (characteristic 0).
theorem matTrace.of_idempotent (k n p : Set)
  requires field : Field(k)
  requires charZero : CharZero(k)
  requires finite : Finite(n)
  requires matrix : p ∈ matrixSpace(k, n, n)
  requires idempotent : matMul(k, n, n, n, p, p) = p
  shows (∃ r ∈ ℕ, r = csGRMatRank(k, n, p) ∧ matTrace(k, n, p) = natCast(k, r)) ∧
    (p = matZero(k, n, n) ↔ matTrace(k, n, p) = Ring.zero(k))
proof
  sorry

-- SemisimpleReps.lean, isIdempotentElem_map_piMatrixUnit: f(E^i_00) is
-- idempotent for a k-algebra map f.
theorem piMatrixUnit.map_idempotent (k m d B f i : Set)
  requires field : Field(k)
  requires sizes : csGRPositiveSizes(m, d)
  requires hom : AlgebraHom(f, piMatAlgebra(k, m, d), B)
  requires index : i ∈ m
  shows call2(Ring.mul(Algebra.ring(B)), f(piMatrixUnit(k, m, d, i, 0, 0)),
    f(piMatrixUnit(k, m, d, i, 0, 0))) = f(piMatrixUnit(k, m, d, i, 0, 0))
proof
  sorry

-- SemisimpleReps.lean, IsTraceNondeg.of_span_piMat: if s(G) spans
-- Π M_{d(i)}(k) and g ∘ s = r for a k-algebra map g into Mₙ(k), then r is
-- trace-nondegenerate.
theorem csGRIsTraceNondeg.of_span_piMat (G k m d n r s f : Set)
  requires field : Field(k)
  requires sizes : csGRPositiveSizes(m, d)
  requires finite : Finite(n)
  requires homR : GroupHom(r, G, generalLinearGroup(k, n))
  requires valuesS : FunctionBetween(s, Group.carrier(G), Ring.carrier(piMatRing(k, m, d)))
  requires spans : moduleSpan(algebraModule(piMatAlgebra(k, m, d)), k,
    functionImage(s, Group.carrier(G), Ring.carrier(piMatRing(k, m, d)))) =
    Ring.carrier(piMatRing(k, m, d))
  requires hom : AlgebraHom(f, piMatAlgebra(k, m, d), csGRMatAlgebra(k, n))
  requires factor : ∀ g ∈ Group.carrier(G), f(s(g)) = r(g)
  shows csGRIsTraceNondeg(G, k, n, r)
proof
  sorry

-- A monoid homomorphism ρ : G → B into the k-algebra B.
predicate csGRMonoidHomInto (G B ρ : Set) :=
  FunctionBetween(ρ, Group.carrier(G), algebraCarrier(B)) ∧
  ρ(Group.one(G)) = Ring.one(Algebra.ring(B)) ∧
  (∀ g ∈ Group.carrier(G), ∀ h ∈ Group.carrier(G),
    ρ(Group.mul(G)(g, h)) = call2(Ring.mul(Algebra.ring(B)), ρ(g), ρ(h)))

-- SemisimpleReps.lean, exists_rep_of_trace: if s(G) spans Π M_{d(i)}(k)
-- and τ is a k-linear trace (τ(xy) = τ(yx)) taking natural values on the
-- units E^i_00 with τ(1) = |n|, then some trace-nondegenerate r has
-- tr r(g) = τ(s(g)).
theorem exists_rep_of_trace (G k m d n s τ : Set)
  requires closed : AlgebraicallyClosed(k)
  requires charZero : CharZero(k)
  requires sizes : csGRPositiveSizes(m, d)
  requires finite : Finite(n)
  requires hom : csGRMonoidHomInto(G, piMatAlgebra(k, m, d), s)
  requires spans : moduleSpan(algebraModule(piMatAlgebra(k, m, d)), k,
    functionImage(s, Group.carrier(G), Ring.carrier(piMatRing(k, m, d)))) =
    Ring.carrier(piMatRing(k, m, d))
  requires linear : LinearMap(τ, algebraModule(piMatAlgebra(k, m, d)), k, selfModule(k))
  requires traceLike : ∀ x ∈ Ring.carrier(piMatRing(k, m, d)),
    ∀ y ∈ Ring.carrier(piMatRing(k, m, d)),
    τ(call2(Ring.mul(piMatRing(k, m, d)), x, y)) = τ(call2(Ring.mul(piMatRing(k, m, d)), y, x))
  requires natural : ∀ i ∈ m, ∃ c ∈ ℕ, τ(piMatrixUnit(k, m, d, i, 0, 0)) = natCast(k, c)
  requires unit : ∃ c ∈ ℕ, HasCardinality(n, c) ∧ τ(Ring.one(piMatRing(k, m, d))) = natCast(k, c)
  shows ∃ r, GroupHom(r, G, generalLinearGroup(k, n)) ∧ csGRIsTraceNondeg(G, k, n, r) ∧
    (∀ g ∈ Group.carrier(G), matTrace(k, n, r(g)) = τ(s(g)))
proof
  sorry

-- Section: Intertwiners
-- SemisimpleReps.lean, intertwiner f g U = Σ_i Σ_a f(E^i_a0) U_i g(E^i_0a)
-- for k-algebra maps f into M_N(k) and g into Mₙ(k) and U_i of size N × n.
def intertwinerTerms (k m d N n f g U : Set) : Set :=
  { (q, matMul(k, N, N, n, f(piMatrixUnit(k, m, d, fst(q), snd(q), 0)),
      matMul(k, N, n, n, U(fst(q)), g(piMatrixUnit(k, m, d, fst(q), 0, snd(q)))))) |
    q ∈ piMatIndexPairs(m, d) }

def intertwiner (k m d N n f g U : Set) : Set :=
  moduleSum(matrixModule(k, N, n), piMatIndexPairs(m, d),
    intertwinerTerms(k, m, d, N, n, f, g, U))

-- SemisimpleReps.lean, mul_intertwiner: f(z) I = I g(z).
theorem intertwiner.mul (k m d N n f g U z : Set)
  requires field : Field(k)
  requires sizes : csGRPositiveSizes(m, d)
  requires finiteN : Finite(N)
  requires finiteSmall : Finite(n)
  requires homF : AlgebraHom(f, piMatAlgebra(k, m, d), csGRMatAlgebra(k, N))
  requires homG : AlgebraHom(g, piMatAlgebra(k, m, d), csGRMatAlgebra(k, n))
  requires family : ∀ i ∈ m, U(i) ∈ matrixSpace(k, N, n)
  requires element : z ∈ Ring.carrier(piMatRing(k, m, d))
  shows matMul(k, N, N, n, f(z), intertwiner(k, m, d, N, n, f, g, U)) =
    matMul(k, N, n, n, intertwiner(k, m, d, N, n, f, g, U), g(z))
proof
  sorry

-- SemisimpleReps.lean, exists_piMat_retract: if rank g(E^i_00) ≤ rank
-- f(E^i_00) for every i, some P (N × n) and Q (n × N) have QP = 1 and
-- f(z) P = P g(z) for all z.
theorem exists_piMat_retract (k m d N n f g : Set)
  requires field : Field(k)
  requires sizes : csGRPositiveSizes(m, d)
  requires finiteN : Finite(N)
  requires finiteSmall : Finite(n)
  requires homF : AlgebraHom(f, piMatAlgebra(k, m, d), csGRMatAlgebra(k, N))
  requires homG : AlgebraHom(g, piMatAlgebra(k, m, d), csGRMatAlgebra(k, n))
  requires ranks : ∀ i ∈ m, csGRMatRank(k, n, g(piMatrixUnit(k, m, d, i, 0, 0))) ⊆
    csGRMatRank(k, N, f(piMatrixUnit(k, m, d, i, 0, 0)))
  shows ∃ P ∈ matrixSpace(k, N, n), ∃ Q ∈ matrixSpace(k, n, N),
    matMul(k, n, N, n, Q, P) = matOne(k, n) ∧
    (∀ z ∈ Ring.carrier(piMatRing(k, m, d)),
      matMul(k, N, N, n, f(z), P) = matMul(k, N, n, n, P, g(z)))
proof
  sorry

-- Section: Wedderburn, Clifford, Brauer–Nesbitt
-- SemisimpleReps.lean, HasSemiprimeSpan k ρ: every x in the span of ρ(G)
-- with x ρ(g) x = 0 for all g is zero.
predicate HasSemiprimeSpan (G B ρ : Set) :=
  ∀ x ∈ moduleSpan(algebraModule(B), Algebra.base(B),
      functionImage(ρ, Group.carrier(G), algebraCarrier(B))),
    (∀ g ∈ Group.carrier(G), call2(Ring.mul(Algebra.ring(B)),
      call2(Ring.mul(Algebra.ring(B)), x, ρ(g)), x) = Ring.zero(Algebra.ring(B))) →
    x = Ring.zero(Algebra.ring(B))

-- The image of a group homomorphism f : H → G is normal.
predicate csGRNormalImage (f H G : Set) :=
  NormalSubgroup(functionImage(f, Group.carrier(H), Group.carrier(G)), G)

-- The matrix representation r : G → GLₙ(k) as a monoid homomorphism into
-- the k-algebra Mₙ(k).
theorem csGRIsTraceNondeg.hasSemiprimeSpan (G k n r : Set)
  requires field : Field(k)
  requires finite : Finite(n)
  requires hom : GroupHom(r, G, generalLinearGroup(k, n))
  requires semisimple : csGRIsTraceNondeg(G, k, n, r)
  shows HasSemiprimeSpan(G, csGRMatAlgebra(k, n), r)
proof
  sorry

-- SemisimpleReps.lean, exists_wedderburn (Wedderburn–Clifford): for k
-- algebraically closed of characteristic 0, B finite-dimensional, ρ with
-- semiprime span and f : H → G of normal image, ρ ∘ f = F ∘ s with s(H)
-- spanning a product Π_{i∈b} M_{d(i)}(k) and F an algebra map into B
-- nonzero on every E^i_00.
theorem exists_wedderburn (G H B ρ f : Set)
  requires closed : AlgebraicallyClosed(Algebra.base(B))
  requires charZero : CharZero(Algebra.base(B))
  requires finiteDim : FiniteDimensional(algebraModule(B), Algebra.base(B))
  requires hom : csGRMonoidHomInto(G, B, ρ)
  requires groupHom : GroupHom(f, H, G)
  requires normal : csGRNormalImage(f, H, G)
  requires semiprime : HasSemiprimeSpan(G, B, ρ)
  shows ∃ b ∈ ℕ, ∃ d, csGRPositiveSizes(b, d) ∧ (∃ s, ∃ F,
    csGRMonoidHomInto(H, piMatAlgebra(Algebra.base(B), b, d), s) ∧
    AlgebraHom(F, piMatAlgebra(Algebra.base(B), b, d), B) ∧
    (∀ i ∈ b, F(piMatrixUnit(Algebra.base(B), b, d, i, 0, 0)) ≠ Ring.zero(Algebra.ring(B))) ∧
    moduleSpan(algebraModule(piMatAlgebra(Algebra.base(B), b, d)), Algebra.base(B),
      functionImage(s, Group.carrier(H), Ring.carrier(piMatRing(Algebra.base(B), b, d)))) =
      Ring.carrier(piMatRing(Algebra.base(B), b, d)) ∧
    (∀ g ∈ Group.carrier(H), F(s(g)) = ρ(f(g))))
proof
  sorry

-- The composite r ∘ f.
def csGRRepCompose (H r f : Set) : Set := { (g, r(f(g))) | g ∈ Group.carrier(H) }

-- SemisimpleReps.lean, IsTraceNondeg.comp (Clifford's theorem): the
-- restriction of a semisimple r along f : H → G of normal image is
-- semisimple.
theorem csGRIsTraceNondeg.comp (G H k n r f : Set)
  requires closed : AlgebraicallyClosed(k)
  requires charZero : CharZero(k)
  requires finite : Finite(n)
  requires hom : GroupHom(r, G, generalLinearGroup(k, n))
  requires semisimple : csGRIsTraceNondeg(G, k, n, r)
  requires groupHom : GroupHom(f, H, G)
  requires normal : csGRNormalImage(f, H, G)
  shows csGRIsTraceNondeg(H, k, n, csGRRepCompose(H, r, f))
proof
  sorry

-- SemisimpleReps.lean, IsTraceNondeg.exists_conj_of_trace_eq (the
-- Brauer–Nesbitt theorem): for r semisimple, ρ : G → B with semiprime
-- span and φ : B → Mₙ(k) a k-algebra map with tr r(g) = tr φ(ρ(g)), some
-- invertible P has r(g) P = P φ(ρ(g)) for all g.
theorem csGRIsTraceNondeg.exists_conj_of_trace_eq (G k n r B ρ φ : Set)
  requires closed : AlgebraicallyClosed(k)
  requires charZero : CharZero(k)
  requires finite : Finite(n)
  requires base : Algebra.base(B) = k
  requires finiteDim : FiniteDimensional(algebraModule(B), k)
  requires hom : GroupHom(r, G, generalLinearGroup(k, n))
  requires semisimple : csGRIsTraceNondeg(G, k, n, r)
  requires monoidHom : csGRMonoidHomInto(G, B, ρ)
  requires semiprime : HasSemiprimeSpan(G, B, ρ)
  requires algHom : AlgebraHom(φ, B, csGRMatAlgebra(k, n))
  requires traces : ∀ g ∈ Group.carrier(G), matTrace(k, n, r(g)) = matTrace(k, n, φ(ρ(g)))
  shows ∃ P ∈ invertibleMatrices(k, n), ∀ g ∈ Group.carrier(G),
    matMul(k, n, n, n, r(g), P) = matMul(k, n, n, n, P, φ(ρ(g)))
proof
  sorry

-- Two semisimple representations with the same trace are conjugate (the
-- case B = Mₙ(k), φ = id, ρ = s of the theorem above).
theorem csGRIsTraceNondeg.conj_of_trace_eq (G k n r s : Set)
  requires closed : AlgebraicallyClosed(k)
  requires charZero : CharZero(k)
  requires finite : Finite(n)
  requires hom : GroupHom(r, G, generalLinearGroup(k, n))
  requires homS : GroupHom(s, G, generalLinearGroup(k, n))
  requires semisimple : csGRIsTraceNondeg(G, k, n, r)
  requires semisimpleS : csGRIsTraceNondeg(G, k, n, s)
  requires traces : ∀ g ∈ Group.carrier(G), matTrace(k, n, r(g)) = matTrace(k, n, s(g))
  shows ∃ P ∈ invertibleMatrices(k, n), ∀ g ∈ Group.carrier(G),
    matMul(k, n, n, n, r(g), P) = matMul(k, n, n, n, P, s(g))
proof
  sorry

end Pseudocharacter
