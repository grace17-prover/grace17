-- Places of an algebraic closure and the Galois-side objects the Galois
-- representations of the GRH port are stated with: Gal(Ω/E) for a number
-- field E inside an algebraic closure Ω, places of Ω as valuation
-- subrings, decomposition and inertia groups, arithmetic Frobenius
-- elements, places over a prime of E, the ℓ-adic cyclotomic character,
-- the local Galois group G_ℓ = Gal(ℚ̄_ℓ/ℚ_ℓ), embeddings of Ω into ℚ̄_ℓ
-- inducing a place, Frobenius data and the filter of most Frobenii.
-- Every definition here is a STAND-IN for a declaration of a source
-- group not yet stated (Lib/ClassField/Places, Lib/ClassField/Chebotarev,
-- Lib/PadicHodge/PeriodRings, Lib/General/Algebra/AdicRingHomExt); each
-- names its source declaration.
-- Encoding. The source fixes Ω = AlgebraicClosure ℚ and a number field
-- E with [Algebra E Ω]. Here the pair is one Cumulus algebra X with base
-- E = Algebra.base(X) a number field and ring Ω = Algebra.ring(X) an
-- algebraic closure of E (hence of ℚ); Gal(Ω/E) is galoisGroup(X) with
-- krullTopology(X). A place of Ω (ClosurePlace) is a valuation subring A
-- of Ω. ℚ̄_ℓ is an algebra Q over ℚ_ℓ with PadicAlgebraicClosure(ℓ, Q).
-- A Frobenius datum (w, A, s) is the set ((w, A), s).
-- Part of the GRH blueprint (layer 4, Lib/GaloisRep).
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.GaloisRep.Places
import GRH.Adelic.Adeles
import GRH.General.PadicPlace

section Places

-- Section: Number fields inside an algebraic closure
-- STAND-IN for ClassField/Places/GaloisDefs.lean, Ω and
-- ClassField/Places/DecompositionLocal.lean, EmbeddedNumberField: X is
-- the extension Ω/E of a number field E by an algebraic closure Ω.
predicate csGRClosure (X : Set) :=
  NumberField(Algebra.base(X)) ∧ IsAlgebraicClosure(X)

-- The field Ω of X, its carrier, and Gal(Ω/E) with the Krull topology.
def csGROmega (X : Set) : Set := Algebra.ring(X)
def csGRGal (X : Set) : Set := galoisGroup(X)
def csGRGalSpace (X : Set) : Set := krullTopology(X)

-- STAND-IN for ClassField/Places/GaloisDefs.lean, ClosurePlace: a place
-- of Ω is a valuation subring of Ω (Ω itself, the trivial one, included).
predicate csGRClosurePlace (X A : Set) := ValuationSubring(Algebra.ring(X), A)

-- The maximal ideal of the valuation subring A.
def csGRMaxIdeal (X A : Set) : Set := valuationSubringNonunits(Algebra.ring(X), A)

-- STAND-IN for ClassField/Places/GaloisDefs.lean, decompGroup: the
-- σ ∈ Gal(Ω/E) with σ(A) = A.
def csGRDecompGroup (X A : Set) : Set :=
  { σ ∈ algebraAutomorphisms(X) | functionImage(σ, A, algebraCarrier(X)) = A }

-- The decomposition group as a group.
def csGRDecompGroupGroup (X A : Set) : Set :=
  subgroupGroup(galoisGroup(X), csGRDecompGroup(X, A))

-- STAND-IN for ClassField/Places/GaloisDefs.lean, IsFrob A q σ: σ fixes A
-- and σ(x) ≡ x^q modulo the maximal ideal of A for every x ∈ A (an
-- arithmetic Frobenius when q is the residue order of the base).
predicate csGRIsFrob (X A : Set, q : Nat, σ : Set) :=
  σ ∈ csGRDecompGroup(X, A) ∧
  (∀ x ∈ A, Ring.sub(Algebra.ring(X), σ(x), Ring.pow(Algebra.ring(X), x, q)) ∈
    csGRMaxIdeal(X, A))

-- STAND-IN for ClassField/Places/GaloisDefs.lean, inertiaGroup: the σ
-- with IsFrob A 1 σ.
def csGRInertiaGroup (X A : Set) : Set :=
  { σ ∈ algebraAutomorphisms(X) | csGRIsFrob(X, A, 1, σ) }

-- STAND-IN for ClassField/Places/GaloisDefs.lean, IsPlaceOver A v: an
-- integer of E lies in the maximal ideal of A exactly when it lies in v.
predicate csGRIsPlaceOver (X A w : Set) :=
  csGRClosurePlace(X, A) ∧ w ∈ finPlaces(Algebra.base(X)) ∧
  (∀ x ∈ ringOfIntegers(Algebra.base(X)),
    Algebra.map(X)(x) ∈ csGRMaxIdeal(X, A) ↔ x ∈ w)

-- STAND-IN for Adelic/Adeles/CoprimeValuation.lean, FinPlace.IsSplit: the
-- finite place w of the CM field E is split, w̄ ≠ w (w̄ the image of w
-- under complex conjugation of E).
def csGRConjPlace (E w : Set) : Set := functionImage(cmConjugation(E), w, Ring.carrier(E))

predicate csGRIsSplit (E w : Set) := csGRConjPlace(E, w) ≠ w

-- Section: The ℓ-adic cyclotomic character
-- STAND-IN for ClassField/Places/GaloisDefs.lean, cycChar Ω ℓ: for a ring
-- automorphism σ of a field L containing ℓⁿ distinct ℓⁿ-th roots of
-- unity for every n, the unique a ∈ ℤ_ℓ with σ(ζ) = ζ^(a mod ℓⁿ) for every
-- ℓⁿ-th root of unity ζ and every n.
defunique csGRCycChar (L : Set, l : Nat, σ : Set) (a ∈ padicIntCarrier(l)) :=
  ∀ n ∈ ℕ, ∀ ζ ∈ rootsOfUnity(L, l ^ n),
    σ(ζ) = Ring.pow(L, ζ, zmodVal(l ^ n, padicToZModPow(l, n)(a)))
requires prime : Prime(l)
requires field : Field(L)
requires roots : ∀ n ∈ ℕ, HasCardinality(rootsOfUnity(L, l ^ n), l ^ n)
requires automorphism : σ ∈ ringAutomorphisms(L)
proof
  sorry
uniqueness
  sorry

-- Section: The local Galois group
-- STAND-IN for PadicHodge/PeriodRings/CpIntegers.lean, Gp ℓ and intQpBar
-- ℓ: G_ℓ = Gal(ℚ̄_ℓ/ℚ_ℓ) with the Krull topology, and the integers of ℚ̄_ℓ.
def csGRGp (Q : Set) : Set := galoisGroup(Q)
def csGRGpSpace (Q : Set) : Set := krullTopology(Q)

-- STAND-IN for PadicHodge/Crystalline/Defs.lean, IsWeilPair s m: s ∈ G_ℓ
-- acts on the residue field of ℚ̄_ℓ as x ↦ x^(ℓ^(−m)): s⁻¹ is a Frobenius
-- for the exponent ℓ^m at the integers of ℚ̄_ℓ; m = 0 is inertia.
predicate csGRIsWeilPair (l : Nat, Q s : Set, m : Nat) :=
  csGRIsFrob(Q, padicAlgClIntegers(l, Q), l ^ m, Group.inv(galoisGroup(Q))(s))

-- STAND-IN for General/Algebra/AdicRingHomExt.lean, ThePrime ℓ and PadicIso
-- ℓ: the prime ℓ, an algebraic closure Q of ℚ_ℓ and a ring isomorphism
-- ι : ℂ ≃ ℚ̄_ℓ.
predicate csGRPadicIso (l : Nat, Q ι : Set) :=
  PadicAlgebraicClosure(l, Q) ∧ RingIso(ι, complexRing, Algebra.ring(Q))

-- Section: Embeddings inducing a place
-- STAND-IN for ClassField/Places/PadicDecomposition.lean, InducesPlace E A e
-- j and Main/LocalEmbedding.lean, PadicPlaceEmbedding A ℓ: e : Ω → ℚ̄_ℓ is
-- a ring homomorphism pulling the integers of ℚ̄_ℓ back to A, and j embeds
-- the decomposition group of A into G_ℓ, compatibly with e, onto the
-- automorphisms fixing e(E) pointwise (IsCompletionGroup).
-- The places of Ω pulled back from the integers of ℚ̄_ℓ along e.
def csGRPullbackIntegers (X : Set, l : Nat, Q e : Set) : Set :=
  { x ∈ algebraCarrier(X) | e(x) ∈ padicAlgClIntegers(l, Q) }

-- The image e(E) ⊆ ℚ̄_ℓ of the base field.
def csGRBaseImage (X Q e : Set) : Set :=
  functionImage(e, functionImage(Algebra.map(X), Ring.carrier(Algebra.base(X)),
    algebraCarrier(X)), algebraCarrier(Q))

predicate csGRInducesPlace (X A : Set, l : Nat, Q e j : Set) :=
  csGRClosurePlace(X, A) ∧ PadicAlgebraicClosure(l, Q) ∧
  RingHom(e, Algebra.ring(X), Algebra.ring(Q)) ∧
  A = csGRPullbackIntegers(X, l, Q, e) ∧
  GroupHom(j, csGRDecompGroupGroup(X, A), galoisGroup(Q)) ∧
  InjectiveBetween(j, csGRDecompGroup(X, A), algebraAutomorphisms(Q)) ∧
  (∀ g ∈ csGRDecompGroup(X, A), ∀ x ∈ algebraCarrier(X), j(g)(e(x)) = e(g(x))) ∧
  functionImage(j, csGRDecompGroup(X, A), algebraAutomorphisms(Q)) =
    fixingSubgroup(Q, csGRBaseImage(X, Q, e))

-- Section: Frobenius data and most Frobenii
-- STAND-IN for ClassField/Chebotarev/FrobeniusFilter.lean, FrobeniusDatum
-- E: a finite place w of E of prime norm, a place A of Ω above w, and a
-- geometric Frobenius s at A (s⁻¹ is a Frobenius for the exponent q_w).
predicate csGRIsFrobDatum (X w A s : Set) :=
  w ∈ finPlaces(Algebra.base(X)) ∧
  csGRIsPlaceOver(X, A, w) ∧ s ∈ algebraAutomorphisms(X) ∧
  (∃ q ∈ ℕ, q = placeNorm(Algebra.base(X), w) ∧ Prime(q) ∧
    csGRIsFrob(X, A, q, Group.inv(galoisGroup(X))(s)))

def csGRFrobData (X : Set) : Set :=
  { d ∈ (finPlaces(Algebra.base(X)) × 𝒫(algebraCarrier(X))) × algebraAutomorphisms(X) |
    csGRIsFrobDatum(X, fst(fst(d)), snd(fst(d)), snd(d)) }

-- The data whose Frobenius lies in O at the places outside F.
def csGRFrobDataIn (X O F : Set) : Set :=
  { d ∈ csGRFrobData(X) | fst(fst(d)) ∉ F ∧ snd(d) ∈ O }

-- STAND-IN for ClassField/Chebotarev/FrobeniusFilter.lean, mostFrobenii E:
-- S is large when each nonempty open V of Gal(Ω/E) has a nonempty open
-- O ⊆ V such that, outside finitely many places w, every Frobenius datum
-- (w, A, s) with s ∈ O lies in S.
def csGRMostFrobenii (X : Set) : Set :=
  { S ∈ 𝒫(csGRFrobData(X)) | ∀ V ∈ krullOpens(X), V ≠ ∅ →
    (∃ O ∈ krullOpens(X), O ⊆ V ∧ O ≠ ∅ ∧
      (∃ F, Finite(F) ∧ csGRFrobDataIn(X, O, F) ⊆ S)) }

-- Section: Facts
-- FrobeniusFilter.lean, mostFrobenii is a filter (its Filter structure).
theorem csGRMostFrobenii.filter (X : Set)
  requires closure : csGRClosure(X)
  shows IsFilter(csGRFrobData(X), csGRMostFrobenii(X))
proof
  sorry

-- FrobeniusFilter.lean, eventually_mostFrobenii: a property of the
-- places holding outside a finite set holds for most Frobenii.
theorem csGRMostFrobenii.of_cofinite (X S F : Set)
  requires closure : csGRClosure(X)
  requires finite : Finite(F)
  requires subset : S ⊆ csGRFrobData(X)
  requires large : ∀ d ∈ csGRFrobData(X), fst(fst(d)) ∉ F → d ∈ S
  shows S ∈ csGRMostFrobenii(X)
proof
  sorry

-- GaloisDefs.lean: the inertia group is a subgroup of the decomposition
-- group (inertiaGroup, IsFrob.mul_iff).
theorem csGRInertiaGroup.subgroup (X A : Set)
  requires closure : csGRClosure(X)
  requires place : csGRClosurePlace(X, A)
  shows Subgroup(csGRInertiaGroup(X, A), csGRDecompGroupGroup(X, A))
proof
  sorry

-- GaloisDefs.lean, IsFrob.inv_mul: two Frobenius elements for the same
-- exponent differ by inertia.
theorem csGRIsFrob.inv_mul (X A σ τ : Set, q : Nat)
  requires closure : csGRClosure(X)
  requires place : csGRClosurePlace(X, A)
  requires frobσ : csGRIsFrob(X, A, q, σ)
  requires frobτ : csGRIsFrob(X, A, q, τ)
  shows Group.mul(galoisGroup(X))(Group.inv(galoisGroup(X))(σ), τ) ∈ csGRInertiaGroup(X, A)
proof
  sorry

-- GaloisDefs.lean, IsFrob.pow: σ^k is a Frobenius for q^k.
theorem csGRIsFrob.pow (X A σ : Set, q k : Nat)
  requires closure : csGRClosure(X)
  requires place : csGRClosurePlace(X, A)
  requires frob : csGRIsFrob(X, A, q, σ)
  shows csGRIsFrob(X, A, q ^ k, groupPow(galoisGroup(X), σ, k))
proof
  sorry

-- LocalEmbedding.lean, PadicPlaceEmbedding.isFrob_iff: for s in the
-- decomposition group of A and an embedding inducing A, j(s) is a
-- Frobenius for q at the integers of ℚ̄_ℓ iff s is one at A.
theorem csGRInducesPlace.isFrob_iff (X A : Set, l : Nat, Q e j s : Set, q : Nat)
  requires closure : csGRClosure(X)
  requires induces : csGRInducesPlace(X, A, l, Q, e, j)
  requires decomp : s ∈ csGRDecompGroup(X, A)
  shows csGRIsFrob(Q, padicAlgClIntegers(l, Q), q, j(s)) ↔ csGRIsFrob(X, A, q, s)
proof
  sorry

-- LocalEmbedding.lean, PadicPlaceEmbedding.isWeilPair_zero_iff: (j(s), 0)
-- is a Weil pair iff s lies in the inertia group of A.
theorem csGRInducesPlace.isWeilPair_zero_iff (X A : Set, l : Nat, Q e j s : Set)
  requires closure : csGRClosure(X)
  requires induces : csGRInducesPlace(X, A, l, Q, e, j)
  requires decomp : s ∈ csGRDecompGroup(X, A)
  shows csGRIsWeilPair(l, Q, j(s), 0) ↔ s ∈ csGRInertiaGroup(X, A)
proof
  sorry

-- LocalEmbedding.lean, PadicPlaceEmbedding.cyclotomicGp_eq_cycChar: the
-- cyclotomic characters of G_ℓ and of Gal(Ω/E) agree along j.
theorem csGRInducesPlace.cycChar_eq (X A : Set, l : Nat, Q e j g : Set)
  requires closure : csGRClosure(X)
  requires induces : csGRInducesPlace(X, A, l, Q, e, j)
  requires decomp : g ∈ csGRDecompGroup(X, A)
  shows csGRCycChar(Algebra.ring(Q), l, j(g)) = csGRCycChar(Algebra.ring(X), l, g)
proof
  sorry

-- PadicDecomposition.lean, exists_inducesPlace: every embedding e : Ω → ℚ̄_ℓ
-- pulling the integers back to A induces A with some j.
theorem csGRInducesPlace.exists (X A : Set, l : Nat, Q e : Set)
  requires closure : csGRClosure(X)
  requires algcl : PadicAlgebraicClosure(l, Q)
  requires hom : RingHom(e, Algebra.ring(X), Algebra.ring(Q))
  requires pullback : A = csGRPullbackIntegers(X, l, Q, e)
  shows ∃ j, csGRInducesPlace(X, A, l, Q, e, j)
proof
  sorry

-- GaloisDefs.lean / LocalDefs.lean, placeOver and isPlaceOver_placeOver:
-- every finite place of E has a place of Ω over it.
theorem csGRIsPlaceOver.exists (X w : Set)
  requires closure : csGRClosure(X)
  requires place : w ∈ finPlaces(Algebra.base(X))
  shows ∃ A, csGRIsPlaceOver(X, A, w)
proof
  sorry

end Places
