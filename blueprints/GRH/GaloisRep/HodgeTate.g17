-- The Hodge–Tate cocharacter lies in the Zariski closure of the image of
-- inertia near the identity, in coordinates over ℂ_p: a polynomial over
-- ℂ_p vanishing at the cyclotomically twisted Galois translates
-- (χ(g)^(−κ_i) g(x_i))_i for all g ∈ G_p near 1 vanishes along the
-- one-parameter torus t ↦ (t^(κ_i) x_i)_i (Serre; Sen).
-- Source: grh-compact/src/Lib/GaloisRep/HodgeTateCocharacter/
-- HodgeTateCocharacter.lean (aeval_cocharacter_eq_zero).
-- Encoding. ℚ̄_p is an algebra Q over ℚ_p with PadicAlgebraicClosure(p,
-- Q); ℂ_p = cpField(p, Q), on which G_p = Gal(ℚ̄_p/ℚ_p) acts through
-- cpGaloisAction (GRH.Padic.Cp); χ is the p-adic cyclotomic character
-- csGRCycChar of GRH.GaloisRep.Places, read in ℂ_p through ℤ_p ⊆ ℚ_p.
-- The source's conclusion is the vanishing of F(T^(κ_i) x_i) in the
-- Laurent polynomials ℂ_p[T, T⁻¹]; ℂ_p being infinite, this is the
-- vanishing of F(t^(κ_i) x_i) for every t ∈ ℂ_p^×, the form stated here.
-- Part of the GRH blueprint (layer 4, Lib/GaloisRep).
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.GaloisRep.HodgeTate
import GRH.GaloisRep.Places

section HodgeTate

-- a^k for a unit a of the field K and an integer k.
def csGRZPow (K a k : Set) : Set :=
  ⋃({ c ∈ Ring.carrier(K) | ∃ m ∈ ℕ,
    (k = integerOfNat(m) ∧ c = Ring.pow(K, a, m)) ∨
    (k = integerNegValue(integerOfNat(m)) ∧ c = Ring.pow(K, ringInverse(K, a), m)) })

-- The twisted translate (χ(g)^(−κ_i) · g(x_i))_i in ℂ_p^n.
def cyclotomicTwistPoint (p : Nat, Q n κ x g : Set) : Set :=
  { (i, call2(Ring.mul(cpField(p, Q)),
      csGRZPow(cpField(p, Q), cpOfPadic(p, Q)(csGRCycChar(Algebra.ring(Q), p, g)),
        integerNegValue(κ(i))),
      cpGaloisAction(p, Q, g)(x(i)))) | i ∈ n }

-- The point (t^(κ_i) x_i)_i of the torus through x.
def cocharacterPoint (p : Nat, Q n κ x t : Set) : Set :=
  { (i, call2(Ring.mul(cpField(p, Q)), csGRZPow(cpField(p, Q), t, κ(i)), x(i))) | i ∈ n }

-- HodgeTateCocharacter.lean, aeval_cocharacter_eq_zero: if F vanishes at
-- (χ(g)^(−κ_i) g(x_i))_i for all g in a neighbourhood of 1 in G_p, then F
-- vanishes at (t^(κ_i) x_i)_i for every t ∈ ℂ_p^×.
theorem cocharacter.eval_eq_zero (p : Nat, Q n κ x F : Set)
  requires algcl : PadicAlgebraicClosure(p, Q)
  requires finite : Finite(n)
  requires weights : FunctionBetween(κ, n, ℤ)
  requires point : FunctionBetween(x, n, Ring.carrier(cpField(p, Q)))
  requires poly : F ∈ Ring.carrier(polynomialRing(cpField(p, Q), n))
  requires vanishing : ∃ U ∈ krullOpens(Q), identity(algebraCarrier(Q)) ∈ U ∧
    (∀ g ∈ U, evaluationAt(cpField(p, Q), n, cyclotomicTwistPoint(p, Q, n, κ, x, g))(F) =
      Ring.zero(cpField(p, Q)))
  shows ∀ t ∈ ringUnits(cpField(p, Q)),
    evaluationAt(cpField(p, Q), n, cocharacterPoint(p, Q, n, κ, x, t))(F) =
      Ring.zero(cpField(p, Q))
proof
  sorry

end HodgeTate
