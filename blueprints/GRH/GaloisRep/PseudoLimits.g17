-- Limits of traces: uniform closures of spans of functions into a normed
-- field, approximating monoids of eigenvalue data, limits of traces of
-- continuous semisimple representations, continuity of a semisimple
-- representation from its trace, det(1 − cN) as a product over
-- eigenvalues, a vanishing finite sum descending along a map weighted by
-- fibre sizes, and the ultrametric Stone–Weierstrass theorem for modules.
-- Source: grh-compact/src/Lib/GaloisRep/Pseudocharacter/FibreSum.lean
-- (uniformClosure, mem_uniformClosure, IsApproximatingMonoid,
-- isApproximatingMonoid_of_mem_closure, exists_trace_limit,
-- det_one_sub_smul_eq_prod_roots, finsum_image_eq_zero_of_fibers),
-- Pseudocharacter/SemisimpleReps.lean (IsTraceNondeg.continuous_of_trace),
-- WeightCongruence/WeightCongruence.lean (stoneWeierstrass_ultrametric).
-- Encoding. A normed field is a pair (K, ‖·‖) with NormedField(K, ‖·‖);
-- functions ι → K are elements of functionSpace(ι, K). The source's
-- uniformClosure (the closure of the span in the topology of uniform
-- convergence) is defined by its characterization mem_uniformClosure. An
-- approximating monoid is indexed by J = {(η, i) : η > 0, i < s(η)} (the
-- sigma type Σ η, Fin (s η)); its uniform convergence as η → 0⁺ (the
-- source's atBot on Ioi 0) is written with ε and δ. The continuous
-- functions C(X, k) of the Stone–Weierstrass theorem form a submodule N
-- of the K-module of functions on the compact space X.
-- Part of the GRH blueprint (layer 4, Lib/GaloisRep, plan group S1
-- GRH.GaloisRep.Pseudocharacter).
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.GaloisRep.PseudoLimits
import GRH.GaloisRep.Pseudocharacter
import GRH.Normed.Groups

section PseudoLimits
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- Section: Uniform closures
-- The pointwise difference of two functions ι → K.
def funSub (K ι f g : Set) : Set := { (x, Ring.sub(K, f(x), g(x))) | x ∈ ι }

-- FibreSum.lean, uniformClosure S, read by mem_uniformClosure: the f with,
-- for every ε > 0, some g in the K-span of S with ‖f(x) − g(x)‖ ≤ ε for
-- all x.
def uniformClosure (K norm ι S : Set) : Set :=
  { f ∈ functionSpace(ι, Ring.carrier(K)) | ∀ ε ∈ ℝ, (0:R) < ε →
    (∃ g ∈ moduleSpan(coordinateModule(K, ι), K, S), ∀ x ∈ ι,
      norm(Ring.sub(K, f(x), g(x))) ≤ ε) }

-- The uniform closure is a submodule containing the span (Mathlib's
-- topologicalClosure of a submodule).
theorem uniformClosure.submodule (K norm ι S : Set)
  requires normed : NormedField(K, norm)
  requires functions : S ⊆ functionSpace(ι, Ring.carrier(K))
  shows SubmoduleOf(uniformClosure(K, norm, ι, S), coordinateModule(K, ι), K) ∧
    moduleSpan(coordinateModule(K, ι), K, S) ⊆ uniformClosure(K, norm, ι, S)
proof
  sorry

-- Section: Approximating monoids
-- The index set J = {(η, i) : η > 0, i < s(η)}.
def approxIndex (s : Set) : Set := { q ∈ ℝ × ℕ | (0:R) < fst(q) ∧ snd(q) ∈ s(fst(q)) }

-- The sum Σ_{i<s(η)} c(η)(i) · v((η, i)).
def approxSumTerms (K s c η v : Set) : Set :=
  { (i, call2(Ring.mul(K), c(η)(i), v((η, i)))) | i ∈ s(η) }

def approxSum (K s c η v : Set) : Set :=
  finiteRingSum(s(η), Ring.carrier(K), Ring.add(K), Ring.zero(K), Ring.neg(K), Ring.mul(K),
    Ring.one(K), approxSumTerms(K, s, c, η, v))

-- The constant function 1 on J and the pointwise product of v, v' : J → K.
def approxOne (K s : Set) : Set := constantFunction(approxIndex(s), Ring.carrier(K), Ring.one(K))

def approxMul (K s v v2 : Set) : Set :=
  { (q, call2(Ring.mul(K), v(q), v2(q))) | q ∈ approxIndex(s) }

-- The space K × K^J with the product of the norm topologies.
def approxCoordSpaces (K norm s : Set) : Set :=
  { (q, normTopology(Ring.additive(K), norm)) | q ∈ approxIndex(s) }

def approxSpace (K norm s : Set) : Set :=
  productSpace(normTopology(Ring.additive(K), norm), piSpace(approxIndex(s),
    approxCoordSpaces(K, norm, s)))

-- FibreSum.lean, IsApproximatingMonoid s c N: N ⊆ K × K^J is a closed
-- submonoid and Σ_i c(η)(i) v((η, i)) → t as η → 0⁺, uniformly over (t, v)
-- ∈ N.
predicate IsApproximatingMonoid (K norm s c N : Set) :=
  NormedField(K, norm) ∧ FunctionBetween(s, ℝ, ℕ) ∧
  N ⊆ Ring.carrier(K) × functionSpace(approxIndex(s), Ring.carrier(K)) ∧
  (Ring.one(K), approxOne(K, s)) ∈ N ∧
  (∀ p ∈ N, ∀ p2 ∈ N, (call2(Ring.mul(K), fst(p), fst(p2)),
    approxMul(K, s, snd(p), snd(p2))) ∈ N) ∧
  Closed(approxSpace(K, norm, s), N) ∧
  (∀ ε ∈ ℝ, (0:R) < ε → (∃ δ ∈ ℝ, (0:R) < δ ∧ (∀ η ∈ ℝ, (0:R) < η → η < δ →
    (∀ p ∈ N, norm(Ring.sub(K, approxSum(K, s, c, η, snd(p)), fst(p))) < ε))))

-- T : K^ι → K^ι is K-linear and preserves sup-norm bounds.
predicate SupContraction (K norm ι T : Set) :=
  LinearMap(T, coordinateModule(K, ι), K, coordinateModule(K, ι)) ∧
  (∀ f ∈ functionSpace(ι, Ring.carrier(K)), ∀ r ∈ ℝ, (∀ x ∈ ι, norm(f(x)) ≤ r) →
    (∀ x ∈ ι, norm(T(f)(x)) ≤ r))

def funSmul (K ι a f : Set) : Set := { (x, call2(Ring.mul(K), a, f(x))) | x ∈ ι }

-- FibreSum.lean, isApproximatingMonoid_of_mem_closure: for f ≠ 0 in the
-- uniform closure of S there are y : J → S, c and an approximating monoid
-- N containing (λ, (λ_q)) whenever a sup-norm contraction T has T f = λ f
-- and T y_q = λ_q y_q.
theorem IsApproximatingMonoid.of_mem_closure (K norm ι S f : Set)
  requires normed : NormedField(K, norm)
  requires functions : S ⊆ functionSpace(ι, Ring.carrier(K))
  requires closure : f ∈ uniformClosure(K, norm, ι, S)
  requires nonzero : f ≠ constantFunction(ι, Ring.carrier(K), Ring.zero(K))
  shows ∃ s, ∃ c, ∃ N, IsApproximatingMonoid(K, norm, s, c, N) ∧
    (∃ y, FunctionBetween(y, approxIndex(s), S) ∧
      (∀ a ∈ Ring.carrier(K), ∀ v ∈ functionSpace(approxIndex(s), Ring.carrier(K)),
        (∃ T, SupContraction(K, norm, ι, T) ∧ T(f) = funSmul(K, ι, a, f) ∧
          (∀ q ∈ approxIndex(s), T(y(q)) = funSmul(K, ι, v(q), y(q)))) → (a, v) ∈ N))
proof
  sorry

-- Section: Limits of traces
-- The entry function g ↦ r(g)[i, j].
def repEntry (G r i j : Set) : Set := { (g, r(g)[i, j]) | g ∈ Group.carrier(G) }

-- L ⊆ K is complete: every Cauchy sequence in L converges to a point of L.
predicate CompleteSubset (K norm L : Set) :=
  L ⊆ Ring.carrier(K) ∧ (∀ u, FunctionBetween(u, ℕ, L) →
    (∀ ε ∈ ℝ, (0:R) < ε → (∃ M ∈ ℕ, ∀ a ∈ ℕ, ∀ b ∈ ℕ, M ⊆ a → M ⊆ b →
      norm(Ring.sub(K, u(a), u(b))) < ε)) →
    (∃ z ∈ L, ∀ ε ∈ ℝ, (0:R) < ε → (∃ M ∈ ℕ, ∀ a ∈ ℕ, M ⊆ a →
      norm(Ring.sub(K, u(a), z)) < ε)))

-- The elements of N whose first coordinate lies in L, and those whose
-- q-th coordinate is within ε of t.
def approxFirstIn (N L : Set) : Set := { p ∈ N | fst(p) ∈ L }

def approxNear (K norm N q t ε : Set) : Set :=
  { p ∈ N | norm(Ring.sub(K, snd(p)(q), t)) < ε }

-- The pair (tr R(g), (tr r_q(g))_q).
def traceFamily (K n r g s : Set) : Set :=
  { (q, matTrace(K, n, r(q)(g))) | q ∈ approxIndex(s) }

-- FibreSum.lean, exists_trace_limit: given an approximating monoid N and
-- continuous r_q : G → GLₙ(K), suppose for each g a proper filter F(g) on N
-- has first coordinate eventually in a complete L and q-th coordinate
-- tending to tr r_q(g). Then some continuous semisimple R : G → GLₙ(K) has
-- (tr R(g), (tr r_q(g))_q) ∈ N for all g.
theorem exists_trace_limit (K norm s c N G T n r F L : Set)
  requires closed : AlgebraicallyClosed(K)
  requires charZero : CharZero(K)
  requires approximating : IsApproximatingMonoid(K, norm, s, c, N)
  requires topological : TopologicalGroup(G, T)
  requires finite : Finite(n)
  requires complete : CompleteSubset(K, norm, L)
  requires filters : ∀ g ∈ Group.carrier(G), IsFilter(N, F(g)) ∧ ∅ ∉ F(g)
  requires inL : ∀ g ∈ Group.carrier(G), approxFirstIn(N, L) ∈ F(g)
  requires homs : ∀ q ∈ approxIndex(s), GroupHom(r(q), G, generalLinearGroup(K, n))
  requires continuous : ∀ q ∈ approxIndex(s), ∀ i ∈ n, ∀ j ∈ n,
    repEntry(G, r(q), i, j) : T ⇒ normTopology(Ring.additive(K), norm)
  requires limits : ∀ g ∈ Group.carrier(G), ∀ q ∈ approxIndex(s), ∀ ε ∈ ℝ, (0:R) < ε →
    approxNear(K, norm, N, q, matTrace(K, n, r(q)(g)), ε) ∈ F(g)
  shows ∃ Rp, GroupHom(Rp, G, generalLinearGroup(K, n)) ∧
    (∀ i ∈ n, ∀ j ∈ n, repEntry(G, Rp, i, j) : T ⇒ normTopology(Ring.additive(K), norm)) ∧
    csGRIsTraceNondeg(G, K, n, Rp) ∧
    (∀ g ∈ Group.carrier(G), (matTrace(K, n, Rp(g)), traceFamily(K, n, r, g, s)) ∈ N)
proof
  sorry

-- SemisimpleReps.lean, IsTraceNondeg.continuous_of_trace: a semisimple
-- representation into GLₙ(k), k a topological field, with continuous
-- trace is continuous.
theorem csGRIsTraceNondeg.continuous_of_trace (G T k Y n r : Set)
  requires field : Field(k)
  requires ring : TopologicalRing(k, Y)
  requires topological : TopologicalGroup(G, T)
  requires finite : Finite(n)
  requires hom : GroupHom(r, G, generalLinearGroup(k, n))
  requires semisimple : csGRIsTraceNondeg(G, k, n, r)
  requires trace : csGRTraceFn(G, k, n, r) : T ⇒ Y
  shows ∀ i ∈ n, ∀ j ∈ n, repEntry(G, r, i, j) : T ⇒ Y
proof
  sorry

-- Section: Products over eigenvalues and fibre sums
def oneMinusValues (n α c : Set) : Set :=
  { (i, Ring.sub(complexRing, complexOne, call2(complexMul, c, α(i)))) | i ∈ n }

-- FibreSum.lean, det_one_sub_smul_eq_prod_roots: det(1 − cN) =
-- Π_i (1 − c α_i) over the eigenvalues α of N with multiplicity.
theorem matDet.one_sub_smul_eq_prod_roots (n N α c : Set)
  requires finite : Finite(n)
  requires matrix : N ∈ matrixSpace(complexRing, n, n)
  requires roots : csGRCharpolyRoots(complexRing, n, N, α)
  requires scalar : c ∈ complexCarrier
  shows matDet(complexRing, n, matAdd(complexRing, n, n, matOne(complexRing, n),
      matNeg(complexRing, n, n, matSmul(complexRing, n, n, c, N)))) =
    finiteRingProduct(n, complexCarrier, complexAdd, complexZero, complexNeg, complexMul,
      complexOne, oneMinusValues(n, α, c))
proof
  sorry

-- The fibre {s ∈ S : ψ(s) = ψ(t)} and the finite complex sum over a set.
def fibreOf (S ψ t : Set) : Set := { u ∈ S | ψ(u) = ψ(t) }

def csGRComplexSetSum (S G : Set) : Set :=
  finiteRingSum(S, complexCarrier, complexAdd, complexZero, complexNeg, complexMul, complexOne,
    restrict(G, S))

-- FibreSum.lean, finsum_image_eq_zero_of_fibers: if Σ_{t∈S} G(t) = 0 and
-- F(ψ(t)) / |fibre of t| = G(t) / D for t ∈ S, then Σ_{c∈ψ(S)} F(c) = 0.
theorem csGRComplexSetSum.image_eq_zero_of_fibers (S ψ G F D C : Set)
  requires finite : Finite(S)
  requires valuesG : FunctionBetween(G, S, complexCarrier)
  requires mapψ : FunctionBetween(ψ, S, C)
  requires valuesF : FunctionBetween(F, C, complexCarrier)
  requires scalar : D ∈ complexCarrier
  requires vanishing : csGRComplexSetSum(S, G) = complexZero
  requires fibres : ∀ t ∈ S, call2(complexMul, F(ψ(t)),
      apply(complexInv, natCast(complexRing, cardinality(fibreOf(S, ψ, t))))) =
    call2(complexMul, G(t), apply(complexInv, D))
  shows csGRComplexSetSum(functionImage(ψ, S, C), F) = complexZero
proof
  sorry

-- Section: Ultrametric Stone–Weierstrass
-- The multipliers N / N of a submodule N of functions: the u with u d ∈ N
-- for every d ∈ N.
def funMul (k X u d : Set) : Set := { (x, call2(Ring.mul(k), u(x), d(x))) | x ∈ X }

def multipliers (k X N : Set) : Set :=
  { u ∈ functionSpace(X, Ring.carrier(k)) | ∀ d ∈ N, funMul(k, X, u, d) ∈ N }

-- WeightCongruence.lean, stoneWeierstrass_ultrametric: X compact, k an
-- ultrametric normed field, N a submodule of the continuous functions;
-- if for every point a some d ∈ N agrees with φ wherever all multipliers
-- of N take their values at a, then φ is a uniform limit of N.
theorem stoneWeierstrass_ultrametric (X k norm N φ : Set)
  requires compact : Compact(X)
  requires nonempty : TopologicalSpace.carrier(X) ≠ ∅
  requires normed : NormedField(k, norm)
  requires ultrametric : ∀ x ∈ Ring.carrier(k), ∀ y ∈ Ring.carrier(k),
    norm(call2(Ring.add(k), x, y)) ≤ norm(x) ∨ norm(call2(Ring.add(k), x, y)) ≤ norm(y)
  requires submodule : SubmoduleOf(N, coordinateModule(k, TopologicalSpace.carrier(X)), k)
  requires continuousN : ∀ d ∈ N, d : X ⇒ normTopology(Ring.additive(k), norm)
  requires continuousφ : φ : X ⇒ normTopology(Ring.additive(k), norm)
  requires local : ∀ a ∈ TopologicalSpace.carrier(X), ∃ d ∈ N, ∀ x ∈ TopologicalSpace.carrier(X),
    (∀ u ∈ multipliers(k, TopologicalSpace.carrier(X), N), u(x) = u(a)) → φ(x) = d(x)
  shows ∀ ε ∈ ℝ, (0:R) < ε → (∃ g ∈ N, ∀ x ∈ TopologicalSpace.carrier(X),
    norm(Ring.sub(k, φ(x), g(x))) ≤ ε)
proof
  sorry

end PseudoLimits
