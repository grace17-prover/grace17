-- Improper integrals. A complex function of a real variable is integrated
-- through its real and imaginary parts with the Riemann integral; the
-- improper integral over [A, ∞) is the limit of the integrals over [A, T]
-- as T → ∞, for real and for complex functions. The comparison test, the
-- bound by a dominating function, the integral of x^(−σ) for σ > 1,
-- linearity, splitting at a point; and holomorphy in a complex parameter
-- s of s ↦ ∫_A^∞ K(s)(x) dx under a locally uniform dominating bound, with
-- the derivative under the integral sign.
-- Part of the GRH blueprint.
-- Planned home: Real/Analysis/Integration/Improper.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Integral
import GRH.Holomorphic
import Grace.Cumulus.Real.Analysis.Integration
import Grace.Cumulus.Real.Analysis.ChainRule

section ImproperIntegrals
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- Section: Complex functions of a real variable
-- A complex function of a real variable is a function g with g(x) ∈ ℂ for
-- every real x, ComplexValuedOn(g, ℝ); a function needed on [A, ∞) only is
-- extended to ℝ arbitrarily, since the integrals below read only its
-- values there. Its real and imaginary parts are functions ℝ → ℝ.
defgraph complexFunctionRe (g : Set) (X ∈ ℝ) : ℝ := complexRe(g(X))
requires values : ComplexValuedOn(g, ℝ)
proof
  have value := values with member
  exact complexRe.real with value

defgraph complexFunctionIm (g : Set) (X ∈ ℝ) : ℝ := complexIm(g(X))
requires values : ComplexValuedOn(g, ℝ)
proof
  have value := values with member
  exact complexIm.real with value

-- g is Riemann integrable on [A, B] when its real and imaginary parts are.
predicate ComplexRiemannIntegrable (g : Set, A B : Real) :=
  ComplexValuedOn(g, ℝ) ∧ RiemannIntegrable(complexFunctionRe(g), A, B) ∧
  RiemannIntegrable(complexFunctionIm(g), A, B)

-- ∫_A^B g = ∫_A^B re g + i ∫_A^B im g.
def complexIntegral (g : Set, A B : Real) : Set :=
  (riemannIntegral(complexFunctionRe(g), A, B),
    riemannIntegral(complexFunctionIm(g), A, B))

-- Section: Improper integrals
-- G : ℝ → ℝ has improper integral I over [A, ∞): G is Riemann integrable
-- on every [A, T], and ∫_A^T G → I as T → ∞.
predicate HasImproperIntegral (G : Set, A I : Real) :=
  FunctionBetween(G, ℝ, ℝ) ∧
  (∀ T ∈ ℝ, A ≤ T → RiemannIntegrable(G, A, T)) ∧
  (∀ e ∈ ℝ, R[0] < e → ∃ T₀ ∈ ℝ, ∀ T ∈ ℝ, T₀ ≤ T → A ≤ T →
    abs(R[riemannIntegral(G, A, T) - I]) < e)

predicate ImproperIntegrable (G : Set, A : Real) :=
  ∃ I ∈ ℝ, HasImproperIntegral(G, A, I)

-- The complex function g has improper integral I over [A, ∞).
predicate HasComplexImproperIntegral (g : Set, A : Real, I : Set) :=
  ComplexValuedOn(g, ℝ) ∧ I ∈ complexCarrier ∧
  (∀ T ∈ ℝ, A ≤ T → ComplexRiemannIntegrable(g, A, T)) ∧
  (∀ e ∈ ℝ, R[0] < e → ∃ T₀ ∈ ℝ, ∀ T ∈ ℝ, T₀ ≤ T → A ≤ T →
    complexAbs(ℂ[complexIntegral(g, A, T) - I]) < e)

predicate ComplexImproperIntegrable (g : Set, A : Real) :=
  ∃ I ∈ complexCarrier, HasComplexImproperIntegral(g, A, I)

-- Two reals with a common point within every e > 0 of both are equal.
theorem real.eq_of_common_near (I J : Real)
  requires near : ∀ e ∈ ℝ, R[0] < e → ∃ S ∈ ℝ,
    abs(R[S - I]) < e ∧ abs(R[S - J]) < e
  shows I = J
proof
  by_contra different
  have gap := dist.positive_of_ne with different
  have halfPositive := half.positive with gap
  have halfReal := half.real at dist(I, J)
  obtain ⟨S, sReal, nearI, nearJ⟩ := near with half(dist(I, J)), halfReal,
    halfPositive
  have triangle := dist.triangle at I, S, J
  have symmetric := dist.symmetric at I, S
  have halves := half.add_self at dist(I, J)
  have sameI : dist(S, I) = abs(R[S - I]) by unfold dist; unfold realSubValue; rfl
  have sameJ : dist(S, J) = abs(R[S - J]) by unfold dist; unfold realSubValue; rfl
  linarith

-- Any two reals have a common upper bound.
theorem real.exists_upper (X Y : Real)
  shows ∃ Z ∈ ℝ, X ≤ Z ∧ Y ≤ Z
proof
  have upperX := abs.upper at X
  have upperY := abs.upper at Y
  have nonnegativeX := abs.nonnegative at X
  have nonnegativeY := abs.nonnegative at Y
  witness R[abs(X) + abs(Y)]
  refine ⟨?_, ?_, ?_⟩
  . typecheck
  . linarith
  . linarith

theorem HasImproperIntegral.unique (G : Set) (A I J : Real)
  requires first : HasImproperIntegral(G, A, I)
  requires second : HasImproperIntegral(G, A, J)
  shows I = J
proof
  obtain ⟨_, _, limitI⟩ := first
  obtain ⟨_, _, limitJ⟩ := second
  apply real.eq_of_common_near
  intros e eReal ePositive
  obtain ⟨T1, t1Real, nearI⟩ := limitI with e, eReal, ePositive
  obtain ⟨T2, t2Real, nearJ⟩ := limitJ with e, eReal, ePositive
  obtain ⟨T3, t3Real, above1, above2⟩ := real.exists_upper at T1, T2
  obtain ⟨T, tReal, above3, aboveA⟩ := real.exists_upper at T3, A
  have later1 : T1 ≤ T by linarith
  have later2 : T2 ≤ T by linarith
  obtain ⟨member, _⟩ := riemannIntegral.selected at G, A, T
  witness riemannIntegral(G, A, T)
  refine ⟨member, ?_, ?_⟩
  . exact nearI with T, tReal, later1, aboveA
  . exact nearJ with T, tReal, later2, aboveA

theorem complexIntegral.member (g : Set) (A B : Real)
  shows complexIntegral(g, A, B) ∈ ℂ
proof
  obtain ⟨reMember, _⟩ := riemannIntegral.selected at complexFunctionRe(g), A, B
  obtain ⟨imMember, _⟩ := riemannIntegral.selected at complexFunctionIm(g), A, B
  have reReal : Real(riemannIntegral(complexFunctionRe(g), A, B))
    by exact reMember
  have imReal : Real(riemannIntegral(complexFunctionIm(g), A, B))
    by exact imMember
  unfold complexIntegral
  exact complexCarrier.pair with reReal, imReal

-- Two complex numbers with a common point within every e > 0 of both are
-- equal.
theorem complex.eq_of_common_near (I J : Set)
  requires memberI : I ∈ ℂ
  requires memberJ : J ∈ ℂ
  requires near : ∀ e ∈ ℝ, R[0] < e → ∃ S ∈ ℂ,
    complexAbs(ℂ[S - I]) < e ∧ complexAbs(ℂ[S - J]) < e
  shows I = J
proof
  by_contra different
  have differenceMember : ℂ[I - J] ∈ ℂ by typecheck
  have nonzero : ℂ[I - J] ≠ ℂ[0]
    intro zero
    apply different
    linear_combination zero
  have gap := complexAbs.positive with nonzero
  have gapReal : complexAbs(ℂ[I - J]) ∈ ℝ by typecheck
  have halfPositive := half.positive with gap
  have halfReal := half.real at complexAbs(ℂ[I - J])
  have halves := half.add_self at complexAbs(ℂ[I - J])
  obtain ⟨S, sMember, nearI, nearJ⟩ := near with half(complexAbs(ℂ[I - J])),
    halfReal, halfPositive
  have split : ℂ[I - J] = ℂ[(S - J) + -(S - I)] by ring
  have triangle := complexAbs.triangle at ℂ[S - J], ℂ[-(S - I)] with *
  have negated := complexAbs.neg at ℂ[S - I] with *
  have same : complexAbs(ℂ[I - J]) = complexAbs(ℂ[(S - J) + -(S - I)])
    by rw split
  linarith

theorem HasComplexImproperIntegral.unique (g : Set) (A : Real) (I J : Set)
  requires first : HasComplexImproperIntegral(g, A, I)
  requires second : HasComplexImproperIntegral(g, A, J)
  shows I = J
proof
  obtain ⟨_, memberI, _, limitI⟩ := first
  obtain ⟨_, memberJ, _, limitJ⟩ := second
  apply complex.eq_of_common_near with memberI, memberJ
  intros e eReal ePositive
  obtain ⟨T1, t1Real, nearI⟩ := limitI with e, eReal, ePositive
  obtain ⟨T2, t2Real, nearJ⟩ := limitJ with e, eReal, ePositive
  obtain ⟨T3, t3Real, above1, above2⟩ := real.exists_upper at T1, T2
  obtain ⟨T, tReal, above3, aboveA⟩ := real.exists_upper at T3, A
  have later1 : T1 ≤ T by linarith
  have later2 : T2 ≤ T by linarith
  have member := complexIntegral.member at g, A, T
  witness complexIntegral(g, A, T)
  refine ⟨member, ?_, ?_⟩
  . exact nearI with T, tReal, later1, aboveA
  . exact nearJ with T, tReal, later2, aboveA

-- ∫_A^∞ G: the limit when it exists, and 0 otherwise, as riemannIntegral
-- is 0 off the integrable functions; every theorem that reads the value
-- assumes it exists.
defunique improperIntegral (G : Set, A : Real) (I ∈ ℝ) :=
  (ImproperIntegrable(G, A) → HasImproperIntegral(G, A, I)) ∧
  (¬ImproperIntegrable(G, A) → I = R[0])
proof
  have alternatives : ImproperIntegrable(G, A) ∨ ¬ImproperIntegrable(G, A)
    by tauto
  cases alternatives with integrable | absent
  . obtain ⟨I, realI, integral⟩ := integrable
    witness I
    refine ⟨realI, ?_⟩
    constructor
    . intro again
      exact integral
    . intro impossible
      exfalso
      exact impossible with ⟨I, realI, integral⟩
  . witness realZero
    refine ⟨realZero.real, ?_⟩
    constructor
    . intro impossible
      exfalso
      exact absent with impossible
    . intro ignored
      rfl
uniqueness
  intros I memberI first J memberJ second
  have alternatives : ImproperIntegrable(G, A) ∨ ¬ImproperIntegrable(G, A)
    by tauto
  cases alternatives with integrable | absent
  . have firstIntegral : HasImproperIntegral(G, A, I) by tauto
    have secondIntegral : HasImproperIntegral(G, A, J) by tauto
    exact HasImproperIntegral.unique with firstIntegral, secondIntegral
  . have firstZero : I = realZero by tauto
    have secondZero : J = realZero by tauto
    cc

-- ∫_A^∞ g for a complex function g, likewise.
defunique complexImproperIntegral (g : Set, A : Real) (I ∈ complexCarrier) :=
  (ComplexImproperIntegrable(g, A) → HasComplexImproperIntegral(g, A, I)) ∧
  (¬ComplexImproperIntegrable(g, A) → I = ℂ[0])
proof
  have alternatives :
    ComplexImproperIntegrable(g, A) ∨ ¬ComplexImproperIntegrable(g, A)
    by tauto
  cases alternatives with integrable | absent
  . obtain ⟨I, memberI, integral⟩ := integrable
    witness I
    refine ⟨memberI, ?_⟩
    constructor
    . intro again
      exact integral
    . intro impossible
      exfalso
      exact impossible with ⟨I, memberI, integral⟩
  . witness complexZero
    refine ⟨complexZero.member, ?_⟩
    constructor
    . intro impossible
      exfalso
      exact absent with impossible
    . intro ignored
      rfl
uniqueness
  intros I memberI first J memberJ second
  have alternatives :
    ComplexImproperIntegrable(g, A) ∨ ¬ComplexImproperIntegrable(g, A)
    by tauto
  cases alternatives with integrable | absent
  . have firstIntegral : HasComplexImproperIntegral(g, A, I) by tauto
    have secondIntegral : HasComplexImproperIntegral(g, A, J) by tauto
    exact HasComplexImproperIntegral.unique with firstIntegral, secondIntegral
  . have firstZero : I = complexZero by tauto
    have secondZero : J = complexZero by tauto
    cc

-- The power x ↦ x^σ as a function ℝ → ℝ (its values at x ≤ 0 are those of
-- realRpow there, and no theorem reads them).
defgraph rpowFunction (S : Real) (X ∈ ℝ) : ℝ := realRpow(X, S)
proof
  exact realRpow.real

-- Section: Integrals of complex functions over [A, B]
theorem complexFunctionRe.apply (g : Set) (X : Real)
  requires values : ComplexValuedOn(g, ℝ)
  shows complexFunctionRe(g)(X) = complexRe(g(X))
proof
  have xReal : X ∈ ℝ by typecheck
  exact complexFunctionRe.value at g, X with values

theorem complexFunctionIm.apply (g : Set) (X : Real)
  requires values : ComplexValuedOn(g, ℝ)
  shows complexFunctionIm(g)(X) = complexIm(g(X))
proof
  have xReal : X ∈ ℝ by typecheck
  exact complexFunctionIm.value at g, X with values

theorem complexIntegral.re (g : Set) (A B : Real)
  shows complexRe(complexIntegral(g, A, B)) =
    riemannIntegral(complexFunctionRe(g), A, B)
proof
  unfold complexIntegral
  unfold complexRe
  rw fst.pair

theorem complexIntegral.im (g : Set) (A B : Real)
  shows complexIm(complexIntegral(g, A, B)) =
    riemannIntegral(complexFunctionIm(g), A, B)
proof
  unfold complexIntegral
  unfold complexIm
  rw snd.pair

-- A continuous complex function is integrable on every [A, B].
theorem ComplexRiemannIntegrable.of_continuous (g : Set) (A B : Real)
  requires values : ComplexValuedOn(g, ℝ)
  requires ordered : A ≤ B
  requires continuousRe : ContinuousOn(complexFunctionRe(g),
    closedInterval(A, B))
  requires continuousIm : ContinuousOn(complexFunctionIm(g),
    closedInterval(A, B))
  shows ComplexRiemannIntegrable(g, A, B)
proof
  refine ⟨values, ?_, ?_⟩
  . exact ContinuousOn.integrable_interval with ordered, continuousRe
  . exact ContinuousOn.integrable_interval with ordered, continuousIm

-- Over a reversed interval nothing is integrable, and the integral is 0.
theorem riemannIntegral.reversed (f : Set) (A B : Real)
  requires reversed : ¬A ≤ B
  shows ¬RiemannIntegrable(f, A, B) ∧ riemannIntegral(f, A, B) = R[0]
proof
  have absent : ¬RiemannIntegrable(f, A, B)
    intro integrable
    obtain ⟨I, _, _, ordered, _⟩ := integrable
    exact reversed with ordered
  obtain ⟨_, _, zero⟩ := riemannIntegral.selected at f, A, B
  refine ⟨absent, ?_⟩
  exact zero with absent

-- The integral of the zero function is 0 over every interval.
theorem riemannIntegral.zero_function (A B : Real)
  shows riemannIntegral(constantRealFunction(R[0]), A, B) = R[0]
proof
  by_cases ordered : A ≤ B
  . rw riemannIntegral.constant with ordered
    ring
  . obtain ⟨_, zero⟩ := riemannIntegral.reversed at
      constantRealFunction(R[0]), A, B with ordered
    exact zero

-- The integral of a real function, seen in ℂ.
theorem complexIntegral.of_real (g G : Set) (A B : Real)
  requires values : ComplexValuedOn(g, ℝ)
  requires function : FunctionBetween(G, ℝ, ℝ)
  requires real : ∀ X ∈ ℝ, g(X) = complexOfReal(G(X))
  shows complexIntegral(g, A, B) = complexOfReal(riemannIntegral(G, A, B))
proof
  have functionRe := complexFunctionRe.function with values
  have functionIm := complexFunctionIm.function with values
  have zeroFunction := constantRealFunction.function at R[0]
  have reParts : complexFunctionRe(g) = G
    apply FunctionBetween.ext with functionRe, function
    intros X xMember
    have xReal : Real(X) by exact xMember
    have valueG := FunctionBetween.apply_closed with function, xMember
    have gReal : Real(G(X)) by exact valueG
    have valueX := real with X, xMember
    rw [(complexFunctionRe.apply with values), valueX, complexOfReal.re]
  have imParts : complexFunctionIm(g) = constantRealFunction(R[0])
    apply FunctionBetween.ext with functionIm, zeroFunction
    intros X xMember
    have valueG := FunctionBetween.apply_closed with function, xMember
    have valueX := real with X, xMember
    rw [(complexFunctionIm.apply with values), valueX, complexOfReal.im,
      constantRealFunction.value]
  obtain ⟨member, _⟩ := riemannIntegral.selected at G, A, B
  unfold complexIntegral
  rw [reParts, imParts, riemannIntegral.zero_function,
    complexOfReal.value with member]

-- Section: Linearity of the Riemann integral
-- A finite sum of a w with w = a u + b v termwise is a Σu + b Σv.
theorem realPartialSum.linear (u v w : Set, a b : Real, n : Nat)
  requires sequenceU : RealSequence(u)
  requires sequenceV : RealSequence(v)
  requires sequenceW : RealSequence(w)
  requires terms : ∀ k ∈ ℕ, w[k] = R[a * u[k] + b * v[k]]
  shows ∑ i < n, w(i) = R[a * (∑ i < n, u(i)) + b * (∑ i < n, v(i))]
proof
  induction n
  | zero =>
    rw [realPartialSum.zero, realPartialSum.zero, realPartialSum.zero]
    ring
  | succ(k) using ih =>
    have valueU := RealSequence.value with sequenceU
    have valueV := RealSequence.value with sequenceV
    have sumU := realPartialSum.real at u, k with sequenceU
    have sumV := realPartialSum.real at v, k with sequenceV
    have naturalK := nat.omega.forward at k with assumption
    have term := terms with k, naturalK
    rw [realPartialSum.succ, realPartialSum.succ, realPartialSum.succ, ih,
      term]
    ring

-- The product realMulValue is the ring product.
theorem realMulValue.eq_mul (A B : Real)
  shows realMulValue(A, B) = R[A * B]
proof
  unfold realMulValue
  unfold call2
  rfl

-- Tagged sums are linear in the function.
theorem riemannSum.linear (h f g p t : Set) (a b : Real, N : Nat)
  requires functionH : h : ℝ → ℝ
  requires functionF : f : ℝ → ℝ
  requires functionG : g : ℝ → ℝ
  requires points : RealSequence(p)
  requires tags : RealSequence(t)
  requires values : ∀ X ∈ ℝ, h(X) = R[a * f(X) + b * g(X)]
  shows riemannSum(h, p, t, N) =
    R[a * riemannSum(f, p, t, N) + b * riemannSum(g, p, t, N)]
proof
  have sequenceH : RealSequence(riemannTerms(h, p, t))
    unfold RealSequence
    exact riemannTerms.function with functionH, points, tags
  have sequenceF : RealSequence(riemannTerms(f, p, t))
    unfold RealSequence
    exact riemannTerms.function with functionF, points, tags
  have sequenceG : RealSequence(riemannTerms(g, p, t))
    unfold RealSequence
    exact riemannTerms.function with functionG, points, tags
  have terms : ∀ k ∈ ℕ, riemannTerms(h, p, t)[k] =
      R[a * riemannTerms(f, p, t)[k] + b * riemannTerms(g, p, t)[k]]
    intros k naturalK
    have typedK := nat.omega.backward with naturalK
    have tagReal := RealSequence.value at t, k with tags
    have tagMember : t[k] ∈ ℝ by exact tagReal
    have realF := FunctionBetween.apply_closed with functionF, tagMember
    have realG := FunctionBetween.apply_closed with functionG, tagMember
    have typedF : Real(f(t[k])) by exact realF
    have typedG : Real(g(t[k])) by exact realG
    have pointK := RealSequence.value at p, k with points
    have pointNext := RealSequence.value at p, succ(k) with points
    have valueH := values with t[k], tagMember
    have termH := riemannTerms.value at h, p, t, k with functionH, points, tags
    have termF := riemannTerms.value at f, p, t, k with functionF, points, tags
    have termG := riemannTerms.value at g, p, t, k with functionG, points, tags
    rw [termH, termF, termG, valueH, realMulValue.eq_mul, realMulValue.eq_mul,
      realMulValue.eq_mul]
    ring
  unfold riemannSum
  exact realPartialSum.linear with sequenceF, sequenceG, sequenceH, terms

-- |a x + b y| ≤ (|a| + |b|) r when |x|, |y| ≤ r.
theorem abs.linear_le (a b x y r : Real)
  requires smallX : abs(x) ≤ r
  requires smallY : abs(y) ≤ r
  shows abs(R[a * x + b * y]) ≤ R[(abs(a) + abs(b)) * r]
proof
  have triangle := abs.triangle at R[a * x], R[b * y]
  have productX := abs.mul at a, x
  have productY := abs.mul at b, y
  have nonnegativeA := abs.nonnegative at a
  have nonnegativeB := abs.nonnegative at b
  have boundX := realLe.mul_left_of_nonnegative with smallX, nonnegativeA
  have boundY := realLe.mul_left_of_nonnegative with smallY, nonnegativeB
  have expand : R[(abs(a) + abs(b)) * r] = R[abs(a) * r + abs(b) * r]
    by ring
  linarith

-- If f, g have integrals I, J and h = a f + b g, then h has integral
-- a I + b J.
theorem HasRiemannIntegral.linear (h f g : Set) (A B I J a b : Real)
  requires integralF : HasRiemannIntegral(f, A, B, I)
  requires integralG : HasRiemannIntegral(g, A, B, J)
  requires functionH : h : ℝ → ℝ
  requires values : ∀ X ∈ ℝ, h(X) = R[a * f(X) + b * g(X)]
  shows HasRiemannIntegral(h, A, B, R[a * I + b * J])
proof
  obtain ⟨functionF, ordered, controlF⟩ := integralF
  obtain ⟨functionG, _, controlG⟩ := integralG
  refine ⟨functionH, ordered, ?_⟩
  intros E eMember positive
  have eReal : Real(E) by exact eMember
  have nonnegativeA := abs.nonnegative at a
  have nonnegativeB := abs.nonnegative at b
  have scalePositive : R[0] < R[abs(a) + abs(b) + 1] by linarith
  have radiusReal := scaledRadius.real at E, R[abs(a) + abs(b) + 1]
  have radiusMember : scaledRadius(E, R[abs(a) + abs(b) + 1]) ∈ ℝ
    by exact radiusReal
  have radiusPositive := scaledRadius.positive with positive, scalePositive
  have cancel := scaledRadius.cancel at E, R[abs(a) + abs(b) + 1]
    with scalePositive
  have halfLess := half.lt_self with positive
  obtain ⟨D1, d1Member, d1Positive, estimateF⟩ := controlF with
    scaledRadius(E, R[abs(a) + abs(b) + 1]), radiusMember, radiusPositive
  obtain ⟨D2, d2Member, d2Positive, estimateG⟩ := controlG with
    scaledRadius(E, R[abs(a) + abs(b) + 1]), radiusMember, radiusPositive
  have d1Real : Real(D1) by exact d1Member
  have d2Real : Real(D2) by exact d2Member
  obtain ⟨D, dMember, dPositive, dD1, dD2⟩ := positiveRadius.common
    with d1Positive, d2Positive
  refine ⟨D, dMember, dPositive, ?_⟩
  intros p t N nMember tagged fine
  have fine1 := FinePartition.weaken with fine, dD1
  have fine2 := FinePartition.weaken with fine, dD2
  have nearF := estimateF with p, t, N, nMember, tagged, fine1
  have nearG := estimateG with p, t, N, nMember, tagged, fine2
  obtain ⟨⟨points, _, _, _⟩, tags, _⟩ := tagged
  have sumH := riemannSum.linear at h, f, g, p, t, a, b, N with functionH,
    functionF, functionG, points, tags, values
  have sumF := riemannSum.real at f, p, t, N with functionF, points, tags
  have sumG := riemannSum.real at g, p, t, N with functionG, points, tags
  have smallF : abs(R[riemannSum(f, p, t, N) - I]) ≤
      scaledRadius(E, R[abs(a) + abs(b) + 1])
    unfold dist at nearF
    unfold realSubValue at nearF
    exact realLess.implies_le with nearF
  have smallG : abs(R[riemannSum(g, p, t, N) - J]) ≤
      scaledRadius(E, R[abs(a) + abs(b) + 1])
    unfold dist at nearG
    unfold realSubValue at nearG
    exact realLess.implies_le with nearG
  have combined := abs.linear_le at a, b,
    R[riemannSum(f, p, t, N) - I], R[riemannSum(g, p, t, N) - J],
    scaledRadius(E, R[abs(a) + abs(b) + 1]) with smallF, smallG
  have shape : R[riemannSum(h, p, t, N) - (a * I + b * J)] =
      R[a * (riemannSum(f, p, t, N) - I) + b * (riemannSum(g, p, t, N) - J)]
    rw sumH
    ring
  have expand : R[(abs(a) + abs(b) + 1) *
      scaledRadius(E, R[abs(a) + abs(b) + 1])] =
    R[(abs(a) + abs(b)) * scaledRadius(E, R[abs(a) + abs(b) + 1]) +
      scaledRadius(E, R[abs(a) + abs(b) + 1])] by ring
  unfold dist
  unfold realSubValue
  rw shape
  linarith

-- The integral of a f + b g is a ∫ f + b ∫ g for integrable f, g.
theorem riemannIntegral.linear (h f g : Set) (A B a b : Real)
  requires integrableF : RiemannIntegrable(f, A, B)
  requires integrableG : RiemannIntegrable(g, A, B)
  requires functionH : h : ℝ → ℝ
  requires values : ∀ X ∈ ℝ, h(X) = R[a * f(X) + b * g(X)]
  shows RiemannIntegrable(h, A, B) ∧ riemannIntegral(h, A, B) =
    R[a * riemannIntegral(f, A, B) + b * riemannIntegral(g, A, B)]
proof
  have integralF := riemannIntegral.integral with integrableF
  have integralG := riemannIntegral.integral with integrableG
  have integralH := HasRiemannIntegral.linear with integralF, integralG,
    functionH, values
  have value := riemannIntegral.eq_of_integral with integralH
  refine ⟨?_, value⟩
  have member : R[a * riemannIntegral(f, A, B) + b * riemannIntegral(g, A, B)]
    ∈ ℝ by typecheck
  exact ⟨R[a * riemannIntegral(f, A, B) + b * riemannIntegral(g, A, B)],
    member, integralH⟩

-- Integrals are monotone: f ≤ g on [A, B] gives ∫ f ≤ ∫ g.
theorem HasRiemannIntegral.mono (f g : Set) (A B I J : Real)
  requires integralF : HasRiemannIntegral(f, A, B, I)
  requires integralG : HasRiemannIntegral(g, A, B, J)
  requires bound : ∀ X ∈ closedInterval(A, B), f(X) ≤ g(X)
  shows I ≤ J
proof
  obtain below | same | above := realLess.trichotomy at J, I
  . exfalso
    obtain ⟨functionF, ordered, controlF⟩ := integralF
    obtain ⟨functionG, _, controlG⟩ := integralG
    have gap : R[0] < R[I - J] by linarith
    have halfPositive := half.positive with gap
    have halfReal := half.real at R[I - J]
    have halfMember : half(R[I - J]) ∈ ℝ by exact halfReal
    have halves := half.add_self at R[I - J]
    obtain ⟨D1, d1Member, d1Positive, estimateF⟩ := controlF with
      half(R[I - J]), halfMember, halfPositive
    obtain ⟨D2, d2Member, d2Positive, estimateG⟩ := controlG with
      half(R[I - J]), halfMember, halfPositive
    obtain ⟨D, dMember, dPositive, dD1, dD2⟩ := positiveRadius.common
      with d1Positive, d2Positive
    have cofinal := FineTaggedPartitionsExist.ordered_interval with ordered
    obtain ⟨p, t, N, nMember, tagged, fine⟩ := cofinal with D, dMember,
      dPositive
    have typedN := nat.omega.backward with nMember
    have fine1 := FinePartition.weaken with fine, dD1
    have fine2 := FinePartition.weaken with fine, dD2
    have nearF := estimateF with p, t, N, nMember, tagged, fine1
    have nearG := estimateG with p, t, N, nMember, tagged, fine2
    have tagBounds : ∀ i ∈ ℕ, i < N → (f(t[i]):R) ≤ (g(t[i]):R)
      intros i naturalI before
      have typedI := nat.omega.backward with naturalI
      have cell := TaggedPartition.cell with tagged, before
      obtain ⟨partition, _, _⟩ := tagged
      have inside := IntervalPartition.cell_subset with partition, before
      exact bound with t[i], (inside with cell)
    have compared := riemannSum.monotone_on_tags with functionF, functionG,
      tagged, tagBounds
    obtain ⟨⟨points, _, _, _⟩, tags, _⟩ := tagged
    have sumF := riemannSum.real with functionF, points, tags
    have sumG := riemannSum.real with functionG, points, tags
    unfold dist at nearF
    unfold dist at nearG
    unfold realSubValue at nearF
    unfold realSubValue at nearG
    have upperF := abs.upper_neg at R[riemannSum(f, p, t, N) - I]
    have upperG := abs.upper at R[riemannSum(g, p, t, N) - J]
    linarith
  . rw same
    exact realLe.reflexive with *
  . exact realLess.implies_le with above

theorem HasRiemannIntegral.function (f : Set) (A B I : Real)
  requires integral : HasRiemannIntegral(f, A, B, I)
  shows f : ℝ → ℝ
proof
  obtain ⟨function, _, _⟩ := integral
  exact function

-- The function x ↦ a f(x) + b g(x).
defgraph realLinearCombination (a b : Real, f g : Set) (X ∈ ℝ) : ℝ :=
    R[a * f(X) + b * g(X)]
requires functionF : f : ℝ → ℝ
requires functionG : g : ℝ → ℝ
proof
  have valueF := FunctionBetween.apply_closed with functionF, member
  have valueG := FunctionBetween.apply_closed with functionG, member
  typecheck

-- A complex number is determined by its real and imaginary parts.
theorem complex.eq_of_parts (z w : Set)
  requires hz : z ∈ ℂ
  requires hw : w ∈ ℂ
  requires re : complexRe(z) = complexRe(w)
  requires im : complexIm(z) = complexIm(w)
  shows z = w
proof
  have expandZ := complex.ext with hz
  have expandW := complex.ext with hw
  cc [expandZ, expandW, re, im]

-- |∫_A^B g| ≤ ∫_A^B G when |g| ≤ G on [A, B].
theorem complexIntegral.abs_le (g G : Set) (A B : Real)
  requires ordered : A ≤ B
  requires integrable : ComplexRiemannIntegrable(g, A, B)
  requires integrableG : RiemannIntegrable(G, A, B)
  requires bound : ∀ X ∈ closedInterval(A, B), complexAbs(g(X)) ≤ G(X)
  shows complexAbs(complexIntegral(g, A, B)) ≤ riemannIntegral(G, A, B)
proof
  obtain ⟨values, integrableRe, integrableIm⟩ := integrable
  obtain ⟨I, iMember, integralG⟩ := integrableG
  have iReal : Real(I) by exact iMember
  have functionG := HasRiemannIntegral.function with integralG
  rw riemannIntegral.eq_of_integral with integralG
  have functionRe := complexFunctionRe.function with values
  have functionIm := complexFunctionIm.function with values
  have member := complexIntegral.member at g, A, B
  have reReal := complexRe.real with member
  have imReal := complexIm.real with member
  have absReal : complexAbs(complexIntegral(g, A, B)) ∈ ℝ by typecheck
  have absNonnegative := complexAbs.nonnegative with member
  -- |g(x)| ≥ 0, so ∫ G ≥ 0.
  have zeroFunction := realLinearCombination.function at R[0], R[0], G, G
    with functionG, functionG
  have zeroValues : ∀ X ∈ ℝ, realLinearCombination(R[0], R[0], G, G)(X) =
      R[0 * G(X) + 0 * G(X)]
    intros X xMember
    exact realLinearCombination.value with functionG, functionG, xMember
  have zeroIntegral := HasRiemannIntegral.linear with integralG, integralG,
    zeroFunction, zeroValues
  have nonnegative : R[0] ≤ I
    have zeroBelow : ∀ X ∈ closedInterval(A, B),
        realLinearCombination(R[0], R[0], G, G)(X) ≤ G(X)
      intros X inside
      obtain ⟨xMember, _, _⟩ := closedInterval.membership.forward with inside
      have gX := values with X, xMember
      have valueG := FunctionBetween.apply_closed with functionG, xMember
      have gReal : Real(G(X)) by exact valueG
      have absNonnegativeX := complexAbs.nonnegative with gX
      have below := bound with X, inside
      have absX : complexAbs(g(X)) ∈ ℝ by typecheck
      have zeroed : R[0 * G(X) + 0 * G(X)] = R[0] by ring
      rw zeroValues with X, xMember
      linarith
    have compared := HasRiemannIntegral.mono with zeroIntegral, integralG,
      zeroBelow
    have same : R[0 * I + 0 * I] = R[0] by ring
    linarith
  -- With P + iQ = ∫ g: P re g + Q im g ≤ |∫ g| G, integrated.
  have combination := realLinearCombination.function at
    complexRe(complexIntegral(g, A, B)), complexIm(complexIntegral(g, A, B)),
    complexFunctionRe(g), complexFunctionIm(g) with functionRe, functionIm
  have scaled := realLinearCombination.function at
    complexAbs(complexIntegral(g, A, B)), R[0], G, G with functionG, functionG
  have values1 : ∀ X ∈ ℝ, realLinearCombination(
      complexRe(complexIntegral(g, A, B)), complexIm(complexIntegral(g, A, B)),
      complexFunctionRe(g), complexFunctionIm(g))(X) =
      R[complexRe(complexIntegral(g, A, B)) * complexFunctionRe(g)(X) +
        complexIm(complexIntegral(g, A, B)) * complexFunctionIm(g)(X)]
    intros X xMember
    exact realLinearCombination.value with functionRe, functionIm, xMember
  have values2 : ∀ X ∈ ℝ, realLinearCombination(
      complexAbs(complexIntegral(g, A, B)), R[0], G, G)(X) =
      R[complexAbs(complexIntegral(g, A, B)) * G(X) + 0 * G(X)]
    intros X xMember
    exact realLinearCombination.value with functionG, functionG, xMember
  have integralRe := riemannIntegral.integral with integrableRe
  have integralIm := riemannIntegral.integral with integrableIm
  have integral1 := HasRiemannIntegral.linear with integralRe, integralIm,
    combination, values1
  have integral2 := HasRiemannIntegral.linear with integralG, integralG,
    scaled, values2
  have pointwise : ∀ X ∈ closedInterval(A, B),
      realLinearCombination(complexRe(complexIntegral(g, A, B)),
        complexIm(complexIntegral(g, A, B)), complexFunctionRe(g),
        complexFunctionIm(g))(X) ≤
      realLinearCombination(complexAbs(complexIntegral(g, A, B)), R[0], G,
        G)(X)
    intros X inside
    obtain ⟨xMember, _, _⟩ := closedInterval.membership.forward with inside
    have gX := values with X, xMember
    have valueG := FunctionBetween.apply_closed with functionG, xMember
    have conjMember : complexConj(complexIntegral(g, A, B)) ∈ ℂ by typecheck
    have productMember :
      ℂ[complexConj(complexIntegral(g, A, B)) * g(X)] ∈ ℂ by typecheck
    have absProductReal :
      complexAbs(ℂ[complexConj(complexIntegral(g, A, B)) * g(X)]) ∈ ℝ
      by typecheck
    have reProduct := complexRe.mul with conjMember, gX
    have reLe := complexAbs.re_le with productMember
    have reUpper := abs.upper at
      complexRe(ℂ[complexConj(complexIntegral(g, A, B)) * g(X)])
    have absProduct := complexAbs.mul with conjMember, gX
    have below := bound with X, inside
    have scaledBound := realLe.mul_left_of_nonnegative with below,
      absNonnegative
    rw [(values1 with X, xMember), (values2 with X, xMember),
      (complexFunctionRe.apply with values), (complexFunctionIm.apply with values)]
    rw [complexConj.re, complexConj.im] at reProduct
    rw complexAbs.conj at absProduct
    have zeroed : R[0 * G(X)] = R[0] by ring
    have shape : R[complexRe(complexIntegral(g, A, B)) * complexRe(g(X)) +
        complexIm(complexIntegral(g, A, B)) * complexIm(g(X))] =
      R[complexRe(complexIntegral(g, A, B)) * complexRe(g(X)) -
        -complexIm(complexIntegral(g, A, B)) * complexIm(g(X))] by ring
    linarith
  have compared := HasRiemannIntegral.mono with integral1, integral2, pointwise
  rw [← complexIntegral.re, ← complexIntegral.im] at compared
  have square := complexAbs.square with member
  have parts := complexNormSquared.parts with member
  have squareBound : R[complexAbs(complexIntegral(g, A, B)) *
      complexAbs(complexIntegral(g, A, B))] ≤
      R[I * complexAbs(complexIntegral(g, A, B))]
    have zeroed : R[0 * I] = R[0] by ring
    have commuted : R[complexAbs(complexIntegral(g, A, B)) * I] =
      R[I * complexAbs(complexIntegral(g, A, B))] by ring
    linarith
  obtain positive | zero | negative := realLess.trichotomy at R[0], complexAbs(complexIntegral(g, A, B))
  . exact realLe.mul_right_cancel_positive with positive, squareBound
  . rw ← zero
    exact nonnegative
  . exfalso
    linarith

-- Section: Completeness and the Cauchy criterion
-- The first N terms of a real sequence are bounded.
theorem RealSequence.prefix_bounded (u : Set, N : Nat)
  requires sequence : RealSequence(u)
  shows ∃ M ∈ ℝ, R[0] ≤ M ∧ (∀ n ∈ ℕ, n < N → abs(u[n]) ≤ M)
proof
  induction N
  | zero =>
    witness R[0]
    refine ⟨realZero.real, ?_, ?_⟩
    . exact realLe.reflexive with realZero.real
    . intros n naturalN below
      exfalso
      have typed := nat.omega.backward with naturalN
      arith
  | k + 1 using ih =>
    obtain ⟨M, mMember, mNonnegative, bound⟩ := ih
    have mReal : Real(M) by exact mMember
    have uk := RealSequence.value with sequence
    have absNonnegative := abs.nonnegative at u[k]
    witness R[M + abs(u[k])]
    refine ⟨?_, ?_, ?_⟩
    . typecheck
    . linarith
    . intros n naturalN below
      have typed := nat.omega.backward with naturalN
      have un := RealSequence.value at u, n with sequence
      by_cases earlier : n < k
      . have old := bound with n, naturalN, earlier
        linarith
      . have same : n = k by arith
        rw same
        linarith

-- A Cauchy sequence of reals converges.
theorem CauchySequence.converges (u : Set)
  requires cauchy : CauchySequence(u)
  shows ∃ L ∈ ℝ, ConvergesTo(u, L)
proof
  have parts : RealSequence(u) ∧ (∀ E ∈ ℝ, 0 < E → ∃ N ∈ ℕ, ∀ m ∈ ℕ, N ≤ m →
      ∀ n ∈ ℕ, N ≤ n → uₘ ∈ openBall(uₙ, E)) by exact cauchy
  obtain ⟨sequence, control⟩ := parts
  have onePositive : R[0] < R[1] by linarith
  have oneMember : R[1] ∈ ℝ by typecheck
  obtain ⟨N, nMember, close⟩ := control with R[1], onePositive
  have typedN := nat.omega.backward with nMember
  obtain ⟨M, mMember, mNonnegative, bound⟩ := RealSequence.prefix_bounded with sequence
  have mReal : Real(M) by exact mMember
  have uN := RealSequence.value with sequence
  have absN := abs.nonnegative at u[N]
  have everywhere : ∀ n ∈ ℕ, abs(u[n]) ≤ R[M + abs(u[N]) + 1]
    intros n naturalN
    have typed := nat.omega.backward with naturalN
    have un := RealSequence.value at u, n with sequence
    by_cases earlier : n < N
    . have old := bound with n, naturalN, earlier
      linarith
    . have later : N ≤ n by arith
      have reflexive : N ≤ N by arith
      have ball := close with n, naturalN, later, N, nMember, reflexive
      obtain ⟨_, near⟩ := openBall.membership.forward with ball
      have triangle := abs.le_dist_add_abs at u[n], u[N]
      linarith
  have terms : TermsIn(u, closedInterval(R[-(M + abs(u[N]) + 1)],
      R[M + abs(u[N]) + 1]))
    intros n naturalN
    have typed := nat.omega.backward with naturalN
    have un := RealSequence.value at u, n with sequence
    have unMember : u[n] ∈ ℝ by exact un
    have bounded := everywhere with n, naturalN
    have upper := abs.upper at u[n]
    have lower := abs.upper_neg at u[n]
    have lowerBound : R[-(M + abs(u[N]) + 1)] ≤ u[n] by linarith
    have upperBound : u[n] ≤ R[M + abs(u[N]) + 1] by linarith
    exact closedInterval.membership.backward with
      ⟨unMember, lowerBound, upperBound⟩
  obtain ⟨L, inside, converges⟩ := CauchySequence.converges_in_interval with
    cauchy, terms
  obtain ⟨lMember, _, _⟩ := closedInterval.membership.forward with inside
  exact ⟨L, lMember, converges⟩

-- The Cauchy criterion: f is integrable on [A, B] when the tagged sums of
-- any two δ-fine tagged partitions are close for δ small.
predicate FineSumsCauchy (f : Set) (A B : Real) :=
  ∀ E ∈ ℝ, R[0] < E → ∃ D ∈ ℝ, R[0] < D ∧
    (∀ p, ∀ t, ∀ N ∈ ℕ, ∀ q, ∀ s, ∀ M ∈ ℕ,
      TaggedPartition(p, t, A, B, N) → FinePartition(p, A, B, N, D) →
        TaggedPartition(q, s, A, B, M) → FinePartition(q, A, B, M, D) →
          dist(riemannSum(f, p, t, N), riemannSum(f, q, s, M)) < E)

theorem FineSumsCauchy.dyadic_cauchy (f : Set) (A B : Real)
  requires function : f : ℝ → ℝ
  requires ordered : A < B
  requires cauchy : FineSumsCauchy(f, A, B)
  shows CauchySequence(dyadicRiemannSums(f, A, B))
proof
  constructor
  . exact dyadicRiemannSums.sequence with function
  . intros E realE positiveE
    obtain ⟨D, realD, positiveD, close⟩ := cauchy with E, realE, positiveE
    obtain ⟨K, naturalK, eventually⟩ :=
      dyadicRadius.eventually_scaled_below at realSubValue(B, A), D with positiveD
    witness K
    constructor
    . exact naturalK
    . intros m naturalM afterM n naturalN afterN
      have typedM := nat.omega.backward with naturalM
      have typedN := nat.omega.backward with naturalN
      have gridM := dyadicRiemannSums.fine_grid at A, B, m with ordered
      have gridN := dyadicRiemannSums.fine_grid at A, B, n with ordered
      rcases gridM with ⟨taggedM, fineM⟩
      rcases gridN with ⟨taggedN, fineN⟩
      have smallM := eventually with m, naturalM, afterM
      have smallN := eventually with n, naturalN, afterN
      have weakM := realLess.implies_le with smallM
      have weakN := realLess.implies_le with smallN
      have relaxedM := FinePartition.weaken with fineM, weakM
      have relaxedN := FinePartition.weaken with fineN, weakN
      have countM := dyadicCellCount.nat at succ(m) with
        Naturals.constructor.succ at m with assumption
      have countN := dyadicCellCount.nat at succ(n) with
        Naturals.constructor.succ at n with assumption
      have near := close with
        affinePoints(A, realSubValue(B, A) * dyadicRadius(succ(m))),
        leftPartitionTags(affinePoints(A, realSubValue(B, A) * dyadicRadius(succ(m)))),
        dyadicCellCount(succ(m)),
        nat.omega.forward at dyadicCellCount(succ(m)) with countM,
        affinePoints(A, realSubValue(B, A) * dyadicRadius(succ(n))),
        leftPartitionTags(affinePoints(A, realSubValue(B, A) * dyadicRadius(succ(n)))),
        dyadicCellCount(succ(n)),
        nat.omega.forward at dyadicCellCount(succ(n)) with countN,
        taggedM, relaxedM, taggedN, relaxedN
      have valueM := dyadicRiemannSums.value at f, A, B, m with function
      have valueN := dyadicRiemannSums.value at f, A, B, n with function
      have sequence := dyadicRiemannSums.sequence at f, A, B with function
      have realM := RealSequence.value at dyadicRiemannSums(f, A, B), m with
        sequence
      rw valueM at realM
      rw [valueM, valueN]
      exact openBall.membership.backward with ⟨realM, near⟩

theorem FineSumsCauchy.integrable (f : Set) (A B : Real)
  requires function : f : ℝ → ℝ
  requires ordered : A ≤ B
  requires cauchy : FineSumsCauchy(f, A, B)
  shows RiemannIntegrable(f, A, B)
proof
  obtain strict | equal | reversed := realLess.trichotomy at A, B
  . have dyadic := FineSumsCauchy.dyadic_cauchy with function, strict, cauchy
    obtain ⟨I, realI, limit⟩ := CauchySequence.converges with dyadic
    have typedI : Real(I) by exact realI
    refine ⟨I, realI, function, ordered, ?_⟩
    intros E realE positiveE
    have typedE : Real(E) by exact realE
    have halfReal := half.real with typedE
    have halfMember : half(E) ∈ ℝ by exact halfReal
    have halfPositive := half.positive with positiveE
    obtain ⟨D, realD, positiveD, close⟩ := cauchy with half(E), halfMember,
      halfPositive
    refine ⟨D, realD, positiveD, ?_⟩
    intros p t N naturalN tagged fine
    have typedN := nat.omega.backward with naturalN
    obtain ⟨K, naturalK, fineEventually⟩ :=
      dyadicRadius.eventually_scaled_below at realSubValue(B, A), D with positiveD
    obtain ⟨H, naturalH, nearEventually⟩ := ConvergesTo.eventually with
      limit, halfPositive
    have typedK := nat.omega.backward with naturalK
    have typedH := nat.omega.backward with naturalH
    obtain ⟨J, naturalJ, afterK, afterH⟩ := nat.common_upper at K, H with *{2}
    have typedJ := nat.omega.backward with naturalJ
    obtain ⟨taggedJ, fineJ⟩ := dyadicRiemannSums.fine_grid at A, B, J with
      strict
    have small := fineEventually with J, naturalJ, afterK
    have weak := realLess.implies_le with small
    have relaxed := FinePartition.weaken with fineJ, weak
    have count := dyadicCellCount.nat at succ(J) with
      Naturals.constructor.succ at J with assumption
    have near := close with p, t, N, naturalN,
      affinePoints(A, realSubValue(B, A) * dyadicRadius(succ(J))),
      leftPartitionTags(affinePoints(A, realSubValue(B, A) * dyadicRadius(succ(J)))),
      dyadicCellCount(succ(J)),
      nat.omega.forward at dyadicCellCount(succ(J)) with count,
      tagged, fine, taggedJ, relaxed
    have value := dyadicRiemannSums.value at f, A, B, J with function
    rw ← value at near
    have tail := nearEventually with J, naturalJ, afterH
    obtain ⟨⟨points, _, _, _⟩, tags, _⟩ := tagged
    have sumReal := riemannSum.real at f, p, t, N with function, points, tags
    have sequence := dyadicRiemannSums.sequence at f, A, B with function
    have gridReal := RealSequence.value at dyadicRiemannSums(f, A, B), J with
      sequence
    have ball := openBall.membership.backward with ⟨sumReal, near⟩
    have joined := openBall.triangle with ball, tail
    have double := half.add_self with typedE
    rw double at joined
    obtain ⟨_, bound⟩ := openBall.membership.forward with joined
    exact bound
  . rw ← equal
    exact RiemannIntegrable.point with function
  . exfalso
    linarith

-- Section: Joining tagged partitions
-- The sequence q delayed by N places, and p followed by q from index N.
defgraph delayedRealSequence (q : Set, N : Nat) (n ∈ ℕ) : ℝ := q[sub(n, N)]
requires sequence : RealSequence(q)
proof
  have typedN := nat.omega.backward with member
  exact RealSequence.value with sequence

def joinedSequence (p q : Set, N : Nat) : Set :=
  switchSequence(p, delayedRealSequence(q, N), N)

theorem joinedSequence.sequence (p q : Set, N : Nat)
  requires sequenceP : RealSequence(p)
  requires sequenceQ : RealSequence(q)
  shows RealSequence(joinedSequence(p, q, N))
proof
  have delayed : RealSequence(delayedRealSequence(q, N))
    unfold RealSequence
    exact delayedRealSequence.function with sequenceQ
  unfold joinedSequence
  exact switchSequence.sequence with sequenceP, delayed

theorem joinedSequence.before (p q : Set, N i : Nat)
  requires sequenceP : RealSequence(p)
  requires sequenceQ : RealSequence(q)
  requires earlier : i < N
  shows joinedSequence(p, q, N)[i] = p[i]
proof
  have delayed : RealSequence(delayedRealSequence(q, N))
    unfold RealSequence
    exact delayedRealSequence.function with sequenceQ
  unfold joinedSequence
  exact switchSequence.before with sequenceP, delayed, earlier

theorem joinedSequence.after (p q : Set, N j : Nat)
  requires sequenceP : RealSequence(p)
  requires sequenceQ : RealSequence(q)
  shows joinedSequence(p, q, N)[add(N, j)] = q[j]
proof
  have delayed : RealSequence(delayedRealSequence(q, N))
    unfold RealSequence
    exact delayedRealSequence.function with sequenceQ
  have later : N ≤ add(N, j) by arith
  have index : sub(add(N, j), N) = j := sub.add_left
  have natural : add(N, j) ∈ ℕ by typecheck
  unfold joinedSequence
  rw [(switchSequence.after with sequenceP, delayed, later),
    (delayedRealSequence.value with sequenceQ, natural), index]

theorem joinedSequence.shifted (p q : Set, N j : Nat)
  requires sequenceP : RealSequence(p)
  requires sequenceQ : RealSequence(q)
  shows shiftedRealSequence(joinedSequence(p, q, N), N)[j] = q[j]
proof
  have joined := joinedSequence.sequence at p, q, N with sequenceP, sequenceQ
  rw [(shiftedRealSequence.value with joined),
    (joinedSequence.after with sequenceP, sequenceQ)]

-- Where p ends where q starts, the cells of the joined sequence are those
-- of p before N and those of q from N on.
theorem joinedSequence.cell_before (p q : Set, N i : Nat)
  requires sequenceP : RealSequence(p)
  requires sequenceQ : RealSequence(q)
  requires meet : p[N] = q[0]
  requires earlier : i < N
  shows joinedSequence(p, q, N)[i] = p[i] ∧
    joinedSequence(p, q, N)[succ(i)] = p[succ(i)]
proof
  refine ⟨(joinedSequence.before with sequenceP, sequenceQ, earlier), ?_⟩
  by_cases inner : succ(i) < N
  . exact joinedSequence.before with sequenceP, sequenceQ, inner
  . have last : succ(i) = N by arith
    have start := joinedSequence.after at p, q, N, 0 with sequenceP, sequenceQ
    have zeroAdd : add(N, 0) = N by arith
    rw zeroAdd at start
    rw [last, start, meet]

theorem joinedSequence.cell_after (p q : Set, N j : Nat)
  requires sequenceP : RealSequence(p)
  requires sequenceQ : RealSequence(q)
  shows joinedSequence(p, q, N)[add(N, j)] = q[j] ∧
    joinedSequence(p, q, N)[succ(add(N, j))] = q[succ(j)]
proof
  refine ⟨(joinedSequence.after with sequenceP, sequenceQ), ?_⟩
  have shift : succ(add(N, j)) = add(N, succ(j)) by arith
  rw shift
  exact joinedSequence.after with sequenceP, sequenceQ

-- Every index below N + K is a cell of p or of q.
theorem joinedSequence.index_cases (N K i : Nat)
  requires below : i < add(N, K)
  shows i < N ∨ (∃ j ∈ ℕ, i = add(N, j) ∧ j < K)
proof
  by_cases earlier : i < N
  . left
    exact earlier
  . right
    have later : N ≤ i by arith
    have split := sub.add_of_le with later
    have naturalMember : sub(i, N) ∈ ℕ by typecheck
    refine ⟨sub(i, N), naturalMember, ?_, ?_⟩
    . rw split
    . arith

-- Joining a δ-fine tagged partition of [A, B] and one of [B, C] gives a
-- δ-fine tagged partition of [A, C].
theorem TaggedPartition.join (p t q s : Set) (A B C D : Real, N K : Nat)
  requires taggedP : TaggedPartition(p, t, A, B, N)
  requires fineP : FinePartition(p, A, B, N, D)
  requires taggedQ : TaggedPartition(q, s, B, C, K)
  requires fineQ : FinePartition(q, B, C, K, D)
  shows TaggedPartition(joinedSequence(p, q, N), joinedSequence(t, s, N),
      A, C, add(N, K)) ∧
    FinePartition(joinedSequence(p, q, N), A, C, add(N, K), D)
proof
  obtain ⟨⟨pointsP, startP, endP, stepsP⟩, tagsT, cellsP⟩ := taggedP
  obtain ⟨⟨pointsQ, startQ, endQ, stepsQ⟩, tagsS, cellsQ⟩ := taggedQ
  obtain ⟨_, dPositive, widthsP⟩ := fineP
  obtain ⟨_, _, widthsQ⟩ := fineQ
  have meet : p[N] = q[0] by rw [endP, startQ]
  have points := joinedSequence.sequence at p, q, N with pointsP, pointsQ
  have tags := joinedSequence.sequence at t, s, N with tagsT, tagsS
  have start : joinedSequence(p, q, N)[0] = A
    by_cases empty : (0:N) < N
    . rw [(joinedSequence.before with pointsP, pointsQ, empty), startP]
    . have zero : N = (0:N) by arith
      have first := joinedSequence.after at p, q, N, (0:N) with pointsP, pointsQ
      have zeroAdd : add(N, (0:N)) = N by arith
      rw [zeroAdd, zero] at first
      rw zero at endP
      rw [zero, first, startQ, ← endP, startP]
  have finish : joinedSequence(p, q, N)[add(N, K)] = C by rw [(joinedSequence.after with pointsP, pointsQ), endQ]
  have cells : ∀ i ∈ ℕ, i < add(N, K) →
      (joinedSequence(p, q, N)[i]:R) < (joinedSequence(p, q, N)[succ(i)]:R) ∧
      joinedSequence(t, s, N)[i] ∈ closedInterval(joinedSequence(p, q, N)[i],
        joinedSequence(p, q, N)[succ(i)]) ∧
      realSubValue(joinedSequence(p, q, N)[succ(i)],
        joinedSequence(p, q, N)[i]) < D
    intros i naturalI below
    have typedI := nat.omega.backward with naturalI
    obtain earlier | later := joinedSequence.index_cases with below
    . obtain ⟨left, right⟩ := joinedSequence.cell_before with pointsP,
        pointsQ, meet, earlier
      have tag := joinedSequence.before with tagsT, tagsS, earlier
      rw [left, right, tag]
      refine ⟨(stepsP with i, naturalI, earlier),
        (cellsP with i, naturalI, earlier), (widthsP with i, naturalI, earlier)⟩
    . obtain ⟨j, naturalJ, same, beforeK⟩ := later
      have typedJ := nat.omega.backward with naturalJ
      obtain ⟨left, right⟩ := joinedSequence.cell_after at p, q, N, j with
        pointsP, pointsQ
      have tag := joinedSequence.after at t, s, N, j with tagsT, tagsS
      rw [same, left, right, tag]
      refine ⟨(stepsQ with j, naturalJ, beforeK),
        (cellsQ with j, naturalJ, beforeK), (widthsQ with j, naturalJ, beforeK)⟩
  have partition : IntervalPartition(joinedSequence(p, q, N), A, C, add(N, K))
    refine ⟨points, start, finish, ?_⟩
    intros i naturalI below
    obtain ⟨step, _, _⟩ := cells with i, naturalI, below
    exact step
  constructor
  . refine ⟨partition, tags, ?_⟩
    intros i naturalI below
    obtain ⟨_, tag, _⟩ := cells with i, naturalI, below
    exact tag
  . refine ⟨partition, dPositive, ?_⟩
    intros i naturalI below
    obtain ⟨_, _, width⟩ := cells with i, naturalI, below
    exact width

-- The tagged sum over the joined partition is the sum of the two sums.
theorem riemannSum.join (f p t q s : Set, N K : Nat)
  requires function : f : ℝ → ℝ
  requires pointsP : RealSequence(p)
  requires tagsT : RealSequence(t)
  requires pointsQ : RealSequence(q)
  requires tagsS : RealSequence(s)
  requires meet : p[N] = q[0]
  shows riemannSum(f, joinedSequence(p, q, N), joinedSequence(t, s, N),
      add(N, K)) = R[riemannSum(f, p, t, N) + riemannSum(f, q, s, K)]
proof
  have points := joinedSequence.sequence at p, q, N with pointsP, pointsQ
  have tags := joinedSequence.sequence at t, s, N with tagsT, tagsS
  have shiftedPoints := shiftedRealSequence.sequence at
    joinedSequence(p, q, N), N with points
  have shiftedTags := shiftedRealSequence.sequence at
    joinedSequence(t, s, N), N with tags
  have prefix := riemannSum.congr_cells at f, joinedSequence(p, q, N),
    joinedSequence(t, s, N), p, t, N with function, points, pointsP, tags,
    tagsT
  have prefixEq : riemannSum(f, joinedSequence(p, q, N),
      joinedSequence(t, s, N), N) = riemannSum(f, p, t, N)
    apply prefix
    intros i naturalI earlier
    have typedI := nat.omega.backward with naturalI
    obtain ⟨left, right⟩ := joinedSequence.cell_before with pointsP, pointsQ,
      meet, earlier
    have tag := joinedSequence.before with tagsT, tagsS, earlier
    exact ⟨left, right, tag⟩
  have suffixEq : riemannSum(f, shiftedRealSequence(joinedSequence(p, q, N), N),
      shiftedRealSequence(joinedSequence(t, s, N), N), K) =
      riemannSum(f, q, s, K)
    apply riemannSum.congr_cells with function, shiftedPoints, pointsQ,
      shiftedTags, tagsS
    intros i naturalI earlier
    have typedI := nat.omega.backward with naturalI
    have left := joinedSequence.shifted at p, q, N, i with pointsP, pointsQ
    have right := joinedSequence.shifted at p, q, N, succ(i) with pointsP,
      pointsQ
    have tag := joinedSequence.shifted at t, s, N, i with tagsT, tagsS
    exact ⟨left, right, tag⟩
  rw [(riemannSum.split_at with function, points, tags), prefixEq, suffixEq]

-- Section: Integrals over adjacent intervals
-- The tagged sums of an integrable function satisfy the Cauchy criterion.
theorem HasRiemannIntegral.fine_sums_cauchy (f : Set) (A B I : Real)
  requires integral : HasRiemannIntegral(f, A, B, I)
  shows FineSumsCauchy(f, A, B)
proof
  obtain ⟨function, _, control⟩ := integral
  intros E eMember ePositive
  have eReal : Real(E) by exact eMember
  have halfPositive := half.positive with ePositive
  have halfReal := half.real at E
  have halfMember : half(E) ∈ ℝ by exact halfReal
  have halves := half.add_self at E
  obtain ⟨D, dMember, dPositive, estimate⟩ := control with half(E), halfMember,
    halfPositive
  refine ⟨D, dMember, dPositive, ?_⟩
  intros p t N nMember q s M mMember taggedP fineP taggedQ fineQ
  have nearP := estimate with p, t, N, nMember, taggedP, fineP
  have nearQ := estimate with q, s, M, mMember, taggedQ, fineQ
  obtain ⟨⟨pointsP, _, _, _⟩, tagsT, _⟩ := taggedP
  obtain ⟨⟨pointsQ, _, _, _⟩, tagsS, _⟩ := taggedQ
  have sumP := riemannSum.real at f, p, t, N with function, pointsP, tagsT
  have sumQ := riemannSum.real at f, q, s, M with function, pointsQ, tagsS
  have triangle := dist.triangle at riemannSum(f, p, t, N), I,
    riemannSum(f, q, s, M)
  have symmetric := dist.symmetric at I, riemannSum(f, q, s, M)
  linarith

-- Integrable on [A, C] gives integrable on [A, B] and on [B, C].
theorem RiemannIntegrable.restrict (f : Set) (A B C : Real)
  requires integrable : RiemannIntegrable(f, A, C)
  requires first : A ≤ B
  requires second : B ≤ C
  shows RiemannIntegrable(f, A, B) ∧ RiemannIntegrable(f, B, C)
proof
  obtain ⟨I, _, integral⟩ := integrable
  have function := HasRiemannIntegral.function with integral
  have close := HasRiemannIntegral.fine_sums_cauchy with integral
  constructor
  . apply FineSumsCauchy.integrable with function, first
    intros E eMember ePositive
    obtain ⟨D, dMember, dPositive, near⟩ := close with E, eMember, ePositive
    refine ⟨D, dMember, dPositive, ?_⟩
    intros p t N nMember q s M mMember taggedP fineP taggedQ fineQ
    have typedN := nat.omega.backward with nMember
    have typedM := nat.omega.backward with mMember
    have cofinal := FineTaggedPartitionsExist.ordered_interval with second
    obtain ⟨u, v, K, kMember, taggedR, fineR⟩ := cofinal with D, dMember,
      dPositive
    have typedK := nat.omega.backward with kMember
    obtain ⟨joinedP, fineJoinedP⟩ := TaggedPartition.join with taggedP, fineP,
      taggedR, fineR
    obtain ⟨joinedQ, fineJoinedQ⟩ := TaggedPartition.join with taggedQ, fineQ,
      taggedR, fineR
    have countP : add(N, K) ∈ ℕ by typecheck
    have countQ : add(M, K) ∈ ℕ by typecheck
    have compared := near with joinedSequence(p, u, N),
      joinedSequence(t, v, N), add(N, K), countP, joinedSequence(q, u, M),
      joinedSequence(s, v, M), add(M, K), countQ, joinedP, fineJoinedP,
      joinedQ, fineJoinedQ
    obtain ⟨⟨pointsP, _, endP, _⟩, tagsT, _⟩ := taggedP
    obtain ⟨⟨pointsQ, _, endQ, _⟩, tagsS, _⟩ := taggedQ
    obtain ⟨⟨pointsR, startR, _, _⟩, tagsV, _⟩ := taggedR
    have meetP : p[N] = u[0] by rw [endP, startR]
    have meetQ : q[M] = u[0] by rw [endQ, startR]
    rw [(riemannSum.join with function, pointsP, tagsT, pointsR, tagsV, meetP),
      (riemannSum.join with function, pointsQ, tagsS, pointsR, tagsV, meetQ),
      dist.add_right] at compared
    exact compared
  . apply FineSumsCauchy.integrable with function, second
    intros E eMember ePositive
    obtain ⟨D, dMember, dPositive, near⟩ := close with E, eMember, ePositive
    refine ⟨D, dMember, dPositive, ?_⟩
    intros p t N nMember q s M mMember taggedP fineP taggedQ fineQ
    have typedN := nat.omega.backward with nMember
    have typedM := nat.omega.backward with mMember
    have cofinal := FineTaggedPartitionsExist.ordered_interval with first
    obtain ⟨u, v, K, kMember, taggedL, fineL⟩ := cofinal with D, dMember,
      dPositive
    have typedK := nat.omega.backward with kMember
    obtain ⟨joinedP, fineJoinedP⟩ := TaggedPartition.join with taggedL, fineL,
      taggedP, fineP
    obtain ⟨joinedQ, fineJoinedQ⟩ := TaggedPartition.join with taggedL, fineL,
      taggedQ, fineQ
    have countP : add(K, N) ∈ ℕ by typecheck
    have countQ : add(K, M) ∈ ℕ by typecheck
    have compared := near with joinedSequence(u, p, K),
      joinedSequence(v, t, K), add(K, N), countP, joinedSequence(u, q, K),
      joinedSequence(v, s, K), add(K, M), countQ, joinedP, fineJoinedP,
      joinedQ, fineJoinedQ
    obtain ⟨⟨pointsP, startP, _, _⟩, tagsT, _⟩ := taggedP
    obtain ⟨⟨pointsQ, startQ, _, _⟩, tagsS, _⟩ := taggedQ
    obtain ⟨⟨pointsL, _, endL, _⟩, tagsV, _⟩ := taggedL
    have meetP : u[K] = p[0] by rw [endL, startP]
    have meetQ : u[K] = q[0] by rw [endL, startQ]
    rw [(riemannSum.join with function, pointsL, tagsV, pointsP, tagsT, meetP),
      (riemannSum.join with function, pointsL, tagsV, pointsQ, tagsS, meetQ),
      dist.add_left] at compared
    exact compared

-- Integrals over adjacent intervals add.
theorem HasRiemannIntegral.adjacent_sum (f : Set) (A B C I J K : Real)
  requires left : HasRiemannIntegral(f, A, B, I)
  requires right : HasRiemannIntegral(f, B, C, J)
  requires whole : HasRiemannIntegral(f, A, C, K)
  shows K = R[I + J]
proof
  obtain ⟨function, first, controlL⟩ := left
  obtain ⟨_, second, controlR⟩ := right
  obtain ⟨_, _, controlW⟩ := whole
  apply real.eq_of_common_near
  intros e eMember ePositive
  have eReal : Real(e) by exact eMember
  have halfPositive := half.positive with ePositive
  have halfReal := half.real at e
  have halfMember : half(e) ∈ ℝ by exact halfReal
  have halves := half.add_self at e
  obtain ⟨D1, d1Member, d1Positive, estimateL⟩ := controlL with half(e),
    halfMember, halfPositive
  obtain ⟨D2, d2Member, d2Positive, estimateR⟩ := controlR with half(e),
    halfMember, halfPositive
  obtain ⟨D3, d3Member, d3Positive, estimateW⟩ := controlW with e, eMember,
    ePositive
  have d1Real : Real(D1) by exact d1Member
  have d2Real : Real(D2) by exact d2Member
  have d3Real : Real(D3) by exact d3Member
  obtain ⟨D4, d4Member, d4Positive, d41, d42⟩ := positiveRadius.common with
    d1Positive, d2Positive
  have d4Real : Real(D4) by exact d4Member
  obtain ⟨D, dMember, dPositive, d4, d3⟩ := positiveRadius.common with
    d4Positive, d3Positive
  have cofinalL := FineTaggedPartitionsExist.ordered_interval with first
  have cofinalR := FineTaggedPartitionsExist.ordered_interval with second
  obtain ⟨p, t, N, nMember, taggedP, fineP⟩ := cofinalL with D, dMember,
    dPositive
  obtain ⟨q, s, M, mMember, taggedQ, fineQ⟩ := cofinalR with D, dMember,
    dPositive
  have typedN := nat.omega.backward with nMember
  have typedM := nat.omega.backward with mMember
  obtain ⟨joined, fineJoined⟩ := TaggedPartition.join with taggedP, fineP,
    taggedQ, fineQ
  have d1 : D ≤ D1 by linarith
  have d2 : D ≤ D2 by linarith
  have nearL := estimateL with p, t, N, nMember, taggedP,
    (FinePartition.weaken with fineP, d1)
  have nearR := estimateR with q, s, M, mMember, taggedQ,
    (FinePartition.weaken with fineQ, d2)
  have count : add(N, M) ∈ ℕ by typecheck
  have nearW := estimateW with joinedSequence(p, q, N), joinedSequence(t, s, N),
    add(N, M), count, joined, (FinePartition.weaken with fineJoined, d3)
  obtain ⟨⟨pointsP, _, endP, _⟩, tagsT, _⟩ := taggedP
  obtain ⟨⟨pointsQ, startQ, _, _⟩, tagsS, _⟩ := taggedQ
  have meet : p[N] = q[0] by rw [endP, startQ]
  rw (riemannSum.join with function, pointsP, tagsT, pointsQ, tagsS, meet)
    at nearW
  have sumP := riemannSum.real at f, p, t, N with function, pointsP, tagsT
  have sumQ := riemannSum.real at f, q, s, M with function, pointsQ, tagsS
  have sumMember : R[riemannSum(f, p, t, N) + riemannSum(f, q, s, M)] ∈ ℝ
    by typecheck
  refine ⟨R[riemannSum(f, p, t, N) + riemannSum(f, q, s, M)], sumMember, ?_, ?_⟩
  . unfold dist at nearW
    unfold realSubValue at nearW
    exact nearW
  . unfold dist at nearL
    unfold dist at nearR
    unfold realSubValue at nearL
    unfold realSubValue at nearR
    have shape : R[riemannSum(f, p, t, N) + riemannSum(f, q, s, M) - (I + J)] =
      R[(riemannSum(f, p, t, N) - I) + (riemannSum(f, q, s, M) - J)] by ring
    have triangle := abs.triangle at R[riemannSum(f, p, t, N) - I],
      R[riemannSum(f, q, s, M) - J]
    rw shape
    linarith

-- Section: Integrable functions are bounded
-- Two sequences that agree off the index i have prefix sums differing by
-- the difference at i.
theorem realPartialSum.single_difference (u v : Set, i n : Nat)
  requires sequenceU : RealSequence(u)
  requires sequenceV : RealSequence(v)
  requires agree : ∀ k ∈ ℕ, k ≠ i → u[k] = v[k]
  shows i < n → R[(∑ k < n, u(k)) - (∑ k < n, v(k))] = R[u[i] - v[i]]
proof
  induction n
  | zero =>
    intro below
    arith
  | succ(m) using ih =>
    intro below
    have um := RealSequence.value at u, m with sequenceU
    have vm := RealSequence.value at v, m with sequenceV
    have ui := RealSequence.value at u, i with sequenceU
    have vi := RealSequence.value at v, i with sequenceV
    have sumU := realPartialSum.real at u, m with sequenceU
    have sumV := realPartialSum.real at v, m with sequenceV
    have naturalM := nat.omega.forward at m with assumption
    rw [realPartialSum.succ, realPartialSum.succ]
    by_cases earlier : i < m
    . have previous := ih with earlier
      have different : m ≠ i by arith
      have same := agree with m, naturalM, different
      rw same
      linarith
    . have equal : i = m by arith
      have prefix : ∑ k < m, u(k) = ∑ k < m, v(k)
        apply realPartialSum.eq_prefix with sequenceU, sequenceV
        intros k naturalK beforeM
        have typedK := nat.omega.backward with naturalK
        have different : k ≠ i by arith
        exact agree with k, naturalK, different
      rw [prefix, equal]
      ring

-- t with its i-th entry replaced by x.
def retagSequence (t : Set, i : Nat, x : Real) : Set :=
  switchSequence(t, switchSequence(constantSequence(x), t, succ(i)), i)

theorem retagSequence.sequence (t : Set, i : Nat, x : Real)
  requires tags : RealSequence(t)
  shows RealSequence(retagSequence(t, i, x))
proof
  have constant := constantSequence.sequence at x
  have inner := switchSequence.sequence at constantSequence(x), t, succ(i)
    with constant, tags
  unfold retagSequence
  exact switchSequence.sequence with tags, inner

theorem retagSequence.value (t : Set, i k : Nat, x : Real)
  requires tags : RealSequence(t)
  shows (k = i → retagSequence(t, i, x)[k] = x) ∧
    (k ≠ i → retagSequence(t, i, x)[k] = t[k])
proof
  have constant := constantSequence.sequence at x
  have inner := switchSequence.sequence at constantSequence(x), t, succ(i)
    with constant, tags
  constructor
  . intro same
    have later : i ≤ k by arith
    have earlier : k < succ(i) by arith
    unfold retagSequence
    rw [(switchSequence.after with tags, inner, later),
      (switchSequence.before with constant, tags, earlier),
      constantSequence.value]
  . intro different
    by_cases earlier : k < i
    . unfold retagSequence
      exact switchSequence.before with tags, inner, earlier
    . have later : i ≤ k by arith
      have beyond : succ(i) ≤ k by arith
      unfold retagSequence
      rw [(switchSequence.after with tags, inner, later),
        (switchSequence.after with constant, tags, beyond)]

-- Moving the tag of cell i to another point x of the cell.
theorem riemannSum.retag (f p t : Set) (A B X : Real, N i : Nat)
  requires function : f : ℝ → ℝ
  requires tagged : TaggedPartition(p, t, A, B, N)
  requires beforeEnd : i < N
  requires inside : X ∈ closedInterval(p[i], p[succ(i)])
  shows TaggedPartition(p, retagSequence(t, i, X), A, B, N) ∧
    riemannSum(f, p, retagSequence(t, i, X), N) =
      R[riemannSum(f, p, t, N) +
        (f(X) - f(t[i])) * realSubValue(p[succ(i)], p[i])]
proof
  obtain ⟨partition, tags, cells⟩ := tagged
  have points : RealSequence(p)
    obtain ⟨points, _, _, _⟩ := partition
    exact points
  have retagged := retagSequence.sequence at t, i, X with tags
  constructor
  . refine ⟨partition, retagged, ?_⟩
    intros k naturalK below
    have typedK := nat.omega.backward with naturalK
    obtain ⟨atI, elsewhere⟩ := retagSequence.value at t, i, k, X with tags
    by_cases same : k = i
    . rw [(atI with same), same]
      exact inside
    . rw (elsewhere with same)
      exact cells with k, naturalK, below
  . have termsNew : RealSequence(riemannTerms(f, p, retagSequence(t, i, X)))
      unfold RealSequence
      exact riemannTerms.function with function, points, retagged
    have termsOld : RealSequence(riemannTerms(f, p, t))
      unfold RealSequence
      exact riemannTerms.function with function, points, tags
    have agree : ∀ k ∈ ℕ, k ≠ i →
        riemannTerms(f, p, retagSequence(t, i, X))[k] = riemannTerms(f, p, t)[k]
      intros k naturalK different
      have typedK := nat.omega.backward with naturalK
      obtain ⟨_, elsewhere⟩ := retagSequence.value at t, i, k, X with tags
      rw [(riemannTerms.value at f, p, retagSequence(t, i, X), k with function,
          points, retagged),
        (riemannTerms.value at f, p, t, k with function, points, tags),
        (elsewhere with different)]
    have difference := realPartialSum.single_difference at
      riemannTerms(f, p, retagSequence(t, i, X)), riemannTerms(f, p, t), i, N
      with termsNew, termsOld, agree
    have atCell := difference with beforeEnd
    obtain ⟨atI, _⟩ := retagSequence.value at t, i, i, X with tags
    have reflexive : i = i by rfl
    rw [(riemannTerms.value at f, p, retagSequence(t, i, X), i with function,
        points, retagged),
      (riemannTerms.value at f, p, t, i with function, points, tags),
      (atI with reflexive)] at atCell
    have sumNew := riemannSum.real at f, p, retagSequence(t, i, X), N with
      function, points, retagged
    have sumOld := riemannSum.real at f, p, t, N with function, points, tags
    have xMember : X ∈ ℝ
      obtain ⟨xMember, _, _⟩ := closedInterval.membership.forward with inside
      exact xMember
    have tagI := RealSequence.value at t, i with tags
    have tagMember : t[i] ∈ ℝ by exact tagI
    have valueX := FunctionBetween.apply_closed with function, xMember
    have valueT := FunctionBetween.apply_closed with function, tagMember
    have pointI := RealSequence.value at p, i with points
    have pointNext := RealSequence.value at p, succ(i) with points
    rw [realMulValue.eq_mul, realMulValue.eq_mul] at atCell
    unfold riemannSum
    have product : R[(f(X) - f(t[i])) * realSubValue(p[succ(i)], p[i])] =
      R[f(X) * realSubValue(p[succ(i)], p[i]) -
        f(t[i]) * realSubValue(p[succ(i)], p[i])] by ring
    rw product
    linarith

-- |x| ≤ M from −M ≤ x ≤ M.
theorem abs.le_of_bounds (X M : Real)
  requires lower : R[-M] ≤ X
  requires upper : X ≤ M
  shows abs(X) ≤ M
proof
  by_cases sign : R[0] ≤ X
  . rw (abs.of_nonnegative with sign)
    exact upper
  . have nonpositive : X ≤ R[0]
      obtain below | same | above := realLess.trichotomy at X, R[0]
      . exact realLess.implies_le with below
      . rw same
        exact realLe.reflexive with *
      . exfalso
        exact sign with (realLess.implies_le with above)
    rw (abs.of_nonpositive with nonpositive)
    linarith

-- The values f(u₀), f(u₁), … and the inverse cell widths of a partition.
defgraph composedSequence (f u : Set) (n ∈ ℕ) : ℝ := f(u[n])
requires function : f : ℝ → ℝ
requires sequence : RealSequence(u)
proof
  have typedN := nat.omega.backward with member
  have value := RealSequence.value with sequence
  have valueMember : u[n] ∈ ℝ by exact value
  exact FunctionBetween.apply_closed with function, valueMember

defgraph inverseCellWidths (p : Set) (n ∈ ℕ) : ℝ :=
    realInvValue(realSubValue(p[succ(n)], p[n]))
requires points : RealSequence(p)
proof
  have typedN := nat.omega.backward with member
  have pointN := RealSequence.value with points
  have pointNext := RealSequence.value at p, succ(n) with points
  have width := realSubValue.real with pointNext, pointN
  exact realInvValue.real with width

-- A point of [A, B] is a vertex of a partition of [A, B] or lies strictly
-- inside one of its cells.
theorem IntervalPartition.locate (p : Set) (A B X : Real, N : Nat)
  requires partition : IntervalPartition(p, A, B, N)
  requires inside : X ∈ closedInterval(A, B)
  shows (∃ j ∈ ℕ, j ≤ N ∧ p[j] = X) ∨
    (∃ k ∈ ℕ, k < N ∧ (p[k]:R) < X ∧ X < (p[succ(k)]:R))
proof
  obtain ⟨_, lower, upper⟩ := closedInterval.membership.forward with inside
  have partitionCopy : IntervalPartition(p, A, B, N) by exact partition
  obtain ⟨_, start, finish, _⟩ := partitionCopy
  obtain above | atStart | beyond := realLess.trichotomy at A, X
  . have right := realLess.trichotomy at X, B
    rcases right with below | atEnd | outside
    . exact IntervalPartition.locate_interior with partition, above, below
    . left
      have nMember : N ∈ ℕ by typecheck
      have reflexive : N ≤ N by arith
      refine ⟨N, nMember, reflexive, ?_⟩
      rw [finish, atEnd]
    . exfalso
      linarith
  . left
    have zeroMember : (0:N) ∈ ℕ by typecheck
    have zeroLe : (0:N) ≤ N by arith
    refine ⟨(0:N), zeroMember, zeroLe, ?_⟩
    rw [start, atStart]
  . exfalso
    linarith

-- A Riemann integrable function is bounded on its interval.
theorem RiemannIntegrable.bounded (f : Set) (A B : Real)
  requires integrable : RiemannIntegrable(f, A, B)
  shows ∃ M ∈ ℝ, ∀ X ∈ closedInterval(A, B), abs(f(X)) ≤ M
proof
  obtain ⟨I, iMember, integral⟩ := integrable
  obtain ⟨function, ordered, control⟩ := integral
  have onePositive : R[0] < R[1] by linarith
  have oneMember : R[1] ∈ ℝ by typecheck
  obtain ⟨D, dMember, dPositive, estimate⟩ := control with R[1], oneMember,
    onePositive
  have cofinal := FineTaggedPartitionsExist.ordered_interval with ordered
  obtain ⟨p, t, N, nMember, tagged, fine⟩ := cofinal with D, dMember, dPositive
  have typedN := nat.omega.backward with nMember
  have taggedCopy : TaggedPartition(p, t, A, B, N) by exact tagged
  obtain ⟨partition, tags, _⟩ := taggedCopy
  have partitionCopy : IntervalPartition(p, A, B, N) by exact partition
  obtain ⟨points, _, _, _⟩ := partitionCopy
  have valuesT : RealSequence(composedSequence(f, t))
    unfold RealSequence
    exact composedSequence.function with function, tags
  have valuesP : RealSequence(composedSequence(f, p))
    unfold RealSequence
    exact composedSequence.function with function, points
  have inverses : RealSequence(inverseCellWidths(p))
    unfold RealSequence
    exact inverseCellWidths.function with points
  obtain ⟨M1, m1Member, m1Nonnegative, bound1⟩ := RealSequence.prefix_bounded
    at composedSequence(f, t), N with valuesT
  obtain ⟨M2, m2Member, m2Nonnegative, bound2⟩ := RealSequence.prefix_bounded
    at composedSequence(f, p), succ(N) with valuesP
  obtain ⟨M3, m3Member, m3Nonnegative, bound3⟩ := RealSequence.prefix_bounded
    at inverseCellWidths(p), N with inverses
  have sumMember : R[M1 + M2 + (M3 + M3 + M3)] ∈ ℝ by typecheck
  refine ⟨R[M1 + M2 + (M3 + M3 + M3)], sumMember, ?_⟩
  intros X inside
  obtain ⟨xMember, _, _⟩ := closedInterval.membership.forward with inside
  have located := IntervalPartition.locate with partition, inside
  have valueX := FunctionBetween.apply_closed with function, xMember
  rcases located with vertex | interior
  . obtain ⟨j, naturalJ, bounded, same⟩ := vertex
    have typedJ := nat.omega.backward with naturalJ
    have below : j < succ(N) by arith
    have atVertex := bound2 with j, naturalJ, below
    rw [(composedSequence.value with function, points, naturalJ), same]
      at atVertex
    linarith
  . obtain ⟨k, naturalK, beforeEnd, lower, upper⟩ := interior
    have typedK := nat.omega.backward with naturalK
    have lowerLe := realLess.implies_le with lower
    have upperLe := realLess.implies_le with upper
    have cell : X ∈ closedInterval(p[k], p[succ(k)])
      exact closedInterval.membership.backward with ⟨xMember, lowerLe, upperLe⟩
    obtain ⟨retagged, sumNew⟩ := riemannSum.retag at f, p, t, A, B, X, N, k
      with function, tagged, beforeEnd, cell
    have nearOld := estimate with p, t, N, nMember, tagged, fine
    have nearNew := estimate with p, retagSequence(t, k, X), N, nMember,
      retagged, fine
    have retags := retagSequence.sequence at t, k, X with tags
    have sumOld := riemannSum.real at f, p, t, N with function, points, tags
    unfold dist at nearOld
    unfold dist at nearNew
    unfold realSubValue at nearOld
    unfold realSubValue at nearNew
    have oldUpper := abs.upper at R[riemannSum(f, p, t, N) - I]
    have oldLower := abs.upper_neg at R[riemannSum(f, p, t, N) - I]
    have newUpper := abs.upper at
      R[riemannSum(f, p, retagSequence(t, k, X), N) - I]
    have newLower := abs.upper_neg at
      R[riemannSum(f, p, retagSequence(t, k, X), N) - I]
    have tagK := RealSequence.value at t, k with tags
    have tagMember : t[k] ∈ ℝ by exact tagK
    have valueT := FunctionBetween.apply_closed with function, tagMember
    have pointK := RealSequence.value at p, k with points
    have pointNext := RealSequence.value at p, succ(k) with points
    have widthPositive := IntervalPartition.positive_width with partition,
      beforeEnd
    have positive : R[0] < realSubValue(p[succ(k)], p[k]) by exact widthPositive
    have inversePositive := realInvValue.positive with positive
    have nonzero : realSubValue(p[succ(k)], p[k]) ≠ R[0]
      intro zero
      rw zero at positive
      linarith
    have cancel := realInvValue.mul_left with nonzero
    -- |(f(X) − f(tₖ)) w| < 2, so |f(X) − f(tₖ)| < 2/w.
    have productUpper : R[(f(X) - f(t[k])) * realSubValue(p[succ(k)], p[k])]
        < R[2] by linarith
    have negated : R[(f(t[k]) - f(X)) * realSubValue(p[succ(k)], p[k])] =
      R[-((f(X) - f(t[k])) * realSubValue(p[succ(k)], p[k]))] by ring
    have productLower : R[(f(t[k]) - f(X)) * realSubValue(p[succ(k)], p[k])]
        < R[2] by linarith
    have scaledUpper := realLess.mul_right_of_positive with productUpper,
      inversePositive
    have scaledLower := realLess.mul_right_of_positive with productLower,
      inversePositive
    have shape : R[((f(X) - f(t[k])) * realSubValue(p[succ(k)], p[k])) *
        realInvValue(realSubValue(p[succ(k)], p[k]))] = R[f(X) - f(t[k])]
      have regroup : R[((f(X) - f(t[k])) * realSubValue(p[succ(k)], p[k])) *
          realInvValue(realSubValue(p[succ(k)], p[k]))] =
        R[(f(X) - f(t[k])) * (realInvValue(realSubValue(p[succ(k)], p[k])) *
          realSubValue(p[succ(k)], p[k]))] by ring
      rw [regroup, cancel]
      ring
    have shapeLower : R[((f(t[k]) - f(X)) * realSubValue(p[succ(k)], p[k])) *
        realInvValue(realSubValue(p[succ(k)], p[k]))] = R[f(t[k]) - f(X)]
      have regroup : R[((f(t[k]) - f(X)) * realSubValue(p[succ(k)], p[k])) *
          realInvValue(realSubValue(p[succ(k)], p[k]))] =
        R[(f(t[k]) - f(X)) * (realInvValue(realSubValue(p[succ(k)], p[k])) *
          realSubValue(p[succ(k)], p[k]))] by ring
      rw [regroup, cancel]
      ring
    have inverseBound := bound3 with k, naturalK, beforeEnd
    rw (inverseCellWidths.value with points, naturalK) at inverseBound
    have inverseUpper := abs.upper at
      realInvValue(realSubValue(p[succ(k)], p[k]))
    have tagBound := bound1 with k, naturalK, beforeEnd
    rw (composedSequence.value with function, tags, naturalK) at tagBound
    have tagUpper := abs.upper at f(t[k])
    have tagLower := abs.upper_neg at f(t[k])
    have inverseLe : realInvValue(realSubValue(p[succ(k)], p[k])) ≤ M3
      by linarith
    have tagAbove : R[-M1] ≤ f(t[k]) by linarith
    have lowerX : R[-(M1 + M3 + M3)] < f(X) by linarith
    have upperX : f(X) < R[M1 + M3 + M3] by linarith
    apply abs.le_of_bounds
    . linarith
    . linarith

-- ∫_A^B g + ∫_B^C g = ∫_A^C g.
theorem complexIntegral.add_interval (g : Set) (A B C : Real)
  requires first : A ≤ B
  requires second : B ≤ C
  requires integrable : ComplexRiemannIntegrable(g, A, C)
  shows ComplexRiemannIntegrable(g, A, B) ∧
    ComplexRiemannIntegrable(g, B, C) ∧
    ℂ[complexIntegral(g, A, B) + complexIntegral(g, B, C)] =
      complexIntegral(g, A, C)
proof
  obtain ⟨values, re, im⟩ := integrable
  obtain ⟨reAB, reBC⟩ := RiemannIntegrable.restrict with re, first, second
  obtain ⟨imAB, imBC⟩ := RiemannIntegrable.restrict with im, first, second
  refine ⟨⟨values, reAB, imAB⟩, ⟨values, reBC, imBC⟩, ?_⟩
  have memberAB := complexIntegral.member at g, A, B
  have memberBC := complexIntegral.member at g, B, C
  have memberAC := complexIntegral.member at g, A, C
  have sumMember :
    ℂ[complexIntegral(g, A, B) + complexIntegral(g, B, C)] ∈ ℂ by typecheck
  apply complex.eq_of_parts with sumMember, memberAC
  . have value := HasRiemannIntegral.adjacent_sum with
      (riemannIntegral.integral with reAB), (riemannIntegral.integral with reBC),
      (riemannIntegral.integral with re)
    rw [(complexRe.add with memberAB, memberBC), complexIntegral.re,
      complexIntegral.re, complexIntegral.re, value]
  . have value := HasRiemannIntegral.adjacent_sum with
      (riemannIntegral.integral with imAB), (riemannIntegral.integral with imBC),
      (riemannIntegral.integral with im)
    rw [(complexIm.add with memberAB, memberBC), complexIntegral.im,
      complexIntegral.im, complexIntegral.im, value]

theorem complexIntegral.add (f g : Set) (A B : Real)
  requires ordered : A ≤ B
  requires integrableF : ComplexRiemannIntegrable(f, A, B)
  requires integrableG : ComplexRiemannIntegrable(g, A, B)
  shows ComplexRiemannIntegrable(complexFunctionAdd(f, g, ℝ), A, B) ∧
    complexIntegral(complexFunctionAdd(f, g, ℝ), A, B) =
      ℂ[complexIntegral(f, A, B) + complexIntegral(g, A, B)]
proof
  obtain ⟨valuesF, reF, imF⟩ := integrableF
  obtain ⟨valuesG, reG, imG⟩ := integrableG
  have functionH := complexFunctionAdd.function with valuesF, valuesG
  have valuesH : ComplexValuedOn(complexFunctionAdd(f, g, ℝ), ℝ)
    intros X xMember
    exact FunctionBetween.apply_closed with functionH, xMember
  have pointRe : ∀ X ∈ ℝ, complexFunctionRe(complexFunctionAdd(f, g, ℝ))(X) =
      R[1 * complexFunctionRe(f)(X) + 1 * complexFunctionRe(g)(X)]
    intros X xMember
    have xReal : Real(X) by exact xMember
    have fX := valuesF with X, xMember
    have gX := valuesG with X, xMember
    rw [(complexFunctionRe.apply with valuesH),
      (complexFunctionRe.apply with valuesF),
      (complexFunctionRe.apply with valuesG),
      (complexFunctionAdd.value with valuesF, valuesG, xMember),
      (complexRe.add with fX, gX)]
    ring
  have pointIm : ∀ X ∈ ℝ, complexFunctionIm(complexFunctionAdd(f, g, ℝ))(X) =
      R[1 * complexFunctionIm(f)(X) + 1 * complexFunctionIm(g)(X)]
    intros X xMember
    have fX := valuesF with X, xMember
    have gX := valuesG with X, xMember
    rw [(complexFunctionIm.apply with valuesH),
      (complexFunctionIm.apply with valuesF),
      (complexFunctionIm.apply with valuesG),
      (complexFunctionAdd.value with valuesF, valuesG, xMember),
      (complexIm.add with fX, gX)]
    ring
  have functionReH := complexFunctionRe.function with valuesH
  have functionImH := complexFunctionIm.function with valuesH
  obtain ⟨integrableReH, valueRe⟩ := riemannIntegral.linear with reF, reG,
    functionReH, pointRe
  obtain ⟨integrableImH, valueIm⟩ := riemannIntegral.linear with imF, imG,
    functionImH, pointIm
  refine ⟨⟨valuesH, integrableReH, integrableImH⟩, ?_⟩
  have memberH := complexIntegral.member at complexFunctionAdd(f, g, ℝ), A, B
  have memberF := complexIntegral.member at f, A, B
  have memberG := complexIntegral.member at g, A, B
  have memberSum :
    ℂ[complexIntegral(f, A, B) + complexIntegral(g, A, B)] ∈ ℂ by typecheck
  apply complex.eq_of_parts with memberH, memberSum
  . rw [complexIntegral.re, valueRe, (complexRe.add with memberF, memberG),
      complexIntegral.re, complexIntegral.re]
    have first := riemannIntegral.selected at complexFunctionRe(f), A, B
    have second := riemannIntegral.selected at complexFunctionRe(g), A, B
    obtain ⟨firstReal, _⟩ := first
    obtain ⟨secondReal, _⟩ := second
    ring
  . rw [complexIntegral.im, valueIm, (complexIm.add with memberF, memberG),
      complexIntegral.im, complexIntegral.im]
    have first := riemannIntegral.selected at complexFunctionIm(f), A, B
    have second := riemannIntegral.selected at complexFunctionIm(g), A, B
    obtain ⟨firstReal, _⟩ := first
    obtain ⟨secondReal, _⟩ := second
    ring

theorem complexIntegral.const_mul (c g : Set) (A B : Real)
  requires hc : c ∈ ℂ
  requires ordered : A ≤ B
  requires integrable : ComplexRiemannIntegrable(g, A, B)
  shows ComplexRiemannIntegrable(
      complexFunctionMul(complexFunctionConst(c, ℝ), g, ℝ), A, B) ∧
    complexIntegral(complexFunctionMul(complexFunctionConst(c, ℝ), g, ℝ),
      A, B) = ℂ[c * complexIntegral(g, A, B)]
proof
  obtain ⟨valuesG, reG, imG⟩ := integrable
  have constant := complexFunctionConst.function at c, ℝ with hc
  have valuesC : ComplexValuedOn(complexFunctionConst(c, ℝ), ℝ)
    intros X xMember
    exact FunctionBetween.apply_closed with constant, xMember
  have functionH := complexFunctionMul.function with valuesC, valuesG
  have valuesH : ComplexValuedOn(
      complexFunctionMul(complexFunctionConst(c, ℝ), g, ℝ), ℝ)
    intros X xMember
    exact FunctionBetween.apply_closed with functionH, xMember
  have pointRe : ∀ X ∈ ℝ, complexFunctionRe(
      complexFunctionMul(complexFunctionConst(c, ℝ), g, ℝ))(X) =
      R[complexRe(c) * complexFunctionRe(g)(X) +
        -complexIm(c) * complexFunctionIm(g)(X)]
    intros X xMember
    have xReal : Real(X) by exact xMember
    have gX := valuesG with X, xMember
    have reGX := complexRe.real with gX
    have imGX := complexIm.real with gX
    rw [(complexFunctionRe.apply with valuesH),
      (complexFunctionRe.apply with valuesG),
      (complexFunctionIm.apply with valuesG),
      (complexFunctionMul.value with valuesC, valuesG, xMember),
      (complexFunctionConst.value with hc, xMember),
      (complexRe.mul with hc, gX)]
    ring
  have pointIm : ∀ X ∈ ℝ, complexFunctionIm(
      complexFunctionMul(complexFunctionConst(c, ℝ), g, ℝ))(X) =
      R[complexRe(c) * complexFunctionIm(g)(X) +
        complexIm(c) * complexFunctionRe(g)(X)]
    intros X xMember
    have gX := valuesG with X, xMember
    rw [(complexFunctionIm.apply with valuesH),
      (complexFunctionRe.apply with valuesG),
      (complexFunctionIm.apply with valuesG),
      (complexFunctionMul.value with valuesC, valuesG, xMember),
      (complexFunctionConst.value with hc, xMember),
      (complexIm.mul with hc, gX)]
    ring
  have functionReH := complexFunctionRe.function with valuesH
  have functionImH := complexFunctionIm.function with valuesH
  obtain ⟨integrableReH, valueRe⟩ := riemannIntegral.linear with reG, imG,
    functionReH, pointRe
  obtain ⟨integrableImH, valueIm⟩ := riemannIntegral.linear with imG, reG,
    functionImH, pointIm
  refine ⟨⟨valuesH, integrableReH, integrableImH⟩, ?_⟩
  have memberH := complexIntegral.member at
    complexFunctionMul(complexFunctionConst(c, ℝ), g, ℝ), A, B
  have memberG := complexIntegral.member at g, A, B
  have memberProduct : ℂ[c * complexIntegral(g, A, B)] ∈ ℂ by typecheck
  have first := riemannIntegral.selected at complexFunctionRe(g), A, B
  have second := riemannIntegral.selected at complexFunctionIm(g), A, B
  obtain ⟨firstReal, _⟩ := first
  obtain ⟨secondReal, _⟩ := second
  apply complex.eq_of_parts with memberH, memberProduct
  . rw [complexIntegral.re, valueRe, (complexRe.mul with hc, memberG),
      complexIntegral.re, complexIntegral.im]
    ring
  . rw [complexIntegral.im, valueIm, (complexIm.mul with hc, memberG),
      complexIntegral.re, complexIntegral.im]
    ring

-- Section: Improper integrals, facts
theorem improperIntegral.spec (G : Set) (A : Real)
  requires integrable : ImproperIntegrable(G, A)
  shows HasImproperIntegral(G, A, improperIntegral(G, A))
proof
  obtain ⟨_, exists, _⟩ := improperIntegral.selected at G, A
  exact exists with integrable

theorem improperIntegral.eq (G : Set) (A I : Real)
  requires integral : HasImproperIntegral(G, A, I)
  shows improperIntegral(G, A) = I
proof
  have realI : I ∈ ℝ by typecheck
  have integrable : ImproperIntegrable(G, A) := ⟨I, realI, integral⟩
  have spec := improperIntegral.spec with integrable
  exact HasImproperIntegral.unique with spec, integral

theorem complexImproperIntegral.spec (g : Set) (A : Real)
  requires integrable : ComplexImproperIntegrable(g, A)
  shows HasComplexImproperIntegral(g, A, complexImproperIntegral(g, A))
proof
  obtain ⟨_, exists, _⟩ := complexImproperIntegral.selected at g, A
  exact exists with integrable

theorem complexImproperIntegral.eq (g : Set) (A : Real) (I : Set)
  requires integral : HasComplexImproperIntegral(g, A, I)
  shows complexImproperIntegral(g, A) = I
proof
  obtain ⟨_, memberI, _⟩ := integral
  have integrable : ComplexImproperIntegrable(g, A) := ⟨I, memberI, integral⟩
  have spec := complexImproperIntegral.spec with integrable
  exact HasComplexImproperIntegral.unique with spec, integral

theorem complexImproperIntegral.member (g : Set) (A : Real)
  shows complexImproperIntegral(g, A) ∈ ℂ
proof
  obtain ⟨member, _⟩ := complexImproperIntegral.selected at g, A
  exact member

-- The derivative of x ↦ x^a at X > 0 is a X^a (1/X).
theorem rpowFunction.has_derivative (S X : Real)
  requires positive : R[0] < X
  shows HasDerivativeAt(rpowFunction(S), R[S * realRpow(X, S) * (1 / X)], X)
proof
  have functionRpow := rpowFunction.function at S
  have functionConstant := constantRealFunction.function at S
  have functionInner := pointwiseMul.function with functionConstant,
    realLog.function
  have functionComposite := compose.function with functionInner,
    realExp.function
  have innerValue : ∀ Y ∈ ℝ,
      pointwiseMul(constantRealFunction(S), realLog)(Y) = R[S * realLog(Y)]
    intros Y yMember
    have yReal : Real(Y) by exact yMember
    have logReal : Real(realLog(Y)) by typecheck
    have constantValue := constantRealFunction.value at S, Y
    rw [(pointwiseMul.value with functionConstant, realLog.function),
      constantValue]
  have same : rpowFunction(S) = compose(realExp,
      pointwiseMul(constantRealFunction(S), realLog), ℝ, ℝ, ℝ)
    apply FunctionBetween.ext with functionRpow, functionComposite
    intros Y yMember
    rw [rpowFunction.value, (compose.apply with functionInner, realExp.function,
      yMember), (innerValue with Y, yMember)]
    unfold realRpow
    rfl
  have xMember : X ∈ ℝ by typecheck
  have logDerivative := realLog.derivative with positive
  have inner := HasDerivativeAt.scale at realLog, S, R[1 / X], X with
    logDerivative
  have outer := realExp.derivative at R[S * realLog(X)]
  rw ← (innerValue with X, xMember) at outer
  have chain := HasDerivativeAt.comp with inner, outer
  rw same
  apply HasDerivativeAt.congr_value with chain
  rw innerValue with X
  unfold realRpow
  ring

-- With K = 1/(1 − σ), the function K x^(1−σ) is an antiderivative of
-- x^(−σ) on (0, ∞), so ∫_A^T x^(−σ) = K T^(1−σ) − K A^(1−σ) for 0 < A ≤ T.
theorem rpowFunction.has_integral (A T S : Real)
  requires positive : R[0] < A
  requires ordered : A ≤ T
  requires exponent : R[1 - S] ≠ R[0]
  shows HasRiemannIntegral(rpowFunction(R[-S]), A, T,
    R[realInvValue(R[1 - S]) * realRpow(T, R[1 - S]) -
      realInvValue(R[1 - S]) * realRpow(A, R[1 - S])])
proof
  have functionRpow := rpowFunction.function at R[1 - S]
  have functionConstant := constantRealFunction.function at
    realInvValue(R[1 - S])
  have functionF := pointwiseMul.function with functionConstant, functionRpow
  have functionf := rpowFunction.function at R[-S]
  have cancel := realInvValue.mul_right with exponent
  have valueF : ∀ Y ∈ ℝ, pointwiseMul(constantRealFunction(realInvValue(R[1 - S])),
      rpowFunction(R[1 - S]))(Y) = R[realInvValue(R[1 - S]) * realRpow(Y, R[1 - S])]
    intros Y yMember
    have powerReal := realRpow.real at Y, R[1 - S]
    have constantValue := constantRealFunction.value at realInvValue(R[1 - S]), Y
    rw [(pointwiseMul.value with functionConstant, functionRpow),
      constantValue, rpowFunction.value]
  -- The derivative at every positive point.
  have derivative : ∀ X ∈ ℝ, R[0] < X → HasDerivativeAt(
      pointwiseMul(constantRealFunction(realInvValue(R[1 - S])),
        rpowFunction(R[1 - S])), rpowFunction(R[-S])(X), X)
    intros X xMember xPositive
    have xReal : Real(X) by exact xMember
    have power := rpowFunction.has_derivative at R[1 - S], X with xPositive
    have scaled := HasDerivativeAt.scale at rpowFunction(R[1 - S]),
      realInvValue(R[1 - S]), R[(1 - S) * realRpow(X, R[1 - S]) * (1 / X)], X
      with power
    apply HasDerivativeAt.congr_value with scaled
    have exponentSum : R[1 - S] = R[-S + 1] by ring
    have split := realRpow.add at X, R[-S], R[1] with xPositive
    rw [← exponentSum, (realRpow.one with xPositive)] at split
    have xNonzero : X ≠ R[0]
      intro zero
      rw zero at xPositive
      linarith
    have inverse := realDiv.mul_left at R[1], X with xNonzero
    rw [rpowFunction.value, split]
    have regroup : R[realInvValue(R[1 - S]) * ((1 - S) * (realRpow(X, R[-S]) * X)
        * (1 / X))] = R[(realInvValue(R[1 - S]) * (1 - S)) * realRpow(X, R[-S]) *
        (X * (1 / X))] by ring
    have commuted : R[realInvValue(R[1 - S]) * (1 - S)] = R[1]
      have swapped : R[realInvValue(R[1 - S]) * (1 - S)] =
        R[(1 - S) * realInvValue(R[1 - S])] by ring
      rw [swapped, cancel]
    rw [regroup, commuted, inverse]
    ring
  have positiveOn : ∀ X ∈ closedInterval(A, T), R[0] < X
    intros X inside
    obtain ⟨xMember, lower, _⟩ := closedInterval.membership.forward with inside
    have xReal : Real(X) by exact xMember
    linarith
  have subset : closedInterval(A, T) ⊆ ℝ
    intros X inside
    obtain ⟨xMember, _, _⟩ := closedInterval.membership.forward with inside
    exact xMember
  have continuousF : ContinuousOn(pointwiseMul(
      constantRealFunction(realInvValue(R[1 - S])), rpowFunction(R[1 - S])),
      closedInterval(A, T))
    apply ContinuousOn.of_differentiable with functionF, subset
    intros X inside
    obtain ⟨xMember, _, _⟩ := closedInterval.membership.forward with inside
    have xReal : Real(X) by exact xMember
    have hasDerivative := derivative with X, xMember, (positiveOn with X, inside)
    exact HasDerivativeAt.differentiable_at with hasDerivative
  have continuousf : ContinuousOn(rpowFunction(R[-S]), closedInterval(A, T))
    apply ContinuousOn.of_differentiable with functionf, subset
    intros X inside
    obtain ⟨xMember, _, _⟩ := closedInterval.membership.forward with inside
    have xReal : Real(X) by exact xMember
    have hasDerivative := rpowFunction.has_derivative at R[-S], X with
      (positiveOn with X, inside)
    exact HasDerivativeAt.differentiable_at with hasDerivative
  have interior : ∀ X ∈ ℝ, A < X → X < T → HasDerivativeAt(
      pointwiseMul(constantRealFunction(realInvValue(R[1 - S])),
        rpowFunction(R[1 - S])), rpowFunction(R[-S])(X), X)
    intros X xMember lower upper
    have xPositive : R[0] < X by linarith
    exact derivative with X, xMember, xPositive
  have integral := FTC.continuous_derivative with ordered, continuousF,
    interior, continuousf
  have aMember : A ∈ ℝ by typecheck
  have tMember : T ∈ ℝ by typecheck
  rw [(valueF with T, tMember), (valueF with A, aMember)] at integral
  unfold realSubValue at integral
  exact integral

-- The integral of x^(−σ) over [A, ∞), for A > 0 and σ > 1, is
-- A^(1−σ)/(σ − 1).
theorem rpowFunction.improper_integral (A S : Real)
  requires positive : R[0] < A
  requires exponent : R[1] < S
  shows HasImproperIntegral(rpowFunction(R[-S]), A,
    R[realRpow(A, R[1 - S]) / (S - 1)])
proof
  have exponentNonzero : R[1 - S] ≠ R[0]
    intro zero
    linarith
  have gapNonzero : R[S - 1] ≠ R[0]
    intro zero
    linarith
  have cancel := realInvValue.mul_right with exponentNonzero
  have aPower := realRpow.real at A, R[1 - S]
  have quotient := realDiv.mul_right at realRpow(A, R[1 - S]), R[S - 1] with
    gapNonzero
  -- K A^(1−σ) = −A^(1−σ)/(σ − 1).
  have startValue : R[realInvValue(R[1 - S]) * realRpow(A, R[1 - S])] =
      R[-(realRpow(A, R[1 - S]) / (S - 1))]
    have expand : R[realInvValue(R[1 - S]) * realRpow(A, R[1 - S])] =
        R[realInvValue(R[1 - S]) *
          ((realRpow(A, R[1 - S]) / (S - 1)) * (S - 1))]
      rw quotient
    have regroup : R[realInvValue(R[1 - S]) *
        ((realRpow(A, R[1 - S]) / (S - 1)) * (S - 1))] =
      R[-(realRpow(A, R[1 - S]) / (S - 1)) * ((1 - S) * realInvValue(R[1 - S]))]
      by ring
    rw [expand, regroup, cancel]
    ring
  -- K < 0.
  have kNegative : realInvValue(R[1 - S]) < R[0]
    by_contra notNegative
    have kNonnegative : R[0] ≤ realInvValue(R[1 - S])
      obtain below | same | above := realLess.trichotomy at realInvValue(R[1 - S]), R[0]
      . exfalso
        exact notNegative with below
      . rw same
        exact realLe.reflexive with *
      . exact realLess.implies_le with above
    have nonpositive : R[1 - S] ≤ R[0] by linarith
    have product := realLe.mul_left_of_nonnegative with nonpositive, kNonnegative
    have swapped : R[realInvValue(R[1 - S]) * (1 - S)] =
      R[(1 - S) * realInvValue(R[1 - S])] by ring
    have zeroed : R[realInvValue(R[1 - S]) * 0] = R[0] by ring
    linarith
  have functionf := rpowFunction.function at R[-S]
  refine ⟨functionf, ?_, ?_⟩
  . intros T tMember later
    have tReal : Real(T) by exact tMember
    have integral := rpowFunction.has_integral with positive, later,
      exponentNonzero
    have valueReal : R[realInvValue(R[1 - S]) * realRpow(T, R[1 - S]) -
        realInvValue(R[1 - S]) * realRpow(A, R[1 - S])] ∈ ℝ by typecheck
    exact ⟨R[realInvValue(R[1 - S]) * realRpow(T, R[1 - S]) -
      realInvValue(R[1 - S]) * realRpow(A, R[1 - S])], valueReal, integral⟩
  . intros e eMember ePositive
    have halfPositive := half.positive with ePositive
    have halfLess := half.lt_self with ePositive
    have gapPositive : R[0] < R[S - 1] by linarith
    have cPositive : R[0] < R[half(e) * (S - 1)]
      have product := realLess.mul_left_of_positive with gapPositive,
        halfPositive
      have zeroed : R[half(e) * 0] = R[0] by ring
      linarith
    have startPower := realRpow.real at R[half(e) * (S - 1)],
      realInvValue(R[1 - S])
    have startReal : Real(realRpow(R[half(e) * (S - 1)],
      realInvValue(R[1 - S]))) by exact startPower
    have startPositive := realRpow.positive at R[half(e) * (S - 1)],
      realInvValue(R[1 - S])
    -- T₀ = c^K with c = (e/2)(σ − 1) has T₀^(1−σ) = c.
    have startValuePower : realRpow(realRpow(R[half(e) * (S - 1)],
        realInvValue(R[1 - S])), R[1 - S]) = R[half(e) * (S - 1)]
      rw (realRpow.mul_exponent with cPositive)
      have product : R[realInvValue(R[1 - S]) * (1 - S)] = R[1]
        have swapped : R[realInvValue(R[1 - S]) * (1 - S)] =
          R[(1 - S) * realInvValue(R[1 - S])] by ring
        rw [swapped, cancel]
      rw [product, (realRpow.one with cPositive)]
    witness realRpow(R[half(e) * (S - 1)], realInvValue(R[1 - S]))
    refine ⟨startPower, ?_⟩
    intros T tMember later afterA
    have tPositive : R[0] < T by linarith
    have integral := rpowFunction.has_integral with positive, afterA,
      exponentNonzero
    rw riemannIntegral.eq_of_integral with integral
    have tPower := realRpow.real at T, R[1 - S]
    have tPowerPositive := realRpow.positive at T, R[1 - S]
    -- T^(1−σ) ≤ T₀^(1−σ) = c.
    have logOrder : realLog(realRpow(R[half(e) * (S - 1)],
        realInvValue(R[1 - S]))) ≤ realLog(T)
      have cases := realLess.trichotomy at
        realRpow(R[half(e) * (S - 1)], realInvValue(R[1 - S])), T
      rcases cases with below | same | above
      . have strict := realLog.strictly_increasing with startPositive, below
        exact realLess.implies_le with strict
      . rw same
        exact realLe.reflexive with *
      . exfalso
        linarith
    have logStartReal : Real(realLog(realRpow(R[half(e) * (S - 1)],
      realInvValue(R[1 - S])))) by typecheck
    have gapNonnegative : R[0] ≤ R[S - 1] by linarith
    have scaledLog := realLe.mul_left_of_nonnegative with logOrder,
      gapNonnegative
    have exponentOrder : R[(1 - S) * realLog(T)] ≤
        R[(1 - S) * realLog(realRpow(R[half(e) * (S - 1)],
          realInvValue(R[1 - S])))]
      have left : R[(1 - S) * realLog(T)] = R[-((S - 1) * realLog(T))] by ring
      have right : R[(1 - S) * realLog(realRpow(R[half(e) * (S - 1)],
          realInvValue(R[1 - S])))] =
        R[-((S - 1) * realLog(realRpow(R[half(e) * (S - 1)],
          realInvValue(R[1 - S]))))] by ring
      linarith
    have powerOrder := (realExp.le_iff at R[(1 - S) * realLog(T)],
      R[(1 - S) * realLog(realRpow(R[half(e) * (S - 1)],
        realInvValue(R[1 - S])))]).backward with exponentOrder
    have powerT : realRpow(T, R[1 - S]) = realExp(R[(1 - S) * realLog(T)])
      unfold realRpow
      rfl
    have powerStart : realRpow(realRpow(R[half(e) * (S - 1)],
        realInvValue(R[1 - S])), R[1 - S]) =
      realExp(R[(1 - S) * realLog(realRpow(R[half(e) * (S - 1)],
        realInvValue(R[1 - S])))])
      unfold realRpow
      rfl
    have expStart : Real(realExp(R[(1 - S) * realLog(realRpow(
      R[half(e) * (S - 1)], realInvValue(R[1 - S])))])) by typecheck
    have powerBound : realRpow(T, R[1 - S]) ≤ R[half(e) * (S - 1)]
      by linarith
    -- |K T^(1−σ)| = −K T^(1−σ) ≤ −K c = e/2.
    have kNonpositive : realInvValue(R[1 - S]) ≤ R[0] by linarith
    have powerNonnegative : R[0] ≤ realRpow(T, R[1 - S]) by linarith
    have productSign := realLe.mul_right_of_nonnegative with kNonpositive,
      powerNonnegative
    have negK : R[0] ≤ R[-realInvValue(R[1 - S])] by linarith
    have scaledBound := realLe.mul_left_of_nonnegative with powerBound, negK
    have shape : R[realInvValue(R[1 - S]) * realRpow(T, R[1 - S]) -
        realInvValue(R[1 - S]) * realRpow(A, R[1 - S]) -
        realRpow(A, R[1 - S]) / (S - 1)] =
      R[realInvValue(R[1 - S]) * realRpow(T, R[1 - S])]
      rw startValue
      ring
    have halfValue : R[-realInvValue(R[1 - S]) * (half(e) * (S - 1))] =
        half(e)
      have regroup : R[-realInvValue(R[1 - S]) * (half(e) * (S - 1))] =
        R[half(e) * ((1 - S) * realInvValue(R[1 - S]))] by ring
      rw [regroup, cancel]
      ring
    have zeroed : R[0 * realRpow(T, R[1 - S])] = R[0] by ring
    have productNonpositive :
      R[realInvValue(R[1 - S]) * realRpow(T, R[1 - S])] ≤ R[0] by linarith
    rw [shape, (abs.of_nonpositive with productNonpositive)]
    have negated : R[-(realInvValue(R[1 - S]) * realRpow(T, R[1 - S]))] =
      R[-realInvValue(R[1 - S]) * realRpow(T, R[1 - S])] by ring
    linarith

-- The integrals ∫_A^(A+n) h, n = 0, 1, 2, …
defgraph partialIntegrals (h : Set, A : Real) (n ∈ ℕ) : ℝ :=
    riemannIntegral(h, A, R[A + realNat(n)])
proof
  obtain ⟨value, _⟩ := riemannIntegral.selected at h, A, R[A + realNat(n)]
  exact value

-- The Cauchy criterion for improper integrals.
theorem HasImproperIntegral.of_cauchy (h : Set) (A : Real)
  requires function : FunctionBetween(h, ℝ, ℝ)
  requires local : ∀ T ∈ ℝ, A ≤ T → RiemannIntegrable(h, A, T)
  requires cauchy : ∀ e ∈ ℝ, R[0] < e → ∃ T0 ∈ ℝ, ∀ T ∈ ℝ, ∀ U ∈ ℝ,
    T0 ≤ T → A ≤ T → T0 ≤ U → A ≤ U →
      abs(R[riemannIntegral(h, A, T) - riemannIntegral(h, A, U)]) < e
  shows ∃ I ∈ ℝ, HasImproperIntegral(h, A, I)
proof
  have sequence : RealSequence(partialIntegrals(h, A))
    unfold RealSequence
    exact partialIntegrals.function
  -- Eventually A + n lies beyond any given point.
  have beyond : ∀ T0 ∈ ℝ, ∃ N ∈ ℕ, ∀ n ∈ ℕ, N ≤ n →
      T0 ≤ R[A + realNat(n)] ∧ A ≤ R[A + realNat(n)]
    intros T0 t0Member
    obtain ⟨N, typedN, above⟩ := Real.below_natural at R[T0 - A]
    have nMember : N ∈ ℕ by typecheck
    refine ⟨N, nMember, ?_⟩
    intros n naturalN later
    have typedn := nat.omega.backward with naturalN
    have monotone := realNat.monotone with later
    have nonnegative := realNat.nonnegative at n
    have realN := realNat.real at n
    constructor
    . linarith
    . linarith
  have converges : CauchySequence(partialIntegrals(h, A))
    refine ⟨sequence, ?_⟩
    intros e eMember ePositive
    obtain ⟨T0, t0Member, close⟩ := cauchy with e, eMember, ePositive
    obtain ⟨N, nMember, eventually⟩ := beyond with T0, t0Member
    refine ⟨N, nMember, ?_⟩
    intros m naturalM laterM n naturalN laterN
    have typedM := nat.omega.backward with naturalM
    have typedN := nat.omega.backward with naturalN
    obtain ⟨farM, afterM⟩ := eventually with m, naturalM, laterM
    obtain ⟨farN, afterN⟩ := eventually with n, naturalN, laterN
    have pointM : R[A + realNat(m)] ∈ ℝ by typecheck
    have pointN : R[A + realNat(n)] ∈ ℝ by typecheck
    have near := close with R[A + realNat(m)], pointM, R[A + realNat(n)], pointN,
      farM, afterM, farN, afterN
    rw [(partialIntegrals.value at h, A, m with naturalM),
      (partialIntegrals.value at h, A, n with naturalN)]
    obtain ⟨memberM, _⟩ := riemannIntegral.selected at h, A, R[A + realNat(m)]
    apply openBall.membership.backward
    refine ⟨memberM, ?_⟩
    unfold dist
    unfold realSubValue
    exact near
  obtain ⟨I, iMember, limit⟩ := CauchySequence.converges with converges
  refine ⟨I, iMember, function, local, ?_⟩
  intros e eMember ePositive
  have halfPositive := half.positive with ePositive
  have halfReal := half.real at e
  have halfMember : half(e) ∈ ℝ by exact halfReal
  have halves := half.add_self at e
  obtain ⟨T0, t0Member, close⟩ := cauchy with half(e), halfPositive
  obtain ⟨N0, n0Member, eventually⟩ := beyond with T0, t0Member
  obtain ⟨N1, n1Member, nearLimit⟩ := ConvergesTo.eventually with limit,
    halfPositive
  have typedN0 := nat.omega.backward with n0Member
  have typedN1 := nat.omega.backward with n1Member
  obtain ⟨n, naturalN, after0, after1⟩ := nat.common_upper at N0, N1
  have typedn := nat.omega.backward with naturalN
  obtain ⟨farN, afterN⟩ := eventually with n, naturalN, after0
  have ball := nearLimit with n, naturalN, after1
  obtain ⟨_, nearI⟩ := openBall.membership.forward with ball
  rw (partialIntegrals.value at h, A, n with naturalN) at nearI
  unfold dist at nearI
  unfold realSubValue at nearI
  refine ⟨T0, t0Member, ?_⟩
  intros T tMember later afterA
  have pointN : R[A + realNat(n)] ∈ ℝ by typecheck
  have near := close with T, tMember, R[A + realNat(n)], pointN, later, afterA,
    farN, afterN
  obtain ⟨memberT, _⟩ := riemannIntegral.selected at h, A, T
  obtain ⟨memberN, _⟩ := riemannIntegral.selected at h, A, R[A + realNat(n)]
  have triangle := abs.triangle at
    R[riemannIntegral(h, A, T) - riemannIntegral(h, A, R[A + realNat(n)])],
    R[riemannIntegral(h, A, R[A + realNat(n)]) - I]
  have shape : R[riemannIntegral(h, A, T) - I] =
    R[(riemannIntegral(h, A, T) - riemannIntegral(h, A, R[A + realNat(n)])) +
      (riemannIntegral(h, A, R[A + realNat(n)]) - I)] by ring
  rw shape
  linarith

-- |∫_T^U h| ≤ ∫_T^U G when |h| ≤ G on [T, U].
theorem riemannIntegral.abs_le (h G : Set) (T U : Real)
  requires integrableH : RiemannIntegrable(h, T, U)
  requires integrableG : RiemannIntegrable(G, T, U)
  requires bound : ∀ X ∈ closedInterval(T, U), abs(h(X)) ≤ G(X)
  shows abs(riemannIntegral(h, T, U)) ≤ riemannIntegral(G, T, U)
proof
  have integralH := riemannIntegral.integral with integrableH
  have integralG := riemannIntegral.integral with integrableG
  have functionH := HasRiemannIntegral.function with integralH
  have functionG := HasRiemannIntegral.function with integralG
  obtain ⟨memberH, _⟩ := riemannIntegral.selected at h, T, U
  obtain ⟨memberG, _⟩ := riemannIntegral.selected at G, T, U
  have functionNeg := realLinearCombination.function at R[-1], R[0], G, G
    with functionG, functionG
  have valuesNeg : ∀ X ∈ ℝ, realLinearCombination(R[-1], R[0], G, G)(X) =
      R[-1 * G(X) + 0 * G(X)]
    intros X xMember
    exact realLinearCombination.value with functionG, functionG, xMember
  have integralNeg := HasRiemannIntegral.linear with integralG, integralG,
    functionNeg, valuesNeg
  have upper : riemannIntegral(h, T, U) ≤ riemannIntegral(G, T, U)
    apply HasRiemannIntegral.mono with integralH, integralG
    intros X inside
    obtain ⟨xMember, _, _⟩ := closedInterval.membership.forward with inside
    have valueH := FunctionBetween.apply_closed with functionH, xMember
    have realX : Real(h(X)) by exact valueH
    have below := bound with X, inside
    have absUpper := abs.upper at h(X)
    linarith
  have lower : R[-1 * riemannIntegral(G, T, U) + 0 * riemannIntegral(G, T, U)]
      ≤ riemannIntegral(h, T, U)
    apply HasRiemannIntegral.mono with integralNeg, integralH
    intros X inside
    obtain ⟨xMember, _, _⟩ := closedInterval.membership.forward with inside
    have valueH := FunctionBetween.apply_closed with functionH, xMember
    have valueG := FunctionBetween.apply_closed with functionG, xMember
    have below := bound with X, inside
    have absLower := abs.upper_neg at h(X)
    rw (valuesNeg with X, xMember)
    have shape : R[-1 * G(X) + 0 * G(X)] = R[-G(X)] by ring
    rw shape
    linarith
  have shape : R[-1 * riemannIntegral(G, T, U) + 0 * riemannIntegral(G, T, U)]
    = R[-riemannIntegral(G, T, U)] by ring
  apply abs.le_of_bounds
  . linarith
  . exact upper

-- Domination for real functions: |h| ≤ G on [A, ∞) with ∫_A^∞ G convergent
-- gives ∫_A^∞ h convergent.
theorem HasImproperIntegral.of_dominated (h G : Set) (A : Real)
  requires function : FunctionBetween(h, ℝ, ℝ)
  requires local : ∀ T ∈ ℝ, A ≤ T → RiemannIntegrable(h, A, T)
  requires integrableG : ImproperIntegrable(G, A)
  requires bound : ∀ X ∈ ℝ, A ≤ X → abs(h(X)) ≤ G(X)
  shows ∃ I ∈ ℝ, HasImproperIntegral(h, A, I)
proof
  obtain ⟨J, jMember, functionG, localG, limitG⟩ := integrableG
  -- For A ≤ T ≤ U: |Φ(U) − Φ(T)| ≤ Ψ(U) − Ψ(T).
  have increment : ∀ T ∈ ℝ, ∀ U ∈ ℝ, A ≤ T → T ≤ U →
      abs(R[riemannIntegral(h, A, U) - riemannIntegral(h, A, T)]) ≤
        R[riemannIntegral(G, A, U) - riemannIntegral(G, A, T)]
    intros T tMember U uMember afterA ordered
    have tReal : Real(T) by exact tMember
    have uReal : Real(U) by exact uMember
    have afterAU : A ≤ U by linarith
    have integrableH := local with U, uMember, afterAU
    have integrableGU := localG with U, uMember, afterAU
    obtain ⟨hAT, hTU⟩ := RiemannIntegrable.restrict with integrableH, afterA,
      ordered
    obtain ⟨gAT, gTU⟩ := RiemannIntegrable.restrict with integrableGU, afterA,
      ordered
    have sumH := HasRiemannIntegral.adjacent_sum with
      (riemannIntegral.integral with hAT), (riemannIntegral.integral with hTU),
      (riemannIntegral.integral with integrableH)
    have sumG := HasRiemannIntegral.adjacent_sum with
      (riemannIntegral.integral with gAT), (riemannIntegral.integral with gTU),
      (riemannIntegral.integral with integrableGU)
    have boundTU : ∀ X ∈ closedInterval(T, U), abs(h(X)) ≤ G(X)
      intros X inside
      obtain ⟨xMember, lower, _⟩ := closedInterval.membership.forward with
        inside
      have afterAX : A ≤ X by linarith
      exact bound with X, xMember, afterAX
    have piece := riemannIntegral.abs_le with hTU, gTU, boundTU
    obtain ⟨memberAT, _⟩ := riemannIntegral.selected at h, A, T
    obtain ⟨memberTU, _⟩ := riemannIntegral.selected at h, T, U
    obtain ⟨memberGAT, _⟩ := riemannIntegral.selected at G, A, T
    obtain ⟨memberGTU, _⟩ := riemannIntegral.selected at G, T, U
    rw [sumH, sumG]
    have shapeH : R[riemannIntegral(h, A, T) + riemannIntegral(h, T, U) -
      riemannIntegral(h, A, T)] = riemannIntegral(h, T, U) by ring
    have shapeG : R[riemannIntegral(G, A, T) + riemannIntegral(G, T, U) -
      riemannIntegral(G, A, T)] = riemannIntegral(G, T, U) by ring
    rwa [shapeH, shapeG]
  apply HasImproperIntegral.of_cauchy with function, local
  intros e eMember ePositive
  have halfPositive := half.positive with ePositive
  have halfReal := half.real at e
  have halfMember : half(e) ∈ ℝ by exact halfReal
  have halves := half.add_self at e
  obtain ⟨T0, t0Member, nearG⟩ := limitG with half(e), halfPositive
  refine ⟨T0, t0Member, ?_⟩
  intros T tMember U uMember laterT afterT laterU afterU
  have closeT := nearG with T, tMember, laterT, afterT
  have closeU := nearG with U, uMember, laterU, afterU
  obtain ⟨memberT, _⟩ := riemannIntegral.selected at G, A, T
  obtain ⟨memberU, _⟩ := riemannIntegral.selected at G, A, U
  obtain ⟨memberHT, _⟩ := riemannIntegral.selected at h, A, T
  obtain ⟨memberHU, _⟩ := riemannIntegral.selected at h, A, U
  have upperT := abs.upper at R[riemannIntegral(G, A, T) - J]
  have lowerT := abs.upper_neg at R[riemannIntegral(G, A, T) - J]
  have upperU := abs.upper at R[riemannIntegral(G, A, U) - J]
  have lowerU := abs.upper_neg at R[riemannIntegral(G, A, U) - J]
  by_cases ordered : T ≤ U
  . have step := increment with T, tMember, U, uMember, afterT, ordered
    have negated := abs.neg at
      R[riemannIntegral(h, A, U) - riemannIntegral(h, A, T)]
    have shape : R[riemannIntegral(h, A, T) - riemannIntegral(h, A, U)] =
      R[-(riemannIntegral(h, A, U) - riemannIntegral(h, A, T))] by ring
    rw shape
    linarith
  . have reversed : U ≤ T
      obtain below | same | above := realLess.trichotomy at T, U
      . exfalso
        exact ordered with (realLess.implies_le with below)
      . rw same
        exact realLe.reflexive with *
      . exact realLess.implies_le with above
    have step := increment with U, uMember, T, tMember, afterU, reversed
    linarith

-- Improper integrals are linear.
theorem HasImproperIntegral.linear (h f g : Set) (A I J a b : Real)
  requires integralF : HasImproperIntegral(f, A, I)
  requires integralG : HasImproperIntegral(g, A, J)
  requires functionH : FunctionBetween(h, ℝ, ℝ)
  requires values : ∀ X ∈ ℝ, h(X) = R[a * f(X) + b * g(X)]
  shows HasImproperIntegral(h, A, R[a * I + b * J])
proof
  obtain ⟨_, localF, limitF⟩ := integralF
  obtain ⟨_, localG, limitG⟩ := integralG
  refine ⟨functionH, ?_, ?_⟩
  . intros T tMember later
    obtain ⟨integrable, _⟩ := riemannIntegral.linear with
      (localF with T, tMember, later), (localG with T, tMember, later),
      functionH, values
    exact integrable
  . intros E eMember positive
    have nonnegativeA := abs.nonnegative at a
    have nonnegativeB := abs.nonnegative at b
    have scalePositive : R[0] < R[abs(a) + abs(b) + 1] by linarith
    have radiusReal := scaledRadius.real at E, R[abs(a) + abs(b) + 1]
    have radiusMember : scaledRadius(E, R[abs(a) + abs(b) + 1]) ∈ ℝ
      by exact radiusReal
    have radiusPositive := scaledRadius.positive with positive, scalePositive
    have cancel := scaledRadius.cancel at E, R[abs(a) + abs(b) + 1]
      with scalePositive
    have halfLess := half.lt_self with positive
    obtain ⟨T1, t1Member, nearF⟩ := limitF with
      scaledRadius(E, R[abs(a) + abs(b) + 1]), radiusMember, radiusPositive
    obtain ⟨T2, t2Member, nearG⟩ := limitG with
      scaledRadius(E, R[abs(a) + abs(b) + 1]), radiusMember, radiusPositive
    obtain ⟨T0, t0Member, above1, above2⟩ := real.exists_upper at T1, T2
    refine ⟨T0, t0Member, ?_⟩
    intros T tMember later afterA
    have later1 : T1 ≤ T by linarith
    have later2 : T2 ≤ T by linarith
    have closeF := nearF with T, tMember, later1, afterA
    have closeG := nearG with T, tMember, later2, afterA
    obtain ⟨_, value⟩ := riemannIntegral.linear with
      (localF with T, tMember, afterA), (localG with T, tMember, afterA),
      functionH, values
    obtain ⟨memberF, _⟩ := riemannIntegral.selected at f, A, T
    obtain ⟨memberG, _⟩ := riemannIntegral.selected at g, A, T
    have smallF := realLess.implies_le with closeF
    have smallG := realLess.implies_le with closeG
    have combined := abs.linear_le at a, b,
      R[riemannIntegral(f, A, T) - I], R[riemannIntegral(g, A, T) - J],
      scaledRadius(E, R[abs(a) + abs(b) + 1]) with smallF, smallG
    have shape : R[riemannIntegral(h, A, T) - (a * I + b * J)] =
        R[a * (riemannIntegral(f, A, T) - I) + b * (riemannIntegral(g, A, T) - J)]
      rw value
      ring
    have expand : R[(abs(a) + abs(b) + 1) *
        scaledRadius(E, R[abs(a) + abs(b) + 1])] =
      R[(abs(a) + abs(b)) * scaledRadius(E, R[abs(a) + abs(b) + 1]) +
        scaledRadius(E, R[abs(a) + abs(b) + 1])] by ring
    rw shape
    linarith

theorem real.le_of_forall_lt (X Y : Real)
  requires near : ∀ e ∈ ℝ, R[0] < e → X < R[Y + e]
  shows X ≤ Y
proof
  obtain below | same | above := realLess.trichotomy at X, Y
  . exact realLess.implies_le with below
  . rw same
    exact realLe.reflexive with *
  . exfalso
    have gap : R[0] < R[X - Y] by linarith
    have halfPositive := half.positive with gap
    have halfReal := half.real at R[X - Y]
    have halfMember : half(R[X - Y]) ∈ ℝ by exact halfReal
    have halves := half.add_self at R[X - Y]
    have close := near with half(R[X - Y]), halfPositive
    linarith

-- The parts of the pair (a, b).
theorem complex.pair_parts (a b : Real)
  shows complexRe((a, b)) = a ∧ complexIm((a, b)) = b
proof
  constructor
  . unfold complexRe
    rw fst.pair
  . unfold complexIm
    rw snd.pair

-- Domination: if g is integrable on every [A, T] and |g| ≤ G on [A, ∞)
-- with ∫_A^∞ G convergent, then ∫_A^∞ g converges and
-- |∫_A^∞ g| ≤ ∫_A^∞ G.
theorem ComplexImproperIntegrable.of_dominated (g G : Set) (A : Real)
  requires local : ∀ T ∈ ℝ, A ≤ T → ComplexRiemannIntegrable(g, A, T)
  requires integrableG : ImproperIntegrable(G, A)
  requires bound : ∀ X ∈ ℝ, A ≤ X → complexAbs(g(X)) ≤ G(X)
  shows ComplexImproperIntegrable(g, A) ∧
    complexAbs(complexImproperIntegral(g, A)) ≤ improperIntegral(G, A)
proof
  have integrableCopy : ImproperIntegrable(G, A) by exact integrableG
  obtain ⟨J, jMember, integralG⟩ := integrableCopy
  have integralGCopy : HasImproperIntegral(G, A, J) by exact integralG
  obtain ⟨functionG, localG, limitG⟩ := integralGCopy
  have aMember : A ∈ ℝ by typecheck
  have reflexive : A ≤ A := realLe.reflexive
  obtain ⟨values, _, _⟩ := local with A, reflexive
  have functionRe := complexFunctionRe.function with values
  have functionIm := complexFunctionIm.function with values
  have localRe : ∀ T ∈ ℝ, A ≤ T → RiemannIntegrable(complexFunctionRe(g), A, T)
    intros T tMember later
    obtain ⟨_, integrable, _⟩ := local with T, tMember, later
    exact integrable
  have localIm : ∀ T ∈ ℝ, A ≤ T → RiemannIntegrable(complexFunctionIm(g), A, T)
    intros T tMember later
    obtain ⟨_, _, integrable⟩ := local with T, tMember, later
    exact integrable
  have boundRe : ∀ X ∈ ℝ, A ≤ X → abs(complexFunctionRe(g)(X)) ≤ G(X)
    intros X xMember later
    have xReal : Real(X) by exact xMember
    have gX := values with X, xMember
    have reLe := complexAbs.re_le with gX
    have below := bound with X, xMember, later
    rw (complexFunctionRe.apply with values)
    linarith
  have boundIm : ∀ X ∈ ℝ, A ≤ X → abs(complexFunctionIm(g)(X)) ≤ G(X)
    intros X xMember later
    have gX := values with X, xMember
    have imLe := complexAbs.im_le with gX
    have below := bound with X, xMember, later
    rw (complexFunctionIm.apply with values)
    linarith
  obtain ⟨I1, i1Member, integral1⟩ := HasImproperIntegral.of_dominated with
    functionRe, localRe, integrableG, boundRe
  obtain ⟨I2, i2Member, integral2⟩ := HasImproperIntegral.of_dominated with
    functionIm, localIm, integrableG, boundIm
  obtain ⟨_, _, limit1⟩ := integral1
  obtain ⟨_, _, limit2⟩ := integral2
  have member := complexCarrier.pair at I1, I2
  obtain ⟨reL, imL⟩ := complex.pair_parts at I1, I2
  have integral : HasComplexImproperIntegral(g, A, (I1, I2))
    refine ⟨values, member, local, ?_⟩
    intros e eMember ePositive
    have eReal : Real(e) by exact eMember
    have halfPositive := half.positive with ePositive
    have halfReal := half.real at e
    have halfMember : half(e) ∈ ℝ by exact halfReal
    have halves := half.add_self at e
    obtain ⟨T1, t1Member, near1⟩ := limit1 with half(e), halfMember,
      halfPositive
    obtain ⟨T2, t2Member, near2⟩ := limit2 with half(e), halfMember,
      halfPositive
    obtain ⟨T0, t0Member, above1, above2⟩ := real.exists_upper at T1, T2
    refine ⟨T0, t0Member, ?_⟩
    intros T tMember later afterA
    have tReal : Real(T) by exact tMember
    have later1 : T1 ≤ T by linarith
    have later2 : T2 ≤ T by linarith
    have close1 := near1 with T, tMember, later1, afterA
    have close2 := near2 with T, tMember, later2, afterA
    have memberT := complexIntegral.member at g, A, T
    have difference : ℂ[complexIntegral(g, A, T) - (I1, I2)] ∈ ℂ by typecheck
    have recombined : complexIntegral(g, A, T) =
      ℂ[(complexIntegral(g, A, T) - (I1, I2)) + (I1, I2)] by ring
    have reSum := complexRe.add with difference, member
    have imSum := complexIm.add with difference, member
    rw ← recombined at reSum
    rw ← recombined at imSum
    rw [complexIntegral.re, reL] at reSum
    rw [complexIntegral.im, imL] at imSum
    have reShape : complexRe(ℂ[complexIntegral(g, A, T) - (I1, I2)]) =
      R[riemannIntegral(complexFunctionRe(g), A, T) - I1] by linarith
    have imShape : complexIm(ℂ[complexIntegral(g, A, T) - (I1, I2)]) =
      R[riemannIntegral(complexFunctionIm(g), A, T) - I2] by linarith
    have parts := complexAbs.le_parts with difference
    rw [reShape, imShape] at parts
    linarith
  have integrable : ComplexImproperIntegrable(g, A) :=
    ⟨(I1, I2), member, integral⟩
  refine ⟨integrable, ?_⟩
  rw [(complexImproperIntegral.eq with integral),
    (improperIntegral.eq with integralG)]
  have integralCopy : HasComplexImproperIntegral(g, A, (I1, I2))
    by exact integral
  obtain ⟨_, _, _, limitL⟩ := integralCopy
  apply real.le_of_forall_lt
  intros e eMember ePositive
  have halfPositive := half.positive with ePositive
  have halfReal := half.real at e
  have halfMember : half(e) ∈ ℝ by exact halfReal
  have halves := half.add_self at e
  obtain ⟨T1, t1Member, nearL⟩ := limitL with half(e), halfMember,
    halfPositive
  obtain ⟨T2, t2Member, nearG⟩ := limitG with half(e), halfMember,
    halfPositive
  obtain ⟨T3, t3Member, above1, above2⟩ := real.exists_upper at T1, T2
  obtain ⟨T, tMember, above3, afterA⟩ := real.exists_upper at T3, A
  have later1 : T1 ≤ T by linarith
  have later2 : T2 ≤ T by linarith
  have closeL := nearL with T, tMember, later1, afterA
  have closeG := nearG with T, tMember, later2, afterA
  have boundAT : ∀ X ∈ closedInterval(A, T), complexAbs(g(X)) ≤ G(X)
    intros X inside
    obtain ⟨xMember, lower, _⟩ := closedInterval.membership.forward with inside
    exact bound with X, xMember, lower
  have modulus := complexIntegral.abs_le with afterA,
    (local with T, tMember, afterA), (localG with T, tMember, afterA), boundAT
  have memberT := complexIntegral.member at g, A, T
  have difference : ℂ[complexIntegral(g, A, T) - (I1, I2)] ∈ ℂ by typecheck
  have split : (I1, I2) =
    ℂ[-(complexIntegral(g, A, T) - (I1, I2)) + complexIntegral(g, A, T)]
    by ring
  have negativeMember : ℂ[-(complexIntegral(g, A, T) - (I1, I2))] ∈ ℂ
    by typecheck
  have triangle := complexAbs.triangle with negativeMember, memberT
  rw ← split at triangle
  have negated := complexAbs.neg with difference
  obtain ⟨memberGT, _⟩ := riemannIntegral.selected at G, A, T
  have upperG := abs.upper at R[riemannIntegral(G, A, T) - J]
  linarith

-- The comparison test with x^(−σ), σ > 1: |g(x)| ≤ C x^(−σ) on [A, ∞),
-- A > 0, gives convergence and |∫_A^∞ g| ≤ C A^(1−σ)/(σ − 1).
theorem ComplexImproperIntegrable.of_rpow_bound (g : Set) (A S C : Real)
  requires positive : R[0] < A
  requires exponent : R[1] < S
  requires local : ∀ T ∈ ℝ, A ≤ T → ComplexRiemannIntegrable(g, A, T)
  requires bound : ∀ X ∈ ℝ, A ≤ X →
    complexAbs(g(X)) ≤ R[C * realRpow(X, R[-S])]
  shows ComplexImproperIntegrable(g, A) ∧
    complexAbs(complexImproperIntegral(g, A)) ≤
      R[C * (realRpow(A, R[1 - S]) / (S - 1))]
proof
  have integral := rpowFunction.improper_integral with positive, exponent
  have functionR := rpowFunction.function at R[-S]
  have functionG := realLinearCombination.function at C, R[0],
    rpowFunction(R[-S]), rpowFunction(R[-S]) with functionR, functionR
  have valuesG : ∀ X ∈ ℝ, realLinearCombination(C, R[0], rpowFunction(R[-S]),
      rpowFunction(R[-S]))(X) =
      R[C * rpowFunction(R[-S])(X) + 0 * rpowFunction(R[-S])(X)]
    intros X xMember
    exact realLinearCombination.value with functionR, functionR, xMember
  have integralG := HasImproperIntegral.linear with integral, integral,
    functionG, valuesG
  have gapNonzero : R[S - 1] ≠ R[0]
    intro zero
    linarith
  have valueMember : R[C * (realRpow(A, R[1 - S]) / (S - 1)) +
    0 * (realRpow(A, R[1 - S]) / (S - 1))] ∈ ℝ by typecheck
  have integrableG : ImproperIntegrable(realLinearCombination(C, R[0],
      rpowFunction(R[-S]), rpowFunction(R[-S])), A) :=
    ⟨R[C * (realRpow(A, R[1 - S]) / (S - 1)) +
      0 * (realRpow(A, R[1 - S]) / (S - 1))], valueMember, integralG⟩
  have boundG : ∀ X ∈ ℝ, A ≤ X → complexAbs(g(X)) ≤
      realLinearCombination(C, R[0], rpowFunction(R[-S]),
        rpowFunction(R[-S]))(X)
    intros X xMember later
    have powerReal := realRpow.real at X, R[-S]
    have below := bound with X, xMember, later
    rw [(valuesG with X, xMember), rpowFunction.value]
    have shape : R[C * realRpow(X, R[-S]) + 0 * realRpow(X, R[-S])] =
      R[C * realRpow(X, R[-S])] by ring
    rwa shape
  obtain ⟨integrable, modulus⟩ := ComplexImproperIntegrable.of_dominated with
    local, integrableG, boundG
  refine ⟨integrable, ?_⟩
  rw (improperIntegral.eq with integralG) at modulus
  have shape : R[C * (realRpow(A, R[1 - S]) / (S - 1)) +
      0 * (realRpow(A, R[1 - S]) / (S - 1))] =
    R[C * (realRpow(A, R[1 - S]) / (S - 1))] by ring
  rwa shape at modulus

theorem complexImproperIntegral.add (f g : Set) (A : Real)
  requires integrableF : ComplexImproperIntegrable(f, A)
  requires integrableG : ComplexImproperIntegrable(g, A)
  shows ComplexImproperIntegrable(complexFunctionAdd(f, g, ℝ), A) ∧
    complexImproperIntegral(complexFunctionAdd(f, g, ℝ), A) =
      ℂ[complexImproperIntegral(f, A) + complexImproperIntegral(g, A)]
proof
  have specF := complexImproperIntegral.spec with integrableF
  have specG := complexImproperIntegral.spec with integrableG
  have memberI := complexImproperIntegral.member at f, A
  have memberJ := complexImproperIntegral.member at g, A
  obtain ⟨valuesF, _, localF, limitF⟩ := specF
  obtain ⟨valuesG, _, localG, limitG⟩ := specG
  have functionH := complexFunctionAdd.function with valuesF, valuesG
  have valuesH : ComplexValuedOn(complexFunctionAdd(f, g, ℝ), ℝ)
    intros X xMember
    exact FunctionBetween.apply_closed with functionH, xMember
  have memberSum : ℂ[complexImproperIntegral(f, A) +
    complexImproperIntegral(g, A)] ∈ ℂ by typecheck
  have integral : HasComplexImproperIntegral(complexFunctionAdd(f, g, ℝ), A,
      ℂ[complexImproperIntegral(f, A) + complexImproperIntegral(g, A)])
    refine ⟨valuesH, memberSum, ?_, ?_⟩
    . intros T tMember later
      obtain ⟨integrable, _⟩ := complexIntegral.add with later,
        (localF with T, tMember, later), (localG with T, tMember, later)
      exact integrable
    . intros e eMember ePositive
      have halfPositive := half.positive with ePositive
      have halfReal := half.real at e
      have halfMember : half(e) ∈ ℝ by exact halfReal
      have halves := half.add_self at e
      obtain ⟨T1, t1Real, nearF⟩ := limitF with half(e), halfMember,
        halfPositive
      obtain ⟨T2, t2Real, nearG⟩ := limitG with half(e), halfMember,
        halfPositive
      obtain ⟨T0, t0Real, above1, above2⟩ := real.exists_upper at T1, T2
      refine ⟨T0, t0Real, ?_⟩
      intros T tMember later afterA
      have later1 : T1 ≤ T by linarith
      have later2 : T2 ≤ T by linarith
      have closeF := nearF with T, tMember, later1, afterA
      have closeG := nearG with T, tMember, later2, afterA
      obtain ⟨_, sum⟩ := complexIntegral.add with afterA,
        (localF with T, tMember, afterA), (localG with T, tMember, afterA)
      have memberFT := complexIntegral.member at f, A, T
      have memberGT := complexIntegral.member at g, A, T
      have shape : ℂ[complexIntegral(complexFunctionAdd(f, g, ℝ), A, T) -
          (complexImproperIntegral(f, A) + complexImproperIntegral(g, A))] =
        ℂ[(complexIntegral(f, A, T) - complexImproperIntegral(f, A)) +
          (complexIntegral(g, A, T) - complexImproperIntegral(g, A))]
        rw sum
        ring
      have triangle := complexAbs.triangle at
        ℂ[complexIntegral(f, A, T) - complexImproperIntegral(f, A)],
        ℂ[complexIntegral(g, A, T) - complexImproperIntegral(g, A)] with *
      rw shape
      linarith
  have integrable : ComplexImproperIntegrable(complexFunctionAdd(f, g, ℝ), A) :=
    ⟨ℂ[complexImproperIntegral(f, A) + complexImproperIntegral(g, A)],
      memberSum, integral⟩
  refine ⟨integrable, ?_⟩
  exact complexImproperIntegral.eq with integral

theorem complexImproperIntegral.const_mul (c g : Set) (A : Real)
  requires hc : c ∈ ℂ
  requires integrable : ComplexImproperIntegrable(g, A)
  shows ComplexImproperIntegrable(
      complexFunctionMul(complexFunctionConst(c, ℝ), g, ℝ), A) ∧
    complexImproperIntegral(
      complexFunctionMul(complexFunctionConst(c, ℝ), g, ℝ), A) =
      ℂ[c * complexImproperIntegral(g, A)]
proof
  have spec := complexImproperIntegral.spec with integrable
  have memberI := complexImproperIntegral.member at g, A
  obtain ⟨valuesG, _, localG, limitG⟩ := spec
  have constant := complexFunctionConst.function at c, ℝ with hc
  have valuesC : ComplexValuedOn(complexFunctionConst(c, ℝ), ℝ)
    intros X xMember
    exact FunctionBetween.apply_closed with constant, xMember
  have functionH := complexFunctionMul.function with valuesC, valuesG
  have valuesH : ComplexValuedOn(
      complexFunctionMul(complexFunctionConst(c, ℝ), g, ℝ), ℝ)
    intros X xMember
    exact FunctionBetween.apply_closed with functionH, xMember
  have memberProduct : ℂ[c * complexImproperIntegral(g, A)] ∈ ℂ by typecheck
  have integral : HasComplexImproperIntegral(
      complexFunctionMul(complexFunctionConst(c, ℝ), g, ℝ), A,
      ℂ[c * complexImproperIntegral(g, A)])
    refine ⟨valuesH, memberProduct, ?_, ?_⟩
    . intros T tMember later
      obtain ⟨integrableH, _⟩ := complexIntegral.const_mul with hc, later,
        (localG with T, tMember, later)
      exact integrableH
    . intros e eMember ePositive
      have absC := complexAbs.nonnegative with hc
      have scalePositive : R[0] < R[complexAbs(c) + 1] by linarith
      have radiusReal := scaledRadius.real at e, R[complexAbs(c) + 1]
      have radiusMember : scaledRadius(e, R[complexAbs(c) + 1]) ∈ ℝ
        by exact radiusReal
      have radiusPositive := scaledRadius.positive with ePositive,
        scalePositive
      have cancel := scaledRadius.cancel at e, R[complexAbs(c) + 1]
        with scalePositive
      have halfLess := half.lt_self with ePositive
      obtain ⟨T0, t0Real, nearG⟩ := limitG with
        scaledRadius(e, R[complexAbs(c) + 1]), radiusMember, radiusPositive
      refine ⟨T0, t0Real, ?_⟩
      intros T tMember later afterA
      have closeG := nearG with T, tMember, later, afterA
      obtain ⟨_, product⟩ := complexIntegral.const_mul with hc, afterA,
        (localG with T, tMember, afterA)
      have memberGT := complexIntegral.member at g, A, T
      have differenceMember : ℂ[complexIntegral(g, A, T) -
        complexImproperIntegral(g, A)] ∈ ℂ by typecheck
      have shape : ℂ[complexIntegral(
          complexFunctionMul(complexFunctionConst(c, ℝ), g, ℝ), A, T) -
          c * complexImproperIntegral(g, A)] =
        ℂ[c * (complexIntegral(g, A, T) - complexImproperIntegral(g, A))]
        rw product
        ring
      have absProduct := complexAbs.mul with hc, differenceMember
      have differenceNonnegative := complexAbs.nonnegative with
        differenceMember
      have differenceReal : complexAbs(ℂ[complexIntegral(g, A, T) -
        complexImproperIntegral(g, A)]) ∈ ℝ by typecheck
      have closeLe := realLess.implies_le with closeG
      have scaled := realLe.mul_left_of_nonnegative with closeLe, absC
      have expand : R[(complexAbs(c) + 1) *
          scaledRadius(e, R[complexAbs(c) + 1])] =
        R[complexAbs(c) * scaledRadius(e, R[complexAbs(c) + 1]) +
          scaledRadius(e, R[complexAbs(c) + 1])] by ring
      rw [shape, absProduct]
      linarith
  have integrableH : ComplexImproperIntegrable(
      complexFunctionMul(complexFunctionConst(c, ℝ), g, ℝ), A) :=
    ⟨ℂ[c * complexImproperIntegral(g, A)], memberProduct, integral⟩
  refine ⟨integrableH, ?_⟩
  exact complexImproperIntegral.eq with integral

-- Integrable on [A, B] and on [B, C] gives integrable on [A, C].
theorem RiemannIntegrable.adjacent (f : Set) (A B C : Real)
  requires left : RiemannIntegrable(f, A, B)
  requires right : RiemannIntegrable(f, B, C)
  shows RiemannIntegrable(f, A, C)
proof
  obtain ⟨M1, m1Member, bound1⟩ := RiemannIntegrable.bounded with left
  obtain ⟨M2, m2Member, bound2⟩ := RiemannIntegrable.bounded with right
  have upper1 := abs.upper at M1
  have upper2 := abs.upper at M2
  have nonnegative1 := abs.nonnegative at M1
  have nonnegative2 := abs.nonnegative at M2
  have bounded : ∀ X ∈ closedInterval(A, C), abs(f(X)) ≤ R[abs(M1) + abs(M2)]
    intros X inside
    obtain ⟨xMember, lower, upper⟩ := closedInterval.membership.forward with
      inside
    obtain ⟨I, _, integral⟩ := left
    have function := HasRiemannIntegral.function with integral
    have valueX := FunctionBetween.apply_closed with function, xMember
    by_cases before : X ≤ B
    . have insideLeft : X ∈ closedInterval(A, B)
        exact closedInterval.membership.backward with ⟨xMember, lower, before⟩
      have value := bound1 with X, insideLeft
      linarith
    . have after : B ≤ X
        obtain below | same | above := realLess.trichotomy at X, B
        . exfalso
          exact before with (realLess.implies_le with below)
        . rw same
          exact realLe.reflexive with *
        . exact realLess.implies_le with above
      have insideRight : X ∈ closedInterval(B, C)
        exact closedInterval.membership.backward with ⟨xMember, after, upper⟩
      have value := bound2 with X, insideRight
      linarith
  exact RiemannIntegrable.add_adjacent with left, right, bounded

theorem ComplexRiemannIntegrable.adjacent (g : Set) (A B C : Real)
  requires left : ComplexRiemannIntegrable(g, A, B)
  requires right : ComplexRiemannIntegrable(g, B, C)
  shows ComplexRiemannIntegrable(g, A, C)
proof
  obtain ⟨values, reLeft, imLeft⟩ := left
  obtain ⟨_, reRight, imRight⟩ := right
  refine ⟨values, ?_, ?_⟩
  . exact RiemannIntegrable.adjacent with reLeft, reRight
  . exact RiemannIntegrable.adjacent with imLeft, imRight

-- An improper integral from A is one from B ≥ A, less ∫_A^B.
theorem HasComplexImproperIntegral.later (g : Set) (A B : Real) (I : Set)
  requires integral : HasComplexImproperIntegral(g, A, I)
  requires ordered : A ≤ B
  shows HasComplexImproperIntegral(g, B, ℂ[I - complexIntegral(g, A, B)])
proof
  obtain ⟨values, memberI, local, limit⟩ := integral
  have memberAB := complexIntegral.member at g, A, B
  have difference : ℂ[I - complexIntegral(g, A, B)] ∈ ℂ by typecheck
  refine ⟨values, difference, ?_, ?_⟩
  . intros T tMember later
    have tReal : Real(T) by exact tMember
    have afterA : A ≤ T by linarith
    obtain ⟨_, restricted, _⟩ := complexIntegral.add_interval with ordered,
      later, (local with T, tMember, afterA)
    exact restricted
  . intros e eMember ePositive
    obtain ⟨T0, t0Real, near⟩ := limit with e, eMember, ePositive
    refine ⟨T0, t0Real, ?_⟩
    intros T tMember later afterB
    have afterA : A ≤ T by linarith
    obtain ⟨_, _, sum⟩ := complexIntegral.add_interval with ordered, afterB,
      (local with T, tMember, afterA)
    have memberBT := complexIntegral.member at g, B, T
    have shape : ℂ[complexIntegral(g, B, T) - (I - complexIntegral(g, A, B))] =
        ℂ[complexIntegral(g, A, T) - I]
      rw ← sum
      ring
    rw shape
    exact near with T, tMember, later, afterA

-- An improper integral from B gives one from A ≤ B, plus ∫_A^B.
theorem HasComplexImproperIntegral.earlier (g : Set) (A B : Real) (J : Set)
  requires integral : HasComplexImproperIntegral(g, B, J)
  requires ordered : A ≤ B
  requires local : ComplexRiemannIntegrable(g, A, B)
  shows HasComplexImproperIntegral(g, A, ℂ[complexIntegral(g, A, B) + J])
proof
  obtain ⟨values, memberJ, localB, limit⟩ := integral
  have memberAB := complexIntegral.member at g, A, B
  have sumMember : ℂ[complexIntegral(g, A, B) + J] ∈ ℂ by typecheck
  have integrableA : ∀ T ∈ ℝ, A ≤ T → ComplexRiemannIntegrable(g, A, T)
    intros T tMember afterA
    have tReal : Real(T) by exact tMember
    by_cases before : T ≤ B
    . obtain ⟨restricted, _, _⟩ := complexIntegral.add_interval with afterA,
        before, local
      exact restricted
    . have afterB : B ≤ T
        obtain below | same | above := realLess.trichotomy at T, B
        . exfalso
          exact before with (realLess.implies_le with below)
        . rw same
          exact realLe.reflexive with *
        . exact realLess.implies_le with above
      exact ComplexRiemannIntegrable.adjacent with local,
        (localB with T, tMember, afterB)
  refine ⟨values, sumMember, integrableA, ?_⟩
  intros e eMember ePositive
  obtain ⟨T1, t1Real, near⟩ := limit with e, eMember, ePositive
  obtain ⟨T0, t0Real, above1, aboveB⟩ := real.exists_upper at T1, B
  refine ⟨T0, t0Real, ?_⟩
  intros T tMember later afterA
  have afterB : B ≤ T by linarith
  have later1 : T1 ≤ T by linarith
  obtain ⟨_, _, sum⟩ := complexIntegral.add_interval with ordered, afterB,
    (integrableA with T, tMember, afterA)
  have memberBT := complexIntegral.member at g, B, T
  have shape : ℂ[complexIntegral(g, A, T) - (complexIntegral(g, A, B) + J)] =
      ℂ[complexIntegral(g, B, T) - J]
    rw ← sum
    ring
  rw shape
  exact near with T, tMember, later1, afterB

-- ∫_A^∞ g = ∫_A^B g + ∫_B^∞ g, and convergence from A and from B are the
-- same for g integrable on [A, B].
theorem complexImproperIntegral.split (g : Set) (A B : Real)
  requires ordered : A ≤ B
  requires local : ComplexRiemannIntegrable(g, A, B)
  shows (ComplexImproperIntegrable(g, A) ↔
      ComplexImproperIntegrable(g, B)) ∧
    (ComplexImproperIntegrable(g, B) →
      complexImproperIntegral(g, A) =
        ℂ[complexIntegral(g, A, B) + complexImproperIntegral(g, B)])
proof
  have fromB : ComplexImproperIntegrable(g, B) →
      HasComplexImproperIntegral(g, A,
        ℂ[complexIntegral(g, A, B) + complexImproperIntegral(g, B)])
    intro integrableB
    have spec := complexImproperIntegral.spec with integrableB
    exact HasComplexImproperIntegral.earlier with spec, ordered, local
  refine ⟨?_, ?_⟩
  . constructor
    . intro integrableA
      have spec := complexImproperIntegral.spec with integrableA
      have integral := HasComplexImproperIntegral.later with spec, ordered
      have memberI := complexImproperIntegral.member at g, A
      have memberAB := complexIntegral.member at g, A, B
      have difference : ℂ[complexImproperIntegral(g, A) -
        complexIntegral(g, A, B)] ∈ ℂ by typecheck
      exact ⟨ℂ[complexImproperIntegral(g, A) - complexIntegral(g, A, B)],
        difference, integral⟩
    . intro integrableB
      have integral := fromB with integrableB
      have memberJ := complexImproperIntegral.member at g, B
      have memberAB := complexIntegral.member at g, A, B
      have sumMember : ℂ[complexIntegral(g, A, B) +
        complexImproperIntegral(g, B)] ∈ ℂ by typecheck
      exact ⟨ℂ[complexIntegral(g, A, B) + complexImproperIntegral(g, B)],
        sumMember, integral⟩
  . intro integrableB
    exact complexImproperIntegral.eq with (fromB with integrableB)

-- The tail tends to 0: ∫_T^∞ g → 0 as T → ∞.
theorem complexImproperIntegral.tail (g : Set) (A : Real)
  requires integrable : ComplexImproperIntegrable(g, A)
  shows ∀ e ∈ ℝ, R[0] < e → ∃ T₀ ∈ ℝ, ∀ T ∈ ℝ, T₀ ≤ T → A ≤ T →
    complexAbs(complexImproperIntegral(g, T)) < e
proof
  have spec := complexImproperIntegral.spec with integrable
  have specCopy : HasComplexImproperIntegral(g, A, complexImproperIntegral(g, A))
    by exact spec
  obtain ⟨_, memberI, _, limit⟩ := specCopy
  intros e eMember ePositive
  obtain ⟨T0, t0Real, near⟩ := limit with e, eMember, ePositive
  refine ⟨T0, t0Real, ?_⟩
  intros T tMember later afterA
  have tail := HasComplexImproperIntegral.later with spec, afterA
  rw complexImproperIntegral.eq with tail
  have memberAT := complexIntegral.member at g, A, T
  have differenceMember : ℂ[complexIntegral(g, A, T) -
    complexImproperIntegral(g, A)] ∈ ℂ by typecheck
  have shape : ℂ[complexImproperIntegral(g, A) - complexIntegral(g, A, T)] =
      ℂ[-(complexIntegral(g, A, T) - complexImproperIntegral(g, A))] by ring
  rw [shape, (complexAbs.neg with differenceMember)]
  exact near with T, tMember, later, afterA

-- Section: Uniform approximation by integrable functions
-- Tagged sums of f and g differ by at most ε (B − A) when |f − g| ≤ ε on
-- [A, B].
theorem riemannSum.close (f g p t : Set) (A B E : Real, N : Nat)
  requires functionF : f : ℝ → ℝ
  requires functionG : g : ℝ → ℝ
  requires tagged : TaggedPartition(p, t, A, B, N)
  requires close : ∀ X ∈ closedInterval(A, B), abs(R[f(X) - g(X)]) ≤ E
  shows abs(R[riemannSum(f, p, t, N) - riemannSum(g, p, t, N)]) ≤
    R[E * (B - A)]
proof
  have taggedCopy : TaggedPartition(p, t, A, B, N) by exact tagged
  obtain ⟨partition, tags, _⟩ := taggedCopy
  have partitionCopy : IntervalPartition(p, A, B, N) by exact partition
  obtain ⟨points, _, _, _⟩ := partitionCopy
  have difference := realLinearCombination.function at R[1], R[-1], f, g
    with functionF, functionG
  have values : ∀ X ∈ ℝ, realLinearCombination(R[1], R[-1], f, g)(X) =
      R[1 * f(X) + -1 * g(X)]
    intros X xMember
    exact realLinearCombination.value with functionF, functionG, xMember
  have linear := riemannSum.linear with difference, functionF, functionG,
    points, tags, values
  have bounds : ∀ i ∈ ℕ, i < N →
      R[-E] ≤ realLinearCombination(R[1], R[-1], f, g)(t[i]) ∧
      realLinearCombination(R[1], R[-1], f, g)(t[i]) ≤ E
    intros i iMember before
    have typedI : Nat(i) := nat.omega.backward at i with iMember
    obtain ⟨lower, upper⟩ := TaggedPartition.tag_bounds with tagged, before
    have iLe : i ≤ N by arith
    have nextLe : succ(i) ≤ N by arith
    obtain ⟨startI, _⟩ := IntervalPartition.point_bounds with partition, iLe
    obtain ⟨_, endNext⟩ := IntervalPartition.point_bounds with partition,
      nextLe
    have tMember := RealSequence.value at t, i with tags
    have inside : t[i] ∈ closedInterval(A, B)
      apply closedInterval.membership.backward
      refine ⟨tMember, ?_, ?_⟩
      . linarith
      . linarith
    have near := close with t[i], inside
    have fT := FunctionBetween.apply_closed with functionF, tMember
    have gT := FunctionBetween.apply_closed with functionG, tMember
    have typedF : Real(f(t[i])) by exact fT
    have typedG : Real(g(t[i])) by exact gT
    have absReal := abs.real at R[f(t[i]) - g(t[i])]
    have up := abs.upper at R[f(t[i]) - g(t[i])]
    have down := abs.upper_neg at R[f(t[i]) - g(t[i])]
    have same : R[1 * f(t[i]) + -1 * g(t[i])] = R[f(t[i]) - g(t[i])] by ring
    rw [(values with t[i], tMember), same]
    constructor
    . linarith
    . linarith
  have lower : ∀ i ∈ ℕ, i < N →
      R[-E] ≤ realLinearCombination(R[1], R[-1], f, g)(t[i])
    intros i iMember before
    have both := bounds with i, iMember, before
    exact both.left
  have upper : ∀ i ∈ ℕ, i < N →
      realLinearCombination(R[1], R[-1], f, g)(t[i]) ≤ E
    intros i iMember before
    have both := bounds with i, iMember, before
    exact both.right
  obtain ⟨below, above⟩ := riemannSum.between_constants with difference,
    tagged, lower, upper
  have sumF := riemannSum.real at f, p, t, N with functionF, points, tags
  have sumG := riemannSum.real at g, p, t, N with functionG, points, tags
  rw linear at below
  rw linear at above
  unfold realSubValue at below
  unfold realSubValue at above
  have negated : R[-E * (B - A)] = R[-(E * (B - A))] by ring
  have sumsF : R[1 * riemannSum(f, p, t, N) + -1 * riemannSum(g, p, t, N)] =
    R[riemannSum(f, p, t, N) - riemannSum(g, p, t, N)] by ring
  rw [negated, sumsF] at below
  rw sumsF at above
  apply abs.le_of_bounds
  . linarith
  . linarith

theorem dist.eq_abs_sub (X Y : Real)
  shows dist(X, Y) = abs(R[X - Y])
proof
  have inner : realSubValue(X, Y) = R[X - Y]
    unfold realSubValue
    ring
  unfold dist
  rw inner

-- A function uniformly approximable on [A, B] by integrable functions is
-- integrable there.
theorem RiemannIntegrable.of_uniform_approx (f : Set) (A B : Real)
  requires function : f : ℝ → ℝ
  requires ordered : A ≤ B
  requires approx : ∀ E ∈ ℝ, R[0] < E → ∃ g, RiemannIntegrable(g, A, B) ∧
    (∀ X ∈ closedInterval(A, B), abs(R[f(X) - g(X)]) ≤ E)
  shows RiemannIntegrable(f, A, B)
proof
  apply FineSumsCauchy.integrable with function, ordered
  intros E eMember ePositive
  have typedE : Real(E) by exact eMember
  have halfPositive := half.positive with ePositive
  have quarterPositive := half.positive with halfPositive
  have halfReal := half.real at E
  have quarterTyped := half.real at half(E)
  have quarterReal : half(half(E)) ∈ ℝ by exact quarterTyped
  have halves := half.add_self at E
  have quarters := half.add_self at half(E)
  have lengthReal : R[B - A] ∈ ℝ by typecheck
  have lengthNonnegative : R[0] ≤ R[B - A] by linarith
  obtain ⟨ε, εMember, εPositive, scaled, _⟩ := realScale.absorb with
    lengthReal, quarterReal, lengthNonnegative, quarterPositive
  obtain ⟨g, integrableG, close⟩ := approx with ε, εMember, εPositive
  obtain ⟨I, _, integralG⟩ := integrableG
  have functionG := HasRiemannIntegral.function with integralG
  have cauchyG := HasRiemannIntegral.fine_sums_cauchy with integralG
  obtain ⟨D, dMember, dPositive, estimate⟩ := cauchyG with
    half(half(E)), quarterReal, quarterPositive
  refine ⟨D, dMember, dPositive, ?_⟩
  intros p t N nMember q s M mMember taggedP fineP taggedQ fineQ
  have nearG := estimate with p, t, N, nMember, q, s, M, mMember, taggedP,
    fineP, taggedQ, fineQ
  have closeP := riemannSum.close with function, functionG, taggedP, close
  have closeQ := riemannSum.close with function, functionG, taggedQ, close
  obtain ⟨⟨pointsP, _, _, _⟩, tagsT, _⟩ := taggedP
  obtain ⟨⟨pointsQ, _, _, _⟩, tagsS, _⟩ := taggedQ
  have fP := riemannSum.real at f, p, t, N with function, pointsP, tagsT
  have fQ := riemannSum.real at f, q, s, M with function, pointsQ, tagsS
  have gP := riemannSum.real at g, p, t, N with functionG, pointsP, tagsT
  have gQ := riemannSum.real at g, q, s, M with functionG, pointsQ, tagsS
  have first := dist.triangle at riemannSum(f, p, t, N),
    riemannSum(g, p, t, N), riemannSum(f, q, s, M)
  have second := dist.triangle at riemannSum(g, p, t, N),
    riemannSum(g, q, s, M), riemannSum(f, q, s, M)
  have symmetric := dist.symmetric at riemannSum(g, q, s, M),
    riemannSum(f, q, s, M)
  rw ← (dist.eq_abs_sub at riemannSum(f, p, t, N), riemannSum(g, p, t, N))
    at closeP
  rw ← (dist.eq_abs_sub at riemannSum(f, q, s, M), riemannSum(g, q, s, M))
    at closeQ
  have pReal := dist.real at riemannSum(f, p, t, N), riemannSum(g, p, t, N)
  have qReal := dist.real at riemannSum(f, q, s, M), riemannSum(g, q, s, M)
  have r1 := dist.real at riemannSum(f, p, t, N), riemannSum(f, q, s, M)
  have r2 := dist.real at riemannSum(g, p, t, N), riemannSum(f, q, s, M)
  have r3 := dist.real at riemannSum(g, p, t, N), riemannSum(g, q, s, M)
  have r4 := dist.real at riemannSum(g, q, s, M), riemannSum(f, q, s, M)
  have typedε : Real(ε) by exact εMember
  have step1 : dist(riemannSum(f, p, t, N), riemannSum(f, q, s, M)) <
      R[dist(riemannSum(f, p, t, N), riemannSum(g, p, t, N)) +
        half(half(E)) + dist(riemannSum(f, q, s, M), riemannSum(g, q, s, M))]
    linarith
  have step2 : R[ε * (B - A)] ≤ half(half(E))
    have same : R[(B - A) * ε] = R[ε * (B - A)] by ring
    rwa same at scaled
  linarith

-- The complex version: g is integrable on [A, B] when it is uniformly
-- approximable there by integrable functions.
theorem ComplexRiemannIntegrable.of_uniform_approx (g : Set) (A B : Real)
  requires values : ComplexValuedOn(g, ℝ)
  requires ordered : A ≤ B
  requires approx : ∀ E ∈ ℝ, R[0] < E → ∃ h,
    ComplexRiemannIntegrable(h, A, B) ∧
    (∀ X ∈ closedInterval(A, B), complexAbs(ℂ[g(X) - h(X)]) ≤ E)
  shows ComplexRiemannIntegrable(g, A, B)
proof
  have functionRe := complexFunctionRe.function with values
  have functionIm := complexFunctionIm.function with values
  refine ⟨values, ?_, ?_⟩
  . apply RiemannIntegrable.of_uniform_approx with functionRe, ordered
    intros E eMember ePositive
    obtain ⟨h, integrableH, close⟩ := approx with E, eMember, ePositive
    obtain ⟨valuesH, reH, _⟩ := integrableH
    refine ⟨complexFunctionRe(h), reH, ?_⟩
    intros X inside
    obtain ⟨xMember, _, _⟩ := closedInterval.membership.forward with inside
    have gX := values with X, xMember
    have hX := valuesH with X, xMember
    have near := close with X, inside
    have forward := complexRe.sub_bound with gX, hX
    have backward := complexRe.sub_bound with hX, gX
    have symmetric := complexAbs.dist_symm with gX, hX
    rw [(complexFunctionRe.apply with values, xMember),
      (complexFunctionRe.apply with valuesH, xMember)]
    apply abs.le_of_bounds
    . linarith
    . linarith
  . apply RiemannIntegrable.of_uniform_approx with functionIm, ordered
    intros E eMember ePositive
    obtain ⟨h, integrableH, close⟩ := approx with E, eMember, ePositive
    obtain ⟨valuesH, _, imH⟩ := integrableH
    refine ⟨complexFunctionIm(h), imH, ?_⟩
    intros X inside
    obtain ⟨xMember, _, _⟩ := closedInterval.membership.forward with inside
    have gX := values with X, xMember
    have hX := valuesH with X, xMember
    have near := close with X, inside
    have forward := complexIm.sub_bound with gX, hX
    have backward := complexIm.sub_bound with hX, gX
    have symmetric := complexAbs.dist_symm with gX, hX
    rw [(complexFunctionIm.apply with values, xMember),
      (complexFunctionIm.apply with valuesH, xMember)]
    apply abs.le_of_bounds
    . linarith
    . linarith

-- Section: Linear combinations of complex functions of a real variable
-- The function x ↦ c₁ f(x) + c₂ g(x).
defgraph complexCombination (c1 f c2 g : Set) (X ∈ ℝ) : complexCarrier :=
    ℂ[c1 * f(X) + c2 * g(X)]
requires hc1 : c1 ∈ complexCarrier
requires hc2 : c2 ∈ complexCarrier
requires valuesF : ComplexValuedOn(f, ℝ)
requires valuesG : ComplexValuedOn(g, ℝ)
proof
  have fX := valuesF with member
  have gX := valuesG with member
  typecheck

-- Functions with the same values on ℝ have the same real and imaginary
-- parts, hence the same integrals.
theorem complexFunctionParts.congr (g h : Set)
  requires valuesG : ComplexValuedOn(g, ℝ)
  requires valuesH : ComplexValuedOn(h, ℝ)
  requires agree : ∀ X ∈ ℝ, g(X) = h(X)
  shows complexFunctionRe(g) = complexFunctionRe(h) ∧
    complexFunctionIm(g) = complexFunctionIm(h)
proof
  have reG := complexFunctionRe.function with valuesG
  have reH := complexFunctionRe.function with valuesH
  have imG := complexFunctionIm.function with valuesG
  have imH := complexFunctionIm.function with valuesH
  constructor
  . apply FunctionBetween.ext with reG, reH
    intros X xMember
    rw [(complexFunctionRe.value with valuesG, xMember),
      (complexFunctionRe.value with valuesH, xMember),
      (agree with X, xMember)]
  . apply FunctionBetween.ext with imG, imH
    intros X xMember
    rw [(complexFunctionIm.value with valuesG, xMember),
      (complexFunctionIm.value with valuesH, xMember),
      (agree with X, xMember)]

theorem ComplexRiemannIntegrable.congr (g h : Set) (A B : Real)
  requires integrable : ComplexRiemannIntegrable(g, A, B)
  requires valuesH : ComplexValuedOn(h, ℝ)
  requires agree : ∀ X ∈ ℝ, g(X) = h(X)
  shows ComplexRiemannIntegrable(h, A, B) ∧
    complexIntegral(h, A, B) = complexIntegral(g, A, B)
proof
  obtain ⟨valuesG, reG, imG⟩ := integrable
  obtain ⟨sameRe, sameIm⟩ := complexFunctionParts.congr with valuesG,
    valuesH, agree
  rw sameRe at reG
  rw sameIm at imG
  refine ⟨⟨valuesH, reG, imG⟩, ?_⟩
  unfold complexIntegral
  rw [sameRe, sameIm]

theorem HasComplexImproperIntegral.congr (g h : Set) (A : Real) (I : Set)
  requires integral : HasComplexImproperIntegral(g, A, I)
  requires valuesH : ComplexValuedOn(h, ℝ)
  requires agree : ∀ X ∈ ℝ, g(X) = h(X)
  shows HasComplexImproperIntegral(h, A, I)
proof
  obtain ⟨valuesG, memberI, local, limit⟩ := integral
  refine ⟨valuesH, memberI, ?_, ?_⟩
  . intros T tMember later
    have integrable := local with T, tMember, later
    obtain ⟨result, _⟩ := ComplexRiemannIntegrable.congr with integrable,
      valuesH, agree
    exact result
  . intros e eMember ePositive
    obtain ⟨T₀, t0Member, eventually⟩ := limit with e, eMember, ePositive
    refine ⟨T₀, t0Member, ?_⟩
    intros T tMember later afterA
    have integrable := local with T, tMember, afterA
    obtain ⟨_, same⟩ := ComplexRiemannIntegrable.congr with integrable,
      valuesH, agree
    rw same
    exact eventually with T, tMember, later, afterA

-- c₁ f + c₂ g is integrable on [A, B] when f and g are.
theorem complexCombination.integrable (c1 f c2 g : Set) (A B : Real)
  requires hc1 : c1 ∈ ℂ
  requires hc2 : c2 ∈ ℂ
  requires ordered : A ≤ B
  requires integrableF : ComplexRiemannIntegrable(f, A, B)
  requires integrableG : ComplexRiemannIntegrable(g, A, B)
  shows ComplexRiemannIntegrable(complexCombination(c1, f, c2, g), A, B)
proof
  have valuesF := integrableF.left
  have valuesG := integrableG.left
  obtain ⟨first, _⟩ := complexIntegral.const_mul with hc1, ordered,
    integrableF
  obtain ⟨second, _⟩ := complexIntegral.const_mul with hc2, ordered,
    integrableG
  obtain ⟨sum, _⟩ := complexIntegral.add with ordered, first, second
  have combination := complexCombination.function at c1, f, c2, g with hc1,
    hc2, valuesF, valuesG
  have valuesH : ComplexValuedOn(complexCombination(c1, f, c2, g), ℝ)
    intros X xMember
    exact FunctionBetween.apply_closed with combination, xMember
  have constant1 := complexFunctionConst.function at c1, ℝ with hc1
  have constant2 := complexFunctionConst.function at c2, ℝ with hc2
  have valuesC1 : ComplexValuedOn(complexFunctionConst(c1, ℝ), ℝ)
    intros X xMember
    exact FunctionBetween.apply_closed with constant1, xMember
  have valuesC2 : ComplexValuedOn(complexFunctionConst(c2, ℝ), ℝ)
    intros X xMember
    exact FunctionBetween.apply_closed with constant2, xMember
  have product1 := complexFunctionMul.function with valuesC1, valuesF
  have product2 := complexFunctionMul.function with valuesC2, valuesG
  have valuesP1 : ComplexValuedOn(
      complexFunctionMul(complexFunctionConst(c1, ℝ), f, ℝ), ℝ)
    intros X xMember
    exact FunctionBetween.apply_closed with product1, xMember
  have valuesP2 : ComplexValuedOn(
      complexFunctionMul(complexFunctionConst(c2, ℝ), g, ℝ), ℝ)
    intros X xMember
    exact FunctionBetween.apply_closed with product2, xMember
  have agree : ∀ X ∈ ℝ, complexFunctionAdd(
      complexFunctionMul(complexFunctionConst(c1, ℝ), f, ℝ),
      complexFunctionMul(complexFunctionConst(c2, ℝ), g, ℝ), ℝ)(X) =
      complexCombination(c1, f, c2, g)(X)
    intros X xMember
    rw [(complexFunctionAdd.value with valuesP1, valuesP2, xMember),
      (complexFunctionMul.value with valuesC1, valuesF, xMember),
      (complexFunctionMul.value with valuesC2, valuesG, xMember),
      (complexFunctionConst.value with hc1, xMember),
      (complexFunctionConst.value with hc2, xMember),
      (complexCombination.value with hc1, hc2, valuesF, valuesG, xMember)]
  obtain ⟨result, _⟩ := ComplexRiemannIntegrable.congr with sum, valuesH,
    agree
  exact result

-- ∫_A^∞ (c₁ f + c₂ g) = c₁ ∫_A^∞ f + c₂ ∫_A^∞ g.
theorem complexCombination.improper (c1 f c2 g : Set) (A : Real)
  requires hc1 : c1 ∈ ℂ
  requires hc2 : c2 ∈ ℂ
  requires integrableF : ComplexImproperIntegrable(f, A)
  requires integrableG : ComplexImproperIntegrable(g, A)
  shows ComplexImproperIntegrable(complexCombination(c1, f, c2, g), A) ∧
    complexImproperIntegral(complexCombination(c1, f, c2, g), A) =
      ℂ[c1 * complexImproperIntegral(f, A) +
        c2 * complexImproperIntegral(g, A)]
proof
  have specF := complexImproperIntegral.spec with integrableF
  have specG := complexImproperIntegral.spec with integrableG
  obtain ⟨valuesF, _⟩ := specF
  obtain ⟨valuesG, _⟩ := specG
  obtain ⟨first, firstValue⟩ := complexImproperIntegral.const_mul with hc1,
    integrableF
  obtain ⟨second, secondValue⟩ := complexImproperIntegral.const_mul with hc2,
    integrableG
  obtain ⟨sum, sumValue⟩ := complexImproperIntegral.add with first, second
  rw [firstValue, secondValue] at sumValue
  have spec := complexImproperIntegral.spec with sum
  rw sumValue at spec
  have combination := complexCombination.function at c1, f, c2, g with hc1,
    hc2, valuesF, valuesG
  have valuesH : ComplexValuedOn(complexCombination(c1, f, c2, g), ℝ)
    intros X xMember
    exact FunctionBetween.apply_closed with combination, xMember
  have constant1 := complexFunctionConst.function at c1, ℝ with hc1
  have constant2 := complexFunctionConst.function at c2, ℝ with hc2
  have valuesC1 : ComplexValuedOn(complexFunctionConst(c1, ℝ), ℝ)
    intros X xMember
    exact FunctionBetween.apply_closed with constant1, xMember
  have valuesC2 : ComplexValuedOn(complexFunctionConst(c2, ℝ), ℝ)
    intros X xMember
    exact FunctionBetween.apply_closed with constant2, xMember
  have product1 := complexFunctionMul.function with valuesC1, valuesF
  have product2 := complexFunctionMul.function with valuesC2, valuesG
  have valuesP1 : ComplexValuedOn(
      complexFunctionMul(complexFunctionConst(c1, ℝ), f, ℝ), ℝ)
    intros X xMember
    exact FunctionBetween.apply_closed with product1, xMember
  have valuesP2 : ComplexValuedOn(
      complexFunctionMul(complexFunctionConst(c2, ℝ), g, ℝ), ℝ)
    intros X xMember
    exact FunctionBetween.apply_closed with product2, xMember
  have agree : ∀ X ∈ ℝ, complexFunctionAdd(
      complexFunctionMul(complexFunctionConst(c1, ℝ), f, ℝ),
      complexFunctionMul(complexFunctionConst(c2, ℝ), g, ℝ), ℝ)(X) =
      complexCombination(c1, f, c2, g)(X)
    intros X xMember
    rw [(complexFunctionAdd.value with valuesP1, valuesP2, xMember),
      (complexFunctionMul.value with valuesC1, valuesF, xMember),
      (complexFunctionMul.value with valuesC2, valuesG, xMember),
      (complexFunctionConst.value with hc1, xMember),
      (complexFunctionConst.value with hc2, xMember),
      (complexCombination.value with hc1, hc2, valuesF, valuesG, xMember)]
  have moved := HasComplexImproperIntegral.congr with spec, valuesH, agree
  have memberI := moved.right.left
  have integrable : ComplexImproperIntegrable(complexCombination(c1, f, c2,
    g), A) := ⟨ℂ[c1 * complexImproperIntegral(f, A) +
      c2 * complexImproperIntegral(g, A)], memberI, moved⟩
  refine ⟨integrable, ?_⟩
  exact complexImproperIntegral.eq with moved

-- L ≤ 2 P Q and P Q ≤ 2 P give L ≤ 4 P.
theorem real.le_of_scaled_chain (L P Q : Real)
  requires first : L ≤ R[2 * (P * Q) * 1]
  requires second : R[P * Q] ≤ R[P * 2]
  shows L ≤ R[4 * P]
proof
  have product : R[P * Q] ∈ ℝ by typecheck
  have doubled : R[2 * (P * Q) * 1] = R[2 * (P * Q)] by ring
  have twice : R[P * 2] = R[2 * P] by ring
  rw doubled at first
  rw twice at second
  linarith

-- 1/X is positive for X > 0.
theorem realInverse.positive (X : Real)
  requires positive : R[0] < X
  shows R[0] < R[1 / X] ∧ R[(1 / X) * X] = R[1]
proof
  have nonzero : X ≠ R[0] by linarith
  have cancel := realDiv.mul_right at R[1], X with nonzero
  refine ⟨?_, cancel⟩
  by_contra notPositive
  have below : R[1 / X] ≤ R[0] by linarith
  have nonnegative : R[0] ≤ X by linarith
  have scaled := realLe.mul_right_of_nonnegative with below, nonnegative
  have zeroProduct : R[0 * X] = R[0] by ring
  linarith

-- Section: The second-order Cauchy estimate
-- With |f| ≤ M on the closed disk of radius ρ about a, inside a disk of
-- holomorphy, |f(z) − f(a) − f′(a)(z − a)| ≤ 4M (|z − a|/ρ)² for
-- |z − a| ≤ ρ/2: Cauchy's formula with the first two terms of the
-- geometric expansion split off.
theorem HolomorphicOn.second_order (f U a r ρ z : Set) (M : Real)
  requires holomorphic : HolomorphicOn(f, U)
  requires ha : a ∈ U
  requires hr : r ∈ ℝ
  requires disk : complexDisk(a, r) ⊆ U
  requires hρ : ρ ∈ ℝ
  requires positive : R[0] < ρ
  requires less : ρ < r
  requires bound : ∀ w ∈ complexClosedDisk(a, ρ), complexAbs(f(w)) ≤ M
  requires hz : z ∈ ℂ
  requires near : R[2 * complexAbs(ℂ[z - a])] ≤ ρ
  shows complexAbs(ℂ[f(z) - f(a) - complexDeriv(f, U)(a) * (z - a)]) ≤
    R[(4 * M) * ((complexAbs(ℂ[z - a]) * (1 / ρ)) *
      (complexAbs(ℂ[z - a]) * (1 / ρ)))]
proof
  have isOpen := holomorphic.left
  have sub := ComplexOpen.subset with isOpen
  have aMember := sub with a, ha
  have values := holomorphic.right.left
  have valuesExt := complexExtension.values with values
  have agreeExt : ∀ w ∈ U, f(w) = complexExtension(f, U)(w)
    intros w hw
    symm
    exact complexExtension.agree with values, sub, hw
  have holomorphicExt := HolomorphicOn.congr with holomorphic, agreeExt
  have diskOpen := complexDisk.open with aMember, hr
  have holomorphicDisk := HolomorphicOn.mono with holomorphicExt, diskOpen,
    disk
  have continuous := HolomorphicOn.continuous with holomorphicDisk
  have typedρ : Real(ρ) by exact hρ
  have za : ℂ[z - a] ∈ ℂ by typecheck
  have dReal : complexAbs(ℂ[z - a]) ∈ ℝ by typecheck
  have dNonnegative := complexAbs.nonnegative with za
  have nearZ : complexAbs(ℂ[z - a]) < ρ by linarith
  have nonnegativeρ : R[0] ≤ ρ by linarith
  have absρ := abs.of_nonnegative at ρ with nonnegativeρ
  -- the circle of radius ρ lies in the closed disk and in the disk
  have onCircle : ∀ θ ∈ ℝ, circlePath(a, ρ)(θ) ∈ complexClosedDisk(a, ρ)
    intros θ hθ
    have point := circlePath.member at a, ρ, θ with aMember, hρ
    have distance := circlePath.abs at a, ρ, θ with aMember, hρ
    rw absρ at distance
    apply complexClosedDisk.membership.backward
    refine ⟨point, ?_⟩
    rw distance
    linarith
  have inside : ∀ θ ∈ ℝ, circlePath(a, ρ)(θ) ∈ complexDisk(a, r)
    intros θ hθ
    have point := circlePath.member at a, ρ, θ with aMember, hρ
    have distance := circlePath.abs at a, ρ, θ with aMember, hρ
    rw absρ at distance
    apply complexDisk.membership.backward
    refine ⟨point, ?_⟩
    rwa distance
  -- Cauchy's formula, and the expansion with two terms split off
  have formula := circleIntegral.cauchy_formula with valuesExt, aMember, hr,
    holomorphicDisk, hρ, positive, less, hz, nearZ
  have expansion := cauchyTerms.partial at complexExtension(f, U), a, z, ρ,
    complexDisk(a, r), succ(succ((0:N))) with valuesExt, aMember, hz, hρ,
    positive, nearZ, diskOpen, continuous, inside
  rw [complexPartialSum.succ, complexPartialSum.succ, complexPartialSum.zero]
    at expansion
  have zeroN : (0:N) ∈ ℕ by typecheck
  have oneN : succ((0:N)) ∈ ℕ by typecheck
  rw [(cauchyTerms.value with aMember, hz, zeroN),
    (cauchyTerms.value with aMember, hz, oneN), monoidPow.succ,
    monoidPow.zero] at expansion
  rw formula at expansion
  -- the first two coefficients are f(a) and f′(a)
  obtain ⟨twoPiI, nonzero⟩ := twoPiI.facts
  have cancel := complexInv.mul_cancel with twoPiI, nonzero
  have inv := complexInv.member with twoPiI
  obtain ⟨radius, sums⟩ := HolomorphicOn.cauchy_series with valuesExt,
    aMember, hr, holomorphicDisk, hρ, positive, less
  have aSmall := complexDisk.center with aMember, hρ, positive
  have atCenter := ComplexSumsTo.unique with (sums with a, aSmall),
    (powerSeriesTerms.center_sums with radius.left, aMember)
  rw (cauchyCoefficients.value at complexExtension(f, U), a, ρ, (0:N) with
    zeroN) at atCenter
  have derivative := HolomorphicOn.deriv_coefficient with holomorphic, ha, hr,
    disk, hρ, positive, less
  rw (cauchyCoefficients.value at complexExtension(f, U), a, ρ, (1:N) with
    oneN) at derivative
  have zDisk : z ∈ complexDisk(a, r)
    apply complexDisk.membership.backward
    refine ⟨hz, ?_⟩
    linarith
  rw [(agreeExt with z, (disk with z, zDisk)), (agreeExt with a, ha)]
  have hzMember := valuesExt with z, hz
  have haMember := valuesExt with a, aMember
  have i0 := circleIntegral.member at coefficientKernel(complexExtension(f,
    U), a, (0:N)), a, ρ
  have i1 := circleIntegral.member at coefficientKernel(complexExtension(f,
    U), a, (1:N)), a, ρ
  have rMember := circleIntegral.member at remainderKernel(complexExtension(f,
    U), a, z, succ(succ((0:N)))), a, ρ
  have dMember := complexDeriv.closed with holomorphic, ha
  have identity : ℂ[complexExtension(f, U)(z) - complexExtension(f, U)(a) -
      complexDeriv(f, U)(a) * (z - a)] =
      ℂ[complexInv(ℂ[complexImaginaryUnit * complexOfReal(R[2 * realPi])]) *
        circleIntegral(remainderKernel(complexExtension(f, U), a, z,
          succ(succ((0:N)))), a, ρ)]
    linear_combination (-1) * atCenter - (z - a) * derivative +
      complexInv(ℂ[complexImaginaryUnit * complexOfReal(R[2 * realPi])]) *
        expansion - complexExtension(f, U)(z) * cancel
  rw [identity, (complexAbs.mul with inv, rMember),
    (complexInv.abs with twoPiI, nonzero), twoPiI.abs]
  -- the remainder integral is small
  obtain ⟨_, _, _, remainderContinuous⟩ := kernels.continuous at
    complexExtension(f, U), a, z, complexDisk(a, r), (0:N),
    succ(succ((0:N))) with valuesExt, aMember, hz, diskOpen, continuous
  have insideW := circlePath.inside_punctured with aMember, hρ, hz, positive,
    nearZ, inside
  have remainderValues : ComplexValuedOn(remainderKernel(complexExtension(f,
      U), a, z, succ(succ((0:N)))), ℂ)
    intros w hw
    exact FunctionBetween.apply_closed with (remainderKernel.function at
      complexExtension(f, U), a, z, succ(succ((0:N))) with valuesExt, aMember,
      hz), hw
  have pointwise : ∀ θ ∈ closedInterval(R[0], R[2 * realPi]),
      complexAbs(remainderKernel(complexExtension(f, U), a, z,
        succ(succ((0:N))))(circlePath(a, ρ)(θ))) ≤
      R[(M * (1 / (ρ - complexAbs(ℂ[z - a])))) *
        (complexAbs(ℂ[z - a]) * (1 / ρ)) ^ succ(succ((0:N)))]
    intros θ hθInterval
    have hθ : θ ∈ ℝ := closedInterval.subset_reals at R[0], R[2 * realPi]
      with θ, hθInterval
    have γU := disk with circlePath(a, ρ)(θ), (inside with θ, hθ)
    have circleBound : complexAbs(complexExtension(f, U)(circlePath(a,
        ρ)(θ))) ≤ M
      rw ← (agreeExt with circlePath(a, ρ)(θ), γU)
      exact bound with circlePath(a, ρ)(θ), (onCircle with θ, hθ)
    exact remainderKernel.bound with valuesExt, aMember, hz, hρ, positive,
      nearZ, circleBound
  have integralBound := circleIntegral.abs_le with remainderValues, aMember,
    hρ, remainderContinuous, insideW, pointwise
  rw absρ at integralBound
  -- arithmetic: (1/2π) · 4πρ M (|z − a|/ρ)²/(ρ − |z − a|) ≤ 4M (|z − a|/ρ)²
  have piPositive := realPi.positive
  have twoPiPositive : R[0] < R[2 * realPi] by linarith
  obtain ⟨wPositive, cancelπ⟩ := realInverse.positive with twoPiPositive
  have gapPositive : R[0] < R[ρ - complexAbs(ℂ[z - a])] by linarith
  obtain ⟨uPositive, cancelU⟩ := realInverse.positive with gapPositive
  obtain ⟨vPositive, _⟩ := realInverse.positive with positive
  have rReal : complexAbs(circleIntegral(remainderKernel(complexExtension(f,
    U), a, z, succ(succ((0:N)))), a, ρ)) ∈ ℝ by typecheck
  have qNonnegative : R[0] ≤ R[complexAbs(ℂ[z - a]) * (1 / ρ)]
    have vNonnegative : R[0] ≤ R[1 / ρ] by linarith
    have product := realLe.mul_right_of_nonnegative with dNonnegative,
      vNonnegative
    have zeroProduct : R[0 * (1 / ρ)] = R[0] by ring
    linarith
  have qqNonnegative : R[0] ≤ R[(complexAbs(ℂ[z - a]) * (1 / ρ)) *
      (complexAbs(ℂ[z - a]) * (1 / ρ))]
    have product := realLe.mul_right_of_nonnegative with qNonnegative,
      qNonnegative
    have zeroProduct : R[0 * (complexAbs(ℂ[z - a]) * (1 / ρ))] = R[0] by ring
    linarith
  have aClosed : a ∈ complexClosedDisk(a, ρ)
    apply complexClosedDisk.membership.backward
    have zero : ℂ[a - a] = ℂ[0] by ring
    refine ⟨aMember, ?_⟩
    rw [zero, complexAbs.zero]
    exact nonnegativeρ
  have mNonnegative : R[0] ≤ M
    have atA := bound with a, aClosed
    have fa := values with a, ha
    have nonnegativeA := complexAbs.nonnegative with fa
    have absReal : complexAbs(f(a)) ∈ ℝ by typecheck
    linarith
  have mqqNonnegative : R[0] ≤ R[M * ((complexAbs(ℂ[z - a]) * (1 / ρ)) *
      (complexAbs(ℂ[z - a]) * (1 / ρ)))]
    have product := realLe.mul_right_of_nonnegative with mNonnegative,
      qqNonnegative
    have zeroProduct : R[0 * ((complexAbs(ℂ[z - a]) * (1 / ρ)) *
      (complexAbs(ℂ[z - a]) * (1 / ρ)))] = R[0] by ring
    linarith
  have ratio : R[ρ * (1 / (ρ - complexAbs(ℂ[z - a])))] ≤ R[2]
    have dGap : complexAbs(ℂ[z - a]) ≤ R[ρ - complexAbs(ℂ[z - a])] by linarith
    have uNonnegative : R[0] ≤ R[1 / (ρ - complexAbs(ℂ[z - a]))] by linarith
    have du := realLe.mul_right_of_nonnegative with dGap, uNonnegative
    have uReal : R[1 / (ρ - complexAbs(ℂ[z - a]))] ∈ ℝ by typecheck
    have first : R[(ρ - complexAbs(ℂ[z - a])) *
        (1 / (ρ - complexAbs(ℂ[z - a])))] =
        R[ρ * (1 / (ρ - complexAbs(ℂ[z - a]))) -
          complexAbs(ℂ[z - a]) * (1 / (ρ - complexAbs(ℂ[z - a])))] by ring
    have second : R[(1 / (ρ - complexAbs(ℂ[z - a]))) *
        (ρ - complexAbs(ℂ[z - a]))] =
        R[ρ * (1 / (ρ - complexAbs(ℂ[z - a]))) -
          complexAbs(ℂ[z - a]) * (1 / (ρ - complexAbs(ℂ[z - a])))] by ring
    rw first at du
    rw second at cancelU
    linarith
  have scaledRatio := realLe.mul_left_of_nonnegative with ratio,
    mqqNonnegative
  have wNonnegative : R[0] ≤ R[1 / (2 * realPi)] by linarith
  have scaledBound := realLe.mul_left_of_nonnegative with integralBound,
    wNonnegative
  have power : R[(complexAbs(ℂ[z - a]) * (1 / ρ)) ^ succ(succ((0:N)))] =
      R[(complexAbs(ℂ[z - a]) * (1 / ρ)) * (complexAbs(ℂ[z - a]) * (1 / ρ))]
    ring
  rw power at scaledBound
  have expand : R[1 / (2 * realPi) * (2 * (M * (1 / (ρ - complexAbs(ℂ[z -
      a]))) * ((complexAbs(ℂ[z - a]) * (1 / ρ)) * (complexAbs(ℂ[z - a]) *
      (1 / ρ))) * ρ * (2 * realPi - 0)))] =
      R[2 * ((M * ((complexAbs(ℂ[z - a]) * (1 / ρ)) * (complexAbs(ℂ[z - a]) *
        (1 / ρ)))) * (ρ * (1 / (ρ - complexAbs(ℂ[z - a]))))) *
        ((1 / (2 * realPi)) * (2 * realPi))]
    ring
  rw [expand, cancelπ] at scaledBound
  have goalForm : R[(4 * M) * ((complexAbs(ℂ[z - a]) * (1 / ρ)) *
      (complexAbs(ℂ[z - a]) * (1 / ρ)))] = R[4 * (M * ((complexAbs(ℂ[z - a]) *
      (1 / ρ)) * (complexAbs(ℂ[z - a]) * (1 / ρ))))] by ring
  rw goalForm
  exact real.le_of_scaled_chain with scaledBound, scaledRatio

-- Section: Estimates for difference quotients
-- |D| ≤ 3G/Q when |a|, |b| ≤ G, |c| = Q > 0 and |a − b − D c| ≤ G.
theorem complexAbs.slope_bound (a b D c : Set) (G Q : Real)
  requires ha : a ∈ ℂ
  requires hb : b ∈ ℂ
  requires hD : D ∈ ℂ
  requires hc : c ∈ ℂ
  requires size : complexAbs(c) = Q
  requires positive : R[0] < Q
  requires boundA : complexAbs(a) ≤ G
  requires boundB : complexAbs(b) ≤ G
  requires error : complexAbs(ℂ[a - b - D * c]) ≤ G
  shows complexAbs(D) ≤ R[(3 * G) * (1 / Q)]
proof
  have difference : ℂ[a - b] ∈ ℂ by typecheck
  have errorMember : ℂ[a - b - D * c] ∈ ℂ by typecheck
  have split := complexAbs.sub_le with difference, errorMember
  have same : ℂ[(a - b) - (a - b - D * c)] = ℂ[D * c] by ring
  rw [same, (complexAbs.mul with hD, hc), size] at split
  have parts := complexAbs.sub_le with ha, hb
  have absD : complexAbs(D) ∈ ℝ by typecheck
  have absDifference : complexAbs(ℂ[a - b]) ∈ ℝ by typecheck
  have absError : complexAbs(ℂ[a - b - D * c]) ∈ ℝ by typecheck
  have absA : complexAbs(a) ∈ ℝ by typecheck
  have absB : complexAbs(b) ∈ ℝ by typecheck
  have product : R[complexAbs(D) * Q] ≤ R[3 * G] by linarith
  obtain ⟨inversePositive, cancel⟩ := realInverse.positive with positive
  have inverseNonnegative : R[0] ≤ R[1 / Q] by linarith
  have scaled := realLe.mul_right_of_nonnegative with product,
    inverseNonnegative
  have unfoldD : R[complexAbs(D) * Q * (1 / Q)] =
    R[complexAbs(D) * ((1 / Q) * Q)] by ring
  rw [unfoldD, cancel] at scaled
  have one : R[complexAbs(D) * 1] = complexAbs(D) by ring
  rwa one at scaled

-- |D − (a − b)/c| ≤ B t when |c| = t > 0 and |a − b − D c| ≤ B t².
theorem complexAbs.quotient_error (a b D c : Set) (B t : Real)
  requires ha : a ∈ ℂ
  requires hb : b ∈ ℂ
  requires hD : D ∈ ℂ
  requires hc : c ∈ ℂ
  requires size : complexAbs(c) = t
  requires positive : R[0] < t
  requires error : complexAbs(ℂ[a - b - D * c]) ≤ R[B * t * t]
  shows complexAbs(ℂ[D - (complexInv(c) * a + -complexInv(c) * b)]) ≤
    R[B * t]
proof
  have nonzero : c ≠ ℂ[0]
    intro zero
    rw [zero, complexAbs.zero] at size
    linarith
  have cancel := complexInv.mul_cancel with hc, nonzero
  have inverse := complexInv.member with hc
  have errorMember : ℂ[a - b - D * c] ∈ ℂ by typecheck
  have same : ℂ[D - (complexInv(c) * a + -complexInv(c) * b)] =
      ℂ[-complexInv(c) * (a - b - D * c)]
    linear_combination (-D) * cancel
  have negInverse : ℂ[-complexInv(c)] ∈ ℂ by typecheck
  rw [same, (complexAbs.mul with negInverse, errorMember),
    (complexAbs.neg with inverse), (complexInv.abs with hc, nonzero), size]
  obtain ⟨inversePositive, cancelT⟩ := realInverse.positive with positive
  have inverseNonnegative : R[0] ≤ R[1 / t] by linarith
  have scaled := realLe.mul_left_of_nonnegative with error,
    inverseNonnegative
  have unfoldB : R[(1 / t) * (B * t * t)] = R[B * t * ((1 / t) * t)] by ring
  rw [unfoldB, cancelT] at scaled
  have one : R[B * t * 1] = R[B * t] by ring
  rwa one at scaled

-- X ≤ 4 (d v)² J with 0 ≤ d ≤ ε and 4 J v² ε ≤ e gives X ≤ e d.
theorem real.quadratic_small (X d J v ε e : Real)
  requires bound : X ≤ R[(4 * ((d * v) * (d * v))) * J + 0 * J]
  requires nonnegative : R[0] ≤ d
  requires close : d ≤ ε
  requires coefficient : R[0] ≤ R[4 * J * (v * v)]
  requires absorb : R[(4 * J * (v * v)) * ε] ≤ e
  shows X ≤ R[e * d]
proof
  have first := realLe.mul_left_of_nonnegative with close, coefficient
  have linear : R[(4 * J * (v * v)) * d] ≤ e by linarith
  have second := realLe.mul_right_of_nonnegative with linear, nonnegative
  have same : R[(4 * ((d * v) * (d * v))) * J + 0 * J] =
    R[(4 * J * (v * v)) * d * d] by ring
  rw same at bound
  linarith

-- Section: Integrals depending on a complex parameter
-- A family of complex functions of a real variable indexed by s ∈ U is a
-- set K with K(s) such a function for each s; its value at x as a
-- function of s, and its integral over [A, ∞) as a function of s.
defgraph kernelSlice (K U : Set, X : Real) (s ∈ U) : complexCarrier :=
    K(s)(X)
requires values : ∀ s ∈ U, ComplexValuedOn(K(s), ℝ)
proof
  have function := values with member
  have xReal : X ∈ ℝ by typecheck
  exact function with xReal

defgraph parameterIntegral (K U : Set, A : Real) (s ∈ U) : complexCarrier :=
    complexImproperIntegral(K(s), A)
proof
  exact complexImproperIntegral.member

-- The derivative in s under the integral sign: x ↦ ∂ₛ K(s)(x).
defgraph kernelDeriv (K U s : Set) (X ∈ ℝ) : complexCarrier :=
    complexDeriv(kernelSlice(K, U, X), U)(s)
requires values : ∀ s ∈ U, ComplexValuedOn(K(s), ℝ)
requires holomorphic : ∀ X ∈ ℝ, HolomorphicOn(kernelSlice(K, U, X), U)
requires hs : s ∈ U
proof
  have holomorphicX := holomorphic with member
  rw complexDeriv.value with holomorphicX, hs
  exact complexDeriv.closed with holomorphicX, hs

-- ∂ₛ K(s)(x) for x ≥ A, and 0 for x < A, where s ↦ K(s)(x) need not be
-- holomorphic.
defunique kernelDerivFromValue (K U s : Set, A X : Real)
    (D ∈ complexCarrier) :=
  (A ≤ X → D = complexDeriv(kernelSlice(K, U, X), U)(s)) ∧
  (¬(A ≤ X) → D = ℂ[0])
requires values : ∀ s ∈ U, ComplexValuedOn(K(s), ℝ)
requires pointwise : ∀ X ∈ ℝ, A ≤ X → HolomorphicOn(kernelSlice(K, U, X), U)
requires hs : s ∈ U
proof
  by_cases later : A ≤ X
  . have xMember : X ∈ ℝ by typecheck
    have holomorphicX := pointwise with X, xMember, later
    have closed : complexDeriv(kernelSlice(K, U, X), U)(s) ∈ ℂ
      rw (complexDeriv.value with holomorphicX, hs)
      exact complexDeriv.closed with holomorphicX, hs
    refine ⟨complexDeriv(kernelSlice(K, U, X), U)(s), closed, ?_, ?_⟩
    . intro ignored
      rfl
    . intro earlier
      exfalso
      apply earlier
      exact later
  . have zero : ℂ[0] ∈ ℂ by typecheck
    refine ⟨ℂ[0], zero, ?_, ?_⟩
    . intro earlier
      exfalso
      apply later
      exact earlier
    . intro ignored
      rfl
uniqueness
  intros D hD first E hE second
  obtain ⟨d1, d2⟩ := first
  obtain ⟨e1, e2⟩ := second
  by_cases later : A ≤ X
  . rw [(d1 with later), (e1 with later)]
  . rw [(d2 with later), (e2 with later)]

defgraph kernelDerivFrom (K U s : Set, A : Real) (X ∈ ℝ) : complexCarrier :=
    kernelDerivFromValue(K, U, s, A, X)
requires values : ∀ s ∈ U, ComplexValuedOn(K(s), ℝ)
requires pointwise : ∀ X ∈ ℝ, A ≤ X → HolomorphicOn(kernelSlice(K, U, X), U)
requires hs : s ∈ U
proof
  have typedX : Real(X) by exact member
  have selected := kernelDerivFromValue.selected at K, U, s, A, X with values,
    pointwise, hs
  exact selected.left

-- The common core of holomorphy and differentiation under the integral
-- sign at a point s, for a function D of x equal to ∂ₛ K(s)(x) for x ≥ A:
-- the second-order Cauchy estimate on a closed disk about s, integrated
-- against the dominating function of that disk.
theorem parameterIntegral.derivative_of (K U s D : Set) (A : Real)
  requires isOpen : ComplexOpen(U)
  requires values : ∀ s ∈ U, ComplexValuedOn(K(s), ℝ)
  requires local : ∀ s ∈ U, ∀ T ∈ ℝ, A ≤ T →
    ComplexRiemannIntegrable(K(s), A, T)
  requires pointwise : ∀ X ∈ ℝ, A ≤ X → HolomorphicOn(kernelSlice(K, U, X), U)
  requires dominated : ∀ C, C ⊆ U → ComplexCompact(C) →
    (∃ G, ImproperIntegrable(G, A) ∧
      (∀ s ∈ C, ∀ X ∈ ℝ, A ≤ X → complexAbs(K(s)(X)) ≤ G(X)))
  requires hs : s ∈ U
  requires valuesD : ComplexValuedOn(D, ℝ)
  requires derivative : ∀ X ∈ ℝ, A ≤ X →
    D(X) = complexDeriv(kernelSlice(K, U, X), U)(s)
  shows ComplexImproperIntegrable(K(s), A) ∧
    ComplexImproperIntegrable(D, A) ∧
    HasComplexDerivativeAt(parameterIntegral(K, U, A), U,
      complexImproperIntegral(D, A), s)
proof
  have sub := ComplexOpen.subset with isOpen
  have sMember := sub with s, hs
  obtain ⟨r, rReal, rPositive, diskInside⟩ := ComplexOpen.disk with isOpen,
    hs
  have typedR : Real(r) by exact rReal
  have ρPositive := half.positive with rPositive
  have ρTyped := half.real at r
  have ρReal : half(r) ∈ ℝ by exact ρTyped
  have halves := half.add_self at r
  have ρLess : half(r) < r by linarith
  have qPositive := half.positive with ρPositive
  have qTyped := half.real at half(r)
  have qReal : half(half(r)) ∈ ℝ by exact qTyped
  have quarters := half.add_self at half(r)
  obtain ⟨_, closedOpen⟩ := complexDisk.mono_closed with sMember, ρReal,
    rReal, ρLess
  have closedInside : complexClosedDisk(s, half(r)) ⊆ U :=
    Subset.transitive with closedOpen, diskInside
  have compact := complexClosedDisk.compact with sMember, ρReal
  obtain ⟨G, integrableG, boundG⟩ := dominated with
    complexClosedDisk(s, half(r)), closedInside, compact
  have specG := improperIntegral.spec with integrableG
  have specGCopy : HasImproperIntegral(G, A, improperIntegral(G, A)) by
    exact specG
  obtain ⟨functionG, localG, _⟩ := specGCopy
  -- points near s lie in the closed disk
  have nearClosed : ∀ z ∈ ℂ, R[2 * complexAbs(ℂ[z - s])] ≤ half(r) →
      z ∈ complexClosedDisk(s, half(r))
    intros z hz near
    have zs : ℂ[z - s] ∈ ℂ by typecheck
    have nonnegative := complexAbs.nonnegative with zs
    have absReal : complexAbs(ℂ[z - s]) ∈ ℝ by typecheck
    apply complexClosedDisk.membership.backward
    refine ⟨hz, ?_⟩
    linarith
  have zero : ℂ[s - s] = ℂ[0] by ring
  have sNear : R[2 * complexAbs(ℂ[s - s])] ≤ half(r)
    rw [zero, complexAbs.zero]
    linarith
  have sClosed := nearClosed with s, sMember, sNear
  -- K(w) is integrable over [A, ∞) on the closed disk
  have kIntegrable : ∀ w ∈ complexClosedDisk(s, half(r)),
      ComplexImproperIntegrable(K(w), A)
    intros w hw
    have wU := closedInside with w, hw
    obtain ⟨result, _⟩ := ComplexImproperIntegrable.of_dominated with
      (local with w, wU), integrableG, (boundG with w, hw)
    exact result
  obtain ⟨integrableS, absS⟩ := ComplexImproperIntegrable.of_dominated with
    (local with s, hs), integrableG, (boundG with s, sClosed)
  -- the second-order estimate at each x ≥ A
  have taylor : ∀ X ∈ ℝ, A ≤ X → ∀ z ∈ ℂ,
      R[2 * complexAbs(ℂ[z - s])] ≤ half(r) →
      complexAbs(ℂ[K(z)(X) - K(s)(X) - D(X) * (z - s)]) ≤
        R[(4 * G(X)) * ((complexAbs(ℂ[z - s]) * (1 / half(r))) *
          (complexAbs(ℂ[z - s]) * (1 / half(r))))]
    intros X xMember later z hz near
    have holomorphicX := pointwise with X, xMember, later
    have typedX : Real(X) by exact xMember
    have gMember := FunctionBetween.apply_closed with functionG, xMember
    have typedG : Real(G(X)) by exact gMember
    have boundX : ∀ w ∈ complexClosedDisk(s, half(r)),
        complexAbs(kernelSlice(K, U, X)(w)) ≤ G(X)
      intros w hw
      rw (kernelSlice.value with values, (closedInside with w, hw))
      exact boundG with w, hw, X, xMember, later
    have estimate := HolomorphicOn.second_order at kernelSlice(K, U, X), U,
      s, r, half(r), z, G(X) with holomorphicX, hs, rReal, diskInside, ρReal,
      ρPositive, ρLess, boundX, hz, near
    have zU := closedInside with z, (nearClosed with z, hz, near)
    rw [(kernelSlice.value with values, zU), (kernelSlice.value with values,
      hs), ← (derivative with X, xMember, later)] at estimate
    exact estimate
  -- the shift by a real c ≥ 0 moves s by |c| = c
  have shiftAbs : ∀ t ∈ ℝ, R[0] ≤ t →
      ℂ[s + complexOfReal(t)] ∈ ℂ ∧
      ℂ[ℂ[s + complexOfReal(t)] - s] = complexOfReal(t) ∧
      complexAbs(complexOfReal(t)) = t
    intros t tMember nonnegative
    have typedT : Real(t) by exact tMember
    have cMember : complexOfReal(t) ∈ ℂ := FunctionBetween.apply_closed with
      complexOfReal.function, tMember
    have sum : ℂ[s + complexOfReal(t)] ∈ ℂ by typecheck
    have shift : ℂ[ℂ[s + complexOfReal(t)] - s] = complexOfReal(t) by ring
    rw [complexAbs.of_real, (abs.of_nonnegative at t with nonnegative)]
    exact ⟨sum, shift, rfl⟩
  obtain ⟨vPositive, cancelV⟩ := realInverse.positive with ρPositive
  have vReal : R[1 / half(r)] ∈ ℝ by typecheck
  have vNonnegative : R[0] ≤ R[1 / half(r)] by linarith
  have vvNonnegative : R[0] ≤ R[(1 / half(r)) * (1 / half(r))]
    have product := realLe.mul_right_of_nonnegative with vNonnegative,
      vNonnegative
    have zeroProduct : R[0 * (1 / half(r))] = R[0] by ring
    linarith
  -- |D(x)| ≤ 3 G(x)/q with q = ρ/2, from the estimate at s + q
  have qNonnegative : R[0] ≤ half(half(r)) by linarith
  obtain ⟨z0Member, shift0, abs0⟩ := shiftAbs with half(half(r)), qReal,
    qNonnegative
  have cMember0 : complexOfReal(half(half(r))) ∈ ℂ :=
    FunctionBetween.apply_closed with complexOfReal.function, qReal
  have z0Near : R[2 * complexAbs(ℂ[ℂ[s + complexOfReal(half(half(r)))] -
      s])] ≤ half(r)
    rw [shift0, abs0]
    linarith
  have z0Closed := nearClosed with ℂ[s + complexOfReal(half(half(r)))],
    z0Member, z0Near
  have z0U := closedInside with ℂ[s + complexOfReal(half(half(r)))], z0Closed
  have dBound : ∀ X ∈ ℝ, A ≤ X →
      complexAbs(D(X)) ≤ R[(3 * G(X)) * (1 / half(half(r)))]
    intros X xMember later
    have typedX : Real(X) by exact xMember
    have gMember := FunctionBetween.apply_closed with functionG, xMember
    have typedG : Real(G(X)) by exact gMember
    have estimate := taylor with X, xMember, later,
      ℂ[s + complexOfReal(half(half(r)))], z0Member, z0Near
    rw [shift0, abs0] at estimate
    have expand : R[(4 * G(X)) * ((half(half(r)) * (1 / half(r))) *
        (half(half(r)) * (1 / half(r))))] =
        R[G(X) * (((1 / half(r)) * (half(half(r)) + half(half(r)))) *
          ((1 / half(r)) * (half(half(r)) + half(half(r)))))] by ring
    rw [expand, quarters, cancelV] at estimate
    have one : R[G(X) * (1 * 1)] = G(X) by ring
    rw one at estimate
    have kz := values with ℂ[s + complexOfReal(half(half(r)))], z0U
    have ks := values with s, hs
    exact complexAbs.slope_bound with (kz with X, xMember),
      (ks with X, xMember), (valuesD with X, xMember), cMember0, abs0,
      qPositive, (boundG with ℂ[s + complexOfReal(half(half(r)))], z0Closed,
      X, xMember, later), (boundG with s, sClosed, X, xMember, later), estimate
  -- D is integrable on [A, T]: difference quotients converge uniformly
  have localD : ∀ T ∈ ℝ, A ≤ T → ComplexRiemannIntegrable(D, A, T)
    intros T bigT later
    obtain ⟨MT, mtMember, boundT⟩ := RiemannIntegrable.bounded with
      (localG with T, bigT, later)
    have typedMT : Real(MT) by exact mtMember
    have aMember : A ∈ ℝ by typecheck
    have aInside : A ∈ closedInterval(A, T)
      apply closedInterval.membership.backward
      refine ⟨aMember, ?_, later⟩
      linarith
    have gA := FunctionBetween.apply_closed with functionG, aMember
    have typedGA : Real(G(A)) by exact gA
    have absA := abs.nonnegative at G(A)
    have atA := boundT with A, aInside
    have mtNonnegative : R[0] ≤ MT by linarith
    have coefficientReal : R[4 * MT * ((1 / half(r)) * (1 / half(r)))] ∈ ℝ
      by typecheck
    have coefficientNonnegative : R[0] ≤
        R[4 * MT * ((1 / half(r)) * (1 / half(r)))]
      have fourMT : R[0] ≤ R[4 * MT] by linarith
      have product := realLe.mul_right_of_nonnegative with fourMT,
        vvNonnegative
      have zeroProduct : R[0 * ((1 / half(r)) * (1 / half(r)))] = R[0] by ring
      linarith
    apply ComplexRiemannIntegrable.of_uniform_approx with valuesD, later
    intros E eMember ePositive
    obtain ⟨ε, εMember, εPositive, absorbed, _⟩ := realScale.absorb with
      coefficientReal, eMember, coefficientNonnegative, ePositive
    obtain ⟨t, tMember, tPositive, tBelowε, tBelowQ⟩ := realRadius.common with
      εMember, qReal, εPositive, qPositive
    have typedT : Real(t) by exact tMember
    have tNonnegative : R[0] ≤ t by linarith
    obtain ⟨zMember, shift, absC⟩ := shiftAbs with t, tMember, tNonnegative
    have cMember : complexOfReal(t) ∈ ℂ := FunctionBetween.apply_closed with
      complexOfReal.function, tMember
    have zNear : R[2 * complexAbs(ℂ[ℂ[s + complexOfReal(t)] - s])] ≤ half(r)
      rw [shift, absC]
      linarith
    have zClosed := nearClosed with ℂ[s + complexOfReal(t)], zMember, zNear
    have zU := closedInside with ℂ[s + complexOfReal(t)], zClosed
    have integrableZ := local with ℂ[s + complexOfReal(t)], zU, T, bigT,
      later
    have integrableST := local with s, hs, T, bigT, later
    have inverse := complexInv.member with cMember
    have negInverse : ℂ[-complexInv(complexOfReal(t))] ∈ ℂ by typecheck
    have valuesZ := values with ℂ[s + complexOfReal(t)], zU
    have valuesS := values with s, hs
    refine ⟨complexCombination(complexInv(complexOfReal(t)),
      K(ℂ[s + complexOfReal(t)]), ℂ[-complexInv(complexOfReal(t))], K(s)),
      (complexCombination.integrable with inverse, negInverse, later,
        integrableZ, integrableST), ?_⟩
    intros X inside
    obtain ⟨xMember, aLe, xLe⟩ := closedInterval.membership.forward with
      inside
    have typedX : Real(X) by exact xMember
    have gMember := FunctionBetween.apply_closed with functionG, xMember
    have typedG : Real(G(X)) by exact gMember
    have estimate := taylor with X, xMember, aLe, ℂ[s + complexOfReal(t)],
      zMember, zNear
    rw [shift, absC] at estimate
    have reshape : R[(4 * G(X)) * ((t * (1 / half(r))) *
        (t * (1 / half(r))))] =
        R[(4 * G(X) * ((1 / half(r)) * (1 / half(r)))) * t * t] by ring
    rw reshape at estimate
    have quotient := complexAbs.quotient_error with (valuesZ with X, xMember),
      (valuesS with X, xMember), (valuesD with X, xMember), cMember, absC,
      tPositive, estimate
    rw (complexCombination.value with inverse, negInverse, valuesZ, valuesS,
      xMember)
    have gAbove := abs.upper at G(X)
    have gBound := boundT with X, inside
    have fourG : R[4 * G(X)] ≤ R[4 * MT] by linarith
    have gScaled := realLe.mul_right_of_nonnegative with fourG, vvNonnegative
    have first := realLe.mul_right_of_nonnegative with gScaled, tNonnegative
    have second := realLe.mul_left_of_nonnegative with tBelowε,
      coefficientNonnegative
    have kzX := valuesZ with X, xMember
    have ksX := valuesS with X, xMember
    have dX := valuesD with X, xMember
    have absReal : complexAbs(ℂ[D(X) - (complexInv(complexOfReal(t)) *
      K(ℂ[s + complexOfReal(t)])(X) + -complexInv(complexOfReal(t)) *
      K(s)(X))]) ∈ ℝ by typecheck
    have toε := realLe.transitive with first, second
    have toE := realLe.transitive with toε, absorbed
    exact realLe.transitive with quotient, toE
  -- D is integrable over [A, ∞), dominated by 3G/q
  have functionGD := realLinearCombination.function at
    R[3 * (1 / half(half(r)))], R[0], G, G with functionG, functionG
  have valuesGD : ∀ X ∈ ℝ, realLinearCombination(R[3 * (1 / half(half(r)))],
      R[0], G, G)(X) = R[3 * (1 / half(half(r))) * G(X) + 0 * G(X)]
    intros X xMember
    exact realLinearCombination.value with functionG, functionG, xMember
  have integralGD := HasImproperIntegral.linear with specG, specG,
    functionGD, valuesGD
  have integralGDReal : R[3 * (1 / half(half(r))) * improperIntegral(G, A) +
    0 * improperIntegral(G, A)] ∈ ℝ by typecheck
  have integrableGD : ImproperIntegrable(realLinearCombination(
      R[3 * (1 / half(half(r)))], R[0], G, G), A) :=
    ⟨R[3 * (1 / half(half(r))) * improperIntegral(G, A) +
      0 * improperIntegral(G, A)], integralGDReal, integralGD⟩
  have boundD : ∀ X ∈ ℝ, A ≤ X → complexAbs(D(X)) ≤
      realLinearCombination(R[3 * (1 / half(half(r)))], R[0], G, G)(X)
    intros X xMember later
    have gMember := FunctionBetween.apply_closed with functionG, xMember
    have typedG : Real(G(X)) by exact gMember
    have same : R[(3 * G(X)) * (1 / half(half(r)))] =
      R[3 * (1 / half(half(r))) * G(X) + 0 * G(X)] by ring
    rw [(valuesGD with X, xMember), ← same]
    exact dBound with X, xMember, later
  obtain ⟨integrableD, _⟩ := ComplexImproperIntegrable.of_dominated with
    localD, integrableGD, boundD
  -- the derivative of the parameter integral at s
  have memberID := complexImproperIntegral.member at D, A
  have functionF := parameterIntegral.function at K, U, A
  have valuesF : ComplexValuedOn(parameterIntegral(K, U, A), U)
    intros z hz
    exact FunctionBetween.apply_closed with functionF, hz
  refine ⟨integrableS, integrableD, isOpen, hs, memberID, valuesF, ?_⟩
  intros e eMember ePositive
  have jReal : improperIntegral(G, A) ∈ ℝ by typecheck
  have integralS := complexImproperIntegral.member at K(s), A
  have absSNonnegative := complexAbs.nonnegative with integralS
  have absSReal : complexAbs(complexImproperIntegral(K(s), A)) ∈ ℝ by
    typecheck
  have jNonnegative : R[0] ≤ improperIntegral(G, A) by linarith
  have coefficientReal : R[4 * improperIntegral(G, A) *
    ((1 / half(r)) * (1 / half(r)))] ∈ ℝ by typecheck
  have coefficientNonnegative : R[0] ≤ R[4 * improperIntegral(G, A) *
      ((1 / half(r)) * (1 / half(r)))]
    have fourJ : R[0] ≤ R[4 * improperIntegral(G, A)] by linarith
    have product := realLe.mul_right_of_nonnegative with fourJ,
      vvNonnegative
    have zeroProduct : R[0 * ((1 / half(r)) * (1 / half(r)))] = R[0] by ring
    linarith
  obtain ⟨ε, εMember, εPositive, absorbed, _⟩ := realScale.absorb with
    coefficientReal, eMember, coefficientNonnegative, ePositive
  obtain ⟨δ, δMember, δPositive, δBelowε, δBelowQ⟩ := realRadius.common with
    εMember, qReal, εPositive, qPositive
  refine ⟨δ, δMember, δPositive, ?_⟩
  intros z hz near
  have zMember := sub with z, hz
  have zs : ℂ[z - s] ∈ ℂ by typecheck
  have dReal : complexAbs(ℂ[z - s]) ∈ ℝ by typecheck
  have dNonnegative := complexAbs.nonnegative with zs
  have zNear : R[2 * complexAbs(ℂ[z - s])] ≤ half(r) by linarith
  have dBelowε : complexAbs(ℂ[z - s]) ≤ ε by linarith
  have zClosed := nearClosed with z, zMember, zNear
  have integrableZ := kIntegrable with z, zClosed
  have valuesZ := values with z, hz
  have valuesS := values with s, hs
  have one : ℂ[1] ∈ ℂ by typecheck
  have minusOne : ℂ[-1] ∈ ℂ by typecheck
  have coefficient : ℂ[-(z - s)] ∈ ℂ by typecheck
  obtain ⟨innerIntegrable, innerValue⟩ := complexCombination.improper with
    one, minusOne, integrableZ, integrableS
  obtain ⟨errorIntegrable, errorValue⟩ := complexCombination.improper with
    one, coefficient, innerIntegrable, integrableD
  have errorSpec := complexImproperIntegral.spec with errorIntegrable
  obtain ⟨_, _, localError, _⟩ := errorSpec
  have functionInner := complexCombination.function at ℂ[1], K(z), ℂ[-1],
    K(s) with one, minusOne, valuesZ, valuesS
  have valuesInner : ComplexValuedOn(complexCombination(ℂ[1], K(z), ℂ[-1],
      K(s)), ℝ)
    intros X xMember
    exact FunctionBetween.apply_closed with functionInner, xMember
  -- the dominating function 4 (|z − s|/ρ)² G
  have functionGE := realLinearCombination.function at
    R[4 * ((complexAbs(ℂ[z - s]) * (1 / half(r))) *
      (complexAbs(ℂ[z - s]) * (1 / half(r))))], R[0], G, G with functionG,
    functionG
  have valuesGE : ∀ X ∈ ℝ, realLinearCombination(
      R[4 * ((complexAbs(ℂ[z - s]) * (1 / half(r))) *
        (complexAbs(ℂ[z - s]) * (1 / half(r))))], R[0], G, G)(X) =
      R[4 * ((complexAbs(ℂ[z - s]) * (1 / half(r))) *
        (complexAbs(ℂ[z - s]) * (1 / half(r)))) * G(X) + 0 * G(X)]
    intros X xMember
    exact realLinearCombination.value with functionG, functionG, xMember
  have integralGE := HasImproperIntegral.linear with specG, specG,
    functionGE, valuesGE
  have integralGEReal : R[4 * ((complexAbs(ℂ[z - s]) * (1 / half(r))) *
      (complexAbs(ℂ[z - s]) * (1 / half(r)))) * improperIntegral(G, A) +
      0 * improperIntegral(G, A)] ∈ ℝ by typecheck
  have integrableGE : ImproperIntegrable(realLinearCombination(
      R[4 * ((complexAbs(ℂ[z - s]) * (1 / half(r))) *
        (complexAbs(ℂ[z - s]) * (1 / half(r))))], R[0], G, G), A) :=
    ⟨R[4 * ((complexAbs(ℂ[z - s]) * (1 / half(r))) *
      (complexAbs(ℂ[z - s]) * (1 / half(r)))) * improperIntegral(G, A) +
      0 * improperIntegral(G, A)], integralGEReal, integralGE⟩
  have boundError : ∀ X ∈ ℝ, A ≤ X →
      complexAbs(complexCombination(ℂ[1], complexCombination(ℂ[1], K(z),
        ℂ[-1], K(s)), ℂ[-(z - s)], D)(X)) ≤
      realLinearCombination(R[4 * ((complexAbs(ℂ[z - s]) * (1 / half(r))) *
        (complexAbs(ℂ[z - s]) * (1 / half(r))))], R[0], G, G)(X)
    intros X xMember later
    have gMember := FunctionBetween.apply_closed with functionG, xMember
    have typedG : Real(G(X)) by exact gMember
    have kzX := valuesZ with X, xMember
    have ksX := valuesS with X, xMember
    have dX := valuesD with X, xMember
    rw [(complexCombination.value with one, coefficient, valuesInner, valuesD,
      xMember), (complexCombination.value with one, minusOne, valuesZ,
      valuesS, xMember), (valuesGE with X, xMember)]
    have sameError : ℂ[1 * (1 * K(z)(X) + -1 * K(s)(X)) + -(z - s) * D(X)] =
      ℂ[K(z)(X) - K(s)(X) - D(X) * (z - s)] by ring
    have sameBound : R[4 * ((complexAbs(ℂ[z - s]) * (1 / half(r))) *
        (complexAbs(ℂ[z - s]) * (1 / half(r)))) * G(X) + 0 * G(X)] =
        R[(4 * G(X)) * ((complexAbs(ℂ[z - s]) * (1 / half(r))) *
          (complexAbs(ℂ[z - s]) * (1 / half(r))))] by ring
    rw [sameError, sameBound]
    exact taylor with X, xMember, later, z, zMember, zNear
  obtain ⟨_, errorAbs⟩ := ComplexImproperIntegrable.of_dominated with
    localError, integrableGE, boundError
  rw [(improperIntegral.eq with integralGE), errorValue, innerValue]
    at errorAbs
  rw [(parameterIntegral.value with hz), (parameterIntegral.value with hs)]
  have integralZ := complexImproperIntegral.member at K(z), A
  have same : ℂ[complexImproperIntegral(K(z), A) -
      complexImproperIntegral(K(s), A) - complexImproperIntegral(D, A) *
        (z - s)] =
      ℂ[1 * (1 * complexImproperIntegral(K(z), A) +
        -1 * complexImproperIntegral(K(s), A)) +
        -(z - s) * complexImproperIntegral(D, A)] by ring
  rw same
  exact real.quadratic_small with errorAbs, dNonnegative, dBelowε,
    coefficientNonnegative, absorbed

-- Holomorphy under the integral sign. If for each x ≥ A the map
-- s ↦ K(s)(x) is holomorphic on the open set U, each K(s) is integrable
-- on every [A, T], and on each compact subset of U the |K(s)(x)| have a
-- common bound G(x) with ∫_A^∞ G convergent, then every ∫_A^∞ K(s)
-- converges and s ↦ ∫_A^∞ K(s)(x) dx is holomorphic on U.
theorem parameterIntegral.holomorphic (K U : Set) (A : Real)
  requires isOpen : ComplexOpen(U)
  requires values : ∀ s ∈ U, ComplexValuedOn(K(s), ℝ)
  requires local : ∀ s ∈ U, ∀ T ∈ ℝ, A ≤ T →
    ComplexRiemannIntegrable(K(s), A, T)
  requires pointwise : ∀ X ∈ ℝ, A ≤ X → HolomorphicOn(kernelSlice(K, U, X), U)
  requires dominated : ∀ C, C ⊆ U → ComplexCompact(C) →
    (∃ G, ImproperIntegrable(G, A) ∧
      (∀ s ∈ C, ∀ X ∈ ℝ, A ≤ X → complexAbs(K(s)(X)) ≤ G(X)))
  shows (∀ s ∈ U, ComplexImproperIntegrable(K(s), A)) ∧
    HolomorphicOn(parameterIntegral(K, U, A), U)
proof
  have atPoint : ∀ s ∈ U, ComplexImproperIntegrable(K(s), A) ∧
      ComplexDifferentiableAt(parameterIntegral(K, U, A), U, s)
    intros s hs
    have functionD := kernelDerivFrom.function at K, U, s, A with values,
      pointwise, hs
    have valuesD : ComplexValuedOn(kernelDerivFrom(K, U, s, A), ℝ)
      intros X xMember
      exact FunctionBetween.apply_closed with functionD, xMember
    have derivative : ∀ X ∈ ℝ, A ≤ X → kernelDerivFrom(K, U, s, A)(X) =
        complexDeriv(kernelSlice(K, U, X), U)(s)
      intros X xMember later
      have typedX : Real(X) by exact xMember
      have selected := kernelDerivFromValue.selected at K, U, s, A, X with
        values, pointwise, hs
      obtain ⟨_, atLater, _⟩ := selected
      rw (kernelDerivFrom.value with values, pointwise, hs, xMember)
      exact atLater with later
    obtain ⟨integrableS, _, has⟩ := parameterIntegral.derivative_of with
      isOpen, values, local, pointwise, dominated, hs, valuesD, derivative
    have memberI := complexImproperIntegral.member at
      kernelDerivFrom(K, U, s, A), A
    exact ⟨integrableS, complexImproperIntegral(kernelDerivFrom(K, U, s, A),
      A), memberI, has⟩
  have functionF := parameterIntegral.function at K, U, A
  have valuesF : ComplexValuedOn(parameterIntegral(K, U, A), U)
    intros z hz
    exact FunctionBetween.apply_closed with functionF, hz
  refine ⟨?_, isOpen, valuesF, ?_⟩
  . intros s hs
    have both := atPoint with s, hs
    exact both.left
  . intros s hs
    have both := atPoint with s, hs
    exact both.right

-- Differentiation under the integral sign: with s ↦ K(s)(x) holomorphic
-- for every real x, the derivative of s ↦ ∫_A^∞ K(s) is ∫_A^∞ ∂ₛ K(s).
theorem parameterIntegral.has_derivative (K U s : Set) (A : Real)
  requires isOpen : ComplexOpen(U)
  requires values : ∀ s ∈ U, ComplexValuedOn(K(s), ℝ)
  requires local : ∀ s ∈ U, ∀ T ∈ ℝ, A ≤ T →
    ComplexRiemannIntegrable(K(s), A, T)
  requires pointwise : ∀ X ∈ ℝ, HolomorphicOn(kernelSlice(K, U, X), U)
  requires dominated : ∀ C, C ⊆ U → ComplexCompact(C) →
    (∃ G, ImproperIntegrable(G, A) ∧
      (∀ s ∈ C, ∀ X ∈ ℝ, A ≤ X → complexAbs(K(s)(X)) ≤ G(X)))
  requires hs : s ∈ U
  shows ComplexImproperIntegrable(kernelDeriv(K, U, s), A) ∧
    HasComplexDerivativeAt(parameterIntegral(K, U, A), U,
      complexImproperIntegral(kernelDeriv(K, U, s), A), s)
proof
  have pointwiseLater : ∀ X ∈ ℝ, A ≤ X →
      HolomorphicOn(kernelSlice(K, U, X), U)
    intros X xMember later
    exact pointwise with X, xMember
  have functionD := kernelDeriv.function at K, U, s with values, pointwise, hs
  have valuesD : ComplexValuedOn(kernelDeriv(K, U, s), ℝ)
    intros X xMember
    exact FunctionBetween.apply_closed with functionD, xMember
  have derivative : ∀ X ∈ ℝ, A ≤ X → kernelDeriv(K, U, s)(X) =
      complexDeriv(kernelSlice(K, U, X), U)(s)
    intros X xMember later
    exact kernelDeriv.value with values, pointwise, hs, xMember
  obtain ⟨_, integrableD, has⟩ := parameterIntegral.derivative_of with
    isOpen, values, local, pointwiseLater, dominated, hs, valuesD, derivative
  exact ⟨integrableD, has⟩

end ImproperIntegrals
