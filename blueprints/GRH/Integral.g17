-- Improper integrals. A complex function of a real variable is integrated
-- through its real and imaginary parts with the Riemann integral; the
-- improper integral over [A, ∞) is the limit of the integrals over [A, T]
-- as T → ∞, for real and for complex functions. The comparison test, the
-- bound by a dominating function, the integral of x^(−σ) for σ > 1,
-- linearity, splitting at a point; and holomorphy in a complex parameter
-- s of s ↦ ∫_A^∞ K(s)(x) dx under a locally uniform dominating bound, with
-- the derivative under the integral sign.
-- Part of the GRH blueprint.
-- Planned home: Real/Analysis/Integration/Improper.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Integral
import GRH.Holomorphic
import Grace.Cumulus.Real.Analysis.Integration

section ImproperIntegrals
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- Section: Complex functions of a real variable
-- A complex function of a real variable is a function g with g(x) ∈ ℂ for
-- every real x, ComplexValuedOn(g, ℝ); a function needed on [A, ∞) only is
-- extended to ℝ arbitrarily, since the integrals below read only its
-- values there. Its real and imaginary parts are functions ℝ → ℝ.
defgraph complexFunctionRe (g : Set) (X ∈ ℝ) : ℝ := complexRe(g(X))
requires values : ComplexValuedOn(g, ℝ)
proof
  have value := values with member
  exact complexRe.real with value

defgraph complexFunctionIm (g : Set) (X ∈ ℝ) : ℝ := complexIm(g(X))
requires values : ComplexValuedOn(g, ℝ)
proof
  have value := values with member
  exact complexIm.real with value

-- g is Riemann integrable on [A, B] when its real and imaginary parts are.
predicate ComplexRiemannIntegrable (g : Set, A B : Real) :=
  ComplexValuedOn(g, ℝ) ∧ RiemannIntegrable(complexFunctionRe(g), A, B) ∧
  RiemannIntegrable(complexFunctionIm(g), A, B)

-- ∫_A^B g = ∫_A^B re g + i ∫_A^B im g.
def complexIntegral (g : Set, A B : Real) : Set :=
  (riemannIntegral(complexFunctionRe(g), A, B),
    riemannIntegral(complexFunctionIm(g), A, B))

-- Section: Improper integrals
-- G : ℝ → ℝ has improper integral I over [A, ∞): G is Riemann integrable
-- on every [A, T], and ∫_A^T G → I as T → ∞.
predicate HasImproperIntegral (G : Set, A I : Real) :=
  FunctionBetween(G, ℝ, ℝ) ∧
  (∀ T ∈ ℝ, A ≤ T → RiemannIntegrable(G, A, T)) ∧
  (∀ e ∈ ℝ, R[0] < e → ∃ T₀ ∈ ℝ, ∀ T ∈ ℝ, T₀ ≤ T → A ≤ T →
    abs(R[riemannIntegral(G, A, T) - I]) < e)

predicate ImproperIntegrable (G : Set, A : Real) :=
  ∃ I ∈ ℝ, HasImproperIntegral(G, A, I)

-- The complex function g has improper integral I over [A, ∞).
predicate HasComplexImproperIntegral (g : Set, A : Real, I : Set) :=
  ComplexValuedOn(g, ℝ) ∧ I ∈ complexCarrier ∧
  (∀ T ∈ ℝ, A ≤ T → ComplexRiemannIntegrable(g, A, T)) ∧
  (∀ e ∈ ℝ, R[0] < e → ∃ T₀ ∈ ℝ, ∀ T ∈ ℝ, T₀ ≤ T → A ≤ T →
    complexAbs(ℂ[complexIntegral(g, A, T) - I]) < e)

predicate ComplexImproperIntegrable (g : Set, A : Real) :=
  ∃ I ∈ complexCarrier, HasComplexImproperIntegral(g, A, I)

theorem HasImproperIntegral.unique (G : Set) (A I J : Real)
  requires first : HasImproperIntegral(G, A, I)
  requires second : HasImproperIntegral(G, A, J)
  shows I = J
proof
  sorry

theorem HasComplexImproperIntegral.unique (g : Set) (A : Real) (I J : Set)
  requires first : HasComplexImproperIntegral(g, A, I)
  requires second : HasComplexImproperIntegral(g, A, J)
  shows I = J
proof
  sorry

-- ∫_A^∞ G: the limit when it exists, and 0 otherwise, as riemannIntegral
-- is 0 off the integrable functions; every theorem that reads the value
-- assumes it exists.
defunique improperIntegral (G : Set, A : Real) (I ∈ ℝ) :=
  (ImproperIntegrable(G, A) → HasImproperIntegral(G, A, I)) ∧
  (¬ImproperIntegrable(G, A) → I = R[0])
proof
  have alternatives : ImproperIntegrable(G, A) ∨ ¬ImproperIntegrable(G, A)
    by tauto
  cases alternatives with integrable | absent
  . obtain ⟨I, realI, integral⟩ := integrable
    witness I
    refine ⟨realI, ?_⟩
    constructor
    . intro again
      exact integral
    . intro impossible
      exfalso
      exact impossible with ⟨I, realI, integral⟩
  . witness realZero
    refine ⟨realZero.real, ?_⟩
    constructor
    . intro impossible
      exfalso
      exact absent with impossible
    . intro ignored
      rfl
uniqueness
  intros I memberI first J memberJ second
  have alternatives : ImproperIntegrable(G, A) ∨ ¬ImproperIntegrable(G, A)
    by tauto
  cases alternatives with integrable | absent
  . have firstIntegral : HasImproperIntegral(G, A, I) by tauto
    have secondIntegral : HasImproperIntegral(G, A, J) by tauto
    exact HasImproperIntegral.unique with firstIntegral, secondIntegral
  . have firstZero : I = realZero by tauto
    have secondZero : J = realZero by tauto
    cc

-- ∫_A^∞ g for a complex function g, likewise.
defunique complexImproperIntegral (g : Set, A : Real) (I ∈ complexCarrier) :=
  (ComplexImproperIntegrable(g, A) → HasComplexImproperIntegral(g, A, I)) ∧
  (¬ComplexImproperIntegrable(g, A) → I = ℂ[0])
proof
  have alternatives :
    ComplexImproperIntegrable(g, A) ∨ ¬ComplexImproperIntegrable(g, A)
    by tauto
  cases alternatives with integrable | absent
  . obtain ⟨I, memberI, integral⟩ := integrable
    witness I
    refine ⟨memberI, ?_⟩
    constructor
    . intro again
      exact integral
    . intro impossible
      exfalso
      exact impossible with ⟨I, memberI, integral⟩
  . witness complexZero
    refine ⟨complexZero.member, ?_⟩
    constructor
    . intro impossible
      exfalso
      exact absent with impossible
    . intro ignored
      rfl
uniqueness
  intros I memberI first J memberJ second
  have alternatives :
    ComplexImproperIntegrable(g, A) ∨ ¬ComplexImproperIntegrable(g, A)
    by tauto
  cases alternatives with integrable | absent
  . have firstIntegral : HasComplexImproperIntegral(g, A, I) by tauto
    have secondIntegral : HasComplexImproperIntegral(g, A, J) by tauto
    exact HasComplexImproperIntegral.unique with firstIntegral, secondIntegral
  . have firstZero : I = complexZero by tauto
    have secondZero : J = complexZero by tauto
    cc

-- The power x ↦ x^σ as a function ℝ → ℝ (its values at x ≤ 0 are those of
-- realRpow there, and no theorem reads them).
defgraph rpowFunction (S : Real) (X ∈ ℝ) : ℝ := realRpow(X, S)
proof
  have xReal : Real(X) by exact member
  exact realRpow.real at X, S

-- Section: Integrals of complex functions over [A, B]
theorem complexFunctionRe.apply (g : Set) (X : Real)
  requires values : ComplexValuedOn(g, ℝ)
  shows complexFunctionRe(g)(X) = complexRe(g(X))
proof
  have xReal : X ∈ ℝ by typecheck
  exact complexFunctionRe.value at g, X with values, xReal

theorem complexFunctionIm.apply (g : Set) (X : Real)
  requires values : ComplexValuedOn(g, ℝ)
  shows complexFunctionIm(g)(X) = complexIm(g(X))
proof
  have xReal : X ∈ ℝ by typecheck
  exact complexFunctionIm.value at g, X with values, xReal

theorem complexIntegral.member (g : Set) (A B : Real)
  shows complexIntegral(g, A, B) ∈ ℂ
proof
  obtain ⟨reMember, _⟩ := riemannIntegral.selected at complexFunctionRe(g), A, B
  obtain ⟨imMember, _⟩ := riemannIntegral.selected at complexFunctionIm(g), A, B
  have reReal : Real(riemannIntegral(complexFunctionRe(g), A, B))
    by exact reMember
  have imReal : Real(riemannIntegral(complexFunctionIm(g), A, B))
    by exact imMember
  unfold complexIntegral
  exact complexCarrier.pair at riemannIntegral(complexFunctionRe(g), A, B),
    riemannIntegral(complexFunctionIm(g), A, B) with reReal, imReal

theorem complexIntegral.re (g : Set) (A B : Real)
  shows complexRe(complexIntegral(g, A, B)) =
    riemannIntegral(complexFunctionRe(g), A, B)
proof
  unfold complexIntegral
  unfold complexRe
  rw fst.pair

theorem complexIntegral.im (g : Set) (A B : Real)
  shows complexIm(complexIntegral(g, A, B)) =
    riemannIntegral(complexFunctionIm(g), A, B)
proof
  unfold complexIntegral
  unfold complexIm
  rw snd.pair

-- A continuous complex function is integrable on every [A, B].
theorem ComplexRiemannIntegrable.of_continuous (g : Set) (A B : Real)
  requires values : ComplexValuedOn(g, ℝ)
  requires ordered : A ≤ B
  requires continuousRe : ContinuousOn(complexFunctionRe(g),
    closedInterval(A, B))
  requires continuousIm : ContinuousOn(complexFunctionIm(g),
    closedInterval(A, B))
  shows ComplexRiemannIntegrable(g, A, B)
proof
  sorry

-- The integral of a real function, seen in ℂ.
theorem complexIntegral.of_real (g G : Set) (A B : Real)
  requires values : ComplexValuedOn(g, ℝ)
  requires function : FunctionBetween(G, ℝ, ℝ)
  requires real : ∀ X ∈ ℝ, g(X) = complexOfReal(G(X))
  shows complexIntegral(g, A, B) = complexOfReal(riemannIntegral(G, A, B))
proof
  sorry

-- |∫_A^B g| ≤ ∫_A^B G when |g| ≤ G on [A, B].
theorem complexIntegral.abs_le (g G : Set) (A B : Real)
  requires ordered : A ≤ B
  requires integrable : ComplexRiemannIntegrable(g, A, B)
  requires integrableG : RiemannIntegrable(G, A, B)
  requires bound : ∀ X ∈ closedInterval(A, B), complexAbs(g(X)) ≤ G(X)
  shows complexAbs(complexIntegral(g, A, B)) ≤ riemannIntegral(G, A, B)
proof
  sorry

-- ∫_A^B g + ∫_B^C g = ∫_A^C g.
theorem complexIntegral.add_interval (g : Set) (A B C : Real)
  requires first : A ≤ B
  requires second : B ≤ C
  requires integrable : ComplexRiemannIntegrable(g, A, C)
  shows ComplexRiemannIntegrable(g, A, B) ∧
    ComplexRiemannIntegrable(g, B, C) ∧
    ℂ[complexIntegral(g, A, B) + complexIntegral(g, B, C)] =
      complexIntegral(g, A, C)
proof
  sorry

theorem complexIntegral.add (f g : Set) (A B : Real)
  requires ordered : A ≤ B
  requires integrableF : ComplexRiemannIntegrable(f, A, B)
  requires integrableG : ComplexRiemannIntegrable(g, A, B)
  shows ComplexRiemannIntegrable(complexFunctionAdd(f, g, ℝ), A, B) ∧
    complexIntegral(complexFunctionAdd(f, g, ℝ), A, B) =
      ℂ[complexIntegral(f, A, B) + complexIntegral(g, A, B)]
proof
  sorry

theorem complexIntegral.const_mul (c g : Set) (A B : Real)
  requires hc : c ∈ ℂ
  requires ordered : A ≤ B
  requires integrable : ComplexRiemannIntegrable(g, A, B)
  shows ComplexRiemannIntegrable(
      complexFunctionMul(complexFunctionConst(c, ℝ), g, ℝ), A, B) ∧
    complexIntegral(complexFunctionMul(complexFunctionConst(c, ℝ), g, ℝ),
      A, B) = ℂ[c * complexIntegral(g, A, B)]
proof
  sorry

-- Section: Improper integrals, facts
theorem improperIntegral.spec (G : Set) (A : Real)
  requires integrable : ImproperIntegrable(G, A)
  shows HasImproperIntegral(G, A, improperIntegral(G, A))
proof
  obtain ⟨_, exists, _⟩ := improperIntegral.selected at G, A
  exact exists with integrable

theorem improperIntegral.eq (G : Set) (A I : Real)
  requires integral : HasImproperIntegral(G, A, I)
  shows improperIntegral(G, A) = I
proof
  have realI : I ∈ ℝ by typecheck
  have integrable : ImproperIntegrable(G, A) := ⟨I, realI, integral⟩
  have spec := improperIntegral.spec with integrable
  exact HasImproperIntegral.unique with spec, integral

theorem complexImproperIntegral.spec (g : Set) (A : Real)
  requires integrable : ComplexImproperIntegrable(g, A)
  shows HasComplexImproperIntegral(g, A, complexImproperIntegral(g, A))
proof
  obtain ⟨_, exists, _⟩ := complexImproperIntegral.selected at g, A
  exact exists with integrable

theorem complexImproperIntegral.eq (g : Set) (A : Real) (I : Set)
  requires integral : HasComplexImproperIntegral(g, A, I)
  shows complexImproperIntegral(g, A) = I
proof
  obtain ⟨_, memberI, _⟩ := integral
  have integrable : ComplexImproperIntegrable(g, A) := ⟨I, memberI, integral⟩
  have spec := complexImproperIntegral.spec with integrable
  exact HasComplexImproperIntegral.unique with spec, integral

theorem complexImproperIntegral.member (g : Set) (A : Real)
  shows complexImproperIntegral(g, A) ∈ ℂ
proof
  obtain ⟨member, _⟩ := complexImproperIntegral.selected at g, A
  exact member

-- The integral of x^(−σ) over [A, ∞), for A > 0 and σ > 1, is
-- A^(1−σ)/(σ − 1).
theorem rpowFunction.improper_integral (A S : Real)
  requires positive : R[0] < A
  requires exponent : R[1] < S
  shows HasImproperIntegral(rpowFunction(R[-S]), A,
    R[realRpow(A, R[1 - S]) / (S - 1)])
proof
  sorry

-- Domination: if g is integrable on every [A, T] and |g| ≤ G on [A, ∞)
-- with ∫_A^∞ G convergent, then ∫_A^∞ g converges and
-- |∫_A^∞ g| ≤ ∫_A^∞ G.
theorem ComplexImproperIntegrable.of_dominated (g G : Set) (A : Real)
  requires local : ∀ T ∈ ℝ, A ≤ T → ComplexRiemannIntegrable(g, A, T)
  requires integrableG : ImproperIntegrable(G, A)
  requires bound : ∀ X ∈ ℝ, A ≤ X → complexAbs(g(X)) ≤ G(X)
  shows ComplexImproperIntegrable(g, A) ∧
    complexAbs(complexImproperIntegral(g, A)) ≤ improperIntegral(G, A)
proof
  sorry

-- The comparison test with x^(−σ), σ > 1: |g(x)| ≤ C x^(−σ) on [A, ∞),
-- A > 0, gives convergence and |∫_A^∞ g| ≤ C A^(1−σ)/(σ − 1).
theorem ComplexImproperIntegrable.of_rpow_bound (g : Set) (A S C : Real)
  requires positive : R[0] < A
  requires exponent : R[1] < S
  requires local : ∀ T ∈ ℝ, A ≤ T → ComplexRiemannIntegrable(g, A, T)
  requires bound : ∀ X ∈ ℝ, A ≤ X →
    complexAbs(g(X)) ≤ R[C * realRpow(X, R[-S])]
  shows ComplexImproperIntegrable(g, A) ∧
    complexAbs(complexImproperIntegral(g, A)) ≤
      R[C * (realRpow(A, R[1 - S]) / (S - 1))]
proof
  sorry

theorem complexImproperIntegral.add (f g : Set) (A : Real)
  requires integrableF : ComplexImproperIntegrable(f, A)
  requires integrableG : ComplexImproperIntegrable(g, A)
  shows ComplexImproperIntegrable(complexFunctionAdd(f, g, ℝ), A) ∧
    complexImproperIntegral(complexFunctionAdd(f, g, ℝ), A) =
      ℂ[complexImproperIntegral(f, A) + complexImproperIntegral(g, A)]
proof
  sorry

theorem complexImproperIntegral.const_mul (c g : Set) (A : Real)
  requires hc : c ∈ ℂ
  requires integrable : ComplexImproperIntegrable(g, A)
  shows ComplexImproperIntegrable(
      complexFunctionMul(complexFunctionConst(c, ℝ), g, ℝ), A) ∧
    complexImproperIntegral(
      complexFunctionMul(complexFunctionConst(c, ℝ), g, ℝ), A) =
      ℂ[c * complexImproperIntegral(g, A)]
proof
  sorry

-- ∫_A^∞ g = ∫_A^B g + ∫_B^∞ g, and convergence from A and from B are the
-- same for g integrable on [A, B].
theorem complexImproperIntegral.split (g : Set) (A B : Real)
  requires ordered : A ≤ B
  requires local : ComplexRiemannIntegrable(g, A, B)
  shows (ComplexImproperIntegrable(g, A) ↔
      ComplexImproperIntegrable(g, B)) ∧
    (ComplexImproperIntegrable(g, B) →
      complexImproperIntegral(g, A) =
        ℂ[complexIntegral(g, A, B) + complexImproperIntegral(g, B)])
proof
  sorry

-- The tail tends to 0: ∫_T^∞ g → 0 as T → ∞.
theorem complexImproperIntegral.tail (g : Set) (A : Real)
  requires integrable : ComplexImproperIntegrable(g, A)
  shows ∀ e ∈ ℝ, R[0] < e → ∃ T₀ ∈ ℝ, ∀ T ∈ ℝ, T₀ ≤ T → A ≤ T →
    complexAbs(complexImproperIntegral(g, T)) < e
proof
  sorry

-- Section: Integrals depending on a complex parameter
-- A family of complex functions of a real variable indexed by s ∈ U is a
-- set K with K(s) such a function for each s; its value at x as a
-- function of s, and its integral over [A, ∞) as a function of s.
defgraph kernelSlice (K U : Set, X : Real) (s ∈ U) : complexCarrier :=
    K(s)(X)
requires values : ∀ s ∈ U, ComplexValuedOn(K(s), ℝ)
proof
  have function := values with member
  have xReal : X ∈ ℝ by typecheck
  exact function with xReal

defgraph parameterIntegral (K U : Set, A : Real) (s ∈ U) : complexCarrier :=
    complexImproperIntegral(K(s), A)
proof
  exact complexImproperIntegral.member at K(s), A

-- The derivative in s under the integral sign: x ↦ ∂ₛ K(s)(x).
defgraph kernelDeriv (K U s : Set) (X ∈ ℝ) : complexCarrier :=
    complexDeriv(kernelSlice(K, U, X), U)(s)
requires values : ∀ s ∈ U, ComplexValuedOn(K(s), ℝ)
requires holomorphic : ∀ X ∈ ℝ, HolomorphicOn(kernelSlice(K, U, X), U)
requires hs : s ∈ U
proof
  sorry

-- Holomorphy under the integral sign. If for each x ≥ A the map
-- s ↦ K(s)(x) is holomorphic on the open set U, each K(s) is integrable
-- on every [A, T], and on each compact subset of U the |K(s)(x)| have a
-- common bound G(x) with ∫_A^∞ G convergent, then every ∫_A^∞ K(s)
-- converges and s ↦ ∫_A^∞ K(s)(x) dx is holomorphic on U.
theorem parameterIntegral.holomorphic (K U : Set) (A : Real)
  requires isOpen : ComplexOpen(U)
  requires values : ∀ s ∈ U, ComplexValuedOn(K(s), ℝ)
  requires local : ∀ s ∈ U, ∀ T ∈ ℝ, A ≤ T →
    ComplexRiemannIntegrable(K(s), A, T)
  requires pointwise : ∀ X ∈ ℝ, A ≤ X → HolomorphicOn(kernelSlice(K, U, X), U)
  requires dominated : ∀ C, C ⊆ U → ComplexCompact(C) →
    (∃ G, ImproperIntegrable(G, A) ∧
      (∀ s ∈ C, ∀ X ∈ ℝ, A ≤ X → complexAbs(K(s)(X)) ≤ G(X)))
  shows (∀ s ∈ U, ComplexImproperIntegrable(K(s), A)) ∧
    HolomorphicOn(parameterIntegral(K, U, A), U)
proof
  sorry

-- Differentiation under the integral sign: with s ↦ K(s)(x) holomorphic
-- for every real x, the derivative of s ↦ ∫_A^∞ K(s) is ∫_A^∞ ∂ₛ K(s).
theorem parameterIntegral.has_derivative (K U s : Set) (A : Real)
  requires isOpen : ComplexOpen(U)
  requires values : ∀ s ∈ U, ComplexValuedOn(K(s), ℝ)
  requires local : ∀ s ∈ U, ∀ T ∈ ℝ, A ≤ T →
    ComplexRiemannIntegrable(K(s), A, T)
  requires pointwise : ∀ X ∈ ℝ, HolomorphicOn(kernelSlice(K, U, X), U)
  requires dominated : ∀ C, C ⊆ U → ComplexCompact(C) →
    (∃ G, ImproperIntegrable(G, A) ∧
      (∀ s ∈ C, ∀ X ∈ ℝ, A ≤ X → complexAbs(K(s)(X)) ≤ G(X)))
  requires hs : s ∈ U
  shows ComplexImproperIntegrable(kernelDeriv(K, U, s), A) ∧
    HasComplexDerivativeAt(parameterIntegral(K, U, A), U,
      complexImproperIntegral(kernelDeriv(K, U, s), A), s)
proof
  sorry

end ImproperIntegrals
