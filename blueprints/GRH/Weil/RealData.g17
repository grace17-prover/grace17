-- The Fock model inside the adelic Weil representation: the adelic
-- Heisenberg datum of signs s splits as the real datum of the signs
-- (τ, i) ↦ sᵢ on ℂ^{Φ × n} plus the finite datum on 𝔸_fⁿ; real vectors
-- in Fock coordinates; the tensor v ⊗ f = ∫ v(y) ϱ(y)f dy of a Fock
-- vector v with f ∈ 𝒮(V), the projection on real vacua, the inner
-- product and theta functional of v ⊗ f; the theta function of a real
-- vacuum; the scaled Taylor series T_a f (jet series) whose coefficient
-- at z^m is a^{|m|}/m! θ(v_m ⊗ f); tight frames, and the relation of
-- Galois-conjugate jets.
-- Source: grh-compact/src/Lib/Weil/MixedModel/AdelicSum.lean (realSigns,
-- adelicSum), Lib/General/NumberTheory/UpsilonValues.lean (scaleIdele),
-- Lib/Weil/Construction/PairDefs.lean (realVec, realCoord,
-- realVec_realCoord_add, integrated, projReal, dataInner),
-- Projections.lean (integrated_integrated, projReal_vacElem),
-- Lib/Weil/Fock/RealData.lean (dataInner_integrated, theta_integrated),
-- Lib/Weil/Fock/EntireTheta.lean (entireTheta, eq_zero_of_realVec,
-- entireTheta_eq_integral), Lib/Weil/Construction/DataProduct.lean
-- (Space.jetSeries, jet_jetSeries_eq_theta), and
-- Lib/Weil/Construction/ConjugateJetDefs.lean (finiteImage,
-- IsTightFrame, Space.IsJetConjugate, constantCoeff_jetSeries). Part of:
-- "Adelic Weil representation of a unitary group and the invariant theta
-- functional (known result; see Lib.Weil.DualPair.PairSplitting)" and
-- "Bargmann–Fock model of the harmonic (oscillator) representation of
-- U(p,q) (known result; see Lib.Weil.Fock.OscillatorPair)".
-- Encoding. The infinite places are the embeddings σ of the CM type Φ of
-- the Weil data W (as in GRH.Weil.Unramified), so the Fock coordinates of
-- 𝔸ⁿ are ℂ^{Φ × n}. A power series in the variables Φ × n is an element
-- of mvSeriesCarrier(ℂ, Φ × n) (GRH.Polynomial.PowerSeries). The source's
-- permutation π of the places in IsJetConjugate is given here by the
-- automorphism σ of ℂ it comes from: the renaming sends the variable
-- (φ, i) to (σ⁻¹ ∘ φ, i) (Parameters.placePerm s σ sends φ to σ ∘ φ by
-- Parameters.placePerm_spec).
-- Part of the GRH blueprint (layer 4, Lib/Weil, stage S3).
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Weil.RealData
import GRH.Weil.Fock
import GRH.Weil.Construction2
import GRH.Polynomial.PowerSeries

section RealData
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- Section: Fock coordinates of the adelic vectors
-- The index set Φ × n of the Fock coordinates, and AdelicSum.lean,
-- realSigns E s: (τ, i) ↦ sᵢ.
def fockIndex (W n : Set) : Set := WeilDatum.cmType(W) × n

def realSigns (W n s : Set) : Set := { (p, s(snd(p))) | p ∈ fockIndex(W, n) }

-- UpsilonValues.lean, scaleIdele: its component (2π Im τ(ȷ))^{−1/2} at the
-- infinite place τ (its finite part is α).
def scaleAt (W τ : Set) : Set :=
  complexOfReal(realInv(realSqrt(R[2 * realPi * complexIm(τ(WeilDatum.j(W)))])))

-- PairDefs.lean, realVec y: the adelic vector with infinite part
-- (scaleIdele · y(·, i))ᵢ and finite part zero.
def realVecInf (W y i : Set) : Set :=
  { (τ, ℂ[scaleAt(W, τ) * y((τ, i))]) | τ ∈ WeilDatum.cmType(W) }

def realVec (W n y : Set) : Set :=
  { (i, (realVecInf(W, y, i), finZero(WeilDatum.field(W)))) | i ∈ n }

-- PairDefs.lean, realCoord y: (τ, i) ↦ y_{iτ}/scaleIdele_τ, the archimedean
-- part of an adelic vector in Fock coordinates.
def realCoord (W n y : Set) : Set :=
  { (p, complexDiv(fst(y(snd(p)))(fst(p)), scaleAt(W, fst(p)))) | p ∈ fockIndex(W, n) }

-- The adelic vector with zero infinite part and the finite part of y.
def finitePartVec (W n y : Set) : Set :=
  { (i, (zeroInfinite(W), snd(y(i)))) | i ∈ n }

-- PairDefs.lean, realVec_realCoord_add: realVec(realCoord y) + (0, y_f) = y.
theorem realVec.realCoord_add (W n y : Set)
  requires weil : IsWeilDatum(W)
  requires finite : Finite(n)
  requires hy : y ∈ adelicVectors(W, n)
  shows hAdd(adelicVectorGroup(W, n), realVec(W, n, realCoord(W, n, y)),
    finitePartVec(W, n, y)) = y
proof
  sorry

-- AdelicSum.lean, adelicSum: (y, z) ↦ scaleIdele · (y, z), that is
-- (y, z) ↦ ((scale_τ y(τ, i))_τ, α zᵢ)ᵢ, an orthogonal sum of the real
-- datum of realSigns and the finite datum (finHeis, finVac) onto the
-- adelic datum of signs s.
def adelicSumValue (W n p : Set) : Set :=
  { (i, (realVecInf(W, fst(p), i), finMul(WeilDatum.field(W), WeilDatum.alpha(W),
      snd(p)(i)))) | i ∈ n }

def adelicSumMap (W n : Set) : Set :=
  { (p, adelicSumValue(W, n, p)) | p ∈ cVectors(fockIndex(W, n)) × finVectors(W, n) }

theorem adelicSumMap.orthogonal (W n s : Set)
  requires weil : IsWeilDatum(W)
  requires finite : Finite(n)
  requires signs : SignsOn(n, s)
  shows OrthogonalSum(adelicVectorGroup(W, n), adelicVectorSpace(W, n), adelicBeta(W, n, s),
    vacuumFn(W, n), cVectorGroup(fockIndex(W, n)), cVectorSpace(fockIndex(W, n)),
    realHeis(fockIndex(W, n), realSigns(W, n, s)), realVac(fockIndex(W, n)),
    finVectorGroup(W, n), finVectorSpace(W, n), finBeta(W, n), finVac(W, n),
    adelicSumMap(W, n))
proof
  sorry

-- AdelicSum.lean: adelicSum (y, 0) = realVec y.
theorem adelicSumMap.real (W n y : Set)
  requires weil : IsWeilDatum(W)
  requires finite : Finite(n)
  requires hy : y ∈ cVectors(fockIndex(W, n))
  shows adelicSumMap(W, n)((y, hZero(finVectorGroup(W, n)))) = realVec(W, n, y)
proof
  sorry

-- Section: Fock vectors tensored with data
-- The Fock space of the real datum of V: functions on ℂ^{Φ × n}.
def realFock (W n s : Set) : Set := fockSpace(fockIndex(W, n), realSigns(W, n, s))

-- y ↦ ϱ(realVec y) on 𝒮(V) (PairDefs.lean, V.heisRep.left (adelicSum ..)).
def realDataRep (W n s : Set) : Set :=
  { (y, dataHeis(W, n, s, realVec(W, n, y))) | y ∈ cVectors(fockIndex(W, n)) }

-- PairDefs.lean, integrated: v ⊗ f = ∫ v(y) ϱ(realVec y)f dy over ℂ^{Φ × n}
-- with the measure realMeasure.
def dataIntegrated (W n s v f : Set) : Set :=
  integrated(cVectorGroup(fockIndex(W, n)), cVectorSpace(fockIndex(W, n)),
    realMeasure(fockIndex(W, n)), dataModule(W, n, s), dataNorm(W, n, s),
    realDataRep(W, n, s), v, f)

-- PairDefs.lean, projReal = integrated vacVector: the projection on real
-- vacua.
def projReal (W n s f : Set) : Set := dataIntegrated(W, n, s, realVac(fockIndex(W, n)), f)

-- PairDefs.lean, dataInner: ⟨c, c′⟩ = ∫ c̄ c′ on 𝒮(V).
def dataInner (W n f g : Set) : Set :=
  modelInner(adelicVectorGroup(W, n), adelicVectorSpace(W, n), vacuumMeasure(W, n), f, g)

-- PairDefs.lean, integrated (its type): a bounded bilinear map
-- 𝓕 × 𝒮(V) → 𝒮(V).
theorem dataIntegrated.mem (W n s v f : Set)
  requires weil : IsWeilDatum(W)
  requires finite : Finite(n)
  requires signs : SignsOn(n, s)
  requires hv : v ∈ realFock(W, n, s)
  requires hf : f ∈ dataSpace(W, n, s)
  shows dataIntegrated(W, n, s, v, f) ∈ dataSpace(W, n, s) ∧
    dataNorm(W, n, s)(dataIntegrated(W, n, s, v, f)) ≤
      R[fockNorm(fockIndex(W, n), realSigns(W, n, s))(v) * dataNorm(W, n, s)(f)]
proof
  sorry

-- Projections.lean, integrated_integrated: v ⊗ (w ⊗ f) = w(0) (v ⊗ f).
theorem dataIntegrated.twice (W n s v w f : Set)
  requires weil : IsWeilDatum(W)
  requires finite : Finite(n)
  requires signs : SignsOn(n, s)
  requires hv : v ∈ realFock(W, n, s)
  requires hw : w ∈ realFock(W, n, s)
  requires hf : f ∈ dataSpace(W, n, s)
  shows dataIntegrated(W, n, s, v, dataIntegrated(W, n, s, w, f)) =
    Module.smul(dataModule(W, n, s))(w(hZero(cVectorGroup(fockIndex(W, n)))),
      dataIntegrated(W, n, s, v, f))
proof
  sorry

-- Projections.lean, projReal_vacElem: the vacuum is a real vacuum.
theorem projReal.vacuum (W n s : Set)
  requires weil : IsWeilDatum(W)
  requires finite : Finite(n)
  requires signs : SignsOn(n, s)
  shows projReal(W, n, s, dataVacuum(W, n)) = dataVacuum(W, n)
proof
  sorry

-- RealData.lean, dataInner_integrated:
-- ⟨v ⊗ f, w ⊗ f′⟩ = ⟨v, w⟩ ⟨P f, P f′⟩, P = projReal.
theorem dataIntegrated.inner (W n s v w f g : Set)
  requires weil : IsWeilDatum(W)
  requires finite : Finite(n)
  requires signs : SignsOn(n, s)
  requires hv : v ∈ realFock(W, n, s)
  requires hw : w ∈ realFock(W, n, s)
  requires hf : f ∈ dataSpace(W, n, s)
  requires hg : g ∈ dataSpace(W, n, s)
  shows dataInner(W, n, dataIntegrated(W, n, s, v, f), dataIntegrated(W, n, s, w, g)) =
    ℂ[realInner(fockIndex(W, n), v, w) *
      dataInner(W, n, projReal(W, n, s, f), projReal(W, n, s, g))]
proof
  sorry

-- RealData.lean, theta_integrated: θ(v ⊗ f) = ∫ v(y) f(realVec y) dy,
-- f(x) = θ(ϱ(x)f).
def thetaIntegrand (V v f : Set) : Set :=
  { (y, ℂ[v(y) * spaceTheta(V, spaceHeis(V, realVec(ThetaSpace.weil(V), ThetaSpace.rank(V), y),
      f))]) | y ∈ cVectors(fockIndex(ThetaSpace.weil(V), ThetaSpace.rank(V))) }

-- v ⊗ f for a space with its theta functional.
def spaceIntegrated (V v f : Set) : Set :=
  dataIntegrated(ThetaSpace.weil(V), ThetaSpace.rank(V), ThetaSpace.signs(V), v, f)

def spaceRealFock (V : Set) : Set :=
  realFock(ThetaSpace.weil(V), ThetaSpace.rank(V), ThetaSpace.signs(V))

def spaceFockIndex (V : Set) : Set := fockIndex(ThetaSpace.weil(V), ThetaSpace.rank(V))

def spaceRealSigns (V : Set) : Set :=
  realSigns(ThetaSpace.weil(V), ThetaSpace.rank(V), ThetaSpace.signs(V))

def spaceProjReal (V f : Set) : Set :=
  projReal(ThetaSpace.weil(V), ThetaSpace.rank(V), ThetaSpace.signs(V), f)

theorem spaceIntegrated.theta (V v f : Set)
  requires space : IsThetaSpace(V)
  requires hv : v ∈ spaceRealFock(V)
  requires hf : f ∈ spaceData(V)
  shows spaceTheta(V, spaceIntegrated(V, v, f)) =
    hIntegral(cVectorSpace(spaceFockIndex(V)), realMeasure(spaceFockIndex(V)),
      thetaIntegrand(V, v, f))
proof
  sorry

-- Section: The theta function of a real vacuum
-- EntireTheta.lean, entireTheta f: Θ_f(y) = θ(ϱ(realVec y)f) exp(|y|²/2).
def entireTheta (V f : Set) : Set :=
  { (y, complexDiv(spaceTheta(V, spaceHeis(V, realVec(ThetaSpace.weil(V),
      ThetaSpace.rank(V), y), f)), realVac(spaceFockIndex(V))(y))) |
    y ∈ cVectors(spaceFockIndex(V)) }

-- EntireTheta.lean, eq_zero_of_realVec: f is zero when θ(ϱ(realVec y)f)
-- vanishes for every y.
theorem entireTheta.eq_zero (V f : Set)
  requires space : IsThetaSpace(V)
  requires hf : f ∈ spaceData(V)
  requires vanish : ∀ y ∈ cVectors(spaceFockIndex(V)),
    spaceTheta(V, spaceHeis(V, realVec(ThetaSpace.weil(V), ThetaSpace.rank(V), y), f)) =
      complexZero
  shows f = Module.zero(spaceModule(V))
proof
  sorry

-- EntireTheta.lean, entireTheta_eq_integral: for positive signs and a
-- real vacuum f (P f = f), Θ_f(y) = ∫ exp(Σ_p y_p conj w_p) e(w) f(w) dw,
-- f(w) = θ(ϱ(realVec w)f); in particular Θ_f is entire
-- (differentiable_entireTheta).
def entireIntegrand (V f y : Set) : Set :=
  { (w, ℂ[complexExp(cDot(spaceFockIndex(V), w, y)) *
      (realVac(spaceFockIndex(V))(w) * spaceTheta(V, spaceHeis(V,
        realVec(ThetaSpace.weil(V), ThetaSpace.rank(V), w), f)))]) |
    w ∈ cVectors(spaceFockIndex(V)) }

theorem entireTheta.eq_integral (V f y : Set)
  requires space : IsThetaSpace(V)
  requires positive : ThetaSpace.signs(V) = unitSigns(ThetaSpace.rank(V))
  requires hf : f ∈ spaceData(V)
  requires real : spaceProjReal(V, f) = f
  requires hy : y ∈ cVectors(spaceFockIndex(V))
  shows entireTheta(V, f)(y) =
    hIntegral(cVectorSpace(spaceFockIndex(V)), realMeasure(spaceFockIndex(V)),
      entireIntegrand(V, f, y))
proof
  sorry

-- Section: Jet series
-- The Fock vector v_m of the monomial z^m (polyVector of monomial m 1).
def monomialVector (V m : Set) : Set :=
  polyVector(spaceFockIndex(V), spaceRealSigns(V),
    mvMonomial(complexRing, spaceFockIndex(V), m, complexOne))

-- DataProduct.lean, Space.jetSeries a f: the power series in the
-- variables Φ × n whose coefficient at z^m is a^{|m|}/m! θ(v_m ⊗ f).
def jetCoeff (V a f m : Set) : Set :=
  ℂ[complexDiv(ℂ[a ^ monomialDegree(spaceFockIndex(V), m)],
      monomialFactorial(spaceFockIndex(V), m)) *
    spaceTheta(V, spaceIntegrated(V, monomialVector(V, m), f))]

def jetSeries (V a f : Set) : Set :=
  { (m, jetCoeff(V, a, f, m)) | m ∈ monomials(spaceFockIndex(V)) }

theorem jetSeries.mem (V a f : Set)
  requires space : IsThetaSpace(V)
  requires ha : a ∈ complexCarrier
  requires hf : f ∈ spaceData(V)
  shows jetSeries(V, a, f) ∈ mvSeriesCarrier(complexRing, spaceFockIndex(V))
proof
  sorry

-- ConjugateJetDefs.lean, Space.constantCoeff_jetSeries: the constant
-- coefficient of T_a f is θ(P f).
theorem jetSeries.constant_coeff (V a f : Set)
  requires space : IsThetaSpace(V)
  requires ha : a ∈ complexCarrier
  requires hf : f ∈ spaceData(V)
  shows mvSeriesConstantCoeff(spaceFockIndex(V), jetSeries(V, a, f)) =
    spaceTheta(V, spaceProjReal(V, f))
proof
  sorry

-- DataProduct.lean, Space.jet_jetSeries_eq_theta: for a polynomial P,
-- Σ_m m! P_m (T_a f)_m = θ(v_{P(aX)} ⊗ f) (the pairing jet P (T_a f)).
def jetPairingTerms (V P F : Set) : Set :=
  { (m, ℂ[monomialFactorial(spaceFockIndex(V), m) * P(m) * F(m)]) |
    m ∈ mvSupport(complexRing, spaceFockIndex(V), P) }

def scaledVariables (V a : Set) : Set :=
  { (p, call2(Ring.mul(polynomialRing(complexRing, spaceFockIndex(V))),
      polynomialConstant(complexRing, spaceFockIndex(V))(a),
      X(complexRing, spaceFockIndex(V), p))) | p ∈ spaceFockIndex(V) }

theorem jetSeries.jet (V a f P : Set)
  requires space : IsThetaSpace(V)
  requires ha : a ∈ complexCarrier
  requires hf : f ∈ spaceData(V)
  requires hP : P ∈ cPolys(spaceFockIndex(V))
  shows groupFiniteSum(complexAdditiveGroup, mvSupport(complexRing, spaceFockIndex(V), P),
      jetPairingTerms(V, P, jetSeries(V, a, f))) =
    spaceTheta(V, spaceIntegrated(V, polyVector(spaceFockIndex(V), spaceRealSigns(V),
      mvBind(complexRing, spaceFockIndex(V), spaceFockIndex(V), scaledVariables(V, a))(P)), f))
proof
  sorry

-- Section: Conjugate jets and tight frames
-- The embedding σ⁻¹ ∘ φ of the field of W, for σ a bijection of ℂ and φ
-- an embedding (the place (placePerm s σ)⁻¹ φ of the source).
def placePullback (W σ φ : Set) : Set :=
  { q ∈ Ring.carrier(WeilDatum.field(W)) × complexCarrier | σ(snd(q)) = φ(fst(q)) }

-- The renaming (φ, i) ↦ (σ⁻¹ ∘ φ, i) of the variables (the source's
-- Equiv.Prod.map π.symm id).
def placeRenaming (V σ : Set) : Set :=
  { (p, (placePullback(ThetaSpace.weil(V), σ, fst(p)), snd(p))) | p ∈ spaceFockIndex(V) }

-- ConjugateJetDefs.lean, Space.IsJetConjugate σ π a t f f′ with π the
-- permutation of the places induced by σ: (T_a f)^σ = rename(π⁻¹)(T_t f′).
predicate JetConjugateAt (V σ a t f g : Set) :=
  IsThetaSpace(V) ∧ a ∈ complexCarrier ∧ t ∈ complexCarrier ∧
  f ∈ spaceData(V) ∧ g ∈ spaceData(V) ∧
  mvSeriesMap(complexRing, complexRing, spaceFockIndex(V), σ)(jetSeries(V, a, f)) =
    mvSeriesRename(complexRing, spaceFockIndex(V), spaceFockIndex(V), placeRenaming(V, σ),
      jetSeries(V, t, g))

-- ConjugateJetDefs.lean, finiteImage w: the finite adelic vector α⁻¹ wᵢ.
def finiteImage (W I w : Set) : Set :=
  { (i, finMul(WeilDatum.field(W), finInv(WeilDatum.field(W), WeilDatum.alpha(W)),
      finOf(WeilDatum.field(W), w(i)))) | i ∈ I }

-- ConjugateJetDefs.lean, IsTightFrame w m M: the wᵢ lie in E ∩ αÔ and,
-- taken mᵢ times, form a tight frame of length M:
-- Σᵢ mᵢ σ(wᵢ) conj τ(wᵢ) = M δ_στ for σ, τ in the CM type.
def frameTerms (I w m σ τ : Set) : Set :=
  { (i, ℂ[complexOfReal(realNat(m(i))) * (σ(w(i)) * complexConj(τ(w(i))))]) | i ∈ I }

predicate IsTightFrame (W I w m M : Set) :=
  Finite(I) ∧ FunctionBetween(w, I, Ring.carrier(WeilDatum.field(W))) ∧
  FunctionBetween(m, I, ℕ) ∧ M ∈ ℕ ∧
  (∀ i ∈ I, finiteImage(W, I, w)(i) ∈ finInt(WeilDatum.field(W))) ∧
  (∀ σ ∈ WeilDatum.cmType(W), ∀ τ ∈ WeilDatum.cmType(W),
    (σ = τ → groupFiniteSum(complexAdditiveGroup, I, frameTerms(I, w, m, σ, τ)) =
      complexOfReal(realNat(M))) ∧
    (σ ≠ τ → groupFiniteSum(complexAdditiveGroup, I, frameTerms(I, w, m, σ, τ)) = complexZero))

end RealData
