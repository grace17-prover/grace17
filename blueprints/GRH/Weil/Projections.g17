-- The lattice model of the finite Heisenberg group and the projections
-- of the data space: the Haar measure on 𝔸_fⁿ giving Ôⁿ mass one, the
-- finite vacuum, self-duality of Ôⁿ for ψ₀; the projection P^S on
-- vectors fixed by the finite Heisenberg operators at the places of S
-- and their conjugates; its laws on ϱ, on v ⊗ f, on the vacuum, and
-- the vacuum coefficient ⟨e, f⟩ e = P^∞ P^all f.
-- Source: grh-compact/src/Lib/Weil/Construction/FiniteVacuum.lean
-- (latticeMeasure, latticeMeasure_stdLattice, mem_stdLattice_iff_psi₀,
-- integral_psi₀_stdLattice, isVacuum_finVac), PairDefs.lean (projOn),
-- Projections.lean (projOn_ϱ, projOn_integrated, projOn_vacElem,
-- projOn_ω, projOn_projOn, the vacuum projection). Part of: "Adelic Weil
-- representation of a unitary group and the invariant theta functional
-- (known result; see Lib.Weil.DualPair.PairSplitting)."
-- Encoding. A set S of finite places is a subset of finPlaces(E); its
-- conjugate closure is S ∪ S̄ with w̄ = conjugatePlace(E, w)
-- (GRH.Adelic.CuspForms). The source's strongIntegral over Ôⁿ is the
-- Bochner integral of the 𝒮(V)-valued function against the restriction
-- of latticeMeasure to Ôⁿ. The Haar measure on 𝔸_fⁿ is named by its
-- normalisation (Ôⁿ of mass one), unique among regular Haar measures.
-- Part of the GRH blueprint (layer 4, Lib/Weil, stage S3).
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Weil.Projections
import GRH.Weil.Operators
import GRH.Adelic.CuspForms

section Projections
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- Section: The lattice model
-- FiniteVacuum.lean, latticeMeasure E n: the Haar measure on 𝔸_fⁿ giving
-- Ôⁿ mass one.
def latticeMeasure (W n : Set) : Set :=
  ⋃({ μ ∈ 𝒫(borelSigma(finVectorSpace(W, n)) × ennreal) |
    RegularHaarMeasure(finVectorGroup(W, n), finVectorSpace(W, n), μ) ∧
    μ(stdLattice(W, n)) = realOne })

theorem latticeMeasure.haar (W n : Set)
  requires weil : IsWeilDatum(W)
  requires finite : Finite(n)
  shows RegularHaarMeasure(finVectorGroup(W, n), finVectorSpace(W, n), latticeMeasure(W, n)) ∧
    latticeMeasure(W, n)(stdLattice(W, n)) = realOne
proof
  sorry

-- FiniteVacuum.lean, mem_stdLattice_iff_psi₀: Ôⁿ is self-dual for
-- (x, y) ↦ ψ₀(y*x).
theorem stdLattice.self_dual (W n x : Set)
  requires weil : IsWeilDatum(W)
  requires finite : Finite(n)
  requires hx : x ∈ finVectors(W, n)
  shows x ∈ stdLattice(W, n) ↔ ∀ y ∈ stdLattice(W, n), psiZero(W, finDot(W, n, y, x)) = complexOne
proof
  sorry

-- FiniteVacuum.lean, integral_psi₀_stdLattice: ∫_{Ôⁿ} ψ₀(x*y) dy is 1 for
-- x ∈ Ôⁿ and 0 otherwise.
def psiDotOn (W n x : Set) : Set :=
  { (y, psiZero(W, finDot(W, n, x, y))) | y ∈ finVectors(W, n) }

def latticeIndicatorValue (W n x : Set) : Set :=
  ⋃({ c ∈ complexCarrier | (x ∈ stdLattice(W, n) ∧ c = complexOne) ∨
    (x ∉ stdLattice(W, n) ∧ c = complexZero) })

theorem stdLattice.integral_psi (W n x : Set)
  requires weil : IsWeilDatum(W)
  requires finite : Finite(n)
  requires hx : x ∈ finVectors(W, n)
  shows hIntegral(finVectorSpace(W, n), restrictMeasure(borelSpace(finVectorSpace(W, n)),
      latticeMeasure(W, n), stdLattice(W, n)), psiDotOn(W, n, x)) =
    latticeIndicatorValue(W, n, x)
proof
  sorry

-- FiniteVacuum.lean, isVacuum_finVac: the finite vacuum is a vacuum for
-- the finite datum and latticeMeasure.
theorem finVac.vacuum (W n : Set)
  requires weil : IsWeilDatum(W)
  requires finite : Finite(n)
  shows IsVacuum(finVectorGroup(W, n), finVectorSpace(W, n), latticeMeasure(W, n), finBeta(W, n),
    finVac(W, n))
proof
  sorry

-- Section: The projections P^S
-- S ∪ S̄ for a set S of finite places.
def placeConjugates (W S : Set) : Set :=
  { conjugatePlace(WeilDatum.field(W), w) | w ∈ S }

def conjClosure (W S : Set) : Set := S ∪ placeConjugates(W, S)

-- idem(T) · y: the part of y above the places T.
def idemPart (W n T y : Set) : Set :=
  { (i, finMul(WeilDatum.field(W), idemAdele(WeilDatum.field(W), T), y(i))) | i ∈ n }

-- y ↦ finHeisOp(idem(S ∪ S̄) y) f on 𝔸_fⁿ.
def projIntegrand (W n s S f : Set) : Set :=
  { (y, finHeisOp(W, n, s, idemPart(W, n, conjClosure(W, S), y), f)) | y ∈ finVectors(W, n) }

-- PairDefs.lean, Space.projOn S: P^S f, the mean over y ∈ Ôⁿ of
-- finHeisOp(idem(S ∪ S̄) y) f.
def projOn (W n s S f : Set) : Set :=
  hBanachIntegral(finVectorSpace(W, n), restrictMeasure(borelSpace(finVectorSpace(W, n)),
    latticeMeasure(W, n), stdLattice(W, n)), dataModule(W, n, s), dataNorm(W, n, s),
    projIntegrand(W, n, s, S, f))

-- A set of finite places.
predicate FinPlaceSet (W S : Set) := S ⊆ finPlaces(WeilDatum.field(W))

-- Projections.lean: P^S is a bounded idempotent fixing the vacuum
-- (projOn_vacElem, projOn_projOn), commuting with v ⊗ ·
-- (projOn_integrated) and with ϱ(y) for y vanishing above S ∪ S̄
-- (projOn_ϱ).
def vanishesAbove (W n T y : Set) : Set := { i ∈ n | ∀ w ∈ T, snd(y(i))(w) ≠
  Ring.zero(adicCompletionField(WeilDatum.field(W), w)) }

theorem projOn.laws (W n s S f v y : Set)
  requires weil : IsWeilDatum(W)
  requires finite : Finite(n)
  requires signs : SignsOn(n, s)
  requires places : FinPlaceSet(W, S)
  requires hf : f ∈ dataSpace(W, n, s)
  requires hv : v ∈ realFock(W, n, s)
  requires hy : y ∈ adelicVectors(W, n)
  requires vanish : vanishesAbove(W, n, conjClosure(W, S), y) = ∅
  shows projOn(W, n, s, S, f) ∈ dataSpace(W, n, s) ∧
    projOn(W, n, s, S, projOn(W, n, s, S, f)) = projOn(W, n, s, S, f) ∧
    projOn(W, n, s, S, dataVacuum(W, n)) = dataVacuum(W, n) ∧
    projOn(W, n, s, S, dataIntegrated(W, n, s, v, f)) =
      dataIntegrated(W, n, s, v, projOn(W, n, s, S, f)) ∧
    projOn(W, n, s, S, dataHeis(W, n, s, y)(f)) = dataHeis(W, n, s, y)(projOn(W, n, s, S, f))
proof
  sorry

-- Projections.lean, the vacuum coefficient: ⟨e, f⟩ e = P^∞ P^all f, with
-- P^∞ = projReal and P^all = projOn of all finite places.
theorem projOn.vacuum_coefficient (W n s f : Set)
  requires weil : IsWeilDatum(W)
  requires finite : Finite(n)
  requires signs : SignsOn(n, s)
  requires hf : f ∈ dataSpace(W, n, s)
  shows Module.smul(dataModule(W, n, s))(dataInner(W, n, dataVacuum(W, n), f), dataVacuum(W, n)) =
    projReal(W, n, s, projOn(W, n, s, finPlaces(WeilDatum.field(W)), f))
proof
  sorry

-- Projections.lean (after projOn_ω): if the finite unitary k stabilises
-- the standard lattice (k ∈ K₀) and is supported on S ∪ S̄ (the identity
-- at the other places), and P^S f = f, then ω(k)f = f; k acts as the
-- adelic point (1, k).
def finiteUnitaryPoint (W n k : Set) : Set :=
  { (q, (fst(matOne(adeleRingOf(W), n)(q)), k(q))) | q ∈ n × n }

predicate SupportedOn (W n T k : Set) :=
  ∀ q ∈ n × n, ∀ w ∈ finPlaces(WeilDatum.field(W)), w ∉ T →
    k(q)(w) = matOne(finiteAdeleRing(WeilDatum.field(W)), n)(q)(w)

theorem projOn.omega_fixed (W υ n s S k f : Set)
  requires splitting : SplittingChar(W, υ)
  requires finite : Finite(n)
  requires signs : SignsOn(n, s)
  requires places : FinPlaceSet(W, S)
  requires hk : k ∈ kfMatrices(WeilDatum.field(W), n)
  requires supported : SupportedOn(W, n, conjClosure(W, S), k)
  requires hf : f ∈ dataSpace(W, n, s)
  requires fixed : projOn(W, n, s, S, f) = f
  shows dataOmega(W, υ, n, s, finiteUnitaryPoint(W, n, k))(f) = f
proof
  sorry

end Projections
