-- The finite pieces of the first Weil group: the Kronecker product of
-- invertible matrices and the homomorphism U(S) × U(T) → U(T ⊗ Kᵀ),
-- (g, h) ↦ h ⊗ (g⁻¹)ᵀ, through which a pair of unitary groups acts on
-- Hom(S, T); and Gauss sums over matrix rings: primitive residue
-- characters, the finite Fourier transform on matrices and its
-- inversion, Gauss sums of primitive determinant characters, the action
-- of GLₙ on unimodular vectors, iterated composites and tensor chains,
-- and local homomorphisms reflecting invertible matrices.
-- Source: grh-compact/src/Lib/Weil/DualPair/Kronecker.lean (kroneckerGL,
-- U.kron, map_kronecker; part of "Theta kernels of unitary dual pairs:
-- functoriality, seesaw, growth, rapid decay (known result; see
-- Lib.Weil.DualPair.KernelDecay)") and Lib/Weil/GaussSum/LocalHomUnit.lean
-- (part of "Gauss sums of a character of the determinant over matrix
-- rings (known result; see Lib.Weil.GaussSum.ShearInvariance)").
-- The third file of the group GRH.Weil.Construction,
-- Lib/Weil/Fock/FockVacuum.lean, is stated in GRH.Weil.Fock, on
-- GRH.DiscreteSeries.Basic (realHeis, realVac, holCoord, posProj,
-- principalMinor, realMeasure).
-- Encoding. Finite index sets are sets, matrices over a ring record R are
-- functions on m × n (GRH.Matrix.Basic); additive characters of a finite
-- ring R are those of its additive group (GRH.Fourier.FiniteAbelian),
-- multiplicative characters are GRH.Characters.Mul's MulChar. The source's
-- families of types S j, M j indexed by ℕ are families of module records.
-- Part of the GRH blueprint (layer 4, Lib/Weil, stage S1).
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Weil.Construction.Local
import GRH.Characters.Mul
import GRH.Fourier.FiniteAbelian
import GRH.Linear.Tensor

section Local
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)

-- Section: Kronecker products
-- The Kronecker product (A ⊗ B)[(i, k), (j, l)] = A[i, j] B[k, l] of an
-- m × n and a p × q matrix (Mathlib's kroneckerMap (· * ·)).
def matKron (R m n p q A B : Set) : Set :=
  { r ∈ ((m × p) × (n × q)) × Ring.carrier(R) | ∃ i ∈ m, ∃ k ∈ p, ∃ j ∈ n, ∃ l ∈ q,
    r = (((i, k), (j, l)), call2(Ring.mul(R), A[i, j], B[k, l])) }

-- Kronecker.lean, kroneckerGL: x ⊗ y is invertible with inverse
-- x⁻¹ ⊗ y⁻¹.
theorem matKron.invertible (R m n x y : Set)
  requires ring : CommRing(R)
  requires finiteM : Finite(m)
  requires finiteN : Finite(n)
  requires hx : x ∈ invertibleMatrices(R, m)
  requires hy : y ∈ invertibleMatrices(R, n)
  shows matKron(R, m, m, n, n, x, y) ∈ invertibleMatrices(R, m × n) ∧
    matInverse(R, m × n, matKron(R, m, m, n, n, x, y)) =
      matKron(R, m, m, n, n, matInverse(R, m, x), matInverse(R, n, y))
proof
  sorry

-- Kronecker.lean, U.kron: for S K = 1 and J = T ⊗ Kᵀ, the map
-- (g, h) ↦ h ⊗ (g⁻¹)ᵀ, the action x ↦ h x g⁻¹ on n′ × n matrices.
def kronAction (R m n g h : Set) : Set :=
  matKron(R, m, m, n, n, h, matTranspose(R, n, n, matInverse(R, n, g)))

theorem kronAction.unitary (R σ m n S K T g h : Set)
  requires ring : CommRing(R)
  requires involution : RingInvolution(σ, R)
  requires finiteM : Finite(m)
  requires finiteN : Finite(n)
  requires hS : S ∈ matrixSpace(R, n, n)
  requires hK : K ∈ matrixSpace(R, n, n)
  requires hT : T ∈ matrixSpace(R, m, m)
  requires inverse : matMul(R, n, n, n, S, K) = matOne(R, n)
  requires hg : g ∈ formUnitaryMatrices(R, σ, n, S)
  requires hh : h ∈ formUnitaryMatrices(R, σ, m, T)
  shows kronAction(R, m, n, g, h) ∈
    formUnitaryMatrices(R, σ, m × n, matKron(R, m, m, n, n, T, matTranspose(R, n, n, K)))
proof
  sorry

theorem kronAction.mul (R σ m n S K T g g2 h h2 : Set)
  requires ring : CommRing(R)
  requires involution : RingInvolution(σ, R)
  requires finiteM : Finite(m)
  requires finiteN : Finite(n)
  requires inverse : matMul(R, n, n, n, S, K) = matOne(R, n)
  requires hg : g ∈ formUnitaryMatrices(R, σ, n, S)
  requires hg2 : g2 ∈ formUnitaryMatrices(R, σ, n, S)
  requires hh : h ∈ formUnitaryMatrices(R, σ, m, T)
  requires hh2 : h2 ∈ formUnitaryMatrices(R, σ, m, T)
  shows kronAction(R, m, n, matMul(R, n, n, n, g, g2), matMul(R, m, m, m, h, h2)) =
    matMul(R, m × n, m × n, m × n, kronAction(R, m, n, g, h), kronAction(R, m, n, g2, h2))
proof
  sorry

-- Kronecker.lean, map_kronecker: (A ⊗ B).map f = A.map f ⊗ B.map f.
theorem matKron.map (R S m n p q f A B : Set)
  requires ringR : Ring(R)
  requires ringS : Ring(S)
  requires hom : RingHom(f, R, S)
  requires hA : A ∈ matrixSpace(R, m, n)
  requires hB : B ∈ matrixSpace(R, p, q)
  shows matMap(S, m × p, n × q, f, matKron(R, m, n, p, q, A, B)) =
    matKron(S, m, n, p, q, matMap(S, m, n, f, A), matMap(S, p, q, f, B))
proof
  sorry

-- Section: Additive characters of finite rings
-- An additive character of the ring R (Mathlib's AddChar R ℂ), and a
-- primitive one: for every a ≠ 0 the character x ↦ ψ(ax) is not trivial
-- (AddChar.IsPrimitive).
predicate RingAddChar (R ψ : Set) := AddCharacter(Ring.additive(R), ψ)

predicate PrimitiveAddChar (R ψ : Set) :=
  RingAddChar(R, ψ) ∧
  ∀ a ∈ Ring.carrier(R), a ≠ Ring.zero(R) →
    (∃ x ∈ Ring.carrier(R), ψ(call2(Ring.mul(R), a, x)) ≠ complexOne)

-- LocalHomUnit.lean, exists_primitive_residue_addChar: for a subring O of
-- F, a surjection π : O → R with π(x) = 0 ⟺ g x ∈ O, and ψ with
-- ψ(tO) = 1 exactly for t ∈ O, the character π(x) ↦ ψ(gx) of R is
-- primitive.
theorem PrimitiveAddChar.of_residue (R F O π g ψ : Set)
  requires ringR : CommRing(R)
  requires ringF : CommRing(F)
  requires subring : IsSubring(Ring.carrier(F), Ring.add(F), Ring.zero(F), Ring.neg(F),
    Ring.mul(F), Ring.one(F), O)
  requires hom : RingHom(π, subringRing(F, O), R)
  requires surjective : ∀ r ∈ Ring.carrier(R), ∃ x ∈ O, π(x) = r
  requires kernel : ∀ x ∈ O, π(x) = Ring.zero(R) ↔ call2(Ring.mul(F), g, x) ∈ O
  requires hg : g ∈ Ring.carrier(F)
  requires character : RingAddChar(F, ψ)
  requires dual : ∀ t ∈ Ring.carrier(F),
    (∀ s ∈ O, ψ(call2(Ring.mul(F), t, s)) = complexOne) ↔ t ∈ O
  shows ∃ φ, PrimitiveAddChar(R, φ) ∧
    ∀ x ∈ O, φ(π(x)) = ψ(call2(Ring.mul(F), g, x))
proof
  sorry

-- Section: Fourier transform on matrices
-- Sums over a finite set in ℂ.
def cSum (F w : Set) : Set := groupFiniteSum(complexAdditiveGroup, F, w)

-- LocalHomUnit.lean, matrixFourier ψ f: for f on N × a matrices,
-- ρ ↦ Σ_v f(v) ψ(tr(ρ v)) on a × N matrices.
def matrixFourierTerms (R a N ψ f ρ : Set) : Set :=
  { (v, ℂ[f(v) * ψ(matTrace(R, a, matMul(R, a, N, a, ρ, v)))]) | v ∈ matrixSpace(R, N, a) }

def matrixFourier (R a N ψ f : Set) : Set :=
  { (ρ, cSum(matrixSpace(R, N, a), matrixFourierTerms(R, a, N, ψ, f, ρ))) |
    ρ ∈ matrixSpace(R, a, N) }

-- LocalHomUnit.lean, IsPrimitiveMulChar χ: for every a ≠ 0 some 1 + ca has
-- χ(1 + ca) ∉ {0, 1}.
predicate PrimitiveMulChar (R χ : Set) :=
  MulChar(R, complexRing, χ) ∧
  ∀ a ∈ Ring.carrier(R), a ≠ Ring.zero(R) → (∃ c ∈ Ring.carrier(R),
    χ(call2(Ring.add(R), Ring.one(R), call2(Ring.mul(R), c, a))) ≠ complexZero ∧
    χ(call2(Ring.add(R), Ring.one(R), call2(Ring.mul(R), c, a))) ≠ complexOne)

-- The zero vector of Rᵃ.
def zeroVectorOf (R a : Set) : Set := a × {Ring.zero(R)}

-- x ↦ ψ(z · x) on Rᵃ.
def dotCharTerms (R a ψ z : Set) : Set :=
  { (x, ψ(vecDot(R, a, z, x))) | x ∈ functionSpace(a, Ring.carrier(R)) }

-- LocalHomUnit.lean, sum_addChar_dotProduct: Σ_x ψ(z · x) is |Rᵃ| if
-- z = 0 and 0 otherwise.
theorem dotCharTerms.sum (R a ψ z : Set)
  requires ring : CommRing(R)
  requires finiteR : Finite(Ring.carrier(R))
  requires finiteA : Finite(a)
  requires primitive : PrimitiveAddChar(R, ψ)
  requires hz : z ∈ functionSpace(a, Ring.carrier(R))
  shows (z = zeroVectorOf(R, a) →
      cSum(functionSpace(a, Ring.carrier(R)), dotCharTerms(R, a, ψ, z)) =
        complexOfReal(realNat(cardinality(functionSpace(a, Ring.carrier(R)))))) ∧
    (z ≠ zeroVectorOf(R, a) →
      cSum(functionSpace(a, Ring.carrier(R)), dotCharTerms(R, a, ψ, z)) = complexZero)
proof
  sorry

-- v ↦ ψ(tr(ρ v)).
def traceCharTerms (R a N ψ ρ : Set) : Set :=
  { (v, ψ(matTrace(R, a, matMul(R, a, N, a, ρ, v)))) | v ∈ matrixSpace(R, N, a) }

-- LocalHomUnit.lean, sum_addChar_trace_mul.
theorem traceCharTerms.sum (R a N ψ ρ : Set)
  requires ring : CommRing(R)
  requires finiteR : Finite(Ring.carrier(R))
  requires finiteA : Finite(a)
  requires finiteN : Finite(N)
  requires primitive : PrimitiveAddChar(R, ψ)
  requires hρ : ρ ∈ matrixSpace(R, a, N)
  shows (ρ = matZero(R, a, N) →
      cSum(matrixSpace(R, N, a), traceCharTerms(R, a, N, ψ, ρ)) =
        complexOfReal(realNat(cardinality(matrixSpace(R, N, a))))) ∧
    (ρ ≠ matZero(R, a, N) →
      cSum(matrixSpace(R, N, a), traceCharTerms(R, a, N, ψ, ρ)) = complexZero)
proof
  sorry

-- LocalHomUnit.lean, matrixFourier_matrixFourier: transforming twice gives
-- y ↦ f(−y) times the number of matrices.
theorem matrixFourier.inversion (R a N ψ f y : Set)
  requires ring : CommRing(R)
  requires finiteR : Finite(Ring.carrier(R))
  requires finiteA : Finite(a)
  requires finiteN : Finite(N)
  requires primitive : PrimitiveAddChar(R, ψ)
  requires hf : FunctionBetween(f, matrixSpace(R, N, a), complexCarrier)
  requires hy : y ∈ matrixSpace(R, N, a)
  shows matrixFourier(R, N, a, ψ, matrixFourier(R, a, N, ψ, f))(y) =
    ℂ[f(matNeg(R, N, a, y)) * complexOfReal(realNat(cardinality(matrixSpace(R, a, N))))]
proof
  sorry

-- y ↦ ψ(tr(y u)) and the combination Σ_u c(u) ψ(tr(· u)).
def traceCharacter (R a N ψ u : Set) : Set :=
  { (y, ψ(matTrace(R, N, matMul(R, N, a, N, y, u)))) | y ∈ matrixSpace(R, N, a) }

def traceCharCombination (R a N ψ c y : Set) : Set :=
  { (u, ℂ[c(u) * traceCharacter(R, a, N, ψ, u)(y)]) | u ∈ matrixSpace(R, a, N) }

-- LocalHomUnit.lean, exists_sum_smul_addChar_trace_eq: every f on N × a
-- matrices is a combination of the characters y ↦ ψ(tr(y u)).
theorem traceCharacter.span (R a N ψ f : Set)
  requires ring : CommRing(R)
  requires finiteR : Finite(Ring.carrier(R))
  requires finiteA : Finite(a)
  requires finiteN : Finite(N)
  requires primitive : PrimitiveAddChar(R, ψ)
  requires hf : FunctionBetween(f, matrixSpace(R, N, a), complexCarrier)
  shows ∃ c, FunctionBetween(c, matrixSpace(R, a, N), complexCarrier) ∧
    ∀ y ∈ matrixSpace(R, N, a),
      cSum(matrixSpace(R, a, N), traceCharCombination(R, a, N, ψ, c, y)) = f(y)
proof
  sorry

-- d ↦ χ(det d) on a × a matrices.
def detCharacter (R a χ : Set) : Set :=
  { (d, χ(matDet(R, a, d))) | d ∈ matrixSpace(R, a, a) }

-- LocalHomUnit.lean, matrix_gauss_sum (known result): for ψ, χ primitive
-- and S(g d) = χ(det g) S(d), Ŝ(y) = χ⁻¹(det y) Ŝ(1), and
-- conj(Σ_v χ(det v) ψ(tr v)) Ŝ(1) = S(1) · #matrices.
theorem matrixFourier.gauss_sum (R a ψ χ S : Set)
  requires ring : CommRing(R)
  requires finiteR : Finite(Ring.carrier(R))
  requires finiteA : Finite(a)
  requires primitive : PrimitiveAddChar(R, ψ)
  requires primitiveChi : PrimitiveMulChar(R, χ)
  requires hS : FunctionBetween(S, matrixSpace(R, a, a), complexCarrier)
  requires equivariant : ∀ g ∈ invertibleMatrices(R, a), ∀ d ∈ matrixSpace(R, a, a),
    S(matMul(R, a, a, a, g, d)) = ℂ[χ(matDet(R, a, g)) * S(d)]
  shows (∀ y ∈ matrixSpace(R, a, a), matrixFourier(R, a, a, ψ, S)(y) =
      ℂ[mulCharInverse(R, complexRing, χ)(matDet(R, a, y)) *
        matrixFourier(R, a, a, ψ, S)(matOne(R, a))]) ∧
    ℂ[complexConj(matrixFourier(R, a, a, ψ, detCharacter(R, a, χ))(matOne(R, a))) *
        matrixFourier(R, a, a, ψ, S)(matOne(R, a))] =
      ℂ[S(matOne(R, a)) * complexOfReal(realNat(cardinality(matrixSpace(R, a, a))))]
proof
  sorry

-- Section: Unimodular vectors
-- The i-th column of a matrix.
def matColumn (R n g i : Set) : Set := { (k, g[k, i]) | k ∈ n }

-- LocalHomUnit.lean, exists_GL_smul_single: a vector with a unit entry is
-- the i-th column of an invertible matrix, for any i.
theorem invertibleMatrices.column (R n v i : Set)
  requires ring : CommRing(R)
  requires finite : Finite(n)
  requires hv : v ∈ functionSpace(n, Ring.carrier(R))
  requires unit : ∃ j ∈ n, RingUnit(R, v(j))
  requires hi : i ∈ n
  shows ∃ g ∈ invertibleMatrices(R, n), matColumn(R, n, g, i) = v
proof
  sorry

-- The stabilizer of u in GLₙ(F).
def vectorStabilizer (F n u : Set) : Set :=
  { g ∈ invertibleMatrices(F, n) | mulVec(F, n, n, g, u) = u }

-- LocalHomUnit.lean, index_stabilizer_GL_vector: for u ≠ 0 over a finite
-- field F, the stabilizer of u has index |F|ⁿ − 1.
theorem vectorStabilizer.index (F n u : Set)
  requires field : Field(F)
  requires finiteF : Finite(Ring.carrier(F))
  requires finiteN : Finite(n)
  requires hu : u ∈ functionSpace(n, Ring.carrier(F))
  requires nonzero : u ≠ zeroVectorOf(F, n)
  shows index(generalLinearGroup(F, n), vectorStabilizer(F, n, u)) =
    cardinality(Ring.carrier(F)) ^ cardinality(n) - 1
proof
  sorry

-- Section: Iterated composites and tensor chains
-- LocalHomUnit.lean, compUpTo L j: L_{j−1} ∘ ⋯ ∘ L_0 : M_0 → M_j, the
-- identity for j = 0 (L j a function M j → M (j + 1)).
def compUpTo (M L : Set, j : Nat) → Set
  | M, L, zero => identity(Module.carrier(M(0)))
  | M, L, succ(k) => compose(L(k), compUpTo(M, L, k), Module.carrier(M(0)),
      Module.carrier(M(k)), Module.carrier(M(succ(k))))

theorem compUpTo.linear (R M L : Set, j : Nat)
  requires ring : CommRing(R)
  requires modules : ∀ k ∈ ℕ, Module(M(k), R)
  requires maps : ∀ k ∈ ℕ, LinearMap(L(k), M(k), R, M(succ(k)))
  shows LinearMap(compUpTo(M, L, j), M(0), R, M(j))
proof
  sorry

-- LocalHomUnit.lean, TensorChain S j: S_{j−1} ⊗ ⋯ ⊗ S_0 over ℂ, equal to
-- ℂ for j = 0.
def tensorChain (S : Set, j : Nat) → Set
  | S, zero => selfModule(complexRing)
  | S, succ(k) => tensorProduct(S(k), complexRing, tensorChain(S, k))

-- LocalHomUnit.lean, TensorChain.pure f j: f_{j−1} ⊗ ⋯ ⊗ f_0, 1 for j = 0.
def tensorPure (S f : Set, j : Nat) → Set
  | S, f, zero => complexOne
  | S, f, succ(k) => tmul(S(k), complexRing, tensorChain(S, k), f(k), tensorPure(S, f, k))

-- LocalHomUnit.lean, TensorChain.lift x j: for bilinear b_i : S_i × M_i →
-- M_{i+1} (b i s a linear map M_i → M_{i+1}) and x ∈ M_0, the linear map
-- S_{j−1} ⊗ ⋯ ⊗ S_0 → M_j with f_{j−1} ⊗ ⋯ ⊗ f_0 ↦ b_{j−1}(f_{j−1})(⋯
-- b_0(f_0)(x)) (TensorChain.lift_pure); it is unique.
def bApplied (b f : Set) : Set := { (k, b(k)(f(k))) | k ∈ ℕ }

defunique tensorChainLift (S M b x : Set, j : Nat)
    (Lj ∈ linearMaps(tensorChain(S, j), complexRing, M(j))) :=
  ∀ f, (∀ k ∈ ℕ, f(k) ∈ Module.carrier(S(k))) →
    Lj(tensorPure(S, f, j)) = compUpTo(M, bApplied(b, f), j)(x)
requires modulesS : ∀ k ∈ ℕ, Module(S(k), complexRing)
requires modulesM : ∀ k ∈ ℕ, Module(M(k), complexRing)
requires bilinear : ∀ k ∈ ℕ, LinearMap(b(k), S(k), complexRing,
  homModule(M(k), complexRing, M(succ(k))))
requires hx : x ∈ Module.carrier(M(0))
proof
  sorry
uniqueness
  sorry

-- LocalHomUnit.lean, TensorChain.pure_smul: if g_j = c_j f_j for j < m,
-- the pure tensor of g is Π_{j<m} c_j times that of f.
def coefficientProduct (c : Set, m : Nat) : Set :=
  finiteRingProduct(m, complexCarrier, complexAdd, complexZero, complexNeg, complexMul,
    complexOne, c)

theorem tensorPure.smul (S f g c : Set, m : Nat)
  requires modules : ∀ k ∈ ℕ, Module(S(k), complexRing)
  requires hf : ∀ k ∈ ℕ, f(k) ∈ Module.carrier(S(k))
  requires hc : ∀ k ∈ ℕ, c(k) ∈ complexCarrier
  requires scaled : ∀ k ∈ m, g(k) = Module.smul(S(k))(c(k), f(k))
  shows tensorPure(S, g, m) =
    Module.smul(tensorChain(S, m))(coefficientProduct(c, m), tensorPure(S, f, m))
proof
  sorry

-- Section: Local homomorphisms
-- LocalHomUnit.lean, isUnit_of_mapMatrix: a local homomorphism f : R → S
-- reflects invertibility of matrices.
theorem invertibleMatrices.of_local_map (R S n f M : Set)
  requires ringR : CommRing(R)
  requires ringS : CommRing(S)
  requires finite : Finite(n)
  requires hom : RingHom(f, R, S)
  requires local : ∀ a ∈ Ring.carrier(R), RingUnit(S, f(a)) → RingUnit(R, a)
  requires hM : M ∈ matrixSpace(R, n, n)
  requires unit : matMap(S, n, n, f, M) ∈ invertibleMatrices(S, n)
  shows M ∈ invertibleMatrices(R, n)
proof
  sorry

end Local
