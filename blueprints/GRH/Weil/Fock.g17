-- The Bargmann–Fock model of the oscillator representation of U(p, q):
-- the Gaussian is a vacuum of the real Heisenberg datum of a signature
-- ε, the unitary group U(ε) acts with multiplier conj det of the
-- negative block and trivial cocycle; the Fock space 𝓕 (the reproducing
-- space of the Gaussian), its Heisenberg and Weil operators and inner
-- product; the Fock vectors v_P = P(ζ) e^{−|x|²/2} of polynomials, their
-- inner products (the Fischer product) and density; external products
-- of Fock vectors; weighted moments, rapid data and mixed models; the
-- matrix coefficients ⟨v_Q, ω₀(u)v_P⟩ between harmonic polynomials.
-- Source: grh-compact/src/Lib/Weil/Fock/FockVacuum.lean
-- (principalMinor_sign_eq_det, realMultiplier, beta_mul_realVac,
-- integrable_exp_mul_realVac, isVacuum_realVac, norm_holCoord,
-- exists_norm_eval_le_exp), FockAction.lean (realCoordSum, realAction),
-- FockTensor.lean (fockSpace, realWeil, realHeisOp, vacVector,
-- realInner, polyVector, polyVector_apply, polyVector_one,
-- polyVector_injective, hasDerivAt_realHeisOp, transport, realBoxProd,
-- piTensor, blockU, realWeil_piTensor, realBoxProd_polyVector),
-- MixedFockModel.lean (weightedNorm, IsRapidDatum, MixedModel,
-- weightedNorm_realHeisOp_le, weightedNorm_polyVector_ne_top,
-- exists_tendsto_weightedNorm, MixedModel.isRapidDatum_slice),
-- FockHarmonicCoeff.lean (fockMatrixCoeff, realInner_polyVector,
-- denseRange_polyVector, complexLinearPart, fockMatrixCoeff_eq_realInner).
-- Part of: "Bargmann–Fock model of the harmonic (oscillator)
-- representation of U(p,q) (known result; see Lib.Weil.Fock.OscillatorPair)."
-- Not yet stated: OscillatorPair.lean (it needs FockDualPair and the
-- derived actions of Lib/DiscreteSeries/Theta and Rigidity) and
-- ReproducingFormula.lean (theta lifts of Lib/GaloisRep/EvenRank).
-- Encoding. As in GRH.DiscreteSeries.Basic: ℂ^ι = functionSpace(ι, ℂ),
-- signs are the complex numbers ±1. U(ε) is the group of matrices g
-- with gᴴ diag(ε) g = diag(ε) (formUnitaryGroup of GRH.Matrix.Groups)
-- with the topology of entries; it acts on ℂ^ι by g • x = gx. A
-- polynomial is an element of polynomialRing(ℂ, ι). The Fock space is
-- the set modelSet(…) of GRH.Weil.Construction for the real datum; the
-- source's Bochner integrals and limits over it are those of its L¹
-- norm. The sup norm of ℂ^ι is the supremum in [0, ∞] of the |xᵢ|.
-- Part of the GRH blueprint (layer 4, Lib/Weil, stage S2).
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Weil.Fock
import GRH.DiscreteSeries.Basic

section Fock
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- Section: The unitary group of a signature and its multiplier
-- U(ε) = U(diag ε), the group and its topology.
def signUnitaryMatrices (ι ε : Set) : Set :=
  formUnitaryMatrices(complexRing, complexConj, ι, signMatrix(complexRing, ι, ε))

def signUnitaryGroup (ι ε : Set) : Set :=
  formUnitaryGroup(complexRing, complexConj, ι, signMatrix(complexRing, ι, ε))

def matrixEntrySpaces (ι : Set) : Set := constantSpaces(ι × ι, complexSpace)

def signUnitarySpace (ι ε : Set) : Set :=
  subspace(piSpace(ι × ι, matrixEntrySpaces(ι)), signUnitaryMatrices(ι, ε))

-- The negative indices {i | εᵢ = −1}.
def negIndices (ι ε : Set) : Set := { i ∈ ι | ε(i) = ℂ[-1] }

-- FockVacuum.lean, realMultiplier u: the conjugate of the determinant of
-- the negative–negative block of u.
def realMultiplier (ι ε u : Set) : Set := complexConj(principalMinor(u, negIndices(ι, ε)))

def realMultiplierMap (ι ε : Set) : Set :=
  { (u, realMultiplier(ι, ε, u)) | u ∈ signUnitaryMatrices(ι, ε) }

-- The action u • x = ux of U(ε) on ℂ^ι.
def mulVecOn (ι u : Set) : Set := { (x, mulVec(complexRing, ι, ι, u, x)) | x ∈ cVectors(ι) }

def realAct (ι ε : Set) : Set := { (u, mulVecOn(ι, u)) | u ∈ signUnitaryMatrices(ι, ε) }

-- FockVacuum.lean, principalMinor_sign_eq_det: for u ∈ U(ε) the minor on
-- the negative indices is det(P₊ + (1 − P₊)u).
theorem principalMinor.sign_eq_det (ι ε u : Set)
  requires finite : Finite(ι)
  requires signs : SignsOn(ι, ε)
  requires hu : u ∈ signUnitaryMatrices(ι, ε)
  shows principalMinor(u, negIndices(ι, ε)) =
    matDet(complexRing, ι, matAdd(complexRing, ι, ι, posProj(ι, ε),
      matMul(complexRing, ι, ι, ι, matSub(ι, matOne(complexRing, ι), posProj(ι, ε)), u)))
proof
  sorry

-- Section: The Gaussian vacuum
-- FockVacuum.lean, beta_mul_realVac: β(y, x) e(x − y) = e(x) e(y)
-- exp(ζ(y)*ζ(x)).
theorem realVac.beta_mul (ι ε x y : Set)
  requires finite : Finite(ι)
  requires signs : SignsOn(ι, ε)
  requires hx : x ∈ cVectors(ι)
  requires hy : y ∈ cVectors(ι)
  shows ℂ[realHeis(ι, ε)(y, x) * realVac(ι)(hSub(cVectorGroup(ι), x, y))] =
    ℂ[realVac(ι)(x) * realVac(ι)(y) *
      complexExp(cDot(ι, holCoord(ι, ε, y), holCoord(ι, ε, x)))]
proof
  sorry

-- The sup norm ‖x‖ = maxᵢ |xᵢ| (in [0, ∞], a real for finite ι).
def absValuesOn (ι x : Set) : Set := { (i, complexAbs(x(i))) | i ∈ ι }

def cSupNorm (ι x : Set) : Set := ennSupOn(absValuesOn(ι, x), ι)

-- u ↦ exp(C‖u‖) |e(u)|.
def expWeightedVac (ι C : Set) : Set :=
  { (u, complexOfReal(R[realExp(R[C * cSupNorm(ι, u)]) * complexAbs(realVac(ι)(u))])) |
    u ∈ cVectors(ι) }

-- FockVacuum.lean, integrable_exp_mul_realVac.
theorem realVac.integrable_exp_mul (ι C : Set)
  requires finite : Finite(ι)
  requires hC : C ∈ ℝ
  shows ComplexIntegrable(borelSpace(cVectorSpace(ι)), realMeasure(ι), expWeightedVac(ι, C))
proof
  sorry

-- FockVacuum.lean, isVacuum_realVac: the Gaussian is a vacuum for β_ε
-- and the normalised Lebesgue measure.
theorem realVac.vacuum (ι ε : Set)
  requires finite : Finite(ι)
  requires signs : SignsOn(ι, ε)
  shows IsVacuum(cVectorGroup(ι), cVectorSpace(ι), realMeasure(ι), realHeis(ι, ε), realVac(ι))
proof
  sorry

-- FockVacuum.lean, norm_holCoord.
theorem holCoord.abs (ι ε y i : Set)
  requires signs : SignsOn(ι, ε)
  requires hy : y ∈ cVectors(ι)
  requires hi : i ∈ ι
  shows complexAbs(holCoord(ι, ε, y)(i)) = complexAbs(y(i))
proof
  sorry

-- FockVacuum.lean, exists_norm_eval_le_exp: |P(l)| ≤ |C| exp(k‖l‖).
theorem polynomial.eval_le_exp (ι P : Set)
  requires finite : Finite(ι)
  requires hP : P ∈ cPolys(ι)
  shows ∃ k ∈ ℕ, ∃ C ∈ ℝ, ∀ l ∈ cVectors(ι),
    complexAbs(evaluationAt(complexRing, ι, l)(P)) ≤
      R[abs(C) * realExp(R[realNat(k) * cSupNorm(ι, l)])]
proof
  sorry

-- FockAction.lean, realAction ε: U(ε) acts on (ℂ^ι, β_ε) preserving β and
-- the measure, with multiplier realMultiplier and trivial cocycle for the
-- Gaussian (a complex Gaussian determinant).
theorem realAct.multiplier (ι ε : Set)
  requires finite : Finite(ι)
  requires signs : SignsOn(ι, ε)
  shows MultiplierAction(signUnitaryGroup(ι, ε), signUnitarySpace(ι, ε), cVectorGroup(ι),
    cVectorSpace(ι), realMeasure(ι), realHeis(ι, ε), realVac(ι), realAct(ι, ε),
    realMultiplierMap(ι, ε), trivialCocycle(signUnitaryGroup(ι, ε)))
proof
  sorry

-- FockAction.lean, realCoordSum: for a bijection e : ι₁ ⊔ ι₂ → ι with
-- ε ∘ e = ε₁ ⊔ ε₂, the map (x₁, x₂) ↦ (x₁ ⊔ x₂) ∘ e⁻¹ is an orthogonal
-- sum of the real data.
def coordSumValue (ι1 ι2 ι e p : Set) : Set :=
  compose(vecAppend(complexRing, ι1, ι2, fst(p), snd(p)), converse(e, ι1 ⊎ ι2, ι),
    ι, ι1 ⊎ ι2, complexCarrier)

def coordSum (ι1 ι2 ι e : Set) : Set :=
  { (p, coordSumValue(ι1, ι2, ι, e, p)) | p ∈ cVectors(ι1) × cVectors(ι2) }

-- e is a bijection ι₁ ⊔ ι₂ → ι matching the signs.
predicate SignSplitting (ι1 ε1 ι2 ε2 ι ε e : Set) :=
  Finite(ι1) ∧ Finite(ι2) ∧ SignsOn(ι1, ε1) ∧ SignsOn(ι2, ε2) ∧ SignsOn(ι, ε) ∧
  BijectiveBetween(e, ι1 ⊎ ι2, ι) ∧
  (∀ i ∈ ι1, ε(e(inl(i))) = ε1(i)) ∧ (∀ i ∈ ι2, ε(e(inr(i))) = ε2(i))

theorem coordSum.orthogonal (ι1 ε1 ι2 ε2 ι ε e : Set)
  requires split : SignSplitting(ι1, ε1, ι2, ε2, ι, ε, e)
  shows OrthogonalSum(cVectorGroup(ι), cVectorSpace(ι), realHeis(ι, ε), realVac(ι),
    cVectorGroup(ι1), cVectorSpace(ι1), realHeis(ι1, ε1), realVac(ι1),
    cVectorGroup(ι2), cVectorSpace(ι2), realHeis(ι2, ε2), realVac(ι2),
    coordSum(ι1, ι2, ι, e))
proof
  sorry

-- Section: The Fock space
-- FockTensor.lean, fockSpace ε: the reproducing space of the Gaussian, its
-- module and L¹ norm.
def fockSpace (ι ε : Set) : Set :=
  modelSet(cVectorGroup(ι), cVectorSpace(ι), realMeasure(ι), realHeis(ι, ε), realVac(ι))

def fockModule (ι ε : Set) : Set :=
  modelModule(cVectorGroup(ι), cVectorSpace(ι), realMeasure(ι), realHeis(ι, ε), realVac(ι))

def fockNorm (ι ε : Set) : Set :=
  modelNorm(cVectorGroup(ι), cVectorSpace(ι), realMeasure(ι), realHeis(ι, ε), realVac(ι))

-- FockTensor.lean, realHeisOp x: c ↦ (z ↦ β(x, z) c(z − x)).
def realHeisOp (ι ε x : Set) : Set :=
  heisRep(cVectorGroup(ι), cVectorSpace(ι), realMeasure(ι), realHeis(ι, ε), realVac(ι))(x)

-- FockTensor.lean, realWeil u: ω₀(u)c = conj(det d) ∫ c(y) ϱ(uy)e dy.
def realWeil (ι ε u : Set) : Set :=
  weilRep(signUnitaryGroup(ι, ε), cVectorGroup(ι), cVectorSpace(ι), realMeasure(ι),
    realHeis(ι, ε), realVac(ι), realAct(ι, ε), realMultiplierMap(ι, ε))(u)

-- FockTensor.lean, realInner: ⟨c, c′⟩ = ∫ c̄ c′.
def realInner (ι v w : Set) : Set :=
  modelInner(cVectorGroup(ι), cVectorSpace(ι), realMeasure(ι), v, w)

-- FockTensor.lean, polyVector ε P: v_P(x) = P(ζ(x)) exp(−|x|²/2).
def polyVector (ι ε P : Set) : Set :=
  { (x, ℂ[evaluationAt(complexRing, ι, holCoord(ι, ε, x))(P) * realVac(ι)(x)]) |
    x ∈ cVectors(ι) }

def polyVectorMap (ι ε : Set) : Set := { (P, polyVector(ι, ε, P)) | P ∈ cPolys(ι) }

-- FockTensor.lean, polyVector (its codomain): v_P lies in 𝓕, and
-- P ↦ v_P is ℂ-linear and injective (polyVector_injective).
theorem polyVector.mem (ι ε P : Set)
  requires finite : Finite(ι)
  requires signs : SignsOn(ι, ε)
  requires hP : P ∈ cPolys(ι)
  shows polyVector(ι, ε, P) ∈ fockSpace(ι, ε)
proof
  sorry

theorem polyVector.linear (ι ε : Set)
  requires finite : Finite(ι)
  requires signs : SignsOn(ι, ε)
  shows LinearMap(polyVectorMap(ι, ε),
    algebraModule(polynomialAlgebra(complexRing, ι)), fockModule(ι, ε), complexRing)
proof
  sorry

theorem polyVector.injective (ι ε P Q : Set)
  requires finite : Finite(ι)
  requires signs : SignsOn(ι, ε)
  requires hP : P ∈ cPolys(ι)
  requires hQ : Q ∈ cPolys(ι)
  requires same : polyVector(ι, ε, P) = polyVector(ι, ε, Q)
  shows P = Q
proof
  sorry

-- FockTensor.lean, polyVector_one: v₁ is the vacuum.
theorem polyVector.one (ι ε : Set)
  requires finite : Finite(ι)
  requires signs : SignsOn(ι, ε)
  shows polyVector(ι, ε, Ring.one(polynomialRing(complexRing, ι))) = realVac(ι)
proof
  sorry

-- t ↦ ϱ(tv)v_P on ℝ, and the difference quotient (ϱ(tv)v_P − v_P)/t.
def heisCurve (ι ε v P t : Set) : Set :=
  realHeisOp(ι, ε, vecSmul(complexRing, ι, complexOfReal(t), v))(polyVector(ι, ε, P))

def heisQuotient (ι ε v P t : Set) : Set :=
  Module.smul(fockModule(ι, ε))(complexOfReal(realInv(t)),
    Module.add(fockModule(ι, ε))(heisCurve(ι, ε, v, P, t),
      Module.smul(fockModule(ι, ε))(ℂ[-1], polyVector(ι, ε, P))))

-- FockTensor.lean, hasDerivAt_realHeisOp: t ↦ ϱ(tv)v_P has derivative
-- v_Q at t = 0 in 𝓕, Q = Σᵢ (conj ζᵢ(v) Xᵢ − ζᵢ(v) ∂ᵢ)P = heisDeriv ε v P.
theorem polyVector.heis_deriv (ι ε v P δ : Set)
  requires finite : Finite(ι)
  requires signs : SignsOn(ι, ε)
  requires hv : v ∈ cVectors(ι)
  requires hP : P ∈ cPolys(ι)
  requires hδ : δ ∈ ℝ
  requires positive : realZero < δ
  shows ∃ η ∈ ℝ, realZero < η ∧ ∀ t ∈ ℝ, t ≠ realZero → abs(t) < η →
    fockNorm(ι, ε)(Module.add(fockModule(ι, ε))(heisQuotient(ι, ε, v, P, t),
      Module.smul(fockModule(ι, ε))(ℂ[-1], polyVector(ι, ε, heisDeriv(ι, ε, v, P))))) < δ
proof
  sorry

-- FockTensor.lean, Heisenberg.IsVacuum.transport: for an isomorphism
-- φ : W′ → W of topological groups with e ∘ φ = e′ and
-- σ(β(φx, φy)) = β′(x, y), σ an isometric ring endomorphism of ℂ, the
-- map v ↦ σ ∘ v ∘ φ carries the reproducing space of e into that of e′,
-- σ-semilinearly and isometrically (transport_apply).
def transportOf (G2 σ φ v : Set) : Set := { (x, σ(v(φ(x)))) | x ∈ Group.carrier(G2) }

theorem transportOf.model (G X μ β e G2 X2 μ2 β2 e2 σ φ v : Set)
  requires vacuum : IsVacuum(G, X, μ, β, e)
  requires vacuum2 : IsVacuum(G2, X2, μ2, β2, e2)
  requires iso : GroupHom(φ, G2, G) ∧ Homeomorphism(φ, X2, X)
  requires isometric : RingHom(σ, complexRing, complexRing) ∧
    FunctionBetween(σ, complexCarrier, complexCarrier) ∧
    (∀ z ∈ complexCarrier, complexAbs(σ(z)) = complexAbs(z))
  requires beta : ∀ x ∈ Group.carrier(G2), ∀ y ∈ Group.carrier(G2),
    σ(β(φ(x), φ(y))) = β2(x, y)
  requires vac : ∀ x ∈ Group.carrier(G2), e(φ(x)) = e2(x)
  requires hv : v ∈ modelSet(G, X, μ, β, e)
  shows transportOf(G2, σ, φ, v) ∈ modelSet(G2, X2, μ2, β2, e2) ∧
    modelNorm(G2, X2, μ2, β2, e2)(transportOf(G2, σ, φ, v)) = modelNorm(G, X, μ, β, e)(v)
proof
  sorry

-- Section: External products of Fock vectors
-- FockTensor.lean, realBoxProd: v₁ ⊠ v₂ in the Fock space of ε, for a
-- sign splitting e (OrthogonalSum.tmul of realCoordSum).
def realBoxProd (ι1 ε1 ι2 ε2 ι ε e v1 v2 : Set) : Set :=
  orthogonalTmul(cVectorGroup(ι), cVectorSpace(ι), realMeasure(ι), realHeis(ι, ε), realVac(ι),
    cVectorGroup(ι1), cVectorSpace(ι1), realMeasure(ι1), cVectorGroup(ι2), cVectorSpace(ι2),
    realMeasure(ι2), coordSum(ι1, ι2, ι, e), v1, v2)

-- FockTensor.lean, realBoxProd_polyVector: v_P ⊠ v_Q = v_{P′Q′} with
-- P′ = rename (e ∘ inl) P and Q′ = rename (e ∘ inr) Q.
theorem realBoxProd.polyVector (ι1 ε1 ι2 ε2 ι ε e P Q : Set)
  requires split : SignSplitting(ι1, ε1, ι2, ε2, ι, ε, e)
  requires hP : P ∈ cPolys(ι1)
  requires hQ : Q ∈ cPolys(ι2)
  shows realBoxProd(ι1, ε1, ι2, ε2, ι, ε, e, polyVector(ι1, ε1, P), polyVector(ι2, ε2, Q)) =
    polyVector(ι, ε, call2(Ring.mul(polynomialRing(complexRing, ι)),
      polynomialRename(complexRing, ι1, ι, compose(e, leftInclusion(ι1, ι2), ι1, ι1 ⊎ ι2, ι))(P),
      polynomialRename(complexRing, ι2, ι, compose(e, rightInclusion(ι1, ι2), ι2, ι1 ⊎ ι2,
        ι))(Q)))
proof
  sorry

-- The signs (τ, i) ↦ εᵢ on T × ι.
def liftedSigns (T ι ε : Set) : Set := { (p, ε(snd(p))) | p ∈ T × ι }

-- FockTensor.lean, piTensor v: x ↦ ∏_τ v_τ(x(τ, ·)) on ℂ^{T × ι}.
def sliceAt (ι x τ : Set) : Set := { (i, x((τ, i))) | i ∈ ι }

def piTensorTerms (T ι v x : Set) : Set := { (τ, v(τ)(sliceAt(ι, x, τ))) | τ ∈ T }

def piTensor (T ι v : Set) : Set :=
  { (x, complexFiniteProduct(T, piTensorTerms(T, ι, v, x))) |
    x ∈ cVectors(T × ι) }

theorem piTensor.mem (T ι ε v : Set)
  requires finiteT : Finite(T)
  requires finite : Finite(ι)
  requires signs : SignsOn(ι, ε)
  requires hv : ∀ τ ∈ T, v(τ) ∈ fockSpace(ι, ε)
  shows piTensor(T, ι, v) ∈ fockSpace(T × ι, liftedSigns(T, ι, ε))
proof
  sorry

-- FockTensor.lean, realInner_piTensor: ⟨⊗v, ⊗w⟩ = ∏_τ ⟨v_τ, w_τ⟩.
def innerTerms (ι v w : Set) : Set := { (τ, realInner(ι, v(τ), w(τ))) | τ ∈ domain(v) }

theorem piTensor.inner (T ι ε v w : Set)
  requires finiteT : Finite(T)
  requires finite : Finite(ι)
  requires signs : SignsOn(ι, ε)
  requires hv : FunctionBetween(v, T, fockSpace(ι, ε))
  requires hw : FunctionBetween(w, T, fockSpace(ι, ε))
  shows realInner(T × ι, piTensor(T, ι, v), piTensor(T, ι, w)) =
    complexFiniteProduct(T, innerTerms(ι, v, w))
proof
  sorry

-- FockTensor.lean, blockU: the block diagonal matrix of a family u_τ.
def blockEntry (u q : Set) : Set :=
  ⋃({ c ∈ complexCarrier |
    (fst(fst(q)) = fst(snd(q)) ∧ c = u(fst(fst(q)))[snd(fst(q)), snd(snd(q))]) ∨
    (fst(fst(q)) ≠ fst(snd(q)) ∧ c = complexZero) })

def blockMatrixOf (T ι u : Set) : Set := { (q, blockEntry(u, q)) | q ∈ (T × ι) × (T × ι) }

-- FockTensor.lean, realWeil_piTensor: ω₀(⊕u)(⊗v) = ⊗ ω₀(u_τ)v_τ.
def weilFamily (ι ε u v : Set) : Set := { (τ, realWeil(ι, ε, u(τ))(v(τ))) | τ ∈ domain(v) }

theorem piTensor.realWeil (T ι ε u v : Set)
  requires finiteT : Finite(T)
  requires finite : Finite(ι)
  requires signs : SignsOn(ι, ε)
  requires hu : FunctionBetween(u, T, signUnitaryMatrices(ι, ε))
  requires hv : FunctionBetween(v, T, fockSpace(ι, ε))
  shows blockMatrixOf(T, ι, u) ∈ signUnitaryMatrices(T × ι, liftedSigns(T, ι, ε)) ∧
    realWeil(T × ι, liftedSigns(T, ι, ε), blockMatrixOf(T, ι, u))(piTensor(T, ι, v)) =
      piTensor(T, ι, weilFamily(ι, ε, u, v))
proof
  sorry

-- Section: Weighted moments and rapid data
-- MixedFockModel.lean, weightedNorm N v: ∫ (1 + ‖y‖)^N |v(y)| dy in [0, ∞].
def momentIntegrand (ι v : Set, N : Nat) : Set :=
  { (y, ennOfReal(R[(R[realOne + cSupNorm(ι, y)] ^ N) * complexAbs(v(y))])) | y ∈ cVectors(ι) }

def weightedNorm (ι v : Set, N : Nat) : Set :=
  lintegral(borelSpace(cVectorSpace(ι)), realMeasure(ι), momentIntegrand(ι, v, N))

-- MixedFockModel.lean, IsRapidDatum: every weighted norm is finite.
predicate IsRapidDatum (ι v : Set) := ∀ N ∈ ℕ, weightedNorm(ι, v, N) ≠ ennTop

-- MixedFockModel.lean, weightedNorm_realHeisOp_le.
theorem weightedNorm.heis_le (ι ε y v : Set, N : Nat)
  requires finite : Finite(ι)
  requires signs : SignsOn(ι, ε)
  requires hy : y ∈ cVectors(ι)
  requires hv : v ∈ fockSpace(ι, ε)
  shows EnnLe(weightedNorm(ι, realHeisOp(ι, ε, y)(v), N),
    ennMul(ennOfReal(R[R[realOne + cSupNorm(ι, y)] ^ N]), weightedNorm(ι, v, N)))
proof
  sorry

-- MixedFockModel.lean, weightedNorm_polyVector_ne_top.
theorem polyVector.rapid (ι ε P : Set)
  requires finite : Finite(ι)
  requires signs : SignsOn(ι, ε)
  requires hP : P ∈ cPolys(ι)
  shows IsRapidDatum(ι, polyVector(ι, ε, P))
proof
  sorry

-- MixedFockModel.lean, exists_tendsto_weightedNorm: a rapid datum is the
-- limit of one sequence of Fock vectors v_{P_k} in every weighted norm.
def vectorDifference (ι ε v w : Set) : Set :=
  Module.add(fockModule(ι, ε))(v, Module.smul(fockModule(ι, ε))(ℂ[-1], w))

theorem IsRapidDatum.polynomial_limit (ι ε v : Set)
  requires finite : Finite(ι)
  requires signs : SignsOn(ι, ε)
  requires hv : v ∈ fockSpace(ι, ε)
  requires rapid : IsRapidDatum(ι, v)
  shows ∃ P, (P : ℕ → cPolys(ι)) ∧ ∀ N ∈ ℕ, ∀ δ ∈ ℝ, realZero < δ → ∃ k0 ∈ ℕ,
    ∀ k ∈ ℕ, k0 ≤ k → EnnLe(weightedNorm(ι, vectorDifference(ι, ε, v,
      polyVector(ι, ε, P(k))), N), δ)
proof
  sorry

-- MixedFockModel.lean, MixedModel ε′ ε p: matrices L, K : ι′ × p and
-- I : ι′ × ι, and maps v ↦ v[a] (a ∈ ℂ^p) from the Fock space of ε′ to
-- that of ε, with ℂ^ι′ = Lℂ^p + Iℂ^ι + Kℂ^p,
-- (ϱ(La′ + Iw + Kb)v)[a] = β₁(a + (a + a′), b) ϱ(w)(v[a + a′]) for the
-- standard signs 1 on p, and vac[a] = exp(−a*a) vac.
structure MixedModelData
  | left right middle slice : Set

-- La′ + Iw + Kb in ℂ^ι′.
def mixedPoint (ι1 ι p M a1 w b : Set) : Set :=
  vecAdd(complexRing, ι1, vecAdd(complexRing, ι1,
    mulVec(complexRing, ι1, p, MixedModelData.left(M), a1),
    mulVec(complexRing, ι1, ι, MixedModelData.middle(M), w)),
    mulVec(complexRing, ι1, p, MixedModelData.right(M), b))

def unitSignsOn (p : Set) : Set := p × {complexOne}

predicate IsMixedModel (ι1 ε1 ι ε p M : Set) :=
  MixedModelData.Data(M) ∧ Finite(ι1) ∧ Finite(ι) ∧ Finite(p) ∧
  SignsOn(ι1, ε1) ∧ SignsOn(ι, ε) ∧
  MixedModelData.left(M) ∈ matrixSpace(complexRing, ι1, p) ∧
  MixedModelData.right(M) ∈ matrixSpace(complexRing, ι1, p) ∧
  MixedModelData.middle(M) ∈ matrixSpace(complexRing, ι1, ι) ∧
  (∀ a ∈ cVectors(p), LinearMap(MixedModelData.slice(M)(a), fockModule(ι1, ε1),
    fockModule(ι, ε), complexRing)) ∧
  (∀ y ∈ cVectors(ι1), ∃ a1 ∈ cVectors(p), ∃ w ∈ cVectors(ι), ∃ b ∈ cVectors(p),
    y = mixedPoint(ι1, ι, p, M, a1, w, b)) ∧
  (∀ a ∈ cVectors(p), ∀ a1 ∈ cVectors(p), ∀ w ∈ cVectors(ι), ∀ b ∈ cVectors(p),
    ∀ v ∈ fockSpace(ι1, ε1),
      MixedModelData.slice(M)(a)(realHeisOp(ι1, ε1, mixedPoint(ι1, ι, p, M, a1, w, b))(v)) =
        Module.smul(fockModule(ι, ε))(realHeis(p, unitSignsOn(p))(
          vecAdd(complexRing, p, a, vecAdd(complexRing, p, a, a1)), b),
          realHeisOp(ι, ε, w)(MixedModelData.slice(M)(vecAdd(complexRing, p, a, a1))(v)))) ∧
  (∀ a ∈ cVectors(p), MixedModelData.slice(M)(a)(realVac(ι1)) =
    Module.smul(fockModule(ι, ε))(complexExp(ℂ[-cDot(p, a, a)]), realVac(ι)))

-- MixedFockModel.lean, MixedModel.exists_weightedNorm_slice_le and
-- isRapidDatum_slice: (1 + ‖a‖)^M mom_N(v[a]) ≤ C mom_{N+M}(v) for a
-- finite C, so the slices of a rapid datum are rapid.
theorem IsMixedModel.slice_le (ι1 ε1 ι ε p M : Set, N K : Nat)
  requires mixed : IsMixedModel(ι1, ε1, ι, ε, p, M)
  shows ∃ C ∈ ℝ, ∀ a ∈ cVectors(p), ∀ v ∈ fockSpace(ι1, ε1),
    EnnLe(ennMul(ennOfReal(R[R[realOne + cSupNorm(p, a)] ^ K]),
      weightedNorm(ι, MixedModelData.slice(M)(a)(v), N)),
      ennMul(ennOfReal(C), weightedNorm(ι1, v, N + K)))
proof
  sorry

theorem IsMixedModel.slice_rapid (ι1 ε1 ι ε p M a v : Set)
  requires mixed : IsMixedModel(ι1, ε1, ι, ε, p, M)
  requires ha : a ∈ cVectors(p)
  requires hv : v ∈ fockSpace(ι1, ε1)
  requires rapid : IsRapidDatum(ι1, v)
  shows IsRapidDatum(ι, MixedModelData.slice(M)(a)(v))
proof
  sorry

-- Section: Inner products and matrix coefficients of Fock vectors
-- FockHarmonicCoeff.lean, realInner_polyVector: ⟨v_P, v_Q⟩ = (P̄(∂)Q)(0)
-- = Σ_m conj(P_m) Q_m m! (the Fischer product).
def factorialValues (ι m : Set) : Set :=
  { (i, complexOfReal(realNat(factorial(m(i))))) | i ∈ ι }

def monomialFactorial (ι m : Set) : Set := complexFiniteProduct(ι, factorialValues(ι, m))

def fischerTerms (ι P Q : Set) : Set :=
  { (m, ℂ[complexConj(P(m)) * Q(m) * monomialFactorial(ι, m)]) |
    m ∈ mvSupport(complexRing, ι, P) }

theorem polyVector.inner (ι ε P Q : Set)
  requires finite : Finite(ι)
  requires signs : SignsOn(ι, ε)
  requires hP : P ∈ cPolys(ι)
  requires hQ : Q ∈ cPolys(ι)
  shows realInner(ι, polyVector(ι, ε, P), polyVector(ι, ε, Q)) =
    groupFiniteSum(complexAdditiveGroup, mvSupport(complexRing, ι, P), fischerTerms(ι, P, Q))
proof
  sorry

-- FockHarmonicCoeff.lean, denseRange_polyVector: the Fock vectors are
-- dense in 𝓕.
theorem polyVector.dense (ι ε v δ : Set)
  requires finite : Finite(ι)
  requires signs : SignsOn(ι, ε)
  requires hv : v ∈ fockSpace(ι, ε)
  requires hδ : δ ∈ ℝ
  requires positive : realZero < δ
  shows ∃ P ∈ cPolys(ι), fockNorm(ι, ε)(vectorDifference(ι, ε, v, polyVector(ι, ε, P))) < δ
proof
  sorry

-- FockHarmonicCoeff.lean, fockMatrixCoeff u P Q = ⟨v_P, ω₀(u)v_Q⟩.
def fockMatrixCoeff (ι ε u P Q : Set) : Set :=
  realInner(ι, polyVector(ι, ε, P), realWeil(ι, ε, u)(polyVector(ι, ε, Q)))

-- FockHarmonicCoeff.lean, complexLinearPart u = P₊uP₊ + P₋ ū P₋ (ū the
-- entrywise conjugate; P₋ = posProj(−ε)).
def negSigns (ι ε : Set) : Set := { (i, ℂ[-ε(i)]) | i ∈ ι }

def complexLinearPart (ι ε u : Set) : Set :=
  matAdd(complexRing, ι, ι,
    matMul(complexRing, ι, ι, ι, posProj(ι, ε), matMul(complexRing, ι, ι, ι, u, posProj(ι, ε))),
    matMul(complexRing, ι, ι, ι, posProj(ι, negSigns(ι, ε)),
      matMul(complexRing, ι, ι, ι, matMap(complexRing, ι, ι, complexConj, u),
        posProj(ι, negSigns(ι, ε)))))

-- The substitution X_s ↦ Σ_t A_ts X_t (linSubst of
-- Lib/General/Algebra/ZerosCostDegree.lean).
def linSubstTerms (ι A s : Set) : Set :=
  { (t, call2(Ring.mul(polynomialRing(complexRing, ι)),
      polynomialConstant(complexRing, ι)(A[t, s]), X(complexRing, ι, t))) | t ∈ ι }

def linSubstImages (ι A : Set) : Set :=
  { (s, groupFiniteSum(Ring.additive(polynomialRing(complexRing, ι)), ι,
      linSubstTerms(ι, A, s))) | s ∈ ι }

def linSubst (ι A P : Set) : Set := mvBind(complexRing, ι, ι, linSubstImages(ι, A))(P)

-- P is killed by ∂ᵢ∂ⱼ whenever dᵢ = dⱼ and εᵢ ≠ εⱼ.
predicate HarmonicFor (ι ε d P : Set) :=
  P ∈ cPolys(ι) ∧ ∀ i ∈ ι, ∀ j ∈ ι, d(i) = d(j) → ε(i) ≠ ε(j) →
    partialDerivative(complexRing, ι, i)(partialDerivative(complexRing, ι, j)(P)) =
      Ring.zero(polynomialRing(complexRing, ι))

-- FockHarmonicCoeff.lean, fockMatrixCoeff_eq_realInner: for u ∈ U(ε)
-- block diagonal for the labels d and Q, P harmonic for d,
-- ⟨v_Q, ω₀(u)v_P⟩ = (det u₋)⁻¹ ⟨v_{Q′}, v_P⟩, Q′ = linSubst A⁻¹ Q with
-- A = complexLinearPart u.
theorem fockMatrixCoeff.eq_inner (ι ε u d P Q : Set)
  requires finite : Finite(ι)
  requires signs : SignsOn(ι, ε)
  requires hu : u ∈ signUnitaryMatrices(ι, ε)
  requires block : ∀ i ∈ ι, ∀ j ∈ ι, d(i) ≠ d(j) → u[i, j] = complexZero
  requires harmonicQ : HarmonicFor(ι, ε, d, Q)
  requires harmonicP : HarmonicFor(ι, ε, d, P)
  shows fockMatrixCoeff(ι, ε, u, Q, P) =
    ℂ[complexInv(principalMinor(u, negIndices(ι, ε))) *
      realInner(ι, polyVector(ι, ε, linSubst(ι,
        matInverse(complexRing, ι, complexLinearPart(ι, ε, u)), Q)), polyVector(ι, ε, P))]
proof
  sorry

end Fock
