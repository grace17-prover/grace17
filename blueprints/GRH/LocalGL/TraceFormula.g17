-- The matrix lemma of the trace comparison: a matrix with irreducible
-- characteristic polynomial is determined by its powers on one nonzero
-- vector.
-- Source: grh-compact/src/Lib/LocalGL/TraceFormula/TraceComparison.lean
-- (eq_of_pow_mulVec_eq).
-- Not stated: the rest of Lib/LocalGL/TraceFormula (TraceComparison:
-- frameClass, geometricTerm, orbitalIntegral, orbitalIntegral_unfold,
-- elliptic_of_integral_ne_zero, exists_trace_eq; ChangingSigns:
-- finite_isSignedFrame_classes, numberedRoots, IsEllipticSimilitude,
-- HasSignType, exists_eigenbasis_diag_form, exists_hasSignType_mul_iff)
-- and Lib/LocalGL/TaylorWiles (HeckeAlgebra, AuxPlaceOperators), which
-- need the hermitian spaces, adelic unitary groups G_f, levels, cusp
-- kernels and integral forms of base level of Lib/Adelic and
-- Lib/GaloisRep.
-- Encoding. Matrices are those of GRH.Matrix.Basic over a field F at a
-- natural index set n; A^j is matPow.
-- Part of the GRH blueprint (layer 4, Lib/LocalGL, stage S3).
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.LocalGL.TraceFormula
import GRH.Polynomial.Univariate

section TraceFormula

-- eq_of_pow_mulVec_eq: if χ_A is irreducible, y ≠ 0 and Aʲy = Bʲy for all
-- j ≤ n, then A = B.
theorem matrix.eq_of_pow_mulVec (F n A B y : Set)
  requires field : Field(F)
  requires natural : n ∈ ℕ
  requires hA : A ∈ matrixSpace(F, n, n)
  requires hB : B ∈ matrixSpace(F, n, n)
  requires irreducible : RingIrreducible(polynomialRing(F, {0}), matCharpoly(F, n, A))
  requires hy : y ∈ functionSpace(n, Ring.carrier(F))
  requires nonzero : y ≠ constantFunction(n, Ring.carrier(F), Ring.zero(F))
  requires powers : ∀ j ∈ succ(n),
    mulVec(F, n, n, matPow(F, n, A, j), y) = mulVec(F, n, n, matPow(F, n, B, j), y)
  shows A = B
proof
  sorry

end TraceFormula
