-- Cuspidal class functions on matrices over a finite field: the adjoint
-- `skew` is a derivation on cuspidal functions (Zelevinsky), the Möbius
-- function μ = 𝟙⁻¹ lives on semisimple classes and is real, the block
-- averages of F·μ, the cuspidal function C_η = (β_η μ) ∗ 𝟙 with
-- C_η ∗ 𝟙 = −β_η, cuspidal functions vanish off primary classes, and the
-- order of GLₙ(F_q).
-- Source: grh-compact/src/Lib/LocalGL/Green/CuspidalFunction.lean
-- (Hall.rankInner_mul_eq_rankInner_skew, Hall.mul_apply_of_dim_zero,
-- Hall.rankInner_mul_of_isCuspidal, Hall.skew_of_isCuspidal, Hall.skew_mul,
-- Hall.mu_mul_constOne, Hall.sum_inverse_constOne,
-- Hall.isSemisimple_of_mu_ne_zero, Hall.mu_apply_of_dim_zero,
-- Hall.blockAverage_mulMu, Hall.conj_mu, Hall.greenCuspidal_mul_constOne,
-- Hall.greenCuspidal_eq_zero_of_dim_lt_one, Hall.isCuspidal_greenCuspidal),
-- Lib/LocalGL/Green/CuspidalSupport.lean (charpoly_eq_pow_of_isNilpotent,
-- Hall.IsCuspidal.exists_charpoly_eq_pow), Lib/LocalGL/Green/
-- CuspidalAtScalars.lean (card_GL_eq_prod).
-- Not stated: Hall.crapo_complementation (a lemma on finite modular
-- lattices, used only inside isSemisimple_of_mu_ne_zero), greenCuspidal_congr
-- and the generating-series values moebius_and_greenCuspidal_lsmul and
-- mulMu_greenCuspidal_lsmul at multiplication by a field generator.
-- Encoding as in GRH.LocalGL.Hall. Functions concentrated in dimension d
-- vanish on every pair (n, A) with n ≠ d. A semisimple endomorphism is one
-- whose stable subspaces all have stable complements (Module.End.IsSemisimple
-- over a field).
-- Part of the GRH blueprint (layer 4, Lib/LocalGL, stage S3).
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.LocalGL.Cuspidal
import GRH.LocalGL.Hall

section Cuspidal
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- Section: Definitions
-- F is concentrated in dimension d.
predicate ConcentratedIn (K d F : Set) :=
  ∀ p ∈ squareMatrixPairs(K), fst(p) ≠ d → F(p) = complexZero

-- Module.End.IsSemisimple g over a field: every g-stable subspace has a
-- g-stable complement.
predicate EndSemisimple (K V g : Set) :=
  ∀ W ∈ stableSubspaces(K, V, g), ∃ C ∈ stableSubspaces(K, V, g),
    W ∩ C = {Module.zero(V)} ∧ submoduleSum(V, W, C) = Module.carrier(V)

-- The zero map W → V and the direct sum b ⊕ a = blockTriangularEnd a b 0.
def zeroMap (W V : Set) : Set :=
  constantFunction(Module.carrier(W), Module.carrier(V), Module.zero(V))

def directSumAt (K B p q : Set) : Set :=
  hallAt(K, B, productModule(coordSpace(K, fst(q)), K, coordSpace(K, fst(p))),
    blockTriangularEnd(coordSpace(K, fst(p)), matEnd(K, p), coordSpace(K, fst(q)),
      matEnd(K, q), zeroMap(coordSpace(K, fst(q)), coordSpace(K, fst(p)))))

-- The terms μ(g|W) summed in sum_inverse_constOne.
def moebiusTerms (K V g : Set) : Set :=
  { (W, hallAt(K, hallMoebius(K), subModuleOf(K, V, W), endOnSub(W, g))) |
    W ∈ stableSubspaces(K, V, g) }

-- The pointwise negative of the Brauer lift.
def negBrauerLift (E η : Set) : Set := hallNeg(Algebra.base(E), brauerLift(E, η))

-- Section: Skew and cuspidal functions
-- Hall.rankInner_mul_eq_rankInner_skew: for f concentrated in dimension d,
-- ⟨f ∗ H, F⟩_{d+n} = ⟨H, skew d f F⟩ₙ.
theorem rankInner.mul_concentrated (K d n f H F : Set)
  requires field : FiniteField(K)
  requires hd : d ∈ ℕ
  requires hn : n ∈ ℕ
  requires hf : f ∈ hallFunctions(K)
  requires hH : H ∈ hallFunctions(K)
  requires hF : F ∈ hallFunctions(K)
  requires concentrated : ConcentratedIn(K, d, f)
  shows rankInner(K, add(d, n), hallMul(K, f, H), F) = rankInner(K, n, H, skew(K, d, f, F))
proof
  sorry

-- Hall.mul_apply_of_dim_zero: at the class of dimension 0, (F ∗ H) = F H.
theorem hallMul.dim_zero (K F H o : Set)
  requires field : FiniteField(K)
  requires hF : F ∈ hallFunctions(K)
  requires hH : H ∈ hallFunctions(K)
  requires ho : o ∈ squareMatrixPairs(K)
  requires zero : fst(o) = (0:N)
  shows hallMul(K, F, H)(o) = ℂ[F(o) * H(o)]
proof
  sorry

-- Hall.rankInner_mul_of_isCuspidal: for c cuspidal and d ≠ 0,
-- ⟨c, F ∗ H⟩_d = ⟨c, F⟩_d ⟨𝟙, H⟩₀ + ⟨𝟙, F⟩₀ ⟨c, H⟩_d.
theorem rankInner.mul_cuspidal (K d c F H : Set)
  requires field : FiniteField(K)
  requires hd : d ∈ ℕ
  requires nonzero : d ≠ (0:N)
  requires hc : c ∈ hallFunctions(K)
  requires cuspidal : IsCuspidal(K, c)
  requires hF : F ∈ hallFunctions(K)
  requires hH : H ∈ hallFunctions(K)
  shows rankInner(K, d, c, hallMul(K, F, H)) =
    ℂ[rankInner(K, d, c, F) * rankInner(K, (0:N), constOne(K), H) +
      rankInner(K, (0:N), constOne(K), F) * rankInner(K, d, c, H)]
proof
  sorry

-- Hall.skew_of_isCuspidal: skew d f c = ⟨f, c⟩_d · 1 for c cuspidal.
theorem skew.cuspidal (K d f c : Set)
  requires field : FiniteField(K)
  requires hd : d ∈ ℕ
  requires nonzero : d ≠ (0:N)
  requires hf : f ∈ hallFunctions(K)
  requires hc : c ∈ hallFunctions(K)
  requires cuspidal : IsCuspidal(K, c)
  shows skew(K, d, f, c) = hallSmul(K, rankInner(K, d, f, c), hallOne(K))
proof
  sorry

-- Hall.skew_mul (Zelevinsky): for c cuspidal and d ≠ 0, skew d c is a
-- derivation of the induction product.
theorem skew.derivation (K d c F H : Set)
  requires field : FiniteField(K)
  requires hd : d ∈ ℕ
  requires nonzero : d ≠ (0:N)
  requires hc : c ∈ hallFunctions(K)
  requires cuspidal : IsCuspidal(K, c)
  requires hF : F ∈ hallFunctions(K)
  requires hH : H ∈ hallFunctions(K)
  shows skew(K, d, c, hallMul(K, F, H)) =
    hallAdd(K, hallMul(K, skew(K, d, c, F), H), hallMul(K, F, skew(K, d, c, H)))
proof
  sorry

-- Section: The Möbius function
-- Hall.sum_inverse_constOne: Σ_W μ(g|W) = 1(g) over the g-stable W.
theorem hallMoebius.sum_stable (K V g : Set)
  requires field : FiniteField(K)
  requires finite : FiniteDimensional(V, K)
  requires hg : g ∈ linearMaps(V, K, V)
  shows csLGSum(stableSubspaces(K, V, g), moebiusTerms(K, V, g)) = hallAt(K, hallOne(K), V, g)
proof
  sorry

-- Hall.isSemisimple_of_mu_ne_zero (P. Hall, Crapo): μ(g) ≠ 0 forces g
-- semisimple.
theorem hallMoebius.semisimple (K V g : Set)
  requires field : FiniteField(K)
  requires finite : FiniteDimensional(V, K)
  requires hg : g ∈ linearMaps(V, K, V)
  requires nonzero : hallAt(K, hallMoebius(K), V, g) ≠ complexZero
  shows EndSemisimple(K, V, g)
proof
  sorry

-- Hall.mu_apply_of_dim_zero and Hall.conj_mu: μ = 1 in dimension 0, and μ
-- is real.
theorem hallMoebius.dim_zero (K o : Set)
  requires field : FiniteField(K)
  requires ho : o ∈ squareMatrixPairs(K)
  requires zero : fst(o) = (0:N)
  shows hallMoebius(K)(o) = complexOne
proof
  sorry

theorem hallMoebius.real (K p : Set)
  requires field : FiniteField(K)
  requires hp : p ∈ squareMatrixPairs(K)
  shows complexConj(hallMoebius(K)(p)) = hallMoebius(K)(p)
proof
  sorry

-- Hall.blockAverage_mulMu: δ(B·μ)(a, b) = μ(a) μ(b) B(b ⊕ a).
theorem blockAverage.mulMu (K B p q : Set)
  requires field : FiniteField(K)
  requires hB : B ∈ hallFunctions(K)
  requires hp : p ∈ squareMatrixPairs(K)
  requires hq : q ∈ squareMatrixPairs(K)
  shows blockAverage(K, mulMu(K, B), p, q) =
    ℂ[hallMoebius(K)(p) * hallMoebius(K)(q) * directSumAt(K, B, p, q)]
proof
  sorry

-- Section: The cuspidal function C_η
-- Hall.greenCuspidal_mul_constOne: C_η ∗ 𝟙 = −β_η.
theorem greenCuspidal.mul_constOne (E η : Set)
  requires extension : FieldExtension(E)
  requires finite : FiniteField(Algebra.base(E))
  requires hη : η ∈ functionSpace(algebraCarrier(E), complexCarrier)
  shows hallMul(Algebra.base(E), greenCuspidal(E, η), constOne(Algebra.base(E))) =
    negBrauerLift(E, η)
proof
  sorry

-- Hall.greenCuspidal_eq_zero_of_dim_lt_one: C_η vanishes in dimension 0.
theorem greenCuspidal.dim_zero (E η o : Set)
  requires extension : FieldExtension(E)
  requires finite : FiniteField(Algebra.base(E))
  requires hη : η ∈ functionSpace(algebraCarrier(E), complexCarrier)
  requires ho : o ∈ squareMatrixPairs(Algebra.base(E))
  requires zero : fst(o) = (0:N)
  shows greenCuspidal(E, η)(o) = complexZero
proof
  sorry

-- Hall.isCuspidal_greenCuspidal: C_η is cuspidal.
theorem greenCuspidal.cuspidal (E η : Set)
  requires extension : FieldExtension(E)
  requires finite : FiniteField(Algebra.base(E))
  requires hη : η ∈ functionSpace(algebraCarrier(E), complexCarrier)
  shows IsCuspidal(Algebra.base(E), greenCuspidal(E, η))
proof
  sorry

theorem greenCuspidal.closed (E η : Set)
  requires extension : FieldExtension(E)
  requires finite : FiniteField(Algebra.base(E))
  requires hη : η ∈ functionSpace(algebraCarrier(E), complexCarrier)
  shows greenCuspidal(E, η) ∈ hallFunctions(Algebra.base(E)) ∧
    brauerLift(E, η) ∈ hallFunctions(Algebra.base(E))
proof
  sorry

-- Section: Support of cuspidal functions
-- charpoly_eq_pow_of_isNilpotent: if P is monic irreducible and P(g) is
-- nilpotent (read on the matrix of g in a basis), then
-- χ_g = P^j with j deg P = dim V.
theorem endCharpoly.nilpotent_power (K V g P n b : Set)
  requires field : Field(K)
  requires hg : g ∈ linearMaps(V, K, V)
  requires natural : n ∈ ℕ
  requires basis : ModuleBasis(V, K, n, b)
  requires irreducible : RingIrreducible(polynomialRing(K, {0}), P)
  requires monic : PolyMonic(K, P)
  requires nilpotent : ∃ m ∈ ℕ,
    matPow(K, n, matPolyEval(K, n, linearToMatrix(V, K, V, n, b, n, b, g), P), m) =
      matZero(K, n, n)
  shows ∃ j ∈ ℕ, mul(j, polyNatDegree(K, P)) = n ∧
    endCharpoly(K, V, g) = Ring.pow(polynomialRing(K, {0}), P, j)
proof
  sorry

-- Hall.IsCuspidal.exists_charpoly_eq_pow: a cuspidal F vanishes at g
-- unless χ_g is a power of an irreducible polynomial.
theorem IsCuspidal.primary_support (K F V g : Set)
  requires field : FiniteField(K)
  requires finite : FiniteDimensional(V, K)
  requires hF : F ∈ hallFunctions(K)
  requires cuspidal : IsCuspidal(K, F)
  requires hg : g ∈ linearMaps(V, K, V)
  requires nonzero : hallAt(K, F, V, g) ≠ complexZero
  shows ∃ P ∈ uniPolys(K), ∃ j ∈ ℕ, RingIrreducible(polynomialRing(K, {0}), P) ∧
    endCharpoly(K, V, g) = Ring.pow(polynomialRing(K, {0}), P, j)
proof
  sorry

-- Section: The order of GLₙ(F_q)
-- card_GL_eq_prod: |GLₙ(k)| = Π_{i<n} qⁱ (q^{i+1} − 1), q = |k|.
def glOrderTerms (q n : Set) : Set :=
  { (i, ℂ[csLGNat(pow(q, i)) * (csLGNat(pow(q, succ(i))) - complexOne)]) | i ∈ n }

theorem invertibleMatrices.card (K n : Set)
  requires field : FiniteField(K)
  requires natural : n ∈ ℕ
  shows csLGNat(cardinality(invertibleMatrices(K, n))) =
    csLGProduct(n, glOrderTerms(cardinality(Ring.carrier(K)), n))
proof
  sorry

end Cuspidal
