-- GLₙ over a non-archimedean local field as the Iwahori-level
-- representation theory of GRH.LocalGL uses it: the discretely valued
-- field with compact integers, GLₙ(𝒪), the pro-p Iwahori and block
-- parahoric subgroups, diagonal, permutation and transvection elements,
-- the dominant torus, smooth representations, the mean over a compact
-- open subgroup, unitary forms, cyclic spans, the normalised absolute
-- value and the torus characters, exponents and Iwahori eigenvectors, the
-- operators U_t, Hecke operators of double cosets, the spherical Hecke
-- operators T_j and the Hecke polynomial.
-- Source: STAND-IN for grh-compact/src/Lib/Adelic/Unitary/CongruenceLevel.lean
-- (residuePreimage, blockParahoric, dominantTorus, proIwahori, IsExponent,
-- IsIwahoriEigen, normAbsChar, torusChar, permGL, iwahoriHeckeHom),
-- Lib/General/Groups/ValuationPair.lean (diagGL, transvectionGL, intGL),
-- Lib/General/Groups/CompactMean.lean (IsSmoothRep, IsUnitary,
-- compactMean), Lib/General/Groups/CyclicSubrep.lean (cyclicSpan),
-- Lib/General/LinearAlgebra/PartialDerivComm.lean (heckeCoset),
-- Lib/Adelic/Unitary/SpaceDefs.lean (Kw, basicDoubleCoset, heckeGL) and
-- Lib/Weil/Unramified/SphericalHecke.lean (heckePoly); stated here for
-- GRH.LocalGL until those groups are stated.
-- Encoding. The source's field F with [Valued F ℤᵐ⁰] and
-- [CompactSpace 𝒪[F]] (and E_w = LocField w, a special case) is a field F
-- with a surjective valuation ord : F∖{0} → ℤ, with finite residue field
-- and complete; v(x) = exp(−ord x), so v ϖ = exp(−1) says ord ϖ = 1 and
-- v x ≤ 1 says x ∈ 𝒪. GL_N(F) is generalLinearGroup(F, N) for a natural N
-- (the source's Fin N). The topology of GL_N(F) enters only through
-- smoothness, read with the neighbourhood basis of congruence subgroups
-- 1 + ϖᵐ M_N(𝒪). The mean over a compact open H, an integral in the
-- source, is the average of π(h)x over H/K for any congruence subgroup
-- K ⊆ H fixing x (heckeFun of GRH.Adelic.Adeles divided by [H : K]), the
-- value common to all such K. A representation is a GroupRep on a complex
-- module W; a linear form is a linear map W → ℂ; a sesquilinear form B is
-- a function B(x)(y). A character ξ of the torus is a function on families
-- t : N → Fˣ with values in ℂ.
-- Part of the GRH blueprint (layer 4, Lib/LocalGL, stage S3).
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.LocalGL.PadicGL
import GRH.Adelic.Adeles
import GRH.LocalGL.GroupChars

section PadicGL
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- Section: The local field
-- The nonzero elements of F.
def csLGNonzero (F : Set) : Set := Ring.carrier(F) ∖ {Ring.zero(F)}

-- ord(x) ≥ m, with ord(0) = ∞.
predicate csLGOrdGe (F ord x m : Set) :=
  x = Ring.zero(F) ∨ realInt(m) ≤ realInt(ord(x))

-- 𝒪 = {v ≤ 1} and 𝔭 = {v < 1}.
def csLGInt (F ord : Set) : Set :=
  { x ∈ Ring.carrier(F) | csLGOrdGe(F, ord, x, integerOfNat((0:N))) }

def csLGMaximal (F ord : Set) : Set :=
  { x ∈ Ring.carrier(F) | csLGOrdGe(F, ord, x, integerOfNat((1:N))) }

-- x ≡ y mod 𝔭ᵐ.
predicate csLGCongruent (F ord x y m : Set) :=
  csLGOrdGe(F, ord, Ring.sub(F, x, y), integerOfNat(m))

-- Congruence modulo 𝔭 on 𝒪 and the order q of the residue field.
def csLGResidueRelation (F ord : Set) : Set :=
  { p ∈ csLGInt(F, ord) × csLGInt(F, ord) | Ring.sub(F, fst(p), snd(p)) ∈ csLGMaximal(F, ord) }

def csLGResidueOrder (F ord : Set) : Set :=
  cardinality(csLGInt(F, ord) ⧸ csLGResidueRelation(F, ord))

-- STAND-IN for [Field F] [Valued F ℤᵐ⁰] [CompactSpace 𝒪[F]]: ord is a
-- surjective discrete valuation, 𝒪/𝔭 is finite and F is complete.
predicate csLGLocalField (F ord : Set) :=
  Field(F) ∧ FunctionBetween(ord, csLGNonzero(F), ℤ) ∧
  (∀ y ∈ ℤ, ∃ x ∈ csLGNonzero(F), ord(x) = y) ∧
  (∀ x ∈ csLGNonzero(F), ∀ y ∈ csLGNonzero(F),
    ord(call2(Ring.mul(F), x, y)) = integerAddValue(ord(x), ord(y))) ∧
  (∀ x ∈ csLGNonzero(F), ∀ y ∈ csLGNonzero(F), ∀ m ∈ ℤ,
    csLGOrdGe(F, ord, x, m) → csLGOrdGe(F, ord, y, m) →
    csLGOrdGe(F, ord, call2(Ring.add(F), x, y), m)) ∧
  Finite(csLGInt(F, ord) ⧸ csLGResidueRelation(F, ord)) ∧
  (∀ s ∈ functionSpace(ℕ, csLGInt(F, ord)),
    (∀ m ∈ ℕ, csLGCongruent(F, ord, s(succ(m)), s(m), m)) →
    ∃ x ∈ csLGInt(F, ord), ∀ m ∈ ℕ, csLGCongruent(F, ord, x, s(m), m))

-- A uniformiser: ord ϖ = 1 (v ϖ = exp(−1)).
predicate csLGUniformiser (F ord ϖ : Set) :=
  ϖ ∈ csLGNonzero(F) ∧ ord(ϖ) = integerOfNat((1:N))

-- Section: Subgroups of GL_N(F)
def csLGGL (F N : Set) : Set := generalLinearGroup(F, N)

def csLGInv (F N g : Set) : Set := matInverse(F, N, g)

-- intGL N 𝒪 = GL_N(𝒪): g and g⁻¹ have entries in 𝒪.
def csLGIntGL (F ord N : Set) : Set :=
  { g ∈ invertibleMatrices(F, N) | ∀ i ∈ N, ∀ j ∈ N,
    g(i, j) ∈ csLGInt(F, ord) ∧ csLGInv(F, N, g)(i, j) ∈ csLGInt(F, ord) }

-- proIwahori: elements of GL_N(𝒪) upper unitriangular modulo 𝔭.
def csLGProIwahori (F ord N : Set) : Set :=
  { g ∈ csLGIntGL(F, ord, N) |
    (∀ i ∈ N, ∀ j ∈ N, (j:N) < (i:N) → g(i, j) ∈ csLGMaximal(F, ord)) ∧
    (∀ i ∈ N, Ring.sub(F, g(i, i), Ring.one(F)) ∈ csLGMaximal(F, ord)) }

-- blockParahoric c: elements of GL_N(𝒪) with g_ij ∈ 𝔭 when c(j) < c(i).
def csLGBlockParahoric (F ord N c : Set) : Set :=
  { g ∈ csLGIntGL(F, ord, N) | ∀ i ∈ N, ∀ j ∈ N,
    (c(j):N) < (c(i):N) → g(i, j) ∈ csLGMaximal(F, ord) }

-- The congruence subgroup 1 + 𝔭ᵐ M_N(𝒪), m ≥ 1.
def csLGCongruenceGL (F ord N m : Set) : Set :=
  { g ∈ csLGIntGL(F, ord, N) | ∀ i ∈ N, ∀ j ∈ N,
    csLGCongruent(F, ord, g(i, j), matOne(F, N)(i, j), m) }

-- diagGL t, permGL σ (the matrix with eⱼ ↦ e_σ(j)), transvectionGL
-- i j a = 1 + a Eᵢⱼ.
def csLGDiagGL (F N t : Set) : Set := matDiagonal(F, N, t)

def csLGPermEntry (F σ q : Set) : Set :=
  ⋃({ c ∈ Ring.carrier(F) | (σ(snd(q)) = fst(q) ∧ c = Ring.one(F)) ∨
    (σ(snd(q)) ≠ fst(q) ∧ c = Ring.zero(F)) })

def csLGPermGL (F N σ : Set) : Set := { (q, csLGPermEntry(F, σ, q)) | q ∈ N × N }

def csLGTransvectionGL (F N i j a : Set) : Set :=
  matAdd(F, N, N, matOne(F, N), matSingle(F, N, N, i, j, a))

-- The families t : N → Fˣ and dominantTorus: ord t_i ≥ ord t_j for i ≤ j
-- (|t_i| ≤ |t_j|).
def csLGTorus (F N : Set) : Set := functionSpace(N, csLGNonzero(F))

def csLGDominantTorus (F ord N : Set) : Set :=
  { t ∈ csLGTorus(F, N) | ∀ i ∈ N, ∀ j ∈ N, (i:N) ≤ (j:N) →
    realInt(ord(t(j))) ≤ realInt(ord(t(i))) }

-- Pointwise product of torus elements and the family ϖ at i, 1 elsewhere.
def csLGTorusMul (F N s t : Set) : Set := { (i, call2(Ring.mul(F), s(i), t(i))) | i ∈ N }

def csLGMulSingleValue (F a i j : Set) : Set :=
  ⋃({ c ∈ Ring.carrier(F) | (j = i ∧ c = a) ∨ (j ≠ i ∧ c = Ring.one(F)) })

def csLGMulSingle (F N i a : Set) : Set := { (j, csLGMulSingleValue(F, a, i, j)) | j ∈ N }

-- Section: Smooth representations and means
-- IsSmoothRep: every vector is fixed by some congruence subgroup.
predicate csLGSmoothRep (F ord N W π : Set) :=
  GroupRep(csLGGL(F, N), complexRing, W, π) ∧
  ∀ x ∈ Module.carrier(W), ∃ m ∈ ℕ, (0:N) < (m:N) ∧
    x ∈ fixedSpace(csLGGL(F, N), csLGCongruenceGL(F, ord, N, m), W, π)

-- The indicator function of a subset S of GL_N(F), with values in ℂ.
def csLGIndicatorValue (S g : Set) : Set :=
  ⋃({ c ∈ complexCarrier | (g ∈ S ∧ c = complexOne) ∨ (g ∉ S ∧ c = complexZero) })

def csLGIndicator (F N S : Set) : Set :=
  { (g, csLGIndicatorValue(S, g)) | g ∈ invertibleMatrices(F, N) }

-- The average of π(h)x over H/K for a congruence subgroup K ⊆ H fixing x.
def csLGMeanAt (F ord N W π H K x : Set) : Set :=
  Module.smul(W)(complexInv(csLGNat(cardinality(heckeSupport(csLGGL(F, N), K, complexRing,
      csLGIndicator(F, N, H))))),
    heckeFun(csLGGL(F, N), K, complexRing, W, π, csLGIndicator(F, N, H), x))

-- compactMean ρ H x: the mean of π(h)x over the compact open H, the value
-- common to all congruence subgroups inside H fixing x.
def csLGCompactMean (F ord N W π H x : Set) : Set :=
  ⋃({ y ∈ Module.carrier(W) | ∀ m ∈ ℕ, (0:N) < (m:N) →
    csLGCongruenceGL(F, ord, N, m) ⊆ H →
    x ∈ fixedSpace(csLGGL(F, N), csLGCongruenceGL(F, ord, N, m), W, π) →
    y = csLGMeanAt(F, ord, N, W, π, H, csLGCongruenceGL(F, ord, N, m), x) })

-- IsUnitary ρ B: B is sesquilinear, positive definite and invariant.
predicate csLGIsUnitary (F N W π B : Set) :=
  (∀ x ∈ Module.carrier(W), LinearMap(B(x), W, complexRing, selfModule(complexRing))) ∧
  (∀ x ∈ Module.carrier(W), ∀ y ∈ Module.carrier(W), ∀ z ∈ Module.carrier(W),
    B(call2(Module.add(W), x, y))(z) = ℂ[B(x)(z) + B(y)(z)]) ∧
  (∀ a ∈ complexCarrier, ∀ x ∈ Module.carrier(W), ∀ z ∈ Module.carrier(W),
    B(Module.smul(W)(a, x))(z) = ℂ[complexConj(a) * B(x)(z)]) ∧
  (∀ x ∈ Module.carrier(W), x ≠ Module.zero(W) →
    complexIm(B(x)(x)) = realZero ∧ (0:R) < complexRe(B(x)(x))) ∧
  (∀ g ∈ invertibleMatrices(F, N), ∀ x ∈ Module.carrier(W), ∀ y ∈ Module.carrier(W),
    B(π(g)(x))(π(g)(y)) = B(x)(y))

-- cyclicSpan ρ x: the span of the translates π(g)x.
def csLGTranslates (F N π x : Set) : Set := { π(g)(x) | g ∈ invertibleMatrices(F, N) }

def csLGCyclicSpan (F N W π x : Set) : Set := moduleSpan(W, complexRing, csLGTranslates(F, N, π, x))

-- Section: Characters of the torus, exponents and eigenvectors
-- normAbsChar x = q^(−ord x), and ‖x‖ for x ∈ F.
def csLGNormAbs (F ord x : Set) : Set :=
  ⋃({ r ∈ ℝ | ∃ a ∈ ℕ, ∃ b ∈ ℕ,
    ord(x) = integerAddValue(integerOfNat(a), integerNegValue(integerOfNat(b))) ∧
    r = R[realNat(pow(csLGResidueOrder(F, ord), b)) / realNat(pow(csLGResidueOrder(F, ord), a))] })

-- torusChar θ: t ↦ Π_i θ_i(t_i) |t_i|^(N−1−i), θ_i functions Fˣ → ℂ.
def csLGTorusCharTerms (F ord N θ t : Set) : Set :=
  { (i, ℂ[θ(i)(t(i)) * complexOfReal(realPow(csLGNormAbs(F, ord, t(i)), sub(sub(N, 1), i)))]) |
    i ∈ N }

def csLGTorusChar (F ord N θ : Set) : Set :=
  { (t, csLGProduct(N, csLGTorusCharTerms(F, ord, N, θ, t))) | t ∈ csLGTorus(F, N) }

-- U_t x = compactMean I₁ (π(diag t) x) (iwahoriHeckeHom).
def csLGUOp (F ord N W π t x : Set) : Set :=
  csLGCompactMean(F, ord, N, W, π, csLGProIwahori(F, ord, N), π(csLGDiagGL(F, N, t))(x))

-- IsExponent ρ ξ l: l(π(diag t) compactMean I₁ x) = ξ(t) l(x) for t
-- dominant.
predicate csLGIsExponent (F ord N W π ξ l : Set) :=
  LinearMap(l, W, complexRing, selfModule(complexRing)) ∧
  ∀ t ∈ csLGDominantTorus(F, ord, N), ∀ x ∈ Module.carrier(W),
    l(π(csLGDiagGL(F, N, t))(csLGCompactMean(F, ord, N, W, π, csLGProIwahori(F, ord, N), x))) =
      ℂ[ξ(t) * l(x)]

-- IsIwahoriEigen ρ ξ x: x ≠ 0 is fixed by I₁ and U_t x = ξ(t) x.
predicate csLGIsIwahoriEigen (F ord N W π ξ x : Set) :=
  x ≠ Module.zero(W) ∧
  x ∈ fixedSpace(csLGGL(F, N), csLGProIwahori(F, ord, N), W, π) ∧
  ∀ t ∈ csLGDominantTorus(F, ord, N), csLGUOp(F, ord, N, W, π, t, x) = Module.smul(W)(ξ(t), x)

-- Section: Hecke operators
-- The double coset KgK.
def csLGDoubleCoset (F N K g : Set) : Set :=
  { h ∈ invertibleMatrices(F, N) | ∃ k ∈ K, ∃ k2 ∈ K,
    h = matMul(F, N, N, N, matMul(F, N, N, N, k, g), k2) }

-- heckeCoset π K g: the Hecke operator of KgK.
def csLGHeckeCoset (F N W π K g x : Set) : Set :=
  heckeFun(csLGGL(F, N), K, complexRing, W, π, csLGIndicator(F, N, csLGDoubleCoset(F, N, K, g)), x)

-- basicDoubleCoset j: g and ϖg⁻¹ integral, ord det g = j.
def csLGBasicDoubleCoset (F ord N j : Set) : Set :=
  { g ∈ invertibleMatrices(F, N) | (∀ a ∈ N, ∀ b ∈ N, g(a, b) ∈ csLGInt(F, ord) ∧
      csLGOrdGe(F, ord, csLGInv(F, N, g)(a, b), integerNegValue(integerOfNat((1:N))))) ∧
    ord(matDet(F, N, g)) = integerOfNat(j) }

-- heckeGL π j: the j-th spherical Hecke operator.
def csLGHeckeGL (F ord N W π j x : Set) : Set :=
  heckeFun(csLGGL(F, N), csLGIntGL(F, ord, N), complexRing, W, π,
    csLGIndicator(F, N, csLGBasicDoubleCoset(F, ord, N, j)), x)

-- heckePoly q N t = Σ_{j ≤ N} (−1)^j q^(j(j−1)/2) t_j X^(N−j) over ℂ;
-- q^(j(j−1)/2) = Π_{i<j} qⁱ.
def csLGPowTerms (q j : Set) : Set := { (i, csLGNat(pow(q, i))) | i ∈ j }

def csLGHalfPow (q j : Set) : Set := csLGProduct(j, csLGPowTerms(q, j))

def csLGHeckePolyTerms (q N t : Set) : Set :=
  { (j, polyMonomial(complexRing, ℂ[Ring.pow(complexRing, ℂ[-complexOne], j) *
      csLGHalfPow(q, j) * t(j)], sub(N, j))) | j ∈ succ(N) }

def csLGHeckePoly (q N t : Set) : Set :=
  groupFiniteSum(Ring.additive(polynomialRing(complexRing, {0})), succ(N),
    csLGHeckePolyTerms(q, N, t))

-- Section: Laws of the stand-ins
-- compactMean is well defined for smooth representations: some
-- congruence subgroup inside an open compact H fixes x, and all of them
-- give the same average; the mean is fixed by H.
theorem csLGCompactMean.spec (F ord N W π H x : Set)
  requires local : csLGLocalField(F, ord)
  requires natural : N ∈ ℕ
  requires smooth : csLGSmoothRep(F, ord, N, W, π)
  requires open : ∃ m ∈ ℕ, (0:N) < (m:N) ∧ csLGCongruenceGL(F, ord, N, m) ⊆ H
  requires subgroup : Subgroup(H, csLGGL(F, N))
  requires compact : H ⊆ csLGIntGL(F, ord, N)
  requires hx : x ∈ Module.carrier(W)
  shows (∃ m ∈ ℕ, (0:N) < (m:N) ∧ csLGCongruenceGL(F, ord, N, m) ⊆ H ∧
      x ∈ fixedSpace(csLGGL(F, N), csLGCongruenceGL(F, ord, N, m), W, π) ∧
      csLGCompactMean(F, ord, N, W, π, H, x) =
        csLGMeanAt(F, ord, N, W, π, H, csLGCongruenceGL(F, ord, N, m), x)) ∧
    csLGCompactMean(F, ord, N, W, π, H, x) ∈ fixedSpace(csLGGL(F, N), H, W, π)
proof
  sorry

-- The pro-p Iwahori and block parahoric subgroups are compact open
-- subgroups of GL_N(F).
theorem csLGProIwahori.compact_open (F ord N : Set)
  requires local : csLGLocalField(F, ord)
  requires natural : N ∈ ℕ
  shows Subgroup(csLGProIwahori(F, ord, N), csLGGL(F, N)) ∧
    csLGCongruenceGL(F, ord, N, (1:N)) ⊆ csLGProIwahori(F, ord, N)
proof
  sorry

theorem csLGBlockParahoric.compact_open (F ord N c : Set)
  requires local : csLGLocalField(F, ord)
  requires natural : N ∈ ℕ
  requires hc : (c : ℕ → ℕ)
  shows Subgroup(csLGBlockParahoric(F, ord, N, c), csLGGL(F, N)) ∧
    csLGCongruenceGL(F, ord, N, (1:N)) ⊆ csLGBlockParahoric(F, ord, N, c)
proof
  sorry

end PadicGL
