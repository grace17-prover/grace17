-- The p-adic places of ℂ: ring homomorphisms ι : ℂ → ℂ_p, for ℂ_p the
-- completion of an algebraic closure Ω of ℚ_p; the absolute value
-- z ↦ ‖ι(z)‖ they induce, the valuation ring O_ι = {‖ι(z)‖ ≤ 1} and the
-- place ι ∘ conj.
-- Source: grh-compact/src/Lib/General/Algebra/AdicRingHomExt.lean
-- (PadicPlace, ιₚ), with Lib/Adelic/CuspForms/ClassReps.lean (embValRing)
-- and Mathlib's ℂ_[p] (PadicComplex), valRingCp.
-- Encoding. The source's place is an instance PadicPlace p holding
-- ιₚ : ℂ →+* ℂ_[p], for the one ℂ_[p] Mathlib builds from its algebraic
-- closure of ℚ_p by choice. Here ℂ_p is cpField(p, Ω) for an algebraic
-- closure Ω given as a parameter (GRH.Padic.Cp), so a place is the pair
-- ι = (Ω, ι₀) of the closure and the homomorphism ι₀ : ℂ → cpField(p, Ω).
-- So that the places form a set (the gauges of GRH.Adelic.CuspForms are
-- functions of the place), Ω and ι₀ are taken in the stage V(ω·2) of the
-- test rings (GRH.Category.Basic, testStage), where Lean's ℂ_[p] lives as
-- a `Type 0`; every algebraic closure of ℚ_p and every homomorphism into
-- its ℂ_p has a copy there (padicPlaces.of_closure), so the statements
-- that quantify over the places mean what they mean for all of them.
-- Part of the GRH blueprint (layer 4, Lib/General/Algebra, stage S1).
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.General.PadicPlace
import GRH.Padic.Cp
import GRH.Category.Basic

section PadicPlace
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- Section: Places
-- AdicRingHomExt.lean, PadicPlace p: the pairs ι = (Ω, ι₀) of an algebraic
-- closure Ω of ℚ_p and a ring homomorphism ι₀ : ℂ → ℂ_p = cpField(p, Ω),
-- both in the stage of the test rings.
def padicPlaces (p : Set) : Set :=
  { ι ∈ testStage × testStage | PadicAlgebraicClosure(p, fst(ι)) ∧
    RingHom(snd(ι), complexRing, cpField(p, fst(ι))) }

-- The parts of a place ι = (Ω, ι₀): the closure Ω, ℂ_p with its norm and
-- its integers O_C (the source's ℂ_[p], ‖·‖ and valRingCp p), and the
-- homomorphism ιₚ = ι₀.
def placeClosure (ι : Set) : Set := fst(ι)
def placeHom (ι : Set) : Set := snd(ι)
def placeCp (p ι : Set) : Set := cpField(p, placeClosure(ι))
def placeCpNorm (p ι : Set) : Set := cpNorm(p, placeClosure(ι))
def placeCpIntegers (p ι : Set) : Set := cpIntegers(p, placeClosure(ι))

-- ‖ιₚ(z)‖, the norm of ℂ_p at the image of z.
def padicPlaceNorm (p ι z : Set) : Set := placeCpNorm(p, ι)(placeHom(ι)(z))

-- ClassReps.lean, embValRing: the valuation ring O_ι ⊂ ℂ of the complex
-- numbers z with ‖ιₚ(z)‖ ≤ 1.
def embValRing (p ι : Set) : Set :=
  { z ∈ complexCarrier | RealLe(padicPlaceNorm(p, ι, z), realOne) }

-- The place ιₚ ∘ conj (ιₚ.comp (starRingEnd ℂ) in the source).
def conjPlaceHom (ι : Set) : Set :=
  { (z, placeHom(ι)(complexConj(z))) | z ∈ complexCarrier }

def conjPlace (ι : Set) : Set := (placeClosure(ι), conjPlaceHom(ι))

-- Section: Facts
-- The parts of a place.
theorem padicPlaces.parts (p ι : Set)
  requires place : ι ∈ padicPlaces(p)
  shows PadicAlgebraicClosure(p, placeClosure(ι)) ∧
    RingHom(placeHom(ι), complexRing, placeCp(p, ι))
proof
  obtain ⟨pair, closure, hom⟩ := place
  unfold placeCp
  unfold placeClosure
  unfold placeHom
  exact ⟨closure, hom⟩

-- Every p-adic place of ℂ, for any algebraic closure Ω of ℚ_p, induces the
-- absolute value of a place in padicPlaces(p): transport Ω and ℂ_p into
-- the stage of the test rings (testRings.essentially_of_continuum) and
-- compose with the isometry of the completions (cpField.independent).
theorem padicPlaces.of_closure (p Ω h : Set)
  requires closure : PadicAlgebraicClosure(p, Ω)
  requires hom : RingHom(h, complexRing, cpField(p, Ω))
  shows ∃ ι ∈ padicPlaces(p), ∀ z ∈ complexCarrier,
    padicPlaceNorm(p, ι, z) = cpNorm(p, Ω)(h(z))
proof
  sorry

-- p-adic places exist (ℂ and ℂ_p are algebraically closed of
-- characteristic 0 and of the same transcendence degree; the source's
-- instance PadicPlace p is chosen this way).
theorem padicPlaces.nonempty (p : Nat)
  requires prime : Prime(p)
  shows ∃ ι, ι ∈ padicPlaces(p)
proof
  sorry

-- ιₚ ∘ conj is a p-adic place.
theorem conjPlace.place (p ι : Set)
  requires place : ι ∈ padicPlaces(p)
  shows conjPlace(ι) ∈ padicPlaces(p)
proof
  sorry

end PadicPlace
