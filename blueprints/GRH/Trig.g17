-- Sine and cosine. The complex sine and cosine from the exponential, their
-- restrictions to the real line, π as twice the least positive zero of
-- the real cosine, sin² + cos² = 1, the addition formulas, periodicity
-- with period 2π, Euler's formula e^(iθ) = cos θ + i sin θ, and
-- |e^(iθ)| = 1 for real θ.
-- Part of the GRH blueprint.
-- Planned home: Complex/Trig.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Trig
import GRH.Exp
import Grace.Cumulus.Real.Integer
import Grace.Cumulus.Real.Analysis.Taylor
import Grace.Cumulus.Real.Analysis.IntermediateValue

section Trigonometry
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- Section: Definitions
-- sin z = (e^(iz) − e^(−iz)) / (2i) and cos z = (e^(iz) + e^(−iz)) / 2.
defgraph complexSin (z ∈ complexCarrier) : complexCarrier :=
    complexDiv(ℂ[complexExp(complexImaginaryUnit * z) -
      complexExp(-(complexImaginaryUnit * z))], ℂ[2 * complexImaginaryUnit])
proof
  have inverse : complexInv(ℂ[2 * complexImaginaryUnit]) ∈ ℂ :=
    complexInv.member with *
  unfold complexDiv
  typecheck

defgraph complexCos (z ∈ complexCarrier) : complexCarrier :=
    complexDiv(ℂ[complexExp(complexImaginaryUnit * z) +
      complexExp(-(complexImaginaryUnit * z))], ℂ[2])
proof
  have inverse : complexInv(ℂ[2]) ∈ ℂ := complexInv.member with *
  unfold complexDiv
  typecheck

-- The real sine and cosine are the real parts of the complex ones at real
-- arguments; the complex values there are real (realSin.of_real).
defgraph realSin (X ∈ ℝ) : ℝ := complexRe(complexSin(complexOfReal(X)))
proof
  have value : complexSin(complexOfReal(X)) ∈ ℂ by typecheck
  exact complexRe.real with value

defgraph realCos (X ∈ ℝ) : ℝ := complexRe(complexCos(complexOfReal(X)))
proof
  have value : complexCos(complexOfReal(X)) ∈ ℂ by typecheck
  exact complexRe.real with value

-- π/2 is the least positive zero of the real cosine.
predicate LeastPositiveZero (f H : Set) :=
  H ∈ ℝ ∧ realZero < H ∧ f(H) = realZero ∧
  (∀ X ∈ ℝ, realZero < X → f(X) = realZero → H ≤ X)

defunique leastPositiveZero (f : Set) (H ∈ ℝ) := LeastPositiveZero(f, H)
requires exists : ∃ H ∈ ℝ, LeastPositiveZero(f, H)
proof
  exact exists
uniqueness
  intros H hH first K hK second
  obtain ⟨hReal, hPositive, hZero, hLeast⟩ := first
  obtain ⟨kReal, kPositive, kZero, kLeast⟩ := second
  have hk := hLeast with kReal, kPositive, kZero
  have kh := kLeast with hReal, hPositive, hZero
  exact realLe.antisymmetric with hk, kh

-- Section: Exponential forms
-- With c = 1/2, A = e^(iz) and B = e^(−iz): sin z = −ic(A − B) and
-- cos z = c(A + B), where 2c = 1 and AB = 1.
theorem complexHalf.twice
  shows ℂ[2 * complexInv(ℂ[2])] = ℂ[1]
proof
  have nonzero := complexNumeral.nonzero at 2 with *
  exact complexInv.mul_cancel with *

theorem complexInv.unique (x d : Set)
  requires hx : x ∈ ℂ
  requires hd : d ∈ ℂ
  requires inverse : ℂ[x * d] = ℂ[1]
  shows complexInv(x) = d
proof
  have nonzero : x ≠ ℂ[0]
    intro zero
    rw zero at inverse
    have product : ℂ[0 * d] = ℂ[0] by ring
    have bad : ℂ[0] = ℂ[1] by cc
    obtain ⟨_, _, distinct⟩ := complexes.nontrivial
    exact distinct with bad
  have cancel := complexInv.mul_cancel with hx, nonzero
  have invMember := complexInv.member with hx
  linear_combination d * cancel - complexInv(x) * inverse

theorem complexImaginaryUnit.double_inv
  shows complexInv(ℂ[2 * complexImaginaryUnit]) =
    ℂ[-(complexImaginaryUnit * complexInv(ℂ[2]))]
proof
  have iMember := complexImaginaryUnit.member
  have square := complexImaginaryUnit.square
  have half := complexHalf.twice
  have halfMember : complexInv(ℂ[2]) ∈ ℂ := complexInv.member with *
  have product : ℂ[ℂ[2 * complexImaginaryUnit] *
      ℂ[-(complexImaginaryUnit * complexInv(ℂ[2]))]] = ℂ[1]
    linear_combination (-2 * complexInv(ℂ[2])) * square + half
  exact complexInv.unique with *

theorem complexSin.formula (z : Set)
  requires hz : z ∈ ℂ
  shows complexSin(z) = ℂ[-(complexImaginaryUnit * complexInv(ℂ[2])) *
    (complexExp(complexImaginaryUnit * z) -
      complexExp(-(complexImaginaryUnit * z)))]
proof
  have value := complexSin.value with hz
  have inverse := complexImaginaryUnit.double_inv
  have iMember := complexImaginaryUnit.member
  have halfMember : complexInv(ℂ[2]) ∈ ℂ := complexInv.member with *
  have first : complexExp(ℂ[complexImaginaryUnit * z]) ∈ ℂ by typecheck
  have second : complexExp(ℂ[-(complexImaginaryUnit * z)]) ∈ ℂ by typecheck
  rw value
  unfold complexDiv
  rw inverse
  ring

theorem complexCos.formula (z : Set)
  requires hz : z ∈ ℂ
  shows complexCos(z) = ℂ[complexInv(ℂ[2]) *
    (complexExp(complexImaginaryUnit * z) +
      complexExp(-(complexImaginaryUnit * z)))]
proof
  have value := complexCos.value with hz
  have iMember := complexImaginaryUnit.member
  have halfMember : complexInv(ℂ[2]) ∈ ℂ := complexInv.member with *
  have first : complexExp(ℂ[complexImaginaryUnit * z]) ∈ ℂ by typecheck
  have second : complexExp(ℂ[-(complexImaginaryUnit * z)]) ∈ ℂ by typecheck
  rw value
  unfold complexDiv
  ring

-- Section: Conjugates
theorem complexConj.pair (a b : Real)
  shows complexConj((a, b)) = (a, R[-b])
proof
  have member := complexCarrier.pair at a, b with *
  have value := complexConj.value with member
  rw [value, fst.pair, snd.pair]

theorem complexConj.neg (z : Set)
  requires hz : z ∈ ℂ
  shows complexConj(ℂ[-z]) = ℂ[-complexConj(z)]
proof
  obtain ⟨a, aReal, b, bReal, shape⟩ := complexCarrier.cases with hz
  rw shape
  have negative := complexConj.pair at R[-a], R[-b]
  have conjugate := complexConj.pair at a, b
  have twice : R[-(-b)] = R[-(-b)] by rfl
  rw [complexNeg.pair, negative, conjugate, complexNeg.pair]

theorem complexConj.imaginary
  shows complexConj(complexImaginaryUnit) = ℂ[-complexImaginaryUnit]
proof
  have conjugate := complexConj.pair at R[0], R[1]
  have negative := complexNeg.pair at R[0], R[1]
  have zero : R[-0] = R[0] by ring
  unfold complexImaginaryUnit
  rw [conjugate, negative, zero]

theorem complexConj.one
  shows complexConj(ℂ[1]) = ℂ[1]
proof
  have conjugate := complexConj.pair at R[1], R[0]
  have zero : R[-0] = R[0] by ring
  unfold complexOne
  rw [conjugate, zero]

theorem complexConj.half
  shows complexConj(complexInv(ℂ[2])) = complexInv(ℂ[2])
proof
  have halfMember : complexInv(ℂ[2]) ∈ ℂ := complexInv.member with *
  have oneMember : ℂ[1] ∈ ℂ by typecheck
  have two : ℂ[2] = ℂ[1 + 1] by ring
  have twoConj : complexConj(ℂ[2]) = ℂ[2]
    have sum := complexConj.add at ℂ[1], ℂ[1] with oneMember, oneMember
    rw two
    rw [sum, complexConj.one]
  have half := complexHalf.twice
  have product := complexConj.mul at ℂ[2], complexInv(ℂ[2]) with *
  rw [half, complexConj.one, twoConj] at product
  have conjMember : complexConj(complexInv(ℂ[2])) ∈ ℂ by typecheck
  have twoMember : ℂ[2] ∈ ℂ by typecheck
  symm at product
  have unique := complexInv.unique with twoMember, conjMember, product
  symm at unique
  exact unique

-- A complex number equal to its conjugate is real.
theorem complex.real_of_conj (w : Set)
  requires hw : w ∈ ℂ
  requires fixed : complexConj(w) = w
  shows w = complexOfReal(complexRe(w))
proof
  obtain ⟨a, aReal, b, bReal, shape⟩ := complexCarrier.cases with hw
  rw shape at fixed
  rw shape
  have conjugate := complexConj.pair at a, b
  rw conjugate at fixed
  have coordinates := orderedPair.injective with fixed
  have imaginary := coordinates.right
  have zero : b = R[0] by linarith
  have aMember : a ∈ ℝ by typecheck
  unfold complexRe
  rw [fst.pair, complexOfReal.value at a with aMember, zero]

-- At a real argument w, the conjugate of e^(iw) is e^(−iw), and the sine
-- and cosine there are their own conjugates.
theorem complexExp.conj_i_real (X : Real)
  shows complexConj(complexExp(ℂ[complexImaginaryUnit * complexOfReal(X)])) =
    complexExp(ℂ[-(complexImaginaryUnit * complexOfReal(X))])
proof
  have wMember : complexOfReal(X) ∈ ℂ by typecheck
  have iMember := complexImaginaryUnit.member
  have product := complexConj.mul at complexImaginaryUnit, complexOfReal(X)
    with iMember, wMember
  rw [complexConj.imaginary, complexConj.of_real at X] at product
  have argument : ℂ[-complexImaginaryUnit * complexOfReal(X)] =
    ℂ[-(complexImaginaryUnit * complexOfReal(X))] by ring
  have productMember : ℂ[complexImaginaryUnit * complexOfReal(X)] ∈ ℂ
    by typecheck
  have exponential := complexExp.conj with productMember
  rw [← exponential, product, argument]

theorem complexExp.conj_neg_i_real (X : Real)
  shows complexConj(complexExp(ℂ[-(complexImaginaryUnit * complexOfReal(X))]))
    = complexExp(ℂ[complexImaginaryUnit * complexOfReal(X)])
proof
  have wMember : complexOfReal(X) ∈ ℂ by typecheck
  have iMember := complexImaginaryUnit.member
  have productMember : ℂ[complexImaginaryUnit * complexOfReal(X)] ∈ ℂ
    by typecheck
  have negMember : ℂ[-(complexImaginaryUnit * complexOfReal(X))] ∈ ℂ
    by typecheck
  have product := complexConj.mul at complexImaginaryUnit, complexOfReal(X)
    with iMember, wMember
  rw [complexConj.imaginary, complexConj.of_real at X] at product
  have negative := complexConj.neg with productMember
  rw product at negative
  have argument : ℂ[-(-complexImaginaryUnit * complexOfReal(X))] =
    ℂ[complexImaginaryUnit * complexOfReal(X)] by ring
  have exponential := complexExp.conj with negMember
  rw [← exponential, negative, argument]

theorem complexSin.conj_real (X : Real)
  shows complexConj(complexSin(complexOfReal(X))) =
    complexSin(complexOfReal(X))
proof
  have wMember : complexOfReal(X) ∈ ℂ by typecheck
  have iMember := complexImaginaryUnit.member
  have halfMember : complexInv(ℂ[2]) ∈ ℂ := complexInv.member with *
  have first : complexExp(ℂ[complexImaginaryUnit * complexOfReal(X)]) ∈ ℂ
    by typecheck
  have second : complexExp(ℂ[-(complexImaginaryUnit * complexOfReal(X))]) ∈ ℂ
    by typecheck
  have formula := complexSin.formula with wMember
  have coefficient : ℂ[-(complexImaginaryUnit * complexInv(ℂ[2]))] ∈ ℂ
    by typecheck
  have scaled : ℂ[complexImaginaryUnit * complexInv(ℂ[2])] ∈ ℂ by typecheck
  have difference : ℂ[complexExp(complexImaginaryUnit * complexOfReal(X)) -
    complexExp(-(complexImaginaryUnit * complexOfReal(X)))] ∈ ℂ by typecheck
  have negSecond : ℂ[-complexExp(-(complexImaginaryUnit *
    complexOfReal(X)))] ∈ ℂ by typecheck
  have outer := complexConj.mul with coefficient, difference
  have negCoefficient := complexConj.neg with scaled
  have inner := complexConj.mul with iMember, halfMember
  have sum := complexConj.add with first, negSecond
  have negDifference := complexConj.neg with second
  rw formula
  rw [outer, negCoefficient, inner, sum, negDifference, complexConj.imaginary,
    complexConj.half, complexExp.conj_i_real, complexExp.conj_neg_i_real]
  ring

theorem complexCos.conj_real (X : Real)
  shows complexConj(complexCos(complexOfReal(X))) =
    complexCos(complexOfReal(X))
proof
  have wMember : complexOfReal(X) ∈ ℂ by typecheck
  have halfMember : complexInv(ℂ[2]) ∈ ℂ := complexInv.member with *
  have first : complexExp(ℂ[complexImaginaryUnit * complexOfReal(X)]) ∈ ℂ
    by typecheck
  have second : complexExp(ℂ[-(complexImaginaryUnit * complexOfReal(X))]) ∈ ℂ
    by typecheck
  have formula := complexCos.formula with wMember
  have total : ℂ[complexExp(complexImaginaryUnit * complexOfReal(X)) +
    complexExp(-(complexImaginaryUnit * complexOfReal(X)))] ∈ ℂ by typecheck
  have outer := complexConj.mul with halfMember, total
  have sum := complexConj.add with first, second
  rw formula
  rw [outer, sum, complexConj.half, complexExp.conj_i_real,
    complexExp.conj_neg_i_real]
  ring

-- Section: Basic values and identities
theorem complexSin.member (z : Set)
  requires hz : z ∈ ℂ
  shows complexSin(z) ∈ ℂ
proof
  typecheck

theorem complexCos.member (z : Set)
  requires hz : z ∈ ℂ
  shows complexCos(z) ∈ ℂ
proof
  typecheck

theorem realSin.real (X : Real)
  shows realSin(X) ∈ ℝ
proof
  typecheck

theorem realCos.real (X : Real)
  shows realCos(X) ∈ ℝ
proof
  typecheck

theorem realSin.of_real (X : Real)
  shows complexSin(complexOfReal(X)) = complexOfReal(realSin(X))
proof
  have xMember : X ∈ ℝ by typecheck
  have member : complexSin(complexOfReal(X)) ∈ ℂ by typecheck
  have fixed := complexSin.conj_real at X
  have real := complex.real_of_conj with member, fixed
  rw realSin.value with xMember
  exact real

theorem realCos.of_real (X : Real)
  shows complexCos(complexOfReal(X)) = complexOfReal(realCos(X))
proof
  have xMember : X ∈ ℝ by typecheck
  have member : complexCos(complexOfReal(X)) ∈ ℂ by typecheck
  have fixed := complexCos.conj_real at X
  have real := complex.real_of_conj with member, fixed
  rw realCos.value with xMember
  exact real

-- e^(iz) = cos z + i sin z.
theorem complexExp.i_mul (z : Set)
  requires hz : z ∈ ℂ
  shows complexExp(ℂ[complexImaginaryUnit * z]) =
    ℂ[complexCos(z) + complexImaginaryUnit * complexSin(z)]
proof
  have iMember := complexImaginaryUnit.member
  have square := complexImaginaryUnit.square
  have half := complexHalf.twice
  have halfMember : complexInv(ℂ[2]) ∈ ℂ := complexInv.member with *
  have first : complexExp(ℂ[complexImaginaryUnit * z]) ∈ ℂ by typecheck
  have second : complexExp(ℂ[-(complexImaginaryUnit * z)]) ∈ ℂ by typecheck
  rw [complexCos.formula with hz, complexSin.formula with hz]
  linear_combination (-complexExp(ℂ[complexImaginaryUnit * z])) * half +
    (complexInv(ℂ[2]) * (complexExp(ℂ[complexImaginaryUnit * z]) -
      complexExp(ℂ[-(complexImaginaryUnit * z)]))) * square

-- Euler's formula: e^(iθ) = cos θ + i sin θ, the point (cos θ, sin θ).
theorem complexExp.euler (θ : Real)
  shows complexExp(ℂ[complexImaginaryUnit * complexOfReal(θ)]) =
    (realCos(θ), realSin(θ))
proof
  have wMember : complexOfReal(θ) ∈ ℂ by typecheck
  have cosMember : realCos(θ) ∈ ℝ by typecheck
  have sinMember : realSin(θ) ∈ ℝ by typecheck
  have step := complexExp.i_mul with wMember
  rw [realCos.of_real, realSin.of_real] at step
  rw [step, complexOfReal.value at realCos(θ) with cosMember,
    complexOfReal.value at realSin(θ) with sinMember]
  unfold complexImaginaryUnit
  rw [complexMul.pair, complexAdd.pair]
  have first : R[realCos(θ) + (0 * realSin(θ) + -(1 * 0))] = realCos(θ)
    by ring
  have second : R[0 + (0 * 0 + 1 * realSin(θ))] = realSin(θ) by ring
  rw [first, second]

theorem complexExp.i_mul_re (θ : Real)
  shows complexRe(complexExp(ℂ[complexImaginaryUnit * complexOfReal(θ)])) =
    realCos(θ)
proof
  rw complexExp.euler
  unfold complexRe
  rw fst.pair

theorem complexExp.i_mul_im (θ : Real)
  shows complexIm(complexExp(ℂ[complexImaginaryUnit * complexOfReal(θ)])) =
    realSin(θ)
proof
  rw complexExp.euler
  unfold complexIm
  rw snd.pair

-- |e^(iθ)| = 1 for real θ.
theorem complexExp.abs_i_mul (θ : Real)
  shows complexAbs(complexExp(ℂ[complexImaginaryUnit * complexOfReal(θ)])) =
    R[1]
proof
  have productMember : ℂ[complexImaginaryUnit * complexOfReal(θ)] ∈ ℂ
    by typecheck
  have member : complexExp(ℂ[complexImaginaryUnit * complexOfReal(θ)]) ∈ ℂ
    by typecheck
  have self := complexConj.mul_self with member
  rw complexExp.conj_i_real at self
  have inverse := complexExp.neg with productMember
  have one : ℂ[complexExp(complexImaginaryUnit * complexOfReal(θ)) *
      complexExp(-(complexImaginaryUnit * complexOfReal(θ)))] = ℂ[1]
    rw ← inverse
    ring
  rw [one, ← complexOfReal.one] at self
  have normReal : Real(complexNormSquared(
    complexExp(ℂ[complexImaginaryUnit * complexOfReal(θ)]))) :=
    complexNormSquared.real with member
  have normOne := complexOfReal.injective with self
  have square := complexAbs.square with member
  have nonnegative := complexAbs.nonnegative with member
  have absReal : complexAbs(complexExp(ℂ[complexImaginaryUnit *
    complexOfReal(θ)])) ∈ ℝ by typecheck
  have squares : R[complexAbs(complexExp(ℂ[complexImaginaryUnit *
      complexOfReal(θ)])) * complexAbs(complexExp(ℂ[complexImaginaryUnit *
      complexOfReal(θ)]))] = R[1 * 1]
    rw [square, ← normOne]
    ring
  have oneNonnegative : R[0] ≤ R[1] by linarith
  exact realMulValue.eq_of_square_eq with nonnegative, oneNonnegative, squares

-- e^(x + iy) = e^x (cos y + i sin y).
theorem complexExp.polar (z : Set)
  requires hz : z ∈ ℂ
  shows complexExp(z) = (R[realExp(complexRe(z)) * realCos(complexIm(z))],
    R[realExp(complexRe(z)) * realSin(complexIm(z))])
proof
  obtain ⟨a, aReal, b, bReal, shape⟩ := complexCarrier.cases with hz
  have aMember : a ∈ ℝ by typecheck
  have bMember : b ∈ ℝ by typecheck
  have reValue : complexRe((a, b)) = a
    unfold complexRe
    rw fst.pair
  have imValue : complexIm((a, b)) = b
    unfold complexIm
    rw snd.pair
  have iMember := complexImaginaryUnit.member
  have aComplex : complexOfReal(a) ∈ ℂ by typecheck
  have bScaled : ℂ[complexImaginaryUnit * complexOfReal(b)] ∈ ℂ by typecheck
  have pairForm : (a, b) =
      ℂ[complexOfReal(a) + complexImaginaryUnit * complexOfReal(b)]
    rw [complexOfReal.value at a with aMember,
      complexOfReal.value at b with bMember]
    unfold complexImaginaryUnit
    rw [complexMul.pair, complexAdd.pair]
    have first : R[a + (0 * b + -(1 * 0))] = a by ring
    have second : R[0 + (0 * 0 + 1 * b)] = b by ring
    rw [first, second]
  have sum := complexExp.add with aComplex, bScaled
  rw ← pairForm at sum
  have expReal : realExp(a) ∈ ℝ by typecheck
  have cosMember : realCos(b) ∈ ℝ by typecheck
  have sinMember : realSin(b) ∈ ℝ by typecheck
  rw [shape, reValue, imValue, sum, complexExp.of_real, complexExp.euler,
    complexOfReal.value at realExp(a) with expReal, complexMul.pair]
  have first : R[realExp(a) * realCos(b) + -(0 * realSin(b))] =
    R[realExp(a) * realCos(b)] by ring
  have second : R[realExp(a) * realSin(b) + 0 * realCos(b)] =
    R[realExp(a) * realSin(b)] by ring
  rw [first, second]

theorem complexSin.square_add_cos_square (z : Set)
  requires hz : z ∈ ℂ
  shows ℂ[complexSin(z) * complexSin(z) + complexCos(z) * complexCos(z)] =
    ℂ[1]
proof
  have iMember := complexImaginaryUnit.member
  have square := complexImaginaryUnit.square
  have half := complexHalf.twice
  have halfMember : complexInv(ℂ[2]) ∈ ℂ := complexInv.member with *
  have productMember : ℂ[complexImaginaryUnit * z] ∈ ℂ by typecheck
  have first : complexExp(ℂ[complexImaginaryUnit * z]) ∈ ℂ by typecheck
  have second : complexExp(ℂ[-(complexImaginaryUnit * z)]) ∈ ℂ by typecheck
  have inverse := complexExp.neg with productMember
  rw [complexCos.formula with hz, complexSin.formula with hz]
  linear_combination (complexInv(ℂ[2]) * complexInv(ℂ[2]) *
      (complexExp(ℂ[complexImaginaryUnit * z]) -
        complexExp(ℂ[-(complexImaginaryUnit * z)])) *
      (complexExp(ℂ[complexImaginaryUnit * z]) -
        complexExp(ℂ[-(complexImaginaryUnit * z)]))) * square +
    (4 * complexInv(ℂ[2]) * complexInv(ℂ[2])) * inverse +
    (2 * complexInv(ℂ[2]) + 1) * half

theorem realSin.square_add_cos_square (X : Real)
  shows R[realSin(X) * realSin(X) + realCos(X) * realCos(X)] = R[1]
proof
  have wMember : complexOfReal(X) ∈ ℂ by typecheck
  have identity := complexSin.square_add_cos_square with wMember
  rw [realSin.of_real, realCos.of_real, ← complexOfReal.mul,
    ← complexOfReal.mul, ← complexOfReal.add, ← complexOfReal.one] at identity
  exact complexOfReal.injective with identity

-- |t| ≤ 1 whenever t² ≤ 1.
theorem realAbs.le_one_of_square (T : Real)
  requires square : R[T * T] ≤ R[1]
  shows abs(T) ≤ R[1]
proof
  have nonnegative := abs.nonnegative at T
  have squareNonnegative := realMulValue.square_nonnegative at T
  have absSquare : R[abs(T) * abs(T)] = R[T * T]
    rw ← abs.mul
    exact abs.of_nonnegative with squareNonnegative
  have oneNonnegative : R[0] ≤ R[1] by linarith
  have squares : R[abs(T) * abs(T)] ≤ R[1 * 1]
    have one : R[1 * 1] = R[1] by ring
    rw [absSquare, one]
    exact square
  exact realMulValue.le_of_square_le with nonnegative, oneNonnegative, squares

theorem realSin.abs_le_one (X : Real)
  shows abs(realSin(X)) ≤ R[1]
proof
  have identity := realSin.square_add_cos_square at X
  have cosSquare := realMulValue.square_nonnegative at realCos(X)
  have square : R[realSin(X) * realSin(X)] ≤ R[1] by linarith
  exact realAbs.le_one_of_square with square

theorem realCos.abs_le_one (X : Real)
  shows abs(realCos(X)) ≤ R[1]
proof
  have identity := realSin.square_add_cos_square at X
  have sinSquare := realMulValue.square_nonnegative at realSin(X)
  have square : R[realCos(X) * realCos(X)] ≤ R[1] by linarith
  exact realAbs.le_one_of_square with square

theorem complexSin.zero
  shows complexSin(ℂ[0]) = ℂ[0]
proof
  have iMember := complexImaginaryUnit.member
  have halfMember : complexInv(ℂ[2]) ∈ ℂ := complexInv.member with *
  have zeroMember : ℂ[0] ∈ ℂ by typecheck
  have product : ℂ[complexImaginaryUnit * 0] = ℂ[0] by ring
  have negative : ℂ[-0] = ℂ[0] by ring
  rw [complexSin.formula with zeroMember, product, negative, complexExp.zero]
  ring

theorem complexCos.zero
  shows complexCos(ℂ[0]) = ℂ[1]
proof
  have iMember := complexImaginaryUnit.member
  have halfMember : complexInv(ℂ[2]) ∈ ℂ := complexInv.member with *
  have zeroMember : ℂ[0] ∈ ℂ by typecheck
  have half := complexHalf.twice
  have product : ℂ[complexImaginaryUnit * 0] = ℂ[0] by ring
  have negative : ℂ[-0] = ℂ[0] by ring
  rw [complexCos.formula with zeroMember, product, negative, complexExp.zero]
  linear_combination half

theorem realSin.zero
  shows realSin(R[0]) = R[0]
proof
  have value := realSin.of_real at R[0]
  rw [complexOfReal.zero, complexSin.zero, ← complexOfReal.zero] at value
  have same := complexOfReal.injective with value
  symm at same
  exact same

theorem realCos.zero
  shows realCos(R[0]) = R[1]
proof
  have value := realCos.of_real at R[0]
  rw [complexOfReal.zero, complexCos.zero, ← complexOfReal.one] at value
  have same := complexOfReal.injective with value
  symm at same
  exact same

theorem complexSin.neg (z : Set)
  requires hz : z ∈ ℂ
  shows complexSin(ℂ[-z]) = ℂ[-complexSin(z)]
proof
  have iMember := complexImaginaryUnit.member
  have halfMember : complexInv(ℂ[2]) ∈ ℂ := complexInv.member with *
  have negMember : ℂ[-z] ∈ ℂ by typecheck
  have first : complexExp(ℂ[complexImaginaryUnit * z]) ∈ ℂ by typecheck
  have second : complexExp(ℂ[-(complexImaginaryUnit * z)]) ∈ ℂ by typecheck
  have inner : ℂ[complexImaginaryUnit * -z] = ℂ[-(complexImaginaryUnit * z)]
    by ring
  have outer : ℂ[-(complexImaginaryUnit * -z)] = ℂ[complexImaginaryUnit * z]
    by ring
  rw [complexSin.formula with negMember, complexSin.formula with hz, outer,
    inner]
  ring

theorem complexCos.neg (z : Set)
  requires hz : z ∈ ℂ
  shows complexCos(ℂ[-z]) = complexCos(z)
proof
  have iMember := complexImaginaryUnit.member
  have halfMember : complexInv(ℂ[2]) ∈ ℂ := complexInv.member with *
  have negMember : ℂ[-z] ∈ ℂ by typecheck
  have first : complexExp(ℂ[complexImaginaryUnit * z]) ∈ ℂ by typecheck
  have second : complexExp(ℂ[-(complexImaginaryUnit * z)]) ∈ ℂ by typecheck
  have inner : ℂ[complexImaginaryUnit * -z] = ℂ[-(complexImaginaryUnit * z)]
    by ring
  have outer : ℂ[-(complexImaginaryUnit * -z)] = ℂ[complexImaginaryUnit * z]
    by ring
  rw [complexCos.formula with negMember, complexCos.formula with hz, outer,
    inner]
  ring

theorem realSin.neg (X : Real)
  shows realSin(R[-X]) = R[-realSin(X)]
proof
  have wMember : complexOfReal(X) ∈ ℂ by typecheck
  have value := realSin.of_real at R[-X]
  rw [complexOfReal.neg, complexSin.neg with wMember, realSin.of_real,
    ← complexOfReal.neg] at value
  have same := complexOfReal.injective with value
  symm at same
  exact same

theorem realCos.neg (X : Real)
  shows realCos(R[-X]) = realCos(X)
proof
  have wMember : complexOfReal(X) ∈ ℂ by typecheck
  have value := realCos.of_real at R[-X]
  rw [complexOfReal.neg, complexCos.neg with wMember, realCos.of_real] at value
  have same := complexOfReal.injective with value
  symm at same
  exact same

theorem complexSin.add (z w : Set)
  requires hz : z ∈ ℂ
  requires hw : w ∈ ℂ
  shows complexSin(ℂ[z + w]) =
    ℂ[complexSin(z) * complexCos(w) + complexCos(z) * complexSin(w)]
proof
  have iMember := complexImaginaryUnit.member
  have half := complexHalf.twice
  have square := complexImaginaryUnit.square
  have halfMember : complexInv(ℂ[2]) ∈ ℂ := complexInv.member with *
  have sumMember : ℂ[z + w] ∈ ℂ by typecheck
  have izMember : ℂ[complexImaginaryUnit * z] ∈ ℂ by typecheck
  have iwMember : ℂ[complexImaginaryUnit * w] ∈ ℂ by typecheck
  have nizMember : ℂ[-(complexImaginaryUnit * z)] ∈ ℂ by typecheck
  have niwMember : ℂ[-(complexImaginaryUnit * w)] ∈ ℂ by typecheck
  have first : complexExp(ℂ[complexImaginaryUnit * z]) ∈ ℂ by typecheck
  have second : complexExp(ℂ[-(complexImaginaryUnit * z)]) ∈ ℂ by typecheck
  have third : complexExp(ℂ[complexImaginaryUnit * w]) ∈ ℂ by typecheck
  have fourth : complexExp(ℂ[-(complexImaginaryUnit * w)]) ∈ ℂ by typecheck
  have inner : ℂ[complexImaginaryUnit * (z + w)] =
    ℂ[complexImaginaryUnit * z + complexImaginaryUnit * w] by ring
  have outer : ℂ[-(complexImaginaryUnit * (z + w))] =
    ℂ[-(complexImaginaryUnit * z) + -(complexImaginaryUnit * w)] by ring
  have plus := complexExp.add with izMember, iwMember
  have minus := complexExp.add with nizMember, niwMember
  rw [complexSin.formula with sumMember, outer, inner, plus, minus,
    complexSin.formula with hz, complexSin.formula with hw,
    complexCos.formula with hz, complexCos.formula with hw]
  linear_combination (complexImaginaryUnit * complexInv(ℂ[2]) *
    (complexExp(ℂ[complexImaginaryUnit * z]) *
      complexExp(ℂ[complexImaginaryUnit * w]) -
      complexExp(ℂ[-(complexImaginaryUnit * z)]) *
      complexExp(ℂ[-(complexImaginaryUnit * w)]))) * half

theorem complexCos.add (z w : Set)
  requires hz : z ∈ ℂ
  requires hw : w ∈ ℂ
  shows complexCos(ℂ[z + w]) =
    ℂ[complexCos(z) * complexCos(w) - complexSin(z) * complexSin(w)]
proof
  have iMember := complexImaginaryUnit.member
  have half := complexHalf.twice
  have square := complexImaginaryUnit.square
  have halfMember : complexInv(ℂ[2]) ∈ ℂ := complexInv.member with *
  have sumMember : ℂ[z + w] ∈ ℂ by typecheck
  have izMember : ℂ[complexImaginaryUnit * z] ∈ ℂ by typecheck
  have iwMember : ℂ[complexImaginaryUnit * w] ∈ ℂ by typecheck
  have nizMember : ℂ[-(complexImaginaryUnit * z)] ∈ ℂ by typecheck
  have niwMember : ℂ[-(complexImaginaryUnit * w)] ∈ ℂ by typecheck
  have first : complexExp(ℂ[complexImaginaryUnit * z]) ∈ ℂ by typecheck
  have second : complexExp(ℂ[-(complexImaginaryUnit * z)]) ∈ ℂ by typecheck
  have third : complexExp(ℂ[complexImaginaryUnit * w]) ∈ ℂ by typecheck
  have fourth : complexExp(ℂ[-(complexImaginaryUnit * w)]) ∈ ℂ by typecheck
  have inner : ℂ[complexImaginaryUnit * (z + w)] =
    ℂ[complexImaginaryUnit * z + complexImaginaryUnit * w] by ring
  have outer : ℂ[-(complexImaginaryUnit * (z + w))] =
    ℂ[-(complexImaginaryUnit * z) + -(complexImaginaryUnit * w)] by ring
  have plus := complexExp.add with izMember, iwMember
  have minus := complexExp.add with nizMember, niwMember
  rw [complexCos.formula with sumMember, outer, inner, plus, minus,
    complexSin.formula with hz, complexSin.formula with hw,
    complexCos.formula with hz, complexCos.formula with hw]
  linear_combination (-complexInv(ℂ[2]) *
    (complexExp(ℂ[complexImaginaryUnit * z]) *
      complexExp(ℂ[complexImaginaryUnit * w]) +
      complexExp(ℂ[-(complexImaginaryUnit * z)]) *
      complexExp(ℂ[-(complexImaginaryUnit * w)]))) * half +
    (complexInv(ℂ[2]) * complexInv(ℂ[2]) *
      (complexExp(ℂ[complexImaginaryUnit * z]) -
        complexExp(ℂ[-(complexImaginaryUnit * z)])) *
      (complexExp(ℂ[complexImaginaryUnit * w]) -
        complexExp(ℂ[-(complexImaginaryUnit * w)]))) * square

theorem realSin.add (X Y : Real)
  shows realSin(R[X + Y]) =
    R[realSin(X) * realCos(Y) + realCos(X) * realSin(Y)]
proof
  have xMember : complexOfReal(X) ∈ ℂ by typecheck
  have yMember : complexOfReal(Y) ∈ ℂ by typecheck
  have value := realSin.of_real at R[X + Y]
  have sum := complexSin.add with xMember, yMember
  rw [complexOfReal.add, sum,
    realSin.of_real, realSin.of_real, realCos.of_real, realCos.of_real,
    ← complexOfReal.mul, ← complexOfReal.mul, ← complexOfReal.add] at value
  have same := complexOfReal.injective with value
  symm at same
  exact same

theorem realCos.add (X Y : Real)
  shows realCos(R[X + Y]) =
    R[realCos(X) * realCos(Y) - realSin(X) * realSin(Y)]
proof
  have xMember : complexOfReal(X) ∈ ℂ by typecheck
  have yMember : complexOfReal(Y) ∈ ℂ by typecheck
  have value := realCos.of_real at R[X + Y]
  have sum := complexCos.add with xMember, yMember
  rw [complexOfReal.add, sum,
    realSin.of_real, realSin.of_real, realCos.of_real, realCos.of_real,
    ← complexOfReal.mul, ← complexOfReal.mul, ← complexOfReal.neg,
    ← complexOfReal.add] at value
  have same := complexOfReal.injective with value
  symm at same
  exact same

-- Section: Calculus
-- A function whose increments are Dh up to Kh² near 0 has derivative D.
theorem HasDerivativeAt.of_quadratic_bound (f : Set) (D A K : Real)
  requires function : f : ℝ → ℝ
  requires positive : R[0] < K
  requires bound : ∀ H ∈ ℝ, H ≠ R[0] → abs(H) < R[1] →
    abs(R[f(R[A + H]) - f(A) - D * H]) ≤ R[K * (H * H)]
  shows HasDerivativeAt(f, D, A)
proof
  have quotient := differenceQuotient.function at f, A with function
  unfold HasDerivativeAt
  refine ⟨function, ?_⟩
  unfold TendsToAt
  refine ⟨quotient, ?_⟩
  intros e realE positiveE
  have sumPositive : R[0] < R[e + K] by linarith
  have sumNonzero : R[e + K] ≠ R[0] by linarith
  have radiusReal : R[e / (e + K)] ∈ ℝ by typecheck
  have cancel := realDiv.mul_right at e, R[e + K] with sumNonzero
  have radiusPositive : R[0] < R[e / (e + K)]
    by_contra notPositive
    have nonpositive : R[e / (e + K)] ≤ R[0] by linarith
    have sumNonnegative : R[0] ≤ R[e + K] by linarith
    have product := realLe.mul_right_of_nonnegative with nonpositive,
      sumNonnegative
    have zero : R[0 * (e + K)] = R[0] by ring
    linarith
  have expand : R[e / (e + K) * e + K * (e / (e + K))] = e by
    linear_combination cancel
  have crossPositive := realMulValue.positive with radiusPositive, positiveE
  have radiusSmall : R[K * (e / (e + K))] < e by linarith
  have radiusBelowOne : R[e / (e + K)] < R[1]
    by_contra notBelow
    have atLeast : R[1] ≤ R[e / (e + K)] by linarith
    have sumNonnegative : R[0] ≤ R[e + K] by linarith
    have product := realLe.mul_right_of_nonnegative with atLeast,
      sumNonnegative
    have one : R[1 * (e + K)] = R[e + K] by ring
    linarith
  witness R[e / (e + K)]
  refine ⟨radiusReal, radiusPositive, ?_⟩
  intros x realX nonzero near
  obtain ⟨above, below⟩ := openBall.order_characterization.forward with near
  have distance : abs(x) < R[e / (e + K)]
    have sign := realLess.trichotomy at x, R[0]
    cases sign with negative | rest
    . have nonpositive : x ≤ R[0] by linarith
      rw abs.of_nonpositive with nonpositive
      linarith
    . cases rest with zero | positiveX
      . exfalso
        exact nonzero with zero
      . have nonnegative : R[0] ≤ x by linarith
        rw abs.of_nonnegative with nonnegative
        linarith
  have absSmall : abs(x) < R[1] by linarith
  have estimate := bound with realX, nonzero, absSmall
  rw differenceQuotient.value at f, A, x with function
  have product := realDiv.mul_right at realSubValue(f(R[A + x]), f(A)), x
    with nonzero
  have relation : R[R[realSubValue(f(R[A + x]), f(A)) / x - D] * x] =
      R[f(R[A + x]) - f(A) - D * x] by
    linear_combination product
  have absProduct := abs.mul at R[realSubValue(f(R[A + x]), f(A)) / x - D], x
  rw relation at absProduct
  have absPositive := abs.positive_of_ne with nonzero
  have squareNonnegative := realMulValue.square_nonnegative at x
  have absSquare : R[x * x] = R[abs(x) * abs(x)]
    rw ← abs.mul
    have same := abs.of_nonnegative with squareNonnegative
    symm at same
    exact same
  have chain : R[abs(R[realSubValue(f(R[A + x]), f(A)) / x - D]) * abs(x)] ≤
      R[(K * abs(x)) * abs(x)]
    have regroup : R[(K * abs(x)) * abs(x)] = R[K * (x * x)]
      rw absSquare
      ring
    rw [regroup, ← absProduct]
    exact estimate
  have cancelled := realLe.mul_right_cancel_positive with absPositive, chain
  have scaled := realLess.mul_left_of_positive with distance, positive
  have close : abs(R[realSubValue(f(R[A + x]), f(A)) / x - D]) < e by linarith
  have upper := abs.upper at R[realSubValue(f(R[A + x]), f(A)) / x - D]
  have lower := abs.upper_neg at R[realSubValue(f(R[A + x]), f(A)) / x - D]
  have quotientReal : Real(realSubValue(f(R[A + x]), f(A)) / x) by typecheck
  have lowerBound : R[D - e] < realSubValue(f(R[A + x]), f(A)) / x by linarith
  have upperBound : realSubValue(f(R[A + x]), f(A)) / x < R[D + e] by linarith
  unfold realSubValue at lowerBound
  unfold realSubValue at upperBound
  apply openBall.order_characterization.backward
  unfold realSubValue
  exact ⟨lowerBound, upperBound⟩

theorem complexAbs.imaginary
  shows complexAbs(complexImaginaryUnit) = R[1]
proof
  have iMember := complexImaginaryUnit.member
  have square := complexAbs.square with iMember
  have norm := complexNormSquared.pair at R[0], R[1]
  have nonnegative := complexAbs.nonnegative with iMember
  have squares : R[complexAbs(complexImaginaryUnit) *
      complexAbs(complexImaginaryUnit)] = R[1 * 1]
    rw square
    unfold complexImaginaryUnit
    rw norm
    ring
  have oneNonnegative : R[0] ≤ R[1] by linarith
  exact realMulValue.eq_of_square_eq with nonnegative, oneNonnegative, squares

theorem trig.small_bounds (H : Real)
  requires small : abs(H) ≤ R[1]
  shows abs(R[realCos(H) - 1]) ≤ R[H * H] ∧ abs(R[realSin(H) - H]) ≤ R[H * H]
proof
  have iMember := complexImaginaryUnit.member
  have hMember : H ∈ ℝ by typecheck
  have wMember : complexOfReal(H) ∈ ℂ by typecheck
  have zMember : ℂ[complexImaginaryUnit * complexOfReal(H)] ∈ ℂ by typecheck
  have modulus : complexAbs(ℂ[complexImaginaryUnit * complexOfReal(H)]) =
      abs(H)
    have product := complexAbs.mul with iMember, wMember
    rw [product, complexAbs.imaginary, complexAbs.of_real]
    ring
  have smallZ : complexAbs(ℂ[complexImaginaryUnit * complexOfReal(H)]) ≤ R[1]
    rw modulus
    exact small
  have quadratic := complexExp.quadratic_bound with zMember, smallZ
  rw [modulus, complexExp.euler] at quadratic
  have cosReal : realCos(H) ∈ ℝ by typecheck
  have sinReal : realSin(H) ∈ ℝ by typecheck
  have difference : ℂ[(realCos(H), realSin(H)) - 1 -
      complexImaginaryUnit * complexOfReal(H)] =
      (R[realCos(H) - 1], R[realSin(H) - H])
    rw complexOfReal.value at H with hMember
    unfold complexImaginaryUnit
    unfold complexOne
    rw [complexMul.pair, complexNeg.pair, complexNeg.pair, complexAdd.pair,
      complexAdd.pair]
    have first : R[realCos(H) - 1 - (0 * H - 1 * 0)] = R[realCos(H) - 1]
      by ring
    have second : R[realSin(H) - 0 - (0 * 0 + 1 * H)] = R[realSin(H) - H]
      by ring
    rw [first, second]
  rw difference at quadratic
  have pairMember : (R[realCos(H) - 1], R[realSin(H) - H]) ∈ ℂ by typecheck
  have reBound := complexAbs.re_le with pairMember
  have imBound := complexAbs.im_le with pairMember
  unfold complexRe at reBound
  unfold complexIm at imBound
  rw fst.pair at reBound
  rw snd.pair at imBound
  have squareNonnegative := realMulValue.square_nonnegative at H
  have absSquare : R[abs(H) * abs(H)] = R[H * H]
    rw ← abs.mul
    exact abs.of_nonnegative with squareNonnegative
  rw absSquare at quadratic
  constructor
  . linarith
  . linarith

-- |ab| ≤ M when |a| ≤ 1 and |b| ≤ M.
theorem realAbs.mul_le (A B M : Real)
  requires first : abs(A) ≤ R[1]
  requires second : abs(B) ≤ M
  shows abs(R[A * B]) ≤ M
proof
  have nonnegative := abs.nonnegative at B
  have scaled := realLe.mul_right_of_nonnegative with first, nonnegative
  have one : R[1 * abs(B)] = abs(B) by ring
  rw abs.mul
  linarith

theorem realSin.derivative (X : Real)
  shows HasDerivativeAt(realSin, realCos(X), X)
proof
  have function := realSin.function
  have two : R[0] < R[2] by linarith
  have bound : ∀ H ∈ ℝ, H ≠ R[0] → abs(H) < R[1] →
      abs(R[realSin(R[X + H]) - realSin(X) - realCos(X) * H]) ≤
        R[2 * (H * H)]
    intros H realH nonzero small
    have smallLe : abs(H) ≤ R[1] by linarith
    obtain ⟨cosBound, sinBound⟩ := trig.small_bounds with smallLe
    have identity : R[realSin(R[X + H]) - realSin(X) - realCos(X) * H] =
        R[realSin(X) * (realCos(H) - 1) + realCos(X) * (realSin(H) - H)]
      rw realSin.add
      ring
    rw identity
    have triangle := abs.triangle at R[realSin(X) * (realCos(H) - 1)],
      R[realCos(X) * (realSin(H) - H)]
    have sinOne := realSin.abs_le_one at X
    have cosOne := realCos.abs_le_one at X
    have firstTerm := realAbs.mul_le with sinOne, cosBound
    have secondTerm := realAbs.mul_le with cosOne, sinBound
    linarith
  exact HasDerivativeAt.of_quadratic_bound with function, two, bound

theorem realCos.derivative (X : Real)
  shows HasDerivativeAt(realCos, R[-realSin(X)], X)
proof
  have function := realCos.function
  have two : R[0] < R[2] by linarith
  have bound : ∀ H ∈ ℝ, H ≠ R[0] → abs(H) < R[1] →
      abs(R[realCos(R[X + H]) - realCos(X) - -realSin(X) * H]) ≤
        R[2 * (H * H)]
    intros H realH nonzero small
    have smallLe : abs(H) ≤ R[1] by linarith
    obtain ⟨cosBound, sinBound⟩ := trig.small_bounds with smallLe
    have identity : R[realCos(R[X + H]) - realCos(X) - -realSin(X) * H] =
        R[realCos(X) * (realCos(H) - 1) + -realSin(X) * (realSin(H) - H)]
      rw realCos.add
      ring
    rw identity
    have triangle := abs.triangle at R[realCos(X) * (realCos(H) - 1)],
      R[-realSin(X) * (realSin(H) - H)]
    have negSin : abs(R[-realSin(X)]) ≤ R[1]
      rw abs.neg
      exact realSin.abs_le_one at X
    have cosOne := realCos.abs_le_one at X
    have firstTerm := realAbs.mul_le with cosOne, cosBound
    have secondTerm := realAbs.mul_le with negSin, sinBound
    linarith
  exact HasDerivativeAt.of_quadratic_bound with function, two, bound
theorem realSin.continuous
  shows Continuous(realSin)
proof
  refine ⟨realSin.function, ?_⟩
  intros A realA
  have derivative := realSin.derivative at A
  exact HasDerivativeAt.continuous_at with derivative

theorem realCos.continuous
  shows Continuous(realCos)
proof
  refine ⟨realCos.function, ?_⟩
  intros A realA
  have derivative := realCos.derivative at A
  exact HasDerivativeAt.continuous_at with derivative

theorem complexSin.continuous
  shows ComplexContinuous(complexSin)
proof
  sorry

theorem complexCos.continuous
  shows ComplexContinuous(complexCos)
proof
  sorry

-- Section: Bounds from Taylor's theorem
-- The derivatives of sin and cos cycle through cos, −sin, −cos, sin, so
-- Taylor's theorem bounds them by polynomials: sin x ≥ x − x³/6 and
-- 1 − x²/2 + x⁴/24 − x⁶/720 ≤ cos x ≤ 1 − x²/2 + x⁴/24 for x > 0.
theorem realSin.derivative_function
  shows derivative(realSin) = realCos
proof
  have derivativeFunction := derivative.function at realSin
  apply FunctionBetween.ext with derivativeFunction, realCos.function
  intros X realX
  have typedX : Real(X) by exact realX
  have has := realSin.derivative at X
  exact derivative.of_has_derivative with has

theorem realCos.derivative_function
  shows derivative(realCos) = pointwiseNeg(realSin)
proof
  have derivativeFunction := derivative.function at realCos
  have negFunction := pointwiseNeg.function with realSin.function
  apply FunctionBetween.ext with derivativeFunction, negFunction
  intros X realX
  have typedX : Real(X) by exact realX
  have has := realCos.derivative at X
  have sinReal : Real(realSin(X)) by typecheck
  have value := pointwiseNeg.value at realSin, X with realSin.function, sinReal
  rw [derivative.of_has_derivative with has, value]

theorem realSin.neg_derivative_function
  shows derivative(pointwiseNeg(realSin)) = pointwiseNeg(realCos)
proof
  have negSinFunction := pointwiseNeg.function with realSin.function
  have derivativeFunction := derivative.function at pointwiseNeg(realSin)
  have negFunction := pointwiseNeg.function with realCos.function
  apply FunctionBetween.ext with derivativeFunction, negFunction
  intros X realX
  have typedX : Real(X) by exact realX
  have sinHas := realSin.derivative at X
  have has := HasDerivativeAt.neg with sinHas
  have cosReal : Real(realCos(X)) by typecheck
  have value := pointwiseNeg.value at realCos, X with realCos.function, cosReal
  rw [derivative.of_has_derivative with has, value]

theorem realCos.neg_derivative_function
  shows derivative(pointwiseNeg(realCos)) = realSin
proof
  have derivativeFunction := derivative.function at pointwiseNeg(realCos)
  apply FunctionBetween.ext with derivativeFunction, realSin.function
  intros X realX
  have typedX : Real(X) by exact realX
  have cosHas := realCos.derivative at X
  have has := HasDerivativeAt.neg with cosHas
  have sinReal : realSin(X) ∈ ℝ by typecheck
  have twice : R[-(-realSin(X))] = realSin(X) by ring
  rw [derivative.of_has_derivative with has, twice]

theorem iteratedDerivative.step (f : Set) (k : Nat)
  shows iteratedDerivative(f, succ(k)) = derivative(iteratedDerivative(f, k))
proof
  rw iteratedDerivative
  rfl

theorem trig.derivative_cycle (f : Set) (k : Nat)
  requires member : f = realSin ∨ f = realCos ∨ f = pointwiseNeg(realSin) ∨
    f = pointwiseNeg(realCos)
  shows f⁽ᵏ⁾ = realSin ∨ f⁽ᵏ⁾ = realCos ∨ f⁽ᵏ⁾ = pointwiseNeg(realSin) ∨
    f⁽ᵏ⁾ = pointwiseNeg(realCos)
proof
  induction k
  | zero =>
    rw iteratedDerivative.zero
    exact member
  | succ(j) using ih =>
    have one : j + 1 = succ(j) := add.right_one with *
    rw [← one, iteratedDerivative.succ]
    cases ih with isSin | rest
    . rw [isSin, realSin.derivative_function]
      right
      left
      rfl
    . cases rest with isCos | rest
      . rw [isCos, realCos.derivative_function]
        right
        right
        left
        rfl
      . cases rest with isNegSin | isNegCos
        . rw [isNegSin, realSin.neg_derivative_function]
          right
          right
          right
          rfl
        . rw [isNegCos, realCos.neg_derivative_function]
          left
          rfl

theorem trig.cycle_differentiable (f : Set) (X : Real)
  requires member : f = realSin ∨ f = realCos ∨ f = pointwiseNeg(realSin) ∨
    f = pointwiseNeg(realCos)
  shows DifferentiableAt(f, X)
proof
  have sinHas := realSin.derivative at X
  have cosHas := realCos.derivative at X
  have negSinHas := HasDerivativeAt.neg with sinHas
  have negCosHas := HasDerivativeAt.neg with cosHas
  cases member with isSin | rest
  . rw isSin
    exact HasDerivativeAt.differentiable_at with sinHas
  . cases rest with isCos | rest
    . rw isCos
      exact HasDerivativeAt.differentiable_at with cosHas
    . cases rest with isNegSin | isNegCos
      . rw isNegSin
        exact HasDerivativeAt.differentiable_at with negSinHas
      . rw isNegCos
        exact HasDerivativeAt.differentiable_at with negCosHas

theorem trig.smooth (f : Set) (A B : Real) (n : Nat)
  requires member : f = realSin ∨ f = realCos ∨ f = pointwiseNeg(realSin) ∨
    f = pointwiseNeg(realCos)
  shows ∀ k ≤ n, ∀ X ∈ closedInterval(A, B), DifferentiableAt(f⁽ᵏ⁾, X)
proof
  intros k naturalK below X memberX
  have cycle := trig.derivative_cycle at f, k with member
  have realX : Real(X)
    have subset := closedInterval.subset_reals at A, B
    exact subset with X, memberX
  exact trig.cycle_differentiable with cycle

theorem realSin.taylor_lower (X : Real)
  requires positive : R[0] < X
  shows R[6 * X - X * X * X] ≤ R[6 * realSin(X)]
proof
  have isSin : realSin = realSin ∨ realSin = realCos ∨
      realSin = pointwiseNeg(realSin) ∨ realSin = pointwiseNeg(realCos)
    left
    rfl
  have smooth := trig.smooth at realSin, R[0], X, (2:N) with isSin
  obtain ⟨C, realC, left, right, expansion⟩ := Taylor.theorem at realSin,
    R[0], X, (2:N) with realSin.function, positive, smooth
  have three := add.right_one at (2:N)
  rw [three] at expansion
  rw [realPartialSum.succ, realPartialSum.succ, realPartialSum.succ,
    realPartialSum.zero] at expansion
  have term0 := taylorTerms.value at realSin, R[0], X, (0:N) with
    realSin.function
  have term1 := taylorTerms.value at realSin, R[0], X, (1:N) with
    realSin.function
  have term2 := taylorTerms.value at realSin, R[0], X, (2:N) with
    realSin.function
  rw term0 at expansion
  rw term1 at expansion
  rw term2 at expansion
  simp [iteratedDerivative.step, iteratedDerivative.zero,
    realSin.derivative_function, realCos.derivative_function,
    realSin.neg_derivative_function] at expansion
  have zeroReal : Real(R[0]) by typecheck
  have sinZeroReal : Real(realSin(R[0])) by typecheck
  have cosReal : Real(realCos(C)) by typecheck
  have negSinValue := pointwiseNeg.value at realSin, R[0] with
    realSin.function, sinZeroReal
  have negCosValue := pointwiseNeg.value at realCos, C with
    realCos.function, cosReal
  rw [negSinValue, negCosValue, realSin.zero, realCos.zero] at expansion
  have factorial0 : (0:N)! = (1:N) by simp [factorial]
  have factorial1 : (1:N)! = (1:N) by simp [factorial]
  have factorial2 : (2:N)! = (2:N) by simp [factorial]
  have factorial3 : (3:N)! = (6:N) by simp [factorial]
  rw [factorial0, factorial1, factorial2, factorial3] at expansion
  simp [realPow.succ, realPow.zero] at expansion
  have two := realNumeral.nat at (2:N)
  have six := realNumeral.nat at (6:N)
  rw [realNat.one, ← two, ← six] at expansion
  simp [realDiv.eq_mul_inv, realInvValue.one] at expansion
  have sixNonzero : R[6] ≠ R[0] by arith
  have inverse := realInvValue.mul_right with sixNonzero
  have realX : X ∈ ℝ by typecheck
  have identity : R[6 * realSin(X)] = R[6 * X - realCos(C) * (X * X * X)] by
    linear_combination 6 * expansion - (realCos(C) * (X * X * X)) * inverse
  have cosUpper := abs.upper at realCos(C)
  have cosOne := realCos.abs_le_one at C
  have square := realMulValue.positive with positive, positive
  have cube := realMulValue.positive with square, positive
  have gap : R[0] ≤ R[1 - realCos(C)] by linarith
  have cubeNonnegative : R[0] ≤ R[X * X * X] by linarith
  have product := realMulValue.nonnegative with gap, cubeNonnegative
  have expand : R[(1 - realCos(C)) * (X * X * X)] =
    R[X * X * X - realCos(C) * (X * X * X)] by ring
  linarith

theorem realCos.taylor_upper (X : Real)
  requires positive : R[0] < X
  shows R[24 * realCos(X)] ≤ R[24 - 12 * (X * X) + X * X * X * X]
proof
  have isCos : realCos = realSin ∨ realCos = realCos ∨
      realCos = pointwiseNeg(realSin) ∨ realCos = pointwiseNeg(realCos)
    right
    left
    rfl
  have smooth := trig.smooth at realCos, R[0], X, (3:N) with isCos
  obtain ⟨C, realC, left, right, expansion⟩ := Taylor.theorem at realCos,
    R[0], X, (3:N) with realCos.function, positive, smooth
  have four := add.right_one at (3:N)
  rw four at expansion
  rw [realPartialSum.succ, realPartialSum.succ, realPartialSum.succ,
    realPartialSum.succ, realPartialSum.zero] at expansion
  have term0 := taylorTerms.value at realCos, R[0], X, (0:N) with
    realCos.function
  have term1 := taylorTerms.value at realCos, R[0], X, (1:N) with
    realCos.function
  have term2 := taylorTerms.value at realCos, R[0], X, (2:N) with
    realCos.function
  have term3 := taylorTerms.value at realCos, R[0], X, (3:N) with
    realCos.function
  rw term0 at expansion
  rw term1 at expansion
  rw term2 at expansion
  rw term3 at expansion
  simp [iteratedDerivative.step, iteratedDerivative.zero,
    realSin.derivative_function, realCos.derivative_function,
    realSin.neg_derivative_function, realCos.neg_derivative_function]
    at expansion
  have sinZeroReal : Real(realSin(R[0])) by typecheck
  have cosZeroReal : Real(realCos(R[0])) by typecheck
  have negSinValue := pointwiseNeg.value at realSin, R[0] with
    realSin.function, sinZeroReal
  have negCosValue := pointwiseNeg.value at realCos, R[0] with
    realCos.function, cosZeroReal
  rw [negSinValue, negCosValue, realSin.zero, realCos.zero] at expansion
  have factorial0 : (0:N)! = (1:N) by simp [factorial]
  have factorial1 : (1:N)! = (1:N) by simp [factorial]
  have factorial2 : (2:N)! = (2:N) by simp [factorial]
  have factorial3 : (3:N)! = (6:N) by simp [factorial]
  have factorial4 : (4:N)! = (24:N) by simp [factorial]
  rw [factorial0, factorial1, factorial2, factorial3, factorial4] at expansion
  simp [realPow.succ, realPow.zero] at expansion
  have two := realNumeral.nat at (2:N)
  have six := realNumeral.nat at (6:N)
  have twentyFour := realNumeral.nat at (24:N)
  rw [realNat.one, ← two, ← six, ← twentyFour] at expansion
  simp [realDiv.eq_mul_inv, realInvValue.one] at expansion
  have twoNonzero : R[2] ≠ R[0] by arith
  have twentyFourNonzero : R[24] ≠ R[0] by arith
  have inverseTwo := realInvValue.mul_right with twoNonzero
  have inverseTwentyFour := realInvValue.mul_right with twentyFourNonzero
  have realX : X ∈ ℝ by typecheck
  have identity : R[24 * realCos(X)] =
      R[24 - 12 * (X * X) + realCos(C) * (X * X * X * X)] by
    linear_combination 24 * expansion - (12 * (X * X)) * inverseTwo +
      (realCos(C) * (X * X * X * X)) * inverseTwentyFour
  have cosUpper := abs.upper at realCos(C)
  have cosOne := realCos.abs_le_one at C
  have square := realMulValue.positive with positive, positive
  have quartic := realMulValue.positive with square, square
  have gap : R[0] ≤ R[1 - realCos(C)] by linarith
  have quarticNonnegative : R[0] ≤ R[X * X * (X * X)] by linarith
  have product := realMulValue.nonnegative with gap, quarticNonnegative
  have expand : R[(1 - realCos(C)) * (X * X * (X * X))] =
    R[X * X * X * X - realCos(C) * (X * X * X * X)] by ring
  linarith

theorem realCos.taylor_lower (X : Real)
  requires positive : R[0] < X
  shows R[720 - 360 * (X * X) + 30 * (X * X * X * X) -
    X * X * X * X * X * X] ≤ R[720 * realCos(X)]
proof
  have isCos : realCos = realSin ∨ realCos = realCos ∨
      realCos = pointwiseNeg(realSin) ∨ realCos = pointwiseNeg(realCos)
    right
    left
    rfl
  have smooth := trig.smooth at realCos, R[0], X, (5:N) with isCos
  obtain ⟨C, realC, left, right, expansion⟩ := Taylor.theorem at realCos,
    R[0], X, (5:N) with realCos.function, positive, smooth
  have six := add.right_one at (5:N)
  rw six at expansion
  rw [realPartialSum.succ, realPartialSum.succ, realPartialSum.succ,
    realPartialSum.succ, realPartialSum.succ, realPartialSum.succ,
    realPartialSum.zero] at expansion
  have term0 := taylorTerms.value at realCos, R[0], X, (0:N) with
    realCos.function
  have term1 := taylorTerms.value at realCos, R[0], X, (1:N) with
    realCos.function
  have term2 := taylorTerms.value at realCos, R[0], X, (2:N) with
    realCos.function
  have term3 := taylorTerms.value at realCos, R[0], X, (3:N) with
    realCos.function
  have term4 := taylorTerms.value at realCos, R[0], X, (4:N) with
    realCos.function
  have term5 := taylorTerms.value at realCos, R[0], X, (5:N) with
    realCos.function
  rw term0 at expansion
  rw term1 at expansion
  rw term2 at expansion
  rw term3 at expansion
  rw term4 at expansion
  rw term5 at expansion
  simp [iteratedDerivative.step, iteratedDerivative.zero,
    realSin.derivative_function, realCos.derivative_function,
    realSin.neg_derivative_function, realCos.neg_derivative_function]
    at expansion
  have sinZeroReal : Real(realSin(R[0])) by typecheck
  have cosZeroReal : Real(realCos(R[0])) by typecheck
  have cosReal : Real(realCos(C)) by typecheck
  have negSinValue := pointwiseNeg.value at realSin, R[0] with
    realSin.function, sinZeroReal
  have negCosValue := pointwiseNeg.value at realCos, R[0] with
    realCos.function, cosZeroReal
  have negCosC := pointwiseNeg.value at realCos, C with
    realCos.function, cosReal
  rw [negSinValue, negCosValue, negCosC, realSin.zero, realCos.zero]
    at expansion
  have factorial0 : (0:N)! = (1:N) by simp [factorial]
  have factorial1 : (1:N)! = (1:N) by simp [factorial]
  have factorial2 : (2:N)! = (2:N) by simp [factorial]
  have factorial3 : (3:N)! = (6:N) by simp [factorial]
  have factorial4 : (4:N)! = (24:N) by simp [factorial]
  have factorial5 : (5:N)! = (120:N) by simp [factorial]
  have factorial6 : (6:N)! = (720:N) by simp [factorial]
  rw [factorial0, factorial1, factorial2, factorial3, factorial4,
    factorial5, factorial6] at expansion
  simp [realPow.succ, realPow.zero] at expansion
  have two := realNumeral.nat at (2:N)
  have sixReal := realNumeral.nat at (6:N)
  have twentyFour := realNumeral.nat at (24:N)
  have oneTwenty := realNumeral.nat at (120:N)
  have sevenTwenty := realNumeral.nat at (720:N)
  rw [realNat.one, ← two, ← sixReal, ← twentyFour, ← oneTwenty,
    ← sevenTwenty] at expansion
  simp [realDiv.eq_mul_inv, realInvValue.one] at expansion
  have twoNonzero : R[2] ≠ R[0] by arith
  have twentyFourNonzero : R[24] ≠ R[0] by arith
  have sevenTwentyNonzero : R[720] ≠ R[0] by arith
  have inverseTwo := realInvValue.mul_right with twoNonzero
  have inverseTwentyFour := realInvValue.mul_right with twentyFourNonzero
  have inverseSevenTwenty := realInvValue.mul_right with sevenTwentyNonzero
  have realX : X ∈ ℝ by typecheck
  have identity : R[720 * realCos(X)] =
      R[720 - 360 * (X * X) + 30 * (X * X * X * X) -
        realCos(C) * (X * X * X * X * X * X)] by
    linear_combination 720 * expansion - (360 * (X * X)) * inverseTwo +
      (30 * (X * X * X * X)) * inverseTwentyFour -
      (realCos(C) * (X * X * X * X * X * X)) * inverseSevenTwenty
  have cosUpper := abs.upper at realCos(C)
  have cosOne := realCos.abs_le_one at C
  have square := realMulValue.positive with positive, positive
  have quartic := realMulValue.positive with square, square
  have sextic := realMulValue.positive with quartic, square
  have gap : R[0] ≤ R[1 - realCos(C)] by linarith
  have sexticNonnegative : R[0] ≤ R[X * X * (X * X) * (X * X)] by linarith
  have product := realMulValue.nonnegative with gap, sexticNonnegative
  have expand : R[(1 - realCos(C)) * (X * X * (X * X) * (X * X))] =
    R[X * X * X * X * X * X - realCos(C) * (X * X * X * X * X * X)] by ring
  linarith

theorem realSin.positive_small (X : Real)
  requires positive : R[0] < X
  requires upper : X ≤ R[2]
  shows R[0] < realSin(X)
proof
  have taylor := realSin.taylor_lower with positive
  have nonnegative : R[0] ≤ X by linarith
  have square := realMulValue.square_le_of_le with nonnegative, upper
  have cube := realLe.mul_right_of_nonnegative with square, nonnegative
  have four : R[2 * 2 * X] = R[4 * X] by ring
  linarith

theorem realCos.decreasing_small (X Y : Real)
  requires lower : R[0] ≤ X
  requires less : X < Y
  requires upper : Y ≤ R[2]
  shows realCos(Y) < realCos(X)
proof
  have isCos : realCos = realSin ∨ realCos = realCos ∨
      realCos = pointwiseNeg(realSin) ∨ realCos = pointwiseNeg(realCos)
    right
    left
    rfl
  have differentiable : ∀ Z ∈ closedInterval(X, Y), DifferentiableAt(realCos, Z)
    intros Z memberZ
    have subset := closedInterval.subset_reals at X, Y
    have realZ : Real(Z)
      exact subset with Z, memberZ
    exact trig.cycle_differentiable with isCos
  obtain ⟨C, realC, left, right, expansion⟩ := Taylor.mean_value at realCos,
    X, Y with realCos.function, less, differentiable
  have sinReal : Real(realSin(C)) by typecheck
  have value := pointwiseNeg.value at realSin, C with realSin.function, sinReal
  rw [realCos.derivative_function, value] at expansion
  have positiveC : R[0] < C by linarith
  have smallC : C ≤ R[2] by linarith
  have sinPositive := realSin.positive_small with positiveC, smallC
  have width : R[0] < R[Y - X] by linarith
  have product := realMulValue.positive with sinPositive, width
  have realY : Y ∈ ℝ by typecheck
  have realX : X ∈ ℝ by typecheck
  have normal : realCos(Y) = R[realCos(X) - realSin(C) * (Y - X)] by
    linear_combination expansion
  linarith

theorem realCos.two_negative
  shows realCos(R[2]) < R[0]
proof
  have positive : R[0] < R[2] by linarith
  have taylor := realCos.taylor_upper with positive
  linarith

theorem realCos.positive_of_double (X : Real)
  requires double : R[X * 2] = R[3]
  shows R[0] < realCos(X)
proof
  have square : R[4 * (X * X)] = R[9] by
    linear_combination (X * 2 + 3) * double
  have quartic : R[16 * (X * X * X * X)] = R[81] by
    linear_combination (4 * (X * X) + 9) * square
  have sextic : R[64 * (X * X * X * X * X * X)] = R[729] by
    linear_combination (16 * (X * X * X * X) + 36 * (X * X) + 81) * square
  have positive : R[0] < X by linarith
  have taylor := realCos.taylor_lower with positive
  have middle : R[240 * (X * X * X * X)] = R[1215] by
    linear_combination 15 * quartic
  have quarticBound : R[151] < R[30 * (X * X * X * X)] by linarith
  have sexticBound : R[X * X * X * X * X * X] < R[12] by linarith
  have squareValue : R[360 * (X * X)] = R[810] by
    linear_combination 90 * square
  have scaled : R[49] < R[720 * realCos(X)] by linarith
  linarith

-- Section: π
-- cos has a zero strictly between 0 and 2.
theorem realCos.zero_below_two
  shows ∃ H ∈ ℝ, R[0] < H ∧ H < R[2] ∧ realCos(H) = R[0]
proof
  have negContinuous := Continuous.neg with realCos.continuous
  have subset := closedInterval.subset_reals at R[0], R[2]
  have continuousOn := Continuous.continuous_on with negContinuous, subset
  have ordered : R[0] ≤ R[2] by linarith
  have cosZeroReal : Real(realCos(R[0])) by typecheck
  have cosTwoReal : Real(realCos(R[2])) by typecheck
  have atZero := pointwiseNeg.value at realCos, R[0] with realCos.function,
    cosZeroReal
  have atTwo := pointwiseNeg.value at realCos, R[2] with realCos.function,
    cosTwoReal
  have twoNegative := realCos.two_negative
  have negative : pointwiseNeg(realCos)(R[0]) < R[0]
    rw [atZero, realCos.zero]
    linarith
  have positive : R[0] < pointwiseNeg(realCos)(R[2])
    rw atTwo
    linarith
  obtain ⟨H, memberH, zeroH⟩ := closedInterval.zero_of_sign_change with
    ordered, continuousOn, negative, positive
  obtain ⟨realH, lower, upper⟩ := closedInterval.membership.forward with memberH
  have cosReal : Real(realCos(H)) by typecheck
  have atH := pointwiseNeg.value at realCos, H with realCos.function, cosReal
  rw atH at zeroH
  have cosZero : realCos(H) = R[0] by linarith
  have notZero : H ≠ R[0]
    intro same
    rw [same, realCos.zero] at cosZero
    linarith
  have notTwo : H ≠ R[2]
    intro same
    rw same at cosZero
    linarith
  have positiveH : R[0] < H
    have split := realLess.trichotomy at H, R[0]
    cases split with below | rest
    . linarith
    . cases rest with same | above
      . exfalso
        exact notZero with same
      . exact above
  have belowTwo : H < R[2]
    have split := realLess.trichotomy at H, R[2]
    cases split with below | rest
    . exact below
    . cases rest with same | above
      . exfalso
        exact notTwo with same
      . linarith
  refine ⟨H, realH, positiveH, belowTwo, cosZero⟩

theorem realCos.least_positive_zero
  shows ∃ H ∈ ℝ, LeastPositiveZero(realCos, H)
proof
  obtain ⟨H, realH, positiveH, belowTwo, cosZero⟩ := realCos.zero_below_two
  witness H
  refine ⟨realH, ?_⟩
  unfold LeastPositiveZero
  refine ⟨realH, positiveH, cosZero, ?_⟩
  intros X realX positiveX zeroX
  by_contra notLe
  have less : X < H by linarith
  have nonnegative : R[0] ≤ X by linarith
  have upper : H ≤ R[2] by linarith
  have decreasing := realCos.decreasing_small with nonnegative, less, upper
  linarith

def realHalfPi : Real := leastPositiveZero(realCos)
proof
  have selected := leastPositiveZero.selected with
    realCos.least_positive_zero
  unfold realHalfPi
  unfold Real
  exact selected.left

def realPi : Real := R[2 * realHalfPi]
proof
  unfold realPi
  typecheck

theorem realHalfPi.property
  shows LeastPositiveZero(realCos, realHalfPi)
proof
  have selected := leastPositiveZero.selected with
    realCos.least_positive_zero
  unfold realHalfPi
  exact selected.right


theorem realHalfPi.positive
  shows R[0] < realHalfPi
proof
  obtain ⟨_, positive, _, _⟩ := realHalfPi.property
  exact positive

theorem realHalfPi.cos
  shows realCos(realHalfPi) = R[0]
proof
  obtain ⟨_, _, zero, _⟩ := realHalfPi.property
  exact zero

theorem realHalfPi.least (X : Real)
  requires positive : R[0] < X
  requires zero : realCos(X) = R[0]
  shows realHalfPi ≤ X
proof
  obtain ⟨_, _, _, least⟩ := realHalfPi.property
  have realX : X ∈ ℝ by typecheck
  exact least with realX, positive, zero

theorem realPi.real
  shows realPi ∈ ℝ
proof
  typecheck

theorem realPi.positive
  shows R[0] < realPi
proof
  have positive := realHalfPi.positive
  unfold realPi
  linarith

-- 3 < π < 4, which places the definition.
theorem realPi.bounds
  shows R[3] < realPi ∧ realPi < R[4]
proof
  obtain ⟨H, realH, positiveH, belowTwo, cosZero⟩ := realCos.zero_below_two
  have typedH : Real(H) by typecheck
  have upper := realHalfPi.least at H with positiveH, cosZero
  have twoNonzero : R[2] ≠ R[0] by arith
  have double := realDiv.mul_right at R[3], R[2] with twoNonzero
  have threeHalves := realCos.positive_of_double with double
  have lower : R[3 / 2] < realHalfPi
    have positive := realHalfPi.positive
    have zero := realHalfPi.cos
    have split := realLess.trichotomy at realHalfPi, R[3 / 2]
    cases split with below | rest
    . have nonnegative : R[0] ≤ realHalfPi by linarith
      have small : R[3 / 2] ≤ R[2] by linarith
      have decreasing := realCos.decreasing_small with nonnegative, below,
        small
      linarith
    . cases rest with same | above
      . rw ← same at threeHalves
        linarith
      . exact above
  unfold realPi
  constructor
  . linarith
  . linarith

theorem realSin.half_pi
  shows realSin(realHalfPi) = R[1]
proof
  have identity := realSin.square_add_cos_square at realHalfPi
  rw realHalfPi.cos at identity
  obtain ⟨_, upper⟩ := realPi.bounds
  have positive := realHalfPi.positive
  have small : realHalfPi ≤ R[2]
    unfold realPi at upper
    linarith
  have sinPositive := realSin.positive_small with positive, small
  have nonnegative : R[0] ≤ realSin(realHalfPi) by linarith
  have oneNonnegative : R[0] ≤ R[1] by linarith
  have squares : R[realSin(realHalfPi) * realSin(realHalfPi)] = R[1 * 1]
    linear_combination identity
  exact realMulValue.eq_of_square_eq with nonnegative, oneNonnegative,
    squares

theorem realSin.pi
  shows realSin(realPi) = R[0]
proof
  have double : R[2 * realHalfPi] = R[realHalfPi + realHalfPi] by ring
  unfold realPi
  rw [double, realSin.add, realHalfPi.cos]
  ring

theorem realCos.pi
  shows realCos(realPi) = R[-1]
proof
  have double : R[2 * realHalfPi] = R[realHalfPi + realHalfPi] by ring
  unfold realPi
  rw [double, realCos.add, realHalfPi.cos, realSin.half_pi]
  ring

theorem complexExp.i_pi
  shows complexExp(ℂ[complexImaginaryUnit * complexOfReal(realPi)]) = ℂ[-1]
proof
  sorry

theorem complexExp.two_pi_i
  shows complexExp(ℂ[complexOfReal(R[2 * realPi]) * complexImaginaryUnit]) =
    ℂ[1]
proof
  sorry

-- Section: Periodicity
theorem complexExp.periodic (z : Set)
  requires hz : z ∈ ℂ
  shows complexExp(ℂ[z + complexOfReal(R[2 * realPi]) * complexImaginaryUnit])
    = complexExp(z)
proof
  sorry

-- e^z = 1 exactly at the integer multiples of 2πi.
theorem complexExp.eq_one_iff (z : Set)
  requires hz : z ∈ ℂ
  shows complexExp(z) = ℂ[1] ↔
    (∃ k ∈ ℤ, z = ℂ[complexOfReal(R[2 * realPi * realInt(k)]) *
      complexImaginaryUnit])
proof
  sorry

theorem complexSin.periodic (z : Set)
  requires hz : z ∈ ℂ
  shows complexSin(ℂ[z + complexOfReal(R[2 * realPi])]) = complexSin(z)
proof
  sorry

theorem complexCos.periodic (z : Set)
  requires hz : z ∈ ℂ
  shows complexCos(ℂ[z + complexOfReal(R[2 * realPi])]) = complexCos(z)
proof
  sorry

theorem realSin.periodic (X : Real)
  shows realSin(R[X + 2 * realPi]) = realSin(X)
proof
  sorry

theorem realCos.periodic (X : Real)
  shows realCos(R[X + 2 * realPi]) = realCos(X)
proof
  sorry

theorem realSin.add_pi (X : Real)
  shows realSin(R[X + realPi]) = R[-realSin(X)]
proof
  sorry

theorem realCos.add_pi (X : Real)
  shows realCos(R[X + realPi]) = R[-realCos(X)]
proof
  sorry

-- Section: Signs and monotonicity
theorem realSin.positive (X : Real)
  requires lower : R[0] < X
  requires upper : X < realPi
  shows R[0] < realSin(X)
proof
  sorry

theorem realCos.positive (X : Real)
  requires lower : R[-realHalfPi] < X
  requires upper : X < realHalfPi
  shows R[0] < realCos(X)
proof
  sorry

theorem realCos.strictly_decreasing (X Y : Real)
  requires lower : R[0] ≤ X
  requires less : X < Y
  requires upper : Y ≤ realPi
  shows realCos(Y) < realCos(X)
proof
  sorry

theorem realSin.eq_zero_iff (X : Real)
  shows realSin(X) = R[0] ↔ (∃ k ∈ ℤ, X = R[realPi * realInt(k)])
proof
  sorry

-- Every point of the unit circle is (cos θ, sin θ) for exactly one θ in
-- (−π, π].
theorem realCos.unit_circle (a b : Real)
  requires unit : R[a * a + b * b] = R[1]
  shows ∃ θ ∈ ℝ, R[-realPi] < θ ∧ θ ≤ realPi ∧ realCos(θ) = a ∧
    realSin(θ) = b
proof
  sorry

theorem realCos.unit_circle_unique (θ φ : Real)
  requires lowerθ : R[-realPi] < θ
  requires upperθ : θ ≤ realPi
  requires lowerφ : R[-realPi] < φ
  requires upperφ : φ ≤ realPi
  requires sameCos : realCos(θ) = realCos(φ)
  requires sameSin : realSin(θ) = realSin(φ)
  shows θ = φ
proof
  sorry

end Trigonometry
