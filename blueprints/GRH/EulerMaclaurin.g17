-- The Euler–Maclaurin summation formula. For f of class C^m on [0, M],
-- with M a natural number and m ≥ 1,
--   Σ_{n<M} f(n) = ∫_0^M f + Σ_{k=1}^{m} Bₖ/k! (f^(k−1)(M) − f^(k−1)(0))
--                  + (−1)^(m+1)/m! ∫_0^M P̃ₘ(x) f^(m)(x) dx,
-- with B₁ = −1/2 and P̃ₘ the periodic Bernoulli function; for real f, and
-- for complex functions of a real variable through their real and
-- imaginary parts.
-- Part of the GRH blueprint.
-- Planned home: Real/Analysis/EulerMaclaurin.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.EulerMaclaurin
import GRH.Integral
import GRH.Bernoulli
import Grace.Cumulus.Real.Analysis.Derivative

section EulerMaclaurin
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- Section: Definitions
-- f : ℝ → ℝ is of class C^m on [A, B]: f, f′, …, f^(m−1) are
-- differentiable at every point of [A, B] (two-sided, so f is defined
-- around the interval) and f^(m) is continuous on [A, B].
predicate ContinuouslyDifferentiableOn (f : Set, m : Nat, A B : Real) :=
  FunctionBetween(f, ℝ, ℝ) ∧
  (∀ k ∈ ℕ, k < m → ∀ X ∈ closedInterval(A, B),
    DifferentiableAt(iteratedDerivative(f, k), X)) ∧
  ContinuousOn(iteratedDerivative(f, m), closedInterval(A, B))

-- The values f(0), f(1), f(2), … as a sequence.
defgraph naturalValues (f : Set) (n ∈ ℕ) : ℝ := f(realNat(n))
requires function : FunctionBetween(f, ℝ, ℝ)
proof
  have typedN := nat.omega.backward with member
  have point := realNat.real at n
  have pointMember : realNat(n) ∈ ℝ by exact point
  exact FunctionBetween.apply_closed with function, pointMember

-- The terms B_{k+1}/(k+1)! (f^(k)(B) − f^(k)(A)), k = 0, 1, …, of the
-- boundary sum (the index k here is k − 1 in the displayed formula).
defgraph eulerMaclaurinTerms (f : Set, A B : Real) (k ∈ ℕ) : ℝ :=
    R[bernoulli(k + 1) / realNat((k + 1)!) *
      (iteratedDerivative(f, k)(B) - iteratedDerivative(f, k)(A))]
requires function : FunctionBetween(f, ℝ, ℝ)
proof
  have typedK := nat.omega.backward with member
  have derivativeFunction := iteratedDerivative.function at f, k with function
  have aMember : A ∈ ℝ by typecheck
  have bMember : B ∈ ℝ by typecheck
  have valueA := FunctionBetween.apply_closed with derivativeFunction, aMember
  have valueB := FunctionBetween.apply_closed with derivativeFunction, bMember
  have realA : Real(iteratedDerivative(f, k)(A)) by exact valueA
  have realB : Real(iteratedDerivative(f, k)(B)) by exact valueB
  have number := bernoulli.real at k + 1
  have factorialReal := realNat.real at (k + 1)!
  typecheck

-- Complex functions of a real variable: the values at the naturals, the
-- k-th derivative taken in the real and imaginary parts, and P̃ₘ as a
-- complex function.
defgraph complexNaturalValues (g : Set) (n ∈ ℕ) : complexCarrier :=
    g(realNat(n))
requires values : ComplexValuedOn(g, ℝ)
proof
  have typedN := nat.omega.backward with member
  have point := realNat.real at n
  have pointMember : realNat(n) ∈ ℝ by exact point
  exact values with realNat(n), pointMember

defgraph complexIteratedDeriv (g : Set, k : Nat) (X ∈ ℝ) : complexCarrier :=
    (iteratedDerivative(complexFunctionRe(g), k)(X),
      iteratedDerivative(complexFunctionIm(g), k)(X))
requires values : ComplexValuedOn(g, ℝ)
proof
  have functionRe := complexFunctionRe.function with values
  have functionIm := complexFunctionIm.function with values
  have derivativeRe := iteratedDerivative.function at complexFunctionRe(g), k
    with functionRe
  have derivativeIm := iteratedDerivative.function at complexFunctionIm(g), k
    with functionIm
  have valueRe := FunctionBetween.apply_closed with derivativeRe, member
  have valueIm := FunctionBetween.apply_closed with derivativeIm, member
  have realRe : Real(iteratedDerivative(complexFunctionRe(g), k)(X))
    by exact valueRe
  have realIm : Real(iteratedDerivative(complexFunctionIm(g), k)(X))
    by exact valueIm
  exact complexCarrier.pair at iteratedDerivative(complexFunctionRe(g), k)(X),
    iteratedDerivative(complexFunctionIm(g), k)(X)

defgraph complexPeriodicBernoulli (m : Nat) (X ∈ ℝ) : complexCarrier :=
    complexOfReal(periodicBernoulli(m)(X))
proof
  have function := periodicBernoulli.function at m
  have value := FunctionBetween.apply_closed with function, member
  have valueReal : Real(periodicBernoulli(m)(X)) by exact value
  typecheck

defgraph complexEulerMaclaurinTerms (g : Set, A B : Real) (k ∈ ℕ) :
    complexCarrier :=
  ℂ[complexOfReal(R[bernoulli(k + 1) / realNat((k + 1)!)]) *
    (complexIteratedDeriv(g, k)(B) - complexIteratedDeriv(g, k)(A))]
requires values : ComplexValuedOn(g, ℝ)
proof
  have typedK := nat.omega.backward with member
  have aMember : A ∈ ℝ by typecheck
  have bMember : B ∈ ℝ by typecheck
  have derivativeFunction := complexIteratedDeriv.function at g, k with values
  have valueA := FunctionBetween.apply_closed with derivativeFunction, aMember
  have valueB := FunctionBetween.apply_closed with derivativeFunction, bMember
  have number := bernoulli.real at k + 1
  have factorialReal := realNat.real at (k + 1)!
  have coefficient : Real(R[bernoulli(k + 1) / realNat((k + 1)!)]) by typecheck
  typecheck

-- Section: Integration by parts
-- ∫ u V + ∫ U v = U V |_A^B when U′ = u and V′ = v inside (A, B).
theorem riemannIntegral.by_parts (U u V v : Set) (A B : Real)
  requires ordered : A ≤ B
  requires functionDU : u : ℝ → ℝ
  requires functionDV : v : ℝ → ℝ
  requires continuousU : ContinuousOn(U, closedInterval(A, B))
  requires continuousV : ContinuousOn(V, closedInterval(A, B))
  requires derivativeU : ∀ X ∈ ℝ, A < X → X < B → HasDerivativeAt(U, u(X), X)
  requires derivativeV : ∀ X ∈ ℝ, A < X → X < B → HasDerivativeAt(V, v(X), X)
  requires integrableFirst : RiemannIntegrable(pointwiseMul(u, V), A, B)
  requires integrableSecond : RiemannIntegrable(pointwiseMul(U, v), A, B)
  shows R[riemannIntegral(pointwiseMul(u, V), A, B) +
      riemannIntegral(pointwiseMul(U, v), A, B)] = R[U(B) * V(B) - U(A) * V(A)]
proof
  have continuousUCopy : ContinuousOn(U, closedInterval(A, B))
    by exact continuousU
  have continuousVCopy : ContinuousOn(V, closedInterval(A, B))
    by exact continuousV
  obtain ⟨functionU, _, _⟩ := continuousUCopy
  obtain ⟨functionV, _, _⟩ := continuousVCopy
  have functionFirst := pointwiseMul.function at u, V with functionDU,
    functionV
  have functionSecond := pointwiseMul.function at U, v with functionU,
    functionDV
  have functionSum := realLinearCombination.function at R[1], R[1],
    pointwiseMul(u, V), pointwiseMul(U, v) with functionFirst, functionSecond
  have valuesSum : ∀ X ∈ ℝ, realLinearCombination(R[1], R[1],
      pointwiseMul(u, V), pointwiseMul(U, v))(X) =
      R[1 * pointwiseMul(u, V)(X) + 1 * pointwiseMul(U, v)(X)]
    intros X xMember
    exact realLinearCombination.value with functionFirst, functionSecond,
      xMember
  have integralSum := HasRiemannIntegral.linear with
    (riemannIntegral.integral with integrableFirst),
    (riemannIntegral.integral with integrableSecond), functionSum, valuesSum
  have continuousW := ContinuousOn.mul with continuousU, continuousV
  have derivativeW : ∀ X ∈ ℝ, A < X → X < B → HasDerivativeAt(
      pointwiseMul(U, V), realLinearCombination(R[1], R[1],
        pointwiseMul(u, V), pointwiseMul(U, v))(X), X)
    intros X xMember lower upper
    have xReal : Real(X) by exact xMember
    have valueU := FunctionBetween.apply_closed with functionU, xMember
    have valueV := FunctionBetween.apply_closed with functionV, xMember
    have valueDU := FunctionBetween.apply_closed with functionDU, xMember
    have valueDV := FunctionBetween.apply_closed with functionDV, xMember
    have realU : Real(U(X)) by exact valueU
    have realV : Real(V(X)) by exact valueV
    have realDU : Real(u(X)) by exact valueDU
    have realDV : Real(v(X)) by exact valueDV
    have product := HasDerivativeAt.mul_value with
      (derivativeU with X, xMember, lower, upper),
      (derivativeV with X, xMember, lower, upper), realU, realV
    apply HasDerivativeAt.congr_value with product
    rw [(valuesSum with X, xMember),
      (pointwiseMul.value at u, V, X with functionDU, functionV, realDU, realV),
      (pointwiseMul.value at U, v, X with functionU, functionDV, realU, realDV)]
    ring
  have value := HasRiemannIntegral.eq_endpoint_of_local_derivative with
    continuousW, derivativeW, integralSum
  have aMember : A ∈ ℝ by typecheck
  have bMember : B ∈ ℝ by typecheck
  have valueUA := FunctionBetween.apply_closed with functionU, aMember
  have valueVA := FunctionBetween.apply_closed with functionV, aMember
  have valueUB := FunctionBetween.apply_closed with functionU, bMember
  have valueVB := FunctionBetween.apply_closed with functionV, bMember
  have realUA : Real(U(A)) by exact valueUA
  have realVA : Real(V(A)) by exact valueVA
  have realUB : Real(U(B)) by exact valueUB
  have realVB : Real(V(B)) by exact valueVB
  rw [(pointwiseMul.value at U, V, B with functionU, functionV, realUB, realVB),
    (pointwiseMul.value at U, V, A with functionU, functionV, realUA, realVA)]
    at value
  obtain ⟨firstReal, _⟩ := riemannIntegral.selected at pointwiseMul(u, V), A, B
  obtain ⟨secondReal, _⟩ := riemannIntegral.selected at pointwiseMul(U, v), A, B
  unfold realSubValue at value
  have shape : R[1 * riemannIntegral(pointwiseMul(u, V), A, B) +
      1 * riemannIntegral(pointwiseMul(U, v), A, B)] =
    R[riemannIntegral(pointwiseMul(u, V), A, B) +
      riemannIntegral(pointwiseMul(U, v), A, B)] by ring
  rw ← shape
  exact value

-- Section: Cells of the integer partition
-- Inside the cell [n, n + 1], P̃ₘ is the translate x ↦ Bₘ(x − n).
theorem periodicBernoulli.cell_agree (m n : Nat)
  shows ∀ X ∈ ℝ, realNat(n) < X → X < realNat(succ(n)) →
    periodicBernoulli(m)(X) = bernoulliTranslate(m, R[-realNat(n)])(X)
proof
  intros X xMember lower upper
  have xReal : Real(X) by exact xMember
  have point := realInt.nat at n
  have nReal := realNat.real at n
  have step := realNat.successor at n
  have lowerLe : realInt(integerOfNat(n)) ≤ X
    rw point
    exact realLess.implies_le with lower
  have upperLt : X < R[realInt(integerOfNat(n)) + 1]
    rw point
    linarith
  rw (periodicBernoulli.eq_right with lowerLe, upperLt)
  rw point

-- P̃ₘ h is integrable on [n, n + 1] for h continuous there.
theorem periodicBernoulli.cell_integrable (m n : Nat, h : Set)
  requires continuous : ContinuousOn(h,
    closedInterval(realNat(n), realNat(succ(n))))
  shows RiemannIntegrable(pointwiseMul(periodicBernoulli(m), h), realNat(n),
    realNat(succ(n)))
proof
  have continuousCopy : ContinuousOn(h,
      closedInterval(realNat(n), realNat(succ(n)))) by exact continuous
  obtain ⟨functionH, subset, _⟩ := continuousCopy
  have functionP := periodicBernoulli.function at m
  have translateFunction := bernoulliTranslate.function at m, R[-realNat(n)]
  have product := pointwiseMul.function with functionP, functionH
  have translateContinuous := Continuous.continuous_on with
    (bernoulliTranslate.continuous at m, R[-realNat(n)]), subset
  have continuousProduct := ContinuousOn.mul with translateContinuous,
    continuous
  have nReal := realNat.real at n
  have step := realNat.successor at n
  have ordered : realNat(n) ≤ realNat(succ(n)) by linarith
  have cellAgree := periodicBernoulli.cell_agree at m, n
  have agree : ∀ X ∈ ℝ, realNat(n) < X → X < realNat(succ(n)) →
      pointwiseMul(periodicBernoulli(m), h)(X) =
        pointwiseMul(bernoulliTranslate(m, R[-realNat(n)]), h)(X)
    intros X xMember lower upper
    have xReal : Real(X) by exact xMember
    have valueP := FunctionBetween.apply_closed with functionP, xMember
    have valueT := FunctionBetween.apply_closed with translateFunction, xMember
    have valueH := FunctionBetween.apply_closed with functionH, xMember
    have realP : Real(periodicBernoulli(m)(X)) by exact valueP
    have realT : Real(bernoulliTranslate(m, R[-realNat(n)])(X)) by exact valueT
    have realH : Real(h(X)) by exact valueH
    rw [(pointwiseMul.value at periodicBernoulli(m), h, X with functionP,
        functionH, realP, realH),
      (pointwiseMul.value at bernoulliTranslate(m, R[-realNat(n)]), h, X with
        translateFunction, functionH, realT, realH),
      (cellAgree with X, xMember, lower, upper)]
  have integral := HasRiemannIntegral.of_continuous_interior with product,
    ordered, continuousProduct, agree
  obtain ⟨value, _⟩ := riemannIntegral.selected at
    pointwiseMul(bernoulliTranslate(m, R[-realNat(n)]), h), realNat(n),
    realNat(succ(n))
  exact ⟨riemannIntegral(pointwiseMul(bernoulliTranslate(m, R[-realNat(n)]), h),
    realNat(n), realNat(succ(n))), value, integral⟩

-- P̃ₘ h is integrable on [0, M] for h continuous there.
theorem periodicBernoulli.prefix_integrable (m : Nat, h : Set) (M : Nat)
  shows ContinuousOn(h, closedInterval(R[0], realNat(M))) →
    RiemannIntegrable(pointwiseMul(periodicBernoulli(m), h), R[0], realNat(M))
proof
  induction M
  | zero =>
    intro continuous
    obtain ⟨functionH, _, _⟩ := continuous
    have functionP := periodicBernoulli.function at m
    have product := pointwiseMul.function with functionP, functionH
    rw realNat.zero
    exact RiemannIntegrable.point with product
  | succ(k) using ih =>
    intro continuous
    have kReal := realNat.real at k
    have nonnegative := realNat.nonnegative at k
    have step := realNat.successor at k
    have reflexiveZero : R[0] ≤ R[0] by linarith
    have before : realNat(k) ≤ realNat(succ(k)) by linarith
    have reflexiveEnd : realNat(succ(k)) ≤ realNat(succ(k)) by linarith
    have left := ContinuousOn.subinterval with continuous, reflexiveZero, before
    have right := ContinuousOn.subinterval with continuous, nonnegative,
      reflexiveEnd
    have prefix := ih with left
    have cell := periodicBernoulli.cell_integrable at m, k, h with right
    exact RiemannIntegrable.adjacent with prefix, cell

-- Section: One cell of the formula
-- h′ is a continuous derivative of h on [A, B].
predicate DerivativeOn (h dh : Set, A B : Real) :=
  FunctionBetween(h, ℝ, ℝ) ∧ FunctionBetween(dh, ℝ, ℝ) ∧
  (∀ X ∈ closedInterval(A, B), HasDerivativeAt(h, dh(X), X)) ∧
  ContinuousOn(dh, closedInterval(A, B))

theorem DerivativeOn.continuous (h dh : Set) (A B : Real)
  requires derivative : DerivativeOn(h, dh, A, B)
  shows ContinuousOn(h, closedInterval(A, B))
proof
  obtain ⟨function, functionD, pointwise, _⟩ := derivative
  have subset : closedInterval(A, B) ⊆ ℝ
    intros X inside
    obtain ⟨xMember, _, _⟩ := closedInterval.membership.forward with inside
    exact xMember
  apply ContinuousOn.of_differentiable with function, subset
  intros X inside
  obtain ⟨xMember, _, _⟩ := closedInterval.membership.forward with inside
  have xReal : Real(X) by exact xMember
  have valueD := FunctionBetween.apply_closed with functionD, xMember
  have realD : Real(dh(X)) by exact valueD
  exact HasDerivativeAt.differentiable_at with (pointwise with X, inside)

theorem DerivativeOn.restrict (h dh : Set) (A B X Y : Real)
  requires derivative : DerivativeOn(h, dh, A, B)
  requires left : A ≤ X
  requires right : Y ≤ B
  shows DerivativeOn(h, dh, X, Y)
proof
  obtain ⟨function, functionD, pointwise, continuous⟩ := derivative
  refine ⟨function, functionD, ?_, ?_⟩
  . intros Z inside
    obtain ⟨zMember, lower, upper⟩ := closedInterval.membership.forward with
      inside
    have zReal : Real(Z) by exact zMember
    have lowerA : A ≤ Z by linarith
    have upperB : Z ≤ B by linarith
    exact pointwise with Z,
      (closedInterval.membership.backward with ⟨zMember, lowerA, upperB⟩)
  . exact ContinuousOn.subinterval with continuous, left, right

-- A point strictly inside [n, n + 1] is not an integer.
theorem realNat.cell_interior (n : Nat) (X : Real)
  requires lower : realNat(n) < X
  requires upper : X < realNat(succ(n))
  shows ∀ k ∈ ℤ, X ≠ realInt(k)
proof
  have point := realInt.nat at n
  have step := realNat.successor at n
  have nReal := realNat.real at n
  have lowerInt : realInt(integerOfNat(n)) < X
    rw point
    exact lower
  have upperInt : X < R[realInt(integerOfNat(n)) + 1]
    rw point
    linarith
  exact realInt.not_between with lowerInt, upperInt

-- For m ≥ 1, on [n, n + 1]:
-- (m + 1) ∫ P̃ₘ h + ∫ P̃ₘ₊₁ h′ = Bₘ₊₁ (h(n + 1) − h(n)).
theorem eulerMaclaurin.cell_step (m n : Nat, h dh : Set)
  requires positive : 1 ≤ m
  requires derivative : DerivativeOn(h, dh, realNat(n), realNat(succ(n)))
  shows R[realNat(succ(m)) * riemannIntegral(pointwiseMul(periodicBernoulli(m),
      h), realNat(n), realNat(succ(n))) +
    riemannIntegral(pointwiseMul(periodicBernoulli(succ(m)), dh), realNat(n),
      realNat(succ(n)))] =
    R[bernoulli(succ(m)) * (h(realNat(succ(n))) - h(realNat(n)))]
proof
  have continuousH := DerivativeOn.continuous with derivative
  obtain ⟨functionH, functionD, pointwise, continuousD⟩ := derivative
  have nReal := realNat.real at n
  have step := realNat.successor at n
  have ordered : realNat(n) ≤ realNat(succ(n)) by linarith
  have subset : closedInterval(realNat(n), realNat(succ(n))) ⊆ ℝ
    intros X inside
    obtain ⟨xMember, _, _⟩ := closedInterval.membership.forward with inside
    exact xMember
  have large : 2 ≤ succ(m) by arith
  have continuousU := Continuous.continuous_on with
    (periodicBernoulli.continuous with large), subset
  have functionP := periodicBernoulli.function at m
  have functionNext := periodicBernoulli.function at succ(m)
  have scaleReal := realNat.real at succ(m)
  have functionScale := constantRealFunction.function at realNat(succ(m))
  have functionU := pointwiseMul.function with functionScale, functionP
  have derivativeU : ∀ X ∈ ℝ, realNat(n) < X → X < realNat(succ(n)) →
      HasDerivativeAt(periodicBernoulli(succ(m)),
        pointwiseMul(constantRealFunction(realNat(succ(m))),
          periodicBernoulli(m))(X), X)
    intros X xMember lower upper
    have xReal : Real(X) by exact xMember
    have valueP := FunctionBetween.apply_closed with functionP, xMember
    have realP : Real(periodicBernoulli(m)(X)) by exact valueP
    have constantReal : Real(constantRealFunction(realNat(succ(m)))(X))
      by typecheck
    have notInteger := realNat.cell_interior with lower, upper
    rw [(pointwiseMul.value at constantRealFunction(realNat(succ(m))),
        periodicBernoulli(m), X with functionScale, functionP, constantReal,
        realP), constantRealFunction.value]
    exact periodicBernoulli.derivative with notInteger
  have derivativeV : ∀ X ∈ ℝ, realNat(n) < X → X < realNat(succ(n)) →
      HasDerivativeAt(h, dh(X), X)
    intros X xMember lower upper
    have xReal : Real(X) by exact xMember
    have lowerLe := realLess.implies_le with lower
    have upperLe := realLess.implies_le with upper
    exact pointwise with X,
      (closedInterval.membership.backward with ⟨xMember, lowerLe, upperLe⟩)
  have integrableP := periodicBernoulli.cell_integrable at m, n, h with
    continuousH
  have functionPH := pointwiseMul.function at periodicBernoulli(m), h with
    functionP, functionH
  have functionUH := pointwiseMul.function at
    pointwiseMul(constantRealFunction(realNat(succ(m))), periodicBernoulli(m)),
    h with functionU, functionH
  have scaled : ∀ X ∈ ℝ, pointwiseMul(pointwiseMul(
      constantRealFunction(realNat(succ(m))), periodicBernoulli(m)), h)(X) =
      R[realNat(succ(m)) * pointwiseMul(periodicBernoulli(m), h)(X) +
        0 * pointwiseMul(periodicBernoulli(m), h)(X)]
    intros X xMember
    have xReal : Real(X) by exact xMember
    have valueP := FunctionBetween.apply_closed with functionP, xMember
    have valueH := FunctionBetween.apply_closed with functionH, xMember
    have realP : Real(periodicBernoulli(m)(X)) by exact valueP
    have realH : Real(h(X)) by exact valueH
    have constantReal : Real(constantRealFunction(realNat(succ(m)))(X))
      by typecheck
    have scaledReal : Real(pointwiseMul(constantRealFunction(realNat(succ(m))),
        periodicBernoulli(m))(X))
      have value := FunctionBetween.apply_closed with functionU, xMember
      exact value
    rw [(pointwiseMul.value at pointwiseMul(
        constantRealFunction(realNat(succ(m))), periodicBernoulli(m)), h, X with
        functionU, functionH, scaledReal, realH),
      (pointwiseMul.value at constantRealFunction(realNat(succ(m))),
        periodicBernoulli(m), X with functionScale, functionP, constantReal,
        realP),
      (pointwiseMul.value at periodicBernoulli(m), h, X with functionP,
        functionH, realP, realH),
      constantRealFunction.value]
    ring
  obtain ⟨integrableFirst, valueFirst⟩ := riemannIntegral.linear with
    integrableP, integrableP, functionUH, scaled
  have integrableSecond := periodicBernoulli.cell_integrable at succ(m), n, dh
    with continuousD
  have parts := riemannIntegral.by_parts with ordered, functionU, functionD,
    continuousU, continuousH, derivativeU, derivativeV, integrableFirst,
    integrableSecond
  have startInt := realInt.nat at n
  have endInt := realInt.nat at succ(n)
  have atStart := periodicBernoulli.at_integer at succ(m), integerOfNat(n)
  have atEnd := periodicBernoulli.at_integer at succ(m), integerOfNat(succ(n))
  rw startInt at atStart
  rw endInt at atEnd
  rw [valueFirst, atStart, atEnd] at parts
  obtain ⟨integralReal, _⟩ := riemannIntegral.selected at
    pointwiseMul(periodicBernoulli(m), h), realNat(n), realNat(succ(n))
  have zeroed : R[0 * riemannIntegral(pointwiseMul(periodicBernoulli(m), h),
    realNat(n), realNat(succ(n)))] = R[0] by ring
  have numberReal := bernoulli.real at succ(m)
  have nMember : realNat(n) ∈ ℝ by typecheck
  have nextMember : realNat(succ(n)) ∈ ℝ by typecheck
  have valueStart := FunctionBetween.apply_closed with functionH, nMember
  have valueEnd := FunctionBetween.apply_closed with functionH, nextMember
  have realStart : Real(h(realNat(n))) by exact valueStart
  have realEnd : Real(h(realNat(succ(n)))) by exact valueEnd
  obtain ⟨secondReal, _⟩ := riemannIntegral.selected at
    pointwiseMul(periodicBernoulli(succ(m)), dh), realNat(n), realNat(succ(n))
  have expand : R[bernoulli(succ(m)) * (h(realNat(succ(n))) - h(realNat(n)))] =
    R[bernoulli(succ(m)) * h(realNat(succ(n))) -
      bernoulli(succ(m)) * h(realNat(n))] by ring
  rw expand
  linarith

-- Section: The formula
-- The Euler–Maclaurin formula of order m ≥ 1 on [0, M].
theorem eulerMaclaurin (f : Set) (m M : Nat)
  requires positive : 1 ≤ m
  requires smooth : ContinuouslyDifferentiableOn(f, m, R[0], realNat(M))
  shows (∑ n < M, naturalValues(f)(n)) =
    R[riemannIntegral(f, R[0], realNat(M)) +
      (∑ k < m, eulerMaclaurinTerms(f, R[0], realNat(M))(k)) +
      (-1) ^ (m + 1) / realNat(m!) *
        riemannIntegral(pointwiseMul(periodicBernoulli(m),
          iteratedDerivative(f, m)), R[0], realNat(M))]
proof
  sorry

-- The remainder term is integrable.
theorem eulerMaclaurin.remainder_integrable (f : Set) (m M : Nat)
  requires positive : 1 ≤ m
  requires smooth : ContinuouslyDifferentiableOn(f, m, R[0], realNat(M))
  shows RiemannIntegrable(pointwiseMul(periodicBernoulli(m),
    iteratedDerivative(f, m)), R[0], realNat(M))
proof
  obtain ⟨_, _, continuous⟩ := smooth
  exact periodicBernoulli.prefix_integrable with continuous

-- Order 1: Σ_{n<M} f(n) = ∫_0^M f − (f(M) − f(0))/2 + ∫_0^M P̃₁ f′.
theorem eulerMaclaurin.order_one (f : Set) (M : Nat)
  requires smooth : ContinuouslyDifferentiableOn(f, 1, R[0], realNat(M))
  shows (∑ n < M, naturalValues(f)(n)) =
    R[riemannIntegral(f, R[0], realNat(M)) -
      (f(realNat(M)) - f(R[0])) / 2 +
      riemannIntegral(pointwiseMul(periodicBernoulli(1),
        iteratedDerivative(f, 1)), R[0], realNat(M))]
proof
  sorry

-- The formula for a complex function, applied to its real and imaginary
-- parts.
theorem eulerMaclaurin.complex (g : Set) (m M : Nat)
  requires positive : 1 ≤ m
  requires values : ComplexValuedOn(g, ℝ)
  requires smoothRe : ContinuouslyDifferentiableOn(complexFunctionRe(g), m,
    R[0], realNat(M))
  requires smoothIm : ContinuouslyDifferentiableOn(complexFunctionIm(g), m,
    R[0], realNat(M))
  shows complexPartialSum(complexNaturalValues(g), M) =
    ℂ[complexIntegral(g, R[0], realNat(M)) +
      complexPartialSum(complexEulerMaclaurinTerms(g, R[0], realNat(M)), m) +
      complexOfReal(R[(-1) ^ (m + 1) / realNat(m!)]) *
        complexIntegral(complexFunctionMul(complexPeriodicBernoulli(m),
          complexIteratedDeriv(g, m), ℝ), R[0], realNat(M))]
proof
  sorry

end EulerMaclaurin
