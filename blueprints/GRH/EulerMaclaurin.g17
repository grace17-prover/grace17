-- The Euler–Maclaurin summation formula. For f of class C^m on [0, M],
-- with M a natural number and m ≥ 1,
--   Σ_{n<M} f(n) = ∫_0^M f + Σ_{k=1}^{m} Bₖ/k! (f^(k−1)(M) − f^(k−1)(0))
--                  + (−1)^(m+1)/m! ∫_0^M P̃ₘ(x) f^(m)(x) dx,
-- with B₁ = −1/2 and P̃ₘ the periodic Bernoulli function; for real f, and
-- for complex functions of a real variable through their real and
-- imaginary parts.
-- Part of the GRH blueprint.
-- Planned home: Real/Analysis/EulerMaclaurin.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.EulerMaclaurin
import GRH.Integral
import GRH.Bernoulli
import Grace.Cumulus.Real.Analysis.Derivative

section EulerMaclaurin
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- Section: Definitions
-- f : ℝ → ℝ is of class C^m on [A, B]: f, f′, …, f^(m−1) are
-- differentiable at every point of [A, B] (two-sided, so f is defined
-- around the interval) and f^(m) is continuous on [A, B].
predicate ContinuouslyDifferentiableOn (f : Set, m : Nat, A B : Real) :=
  FunctionBetween(f, ℝ, ℝ) ∧
  (∀ k ∈ ℕ, k < m → ∀ X ∈ closedInterval(A, B),
    DifferentiableAt(iteratedDerivative(f, k), X)) ∧
  ContinuousOn(iteratedDerivative(f, m), closedInterval(A, B))

-- The values f(0), f(1), f(2), … as a sequence.
defgraph naturalValues (f : Set) (n ∈ ℕ) : ℝ := f(realNat(n))
requires function : FunctionBetween(f, ℝ, ℝ)
proof
  have typedN := nat.omega.backward with member
  have point := realNat.real at n
  have pointMember : realNat(n) ∈ ℝ by exact point
  exact FunctionBetween.apply_closed with function, pointMember

-- The terms B_{k+1}/(k+1)! (f^(k)(B) − f^(k)(A)), k = 0, 1, …, of the
-- boundary sum (the index k here is k − 1 in the displayed formula).
defgraph eulerMaclaurinTerms (f : Set, A B : Real) (k ∈ ℕ) : ℝ :=
    R[bernoulli(k + 1) / realNat((k + 1)!) *
      (iteratedDerivative(f, k)(B) - iteratedDerivative(f, k)(A))]
requires function : FunctionBetween(f, ℝ, ℝ)
proof
  have typedK := nat.omega.backward with member
  have derivativeFunction := iteratedDerivative.function at f, k with function
  have aMember : A ∈ ℝ by typecheck
  have bMember : B ∈ ℝ by typecheck
  have valueA := FunctionBetween.apply_closed with derivativeFunction, aMember
  have valueB := FunctionBetween.apply_closed with derivativeFunction, bMember
  have realA : Real(iteratedDerivative(f, k)(A)) by exact valueA
  have realB : Real(iteratedDerivative(f, k)(B)) by exact valueB
  have number := bernoulli.real at k + 1
  have factorialReal := realNat.real at (k + 1)!
  typecheck

-- Complex functions of a real variable: the values at the naturals, the
-- k-th derivative taken in the real and imaginary parts, and P̃ₘ as a
-- complex function.
defgraph complexNaturalValues (g : Set) (n ∈ ℕ) : complexCarrier :=
    g(realNat(n))
requires values : ComplexValuedOn(g, ℝ)
proof
  have typedN := nat.omega.backward with member
  have point := realNat.real at n
  have pointMember : realNat(n) ∈ ℝ by exact point
  exact values with realNat(n), pointMember

defgraph complexIteratedDeriv (g : Set, k : Nat) (X ∈ ℝ) : complexCarrier :=
    (iteratedDerivative(complexFunctionRe(g), k)(X),
      iteratedDerivative(complexFunctionIm(g), k)(X))
requires values : ComplexValuedOn(g, ℝ)
proof
  have functionRe := complexFunctionRe.function with values
  have functionIm := complexFunctionIm.function with values
  have derivativeRe := iteratedDerivative.function at complexFunctionRe(g), k
    with functionRe
  have derivativeIm := iteratedDerivative.function at complexFunctionIm(g), k
    with functionIm
  have valueRe := FunctionBetween.apply_closed with derivativeRe, member
  have valueIm := FunctionBetween.apply_closed with derivativeIm, member
  have realRe : Real(iteratedDerivative(complexFunctionRe(g), k)(X))
    by exact valueRe
  have realIm : Real(iteratedDerivative(complexFunctionIm(g), k)(X))
    by exact valueIm
  exact complexCarrier.pair at iteratedDerivative(complexFunctionRe(g), k)(X),
    iteratedDerivative(complexFunctionIm(g), k)(X)

defgraph complexPeriodicBernoulli (m : Nat) (X ∈ ℝ) : complexCarrier :=
    complexOfReal(periodicBernoulli(m)(X))
proof
  have function := periodicBernoulli.function at m
  have value := FunctionBetween.apply_closed with function, member
  have valueReal : Real(periodicBernoulli(m)(X)) by exact value
  typecheck

defgraph complexEulerMaclaurinTerms (g : Set, A B : Real) (k ∈ ℕ) :
    complexCarrier :=
  ℂ[complexOfReal(R[bernoulli(k + 1) / realNat((k + 1)!)]) *
    (complexIteratedDeriv(g, k)(B) - complexIteratedDeriv(g, k)(A))]
requires values : ComplexValuedOn(g, ℝ)
proof
  have typedK := nat.omega.backward with member
  have aMember : A ∈ ℝ by typecheck
  have bMember : B ∈ ℝ by typecheck
  have derivativeFunction := complexIteratedDeriv.function at g, k with values
  have valueA := FunctionBetween.apply_closed with derivativeFunction, aMember
  have valueB := FunctionBetween.apply_closed with derivativeFunction, bMember
  have number := bernoulli.real at k + 1
  have factorialReal := realNat.real at (k + 1)!
  have coefficient : Real(R[bernoulli(k + 1) / realNat((k + 1)!)]) by typecheck
  typecheck

-- Section: Integration by parts
-- ∫ u V + ∫ U v = U V |_A^B when U′ = u and V′ = v inside (A, B).
theorem riemannIntegral.by_parts (U u V v : Set) (A B : Real)
  requires ordered : A ≤ B
  requires functionDU : u : ℝ → ℝ
  requires functionDV : v : ℝ → ℝ
  requires continuousU : ContinuousOn(U, closedInterval(A, B))
  requires continuousV : ContinuousOn(V, closedInterval(A, B))
  requires derivativeU : ∀ X ∈ ℝ, A < X → X < B → HasDerivativeAt(U, u(X), X)
  requires derivativeV : ∀ X ∈ ℝ, A < X → X < B → HasDerivativeAt(V, v(X), X)
  requires integrableFirst : RiemannIntegrable(pointwiseMul(u, V), A, B)
  requires integrableSecond : RiemannIntegrable(pointwiseMul(U, v), A, B)
  shows R[riemannIntegral(pointwiseMul(u, V), A, B) +
      riemannIntegral(pointwiseMul(U, v), A, B)] = R[U(B) * V(B) - U(A) * V(A)]
proof
  have continuousUCopy : ContinuousOn(U, closedInterval(A, B))
    by exact continuousU
  have continuousVCopy : ContinuousOn(V, closedInterval(A, B))
    by exact continuousV
  obtain ⟨functionU, _, _⟩ := continuousUCopy
  obtain ⟨functionV, _, _⟩ := continuousVCopy
  have functionFirst := pointwiseMul.function at u, V with functionDU,
    functionV
  have functionSecond := pointwiseMul.function at U, v with functionU,
    functionDV
  have functionSum := realLinearCombination.function at R[1], R[1],
    pointwiseMul(u, V), pointwiseMul(U, v) with functionFirst, functionSecond
  have valuesSum : ∀ X ∈ ℝ, realLinearCombination(R[1], R[1],
      pointwiseMul(u, V), pointwiseMul(U, v))(X) =
      R[1 * pointwiseMul(u, V)(X) + 1 * pointwiseMul(U, v)(X)]
    intros X xMember
    exact realLinearCombination.value with functionFirst, functionSecond,
      xMember
  have integralSum := HasRiemannIntegral.linear with
    (riemannIntegral.integral with integrableFirst),
    (riemannIntegral.integral with integrableSecond), functionSum, valuesSum
  have continuousW := ContinuousOn.mul with continuousU, continuousV
  have derivativeW : ∀ X ∈ ℝ, A < X → X < B → HasDerivativeAt(
      pointwiseMul(U, V), realLinearCombination(R[1], R[1],
        pointwiseMul(u, V), pointwiseMul(U, v))(X), X)
    intros X xMember lower upper
    have xReal : Real(X) by exact xMember
    have valueU := FunctionBetween.apply_closed with functionU, xMember
    have valueV := FunctionBetween.apply_closed with functionV, xMember
    have valueDU := FunctionBetween.apply_closed with functionDU, xMember
    have valueDV := FunctionBetween.apply_closed with functionDV, xMember
    have realU : Real(U(X)) by exact valueU
    have realV : Real(V(X)) by exact valueV
    have realDU : Real(u(X)) by exact valueDU
    have realDV : Real(v(X)) by exact valueDV
    have product := HasDerivativeAt.mul_value with
      (derivativeU with X, xMember, lower, upper),
      (derivativeV with X, xMember, lower, upper), realU, realV
    apply HasDerivativeAt.congr_value with product
    rw [(valuesSum with X, xMember),
      (pointwiseMul.value at u, V, X with functionDU, functionV, realDU, realV),
      (pointwiseMul.value at U, v, X with functionU, functionDV, realU, realDV)]
    ring
  have value := HasRiemannIntegral.eq_endpoint_of_local_derivative with
    continuousW, derivativeW, integralSum
  have aMember : A ∈ ℝ by typecheck
  have bMember : B ∈ ℝ by typecheck
  have valueUA := FunctionBetween.apply_closed with functionU, aMember
  have valueVA := FunctionBetween.apply_closed with functionV, aMember
  have valueUB := FunctionBetween.apply_closed with functionU, bMember
  have valueVB := FunctionBetween.apply_closed with functionV, bMember
  have realUA : Real(U(A)) by exact valueUA
  have realVA : Real(V(A)) by exact valueVA
  have realUB : Real(U(B)) by exact valueUB
  have realVB : Real(V(B)) by exact valueVB
  rw [(pointwiseMul.value at U, V, B with functionU, functionV, realUB, realVB),
    (pointwiseMul.value at U, V, A with functionU, functionV, realUA, realVA)]
    at value
  obtain ⟨firstReal, _⟩ := riemannIntegral.selected at pointwiseMul(u, V), A, B
  obtain ⟨secondReal, _⟩ := riemannIntegral.selected at pointwiseMul(U, v), A, B
  unfold realSubValue at value
  have shape : R[1 * riemannIntegral(pointwiseMul(u, V), A, B) +
      1 * riemannIntegral(pointwiseMul(U, v), A, B)] =
    R[riemannIntegral(pointwiseMul(u, V), A, B) +
      riemannIntegral(pointwiseMul(U, v), A, B)] by ring
  rw ← shape
  exact value

-- Section: Cells of the integer partition
-- Inside the cell [n, n + 1], P̃ₘ is the translate x ↦ Bₘ(x − n).
theorem periodicBernoulli.cell_agree (m n : Nat)
  shows ∀ X ∈ ℝ, realNat(n) < X → X < realNat(succ(n)) →
    periodicBernoulli(m)(X) = bernoulliTranslate(m, R[-realNat(n)])(X)
proof
  intros X xMember lower upper
  have xReal : Real(X) by exact xMember
  have point := realInt.nat at n
  have nReal := realNat.real at n
  have step := realNat.successor at n
  have lowerLe : realInt(integerOfNat(n)) ≤ X
    rw point
    exact realLess.implies_le with lower
  have upperLt : X < R[realInt(integerOfNat(n)) + 1]
    rw point
    linarith
  rw (periodicBernoulli.eq_right with lowerLe, upperLt)
  rw point

-- P̃ₘ h is integrable on [n, n + 1] for h continuous there.
theorem periodicBernoulli.cell_integrable (m n : Nat, h : Set)
  requires continuous : ContinuousOn(h,
    closedInterval(realNat(n), realNat(succ(n))))
  shows RiemannIntegrable(pointwiseMul(periodicBernoulli(m), h), realNat(n),
    realNat(succ(n)))
proof
  have continuousCopy : ContinuousOn(h,
      closedInterval(realNat(n), realNat(succ(n)))) by exact continuous
  obtain ⟨functionH, subset, _⟩ := continuousCopy
  have functionP := periodicBernoulli.function at m
  have translateFunction := bernoulliTranslate.function at m, R[-realNat(n)]
  have product := pointwiseMul.function with functionP, functionH
  have translateContinuous := Continuous.continuous_on with
    (bernoulliTranslate.continuous at m, R[-realNat(n)]), subset
  have continuousProduct := ContinuousOn.mul with translateContinuous,
    continuous
  have nReal := realNat.real at n
  have step := realNat.successor at n
  have ordered : realNat(n) ≤ realNat(succ(n)) by linarith
  have cellAgree := periodicBernoulli.cell_agree at m, n
  have agree : ∀ X ∈ ℝ, realNat(n) < X → X < realNat(succ(n)) →
      pointwiseMul(periodicBernoulli(m), h)(X) =
        pointwiseMul(bernoulliTranslate(m, R[-realNat(n)]), h)(X)
    intros X xMember lower upper
    have xReal : Real(X) by exact xMember
    have valueP := FunctionBetween.apply_closed with functionP, xMember
    have valueT := FunctionBetween.apply_closed with translateFunction, xMember
    have valueH := FunctionBetween.apply_closed with functionH, xMember
    have realP : Real(periodicBernoulli(m)(X)) by exact valueP
    have realT : Real(bernoulliTranslate(m, R[-realNat(n)])(X)) by exact valueT
    have realH : Real(h(X)) by exact valueH
    rw [(pointwiseMul.value at periodicBernoulli(m), h, X with functionP,
        functionH, realP, realH),
      (pointwiseMul.value at bernoulliTranslate(m, R[-realNat(n)]), h, X with
        translateFunction, functionH, realT, realH),
      (cellAgree with X, xMember, lower, upper)]
  have integral := HasRiemannIntegral.of_continuous_interior with product,
    ordered, continuousProduct, agree
  obtain ⟨value, _⟩ := riemannIntegral.selected at
    pointwiseMul(bernoulliTranslate(m, R[-realNat(n)]), h), realNat(n),
    realNat(succ(n))
  exact ⟨riemannIntegral(pointwiseMul(bernoulliTranslate(m, R[-realNat(n)]), h),
    realNat(n), realNat(succ(n))), value, integral⟩

-- P̃ₘ h is integrable on [0, M] for h continuous there.
theorem periodicBernoulli.prefix_integrable (m : Nat, h : Set) (M : Nat)
  shows ContinuousOn(h, closedInterval(R[0], realNat(M))) →
    RiemannIntegrable(pointwiseMul(periodicBernoulli(m), h), R[0], realNat(M))
proof
  induction M
  | zero =>
    intro continuous
    obtain ⟨functionH, _, _⟩ := continuous
    have functionP := periodicBernoulli.function at m
    have product := pointwiseMul.function with functionP, functionH
    rw realNat.zero
    exact RiemannIntegrable.point with product
  | succ(k) using ih =>
    intro continuous
    have kReal := realNat.real at k
    have nonnegative := realNat.nonnegative at k
    have step := realNat.successor at k
    have reflexiveZero : R[0] ≤ R[0] by linarith
    have before : realNat(k) ≤ realNat(succ(k)) by linarith
    have reflexiveEnd : realNat(succ(k)) ≤ realNat(succ(k)) by linarith
    have left := ContinuousOn.subinterval with continuous, reflexiveZero, before
    have right := ContinuousOn.subinterval with continuous, nonnegative,
      reflexiveEnd
    have prefix := ih with left
    have cell := periodicBernoulli.cell_integrable at m, k, h with right
    exact RiemannIntegrable.adjacent with prefix, cell

-- Section: One cell of the formula
-- h′ is a continuous derivative of h on [A, B].
predicate DerivativeOn (h dh : Set, A B : Real) :=
  FunctionBetween(h, ℝ, ℝ) ∧ FunctionBetween(dh, ℝ, ℝ) ∧
  (∀ X ∈ closedInterval(A, B), HasDerivativeAt(h, dh(X), X)) ∧
  ContinuousOn(dh, closedInterval(A, B))

theorem DerivativeOn.continuous (h dh : Set) (A B : Real)
  requires derivative : DerivativeOn(h, dh, A, B)
  shows ContinuousOn(h, closedInterval(A, B))
proof
  obtain ⟨function, functionD, pointwise, _⟩ := derivative
  have subset : closedInterval(A, B) ⊆ ℝ
    intros X inside
    obtain ⟨xMember, _, _⟩ := closedInterval.membership.forward with inside
    exact xMember
  apply ContinuousOn.of_differentiable with function, subset
  intros X inside
  obtain ⟨xMember, _, _⟩ := closedInterval.membership.forward with inside
  have xReal : Real(X) by exact xMember
  have valueD := FunctionBetween.apply_closed with functionD, xMember
  have realD : Real(dh(X)) by exact valueD
  exact HasDerivativeAt.differentiable_at with (pointwise with X, inside)

theorem DerivativeOn.restrict (h dh : Set) (A B X Y : Real)
  requires derivative : DerivativeOn(h, dh, A, B)
  requires left : A ≤ X
  requires right : Y ≤ B
  shows DerivativeOn(h, dh, X, Y)
proof
  obtain ⟨function, functionD, pointwise, continuous⟩ := derivative
  refine ⟨function, functionD, ?_, ?_⟩
  . intros Z inside
    obtain ⟨zMember, lower, upper⟩ := closedInterval.membership.forward with
      inside
    have zReal : Real(Z) by exact zMember
    have lowerA : A ≤ Z by linarith
    have upperB : Z ≤ B by linarith
    exact pointwise with Z,
      (closedInterval.membership.backward with ⟨zMember, lowerA, upperB⟩)
  . exact ContinuousOn.subinterval with continuous, left, right

-- A point strictly inside [n, n + 1] is not an integer.
theorem realNat.cell_interior (n : Nat) (X : Real)
  requires lower : realNat(n) < X
  requires upper : X < realNat(succ(n))
  shows ∀ k ∈ ℤ, X ≠ realInt(k)
proof
  have point := realInt.nat at n
  have step := realNat.successor at n
  have nReal := realNat.real at n
  have lowerInt : realInt(integerOfNat(n)) < X
    rw point
    exact lower
  have upperInt : X < R[realInt(integerOfNat(n)) + 1]
    rw point
    linarith
  exact realInt.not_between with lowerInt, upperInt

-- For m ≥ 1, on [n, n + 1]:
-- (m + 1) ∫ P̃ₘ h + ∫ P̃ₘ₊₁ h′ = Bₘ₊₁ (h(n + 1) − h(n)).
theorem eulerMaclaurin.cell_step (m n : Nat, h dh : Set)
  requires positive : 1 ≤ m
  requires derivative : DerivativeOn(h, dh, realNat(n), realNat(succ(n)))
  shows R[realNat(succ(m)) * riemannIntegral(pointwiseMul(periodicBernoulli(m),
      h), realNat(n), realNat(succ(n))) +
    riemannIntegral(pointwiseMul(periodicBernoulli(succ(m)), dh), realNat(n),
      realNat(succ(n)))] =
    R[bernoulli(succ(m)) * (h(realNat(succ(n))) - h(realNat(n)))]
proof
  have continuousH := DerivativeOn.continuous with derivative
  obtain ⟨functionH, functionD, pointwise, continuousD⟩ := derivative
  have nReal := realNat.real at n
  have step := realNat.successor at n
  have ordered : realNat(n) ≤ realNat(succ(n)) by linarith
  have subset : closedInterval(realNat(n), realNat(succ(n))) ⊆ ℝ
    intros X inside
    obtain ⟨xMember, _, _⟩ := closedInterval.membership.forward with inside
    exact xMember
  have large : 2 ≤ succ(m) by arith
  have continuousU := Continuous.continuous_on with
    (periodicBernoulli.continuous with large), subset
  have functionP := periodicBernoulli.function at m
  have functionNext := periodicBernoulli.function at succ(m)
  have scaleReal := realNat.real at succ(m)
  have functionScale := constantRealFunction.function at realNat(succ(m))
  have functionU := pointwiseMul.function with functionScale, functionP
  have derivativeU : ∀ X ∈ ℝ, realNat(n) < X → X < realNat(succ(n)) →
      HasDerivativeAt(periodicBernoulli(succ(m)),
        pointwiseMul(constantRealFunction(realNat(succ(m))),
          periodicBernoulli(m))(X), X)
    intros X xMember lower upper
    have xReal : Real(X) by exact xMember
    have valueP := FunctionBetween.apply_closed with functionP, xMember
    have realP : Real(periodicBernoulli(m)(X)) by exact valueP
    have constantReal : Real(constantRealFunction(realNat(succ(m)))(X))
      by typecheck
    have notInteger := realNat.cell_interior with lower, upper
    rw [(pointwiseMul.value at constantRealFunction(realNat(succ(m))),
        periodicBernoulli(m), X with functionScale, functionP, constantReal,
        realP), constantRealFunction.value]
    exact periodicBernoulli.derivative with notInteger
  have derivativeV : ∀ X ∈ ℝ, realNat(n) < X → X < realNat(succ(n)) →
      HasDerivativeAt(h, dh(X), X)
    intros X xMember lower upper
    have xReal : Real(X) by exact xMember
    have lowerLe := realLess.implies_le with lower
    have upperLe := realLess.implies_le with upper
    exact pointwise with X,
      (closedInterval.membership.backward with ⟨xMember, lowerLe, upperLe⟩)
  have integrableP := periodicBernoulli.cell_integrable at m, n, h with
    continuousH
  have functionPH := pointwiseMul.function at periodicBernoulli(m), h with
    functionP, functionH
  have functionUH := pointwiseMul.function at
    pointwiseMul(constantRealFunction(realNat(succ(m))), periodicBernoulli(m)),
    h with functionU, functionH
  have scaled : ∀ X ∈ ℝ, pointwiseMul(pointwiseMul(
      constantRealFunction(realNat(succ(m))), periodicBernoulli(m)), h)(X) =
      R[realNat(succ(m)) * pointwiseMul(periodicBernoulli(m), h)(X) +
        0 * pointwiseMul(periodicBernoulli(m), h)(X)]
    intros X xMember
    have xReal : Real(X) by exact xMember
    have valueP := FunctionBetween.apply_closed with functionP, xMember
    have valueH := FunctionBetween.apply_closed with functionH, xMember
    have realP : Real(periodicBernoulli(m)(X)) by exact valueP
    have realH : Real(h(X)) by exact valueH
    have constantReal : Real(constantRealFunction(realNat(succ(m)))(X))
      by typecheck
    have scaledReal : Real(pointwiseMul(constantRealFunction(realNat(succ(m))),
        periodicBernoulli(m))(X))
      have value := FunctionBetween.apply_closed with functionU, xMember
      exact value
    rw [(pointwiseMul.value at pointwiseMul(
        constantRealFunction(realNat(succ(m))), periodicBernoulli(m)), h, X with
        functionU, functionH, scaledReal, realH),
      (pointwiseMul.value at constantRealFunction(realNat(succ(m))),
        periodicBernoulli(m), X with functionScale, functionP, constantReal,
        realP),
      (pointwiseMul.value at periodicBernoulli(m), h, X with functionP,
        functionH, realP, realH),
      constantRealFunction.value]
    ring
  obtain ⟨integrableFirst, valueFirst⟩ := riemannIntegral.linear with
    integrableP, integrableP, functionUH, scaled
  have integrableSecond := periodicBernoulli.cell_integrable at succ(m), n, dh
    with continuousD
  have parts := riemannIntegral.by_parts with ordered, functionU, functionD,
    continuousU, continuousH, derivativeU, derivativeV, integrableFirst,
    integrableSecond
  have startInt := realInt.nat at n
  have endInt := realInt.nat at succ(n)
  have atStart := periodicBernoulli.at_integer at succ(m), integerOfNat(n)
  have atEnd := periodicBernoulli.at_integer at succ(m), integerOfNat(succ(n))
  rw startInt at atStart
  rw endInt at atEnd
  rw [valueFirst, atStart, atEnd] at parts
  obtain ⟨integralReal, _⟩ := riemannIntegral.selected at
    pointwiseMul(periodicBernoulli(m), h), realNat(n), realNat(succ(n))
  have zeroed : R[0 * riemannIntegral(pointwiseMul(periodicBernoulli(m), h),
    realNat(n), realNat(succ(n)))] = R[0] by ring
  have numberReal := bernoulli.real at succ(m)
  have nMember : realNat(n) ∈ ℝ by typecheck
  have nextMember : realNat(succ(n)) ∈ ℝ by typecheck
  have valueStart := FunctionBetween.apply_closed with functionH, nMember
  have valueEnd := FunctionBetween.apply_closed with functionH, nextMember
  have realStart : Real(h(realNat(n))) by exact valueStart
  have realEnd : Real(h(realNat(succ(n)))) by exact valueEnd
  obtain ⟨secondReal, _⟩ := riemannIntegral.selected at
    pointwiseMul(periodicBernoulli(succ(m)), dh), realNat(n), realNat(succ(n))
  have expand : R[bernoulli(succ(m)) * (h(realNat(succ(n))) - h(realNat(n)))] =
    R[bernoulli(succ(m)) * h(realNat(succ(n))) -
      bernoulli(succ(m)) * h(realNat(n))] by ring
  rw expand
  linarith

-- On [n, n + 1]: ∫ f + ∫ P̃₁ f′ = (f(n) + f(n + 1))/2.
theorem eulerMaclaurin.cell_one (n : Nat, f df : Set)
  requires derivative : DerivativeOn(f, df, realNat(n), realNat(succ(n)))
  shows R[riemannIntegral(f, realNat(n), realNat(succ(n))) +
    riemannIntegral(pointwiseMul(periodicBernoulli(1), df), realNat(n),
      realNat(succ(n)))] = R[(f(realNat(n)) + f(realNat(succ(n)))) / 2]
proof
  have continuousF := DerivativeOn.continuous with derivative
  obtain ⟨functionF, functionD, pointwise, continuousD⟩ := derivative
  have nReal := realNat.real at n
  have step := realNat.successor at n
  have ordered : realNat(n) ≤ realNat(succ(n)) by linarith
  have subset : closedInterval(realNat(n), realNat(succ(n))) ⊆ ℝ
    intros X inside
    obtain ⟨xMember, _, _⟩ := closedInterval.membership.forward with inside
    exact xMember
  have functionT := bernoulliTranslate.function at (1:N), R[-realNat(n)]
  have continuousU := Continuous.continuous_on with
    (bernoulliTranslate.continuous at (1:N), R[-realNat(n)]), subset
  have functionOne := constantRealFunction.function at R[1]
  have derivativeU : ∀ X ∈ ℝ, realNat(n) < X → X < realNat(succ(n)) →
      HasDerivativeAt(bernoulliTranslate(1, R[-realNat(n)]),
        constantRealFunction(R[1])(X), X)
    intros X xMember lower upper
    have xReal : Real(X) by exact xMember
    have translate := bernoulliTranslate.derivative at 0, R[-realNat(n)], X
    apply HasDerivativeAt.congr_value with translate
    rw [constantRealFunction.value, bernoulliPolynomial.zero_index,
      realNat.one]
    ring
  have derivativeV : ∀ X ∈ ℝ, realNat(n) < X → X < realNat(succ(n)) →
      HasDerivativeAt(f, df(X), X)
    intros X xMember lower upper
    have xReal : Real(X) by exact xMember
    have lowerLe := realLess.implies_le with lower
    have upperLe := realLess.implies_le with upper
    exact pointwise with X,
      (closedInterval.membership.backward with ⟨xMember, lowerLe, upperLe⟩)
  have integrableF := ContinuousOn.integrable_interval with ordered,
    continuousF
  have functionOneF := pointwiseMul.function at constantRealFunction(R[1]), f
    with functionOne, functionF
  have scaled : ∀ X ∈ ℝ, pointwiseMul(constantRealFunction(R[1]), f)(X) =
      R[1 * f(X) + 0 * f(X)]
    intros X xMember
    have xReal : Real(X) by exact xMember
    have valueF := FunctionBetween.apply_closed with functionF, xMember
    have realF : Real(f(X)) by exact valueF
    have constantReal : Real(constantRealFunction(R[1])(X)) by typecheck
    rw [(pointwiseMul.value at constantRealFunction(R[1]), f, X with
        functionOne, functionF, constantReal, realF), constantRealFunction.value]
    ring
  obtain ⟨integrableFirst, valueFirst⟩ := riemannIntegral.linear with
    integrableF, integrableF, functionOneF, scaled
  have continuousProduct := ContinuousOn.mul with continuousU, continuousD
  have integrableSecond := ContinuousOn.integrable_interval with ordered,
    continuousProduct
  have parts := riemannIntegral.by_parts with ordered, functionOne, functionD,
    continuousU, continuousF, derivativeU, derivativeV, integrableFirst,
    integrableSecond
  -- On the open cell, P̃₁ f′ agrees with the translate times f′.
  have functionP := periodicBernoulli.function at (1:N)
  have functionPD := pointwiseMul.function at periodicBernoulli(1), df with
    functionP, functionD
  have cellAgree := periodicBernoulli.cell_agree at (1:N), n
  have agree : ∀ X ∈ ℝ, realNat(n) < X → X < realNat(succ(n)) →
      pointwiseMul(periodicBernoulli(1), df)(X) =
        pointwiseMul(bernoulliTranslate(1, R[-realNat(n)]), df)(X)
    intros X xMember lower upper
    have xReal : Real(X) by exact xMember
    have valueP := FunctionBetween.apply_closed with functionP, xMember
    have valueT := FunctionBetween.apply_closed with functionT, xMember
    have valueD := FunctionBetween.apply_closed with functionD, xMember
    have realP : Real(periodicBernoulli(1)(X)) by exact valueP
    have realT : Real(bernoulliTranslate(1, R[-realNat(n)])(X)) by exact valueT
    have realD : Real(df(X)) by exact valueD
    rw [(pointwiseMul.value at periodicBernoulli(1), df, X with functionP,
        functionD, realP, realD),
      (pointwiseMul.value at bernoulliTranslate(1, R[-realNat(n)]), df, X with
        functionT, functionD, realT, realD),
      (cellAgree with X, xMember, lower, upper)]
  have sameIntegral := HasRiemannIntegral.of_continuous_interior with
    functionPD, ordered, continuousProduct, agree
  rw riemannIntegral.eq_of_integral with sameIntegral
  rw valueFirst at parts
  rw step at parts
  rw step
  have endValue : bernoulliTranslate(1, R[-realNat(n)])(R[realNat(n) + 1]) =
      R[1 / 2]
    rw [bernoulliTranslate.value, bernoulliPolynomial.one_index]
    unfold realSubValue
    ring
  have startValue : bernoulliTranslate(1, R[-realNat(n)])(realNat(n)) =
      R[-(1 / 2)]
    rw [bernoulliTranslate.value, bernoulliPolynomial.one_index]
    unfold realSubValue
    ring
  rw [endValue, startValue] at parts
  obtain ⟨integralReal, _⟩ := riemannIntegral.selected at f, realNat(n),
    R[realNat(n) + 1]
  obtain ⟨secondReal, _⟩ := riemannIntegral.selected at
    pointwiseMul(bernoulliTranslate(1, R[-realNat(n)]), df), realNat(n),
    R[realNat(n) + 1]
  have nMember : realNat(n) ∈ ℝ by typecheck
  have nextMember : R[realNat(n) + 1] ∈ ℝ by typecheck
  have valueStart := FunctionBetween.apply_closed with functionF, nMember
  have valueEnd := FunctionBetween.apply_closed with functionF, nextMember
  have realStart : Real(f(realNat(n))) by exact valueStart
  have realEnd : Real(f(R[realNat(n) + 1])) by exact valueEnd
  have right : R[1 / 2 * f(R[realNat(n) + 1]) - (-(1 / 2)) * f(realNat(n))] =
    R[(f(realNat(n)) + f(R[realNat(n) + 1])) / 2] by ring
  have left : R[1 * riemannIntegral(f, realNat(n), R[realNat(n) + 1]) +
      0 * riemannIntegral(f, realNat(n), R[realNat(n) + 1]) +
      riemannIntegral(pointwiseMul(bernoulliTranslate(1, R[-realNat(n)]), df),
        realNat(n), R[realNat(n) + 1])] =
    R[riemannIntegral(f, realNat(n), R[realNat(n) + 1]) +
      riemannIntegral(pointwiseMul(bernoulliTranslate(1, R[-realNat(n)]), df),
        realNat(n), R[realNat(n) + 1])] by ring
  rw [left, right] at parts
  exact parts

-- Section: Summing over the cells
-- The sum realAddValue is the ring sum.
theorem realAddValue.eq_add (A B : Real)
  shows realAddValue(A, B) = R[A + B]
proof
  unfold realAddValue
  unfold call2
  rfl

-- Integrals over adjacent intervals add, for integrable functions.
theorem riemannIntegral.adjacent (f : Set) (A B C : Real)
  requires left : RiemannIntegrable(f, A, B)
  requires right : RiemannIntegrable(f, B, C)
  shows RiemannIntegrable(f, A, C) ∧
    riemannIntegral(f, A, C) = R[riemannIntegral(f, A, B) + riemannIntegral(f, B, C)]
proof
  have whole := RiemannIntegrable.adjacent with left, right
  refine ⟨whole, ?_⟩
  exact HasRiemannIntegral.adjacent_sum with
    (riemannIntegral.integral with left), (riemannIntegral.integral with right),
    (riemannIntegral.integral with whole)

-- Over a single point every integral is 0.
theorem riemannIntegral.point (f : Set) (A : Real)
  requires function : f : ℝ → ℝ
  shows riemannIntegral(f, A, A) = R[0]
proof
  exact riemannIntegral.eq_of_integral with
    (HasRiemannIntegral.point with function)

-- Splitting the hypotheses at the last cell.
theorem DerivativeOn.last_cell (h dh : Set) (k : Nat)
  requires derivative : DerivativeOn(h, dh, R[0], realNat(succ(k)))
  shows DerivativeOn(h, dh, R[0], realNat(k)) ∧
    DerivativeOn(h, dh, realNat(k), realNat(succ(k)))
proof
  have kReal := realNat.real at k
  have nonnegative := realNat.nonnegative at k
  have step := realNat.successor at k
  have reflexiveZero : R[0] ≤ R[0] by linarith
  have before : realNat(k) ≤ realNat(succ(k)) by linarith
  have reflexiveEnd : realNat(succ(k)) ≤ realNat(succ(k)) by linarith
  constructor
  . exact DerivativeOn.restrict with derivative, reflexiveZero, before
  . exact DerivativeOn.restrict with derivative, nonnegative, reflexiveEnd

-- Order one on [0, M]: ∫ f + ∫ P̃₁ f′ = Σ_{n<M} f(n) + (f(M) − f(0))/2.
theorem eulerMaclaurin.prefix_one (f df : Set) (M : Nat)
  shows DerivativeOn(f, df, R[0], realNat(M)) →
    RiemannIntegrable(f, R[0], realNat(M)) ∧
    RiemannIntegrable(pointwiseMul(periodicBernoulli(1), df), R[0],
      realNat(M)) ∧
    R[riemannIntegral(f, R[0], realNat(M)) +
      riemannIntegral(pointwiseMul(periodicBernoulli(1), df), R[0],
        realNat(M))] =
      R[(∑ n < M, naturalValues(f)(n)) + (f(realNat(M)) - f(R[0])) / 2]
proof
  induction M
  | zero =>
    intro derivative
    obtain ⟨functionF, functionD, _, _⟩ := derivative
    have functionP := periodicBernoulli.function at (1:N)
    have product := pointwiseMul.function at periodicBernoulli(1), df with
      functionP, functionD
    rw realNat.zero
    refine ⟨(RiemannIntegrable.point with functionF),
      (RiemannIntegrable.point with product), ?_⟩
    rw [(riemannIntegral.point with functionF),
      (riemannIntegral.point with product), realPartialSum.zero]
    have zeroMember : R[0] ∈ ℝ by typecheck
    have valueZero := FunctionBetween.apply_closed with functionF, zeroMember
    have realZeroValue : Real(f(R[0])) by exact valueZero
    ring
  | succ(k) using ih =>
    intro derivative
    obtain ⟨prefix, cell⟩ := DerivativeOn.last_cell with derivative
    obtain ⟨integrableF, integrableP, previous⟩ := ih with prefix
    have cellIdentity := eulerMaclaurin.cell_one with cell
    have continuousCell := DerivativeOn.continuous with cell
    have derivativeCopy : DerivativeOn(f, df, realNat(k), realNat(succ(k)))
      by exact cell
    obtain ⟨functionF, functionD, _, continuousD⟩ := derivativeCopy
    have kReal := realNat.real at k
    have step := realNat.successor at k
    have before : realNat(k) ≤ realNat(succ(k)) by linarith
    have cellF := ContinuousOn.integrable_interval with before, continuousCell
    have cellP := periodicBernoulli.cell_integrable at (1:N), k, df with
      continuousD
    obtain ⟨wholeF, splitF⟩ := riemannIntegral.adjacent with integrableF, cellF
    obtain ⟨wholeP, splitP⟩ := riemannIntegral.adjacent with integrableP, cellP
    refine ⟨wholeF, wholeP, ?_⟩
    have sequence : RealSequence(naturalValues(f))
      unfold RealSequence
      exact naturalValues.function with functionF
    have sumReal := realPartialSum.real at naturalValues(f), k with sequence
    have kNatural := nat.omega.forward at k with assumption
    rw [splitF, splitP, realPartialSum.succ,
      (naturalValues.value with functionF, kNatural)]
    obtain ⟨first, _⟩ := riemannIntegral.selected at f, R[0], realNat(k)
    obtain ⟨second, _⟩ := riemannIntegral.selected at f, realNat(k),
      realNat(succ(k))
    obtain ⟨third, _⟩ := riemannIntegral.selected at
      pointwiseMul(periodicBernoulli(1), df), R[0], realNat(k)
    obtain ⟨fourth, _⟩ := riemannIntegral.selected at
      pointwiseMul(periodicBernoulli(1), df), realNat(k), realNat(succ(k))
    have zeroMember : R[0] ∈ ℝ by typecheck
    have kMember : realNat(k) ∈ ℝ by typecheck
    have nextMember : realNat(succ(k)) ∈ ℝ by typecheck
    have valueZero := FunctionBetween.apply_closed with functionF, zeroMember
    have valueK := FunctionBetween.apply_closed with functionF, kMember
    have valueNext := FunctionBetween.apply_closed with functionF, nextMember
    have realZeroValue : Real(f(R[0])) by exact valueZero
    have realK : Real(f(realNat(k))) by exact valueK
    have realNext : Real(f(realNat(succ(k)))) by exact valueNext
    linarith

-- C^m on [0, M] gives a continuous derivative f^(k+1) of f^(k) for k < m.
theorem ContinuouslyDifferentiableOn.derivative_on (f : Set) (m k : Nat)
    (A B : Real)
  requires smooth : ContinuouslyDifferentiableOn(f, m, A, B)
  requires below : k < m
  shows DerivativeOn(iteratedDerivative(f, k), iteratedDerivative(f, succ(k)),
    A, B)
proof
  obtain ⟨function, differentiable, continuous⟩ := smooth
  have functionK := iteratedDerivative.function at f, k with function
  have functionNext := iteratedDerivative.function at f, succ(k) with function
  have kNatural := nat.omega.forward at k with assumption
  have pointwise : ∀ X ∈ closedInterval(A, B),
      HasDerivativeAt(iteratedDerivative(f, k),
        iteratedDerivative(f, succ(k))(X), X)
    intros X inside
    obtain ⟨xMember, _, _⟩ := closedInterval.membership.forward with inside
    have xReal : Real(X) by exact xMember
    have here := differentiable with k, kNatural, below, X, inside
    have next := iteratedDerivative.succ at f, k
    have same : k + 1 = succ(k) by arith
    rw same at next
    rw next
    exact derivative.has_derivative_at with here
  refine ⟨functionK, functionNext, pointwise, ?_⟩
  by_cases last : succ(k) = m
  . rw last
    exact continuous
  . have earlier : succ(k) < m by arith
    have nextNatural := nat.omega.forward at succ(k) with assumption
    have subset : closedInterval(A, B) ⊆ ℝ
      intros X inside
      obtain ⟨xMember, _, _⟩ := closedInterval.membership.forward with inside
      exact xMember
    apply ContinuousOn.of_differentiable with functionNext, subset
    intros X inside
    exact differentiable with succ(k), nextNatural, earlier, X, inside

-- The step on [0, M]: for m ≥ 1,
-- (m + 1) ∫ P̃ₘ h + ∫ P̃ₘ₊₁ h′ = Bₘ₊₁ (h(M) − h(0)).
theorem eulerMaclaurin.prefix_step (m : Nat, h dh : Set) (M : Nat)
  requires positive : 1 ≤ m
  shows DerivativeOn(h, dh, R[0], realNat(M)) →
    R[realNat(succ(m)) * riemannIntegral(pointwiseMul(periodicBernoulli(m), h),
        R[0], realNat(M)) +
      riemannIntegral(pointwiseMul(periodicBernoulli(succ(m)), dh), R[0],
        realNat(M))] =
      R[bernoulli(succ(m)) * (h(realNat(M)) - h(R[0]))]
proof
  induction M
  | zero =>
    intro derivative
    obtain ⟨functionH, functionD, _, _⟩ := derivative
    have functionP := periodicBernoulli.function at m
    have functionNext := periodicBernoulli.function at succ(m)
    have first := pointwiseMul.function at periodicBernoulli(m), h with
      functionP, functionH
    have second := pointwiseMul.function at periodicBernoulli(succ(m)), dh with
      functionNext, functionD
    rw [realNat.zero, (riemannIntegral.point with first),
      (riemannIntegral.point with second)]
    have scale := realNat.real at succ(m)
    have number := bernoulli.real at succ(m)
    have zeroMember : R[0] ∈ ℝ by typecheck
    have valueZero := FunctionBetween.apply_closed with functionH, zeroMember
    have realZeroValue : Real(h(R[0])) by exact valueZero
    ring
  | succ(k) using ih =>
    intro derivative
    obtain ⟨prefix, cell⟩ := DerivativeOn.last_cell with derivative
    have previous := ih with prefix
    have cellIdentity := eulerMaclaurin.cell_step with positive, cell
    have continuousPrefix := DerivativeOn.continuous with prefix
    have continuousCell := DerivativeOn.continuous with cell
    have prefixCopy : DerivativeOn(h, dh, R[0], realNat(k)) by exact prefix
    obtain ⟨_, _, _, continuousPrefixD⟩ := prefixCopy
    have cellCopy : DerivativeOn(h, dh, realNat(k), realNat(succ(k)))
      by exact cell
    obtain ⟨functionH, _, _, continuousCellD⟩ := cellCopy
    have firstPrefix := periodicBernoulli.prefix_integrable at m, h, k with
      continuousPrefix
    have secondPrefix := periodicBernoulli.prefix_integrable at succ(m), dh, k
      with continuousPrefixD
    have firstCell := periodicBernoulli.cell_integrable at m, k, h with
      continuousCell
    have secondCell := periodicBernoulli.cell_integrable at succ(m), k, dh with
      continuousCellD
    obtain ⟨_, splitFirst⟩ := riemannIntegral.adjacent with firstPrefix,
      firstCell
    obtain ⟨_, splitSecond⟩ := riemannIntegral.adjacent with secondPrefix,
      secondCell
    rw [splitFirst, splitSecond]
    obtain ⟨a, _⟩ := riemannIntegral.selected at
      pointwiseMul(periodicBernoulli(m), h), R[0], realNat(k)
    obtain ⟨b, _⟩ := riemannIntegral.selected at
      pointwiseMul(periodicBernoulli(m), h), realNat(k), realNat(succ(k))
    obtain ⟨c, _⟩ := riemannIntegral.selected at
      pointwiseMul(periodicBernoulli(succ(m)), dh), R[0], realNat(k)
    obtain ⟨d, _⟩ := riemannIntegral.selected at
      pointwiseMul(periodicBernoulli(succ(m)), dh), realNat(k), realNat(succ(k))
    have scale := realNat.real at succ(m)
    have number := bernoulli.real at succ(m)
    have zeroMember : R[0] ∈ ℝ by typecheck
    have kMember : realNat(k) ∈ ℝ by typecheck
    have nextMember : realNat(succ(k)) ∈ ℝ by typecheck
    have valueZero := FunctionBetween.apply_closed with functionH, zeroMember
    have valueK := FunctionBetween.apply_closed with functionH, kMember
    have valueNext := FunctionBetween.apply_closed with functionH, nextMember
    have realZeroValue : Real(h(R[0])) by exact valueZero
    have realK : Real(h(realNat(k))) by exact valueK
    have realNext : Real(h(realNat(succ(k)))) by exact valueNext
    have expand : R[bernoulli(succ(m)) * (h(realNat(succ(k))) - h(R[0]))] =
      R[bernoulli(succ(m)) * (h(realNat(k)) - h(R[0])) +
        bernoulli(succ(m)) * (h(realNat(succ(k))) - h(realNat(k)))] by ring
    have distribute : R[realNat(succ(m)) * (riemannIntegral(
        pointwiseMul(periodicBernoulli(m), h), R[0], realNat(k)) +
        riemannIntegral(pointwiseMul(periodicBernoulli(m), h), realNat(k),
          realNat(succ(k))))] =
      R[realNat(succ(m)) * riemannIntegral(pointwiseMul(periodicBernoulli(m), h),
          R[0], realNat(k)) +
        realNat(succ(m)) * riemannIntegral(pointwiseMul(periodicBernoulli(m), h),
          realNat(k), realNat(succ(k)))] by ring
    rw [expand, distribute]
    linarith

-- (−1)^(j+1) Bⱼ₊₁ = Bⱼ₊₁ for j ≥ 1: the odd Bernoulli numbers past B₁
-- vanish.
theorem bernoulli.sign_absorb (j : Nat)
  requires positive : 1 ≤ j
  shows R[(-1) ^ (j + 1) * bernoulli(j + 1)] = bernoulli(j + 1)
proof
  have cases := parity.exhaustive at j
  rcases cases with even | odd
  . obtain ⟨q, qNatural, double⟩ := even
    have typedQ := nat.omega.backward with qNatural
    have qPositive : 1 ≤ q by arith
    have pred := sub.closed at q, 1
    have back := sub.add_of_le at 1, q with qPositive
    have shape : j + 1 = 2 * sub(q, 1) + 3 by arith
    rw shape
    rw bernoulli.odd
    ring
  . obtain ⟨q, qNatural, double⟩ := odd
    have typedQ := nat.omega.backward with qNatural
    have shape : j + 1 = 2 * (q + 1) by arith
    have even := realPow.neg_one_even at q + 1
    have sign : R[(-1) ^ (j + 1)] = R[1]
      rw shape
      unfold realPow at even
      exact even
    have number := bernoulli.real at j + 1
    rw sign
    ring

-- The coefficients of the formula from one order to the next: with
-- (j + 1) Rⱼ + Rⱼ₊₁ = Bⱼ₊₁ D,
-- (−1)^(j+1)/j! Rⱼ = Bⱼ₊₁/(j + 1)! D + (−1)^(j+2)/(j + 1)! Rⱼ₊₁.
theorem eulerMaclaurin.coefficient_step (j : Nat) (Rj Rnext D : Real)
  requires positive : 1 ≤ j
  requires step : R[realNat(succ(j)) * Rj + Rnext] = R[bernoulli(succ(j)) * D]
  shows R[(-1) ^ (j + 1) / realNat(j!) * Rj] =
    R[bernoulli(j + 1) / realNat((j + 1)!) * D +
      (-1) ^ (succ(j) + 1) / realNat(succ(j)!) * Rnext]
proof
  have sign := bernoulli.sign_absorb with positive
  have same : j + 1 = succ(j) by arith
  have twice : succ(j) + 1 = succ(succ(j)) by arith
  rw same at sign
  rw [same, twice]
  have kReal := realNat.real at j
  have succStep := realNat.successor at j
  rw succStep at step
  have factorialPositive := realNat.factorial_pos at j
  have factorialReal := realNat.real at j!
  have nextPositive := realNat.factorial_pos at succ(j)
  have nextReal := realNat.real at succ(j)!
  have factorialNonzero : realNat(j!) ≠ R[0]
    intro zero
    rw zero at factorialPositive
    linarith
  have nonnegative := realNat.nonnegative at j
  have scaleNonzero : R[realNat(j) + 1] ≠ R[0]
    intro zero
    linarith
  have number := bernoulli.real at succ(j)
  have power := realPow.real at R[-1], succ(j)
  unfold realPow at power
  have powerStep := realPow.succ at R[-1], succ(j)
  unfold realPow at powerStep
  have inverseNext := realInvValue.real at realNat(succ(j)!)
  have inverse : realInvValue(realNat(j!)) =
      R[(realNat(j) + 1) * realInvValue(realNat(succ(j)!))]
    have factorialStep := realNat.factorial_successor at j
    rw [factorialStep, (realInvValue.mul with scaleNonzero, factorialNonzero)]
    have cancel := realInvValue.mul_right with scaleNonzero
    have inverseScale := realInvValue.real at R[realNat(j) + 1]
    have inverseFactorial := realInvValue.real at realNat(j!)
    have regroup : R[(realNat(j) + 1) * (realInvValue(R[realNat(j) + 1]) *
        realInvValue(realNat(j!)))] =
      R[((realNat(j) + 1) * realInvValue(R[realNat(j) + 1])) *
        realInvValue(realNat(j!))] by ring
    rw [regroup, cancel]
    ring
  have product : R[(realNat(j) + 1) * Rj] = R[bernoulli(succ(j)) * D - Rnext]
    by linarith
  rw [realDiv.eq_mul_inv, realDiv.eq_mul_inv, realDiv.eq_mul_inv, inverse,
    powerStep]
  have expand : R[(-1) ^ succ(j) * ((realNat(j) + 1) *
      realInvValue(realNat(succ(j)!))) * Rj] =
    R[realInvValue(realNat(succ(j)!)) * ((-1) ^ succ(j) *
      ((realNat(j) + 1) * Rj))] by ring
  rw [expand, product]
  have regroup : R[realInvValue(realNat(succ(j)!)) * ((-1) ^ succ(j) *
      (bernoulli(succ(j)) * D - Rnext))] =
    R[((-1) ^ succ(j) * bernoulli(succ(j))) * realInvValue(realNat(succ(j)!)) *
      D - (-1) ^ succ(j) * realInvValue(realNat(succ(j)!)) * Rnext] by ring
  rw [regroup, sign]
  ring

-- C^m gives C^k for 1 ≤ k ≤ m... and for every k ≤ m.
theorem ContinuouslyDifferentiableOn.lower (f : Set) (m k : Nat) (A B : Real)
  requires smooth : ContinuouslyDifferentiableOn(f, m, A, B)
  requires bounded : k ≤ m
  shows ContinuouslyDifferentiableOn(f, k, A, B)
proof
  obtain ⟨function, differentiable, continuous⟩ := smooth
  have earlier : ∀ i ∈ ℕ, i < k → ∀ X ∈ closedInterval(A, B),
      DifferentiableAt(iteratedDerivative(f, i), X)
    intros i naturalI below X inside
    have typedI := nat.omega.backward with naturalI
    have belowM : i < m by arith
    exact differentiable with i, naturalI, belowM, X, inside
  refine ⟨function, earlier, ?_⟩
  by_cases top : k = m
  . rw top
    exact continuous
  . have below : k < m by arith
    have kNatural := nat.omega.forward at k with assumption
    have functionK := iteratedDerivative.function at f, k with function
    have subset : closedInterval(A, B) ⊆ ℝ
      intros X inside
      obtain ⟨xMember, _, _⟩ := closedInterval.membership.forward with inside
      exact xMember
    apply ContinuousOn.of_differentiable with functionK, subset
    intros X inside
    exact differentiable with k, kNatural, below, X, inside

-- The formula of every order j with 1 ≤ j ≤ m, by induction on j.
theorem eulerMaclaurin.up_to (f : Set) (m M j : Nat)
  requires smooth : ContinuouslyDifferentiableOn(f, m, R[0], realNat(M))
  shows 1 ≤ j → j ≤ m → (∑ n < M, naturalValues(f)(n)) =
    R[riemannIntegral(f, R[0], realNat(M)) +
      (∑ k < j, eulerMaclaurinTerms(f, R[0], realNat(M))(k)) +
      (-1) ^ (j + 1) / realNat(j!) *
        riemannIntegral(pointwiseMul(periodicBernoulli(j),
          iteratedDerivative(f, j)), R[0], realNat(M))]
proof
  induction j
  | zero =>
    intro impossible
    exfalso
    arith
  | succ(i) using ih =>
    intros positive bounded
    have smoothCopy : ContinuouslyDifferentiableOn(f, m, R[0], realNat(M))
      by exact smooth
    obtain ⟨function, _, _⟩ := smoothCopy
    have sequence : RealSequence(eulerMaclaurinTerms(f, R[0], realNat(M)))
      unfold RealSequence
      exact eulerMaclaurinTerms.function with function
    by_cases base : i = (0:N)
    . rw base
      rw base at bounded
      have firstOrder := ContinuouslyDifferentiableOn.lower at f, m, (1:N), R[0],
        realNat(M) with smooth, bounded
      have below : (0:N) < (1:N) by arith
      have derivative := ContinuouslyDifferentiableOn.derivative_on at f,
        (1:N), (0:N), R[0], realNat(M) with firstOrder, below
      rw iteratedDerivative.zero at derivative
      obtain ⟨_, _, orderOne⟩ := eulerMaclaurin.prefix_one at f,
        iteratedDerivative(f, (1:N)), M with derivative
      have naturalSequence : RealSequence(naturalValues(f))
        unfold RealSequence
        exact naturalValues.function with function
      have naturalSum := realPartialSum.real at naturalValues(f), M with
        naturalSequence
      have zeroNatural : (0:N) ∈ ℕ by typecheck
      have firstTerm := eulerMaclaurinTerms.value at f, R[0], realNat(M), (0:N)
        with function, zeroNatural
      have indexOne : (0:N) + (1:N) = (1:N) by arith
      have factorialOne : (1:N)! = (1:N) by compute
      rw [indexOne, factorialOne, realNat.one, bernoulli.one,
        iteratedDerivative.zero] at firstTerm
      have even := realPow.neg_one_even at (1:N)
      unfold realPow at even
      have doubled : (1:N) + (1:N) = 2 * (1:N) by arith
      rw [realPartialSum.succ, realPartialSum.zero, firstTerm, doubled, even,
        factorialOne, realNat.one]
      obtain ⟨integralReal, _⟩ := riemannIntegral.selected at f, R[0],
        realNat(M)
      obtain ⟨remainderReal, _⟩ := riemannIntegral.selected at
        pointwiseMul(periodicBernoulli(1), iteratedDerivative(f, 1)), R[0],
        realNat(M)
      have zeroMember : R[0] ∈ ℝ by typecheck
      have endMember : realNat(M) ∈ ℝ by typecheck
      have valueZero := FunctionBetween.apply_closed with function, zeroMember
      have valueEnd := FunctionBetween.apply_closed with function, endMember
      have realZeroValue : Real(f(R[0])) by exact valueZero
      have realEnd : Real(f(realNat(M))) by exact valueEnd
      have addShape := realAddValue.eq_add at R[0],
        R[-(1:R) / (2:R) / 1 * (f(realNat(M)) - f(R[0]))]
      rw addShape
      have oneNonzero : R[1] ≠ R[0]
        intro zero
        have contradiction : R[1] ≤ R[0] by rw zero; linarith
        linarith
      have half : Real(R[-(1:R) / (2:R)]) by typecheck
      have byOne := realDiv.mul_right at R[-(1:R) / (2:R)], R[1] with oneNonzero
      have unitTimes : R[-(1:R) / (2:R) / 1 * 1] = R[-(1:R) / (2:R) / 1]
        by ring
      have dropOne : R[-(1:R) / (2:R) / 1] = R[-(1:R) / (2:R)] by linarith
      rw dropOne
      have shape : R[0 + -(1:R) / (2:R) * (f(realNat(M)) - f(R[0]))] =
        R[-((f(realNat(M)) - f(R[0])) / 2)] by ring
      rw [shape, (realDiv.self with oneNonzero)]
      have finalShape : R[riemannIntegral(f, R[0], realNat(M)) -
          (f(realNat(M)) - f(R[0])) / 2 + 1 * riemannIntegral(pointwiseMul(
            periodicBernoulli(1), iteratedDerivative(f, 1)), R[0], realNat(M))] =
        R[riemannIntegral(f, R[0], realNat(M)) + riemannIntegral(pointwiseMul(
            periodicBernoulli(1), iteratedDerivative(f, 1)), R[0], realNat(M)) -
          (f(realNat(M)) - f(R[0])) / 2] by ring
      rw [finalShape, orderOne]
      ring
    . have positiveJ : 1 ≤ i by arith
      have boundJ : i ≤ m by arith
      have previous := ih with positiveJ, boundJ
      have below : i < m by arith
      have derivative := ContinuouslyDifferentiableOn.derivative_on at f, m, i,
        R[0], realNat(M) with smooth, below
      have stepIdentity := eulerMaclaurin.prefix_step at i,
        iteratedDerivative(f, i), iteratedDerivative(f, succ(i)), M with
        positiveJ
      have stepHere := stepIdentity with derivative
      have coefficient := eulerMaclaurin.coefficient_step with positiveJ,
        stepHere
      have iNatural := nat.omega.forward at i with assumption
      rw [realPartialSum.succ,
        (eulerMaclaurinTerms.value with function, iNatural)]
      have sumReal := realPartialSum.real at
        eulerMaclaurinTerms(f, R[0], realNat(M)), i with sequence
      obtain ⟨integralReal, _⟩ := riemannIntegral.selected at f, R[0],
        realNat(M)
      obtain ⟨remainderReal, _⟩ := riemannIntegral.selected at
        pointwiseMul(periodicBernoulli(i), iteratedDerivative(f, i)), R[0],
        realNat(M)
      obtain ⟨nextReal, _⟩ := riemannIntegral.selected at
        pointwiseMul(periodicBernoulli(succ(i)), iteratedDerivative(f, succ(i))),
        R[0], realNat(M)
      have termReal := RealSequence.value at
        eulerMaclaurinTerms(f, R[0], realNat(M)), i with sequence
      rw (eulerMaclaurinTerms.value with function, iNatural) at termReal
      have addShape := realAddValue.eq_add at
        ∑ k < i, eulerMaclaurinTerms(f, R[0], realNat(M))(k),
        R[bernoulli(i + 1) / realNat((i + 1)!) *
          (iteratedDerivative(f, i)(realNat(M)) - iteratedDerivative(f, i)(R[0]))]
      rw addShape
      linarith

-- Section: The formula
-- The Euler–Maclaurin formula of order m ≥ 1 on [0, M].
theorem eulerMaclaurin (f : Set) (m M : Nat)
  requires positive : 1 ≤ m
  requires smooth : ContinuouslyDifferentiableOn(f, m, R[0], realNat(M))
  shows (∑ n < M, naturalValues(f)(n)) =
    R[riemannIntegral(f, R[0], realNat(M)) +
      (∑ k < m, eulerMaclaurinTerms(f, R[0], realNat(M))(k)) +
      (-1) ^ (m + 1) / realNat(m!) *
        riemannIntegral(pointwiseMul(periodicBernoulli(m),
          iteratedDerivative(f, m)), R[0], realNat(M))]
proof
  have all := eulerMaclaurin.up_to at f, m, M, m with smooth
  have reflexive : m ≤ m by arith
  exact all with positive, reflexive

-- The remainder term is integrable.
theorem eulerMaclaurin.remainder_integrable (f : Set) (m M : Nat)
  requires positive : 1 ≤ m
  requires smooth : ContinuouslyDifferentiableOn(f, m, R[0], realNat(M))
  shows RiemannIntegrable(pointwiseMul(periodicBernoulli(m),
    iteratedDerivative(f, m)), R[0], realNat(M))
proof
  obtain ⟨_, _, continuous⟩ := smooth
  exact periodicBernoulli.prefix_integrable with continuous

-- Order 1: Σ_{n<M} f(n) = ∫_0^M f − (f(M) − f(0))/2 + ∫_0^M P̃₁ f′.
theorem eulerMaclaurin.order_one (f : Set) (M : Nat)
  requires smooth : ContinuouslyDifferentiableOn(f, 1, R[0], realNat(M))
  shows (∑ n < M, naturalValues(f)(n)) =
    R[riemannIntegral(f, R[0], realNat(M)) -
      (f(realNat(M)) - f(R[0])) / 2 +
      riemannIntegral(pointwiseMul(periodicBernoulli(1),
        iteratedDerivative(f, 1)), R[0], realNat(M))]
proof
  have below : 0 < 1 by arith
  have derivative := ContinuouslyDifferentiableOn.derivative_on at f, 1, 0,
    R[0], realNat(M) with smooth, below
  rw iteratedDerivative.zero at derivative
  obtain ⟨_, _, identity⟩ := eulerMaclaurin.prefix_one at f,
    iteratedDerivative(f, 1), M with derivative
  obtain ⟨function, _, _⟩ := smooth
  have sequence : RealSequence(naturalValues(f))
    unfold RealSequence
    exact naturalValues.function with function
  have sumReal := realPartialSum.real at naturalValues(f), M with sequence
  obtain ⟨first, _⟩ := riemannIntegral.selected at f, R[0], realNat(M)
  obtain ⟨second, _⟩ := riemannIntegral.selected at
    pointwiseMul(periodicBernoulli(1), iteratedDerivative(f, 1)), R[0],
    realNat(M)
  have zeroMember : R[0] ∈ ℝ by typecheck
  have endMember : realNat(M) ∈ ℝ by typecheck
  have valueZero := FunctionBetween.apply_closed with function, zeroMember
  have valueEnd := FunctionBetween.apply_closed with function, endMember
  have realZeroValue : Real(f(R[0])) by exact valueZero
  have realEnd : Real(f(realNat(M))) by exact valueEnd
  linarith

-- The formula for a complex function, applied to its real and imaginary
-- parts.
theorem eulerMaclaurin.complex (g : Set) (m M : Nat)
  requires positive : 1 ≤ m
  requires values : ComplexValuedOn(g, ℝ)
  requires smoothRe : ContinuouslyDifferentiableOn(complexFunctionRe(g), m,
    R[0], realNat(M))
  requires smoothIm : ContinuouslyDifferentiableOn(complexFunctionIm(g), m,
    R[0], realNat(M))
  shows complexPartialSum(complexNaturalValues(g), M) =
    ℂ[complexIntegral(g, R[0], realNat(M)) +
      complexPartialSum(complexEulerMaclaurinTerms(g, R[0], realNat(M)), m) +
      complexOfReal(R[(-1) ^ (m + 1) / realNat(m!)]) *
        complexIntegral(complexFunctionMul(complexPeriodicBernoulli(m),
          complexIteratedDeriv(g, m), ℝ), R[0], realNat(M))]
proof
  sorry

end EulerMaclaurin
