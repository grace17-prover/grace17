-- Landau's lemma for polar functions, from the moments of the density
-- K e^(B v) − E(v) e^v: its Laplace transform continues K/(s − B) − Φ(s)
-- across every disk about a large real x that stays right of the abscissa
-- of convergence, so a residue off the real axis right of the abscissa
-- vanishes; and the abscissa is B, since a pole-free real point of the
-- abscissa would let the Taylor series at a nearby real point, whose
-- terms are moments of one sign, converge left of the abscissa.
-- Source: grh-compact/src/Lib/Analytic/Landau/PolarLandau.lean
-- (IsPolar.landau). Related work: Montgomery-Vaughan, Multiplicative
-- Number Theory I, Lemma 15.1, 2007; Widder, The Laplace Transform, 1941,
-- II Thm 5b.
-- Part of the GRH blueprint (layer 4, Lib/Analytic).
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Analytic.LandauCore
import GRH.Analytic.LandauMoments

section LandauCore
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- Section: Complex helpers
-- If (s − 1)Φ(s) is analytic on re s ≥ 1, Φ is holomorphic on re s > 1.
theorem lndPhi.holomorphic (Φ : Set)
  requires functionΦ : FunctionBetween(Φ, ℂ, ℂ)
  requires analytic : ComplexAnalyticOnNhd(subMulMap(Φ, ℂ[1]),
    closedRightHalfPlane(R[1]))
  shows HolomorphicOn(Φ, rightHalfPlane(R[1]))
proof
  have isOpen := rightHalfPlane.open at R[1]
  have sub := ComplexOpen.subset with isOpen
  have valuesΦ : ∀ w ∈ ℂ, Φ(w) ∈ ℂ
    intros w hw
    exact FunctionBetween.apply_closed with functionΦ, hw
  have one : ℂ[1] ∈ ℂ by typecheck
  have values : ComplexValuedOn(subMulMap(Φ, ℂ[1]), rightHalfPlane(R[1]))
    intros z hz
    exact FunctionBetween.apply_closed with
      (subMulMap.function with valuesΦ, one), (sub with z, hz)
  have analyticOpen : ComplexAnalyticOnNhd(subMulMap(Φ, ℂ[1]),
      rightHalfPlane(R[1]))
    intros z hz
    obtain ⟨zC, zRe⟩ := rightHalfPlane.membership.forward with hz
    have closed : z ∈ closedRightHalfPlane(R[1])
      apply closedRightHalfPlane.membership.backward
      refine ⟨zC, ?_⟩
      linarith
    exact analytic with z, closed
  have holomorphicS := (ComplexAnalyticOnNhd.iff_holomorphic with isOpen,
    values).forward with analyticOpen
  have holomorphicP := lndPowerMap.holomorphic at ℂ[1], rightHalfPlane(R[1]),
    (1:N) with one, isOpen
  have nonvanishing : ∀ z ∈ rightHalfPlane(R[1]),
      cxaPowerMap(ℂ[1], (1:N))(z) ≠ ℂ[0]
    intros z hz
    obtain ⟨zC, zRe⟩ := rightHalfPlane.membership.forward with hz
    have pow1 : ℂ[(z - 1) ^ (1:N)] = ℂ[z - 1]
      rw [monoidPow.succ, monoidPow.zero]
      ring
    rw [(cxaPowerMap.value with one, zC), pow1]
    intro zero
    have reZero : complexRe(ℂ[z - 1]) = complexRe(ℂ[0]) by rw zero
    have zeroC : ℂ[0] ∈ ℂ by typecheck
    rw [(complexRe.sub with zC, one), complexRe.one] at reZero
    have zeroRe : complexRe(ℂ[0]) = R[0]
      have z0 := complexOfReal.zero
      rw ← z0
      exact complexOfReal.re at R[0]
    rw zeroRe at reZero
    linarith
  have quotient := HolomorphicOn.div with holomorphicS, holomorphicP,
    nonvanishing
  have agree : ∀ z ∈ rightHalfPlane(R[1]),
      complexFunctionDiv(subMulMap(Φ, ℂ[1]), cxaPowerMap(ℂ[1], (1:N)),
        rightHalfPlane(R[1]))(z) = Φ(z)
    intros z hz
    have zC := sub with z, hz
    have fz := valuesΦ with z, zC
    have nonzero := nonvanishing with z, hz
    have pow1 : ℂ[(z - 1) ^ (1:N)] = ℂ[z - 1]
      rw [monoidPow.succ, monoidPow.zero]
      ring
    rw [(cxaPowerMap.value with one, zC), pow1] at nonzero
    have difference : ℂ[z - 1] ∈ ℂ by typecheck
    have cancel := complexInv.mul_cancel with difference, nonzero
    have inverse := complexInv.member with difference
    rw [(complexFunctionDiv.value with holomorphicS.right.left,
      holomorphicP.right.left, hz), (subMulMap.value with valuesΦ, one, zC),
      (cxaPowerMap.value with one, zC), pow1]
    unfold complexDiv
    linear_combination Φ(z) * cancel
  exact HolomorphicOn.congr with quotient, agree

-- z ↦ k/(z − b) − L(z) is holomorphic where L is, off b.
theorem lndPoleMinus.holomorphic (L U b k : Set)
  requires holomorphicL : HolomorphicOn(L, U)
  requires hb : b ∈ ℂ
  requires hk : k ∈ ℂ
  requires avoid : ∀ z ∈ U, z ≠ b
  shows ∃ Λ, HolomorphicOn(Λ, U) ∧
    (∀ z ∈ U, Λ(z) = ℂ[complexDiv(k, ℂ[z - b]) - L(z)])
proof
  have isOpen := holomorphicL.left
  have sub := ComplexOpen.subset with isOpen
  have negB : ℂ[-b] ∈ ℂ by typecheck
  have constK := HolomorphicOn.const with isOpen, hk
  have constB := HolomorphicOn.const with isOpen, negB
  have identity := HolomorphicOn.id with isOpen
  have denominator := HolomorphicOn.add with identity, constB
  have valuesId := identity.right.left
  have valuesB := constB.right.left
  have valuesK := constK.right.left
  have valuesD := denominator.right.left
  have valuesL := holomorphicL.right.left
  have denominatorValue : ∀ z ∈ U, complexFunctionAdd(complexFunctionId(U),
      complexFunctionConst(ℂ[-b], U), U)(z) = ℂ[z - b]
    intros z hz
    have zC := sub with z, hz
    rw [(complexFunctionAdd.value with valuesId, valuesB, hz),
      (complexFunctionId.value with sub, hz),
      (complexFunctionConst.value with negB, hz)]
    ring
  have nonvanishing : ∀ z ∈ U, complexFunctionAdd(complexFunctionId(U),
      complexFunctionConst(ℂ[-b], U), U)(z) ≠ ℂ[0]
    intros z hz zero
    have zC := sub with z, hz
    rw (denominatorValue with z, hz) at zero
    apply (avoid with z, hz)
    have shape : z = ℂ[(z - b) + b] by ring
    rw [shape, zero]
    ring
  have quotient := HolomorphicOn.div with constK, denominator, nonvanishing
  have negL := HolomorphicOn.neg with holomorphicL
  have total := HolomorphicOn.add with quotient, negL
  refine ⟨complexFunctionAdd(complexFunctionDiv(complexFunctionConst(k, U),
    complexFunctionAdd(complexFunctionId(U), complexFunctionConst(ℂ[-b], U), U),
    U), complexFunctionNeg(L, U), U), total, ?_⟩
  intros z hz
  have zC := sub with z, hz
  have lz := valuesL with z, hz
  rw [(complexFunctionAdd.value with quotient.right.left, negL.right.left, hz),
    (complexFunctionNeg.value with valuesL, hz),
    (complexFunctionDiv.value with valuesK, valuesD, hz),
    (complexFunctionConst.value with hk, hz), (denominatorValue with z, hz)]
  ring

-- If (z − p)Φ(z) → L and Φ agrees off p, near p, with a function
-- holomorphic on a disk about p, then L = 0.
theorem lndResidue.zero (Φ Λ p L : Set, ε : Real)
  requires limit : HasPuncturedLimit(subMulMap(Φ, p), p, L)
  requires valuesΦ : ∀ w ∈ ℂ, Φ(w) ∈ ℂ
  requires hp : p ∈ ℂ
  requires hL : L ∈ ℂ
  requires holomorphic : HolomorphicOn(Λ, complexDisk(p, ε))
  requires positive : (0:R) < ε
  requires agree : lndPuncturedAgree(Φ, Λ, p)
  shows L = ℂ[0]
proof
  by_contra nonzero
  have absPositive := complexAbs.positive with hL, nonzero
  have eReal : half(complexAbs(L)) ∈ ℝ by typecheck
  have ePositive := half.positive with absPositive
  have twice := half.add_self at complexAbs(L)
  obtain ⟨d, hd, dPositive, close⟩ := (lndPunctured.close with limit, hp, hL)
    with half(complexAbs(L)), eReal, ePositive
  have hε : ε ∈ ℝ by typecheck
  have center := complexDisk.center with hp, hε, positive
  have continuous := HolomorphicOn.continuous with holomorphic
  obtain ⟨_, valuesΛ, near⟩ := continuous
  have oneReal : R[1] ∈ ℝ by typecheck
  have onePositive : R[0] < R[1] by linarith
  obtain ⟨d2, hd2, positive2, close2⟩ := near with p, center, R[1], oneReal,
    onePositive
  have λp := valuesΛ with p, center
  have absΛ := complexAbs.nonnegative with λp
  have mReal : R[complexAbs(Λ(p)) + 1] ∈ ℝ by typecheck
  have mNonneg : R[0] ≤ R[complexAbs(Λ(p)) + 1] by linarith
  obtain ⟨η, hη, ηPositive, ηScaled, ηSmall⟩ := realScale.absorb at
    R[complexAbs(Λ(p)) + 1], half(complexAbs(L)) with mReal, eReal, mNonneg,
    ePositive
  obtain ⟨rA, hrA, rAPositive, nearA⟩ := agree
  obtain ⟨m1, hm1, pm1, m1d, m1d2⟩ := realRadius.common with hd, hd2,
    dPositive, positive2
  obtain ⟨m2, hm2, pm2, m2a, m2ε⟩ := realRadius.common with hm1, hε, pm1,
    positive
  obtain ⟨m3, hm3, pm3, m3a, m3r⟩ := realRadius.common with hm2, hrA, pm2,
    rAPositive
  obtain ⟨z, hz, distinct, closeZ⟩ := cxaDisk.punctured_point with hp, hm3, hη,
    pm3, ηPositive
  obtain ⟨zC, zm⟩ := complexDisk.membership.forward with hz
  have zd : z ∈ complexDisk(p, d)
    apply complexDisk.membership.backward
    refine ⟨zC, ?_⟩
    linarith
  have zε : z ∈ complexDisk(p, ε)
    apply complexDisk.membership.backward
    refine ⟨zC, ?_⟩
    linarith
  have zA : z ∈ complexDisk(p, rA)
    apply complexDisk.membership.backward
    refine ⟨zC, ?_⟩
    linarith
  have zd2 : complexAbs(ℂ[z - p]) < d2 by linarith
  have equal := nearA with z, zA, distinct
  have λz := valuesΛ with z, zε
  have fz := valuesΦ with z, zC
  have nearΛ := close2 with z, zε, zd2
  have diffΛ : ℂ[Λ(z) - Λ(p)] ∈ ℂ by typecheck
  have splitΛ : ℂ[(Λ(z) - Λ(p)) + Λ(p)] = Λ(z) by ring
  have triΛ := complexAbs.triangle with diffΛ, λp
  rw splitΛ at triΛ
  have difference : ℂ[z - p] ∈ ℂ by typecheck
  have wValue : subMulMap(Φ, p)(z) = ℂ[(z - p) * Λ(z)]
    rw [(subMulMap.value with valuesΦ, hp, zC), equal]
  have closeW := close with z, zd, distinct
  rw wValue at closeW
  have absW := complexAbs.mul with difference, λz
  have absZ := complexAbs.nonnegative with λz
  have absD := complexAbs.nonnegative with difference
  have distLe : complexAbs(ℂ[z - p]) ≤ η by linarith
  have first := realLe.mul_right_of_nonnegative at complexAbs(ℂ[z - p]), η,
    complexAbs(Λ(z)) with distLe, absZ
  have λLe : complexAbs(Λ(z)) ≤ R[complexAbs(Λ(p)) + 1] by linarith
  have ηNonneg : (0:R) ≤ η by linarith
  have second := realLe.mul_left_of_nonnegative at complexAbs(Λ(z)),
    R[complexAbs(Λ(p)) + 1], η with λLe, ηNonneg
  have swap : R[η * (complexAbs(Λ(p)) + 1)] =
    R[(complexAbs(Λ(p)) + 1) * η] by ring
  have w : ℂ[(z - p) * Λ(z)] ∈ ℂ by typecheck
  have diffL : ℂ[L - (z - p) * Λ(z)] ∈ ℂ by typecheck
  have splitL : ℂ[(L - (z - p) * Λ(z)) + (z - p) * Λ(z)] = L by ring
  have triL := complexAbs.triangle with diffL, w
  rw splitL at triL
  have symm := complexAbs.dist_symm with hL, w
  have r1 : complexAbs(L) ∈ ℝ by typecheck
  have r2 : complexAbs(ℂ[L - (z - p) * Λ(z)]) ∈ ℝ by typecheck
  have r3 : complexAbs(ℂ[(z - p) * Λ(z)]) ∈ ℝ by typecheck
  have r4 : complexAbs(ℂ[(z - p) * Λ(z) - L]) ∈ ℝ by typecheck
  have r5 : R[complexAbs(ℂ[z - p]) * complexAbs(Λ(z))] ∈ ℝ by typecheck
  have r6 : R[η * complexAbs(Λ(z))] ∈ ℝ by typecheck
  have r7 : R[η * (complexAbs(Λ(p)) + 1)] ∈ ℝ by typecheck
  have bad : complexAbs(L) < complexAbs(L) by linarith
  have irreflexive := realLess.irreflexive_on
  exact irreflexive with complexAbs(L), bad

-- Section: The setting
-- E is measurable with |E(v)| ≤ C e^v on v ≥ 0; Φ : ℂ → ℂ is meromorphic,
-- the transform of E for re s > 2, with (s − 1)Φ(s) analytic on re s ≥ 1;
-- the density K e^(B v) − E(v) e^v is ≥ 0 on v > 0; K ≥ 0 and B > 0.
predicate lndSetting (E Φ : Set, C K B : Real) :=
  FunctionBetween(E, ℝ, ℝ) ∧
  Measurable(E, realMeasurableSpace, realMeasurableSpace) ∧
  FunctionBetween(Φ, complexCarrier, complexCarrier) ∧ Meromorphic(Φ) ∧
  (∀ V ∈ ℝ, (0:R) ≤ V → abs(E(V)) ≤ R[C * realExp(V)]) ∧
  (∀ s ∈ complexCarrier, (2:R) < complexRe(s) →
    Φ(s) = laplaceTransform(E, s)) ∧
  ComplexAnalyticOnNhd(subMulMap(Φ, ℂ[1]), closedRightHalfPlane(R[1])) ∧
  (∀ W ∈ ℝ, (0:R) < W → (0:R) ≤ lndDensity(E, K, B)(W)) ∧
  (0:R) ≤ K ∧ (0:R) < B

-- The real points of (x − w, x).
def lndSegment (x w : Real) : Set :=
  { z ∈ complexCarrier | ∃ t ∈ ℝ, R[x - w] < t ∧ t < x ∧ z = complexOfReal(t) }

-- |t − x| for real t, x.
theorem lndReal.dist (t x : Real)
  shows complexAbs(ℂ[complexOfReal(t) - complexOfReal(x)]) = abs(R[t - x])
proof
  rw [← complexOfReal.sub, complexAbs.of_real]

-- Section: The representation near a large real point
-- Let σ > B have a finite moment and x > max(2, σ). On the disk D of
-- radius x − σ about x, Φ agrees off each point, near it, with
-- Λ(z) = K/(z − B) − Σ cₖ (z − x)ᵏ, the series of the moments at x.
theorem lndRep (E Φ : Set, C K B σ x : Real)
  requires setting : lndSetting(E, Φ, C, K, B)
  requires bσ : B < σ
  requires below : σ < x
  requires two : (2:R) < x
  requires finite : lndMoment(lndDensity(E, K, B), σ, (0:N)) ≠ ennTop
  shows ∃ Λ, HolomorphicOn(Λ, complexDisk(complexOfReal(x), R[x - σ])) ∧
    (∀ z ∈ complexDisk(complexOfReal(x), R[x - σ]),
      Λ(z) = ℂ[complexDiv(complexOfReal(K), ℂ[z - complexOfReal(B)]) -
        powerSeriesSum(lndCoeff(lndDensity(E, K, B), x), complexOfReal(x),
          R[x - σ])(z)]) ∧
    (∀ p ∈ complexDisk(complexOfReal(x), R[x - σ]),
      lndPuncturedAgree(Φ, Λ, p))
proof
  obtain ⟨function, measurableE, functionΦ, meromorphic, boundC, transform,
    analyticOne, nonnegG, kNonneg, bPositive⟩ := setting
  obtain ⟨gValues, gMeasurable⟩ := lndDensity.facts at E, K, B with function,
    measurableE
  have radius := lndCoeff.radius at lndDensity(E, K, B), σ, x with gValues,
    gMeasurable, nonnegG, below, finite
  have xC := complexOfReal.mem at x
  have bC := complexOfReal.mem at B
  have kC := complexOfReal.mem at K
  have rReal : R[x - σ] ∈ ℝ by typecheck
  have holomorphicL := powerSeriesSum.holomorphic with radius, xC
  have avoid : ∀ z ∈ complexDisk(complexOfReal(x), R[x - σ]),
      z ≠ complexOfReal(B)
    intros z hz same
    obtain ⟨_, close⟩ := complexDisk.membership.forward with hz
    rw [same, lndReal.dist] at close
    have nonpos : R[B - x] ≤ (0:R) by linarith
    have absNeg := abs.of_nonpositive at R[B - x] with nonpos
    rw absNeg at close
    linarith
  obtain ⟨Λ, holomorphicΛ, valueΛ⟩ := lndPoleMinus.holomorphic with
    holomorphicL, bC, kC, avoid
  -- a small disk V about x inside D and inside re z > 2
  have xσ : (0:R) < R[x - σ] by linarith
  have x2Real : R[x - 2] ∈ ℝ by typecheck
  have x2 : (0:R) < R[x - 2] by linarith
  obtain ⟨w, hw, wPositive, wσ, w2⟩ := realRadius.common with rReal, x2Real,
    xσ, x2
  have wReal : Real(w) by typecheck
  have intoD := complexDisk.mono at complexOfReal(x), w, R[x - σ] with xC, hw,
    rReal, wσ
  have halfPlane : complexDisk(complexOfReal(x), w) ⊆ rightHalfPlane(R[1])
    intros z hz
    obtain ⟨zC, close⟩ := complexDisk.membership.forward with hz
    apply rightHalfPlane.membership.backward
    refine ⟨zC, ?_⟩
    have difference : ℂ[z - complexOfReal(x)] ∈ ℂ by typecheck
    have reLe := complexAbs.re_le with difference
    rw [(complexRe.sub with zC, xC), complexOfReal.re] at reLe
    have reReal : complexRe(z) ∈ ℝ by typecheck
    have lower := abs.upper_neg at R[complexRe(z) - x]
    linarith
  have holomorphicΦ := lndPhi.holomorphic with functionΦ, analyticOne
  have openV := complexDisk.open with xC, hw
  have connectedV := complexDisk.connected with xC, hw
  have ΦV := HolomorphicOn.mono with holomorphicΦ, openV, halfPlane
  have ΛV := HolomorphicOn.mono with holomorphicΛ, openV, intoD
  have centerV := complexDisk.center with xC, hw, wPositive
  have inside : lndSegment(x, w) ⊆ complexDisk(complexOfReal(x), w)
    intros z hz
    obtain ⟨zC, t, ht, tLow, tHigh, zEq⟩ := lndSegment.membership.forward with
      hz
    have tReal : Real(t) by typecheck
    apply complexDisk.membership.backward
    refine ⟨zC, ?_⟩
    rw [zEq, lndReal.dist]
    have nonpos : R[t - x] ≤ (0:R) by linarith
    rw (abs.of_nonpositive at R[t - x] with nonpos)
    linarith
  have accumulates : ∀ r ∈ ℝ, R[0] < r → (∃ s ∈ lndSegment(x, w),
      s ≠ complexOfReal(x) ∧ complexAbs(ℂ[s - complexOfReal(x)]) < r)
    intros r hr rPositive
    obtain ⟨m, hm, mPositive, mr, mw⟩ := realRadius.common with hr, hw,
      rPositive, wPositive
    have mReal : Real(m) by typecheck
    have hmHalf := half.positive with mPositive
    have hmBelow := half.lt_self with mPositive
    have tReal : R[x - half(m)] ∈ ℝ by typecheck
    have tC := complexOfReal.mem at R[x - half(m)]
    have dist := lndReal.dist at R[x - half(m)], x
    have same : R[x - half(m) - x] = R[-half(m)] by ring
    rw [same, (abs.neg at half(m))] at dist
    have halfNonneg : (0:R) ≤ half(m) by linarith
    rw (abs.of_nonnegative at half(m) with halfNonneg) at dist
    refine ⟨complexOfReal(R[x - half(m)]), ?_, ?_, ?_⟩
    . apply lndSegment.membership.backward
      refine ⟨tC, R[x - half(m)], tReal, ?_, ?_, rfl⟩
      . linarith
      . linarith
    . intro same2
      rw [same2, ← complexOfReal.sub] at dist
      have zero : R[x - x] = R[0] by ring
      rw [zero, complexOfReal.zero, complexAbs.zero] at dist
      linarith
    . rw dist
      linarith
  have agreeS : ∀ z ∈ lndSegment(x, w), Φ(z) = Λ(z)
    intros z hz
    obtain ⟨zC, t, ht, tLow, tHigh, zEq⟩ := lndSegment.membership.forward with
      hz
    have tReal : Real(t) by typecheck
    have zD := intoD with z, (inside with z, hz)
    rw (valueΛ with z, zD)
    rw zEq at zD
    rw zEq
    have t2 : (2:R) < t by linarith
    have tB : B < t by linarith
    have tσ : σ < t by linarith
    have tx : t ≤ x by linarith
    obtain ⟨tFinite, moment⟩ := lndDensity.moment at E, C, K, B, t with
      function, measurableE, boundC, nonnegG, kNonneg, t2, tB
    have tCm := complexOfReal.mem at t
    have reT : (2:R) < complexRe(complexOfReal(t)) by
      rw complexOfReal.re
      exact t2
    have atT := transform with complexOfReal(t), tCm, reT
    obtain ⟨_, sums⟩ := lndCoeff.sums_real at lndDensity(E, K, B), σ, x, t
      with gValues, gMeasurable, nonnegG, below, finite, tσ, tx
    have sumL := powerSeriesSum.sums with radius, xC, zD
    have lValue := ComplexSumsTo.unique with sumL, sums
    have gap : R[t - B] ≠ R[0] by
      intro zero
      linarith
    have quotient := complexOfReal.div at K, R[t - B] with gap
    rw complexOfReal.sub at quotient
    unfold complexDiv
    rw [lValue, ← quotient, atT]
    have mR := ennToReal.boch_member with (lndMoment.member at
      lndDensity(E, K, B), t, (0:N))
    have lt : laplaceTransform(E, complexOfReal(t)) ∈ ℂ by
      rw ← atT
      exact FunctionBetween.apply_closed with functionΦ, tCm
    linear_combination moment
  have agreeV := holomorphic.identity_accumulation with ΦV, ΛV, connectedV,
    inside, centerV, accumulates, agreeS
  -- the identity theorem on D
  have openD := complexDisk.open with xC, rReal
  have connectedD := complexDisk.connected with xC, rReal
  have subD := complexDisk.subset at complexOfReal(x), R[x - σ]
  have meromorphicΦ : ∀ a ∈ complexDisk(complexOfReal(x), R[x - σ]),
      MeromorphicAt(Φ, a)
    intros a ha
    exact meromorphic with a, (subD with a, ha)
  have meromorphicΛ : ∀ a ∈ complexDisk(complexOfReal(x), R[x - σ]),
      MeromorphicAt(Λ, a)
    intros a ha
    have analytic := ComplexAnalyticAt.of_holomorphic with holomorphicΛ, ha
    exact MeromorphicAt.of_analytic with analytic
  have valuesΦ : ∀ z ∈ complexDisk(complexOfReal(x), R[x - σ]), Φ(z) ∈ ℂ
    intros z hz
    exact FunctionBetween.apply_closed with functionΦ, (subD with z, hz)
  have valuesΛ : ∀ z ∈ complexDisk(complexOfReal(x), R[x - σ]), Λ(z) ∈ ℂ
    intros z hz
    exact holomorphicΛ.right.left with z, hz
  have nonempty : ∃ b, b ∈ complexDisk(complexOfReal(x), w)
    exact ⟨complexOfReal(x), centerV⟩
  have near := lndMeromorphic.eq_near with openD, connectedD, meromorphicΦ,
    meromorphicΛ, valuesΦ, valuesΛ, openV, intoD, nonempty, agreeV
  exact ⟨Λ, holomorphicΛ, valueΛ, near⟩

-- Every p with re p > σ lies in the disk of radius x − σ about some real
-- x > max(2, σ).
theorem lndNear.center (p : Set, σ : Real)
  requires hp : p ∈ ℂ
  requires below : σ < complexRe(p)
  shows ∃ x ∈ ℝ, (2:R) < x ∧ σ < x ∧ complexRe(p) < x ∧
    p ∈ complexDisk(complexOfReal(x), R[x - σ])
proof
  have reReal := complexRe.real with hp
  have imReal := complexIm.real with hp
  have reTyped : Real(complexRe(p)) by exact reReal
  have imTyped : Real(complexIm(p)) by exact imReal
  have δPositive : (0:R) < R[complexRe(p) - σ] by linarith
  have δNonzero : R[complexRe(p) - σ] ≠ R[0] by
    intro zero
    linarith
  have absRe := abs.nonnegative at complexRe(p)
  have upperRe := abs.upper_neg at complexRe(p)
  have square := realMulValue.square_nonnegative at complexIm(p)
  have quotientNonneg : (0:R) ≤ R[complexIm(p) * complexIm(p) /
      (complexRe(p) - σ)]
    have inv := realInvValue.positive at R[complexRe(p) - σ] with δPositive
    have invR := realInvValue.real at R[complexRe(p) - σ]
    rw realDiv.eq_mul_inv
    have sq : (0:R) ≤ R[complexIm(p) * complexIm(p)] by linarith
    have invNonneg : (0:R) ≤ realInvValue(R[complexRe(p) - σ]) by linarith
    exact realMulValue.nonnegative at R[complexIm(p) * complexIm(p)],
      realInvValue(R[complexRe(p) - σ]) with sq, invNonneg
  have cancel := realDiv.mul_left at R[complexIm(p) * complexIm(p)],
    R[complexRe(p) - σ] with δNonzero
  have tReal : R[complexIm(p) * complexIm(p) / (complexRe(p) - σ) +
    (complexRe(p) - σ) + 2 + abs(complexRe(p))] ∈ ℝ by typecheck
  have xReal : R[complexRe(p) + (complexIm(p) * complexIm(p) /
    (complexRe(p) - σ) + (complexRe(p) - σ) + 2 + abs(complexRe(p)))] ∈ ℝ
    by typecheck
  refine ⟨R[complexRe(p) + (complexIm(p) * complexIm(p) / (complexRe(p) - σ) +
    (complexRe(p) - σ) + 2 + abs(complexRe(p)))], xReal, ?_, ?_, ?_, ?_⟩
  . linarith
  . linarith
  . linarith
  . have xC := complexOfReal.mem at R[complexRe(p) + (complexIm(p) *
      complexIm(p) / (complexRe(p) - σ) + (complexRe(p) - σ) + 2 +
      abs(complexRe(p)))]
    apply complexDisk.membership.backward
    refine ⟨hp, ?_⟩
    have difference : ℂ[p - complexOfReal(R[complexRe(p) + (complexIm(p) *
      complexIm(p) / (complexRe(p) - σ) + (complexRe(p) - σ) + 2 +
      abs(complexRe(p)))])] ∈ ℂ by typecheck
    have normSq := complexAbs.square with difference
    have shape := complex.ext with difference
    have dRe := complexRe.real with difference
    have dIm := complexIm.real with difference
    have dReT : Real(complexRe(ℂ[p - complexOfReal(R[complexRe(p) +
      (complexIm(p) * complexIm(p) / (complexRe(p) - σ) + (complexRe(p) - σ) +
      2 + abs(complexRe(p)))])])) by exact dRe
    have dImT : Real(complexIm(ℂ[p - complexOfReal(R[complexRe(p) +
      (complexIm(p) * complexIm(p) / (complexRe(p) - σ) + (complexRe(p) - σ) +
      2 + abs(complexRe(p)))])])) by exact dIm
    have nsq := complexNormSquared.pair at complexRe(ℂ[p - complexOfReal(
      R[complexRe(p) + (complexIm(p) * complexIm(p) / (complexRe(p) - σ) +
      (complexRe(p) - σ) + 2 + abs(complexRe(p)))])]), complexIm(ℂ[p -
      complexOfReal(R[complexRe(p) + (complexIm(p) * complexIm(p) /
      (complexRe(p) - σ) + (complexRe(p) - σ) + 2 + abs(complexRe(p)))])])
    rw ← shape at nsq
    rw [(complexRe.sub with hp, xC), (complexIm.sub with hp, xC),
      complexOfReal.re, complexOfReal.im] at nsq
    rw nsq at normSq
    have absNonneg := complexAbs.nonnegative with difference
    by_contra notLess
    have ge : R[complexRe(p) + (complexIm(p) * complexIm(p) / (complexRe(p) - σ)
        + (complexRe(p) - σ) + 2 + abs(complexRe(p))) - σ] ≤
        complexAbs(ℂ[p - complexOfReal(R[complexRe(p) + (complexIm(p) *
          complexIm(p) / (complexRe(p) - σ) + (complexRe(p) - σ) + 2 +
          abs(complexRe(p)))])])
      have r1 : complexAbs(ℂ[p - complexOfReal(R[complexRe(p) + (complexIm(p) *
          complexIm(p) / (complexRe(p) - σ) + (complexRe(p) - σ) + 2 +
          abs(complexRe(p)))])]) ∈ ℝ by typecheck
      have total := realLess.trichotomy at complexAbs(ℂ[p - complexOfReal(
        R[complexRe(p) + (complexIm(p) * complexIm(p) / (complexRe(p) - σ) +
        (complexRe(p) - σ) + 2 + abs(complexRe(p)))])]),
        R[complexRe(p) + (complexIm(p) * complexIm(p) / (complexRe(p) - σ) +
        (complexRe(p) - σ) + 2 + abs(complexRe(p))) - σ]
      cases total with less | rest
      . exfalso
        exact notLess with less
      . cases rest with equal | greater
        . linarith
        . linarith
    have bNonneg : (0:R) ≤ R[complexRe(p) + (complexIm(p) * complexIm(p) /
        (complexRe(p) - σ) + (complexRe(p) - σ) + 2 + abs(complexRe(p))) - σ]
      by linarith
    have squares := realMulValue.square_le_of_le with bNonneg, ge
    rw normSq at squares
    have qReal : R[complexIm(p) * complexIm(p) / (complexRe(p) - σ)] ∈ ℝ by
      typecheck
    have ident : R[(complexRe(p) + (complexIm(p) * complexIm(p) /
        (complexRe(p) - σ) + (complexRe(p) - σ) + 2 + abs(complexRe(p))) - σ) *
        (complexRe(p) + (complexIm(p) * complexIm(p) / (complexRe(p) - σ) +
        (complexRe(p) - σ) + 2 + abs(complexRe(p))) - σ)] =
        R[(complexRe(p) - (complexRe(p) + (complexIm(p) * complexIm(p) /
        (complexRe(p) - σ) + (complexRe(p) - σ) + 2 + abs(complexRe(p))))) *
        (complexRe(p) - (complexRe(p) + (complexIm(p) * complexIm(p) /
        (complexRe(p) - σ) + (complexRe(p) - σ) + 2 + abs(complexRe(p))))) +
        (complexIm(p) - 0) * (complexIm(p) - 0) +
        (complexIm(p) * complexIm(p) + 3 * (complexRe(p) - σ) *
        (complexRe(p) - σ) + 4 * (complexRe(p) - σ) + 2 * abs(complexRe(p)) *
        (complexRe(p) - σ))] by
      linear_combination 2 * cancel
    have dd := realMulValue.positive at R[complexRe(p) - σ],
      R[complexRe(p) - σ] with δPositive, δPositive
    have δNonneg : (0:R) ≤ R[complexRe(p) - σ] by linarith
    have aδ := realMulValue.nonnegative at abs(complexRe(p)),
      R[complexRe(p) - σ] with absRe, δNonneg
    have three : R[3 * (complexRe(p) - σ) * (complexRe(p) - σ)] =
      R[3 * ((complexRe(p) - σ) * (complexRe(p) - σ))] by ring
    have twoA : R[2 * abs(complexRe(p)) * (complexRe(p) - σ)] =
      R[2 * (abs(complexRe(p)) * (complexRe(p) - σ))] by ring
    linarith

-- Section: Consequences of the representation
-- If σ > B has a finite moment, every residue at p with re p > σ vanishes.
theorem lndResidue.vanishes (E Φ : Set, C K B σ : Real, p L : Set)
  requires setting : lndSetting(E, Φ, C, K, B)
  requires bσ : B < σ
  requires finite : lndMoment(lndDensity(E, K, B), σ, (0:N)) ≠ ennTop
  requires hp : p ∈ ℂ
  requires right : σ < complexRe(p)
  requires hL : L ∈ ℂ
  requires limit : HasPuncturedLimit(subMulMap(Φ, p), p, L)
  shows L = ℂ[0]
proof
  have copy := setting
  obtain ⟨_, _, functionΦ, _⟩ := copy
  have valuesΦ : ∀ w ∈ ℂ, Φ(w) ∈ ℂ
    intros w hw
    exact FunctionBetween.apply_closed with functionΦ, hw
  obtain ⟨x, hx, two, below, _, inside⟩ := lndNear.center with hp, right
  have xReal : Real(x) by typecheck
  obtain ⟨Λ, holomorphicΛ, _, near⟩ := lndRep at E, Φ, C, K, B, σ, x with
    setting, bσ, below, two, finite
  have xC := complexOfReal.mem at x
  have rReal : R[x - σ] ∈ ℝ by typecheck
  obtain ⟨ε, hε, εPositive, diskP⟩ := complexDisk.inner with xC, rReal, inside
  have openP := complexDisk.open with hp, hε
  have holomorphicP := HolomorphicOn.mono with holomorphicΛ, openP, diskP
  have εReal : Real(ε) by typecheck
  exact lndResidue.zero at Φ, Λ, p, L, ε with limit, valuesΦ, hp, hL,
    holomorphicP, εPositive, (near with p, inside)

-- If σ > B has a finite moment, then right of every real z > σ, within
-- any ε, lies a real z′ where Φ(z′) = K/(z′ − B) − ∫ D(v) e^(−z′ v) dv,
-- the moment being finite.
theorem lndRealValues (E Φ : Set, C K B σ z ε : Real)
  requires setting : lndSetting(E, Φ, C, K, B)
  requires bσ : B < σ
  requires finite : lndMoment(lndDensity(E, K, B), σ, (0:N)) ≠ ennTop
  requires right : σ < z
  requires positive : (0:R) < ε
  shows ∃ Z ∈ ℝ, z < Z ∧ Z < R[z + ε] ∧
    lndMoment(lndDensity(E, K, B), Z, (0:N)) ≠ ennTop ∧
    Φ(complexOfReal(Z)) = ℂ[complexOfReal(R[K / (Z - B)]) -
      complexOfReal(ennToReal(lndMoment(lndDensity(E, K, B), Z, (0:N))))]
proof
  have copy := setting
  obtain ⟨function, measurableE, functionΦ, _, _, _, _, nonnegG, _, _⟩ := copy
  obtain ⟨gValues, gMeasurable⟩ := lndDensity.facts at E, K, B with function,
    measurableE
  have zC := complexOfReal.mem at z
  have reZ : σ < complexRe(complexOfReal(z)) by
    rw complexOfReal.re
    exact right
  obtain ⟨x, hx, two, below, zxRe, inside⟩ := lndNear.center with zC, reZ
  have xReal : Real(x) by typecheck
  obtain ⟨Λ, holomorphicΛ, valueΛ, near⟩ := lndRep at E, Φ, C, K, B, σ, x
    with setting, bσ, below, two, finite
  obtain ⟨ρ, hρ, ρPositive, nearZ⟩ := near with complexOfReal(z), inside
  have radius := lndCoeff.radius at lndDensity(E, K, B), σ, x with gValues,
    gMeasurable, nonnegG, below, finite
  have xC := complexOfReal.mem at x
  rw complexOfReal.re at zxRe
  have zx : z < x := zxRe
  have gapReal : R[x - z] ∈ ℝ by typecheck
  have gap : (0:R) < R[x - z] by linarith
  have hε : ε ∈ ℝ by typecheck
  obtain ⟨m1, hm1, pm1, m1ε, m1ρ⟩ := realRadius.common with hε, hρ, positive,
    ρPositive
  obtain ⟨m, hm, pm, mA, mGap⟩ := realRadius.common with hm1, gapReal, pm1, gap
  have mReal : Real(m) by typecheck
  have halfPositive := half.positive with pm
  have halfBelow := half.lt_self with pm
  have ZReal : R[z + half(m)] ∈ ℝ by typecheck
  have ZC := complexOfReal.mem at R[z + half(m)]
  have Zσ : σ < R[z + half(m)] by linarith
  have Zx : R[z + half(m)] ≤ x by linarith
  have distZ := lndReal.dist at R[z + half(m)], z
  have shift : R[z + half(m) - z] = half(m) by ring
  have halfNonneg : (0:R) ≤ half(m) by linarith
  rw [shift, (abs.of_nonnegative at half(m) with halfNonneg)] at distZ
  have inρ : complexOfReal(R[z + half(m)]) ∈ complexDisk(complexOfReal(z), ρ)
    apply complexDisk.membership.backward
    refine ⟨ZC, ?_⟩
    rw distZ
    linarith
  have distinct : complexOfReal(R[z + half(m)]) ≠ complexOfReal(z)
    intro same
    have back := complexOfReal.injective with same
    linarith
  have equal := nearZ with complexOfReal(R[z + half(m)]), inρ, distinct
  have inD : complexOfReal(R[z + half(m)]) ∈ complexDisk(complexOfReal(x),
      R[x - σ])
    apply complexDisk.membership.backward
    refine ⟨ZC, ?_⟩
    rw lndReal.dist
    have nonpos : R[z + half(m) - x] ≤ (0:R) by linarith
    rw (abs.of_nonpositive at R[z + half(m) - x] with nonpos)
    linarith
  obtain ⟨ZFinite, sums⟩ := lndCoeff.sums_real at lndDensity(E, K, B), σ, x,
    R[z + half(m)] with gValues, gMeasurable, nonnegG, below, finite, Zσ, Zx
  have sumL := powerSeriesSum.sums with radius, xC, inD
  have lValue := ComplexSumsTo.unique with sumL, sums
  have bLess : B < R[z + half(m)] by linarith
  have gapB : R[z + half(m) - B] ≠ R[0] by
    intro zero
    linarith
  have quotient := complexOfReal.div at K, R[z + half(m) - B] with gapB
  rw complexOfReal.sub at quotient
  refine ⟨R[z + half(m)], ZReal, ?_, ?_, ZFinite, ?_⟩
  . linarith
  . linarith
  . rw [equal, (valueΛ with complexOfReal(R[z + half(m)]), inD), lValue]
    unfold complexDiv
    rw ← quotient

-- Section: The abscissa
-- At a real a > B right of which every moment is finite, a residue L with
-- re L ≥ 0 vanishes: along real z ↓ a, (z − a)Φ(z) is real and at most
-- (z − a) K/(z − B).
theorem lndResidue.real_zero (E Φ : Set, C K B a : Real, L : Set)
  requires setting : lndSetting(E, Φ, C, K, B)
  requires bA : B < a
  requires finiteAbove : ∀ σ ∈ ℝ, a < σ →
    lndMoment(lndDensity(E, K, B), σ, (0:N)) ≠ ennTop
  requires hL : L ∈ ℂ
  requires limit : HasPuncturedLimit(subMulMap(Φ, complexOfReal(a)),
    complexOfReal(a), L)
  requires reNonneg : (0:R) ≤ complexRe(L)
  shows L = ℂ[0]
proof
  have copy := setting
  obtain ⟨_, _, functionΦ, _, _, _, _, _, kNonneg, _⟩ := copy
  have valuesΦ : ∀ w ∈ ℂ, Φ(w) ∈ ℂ
    intros w hw
    exact FunctionBetween.apply_closed with functionΦ, hw
  have aC := complexOfReal.mem at a
  have reL := complexRe.real with hL
  have imL := complexIm.real with hL
  have reLT : Real(complexRe(L)) by exact reL
  have imLT : Real(complexIm(L)) by exact imL
  have gap : (0:R) < R[a - B] by linarith
  have key : ∀ e ∈ ℝ, (0:R) < e →
      complexRe(L) < R[e + e] ∧ abs(complexIm(L)) < e
    intros e he ePositive
    have eT : Real(e) by typecheck
    obtain ⟨d, hd, dPositive, close⟩ := (lndPunctured.close with limit, aC,
      hL) with e, he, ePositive
    have κReal : R[K / (a - B)] ∈ ℝ by typecheck
    have invGap := realInvValue.positive at R[a - B] with gap
    have invGapR := realInvValue.real at R[a - B]
    have invNonneg : (0:R) ≤ realInvValue(R[a - B]) by linarith
    have κNonneg : (0:R) ≤ R[K / (a - B)]
      rw realDiv.eq_mul_inv
      exact realMulValue.nonnegative at K, realInvValue(R[a - B]) with kNonneg,
        invNonneg
    obtain ⟨η, hη, ηPositive, ηScaled, ηSmall⟩ := realScale.absorb at
      R[K / (a - B)], e with κReal, he, κNonneg, ePositive
    obtain ⟨m, hm, mPositive, md, mη⟩ := realRadius.common with hd, hη,
      dPositive, ηPositive
    have mT : Real(m) by typecheck
    have h1 := half.positive with mPositive
    have h1Below := half.lt_self with mPositive
    have h2 := half.positive with h1
    have h2Below := half.lt_self with h1
    have twiceM := half.add_self at m
    have σReal : R[a + half(half(m))] ∈ ℝ by typecheck
    have σT : Real(R[a + half(half(m))]) by typecheck
    have σAbove : a < R[a + half(half(m))] by linarith
    have σB : B < R[a + half(half(m))] by linarith
    have σFinite := finiteAbove with R[a + half(half(m))], σReal, σAbove
    have zT : Real(R[a + half(m)]) by typecheck
    have σz : R[a + half(half(m))] < R[a + half(m)] by linarith
    have hmT : Real(half(m)) by typecheck
    obtain ⟨Z, hZ, zLow, zHigh, zFinite, zValue⟩ := lndRealValues at E, Φ, C,
      K, B, R[a + half(half(m))], R[a + half(m)], half(m) with setting, σB,
      σFinite, σz, h1
    have ZT : Real(Z) by typecheck
    have ZC := complexOfReal.mem at Z
    have dist := lndReal.dist at Z, a
    have zaNonneg : (0:R) ≤ R[Z - a] by linarith
    rw (abs.of_nonnegative at R[Z - a] with zaNonneg) at dist
    have inD : complexOfReal(Z) ∈ complexDisk(complexOfReal(a), d)
      apply complexDisk.membership.backward
      refine ⟨ZC, ?_⟩
      rw dist
      linarith
    have distinct : complexOfReal(Z) ≠ complexOfReal(a)
      intro same
      have back := complexOfReal.injective with same
      linarith
    have closeZ := close with complexOfReal(Z), inD, distinct
    have gMember := lndMoment.member at lndDensity(E, K, B), Z, (0:N)
    obtain ⟨gReal, gNonneg⟩ := ennreal.finite with gMember, zFinite
    obtain ⟨gToReal, _⟩ := ennToReal.of_finite with gMember, zFinite
    rw gToReal at zValue
    have zbGap : R[Z - B] ≠ R[0] by
      intro zero
      linarith
    have wValue : subMulMap(Φ, complexOfReal(a))(complexOfReal(Z)) =
        complexOfReal(R[(Z - a) * (K / (Z - B) -
          lndMoment(lndDensity(E, K, B), Z, (0:N)))])
      rw [(subMulMap.value with valuesΦ, aC, ZC), zValue, complexOfReal.mul,
        complexOfReal.sub, complexOfReal.sub]
    rw wValue at closeZ
    have uReal : R[(Z - a) * (K / (Z - B) - lndMoment(lndDensity(E, K, B), Z,
      (0:N)))] ∈ ℝ by typecheck
    have uC := complexOfReal.mem at R[(Z - a) * (K / (Z - B) -
      lndMoment(lndDensity(E, K, B), Z, (0:N)))]
    have difference : ℂ[complexOfReal(R[(Z - a) * (K / (Z - B) -
      lndMoment(lndDensity(E, K, B), Z, (0:N)))]) - L] ∈ ℂ by typecheck
    have reLe := complexAbs.re_le with difference
    have imLe := complexAbs.abs_im_le with difference
    rw [(complexRe.sub with uC, hL), complexOfReal.re] at reLe
    rw [(complexIm.sub with uC, hL), complexOfReal.im] at imLe
    have zeroMinus : R[0 - complexIm(L)] = R[-complexIm(L)] by ring
    rw [zeroMinus, abs.neg] at imLe
    have upper := abs.upper_neg at R[R[(Z - a) * (K / (Z - B) -
      lndMoment(lndDensity(E, K, B), Z, (0:N)))] - complexRe(L)]
    -- the real value is at most e
    have zbPositive : (0:R) < R[Z - B] by linarith
    have gapLe : R[a - B] ≤ R[Z - B] by linarith
    have invLe := realInvValue.antitone_le at R[a - B], R[Z - B] with gap, gapLe
    have invZR := realInvValue.real at R[Z - B]
    have kStep := realLe.mul_left_of_nonnegative at realInvValue(R[Z - B]),
      realInvValue(R[a - B]), K with invLe, kNonneg
    have divZ := realDiv.eq_mul_inv at K, R[Z - B]
    have divA := realDiv.eq_mul_inv at K, R[a - B]
    have kzReal : R[K / (Z - B)] ∈ ℝ by typecheck
    have kzLe : R[K / (Z - B)] ≤ R[K / (a - B)] by linarith
    have zaLe : R[Z - a] ≤ η by linarith
    have step1 := realLe.mul_right_of_nonnegative at R[Z - a], η,
      R[K / (a - B)] with zaLe, κNonneg
    have step2 := realLe.mul_left_of_nonnegative at R[K / (Z - B)],
      R[K / (a - B)], R[Z - a] with kzLe, zaNonneg
    have step3 := realMulValue.nonnegative at R[Z - a],
      lndMoment(lndDensity(E, K, B), Z, (0:N)) with zaNonneg, gNonneg
    have expand : R[(Z - a) * (K / (Z - B) - lndMoment(lndDensity(E, K, B), Z,
        (0:N)))] = R[(Z - a) * (K / (Z - B)) - (Z - a) *
        lndMoment(lndDensity(E, K, B), Z, (0:N))] by ring
    have swap : R[η * (K / (a - B))] = R[K / (a - B) * η] by ring
    refine ⟨?_, ?_⟩
    . linarith
    . linarith
  -- im L = 0 and re L ≤ 0
  have imZero : complexIm(L) = R[0]
    by_contra nonzero
    have absPositive := abs.positive_of_ne at complexIm(L) with nonzero
    have halfReal : half(abs(complexIm(L))) ∈ ℝ by typecheck
    have halfPositive := half.positive with absPositive
    have halfBelow := half.lt_self with absPositive
    obtain ⟨_, small⟩ := key with half(abs(complexIm(L))), halfReal,
      halfPositive
    linarith
  have reZero : complexRe(L) = R[0]
    by_contra nonzero
    have rePositive : (0:R) < complexRe(L)
      have total := realLess.trichotomy at R[0], complexRe(L)
      cases total with less | rest
      . exact less
      . exfalso
        cases rest with equal | greater
        . apply nonzero
          symm
          exact equal
        . linarith
    have h1 := half.positive with rePositive
    have h2 := half.positive with h1
    have q := half.add_self at half(complexRe(L))
    have q2 := half.add_self at complexRe(L)
    have quarterReal : half(half(complexRe(L))) ∈ ℝ by typecheck
    obtain ⟨small, _⟩ := key with half(half(complexRe(L))), quarterReal, h2
    linarith
  have shape := complex.ext with hL
  rw [shape, reZero, imZero]
  have zero := complexOfReal.zero
  have zeroR : R[0] ∈ ℝ by typecheck
  rw [← zero, (complexOfReal.value at R[0] with zeroR)]

end LandauCore
