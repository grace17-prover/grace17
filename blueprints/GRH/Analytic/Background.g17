-- Background for layer 4's analytic library that layers 1-3 lack:
-- meromorphic functions on ℂ, limits on punctured neighborhoods (the
-- residue (z − a)·f(z) → c), the Laplace transform on (0, ∞), and the
-- analytic facts behind Landau's lemma and the three-lines bound: the
-- exponential integral over (0, ∞), holomorphy of Laplace transforms of
-- nonnegative densities, Taylor series on a disk, the identity theorem for
-- meromorphic functions, and Hadamard's three-lines theorem.
-- Source: the Mathlib declarations used by grh-compact/src/Lib/Analytic
-- (Mathlib's Meromorphic, MeromorphicAt, Filter.Tendsto on 𝓝[≠],
-- integral_exp_mul_complex_Ioi, complexMGF, analyticOnNhd_complexMGF,
-- iteratedDeriv_complexMGF, hasSum_taylorSeries_on_ball,
-- MeromorphicOn.meromorphicOrderAt_ne_top_of_isPreconnected,
-- HadamardThreeLines.norm_le_interp_of_mem_verticalClosedStrip').
-- Part of the GRH blueprint (layer 4, Lib/Analytic).
-- Planned home: Complex/Analytic.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Analytic.Background
import GRH.LSeries.Values

section Background
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- Section: Definitions
-- Φ : ℂ → ℂ is meromorphic at every point (Mathlib's Meromorphic).
predicate Meromorphic (Φ : Set) := ∀ a ∈ complexCarrier, MeromorphicAt(Φ, a)

-- z ↦ (z − a)·f(z) on ℂ.
defgraph subMulMap (f a : Set) (z ∈ complexCarrier) : complexCarrier :=
    ℂ[(z - a) * f(z)]
requires values : ∀ w ∈ complexCarrier, f(w) ∈ complexCarrier
requires ha : a ∈ complexCarrier
proof
  have value := values with member
  typecheck

-- f(z) → c as z → a with z ≠ a (Mathlib's Tendsto f (𝓝[≠] a) (𝓝 c)).
predicate HasPuncturedLimit (f a c : Set) :=
  Tendsto(f, complexCarrier, nhdsPunctured(complexSpace, a),
    nhds(complexSpace, c))

-- v ↦ E(v) e^((1−s)v) on ℝ, and the Laplace transform
-- ∫_{(0,∞)} E(v) e^((1−s)v) dv (a Bochner integral, 0 off the integrable
-- s, as Mathlib's integral).
def laplaceIntegrand (E s : Set) : Set :=
  { (V, ℂ[complexOfReal(E(V)) * complexExp(ℂ[(1 - s) * complexOfReal(V)])]) |
    V ∈ ℝ }

def laplaceTransform (E s : Set) : Set :=
  complexSetIntegral(realMeasurableSpace, realVolume, laplaceIntegrand(E, s),
    realIoi(realZero))

-- v ↦ g(v) e^(−s v), and its integral over (0, ∞): the Laplace transform
-- of the density g, Mathlib's complexMGF (−|·|) (volume.withDensity g)
-- restricted to (0, ∞).
def densityLaplaceIntegrand (g s : Set) : Set :=
  { (V, ℂ[complexOfReal(g(V)) * complexExp(ℂ[-(s * complexOfReal(V))])]) |
    V ∈ ℝ }

def densityLaplace (g s : Set) : Set :=
  complexSetIntegral(realMeasurableSpace, realVolume,
    densityLaplaceIntegrand(g, s), realIoi(realZero))

-- v ↦ (−v)^k g(v) e^(−s v), the k-th derivative in s of the integrand.
def densityLaplaceMoment (g s : Set, k : Nat) : Set :=
  { (V, ℂ[complexOfReal(R[-V]) ^ k * complexOfReal(g(V)) *
      complexExp(ℂ[-(s * complexOfReal(V))])]) | V ∈ ℝ }

-- s ↦ the Laplace transform of g on ℂ.
def densityLaplaceMap (g : Set) : Set :=
  { (s, densityLaplace(g, s)) | s ∈ complexCarrier }

-- The Taylor terms f⁽ᵏ⁾(z)(w − z)^k/k! of f at z, holomorphic on U.
def taylorTerms (f U z w : Set) : Set :=
  { (k, ℂ[complexOfReal(realInvValue(realNat(k!))) * (w - z) ^ k *
      holomorphicIteratedDeriv(f, U, k)(z)]) | k ∈ ℕ }

-- The open vertical strip A < re z < B and its closure.
def verticalStrip (A B : Real) : Set :=
  { z ∈ complexCarrier | A < complexRe(z) ∧ complexRe(z) < B }
def verticalClosedStrip (A B : Real) : Set :=
  { z ∈ complexCarrier | A ≤ complexRe(z) ∧ complexRe(z) ≤ B }

-- Section: The exponential integral
-- Mathlib's integrableOn_exp_mul_complex_Ioi and
-- integral_exp_mul_complex_Ioi (at c = 0): for re a < 0, t ↦ e^(a t) is
-- integrable on (0, ∞) with integral −1/a.
theorem complexExpLinear.integral_Ioi (a : Set)
  requires ha : a ∈ complexCarrier
  requires negative : complexRe(a) < (0:R)
  shows ComplexIntegrableOn(realMeasurableSpace, realVolume,
      complexExpLinear(a), realIoi(realZero)) ∧
    complexSetIntegral(realMeasurableSpace, realVolume, complexExpLinear(a),
      realIoi(realZero)) = ℂ[-complexInv(a)]
proof
  sorry

-- Section: Laplace transforms of nonnegative densities
-- Mathlib's analyticOnNhd_complexMGF and iteratedDeriv_complexMGF, for the
-- measure g(v) dv on (0, ∞), g ≥ 0 measurable: if g(v) e^(−σ v) is
-- integrable on (0, ∞) for every real σ > S, then s ↦ ∫ g(v) e^(−s v) dv
-- is holomorphic on re s > S, and its k-th derivative is
-- ∫ (−v)^k g(v) e^(−s v) dv, the integrand being integrable.
theorem densityLaplace.holomorphic (g : Set, S : Real)
  requires measurable : Measurable(g, realMeasurableSpace, realMeasurableSpace)
  requires nonneg : ∀ V ∈ ℝ, (0:R) ≤ g(V)
  requires integrable : ∀ T ∈ ℝ, S < T →
    ComplexIntegrableOn(realMeasurableSpace, realVolume,
      densityLaplaceIntegrand(g, complexOfReal(T)), realIoi(realZero))
  shows HolomorphicOn(densityLaplaceMap(g), rightHalfPlane(S)) ∧
    (∀ k ∈ ℕ, ∀ s ∈ rightHalfPlane(S),
      ComplexIntegrableOn(realMeasurableSpace, realVolume,
        densityLaplaceMoment(g, s, k), realIoi(realZero)) ∧
      holomorphicIteratedDeriv(densityLaplaceMap(g), rightHalfPlane(S), k)(s) =
        complexSetIntegral(realMeasurableSpace, realVolume,
          densityLaplaceMoment(g, s, k), realIoi(realZero)))
proof
  sorry

-- Section: Taylor series and the identity theorem
-- Mathlib's hasSum_taylorSeries_on_ball: f holomorphic on the disk of
-- radius r about z is the sum of its Taylor series at every w of the disk.
theorem taylorTerms.sums_on_disk (f z w : Set, r : Real)
  requires holomorphic : HolomorphicOn(f, complexDisk(z, r))
  requires hz : z ∈ complexCarrier
  requires inside : w ∈ complexDisk(z, r)
  shows ComplexSumsTo(taylorTerms(f, complexDisk(z, r), z, w), f(w))
proof
  sorry

-- The identity theorem for meromorphic functions (Mathlib's
-- MeromorphicOn.meromorphicOrderAt_ne_top_of_isPreconnected with
-- meromorphicOrderAt_eq_top_iff): if Φ and Ψ are meromorphic at every
-- point of a connected open U and agree on a nonempty open V ⊆ U, then
-- near every point of U they agree off that point.
theorem Meromorphic.eq_near_of_eq_on_open (Φ Ψ U V : Set)
  requires open : ComplexOpen(U)
  requires connected : ComplexConnected(U)
  requires meromorphicΦ : ∀ a ∈ U, MeromorphicAt(Φ, a)
  requires meromorphicΨ : ∀ a ∈ U, MeromorphicAt(Ψ, a)
  requires openV : ComplexOpen(V)
  requires inside : V ⊆ U
  requires nonempty : ∃ b, b ∈ V
  requires agree : ∀ z ∈ V, Φ(z) = Ψ(z)
  shows ∀ a ∈ U, ∃ r ∈ ℝ, (0:R) < r ∧
    (∀ z ∈ complexDisk(a, r), z ≠ a → Φ(z) = Ψ(z))
proof
  sorry

-- Section: Three lines
-- Hadamard's three-lines theorem (Mathlib's
-- HadamardThreeLines.norm_le_interp_of_mem_verticalClosedStrip'): let f
-- be holomorphic on A < re z < B, continuous and bounded on
-- A ≤ re z ≤ B, with |f| ≤ P on re z = A and |f| ≤ Q on re z = B, where
-- P, Q > 0. Then |f(z)| ≤ P^(1−u) Q^u, u = (re z − A)/(B − A), on the
-- closed strip.
theorem threeLines.norm_le_interp (f z : Set, A B P Q : Real)
  requires order : A < B
  requires positiveP : (0:R) < P
  requires positiveQ : (0:R) < Q
  requires holomorphic : HolomorphicOn(f, verticalStrip(A, B))
  requires continuous : ComplexContinuousOn(f, verticalClosedStrip(A, B))
  requires bounded : ∃ K ∈ ℝ, ∀ w ∈ verticalClosedStrip(A, B),
    complexAbs(f(w)) ≤ K
  requires left : ∀ w ∈ complexCarrier, complexRe(w) = A → complexAbs(f(w)) ≤ P
  requires right : ∀ w ∈ complexCarrier, complexRe(w) = B → complexAbs(f(w)) ≤ Q
  requires hz : z ∈ verticalClosedStrip(A, B)
  shows complexAbs(f(z)) ≤
    R[realRpow(P, R[1 - (complexRe(z) - A) / (B - A)]) *
      realRpow(Q, R[(complexRe(z) - A) / (B - A)])]
proof
  sorry

end Background
