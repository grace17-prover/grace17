-- Quadratic non-residues and a Chinese remainder step for the quadratic
-- twist: every odd prime d has a non-residue (x ↦ x² mod d is not onto),
-- and for N prime to d some integer is ≡ 1 mod N and ≡ a mod d.
-- Helpers for GRH.Analytic.Landau (quadTwist.ne_principal).
-- Part of the GRH blueprint (layer 4, Lib/Analytic).
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Analytic.TkKQuadraticResidues
import GRH.Analytic.Legendre

-- x ↦ x² mod d on {0, …, d − 1}.
def tkKsq (d x : Nat) : Set := ((x:N) * (x:N)) % d
def tkKsquareModMap (d : Nat) : Set := { (x, tkKsq(d, x)) | x ∈ d }

theorem tkKsq.member (d x : Nat)
  requires positive : (0:N) < d
  shows tkKsq(d, x) ∈ d
proof
  have nonzero : d ≠ (0:N) by arith
  have value := mod.natural at d, x * x
  have below := mod.less at x * x, d with nonzero
  have member := membership.of_Less at (x * x) % d, d with value
  unfold tkKsq
  exact member with below

theorem tkKsquareModMap.facts (d : Nat)
  requires positive : (0:N) < d
  shows FunctionBetween(tkKsquareModMap(d), d, d) ∧
    (∀ x ∈ d, tkKsquareModMap(d)(x) = tkKsq(d, x))
proof
  have shape : ∀ p ∈ tkKsquareModMap(d), ∃ a ∈ d, ∃ b ∈ d, p = (a, b)
    intros p hp
    simp [tkKsquareModMap] at hp
    obtain ⟨m, mIn, eq⟩ := hp
    rw ← eq
    have mNat := natural.member at d with m, mIn
    exact ⟨m, mIn, tkKsq(d, m), (tkKsq.member at d, m with positive), rfl⟩
  have total : ∀ a ∈ d, ∃ b ∈ d, (a, b) ∈ tkKsquareModMap(d)
    intros a aIn
    have aNat := natural.member at d with a, aIn
    refine ⟨tkKsq(d, a), (tkKsq.member at d, a with positive), ?_⟩
    simp [tkKsquareModMap]
  have functional : ∀ a, ∀ b, ∀ c, (a, b) ∈ tkKsquareModMap(d) →
      (a, c) ∈ tkKsquareModMap(d) → b = c
    intros a b c ab ac
    simp [tkKsquareModMap] at ab
    simp [tkKsquareModMap] at ac
    obtain ⟨m, _, abEq⟩ := ab
    obtain ⟨k, _, acEq⟩ := ac
    obtain ⟨ma, mb⟩ := orderedPair.injective with abEq
    obtain ⟨ka, kc⟩ := orderedPair.injective with acEq
    cc
  have function := coefficientGraph.function with shape, total, functional
  refine ⟨function, ?_⟩
  intros x xIn
  have xNat := natural.member at d with x, xIn
  have shapeLoose : ∀ p ∈ tkKsquareModMap(d), ∃ a ∈ d, ∃ b, p = (a, b)
    intros p hp
    obtain ⟨a, aIn, b, _, eq⟩ := shape with p, hp
    exact ⟨a, aIn, b, eq⟩
  have totalLoose : ∀ a ∈ d, ∃ b, (a, b) ∈ tkKsquareModMap(d)
    intros a aIn
    obtain ⟨b, _, mapped⟩ := total with a, aIn
    exact ⟨b, mapped⟩
  have mapped : (x, tkKsq(d, x)) ∈ tkKsquareModMap(d)
    simp [tkKsquareModMap]
  exact coefficientGraph.apply with shapeLoose, totalLoose, functional, xIn,
    mapped

-- Every odd prime d has a quadratic non-residue: otherwise x ↦ x² mod d
-- would be onto {0, …, d − 1}, hence one-to-one, while 1² ≡ (d − 1)².
theorem tkKnonresidue.exists (d : Nat)
  requires prime : Prime(d)
  requires odd : d ≠ (2:N)
  shows ∃ a ∈ ℤ, ¬IntegerCongruent(integerOfNat(d), a, integerZero) ∧
    ¬IntegerSquareMod(d, a)
proof
  have two := Prime.two_le with prime
  have positive : (0:N) < d by arith
  have nonzero : d ≠ (0:N) by arith
  by_contra none
  have hits : ∀ a ∈ d, ∃ x ∈ d, tkKsq(d, x) = a
    intros a ha
    have aNat := natural.member at d with a, ha
    have aBelow := (Less.of_membership at a, d) with ha
    have zeroIn := (membership.of_Less at (0:N), d) with positive
    by_cases zero : a = (0:N)
    . refine ⟨(0:N), zeroIn, ?_⟩
      rw zero
      have same : (0:N) * (0:N) = (0:N) by arith
      unfold tkKsq
      rw same
      exact mod.zero_left at d
    . have aInt : integerOfNat(a) ∈ ℤ by typecheck
      have notDivides : ¬IntegerCongruent(integerOfNat(d), integerOfNat(a),
          integerZero)
        intro congruent
        rw ← integerOfNat.zero at congruent
        have natural := (IntegerCongruent.ofNat_iff at d, a, (0:N)).forward
          with congruent
        have divides := (CongruentMod.zero_right_iff at a, d).forward with
          natural
        have le := divides.le with divides, zero
        arith
      have square : IntegerSquareMod(d, integerOfNat(a))
        by_contra notSquare
        apply none
        exact ⟨integerOfNat(a), aInt, notDivides, notSquare⟩
      have residue := (IntegerSquareMod.iff_residue with positive, aInt).forward
        with square
      rw [(integerMod.ofNat at a, d with positive), (mod.of_less with aBelow)]
        at residue
      obtain ⟨x, xNat, congruent⟩ := residue
      unfold CongruentMod at congruent
      rw (mod.of_less with aBelow) at congruent
      have value := mod.natural at d, x
      have below := mod.less at x, d with nonzero
      have member := (membership.of_Less at x % d, d with value) with below
      refine ⟨x % d, member, ?_⟩
      unfold tkKsq
      rw [(mod.mul_left at d, x, x % d with nonzero),
        (mod.mul_right at d, x, x with nonzero), congruent]
  obtain ⟨function, values⟩ := tkKsquareModMap.facts with positive
  have surjective : SurjectiveBetween(tkKsquareModMap(d), d, d)
    refine ⟨function, ?_⟩
    intros y hy
    obtain ⟨x, hx, equation⟩ := hits with y, hy
    refine ⟨x, hx, ?_⟩
    have relates := FunctionBetween.relates_apply with function, hx
    rw [(values with x, hx), equation] at relates
    exact relates
  have finite := Finite.natural at d
  have bijective := Finite.self_surjective_bijective with surjective, finite
  obtain ⟨injective, _⟩ := bijective
  obtain ⟨_, oneToOne⟩ := injective
  obtain ⟨s, sNat, dEq⟩ := LessEqual.exists_add with two
  have sNonzero : s ≠ (0:N)
    intro zero
    rw zero at dEq
    apply odd
    rw dEq
    arith
  have oneBelow : (1:N) < d by arith
  have eBelow : s + (1:N) < d by arith
  have oneNat : Nat((1:N)) by typecheck
  have eNat : Nat(s + (1:N)) by typecheck
  have oneIn := (membership.of_Less at (1:N), d) with oneBelow
  have eIn := (membership.of_Less at s + (1:N), d) with eBelow
  have atOne : tkKsq(d, (1:N)) = (1:N)
    have same : (1:N) * (1:N) = (1:N) by arith
    unfold tkKsq
    rw same
    exact mod.of_less with oneBelow
  have atE : tkKsq(d, s + (1:N)) = (1:N)
    have expand : (s + (1:N)) * (s + (1:N)) = (1:N) + (d:N) * (s:N)
      rw dEq
      ring
    unfold tkKsq
    rw [expand, (mod.add_multiple at d, (1:N), s with nonzero)]
    exact mod.of_less with oneBelow
  have relOne := FunctionBetween.relates_apply with function, oneIn
  rw [(values with (1:N), oneIn), atOne] at relOne
  have relE := FunctionBetween.relates_apply with function, eIn
  rw [(values with s + (1:N), eIn), atE] at relE
  have same := oneToOne with (1:N), oneIn, s + (1:N), eIn, (1:N), oneIn,
    relOne, relE
  arith

-- For N prime to d there is an integer ≡ 1 mod N and ≡ a mod d.
theorem tkKcrt.one_and (N d : Nat, a : Integer)
  requires coprime : gcd(N, d) = (1:N)
  shows ∃ n, Integer(n) ∧ IntegerCongruent(integerOfNat(N), n, integerOne) ∧
    IntegerCongruent(integerOfNat(d), n, a)
proof
  have integerCoprime : IntegerCoprime(integerOfNat(N), integerOfNat(d))
    unfold IntegerCoprime
    rw integerGCD.ofNat
    exact coprime
  obtain ⟨u, uInteger, v, vInteger, identity⟩ := IntegerCoprime.bezout at
    integerOfNat(N), integerOfNat(d) with integerCoprime
  witness integerOne + (a - integerOne) * u * integerOfNat(N)
  constructor
  . witness (a - integerOne) * u
    ring
  . witness (integerOne - a) * v
    linear_combination (integerOne - a) * identity
