-- A prime in a long window (a weak Siegel-Walfisz theorem): for M a
-- multiple of 4, large W, k ≥ 2 with M^k ≤ W^A and U ∈ [W, W^A], some
-- prime p ≡ 1 (mod M^k) has U ≤ log p ≤ U + W. Through a zero-free disk
-- at 1: |L(s, χ)| ≤ C q^(2r) on |s − 1| ≤ r, and η|L̃′(s, χ)| < |L̃(s, χ)|
-- on |s − 1| ≤ η for the characters modulo M^k.
-- Source: grh-compact/src/Lib/Analytic/Primes/AuxiliaryPrimes.lean.
-- "Known result: A prime in a long window (weak form of the
-- Siegel-Walfisz theorem)." Related work: Montgomery-Vaughan,
-- Multiplicative Number Theory I, Cor. 11.19, 2007.
-- Part of the GRH blueprint (layer 4, Lib/Analytic).
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Analytic.Primes
import GRH.Analytic.Theta
import GRH.Analytic.Landau

section Primes
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- AuxiliaryPrimes.lean, exists_norm_LFunction_le: for 0 < r < 1/9 there
-- is C ≥ 0 with |L(s, χ)| ≤ C q^(2r) on |s − 1| ≤ r, for every modulus q
-- and every non-principal χ modulo q.
theorem LFunction.exists_abs_le_near_one (r : Real)
  requires positive : (0:R) < r
  requires small : r < R[1 / 9]
  shows ∃ C ∈ ℝ, (0:R) ≤ C ∧
    (∀ q ∈ ℕ, (1:N) ≤ q → ∀ χ, DirichletCharacter(q, χ) →
      χ ≠ principalCharacter(q) → ∀ s ∈ complexCarrier,
      complexAbs(ℂ[s - 1]) ≤ r →
      complexAbs(LFunction(q, χ, s)) ≤ R[C * realRpow(realNat(q), R[2 * r])])
proof
  sorry

-- AuxiliaryPrimes.lean, eventually_mul_norm_deriv_entireL_lt: let M > 0
-- be a multiple of 4 and A natural. For all small η > 0, all k ≥ 2 with
-- M^k ≤ η^(−A), all characters χ modulo M^k and |s − 1| ≤ η,
-- η |L̃′(s, χ)| < |L̃(s, χ)|.
theorem entireL.eventually_abs_deriv_lt (A M : Nat)
  requires positive : (1:N) ≤ M
  requires four : 4 ∣ M
  shows ∃ E ∈ ℝ, (0:R) < E ∧ (∀ H ∈ ℝ, (0:R) < H → H < E →
    ∀ k ∈ ℕ, (1:N) < k → ∀ χ, DirichletCharacter(M ^ k, χ) →
    ∀ s ∈ complexCarrier,
    realNat(M ^ k) ≤ realInvValue(R[H ^ A]) →
    complexAbs(ℂ[s - 1]) ≤ H →
    ¬(complexAbs(entireL(M ^ k, χ, s)) ≤
      R[H * complexAbs(complexDeriv(entireLMap(M ^ k, χ), complexCarrier)(s))]))
proof
  sorry

-- AuxiliaryPrimes.lean, exists_prime_modEq_one_log_mem: let M > 0 be a
-- multiple of 4 and A natural. For all large W, all k ≥ 2 with
-- M^k ≤ W^A and all U ∈ [W, W^A], some prime p ≡ 1 (mod M^k) has
-- U ≤ log p ≤ U + W.
theorem prime.exists_modEq_one_log_mem (M A : Nat)
  requires positive : (1:N) ≤ M
  requires four : 4 ∣ M
  shows ∃ W₀ ∈ ℝ, ∀ W ∈ ℝ, W₀ ≤ W → ∀ k ∈ ℕ, (1:N) < k →
    realNat(M ^ k) ≤ R[W ^ A] → ∀ U ∈ ℝ, W ≤ U → U ≤ R[W ^ A] →
    ∃ p ∈ ℕ, Prime(p) ∧ CongruentMod(p, 1, M ^ k) ∧
      U ≤ realLog(realNat(p)) ∧ realLog(realNat(p)) ≤ R[U + W]
proof
  sorry

end Primes
