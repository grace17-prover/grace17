-- Landau's lemma for one-sided bounds: a function E whose transform
-- ∫₀^∞ E(v) e^((1−s)v) dv continues meromorphically with at most simple
-- poles of residue r(ρ) in re ρ > 0 (`IsPolar`), with E(v) ≤ e^((β−1)v)
-- for large v and re r(x) ≥ 0 for real x > β, has r(ρ) = 0 for re ρ > β.
-- Also: the quadratic twist ξ·(·/d), the Laplace transform of a power,
-- and the entire L-function L̃: analytic, nonzero on re s ≥ 1, −L̃′/L̃ as
-- an L-series of χΛ, and (z − s) L̃′/L̃(z) → ord_s L̃.
-- Source: grh-compact/src/Lib/Analytic/Landau/PolarLandau.lean. "Known
-- result: Landau's lemma on Dirichlet integrals of one sign." Related
-- work: Montgomery-Vaughan, Multiplicative Number Theory I, Lemma 15.1,
-- 2007; Widder, The Laplace Transform, 1941, II Thm 5b.
-- Part of the GRH blueprint (layer 4, Lib/Analytic).
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Analytic.Landau
import GRH.Analytic.Background
import GRH.Analytic.Legendre
import GRH.Analytic.LandauCore

section Landau
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- Section: Definitions
-- PolarLandau.lean, IsPolar: E : ℝ → ℝ is measurable with |E(v)| ≤ C e^v
-- for v ≥ 0; its transform ∫₀^∞ E(v) e^((1−s)v) dv agrees for re s > 2
-- with a meromorphic Φ : ℂ → ℂ such that (s − 1)Φ(s) is analytic on
-- re s ≥ 1, and (z − ρ)Φ(z) → r(ρ) as z → ρ, z ≠ ρ, for every re ρ > 0.
predicate IsPolar (E r : Set) :=
  FunctionBetween(E, ℝ, ℝ) ∧
  Measurable(E, realMeasurableSpace, realMeasurableSpace) ∧
  ∃ C ∈ ℝ, ∃ Φ, FunctionBetween(Φ, complexCarrier, complexCarrier) ∧
    Meromorphic(Φ) ∧
    (∀ V ∈ ℝ, (0:R) ≤ V → abs(E(V)) ≤ R[C * realExp(V)]) ∧
    (∀ s ∈ complexCarrier, (2:R) < complexRe(s) →
      Φ(s) = laplaceTransform(E, s)) ∧
    ComplexAnalyticOnNhd(subMulMap(Φ, ℂ[1]), closedRightHalfPlane(R[1])) ∧
    (∀ ρ ∈ complexCarrier, (0:R) < complexRe(ρ) →
      HasPuncturedLimit(subMulMap(Φ, ρ), ρ, r(ρ)))

-- t ↦ t^k e^(−s t) on ℝ.
def powExpIntegrand (k : Nat, s : Set) : Set :=
  { (T, ℂ[complexOfReal(T) ^ k * complexExp(ℂ[-(s * complexOfReal(T))])]) |
    T ∈ ℝ }

-- 1 if χ is the principal character modulo N, 0 otherwise (the source's
-- ite (χ = 1) 1 0).
def principalIndicator (N : Nat, χ : Set) : Set :=
  ⋃({ w ∈ complexCarrier | (χ = principalCharacter(N) ∧ w = ℂ[1]) ∨
    (χ ≠ principalCharacter(N) ∧ w = ℂ[0]) })

-- Section: The quadratic twist
-- QuadField.lean, quadTwist (its type): ξ·(·/d) is a Dirichlet character
-- modulo N d.
theorem quadTwist.character (N d : Nat, ξ : Set)
  requires prime : Prime(d)
  requires character : DirichletCharacter(N, ξ)
  shows DirichletCharacter(N * d, quadTwist(N, ξ, d))
proof
  have values := legendreTwistValues.character with prime, character
  have same := divides.reflexive at N * d
  unfold quadTwist
  exact changeLevel.character with same, values

-- PolarLandau.lean, quadTwist_apply: ξ·(·/d) takes the value ξ(n)(n/d)
-- at every integer n.
theorem quadTwist.apply (N d : Nat, ξ n : Set)
  requires prime : Prime(d)
  requires character : DirichletCharacter(N, ξ)
  requires integer : n ∈ ℤ
  shows quadTwist(N, ξ, d)(n) = ℂ[ξ(n) * complexOfReal(legendreSign(d, n))]
proof
  have values := legendreTwistValues.character with prime, character
  have function := DirichletCharacter.function with values
  rw ← (legendreTwistValues.apply with integer)
  unfold quadTwist
  by_cases coprime : IntegerCoprime(n, integerOfNat(N * d))
  . have value := FunctionBetween.apply_closed with function, integer
    exact changeLevel.coprime with integer, coprime, value
  . have zero := DirichletCharacter.not_coprime with values, integer, coprime
    rw [(changeLevel.not_coprime with integer, coprime), zero]

-- PolarLandau.lean, quadTwist_ne_one: for an odd prime d prime to N the
-- twist ξ·(·/d) is not the principal character modulo N d.
theorem quadTwist.ne_principal (N d : Nat, ξ : Set)
  requires prime : Prime(d)
  requires odd : d ≠ (2:N)
  requires coprime : gcd(N, d) = (1:N)
  requires character : DirichletCharacter(N, ξ)
  shows quadTwist(N, ξ, d) ≠ principalCharacter(N * d)
proof
  sorry

-- Section: Laplace transforms
-- PolarLandau.lean, integrableOn_laplace_of_abs_le: for E measurable with
-- |E(v)| ≤ C e^v on v ≥ 0 and re s > 2, v ↦ E(v) e^((1−s)v) is integrable
-- on (0, ∞).
theorem laplaceIntegrand.integrable_of_abs_le (E s : Set, C : Real)
  requires function : FunctionBetween(E, ℝ, ℝ)
  requires measurable : Measurable(E, realMeasurableSpace, realMeasurableSpace)
  requires bound : ∀ V ∈ ℝ, (0:R) ≤ V → abs(E(V)) ≤ R[C * realExp(V)]
  requires hs : s ∈ complexCarrier
  requires right : (2:R) < complexRe(s)
  shows ComplexIntegrableOn(realMeasurableSpace, realVolume,
    laplaceIntegrand(E, s), realIoi(realZero))
proof
  have σMember := complexRe.real with hs
  have σT : Real(complexRe(s)) by typecheck
  have realIntegrable := lndLaplaceReal.integrable at E, C, complexRe(s) with
    function, measurable, bound, right
  obtain ⟨measure, _, finite⟩ := realIntegrable
  have aMember : ℂ[1 - s] ∈ ℂ by typecheck
  have decay : complexRe(ℂ[1 - s]) < realZero
    rw (complexRe.one_sub with hs)
    linarith
  obtain ⟨expIntegrable, _⟩ := complexSetIntegral.exp_mul_Ioi with aMember,
    decay
  obtain ⟨_, expMeasurable, _⟩ := expIntegrable
  have cast : ∀ x ∈ MeasurableSpace.carrier(realMeasurableSpace),
      complexOfRealOn(E, MeasurableSpace.carrier(realMeasurableSpace))(x) =
        complexOfReal(E(x))
    intros x hx
    exact complexOfRealOn.boch_apply with hx
  have castMeasurable := Measurable.complex_of_real with measurable, cast
  have product : ∀ x ∈ MeasurableSpace.carrier(realMeasurableSpace),
      laplaceIntegrand(E, s)(x) = ℂ[complexOfRealOn(E,
        MeasurableSpace.carrier(realMeasurableSpace))(x) *
        complexExpLinear(ℂ[1 - s])(x)]
    intros x hx
    have xR := hx
    rw realMeasurableSpace.carrier at xR
    rw [(lndLaplaceIntegrand.apply with xR), (complexOfRealOn.boch_apply with hx),
      (lndExpLinear.apply with xR)]
  have integrandMeasurable := Measurable.complex_mul with castMeasurable,
    expMeasurable, product
  have agree : ∀ x ∈ MeasurableSpace.carrier(realMeasurableSpace),
      complexAbsOn(laplaceIntegrand(E, s),
        MeasurableSpace.carrier(realMeasurableSpace))(x) =
      realAbsOn(lndLaplaceReal(E, complexRe(s)),
        MeasurableSpace.carrier(realMeasurableSpace))(x)
    intros x hx
    have xR := hx
    rw realMeasurableSpace.carrier at xR
    have xReal : Real(x) by typecheck
    have eX := FunctionBetween.apply_closed with function, xR
    have eReal : Real(E(x)) by typecheck
    have eC : complexOfReal(E(x)) ∈ ℂ by typecheck
    have xC : complexOfReal(x) ∈ ℂ by typecheck
    have expC : complexExp(ℂ[(1 - s) * complexOfReal(x)]) ∈ ℂ by typecheck
    have re : complexRe(ℂ[(1 - s) * complexOfReal(x)]) =
        R[(1 - complexRe(s)) * x]
      rw [(complexRe.mul with aMember, xC), complexOfReal.re, complexOfReal.im,
        (complexRe.one_sub with hs)]
      ring
    have expPositive := realExp.positive at R[(1 - complexRe(s)) * x]
    have expNonneg : (0:R) ≤ realExp(R[(1 - complexRe(s)) * x]) by linarith
    rw [(complexAbsOn.boch_apply with hx), (realAbsOn.boch_apply with hx),
      (lndLaplaceIntegrand.apply with xR),
      (lndLaplaceReal.value at E, complexRe(s), x with xR),
      (complexAbs.mul with eC, expC), complexAbs.of_real, complexExp.abs, re,
      (abs.mul at E(x), realExp(R[(1 - complexRe(s)) * x])),
      (abs.of_nonnegative with expNonneg)]
  have same := lintegral.congr at realMeasurableSpace,
    restrictMeasure(realMeasurableSpace, realVolume, realIoi(realZero)) with
    agree
  rw lndMeasure.eq at measure
  rw lndMeasure.eq at finite
  unfold ComplexIntegrableOn
  unfold ComplexIntegrable
  refine ⟨measure, integrandMeasurable, ?_⟩
  rw same
  exact finite

-- PolarLandau.lean, laplace_pow: for re s > 0,
-- ∫₀^∞ t^k e^(−s t) dt = k!/s^(k+1).
theorem powExpIntegrand.integral_Ioi (k : Nat, s : Set)
  requires hs : s ∈ complexCarrier
  requires right : (0:R) < complexRe(s)
  shows complexSetIntegral(realMeasurableSpace, realVolume,
      powExpIntegrand(k, s), realIoi(realZero)) =
    complexDiv(complexOfReal(realNat(k!)), ℂ[s ^ (k + 1)])
proof
  sorry

-- Section: The entire L-function
-- s ↦ L̃(s, χ) takes the value L̃(s, χ) at s ∈ ℂ.
theorem entireLMap.apply (N : Nat, χ s : Set)
  requires hs : s ∈ complexCarrier
  shows entireLMap(N, χ)(s) = entireL(N, χ, s)
proof
  have shape : ∀ p ∈ entireLMap(N, χ), ∃ a ∈ complexCarrier, ∃ b, p = (a, b) by
    intros p hp
    simp [entireLMap] at hp
    obtain ⟨z, zIn, eq⟩ := hp
    rw ← eq
    exact ⟨z, zIn, entireL(N, χ, z), rfl⟩
  have total : ∀ a ∈ complexCarrier, ∃ b, (a, b) ∈ entireLMap(N, χ) by
    intros a aIn
    refine ⟨entireL(N, χ, a), ?_⟩
    simp [entireLMap]
  have functional : ∀ a, ∀ b, ∀ c, (a, b) ∈ entireLMap(N, χ) →
      (a, c) ∈ entireLMap(N, χ) → b = c by
    intros a b c ab ac
    simp [entireLMap] at ab
    simp [entireLMap] at ac
    obtain ⟨z, _, abEq⟩ := ab
    obtain ⟨w, _, acEq⟩ := ac
    obtain ⟨za, zb⟩ := orderedPair.injective with abEq
    obtain ⟨wa, wc⟩ := orderedPair.injective with acEq
    cc
  have mapped : (s, entireL(N, χ, s)) ∈ entireLMap(N, χ) by
    simp [entireLMap]
  exact coefficientGraph.apply with shape, total, functional, hs, mapped

-- L̃(s, χ₀) is the continuation of (s − 1) L(s, χ₀) at every s, s = 1
-- included.
theorem entireL.principal (N : Nat, s : Set)
  requires hs : s ∈ complexCarrier
  shows entireL(N, principalCharacter(N), s) = principalLFunctionOne(N, s)
proof
  have value := principalLFunctionOneMap.closed at N, s with hs
  unfold entireL
  apply union.of_unique
  . refine ⟨value, ?_⟩
    left
    exact ⟨rfl, rfl⟩
  . intros y hy
    obtain ⟨_, alternatives⟩ := hy
    rcases alternatives with ⟨_, yValue⟩ | ⟨notPrincipal, _⟩
    . exact yValue
    . exfalso
      exact notPrincipal with rfl

-- L̃(s, χ) is a complex number.
theorem entireL.member (N : Nat, χ s : Set)
  requires character : DirichletCharacter(N, χ)
  requires hs : s ∈ complexCarrier
  shows entireL(N, χ, s) ∈ complexCarrier
proof
  by_cases principal : χ = principalCharacter(N)
  . rw [principal, (entireL.principal with hs)]
    exact principalLFunctionOneMap.closed at N, s with hs
  . have values := DirichletCharacter.function with character
    rw (entireL.of_not_principal with values, hs, principal)
    exact LFunction.closed with values, hs

-- s ↦ L̃(s, χ) is holomorphic on ℂ.
theorem entireLMap.holomorphic (N : Nat, χ : Set)
  requires positive : (1:N) ≤ N
  requires character : DirichletCharacter(N, χ)
  shows HolomorphicOn(entireLMap(N, χ), complexCarrier)
proof
  by_cases principal : χ = principalCharacter(N)
  . have holomorphic := principalLFunctionOneMap.holomorphic with positive
    have agree : ∀ z ∈ complexCarrier,
        principalLFunctionOneMap(N)(z) = entireLMap(N, χ)(z) by
      intros z hz
      rw [(principalLFunctionOneMap.apply with hz), (entireLMap.apply with hz),
        principal, (entireL.principal with hz)]
    exact HolomorphicOn.congr with holomorphic, agree
  . have holomorphic := LFunctionMap.holomorphic_of_ne_principal with
      positive, character, principal
    have values := DirichletCharacter.function with character
    have agree : ∀ z ∈ complexCarrier,
        LFunctionMap(N, χ)(z) = entireLMap(N, χ)(z) by
      intros z hz
      rw [(LFunctionMap.value with values, hz), (entireLMap.apply with hz),
        (entireL.of_not_principal with values, hz, principal)]
    exact HolomorphicOn.congr with holomorphic, agree

-- z ↦ L̃′/L̃(z, χ) on ℂ.
defgraph logDerivEntireLMap (N : Nat, χ : Set) (z ∈ complexCarrier) :
    complexCarrier := logDerivEntireL(N, χ, z)
requires positive : (1:N) ≤ N
requires character : DirichletCharacter(N, χ)
proof
  have holomorphic := entireLMap.holomorphic with positive, character
  have derivative := complexDeriv.closed at entireLMap(N, χ), complexCarrier,
    z with holomorphic, member
  have value := entireL.member with character, member
  have inverse := complexInv.member with value
  unfold logDerivEntireL
  unfold complexDiv
  typecheck

-- PolarLandau.lean, analyticAt_entireL: L̃(·, χ) is analytic at every s.
theorem entireL.analytic (N : Nat, χ s : Set)
  requires positive : (1:N) ≤ N
  requires character : DirichletCharacter(N, χ)
  requires hs : s ∈ complexCarrier
  shows ComplexAnalyticAt(entireLMap(N, χ), s)
proof
  have holomorphic := entireLMap.holomorphic with positive, character
  exact ComplexAnalyticAt.of_holomorphic with holomorphic, hs

-- PolarLandau.lean, entireL_ne_zero: L̃(s, χ) ≠ 0 for re s ≥ 1.
theorem entireL.ne_zero (N : Nat, χ s : Set)
  requires positive : (1:N) ≤ N
  requires character : DirichletCharacter(N, χ)
  requires hs : s ∈ complexCarrier
  requires halfPlane : (1:R) ≤ complexRe(s)
  shows entireL(N, χ, s) ≠ ℂ[0]
proof
  by_cases principal : χ = principalCharacter(N)
  . rw [principal, (entireL.principal with hs)]
    exact principalLFunctionOne.ne_zero_of_one_le_re with positive, hs,
      halfPlane
  . have values := DirichletCharacter.function with character
    rw (entireL.of_not_principal with values, hs, principal)
    have notPole : χ ≠ principalCharacter(N) ∨ s ≠ ℂ[1] by
      left
      exact principal
    exact LFunction.ne_zero_of_one_le_re with positive, character, hs,
      notPole, halfPlane

-- Two holomorphic functions agreeing on an open V ⊆ U have the same
-- derivative at points of V.
theorem tkKcomplexDeriv.agree (f g U V s : Set)
  requires holomorphicF : HolomorphicOn(f, U)
  requires holomorphicG : HolomorphicOn(g, V)
  requires inside : V ⊆ U
  requires hs : s ∈ V
  requires agree : ∀ z ∈ V, f(z) = g(z)
  shows complexDeriv(f, U)(s) = complexDeriv(g, V)(s)
proof
  have sU := inside with s, hs
  have derivative := complexDeriv.has_derivative with holomorphicF, sU
  have hg := holomorphicG
  obtain ⟨isOpen, _, _⟩ := hg
  have restricted := HasComplexDerivativeAt.mono with derivative, isOpen,
    inside, hs
  have moved := HasComplexDerivativeAt.congr with restricted, agree
  have equal := cxaDeriv.eq with holomorphicG, moved
  symm
  exact equal

-- PolarLandau.lean, LSeriesHasSum_mul_vonMangoldt: for re s > 1,
-- Σ χ(n)Λ(n) n^(−s) = [χ = 1]/(s − 1) − L̃′/L̃(s, χ).
theorem LSeriesHasSum.twist_vonMangoldt_entireL (N : Nat, χ s : Set)
  requires positive : (1:N) ≤ N
  requires character : DirichletCharacter(N, χ)
  requires hs : s ∈ complexCarrier
  requires halfPlane : (1:R) < complexRe(s)
  shows LSeriesHasSum(twistedVonMangoldt(χ), s,
    ℂ[complexDiv(principalIndicator(N, χ), ℂ[s - 1]) -
      logDerivEntireL(N, χ, s)])
proof
  have positiveN : 1 ≤ N by arith
  have halfOne : realOne < complexRe(s) by linarith
  have notOne : s ≠ ℂ[1]
    intro equal
    rw [equal, complexRe.one] at halfPlane
    linarith
  have shifted : ℂ[s - 1] ∈ ℂ by typecheck
  have values := DirichletCharacter.function with character
  have whole := entireLMap.holomorphic with positive, character
  have complexSub : complexCarrier ⊆ complexCarrier
    exact Subset.reflexive at complexCarrier
  by_cases principal : χ = principalCharacter(N)
  . have indicator : principalIndicator(N, χ) = ℂ[1]
      have oneMember : ℂ[1] ∈ complexCarrier by typecheck
      unfold principalIndicator
      apply union.of_unique
      . refine ⟨oneMember, ?_⟩
        left
        exact ⟨principal, rfl⟩
      . intros y hy
        obtain ⟨_, alternatives⟩ := hy
        rcases alternatives with ⟨_, yValue⟩ | ⟨notPrincipal, _⟩
        . exact yValue
        . exfalso
          exact notPrincipal with principal
    have has := LSeriesHasSum.principal_vonMangoldt with positiveN, hs,
      halfOne
    have holomorphic := principalLFunctionOneMap.holomorphic with positiveN
    have agree : ∀ z ∈ complexCarrier,
        entireLMap(N, χ)(z) = principalLFunctionOneMap(N)(z)
      intros z hz
      rw [(entireLMap.apply with hz), (principalLFunctionOneMap.apply with hz),
        principal, (entireL.principal with hz)]
    have derivative := tkKcomplexDeriv.agree with whole, holomorphic,
      complexSub, hs, agree
    have value : ℂ[complexDiv(principalIndicator(N, χ), ℂ[s - 1]) -
        logDerivEntireL(N, χ, s)] = ℂ[complexInv(ℂ[s - 1]) -
        logDeriv(principalLFunctionOneMap(N), complexCarrier, s)]
      have inverse := complexInv.member with shifted
      have pointValue := agree with s, hs
      rw (entireLMap.apply with hs) at pointValue
      unfold logDerivEntireL
      unfold logDeriv
      rw [indicator, derivative, pointValue]
      unfold complexDiv
      ring
    rw [value, principal]
    exact has
  . have indicator : principalIndicator(N, χ) = ℂ[0]
      have zeroMember : ℂ[0] ∈ complexCarrier by typecheck
      unfold principalIndicator
      apply union.of_unique
      . refine ⟨zeroMember, ?_⟩
        right
        exact ⟨principal, rfl⟩
      . intros y hy
        obtain ⟨_, alternatives⟩ := hy
        rcases alternatives with ⟨isPrincipal, _⟩ | ⟨_, yValue⟩
        . exfalso
          exact principal with isPrincipal
        . exact yValue
    have has := LSeriesHasSum.twist_vonMangoldt with positiveN, character, hs,
      halfOne
    have holomorphic := LFunction.holomorphic_off_one with positiveN, character
    have one := complexOne.member
    have isOpen := complexPunctured.open with one
    have inside := ComplexOpen.subset with isOpen
    have sU : s ∈ complexCarrier ∖ {ℂ[1]}
      refine ⟨hs, ?_⟩
      intro single
      exact notOne with ((singleton.membership at s, ℂ[1]).forward with single)
    have agree : ∀ z ∈ complexCarrier ∖ {ℂ[1]},
        entireLMap(N, χ)(z) = LFunctionMap(N, χ)(z)
      intros z hz
      have zC := inside with z, hz
      rw [(entireLMap.apply with zC), (LFunctionMap.value with values, zC),
        (entireL.of_not_principal with values, zC, principal)]
    have derivative := tkKcomplexDeriv.agree with whole, holomorphic,
      inside, sU, agree
    have value : ℂ[complexDiv(principalIndicator(N, χ), ℂ[s - 1]) -
        logDerivEntireL(N, χ, s)] = ℂ[-logDeriv(LFunctionMap(N, χ),
        complexCarrier ∖ {ℂ[1]}, s)]
      have inverse := complexInv.member with shifted
      have pointValue := agree with s, sU
      rw (entireLMap.apply with hs) at pointValue
      have dMember := complexDeriv.closed at LFunctionMap(N, χ),
        complexCarrier ∖ {ℂ[1]}, s with holomorphic, sU
      have lMember := LFunction.closed with values, hs
      have lInverse := complexInv.member with lMember
      unfold logDerivEntireL
      unfold logDeriv
      rw [indicator, derivative, pointValue, (LFunctionMap.value with values, hs)]
      unfold complexDiv
      ring
    rw value
    exact has

-- PolarLandau.lean, tendsto_sub_mul_logDeriv_entireL: ord_s L̃ = 0 exactly
-- when L̃(s, χ) ≠ 0, and (z − s) L̃′/L̃(z, χ) → ord_s L̃ as z → s, z ≠ s.
theorem entireL.tendsto_sub_mul_logDeriv (N : Nat, χ s : Set)
  requires positive : (1:N) ≤ N
  requires character : DirichletCharacter(N, χ)
  requires hs : s ∈ complexCarrier
  shows (analyticOrderNat(entireLMap(N, χ), s) = (0:N) ↔
      entireL(N, χ, s) ≠ ℂ[0]) ∧
    HasPuncturedLimit(subMulMap(logDerivEntireLMap(N, χ), s), s,
      complexOfReal(realNat(analyticOrderNat(entireLMap(N, χ), s))))
proof
  have holomorphic := entireLMap.holomorphic with positive, character
  have analytic := ComplexAnalyticAt.of_holomorphic with holomorphic, hs
  -- L̃ is not identically 0 near s: it does not vanish at 2.
  have two : ℂ[2] ∈ complexCarrier by typecheck
  have reTwo := complexOfReal.re at R[2]
  have twoReal := complexOfReal.two
  rw twoReal at reTwo
  have halfPlane : (1:R) ≤ complexRe(ℂ[2]) by
    rw reTwo
    linarith
  have atTwo := entireL.ne_zero with positive, character, two, halfPlane
  have somewhere : ∃ b ∈ complexCarrier, entireLMap(N, χ)(b) ≠ complexZero by
    refine ⟨ℂ[2], two, ?_⟩
    rw (entireLMap.apply with two)
    exact atTwo
  have connected := ComplexConnected.whole
  have nonzero := EventuallyZeroAt.connected with holomorphic, connected, hs,
    somewhere
  have zeroIff := analyticOrderNat.zero_iff with analytic, nonzero
  rw (entireLMap.apply with hs) at zeroIff
  -- (z − s) L̃′/L̃(z) is (z − s) times Mathlib's logDeriv of L̃.
  have values : ∀ z ∈ complexCarrier, logDerivEntireLMap(N, χ)(z) ∈ complexCarrier by
    intros z hz
    rw (logDerivEntireLMap.value with positive, character, hz)
    exact logDerivEntireLMap.closed with positive, character, hz
  have agree : ∀ z ∈ complexCarrier,
      subMulMap(logDerivEntireLMap(N, χ), s)(z) =
        ℂ[(z - s) * logDeriv(entireLMap(N, χ), complexCarrier, z)] by
    intros z hz
    rw [(subMulMap.value with values, hs, hz),
      (logDerivEntireLMap.value with positive, character, hz)]
    unfold logDerivEntireL
    unfold logDeriv
    rw (entireLMap.apply with hz)
  have function := subMulMap.function with values, hs
  have limit := logDeriv.residue with holomorphic, hs, nonzero, agree,
    function
  refine ⟨zeroIff, ?_⟩
  unfold HasPuncturedLimit
  exact limit

-- The order of L̃ at s is a natural number, and it is 0 exactly where
-- L̃(s, χ) ≠ 0 (the first half of tendsto_sub_mul_logDeriv_entireL, with
-- the law of analyticOrderNatAt).
theorem entireL.order_facts (N : Nat, χ s : Set)
  requires positive : (1:N) ≤ N
  requires character : DirichletCharacter(N, χ)
  requires hs : s ∈ complexCarrier
  shows analyticOrderNat(entireLMap(N, χ), s) ∈ ℕ ∧
    (analyticOrderNat(entireLMap(N, χ), s) = (0:N) ↔
      entireL(N, χ, s) ≠ ℂ[0])
proof
  have analytic := entireL.analytic with positive, character, hs
  have selected := analyticOrderNat.selected at entireLMap(N, χ), s with
    analytic
  have facts := entireL.tendsto_sub_mul_logDeriv with positive, character, hs
  exact ⟨selected.left, facts.left⟩

-- Section: Landau's lemma
-- PolarLandau.lean, summable_taylor_of_removable: if z ↦ (z − a)Ψ(z) is
-- analytic on the disk of radius ε about z, a ≠ z, and a, σ lie in that
-- disk, then the Taylor series of Ψ at z converges at σ (Ψ is holomorphic
-- on the disk less a).
theorem taylorTerms.summable_of_removable (Ψ a z σ : Set, ε : Real)
  requires analytic : ComplexAnalyticOnNhd(subMulMap(Ψ, a), complexDisk(z, ε))
  requires different : z ≠ a
  requires aInside : a ∈ complexDisk(z, ε)
  requires σInside : σ ∈ complexDisk(z, ε)
  shows ComplexSummable(taylorTerms(Ψ, complexDisk(z, ε) ∖ {a}, z, σ))
proof
  sorry


-- IsPolar.landau for residues with complex values (r : ℂ → ℂ in the
-- source). Without them the statement above is not provable: a limit
-- (z − ρ)Φ(z) → r(ρ) toward a point r(ρ) outside ℂ holds vacuously (no
-- neighborhood of complexSpace contains it), so IsPolar does not pin
-- r(ρ) down at non-real ρ.
theorem lndIsPolar.landau (E r : Set, B : Real, ρ : Set)
  requires polar : IsPolar(E, r)
  requires values : ∀ z ∈ complexCarrier, r(z) ∈ complexCarrier
  requires bPositive : (0:R) < B
  requires residues : ∀ X ∈ ℝ, B < X → (0:R) ≤ complexRe(r(complexOfReal(X)))
  requires bound : ∃ V ∈ ℝ, ∀ W ∈ ℝ, V ≤ W → E(W) ≤ realExp(R[(B - 1) * W])
  requires hρ : ρ ∈ complexCarrier
  requires right : B < complexRe(ρ)
  shows r(ρ) = ℂ[0]
proof
  obtain ⟨function, measurable, C, hC, Φ, functionΦ, meromorphic, boundC,
    transform, analyticOne, residuesAt⟩ := polar
  obtain ⟨V, hV, boundV⟩ := bound
  have vT : Real(V) by typecheck
  have shifted : ∃ Y ∈ ℝ, (0:R) ≤ Y ∧
      (∀ W ∈ ℝ, Y ≤ W → E(W) ≤ realExp(R[(B - 1) * W]))
    by_cases nonneg : (0:R) ≤ V
    . exact ⟨V, hV, nonneg, boundV⟩
    . have zeroR : R[0] ∈ ℝ by typecheck
      refine ⟨R[0], zeroR, ?_, ?_⟩
      . linarith
      . intros W hW zeroLe
        have wT : Real(W) by typecheck
        have vLe : V ≤ W
          have total := realLess.trichotomy at V, R[0]
          cases total with less | rest
          . linarith
          . exfalso
            apply nonneg
            cases rest with equal | greater
            . linarith
            . linarith
        exact boundV with W, hW, vLe
  obtain ⟨Y, hY, yNonneg, boundY⟩ := shifted
  have yT : Real(Y) by typecheck
  have cT : Real(C) by typecheck
  have absC := abs.nonnegative at C
  have expY := realExp.positive at R[2 * Y]
  have expNonneg : (0:R) ≤ realExp(R[2 * Y]) by linarith
  have product := realMulValue.nonnegative at abs(C), realExp(R[2 * Y]) with
    absC, expNonneg
  have kReal : R[1 + abs(C) * realExp(R[2 * Y])] ∈ ℝ by typecheck
  have kOne : (1:R) ≤ R[1 + abs(C) * realExp(R[2 * Y])] by linarith
  have kLarge : R[abs(C) * realExp(R[2 * Y])] ≤
    R[1 + abs(C) * realExp(R[2 * Y])] by linarith
  have kNonneg : (0:R) ≤ R[1 + abs(C) * realExp(R[2 * Y])] by linarith
  have nonnegG := lndDensity.nonneg at E, C, R[1 + abs(C) * realExp(R[2 * Y])],
    B, Y with function, boundC, boundY, bPositive, yNonneg, kOne, kLarge
  have setting : lndSetting(E, Φ, C, R[1 + abs(C) * realExp(R[2 * Y])], B)
    exact ⟨function, measurable, functionΦ, meromorphic, boundC, transform,
      analyticOne, nonnegG, kNonneg, bPositive⟩
  exact lndLandau.core at E, Φ, r, C, R[1 + abs(C) * realExp(R[2 * Y])], B, ρ
    with setting, values, residuesAt, residues, hρ, right

-- PolarLandau.lean, IsPolar.landau (Landau's lemma). Let E be polar with
-- residues r, and β > 0. If re r(x) ≥ 0 for all real x > β and
-- E(v) ≤ e^((β−1)v) for large v, then r(ρ) = 0 whenever re ρ > β.
theorem IsPolar.landau (E r : Set, B : Real, ρ : Set)
  requires polar : IsPolar(E, r)
  requires values : ∀ z ∈ complexCarrier, r(z) ∈ complexCarrier
  requires bPositive : (0:R) < B
  requires residues : ∀ X ∈ ℝ, B < X → (0:R) ≤ complexRe(r(complexOfReal(X)))
  requires bound : ∃ V ∈ ℝ, ∀ W ∈ ℝ, V ≤ W → E(W) ≤ realExp(R[(B - 1) * W])
  requires hρ : ρ ∈ complexCarrier
  requires right : B < complexRe(ρ)
  shows r(ρ) = ℂ[0]
proof
  exact lndIsPolar.landau with *

end Landau
