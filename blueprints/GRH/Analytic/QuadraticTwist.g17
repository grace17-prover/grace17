-- Zero density for quadratic twists (Jutila): for ξ modulo N and η > 0,
-- only O(x^(1−η/2)) primes d ≤ x, d ≡ 7 mod 8, d prime to N, have a
-- zero of L̃(s, ξ·(·/d)) with re s ≥ 1/2 + 9η and |im s| ≤ y. Hence,
-- with Dirichlet's theorem, some prime d of a given unit class has all
-- its quadratic twists zero-free on re s ≥ β, |im s| ≤ y, for any
-- β > 1/2. The proof runs through a three-lines bound for Γ_j L at a zero
-- and a smoothed mean square of Jacobi symbol sums.
-- Source: grh-compact/src/Lib/Analytic/QuadraticTwist/ZeroFreeTwist.lean.
-- "Known result: Zero density for quadratic twists by mean values over
-- real characters." Related work: Jutila, On mean values of Dirichlet
-- polynomials with real characters, Acta Arith. 27 (1975) 191-198.
-- Part of the GRH blueprint (layer 4, Lib/Analytic).
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Analytic.QuadraticTwist
import GRH.Analytic.Primes

section QuadraticTwist
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- Section: Definitions
-- The product of the Legendre symbols (a/p) over a list of primes p.
def legendreListProduct (a : Set, xs : List(ℕ)) → Set
  | a, [] => realOne
  | a, x :: rest => realMul(legendreSign(x, a), legendreListProduct(a, rest))

-- The Jacobi symbol (a/m) of an integer a and m ≥ 1 (Mathlib's
-- jacobiSym a m): the product of (a/p) over the prime factors p of m,
-- with multiplicity; the value does not depend on the order of the
-- factorization.
def jacobiSign (a : Set, m : Nat) : Set :=
  ⋃({ w ∈ ℝ | ∃ xs, List(ℕ, xs) ∧ PrimeList(xs) ∧ listProduct(xs) = m ∧
    w = legendreListProduct(a, xs) })

-- The terms (−v/m), v = 1, 2, …, indexed from 0 as v = n + 1.
def jacobiNegTerms (m : Nat) : Set :=
  { (n, jacobiSign(integerNegValue(integerOfNat(succ(n))), m)) | n ∈ ℕ }

-- The coefficients n ↦ c(n) (−v/n).
def jacobiTwistCoefficients (c : Set, v : Nat) : Set :=
  { (n, ℂ[c(n) * complexOfReal(jacobiSign(integerNegValue(integerOfNat(v)),
      n))]) | n ∈ ℕ }

-- The terms |θ_j(n ↦ c(n)(−v/n))(t)|², v = 1, 2, … (indexed from 0).
def jacobiThetaSquareTerms (j : Nat, c : Set, T : Real) : Set :=
  { (n, R[complexAbs(gaussianTheta(j, jacobiTwistCoefficients(c, succ(n)),
      T)) ^ 2]) | n ∈ ℕ }

-- The terms ∫_{1/T}^∞ |θ_j(n ↦ c(n)(−v/n))(t)| dt/√t, v = 1, 2, ….
def jacobiThetaTailTerms (j : Nat, c : Set, T : Real) : Set :=
  { (n, thetaTailIntegral(j, jacobiTwistCoefficients(c, succ(n)),
      realInvValue(T))) | n ∈ ℕ }

-- The primes d ≤ x, d ≡ 7 mod 8, prime to N, for which some L̃(s, ξ·(·/d))
-- vanishes on re s ≥ 1/2 + 9η, |im s| ≤ y.
def zeroTwistPrimes (N : Nat, ξ : Set, H Y : Real, x : Nat) : Set :=
  { d ∈ ℕ | (1:N) ≤ d ∧ d ≤ x ∧ Prime(d) ∧ d % 8 = (7:N) ∧
    gcd(N, d) = (1:N) ∧
    (∃ s ∈ complexCarrier, R[1 / 2 + 9 * H] ≤ complexRe(s) ∧
      abs(complexIm(s)) ≤ Y ∧ entireL(N * d, quadTwist(N, ξ, d), s) = ℂ[0]) }

-- Section: The three-lines bound
-- ZeroFreeTwist.lean, norm_mul_moebius_le_one: |ξ(n) μ(n)| ≤ 1.
theorem moebiusTwist.abs_le_one (N : Nat, ξ : Set, n : Nat)
  requires character : DirichletCharacter(N, ξ)
  shows complexAbs(coefficientMul(characterCoefficients(ξ),
    moebiusCoefficients)(n)) ≤ (1:R)
proof
  sorry

-- ZeroFreeTwist.lean, three_lines_bound_of_LFunction_eq_zero: for j ≤ 1
-- some C has |Γ_j(s)|² ≤ C T^(−2η) whenever χ ≠ 1 is primitive modulo
-- q ≤ T² of parity j, L(s, χ) = 0, 1/2 + 9η ≤ re s ≤ 1, and the tail
-- integrals from 1/T of the theta series of χ and of μχ total at most
-- T^(2η).
theorem gaussianMellin.three_lines_bound (j : Nat)
  requires small : j ≤ (1:N)
  shows ∃ C ∈ ℝ, ∀ H ∈ ℝ, ∀ T ∈ ℝ, ∀ q ∈ ℕ, ∀ χ, ∀ s ∈ complexCarrier,
    (1:N) ≤ q → DirichletCharacter(q, χ) → (0:R) < H →
    PrimitiveCharacter(q, χ) → χ ≠ principalCharacter(q) →
    HasParity(χ, j) → (0:R) < T → realNat(q) ≤ R[T ^ 2] →
    R[thetaTailIntegral(j, characterCoefficients(χ), realInvValue(T)) +
      thetaTailIntegral(j, coefficientMul(characterCoefficients(χ),
        moebiusCoefficients), realInvValue(T))] ≤
      realRpow(T, R[2 * H]) →
    LFunction(q, χ, s) = ℂ[0] → R[1 / 2 + 9 * H] ≤ complexRe(s) →
    complexRe(s) ≤ (1:R) →
    R[complexAbs(gaussianMellin(j, s)) ^ 2] ≤ R[C / realRpow(T, R[2 * H])]
proof
  sorry

-- Section: Mean values of Jacobi symbols
-- ZeroFreeTwist.lean, norm_sum_jacobiSym_le: if m ≥ 1 and neither m nor
-- 2m is a square, then |Σ_{1 ≤ v ≤ X} (−v/m)| ≤ 2√m (1 + log m).
theorem jacobiSign.abs_sum_le (m X : Nat)
  requires nonzero : m ≠ (0:N)
  requires notSquare : ¬IsSquare(m)
  requires notTwiceSquare : ¬IsSquare(2 * m)
  shows abs(realPartialSum(jacobiNegTerms(m), X)) ≤
    R[2 * realSqrt(realNat(m)) * (1 + realLog(realNat(m)))]
proof
  sorry

-- ZeroFreeTwist.lean, sum_sq_gaussianTheta_jacobiSym_le (the mean value
-- estimate): for j ≤ 1 and η > 0 some C has, for t ≥ 1/T > 0, X ≤ T² and
-- |c| ≤ 1, Σ_{1 ≤ v ≤ X} |Σ_{n ≥ 1} c(n)(−v/n) g_j(n t)|² ≤
-- C T² t^(−1−2η).
theorem jacobiTheta.sum_sq_le (j : Nat, H : Real)
  requires small : j ≤ (1:N)
  requires positive : (0:R) < H
  shows ∃ C ∈ ℝ, ∀ T ∈ ℝ, (0:R) < T → ∀ t ∈ ℝ, realInvValue(T) ≤ t →
    ∀ X ∈ ℕ, realNat(X) ≤ R[T ^ 2] → ∀ c,
    FunctionBetween(c, ℕ, complexCarrier) →
    (∀ n ∈ ℕ, complexAbs(c(n)) ≤ (1:R)) →
    realPartialSum(jacobiThetaSquareTerms(j, c, t), X) ≤
      R[C * (T ^ 2 * realRpow(t, R[-1 - 2 * H]))]
proof
  sorry

-- ZeroFreeTwist.lean, sum_thetaTailIntegral_le: for j ≤ 1 and η > 0 some
-- C has, for T > 0, X ≤ T² and |c| ≤ 1,
-- Σ_{1 ≤ v ≤ X} ∫_{1/T}^∞ |Σ_{n ≥ 1} c(n)(−v/n) g_j(n t)| dt/√t ≤
-- C T^(2+η).
theorem jacobiTheta.sum_tail_le (j : Nat, H : Real)
  requires small : j ≤ (1:N)
  requires positive : (0:R) < H
  shows ∃ C ∈ ℝ, ∀ T ∈ ℝ, (0:R) < T →
    ∀ X ∈ ℕ, realNat(X) ≤ R[T ^ 2] → ∀ c,
    FunctionBetween(c, ℕ, complexCarrier) →
    (∀ n ∈ ℕ, complexAbs(c(n)) ≤ (1:R)) →
    realPartialSum(jacobiThetaTailTerms(j, c, T), X) ≤
      R[C * realRpow(T, R[2 + H])]
proof
  sorry

-- Section: Zero density and a zero-free twist
-- ZeroFreeTwist.lean, zero_density_quadTwist (Jutila): for ξ modulo N,
-- η > 0 and real y, the primes d ≤ x, d ≡ 7 mod 8, d prime to N, with a
-- zero of L̃(s, ξ·(·/d)) on re s ≥ 1/2 + 9η, |im s| ≤ y, number
-- O(x^(1−η/2)).
theorem quadTwist.zero_density (N : Nat, ξ : Set, H Y : Real)
  requires positive : (1:N) ≤ N
  requires character : DirichletCharacter(N, ξ)
  requires hPositive : (0:R) < H
  shows ∃ C ∈ ℝ, ∃ x₀ ∈ ℕ, ∀ x ∈ ℕ, x₀ ≤ x →
    realNat(cardinality(zeroTwistPrimes(N, ξ, H, Y, x))) ≤
      R[C * realRpow(realNat(x), R[1 - H / 2])]
proof
  sorry

-- ZeroFreeTwist.lean, exists_entireL_quadTwist_ne_zero: let β > 1/2, y
-- real, and a a unit modulo N (an integer prime to N standing for its
-- class) whose primes are all ≡ 7 mod 8 and prime to N. Some prime
-- d ≡ a (mod N) has no L̃(s, ξ·(·/d)), ξ modulo N, vanishing on re s ≥ β,
-- |im s| ≤ y.
theorem entireL.exists_quadTwist_ne_zero_of_unit (N : Nat, a : Set,
    B Y : Real)
  requires positive : (1:N) ≤ N
  requires half : R[1 / 2] < B
  requires integer : a ∈ ℤ
  requires unit : IntegerCoprime(a, integerOfNat(N))
  requires classPrimes : ∀ d ∈ ℕ, Prime(d) → InResidueClass(N, d, a) →
    d % 8 = (7:N) ∧ gcd(N, d) = (1:N)
  shows ∃ d ∈ ℕ, Prime(d) ∧ InResidueClass(N, d, a) ∧
    (∀ ξ ∈ dirichletCharacters(N), ∀ s ∈ complexCarrier,
      B ≤ complexRe(s) → abs(complexIm(s)) ≤ Y →
      entireL(N * d, quadTwist(N, ξ, d), s) ≠ ℂ[0])
proof
  sorry

end QuadraticTwist
