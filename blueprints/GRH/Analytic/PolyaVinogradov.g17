-- The Pólya-Vinogradov inequality for a non-principal Dirichlet
-- character χ modulo q, on initial intervals:
-- |Σ_{1 ≤ v ≤ X} χ(v)| ≤ 2√q (1 + log q); and |τ(χ)| = √q for the Gauss
-- sum of a primitive character.
-- Source: grh-compact/src/Lib/Analytic/PolyaVinogradov/PolyaVinogradov.lean.
-- "Known result: the Pólya-Vinogradov inequality for sums of a
-- non-principal Dirichlet character." Related work: Pólya 1918,
-- Vinogradov 1918; Davenport, Multiplicative Number Theory;
-- Montgomery-Vaughan, Thm 9.18.
-- Part of the GRH blueprint (layer 4, Lib/Analytic).
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Analytic.PolyaVinogradov
import GRH.Analytic.Background

section PolyaVinogradov
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- Section: Definitions
-- The terms χ(1), χ(2), …, indexed from 0 as χ(n + 1); their partial sum
-- over n < X is Σ_{1 ≤ v ≤ X} χ(v) (the source's Σ over Ioc 0 X).
def characterShiftedTerms (χ : Set) : Set :=
  { (n, χ(integerOfNat(succ(n)))) | n ∈ ℕ }

-- Section: Gauss sums
-- PolyaVinogradov.lean, norm_gaussSum_of_isPrimitive: the Gauss sum of a
-- primitive character modulo q has absolute value √q.
theorem gaussSum.abs_of_primitive (q : Nat, χ : Set)
  requires positive : (1:N) ≤ q
  requires character : DirichletCharacter(q, χ)
  requires primitive : PrimitiveCharacter(q, χ)
  shows complexAbs(gaussSum(q, χ)) = realSqrt(realNat(q))
proof
  sorry

-- Section: Pólya-Vinogradov
-- PolyaVinogradov.lean, polya_vinogradov: for a non-principal character
-- χ modulo q and every X, |Σ_{1 ≤ v ≤ X} χ(v)| ≤ 2√q (1 + log q).
theorem characterSum.polya_vinogradov (q : Nat, χ : Set, X : Nat)
  requires positive : (1:N) ≤ q
  requires character : DirichletCharacter(q, χ)
  requires nonPrincipal : χ ≠ principalCharacter(q)
  shows complexAbs(complexPartialSum(characterShiftedTerms(χ), X)) ≤
    R[2 * realSqrt(realNat(q)) * (1 + realLog(realNat(q)))]
proof
  sorry

end PolyaVinogradov
