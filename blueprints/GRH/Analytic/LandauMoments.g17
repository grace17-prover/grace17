-- Moments of a density on (0, ∞) for Landau's lemma: the integrals
-- ∫₀^∞ D(v) vᵏ e^(−σ v) dv in [0, ∞] of a density D ≥ 0, their expansion
-- ∫ D(v) e^(−(x − t)v) dv = Σⱼ tʲ/j! ∫ D(v) vʲ e^(−x v) dv, and the power
-- series in s − x they give.
-- Part of the GRH blueprint (layer 4, Lib/Analytic).
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Analytic.LandauMoments
import GRH.Analytic.LandauTools

section LandauMoments
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- Section: Definitions
-- Lebesgue measure on (0, ∞).
def lndMeasure : Set :=
  restrictMeasure(realMeasurableSpace, realVolume, realIoi(realZero))

-- v ↦ vᵏ, v ↦ −σ v, v ↦ e^(−σ v), and v ↦ vᵏ e^(−σ v) on ℝ.
defgraph lndPow (k : Nat) (V ∈ ℝ) : ℝ := V ^ k
proof
  have vReal : Real(V) by exact member
  have powReal := realPow.real at V, k
  unfold realPow at powReal
  exact powReal
defgraph lndLin (σ : Real) (V ∈ ℝ) : ℝ := R[-(σ * V)]
proof
  have vReal : Real(V) by exact member
  typecheck
defgraph lndExpLin (σ : Real) (V ∈ ℝ) : ℝ := realExp(R[-(σ * V)])
proof
  have vReal : Real(V) by exact member
  typecheck
defgraph lndPowExp (σ : Real, k : Nat) (V ∈ ℝ) : ℝ :=
    R[V ^ k * realExp(R[-(σ * V)])]
proof
  have vReal : Real(V) by exact member
  have powReal := realPow.real at V, k
  unfold realPow at powReal
  typecheck

-- v ↦ D(v) vᵏ e^(−σ v), as a real map and in [0, ∞].
def lndRealValues (D : Set, σ : Real, k : Nat) : Set :=
  { R[D(W) * (W ^ k * realExp(R[-(σ * W)]))] | W ∈ ℝ }
defgraph lndReal (D : Set, σ : Real, k : Nat) (V ∈ ℝ) :
    lndRealValues(D, σ, k) := R[D(V) * (V ^ k * realExp(R[-(σ * V)]))]
proof
  unfold lndRealValues
  simp

def lndTermValues (D : Set, σ : Real, k : Nat) : Set :=
  { ennOfReal(R[D(W) * (W ^ k * realExp(R[-(σ * W)]))]) | W ∈ ℝ }
defgraph lndTerm (D : Set, σ : Real, k : Nat) (V ∈ ℝ) :
    lndTermValues(D, σ, k) :=
    ennOfReal(R[D(V) * (V ^ k * realExp(R[-(σ * V)]))])
proof
  unfold lndTermValues
  simp

-- The moment ∫₀^∞ D(v) vᵏ e^(−σ v) dv in [0, ∞].
def lndMoment (D : Set, σ : Real, k : Nat) : Set :=
  lintegral(realMeasurableSpace, lndMeasure, lndTerm(D, σ, k))

-- Section: The measure
theorem lndMeasure.measure
  shows Measure(realMeasurableSpace, lndMeasure)
proof
  have volume := realVolume.measure
  have intervals := MeasurableSet.real_intervals at realZero, realZero
  unfold lndMeasure
  exact restrictMeasure.measure with volume, intervals.left

-- What holds on (0, ∞) holds almost everywhere.
theorem lndMeasure.ae (S : Set)
  requires holds : realIoi(realZero) ⊆ S
  shows AlmostEverywhere(realMeasurableSpace, lndMeasure, S)
proof
  have volume := realVolume.measure
  have intervals := MeasurableSet.real_intervals at realZero, realZero
  unfold lndMeasure
  exact AlmostEverywhere.restrict_of_forall with volume, intervals.left,
    holds

-- Section: The integrands
theorem lndTerm.valued (D : Set, σ : Real, k : Nat)
  requires values : ∀ W ∈ ℝ, D(W) ∈ ℝ
  shows EnnValued(realMeasurableSpace, lndTerm(D, σ, k))
proof
  unfold EnnValued
  unfold MapsInto
  intros V hV
  rw realMeasurableSpace.carrier at hV
  have dv := values with V, hV
  have vReal : Real(V) by typecheck
  rw (lndTerm.value at D, σ, k, V with hV)
  have member := ennOfReal.member at R[D(V) * (V ^ k * realExp(R[-(σ * V)]))]
  exact member.left

-- For v > 0 the integrand is the real number D(v) vᵏ e^(−σ v) ≥ 0.
theorem lndTerm.real (D : Set, σ : Real, k : Nat, V : Real)
  requires values : ∀ W ∈ ℝ, D(W) ∈ ℝ
  requires nonneg : ∀ W ∈ ℝ, (0:R) < W → (0:R) ≤ D(W)
  requires positive : (0:R) < V
  shows lndTerm(D, σ, k)(V) = R[D(V) * (V ^ k * realExp(R[-(σ * V)]))] ∧
    (0:R) ≤ R[D(V) * (V ^ k * realExp(R[-(σ * V)]))]
proof
  have vR : V ∈ ℝ by typecheck
  have dv := values with V, vR
  have dReal : Real(D(V)) by typecheck
  have dNonneg := nonneg with V, vR, positive
  have vNonneg : (0:R) ≤ V by linarith
  have powNonneg := realPow.nonnegative at V, k with vNonneg
  unfold realPow at powNonneg
  have expPositive := realExp.positive at R[-(σ * V)]
  have expNonneg : (0:R) ≤ realExp(R[-(σ * V)]) by linarith
  have inner := realMulValue.nonnegative at V ^ k, realExp(R[-(σ * V)]) with
    powNonneg, expNonneg
  have outer := realMulValue.nonnegative at D(V),
    R[V ^ k * realExp(R[-(σ * V)])] with dNonneg, inner
  refine ⟨?_, outer⟩
  rw [(lndTerm.value at D, σ, k, V with vR),
    (ennOfReal.of_nonneg at R[D(V) * (V ^ k * realExp(R[-(σ * V)]))] with
      outer)]

-- Section: Measurability
theorem lndPow.measurable (k : Nat)
  shows Measurable(lndPow(k), realMeasurableSpace, realMeasurableSpace)
proof
  have space := realMeasurableSpace.space
  have identity := Measurable.identity with space
  induction k
  | zero =>
    have one : realOne ∈ MeasurableSpace.carrier(realMeasurableSpace)
      rw realMeasurableSpace.carrier
      typecheck
    have constant : ∀ x ∈ MeasurableSpace.carrier(realMeasurableSpace),
        lndPow((0:N))(x) = realOne
      intros x hx
      rw realMeasurableSpace.carrier at hx
      rw [(lndPow.value at (0:N), x with hx), monoidPow.zero]
    exact Measurable.constant with space, space, one, constant
  | succ(j) using ih =>
    have product : ∀ x ∈ MeasurableSpace.carrier(realMeasurableSpace),
        lndPow(succ(j))(x) = R[lndPow(j)(x) *
          identity(MeasurableSpace.carrier(realMeasurableSpace))(x)]
      intros x hx
      have xR := hx
      rw realMeasurableSpace.carrier at xR
      have xReal : Real(x) by typecheck
      rw [(lndPow.value at succ(j), x with xR), (lndPow.value at j, x with xR),
        (identity.apply with hx), monoidPow.succ]
      ring
    exact Measurable.real_mul with ih, identity, product

theorem lndLin.measurable (σ : Real)
  shows Measurable(lndLin(σ), realMeasurableSpace, realMeasurableSpace)
proof
  have space := realMeasurableSpace.space
  have identity := Measurable.identity with space
  have member : R[-σ] ∈ MeasurableSpace.carrier(realMeasurableSpace)
    rw realMeasurableSpace.carrier
    typecheck
  have constantMap : ∀ x ∈ MeasurableSpace.carrier(realMeasurableSpace),
      constantOn(MeasurableSpace.carrier(realMeasurableSpace), R[-σ])(x) =
        R[-σ]
    intros x hx
    exact constantOn.apply with hx
  have constant := Measurable.constant with space, space, member, constantMap
  have product : ∀ x ∈ MeasurableSpace.carrier(realMeasurableSpace),
      lndLin(σ)(x) = R[constantOn(MeasurableSpace.carrier(realMeasurableSpace),
        R[-σ])(x) * identity(MeasurableSpace.carrier(realMeasurableSpace))(x)]
    intros x hx
    have xR := hx
    rw realMeasurableSpace.carrier at xR
    have xReal : Real(x) by typecheck
    rw [(lndLin.value at σ, x with xR), (constantOn.apply with hx),
      (identity.apply with hx)]
    ring
  exact Measurable.real_mul with constant, identity, product

theorem lndExpLin.measurable (σ : Real)
  shows Measurable(lndExpLin(σ), realMeasurableSpace, realMeasurableSpace)
proof
  have spaceLine := realLine.space
  have continuous := (Continuous.iff_real_line at realExp).forward with
    realExp.continuous
  have expMeasurable : Measurable(realExp, realMeasurableSpace,
      realMeasurableSpace)
    unfold realMeasurableSpace
    exact Measurable.of_continuous with spaceLine, spaceLine, continuous
  have linear := lndLin.measurable at σ
  have composite : ∀ x ∈ MeasurableSpace.carrier(realMeasurableSpace),
      lndExpLin(σ)(x) = realExp(lndLin(σ)(x))
    intros x hx
    rw realMeasurableSpace.carrier at hx
    rw [(lndExpLin.value at σ, x with hx), (lndLin.value at σ, x with hx)]
  exact Measurable.comp with linear, expMeasurable, composite

theorem lndTerm.measurable (D : Set, σ : Real, k : Nat)
  requires values : ∀ W ∈ ℝ, D(W) ∈ ℝ
  requires measurable : Measurable(D, realMeasurableSpace, realMeasurableSpace)
  shows Measurable(lndTerm(D, σ, k), realMeasurableSpace, ennMeasurableSpace)
proof
  have power := lndPow.measurable at k
  have exponential := lndExpLin.measurable at σ
  have productPE : ∀ x ∈ MeasurableSpace.carrier(realMeasurableSpace),
      lndPowExp(σ, k)(x) = R[lndPow(k)(x) * lndExpLin(σ)(x)]
    intros x hx
    rw realMeasurableSpace.carrier at hx
    rw [(lndPowExp.value at σ, k, x with hx), (lndPow.value at k, x with hx),
      (lndExpLin.value at σ, x with hx)]
  have measurablePE := Measurable.real_mul with power, exponential, productPE
  have productR : ∀ x ∈ MeasurableSpace.carrier(realMeasurableSpace),
      lndReal(D, σ, k)(x) = R[D(x) * lndPowExp(σ, k)(x)]
    intros x hx
    rw realMeasurableSpace.carrier at hx
    rw [(lndReal.value at D, σ, k, x with hx), (lndPowExp.value at σ, k, x with hx)]
  have measurableR := Measurable.real_mul with measurable, measurablePE,
    productR
  have cast : ∀ x ∈ MeasurableSpace.carrier(realMeasurableSpace),
      lndTerm(D, σ, k)(x) = ennOfReal(lndReal(D, σ, k)(x))
    intros x hx
    rw realMeasurableSpace.carrier at hx
    rw [(lndTerm.value at D, σ, k, x with hx), (lndReal.value at D, σ, k, x with hx)]
  exact Measurable.enn_of_real with measurableR, cast

-- Section: Moments
theorem lndMoment.member (D : Set, σ : Real, k : Nat)
  shows lndMoment(D, σ, k) ∈ ennreal
proof
  have measure := lndMeasure.measure
  unfold lndMoment
  exact lintegral.member with measure

-- σ ↦ ∫ D(v) e^(−σ v) dv is nonincreasing.
theorem lndMoment.antitone (D : Set, σ τ : Real)
  requires values : ∀ W ∈ ℝ, D(W) ∈ ℝ
  requires nonneg : ∀ W ∈ ℝ, (0:R) < W → (0:R) ≤ D(W)
  requires le : σ ≤ τ
  shows EnnLe(lndMoment(D, τ, (0:N)), lndMoment(D, σ, (0:N)))
proof
  have measure := lndMeasure.measure
  have valuedT := lndTerm.valued at D, τ, (0:N) with values
  have valuedS := lndTerm.valued at D, σ, (0:N) with values
  have holds : realIoi(realZero) ⊆ ennLeSet(lndTerm(D, τ, (0:N)),
      lndTerm(D, σ, (0:N)), MeasurableSpace.carrier(realMeasurableSpace))
    intros V hV
    obtain ⟨vR, vPositive⟩ := realIoi.membership.forward with hV
    have vReal : Real(V) by typecheck
    obtain ⟨valueT, nonnegT⟩ := lndTerm.real at D, τ, (0:N), V with values,
      nonneg, vPositive
    obtain ⟨valueS, nonnegS⟩ := lndTerm.real at D, σ, (0:N), V with values,
      nonneg, vPositive
    apply ennLeSet.membership.backward
    refine ⟨?_, ?_⟩
    . rw realMeasurableSpace.carrier
      exact vR
    . rw [valueT, valueS]
      have dv := values with V, vR
      have dNonneg := nonneg with V, vR, vPositive
      have vNonneg : (0:R) ≤ V by linarith
      have scaled := realLe.mul_right_of_nonnegative at σ, τ, V with le,
        vNonneg
      have negated : R[-(τ * V)] ≤ R[-(σ * V)] by linarith
      have expLe := realExp.monotone with negated
      have one : V ^ (0:N) = (1:R) by rw monoidPow.zero
      rw one
      have left : R[1 * realExp(R[-(τ * V)])] = realExp(R[-(τ * V)]) by ring
      have right : R[1 * realExp(R[-(σ * V)])] = realExp(R[-(σ * V)]) by ring
      have inner : R[1 * realExp(R[-(τ * V)])] ≤ R[1 * realExp(R[-(σ * V)])]
        by linarith
      have product := realLe.mul_left_of_nonnegative at
        R[1 * realExp(R[-(τ * V)])], R[1 * realExp(R[-(σ * V)])], D(V) with
        inner, dNonneg
      rw one at nonnegT
      have rT : R[D(V) * (1 * realExp(R[-(τ * V)]))] ∈ ℝ by typecheck
      have rS : R[D(V) * (1 * realExp(R[-(σ * V)]))] ∈ ℝ by typecheck
      exact (EnnLe.lint_real_iff with rT, rS, nonnegT).backward with product
  have ae := lndMeasure.ae with holds
  unfold lndMoment
  exact lintegral.mono_ae with measure, valuedT, valuedS, ae

-- Section: The exponential series
-- j ↦ (v ↦ tʲ/j! · D(v) vʲ e^(−x v)), and j ↦ tʲ/j! · ∫ D(v) vʲ e^(−x v) dv.
def lndSeriesTermValues (D : Set, x t : Real) : Set :=
  { ennConstMulOn(realExpTerms(t)(j), lndTerm(D, x, j), ℝ) | j ∈ ℕ }
defgraph lndSeriesTerm (D : Set, x t : Real) (j ∈ ℕ) :
    lndSeriesTermValues(D, x, t) :=
    ennConstMulOn(realExpTerms(t)(j), lndTerm(D, x, j), ℝ)
proof
  unfold lndSeriesTermValues
  simp

def lndMomentSeriesValues (D : Set, x t : Real) : Set :=
  { ennMul(realExpTerms(t)(j), lndMoment(D, x, j)) | j ∈ ℕ }
defgraph lndMomentSeries (D : Set, x t : Real) (j ∈ ℕ) :
    lndMomentSeriesValues(D, x, t) :=
    ennMul(realExpTerms(t)(j), lndMoment(D, x, j))
proof
  unfold lndMomentSeriesValues
  simp

-- tʲ/j! is a nonnegative real number.
theorem lndCoefficient.facts (t : Real, j : Set)
  requires tNonneg : (0:R) ≤ t
  requires hj : j ∈ ℕ
  shows realExpTerms(t)(j) ∈ ennreal ∧ realExpTerms(t)(j) ∈ ℝ ∧
    (0:R) ≤ realExpTerms(t)(j)
proof
  have jNat := nat.omega.backward at j with hj
  have nonnegJ := realExpTerms.nonnegative at t, j with tNonneg
  have realJ := FunctionBetween.apply_closed with (realExpTerms.function at t),
    hj
  have realT : Real(realExpTerms(t)(j)) by exact realJ
  exact ⟨(ennreal.real_member at realExpTerms(t)(j) with nonnegJ), realJ,
    nonnegJ⟩

-- The terms of the series are measurable.
theorem lndSeriesTerm.measurable (D : Set, x t : Real)
  requires values : ∀ W ∈ ℝ, D(W) ∈ ℝ
  requires measurable : Measurable(D, realMeasurableSpace, realMeasurableSpace)
  requires tNonneg : (0:R) ≤ t
  shows ∀ j ∈ ℕ, Measurable(lndSeriesTerm(D, x, t)(j), realMeasurableSpace,
    ennMeasurableSpace)
proof
  intros j hj
  have jNat := nat.omega.backward at j with hj
  have space := realMeasurableSpace.space
  have ennSpace := ennMeasurableSpace.space
  obtain ⟨cEnn, cReal, cNonneg⟩ := lndCoefficient.facts with tNonneg, hj
  have member : realExpTerms(t)(j) ∈ MeasurableSpace.carrier(ennMeasurableSpace)
    rw ennMeasurableSpace.carrier
    exact cEnn
  have constantMap : ∀ v ∈ MeasurableSpace.carrier(realMeasurableSpace),
      constantOn(ℝ, realExpTerms(t)(j))(v) = realExpTerms(t)(j)
    intros v hv
    rw realMeasurableSpace.carrier at hv
    exact constantOn.apply with hv
  have constant := Measurable.constant with space, ennSpace, member,
    constantMap
  have term := lndTerm.measurable at D, x, j with values, measurable
  have product : ∀ v ∈ MeasurableSpace.carrier(realMeasurableSpace),
      ennConstMulOn(realExpTerms(t)(j), lndTerm(D, x, j), ℝ)(v) =
        ennMul(constantOn(ℝ, realExpTerms(t)(j))(v), lndTerm(D, x, j)(v))
    intros v hv
    rw realMeasurableSpace.carrier at hv
    rw [(ennConstMulOn.apply with hv), (constantOn.apply with hv)]
  rw (lndSeriesTerm.value at D, x, t, j with hj)
  exact Measurable.enn_mul with constant, term, product

-- Pointwise: for v > 0, D(v) e^(−(x − t)v) = Σⱼ tʲ/j! · D(v) vʲ e^(−x v).
theorem lndSeriesTerm.pointwise (D : Set, x t V : Real)
  requires values : ∀ W ∈ ℝ, D(W) ∈ ℝ
  requires nonneg : ∀ W ∈ ℝ, (0:R) < W → (0:R) ≤ D(W)
  requires tNonneg : (0:R) ≤ t
  requires positive : (0:R) < V
  shows lndTerm(D, R[x - t], (0:N))(V) =
    ennTsum(familyAt(lndSeriesTerm(D, x, t), ℕ, V), ℕ)
proof
  have vR : V ∈ ℝ by typecheck
  have dv := values with V, vR
  have dNonneg := nonneg with V, vR, positive
  have vNonneg : (0:R) ≤ V by linarith
  have tvNonneg := realMulValue.nonnegative at t, V with tNonneg, vNonneg
  have expPositive := realExp.positive at R[-(x * V)]
  have expNonneg : (0:R) ≤ realExp(R[-(x * V)]) by linarith
  have cNonneg := realMulValue.nonnegative at D(V), realExp(R[-(x * V)]) with
    dNonneg, expNonneg
  -- the terms
  have terms : ∀ j ∈ ℕ, familyAt(lndSeriesTerm(D, x, t), ℕ, V)(j) =
      R[R[D(V) * realExp(R[-(x * V)])] * realExpTerms(R[t * V])(j)]
    intros j hj
    have jNat := nat.omega.backward at j with hj
    obtain ⟨cEnn, cReal, cNonneg2⟩ := lndCoefficient.facts with tNonneg, hj
    obtain ⟨termValue, termNonneg⟩ := lndTerm.real at D, x, j, V with values,
      nonneg, positive
    have termReal : R[D(V) * (V ^ j * realExp(R[-(x * V)]))] ∈ ℝ by typecheck
    rw [(familyAt.apply with hj), (lndSeriesTerm.value at D, x, t, j with hj),
      (ennConstMulOn.apply with vR), termValue,
      (ennMul.finite with cReal, termReal, cNonneg2, termNonneg),
      (realExpTerms.value at t, j with hj),
      (realExpTerms.value at R[t * V], j with hj)]
    have powers := realPow.mul at t, V, j
    unfold realPow at powers
    rw [powers, realDiv.eq_mul_inv, realDiv.eq_mul_inv]
    ring
  have sequence := realExpTerms.sequence at R[t * V]
  have termNonneg : ∀ n ∈ ℕ, realZero ≤ realExpTerms(R[t * V])(n)
    intros n hn
    have nNat := nat.omega.backward at n with hn
    exact realExpTerms.nonnegative at R[t * V], n with tvNonneg
  have sums := realExp.sums at R[t * V]
  have hasSum := RealHasSum.of_nonneg_sums_to with sequence, termNonneg, sums
  have termValues : ∀ n ∈ ℕ, realExpTerms(R[t * V])(n) ∈ ℝ
    intros n hn
    exact FunctionBetween.apply_closed with sequence, hn
  have scaled := RealHasSum.mul_left at realExpTerms(R[t * V]),
    familyAt(lndSeriesTerm(D, x, t), ℕ, V), ℕ,
    R[D(V) * realExp(R[-(x * V)])], realExp(R[t * V]) with termValues, terms,
    hasSum
  have familyValues : ∀ j ∈ ℕ, familyAt(lndSeriesTerm(D, x, t), ℕ, V)(j) ∈ ℝ
    intros j hj
    have tj := termValues with j, hj
    rw (terms with j, hj)
    typecheck
  have familyNonneg : ∀ j ∈ ℕ,
      realZero ≤ familyAt(lndSeriesTerm(D, x, t), ℕ, V)(j)
    intros j hj
    have tj := termValues with j, hj
    have nj := termNonneg with j, hj
    rw (terms with j, hj)
    exact realMulValue.nonnegative at R[D(V) * realExp(R[-(x * V)])],
      realExpTerms(R[t * V])(j) with cNonneg, nj
  have total := ennTsum.of_hasSum with familyValues, familyNonneg, scaled
  rw total
  obtain ⟨value0, _⟩ := lndTerm.real at D, R[x - t], (0:N), V with values,
    nonneg, positive
  rw [value0, monoidPow.zero]
  have split : R[-(R[x - t] * V)] = R[-(x * V) + t * V] by ring
  rw [split, realExp.add]
  ring

-- ∫ D(v) e^(−(x − t)v) dv = Σⱼ tʲ/j! ∫ D(v) vʲ e^(−x v) dv for t ≥ 0.
theorem lndMoment.series (D : Set, x t : Real)
  requires values : ∀ W ∈ ℝ, D(W) ∈ ℝ
  requires measurable : Measurable(D, realMeasurableSpace, realMeasurableSpace)
  requires nonneg : ∀ W ∈ ℝ, (0:R) < W → (0:R) ≤ D(W)
  requires tNonneg : (0:R) ≤ t
  shows lndMoment(D, R[x - t], (0:N)) = ennTsum(lndMomentSeries(D, x, t), ℕ)
proof
  have measure := lndMeasure.measure
  have measurableU := lndSeriesTerm.measurable at D, x, t with values,
    measurable, tNonneg
  have tsum := lintegral.tsum at realMeasurableSpace, lndMeasure,
    lndSeriesTerm(D, x, t) with measure, measurableU
  have termsAgree : ∀ j ∈ ℕ, lintegralSequence(realMeasurableSpace,
      lndMeasure, lndSeriesTerm(D, x, t))(j) = lndMomentSeries(D, x, t)(j)
    intros j hj
    have jNat := nat.omega.backward at j with hj
    obtain ⟨cEnn, cReal, cNonneg⟩ := lndCoefficient.facts with tNonneg, hj
    have term := lndTerm.measurable at D, x, j with values, measurable
    have constMul := lintegral.const_mul with measure, cEnn, term
    rw realMeasurableSpace.carrier at constMul
    rw [(lintegralSequence.lint_apply with hj),
      (lndSeriesTerm.value at D, x, t, j with hj),
      (lndMomentSeries.value at D, x, t, j with hj), constMul]
    unfold lndMoment
    rfl
  have right := ennTsum.congr with termsAgree
  rw ← right
  rw ← tsum
  have valuedF := lndTerm.valued at D, R[x - t], (0:N) with values
  have valuedG : EnnValued(realMeasurableSpace, ennTsumOn(lndSeriesTerm(D, x, t),
      MeasurableSpace.carrier(realMeasurableSpace)))
    unfold EnnValued
    unfold MapsInto
    intros V hV
    rw (ennTsumOn.lint_apply with hV)
    have memberV := hV
    rw realMeasurableSpace.carrier at memberV
    apply ennTsum.member
    intros j hj
    have jNat := nat.omega.backward at j with hj
    have valuedJ := lndTerm.valued at D, x, j with values
    obtain ⟨cEnn, cReal, cNonneg⟩ := lndCoefficient.facts with tNonneg, hj
    unfold EnnValued at valuedJ
    unfold MapsInto at valuedJ
    have termJ := valuedJ with V, hV
    rw [(familyAt.apply with hj), (lndSeriesTerm.value at D, x, t, j with hj),
      (ennConstMulOn.apply with memberV)]
    exact ennMul.member with cEnn, termJ
  have holds : realIoi(realZero) ⊆ equalizer(lndTerm(D, R[x - t], (0:N)),
      ennTsumOn(lndSeriesTerm(D, x, t),
        MeasurableSpace.carrier(realMeasurableSpace)),
      MeasurableSpace.carrier(realMeasurableSpace))
    intros V hV
    obtain ⟨vR, vPositive⟩ := realIoi.membership.forward with hV
    have vReal : Real(V) by typecheck
    have vCarrier : V ∈ MeasurableSpace.carrier(realMeasurableSpace)
      rw realMeasurableSpace.carrier
      exact vR
    apply equalizer.membership.backward
    refine ⟨vCarrier, ?_⟩
    rw (ennTsumOn.lint_apply with vCarrier)
    exact lndSeriesTerm.pointwise at D, x, t, V with values, nonneg, tNonneg,
      vPositive
  have ae := lndMeasure.ae with holds
  have equal : AEEqual(realMeasurableSpace, lndMeasure,
      lndTerm(D, R[x - t], (0:N)), ennTsumOn(lndSeriesTerm(D, x, t),
        MeasurableSpace.carrier(realMeasurableSpace))) := ae
  unfold lndMoment
  exact lintegral.congr_ae with measure, valuedF, valuedG, equal

-- Section: The power series of the moments
-- (−1)ʲ/j! · (t − x)ʲ = (x − t)ʲ/j!.
theorem lndExpTerms.flip (x t : Real, j : Nat)
  shows R[realExpTerms(R[-1])(j) * R[t - x] ^ j] = realExpTerms(R[x - t])(j)
proof
  have hj : j ∈ ℕ by typecheck
  have pm := realPow.mul at R[-1], R[t - x], j
  unfold realPow at pm
  have prod : R[-1 * (t - x)] = R[x - t] by ring
  rw prod at pm
  rw [(realExpTerms.value at R[-1], j with hj),
    (realExpTerms.value at R[x - t], j with hj), pm, realDiv.eq_mul_inv,
    realDiv.eq_mul_inv]
  ring

-- 1/j! · ρʲ = ρʲ/j!.
theorem lndExpTerms.one (ρ : Real, j : Nat)
  shows R[realExpTerms(R[1])(j) * ρ ^ j] = realExpTerms(ρ)(j)
proof
  have hj : j ∈ ℕ by typecheck
  have pm := realPow.mul at R[1], ρ, j
  unfold realPow at pm
  have prod : R[1 * ρ] = ρ by ring
  rw prod at pm
  have onePow := realPow.one at j
  unfold realPow at onePow
  rw [(realExpTerms.value at R[1], j with hj),
    (realExpTerms.value at ρ, j with hj), onePow, realDiv.eq_mul_inv,
    realDiv.eq_mul_inv]
  ring

-- ρʲ/j! > 0 for ρ > 0.
theorem lndExpTerms.positive (ρ : Real, j : Nat)
  requires positive : (0:R) < ρ
  shows (0:R) < realExpTerms(ρ)(j)
proof
  have hj : j ∈ ℕ by typecheck
  have powPositive := realPow.positive at ρ, j with positive
  unfold realPow at powPositive
  have factPositive := realNat.factorial_pos at j
  have invPositive := realInvValue.positive with factPositive
  have prodPositive := realMulValue.positive with powPositive, invPositive
  rw [(realExpTerms.value at ρ, j with hj), realDiv.eq_mul_inv]
  exact prodPositive

-- The coefficients (−1)ᵏ/k! · ∫ D(v) vᵏ e^(−x v) dv of the expansion at x.
defgraph lndCoeff (D : Set, x : Real) (k ∈ ℕ) : complexCarrier :=
    complexOfReal(R[realExpTerms(R[-1])(k) * ennToReal(lndMoment(D, x, k))])
proof
  have kNat := nat.omega.backward at k with member
  have e := FunctionBetween.apply_closed with
    (realExpTerms.function at R[-1]), member
  have m := ennToReal.boch_member with (lndMoment.member at D, x, k)
  typecheck

-- The series values tʲ/j! · mⱼ lie in [0, ∞].
theorem lndMomentSeries.values (D : Set, x t : Real)
  requires tNonneg : (0:R) ≤ t
  shows ∀ i ∈ ℕ, lndMomentSeries(D, x, t)(i) ∈ ennreal
proof
  intros i hi
  have iNat := nat.omega.backward at i with hi
  obtain ⟨cEnn, _, _⟩ := lndCoefficient.facts with tNonneg, hi
  rw (lndMomentSeries.value at D, x, t, i with hi)
  exact ennMul.member with cEnn, (lndMoment.member at D, x, i)

-- If the moment at σ < x is finite, so is every moment at x.
theorem lndMoment.finite_above (D : Set, σ x : Real, k : Nat)
  requires values : ∀ W ∈ ℝ, D(W) ∈ ℝ
  requires measurable : Measurable(D, realMeasurableSpace, realMeasurableSpace)
  requires nonneg : ∀ W ∈ ℝ, (0:R) < W → (0:R) ≤ D(W)
  requires below : σ < x
  requires finite : lndMoment(D, σ, (0:N)) ≠ ennTop
  shows lndMoment(D, x, k) ≠ ennTop
proof
  have sPositive : (0:R) < R[x - σ] by linarith
  have sNonneg : (0:R) ≤ R[x - σ] by linarith
  have series := lndMoment.series at D, x, R[x - σ] with values, measurable,
    nonneg, sNonneg
  have same : R[x - (x - σ)] = σ by ring
  rw same at series
  have hk : k ∈ ℕ by typecheck
  have seriesValues := lndMomentSeries.values at D, x, R[x - σ] with sNonneg
  have termLe := ennTsum.term_le with seriesValues, hk
  rw [(lndMomentSeries.value at D, x, R[x - σ], k with hk), ← series] at termLe
  intro top
  have coefficientPositive := lndExpTerms.positive at R[x - σ], k with
    sPositive
  have coefficientNonzero : realExpTerms(R[x - σ])(k) ≠ realZero
    intro zero
    rw zero at coefficientPositive
    linarith
  have mulTop := ennMul.top_right with coefficientNonzero, top
  rw mulTop at termLe
  have totalTop := EnnLe.top_eq with termLe
  exact finite with totalTop

-- The coefficients have radius at least x − σ when the moment at σ is
-- finite.
theorem lndCoeff.radius (D : Set, σ x : Real)
  requires values : ∀ W ∈ ℝ, D(W) ∈ ℝ
  requires measurable : Measurable(D, realMeasurableSpace, realMeasurableSpace)
  requires nonneg : ∀ W ∈ ℝ, (0:R) < W → (0:R) ≤ D(W)
  requires below : σ < x
  requires finite : lndMoment(D, σ, (0:N)) ≠ ennTop
  shows PowerSeriesRadiusAtLeast(lndCoeff(D, x), R[x - σ])
proof
  have sequence := lndCoeff.function at D, x
  have rReal : R[x - σ] ∈ ℝ by typecheck
  have total := lndMoment.member at D, σ, (0:N)
  obtain ⟨totalReal, totalNonneg⟩ := ennreal.finite with total, finite
  refine ⟨sequence, rReal, ?_⟩
  intros ρ hρ ρNonneg ρBelow
  have ρReal : Real(ρ) by typecheck
  refine ⟨lndMoment(D, σ, (0:N)), totalReal, ?_⟩
  intros n hn
  have nNat := nat.omega.backward at n with hn
  have mMember := lndMoment.member at D, x, n
  have mFinite := lndMoment.finite_above at D, σ, x, n with values,
    measurable, nonneg, below, finite
  obtain ⟨mReal, mNonneg⟩ := ennreal.finite with mMember, mFinite
  obtain ⟨toReal, _⟩ := ennToReal.of_finite with mMember, mFinite
  have eAbs := realExpTerms.abs at R[-1], n
  have absOne : abs(R[-1]) = R[1]
    have negOne := abs.neg at R[1]
    have oneNonneg : (0:R) ≤ R[1] by linarith
    have one := abs.of_nonnegative at R[1] with oneNonneg
    rw one at negOne
    exact negOne
  rw absOne at eAbs
  have eOne := FunctionBetween.apply_closed with
    (realExpTerms.function at R[1]), hn
  have eNeg := FunctionBetween.apply_closed with
    (realExpTerms.function at R[-1]), hn
  have coefficientAbs : R[complexAbs(lndCoeff(D, x)(n)) * ρ ^ n] =
      R[realExpTerms(ρ)(n) * lndMoment(D, x, n)]
    rw [(lndCoeff.value at D, x, n with hn), complexAbs.of_real, abs.mul, eAbs,
      toReal, (abs.of_nonnegative at lndMoment(D, x, n) with mNonneg)]
    rw ← (lndExpTerms.one at ρ, n)
    ring
  rw coefficientAbs
  have series := lndMoment.series at D, x, ρ with values, measurable, nonneg,
    ρNonneg
  have seriesValues := lndMomentSeries.values at D, x, ρ with ρNonneg
  have termLe := ennTsum.term_le with seriesValues, hn
  rw [(lndMomentSeries.value at D, x, ρ, n with hn), ← series] at termLe
  have le : σ ≤ R[x - ρ] by linarith
  have mono := lndMoment.antitone at D, σ, R[x - ρ] with values, nonneg, le
  have chain := EnnLe.transitive with termLe, mono
  obtain ⟨cEnn, cReal, cNonneg⟩ := lndCoefficient.facts with ρNonneg, hn
  rw (ennMul.finite with cReal, mReal, cNonneg, mNonneg) at chain
  exact EnnLe.boch_real with chain, totalReal

-- On the real axis the terms are (x − t)ʲ/j! · mⱼ.
theorem lndCoeff.term (D : Set, σ x t : Real, j : Nat)
  requires values : ∀ W ∈ ℝ, D(W) ∈ ℝ
  requires measurable : Measurable(D, realMeasurableSpace, realMeasurableSpace)
  requires nonneg : ∀ W ∈ ℝ, (0:R) < W → (0:R) ≤ D(W)
  requires below : σ < x
  requires finite : lndMoment(D, σ, (0:N)) ≠ ennTop
  shows powerSeriesTerms(lndCoeff(D, x), complexOfReal(x),
      complexOfReal(t))(j) =
    complexOfReal(R[realExpTerms(R[x - t])(j) * lndMoment(D, x, j)])
proof
  have hj : j ∈ ℕ by typecheck
  have sequence := lndCoeff.function at D, x
  have xC := complexOfReal.mem at x
  have tC := complexOfReal.mem at t
  have mMember := lndMoment.member at D, x, j
  have mFinite := lndMoment.finite_above at D, σ, x, j with values,
    measurable, nonneg, below, finite
  obtain ⟨mReal, mNonneg⟩ := ennreal.finite with mMember, mFinite
  obtain ⟨toReal, _⟩ := ennToReal.of_finite with mMember, mFinite
  have eNeg := FunctionBetween.apply_closed with
    (realExpTerms.function at R[-1]), hj
  have eFlip := FunctionBetween.apply_closed with
    (realExpTerms.function at R[x - t]), hj
  rw [(powerSeriesTerms.value with sequence, xC, tC, hj),
    (lndCoeff.value at D, x, j with hj), toReal, ← complexOfReal.sub,
    ← complexOfReal.pow, ← complexOfReal.mul]
  have inner : R[realExpTerms(R[-1])(j) * lndMoment(D, x, j) * (t - x) ^ j] =
      R[realExpTerms(R[x - t])(j) * lndMoment(D, x, j)]
    rw ← (lndExpTerms.flip at x, t, j)
    ring
  rw inner

-- The real and imaginary parts of the terms on the real axis.
theorem lndCoeff.parts (D : Set, σ x t : Real)
  requires values : ∀ W ∈ ℝ, D(W) ∈ ℝ
  requires measurable : Measurable(D, realMeasurableSpace, realMeasurableSpace)
  requires nonneg : ∀ W ∈ ℝ, (0:R) < W → (0:R) ≤ D(W)
  requires below : σ < x
  requires finite : lndMoment(D, σ, (0:N)) ≠ ennTop
  requires atMost : t ≤ x
  shows (∀ j ∈ ℕ, complexSequenceX(powerSeriesTerms(lndCoeff(D, x),
      complexOfReal(x), complexOfReal(t)))(j) =
      lndMomentSeries(D, x, R[x - t])(j)) ∧
    (∀ j ∈ ℕ, complexSequenceY(powerSeriesTerms(lndCoeff(D, x),
      complexOfReal(x), complexOfReal(t)))(j) = (0:R)) ∧
    ComplexSequence(powerSeriesTerms(lndCoeff(D, x), complexOfReal(x),
      complexOfReal(t)))
proof
  have sequence := lndCoeff.function at D, x
  have xC := complexOfReal.mem at x
  have tC := complexOfReal.mem at t
  have termsSequence := powerSeriesTerms.function with sequence, xC, tC
  have sNonneg : (0:R) ≤ R[x - t] by linarith
  refine ⟨?_, ?_, termsSequence⟩
  . intros j hj
    have jNat := nat.omega.backward at j with hj
    have mMember := lndMoment.member at D, x, j
    have mFinite := lndMoment.finite_above at D, σ, x, j with values,
      measurable, nonneg, below, finite
    obtain ⟨mReal, mNonneg⟩ := ennreal.finite with mMember, mFinite
    obtain ⟨cEnn, cReal, cNonneg⟩ := lndCoefficient.facts with sNonneg, hj
    have term := lndCoeff.term at D, σ, x, t, j with values, measurable,
      nonneg, below, finite
    have termMember := FunctionBetween.apply_closed with termsSequence, hj
    rw [(complexSequenceX.value with termsSequence), (complexRe.x with
      termMember), term, complexOfReal.re,
      (lndMomentSeries.value at D, x, R[x - t], j with hj),
      (ennMul.finite with cReal, mReal, cNonneg, mNonneg)]
  . intros j hj
    have jNat := nat.omega.backward at j with hj
    have term := lndCoeff.term at D, σ, x, t, j with values, measurable,
      nonneg, below, finite
    have termMember := FunctionBetween.apply_closed with termsSequence, hj
    have mMember := lndMoment.member at D, x, j
    have mFinite := lndMoment.finite_above at D, σ, x, j with values,
      measurable, nonneg, below, finite
    obtain ⟨mReal, mNonneg⟩ := ennreal.finite with mMember, mFinite
    obtain ⟨cEnn, cReal, cNonneg⟩ := lndCoefficient.facts with sNonneg, hj
    rw [(complexSequenceY.value with termsSequence), (complexIm.y with
      termMember), term, complexOfReal.im]

end LandauMoments
