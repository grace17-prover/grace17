-- The Bernoulli numbers, with B₁ = −1/2; the Bernoulli polynomials
-- Bₙ(x) = Σ_{k ≤ n} C(n, k) Bₖ x^(n − k) on ℝ, their derivatives,
-- differences, values at 0 and 1, and integrals; the integer floor and the
-- fractional part on all of ℝ; and the periodic Bernoulli functions
-- P̃ₙ(x) = Bₙ(x − ⌊x⌋), bounded, continuous for n ≥ 2, and integrated
-- against unit periods.
-- Part of the GRH blueprint.
-- Planned home: NumberTheory/Bernoulli.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Bernoulli
import Grace.Cumulus.Real.Analysis.Integration
import Grace.Cumulus.Real.Rationals
import Grace.Cumulus.NumberTheory.Binomial
import Grace.Cumulus.Real.Floor

-- The Bernoulli numbers

-- The terms C(n + 1, k) b(k) of the defining recurrence at n.
defgraph bernoulliRecurrenceTerms (b : Set, n : Nat) (k ∈ ℕ) : ℝ :=
  realNat(choose(succ(n), k)) * b(k)
requires sequence : RealSequence(b)
proof
  have kNat := nat.omega.backward with member
  have term := RealSequence.value at b, k with sequence
  have natural := realNat.real at choose(succ(n), k)
  typecheck

-- The Bernoulli numbers are the real sequence with B₀ = 1 and
-- Σ_{k ≤ n} C(n + 1, k) Bₖ = 0 for every n ≥ 1; so
-- Bₙ = −(1/(n + 1)) Σ_{k < n} C(n + 1, k) Bₖ, and B₁ = −1/2. This is the
-- convention of Mathlib's `bernoulli` (not `bernoulli'`, which has
-- B₁ = 1/2), and the one in which the Euler–Maclaurin formula reads
-- Σ_{a ≤ n < b} f(n) = ∫_a^b f + Σ_{k=1}^{K} Bₖ/k! (f^(k−1)(b) − f^(k−1)(a))
-- + remainder. The values are rational: `bernoulli.rational`.
predicate BernoulliSequence (b : Set) :=
  RealSequence(b) ∧ b(0) = (1:R) ∧
  (∀ n ∈ ℕ, 0 < n →
    ∑ k < succ(n), bernoulliRecurrenceTerms(b, n)(k) = (0:R))

-- Construction of the sequence

-- C(n + 1, n) = n + 1.
theorem choose.succ_left (n : Nat)
  shows choose(succ(n), n) = succ(n)
proof
  induction n
  | zero =>
    rw choose.zero_right
    arith
  | succ(k) using ih =>
    rw [choose.succ_succ, ih, choose.diagonal]
    arith

-- The recurrence at n, with its last term separated:
-- Σ_{k ≤ n} C(n + 1, k) b(k) = Σ_{k < n} C(n + 1, k) b(k) + (n + 1) b(n).
theorem bernoulliRecurrenceTerms.split (b : Set, n : Nat)
  requires sequence : RealSequence(b)
  shows ∑ k < succ(n), bernoulliRecurrenceTerms(b, n)(k) =
    (∑ k < n, bernoulliRecurrenceTerms(b, n)(k)) + realNat(succ(n)) * b(n)
proof
  have last := bernoulliRecurrenceTerms.value at b, n, n with sequence
  rw [realPartialSum.succ, last, choose.succ_left]
  unfold realAddValue
  unfold call2
  rfl

-- The recurrence terms only see the sequence below the index.
theorem bernoulliRecurrenceTerms.eq_prefix (b c : Set, n m : Nat)
  requires first : RealSequence(b)
  requires second : RealSequence(c)
  requires agree : ∀ k ∈ ℕ, k < m → b(k) = c(k)
  shows ∑ k < m, bernoulliRecurrenceTerms(b, n)(k) =
    ∑ k < m, bernoulliRecurrenceTerms(c, n)(k)
proof
  have firstTerms := bernoulliRecurrenceTerms.function at b, n with first
  have secondTerms := bernoulliRecurrenceTerms.function at c, n with second
  have firstSequence : RealSequence(bernoulliRecurrenceTerms(b, n))
    by exact firstTerms
  have secondSequence : RealSequence(bernoulliRecurrenceTerms(c, n))
    by exact secondTerms
  apply realPartialSum.eq_prefix with firstSequence, secondSequence
  intros k kMember below
  have kNat := nat.omega.backward with kMember
  have same := agree with k, kMember, below
  have left := bernoulliRecurrenceTerms.value at b, n, k with first
  have right := bernoulliRecurrenceTerms.value at c, n, k with second
  rw [left, right, same]

-- A sequence satisfying the defining conditions below m.
predicate BernoulliPrefix (f : Set, m : Nat) :=
  RealSequence(f) ∧ f(0) = (1:R) ∧
  (∀ n ∈ ℕ, 0 < n → n < m →
    ∑ k < succ(n), bernoulliRecurrenceTerms(f, n)(k) = (0:R))

theorem BernoulliPrefix.of_sequence (b : Set, m : Nat)
  requires sequence : BernoulliSequence(b)
  shows BernoulliPrefix(b, m)
proof
  obtain ⟨real, start, recurrence⟩ := sequence
  refine ⟨real, start, ?_⟩
  intros n member positive below
  exact recurrence with n, member, positive

theorem BernoulliPrefix.mono (f : Set, m p : Nat)
  requires prefix : BernoulliPrefix(f, m)
  requires smaller : p ≤ m
  shows BernoulliPrefix(f, p)
proof
  obtain ⟨real, start, recurrence⟩ := prefix
  refine ⟨real, start, ?_⟩
  intros n member positive below
  have nNat := nat.omega.backward with member
  have within : n < m by arith
  exact recurrence with n, member, positive, within

-- Two prefixes for m agree below m: the recurrence at n determines the
-- n-th term from the earlier ones.
theorem BernoulliPrefix.agree (f g : Set, m i : Nat)
  requires first : BernoulliPrefix(f, m)
  requires second : BernoulliPrefix(g, m)
  shows ∀ k ∈ ℕ, k < i → k < m → f(k) = g(k)
proof
  induction i
  | zero =>
    intros k member below within
    have kNat := nat.omega.backward with member
    exfalso
    arith
  | succ(j) using ih =>
    intros k member below within
    have kNat := nat.omega.backward with member
    by_cases earlier : k < j
    . exact ih with k, member, earlier, within
    . have same : k = j by arith
      rw same
      rw same at within
      obtain ⟨fReal, fStart, fRecurrence⟩ := first
      obtain ⟨gReal, gStart, gRecurrence⟩ := second
      by_cases zero : j = 0
      . rw [zero, fStart, gStart]
      . have positive : 0 < j by arith
        have jMember : j ∈ ℕ by typecheck
        have fZero := fRecurrence with j, jMember, positive, within
        have gZero := gRecurrence with j, jMember, positive, within
        have fSplit := bernoulliRecurrenceTerms.split at f, j with fReal
        have gSplit := bernoulliRecurrenceTerms.split at g, j with gReal
        have earlierAgree : ∀ k ∈ ℕ, k < j → f(k) = g(k)
          intros l lMember lBelow
          have lNat := nat.omega.backward with lMember
          have lWithin : l < m by arith
          exact ih with l, lMember, lBelow, lWithin
        have prefixes := bernoulliRecurrenceTerms.eq_prefix at f, g, j, j
          with fReal, gReal, earlierAgree
        have fTerms := bernoulliRecurrenceTerms.function at f, j with fReal
        have fSequence : RealSequence(bernoulliRecurrenceTerms(f, j))
          by exact fTerms
        have fSum := realPartialSum.real
          at bernoulliRecurrenceTerms(f, j), j with fSequence
        have fValue := RealSequence.value at f, j with fReal
        have gValue := RealSequence.value at g, j with gReal
        have scale := realNat.real at succ(j)
        have succNonzero : succ(j) ≠ 0 by arith
        have nonzero := realNat.ne_zero with succNonzero
        have scaled : realNat(succ(j)) * f(j) = realNat(succ(j)) * g(j)
          by linarith
        have cancel := realInvValue.mul_left with nonzero
        have inverse := realInvValue.real at realNat(succ(j))
        linear_combination realInvValue(realNat(succ(j))) * scaled -
          (f(j) - g(j)) * cancel

-- Changing a real sequence at the single index m to the value v.
defgraph bernoulliAdjust (f : Set, m : Nat, v : Real) (k ∈ ℕ) : ℝ :=
  f(k) + realNat(choose(k, m) * choose(m, k)) * (v - f(k))
requires sequence : RealSequence(f)
proof
  have kNat := nat.omega.backward with member
  have value := RealSequence.value at f, k with sequence
  have natural := realNat.real at choose(k, m) * choose(m, k)
  typecheck

theorem bernoulliAdjust.at (f : Set, m : Nat, v : Real)
  requires sequence : RealSequence(f)
  shows bernoulliAdjust(f, m, v)(m) = v
proof
  have value := RealSequence.value at f, m with sequence
  have adjusted := bernoulliAdjust.value at f, m, v, m with sequence
  rw [adjusted, choose.diagonal]
  have unit : 1 * 1 = 1 by arith
  rw [unit, realNat.one]
  ring

theorem bernoulliAdjust.other (f : Set, m : Nat, v : Real, k : Nat)
  requires sequence : RealSequence(f)
  requires different : k ≠ m
  shows bernoulliAdjust(f, m, v)(k) = f(k)
proof
  have value := RealSequence.value at f, k with sequence
  have adjusted := bernoulliAdjust.value at f, m, v, k with sequence
  have vanishing : choose(k, m) * choose(m, k) = 0
    by_cases below : k < m
    . obtain ⟨j, jNat, shape⟩ := Less.exists_add_one with below
      have form : m = k + succ(j) by arith
      have zero := choose.above at k
      have instance := zero with j, jNat
      rw ← form at instance
      rw instance
      arith
    . have above : m < k by arith
      obtain ⟨j, jNat, shape⟩ := Less.exists_add_one with above
      have form : k = m + succ(j) by arith
      have zero := choose.above at m
      have instance := zero with j, jNat
      rw ← form at instance
      rw instance
      arith
  rw [adjusted, vanishing, realNat.zero]
  ring

-- Prefixes of every length exist.
theorem BernoulliPrefix.exists (m : Nat)
  shows ∃ f, BernoulliPrefix(f, m)
proof
  induction m
  | zero =>
    have one : Real((1:R)) by typecheck
    have function := constantSequence.function at (1:R)
    have related := constantSequence.relates at (1:R), 0
    have zeroMember : 0 ∈ ℕ by typecheck
    have start := FunctionBetween.apply_value with function, zeroMember,
      related
    witness constantSequence((1:R))
    refine ⟨function, start, ?_⟩
    intros n member positive below
    have nNat := nat.omega.backward with member
    exfalso
    arith
  | succ(q) using ih =>
    obtain ⟨f, prefix⟩ := ih
    obtain ⟨real, start, recurrence⟩ := prefix
    by_cases zero : q = 0
    . witness f
      refine ⟨real, start, ?_⟩
      intros n member positive below
      have nNat := nat.omega.backward with member
      exfalso
      rw zero at below
      arith
    . -- Solve the recurrence at q for the q-th term.
      have mPositive : 0 < q by arith
      have terms := bernoulliRecurrenceTerms.function at f, q with real
      have termSequence : RealSequence(bernoulliRecurrenceTerms(f, q))
        by exact terms
      have sum := realPartialSum.real at bernoulliRecurrenceTerms(f, q), q
        with termSequence
      have scale := realNat.real at succ(q)
      have succNonzero : succ(q) ≠ 0 by arith
      have nonzero := realNat.ne_zero with succNonzero
      have inverse := realInvValue.real at realNat(succ(q))
      set v := -(realInvValue(realNat(succ(q))) *
        (∑ i < q, bernoulliRecurrenceTerms(f, q)(i))) with vDefinition
      have solved : Real(v)
        rw vDefinition
        typecheck
      have adjust := bernoulliAdjust.function at f, q, v with real
      have adjustSequence : RealSequence(bernoulliAdjust(f, q, v))
        by exact adjust
      witness bernoulliAdjust(f, q, v)
      have otherwise : ∀ k ∈ ℕ, k < q → bernoulliAdjust(f, q, v)(k) = f(k)
        intros k kMember kBelow
        have kNat := nat.omega.backward with kMember
        have different : k ≠ q by arith
        exact bernoulliAdjust.other with real, different
      refine ⟨adjustSequence, ?_, ?_⟩
      . have zeroMember : 0 ∈ ℕ by typecheck
        have kept := otherwise with 0, zeroMember, mPositive
        rw [kept, start]
      . intros n member positive below
        have nNat := nat.omega.backward with member
        by_cases earlier : n < q
        . have agree : ∀ k ∈ ℕ, k < succ(n) →
              bernoulliAdjust(f, q, v)(k) = f(k)
            intros k kMember kBelow
            have kNat := nat.omega.backward with kMember
            have kEarlier : k < q by arith
            exact otherwise with k, kMember, kEarlier
          have same := bernoulliRecurrenceTerms.eq_prefix
            at bernoulliAdjust(f, q, v), f, n, succ(n)
            with adjustSequence, real, agree
          have old := recurrence with n, member, positive, earlier
          rw [same, old]
        . have equal : n = q by arith
          rw equal
          have split := bernoulliRecurrenceTerms.split
            at bernoulliAdjust(f, q, v), q with adjustSequence
          have same := bernoulliRecurrenceTerms.eq_prefix
            at bernoulliAdjust(f, q, v), f, q, q
            with adjustSequence, real, otherwise
          have last := bernoulliAdjust.at at f, q, v with real
          have cancel := realInvValue.mul_right with nonzero
          rw [split, same, last, vDefinition]
          linear_combination (-(∑ i < q, bernoulliRecurrenceTerms(f, q)(i))) *
            cancel

-- The graph of the Bernoulli numbers: n is sent to the n-th term of any
-- prefix of length n + 1.
def bernoulliGraph : Set :=
  { p ∈ ℕ × ℝ | ∃ n ∈ ℕ, ∃ f, BernoulliPrefix(f, succ(n)) ∧ p = (n, f(n)) }

theorem bernoulliGraph.function
  shows bernoulliGraph : ℕ → ℝ
proof
  refine ⟨?_, ?_, ?_⟩
  . intros p member
    unfold bernoulliGraph at member
    exact member.left
  . intros x y first z second
    unfold relates at first, second
    unfold bernoulliGraph at first, second
    obtain ⟨_, n, nMember, f, fPrefix, fShape⟩ := first
    obtain ⟨_, l, lMember, g, gPrefix, gShape⟩ := second
    obtain ⟨xn, yf⟩ := orderedPair.injective with fShape
    obtain ⟨xl, zg⟩ := orderedPair.injective with gShape
    have nNat := nat.omega.backward with nMember
    have lNat := nat.omega.backward with lMember
    have same : n = l by cc
    rw ← same at gPrefix
    have agree := BernoulliPrefix.agree at f, g, succ(n), succ(n)
      with fPrefix, gPrefix
    have below : n < succ(n) by arith
    have equal := agree with n, nMember, below, below
    rw [yf, zg, ← same, equal]
  . intros n member
    have nNat := nat.omega.backward with member
    obtain ⟨f, prefix⟩ := BernoulliPrefix.exists at succ(n)
    have real := prefix.left
    have value := RealSequence.value at f, n with real
    have valueMember : f(n) ∈ ℝ by typecheck
    refine ⟨f(n), valueMember, ?_⟩
    unfold relates
    unfold bernoulliGraph
    have pair := product.pair with member, valueMember
    exact ⟨pair, n, member, f, prefix, rfl⟩

theorem bernoulliGraph.value (f : Set, n : Nat)
  requires prefix : BernoulliPrefix(f, succ(n))
  shows bernoulliGraph(n) = f(n)
proof
  have function := bernoulliGraph.function
  have member : n ∈ ℕ by typecheck
  have real := prefix.left
  have value := RealSequence.value at f, n with real
  have valueMember : f(n) ∈ ℝ by typecheck
  apply FunctionBetween.apply_value with function, member
  unfold relates
  unfold bernoulliGraph
  have pair := product.pair with member, valueMember
  exact ⟨pair, n, member, f, prefix, rfl⟩

theorem bernoulliGraph.sequence
  shows BernoulliSequence(bernoulliGraph)
proof
  have function := bernoulliGraph.function
  refine ⟨function, ?_, ?_⟩
  . obtain ⟨f, prefix⟩ := BernoulliPrefix.exists at succ(0)
    have value := bernoulliGraph.value with prefix
    rw value
    exact prefix.right.left
  . intros n member positive
    have nNat := nat.omega.backward with member
    obtain ⟨f, prefix⟩ := BernoulliPrefix.exists at succ(n)
    have real := prefix.left
    have agree : ∀ k ∈ ℕ, k < succ(n) → bernoulliGraph(k) = f(k)
      intros k kMember below
      have kNat := nat.omega.backward with kMember
      have within : succ(k) ≤ succ(n) by arith
      have shorter := BernoulliPrefix.mono with prefix, within
      exact bernoulliGraph.value with shorter
    have same := bernoulliRecurrenceTerms.eq_prefix
      at bernoulliGraph, f, n, succ(n) with function, real, agree
    obtain ⟨_, _, recurrence⟩ := prefix
    have below : n < succ(n) by arith
    have zero := recurrence with n, member, positive, below
    rw [same, zero]

theorem BernoulliSequence.unique (b c : Set)
  requires first : BernoulliSequence(b)
  requires second : BernoulliSequence(c)
  shows b = c
proof
  have bFunction := first.left
  have cFunction := second.left
  apply FunctionBetween.ext at b, c, ℕ, ℝ with bFunction, cFunction
  intros k member
  have kNat := nat.omega.backward with member
  have bPrefix := BernoulliPrefix.of_sequence at b, succ(k) with first
  have cPrefix := BernoulliPrefix.of_sequence at c, succ(k) with second
  have agree := BernoulliPrefix.agree at b, c, succ(k), succ(k)
    with bPrefix, cPrefix
  have below : k < succ(k) by arith
  exact agree with k, member, below, below

-- The n-th Bernoulli number Bₙ: the n-th term of the sequence above, which
-- exists and is unique (`BernoulliSequence.unique`).
defunique bernoulli (n : Nat) (B ∈ ℝ) :=
  ∃ b, BernoulliSequence(b) ∧ B = b(n)
proof
  have sequence := bernoulliGraph.sequence
  have function := bernoulliGraph.function
  have member : n ∈ ℕ by typecheck
  have value := FunctionBetween.apply_closed with function, member
  witness bernoulliGraph(n)
  exact ⟨value, bernoulliGraph, sequence, rfl⟩
uniqueness
  intros x xMember xProperty y yMember yProperty
  obtain ⟨b, bSequence, bValue⟩ := xProperty
  obtain ⟨c, cSequence, cValue⟩ := yProperty
  have same := BernoulliSequence.unique with bSequence, cSequence
  rw [bValue, cValue, same]

-- The sequence n ↦ Bₙ.
defgraph bernoulliNumbers (n ∈ ℕ) : ℝ := bernoulli(n)
proof
  have nNat := nat.omega.backward with member
  have selected := bernoulli.selected at n
  exact selected.left

-- The Bernoulli polynomials

-- The terms C(n, k) Bₖ x^(n − k) of Bₙ(x).
defgraph bernoulliPolynomialTerms (n : Nat, x : Real) (k ∈ ℕ) : ℝ :=
  realNat(choose(n, k)) * bernoulli(k) * x ^ (n - k)
proof
  have kNat := nat.omega.backward with member
  have selected := bernoulli.selected at k
  have value : Real(bernoulli(k)) by exact selected.left
  have natural := realNat.real at choose(n, k)
  typecheck

-- The n-th Bernoulli polynomial at x: Bₙ(x) = Σ_{k ≤ n} C(n, k) Bₖ x^(n − k).
def bernoulliPolynomial (n : Nat, x : Real) : Set :=
  ∑ k < succ(n), bernoulliPolynomialTerms(n, x)(k)

-- Bₙ as a function ℝ → ℝ.
defgraph bernoulliFunction (n : Nat) (x ∈ ℝ) : ℝ := bernoulliPolynomial(n, x)
proof
  have xReal : Real(x) by exact member
  have terms := bernoulliPolynomialTerms.function at n, x
  have sequence : RealSequence(bernoulliPolynomialTerms(n, x)) by exact terms
  have sum := realPartialSum.real at bernoulliPolynomialTerms(n, x), succ(n)
    with sequence
  unfold bernoulliPolynomial
  exact sum

-- The integer floor and the fractional part on ℝ

-- ⌊X⌋, the integer k with k ≤ X < k + 1.
defunique integerFloor (X : Real) (k ∈ ℤ) :=
  realInt(k) ≤ X ∧ X < realInt(k) + 1
proof
  -- Shift X by a natural M into [0, ∞) and take the natural floor there.
  obtain ⟨M, mNat, above⟩ := Real.below_natural at -X
  have mReal := realNat.real at M
  have shifted : (0:R) ≤ X + realNat(M) by linarith
  have shiftedReal : Real(X + realNat(M)) by typecheck
  have floorNat := realFloor.natural at X + realNat(M) with shifted
  have lower := realFloor.le at X + realNat(M) with shifted
  have upper := realFloor.lt at X + realNat(M) with shifted
  have value := realInt.class at realFloor(X + realNat(M)), M
  have integer := integerClass.integer at realFloor(X + realNat(M)), M
  have floorReal := realNat.real at realFloor(X + realNat(M))
  witness integerClass(realFloor(X + realNat(M)), M)
  refine ⟨?_, ?_, ?_⟩
  . typecheck
  . rw value
    linarith
  . rw value
    linarith
uniqueness
  intros k kMember kBounds l lMember lBounds
  obtain ⟨kLower, kUpper⟩ := kBounds
  obtain ⟨lLower, lUpper⟩ := lBounds
  have kInteger : Integer(k) by typecheck
  have lInteger : Integer(l) by typecheck
  have kReal := realInt.real at k
  have lReal := realInt.real at l
  have difference := realInt.sub at k, l
  obtain ⟨n, nNat, sign⟩ := Integer.signed_natural at k - l
  have nReal := realNat.real at n
  have nZero : n = 0
    by_contra nonzero
    have positive : 0 < n by arith
    have gap := realNat.add_one_le at 0, n with positive
    rw realNat.zero at gap
    cases sign with plus | minus
    . rw [plus, realInt.nat] at difference
      linarith
    . rw [minus, ← integerOfNat.neg, realInt.neg, realInt.nat] at difference
      linarith
  have zeroDifference : k - l = integerZero
    cases sign with plus | minus
    . rw [plus, nZero, integerOfNat.zero]
    . rw [minus, nZero, ← integerOfNat.neg, integerOfNat.zero]
      ring
  linear_combination zeroDifference

-- The fractional part X − ⌊X⌋, in [0, 1).
def fractionalPart (X : Real) : Set := X - realInt(integerFloor(X))

-- The periodic Bernoulli functions

-- P̃ₙ(x) = Bₙ(x − ⌊x⌋), of period 1, equal to Bₙ on [0, 1).
defgraph periodicBernoulli (n : Nat) (x ∈ ℝ) : ℝ :=
  bernoulliPolynomial(n, fractionalPart(x))
proof
  have xReal : Real(x) by exact member
  have selected := integerFloor.selected at x
  have floorInteger : Integer(integerFloor(x)) by exact selected.left
  have floorReal := realInt.real at integerFloor(x)
  have fracReal : Real(fractionalPart(x))
    unfold fractionalPart
    typecheck
  have terms := bernoulliPolynomialTerms.function at n, fractionalPart(x)
  have sequence : RealSequence(bernoulliPolynomialTerms(n, fractionalPart(x)))
    by exact terms
  have sum := realPartialSum.real
    at bernoulliPolynomialTerms(n, fractionalPart(x)), succ(n) with sequence
  unfold bernoulliPolynomial
  exact sum

-- An explicit bound for P̃ₙ: Σ_{k ≤ n} C(n, k) |Bₖ|.
defgraph bernoulliBoundTerms (n : Nat) (k ∈ ℕ) : ℝ :=
  realNat(choose(n, k)) * abs(bernoulli(k))
proof
  have kNat := nat.omega.backward with member
  have selected := bernoulli.selected at k
  have value : Real(bernoulli(k)) by exact selected.left
  have natural := realNat.real at choose(n, k)
  typecheck

def bernoulliBound (n : Nat) : Set := ∑ k < succ(n), bernoulliBoundTerms(n)(k)

-- Facts about the Bernoulli numbers

-- Each Bernoulli number is the value of the constructed sequence.
theorem bernoulli.graph (n : Nat)
  shows bernoulli(n) = bernoulliGraph(n)
proof
  obtain ⟨_, b, sequence, value⟩ := bernoulli.selected at n
  have constructed := bernoulliGraph.sequence
  have same := BernoulliSequence.unique with sequence, constructed
  rw [value, same]

theorem bernoulliNumbers.eq_graph
  shows bernoulliNumbers = bernoulliGraph
proof
  have first := bernoulliNumbers.function
  have second := bernoulliGraph.function
  apply FunctionBetween.ext at bernoulliNumbers, bernoulliGraph, ℕ, ℝ
    with first, second
  intros n member
  have nNat := nat.omega.backward with member
  have value := bernoulliNumbers.value at n with member
  rw [value, bernoulli.graph]

theorem bernoulliNumbers.bernoulli_sequence
  shows BernoulliSequence(bernoulliNumbers)
proof
  rw bernoulliNumbers.eq_graph
  exact bernoulliGraph.sequence

theorem bernoulli.real (n : Nat)
  shows Real(bernoulli(n))
proof
  have selected := bernoulli.selected at n
  exact selected.left

theorem bernoulli.zero
  shows bernoulli(0) = (1:R)
proof
  obtain ⟨member, b, sequence, value⟩ := bernoulli.selected at 0
  obtain ⟨real, start, recurrence⟩ := sequence
  rw value
  exact start

theorem bernoulli.recurrence (n : Nat)
  requires positive : 0 < n
  shows ∑ k < succ(n), bernoulliRecurrenceTerms(bernoulliNumbers, n)(k) =
    (0:R)
proof
  have sequence := bernoulliNumbers.bernoulli_sequence
  obtain ⟨_, _, recurrence⟩ := sequence
  have member : n ∈ ℕ by typecheck
  exact recurrence with n, member, positive

-- The recurrence solved for Bₙ: (n + 1) Bₙ = −Σ_{k < n} C(n + 1, k) Bₖ.
theorem bernoulli.recurrence_solved (n : Nat)
  requires positive : 0 < n
  shows realNat(succ(n)) * bernoulli(n) =
    -(∑ k < n, bernoulliRecurrenceTerms(bernoulliNumbers, n)(k))
proof
  have sequence := bernoulliNumbers.bernoulli_sequence
  have real := sequence.left
  have zero := bernoulli.recurrence with positive
  have split := bernoulliRecurrenceTerms.split at bernoulliNumbers, n
    with real
  have member : n ∈ ℕ by typecheck
  have value := bernoulliNumbers.value at n with member
  rw value at split
  have terms := bernoulliRecurrenceTerms.function at bernoulliNumbers, n
    with real
  have termSequence : RealSequence(bernoulliRecurrenceTerms(bernoulliNumbers,
      n)) by exact terms
  have sum := realPartialSum.real at bernoulliRecurrenceTerms(bernoulliNumbers,
    n), n with termSequence
  have number := bernoulli.real at n
  have scale := realNat.real at succ(n)
  linarith

-- The first few binomial coefficients the small cases use.
theorem choose.two_one
  shows choose(2, 1) = 2
proof
  compute

theorem choose.three_one
  shows choose(3, 1) = 3
proof
  compute

theorem bernoulli.one
  shows bernoulli(1) = -(1:R) / (2:R)
proof
  have positive : 0 < 1 by arith
  have solved := bernoulli.recurrence_solved at 1 with positive
  have sequence := bernoulliNumbers.bernoulli_sequence
  have real := sequence.left
  have first := bernoulliRecurrenceTerms.value at bernoulliNumbers, 1, 0
    with real
  have zeroMember : 0 ∈ ℕ by typecheck
  have zeroValue := bernoulliNumbers.value at 0 with zeroMember
  have sum : ∑ k < 1, bernoulliRecurrenceTerms(bernoulliNumbers, 1)(k) =
      (1:R)
    rw [realPartialSum.succ, realPartialSum.zero, first, zeroValue,
      choose.zero_right, realNat.one, bernoulli.zero]
    ring
  rw [sum, realNat.two] at solved
  have number := bernoulli.real at 1
  rw realDiv.eq_mul_inv
  have two : (2:R) ≠ (0:R) by linarith
  have cancel := realInvValue.mul_left with two
  have inverse := realInvValue.real at (2:R)
  linear_combination realInvValue((2:R)) * solved - bernoulli(1) * cancel

theorem bernoulli.two
  shows bernoulli(2) = (1:R) / (6:R)
proof
  have positive : 0 < 2 by arith
  have solved := bernoulli.recurrence_solved at 2 with positive
  have sequence := bernoulliNumbers.bernoulli_sequence
  have real := sequence.left
  have first := bernoulliRecurrenceTerms.value at bernoulliNumbers, 2, 0
    with real
  have second := bernoulliRecurrenceTerms.value at bernoulliNumbers, 2, 1
    with real
  have zeroMember : 0 ∈ ℕ by typecheck
  have oneMember : 1 ∈ ℕ by typecheck
  have zeroValue := bernoulliNumbers.value at 0 with zeroMember
  have oneValue := bernoulliNumbers.value at 1 with oneMember
  have half := bernoulli.one
  have threeChoose : choose(succ(2), 1) = 3 by exact choose.three_one
  have three : realNat(3) = (3:R)
    have step := realNat.succ_add at 2
    rw [realNat.two] at step
    rw step
    ring
  have twoNonzero : (2:R) ≠ (0:R) by linarith
  have twoCancel := realInvValue.mul_left with twoNonzero
  have twoInverse := realInvValue.real at (2:R)
  have sum : ∑ k < 2, bernoulliRecurrenceTerms(bernoulliNumbers, 2)(k) =
      -(1:R) / (2:R)
    rw [realPartialSum.succ, realPartialSum.succ, realPartialSum.zero, first,
      second, zeroValue, oneValue, choose.zero_right, threeChoose, realNat.one,
      bernoulli.zero, half, three]
    rw [realDiv.eq_mul_inv]
    linear_combination -twoCancel
  have threeSucc : realNat(succ(2)) = (3:R) by exact three
  rw [sum, threeSucc] at solved
  have number := bernoulli.real at 2
  rw [realDiv.eq_mul_inv] at solved
  rw realDiv.eq_mul_inv
  have sixNonzero : (6:R) ≠ (0:R) by linarith
  have sixCancel := realInvValue.mul_left with sixNonzero
  have sixInverse := realInvValue.real at (6:R)
  linear_combination (2:R) * realInvValue((6:R)) * solved +
    realInvValue((6:R)) * twoCancel - bernoulli(2) * sixCancel

-- The odd Bernoulli numbers past B₁ vanish.
theorem bernoulli.odd (m : Nat)
  shows bernoulli(2 * m + 3) = (0:R)
proof
  sorry

-- A partial sum of rational terms is rational.
theorem realPartialSum.rational (u : Set, n : Nat)
  requires sequence : RealSequence(u)
  requires terms : ∀ k ∈ ℕ, k < n → u(k) ∈ rationalReals
  shows (∑ i < n, u(i)) ∈ rationalReals
proof
  induction n
  | zero =>
    intro terms
    rw realPartialSum.zero
    exact rationalReals.zero_mem
  | succ(j) using ih =>
    intro terms
    have earlier : ∀ k ∈ ℕ, k < j → u(k) ∈ rationalReals
      intros k member below
      have kNat := nat.omega.backward with member
      have within : k < succ(j) by arith
      exact terms with k, member, within
    have previous := ih with earlier
    have jMember : j ∈ ℕ by typecheck
    have last : j < succ(j) by arith
    have value := terms with j, jMember, last
    have sum := realPartialSum.real at u, j with sequence
    have term := RealSequence.value at u, j with sequence
    have closed := rationalReals.add_mem with previous, value
    unfold call2 at closed
    rw realPartialSum.succ
    unfold realAddValue
    exact closed

-- The Bernoulli numbers below i are rational.
theorem bernoulli.rational_below (i : Nat)
  shows ∀ k ∈ ℕ, k < i → bernoulli(k) ∈ rationalReals
proof
  induction i
  | zero =>
    intros k member below
    have kNat := nat.omega.backward with member
    exfalso
    arith
  | succ(j) using ih =>
    intros k member below
    have kNat := nat.omega.backward with member
    by_cases earlier : k < j
    . exact ih with k, member, earlier
    . have same : k = j by arith
      rw same
      by_cases zero : j = 0
      . rw [zero, bernoulli.zero]
        exact rationalReals.one_mem
      . have positive : 0 < j by arith
        have solved := bernoulli.recurrence_solved with positive
        have sequence := bernoulliNumbers.bernoulli_sequence
        have real := sequence.left
        have terms := bernoulliRecurrenceTerms.function
          at bernoulliNumbers, j with real
        have termSequence : RealSequence(bernoulliRecurrenceTerms(
            bernoulliNumbers, j)) by exact terms
        have rationalTerms : ∀ l ∈ ℕ, l < j →
            bernoulliRecurrenceTerms(bernoulliNumbers, j)(l) ∈ rationalReals
          intros l lMember lBelow
          have lNat := nat.omega.backward with lMember
          have value := bernoulliRecurrenceTerms.value
            at bernoulliNumbers, j, l with real
          have number := bernoulliNumbers.value at l with lMember
          have earlierNumber := ih with l, lMember, lBelow
          have coefficient := rationalReals.nat_mem at choose(succ(j), l)
          have coefficientReal := realNat.real at choose(succ(j), l)
          have numberReal := bernoulli.real at l
          rw [value, number]
          exact rationalReals.mul_mem with coefficient, earlierNumber
        have sum := realPartialSum.rational with termSequence, rationalTerms
        have sumReal := realPartialSum.real
          at bernoulliRecurrenceTerms(bernoulliNumbers, j), j
          with termSequence
        have negated := rationalReals.neg_mem with sum
        have scale := rationalReals.nat_mem at succ(j)
        have scaleReal := realNat.real at succ(j)
        have succNonzero : succ(j) ≠ 0 by arith
        have nonzero := realNat.ne_zero with succNonzero
        have inverse := rationalReals.inv_mem with scale, nonzero
        have inverseReal := realInvValue.real at realNat(succ(j))
        have product := rationalReals.mul_mem with inverse, negated
        have cancel := realInvValue.mul_left with nonzero
        have number := bernoulli.real at j
        have value : bernoulli(j) = realInvValue(realNat(succ(j))) *
            -(∑ i < j, bernoulliRecurrenceTerms(bernoulliNumbers, j)(i))
          linear_combination realInvValue(realNat(succ(j))) * solved -
            bernoulli(j) * cancel
        rw value
        exact product

theorem bernoulli.rational (n : Nat)
  shows bernoulli(n) ∈ rationalReals
proof
  have all := bernoulli.rational_below at succ(n)
  have member : n ∈ ℕ by typecheck
  have below : n < succ(n) by arith
  exact all with n, member, below

-- Facts about the Bernoulli polynomials

theorem bernoulliPolynomial.real (n : Nat) (x : Real)
  shows Real(bernoulliPolynomial(n, x))
proof
  have terms := bernoulliPolynomialTerms.function at n, x
  have sequence : RealSequence(bernoulliPolynomialTerms(n, x)) by exact terms
  have sum := realPartialSum.real at bernoulliPolynomialTerms(n, x), succ(n)
    with sequence
  unfold bernoulliPolynomial
  exact sum

-- Bₙ(x) with its last term Bₙ separated.
theorem bernoulliPolynomial.split (n : Nat) (x : Real)
  shows bernoulliPolynomial(n, x) =
    (∑ k < n, bernoulliPolynomialTerms(n, x)(k)) + bernoulli(n)
proof
  have last := bernoulliPolynomialTerms.value at n, x, n
  have zero : n - n = 0 by arith
  have number := bernoulli.real at n
  unfold bernoulliPolynomial
  rw [realPartialSum.succ, last, choose.diagonal, zero, realPow.zero,
    realNat.one]
  unfold realAddValue
  have shape : (1:R) * bernoulli(n) * (1:R) = bernoulli(n) by ring
  rw shape
  unfold call2
  rfl

theorem bernoulliPolynomial.zero_index (x : Real)
  shows bernoulliPolynomial(0, x) = (1:R)
proof
  have split := bernoulliPolynomial.split at 0, x
  rw [realPartialSum.zero, bernoulli.zero] at split
  rw split
  ring

theorem bernoulliPolynomial.one_index (x : Real)
  shows bernoulliPolynomial(1, x) = x - (1:R) / (2:R)
proof
  have split := bernoulliPolynomial.split at 1, x
  have first := bernoulliPolynomialTerms.value at 1, x, 0
  have exponent : 1 - 0 = 1 by arith
  have power : x ^ 1 = x
    have step := realPow.succ at x, 0
    rw realPow.zero at step
    rw step
    ring
  rw [realPartialSum.succ, realPartialSum.zero, first, choose.zero_right,
    realNat.one, bernoulli.zero, exponent, power, bernoulli.one] at split
  rw split
  ring

theorem bernoulliPolynomial.two_index (x : Real)
  shows bernoulliPolynomial(2, x) = x * x - x + (1:R) / (6:R)
proof
  have split := bernoulliPolynomial.split at 2, x
  have first := bernoulliPolynomialTerms.value at 2, x, 0
  have second := bernoulliPolynomialTerms.value at 2, x, 1
  have firstExponent : 2 - 0 = 2 by arith
  have secondExponent : 2 - 1 = 1 by arith
  have square := realPow.two at x
  have twoShape : succ(succ(0)) = 2 by arith
  rw twoShape at square
  have power : x ^ 1 = x
    have step := realPow.succ at x, 0
    rw realPow.zero at step
    rw step
    ring
  rw [realPartialSum.succ, realPartialSum.succ, realPartialSum.zero, first,
    second, choose.zero_right, choose.two_one, realNat.one, realNat.two,
    bernoulli.zero, bernoulli.one, bernoulli.two, firstExponent,
    secondExponent, square, power] at split
  rw split
  rw [realDiv.eq_mul_inv, realDiv.eq_mul_inv]
  have twoNonzero : (2:R) ≠ (0:R) by linarith
  have twoCancel := realInvValue.mul_left with twoNonzero
  have twoInverse := realInvValue.real at (2:R)
  have sixInverse := realInvValue.real at (6:R)
  linear_combination -x * twoCancel

-- Bₙ(0) = Bₙ for every n.
theorem bernoulliPolynomial.at_zero (n : Nat)
  shows bernoulliPolynomial(n, (0:R)) = bernoulli(n)
proof
  have split := bernoulliPolynomial.split at n, (0:R)
  have terms := bernoulliPolynomialTerms.function at n, (0:R)
  have termSequence : RealSequence(bernoulliPolynomialTerms(n, (0:R)))
    by exact terms
  have zeroReal : Real((0:R)) by typecheck
  have constant := constantSequence.function at (0:R)
  have constantSequence : RealSequence(constantSequence((0:R)))
    by exact constant
  have vanishing : ∀ k ∈ ℕ, k < n →
      bernoulliPolynomialTerms(n, (0:R))(k) = constantSequence((0:R))(k)
    intros k member below
    have kNat := nat.omega.backward with member
    have value := bernoulliPolynomialTerms.value at n, (0:R), k
    have related := constantSequence.relates at (0:R), k
    have constantValue := FunctionBetween.apply_value with constant, member,
      related
    obtain ⟨j, jNat, shape⟩ := Less.exists_add_one with below
    have atMost : k ≤ n by arith
    have difference := sub.eq_iff_of_le at n, k, succ(j) with atMost
    have sum : n = k + succ(j) by arith
    have exponent := difference.backward with sum
    have number := bernoulli.real at k
    have coefficient := realNat.real at choose(n, k)
    rw [value, constantValue, exponent, realPow.zero_succ]
    ring
  have prefix := realPartialSum.eq_prefix with termSequence,
    constantSequence, vanishing
  have total := realPartialSum.constant at (0:R), n
  have number := bernoulli.real at n
  have count := realNat.real at n
  rw [prefix, total] at split
  rw split
  ring

-- Bₙ(1) = Bₙ for n ≠ 1; B₁(1) = 1/2 = −B₁.
theorem bernoulliPolynomial.at_one (n : Nat)
  requires notOne : n ≠ 1
  shows bernoulliPolynomial(n, (1:R)) = bernoulli(n)
proof
  have alternatives := natural.zero_or_successor at n
  cases alternatives with zero | successor
  . rw [zero, bernoulli.zero]
    exact bernoulliPolynomial.zero_index at (1:R)
  obtain ⟨m, mNat, shape⟩ := successor
  have positive : 0 < m
    by_contra notPositive
    have mZero : m = 0 by arith
    rw [mZero] at shape
    exact notOne with shape
  rw shape
  have split := bernoulliPolynomial.split at succ(m), (1:R)
  have oneReal : Real((1:R)) by typecheck
  have terms := bernoulliPolynomialTerms.function at succ(m), (1:R)
  have termSequence : RealSequence(bernoulliPolynomialTerms(succ(m), (1:R)))
    by exact terms
  have sequence := bernoulliNumbers.bernoulli_sequence
  have real := sequence.left
  have recurrenceFunction := bernoulliRecurrenceTerms.function
    at bernoulliNumbers, m with real
  have recurrenceSequence : RealSequence(bernoulliRecurrenceTerms(
      bernoulliNumbers, m)) by exact recurrenceFunction
  have agree : ∀ k ∈ ℕ, k < succ(m) →
      bernoulliPolynomialTerms(succ(m), (1:R))(k) =
        bernoulliRecurrenceTerms(bernoulliNumbers, m)(k)
    intros k member below
    have kNat := nat.omega.backward with member
    have left := bernoulliPolynomialTerms.value at succ(m), (1:R), k
    have right := bernoulliRecurrenceTerms.value at bernoulliNumbers, m, k
      with real
    have number := bernoulliNumbers.value at k with member
    have numberReal := bernoulli.real at k
    have coefficient := realNat.real at choose(succ(m), k)
    rw [left, right, number, realPow.one]
    ring
  have prefix := realPartialSum.eq_prefix with termSequence,
    recurrenceSequence, agree
  have zero := bernoulli.recurrence with positive
  have number := bernoulli.real at succ(m)
  rw [prefix, zero] at split
  rw split
  ring

theorem bernoulliPolynomial.one_at_one
  shows bernoulliPolynomial(1, (1:R)) = (1:R) / (2:R)
proof
  have value := bernoulliPolynomial.one_index at (1:R)
  rw value
  rw realDiv.eq_mul_inv
  have twoNonzero : (2:R) ≠ (0:R) by linarith
  have twoCancel := realInvValue.mul_left with twoNonzero
  have twoInverse := realInvValue.real at (2:R)
  linear_combination -twoCancel

-- Bₙ(x + 1) − Bₙ(x) = n x^(n − 1) for n ≥ 1.
theorem bernoulliPolynomial.difference (n : Nat) (x : Real)
  requires positive : 0 < n
  shows bernoulliPolynomial(n, x + (1:R)) - bernoulliPolynomial(n, x) =
    realNat(n) * x ^ (n - 1)
proof
  sorry

-- Bₙ(1 − x) = (−1)ⁿ Bₙ(x).
theorem bernoulliPolynomial.reflection (n : Nat) (x : Real)
  shows bernoulliPolynomial(n, (1:R) - x) =
    (-(1:R)) ^ n * bernoulliPolynomial(n, x)
proof
  sorry

-- The Appell property: Bₙ(x + y) = Σ_{k ≤ n} C(n, k) Bₖ(x) y^(n − k).
defgraph bernoulliShiftTerms (n : Nat, x y : Real) (k ∈ ℕ) : ℝ :=
  realNat(choose(n, k)) * bernoulliPolynomial(k, x) * y ^ (n - k)
proof
  have kNat := nat.omega.backward with member
  have value := bernoulliPolynomial.real at k, x
  have natural := realNat.real at choose(n, k)
  typecheck

theorem bernoulliPolynomial.add (n : Nat) (x y : Real)
  shows bernoulliPolynomial(n, x + y) =
    ∑ k < succ(n), bernoulliShiftTerms(n, x, y)(k)
proof
  sorry

theorem bernoulliFunction.continuous (n : Nat)
  shows Continuous(bernoulliFunction(n))
proof
  sorry

-- B′ₙ₊₁ = (n + 1) Bₙ.
theorem bernoulliFunction.derivative (n : Nat) (x : Real)
  shows HasDerivativeAt(bernoulliFunction(succ(n)),
    realNat(succ(n)) * bernoulliPolynomial(n, x), x)
proof
  sorry

-- (n + 1) ∫_A^B Bₙ = Bₙ₊₁(B) − Bₙ₊₁(A).
theorem bernoulliFunction.integral (n : Nat) (A B : Real)
  requires ordered : A ≤ B
  shows realNat(succ(n)) * riemannIntegral(bernoulliFunction(n), A, B) =
    bernoulliPolynomial(succ(n), B) - bernoulliPolynomial(succ(n), A)
proof
  sorry

-- ∫₀¹ Bₙ = 0 for n ≥ 1.
theorem bernoulliFunction.integral_unit (n : Nat)
  requires positive : 0 < n
  shows riemannIntegral(bernoulliFunction(n), (0:R), (1:R)) = (0:R)
proof
  sorry

-- Facts about the integer floor and the fractional part

theorem integerFloor.integer (X : Real)
  shows Integer(integerFloor(X))
proof
  have selected := integerFloor.selected at X
  exact selected.left

theorem integerFloor.le (X : Real)
  shows realInt(integerFloor(X)) ≤ X
proof
  obtain ⟨_, lower, _⟩ := integerFloor.selected at X
  exact lower

theorem integerFloor.lt (X : Real)
  shows X < realInt(integerFloor(X)) + 1
proof
  obtain ⟨_, _, upper⟩ := integerFloor.selected at X
  exact upper

theorem integerFloor.eq_of_bounds (X : Real) (k : Integer)
  requires lower : realInt(k) ≤ X
  requires upper : X < realInt(k) + 1
  shows integerFloor(X) = k
proof
  obtain ⟨member, floorLower, floorUpper⟩ := integerFloor.selected at X
  have kMember : k ∈ ℤ by typecheck
  have unique := integerFloor.unique at X
  have step := unique with member, ⟨floorLower, floorUpper⟩
  exact step with kMember, ⟨lower, upper⟩

theorem integerFloor.of_integer (k : Integer)
  shows integerFloor(realInt(k)) = k
proof
  have kReal := realInt.real at k
  have lower := realLe.reflexive at realInt(k)
  have upper : realInt(k) < realInt(k) + 1 by linarith
  exact integerFloor.eq_of_bounds with lower, upper

-- On the nonnegative reals ⌊X⌋ is the natural floor of Real/Floor.
theorem integerFloor.of_nonnegative (X : Real)
  requires nonnegative : (0:R) ≤ X
  shows integerFloor(X) = integerOfNat(realFloor(X))
proof
  have floorNat := realFloor.natural with nonnegative
  have lower := realFloor.le with nonnegative
  have upper := realFloor.lt with nonnegative
  have value := realInt.nat at realFloor(X)
  rw ← value at lower, upper
  exact integerFloor.eq_of_bounds with lower, upper

theorem fractionalPart.real (X : Real)
  shows Real(fractionalPart(X))
proof
  have floorInteger := integerFloor.integer at X
  have floorReal := realInt.real at integerFloor(X)
  unfold fractionalPart
  typecheck

theorem fractionalPart.nonnegative (X : Real)
  shows (0:R) ≤ fractionalPart(X)
proof
  have floorInteger := integerFloor.integer at X
  have floorReal := realInt.real at integerFloor(X)
  have lower := integerFloor.le at X
  unfold fractionalPart
  linarith

theorem fractionalPart.lt_one (X : Real)
  shows fractionalPart(X) < (1:R)
proof
  have floorInteger := integerFloor.integer at X
  have floorReal := realInt.real at integerFloor(X)
  have upper := integerFloor.lt at X
  unfold fractionalPart
  linarith

theorem fractionalPart.decomposition (X : Real)
  shows X = realInt(integerFloor(X)) + fractionalPart(X)
proof
  have floorInteger := integerFloor.integer at X
  have floorReal := realInt.real at integerFloor(X)
  unfold fractionalPart
  linarith

theorem fractionalPart.add_integer (X : Real) (k : Integer)
  shows fractionalPart(X + realInt(k)) = fractionalPart(X)
proof
  have kReal := realInt.real at k
  have floorInteger := integerFloor.integer at X
  have floorReal := realInt.real at integerFloor(X)
  have lower := integerFloor.le at X
  have upper := integerFloor.lt at X
  have sum := realInt.add at integerFloor(X), k
  have shiftedLower : realInt(integerFloor(X) + k) ≤ X + realInt(k)
    rw sum
    linarith
  have shiftedUpper : X + realInt(k) < realInt(integerFloor(X) + k) + 1
    rw sum
    linarith
  have floor := integerFloor.eq_of_bounds with shiftedLower, shiftedUpper
  unfold fractionalPart
  rw [floor, sum]
  ring

theorem fractionalPart.of_unit (X : Real)
  requires nonnegative : (0:R) ≤ X
  requires belowOne : X < (1:R)
  shows fractionalPart(X) = X
proof
  have lower : realInt(integerZero) ≤ X
    rw realInt.zero
    exact nonnegative
  have upper : X < realInt(integerZero) + 1
    rw realInt.zero
    linarith
  have floor := integerFloor.eq_of_bounds with lower, upper
  unfold fractionalPart
  rw [floor, realInt.zero]
  ring

theorem fractionalPart.of_nonnegative (X : Real)
  requires nonnegative : (0:R) ≤ X
  shows fractionalPart(X) = realFrac(X)
proof
  have floor := integerFloor.of_nonnegative with nonnegative
  unfold fractionalPart
  rw [floor, realInt.nat, realFrac.value]

-- Facts about the periodic Bernoulli functions

theorem periodicBernoulli.periodic (n : Nat) (x : Real) (k : Integer)
  shows periodicBernoulli(n)(x + realInt(k)) = periodicBernoulli(n)(x)
proof
  sorry

-- On [k, k + 1), P̃ₙ(x) = Bₙ(x − k).
theorem periodicBernoulli.on_cell (n : Nat) (x : Real) (k : Integer)
  requires lower : realInt(k) ≤ x
  requires upper : x < realInt(k) + 1
  shows periodicBernoulli(n)(x) = bernoulliPolynomial(n, x - realInt(k))
proof
  sorry

theorem periodicBernoulli.of_unit (n : Nat) (x : Real)
  requires nonnegative : (0:R) ≤ x
  requires belowOne : x < (1:R)
  shows periodicBernoulli(n)(x) = bernoulliPolynomial(n, x)
proof
  sorry

-- P̃ₙ(k) = Bₙ at every integer k.
theorem periodicBernoulli.at_integer (n : Nat) (k : Integer)
  shows periodicBernoulli(n)(realInt(k)) = bernoulli(n)
proof
  sorry

theorem periodicBernoulli.zero_index (x : Real)
  shows periodicBernoulli(0)(x) = (1:R)
proof
  sorry

-- |P̃ₙ(x)| ≤ Σ_{k ≤ n} C(n, k) |Bₖ| on all of ℝ.
theorem periodicBernoulli.bound (n : Nat) (x : Real)
  shows abs(periodicBernoulli(n)(x)) ≤ bernoulliBound(n)
proof
  sorry

theorem periodicBernoulli.bounded (n : Nat)
  shows ∃ C ∈ ℝ, ∀ x ∈ ℝ, abs(periodicBernoulli(n)(x)) ≤ C
proof
  sorry

-- P̃ₙ is continuous for n ≥ 2, since Bₙ(0) = Bₙ(1) there.
theorem periodicBernoulli.continuous (n : Nat)
  requires large : 2 ≤ n
  shows Continuous(periodicBernoulli(n))
proof
  sorry

-- Off the integers, P̃′ₙ₊₁ = (n + 1) P̃ₙ.
theorem periodicBernoulli.derivative (n : Nat) (x : Real)
  requires notInteger : ∀ k ∈ ℤ, x ≠ realInt(k)
  shows HasDerivativeAt(periodicBernoulli(succ(n)),
    realNat(succ(n)) * periodicBernoulli(n)(x), x)
proof
  sorry

-- From index 3 on, P̃′ₙ = n P̃ₙ₋₁ everywhere. (P̃₂ has corners at the
-- integers, where P̃₁ jumps.)
theorem periodicBernoulli.derivative_everywhere (n : Nat) (x : Real)
  requires large : 2 ≤ n
  shows HasDerivativeAt(periodicBernoulli(succ(n)),
    realNat(succ(n)) * periodicBernoulli(n)(x), x)
proof
  sorry

theorem periodicBernoulli.integrable (n : Nat) (A B : Real)
  requires ordered : A ≤ B
  shows RiemannIntegrable(periodicBernoulli(n), A, B)
proof
  sorry

-- For n ≥ 1, (n + 1) ∫_A^B P̃ₙ = P̃ₙ₊₁(B) − P̃ₙ₊₁(A).
theorem periodicBernoulli.integral (n : Nat) (A B : Real)
  requires positive : 0 < n
  requires ordered : A ≤ B
  shows realNat(succ(n)) * riemannIntegral(periodicBernoulli(n), A, B) =
    periodicBernoulli(succ(n))(B) - periodicBernoulli(succ(n))(A)
proof
  sorry

-- The integral of P̃ₙ over a period vanishes for n ≥ 1.
theorem periodicBernoulli.integral_period (n : Nat) (A : Real)
  requires positive : 0 < n
  shows riemannIntegral(periodicBernoulli(n), A, A + (1:R)) = (0:R)
proof
  sorry
