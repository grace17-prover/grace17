-- Multiplicative characters: maps χ : R → S between commutative rings,
-- multiplicative with χ(1) = 1 and vanishing off the units (MulChar R S);
-- the trivial character, products, inverses and powers; composition
-- with ring homomorphisms; the correspondence with homomorphisms of unit
-- groups; values in roots of unity, orthogonality Σ χ = 0, conjugation in
-- ℂ, the count of characters and characters of given order on a finite
-- field; Dirichlet characters as MulChar (ZMod N) ℂ, matched with layer
-- 1's characters on ℤ; reduction ZMod n → ZMod m and its units; ZMod n
-- as scalars on a group of exponent n; and χ₄, χ₈.
-- Part of the GRH blueprint.
-- Planned home: NumberTheory/MulChar.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Characters.Mul
import GRH.Cyclotomy.Fields
import GRH.FunctionalEquation

-- Section: Definitions
-- A multiplicative character R → S (Mathlib's MulChar R S): a monoid
-- homomorphism of the multiplicative monoids that sends every nonunit
-- to 0 (MulChar.map_nonunit).
predicate MulChar (R S χ : Set) :=
  CommRing(R) ∧ CommRing(S) ∧
  FunctionBetween(χ, Ring.carrier(R), Ring.carrier(S)) ∧
  χ(Ring.one(R)) = Ring.one(S) ∧
  (∀ a ∈ Ring.carrier(R), ∀ b ∈ Ring.carrier(R),
    χ(call2(Ring.mul(R), a, b)) = call2(Ring.mul(S), χ(a), χ(b))) ∧
  (∀ a ∈ Ring.carrier(R), ¬RingUnit(R, a) → χ(a) = Ring.zero(S))

def mulChars (R S : Set) : Set :=
  { χ ∈ functionSpace(Ring.carrier(R), Ring.carrier(S)) | MulChar(R, S, χ) }

-- The trivial character 1: 1 on units, 0 elsewhere (MulChar.one_apply).
def trivialMulChar (R S : Set) : Set :=
  { u ∈ Ring.carrier(R) × Ring.carrier(S) |
    (RingUnit(R, fst(u)) ∧ snd(u) = Ring.one(S)) ∨
    (¬RingUnit(R, fst(u)) ∧ snd(u) = Ring.zero(S)) }

-- The product χ ψ, a ↦ χ(a) ψ(a) (MulChar.mul_apply).
def mulCharProduct (R S χ ψ : Set) : Set :=
  { (a, call2(Ring.mul(S), χ(a), ψ(a))) | a ∈ Ring.carrier(R) }

-- The inverse χ⁻¹, a ↦ Ring.inverse(χ(a)): the inverse of χ(a) when it
-- is a unit and 0 otherwise (MulChar.inv_apply').
def mulCharInverse (R S χ : Set) : Set :=
  { u ∈ Ring.carrier(R) × Ring.carrier(S) |
    (RingUnit(S, χ(fst(u))) ∧ call2(Ring.mul(S), χ(fst(u)), snd(u)) = Ring.one(S)) ∨
    (¬RingUnit(S, χ(fst(u))) ∧ snd(u) = Ring.zero(S)) }

-- The power χ^n: χ(a)^n on units and 0 elsewhere, so χ^0 = 1 and
-- (χ^n)(a) = χ(a)^n for n ≥ 1 (MulChar.pow_apply').
def mulCharPow (R S χ : Set, n : Nat) : Set :=
  { u ∈ Ring.carrier(R) × Ring.carrier(S) |
    (RingUnit(R, fst(u)) ∧ snd(u) = Ring.pow(S, χ(fst(u)), n)) ∨
    (¬RingUnit(R, fst(u)) ∧ snd(u) = Ring.zero(S)) }

-- f ∘ χ for a ring homomorphism f : S → T (MulChar.ringHomComp).
def mulCharComp (R S T χ f : Set) : Set :=
  compose(f, χ, Ring.carrier(R), Ring.carrier(S), Ring.carrier(T))

-- The character extending a homomorphism of unit groups f : Rˣ → Sˣ by
-- 0 (MulChar.ofUnitHom); restriction to the units is MulChar.toUnitHom.
def mulCharOfUnitHom (R S f : Set) : Set :=
  { u ∈ Ring.carrier(R) × Ring.carrier(S) |
    (RingUnit(R, fst(u)) ∧ snd(u) = f(fst(u))) ∨
    (¬RingUnit(R, fst(u)) ∧ snd(u) = Ring.zero(S)) }

-- Section: Dirichlet characters as multiplicative characters
-- Mathlib's DirichletCharacter R N is MulChar (ZMod N) R. Layer 1's
-- DirichletCharacter(N, ψ) is a function on ℤ; the two correspond by
-- composing with the cast ℤ → ZMod N and by descending ψ to the quotient
-- (Ideal.Quotient.lift).
def dirichletOfMulChar (N : Nat, χ : Set) : Set :=
  compose(χ, zmodCast(N), ℤ, Ring.carrier(zmod(N)), complexCarrier)

def mulCharOfDirichlet (N : Nat, ψ : Set) : Set :=
  quotientRingLift(integerRing, complexRing, zmodIdeal(N), ψ)

-- Section: ZMod reduction and scalars
-- The reduction ZMod n → ZMod m, [a]_n ↦ [a]_m (ZMod.castHom for m ∣ n),
-- and on units (ZMod.unitsMap).
def zmodReduce (n m : Nat) : Set :=
  { u ∈ Ring.carrier(zmod(n)) × Ring.carrier(zmod(m)) | ∃ a ∈ ℤ,
    u = (zmodCast(n)(a), zmodCast(m)(a)) }

-- An abelian group G (written in its mul slot) of exponent dividing n as
-- a ZMod n-module, [k] · x = x^k (AddCommGroup.zmodModule).
def zmodAction (G : Set, n : Nat) : Set :=
  { u ∈ (Ring.carrier(zmod(n)) × Group.carrier(G)) × Group.carrier(G) |
    ∃ k ∈ ℕ, ∃ x ∈ Group.carrier(G),
      u = ((zmodCast(n)(integerOfNat(k)), x), groupPow(G, x, k)) }

def zmodModule (G : Set, n : Nat) : Set :=
  Module.mk(Group.carrier(G), Group.mul(G), Group.one(G), Group.inv(G), zmodAction(G, n))

-- Section: χ₄ and χ₈
-- The nontrivial character modulo 4 with values in ℤ (ZMod.χ₄): 1 at
-- 1 mod 4, −1 at 3 mod 4, 0 at even classes; and the character modulo 8
-- with 1 at ±1 mod 8 and −1 at ±3 mod 8 (ZMod.χ₈).
def chiFour : Set :=
  { u ∈ Ring.carrier(zmod(4)) × ℤ | ∃ k ∈ ℕ, fst(u) = zmodCast(4)(integerOfNat(k)) ∧
    ((integerMod(integerOfNat(k), 4) = 1 ∧ snd(u) = integerOne) ∨
     (integerMod(integerOfNat(k), 4) = 3 ∧ snd(u) = integerNegValue(integerOne)) ∨
     (integerMod(integerOfNat(k), 2) = 0 ∧ snd(u) = integerZero)) }

def chiEight : Set :=
  { u ∈ Ring.carrier(zmod(8)) × ℤ | ∃ k ∈ ℕ, fst(u) = zmodCast(8)(integerOfNat(k)) ∧
    (((integerMod(integerOfNat(k), 8) = 1 ∨ integerMod(integerOfNat(k), 8) = 7) ∧
        snd(u) = integerOne) ∨
     ((integerMod(integerOfNat(k), 8) = 3 ∨ integerMod(integerOfNat(k), 8) = 5) ∧
        snd(u) = integerNegValue(integerOne)) ∨
     (integerMod(integerOfNat(k), 2) = 0 ∧ snd(u) = integerZero)) }

-- Section: Laws
section Laws
variable (R S : Set)
hypothesis domainRing : CommRing(R)
hypothesis targetRing : CommRing(S)

-- MulChar.map_zero: χ(0) = 0 for R nontrivial.
theorem MulChar.map_zero (χ : Set)
  requires character : MulChar(R, S, χ)
  requires nontrivial : Ring.zero(R) ≠ Ring.one(R)
  shows χ(Ring.zero(R)) = Ring.zero(S)
proof
  sorry

-- MulChar.apply_eq_zero_iff, MulChar.apply_ne_zero_iff: into a
-- nontrivial ring, χ(a) = 0 exactly at the nonunits.
theorem MulChar.apply_eq_zero_iff (χ a : Set)
  requires character : MulChar(R, S, χ)
  requires nontrivial : Ring.zero(S) ≠ Ring.one(S)
  requires member : a ∈ Ring.carrier(R)
  shows χ(a) = Ring.zero(S) ↔ ¬RingUnit(R, a)
proof
  sorry

-- MulChar.ext, MulChar.eq_iff: characters agreeing on units are equal.
theorem MulChar.ext (χ ψ : Set)
  requires first : MulChar(R, S, χ)
  requires second : MulChar(R, S, ψ)
  requires agree : ∀ a ∈ Ring.carrier(R), RingUnit(R, a) → χ(a) = ψ(a)
  shows χ = ψ
proof
  sorry

-- MulChar.one_apply, MulChar.one_apply_coe.
theorem trivialMulChar.char
  shows MulChar(R, S, trivialMulChar(R, S)) ∧
    (∀ a ∈ Ring.carrier(R), RingUnit(R, a) → trivialMulChar(R, S)(a) = Ring.one(S))
proof
  sorry

-- MulChar.mul_apply: χ ψ is a character.
theorem mulCharProduct.char (χ ψ : Set)
  requires first : MulChar(R, S, χ)
  requires second : MulChar(R, S, ψ)
  shows MulChar(R, S, mulCharProduct(R, S, χ, ψ))
proof
  sorry

-- MulChar.inv_apply', MulChar.inv_apply_eq_inv: χ⁻¹ is a character with
-- χ⁻¹(a) = χ(a⁻¹) on units, and χ χ⁻¹ = 1 (MulChar.inv_mul).
theorem mulCharInverse.char (χ : Set)
  requires character : MulChar(R, S, χ)
  shows MulChar(R, S, mulCharInverse(R, S, χ)) ∧
    mulCharProduct(R, S, χ, mulCharInverse(R, S, χ)) = trivialMulChar(R, S)
proof
  sorry

theorem mulCharInverse.apply_unit (χ a : Set)
  requires character : MulChar(R, S, χ)
  requires unit : RingUnit(R, a)
  shows mulCharInverse(R, S, χ)(a) = χ(ringInverse(R, a)) ∧
    call2(Ring.mul(S), χ(a), mulCharInverse(R, S, χ)(a)) = Ring.one(S)
proof
  sorry

-- MulChar.inv_apply_eq_inv': into a field, χ⁻¹(a) = χ(a)⁻¹ for χ(a) ≠ 0.
theorem mulCharInverse.apply_field (χ a : Set)
  requires field : Field(S)
  requires character : MulChar(R, S, χ)
  requires member : a ∈ Ring.carrier(R)
  requires nonzero : χ(a) ≠ Ring.zero(S)
  shows mulCharInverse(R, S, χ)(a) = ringInverse(S, χ(a))
proof
  sorry

-- MulChar.pow_apply', MulChar.pow_apply_coe: χ^n is a character and
-- (χ^n)(a) = χ(a)^n for n ≥ 1; χ^(m+n) = χ^m χ^n.
theorem mulCharPow.char (χ : Set) (n : Nat)
  requires character : MulChar(R, S, χ)
  shows MulChar(R, S, mulCharPow(R, S, χ, n)) ∧ mulCharPow(R, S, χ, 0) = trivialMulChar(R, S)
proof
  sorry

theorem mulCharPow.apply (χ a : Set) (n : Nat)
  requires character : MulChar(R, S, χ)
  requires positive : 0 < n
  requires member : a ∈ Ring.carrier(R)
  shows mulCharPow(R, S, χ, n)(a) = Ring.pow(S, χ(a), n)
proof
  sorry

theorem mulCharPow.add (χ : Set) (m n : Nat)
  requires character : MulChar(R, S, χ)
  shows mulCharPow(R, S, χ, m + n) =
    mulCharProduct(R, S, mulCharPow(R, S, χ, m), mulCharPow(R, S, χ, n))
proof
  sorry

-- MulChar.ringHomComp, MulChar.ringHomComp_apply.
theorem mulCharComp.char (T χ f : Set)
  requires character : MulChar(R, S, χ)
  requires hom : f : S →+* T
  shows MulChar(R, T, mulCharComp(R, S, T, χ, f)) ∧
    (∀ a ∈ Ring.carrier(R), mulCharComp(R, S, T, χ, f)(a) = f(χ(a)))
proof
  sorry

-- MulChar.toUnitHom and MulChar.ofUnitHom: characters correspond to
-- homomorphisms Rˣ → Sˣ (MulChar.ofUnitHom_coe, toUnitHom_eq).
theorem MulChar.unit_hom (χ : Set)
  requires character : MulChar(R, S, χ)
  shows GroupHom(restrict(χ, ringUnits(R)), unitGroup(R), unitGroup(S)) ∧
    mulCharOfUnitHom(R, S, restrict(χ, ringUnits(R))) = χ
proof
  sorry

theorem mulCharOfUnitHom.char (f : Set)
  requires hom : GroupHom(f, unitGroup(R), unitGroup(S))
  shows MulChar(R, S, mulCharOfUnitHom(R, S, f)) ∧
    (∀ a ∈ ringUnits(R), mulCharOfUnitHom(R, S, f)(a) = f(a))
proof
  sorry

-- MulChar.ne_one_iff: χ ≠ 1 iff some unit has χ(a) ≠ 1.
theorem MulChar.ne_one_iff (χ : Set)
  requires character : MulChar(R, S, χ)
  shows χ ≠ trivialMulChar(R, S) ↔ (∃ a ∈ ringUnits(R), χ(a) ≠ Ring.one(S))
proof
  sorry

-- Values on units are roots of unity of order |Rˣ|
-- (MulChar.apply_mem_rootsOfUnity, pow_card_units).
theorem MulChar.value_root_of_unity (χ a : Set)
  requires character : MulChar(R, S, χ)
  requires finite : Finite(Ring.carrier(R))
  requires unit : a ∈ ringUnits(R)
  shows χ(a) ∈ rootsOfUnity(S, cardinality(ringUnits(R)))
proof
  sorry

-- MulChar.sum_eq_zero_of_ne_one: Σ_a χ(a) = 0 for χ ≠ 1 on a finite
-- ring, into a domain.
theorem MulChar.sum_eq_zero (χ : Set)
  requires character : MulChar(R, S, χ)
  requires finite : Finite(Ring.carrier(R))
  requires domain : IntegralDomain(S)
  requires nontrivialChar : χ ≠ trivialMulChar(R, S)
  shows finiteRingSum(Ring.carrier(R), Ring.carrier(S), Ring.add(S), Ring.zero(S),
    Ring.neg(S), Ring.mul(S), Ring.one(S), χ) = Ring.zero(S)
proof
  sorry

-- MulChar.card_eq_card_units_of_hasEnoughRootsOfUnity: with enough n-th
-- roots of unity in a domain S, n a multiple of the exponent of Rˣ,
-- there are |Rˣ| characters.
theorem mulChars.card (n : Nat)
  requires finite : Finite(Ring.carrier(R))
  requires domain : IntegralDomain(S)
  requires exponent : ∀ a ∈ ringUnits(R), Ring.pow(R, a, n) = Ring.one(R)
  requires positive : 0 < n
  requires enough : HasEnoughRootsOfUnity(S, n)
  shows HasCardinality(mulChars(R, S), cardinality(ringUnits(R)))
proof
  sorry

end Laws

-- MulChar.exists_mulChar_orderOf: on a finite field F with n ∣ |F| − 1,
-- and a primitive n-th root of unity in the domain S, some character has
-- order exactly n.
theorem MulChar.exists_of_order (F S ζ : Set) (n : Nat)
  requires finite : FiniteField(F)
  requires domain : IntegralDomain(S)
  requires positive : 0 < n
  requires divides : n ∣ cardinality(Ring.carrier(F)) - 1
  requires primitive : IsPrimitiveRoot(S, ζ, n)
  shows ∃ χ, MulChar(F, S, χ) ∧ mulCharPow(F, S, χ, n) = trivialMulChar(F, S) ∧
    (∀ m ∈ ℕ, 0 < m → m < n → mulCharPow(F, S, χ, m) ≠ trivialMulChar(F, S))
proof
  sorry

-- Section: Complex values
-- IsPrimitiveRoot.norm'_eq_one: roots of unity in ℂ have absolute value 1.
theorem IsPrimitiveRoot.complex_abs (ζ : Set) (k : Nat)
  requires primitive : IsPrimitiveRoot(complexRing, ζ, k)
  requires positive : 0 < k
  shows complexAbs(ζ) = realOne
proof
  sorry

-- MulChar.star_apply': for R finite and values in ℂ, the conjugate of χ
-- is χ⁻¹.
theorem MulChar.conj_eq_inverse (R χ a : Set)
  requires character : MulChar(R, complexRing, χ)
  requires finite : Finite(Ring.carrier(R))
  requires member : a ∈ Ring.carrier(R)
  shows complexConj(χ(a)) = mulCharInverse(R, complexRing, χ)(a)
proof
  sorry

-- Section: Dirichlet characters
section Dirichlet
variable (N : Nat)
hypothesis positive : 0 < N

-- A character of ZMod N with complex values is a layer-1 Dirichlet
-- character on ℤ, and every layer-1 character arises from exactly one
-- (DirichletCharacter R N = MulChar (ZMod N) R).
theorem dirichletOfMulChar.character (χ : Set)
  requires character : MulChar(zmod(N), complexRing, χ)
  shows DirichletCharacter(N, dirichletOfMulChar(N, χ)) ∧
    (∀ a ∈ ℤ, dirichletOfMulChar(N, χ)(a) = χ(zmodCast(N)(a)))
proof
  sorry

theorem mulCharOfDirichlet.character (ψ : Set)
  requires character : DirichletCharacter(N, ψ)
  shows MulChar(zmod(N), complexRing, mulCharOfDirichlet(N, ψ)) ∧
    dirichletOfMulChar(N, mulCharOfDirichlet(N, ψ)) = ψ ∧
    (∀ a ∈ ℤ, mulCharOfDirichlet(N, ψ)(zmodCast(N)(a)) = ψ(a))
proof
  sorry

theorem mulCharOfDirichlet.of_mul_char (χ : Set)
  requires character : MulChar(zmod(N), complexRing, χ)
  shows mulCharOfDirichlet(N, dirichletOfMulChar(N, χ)) = χ
proof
  sorry

-- The principal character is the trivial one, products and conjugates
-- correspond (DirichletCharacter as a group).
theorem dirichletOfMulChar.trivial
  shows dirichletOfMulChar(N, trivialMulChar(zmod(N), complexRing)) = principalCharacter(N)
proof
  sorry

theorem dirichletOfMulChar.conj (χ : Set)
  requires character : MulChar(zmod(N), complexRing, χ)
  shows dirichletOfMulChar(N, mulCharInverse(zmod(N), complexRing, χ)) =
    conjCharacter(dirichletOfMulChar(N, χ))
proof
  sorry

-- The unit group of ZMod N has φ(N) elements and the characters number
-- φ(N) (ZMod.card_units_eq_totient, DirichletCharacter.card_eq_totient).
theorem zmod.units_card
  shows HasCardinality(ringUnits(zmod(N)), totient(N)) ∧
    HasCardinality(mulChars(zmod(N), complexRing), totient(N))
proof
  sorry

end Dirichlet

-- Section: ZMod laws
section ZModReduce
variable (n m : Nat)
hypothesis positive : 0 < m
hypothesis divides : m ∣ n

-- ZMod.castHom: reduction ZMod n → ZMod m is a surjective ring
-- homomorphism (ZMod.ringHom_surjective), and it maps units onto units
-- (ZMod.unitsMap, ZMod.unitsMap_surjective).
theorem zmodReduce.hom
  shows (zmodReduce(n, m) : zmod(n) →+* zmod(m)) ∧
    SurjectiveBetween(zmodReduce(n, m), Ring.carrier(zmod(n)), Ring.carrier(zmod(m)))
proof
  sorry

theorem zmodReduce.cast (a : Set)
  requires integer : a ∈ ℤ
  shows zmodReduce(n, m)(zmodCast(n)(a)) = zmodCast(m)(a)
proof
  sorry

theorem zmodReduce.units_surjective
  requires large : 0 < n
  shows SurjectiveBetween(restrict(zmodReduce(n, m), ringUnits(zmod(n))),
    ringUnits(zmod(n)), ringUnits(zmod(m)))
proof
  sorry

end ZModReduce

-- ZModModule.char_nsmul_eq_zero, AddCommGroup.zmodModule: an abelian
-- group of exponent dividing n is a ZMod n-module, and n · x = 0.
theorem zmodModule.module (G : Set) (n : Nat)
  requires abelian : AbelianGroup(G)
  requires exponent : ∀ x ∈ Group.carrier(G), groupPow(G, x, n) = Group.one(G)
  shows Module(zmodModule(G, n), zmod(n))
proof
  sorry

-- ZMod.val_one: the value of 1 is 1 for n > 1.
theorem zmodVal.one (n : Nat)
  requires large : 1 < n
  shows zmodVal(n, Ring.one(zmod(n))) = 1
proof
  sorry

-- ZMod.χ₄ and ZMod.χ₈ are characters (MulChar (ZMod 4) ℤ, MulChar
-- (ZMod 8) ℤ); ZMod.χ₄_nat_three_mod_four, ZMod.χ₈_nat_eq_if_mod_eight.
theorem chiFour.char
  shows MulChar(zmod(4), integerRing, chiFour)
proof
  sorry

theorem chiFour.three_mod_four (k : Nat)
  requires residue : integerMod(integerOfNat(k), 4) = 3
  shows chiFour(zmodCast(4)(integerOfNat(k))) = integerNegValue(integerOne)
proof
  sorry

theorem chiEight.char
  shows MulChar(zmod(8), integerRing, chiEight)
proof
  sorry

theorem chiEight.values (k : Nat)
  requires odd : integerMod(integerOfNat(k), 2) = 1
  shows ((integerMod(integerOfNat(k), 8) = 1 ∨ integerMod(integerOfNat(k), 8) = 7) →
      chiEight(zmodCast(8)(integerOfNat(k))) = integerOne) ∧
    ((integerMod(integerOfNat(k), 8) = 3 ∨ integerMod(integerOfNat(k), 8) = 5) →
      chiEight(zmodCast(8)(integerOfNat(k))) = integerNegValue(integerOne))
proof
  sorry
