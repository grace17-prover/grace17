  have p1 := exteriorProduct.mem at R, I, lt, x, y with ring, finite, xIn, yIn
  have p2 := exteriorProduct.mem at R, I, lt, x, y2 with ring, finite, xIn, y2In
  have left := exteriorProduct.mem at R, I, lt, x, call2(Module.add(exteriorModule(R, I)), y, y2) with ring, finite, xIn, sumIn
  have right := exteriorModule.add_mem at R, I, exteriorProduct(R, I, lt, x, y), exteriorProduct(R, I, lt, x, y2) with ring, p1, p2
  have xF := functionSpace.mem_iff.forward with xIn
  have yF := functionSpace.mem_iff.forward with yIn
  have y2F := functionSpace.mem_iff.forward with y2In
  apply functionSpace.ext_of with left, right
  intros U hU
  have a := exteriorProduct.apply at R, I, lt, x, call2(Module.add(exteriorModule(R, I)), y, y2), U with ring, finite, xIn, sumIn, hU
  have b := exteriorModule.add_apply at R, I, exteriorProduct(R, I, lt, x, y), exteriorProduct(R, I, lt, x, y2), U with ring, p1, p2, hU
  have c1 := exteriorProduct.apply at R, I, lt, x, y, U with ring, finite, xIn, yIn, hU
  have c2 := exteriorProduct.apply at R, I, lt, x, y2, U with ring, finite, xIn, y2In, hU
  rw [a, b, c1, c2]
