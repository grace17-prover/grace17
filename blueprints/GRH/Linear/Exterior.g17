  have w1 := exteriorProductTerms.weights at R, I, lt, x, y, U with ring, finite, xIn, yIn
  have w2 := exteriorProductTerms.weights at R, I, lt, x, y2, U with ring, finite, xIn, y2In
  have w3 := exteriorProductTerms.weights at R, I, lt, x, call2(Module.add(exteriorModule(R, I)), y, y2), U with ring, finite, xIn, sumIn
  have oneIn := Ring.one_mem at R with ringR
  have entries : ∀ q ∈ exteriorSplittings(I, U), exteriorProductTerms(R, I, lt, x, call2(Module.add(exteriorModule(R, I)), y, y2), U)(q) = R.one * exteriorProductTerms(R, I, lt, x, y, U)(q) + R.one * exteriorProductTerms(R, I, lt, x, y2, U)(q)
    intros q hq
