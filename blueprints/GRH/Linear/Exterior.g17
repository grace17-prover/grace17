    have t1 := exteriorProductTerms.value at R, I, lt, x, y, U, q with ring, xIn, yIn, hq
    have s := exteriorModule.smul_apply at R, I, r, y, snd(q) with ring, scalar, yIn, q2P
    have sg := exteriorSign.mem at R, lt, fst(q), snd(q) with ring
    have m1 := FunctionBetween.apply_closed with xF, qP
    have m3 := FunctionBetween.apply_closed with yF, q2P
    rw [t3, t1, s]
    ring
  exact finiteRingSum.scale_eq at exteriorSplittings(I, U), R.carrier, R.add, R.zero, R.neg, R.mul, R.one, exteriorProductTerms(R, I, lt, x, y, U), exteriorProductTerms(R, I, lt, x, call2(Module.smul(exteriorModule(R, I)), r, y), U), r with parts, fin, w1, w3, scalar, entries

theorem exteriorProduct.zero_left (y : Set)
  requires vIn : y ∈ functionSpace(𝒫(I), R.carrier)
  shows exteriorProduct(R, I, lt, constantFunction(𝒫(I), R.carrier, R.zero), y) = constantFunction(𝒫(I), R.carrier, R.zero)
proof
  have ringR := CommRing.to_ring with ring
  have parts := CommRing.parts with ring
  have zIn := exteriorZero.mem at R, I with ring
  have left := exteriorProduct.mem at R, I, lt, constantFunction(𝒫(I), R.carrier, R.zero), y with ring, finite, zIn, vIn
  have vF := functionSpace.mem_iff.forward with vIn
  apply functionSpace.ext_of with left, zIn
  intros U hU
  have a := exteriorProduct.apply at R, I, lt, constantFunction(𝒫(I), R.carrier, R.zero), y, U with ring, finite, zIn, vIn, hU
  have z := exteriorZero.apply at R, I, U with ring, hU
  rw [a, z]
  have fin := exteriorSplittings.finite at I, U with finite
  have weights := exteriorProductTerms.weights at R, I, lt, constantFunction(𝒫(I), R.carrier, R.zero), y, U with ring, finite, zIn, vIn
  have vanish : ∀ q ∈ exteriorSplittings(I, U), exteriorProductTerms(R, I, lt, constantFunction(𝒫(I), R.carrier, R.zero), y, U)(q) = R.zero
    intros q hq
    obtain ⟨qI, q2I, _, _, _⟩ := exteriorSplittings.parts with hq
    have qP := powerset.membership_iff.backward at fst(q), I with qI
    have q2P := powerset.membership_iff.backward at snd(q), I with q2I
    have t := exteriorProductTerms.value at R, I, lt, constantFunction(𝒫(I), R.carrier, R.zero), y, U, q with ring, zIn, vIn, hq
    have z1 := exteriorZero.apply at R, I, fst(q) with ring, qP
    have sg := exteriorSign.mem at R, lt, fst(q), snd(q) with ring
    have m := FunctionBetween.apply_closed with vF, q2P
    rw [t, z1]
    ring
  exact exteriorSum.none at R, exteriorSplittings(I, U), exteriorProductTerms(R, I, lt, constantFunction(𝒫(I), R.carrier, R.zero), y, U) with ring, fin, weights, vanish

theorem exteriorProduct.zero_right (x : Set)
  requires vIn : x ∈ functionSpace(𝒫(I), R.carrier)
  shows exteriorProduct(R, I, lt, x, constantFunction(𝒫(I), R.carrier, R.zero)) = constantFunction(𝒫(I), R.carrier, R.zero)
proof
  have ringR := CommRing.to_ring with ring
  have parts := CommRing.parts with ring
  have zIn := exteriorZero.mem at R, I with ring
  have left := exteriorProduct.mem at R, I, lt, x, constantFunction(𝒫(I), R.carrier, R.zero) with ring, finite, vIn, zIn
  have vF := functionSpace.mem_iff.forward with vIn
  apply functionSpace.ext_of with left, zIn
  intros U hU
  have a := exteriorProduct.apply at R, I, lt, x, constantFunction(𝒫(I), R.carrier, R.zero), U with ring, finite, vIn, zIn, hU
  have z := exteriorZero.apply at R, I, U with ring, hU
  rw [a, z]
  have fin := exteriorSplittings.finite at I, U with finite
  have weights := exteriorProductTerms.weights at R, I, lt, x, constantFunction(𝒫(I), R.carrier, R.zero), U with ring, finite, vIn, zIn
  have vanish : ∀ q ∈ exteriorSplittings(I, U), exteriorProductTerms(R, I, lt, x, constantFunction(𝒫(I), R.carrier, R.zero), U)(q) = R.zero
    intros q hq
    obtain ⟨qI, q2I, _, _, _⟩ := exteriorSplittings.parts with hq
    have qP := powerset.membership_iff.backward at fst(q), I with qI
    have q2P := powerset.membership_iff.backward at snd(q), I with q2I
    have t := exteriorProductTerms.value at R, I, lt, x, constantFunction(𝒫(I), R.carrier, R.zero), U, q with ring, vIn, zIn, hq
    have z1 := exteriorZero.apply at R, I, snd(q) with ring, q2P
    have sg := exteriorSign.mem at R, lt, fst(q), snd(q) with ring
    have m := FunctionBetween.apply_closed with vF, qP
    rw [t, z1]
    ring
  exact exteriorSum.none at R, exteriorSplittings(I, U), exteriorProductTerms(R, I, lt, x, constantFunction(𝒫(I), R.carrier, R.zero), U) with ring, fin, weights, vanish

end ExteriorMultiplicationLaws

-- Left and right multiplication as graphs, for the linear-extension
-- arguments.
def exteriorLeftMul (R I lt x : Set) : Set :=
  { p ∈ functionSpace(𝒫(I), Ring.carrier(R)) × functionSpace(𝒫(I), Ring.carrier(R)) |
    ∃ y ∈ functionSpace(𝒫(I), Ring.carrier(R)), p = (y, exteriorProduct(R, I, lt, x, y)) }

def exteriorRightMul (R I lt y : Set) : Set :=
  { p ∈ functionSpace(𝒫(I), Ring.carrier(R)) × functionSpace(𝒫(I), Ring.carrier(R)) |
    ∃ x ∈ functionSpace(𝒫(I), Ring.carrier(R)), p = (x, exteriorProduct(R, I, lt, x, y)) }

theorem exteriorLeftMul.graph_relates (R I lt x y : Set)
  requires index : y ∈ functionSpace(𝒫(I), Ring.carrier(R))
  requires valueIn : exteriorProduct(R, I, lt, x, y) ∈ functionSpace(𝒫(I), Ring.carrier(R))
  shows relates(exteriorLeftMul(R, I, lt, x), y, exteriorProduct(R, I, lt, x, y))
proof
  unfold relates
  apply exteriorLeftMul.membership.backward
  refine ⟨(product.pair at y, exteriorProduct(R, I, lt, x, y), functionSpace(𝒫(I), Ring.carrier(R)), functionSpace(𝒫(I), Ring.carrier(R)) with index, valueIn), y, index, rfl⟩

theorem exteriorLeftMul.graph_function (R I lt x : Set)
  requires values : ∀ y ∈ functionSpace(𝒫(I), Ring.carrier(R)), exteriorProduct(R, I, lt, x, y) ∈ functionSpace(𝒫(I), Ring.carrier(R))
  shows exteriorLeftMul(R, I, lt, x) : functionSpace(𝒫(I), Ring.carrier(R)) → functionSpace(𝒫(I), Ring.carrier(R))
proof
  constructor
    intros q0 member
    obtain ⟨bounded, witnesses⟩ := exteriorLeftMul.membership.forward with member
    exact bounded
  . constructor
      intros z0 first xFirst second xSecond
      unfold relates at xFirst
      obtain ⟨_, a1, a1In, firstShape⟩ := exteriorLeftMul.membership.forward with xFirst
      unfold relates at xSecond
      obtain ⟨_, a2, a2In, secondShape⟩ := exteriorLeftMul.membership.forward with xSecond
      obtain ⟨xi, firstEqual⟩ := orderedPair.injective with firstShape
      obtain ⟨xj, secondEqual⟩ := orderedPair.injective with secondShape
      rw [firstEqual, secondEqual]
      cc
    . intros y xIn
      have valueIn := values with y, xIn
      refine ⟨exteriorProduct(R, I, lt, x, y), valueIn, (exteriorLeftMul.graph_relates at R, I, lt, x, y with xIn, valueIn)⟩

theorem exteriorLeftMul.graph_apply (R I lt x y : Set)
  requires values : ∀ y ∈ functionSpace(𝒫(I), Ring.carrier(R)), exteriorProduct(R, I, lt, x, y) ∈ functionSpace(𝒫(I), Ring.carrier(R))
  requires index : y ∈ functionSpace(𝒫(I), Ring.carrier(R))
  shows exteriorLeftMul(R, I, lt, x)(y) = exteriorProduct(R, I, lt, x, y)
proof
  have function := exteriorLeftMul.graph_function at R, I, lt, x with values
  have valueIn := values with y, index
  have mapped := exteriorLeftMul.graph_relates at R, I, lt, x, y with index, valueIn
  exact FunctionBetween.apply_value with function, index, mapped

theorem exteriorRightMul.graph_relates (R I lt y x : Set)
  requires index : x ∈ functionSpace(𝒫(I), Ring.carrier(R))
  requires valueIn : exteriorProduct(R, I, lt, x, y) ∈ functionSpace(𝒫(I), Ring.carrier(R))
  shows relates(exteriorRightMul(R, I, lt, y), x, exteriorProduct(R, I, lt, x, y))
proof
  unfold relates
  apply exteriorRightMul.membership.backward
  refine ⟨(product.pair at x, exteriorProduct(R, I, lt, x, y), functionSpace(𝒫(I), Ring.carrier(R)), functionSpace(𝒫(I), Ring.carrier(R)) with index, valueIn), x, index, rfl⟩

theorem exteriorRightMul.graph_function (R I lt y : Set)
  requires values : ∀ x ∈ functionSpace(𝒫(I), Ring.carrier(R)), exteriorProduct(R, I, lt, x, y) ∈ functionSpace(𝒫(I), Ring.carrier(R))
  shows exteriorRightMul(R, I, lt, y) : functionSpace(𝒫(I), Ring.carrier(R)) → functionSpace(𝒫(I), Ring.carrier(R))
proof
  constructor
    intros q0 member
    obtain ⟨bounded, witnesses⟩ := exteriorRightMul.membership.forward with member
    exact bounded
  . constructor
      intros z0 first xFirst second xSecond
      unfold relates at xFirst
      obtain ⟨_, a1, a1In, firstShape⟩ := exteriorRightMul.membership.forward with xFirst
      unfold relates at xSecond
      obtain ⟨_, a2, a2In, secondShape⟩ := exteriorRightMul.membership.forward with xSecond
      obtain ⟨xi, firstEqual⟩ := orderedPair.injective with firstShape
      obtain ⟨xj, secondEqual⟩ := orderedPair.injective with secondShape
      rw [firstEqual, secondEqual]
      cc
    . intros x xIn
      have valueIn := values with x, xIn
      refine ⟨exteriorProduct(R, I, lt, x, y), valueIn, (exteriorRightMul.graph_relates at R, I, lt, y, x with xIn, valueIn)⟩

theorem exteriorRightMul.graph_apply (R I lt y x : Set)
  requires values : ∀ x ∈ functionSpace(𝒫(I), Ring.carrier(R)), exteriorProduct(R, I, lt, x, y) ∈ functionSpace(𝒫(I), Ring.carrier(R))
  requires index : x ∈ functionSpace(𝒫(I), Ring.carrier(R))
  shows exteriorRightMul(R, I, lt, y)(x) = exteriorProduct(R, I, lt, x, y)
proof
  have function := exteriorRightMul.graph_function at R, I, lt, y with values
  have valueIn := values with x, index
  have mapped := exteriorRightMul.graph_relates at R, I, lt, y, x with index, valueIn
  exact FunctionBetween.apply_value with function, index, mapped

section ExteriorAssociativity
variable (R I lt : Set)
hypothesis ring : CommRing(R)
hypothesis finite : Finite(I)

theorem exteriorBasis.basis_of
  shows ModuleBasis(exteriorModule(R, I), R, 𝒫(I), standardBasis(R, 𝒫(I)))
proof
  have power := Finite.powerset at I with finite
  unfold exteriorModule
  exact standardBasis.basis at R, 𝒫(I) with ring, power

theorem exteriorBasis.at (S : Set)
  requires index : S ∈ 𝒫(I)
  shows standardBasis(R, 𝒫(I))(S) = exteriorBasisVector(R, I, S)
proof
  unfold exteriorBasisVector
  exact standardBasis.apply at R, 𝒫(I), S with ring, index

theorem exteriorModule.smul_smul (a b x : Set)
  requires first : a ∈ R.carrier
  requires second : b ∈ R.carrier
  requires xIn : x ∈ functionSpace(𝒫(I), R.carrier)
  shows call2(Module.smul(exteriorModule(R, I)), a, call2(Module.smul(exteriorModule(R, I)), b, x)) = call2(Module.smul(exteriorModule(R, I)), a * b, x)
proof
  have ringR := CommRing.to_ring with ring
  have ab := Ring.mul_mem at R, a, b with ringR, first, second
  have bx := exteriorModule.smul_mem at R, I, b, x with ring, second, xIn
  have left := exteriorModule.smul_mem at R, I, a, call2(Module.smul(exteriorModule(R, I)), b, x) with ring, first, bx
  have right := exteriorModule.smul_mem at R, I, a * b, x with ring, ab, xIn
  have xF := functionSpace.mem_iff.forward with xIn
  apply functionSpace.ext_of with left, right
  intros U hU
  have v1 := exteriorModule.smul_apply at R, I, a, call2(Module.smul(exteriorModule(R, I)), b, x), U with ring, first, bx, hU
  have v2 := exteriorModule.smul_apply at R, I, b, x, U with ring, second, xIn, hU
  have v3 := exteriorModule.smul_apply at R, I, a * b, x, U with ring, ab, xIn, hU
  have m := FunctionBetween.apply_closed with xF, hU
  rw [v1, v2, v3]
  ring

theorem exteriorModule.smul_zero (a : Set)
  requires first : a ∈ R.carrier
  shows call2(Module.smul(exteriorModule(R, I)), a, constantFunction(𝒫(I), R.carrier, R.zero)) = constantFunction(𝒫(I), R.carrier, R.zero)
proof
  have zIn := exteriorZero.mem at R, I with ring
  have left := exteriorModule.smul_mem at R, I, a, constantFunction(𝒫(I), R.carrier, R.zero) with ring, first, zIn
  apply functionSpace.ext_of with left, zIn
  intros U hU
  have v1 := exteriorModule.smul_apply at R, I, a, constantFunction(𝒫(I), R.carrier, R.zero), U with ring, first, zIn, hU
  have z := exteriorZero.apply at R, I, U with ring, hU
  rw [v1, z]
  ring

theorem exteriorLeftMul.function_of (x : Set)
  requires xIn : x ∈ functionSpace(𝒫(I), R.carrier)
  shows exteriorLeftMul(R, I, lt, x) : Module.carrier(exteriorModule(R, I)) → Module.carrier(exteriorModule(R, I))
proof
  have carrierEq := exteriorModule.carrier_eq at R, I
  have values : ∀ y ∈ functionSpace(𝒫(I), R.carrier), exteriorProduct(R, I, lt, x, y) ∈ functionSpace(𝒫(I), R.carrier)
    intros y hy
    exact exteriorProduct.mem at R, I, lt, x, y with ring, finite, xIn, hy
  have f := exteriorLeftMul.graph_function at R, I, lt, x with values
  rw carrierEq
  exact f

theorem exteriorLeftMul.apply_of (x y : Set)
  requires xIn : x ∈ functionSpace(𝒫(I), R.carrier)
  requires yIn : y ∈ functionSpace(𝒫(I), R.carrier)
  shows exteriorLeftMul(R, I, lt, x)(y) = exteriorProduct(R, I, lt, x, y)
proof
  have values : ∀ w ∈ functionSpace(𝒫(I), R.carrier), exteriorProduct(R, I, lt, x, w) ∈ functionSpace(𝒫(I), R.carrier)
    intros w hw
    exact exteriorProduct.mem at R, I, lt, x, w with ring, finite, xIn, hw
  exact exteriorLeftMul.graph_apply at R, I, lt, x, y with values, yIn

theorem exteriorRightMul.function_of (y : Set)
  requires yIn : y ∈ functionSpace(𝒫(I), R.carrier)
  shows exteriorRightMul(R, I, lt, y) : Module.carrier(exteriorModule(R, I)) → Module.carrier(exteriorModule(R, I))
proof
  have carrierEq := exteriorModule.carrier_eq at R, I
  have values : ∀ x ∈ functionSpace(𝒫(I), R.carrier), exteriorProduct(R, I, lt, x, y) ∈ functionSpace(𝒫(I), R.carrier)
    intros x hx
    exact exteriorProduct.mem at R, I, lt, x, y with ring, finite, hx, yIn
  have f := exteriorRightMul.graph_function at R, I, lt, y with values
  rw carrierEq
  exact f

theorem exteriorRightMul.apply_of (x y : Set)
  requires xIn : x ∈ functionSpace(𝒫(I), R.carrier)
  requires yIn : y ∈ functionSpace(𝒫(I), R.carrier)
  shows exteriorRightMul(R, I, lt, y)(x) = exteriorProduct(R, I, lt, x, y)
proof
  have values : ∀ w ∈ functionSpace(𝒫(I), R.carrier), exteriorProduct(R, I, lt, w, y) ∈ functionSpace(𝒫(I), R.carrier)
    intros w hw
    exact exteriorProduct.mem at R, I, lt, w, y with ring, finite, hw, yIn
  exact exteriorRightMul.graph_apply at R, I, lt, y, x with values, xIn

theorem exteriorLeftMul.linear (x : Set)
  requires xIn : x ∈ functionSpace(𝒫(I), R.carrier)
  shows LinearMap(exteriorLeftMul(R, I, lt, x), exteriorModule(R, I), R, exteriorModule(R, I))
proof
  have module := exteriorModule.module_of at R, I with ring
  have carrierEq := exteriorModule.carrier_eq at R, I
  have function := exteriorLeftMul.function_of at R, I, lt, x with ring, finite, xIn
  apply LinearMap.of_laws with module, module, function
  . rw carrierEq
    intros v hv w hw
    have sum := exteriorModule.add_mem at R, I, v, w with ring, hv, hw
    have a1 := exteriorLeftMul.apply_of at R, I, lt, x, call2(Module.add(exteriorModule(R, I)), v, w) with ring, finite, xIn, sum
    have a2 := exteriorLeftMul.apply_of at R, I, lt, x, v with ring, finite, xIn, hv
    have a3 := exteriorLeftMul.apply_of at R, I, lt, x, w with ring, finite, xIn, hw
    rw [a1, a2, a3]
    exact exteriorProduct.add_right at R, I, lt, x, v, w with ring, finite, xIn, hv, hw
  . rw carrierEq
    intros r hr v hv
    have sv := exteriorModule.smul_mem at R, I, r, v with ring, hr, hv
    have a1 := exteriorLeftMul.apply_of at R, I, lt, x, call2(Module.smul(exteriorModule(R, I)), r, v) with ring, finite, xIn, sv
    have a2 := exteriorLeftMul.apply_of at R, I, lt, x, v with ring, finite, xIn, hv
    rw [a1, a2]
    exact exteriorProduct.smul_right at R, I, lt, r, x, v with ring, finite, hr, xIn, hv

theorem exteriorRightMul.linear (y : Set)
  requires yIn : y ∈ functionSpace(𝒫(I), R.carrier)
  shows LinearMap(exteriorRightMul(R, I, lt, y), exteriorModule(R, I), R, exteriorModule(R, I))
proof
  have module := exteriorModule.module_of at R, I with ring
  have carrierEq := exteriorModule.carrier_eq at R, I
  have function := exteriorRightMul.function_of at R, I, lt, y with ring, finite, yIn
  apply LinearMap.of_laws with module, module, function
  . rw carrierEq
    intros v hv w hw
    have sum := exteriorModule.add_mem at R, I, v, w with ring, hv, hw
    have a1 := exteriorRightMul.apply_of at R, I, lt, call2(Module.add(exteriorModule(R, I)), v, w), y with ring, finite, sum, yIn
    have a2 := exteriorRightMul.apply_of at R, I, lt, v, y with ring, finite, hv, yIn
    have a3 := exteriorRightMul.apply_of at R, I, lt, w, y with ring, finite, hw, yIn
    rw [a1, a2, a3]
    exact exteriorProduct.add_left at R, I, lt, v, w, y with ring, finite, hv, hw, yIn
  . rw carrierEq
    intros r hr v hv
    have sv := exteriorModule.smul_mem at R, I, r, v with ring, hr, hv
    have a1 := exteriorRightMul.apply_of at R, I, lt, call2(Module.smul(exteriorModule(R, I)), r, v), y with ring, finite, sv, yIn
    have a2 := exteriorRightMul.apply_of at R, I, lt, v, y with ring, finite, hv, yIn
    rw [a1, a2]
    exact exteriorProduct.smul_left at R, I, lt, r, v, y with ring, finite, hr, hv, yIn

theorem exteriorProduct.assoc_basis (S T V : Set)
  requires sI : S ⊆ I
  requires tI : T ⊆ I
  requires vI : V ⊆ I
  shows exteriorProduct(R, I, lt, exteriorProduct(R, I, lt, exteriorBasisVector(R, I, S), exteriorBasisVector(R, I, T)), exteriorBasisVector(R, I, V)) = exteriorProduct(R, I, lt, exteriorBasisVector(R, I, S), exteriorProduct(R, I, lt, exteriorBasisVector(R, I, T), exteriorBasisVector(R, I, V)))
proof
  have ringR := CommRing.to_ring with ring
  have eS := exteriorBasisVector.mem at R, I, S with ring
  have eT := exteriorBasisVector.mem at R, I, T with ring
  have eV := exteriorBasisVector.mem at R, I, V with ring
  have fS := Finite.subset at S, I with finite, sI
  have fT := Finite.subset at T, I with finite, tI
  have fV := Finite.subset at V, I with finite, vI
  have stI : S ∪ T ⊆ I
    intros z hz
    simp at hz
    cases hz with h | h
    . exact sI with z, h
    . exact tI with z, h
  have tvI : T ∪ V ⊆ I
    intros z hz
    simp at hz
    cases hz with h | h
    . exact tI with z, h
    . exact vI with z, h
  have eST := exteriorBasisVector.mem at R, I, S ∪ T with ring
  have eTV := exteriorBasisVector.mem at R, I, T ∪ V with ring
  have subS : S ⊆ S
    intros z hz
    exact hz
  have subT : T ⊆ T
    intros z hz
    exact hz
  have subV : V ⊆ V
    intros z hz
    exact hz
  have subST : S ⊆ S ∪ T
    intros z hz
    simp [hz]
  have subTST : T ⊆ S ∪ T
    intros z hz
    simp [hz]
  have subVTV : V ⊆ T ∪ V
    intros z hz
    simp [hz]
  have subTTV : T ⊆ T ∪ V
    intros z hz
    simp [hz]
  by_cases st : S ∩ T = ∅
  . have pST := exteriorProduct.basis_disjoint at R, I, lt, S, T with ring, finite, sI, tI, st
    have sgST := exteriorSign.mem at R, lt, S, T with ring
    have l1 := exteriorProduct.smul_left at R, I, lt, exteriorSign(R, lt, S, T), exteriorBasisVector(R, I, S ∪ T), exteriorBasisVector(R, I, V) with ring, finite, sgST, eST, eV
    rw [pST, l1]
    by_cases tv : T ∩ V = ∅
    . have pTV := exteriorProduct.basis_disjoint at R, I, lt, T, V with ring, finite, tI, vI, tv
      have sgTV := exteriorSign.mem at R, lt, T, V with ring
      have r1 := exteriorProduct.smul_right at R, I, lt, exteriorSign(R, lt, T, V), exteriorBasisVector(R, I, S), exteriorBasisVector(R, I, T ∪ V) with ring, finite, sgTV, eS, eTV
      rw [pTV, r1]
      by_cases sv : S ∩ V = ∅
      . have stv := exteriorSet.union_inter_empty at S, T, V with sv, tv
        have s_tv := exteriorSet.inter_union_empty at S, T, V with st, sv
        have p1 := exteriorProduct.basis_disjoint at R, I, lt, S ∪ T, V with ring, finite, stI, vI, stv
        have p2 := exteriorProduct.basis_disjoint at R, I, lt, S, T ∪ V with ring, finite, sI, tvI, s_tv
        have ua := exteriorSet.union_assoc at S, T, V
        have sg1 := exteriorSign.mem at R, lt, S ∪ T, V with ring
        have sg2 := exteriorSign.mem at R, lt, S, T ∪ V with ring
        have eAll := exteriorBasisVector.mem at R, I, S ∪ (T ∪ V) with ring
        have u1 := exteriorSign.union_left at R, lt, S, T, V with ring, fS, fT, fV, st
        have u2 := exteriorSign.union_right at R, lt, S, T, V with ring, fS, fT, fV, tv
        rw [p1, p2, ua]
        have m1 := exteriorModule.smul_smul at R, I, lt, exteriorSign(R, lt, S, T), exteriorSign(R, lt, S ∪ T, V), exteriorBasisVector(R, I, S ∪ (T ∪ V)) with ring, finite, sgST, sg1, eAll
        have m2 := exteriorModule.smul_smul at R, I, lt, exteriorSign(R, lt, T, V), exteriorSign(R, lt, S, T ∪ V), exteriorBasisVector(R, I, S ∪ (T ∪ V)) with ring, finite, sgTV, sg2, eAll
        rw [m1, m2, u1, u2]
        have sgSV := exteriorSign.mem at R, lt, S, V with ring
        have scal : exteriorSign(R, lt, S, T) * (exteriorSign(R, lt, S, V) * exteriorSign(R, lt, T, V)) = exteriorSign(R, lt, T, V) * (exteriorSign(R, lt, S, T) * exteriorSign(R, lt, S, V)) by ring
        rw scal
      . have stv := exteriorSet.inter_mono at S, V, S ∪ T, V with subST, subV, sv
        have s_tv := exteriorSet.inter_mono at S, V, S, T ∪ V with subS, subVTV, sv
        have p1 := exteriorProduct.basis_overlap at R, I, lt, S ∪ T, V with ring, finite, stI, vI, stv
        have p2 := exteriorProduct.basis_overlap at R, I, lt, S, T ∪ V with ring, finite, sI, tvI, s_tv
        have z1 := exteriorModule.smul_zero at R, I, lt, exteriorSign(R, lt, S, T) with ring, finite, sgST
        have z2 := exteriorModule.smul_zero at R, I, lt, exteriorSign(R, lt, T, V) with ring, finite, sgTV
        rw [p1, p2, z1, z2]
    . have pTV := exteriorProduct.basis_overlap at R, I, lt, T, V with ring, finite, tI, vI, tv
      have stv := exteriorSet.inter_mono at T, V, S ∪ T, V with subTST, subV, tv
      have p1 := exteriorProduct.basis_overlap at R, I, lt, S ∪ T, V with ring, finite, stI, vI, stv
      have zr := exteriorProduct.zero_right at R, I, lt, exteriorBasisVector(R, I, S) with ring, finite, eS
      have z1 := exteriorModule.smul_zero at R, I, lt, exteriorSign(R, lt, S, T) with ring, finite, sgST
      rw [pTV, p1, zr, z1]
  . have pST := exteriorProduct.basis_overlap at R, I, lt, S, T with ring, finite, sI, tI, st
    have zl := exteriorProduct.zero_left at R, I, lt, exteriorBasisVector(R, I, V) with ring, finite, eV
    rw [pST, zl]
    by_cases tv : T ∩ V = ∅
    . have pTV := exteriorProduct.basis_disjoint at R, I, lt, T, V with ring, finite, tI, vI, tv
      have sgTV := exteriorSign.mem at R, lt, T, V with ring
      have r1 := exteriorProduct.smul_right at R, I, lt, exteriorSign(R, lt, T, V), exteriorBasisVector(R, I, S), exteriorBasisVector(R, I, T ∪ V) with ring, finite, sgTV, eS, eTV
      have s_tv := exteriorSet.inter_mono at S, T, S, T ∪ V with subS, subTTV, st
      have p2 := exteriorProduct.basis_overlap at R, I, lt, S, T ∪ V with ring, finite, sI, tvI, s_tv
      have z2 := exteriorModule.smul_zero at R, I, lt, exteriorSign(R, lt, T, V) with ring, finite, sgTV
      rw [pTV, r1, p2, z2]
    . have pTV := exteriorProduct.basis_overlap at R, I, lt, T, V with ring, finite, tI, vI, tv
      have zr := exteriorProduct.zero_right at R, I, lt, exteriorBasisVector(R, I, S) with ring, finite, eS
      rw [pTV, zr]

theorem exteriorProduct.assoc_two (S T z : Set)
  requires sI : S ⊆ I
  requires tI : T ⊆ I
  requires zIn : z ∈ functionSpace(𝒫(I), R.carrier)
  shows exteriorProduct(R, I, lt, exteriorProduct(R, I, lt, exteriorBasisVector(R, I, S), exteriorBasisVector(R, I, T)), z) = exteriorProduct(R, I, lt, exteriorBasisVector(R, I, S), exteriorProduct(R, I, lt, exteriorBasisVector(R, I, T), z))
proof
  have module := exteriorModule.module_of at R, I with ring
  have basis := exteriorBasis.basis_of at R, I, lt with ring, finite
  have carrierEq := exteriorModule.carrier_eq at R, I
  have eS := exteriorBasisVector.mem at R, I, S with ring
  have eT := exteriorBasisVector.mem at R, I, T with ring
  have pST := exteriorProduct.mem at R, I, lt, exteriorBasisVector(R, I, S), exteriorBasisVector(R, I, T) with ring, finite, eS, eT
  have fS := exteriorLeftMul.function_of at R, I, lt, exteriorBasisVector(R, I, S) with ring, finite, eS
  have fT := exteriorLeftMul.function_of at R, I, lt, exteriorBasisVector(R, I, T) with ring, finite, eT
  have LS := exteriorLeftMul.linear at R, I, lt, exteriorBasisVector(R, I, S) with ring, finite, eS
  have LT := exteriorLeftMul.linear at R, I, lt, exteriorBasisVector(R, I, T) with ring, finite, eT
  have G1lin := exteriorLeftMul.linear at R, I, lt, exteriorProduct(R, I, lt, exteriorBasisVector(R, I, S), exteriorBasisVector(R, I, T)) with ring, finite, pST
  have G2lin := LinearMap.compose at exteriorLeftMul(R, I, lt, exteriorBasisVector(R, I, T)), exteriorLeftMul(R, I, lt, exteriorBasisVector(R, I, S)), exteriorModule(R, I), R, exteriorModule(R, I), exteriorModule(R, I) with LT, LS
  have agree : ∀ W ∈ 𝒫(I), (exteriorLeftMul(R, I, lt, exteriorProduct(R, I, lt, exteriorBasisVector(R, I, S), exteriorBasisVector(R, I, T))))(standardBasis(R, 𝒫(I))(W)) = (compose(exteriorLeftMul(R, I, lt, exteriorBasisVector(R, I, S)), exteriorLeftMul(R, I, lt, exteriorBasisVector(R, I, T)), Module.carrier(exteriorModule(R, I)), Module.carrier(exteriorModule(R, I)), Module.carrier(exteriorModule(R, I))))(standardBasis(R, 𝒫(I))(W))
    intros W hW
    have bW := exteriorBasis.at at R, I, lt, W with ring, finite, hW
    rw bW
    have wI := powerset.membership_iff.forward with hW
    have eW := exteriorBasisVector.mem at R, I, W with ring
    have eWC : exteriorBasisVector(R, I, W) ∈ Module.carrier(exteriorModule(R, I))
      rw carrierEq
      exact eW
    have c := compose.apply at exteriorLeftMul(R, I, lt, exteriorBasisVector(R, I, S)), exteriorLeftMul(R, I, lt, exteriorBasisVector(R, I, T)), Module.carrier(exteriorModule(R, I)), Module.carrier(exteriorModule(R, I)), Module.carrier(exteriorModule(R, I)), exteriorBasisVector(R, I, W) with fT, fS, eWC
    have pTW := exteriorProduct.mem at R, I, lt, exteriorBasisVector(R, I, T), exteriorBasisVector(R, I, W) with ring, finite, eT, eW
    have a1 := exteriorLeftMul.apply_of at R, I, lt, exteriorProduct(R, I, lt, exteriorBasisVector(R, I, S), exteriorBasisVector(R, I, T)), exteriorBasisVector(R, I, W) with ring, finite, pST, eW
    have a2 := exteriorLeftMul.apply_of at R, I, lt, exteriorBasisVector(R, I, T), exteriorBasisVector(R, I, W) with ring, finite, eT, eW
    have a3 := exteriorLeftMul.apply_of at R, I, lt, exteriorBasisVector(R, I, S), exteriorProduct(R, I, lt, exteriorBasisVector(R, I, T), exteriorBasisVector(R, I, W)) with ring, finite, eS, pTW
    rw [a1, c, a2, a3]
    exact exteriorProduct.assoc_basis at R, I, lt, S, T, W with ring, finite, sI, tI, wI
  have same := ModuleBasis.ext at R, exteriorModule(R, I), exteriorModule(R, I), exteriorLeftMul(R, I, lt, exteriorProduct(R, I, lt, exteriorBasisVector(R, I, S), exteriorBasisVector(R, I, T))), compose(exteriorLeftMul(R, I, lt, exteriorBasisVector(R, I, S)), exteriorLeftMul(R, I, lt, exteriorBasisVector(R, I, T)), Module.carrier(exteriorModule(R, I)), Module.carrier(exteriorModule(R, I)), Module.carrier(exteriorModule(R, I))), 𝒫(I), standardBasis(R, 𝒫(I)) with ring, module, basis, G1lin, G2lin, agree
  have zC : z ∈ Module.carrier(exteriorModule(R, I))
    rw carrierEq
    exact zIn
  have c := compose.apply at exteriorLeftMul(R, I, lt, exteriorBasisVector(R, I, S)), exteriorLeftMul(R, I, lt, exteriorBasisVector(R, I, T)), Module.carrier(exteriorModule(R, I)), Module.carrier(exteriorModule(R, I)), Module.carrier(exteriorModule(R, I)), z with fT, fS, zC
  have pTz := exteriorProduct.mem at R, I, lt, exteriorBasisVector(R, I, T), z with ring, finite, eT, zIn
  have a1 := exteriorLeftMul.apply_of at R, I, lt, exteriorProduct(R, I, lt, exteriorBasisVector(R, I, S), exteriorBasisVector(R, I, T)), z with ring, finite, pST, zIn
  have a2 := exteriorLeftMul.apply_of at R, I, lt, exteriorBasisVector(R, I, T), z with ring, finite, eT, zIn
  have a3 := exteriorLeftMul.apply_of at R, I, lt, exteriorBasisVector(R, I, S), exteriorProduct(R, I, lt, exteriorBasisVector(R, I, T), z) with ring, finite, eS, pTz
  rw [← a1, same, c, a2, a3]

theorem exteriorProduct.assoc_one (S y z : Set)
  requires sI : S ⊆ I
  requires yIn : y ∈ functionSpace(𝒫(I), R.carrier)
  requires zIn : z ∈ functionSpace(𝒫(I), R.carrier)
  shows exteriorProduct(R, I, lt, exteriorProduct(R, I, lt, exteriorBasisVector(R, I, S), y), z) = exteriorProduct(R, I, lt, exteriorBasisVector(R, I, S), exteriorProduct(R, I, lt, y, z))
proof
  have module := exteriorModule.module_of at R, I with ring
  have basis := exteriorBasis.basis_of at R, I, lt with ring, finite
  have carrierEq := exteriorModule.carrier_eq at R, I
  have eS := exteriorBasisVector.mem at R, I, S with ring
  have fS := exteriorLeftMul.function_of at R, I, lt, exteriorBasisVector(R, I, S) with ring, finite, eS
  have fZ := exteriorRightMul.function_of at R, I, lt, z with ring, finite, zIn
  have LS := exteriorLeftMul.linear at R, I, lt, exteriorBasisVector(R, I, S) with ring, finite, eS
  have RZ := exteriorRightMul.linear at R, I, lt, z with ring, finite, zIn
  have G1lin := LinearMap.compose at exteriorLeftMul(R, I, lt, exteriorBasisVector(R, I, S)), exteriorRightMul(R, I, lt, z), exteriorModule(R, I), R, exteriorModule(R, I), exteriorModule(R, I) with LS, RZ
  have G2lin := LinearMap.compose at exteriorRightMul(R, I, lt, z), exteriorLeftMul(R, I, lt, exteriorBasisVector(R, I, S)), exteriorModule(R, I), R, exteriorModule(R, I), exteriorModule(R, I) with RZ, LS
  have agree : ∀ W ∈ 𝒫(I), (compose(exteriorRightMul(R, I, lt, z), exteriorLeftMul(R, I, lt, exteriorBasisVector(R, I, S)), Module.carrier(exteriorModule(R, I)), Module.carrier(exteriorModule(R, I)), Module.carrier(exteriorModule(R, I))))(standardBasis(R, 𝒫(I))(W)) = (compose(exteriorLeftMul(R, I, lt, exteriorBasisVector(R, I, S)), exteriorRightMul(R, I, lt, z), Module.carrier(exteriorModule(R, I)), Module.carrier(exteriorModule(R, I)), Module.carrier(exteriorModule(R, I))))(standardBasis(R, 𝒫(I))(W))
    intros W hW
    have bW := exteriorBasis.at at R, I, lt, W with ring, finite, hW
    rw bW
    have wI := powerset.membership_iff.forward with hW
    have eW := exteriorBasisVector.mem at R, I, W with ring
    have eWC : exteriorBasisVector(R, I, W) ∈ Module.carrier(exteriorModule(R, I))
      rw carrierEq
      exact eW
    have c1 := compose.apply at exteriorRightMul(R, I, lt, z), exteriorLeftMul(R, I, lt, exteriorBasisVector(R, I, S)), Module.carrier(exteriorModule(R, I)), Module.carrier(exteriorModule(R, I)), Module.carrier(exteriorModule(R, I)), exteriorBasisVector(R, I, W) with fS, fZ, eWC
    have c2 := compose.apply at exteriorLeftMul(R, I, lt, exteriorBasisVector(R, I, S)), exteriorRightMul(R, I, lt, z), Module.carrier(exteriorModule(R, I)), Module.carrier(exteriorModule(R, I)), Module.carrier(exteriorModule(R, I)), exteriorBasisVector(R, I, W) with fZ, fS, eWC
    have pSW := exteriorProduct.mem at R, I, lt, exteriorBasisVector(R, I, S), exteriorBasisVector(R, I, W) with ring, finite, eS, eW
    have pWz := exteriorProduct.mem at R, I, lt, exteriorBasisVector(R, I, W), z with ring, finite, eW, zIn
    have a1 := exteriorLeftMul.apply_of at R, I, lt, exteriorBasisVector(R, I, S), exteriorBasisVector(R, I, W) with ring, finite, eS, eW
    have a2 := exteriorRightMul.apply_of at R, I, lt, exteriorProduct(R, I, lt, exteriorBasisVector(R, I, S), exteriorBasisVector(R, I, W)), z with ring, finite, pSW, zIn
    have a3 := exteriorRightMul.apply_of at R, I, lt, exteriorBasisVector(R, I, W), z with ring, finite, eW, zIn
    have a4 := exteriorLeftMul.apply_of at R, I, lt, exteriorBasisVector(R, I, S), exteriorProduct(R, I, lt, exteriorBasisVector(R, I, W), z) with ring, finite, eS, pWz
    rw [c1, c2, a1, a2, a3, a4]
    exact exteriorProduct.assoc_two at R, I, lt, S, W, z with ring, finite, sI, wI, zIn
  have same := ModuleBasis.ext at R, exteriorModule(R, I), exteriorModule(R, I), compose(exteriorRightMul(R, I, lt, z), exteriorLeftMul(R, I, lt, exteriorBasisVector(R, I, S)), Module.carrier(exteriorModule(R, I)), Module.carrier(exteriorModule(R, I)), Module.carrier(exteriorModule(R, I))), compose(exteriorLeftMul(R, I, lt, exteriorBasisVector(R, I, S)), exteriorRightMul(R, I, lt, z), Module.carrier(exteriorModule(R, I)), Module.carrier(exteriorModule(R, I)), Module.carrier(exteriorModule(R, I))), 𝒫(I), standardBasis(R, 𝒫(I)) with ring, module, basis, G1lin, G2lin, agree
  have yC : y ∈ Module.carrier(exteriorModule(R, I))
    rw carrierEq
    exact yIn
  have c1 := compose.apply at exteriorRightMul(R, I, lt, z), exteriorLeftMul(R, I, lt, exteriorBasisVector(R, I, S)), Module.carrier(exteriorModule(R, I)), Module.carrier(exteriorModule(R, I)), Module.carrier(exteriorModule(R, I)), y with fS, fZ, yC
  have c2 := compose.apply at exteriorLeftMul(R, I, lt, exteriorBasisVector(R, I, S)), exteriorRightMul(R, I, lt, z), Module.carrier(exteriorModule(R, I)), Module.carrier(exteriorModule(R, I)), Module.carrier(exteriorModule(R, I)), y with fZ, fS, yC
  have pSy := exteriorProduct.mem at R, I, lt, exteriorBasisVector(R, I, S), y with ring, finite, eS, yIn
  have pyz := exteriorProduct.mem at R, I, lt, y, z with ring, finite, yIn, zIn
  have a1 := exteriorLeftMul.apply_of at R, I, lt, exteriorBasisVector(R, I, S), y with ring, finite, eS, yIn
  have a2 := exteriorRightMul.apply_of at R, I, lt, exteriorProduct(R, I, lt, exteriorBasisVector(R, I, S), y), z with ring, finite, pSy, zIn
  have a3 := exteriorRightMul.apply_of at R, I, lt, y, z with ring, finite, yIn, zIn
  have a4 := exteriorLeftMul.apply_of at R, I, lt, exteriorBasisVector(R, I, S), exteriorProduct(R, I, lt, y, z) with ring, finite, eS, pyz
  have v1 : compose(exteriorRightMul(R, I, lt, z), exteriorLeftMul(R, I, lt, exteriorBasisVector(R, I, S)), Module.carrier(exteriorModule(R, I)), Module.carrier(exteriorModule(R, I)), Module.carrier(exteriorModule(R, I)))(y) = exteriorProduct(R, I, lt, exteriorProduct(R, I, lt, exteriorBasisVector(R, I, S), y), z)
    rw [c1, a1, a2]
  have v2 : compose(exteriorLeftMul(R, I, lt, exteriorBasisVector(R, I, S)), exteriorRightMul(R, I, lt, z), Module.carrier(exteriorModule(R, I)), Module.carrier(exteriorModule(R, I)), Module.carrier(exteriorModule(R, I)))(y) = exteriorProduct(R, I, lt, exteriorBasisVector(R, I, S), exteriorProduct(R, I, lt, y, z))
    rw [c2, a3, a4]
  rw [← v1, ← v2, same]

theorem exteriorProduct.assoc (x y z : Set)
  requires xIn : x ∈ functionSpace(𝒫(I), R.carrier)
  requires yIn : y ∈ functionSpace(𝒫(I), R.carrier)
  requires zIn : z ∈ functionSpace(𝒫(I), R.carrier)
  shows exteriorProduct(R, I, lt, exteriorProduct(R, I, lt, x, y), z) = exteriorProduct(R, I, lt, x, exteriorProduct(R, I, lt, y, z))
proof
  have module := exteriorModule.module_of at R, I with ring
  have basis := exteriorBasis.basis_of at R, I, lt with ring, finite
  have carrierEq := exteriorModule.carrier_eq at R, I
  have fY := exteriorRightMul.function_of at R, I, lt, y with ring, finite, yIn
  have fZ := exteriorRightMul.function_of at R, I, lt, z with ring, finite, zIn
  have RY := exteriorRightMul.linear at R, I, lt, y with ring, finite, yIn
  have RZ := exteriorRightMul.linear at R, I, lt, z with ring, finite, zIn
  have pyz := exteriorProduct.mem at R, I, lt, y, z with ring, finite, yIn, zIn
  have G1lin := LinearMap.compose at exteriorRightMul(R, I, lt, y), exteriorRightMul(R, I, lt, z), exteriorModule(R, I), R, exteriorModule(R, I), exteriorModule(R, I) with RY, RZ
  have G2lin := exteriorRightMul.linear at R, I, lt, exteriorProduct(R, I, lt, y, z) with ring, finite, pyz
  have agree : ∀ W ∈ 𝒫(I), (compose(exteriorRightMul(R, I, lt, z), exteriorRightMul(R, I, lt, y), Module.carrier(exteriorModule(R, I)), Module.carrier(exteriorModule(R, I)), Module.carrier(exteriorModule(R, I))))(standardBasis(R, 𝒫(I))(W)) = (exteriorRightMul(R, I, lt, exteriorProduct(R, I, lt, y, z)))(standardBasis(R, 𝒫(I))(W))
    intros W hW
    have bW := exteriorBasis.at at R, I, lt, W with ring, finite, hW
    rw bW
    have wI := powerset.membership_iff.forward with hW
    have eW := exteriorBasisVector.mem at R, I, W with ring
    have eWC : exteriorBasisVector(R, I, W) ∈ Module.carrier(exteriorModule(R, I))
      rw carrierEq
      exact eW
    have c1 := compose.apply at exteriorRightMul(R, I, lt, z), exteriorRightMul(R, I, lt, y), Module.carrier(exteriorModule(R, I)), Module.carrier(exteriorModule(R, I)), Module.carrier(exteriorModule(R, I)), exteriorBasisVector(R, I, W) with fY, fZ, eWC
    have pWy := exteriorProduct.mem at R, I, lt, exteriorBasisVector(R, I, W), y with ring, finite, eW, yIn
    have a1 := exteriorRightMul.apply_of at R, I, lt, exteriorBasisVector(R, I, W), y with ring, finite, eW, yIn
    have a2 := exteriorRightMul.apply_of at R, I, lt, exteriorProduct(R, I, lt, exteriorBasisVector(R, I, W), y), z with ring, finite, pWy, zIn
    have a3 := exteriorRightMul.apply_of at R, I, lt, exteriorBasisVector(R, I, W), exteriorProduct(R, I, lt, y, z) with ring, finite, eW, pyz
    rw [c1, a1, a2, a3]
    exact exteriorProduct.assoc_one at R, I, lt, W, y, z with ring, finite, wI, yIn, zIn
  have same := ModuleBasis.ext at R, exteriorModule(R, I), exteriorModule(R, I), compose(exteriorRightMul(R, I, lt, z), exteriorRightMul(R, I, lt, y), Module.carrier(exteriorModule(R, I)), Module.carrier(exteriorModule(R, I)), Module.carrier(exteriorModule(R, I))), exteriorRightMul(R, I, lt, exteriorProduct(R, I, lt, y, z)), 𝒫(I), standardBasis(R, 𝒫(I)) with ring, module, basis, G1lin, G2lin, agree
  have xC : x ∈ Module.carrier(exteriorModule(R, I))
    rw carrierEq
    exact xIn
  have c1 := compose.apply at exteriorRightMul(R, I, lt, z), exteriorRightMul(R, I, lt, y), Module.carrier(exteriorModule(R, I)), Module.carrier(exteriorModule(R, I)), Module.carrier(exteriorModule(R, I)), x with fY, fZ, xC
  have pxy := exteriorProduct.mem at R, I, lt, x, y with ring, finite, xIn, yIn
  have a1 := exteriorRightMul.apply_of at R, I, lt, x, y with ring, finite, xIn, yIn
  have a2 := exteriorRightMul.apply_of at R, I, lt, exteriorProduct(R, I, lt, x, y), z with ring, finite, pxy, zIn
  have a3 := exteriorRightMul.apply_of at R, I, lt, x, exteriorProduct(R, I, lt, y, z) with ring, finite, xIn, pyz
  have v1 : compose(exteriorRightMul(R, I, lt, z), exteriorRightMul(R, I, lt, y), Module.carrier(exteriorModule(R, I)), Module.carrier(exteriorModule(R, I)), Module.carrier(exteriorModule(R, I)))(x) = exteriorProduct(R, I, lt, exteriorProduct(R, I, lt, x, y), z)
    rw [c1, a1, a2]
  rw [← v1, same, a3]

end ExteriorAssociativity

-- Section: Laws
section Exterior
variable (R I lt : Set)
hypothesis ring : CommRing(R)
hypothesis finite : Finite(I)
hypothesis order : StrictLinearOrder(I, lt)

theorem exteriorAlgebra.ring
  shows Ring(exteriorAlgebra(R, I, lt))
proof
  sorry

theorem exteriorModule.module
  shows Module(exteriorModule(R, I), R)
proof
  sorry

-- The additive structure of the ring is that of the module R^𝒫(I).
theorem exteriorAlgebra.additive
  shows Ring.carrier(exteriorAlgebra(R, I, lt)) =
      Module.carrier(exteriorModule(R, I)) ∧
    Ring.add(exteriorAlgebra(R, I, lt)) = Module.add(exteriorModule(R, I))
proof
  sorry

-- The basis {e_S} of ⋀Rᴵ (Basis.ExteriorAlgebra of Pi.basisFun), of rank
-- 2^|I|.
theorem exteriorBasisVector.basis
  shows ModuleBasis(exteriorModule(R, I), R, 𝒫(I),
    standardBasis(R, 𝒫(I)))
proof
  sorry

-- e_S e_T = sign(S, T) e_{S ∪ T} for S ∩ T = ∅, and 0 otherwise
-- (ExteriorAlgebra.basis_mul_of_disjoint).
theorem exteriorBasisVector.mul_disjoint (S T : Set)
  requires first : S ⊆ I
  requires second : T ⊆ I
  requires disjoint : S ∩ T = ∅
  shows call2(Ring.mul(exteriorAlgebra(R, I, lt)),
      exteriorBasisVector(R, I, S), exteriorBasisVector(R, I, T)) =
    call2(Module.smul(exteriorModule(R, I)), exteriorSign(R, lt, S, T),
      exteriorBasisVector(R, I, S ∪ T))
proof
  sorry

theorem exteriorBasisVector.mul_overlap (S T : Set)
  requires first : S ⊆ I
  requires second : T ⊆ I
  requires overlap : S ∩ T ≠ ∅
  shows call2(Ring.mul(exteriorAlgebra(R, I, lt)),
      exteriorBasisVector(R, I, S), exteriorBasisVector(R, I, T)) =
    Ring.zero(exteriorAlgebra(R, I, lt))
proof
  sorry

theorem exteriorSign.swap (S T : Set)
  requires first : S ⊆ I
  requires second : T ⊆ I
  requires disjoint : S ∩ T = ∅
  shows call2(R.mul, exteriorSign(R, lt, S, T), exteriorSign(R, lt, T, S)) =
    monoidPow(R.mul, R.one, -R.one, cardinality(S) * cardinality(T))
proof
  sorry

-- The scalars are central and form a copy of R (algebraMap).
theorem exteriorScalar.central_hom
  shows CentralRingHom(exteriorScalar(R, I), R, exteriorAlgebra(R, I, lt))
proof
  sorry

-- The action of R is multiplication by scalars.
theorem exteriorScalar.smul (r x : Set)
  requires scalar : r ∈ R.carrier
  requires member : x ∈ functionSpace(𝒫(I), R.carrier)
  shows call2(Ring.mul(exteriorAlgebra(R, I, lt)), exteriorScalar(R, I)(r), x) =
    call2(Module.smul(exteriorModule(R, I)), r, x)
proof
  sorry

-- ExteriorAlgebra.algebraMapInv is a ring map, left inverse to the
-- scalars.
theorem exteriorDegreeZero.hom
  shows RingHom(exteriorDegreeZero(R, I), exteriorAlgebra(R, I, lt), R)
proof
  sorry

theorem exteriorDegreeZero.scalar (r : R)
  shows exteriorDegreeZero(R, I)(exteriorScalar(R, I)(r)) = r
proof
  sorry

theorem exteriorIota.linear
  shows LinearMap(exteriorIota(R, I), coordinateModule(R, I), R,
    exteriorModule(R, I))
proof
  sorry

theorem exteriorIota.unit_vector (i : Set)
  requires index : i ∈ I
  shows exteriorIota(R, I)(unitVector(R, I, i)) = exteriorBasisVector(R, I, {i})
proof
  sorry

-- ExteriorAlgebra.ι_sq_zero and ι_add_mul_swap: ι(v)² = 0 and
-- ι(u) ι(v) = −ι(v) ι(u).
theorem exteriorIota.square_zero (v : Set)
  requires vector : v ∈ functionSpace(I, R.carrier)
  shows call2(Ring.mul(exteriorAlgebra(R, I, lt)), exteriorIota(R, I)(v),
    exteriorIota(R, I)(v)) = Ring.zero(exteriorAlgebra(R, I, lt))
proof
  sorry

theorem exteriorIota.anticommute (u v : Set)
  requires first : u ∈ functionSpace(I, R.carrier)
  requires second : v ∈ functionSpace(I, R.carrier)
  shows call2(Ring.mul(exteriorAlgebra(R, I, lt)), exteriorIota(R, I)(u),
      exteriorIota(R, I)(v)) =
    apply(Ring.neg(exteriorAlgebra(R, I, lt)),
      call2(Ring.mul(exteriorAlgebra(R, I, lt)), exteriorIota(R, I)(v),
        exteriorIota(R, I)(u)))
proof
  sorry

-- The products of the ι(e_i) in increasing order are the basis vectors.
theorem exteriorMultiProduct.basis_vector (k : Nat) (u S : Set)
  requires subset : S ⊆ I
  requires increasing : BijectiveBetween(u, k, S) ∧
    (∀ a ∈ k, ∀ b ∈ k, a < b → (u(a), u(b)) ∈ lt)
  shows exteriorMultiProduct(R, I, lt, compose(standardBasis(R, I), u, k, I,
      functionSpace(I, R.carrier)), k) = exteriorBasisVector(R, I, S)
proof
  sorry

-- ιMulti is alternating: it vanishes when two vectors agree.
theorem exteriorMultiProduct.alternating (k : Nat) (u a b : Set)
  requires vectors : u : k → functionSpace(I, R.carrier)
  requires first : a ∈ k
  requires second : b ∈ k
  requires distinct : a ≠ b
  requires same : u(a) = u(b)
  shows exteriorMultiProduct(R, I, lt, u, k) = Ring.zero(exteriorAlgebra(R, I, lt))
proof
  sorry

theorem exteriorMultiProduct.mem_power (k : Nat) (u : Set)
  requires vectors : u : k → functionSpace(I, R.carrier)
  shows exteriorMultiProduct(R, I, lt, u, k) ∈ exteriorPower(R, I, k)
proof
  sorry

theorem exteriorPower.submodule (k : Nat)
  shows SubmoduleOf(exteriorPower(R, I, k), exteriorModule(R, I), R)
proof
  sorry

-- ⋀ᵏ Rᴵ has the basis e_S, |S| = k, so rank (|I| choose k)
-- (Basis.exteriorPower).
theorem exteriorPower.basis (k : Nat)
  shows ModuleBasis(submoduleModule(exteriorModule(R, I), R,
    exteriorPower(R, I, k)), R, subsetsOfSize(I, k), exteriorPowerBasis(R, I, k))
proof
  sorry

theorem exteriorPower.mul (j k : Nat) (x y : Set)
  requires first : x ∈ exteriorPower(R, I, j)
  requires second : y ∈ exteriorPower(R, I, k)
  shows call2(Ring.mul(exteriorAlgebra(R, I, lt)), x, y) ∈
    exteriorPower(R, I, j + k)
proof
  sorry

-- Every element is the sum of its homogeneous parts: ⋀Rᴵ is the direct
-- sum of the ⋀ᵏ, k ≤ |I|.
theorem exteriorPower.top (k : Nat)
  requires large : cardinality(I) < k
  shows exteriorPower(R, I, k) = {Ring.zero(exteriorAlgebra(R, I, lt))}
proof
  sorry

-- ExteriorAlgebra.lift: the universal property.
theorem exteriorLift.hom (A φ f : Set)
  requires data : ExteriorData(R, I, A, φ, f)
  shows RingHom(exteriorLift(R, I, lt, A, φ, f), exteriorAlgebra(R, I, lt), A)
proof
  sorry

theorem exteriorLift.iota (A φ f v : Set)
  requires data : ExteriorData(R, I, A, φ, f)
  requires vector : v ∈ functionSpace(I, R.carrier)
  shows exteriorLift(R, I, lt, A, φ, f)(exteriorIota(R, I)(v)) = f(v)
proof
  sorry

theorem exteriorLift.scalar (A φ f r : Set)
  requires data : ExteriorData(R, I, A, φ, f)
  requires scalar : r ∈ R.carrier
  shows exteriorLift(R, I, lt, A, φ, f)(exteriorScalar(R, I)(r)) = φ(r)
proof
  sorry

theorem exteriorLift.eq_of_agree (A φ f F : Set)
  requires data : ExteriorData(R, I, A, φ, f)
  requires hom : RingHom(F, exteriorAlgebra(R, I, lt), A)
  requires onIota : ∀ v ∈ functionSpace(I, R.carrier),
    F(exteriorIota(R, I)(v)) = f(v)
  requires onScalars : ∀ r ∈ R.carrier, F(exteriorScalar(R, I)(r)) = φ(r)
  shows F = exteriorLift(R, I, lt, A, φ, f)
proof
  sorry

-- ExteriorAlgebra.map: a linear map g gives a ring map on exterior
-- algebras with ι(v) ↦ ι(g(v)), functorially.
theorem exteriorMap.hom (J lt2 g : Set)
  requires finiteJ : Finite(J)
  requires orderJ : StrictLinearOrder(J, lt2)
  requires linear : LinearMap(g, coordinateModule(R, I), R, coordinateModule(R, J))
  shows RingHom(exteriorMap(R, I, lt, J, lt2, g), exteriorAlgebra(R, I, lt),
    exteriorAlgebra(R, J, lt2))
proof
  sorry

theorem exteriorMap.iota (J lt2 g v : Set)
  requires finiteJ : Finite(J)
  requires orderJ : StrictLinearOrder(J, lt2)
  requires linear : LinearMap(g, coordinateModule(R, I), R, coordinateModule(R, J))
  requires vector : v ∈ functionSpace(I, R.carrier)
  shows exteriorMap(R, I, lt, J, lt2, g)(exteriorIota(R, I)(v)) =
    exteriorIota(R, J)(g(v))
proof
  sorry

theorem exteriorMap.multi_product (J lt2 g : Set) (k : Nat) (u : Set)
  requires finiteJ : Finite(J)
  requires orderJ : StrictLinearOrder(J, lt2)
  requires linear : LinearMap(g, coordinateModule(R, I), R, coordinateModule(R, J))
  requires vectors : u : k → functionSpace(I, R.carrier)
  shows exteriorMap(R, I, lt, J, lt2, g)(exteriorMultiProduct(R, I, lt, u, k)) =
    exteriorMultiProduct(R, J, lt2, compose(g, u, k, functionSpace(I, R.carrier),
      functionSpace(J, R.carrier)), k)
proof
  sorry

theorem exteriorMap.degree (J lt2 g x : Set) (k : Nat)
  requires finiteJ : Finite(J)
  requires orderJ : StrictLinearOrder(J, lt2)
  requires linear : LinearMap(g, coordinateModule(R, I), R, coordinateModule(R, J))
  requires member : x ∈ exteriorPower(R, I, k)
  shows exteriorMap(R, I, lt, J, lt2, g)(x) ∈ exteriorPower(R, J, k)
proof
  sorry

theorem exteriorMap.identity
  shows exteriorMap(R, I, lt, I, lt, identity(functionSpace(I, R.carrier))) =
    identity(functionSpace(𝒫(I), R.carrier))
proof
  sorry

-- The contraction ι_c is linear, lowers degree by one, and is a graded
-- derivation: ι_c(ι(v) x) = c(v) x − ι(v) ι_c(x)
-- (contractLeft_ι_mul), with ι_c ∘ ι_c = 0.
theorem exteriorContraction.linear (c : Set)
  requires form : c ∈ functionSpace(I, R.carrier)
  shows LinearMap(exteriorContraction(R, I, lt, c), exteriorModule(R, I), R,
    exteriorModule(R, I))
proof
  sorry

theorem exteriorContraction.iota_mul (c v x : Set)
  requires form : c ∈ functionSpace(I, R.carrier)
  requires vector : v ∈ functionSpace(I, R.carrier)
  requires member : x ∈ functionSpace(𝒫(I), R.carrier)
  shows exteriorContraction(R, I, lt, c)(call2(Ring.mul(exteriorAlgebra(R, I, lt)),
      exteriorIota(R, I)(v), x)) =
    call2(Ring.add(exteriorAlgebra(R, I, lt)),
      call2(Module.smul(exteriorModule(R, I)),
        finiteRingSum(I, R.carrier, R.add, R.zero, R.neg, R.mul, R.one,
          combinationTerms(selfModule(R), R, I, c, v)), x),
      apply(Ring.neg(exteriorAlgebra(R, I, lt)),
        call2(Ring.mul(exteriorAlgebra(R, I, lt)), exteriorIota(R, I)(v),
          exteriorContraction(R, I, lt, c)(x))))
proof
  sorry

theorem exteriorContraction.one (c : Set)
  requires form : c ∈ functionSpace(I, R.carrier)
  shows exteriorContraction(R, I, lt, c)(exteriorBasisVector(R, I, ∅)) =
    Ring.zero(exteriorAlgebra(R, I, lt))
proof
  sorry

theorem exteriorContraction.square_zero (c x : Set)
  requires form : c ∈ functionSpace(I, R.carrier)
  requires member : x ∈ functionSpace(𝒫(I), R.carrier)
  shows exteriorContraction(R, I, lt, c)(exteriorContraction(R, I, lt, c)(x)) =
    Ring.zero(exteriorAlgebra(R, I, lt))
proof
  sorry

theorem exteriorContraction.degree (c x : Set) (k : Nat)
  requires form : c ∈ functionSpace(I, R.carrier)
  requires member : x ∈ exteriorPower(R, I, succ(k))
  shows exteriorContraction(R, I, lt, c)(x) ∈ exteriorPower(R, I, k)
proof
  sorry

end Exterior
