    rw [c2, a3, a4]
  rw [← v1, ← v2, same]

theorem exteriorProduct.assoc (x y z : Set)
  requires xIn : x ∈ functionSpace(𝒫(I), R.carrier)
  requires yIn : y ∈ functionSpace(𝒫(I), R.carrier)
  requires zIn : z ∈ functionSpace(𝒫(I), R.carrier)
  shows exteriorProduct(R, I, lt, exteriorProduct(R, I, lt, x, y), z) = exteriorProduct(R, I, lt, x, exteriorProduct(R, I, lt, y, z))
proof
  have module := exteriorModule.module_of at R, I with ring
  have basis := exteriorBasis.basis_of at R, I, lt with ring, finite
  have carrierEq := exteriorModule.carrier_eq at R, I
  have fY := exteriorRightMul.function_of at R, I, lt, y with ring, finite, yIn
  have fZ := exteriorRightMul.function_of at R, I, lt, z with ring, finite, zIn
  have RY := exteriorRightMul.linear at R, I, lt, y with ring, finite, yIn
  have RZ := exteriorRightMul.linear at R, I, lt, z with ring, finite, zIn
  have pyz := exteriorProduct.mem at R, I, lt, y, z with ring, finite, yIn, zIn
  have G1lin := LinearMap.compose at exteriorRightMul(R, I, lt, y), exteriorRightMul(R, I, lt, z), exteriorModule(R, I), R, exteriorModule(R, I), exteriorModule(R, I) with RY, RZ
  have G2lin := exteriorRightMul.linear at R, I, lt, exteriorProduct(R, I, lt, y, z) with ring, finite, pyz
  have agree : ∀ W ∈ 𝒫(I), (compose(exteriorRightMul(R, I, lt, z), exteriorRightMul(R, I, lt, y), Module.carrier(exteriorModule(R, I)), Module.carrier(exteriorModule(R, I)), Module.carrier(exteriorModule(R, I))))(standardBasis(R, 𝒫(I))(W)) = (exteriorRightMul(R, I, lt, exteriorProduct(R, I, lt, y, z)))(standardBasis(R, 𝒫(I))(W))
    intros W hW
    have bW := exteriorBasis.at at R, I, lt, W with ring, finite, hW
    rw bW
    have wI := powerset.membership_iff.forward with hW
    have eW := exteriorBasisVector.mem at R, I, W with ring
    have eWC : exteriorBasisVector(R, I, W) ∈ Module.carrier(exteriorModule(R, I))
      rw carrierEq
      exact eW
    have c1 := compose.apply at exteriorRightMul(R, I, lt, z), exteriorRightMul(R, I, lt, y), Module.carrier(exteriorModule(R, I)), Module.carrier(exteriorModule(R, I)), Module.carrier(exteriorModule(R, I)), exteriorBasisVector(R, I, W) with fY, fZ, eWC
    have pWy := exteriorProduct.mem at R, I, lt, exteriorBasisVector(R, I, W), y with ring, finite, eW, yIn
    have a1 := exteriorRightMul.apply_of at R, I, lt, exteriorBasisVector(R, I, W), y with ring, finite, eW, yIn
    have a2 := exteriorRightMul.apply_of at R, I, lt, exteriorProduct(R, I, lt, exteriorBasisVector(R, I, W), y), z with ring, finite, pWy, zIn
    have a3 := exteriorRightMul.apply_of at R, I, lt, exteriorBasisVector(R, I, W), exteriorProduct(R, I, lt, y, z) with ring, finite, eW, pyz
    rw [c1, a1, a2, a3]
    exact exteriorProduct.assoc_one at R, I, lt, W, y, z with ring, finite, wI, yIn, zIn
  have same := ModuleBasis.ext at R, exteriorModule(R, I), exteriorModule(R, I), compose(exteriorRightMul(R, I, lt, z), exteriorRightMul(R, I, lt, y), Module.carrier(exteriorModule(R, I)), Module.carrier(exteriorModule(R, I)), Module.carrier(exteriorModule(R, I))), exteriorRightMul(R, I, lt, exteriorProduct(R, I, lt, y, z)), 𝒫(I), standardBasis(R, 𝒫(I)) with ring, module, basis, G1lin, G2lin, agree
  have xC : x ∈ Module.carrier(exteriorModule(R, I))
    rw carrierEq
    exact xIn
  have c1 := compose.apply at exteriorRightMul(R, I, lt, z), exteriorRightMul(R, I, lt, y), Module.carrier(exteriorModule(R, I)), Module.carrier(exteriorModule(R, I)), Module.carrier(exteriorModule(R, I)), x with fY, fZ, xC
  have pxy := exteriorProduct.mem at R, I, lt, x, y with ring, finite, xIn, yIn
  have a1 := exteriorRightMul.apply_of at R, I, lt, x, y with ring, finite, xIn, yIn
  have a2 := exteriorRightMul.apply_of at R, I, lt, exteriorProduct(R, I, lt, x, y), z with ring, finite, pxy, zIn
  have a3 := exteriorRightMul.apply_of at R, I, lt, x, exteriorProduct(R, I, lt, y, z) with ring, finite, xIn, pyz
  have v1 : compose(exteriorRightMul(R, I, lt, z), exteriorRightMul(R, I, lt, y), Module.carrier(exteriorModule(R, I)), Module.carrier(exteriorModule(R, I)), Module.carrier(exteriorModule(R, I)))(x) = exteriorProduct(R, I, lt, exteriorProduct(R, I, lt, x, y), z)
    rw [c1, a1, a2]
  rw [← v1, same, a3]

theorem exteriorMultiplication.call (x y : Set)
  requires xIn : x ∈ functionSpace(𝒫(I), R.carrier)
  requires yIn : y ∈ functionSpace(𝒫(I), R.carrier)
  shows call2(exteriorMultiplication(R, I, lt), x, y) = exteriorProduct(R, I, lt, x, y)
proof
  have pair := product.pair at x, y, functionSpace(𝒫(I), R.carrier), functionSpace(𝒫(I), R.carrier) with xIn, yIn
  have v := exteriorMultiplication.value at R, I, lt, (x, y) with ring, finite, pair
  rw [fst.pair, snd.pair] at v
  unfold call2
  exact v

theorem exteriorProduct.one_left (x : Set)
  requires xIn : x ∈ functionSpace(𝒫(I), R.carrier)
  shows exteriorProduct(R, I, lt, exteriorBasisVector(R, I, ∅), x) = x
proof
  have ringR := CommRing.to_ring with ring
  have eIn := exteriorBasisVector.mem at R, I, ∅ with ring
  have left := exteriorProduct.mem at R, I, lt, exteriorBasisVector(R, I, ∅), x with ring, finite, eIn, xIn
  have xF := functionSpace.mem_iff.forward with xIn
  apply functionSpace.ext_of with left, xIn
  intros U hU
  have sub : ∅ ⊆ I
    intros z hz
    simp at hz
  have sub2 : ∅ ⊆ U
    intros z hz
    simp at hz
  have formula := exteriorProduct.basis_left at R, I, lt, ∅, x, U with ring, finite, sub, xIn, hU
  have l := formula.left with sub2
  have d : U ∖ ∅ = U
    ext z
    simp
  have s := exteriorSign.empty_left at R, lt, U with ring
  have m := FunctionBetween.apply_closed with xF, hU
  rw [l, d, s]
  ring

theorem exteriorProduct.one_right (x : Set)
  requires xIn : x ∈ functionSpace(𝒫(I), R.carrier)
  shows exteriorProduct(R, I, lt, x, exteriorBasisVector(R, I, ∅)) = x
proof
  have ringR := CommRing.to_ring with ring
  have eIn := exteriorBasisVector.mem at R, I, ∅ with ring
  have left := exteriorProduct.mem at R, I, lt, x, exteriorBasisVector(R, I, ∅) with ring, finite, xIn, eIn
  have xF := functionSpace.mem_iff.forward with xIn
  apply functionSpace.ext_of with left, xIn
  intros U hU
  have sub : ∅ ⊆ I
    intros z hz
    simp at hz
  have sub2 : ∅ ⊆ U
    intros z hz
    simp at hz
  have formula := exteriorProduct.basis_right at R, I, lt, x, ∅, U with ring, finite, xIn, sub, hU
  have l := formula.left with sub2
  have d : U ∖ ∅ = U
    ext z
    simp
  have s := exteriorSign.empty_right at R, lt, U with ring
  have m := FunctionBetween.apply_closed with xF, hU
  rw [l, d, s]
  ring

theorem exteriorAlgebra.ring_of
  shows Ring(exteriorAlgebra(R, I, lt))
proof
  have ringR := CommRing.to_ring with ring
  have module := exteriorModule.module_of at R, I with ring
  have abelian := Module.additive.abelian_group at exteriorModule(R, I), R with module
  have groupParts := Module.additive_parts with abelian
  obtain ⟨c, a, z, n⟩ := exteriorModule.parts at R, I
  rw [c, a, z, n] at groupParts
  have mulF := exteriorMultiplication.function at R, I, lt with ring, finite
  have oneIn := exteriorBasisVector.mem at R, I, ∅ with ring
  have callEq : ∀ x ∈ functionSpace(𝒫(I), R.carrier), ∀ y ∈ functionSpace(𝒫(I), R.carrier), call2(exteriorMultiplication(R, I, lt), x, y) = exteriorProduct(R, I, lt, x, y)
    intros x hx y hy
    exact exteriorMultiplication.call at R, I, lt, x, y with ring, finite, hx, hy
  have isRing : IsRing(functionSpace(𝒫(I), R.carrier), functionModuleAdd(R, 𝒫(I), selfModule(R)), constantFunction(𝒫(I), R.carrier, R.zero), functionModuleNeg(R, 𝒫(I), selfModule(R)), exteriorMultiplication(R, I, lt), exteriorBasisVector(R, I, ∅))
    unfold IsRing
    refine ⟨groupParts, ?_, ?_⟩
    . unfold IsMonoid
      refine ⟨?_, ?_⟩
      . unfold IsSemigroup
        refine ⟨mulF, ?_⟩
        intros x hx y hy w hw
        have xy := exteriorProduct.mem at R, I, lt, x, y with ring, finite, hx, hy
        have yw := exteriorProduct.mem at R, I, lt, y, w with ring, finite, hy, hw
        have e1 := callEq with x, hx, y, hy
        have e2 := callEq with exteriorProduct(R, I, lt, x, y), xy, w, hw
        have e3 := callEq with y, hy, w, hw
        have e4 := callEq with x, hx, exteriorProduct(R, I, lt, y, w), yw
        rw [e1, e2, e3, e4]
        exact exteriorProduct.assoc at R, I, lt, x, y, w with ring, finite, hx, hy, hw
      . unfold Identity
        refine ⟨oneIn, ?_⟩
        intros x hx
        have e1 := callEq with exteriorBasisVector(R, I, ∅), oneIn, x, hx
        have e2 := callEq with x, hx, exteriorBasisVector(R, I, ∅), oneIn
        have o1 := exteriorProduct.one_left at R, I, lt, x with ring, finite, hx
        have o2 := exteriorProduct.one_right at R, I, lt, x with ring, finite, hx
        rw [e1, e2, o1, o2]
        exact ⟨rfl, rfl⟩
    . unfold Distributive
      intros x hx y hy w hw
      rw ← a
      have yw := exteriorModule.add_mem at R, I, y, w with ring, hy, hw
      have xy := exteriorModule.add_mem at R, I, x, y with ring, hx, hy
      have e1 := callEq with x, hx, call2(Module.add(exteriorModule(R, I)), y, w), yw
      have e2 := callEq with x, hx, y, hy
      have e3 := callEq with x, hx, w, hw
      have e4 := callEq with call2(Module.add(exteriorModule(R, I)), x, y), xy, w, hw
      have e5 := callEq with y, hy, w, hw
      rw [e1, e2, e3, e4, e5]
      constructor
      . exact exteriorProduct.add_right at R, I, lt, x, y, w with ring, finite, hx, hy, hw
      . exact exteriorProduct.add_left at R, I, lt, x, y, w with ring, finite, hx, hy, hw
  unfold exteriorAlgebra
  exact Ring.of_parts with isRing

end ExteriorAssociativity

-- Section: Scalars and degree zero
theorem exteriorScalar.graph_relates (R I r : Set)
  requires index : r ∈ Ring.carrier(R)
  requires valueIn : call2(Module.smul(exteriorModule(R, I)), r, exteriorBasisVector(R, I, ∅)) ∈ functionSpace(𝒫(I), Ring.carrier(R))
  shows relates(exteriorScalar(R, I), r, call2(Module.smul(exteriorModule(R, I)), r, exteriorBasisVector(R, I, ∅)))
proof
  unfold relates
  apply exteriorScalar.membership.backward
  refine ⟨(product.pair at r, call2(Module.smul(exteriorModule(R, I)), r, exteriorBasisVector(R, I, ∅)), Ring.carrier(R), functionSpace(𝒫(I), Ring.carrier(R)) with index, valueIn), r, index, rfl⟩

theorem exteriorScalar.graph_function (R I : Set)
  requires values : ∀ r ∈ Ring.carrier(R), call2(Module.smul(exteriorModule(R, I)), r, exteriorBasisVector(R, I, ∅)) ∈ functionSpace(𝒫(I), Ring.carrier(R))
  shows exteriorScalar(R, I) : Ring.carrier(R) → functionSpace(𝒫(I), Ring.carrier(R))
proof
  constructor
    intros q0 member
    obtain ⟨bounded, witnesses⟩ := exteriorScalar.membership.forward with member
    exact bounded
  . constructor
      intros z0 first xFirst second xSecond
      unfold relates at xFirst
      obtain ⟨_, a1, a1In, firstShape⟩ := exteriorScalar.membership.forward with xFirst
      unfold relates at xSecond
      obtain ⟨_, a2, a2In, secondShape⟩ := exteriorScalar.membership.forward with xSecond
      obtain ⟨xi, firstEqual⟩ := orderedPair.injective with firstShape
      obtain ⟨xj, secondEqual⟩ := orderedPair.injective with secondShape
      rw [firstEqual, secondEqual]
      cc
    . intros r xIn
      have valueIn := values with r, xIn
      refine ⟨call2(Module.smul(exteriorModule(R, I)), r, exteriorBasisVector(R, I, ∅)), valueIn, (exteriorScalar.graph_relates at R, I, r with xIn, valueIn)⟩

theorem exteriorScalar.graph_apply (R I r : Set)
  requires values : ∀ r ∈ Ring.carrier(R), call2(Module.smul(exteriorModule(R, I)), r, exteriorBasisVector(R, I, ∅)) ∈ functionSpace(𝒫(I), Ring.carrier(R))
  requires index : r ∈ Ring.carrier(R)
  shows exteriorScalar(R, I)(r) = call2(Module.smul(exteriorModule(R, I)), r, exteriorBasisVector(R, I, ∅))
proof
  have function := exteriorScalar.graph_function at R, I with values
  have valueIn := values with r, index
  have mapped := exteriorScalar.graph_relates at R, I, r with index, valueIn
  exact FunctionBetween.apply_value with function, index, mapped

theorem exteriorDegreeZero.graph_relates (R I x : Set)
  requires index : x ∈ functionSpace(𝒫(I), Ring.carrier(R))
  requires valueIn : x(∅) ∈ Ring.carrier(R)
  shows relates(exteriorDegreeZero(R, I), x, x(∅))
proof
  unfold relates
  apply exteriorDegreeZero.membership.backward
  refine ⟨(product.pair at x, x(∅), functionSpace(𝒫(I), Ring.carrier(R)), Ring.carrier(R) with index, valueIn), x, index, rfl⟩

theorem exteriorDegreeZero.graph_function (R I : Set)
  requires values : ∀ x ∈ functionSpace(𝒫(I), Ring.carrier(R)), x(∅) ∈ Ring.carrier(R)
  shows exteriorDegreeZero(R, I) : functionSpace(𝒫(I), Ring.carrier(R)) → Ring.carrier(R)
proof
  constructor
    intros q0 member
    obtain ⟨bounded, witnesses⟩ := exteriorDegreeZero.membership.forward with member
    exact bounded
  . constructor
      intros z0 first xFirst second xSecond
      unfold relates at xFirst
      obtain ⟨_, a1, a1In, firstShape⟩ := exteriorDegreeZero.membership.forward with xFirst
      unfold relates at xSecond
      obtain ⟨_, a2, a2In, secondShape⟩ := exteriorDegreeZero.membership.forward with xSecond
      obtain ⟨xi, firstEqual⟩ := orderedPair.injective with firstShape
      obtain ⟨xj, secondEqual⟩ := orderedPair.injective with secondShape
      rw [firstEqual, secondEqual]
      cc
    . intros x xIn
      have valueIn := values with x, xIn
      refine ⟨x(∅), valueIn, (exteriorDegreeZero.graph_relates at R, I, x with xIn, valueIn)⟩

theorem exteriorDegreeZero.graph_apply (R I x : Set)
  requires values : ∀ x ∈ functionSpace(𝒫(I), Ring.carrier(R)), x(∅) ∈ Ring.carrier(R)
  requires index : x ∈ functionSpace(𝒫(I), Ring.carrier(R))
  shows exteriorDegreeZero(R, I)(x) = x(∅)
proof
  have function := exteriorDegreeZero.graph_function at R, I with values
  have valueIn := values with x, index
  have mapped := exteriorDegreeZero.graph_relates at R, I, x with index, valueIn
  exact FunctionBetween.apply_value with function, index, mapped

section ExteriorScalars
variable (R I lt : Set)
hypothesis ring : CommRing(R)
hypothesis finite : Finite(I)

theorem exteriorScalar.values
  shows ∀ r ∈ R.carrier, call2(Module.smul(exteriorModule(R, I)), r, exteriorBasisVector(R, I, ∅)) ∈ functionSpace(𝒫(I), R.carrier)
proof
  have eIn := exteriorBasisVector.mem at R, I, ∅ with ring
  intros r hr
  exact exteriorModule.smul_mem at R, I, r, exteriorBasisVector(R, I, ∅) with ring, hr, eIn

theorem exteriorScalar.apply_of (r : Set)
  requires scalar : r ∈ R.carrier
  shows exteriorScalar(R, I)(r) = call2(Module.smul(exteriorModule(R, I)), r, exteriorBasisVector(R, I, ∅))
proof
  have values := exteriorScalar.values at R, I, lt with ring, finite
  exact exteriorScalar.graph_apply at R, I, r with values, scalar

theorem exteriorScalar.mul_left (r x : Set)
  requires scalar : r ∈ R.carrier
  requires xIn : x ∈ functionSpace(𝒫(I), R.carrier)
  shows exteriorProduct(R, I, lt, call2(Module.smul(exteriorModule(R, I)), r, exteriorBasisVector(R, I, ∅)), x) = call2(Module.smul(exteriorModule(R, I)), r, x)
proof
  have eIn := exteriorBasisVector.mem at R, I, ∅ with ring
  have l := exteriorProduct.smul_left at R, I, lt, r, exteriorBasisVector(R, I, ∅), x with ring, finite, scalar, eIn, xIn
  have o := exteriorProduct.one_left at R, I, lt, x with ring, finite, xIn
  rw [l, o]

theorem exteriorScalar.mul_right (r x : Set)
  requires scalar : r ∈ R.carrier
  requires xIn : x ∈ functionSpace(𝒫(I), R.carrier)
  shows exteriorProduct(R, I, lt, x, call2(Module.smul(exteriorModule(R, I)), r, exteriorBasisVector(R, I, ∅))) = call2(Module.smul(exteriorModule(R, I)), r, x)
proof
  have eIn := exteriorBasisVector.mem at R, I, ∅ with ring
  have l := exteriorProduct.smul_right at R, I, lt, r, x, exteriorBasisVector(R, I, ∅) with ring, finite, scalar, xIn, eIn
  have o := exteriorProduct.one_right at R, I, lt, x with ring, finite, xIn
  rw [l, o]

theorem exteriorScalar.hom_of
  shows RingHom(exteriorScalar(R, I), R, exteriorAlgebra(R, I, lt))
proof
  have ringR := CommRing.to_ring with ring
  have target := exteriorAlgebra.ring_of at R, I, lt with ring, finite
  obtain ⟨c, a, _, _, m, o⟩ := exteriorAlgebra.projections at R, I, lt
  have values := exteriorScalar.values at R, I, lt with ring, finite
  have f0 := exteriorScalar.graph_function at R, I with values
  have function : exteriorScalar(R, I) : R.carrier → Ring.carrier(exteriorAlgebra(R, I, lt))
    rw c
    exact f0
  have eIn := exteriorBasisVector.mem at R, I, ∅ with ring
  have eF := functionSpace.mem_iff.forward with eIn
  apply exteriorRingHom.of_add_mul with ringR, target, function
  . intros r hr s hs
    have rs := Ring.add_mem at R, r, s with ringR, hr, hs
    have a1 := exteriorScalar.apply_of at R, I, lt, call2(R.add, r, s) with ring, finite, rs
    have a2 := exteriorScalar.apply_of at R, I, lt, r with ring, finite, hr
    have a3 := exteriorScalar.apply_of at R, I, lt, s with ring, finite, hs
    rw [a1, a2, a3, a]
    have m1 := exteriorModule.smul_mem at R, I, call2(R.add, r, s), exteriorBasisVector(R, I, ∅) with ring, rs, eIn
    have m2 := exteriorModule.smul_mem at R, I, r, exteriorBasisVector(R, I, ∅) with ring, hr, eIn
    have m3 := exteriorModule.smul_mem at R, I, s, exteriorBasisVector(R, I, ∅) with ring, hs, eIn
    have m4 := exteriorModule.add_mem at R, I, call2(Module.smul(exteriorModule(R, I)), r, exteriorBasisVector(R, I, ∅)), call2(Module.smul(exteriorModule(R, I)), s, exteriorBasisVector(R, I, ∅)) with ring, m2, m3
    apply functionSpace.ext_of with m1, m4
    intros U hU
    have v1 := exteriorModule.smul_apply at R, I, call2(R.add, r, s), exteriorBasisVector(R, I, ∅), U with ring, rs, eIn, hU
    have v2 := exteriorModule.add_apply at R, I, call2(Module.smul(exteriorModule(R, I)), r, exteriorBasisVector(R, I, ∅)), call2(Module.smul(exteriorModule(R, I)), s, exteriorBasisVector(R, I, ∅)), U with ring, m2, m3, hU
    have v3 := exteriorModule.smul_apply at R, I, r, exteriorBasisVector(R, I, ∅), U with ring, hr, eIn, hU
    have v4 := exteriorModule.smul_apply at R, I, s, exteriorBasisVector(R, I, ∅), U with ring, hs, eIn, hU
    have eU := FunctionBetween.apply_closed with eF, hU
    rw [v1, v2, v3, v4]
    ring
  . intros r hr s hs
    have rs := Ring.mul_mem at R, r, s with ringR, hr, hs
    have a1 := exteriorScalar.apply_of at R, I, lt, call2(R.mul, r, s) with ring, finite, rs
    have a2 := exteriorScalar.apply_of at R, I, lt, r with ring, finite, hr
    have a3 := exteriorScalar.apply_of at R, I, lt, s with ring, finite, hs
    have m3 := exteriorModule.smul_mem at R, I, s, exteriorBasisVector(R, I, ∅) with ring, hs, eIn
    have m2 := exteriorModule.smul_mem at R, I, r, exteriorBasisVector(R, I, ∅) with ring, hr, eIn
    have me := exteriorAlgebra.mul_eq at R, I, lt, call2(Module.smul(exteriorModule(R, I)), r, exteriorBasisVector(R, I, ∅)), call2(Module.smul(exteriorModule(R, I)), s, exteriorBasisVector(R, I, ∅)) with ring, finite, m2, m3
    have ml := exteriorScalar.mul_left at R, I, lt, r, call2(Module.smul(exteriorModule(R, I)), s, exteriorBasisVector(R, I, ∅)) with ring, finite, hr, m3
    have ss := exteriorModule.smul_smul at R, I, lt, r, s, exteriorBasisVector(R, I, ∅) with ring, finite, hr, hs, eIn
    rw [a1, a2, a3, me, ml, ss]
  . have oneIn := Ring.one_mem at R with ringR
    have a1 := exteriorScalar.apply_of at R, I, lt, R.one with ring, finite, oneIn
    rw [a1, o]
    have m1 := exteriorModule.smul_mem at R, I, R.one, exteriorBasisVector(R, I, ∅) with ring, oneIn, eIn
    apply functionSpace.ext_of with m1, eIn
    intros U hU
    have v1 := exteriorModule.smul_apply at R, I, R.one, exteriorBasisVector(R, I, ∅), U with ring, oneIn, eIn, hU
    have eU := FunctionBetween.apply_closed with eF, hU
    rw v1
    ring

theorem exteriorScalar.central_of
  shows CentralRingHom(exteriorScalar(R, I), R, exteriorAlgebra(R, I, lt))
proof
  have hom := exteriorScalar.hom_of at R, I, lt with ring, finite
  obtain ⟨c, _, _, _, _, _⟩ := exteriorAlgebra.projections at R, I, lt
  unfold CentralRingHom
  refine ⟨hom, ?_⟩
  rw c
  intros r hr x hx
  have a1 := exteriorScalar.apply_of at R, I, lt, r with ring, finite, hr
  have eIn := exteriorBasisVector.mem at R, I, ∅ with ring
  have m := exteriorModule.smul_mem at R, I, r, exteriorBasisVector(R, I, ∅) with ring, hr, eIn
  have me1 := exteriorAlgebra.mul_eq at R, I, lt, call2(Module.smul(exteriorModule(R, I)), r, exteriorBasisVector(R, I, ∅)), x with ring, finite, m, hx
  have me2 := exteriorAlgebra.mul_eq at R, I, lt, x, call2(Module.smul(exteriorModule(R, I)), r, exteriorBasisVector(R, I, ∅)) with ring, finite, hx, m
  have l := exteriorScalar.mul_left at R, I, lt, r, x with ring, finite, hr, hx
  have rr := exteriorScalar.mul_right at R, I, lt, r, x with ring, finite, hr, hx
  rw [a1, me1, me2, l, rr]

theorem exteriorProduct.at_empty (x y : Set)
  requires xIn : x ∈ functionSpace(𝒫(I), R.carrier)
  requires yIn : y ∈ functionSpace(𝒫(I), R.carrier)
  shows exteriorProduct(R, I, lt, x, y)(∅) = x(∅) * y(∅)
proof
  have ringR := CommRing.to_ring with ring
  have emptyP := powerset.empty_member at I
  have value := exteriorProduct.apply at R, I, lt, x, y, ∅ with ring, finite, xIn, yIn, emptyP
  have fin := exteriorSplittings.finite at I, ∅ with finite
  have weights := exteriorProductTerms.weights at R, I, lt, x, y, ∅ with ring, finite, xIn, yIn
  have sub : ∅ ⊆ I
    intros z hz
    simp at hz
  have dis : ∅ ∩ ∅ = ∅
    ext z
    simp
  have un : ∅ ∪ ∅ = ∅
    ext z
    simp
  have c0 := exteriorSplittings.pair at I, ∅, ∅ with sub, sub, dis
  rw un at c0
  have vanish : ∀ q ∈ exteriorSplittings(I, ∅), q ≠ (∅, ∅) → exteriorProductTerms(R, I, lt, x, y, ∅)(q) = R.zero
    intros q hq ne
    obtain ⟨_, _, _, u, shape⟩ := exteriorSplittings.parts with hq
    have e1 : fst(q) = ∅
      ext z
      constructor
      . intros hz
        have hz2 : z ∈ fst(q) ∪ snd(q)
          simp [hz]
        rw u at hz2
        exact hz2
      . intros hz
        simp at hz
    have e2 : snd(q) = ∅
      ext z
      constructor
      . intros hz
        have hz2 : z ∈ fst(q) ∪ snd(q)
          simp [hz]
        rw u at hz2
        exact hz2
      . intros hz
        simp at hz
    exfalso
    apply ne
    rw shape
    rw [e1, e2]
  have only := exteriorSum.only at R, exteriorSplittings(I, ∅), exteriorProductTerms(R, I, lt, x, y, ∅), (∅, ∅) with ring, fin, weights, c0, vanish
  have t := exteriorProductTerms.value at R, I, lt, x, y, ∅, (∅, ∅) with ring, xIn, yIn, c0
  have s := exteriorSign.empty_left at R, lt, ∅ with ring
  have xF := functionSpace.mem_iff.forward with xIn
  have yF := functionSpace.mem_iff.forward with yIn
  have xv := FunctionBetween.apply_closed with xF, emptyP
  have yv := FunctionBetween.apply_closed with yF, emptyP
  rw [value, only, t, fst.pair, snd.pair, s]
  ring

theorem exteriorDegreeZero.apply_of (x : Set)
  requires xIn : x ∈ functionSpace(𝒫(I), R.carrier)
  shows exteriorDegreeZero(R, I)(x) = x(∅)
proof
  have emptyP := powerset.empty_member at I
  have values : ∀ w ∈ functionSpace(𝒫(I), R.carrier), w(∅) ∈ R.carrier
    intros w hw
    have wF := functionSpace.mem_iff.forward with hw
    exact FunctionBetween.apply_closed with wF, emptyP
  exact exteriorDegreeZero.graph_apply at R, I, x with values, xIn

theorem exteriorDegreeZero.hom_of
  shows RingHom(exteriorDegreeZero(R, I), exteriorAlgebra(R, I, lt), R)
proof
  have ringR := CommRing.to_ring with ring
  have source := exteriorAlgebra.ring_of at R, I, lt with ring, finite
  obtain ⟨c, a, _, _, m, o⟩ := exteriorAlgebra.projections at R, I, lt
  have emptyP := powerset.empty_member at I
  have values : ∀ w ∈ functionSpace(𝒫(I), R.carrier), w(∅) ∈ R.carrier
    intros w hw
    have wF := functionSpace.mem_iff.forward with hw
    exact FunctionBetween.apply_closed with wF, emptyP
  have f0 := exteriorDegreeZero.graph_function at R, I with values
  have function : exteriorDegreeZero(R, I) : Ring.carrier(exteriorAlgebra(R, I, lt)) → R.carrier
    rw c
    exact f0
  apply exteriorRingHom.of_add_mul with source, ringR, function
  . rw [c, a]
    intros x hx y hy
    have s := exteriorModule.add_mem at R, I, x, y with ring, hx, hy
    have a1 := exteriorDegreeZero.apply_of at R, I, lt, call2(Module.add(exteriorModule(R, I)), x, y) with ring, finite, s
    have a2 := exteriorDegreeZero.apply_of at R, I, lt, x with ring, finite, hx
    have a3 := exteriorDegreeZero.apply_of at R, I, lt, y with ring, finite, hy
    have v := exteriorModule.add_apply at R, I, x, y, ∅ with ring, hx, hy, emptyP
    rw [a1, a2, a3, v]
  . rw c
    intros x hx y hy
    have me := exteriorAlgebra.mul_eq at R, I, lt, x, y with ring, finite, hx, hy
    have p := exteriorProduct.mem at R, I, lt, x, y with ring, finite, hx, hy
    have a1 := exteriorDegreeZero.apply_of at R, I, lt, exteriorProduct(R, I, lt, x, y) with ring, finite, p
    have a2 := exteriorDegreeZero.apply_of at R, I, lt, x with ring, finite, hx
    have a3 := exteriorDegreeZero.apply_of at R, I, lt, y with ring, finite, hy
    have z := exteriorProduct.at_empty at R, I, lt, x, y with ring, finite, hx, hy
    rw [me, a1, a2, a3, z]
  . have eIn := exteriorBasisVector.mem at R, I, ∅ with ring
    have a1 := exteriorDegreeZero.apply_of at R, I, lt, exteriorBasisVector(R, I, ∅) with ring, finite, eIn
    have b := exteriorBasisVector.apply at R, I, ∅, ∅ with ring, emptyP
    have one := b.left with rfl
    rw [o, a1, one]

theorem exteriorDegreeZero.scalar_of (r : Set)
  requires scalar : r ∈ R.carrier
  shows exteriorDegreeZero(R, I)(exteriorScalar(R, I)(r)) = r
proof
  have ringR := CommRing.to_ring with ring
  have emptyP := powerset.empty_member at I
  have eIn := exteriorBasisVector.mem at R, I, ∅ with ring
  have m := exteriorModule.smul_mem at R, I, r, exteriorBasisVector(R, I, ∅) with ring, scalar, eIn
  have a1 := exteriorScalar.apply_of at R, I, lt, r with ring, finite, scalar
  have a2 := exteriorDegreeZero.apply_of at R, I, lt, call2(Module.smul(exteriorModule(R, I)), r, exteriorBasisVector(R, I, ∅)) with ring, finite, m
  have v := exteriorModule.smul_apply at R, I, r, exteriorBasisVector(R, I, ∅), ∅ with ring, scalar, eIn, emptyP
  have b := exteriorBasisVector.apply at R, I, ∅, ∅ with ring, emptyP
  have one := b.left with rfl
  rw [a1, a2, v, one]
  ring

end ExteriorScalars

-- Section: Degree one
theorem exteriorIota.graph_relates (R I v : Set)
  requires index : v ∈ functionSpace(I, Ring.carrier(R))
  requires valueIn : exteriorDegreeOne(R, I, v) ∈ functionSpace(𝒫(I), Ring.carrier(R))
  shows relates(exteriorIota(R, I), v, exteriorDegreeOne(R, I, v))
proof
  unfold relates
  apply exteriorIota.membership.backward
  refine ⟨(product.pair at v, exteriorDegreeOne(R, I, v), functionSpace(I, Ring.carrier(R)), functionSpace(𝒫(I), Ring.carrier(R)) with index, valueIn), v, index, rfl⟩

theorem exteriorIota.graph_function (R I : Set)
  requires values : ∀ v ∈ functionSpace(I, Ring.carrier(R)), exteriorDegreeOne(R, I, v) ∈ functionSpace(𝒫(I), Ring.carrier(R))
  shows exteriorIota(R, I) : functionSpace(I, Ring.carrier(R)) → functionSpace(𝒫(I), Ring.carrier(R))
proof
  constructor
    intros q0 member
    obtain ⟨bounded, witnesses⟩ := exteriorIota.membership.forward with member
    exact bounded
  . constructor
      intros z0 first xFirst second xSecond
      unfold relates at xFirst
      obtain ⟨_, a1, a1In, firstShape⟩ := exteriorIota.membership.forward with xFirst
      unfold relates at xSecond
      obtain ⟨_, a2, a2In, secondShape⟩ := exteriorIota.membership.forward with xSecond
      obtain ⟨xi, firstEqual⟩ := orderedPair.injective with firstShape
      obtain ⟨xj, secondEqual⟩ := orderedPair.injective with secondShape
      rw [firstEqual, secondEqual]
      cc
    . intros v xIn
      have valueIn := values with v, xIn
      refine ⟨exteriorDegreeOne(R, I, v), valueIn, (exteriorIota.graph_relates at R, I, v with xIn, valueIn)⟩

theorem exteriorIota.graph_apply (R I v : Set)
  requires values : ∀ v ∈ functionSpace(I, Ring.carrier(R)), exteriorDegreeOne(R, I, v) ∈ functionSpace(𝒫(I), Ring.carrier(R))
  requires index : v ∈ functionSpace(I, Ring.carrier(R))
  shows exteriorIota(R, I)(v) = exteriorDegreeOne(R, I, v)
proof
  have function := exteriorIota.graph_function at R, I with values
  have valueIn := values with v, index
  have mapped := exteriorIota.graph_relates at R, I, v with index, valueIn
  exact FunctionBetween.apply_value with function, index, mapped

section ExteriorDegreeOne
variable (R I : Set)
hypothesis ring : CommRing(R)

theorem coordinateModule.add_at (u w i : Set)
  requires uIn : u ∈ functionSpace(I, R.carrier)
  requires wIn : w ∈ functionSpace(I, R.carrier)
  requires index : i ∈ I
  shows call2(Module.add(coordinateModule(R, I)), u, w)(i) = u(i) + w(i)
proof
  have ringR := CommRing.to_ring with ring
  have self := Ring.to_module at R with ringR
  have selfCarrier := selfModule.carrier_eq at R
  have uS : u ∈ functionSpace(I, Module.carrier(selfModule(R)))
    rw selfCarrier
    exact uIn
  have wS : w ∈ functionSpace(I, Module.carrier(selfModule(R)))
    rw selfCarrier
    exact wIn
  have value := functionModule.add_apply at R, I, selfModule(R), u, w, i with ringR, self, uS, wS, index
  rw selfModule.add_eq at value
  unfold coordinateModule
  exact value

theorem coordinateModule.smul_at (r u i : Set)
  requires scalar : r ∈ R.carrier
  requires uIn : u ∈ functionSpace(I, R.carrier)
  requires index : i ∈ I
  shows call2(Module.smul(coordinateModule(R, I)), r, u)(i) = r * u(i)
proof
  have ringR := CommRing.to_ring with ring
  have self := Ring.to_module at R with ringR
  have selfCarrier := selfModule.carrier_eq at R
  have uS : u ∈ functionSpace(I, Module.carrier(selfModule(R)))
    rw selfCarrier
    exact uIn
  have value := functionModule.smul_apply at R, I, selfModule(R), r, u, i with ringR, self, scalar, uS, index
  rw selfModule.smul_eq at value
  unfold coordinateModule
  exact value

theorem exteriorDegreeOne.function_of (v : Set)
  requires vIn : v ∈ functionSpace(I, R.carrier)
  shows exteriorDegreeOne(R, I, v) : 𝒫(I) → R.carrier
proof
  have ringR := CommRing.to_ring with ring
  have zeroIn := Ring.zero_mem at R with ringR
  have vF := functionSpace.mem_iff.forward with vIn
  constructor
    intros p member
    obtain ⟨bounded, _⟩ := exteriorDegreeOne.membership.forward with member
    exact bounded
  . constructor
      intros S a1 h1 a2 h2
      unfold relates at h1
      unfold relates at h2
      obtain ⟨_, S1, hS1, c1⟩ := exteriorDegreeOne.membership.forward with h1
      obtain ⟨_, S2, hS2, c2⟩ := exteriorDegreeOne.membership.forward with h2
      cases c1 with k1 | k1
      . obtain ⟨i, hi, si, p1⟩ := k1
        obtain ⟨e1, f1⟩ := orderedPair.injective with p1
        cases c2 with k2 | k2
        . obtain ⟨j, hj, sj, p2⟩ := k2
          obtain ⟨e2, f2⟩ := orderedPair.injective with p2
          have ss : {i} = {j}
            rw [← si, ← sj, ← e1, ← e2]
          have ij := singleton.injective with ss
          rw [f1, f2, ij]
        . obtain ⟨none, p2⟩ := k2
          obtain ⟨e2, f2⟩ := orderedPair.injective with p2
          have bad := none with i, hi
          exfalso
          apply bad
          rw [← e2, e1, si]
      . obtain ⟨none, p1⟩ := k1
        obtain ⟨e1, f1⟩ := orderedPair.injective with p1
        cases c2 with k2 | k2
        . obtain ⟨j, hj, sj, p2⟩ := k2
          obtain ⟨e2, f2⟩ := orderedPair.injective with p2
          have bad := none with j, hj
          exfalso
          apply bad
          rw [← e1, e2, sj]
        . obtain ⟨none2, p2⟩ := k2
          obtain ⟨e2, f2⟩ := orderedPair.injective with p2
          rw [f1, f2]
    . intros S hS
      by_cases single : ∃ i ∈ I, S = {i}
      . obtain ⟨i, hi, si⟩ := single
        have val := FunctionBetween.apply_closed with vF, hi
        refine ⟨v(i), val, ?_⟩
        unfold relates
        apply exteriorDegreeOne.membership.backward
        have pair := product.pair at S, v(i), 𝒫(I), R.carrier with hS, val
        refine ⟨pair, S, hS, ?_⟩
        left
        exact ⟨i, hi, si, rfl⟩
      . refine ⟨R.zero, zeroIn, ?_⟩
        unfold relates
        apply exteriorDegreeOne.membership.backward
        have pair := product.pair at S, R.zero, 𝒫(I), R.carrier with hS, zeroIn
        refine ⟨pair, S, hS, ?_⟩
        right
        refine ⟨?_, rfl⟩
        intros i hi same
        apply single
        exact ⟨i, hi, same⟩

theorem exteriorDegreeOne.mem (v : Set)
  requires vIn : v ∈ functionSpace(I, R.carrier)
  shows exteriorDegreeOne(R, I, v) ∈ functionSpace(𝒫(I), R.carrier)
proof
  have f := exteriorDegreeOne.function_of at R, I, v with ring, vIn
  exact functionSpace.mem_iff.backward with f

theorem exteriorDegreeOne.at_single (v i : Set)
  requires vIn : v ∈ functionSpace(I, R.carrier)
  requires index : i ∈ I
  shows exteriorDegreeOne(R, I, v)({i}) = v(i)
proof
  have f := exteriorDegreeOne.function_of at R, I, v with ring, vIn
  have vF := functionSpace.mem_iff.forward with vIn
  have val := FunctionBetween.apply_closed with vF, index
  have sub : {i} ⊆ I
    intros z hz
    have zi := singleton.membership.forward with hz
    rw zi
    exact index
  have hS := powerset.membership_iff.backward at {i}, I with sub
  have rel : relates(exteriorDegreeOne(R, I, v), {i}, v(i))
    unfold relates
    apply exteriorDegreeOne.membership.backward
    have pair := product.pair at {i}, v(i), 𝒫(I), R.carrier with hS, val
    refine ⟨pair, {i}, hS, ?_⟩
    left
    exact ⟨i, index, rfl, rfl⟩
  exact FunctionBetween.apply_value with f, hS, rel

theorem exteriorDegreeOne.at_other (v S : Set)
  requires vIn : v ∈ functionSpace(I, R.carrier)
  requires index : S ∈ 𝒫(I)
  requires other : ∀ i ∈ I, S ≠ {i}
  shows exteriorDegreeOne(R, I, v)(S) = R.zero
proof
  have ringR := CommRing.to_ring with ring
  have zeroIn := Ring.zero_mem at R with ringR
  have f := exteriorDegreeOne.function_of at R, I, v with ring, vIn
  have rel : relates(exteriorDegreeOne(R, I, v), S, R.zero)
    unfold relates
    apply exteriorDegreeOne.membership.backward
    have pair := product.pair at S, R.zero, 𝒫(I), R.carrier with index, zeroIn
    refine ⟨pair, S, index, ?_⟩
    right
    exact ⟨other, rfl⟩
  exact FunctionBetween.apply_value with f, index, rel

theorem exteriorIota.apply_of (v : Set)
  requires vIn : v ∈ functionSpace(I, R.carrier)
  shows exteriorIota(R, I)(v) = exteriorDegreeOne(R, I, v)
proof
  have values : ∀ w ∈ functionSpace(I, R.carrier), exteriorDegreeOne(R, I, w) ∈ functionSpace(𝒫(I), R.carrier)
    intros w hw
    exact exteriorDegreeOne.mem at R, I, w with ring, hw
  exact exteriorIota.graph_apply at R, I, v with values, vIn

theorem exteriorIota.linear_of
  shows LinearMap(exteriorIota(R, I), coordinateModule(R, I), R, exteriorModule(R, I))
proof
  have ringR := CommRing.to_ring with ring
  have moduleC := coordinateModule.module at R, I with ringR
  have moduleE := exteriorModule.module_of at R, I with ring
  have cc := coordinateModule.carrier_space at R, I
  have ce := exteriorModule.carrier_eq at R, I
  have values : ∀ w ∈ functionSpace(I, R.carrier), exteriorDegreeOne(R, I, w) ∈ functionSpace(𝒫(I), R.carrier)
    intros w hw
    exact exteriorDegreeOne.mem at R, I, w with ring, hw
  have f0 := exteriorIota.graph_function at R, I with values
  have function : exteriorIota(R, I) : Module.carrier(coordinateModule(R, I)) → Module.carrier(exteriorModule(R, I))
    rw [cc, ce]
    exact f0
  apply LinearMap.of_laws with moduleC, moduleE, function
  . rw cc
    intros u hu w hw
    have huC : u ∈ Module.carrier(coordinateModule(R, I))
      rw cc
      exact hu
    have hwC : w ∈ Module.carrier(coordinateModule(R, I))
      rw cc
      exact hw
    have sumIn0 := Module.add_mem at R, coordinateModule(R, I), u, w with moduleC, huC, hwC
    rw cc at sumIn0
    have a1 := exteriorIota.apply_of at R, I, call2(Module.add(coordinateModule(R, I)), u, w) with ring, sumIn0
    have a2 := exteriorIota.apply_of at R, I, u with ring, hu
    have a3 := exteriorIota.apply_of at R, I, w with ring, hw
    rw [a1, a2, a3]
    have m1 := exteriorDegreeOne.mem at R, I, call2(Module.add(coordinateModule(R, I)), u, w) with ring, sumIn0
    have m2 := exteriorDegreeOne.mem at R, I, u with ring, hu
    have m3 := exteriorDegreeOne.mem at R, I, w with ring, hw
    have m4 := exteriorModule.add_mem at R, I, exteriorDegreeOne(R, I, u), exteriorDegreeOne(R, I, w) with ring, m2, m3
    apply functionSpace.ext_of with m1, m4
    intros S hS
    have v := exteriorModule.add_apply at R, I, exteriorDegreeOne(R, I, u), exteriorDegreeOne(R, I, w), S with ring, m2, m3, hS
    rw v
    by_cases single : ∃ i ∈ I, S = {i}
    . obtain ⟨i, hi, si⟩ := single
      rw si
      have b1 := exteriorDegreeOne.at_single at R, I, call2(Module.add(coordinateModule(R, I)), u, w), i with ring, sumIn0, hi
      have b2 := exteriorDegreeOne.at_single at R, I, u, i with ring, hu, hi
      have b3 := exteriorDegreeOne.at_single at R, I, w, i with ring, hw, hi
      have b4 := coordinateModule.add_at at R, I, u, w, i with ring, hu, hw, hi
      rw [b1, b2, b3, b4]
    . have other : ∀ i ∈ I, S ≠ {i}
        intros i hi same
        apply single
        exact ⟨i, hi, same⟩
      have b1 := exteriorDegreeOne.at_other at R, I, call2(Module.add(coordinateModule(R, I)), u, w), S with ring, sumIn0, hS, other
      have b2 := exteriorDegreeOne.at_other at R, I, u, S with ring, hu, hS, other
      have b3 := exteriorDegreeOne.at_other at R, I, w, S with ring, hw, hS, other
      have zeroIn := Ring.zero_mem at R with ringR
      rw [b1, b2, b3]
      ring
  . rw cc
    intros r hr u hu
    have huC : u ∈ Module.carrier(coordinateModule(R, I))
      rw cc
      exact hu
    have sIn0 := Module.smul_mem at R, coordinateModule(R, I), r, u with moduleC, hr, huC
    rw cc at sIn0
    have a1 := exteriorIota.apply_of at R, I, call2(Module.smul(coordinateModule(R, I)), r, u) with ring, sIn0
    have a2 := exteriorIota.apply_of at R, I, u with ring, hu
    rw [a1, a2]
    have m1 := exteriorDegreeOne.mem at R, I, call2(Module.smul(coordinateModule(R, I)), r, u) with ring, sIn0
    have m2 := exteriorDegreeOne.mem at R, I, u with ring, hu
    have m4 := exteriorModule.smul_mem at R, I, r, exteriorDegreeOne(R, I, u) with ring, hr, m2
    apply functionSpace.ext_of with m1, m4
    intros S hS
    have v := exteriorModule.smul_apply at R, I, r, exteriorDegreeOne(R, I, u), S with ring, hr, m2, hS
    rw v
    by_cases single : ∃ i ∈ I, S = {i}
    . obtain ⟨i, hi, si⟩ := single
      rw si
      have b1 := exteriorDegreeOne.at_single at R, I, call2(Module.smul(coordinateModule(R, I)), r, u), i with ring, sIn0, hi
      have b2 := exteriorDegreeOne.at_single at R, I, u, i with ring, hu, hi
      have b4 := coordinateModule.smul_at at R, I, r, u, i with ring, hr, hu, hi
      rw [b1, b2, b4]
    . have other : ∀ i ∈ I, S ≠ {i}
        intros i hi same
        apply single
        exact ⟨i, hi, same⟩
      have b1 := exteriorDegreeOne.at_other at R, I, call2(Module.smul(coordinateModule(R, I)), r, u), S with ring, sIn0, hS, other
      have b2 := exteriorDegreeOne.at_other at R, I, u, S with ring, hu, hS, other
      rw [b1, b2]
      ring

theorem exteriorIota.unit_vector_of (i : Set)
  requires index : i ∈ I
  shows exteriorIota(R, I)(unitVector(R, I, i)) = exteriorBasisVector(R, I, {i})
proof
  have uIn := unitVector.mem at R, I, i with ring
  have a := exteriorIota.apply_of at R, I, unitVector(R, I, i) with ring, uIn
  rw a
  have m1 := exteriorDegreeOne.mem at R, I, unitVector(R, I, i) with ring, uIn
  have m2 := exteriorBasisVector.mem at R, I, {i} with ring
  apply functionSpace.ext_of with m1, m2
  intros S hS
  have b := exteriorBasisVector.apply at R, I, {i}, S with ring, hS
  by_cases single : ∃ j ∈ I, S = {j}
  . obtain ⟨j, hj, sj⟩ := single
    have d := exteriorDegreeOne.at_single at R, I, unitVector(R, I, i), j with ring, uIn, hj
    rw sj
    rw sj at b
    rw d
    by_cases same : j = i
    . have u1 := unitVector.apply_same at R, I, i with ring, index
      have ss : {j} = {i}
        rw same
      have o := b.left with ss
      rw [o, same, u1]
    . have u0 := unitVector.apply_other at R, I, i, j with ring, hj, same
      have ns : {j} ≠ {i}
        intro ss
        apply same
        exact singleton.injective with ss
      have z := b.right with ns
      rw [u0, z]
  . have other : ∀ j ∈ I, S ≠ {j}
      intros j hj same
      apply single
      exact ⟨j, hj, same⟩
    have d := exteriorDegreeOne.at_other at R, I, unitVector(R, I, i), S with ring, uIn, hS, other
    have ns := other with i, index
    have z := b.right with ns
    rw [d, z]

end ExteriorDegreeOne

-- Section: Squares of degree one
-- The swap (S, T) ↦ (T, S) of a splitting.
def exteriorSplitSwap (I U : Set) : Set :=
  { p ∈ exteriorSplittings(I, U) × exteriorSplittings(I, U) |
    ∃ q ∈ exteriorSplittings(I, U), p = (q, (snd(q), fst(q))) }

theorem exteriorSplitSwap.graph_relates (I U q : Set)
  requires index : q ∈ exteriorSplittings(I, U)
  requires valueIn : (snd(q), fst(q)) ∈ exteriorSplittings(I, U)
  shows relates(exteriorSplitSwap(I, U), q, (snd(q), fst(q)))
proof
  unfold relates
  apply exteriorSplitSwap.membership.backward
  refine ⟨(product.pair at q, (snd(q), fst(q)), exteriorSplittings(I, U), exteriorSplittings(I, U) with index, valueIn), q, index, rfl⟩

theorem exteriorSplitSwap.graph_function (I U : Set)
  requires values : ∀ q ∈ exteriorSplittings(I, U), (snd(q), fst(q)) ∈ exteriorSplittings(I, U)
  shows exteriorSplitSwap(I, U) : exteriorSplittings(I, U) → exteriorSplittings(I, U)
proof
  constructor
    intros q0 member
    obtain ⟨bounded, witnesses⟩ := exteriorSplitSwap.membership.forward with member
    exact bounded
  . constructor
      intros z0 first xFirst second xSecond
      unfold relates at xFirst
      obtain ⟨_, a1, a1In, firstShape⟩ := exteriorSplitSwap.membership.forward with xFirst
      unfold relates at xSecond
      obtain ⟨_, a2, a2In, secondShape⟩ := exteriorSplitSwap.membership.forward with xSecond
      obtain ⟨xi, firstEqual⟩ := orderedPair.injective with firstShape
      obtain ⟨xj, secondEqual⟩ := orderedPair.injective with secondShape
      rw [firstEqual, secondEqual]
      cc
    . intros q xIn
      have valueIn := values with q, xIn
      refine ⟨(snd(q), fst(q)), valueIn, (exteriorSplitSwap.graph_relates at I, U, q with xIn, valueIn)⟩

theorem exteriorSplitSwap.graph_apply (I U q : Set)
  requires values : ∀ q ∈ exteriorSplittings(I, U), (snd(q), fst(q)) ∈ exteriorSplittings(I, U)
  requires index : q ∈ exteriorSplittings(I, U)
  shows exteriorSplitSwap(I, U)(q) = (snd(q), fst(q))
proof
  have function := exteriorSplitSwap.graph_function at I, U with values
  have valueIn := values with q, index
  have mapped := exteriorSplitSwap.graph_relates at I, U, q with index, valueIn
  exact FunctionBetween.apply_value with function, index, mapped

theorem exteriorSplitSwap.values (I U : Set)
  shows ∀ q ∈ exteriorSplittings(I, U), (snd(q), fst(q)) ∈ exteriorSplittings(I, U)
proof
  intros q hq
  obtain ⟨sI, tI, dis, un, _⟩ := exteriorSplittings.parts with hq
  have dis2 : snd(q) ∩ fst(q) = ∅
    rw ← dis
    ext z
    simp
  have un2 : snd(q) ∪ fst(q) = U
    rw ← un
    ext z
    simp
  have p := exteriorSplittings.pair at I, snd(q), fst(q) with tI, sI, dis2
  rw un2 at p
  exact p

theorem exteriorSplitSwap.involution (I U : Set)
  shows InvolutionOn(exteriorSplitSwap(I, U), exteriorSplittings(I, U))
proof
  have values := exteriorSplitSwap.values at I, U
  have f := exteriorSplitSwap.graph_function at I, U with values
  unfold InvolutionOn
  refine ⟨f, ?_⟩
  intros q hq
  have t1 := exteriorSplitSwap.graph_apply at I, U, q with values, hq
  have tq := values with q, hq
  have t2 := exteriorSplitSwap.graph_apply at I, U, (snd(q), fst(q)) with values, tq
  obtain ⟨_, _, _, _, shape⟩ := exteriorSplittings.parts with hq
  rw [t1, t2, fst.pair, snd.pair]
  symm
  exact shape

theorem exteriorNeg.apply (R I x U : Set)
  requires ring : CommRing(R)
  requires xIn : x ∈ functionSpace(𝒫(I), R.carrier)
  requires index : U ∈ 𝒫(I)
  shows functionModuleNeg(R, 𝒫(I), selfModule(R))(x)(U) = -x(U)
proof
  have ringR := CommRing.to_ring with ring
  have self := Ring.to_module at R with ringR
  have selfCarrier := selfModule.carrier_eq at R
  have xS : x ∈ functionSpace(𝒫(I), Module.carrier(selfModule(R)))
    rw selfCarrier
    exact xIn
  have v := functionModuleNeg.value at R, 𝒫(I), selfModule(R), x with self, xS
  have p := pointwiseNeg.at at R, 𝒫(I), selfModule(R), x, U with self, xS, index
  have n : Module.neg(selfModule(R)) = R.neg
    unfold selfModule
    module_projections
  rw [v, p, n]

theorem exteriorNeg.mem (R I x : Set)
  requires ring : CommRing(R)
  requires xIn : x ∈ functionSpace(𝒫(I), R.carrier)
  shows functionModuleNeg(R, 𝒫(I), selfModule(R))(x) ∈ functionSpace(𝒫(I), R.carrier)
proof
  have ringR := CommRing.to_ring with ring
  have self := Ring.to_module at R with ringR
  have selfCarrier := selfModule.carrier_eq at R
  have xS : x ∈ functionSpace(𝒫(I), Module.carrier(selfModule(R)))
    rw selfCarrier
    exact xIn
  have v := functionModuleNeg.value at R, 𝒫(I), selfModule(R), x with self, xS
  have p := pointwiseNeg.space at R, 𝒫(I), selfModule(R), x with self, xS
  rw [v]
  rw selfCarrier at p
  exact p

theorem exteriorSign.singleton_swap (R I lt i j : Set)
  requires ring : CommRing(R)
  requires finite : Finite(I)
  requires order : StrictLinearOrder(I, lt)
  requires first : i ∈ I
  requires second : j ∈ I
  requires distinct : i ≠ j
  shows exteriorSign(R, lt, {j}, {i}) = -exteriorSign(R, lt, {i}, {j})
proof
  have ringR := CommRing.to_ring with ring
  have monoid := IsRing.multiplicative with (Ring.parts with ringR)
  have oneIn := Ring.one_mem at R with ringR
  have negIn := Ring.neg_mem at R, R.one with ringR, oneIn
  have si : {i} ⊆ I
    intros z hz
    have zi := singleton.membership.forward with hz
    rw zi
    exact first
  have sj : {j} ⊆ I
    intros z hz
    have zj := singleton.membership.forward with hz
    rw zj
    exact second
  have dis : {i} ∩ {j} = ∅
    ext z
    constructor
    . intros hz
      simp at hz
      obtain ⟨a, b⟩ := hz
      have za := singleton.membership.forward with a
      have zb := singleton.membership.forward with b
      exfalso
      apply distinct
      rw [← za, ← zb]
    . intros hz
      simp at hz
  have count := exteriorInversions.complement_count at I, lt, {i}, {j} with finite, order, si, sj, dis
  rw [cardinality.singleton, cardinality.singleton] at count
  have c1 := cardinality.nat_total at exteriorInversions(lt, {i}, {j})
  have c2 := cardinality.nat_total at exteriorInversions(lt, {j}, {i})
  have p1 := monoidPow.one at R.carrier, R.mul, R.one, -R.one with monoid, negIn
  unfold exteriorSign
  by_cases ha : cardinality(exteriorInversions(lt, {i}, {j})) = 0
  . have hb : cardinality(exteriorInversions(lt, {j}, {i})) = 1 by arith
    rw [ha, hb, monoidPow.zero, p1]
  . have ha1 : cardinality(exteriorInversions(lt, {i}, {j})) = 1 by arith
    have hb : cardinality(exteriorInversions(lt, {j}, {i})) = 0 by arith
    rw [ha1, hb, monoidPow.zero, p1]
    ring


section ExteriorSquares
variable (R I lt : Set)
hypothesis ring : CommRing(R)
hypothesis finite : Finite(I)
hypothesis order : StrictLinearOrder(I, lt)

theorem exteriorDegreeOne.square_zero (v : Set)
  requires vIn : v ∈ functionSpace(I, R.carrier)
  shows exteriorProduct(R, I, lt, exteriorDegreeOne(R, I, v), exteriorDegreeOne(R, I, v)) = constantFunction(𝒫(I), R.carrier, R.zero)
proof
  have ringR := CommRing.to_ring with ring
  have parts := CommRing.parts with ring
  have aIn := exteriorDegreeOne.mem at R, I, v with ring, vIn
  have aF := functionSpace.mem_iff.forward with aIn
  have left := exteriorProduct.mem at R, I, lt, exteriorDegreeOne(R, I, v), exteriorDegreeOne(R, I, v) with ring, finite, aIn, aIn
  have zIn := exteriorZero.mem at R, I with ring
  apply functionSpace.ext_of with left, zIn
  intros U hU
  have value := exteriorProduct.apply at R, I, lt, exteriorDegreeOne(R, I, v), exteriorDegreeOne(R, I, v), U with ring, finite, aIn, aIn, hU
  have zeroAt := exteriorZero.apply at R, I, U with ring, hU
  rw [value, zeroAt]
  have fin := exteriorSplittings.finite at I, U with finite
  have weights := exteriorProductTerms.weights at R, I, lt, exteriorDegreeOne(R, I, v), exteriorDegreeOne(R, I, v), U with ring, finite, aIn, aIn
  have inv := exteriorSplitSwap.involution at I, U
  have values := exteriorSplitSwap.values at I, U
  have opposite : ∀ q ∈ exteriorSplittings(I, U), exteriorProductTerms(R, I, lt, exteriorDegreeOne(R, I, v), exteriorDegreeOne(R, I, v), U)(exteriorSplitSwap(I, U)(q)) = -exteriorProductTerms(R, I, lt, exteriorDegreeOne(R, I, v), exteriorDegreeOne(R, I, v), U)(q)
    intros q hq
    obtain ⟨qI, q2I, dis, _, _⟩ := exteriorSplittings.parts with hq
    have qP := powerset.membership_iff.backward at fst(q), I with qI
    have q2P := powerset.membership_iff.backward at snd(q), I with q2I
    have tq := values with q, hq
    have s1 := exteriorSplitSwap.graph_apply at I, U, q with values, hq
    have t1 := exteriorProductTerms.value at R, I, lt, exteriorDegreeOne(R, I, v), exteriorDegreeOne(R, I, v), U, q with ring, aIn, aIn, hq
    have t2 := exteriorProductTerms.value at R, I, lt, exteriorDegreeOne(R, I, v), exteriorDegreeOne(R, I, v), U, (snd(q), fst(q)) with ring, aIn, aIn, tq
    rw [s1, t2, t1, fst.pair, snd.pair]
    have g1 := exteriorSign.mem at R, lt, fst(q), snd(q) with ring
    have g2 := exteriorSign.mem at R, lt, snd(q), fst(q) with ring
    have a1 := FunctionBetween.apply_closed with aF, qP
    have a2 := FunctionBetween.apply_closed with aF, q2P
    by_cases h1 : ∃ i ∈ I, fst(q) = {i}
    . by_cases h2 : ∃ j ∈ I, snd(q) = {j}
      . obtain ⟨i, hi, ei⟩ := h1
        obtain ⟨j, hj, ej⟩ := h2
        have ne : i ≠ j
          intro same
          have m1 : i ∈ fst(q)
            rw ei
            exact singleton.self at i
          have m2 : i ∈ snd(q)
            rw [ej, same]
            exact singleton.self at j
          have m := exteriorSet.inter_mem at fst(q), snd(q), i with m1, m2
          rw dis at m
          simp at m
        have sw := exteriorSign.singleton_swap at R, I, lt, i, j with ring, finite, order, hi, hj, ne
        rw [ei, ej, sw]
        have g3 := exteriorSign.mem at R, lt, {i}, {j} with ring
        rw ei at a1
        rw ej at a2
        ring
      . have other : ∀ j ∈ I, snd(q) ≠ {j}
          intros j hj same
          apply h2
          exact ⟨j, hj, same⟩
        have zero := exteriorDegreeOne.at_other at R, I, v, snd(q) with ring, vIn, q2P, other
        rw zero
        ring
    . have other : ∀ i ∈ I, fst(q) ≠ {i}
        intros i hi same
        apply h1
        exact ⟨i, hi, same⟩
      have zero := exteriorDegreeOne.at_other at R, I, v, fst(q) with ring, vIn, qP, other
      rw zero
      ring
  have fixed : ∀ q ∈ exteriorSplittings(I, U), exteriorSplitSwap(I, U)(q) = q → exteriorProductTerms(R, I, lt, exteriorDegreeOne(R, I, v), exteriorDegreeOne(R, I, v), U)(q) = R.zero
    intros q hq same
    obtain ⟨qI, q2I, dis, _, shape⟩ := exteriorSplittings.parts with hq
    have qP := powerset.membership_iff.backward at fst(q), I with qI
    have q2P := powerset.membership_iff.backward at snd(q), I with q2I
    have s1 := exteriorSplitSwap.graph_apply at I, U, q with values, hq
    rw s1 at same
    have pairEq : (snd(q), fst(q)) = (fst(q), snd(q))
      rw same
      exact shape
    obtain ⟨e1, _⟩ := orderedPair.injective with pairEq
    have empty : fst(q) = ∅
      rw e1 at dis
      ext z
      constructor
      . intros hz
        have m := exteriorSet.inter_mem at fst(q), fst(q), z with hz, hz
        rw dis at m
        exact m
      . intros hz
        simp at hz
    have other : ∀ i ∈ I, fst(q) ≠ {i}
      intros i hi eq
      rw empty at eq
      have m : i ∈ {i} := singleton.self at i
      rw ← eq at m
      simp at m
    have zero := exteriorDegreeOne.at_other at R, I, v, fst(q) with ring, vIn, qP, other
    have t1 := exteriorProductTerms.value at R, I, lt, exteriorDegreeOne(R, I, v), exteriorDegreeOne(R, I, v), U, q with ring, aIn, aIn, hq
    have g1 := exteriorSign.mem at R, lt, fst(q), snd(q) with ring
    have a2 := FunctionBetween.apply_closed with aF, q2P
    rw [t1, zero]
    ring
  exact finiteRingSum.involution at exteriorSplittings(I, U), R.carrier, R.add, R.zero, R.neg, R.mul, R.one, exteriorProductTerms(R, I, lt, exteriorDegreeOne(R, I, v), exteriorDegreeOne(R, I, v), U), exteriorSplitSwap(I, U) with parts, weights, fin, inv, opposite, fixed

theorem exteriorDegreeOne.anticommute (u v : Set)
  requires uIn : u ∈ functionSpace(I, R.carrier)
  requires vIn : v ∈ functionSpace(I, R.carrier)
  shows exteriorProduct(R, I, lt, exteriorDegreeOne(R, I, u), exteriorDegreeOne(R, I, v)) = functionModuleNeg(R, 𝒫(I), selfModule(R))(exteriorProduct(R, I, lt, exteriorDegreeOne(R, I, v), exteriorDegreeOne(R, I, u)))
proof
  have ringR := CommRing.to_ring with ring
  have aIn := exteriorDegreeOne.mem at R, I, u with ring, uIn
  have bIn := exteriorDegreeOne.mem at R, I, v with ring, vIn
  have moduleC := coordinateModule.module at R, I with ringR
  have cc := coordinateModule.carrier_space at R, I
  have uC : u ∈ Module.carrier(coordinateModule(R, I))
    rw cc
    exact uIn
  have vC : v ∈ Module.carrier(coordinateModule(R, I))
    rw cc
    exact vIn
  have uv0 := Module.add_mem at R, coordinateModule(R, I), u, v with moduleC, uC, vC
  have uvIn : call2(Module.add(coordinateModule(R, I)), u, v) ∈ functionSpace(I, R.carrier)
    rw ← cc
    exact uv0
  have lin := exteriorIota.linear_of at R, I with ring
  have law := LinearMap.add_law at exteriorIota(R, I), coordinateModule(R, I), R, exteriorModule(R, I), u, v with lin, uC, vC
  have i1 := exteriorIota.apply_of at R, I, call2(Module.add(coordinateModule(R, I)), u, v) with ring, uvIn
  have i2 := exteriorIota.apply_of at R, I, u with ring, uIn
  have i3 := exteriorIota.apply_of at R, I, v with ring, vIn
  rw [i1, i2, i3] at law
  have sq := exteriorDegreeOne.square_zero at R, I, lt, call2(Module.add(coordinateModule(R, I)), u, v) with ring, finite, order, uvIn
  rw law at sq
  have abIn := exteriorModule.add_mem at R, I, exteriorDegreeOne(R, I, u), exteriorDegreeOne(R, I, v) with ring, aIn, bIn
  have e1 := exteriorProduct.add_left at R, I, lt, exteriorDegreeOne(R, I, u), exteriorDegreeOne(R, I, v), call2(Module.add(exteriorModule(R, I)), exteriorDegreeOne(R, I, u), exteriorDegreeOne(R, I, v)) with ring, finite, aIn, bIn, abIn
  have e2 := exteriorProduct.add_right at R, I, lt, exteriorDegreeOne(R, I, u), exteriorDegreeOne(R, I, u), exteriorDegreeOne(R, I, v) with ring, finite, aIn, aIn, bIn
  have e3 := exteriorProduct.add_right at R, I, lt, exteriorDegreeOne(R, I, v), exteriorDegreeOne(R, I, u), exteriorDegreeOne(R, I, v) with ring, finite, bIn, aIn, bIn
  rw [e1, e2, e3] at sq
  have sa := exteriorDegreeOne.square_zero at R, I, lt, u with ring, finite, order, uIn
  have sb := exteriorDegreeOne.square_zero at R, I, lt, v with ring, finite, order, vIn
  rw [sa, sb] at sq
  have zIn := exteriorZero.mem at R, I with ring
  have pab := exteriorProduct.mem at R, I, lt, exteriorDegreeOne(R, I, u), exteriorDegreeOne(R, I, v) with ring, finite, aIn, bIn
  have pba := exteriorProduct.mem at R, I, lt, exteriorDegreeOne(R, I, v), exteriorDegreeOne(R, I, u) with ring, finite, bIn, aIn
  have negIn := exteriorNeg.mem at R, I, exteriorProduct(R, I, lt, exteriorDegreeOne(R, I, v), exteriorDegreeOne(R, I, u)) with ring, pba
  have s1 := exteriorModule.add_mem at R, I, constantFunction(𝒫(I), R.carrier, R.zero), exteriorProduct(R, I, lt, exteriorDegreeOne(R, I, u), exteriorDegreeOne(R, I, v)) with ring, zIn, pab
  have s2 := exteriorModule.add_mem at R, I, exteriorProduct(R, I, lt, exteriorDegreeOne(R, I, v), exteriorDegreeOne(R, I, u)), constantFunction(𝒫(I), R.carrier, R.zero) with ring, pba, zIn
  apply functionSpace.ext_of with pab, negIn
  intros U hU
  have n := exteriorNeg.apply at R, I, exteriorProduct(R, I, lt, exteriorDegreeOne(R, I, v), exteriorDegreeOne(R, I, u)), U with ring, pba, hU
  rw n
  have hU2 : call2(Module.add(exteriorModule(R, I)), call2(Module.add(exteriorModule(R, I)), constantFunction(𝒫(I), R.carrier, R.zero), exteriorProduct(R, I, lt, exteriorDegreeOne(R, I, u), exteriorDegreeOne(R, I, v))), call2(Module.add(exteriorModule(R, I)), exteriorProduct(R, I, lt, exteriorDegreeOne(R, I, v), exteriorDegreeOne(R, I, u)), constantFunction(𝒫(I), R.carrier, R.zero)))(U) = constantFunction(𝒫(I), R.carrier, R.zero)(U)
    rw sq
  have v1 := exteriorModule.add_apply at R, I, call2(Module.add(exteriorModule(R, I)), constantFunction(𝒫(I), R.carrier, R.zero), exteriorProduct(R, I, lt, exteriorDegreeOne(R, I, u), exteriorDegreeOne(R, I, v))), call2(Module.add(exteriorModule(R, I)), exteriorProduct(R, I, lt, exteriorDegreeOne(R, I, v), exteriorDegreeOne(R, I, u)), constantFunction(𝒫(I), R.carrier, R.zero)), U with ring, s1, s2, hU
  have v2 := exteriorModule.add_apply at R, I, constantFunction(𝒫(I), R.carrier, R.zero), exteriorProduct(R, I, lt, exteriorDegreeOne(R, I, u), exteriorDegreeOne(R, I, v)), U with ring, zIn, pab, hU
  have v3 := exteriorModule.add_apply at R, I, exteriorProduct(R, I, lt, exteriorDegreeOne(R, I, v), exteriorDegreeOne(R, I, u)), constantFunction(𝒫(I), R.carrier, R.zero), U with ring, pba, zIn, hU
  have zU := exteriorZero.apply at R, I, U with ring, hU
  rw [v1, v2, v3, zU] at hU2
  have pabF := functionSpace.mem_iff.forward with pab
  have pbaF := functionSpace.mem_iff.forward with pba
  have m1 := FunctionBetween.apply_closed with pabF, hU
  have m2 := FunctionBetween.apply_closed with pbaF, hU
  have zero := Ring.zero_mem at R with ringR
  have fin : exteriorProduct(R, I, lt, exteriorDegreeOne(R, I, u), exteriorDegreeOne(R, I, v))(U) + exteriorProduct(R, I, lt, exteriorDegreeOne(R, I, v), exteriorDegreeOne(R, I, u))(U) = R.zero
    rw ← hU2
    ring
  have target : exteriorProduct(R, I, lt, exteriorDegreeOne(R, I, u), exteriorDegreeOne(R, I, v))(U) = -exteriorProduct(R, I, lt, exteriorDegreeOne(R, I, v), exteriorDegreeOne(R, I, u))(U)
    have neg := Ring.neg_mem at R, exteriorProduct(R, I, lt, exteriorDegreeOne(R, I, v), exteriorDegreeOne(R, I, u))(U) with ringR, m2
    have expand : exteriorProduct(R, I, lt, exteriorDegreeOne(R, I, u), exteriorDegreeOne(R, I, v))(U) = (exteriorProduct(R, I, lt, exteriorDegreeOne(R, I, u), exteriorDegreeOne(R, I, v))(U) + exteriorProduct(R, I, lt, exteriorDegreeOne(R, I, v), exteriorDegreeOne(R, I, u))(U)) + -exteriorProduct(R, I, lt, exteriorDegreeOne(R, I, v), exteriorDegreeOne(R, I, u))(U) by ring
    rw [expand, fin]
    ring
  exact target

end ExteriorSquares


section ExteriorPowers
variable (R I lt : Set)
hypothesis ring : CommRing(R)
hypothesis finite : Finite(I)

theorem exteriorPower.zero_mem (k : Set)
  shows constantFunction(𝒫(I), R.carrier, R.zero) ∈ exteriorPower(R, I, k)
proof
  have zIn := exteriorZero.mem at R, I with ring
  apply exteriorPower.membership.backward
  refine ⟨zIn, ?_⟩
  intros S hS _
  exact exteriorZero.apply at R, I, S with ring, hS

theorem exteriorPower.submodule_of (k : Set)
  shows SubmoduleOf(exteriorPower(R, I, k), exteriorModule(R, I), R)
proof
  have ringR := CommRing.to_ring with ring
  have module := exteriorModule.module_of at R, I with ring
  obtain ⟨c, _, z, _⟩ := exteriorModule.parts at R, I
  unfold SubmoduleOf
  refine ⟨module, ?_, ?_, ?_, ?_⟩
  . intros x hx
    obtain ⟨xIn, _⟩ := exteriorPower.membership.forward with hx
    rw c
    exact xIn
  . rw z
    exact exteriorPower.zero_mem at R, I, lt, k with ring, finite
  . intros v hv w hw
    obtain ⟨vIn, vv⟩ := exteriorPower.membership.forward with hv
    obtain ⟨wIn, wv⟩ := exteriorPower.membership.forward with hw
    have s := exteriorModule.add_mem at R, I, v, w with ring, vIn, wIn
    apply exteriorPower.membership.backward
    refine ⟨s, ?_⟩
    intros S hS nh
    have a := exteriorModule.add_apply at R, I, v, w, S with ring, vIn, wIn, hS
    have z1 := vv with S, hS, nh
    have z2 := wv with S, hS, nh
    have zero := Ring.zero_mem at R with ringR
    rw [a, z1, z2]
    ring
  . intros r hr v hv
    obtain ⟨vIn, vv⟩ := exteriorPower.membership.forward with hv
    have s := exteriorModule.smul_mem at R, I, r, v with ring, hr, vIn
    apply exteriorPower.membership.backward
    refine ⟨s, ?_⟩
    intros S hS nh
    have a := exteriorModule.smul_apply at R, I, r, v, S with ring, hr, vIn, hS
    have z1 := vv with S, hS, nh
    rw [a, z1]
    ring

theorem exteriorPower.top_of (k : Nat)
  requires large : cardinality(I) < k
  shows exteriorPower(R, I, k) = {constantFunction(𝒫(I), R.carrier, R.zero)}
proof
  have zIn := exteriorZero.mem at R, I with ring
  have zW := exteriorPower.zero_mem at R, I, lt, k with ring, finite
  ext x
  constructor
  . intros hx
    obtain ⟨xIn, vanish⟩ := exteriorPower.membership.forward with hx
    have eq : x = constantFunction(𝒫(I), R.carrier, R.zero)
      apply functionSpace.ext_of with xIn, zIn
      intros S hS
      have notCard : ¬HasCardinality(S, k)
        intro has
        have c := cardinality.eq_of_has with has
        have sI := powerset.membership_iff.forward with hS
        have mono := cardinality.monotone at S, I with finite, sI
        have cI := cardinality.nat at I with finite
        rw c at mono
        arith
      have z1 := vanish with S, hS, notCard
      have z2 := exteriorZero.apply at R, I, S with ring, hS
      rw [z1, z2]
    rw eq
    exact singleton.self at constantFunction(𝒫(I), R.carrier, R.zero)
  . intros hx
    have e := singleton.membership.forward with hx
    rw e
    exact zW

theorem exteriorPower.mul_of (j k : Nat) (x y : Set)
  requires first : x ∈ exteriorPower(R, I, j)
  requires second : y ∈ exteriorPower(R, I, k)
  shows exteriorProduct(R, I, lt, x, y) ∈ exteriorPower(R, I, j + k)
proof
  have ringR := CommRing.to_ring with ring
  obtain ⟨xIn, xv⟩ := exteriorPower.membership.forward with first
  obtain ⟨yIn, yv⟩ := exteriorPower.membership.forward with second
  have xF := functionSpace.mem_iff.forward with xIn
  have yF := functionSpace.mem_iff.forward with yIn
  have p := exteriorProduct.mem at R, I, lt, x, y with ring, finite, xIn, yIn
  apply exteriorPower.membership.backward
  refine ⟨p, ?_⟩
  intros U hU notCard
  have value := exteriorProduct.apply at R, I, lt, x, y, U with ring, finite, xIn, yIn, hU
  have fin := exteriorSplittings.finite at I, U with finite
  have weights := exteriorProductTerms.weights at R, I, lt, x, y, U with ring, finite, xIn, yIn
  have uI := powerset.membership_iff.forward with hU
  have fU := Finite.subset at U, I with finite, uI
  have vanish : ∀ q ∈ exteriorSplittings(I, U), exteriorProductTerms(R, I, lt, x, y, U)(q) = R.zero
    intros q hq
    obtain ⟨qI, q2I, dis, un, _⟩ := exteriorSplittings.parts with hq
    have qP := powerset.membership_iff.backward at fst(q), I with qI
    have q2P := powerset.membership_iff.backward at snd(q), I with q2I
    have t := exteriorProductTerms.value at R, I, lt, x, y, U, q with ring, xIn, yIn, hq
    have sg := exteriorSign.mem at R, lt, fst(q), snd(q) with ring
    have xq := FunctionBetween.apply_closed with xF, qP
    have yq := FunctionBetween.apply_closed with yF, q2P
    rw t
    by_cases h1 : HasCardinality(fst(q), j)
    . by_cases h2 : HasCardinality(snd(q), k)
      . exfalso
        apply notCard
        have f1 := Finite.subset at fst(q), I with finite, qI
        have f2 := Finite.subset at snd(q), I with finite, q2I
        have dd : Disjoint(fst(q), snd(q))
          unfold Disjoint
          exact dis
        have cu := cardinality.union_disjoint at fst(q), snd(q) with f1, f2, dd
        have c1 := cardinality.eq_of_has with h1
        have c2 := cardinality.eq_of_has with h2
        rw [un, c1, c2] at cu
        exact HasCardinality.of_cardinality at U, j + k with fU, cu
      . have z := yv with snd(q), q2P, h2
        rw z
        ring
    . have z := xv with fst(q), qP, h1
      rw z
      ring
  rw value
  exact exteriorSum.none at R, exteriorSplittings(I, U), exteriorProductTerms(R, I, lt, x, y, U) with ring, fin, weights, vanish

theorem exteriorPower.one_mem
  shows exteriorBasisVector(R, I, ∅) ∈ exteriorPower(R, I, 0)
proof
  have eIn := exteriorBasisVector.mem at R, I, ∅ with ring
  apply exteriorPower.membership.backward
  refine ⟨eIn, ?_⟩
  intros S hS nh
  have b := exteriorBasisVector.apply at R, I, ∅, S with ring, hS
  have ne : S ≠ ∅
    intro same
    apply nh
    rw same
    exact HasCardinality.empty_set
  exact b.right with ne

theorem exteriorPower.degree_one (v : Set)
  requires vIn : v ∈ functionSpace(I, R.carrier)
  shows exteriorDegreeOne(R, I, v) ∈ exteriorPower(R, I, 1)
proof
  have dIn := exteriorDegreeOne.mem at R, I, v with ring, vIn
  apply exteriorPower.membership.backward
  refine ⟨dIn, ?_⟩
  intros S hS nh
  have other : ∀ i ∈ I, S ≠ {i}
    intros i hi same
    apply nh
    rw same
    have fs := Finite.singleton at i
    have cs := cardinality.singleton at i
    exact HasCardinality.of_cardinality at {i}, 1 with fs, cs
  exact exteriorDegreeOne.at_other at R, I, v, S with ring, vIn, hS, other

theorem exteriorMultiProduct.mem_of (u : Set) (m : Nat)
  requires vectors : ∀ a ∈ m, u(a) ∈ functionSpace(I, R.carrier)
  shows exteriorMultiProduct(R, I, lt, u, m) ∈ exteriorPower(R, I, m)
proof
  induction m with
  | zero =>
    intro vectors
    rw exteriorMultiProduct
    exact exteriorPower.one_mem at R, I, lt with ring, finite
  | succ(j) using ih =>
    intro vectors
    have sub : ∀ a ∈ j, u(a) ∈ functionSpace(I, R.carrier)
      intros a ha
      have a2 := membership.into_successor at a, j with ha
      exact vectors with a, a2
    have prev := ih with sub
    have jIn := membership.self_successor at j
    have uj := vectors with j, jIn
    have d := exteriorPower.degree_one at R, I, lt, u(j) with ring, finite, uj
    have prod := exteriorPower.mul_of at R, I, lt, j, 1, exteriorMultiProduct(R, I, lt, u, j), exteriorDegreeOne(R, I, u(j)) with ring, finite, prev, d
    have e : j + 1 = succ(j) by arith
    rw e at prod
    rw exteriorMultiProduct
    exact prod

end ExteriorPowers

-- Section: Laws
-- Helper for exteriorPower.basis: S ↦ e_S on the k-subsets as a function.
theorem cldA.exteriorPowerBasis_graph (R I k : Set)
  requires ring : CommRing(R)
  shows (exteriorPowerBasis(R, I, k) : subsetsOfSize(I, k) → functionSpace(𝒫(I), R.carrier)) ∧
    (∀ S ∈ subsetsOfSize(I, k), exteriorPowerBasis(R, I, k)(S) = exteriorBasisVector(R, I, S))
proof
  have values : ∀ S ∈ subsetsOfSize(I, k), exteriorBasisVector(R, I, S) ∈ functionSpace(𝒫(I), R.carrier)
    intros S hS
    unfold exteriorBasisVector
    exact unitVector.mem at R, 𝒫(I), S with ring
  have relates0 : ∀ S ∈ subsetsOfSize(I, k), relates(exteriorPowerBasis(R, I, k), S, exteriorBasisVector(R, I, S))
    intros S hS
    unfold relates
    apply exteriorPowerBasis.membership.backward
    refine ⟨(product.pair at S, exteriorBasisVector(R, I, S), subsetsOfSize(I, k), functionSpace(𝒫(I), R.carrier) with hS, (values with S, hS)), S, hS, rfl⟩
  have function : exteriorPowerBasis(R, I, k) : subsetsOfSize(I, k) → functionSpace(𝒫(I), R.carrier)
    constructor
      intros q0 member
      obtain ⟨bounded, _⟩ := exteriorPowerBasis.membership.forward with member
      exact bounded
    . constructor
        intros z0 first xFirst second xSecond
        unfold relates at xFirst
        obtain ⟨_, a1, a1In, firstShape⟩ := exteriorPowerBasis.membership.forward with xFirst
        unfold relates at xSecond
        obtain ⟨_, a2, a2In, secondShape⟩ := exteriorPowerBasis.membership.forward with xSecond
        obtain ⟨xi, firstEqual⟩ := orderedPair.injective with firstShape
        obtain ⟨xj, secondEqual⟩ := orderedPair.injective with secondShape
        rw [firstEqual, secondEqual]
        cc
      . intros S hS
        refine ⟨exteriorBasisVector(R, I, S), (values with S, hS), (relates0 with S, hS)⟩
  refine ⟨function, ?_⟩
  intros S hS
  exact FunctionBetween.apply_value with function, hS, (relates0 with S, hS)

section Exterior
variable (R I lt : Set)
hypothesis ring : CommRing(R)
hypothesis finite : Finite(I)
hypothesis order : StrictLinearOrder(I, lt)

theorem exteriorAlgebra.ring
  shows Ring(exteriorAlgebra(R, I, lt))
proof
  exact exteriorAlgebra.ring_of at R, I, lt with ring, finite

theorem exteriorModule.module
  shows Module(exteriorModule(R, I), R)
proof
  exact exteriorModule.module_of at R, I with ring

-- The additive structure of the ring is that of the module R^𝒫(I).
theorem exteriorAlgebra.additive
  shows Ring.carrier(exteriorAlgebra(R, I, lt)) =
      Module.carrier(exteriorModule(R, I)) ∧
    Ring.add(exteriorAlgebra(R, I, lt)) = Module.add(exteriorModule(R, I))
proof
  obtain ⟨c, a, _, _, _, _⟩ := exteriorAlgebra.projections at R, I, lt
  have c2 := exteriorModule.carrier_eq at R, I
  rw [c, c2, a]
  exact ⟨rfl, rfl⟩

-- The basis {e_S} of ⋀Rᴵ (Basis.ExteriorAlgebra of Pi.basisFun), of rank
-- 2^|I|.
theorem exteriorBasisVector.basis
  shows ModuleBasis(exteriorModule(R, I), R, 𝒫(I),
    standardBasis(R, 𝒫(I)))
proof
  exact exteriorBasis.basis_of at R, I, lt with ring, finite

-- e_S e_T = sign(S, T) e_{S ∪ T} for S ∩ T = ∅, and 0 otherwise
-- (ExteriorAlgebra.basis_mul_of_disjoint).
theorem exteriorBasisVector.mul_disjoint (S T : Set)
  requires first : S ⊆ I
  requires second : T ⊆ I
  requires disjoint : S ∩ T = ∅
  shows call2(Ring.mul(exteriorAlgebra(R, I, lt)),
      exteriorBasisVector(R, I, S), exteriorBasisVector(R, I, T)) =
    call2(Module.smul(exteriorModule(R, I)), exteriorSign(R, lt, S, T),
      exteriorBasisVector(R, I, S ∪ T))
proof
  have sIn := exteriorBasisVector.mem at R, I, S with ring
  have tIn := exteriorBasisVector.mem at R, I, T with ring
  have m := exteriorAlgebra.mul_eq at R, I, lt, exteriorBasisVector(R, I, S), exteriorBasisVector(R, I, T) with ring, finite, sIn, tIn
  rw m
  exact exteriorProduct.basis_disjoint at R, I, lt, S, T with ring, finite, first, second, disjoint

theorem exteriorBasisVector.mul_overlap (S T : Set)
  requires first : S ⊆ I
  requires second : T ⊆ I
  requires overlap : S ∩ T ≠ ∅
  shows call2(Ring.mul(exteriorAlgebra(R, I, lt)),
      exteriorBasisVector(R, I, S), exteriorBasisVector(R, I, T)) =
    Ring.zero(exteriorAlgebra(R, I, lt))
proof
  have sIn := exteriorBasisVector.mem at R, I, S with ring
  have tIn := exteriorBasisVector.mem at R, I, T with ring
  have m := exteriorAlgebra.mul_eq at R, I, lt, exteriorBasisVector(R, I, S), exteriorBasisVector(R, I, T) with ring, finite, sIn, tIn
  obtain ⟨_, _, z, _, _, _⟩ := exteriorAlgebra.projections at R, I, lt
  rw [m, z]
  exact exteriorProduct.basis_overlap at R, I, lt, S, T with ring, finite, first, second, overlap

theorem exteriorSign.swap (S T : Set)
  requires first : S ⊆ I
  requires second : T ⊆ I
  requires disjoint : S ∩ T = ∅
  shows call2(R.mul, exteriorSign(R, lt, S, T), exteriorSign(R, lt, T, S)) =
    monoidPow(R.mul, R.one, -R.one, cardinality(S) * cardinality(T))
proof
  have ringR := CommRing.to_ring with ring
  have monoid := IsRing.multiplicative with (Ring.parts with ringR)
  have oneIn := Ring.one_mem at R with ringR
  have negIn := Ring.neg_mem at R, R.one with ringR, oneIn
  have count := exteriorInversions.complement_count at I, lt, S, T with finite, order, first, second, disjoint
  have c1 := cardinality.nat_total at exteriorInversions(lt, S, T)
  have c2 := cardinality.nat_total at exteriorInversions(lt, T, S)
  have split := monoidPow.add at R.carrier, R.mul, R.one, -R.one, cardinality(exteriorInversions(lt, S, T)), cardinality(exteriorInversions(lt, T, S)) with monoid, negIn
  unfold exteriorSign
  rw [← count, split]

-- The scalars are central and form a copy of R (algebraMap).
theorem exteriorScalar.central_hom
  shows CentralRingHom(exteriorScalar(R, I), R, exteriorAlgebra(R, I, lt))
proof
  exact exteriorScalar.central_of at R, I, lt with ring, finite

-- The action of R is multiplication by scalars.
theorem exteriorScalar.smul (r x : Set)
  requires scalar : r ∈ R.carrier
  requires member : x ∈ functionSpace(𝒫(I), R.carrier)
  shows call2(Ring.mul(exteriorAlgebra(R, I, lt)), exteriorScalar(R, I)(r), x) =
    call2(Module.smul(exteriorModule(R, I)), r, x)
proof
  have eIn := exteriorBasisVector.mem at R, I, ∅ with ring
  have m := exteriorModule.smul_mem at R, I, r, exteriorBasisVector(R, I, ∅) with ring, scalar, eIn
  have a1 := exteriorScalar.apply_of at R, I, lt, r with ring, finite, scalar
  have me := exteriorAlgebra.mul_eq at R, I, lt, call2(Module.smul(exteriorModule(R, I)), r, exteriorBasisVector(R, I, ∅)), x with ring, finite, m, member
  rw [a1, me]
  exact exteriorScalar.mul_left at R, I, lt, r, x with ring, finite, scalar, member

-- ExteriorAlgebra.algebraMapInv is a ring map, left inverse to the
-- scalars.
theorem exteriorDegreeZero.hom
  shows RingHom(exteriorDegreeZero(R, I), exteriorAlgebra(R, I, lt), R)
proof
  exact exteriorDegreeZero.hom_of at R, I, lt with ring, finite

theorem exteriorDegreeZero.scalar (r : R)
  shows exteriorDegreeZero(R, I)(exteriorScalar(R, I)(r)) = r
proof
  exact exteriorDegreeZero.scalar_of at R, I, lt, r with ring, finite, *

theorem exteriorIota.linear
  shows LinearMap(exteriorIota(R, I), coordinateModule(R, I), R,
    exteriorModule(R, I))
proof
  exact exteriorIota.linear_of at R, I with ring

theorem exteriorIota.unit_vector (i : Set)
  requires index : i ∈ I
  shows exteriorIota(R, I)(unitVector(R, I, i)) = exteriorBasisVector(R, I, {i})
proof
  exact exteriorIota.unit_vector_of at R, I, i with ring, index

-- ExteriorAlgebra.ι_sq_zero and ι_add_mul_swap: ι(v)² = 0 and
-- ι(u) ι(v) = −ι(v) ι(u).
theorem exteriorIota.square_zero (v : Set)
  requires vector : v ∈ functionSpace(I, R.carrier)
  shows call2(Ring.mul(exteriorAlgebra(R, I, lt)), exteriorIota(R, I)(v),
    exteriorIota(R, I)(v)) = Ring.zero(exteriorAlgebra(R, I, lt))
proof
  have a := exteriorIota.apply_of at R, I, v with ring, vector
  have dIn := exteriorDegreeOne.mem at R, I, v with ring, vector
  have m := exteriorAlgebra.mul_eq at R, I, lt, exteriorDegreeOne(R, I, v), exteriorDegreeOne(R, I, v) with ring, finite, dIn, dIn
  obtain ⟨_, _, z, _, _, _⟩ := exteriorAlgebra.projections at R, I, lt
  rw [a, m, z]
  exact exteriorDegreeOne.square_zero at R, I, lt, v with ring, finite, order, vector

theorem exteriorIota.anticommute (u v : Set)
  requires first : u ∈ functionSpace(I, R.carrier)
  requires second : v ∈ functionSpace(I, R.carrier)
  shows call2(Ring.mul(exteriorAlgebra(R, I, lt)), exteriorIota(R, I)(u),
      exteriorIota(R, I)(v)) =
    apply(Ring.neg(exteriorAlgebra(R, I, lt)),
      call2(Ring.mul(exteriorAlgebra(R, I, lt)), exteriorIota(R, I)(v),
        exteriorIota(R, I)(u)))
proof
  have a1 := exteriorIota.apply_of at R, I, u with ring, first
  have a2 := exteriorIota.apply_of at R, I, v with ring, second
  have d1 := exteriorDegreeOne.mem at R, I, u with ring, first
  have d2 := exteriorDegreeOne.mem at R, I, v with ring, second
  have m1 := exteriorAlgebra.mul_eq at R, I, lt, exteriorDegreeOne(R, I, u), exteriorDegreeOne(R, I, v) with ring, finite, d1, d2
  have m2 := exteriorAlgebra.mul_eq at R, I, lt, exteriorDegreeOne(R, I, v), exteriorDegreeOne(R, I, u) with ring, finite, d2, d1
  obtain ⟨_, _, _, n, _, _⟩ := exteriorAlgebra.projections at R, I, lt
  rw [a1, a2, m1, m2, n]
  exact exteriorDegreeOne.anticommute at R, I, lt, u, v with ring, finite, order, first, second

-- The products of the ι(e_i) in increasing order are the basis vectors.
theorem exteriorMultiProduct.basis_vector (k : Nat) (u S : Set)
  requires subset : S ⊆ I
  requires increasing : BijectiveBetween(u, k, S) ∧
    (∀ a ∈ k, ∀ b ∈ k, a < b → (u(a), u(b)) ∈ lt)
  shows exteriorMultiProduct(R, I, lt, compose(standardBasis(R, I), u, k, I,
      functionSpace(I, R.carrier)), k) = exteriorBasisVector(R, I, S)
proof
  sorry

-- ιMulti is alternating: it vanishes when two vectors agree.
theorem exteriorMultiProduct.alternating (k : Nat) (u a b : Set)
  requires vectors : u : k → functionSpace(I, R.carrier)
  requires first : a ∈ k
  requires second : b ∈ k
  requires distinct : a ≠ b
  requires same : u(a) = u(b)
  shows exteriorMultiProduct(R, I, lt, u, k) = Ring.zero(exteriorAlgebra(R, I, lt))
proof
  sorry

theorem exteriorMultiProduct.mem_power (k : Nat) (u : Set)
  requires vectors : u : k → functionSpace(I, R.carrier)
  shows exteriorMultiProduct(R, I, lt, u, k) ∈ exteriorPower(R, I, k)
proof
  have values : ∀ a ∈ k, u(a) ∈ functionSpace(I, R.carrier)
    intros a ha
    exact FunctionBetween.apply_closed with vectors, ha
  exact exteriorMultiProduct.mem_of at R, I, lt, u, k with ring, finite, values

theorem exteriorPower.submodule (k : Nat)
  shows SubmoduleOf(exteriorPower(R, I, k), exteriorModule(R, I), R)
proof
  exact exteriorPower.submodule_of at R, I, lt, k with ring, finite

-- ⋀ᵏ Rᴵ has the basis e_S, |S| = k, so rank (|I| choose k)
-- (Basis.exteriorPower).
theorem exteriorPower.basis (k : Nat)
  shows ModuleBasis(submoduleModule(exteriorModule(R, I), R,
    exteriorPower(R, I, k)), R, subsetsOfSize(I, k), exteriorPowerBasis(R, I, k))
proof
  have ringR := CommRing.to_ring with ring
  have module := exteriorModule.module_of at R, I with ring
  obtain ⟨cE, _, zE, _⟩ := exteriorModule.parts at R, I
  have sub := exteriorPower.submodule_of at R, I, lt, k with ring, finite
  have moduleW := SubmoduleOf.submodule_module at R, exteriorModule(R, I), exteriorPower(R, I, k) with ringR, module, sub
  have cW := submoduleModule.carrier_eq at exteriorModule(R, I), R, exteriorPower(R, I, k)
  have JP : subsetsOfSize(I, k) ⊆ 𝒫(I)
    intros S hS
    obtain ⟨SP, _⟩ := subsetsOfSize.membership.forward with hS
    exact SP
  have finiteJ := Finite.subset with (Finite.powerset with finite), JP
  obtain ⟨bF, bV⟩ := cldA.exteriorPowerBasis_graph at R, I, k with ring
  have bInW : ∀ S ∈ subsetsOfSize(I, k), exteriorPowerBasis(R, I, k)(S) ∈ exteriorPower(R, I, k)
    intros S hS
    obtain ⟨_, cardS⟩ := subsetsOfSize.membership.forward with hS
    rw (bV with S, hS)
    apply exteriorPower.membership.backward
    refine ⟨(exteriorBasisVector.mem at R, I, S with ring), ?_⟩
    intros U hU notCard
    have other : U ≠ S
      intro same
      rw same at notCard
      exact notCard with cardS
    obtain ⟨_, zero⟩ := exteriorBasisVector.apply at R, I, S, U with ring, hU
    exact zero with other
  have bW := FunctionBetween.codomain_of_values with bF, bInW
  have bWm : exteriorPowerBasis(R, I, k) : subsetsOfSize(I, k) → Module.carrier(submoduleModule(exteriorModule(R, I), R, exteriorPower(R, I, k)))
    rw cW
    exact bW
  have bE : exteriorPowerBasis(R, I, k) : subsetsOfSize(I, k) → Module.carrier(exteriorModule(R, I))
    rw cE
    exact bF
  have unitValues : ∀ S ∈ 𝒫(I), unitVector(R, 𝒫(I), S) ∈ functionSpace(𝒫(I), Ring.carrier(R))
    intros S hS
    exact unitVector.mem at R, 𝒫(I), S with ring
  have stdF := standardBasis.graph_function at R, 𝒫(I) with unitValues
  have rstd := restrict.domain_function at standardBasis(R, 𝒫(I)), 𝒫(I), functionSpace(𝒫(I), Ring.carrier(R)), subsetsOfSize(I, k) with stdF, JP
  have bStd : exteriorPowerBasis(R, I, k) = restrict(standardBasis(R, 𝒫(I)), subsetsOfSize(I, k))
    apply FunctionBetween.ext with bF, rstd
    intros S hS
    have r1 := restrict.domain_apply at standardBasis(R, 𝒫(I)), 𝒫(I), functionSpace(𝒫(I), Ring.carrier(R)), subsetsOfSize(I, k), S with stdF, JP, hS
    have r2 := standardBasis.graph_apply at R, 𝒫(I), S with unitValues, (JP with S, hS)
    rw [(bV with S, hS), r1, r2]
    unfold exteriorBasisVector
    rfl
  have independent : LinearIndependent(submoduleModule(exteriorModule(R, I), R, exteriorPower(R, I, k)), R, subsetsOfSize(I, k), exteriorPowerBasis(R, I, k))
    have lawW := LinearIndependent.finite_iff at R, submoduleModule(exteriorModule(R, I), R, exteriorPower(R, I, k)), subsetsOfSize(I, k), exteriorPowerBasis(R, I, k) with ring, moduleW, finiteJ, bWm
    apply lawW.backward
    intros c cF zero
    have same := submoduleModule.combination_eq at R, exteriorModule(R, I), exteriorPower(R, I, k), subsetsOfSize(I, k), c, exteriorPowerBasis(R, I, k) with ring, module, sub, finiteJ, cF, bW
    have z := submoduleModule.zero_eq at exteriorModule(R, I), R, exteriorPower(R, I, k)
    rw [same, z, zE, bStd] at zero
    intros S hS
    obtain ⟨atS, _⟩ := standardBasis.combination_at at R, 𝒫(I), subsetsOfSize(I, k), c, S with ring, JP, finiteJ, cF, (JP with S, hS)
    have v := atS with hS
    unfold exteriorModule at zero
    rw zero at v
    have zeroIn := Ring.zero_mem at R with ringR
    have k0 := constantFunction.apply at 𝒫(I), R.carrier, S, R.zero with (JP with S, hS), zeroIn
    rw k0 at v
    symm
    exact v
  have range := moduleSpan.range_family at R, submoduleModule(exteriorModule(R, I), R, exteriorPower(R, I, k)), subsetsOfSize(I, k), exteriorPowerBasis(R, I, k) with ringR, moduleW, finiteJ, bWm
  have spans : SpansModule(submoduleModule(exteriorModule(R, I), R, exteriorPower(R, I, k)), R, subsetsOfSize(I, k), exteriorPowerBasis(R, I, k))
    refine ⟨moduleW, bWm, ?_⟩
    rw range
    ext x
    constructor
    . intro hx
      obtain ⟨xIn, _⟩ := familyCombinations.membership.forward with hx
      exact xIn
    . intro hx
      have hx0 := hx
      rw cW at hx0
      obtain ⟨xSpace, xVanish⟩ := exteriorPower.membership.forward with hx0
      have xF := functionSpace.mem_iff.forward with xSpace
      have cF := restrict.domain_function at x, 𝒫(I), R.carrier, subsetsOfSize(I, k) with xF, JP
      have same := submoduleModule.combination_eq at R, exteriorModule(R, I), exteriorPower(R, I, k), subsetsOfSize(I, k), restrict(x, subsetsOfSize(I, k)), exteriorPowerBasis(R, I, k) with ring, module, sub, finiteJ, cF, bW
      have combIn := moduleCombination.mem_of at R, exteriorModule(R, I), subsetsOfSize(I, k), restrict(x, subsetsOfSize(I, k)), exteriorPowerBasis(R, I, k) with ringR, module, finiteJ, cF, bE
      rw cE at combIn
      have combF := functionSpace.mem_iff.forward with combIn
      apply familyCombinations.membership.backward
      refine ⟨hx, restrict(x, subsetsOfSize(I, k)), cF, ?_⟩
      rw [same, bStd]
      rw bStd at combF
      unfold exteriorModule
      unfold exteriorModule at combF
      apply FunctionBetween.ext with xF, combF
      intros y hy
      obtain ⟨inside, outside⟩ := standardBasis.combination_at at R, 𝒫(I), subsetsOfSize(I, k), restrict(x, subsetsOfSize(I, k)), y with ring, JP, finiteJ, cF, hy
      by_cases yJ : y ∈ subsetsOfSize(I, k)
      . have v := inside with yJ
        have r := restrict.domain_apply at x, 𝒫(I), R.carrier, subsetsOfSize(I, k), y with xF, JP, yJ
        rw [v, r]
      . have v := outside with yJ
        have notCard : ¬HasCardinality(y, k)
          intro card
          apply yJ
          apply subsetsOfSize.membership.backward
          exact ⟨hy, card⟩
        have zero := xVanish with y, hy, notCard
        rw [v, zero]
  exact ⟨independent, spans⟩

theorem exteriorPower.mul (j k : Nat) (x y : Set)
  requires first : x ∈ exteriorPower(R, I, j)
  requires second : y ∈ exteriorPower(R, I, k)
  shows call2(Ring.mul(exteriorAlgebra(R, I, lt)), x, y) ∈
    exteriorPower(R, I, j + k)
proof
  obtain ⟨xIn, _⟩ := exteriorPower.membership.forward with first
  obtain ⟨yIn, _⟩ := exteriorPower.membership.forward with second
  have m := exteriorAlgebra.mul_eq at R, I, lt, x, y with ring, finite, xIn, yIn
  rw m
  exact exteriorPower.mul_of at R, I, lt, j, k, x, y with ring, finite, first, second

-- Every element is the sum of its homogeneous parts: ⋀Rᴵ is the direct
-- sum of the ⋀ᵏ, k ≤ |I|.
theorem exteriorPower.top (k : Nat)
  requires large : cardinality(I) < k
  shows exteriorPower(R, I, k) = {Ring.zero(exteriorAlgebra(R, I, lt))}
proof
  obtain ⟨_, _, z, _, _, _⟩ := exteriorAlgebra.projections at R, I, lt
  rw z
  exact exteriorPower.top_of at R, I, lt, k with ring, finite, large

-- ExteriorAlgebra.lift: the universal property.
theorem exteriorLift.hom (A φ f : Set)
  requires data : ExteriorData(R, I, A, φ, f)
  shows RingHom(exteriorLift(R, I, lt, A, φ, f), exteriorAlgebra(R, I, lt), A)
proof
  sorry

theorem exteriorLift.iota (A φ f v : Set)
  requires data : ExteriorData(R, I, A, φ, f)
  requires vector : v ∈ functionSpace(I, R.carrier)
  shows exteriorLift(R, I, lt, A, φ, f)(exteriorIota(R, I)(v)) = f(v)
proof
  sorry

theorem exteriorLift.scalar (A φ f r : Set)
  requires data : ExteriorData(R, I, A, φ, f)
  requires scalar : r ∈ R.carrier
  shows exteriorLift(R, I, lt, A, φ, f)(exteriorScalar(R, I)(r)) = φ(r)
proof
  sorry

theorem exteriorLift.eq_of_agree (A φ f F : Set)
  requires data : ExteriorData(R, I, A, φ, f)
  requires hom : RingHom(F, exteriorAlgebra(R, I, lt), A)
  requires onIota : ∀ v ∈ functionSpace(I, R.carrier),
    F(exteriorIota(R, I)(v)) = f(v)
  requires onScalars : ∀ r ∈ R.carrier, F(exteriorScalar(R, I)(r)) = φ(r)
  shows F = exteriorLift(R, I, lt, A, φ, f)
proof
  sorry

-- ExteriorAlgebra.map: a linear map g gives a ring map on exterior
-- algebras with ι(v) ↦ ι(g(v)), functorially.
theorem exteriorMap.hom (J lt2 g : Set)
  requires finiteJ : Finite(J)
  requires orderJ : StrictLinearOrder(J, lt2)
  requires linear : LinearMap(g, coordinateModule(R, I), R, coordinateModule(R, J))
  shows RingHom(exteriorMap(R, I, lt, J, lt2, g), exteriorAlgebra(R, I, lt),
    exteriorAlgebra(R, J, lt2))
proof
  sorry

theorem exteriorMap.iota (J lt2 g v : Set)
  requires finiteJ : Finite(J)
  requires orderJ : StrictLinearOrder(J, lt2)
  requires linear : LinearMap(g, coordinateModule(R, I), R, coordinateModule(R, J))
  requires vector : v ∈ functionSpace(I, R.carrier)
  shows exteriorMap(R, I, lt, J, lt2, g)(exteriorIota(R, I)(v)) =
    exteriorIota(R, J)(g(v))
proof
  sorry

theorem exteriorMap.multi_product (J lt2 g : Set) (k : Nat) (u : Set)
  requires finiteJ : Finite(J)
  requires orderJ : StrictLinearOrder(J, lt2)
  requires linear : LinearMap(g, coordinateModule(R, I), R, coordinateModule(R, J))
  requires vectors : u : k → functionSpace(I, R.carrier)
  shows exteriorMap(R, I, lt, J, lt2, g)(exteriorMultiProduct(R, I, lt, u, k)) =
    exteriorMultiProduct(R, J, lt2, compose(g, u, k, functionSpace(I, R.carrier),
      functionSpace(J, R.carrier)), k)
proof
  sorry

theorem exteriorMap.degree (J lt2 g x : Set) (k : Nat)
  requires finiteJ : Finite(J)
  requires orderJ : StrictLinearOrder(J, lt2)
  requires linear : LinearMap(g, coordinateModule(R, I), R, coordinateModule(R, J))
  requires member : x ∈ exteriorPower(R, I, k)
  shows exteriorMap(R, I, lt, J, lt2, g)(x) ∈ exteriorPower(R, J, k)
proof
  sorry

theorem exteriorMap.identity
  shows exteriorMap(R, I, lt, I, lt, identity(functionSpace(I, R.carrier))) =
    identity(functionSpace(𝒫(I), R.carrier))
proof
  sorry

-- The contraction ι_c is linear, lowers degree by one, and is a graded
-- derivation: ι_c(ι(v) x) = c(v) x − ι(v) ι_c(x)
-- (contractLeft_ι_mul), with ι_c ∘ ι_c = 0.
theorem exteriorContraction.linear (c : Set)
  requires form : c ∈ functionSpace(I, R.carrier)
  shows LinearMap(exteriorContraction(R, I, lt, c), exteriorModule(R, I), R,
    exteriorModule(R, I))
proof
  sorry

theorem exteriorContraction.iota_mul (c v x : Set)
  requires form : c ∈ functionSpace(I, R.carrier)
  requires vector : v ∈ functionSpace(I, R.carrier)
  requires member : x ∈ functionSpace(𝒫(I), R.carrier)
  shows exteriorContraction(R, I, lt, c)(call2(Ring.mul(exteriorAlgebra(R, I, lt)),
      exteriorIota(R, I)(v), x)) =
    call2(Ring.add(exteriorAlgebra(R, I, lt)),
      call2(Module.smul(exteriorModule(R, I)),
        finiteRingSum(I, R.carrier, R.add, R.zero, R.neg, R.mul, R.one,
          combinationTerms(selfModule(R), R, I, c, v)), x),
      apply(Ring.neg(exteriorAlgebra(R, I, lt)),
        call2(Ring.mul(exteriorAlgebra(R, I, lt)), exteriorIota(R, I)(v),
          exteriorContraction(R, I, lt, c)(x))))
proof
  sorry

theorem exteriorContraction.one (c : Set)
  requires form : c ∈ functionSpace(I, R.carrier)
  shows exteriorContraction(R, I, lt, c)(exteriorBasisVector(R, I, ∅)) =
    Ring.zero(exteriorAlgebra(R, I, lt))
proof
  sorry

theorem exteriorContraction.square_zero (c x : Set)
  requires form : c ∈ functionSpace(I, R.carrier)
  requires member : x ∈ functionSpace(𝒫(I), R.carrier)
  shows exteriorContraction(R, I, lt, c)(exteriorContraction(R, I, lt, c)(x)) =
    Ring.zero(exteriorAlgebra(R, I, lt))
proof
  sorry

theorem exteriorContraction.degree (c x : Set) (k : Nat)
  requires form : c ∈ functionSpace(I, R.carrier)
  requires member : x ∈ exteriorPower(R, I, succ(k))
  shows exteriorContraction(R, I, lt, c)(x) ∈ exteriorPower(R, I, k)
proof
  sorry

end Exterior
