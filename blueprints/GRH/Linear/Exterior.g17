  have b := exteriorModule.smul_apply at R, I, r, exteriorProduct(R, I, lt, x, y), U with ring, scalar, p1, hU
  have c1 := exteriorProduct.apply at R, I, lt, x, y, U with ring, finite, xIn, yIn, hU
