    have m1 := FunctionBetween.apply_closed with xF, qP
    have m2 := FunctionBetween.apply_closed with x2F, qP
    have m3 := FunctionBetween.apply_closed with yF, q2P
    rw [t3, t1, t2, s]
    ring
  have lin := finiteRingSum.linear at exteriorSplittings(I, U), R.carrier, R.add, R.zero, R.neg, R.mul, R.one, exteriorProductTerms(R, I, lt, x, y, U), exteriorProductTerms(R, I, lt, x2, y, U), exteriorProductTerms(R, I, lt, call2(Module.add(exteriorModule(R, I)), x, x2), y, U), R.one, R.one with parts, fin, w1, w2, w3, oneIn, oneIn, entries
  have v1 := exteriorProduct.value_mem at R, I, lt, x, y, U with ring, finite, xIn, yIn
  have v2 := exteriorProduct.value_mem at R, I, lt, x2, y, U with ring, finite, x2In, yIn
  rw lin
  ring

theorem exteriorProduct.add_right (x y y2 : Set)
  requires xIn : x ∈ functionSpace(𝒫(I), R.carrier)
  requires yIn : y ∈ functionSpace(𝒫(I), R.carrier)
  requires y2In : y2 ∈ functionSpace(𝒫(I), R.carrier)
  shows exteriorProduct(R, I, lt, x, call2(Module.add(exteriorModule(R, I)), y, y2)) = call2(Module.add(exteriorModule(R, I)), exteriorProduct(R, I, lt, x, y), exteriorProduct(R, I, lt, x, y2))
