    have qP := powerset.membership_iff.backward at fst(q), I with qI
    have q2P := powerset.membership_iff.backward at snd(q), I with q2I
    have t3 := exteriorProductTerms.value at R, I, lt, x, call2(Module.add(exteriorModule(R, I)), y, y2), U, q with ring, xIn, sumIn, hq
    have t1 := exteriorProductTerms.value at R, I, lt, x, y, U, q with ring, xIn, yIn, hq
    have t2 := exteriorProductTerms.value at R, I, lt, x, y2, U, q with ring, xIn, y2In, hq
    have s := exteriorModule.add_apply at R, I, y, y2, snd(q) with ring, yIn, y2In, q2P
    have sg := exteriorSign.mem at R, lt, fst(q), snd(q) with ring
    have m1 := FunctionBetween.apply_closed with xF, qP
    have m2 := FunctionBetween.apply_closed with yF, q2P
    have m3 := FunctionBetween.apply_closed with y2F, q2P
    rw [t3, t1, t2, s]
    ring
  have lin := finiteRingSum.linear at exteriorSplittings(I, U), R.carrier, R.add, R.zero, R.neg, R.mul, R.one, exteriorProductTerms(R, I, lt, x, y, U), exteriorProductTerms(R, I, lt, x, y2, U), exteriorProductTerms(R, I, lt, x, call2(Module.add(exteriorModule(R, I)), y, y2), U), R.one, R.one with parts, fin, w1, w2, w3, oneIn, oneIn, entries
  have v1 := exteriorProduct.value_mem at R, I, lt, x, y, U with ring, finite, xIn, yIn
  have v2 := exteriorProduct.value_mem at R, I, lt, x, y2, U with ring, finite, xIn, y2In
  rw lin
  ring

theorem exteriorProduct.smul_left (r x y : Set)
  requires scalar : r ∈ R.carrier
  requires xIn : x ∈ functionSpace(𝒫(I), R.carrier)
  requires yIn : y ∈ functionSpace(𝒫(I), R.carrier)
  shows exteriorProduct(R, I, lt, call2(Module.smul(exteriorModule(R, I)), r, x), y) = call2(Module.smul(exteriorModule(R, I)), r, exteriorProduct(R, I, lt, x, y))
