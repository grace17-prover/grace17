-- The exterior algebra of the finite free module Rᴵ over a commutative
-- ring, I finite and linearly ordered, by its basis e_S indexed by the
-- subsets S ⊆ I: e_S e_T = ±e_{S ∪ T} when S and T are disjoint and 0
-- otherwise, the sign counting the pairs out of order. The inclusion ι
-- of Rᴵ in degree one with ι(v)² = 0, the products ι(v₁)⋯ι(v_k)
-- (ExteriorAlgebra.ιMulti), the exterior powers ⋀ᵏ Rᴵ with their bases
-- of k-subsets, the projection to degree zero (algebraMapInv), the
-- universal property (ExteriorAlgebra.lift), functoriality
-- (ExteriorAlgebra.map), and contraction with a linear form
-- (contractLeft). The proof uses exterior algebras only of free modules
-- of finite rank, in the Hodge and Hodge–Tate cohomology of the
-- universe region.
-- Part of the GRH blueprint.
-- Planned home: Algebra/Module/Exterior.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Linear.Exterior
import GRH.Linear.Dimension
import Grace.Cumulus.Cardinal.Combinations
import Grace.Cumulus.Set.Order

-- Section: The sign of a pair of subsets
-- The pairs (s, t) ∈ S × T out of order (t < s), and the sign
-- (−1)^#{such pairs} ∈ R: e_S e_T = sign(S, T) e_{S ∪ T} for S ∩ T = ∅.
def exteriorInversions (lt S T : Set) : Set :=
  { p ∈ S × T | ∃ s ∈ S, ∃ t ∈ T, p = (s, t) ∧ (t, s) ∈ lt }

def exteriorSign (R lt S T : Set) : Set :=
  monoidPow(Ring.mul(R), Ring.one(R), apply(Ring.neg(R), Ring.one(R)),
    cardinality(exteriorInversions(lt, S, T)))

-- The ways of writing U as a disjoint union S ∪ T.
def exteriorSplittings (I U : Set) : Set :=
  { q ∈ 𝒫(I) × 𝒫(I) | ∃ S ∈ 𝒫(I), ∃ T ∈ 𝒫(I),
    q = (S, T) ∧ S ∩ T = ∅ ∧ S ∪ T = U }

-- Section: Helpers for signs and splittings
theorem exteriorInversions.subset (lt S T : Set)
  shows exteriorInversions(lt, S, T) ⊆ S × T
proof
  intros p hp
  obtain ⟨pIn, _⟩ := exteriorInversions.membership.forward with hp
  exact pIn

theorem exteriorInversions.finite (lt S T : Set)
  requires first : Finite(S)
  requires second : Finite(T)
  shows Finite(exteriorInversions(lt, S, T))
proof
  have product := Finite.product at S, T with first, second
  have sub := exteriorInversions.subset at lt, S, T
  exact Finite.subset with product, sub

theorem exteriorSplittings.subset (I U : Set)
  shows exteriorSplittings(I, U) ⊆ 𝒫(I) × 𝒫(I)
proof
  intros p hp
  obtain ⟨pIn, _⟩ := exteriorSplittings.membership.forward with hp
  exact pIn

theorem exteriorSplittings.finite (I U : Set)
  requires finite : Finite(I)
  shows Finite(exteriorSplittings(I, U))
proof
  have power := Finite.powerset at I with finite
  have product := Finite.product at 𝒫(I), 𝒫(I) with power, power
  have sub := exteriorSplittings.subset at I, U
  exact Finite.subset with product, sub

theorem exteriorSplittings.parts (I U q : Set)
  requires member : q ∈ exteriorSplittings(I, U)
  shows fst(q) ⊆ I ∧ snd(q) ⊆ I ∧ fst(q) ∩ snd(q) = ∅ ∧ fst(q) ∪ snd(q) = U ∧
    q = (fst(q), snd(q))
proof
  obtain ⟨_, S, hS, T, hT, shape, disjoint, union⟩ := exteriorSplittings.membership.forward with member
  have e1 : fst(q) = S
    rw shape
    exact fst.pair at S, T
  have e2 : snd(q) = T
    rw shape
    exact snd.pair at S, T
  have sI := powerset.membership_iff.forward with hS
  have tI := powerset.membership_iff.forward with hT
  rw [e1, e2]
  exact ⟨sI, tI, disjoint, union, shape⟩

theorem exteriorSplittings.pair (I S T : Set)
  requires first : S ⊆ I
  requires second : T ⊆ I
  requires disjoint : S ∩ T = ∅
  shows (S, T) ∈ exteriorSplittings(I, S ∪ T)
proof
  have hS := powerset.membership_iff.backward at S, I with first
  have hT := powerset.membership_iff.backward at T, I with second
  have pair := product.pair at S, T, 𝒫(I), 𝒫(I) with hS, hT
  apply exteriorSplittings.membership.backward
  exact ⟨pair, S, hS, T, hT, rfl, disjoint, rfl⟩

-- cardinality is the union of its candidates, so ∅ = 0 off the finite sets.
theorem cardinality.nat_total (A : Set)
  shows Nat(cardinality(A))
proof
  by_cases finite : Finite(A)
  . exact cardinality.nat at A with finite
  . have empty : ⋃(cardinality.candidates(A)) = ∅
      apply union.eq_empty_iff.backward
      intros n hn
      unfold cardinality.candidates at hn
      obtain ⟨_, has⟩ := hn
      have fin := Finite.from_cardinality with has
      contradiction
    have h := cardinality.nat at ∅ with Finite.empty
    rw [cardinality.empty, nat.zero] at h
    unfold cardinality
    rw empty
    exact h

section ExteriorSignLaws
variable (R lt : Set)
hypothesis ring : CommRing(R)

theorem exteriorSign.mem (S T : Set)
  shows exteriorSign(R, lt, S, T) ∈ R.carrier
proof
  have ringR := CommRing.to_ring with ring
  have count := cardinality.nat_total at exteriorInversions(lt, S, T)
  have oneIn := Ring.one_mem at R with ringR
  have negIn := Ring.neg_mem at R, R.one with ringR, oneIn
  have power := Ring.pow_mem at R, -R.one, cardinality(exteriorInversions(lt, S, T)) with ringR, negIn, count
  unfold Ring.pow at power
  unfold exteriorSign
  exact power

end ExteriorSignLaws

-- Section: The algebra
-- An element of ⋀Rᴵ is its coordinate function 𝒫(I) → R. The product
-- (x y)(U) = Σ_{S ⊔ T = U} sign(S, T) x(S) y(T).
defgraph exteriorProductTerms (R I lt x y U : Set)
    (q ∈ exteriorSplittings(I, U)) : Ring.carrier(R) :=
  call2(Ring.mul(R), call2(Ring.mul(R), exteriorSign(R, lt, fst(q), snd(q)),
    x(fst(q))), y(snd(q)))
requires ring : CommRing(R)
requires xIn : x ∈ functionSpace(𝒫(I), Ring.carrier(R))
requires yIn : y ∈ functionSpace(𝒫(I), Ring.carrier(R))
proof
  have ringR := CommRing.to_ring with ring
  obtain ⟨sI, tI, _, _, _⟩ := exteriorSplittings.parts with member
  have sP := powerset.membership_iff.backward at fst(q), I with sI
  have tP := powerset.membership_iff.backward at snd(q), I with tI
  have xF := functionSpace.mem_iff.forward with xIn
  have yF := functionSpace.mem_iff.forward with yIn
  have xs := FunctionBetween.apply_closed with xF, sP
  have yt := FunctionBetween.apply_closed with yF, tP
  have sg := exteriorSign.mem at R, lt, fst(q), snd(q) with ring
  have m1 := Ring.mul_mem at R, exteriorSign(R, lt, fst(q), snd(q)), x(fst(q)) with ringR, sg, xs
  exact Ring.mul_mem at R, call2(Ring.mul(R), exteriorSign(R, lt, fst(q), snd(q)), x(fst(q))), y(snd(q)) with ringR, m1, yt

def exteriorProduct (R I lt x y : Set) : Set :=
  { p ∈ 𝒫(I) × Ring.carrier(R) | ∃ U ∈ 𝒫(I), p = (U,
    finiteRingSum(exteriorSplittings(I, U), Ring.carrier(R), Ring.add(R),
      Ring.zero(R), Ring.neg(R), Ring.mul(R), Ring.one(R),
      exteriorProductTerms(R, I, lt, x, y, U))) }

-- Section: The product graph
theorem exteriorProduct.graph_relates (R I lt x y U : Set)
  requires index : U ∈ 𝒫(I)
  requires valueIn : finiteRingSum(exteriorSplittings(I, U), Ring.carrier(R), Ring.add(R), Ring.zero(R), Ring.neg(R), Ring.mul(R), Ring.one(R), exteriorProductTerms(R, I, lt, x, y, U)) ∈ Ring.carrier(R)
  shows relates(exteriorProduct(R, I, lt, x, y), U, finiteRingSum(exteriorSplittings(I, U), Ring.carrier(R), Ring.add(R), Ring.zero(R), Ring.neg(R), Ring.mul(R), Ring.one(R), exteriorProductTerms(R, I, lt, x, y, U)))
proof
  unfold relates
  apply exteriorProduct.membership.backward
  refine ⟨(product.pair at U, finiteRingSum(exteriorSplittings(I, U), Ring.carrier(R), Ring.add(R), Ring.zero(R), Ring.neg(R), Ring.mul(R), Ring.one(R), exteriorProductTerms(R, I, lt, x, y, U)), 𝒫(I), Ring.carrier(R) with index, valueIn), U, index, rfl⟩

theorem exteriorProduct.graph_function (R I lt x y : Set)
  requires values : ∀ U ∈ 𝒫(I), finiteRingSum(exteriorSplittings(I, U), Ring.carrier(R), Ring.add(R), Ring.zero(R), Ring.neg(R), Ring.mul(R), Ring.one(R), exteriorProductTerms(R, I, lt, x, y, U)) ∈ Ring.carrier(R)
  shows exteriorProduct(R, I, lt, x, y) : 𝒫(I) → Ring.carrier(R)
proof
  constructor
    intros q0 member
    obtain ⟨bounded, witnesses⟩ := exteriorProduct.membership.forward with member
    exact bounded
  . constructor
      intros z0 first xFirst second xSecond
      unfold relates at xFirst
      obtain ⟨_, a1, a1In, firstShape⟩ := exteriorProduct.membership.forward with xFirst
      unfold relates at xSecond
      obtain ⟨_, a2, a2In, secondShape⟩ := exteriorProduct.membership.forward with xSecond
      obtain ⟨xi, firstEqual⟩ := orderedPair.injective with firstShape
      obtain ⟨xj, secondEqual⟩ := orderedPair.injective with secondShape
      rw [firstEqual, secondEqual]
      cc
    . intros U xIn
      have valueIn := values with U, xIn
      refine ⟨finiteRingSum(exteriorSplittings(I, U), Ring.carrier(R), Ring.add(R), Ring.zero(R), Ring.neg(R), Ring.mul(R), Ring.one(R), exteriorProductTerms(R, I, lt, x, y, U)), valueIn, (exteriorProduct.graph_relates at R, I, lt, x, y, U with xIn, valueIn)⟩

theorem exteriorProduct.graph_apply (R I lt x y U : Set)
  requires values : ∀ U ∈ 𝒫(I), finiteRingSum(exteriorSplittings(I, U), Ring.carrier(R), Ring.add(R), Ring.zero(R), Ring.neg(R), Ring.mul(R), Ring.one(R), exteriorProductTerms(R, I, lt, x, y, U)) ∈ Ring.carrier(R)
  requires index : U ∈ 𝒫(I)
  shows exteriorProduct(R, I, lt, x, y)(U) = finiteRingSum(exteriorSplittings(I, U), Ring.carrier(R), Ring.add(R), Ring.zero(R), Ring.neg(R), Ring.mul(R), Ring.one(R), exteriorProductTerms(R, I, lt, x, y, U))
proof
  have function := exteriorProduct.graph_function at R, I, lt, x, y with values
  have valueIn := values with U, index
  have mapped := exteriorProduct.graph_relates at R, I, lt, x, y, U with index, valueIn
  exact FunctionBetween.apply_value with function, index, mapped


section ExteriorProductLaws
variable (R I lt : Set)
hypothesis ring : CommRing(R)
hypothesis finite : Finite(I)

theorem exteriorProductTerms.weights (x y U : Set)
  requires xIn : x ∈ functionSpace(𝒫(I), R.carrier)
  requires yIn : y ∈ functionSpace(𝒫(I), R.carrier)
  shows exteriorProductTerms(R, I, lt, x, y, U) : exteriorSplittings(I, U) → R.carrier
proof
  exact exteriorProductTerms.function at R, I, lt, x, y, U with ring, xIn, yIn

theorem exteriorProduct.value_mem (x y U : Set)
  requires xIn : x ∈ functionSpace(𝒫(I), R.carrier)
  requires yIn : y ∈ functionSpace(𝒫(I), R.carrier)
  shows finiteRingSum(exteriorSplittings(I, U), R.carrier, R.add, R.zero, R.neg, R.mul, R.one, exteriorProductTerms(R, I, lt, x, y, U)) ∈ R.carrier
proof
  have parts := CommRing.parts with ring
  have fin := exteriorSplittings.finite at I, U with finite
  have weights := exteriorProductTerms.weights at R, I, lt, x, y, U with ring, finite, xIn, yIn
  exact finiteRingSum.closed with parts, fin, weights

theorem exteriorProduct.mem (x y : Set)
  requires xIn : x ∈ functionSpace(𝒫(I), R.carrier)
  requires yIn : y ∈ functionSpace(𝒫(I), R.carrier)
  shows exteriorProduct(R, I, lt, x, y) ∈ functionSpace(𝒫(I), R.carrier)
proof
  have values : ∀ U ∈ 𝒫(I), finiteRingSum(exteriorSplittings(I, U), R.carrier, R.add, R.zero, R.neg, R.mul, R.one, exteriorProductTerms(R, I, lt, x, y, U)) ∈ R.carrier
    intros U hU
    exact exteriorProduct.value_mem at R, I, lt, x, y, U with ring, finite, xIn, yIn
  have function := exteriorProduct.graph_function at R, I, lt, x, y with values
  exact functionSpace.mem_iff.backward with function

theorem exteriorProduct.apply (x y U : Set)
  requires xIn : x ∈ functionSpace(𝒫(I), R.carrier)
  requires yIn : y ∈ functionSpace(𝒫(I), R.carrier)
  requires index : U ∈ 𝒫(I)
  shows exteriorProduct(R, I, lt, x, y)(U) = finiteRingSum(exteriorSplittings(I, U), R.carrier, R.add, R.zero, R.neg, R.mul, R.one, exteriorProductTerms(R, I, lt, x, y, U))
proof
  have values : ∀ W ∈ 𝒫(I), finiteRingSum(exteriorSplittings(I, W), R.carrier, R.add, R.zero, R.neg, R.mul, R.one, exteriorProductTerms(R, I, lt, x, y, W)) ∈ R.carrier
    intros W hW
    exact exteriorProduct.value_mem at R, I, lt, x, y, W with ring, finite, xIn, yIn
  exact exteriorProduct.graph_apply at R, I, lt, x, y, U with values, index

end ExteriorProductLaws

defgraph exteriorMultiplication (R I lt : Set)
    (p ∈ functionSpace(𝒫(I), Ring.carrier(R)) ×
      functionSpace(𝒫(I), Ring.carrier(R))) :
    functionSpace(𝒫(I), Ring.carrier(R)) :=
  exteriorProduct(R, I, lt, fst(p), snd(p))
requires ring : CommRing(R)
requires finite : Finite(I)
proof
  obtain ⟨_, a, aIn, b, bIn, shape⟩ := product.membership.forward with member
  rw shape
  rw [fst.pair, snd.pair]
  exact exteriorProduct.mem at R, I, lt, a, b with ring, finite, aIn, bIn

-- The basis vector e_S, the exterior algebra ⋀Rᴵ as a ring with one e_∅,
-- and its underlying R-module R^𝒫(I).
def exteriorBasisVector (R I S : Set) : Set := unitVector(R, 𝒫(I), S)

def exteriorAlgebra (R I lt : Set) : Set :=
  Ring.mk(functionSpace(𝒫(I), Ring.carrier(R)),
    functionModuleAdd(R, 𝒫(I), selfModule(R)),
    constantFunction(𝒫(I), Ring.carrier(R), Ring.zero(R)),
    functionModuleNeg(R, 𝒫(I), selfModule(R)),
    exteriorMultiplication(R, I, lt),
    exteriorBasisVector(R, I, ∅))

def exteriorModule (R I : Set) : Set := coordinateModule(R, 𝒫(I))

-- The scalars r e_∅ (algebraMap R (⋀Rᴵ)) and the projection to degree
-- zero x ↦ x(∅) (ExteriorAlgebra.algebraMapInv).
def exteriorScalar (R I : Set) : Set :=
  { p ∈ Ring.carrier(R) × functionSpace(𝒫(I), Ring.carrier(R)) |
    ∃ r ∈ Ring.carrier(R), p = (r, call2(Module.smul(exteriorModule(R, I)), r,
      exteriorBasisVector(R, I, ∅))) }

def exteriorDegreeZero (R I : Set) : Set :=
  { p ∈ functionSpace(𝒫(I), Ring.carrier(R)) × Ring.carrier(R) |
    ∃ x ∈ functionSpace(𝒫(I), Ring.carrier(R)), p = (x, x(∅)) }

-- ι : Rᴵ → ⋀Rᴵ, v ↦ Σ v(i) e_{i} (ExteriorAlgebra.ι).
def exteriorDegreeOne (R I v : Set) : Set :=
  { p ∈ 𝒫(I) × Ring.carrier(R) | ∃ S ∈ 𝒫(I),
    (∃ i ∈ I, S = {i} ∧ p = (S, v(i))) ∨
    ((∀ i ∈ I, S ≠ {i}) ∧ p = (S, Ring.zero(R))) }

def exteriorIota (R I : Set) : Set :=
  { p ∈ functionSpace(I, Ring.carrier(R)) × functionSpace(𝒫(I), Ring.carrier(R)) |
    ∃ v ∈ functionSpace(I, Ring.carrier(R)), p = (v, exteriorDegreeOne(R, I, v)) }

-- ι(u(0)) ι(u(1)) ⋯ ι(u(k − 1)) for u : k → Rᴵ (ExteriorAlgebra.ιMulti).
def exteriorMultiProduct (R I lt u : Set, k : Nat) → Set
  | R, I, lt, u, zero => exteriorBasisVector(R, I, ∅)
  | R, I, lt, u, succ(j) => exteriorProduct(R, I, lt,
      exteriorMultiProduct(R, I, lt, u, j), exteriorDegreeOne(R, I, u(j)))

-- ⋀ᵏ Rᴵ: the elements supported on the k-subsets (exteriorPower), a
-- submodule of the exterior algebra.
def exteriorPower (R I k : Set) : Set :=
  { x ∈ functionSpace(𝒫(I), Ring.carrier(R)) | ∀ S ∈ 𝒫(I),
    ¬HasCardinality(S, k) → x(S) = Ring.zero(R) }

-- The family S ↦ e_S on the k-subsets of I.
def exteriorPowerBasis (R I k : Set) : Set :=
  { p ∈ subsetsOfSize(I, k) × functionSpace(𝒫(I), Ring.carrier(R)) |
    ∃ S ∈ subsetsOfSize(I, k), p = (S, exteriorBasisVector(R, I, S)) }

-- Contraction with the linear form u ↦ Σ c(i) u(i):
-- (ι_c x)(U) = Σ_{i ∈ I ∖ U} sign({i}, U) c(i) x(U ∪ {i})
-- (CliffordAlgebra.contractLeft on the exterior algebra).
defgraph contractionTerms (R I lt c x U : Set) (i ∈ I ∖ U) : Ring.carrier(R) :=
  call2(Ring.mul(R), call2(Ring.mul(R), exteriorSign(R, lt, {i}, U), c(i)),
    x(U ∪ {i}))
requires ring : CommRing(R)
requires form : c ∈ functionSpace(I, Ring.carrier(R))
requires vector : x ∈ functionSpace(𝒫(I), Ring.carrier(R))
proof
  sorry

def contractionValue (R I lt c x : Set) : Set :=
  { q ∈ 𝒫(I) × Ring.carrier(R) | ∃ U ∈ 𝒫(I), q = (U,
    finiteRingSum(I ∖ U, Ring.carrier(R), Ring.add(R), Ring.zero(R),
      Ring.neg(R), Ring.mul(R), Ring.one(R),
      contractionTerms(R, I, lt, c, x, U))) }

def exteriorContraction (R I lt c : Set) : Set :=
  { p ∈ functionSpace(𝒫(I), Ring.carrier(R)) × functionSpace(𝒫(I), Ring.carrier(R)) |
    ∃ x ∈ functionSpace(𝒫(I), Ring.carrier(R)),
      p = (x, contractionValue(R, I, lt, c, x)) }

-- Section: The universal property
-- A ring map φ : R → A into the centre of a ring A makes A an R-algebra
-- (Mathlib's Algebra R A, A not necessarily commutative).
predicate CentralRingHom (φ R A : Set) :=
  RingHom(φ, R, A) ∧
  (∀ r ∈ Ring.carrier(R), ∀ a ∈ Ring.carrier(A),
    call2(Ring.mul(A), φ(r), a) = call2(Ring.mul(A), a, φ(r)))

-- f : Rᴵ → A is φ-linear and squares to zero: the data of
-- ExteriorAlgebra.lift.
predicate ExteriorData (R I A φ f : Set) :=
  CommRing(R) ∧ CentralRingHom(φ, R, A) ∧
  (f : functionSpace(I, Ring.carrier(R)) → Ring.carrier(A)) ∧
  (∀ u v ∈ functionSpace(I, Ring.carrier(R)),
    f(call2(Module.add(coordinateModule(R, I)), u, v)) =
      call2(Ring.add(A), f(u), f(v))) ∧
  (∀ r ∈ Ring.carrier(R), ∀ v ∈ functionSpace(I, Ring.carrier(R)),
    f(call2(Module.smul(coordinateModule(R, I)), r, v)) =
      call2(Ring.mul(A), φ(r), f(v))) ∧
  (∀ v ∈ functionSpace(I, Ring.carrier(R)),
    call2(Ring.mul(A), f(v), f(v)) = Ring.zero(A))

-- The unique ring map ⋀Rᴵ → A extending f on degree one and φ on the
-- scalars.
defunique exteriorLift (R I lt A φ f : Set)
    (F ∈ functionSpace(functionSpace(𝒫(I), Ring.carrier(R)), Ring.carrier(A))) :=
  RingHom(F, exteriorAlgebra(R, I, lt), A) ∧
  (∀ v ∈ functionSpace(I, Ring.carrier(R)), F(exteriorIota(R, I)(v)) = f(v)) ∧
  (∀ r ∈ Ring.carrier(R), F(exteriorScalar(R, I)(r)) = φ(r))
requires finite : Finite(I)
requires order : StrictLinearOrder(I, lt)
requires data : ExteriorData(R, I, A, φ, f)
proof
  sorry
uniqueness
  sorry

-- The map ⋀Rᴵ → ⋀Rᴶ induced by a linear map g : Rᴵ → Rᴶ
-- (ExteriorAlgebra.map): the lift of ι ∘ g.
def exteriorMap (R I lt J lt2 g : Set) : Set :=
  exteriorLift(R, I, lt, exteriorAlgebra(R, J, lt2), exteriorScalar(R, J),
    compose(exteriorIota(R, J), g, functionSpace(I, Ring.carrier(R)),
      functionSpace(J, Ring.carrier(R)), functionSpace(𝒫(J), Ring.carrier(R))))

-- Section: Helpers for coordinates
theorem exteriorModule.carrier_eq (R I : Set)
  shows Module.carrier(exteriorModule(R, I)) = functionSpace(𝒫(I), R.carrier)
proof
  unfold exteriorModule
  exact coordinateModule.carrier_space at R, 𝒫(I)

theorem exteriorAlgebra.projections (R I lt : Set)
  shows Ring.carrier(exteriorAlgebra(R, I, lt)) = functionSpace(𝒫(I), R.carrier) ∧
    Ring.add(exteriorAlgebra(R, I, lt)) = Module.add(exteriorModule(R, I)) ∧
    Ring.zero(exteriorAlgebra(R, I, lt)) = constantFunction(𝒫(I), R.carrier, R.zero) ∧
    Ring.neg(exteriorAlgebra(R, I, lt)) = functionModuleNeg(R, 𝒫(I), selfModule(R)) ∧
    Ring.mul(exteriorAlgebra(R, I, lt)) = exteriorMultiplication(R, I, lt) ∧
    Ring.one(exteriorAlgebra(R, I, lt)) = exteriorBasisVector(R, I, ∅)
proof
  have addEq := functionModule.add_eq at R, 𝒫(I), selfModule(R)
  unfold exteriorModule
  unfold coordinateModule
  rw addEq
  unfold exteriorAlgebra
  ring_projections

section ExteriorCoordinates
variable (R I : Set)
hypothesis ring : CommRing(R)

theorem exteriorModule.module_of
  shows Module(exteriorModule(R, I), R)
proof
  have ringR := CommRing.to_ring with ring
  unfold exteriorModule
  exact coordinateModule.module at R, 𝒫(I) with ringR

theorem exteriorModule.add_apply (x y S : Set)
  requires xIn : x ∈ functionSpace(𝒫(I), R.carrier)
  requires yIn : y ∈ functionSpace(𝒫(I), R.carrier)
  requires index : S ∈ 𝒫(I)
  shows call2(Module.add(exteriorModule(R, I)), x, y)(S) = x(S) + y(S)
proof
  have ringR := CommRing.to_ring with ring
  have self := Ring.to_module at R with ringR
  have selfCarrier := selfModule.carrier_eq at R
  have xS : x ∈ functionSpace(𝒫(I), Module.carrier(selfModule(R)))
    rw selfCarrier
    exact xIn
  have yS : y ∈ functionSpace(𝒫(I), Module.carrier(selfModule(R)))
    rw selfCarrier
    exact yIn
  have value := functionModule.add_apply at R, 𝒫(I), selfModule(R), x, y, S with ringR, self, xS, yS, index
  rw selfModule.add_eq at value
  unfold exteriorModule
  unfold coordinateModule
  exact value

theorem exteriorModule.smul_apply (r x S : Set)
  requires scalar : r ∈ R.carrier
  requires xIn : x ∈ functionSpace(𝒫(I), R.carrier)
  requires index : S ∈ 𝒫(I)
  shows call2(Module.smul(exteriorModule(R, I)), r, x)(S) = r * x(S)
proof
  have ringR := CommRing.to_ring with ring
  have self := Ring.to_module at R with ringR
  have selfCarrier := selfModule.carrier_eq at R
  have xS : x ∈ functionSpace(𝒫(I), Module.carrier(selfModule(R)))
    rw selfCarrier
    exact xIn
  have value := functionModule.smul_apply at R, 𝒫(I), selfModule(R), r, x, S with ringR, self, scalar, xS, index
  rw selfModule.smul_eq at value
  unfold exteriorModule
  unfold coordinateModule
  exact value

theorem exteriorModule.add_mem (x y : Set)
  requires xIn : x ∈ functionSpace(𝒫(I), R.carrier)
  requires yIn : y ∈ functionSpace(𝒫(I), R.carrier)
  shows call2(Module.add(exteriorModule(R, I)), x, y) ∈ functionSpace(𝒫(I), R.carrier)
proof
  have ringR := CommRing.to_ring with ring
  have self := Ring.to_module at R with ringR
  have selfCarrier := selfModule.carrier_eq at R
  have xS : x ∈ functionSpace(𝒫(I), Module.carrier(selfModule(R)))
    rw selfCarrier
    exact xIn
  have yS : y ∈ functionSpace(𝒫(I), Module.carrier(selfModule(R)))
    rw selfCarrier
    exact yIn
  have value := functionModule.add_mem_of at R, 𝒫(I), selfModule(R), x, y with ringR, self, xS, yS
  rw selfCarrier at value
  unfold exteriorModule
  unfold coordinateModule
  exact value

theorem exteriorModule.smul_mem (r x : Set)
  requires scalar : r ∈ R.carrier
  requires xIn : x ∈ functionSpace(𝒫(I), R.carrier)
  shows call2(Module.smul(exteriorModule(R, I)), r, x) ∈ functionSpace(𝒫(I), R.carrier)
proof
  have ringR := CommRing.to_ring with ring
  have self := Ring.to_module at R with ringR
  have selfCarrier := selfModule.carrier_eq at R
  have xS : x ∈ functionSpace(𝒫(I), Module.carrier(selfModule(R)))
    rw selfCarrier
    exact xIn
  have value := functionModule.smul_mem_of at R, 𝒫(I), selfModule(R), r, x with ringR, self, scalar, xS
  rw selfCarrier at value
  unfold exteriorModule
  unfold coordinateModule
  exact value

theorem exteriorBasisVector.mem (S : Set)
  shows exteriorBasisVector(R, I, S) ∈ functionSpace(𝒫(I), R.carrier)
proof
  unfold exteriorBasisVector
  exact unitVector.mem at R, 𝒫(I), S with ring

theorem exteriorBasisVector.apply (S U : Set)
  requires index : U ∈ 𝒫(I)
  shows (U = S → exteriorBasisVector(R, I, S)(U) = R.one) ∧
    (U ≠ S → exteriorBasisVector(R, I, S)(U) = R.zero)
proof
  unfold exteriorBasisVector
  constructor
  . intros same
    rw same at index
    rw same
    exact unitVector.apply_same at R, 𝒫(I), S with ring, index
  . intros other
    exact unitVector.apply_other at R, 𝒫(I), S, U with ring, index, other

theorem exteriorZero.apply (U : Set)
  requires index : U ∈ 𝒫(I)
  shows constantFunction(𝒫(I), R.carrier, R.zero)(U) = R.zero
proof
  have ringR := CommRing.to_ring with ring
  have zeroIn := Ring.zero_mem at R with ringR
  exact constantFunction.apply at 𝒫(I), R.carrier, U, R.zero with index, zeroIn

theorem exteriorZero.mem
  shows constantFunction(𝒫(I), R.carrier, R.zero) ∈ functionSpace(𝒫(I), R.carrier)
proof
  have ringR := CommRing.to_ring with ring
  have zeroIn := Ring.zero_mem at R with ringR
  have function := constantFunction.function at 𝒫(I), R.carrier, R.zero with zeroIn
  exact functionSpace.mem_iff.backward with function

end ExteriorCoordinates

-- Section: Helpers for sums and splittings
theorem exteriorSplit.complement (S T U : Set)
  requires disjoint : S ∩ T = ∅
  requires union : S ∪ T = U
  shows T = U ∖ S
proof
  rw ← union
  ext z
  have noz : ¬(z ∈ S ∩ T)
    rw disjoint
    simp
  simp at noz
  simp

theorem exteriorSplit.of_subset (S U : Set)
  requires sub : S ⊆ U
  shows S ∪ (U ∖ S) = U ∧ S ∩ (U ∖ S) = ∅
proof
  constructor
  . ext z
    simp [sub]
  . ext z
    simp

theorem exteriorSplit.complement_left (S T U : Set)
  requires disjoint : S ∩ T = ∅
  requires union : S ∪ T = U
  shows S = U ∖ T
proof
  rw ← union
  ext z
  have noz : ¬(z ∈ S ∩ T)
    rw disjoint
    simp
  simp at noz
  simp

theorem exteriorSplit.of_subset_right (T U : Set)
  requires sub : T ⊆ U
  shows (U ∖ T) ∪ T = U ∧ (U ∖ T) ∩ T = ∅
proof
  constructor
  . ext z
    simp [sub]
  . ext z
    simp

section ExteriorSums
variable (R : Set)
hypothesis ring : CommRing(R)

-- A finite sum with at most one nonzero term.
theorem exteriorSum.only (D w c : Set)
  requires finite : Finite(D)
  requires weights : w : D → R.carrier
  requires index : c ∈ D
  requires vanishes : ∀ d ∈ D, d ≠ c → w(d) = R.zero
  shows finiteRingSum(D, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, w) = w(c)
proof
  have parts := CommRing.parts with ring
  have wc := FunctionBetween.apply_closed with weights, index
  have sub : {c} ⊆ D
    intros z hz
    have zc := singleton.membership.forward with hz
    rw zc
    exact index
  have constF := constantFunction.function at {c}, R.carrier, w(c) with wc
  have agreement : ∀ s ∈ {c}, w(s) = constantFunction({c}, R.carrier, w(c))(s)
    intros s hs
    have sc := singleton.membership.forward with hs
    have v := constantFunction.apply at {c}, R.carrier, s, w(c) with hs, wc
    rw v
    rw sc
  have outside : ∀ d ∈ D, ¬(d ∈ {c}) → w(d) = R.zero
    intros d hd notIn
    have ne : d ≠ c
      intro same
      apply notIn
      rw same
      exact singleton.self at c
    exact vanishes with d, hd, ne
  have extension := finiteRingSum.zero_extension at D, {c}, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, w, constantFunction({c}, R.carrier, w(c)) with parts, finite, weights, constF, sub, agreement, outside
  have single := finiteRingSum.singleton at R.carrier, R.add, R.zero, R.neg, R.mul, R.one, constantFunction({c}, R.carrier, w(c)), c with parts, constF
  have v := constantFunction.apply at {c}, R.carrier, c, w(c) with (singleton.self at c), wc
  rw [extension, single, v]

theorem exteriorSum.none (D w : Set)
  requires finite : Finite(D)
  requires weights : w : D → R.carrier
  requires vanishes : ∀ d ∈ D, w(d) = R.zero
  shows finiteRingSum(D, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, w) = R.zero
proof
  have parts := CommRing.parts with ring
  exact finiteRingSum.zero at D, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, w with parts, finite, weights, vanishes

end ExteriorSums

section ExteriorMultiplicationLaws
variable (R I lt : Set)
hypothesis ring : CommRing(R)
hypothesis finite : Finite(I)

theorem exteriorAlgebra.mul_eq (x y : Set)
  requires xIn : x ∈ functionSpace(𝒫(I), R.carrier)
  requires yIn : y ∈ functionSpace(𝒫(I), R.carrier)
  shows call2(Ring.mul(exteriorAlgebra(R, I, lt)), x, y) = exteriorProduct(R, I, lt, x, y)
proof
  have pair := product.pair at x, y, functionSpace(𝒫(I), R.carrier), functionSpace(𝒫(I), R.carrier) with xIn, yIn
  have v := exteriorMultiplication.value at R, I, lt, (x, y) with ring, finite, pair
  rw [fst.pair, snd.pair] at v
  obtain ⟨_, _, _, _, mulEq, _⟩ := exteriorAlgebra.projections at R, I, lt
  rw mulEq
  unfold call2
  exact v

-- e_S y and x e_T, coordinatewise.
theorem exteriorProduct.basis_left (S y U : Set)
  requires sI : S ⊆ I
  requires yIn : y ∈ functionSpace(𝒫(I), R.carrier)
  requires index : U ∈ 𝒫(I)
  shows (S ⊆ U → exteriorProduct(R, I, lt, exteriorBasisVector(R, I, S), y)(U) =
      exteriorSign(R, lt, S, U ∖ S) * y(U ∖ S)) ∧
    (¬(S ⊆ U) → exteriorProduct(R, I, lt, exteriorBasisVector(R, I, S), y)(U) = R.zero)
proof
  have ringR := CommRing.to_ring with ring
  have eIn := exteriorBasisVector.mem at R, I, S with ring
  have sP := powerset.membership_iff.backward at S, I with sI
  have uI := powerset.membership_iff.forward with index
  have value := exteriorProduct.apply at R, I, lt, exteriorBasisVector(R, I, S), y, U with ring, finite, eIn, yIn, index
  have fin := exteriorSplittings.finite at I, U with finite
  have weights := exteriorProductTerms.weights at R, I, lt, exteriorBasisVector(R, I, S), y, U with ring, finite, eIn, yIn
  have yF := functionSpace.mem_iff.forward with yIn
  have offS : ∀ q ∈ exteriorSplittings(I, U), fst(q) ≠ S → exteriorProductTerms(R, I, lt, exteriorBasisVector(R, I, S), y, U)(q) = R.zero
    intros q hq ne
    obtain ⟨qI, q2I, _, _, _⟩ := exteriorSplittings.parts with hq
    have qP := powerset.membership_iff.backward at fst(q), I with qI
    have q2P := powerset.membership_iff.backward at snd(q), I with q2I
    have basis := exteriorBasisVector.apply at R, I, S, fst(q) with ring, qP
    have zero := basis.right with ne
    have t := exteriorProductTerms.value at R, I, lt, exteriorBasisVector(R, I, S), y, U, q with ring, eIn, yIn, hq
    have sg := exteriorSign.mem at R, lt, fst(q), snd(q) with ring
    have yv := FunctionBetween.apply_closed with yF, q2P
    rw [t, zero]
    ring
  constructor
  . intros sub
    obtain ⟨u1, d1⟩ := exteriorSplit.of_subset at S, U with sub
    have diffI : U ∖ S ⊆ I
      intros z hz
      simp at hz
      exact uI with z, hz.left
    have cIn0 := exteriorSplittings.pair at I, S, U ∖ S with sI, diffI, d1
    have cIn : (S, U ∖ S) ∈ exteriorSplittings(I, U)
      rw u1 at cIn0
      exact cIn0
    have vanish : ∀ q ∈ exteriorSplittings(I, U), q ≠ (S, U ∖ S) → exteriorProductTerms(R, I, lt, exteriorBasisVector(R, I, S), y, U)(q) = R.zero
      intros q hq ne
      by_cases same : fst(q) = S
      . obtain ⟨_, _, disj, un, shape⟩ := exteriorSplittings.parts with hq
        rw same at disj
        rw same at un
        have comp := exteriorSplit.complement at S, snd(q), U with disj, un
        exfalso
        apply ne
        rw shape
        rw [same, comp]
      . exact offS with q, hq, same
    have only := exteriorSum.only at R, exteriorSplittings(I, U), exteriorProductTerms(R, I, lt, exteriorBasisVector(R, I, S), y, U), (S, U ∖ S) with ring, fin, weights, cIn, vanish
    have t := exteriorProductTerms.value at R, I, lt, exteriorBasisVector(R, I, S), y, U, (S, U ∖ S) with ring, eIn, yIn, cIn
    have basis := exteriorBasisVector.apply at R, I, S, S with ring, sP
    have one := basis.left with rfl
    have diffP := powerset.membership_iff.backward at U ∖ S, I with diffI
    have sg := exteriorSign.mem at R, lt, S, U ∖ S with ring
    have yv := FunctionBetween.apply_closed with yF, diffP
    rw [value, only, t, fst.pair, snd.pair, one]
    ring
  . intros notSub
    have vanish : ∀ q ∈ exteriorSplittings(I, U), exteriorProductTerms(R, I, lt, exteriorBasisVector(R, I, S), y, U)(q) = R.zero
      intros q hq
      have ne : fst(q) ≠ S
        intro same
        obtain ⟨_, _, _, un, _⟩ := exteriorSplittings.parts with hq
        apply notSub
        rw ← un
        rw ← same
        intros z hz
        simp [hz]
      exact offS with q, hq, ne
    rw value
    exact exteriorSum.none at R, exteriorSplittings(I, U), exteriorProductTerms(R, I, lt, exteriorBasisVector(R, I, S), y, U) with ring, fin, weights, vanish

theorem exteriorProduct.basis_right (x T U : Set)
  requires xIn : x ∈ functionSpace(𝒫(I), R.carrier)
  requires tI : T ⊆ I
  requires index : U ∈ 𝒫(I)
  shows (T ⊆ U → exteriorProduct(R, I, lt, x, exteriorBasisVector(R, I, T))(U) =
      exteriorSign(R, lt, U ∖ T, T) * x(U ∖ T)) ∧
    (¬(T ⊆ U) → exteriorProduct(R, I, lt, x, exteriorBasisVector(R, I, T))(U) = R.zero)
proof
  have ringR := CommRing.to_ring with ring
  have eIn := exteriorBasisVector.mem at R, I, T with ring
  have tP := powerset.membership_iff.backward at T, I with tI
  have uI := powerset.membership_iff.forward with index
  have value := exteriorProduct.apply at R, I, lt, x, exteriorBasisVector(R, I, T), U with ring, finite, xIn, eIn, index
  have fin := exteriorSplittings.finite at I, U with finite
  have weights := exteriorProductTerms.weights at R, I, lt, x, exteriorBasisVector(R, I, T), U with ring, finite, xIn, eIn
  have xF := functionSpace.mem_iff.forward with xIn
  have offT : ∀ q ∈ exteriorSplittings(I, U), snd(q) ≠ T → exteriorProductTerms(R, I, lt, x, exteriorBasisVector(R, I, T), U)(q) = R.zero
    intros q hq ne
    obtain ⟨qI, q2I, _, _, _⟩ := exteriorSplittings.parts with hq
    have qP := powerset.membership_iff.backward at fst(q), I with qI
    have q2P := powerset.membership_iff.backward at snd(q), I with q2I
    have basis := exteriorBasisVector.apply at R, I, T, snd(q) with ring, q2P
    have zero := basis.right with ne
    have t := exteriorProductTerms.value at R, I, lt, x, exteriorBasisVector(R, I, T), U, q with ring, xIn, eIn, hq
    have sg := exteriorSign.mem at R, lt, fst(q), snd(q) with ring
    have xv := FunctionBetween.apply_closed with xF, qP
    rw [t, zero]
    ring
  constructor
  . intros sub
    obtain ⟨u1, d1⟩ := exteriorSplit.of_subset_right at T, U with sub
    have diffI : U ∖ T ⊆ I
      intros z hz
      simp at hz
      exact uI with z, hz.left
    have cIn0 := exteriorSplittings.pair at I, U ∖ T, T with diffI, tI, d1
    have cIn : (U ∖ T, T) ∈ exteriorSplittings(I, U)
      rw u1 at cIn0
      exact cIn0
    have vanish : ∀ q ∈ exteriorSplittings(I, U), q ≠ (U ∖ T, T) → exteriorProductTerms(R, I, lt, x, exteriorBasisVector(R, I, T), U)(q) = R.zero
      intros q hq ne
      by_cases same : snd(q) = T
      . obtain ⟨_, _, disj, un, shape⟩ := exteriorSplittings.parts with hq
        rw same at disj
        rw same at un
        have comp := exteriorSplit.complement_left at fst(q), T, U with disj, un
        exfalso
        apply ne
        rw shape
        rw [same, comp]
      . exact offT with q, hq, same
    have only := exteriorSum.only at R, exteriorSplittings(I, U), exteriorProductTerms(R, I, lt, x, exteriorBasisVector(R, I, T), U), (U ∖ T, T) with ring, fin, weights, cIn, vanish
    have t := exteriorProductTerms.value at R, I, lt, x, exteriorBasisVector(R, I, T), U, (U ∖ T, T) with ring, xIn, eIn, cIn
    have basis := exteriorBasisVector.apply at R, I, T, T with ring, tP
    have one := basis.left with rfl
    have diffP := powerset.membership_iff.backward at U ∖ T, I with diffI
    have sg := exteriorSign.mem at R, lt, U ∖ T, T with ring
    have xv := FunctionBetween.apply_closed with xF, diffP
    rw [value, only, t, fst.pair, snd.pair, one]
    ring
  . intros notSub
    have vanish : ∀ q ∈ exteriorSplittings(I, U), exteriorProductTerms(R, I, lt, x, exteriorBasisVector(R, I, T), U)(q) = R.zero
      intros q hq
      have ne : snd(q) ≠ T
        intro same
        obtain ⟨_, _, _, un, _⟩ := exteriorSplittings.parts with hq
        apply notSub
        rw ← un
        rw ← same
        intros z hz
        simp [hz]
      exact offT with q, hq, ne
    rw value
    exact exteriorSum.none at R, exteriorSplittings(I, U), exteriorProductTerms(R, I, lt, x, exteriorBasisVector(R, I, T), U) with ring, fin, weights, vanish

theorem exteriorProduct.basis_disjoint (S T : Set)
  requires sI : S ⊆ I
  requires tI : T ⊆ I
  requires disjoint : S ∩ T = ∅
  shows exteriorProduct(R, I, lt, exteriorBasisVector(R, I, S), exteriorBasisVector(R, I, T)) =
    call2(Module.smul(exteriorModule(R, I)), exteriorSign(R, lt, S, T), exteriorBasisVector(R, I, S ∪ T))
proof
  have ringR := CommRing.to_ring with ring
  have sIn := exteriorBasisVector.mem at R, I, S with ring
  have tIn := exteriorBasisVector.mem at R, I, T with ring
  have uIn := exteriorBasisVector.mem at R, I, S ∪ T with ring
  have sg := exteriorSign.mem at R, lt, S, T with ring
  have left := exteriorProduct.mem at R, I, lt, exteriorBasisVector(R, I, S), exteriorBasisVector(R, I, T) with ring, finite, sIn, tIn
  have right := exteriorModule.smul_mem at R, I, exteriorSign(R, lt, S, T), exteriorBasisVector(R, I, S ∪ T) with ring, sg, uIn
  apply functionSpace.ext_of with left, right
  intros U hU
  have uI := powerset.membership_iff.forward with hU
  have formula := exteriorProduct.basis_left at R, I, lt, S, exteriorBasisVector(R, I, T), U with ring, finite, sI, tIn, hU
  have rv := exteriorModule.smul_apply at R, I, exteriorSign(R, lt, S, T), exteriorBasisVector(R, I, S ∪ T), U with ring, sg, uIn, hU
  rw rv
  have bU := exteriorBasisVector.apply at R, I, S ∪ T, U with ring, hU
  by_cases sub : S ⊆ U
  . have l := formula.left with sub
    rw l
    have diffI : U ∖ S ⊆ I
      intros z hz
      simp at hz
      exact uI with z, hz.left
    have diffP := powerset.membership_iff.backward at U ∖ S, I with diffI
    have bT := exteriorBasisVector.apply at R, I, T, U ∖ S with ring, diffP
    have sg2 := exteriorSign.mem at R, lt, S, U ∖ S with ring
    by_cases same : U ∖ S = T
    . have one := bT.left with same
      have eqU : U = S ∪ T
        obtain ⟨u1, _⟩ := exteriorSplit.of_subset at S, U with sub
        rw ← same
        symm
        exact u1
      have one2 := bU.left with eqU
      rw [one, one2, same]
      ring
    . have zero := bT.right with same
      have neU : U ≠ S ∪ T
        intro eqU
        apply same
        rw eqU
        have refl : S ∪ T = S ∪ T by rfl
        have comp := exteriorSplit.complement at S, T, S ∪ T with disjoint, refl
        symm
        exact comp
      have zero2 := bU.right with neU
      rw [zero, zero2]
      ring
  . have l := formula.right with sub
    rw l
    have neU : U ≠ S ∪ T
      intro eqU
      apply sub
      rw eqU
      intros z hz
      simp [hz]
    have zero2 := bU.right with neU
    rw zero2
    ring

theorem exteriorProduct.basis_overlap (S T : Set)
  requires sI : S ⊆ I
  requires tI : T ⊆ I
  requires overlap : S ∩ T ≠ ∅
  shows exteriorProduct(R, I, lt, exteriorBasisVector(R, I, S), exteriorBasisVector(R, I, T)) =
    constantFunction(𝒫(I), R.carrier, R.zero)
proof
  have ringR := CommRing.to_ring with ring
  have sIn := exteriorBasisVector.mem at R, I, S with ring
  have tIn := exteriorBasisVector.mem at R, I, T with ring
  have left := exteriorProduct.mem at R, I, lt, exteriorBasisVector(R, I, S), exteriorBasisVector(R, I, T) with ring, finite, sIn, tIn
  have right := exteriorZero.mem at R, I with ring
  apply functionSpace.ext_of with left, right
  intros U hU
  have uI := powerset.membership_iff.forward with hU
  have formula := exteriorProduct.basis_left at R, I, lt, S, exteriorBasisVector(R, I, T), U with ring, finite, sI, tIn, hU
  have zeroAt := exteriorZero.apply at R, I, U with ring, hU
  rw zeroAt
  by_cases sub : S ⊆ U
  . have l := formula.left with sub
    rw l
    have diffI : U ∖ S ⊆ I
      intros z hz
      simp at hz
      exact uI with z, hz.left
    have diffP := powerset.membership_iff.backward at U ∖ S, I with diffI
    have bT := exteriorBasisVector.apply at R, I, T, U ∖ S with ring, diffP
    have sg2 := exteriorSign.mem at R, lt, S, U ∖ S with ring
    have ne : U ∖ S ≠ T
      intro same
      apply overlap
      rw ← same
      obtain ⟨_, d1⟩ := exteriorSplit.of_subset at S, U with sub
      exact d1
    have zero := bT.right with ne
    rw zero
    ring
  . exact formula.right with sub

theorem exteriorProduct.add_left (x x2 y : Set)
  requires xIn : x ∈ functionSpace(𝒫(I), R.carrier)
  requires x2In : x2 ∈ functionSpace(𝒫(I), R.carrier)
  requires yIn : y ∈ functionSpace(𝒫(I), R.carrier)
  shows exteriorProduct(R, I, lt, call2(Module.add(exteriorModule(R, I)), x, x2), y) = call2(Module.add(exteriorModule(R, I)), exteriorProduct(R, I, lt, x, y), exteriorProduct(R, I, lt, x2, y))
proof
  have ringR := CommRing.to_ring with ring
  have parts := CommRing.parts with ring
  have sumIn := exteriorModule.add_mem at R, I, x, x2 with ring, xIn, x2In
  have p1 := exteriorProduct.mem at R, I, lt, x, y with ring, finite, xIn, yIn
  have p2 := exteriorProduct.mem at R, I, lt, x2, y with ring, finite, x2In, yIn
  have left := exteriorProduct.mem at R, I, lt, call2(Module.add(exteriorModule(R, I)), x, x2), y with ring, finite, sumIn, yIn
  have right := exteriorModule.add_mem at R, I, exteriorProduct(R, I, lt, x, y), exteriorProduct(R, I, lt, x2, y) with ring, p1, p2
  have xF := functionSpace.mem_iff.forward with xIn
  have x2F := functionSpace.mem_iff.forward with x2In
  have yF := functionSpace.mem_iff.forward with yIn
  apply functionSpace.ext_of with left, right
  intros U hU
  have a := exteriorProduct.apply at R, I, lt, call2(Module.add(exteriorModule(R, I)), x, x2), y, U with ring, finite, sumIn, yIn, hU
  have b := exteriorModule.add_apply at R, I, exteriorProduct(R, I, lt, x, y), exteriorProduct(R, I, lt, x2, y), U with ring, p1, p2, hU
  have c1 := exteriorProduct.apply at R, I, lt, x, y, U with ring, finite, xIn, yIn, hU
  have c2 := exteriorProduct.apply at R, I, lt, x2, y, U with ring, finite, x2In, yIn, hU
  rw [a, b, c1, c2]
  have fin := exteriorSplittings.finite at I, U with finite
  have w1 := exteriorProductTerms.weights at R, I, lt, x, y, U with ring, finite, xIn, yIn
  have w2 := exteriorProductTerms.weights at R, I, lt, x2, y, U with ring, finite, x2In, yIn
  have w3 := exteriorProductTerms.weights at R, I, lt, call2(Module.add(exteriorModule(R, I)), x, x2), y, U with ring, finite, sumIn, yIn
  have oneIn := Ring.one_mem at R with ringR
  have entries : ∀ q ∈ exteriorSplittings(I, U), exteriorProductTerms(R, I, lt, call2(Module.add(exteriorModule(R, I)), x, x2), y, U)(q) = R.one * exteriorProductTerms(R, I, lt, x, y, U)(q) + R.one * exteriorProductTerms(R, I, lt, x2, y, U)(q)
    intros q hq
    obtain ⟨qI, q2I, _, _, _⟩ := exteriorSplittings.parts with hq
    have qP := powerset.membership_iff.backward at fst(q), I with qI
    have q2P := powerset.membership_iff.backward at snd(q), I with q2I
    have t3 := exteriorProductTerms.value at R, I, lt, call2(Module.add(exteriorModule(R, I)), x, x2), y, U, q with ring, sumIn, yIn, hq
    have t1 := exteriorProductTerms.value at R, I, lt, x, y, U, q with ring, xIn, yIn, hq
    have t2 := exteriorProductTerms.value at R, I, lt, x2, y, U, q with ring, x2In, yIn, hq
    have s := exteriorModule.add_apply at R, I, x, x2, fst(q) with ring, xIn, x2In, qP
