-- The exterior algebra of the finite free module Rᴵ over a commutative
-- ring, I finite and linearly ordered, by its basis e_S indexed by the
-- subsets S ⊆ I: e_S e_T = ±e_{S ∪ T} when S and T are disjoint and 0
-- otherwise, the sign counting the pairs out of order. The inclusion ι
-- of Rᴵ in degree one with ι(v)² = 0, the products ι(v₁)⋯ι(v_k)
-- (ExteriorAlgebra.ιMulti), the exterior powers ⋀ᵏ Rᴵ with their bases
-- of k-subsets, the projection to degree zero (algebraMapInv), the
-- universal property (ExteriorAlgebra.lift), functoriality
-- (ExteriorAlgebra.map), and contraction with a linear form
-- (contractLeft). The proof uses exterior algebras only of free modules
-- of finite rank, in the Hodge and Hodge–Tate cohomology of the
-- universe region.
-- Part of the GRH blueprint.
-- Planned home: Algebra/Module/Exterior.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Linear.Exterior
import GRH.Linear.Dimension
import Grace.Cumulus.Cardinal.Combinations
import Grace.Cumulus.Set.Order

-- Section: The sign of a pair of subsets
-- The pairs (s, t) ∈ S × T out of order (t < s), and the sign
-- (−1)^#{such pairs} ∈ R: e_S e_T = sign(S, T) e_{S ∪ T} for S ∩ T = ∅.
def exteriorInversions (lt S T : Set) : Set :=
  { p ∈ S × T | ∃ s ∈ S, ∃ t ∈ T, p = (s, t) ∧ (t, s) ∈ lt }

def exteriorSign (R lt S T : Set) : Set :=
  monoidPow(Ring.mul(R), Ring.one(R), apply(Ring.neg(R), Ring.one(R)),
    cardinality(exteriorInversions(lt, S, T)))

-- The ways of writing U as a disjoint union S ∪ T.
def exteriorSplittings (I U : Set) : Set :=
  { q ∈ 𝒫(I) × 𝒫(I) | ∃ S ∈ 𝒫(I), ∃ T ∈ 𝒫(I),
    q = (S, T) ∧ S ∩ T = ∅ ∧ S ∪ T = U }

-- Section: The algebra
-- An element of ⋀Rᴵ is its coordinate function 𝒫(I) → R. The product
-- (x y)(U) = Σ_{S ⊔ T = U} sign(S, T) x(S) y(T).
defgraph exteriorProductTerms (R I lt x y U : Set)
    (q ∈ exteriorSplittings(I, U)) : Ring.carrier(R) :=
  call2(Ring.mul(R), call2(Ring.mul(R), exteriorSign(R, lt, fst(q), snd(q)),
    x(fst(q))), y(snd(q)))
requires ring : CommRing(R)
requires xIn : x ∈ functionSpace(𝒫(I), Ring.carrier(R))
requires yIn : y ∈ functionSpace(𝒫(I), Ring.carrier(R))
proof
  sorry

def exteriorProduct (R I lt x y : Set) : Set :=
  { p ∈ 𝒫(I) × Ring.carrier(R) | ∃ U ∈ 𝒫(I), p = (U,
    finiteRingSum(exteriorSplittings(I, U), Ring.carrier(R), Ring.add(R),
      Ring.zero(R), Ring.neg(R), Ring.mul(R), Ring.one(R),
      exteriorProductTerms(R, I, lt, x, y, U))) }

defgraph exteriorMultiplication (R I lt : Set)
    (p ∈ functionSpace(𝒫(I), Ring.carrier(R)) ×
      functionSpace(𝒫(I), Ring.carrier(R))) :
    functionSpace(𝒫(I), Ring.carrier(R)) :=
  exteriorProduct(R, I, lt, fst(p), snd(p))
requires ring : CommRing(R)
requires finite : Finite(I)
proof
  sorry

-- The basis vector e_S, the exterior algebra ⋀Rᴵ as a ring with one e_∅,
-- and its underlying R-module R^𝒫(I).
def exteriorBasisVector (R I S : Set) : Set := unitVector(R, 𝒫(I), S)

def exteriorAlgebra (R I lt : Set) : Set :=
  Ring.mk(functionSpace(𝒫(I), Ring.carrier(R)),
    functionModuleAdd(R, 𝒫(I), selfModule(R)),
    constantFunction(𝒫(I), Ring.carrier(R), Ring.zero(R)),
    functionModuleNeg(R, 𝒫(I), selfModule(R)),
    exteriorMultiplication(R, I, lt),
    exteriorBasisVector(R, I, ∅))

def exteriorModule (R I : Set) : Set := coordinateModule(R, 𝒫(I))

-- The scalars r e_∅ (algebraMap R (⋀Rᴵ)) and the projection to degree
-- zero x ↦ x(∅) (ExteriorAlgebra.algebraMapInv).
def exteriorScalar (R I : Set) : Set :=
  { p ∈ Ring.carrier(R) × functionSpace(𝒫(I), Ring.carrier(R)) |
    ∃ r ∈ Ring.carrier(R), p = (r, call2(Module.smul(exteriorModule(R, I)), r,
      exteriorBasisVector(R, I, ∅))) }

def exteriorDegreeZero (R I : Set) : Set :=
  { p ∈ functionSpace(𝒫(I), Ring.carrier(R)) × Ring.carrier(R) |
    ∃ x ∈ functionSpace(𝒫(I), Ring.carrier(R)), p = (x, x(∅)) }

-- ι : Rᴵ → ⋀Rᴵ, v ↦ Σ v(i) e_{i} (ExteriorAlgebra.ι).
def exteriorDegreeOne (R I v : Set) : Set :=
  { p ∈ 𝒫(I) × Ring.carrier(R) | ∃ S ∈ 𝒫(I),
    (∃ i ∈ I, S = {i} ∧ p = (S, v(i))) ∨
    ((∀ i ∈ I, S ≠ {i}) ∧ p = (S, Ring.zero(R))) }

def exteriorIota (R I : Set) : Set :=
  { p ∈ functionSpace(I, Ring.carrier(R)) × functionSpace(𝒫(I), Ring.carrier(R)) |
    ∃ v ∈ functionSpace(I, Ring.carrier(R)), p = (v, exteriorDegreeOne(R, I, v)) }

-- ι(u(0)) ι(u(1)) ⋯ ι(u(k − 1)) for u : k → Rᴵ (ExteriorAlgebra.ιMulti).
def exteriorMultiProduct (R I lt u : Set, k : Nat) → Set
  | R, I, lt, u, zero => exteriorBasisVector(R, I, ∅)
  | R, I, lt, u, succ(j) => exteriorProduct(R, I, lt,
      exteriorMultiProduct(R, I, lt, u, j), exteriorDegreeOne(R, I, u(j)))

-- ⋀ᵏ Rᴵ: the elements supported on the k-subsets (exteriorPower), a
-- submodule of the exterior algebra.
def exteriorPower (R I k : Set) : Set :=
  { x ∈ functionSpace(𝒫(I), Ring.carrier(R)) | ∀ S ∈ 𝒫(I),
    ¬HasCardinality(S, k) → x(S) = Ring.zero(R) }

-- The family S ↦ e_S on the k-subsets of I.
def exteriorPowerBasis (R I k : Set) : Set :=
  { p ∈ subsetsOfSize(I, k) × functionSpace(𝒫(I), Ring.carrier(R)) |
    ∃ S ∈ subsetsOfSize(I, k), p = (S, exteriorBasisVector(R, I, S)) }

-- Contraction with the linear form u ↦ Σ c(i) u(i):
-- (ι_c x)(U) = Σ_{i ∈ I ∖ U} sign({i}, U) c(i) x(U ∪ {i})
-- (CliffordAlgebra.contractLeft on the exterior algebra).
defgraph contractionTerms (R I lt c x U : Set) (i ∈ I ∖ U) : Ring.carrier(R) :=
  call2(Ring.mul(R), call2(Ring.mul(R), exteriorSign(R, lt, {i}, U), c(i)),
    x(U ∪ {i}))
requires ring : CommRing(R)
requires form : c ∈ functionSpace(I, Ring.carrier(R))
requires vector : x ∈ functionSpace(𝒫(I), Ring.carrier(R))
proof
  sorry

def contractionValue (R I lt c x : Set) : Set :=
  { q ∈ 𝒫(I) × Ring.carrier(R) | ∃ U ∈ 𝒫(I), q = (U,
    finiteRingSum(I ∖ U, Ring.carrier(R), Ring.add(R), Ring.zero(R),
      Ring.neg(R), Ring.mul(R), Ring.one(R),
      contractionTerms(R, I, lt, c, x, U))) }

def exteriorContraction (R I lt c : Set) : Set :=
  { p ∈ functionSpace(𝒫(I), Ring.carrier(R)) × functionSpace(𝒫(I), Ring.carrier(R)) |
    ∃ x ∈ functionSpace(𝒫(I), Ring.carrier(R)),
      p = (x, contractionValue(R, I, lt, c, x)) }

-- Section: The universal property
-- A ring map φ : R → A into the centre of a ring A makes A an R-algebra
-- (Mathlib's Algebra R A, A not necessarily commutative).
predicate CentralRingHom (φ R A : Set) :=
  RingHom(φ, R, A) ∧
  (∀ r ∈ Ring.carrier(R), ∀ a ∈ Ring.carrier(A),
    call2(Ring.mul(A), φ(r), a) = call2(Ring.mul(A), a, φ(r)))

-- f : Rᴵ → A is φ-linear and squares to zero: the data of
-- ExteriorAlgebra.lift.
predicate ExteriorData (R I A φ f : Set) :=
  CommRing(R) ∧ CentralRingHom(φ, R, A) ∧
  (f : functionSpace(I, Ring.carrier(R)) → Ring.carrier(A)) ∧
  (∀ u v ∈ functionSpace(I, Ring.carrier(R)),
    f(call2(Module.add(coordinateModule(R, I)), u, v)) =
      call2(Ring.add(A), f(u), f(v))) ∧
  (∀ r ∈ Ring.carrier(R), ∀ v ∈ functionSpace(I, Ring.carrier(R)),
    f(call2(Module.smul(coordinateModule(R, I)), r, v)) =
      call2(Ring.mul(A), φ(r), f(v))) ∧
  (∀ v ∈ functionSpace(I, Ring.carrier(R)),
    call2(Ring.mul(A), f(v), f(v)) = Ring.zero(A))

-- The unique ring map ⋀Rᴵ → A extending f on degree one and φ on the
-- scalars.
defunique exteriorLift (R I lt A φ f : Set)
    (F ∈ functionSpace(functionSpace(𝒫(I), Ring.carrier(R)), Ring.carrier(A))) :=
  RingHom(F, exteriorAlgebra(R, I, lt), A) ∧
  (∀ v ∈ functionSpace(I, Ring.carrier(R)), F(exteriorIota(R, I)(v)) = f(v)) ∧
  (∀ r ∈ Ring.carrier(R), F(exteriorScalar(R, I)(r)) = φ(r))
requires finite : Finite(I)
requires order : StrictLinearOrder(I, lt)
requires data : ExteriorData(R, I, A, φ, f)
proof
  sorry
uniqueness
  sorry

-- The map ⋀Rᴵ → ⋀Rᴶ induced by a linear map g : Rᴵ → Rᴶ
-- (ExteriorAlgebra.map): the lift of ι ∘ g.
def exteriorMap (R I lt J lt2 g : Set) : Set :=
  exteriorLift(R, I, lt, exteriorAlgebra(R, J, lt2), exteriorScalar(R, J),
    compose(exteriorIota(R, J), g, functionSpace(I, Ring.carrier(R)),
      functionSpace(J, Ring.carrier(R)), functionSpace(𝒫(J), Ring.carrier(R))))

-- Section: Laws
section Exterior
variable (R I lt : Set)
hypothesis ring : CommRing(R)
hypothesis finite : Finite(I)
hypothesis order : StrictLinearOrder(I, lt)

theorem exteriorAlgebra.ring
  shows Ring(exteriorAlgebra(R, I, lt))
proof
  sorry

theorem exteriorModule.module
  shows Module(exteriorModule(R, I), R)
proof
  sorry

-- The additive structure of the ring is that of the module R^𝒫(I).
theorem exteriorAlgebra.additive
  shows Ring.carrier(exteriorAlgebra(R, I, lt)) =
      Module.carrier(exteriorModule(R, I)) ∧
    Ring.add(exteriorAlgebra(R, I, lt)) = Module.add(exteriorModule(R, I))
proof
  sorry

-- The basis {e_S} of ⋀Rᴵ (Basis.ExteriorAlgebra of Pi.basisFun), of rank
-- 2^|I|.
theorem exteriorBasisVector.basis
  shows ModuleBasis(exteriorModule(R, I), R, 𝒫(I),
    standardBasis(R, 𝒫(I)))
proof
  sorry

-- e_S e_T = sign(S, T) e_{S ∪ T} for S ∩ T = ∅, and 0 otherwise
-- (ExteriorAlgebra.basis_mul_of_disjoint).
theorem exteriorBasisVector.mul_disjoint (S T : Set)
  requires first : S ⊆ I
  requires second : T ⊆ I
  requires disjoint : S ∩ T = ∅
  shows call2(Ring.mul(exteriorAlgebra(R, I, lt)),
      exteriorBasisVector(R, I, S), exteriorBasisVector(R, I, T)) =
    call2(Module.smul(exteriorModule(R, I)), exteriorSign(R, lt, S, T),
      exteriorBasisVector(R, I, S ∪ T))
proof
  sorry

theorem exteriorBasisVector.mul_overlap (S T : Set)
  requires first : S ⊆ I
  requires second : T ⊆ I
  requires overlap : S ∩ T ≠ ∅
  shows call2(Ring.mul(exteriorAlgebra(R, I, lt)),
      exteriorBasisVector(R, I, S), exteriorBasisVector(R, I, T)) =
    Ring.zero(exteriorAlgebra(R, I, lt))
proof
  sorry

theorem exteriorSign.swap (S T : Set)
  requires first : S ⊆ I
  requires second : T ⊆ I
  requires disjoint : S ∩ T = ∅
  shows call2(R.mul, exteriorSign(R, lt, S, T), exteriorSign(R, lt, T, S)) =
    monoidPow(R.mul, R.one, -R.one, cardinality(S) * cardinality(T))
proof
  sorry

-- The scalars are central and form a copy of R (algebraMap).
theorem exteriorScalar.central_hom
  shows CentralRingHom(exteriorScalar(R, I), R, exteriorAlgebra(R, I, lt))
proof
  sorry

-- The action of R is multiplication by scalars.
theorem exteriorScalar.smul (r x : Set)
  requires scalar : r ∈ R.carrier
  requires member : x ∈ functionSpace(𝒫(I), R.carrier)
  shows call2(Ring.mul(exteriorAlgebra(R, I, lt)), exteriorScalar(R, I)(r), x) =
    call2(Module.smul(exteriorModule(R, I)), r, x)
proof
  sorry

-- ExteriorAlgebra.algebraMapInv is a ring map, left inverse to the
-- scalars.
theorem exteriorDegreeZero.hom
  shows RingHom(exteriorDegreeZero(R, I), exteriorAlgebra(R, I, lt), R)
proof
  sorry

theorem exteriorDegreeZero.scalar (r : R)
  shows exteriorDegreeZero(R, I)(exteriorScalar(R, I)(r)) = r
proof
  sorry

theorem exteriorIota.linear
  shows LinearMap(exteriorIota(R, I), coordinateModule(R, I), R,
    exteriorModule(R, I))
proof
  sorry

theorem exteriorIota.unit_vector (i : Set)
  requires index : i ∈ I
  shows exteriorIota(R, I)(unitVector(R, I, i)) = exteriorBasisVector(R, I, {i})
proof
  sorry

-- ExteriorAlgebra.ι_sq_zero and ι_add_mul_swap: ι(v)² = 0 and
-- ι(u) ι(v) = −ι(v) ι(u).
theorem exteriorIota.square_zero (v : Set)
  requires vector : v ∈ functionSpace(I, R.carrier)
  shows call2(Ring.mul(exteriorAlgebra(R, I, lt)), exteriorIota(R, I)(v),
    exteriorIota(R, I)(v)) = Ring.zero(exteriorAlgebra(R, I, lt))
proof
  sorry

theorem exteriorIota.anticommute (u v : Set)
  requires first : u ∈ functionSpace(I, R.carrier)
  requires second : v ∈ functionSpace(I, R.carrier)
  shows call2(Ring.mul(exteriorAlgebra(R, I, lt)), exteriorIota(R, I)(u),
      exteriorIota(R, I)(v)) =
    apply(Ring.neg(exteriorAlgebra(R, I, lt)),
      call2(Ring.mul(exteriorAlgebra(R, I, lt)), exteriorIota(R, I)(v),
        exteriorIota(R, I)(u)))
proof
  sorry

-- The products of the ι(e_i) in increasing order are the basis vectors.
theorem exteriorMultiProduct.basis_vector (k : Nat) (u S : Set)
  requires subset : S ⊆ I
  requires increasing : BijectiveBetween(u, k, S) ∧
    (∀ a ∈ k, ∀ b ∈ k, a < b → (u(a), u(b)) ∈ lt)
  shows exteriorMultiProduct(R, I, lt, compose(standardBasis(R, I), u, k, I,
      functionSpace(I, R.carrier)), k) = exteriorBasisVector(R, I, S)
proof
  sorry

-- ιMulti is alternating: it vanishes when two vectors agree.
theorem exteriorMultiProduct.alternating (k : Nat) (u a b : Set)
  requires vectors : u : k → functionSpace(I, R.carrier)
  requires first : a ∈ k
  requires second : b ∈ k
  requires distinct : a ≠ b
  requires same : u(a) = u(b)
  shows exteriorMultiProduct(R, I, lt, u, k) = Ring.zero(exteriorAlgebra(R, I, lt))
proof
  sorry

theorem exteriorMultiProduct.mem_power (k : Nat) (u : Set)
  requires vectors : u : k → functionSpace(I, R.carrier)
  shows exteriorMultiProduct(R, I, lt, u, k) ∈ exteriorPower(R, I, k)
proof
  sorry

theorem exteriorPower.submodule (k : Nat)
  shows SubmoduleOf(exteriorPower(R, I, k), exteriorModule(R, I), R)
proof
  sorry

-- ⋀ᵏ Rᴵ has the basis e_S, |S| = k, so rank (|I| choose k)
-- (Basis.exteriorPower).
theorem exteriorPower.basis (k : Nat)
  shows ModuleBasis(submoduleModule(exteriorModule(R, I), R,
    exteriorPower(R, I, k)), R, subsetsOfSize(I, k), exteriorPowerBasis(R, I, k))
proof
  sorry

theorem exteriorPower.mul (j k : Nat) (x y : Set)
  requires first : x ∈ exteriorPower(R, I, j)
  requires second : y ∈ exteriorPower(R, I, k)
  shows call2(Ring.mul(exteriorAlgebra(R, I, lt)), x, y) ∈
    exteriorPower(R, I, j + k)
proof
  sorry

-- Every element is the sum of its homogeneous parts: ⋀Rᴵ is the direct
-- sum of the ⋀ᵏ, k ≤ |I|.
theorem exteriorPower.top (k : Nat)
  requires large : cardinality(I) < k
  shows exteriorPower(R, I, k) = {Ring.zero(exteriorAlgebra(R, I, lt))}
proof
  sorry

-- ExteriorAlgebra.lift: the universal property.
theorem exteriorLift.hom (A φ f : Set)
  requires data : ExteriorData(R, I, A, φ, f)
  shows RingHom(exteriorLift(R, I, lt, A, φ, f), exteriorAlgebra(R, I, lt), A)
proof
  sorry

theorem exteriorLift.iota (A φ f v : Set)
  requires data : ExteriorData(R, I, A, φ, f)
  requires vector : v ∈ functionSpace(I, R.carrier)
  shows exteriorLift(R, I, lt, A, φ, f)(exteriorIota(R, I)(v)) = f(v)
proof
  sorry

theorem exteriorLift.scalar (A φ f r : Set)
  requires data : ExteriorData(R, I, A, φ, f)
  requires scalar : r ∈ R.carrier
  shows exteriorLift(R, I, lt, A, φ, f)(exteriorScalar(R, I)(r)) = φ(r)
proof
  sorry

theorem exteriorLift.eq_of_agree (A φ f F : Set)
  requires data : ExteriorData(R, I, A, φ, f)
  requires hom : RingHom(F, exteriorAlgebra(R, I, lt), A)
  requires onIota : ∀ v ∈ functionSpace(I, R.carrier),
    F(exteriorIota(R, I)(v)) = f(v)
  requires onScalars : ∀ r ∈ R.carrier, F(exteriorScalar(R, I)(r)) = φ(r)
  shows F = exteriorLift(R, I, lt, A, φ, f)
proof
  sorry

-- ExteriorAlgebra.map: a linear map g gives a ring map on exterior
-- algebras with ι(v) ↦ ι(g(v)), functorially.
theorem exteriorMap.hom (J lt2 g : Set)
  requires finiteJ : Finite(J)
  requires orderJ : StrictLinearOrder(J, lt2)
  requires linear : LinearMap(g, coordinateModule(R, I), R, coordinateModule(R, J))
  shows RingHom(exteriorMap(R, I, lt, J, lt2, g), exteriorAlgebra(R, I, lt),
    exteriorAlgebra(R, J, lt2))
proof
  sorry

theorem exteriorMap.iota (J lt2 g v : Set)
  requires finiteJ : Finite(J)
  requires orderJ : StrictLinearOrder(J, lt2)
  requires linear : LinearMap(g, coordinateModule(R, I), R, coordinateModule(R, J))
  requires vector : v ∈ functionSpace(I, R.carrier)
  shows exteriorMap(R, I, lt, J, lt2, g)(exteriorIota(R, I)(v)) =
    exteriorIota(R, J)(g(v))
proof
  sorry

theorem exteriorMap.multi_product (J lt2 g : Set) (k : Nat) (u : Set)
  requires finiteJ : Finite(J)
  requires orderJ : StrictLinearOrder(J, lt2)
  requires linear : LinearMap(g, coordinateModule(R, I), R, coordinateModule(R, J))
  requires vectors : u : k → functionSpace(I, R.carrier)
  shows exteriorMap(R, I, lt, J, lt2, g)(exteriorMultiProduct(R, I, lt, u, k)) =
    exteriorMultiProduct(R, J, lt2, compose(g, u, k, functionSpace(I, R.carrier),
      functionSpace(J, R.carrier)), k)
proof
  sorry

theorem exteriorMap.degree (J lt2 g x : Set) (k : Nat)
  requires finiteJ : Finite(J)
  requires orderJ : StrictLinearOrder(J, lt2)
  requires linear : LinearMap(g, coordinateModule(R, I), R, coordinateModule(R, J))
  requires member : x ∈ exteriorPower(R, I, k)
  shows exteriorMap(R, I, lt, J, lt2, g)(x) ∈ exteriorPower(R, J, k)
proof
  sorry

theorem exteriorMap.identity
  shows exteriorMap(R, I, lt, I, lt, identity(functionSpace(I, R.carrier))) =
    identity(functionSpace(𝒫(I), R.carrier))
proof
  sorry

-- The contraction ι_c is linear, lowers degree by one, and is a graded
-- derivation: ι_c(ι(v) x) = c(v) x − ι(v) ι_c(x)
-- (contractLeft_ι_mul), with ι_c ∘ ι_c = 0.
theorem exteriorContraction.linear (c : Set)
  requires form : c ∈ functionSpace(I, R.carrier)
  shows LinearMap(exteriorContraction(R, I, lt, c), exteriorModule(R, I), R,
    exteriorModule(R, I))
proof
  sorry

theorem exteriorContraction.iota_mul (c v x : Set)
  requires form : c ∈ functionSpace(I, R.carrier)
  requires vector : v ∈ functionSpace(I, R.carrier)
  requires member : x ∈ functionSpace(𝒫(I), R.carrier)
  shows exteriorContraction(R, I, lt, c)(call2(Ring.mul(exteriorAlgebra(R, I, lt)),
      exteriorIota(R, I)(v), x)) =
    call2(Ring.add(exteriorAlgebra(R, I, lt)),
      call2(Module.smul(exteriorModule(R, I)),
        finiteRingSum(I, R.carrier, R.add, R.zero, R.neg, R.mul, R.one,
          combinationTerms(selfModule(R), R, I, c, v)), x),
      apply(Ring.neg(exteriorAlgebra(R, I, lt)),
        call2(Ring.mul(exteriorAlgebra(R, I, lt)), exteriorIota(R, I)(v),
          exteriorContraction(R, I, lt, c)(x))))
proof
  sorry

theorem exteriorContraction.one (c : Set)
  requires form : c ∈ functionSpace(I, R.carrier)
  shows exteriorContraction(R, I, lt, c)(exteriorBasisVector(R, I, ∅)) =
    Ring.zero(exteriorAlgebra(R, I, lt))
proof
  sorry

theorem exteriorContraction.square_zero (c x : Set)
  requires form : c ∈ functionSpace(I, R.carrier)
  requires member : x ∈ functionSpace(𝒫(I), R.carrier)
  shows exteriorContraction(R, I, lt, c)(exteriorContraction(R, I, lt, c)(x)) =
    Ring.zero(exteriorAlgebra(R, I, lt))
proof
  sorry

theorem exteriorContraction.degree (c x : Set) (k : Nat)
  requires form : c ∈ functionSpace(I, R.carrier)
  requires member : x ∈ exteriorPower(R, I, succ(k))
  shows exteriorContraction(R, I, lt, c)(x) ∈ exteriorPower(R, I, k)
proof
  sorry

end Exterior
