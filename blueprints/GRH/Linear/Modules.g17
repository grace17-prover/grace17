-- Modules over a ring and linear maps: linear maps and linear
-- equivalences between bundled modules, identity and composite maps,
-- submodules, the span of a set, finite sums and linear combinations of
-- vectors, kernels and ranges, quotient modules, products of two modules,
-- the modules of functions from a set into a module, precomposition
-- (Mathlib's LinearMap.funLeft), and the module of linear maps with the
-- endomorphism ring.
-- Part of the GRH blueprint.
-- Planned home: Algebra/Module/Linear.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Linear.Modules
import Grace.Cumulus.Algebra.Module.Basic
import Grace.Cumulus.Algebra.Ring.FiniteSetSum
import Grace.Cumulus.Relation.QuotientOperations

-- Section: Linear maps
-- A module is Cumulus's bundled Module(M, R): the carrier M.carrier with
-- M.add, M.zero, M.neg and the action M.smul of the ring R. A linear map
-- f : M → N over R is a function between the carriers preserving sums and
-- the action; a linear equivalence is a bijective linear map. Mathlib's
-- LinearMap and LinearEquiv. The argument order LinearMap(f, M, R, N)
-- reads f : M →ₗ[R] N.
predicate LinearMap (f M R N : Set) :=
  Module(M, R) ∧ Module(N, R) ∧ (f : M.carrier → N.carrier) ∧
  (∀ v w ∈ M.carrier, f(call2(M.add, v, w)) = call2(N.add, f(v), f(w))) ∧
  (∀ r ∈ Ring.carrier(R), ∀ v ∈ M.carrier,
    f(call2(M.smul, r, v)) = call2(N.smul, r, f(v)))

predicate LinearEquiv (f M R N : Set) :=
  LinearMap(f, M, R, N) ∧ BijectiveBetween(f, M.carrier, N.carrier)

-- Two modules are isomorphic when a linear equivalence joins them.
predicate ModuleIsomorphic (M R N : Set) := ∃ f, LinearEquiv(f, M, R, N)

-- Section: Submodules and span
-- N is a submodule of M: a subset containing zero and closed under sums
-- and the action (closure under negation follows, by (−1) • v).
predicate SubmoduleOf (N M R : Set) :=
  Module(M, R) ∧ N ⊆ M.carrier ∧ M.zero ∈ N ∧
  (∀ v w ∈ N, call2(M.add, v, w) ∈ N) ∧
  (∀ r ∈ Ring.carrier(R), ∀ v ∈ N, call2(M.smul, r, v) ∈ N)

-- A submodule with the operations of M restricted to it, as a module.
def submoduleModule (M R N : Set) : Set :=
  Module.mk(N, restrict(Module.add(M), N × N), Module.zero(M),
    restrict(Module.neg(M), N), restrict(Module.smul(M), Ring.carrier(R) × N))

-- The span of S ⊆ M: the least submodule containing S, as the
-- intersection of the submodules containing it (choice-free). Mathlib's
-- Submodule.span.
def moduleSpan (M R S : Set) : Set :=
  { v ∈ Module.carrier(M) | ∀ N, SubmoduleOf(N, M, R) → S ⊆ N → v ∈ N }

-- The sum N + P of two submodules.
def submoduleSum (M N P : Set) : Set :=
  { v ∈ Module.carrier(M) | ∃ x ∈ N, ∃ y ∈ P, v = call2(Module.add(M), x, y) }

-- Section: Finite sums and linear combinations
-- The sum of the vectors w(i), i ∈ V, over a finite set V, independent of
-- the order of summation. Mathlib's Finset.sum in a module.
defunique moduleSum (M V w : Set) (s ∈ Module.carrier(M)) :=
  ∃ n, Nat(n) ∧ ∃ f, BijectiveBetween(f, n, V) ∧
    s = indexedRingSum(w, f, Module.add(M), Module.zero(M), n)
requires group : AbelianGroup(Module.additive(M))
requires finite : Finite(V)
requires values : w : V → Module.carrier(M)
proof
  sorry
uniqueness
  sorry

-- The terms c(i) • v(i) of a linear combination, and the combination
-- Σ_{i ∈ V} c(i) • v(i) itself.
defgraph combinationTerms (M R V c v : Set) (i ∈ V) : Module.carrier(M) :=
    call2(Module.smul(M), c(i), v(i))
requires module : Module(M, R)
requires coefficients : c : V → Ring.carrier(R)
requires vectors : v : V → Module.carrier(M)
proof
  sorry

def moduleCombination (M R V c v : Set) : Set :=
  moduleSum(M, V, combinationTerms(M, R, V, c, v))

-- Families built from families: k ↦ w(k)(x), j ↦ w(i, j), and the row sums
-- i ↦ Σ_j w(i, j), as graphs on the index set.
def familyEvaluate (V X w x : Set) : Set :=
  { p ∈ V × X | ∃ k ∈ V, p = (k, w(k)(x)) }

def familySlice (V X w i : Set) : Set :=
  { q ∈ V × X | ∃ j ∈ V, q = (j, w((i, j))) }

def familyRowSums (M U V w : Set) : Set :=
  { p ∈ U × Module.carrier(M) |
    ∃ i ∈ U, p = (i, moduleSum(M, V, familySlice(V, Module.carrier(M), w, i))) }

-- The multiples r • v of one vector, the linear combinations of a finite
-- family, and the linear combinations of finite subsets of a set.
def scalarMultiples (M R v : Set) : Set :=
  { w ∈ Module.carrier(M) | ∃ r ∈ Ring.carrier(R),
    w = call2(Module.smul(M), r, v) }

def familyCombinations (M R I v : Set) : Set :=
  { w ∈ Module.carrier(M) | ∃ c, (c : I → Ring.carrier(R)) ∧
    w = moduleCombination(M, R, I, c, v) }

def finiteCombinations (M R S : Set) : Set :=
  { w ∈ Module.carrier(M) | ∃ V, V ⊆ S ∧ Finite(V) ∧
    (∃ c, (c : V → Ring.carrier(R)) ∧
      w = moduleCombination(M, R, V, c, identity(V))) }

-- Section: Kernel and range
-- The kernel {v | f(v) = 0} and the range {f(v)} of a linear map.
def linearKernel (f M N : Set) : Set :=
  { v ∈ Module.carrier(M) | f(v) = Module.zero(N) }

def linearRange (f M N : Set) : Set :=
  { w ∈ Module.carrier(N) | ∃ v ∈ Module.carrier(M), f(v) = w }

-- The image and the preimage of a submodule.
def submoduleImage (f M N P : Set) : Set :=
  { w ∈ Module.carrier(N) | ∃ v ∈ P, f(v) = w }

def submodulePreimage (f M Q : Set) : Set :=
  { v ∈ Module.carrier(M) | f(v) ∈ Q }

-- An exact pair M →f N →g P: the range of f is the kernel of g.
predicate ExactPair (f g M N P : Set) :=
  linearRange(f, M, N) = linearKernel(g, N, P)

-- Section: Quotient modules
-- Congruence modulo a submodule N, the quotient module M ⧸ N on the
-- classes, and the projection v ↦ [v]. The action on classes is the graph
-- {((r, [v]), [r • v])}, a function because N is a submodule. Mathlib's
-- Submodule.Quotient and Submodule.mkQ.
def submoduleRelation (M N : Set) : Set :=
  { p ∈ Module.carrier(M) × Module.carrier(M) |
    ∃ x ∈ Module.carrier(M), ∃ y ∈ Module.carrier(M),
      p = (x, y) ∧ call2(Module.add(M), x, apply(Module.neg(M), y)) ∈ N }

def quotientScalar (M R N : Set) : Set :=
  { q ∈ (Ring.carrier(R) × (Module.carrier(M) ⧸ submoduleRelation(M, N))) ×
      (Module.carrier(M) ⧸ submoduleRelation(M, N)) |
    ∃ r ∈ Ring.carrier(R), ∃ v ∈ Module.carrier(M),
      q = ((r, ⟦v⟧[Module.carrier(M), submoduleRelation(M, N)]),
        ⟦call2(Module.smul(M), r, v)⟧[Module.carrier(M), submoduleRelation(M, N)]) }

def quotientModule (M R N : Set) : Set :=
  Module.mk((Module.carrier(M) ⧸ submoduleRelation(M, N)),
    quotientBinary(Module.carrier(M), submoduleRelation(M, N), Module.add(M)),
    ⟦Module.zero(M)⟧[Module.carrier(M), submoduleRelation(M, N)],
    quotientUnary(Module.carrier(M), submoduleRelation(M, N), Module.neg(M)),
    quotientScalar(M, R, N))

def quotientModuleMap (M N : Set) : Set :=
  { p ∈ Module.carrier(M) × (Module.carrier(M) ⧸ submoduleRelation(M, N)) |
    ∃ v ∈ Module.carrier(M),
      p = (v, ⟦v⟧[Module.carrier(M), submoduleRelation(M, N)]) }

-- The map M ⧸ N → P induced by a linear map f vanishing on N: the graph
-- {([v], f(v))}. Mathlib's Submodule.liftQ.
def quotientLift (f M N P : Set) : Set :=
  { p ∈ (Module.carrier(M) ⧸ submoduleRelation(M, N)) × Module.carrier(P) |
    ∃ v ∈ Module.carrier(M),
      p = (⟦v⟧[Module.carrier(M), submoduleRelation(M, N)], f(v)) }

-- Section: Products and function modules
-- The product M × N with the componentwise operations.
defgraph productModuleAdd (M R N : Set)
    (p ∈ (Module.carrier(M) × Module.carrier(N)) ×
      (Module.carrier(M) × Module.carrier(N))) :
    Module.carrier(M) × Module.carrier(N) :=
  (call2(Module.add(M), fst(fst(p)), fst(snd(p))),
    call2(Module.add(N), snd(fst(p)), snd(snd(p))))
requires moduleM : Module(M, R)
requires moduleN : Module(N, R)
proof
  sorry

defgraph productModuleNeg (M R N : Set)
    (p ∈ Module.carrier(M) × Module.carrier(N)) :
    Module.carrier(M) × Module.carrier(N) :=
  (apply(Module.neg(M), fst(p)), apply(Module.neg(N), snd(p)))
requires moduleM : Module(M, R)
requires moduleN : Module(N, R)
proof
  sorry

defgraph productModuleSmul (M R N : Set)
    (p ∈ Ring.carrier(R) × (Module.carrier(M) × Module.carrier(N))) :
    Module.carrier(M) × Module.carrier(N) :=
  (call2(Module.smul(M), fst(p), fst(snd(p))),
    call2(Module.smul(N), fst(p), snd(snd(p))))
requires moduleM : Module(M, R)
requires moduleN : Module(N, R)
proof
  sorry

-- The projections of a product of two sets.
def firstProjection (A B : Set) : Set :=
  { p ∈ (A × B) × A | ∃ x ∈ A, ∃ y ∈ B, p = ((x, y), x) }

def secondProjection (A B : Set) : Set :=
  { p ∈ (A × B) × B | ∃ x ∈ A, ∃ y ∈ B, p = ((x, y), y) }

def productModule (M R N : Set) : Set :=
  Module.mk(Module.carrier(M) × Module.carrier(N), productModuleAdd(M, R, N),
    (Module.zero(M), Module.zero(N)), productModuleNeg(M, R, N),
    productModuleSmul(M, R, N))

-- The module of functions I → M with the pointwise operations; for M the
-- ring itself (selfModule(R)) this is Rᴵ, Mathlib's ι → R. The pointwise
-- sum, negation, and multiple of functions into M are graphs on I.
def pointwiseSum (I M u v : Set) : Set :=
  { q ∈ I × Module.carrier(M) |
    ∃ i ∈ I, q = (i, call2(Module.add(M), u(i), v(i))) }

def pointwiseNeg (I M u : Set) : Set :=
  { q ∈ I × Module.carrier(M) | ∃ i ∈ I, q = (i, apply(Module.neg(M), u(i))) }

def pointwiseSmul (I M r u : Set) : Set :=
  { q ∈ I × Module.carrier(M) |
    ∃ i ∈ I, q = (i, call2(Module.smul(M), r, u(i))) }

defgraph functionModuleAdd (R I M : Set)
    (p ∈ functionSpace(I, Module.carrier(M)) ×
      functionSpace(I, Module.carrier(M))) :
    functionSpace(I, Module.carrier(M)) :=
  pointwiseSum(I, M, fst(p), snd(p))
requires module : Module(M, R)
proof
  sorry

defgraph functionModuleNeg (R I M : Set)
    (u ∈ functionSpace(I, Module.carrier(M))) :
    functionSpace(I, Module.carrier(M)) :=
  pointwiseNeg(I, M, u)
requires module : Module(M, R)
proof
  sorry

defgraph functionModuleSmul (R I M : Set)
    (p ∈ Ring.carrier(R) × functionSpace(I, Module.carrier(M))) :
    functionSpace(I, Module.carrier(M)) :=
  pointwiseSmul(I, M, fst(p), snd(p))
requires module : Module(M, R)
proof
  sorry

def functionModule (R I M : Set) : Set :=
  Module.mk(functionSpace(I, Module.carrier(M)), functionModuleAdd(R, I, M),
    constantFunction(I, Module.carrier(M), Module.zero(M)),
    functionModuleNeg(R, I, M), functionModuleSmul(R, I, M))

-- Rᴵ, the functions I → R.
def coordinateModule (R I : Set) : Set := functionModule(R, I, selfModule(R))

-- Precomposition with g : J → I, the linear map Mᴵ → Mᴶ, u ↦ u ∘ g.
-- Mathlib's LinearMap.funLeft.
def precompose (I J M g : Set) : Set :=
  { p ∈ functionSpace(I, Module.carrier(M)) × functionSpace(J, Module.carrier(M)) |
    ∃ u ∈ functionSpace(I, Module.carrier(M)),
      p = (u, compose(u, g, J, I, Module.carrier(M))) }

-- Evaluation at i ∈ I, the linear map Mᴵ → M (Mathlib's LinearMap.proj).
def evaluationMap (I M i : Set) : Set :=
  { p ∈ functionSpace(I, Module.carrier(M)) × Module.carrier(M) |
    ∃ u ∈ functionSpace(I, Module.carrier(M)), p = (u, u(i)) }

-- Section: Linear maps as a module and the endomorphism ring
-- The set of linear maps M → N, with the pointwise operations a module
-- over a commutative ring; the endomorphisms with composition form a
-- ring, Mathlib's Module.End.
def linearMaps (M R N : Set) : Set :=
  { f ∈ functionSpace(Module.carrier(M), Module.carrier(N)) |
    LinearMap(f, M, R, N) }

defgraph linearMapAdd (M R N : Set)
    (p ∈ linearMaps(M, R, N) × linearMaps(M, R, N)) : linearMaps(M, R, N) :=
  pointwiseSum(Module.carrier(M), N, fst(p), snd(p))
requires ring : CommRing(R)
requires moduleM : Module(M, R)
requires moduleN : Module(N, R)
proof
  sorry

defgraph linearMapNeg (M R N : Set) (f ∈ linearMaps(M, R, N)) :
    linearMaps(M, R, N) :=
  pointwiseNeg(Module.carrier(M), N, f)
requires ring : CommRing(R)
requires moduleM : Module(M, R)
requires moduleN : Module(N, R)
proof
  sorry

defgraph linearMapSmul (M R N : Set)
    (p ∈ Ring.carrier(R) × linearMaps(M, R, N)) : linearMaps(M, R, N) :=
  pointwiseSmul(Module.carrier(M), N, fst(p), snd(p))
requires ring : CommRing(R)
requires moduleM : Module(M, R)
requires moduleN : Module(N, R)
proof
  sorry

def homModule (M R N : Set) : Set :=
  Module.mk(linearMaps(M, R, N), linearMapAdd(M, R, N),
    constantFunction(Module.carrier(M), Module.carrier(N), Module.zero(N)),
    linearMapNeg(M, R, N), linearMapSmul(M, R, N))

defgraph linearMapCompose (M R : Set)
    (p ∈ linearMaps(M, R, M) × linearMaps(M, R, M)) : linearMaps(M, R, M) :=
  compose(fst(p), snd(p), Module.carrier(M), Module.carrier(M),
    Module.carrier(M))
requires module : Module(M, R)
proof
  sorry

-- End(M) = Ring.mk(linear maps, +, 0, −, ∘, id): the product f * g is the
-- composite f ∘ g.
def endomorphismRing (M R : Set) : Set :=
  Ring.mk(linearMaps(M, R, M), linearMapAdd(M, R, M),
    constantFunction(Module.carrier(M), Module.carrier(M), Module.zero(M)),
    linearMapNeg(M, R, M), linearMapCompose(M, R),
    identity(Module.carrier(M)))

-- Section: Laws of linear maps
section LinearMapLaws
variable (R M N f : Set)
hypothesis ring : Ring(R)
hypothesis moduleM : Module(M, R)
hypothesis moduleN : Module(N, R)
hypothesis linear : LinearMap(f, M, R, N)

theorem LinearMap.function
  shows f : M.carrier → N.carrier
proof
  sorry

theorem LinearMap.map_add (v w : M)
  shows f(v + w) = f(v) + f(w)
proof
  sorry

theorem LinearMap.map_smul (r : R) (v : M)
  shows f(r • v) = r • f(v)
proof
  sorry

theorem LinearMap.map_zero
  shows f(M.zero) = N.zero
proof
  sorry

theorem LinearMap.map_neg (v : M)
  shows f(-v) = -f(v)
proof
  sorry

theorem LinearMap.map_sum (V w : Set)
  requires finite : Finite(V)
  requires values : w : V → M.carrier
  shows f(moduleSum(M, V, w)) =
    moduleSum(N, V, compose(f, w, V, M.carrier, N.carrier))
proof
  sorry

theorem LinearMap.map_combination (V c v : Set)
  requires finite : Finite(V)
  requires coefficients : c : V → R.carrier
  requires vectors : v : V → M.carrier
  shows f(moduleCombination(M, R, V, c, v)) =
    moduleCombination(N, R, V, c, compose(f, v, V, M.carrier, N.carrier))
proof
  sorry

theorem LinearMap.kernel_submodule
  shows SubmoduleOf(linearKernel(f, M, N), M, R)
proof
  sorry

theorem LinearMap.range_submodule
  shows SubmoduleOf(linearRange(f, M, N), N, R)
proof
  sorry

-- LinearMap.ker_eq_bot.
theorem LinearMap.injective_iff_kernel
  shows InjectiveBetween(f, M.carrier, N.carrier) ↔
    linearKernel(f, M, N) = {M.zero}
proof
  sorry

-- LinearMap.range_eq_top.
theorem LinearMap.surjective_iff_range
  shows SurjectiveBetween(f, M.carrier, N.carrier) ↔
    linearRange(f, M, N) = N.carrier
proof
  sorry

theorem LinearMap.image_submodule (P : Set)
  requires sub : SubmoduleOf(P, M, R)
  shows SubmoduleOf(submoduleImage(f, M, N, P), N, R)
proof
  sorry

theorem LinearMap.preimage_submodule (Q : Set)
  requires sub : SubmoduleOf(Q, N, R)
  shows SubmoduleOf(submodulePreimage(f, M, Q), M, R)
proof
  sorry

-- Submodule.map_span: the image of a span is the span of the image.
theorem LinearMap.image_span (S : Set)
  requires subset : S ⊆ M.carrier
  shows submoduleImage(f, M, N, moduleSpan(M, R, S)) =
    moduleSpan(N, R, functionImage(f, S, N.carrier))
proof
  sorry

-- LinearMap.ext_on: linear maps agreeing on a spanning set are equal.
theorem LinearMap.ext_on_span (g S : Set)
  requires other : LinearMap(g, M, R, N)
  requires spans : moduleSpan(M, R, S) = M.carrier
  requires agree : ∀ v ∈ S, f(v) = g(v)
  shows f = g
proof
  sorry

-- The first isomorphism theorem: M ⧸ ker f ≅ range f.
theorem LinearMap.quotient_kernel_equiv
  shows LinearEquiv(quotientLift(f, M, linearKernel(f, M, N), N),
    quotientModule(M, R, linearKernel(f, M, N)), R,
    submoduleModule(N, R, linearRange(f, M, N)))
proof
  sorry

end LinearMapLaws

-- LinearMap.ext.
theorem LinearMap.ext (f g M R N : Set)
  requires first : LinearMap(f, M, R, N)
  requires second : LinearMap(g, M, R, N)
  requires agree : ∀ v ∈ Module.carrier(M), f(v) = g(v)
  shows f = g
proof
  sorry

theorem LinearMap.source_module (f M R N : Set)
  requires linear : LinearMap(f, M, R, N)
  shows Module(M, R)
proof
  sorry

theorem LinearMap.target_module (f M R N : Set)
  requires linear : LinearMap(f, M, R, N)
  shows Module(N, R)
proof
  sorry

-- LinearMap.id.
theorem LinearMap.identity (M R : Set)
  requires module : Module(M, R)
  shows LinearMap(identity(Module.carrier(M)), M, R, M)
proof
  sorry

theorem LinearMap.compose (f g M R N P : Set)
  requires first : LinearMap(f, M, R, N)
  requires second : LinearMap(g, N, R, P)
  shows LinearMap(compose(g, f, Module.carrier(M), Module.carrier(N),
    Module.carrier(P)), M, R, P)
proof
  sorry

theorem LinearEquiv.inverse (f M R N : Set)
  requires equiv : LinearEquiv(f, M, R, N)
  shows LinearEquiv(converse(f, Module.carrier(M), Module.carrier(N)), N, R, M)
proof
  sorry

-- LinearEquiv.ofBijective.
theorem LinearEquiv.of_bijective (f M R N : Set)
  requires linear : LinearMap(f, M, R, N)
  requires bijective : BijectiveBetween(f, Module.carrier(M), Module.carrier(N))
  shows LinearEquiv(f, M, R, N)
proof
  sorry

theorem LinearEquiv.compose (f g M R N P : Set)
  requires first : LinearEquiv(f, M, R, N)
  requires second : LinearEquiv(g, N, R, P)
  shows LinearEquiv(compose(g, f, Module.carrier(M), Module.carrier(N),
    Module.carrier(P)), M, R, P)
proof
  sorry

theorem LinearEquiv.identity (M R : Set)
  requires module : Module(M, R)
  shows LinearEquiv(identity(Module.carrier(M)), M, R, M)
proof
  sorry

-- Section: Laws of submodules and quotients
section SubmoduleLaws
variable (R M N : Set)
hypothesis ring : Ring(R)
hypothesis module : Module(M, R)
hypothesis sub : SubmoduleOf(N, M, R)

theorem SubmoduleOf.subset
  shows N ⊆ M.carrier
proof
  sorry

theorem SubmoduleOf.zero_mem
  shows M.zero ∈ N
proof
  sorry

theorem SubmoduleOf.add_mem (v w : Set)
  requires first : v ∈ N
  requires second : w ∈ N
  shows call2(M.add, v, w) ∈ N
proof
  sorry

-- Submodule.smul_mem.
theorem SubmoduleOf.smul_mem (r v : Set)
  requires scalar : r ∈ R.carrier
  requires member : v ∈ N
  shows call2(M.smul, r, v) ∈ N
proof
  sorry

theorem SubmoduleOf.neg_mem (v : Set)
  requires member : v ∈ N
  shows apply(M.neg, v) ∈ N
proof
  sorry

-- Submodule.sub_mem_iff_left: for y ∈ N, x − y ∈ N iff x ∈ N.
theorem SubmoduleOf.sub_mem_iff_left (x y : Set)
  requires vector : x ∈ M.carrier
  requires member : y ∈ N
  shows call2(M.add, x, apply(M.neg, y)) ∈ N ↔ x ∈ N
proof
  sorry

-- Submodule.sum_mem and Submodule.sum_smul_mem.
theorem SubmoduleOf.sum_mem (V w : Set)
  requires finite : Finite(V)
  requires values : w : V → N
  shows moduleSum(M, V, w) ∈ N
proof
  sorry

theorem SubmoduleOf.combination_mem (V c v : Set)
  requires finite : Finite(V)
  requires coefficients : c : V → R.carrier
  requires vectors : v : V → N
  shows moduleCombination(M, R, V, c, v) ∈ N
proof
  sorry

theorem SubmoduleOf.submodule_module
  shows Module(submoduleModule(M, R, N), R)
proof
  sorry

-- Submodule.subtype: the inclusion N → M is linear.
theorem SubmoduleOf.inclusion_linear
  shows LinearMap(identity(N), submoduleModule(M, R, N), R, M)
proof
  sorry

theorem SubmoduleOf.quotient_module
  shows Module(quotientModule(M, R, N), R)
proof
  sorry

-- Submodule.mkQ.
theorem SubmoduleOf.quotient_map_linear
  shows LinearMap(quotientModuleMap(M, N), M, R, quotientModule(M, R, N))
proof
  sorry

-- Submodule.Quotient.eq: [x] = [y] iff x − y ∈ N.
theorem SubmoduleOf.quotient_eq (x y : Set)
  requires first : x ∈ M.carrier
  requires second : y ∈ M.carrier
  shows quotientModuleMap(M, N)(x) = quotientModuleMap(M, N)(y) ↔
    call2(M.add, x, apply(M.neg, y)) ∈ N
proof
  sorry

-- Submodule.ker_mkQ.
theorem SubmoduleOf.quotient_kernel
  shows linearKernel(quotientModuleMap(M, N), M, quotientModule(M, R, N)) = N
proof
  sorry

theorem SubmoduleOf.quotient_map_surjective
  shows SurjectiveBetween(quotientModuleMap(M, N), M.carrier,
    Module.carrier(quotientModule(M, R, N)))
proof
  sorry

-- Submodule.liftQ: a linear map vanishing on N factors through M ⧸ N.
theorem SubmoduleOf.quotient_lift (f P : Set)
  requires linear : LinearMap(f, M, R, P)
  requires vanishes : N ⊆ linearKernel(f, M, P)
  shows LinearMap(quotientLift(f, M, N, P), quotientModule(M, R, N), R, P) ∧
    (∀ v ∈ M.carrier,
      quotientLift(f, M, N, P)(quotientModuleMap(M, N)(v)) = f(v))
proof
  sorry

end SubmoduleLaws

section SpanLaws
variable (R M : Set)
hypothesis ring : Ring(R)
hypothesis module : Module(M, R)

theorem moduleSpan.submodule (S : Set)
  shows SubmoduleOf(moduleSpan(M, R, S), M, R)
proof
  sorry

-- Submodule.subset_span.
theorem moduleSpan.subset_span (S : Set)
  requires subset : S ⊆ M.carrier
  shows S ⊆ moduleSpan(M, R, S)
proof
  sorry

-- Submodule.span_le.
theorem moduleSpan.least (S N : Set)
  requires subset : S ⊆ M.carrier
  requires sub : SubmoduleOf(N, M, R)
  shows moduleSpan(M, R, S) ⊆ N ↔ S ⊆ N
proof
  sorry

-- Submodule.span_mono.
theorem moduleSpan.mono (S T : Set)
  requires subset : S ⊆ T
  shows moduleSpan(M, R, S) ⊆ moduleSpan(M, R, T)
proof
  sorry

theorem moduleSpan.of_submodule (N : Set)
  requires sub : SubmoduleOf(N, M, R)
  shows moduleSpan(M, R, N) = N
proof
  sorry

-- Submodule.mem_span_singleton: the span of {v} is {r • v}.
theorem moduleSpan.singleton (v : M)
  shows moduleSpan(M, R, {v}) =
    scalarMultiples(M, R, v)
proof
  sorry

-- Submodule.mem_span_set': the span of a set is the set of linear
-- combinations of its finite subsets.
theorem moduleSpan.combinations (S : Set)
  requires subset : S ⊆ M.carrier
  shows moduleSpan(M, R, S) = finiteCombinations(M, R, S)
proof
  sorry

-- Submodule.mem_span_range_iff_exists_fun: over a finite index set, the
-- span of the range of a family is the set of its linear combinations.
theorem moduleSpan.range_family (I v : Set)
  requires finite : Finite(I)
  requires family : v : I → M.carrier
  shows moduleSpan(M, R, functionImage(v, I, M.carrier)) =
    familyCombinations(M, R, I, v)
proof
  sorry

-- Submodule.span_induction: a set containing S and zero and closed under
-- sums and the action contains the span.
theorem moduleSpan.induction (S P : Set)
  requires base : S ⊆ P
  requires zeroIn : M.zero ∈ P
  requires addIn : ∀ v w ∈ P ∩ M.carrier, call2(M.add, v, w) ∈ P
  requires smulIn : ∀ r ∈ R.carrier, ∀ v ∈ P ∩ M.carrier, call2(M.smul, r, v) ∈ P
  shows moduleSpan(M, R, S) ⊆ P
proof
  sorry

theorem submoduleSum.submodule (N P : Set)
  requires first : SubmoduleOf(N, M, R)
  requires second : SubmoduleOf(P, M, R)
  shows SubmoduleOf(submoduleSum(M, N, P), M, R)
proof
  sorry

-- Submodule.mem_sup: N + P is the span of N ∪ P.
theorem submoduleSum.span_union (N P : Set)
  requires first : SubmoduleOf(N, M, R)
  requires second : SubmoduleOf(P, M, R)
  shows submoduleSum(M, N, P) = moduleSpan(M, R, N ∪ P)
proof
  sorry

theorem SubmoduleOf.intersection (N P : Set)
  requires first : SubmoduleOf(N, M, R)
  requires second : SubmoduleOf(P, M, R)
  shows SubmoduleOf(N ∩ P, M, R)
proof
  sorry

theorem SubmoduleOf.whole
  shows SubmoduleOf(M.carrier, M, R)
proof
  sorry

theorem SubmoduleOf.zero_submodule
  shows SubmoduleOf({M.zero}, M, R)
proof
  sorry

end SpanLaws

-- Section: Laws of finite sums
section SumLaws
variable (R M : Set)
hypothesis ring : Ring(R)
hypothesis module : Module(M, R)

theorem moduleSum.mem (V w : Set)
  requires finite : Finite(V)
  requires values : w : V → M.carrier
  shows moduleSum(M, V, w) ∈ M.carrier
proof
  sorry

theorem moduleSum.empty (w : Set)
  requires values : w : ∅ → M.carrier
  shows moduleSum(M, ∅, w) = M.zero
proof
  sorry

theorem moduleSum.singleton (x w : Set)
  requires values : w : {x} → M.carrier
  shows moduleSum(M, {x}, w) = w(x)
proof
  sorry

theorem moduleSum.insert (V w x : Set)
  requires finite : Finite(V)
  requires fresh : x ∉ V
  requires values : w : V ∪ {x} → M.carrier
  shows moduleSum(M, V ∪ {x}, w) = moduleSum(M, V, restrict(w, V)) + w(x)
proof
  sorry

theorem moduleSum.congr (V w u : Set)
  requires finite : Finite(V)
  requires first : w : V → M.carrier
  requires second : u : V → M.carrier
  requires agree : ∀ i ∈ V, w(i) = u(i)
  shows moduleSum(M, V, w) = moduleSum(M, V, u)
proof
  sorry

-- Finset.smul_sum.
theorem moduleSum.smul (V w r : Set)
  requires finite : Finite(V)
  requires values : w : V → M.carrier
  requires scalar : r ∈ R.carrier
  shows r • moduleSum(M, V, w) = moduleSum(M, V, pointwiseSmul(V, M, r, w))
proof
  sorry

-- Finset.sum_smul.
theorem moduleSum.sum_smul (V c v : Set)
  requires comm : CommRing(R)
  requires finite : Finite(V)
  requires coefficients : c : V → R.carrier
  requires vector : v ∈ M.carrier
  shows finiteRingSum(V, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, c) • v =
    moduleCombination(M, R, V, c, constantFunction(V, M.carrier, v))
proof
  sorry

theorem moduleSum.add (V w u : Set)
  requires finite : Finite(V)
  requires first : w : V → M.carrier
  requires second : u : V → M.carrier
  shows moduleSum(M, V, w) + moduleSum(M, V, u) =
    moduleSum(M, V, pointwiseSum(V, M, w, u))
proof
  sorry

theorem moduleSum.zero_terms (V : Set)
  requires finite : Finite(V)
  shows moduleSum(M, V, constantFunction(V, M.carrier, M.zero)) = M.zero
proof
  sorry

-- Reindexing along a bijection e : U → V (Finset.sum_bij).
theorem moduleSum.reindex (U V e w : Set)
  requires finite : Finite(V)
  requires bijective : BijectiveBetween(e, U, V)
  requires values : w : V → M.carrier
  shows moduleSum(M, U, compose(w, e, U, V, M.carrier)) = moduleSum(M, V, w)
proof
  sorry

-- The sum over a union of two disjoint finite sets.
theorem moduleSum.union (U V w : Set)
  requires finiteU : Finite(U)
  requires finiteV : Finite(V)
  requires disjoint : U ∩ V = ∅
  requires values : w : U ∪ V → M.carrier
  shows moduleSum(M, U ∪ V, w) =
    moduleSum(M, U, restrict(w, U)) + moduleSum(M, V, restrict(w, V))
proof
  sorry

-- Finset.sum_product and Finset.sum_comm: a sum over U × V is the
-- iterated sum.
theorem moduleSum.product (U V w : Set)
  requires finiteU : Finite(U)
  requires finiteV : Finite(V)
  requires values : w : U × V → M.carrier
  shows moduleSum(M, U × V, w) = moduleSum(M, U, familyRowSums(M, U, V, w))
proof
  sorry

-- Terms vanishing off a subset do not contribute.
theorem moduleSum.subset_support (U V w : Set)
  requires finite : Finite(V)
  requires subset : U ⊆ V
  requires values : w : V → M.carrier
  requires vanishing : ∀ i ∈ V, i ∉ U → w(i) = M.zero
  shows moduleSum(M, V, w) = moduleSum(M, U, restrict(w, U))
proof
  sorry

end SumLaws

-- Section: Products, function modules, and Hom
section Constructions
variable (R : Set)
hypothesis ring : Ring(R)

theorem productModule.module (M N : Set)
  requires moduleM : Module(M, R)
  requires moduleN : Module(N, R)
  shows Module(productModule(M, R, N), R)
proof
  sorry

theorem productModule.first_linear (M N : Set)
  requires moduleM : Module(M, R)
  requires moduleN : Module(N, R)
  shows LinearMap(firstProjection(M.carrier, N.carrier),
    productModule(M, R, N), R, M)
proof
  sorry

theorem productModule.second_linear (M N : Set)
  requires moduleM : Module(M, R)
  requires moduleN : Module(N, R)
  shows LinearMap(secondProjection(M.carrier, N.carrier),
    productModule(M, R, N), R, N)
proof
  sorry

theorem functionModule.module (I M : Set)
  requires module : Module(M, R)
  shows Module(functionModule(R, I, M), R)
proof
  sorry

theorem functionModule.add_apply (I M u v i : Set)
  requires module : Module(M, R)
  requires first : u ∈ functionSpace(I, M.carrier)
  requires second : v ∈ functionSpace(I, M.carrier)
  requires index : i ∈ I
  shows call2(Module.add(functionModule(R, I, M)), u, v)(i) =
    call2(M.add, u(i), v(i))
proof
  sorry

theorem functionModule.smul_apply (I M r u i : Set)
  requires module : Module(M, R)
  requires scalar : r ∈ R.carrier
  requires vector : u ∈ functionSpace(I, M.carrier)
  requires index : i ∈ I
  shows call2(Module.smul(functionModule(R, I, M)), r, u)(i) =
    call2(M.smul, r, u(i))
proof
  sorry

theorem functionModule.sum_apply (I M V w i : Set)
  requires module : Module(M, R)
  requires finite : Finite(V)
  requires values : w : V → functionSpace(I, M.carrier)
  requires index : i ∈ I
  shows moduleSum(functionModule(R, I, M), V, w)(i) = moduleSum(M, V,
    familyEvaluate(V, M.carrier, w, i))
proof
  sorry

theorem coordinateModule.module (I : Set)
  shows Module(coordinateModule(R, I), R)
proof
  sorry

-- LinearMap.funLeft is linear.
theorem precompose.linear (I J M g : Set)
  requires module : Module(M, R)
  requires map : g : J → I
  shows LinearMap(precompose(I, J, M, g), functionModule(R, I, M), R,
    functionModule(R, J, M))
proof
  sorry

theorem precompose.apply (I J M g u j : Set)
  requires map : g : J → I
  requires vector : u ∈ functionSpace(I, M.carrier)
  requires index : j ∈ J
  shows precompose(I, J, M, g)(u)(j) = u(g(j))
proof
  sorry

-- LinearMap.funLeft_injective_of_surjective and
-- LinearMap.funLeft_surjective_of_injective.
theorem precompose.injective_of_surjective (I J M g : Set)
  requires module : Module(M, R)
  requires surjective : SurjectiveBetween(g, J, I)
  shows InjectiveBetween(precompose(I, J, M, g), functionSpace(I, M.carrier),
    functionSpace(J, M.carrier))
proof
  sorry

theorem precompose.surjective_of_injective (I J M g : Set)
  requires module : Module(M, R)
  requires nonempty : M.carrier ≠ ∅
  requires injective : InjectiveBetween(g, J, I)
  shows SurjectiveBetween(precompose(I, J, M, g), functionSpace(I, M.carrier),
    functionSpace(J, M.carrier))
proof
  sorry

theorem precompose.compose (I J K M g h : Set)
  requires first : g : J → I
  requires second : h : K → J
  shows compose(precompose(J, K, M, h), precompose(I, J, M, g),
      functionSpace(I, M.carrier), functionSpace(J, M.carrier),
      functionSpace(K, M.carrier)) =
    precompose(I, K, M, compose(g, h, K, J, I))
proof
  sorry

-- LinearMap.proj.
theorem evaluationMap.linear (I M i : Set)
  requires module : Module(M, R)
  requires index : i ∈ I
  shows LinearMap(evaluationMap(I, M, i), functionModule(R, I, M), R, M)
proof
  sorry

-- LinearMap.pi: linear maps into a function module are the families of
-- linear maps into its coordinates.
theorem functionModule.linear_iff (I M N f : Set)
  requires moduleM : Module(M, R)
  requires moduleN : Module(N, R)
  requires map : f : N.carrier → functionSpace(I, M.carrier)
  shows LinearMap(f, N, R, functionModule(R, I, M)) ↔
    (∀ i ∈ I, LinearMap(compose(evaluationMap(I, M, i), f, N.carrier,
      functionSpace(I, M.carrier), M.carrier), N, R, M))
proof
  sorry

end Constructions

section HomModule
variable (R M N : Set)
hypothesis ring : CommRing(R)
hypothesis moduleM : Module(M, R)
hypothesis moduleN : Module(N, R)

theorem homModule.module
  shows Module(homModule(M, R, N), R)
proof
  sorry

-- LinearMap.add_apply and LinearMap.sum_apply.
theorem homModule.add_apply (f g v : Set)
  requires first : LinearMap(f, M, R, N)
  requires second : LinearMap(g, M, R, N)
  requires vector : v ∈ M.carrier
  shows call2(Module.add(homModule(M, R, N)), f, g)(v) =
    call2(N.add, f(v), g(v))
proof
  sorry

theorem homModule.smul_apply (r f v : Set)
  requires scalar : r ∈ R.carrier
  requires linear : LinearMap(f, M, R, N)
  requires vector : v ∈ M.carrier
  shows call2(Module.smul(homModule(M, R, N)), r, f)(v) =
    call2(N.smul, r, f(v))
proof
  sorry

theorem homModule.sum_apply (V w v : Set)
  requires finite : Finite(V)
  requires values : w : V → linearMaps(M, R, N)
  requires vector : v ∈ M.carrier
  shows moduleSum(homModule(M, R, N), V, w)(v) = moduleSum(N, V,
    familyEvaluate(V, N.carrier, w, v))
proof
  sorry

theorem endomorphismRing.ring
  shows Ring(endomorphismRing(M, R))
proof
  sorry

-- Module.End.mul_apply: the product of End(M) is composition.
theorem endomorphismRing.mul_apply (f g v : Set)
  requires first : LinearMap(f, M, R, M)
  requires second : LinearMap(g, M, R, M)
  requires vector : v ∈ M.carrier
  shows call2(Ring.mul(endomorphismRing(M, R)), f, g)(v) = f(g(v))
proof
  sorry

end HomModule

theorem endomorphismRing.one (M R : Set)
  shows Ring.one(endomorphismRing(M, R)) = identity(Module.carrier(M))
proof
  sorry
