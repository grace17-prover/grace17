-- Modules over a ring and linear maps: linear maps and linear
-- equivalences between bundled modules, identity and composite maps,
-- submodules, the span of a set, finite sums and linear combinations of
-- vectors, kernels and ranges, quotient modules, products of two modules,
-- the modules of functions from a set into a module, precomposition
-- (Mathlib's LinearMap.funLeft), and the module of linear maps with the
-- endomorphism ring.
-- Part of the GRH blueprint.
-- Planned home: Algebra/Module/Linear.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Linear.Modules
import Grace.Cumulus.Algebra.Module.Basic
import Grace.Cumulus.Algebra.Ring.FiniteSetSum
import Grace.Cumulus.Relation.QuotientOperations
import Grace.Cumulus.Cardinal.Counting

-- Section: Sums in an abelian group
-- The enumeration-independence of indexedRingSum (Cumulus's IndexedSum)
-- needs only the additive abelian group; these helpers redo it under
-- IsAbelianGroup, so that it applies to the vectors of a module.
section GroupSums
variable (A add zero neg : Set)
hypothesis group : IsAbelianGroup(A, add, zero, neg)

theorem GroupSums.monoid
  shows IsMonoid(A, add, zero)
proof
  have ordinary := IsAbelianGroup.group with group
  exact IsGroup.monoid with ordinary

theorem GroupSums.zero_mem
  shows zero ∈ A
proof
  have monoid := GroupSums.monoid with *
  exact IsMonoid.unit_in_carrier with monoid

theorem GroupSums.add_mem (x y : Set)
  requires xIn : x ∈ A
  requires yIn : y ∈ A
  shows call2(add, x, y) ∈ A
proof
  have monoid := GroupSums.monoid with *
  exact IsMonoid.closed with monoid, xIn, yIn

theorem GroupSums.zero_add (x : Set)
  requires xIn : x ∈ A
  shows call2(add, zero, x) = x
proof
  have monoid := GroupSums.monoid with *
  exact IsMonoid.left_identity with monoid, xIn

theorem GroupSums.add_zero (x : Set)
  requires xIn : x ∈ A
  shows call2(add, x, zero) = x
proof
  have monoid := GroupSums.monoid with *
  exact IsMonoid.right_identity with monoid, xIn

theorem indexedRingSum.group_closed (w f : Set, n : Nat)
  shows WeightedValues(w, f, A, n) → indexedRingSum(w, f, add, zero, n) ∈ A
proof
  induction n
  | zero =>
    intro values
    rw indexedRingSum
    exact GroupSums.zero_mem with group
  | succ(k) using ih =>
    intro values
    have prefix := WeightedValues.prefix at w, f, A, k with *
    have last := WeightedValues.last at w, f, A, k with *
    have previous := ih with prefix
    rw indexedRingSum
    exact GroupSums.add_mem with group, previous, last

theorem matchingRingRow.group_closed (w f x : Set, n : Nat)
  requires value : w(x) ∈ A
  shows matchingRingRow(A, zero, add, w, f, x, n) ∈ A
proof
  induction n
  | zero =>
    have zeroIn := GroupSums.zero_mem with group
    rwa matchingRingRow
  | succ(k) using ih =>
    have zeroIn := GroupSums.zero_mem with group
    have last := singleValue.closed at A, zero, w(x), x, f(k) with *
    rw matchingRingRow
    exact GroupSums.add_mem with group, ih, last

theorem matchingRingTotal.group_closed (w f g : Set, n m : Nat)
  shows WeightedValues(w, g, A, m) →
    matchingRingTotal(A, zero, add, w, f, g, n, m) ∈ A
proof
  induction m
  | zero =>
    intro values
    rw matchingRingTotal
    exact GroupSums.zero_mem with group
  | succ(k) using ih =>
    intro values
    have prefix := WeightedValues.prefix at w, g, A, k with *
    have last := WeightedValues.last at w, g, A, k with *
    have previous := ih with prefix
    have row := matchingRingRow.group_closed at A, add, zero, neg, w, f, g(k), n with *
    rw matchingRingTotal
    exact GroupSums.add_mem with group, previous, row

theorem matchingRingRow.group_absent (w f x : Set, n : Nat)
  requires value : w(x) ∈ A
  shows (∀ i ∈ n, f(i) ≠ x) → matchingRingRow(A, zero, add, w, f, x, n) = zero
proof
  induction n
  | zero =>
    intro absent
    rw matchingRingRow
    rfl
  | succ(k) using ih =>
    have zeroIn := GroupSums.zero_mem with group
    intro absent
    have prefix : ∀ i ∈ k, f(i) ≠ x
      intros i before
      have included := membership.into_successor at i, k with *
      exact absent with i, included
    have last := absent with k, membership.self_successor at k with *
    have previous := ih with prefix
    have entry := singleValue.other at A, zero, w(x), x, f(k) with *
    rw [matchingRingRow, previous, entry]
    exact GroupSums.zero_add with group, zeroIn

theorem matchingRingRow.group_unique (w f x : Set, n : Nat)
  requires value : w(x) ∈ A
  shows DistinctValues(f, n) → Occurs(f, n, x) →
    matchingRingRow(A, zero, add, w, f, x, n) = w(x)
proof
  induction n
  | zero =>
    intros distinct occurs
    rcases occurs with ⟨i, impossible, same⟩
    exfalso
    simp [nat.zero, set.empty]
  | succ(k) using ih =>
    have zeroIn := GroupSums.zero_mem with group
    intros distinct occurs
    have alternatives : f(k) = x ∨ f(k) ≠ x by tauto
    cases alternatives with last | other
    . have fresh := DistinctValues.last_fresh at f, k with *
      have absent : ∀ i ∈ k, f(i) ≠ x
        intros i before equal
        have different := fresh with i, before
        rw ← last at equal
        exact different with equal
      have previous := matchingRingRow.group_absent at A, add, zero, neg, w, f, x, k with *
      have entry := singleValue.same at A, zero, w(x), x, f(k) with *
      rw [matchingRingRow, previous, entry]
      exact GroupSums.zero_add with group, value
    . obtain ⟨position, before, equal⟩ := Occurs.forward at f, succ(k), x with occurs
      have shape := membership.successor_forward{n := k} with before
      have earlier : position ∈ k
        cases shape with inside | atLast
        . exact inside
        . exfalso
          rw atLast at equal
          exact other with equal
      have prefix := DistinctValues.prefix at f, k with *
      have occurrence : Occurs(f, k, x)
        unfold Occurs
        refine ⟨position, earlier, equal⟩
      have previous := ih with prefix, occurrence
      have entry := singleValue.other at A, zero, w(x), x, f(k) with *
      rw [matchingRingRow, previous, entry]
      exact GroupSums.add_zero with group, value

theorem matchingRingWeight.group_symmetric (w x y : Set)
  requires xValue : w(x) ∈ A
  requires yValue : w(y) ∈ A
  shows singleValue(A, zero, w(x), x, y) = singleValue(A, zero, w(y), y, x)
proof
  have zeroIn := GroupSums.zero_mem with group
  have alternatives : x = y ∨ x ≠ y by tauto
  cases alternatives with same | different
  . rw same
    rfl
  . have reverse : y ≠ x
      intro equal
      have impossible : x = y by cc
      exact different with impossible
    have left := singleValue.other at A, zero, w(x), x, y with *
    have right := singleValue.other at A, zero, w(y), y, x with *
    cc

theorem matchingRingTotal.group_empty_left (w f g : Set, m : Nat)
  shows matchingRingTotal(A, zero, add, w, f, g, (0:Nat), m) = zero
proof
  induction m
  | zero =>
    rw matchingRingTotal
    rfl
  | succ(k) using ih =>
    have zeroIn := GroupSums.zero_mem with group
    rw [matchingRingTotal, matchingRingRow, ih]
    exact GroupSums.zero_add with group, zeroIn

theorem matchingRingTotal.group_extend_left (w f g : Set, n m : Nat)
  requires value : w(f(n)) ∈ A
  shows WeightedValues(w, g, A, m) →
    matchingRingTotal(A, zero, add, w, f, g, succ(n), m) =
    call2(add, matchingRingTotal(A, zero, add, w, f, g, n, m),
      matchingRingRow(A, zero, add, w, g, f(n), m))
proof
  induction m
  | zero =>
    have zeroIn := GroupSums.zero_mem with group
    intro values
    simp [matchingRingTotal, matchingRingRow]
    symm
    exact GroupSums.zero_add with group, zeroIn
  | succ(k) using ih =>
    have zeroIn := GroupSums.zero_mem with group
    intro values
    have prefix := WeightedValues.prefix at w, g, A, k with *
    have last := WeightedValues.last at w, g, A, k with *
    have previous := ih with prefix
    have symmetric := matchingRingWeight.group_symmetric at A, add, zero, neg, w, g(k), f(n) with *
    have totalBound := matchingRingTotal.group_closed at A, add, zero, neg, w, f, g, n, k with *
    have totalIn := totalBound with prefix
    have rowLeftIn := matchingRingRow.group_closed at A, add, zero, neg, w, g, f(n), k with *
    have rowRightIn := matchingRingRow.group_closed at A, add, zero, neg, w, f, g(k), n with *
    have entryIn := singleValue.closed at A, zero, w(f(n)), f(n), g(k) with *
    rw [matchingRingTotal, matchingRingTotal, matchingRingRow, matchingRingRow, previous, symmetric]
    exact IsAbelianGroup.four_shuffle with group, totalIn, rowLeftIn, rowRightIn, entryIn

theorem matchingRingTotal.group_transpose (w f g : Set, m n : Nat)
  requires valuesG : WeightedValues(w, g, A, m)
  shows WeightedValues(w, f, A, n) →
    matchingRingTotal(A, zero, add, w, f, g, n, m) =
    matchingRingTotal(A, zero, add, w, g, f, m, n)
proof
  induction n
  | zero =>
    intro valuesF
    have empty := matchingRingTotal.group_empty_left at A, add, zero, neg, w, f, g, m with *
    rw [empty, matchingRingTotal]
    rfl
  | succ(k) using ih =>
    intro valuesF
    have prefix := WeightedValues.prefix at w, f, A, k with *
    have last := WeightedValues.last at w, f, A, k with *
    have previous := ih with prefix
    have extended := matchingRingTotal.group_extend_left at A, add, zero, neg, w, f, g, k, m with *
    rw [extended, matchingRingTotal, previous]
    rfl

theorem matchingRingTotal.group_sum (w f g : Set, n m : Nat)
  requires distinct : DistinctValues(f, n)
  shows WeightedValues(w, g, A, m) → (∀ j ∈ m, Occurs(f, n, g(j))) →
    matchingRingTotal(A, zero, add, w, f, g, n, m) =
    indexedRingSum(w, g, add, zero, m)
proof
  induction m
  | zero =>
    intros values covered
    simp [matchingRingTotal, indexedRingSum]
  | succ(k) using ih =>
    intros values covered
    have prefix : ∀ j ∈ k, Occurs(f, n, g(j))
      intros j before
      have included := membership.into_successor at j, k with *
      exact covered with j, included
    have last := covered with k, membership.self_successor at k with *
    have valuePrefix := WeightedValues.prefix at w, g, A, k with *
    have valueLast := WeightedValues.last at w, g, A, k with *
    have row := matchingRingRow.group_unique at A, add, zero, neg, w, f, g(k), n with *
    have previous := ih with valuePrefix, prefix
    rw [matchingRingTotal, indexedRingSum, previous, row]
    rfl

theorem indexedRingSum.group_same_entries (w f g : Set, n m : Nat)
  requires valuesF : WeightedValues(w, f, A, n)
  requires valuesG : WeightedValues(w, g, A, m)
  requires distinctF : DistinctValues(f, n)
  requires distinctG : DistinctValues(g, m)
  requires coveredF : ∀ i ∈ n, Occurs(g, m, f(i))
  requires coveredG : ∀ j ∈ m, Occurs(f, n, g(j))
  shows indexedRingSum(w, f, add, zero, n) = indexedRingSum(w, g, add, zero, m)
proof
  have left := matchingRingTotal.group_sum at A, add, zero, neg, w, g, f, m, n with *
  have right := matchingRingTotal.group_sum at A, add, zero, neg, w, f, g, n, m with *
  have transpose := matchingRingTotal.group_transpose at A, add, zero, neg, w, f, g, m, n with *
  rw [← left, ← right]
  symm
  exact transpose with valuesF

theorem indexedRingSum.group_reindex (w V f g : Set, n m : Nat)
  requires weights : w : V → A
  requires enumerationF : BijectiveBetween(f, n, V)
  requires enumerationG : BijectiveBetween(g, m, V)
  shows indexedRingSum(w, f, add, zero, n) = indexedRingSum(w, g, add, zero, m)
proof
  have injF := Bijective.injective with enumerationF
  have injG := Bijective.injective with enumerationG
  have surjF := Bijective.surjective with enumerationF
  have surjG := Bijective.surjective with enumerationG
  have fnF := Injective.function with injF
  have fnG := Injective.function with injG
  have distinctF := Injective.distinct_values with injF
  have distinctG := Injective.distinct_values with injG
  have valuesF : WeightedValues(w, f, A, n)
    intros i hi
    have member := FunctionBetween.apply_closed with *
    exact FunctionBetween.apply_closed with *
  have valuesG : WeightedValues(w, g, A, m)
    intros j hj
    have member := FunctionBetween.apply_closed with *
    exact FunctionBetween.apply_closed with *
  have coveredF : ∀ i ∈ n, Occurs(g, m, f(i))
    intros i hi
    have member := FunctionBetween.apply_closed with *
    exact Surjective.occurs with *
  have coveredG : ∀ j ∈ m, Occurs(f, n, g(j))
    intros j hj
    have member := FunctionBetween.apply_closed with *
    exact Surjective.occurs with *
  exact indexedRingSum.group_same_entries with *

end GroupSums

-- The additive group of a module, unbundled.
theorem Module.additive_parts (M : Set)
  requires group : AbelianGroup(Module.additive(M))
  shows IsAbelianGroup(Module.carrier(M), Module.add(M), Module.zero(M),
    Module.neg(M))
proof
  have parts := AbelianGroup.parts with group
  module_additive at parts
  exact parts

-- The coordinates of a member of a product.
theorem product.member_parts (q A B : Set)
  requires member : q ∈ A × B
  shows fst(q) ∈ A ∧ snd(q) ∈ B
proof
  obtain ⟨bound, x, hx, y, hy, shape⟩ := product.membership.forward with member
  rw [shape, fst.pair, snd.pair]
  exact ⟨hx, hy⟩

-- A function restricted to its whole domain.
theorem restrict.self (w A B : Set)
  requires function : w : A → B
  shows restrict(w, A) = w
proof
  have refl : A ⊆ A
    intros y hy
    exact hy
  have restricted := restrict.domain_function at w, A, B, A with function, refl
  apply FunctionBetween.ext with restricted, function
  intros x hx
  exact restrict.domain_apply at w, A, B, A, x with function, refl, hx

-- Injectivity and surjectivity read through application.
theorem Injective.apply_cancel (f A B x y : Set)
  requires injective : InjectiveBetween(f, A, B)
  requires hx : x ∈ A
  requires hy : y ∈ A
  requires same : f(x) = f(y)
  shows x = y
proof
  have function := Injective.function with injective
  have fx := FunctionBetween.apply_closed with function, hx
  have rx := FunctionBetween.relates_apply with function, hx
  have ry := FunctionBetween.relates_apply with function, hy
  rw ← same at ry
  exact Injective.cancel with injective, hx, hy, fx, rx, ry

theorem Surjective.of_pointwise (f A B : Set)
  requires function : f : A → B
  requires covers : ∀ y ∈ B, ∃ x ∈ A, f(x) = y
  shows SurjectiveBetween(f, A, B)
proof
  unfold SurjectiveBetween
  refine ⟨function, ?_⟩
  intros y hy
  obtain ⟨x, hx, value⟩ := covers with y, hy
  have mapped := FunctionBetween.relates_apply with function, hx
  rw value at mapped
  exact ⟨x, hx, mapped⟩

theorem Surjective.apply_exists (f A B y : Set)
  requires surjective : SurjectiveBetween(f, A, B)
  requires hy : y ∈ B
  shows ∃ x ∈ A, f(x) = y
proof
  obtain ⟨function, covers⟩ := surjective
  obtain ⟨x, hx, mapped⟩ := covers with y, hy
  have value := FunctionBetween.apply_value with function, hx, mapped
  exact ⟨x, hx, value⟩

-- Section: Linear maps
-- A module is Cumulus's bundled Module(M, R): the carrier M.carrier with
-- M.add, M.zero, M.neg and the action M.smul of the ring R. A linear map
-- f : M → N over R is a function between the carriers preserving sums and
-- the action; a linear equivalence is a bijective linear map. Mathlib's
-- LinearMap and LinearEquiv. The argument order LinearMap(f, M, R, N)
-- reads f : M →ₗ[R] N.
predicate LinearMap (f M R N : Set) :=
  Module(M, R) ∧ Module(N, R) ∧ (f : M.carrier → N.carrier) ∧
  (∀ v w ∈ M.carrier, f(call2(M.add, v, w)) = call2(N.add, f(v), f(w))) ∧
  (∀ r ∈ Ring.carrier(R), ∀ v ∈ M.carrier,
    f(call2(M.smul, r, v)) = call2(N.smul, r, f(v)))

predicate LinearEquiv (f M R N : Set) :=
  LinearMap(f, M, R, N) ∧ BijectiveBetween(f, M.carrier, N.carrier)

-- Two modules are isomorphic when a linear equivalence joins them.
predicate ModuleIsomorphic (M R N : Set) := ∃ f, LinearEquiv(f, M, R, N)

-- Section: Submodules and span
-- N is a submodule of M: a subset containing zero and closed under sums
-- and the action (closure under negation follows, by (−1) • v).
predicate SubmoduleOf (N M R : Set) :=
  Module(M, R) ∧ N ⊆ M.carrier ∧ M.zero ∈ N ∧
  (∀ v w ∈ N, call2(M.add, v, w) ∈ N) ∧
  (∀ r ∈ Ring.carrier(R), ∀ v ∈ N, call2(M.smul, r, v) ∈ N)

-- A submodule with the operations of M restricted to it, as a module.
def submoduleModule (M R N : Set) : Set :=
  Module.mk(N, restrict(Module.add(M), N × N), Module.zero(M),
    restrict(Module.neg(M), N), restrict(Module.smul(M), Ring.carrier(R) × N))

-- The span of S ⊆ M: the least submodule containing S, as the
-- intersection of the submodules containing it (choice-free). Mathlib's
-- Submodule.span.
def moduleSpan (M R S : Set) : Set :=
  { v ∈ Module.carrier(M) | ∀ N, SubmoduleOf(N, M, R) → S ⊆ N → v ∈ N }

-- The sum N + P of two submodules.
def submoduleSum (M N P : Set) : Set :=
  { v ∈ Module.carrier(M) | ∃ x ∈ N, ∃ y ∈ P, v = call2(Module.add(M), x, y) }

-- Section: Finite sums and linear combinations
-- The sum of the vectors w(i), i ∈ V, over a finite set V, independent of
-- the order of summation. Mathlib's Finset.sum in a module.
defunique moduleSum (M V w : Set) (s ∈ Module.carrier(M)) :=
  ∃ n, Nat(n) ∧ ∃ f, BijectiveBetween(f, n, V) ∧
    s = indexedRingSum(w, f, Module.add(M), Module.zero(M), n)
requires group : AbelianGroup(Module.additive(M))
requires finite : Finite(V)
requires values : w : V → Module.carrier(M)
proof
  have parts := Module.additive_parts with group
  obtain ⟨n, natural, equivalent⟩ := finite
  obtain ⟨f, bijective⟩ := equivalent
  have enumeration := converse.bijective with bijective
  have function := converse.function_of_bijective with bijective
  have valuesIn := WeightedValues.of_functions with values, function
  have closure := indexedRingSum.group_closed at Module.carrier(M), Module.add(M), Module.zero(M), Module.neg(M), w, converse(f, V, n), n with *
  have sumIn := closure with valuesIn
  witness indexedRingSum(w, converse(f, V, n), Module.add(M), Module.zero(M), n)
  refine ⟨sumIn, n, natural, converse(f, V, n), enumeration, rfl⟩
uniqueness
  have parts := Module.additive_parts with group
  intros u uIn first v vIn second
  obtain ⟨n, naturalN, f, enumerationF, valueF⟩ := first
  obtain ⟨m, naturalM, g, enumerationG, valueG⟩ := second
  have same := indexedRingSum.group_reindex at Module.carrier(M), Module.add(M), Module.zero(M), Module.neg(M), w, V, f, g, n, m with *
  cc

-- The terms c(i) • v(i) of a linear combination, and the combination
-- Σ_{i ∈ V} c(i) • v(i) itself.
defgraph combinationTerms (M R V c v : Set) (i ∈ V) : Module.carrier(M) :=
    call2(Module.smul(M), c(i), v(i))
requires module : Module(M, R)
requires coefficients : c : V → Ring.carrier(R)
requires vectors : v : V → Module.carrier(M)
proof
  have cIn := FunctionBetween.apply_closed with coefficients, member
  have vIn := FunctionBetween.apply_closed with vectors, member
  exact Module.smul_mem with *

def moduleCombination (M R V c v : Set) : Set :=
  moduleSum(M, V, combinationTerms(M, R, V, c, v))

-- Families built from families: k ↦ w(k)(x), j ↦ w(i, j), and the row sums
-- i ↦ Σ_j w(i, j), as graphs on the index set.
def familyEvaluate (V X w x : Set) : Set :=
  { p ∈ V × X | ∃ k ∈ V, p = (k, w(k)(x)) }

def familySlice (V X w i : Set) : Set :=
  { q ∈ V × X | ∃ j ∈ V, q = (j, w((i, j))) }

def familyRowSums (M U V w : Set) : Set :=
  { p ∈ U × Module.carrier(M) |
    ∃ i ∈ U, p = (i, moduleSum(M, V, familySlice(V, Module.carrier(M), w, i))) }

-- The multiples r • v of one vector, the linear combinations of a finite
-- family, and the linear combinations of finite subsets of a set.
def scalarMultiples (M R v : Set) : Set :=
  { w ∈ Module.carrier(M) | ∃ r ∈ Ring.carrier(R),
    w = call2(Module.smul(M), r, v) }

def familyCombinations (M R I v : Set) : Set :=
  { w ∈ Module.carrier(M) | ∃ c, (c : I → Ring.carrier(R)) ∧
    w = moduleCombination(M, R, I, c, v) }

def finiteCombinations (M R S : Set) : Set :=
  { w ∈ Module.carrier(M) | ∃ V, V ⊆ S ∧ Finite(V) ∧
    (∃ c, (c : V → Ring.carrier(R)) ∧
      w = moduleCombination(M, R, V, c, identity(V))) }

-- Section: Kernel and range
-- The kernel {v | f(v) = 0} and the range {f(v)} of a linear map.
def linearKernel (f M N : Set) : Set :=
  { v ∈ Module.carrier(M) | f(v) = Module.zero(N) }

def linearRange (f M N : Set) : Set :=
  { w ∈ Module.carrier(N) | ∃ v ∈ Module.carrier(M), f(v) = w }

-- The image and the preimage of a submodule.
def submoduleImage (f M N P : Set) : Set :=
  { w ∈ Module.carrier(N) | ∃ v ∈ P, f(v) = w }

def submodulePreimage (f M Q : Set) : Set :=
  { v ∈ Module.carrier(M) | f(v) ∈ Q }

-- An exact pair M →f N →g P: the range of f is the kernel of g.
predicate ExactPair (f g M N P : Set) :=
  linearRange(f, M, N) = linearKernel(g, N, P)

-- Section: Quotient modules
-- Congruence modulo a submodule N, the quotient module M ⧸ N on the
-- classes, and the projection v ↦ [v]. The action on classes is the graph
-- {((r, [v]), [r • v])}, a function because N is a submodule. Mathlib's
-- Submodule.Quotient and Submodule.mkQ.
def submoduleRelation (M N : Set) : Set :=
  { p ∈ Module.carrier(M) × Module.carrier(M) |
    ∃ x ∈ Module.carrier(M), ∃ y ∈ Module.carrier(M),
      p = (x, y) ∧ call2(Module.add(M), x, apply(Module.neg(M), y)) ∈ N }

def quotientScalar (M R N : Set) : Set :=
  { q ∈ (Ring.carrier(R) × (Module.carrier(M) ⧸ submoduleRelation(M, N))) ×
      (Module.carrier(M) ⧸ submoduleRelation(M, N)) |
    ∃ r ∈ Ring.carrier(R), ∃ v ∈ Module.carrier(M),
      q = ((r, ⟦v⟧[Module.carrier(M), submoduleRelation(M, N)]),
        ⟦call2(Module.smul(M), r, v)⟧[Module.carrier(M), submoduleRelation(M, N)]) }

def quotientModule (M R N : Set) : Set :=
  Module.mk((Module.carrier(M) ⧸ submoduleRelation(M, N)),
    quotientBinary(Module.carrier(M), submoduleRelation(M, N), Module.add(M)),
    ⟦Module.zero(M)⟧[Module.carrier(M), submoduleRelation(M, N)],
    quotientUnary(Module.carrier(M), submoduleRelation(M, N), Module.neg(M)),
    quotientScalar(M, R, N))

def quotientModuleMap (M N : Set) : Set :=
  { p ∈ Module.carrier(M) × (Module.carrier(M) ⧸ submoduleRelation(M, N)) |
    ∃ v ∈ Module.carrier(M),
      p = (v, ⟦v⟧[Module.carrier(M), submoduleRelation(M, N)]) }

-- The map M ⧸ N → P induced by a linear map f vanishing on N: the graph
-- {([v], f(v))}. Mathlib's Submodule.liftQ.
def quotientLift (f M N P : Set) : Set :=
  { p ∈ (Module.carrier(M) ⧸ submoduleRelation(M, N)) × Module.carrier(P) |
    ∃ v ∈ Module.carrier(M),
      p = (⟦v⟧[Module.carrier(M), submoduleRelation(M, N)], f(v)) }

-- Section: Products and function modules
-- The product M × N with the componentwise operations.
defgraph productModuleAdd (M R N : Set)
    (p ∈ (Module.carrier(M) × Module.carrier(N)) ×
      (Module.carrier(M) × Module.carrier(N))) :
    Module.carrier(M) × Module.carrier(N) :=
  (call2(Module.add(M), fst(fst(p)), fst(snd(p))),
    call2(Module.add(N), snd(fst(p)), snd(snd(p))))
requires moduleM : Module(M, R)
requires moduleN : Module(N, R)
proof
  obtain ⟨left, right⟩ := product.member_parts with member
  obtain ⟨l1, l2⟩ := product.member_parts with left
  obtain ⟨r1, r2⟩ := product.member_parts with right
  have first := Module.add_mem at R, M, fst(fst(p)), fst(snd(p)) with *
  have second := Module.add_mem at R, N, snd(fst(p)), snd(snd(p)) with *
  exact product.pair with first, second

defgraph productModuleNeg (M R N : Set)
    (p ∈ Module.carrier(M) × Module.carrier(N)) :
    Module.carrier(M) × Module.carrier(N) :=
  (apply(Module.neg(M), fst(p)), apply(Module.neg(N), snd(p)))
requires moduleM : Module(M, R)
requires moduleN : Module(N, R)
proof
  obtain ⟨left, right⟩ := product.member_parts with member
  have first := Module.neg_mem at R, M, fst(p) with *
  have second := Module.neg_mem at R, N, snd(p) with *
  exact product.pair with first, second

defgraph productModuleSmul (M R N : Set)
    (p ∈ Ring.carrier(R) × (Module.carrier(M) × Module.carrier(N))) :
    Module.carrier(M) × Module.carrier(N) :=
  (call2(Module.smul(M), fst(p), fst(snd(p))),
    call2(Module.smul(N), fst(p), snd(snd(p))))
requires moduleM : Module(M, R)
requires moduleN : Module(N, R)
proof
  obtain ⟨left, right⟩ := product.member_parts with member
  obtain ⟨r1, r2⟩ := product.member_parts with right
  have first := Module.smul_mem at R, M, fst(p), fst(snd(p)) with *
  have second := Module.smul_mem at R, N, fst(p), snd(snd(p)) with *
  exact product.pair with first, second

-- The projections of a product of two sets.
def firstProjection (A B : Set) : Set :=
  { p ∈ (A × B) × A | ∃ x ∈ A, ∃ y ∈ B, p = ((x, y), x) }

def secondProjection (A B : Set) : Set :=
  { p ∈ (A × B) × B | ∃ x ∈ A, ∃ y ∈ B, p = ((x, y), y) }

def productModule (M R N : Set) : Set :=
  Module.mk(Module.carrier(M) × Module.carrier(N), productModuleAdd(M, R, N),
    (Module.zero(M), Module.zero(N)), productModuleNeg(M, R, N),
    productModuleSmul(M, R, N))

-- The module of functions I → M with the pointwise operations; for M the
-- ring itself (selfModule(R)) this is Rᴵ, Mathlib's ι → R. The pointwise
-- sum, negation, and multiple of functions into M are graphs on I.
def pointwiseSum (I M u v : Set) : Set :=
  { q ∈ I × Module.carrier(M) |
    ∃ i ∈ I, q = (i, call2(Module.add(M), u(i), v(i))) }

def pointwiseNeg (I M u : Set) : Set :=
  { q ∈ I × Module.carrier(M) | ∃ i ∈ I, q = (i, apply(Module.neg(M), u(i))) }

def pointwiseSmul (I M r u : Set) : Set :=
  { q ∈ I × Module.carrier(M) |
    ∃ i ∈ I, q = (i, call2(Module.smul(M), r, u(i))) }

-- Graph laws of the pointwise operations.
theorem pointwiseSum.relates (I M u v i : Set)
  requires index : i ∈ I
  requires valueIn : call2(Module.add(M), u(i), v(i)) ∈ Module.carrier(M)
  shows relates(pointwiseSum(I, M, u, v), i, call2(Module.add(M), u(i), v(i)))
proof
  unfold relates
  apply pointwiseSum.membership.backward
  refine ⟨(product.pair at i, call2(Module.add(M), u(i), v(i)), I, Module.carrier(M) with index, valueIn), i, index, rfl⟩

theorem pointwiseSum.function (I M u v : Set)
  requires values : ∀ i ∈ I, call2(Module.add(M), u(i), v(i)) ∈ Module.carrier(M)
  shows pointwiseSum(I, M, u, v) : I → Module.carrier(M)
proof
  constructor
    intros p member
    obtain ⟨bounded, witnesses⟩ := pointwiseSum.membership.forward with member
    exact bounded
  . constructor
      intros z0 first xFirst second xSecond
      unfold relates at xFirst
      obtain ⟨_, a1, a1In, firstShape⟩ := pointwiseSum.membership.forward with xFirst
      unfold relates at xSecond
      obtain ⟨_, a2, a2In, secondShape⟩ := pointwiseSum.membership.forward with xSecond
      obtain ⟨xi, firstEqual⟩ := orderedPair.injective with firstShape
      obtain ⟨xj, secondEqual⟩ := orderedPair.injective with secondShape
      rw [firstEqual, secondEqual]
      cc
    . intros i xIn
      have valueIn := values with i, xIn
      refine ⟨call2(Module.add(M), u(i), v(i)), valueIn, (pointwiseSum.relates at I, M, u, v, i with xIn, valueIn)⟩

theorem pointwiseSum.apply (I M u v i : Set)
  requires values : ∀ i ∈ I, call2(Module.add(M), u(i), v(i)) ∈ Module.carrier(M)
  requires index : i ∈ I
  shows pointwiseSum(I, M, u, v)(i) = call2(Module.add(M), u(i), v(i))
proof
  have function := pointwiseSum.function at I, M, u, v with values
  have valueIn := values with i, index
  have mapped := pointwiseSum.relates at I, M, u, v, i with index, valueIn
  exact FunctionBetween.apply_value with function, index, mapped

theorem pointwiseNeg.relates (I M u i : Set)
  requires index : i ∈ I
  requires valueIn : apply(Module.neg(M), u(i)) ∈ Module.carrier(M)
  shows relates(pointwiseNeg(I, M, u), i, apply(Module.neg(M), u(i)))
proof
  unfold relates
  apply pointwiseNeg.membership.backward
  refine ⟨(product.pair at i, apply(Module.neg(M), u(i)), I, Module.carrier(M) with index, valueIn), i, index, rfl⟩

theorem pointwiseNeg.function (I M u : Set)
  requires values : ∀ i ∈ I, apply(Module.neg(M), u(i)) ∈ Module.carrier(M)
  shows pointwiseNeg(I, M, u) : I → Module.carrier(M)
proof
  constructor
    intros p member
    obtain ⟨bounded, witnesses⟩ := pointwiseNeg.membership.forward with member
    exact bounded
  . constructor
      intros z0 first xFirst second xSecond
      unfold relates at xFirst
      obtain ⟨_, a1, a1In, firstShape⟩ := pointwiseNeg.membership.forward with xFirst
      unfold relates at xSecond
      obtain ⟨_, a2, a2In, secondShape⟩ := pointwiseNeg.membership.forward with xSecond
      obtain ⟨xi, firstEqual⟩ := orderedPair.injective with firstShape
      obtain ⟨xj, secondEqual⟩ := orderedPair.injective with secondShape
      rw [firstEqual, secondEqual]
      cc
    . intros i xIn
      have valueIn := values with i, xIn
      refine ⟨apply(Module.neg(M), u(i)), valueIn, (pointwiseNeg.relates at I, M, u, i with xIn, valueIn)⟩

theorem pointwiseNeg.apply (I M u i : Set)
  requires values : ∀ i ∈ I, apply(Module.neg(M), u(i)) ∈ Module.carrier(M)
  requires index : i ∈ I
  shows pointwiseNeg(I, M, u)(i) = apply(Module.neg(M), u(i))
proof
  have function := pointwiseNeg.function at I, M, u with values
  have valueIn := values with i, index
  have mapped := pointwiseNeg.relates at I, M, u, i with index, valueIn
  exact FunctionBetween.apply_value with function, index, mapped

theorem pointwiseSmul.relates (I M r u i : Set)
  requires index : i ∈ I
  requires valueIn : call2(Module.smul(M), r, u(i)) ∈ Module.carrier(M)
  shows relates(pointwiseSmul(I, M, r, u), i, call2(Module.smul(M), r, u(i)))
proof
  unfold relates
  apply pointwiseSmul.membership.backward
  refine ⟨(product.pair at i, call2(Module.smul(M), r, u(i)), I, Module.carrier(M) with index, valueIn), i, index, rfl⟩

theorem pointwiseSmul.function (I M r u : Set)
  requires values : ∀ i ∈ I, call2(Module.smul(M), r, u(i)) ∈ Module.carrier(M)
  shows pointwiseSmul(I, M, r, u) : I → Module.carrier(M)
proof
  constructor
    intros p member
    obtain ⟨bounded, witnesses⟩ := pointwiseSmul.membership.forward with member
    exact bounded
  . constructor
      intros z0 first xFirst second xSecond
      unfold relates at xFirst
      obtain ⟨_, a1, a1In, firstShape⟩ := pointwiseSmul.membership.forward with xFirst
      unfold relates at xSecond
      obtain ⟨_, a2, a2In, secondShape⟩ := pointwiseSmul.membership.forward with xSecond
      obtain ⟨xi, firstEqual⟩ := orderedPair.injective with firstShape
      obtain ⟨xj, secondEqual⟩ := orderedPair.injective with secondShape
      rw [firstEqual, secondEqual]
      cc
    . intros i xIn
      have valueIn := values with i, xIn
      refine ⟨call2(Module.smul(M), r, u(i)), valueIn, (pointwiseSmul.relates at I, M, r, u, i with xIn, valueIn)⟩

theorem pointwiseSmul.apply (I M r u i : Set)
  requires values : ∀ i ∈ I, call2(Module.smul(M), r, u(i)) ∈ Module.carrier(M)
  requires index : i ∈ I
  shows pointwiseSmul(I, M, r, u)(i) = call2(Module.smul(M), r, u(i))
proof
  have function := pointwiseSmul.function at I, M, r, u with values
  have valueIn := values with i, index
  have mapped := pointwiseSmul.relates at I, M, r, u, i with index, valueIn
  exact FunctionBetween.apply_value with function, index, mapped

theorem pointwiseSum.space (R I M u v : Set)
  requires module : Module(M, R)
  requires first : u ∈ functionSpace(I, Module.carrier(M))
  requires second : v ∈ functionSpace(I, Module.carrier(M))
  shows pointwiseSum(I, M, u, v) ∈ functionSpace(I, Module.carrier(M))
proof
  have uF := functionSpace.mem_iff.forward with first
  have vF := functionSpace.mem_iff.forward with second
  have values : ∀ i ∈ I, call2(Module.add(M), u(i), v(i)) ∈ Module.carrier(M)
    intros i hi
    have ui := FunctionBetween.apply_closed with uF, hi
    have vi := FunctionBetween.apply_closed with vF, hi
    exact Module.add_mem at R, M, u(i), v(i) with *
  have function := pointwiseSum.function at I, M, u, v with values
  exact functionSpace.mem_iff.backward with function

theorem pointwiseNeg.space (R I M u : Set)
  requires module : Module(M, R)
  requires first : u ∈ functionSpace(I, Module.carrier(M))
  shows pointwiseNeg(I, M, u) ∈ functionSpace(I, Module.carrier(M))
proof
  have uF := functionSpace.mem_iff.forward with first
  have values : ∀ i ∈ I, apply(Module.neg(M), u(i)) ∈ Module.carrier(M)
    intros i hi
    have ui := FunctionBetween.apply_closed with uF, hi
    exact Module.neg_mem at R, M, u(i) with *
  have function := pointwiseNeg.function at I, M, u with values
  exact functionSpace.mem_iff.backward with function

theorem pointwiseSmul.space (R I M r u : Set)
  requires module : Module(M, R)
  requires scalar : r ∈ Ring.carrier(R)
  requires first : u ∈ functionSpace(I, Module.carrier(M))
  shows pointwiseSmul(I, M, r, u) ∈ functionSpace(I, Module.carrier(M))
proof
  have uF := functionSpace.mem_iff.forward with first
  have values : ∀ i ∈ I, call2(Module.smul(M), r, u(i)) ∈ Module.carrier(M)
    intros i hi
    have ui := FunctionBetween.apply_closed with uF, hi
    exact Module.smul_mem at R, M, r, u(i) with *
  have function := pointwiseSmul.function at I, M, r, u with values
  exact functionSpace.mem_iff.backward with function

defgraph functionModuleAdd (R I M : Set)
    (p ∈ functionSpace(I, Module.carrier(M)) ×
      functionSpace(I, Module.carrier(M))) :
    functionSpace(I, Module.carrier(M)) :=
  pointwiseSum(I, M, fst(p), snd(p))
requires module : Module(M, R)
proof
  obtain ⟨left, right⟩ := product.member_parts with member
  exact pointwiseSum.space with module, left, right

defgraph functionModuleNeg (R I M : Set)
    (u ∈ functionSpace(I, Module.carrier(M))) :
    functionSpace(I, Module.carrier(M)) :=
  pointwiseNeg(I, M, u)
requires module : Module(M, R)
proof
  exact pointwiseNeg.space with module, member

defgraph functionModuleSmul (R I M : Set)
    (p ∈ Ring.carrier(R) × functionSpace(I, Module.carrier(M))) :
    functionSpace(I, Module.carrier(M)) :=
  pointwiseSmul(I, M, fst(p), snd(p))
requires module : Module(M, R)
proof
  obtain ⟨left, right⟩ := product.member_parts with member
  exact pointwiseSmul.space with module, left, right

def functionModule (R I M : Set) : Set :=
  Module.mk(functionSpace(I, Module.carrier(M)), functionModuleAdd(R, I, M),
    constantFunction(I, Module.carrier(M), Module.zero(M)),
    functionModuleNeg(R, I, M), functionModuleSmul(R, I, M))

-- Rᴵ, the functions I → R.
def coordinateModule (R I : Set) : Set := functionModule(R, I, selfModule(R))

-- Precomposition with g : J → I, the linear map Mᴵ → Mᴶ, u ↦ u ∘ g.
-- Mathlib's LinearMap.funLeft.
def precompose (I J M g : Set) : Set :=
  { p ∈ functionSpace(I, Module.carrier(M)) × functionSpace(J, Module.carrier(M)) |
    ∃ u ∈ functionSpace(I, Module.carrier(M)),
      p = (u, compose(u, g, J, I, Module.carrier(M))) }

-- Evaluation at i ∈ I, the linear map Mᴵ → M (Mathlib's LinearMap.proj).
def evaluationMap (I M i : Set) : Set :=
  { p ∈ functionSpace(I, Module.carrier(M)) × Module.carrier(M) |
    ∃ u ∈ functionSpace(I, Module.carrier(M)), p = (u, u(i)) }

-- Section: Linear maps as a module and the endomorphism ring
-- The set of linear maps M → N, with the pointwise operations a module
-- over a commutative ring; the endomorphisms with composition form a
-- ring, Mathlib's Module.End.
def linearMaps (M R N : Set) : Set :=
  { f ∈ functionSpace(Module.carrier(M), Module.carrier(N)) |
    LinearMap(f, M, R, N) }

-- Section: More laws of a module
-- Negation and cancellation in the additive group of a module, each a
-- group law applied to M.additive, and the action on negatives.
section ModuleToolkit
variable (R M : Set)
hypothesis ring : Ring(R)
hypothesis module : Module(M, R)

theorem Module.add_neg (v : M)
  shows v + -v = M.zero
proof
  have group := Module.additive_group with *
  have cancel := Group.mul_inv at M.additive, v with group, *
  module_additive at cancel
  exact cancel

theorem Module.neg_add_distrib (v w : M)
  shows -(v + w) = -v + -w
proof
  have abelian := Module.additive.abelian_group with module
  have law := mul_inv at M.additive, v, w with abelian, *
  module_additive at law
  exact law

theorem Module.eq_neg_of_add_eq_zero (v w : M)
  requires equal : v + w = M.zero
  shows v = -w
proof
  have s1 := Module.add_neg at R, M, w with *
  have s2 := Module.add_assoc at R, M, v, w, -w with *
  have s3 := Module.add_zero at R, M, v with *
  have s4 := Module.zero_add at R, M, -w with *
  rw equal at s2
  cc

theorem Module.neg_neg (v : M)
  shows -(-v) = v
proof
  have group := Module.additive_group with *
  have law := inv_inv at M.additive, v with group, *
  module_additive at law
  exact law

theorem Module.neg_zero
  shows -M.zero = M.zero
proof
  have group := Module.additive_group with *
  have law := inv_one at M.additive with group
  module_additive at law
  exact law

theorem Module.add_left_cancel (u v w : M)
  requires equal : u + v = u + w
  shows v = w
proof
  have s1 := Module.neg_add at R, M, u with *
  have s2 := Module.add_assoc at R, M, -u, u, v with *
  have s3 := Module.add_assoc at R, M, -u, u, w with *
  have s4 := Module.zero_add at R, M, v with *
  have s5 := Module.zero_add at R, M, w with *
  rw s1 at s2
  rw s1 at s3
  cc

theorem Module.add_right_cancel (u v w : M)
  requires equal : v + u = w + u
  shows v = w
proof
  have c1 := Module.add_comm at R, M, v, u with *
  have c2 := Module.add_comm at R, M, w, u with *
  have swapped : u + v = u + w by cc
  exact Module.add_left_cancel with swapped

theorem Module.add_add_add_comm (a b c d : M)
  shows a + b + (c + d) = a + c + (b + d)
proof
  have abelian := Module.additive.abelian_group with module
  have law := mul_mul_mul_comm at M.additive, a, b, c, d with abelian, *
  module_additive at law
  exact law

theorem Module.sub_eq_zero_iff (v w : M)
  shows v + -w = M.zero ↔ v = w
proof
  constructor
  . intro equal
    have same := Module.eq_neg_of_add_eq_zero at R, M, v, -w with *
    have back := Module.neg_neg at R, M, w with *
    rw back at same
    exact same
  . intro equal
    rw equal
    exact Module.add_neg at R, M, w with *

theorem smul_neg (r : R) (v : M)
  shows r • -v = -(r • v)
proof
  have sum : r • -v + r • v = M.zero
    rw [← smul_add, Module.neg_add, smul_zero]
  exact Module.eq_neg_of_add_eq_zero with *

theorem neg_smul (r : R) (v : M)
  shows (-r) • v = -(r • v)
proof
  have negIn : -r ∈ R.carrier := Ring.neg_mem with *
  have parts := Ring.parts with ring
  have cancel := IsRing.add_inverse_left at R.carrier, R.add, R.zero, R.neg, R.mul, R.one, r with parts, *
  have sum : (-r) • v + r • v = M.zero
    rw [← add_smul, cancel, zero_smul]
  exact Module.eq_neg_of_add_eq_zero with *

end ModuleToolkit

-- Section: Restricted operations
-- An operation restricted to a closed subset, and the additive group of a
-- submodule.
theorem restrictBinary.function_on (A S op : Set)
  requires function : op : A × A → A
  requires subset : S ⊆ A
  requires closed : ∀ x y ∈ S, call2(op, x, y) ∈ S
  shows restrict(op, S × S) : S × S → S
proof
  have bounded := product.monotone with subset, subset
  have values : ∀ p ∈ S × S, op(p) ∈ S
    intros p hp
    obtain ⟨bound, x, hx, y, hy, shape⟩ := product.membership.forward with hp
    have output := closed with x, hx, y, hy
    unfold call2 at output
    rwa shape
  exact restrict.function at op, A × A, A, S × S, S with *

theorem restrictBinary.value_on (A S op x y : Set)
  requires function : op : A × A → A
  requires subset : S ⊆ A
  requires hx : x ∈ S
  requires hy : y ∈ S
  shows call2(restrict(op, S × S), x, y) = call2(op, x, y)
proof
  have bounded := product.monotone with subset, subset
  have pair := product.pair at x, y, S, S with *
  unfold call2
  exact restrict.domain_apply at op, A × A, A, S × S, (x, y) with *

theorem restrictUnary.value_on (A S op x : Set)
  requires function : op : A → A
  requires subset : S ⊆ A
  requires hx : x ∈ S
  shows restrict(op, S)(x) = op(x)
proof
  exact restrict.domain_apply at op, A, A, S, x with *

theorem SubmoduleOf.parts (N M R : Set)
  requires sub : SubmoduleOf(N, M, R)
  shows Module(M, R) ∧ N ⊆ Module.carrier(M) ∧ Module.zero(M) ∈ N ∧
    (∀ v w ∈ N, call2(Module.add(M), v, w) ∈ N) ∧
    (∀ r ∈ Ring.carrier(R), ∀ v ∈ N, call2(Module.smul(M), r, v) ∈ N)
proof
  obtain ⟨module, subset, zeroIn, addIn, smulIn⟩ := sub
  exact ⟨module, subset, zeroIn, addIn, smulIn⟩

theorem SubmoduleOf.neg_closed (N M R v : Set)
  requires sub : SubmoduleOf(N, M, R)
  requires member : v ∈ N
  shows apply(Module.neg(M), v) ∈ N
proof
  obtain ⟨module, subset, zeroIn, addIn, smulIn⟩ := sub
  have ring := Module.ring with module
  have vIn := subset with v, member
  have oneIn := Ring.one_mem at R with ring
  have negOne := Ring.neg_mem at R, R.one with *
  have scaled := smulIn with apply(R.neg, R.one), negOne, v, member
  have law := neg_smul at R, M, R.one, v with *
  have unit := one_smul at R, M, v with *
  rw [law, unit] at scaled
  exact scaled

theorem SubmoduleOf.additive_parts (N M R : Set)
  requires sub : SubmoduleOf(N, M, R)
  shows IsAbelianGroup(N, restrict(Module.add(M), N × N), Module.zero(M),
    restrict(Module.neg(M), N))
proof
  obtain ⟨module, subset, zeroIn, addIn, smulIn⟩ := SubmoduleOf.parts with sub
  have ring := Module.ring with module
  obtain ⟨shape, ringR, addF, zeroM, negF, smulF, rest⟩ := module
  have addR := restrictBinary.function_on with addF, subset, addIn
  have negIn : ∀ v ∈ N, apply(Module.neg(M), v) ∈ N
    intros v hv
    exact SubmoduleOf.neg_closed with sub, hv
  have negR := restrict.function at Module.neg(M), Module.carrier(M), Module.carrier(M), N, N with negF, subset, negIn
  have addV : ∀ x y ∈ N, call2(restrict(Module.add(M), N × N), x, y) = call2(Module.add(M), x, y)
    intros x hx y hy
    exact restrictBinary.value_on with addF, subset, hx, hy
  have negV : ∀ x ∈ N, restrict(Module.neg(M), N)(x) = apply(Module.neg(M), x)
    intros x hx
    exact restrictUnary.value_on with negF, subset, hx
  unfold IsAbelianGroup
  refine ⟨?_, ?_⟩
  . unfold IsGroup
    refine ⟨?_, ?_⟩
    . unfold IsMonoid
      refine ⟨?_, ?_⟩
      . unfold IsSemigroup
        refine ⟨addR, ?_⟩
        intros x hx y hy z hz
        have xy := addIn with x, hx, y, hy
        have yz := addIn with y, hy, z, hz
        have e1 := addV with x, hx, y, hy
        have e2 := addV with call2(Module.add(M), x, y), xy, z, hz
        have e3 := addV with y, hy, z, hz
        have e4 := addV with x, hx, call2(Module.add(M), y, z), yz
        have xM := subset with x, hx
        have yM := subset with y, hy
        have zM := subset with z, hz
        have assoc := Module.add_assoc at R, M, x, y, z with ring, module, *
        rw [e1, e2, e3, e4]
        exact assoc
      . unfold Identity
        refine ⟨zeroIn, ?_⟩
        intros x hx
        have xM := subset with x, hx
        have e1 := addV with Module.zero(M), zeroIn, x, hx
        have e2 := addV with x, hx, Module.zero(M), zeroIn
        have l := Module.zero_add at R, M, x with ring, module, *
        have r := Module.add_zero at R, M, x with ring, module, *
        rw [e1, e2]
        exact ⟨l, r⟩
    . unfold Inverse
      refine ⟨negR, ?_⟩
      intros x hx
      have xM := subset with x, hx
      have nx := negIn with x, hx
      have n1 := negV with x, hx
      have e1 := addV with apply(Module.neg(M), x), nx, x, hx
      have e2 := addV with x, hx, apply(Module.neg(M), x), nx
      have l := Module.neg_add at R, M, x with ring, module, *
      have r := Module.add_neg at R, M, x with ring, module, *
      rw [n1, e1, e2]
      exact ⟨l, r⟩
  . intros x hx y hy
    have xM := subset with x, hx
    have yM := subset with y, hy
    have e1 := addV with x, hx, y, hy
    have e2 := addV with y, hy, x, hx
    have c := Module.add_comm at R, M, x, y with ring, module, *
    rw [e1, e2]
    exact c

-- The operations of a submodule module, read back.
theorem submoduleModule.carrier_eq (M R N : Set)
  shows Module.carrier(submoduleModule(M, R, N)) = N
proof
  unfold submoduleModule
  module_projections

theorem submoduleModule.zero_eq (M R N : Set)
  shows Module.zero(submoduleModule(M, R, N)) = Module.zero(M)
proof
  unfold submoduleModule
  module_projections

theorem submoduleModule.add_value (M R N v w : Set)
  requires sub : SubmoduleOf(N, M, R)
  requires first : v ∈ N
  requires second : w ∈ N
  shows call2(Module.add(submoduleModule(M, R, N)), v, w) =
    call2(Module.add(M), v, w)
proof
  obtain ⟨module, subset, zeroIn, addIn, smulIn⟩ := SubmoduleOf.parts with sub
  obtain ⟨shape, ringR, addF, rest⟩ := module
  unfold submoduleModule
  module_projections
  exact restrictBinary.value_on with addF, subset, first, second

theorem submoduleModule.neg_value (M R N v : Set)
  requires sub : SubmoduleOf(N, M, R)
  requires member : v ∈ N
  shows apply(Module.neg(submoduleModule(M, R, N)), v) = apply(Module.neg(M), v)
proof
  obtain ⟨module, subset, zeroIn, addIn, smulIn⟩ := SubmoduleOf.parts with sub
  obtain ⟨shape, ringR, addF, zeroM, negF, rest⟩ := module
  unfold submoduleModule
  module_projections
  exact restrictUnary.value_on with negF, subset, member

theorem submoduleModule.smul_value (M R N r v : Set)
  requires sub : SubmoduleOf(N, M, R)
  requires scalar : r ∈ Ring.carrier(R)
  requires member : v ∈ N
  shows call2(Module.smul(submoduleModule(M, R, N)), r, v) =
    call2(Module.smul(M), r, v)
proof
  obtain ⟨module, subset, zeroIn, addIn, smulIn⟩ := SubmoduleOf.parts with sub
  obtain ⟨shape, ringR, addF, zeroM, negF, smulF, rest⟩ := module
  have refl : Ring.carrier(R) ⊆ Ring.carrier(R)
    intros x hx
    exact hx
  have bounded := product.monotone with refl, subset
  have pair := product.pair at r, v, Ring.carrier(R), N with scalar, member
  unfold submoduleModule
  module_projections
  unfold call2
  exact restrict.domain_apply at Module.smul(M), Ring.carrier(R) × Module.carrier(M), Module.carrier(M), Ring.carrier(R) × N, (r, v) with smulF, bounded, pair

-- Section: Modules from their laws
-- An abelian group and a module built from the pointwise laws of their
-- operations.
theorem IsAbelianGroup.of_laws (A add zero neg : Set)
  requires addF : add : A × A → A
  requires zeroIn : zero ∈ A
  requires negF : neg : A → A
  requires assoc : ∀ x y z ∈ A,
    call2(add, call2(add, x, y), z) = call2(add, x, call2(add, y, z))
  requires comm : ∀ x y ∈ A, call2(add, x, y) = call2(add, y, x)
  requires zeroAdd : ∀ x ∈ A, call2(add, zero, x) = x
  requires negAdd : ∀ x ∈ A, call2(add, neg(x), x) = zero
  shows IsAbelianGroup(A, add, zero, neg)
proof
  unfold IsAbelianGroup
  refine ⟨?_, ?_⟩
  . unfold IsGroup
    refine ⟨?_, ?_⟩
    . unfold IsMonoid
      refine ⟨?_, ?_⟩
      . unfold IsSemigroup
        refine ⟨addF, ?_⟩
        intros x hx y hy z hz
        exact assoc with x, hx, y, hy, z, hz
      . unfold Identity
        refine ⟨zeroIn, ?_⟩
        intros x hx
        have left := zeroAdd with x, hx
        have swap := comm with x, hx, zero, zeroIn
        rw left at swap
        exact ⟨left, swap⟩
    . unfold Inverse
      refine ⟨negF, ?_⟩
      intros x hx
      have nx := FunctionBetween.apply_closed with negF, hx
      have left := negAdd with x, hx
      have swap := comm with x, hx, neg(x), nx
      rw left at swap
      exact ⟨left, swap⟩
  . intros x hx y hy
    exact comm with x, hx, y, hy

theorem Module.of_laws (R A add zero neg smul : Set)
  requires ring : Ring(R)
  requires addF : add : A × A → A
  requires zeroIn : zero ∈ A
  requires negF : neg : A → A
  requires smulF : smul : Ring.carrier(R) × A → A
  requires assoc : ∀ x y z ∈ A,
    call2(add, call2(add, x, y), z) = call2(add, x, call2(add, y, z))
  requires comm : ∀ x y ∈ A, call2(add, x, y) = call2(add, y, x)
  requires zeroAdd : ∀ x ∈ A, call2(add, zero, x) = x
  requires negAdd : ∀ x ∈ A, call2(add, neg(x), x) = zero
  requires smulAdd : ∀ r ∈ Ring.carrier(R), ∀ v w ∈ A,
    call2(smul, r, call2(add, v, w)) = call2(add, call2(smul, r, v), call2(smul, r, w))
  requires addSmul : ∀ r s ∈ Ring.carrier(R), ∀ v ∈ A,
    call2(smul, call2(Ring.add(R), r, s), v) = call2(add, call2(smul, r, v), call2(smul, s, v))
  requires mulSmul : ∀ r s ∈ Ring.carrier(R), ∀ v ∈ A,
    call2(smul, call2(Ring.mul(R), r, s), v) = call2(smul, r, call2(smul, s, v))
  requires oneSmul : ∀ v ∈ A, call2(smul, Ring.one(R), v) = v
  shows Module(Module.mk(A, add, zero, neg, smul), R)
proof
  have parts := IsAbelianGroup.of_laws with addF, zeroIn, negF, assoc, comm, zeroAdd, negAdd
  have abelian := AbelianGroup.of_parts with parts
  exact Module.intro with ring, addF, zeroIn, negF, smulF, abelian, smulAdd, addSmul, mulSmul, oneSmul

-- Section: First laws of linear maps
-- Helpers for the definitions below: a linear map unpacked and rebuilt,
-- and the pointwise operations and composites of linear maps.
theorem LinearMap.of_laws (f M R N : Set)
  requires moduleM : Module(M, R)
  requires moduleN : Module(N, R)
  requires function : f : Module.carrier(M) → Module.carrier(N)
  requires additive : ∀ v w ∈ Module.carrier(M),
    f(call2(Module.add(M), v, w)) = call2(Module.add(N), f(v), f(w))
  requires homogeneous : ∀ r ∈ Ring.carrier(R), ∀ v ∈ Module.carrier(M),
    f(call2(Module.smul(M), r, v)) = call2(Module.smul(N), r, f(v))
  shows LinearMap(f, M, R, N)
proof
  unfold LinearMap
  exact ⟨moduleM, moduleN, function, additive, homogeneous⟩

theorem LinearMap.add_law (f M R N v w : Set)
  requires linear : LinearMap(f, M, R, N)
  requires first : v ∈ Module.carrier(M)
  requires second : w ∈ Module.carrier(M)
  shows f(call2(Module.add(M), v, w)) = call2(Module.add(N), f(v), f(w))
proof
  obtain ⟨moduleM, moduleN, function, additive, homogeneous⟩ := linear
  exact additive with v, first, w, second

theorem LinearMap.smul_law (f M R N r v : Set)
  requires linear : LinearMap(f, M, R, N)
  requires scalar : r ∈ Ring.carrier(R)
  requires vector : v ∈ Module.carrier(M)
  shows f(call2(Module.smul(M), r, v)) = call2(Module.smul(N), r, f(v))
proof
  obtain ⟨moduleM, moduleN, function, additive, homogeneous⟩ := linear
  exact homogeneous with r, scalar, v, vector

theorem LinearMap.function_of (f M R N : Set)
  requires linear : LinearMap(f, M, R, N)
  shows f : Module.carrier(M) → Module.carrier(N)
proof
  obtain ⟨moduleM, moduleN, function, additive, homogeneous⟩ := linear
  exact function

theorem LinearMap.value_mem (f M R N v : Set)
  requires linear : LinearMap(f, M, R, N)
  requires vector : v ∈ Module.carrier(M)
  shows f(v) ∈ Module.carrier(N)
proof
  have function := LinearMap.function_of with linear
  exact FunctionBetween.apply_closed with function, vector

theorem linearMaps.linear (f M R N : Set)
  requires member : f ∈ linearMaps(M, R, N)
  shows LinearMap(f, M, R, N)
proof
  obtain ⟨space, linear⟩ := linearMaps.membership.forward with member
  exact linear

theorem linearMaps.of_linear (f M R N : Set)
  requires linear : LinearMap(f, M, R, N)
  shows f ∈ linearMaps(M, R, N)
proof
  have function := LinearMap.function_of with linear
  have space := functionSpace.mem_iff.backward with function
  apply linearMaps.membership.backward
  exact ⟨space, linear⟩

theorem LinearMap.pointwise_add (f g M R N : Set)
  requires first : LinearMap(f, M, R, N)
  requires second : LinearMap(g, M, R, N)
  shows LinearMap(pointwiseSum(Module.carrier(M), N, f, g), M, R, N)
proof
  obtain ⟨moduleM, moduleN, fF, fAdd, fSmul⟩ := first
  obtain ⟨_, _, gF, gAdd, gSmul⟩ := second
  have ring := Module.ring with moduleM
  have abelian := Module.additive.abelian_group with moduleN
  have parts := Module.additive_parts with abelian
  have values : ∀ v ∈ Module.carrier(M),
      call2(Module.add(N), f(v), g(v)) ∈ Module.carrier(N)
    intros v hv
    have fv := FunctionBetween.apply_closed with fF, hv
    have gv := FunctionBetween.apply_closed with gF, hv
    exact Module.add_mem at R, N, f(v), g(v) with *
  have function := pointwiseSum.function at Module.carrier(M), N, f, g with values
  apply LinearMap.of_laws with moduleM, moduleN, function
  . intros v hv w hw
    have vw := Module.add_mem at R, M, v, w with *
    have fv := FunctionBetween.apply_closed with fF, hv
    have gv := FunctionBetween.apply_closed with gF, hv
    have fw := FunctionBetween.apply_closed with fF, hw
    have gw := FunctionBetween.apply_closed with gF, hw
    have e1 := pointwiseSum.apply at Module.carrier(M), N, f, g, call2(Module.add(M), v, w) with values, vw
    have e2 := pointwiseSum.apply at Module.carrier(M), N, f, g, v with values, hv
    have e3 := pointwiseSum.apply at Module.carrier(M), N, f, g, w with values, hw
    have fa := fAdd with v, hv, w, hw
    have ga := gAdd with v, hv, w, hw
    have shuffle := IsAbelianGroup.four_shuffle at Module.carrier(N), Module.add(N), Module.zero(N), Module.neg(N), f(v), f(w), g(v), g(w) with *
    rw [e1, e2, e3, fa, ga]
    exact shuffle
  . intros r hr v hv
    have rv := Module.smul_mem at R, M, r, v with *
    have fv := FunctionBetween.apply_closed with fF, hv
    have gv := FunctionBetween.apply_closed with gF, hv
    have e1 := pointwiseSum.apply at Module.carrier(M), N, f, g, call2(Module.smul(M), r, v) with values, rv
    have e2 := pointwiseSum.apply at Module.carrier(M), N, f, g, v with values, hv
    have fs := fSmul with r, hr, v, hv
    have gs := gSmul with r, hr, v, hv
    have distribute := smul_add at R, N, r, f(v), g(v) with *
    rw [e1, e2, fs, gs, distribute]
theorem LinearMap.pointwise_neg (f M R N : Set)
  requires linear : LinearMap(f, M, R, N)
  shows LinearMap(pointwiseNeg(Module.carrier(M), N, f), M, R, N)
proof
  obtain ⟨moduleM, moduleN, fF, fAdd, fSmul⟩ := linear
  have ring := Module.ring with moduleM
  have values : ∀ v ∈ Module.carrier(M),
      apply(Module.neg(N), f(v)) ∈ Module.carrier(N)
    intros v hv
    have fv := FunctionBetween.apply_closed with fF, hv
    exact Module.neg_mem at R, N, f(v) with *
  have function := pointwiseNeg.function at Module.carrier(M), N, f with values
  apply LinearMap.of_laws with moduleM, moduleN, function
  . intros v hv w hw
    have vw := Module.add_mem at R, M, v, w with *
    have fv := FunctionBetween.apply_closed with fF, hv
    have fw := FunctionBetween.apply_closed with fF, hw
    have e1 := pointwiseNeg.apply at Module.carrier(M), N, f, call2(Module.add(M), v, w) with values, vw
    have e2 := pointwiseNeg.apply at Module.carrier(M), N, f, v with values, hv
    have e3 := pointwiseNeg.apply at Module.carrier(M), N, f, w with values, hw
    have fa := fAdd with v, hv, w, hw
    have distribute := Module.neg_add_distrib at R, N, f(v), f(w) with *
    rw [e1, e2, e3, fa, distribute]
  . intros r hr v hv
    have rv := Module.smul_mem at R, M, r, v with *
    have fv := FunctionBetween.apply_closed with fF, hv
    have e1 := pointwiseNeg.apply at Module.carrier(M), N, f, call2(Module.smul(M), r, v) with values, rv
    have e2 := pointwiseNeg.apply at Module.carrier(M), N, f, v with values, hv
    have fs := fSmul with r, hr, v, hv
    have negate := smul_neg at R, N, r, f(v) with *
    rw [e1, e2, fs, negate]

theorem LinearMap.pointwise_smul (f M R N a : Set)
  requires comm : CommRing(R)
  requires linear : LinearMap(f, M, R, N)
  requires scalar : a ∈ Ring.carrier(R)
  shows LinearMap(pointwiseSmul(Module.carrier(M), N, a, f), M, R, N)
proof
  obtain ⟨moduleM, moduleN, fF, fAdd, fSmul⟩ := linear
  have ring := Module.ring with moduleM
  have values : ∀ v ∈ Module.carrier(M),
      call2(Module.smul(N), a, f(v)) ∈ Module.carrier(N)
    intros v hv
    have fv := FunctionBetween.apply_closed with fF, hv
    exact Module.smul_mem at R, N, a, f(v) with *
  have function := pointwiseSmul.function at Module.carrier(M), N, a, f with values
  apply LinearMap.of_laws with moduleM, moduleN, function
  . intros v hv w hw
    have vw := Module.add_mem at R, M, v, w with *
    have fv := FunctionBetween.apply_closed with fF, hv
    have fw := FunctionBetween.apply_closed with fF, hw
    have e1 := pointwiseSmul.apply at Module.carrier(M), N, a, f, call2(Module.add(M), v, w) with values, vw
    have e2 := pointwiseSmul.apply at Module.carrier(M), N, a, f, v with values, hv
    have e3 := pointwiseSmul.apply at Module.carrier(M), N, a, f, w with values, hw
    have fa := fAdd with v, hv, w, hw
    have distribute := smul_add at R, N, a, f(v), f(w) with *
    rw [e1, e2, e3, fa, distribute]
  . intros r hr v hv
    have rv := Module.smul_mem at R, M, r, v with *
    have fv := FunctionBetween.apply_closed with fF, hv
    have e1 := pointwiseSmul.apply at Module.carrier(M), N, a, f, call2(Module.smul(M), r, v) with values, rv
    have e2 := pointwiseSmul.apply at Module.carrier(M), N, a, f, v with values, hv
    have fs := fSmul with r, hr, v, hv
    have swap : a * r = r * a by ring
    have left := mul_smul at R, N, a, r, f(v) with *
    have right := mul_smul at R, N, r, a, f(v) with *
    rw [e1, e2, fs, ← left, swap, right]

theorem LinearMap.compose_of (f g M R N P : Set)
  requires first : LinearMap(f, M, R, N)
  requires second : LinearMap(g, N, R, P)
  shows LinearMap(compose(g, f, Module.carrier(M), Module.carrier(N),
    Module.carrier(P)), M, R, P)
proof
  obtain ⟨moduleM, moduleN, fF, fAdd, fSmul⟩ := first
  obtain ⟨_, moduleP, gF, gAdd, gSmul⟩ := second
  have ring := Module.ring with moduleM
  have function := compose.function at g, f, Module.carrier(M), Module.carrier(N), Module.carrier(P) with fF, gF
  apply LinearMap.of_laws with moduleM, moduleP, function
  . intros v hv w hw
    have vw := Module.add_mem at R, M, v, w with *
    have fv := FunctionBetween.apply_closed with fF, hv
    have fw := FunctionBetween.apply_closed with fF, hw
    have e1 := compose.apply at g, f, Module.carrier(M), Module.carrier(N), Module.carrier(P), call2(Module.add(M), v, w) with fF, gF, vw
    have e2 := compose.apply at g, f, Module.carrier(M), Module.carrier(N), Module.carrier(P), v with fF, gF, hv
    have e3 := compose.apply at g, f, Module.carrier(M), Module.carrier(N), Module.carrier(P), w with fF, gF, hw
    have fa := fAdd with v, hv, w, hw
    have ga := gAdd with f(v), fv, f(w), fw
    rw [e1, e2, e3, fa, ga]
  . intros r hr v hv
    have rv := Module.smul_mem at R, M, r, v with *
    have fv := FunctionBetween.apply_closed with fF, hv
    have e1 := compose.apply at g, f, Module.carrier(M), Module.carrier(N), Module.carrier(P), call2(Module.smul(M), r, v) with fF, gF, rv
    have e2 := compose.apply at g, f, Module.carrier(M), Module.carrier(N), Module.carrier(P), v with fF, gF, hv
    have fs := fSmul with r, hr, v, hv
    have gs := gSmul with r, hr, f(v), fv
    rw [e1, e2, fs, gs]

defgraph linearMapAdd (M R N : Set)
    (p ∈ linearMaps(M, R, N) × linearMaps(M, R, N)) : linearMaps(M, R, N) :=
  pointwiseSum(Module.carrier(M), N, fst(p), snd(p))
requires ring : CommRing(R)
requires moduleM : Module(M, R)
requires moduleN : Module(N, R)
proof
  obtain ⟨left, right⟩ := product.member_parts with member
  have lf := linearMaps.linear with left
  have lg := linearMaps.linear with right
  have sum := LinearMap.pointwise_add with lf, lg
  exact linearMaps.of_linear with sum

defgraph linearMapNeg (M R N : Set) (f ∈ linearMaps(M, R, N)) :
    linearMaps(M, R, N) :=
  pointwiseNeg(Module.carrier(M), N, f)
requires ring : CommRing(R)
requires moduleM : Module(M, R)
requires moduleN : Module(N, R)
proof
  have lf := linearMaps.linear with member
  have negated := LinearMap.pointwise_neg with lf
  exact linearMaps.of_linear with negated

defgraph linearMapSmul (M R N : Set)
    (p ∈ Ring.carrier(R) × linearMaps(M, R, N)) : linearMaps(M, R, N) :=
  pointwiseSmul(Module.carrier(M), N, fst(p), snd(p))
requires ring : CommRing(R)
requires moduleM : Module(M, R)
requires moduleN : Module(N, R)
proof
  obtain ⟨left, right⟩ := product.member_parts with member
  have lf := linearMaps.linear with right
  have scaled := LinearMap.pointwise_smul with ring, lf, left
  exact linearMaps.of_linear with scaled

def homModule (M R N : Set) : Set :=
  Module.mk(linearMaps(M, R, N), linearMapAdd(M, R, N),
    constantFunction(Module.carrier(M), Module.carrier(N), Module.zero(N)),
    linearMapNeg(M, R, N), linearMapSmul(M, R, N))

defgraph linearMapCompose (M R : Set)
    (p ∈ linearMaps(M, R, M) × linearMaps(M, R, M)) : linearMaps(M, R, M) :=
  compose(fst(p), snd(p), Module.carrier(M), Module.carrier(M),
    Module.carrier(M))
requires module : Module(M, R)
proof
  obtain ⟨left, right⟩ := product.member_parts with member
  have lf := linearMaps.linear with left
  have lg := linearMaps.linear with right
  have composite := LinearMap.compose_of with lg, lf
  exact linearMaps.of_linear with composite

-- End(M) = Ring.mk(linear maps, +, 0, −, ∘, id): the product f * g is the
-- composite f ∘ g.
def endomorphismRing (M R : Set) : Set :=
  Ring.mk(linearMaps(M, R, M), linearMapAdd(M, R, M),
    constantFunction(Module.carrier(M), Module.carrier(M), Module.zero(M)),
    linearMapNeg(M, R, M), linearMapCompose(M, R),
    identity(Module.carrier(M)))

-- Graph laws of the family constructions.
theorem familySlice.relates (V X w i j : Set)
  requires index : j ∈ V
  requires valueIn : w((i, j)) ∈ X
  shows relates(familySlice(V, X, w, i), j, w((i, j)))
proof
  unfold relates
  apply familySlice.membership.backward
  refine ⟨(product.pair at j, w((i, j)), V, X with index, valueIn), j, index, rfl⟩

theorem familySlice.function (V X w i : Set)
  requires values : ∀ j ∈ V, w((i, j)) ∈ X
  shows familySlice(V, X, w, i) : V → X
proof
  constructor
    intros p member
    obtain ⟨bounded, witnesses⟩ := familySlice.membership.forward with member
    exact bounded
  . constructor
      intros z0 first xFirst second xSecond
      unfold relates at xFirst
      obtain ⟨_, a1, a1In, firstShape⟩ := familySlice.membership.forward with xFirst
      unfold relates at xSecond
      obtain ⟨_, a2, a2In, secondShape⟩ := familySlice.membership.forward with xSecond
      obtain ⟨xi, firstEqual⟩ := orderedPair.injective with firstShape
      obtain ⟨xj, secondEqual⟩ := orderedPair.injective with secondShape
      rw [firstEqual, secondEqual]
      cc
    . intros j xIn
      have valueIn := values with j, xIn
      refine ⟨w((i, j)), valueIn, (familySlice.relates at V, X, w, i, j with xIn, valueIn)⟩

theorem familySlice.apply (V X w i j : Set)
  requires values : ∀ j ∈ V, w((i, j)) ∈ X
  requires index : j ∈ V
  shows familySlice(V, X, w, i)(j) = w((i, j))
proof
  have function := familySlice.function at V, X, w, i with values
  have valueIn := values with j, index
  have mapped := familySlice.relates at V, X, w, i, j with index, valueIn
  exact FunctionBetween.apply_value with function, index, mapped

theorem familyRowSums.relates (M U V w i : Set)
  requires index : i ∈ U
  requires valueIn : moduleSum(M, V, familySlice(V, Module.carrier(M), w, i)) ∈ Module.carrier(M)
  shows relates(familyRowSums(M, U, V, w), i, moduleSum(M, V, familySlice(V, Module.carrier(M), w, i)))
proof
  unfold relates
  apply familyRowSums.membership.backward
  refine ⟨(product.pair at i, moduleSum(M, V, familySlice(V, Module.carrier(M), w, i)), U, Module.carrier(M) with index, valueIn), i, index, rfl⟩

theorem familyRowSums.function (M U V w : Set)
  requires values : ∀ i ∈ U, moduleSum(M, V, familySlice(V, Module.carrier(M), w, i)) ∈ Module.carrier(M)
  shows familyRowSums(M, U, V, w) : U → Module.carrier(M)
proof
  constructor
    intros p member
    obtain ⟨bounded, witnesses⟩ := familyRowSums.membership.forward with member
    exact bounded
  . constructor
      intros z0 first xFirst second xSecond
      unfold relates at xFirst
      obtain ⟨_, a1, a1In, firstShape⟩ := familyRowSums.membership.forward with xFirst
      unfold relates at xSecond
      obtain ⟨_, a2, a2In, secondShape⟩ := familyRowSums.membership.forward with xSecond
      obtain ⟨xi, firstEqual⟩ := orderedPair.injective with firstShape
      obtain ⟨xj, secondEqual⟩ := orderedPair.injective with secondShape
      rw [firstEqual, secondEqual]
      cc
    . intros i xIn
      have valueIn := values with i, xIn
      refine ⟨moduleSum(M, V, familySlice(V, Module.carrier(M), w, i)), valueIn, (familyRowSums.relates at M, U, V, w, i with xIn, valueIn)⟩

theorem familyRowSums.apply (M U V w i : Set)
  requires values : ∀ i ∈ U, moduleSum(M, V, familySlice(V, Module.carrier(M), w, i)) ∈ Module.carrier(M)
  requires index : i ∈ U
  shows familyRowSums(M, U, V, w)(i) = moduleSum(M, V, familySlice(V, Module.carrier(M), w, i))
proof
  have function := familyRowSums.function at M, U, V, w with values
  have valueIn := values with i, index
  have mapped := familyRowSums.relates at M, U, V, w, i with index, valueIn
  exact FunctionBetween.apply_value with function, index, mapped

theorem familyEvaluate.relates (V X w x k : Set)
  requires index : k ∈ V
  requires valueIn : w(k)(x) ∈ X
  shows relates(familyEvaluate(V, X, w, x), k, w(k)(x))
proof
  unfold relates
  apply familyEvaluate.membership.backward
  refine ⟨(product.pair at k, w(k)(x), V, X with index, valueIn), k, index, rfl⟩

theorem familyEvaluate.function (V X w x : Set)
  requires values : ∀ k ∈ V, w(k)(x) ∈ X
  shows familyEvaluate(V, X, w, x) : V → X
proof
  constructor
    intros p member
    obtain ⟨bounded, witnesses⟩ := familyEvaluate.membership.forward with member
    exact bounded
  . constructor
      intros z0 first xFirst second xSecond
      unfold relates at xFirst
      obtain ⟨_, a1, a1In, firstShape⟩ := familyEvaluate.membership.forward with xFirst
      unfold relates at xSecond
      obtain ⟨_, a2, a2In, secondShape⟩ := familyEvaluate.membership.forward with xSecond
      obtain ⟨xi, firstEqual⟩ := orderedPair.injective with firstShape
      obtain ⟨xj, secondEqual⟩ := orderedPair.injective with secondShape
      rw [firstEqual, secondEqual]
      cc
    . intros k xIn
      have valueIn := values with k, xIn
      refine ⟨w(k)(x), valueIn, (familyEvaluate.relates at V, X, w, x, k with xIn, valueIn)⟩

theorem familyEvaluate.apply (V X w x k : Set)
  requires values : ∀ k ∈ V, w(k)(x) ∈ X
  requires index : k ∈ V
  shows familyEvaluate(V, X, w, x)(k) = w(k)(x)
proof
  have function := familyEvaluate.function at V, X, w, x with values
  have valueIn := values with k, index
  have mapped := familyEvaluate.relates at V, X, w, x, k with index, valueIn
  exact FunctionBetween.apply_value with function, index, mapped


-- Section: Indexed sums in a module
-- The sum of a module-valued family along an enumeration f : n → V, and
-- its laws by induction on n; moduleSum is such a sum for any bijective
-- enumeration.
section IndexedModuleSums
variable (R M : Set)
hypothesis ring : Ring(R)
hypothesis module : Module(M, R)

theorem Module.parts_of
  shows IsAbelianGroup(M.carrier, M.add, M.zero, M.neg)
proof
  have abelian := Module.additive.abelian_group with module
  exact Module.additive_parts with abelian

theorem indexedRingSum.module_mem (w f : Set, n : Nat)
  requires values : WeightedValues(w, f, M.carrier, n)
  shows indexedRingSum(w, f, M.add, M.zero, n) ∈ M.carrier
proof
  have parts := Module.parts_of with *
  have closure := indexedRingSum.group_closed at M.carrier, M.add, M.zero, M.neg, w, f, n with parts
  exact closure with values

theorem moduleSum.enumeration (V w f : Set, n : Nat)
  requires weights : w : V → M.carrier
  requires enumeration : BijectiveBetween(f, n, V)
  shows moduleSum(M, V, w) = indexedRingSum(w, f, M.add, M.zero, n)
proof
  have parts := Module.parts_of with *
  have abelian := Module.additive.abelian_group with module
  have reverse := converse.bijective with enumeration
  have cardinality : HasCardinality(V, n)
    unfold HasCardinality
    refine ⟨assumption, ?_⟩
    unfold Equipotent
    refine ⟨converse(f, n, V), reverse⟩
  have finite := Finite.from_cardinality with cardinality
  have selected := moduleSum.selected at M, V, w with abelian, finite, weights
  obtain ⟨m, naturalM, g, enumerationG, value⟩ := selected.right
  have same := indexedRingSum.group_reindex at M.carrier, M.add, M.zero, M.neg, w, V, g, f, m, n with *
  cc

theorem moduleSum.mem_of (V w : Set)
  requires finite : Finite(V)
  requires weights : w : V → M.carrier
  shows moduleSum(M, V, w) ∈ M.carrier
proof
  have abelian := Module.additive.abelian_group with module
  have selected := moduleSum.selected at M, V, w with abelian, finite, weights
  exact selected.left

-- Some bijective enumeration of a finite set.
theorem Finite.enumeration (V : Set)
  requires finite : Finite(V)
  shows ∃ n, Nat(n) ∧ ∃ f, BijectiveBetween(f, n, V)
proof
  obtain ⟨n, natural, equivalent⟩ := finite
  obtain ⟨f, bijective⟩ := equivalent
  have enumeration := converse.bijective with bijective
  exact ⟨n, natural, converse(f, V, n), enumeration⟩

theorem indexedRingSum.module_add (w u h f : Set, n : Nat)
  shows WeightedValues(w, f, M.carrier, n) → WeightedValues(u, f, M.carrier, n) →
    (∀ i ∈ n, h(f(i)) = call2(M.add, w(f(i)), u(f(i)))) →
    indexedRingSum(h, f, M.add, M.zero, n) =
      call2(M.add, indexedRingSum(w, f, M.add, M.zero, n), indexedRingSum(u, f, M.add, M.zero, n))
proof
  induction n
  | zero =>
    intros valuesW valuesU equations
    have zeroM := Module.zero_mem at R, M with *
    have unit := Module.add_zero at R, M, M.zero with *
    simp [indexedRingSum, unit]
  | succ(k) using ih =>
    intros valuesW valuesU equations
    have prefixW := WeightedValues.prefix at w, f, M.carrier, k with *
    have prefixU := WeightedValues.prefix at u, f, M.carrier, k with *
    have lastW := WeightedValues.last at w, f, M.carrier, k with *
    have lastU := WeightedValues.last at u, f, M.carrier, k with *
    have prefix : ∀ i ∈ k, h(f(i)) = call2(M.add, w(f(i)), u(f(i)))
      intros i hi
      have next := membership.into_successor at i, k with *
      exact equations with i, next
    have last := equations with k, membership.self_successor at k with *
    have previous := ih with prefixW, prefixU, prefix
    have sumW := indexedRingSum.module_mem at R, M, w, f, k with *
    have sumU := indexedRingSum.module_mem at R, M, u, f, k with *
    have shuffle := Module.add_add_add_comm at R, M, indexedRingSum(w, f, M.add, M.zero, k), indexedRingSum(u, f, M.add, M.zero, k), w(f(k)), u(f(k)) with *
    rw [indexedRingSum, indexedRingSum, indexedRingSum, previous, last]
    exact shuffle

theorem indexedRingSum.module_smul (w h f r : Set, n : Nat)
  requires scalar : r ∈ R.carrier
  shows WeightedValues(w, f, M.carrier, n) →
    (∀ i ∈ n, h(f(i)) = call2(M.smul, r, w(f(i)))) →
    indexedRingSum(h, f, M.add, M.zero, n) =
      call2(M.smul, r, indexedRingSum(w, f, M.add, M.zero, n))
proof
  induction n
  | zero =>
    intros valuesW equations
    have vanish := smul_zero at R, M, r with *
    simp [indexedRingSum, vanish]
  | succ(k) using ih =>
    intros valuesW equations
    have prefixW := WeightedValues.prefix at w, f, M.carrier, k with *
    have lastW := WeightedValues.last at w, f, M.carrier, k with *
    have prefix : ∀ i ∈ k, h(f(i)) = call2(M.smul, r, w(f(i)))
      intros i hi
      have next := membership.into_successor at i, k with *
      exact equations with i, next
    have last := equations with k, membership.self_successor at k with *
    have previous := ih with prefixW, prefix
    have sumW := indexedRingSum.module_mem at R, M, w, f, k with *
    have law := smul_add at R, M, r, indexedRingSum(w, f, M.add, M.zero, k), w(f(k)) with *
    rw [indexedRingSum, indexedRingSum, previous, last, law]

theorem indexedRingSum.module_zero (h f : Set, n : Nat)
  shows (∀ i ∈ n, h(f(i)) = M.zero) → indexedRingSum(h, f, M.add, M.zero, n) = M.zero
proof
  induction n
  | zero =>
    intro equations
    simp [indexedRingSum]
  | succ(k) using ih =>
    intro equations
    have prefix : ∀ i ∈ k, h(f(i)) = M.zero
      intros i hi
      have next := membership.into_successor at i, k with *
      exact equations with i, next
    have last := equations with k, membership.self_successor at k with *
    have previous := ih with prefix
    have zeroM := Module.zero_mem at R, M with *
    have unit := Module.add_zero at R, M, M.zero with *
    rw [indexedRingSum, previous, last]
    exact unit

theorem indexedRingSum.submodule_mem (N w f : Set, n : Nat)
  requires sub : SubmoduleOf(N, M, R)
  shows (∀ i ∈ n, w(f(i)) ∈ N) → indexedRingSum(w, f, M.add, M.zero, n) ∈ N
proof
  induction n
  | zero =>
    intro values
    obtain ⟨_, subset, zeroIn, rest⟩ := sub
    simp [indexedRingSum, zeroIn]
  | succ(k) using ih =>
    intro values
    obtain ⟨_, subset, zeroIn, addIn, smulIn⟩ := sub
    have prefix : ∀ i ∈ k, w(f(i)) ∈ N
      intros i hi
      have next := membership.into_successor at i, k with *
      exact values with i, next
    have last := values with k, membership.self_successor at k with *
    have previous := ih with prefix
    rw indexedRingSum
    exact addIn with indexedRingSum(w, f, M.add, M.zero, k), previous, w(f(k)), last

theorem indexedRingSum.module_sum_smul (c h f v : Set, n : Nat)
  requires vector : v ∈ M.carrier
  shows WeightedValues(c, f, R.carrier, n) →
    (∀ i ∈ n, h(f(i)) = call2(M.smul, c(f(i)), v)) →
    call2(M.smul, indexedRingSum(c, f, R.add, R.zero, n), v) =
      indexedRingSum(h, f, M.add, M.zero, n)
proof
  induction n
  | zero =>
    intros valuesC equations
    have vanish := zero_smul at R, M, v with *
    simp [indexedRingSum, vanish]
  | succ(k) using ih =>
    intros valuesC equations
    have parts := Ring.parts with ring
    have additive := IsRing.additive with parts
    have prefixC := WeightedValues.prefix at c, f, R.carrier, k with *
    have lastC := WeightedValues.last at c, f, R.carrier, k with *
    have prefix : ∀ i ∈ k, h(f(i)) = call2(M.smul, c(f(i)), v)
      intros i hi
      have next := membership.into_successor at i, k with *
      exact equations with i, next
    have last := equations with k, membership.self_successor at k with *
    have previous := ih with prefixC, prefix
    have closure := indexedRingSum.group_closed at R.carrier, R.add, R.zero, R.neg, c, f, k with additive
    have sumC := closure with prefixC
    have law := add_smul at R, M, indexedRingSum(c, f, R.add, R.zero, k), c(f(k)), v with *
    rw [indexedRingSum, indexedRingSum, law, previous, last]

theorem moduleSum.empty_of (w : Set)
  requires values : w : ∅ → M.carrier
  shows moduleSum(M, ∅, w) = M.zero
proof
  have abelian := Module.additive.abelian_group with module
  have finite := Finite.empty
  have selected := moduleSum.selected at M, ∅, w with abelian, finite, values
  obtain ⟨n, natural, e, enumeration, value⟩ := selected.right
  have injective := Bijective.injective with enumeration
  have eF := Injective.function with injective
  have vanish : ∀ i ∈ n, w(e(i)) = M.zero
    intros i hi
    have member := FunctionBetween.apply_closed with eF, hi
    exfalso
    exact empty.membership with e(i), member
  have zero := indexedRingSum.module_zero at R, M, w, e, n with *
  rw value
  exact zero with vanish

theorem moduleSum.insert_of (V w x : Set)
  requires finite : Finite(V)
  requires fresh : x ∉ V
  requires values : w : V ∪ {x} → M.carrier
  shows moduleSum(M, V ∪ {x}, w) =
    call2(M.add, moduleSum(M, V, restrict(w, V)), w(x))
proof
  obtain ⟨n, natural, e, enumeration⟩ := Finite.enumeration with finite
  have injective := Bijective.injective with enumeration
  have eF := Injective.function with injective
  have freshN : n ∉ n
    exact membership.irreflexive at n
  have extended := adjoinMap.bijective at e, n, V, n, x with enumeration, freshN, fresh
  have domain := natural.successor_as_insert at n
  have codomain : insert(x, V) = V ∪ {x}
    unfold insert
    exact union2.commutative at {x}, V
  rw [← domain, codomain] at extended
  have subset : V ⊆ V ∪ {x}
    intros y hy
    exact union2.left at y, V, {x} with hy
  have restricted := restrict.domain_function at w, V ∪ {x}, M.carrier, V with values, subset
  have whole := moduleSum.enumeration at R, M, V ∪ {x}, w, adjoinMap(e, n, x), succ(n) with *
  have part := moduleSum.enumeration at R, M, V, restrict(w, V), e, n with *
  have extInj := Bijective.injective with extended
  have extF := Injective.function with extInj
  have lastIn := membership.self_successor at n
  have lastValue : adjoinMap(e, n, x)(n) = x
    have mapped := adjoinMap.relates_new at e, n, x
    exact FunctionBetween.apply_value with extF, lastIn, mapped
  have agree : ∀ i ∈ n, w(adjoinMap(e, n, x)(i)) = restrict(w, V)(e(i))
    intros i hi
    have iSucc := membership.into_successor at i, n with hi
    have eiV := FunctionBetween.apply_closed with eF, hi
    have old := FunctionBetween.relates_apply with eF, hi
    have mapped := adjoinMap.relates_old at e, n, x, i, e(i) with old
    have value := FunctionBetween.apply_value with extF, iSucc, mapped
    have restrictValue := restrict.domain_apply at w, V ∪ {x}, M.carrier, V, e(i) with values, subset, eiV
    rw [value, restrictValue]
  have prefix := indexedRingSum.congr at w, restrict(w, V), adjoinMap(e, n, x), e, M.add, M.zero, n
  have same := prefix with agree
  rw [whole, part, indexedRingSum, same, lastValue]

theorem moduleSum.reindex_of (U V e w : Set)
  requires finite : Finite(V)
  requires bijective : BijectiveBetween(e, U, V)
  requires values : w : V → M.carrier
  shows moduleSum(M, U, compose(w, e, U, V, M.carrier)) = moduleSum(M, V, w)
proof
  have injective := Bijective.injective with bijective
  have eF := Injective.function with injective
  obtain ⟨n, natural, f, enumeration⟩ := Finite.enumeration with finite
  have inverse := converse.bijective with bijective
  have g := compose.bijective at converse(e, U, V), f, n, V, U with enumeration, inverse
  have gInj := Bijective.injective with g
  have gF := Injective.function with gInj
  have fInj := Bijective.injective with enumeration
  have fF := Injective.function with fInj
  have invF := converse.function_of_bijective with bijective
  have composite := compose.function at w, e, U, V, M.carrier with eF, values
  have left := moduleSum.enumeration at R, M, U, compose(w, e, U, V, M.carrier), compose(converse(e, U, V), f, n, V, U), n with composite, g
  have right := moduleSum.enumeration at R, M, V, w, f, n with values, enumeration
  have agree : ∀ i ∈ n, compose(w, e, U, V, M.carrier)(compose(converse(e, U, V), f, n, V, U)(i)) = w(f(i))
    intros i hi
    have fi := FunctionBetween.apply_closed with fF, hi
    have gi := FunctionBetween.apply_closed with invF, fi
    have e1 := compose.apply at converse(e, U, V), f, n, V, U, i with fF, invF, hi
    have e2 := compose.apply at w, e, U, V, M.carrier, converse(e, U, V)(f(i)) with eF, values, gi
    have e3 := Bijective.apply_inverse at e, U, V, f(i) with bijective, fi
    rw [e1, e2, e3]
  have same := indexedRingSum.congr at compose(w, e, U, V, M.carrier), w, compose(converse(e, U, V), f, n, V, U), f, M.add, M.zero, n
  rw [left, right]
  exact same with agree

theorem moduleSum.union_of (U V : Set)
  requires finiteU : Finite(U)
  requires finiteV : Finite(V)
  shows ∀ w, (w : U ∪ V → M.carrier) → U ∩ V = ∅ →
    moduleSum(M, U ∪ V, w) = call2(M.add, moduleSum(M, U, restrict(w, U)),
      moduleSum(M, V, restrict(w, V)))
proof
  induction finiteV with G a
  | empty =>
    intros w values disjoint
    have shape := union2.right_empty at U
    rw shape at values
    have refl : U ⊆ U
      intros y hy
      exact hy
    have restricted := restrict.domain_function at w, U, M.carrier, U with values, refl
    have whole := restrict.self at w, U, M.carrier with values
    have emptySubset : ∅ ⊆ U
      intros y hy
      exfalso
      exact empty.membership with y, hy
    have restrictedEmpty := restrict.domain_function at w, U, M.carrier, ∅ with values, emptySubset
    have zero := moduleSum.empty_of at R, M, restrict(w, ∅) with *
    have sumIn := moduleSum.mem_of at R, M, U, w with *
    have unit := Module.add_zero at R, M, moduleSum(M, U, w) with *
    rw [shape, zero, whole, unit]
  | insert using ih =>
    intros w values disjoint
    have shape : U ∪ (G ∪ {a}) = U ∪ G ∪ {a}
      ext y
      simp
    rw shape at values
    have aG : a ∈ G ∪ {a}
      exact union2.right at a, G, {a} with (singleton.self at a)
    have aU : a ∉ U
      intro inU
      have both : a ∈ U ∩ (G ∪ {a})
        exact intersection.membership.backward with ⟨inU, aG⟩
      rw disjoint at both
      exact empty.membership with a, both
    have freshUG : a ∉ U ∪ G
      intro inUG
      have cases := union2.membership.forward with inUG
      cases cases with inU | inG
      . exact aU with inU
      . exact aFresh with inG
    have finiteUG := Finite.union with finiteU, GFinite
    have first := moduleSum.insert_of at R, M, U ∪ G, w, a with finiteUG, freshUG, values
    have subsetUG : U ∪ G ⊆ U ∪ G ∪ {a}
      intros y hy
      exact union2.left at y, U ∪ G, {a} with hy
    have restrictedUG := restrict.domain_function at w, U ∪ G ∪ {a}, M.carrier, U ∪ G with values, subsetUG
    have disjointG : U ∩ G = ∅
      ext y
      constructor
      . intro hy
        obtain ⟨yU, yG⟩ := intersection.membership.forward with hy
        have yGa := union2.left at y, G, {a} with yG
        have both : y ∈ U ∩ (G ∪ {a})
          exact intersection.membership.backward with ⟨yU, yGa⟩
        rw disjoint at both
        exact both
      . intro hy
        exfalso
        exact empty.membership with y, hy
    have split := ih with restrict(w, U ∪ G), restrictedUG, disjointG
    have uSub : U ⊆ U ∪ G
      intros y hy
      exact union2.left at y, U, G with hy
    have gSub : G ⊆ U ∪ G
      intros y hy
      exact union2.right at y, U, G with hy
    have nestedU := restrict.nested at w, U, U ∪ G with uSub
    have nestedG := restrict.nested at w, G, U ∪ G with gSub
    rw [nestedU, nestedG] at split
    have gaSub : G ∪ {a} ⊆ U ∪ G ∪ {a}
      intros y hy
      have cases := union2.membership.forward with hy
      cases cases with inG | inA
      . have inUG := union2.right at y, U, G with inG
        exact union2.left at y, U ∪ G, {a} with inUG
      . exact union2.right at y, U ∪ G, {a} with inA
    have restrictedGa := restrict.domain_function at w, U ∪ G ∪ {a}, M.carrier, G ∪ {a} with values, gaSub
    have second := moduleSum.insert_of at R, M, G, restrict(w, G ∪ {a}), a with GFinite, aFresh, restrictedGa
    have gInGa : G ⊆ G ∪ {a}
      intros y hy
      exact union2.left at y, G, {a} with hy
    have nestedGa := restrict.nested at w, G, G ∪ {a} with gInGa
    have aValue := restrict.domain_apply at w, U ∪ G ∪ {a}, M.carrier, G ∪ {a}, a with values, gaSub, aG
    rw [nestedGa, aValue] at second
    have uSub2 : U ⊆ U ∪ G ∪ {a}
      intros y hy
      have inUG := union2.left at y, U, G with hy
      exact union2.left at y, U ∪ G, {a} with inUG
    have gSub2 : G ⊆ U ∪ G ∪ {a}
      intros y hy
      have inUG := union2.right at y, U, G with hy
      exact union2.left at y, U ∪ G, {a} with inUG
    have restrictedU := restrict.domain_function at w, U ∪ G ∪ {a}, M.carrier, U with values, uSub2
    have restrictedG := restrict.domain_function at w, U ∪ G ∪ {a}, M.carrier, G with values, gSub2
    have sumU := moduleSum.mem_of at R, M, U, restrict(w, U) with *
    have sumG := moduleSum.mem_of at R, M, G, restrict(w, G) with *
    have aIn := union2.right at a, U ∪ G, {a} with (singleton.self at a)
    have wa := FunctionBetween.apply_closed with values, aIn
    have assoc := Module.add_assoc at R, M, moduleSum(M, U, restrict(w, U)), moduleSum(M, G, restrict(w, G)), w(a) with *
    rw [shape, first, split, second]
    exact assoc

theorem moduleSum.product_of (U V : Set)
  requires finiteU : Finite(U)
  requires finiteV : Finite(V)
  shows Finite(U × V) ∧ ∀ w, (w : U × V → M.carrier) →
    moduleSum(M, U × V, w) = moduleSum(M, U, familyRowSums(M, U, V, w))
proof
  induction finiteU with G a
  | empty =>
    have shape := product.left_empty at V
    rw shape
    refine ⟨Finite.empty, ?_⟩
    intros w values
    rw shape at values
    rw shape
    have zero := moduleSum.empty_of at R, M, w with values
    have rowValues : ∀ i ∈ ∅, moduleSum(M, V, familySlice(V, M.carrier, w, i)) ∈ M.carrier
      intros i hi
      exfalso
      exact empty.membership with i, hi
    have rowsF := familyRowSums.function at M, ∅, V, w with rowValues
    have zero2 := moduleSum.empty_of at R, M, familyRowSums(M, ∅, V, w) with rowsF
    rw [zero, zero2]
  | insert using ih =>
    obtain ⟨finiteGV, sumsG⟩ := ih
    have aSelf := singleton.self at a
    have constF := constantFunction.function at V, {a}, a with aSelf
    have idF := identity.function at V
    have eF := pairFunctions.function at constantFunction(V, {a}, a), identity(V), V, {a}, V with constF, idF
    have eApply : ∀ j ∈ V, pairFunctions(constantFunction(V, {a}, a), identity(V), V, {a}, V)(j) = (a, j)
      intros j hj
      have e1 := pairFunctions.apply at constantFunction(V, {a}, a), identity(V), V, {a}, V, j with constF, idF, hj
      have e2 := constantFunction.apply at V, {a}, j, a with hj, aSelf
      have e3 := identity.apply at j, V with hj
      rw [e1, e2, e3]
    have eBij : BijectiveBetween(pairFunctions(constantFunction(V, {a}, a), identity(V), V, {a}, V), V, {a} × V)
      constructor
      . apply Injective.of_pointwise with eF
        intros x hx y hy same
        have ex := eApply with x, hx
        have ey := eApply with y, hy
        rw [ex, ey] at same
        obtain ⟨_, equal⟩ := orderedPair.injective with same
        exact equal
      . apply Surjective.of_pointwise with eF
        intros p hp
        obtain ⟨bound, x, hx, y, hy, pShape⟩ := product.membership.forward with hp
        have xa := singleton.membership.forward with hx
        have ey := eApply with y, hy
        refine ⟨y, hy, ?_⟩
        rw [ey, pShape, xa]
    have equipotent : Equipotent(V, {a} × V)
      unfold Equipotent
      exact ⟨pairFunctions(constantFunction(V, {a}, a), identity(V), V, {a}, V), eBij⟩
    have finiteAV := Finite.of_equipotent with finiteV, equipotent
    have shape := product.union2_left at G, {a}, V
    have finiteWhole := Finite.union with finiteGV, finiteAV
    refine ⟨?_, ?_⟩
    . rw shape
      exact finiteWhole
    . intros w values
      rw shape at values
      have disjoint : (G × V) ∩ ({a} × V) = ∅
        ext p
        constructor
        . intro hp
          exfalso
          obtain ⟨inG, inA⟩ := intersection.membership.forward with hp
          obtain ⟨b1, x, hx, y, hy, s1⟩ := product.membership.forward with inG
          obtain ⟨b2, x2, hx2, y2, hy2, s2⟩ := product.membership.forward with inA
          rw s1 at s2
          obtain ⟨same, _⟩ := orderedPair.injective with s2
          have x2a := singleton.membership.forward with hx2
          rw [← same] at x2a
          rw x2a at hx
          exact aFresh with hx
        . intro hp
          exfalso
          exact empty.membership with p, hp
      have splitLaw := moduleSum.union_of at R, M, G × V, {a} × V with finiteGV, finiteAV
      have split := splitLaw with w, values, disjoint
      have gvSub : G × V ⊆ G × V ∪ {a} × V
        intros p hp
        exact union2.left at p, G × V, {a} × V with hp
      have avSub : {a} × V ⊆ G × V ∪ {a} × V
        intros p hp
        exact union2.right at p, G × V, {a} × V with hp
      have wG := restrict.domain_function at w, G × V ∪ {a} × V, M.carrier, G × V with values, gvSub
      have wA := restrict.domain_function at w, G × V ∪ {a} × V, M.carrier, {a} × V with values, avSub
      have part1 := sumsG with restrict(w, G × V), wG
      have composite := compose.function at restrict(w, {a} × V), pairFunctions(constantFunction(V, {a}, a), identity(V), V, {a}, V), V, {a} × V, M.carrier with eF, wA
      have part2 := moduleSum.reindex_of at R, M, V, {a} × V, pairFunctions(constantFunction(V, {a}, a), identity(V), V, {a}, V), restrict(w, {a} × V) with finiteAV, eBij, wA
      -- the slices of w over G ∪ {a}
      have wValue : ∀ i ∈ G ∪ {a}, ∀ j ∈ V, w((i, j)) ∈ M.carrier
        intros i hi j hj
        have pair := product.pair at i, j, G ∪ {a}, V with hi, hj
        rw shape at pair
        exact FunctionBetween.apply_closed with values, pair
      have sliceF : ∀ i ∈ G ∪ {a}, familySlice(V, M.carrier, w, i) : V → M.carrier
        intros i hi
        have vals := wValue with i, hi
        exact familySlice.function at V, M.carrier, w, i with vals
      have rowValues : ∀ i ∈ G ∪ {a}, moduleSum(M, V, familySlice(V, M.carrier, w, i)) ∈ M.carrier
        intros i hi
        have sf := sliceF with i, hi
        exact moduleSum.mem_of at R, M, V, familySlice(V, M.carrier, w, i) with *
      have rowsF := familyRowSums.function at M, G ∪ {a}, V, w with rowValues
      have inserted := moduleSum.insert_of at R, M, G, familyRowSums(M, G ∪ {a}, V, w), a with GFinite, aFresh, rowsF
      have aIn := union2.right at a, G, {a} with aSelf
      have rowA := familyRowSums.apply at M, G ∪ {a}, V, w, a with rowValues, aIn
      -- the slice at a is the reindexed restriction
      have sliceA := sliceF with a, aIn
      have sliceSame : compose(restrict(w, {a} × V), pairFunctions(constantFunction(V, {a}, a), identity(V), V, {a}, V), V, {a} × V, M.carrier) = familySlice(V, M.carrier, w, a)
        apply FunctionBetween.ext with composite, sliceA
        intros j hj
        have ej := FunctionBetween.apply_closed with eF, hj
        have c1 := compose.apply at restrict(w, {a} × V), pairFunctions(constantFunction(V, {a}, a), identity(V), V, {a}, V), V, {a} × V, M.carrier, j with eF, wA, hj
        have c2 := eApply with j, hj
        have pairIn := product.pair at a, j, {a}, V with aSelf, hj
        have c3 := restrict.domain_apply at w, G × V ∪ {a} × V, M.carrier, {a} × V, (a, j) with values, avSub, pairIn
        have vals := wValue with a, aIn
        have c4 := familySlice.apply at V, M.carrier, w, a, j with vals, hj
        rw [c1, c2, c3, c4]
      -- the rows over G
      have gSub : G ⊆ G ∪ {a}
        intros y hy
        exact union2.left at y, G, {a} with hy
      have rowsRestricted := restrict.domain_function at familyRowSums(M, G ∪ {a}, V, w), G ∪ {a}, M.carrier, G with rowsF, gSub
      have wGValue : ∀ i ∈ G, ∀ j ∈ V, restrict(w, G × V)((i, j)) ∈ M.carrier
        intros i hi j hj
        have pair := product.pair at i, j, G, V with hi, hj
        exact FunctionBetween.apply_closed with wG, pair
      have rowGValues : ∀ i ∈ G, moduleSum(M, V, familySlice(V, M.carrier, restrict(w, G × V), i)) ∈ M.carrier
        intros i hi
        have vals := wGValue with i, hi
        have sf := familySlice.function at V, M.carrier, restrict(w, G × V), i with vals
        exact moduleSum.mem_of at R, M, V, familySlice(V, M.carrier, restrict(w, G × V), i) with *
      have rowsGF := familyRowSums.function at M, G, V, restrict(w, G × V) with rowGValues
      have rowsSame : familyRowSums(M, G, V, restrict(w, G × V)) = restrict(familyRowSums(M, G ∪ {a}, V, w), G)
        apply FunctionBetween.ext with rowsGF, rowsRestricted
        intros i hi
        have iIn := gSub with i, hi
        have r1 := familyRowSums.apply at M, G, V, restrict(w, G × V), i with rowGValues, hi
        have r2 := restrict.domain_apply at familyRowSums(M, G ∪ {a}, V, w), G ∪ {a}, M.carrier, G, i with rowsF, gSub, hi
        have r3 := familyRowSums.apply at M, G ∪ {a}, V, w, i with rowValues, iIn
        have valsG := wGValue with i, hi
        have valsW := wValue with i, iIn
        have sG := familySlice.function at V, M.carrier, restrict(w, G × V), i with valsG
        have sW := familySlice.function at V, M.carrier, w, i with valsW
        have slices : familySlice(V, M.carrier, restrict(w, G × V), i) = familySlice(V, M.carrier, w, i)
          apply FunctionBetween.ext with sG, sW
          intros j hj
          have pair := product.pair at i, j, G, V with hi, hj
          have s1 := familySlice.apply at V, M.carrier, restrict(w, G × V), i, j with valsG, hj
          have s2 := familySlice.apply at V, M.carrier, w, i, j with valsW, hj
          have s3 := restrict.domain_apply at w, G × V ∪ {a} × V, M.carrier, G × V, (i, j) with values, gvSub, pair
          rw [s1, s2, s3]
        rw [r1, r2, r3, slices]
      rw [shape, split, part1, rowsSame, inserted, rowA, ← sliceSame, part2]

end IndexedModuleSums

theorem LinearMap.source_module_of (f M R N : Set)
  requires linear : LinearMap(f, M, R, N)
  shows Module(M, R)
proof
  obtain ⟨moduleM, rest⟩ := linear
  exact moduleM

-- A linear map carries an indexed sum to the indexed sum of the images.
theorem indexedRingSum.linear_map (L M R N w h f : Set, n : Nat)
  requires linear : LinearMap(L, M, R, N)
  shows WeightedValues(w, f, Module.carrier(M), n) →
    (∀ i ∈ n, h(f(i)) = L(w(f(i)))) →
    L(indexedRingSum(w, f, Module.add(M), Module.zero(M), n)) =
      indexedRingSum(h, f, Module.add(N), Module.zero(N), n)
proof
  induction n
  | zero =>
    intros valuesW equations
    obtain ⟨moduleM, moduleN, function, additive, homogeneous⟩ := linear
    have ring := Module.ring with moduleM
    have zeroM := Module.zero_mem at R, M with *
    have fz := FunctionBetween.apply_closed with function, zeroM
    have sum := additive with Module.zero(M), zeroM, Module.zero(M), zeroM
    have unit := Module.zero_add at R, M, Module.zero(M) with *
    rw unit at sum
    have doubled : L(Module.zero(M)) + L(Module.zero(M)) = L(Module.zero(M))
      symm
      exact sum
    have vanish := Module.eq_zero_of_add_self at R, N, L(Module.zero(M)) with *
    simp [indexedRingSum, vanish]
  | succ(k) using ih =>
    intros valuesW equations
    have moduleM := LinearMap.source_module_of with linear
    have ring := Module.ring with moduleM
    have prefixW := WeightedValues.prefix at w, f, Module.carrier(M), k with *
    have lastW := WeightedValues.last at w, f, Module.carrier(M), k with *
    have prefix : ∀ i ∈ k, h(f(i)) = L(w(f(i)))
      intros i hi
      have next := membership.into_successor at i, k with *
      exact equations with i, next
    have last := equations with k, membership.self_successor at k with *
    have previous := ih with prefixW, prefix
    have sumW := indexedRingSum.module_mem at R, M, w, f, k with *
    have law := LinearMap.add_law at L, M, R, N, indexedRingSum(w, f, Module.add(M), Module.zero(M), k), w(f(k)) with *
    rw [indexedRingSum, indexedRingSum, law, previous, last]

-- Section: The operations of a product module on pairs
theorem productModuleAdd.pair_value (M R N a b c d : Set)
  requires moduleM : Module(M, R)
  requires moduleN : Module(N, R)
  requires ha : a ∈ Module.carrier(M)
  requires hb : b ∈ Module.carrier(N)
  requires hc : c ∈ Module.carrier(M)
  requires hd : d ∈ Module.carrier(N)
  shows call2(productModuleAdd(M, R, N), (a, b), (c, d)) =
    (call2(Module.add(M), a, c), call2(Module.add(N), b, d))
proof
  have p1 := product.pair at a, b, Module.carrier(M), Module.carrier(N) with ha, hb
  have p2 := product.pair at c, d, Module.carrier(M), Module.carrier(N) with hc, hd
  have pp := product.pair at (a, b), (c, d), Module.carrier(M) × Module.carrier(N), Module.carrier(M) × Module.carrier(N) with p1, p2
  have value := productModuleAdd.value at M, R, N, ((a, b), (c, d)) with moduleM, moduleN, pp
  have same : call2(productModuleAdd(M, R, N), (a, b), (c, d)) = productModuleAdd(M, R, N)(((a, b), (c, d)))
    unfold call2
    rfl
  rw [same, value, fst.pair, snd.pair, fst.pair, snd.pair, fst.pair, snd.pair]

theorem productModuleNeg.pair_value (M R N a b : Set)
  requires moduleM : Module(M, R)
  requires moduleN : Module(N, R)
  requires ha : a ∈ Module.carrier(M)
  requires hb : b ∈ Module.carrier(N)
  shows productModuleNeg(M, R, N)((a, b)) =
    (apply(Module.neg(M), a), apply(Module.neg(N), b))
proof
  have p1 := product.pair at a, b, Module.carrier(M), Module.carrier(N) with ha, hb
  have value := productModuleNeg.value at M, R, N, (a, b) with moduleM, moduleN, p1
  rw [value, fst.pair, snd.pair]

theorem productModuleSmul.pair_value (M R N r a b : Set)
  requires moduleM : Module(M, R)
  requires moduleN : Module(N, R)
  requires hr : r ∈ Ring.carrier(R)
  requires ha : a ∈ Module.carrier(M)
  requires hb : b ∈ Module.carrier(N)
  shows call2(productModuleSmul(M, R, N), r, (a, b)) =
    (call2(Module.smul(M), r, a), call2(Module.smul(N), r, b))
proof
  have p1 := product.pair at a, b, Module.carrier(M), Module.carrier(N) with ha, hb
  have pp := product.pair at r, (a, b), Ring.carrier(R), Module.carrier(M) × Module.carrier(N) with hr, p1
  have value := productModuleSmul.value at M, R, N, (r, (a, b)) with moduleM, moduleN, pp
  have same : call2(productModuleSmul(M, R, N), r, (a, b)) = productModuleSmul(M, R, N)((r, (a, b)))
    unfold call2
    rfl
  rw [same, value, fst.pair, snd.pair, fst.pair, snd.pair]

-- Section: The projections of a product
theorem firstProjection.function_of (A B : Set)
  shows firstProjection(A, B) : A × B → A
proof
  constructor
    intros p hp
    obtain ⟨bounded, rest⟩ := firstProjection.membership.forward with hp
    exact bounded
  . constructor
      intros z0 first r1 second r2
      unfold relates at r1
      unfold relates at r2
      obtain ⟨_, x, hx, y, hy, s1⟩ := firstProjection.membership.forward with r1
      obtain ⟨_, x2, hx2, y2, hy2, s2⟩ := firstProjection.membership.forward with r2
      obtain ⟨z1, f1⟩ := orderedPair.injective with s1
      obtain ⟨z2, f2⟩ := orderedPair.injective with s2
      rw z1 at z2
      obtain ⟨xx, _⟩ := orderedPair.injective with z2
      rw [f1, f2, xx]
    . intros p hp
      obtain ⟨bound, x, hx, y, hy, shape⟩ := product.membership.forward with hp
      refine ⟨x, hx, ?_⟩
      unfold relates
      rw shape
      apply firstProjection.membership.backward
      have pairIn := product.pair at (x, y), x, A × B, A with (product.pair at x, y, A, B with hx, hy), hx
      exact ⟨pairIn, x, hx, y, hy, rfl⟩

theorem firstProjection.pair_value (A B x y : Set)
  requires hx : x ∈ A
  requires hy : y ∈ B
  shows firstProjection(A, B)((x, y)) = x
proof
  have function := firstProjection.function_of at A, B
  have pIn := product.pair at x, y, A, B with hx, hy
  have pairIn := product.pair at (x, y), x, A × B, A with pIn, hx
  have mapped : relates(firstProjection(A, B), (x, y), x)
    unfold relates
    apply firstProjection.membership.backward
    exact ⟨pairIn, x, hx, y, hy, rfl⟩
  exact FunctionBetween.apply_value with function, pIn, mapped

theorem secondProjection.function_of (A B : Set)
  shows secondProjection(A, B) : A × B → B
proof
  constructor
    intros p hp
    obtain ⟨bounded, rest⟩ := secondProjection.membership.forward with hp
    exact bounded
  . constructor
      intros z0 first r1 second r2
      unfold relates at r1
      unfold relates at r2
      obtain ⟨_, x, hx, y, hy, s1⟩ := secondProjection.membership.forward with r1
      obtain ⟨_, x2, hx2, y2, hy2, s2⟩ := secondProjection.membership.forward with r2
      obtain ⟨z1, f1⟩ := orderedPair.injective with s1
      obtain ⟨z2, f2⟩ := orderedPair.injective with s2
      rw z1 at z2
      obtain ⟨_, yy⟩ := orderedPair.injective with z2
      rw [f1, f2, yy]
    . intros p hp
      obtain ⟨bound, x, hx, y, hy, shape⟩ := product.membership.forward with hp
      refine ⟨y, hy, ?_⟩
      unfold relates
      rw shape
      apply secondProjection.membership.backward
      have pairIn := product.pair at (x, y), y, A × B, B with (product.pair at x, y, A, B with hx, hy), hy
      exact ⟨pairIn, x, hx, y, hy, rfl⟩

theorem secondProjection.pair_value (A B x y : Set)
  requires hx : x ∈ A
  requires hy : y ∈ B
  shows secondProjection(A, B)((x, y)) = y
proof
  have function := secondProjection.function_of at A, B
  have pIn := product.pair at x, y, A, B with hx, hy
  have pairIn := product.pair at (x, y), y, A × B, B with pIn, hy
  have mapped : relates(secondProjection(A, B), (x, y), y)
    unfold relates
    apply secondProjection.membership.backward
    exact ⟨pairIn, x, hx, y, hy, rfl⟩
  exact FunctionBetween.apply_value with function, pIn, mapped

theorem productModule.carrier_eq (M R N : Set)
  shows Module.carrier(productModule(M, R, N)) =
    Module.carrier(M) × Module.carrier(N)
proof
  unfold productModule
  module_projections

theorem productModule.add_eq (M R N : Set)
  shows Module.add(productModule(M, R, N)) = productModuleAdd(M, R, N)
proof
  unfold productModule
  module_projections

theorem productModule.smul_eq (M R N : Set)
  shows Module.smul(productModule(M, R, N)) = productModuleSmul(M, R, N)
proof
  unfold productModule
  module_projections

-- Section: The pointwise operations on functions, pointwise
theorem functionSpace.ext_of (f g A B : Set)
  requires first : f ∈ functionSpace(A, B)
  requires second : g ∈ functionSpace(A, B)
  requires agree : ∀ x ∈ A, f(x) = g(x)
  shows f = g
proof
  have fF := functionSpace.mem_iff.forward with first
  have gF := functionSpace.mem_iff.forward with second
  exact FunctionBetween.ext with fF, gF, agree

theorem functionSpace.apply_mem (f A B x : Set)
  requires member : f ∈ functionSpace(A, B)
  requires hx : x ∈ A
  shows f(x) ∈ B
proof
  have fF := functionSpace.mem_iff.forward with member
  exact FunctionBetween.apply_closed with fF, hx

theorem pointwiseSum.at (R I M u v i : Set)
  requires module : Module(M, R)
  requires first : u ∈ functionSpace(I, Module.carrier(M))
  requires second : v ∈ functionSpace(I, Module.carrier(M))
  requires index : i ∈ I
  shows pointwiseSum(I, M, u, v)(i) = call2(Module.add(M), u(i), v(i))
proof
  have values : ∀ j ∈ I, call2(Module.add(M), u(j), v(j)) ∈ Module.carrier(M)
    intros j hj
    have uj := functionSpace.apply_mem with first, hj
    have vj := functionSpace.apply_mem with second, hj
    exact Module.add_mem at R, M, u(j), v(j) with *
  exact pointwiseSum.apply at I, M, u, v, i with values, index

theorem pointwiseNeg.at (R I M u i : Set)
  requires module : Module(M, R)
  requires first : u ∈ functionSpace(I, Module.carrier(M))
  requires index : i ∈ I
  shows pointwiseNeg(I, M, u)(i) = apply(Module.neg(M), u(i))
proof
  have values : ∀ j ∈ I, apply(Module.neg(M), u(j)) ∈ Module.carrier(M)
    intros j hj
    have uj := functionSpace.apply_mem with first, hj
    exact Module.neg_mem at R, M, u(j) with *
  exact pointwiseNeg.apply at I, M, u, i with values, index

theorem pointwiseSmul.at (R I M r u i : Set)
  requires module : Module(M, R)
  requires scalar : r ∈ Ring.carrier(R)
  requires first : u ∈ functionSpace(I, Module.carrier(M))
  requires index : i ∈ I
  shows pointwiseSmul(I, M, r, u)(i) = call2(Module.smul(M), r, u(i))
proof
  have values : ∀ j ∈ I, call2(Module.smul(M), r, u(j)) ∈ Module.carrier(M)
    intros j hj
    have uj := functionSpace.apply_mem with first, hj
    exact Module.smul_mem at R, M, r, u(j) with *
  exact pointwiseSmul.apply at I, M, r, u, i with values, index

theorem functionModuleAdd.pair_value (R I M u v : Set)
  requires module : Module(M, R)
  requires first : u ∈ functionSpace(I, Module.carrier(M))
  requires second : v ∈ functionSpace(I, Module.carrier(M))
  shows call2(functionModuleAdd(R, I, M), u, v) = pointwiseSum(I, M, u, v)
proof
  have pp := product.pair at u, v, functionSpace(I, Module.carrier(M)), functionSpace(I, Module.carrier(M)) with first, second
  have value := functionModuleAdd.value at R, I, M, (u, v) with module, pp
  have same : call2(functionModuleAdd(R, I, M), u, v) = functionModuleAdd(R, I, M)((u, v))
    unfold call2
    rfl
  rw [same, value, fst.pair, snd.pair]

theorem functionModuleSmul.pair_value (R I M r u : Set)
  requires module : Module(M, R)
  requires scalar : r ∈ Ring.carrier(R)
  requires first : u ∈ functionSpace(I, Module.carrier(M))
  shows call2(functionModuleSmul(R, I, M), r, u) = pointwiseSmul(I, M, r, u)
proof
  have pp := product.pair at r, u, Ring.carrier(R), functionSpace(I, Module.carrier(M)) with scalar, first
  have value := functionModuleSmul.value at R, I, M, (r, u) with module, pp
  have same : call2(functionModuleSmul(R, I, M), r, u) = functionModuleSmul(R, I, M)((r, u))
    unfold call2
    rfl
  rw [same, value, fst.pair, snd.pair]

theorem functionModule.carrier_eq (R I M : Set)
  shows Module.carrier(functionModule(R, I, M)) = functionSpace(I, Module.carrier(M))
proof
  unfold functionModule
  module_projections

theorem functionModule.add_eq (R I M : Set)
  shows Module.add(functionModule(R, I, M)) = functionModuleAdd(R, I, M)
proof
  unfold functionModule
  module_projections

theorem functionModule.smul_eq (R I M : Set)
  shows Module.smul(functionModule(R, I, M)) = functionModuleSmul(R, I, M)
proof
  unfold functionModule
  module_projections

theorem functionModule.zero_eq (R I M : Set)
  shows Module.zero(functionModule(R, I, M)) = constantFunction(I, Module.carrier(M), Module.zero(M))
proof
  unfold functionModule
  module_projections

-- Graph laws of evaluation and precomposition.
theorem evaluationMap.graph_relates (I M i u : Set)
  requires index : u ∈ functionSpace(I, Module.carrier(M))
  requires valueIn : u(i) ∈ Module.carrier(M)
  shows relates(evaluationMap(I, M, i), u, u(i))
proof
  unfold relates
  apply evaluationMap.membership.backward
  refine ⟨(product.pair at u, u(i), functionSpace(I, Module.carrier(M)), Module.carrier(M) with index, valueIn), u, index, rfl⟩

theorem evaluationMap.graph_function (I M i : Set)
  requires values : ∀ u ∈ functionSpace(I, Module.carrier(M)), u(i) ∈ Module.carrier(M)
  shows evaluationMap(I, M, i) : functionSpace(I, Module.carrier(M)) → Module.carrier(M)
proof
  constructor
    intros p member
    obtain ⟨bounded, witnesses⟩ := evaluationMap.membership.forward with member
    exact bounded
  . constructor
      intros z0 first xFirst second xSecond
      unfold relates at xFirst
      obtain ⟨_, a1, a1In, firstShape⟩ := evaluationMap.membership.forward with xFirst
      unfold relates at xSecond
      obtain ⟨_, a2, a2In, secondShape⟩ := evaluationMap.membership.forward with xSecond
      obtain ⟨xi, firstEqual⟩ := orderedPair.injective with firstShape
      obtain ⟨xj, secondEqual⟩ := orderedPair.injective with secondShape
      rw [firstEqual, secondEqual]
      cc
    . intros u xIn
      have valueIn := values with u, xIn
      refine ⟨u(i), valueIn, (evaluationMap.graph_relates at I, M, i, u with xIn, valueIn)⟩

theorem evaluationMap.graph_apply (I M i u : Set)
  requires values : ∀ u ∈ functionSpace(I, Module.carrier(M)), u(i) ∈ Module.carrier(M)
  requires index : u ∈ functionSpace(I, Module.carrier(M))
  shows evaluationMap(I, M, i)(u) = u(i)
proof
  have function := evaluationMap.graph_function at I, M, i with values
  have valueIn := values with u, index
  have mapped := evaluationMap.graph_relates at I, M, i, u with index, valueIn
  exact FunctionBetween.apply_value with function, index, mapped

theorem precompose.graph_relates (I J M g u : Set)
  requires index : u ∈ functionSpace(I, Module.carrier(M))
  requires valueIn : compose(u, g, J, I, Module.carrier(M)) ∈ functionSpace(J, Module.carrier(M))
  shows relates(precompose(I, J, M, g), u, compose(u, g, J, I, Module.carrier(M)))
proof
  unfold relates
  apply precompose.membership.backward
  refine ⟨(product.pair at u, compose(u, g, J, I, Module.carrier(M)), functionSpace(I, Module.carrier(M)), functionSpace(J, Module.carrier(M)) with index, valueIn), u, index, rfl⟩

theorem precompose.graph_function (I J M g : Set)
  requires values : ∀ u ∈ functionSpace(I, Module.carrier(M)), compose(u, g, J, I, Module.carrier(M)) ∈ functionSpace(J, Module.carrier(M))
  shows precompose(I, J, M, g) : functionSpace(I, Module.carrier(M)) → functionSpace(J, Module.carrier(M))
proof
  constructor
    intros p member
    obtain ⟨bounded, witnesses⟩ := precompose.membership.forward with member
    exact bounded
  . constructor
      intros z0 first xFirst second xSecond
      unfold relates at xFirst
      obtain ⟨_, a1, a1In, firstShape⟩ := precompose.membership.forward with xFirst
      unfold relates at xSecond
      obtain ⟨_, a2, a2In, secondShape⟩ := precompose.membership.forward with xSecond
      obtain ⟨xi, firstEqual⟩ := orderedPair.injective with firstShape
      obtain ⟨xj, secondEqual⟩ := orderedPair.injective with secondShape
      rw [firstEqual, secondEqual]
      cc
    . intros u xIn
      have valueIn := values with u, xIn
      refine ⟨compose(u, g, J, I, Module.carrier(M)), valueIn, (precompose.graph_relates at I, J, M, g, u with xIn, valueIn)⟩

theorem precompose.graph_apply (I J M g u : Set)
  requires values : ∀ u ∈ functionSpace(I, Module.carrier(M)), compose(u, g, J, I, Module.carrier(M)) ∈ functionSpace(J, Module.carrier(M))
  requires index : u ∈ functionSpace(I, Module.carrier(M))
  shows precompose(I, J, M, g)(u) = compose(u, g, J, I, Module.carrier(M))
proof
  have function := precompose.graph_function at I, J, M, g with values
  have valueIn := values with u, index
  have mapped := precompose.graph_relates at I, J, M, g, u with index, valueIn
  exact FunctionBetween.apply_value with function, index, mapped

-- Section: The operations of the module of linear maps
theorem linearMaps.space (f M R N : Set)
  requires member : f ∈ linearMaps(M, R, N)
  shows f ∈ functionSpace(Module.carrier(M), Module.carrier(N))
proof
  obtain ⟨space, linear⟩ := linearMaps.membership.forward with member
  exact space

theorem linearMaps.add_closed (f g M R N : Set)
  requires first : f ∈ linearMaps(M, R, N)
  requires second : g ∈ linearMaps(M, R, N)
  shows pointwiseSum(Module.carrier(M), N, f, g) ∈ linearMaps(M, R, N)
proof
  have lf := linearMaps.linear with first
  have lg := linearMaps.linear with second
  have sum := LinearMap.pointwise_add with lf, lg
  exact linearMaps.of_linear with sum

theorem linearMaps.neg_closed (f M R N : Set)
  requires first : f ∈ linearMaps(M, R, N)
  shows pointwiseNeg(Module.carrier(M), N, f) ∈ linearMaps(M, R, N)
proof
  have lf := linearMaps.linear with first
  have negated := LinearMap.pointwise_neg with lf
  exact linearMaps.of_linear with negated

theorem linearMaps.smul_closed (f M R N r : Set)
  requires comm : CommRing(R)
  requires first : f ∈ linearMaps(M, R, N)
  requires scalar : r ∈ Ring.carrier(R)
  shows pointwiseSmul(Module.carrier(M), N, r, f) ∈ linearMaps(M, R, N)
proof
  have lf := linearMaps.linear with first
  have scaled := LinearMap.pointwise_smul with comm, lf, scalar
  exact linearMaps.of_linear with scaled

theorem linearMaps.zero_mem (M R N : Set)
  requires moduleM : Module(M, R)
  requires moduleN : Module(N, R)
  shows constantFunction(Module.carrier(M), Module.carrier(N), Module.zero(N)) ∈ linearMaps(M, R, N)
proof
  have ring := Module.ring with moduleM
  have zeroN := Module.zero_mem at R, N with *
  have function := constantFunction.function at Module.carrier(M), Module.carrier(N), Module.zero(N) with zeroN
  have linear : LinearMap(constantFunction(Module.carrier(M), Module.carrier(N), Module.zero(N)), M, R, N)
    apply LinearMap.of_laws with moduleM, moduleN, function
    . intros v hv w hw
      have vw := Module.add_mem at R, M, v, w with *
      have c1 := constantFunction.apply at Module.carrier(M), Module.carrier(N), call2(Module.add(M), v, w), Module.zero(N) with vw, zeroN
      have c2 := constantFunction.apply at Module.carrier(M), Module.carrier(N), v, Module.zero(N) with hv, zeroN
      have c3 := constantFunction.apply at Module.carrier(M), Module.carrier(N), w, Module.zero(N) with hw, zeroN
      have unit := Module.add_zero at R, N, Module.zero(N) with *
      rw [c1, c2, c3, unit]
    . intros r hr v hv
      have rv := Module.smul_mem at R, M, r, v with *
      have c1 := constantFunction.apply at Module.carrier(M), Module.carrier(N), call2(Module.smul(M), r, v), Module.zero(N) with rv, zeroN
      have c2 := constantFunction.apply at Module.carrier(M), Module.carrier(N), v, Module.zero(N) with hv, zeroN
      have vanish := smul_zero at R, N, r with *
      rw [c1, c2, vanish]
  exact linearMaps.of_linear with linear

theorem linearMapAdd.pair_value (M R N f g : Set)
  requires ring : CommRing(R)
  requires moduleM : Module(M, R)
  requires moduleN : Module(N, R)
  requires first : f ∈ linearMaps(M, R, N)
  requires second : g ∈ linearMaps(M, R, N)
  shows call2(linearMapAdd(M, R, N), f, g) = pointwiseSum(Module.carrier(M), N, f, g)
proof
  have pp := product.pair at f, g, linearMaps(M, R, N), linearMaps(M, R, N) with first, second
  have value := linearMapAdd.value at M, R, N, (f, g) with ring, moduleM, moduleN, pp
  have same : call2(linearMapAdd(M, R, N), f, g) = linearMapAdd(M, R, N)((f, g))
    unfold call2
    rfl
  rw [same, value, fst.pair, snd.pair]

theorem linearMapSmul.pair_value (M R N r f : Set)
  requires ring : CommRing(R)
  requires moduleM : Module(M, R)
  requires moduleN : Module(N, R)
  requires scalar : r ∈ Ring.carrier(R)
  requires first : f ∈ linearMaps(M, R, N)
  shows call2(linearMapSmul(M, R, N), r, f) = pointwiseSmul(Module.carrier(M), N, r, f)
proof
  have pp := product.pair at r, f, Ring.carrier(R), linearMaps(M, R, N) with scalar, first
  have value := linearMapSmul.value at M, R, N, (r, f) with ring, moduleM, moduleN, pp
  have same : call2(linearMapSmul(M, R, N), r, f) = linearMapSmul(M, R, N)((r, f))
    unfold call2
    rfl
  rw [same, value, fst.pair, snd.pair]

theorem homModule.carrier_eq (M R N : Set)
  shows Module.carrier(homModule(M, R, N)) = linearMaps(M, R, N)
proof
  unfold homModule
  module_projections

theorem homModule.add_eq (M R N : Set)
  shows Module.add(homModule(M, R, N)) = linearMapAdd(M, R, N)
proof
  unfold homModule
  module_projections

theorem homModule.smul_eq (M R N : Set)
  shows Module.smul(homModule(M, R, N)) = linearMapSmul(M, R, N)
proof
  unfold homModule
  module_projections

theorem LinearMap.target_module_of (f M R N : Set)
  requires linear : LinearMap(f, M, R, N)
  shows Module(N, R)
proof
  obtain ⟨moduleM, moduleN, rest⟩ := linear
  exact moduleN

theorem LinearMap.neg_law (R M N f v : Set)
  requires ring : Ring(R)
  requires linear : LinearMap(f, M, R, N)
  requires vector : v ∈ Module.carrier(M)
  shows f(apply(Module.neg(M), v)) = apply(Module.neg(N), f(v))
proof
  have moduleM := LinearMap.source_module_of with linear
  have moduleN := LinearMap.target_module_of with linear
  have negIn := Module.neg_mem at R, M, v with *
  have fv := LinearMap.value_mem at f, M, R, N, v with linear, vector
  have fn := LinearMap.value_mem at f, M, R, N, apply(Module.neg(M), v) with linear, negIn
  have sum := LinearMap.add_law at f, M, R, N, apply(Module.neg(M), v), v with linear, negIn, vector
  have cancel := Module.neg_add at R, M, v with *
  have zeroM := Module.zero_mem at R, M with *
  have sum0 := LinearMap.add_law at f, M, R, N, Module.zero(M), Module.zero(M) with linear, zeroM, zeroM
  have unit := Module.zero_add at R, M, Module.zero(M) with *
  rw unit at sum0
  have f0 := LinearMap.value_mem at f, M, R, N, Module.zero(M) with linear, zeroM
  have doubled : call2(Module.add(N), f(Module.zero(M)), f(Module.zero(M))) = f(Module.zero(M))
    symm
    exact sum0
  have zero := Module.eq_zero_of_add_self at R, N, f(Module.zero(M)) with *
  rw [cancel, zero] at sum
  have total : call2(Module.add(N), f(apply(Module.neg(M), v)), f(v)) = Module.zero(N)
    symm
    exact sum
  exact Module.eq_neg_of_add_eq_zero at R, N, f(apply(Module.neg(M), v)), f(v) with *

theorem submoduleModule.module_of (R M N : Set)
  requires ring : Ring(R)
  requires module : Module(M, R)
  requires sub : SubmoduleOf(N, M, R)
  shows Module(submoduleModule(M, R, N), R)
proof
  obtain ⟨_, subset, zeroIn, addIn, smulIn⟩ := SubmoduleOf.parts with sub
  have parts := SubmoduleOf.additive_parts with sub
  have abelian := AbelianGroup.of_parts with parts
  obtain ⟨shape, ringR, addF, zeroM, negF, smulF, rest⟩ := module
  have addR := restrictBinary.function_on with addF, subset, addIn
  have negIn : ∀ v ∈ N, apply(Module.neg(M), v) ∈ N
    intros v hv
    exact SubmoduleOf.neg_closed with sub, hv
  have negR := restrict.function at Module.neg(M), Module.carrier(M), Module.carrier(M), N, N with negF, subset, negIn
  have refl : Ring.carrier(R) ⊆ Ring.carrier(R)
    intros r hr
    exact hr
  have bounded := product.monotone with refl, subset
  have smulValues : ∀ p ∈ Ring.carrier(R) × N, Module.smul(M)(p) ∈ N
    intros p hp
    obtain ⟨bound, r, hr, v, hv, pShape⟩ := product.membership.forward with hp
    have output := smulIn with r, hr, v, hv
    unfold call2 at output
    rwa pShape
  have smulR := restrict.function at Module.smul(M), Ring.carrier(R) × Module.carrier(M), Module.carrier(M), Ring.carrier(R) × N, N with smulF, bounded, smulValues
  have addV : ∀ x y ∈ N, call2(restrict(Module.add(M), N × N), x, y) = call2(Module.add(M), x, y)
    intros x hx y hy
    exact restrictBinary.value_on with addF, subset, hx, hy
  have smulV : ∀ r ∈ Ring.carrier(R), ∀ v ∈ N, call2(restrict(Module.smul(M), Ring.carrier(R) × N), r, v) = call2(Module.smul(M), r, v)
    intros r hr v hv
    have pair := product.pair at r, v, Ring.carrier(R), N with hr, hv
    unfold call2
    exact restrict.domain_apply at Module.smul(M), Ring.carrier(R) × Module.carrier(M), Module.carrier(M), Ring.carrier(R) × N, (r, v) with smulF, bounded, pair
  unfold submoduleModule
  apply Module.intro with ring, addR, zeroIn, negR, smulR, abelian
  . intros r hr v hv w hw
    have vw := addIn with v, hv, w, hw
    have rv := smulIn with r, hr, v, hv
    have rw2 := smulIn with r, hr, w, hw
    have vM := subset with v, hv
    have wM := subset with w, hw
    have law := smul_add at R, M, r, v, w with *
    have e1 := addV with v, hv, w, hw
    have e2 := smulV with r, hr, call2(Module.add(M), v, w), vw
    have e3 := smulV with r, hr, v, hv
    have e4 := smulV with r, hr, w, hw
    have e5 := addV with call2(Module.smul(M), r, v), rv, call2(Module.smul(M), r, w), rw2
    rw [e1, e2, e3, e4, e5]
    exact law
  . intros r hr t ht v hv
    have rv := smulIn with r, hr, v, hv
    have tv := smulIn with t, ht, v, hv
    have sumR := Ring.add_mem at R, r, t with *
    have vM := subset with v, hv
    have law := add_smul at R, M, r, t, v with *
    have e1 := smulV with call2(Ring.add(R), r, t), sumR, v, hv
    have e2 := smulV with r, hr, v, hv
    have e3 := smulV with t, ht, v, hv
    have e4 := addV with call2(Module.smul(M), r, v), rv, call2(Module.smul(M), t, v), tv
    rw [e1, e2, e3, e4]
    exact law
  . intros r hr t ht v hv
    have tv := smulIn with t, ht, v, hv
    have prodR := Ring.mul_mem at R, r, t with *
    have vM := subset with v, hv
    have law := mul_smul at R, M, r, t, v with *
    have e1 := smulV with call2(Ring.mul(R), r, t), prodR, v, hv
    have e2 := smulV with t, ht, v, hv
    have e3 := smulV with r, hr, call2(Module.smul(M), t, v), tv
    rw [e1, e2, e3]
    exact law
  . intros v hv
    have oneIn := Ring.one_mem at R with ring
    have vM := subset with v, hv
    have law := one_smul at R, M, v with *
    have e1 := smulV with Ring.one(R), oneIn, v, hv
    rw e1
    exact law

theorem moduleSpan.submodule_of (R M S : Set)
  requires ring : Ring(R)
  requires module : Module(M, R)
  shows SubmoduleOf(moduleSpan(M, R, S), M, R)
proof
  have zeroM := Module.zero_mem at R, M with *
  unfold SubmoduleOf
  refine ⟨module, ?_, ?_, ?_, ?_⟩
  . intros v hv
    obtain ⟨vIn, _⟩ := moduleSpan.membership.forward with hv
    exact vIn
  . apply moduleSpan.membership.backward
    refine ⟨zeroM, ?_⟩
    intros N sub contains
    obtain ⟨_, _, z, _, _⟩ := SubmoduleOf.parts with sub
    exact z
  . intros v hv w hw
    obtain ⟨vIn, vAll⟩ := moduleSpan.membership.forward with hv
    obtain ⟨wIn, wAll⟩ := moduleSpan.membership.forward with hw
    have sumIn := Module.add_mem at R, M, v, w with *
    apply moduleSpan.membership.backward
    refine ⟨sumIn, ?_⟩
    intros N sub contains
    have vN := vAll with N, sub, contains
    have wN := wAll with N, sub, contains
    obtain ⟨_, _, _, a, _⟩ := SubmoduleOf.parts with sub
    exact a with v, vN, w, wN
  . intros r hr v hv
    obtain ⟨vIn, vAll⟩ := moduleSpan.membership.forward with hv
    have smulIn := Module.smul_mem at R, M, r, v with *
    apply moduleSpan.membership.backward
    refine ⟨smulIn, ?_⟩
    intros N sub contains
    have vN := vAll with N, sub, contains
    obtain ⟨_, _, _, _, m⟩ := SubmoduleOf.parts with sub
    exact m with r, hr, v, vN

theorem moduleSpan.subset_of (R M S : Set)
  requires ring : Ring(R)
  requires module : Module(M, R)
  requires subset : S ⊆ M.carrier
  shows S ⊆ moduleSpan(M, R, S)
proof
  intros v hv
  have vIn := subset with v, hv
  apply moduleSpan.membership.backward
  refine ⟨vIn, ?_⟩
  intros N sub contains
  exact contains with v, hv

theorem moduleSpan.least_of (R M S N : Set)
  requires ring : Ring(R)
  requires module : Module(M, R)
  requires subset : S ⊆ M.carrier
  requires sub : SubmoduleOf(N, M, R)
  shows moduleSpan(M, R, S) ⊆ N ↔ S ⊆ N
proof
  constructor
  . intro within
    intros v hv
    have inSpan := (moduleSpan.subset_of at R, M, S with *) with v, hv
    exact within with v, inSpan
  . intro contains
    intros v hv
    obtain ⟨vIn, vAll⟩ := moduleSpan.membership.forward with hv
    exact vAll with N, sub, contains

-- Section: Congruence modulo a submodule
-- The relation x ~ y iff x − y ∈ N is an equivalence compatible with the
-- operations; the classes, the action on classes, and the quotient laws.
section QuotientModules
variable (R M N : Set)
hypothesis ring : Ring(R)
hypothesis module : Module(M, R)
hypothesis sub : SubmoduleOf(N, M, R)

theorem submoduleRelation.relates_iff (x y : Set)
  shows relates(submoduleRelation(M, N), x, y) ↔
    (x ∈ M.carrier ∧ y ∈ M.carrier ∧ call2(M.add, x, apply(M.neg, y)) ∈ N)
proof
  constructor
  . intro related
    unfold relates at related
    obtain ⟨bound, a, ha, b, hb, shape, diff⟩ := submoduleRelation.membership.forward with related
    obtain ⟨xa, yb⟩ := orderedPair.injective with shape
    rw [xa, yb]
    exact ⟨ha, hb, diff⟩
  . intro facts
    obtain ⟨hx, hy, diff⟩ := facts
    unfold relates
    apply submoduleRelation.membership.backward
    have pair := product.pair at x, y, M.carrier, M.carrier with hx, hy
    exact ⟨pair, x, hx, y, hy, rfl, diff⟩

theorem submoduleRelation.equivalence
  shows Equivalence(M.carrier, submoduleRelation(M, N))
proof
  obtain ⟨_, subset, zeroIn, addIn, smulIn⟩ := SubmoduleOf.parts with sub
  unfold Equivalence
  refine ⟨?_, ?_, ?_, ?_⟩
  . intros p hp
    obtain ⟨bound, rest⟩ := submoduleRelation.membership.forward with hp
    exact bound
  . intros x hx
    have cancel := Module.add_neg at R, M, x with *
    apply (submoduleRelation.relates_iff at R, M, N, x, x with *).backward
    rw cancel
    exact ⟨hx, hx, zeroIn⟩
  . intros x hx y hy related
    obtain ⟨_, _, diff⟩ := (submoduleRelation.relates_iff at R, M, N, x, y with *).forward with related
    have negDiff := SubmoduleOf.neg_closed with sub, diff
    have ny := Module.neg_mem at R, M, y with *
    have distribute := Module.neg_add_distrib at R, M, x, apply(M.neg, y) with *
    have double := Module.neg_neg at R, M, y with *
    have swap := Module.add_comm at R, M, apply(M.neg, x), y with *
    rw [distribute, double, swap] at negDiff
    apply (submoduleRelation.relates_iff at R, M, N, y, x with *).backward
    exact ⟨hy, hx, negDiff⟩
  . intros x hx y hy z hz first second
    obtain ⟨_, _, d1⟩ := (submoduleRelation.relates_iff at R, M, N, x, y with *).forward with first
    obtain ⟨_, _, d2⟩ := (submoduleRelation.relates_iff at R, M, N, y, z with *).forward with second
    have total := addIn with call2(M.add, x, apply(M.neg, y)), d1, call2(M.add, y, apply(M.neg, z)), d2
    have ny := Module.neg_mem at R, M, y with *
    have nz := Module.neg_mem at R, M, z with *
    have a1 := Module.add_assoc at R, M, x, apply(M.neg, y), call2(M.add, y, apply(M.neg, z)) with *
    have a2 := Module.add_assoc at R, M, apply(M.neg, y), y, apply(M.neg, z) with *
    have c1 := Module.neg_add at R, M, y with *
    have c2 := Module.zero_add at R, M, apply(M.neg, z) with *
    rw [a1, ← a2, c1, c2] at total
    apply (submoduleRelation.relates_iff at R, M, N, x, z with *).backward
    exact ⟨hx, hz, total⟩

theorem submoduleRelation.compatible_add
  shows CompatibleBinary(M.carrier, submoduleRelation(M, N), M.add)
proof
  obtain ⟨_, subset, zeroIn, addIn, smulIn⟩ := SubmoduleOf.parts with sub
  intros x hx y hy u hu v hv first second
  obtain ⟨_, _, d1⟩ := (submoduleRelation.relates_iff at R, M, N, x, y with *).forward with first
  obtain ⟨_, _, d2⟩ := (submoduleRelation.relates_iff at R, M, N, u, v with *).forward with second
  have total := addIn with call2(M.add, x, apply(M.neg, y)), d1, call2(M.add, u, apply(M.neg, v)), d2
  have ny := Module.neg_mem at R, M, y with *
  have nv := Module.neg_mem at R, M, v with *
  have xu := Module.add_mem at R, M, x, u with *
  have yv := Module.add_mem at R, M, y, v with *
  have shuffle := Module.add_add_add_comm at R, M, x, apply(M.neg, y), u, apply(M.neg, v) with *
  have distribute := Module.neg_add_distrib at R, M, y, v with *
  rw [shuffle, ← distribute] at total
  apply (submoduleRelation.relates_iff at R, M, N, call2(M.add, x, u), call2(M.add, y, v) with *).backward
  exact ⟨xu, yv, total⟩

theorem submoduleRelation.compatible_neg
  shows CompatibleUnary(M.carrier, submoduleRelation(M, N), M.neg)
proof
  intros x hx y hy related
  obtain ⟨_, _, diff⟩ := (submoduleRelation.relates_iff at R, M, N, x, y with *).forward with related
  have negDiff := SubmoduleOf.neg_closed with sub, diff
  have nx := Module.neg_mem at R, M, x with *
  have ny := Module.neg_mem at R, M, y with *
  have distribute := Module.neg_add_distrib at R, M, x, apply(M.neg, y) with *
  rw distribute at negDiff
  apply (submoduleRelation.relates_iff at R, M, N, apply(M.neg, x), apply(M.neg, y) with *).backward
  exact ⟨nx, ny, negDiff⟩

theorem submoduleRelation.class_eq_iff (x y : Set)
  requires hx : x ∈ M.carrier
  requires hy : y ∈ M.carrier
  shows ⟦x⟧[M.carrier, submoduleRelation(M, N)] = ⟦y⟧[M.carrier, submoduleRelation(M, N)] ↔
    call2(M.add, x, apply(M.neg, y)) ∈ N
proof
  have equivalence := submoduleRelation.equivalence with *
  constructor
  . intro same
    have related := equivalenceClass.related_of_eq with equivalence, hx, hy, same
    obtain ⟨_, _, diff⟩ := (submoduleRelation.relates_iff at R, M, N, x, y with *).forward with related
    exact diff
  . intro diff
    have related := (submoduleRelation.relates_iff at R, M, N, x, y with *).backward with ⟨hx, hy, diff⟩
    exact equivalenceClass.eq with equivalence, hx, hy, related

theorem quotientScalar.function_of
  shows quotientScalar(M, R, N) : R.carrier × (M.carrier ⧸ submoduleRelation(M, N)) → (M.carrier ⧸ submoduleRelation(M, N))
proof
  have equivalence := submoduleRelation.equivalence with *
  obtain ⟨_, subset, zeroIn, addIn, smulIn⟩ := SubmoduleOf.parts with sub
  constructor
    intros p hp
    obtain ⟨bounded, rest⟩ := quotientScalar.membership.forward with hp
    exact bounded
  . constructor
      intros z0 first r1 second r2
      unfold relates at r1
      unfold relates at r2
      obtain ⟨_, r, hr, v, hv, s1⟩ := quotientScalar.membership.forward with r1
      obtain ⟨_, t, ht, w, hw, s2⟩ := quotientScalar.membership.forward with r2
      obtain ⟨z1, f1⟩ := orderedPair.injective with s1
      obtain ⟨z2, f2⟩ := orderedPair.injective with s2
      rw z1 at z2
      obtain ⟨rt, vw⟩ := orderedPair.injective with z2
      rw [f1, f2, rt]
      have diff := (submoduleRelation.class_eq_iff at R, M, N, v, w with *).forward with vw
      have scaled := smulIn with t, ht, call2(M.add, v, apply(M.neg, w)), diff
      have nw := Module.neg_mem at R, M, w with *
      have distribute := smul_add at R, M, t, v, apply(M.neg, w) with *
      have negate := smul_neg at R, M, t, w with *
      rw [distribute, negate] at scaled
      have tv := Module.smul_mem at R, M, t, v with *
      have tw := Module.smul_mem at R, M, t, w with *
      exact (submoduleRelation.class_eq_iff at R, M, N, call2(M.smul, t, v), call2(M.smul, t, w) with *).backward with scaled
    . intros p hp
      obtain ⟨bound, r, hr, X, hX, shape⟩ := product.membership.forward with hp
      obtain ⟨v, hv, vX⟩ := quotient.representative with hX
      have rv := Module.smul_mem at R, M, r, v with *
      have classIn := quotient.contains_class at M.carrier, submoduleRelation(M, N), call2(M.smul, r, v) with equivalence, rv
      refine ⟨⟦call2(M.smul, r, v)⟧[M.carrier, submoduleRelation(M, N)], classIn, ?_⟩
      unfold relates
      rw [shape, vX]
      apply quotientScalar.membership.backward
      have vClass := quotient.contains_class at M.carrier, submoduleRelation(M, N), v with equivalence, hv
      have inner := product.pair at r, ⟦v⟧[M.carrier, submoduleRelation(M, N)], R.carrier, (M.carrier ⧸ submoduleRelation(M, N)) with hr, vClass
      have outer := product.pair at (r, ⟦v⟧[M.carrier, submoduleRelation(M, N)]), ⟦call2(M.smul, r, v)⟧[M.carrier, submoduleRelation(M, N)], R.carrier × (M.carrier ⧸ submoduleRelation(M, N)), (M.carrier ⧸ submoduleRelation(M, N)) with inner, classIn
      exact ⟨outer, r, hr, v, hv, rfl⟩

theorem quotientScalar.classes (r v : Set)
  requires hr : r ∈ R.carrier
  requires hv : v ∈ M.carrier
  shows call2(quotientScalar(M, R, N), r, ⟦v⟧[M.carrier, submoduleRelation(M, N)]) =
    ⟦call2(M.smul, r, v)⟧[M.carrier, submoduleRelation(M, N)]
proof
  have equivalence := submoduleRelation.equivalence with *
  have function := quotientScalar.function_of with *
  have vClass := quotient.contains_class at M.carrier, submoduleRelation(M, N), v with equivalence, hv
  have rv := Module.smul_mem at R, M, r, v with *
  have classIn := quotient.contains_class at M.carrier, submoduleRelation(M, N), call2(M.smul, r, v) with equivalence, rv
  have inner := product.pair at r, ⟦v⟧[M.carrier, submoduleRelation(M, N)], R.carrier, (M.carrier ⧸ submoduleRelation(M, N)) with hr, vClass
  have outer := product.pair at (r, ⟦v⟧[M.carrier, submoduleRelation(M, N)]), ⟦call2(M.smul, r, v)⟧[M.carrier, submoduleRelation(M, N)], R.carrier × (M.carrier ⧸ submoduleRelation(M, N)), (M.carrier ⧸ submoduleRelation(M, N)) with inner, classIn
  have mapped : relates(quotientScalar(M, R, N), (r, ⟦v⟧[M.carrier, submoduleRelation(M, N)]), ⟦call2(M.smul, r, v)⟧[M.carrier, submoduleRelation(M, N)])
    unfold relates
    apply quotientScalar.membership.backward
    exact ⟨outer, r, hr, v, hv, rfl⟩
  have value := FunctionBetween.apply_value with function, inner, mapped
  have same : call2(quotientScalar(M, R, N), r, ⟦v⟧[M.carrier, submoduleRelation(M, N)]) = quotientScalar(M, R, N)((r, ⟦v⟧[M.carrier, submoduleRelation(M, N)]))
    unfold call2
    rfl
  rw [same, value]

theorem quotientAdd.classes (x y : Set)
  requires hx : x ∈ M.carrier
  requires hy : y ∈ M.carrier
  shows call2(quotientBinary(M.carrier, submoduleRelation(M, N), M.add), ⟦x⟧[M.carrier, submoduleRelation(M, N)], ⟦y⟧[M.carrier, submoduleRelation(M, N)]) =
    ⟦call2(M.add, x, y)⟧[M.carrier, submoduleRelation(M, N)]
proof
  have equivalence := submoduleRelation.equivalence with *
  have compatible := submoduleRelation.compatible_add with *
  obtain ⟨shape, ringR, addF, rest⟩ := module
  exact quotientBinary.classes with equivalence, addF, compatible, hx, hy

theorem quotientNeg.classes (x : Set)
  requires hx : x ∈ M.carrier
  shows quotientUnary(M.carrier, submoduleRelation(M, N), M.neg)(⟦x⟧[M.carrier, submoduleRelation(M, N)]) =
    ⟦apply(M.neg, x)⟧[M.carrier, submoduleRelation(M, N)]
proof
  have equivalence := submoduleRelation.equivalence with *
  have compatible := submoduleRelation.compatible_neg with *
  obtain ⟨shape, ringR, addF, zeroIn, negF, rest⟩ := module
  exact quotientUnary.classes with equivalence, negF, compatible, hx

theorem quotientModule.module_of
  shows Module(quotientModule(M, R, N), R)
proof
  have equivalence := submoduleRelation.equivalence at R, M, N with *
  have compatibleAdd := submoduleRelation.compatible_add at R, M, N with *
  have compatibleNeg := submoduleRelation.compatible_neg at R, M, N with *
  have zeroM := Module.zero_mem at R, M with *
  have parts := module
  obtain ⟨shape, ringR, addF0, zeroIn0, negF0, smulF0, rest⟩ := parts
  have addF := quotientBinary.magma at M.carrier, submoduleRelation(M, N), M.add with equivalence, addF0, compatibleAdd
  have negF := quotientUnary.function at M.carrier, submoduleRelation(M, N), M.neg with equivalence, negF0, compatibleNeg
  have smulF := quotientScalar.function_of at R, M, N with *
  have zeroIn := quotient.contains_class at M.carrier, submoduleRelation(M, N), M.zero with equivalence, zeroM
  unfold quotientModule
  apply Module.of_laws with ring, addF, zeroIn, negF, smulF
  . intros X hX Y hY Z hZ
    obtain ⟨x, hx, xs⟩ := quotient.representative with hX
    obtain ⟨y, hy, ys⟩ := quotient.representative with hY
    obtain ⟨z, hz, zs⟩ := quotient.representative with hZ
    have xy := Module.add_mem at R, M, x, y with *
    have yz := Module.add_mem at R, M, y, z with *
    have e1 := quotientAdd.classes at R, M, N, x, y with *
    have e2 := quotientAdd.classes at R, M, N, call2(M.add, x, y), z with *
    have e3 := quotientAdd.classes at R, M, N, y, z with *
    have e4 := quotientAdd.classes at R, M, N, x, call2(M.add, y, z) with *
    have law := Module.add_assoc at R, M, x, y, z with *
    rw [xs, ys, zs, e1, e2, e3, e4, law]
  . intros X hX Y hY
    obtain ⟨x, hx, xs⟩ := quotient.representative with hX
    obtain ⟨y, hy, ys⟩ := quotient.representative with hY
    have e1 := quotientAdd.classes at R, M, N, x, y with *
    have e2 := quotientAdd.classes at R, M, N, y, x with *
    have law := Module.add_comm at R, M, x, y with *
    rw [xs, ys, e1, e2, law]
  . intros X hX
    obtain ⟨x, hx, xs⟩ := quotient.representative with hX
    have e1 := quotientAdd.classes at R, M, N, M.zero, x with *
    have law := Module.zero_add at R, M, x with *
    rw [xs, e1, law]
  . intros X hX
    obtain ⟨x, hx, xs⟩ := quotient.representative with hX
    have nx := Module.neg_mem at R, M, x with *
    have e0 := quotientNeg.classes at R, M, N, x with *
    have e1 := quotientAdd.classes at R, M, N, apply(M.neg, x), x with *
    have law := Module.neg_add at R, M, x with *
    rw [xs, e0, e1, law]
  . intros r hr X hX Y hY
    obtain ⟨x, hx, xs⟩ := quotient.representative with hX
    obtain ⟨y, hy, ys⟩ := quotient.representative with hY
    have xy := Module.add_mem at R, M, x, y with *
    have rx := Module.smul_mem at R, M, r, x with *
    have ry := Module.smul_mem at R, M, r, y with *
    have e1 := quotientAdd.classes at R, M, N, x, y with *
    have e2 := quotientScalar.classes at R, M, N, r, call2(M.add, x, y) with *
    have e3 := quotientScalar.classes at R, M, N, r, x with *
    have e4 := quotientScalar.classes at R, M, N, r, y with *
    have e5 := quotientAdd.classes at R, M, N, call2(M.smul, r, x), call2(M.smul, r, y) with *
    have law := smul_add at R, M, r, x, y with *
    rw [xs, ys, e1, e2, e3, e4, e5, law]
  . intros r hr t ht X hX
    obtain ⟨x, hx, xs⟩ := quotient.representative with hX
    have rt := Ring.add_mem at R, r, t with *
    have rx := Module.smul_mem at R, M, r, x with *
    have tx := Module.smul_mem at R, M, t, x with *
    have e1 := quotientScalar.classes at R, M, N, call2(R.add, r, t), x with *
    have e2 := quotientScalar.classes at R, M, N, r, x with *
    have e3 := quotientScalar.classes at R, M, N, t, x with *
    have e4 := quotientAdd.classes at R, M, N, call2(M.smul, r, x), call2(M.smul, t, x) with *
    have law := add_smul at R, M, r, t, x with *
    rw [xs, e1, e2, e3, e4, law]
  . intros r hr t ht X hX
    obtain ⟨x, hx, xs⟩ := quotient.representative with hX
    have rt := Ring.mul_mem at R, r, t with *
    have tx := Module.smul_mem at R, M, t, x with *
    have e1 := quotientScalar.classes at R, M, N, call2(R.mul, r, t), x with *
    have e2 := quotientScalar.classes at R, M, N, t, x with *
    have e3 := quotientScalar.classes at R, M, N, r, call2(M.smul, t, x) with *
    have law := mul_smul at R, M, r, t, x with *
    rw [xs, e1, e2, e3, law]
  . intros X hX
    obtain ⟨x, hx, xs⟩ := quotient.representative with hX
    have oneIn := Ring.one_mem at R with ring
    have e1 := quotientScalar.classes at R, M, N, R.one, x with *
    have law := one_smul at R, M, x with *
    rw [xs, e1, law]

end QuotientModules

-- Graph laws of the quotient map.
theorem quotientModuleMap.graph_relates (M N v : Set)
  requires index : v ∈ Module.carrier(M)
  requires valueIn : ⟦v⟧[Module.carrier(M), submoduleRelation(M, N)] ∈ (Module.carrier(M) ⧸ submoduleRelation(M, N))
  shows relates(quotientModuleMap(M, N), v, ⟦v⟧[Module.carrier(M), submoduleRelation(M, N)])
proof
  unfold relates
  apply quotientModuleMap.membership.backward
  refine ⟨(product.pair at v, ⟦v⟧[Module.carrier(M), submoduleRelation(M, N)], Module.carrier(M), (Module.carrier(M) ⧸ submoduleRelation(M, N)) with index, valueIn), v, index, rfl⟩

theorem quotientModuleMap.graph_function (M N : Set)
  requires values : ∀ v ∈ Module.carrier(M), ⟦v⟧[Module.carrier(M), submoduleRelation(M, N)] ∈ (Module.carrier(M) ⧸ submoduleRelation(M, N))
  shows quotientModuleMap(M, N) : Module.carrier(M) → (Module.carrier(M) ⧸ submoduleRelation(M, N))
proof
  constructor
    intros p member
    obtain ⟨bounded, witnesses⟩ := quotientModuleMap.membership.forward with member
    exact bounded
  . constructor
      intros z0 first xFirst second xSecond
      unfold relates at xFirst
      obtain ⟨_, a1, a1In, firstShape⟩ := quotientModuleMap.membership.forward with xFirst
      unfold relates at xSecond
      obtain ⟨_, a2, a2In, secondShape⟩ := quotientModuleMap.membership.forward with xSecond
      obtain ⟨xi, firstEqual⟩ := orderedPair.injective with firstShape
      obtain ⟨xj, secondEqual⟩ := orderedPair.injective with secondShape
      rw [firstEqual, secondEqual]
      cc
    . intros v xIn
      have valueIn := values with v, xIn
      refine ⟨⟦v⟧[Module.carrier(M), submoduleRelation(M, N)], valueIn, (quotientModuleMap.graph_relates at M, N, v with xIn, valueIn)⟩

theorem quotientModuleMap.graph_apply (M N v : Set)
  requires values : ∀ v ∈ Module.carrier(M), ⟦v⟧[Module.carrier(M), submoduleRelation(M, N)] ∈ (Module.carrier(M) ⧸ submoduleRelation(M, N))
  requires index : v ∈ Module.carrier(M)
  shows quotientModuleMap(M, N)(v) = ⟦v⟧[Module.carrier(M), submoduleRelation(M, N)]
proof
  have function := quotientModuleMap.graph_function at M, N with values
  have valueIn := values with v, index
  have mapped := quotientModuleMap.graph_relates at M, N, v with index, valueIn
  exact FunctionBetween.apply_value with function, index, mapped

theorem quotientModule.carrier_eq (M R N : Set)
  shows Module.carrier(quotientModule(M, R, N)) = (Module.carrier(M) ⧸ submoduleRelation(M, N))
proof
  unfold quotientModule
  module_projections

theorem quotientModule.add_eq (M R N : Set)
  shows Module.add(quotientModule(M, R, N)) = quotientBinary(Module.carrier(M), submoduleRelation(M, N), Module.add(M))
proof
  unfold quotientModule
  module_projections

theorem quotientModule.zero_eq (M R N : Set)
  shows Module.zero(quotientModule(M, R, N)) = ⟦Module.zero(M)⟧[Module.carrier(M), submoduleRelation(M, N)]
proof
  unfold quotientModule
  module_projections

theorem quotientModule.smul_eq (M R N : Set)
  shows Module.smul(quotientModule(M, R, N)) = quotientScalar(M, R, N)
proof
  unfold quotientModule
  module_projections

-- The lift of a linear map vanishing on N, as a function on classes.
theorem quotientLift.function_of (R M N P f : Set)
  requires ring : Ring(R)
  requires module : Module(M, R)
  requires sub : SubmoduleOf(N, M, R)
  requires linear : LinearMap(f, M, R, P)
  requires vanishes : N ⊆ linearKernel(f, M, P)
  shows quotientLift(f, M, N, P) : (Module.carrier(M) ⧸ submoduleRelation(M, N)) → Module.carrier(P)
proof
  have equivalence := submoduleRelation.equivalence at R, M, N with *
  have moduleP := LinearMap.target_module_of with linear
  constructor
    intros p hp
    obtain ⟨bounded, rest⟩ := quotientLift.membership.forward with hp
    exact bounded
  . constructor
      intros z0 first r1 second r2
      unfold relates at r1
      unfold relates at r2
      obtain ⟨_, v, hv, s1⟩ := quotientLift.membership.forward with r1
      obtain ⟨_, w, hw, s2⟩ := quotientLift.membership.forward with r2
      obtain ⟨z1, f1⟩ := orderedPair.injective with s1
      obtain ⟨z2, f2⟩ := orderedPair.injective with s2
      rw z1 at z2
      have diff := (submoduleRelation.class_eq_iff at R, M, N, v, w with *).forward with z2
      have inKernel := vanishes with call2(Module.add(M), v, apply(Module.neg(M), w)), diff
      obtain ⟨_, zero⟩ := linearKernel.membership.forward with inKernel
      have nw := Module.neg_mem at R, M, w with *
      have law := LinearMap.add_law at f, M, R, P, v, apply(Module.neg(M), w) with linear, hv, nw
      have negLaw := LinearMap.neg_law at R, M, P, f, w with *
      rw [law, negLaw] at zero
      have fv := LinearMap.value_mem at f, M, R, P, v with linear, hv
      have fw := LinearMap.value_mem at f, M, R, P, w with linear, hw
      have same := (Module.sub_eq_zero_iff at R, P, f(v), f(w) with *).forward with zero
      rw [f1, f2, same]
    . intros X hX
      obtain ⟨v, hv, vX⟩ := quotient.representative with hX
      have fv := LinearMap.value_mem at f, M, R, P, v with linear, hv
      refine ⟨f(v), fv, ?_⟩
      unfold relates
      rw vX
      apply quotientLift.membership.backward
      have vClass := quotient.contains_class at Module.carrier(M), submoduleRelation(M, N), v with equivalence, hv
      have pair := product.pair at ⟦v⟧[Module.carrier(M), submoduleRelation(M, N)], f(v), (Module.carrier(M) ⧸ submoduleRelation(M, N)), Module.carrier(P) with vClass, fv
      exact ⟨pair, v, hv, rfl⟩

theorem quotientLift.classes (R M N P f v : Set)
  requires ring : Ring(R)
  requires module : Module(M, R)
  requires sub : SubmoduleOf(N, M, R)
  requires linear : LinearMap(f, M, R, P)
  requires vanishes : N ⊆ linearKernel(f, M, P)
  requires hv : v ∈ Module.carrier(M)
  shows quotientLift(f, M, N, P)(⟦v⟧[Module.carrier(M), submoduleRelation(M, N)]) = f(v)
proof
  have equivalence := submoduleRelation.equivalence at R, M, N with *
  have function := quotientLift.function_of with *
  have fv := LinearMap.value_mem at f, M, R, P, v with linear, hv
  have vClass := quotient.contains_class at Module.carrier(M), submoduleRelation(M, N), v with equivalence, hv
  have pair := product.pair at ⟦v⟧[Module.carrier(M), submoduleRelation(M, N)], f(v), (Module.carrier(M) ⧸ submoduleRelation(M, N)), Module.carrier(P) with vClass, fv
  have mapped : relates(quotientLift(f, M, N, P), ⟦v⟧[Module.carrier(M), submoduleRelation(M, N)], f(v))
    unfold relates
    apply quotientLift.membership.backward
    exact ⟨pair, v, hv, rfl⟩
  exact FunctionBetween.apply_value with function, vClass, mapped

theorem quotientLift.linear_of (R M N P f : Set)
  requires ring : Ring(R)
  requires module : Module(M, R)
  requires sub : SubmoduleOf(N, M, R)
  requires linear : LinearMap(f, M, R, P)
  requires vanishes : N ⊆ linearKernel(f, M, P)
  shows LinearMap(quotientLift(f, M, N, P), quotientModule(M, R, N), R, P)
proof
  have equivalence := submoduleRelation.equivalence at R, M, N with *
  have moduleP := LinearMap.target_module_of with linear
  have function := quotientLift.function_of with *
  have quotient := quotientModule.module_of at R, M, N with *
  have carrier := quotientModule.carrier_eq at M, R, N
  have addEq := quotientModule.add_eq at M, R, N
  have smulEq := quotientModule.smul_eq at M, R, N
  apply LinearMap.of_laws with quotient, moduleP
  . rw carrier
    exact function
  . rw [carrier, addEq]
    intros X hX Y hY
    obtain ⟨x, hx, xs⟩ := quotient.representative with hX
    obtain ⟨y, hy, ys⟩ := quotient.representative with hY
    have xy := Module.add_mem at R, M, x, y with *
    have e1 := quotientAdd.classes at R, M, N, x, y with *
    have l1 := quotientLift.classes at R, M, N, P, f, call2(Module.add(M), x, y) with *
    have l2 := quotientLift.classes at R, M, N, P, f, x with *
    have l3 := quotientLift.classes at R, M, N, P, f, y with *
    have law := LinearMap.add_law at f, M, R, P, x, y with linear, hx, hy
    rw [xs, ys, e1, l1, l2, l3, law]
  . rw [carrier, smulEq]
    intros r hr X hX
    obtain ⟨x, hx, xs⟩ := quotient.representative with hX
    have rx := Module.smul_mem at R, M, r, x with *
    have e1 := quotientScalar.classes at R, M, N, r, x with *
    have l1 := quotientLift.classes at R, M, N, P, f, call2(Module.smul(M), r, x) with *
    have l2 := quotientLift.classes at R, M, N, P, f, x with *
    have law := LinearMap.smul_law at f, M, R, P, r, x with linear, hr, hx
    rw [xs, e1, l1, l2, law]


-- Section: Extension along an injection
-- A function v : J → M extended along an injective g : J → I by zero off
-- the range of g: the graph {(g(j), v(j))} ∪ {(i, 0) | i ∉ range g}.
def extendAlong (I J M g v : Set) : Set :=
  { p ∈ I × Module.carrier(M) | ∃ i ∈ I,
    ((∃ j ∈ J, g(j) = i ∧ p = (i, v(j))) ∨
      ((∀ j ∈ J, g(j) ≠ i) ∧ p = (i, Module.zero(M)))) }

theorem extendAlong.function_of (R I J M g v : Set)
  requires ring : Ring(R)
  requires module : Module(M, R)
  requires injective : InjectiveBetween(g, J, I)
  requires vector : v ∈ functionSpace(J, Module.carrier(M))
  shows extendAlong(I, J, M, g, v) : I → Module.carrier(M)
proof
  have gF := Injective.function with injective
  have vF := functionSpace.mem_iff.forward with vector
  have zeroM := Module.zero_mem at R, M with *
  constructor
    intros p hp
    obtain ⟨bounded, rest⟩ := extendAlong.membership.forward with hp
    exact bounded
  . constructor
      intros z0 first r1 second r2
      unfold relates at r1
      unfold relates at r2
      obtain ⟨_, i1, hi1, c1⟩ := extendAlong.membership.forward with r1
      obtain ⟨_, i2, hi2, c2⟩ := extendAlong.membership.forward with r2
      cases c1 with left1 | right1
      . obtain ⟨j1, hj1, g1, s1⟩ := left1
        obtain ⟨z1, f1⟩ := orderedPair.injective with s1
        cases c2 with left2 | right2
        . obtain ⟨j2, hj2, g2, s2⟩ := left2
          obtain ⟨z2, f2⟩ := orderedPair.injective with s2
          have same : g(j1) = g(j2) by cc
          have jj := Injective.apply_cancel with injective, hj1, hj2, same
          rw [f1, f2, jj]
        . obtain ⟨none, s2⟩ := right2
          obtain ⟨z2, f2⟩ := orderedPair.injective with s2
          exfalso
          have hit : g(j1) = i2 by cc
          exact (none with j1, hj1) with hit
      . obtain ⟨none, s1⟩ := right1
        obtain ⟨z1, f1⟩ := orderedPair.injective with s1
        cases c2 with left2 | right2
        . obtain ⟨j2, hj2, g2, s2⟩ := left2
          obtain ⟨z2, f2⟩ := orderedPair.injective with s2
          exfalso
          have hit : g(j2) = i1 by cc
          exact (none with j2, hj2) with hit
        . obtain ⟨none2, s2⟩ := right2
          obtain ⟨z2, f2⟩ := orderedPair.injective with s2
          rw [f1, f2]
    . intros i hi
      by_cases hit : ∃ j ∈ J, g(j) = i
      . obtain ⟨j, hj, gj⟩ := hit
        have vj := FunctionBetween.apply_closed with vF, hj
        refine ⟨v(j), vj, ?_⟩
        unfold relates
        apply extendAlong.membership.backward
        have pair := product.pair at i, v(j), I, Module.carrier(M) with hi, vj
        refine ⟨pair, i, hi, ?_⟩
        left
        exact ⟨j, hj, gj, rfl⟩
      . have none : ∀ j ∈ J, g(j) ≠ i
          intros j hj equal
          exact hit with ⟨j, hj, equal⟩
        refine ⟨Module.zero(M), zeroM, ?_⟩
        unfold relates
        apply extendAlong.membership.backward
        have pair := product.pair at i, Module.zero(M), I, Module.carrier(M) with hi, zeroM
        refine ⟨pair, i, hi, ?_⟩
        right
        exact ⟨none, rfl⟩

theorem extendAlong.at_image (R I J M g v j : Set)
  requires ring : Ring(R)
  requires module : Module(M, R)
  requires injective : InjectiveBetween(g, J, I)
  requires vector : v ∈ functionSpace(J, Module.carrier(M))
  requires index : j ∈ J
  shows extendAlong(I, J, M, g, v)(g(j)) = v(j)
proof
  have gF := Injective.function with injective
  have vF := functionSpace.mem_iff.forward with vector
  have function := extendAlong.function_of with *
  have gj := FunctionBetween.apply_closed with gF, index
  have vj := FunctionBetween.apply_closed with vF, index
  have mapped : relates(extendAlong(I, J, M, g, v), g(j), v(j))
    unfold relates
    apply extendAlong.membership.backward
    have pair := product.pair at g(j), v(j), I, Module.carrier(M) with gj, vj
    refine ⟨pair, g(j), gj, ?_⟩
    left
    exact ⟨j, index, rfl, rfl⟩
  exact FunctionBetween.apply_value with function, gj, mapped

-- Section: Laws of linear maps
section LinearMapLaws
variable (R M N f : Set)
hypothesis ring : Ring(R)
hypothesis moduleM : Module(M, R)
hypothesis moduleN : Module(N, R)
hypothesis linear : LinearMap(f, M, R, N)

theorem LinearMap.function
  shows f : M.carrier → N.carrier
proof
  exact LinearMap.function_of with linear

theorem LinearMap.map_add (v w : M)
  shows f(v + w) = f(v) + f(w)
proof
  exact LinearMap.add_law with linear, *

theorem LinearMap.map_smul (r : R) (v : M)
  shows f(r • v) = r • f(v)
proof
  exact LinearMap.smul_law with linear, *

theorem LinearMap.map_zero
  shows f(M.zero) = N.zero
proof
  have zeroIn := Module.zero_mem at R, M with *
  have fz := LinearMap.value_mem with linear, zeroIn
  have sum := LinearMap.add_law with linear, zeroIn, zeroIn
  have unit := Module.zero_add at R, M, M.zero with *
  rw unit at sum
  have doubled : f(M.zero) + f(M.zero) = f(M.zero)
    symm
    exact sum
  exact Module.eq_zero_of_add_self with doubled

theorem LinearMap.map_neg (v : M)
  shows f(-v) = -f(v)
proof
  have negIn := Module.neg_mem at R, M, v with *
  have fv := LinearMap.value_mem at f, M, R, N, v with linear, *
  have fn := LinearMap.value_mem at f, M, R, N, -v with linear, negIn
  have sum := LinearMap.add_law at f, M, R, N, -v, v with linear, *
  have cancel := Module.neg_add at R, M, v with *
  have zero := LinearMap.map_zero with *
  rw [cancel, zero] at sum
  have total : f(-v) + f(v) = N.zero
    symm
    exact sum
  exact Module.eq_neg_of_add_eq_zero with total

theorem LinearMap.map_sum (V w : Set)
  requires finite : Finite(V)
  requires values : w : V → M.carrier
  shows f(moduleSum(M, V, w)) =
    moduleSum(N, V, compose(f, w, V, M.carrier, N.carrier))
proof
  obtain ⟨n, natural, e, enumeration⟩ := Finite.enumeration with finite
  have injective := Bijective.injective with enumeration
  have eF := Injective.function with injective
  have fF := LinearMap.function_of with linear
  have composite := compose.function at f, w, V, M.carrier, N.carrier with values, fF
  have left := moduleSum.enumeration at R, M, V, w, e, n with *
  have right := moduleSum.enumeration at R, N, V, compose(f, w, V, M.carrier, N.carrier), e, n with *
  have valuesW := WeightedValues.of_functions with values, eF
  have equations : ∀ i ∈ n, compose(f, w, V, M.carrier, N.carrier)(e(i)) = f(w(e(i)))
    intros i hi
    have ei := FunctionBetween.apply_closed with eF, hi
    exact compose.apply at f, w, V, M.carrier, N.carrier, e(i) with values, fF, ei
  have law := indexedRingSum.linear_map at f, M, R, N, w, compose(f, w, V, M.carrier, N.carrier), e, n with linear
  rw [left, right]
  exact law with valuesW, equations

theorem LinearMap.map_combination (V c v : Set)
  requires finite : Finite(V)
  requires coefficients : c : V → R.carrier
  requires vectors : v : V → M.carrier
  shows f(moduleCombination(M, R, V, c, v)) =
    moduleCombination(N, R, V, c, compose(f, v, V, M.carrier, N.carrier))
proof
  have fF := LinearMap.function_of with linear
  have terms := combinationTerms.function at M, R, V, c, v with *
  have image := compose.function at f, v, V, M.carrier, N.carrier with vectors, fF
  have termsN := combinationTerms.function at N, R, V, c, compose(f, v, V, M.carrier, N.carrier) with moduleN, coefficients, image
  have mapped := LinearMap.map_sum at R, M, N, f, V, combinationTerms(M, R, V, c, v) with *
  have composite := compose.function at f, combinationTerms(M, R, V, c, v), V, M.carrier, N.carrier with terms, fF
  have same : compose(f, combinationTerms(M, R, V, c, v), V, M.carrier, N.carrier) = combinationTerms(N, R, V, c, compose(f, v, V, M.carrier, N.carrier))
    apply FunctionBetween.ext with composite, termsN
    intros i hi
    have ci := FunctionBetween.apply_closed with coefficients, hi
    have vi := FunctionBetween.apply_closed with vectors, hi
    have e1 := compose.apply at f, combinationTerms(M, R, V, c, v), V, M.carrier, N.carrier, i with terms, fF, hi
    have e2 := combinationTerms.value at M, R, V, c, v, i with *
    have e3 := combinationTerms.value at N, R, V, c, compose(f, v, V, M.carrier, N.carrier), i with moduleN, coefficients, image, hi
    have e4 := compose.apply at f, v, V, M.carrier, N.carrier, i with vectors, fF, hi
    have law := LinearMap.smul_law at f, M, R, N, c(i), v(i) with linear, ci, vi
    rw [e1, e2, e3, e4, law]
  unfold moduleCombination
  rw [mapped, same]

theorem LinearMap.kernel_submodule
  shows SubmoduleOf(linearKernel(f, M, N), M, R)
proof
  have fzero := LinearMap.map_zero with *
  unfold SubmoduleOf
  refine ⟨moduleM, ?_, ?_, ?_, ?_⟩
  . intros v hv
    obtain ⟨vIn, _⟩ := linearKernel.membership.forward with hv
    exact vIn
  . have zeroIn := Module.zero_mem at R, M with *
    apply linearKernel.membership.backward
    exact ⟨zeroIn, fzero⟩
  . intros v hv w hw
    obtain ⟨vIn, fv⟩ := linearKernel.membership.forward with hv
    obtain ⟨wIn, fw⟩ := linearKernel.membership.forward with hw
    have sumIn := Module.add_mem at R, M, v, w with *
    have law := LinearMap.add_law with linear, vIn, wIn
    have zeroN := Module.zero_mem at R, N with *
    have unit := Module.zero_add at R, N, N.zero with *
    rw [fv, fw, unit] at law
    apply linearKernel.membership.backward
    exact ⟨sumIn, law⟩
  . intros r hr v hv
    obtain ⟨vIn, fv⟩ := linearKernel.membership.forward with hv
    have smulIn := Module.smul_mem at R, M, r, v with *
    have law := LinearMap.smul_law with linear, hr, vIn
    have vanish := smul_zero at R, N, r with *
    rw [fv, vanish] at law
    apply linearKernel.membership.backward
    exact ⟨smulIn, law⟩

theorem LinearMap.range_submodule
  shows SubmoduleOf(linearRange(f, M, N), N, R)
proof
  have fzero := LinearMap.map_zero with *
  have zeroM := Module.zero_mem at R, M with *
  unfold SubmoduleOf
  refine ⟨moduleN, ?_, ?_, ?_, ?_⟩
  . intros w hw
    obtain ⟨wIn, _⟩ := linearRange.membership.forward with hw
    exact wIn
  . have zeroIn := Module.zero_mem at R, N with *
    apply linearRange.membership.backward
    exact ⟨zeroIn, M.zero, zeroM, fzero⟩
  . intros a ha b hb
    obtain ⟨aIn, v, vIn, fv⟩ := linearRange.membership.forward with ha
    obtain ⟨bIn, w, wIn, fw⟩ := linearRange.membership.forward with hb
    have sumIn := Module.add_mem at R, N, a, b with *
    have sumM := Module.add_mem at R, M, v, w with *
    have law := LinearMap.add_law with linear, vIn, wIn
    rw [fv, fw] at law
    apply linearRange.membership.backward
    exact ⟨sumIn, call2(M.add, v, w), sumM, law⟩
  . intros r hr a ha
    obtain ⟨aIn, v, vIn, fv⟩ := linearRange.membership.forward with ha
    have smulIn := Module.smul_mem at R, N, r, a with *
    have smulM := Module.smul_mem at R, M, r, v with *
    have law := LinearMap.smul_law with linear, hr, vIn
    rw fv at law
    apply linearRange.membership.backward
    exact ⟨smulIn, call2(M.smul, r, v), smulM, law⟩

-- LinearMap.ker_eq_bot.
theorem LinearMap.injective_iff_kernel
  shows InjectiveBetween(f, M.carrier, N.carrier) ↔
    linearKernel(f, M, N) = {M.zero}
proof
  have fzero := LinearMap.map_zero with *
  have zeroM := Module.zero_mem at R, M with *
  have function := LinearMap.function_of with linear
  constructor
  . intro injective
    ext v
    constructor
    . intro hv
      obtain ⟨vIn, fv⟩ := linearKernel.membership.forward with hv
      rw ← fzero at fv
      have same := Injective.apply_cancel with injective, vIn, zeroM, fv
      exact singleton.membership.backward with same
    . intro hv
      have same := singleton.membership.forward with hv
      rw same
      apply linearKernel.membership.backward
      exact ⟨zeroM, fzero⟩
  . intro kernel
    apply Injective.of_pointwise with function
    intros x hx y hy same
    have negY := Module.neg_mem at R, M, y with *
    have diff := Module.add_mem at R, M, x, -y with *
    have law := LinearMap.add_law with linear, hx, negY
    have negLaw := LinearMap.map_neg at R, M, N, f, y with *
    have fy := LinearMap.value_mem with linear, hy
    have cancel := Module.add_neg at R, N, f(y) with *
    rw [negLaw, same, cancel] at law
    have member : call2(M.add, x, -y) ∈ linearKernel(f, M, N)
      apply linearKernel.membership.backward
      exact ⟨diff, law⟩
    rw kernel at member
    have zero := singleton.membership.forward with member
    exact (Module.sub_eq_zero_iff at R, M, x, y with *).forward with zero

-- LinearMap.range_eq_top.
theorem LinearMap.surjective_iff_range
  shows SurjectiveBetween(f, M.carrier, N.carrier) ↔
    linearRange(f, M, N) = N.carrier
proof
  have function := LinearMap.function_of with linear
  constructor
  . intro surjective
    ext w
    constructor
    . intro hw
      obtain ⟨wIn, _⟩ := linearRange.membership.forward with hw
      exact wIn
    . intro hw
      obtain ⟨v, hv, value⟩ := Surjective.apply_exists with surjective, hw
      apply linearRange.membership.backward
      exact ⟨hw, v, hv, value⟩
  . intro range
    apply Surjective.of_pointwise with function
    intros w hw
    rw ← range at hw
    obtain ⟨wIn, v, hv, value⟩ := linearRange.membership.forward with hw
    exact ⟨v, hv, value⟩

theorem LinearMap.image_submodule (P : Set)
  requires sub : SubmoduleOf(P, M, R)
  shows SubmoduleOf(submoduleImage(f, M, N, P), N, R)
proof
  obtain ⟨_, Psub, Pzero, Padd, Psmul⟩ := sub
  have fzero := LinearMap.map_zero with *
  unfold SubmoduleOf
  refine ⟨moduleN, ?_, ?_, ?_, ?_⟩
  . intros w hw
    obtain ⟨wIn, _⟩ := submoduleImage.membership.forward with hw
    exact wIn
  . have zeroIn := Module.zero_mem at R, N with *
    apply submoduleImage.membership.backward
    exact ⟨zeroIn, M.zero, Pzero, fzero⟩
  . intros a ha b hb
    obtain ⟨aIn, v, vP, fv⟩ := submoduleImage.membership.forward with ha
    obtain ⟨bIn, w, wP, fw⟩ := submoduleImage.membership.forward with hb
    have vIn := Psub with v, vP
    have wIn := Psub with w, wP
    have sumIn := Module.add_mem at R, N, a, b with *
    have sumP := Padd with v, vP, w, wP
    have law := LinearMap.add_law with linear, vIn, wIn
    rw [fv, fw] at law
    apply submoduleImage.membership.backward
    exact ⟨sumIn, call2(M.add, v, w), sumP, law⟩
  . intros r hr a ha
    obtain ⟨aIn, v, vP, fv⟩ := submoduleImage.membership.forward with ha
    have vIn := Psub with v, vP
    have smulIn := Module.smul_mem at R, N, r, a with *
    have smulP := Psmul with r, hr, v, vP
    have law := LinearMap.smul_law with linear, hr, vIn
    rw fv at law
    apply submoduleImage.membership.backward
    exact ⟨smulIn, call2(M.smul, r, v), smulP, law⟩

theorem LinearMap.preimage_submodule (Q : Set)
  requires sub : SubmoduleOf(Q, N, R)
  shows SubmoduleOf(submodulePreimage(f, M, Q), M, R)
proof
  obtain ⟨_, Qsub, Qzero, Qadd, Qsmul⟩ := sub
  have fzero := LinearMap.map_zero with *
  unfold SubmoduleOf
  refine ⟨moduleM, ?_, ?_, ?_, ?_⟩
  . intros v hv
    obtain ⟨vIn, _⟩ := submodulePreimage.membership.forward with hv
    exact vIn
  . have zeroIn := Module.zero_mem at R, M with *
    apply submodulePreimage.membership.backward
    rw fzero
    exact ⟨zeroIn, Qzero⟩
  . intros v hv w hw
    obtain ⟨vIn, fv⟩ := submodulePreimage.membership.forward with hv
    obtain ⟨wIn, fw⟩ := submodulePreimage.membership.forward with hw
    have sumIn := Module.add_mem at R, M, v, w with *
    have law := LinearMap.add_law with linear, vIn, wIn
    have sumQ := Qadd with f(v), fv, f(w), fw
    rw ← law at sumQ
    apply submodulePreimage.membership.backward
    exact ⟨sumIn, sumQ⟩
  . intros r hr v hv
    obtain ⟨vIn, fv⟩ := submodulePreimage.membership.forward with hv
    have smulIn := Module.smul_mem at R, M, r, v with *
    have law := LinearMap.smul_law with linear, hr, vIn
    have smulQ := Qsmul with r, hr, f(v), fv
    rw ← law at smulQ
    apply submodulePreimage.membership.backward
    exact ⟨smulIn, smulQ⟩

-- Submodule.map_span: the image of a span is the span of the image.
theorem LinearMap.image_span (S : Set)
  requires subset : S ⊆ M.carrier
  shows submoduleImage(f, M, N, moduleSpan(M, R, S)) =
    moduleSpan(N, R, functionImage(f, S, N.carrier))
proof
  have spanM := moduleSpan.submodule_of at R, M, S with ring, moduleM
  have fF := LinearMap.function_of with linear
  have imageSub := functionImage.subset at f, S, N.carrier
  have spanN := moduleSpan.submodule_of at R, N, functionImage(f, S, N.carrier) with ring, moduleN
  have imageSpan := LinearMap.image_submodule at R, M, N, f, moduleSpan(M, R, S) with *
  have containsS := moduleSpan.subset_of at R, M, S with ring, moduleM, subset
  have containsFS := moduleSpan.subset_of at R, N, functionImage(f, S, N.carrier) with ring, moduleN, imageSub
  ext w
  constructor
  . intro hw
    obtain ⟨wIn, v, hv, value⟩ := submoduleImage.membership.forward with hw
    have pre := LinearMap.preimage_submodule at R, M, N, f, moduleSpan(N, R, functionImage(f, S, N.carrier)) with *
    have SinPre : S ⊆ submodulePreimage(f, M, moduleSpan(N, R, functionImage(f, S, N.carrier)))
      intros s hs
      have sM := subset with s, hs
      have fs := FunctionBetween.apply_closed with fF, sM
      have inImage : f(s) ∈ functionImage(f, S, N.carrier)
        apply functionImage.membership.backward
        exact ⟨fs, s, hs, rfl⟩
      have inSpan := containsFS with f(s), inImage
      apply submodulePreimage.membership.backward
      exact ⟨sM, inSpan⟩
    have within := (moduleSpan.least_of at R, M, S, submodulePreimage(f, M, moduleSpan(N, R, functionImage(f, S, N.carrier))) with ring, moduleM, subset, pre).backward with SinPre
    have vPre := within with v, hv
    obtain ⟨vIn, fv⟩ := submodulePreimage.membership.forward with vPre
    rw ← value
    exact fv
  . intro hw
    have FSinImage : functionImage(f, S, N.carrier) ⊆ submoduleImage(f, M, N, moduleSpan(M, R, S))
      intros y hy
      obtain ⟨yIn, s, hs, ys⟩ := functionImage.membership.forward with hy
      have sSpan := containsS with s, hs
      apply submoduleImage.membership.backward
      refine ⟨yIn, s, sSpan, ?_⟩
      symm
      exact ys
    have within := (moduleSpan.least_of at R, N, functionImage(f, S, N.carrier), submoduleImage(f, M, N, moduleSpan(M, R, S)) with ring, moduleN, imageSub, imageSpan).backward with FSinImage
    exact within with w, hw

-- LinearMap.ext_on: linear maps agreeing on a spanning set are equal.
theorem LinearMap.ext_on_span (g S : Set)
  requires other : LinearMap(g, M, R, N)
  requires spans : moduleSpan(M, R, S) = M.carrier
  requires agree : ∀ v ∈ S, f(v) = g(v)
  shows f = g
proof
  sorry

-- The first isomorphism theorem: M ⧸ ker f ≅ range f.
theorem LinearMap.quotient_kernel_equiv
  shows LinearEquiv(quotientLift(f, M, linearKernel(f, M, N), N),
    quotientModule(M, R, linearKernel(f, M, N)), R,
    submoduleModule(N, R, linearRange(f, M, N)))
proof
  have kernel := LinearMap.kernel_submodule at R, M, N, f with *
  have range := LinearMap.range_submodule at R, M, N, f with *
  have vanishes : linearKernel(f, M, N) ⊆ linearKernel(f, M, N)
    intros v hv
    exact hv
  have equivalence := submoduleRelation.equivalence at R, M, linearKernel(f, M, N) with ring, moduleM, kernel
  have liftF := quotientLift.function_of at R, M, linearKernel(f, M, N), N, f with ring, moduleM, kernel, linear, vanishes
  have liftL := quotientLift.linear_of at R, M, linearKernel(f, M, N), N, f with ring, moduleM, kernel, linear, vanishes
  have quotient := quotientModule.module_of at R, M, linearKernel(f, M, N) with ring, moduleM, kernel
  have target := submoduleModule.module_of at R, N, linearRange(f, M, N) with ring, moduleN, range
  have carrierQ := quotientModule.carrier_eq at M, R, linearKernel(f, M, N)
  have carrierS := submoduleModule.carrier_eq at N, R, linearRange(f, M, N)
  have addEqQ := quotientModule.add_eq at M, R, linearKernel(f, M, N)
  have smulEqQ := quotientModule.smul_eq at M, R, linearKernel(f, M, N)
  have inRange : ∀ X ∈ (Module.carrier(M) ⧸ submoduleRelation(M, linearKernel(f, M, N))), quotientLift(f, M, linearKernel(f, M, N), N)(X) ∈ linearRange(f, M, N)
    intros X hX
    obtain ⟨v, hv, vX⟩ := quotient.representative with hX
    have l1 := quotientLift.classes at R, M, linearKernel(f, M, N), N, f, v with ring, moduleM, kernel, linear, vanishes, hv
    have fv := LinearMap.value_mem at f, M, R, N, v with linear, hv
    rw [vX, l1]
    apply linearRange.membership.backward
    exact ⟨fv, v, hv, rfl⟩
  have function := FunctionBetween.codomain_of_values at quotientLift(f, M, linearKernel(f, M, N), N), (Module.carrier(M) ⧸ submoduleRelation(M, linearKernel(f, M, N))), Module.carrier(N), linearRange(f, M, N) with liftF, inRange
  have lin : LinearMap(quotientLift(f, M, linearKernel(f, M, N), N), quotientModule(M, R, linearKernel(f, M, N)), R, submoduleModule(N, R, linearRange(f, M, N)))
    apply LinearMap.of_laws with quotient, target
    . rw [carrierQ, carrierS]
      exact function
    . rw [carrierQ, addEqQ]
      intros X hX Y hY
      obtain ⟨x, hx, xs⟩ := quotient.representative with hX
      obtain ⟨y, hy, ys⟩ := quotient.representative with hY
      have xy := Module.add_mem at R, M, x, y with *
      have e1 := quotientAdd.classes at R, M, linearKernel(f, M, N), x, y with ring, moduleM, kernel, hx, hy
      have l1 := quotientLift.classes at R, M, linearKernel(f, M, N), N, f, call2(Module.add(M), x, y) with ring, moduleM, kernel, linear, vanishes, xy
      have l2 := quotientLift.classes at R, M, linearKernel(f, M, N), N, f, x with ring, moduleM, kernel, linear, vanishes, hx
      have l3 := quotientLift.classes at R, M, linearKernel(f, M, N), N, f, y with ring, moduleM, kernel, linear, vanishes, hy
      have fx := LinearMap.value_mem at f, M, R, N, x with linear, hx
      have fy := LinearMap.value_mem at f, M, R, N, y with linear, hy
      have rx : f(x) ∈ linearRange(f, M, N)
        apply linearRange.membership.backward
        exact ⟨fx, x, hx, rfl⟩
      have ry : f(y) ∈ linearRange(f, M, N)
        apply linearRange.membership.backward
        exact ⟨fy, y, hy, rfl⟩
      have s1 := submoduleModule.add_value at N, R, linearRange(f, M, N), f(x), f(y) with range, rx, ry
      have law := LinearMap.add_law at f, M, R, N, x, y with linear, hx, hy
      rw [xs, ys, e1, l1, l2, l3, s1, law]
    . rw [carrierQ, smulEqQ]
      intros r hr X hX
      obtain ⟨x, hx, xs⟩ := quotient.representative with hX
      have rx0 := Module.smul_mem at R, M, r, x with *
      have e1 := quotientScalar.classes at R, M, linearKernel(f, M, N), r, x with ring, moduleM, kernel, hr, hx
      have l1 := quotientLift.classes at R, M, linearKernel(f, M, N), N, f, call2(Module.smul(M), r, x) with ring, moduleM, kernel, linear, vanishes, rx0
      have l2 := quotientLift.classes at R, M, linearKernel(f, M, N), N, f, x with ring, moduleM, kernel, linear, vanishes, hx
      have fx := LinearMap.value_mem at f, M, R, N, x with linear, hx
      have rx : f(x) ∈ linearRange(f, M, N)
        apply linearRange.membership.backward
        exact ⟨fx, x, hx, rfl⟩
      have s1 := submoduleModule.smul_value at N, R, linearRange(f, M, N), r, f(x) with range, hr, rx
      have law := LinearMap.smul_law at f, M, R, N, r, x with linear, hr, hx
      rw [xs, e1, l1, l2, s1, law]
  have injective := Injective.of_pointwise at quotientLift(f, M, linearKernel(f, M, N), N), (Module.carrier(M) ⧸ submoduleRelation(M, linearKernel(f, M, N))), linearRange(f, M, N) with function
  have inj : InjectiveBetween(quotientLift(f, M, linearKernel(f, M, N), N), (Module.carrier(M) ⧸ submoduleRelation(M, linearKernel(f, M, N))), linearRange(f, M, N))
    apply injective
    intros X hX Y hY same
    obtain ⟨x, hx, xs⟩ := quotient.representative with hX
    obtain ⟨y, hy, ys⟩ := quotient.representative with hY
    have l1 := quotientLift.classes at R, M, linearKernel(f, M, N), N, f, x with ring, moduleM, kernel, linear, vanishes, hx
    have l2 := quotientLift.classes at R, M, linearKernel(f, M, N), N, f, y with ring, moduleM, kernel, linear, vanishes, hy
    rw [xs, ys, l1, l2] at same
    have ny := Module.neg_mem at R, M, y with *
    have diffIn := Module.add_mem at R, M, x, apply(Module.neg(M), y) with *
    have law := LinearMap.add_law at f, M, R, N, x, apply(Module.neg(M), y) with linear, hx, ny
    have negLaw := LinearMap.neg_law at R, M, N, f, y with ring, linear, hy
    have fy := LinearMap.value_mem at f, M, R, N, y with linear, hy
    have cancel := Module.add_neg at R, N, f(y) with *
    rw [negLaw, same, cancel] at law
    have inKernel : call2(Module.add(M), x, apply(Module.neg(M), y)) ∈ linearKernel(f, M, N)
      apply linearKernel.membership.backward
      exact ⟨diffIn, law⟩
    rw [xs, ys]
    exact (submoduleRelation.class_eq_iff at R, M, linearKernel(f, M, N), x, y with ring, moduleM, kernel, hx, hy).backward with inKernel
  have surj : SurjectiveBetween(quotientLift(f, M, linearKernel(f, M, N), N), (Module.carrier(M) ⧸ submoduleRelation(M, linearKernel(f, M, N))), linearRange(f, M, N))
    apply Surjective.of_pointwise with function
    intros w hw
    obtain ⟨wIn, v, hv, value⟩ := linearRange.membership.forward with hw
    have vClass := quotient.contains_class at Module.carrier(M), submoduleRelation(M, linearKernel(f, M, N)), v with equivalence, hv
    have l1 := quotientLift.classes at R, M, linearKernel(f, M, N), N, f, v with ring, moduleM, kernel, linear, vanishes, hv
    refine ⟨⟦v⟧[Module.carrier(M), submoduleRelation(M, linearKernel(f, M, N))], vClass, ?_⟩
    rw [l1, value]
  unfold LinearEquiv
  refine ⟨lin, ?_⟩
  rw [carrierQ, carrierS]
  exact ⟨inj, surj⟩

end LinearMapLaws

-- LinearMap.ext.
theorem LinearMap.ext (f g M R N : Set)
  requires first : LinearMap(f, M, R, N)
  requires second : LinearMap(g, M, R, N)
  requires agree : ∀ v ∈ Module.carrier(M), f(v) = g(v)
  shows f = g
proof
  have ff := LinearMap.function_of with first
  have gf := LinearMap.function_of with second
  exact FunctionBetween.ext with ff, gf, agree

theorem LinearMap.source_module (f M R N : Set)
  requires linear : LinearMap(f, M, R, N)
  shows Module(M, R)
proof
  obtain ⟨moduleM, rest⟩ := linear
  exact moduleM

theorem LinearMap.target_module (f M R N : Set)
  requires linear : LinearMap(f, M, R, N)
  shows Module(N, R)
proof
  obtain ⟨moduleM, moduleN, rest⟩ := linear
  exact moduleN

-- LinearMap.id.
theorem LinearMap.identity (M R : Set)
  requires module : Module(M, R)
  shows LinearMap(identity(Module.carrier(M)), M, R, M)
proof
  have ring := Module.ring with module
  have function := identity.function at Module.carrier(M)
  apply LinearMap.of_laws with module, module, function
  . intros v hv w hw
    have sumIn := Module.add_mem at R, M, v, w with *
    rw [identity.apply with sumIn, identity.apply with hv, identity.apply with hw]
  . intros r hr v hv
    have smulIn := Module.smul_mem at R, M, r, v with *
    rw [identity.apply with smulIn, identity.apply with hv]

theorem LinearMap.compose (f g M R N P : Set)
  requires first : LinearMap(f, M, R, N)
  requires second : LinearMap(g, N, R, P)
  shows LinearMap(compose(g, f, Module.carrier(M), Module.carrier(N),
    Module.carrier(P)), M, R, P)
proof
  exact LinearMap.compose_of with first, second

theorem LinearEquiv.inverse (f M R N : Set)
  requires equiv : LinearEquiv(f, M, R, N)
  shows LinearEquiv(converse(f, Module.carrier(M), Module.carrier(N)), N, R, M)
proof
  obtain ⟨linear, bijective⟩ := equiv
  have moduleM := LinearMap.source_module with linear
  have moduleN := LinearMap.target_module with linear
  have ring := Module.ring with moduleM
  have gF := converse.function_of_bijective with bijective
  have gBij := converse.bijective with bijective
  have inj := Bijective.injective with bijective
  have lin : LinearMap(converse(f, Module.carrier(M), Module.carrier(N)), N, R, M)
    apply LinearMap.of_laws with moduleN, moduleM, gF
    . intros a ha b hb
      have ga := FunctionBetween.apply_closed with gF, ha
      have gb := FunctionBetween.apply_closed with gF, hb
      have sumN := Module.add_mem at R, N, a, b with *
      have gs := FunctionBetween.apply_closed with gF, sumN
      have sumM := Module.add_mem at R, M, converse(f, Module.carrier(M), Module.carrier(N))(a), converse(f, Module.carrier(M), Module.carrier(N))(b) with *
      apply Injective.apply_cancel with inj, gs, sumM
      have e1 := Bijective.apply_inverse with bijective, sumN
      have e2 := Bijective.apply_inverse with bijective, ha
      have e3 := Bijective.apply_inverse with bijective, hb
      have law := LinearMap.add_law with linear, ga, gb
      rw [e1, law, e2, e3]
    . intros r hr a ha
      have ga := FunctionBetween.apply_closed with gF, ha
      have smulN := Module.smul_mem at R, N, r, a with *
      have gs := FunctionBetween.apply_closed with gF, smulN
      have smulM := Module.smul_mem at R, M, r, converse(f, Module.carrier(M), Module.carrier(N))(a) with *
      apply Injective.apply_cancel with inj, gs, smulM
      have e1 := Bijective.apply_inverse with bijective, smulN
      have e2 := Bijective.apply_inverse with bijective, ha
      have law := LinearMap.smul_law with linear, hr, ga
      rw [e1, law, e2]
  unfold LinearEquiv
  exact ⟨lin, gBij⟩

-- LinearEquiv.ofBijective.
theorem LinearEquiv.of_bijective (f M R N : Set)
  requires linear : LinearMap(f, M, R, N)
  requires bijective : BijectiveBetween(f, Module.carrier(M), Module.carrier(N))
  shows LinearEquiv(f, M, R, N)
proof
  unfold LinearEquiv
  exact ⟨linear, bijective⟩

theorem LinearEquiv.compose (f g M R N P : Set)
  requires first : LinearEquiv(f, M, R, N)
  requires second : LinearEquiv(g, N, R, P)
  shows LinearEquiv(compose(g, f, Module.carrier(M), Module.carrier(N),
    Module.carrier(P)), M, R, P)
proof
  obtain ⟨lf, bf⟩ := first
  obtain ⟨lg, bg⟩ := second
  have composite := LinearMap.compose_of with lf, lg
  have bijective := compose.bijective with bf, bg
  unfold LinearEquiv
  exact ⟨composite, bijective⟩

theorem LinearEquiv.identity (M R : Set)
  requires module : Module(M, R)
  shows LinearEquiv(identity(Module.carrier(M)), M, R, M)
proof
  have linear := LinearMap.identity with module
  have bijective := identity.bijective at Module.carrier(M)
  unfold LinearEquiv
  exact ⟨linear, bijective⟩

-- Section: Laws of submodules and quotients
section SubmoduleLaws
variable (R M N : Set)
hypothesis ring : Ring(R)
hypothesis module : Module(M, R)
hypothesis sub : SubmoduleOf(N, M, R)

theorem SubmoduleOf.subset
  shows N ⊆ M.carrier
proof
  obtain ⟨_, subset, rest⟩ := sub
  exact subset

theorem SubmoduleOf.zero_mem
  shows M.zero ∈ N
proof
  obtain ⟨_, subset, zeroIn, rest⟩ := sub
  exact zeroIn

theorem SubmoduleOf.add_mem (v w : Set)
  requires first : v ∈ N
  requires second : w ∈ N
  shows call2(M.add, v, w) ∈ N
proof
  obtain ⟨_, subset, zeroIn, addIn, smulIn⟩ := sub
  exact addIn with v, first, w, second

-- Submodule.smul_mem.
theorem SubmoduleOf.smul_mem (r v : Set)
  requires scalar : r ∈ R.carrier
  requires member : v ∈ N
  shows call2(M.smul, r, v) ∈ N
proof
  obtain ⟨_, subset, zeroIn, addIn, smulIn⟩ := sub
  exact smulIn with r, scalar, v, member

theorem SubmoduleOf.neg_mem (v : Set)
  requires member : v ∈ N
  shows apply(M.neg, v) ∈ N
proof
  exact SubmoduleOf.neg_closed with sub, member

-- Submodule.sub_mem_iff_left: for y ∈ N, x − y ∈ N iff x ∈ N.
theorem SubmoduleOf.sub_mem_iff_left (x y : Set)
  requires vector : x ∈ M.carrier
  requires member : y ∈ N
  shows call2(M.add, x, apply(M.neg, y)) ∈ N ↔ x ∈ N
proof
  obtain ⟨_, subset, zeroIn, addIn, smulIn⟩ := SubmoduleOf.parts with sub
  have yM := subset with y, member
  have negY := SubmoduleOf.neg_closed with sub, member
  have negYM := Module.neg_mem at R, M, y with *
  constructor
  . intro diff
    have total := addIn with call2(M.add, x, apply(M.neg, y)), diff, y, member
    have assoc := Module.add_assoc at R, M, x, apply(M.neg, y), y with *
    have cancel := Module.neg_add at R, M, y with *
    have unit := Module.add_zero at R, M, x with *
    rw [assoc, cancel, unit] at total
    exact total
  . intro xN
    exact addIn with x, xN, apply(M.neg, y), negY

-- Submodule.sum_mem and Submodule.sum_smul_mem.
theorem SubmoduleOf.sum_mem (V w : Set)
  requires finite : Finite(V)
  requires values : w : V → N
  shows moduleSum(M, V, w) ∈ N
proof
  obtain ⟨_, subset, zeroIn, addIn, smulIn⟩ := SubmoduleOf.parts with sub
  obtain ⟨n, natural, e, enumeration⟩ := Finite.enumeration with finite
  have injective := Bijective.injective with enumeration
  have eF := Injective.function with injective
  have inM : ∀ i ∈ V, w(i) ∈ M.carrier
    intros i hi
    have wi := FunctionBetween.apply_closed with values, hi
    exact subset with w(i), wi
  have valuesM := FunctionBetween.codomain_of_values at w, V, N, M.carrier with values, inM
  have value := moduleSum.enumeration at R, M, V, w, e, n with valuesM, enumeration
  have members : ∀ i ∈ n, w(e(i)) ∈ N
    intros i hi
    have ei := FunctionBetween.apply_closed with eF, hi
    exact FunctionBetween.apply_closed with values, ei
  have law := indexedRingSum.submodule_mem at R, M, N, w, e, n with *
  rw value
  exact law with members

theorem SubmoduleOf.combination_mem (V c v : Set)
  requires finite : Finite(V)
  requires coefficients : c : V → R.carrier
  requires vectors : v : V → N
  shows moduleCombination(M, R, V, c, v) ∈ N
proof
  obtain ⟨_, subset, zeroIn, addIn, smulIn⟩ := SubmoduleOf.parts with sub
  have inM : ∀ i ∈ V, v(i) ∈ M.carrier
    intros i hi
    have vi := FunctionBetween.apply_closed with vectors, hi
    exact subset with v(i), vi
  have vectorsM := FunctionBetween.codomain_of_values at v, V, N, M.carrier with vectors, inM
  have terms := combinationTerms.function at M, R, V, c, v with module, coefficients, vectorsM
  have inN : ∀ i ∈ V, combinationTerms(M, R, V, c, v)(i) ∈ N
    intros i hi
    have ci := FunctionBetween.apply_closed with coefficients, hi
    have vi := FunctionBetween.apply_closed with vectors, hi
    have value := combinationTerms.value at M, R, V, c, v, i with module, coefficients, vectorsM, hi
    rw value
    exact smulIn with c(i), ci, v(i), vi
  have termsN := FunctionBetween.codomain_of_values at combinationTerms(M, R, V, c, v), V, M.carrier, N with terms, inN
  unfold moduleCombination
  exact SubmoduleOf.sum_mem at R, M, N, V, combinationTerms(M, R, V, c, v) with *

theorem SubmoduleOf.submodule_module
  shows Module(submoduleModule(M, R, N), R)
proof
  exact submoduleModule.module_of at R, M, N with *

-- Submodule.subtype: the inclusion N → M is linear.
theorem SubmoduleOf.inclusion_linear
  shows LinearMap(identity(N), submoduleModule(M, R, N), R, M)
proof
  have subModule := SubmoduleOf.submodule_module with *
  have subset := SubmoduleOf.subset with *
  have function := identity.inclusion with subset
  have carrier := submoduleModule.carrier_eq at M, R, N
  apply LinearMap.of_laws with subModule, module
  . rw carrier
    exact function
  . rw carrier
    intros v hv w hw
    have sumIn := SubmoduleOf.add_mem at R, M, N, v, w with *
    have e1 := submoduleModule.add_value with sub, hv, hw
    rw [e1, identity.apply with sumIn, identity.apply with hv, identity.apply with hw]
  . rw carrier
    intros r hr v hv
    have smulIn := SubmoduleOf.smul_mem at R, M, N, r, v with *
    have e1 := submoduleModule.smul_value with sub, hr, hv
    rw [e1, identity.apply with smulIn, identity.apply with hv]

theorem SubmoduleOf.quotient_module
  shows Module(quotientModule(M, R, N), R)
proof
  exact quotientModule.module_of at R, M, N with *

-- Submodule.mkQ.
theorem SubmoduleOf.quotient_map_linear
  shows LinearMap(quotientModuleMap(M, N), M, R, quotientModule(M, R, N))
proof
  have equivalence := submoduleRelation.equivalence at R, M, N with *
  have values : ∀ v ∈ Module.carrier(M), ⟦v⟧[Module.carrier(M), submoduleRelation(M, N)] ∈ (Module.carrier(M) ⧸ submoduleRelation(M, N))
    intros v hv
    exact quotient.contains_class at Module.carrier(M), submoduleRelation(M, N), v with equivalence, hv
  have function := quotientModuleMap.graph_function at M, N with values
  have quotient := quotientModule.module_of at R, M, N with *
  have carrier := quotientModule.carrier_eq at M, R, N
  have addEq := quotientModule.add_eq at M, R, N
  have smulEq := quotientModule.smul_eq at M, R, N
  apply LinearMap.of_laws with module, quotient
  . rw carrier
    exact function
  . rw addEq
    intros v hv w hw
    have vw := Module.add_mem at R, M, v, w with *
    have q1 := quotientModuleMap.graph_apply at M, N, call2(Module.add(M), v, w) with values, vw
    have q2 := quotientModuleMap.graph_apply at M, N, v with values, hv
    have q3 := quotientModuleMap.graph_apply at M, N, w with values, hw
    have e1 := quotientAdd.classes at R, M, N, v, w with *
    rw [q1, q2, q3, e1]
  . rw smulEq
    intros r hr v hv
    have rv := Module.smul_mem at R, M, r, v with *
    have q1 := quotientModuleMap.graph_apply at M, N, call2(Module.smul(M), r, v) with values, rv
    have q2 := quotientModuleMap.graph_apply at M, N, v with values, hv
    have e1 := quotientScalar.classes at R, M, N, r, v with *
    rw [q1, q2, e1]

-- Submodule.Quotient.eq: [x] = [y] iff x − y ∈ N.
theorem SubmoduleOf.quotient_eq (x y : Set)
  requires first : x ∈ M.carrier
  requires second : y ∈ M.carrier
  shows quotientModuleMap(M, N)(x) = quotientModuleMap(M, N)(y) ↔
    call2(M.add, x, apply(M.neg, y)) ∈ N
proof
  have equivalence := submoduleRelation.equivalence at R, M, N with *
  have values : ∀ v ∈ Module.carrier(M), ⟦v⟧[Module.carrier(M), submoduleRelation(M, N)] ∈ (Module.carrier(M) ⧸ submoduleRelation(M, N))
    intros v hv
    exact quotient.contains_class at Module.carrier(M), submoduleRelation(M, N), v with equivalence, hv
  have q1 := quotientModuleMap.graph_apply at M, N, x with values, first
  have q2 := quotientModuleMap.graph_apply at M, N, y with values, second
  rw [q1, q2]
  exact submoduleRelation.class_eq_iff at R, M, N, x, y with *

-- Submodule.ker_mkQ.
theorem SubmoduleOf.quotient_kernel
  shows linearKernel(quotientModuleMap(M, N), M, quotientModule(M, R, N)) = N
proof
  have equivalence := submoduleRelation.equivalence at R, M, N with *
  have values : ∀ v ∈ Module.carrier(M), ⟦v⟧[Module.carrier(M), submoduleRelation(M, N)] ∈ (Module.carrier(M) ⧸ submoduleRelation(M, N))
    intros v hv
    exact quotient.contains_class at Module.carrier(M), submoduleRelation(M, N), v with equivalence, hv
  have zeroEq := quotientModule.zero_eq at M, R, N
  have zeroM := Module.zero_mem at R, M with *
  have negZero := Module.neg_zero at R, M with *
  have subset := SubmoduleOf.subset at R, M, N with *
  ext v
  constructor
  . intro hv
    obtain ⟨vIn, zero⟩ := linearKernel.membership.forward with hv
    have q1 := quotientModuleMap.graph_apply at M, N, v with values, vIn
    rw [q1, zeroEq] at zero
    have diff := (submoduleRelation.class_eq_iff at R, M, N, v, Module.zero(M) with *).forward with zero
    have unit := Module.add_zero at R, M, v with *
    rw [negZero, unit] at diff
    exact diff
  . intro hv
    have vIn := subset with v, hv
    have q1 := quotientModuleMap.graph_apply at M, N, v with values, vIn
    have unit := Module.add_zero at R, M, v with *
    have diff : call2(Module.add(M), v, apply(Module.neg(M), Module.zero(M))) ∈ N
      rw [negZero, unit]
      exact hv
    have same := (submoduleRelation.class_eq_iff at R, M, N, v, Module.zero(M) with *).backward with diff
    apply linearKernel.membership.backward
    refine ⟨vIn, ?_⟩
    rw [q1, zeroEq, same]

theorem SubmoduleOf.quotient_map_surjective
  shows SurjectiveBetween(quotientModuleMap(M, N), M.carrier,
    Module.carrier(quotientModule(M, R, N)))
proof
  have equivalence := submoduleRelation.equivalence at R, M, N with *
  have values : ∀ v ∈ Module.carrier(M), ⟦v⟧[Module.carrier(M), submoduleRelation(M, N)] ∈ (Module.carrier(M) ⧸ submoduleRelation(M, N))
    intros v hv
    exact quotient.contains_class at Module.carrier(M), submoduleRelation(M, N), v with equivalence, hv
  have function := quotientModuleMap.graph_function at M, N with values
  have carrier := quotientModule.carrier_eq at M, R, N
  rw carrier
  apply Surjective.of_pointwise with function
  intros X hX
  obtain ⟨v, hv, vX⟩ := quotient.representative with hX
  have q1 := quotientModuleMap.graph_apply at M, N, v with values, hv
  refine ⟨v, hv, ?_⟩
  rw [q1, vX]

-- Submodule.liftQ: a linear map vanishing on N factors through M ⧸ N.
theorem SubmoduleOf.quotient_lift (f P : Set)
  requires linear : LinearMap(f, M, R, P)
  requires vanishes : N ⊆ linearKernel(f, M, P)
  shows LinearMap(quotientLift(f, M, N, P), quotientModule(M, R, N), R, P) ∧
    (∀ v ∈ M.carrier,
      quotientLift(f, M, N, P)(quotientModuleMap(M, N)(v)) = f(v))
proof
  have equivalence := submoduleRelation.equivalence at R, M, N with *
  have values : ∀ v ∈ Module.carrier(M), ⟦v⟧[Module.carrier(M), submoduleRelation(M, N)] ∈ (Module.carrier(M) ⧸ submoduleRelation(M, N))
    intros v hv
    exact quotient.contains_class at Module.carrier(M), submoduleRelation(M, N), v with equivalence, hv
  have lin := quotientLift.linear_of at R, M, N, P, f with *
  refine ⟨lin, ?_⟩
  intros v hv
  have q1 := quotientModuleMap.graph_apply at M, N, v with values, hv
  rw q1
  exact quotientLift.classes at R, M, N, P, f, v with *

end SubmoduleLaws

section SpanLaws
variable (R M : Set)
hypothesis ring : Ring(R)
hypothesis module : Module(M, R)

theorem moduleSpan.submodule (S : Set)
  shows SubmoduleOf(moduleSpan(M, R, S), M, R)
proof
  exact moduleSpan.submodule_of at R, M, S with *

-- Submodule.subset_span.
theorem moduleSpan.subset_span (S : Set)
  requires subset : S ⊆ M.carrier
  shows S ⊆ moduleSpan(M, R, S)
proof
  exact moduleSpan.subset_of at R, M, S with *

-- Submodule.span_le.
theorem moduleSpan.least (S N : Set)
  requires subset : S ⊆ M.carrier
  requires sub : SubmoduleOf(N, M, R)
  shows moduleSpan(M, R, S) ⊆ N ↔ S ⊆ N
proof
  exact moduleSpan.least_of at R, M, S, N with *

-- Submodule.span_mono.
theorem moduleSpan.mono (S T : Set)
  requires subset : S ⊆ T
  shows moduleSpan(M, R, S) ⊆ moduleSpan(M, R, T)
proof
  intros v hv
  obtain ⟨vIn, vAll⟩ := moduleSpan.membership.forward with hv
  apply moduleSpan.membership.backward
  refine ⟨vIn, ?_⟩
  intros N sub contains
  have smaller : S ⊆ N
    intros x hx
    exact contains with x, (subset with x, hx)
  exact vAll with N, sub, smaller

theorem moduleSpan.of_submodule (N : Set)
  requires sub : SubmoduleOf(N, M, R)
  shows moduleSpan(M, R, N) = N
proof
  have subsetN := SubmoduleOf.subset at R, M, N with *
  have refl : N ⊆ N
    intros x hx
    exact hx
  have within := (moduleSpan.least at R, M, N, N with *).backward with refl
  have contains := moduleSpan.subset_span at R, M, N with *
  ext v
  constructor
  . intro hv
    exact within with v, hv
  . intro hv
    exact contains with v, hv

-- Submodule.mem_span_singleton: the span of {v} is {r • v}.
theorem moduleSpan.singleton (v : M)
  shows moduleSpan(M, R, {v}) =
    scalarMultiples(M, R, v)
proof
  have oneIn := Ring.one_mem at R with ring
  have multiplesSub : SubmoduleOf(scalarMultiples(M, R, v), M, R)
    unfold SubmoduleOf
    refine ⟨module, ?_, ?_, ?_, ?_⟩
    . intros w hw
      obtain ⟨wIn, _⟩ := scalarMultiples.membership.forward with hw
      exact wIn
    . have zeroIn := Ring.zero_mem at R with ring
      have zeroM := Module.zero_mem at R, M with *
      have law := zero_smul at R, M, v with *
      apply scalarMultiples.membership.backward
      refine ⟨zeroM, R.zero, zeroIn, ?_⟩
      symm
      exact law
    . intros a ha b hb
      obtain ⟨aIn, r, hr, ar⟩ := scalarMultiples.membership.forward with ha
      obtain ⟨bIn, s, hs, bs⟩ := scalarMultiples.membership.forward with hb
      have sumIn := Module.add_mem at R, M, a, b with *
      have rs := Ring.add_mem at R, r, s with *
      have law := add_smul at R, M, r, s, v with *
      apply scalarMultiples.membership.backward
      refine ⟨sumIn, call2(R.add, r, s), rs, ?_⟩
      rw [ar, bs, law]
    . intros t ht a ha
      obtain ⟨aIn, r, hr, ar⟩ := scalarMultiples.membership.forward with ha
      have smulIn := Module.smul_mem at R, M, t, a with *
      have tr := Ring.mul_mem at R, t, r with *
      have law := mul_smul at R, M, t, r, v with *
      apply scalarMultiples.membership.backward
      refine ⟨smulIn, call2(R.mul, t, r), tr, ?_⟩
      rw [ar, law]
  have vSelf : v ∈ scalarMultiples(M, R, v)
    have law := one_smul at R, M, v with *
    apply scalarMultiples.membership.backward
    refine ⟨assumption, R.one, oneIn, ?_⟩
    symm
    exact law
  have singletonSub : {v} ⊆ M.carrier
    intros x hx
    have same := singleton.membership.forward with hx
    rw same
    assumption
  have contains : {v} ⊆ scalarMultiples(M, R, v)
    intros x hx
    have same := singleton.membership.forward with hx
    rw same
    exact vSelf
  have within := (moduleSpan.least at R, M, {v}, scalarMultiples(M, R, v) with *).backward with contains
  ext w
  constructor
  . intro hw
    exact within with w, hw
  . intro hw
    obtain ⟨wIn, r, hr, wr⟩ := scalarMultiples.membership.forward with hw
    apply moduleSpan.membership.backward
    refine ⟨wIn, ?_⟩
    intros N sub singletonIn
    have vN := singletonIn with v, (singleton.self at v)
    rw wr
    exact SubmoduleOf.smul_mem at R, M, N, r, v with *

-- Submodule.mem_span_set': the span of a set is the set of linear
-- combinations of its finite subsets.
theorem moduleSpan.combinations (S : Set)
  requires subset : S ⊆ M.carrier
  shows moduleSpan(M, R, S) = finiteCombinations(M, R, S)
proof
  sorry

-- Submodule.mem_span_range_iff_exists_fun: over a finite index set, the
-- span of the range of a family is the set of its linear combinations.
theorem moduleSpan.range_family (I v : Set)
  requires finite : Finite(I)
  requires family : v : I → M.carrier
  shows moduleSpan(M, R, functionImage(v, I, M.carrier)) =
    familyCombinations(M, R, I, v)
proof
  sorry

-- Submodule.span_induction: a set containing S and zero and closed under
-- sums and the action contains the span.
theorem moduleSpan.induction (S P : Set)
  requires base : S ⊆ P
  requires zeroIn : M.zero ∈ P
  requires addIn : ∀ v w ∈ P ∩ M.carrier, call2(M.add, v, w) ∈ P
  requires smulIn : ∀ r ∈ R.carrier, ∀ v ∈ P ∩ M.carrier, call2(M.smul, r, v) ∈ P
  shows moduleSpan(M, R, S) ⊆ P
proof
  sorry

theorem submoduleSum.submodule (N P : Set)
  requires first : SubmoduleOf(N, M, R)
  requires second : SubmoduleOf(P, M, R)
  shows SubmoduleOf(submoduleSum(M, N, P), M, R)
proof
  obtain ⟨_, sN, zN, aN, mN⟩ := first
  obtain ⟨_, sP, zP, aP, mP⟩ := second
  have zeroM := Module.zero_mem at R, M with *
  unfold SubmoduleOf
  refine ⟨module, ?_, ?_, ?_, ?_⟩
  . intros v hv
    obtain ⟨vIn, _⟩ := submoduleSum.membership.forward with hv
    exact vIn
  . have unit := Module.add_zero at R, M, M.zero with *
    apply submoduleSum.membership.backward
    refine ⟨zeroM, M.zero, zN, M.zero, zP, ?_⟩
    symm
    exact unit
  . intros v hv w hw
    obtain ⟨vIn, x, xN, y, yP, vxy⟩ := submoduleSum.membership.forward with hv
    obtain ⟨wIn, x2, x2N, y2, y2P, wxy⟩ := submoduleSum.membership.forward with hw
    have xM := sN with x, xN
    have yM := sP with y, yP
    have x2M := sN with x2, x2N
    have y2M := sP with y2, y2P
    have sumIn := Module.add_mem at R, M, v, w with *
    have shuffle := Module.add_add_add_comm at R, M, x, y, x2, y2 with *
    apply submoduleSum.membership.backward
    have xx := aN with x, xN, x2, x2N
    have yy := aP with y, yP, y2, y2P
    refine ⟨sumIn, call2(M.add, x, x2), xx, call2(M.add, y, y2), yy, ?_⟩
    rw [vxy, wxy]
    exact shuffle
  . intros r hr v hv
    obtain ⟨vIn, x, xN, y, yP, vxy⟩ := submoduleSum.membership.forward with hv
    have xM := sN with x, xN
    have yM := sP with y, yP
    have smulIn := Module.smul_mem at R, M, r, v with *
    have law := smul_add at R, M, r, x, y with *
    apply submoduleSum.membership.backward
    have rx := mN with r, hr, x, xN
    have ry := mP with r, hr, y, yP
    refine ⟨smulIn, call2(M.smul, r, x), rx, call2(M.smul, r, y), ry, ?_⟩
    rw [vxy, law]

-- Submodule.mem_sup: N + P is the span of N ∪ P.
theorem submoduleSum.span_union (N P : Set)
  requires first : SubmoduleOf(N, M, R)
  requires second : SubmoduleOf(P, M, R)
  shows submoduleSum(M, N, P) = moduleSpan(M, R, N ∪ P)
proof
  have sumSub := submoduleSum.submodule at R, M, N, P with *
  have spanSub := moduleSpan.submodule at R, M, N ∪ P with *
  have sN := SubmoduleOf.subset at R, M, N with *
  have sP := SubmoduleOf.subset at R, M, P with *
  have zN := SubmoduleOf.zero_mem at R, M, N with *
  have zP := SubmoduleOf.zero_mem at R, M, P with *
  have unionSub : N ∪ P ⊆ M.carrier
    intros x hx
    have cases := union2.membership.forward with hx
    cases cases with inN | inP
    . exact sN with x, inN
    . exact sP with x, inP
  have contains := moduleSpan.subset_span at R, M, N ∪ P with *
  have unionIn : N ∪ P ⊆ submoduleSum(M, N, P)
    intros x hx
    have xM := unionSub with x, hx
    have cases := union2.membership.forward with hx
    apply submoduleSum.membership.backward
    refine ⟨xM, ?_⟩
    cases cases with inN | inP
    . have unit := Module.add_zero at R, M, x with *
      refine ⟨x, inN, M.zero, zP, ?_⟩
      symm
      exact unit
    . have unit := Module.zero_add at R, M, x with *
      refine ⟨M.zero, zN, x, inP, ?_⟩
      symm
      exact unit
  have within := (moduleSpan.least at R, M, N ∪ P, submoduleSum(M, N, P) with *).backward with unionIn
  ext v
  constructor
  . intro hv
    obtain ⟨vIn, x, xN, y, yP, vxy⟩ := submoduleSum.membership.forward with hv
    have xS := contains with x, (union2.left at x, N, P with xN)
    have yS := contains with y, (union2.right at y, N, P with yP)
    rw vxy
    exact SubmoduleOf.add_mem at R, M, moduleSpan(M, R, N ∪ P), x, y with *
  . intro hv
    exact within with v, hv

theorem SubmoduleOf.intersection (N P : Set)
  requires first : SubmoduleOf(N, M, R)
  requires second : SubmoduleOf(P, M, R)
  shows SubmoduleOf(N ∩ P, M, R)
proof
  obtain ⟨_, sN, zN, aN, mN⟩ := first
  obtain ⟨_, sP, zP, aP, mP⟩ := second
  unfold SubmoduleOf
  refine ⟨module, ?_, ?_, ?_, ?_⟩
  . intros v hv
    obtain ⟨vN, vP⟩ := intersection.membership.forward with hv
    exact sN with v, vN
  . apply intersection.membership.backward
    exact ⟨zN, zP⟩
  . intros v hv w hw
    obtain ⟨vN, vP⟩ := intersection.membership.forward with hv
    obtain ⟨wN, wP⟩ := intersection.membership.forward with hw
    apply intersection.membership.backward
    have a1 := aN with v, vN, w, wN
    have a2 := aP with v, vP, w, wP
    exact ⟨a1, a2⟩
  . intros r hr v hv
    obtain ⟨vN, vP⟩ := intersection.membership.forward with hv
    apply intersection.membership.backward
    have a1 := mN with r, hr, v, vN
    have a2 := mP with r, hr, v, vP
    exact ⟨a1, a2⟩

theorem SubmoduleOf.whole
  shows SubmoduleOf(M.carrier, M, R)
proof
  have zeroM := Module.zero_mem at R, M with *
  unfold SubmoduleOf
  refine ⟨module, ?_, zeroM, ?_, ?_⟩
  . intros v hv
    exact hv
  . intros v hv w hw
    exact Module.add_mem at R, M, v, w with *
  . intros r hr v hv
    exact Module.smul_mem at R, M, r, v with *

theorem SubmoduleOf.zero_submodule
  shows SubmoduleOf({M.zero}, M, R)
proof
  have zeroM := Module.zero_mem at R, M with *
  have zeroSelf := singleton.self at M.zero
  unfold SubmoduleOf
  refine ⟨module, ?_, zeroSelf, ?_, ?_⟩
  . intros v hv
    have same := singleton.membership.forward with hv
    rw same
    exact zeroM
  . intros v hv w hw
    have sv := singleton.membership.forward with hv
    have sw := singleton.membership.forward with hw
    have unit := Module.add_zero at R, M, M.zero with *
    rw [sv, sw, unit]
    exact zeroSelf
  . intros r hr v hv
    have sv := singleton.membership.forward with hv
    have vanish := smul_zero at R, M, r with *
    rw [sv, vanish]
    exact zeroSelf

end SpanLaws

-- Section: Laws of finite sums
section SumLaws
variable (R M : Set)
hypothesis ring : Ring(R)
hypothesis module : Module(M, R)

theorem moduleSum.mem (V w : Set)
  requires finite : Finite(V)
  requires values : w : V → M.carrier
  shows moduleSum(M, V, w) ∈ M.carrier
proof
  exact moduleSum.mem_of at R, M, V, w with *

theorem moduleSum.empty (w : Set)
  requires values : w : ∅ → M.carrier
  shows moduleSum(M, ∅, w) = M.zero
proof
  exact moduleSum.empty_of at R, M, w with *

theorem moduleSum.singleton (x w : Set)
  requires values : w : {x} → M.carrier
  shows moduleSum(M, {x}, w) = w(x)
proof
  have finite := Finite.empty
  have fresh : x ∉ ∅
    exact empty.membership with x
  have shape : ∅ ∪ {x} = {x}
    exact union2.left_empty at {x}
  rw ← shape at values
  have inserted := moduleSum.insert_of at R, M, ∅, w, x with *
  have emptySubset : ∅ ⊆ ∅ ∪ {x}
    intros y hy
    exfalso
    exact empty.membership with y, hy
  have restricted := restrict.domain_function at w, ∅ ∪ {x}, M.carrier, ∅ with values, emptySubset
  have zero := moduleSum.empty at R, M, restrict(w, ∅) with *
  have xIn := union2.right at x, ∅, {x} with (singleton.self at x)
  have wx := FunctionBetween.apply_closed with values, xIn
  have unit := Module.zero_add at R, M, w(x) with *
  rw [zero, unit, shape] at inserted
  exact inserted

theorem moduleSum.insert (V w x : Set)
  requires finite : Finite(V)
  requires fresh : x ∉ V
  requires values : w : V ∪ {x} → M.carrier
  shows moduleSum(M, V ∪ {x}, w) = moduleSum(M, V, restrict(w, V)) + w(x)
proof
  exact moduleSum.insert_of at R, M, V, w, x with *

theorem moduleSum.congr (V w u : Set)
  requires finite : Finite(V)
  requires first : w : V → M.carrier
  requires second : u : V → M.carrier
  requires agree : ∀ i ∈ V, w(i) = u(i)
  shows moduleSum(M, V, w) = moduleSum(M, V, u)
proof
  have same := FunctionBetween.ext with first, second, agree
  rw same

-- Finset.smul_sum.
theorem moduleSum.smul (V w r : Set)
  requires finite : Finite(V)
  requires values : w : V → M.carrier
  requires scalar : r ∈ R.carrier
  shows r • moduleSum(M, V, w) = moduleSum(M, V, pointwiseSmul(V, M, r, w))
proof
  obtain ⟨n, natural, e, enumeration⟩ := Finite.enumeration with finite
  have injective := Bijective.injective with enumeration
  have eF := Injective.function with injective
  have valuesW := WeightedValues.of_functions with values, eF
  have pointwise : ∀ i ∈ V, call2(M.smul, r, w(i)) ∈ M.carrier
    intros i hi
    have wi := FunctionBetween.apply_closed with values, hi
    exact Module.smul_mem at R, M, r, w(i) with *
  have scaledF := pointwiseSmul.function at V, M, r, w with pointwise
  have left := moduleSum.enumeration at R, M, V, w, e, n with *
  have right := moduleSum.enumeration at R, M, V, pointwiseSmul(V, M, r, w), e, n with *
  have equations : ∀ i ∈ n, pointwiseSmul(V, M, r, w)(e(i)) = call2(M.smul, r, w(e(i)))
    intros i hi
    have ei := FunctionBetween.apply_closed with eF, hi
    exact pointwiseSmul.apply at V, M, r, w, e(i) with pointwise, ei
  have law := indexedRingSum.module_smul at R, M, w, pointwiseSmul(V, M, r, w), e, r, n with *
  rw [left, right]
  symm
  exact law with valuesW, equations

-- Finset.sum_smul.
theorem moduleSum.sum_smul (V c v : Set)
  requires comm : CommRing(R)
  requires finite : Finite(V)
  requires coefficients : c : V → R.carrier
  requires vector : v ∈ M.carrier
  shows finiteRingSum(V, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, c) • v =
    moduleCombination(M, R, V, c, constantFunction(V, M.carrier, v))
proof
  obtain ⟨n, natural, e, enumeration⟩ := Finite.enumeration with finite
  have injective := Bijective.injective with enumeration
  have eF := Injective.function with injective
  have commParts := CommRing.parts with comm
  have ringSum := finiteRingSum.enumeration at V, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, c, e, n with commParts, coefficients, enumeration
  have constant := constantFunction.function at V, M.carrier, v with vector
  have terms := combinationTerms.function at M, R, V, c, constantFunction(V, M.carrier, v) with module, coefficients, constant
  have value := moduleSum.enumeration at R, M, V, combinationTerms(M, R, V, c, constantFunction(V, M.carrier, v)), e, n with terms, enumeration
  have valuesC := WeightedValues.of_functions with coefficients, eF
  have equations : ∀ i ∈ n, combinationTerms(M, R, V, c, constantFunction(V, M.carrier, v))(e(i)) = call2(M.smul, c(e(i)), v)
    intros i hi
    have ei := FunctionBetween.apply_closed with eF, hi
    have e1 := combinationTerms.value at M, R, V, c, constantFunction(V, M.carrier, v), e(i) with module, coefficients, constant, ei
    have e2 := constantFunction.apply at V, M.carrier, e(i), v with ei, vector
    rw [e1, e2]
  have law := indexedRingSum.module_sum_smul at R, M, c, combinationTerms(M, R, V, c, constantFunction(V, M.carrier, v)), e, v, n with *
  unfold moduleCombination
  rw [ringSum, value]
  exact law with valuesC, equations

theorem moduleSum.add (V w u : Set)
  requires finite : Finite(V)
  requires first : w : V → M.carrier
  requires second : u : V → M.carrier
  shows moduleSum(M, V, w) + moduleSum(M, V, u) =
    moduleSum(M, V, pointwiseSum(V, M, w, u))
proof
  obtain ⟨n, natural, e, enumeration⟩ := Finite.enumeration with finite
  have injective := Bijective.injective with enumeration
  have eF := Injective.function with injective
  have valuesW := WeightedValues.of_functions with first, eF
  have valuesU := WeightedValues.of_functions with second, eF
  have pointwise : ∀ i ∈ V, call2(M.add, w(i), u(i)) ∈ M.carrier
    intros i hi
    have wi := FunctionBetween.apply_closed with first, hi
    have ui := FunctionBetween.apply_closed with second, hi
    exact Module.add_mem at R, M, w(i), u(i) with *
  have sumF := pointwiseSum.function at V, M, w, u with pointwise
  have left := moduleSum.enumeration at R, M, V, w, e, n with first, enumeration
  have middle := moduleSum.enumeration at R, M, V, u, e, n with second, enumeration
  have right := moduleSum.enumeration at R, M, V, pointwiseSum(V, M, w, u), e, n with sumF, enumeration
  have equations : ∀ i ∈ n, pointwiseSum(V, M, w, u)(e(i)) = call2(M.add, w(e(i)), u(e(i)))
    intros i hi
    have ei := FunctionBetween.apply_closed with eF, hi
    exact pointwiseSum.apply at V, M, w, u, e(i) with pointwise, ei
  have law := indexedRingSum.module_add at R, M, w, u, pointwiseSum(V, M, w, u), e, n with *
  rw [left, middle, right]
  symm
  exact law with valuesW, valuesU, equations

theorem moduleSum.zero_terms (V : Set)
  requires finite : Finite(V)
  shows moduleSum(M, V, constantFunction(V, M.carrier, M.zero)) = M.zero
proof
  obtain ⟨n, natural, e, enumeration⟩ := Finite.enumeration with finite
  have injective := Bijective.injective with enumeration
  have eF := Injective.function with injective
  have zeroM := Module.zero_mem at R, M with *
  have constant := constantFunction.function at V, M.carrier, M.zero with zeroM
  have value := moduleSum.enumeration at R, M, V, constantFunction(V, M.carrier, M.zero), e, n with *
  have vanish : ∀ i ∈ n, constantFunction(V, M.carrier, M.zero)(e(i)) = M.zero
    intros i hi
    have ei := FunctionBetween.apply_closed with eF, hi
    exact constantFunction.apply at V, M.carrier, e(i), M.zero with ei, zeroM
  have zero := indexedRingSum.module_zero at R, M, constantFunction(V, M.carrier, M.zero), e, n with *
  rw value
  exact zero with vanish

-- Reindexing along a bijection e : U → V (Finset.sum_bij).
theorem moduleSum.reindex (U V e w : Set)
  requires finite : Finite(V)
  requires bijective : BijectiveBetween(e, U, V)
  requires values : w : V → M.carrier
  shows moduleSum(M, U, compose(w, e, U, V, M.carrier)) = moduleSum(M, V, w)
proof
  exact moduleSum.reindex_of at R, M, U, V, e, w with *

-- The sum over a union of two disjoint finite sets.
theorem moduleSum.union (U V w : Set)
  requires finiteU : Finite(U)
  requires finiteV : Finite(V)
  requires disjoint : U ∩ V = ∅
  requires values : w : U ∪ V → M.carrier
  shows moduleSum(M, U ∪ V, w) =
    moduleSum(M, U, restrict(w, U)) + moduleSum(M, V, restrict(w, V))
proof
  have law := moduleSum.union_of at R, M, U, V with finiteU, finiteV
  exact law with w, values, disjoint

-- Finset.sum_product and Finset.sum_comm: a sum over U × V is the
-- iterated sum.
theorem moduleSum.product (U V w : Set)
  requires finiteU : Finite(U)
  requires finiteV : Finite(V)
  requires values : w : U × V → M.carrier
  shows moduleSum(M, U × V, w) = moduleSum(M, U, familyRowSums(M, U, V, w))
proof
  have law := moduleSum.product_of at R, M, U, V with finiteU, finiteV
  obtain ⟨_, sums⟩ := law
  exact sums with w, values

-- Terms vanishing off a subset do not contribute.
theorem moduleSum.subset_support (U V w : Set)
  requires finite : Finite(V)
  requires subset : U ⊆ V
  requires values : w : V → M.carrier
  requires vanishing : ∀ i ∈ V, i ∉ U → w(i) = M.zero
  shows moduleSum(M, V, w) = moduleSum(M, U, restrict(w, U))
proof
  have finiteU := Finite.subset with finite, subset
  have restSub := difference.subset_left at V, U
  have finiteD := Finite.subset with finite, restSub
  have split : V = U ∪ (V ∖ U)
    ext y
    constructor
    . intro hy
      have cases : y ∈ U ∨ y ∉ U by tauto
      cases cases with inU | outU
      . exact union2.left at y, U, V ∖ U with inU
      . have inD : y ∈ V ∖ U
          exact difference.membership.backward with ⟨hy, outU⟩
        exact union2.right at y, U, V ∖ U with inD
    . intro hy
      have cases := union2.membership.forward with hy
      cases cases with inU | inD
      . exact subset with y, inU
      . exact restSub with y, inD
  have disjoint : U ∩ (V ∖ U) = ∅
    ext y
    constructor
    . intro hy
      exfalso
      obtain ⟨yU, yD⟩ := intersection.membership.forward with hy
      obtain ⟨yV, notU⟩ := difference.membership.forward with yD
      exact notU with yU
    . intro hy
      exfalso
      exact empty.membership with y, hy
  have restricted := restrict.domain_function at w, V, M.carrier, V ∖ U with values, restSub
  have zeroM := Module.zero_mem at R, M with *
  have constant := constantFunction.function at V ∖ U, M.carrier, M.zero with zeroM
  have vanish : restrict(w, V ∖ U) = constantFunction(V ∖ U, M.carrier, M.zero)
    apply FunctionBetween.ext with restricted, constant
    intros y hy
    obtain ⟨yV, notU⟩ := difference.membership.forward with hy
    have r1 := restrict.domain_apply at w, V, M.carrier, V ∖ U, y with values, restSub, hy
    have r2 := constantFunction.apply at V ∖ U, M.carrier, y, M.zero with hy, zeroM
    have zero := vanishing with y, yV, notU
    rw [r1, r2, zero]
  have zeroSum := moduleSum.zero_terms at R, M, V ∖ U with finiteD
  have restrictedU := restrict.domain_function at w, V, M.carrier, U with values, subset
  have sumU := moduleSum.mem_of at R, M, U, restrict(w, U) with *
  have unit := Module.add_zero at R, M, moduleSum(M, U, restrict(w, U)) with *
  rw split at values
  have law := moduleSum.union_of at R, M, U, V ∖ U with finiteU, finiteD
  have splitSum := law with w, values, disjoint
  rw ← split at splitSum
  rw [splitSum, vanish, zeroSum, unit]

end SumLaws

-- Section: Products, function modules, and Hom
section Constructions
variable (R : Set)
hypothesis ring : Ring(R)

theorem productModule.module (M N : Set)
  requires moduleM : Module(M, R)
  requires moduleN : Module(N, R)
  shows Module(productModule(M, R, N), R)
proof
  have addF := productModuleAdd.function at M, R, N with moduleM, moduleN
  have negF := productModuleNeg.function at M, R, N with moduleM, moduleN
  have smulF := productModuleSmul.function at M, R, N with moduleM, moduleN
  have zeroM := Module.zero_mem at R, M with *
  have zeroN := Module.zero_mem at R, N with *
  have zeroIn := product.pair at Module.zero(M), Module.zero(N), M.carrier, N.carrier with zeroM, zeroN
  unfold productModule
  apply Module.of_laws with ring, addF, zeroIn, negF, smulF
  . intros p hp q hq t ht
    obtain ⟨b1, a, ha, b, hb, ps⟩ := product.membership.forward with hp
    obtain ⟨b2, c, hc, d, hd, qs⟩ := product.membership.forward with hq
    obtain ⟨b3, e, he, f, hf, ts⟩ := product.membership.forward with ht
    have ac := Module.add_mem at R, M, a, c with *
    have bd := Module.add_mem at R, N, b, d with *
    have ce := Module.add_mem at R, M, c, e with *
    have df := Module.add_mem at R, N, d, f with *
    have v1 := productModuleAdd.pair_value at M, R, N, a, b, c, d with *
    have v2 := productModuleAdd.pair_value at M, R, N, call2(M.add, a, c), call2(N.add, b, d), e, f with *
    have v3 := productModuleAdd.pair_value at M, R, N, c, d, e, f with *
    have v4 := productModuleAdd.pair_value at M, R, N, a, b, call2(M.add, c, e), call2(N.add, d, f) with *
    have l1 := Module.add_assoc at R, M, a, c, e with *
    have l2 := Module.add_assoc at R, N, b, d, f with *
    rw [ps, qs, ts, v1, v2, v3, v4, l1, l2]
  . intros p hp q hq
    obtain ⟨b1, a, ha, b, hb, ps⟩ := product.membership.forward with hp
    obtain ⟨b2, c, hc, d, hd, qs⟩ := product.membership.forward with hq
    have v1 := productModuleAdd.pair_value at M, R, N, a, b, c, d with *
    have v2 := productModuleAdd.pair_value at M, R, N, c, d, a, b with *
    have l1 := Module.add_comm at R, M, a, c with *
    have l2 := Module.add_comm at R, N, b, d with *
    rw [ps, qs, v1, v2, l1, l2]
  . intros p hp
    obtain ⟨b1, a, ha, b, hb, ps⟩ := product.membership.forward with hp
    have v1 := productModuleAdd.pair_value at M, R, N, Module.zero(M), Module.zero(N), a, b with *
    have l1 := Module.zero_add at R, M, a with *
    have l2 := Module.zero_add at R, N, b with *
    rw [ps, v1, l1, l2]
  . intros p hp
    obtain ⟨b1, a, ha, b, hb, ps⟩ := product.membership.forward with hp
    have na := Module.neg_mem at R, M, a with *
    have nb := Module.neg_mem at R, N, b with *
    have v0 := productModuleNeg.pair_value at M, R, N, a, b with *
    have v1 := productModuleAdd.pair_value at M, R, N, apply(M.neg, a), apply(N.neg, b), a, b with *
    have l1 := Module.neg_add at R, M, a with *
    have l2 := Module.neg_add at R, N, b with *
    rw [ps, v0, v1, l1, l2]
  . intros r hr p hp q hq
    obtain ⟨b1, a, ha, b, hb, ps⟩ := product.membership.forward with hp
    obtain ⟨b2, c, hc, d, hd, qs⟩ := product.membership.forward with hq
    have ac := Module.add_mem at R, M, a, c with *
    have bd := Module.add_mem at R, N, b, d with *
    have ra := Module.smul_mem at R, M, r, a with *
    have rb := Module.smul_mem at R, N, r, b with *
    have rc := Module.smul_mem at R, M, r, c with *
    have rd := Module.smul_mem at R, N, r, d with *
    have v1 := productModuleAdd.pair_value at M, R, N, a, b, c, d with *
    have v2 := productModuleSmul.pair_value at M, R, N, r, call2(M.add, a, c), call2(N.add, b, d) with *
    have v3 := productModuleSmul.pair_value at M, R, N, r, a, b with *
    have v4 := productModuleSmul.pair_value at M, R, N, r, c, d with *
    have v5 := productModuleAdd.pair_value at M, R, N, call2(M.smul, r, a), call2(N.smul, r, b), call2(M.smul, r, c), call2(N.smul, r, d) with *
    have l1 := smul_add at R, M, r, a, c with *
    have l2 := smul_add at R, N, r, b, d with *
    rw [ps, qs, v1, v2, v3, v4, v5, l1, l2]
  . intros r hr s hs p hp
    obtain ⟨b1, a, ha, b, hb, ps⟩ := product.membership.forward with hp
    have rs := Ring.add_mem at R, r, s with *
    have ra := Module.smul_mem at R, M, r, a with *
    have rb := Module.smul_mem at R, N, r, b with *
    have sa := Module.smul_mem at R, M, s, a with *
    have sb := Module.smul_mem at R, N, s, b with *
    have v1 := productModuleSmul.pair_value at M, R, N, call2(R.add, r, s), a, b with *
    have v2 := productModuleSmul.pair_value at M, R, N, r, a, b with *
    have v3 := productModuleSmul.pair_value at M, R, N, s, a, b with *
    have v4 := productModuleAdd.pair_value at M, R, N, call2(M.smul, r, a), call2(N.smul, r, b), call2(M.smul, s, a), call2(N.smul, s, b) with *
    have l1 := add_smul at R, M, r, s, a with *
    have l2 := add_smul at R, N, r, s, b with *
    rw [ps, v1, v2, v3, v4, l1, l2]
  . intros r hr s hs p hp
    obtain ⟨b1, a, ha, b, hb, ps⟩ := product.membership.forward with hp
    have rs := Ring.mul_mem at R, r, s with *
    have sa := Module.smul_mem at R, M, s, a with *
    have sb := Module.smul_mem at R, N, s, b with *
    have v1 := productModuleSmul.pair_value at M, R, N, call2(R.mul, r, s), a, b with *
    have v2 := productModuleSmul.pair_value at M, R, N, s, a, b with *
    have v3 := productModuleSmul.pair_value at M, R, N, r, call2(M.smul, s, a), call2(N.smul, s, b) with *
    have l1 := mul_smul at R, M, r, s, a with *
    have l2 := mul_smul at R, N, r, s, b with *
    rw [ps, v1, v2, v3, l1, l2]
  . intros p hp
    obtain ⟨b1, a, ha, b, hb, ps⟩ := product.membership.forward with hp
    have oneIn := Ring.one_mem at R with ring
    have v1 := productModuleSmul.pair_value at M, R, N, R.one, a, b with *
    have l1 := one_smul at R, M, a with *
    have l2 := one_smul at R, N, b with *
    rw [ps, v1, l1, l2]

theorem productModule.first_linear (M N : Set)
  requires moduleM : Module(M, R)
  requires moduleN : Module(N, R)
  shows LinearMap(firstProjection(M.carrier, N.carrier),
    productModule(M, R, N), R, M)
proof
  have product := productModule.module at R, M, N with *
  have function := firstProjection.function_of at M.carrier, N.carrier
  have carrier := productModule.carrier_eq at M, R, N
  have addEq := productModule.add_eq at M, R, N
  have smulEq := productModule.smul_eq at M, R, N
  apply LinearMap.of_laws with product, moduleM
  . rw carrier
    exact function
  . rw [carrier, addEq]
    intros p hp q hq
    obtain ⟨b1, a, ha, b, hb, ps⟩ := product.membership.forward with hp
    obtain ⟨b2, c, hc, d, hd, qs⟩ := product.membership.forward with hq
    have ac := Module.add_mem at R, M, a, c with *
    have bd := Module.add_mem at R, N, b, d with *
    have v1 := productModuleAdd.pair_value at M, R, N, a, b, c, d with *
    have f1 := firstProjection.pair_value at M.carrier, N.carrier, call2(M.add, a, c), call2(N.add, b, d) with ac, bd
    have f2 := firstProjection.pair_value at M.carrier, N.carrier, a, b with ha, hb
    have f3 := firstProjection.pair_value at M.carrier, N.carrier, c, d with hc, hd
    rw [ps, qs, v1, f1, f2, f3]
  . rw [carrier, smulEq]
    intros r hr p hp
    obtain ⟨b1, a, ha, b, hb, ps⟩ := product.membership.forward with hp
    have ra := Module.smul_mem at R, M, r, a with *
    have rb := Module.smul_mem at R, N, r, b with *
    have v1 := productModuleSmul.pair_value at M, R, N, r, a, b with *
    have f1 := firstProjection.pair_value at M.carrier, N.carrier, call2(M.smul, r, a), call2(N.smul, r, b) with ra, rb
    have f2 := firstProjection.pair_value at M.carrier, N.carrier, a, b with ha, hb
    rw [ps, v1, f1, f2]

theorem productModule.second_linear (M N : Set)
  requires moduleM : Module(M, R)
  requires moduleN : Module(N, R)
  shows LinearMap(secondProjection(M.carrier, N.carrier),
    productModule(M, R, N), R, N)
proof
  have product := productModule.module at R, M, N with *
  have function := secondProjection.function_of at M.carrier, N.carrier
  have carrier := productModule.carrier_eq at M, R, N
  have addEq := productModule.add_eq at M, R, N
  have smulEq := productModule.smul_eq at M, R, N
  apply LinearMap.of_laws with product, moduleN
  . rw carrier
    exact function
  . rw [carrier, addEq]
    intros p hp q hq
    obtain ⟨b1, a, ha, b, hb, ps⟩ := product.membership.forward with hp
    obtain ⟨b2, c, hc, d, hd, qs⟩ := product.membership.forward with hq
    have ac := Module.add_mem at R, M, a, c with *
    have bd := Module.add_mem at R, N, b, d with *
    have v1 := productModuleAdd.pair_value at M, R, N, a, b, c, d with *
    have f1 := secondProjection.pair_value at M.carrier, N.carrier, call2(M.add, a, c), call2(N.add, b, d) with ac, bd
    have f2 := secondProjection.pair_value at M.carrier, N.carrier, a, b with ha, hb
    have f3 := secondProjection.pair_value at M.carrier, N.carrier, c, d with hc, hd
    rw [ps, qs, v1, f1, f2, f3]
  . rw [carrier, smulEq]
    intros r hr p hp
    obtain ⟨b1, a, ha, b, hb, ps⟩ := product.membership.forward with hp
    have ra := Module.smul_mem at R, M, r, a with *
    have rb := Module.smul_mem at R, N, r, b with *
    have v1 := productModuleSmul.pair_value at M, R, N, r, a, b with *
    have f1 := secondProjection.pair_value at M.carrier, N.carrier, call2(M.smul, r, a), call2(N.smul, r, b) with ra, rb
    have f2 := secondProjection.pair_value at M.carrier, N.carrier, a, b with ha, hb
    rw [ps, v1, f1, f2]

theorem functionModule.module (I M : Set)
  requires module : Module(M, R)
  shows Module(functionModule(R, I, M), R)
proof
  have addF := functionModuleAdd.function at R, I, M with module
  have negF := functionModuleNeg.function at R, I, M with module
  have smulF := functionModuleSmul.function at R, I, M with module
  have zeroM := Module.zero_mem at R, M with *
  have zeroIn := functionSpace.constant at I, M.carrier, M.zero with zeroM
  unfold functionModule
  apply Module.of_laws with ring, addF, zeroIn, negF, smulF
  . intros u hu v hv w hw
    have uv := pointwiseSum.space at R, I, M, u, v with *
    have vw := pointwiseSum.space at R, I, M, v, w with *
    have e1 := functionModuleAdd.pair_value at R, I, M, u, v with *
    have e2 := functionModuleAdd.pair_value at R, I, M, pointwiseSum(I, M, u, v), w with *
    have e3 := functionModuleAdd.pair_value at R, I, M, v, w with *
    have e4 := functionModuleAdd.pair_value at R, I, M, u, pointwiseSum(I, M, v, w) with *
    have left := pointwiseSum.space at R, I, M, pointwiseSum(I, M, u, v), w with *
    have right := pointwiseSum.space at R, I, M, u, pointwiseSum(I, M, v, w) with *
    rw [e1, e2, e3, e4]
    apply functionSpace.ext_of with left, right
    intros i hi
    have ui := functionSpace.apply_mem with hu, hi
    have vi := functionSpace.apply_mem with hv, hi
    have wi := functionSpace.apply_mem with hw, hi
    have a1 := pointwiseSum.at at R, I, M, pointwiseSum(I, M, u, v), w, i with *
    have a2 := pointwiseSum.at at R, I, M, u, v, i with *
    have a3 := pointwiseSum.at at R, I, M, u, pointwiseSum(I, M, v, w), i with *
    have a4 := pointwiseSum.at at R, I, M, v, w, i with *
    have law := Module.add_assoc at R, M, u(i), v(i), w(i) with *
    rw [a1, a2, a3, a4, law]
  . intros u hu v hv
    have e1 := functionModuleAdd.pair_value at R, I, M, u, v with *
    have e2 := functionModuleAdd.pair_value at R, I, M, v, u with *
    have left := pointwiseSum.space at R, I, M, u, v with *
    have right := pointwiseSum.space at R, I, M, v, u with *
    rw [e1, e2]
    apply functionSpace.ext_of with left, right
    intros i hi
    have ui := functionSpace.apply_mem with hu, hi
    have vi := functionSpace.apply_mem with hv, hi
    have a1 := pointwiseSum.at at R, I, M, u, v, i with *
    have a2 := pointwiseSum.at at R, I, M, v, u, i with *
    have law := Module.add_comm at R, M, u(i), v(i) with *
    rw [a1, a2, law]
  . intros u hu
    have e1 := functionModuleAdd.pair_value at R, I, M, constantFunction(I, M.carrier, M.zero), u with *
    have left := pointwiseSum.space at R, I, M, constantFunction(I, M.carrier, M.zero), u with *
    rw e1
    apply functionSpace.ext_of with left, hu
    intros i hi
    have ui := functionSpace.apply_mem with hu, hi
    have a1 := pointwiseSum.at at R, I, M, constantFunction(I, M.carrier, M.zero), u, i with *
    have c := constantFunction.apply at I, M.carrier, i, M.zero with hi, zeroM
    have law := Module.zero_add at R, M, u(i) with *
    rw [a1, c, law]
  . intros u hu
    have n1 := functionModuleNeg.value at R, I, M, u with module, hu
    have nu := pointwiseNeg.space at R, I, M, u with *
    have e1 := functionModuleAdd.pair_value at R, I, M, pointwiseNeg(I, M, u), u with *
    have left := pointwiseSum.space at R, I, M, pointwiseNeg(I, M, u), u with *
    rw [n1, e1]
    apply functionSpace.ext_of with left, zeroIn
    intros i hi
    have ui := functionSpace.apply_mem with hu, hi
    have a1 := pointwiseSum.at at R, I, M, pointwiseNeg(I, M, u), u, i with *
    have a2 := pointwiseNeg.at at R, I, M, u, i with *
    have c := constantFunction.apply at I, M.carrier, i, M.zero with hi, zeroM
    have law := Module.neg_add at R, M, u(i) with *
    rw [a1, a2, c, law]
  . intros r hr u hu v hv
    have uv := pointwiseSum.space at R, I, M, u, v with *
    have ru := pointwiseSmul.space at R, I, M, r, u with *
    have rv := pointwiseSmul.space at R, I, M, r, v with *
    have e1 := functionModuleAdd.pair_value at R, I, M, u, v with *
    have e2 := functionModuleSmul.pair_value at R, I, M, r, pointwiseSum(I, M, u, v) with *
    have e3 := functionModuleSmul.pair_value at R, I, M, r, u with *
    have e4 := functionModuleSmul.pair_value at R, I, M, r, v with *
    have e5 := functionModuleAdd.pair_value at R, I, M, pointwiseSmul(I, M, r, u), pointwiseSmul(I, M, r, v) with *
    have left := pointwiseSmul.space at R, I, M, r, pointwiseSum(I, M, u, v) with *
    have right := pointwiseSum.space at R, I, M, pointwiseSmul(I, M, r, u), pointwiseSmul(I, M, r, v) with *
    rw [e1, e2, e3, e4, e5]
    apply functionSpace.ext_of with left, right
    intros i hi
    have ui := functionSpace.apply_mem with hu, hi
    have vi := functionSpace.apply_mem with hv, hi
    have a1 := pointwiseSmul.at at R, I, M, r, pointwiseSum(I, M, u, v), i with *
    have a2 := pointwiseSum.at at R, I, M, u, v, i with *
    have a3 := pointwiseSum.at at R, I, M, pointwiseSmul(I, M, r, u), pointwiseSmul(I, M, r, v), i with *
    have a4 := pointwiseSmul.at at R, I, M, r, u, i with *
    have a5 := pointwiseSmul.at at R, I, M, r, v, i with *
    have law := smul_add at R, M, r, u(i), v(i) with *
    rw [a1, a2, a3, a4, a5, law]
  . intros r hr s hs u hu
    have rs := Ring.add_mem at R, r, s with *
    have ru := pointwiseSmul.space at R, I, M, r, u with *
    have su := pointwiseSmul.space at R, I, M, s, u with *
    have e1 := functionModuleSmul.pair_value at R, I, M, call2(R.add, r, s), u with *
    have e2 := functionModuleSmul.pair_value at R, I, M, r, u with *
    have e3 := functionModuleSmul.pair_value at R, I, M, s, u with *
    have e4 := functionModuleAdd.pair_value at R, I, M, pointwiseSmul(I, M, r, u), pointwiseSmul(I, M, s, u) with *
    have left := pointwiseSmul.space at R, I, M, call2(R.add, r, s), u with *
    have right := pointwiseSum.space at R, I, M, pointwiseSmul(I, M, r, u), pointwiseSmul(I, M, s, u) with *
    rw [e1, e2, e3, e4]
    apply functionSpace.ext_of with left, right
    intros i hi
    have ui := functionSpace.apply_mem with hu, hi
    have a1 := pointwiseSmul.at at R, I, M, call2(R.add, r, s), u, i with *
    have a2 := pointwiseSum.at at R, I, M, pointwiseSmul(I, M, r, u), pointwiseSmul(I, M, s, u), i with *
    have a3 := pointwiseSmul.at at R, I, M, r, u, i with *
    have a4 := pointwiseSmul.at at R, I, M, s, u, i with *
    have law := add_smul at R, M, r, s, u(i) with *
    rw [a1, a2, a3, a4, law]
  . intros r hr s hs u hu
    have rs := Ring.mul_mem at R, r, s with *
    have su := pointwiseSmul.space at R, I, M, s, u with *
    have e1 := functionModuleSmul.pair_value at R, I, M, call2(R.mul, r, s), u with *
    have e2 := functionModuleSmul.pair_value at R, I, M, s, u with *
    have e3 := functionModuleSmul.pair_value at R, I, M, r, pointwiseSmul(I, M, s, u) with *
    have left := pointwiseSmul.space at R, I, M, call2(R.mul, r, s), u with *
    have right := pointwiseSmul.space at R, I, M, r, pointwiseSmul(I, M, s, u) with *
    rw [e1, e2, e3]
    apply functionSpace.ext_of with left, right
    intros i hi
    have ui := functionSpace.apply_mem with hu, hi
    have a1 := pointwiseSmul.at at R, I, M, call2(R.mul, r, s), u, i with *
    have a2 := pointwiseSmul.at at R, I, M, r, pointwiseSmul(I, M, s, u), i with *
    have a3 := pointwiseSmul.at at R, I, M, s, u, i with *
    have law := mul_smul at R, M, r, s, u(i) with *
    rw [a1, a2, a3, law]
  . intros u hu
    have oneIn := Ring.one_mem at R with ring
    have e1 := functionModuleSmul.pair_value at R, I, M, R.one, u with *
    have left := pointwiseSmul.space at R, I, M, R.one, u with *
    rw e1
    apply functionSpace.ext_of with left, hu
    intros i hi
    have ui := functionSpace.apply_mem with hu, hi
    have a1 := pointwiseSmul.at at R, I, M, R.one, u, i with *
    have law := one_smul at R, M, u(i) with *
    rw [a1, law]

theorem functionModule.add_apply (I M u v i : Set)
  requires module : Module(M, R)
  requires first : u ∈ functionSpace(I, M.carrier)
  requires second : v ∈ functionSpace(I, M.carrier)
  requires index : i ∈ I
  shows call2(Module.add(functionModule(R, I, M)), u, v)(i) =
    call2(M.add, u(i), v(i))
proof
  have addEq := functionModule.add_eq at R, I, M
  have e1 := functionModuleAdd.pair_value at R, I, M, u, v with *
  rw [addEq, e1]
  exact pointwiseSum.at at R, I, M, u, v, i with *

theorem functionModule.smul_apply (I M r u i : Set)
  requires module : Module(M, R)
  requires scalar : r ∈ R.carrier
  requires vector : u ∈ functionSpace(I, M.carrier)
  requires index : i ∈ I
  shows call2(Module.smul(functionModule(R, I, M)), r, u)(i) =
    call2(M.smul, r, u(i))
proof
  have smulEq := functionModule.smul_eq at R, I, M
  have e1 := functionModuleSmul.pair_value at R, I, M, r, u with *
  rw [smulEq, e1]
  exact pointwiseSmul.at at R, I, M, r, u, i with *

theorem functionModule.add_mem_of (I M u v : Set)
  requires module : Module(M, R)
  requires first : u ∈ functionSpace(I, Module.carrier(M))
  requires second : v ∈ functionSpace(I, Module.carrier(M))
  shows call2(Module.add(functionModule(R, I, M)), u, v) ∈ functionSpace(I, Module.carrier(M))
proof
  have addEq := functionModule.add_eq at R, I, M
  have e1 := functionModuleAdd.pair_value at R, I, M, u, v with *
  rw [addEq, e1]
  exact pointwiseSum.space at R, I, M, u, v with *

theorem functionModule.smul_mem_of (I M r u : Set)
  requires module : Module(M, R)
  requires scalar : r ∈ Ring.carrier(R)
  requires first : u ∈ functionSpace(I, Module.carrier(M))
  shows call2(Module.smul(functionModule(R, I, M)), r, u) ∈ functionSpace(I, Module.carrier(M))
proof
  have smulEq := functionModule.smul_eq at R, I, M
  have e1 := functionModuleSmul.pair_value at R, I, M, r, u with *
  rw [smulEq, e1]
  exact pointwiseSmul.space at R, I, M, r, u with *

theorem evaluationMap.linear_of (I M i : Set)
  requires module : Module(M, R)
  requires index : i ∈ I
  shows LinearMap(evaluationMap(I, M, i), functionModule(R, I, M), R, M)
proof
  have fm := functionModule.module at R, I, M with *
  have values : ∀ u ∈ functionSpace(I, Module.carrier(M)), u(i) ∈ Module.carrier(M)
    intros u hu
    exact functionSpace.apply_mem with hu, index
  have function := evaluationMap.graph_function at I, M, i with values
  have carrier := functionModule.carrier_eq at R, I, M
  apply LinearMap.of_laws with fm, module
  . rw carrier
    exact function
  . rw carrier
    intros u hu v hv
    have sumIn := functionModule.add_mem_of at R, I, M, u, v with *
    have a1 := evaluationMap.graph_apply at I, M, i, call2(Module.add(functionModule(R, I, M)), u, v) with values, sumIn
    have a2 := evaluationMap.graph_apply at I, M, i, u with values, hu
    have a3 := evaluationMap.graph_apply at I, M, i, v with values, hv
    have law := functionModule.add_apply at R, I, M, u, v, i with *
    rw [a1, a2, a3, law]
  . rw carrier
    intros r hr u hu
    have smulIn := functionModule.smul_mem_of at R, I, M, r, u with *
    have a1 := evaluationMap.graph_apply at I, M, i, call2(Module.smul(functionModule(R, I, M)), r, u) with values, smulIn
    have a2 := evaluationMap.graph_apply at I, M, i, u with values, hu
    have law := functionModule.smul_apply at R, I, M, r, u, i with *
    rw [a1, a2, law]

theorem functionModule.sum_apply (I M V w i : Set)
  requires module : Module(M, R)
  requires finite : Finite(V)
  requires values : w : V → functionSpace(I, M.carrier)
  requires index : i ∈ I
  shows moduleSum(functionModule(R, I, M), V, w)(i) = moduleSum(M, V,
    familyEvaluate(V, M.carrier, w, i))
proof
  have lin := evaluationMap.linear_of at R, I, M, i with module, index
  have fm := functionModule.module at R, I, M with *
  have carrier := functionModule.carrier_eq at R, I, M
  have valuesF : w : V → Module.carrier(functionModule(R, I, M))
    rw carrier
    exact values
  have mapped := LinearMap.map_sum at R, functionModule(R, I, M), M, evaluationMap(I, M, i), V, w with ring, fm, module, lin, finite, valuesF
  have sumIn := moduleSum.mem at R, functionModule(R, I, M), V, w with ring, fm, finite, valuesF
  rw carrier at sumIn
  have evalValues : ∀ u ∈ functionSpace(I, Module.carrier(M)), u(i) ∈ Module.carrier(M)
    intros u hu
    exact functionSpace.apply_mem with hu, index
  have e1 := evaluationMap.graph_apply at I, M, i, moduleSum(functionModule(R, I, M), V, w) with evalValues, sumIn
  rw e1 at mapped
  have evalF := evaluationMap.graph_function at I, M, i with evalValues
  have composite := compose.function at evaluationMap(I, M, i), w, V, functionSpace(I, Module.carrier(M)), Module.carrier(M) with values, evalF
  have entryValues : ∀ k ∈ V, w(k)(i) ∈ Module.carrier(M)
    intros k hk
    have wk := FunctionBetween.apply_closed with values, hk
    exact functionSpace.apply_mem with wk, index
  have evaluated := familyEvaluate.function at V, Module.carrier(M), w, i with entryValues
  have same : compose(evaluationMap(I, M, i), w, V, Module.carrier(functionModule(R, I, M)), Module.carrier(M)) = familyEvaluate(V, Module.carrier(M), w, i)
    rw carrier
    apply FunctionBetween.ext with composite, evaluated
    intros k hk
    have wk := FunctionBetween.apply_closed with values, hk
    have c1 := compose.apply at evaluationMap(I, M, i), w, V, functionSpace(I, Module.carrier(M)), Module.carrier(M), k with values, evalF, hk
    have c2 := evaluationMap.graph_apply at I, M, i, w(k) with evalValues, wk
    have c3 := familyEvaluate.apply at V, Module.carrier(M), w, i, k with entryValues, hk
    rw [c1, c2, c3]
  rw same at mapped
  exact mapped

theorem coordinateModule.module (I : Set)
  shows Module(coordinateModule(R, I), R)
proof
  have self := Ring.to_module at R with ring
  unfold coordinateModule
  exact functionModule.module at R, I, selfModule(R) with *

-- LinearMap.funLeft is linear.
theorem precompose.at (I J M g u j : Set)
  requires map : g : J → I
  requires vector : u ∈ functionSpace(I, M.carrier)
  requires index : j ∈ J
  shows precompose(I, J, M, g)(u)(j) = u(g(j))
proof
  have values : ∀ x0 ∈ functionSpace(I, M.carrier), compose(x0, g, J, I, M.carrier) ∈ functionSpace(J, M.carrier)
    intros x0 hx0
    have gIn := functionSpace.mem_iff.backward with map
    exact functionSpace.compose at g, x0, J, I, M.carrier with gIn, hx0
  have e1 := precompose.graph_apply at I, J, M, g, u with values, vector
  have uF := functionSpace.mem_iff.forward with vector
  have e2 := compose.apply at u, g, J, I, M.carrier, j with map, uF, index
  rw [e1, e2]

theorem precompose.linear (I J M g : Set)
  requires module : Module(M, R)
  requires map : g : J → I
  shows LinearMap(precompose(I, J, M, g), functionModule(R, I, M), R,
    functionModule(R, J, M))
proof
  have values : ∀ u ∈ functionSpace(I, M.carrier), compose(u, g, J, I, M.carrier) ∈ functionSpace(J, M.carrier)
    intros u hu
    have gIn := functionSpace.mem_iff.backward with map
    exact functionSpace.compose at g, u, J, I, M.carrier with gIn, hu
  have function := precompose.graph_function at I, J, M, g with values
  have fmI := functionModule.module at R, I, M with *
  have fmJ := functionModule.module at R, J, M with *
  have carrierI := functionModule.carrier_eq at R, I, M
  have carrierJ := functionModule.carrier_eq at R, J, M
  apply LinearMap.of_laws with fmI, fmJ
  . rw [carrierI, carrierJ]
    exact function
  . rw carrierI
    intros u hu v hv
    have sumIn := functionModule.add_mem_of at R, I, M, u, v with *
    have pu := FunctionBetween.apply_closed with function, hu
    have pv := FunctionBetween.apply_closed with function, hv
    have sumJ := functionModule.add_mem_of at R, J, M, precompose(I, J, M, g)(u), precompose(I, J, M, g)(v) with *
    have left := FunctionBetween.apply_closed with function, sumIn
    apply functionSpace.ext_of with left, sumJ
    intros j hj
    have gj := FunctionBetween.apply_closed with map, hj
    have a1 := precompose.at at R, I, J, M, g, call2(Module.add(functionModule(R, I, M)), u, v), j with map, sumIn, hj
    have a2 := functionModule.add_apply at R, I, M, u, v, g(j) with *
    have a3 := functionModule.add_apply at R, J, M, precompose(I, J, M, g)(u), precompose(I, J, M, g)(v), j with *
    have a4 := precompose.at at R, I, J, M, g, u, j with map, hu, hj
    have a5 := precompose.at at R, I, J, M, g, v, j with map, hv, hj
    rw [a1, a2, a3, a4, a5]
  . rw carrierI
    intros r hr u hu
    have smulIn := functionModule.smul_mem_of at R, I, M, r, u with *
    have pu := FunctionBetween.apply_closed with function, hu
    have smulJ := functionModule.smul_mem_of at R, J, M, r, precompose(I, J, M, g)(u) with *
    have left := FunctionBetween.apply_closed with function, smulIn
    apply functionSpace.ext_of with left, smulJ
    intros j hj
    have gj := FunctionBetween.apply_closed with map, hj
    have a1 := precompose.at at R, I, J, M, g, call2(Module.smul(functionModule(R, I, M)), r, u), j with map, smulIn, hj
    have a2 := functionModule.smul_apply at R, I, M, r, u, g(j) with *
    have a3 := functionModule.smul_apply at R, J, M, r, precompose(I, J, M, g)(u), j with *
    have a4 := precompose.at at R, I, J, M, g, u, j with map, hu, hj
    rw [a1, a2, a3, a4]

theorem precompose.apply (I J M g u j : Set)
  requires map : g : J → I
  requires vector : u ∈ functionSpace(I, M.carrier)
  requires index : j ∈ J
  shows precompose(I, J, M, g)(u)(j) = u(g(j))
proof
  exact precompose.at at R, I, J, M, g, u, j with *

-- LinearMap.funLeft_injective_of_surjective and
-- LinearMap.funLeft_surjective_of_injective.
theorem precompose.injective_of_surjective (I J M g : Set)
  requires module : Module(M, R)
  requires surjective : SurjectiveBetween(g, J, I)
  shows InjectiveBetween(precompose(I, J, M, g), functionSpace(I, M.carrier),
    functionSpace(J, M.carrier))
proof
  have gF := Surjective.function with surjective
  have values : ∀ u ∈ functionSpace(I, M.carrier), compose(u, g, J, I, M.carrier) ∈ functionSpace(J, M.carrier)
    intros u hu
    have gIn := functionSpace.mem_iff.backward with gF
    exact functionSpace.compose at g, u, J, I, M.carrier with gIn, hu
  have function := precompose.graph_function at I, J, M, g with values
  apply Injective.of_pointwise with function
  intros u hu v hv same
  apply functionSpace.ext_of with hu, hv
  intros i hi
  obtain ⟨j, hj, gj⟩ := Surjective.apply_exists with surjective, hi
  have a1 := precompose.apply at R, I, J, M, g, u, j with gF, hu, hj
  have a2 := precompose.apply at R, I, J, M, g, v, j with gF, hv, hj
  rw same at a1
  rw [← gj, ← a1, a2]

theorem precompose.surjective_of_injective (I J M g : Set)
  requires module : Module(M, R)
  requires nonempty : M.carrier ≠ ∅
  requires injective : InjectiveBetween(g, J, I)
  shows SurjectiveBetween(precompose(I, J, M, g), functionSpace(I, M.carrier),
    functionSpace(J, M.carrier))
proof
  have gF := Injective.function with injective
  have gIn := functionSpace.mem_iff.backward with gF
  have values : ∀ u ∈ functionSpace(I, M.carrier), compose(u, g, J, I, M.carrier) ∈ functionSpace(J, M.carrier)
    intros u hu
    exact functionSpace.compose at g, u, J, I, M.carrier with gIn, hu
  have function := precompose.graph_function at I, J, M, g with values
  apply Surjective.of_pointwise with function
  intros v hv
  have extended := extendAlong.function_of at R, I, J, M, g, v with *
  have extendedIn := functionSpace.mem_iff.backward with extended
  refine ⟨extendAlong(I, J, M, g, v), extendedIn, ?_⟩
  have image := FunctionBetween.apply_closed with function, extendedIn
  apply functionSpace.ext_of with image, hv
  intros j hj
  have a1 := precompose.at at R, I, J, M, g, extendAlong(I, J, M, g, v), j with gF, extendedIn, hj
  have a2 := extendAlong.at_image at R, I, J, M, g, v, j with *
  rw [a1, a2]

theorem precompose.compose (I J K M g h : Set)
  requires first : g : J → I
  requires second : h : K → J
  shows compose(precompose(J, K, M, h), precompose(I, J, M, g),
      functionSpace(I, M.carrier), functionSpace(J, M.carrier),
      functionSpace(K, M.carrier)) =
    precompose(I, K, M, compose(g, h, K, J, I))
proof
  have gIn := functionSpace.mem_iff.backward with first
  have hIn := functionSpace.mem_iff.backward with second
  have valuesG : ∀ u ∈ functionSpace(I, M.carrier), compose(u, g, J, I, M.carrier) ∈ functionSpace(J, M.carrier)
    intros u hu
    exact functionSpace.compose at g, u, J, I, M.carrier with gIn, hu
  have valuesH : ∀ u ∈ functionSpace(J, M.carrier), compose(u, h, K, J, M.carrier) ∈ functionSpace(K, M.carrier)
    intros u hu
    exact functionSpace.compose at h, u, K, J, M.carrier with hIn, hu
  have gh := compose.function at g, h, K, J, I with second, first
  have ghIn := functionSpace.mem_iff.backward with gh
  have valuesGH : ∀ u ∈ functionSpace(I, M.carrier), compose(u, compose(g, h, K, J, I), K, I, M.carrier) ∈ functionSpace(K, M.carrier)
    intros u hu
    exact functionSpace.compose at compose(g, h, K, J, I), u, K, I, M.carrier with ghIn, hu
  have fG := precompose.graph_function at I, J, M, g with valuesG
  have fH := precompose.graph_function at J, K, M, h with valuesH
  have fGH := precompose.graph_function at I, K, M, compose(g, h, K, J, I) with valuesGH
  have both := compose.function at precompose(J, K, M, h), precompose(I, J, M, g), functionSpace(I, M.carrier), functionSpace(J, M.carrier), functionSpace(K, M.carrier) with fG, fH
  apply FunctionBetween.ext with both, fGH
  intros u hu
  have pu := FunctionBetween.apply_closed with fG, hu
  have left := FunctionBetween.apply_closed with both, hu
  have right := FunctionBetween.apply_closed with fGH, hu
  have c1 := compose.apply at precompose(J, K, M, h), precompose(I, J, M, g), functionSpace(I, M.carrier), functionSpace(J, M.carrier), functionSpace(K, M.carrier), u with fG, fH, hu
  rw c1
  rw c1 at left
  apply functionSpace.ext_of with left, right
  intros k hk
  have hk2 := FunctionBetween.apply_closed with second, hk
  have uF := functionSpace.mem_iff.forward with hu
  have a1 := precompose.apply at R, J, K, M, h, precompose(I, J, M, g)(u), k with second, pu, hk
  have a2 := precompose.apply at R, I, J, M, g, u, h(k) with first, hu, hk2
  have a3 := precompose.apply at R, I, K, M, compose(g, h, K, J, I), u, k with gh, hu, hk
  have a4 := compose.apply at g, h, K, J, I, k with second, first, hk
  rw [a1, a2, a3, a4]

-- LinearMap.proj.
theorem evaluationMap.linear (I M i : Set)
  requires module : Module(M, R)
  requires index : i ∈ I
  shows LinearMap(evaluationMap(I, M, i), functionModule(R, I, M), R, M)
proof
  exact evaluationMap.linear_of at R, I, M, i with *

-- LinearMap.pi: linear maps into a function module are the families of
-- linear maps into its coordinates.
theorem functionModule.linear_iff (I M N f : Set)
  requires moduleM : Module(M, R)
  requires moduleN : Module(N, R)
  requires map : f : N.carrier → functionSpace(I, M.carrier)
  shows LinearMap(f, N, R, functionModule(R, I, M)) ↔
    (∀ i ∈ I, LinearMap(compose(evaluationMap(I, M, i), f, N.carrier,
      functionSpace(I, M.carrier), M.carrier), N, R, M))
proof
  have fm := functionModule.module at R, I, M with *
  have carrier := functionModule.carrier_eq at R, I, M
  constructor
  . intro lf
    intros i hi
    have ev := evaluationMap.linear_of at R, I, M, i with *
    have composite := LinearMap.compose_of with lf, ev
    rw carrier at composite
    exact composite
  . intro all
    have mapF : f : N.carrier → Module.carrier(functionModule(R, I, M))
      rw carrier
      exact map
    apply LinearMap.of_laws with moduleN, fm, mapF
    . intros v hv w hw
      have vw := Module.add_mem at R, N, v, w with *
      have fv := FunctionBetween.apply_closed with map, hv
      have fw := FunctionBetween.apply_closed with map, hw
      have fvw := FunctionBetween.apply_closed with map, vw
      have sumIn := functionModule.add_mem_of at R, I, M, f(v), f(w) with *
      apply functionSpace.ext_of with fvw, sumIn
      intros i hi
      have lin := all with i, hi
      have evalValues : ∀ u ∈ functionSpace(I, M.carrier), u(i) ∈ M.carrier
        intros u hu
        exact functionSpace.apply_mem with hu, hi
      have evalF := evaluationMap.graph_function at I, M, i with evalValues
      have law := LinearMap.add_law at compose(evaluationMap(I, M, i), f, N.carrier, functionSpace(I, M.carrier), M.carrier), N, R, M, v, w with lin, hv, hw
      have c1 := compose.apply at evaluationMap(I, M, i), f, N.carrier, functionSpace(I, M.carrier), M.carrier, call2(N.add, v, w) with map, evalF, vw
      have c2 := compose.apply at evaluationMap(I, M, i), f, N.carrier, functionSpace(I, M.carrier), M.carrier, v with map, evalF, hv
      have c3 := compose.apply at evaluationMap(I, M, i), f, N.carrier, functionSpace(I, M.carrier), M.carrier, w with map, evalF, hw
      have g1 := evaluationMap.graph_apply at I, M, i, f(call2(N.add, v, w)) with evalValues, fvw
      have g2 := evaluationMap.graph_apply at I, M, i, f(v) with evalValues, fv
      have g3 := evaluationMap.graph_apply at I, M, i, f(w) with evalValues, fw
      have apply := functionModule.add_apply at R, I, M, f(v), f(w), i with *
      rw [c1, c2, c3, g1, g2, g3] at law
      rw [apply, law]
    . intros r hr v hv
      have rv := Module.smul_mem at R, N, r, v with *
      have fv := FunctionBetween.apply_closed with map, hv
      have frv := FunctionBetween.apply_closed with map, rv
      have smulIn := functionModule.smul_mem_of at R, I, M, r, f(v) with *
      apply functionSpace.ext_of with frv, smulIn
      intros i hi
      have lin := all with i, hi
      have evalValues : ∀ u ∈ functionSpace(I, M.carrier), u(i) ∈ M.carrier
        intros u hu
        exact functionSpace.apply_mem with hu, hi
      have evalF := evaluationMap.graph_function at I, M, i with evalValues
      have law := LinearMap.smul_law at compose(evaluationMap(I, M, i), f, N.carrier, functionSpace(I, M.carrier), M.carrier), N, R, M, r, v with lin, hr, hv
      have c1 := compose.apply at evaluationMap(I, M, i), f, N.carrier, functionSpace(I, M.carrier), M.carrier, call2(N.smul, r, v) with map, evalF, rv
      have c2 := compose.apply at evaluationMap(I, M, i), f, N.carrier, functionSpace(I, M.carrier), M.carrier, v with map, evalF, hv
      have g1 := evaluationMap.graph_apply at I, M, i, f(call2(N.smul, r, v)) with evalValues, frv
      have g2 := evaluationMap.graph_apply at I, M, i, f(v) with evalValues, fv
      have apply := functionModule.smul_apply at R, I, M, r, f(v), i with *
      rw [c1, c2, g1, g2] at law
      rw [apply, law]

end Constructions

section HomModule
variable (R M N : Set)
hypothesis ring : CommRing(R)
hypothesis moduleM : Module(M, R)
hypothesis moduleN : Module(N, R)

theorem homModule.module
  shows Module(homModule(M, R, N), R)
proof
  have ringR := CommRing.to_ring with ring
  have addF := linearMapAdd.function at M, R, N with ring, moduleM, moduleN
  have negF := linearMapNeg.function at M, R, N with ring, moduleM, moduleN
  have smulF := linearMapSmul.function at M, R, N with ring, moduleM, moduleN
  have zeroM := Module.zero_mem at R, N with *
  have zeroS := functionSpace.constant at Module.carrier(M), N.carrier, N.zero with zeroM
  have zeroIn := linearMaps.zero_mem at M, R, N with moduleM, moduleN
  unfold homModule
  apply Module.of_laws with ringR, addF, zeroIn, negF, smulF
  . intros u hu v hv w hw
    have uS := linearMaps.space at u, M, R, N with hu
    have vS := linearMaps.space at v, M, R, N with hv
    have wS := linearMaps.space at w, M, R, N with hw
    have uvL := linearMaps.add_closed at u, v, M, R, N with hu, hv
    have vwL := linearMaps.add_closed at v, w, M, R, N with hv, hw
    have uv := pointwiseSum.space at R, Module.carrier(M), N, u, v with *
    have vw := pointwiseSum.space at R, Module.carrier(M), N, v, w with *
    have e1 := linearMapAdd.pair_value at M, R, N, u, v with *
    have e2 := linearMapAdd.pair_value at M, R, N, pointwiseSum(Module.carrier(M), N, u, v), w with *
    have e3 := linearMapAdd.pair_value at M, R, N, v, w with *
    have e4 := linearMapAdd.pair_value at M, R, N, u, pointwiseSum(Module.carrier(M), N, v, w) with *
    have left := pointwiseSum.space at R, Module.carrier(M), N, pointwiseSum(Module.carrier(M), N, u, v), w with *
    have right := pointwiseSum.space at R, Module.carrier(M), N, u, pointwiseSum(Module.carrier(M), N, v, w) with *
    rw [e1, e2, e3, e4]
    apply functionSpace.ext_of with left, right
    intros i hi
    have ui := functionSpace.apply_mem with uS, hi
    have vi := functionSpace.apply_mem with vS, hi
    have wi := functionSpace.apply_mem with wS, hi
    have a1 := pointwiseSum.at at R, Module.carrier(M), N, pointwiseSum(Module.carrier(M), N, u, v), w, i with *
    have a2 := pointwiseSum.at at R, Module.carrier(M), N, u, v, i with *
    have a3 := pointwiseSum.at at R, Module.carrier(M), N, u, pointwiseSum(Module.carrier(M), N, v, w), i with *
    have a4 := pointwiseSum.at at R, Module.carrier(M), N, v, w, i with *
    have law := Module.add_assoc at R, N, u(i), v(i), w(i) with *
    rw [a1, a2, a3, a4, law]
  . intros u hu v hv
    have uS := linearMaps.space at u, M, R, N with hu
    have vS := linearMaps.space at v, M, R, N with hv
    have uvL := linearMaps.add_closed at u, v, M, R, N with hu, hv
    have e1 := linearMapAdd.pair_value at M, R, N, u, v with *
    have e2 := linearMapAdd.pair_value at M, R, N, v, u with *
    have left := pointwiseSum.space at R, Module.carrier(M), N, u, v with *
    have right := pointwiseSum.space at R, Module.carrier(M), N, v, u with *
    rw [e1, e2]
    apply functionSpace.ext_of with left, right
    intros i hi
    have ui := functionSpace.apply_mem with uS, hi
    have vi := functionSpace.apply_mem with vS, hi
    have a1 := pointwiseSum.at at R, Module.carrier(M), N, u, v, i with *
    have a2 := pointwiseSum.at at R, Module.carrier(M), N, v, u, i with *
    have law := Module.add_comm at R, N, u(i), v(i) with *
    rw [a1, a2, law]
  . intros u hu
    have uS := linearMaps.space at u, M, R, N with hu
    have nuL := linearMaps.neg_closed at u, M, R, N with hu
    have e1 := linearMapAdd.pair_value at M, R, N, constantFunction(Module.carrier(M), N.carrier, N.zero), u with *
    have left := pointwiseSum.space at R, Module.carrier(M), N, constantFunction(Module.carrier(M), N.carrier, N.zero), u with *
    rw e1
    apply functionSpace.ext_of with left, uS
    intros i hi
    have ui := functionSpace.apply_mem with uS, hi
    have a1 := pointwiseSum.at at R, Module.carrier(M), N, constantFunction(Module.carrier(M), N.carrier, N.zero), u, i with *
    have c := constantFunction.apply at Module.carrier(M), N.carrier, i, N.zero with hi, zeroM
    have law := Module.zero_add at R, N, u(i) with *
    rw [a1, c, law]
  . intros u hu
    have uS := linearMaps.space at u, M, R, N with hu
    have nuL := linearMaps.neg_closed at u, M, R, N with hu
    have n1 := linearMapNeg.value at M, R, N, u with ring, moduleM, moduleN, hu
    have nu := pointwiseNeg.space at R, Module.carrier(M), N, u with *
    have e1 := linearMapAdd.pair_value at M, R, N, pointwiseNeg(Module.carrier(M), N, u), u with *
    have left := pointwiseSum.space at R, Module.carrier(M), N, pointwiseNeg(Module.carrier(M), N, u), u with *
    rw [n1, e1]
    apply functionSpace.ext_of with left, zeroS
    intros i hi
    have ui := functionSpace.apply_mem with uS, hi
    have a1 := pointwiseSum.at at R, Module.carrier(M), N, pointwiseNeg(Module.carrier(M), N, u), u, i with *
    have a2 := pointwiseNeg.at at R, Module.carrier(M), N, u, i with *
    have c := constantFunction.apply at Module.carrier(M), N.carrier, i, N.zero with hi, zeroM
    have law := Module.neg_add at R, N, u(i) with *
    rw [a1, a2, c, law]
  . intros r hr u hu v hv
    have uS := linearMaps.space at u, M, R, N with hu
    have vS := linearMaps.space at v, M, R, N with hv
    have uvL := linearMaps.add_closed at u, v, M, R, N with hu, hv
    have ruL := linearMaps.smul_closed at u, M, R, N, r with ring, hu, hr
    have rvL := linearMaps.smul_closed at v, M, R, N, r with ring, hv, hr
    have uv := pointwiseSum.space at R, Module.carrier(M), N, u, v with *
    have ru := pointwiseSmul.space at R, Module.carrier(M), N, r, u with *
    have rv := pointwiseSmul.space at R, Module.carrier(M), N, r, v with *
    have e1 := linearMapAdd.pair_value at M, R, N, u, v with *
    have e2 := linearMapSmul.pair_value at M, R, N, r, pointwiseSum(Module.carrier(M), N, u, v) with *
    have e3 := linearMapSmul.pair_value at M, R, N, r, u with *
    have e4 := linearMapSmul.pair_value at M, R, N, r, v with *
    have e5 := linearMapAdd.pair_value at M, R, N, pointwiseSmul(Module.carrier(M), N, r, u), pointwiseSmul(Module.carrier(M), N, r, v) with *
    have left := pointwiseSmul.space at R, Module.carrier(M), N, r, pointwiseSum(Module.carrier(M), N, u, v) with *
    have right := pointwiseSum.space at R, Module.carrier(M), N, pointwiseSmul(Module.carrier(M), N, r, u), pointwiseSmul(Module.carrier(M), N, r, v) with *
    rw [e1, e2, e3, e4, e5]
    apply functionSpace.ext_of with left, right
    intros i hi
    have ui := functionSpace.apply_mem with uS, hi
    have vi := functionSpace.apply_mem with vS, hi
    have a1 := pointwiseSmul.at at R, Module.carrier(M), N, r, pointwiseSum(Module.carrier(M), N, u, v), i with *
    have a2 := pointwiseSum.at at R, Module.carrier(M), N, u, v, i with *
    have a3 := pointwiseSum.at at R, Module.carrier(M), N, pointwiseSmul(Module.carrier(M), N, r, u), pointwiseSmul(Module.carrier(M), N, r, v), i with *
    have a4 := pointwiseSmul.at at R, Module.carrier(M), N, r, u, i with *
    have a5 := pointwiseSmul.at at R, Module.carrier(M), N, r, v, i with *
    have law := smul_add at R, N, r, u(i), v(i) with *
    rw [a1, a2, a3, a4, a5, law]
  . intros r hr s hs u hu
    have uS := linearMaps.space at u, M, R, N with hu
    have ruL := linearMaps.smul_closed at u, M, R, N, r with ring, hu, hr
    have suL := linearMaps.smul_closed at u, M, R, N, s with ring, hu, hs
    have rs := Ring.add_mem at R, r, s with *
    have ru := pointwiseSmul.space at R, Module.carrier(M), N, r, u with *
    have su := pointwiseSmul.space at R, Module.carrier(M), N, s, u with *
    have e1 := linearMapSmul.pair_value at M, R, N, call2(R.add, r, s), u with *
    have e2 := linearMapSmul.pair_value at M, R, N, r, u with *
    have e3 := linearMapSmul.pair_value at M, R, N, s, u with *
    have e4 := linearMapAdd.pair_value at M, R, N, pointwiseSmul(Module.carrier(M), N, r, u), pointwiseSmul(Module.carrier(M), N, s, u) with *
    have left := pointwiseSmul.space at R, Module.carrier(M), N, call2(R.add, r, s), u with *
    have right := pointwiseSum.space at R, Module.carrier(M), N, pointwiseSmul(Module.carrier(M), N, r, u), pointwiseSmul(Module.carrier(M), N, s, u) with *
    rw [e1, e2, e3, e4]
    apply functionSpace.ext_of with left, right
    intros i hi
    have ui := functionSpace.apply_mem with uS, hi
    have a1 := pointwiseSmul.at at R, Module.carrier(M), N, call2(R.add, r, s), u, i with *
    have a2 := pointwiseSum.at at R, Module.carrier(M), N, pointwiseSmul(Module.carrier(M), N, r, u), pointwiseSmul(Module.carrier(M), N, s, u), i with *
    have a3 := pointwiseSmul.at at R, Module.carrier(M), N, r, u, i with *
    have a4 := pointwiseSmul.at at R, Module.carrier(M), N, s, u, i with *
    have law := add_smul at R, N, r, s, u(i) with *
    rw [a1, a2, a3, a4, law]
  . intros r hr s hs u hu
    have uS := linearMaps.space at u, M, R, N with hu
    have ruL := linearMaps.smul_closed at u, M, R, N, r with ring, hu, hr
    have suL := linearMaps.smul_closed at u, M, R, N, s with ring, hu, hs
    have rs := Ring.mul_mem at R, r, s with *
    have su := pointwiseSmul.space at R, Module.carrier(M), N, s, u with *
    have e1 := linearMapSmul.pair_value at M, R, N, call2(R.mul, r, s), u with *
    have e2 := linearMapSmul.pair_value at M, R, N, s, u with *
    have e3 := linearMapSmul.pair_value at M, R, N, r, pointwiseSmul(Module.carrier(M), N, s, u) with *
    have left := pointwiseSmul.space at R, Module.carrier(M), N, call2(R.mul, r, s), u with *
    have right := pointwiseSmul.space at R, Module.carrier(M), N, r, pointwiseSmul(Module.carrier(M), N, s, u) with *
    rw [e1, e2, e3]
    apply functionSpace.ext_of with left, right
    intros i hi
    have ui := functionSpace.apply_mem with uS, hi
    have a1 := pointwiseSmul.at at R, Module.carrier(M), N, call2(R.mul, r, s), u, i with *
    have a2 := pointwiseSmul.at at R, Module.carrier(M), N, r, pointwiseSmul(Module.carrier(M), N, s, u), i with *
    have a3 := pointwiseSmul.at at R, Module.carrier(M), N, s, u, i with *
    have law := mul_smul at R, N, r, s, u(i) with *
    rw [a1, a2, a3, law]
  . intros u hu
    have uS := linearMaps.space at u, M, R, N with hu
    have nuL := linearMaps.neg_closed at u, M, R, N with hu
    have oneIn := Ring.one_mem at R with ringR
    have e1 := linearMapSmul.pair_value at M, R, N, R.one, u with *
    have left := pointwiseSmul.space at R, Module.carrier(M), N, R.one, u with *
    rw e1
    apply functionSpace.ext_of with left, uS
    intros i hi
    have ui := functionSpace.apply_mem with uS, hi
    have a1 := pointwiseSmul.at at R, Module.carrier(M), N, R.one, u, i with *
    have law := one_smul at R, N, u(i) with *
    rw [a1, law]

-- LinearMap.add_apply and LinearMap.sum_apply.
theorem homModule.add_apply (f g v : Set)
  requires first : LinearMap(f, M, R, N)
  requires second : LinearMap(g, M, R, N)
  requires vector : v ∈ M.carrier
  shows call2(Module.add(homModule(M, R, N)), f, g)(v) =
    call2(N.add, f(v), g(v))
proof
  have addEq := homModule.add_eq at M, R, N
  have hf := linearMaps.of_linear with first
  have hg := linearMaps.of_linear with second
  have fS := linearMaps.space at f, M, R, N with hf
  have gS := linearMaps.space at g, M, R, N with hg
  have ringR := CommRing.to_ring with ring
  have e1 := linearMapAdd.pair_value at M, R, N, f, g with ring, moduleM, moduleN, hf, hg
  rw [addEq, e1]
  exact pointwiseSum.at at R, Module.carrier(M), N, f, g, v with moduleN, fS, gS, vector

theorem homModule.smul_apply (r f v : Set)
  requires scalar : r ∈ R.carrier
  requires linear : LinearMap(f, M, R, N)
  requires vector : v ∈ M.carrier
  shows call2(Module.smul(homModule(M, R, N)), r, f)(v) =
    call2(N.smul, r, f(v))
proof
  have smulEq := homModule.smul_eq at M, R, N
  have hf := linearMaps.of_linear with linear
  have fS := linearMaps.space at f, M, R, N with hf
  have ringR := CommRing.to_ring with ring
  have e1 := linearMapSmul.pair_value at M, R, N, r, f with ring, moduleM, moduleN, scalar, hf
  rw [smulEq, e1]
  exact pointwiseSmul.at at R, Module.carrier(M), N, r, f, v with moduleN, scalar, fS, vector

theorem homModule.sum_apply (V w v : Set)
  requires finite : Finite(V)
  requires values : w : V → linearMaps(M, R, N)
  requires vector : v ∈ M.carrier
  shows moduleSum(homModule(M, R, N), V, w)(v) = moduleSum(N, V,
    familyEvaluate(V, N.carrier, w, v))
proof
  have ringR := CommRing.to_ring with ring
  have hm := homModule.module at R, M, N with *
  have carrier := homModule.carrier_eq at M, R, N
  have evalValues : ∀ u ∈ functionSpace(Module.carrier(M), Module.carrier(N)), u(v) ∈ Module.carrier(N)
    intros u hu
    exact functionSpace.apply_mem with hu, vector
  have evalF := evaluationMap.graph_function at Module.carrier(M), N, v with evalValues
  have sub : linearMaps(M, R, N) ⊆ functionSpace(Module.carrier(M), Module.carrier(N))
    intros f hf
    exact linearMaps.space at f, M, R, N with hf
  have EF := restrict.domain_function at evaluationMap(Module.carrier(M), N, v), functionSpace(Module.carrier(M), Module.carrier(N)), Module.carrier(N), linearMaps(M, R, N) with evalF, sub
  have Eapply : ∀ f ∈ linearMaps(M, R, N), restrict(evaluationMap(Module.carrier(M), N, v), linearMaps(M, R, N))(f) = f(v)
    intros f hf
    have fS := sub with f, hf
    have r1 := restrict.domain_apply at evaluationMap(Module.carrier(M), N, v), functionSpace(Module.carrier(M), Module.carrier(N)), Module.carrier(N), linearMaps(M, R, N), f with evalF, sub, hf
    have r2 := evaluationMap.graph_apply at Module.carrier(M), N, v, f with evalValues, fS
    rw [r1, r2]
  have linear : LinearMap(restrict(evaluationMap(Module.carrier(M), N, v), linearMaps(M, R, N)), homModule(M, R, N), R, N)
    apply LinearMap.of_laws with hm, moduleN
    . rw carrier
      exact EF
    . rw carrier
      intros f hf g hg
      have lf := linearMaps.linear with hf
      have lg := linearMaps.linear with hg
      have fC : f ∈ Module.carrier(homModule(M, R, N))
        rw carrier
        exact hf
      have gC : g ∈ Module.carrier(homModule(M, R, N))
        rw carrier
        exact hg
      have sumC := Module.add_mem at R, homModule(M, R, N), f, g with ringR, hm, fC, gC
      rw carrier at sumC
      have a1 := Eapply with call2(Module.add(homModule(M, R, N)), f, g), sumC
      have a2 := Eapply with f, hf
      have a3 := Eapply with g, hg
      have law := homModule.add_apply at R, M, N, f, g, v with ring, moduleM, moduleN, lf, lg, vector
      rw [a1, a2, a3, law]
    . rw carrier
      intros r hr f hf
      have lf := linearMaps.linear with hf
      have fC : f ∈ Module.carrier(homModule(M, R, N))
        rw carrier
        exact hf
      have smulC := Module.smul_mem at R, homModule(M, R, N), r, f with ringR, hm, hr, fC
      rw carrier at smulC
      have a1 := Eapply with call2(Module.smul(homModule(M, R, N)), r, f), smulC
      have a2 := Eapply with f, hf
      have law := homModule.smul_apply at R, M, N, r, f, v with ring, moduleM, moduleN, hr, lf, vector
      rw [a1, a2, law]
  have valuesH : w : V → Module.carrier(homModule(M, R, N))
    rw carrier
    exact values
  have mapped := LinearMap.map_sum at R, homModule(M, R, N), N, restrict(evaluationMap(Module.carrier(M), N, v), linearMaps(M, R, N)), V, w with ringR, hm, moduleN, linear, finite, valuesH
  have sumIn := moduleSum.mem at R, homModule(M, R, N), V, w with ringR, hm, finite, valuesH
  rw carrier at sumIn
  have e1 := Eapply with moduleSum(homModule(M, R, N), V, w), sumIn
  rw e1 at mapped
  have composite := compose.function at restrict(evaluationMap(Module.carrier(M), N, v), linearMaps(M, R, N)), w, V, linearMaps(M, R, N), Module.carrier(N) with values, EF
  have entryValues : ∀ k ∈ V, w(k)(v) ∈ Module.carrier(N)
    intros k hk
    have wk := FunctionBetween.apply_closed with values, hk
    have wS := sub with w(k), wk
    exact functionSpace.apply_mem with wS, vector
  have evaluated := familyEvaluate.function at V, Module.carrier(N), w, v with entryValues
  have same : compose(restrict(evaluationMap(Module.carrier(M), N, v), linearMaps(M, R, N)), w, V, Module.carrier(homModule(M, R, N)), Module.carrier(N)) = familyEvaluate(V, Module.carrier(N), w, v)
    rw carrier
    apply FunctionBetween.ext with composite, evaluated
    intros k hk
    have wk := FunctionBetween.apply_closed with values, hk
    have c1 := compose.apply at restrict(evaluationMap(Module.carrier(M), N, v), linearMaps(M, R, N)), w, V, linearMaps(M, R, N), Module.carrier(N), k with values, EF, hk
    have c2 := Eapply with w(k), wk
    have c3 := familyEvaluate.apply at V, Module.carrier(N), w, v, k with entryValues, hk
    rw [c1, c2, c3]
  rw same at mapped
  exact mapped

theorem endomorphismRing.ring
  shows Ring(endomorphismRing(M, R))
proof
  have ringR := CommRing.to_ring with ring
  have hm := homModule.module at R, M, M with ring, moduleM, moduleM
  have abelian := Module.additive.abelian_group with hm
  have parts := Module.additive_parts with abelian
  have carrier := homModule.carrier_eq at M, R, M
  have addEq := homModule.add_eq at M, R, M
  have zeroEq : Module.zero(homModule(M, R, M)) = constantFunction(Module.carrier(M), Module.carrier(M), Module.zero(M))
    unfold homModule
    module_projections
  have negEq : Module.neg(homModule(M, R, M)) = linearMapNeg(M, R, M)
    unfold homModule
    module_projections
  rw [carrier, addEq, zeroEq, negEq] at parts
  have mulF := linearMapCompose.function at M, R with moduleM
  have idLinear := LinearMap.identity at M, R with moduleM
  have idIn := linearMaps.of_linear with idLinear
  have mulV : ∀ f g ∈ linearMaps(M, R, M), call2(linearMapCompose(M, R), f, g) = compose(f, g, Module.carrier(M), Module.carrier(M), Module.carrier(M))
    intros f hf g hg
    have pp := product.pair at f, g, linearMaps(M, R, M), linearMaps(M, R, M) with hf, hg
    have value := linearMapCompose.value at M, R, (f, g) with moduleM, pp
    have same : call2(linearMapCompose(M, R), f, g) = linearMapCompose(M, R)((f, g))
      unfold call2
      rfl
    rw [same, value, fst.pair, snd.pair]
  have addV : ∀ f g ∈ linearMaps(M, R, M), call2(linearMapAdd(M, R, M), f, g) = pointwiseSum(Module.carrier(M), M, f, g)
    intros f hf g hg
    exact linearMapAdd.pair_value at M, R, M, f, g with ring, moduleM, moduleM, hf, hg
  have isRing : IsRing(linearMaps(M, R, M), linearMapAdd(M, R, M), constantFunction(Module.carrier(M), Module.carrier(M), Module.zero(M)), linearMapNeg(M, R, M), linearMapCompose(M, R), identity(Module.carrier(M)))
    unfold IsRing
    refine ⟨parts, ?_, ?_⟩
    . unfold IsMonoid
      refine ⟨?_, ?_⟩
      . unfold IsSemigroup
        refine ⟨mulF, ?_⟩
        intros f hf g hg h hh
        have fF := LinearMap.function_of with (linearMaps.linear with hf)
        have gF := LinearMap.function_of with (linearMaps.linear with hg)
        have hF := LinearMap.function_of with (linearMaps.linear with hh)
        have fg := FunctionBetween.apply_closed with mulF, (product.pair at f, g, linearMaps(M, R, M), linearMaps(M, R, M) with hf, hg)
        have gh := FunctionBetween.apply_closed with mulF, (product.pair at g, h, linearMaps(M, R, M), linearMaps(M, R, M) with hg, hh)
        have fgIn : call2(linearMapCompose(M, R), f, g) ∈ linearMaps(M, R, M)
          unfold call2
          exact fg
        have ghIn : call2(linearMapCompose(M, R), g, h) ∈ linearMaps(M, R, M)
          unfold call2
          exact gh
        have e1 := mulV with f, hf, g, hg
        have e2 := mulV with call2(linearMapCompose(M, R), f, g), fgIn, h, hh
        have e3 := mulV with g, hg, h, hh
        have e4 := mulV with f, hf, call2(linearMapCompose(M, R), g, h), ghIn
        rw [e2, e4, e1, e3]
        have c1 := compose.function at f, g, Module.carrier(M), Module.carrier(M), Module.carrier(M) with gF, fF
        have c2 := compose.function at g, h, Module.carrier(M), Module.carrier(M), Module.carrier(M) with hF, gF
        have left := compose.function at compose(f, g, Module.carrier(M), Module.carrier(M), Module.carrier(M)), h, Module.carrier(M), Module.carrier(M), Module.carrier(M) with hF, c1
        have right := compose.function at f, compose(g, h, Module.carrier(M), Module.carrier(M), Module.carrier(M)), Module.carrier(M), Module.carrier(M), Module.carrier(M) with c2, fF
        apply FunctionBetween.ext with left, right
        intros v hv
        have hv2 := FunctionBetween.apply_closed with hF, hv
        have a1 := compose.apply at compose(f, g, Module.carrier(M), Module.carrier(M), Module.carrier(M)), h, Module.carrier(M), Module.carrier(M), Module.carrier(M), v with hF, c1, hv
        have a2 := compose.apply at f, g, Module.carrier(M), Module.carrier(M), Module.carrier(M), h(v) with gF, fF, hv2
        have a3 := compose.apply at f, compose(g, h, Module.carrier(M), Module.carrier(M), Module.carrier(M)), Module.carrier(M), Module.carrier(M), Module.carrier(M), v with c2, fF, hv
        have a4 := compose.apply at g, h, Module.carrier(M), Module.carrier(M), Module.carrier(M), v with hF, gF, hv
        rw [a1, a2, a3, a4]
      . unfold Identity
        refine ⟨idIn, ?_⟩
        intros f hf
        have fF := LinearMap.function_of with (linearMaps.linear with hf)
        have e1 := mulV with identity(Module.carrier(M)), idIn, f, hf
        have e2 := mulV with f, hf, identity(Module.carrier(M)), idIn
        have l := compose.identity_left at f, Module.carrier(M), Module.carrier(M) with fF
        have r := compose.identity_right at f, Module.carrier(M), Module.carrier(M) with fF
        rw [e1, e2, l, r]
        exact ⟨rfl, rfl⟩
    . intros f hf g hg h hh
      have lf := linearMaps.linear with hf
      have fF := LinearMap.function_of with lf
      have gF := LinearMap.function_of with (linearMaps.linear with hg)
      have hF := LinearMap.function_of with (linearMaps.linear with hh)
      have gS := linearMaps.space at g, M, R, M with hg
      have hS := linearMaps.space at h, M, R, M with hh
      have fS := linearMaps.space at f, M, R, M with hf
      have ghL := linearMaps.add_closed at g, h, M, R, M with hg, hh
      have fgL := linearMaps.add_closed at f, g, M, R, M with hf, hg
      have fgC := FunctionBetween.apply_closed with mulF, (product.pair at f, g, linearMaps(M, R, M), linearMaps(M, R, M) with hf, hg)
      have fhC := FunctionBetween.apply_closed with mulF, (product.pair at f, h, linearMaps(M, R, M), linearMaps(M, R, M) with hf, hh)
      have ghC := FunctionBetween.apply_closed with mulF, (product.pair at g, h, linearMaps(M, R, M), linearMaps(M, R, M) with hg, hh)
      have fgIn : call2(linearMapCompose(M, R), f, g) ∈ linearMaps(M, R, M)
        unfold call2
        exact fgC
      have fhIn : call2(linearMapCompose(M, R), f, h) ∈ linearMaps(M, R, M)
        unfold call2
        exact fhC
      have ghIn : call2(linearMapCompose(M, R), g, h) ∈ linearMaps(M, R, M)
        unfold call2
        exact ghC
      have m1 := mulV with f, hf, g, hg
      have m2 := mulV with f, hf, h, hh
      have m3 := mulV with g, hg, h, hh
      have s1 := addV with g, hg, h, hh
      have s2 := addV with f, hf, g, hg
      have fghC := mulV with f, hf, pointwiseSum(Module.carrier(M), M, g, h), ghL
      have fghR := mulV with pointwiseSum(Module.carrier(M), M, f, g), fgL, h, hh
      have ffS := functionSpace.mem_iff.backward with fF
      have ggS := functionSpace.mem_iff.backward with gF
      have hhS := functionSpace.mem_iff.backward with hF
      have cfg := functionSpace.compose at g, f, Module.carrier(M), Module.carrier(M), Module.carrier(M) with ggS, ffS
      have cfh := functionSpace.compose at h, f, Module.carrier(M), Module.carrier(M), Module.carrier(M) with hhS, ffS
      have cgh := functionSpace.compose at h, g, Module.carrier(M), Module.carrier(M), Module.carrier(M) with hhS, ggS
      have sgh := pointwiseSum.space at R, Module.carrier(M), M, g, h with moduleM, gS, hS
      have sfg := pointwiseSum.space at R, Module.carrier(M), M, f, g with moduleM, fS, gS
      have sghF := functionSpace.mem_iff.forward with sgh
      have sfgF := functionSpace.mem_iff.forward with sfg
      refine ⟨?_, ?_⟩
      . have t1 := addV with call2(linearMapCompose(M, R), f, g), fgIn, call2(linearMapCompose(M, R), f, h), fhIn
        rw [s1, fghC, t1, m1, m2]
        have left := functionSpace.compose at pointwiseSum(Module.carrier(M), M, g, h), f, Module.carrier(M), Module.carrier(M), Module.carrier(M) with sgh, ffS
        have right := pointwiseSum.space at R, Module.carrier(M), M, compose(f, g, Module.carrier(M), Module.carrier(M), Module.carrier(M)), compose(f, h, Module.carrier(M), Module.carrier(M), Module.carrier(M)) with moduleM, cfg, cfh
        apply functionSpace.ext_of with left, right
        intros v hv
        have gv := FunctionBetween.apply_closed with gF, hv
        have hv2 := FunctionBetween.apply_closed with hF, hv
        have svIn := FunctionBetween.apply_closed with sghF, hv
        have a1 := compose.apply at f, pointwiseSum(Module.carrier(M), M, g, h), Module.carrier(M), Module.carrier(M), Module.carrier(M), v with sghF, fF, hv
        have a2 := pointwiseSum.at at R, Module.carrier(M), M, g, h, v with moduleM, gS, hS, hv
        have a3 := pointwiseSum.at at R, Module.carrier(M), M, compose(f, g, Module.carrier(M), Module.carrier(M), Module.carrier(M)), compose(f, h, Module.carrier(M), Module.carrier(M), Module.carrier(M)), v with moduleM, cfg, cfh, hv
        have a4 := compose.apply at f, g, Module.carrier(M), Module.carrier(M), Module.carrier(M), v with gF, fF, hv
        have a5 := compose.apply at f, h, Module.carrier(M), Module.carrier(M), Module.carrier(M), v with hF, fF, hv
        have law := LinearMap.add_law at f, M, R, M, g(v), h(v) with lf, gv, hv2
        rw [a1, a2, a3, a4, a5, law]
      . have t1 := addV with call2(linearMapCompose(M, R), f, h), fhIn, call2(linearMapCompose(M, R), g, h), ghIn
        rw [s2, fghR, t1, m2, m3]
        have left := functionSpace.compose at h, pointwiseSum(Module.carrier(M), M, f, g), Module.carrier(M), Module.carrier(M), Module.carrier(M) with hhS, sfg
        have right := pointwiseSum.space at R, Module.carrier(M), M, compose(f, h, Module.carrier(M), Module.carrier(M), Module.carrier(M)), compose(g, h, Module.carrier(M), Module.carrier(M), Module.carrier(M)) with moduleM, cfh, cgh
        apply functionSpace.ext_of with left, right
        intros v hv
        have hv2 := FunctionBetween.apply_closed with hF, hv
        have a1 := compose.apply at pointwiseSum(Module.carrier(M), M, f, g), h, Module.carrier(M), Module.carrier(M), Module.carrier(M), v with hF, sfgF, hv
        have a2 := pointwiseSum.at at R, Module.carrier(M), M, f, g, h(v) with moduleM, fS, gS, hv2
        have a3 := pointwiseSum.at at R, Module.carrier(M), M, compose(f, h, Module.carrier(M), Module.carrier(M), Module.carrier(M)), compose(g, h, Module.carrier(M), Module.carrier(M), Module.carrier(M)), v with moduleM, cfh, cgh, hv
        have a4 := compose.apply at f, h, Module.carrier(M), Module.carrier(M), Module.carrier(M), v with hF, fF, hv
        have a5 := compose.apply at g, h, Module.carrier(M), Module.carrier(M), Module.carrier(M), v with hF, gF, hv
        rw [a1, a2, a3, a4, a5]
  unfold endomorphismRing
  exact Ring.of_parts with isRing

-- Module.End.mul_apply: the product of End(M) is composition.
theorem endomorphismRing.mul_apply (f g v : Set)
  requires first : LinearMap(f, M, R, M)
  requires second : LinearMap(g, M, R, M)
  requires vector : v ∈ M.carrier
  shows call2(Ring.mul(endomorphismRing(M, R)), f, g)(v) = f(g(v))
proof
  have hf := linearMaps.of_linear with first
  have hg := linearMaps.of_linear with second
  have same : call2(Ring.mul(endomorphismRing(M, R)), f, g) = linearMapCompose(M, R)((f, g))
    unfold endomorphismRing
    ring_projections
    unfold call2
    rfl
  have pp := product.pair at f, g, linearMaps(M, R, M), linearMaps(M, R, M) with hf, hg
  have value := linearMapCompose.value at M, R, (f, g) with moduleM, pp
  have fF := LinearMap.function_of with first
  have gF := LinearMap.function_of with second
  rw [same, value, fst.pair, snd.pair]
  exact compose.apply at f, g, Module.carrier(M), Module.carrier(M), Module.carrier(M), v with gF, fF, vector

end HomModule

theorem endomorphismRing.one (M R : Set)
  shows Ring.one(endomorphismRing(M, R)) = identity(Module.carrier(M))
proof
  unfold endomorphismRing
  ring_projections
