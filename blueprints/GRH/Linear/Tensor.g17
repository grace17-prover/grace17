theorem algebraTensorAction.parts
  shows LinearMap(algebraTensorAction(A, B), tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B)), Algebra.base(A), homModule(tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B)), Algebra.base(A), tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B)))) ∧
    (∀ a ∈ algebraCarrier(A), ∀ b ∈ algebraCarrier(B),
      algebraTensorAction(A, B)(tmul(algebraModule(A), Algebra.base(A), algebraModule(B), a, b)) = algebraTensorLeft(A, B, a, b))
proof
  obtain ⟨ringK, mA, mB, tp, hm⟩ := algebraTensor.setup at A, B with algebraA, algebraB, sameBase
  have bil := algebraTensorPairs.bilinear at A, B with algebraA, algebraB, sameBase
  obtain ⟨lin, val⟩ := tensorLift.parts at Algebra.base(A), algebraModule(A), algebraModule(B), homModule(tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B)), Algebra.base(A), tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B))), algebraTensorPairs(A, B) with ringK, mA, mB, bil
  unfold algebraTensorAction
  refine ⟨lin, ?_⟩
  intros a ha b hb
  have ha2 := algebraModule.mem at A, a with ha
  have hb2 := algebraModule.mem at B, b with hb
  have v := val with a, ha2, b, hb2
  have p := algebraTensorPairs.value at A, B, a, b with algebraA, algebraB, sameBase, ha, hb
  rw [v, p]

theorem algebraTensorAction.slice (s : Set)
  requires hs : s ∈ Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B)))
  shows LinearMap(algebraTensorAction(A, B)(s), tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B)), Algebra.base(A), tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B)))
proof
  obtain ⟨lin, _⟩ := algebraTensorAction.parts at A, B with algebraA, algebraB, sameBase
  have m := LinearMap.value_mem with lin, hs
  have ce := homModule.carrier_eq at tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B)), Algebra.base(A), tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B))
  rw ce at m
  exact linearMaps.linear with m

theorem algebraTensorProductGraph.value (s t : Set)
  requires hs : s ∈ Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B)))
  requires ht : t ∈ Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B)))
  shows algebraTensorProductGraph(A, B)((s, t)) = algebraTensorAction(A, B)(s)(t)
proof
  have values : ∀ s ∈ Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B))), ∀ t ∈ Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B))), algebraTensorAction(A, B)(s)(t) ∈ Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B)))
    intros u hu w hw
    have l := algebraTensorAction.slice at A, B, u with algebraA, algebraB, sameBase, hu
    exact LinearMap.value_mem with l, hw
  exact algebraTensorProductGraph.graph_entry at A, B, s, t with values, hs, ht

theorem algebraTensorProductGraph.bilinear
  shows BilinearMap(algebraTensorProductGraph(A, B), tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B)), tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B)), tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B)), Algebra.base(A))
