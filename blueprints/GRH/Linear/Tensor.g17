    rw [e1, e2, e3, a, b]
  . intros v hv x hx y hy
    have xy := Module.add_mem at Algebra.base(A), tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B)), x, y with ringR, tp, hx, hy
    have e1 := algebraTensorProductGraph.value at A, B, v, call2(Module.add(tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B))), x, y) with algebraA, algebraB, sameBase, hv, xy
    have e2 := algebraTensorProductGraph.value at A, B, v, x with algebraA, algebraB, sameBase, hv, hx
    have e3 := algebraTensorProductGraph.value at A, B, v, y with algebraA, algebraB, sameBase, hv, hy
    have lv := algebraTensorAction.slice at A, B, v with algebraA, algebraB, sameBase, hv
    have a := LinearMap.add_law with lv, hx, hy
    rw [e1, e2, e3, a]
  . intros r hr v hv x hx
    have rv := Module.smul_mem at Algebra.base(A), tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B)), r, v with ringR, tp, hr, hv
    have rx := Module.smul_mem at Algebra.base(A), tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B)), r, x with ringR, tp, hr, hx
    have e1 := algebraTensorProductGraph.value at A, B, call2(Module.smul(tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B))), r, v), x with algebraA, algebraB, sameBase, rv, hx
    have e2 := algebraTensorProductGraph.value at A, B, v, x with algebraA, algebraB, sameBase, hv, hx
    have e3 := algebraTensorProductGraph.value at A, B, v, call2(Module.smul(tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B))), r, x) with algebraA, algebraB, sameBase, hv, rx
    have a := LinearMap.smul_law with lin, hr, hv
    have lv := algebraTensorAction.slice at A, B, v with algebraA, algebraB, sameBase, hv
    have b := homModule.smul_apply at Algebra.base(A), tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B)), tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B)), r, algebraTensorAction(A, B)(v), x with ringK, tp, tp, hr, lv, hx
    have c := LinearMap.smul_law with lv, hr, hx
    rw [e1, e2, e3, a, b, c]
    exact ⟨rfl, rfl⟩

theorem algebraTensorProductGraph.pure (a a2 b b2 : Set)
  requires ha : a ∈ algebraCarrier(A)
  requires ha2 : a2 ∈ algebraCarrier(A)
  requires hb : b ∈ algebraCarrier(B)
  requires hb2 : b2 ∈ algebraCarrier(B)
  shows algebraTensorProductGraph(A, B)((tmul(algebraModule(A), Algebra.base(A), algebraModule(B), a, b), tmul(algebraModule(A), Algebra.base(A), algebraModule(B), a2, b2))) = tmul(algebraModule(A), Algebra.base(A), algebraModule(B), call2(Ring.mul(Algebra.ring(A)), a, a2), call2(Ring.mul(Algebra.ring(B)), b, b2))
proof
  obtain ⟨ringK, mA, mB, tp, hm⟩ := algebraTensor.setup at A, B with algebraA, algebraB, sameBase
  obtain ⟨_, val⟩ := algebraTensorAction.parts at A, B with algebraA, algebraB, sameBase
  have x1 := algebraModule.mem at A, a with ha
  have x2 := algebraModule.mem at A, a2 with ha2
  have y1 := algebraModule.mem at B, b with hb
  have y2 := algebraModule.mem at B, b2 with hb2
  have t1 := tmul.mem at Algebra.base(A), algebraModule(A), algebraModule(B), a, b with ringK, mA, mB, x1, y1
  have t2 := tmul.mem at Algebra.base(A), algebraModule(A), algebraModule(B), a2, b2 with ringK, mA, mB, x2, y2
  have e1 := algebraTensorProductGraph.value at A, B, tmul(algebraModule(A), Algebra.base(A), algebraModule(B), a, b), tmul(algebraModule(A), Algebra.base(A), algebraModule(B), a2, b2) with algebraA, algebraB, sameBase, t1, t2
  have e2 := val with a, ha, b, hb
  have e3 := algebraTensorLeft.tmul at A, B, a, b, a2, b2 with algebraA, algebraB, sameBase, ha, hb, ha2, hb2
  rw [e1, e2, e3]

end AlgebraTensorConstruction

-- Section: Tensor products of algebras
-- For commutative R-algebras A and B, the multiplication of A ⊗ B: the
-- unique map T × T → T, bilinear for the R-module structure, with
-- (a ⊗ b)(a' ⊗ b') = (a a') ⊗ (b b') (Algebra.TensorProduct.mul).
defunique algebraTensorMultiplication (A B : Set)
    (μ ∈ functionSpace(
      Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A),
        algebraModule(B))) ×
      Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A),
        algebraModule(B))),
      Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A),
        algebraModule(B))))) :=
  BilinearMap(μ, tensorProduct(algebraModule(A), Algebra.base(A),
      algebraModule(B)),
    tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B)),
    tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B)),
    Algebra.base(A)) ∧
  (∀ a a2 ∈ algebraCarrier(A), ∀ b b2 ∈ algebraCarrier(B),
    μ((tmul(algebraModule(A), Algebra.base(A), algebraModule(B), a, b),
       tmul(algebraModule(A), Algebra.base(A), algebraModule(B), a2, b2))) =
    tmul(algebraModule(A), Algebra.base(A), algebraModule(B),
      call2(Ring.mul(Algebra.ring(A)), a, a2),
      call2(Ring.mul(Algebra.ring(B)), b, b2)))
requires algebraA : Algebra(A)
requires algebraB : Algebra(B)
requires sameBase : Algebra.base(A) = Algebra.base(B)
proof
  obtain ⟨ringK, mA, mB, tp, hm⟩ := algebraTensor.setup at A, B with algebraA, algebraB, sameBase
  have bil := algebraTensorProductGraph.bilinear at A, B with algebraA, algebraB, sameBase
  obtain ⟨_, _, _, function, _⟩ := bil
  have space := functionSpace.mem_iff.backward with function
  witness algebraTensorProductGraph(A, B)
  refine ⟨space, bil, ?_⟩
  intros a ha a2 ha2 b hb b2 hb2
  exact algebraTensorProductGraph.pure at A, B, a, a2, b, b2 with algebraA, algebraB, sameBase, ha, ha2, hb, hb2
uniqueness
  obtain ⟨ringK, mA, mB, tp, hmod⟩ := algebraTensor.setup at A, B with algebraA, algebraB, sameBase
  intros u uIn first v vIn second
  obtain ⟨bu, pu⟩ := first
  obtain ⟨bv, pv⟩ := second
  have uF := functionSpace.mem_iff.forward with uIn
  have vF := functionSpace.mem_iff.forward with vIn
  have pureLeft : ∀ a ∈ algebraCarrier(A), ∀ b ∈ algebraCarrier(B), ∀ t ∈ Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B))), u((tmul(algebraModule(A), Algebra.base(A), algebraModule(B), a, b), t)) = v((tmul(algebraModule(A), Algebra.base(A), algebraModule(B), a, b), t))
    intros a ha b hb t ht
    have x1 := algebraModule.mem at A, a with ha
    have y1 := algebraModule.mem at B, b with hb
    have s := tmul.mem at Algebra.base(A), algebraModule(A), algebraModule(B), a, b with ringK, mA, mB, x1, y1
    have lu := bilinearRight.linear at u, tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B)), tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B)), tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B)), Algebra.base(A), tmul(algebraModule(A), Algebra.base(A), algebraModule(B), a, b) with ringK, bu, s
    have lv := bilinearRight.linear at v, tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B)), tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B)), tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B)), Algebra.base(A), tmul(algebraModule(A), Algebra.base(A), algebraModule(B), a, b) with ringK, bv, s
    have agree : ∀ m ∈ Module.carrier(algebraModule(A)), ∀ n ∈ Module.carrier(algebraModule(B)), bilinearRight(u, Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B))), Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B))), tmul(algebraModule(A), Algebra.base(A), algebraModule(B), a, b))(tmul(algebraModule(A), Algebra.base(A), algebraModule(B), m, n)) = bilinearRight(v, Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B))), Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B))), tmul(algebraModule(A), Algebra.base(A), algebraModule(B), a, b))(tmul(algebraModule(A), Algebra.base(A), algebraModule(B), m, n))
      intros m hm n hn
      have tn := tmul.mem at Algebra.base(A), algebraModule(A), algebraModule(B), m, n with ringK, mA, mB, hm, hn
      have e1 := bilinearRight.value at u, tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B)), tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B)), tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B)), Algebra.base(A), tmul(algebraModule(A), Algebra.base(A), algebraModule(B), a, b), tmul(algebraModule(A), Algebra.base(A), algebraModule(B), m, n) with ringK, bu, s, tn
      have e2 := bilinearRight.value at v, tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B)), tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B)), tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B)), Algebra.base(A), tmul(algebraModule(A), Algebra.base(A), algebraModule(B), a, b), tmul(algebraModule(A), Algebra.base(A), algebraModule(B), m, n) with ringK, bv, s, tn
      have ceA := algebraModule.carrier_eq at A
      have ceB := algebraModule.carrier_eq at B
      rw ceA at hm
      rw ceB at hn
      have f1 := pu with a, ha, m, hm, b, hb, n, hn
      have f2 := pv with a, ha, m, hm, b, hb, n, hn
      rw [e1, e2, f1, f2]
    have same := tensorProduct.ext_pure at Algebra.base(A), algebraModule(A), algebraModule(B), tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B)), bilinearRight(u, Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B))), Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B))), tmul(algebraModule(A), Algebra.base(A), algebraModule(B), a, b)), bilinearRight(v, Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B))), Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B))), tmul(algebraModule(A), Algebra.base(A), algebraModule(B), a, b)) with ringK, mA, mB, lu, lv, agree
    have e1 := bilinearRight.value at u, tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B)), tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B)), tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B)), Algebra.base(A), tmul(algebraModule(A), Algebra.base(A), algebraModule(B), a, b), t with ringK, bu, s, ht
    have e2 := bilinearRight.value at v, tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B)), tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B)), tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B)), Algebra.base(A), tmul(algebraModule(A), Algebra.base(A), algebraModule(B), a, b), t with ringK, bv, s, ht
    rw [← e1, ← e2, same]
  have everywhere : ∀ s ∈ Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B))), ∀ t ∈ Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B))), u((s, t)) = v((s, t))
    intros s hs t ht
    have lu := bilinearLeft.linear at u, tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B)), tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B)), tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B)), Algebra.base(A), t with ringK, bu, ht
    have lv := bilinearLeft.linear at v, tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B)), tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B)), tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B)), Algebra.base(A), t with ringK, bv, ht
    have agree : ∀ m ∈ Module.carrier(algebraModule(A)), ∀ n ∈ Module.carrier(algebraModule(B)), bilinearLeft(u, Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B))), Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B))), t)(tmul(algebraModule(A), Algebra.base(A), algebraModule(B), m, n)) = bilinearLeft(v, Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B))), Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B))), t)(tmul(algebraModule(A), Algebra.base(A), algebraModule(B), m, n))
      intros m hm n hn
      have tn := tmul.mem at Algebra.base(A), algebraModule(A), algebraModule(B), m, n with ringK, mA, mB, hm, hn
      have e1 := bilinearLeft.value at u, tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B)), tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B)), tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B)), Algebra.base(A), tmul(algebraModule(A), Algebra.base(A), algebraModule(B), m, n), t with ringK, bu, tn, ht
      have e2 := bilinearLeft.value at v, tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B)), tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B)), tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B)), Algebra.base(A), tmul(algebraModule(A), Algebra.base(A), algebraModule(B), m, n), t with ringK, bv, tn, ht
      have ceA := algebraModule.carrier_eq at A
      have ceB := algebraModule.carrier_eq at B
      rw ceA at hm
      rw ceB at hn
      have f := pureLeft with m, hm, n, hn, t, ht
      rw [e1, e2, f]
    have same := tensorProduct.ext_pure at Algebra.base(A), algebraModule(A), algebraModule(B), tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B)), bilinearLeft(u, Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B))), Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B))), t), bilinearLeft(v, Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B))), Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B))), t) with ringK, mA, mB, lu, lv, agree
    have e1 := bilinearLeft.value at u, tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B)), tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B)), tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B)), Algebra.base(A), s, t with ringK, bu, hs, ht
    have e2 := bilinearLeft.value at v, tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B)), tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B)), tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B)), Algebra.base(A), s, t with ringK, bv, hs, ht
    rw [← e1, ← e2, same]
  apply FunctionBetween.ext with uF, vF
  intros p hp
  obtain ⟨bound, s, hs, t, ht, shape⟩ := product.membership.forward with hp
  rw shape
  exact everywhere with s, hs, t, ht

-- The ring A ⊗ B, with one 1 ⊗ 1, and the R-algebra with structure map
-- r ↦ (r · 1) ⊗ 1.
def algebraTensorRing (A B : Set) : Set :=
  Ring.mk(
    Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A),
      algebraModule(B))),
    Module.add(tensorProduct(algebraModule(A), Algebra.base(A),
      algebraModule(B))),
    Module.zero(tensorProduct(algebraModule(A), Algebra.base(A),
      algebraModule(B))),
    Module.neg(tensorProduct(algebraModule(A), Algebra.base(A),
      algebraModule(B))),
    algebraTensorMultiplication(A, B),
    tmul(algebraModule(A), Algebra.base(A), algebraModule(B),
      Ring.one(Algebra.ring(A)), Ring.one(Algebra.ring(B))))

def algebraTensorMap (A B : Set) : Set :=
  { p ∈ Ring.carrier(Algebra.base(A)) × Ring.carrier(algebraTensorRing(A, B)) |
    ∃ r ∈ Ring.carrier(Algebra.base(A)),
      p = (r, tmul(algebraModule(A), Algebra.base(A), algebraModule(B),
        Algebra.map(A)(r), Ring.one(Algebra.ring(B)))) }

def algebraTensor (A B : Set) : Set :=
  Algebra.mk(Algebra.base(A), algebraTensorRing(A, B), algebraTensorMap(A, B))

-- a ↦ a ⊗ 1 and b ↦ 1 ⊗ b (Algebra.TensorProduct.includeLeft,
-- includeRight).
def includeLeft (A B : Set) : Set :=
  { p ∈ algebraCarrier(A) × Ring.carrier(algebraTensorRing(A, B)) |
    ∃ a ∈ algebraCarrier(A), p = (a, tmul(algebraModule(A), Algebra.base(A),
      algebraModule(B), a, Ring.one(Algebra.ring(B)))) }

def includeRight (A B : Set) : Set :=
  { p ∈ algebraCarrier(B) × Ring.carrier(algebraTensorRing(A, B)) |
    ∃ b ∈ algebraCarrier(B), p = (b, tmul(algebraModule(A), Algebra.base(A),
      algebraModule(B), Ring.one(Algebra.ring(A)), b)) }

-- For algebra maps f : A → C and g : B → C, the algebra map A ⊗ B → C,
-- a ⊗ b ↦ f(a) g(b) (Algebra.TensorProduct.productMap).
def productMapPairs (A B C f g : Set) : Set :=
  { p ∈ (algebraCarrier(A) × algebraCarrier(B)) × algebraCarrier(C) |
    ∃ a ∈ algebraCarrier(A), ∃ b ∈ algebraCarrier(B),
      p = ((a, b), call2(Ring.mul(Algebra.ring(C)), f(a), g(b))) }

def productMap (A B C f g : Set) : Set :=
  tensorLift(algebraModule(A), Algebra.base(A), algebraModule(B),
    algebraModule(C), productMapPairs(A, B, C, f, g))

-- Graph lemmas of the product map.
theorem productMapPairs.graph_relates (A B C f g a b : Set)
  requires rowIn : a ∈ algebraCarrier(A)
  requires colIn : b ∈ algebraCarrier(B)
  requires valueIn : call2(Ring.mul(Algebra.ring(C)), f(a), g(b)) ∈ algebraCarrier(C)
  shows relates(productMapPairs(A, B, C, f, g), (a, b), call2(Ring.mul(Algebra.ring(C)), f(a), g(b)))
proof
  have pairIn := product.pair at a, b, algebraCarrier(A), algebraCarrier(B) with rowIn, colIn
  have outer := product.pair at (a, b), call2(Ring.mul(Algebra.ring(C)), f(a), g(b)), algebraCarrier(A) × algebraCarrier(B), algebraCarrier(C) with pairIn, valueIn
  unfold relates
  apply productMapPairs.membership.backward
  exact ⟨outer, a, rowIn, b, colIn, rfl⟩

theorem productMapPairs.graph_function (A B C f g : Set)
  requires values : ∀ a ∈ algebraCarrier(A), ∀ b ∈ algebraCarrier(B), call2(Ring.mul(Algebra.ring(C)), f(a), g(b)) ∈ algebraCarrier(C)
  shows productMapPairs(A, B, C, f, g) : algebraCarrier(A) × algebraCarrier(B) → algebraCarrier(C)
proof
  constructor
    intros q0 member
    obtain ⟨bounded, witnesses⟩ := productMapPairs.membership.forward with member
    exact bounded
  . constructor
      intros z0 first xFirst second xSecond
      unfold relates at xFirst
      obtain ⟨_, a1, a1In, b1, b1In, firstShape⟩ := productMapPairs.membership.forward with xFirst
      unfold relates at xSecond
      obtain ⟨_, a2, a2In, b2, b2In, secondShape⟩ := productMapPairs.membership.forward with xSecond
      obtain ⟨xi, firstEqual⟩ := orderedPair.injective with firstShape
      obtain ⟨xj, secondEqual⟩ := orderedPair.injective with secondShape
      rw xi at xj
      obtain ⟨aa, bb⟩ := orderedPair.injective with xj
      rw [firstEqual, secondEqual]
      cc
    . intros q0 pIn
      obtain ⟨bound, a, rowIn, b, colIn, shape⟩ := product.membership.forward with pIn
      have valueIn := values with a, rowIn, b, colIn
      have mapped := productMapPairs.graph_relates at A, B, C, f, g, a, b with rowIn, colIn, valueIn
      rw shape
      exact ⟨call2(Ring.mul(Algebra.ring(C)), f(a), g(b)), valueIn, mapped⟩

theorem productMapPairs.graph_entry (A B C f g a b : Set)
  requires values : ∀ a ∈ algebraCarrier(A), ∀ b ∈ algebraCarrier(B), call2(Ring.mul(Algebra.ring(C)), f(a), g(b)) ∈ algebraCarrier(C)
  requires rowIn : a ∈ algebraCarrier(A)
  requires colIn : b ∈ algebraCarrier(B)
  shows productMapPairs(A, B, C, f, g)((a, b)) = call2(Ring.mul(Algebra.ring(C)), f(a), g(b))
proof
  have function := productMapPairs.graph_function at A, B, C, f, g with values
  have valueIn := values with a, rowIn, b, colIn
  have mapped := productMapPairs.graph_relates at A, B, C, f, g, a, b with rowIn, colIn, valueIn
  have pairIn := product.pair at a, b, algebraCarrier(A), algebraCarrier(B) with rowIn, colIn
  exact FunctionBetween.apply_value with function, pairIn, mapped

-- Section: Laws of tensor products of algebras
section AlgebraTensor
variable (A B : Set)
hypothesis algebraA : Algebra(A)
hypothesis algebraB : Algebra(B)
hypothesis sameBase : Algebra.base(A) = Algebra.base(B)

theorem productMapPairs.value (C f g a b : Set)
  requires first : AlgebraHom(f, A, C)
  requires second : AlgebraHom(g, B, C)
  requires ha : a ∈ algebraCarrier(A)
  requires hb : b ∈ algebraCarrier(B)
  shows productMapPairs(A, B, C, f, g)((a, b)) = call2(Ring.mul(Algebra.ring(C)), f(a), g(b))
proof
  have baseC := AlgebraHom.base_eq with first
  have algebraC := AlgebraHom.target with first
  have fF := AlgebraHom.function with first
  have gF := AlgebraHom.function with second
  have fR := AlgebraHom.ring_hom with first
  have gR := AlgebraHom.ring_hom with second
  have crC := Algebra.comm_ring at C with algebraC
  have ringC := CommRing.to_ring with crC
  have values : ∀ a ∈ algebraCarrier(A), ∀ b ∈ algebraCarrier(B), call2(Ring.mul(Algebra.ring(C)), f(a), g(b)) ∈ algebraCarrier(C)
    intros x hx y hy
    have fx := FunctionBetween.apply_closed with fF, hx
    have gy := FunctionBetween.apply_closed with gF, hy
    exact algebraCarrier.mul_mem at C, f(x), g(y) with algebraC, fx, gy
  exact productMapPairs.graph_entry at A, B, C, f, g, a, b with values, ha, hb

theorem productMapPairs.bilinear (C f g : Set)
  requires first : AlgebraHom(f, A, C)
  requires second : AlgebraHom(g, B, C)
  shows BilinearMap(productMapPairs(A, B, C, f, g), algebraModule(A), algebraModule(B), algebraModule(C), Algebra.base(A))
proof
  obtain ⟨ringK, mA, mB, tp, hm⟩ := algebraTensor.setup at A, B with algebraA, algebraB, sameBase
  have baseC := AlgebraHom.base_eq with first
  have algebraC := AlgebraHom.target with first
  have fF := AlgebraHom.function with first
  have gF := AlgebraHom.function with second
  have fR := AlgebraHom.ring_hom with first
  have gR := AlgebraHom.ring_hom with second
  have crC := Algebra.comm_ring at C with algebraC
  have ringC := CommRing.to_ring with crC
  have mC : Module(algebraModule(C), Algebra.base(A))
    rw baseC
    exact algebraModule.module_of at C with algebraC
  have values : ∀ a ∈ algebraCarrier(A), ∀ b ∈ algebraCarrier(B), call2(Ring.mul(Algebra.ring(C)), f(a), g(b)) ∈ algebraCarrier(C)
    intros x hx y hy
    have fx := FunctionBetween.apply_closed with fF, hx
    have gy := FunctionBetween.apply_closed with gF, hy
    exact algebraCarrier.mul_mem at C, f(x), g(y) with algebraC, fx, gy
  have function := productMapPairs.graph_function at A, B, C, f, g with values
  have ceA := algebraModule.carrier_eq at A
  have ceB := algebraModule.carrier_eq at B
  have ceC := algebraModule.carrier_eq at C
  have aeA := algebraModule.add_eq at A
  have aeB := algebraModule.add_eq at B
  have aeC := algebraModule.add_eq at C
  rw [← ceA, ← ceB, ← ceC] at function
  unfold BilinearMap
  refine ⟨mA, mB, mC, function, ?_, ?_, ?_⟩
  . intros v hv w hw x hx
    rw ceA at hv
    rw ceA at hw
    rw ceB at hx
    rw [aeA, aeC]
    have vw := algebraCarrier.add_mem at A, v, w with algebraA, hv, hw
    have e1 := productMapPairs.value at A, B, C, f, g, call2(Ring.add(Algebra.ring(A)), v, w), x with algebraA, algebraB, sameBase, first, second, vw, hx
    have e2 := productMapPairs.value at A, B, C, f, g, v, x with algebraA, algebraB, sameBase, first, second, hv, hx
    have e3 := productMapPairs.value at A, B, C, f, g, w, x with algebraA, algebraB, sameBase, first, second, hw, hx
    have fv := FunctionBetween.apply_closed with fF, hv
    have fw := FunctionBetween.apply_closed with fF, hw
    have gx := FunctionBetween.apply_closed with gF, hx
    unfold algebraCarrier at hv
    unfold algebraCarrier at hw
    have fa := RingHom.map_add at f, Algebra.ring(A), Algebra.ring(C), v, w with fR, hv, hw
    unfold algebraCarrier at fv
    unfold algebraCarrier at fw
    unfold algebraCarrier at gx
    rw [e1, e2, e3, fa]
    ring
  . intros v hv x hx y hy
    rw ceA at hv
    rw ceB at hx
    rw ceB at hy
    rw [aeB, aeC]
    have xy := algebraCarrier.add_mem at B, x, y with algebraB, hx, hy
    have e1 := productMapPairs.value at A, B, C, f, g, v, call2(Ring.add(Algebra.ring(B)), x, y) with algebraA, algebraB, sameBase, first, second, hv, xy
    have e2 := productMapPairs.value at A, B, C, f, g, v, x with algebraA, algebraB, sameBase, first, second, hv, hx
    have e3 := productMapPairs.value at A, B, C, f, g, v, y with algebraA, algebraB, sameBase, first, second, hv, hy
    have fv := FunctionBetween.apply_closed with fF, hv
    have gx := FunctionBetween.apply_closed with gF, hx
    have gy := FunctionBetween.apply_closed with gF, hy
    unfold algebraCarrier at hx
    unfold algebraCarrier at hy
    have ga := RingHom.map_add at g, Algebra.ring(B), Algebra.ring(C), x, y with gR, hx, hy
    unfold algebraCarrier at fv
    unfold algebraCarrier at gx
    unfold algebraCarrier at gy
    rw [e1, e2, e3, ga]
    ring
  . intros r hr v hv x hx
    rw ceA at hv
    rw ceB at hx
    have hrB : r ∈ Ring.carrier(Algebra.base(B))
      rw ← sameBase
      exact hr
    have hrC : r ∈ Ring.carrier(Algebra.base(C))
      rw ← baseC
      exact hr
    have sv := algebraModule.smul_value at A, r, v with algebraA, hr, hv
    have sx := algebraModule.smul_value at B, r, x with algebraB, hrB, hx
    rw [sv, sx]
    have ma := algebraCarrier.map_mem at A, r with algebraA, hr
    have mb := algebraCarrier.map_mem at B, r with algebraB, hrB
    have rv := algebraCarrier.mul_mem at A, Algebra.map(A)(r), v with algebraA, ma, hv
    have rx := algebraCarrier.mul_mem at B, Algebra.map(B)(r), x with algebraB, mb, hx
    have e1 := productMapPairs.value at A, B, C, f, g, call2(Ring.mul(Algebra.ring(A)), Algebra.map(A)(r), v), x with algebraA, algebraB, sameBase, first, second, rv, hx
    have e2 := productMapPairs.value at A, B, C, f, g, v, x with algebraA, algebraB, sameBase, first, second, hv, hx
    have e3 := productMapPairs.value at A, B, C, f, g, v, call2(Ring.mul(Algebra.ring(B)), Algebra.map(B)(r), x) with algebraA, algebraB, sameBase, first, second, hv, rx
    have fv := FunctionBetween.apply_closed with fF, hv
    have gx := FunctionBetween.apply_closed with gF, hx
    have fg := algebraCarrier.mul_mem at C, f(v), g(x) with algebraC, fv, gx
    have sc := algebraModule.smul_value at C, r, call2(Ring.mul(Algebra.ring(C)), f(v), g(x)) with algebraC, hrC, fg
    unfold algebraCarrier at ma
    unfold algebraCarrier at mb
    unfold algebraCarrier at hv
    unfold algebraCarrier at hx
    have fm := RingHom.map_mul at f, Algebra.ring(A), Algebra.ring(C), Algebra.map(A)(r), v with fR, ma, hv
    have gm := RingHom.map_mul at g, Algebra.ring(B), Algebra.ring(C), Algebra.map(B)(r), x with gR, mb, hx
    have fb := AlgebraHom.map_base with first, hr
    have gb := AlgebraHom.map_base with second, hrB
    have mc := Algebra.map_mem at C, r with algebraC, hrC
    unfold algebraCarrier at fv
    unfold algebraCarrier at gx
    rw [e1, e2, e3, sc, fm, gm, fb, gb]
    refine ⟨?_, ?_⟩
    . ring
    . ring

theorem algebraTensor.algebra
  shows Algebra(algebraTensor(A, B))
proof
  sorry

theorem algebraTensor.mul_tmul (a a2 b b2 : Set)
  requires firstA : a ∈ algebraCarrier(A)
  requires secondA : a2 ∈ algebraCarrier(A)
  requires firstB : b ∈ algebraCarrier(B)
  requires secondB : b2 ∈ algebraCarrier(B)
  shows call2(Ring.mul(algebraTensorRing(A, B)),
      tmul(algebraModule(A), Algebra.base(A), algebraModule(B), a, b),
      tmul(algebraModule(A), Algebra.base(A), algebraModule(B), a2, b2)) =
    tmul(algebraModule(A), Algebra.base(A), algebraModule(B),
      call2(Ring.mul(Algebra.ring(A)), a, a2),
      call2(Ring.mul(Algebra.ring(B)), b, b2))
proof
  have sel := algebraTensorMultiplication.selected at A, B with algebraA, algebraB, sameBase
  obtain ⟨_, _, values⟩ := sel
  have e := values with a, firstA, a2, secondA, b, firstB, b2, secondB
  have me : Ring.mul(algebraTensorRing(A, B)) = algebraTensorMultiplication(A, B)
    unfold algebraTensorRing
    ring_projections
  rw me
  unfold call2
  unfold call2 at e
  exact e

theorem includeLeft.hom
  shows AlgebraHom(includeLeft(A, B), A, algebraTensor(A, B))
proof
  sorry

theorem includeRight.hom
  shows AlgebraHom(includeRight(A, B), B, algebraTensor(A, B))
proof
  sorry

-- Algebra.TensorProduct.productMap: algebra maps f : A → C and g : B → C
-- give the algebra map a ⊗ b ↦ f(a) g(b), the unique one restricting to
-- f and g.
theorem productMap.hom (C f g : Set)
  requires first : AlgebraHom(f, A, C)
  requires second : AlgebraHom(g, B, C)
  shows AlgebraHom(productMap(A, B, C, f, g), algebraTensor(A, B), C)
proof
  sorry

theorem productMap.tmul (C f g a b : Set)
  requires first : AlgebraHom(f, A, C)
  requires second : AlgebraHom(g, B, C)
  requires memberA : a ∈ algebraCarrier(A)
  requires memberB : b ∈ algebraCarrier(B)
  shows productMap(A, B, C, f, g)(tmul(algebraModule(A), Algebra.base(A),
    algebraModule(B), a, b)) = call2(Ring.mul(Algebra.ring(C)), f(a), g(b))
proof
  obtain ⟨ringK, mA, mB, tp, hm⟩ := algebraTensor.setup at A, B with algebraA, algebraB, sameBase
  have baseC := AlgebraHom.base_eq with first
  have algebraC := AlgebraHom.target with first
  have mC : Module(algebraModule(C), Algebra.base(A))
    rw baseC
    exact algebraModule.module_of at C with algebraC
  have bil := productMapPairs.bilinear at A, B, C, f, g with algebraA, algebraB, sameBase, first, second
  obtain ⟨_, val⟩ := tensorLift.parts at Algebra.base(A), algebraModule(A), algebraModule(B), algebraModule(C), productMapPairs(A, B, C, f, g) with ringK, mA, mB, bil
  have ha := algebraModule.mem at A, a with memberA
  have hb := algebraModule.mem at B, b with memberB
  have v := val with a, ha, b, hb
  have p := productMapPairs.value at A, B, C, f, g, a, b with algebraA, algebraB, sameBase, first, second, memberA, memberB
  unfold productMap
  rw [v, p]

theorem productMap.unique (C f g h : Set)
  requires first : AlgebraHom(f, A, C)
  requires second : AlgebraHom(g, B, C)
  requires hom : AlgebraHom(h, algebraTensor(A, B), C)
  requires left : ∀ a ∈ algebraCarrier(A), h(includeLeft(A, B)(a)) = f(a)
  requires right : ∀ b ∈ algebraCarrier(B), h(includeRight(A, B)(b)) = g(b)
  shows h = productMap(A, B, C, f, g)
proof
  sorry

end AlgebraTensor
