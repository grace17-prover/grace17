-- Tensor products of modules over a commutative ring, constructed as the
-- quotient of the free module on pairs by the bilinearity relations: pure
-- tensors and their laws, the universal property for bilinear maps,
-- functoriality (TensorProduct.map, lTensor, rTensor), the unit,
-- commutativity, and associativity isomorphisms, right exactness, bases
-- and ranks; base change along an algebra with its universal property
-- (LinearMap.liftBaseChange); and the tensor product of commutative
-- algebras with its inclusions and product map.
-- Part of the GRH blueprint.
-- Planned home: Algebra/Module/TensorProduct.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Linear.Tensor
import GRH.Linear.Dual
import Grace.Cumulus.Algebra.Algebras.Basic

-- Section: The construction
-- The free module R^(M × N) on the pairs, the generator [m, n] of a pair,
-- and the relators [m + m', n] − [m, n] − [m', n],
-- [m, n + n'] − [m, n] − [m, n'], [r m, n] − r [m, n], [m, r n] − r [m, n].
def pairModule (M R N : Set) : Set :=
  freeModule(R, Module.carrier(M) × Module.carrier(N))

def pairGenerator (M R N m n : Set) : Set :=
  unitVector(R, Module.carrier(M) × Module.carrier(N), (m, n))

-- a − b − c and a − r • b in the free module on pairs.
def pairDifference (M R N a b c : Set) : Set :=
  call2(Module.add(pairModule(M, R, N)),
    call2(Module.add(pairModule(M, R, N)), a,
      apply(Module.neg(pairModule(M, R, N)), b)),
    apply(Module.neg(pairModule(M, R, N)), c))

def pairScaledDifference (M R N a r b : Set) : Set :=
  call2(Module.add(pairModule(M, R, N)), a,
    apply(Module.neg(pairModule(M, R, N)),
      call2(Module.smul(pairModule(M, R, N)), r, b)))

def tensorRelators (M R N : Set) : Set :=
  { z ∈ finitelySupported(R, Module.carrier(M) × Module.carrier(N)) |
    (∃ m m2 ∈ Module.carrier(M), ∃ n ∈ Module.carrier(N),
      z = pairDifference(M, R, N,
        pairGenerator(M, R, N, call2(Module.add(M), m, m2), n),
        pairGenerator(M, R, N, m, n), pairGenerator(M, R, N, m2, n))) ∨
    (∃ m ∈ Module.carrier(M), ∃ n n2 ∈ Module.carrier(N),
      z = pairDifference(M, R, N,
        pairGenerator(M, R, N, m, call2(Module.add(N), n, n2)),
        pairGenerator(M, R, N, m, n), pairGenerator(M, R, N, m, n2))) ∨
    (∃ r ∈ Ring.carrier(R), ∃ m ∈ Module.carrier(M), ∃ n ∈ Module.carrier(N),
      z = pairScaledDifference(M, R, N,
        pairGenerator(M, R, N, call2(Module.smul(M), r, m), n), r,
        pairGenerator(M, R, N, m, n))) ∨
    (∃ r ∈ Ring.carrier(R), ∃ m ∈ Module.carrier(M), ∃ n ∈ Module.carrier(N),
      z = pairScaledDifference(M, R, N,
        pairGenerator(M, R, N, m, call2(Module.smul(N), r, n)), r,
        pairGenerator(M, R, N, m, n))) }

def tensorRelations (M R N : Set) : Set :=
  moduleSpan(pairModule(M, R, N), R, tensorRelators(M, R, N))

-- M ⊗[R] N, the pure tensor m ⊗ n, and the bilinear map (m, n) ↦ m ⊗ n
-- (Mathlib's TensorProduct, TensorProduct.tmul, TensorProduct.mk).
def tensorProduct (M R N : Set) : Set :=
  quotientModule(pairModule(M, R, N), R, tensorRelations(M, R, N))

def tmul (M R N m n : Set) : Set :=
  quotientModuleMap(pairModule(M, R, N), tensorRelations(M, R, N))(
    pairGenerator(M, R, N, m, n))

def tensorMk (M R N : Set) : Set :=
  { p ∈ (Module.carrier(M) × Module.carrier(N)) ×
      Module.carrier(tensorProduct(M, R, N)) |
    ∃ m ∈ Module.carrier(M), ∃ n ∈ Module.carrier(N),
      p = ((m, n), tmul(M, R, N, m, n)) }

-- The families i ↦ (u(i), w(i)) and (i, j) ↦ (v(i), w(j)) of pairs.
def pairFamily (k X Y u w : Set) : Set :=
  { p ∈ k × (X × Y) | ∃ i ∈ k, p = (i, (u(i), w(i))) }

def productFamily (I J X Y v w : Set) : Set :=
  { p ∈ (I × J) × (X × Y) | ∃ i ∈ I, ∃ j ∈ J, p = ((i, j), (v(i), w(j))) }

-- The linear map M ⊗ N → P of a bilinear map B : M × N → P,
-- m ⊗ n ↦ B(m, n) (TensorProduct.lift): the free extension of B to the
-- pairs, through the quotient.
def tensorLift (M R N P B : Set) : Set :=
  quotientLift(freeLift(P, R, Module.carrier(M) × Module.carrier(N), B),
    pairModule(M, R, N), tensorRelations(M, R, N), P)

-- f ⊗ g : M ⊗ N → M' ⊗ N', m ⊗ n ↦ f(m) ⊗ g(n) (TensorProduct.map),
-- and its one-sided cases lTensor (id ⊗ g) and rTensor (f ⊗ id).
def tensorMapPairs (f g M N M2 R N2 : Set) : Set :=
  { p ∈ (Module.carrier(M) × Module.carrier(N)) ×
      Module.carrier(tensorProduct(M2, R, N2)) |
    ∃ m ∈ Module.carrier(M), ∃ n ∈ Module.carrier(N),
      p = ((m, n), tmul(M2, R, N2, f(m), g(n))) }

def tensorMap (f g M N M2 R N2 : Set) : Set :=
  tensorLift(M, R, N, tensorProduct(M2, R, N2),
    tensorMapPairs(f, g, M, N, M2, R, N2))

def leftTensor (M R N N2 g : Set) : Set :=
  tensorMap(identity(Module.carrier(M)), g, M, N, M, R, N2)

def rightTensor (M R N M2 f : Set) : Set :=
  tensorMap(f, identity(Module.carrier(N)), M, N, M2, R, N)

-- R ⊗ M → M, r ⊗ m ↦ r m (TensorProduct.lid), and M ⊗ N → N ⊗ M,
-- m ⊗ n ↦ n ⊗ m (TensorProduct.comm).
def scalarTensorMap (M R : Set) : Set :=
  tensorLift(selfModule(R), R, M, M, Module.smul(M))

def tensorSwapPairs (M R N : Set) : Set :=
  { p ∈ (Module.carrier(M) × Module.carrier(N)) ×
      Module.carrier(tensorProduct(N, R, M)) |
    ∃ m ∈ Module.carrier(M), ∃ n ∈ Module.carrier(N),
      p = ((m, n), tmul(N, R, M, n, m)) }

def tensorSwap (M R N : Set) : Set :=
  tensorLift(M, R, N, tensorProduct(N, R, M), tensorSwapPairs(M, R, N))

-- Section: Base change
-- A commutative R-algebra A (Cumulus's Algebra, base R) as an R-module,
-- a ↦ r a acting through the structure map, and an A-module N as an
-- R-module by restriction of scalars.
def algebraAction (A : Set) : Set :=
  { p ∈ (Ring.carrier(Algebra.base(A)) × algebraCarrier(A)) × algebraCarrier(A) |
    ∃ r ∈ Ring.carrier(Algebra.base(A)), ∃ a ∈ algebraCarrier(A),
      p = ((r, a), call2(Ring.mul(Algebra.ring(A)), Algebra.map(A)(r), a)) }

def algebraModule (A : Set) : Set :=
  Module.mk(algebraCarrier(A), Ring.add(Algebra.ring(A)),
    Ring.zero(Algebra.ring(A)), Ring.neg(Algebra.ring(A)), algebraAction(A))

def restrictedAction (A N : Set) : Set :=
  { p ∈ (Ring.carrier(Algebra.base(A)) × Module.carrier(N)) × Module.carrier(N) |
    ∃ r ∈ Ring.carrier(Algebra.base(A)), ∃ x ∈ Module.carrier(N),
      p = ((r, x), call2(Module.smul(N), Algebra.map(A)(r), x)) }

def restrictedModule (A N : Set) : Set :=
  Module.mk(Module.carrier(N), Module.add(N), Module.zero(N), Module.neg(N),
    restrictedAction(A, N))

-- Multiplication by a ∈ A as an R-linear map of A.
def algebraMultiplication (A a : Set) : Set :=
  { p ∈ algebraCarrier(A) × algebraCarrier(A) | ∃ b ∈ algebraCarrier(A),
    p = (b, call2(Ring.mul(Algebra.ring(A)), a, b)) }

-- A ⊗[R] M as an A-module, a (b ⊗ m) = (a b) ⊗ m (Mathlib's
-- TensorProduct.leftModule on A ⊗ M, the base change of M).
def baseChangeAction (A M : Set) : Set :=
  { p ∈ (algebraCarrier(A) ×
      Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), M))) ×
      Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), M)) |
    ∃ a ∈ algebraCarrier(A),
    ∃ t ∈ Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), M)),
      p = ((a, t), rightTensor(algebraModule(A), Algebra.base(A), M,
        algebraModule(A), algebraMultiplication(A, a))(t)) }

def baseChange (A M : Set) : Set :=
  Module.mk(
    Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), M)),
    Module.add(tensorProduct(algebraModule(A), Algebra.base(A), M)),
    Module.zero(tensorProduct(algebraModule(A), Algebra.base(A), M)),
    Module.neg(tensorProduct(algebraModule(A), Algebra.base(A), M)),
    baseChangeAction(A, M))

-- m ↦ 1 ⊗ m, the R-linear map M → A ⊗ M.
def baseChangeUnit (A M : Set) : Set :=
  { p ∈ Module.carrier(M) ×
      Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), M)) |
    ∃ m ∈ Module.carrier(M), p = (m, tmul(algebraModule(A), Algebra.base(A),
      M, Ring.one(Algebra.ring(A)), m)) }

-- For an A-module N and an R-linear f : M → N, the A-linear map
-- A ⊗ M → N, a ⊗ m ↦ a f(m) (LinearMap.liftBaseChange).
def liftBaseChangePairs (A M N f : Set) : Set :=
  { p ∈ (algebraCarrier(A) × Module.carrier(M)) × Module.carrier(N) |
    ∃ a ∈ algebraCarrier(A), ∃ m ∈ Module.carrier(M),
      p = ((a, m), call2(Module.smul(N), a, f(m))) }

def liftBaseChange (A M N f : Set) : Set :=
  tensorLift(algebraModule(A), Algebra.base(A), M, restrictedModule(A, N),
    liftBaseChangePairs(A, M, N, f))

-- Section: Graph lemmas
theorem tensorMk.graph_relates (M R N m n : Set)
  requires rowIn : m ∈ Module.carrier(M)
  requires colIn : n ∈ Module.carrier(N)
  requires valueIn : tmul(M, R, N, m, n) ∈ Module.carrier(tensorProduct(M, R, N))
  shows relates(tensorMk(M, R, N), (m, n), tmul(M, R, N, m, n))
proof
  have pairIn := product.pair at m, n, Module.carrier(M), Module.carrier(N) with rowIn, colIn
  have outer := product.pair at (m, n), tmul(M, R, N, m, n), Module.carrier(M) × Module.carrier(N), Module.carrier(tensorProduct(M, R, N)) with pairIn, valueIn
  unfold relates
  apply tensorMk.membership.backward
  exact ⟨outer, m, rowIn, n, colIn, rfl⟩

theorem tensorMk.graph_function (M R N : Set)
  requires values : ∀ m ∈ Module.carrier(M), ∀ n ∈ Module.carrier(N), tmul(M, R, N, m, n) ∈ Module.carrier(tensorProduct(M, R, N))
  shows tensorMk(M, R, N) : Module.carrier(M) × Module.carrier(N) → Module.carrier(tensorProduct(M, R, N))
proof
  constructor
    intros q0 member
    obtain ⟨bounded, witnesses⟩ := tensorMk.membership.forward with member
    exact bounded
  . constructor
      intros z0 first xFirst second xSecond
      unfold relates at xFirst
      obtain ⟨_, a1, a1In, b1, b1In, firstShape⟩ := tensorMk.membership.forward with xFirst
      unfold relates at xSecond
      obtain ⟨_, a2, a2In, b2, b2In, secondShape⟩ := tensorMk.membership.forward with xSecond
      obtain ⟨xi, firstEqual⟩ := orderedPair.injective with firstShape
      obtain ⟨xj, secondEqual⟩ := orderedPair.injective with secondShape
      rw xi at xj
      obtain ⟨aa, bb⟩ := orderedPair.injective with xj
      rw [firstEqual, secondEqual]
      cc
    . intros q0 pIn
      obtain ⟨bound, m, rowIn, n, colIn, shape⟩ := product.membership.forward with pIn
      have valueIn := values with m, rowIn, n, colIn
      have mapped := tensorMk.graph_relates at M, R, N, m, n with rowIn, colIn, valueIn
      rw shape
      exact ⟨tmul(M, R, N, m, n), valueIn, mapped⟩

theorem tensorMk.graph_entry (M R N m n : Set)
  requires values : ∀ m ∈ Module.carrier(M), ∀ n ∈ Module.carrier(N), tmul(M, R, N, m, n) ∈ Module.carrier(tensorProduct(M, R, N))
  requires rowIn : m ∈ Module.carrier(M)
  requires colIn : n ∈ Module.carrier(N)
  shows tensorMk(M, R, N)((m, n)) = tmul(M, R, N, m, n)
proof
  have function := tensorMk.graph_function at M, R, N with values
  have valueIn := values with m, rowIn, n, colIn
  have mapped := tensorMk.graph_relates at M, R, N, m, n with rowIn, colIn, valueIn
  have pairIn := product.pair at m, n, Module.carrier(M), Module.carrier(N) with rowIn, colIn
  exact FunctionBetween.apply_value with function, pairIn, mapped

theorem tensorMapPairs.graph_relates (f g M N M2 R N2 m n : Set)
  requires rowIn : m ∈ Module.carrier(M)
  requires colIn : n ∈ Module.carrier(N)
  requires valueIn : tmul(M2, R, N2, f(m), g(n)) ∈ Module.carrier(tensorProduct(M2, R, N2))
  shows relates(tensorMapPairs(f, g, M, N, M2, R, N2), (m, n), tmul(M2, R, N2, f(m), g(n)))
proof
  have pairIn := product.pair at m, n, Module.carrier(M), Module.carrier(N) with rowIn, colIn
  have outer := product.pair at (m, n), tmul(M2, R, N2, f(m), g(n)), Module.carrier(M) × Module.carrier(N), Module.carrier(tensorProduct(M2, R, N2)) with pairIn, valueIn
  unfold relates
  apply tensorMapPairs.membership.backward
  exact ⟨outer, m, rowIn, n, colIn, rfl⟩

theorem tensorMapPairs.graph_function (f g M N M2 R N2 : Set)
  requires values : ∀ m ∈ Module.carrier(M), ∀ n ∈ Module.carrier(N), tmul(M2, R, N2, f(m), g(n)) ∈ Module.carrier(tensorProduct(M2, R, N2))
  shows tensorMapPairs(f, g, M, N, M2, R, N2) : Module.carrier(M) × Module.carrier(N) → Module.carrier(tensorProduct(M2, R, N2))
proof
  constructor
    intros q0 member
    obtain ⟨bounded, witnesses⟩ := tensorMapPairs.membership.forward with member
    exact bounded
  . constructor
      intros z0 first xFirst second xSecond
      unfold relates at xFirst
      obtain ⟨_, a1, a1In, b1, b1In, firstShape⟩ := tensorMapPairs.membership.forward with xFirst
      unfold relates at xSecond
      obtain ⟨_, a2, a2In, b2, b2In, secondShape⟩ := tensorMapPairs.membership.forward with xSecond
      obtain ⟨xi, firstEqual⟩ := orderedPair.injective with firstShape
      obtain ⟨xj, secondEqual⟩ := orderedPair.injective with secondShape
      rw xi at xj
      obtain ⟨aa, bb⟩ := orderedPair.injective with xj
      rw [firstEqual, secondEqual]
      cc
    . intros q0 pIn
      obtain ⟨bound, m, rowIn, n, colIn, shape⟩ := product.membership.forward with pIn
      have valueIn := values with m, rowIn, n, colIn
      have mapped := tensorMapPairs.graph_relates at f, g, M, N, M2, R, N2, m, n with rowIn, colIn, valueIn
      rw shape
      exact ⟨tmul(M2, R, N2, f(m), g(n)), valueIn, mapped⟩

theorem tensorMapPairs.graph_entry (f g M N M2 R N2 m n : Set)
  requires values : ∀ m ∈ Module.carrier(M), ∀ n ∈ Module.carrier(N), tmul(M2, R, N2, f(m), g(n)) ∈ Module.carrier(tensorProduct(M2, R, N2))
  requires rowIn : m ∈ Module.carrier(M)
  requires colIn : n ∈ Module.carrier(N)
  shows tensorMapPairs(f, g, M, N, M2, R, N2)((m, n)) = tmul(M2, R, N2, f(m), g(n))
proof
  have function := tensorMapPairs.graph_function at f, g, M, N, M2, R, N2 with values
  have valueIn := values with m, rowIn, n, colIn
  have mapped := tensorMapPairs.graph_relates at f, g, M, N, M2, R, N2, m, n with rowIn, colIn, valueIn
  have pairIn := product.pair at m, n, Module.carrier(M), Module.carrier(N) with rowIn, colIn
  exact FunctionBetween.apply_value with function, pairIn, mapped

theorem tensorSwapPairs.graph_relates (M R N m n : Set)
  requires rowIn : m ∈ Module.carrier(M)
  requires colIn : n ∈ Module.carrier(N)
  requires valueIn : tmul(N, R, M, n, m) ∈ Module.carrier(tensorProduct(N, R, M))
  shows relates(tensorSwapPairs(M, R, N), (m, n), tmul(N, R, M, n, m))
proof
  have pairIn := product.pair at m, n, Module.carrier(M), Module.carrier(N) with rowIn, colIn
  have outer := product.pair at (m, n), tmul(N, R, M, n, m), Module.carrier(M) × Module.carrier(N), Module.carrier(tensorProduct(N, R, M)) with pairIn, valueIn
  unfold relates
  apply tensorSwapPairs.membership.backward
  exact ⟨outer, m, rowIn, n, colIn, rfl⟩

theorem tensorSwapPairs.graph_function (M R N : Set)
  requires values : ∀ m ∈ Module.carrier(M), ∀ n ∈ Module.carrier(N), tmul(N, R, M, n, m) ∈ Module.carrier(tensorProduct(N, R, M))
  shows tensorSwapPairs(M, R, N) : Module.carrier(M) × Module.carrier(N) → Module.carrier(tensorProduct(N, R, M))
proof
  constructor
    intros q0 member
    obtain ⟨bounded, witnesses⟩ := tensorSwapPairs.membership.forward with member
    exact bounded
  . constructor
      intros z0 first xFirst second xSecond
      unfold relates at xFirst
      obtain ⟨_, a1, a1In, b1, b1In, firstShape⟩ := tensorSwapPairs.membership.forward with xFirst
      unfold relates at xSecond
      obtain ⟨_, a2, a2In, b2, b2In, secondShape⟩ := tensorSwapPairs.membership.forward with xSecond
      obtain ⟨xi, firstEqual⟩ := orderedPair.injective with firstShape
      obtain ⟨xj, secondEqual⟩ := orderedPair.injective with secondShape
      rw xi at xj
      obtain ⟨aa, bb⟩ := orderedPair.injective with xj
      rw [firstEqual, secondEqual]
      cc
    . intros q0 pIn
      obtain ⟨bound, m, rowIn, n, colIn, shape⟩ := product.membership.forward with pIn
      have valueIn := values with m, rowIn, n, colIn
      have mapped := tensorSwapPairs.graph_relates at M, R, N, m, n with rowIn, colIn, valueIn
      rw shape
      exact ⟨tmul(N, R, M, n, m), valueIn, mapped⟩

theorem tensorSwapPairs.graph_entry (M R N m n : Set)
  requires values : ∀ m ∈ Module.carrier(M), ∀ n ∈ Module.carrier(N), tmul(N, R, M, n, m) ∈ Module.carrier(tensorProduct(N, R, M))
  requires rowIn : m ∈ Module.carrier(M)
  requires colIn : n ∈ Module.carrier(N)
  shows tensorSwapPairs(M, R, N)((m, n)) = tmul(N, R, M, n, m)
proof
  have function := tensorSwapPairs.graph_function at M, R, N with values
  have valueIn := values with m, rowIn, n, colIn
  have mapped := tensorSwapPairs.graph_relates at M, R, N, m, n with rowIn, colIn, valueIn
  have pairIn := product.pair at m, n, Module.carrier(M), Module.carrier(N) with rowIn, colIn
  exact FunctionBetween.apply_value with function, pairIn, mapped

theorem liftBaseChangePairs.graph_relates (A M N f a m : Set)
  requires rowIn : a ∈ algebraCarrier(A)
  requires colIn : m ∈ Module.carrier(M)
  requires valueIn : call2(Module.smul(N), a, f(m)) ∈ Module.carrier(N)
  shows relates(liftBaseChangePairs(A, M, N, f), (a, m), call2(Module.smul(N), a, f(m)))
proof
  have pairIn := product.pair at a, m, algebraCarrier(A), Module.carrier(M) with rowIn, colIn
  have outer := product.pair at (a, m), call2(Module.smul(N), a, f(m)), algebraCarrier(A) × Module.carrier(M), Module.carrier(N) with pairIn, valueIn
  unfold relates
  apply liftBaseChangePairs.membership.backward
  exact ⟨outer, a, rowIn, m, colIn, rfl⟩

theorem liftBaseChangePairs.graph_function (A M N f : Set)
  requires values : ∀ a ∈ algebraCarrier(A), ∀ m ∈ Module.carrier(M), call2(Module.smul(N), a, f(m)) ∈ Module.carrier(N)
  shows liftBaseChangePairs(A, M, N, f) : algebraCarrier(A) × Module.carrier(M) → Module.carrier(N)
proof
  constructor
    intros q0 member
    obtain ⟨bounded, witnesses⟩ := liftBaseChangePairs.membership.forward with member
    exact bounded
  . constructor
      intros z0 first xFirst second xSecond
      unfold relates at xFirst
      obtain ⟨_, a1, a1In, b1, b1In, firstShape⟩ := liftBaseChangePairs.membership.forward with xFirst
      unfold relates at xSecond
      obtain ⟨_, a2, a2In, b2, b2In, secondShape⟩ := liftBaseChangePairs.membership.forward with xSecond
      obtain ⟨xi, firstEqual⟩ := orderedPair.injective with firstShape
      obtain ⟨xj, secondEqual⟩ := orderedPair.injective with secondShape
      rw xi at xj
      obtain ⟨aa, bb⟩ := orderedPair.injective with xj
      rw [firstEqual, secondEqual]
      cc
    . intros q0 pIn
      obtain ⟨bound, a, rowIn, m, colIn, shape⟩ := product.membership.forward with pIn
      have valueIn := values with a, rowIn, m, colIn
      have mapped := liftBaseChangePairs.graph_relates at A, M, N, f, a, m with rowIn, colIn, valueIn
      rw shape
      exact ⟨call2(Module.smul(N), a, f(m)), valueIn, mapped⟩

theorem liftBaseChangePairs.graph_entry (A M N f a m : Set)
  requires values : ∀ a ∈ algebraCarrier(A), ∀ m ∈ Module.carrier(M), call2(Module.smul(N), a, f(m)) ∈ Module.carrier(N)
  requires rowIn : a ∈ algebraCarrier(A)
  requires colIn : m ∈ Module.carrier(M)
  shows liftBaseChangePairs(A, M, N, f)((a, m)) = call2(Module.smul(N), a, f(m))
proof
  have function := liftBaseChangePairs.graph_function at A, M, N, f with values
  have valueIn := values with a, rowIn, m, colIn
  have mapped := liftBaseChangePairs.graph_relates at A, M, N, f, a, m with rowIn, colIn, valueIn
  have pairIn := product.pair at a, m, algebraCarrier(A), Module.carrier(M) with rowIn, colIn
  exact FunctionBetween.apply_value with function, pairIn, mapped

theorem productFamily.graph_relates (I J X Y v w i j : Set)
  requires rowIn : i ∈ I
  requires colIn : j ∈ J
  requires valueIn : (v(i), w(j)) ∈ X × Y
  shows relates(productFamily(I, J, X, Y, v, w), (i, j), (v(i), w(j)))
proof
  have pairIn := product.pair at i, j, I, J with rowIn, colIn
  have outer := product.pair at (i, j), (v(i), w(j)), I × J, X × Y with pairIn, valueIn
  unfold relates
  apply productFamily.membership.backward
  exact ⟨outer, i, rowIn, j, colIn, rfl⟩

theorem productFamily.graph_function (I J X Y v w : Set)
  requires values : ∀ i ∈ I, ∀ j ∈ J, (v(i), w(j)) ∈ X × Y
  shows productFamily(I, J, X, Y, v, w) : I × J → X × Y
proof
  constructor
    intros q0 member
    obtain ⟨bounded, witnesses⟩ := productFamily.membership.forward with member
    exact bounded
  . constructor
      intros z0 first xFirst second xSecond
      unfold relates at xFirst
      obtain ⟨_, a1, a1In, b1, b1In, firstShape⟩ := productFamily.membership.forward with xFirst
      unfold relates at xSecond
      obtain ⟨_, a2, a2In, b2, b2In, secondShape⟩ := productFamily.membership.forward with xSecond
      obtain ⟨xi, firstEqual⟩ := orderedPair.injective with firstShape
      obtain ⟨xj, secondEqual⟩ := orderedPair.injective with secondShape
      rw xi at xj
      obtain ⟨aa, bb⟩ := orderedPair.injective with xj
      rw [firstEqual, secondEqual]
      cc
    . intros q0 pIn
      obtain ⟨bound, i, rowIn, j, colIn, shape⟩ := product.membership.forward with pIn
      have valueIn := values with i, rowIn, j, colIn
      have mapped := productFamily.graph_relates at I, J, X, Y, v, w, i, j with rowIn, colIn, valueIn
      rw shape
      exact ⟨(v(i), w(j)), valueIn, mapped⟩

theorem productFamily.graph_entry (I J X Y v w i j : Set)
  requires values : ∀ i ∈ I, ∀ j ∈ J, (v(i), w(j)) ∈ X × Y
  requires rowIn : i ∈ I
  requires colIn : j ∈ J
  shows productFamily(I, J, X, Y, v, w)((i, j)) = (v(i), w(j))
proof
  have function := productFamily.graph_function at I, J, X, Y, v, w with values
  have valueIn := values with i, rowIn, j, colIn
  have mapped := productFamily.graph_relates at I, J, X, Y, v, w, i, j with rowIn, colIn, valueIn
  have pairIn := product.pair at i, j, I, J with rowIn, colIn
  exact FunctionBetween.apply_value with function, pairIn, mapped

theorem pairFamily.graph_relates (k X Y u w i : Set)
  requires index : i ∈ k
  requires valueIn : (u(i), w(i)) ∈ X × Y
  shows relates(pairFamily(k, X, Y, u, w), i, (u(i), w(i)))
proof
  unfold relates
  apply pairFamily.membership.backward
  refine ⟨(product.pair at i, (u(i), w(i)), k, X × Y with index, valueIn), i, index, rfl⟩

theorem pairFamily.graph_function (k X Y u w : Set)
  requires values : ∀ i ∈ k, (u(i), w(i)) ∈ X × Y
  shows pairFamily(k, X, Y, u, w) : k → X × Y
proof
  constructor
    intros q0 member
    obtain ⟨bounded, witnesses⟩ := pairFamily.membership.forward with member
    exact bounded
  . constructor
      intros z0 first xFirst second xSecond
      unfold relates at xFirst
      obtain ⟨_, a1, a1In, firstShape⟩ := pairFamily.membership.forward with xFirst
      unfold relates at xSecond
      obtain ⟨_, a2, a2In, secondShape⟩ := pairFamily.membership.forward with xSecond
      obtain ⟨xi, firstEqual⟩ := orderedPair.injective with firstShape
      obtain ⟨xj, secondEqual⟩ := orderedPair.injective with secondShape
      rw [firstEqual, secondEqual]
      cc
    . intros i xIn
      have valueIn := values with i, xIn
      refine ⟨(u(i), w(i)), valueIn, (pairFamily.graph_relates at k, X, Y, u, w, i with xIn, valueIn)⟩

theorem pairFamily.graph_apply (k X Y u w i : Set)
  requires values : ∀ i ∈ k, (u(i), w(i)) ∈ X × Y
  requires index : i ∈ k
  shows pairFamily(k, X, Y, u, w)(i) = (u(i), w(i))
proof
  have function := pairFamily.graph_function at k, X, Y, u, w with values
  have valueIn := values with i, index
  have mapped := pairFamily.graph_relates at k, X, Y, u, w, i with index, valueIn
  exact FunctionBetween.apply_value with function, index, mapped


theorem algebraAction.graph_relates (A r a : Set)
  requires rowIn : r ∈ Ring.carrier(Algebra.base(A))
  requires colIn : a ∈ algebraCarrier(A)
  requires valueIn : call2(Ring.mul(Algebra.ring(A)), Algebra.map(A)(r), a) ∈ algebraCarrier(A)
  shows relates(algebraAction(A), (r, a), call2(Ring.mul(Algebra.ring(A)), Algebra.map(A)(r), a))
proof
  have pairIn := product.pair at r, a, Ring.carrier(Algebra.base(A)), algebraCarrier(A) with rowIn, colIn
  have outer := product.pair at (r, a), call2(Ring.mul(Algebra.ring(A)), Algebra.map(A)(r), a), Ring.carrier(Algebra.base(A)) × algebraCarrier(A), algebraCarrier(A) with pairIn, valueIn
  unfold relates
  apply algebraAction.membership.backward
  exact ⟨outer, r, rowIn, a, colIn, rfl⟩

theorem algebraAction.graph_function (A : Set)
  requires values : ∀ r ∈ Ring.carrier(Algebra.base(A)), ∀ a ∈ algebraCarrier(A), call2(Ring.mul(Algebra.ring(A)), Algebra.map(A)(r), a) ∈ algebraCarrier(A)
  shows algebraAction(A) : Ring.carrier(Algebra.base(A)) × algebraCarrier(A) → algebraCarrier(A)
proof
  constructor
    intros q0 member
    obtain ⟨bounded, witnesses⟩ := algebraAction.membership.forward with member
    exact bounded
  . constructor
      intros z0 first xFirst second xSecond
      unfold relates at xFirst
      obtain ⟨_, a1, a1In, b1, b1In, firstShape⟩ := algebraAction.membership.forward with xFirst
      unfold relates at xSecond
      obtain ⟨_, a2, a2In, b2, b2In, secondShape⟩ := algebraAction.membership.forward with xSecond
      obtain ⟨xi, firstEqual⟩ := orderedPair.injective with firstShape
      obtain ⟨xj, secondEqual⟩ := orderedPair.injective with secondShape
      rw xi at xj
      obtain ⟨aa, bb⟩ := orderedPair.injective with xj
      rw [firstEqual, secondEqual]
      cc
    . intros q0 pIn
      obtain ⟨bound, r, rowIn, a, colIn, shape⟩ := product.membership.forward with pIn
      have valueIn := values with r, rowIn, a, colIn
      have mapped := algebraAction.graph_relates at A, r, a with rowIn, colIn, valueIn
      rw shape
      exact ⟨call2(Ring.mul(Algebra.ring(A)), Algebra.map(A)(r), a), valueIn, mapped⟩

theorem algebraAction.graph_entry (A r a : Set)
  requires values : ∀ r ∈ Ring.carrier(Algebra.base(A)), ∀ a ∈ algebraCarrier(A), call2(Ring.mul(Algebra.ring(A)), Algebra.map(A)(r), a) ∈ algebraCarrier(A)
  requires rowIn : r ∈ Ring.carrier(Algebra.base(A))
  requires colIn : a ∈ algebraCarrier(A)
  shows algebraAction(A)((r, a)) = call2(Ring.mul(Algebra.ring(A)), Algebra.map(A)(r), a)
proof
  have function := algebraAction.graph_function at A with values
  have valueIn := values with r, rowIn, a, colIn
  have mapped := algebraAction.graph_relates at A, r, a with rowIn, colIn, valueIn
  have pairIn := product.pair at r, a, Ring.carrier(Algebra.base(A)), algebraCarrier(A) with rowIn, colIn
  exact FunctionBetween.apply_value with function, pairIn, mapped

theorem restrictedAction.graph_relates (A N r x : Set)
  requires rowIn : r ∈ Ring.carrier(Algebra.base(A))
  requires colIn : x ∈ Module.carrier(N)
  requires valueIn : call2(Module.smul(N), Algebra.map(A)(r), x) ∈ Module.carrier(N)
  shows relates(restrictedAction(A, N), (r, x), call2(Module.smul(N), Algebra.map(A)(r), x))
proof
  have pairIn := product.pair at r, x, Ring.carrier(Algebra.base(A)), Module.carrier(N) with rowIn, colIn
  have outer := product.pair at (r, x), call2(Module.smul(N), Algebra.map(A)(r), x), Ring.carrier(Algebra.base(A)) × Module.carrier(N), Module.carrier(N) with pairIn, valueIn
  unfold relates
  apply restrictedAction.membership.backward
  exact ⟨outer, r, rowIn, x, colIn, rfl⟩

theorem restrictedAction.graph_function (A N : Set)
  requires values : ∀ r ∈ Ring.carrier(Algebra.base(A)), ∀ x ∈ Module.carrier(N), call2(Module.smul(N), Algebra.map(A)(r), x) ∈ Module.carrier(N)
  shows restrictedAction(A, N) : Ring.carrier(Algebra.base(A)) × Module.carrier(N) → Module.carrier(N)
proof
  constructor
    intros q0 member
    obtain ⟨bounded, witnesses⟩ := restrictedAction.membership.forward with member
    exact bounded
  . constructor
      intros z0 first xFirst second xSecond
      unfold relates at xFirst
      obtain ⟨_, a1, a1In, b1, b1In, firstShape⟩ := restrictedAction.membership.forward with xFirst
      unfold relates at xSecond
      obtain ⟨_, a2, a2In, b2, b2In, secondShape⟩ := restrictedAction.membership.forward with xSecond
      obtain ⟨xi, firstEqual⟩ := orderedPair.injective with firstShape
      obtain ⟨xj, secondEqual⟩ := orderedPair.injective with secondShape
      rw xi at xj
      obtain ⟨aa, bb⟩ := orderedPair.injective with xj
      rw [firstEqual, secondEqual]
      cc
    . intros q0 pIn
      obtain ⟨bound, r, rowIn, x, colIn, shape⟩ := product.membership.forward with pIn
      have valueIn := values with r, rowIn, x, colIn
      have mapped := restrictedAction.graph_relates at A, N, r, x with rowIn, colIn, valueIn
      rw shape
      exact ⟨call2(Module.smul(N), Algebra.map(A)(r), x), valueIn, mapped⟩

theorem restrictedAction.graph_entry (A N r x : Set)
  requires values : ∀ r ∈ Ring.carrier(Algebra.base(A)), ∀ x ∈ Module.carrier(N), call2(Module.smul(N), Algebra.map(A)(r), x) ∈ Module.carrier(N)
  requires rowIn : r ∈ Ring.carrier(Algebra.base(A))
  requires colIn : x ∈ Module.carrier(N)
  shows restrictedAction(A, N)((r, x)) = call2(Module.smul(N), Algebra.map(A)(r), x)
proof
  have function := restrictedAction.graph_function at A, N with values
  have valueIn := values with r, rowIn, x, colIn
  have mapped := restrictedAction.graph_relates at A, N, r, x with rowIn, colIn, valueIn
  have pairIn := product.pair at r, x, Ring.carrier(Algebra.base(A)), Module.carrier(N) with rowIn, colIn
  exact FunctionBetween.apply_value with function, pairIn, mapped


-- Section: Linear maps killing differences
section TensorToolkit
variable (R A B f : Set)
hypothesis ringT : Ring(R)
hypothesis linearT : LinearMap(f, A, R, B)

theorem LinearMap.difference_zero (a b c : Set)
  requires ha : a ∈ Module.carrier(A)
  requires hb : b ∈ Module.carrier(A)
  requires hc : c ∈ Module.carrier(A)
  requires zero : f(call2(Module.add(A), call2(Module.add(A), a,
    apply(Module.neg(A), b)), apply(Module.neg(A), c))) = Module.zero(B)
  shows f(a) = call2(Module.add(B), f(b), f(c))
proof
  have moduleA := LinearMap.source_module with linearT
  have moduleB := LinearMap.target_module with linearT
  have nb := Module.neg_mem at R, A, b with *
  have nc := Module.neg_mem at R, A, c with *
  have ab := Module.add_mem at R, A, a, apply(Module.neg(A), b) with *
  have e1 := LinearMap.add_law at f, A, R, B, call2(Module.add(A), a, apply(Module.neg(A), b)), apply(Module.neg(A), c) with *
  have e2 := LinearMap.add_law at f, A, R, B, a, apply(Module.neg(A), b) with *
  have e3 := LinearMap.neg_law at R, A, B, f, b with *
  have e4 := LinearMap.neg_law at R, A, B, f, c with *
  rw [e1, e2, e3, e4] at zero
  have fa := LinearMap.value_mem at f, A, R, B, a with *
  have fb := LinearMap.value_mem at f, A, R, B, b with *
  have fc := LinearMap.value_mem at f, A, R, B, c with *
  have nfb := Module.neg_mem at R, B, f(b) with *
  have nfc := Module.neg_mem at R, B, f(c) with *
  have s1 := Module.add_mem at R, B, f(a), apply(Module.neg(B), f(b)) with *
  have s2 := (Module.sub_eq_zero_iff at R, B, call2(Module.add(B), f(a), apply(Module.neg(B), f(b))), f(c) with *).forward with zero
  have s4 := Module.add_assoc at R, B, f(a), apply(Module.neg(B), f(b)), f(b) with *
  have s5 := Module.neg_add at R, B, f(b) with *
  have s6 := Module.add_zero at R, B, f(a) with *
  have s7 := Module.add_comm at R, B, f(c), f(b) with *
  rw [s2, s5, s6] at s4
  rw [← s7, ← s4]

theorem LinearMap.scaled_difference_zero (a r b : Set)
  requires ha : a ∈ Module.carrier(A)
  requires hr : r ∈ Ring.carrier(R)
  requires hb : b ∈ Module.carrier(A)
  requires zero : f(call2(Module.add(A), a,
    apply(Module.neg(A), call2(Module.smul(A), r, b)))) = Module.zero(B)
  shows f(a) = call2(Module.smul(B), r, f(b))
proof
  have moduleA := LinearMap.source_module with linearT
  have moduleB := LinearMap.target_module with linearT
  have rb := Module.smul_mem at R, A, r, b with *
  have nrb := Module.neg_mem at R, A, call2(Module.smul(A), r, b) with *
  have e1 := LinearMap.add_law at f, A, R, B, a, apply(Module.neg(A), call2(Module.smul(A), r, b)) with *
  have e2 := LinearMap.neg_law at R, A, B, f, call2(Module.smul(A), r, b) with *
  have e3 := LinearMap.smul_law at f, A, R, B, r, b with *
  rw [e1, e2, e3] at zero
  have fa := LinearMap.value_mem at f, A, R, B, a with *
  have fb := LinearMap.value_mem at f, A, R, B, b with *
  have rfb := Module.smul_mem at R, B, r, f(b) with *
  exact (Module.sub_eq_zero_iff at R, B, f(a), call2(Module.smul(B), r, f(b)) with *).forward with zero

theorem LinearMap.difference_kills (a b c : Set)
  requires ha : a ∈ Module.carrier(A)
  requires hb : b ∈ Module.carrier(A)
  requires hc : c ∈ Module.carrier(A)
  requires sum : f(a) = call2(Module.add(B), f(b), f(c))
  shows f(call2(Module.add(A), call2(Module.add(A), a,
    apply(Module.neg(A), b)), apply(Module.neg(A), c))) = Module.zero(B)
proof
  have moduleA := LinearMap.source_module with linearT
  have moduleB := LinearMap.target_module with linearT
  have nb := Module.neg_mem at R, A, b with *
  have nc := Module.neg_mem at R, A, c with *
  have ab := Module.add_mem at R, A, a, apply(Module.neg(A), b) with *
  have e1 := LinearMap.add_law at f, A, R, B, call2(Module.add(A), a, apply(Module.neg(A), b)), apply(Module.neg(A), c) with *
  have e2 := LinearMap.add_law at f, A, R, B, a, apply(Module.neg(A), b) with *
  have e3 := LinearMap.neg_law at R, A, B, f, b with *
  have e4 := LinearMap.neg_law at R, A, B, f, c with *
  have fb := LinearMap.value_mem at f, A, R, B, b with *
  have fc := LinearMap.value_mem at f, A, R, B, c with *
  have nfb := Module.neg_mem at R, B, f(b) with *
  have s1 := Module.add_comm at R, B, f(b), f(c) with *
  have s2 := Module.add_assoc at R, B, f(c), f(b), apply(Module.neg(B), f(b)) with *
  have s3 := Module.add_neg at R, B, f(b) with *
  have s4 := Module.add_zero at R, B, f(c) with *
  have s5 := Module.add_neg at R, B, f(c) with *
  rw [e1, e2, e3, e4, sum, s1, s2, s3, s4, s5]

theorem LinearMap.scaled_difference_kills (a r b : Set)
  requires ha : a ∈ Module.carrier(A)
  requires hr : r ∈ Ring.carrier(R)
  requires hb : b ∈ Module.carrier(A)
  requires scaled : f(a) = call2(Module.smul(B), r, f(b))
  shows f(call2(Module.add(A), a,
    apply(Module.neg(A), call2(Module.smul(A), r, b)))) = Module.zero(B)
proof
  have moduleA := LinearMap.source_module with linearT
  have moduleB := LinearMap.target_module with linearT
  have rb := Module.smul_mem at R, A, r, b with *
  have nrb := Module.neg_mem at R, A, call2(Module.smul(A), r, b) with *
  have e1 := LinearMap.add_law at f, A, R, B, a, apply(Module.neg(A), call2(Module.smul(A), r, b)) with *
  have e2 := LinearMap.neg_law at R, A, B, f, call2(Module.smul(A), r, b) with *
  have e3 := LinearMap.smul_law at f, A, R, B, r, b with *
  have fb := LinearMap.value_mem at f, A, R, B, b with *
  have rfb := Module.smul_mem at R, B, r, f(b) with *
  have s5 := Module.add_neg at R, B, call2(Module.smul(B), r, f(b)) with *
  rw [e1, e2, e3, scaled, s5]

end TensorToolkit

-- For an exact N1 → N → N2 → 0, the bilinear map M × N2 → (M ⊗ N) ⧸ W,
-- (m, g(n)) ↦ [m ⊗ n], W the range of M ⊗ N1 → M ⊗ N.
def exactLiftPairs (M R N N2 g W : Set) : Set :=
  { p ∈ (Module.carrier(M) × Module.carrier(N2)) ×
      Module.carrier(quotientModule(tensorProduct(M, R, N), R, W)) |
    ∃ m ∈ Module.carrier(M), ∃ n ∈ Module.carrier(N),
      p = ((m, g(n)), quotientModuleMap(tensorProduct(M, R, N), W)(tmul(M, R, N, m, n))) }

-- Section: Laws of tensor products
section Tensors
variable (R M N : Set)
hypothesis ring : CommRing(R)
hypothesis moduleM : Module(M, R)
hypothesis moduleN : Module(N, R)

theorem tensorRelations.submodule
  shows SubmoduleOf(tensorRelations(M, R, N), pairModule(M, R, N), R)
proof
  have ringR := CommRing.to_ring with ring
  have pm : Module(pairModule(M, R, N), R)
    unfold pairModule
    exact freeModule.module at R, M.carrier × N.carrier with ring
  unfold tensorRelations
  exact moduleSpan.submodule_of at R, pairModule(M, R, N), tensorRelators(M, R, N) with ringR, pm

theorem pairModule.module
  shows Module(pairModule(M, R, N), R)
proof
  unfold pairModule
  exact freeModule.module at R, M.carrier × N.carrier with ring

theorem pairModule.carrier_eq
  shows Module.carrier(pairModule(M, R, N)) =
    finitelySupported(R, M.carrier × N.carrier)
proof
  unfold pairModule
  exact freeModule.carrierOf at R, M.carrier × N.carrier with ring

theorem pairGenerator.mem (m n : Set)
  requires hm : m ∈ M.carrier
  requires hn : n ∈ N.carrier
  shows pairGenerator(M, R, N, m, n) ∈ Module.carrier(pairModule(M, R, N))
proof
  have pair := product.pair at m, n, M.carrier, N.carrier with hm, hn
  have u := unitVector.finitely_supported at R, M.carrier × N.carrier, (m, n) with ring, pair
  have c := pairModule.carrier_eq at R, M, N with *
  rw c
  unfold pairGenerator
  exact u

theorem pairDifference.mem (a b c : Set)
  requires ha : a ∈ Module.carrier(pairModule(M, R, N))
  requires hb : b ∈ Module.carrier(pairModule(M, R, N))
  requires hc : c ∈ Module.carrier(pairModule(M, R, N))
  shows pairDifference(M, R, N, a, b, c) ∈ Module.carrier(pairModule(M, R, N))
proof
  have ringR := CommRing.to_ring with ring
  have pm := pairModule.module at R, M, N with *
  have nb := Module.neg_mem at R, pairModule(M, R, N), b with *
  have nc := Module.neg_mem at R, pairModule(M, R, N), c with *
  have ab := Module.add_mem at R, pairModule(M, R, N), a, apply(Module.neg(pairModule(M, R, N)), b) with *
  unfold pairDifference
  exact Module.add_mem at R, pairModule(M, R, N), call2(Module.add(pairModule(M, R, N)), a, apply(Module.neg(pairModule(M, R, N)), b)), apply(Module.neg(pairModule(M, R, N)), c) with *

theorem pairScaledDifference.mem (a r b : Set)
  requires ha : a ∈ Module.carrier(pairModule(M, R, N))
  requires hr : r ∈ R.carrier
  requires hb : b ∈ Module.carrier(pairModule(M, R, N))
  shows pairScaledDifference(M, R, N, a, r, b) ∈ Module.carrier(pairModule(M, R, N))
proof
  have ringR := CommRing.to_ring with ring
  have pm := pairModule.module at R, M, N with *
  have rb := Module.smul_mem at R, pairModule(M, R, N), r, b with *
  have nrb := Module.neg_mem at R, pairModule(M, R, N), call2(Module.smul(pairModule(M, R, N)), r, b) with *
  unfold pairScaledDifference
  exact Module.add_mem at R, pairModule(M, R, N), a, apply(Module.neg(pairModule(M, R, N)), call2(Module.smul(pairModule(M, R, N)), r, b)) with *

theorem tensorRelators.subset
  shows tensorRelators(M, R, N) ⊆ Module.carrier(pairModule(M, R, N))
proof
  have c := pairModule.carrier_eq at R, M, N with *
  intros z hz
  obtain ⟨zIn, _⟩ := tensorRelators.membership.forward with hz
  rw c
  exact zIn

theorem tensorQuotient.linear
  shows LinearMap(quotientModuleMap(pairModule(M, R, N), tensorRelations(M, R, N)),
    pairModule(M, R, N), R, tensorProduct(M, R, N))
proof
  have ringR := CommRing.to_ring with ring
  have pm := pairModule.module at R, M, N with *
  have sub := tensorRelations.submodule at R, M, N with *
  unfold tensorProduct
  exact SubmoduleOf.quotient_map_linear at R, pairModule(M, R, N), tensorRelations(M, R, N) with ringR, pm, sub

theorem tensorRelations.kills (z : Set)
  requires hz : z ∈ tensorRelations(M, R, N)
  shows quotientModuleMap(pairModule(M, R, N), tensorRelations(M, R, N))(z) =
    Module.zero(tensorProduct(M, R, N))
proof
  have ringR := CommRing.to_ring with ring
  have pm := pairModule.module at R, M, N with *
  have sub := tensorRelations.submodule at R, M, N with *
  have ker := SubmoduleOf.quotient_kernel at R, pairModule(M, R, N), tensorRelations(M, R, N) with ringR, pm, sub
  rw ← ker at hz
  obtain ⟨_, zero⟩ := linearKernel.membership.forward with hz
  unfold tensorProduct
  exact zero

theorem tensorRelators.kills (z : Set)
  requires hz : z ∈ tensorRelators(M, R, N)
  shows quotientModuleMap(pairModule(M, R, N), tensorRelations(M, R, N))(z) =
    Module.zero(tensorProduct(M, R, N))
proof
  have ringR := CommRing.to_ring with ring
  have pm := pairModule.module at R, M, N with *
  have inside := tensorRelators.subset at R, M, N with *
  have span := moduleSpan.subset_of at R, pairModule(M, R, N), tensorRelators(M, R, N) with ringR, pm, inside
  have zIn := span with z, hz
  have zRel : z ∈ tensorRelations(M, R, N)
    unfold tensorRelations
    exact zIn
  exact tensorRelations.kills at R, M, N, z with *

theorem tensorProduct.module
  shows Module(tensorProduct(M, R, N), R)
proof
  have ringR := CommRing.to_ring with ring
  have pm := pairModule.module at R, M, N with *
  have sub := tensorRelations.submodule at R, M, N with *
  unfold tensorProduct
  exact SubmoduleOf.quotient_module at R, pairModule(M, R, N), tensorRelations(M, R, N) with ringR, pm, sub

theorem tmul.mem (m : M) (n : N)
  shows tmul(M, R, N, m, n) ∈ Module.carrier(tensorProduct(M, R, N))
proof
  have lin := tensorQuotient.linear at R, M, N with *
  have g := pairGenerator.mem at R, M, N, m, n with *
  unfold tmul
  exact LinearMap.value_mem with lin, g

-- TensorProduct.add_tmul and tmul_add.
theorem tmul.add_left (m m2 : M) (n : N)
  shows tmul(M, R, N, m + m2, n) = call2(Module.add(tensorProduct(M, R, N)),
    tmul(M, R, N, m, n), tmul(M, R, N, m2, n))
proof
  have hm : m ∈ M.carrier by assumption
  have hm2 : m2 ∈ M.carrier by assumption
  have hn : n ∈ N.carrier by assumption
  have ringR := CommRing.to_ring with ring
  have hsum := Module.add_mem at R, M, m, m2 with *
  have lin := tensorQuotient.linear at R, M, N with *
  have ga := pairGenerator.mem at R, M, N, m + m2, n with *
  have gb := pairGenerator.mem at R, M, N, m, n with *
  have gc := pairGenerator.mem at R, M, N, m2, n with *
  have dIn := pairDifference.mem at R, M, N, pairGenerator(M, R, N, m + m2, n), pairGenerator(M, R, N, m, n), pairGenerator(M, R, N, m2, n) with *
  have c := pairModule.carrier_eq at R, M, N with *
  rw c at dIn
  have rel : pairDifference(M, R, N, pairGenerator(M, R, N, m + m2, n), pairGenerator(M, R, N, m, n), pairGenerator(M, R, N, m2, n)) ∈ tensorRelators(M, R, N)
    apply tensorRelators.membership.backward
    refine ⟨dIn, ?_⟩
    left
    exact ⟨m, hm, m2, hm2, n, hn, rfl⟩
  have zero := tensorRelators.kills at R, M, N with rel
  unfold pairDifference at zero
  unfold tmul
  exact LinearMap.difference_zero at R, pairModule(M, R, N), tensorProduct(M, R, N), quotientModuleMap(pairModule(M, R, N), tensorRelations(M, R, N)) with ringR, lin, ga, gb, gc, zero

theorem tmul.add_right (m : M) (n n2 : N)
  shows tmul(M, R, N, m, n + n2) = call2(Module.add(tensorProduct(M, R, N)),
    tmul(M, R, N, m, n), tmul(M, R, N, m, n2))
proof
  have hm : m ∈ M.carrier by assumption
  have hn : n ∈ N.carrier by assumption
  have hn2 : n2 ∈ N.carrier by assumption
  have ringR := CommRing.to_ring with ring
  have hsum := Module.add_mem at R, N, n, n2 with *
  have lin := tensorQuotient.linear at R, M, N with *
  have ga := pairGenerator.mem at R, M, N, m, n + n2 with *
  have gb := pairGenerator.mem at R, M, N, m, n with *
  have gc := pairGenerator.mem at R, M, N, m, n2 with *
  have dIn := pairDifference.mem at R, M, N, pairGenerator(M, R, N, m, n + n2), pairGenerator(M, R, N, m, n), pairGenerator(M, R, N, m, n2) with *
  have c := pairModule.carrier_eq at R, M, N with *
  rw c at dIn
  have rel : pairDifference(M, R, N, pairGenerator(M, R, N, m, n + n2), pairGenerator(M, R, N, m, n), pairGenerator(M, R, N, m, n2)) ∈ tensorRelators(M, R, N)
    apply tensorRelators.membership.backward
    refine ⟨dIn, ?_⟩
    right
    left
    exact ⟨m, hm, n, hn, n2, hn2, rfl⟩
  have zero := tensorRelators.kills at R, M, N with rel
  unfold pairDifference at zero
  unfold tmul
  exact LinearMap.difference_zero at R, pairModule(M, R, N), tensorProduct(M, R, N), quotientModuleMap(pairModule(M, R, N), tensorRelations(M, R, N)) with ringR, lin, ga, gb, gc, zero

-- TensorProduct.smul_tmul' and smul_tmul: r (m ⊗ n) = (r m) ⊗ n =
-- m ⊗ (r n).
theorem tmul.smul_left (r : R) (m : M) (n : N)
  shows tmul(M, R, N, r • m, n) = call2(Module.smul(tensorProduct(M, R, N)),
    r, tmul(M, R, N, m, n))
proof
  have hr : r ∈ R.carrier by assumption
  have hm : m ∈ M.carrier by assumption
  have hn : n ∈ N.carrier by assumption
  have ringR := CommRing.to_ring with ring
  have hrm := Module.smul_mem at R, M, r, m with *
  have lin := tensorQuotient.linear at R, M, N with *
  have ga := pairGenerator.mem at R, M, N, r • m, n with *
  have gb := pairGenerator.mem at R, M, N, m, n with *
  have dIn := pairScaledDifference.mem at R, M, N, pairGenerator(M, R, N, r • m, n), r, pairGenerator(M, R, N, m, n) with *
  have c := pairModule.carrier_eq at R, M, N with *
  rw c at dIn
  have rel : pairScaledDifference(M, R, N, pairGenerator(M, R, N, r • m, n), r, pairGenerator(M, R, N, m, n)) ∈ tensorRelators(M, R, N)
    apply tensorRelators.membership.backward
    refine ⟨dIn, ?_⟩
    right
    right
    left
    exact ⟨r, hr, m, hm, n, hn, rfl⟩
  have zero := tensorRelators.kills at R, M, N with rel
  unfold pairScaledDifference at zero
  unfold tmul
  exact LinearMap.scaled_difference_zero at R, pairModule(M, R, N), tensorProduct(M, R, N), quotientModuleMap(pairModule(M, R, N), tensorRelations(M, R, N)) with ringR, lin, ga, hr, gb, zero

theorem tmul.smul_right (r : R) (m : M) (n : N)
  shows tmul(M, R, N, m, r • n) = tmul(M, R, N, r • m, n)
proof
  have hr : r ∈ R.carrier by assumption
  have hm : m ∈ M.carrier by assumption
  have hn : n ∈ N.carrier by assumption
  have ringR := CommRing.to_ring with ring
  have hrn := Module.smul_mem at R, N, r, n with *
  have lin := tensorQuotient.linear at R, M, N with *
  have ga := pairGenerator.mem at R, M, N, m, r • n with *
  have gb := pairGenerator.mem at R, M, N, m, n with *
  have dIn := pairScaledDifference.mem at R, M, N, pairGenerator(M, R, N, m, r • n), r, pairGenerator(M, R, N, m, n) with *
  have c := pairModule.carrier_eq at R, M, N with *
  rw c at dIn
  have rel : pairScaledDifference(M, R, N, pairGenerator(M, R, N, m, r • n), r, pairGenerator(M, R, N, m, n)) ∈ tensorRelators(M, R, N)
    apply tensorRelators.membership.backward
    refine ⟨dIn, ?_⟩
    right
    right
    right
    exact ⟨r, hr, m, hm, n, hn, rfl⟩
  have zero := tensorRelators.kills at R, M, N with rel
  unfold pairScaledDifference at zero
  have e1 : tmul(M, R, N, m, r • n) = call2(Module.smul(tensorProduct(M, R, N)), r, tmul(M, R, N, m, n))
    unfold tmul
    exact LinearMap.scaled_difference_zero at R, pairModule(M, R, N), tensorProduct(M, R, N), quotientModuleMap(pairModule(M, R, N), tensorRelations(M, R, N)) with ringR, lin, ga, hr, gb, zero
  have e2 := tmul.smul_left at R, M, N, r, m, n with *
  rw [e1, e2]

theorem tmul.zero_left (n : N)
  shows tmul(M, R, N, M.zero, n) = Module.zero(tensorProduct(M, R, N))
proof
  have ringR := CommRing.to_ring with ring
  have tp := tensorProduct.module at R, M, N with *
  have z := Module.zero_mem at R, M with *
  have zR := Ring.zero_mem at R with ringR
  have t0 := tmul.mem at R, M, N, M.zero, n with *
  have e1 := zero_smul at R, M, M.zero with *
  have e2 := tmul.smul_left at R, M, N, R.zero, M.zero, n with *
  have e3 := zero_smul at R, tensorProduct(M, R, N), tmul(M, R, N, M.zero, n) with *
  rw [e1, e3] at e2
  exact e2

theorem tmul.zero_right (m : M)
  shows tmul(M, R, N, m, N.zero) = Module.zero(tensorProduct(M, R, N))
proof
  have ringR := CommRing.to_ring with ring
  have tp := tensorProduct.module at R, M, N with *
  have z := Module.zero_mem at R, N with *
  have zR := Ring.zero_mem at R with ringR
  have zM := Module.zero_mem at R, M with *
  have e1 := zero_smul at R, N, N.zero with *
  have e2 := tmul.smul_right at R, M, N, R.zero, m, N.zero with *
  have e3 := zero_smul at R, M, m with *
  have e4 := tmul.zero_left at R, M, N, N.zero with *
  rw [e1, e3, e4] at e2
  exact e2

-- TensorProduct.tmul_sub and neg_tmul.
theorem tmul.neg_left (m : M) (n : N)
  shows tmul(M, R, N, -m, n) =
    apply(Module.neg(tensorProduct(M, R, N)), tmul(M, R, N, m, n))
proof
  have ringR := CommRing.to_ring with ring
  have tp := tensorProduct.module at R, M, N with *
  have nm := Module.neg_mem at R, M, m with *
  have e1 := tmul.add_left at R, M, N, -m, m, n with *
  have e2 := Module.neg_add at R, M, m with *
  have e3 := tmul.zero_left at R, M, N, n with *
  rw [e2, e3] at e1
  have t1 := tmul.mem at R, M, N, -m, n with *
  have t2 := tmul.mem at R, M, N, m, n with *
  symm at e1
  exact Module.eq_neg_of_add_eq_zero at R, tensorProduct(M, R, N), tmul(M, R, N, -m, n), tmul(M, R, N, m, n) with *

theorem tmul.neg_right (m : M) (n : N)
  shows tmul(M, R, N, m, -n) =
    apply(Module.neg(tensorProduct(M, R, N)), tmul(M, R, N, m, n))
proof
  have ringR := CommRing.to_ring with ring
  have tp := tensorProduct.module at R, M, N with *
  have nn := Module.neg_mem at R, N, n with *
  have e1 := tmul.add_right at R, M, N, m, -n, n with *
  have e2 := Module.neg_add at R, N, n with *
  have e3 := tmul.zero_right at R, M, N, m with *
  rw [e2, e3] at e1
  have t1 := tmul.mem at R, M, N, m, -n with *
  have t2 := tmul.mem at R, M, N, m, n with *
  symm at e1
  exact Module.eq_neg_of_add_eq_zero at R, tensorProduct(M, R, N), tmul(M, R, N, m, -n), tmul(M, R, N, m, n) with *

-- TensorProduct.mk is bilinear.
theorem tensorMk.bilinear
  shows BilinearMap(tensorMk(M, R, N), M, N, tensorProduct(M, R, N), R)
proof
  have tp := tensorProduct.module at R, M, N with *
  have values : ∀ m ∈ M.carrier, ∀ n ∈ N.carrier, tmul(M, R, N, m, n) ∈ Module.carrier(tensorProduct(M, R, N))
    intros a ha b hb
    exact tmul.mem at R, M, N, a, b with *
  have function := tensorMk.graph_function at M, R, N with values
  have ap : ∀ a ∈ M.carrier, ∀ b ∈ N.carrier, tensorMk(M, R, N)((a, b)) = tmul(M, R, N, a, b)
    intros a ha b hb
    exact tensorMk.graph_entry at M, R, N, a, b with values, ha, hb
  unfold BilinearMap
  refine ⟨moduleM, moduleN, tp, function, ?_, ?_, ?_⟩
  . intros v hv w hw x hx
    have vw := Module.add_mem at R, M, v, w with *
    have a0 := ap with v + w, vw, x, hx
    have a1 := ap with v, hv, x, hx
    have a2 := ap with w, hw, x, hx
    rw [a0, a1, a2]
    exact tmul.add_left at R, M, N, v, w, x with *
  . intros v hv x hx y hy
    have xy := Module.add_mem at R, N, x, y with *
    have a0 := ap with v, hv, x + y, xy
    have a1 := ap with v, hv, x, hx
    have a2 := ap with v, hv, y, hy
    rw [a0, a1, a2]
    exact tmul.add_right at R, M, N, v, x, y with *
  . intros r hr v hv x hx
    have rv := Module.smul_mem at R, M, r, v with *
    have rx := Module.smul_mem at R, N, r, x with *
    have a0 := ap with r • v, rv, x, hx
    have a1 := ap with v, hv, x, hx
    have a2 := ap with v, hv, r • x, rx
    have e1 := tmul.smul_right at R, M, N, r, v, x with *
    have e2 := tmul.smul_left at R, M, N, r, v, x with *
    rw [a0, a1, a2, e1, e2]
    exact ⟨rfl, rfl⟩

theorem tensorMk.apply (m : M) (n : N)
  shows tensorMk(M, R, N)((m, n)) = tmul(M, R, N, m, n)
proof
  have values : ∀ m ∈ M.carrier, ∀ n ∈ N.carrier, tmul(M, R, N, m, n) ∈ Module.carrier(tensorProduct(M, R, N))
    intros a ha b hb
    exact tmul.mem at R, M, N, a, b with *
  exact tensorMk.graph_entry at M, R, N, m, n with values, *

theorem pairModule.free
  shows pairModule(M, R, N) = freeModule(R, M.carrier × N.carrier)
proof
  unfold pairModule
  rfl

theorem pairModule.basis
  shows ModuleBasis(pairModule(M, R, N), R, M.carrier × N.carrier,
    standardBasis(R, M.carrier × N.carrier))
proof
  have e := pairModule.free at R, M, N with *
  rw e
  exact freeModule.basis at R, M.carrier × N.carrier with ring

theorem pairModule.basis_value (m n : Set)
  requires hm : m ∈ M.carrier
  requires hn : n ∈ N.carrier
  shows standardBasis(R, M.carrier × N.carrier)((m, n)) = pairGenerator(M, R, N, m, n)
proof
  have values : ∀ i ∈ M.carrier × N.carrier, unitVector(R, M.carrier × N.carrier, i) ∈ functionSpace(M.carrier × N.carrier, R.carrier)
    intros i hi
    exact unitVector.mem at R, M.carrier × N.carrier, i with ring
  have pair := product.pair at m, n, M.carrier, N.carrier with hm, hn
  unfold pairGenerator
  exact standardBasis.graph_apply at R, M.carrier × N.carrier, (m, n) with values, pair

theorem tmul.quotient (m n : Set)
  shows quotientModuleMap(pairModule(M, R, N), tensorRelations(M, R, N))(pairGenerator(M, R, N, m, n)) = tmul(M, R, N, m, n)
proof
  unfold tmul
  rfl

theorem tensorQuotient.surjective
  shows SurjectiveBetween(quotientModuleMap(pairModule(M, R, N), tensorRelations(M, R, N)),
    Module.carrier(pairModule(M, R, N)), Module.carrier(tensorProduct(M, R, N)))
proof
  have ringR := CommRing.to_ring with ring
  have pm := pairModule.module at R, M, N with *
  have sub := tensorRelations.submodule at R, M, N with *
  unfold tensorProduct
  exact SubmoduleOf.quotient_map_surjective at R, pairModule(M, R, N), tensorRelations(M, R, N) with ringR, pm, sub

-- Linear maps out of M ⊗ N agreeing on pure tensors agree.
theorem tensorProduct.ext_pure (P f g : Set)
  requires first : LinearMap(f, tensorProduct(M, R, N), R, P)
  requires second : LinearMap(g, tensorProduct(M, R, N), R, P)
  requires agree : ∀ m ∈ M.carrier, ∀ n ∈ N.carrier,
    f(tmul(M, R, N, m, n)) = g(tmul(M, R, N, m, n))
  shows f = g
proof
  have ringR := CommRing.to_ring with ring
  have pm := pairModule.module at R, M, N with *
  have lin := tensorQuotient.linear at R, M, N with *
  have surj := tensorQuotient.surjective at R, M, N with *
  have qF := LinearMap.function_of with lin
  have fF := LinearMap.function_of with first
  have gF := LinearMap.function_of with second
  have cf := LinearMap.compose_of at quotientModuleMap(pairModule(M, R, N), tensorRelations(M, R, N)), f, pairModule(M, R, N), R, tensorProduct(M, R, N), P with lin, first
  have cg := LinearMap.compose_of at quotientModuleMap(pairModule(M, R, N), tensorRelations(M, R, N)), g, pairModule(M, R, N), R, tensorProduct(M, R, N), P with lin, second
  have basis := pairModule.basis at R, M, N with *
  have agreeBasis : ∀ x ∈ M.carrier × N.carrier,
      compose(f, quotientModuleMap(pairModule(M, R, N), tensorRelations(M, R, N)), Module.carrier(pairModule(M, R, N)), Module.carrier(tensorProduct(M, R, N)), Module.carrier(P))(standardBasis(R, M.carrier × N.carrier)(x)) =
      compose(g, quotientModuleMap(pairModule(M, R, N), tensorRelations(M, R, N)), Module.carrier(pairModule(M, R, N)), Module.carrier(tensorProduct(M, R, N)), Module.carrier(P))(standardBasis(R, M.carrier × N.carrier)(x))
    intros x hx
    obtain ⟨bound, a, ha, b, hb, shape⟩ := product.membership.forward with hx
    rw shape
    have bv := pairModule.basis_value at R, M, N, a, b with *
    have gen := pairGenerator.mem at R, M, N, a, b with *
    have c1 := compose.apply at f, quotientModuleMap(pairModule(M, R, N), tensorRelations(M, R, N)), Module.carrier(pairModule(M, R, N)), Module.carrier(tensorProduct(M, R, N)), Module.carrier(P), pairGenerator(M, R, N, a, b) with qF, fF, gen
    have c2 := compose.apply at g, quotientModuleMap(pairModule(M, R, N), tensorRelations(M, R, N)), Module.carrier(pairModule(M, R, N)), Module.carrier(tensorProduct(M, R, N)), Module.carrier(P), pairGenerator(M, R, N, a, b) with qF, gF, gen
    have tq := tmul.quotient at R, M, N, a, b with *
    have ag := agree with a, ha, b, hb
    rw [bv, c1, c2, tq, ag]
  have same := ModuleBasis.ext at R, pairModule(M, R, N), P, compose(f, quotientModuleMap(pairModule(M, R, N), tensorRelations(M, R, N)), Module.carrier(pairModule(M, R, N)), Module.carrier(tensorProduct(M, R, N)), Module.carrier(P)), compose(g, quotientModuleMap(pairModule(M, R, N), tensorRelations(M, R, N)), Module.carrier(pairModule(M, R, N)), Module.carrier(tensorProduct(M, R, N)), Module.carrier(P)), M.carrier × N.carrier, standardBasis(R, M.carrier × N.carrier) with ring, pm, basis, cf, cg, agreeBasis
  apply LinearMap.ext with first, second
  intros t ht
  obtain ⟨h, hh, ht2⟩ := Surjective.apply_exists with surj, ht
  have c1 := compose.apply at f, quotientModuleMap(pairModule(M, R, N), tensorRelations(M, R, N)), Module.carrier(pairModule(M, R, N)), Module.carrier(tensorProduct(M, R, N)), Module.carrier(P), h with qF, fF, hh
  have c2 := compose.apply at g, quotientModuleMap(pairModule(M, R, N), tensorRelations(M, R, N)), Module.carrier(pairModule(M, R, N)), Module.carrier(tensorProduct(M, R, N)), Module.carrier(P), h with qF, gF, hh
  rw [← ht2, ← c1, ← c2, same]

theorem freeLift.pair_value (P B m n : Set)
  requires moduleP : Module(P, R)
  requires family : B : M.carrier × N.carrier → P.carrier
  requires hm : m ∈ M.carrier
  requires hn : n ∈ N.carrier
  shows freeLift(P, R, M.carrier × N.carrier, B)(pairGenerator(M, R, N, m, n)) = B((m, n))
proof
  have pair := product.pair at m, n, M.carrier, N.carrier with hm, hn
  unfold pairGenerator
  exact freeLift.basis_vector at R, P, M.carrier × N.carrier, B, (m, n) with ring, moduleP, family, pair

theorem tensorLift.free_linear (P B : Set)
  requires bilinear : BilinearMap(B, M, N, P, R)
  shows LinearMap(freeLift(P, R, M.carrier × N.carrier, B), pairModule(M, R, N), R, P)
proof
  obtain ⟨_, _, moduleP, family, rest⟩ := bilinear
  have e := pairModule.free at R, M, N with *
  rw e
  exact freeLift.linear at R, P, M.carrier × N.carrier, B with ring, moduleP, family

theorem tensorLift.vanishes (P B : Set)
  requires bilinear : BilinearMap(B, M, N, P, R)
  shows tensorRelations(M, R, N) ⊆
    linearKernel(freeLift(P, R, M.carrier × N.carrier, B), pairModule(M, R, N), P)
proof
  have ringR := CommRing.to_ring with ring
  have pm := pairModule.module at R, M, N with *
  have lin := tensorLift.free_linear at R, M, N, P, B with *
  obtain ⟨_, _, moduleP, family, addL, addR, smulLR⟩ := bilinear
  have kernel := LinearMap.kernel_submodule at R, pairModule(M, R, N), P, freeLift(P, R, M.carrier × N.carrier, B) with ringR, pm, moduleP, lin
  have inside := tensorRelators.subset at R, M, N with *
  have least := (moduleSpan.least_of at R, pairModule(M, R, N), tensorRelators(M, R, N), linearKernel(freeLift(P, R, M.carrier × N.carrier, B), pairModule(M, R, N), P) with ringR, pm, inside, kernel).backward
  unfold tensorRelations
  apply least
  intros z hz
  have zIn := inside with z, hz
  apply linearKernel.membership.backward
  refine ⟨zIn, ?_⟩
  obtain ⟨_, cases⟩ := tensorRelators.membership.forward with hz
  cases cases with c1 | rest1
  . obtain ⟨m, hm, m2, hm2, n, hn, shape⟩ := c1
    have hsum := Module.add_mem at R, M, m, m2 with *
    have ga := pairGenerator.mem at R, M, N, m + m2, n with *
    have gb := pairGenerator.mem at R, M, N, m, n with *
    have gc := pairGenerator.mem at R, M, N, m2, n with *
    have v1 := freeLift.pair_value at R, M, N, P, B, m + m2, n with *
    have v2 := freeLift.pair_value at R, M, N, P, B, m, n with *
    have v3 := freeLift.pair_value at R, M, N, P, B, m2, n with *
    have law := addL with m, hm, m2, hm2, n, hn
    rw shape
    unfold pairDifference
    apply LinearMap.difference_kills at R, pairModule(M, R, N), P, freeLift(P, R, M.carrier × N.carrier, B) with ringR, lin, ga, gb, gc
    rw [v1, v2, v3, law]
  cases rest1 with c2 | rest2
  . obtain ⟨m, hm, n, hn, n2, hn2, shape⟩ := c2
    have hsum := Module.add_mem at R, N, n, n2 with *
    have ga := pairGenerator.mem at R, M, N, m, n + n2 with *
    have gb := pairGenerator.mem at R, M, N, m, n with *
    have gc := pairGenerator.mem at R, M, N, m, n2 with *
    have v1 := freeLift.pair_value at R, M, N, P, B, m, n + n2 with *
    have v2 := freeLift.pair_value at R, M, N, P, B, m, n with *
    have v3 := freeLift.pair_value at R, M, N, P, B, m, n2 with *
    have law := addR with m, hm, n, hn, n2, hn2
    rw shape
    unfold pairDifference
    apply LinearMap.difference_kills at R, pairModule(M, R, N), P, freeLift(P, R, M.carrier × N.carrier, B) with ringR, lin, ga, gb, gc
    rw [v1, v2, v3, law]
  cases rest2 with c3 | c4
  . obtain ⟨r, hr, m, hm, n, hn, shape⟩ := c3
    have hrm := Module.smul_mem at R, M, r, m with *
    have ga := pairGenerator.mem at R, M, N, r • m, n with *
    have gb := pairGenerator.mem at R, M, N, m, n with *
    have v1 := freeLift.pair_value at R, M, N, P, B, r • m, n with *
    have v2 := freeLift.pair_value at R, M, N, P, B, m, n with *
    obtain ⟨law, _⟩ := smulLR with r, hr, m, hm, n, hn
    rw shape
    unfold pairScaledDifference
    apply LinearMap.scaled_difference_kills at R, pairModule(M, R, N), P, freeLift(P, R, M.carrier × N.carrier, B) with ringR, lin, ga, hr, gb
    rw [v1, v2, law]
  . obtain ⟨r, hr, m, hm, n, hn, shape⟩ := c4
    have hrn := Module.smul_mem at R, N, r, n with *
    have ga := pairGenerator.mem at R, M, N, m, r • n with *
    have gb := pairGenerator.mem at R, M, N, m, n with *
    have v1 := freeLift.pair_value at R, M, N, P, B, m, r • n with *
    have v2 := freeLift.pair_value at R, M, N, P, B, m, n with *
    obtain ⟨_, law⟩ := smulLR with r, hr, m, hm, n, hn
    rw shape
    unfold pairScaledDifference
    apply LinearMap.scaled_difference_kills at R, pairModule(M, R, N), P, freeLift(P, R, M.carrier × N.carrier, B) with ringR, lin, ga, hr, gb
    rw [v1, v2, law]

theorem tensorLift.parts (P B : Set)
  requires bilinear : BilinearMap(B, M, N, P, R)
  shows LinearMap(tensorLift(M, R, N, P, B), tensorProduct(M, R, N), R, P) ∧
    (∀ m ∈ M.carrier, ∀ n ∈ N.carrier,
      tensorLift(M, R, N, P, B)(tmul(M, R, N, m, n)) = B((m, n)))
proof
  have ringR := CommRing.to_ring with ring
  have pm := pairModule.module at R, M, N with *
  have sub := tensorRelations.submodule at R, M, N with *
  have lin := tensorLift.free_linear at R, M, N, P, B with *
  have van := tensorLift.vanishes at R, M, N, P, B with *
  obtain ⟨_, _, moduleP, family, rest⟩ := bilinear
  obtain ⟨liftLin, liftValue⟩ := SubmoduleOf.quotient_lift at R, pairModule(M, R, N), tensorRelations(M, R, N), freeLift(P, R, M.carrier × N.carrier, B), P with ringR, pm, sub, lin, van
  have tp : tensorProduct(M, R, N) = quotientModule(pairModule(M, R, N), R, tensorRelations(M, R, N))
    unfold tensorProduct
    rfl
  have tl : tensorLift(M, R, N, P, B) = quotientLift(freeLift(P, R, M.carrier × N.carrier, B), pairModule(M, R, N), tensorRelations(M, R, N), P)
    unfold tensorLift
    rfl
  rw [tp, tl]
  refine ⟨liftLin, ?_⟩
  intros m hm n hn
  have gen := pairGenerator.mem at R, M, N, m, n with *
  have v := liftValue with pairGenerator(M, R, N, m, n), gen
  have pv := freeLift.pair_value at R, M, N, P, B, m, n with *
  unfold tmul
  rw [tl, v, pv]

-- TensorProduct.span_tmul_eq_top and induction_on: the pure tensors span.
theorem tensorProduct.span_pure
  shows moduleSpan(tensorProduct(M, R, N), R,
      functionImage(tensorMk(M, R, N), M.carrier × N.carrier,
        Module.carrier(tensorProduct(M, R, N)))) =
    Module.carrier(tensorProduct(M, R, N))
proof
  have ringR := CommRing.to_ring with ring
  have pm := pairModule.module at R, M, N with *
  have tp := tensorProduct.module at R, M, N with *
  have lin := tensorQuotient.linear at R, M, N with *
  have surj := tensorQuotient.surjective at R, M, N with *
  have values : ∀ m ∈ M.carrier, ∀ n ∈ N.carrier, tmul(M, R, N, m, n) ∈ Module.carrier(tensorProduct(M, R, N))
    intros a ha b hb
    exact tmul.mem at R, M, N, a, b with *
  have mkF := tensorMk.graph_function at M, R, N with values
  have SSub := functionImage.subset at tensorMk(M, R, N), M.carrier × N.carrier, Module.carrier(tensorProduct(M, R, N))
  have WSub := moduleSpan.submodule_of at R, tensorProduct(M, R, N), functionImage(tensorMk(M, R, N), M.carrier × N.carrier, Module.carrier(tensorProduct(M, R, N))) with ringR, tp
  have SW := moduleSpan.subset_of at R, tensorProduct(M, R, N), functionImage(tensorMk(M, R, N), M.carrier × N.carrier, Module.carrier(tensorProduct(M, R, N))) with ringR, tp, SSub
  have preSub := LinearMap.preimage_submodule at R, pairModule(M, R, N), tensorProduct(M, R, N), quotientModuleMap(pairModule(M, R, N), tensorRelations(M, R, N)), moduleSpan(tensorProduct(M, R, N), R, functionImage(tensorMk(M, R, N), M.carrier × N.carrier, Module.carrier(tensorProduct(M, R, N)))) with ringR, pm, tp, lin, WSub
  have basis := pairModule.basis at R, M, N with *
  obtain ⟨_, spans⟩ := basis
  obtain ⟨_, vF, spanEq⟩ := spans
  have imageSub := functionImage.subset at standardBasis(R, M.carrier × N.carrier), M.carrier × N.carrier, Module.carrier(pairModule(M, R, N))
  have imagePre : functionImage(standardBasis(R, M.carrier × N.carrier), M.carrier × N.carrier, Module.carrier(pairModule(M, R, N))) ⊆ submodulePreimage(quotientModuleMap(pairModule(M, R, N), tensorRelations(M, R, N)), pairModule(M, R, N), moduleSpan(tensorProduct(M, R, N), R, functionImage(tensorMk(M, R, N), M.carrier × N.carrier, Module.carrier(tensorProduct(M, R, N)))))
    intros y hy
    obtain ⟨yIn, x, hx, yv⟩ := functionImage.membership.forward with hy
    obtain ⟨bound, a, ha, b, hb, shape⟩ := product.membership.forward with hx
    apply submodulePreimage.membership.backward
    refine ⟨yIn, ?_⟩
    have bv := pairModule.basis_value at R, M, N, a, b with *
    have tq := tmul.quotient at R, M, N, a, b with *
    have mk := tensorMk.graph_entry at M, R, N, a, b with values, ha, hb
    have pair := product.pair at a, b, M.carrier, N.carrier with ha, hb
    have inS := functionImage.value at tensorMk(M, R, N), M.carrier × N.carrier, Module.carrier(tensorProduct(M, R, N)), (a, b) with mkF, pair
    rw mk at inS
    rw [yv, shape, bv, tq]
    exact SW with tmul(M, R, N, a, b), inS
  have least := (moduleSpan.least_of at R, pairModule(M, R, N), functionImage(standardBasis(R, M.carrier × N.carrier), M.carrier × N.carrier, Module.carrier(pairModule(M, R, N))), submodulePreimage(quotientModuleMap(pairModule(M, R, N), tensorRelations(M, R, N)), pairModule(M, R, N), moduleSpan(tensorProduct(M, R, N), R, functionImage(tensorMk(M, R, N), M.carrier × N.carrier, Module.carrier(tensorProduct(M, R, N))))) with ringR, pm, imageSub, preSub).backward with imagePre
  rw spanEq at least
  ext t
  constructor
  . intro ht
    obtain ⟨tIn, _⟩ := moduleSpan.membership.forward with ht
    exact tIn
  . intro ht
    obtain ⟨h, hh, ht2⟩ := Surjective.apply_exists with surj, ht
    have hPre := least with h, hh
    obtain ⟨_, qW⟩ := submodulePreimage.membership.forward with hPre
    rw ← ht2
    exact qW

-- Every element is a finite sum of pure tensors.
theorem tensorProduct.finite_sum (t : Set)
  requires member : t ∈ Module.carrier(tensorProduct(M, R, N))
  shows ∃ k, Nat(k) ∧ ∃ u, ∃ w, (u : k → M.carrier) ∧ (w : k → N.carrier) ∧
    t = moduleSum(tensorProduct(M, R, N), k,
      compose(tensorMk(M, R, N), pairFamily(k, M.carrier, N.carrier, u, w), k, M.carrier × N.carrier,
        Module.carrier(tensorProduct(M, R, N))))
proof
  sorry

-- TensorProduct.lift: the universal property.
theorem tensorLift.linear (P B : Set)
  requires bilinear : BilinearMap(B, M, N, P, R)
  shows LinearMap(tensorLift(M, R, N, P, B), tensorProduct(M, R, N), R, P)
proof
  obtain ⟨l, _⟩ := tensorLift.parts at R, M, N, P, B with *
  exact l

theorem tensorLift.tmul (P B : Set) (m : M) (n : N)
  requires bilinear : BilinearMap(B, M, N, P, R)
  shows tensorLift(M, R, N, P, B)(tmul(M, R, N, m, n)) = B((m, n))
proof
  have hm : m ∈ M.carrier by assumption
  have hn : n ∈ N.carrier by assumption
  obtain ⟨_, v⟩ := tensorLift.parts at R, M, N, P, B with *
  exact v with m, hm, n, hn

-- TensorProduct.ext': linear maps out of M ⊗ N agreeing on pure tensors
-- are equal.
theorem tensorProduct.ext (P f g : Set)
  requires first : LinearMap(f, tensorProduct(M, R, N), R, P)
  requires second : LinearMap(g, tensorProduct(M, R, N), R, P)
  requires agree : ∀ m ∈ M.carrier, ∀ n ∈ N.carrier,
    f(tmul(M, R, N, m, n)) = g(tmul(M, R, N, m, n))
  shows f = g
proof
  exact tensorProduct.ext_pure at R, M, N, P, f, g with *

theorem tensorLift.unique (P B f : Set)
  requires bilinear : BilinearMap(B, M, N, P, R)
  requires linear : LinearMap(f, tensorProduct(M, R, N), R, P)
  requires agree : ∀ m ∈ M.carrier, ∀ n ∈ N.carrier,
    f(tmul(M, R, N, m, n)) = B((m, n))
  shows f = tensorLift(M, R, N, P, B)
proof
  obtain ⟨l, v⟩ := tensorLift.parts at R, M, N, P, B with *
  apply tensorProduct.ext_pure at R, M, N, P, f, tensorLift(M, R, N, P, B) with ring, moduleM, moduleN, linear, l
  intros m hm n hn
  have a := agree with m, hm, n, hn
  have b := v with m, hm, n, hn
  rw [a, b]

theorem tensorMapPairs.value (M2 N2 f g m n : Set)
  requires first : LinearMap(f, M, R, M2)
  requires second : LinearMap(g, N, R, N2)
  requires hm : m ∈ M.carrier
  requires hn : n ∈ N.carrier
  shows tensorMapPairs(f, g, M, N, M2, R, N2)((m, n)) = tmul(M2, R, N2, f(m), g(n))
proof
  have moduleM2 := LinearMap.target_module with first
  have moduleN2 := LinearMap.target_module with second
  have fF := LinearMap.function_of with first
  have gF := LinearMap.function_of with second
  have values : ∀ a ∈ M.carrier, ∀ b ∈ N.carrier, tmul(M2, R, N2, f(a), g(b)) ∈ Module.carrier(tensorProduct(M2, R, N2))
    intros a ha b hb
    have fa := FunctionBetween.apply_closed with fF, ha
    have gb := FunctionBetween.apply_closed with gF, hb
    exact tmul.mem at R, M2, N2, f(a), g(b) with ring, moduleM2, moduleN2, fa, gb
  exact tensorMapPairs.graph_entry at f, g, M, N, M2, R, N2, m, n with values, hm, hn

theorem tensorMapPairs.bilinear (M2 N2 f g : Set)
  requires first : LinearMap(f, M, R, M2)
  requires second : LinearMap(g, N, R, N2)
  shows BilinearMap(tensorMapPairs(f, g, M, N, M2, R, N2), M, N, tensorProduct(M2, R, N2), R)
proof
  have moduleM2 := LinearMap.target_module with first
  have moduleN2 := LinearMap.target_module with second
  have tp := tensorProduct.module at R, M2, N2 with ring, moduleM2, moduleN2
  have fF := LinearMap.function_of with first
  have gF := LinearMap.function_of with second
  have values : ∀ a ∈ M.carrier, ∀ b ∈ N.carrier, tmul(M2, R, N2, f(a), g(b)) ∈ Module.carrier(tensorProduct(M2, R, N2))
    intros a ha b hb
    have fa := FunctionBetween.apply_closed with fF, ha
    have gb := FunctionBetween.apply_closed with gF, hb
    exact tmul.mem at R, M2, N2, f(a), g(b) with ring, moduleM2, moduleN2, fa, gb
  have function := tensorMapPairs.graph_function at f, g, M, N, M2, R, N2 with values
  unfold BilinearMap
  refine ⟨moduleM, moduleN, tp, function, ?_, ?_, ?_⟩
  . intros v hv w hw x hx
    have vw := Module.add_mem at R, M, v, w with *
    have a0 := tensorMapPairs.value at R, M, N, M2, N2, f, g, v + w, x with *
    have a1 := tensorMapPairs.value at R, M, N, M2, N2, f, g, v, x with *
    have a2 := tensorMapPairs.value at R, M, N, M2, N2, f, g, w, x with *
    have fv := FunctionBetween.apply_closed with fF, hv
    have fw := FunctionBetween.apply_closed with fF, hw
    have gx := FunctionBetween.apply_closed with gF, hx
    have l := LinearMap.add_law with first, hv, hw
    have t := tmul.add_left at R, M2, N2, f(v), f(w), g(x) with ring, moduleM2, moduleN2, fv, fw, gx
    rw [a0, a1, a2, l, t]
  . intros v hv x hx y hy
    have xy := Module.add_mem at R, N, x, y with *
    have a0 := tensorMapPairs.value at R, M, N, M2, N2, f, g, v, x + y with *
    have a1 := tensorMapPairs.value at R, M, N, M2, N2, f, g, v, x with *
    have a2 := tensorMapPairs.value at R, M, N, M2, N2, f, g, v, y with *
    have fv := FunctionBetween.apply_closed with fF, hv
    have gx := FunctionBetween.apply_closed with gF, hx
    have gy := FunctionBetween.apply_closed with gF, hy
    have l := LinearMap.add_law with second, hx, hy
    have t := tmul.add_right at R, M2, N2, f(v), g(x), g(y) with ring, moduleM2, moduleN2, fv, gx, gy
    rw [a0, a1, a2, l, t]
  . intros r hr v hv x hx
    have rv := Module.smul_mem at R, M, r, v with *
    have rx := Module.smul_mem at R, N, r, x with *
    have a0 := tensorMapPairs.value at R, M, N, M2, N2, f, g, r • v, x with *
    have a1 := tensorMapPairs.value at R, M, N, M2, N2, f, g, v, x with *
    have a2 := tensorMapPairs.value at R, M, N, M2, N2, f, g, v, r • x with *
    have fv := FunctionBetween.apply_closed with fF, hv
    have gx := FunctionBetween.apply_closed with gF, hx
    have l1 := LinearMap.smul_law with first, hr, hv
    have l2 := LinearMap.smul_law with second, hr, hx
    have t1 := tmul.smul_left at R, M2, N2, r, f(v), g(x) with ring, moduleM2, moduleN2, hr, fv, gx
    have t2 := tmul.smul_right at R, M2, N2, r, f(v), g(x) with ring, moduleM2, moduleN2, hr, fv, gx
    rw [a0, a1, a2, l1, l2, t2, t1]
    exact ⟨rfl, rfl⟩

-- TensorProduct.map and its laws.
theorem tensorMap.linear (M2 N2 f g : Set)
  requires first : LinearMap(f, M, R, M2)
  requires second : LinearMap(g, N, R, N2)
  shows LinearMap(tensorMap(f, g, M, N, M2, R, N2), tensorProduct(M, R, N), R,
    tensorProduct(M2, R, N2))
proof
  have bil := tensorMapPairs.bilinear at R, M, N, M2, N2, f, g with *
  unfold tensorMap
  exact tensorLift.linear at R, M, N, tensorProduct(M2, R, N2), tensorMapPairs(f, g, M, N, M2, R, N2) with *

theorem tensorMap.tmul (M2 N2 f g : Set) (m : M) (n : N)
  requires first : LinearMap(f, M, R, M2)
  requires second : LinearMap(g, N, R, N2)
  shows tensorMap(f, g, M, N, M2, R, N2)(tmul(M, R, N, m, n)) =
    tmul(M2, R, N2, f(m), g(n))
proof
  have hm : m ∈ M.carrier by assumption
  have hn : n ∈ N.carrier by assumption
  have bil := tensorMapPairs.bilinear at R, M, N, M2, N2, f, g with *
  have v := tensorMapPairs.value at R, M, N, M2, N2, f, g, m, n with *
  have l := tensorLift.tmul at R, M, N, tensorProduct(M2, R, N2), tensorMapPairs(f, g, M, N, M2, R, N2), m, n with ring, moduleM, moduleN, bil, hm, hn
  unfold tensorMap
  rw [l, v]

theorem tensorMap.identity
  shows tensorMap(identity(M.carrier), identity(N.carrier), M, N, M, R, N) =
    identity(Module.carrier(tensorProduct(M, R, N)))
proof
  have idM := LinearMap.identity at M, R with moduleM
  have idN := LinearMap.identity at N, R with moduleN
  have tp := tensorProduct.module at R, M, N with *
  have idT := LinearMap.identity at tensorProduct(M, R, N), R with tp
  have lin := tensorMap.linear at R, M, N, M, N, identity(M.carrier), identity(N.carrier) with ring, moduleM, moduleN, idM, idN
  apply tensorProduct.ext_pure at R, M, N, tensorProduct(M, R, N), tensorMap(identity(M.carrier), identity(N.carrier), M, N, M, R, N), identity(Module.carrier(tensorProduct(M, R, N))) with ring, moduleM, moduleN, lin, idT
  intros m hm n hn
  have t := tensorMap.tmul at R, M, N, M, N, identity(M.carrier), identity(N.carrier), m, n with ring, moduleM, moduleN, idM, idN, hm, hn
  have tIn := tmul.mem at R, M, N, m, n with *
  rw [t, identity.apply with hm, identity.apply with hn, identity.apply with tIn]

theorem tensorMap.compose (M2 N2 M3 N3 f g f2 g2 : Set)
  requires first : LinearMap(f, M, R, M2)
  requires second : LinearMap(g, N, R, N2)
  requires third : LinearMap(f2, M2, R, M3)
  requires fourth : LinearMap(g2, N2, R, N3)
  shows compose(tensorMap(f2, g2, M2, N2, M3, R, N3),
      tensorMap(f, g, M, N, M2, R, N2),
      Module.carrier(tensorProduct(M, R, N)),
      Module.carrier(tensorProduct(M2, R, N2)),
      Module.carrier(tensorProduct(M3, R, N3))) =
    tensorMap(compose(f2, f, M.carrier, Module.carrier(M2), Module.carrier(M3)),
      compose(g2, g, N.carrier, Module.carrier(N2), Module.carrier(N3)),
      M, N, M3, R, N3)
proof
  have moduleM2 := LinearMap.target_module with first
  have moduleN2 := LinearMap.target_module with second
  have moduleM3 := LinearMap.target_module with third
  have moduleN3 := LinearMap.target_module with fourth
  have l1 := tensorMap.linear at R, M, N, M2, N2, f, g with ring, moduleM, moduleN, first, second
  have l2 := tensorMap.linear at R, M2, N2, M3, N3, f2, g2 with ring, moduleM2, moduleN2, third, fourth
  have cf := LinearMap.compose at f, f2, M, R, M2, M3 with first, third
  have cg := LinearMap.compose at g, g2, N, R, N2, N3 with second, fourth
  have l3 := tensorMap.linear at R, M, N, M3, N3, compose(f2, f, M.carrier, Module.carrier(M2), Module.carrier(M3)), compose(g2, g, N.carrier, Module.carrier(N2), Module.carrier(N3)) with ring, moduleM, moduleN, cf, cg
  have l4 := LinearMap.compose at tensorMap(f, g, M, N, M2, R, N2), tensorMap(f2, g2, M2, N2, M3, R, N3), tensorProduct(M, R, N), R, tensorProduct(M2, R, N2), tensorProduct(M3, R, N3) with l1, l2
  apply tensorProduct.ext_pure at R, M, N, tensorProduct(M3, R, N3), compose(tensorMap(f2, g2, M2, N2, M3, R, N3), tensorMap(f, g, M, N, M2, R, N2), Module.carrier(tensorProduct(M, R, N)), Module.carrier(tensorProduct(M2, R, N2)), Module.carrier(tensorProduct(M3, R, N3))), tensorMap(compose(f2, f, M.carrier, Module.carrier(M2), Module.carrier(M3)), compose(g2, g, N.carrier, Module.carrier(N2), Module.carrier(N3)), M, N, M3, R, N3) with ring, moduleM, moduleN, l4, l3
  intros m hm n hn
  have fF := LinearMap.function_of with first
  have gF := LinearMap.function_of with second
  have f2F := LinearMap.function_of with third
  have g2F := LinearMap.function_of with fourth
  have t1F := LinearMap.function_of with l1
  have t2F := LinearMap.function_of with l2
  have tIn := tmul.mem at R, M, N, m, n with *
  have fm := FunctionBetween.apply_closed with fF, hm
  have gn := FunctionBetween.apply_closed with gF, hn
  have c0 := compose.apply at tensorMap(f2, g2, M2, N2, M3, R, N3), tensorMap(f, g, M, N, M2, R, N2), Module.carrier(tensorProduct(M, R, N)), Module.carrier(tensorProduct(M2, R, N2)), Module.carrier(tensorProduct(M3, R, N3)), tmul(M, R, N, m, n) with t1F, t2F, tIn
  have e1 := tensorMap.tmul at R, M, N, M2, N2, f, g, m, n with ring, moduleM, moduleN, first, second, hm, hn
  have e2 := tensorMap.tmul at R, M2, N2, M3, N3, f2, g2, f(m), g(n) with ring, moduleM2, moduleN2, third, fourth, fm, gn
  have e3 := tensorMap.tmul at R, M, N, M3, N3, compose(f2, f, M.carrier, Module.carrier(M2), Module.carrier(M3)), compose(g2, g, N.carrier, Module.carrier(N2), Module.carrier(N3)), m, n with ring, moduleM, moduleN, cf, cg, hm, hn
  have c1 := compose.apply at f2, f, M.carrier, Module.carrier(M2), Module.carrier(M3), m with fF, f2F, hm
  have c2 := compose.apply at g2, g, N.carrier, Module.carrier(N2), Module.carrier(N3), n with gF, g2F, hn
  rw [c0, e1, e2, e3, c1, c2]

-- LinearMap.lTensor_surjective and rTensor_surjective.
theorem leftTensor.surjective (N2 g : Set)
  requires linear : LinearMap(g, N, R, N2)
  requires surjective : SurjectiveBetween(g, N.carrier, Module.carrier(N2))
  shows SurjectiveBetween(leftTensor(M, R, N, N2, g),
    Module.carrier(tensorProduct(M, R, N)), Module.carrier(tensorProduct(M, R, N2)))
proof
  have moduleN2 := LinearMap.target_module with linear
  have ringR := CommRing.to_ring with ring
  have idM := LinearMap.identity at M, R with moduleM
  have lin := tensorMap.linear at R, M, N, M, N2, identity(M.carrier), g with ring, moduleM, moduleN, idM, linear
  have tp2 := tensorProduct.module at R, M, N2 with ring, moduleM, moduleN2
  have tp := tensorProduct.module at R, M, N with *
  have rangeSub := LinearMap.range_submodule at R, tensorProduct(M, R, N), tensorProduct(M, R, N2), tensorMap(identity(M.carrier), g, M, N, M, R, N2) with ringR, tp, tp2, lin
  have values : ∀ m ∈ M.carrier, ∀ n ∈ Module.carrier(N2), tmul(M, R, N2, m, n) ∈ Module.carrier(tensorProduct(M, R, N2))
    intros a ha b hb
    exact tmul.mem at R, M, N2, a, b with ring, moduleM, moduleN2, ha, hb
  have SSub := functionImage.subset at tensorMk(M, R, N2), M.carrier × Module.carrier(N2), Module.carrier(tensorProduct(M, R, N2))
  have inRange : functionImage(tensorMk(M, R, N2), M.carrier × Module.carrier(N2), Module.carrier(tensorProduct(M, R, N2))) ⊆ linearRange(tensorMap(identity(M.carrier), g, M, N, M, R, N2), tensorProduct(M, R, N), tensorProduct(M, R, N2))
    intros y hy
    obtain ⟨yIn, x, hx, yv⟩ := functionImage.membership.forward with hy
    obtain ⟨bound, a, ha, b, hb, shape⟩ := product.membership.forward with hx
    obtain ⟨n, hn, gn⟩ := Surjective.apply_exists with surjective, hb
    have mk := tensorMk.graph_entry at M, R, N2, a, b with values, ha, hb
    have t := tensorMap.tmul at R, M, N, M, N2, identity(M.carrier), g, a, n with ring, moduleM, moduleN, idM, linear, ha, hn
    have tIn := tmul.mem at R, M, N, a, n with *
    apply linearRange.membership.backward
    refine ⟨yIn, tmul(M, R, N, a, n), tIn, ?_⟩
    rw [t, identity.apply with ha, gn, yv, shape, mk]
  have spans := tensorProduct.span_pure at R, M, N2 with ring, moduleM, moduleN2
  have least := (moduleSpan.least_of at R, tensorProduct(M, R, N2), functionImage(tensorMk(M, R, N2), M.carrier × Module.carrier(N2), Module.carrier(tensorProduct(M, R, N2))), linearRange(tensorMap(identity(M.carrier), g, M, N, M, R, N2), tensorProduct(M, R, N), tensorProduct(M, R, N2)) with ringR, tp2, SSub, rangeSub).backward with inRange
  rw spans at least
  have full : linearRange(tensorMap(identity(M.carrier), g, M, N, M, R, N2), tensorProduct(M, R, N), tensorProduct(M, R, N2)) = Module.carrier(tensorProduct(M, R, N2))
    apply Subset.antisymmetric
    . exact SubmoduleOf.subset at R, tensorProduct(M, R, N2), linearRange(tensorMap(identity(M.carrier), g, M, N, M, R, N2), tensorProduct(M, R, N), tensorProduct(M, R, N2)) with ringR, tp2, rangeSub
    . exact least
  unfold leftTensor
  exact (LinearMap.surjective_iff_range at R, tensorProduct(M, R, N), tensorProduct(M, R, N2), tensorMap(identity(M.carrier), g, M, N, M, R, N2) with ringR, tp, tp2, lin).backward with full

theorem rightTensor.surjective (M2 f : Set)
  requires linear : LinearMap(f, M, R, M2)
  requires surjective : SurjectiveBetween(f, M.carrier, Module.carrier(M2))
  shows SurjectiveBetween(rightTensor(M, R, N, M2, f),
    Module.carrier(tensorProduct(M, R, N)), Module.carrier(tensorProduct(M2, R, N)))
proof
  have moduleM2 := LinearMap.target_module with linear
  have ringR := CommRing.to_ring with ring
  have idN := LinearMap.identity at N, R with moduleN
  have lin := tensorMap.linear at R, M, N, M2, N, f, identity(N.carrier) with ring, moduleM, moduleN, linear, idN
  have tp2 := tensorProduct.module at R, M2, N with ring, moduleM2, moduleN
  have tp := tensorProduct.module at R, M, N with *
  have rangeSub := LinearMap.range_submodule at R, tensorProduct(M, R, N), tensorProduct(M2, R, N), tensorMap(f, identity(N.carrier), M, N, M2, R, N) with ringR, tp, tp2, lin
  have values : ∀ m ∈ Module.carrier(M2), ∀ n ∈ N.carrier, tmul(M2, R, N, m, n) ∈ Module.carrier(tensorProduct(M2, R, N))
    intros a ha b hb
    exact tmul.mem at R, M2, N, a, b with ring, moduleM2, moduleN, ha, hb
  have SSub := functionImage.subset at tensorMk(M2, R, N), Module.carrier(M2) × N.carrier, Module.carrier(tensorProduct(M2, R, N))
  have inRange : functionImage(tensorMk(M2, R, N), Module.carrier(M2) × N.carrier, Module.carrier(tensorProduct(M2, R, N))) ⊆ linearRange(tensorMap(f, identity(N.carrier), M, N, M2, R, N), tensorProduct(M, R, N), tensorProduct(M2, R, N))
    intros y hy
    obtain ⟨yIn, x, hx, yv⟩ := functionImage.membership.forward with hy
    obtain ⟨bound, a, ha, b, hb, shape⟩ := product.membership.forward with hx
    obtain ⟨m, hm, fm⟩ := Surjective.apply_exists with surjective, ha
    have mk := tensorMk.graph_entry at M2, R, N, a, b with values, ha, hb
    have t := tensorMap.tmul at R, M, N, M2, N, f, identity(N.carrier), m, b with ring, moduleM, moduleN, linear, idN, hm, hb
    have tIn := tmul.mem at R, M, N, m, b with *
    apply linearRange.membership.backward
    refine ⟨yIn, tmul(M, R, N, m, b), tIn, ?_⟩
    rw [t, identity.apply with hb, fm, yv, shape, mk]
  have spans := tensorProduct.span_pure at R, M2, N with ring, moduleM2, moduleN
  have least := (moduleSpan.least_of at R, tensorProduct(M2, R, N), functionImage(tensorMk(M2, R, N), Module.carrier(M2) × N.carrier, Module.carrier(tensorProduct(M2, R, N))), linearRange(tensorMap(f, identity(N.carrier), M, N, M2, R, N), tensorProduct(M, R, N), tensorProduct(M2, R, N)) with ringR, tp2, SSub, rangeSub).backward with inRange
  rw spans at least
  have full : linearRange(tensorMap(f, identity(N.carrier), M, N, M2, R, N), tensorProduct(M, R, N), tensorProduct(M2, R, N)) = Module.carrier(tensorProduct(M2, R, N))
    apply Subset.antisymmetric
    . exact SubmoduleOf.subset at R, tensorProduct(M2, R, N), linearRange(tensorMap(f, identity(N.carrier), M, N, M2, R, N), tensorProduct(M, R, N), tensorProduct(M2, R, N)) with ringR, tp2, rangeSub
    . exact least
  unfold rightTensor
  exact (LinearMap.surjective_iff_range at R, tensorProduct(M, R, N), tensorProduct(M2, R, N), tensorMap(f, identity(N.carrier), M, N, M2, R, N) with ringR, tp, tp2, lin).backward with full

theorem tensorSwapPairs.value (m n : Set)
  requires hm : m ∈ M.carrier
  requires hn : n ∈ N.carrier
  shows tensorSwapPairs(M, R, N)((m, n)) = tmul(N, R, M, n, m)
proof
  have values : ∀ a ∈ M.carrier, ∀ b ∈ N.carrier, tmul(N, R, M, b, a) ∈ Module.carrier(tensorProduct(N, R, M))
    intros a ha b hb
    exact tmul.mem at R, N, M, b, a with ring, moduleN, moduleM, hb, ha
  exact tensorSwapPairs.graph_entry at M, R, N, m, n with values, hm, hn

theorem tensorSwapPairs.bilinear
  shows BilinearMap(tensorSwapPairs(M, R, N), M, N, tensorProduct(N, R, M), R)
proof
  have tp := tensorProduct.module at R, N, M with ring, moduleN, moduleM
  have values : ∀ a ∈ M.carrier, ∀ b ∈ N.carrier, tmul(N, R, M, b, a) ∈ Module.carrier(tensorProduct(N, R, M))
    intros a ha b hb
    exact tmul.mem at R, N, M, b, a with ring, moduleN, moduleM, hb, ha
  have function := tensorSwapPairs.graph_function at M, R, N with values
  unfold BilinearMap
  refine ⟨moduleM, moduleN, tp, function, ?_, ?_, ?_⟩
  . intros v hv w hw x hx
    have vw := Module.add_mem at R, M, v, w with *
    have a0 := tensorSwapPairs.value at R, M, N, v + w, x with *
    have a1 := tensorSwapPairs.value at R, M, N, v, x with *
    have a2 := tensorSwapPairs.value at R, M, N, w, x with *
    have t := tmul.add_right at R, N, M, x, v, w with ring, moduleN, moduleM, hx, hv, hw
    rw [a0, a1, a2, t]
  . intros v hv x hx y hy
    have xy := Module.add_mem at R, N, x, y with *
    have a0 := tensorSwapPairs.value at R, M, N, v, x + y with *
    have a1 := tensorSwapPairs.value at R, M, N, v, x with *
    have a2 := tensorSwapPairs.value at R, M, N, v, y with *
    have t := tmul.add_left at R, N, M, x, y, v with ring, moduleN, moduleM, hx, hy, hv
    rw [a0, a1, a2, t]
  . intros r hr v hv x hx
    have rv := Module.smul_mem at R, M, r, v with *
    have rx := Module.smul_mem at R, N, r, x with *
    have a0 := tensorSwapPairs.value at R, M, N, r • v, x with *
    have a1 := tensorSwapPairs.value at R, M, N, v, x with *
    have a2 := tensorSwapPairs.value at R, M, N, v, r • x with *
    have t1 := tmul.smul_left at R, N, M, r, x, v with ring, moduleN, moduleM, hr, hx, hv
    have t2 := tmul.smul_right at R, N, M, r, x, v with ring, moduleN, moduleM, hr, hx, hv
    rw [a0, a1, a2, t2, t1]
    exact ⟨rfl, rfl⟩

theorem tensorSwap.parts
  shows LinearMap(tensorSwap(M, R, N), tensorProduct(M, R, N), R, tensorProduct(N, R, M)) ∧
    (∀ m ∈ M.carrier, ∀ n ∈ N.carrier,
      tensorSwap(M, R, N)(tmul(M, R, N, m, n)) = tmul(N, R, M, n, m))
proof
  have bil := tensorSwapPairs.bilinear at R, M, N with *
  obtain ⟨lin, val⟩ := tensorLift.parts at R, M, N, tensorProduct(N, R, M), tensorSwapPairs(M, R, N) with ring, moduleM, moduleN, bil
  unfold tensorSwap
  refine ⟨lin, ?_⟩
  intros m hm n hn
  have v := val with m, hm, n, hn
  have p := tensorSwapPairs.value at R, M, N, m, n with *
  rw [v, p]

theorem tensorSwap.involutive (t : Set)
  requires member : t ∈ Module.carrier(tensorProduct(M, R, N))
  shows tensorSwap(N, R, M)(tensorSwap(M, R, N)(t)) = t
proof
  obtain ⟨l1, v1⟩ := tensorSwap.parts at R, M, N with *
  obtain ⟨l2, v2⟩ := tensorSwap.parts at R, N, M with ring, moduleN, moduleM
  have tp := tensorProduct.module at R, M, N with *
  have idT := LinearMap.identity at tensorProduct(M, R, N), R with tp
  have c := LinearMap.compose at tensorSwap(M, R, N), tensorSwap(N, R, M), tensorProduct(M, R, N), R, tensorProduct(N, R, M), tensorProduct(M, R, N) with l1, l2
  have f1 := LinearMap.function_of with l1
  have f2 := LinearMap.function_of with l2
  have agree : ∀ m ∈ M.carrier, ∀ n ∈ N.carrier, compose(tensorSwap(N, R, M), tensorSwap(M, R, N), Module.carrier(tensorProduct(M, R, N)), Module.carrier(tensorProduct(N, R, M)), Module.carrier(tensorProduct(M, R, N)))(tmul(M, R, N, m, n)) = identity(Module.carrier(tensorProduct(M, R, N)))(tmul(M, R, N, m, n))
    intros m hm n hn
    have tIn := tmul.mem at R, M, N, m, n with *
    have c0 := compose.apply at tensorSwap(N, R, M), tensorSwap(M, R, N), Module.carrier(tensorProduct(M, R, N)), Module.carrier(tensorProduct(N, R, M)), Module.carrier(tensorProduct(M, R, N)), tmul(M, R, N, m, n) with f1, f2, tIn
    have a := v1 with m, hm, n, hn
    have b := v2 with n, hn, m, hm
    rw [c0, a, b, identity.apply with tIn]
  have same := tensorProduct.ext_pure at R, M, N, tensorProduct(M, R, N), compose(tensorSwap(N, R, M), tensorSwap(M, R, N), Module.carrier(tensorProduct(M, R, N)), Module.carrier(tensorProduct(N, R, M)), Module.carrier(tensorProduct(M, R, N))), identity(Module.carrier(tensorProduct(M, R, N))) with ring, moduleM, moduleN, c, idT, agree
  have c0 := compose.apply at tensorSwap(N, R, M), tensorSwap(M, R, N), Module.carrier(tensorProduct(M, R, N)), Module.carrier(tensorProduct(N, R, M)), Module.carrier(tensorProduct(M, R, N)), t with f1, f2, member
  rw [← c0, same, identity.apply with member]

theorem leftTensor.parts (N2 g : Set)
  requires linear : LinearMap(g, N, R, N2)
  shows LinearMap(leftTensor(M, R, N, N2, g), tensorProduct(M, R, N), R, tensorProduct(M, R, N2)) ∧
    (∀ m ∈ M.carrier, ∀ n ∈ N.carrier,
      leftTensor(M, R, N, N2, g)(tmul(M, R, N, m, n)) = tmul(M, R, N2, m, g(n)))
proof
  have idM := LinearMap.identity at M, R with moduleM
  have lin := tensorMap.linear at R, M, N, M, N2, identity(M.carrier), g with ring, moduleM, moduleN, idM, linear
  unfold leftTensor
  refine ⟨lin, ?_⟩
  intros m hm n hn
  have t := tensorMap.tmul at R, M, N, M, N2, identity(M.carrier), g, m, n with ring, moduleM, moduleN, idM, linear, hm, hn
  rw [t, identity.apply with hm]

theorem exactLiftPairs.difference (N1 N2 f g m n n2 : Set)
  requires first : LinearMap(f, N1, R, N)
  requires second : LinearMap(g, N, R, N2)
  requires exact : ExactPair(f, g, N1, N, N2)
  requires surjective : SurjectiveBetween(g, N.carrier, Module.carrier(N2))
  requires hm : m ∈ M.carrier
  requires hn : n ∈ N.carrier
  requires hn2 : n2 ∈ N.carrier
  requires same : g(n) = g(n2)
  shows quotientModuleMap(tensorProduct(M, R, N), linearRange(leftTensor(M, R, N1, N, f), tensorProduct(M, R, N1), tensorProduct(M, R, N)))(tmul(M, R, N, m, n)) = quotientModuleMap(tensorProduct(M, R, N), linearRange(leftTensor(M, R, N1, N, f), tensorProduct(M, R, N1), tensorProduct(M, R, N)))(tmul(M, R, N, m, n2))
proof
  have ringR := CommRing.to_ring with ring
  have moduleN1 := LinearMap.source_module with first
  have moduleN2 := LinearMap.target_module with second
  have tp1 := tensorProduct.module at R, M, N1 with ring, moduleM, moduleN1
  have tp := tensorProduct.module at R, M, N with *
  have tp2 := tensorProduct.module at R, M, N2 with ring, moduleM, moduleN2
  obtain ⟨linF, valF⟩ := leftTensor.parts at R, M, N1, N, f with ring, moduleM, moduleN1, first
  obtain ⟨linG, valG⟩ := leftTensor.parts at R, M, N, N2, g with *
  have subW := LinearMap.range_submodule at R, tensorProduct(M, R, N1), tensorProduct(M, R, N), leftTensor(M, R, N1, N, f) with ringR, tp1, tp, linF
  have linPi := SubmoduleOf.quotient_map_linear at R, tensorProduct(M, R, N), linearRange(leftTensor(M, R, N1, N, f), tensorProduct(M, R, N1), tensorProduct(M, R, N)) with ringR, tp, subW
  have moduleQ := SubmoduleOf.quotient_module at R, tensorProduct(M, R, N), linearRange(leftTensor(M, R, N1, N, f), tensorProduct(M, R, N1), tensorProduct(M, R, N)) with ringR, tp, subW
  have t1 := tmul.mem at R, M, N, m, n with *
  have t2 := tmul.mem at R, M, N, m, n2 with ring, moduleM, moduleN, hm, hn2
  apply (SubmoduleOf.quotient_eq at R, tensorProduct(M, R, N), linearRange(leftTensor(M, R, N1, N, f), tensorProduct(M, R, N1), tensorProduct(M, R, N)), tmul(M, R, N, m, n), tmul(M, R, N, m, n2) with ringR, tp, subW, t1, t2).backward
  have nn2 := Module.neg_mem at R, N, n2 with ringR, moduleN, hn2
  have dIn := Module.add_mem at R, N, n, apply(Module.neg(N), n2) with ringR, moduleN, hn, nn2
  have e1 := tmul.add_right at R, M, N, m, n, apply(Module.neg(N), n2) with ring, moduleM, moduleN, hm, hn, nn2
  have e2 := tmul.neg_right at R, M, N, m, n2 with ring, moduleM, moduleN, hm, hn2
  rw [e2] at e1
  rw ← e1
  have gd := LinearMap.add_law with second, hn, nn2
  have gn := LinearMap.neg_law at R, N, N2, g, n2 with ringR, second, hn2
  have gn1 := LinearMap.value_mem with second, hn
  have cancel := Module.add_neg at R, N2, g(n) with ringR, moduleN2, gn1
  rw [gn, ← same, cancel] at gd
  have inKer : call2(Module.add(N), n, apply(Module.neg(N), n2)) ∈ linearKernel(g, N, N2)
    apply linearKernel.membership.backward
    exact ⟨dIn, gd⟩
  unfold ExactPair at exact
  rw ← exact at inKer
  obtain ⟨_, k, hk, fk⟩ := linearRange.membership.forward with inKer
  have tk := tmul.mem at R, M, N1, m, k with ring, moduleM, moduleN1, hm, hk
  have Fk := valF with m, hm, k, hk
  rw fk at Fk
  have dd := tmul.mem at R, M, N, m, call2(Module.add(N), n, apply(Module.neg(N), n2)) with ring, moduleM, moduleN, hm, dIn
  apply linearRange.membership.backward
  exact ⟨dd, tmul(M, R, N1, m, k), tk, Fk⟩

theorem exactLiftPairs.function (N1 N2 f g : Set)
  requires first : LinearMap(f, N1, R, N)
  requires second : LinearMap(g, N, R, N2)
  requires exact : ExactPair(f, g, N1, N, N2)
  requires surjective : SurjectiveBetween(g, N.carrier, Module.carrier(N2))
  shows exactLiftPairs(M, R, N, N2, g, linearRange(leftTensor(M, R, N1, N, f), tensorProduct(M, R, N1), tensorProduct(M, R, N))) : M.carrier × Module.carrier(N2) → Module.carrier(quotientModule(tensorProduct(M, R, N), R, linearRange(leftTensor(M, R, N1, N, f), tensorProduct(M, R, N1), tensorProduct(M, R, N))))
proof
  have ringR := CommRing.to_ring with ring
  have moduleN1 := LinearMap.source_module with first
  have moduleN2 := LinearMap.target_module with second
  have tp1 := tensorProduct.module at R, M, N1 with ring, moduleM, moduleN1
  have tp := tensorProduct.module at R, M, N with *
  have tp2 := tensorProduct.module at R, M, N2 with ring, moduleM, moduleN2
  obtain ⟨linF, valF⟩ := leftTensor.parts at R, M, N1, N, f with ring, moduleM, moduleN1, first
  obtain ⟨linG, valG⟩ := leftTensor.parts at R, M, N, N2, g with *
  have subW := LinearMap.range_submodule at R, tensorProduct(M, R, N1), tensorProduct(M, R, N), leftTensor(M, R, N1, N, f) with ringR, tp1, tp, linF
  have linPi := SubmoduleOf.quotient_map_linear at R, tensorProduct(M, R, N), linearRange(leftTensor(M, R, N1, N, f), tensorProduct(M, R, N1), tensorProduct(M, R, N)) with ringR, tp, subW
  have moduleQ := SubmoduleOf.quotient_module at R, tensorProduct(M, R, N), linearRange(leftTensor(M, R, N1, N, f), tensorProduct(M, R, N1), tensorProduct(M, R, N)) with ringR, tp, subW
  constructor
    intros q0 member
    obtain ⟨bounded, witnesses⟩ := exactLiftPairs.membership.forward with member
    exact bounded
  . constructor
      intros z0 a0 xFirst b0 xSecond
      unfold relates at xFirst
      obtain ⟨_, m1, hm1, n1, hn1, s1⟩ := exactLiftPairs.membership.forward with xFirst
      unfold relates at xSecond
      obtain ⟨_, m2, hm2, n2, hn2, s2⟩ := exactLiftPairs.membership.forward with xSecond
      obtain ⟨z1, v1⟩ := orderedPair.injective with s1
      obtain ⟨z2, v2⟩ := orderedPair.injective with s2
      rw z1 at z2
      obtain ⟨mm, gg⟩ := orderedPair.injective with z2
      have d := exactLiftPairs.difference at R, M, N, N1, N2, f, g, m1, n1, n2 with ring, moduleM, moduleN, first, second, exact, surjective, hm1, hn1, hn2, gg
      rw [v1, v2, ← mm, d]
    . intros q0 pIn
      obtain ⟨bound, m, hm, x, hx, shape⟩ := product.membership.forward with pIn
      obtain ⟨n, hn, gn⟩ := Surjective.apply_exists with surjective, hx
      have t := tmul.mem at R, M, N, m, n with *
      have valIn := LinearMap.value_mem with linPi, t
      have gnIn := LinearMap.value_mem with second, hn
      have pair := product.pair at m, g(n), M.carrier, Module.carrier(N2) with hm, gnIn
      have outer := product.pair at (m, g(n)), quotientModuleMap(tensorProduct(M, R, N), linearRange(leftTensor(M, R, N1, N, f), tensorProduct(M, R, N1), tensorProduct(M, R, N)))(tmul(M, R, N, m, n)), M.carrier × Module.carrier(N2), Module.carrier(quotientModule(tensorProduct(M, R, N), R, linearRange(leftTensor(M, R, N1, N, f), tensorProduct(M, R, N1), tensorProduct(M, R, N)))) with pair, valIn
      have rel : relates(exactLiftPairs(M, R, N, N2, g, linearRange(leftTensor(M, R, N1, N, f), tensorProduct(M, R, N1), tensorProduct(M, R, N))), (m, g(n)), quotientModuleMap(tensorProduct(M, R, N), linearRange(leftTensor(M, R, N1, N, f), tensorProduct(M, R, N1), tensorProduct(M, R, N)))(tmul(M, R, N, m, n)))
        unfold relates
        apply exactLiftPairs.membership.backward
        exact ⟨outer, m, hm, n, hn, rfl⟩
      rw [shape, ← gn]
      exact ⟨quotientModuleMap(tensorProduct(M, R, N), linearRange(leftTensor(M, R, N1, N, f), tensorProduct(M, R, N1), tensorProduct(M, R, N)))(tmul(M, R, N, m, n)), valIn, rel⟩

theorem exactLiftPairs.value (N1 N2 f g m n : Set)
  requires first : LinearMap(f, N1, R, N)
  requires second : LinearMap(g, N, R, N2)
  requires exact : ExactPair(f, g, N1, N, N2)
  requires surjective : SurjectiveBetween(g, N.carrier, Module.carrier(N2))
  requires hm : m ∈ M.carrier
  requires hn : n ∈ N.carrier
  shows exactLiftPairs(M, R, N, N2, g, linearRange(leftTensor(M, R, N1, N, f), tensorProduct(M, R, N1), tensorProduct(M, R, N)))((m, g(n))) = quotientModuleMap(tensorProduct(M, R, N), linearRange(leftTensor(M, R, N1, N, f), tensorProduct(M, R, N1), tensorProduct(M, R, N)))(tmul(M, R, N, m, n))
proof
  have ringR := CommRing.to_ring with ring
  have moduleN1 := LinearMap.source_module with first
  have moduleN2 := LinearMap.target_module with second
  have tp1 := tensorProduct.module at R, M, N1 with ring, moduleM, moduleN1
  have tp := tensorProduct.module at R, M, N with *
  have tp2 := tensorProduct.module at R, M, N2 with ring, moduleM, moduleN2
  obtain ⟨linF, valF⟩ := leftTensor.parts at R, M, N1, N, f with ring, moduleM, moduleN1, first
  obtain ⟨linG, valG⟩ := leftTensor.parts at R, M, N, N2, g with *
  have subW := LinearMap.range_submodule at R, tensorProduct(M, R, N1), tensorProduct(M, R, N), leftTensor(M, R, N1, N, f) with ringR, tp1, tp, linF
  have linPi := SubmoduleOf.quotient_map_linear at R, tensorProduct(M, R, N), linearRange(leftTensor(M, R, N1, N, f), tensorProduct(M, R, N1), tensorProduct(M, R, N)) with ringR, tp, subW
  have moduleQ := SubmoduleOf.quotient_module at R, tensorProduct(M, R, N), linearRange(leftTensor(M, R, N1, N, f), tensorProduct(M, R, N1), tensorProduct(M, R, N)) with ringR, tp, subW
  have function := exactLiftPairs.function at R, M, N, N1, N2, f, g with ring, moduleM, moduleN, first, second, exact, surjective
  have t := tmul.mem at R, M, N, m, n with *
  have valIn := LinearMap.value_mem with linPi, t
  have gnIn := LinearMap.value_mem with second, hn
  have pair := product.pair at m, g(n), M.carrier, Module.carrier(N2) with hm, gnIn
  have outer := product.pair at (m, g(n)), quotientModuleMap(tensorProduct(M, R, N), linearRange(leftTensor(M, R, N1, N, f), tensorProduct(M, R, N1), tensorProduct(M, R, N)))(tmul(M, R, N, m, n)), M.carrier × Module.carrier(N2), Module.carrier(quotientModule(tensorProduct(M, R, N), R, linearRange(leftTensor(M, R, N1, N, f), tensorProduct(M, R, N1), tensorProduct(M, R, N)))) with pair, valIn
  have rel : relates(exactLiftPairs(M, R, N, N2, g, linearRange(leftTensor(M, R, N1, N, f), tensorProduct(M, R, N1), tensorProduct(M, R, N))), (m, g(n)), quotientModuleMap(tensorProduct(M, R, N), linearRange(leftTensor(M, R, N1, N, f), tensorProduct(M, R, N1), tensorProduct(M, R, N)))(tmul(M, R, N, m, n)))
    unfold relates
    apply exactLiftPairs.membership.backward
    exact ⟨outer, m, hm, n, hn, rfl⟩
  exact FunctionBetween.apply_value with function, pair, rel

theorem exactLiftPairs.bilinear (N1 N2 f g : Set)
  requires first : LinearMap(f, N1, R, N)
  requires second : LinearMap(g, N, R, N2)
  requires exact : ExactPair(f, g, N1, N, N2)
  requires surjective : SurjectiveBetween(g, N.carrier, Module.carrier(N2))
  shows BilinearMap(exactLiftPairs(M, R, N, N2, g, linearRange(leftTensor(M, R, N1, N, f), tensorProduct(M, R, N1), tensorProduct(M, R, N))), M, N2, quotientModule(tensorProduct(M, R, N), R, linearRange(leftTensor(M, R, N1, N, f), tensorProduct(M, R, N1), tensorProduct(M, R, N))), R)
proof
  have ringR := CommRing.to_ring with ring
  have moduleN1 := LinearMap.source_module with first
  have moduleN2 := LinearMap.target_module with second
  have tp1 := tensorProduct.module at R, M, N1 with ring, moduleM, moduleN1
  have tp := tensorProduct.module at R, M, N with *
  have tp2 := tensorProduct.module at R, M, N2 with ring, moduleM, moduleN2
  obtain ⟨linF, valF⟩ := leftTensor.parts at R, M, N1, N, f with ring, moduleM, moduleN1, first
  obtain ⟨linG, valG⟩ := leftTensor.parts at R, M, N, N2, g with *
  have subW := LinearMap.range_submodule at R, tensorProduct(M, R, N1), tensorProduct(M, R, N), leftTensor(M, R, N1, N, f) with ringR, tp1, tp, linF
  have linPi := SubmoduleOf.quotient_map_linear at R, tensorProduct(M, R, N), linearRange(leftTensor(M, R, N1, N, f), tensorProduct(M, R, N1), tensorProduct(M, R, N)) with ringR, tp, subW
  have moduleQ := SubmoduleOf.quotient_module at R, tensorProduct(M, R, N), linearRange(leftTensor(M, R, N1, N, f), tensorProduct(M, R, N1), tensorProduct(M, R, N)) with ringR, tp, subW
  have function := exactLiftPairs.function at R, M, N, N1, N2, f, g with ring, moduleM, moduleN, first, second, exact, surjective
  unfold BilinearMap
  refine ⟨moduleM, moduleN2, moduleQ, function, ?_, ?_, ?_⟩
  . intros v hv w hw x hx
    obtain ⟨n, hn, gn⟩ := Surjective.apply_exists with surjective, hx
    rw ← gn
    have vw := Module.add_mem at R, M, v, w with ringR, moduleM, hv, hw
    have e1 := exactLiftPairs.value at R, M, N, N1, N2, f, g, call2(Module.add(M), v, w), n with ring, moduleM, moduleN, first, second, exact, surjective, vw, hn
    have e2 := exactLiftPairs.value at R, M, N, N1, N2, f, g, v, n with ring, moduleM, moduleN, first, second, exact, surjective, hv, hn
    have e3 := exactLiftPairs.value at R, M, N, N1, N2, f, g, w, n with ring, moduleM, moduleN, first, second, exact, surjective, hw, hn
    have t := tmul.add_left at R, M, N, v, w, n with ring, moduleM, moduleN, hv, hw, hn
    have tv := tmul.mem at R, M, N, v, n with ring, moduleM, moduleN, hv, hn
    have tw := tmul.mem at R, M, N, w, n with ring, moduleM, moduleN, hw, hn
    have a := LinearMap.add_law with linPi, tv, tw
    rw [e1, e2, e3, t, a]
  . intros v hv x hx y hy
    obtain ⟨n, hn, gn⟩ := Surjective.apply_exists with surjective, hx
    obtain ⟨n2, hn2, gn2⟩ := Surjective.apply_exists with surjective, hy
    have nn := Module.add_mem at R, N, n, n2 with ringR, moduleN, hn, hn2
    have ga := LinearMap.add_law with second, hn, hn2
    rw [← gn, ← gn2, ← ga]
    have e1 := exactLiftPairs.value at R, M, N, N1, N2, f, g, v, call2(Module.add(N), n, n2) with ring, moduleM, moduleN, first, second, exact, surjective, hv, nn
    have e2 := exactLiftPairs.value at R, M, N, N1, N2, f, g, v, n with ring, moduleM, moduleN, first, second, exact, surjective, hv, hn
    have e3 := exactLiftPairs.value at R, M, N, N1, N2, f, g, v, n2 with ring, moduleM, moduleN, first, second, exact, surjective, hv, hn2
    have t := tmul.add_right at R, M, N, v, n, n2 with ring, moduleM, moduleN, hv, hn, hn2
    have tv := tmul.mem at R, M, N, v, n with ring, moduleM, moduleN, hv, hn
    have tw := tmul.mem at R, M, N, v, n2 with ring, moduleM, moduleN, hv, hn2
    have a := LinearMap.add_law with linPi, tv, tw
    rw [e1, e2, e3, t, a]
  . intros r hr v hv x hx
    obtain ⟨n, hn, gn⟩ := Surjective.apply_exists with surjective, hx
    have rn := Module.smul_mem at R, N, r, n with ringR, moduleN, hr, hn
    have rv := Module.smul_mem at R, M, r, v with ringR, moduleM, hr, hv
    have gs := LinearMap.smul_law with second, hr, hn
    rw [← gn, ← gs]
    have e1 := exactLiftPairs.value at R, M, N, N1, N2, f, g, call2(Module.smul(M), r, v), n with ring, moduleM, moduleN, first, second, exact, surjective, rv, hn
    have e2 := exactLiftPairs.value at R, M, N, N1, N2, f, g, v, n with ring, moduleM, moduleN, first, second, exact, surjective, hv, hn
    have e3 := exactLiftPairs.value at R, M, N, N1, N2, f, g, v, call2(Module.smul(N), r, n) with ring, moduleM, moduleN, first, second, exact, surjective, hv, rn
    have t1 := tmul.smul_left at R, M, N, r, v, n with ring, moduleM, moduleN, hr, hv, hn
    have t2 := tmul.smul_right at R, M, N, r, v, n with ring, moduleM, moduleN, hr, hv, hn
    have tv := tmul.mem at R, M, N, v, n with ring, moduleM, moduleN, hv, hn
    have s := LinearMap.smul_law with linPi, hr, tv
    rw [e1, e2, e3, t2, t1, s]
    exact ⟨rfl, rfl⟩

-- lTensor_exact: tensoring with M is right exact. For N1 →f N →g N2 → 0
-- exact, M ⊗ N1 → M ⊗ N → M ⊗ N2 → 0 is exact.
theorem leftTensor.exact (N1 N2 f g : Set)
  requires first : LinearMap(f, N1, R, N)
  requires second : LinearMap(g, N, R, N2)
  requires exact : ExactPair(f, g, N1, N, N2)
  requires surjective : SurjectiveBetween(g, N.carrier, Module.carrier(N2))
  shows ExactPair(leftTensor(M, R, N1, N, f), leftTensor(M, R, N, N2, g),
    tensorProduct(M, R, N1), tensorProduct(M, R, N), tensorProduct(M, R, N2))
proof
  have ringR := CommRing.to_ring with ring
  have moduleN1 := LinearMap.source_module with first
  have moduleN2 := LinearMap.target_module with second
  have tp1 := tensorProduct.module at R, M, N1 with ring, moduleM, moduleN1
  have tp := tensorProduct.module at R, M, N with *
  have tp2 := tensorProduct.module at R, M, N2 with ring, moduleM, moduleN2
  obtain ⟨linF, valF⟩ := leftTensor.parts at R, M, N1, N, f with ring, moduleM, moduleN1, first
  obtain ⟨linG, valG⟩ := leftTensor.parts at R, M, N, N2, g with *
  have subW := LinearMap.range_submodule at R, tensorProduct(M, R, N1), tensorProduct(M, R, N), leftTensor(M, R, N1, N, f) with ringR, tp1, tp, linF
  have linPi := SubmoduleOf.quotient_map_linear at R, tensorProduct(M, R, N), linearRange(leftTensor(M, R, N1, N, f), tensorProduct(M, R, N1), tensorProduct(M, R, N)) with ringR, tp, subW
  have moduleQ := SubmoduleOf.quotient_module at R, tensorProduct(M, R, N), linearRange(leftTensor(M, R, N1, N, f), tensorProduct(M, R, N1), tensorProduct(M, R, N)) with ringR, tp, subW
  have zeroT2 := Module.zero_mem at R, tensorProduct(M, R, N2) with ringR, tp2
  unfold ExactPair
  ext t
  constructor
  . intro ht
    obtain ⟨tIn, t1, ht1, Ft1⟩ := linearRange.membership.forward with ht
    have comp := LinearMap.compose at leftTensor(M, R, N1, N, f), leftTensor(M, R, N, N2, g), tensorProduct(M, R, N1), R, tensorProduct(M, R, N), tensorProduct(M, R, N2) with linF, linG
    have kerSub := LinearMap.kernel_submodule at R, tensorProduct(M, R, N1), tensorProduct(M, R, N2), compose(leftTensor(M, R, N, N2, g), leftTensor(M, R, N1, N, f), Module.carrier(tensorProduct(M, R, N1)), Module.carrier(tensorProduct(M, R, N)), Module.carrier(tensorProduct(M, R, N2))) with ringR, tp1, tp2, comp
    have fF := LinearMap.function_of with linF
    have gF := LinearMap.function_of with linG
    have values : ∀ m ∈ M.carrier, ∀ n ∈ Module.carrier(N1), tmul(M, R, N1, m, n) ∈ Module.carrier(tensorProduct(M, R, N1))
      intros a ha b hb
      exact tmul.mem at R, M, N1, a, b with ring, moduleM, moduleN1, ha, hb
    have SSub := functionImage.subset at tensorMk(M, R, N1), M.carrier × Module.carrier(N1), Module.carrier(tensorProduct(M, R, N1))
    have pureIn : functionImage(tensorMk(M, R, N1), M.carrier × Module.carrier(N1), Module.carrier(tensorProduct(M, R, N1))) ⊆ linearKernel(compose(leftTensor(M, R, N, N2, g), leftTensor(M, R, N1, N, f), Module.carrier(tensorProduct(M, R, N1)), Module.carrier(tensorProduct(M, R, N)), Module.carrier(tensorProduct(M, R, N2))), tensorProduct(M, R, N1), tensorProduct(M, R, N2))
      intros y hy
      obtain ⟨yIn, x, hx, yv⟩ := functionImage.membership.forward with hy
      obtain ⟨bound, a, ha, b, hb, shape⟩ := product.membership.forward with hx
      have mk := tensorMk.graph_entry at M, R, N1, a, b with values, ha, hb
      apply linearKernel.membership.backward
      refine ⟨yIn, ?_⟩
      rw [yv, shape, mk]
      have tIn1 := tmul.mem at R, M, N1, a, b with ring, moduleM, moduleN1, ha, hb
      have c0 := compose.apply at leftTensor(M, R, N, N2, g), leftTensor(M, R, N1, N, f), Module.carrier(tensorProduct(M, R, N1)), Module.carrier(tensorProduct(M, R, N)), Module.carrier(tensorProduct(M, R, N2)), tmul(M, R, N1, a, b) with fF, gF, tIn1
      have fb := LinearMap.value_mem with first, hb
      have v1 := valF with a, ha, b, hb
      have v2 := valG with a, ha, f(b), fb
      have rangeIn : f(b) ∈ linearRange(f, N1, N)
        apply linearRange.membership.backward
        exact ⟨fb, b, hb, rfl⟩
      unfold ExactPair at exact
      rw exact at rangeIn
      obtain ⟨_, gfb⟩ := linearKernel.membership.forward with rangeIn
      have z := tmul.zero_right at R, M, N2, a with ring, moduleM, moduleN2, ha
      rw [c0, v1, v2, gfb, z]
    have spans := tensorProduct.span_pure at R, M, N1 with ring, moduleM, moduleN1
    have least := (moduleSpan.least_of at R, tensorProduct(M, R, N1), functionImage(tensorMk(M, R, N1), M.carrier × Module.carrier(N1), Module.carrier(tensorProduct(M, R, N1))), linearKernel(compose(leftTensor(M, R, N, N2, g), leftTensor(M, R, N1, N, f), Module.carrier(tensorProduct(M, R, N1)), Module.carrier(tensorProduct(M, R, N)), Module.carrier(tensorProduct(M, R, N2))), tensorProduct(M, R, N1), tensorProduct(M, R, N2)) with ringR, tp1, SSub, kerSub).backward with pureIn
    rw spans at least
    have inK := least with t1, ht1
    obtain ⟨_, zero⟩ := linearKernel.membership.forward with inK
    have c0 := compose.apply at leftTensor(M, R, N, N2, g), leftTensor(M, R, N1, N, f), Module.carrier(tensorProduct(M, R, N1)), Module.carrier(tensorProduct(M, R, N)), Module.carrier(tensorProduct(M, R, N2)), t1 with fF, gF, ht1
    rw [c0, Ft1] at zero
    apply linearKernel.membership.backward
    exact ⟨tIn, zero⟩
  . intro ht
    obtain ⟨tIn, Gt⟩ := linearKernel.membership.forward with ht
    have bil := exactLiftPairs.bilinear at R, M, N, N1, N2, f, g with ring, moduleM, moduleN, first, second, exact, surjective
    obtain ⟨linPhi, valPhi⟩ := tensorLift.parts at R, M, N2, quotientModule(tensorProduct(M, R, N), R, linearRange(leftTensor(M, R, N1, N, f), tensorProduct(M, R, N1), tensorProduct(M, R, N))), exactLiftPairs(M, R, N, N2, g, linearRange(leftTensor(M, R, N1, N, f), tensorProduct(M, R, N1), tensorProduct(M, R, N))) with ring, moduleM, moduleN2, bil
    have comp := LinearMap.compose at leftTensor(M, R, N, N2, g), tensorLift(M, R, N2, quotientModule(tensorProduct(M, R, N), R, linearRange(leftTensor(M, R, N1, N, f), tensorProduct(M, R, N1), tensorProduct(M, R, N))), exactLiftPairs(M, R, N, N2, g, linearRange(leftTensor(M, R, N1, N, f), tensorProduct(M, R, N1), tensorProduct(M, R, N)))), tensorProduct(M, R, N), R, tensorProduct(M, R, N2), quotientModule(tensorProduct(M, R, N), R, linearRange(leftTensor(M, R, N1, N, f), tensorProduct(M, R, N1), tensorProduct(M, R, N))) with linG, linPhi
    have gF := LinearMap.function_of with linG
    have pF := LinearMap.function_of with linPhi
    have agree : ∀ m ∈ M.carrier, ∀ n ∈ N.carrier, compose(tensorLift(M, R, N2, quotientModule(tensorProduct(M, R, N), R, linearRange(leftTensor(M, R, N1, N, f), tensorProduct(M, R, N1), tensorProduct(M, R, N))), exactLiftPairs(M, R, N, N2, g, linearRange(leftTensor(M, R, N1, N, f), tensorProduct(M, R, N1), tensorProduct(M, R, N)))), leftTensor(M, R, N, N2, g), Module.carrier(tensorProduct(M, R, N)), Module.carrier(tensorProduct(M, R, N2)), Module.carrier(quotientModule(tensorProduct(M, R, N), R, linearRange(leftTensor(M, R, N1, N, f), tensorProduct(M, R, N1), tensorProduct(M, R, N)))))(tmul(M, R, N, m, n)) = quotientModuleMap(tensorProduct(M, R, N), linearRange(leftTensor(M, R, N1, N, f), tensorProduct(M, R, N1), tensorProduct(M, R, N)))(tmul(M, R, N, m, n))
      intros m hm n hn
      have tIn2 := tmul.mem at R, M, N, m, n with *
      have c0 := compose.apply at tensorLift(M, R, N2, quotientModule(tensorProduct(M, R, N), R, linearRange(leftTensor(M, R, N1, N, f), tensorProduct(M, R, N1), tensorProduct(M, R, N))), exactLiftPairs(M, R, N, N2, g, linearRange(leftTensor(M, R, N1, N, f), tensorProduct(M, R, N1), tensorProduct(M, R, N)))), leftTensor(M, R, N, N2, g), Module.carrier(tensorProduct(M, R, N)), Module.carrier(tensorProduct(M, R, N2)), Module.carrier(quotientModule(tensorProduct(M, R, N), R, linearRange(leftTensor(M, R, N1, N, f), tensorProduct(M, R, N1), tensorProduct(M, R, N)))), tmul(M, R, N, m, n) with gF, pF, tIn2
      have gn := LinearMap.value_mem with second, hn
      have v1 := valG with m, hm, n, hn
      have v2 := valPhi with m, hm, g(n), gn
      have v3 := exactLiftPairs.value at R, M, N, N1, N2, f, g, m, n with ring, moduleM, moduleN, first, second, exact, surjective, hm, hn
      rw [c0, v1, v2, v3]
    have same := tensorProduct.ext_pure at R, M, N, quotientModule(tensorProduct(M, R, N), R, linearRange(leftTensor(M, R, N1, N, f), tensorProduct(M, R, N1), tensorProduct(M, R, N))), compose(tensorLift(M, R, N2, quotientModule(tensorProduct(M, R, N), R, linearRange(leftTensor(M, R, N1, N, f), tensorProduct(M, R, N1), tensorProduct(M, R, N))), exactLiftPairs(M, R, N, N2, g, linearRange(leftTensor(M, R, N1, N, f), tensorProduct(M, R, N1), tensorProduct(M, R, N)))), leftTensor(M, R, N, N2, g), Module.carrier(tensorProduct(M, R, N)), Module.carrier(tensorProduct(M, R, N2)), Module.carrier(quotientModule(tensorProduct(M, R, N), R, linearRange(leftTensor(M, R, N1, N, f), tensorProduct(M, R, N1), tensorProduct(M, R, N))))), quotientModuleMap(tensorProduct(M, R, N), linearRange(leftTensor(M, R, N1, N, f), tensorProduct(M, R, N1), tensorProduct(M, R, N))) with ring, moduleM, moduleN, comp, linPi, agree
    have c0 := compose.apply at tensorLift(M, R, N2, quotientModule(tensorProduct(M, R, N), R, linearRange(leftTensor(M, R, N1, N, f), tensorProduct(M, R, N1), tensorProduct(M, R, N))), exactLiftPairs(M, R, N, N2, g, linearRange(leftTensor(M, R, N1, N, f), tensorProduct(M, R, N1), tensorProduct(M, R, N)))), leftTensor(M, R, N, N2, g), Module.carrier(tensorProduct(M, R, N)), Module.carrier(tensorProduct(M, R, N2)), Module.carrier(quotientModule(tensorProduct(M, R, N), R, linearRange(leftTensor(M, R, N1, N, f), tensorProduct(M, R, N1), tensorProduct(M, R, N)))), t with gF, pF, tIn
    rw [same, Gt] at c0
    have z := LinearMap.map_zero at R, tensorProduct(M, R, N2), quotientModule(tensorProduct(M, R, N), R, linearRange(leftTensor(M, R, N1, N, f), tensorProduct(M, R, N1), tensorProduct(M, R, N))), tensorLift(M, R, N2, quotientModule(tensorProduct(M, R, N), R, linearRange(leftTensor(M, R, N1, N, f), tensorProduct(M, R, N1), tensorProduct(M, R, N))), exactLiftPairs(M, R, N, N2, g, linearRange(leftTensor(M, R, N1, N, f), tensorProduct(M, R, N1), tensorProduct(M, R, N)))) with ringR, tp2, moduleQ, linPhi
    rw z at c0
    have ker := SubmoduleOf.quotient_kernel at R, tensorProduct(M, R, N), linearRange(leftTensor(M, R, N1, N, f), tensorProduct(M, R, N1), tensorProduct(M, R, N)) with ringR, tp, subW
    have inK : t ∈ linearKernel(quotientModuleMap(tensorProduct(M, R, N), linearRange(leftTensor(M, R, N1, N, f), tensorProduct(M, R, N1), tensorProduct(M, R, N))), tensorProduct(M, R, N), quotientModule(tensorProduct(M, R, N), R, linearRange(leftTensor(M, R, N1, N, f), tensorProduct(M, R, N1), tensorProduct(M, R, N))))
      apply linearKernel.membership.backward
      refine ⟨tIn, ?_⟩
      have qz := quotientModule.zero_eq at tensorProduct(M, R, N), R, linearRange(leftTensor(M, R, N1, N, f), tensorProduct(M, R, N1), tensorProduct(M, R, N))
      exact c0
    rw ker at inK
    exact inK

theorem rightTensor.parts (M2 f : Set)
  requires linear : LinearMap(f, M, R, M2)
  shows LinearMap(rightTensor(M, R, N, M2, f), tensorProduct(M, R, N), R, tensorProduct(M2, R, N)) ∧
    (∀ m ∈ M.carrier, ∀ n ∈ N.carrier,
      rightTensor(M, R, N, M2, f)(tmul(M, R, N, m, n)) = tmul(M2, R, N, f(m), n))
proof
  have idN := LinearMap.identity at N, R with moduleN
  have lin := tensorMap.linear at R, M, N, M2, N, f, identity(N.carrier) with ring, moduleM, moduleN, linear, idN
  unfold rightTensor
  refine ⟨lin, ?_⟩
  intros m hm n hn
  have t := tensorMap.tmul at R, M, N, M2, N, f, identity(N.carrier), m, n with ring, moduleM, moduleN, linear, idN, hm, hn
  rw [t, identity.apply with hn]

-- σ ∘ (f ⊗ id) = (id ⊗ f) ∘ σ for the swap σ.
theorem rightTensor.swap (M2 f t : Set)
  requires linear : LinearMap(f, M, R, M2)
  requires member : t ∈ Module.carrier(tensorProduct(M, R, N))
  shows tensorSwap(M2, R, N)(rightTensor(M, R, N, M2, f)(t)) =
    leftTensor(N, R, M, M2, f)(tensorSwap(M, R, N)(t))
proof
  have moduleM2 := LinearMap.target_module with linear
  obtain ⟨linR, valR⟩ := rightTensor.parts at R, M, N, M2, f with *
  obtain ⟨linL, valL⟩ := leftTensor.parts at R, N, M, M2, f with ring, moduleN, moduleM, linear
  obtain ⟨linS, valS⟩ := tensorSwap.parts at R, M, N with *
  obtain ⟨linS2, valS2⟩ := tensorSwap.parts at R, M2, N with ring, moduleM2, moduleN
  have c1 := LinearMap.compose at rightTensor(M, R, N, M2, f), tensorSwap(M2, R, N), tensorProduct(M, R, N), R, tensorProduct(M2, R, N), tensorProduct(N, R, M2) with linR, linS2
  have c2 := LinearMap.compose at tensorSwap(M, R, N), leftTensor(N, R, M, M2, f), tensorProduct(M, R, N), R, tensorProduct(N, R, M), tensorProduct(N, R, M2) with linS, linL
  have fR := LinearMap.function_of with linR
  have fL := LinearMap.function_of with linL
  have fS := LinearMap.function_of with linS
  have fS2 := LinearMap.function_of with linS2
  have agree : ∀ m ∈ M.carrier, ∀ n ∈ N.carrier, compose(tensorSwap(M2, R, N), rightTensor(M, R, N, M2, f), Module.carrier(tensorProduct(M, R, N)), Module.carrier(tensorProduct(M2, R, N)), Module.carrier(tensorProduct(N, R, M2)))(tmul(M, R, N, m, n)) = compose(leftTensor(N, R, M, M2, f), tensorSwap(M, R, N), Module.carrier(tensorProduct(M, R, N)), Module.carrier(tensorProduct(N, R, M)), Module.carrier(tensorProduct(N, R, M2)))(tmul(M, R, N, m, n))
    intros m hm n hn
    have tIn := tmul.mem at R, M, N, m, n with *
    have fm := LinearMap.value_mem with linear, hm
    have a1 := compose.apply at tensorSwap(M2, R, N), rightTensor(M, R, N, M2, f), Module.carrier(tensorProduct(M, R, N)), Module.carrier(tensorProduct(M2, R, N)), Module.carrier(tensorProduct(N, R, M2)), tmul(M, R, N, m, n) with fR, fS2, tIn
    have a2 := compose.apply at leftTensor(N, R, M, M2, f), tensorSwap(M, R, N), Module.carrier(tensorProduct(M, R, N)), Module.carrier(tensorProduct(N, R, M)), Module.carrier(tensorProduct(N, R, M2)), tmul(M, R, N, m, n) with fS, fL, tIn
    have v1 := valR with m, hm, n, hn
    have v2 := valS2 with f(m), fm, n, hn
    have v3 := valS with m, hm, n, hn
    have v4 := valL with n, hn, m, hm
    rw [a1, a2, v1, v2, v3, v4]
  have same := tensorProduct.ext_pure at R, M, N, tensorProduct(N, R, M2), compose(tensorSwap(M2, R, N), rightTensor(M, R, N, M2, f), Module.carrier(tensorProduct(M, R, N)), Module.carrier(tensorProduct(M2, R, N)), Module.carrier(tensorProduct(N, R, M2))), compose(leftTensor(N, R, M, M2, f), tensorSwap(M, R, N), Module.carrier(tensorProduct(M, R, N)), Module.carrier(tensorProduct(N, R, M)), Module.carrier(tensorProduct(N, R, M2))) with ring, moduleM, moduleN, c1, c2, agree
  have a1 := compose.apply at tensorSwap(M2, R, N), rightTensor(M, R, N, M2, f), Module.carrier(tensorProduct(M, R, N)), Module.carrier(tensorProduct(M2, R, N)), Module.carrier(tensorProduct(N, R, M2)), t with fR, fS2, member
  have a2 := compose.apply at leftTensor(N, R, M, M2, f), tensorSwap(M, R, N), Module.carrier(tensorProduct(M, R, N)), Module.carrier(tensorProduct(N, R, M)), Module.carrier(tensorProduct(N, R, M2)), t with fS, fL, member
  rw [← a1, ← a2, same]

theorem rightTensor.exact (M1 M2 f g : Set)
  requires first : LinearMap(f, M1, R, M)
  requires second : LinearMap(g, M, R, M2)
  requires exact : ExactPair(f, g, M1, M, M2)
  requires surjective : SurjectiveBetween(g, M.carrier, Module.carrier(M2))
  shows ExactPair(rightTensor(M1, R, N, M, f), rightTensor(M, R, N, M2, g),
    tensorProduct(M1, R, N), tensorProduct(M, R, N), tensorProduct(M2, R, N))
proof
  have ringR := CommRing.to_ring with ring
  have moduleM1 := LinearMap.source_module with first
  have moduleM2 := LinearMap.target_module with second
  have tp1 := tensorProduct.module at R, M1, N with ring, moduleM1, moduleN
  have tp := tensorProduct.module at R, M, N with *
  have tp2 := tensorProduct.module at R, M2, N with ring, moduleM2, moduleN
  have stp2 := tensorProduct.module at R, N, M2 with ring, moduleN, moduleM2
  obtain ⟨linF, _⟩ := rightTensor.parts at R, M1, N, M, f with ring, moduleM1, moduleN, first
  obtain ⟨linG, _⟩ := rightTensor.parts at R, M, N, M2, g with *
  obtain ⟨linLF, _⟩ := leftTensor.parts at R, N, M1, M, f with ring, moduleN, moduleM1, first
  obtain ⟨linLG, _⟩ := leftTensor.parts at R, N, M, M2, g with ring, moduleN, moduleM, second
  obtain ⟨linS1, _⟩ := tensorSwap.parts at R, M1, N with ring, moduleM1, moduleN
  obtain ⟨linS, _⟩ := tensorSwap.parts at R, M, N with *
  obtain ⟨linS2, _⟩ := tensorSwap.parts at R, M2, N with ring, moduleM2, moduleN
  obtain ⟨linT1, _⟩ := tensorSwap.parts at R, N, M1 with ring, moduleN, moduleM1
  obtain ⟨linT, _⟩ := tensorSwap.parts at R, N, M with ring, moduleN, moduleM
  obtain ⟨linT2, _⟩ := tensorSwap.parts at R, N, M2 with ring, moduleN, moduleM2
  have leftExact := leftTensor.exact at R, N, M, M1, M2, f, g with ring, moduleN, moduleM, first, second, exact, surjective
  unfold ExactPair at leftExact
  unfold ExactPair
  ext t
  constructor
  . intro ht
    obtain ⟨tIn, t1, ht1, Ft1⟩ := linearRange.membership.forward with ht
    have s1 := LinearMap.value_mem with linS1, ht1
    have inRange : leftTensor(N, R, M1, M, f)(tensorSwap(M1, R, N)(t1)) ∈ linearRange(leftTensor(N, R, M1, M, f), tensorProduct(N, R, M1), tensorProduct(N, R, M))
      have vIn := LinearMap.value_mem with linLF, s1
      apply linearRange.membership.backward
      exact ⟨vIn, tensorSwap(M1, R, N)(t1), s1, rfl⟩
    rw leftExact at inRange
    obtain ⟨_, zero⟩ := linearKernel.membership.forward with inRange
    have sw1 := rightTensor.swap at R, M1, N, M, f, t1 with ring, moduleM1, moduleN, first, ht1
    rw [← sw1, Ft1] at zero
    have sw2 := rightTensor.swap at R, M, N, M2, g, t with *
    rw ← sw2 at zero
    have gt := LinearMap.value_mem with linG, tIn
    have back := tensorSwap.involutive at R, M2, N, rightTensor(M, R, N, M2, g)(t) with ring, moduleM2, moduleN, gt
    rw zero at back
    have z := LinearMap.map_zero at R, tensorProduct(N, R, M2), tensorProduct(M2, R, N), tensorSwap(N, R, M2) with ringR, stp2, tp2, linT2
    rw z at back
    apply linearKernel.membership.backward
    refine ⟨tIn, ?_⟩
    symm
    exact back
  . intro ht
    obtain ⟨tIn, Gt⟩ := linearKernel.membership.forward with ht
    have sw2 := rightTensor.swap at R, M, N, M2, g, t with *
    rw Gt at sw2
    have z := LinearMap.map_zero at R, tensorProduct(M2, R, N), tensorProduct(N, R, M2), tensorSwap(M2, R, N) with ringR, tp2, stp2, linS2
    rw z at sw2
    have st := LinearMap.value_mem with linS, tIn
    have inKer : tensorSwap(M, R, N)(t) ∈ linearKernel(leftTensor(N, R, M, M2, g), tensorProduct(N, R, M), tensorProduct(N, R, M2))
      apply linearKernel.membership.backward
      refine ⟨st, ?_⟩
      symm
      exact sw2
    rw ← leftExact at inKer
    obtain ⟨_, s, hs, Fs⟩ := linearRange.membership.forward with inKer
    have u := LinearMap.value_mem with linT1, hs
    have sw1 := rightTensor.swap at R, M1, N, M, f, tensorSwap(N, R, M1)(s) with ring, moduleM1, moduleN, first, u
    have inv1 := tensorSwap.involutive at R, N, M1, s with ring, moduleN, moduleM1, hs
    rw [inv1, Fs] at sw1
    have Fu := LinearMap.value_mem with linF, u
    have back := tensorSwap.involutive at R, M, N, rightTensor(M1, R, N, M, f)(tensorSwap(N, R, M1)(s)) with ring, moduleM, moduleN, Fu
    rw sw1 at back
    have back2 := tensorSwap.involutive at R, M, N, t with *
    rw back2 at back
    symm at back
    apply linearRange.membership.backward
    exact ⟨tIn, tensorSwap(N, R, M1)(s), u, back⟩

-- TensorProduct.comm.
theorem tensorSwap.equiv
  shows LinearEquiv(tensorSwap(M, R, N), tensorProduct(M, R, N), R,
    tensorProduct(N, R, M))
proof
  obtain ⟨l1, v1⟩ := tensorSwap.parts at R, M, N with *
  obtain ⟨l2, v2⟩ := tensorSwap.parts at R, N, M with ring, moduleN, moduleM
  have f1 := LinearMap.function_of with l1
  have f2 := LinearMap.function_of with l2
  have left : ∀ t ∈ Module.carrier(tensorProduct(M, R, N)), tensorSwap(N, R, M)(tensorSwap(M, R, N)(t)) = t
    intros t ht
    exact tensorSwap.involutive at R, M, N, t with *
  have right : ∀ t ∈ Module.carrier(tensorProduct(N, R, M)), tensorSwap(M, R, N)(tensorSwap(N, R, M)(t)) = t
    intros t ht
    exact tensorSwap.involutive at R, N, M, t with ring, moduleN, moduleM, ht
  have bij := Bijective.of_two_sided_inverse with f1, f2, left, right
  exact LinearEquiv.of_bijective with l1, bij

theorem tensorSwap.tmul (m : M) (n : N)
  shows tensorSwap(M, R, N)(tmul(M, R, N, m, n)) = tmul(N, R, M, n, m)
proof
  have hm : m ∈ M.carrier by assumption
  have hn : n ∈ N.carrier by assumption
  obtain ⟨_, v⟩ := tensorSwap.parts at R, M, N with *
  exact v with m, hm, n, hn

-- TensorProduct.assoc: (M ⊗ N) ⊗ P ≅ M ⊗ (N ⊗ P).
theorem tensorProduct.assoc (P : Set)
  requires moduleP : Module(P, R)
  shows ∃ e, LinearEquiv(e, tensorProduct(tensorProduct(M, R, N), R, P), R,
      tensorProduct(M, R, tensorProduct(N, R, P))) ∧
    (∀ m ∈ M.carrier, ∀ n ∈ N.carrier, ∀ p ∈ P.carrier,
      e(tmul(tensorProduct(M, R, N), R, P, tmul(M, R, N, m, n), p)) =
        tmul(M, R, tensorProduct(N, R, P), m, tmul(N, R, P, n, p)))
proof
  sorry

-- Basis.tensorProduct: pure tensors of basis vectors form a basis, so the
-- rank is multiplicative (Module.finrank_tensorProduct).
theorem tensorProduct.basis (I J v w : Set)
  requires first : ModuleBasis(M, R, I, v)
  requires second : ModuleBasis(N, R, J, w)
  shows ModuleBasis(tensorProduct(M, R, N), R, I × J,
    compose(tensorMk(M, R, N), productFamily(I, J, M.carrier, N.carrier, v, w), I × J,
      M.carrier × N.carrier, Module.carrier(tensorProduct(M, R, N))))
proof
  sorry

theorem tensorProduct.finrank
  requires nontrivial : R.zero ≠ R.one
  requires freeM : FiniteFreeModule(M, R)
  requires freeN : FiniteFreeModule(N, R)
  shows FiniteFreeModule(tensorProduct(M, R, N), R) ∧
    finrank(tensorProduct(M, R, N), R) = finrank(M, R) * finrank(N, R)
proof
  sorry

end Tensors

-- m ↦ 1 ⊗ m, the inverse of R ⊗ M → M.
def scalarTensorInverse (M R : Set) : Set :=
  { p ∈ Module.carrier(M) × Module.carrier(tensorProduct(selfModule(R), R, M)) |
    ∃ m ∈ Module.carrier(M), p = (m, tmul(selfModule(R), R, M, Ring.one(R), m)) }

theorem scalarTensorInverse.graph_relates (M R m : Set)
  requires index : m ∈ Module.carrier(M)
  requires valueIn : tmul(selfModule(R), R, M, Ring.one(R), m) ∈ Module.carrier(tensorProduct(selfModule(R), R, M))
  shows relates(scalarTensorInverse(M, R), m, tmul(selfModule(R), R, M, Ring.one(R), m))
proof
  unfold relates
  apply scalarTensorInverse.membership.backward
  refine ⟨(product.pair at m, tmul(selfModule(R), R, M, Ring.one(R), m), Module.carrier(M), Module.carrier(tensorProduct(selfModule(R), R, M)) with index, valueIn), m, index, rfl⟩

theorem scalarTensorInverse.graph_function (M R : Set)
  requires values : ∀ m ∈ Module.carrier(M), tmul(selfModule(R), R, M, Ring.one(R), m) ∈ Module.carrier(tensorProduct(selfModule(R), R, M))
  shows scalarTensorInverse(M, R) : Module.carrier(M) → Module.carrier(tensorProduct(selfModule(R), R, M))
proof
  constructor
    intros q0 member
    obtain ⟨bounded, witnesses⟩ := scalarTensorInverse.membership.forward with member
    exact bounded
  . constructor
      intros z0 first xFirst second xSecond
      unfold relates at xFirst
      obtain ⟨_, a1, a1In, firstShape⟩ := scalarTensorInverse.membership.forward with xFirst
      unfold relates at xSecond
      obtain ⟨_, a2, a2In, secondShape⟩ := scalarTensorInverse.membership.forward with xSecond
      obtain ⟨xi, firstEqual⟩ := orderedPair.injective with firstShape
      obtain ⟨xj, secondEqual⟩ := orderedPair.injective with secondShape
      rw [firstEqual, secondEqual]
      cc
    . intros m xIn
      have valueIn := values with m, xIn
      refine ⟨tmul(selfModule(R), R, M, Ring.one(R), m), valueIn, (scalarTensorInverse.graph_relates at M, R, m with xIn, valueIn)⟩

theorem scalarTensorInverse.graph_apply (M R m : Set)
  requires values : ∀ m ∈ Module.carrier(M), tmul(selfModule(R), R, M, Ring.one(R), m) ∈ Module.carrier(tensorProduct(selfModule(R), R, M))
  requires index : m ∈ Module.carrier(M)
  shows scalarTensorInverse(M, R)(m) = tmul(selfModule(R), R, M, Ring.one(R), m)
proof
  have function := scalarTensorInverse.graph_function at M, R with values
  have valueIn := values with m, index
  have mapped := scalarTensorInverse.graph_relates at M, R, m with index, valueIn
  exact FunctionBetween.apply_value with function, index, mapped

section Unit
variable (R M : Set)
hypothesis ring : CommRing(R)
hypothesis module : Module(M, R)

theorem smul.bilinear
  shows BilinearMap(Module.smul(M), selfModule(R), M, M, R)
proof
  have ringR := CommRing.to_ring with ring
  have self := Ring.to_module at R with ringR
  have sc := selfModule.carrier_eq at R
  have sa := selfModule.add_eq at R
  have sm := selfModule.smul_eq at R
  obtain ⟨_, _, _, _, _, smulF, _⟩ := module
  unfold BilinearMap
  rw [sc, sa, sm]
  refine ⟨self, module, module, smulF, ?_, ?_, ?_⟩
  . intros v hv w hw x hx
    rw sc at hv
    rw sc at hw
    have h := add_smul at R, M, v, w, x with *
    unfold call2 at h
    unfold call2
    exact h
  . intros v hv x hx y hy
    rw sc at hv
    have h := smul_add at R, M, v, x, y with *
    unfold call2 at h
    unfold call2
    exact h
  . intros r hr v hv x hx
    rw sc at hv
    have l1 := mul_smul at R, M, r, v, x with *
    have l2 := mul_smul at R, M, v, r, x with *
    have swap : v * r = r * v by ring
    unfold call2 at l1
    unfold call2 at l2
    unfold call2 at swap
    unfold call2
    refine ⟨l1, ?_⟩
    rw [← l2, swap, l1]

theorem scalarTensorMap.parts
  shows LinearMap(scalarTensorMap(M, R), tensorProduct(selfModule(R), R, M), R, M) ∧
    (∀ r ∈ R.carrier, ∀ m ∈ M.carrier,
      scalarTensorMap(M, R)(tmul(selfModule(R), R, M, r, m)) = r • m)
proof
  have ringR := CommRing.to_ring with ring
  have self := Ring.to_module at R with ringR
  have sc := selfModule.carrier_eq at R
  have bil := smul.bilinear at R, M with *
  obtain ⟨lin, val⟩ := tensorLift.parts at R, selfModule(R), M, M, Module.smul(M) with ring, self, module, bil
  unfold scalarTensorMap
  refine ⟨lin, ?_⟩
  intros r hr m hm
  have hr2 : r ∈ Module.carrier(selfModule(R))
    rw sc
    exact hr
  have h := val with r, hr2, m, hm
  unfold call2
  exact h

theorem scalarTensorInverse.value (m : Set)
  requires hm : m ∈ M.carrier
  shows scalarTensorInverse(M, R)(m) = tmul(selfModule(R), R, M, R.one, m)
proof
  have ringR := CommRing.to_ring with ring
  have self := Ring.to_module at R with ringR
  have sc := selfModule.carrier_eq at R
  have oneIn := Ring.one_mem at R with ringR
  have one2 : R.one ∈ Module.carrier(selfModule(R))
    rw sc
    exact oneIn
  have values : ∀ m ∈ M.carrier, tmul(selfModule(R), R, M, Ring.one(R), m) ∈ Module.carrier(tensorProduct(selfModule(R), R, M))
    intros a ha
    exact tmul.mem at R, selfModule(R), M, R.one, a with ring, self, module, one2, ha
  exact scalarTensorInverse.graph_apply at M, R, m with values, hm

theorem scalarTensorInverse.linear
  shows LinearMap(scalarTensorInverse(M, R), M, R, tensorProduct(selfModule(R), R, M))
proof
  have ringR := CommRing.to_ring with ring
  have self := Ring.to_module at R with ringR
  have sc := selfModule.carrier_eq at R
  have sm := selfModule.smul_eq at R
  have oneIn := Ring.one_mem at R with ringR
  have one2 : R.one ∈ Module.carrier(selfModule(R))
    rw sc
    exact oneIn
  have tp := tensorProduct.module at R, selfModule(R), M with ring, self, module
  have values : ∀ m ∈ M.carrier, tmul(selfModule(R), R, M, Ring.one(R), m) ∈ Module.carrier(tensorProduct(selfModule(R), R, M))
    intros a ha
    exact tmul.mem at R, selfModule(R), M, R.one, a with ring, self, module, one2, ha
  have function := scalarTensorInverse.graph_function at M, R with values
  apply LinearMap.of_laws with module, tp, function
  . intros v hv w hw
    have vw := Module.add_mem at R, M, v, w with *
    have e1 := scalarTensorInverse.value at R, M, v + w with *
    have e2 := scalarTensorInverse.value at R, M, v with *
    have e3 := scalarTensorInverse.value at R, M, w with *
    have t := tmul.add_right at R, selfModule(R), M, R.one, v, w with ring, self, module, one2, hv, hw
    rw [e1, e2, e3, t]
  . intros r hr v hv
    have rv := Module.smul_mem at R, M, r, v with *
    have e1 := scalarTensorInverse.value at R, M, r • v with *
    have e2 := scalarTensorInverse.value at R, M, v with *
    have t1 := tmul.smul_right at R, selfModule(R), M, r, R.one, v with ring, self, module, hr, one2, hv
    have r1 : r ∈ Module.carrier(selfModule(R))
      rw sc
      exact hr
    have t2 := tmul.smul_left at R, selfModule(R), M, r, R.one, v with ring, self, module, hr, one2, hv
    rw [e1, e2, t1, t2]

-- TensorProduct.lid: R ⊗ M ≅ M.
theorem scalarTensorMap.equiv
  shows LinearEquiv(scalarTensorMap(M, R), tensorProduct(selfModule(R), R, M),
    R, M)
proof
  have ringR := CommRing.to_ring with ring
  have self := Ring.to_module at R with ringR
  have sc := selfModule.carrier_eq at R
  have sm := selfModule.smul_eq at R
  have oneIn := Ring.one_mem at R with ringR
  have tp := tensorProduct.module at R, selfModule(R), M with ring, self, module
  obtain ⟨l1, v1⟩ := scalarTensorMap.parts at R, M with *
  have l2 := scalarTensorInverse.linear at R, M with *
  have f1 := LinearMap.function_of with l1
  have f2 := LinearMap.function_of with l2
  have idT := LinearMap.identity at tensorProduct(selfModule(R), R, M), R with tp
  have c := LinearMap.compose at scalarTensorMap(M, R), scalarTensorInverse(M, R), tensorProduct(selfModule(R), R, M), R, M, tensorProduct(selfModule(R), R, M) with l1, l2
  have agree : ∀ r ∈ Module.carrier(selfModule(R)), ∀ m ∈ M.carrier, compose(scalarTensorInverse(M, R), scalarTensorMap(M, R), Module.carrier(tensorProduct(selfModule(R), R, M)), M.carrier, Module.carrier(tensorProduct(selfModule(R), R, M)))(tmul(selfModule(R), R, M, r, m)) = identity(Module.carrier(tensorProduct(selfModule(R), R, M)))(tmul(selfModule(R), R, M, r, m))
    intros r hr m hm
    have tIn := tmul.mem at R, selfModule(R), M, r, m with ring, self, module, hr, hm
    have c0 := compose.apply at scalarTensorInverse(M, R), scalarTensorMap(M, R), Module.carrier(tensorProduct(selfModule(R), R, M)), M.carrier, Module.carrier(tensorProduct(selfModule(R), R, M)), tmul(selfModule(R), R, M, r, m) with f1, f2, tIn
    have hr1 : r ∈ R.carrier
      rw sc at hr
      exact hr
    have a := v1 with r, hr1, m, hm
    have rm := Module.smul_mem at R, M, r, m with ringR, module, hr1, hm
    have b := scalarTensorInverse.value at R, M, call2(Module.smul(M), r, m) with ring, module, rm
    have one2 : R.one ∈ Module.carrier(selfModule(R))
      rw sc
      exact oneIn
    have t1 := tmul.smul_right at R, selfModule(R), M, r, R.one, m with ring, self, module, hr1, one2, hm
    have unit : r * R.one = r by ring
    rw [c0, a, b, t1, sm, unit, identity.apply with tIn]
  have same := tensorProduct.ext_pure at R, selfModule(R), M, tensorProduct(selfModule(R), R, M), compose(scalarTensorInverse(M, R), scalarTensorMap(M, R), Module.carrier(tensorProduct(selfModule(R), R, M)), M.carrier, Module.carrier(tensorProduct(selfModule(R), R, M))), identity(Module.carrier(tensorProduct(selfModule(R), R, M))) with ring, self, module, c, idT, agree
  have left : ∀ t ∈ Module.carrier(tensorProduct(selfModule(R), R, M)), scalarTensorInverse(M, R)(scalarTensorMap(M, R)(t)) = t
    intros t ht
    have c0 := compose.apply at scalarTensorInverse(M, R), scalarTensorMap(M, R), Module.carrier(tensorProduct(selfModule(R), R, M)), M.carrier, Module.carrier(tensorProduct(selfModule(R), R, M)), t with f1, f2, ht
    rw [← c0, same, identity.apply with ht]
  have right : ∀ m ∈ M.carrier, scalarTensorMap(M, R)(scalarTensorInverse(M, R)(m)) = m
    intros m hm
    have b := scalarTensorInverse.value at R, M, m with *
    have a := v1 with R.one, oneIn, m, hm
    have u := one_smul at R, M, m with *
    rw [b, a, u]
  have bij := Bijective.of_two_sided_inverse with f1, f2, left, right
  exact LinearEquiv.of_bijective with l1, bij

theorem scalarTensorMap.tmul (r : R) (m : M)
  shows scalarTensorMap(M, R)(tmul(selfModule(R), R, M, r, m)) = r • m
proof
  have hr : r ∈ R.carrier by assumption
  have hm : m ∈ M.carrier by assumption
  obtain ⟨_, v⟩ := scalarTensorMap.parts at R, M with *
  exact v with r, hr, m, hm

-- Rᴵ ⊗ M ≅ Mᴵ for finite I.
theorem tensorProduct.coordinate (I : Set)
  requires finite : Finite(I)
  shows ModuleIsomorphic(tensorProduct(coordinateModule(R, I), R, M), R,
    functionModule(R, I, M))
proof
  sorry

end Unit

-- Section: Slices of bilinear maps
-- x ↦ B(v, x) and v ↦ B(v, x).
def bilinearRight (B X Y v : Set) : Set :=
  { p ∈ X × Y | ∃ x ∈ X, p = (x, B((v, x))) }

def bilinearLeft (B X Y x : Set) : Set :=
  { p ∈ X × Y | ∃ v ∈ X, p = (v, B((v, x))) }

-- Multiplication by a fixed element, as a set of pairs.

theorem bilinearRight.graph_relates (B X Y v x : Set)
  requires index : x ∈ X
  requires valueIn : B((v, x)) ∈ Y
  shows relates(bilinearRight(B, X, Y, v), x, B((v, x)))
proof
  unfold relates
  apply bilinearRight.membership.backward
  refine ⟨(product.pair at x, B((v, x)), X, Y with index, valueIn), x, index, rfl⟩

theorem bilinearRight.graph_function (B X Y v : Set)
  requires values : ∀ x ∈ X, B((v, x)) ∈ Y
  shows bilinearRight(B, X, Y, v) : X → Y
proof
  constructor
    intros q0 member
    obtain ⟨bounded, witnesses⟩ := bilinearRight.membership.forward with member
    exact bounded
  . constructor
      intros z0 first xFirst second xSecond
      unfold relates at xFirst
      obtain ⟨_, a1, a1In, firstShape⟩ := bilinearRight.membership.forward with xFirst
      unfold relates at xSecond
      obtain ⟨_, a2, a2In, secondShape⟩ := bilinearRight.membership.forward with xSecond
      obtain ⟨xi, firstEqual⟩ := orderedPair.injective with firstShape
      obtain ⟨xj, secondEqual⟩ := orderedPair.injective with secondShape
      rw [firstEqual, secondEqual]
      cc
    . intros x xIn
      have valueIn := values with x, xIn
      refine ⟨B((v, x)), valueIn, (bilinearRight.graph_relates at B, X, Y, v, x with xIn, valueIn)⟩

theorem bilinearRight.graph_apply (B X Y v x : Set)
  requires values : ∀ x ∈ X, B((v, x)) ∈ Y
  requires index : x ∈ X
  shows bilinearRight(B, X, Y, v)(x) = B((v, x))
proof
  have function := bilinearRight.graph_function at B, X, Y, v with values
  have valueIn := values with x, index
  have mapped := bilinearRight.graph_relates at B, X, Y, v, x with index, valueIn
  exact FunctionBetween.apply_value with function, index, mapped

theorem bilinearLeft.graph_relates (B X Y x v : Set)
  requires index : v ∈ X
  requires valueIn : B((v, x)) ∈ Y
  shows relates(bilinearLeft(B, X, Y, x), v, B((v, x)))
proof
  unfold relates
  apply bilinearLeft.membership.backward
  refine ⟨(product.pair at v, B((v, x)), X, Y with index, valueIn), v, index, rfl⟩

theorem bilinearLeft.graph_function (B X Y x : Set)
  requires values : ∀ v ∈ X, B((v, x)) ∈ Y
  shows bilinearLeft(B, X, Y, x) : X → Y
proof
  constructor
    intros q0 member
    obtain ⟨bounded, witnesses⟩ := bilinearLeft.membership.forward with member
    exact bounded
  . constructor
      intros z0 first xFirst second xSecond
      unfold relates at xFirst
      obtain ⟨_, a1, a1In, firstShape⟩ := bilinearLeft.membership.forward with xFirst
      unfold relates at xSecond
      obtain ⟨_, a2, a2In, secondShape⟩ := bilinearLeft.membership.forward with xSecond
      obtain ⟨xi, firstEqual⟩ := orderedPair.injective with firstShape
      obtain ⟨xj, secondEqual⟩ := orderedPair.injective with secondShape
      rw [firstEqual, secondEqual]
      cc
    . intros v xIn
      have valueIn := values with v, xIn
      refine ⟨B((v, x)), valueIn, (bilinearLeft.graph_relates at B, X, Y, x, v with xIn, valueIn)⟩

theorem bilinearLeft.graph_apply (B X Y x v : Set)
  requires values : ∀ v ∈ X, B((v, x)) ∈ Y
  requires index : v ∈ X
  shows bilinearLeft(B, X, Y, x)(v) = B((v, x))
proof
  have function := bilinearLeft.graph_function at B, X, Y, x with values
  have valueIn := values with v, index
  have mapped := bilinearLeft.graph_relates at B, X, Y, x, v with index, valueIn
  exact FunctionBetween.apply_value with function, index, mapped

theorem algebraMultiplication.graph_relates (A a b : Set)
  requires index : b ∈ algebraCarrier(A)
  requires valueIn : call2(Ring.mul(Algebra.ring(A)), a, b) ∈ algebraCarrier(A)
  shows relates(algebraMultiplication(A, a), b, call2(Ring.mul(Algebra.ring(A)), a, b))
proof
  unfold relates
  apply algebraMultiplication.membership.backward
  refine ⟨(product.pair at b, call2(Ring.mul(Algebra.ring(A)), a, b), algebraCarrier(A), algebraCarrier(A) with index, valueIn), b, index, rfl⟩

theorem algebraMultiplication.graph_function (A a : Set)
  requires values : ∀ b ∈ algebraCarrier(A), call2(Ring.mul(Algebra.ring(A)), a, b) ∈ algebraCarrier(A)
  shows algebraMultiplication(A, a) : algebraCarrier(A) → algebraCarrier(A)
proof
  constructor
    intros q0 member
    obtain ⟨bounded, witnesses⟩ := algebraMultiplication.membership.forward with member
    exact bounded
  . constructor
      intros z0 first xFirst second xSecond
      unfold relates at xFirst
      obtain ⟨_, a1, a1In, firstShape⟩ := algebraMultiplication.membership.forward with xFirst
      unfold relates at xSecond
      obtain ⟨_, a2, a2In, secondShape⟩ := algebraMultiplication.membership.forward with xSecond
      obtain ⟨xi, firstEqual⟩ := orderedPair.injective with firstShape
      obtain ⟨xj, secondEqual⟩ := orderedPair.injective with secondShape
      rw [firstEqual, secondEqual]
      cc
    . intros b xIn
      have valueIn := values with b, xIn
      refine ⟨call2(Ring.mul(Algebra.ring(A)), a, b), valueIn, (algebraMultiplication.graph_relates at A, a, b with xIn, valueIn)⟩

theorem algebraMultiplication.graph_apply (A a b : Set)
  requires values : ∀ b ∈ algebraCarrier(A), call2(Ring.mul(Algebra.ring(A)), a, b) ∈ algebraCarrier(A)
  requires index : b ∈ algebraCarrier(A)
  shows algebraMultiplication(A, a)(b) = call2(Ring.mul(Algebra.ring(A)), a, b)
proof
  have function := algebraMultiplication.graph_function at A, a with values
  have valueIn := values with b, index
  have mapped := algebraMultiplication.graph_relates at A, a, b with index, valueIn
  exact FunctionBetween.apply_value with function, index, mapped


section Slices
variable (B M N P R : Set)
hypothesis ringS : CommRing(R)
hypothesis bilinearS : BilinearMap(B, M, N, P, R)

theorem bilinearRight.value (v x : Set)
  requires hv : v ∈ M.carrier
  requires hx : x ∈ N.carrier
  shows bilinearRight(B, N.carrier, P.carrier, v)(x) = B((v, x))
proof
  obtain ⟨_, _, _, family, _⟩ := bilinearS
  have values : ∀ x ∈ N.carrier, B((v, x)) ∈ P.carrier
    intros y hy
    have pair := product.pair at v, y, M.carrier, N.carrier with hv, hy
    exact FunctionBetween.apply_closed with family, pair
  exact bilinearRight.graph_apply at B, N.carrier, P.carrier, v, x with values, hx

theorem bilinearRight.linear (v : Set)
  requires hv : v ∈ M.carrier
  shows LinearMap(bilinearRight(B, N.carrier, P.carrier, v), N, R, P)
proof
  obtain ⟨moduleM, moduleN, moduleP, family, addL, addR, smulLR⟩ := bilinearS
  have values : ∀ x ∈ N.carrier, B((v, x)) ∈ P.carrier
    intros y hy
    have pair := product.pair at v, y, M.carrier, N.carrier with hv, hy
    exact FunctionBetween.apply_closed with family, pair
  have function := bilinearRight.graph_function at B, N.carrier, P.carrier, v with values
  apply LinearMap.of_laws with moduleN, moduleP, function
  . intros x hx y hy
    have ringR := CommRing.to_ring with ringS
    have xy := Module.add_mem at R, N, x, y with ringR, moduleN, hx, hy
    have e1 := bilinearRight.value at B, M, N, P, R, v, call2(Module.add(N), x, y) with ringS, bilinearS, hv, xy
    have e2 := bilinearRight.value at B, M, N, P, R, v, x with ringS, bilinearS, hv, hx
    have e3 := bilinearRight.value at B, M, N, P, R, v, y with ringS, bilinearS, hv, hy
    have law := addR with v, hv, x, hx, y, hy
    rw [e1, e2, e3, law]
  . intros r hr x hx
    have ringR := CommRing.to_ring with ringS
    have rx := Module.smul_mem at R, N, r, x with ringR, moduleN, hr, hx
    have e1 := bilinearRight.value at B, M, N, P, R, v, call2(Module.smul(N), r, x) with ringS, bilinearS, hv, rx
    have e2 := bilinearRight.value at B, M, N, P, R, v, x with ringS, bilinearS, hv, hx
    obtain ⟨_, law⟩ := smulLR with r, hr, v, hv, x, hx
    rw [e1, e2, law]

theorem bilinearLeft.value (v x : Set)
  requires hv : v ∈ M.carrier
  requires hx : x ∈ N.carrier
  shows bilinearLeft(B, M.carrier, P.carrier, x)(v) = B((v, x))
proof
  obtain ⟨_, _, _, family, _⟩ := bilinearS
  have values : ∀ v ∈ M.carrier, B((v, x)) ∈ P.carrier
    intros w hw
    have pair := product.pair at w, x, M.carrier, N.carrier with hw, hx
    exact FunctionBetween.apply_closed with family, pair
  exact bilinearLeft.graph_apply at B, M.carrier, P.carrier, x, v with values, hv

theorem bilinearLeft.linear (x : Set)
  requires hx : x ∈ N.carrier
  shows LinearMap(bilinearLeft(B, M.carrier, P.carrier, x), M, R, P)
proof
  obtain ⟨moduleM, moduleN, moduleP, family, addL, addR, smulLR⟩ := bilinearS
  have values : ∀ v ∈ M.carrier, B((v, x)) ∈ P.carrier
    intros w hw
    have pair := product.pair at w, x, M.carrier, N.carrier with hw, hx
    exact FunctionBetween.apply_closed with family, pair
  have function := bilinearLeft.graph_function at B, M.carrier, P.carrier, x with values
  apply LinearMap.of_laws with moduleM, moduleP, function
  . intros v hv w hw
    have ringR := CommRing.to_ring with ringS
    have vw := Module.add_mem at R, M, v, w with ringR, moduleM, hv, hw
    have e1 := bilinearLeft.value at B, M, N, P, R, call2(Module.add(M), v, w), x with ringS, bilinearS, vw, hx
    have e2 := bilinearLeft.value at B, M, N, P, R, v, x with ringS, bilinearS, hv, hx
    have e3 := bilinearLeft.value at B, M, N, P, R, w, x with ringS, bilinearS, hw, hx
    have law := addL with v, hv, w, hw, x, hx
    rw [e1, e2, e3, law]
  . intros r hr v hv
    have ringR := CommRing.to_ring with ringS
    have rv := Module.smul_mem at R, M, r, v with ringR, moduleM, hr, hv
    have e1 := bilinearLeft.value at B, M, N, P, R, call2(Module.smul(M), r, v), x with ringS, bilinearS, rv, hx
    have e2 := bilinearLeft.value at B, M, N, P, R, v, x with ringS, bilinearS, hv, hx
    obtain ⟨law, _⟩ := smulLR with r, hr, v, hv, x, hx
    rw [e1, e2, law]

end Slices

theorem algebraModule.carrier_eq (A : Set)
  shows Module.carrier(algebraModule(A)) = algebraCarrier(A)
proof
  unfold algebraModule
  module_projections

theorem algebraModule.add_eq (A : Set)
  shows Module.add(algebraModule(A)) = Ring.add(Algebra.ring(A))
proof
  unfold algebraModule
  module_projections

theorem algebraModule.smul_eq (A : Set)
  shows Module.smul(algebraModule(A)) = algebraAction(A)
proof
  unfold algebraModule
  module_projections

theorem algebraModule.smul_value (A r a : Set)
  requires algebra : Algebra(A)
  requires hr : r ∈ Ring.carrier(Algebra.base(A))
  requires ha : a ∈ algebraCarrier(A)
  shows call2(Module.smul(algebraModule(A)), r, a) =
    call2(Ring.mul(Algebra.ring(A)), Algebra.map(A)(r), a)
proof
  have cr := Algebra.comm_ring with algebra
  have ringS := CommRing.to_ring with cr
  have values : ∀ r ∈ Ring.carrier(Algebra.base(A)), ∀ a ∈ algebraCarrier(A), call2(Ring.mul(Algebra.ring(A)), Algebra.map(A)(r), a) ∈ algebraCarrier(A)
    intros s hs b hb
    unfold algebraCarrier at hb
    unfold algebraCarrier
    have ms := Algebra.map_mem at A, s with algebra, hs
    exact Ring.mul_mem at Algebra.ring(A), Algebra.map(A)(s), b with ringS, ms, hb
  have e := algebraAction.graph_entry at A, r, a with values, hr, ha
  have se := algebraModule.smul_eq at A
  rw se
  unfold call2 at e
  unfold call2
  exact e

theorem algebraModule.module_of (A : Set)
  requires algebra : Algebra(A)
  shows Module(algebraModule(A), Algebra.base(A))
proof
  have cr := Algebra.comm_ring with algebra
  have br := Algebra.base_comm_ring with algebra
  have hom := Algebra.structure_hom with algebra
  have ringS := CommRing.to_ring with cr
  have ringB := CommRing.to_ring with br
  have parts := Ring.parts with ringS
  obtain ⟨addF, zeroIn, negF, mulF, oneIn⟩ := IsRing.typing_of_parts with parts
  have values : ∀ r ∈ Ring.carrier(Algebra.base(A)), ∀ a ∈ algebraCarrier(A), call2(Ring.mul(Algebra.ring(A)), Algebra.map(A)(r), a) ∈ algebraCarrier(A)
    intros r hr a ha
    unfold algebraCarrier at ha
    unfold algebraCarrier
    have mr := Algebra.map_mem at A, r with algebra, hr
    exact Ring.mul_mem at Algebra.ring(A), Algebra.map(A)(r), a with ringS, mr, ha
  have actF := algebraAction.graph_function at A with values
  have act : ∀ r ∈ Ring.carrier(Algebra.base(A)), ∀ a ∈ algebraCarrier(A), call2(algebraAction(A), r, a) = call2(Ring.mul(Algebra.ring(A)), Algebra.map(A)(r), a)
    intros r hr a ha
    have e := algebraAction.graph_entry at A, r, a with values, hr, ha
    unfold call2 at e
    unfold call2
    exact e
  unfold algebraModule
  unfold algebraCarrier
  unfold algebraCarrier at actF
  unfold algebraCarrier at act
  apply Module.of_laws with ringB, addF, zeroIn, negF, actF
  . intros x hx y hy z hz
    ring
  . intros x hx y hy
    ring
  . intros x hx
    ring
  . intros x hx
    ring
  . intros r hr v hv w hw
    have vw := Ring.add_mem at Algebra.ring(A), v, w with ringS, hv, hw
    have mr := Algebra.map_mem at A, r with algebra, hr
    rw [(act with r, hr, call2(Ring.add(Algebra.ring(A)), v, w), vw), (act with r, hr, v, hv), (act with r, hr, w, hw)]
    ring
  . intros r hr s hs v hv
    have rs := Ring.add_mem at Algebra.base(A), r, s with ringB, hr, hs
    have mr := Algebra.map_mem at A, r with algebra, hr
    have ms := Algebra.map_mem at A, s with algebra, hs
    have e := RingHom.map_add at Algebra.map(A), Algebra.base(A), Algebra.ring(A), r, s with hom, hr, hs
    rw [(act with call2(Ring.add(Algebra.base(A)), r, s), rs, v, hv), (act with r, hr, v, hv), (act with s, hs, v, hv), e]
    ring
  . intros r hr s hs v hv
    have rs := Ring.mul_mem at Algebra.base(A), r, s with ringB, hr, hs
    have mr := Algebra.map_mem at A, r with algebra, hr
    have ms := Algebra.map_mem at A, s with algebra, hs
    have sv := Ring.mul_mem at Algebra.ring(A), Algebra.map(A)(s), v with ringS, ms, hv
    have e := RingHom.map_mul at Algebra.map(A), Algebra.base(A), Algebra.ring(A), r, s with hom, hr, hs
    rw [(act with call2(Ring.mul(Algebra.base(A)), r, s), rs, v, hv), (act with s, hs, v, hv), (act with r, hr, call2(Ring.mul(Algebra.ring(A)), Algebra.map(A)(s), v), sv), e]
    ring
  . intros v hv
    have one := Ring.one_mem at Algebra.base(A) with ringB
    have e := RingHom.map_one at Algebra.map(A), Algebra.base(A), Algebra.ring(A) with hom
    rw [(act with Ring.one(Algebra.base(A)), one, v, hv), e]
    ring

theorem algebraMultiplication.value (A a b : Set)
  requires algebra : Algebra(A)
  requires ha : a ∈ algebraCarrier(A)
  requires hb : b ∈ algebraCarrier(A)
  shows algebraMultiplication(A, a)(b) = call2(Ring.mul(Algebra.ring(A)), a, b)
proof
  have cr := Algebra.comm_ring with algebra
  have ringS := CommRing.to_ring with cr
  have values : ∀ b ∈ algebraCarrier(A), call2(Ring.mul(Algebra.ring(A)), a, b) ∈ algebraCarrier(A)
    intros c hc
    unfold algebraCarrier at hc
    unfold algebraCarrier at ha
    unfold algebraCarrier
    exact Ring.mul_mem at Algebra.ring(A), a, c with ringS, ha, hc
  exact algebraMultiplication.graph_apply at A, a, b with values, hb

theorem algebraMultiplication.linear (A a : Set)
  requires algebra : Algebra(A)
  requires ha : a ∈ algebraCarrier(A)
  shows LinearMap(algebraMultiplication(A, a), algebraModule(A), Algebra.base(A), algebraModule(A))
proof
  have cr := Algebra.comm_ring with algebra
  have ringS := CommRing.to_ring with cr
  have moduleA := algebraModule.module_of at A with algebra
  have ce := algebraModule.carrier_eq at A
  have ae := algebraModule.add_eq at A
  have values : ∀ b ∈ algebraCarrier(A), call2(Ring.mul(Algebra.ring(A)), a, b) ∈ algebraCarrier(A)
    intros c hc
    unfold algebraCarrier at hc
    unfold algebraCarrier at ha
    unfold algebraCarrier
    exact Ring.mul_mem at Algebra.ring(A), a, c with ringS, ha, hc
  have function := algebraMultiplication.graph_function at A, a with values
  rw ← ce at function
  apply LinearMap.of_laws with moduleA, moduleA, function
  . rw [ce, ae]
    intros v hv w hw
    have vw : call2(Ring.add(Algebra.ring(A)), v, w) ∈ algebraCarrier(A)
      unfold algebraCarrier at hv
      unfold algebraCarrier at hw
      unfold algebraCarrier
      exact Ring.add_mem at Algebra.ring(A), v, w with ringS, hv, hw
    have e1 := algebraMultiplication.value at A, a, call2(Ring.add(Algebra.ring(A)), v, w) with algebra, ha, vw
    have e2 := algebraMultiplication.value at A, a, v with algebra, ha, hv
    have e3 := algebraMultiplication.value at A, a, w with algebra, ha, hw
    rw [e1, e2, e3]
    unfold algebraCarrier at hv
    unfold algebraCarrier at hw
    unfold algebraCarrier at ha
    ring
  . rw ce
    intros r hr v hv
    have mr := Algebra.map_mem at A, r with algebra, hr
    have rv := algebraModule.smul_value at A, r, v with algebra, hr, hv
    have av := values with v, hv
    have e0 := algebraModule.smul_value at A, r, call2(Ring.mul(Algebra.ring(A)), a, v) with algebra, hr, av
    have rvIn : call2(Ring.mul(Algebra.ring(A)), Algebra.map(A)(r), v) ∈ algebraCarrier(A)
      unfold algebraCarrier at hv
      unfold algebraCarrier
      exact Ring.mul_mem at Algebra.ring(A), Algebra.map(A)(r), v with ringS, mr, hv
    have e1 := algebraMultiplication.value at A, a, call2(Ring.mul(Algebra.ring(A)), Algebra.map(A)(r), v) with algebra, ha, rvIn
    have e2 := algebraMultiplication.value at A, a, v with algebra, ha, hv
    rw [rv, e1, e2, e0]
    unfold algebraCarrier at hv
    unfold algebraCarrier at ha
    ring

theorem algebraModule.mem (A a : Set)
  requires ha : a ∈ algebraCarrier(A)
  shows a ∈ Module.carrier(algebraModule(A))
proof
  have ce := algebraModule.carrier_eq at A
  rw ce
  exact ha

theorem algebraCarrier.mul_mem (A a b : Set)
  requires algebra : Algebra(A)
  requires ha : a ∈ algebraCarrier(A)
  requires hb : b ∈ algebraCarrier(A)
  shows call2(Ring.mul(Algebra.ring(A)), a, b) ∈ algebraCarrier(A)
proof
  have cr := Algebra.comm_ring with algebra
  have ringS := CommRing.to_ring with cr
  unfold algebraCarrier at ha
  unfold algebraCarrier at hb
  unfold algebraCarrier
  exact Ring.mul_mem at Algebra.ring(A), a, b with ringS, ha, hb

theorem algebraCarrier.add_mem (A a b : Set)
  requires algebra : Algebra(A)
  requires ha : a ∈ algebraCarrier(A)
  requires hb : b ∈ algebraCarrier(A)
  shows call2(Ring.add(Algebra.ring(A)), a, b) ∈ algebraCarrier(A)
proof
  have cr := Algebra.comm_ring with algebra
  have ringS := CommRing.to_ring with cr
  unfold algebraCarrier at ha
  unfold algebraCarrier at hb
  unfold algebraCarrier
  exact Ring.add_mem at Algebra.ring(A), a, b with ringS, ha, hb

theorem algebraCarrier.map_mem (A r : Set)
  requires algebra : Algebra(A)
  requires hr : r ∈ Ring.carrier(Algebra.base(A))
  shows Algebra.map(A)(r) ∈ algebraCarrier(A)
proof
  have m := Algebra.map_mem at A, r with algebra, hr
  unfold algebraCarrier
  exact m

theorem baseChangeAction.graph_relates (A M a t : Set)
  requires rowIn : a ∈ algebraCarrier(A)
  requires colIn : t ∈ Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), M))
  requires valueIn : rightTensor(algebraModule(A), Algebra.base(A), M, algebraModule(A), algebraMultiplication(A, a))(t) ∈ Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), M))
  shows relates(baseChangeAction(A, M), (a, t), rightTensor(algebraModule(A), Algebra.base(A), M, algebraModule(A), algebraMultiplication(A, a))(t))
proof
  have pairIn := product.pair at a, t, algebraCarrier(A), Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), M)) with rowIn, colIn
  have outer := product.pair at (a, t), rightTensor(algebraModule(A), Algebra.base(A), M, algebraModule(A), algebraMultiplication(A, a))(t), algebraCarrier(A) × Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), M)), Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), M)) with pairIn, valueIn
  unfold relates
  apply baseChangeAction.membership.backward
  exact ⟨outer, a, rowIn, t, colIn, rfl⟩

theorem baseChangeAction.graph_function (A M : Set)
  requires values : ∀ a ∈ algebraCarrier(A), ∀ t ∈ Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), M)), rightTensor(algebraModule(A), Algebra.base(A), M, algebraModule(A), algebraMultiplication(A, a))(t) ∈ Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), M))
  shows baseChangeAction(A, M) : algebraCarrier(A) × Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), M)) → Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), M))
proof
  constructor
    intros q0 member
    obtain ⟨bounded, witnesses⟩ := baseChangeAction.membership.forward with member
    exact bounded
  . constructor
      intros z0 first xFirst second xSecond
      unfold relates at xFirst
      obtain ⟨_, a1, a1In, b1, b1In, firstShape⟩ := baseChangeAction.membership.forward with xFirst
      unfold relates at xSecond
      obtain ⟨_, a2, a2In, b2, b2In, secondShape⟩ := baseChangeAction.membership.forward with xSecond
      obtain ⟨xi, firstEqual⟩ := orderedPair.injective with firstShape
      obtain ⟨xj, secondEqual⟩ := orderedPair.injective with secondShape
      rw xi at xj
      obtain ⟨aa, bb⟩ := orderedPair.injective with xj
      rw [firstEqual, secondEqual]
      cc
    . intros q0 pIn
      obtain ⟨bound, a, rowIn, t, colIn, shape⟩ := product.membership.forward with pIn
      have valueIn := values with a, rowIn, t, colIn
      have mapped := baseChangeAction.graph_relates at A, M, a, t with rowIn, colIn, valueIn
      rw shape
      exact ⟨rightTensor(algebraModule(A), Algebra.base(A), M, algebraModule(A), algebraMultiplication(A, a))(t), valueIn, mapped⟩

theorem baseChangeAction.graph_entry (A M a t : Set)
  requires values : ∀ a ∈ algebraCarrier(A), ∀ t ∈ Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), M)), rightTensor(algebraModule(A), Algebra.base(A), M, algebraModule(A), algebraMultiplication(A, a))(t) ∈ Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), M))
  requires rowIn : a ∈ algebraCarrier(A)
  requires colIn : t ∈ Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), M))
  shows baseChangeAction(A, M)((a, t)) = rightTensor(algebraModule(A), Algebra.base(A), M, algebraModule(A), algebraMultiplication(A, a))(t)
proof
  have function := baseChangeAction.graph_function at A, M with values
  have valueIn := values with a, rowIn, t, colIn
  have mapped := baseChangeAction.graph_relates at A, M, a, t with rowIn, colIn, valueIn
  have pairIn := product.pair at a, t, algebraCarrier(A), Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), M)) with rowIn, colIn
  exact FunctionBetween.apply_value with function, pairIn, mapped


theorem restrictedModule.carrier_eq (A N : Set)
  shows Module.carrier(restrictedModule(A, N)) = Module.carrier(N)
proof
  unfold restrictedModule
  module_projections

theorem restrictedModule.add_eq (A N : Set)
  shows Module.add(restrictedModule(A, N)) = Module.add(N)
proof
  unfold restrictedModule
  module_projections

theorem restrictedModule.smul_value (A N r x : Set)
  requires algebra : Algebra(A)
  requires moduleN : Module(N, Algebra.ring(A))
  requires hr : r ∈ Ring.carrier(Algebra.base(A))
  requires hx : x ∈ Module.carrier(N)
  shows call2(Module.smul(restrictedModule(A, N)), r, x) = call2(Module.smul(N), Algebra.map(A)(r), x)
proof
  have cr := Algebra.comm_ring at A with algebra
  have ringS := CommRing.to_ring with cr
  have values : ∀ r ∈ Ring.carrier(Algebra.base(A)), ∀ x ∈ Module.carrier(N), call2(Module.smul(N), Algebra.map(A)(r), x) ∈ Module.carrier(N)
    intros s hs y hy
    have ms := Algebra.map_mem at A, s with algebra, hs
    exact Module.smul_mem at Algebra.ring(A), N, Algebra.map(A)(s), y with ringS, moduleN, ms, hy
  have e := restrictedAction.graph_entry at A, N, r, x with values, hr, hx
  have se : Module.smul(restrictedModule(A, N)) = restrictedAction(A, N)
    unfold restrictedModule
    module_projections
  rw se
  unfold call2 at e
  unfold call2
  exact e

theorem baseChangeUnit.graph_relates (A M m : Set)
  requires index : m ∈ Module.carrier(M)
  requires valueIn : tmul(algebraModule(A), Algebra.base(A), M, Ring.one(Algebra.ring(A)), m) ∈ Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), M))
  shows relates(baseChangeUnit(A, M), m, tmul(algebraModule(A), Algebra.base(A), M, Ring.one(Algebra.ring(A)), m))
proof
  unfold relates
  apply baseChangeUnit.membership.backward
  refine ⟨(product.pair at m, tmul(algebraModule(A), Algebra.base(A), M, Ring.one(Algebra.ring(A)), m), Module.carrier(M), Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), M)) with index, valueIn), m, index, rfl⟩

theorem baseChangeUnit.graph_function (A M : Set)
  requires values : ∀ m ∈ Module.carrier(M), tmul(algebraModule(A), Algebra.base(A), M, Ring.one(Algebra.ring(A)), m) ∈ Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), M))
  shows baseChangeUnit(A, M) : Module.carrier(M) → Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), M))
proof
  constructor
    intros q0 member
    obtain ⟨bounded, witnesses⟩ := baseChangeUnit.membership.forward with member
    exact bounded
  . constructor
      intros z0 first xFirst second xSecond
      unfold relates at xFirst
      obtain ⟨_, a1, a1In, firstShape⟩ := baseChangeUnit.membership.forward with xFirst
      unfold relates at xSecond
      obtain ⟨_, a2, a2In, secondShape⟩ := baseChangeUnit.membership.forward with xSecond
      obtain ⟨xi, firstEqual⟩ := orderedPair.injective with firstShape
      obtain ⟨xj, secondEqual⟩ := orderedPair.injective with secondShape
      rw [firstEqual, secondEqual]
      cc
    . intros m xIn
      have valueIn := values with m, xIn
      refine ⟨tmul(algebraModule(A), Algebra.base(A), M, Ring.one(Algebra.ring(A)), m), valueIn, (baseChangeUnit.graph_relates at A, M, m with xIn, valueIn)⟩

theorem baseChangeUnit.graph_apply (A M m : Set)
  requires values : ∀ m ∈ Module.carrier(M), tmul(algebraModule(A), Algebra.base(A), M, Ring.one(Algebra.ring(A)), m) ∈ Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), M))
  requires index : m ∈ Module.carrier(M)
  shows baseChangeUnit(A, M)(m) = tmul(algebraModule(A), Algebra.base(A), M, Ring.one(Algebra.ring(A)), m)
proof
  have function := baseChangeUnit.graph_function at A, M with values
  have valueIn := values with m, index
  have mapped := baseChangeUnit.graph_relates at A, M, m with index, valueIn
  exact FunctionBetween.apply_value with function, index, mapped

-- Section: Laws of base change
section BaseChange
variable (A M : Set)
hypothesis algebra : Algebra(A)
hypothesis module : Module(M, Algebra.base(A))

theorem algebraModule.module
  shows Module(algebraModule(A), Algebra.base(A))
proof
  exact algebraModule.module_of at A with algebra

theorem restrictedModule.module (N : Set)
  requires moduleN : Module(N, Algebra.ring(A))
  shows Module(restrictedModule(A, N), Algebra.base(A))
proof
  have cr := Algebra.comm_ring with algebra
  have br := Algebra.base_comm_ring with algebra
  have hom := Algebra.structure_hom with algebra
  have ringS := CommRing.to_ring with cr
  have ringB := CommRing.to_ring with br
  obtain ⟨_, _, addF, zeroIn, negF, smulF, _⟩ := moduleN
  have values : ∀ r ∈ Ring.carrier(Algebra.base(A)), ∀ x ∈ Module.carrier(N), call2(Module.smul(N), Algebra.map(A)(r), x) ∈ Module.carrier(N)
    intros r hr x hx
    have mr := Algebra.map_mem at A, r with algebra, hr
    exact Module.smul_mem at Algebra.ring(A), N, Algebra.map(A)(r), x with ringS, moduleN, mr, hx
  have actF := restrictedAction.graph_function at A, N with values
  have act : ∀ r ∈ Ring.carrier(Algebra.base(A)), ∀ x ∈ Module.carrier(N), call2(restrictedAction(A, N), r, x) = call2(Module.smul(N), Algebra.map(A)(r), x)
    intros r hr x hx
    have e := restrictedAction.graph_entry at A, N, r, x with values, hr, hx
    unfold call2 at e
    unfold call2
    exact e
  unfold restrictedModule
  apply Module.of_laws with ringB, addF, zeroIn, negF, actF
  . intros x hx y hy z hz
    exact Module.add_assoc at Algebra.ring(A), N, x, y, z with ringS, moduleN, hx, hy, hz
  . intros x hx y hy
    exact Module.add_comm at Algebra.ring(A), N, x, y with ringS, moduleN, hx, hy
  . intros x hx
    exact Module.zero_add at Algebra.ring(A), N, x with ringS, moduleN, hx
  . intros x hx
    exact Module.neg_add at Algebra.ring(A), N, x with ringS, moduleN, hx
  . intros r hr v hv w hw
    have vw := Module.add_mem at Algebra.ring(A), N, v, w with ringS, moduleN, hv, hw
    have mr := Algebra.map_mem at A, r with algebra, hr
    rw [(act with r, hr, call2(Module.add(N), v, w), vw), (act with r, hr, v, hv), (act with r, hr, w, hw)]
    exact smul_add at Algebra.ring(A), N, Algebra.map(A)(r), v, w with ringS, moduleN, mr, hv, hw
  . intros r hr s hs v hv
    have rs := Ring.add_mem at Algebra.base(A), r, s with ringB, hr, hs
    have mr := Algebra.map_mem at A, r with algebra, hr
    have ms := Algebra.map_mem at A, s with algebra, hs
    have e := RingHom.map_add at Algebra.map(A), Algebra.base(A), Algebra.ring(A), r, s with hom, hr, hs
    rw [(act with call2(Ring.add(Algebra.base(A)), r, s), rs, v, hv), (act with r, hr, v, hv), (act with s, hs, v, hv), e]
    exact add_smul at Algebra.ring(A), N, Algebra.map(A)(r), Algebra.map(A)(s), v with ringS, moduleN, mr, ms, hv
  . intros r hr s hs v hv
    have rs := Ring.mul_mem at Algebra.base(A), r, s with ringB, hr, hs
    have mr := Algebra.map_mem at A, r with algebra, hr
    have ms := Algebra.map_mem at A, s with algebra, hs
    have sv := Module.smul_mem at Algebra.ring(A), N, Algebra.map(A)(s), v with ringS, moduleN, ms, hv
    have e := RingHom.map_mul at Algebra.map(A), Algebra.base(A), Algebra.ring(A), r, s with hom, hr, hs
    rw [(act with call2(Ring.mul(Algebra.base(A)), r, s), rs, v, hv), (act with s, hs, v, hv), (act with r, hr, call2(Module.smul(N), Algebra.map(A)(s), v), sv), e]
    exact mul_smul at Algebra.ring(A), N, Algebra.map(A)(r), Algebra.map(A)(s), v with ringS, moduleN, mr, ms, hv
  . intros v hv
    have one := Ring.one_mem at Algebra.base(A) with ringB
    have e := RingHom.map_one at Algebra.map(A), Algebra.base(A), Algebra.ring(A) with hom
    rw [(act with Ring.one(Algebra.base(A)), one, v, hv), e]
    exact one_smul at Algebra.ring(A), N, v with ringS, moduleN, hv

theorem baseChange.setup
  shows CommRing(Algebra.base(A)) ∧ Module(algebraModule(A), Algebra.base(A)) ∧ Module(tensorProduct(algebraModule(A), Algebra.base(A), M), Algebra.base(A)) ∧ Ring(Algebra.ring(A))
proof
  have ringK := Algebra.base_comm_ring at A with algebra
  have mA := algebraModule.module_of at A with algebra
  have tp := tensorProduct.module at Algebra.base(A), algebraModule(A), M with ringK, mA, module
  have cr := Algebra.comm_ring at A with algebra
  have ringS := CommRing.to_ring with cr
  exact ⟨ringK, mA, tp, ringS⟩

theorem baseChangeRho.parts (a : Set)
  requires ha : a ∈ algebraCarrier(A)
  shows LinearMap(rightTensor(algebraModule(A), Algebra.base(A), M, algebraModule(A), algebraMultiplication(A, a)), tensorProduct(algebraModule(A), Algebra.base(A), M), Algebra.base(A), tensorProduct(algebraModule(A), Algebra.base(A), M)) ∧
    (∀ b ∈ algebraCarrier(A), ∀ m ∈ M.carrier, rightTensor(algebraModule(A), Algebra.base(A), M, algebraModule(A), algebraMultiplication(A, a))(tmul(algebraModule(A), Algebra.base(A), M, b, m)) = tmul(algebraModule(A), Algebra.base(A), M, call2(Ring.mul(Algebra.ring(A)), a, b), m))
proof
  obtain ⟨ringK, mA, tp, ringS⟩ := baseChange.setup at A, M with algebra, module
  have la := algebraMultiplication.linear at A, a with algebra, ha
  obtain ⟨lin, val⟩ := rightTensor.parts at Algebra.base(A), algebraModule(A), M, algebraModule(A), algebraMultiplication(A, a) with ringK, mA, module, la
  refine ⟨lin, ?_⟩
  intros b hb m hm
  have hb2 := algebraModule.mem at A, b with hb
  have v := val with b, hb2, m, hm
  have w := algebraMultiplication.value at A, a, b with algebra, ha, hb
  rw [v, w]

theorem baseChange.smul_value (a t : Set)
  requires ha : a ∈ algebraCarrier(A)
  requires ht : t ∈ Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), M))
  shows call2(Module.smul(baseChange(A, M)), a, t) = rightTensor(algebraModule(A), Algebra.base(A), M, algebraModule(A), algebraMultiplication(A, a))(t)
proof
  have values : ∀ a ∈ algebraCarrier(A), ∀ t ∈ Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), M)), rightTensor(algebraModule(A), Algebra.base(A), M, algebraModule(A), algebraMultiplication(A, a))(t) ∈ Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), M))
    intros c hc u hu
    obtain ⟨lin, _⟩ := baseChangeRho.parts at A, M, c with algebra, module, hc
    exact LinearMap.value_mem with lin, hu
  have e := baseChangeAction.graph_entry at A, M, a, t with values, ha, ht
  have se : Module.smul(baseChange(A, M)) = baseChangeAction(A, M)
    unfold baseChange
    module_projections
  rw se
  unfold call2
  exact e

theorem baseChange.carrier_eq
  shows Module.carrier(baseChange(A, M)) = Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), M))
proof
  unfold baseChange
  module_projections

theorem baseChange.add_eq
  shows Module.add(baseChange(A, M)) = Module.add(tensorProduct(algebraModule(A), Algebra.base(A), M))
proof
  unfold baseChange
  module_projections

theorem baseChange.module
  shows Module(baseChange(A, M), Algebra.ring(A))
proof
  obtain ⟨ringK, mA, tp, ringS⟩ := baseChange.setup at A, M with algebra, module
  have values : ∀ a ∈ algebraCarrier(A), ∀ t ∈ Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), M)), rightTensor(algebraModule(A), Algebra.base(A), M, algebraModule(A), algebraMultiplication(A, a))(t) ∈ Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), M))
    intros c hc u hu
    obtain ⟨lin, _⟩ := baseChangeRho.parts at A, M, c with algebra, module, hc
    exact LinearMap.value_mem with lin, hu
  have actF := baseChangeAction.graph_function at A, M with values
  unfold algebraCarrier at actF
  have act : ∀ a ∈ Ring.carrier(Algebra.ring(A)), ∀ t ∈ Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), M)), call2(baseChangeAction(A, M), a, t) = rightTensor(algebraModule(A), Algebra.base(A), M, algebraModule(A), algebraMultiplication(A, a))(t)
    intros c hc u hu
    have hc2 : c ∈ algebraCarrier(A)
      unfold algebraCarrier
      exact hc
    have e := baseChangeAction.graph_entry at A, M, c, u with values, hc2, hu
    unfold call2
    exact e
  have ringR := CommRing.to_ring with ringK
  obtain ⟨_, _, addF, zeroIn, negF, _, _⟩ := tp
  have tp2 := tensorProduct.module at Algebra.base(A), algebraModule(A), M with ringK, mA, module
  unfold baseChange
  apply Module.of_laws with ringS, addF, zeroIn, negF, actF
  . intros x hx y hy z hz
    exact Module.add_assoc at Algebra.base(A), tensorProduct(algebraModule(A), Algebra.base(A), M), x, y, z with ringR, tp2, hx, hy, hz
  . intros x hx y hy
    exact Module.add_comm at Algebra.base(A), tensorProduct(algebraModule(A), Algebra.base(A), M), x, y with ringR, tp2, hx, hy
  . intros x hx
    exact Module.zero_add at Algebra.base(A), tensorProduct(algebraModule(A), Algebra.base(A), M), x with ringR, tp2, hx
  . intros x hx
    exact Module.neg_add at Algebra.base(A), tensorProduct(algebraModule(A), Algebra.base(A), M), x with ringR, tp2, hx
  . intros a ha v hv w hw
    have vw := Module.add_mem at Algebra.base(A), tensorProduct(algebraModule(A), Algebra.base(A), M), v, w with ringR, tp2, hv, hw
    have ha2 : a ∈ algebraCarrier(A)
      unfold algebraCarrier
      exact ha
    obtain ⟨lin, _⟩ := baseChangeRho.parts at A, M, a with algebra, module, ha2
    rw [(act with a, ha, call2(Module.add(tensorProduct(algebraModule(A), Algebra.base(A), M)), v, w), vw), (act with a, ha, v, hv), (act with a, ha, w, hw)]
    exact LinearMap.add_law with lin, hv, hw
  . intros a ha b hb v hv
    have ha2 : a ∈ algebraCarrier(A)
      unfold algebraCarrier
      exact ha
    have hb2 : b ∈ algebraCarrier(A)
      unfold algebraCarrier
      exact hb
    have ab := algebraCarrier.add_mem at A, a, b with algebra, ha2, hb2
    have ab1 : call2(Ring.add(Algebra.ring(A)), a, b) ∈ Ring.carrier(Algebra.ring(A))
      unfold algebraCarrier at ab
      exact ab
    obtain ⟨la, va⟩ := baseChangeRho.parts at A, M, a with algebra, module, ha2
    obtain ⟨lb, vb⟩ := baseChangeRho.parts at A, M, b with algebra, module, hb2
    obtain ⟨lab, vab⟩ := baseChangeRho.parts at A, M, call2(Ring.add(Algebra.ring(A)), a, b) with algebra, module, ab
    have sumL := LinearMap.pointwise_add at rightTensor(algebraModule(A), Algebra.base(A), M, algebraModule(A), algebraMultiplication(A, a)), rightTensor(algebraModule(A), Algebra.base(A), M, algebraModule(A), algebraMultiplication(A, b)), tensorProduct(algebraModule(A), Algebra.base(A), M), Algebra.base(A), tensorProduct(algebraModule(A), Algebra.base(A), M) with la, lb
    have fa := functionSpace.mem_iff.backward with (LinearMap.function_of with la)
    have fb := functionSpace.mem_iff.backward with (LinearMap.function_of with lb)
    have agree : ∀ x ∈ Module.carrier(algebraModule(A)), ∀ m ∈ M.carrier, rightTensor(algebraModule(A), Algebra.base(A), M, algebraModule(A), algebraMultiplication(A, call2(Ring.add(Algebra.ring(A)), a, b)))(tmul(algebraModule(A), Algebra.base(A), M, x, m)) = pointwiseSum(Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), M)), tensorProduct(algebraModule(A), Algebra.base(A), M), rightTensor(algebraModule(A), Algebra.base(A), M, algebraModule(A), algebraMultiplication(A, a)), rightTensor(algebraModule(A), Algebra.base(A), M, algebraModule(A), algebraMultiplication(A, b)))(tmul(algebraModule(A), Algebra.base(A), M, x, m))
      intros x hx m hm
      have tIn := tmul.mem at Algebra.base(A), algebraModule(A), M, x, m with ringK, mA, module, hx, hm
      have ce := algebraModule.carrier_eq at A
      rw ce at hx
      have p := pointwiseSum.at at Algebra.base(A), Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), M)), tensorProduct(algebraModule(A), Algebra.base(A), M), rightTensor(algebraModule(A), Algebra.base(A), M, algebraModule(A), algebraMultiplication(A, a)), rightTensor(algebraModule(A), Algebra.base(A), M, algebraModule(A), algebraMultiplication(A, b)), tmul(algebraModule(A), Algebra.base(A), M, x, m) with tp2, fa, fb, tIn
      have e1 := vab with x, hx, m, hm
      have e2 := va with x, hx, m, hm
      have e3 := vb with x, hx, m, hm
      have ax := algebraCarrier.mul_mem at A, a, x with algebra, ha2, hx
      have bx := algebraCarrier.mul_mem at A, b, x with algebra, hb2, hx
      have ax2 := algebraModule.mem at A, call2(Ring.mul(Algebra.ring(A)), a, x) with ax
      have bx2 := algebraModule.mem at A, call2(Ring.mul(Algebra.ring(A)), b, x) with bx
      have t := tmul.add_left at Algebra.base(A), algebraModule(A), M, call2(Ring.mul(Algebra.ring(A)), a, x), call2(Ring.mul(Algebra.ring(A)), b, x), m with ringK, mA, module, ax2, bx2, hm
      have ae := algebraModule.add_eq at A
      rw ae at t
      have dist : call2(Ring.mul(Algebra.ring(A)), call2(Ring.add(Algebra.ring(A)), a, b), x) = call2(Ring.add(Algebra.ring(A)), call2(Ring.mul(Algebra.ring(A)), a, x), call2(Ring.mul(Algebra.ring(A)), b, x))
        have cr := Algebra.comm_ring at A with algebra
        unfold algebraCarrier at ha2
        unfold algebraCarrier at hb2
        unfold algebraCarrier at hx
        ring
      rw [p, e1, e2, e3, dist, t]
    have same := tensorProduct.ext_pure at Algebra.base(A), algebraModule(A), M, tensorProduct(algebraModule(A), Algebra.base(A), M), rightTensor(algebraModule(A), Algebra.base(A), M, algebraModule(A), algebraMultiplication(A, call2(Ring.add(Algebra.ring(A)), a, b))), pointwiseSum(Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), M)), tensorProduct(algebraModule(A), Algebra.base(A), M), rightTensor(algebraModule(A), Algebra.base(A), M, algebraModule(A), algebraMultiplication(A, a)), rightTensor(algebraModule(A), Algebra.base(A), M, algebraModule(A), algebraMultiplication(A, b))) with ringK, mA, module, lab, sumL, agree
    rw [(act with call2(Ring.add(Algebra.ring(A)), a, b), ab1, v, hv), (act with a, ha, v, hv), (act with b, hb, v, hv), same]
    exact pointwiseSum.at at Algebra.base(A), Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), M)), tensorProduct(algebraModule(A), Algebra.base(A), M), rightTensor(algebraModule(A), Algebra.base(A), M, algebraModule(A), algebraMultiplication(A, a)), rightTensor(algebraModule(A), Algebra.base(A), M, algebraModule(A), algebraMultiplication(A, b)), v with tp2, fa, fb, hv
  . intros a ha b hb v hv
    have ha2 : a ∈ algebraCarrier(A)
      unfold algebraCarrier
      exact ha
    have hb2 : b ∈ algebraCarrier(A)
      unfold algebraCarrier
      exact hb
    have ab := algebraCarrier.mul_mem at A, a, b with algebra, ha2, hb2
    have ab1 : call2(Ring.mul(Algebra.ring(A)), a, b) ∈ Ring.carrier(Algebra.ring(A))
      unfold algebraCarrier at ab
      exact ab
    obtain ⟨la, va⟩ := baseChangeRho.parts at A, M, a with algebra, module, ha2
    obtain ⟨lb, vb⟩ := baseChangeRho.parts at A, M, b with algebra, module, hb2
    obtain ⟨lab, vab⟩ := baseChangeRho.parts at A, M, call2(Ring.mul(Algebra.ring(A)), a, b) with algebra, module, ab
    have comp := LinearMap.compose at rightTensor(algebraModule(A), Algebra.base(A), M, algebraModule(A), algebraMultiplication(A, b)), rightTensor(algebraModule(A), Algebra.base(A), M, algebraModule(A), algebraMultiplication(A, a)), tensorProduct(algebraModule(A), Algebra.base(A), M), Algebra.base(A), tensorProduct(algebraModule(A), Algebra.base(A), M), tensorProduct(algebraModule(A), Algebra.base(A), M) with lb, la
    have fa := LinearMap.function_of with la
    have fb := LinearMap.function_of with lb
    have bv := LinearMap.value_mem with lb, hv
    have bv1 : rightTensor(algebraModule(A), Algebra.base(A), M, algebraModule(A), algebraMultiplication(A, b))(v) ∈ Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), M)) := bv
    have agree : ∀ x ∈ Module.carrier(algebraModule(A)), ∀ m ∈ M.carrier, rightTensor(algebraModule(A), Algebra.base(A), M, algebraModule(A), algebraMultiplication(A, call2(Ring.mul(Algebra.ring(A)), a, b)))(tmul(algebraModule(A), Algebra.base(A), M, x, m)) = compose(rightTensor(algebraModule(A), Algebra.base(A), M, algebraModule(A), algebraMultiplication(A, a)), rightTensor(algebraModule(A), Algebra.base(A), M, algebraModule(A), algebraMultiplication(A, b)), Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), M)), Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), M)), Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), M)))(tmul(algebraModule(A), Algebra.base(A), M, x, m))
      intros x hx m hm
      have tIn := tmul.mem at Algebra.base(A), algebraModule(A), M, x, m with ringK, mA, module, hx, hm
      have ce := algebraModule.carrier_eq at A
      rw ce at hx
      have c0 := compose.apply at rightTensor(algebraModule(A), Algebra.base(A), M, algebraModule(A), algebraMultiplication(A, a)), rightTensor(algebraModule(A), Algebra.base(A), M, algebraModule(A), algebraMultiplication(A, b)), Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), M)), Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), M)), Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), M)), tmul(algebraModule(A), Algebra.base(A), M, x, m) with fb, fa, tIn
      have bx := algebraCarrier.mul_mem at A, b, x with algebra, hb2, hx
      have e1 := vab with x, hx, m, hm
      have e2 := vb with x, hx, m, hm
      have e3 := va with call2(Ring.mul(Algebra.ring(A)), b, x), bx, m, hm
      have assoc : call2(Ring.mul(Algebra.ring(A)), call2(Ring.mul(Algebra.ring(A)), a, b), x) = call2(Ring.mul(Algebra.ring(A)), a, call2(Ring.mul(Algebra.ring(A)), b, x))
        have cr := Algebra.comm_ring at A with algebra
        unfold algebraCarrier at ha2
        unfold algebraCarrier at hb2
        unfold algebraCarrier at hx
        ring
      rw [c0, e1, e2, e3, assoc]
    have same := tensorProduct.ext_pure at Algebra.base(A), algebraModule(A), M, tensorProduct(algebraModule(A), Algebra.base(A), M), rightTensor(algebraModule(A), Algebra.base(A), M, algebraModule(A), algebraMultiplication(A, call2(Ring.mul(Algebra.ring(A)), a, b))), compose(rightTensor(algebraModule(A), Algebra.base(A), M, algebraModule(A), algebraMultiplication(A, a)), rightTensor(algebraModule(A), Algebra.base(A), M, algebraModule(A), algebraMultiplication(A, b)), Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), M)), Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), M)), Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), M))) with ringK, mA, module, lab, comp, agree
    rw [(act with call2(Ring.mul(Algebra.ring(A)), a, b), ab1, v, hv), (act with b, hb, v, hv), (act with a, ha, rightTensor(algebraModule(A), Algebra.base(A), M, algebraModule(A), algebraMultiplication(A, b))(v), bv1), same]
    exact compose.apply at rightTensor(algebraModule(A), Algebra.base(A), M, algebraModule(A), algebraMultiplication(A, a)), rightTensor(algebraModule(A), Algebra.base(A), M, algebraModule(A), algebraMultiplication(A, b)), Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), M)), Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), M)), Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), M)), v with fb, fa, hv
  . intros v hv
    have one := Ring.one_mem at Algebra.ring(A) with ringS
    have one2 : Ring.one(Algebra.ring(A)) ∈ algebraCarrier(A)
      unfold algebraCarrier
      exact one
    obtain ⟨l1, v1⟩ := baseChangeRho.parts at A, M, Ring.one(Algebra.ring(A)) with algebra, module, one2
    have idT := LinearMap.identity at tensorProduct(algebraModule(A), Algebra.base(A), M), Algebra.base(A) with tp2
    have agree : ∀ x ∈ Module.carrier(algebraModule(A)), ∀ m ∈ M.carrier, rightTensor(algebraModule(A), Algebra.base(A), M, algebraModule(A), algebraMultiplication(A, Ring.one(Algebra.ring(A))))(tmul(algebraModule(A), Algebra.base(A), M, x, m)) = identity(Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), M)))(tmul(algebraModule(A), Algebra.base(A), M, x, m))
      intros x hx m hm
      have tIn := tmul.mem at Algebra.base(A), algebraModule(A), M, x, m with ringK, mA, module, hx, hm
      have ce := algebraModule.carrier_eq at A
      rw ce at hx
      have e1 := v1 with x, hx, m, hm
      have u : call2(Ring.mul(Algebra.ring(A)), Ring.one(Algebra.ring(A)), x) = x
        have cr := Algebra.comm_ring at A with algebra
        unfold algebraCarrier at hx
        ring
      rw [e1, u, identity.apply with tIn]
    have same := tensorProduct.ext_pure at Algebra.base(A), algebraModule(A), M, tensorProduct(algebraModule(A), Algebra.base(A), M), rightTensor(algebraModule(A), Algebra.base(A), M, algebraModule(A), algebraMultiplication(A, Ring.one(Algebra.ring(A)))), identity(Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), M))) with ringK, mA, module, l1, idT, agree
    rw [(act with Ring.one(Algebra.ring(A)), one, v, hv), same, identity.apply with hv]

-- a (b ⊗ m) = (a b) ⊗ m.
theorem baseChange.smul_tmul (a b m : Set)
  requires first : a ∈ algebraCarrier(A)
  requires second : b ∈ algebraCarrier(A)
  requires vector : m ∈ M.carrier
  shows call2(Module.smul(baseChange(A, M)), a,
      tmul(algebraModule(A), Algebra.base(A), M, b, m)) =
    tmul(algebraModule(A), Algebra.base(A), M,
      call2(Ring.mul(Algebra.ring(A)), a, b), m)
proof
  obtain ⟨ringK, mA, tp, ringS⟩ := baseChange.setup at A, M with algebra, module
  have b2 := algebraModule.mem at A, b with second
  have tIn := tmul.mem at Algebra.base(A), algebraModule(A), M, b, m with ringK, mA, module, b2, vector
  have e := baseChange.smul_value at A, M, a, tmul(algebraModule(A), Algebra.base(A), M, b, m) with algebra, module, first, tIn
  obtain ⟨_, val⟩ := baseChangeRho.parts at A, M, a with algebra, module, first
  have v := val with b, second, m, vector
  rw [e, v]

-- A basis v of M gives the basis 1 ⊗ v of A ⊗ M over A
-- (Basis.baseChange).
theorem baseChange.basis (I v : Set)
  requires basis : ModuleBasis(M, Algebra.base(A), I, v)
  shows ModuleBasis(baseChange(A, M), Algebra.ring(A), I,
    compose(baseChangeUnit(A, M), v, I, M.carrier,
      Module.carrier(baseChange(A, M))))
proof
  sorry

theorem liftBaseChangePairs.value (N f a m : Set)
  requires moduleN : Module(N, Algebra.ring(A))
  requires linear : LinearMap(f, M, Algebra.base(A), restrictedModule(A, N))
  requires ha : a ∈ algebraCarrier(A)
  requires hm : m ∈ M.carrier
  shows liftBaseChangePairs(A, M, N, f)((a, m)) = call2(Module.smul(N), a, f(m))
proof
  obtain ⟨ringK, mA, tp, ringS⟩ := baseChange.setup at A, M with algebra, module
  have rN := restrictedModule.module at A, M, N with algebra, module, moduleN
  have ceR := restrictedModule.carrier_eq at A, N
  have aeR := restrictedModule.add_eq at A, N
  have ceA := algebraModule.carrier_eq at A
  have cr := Algebra.comm_ring at A with algebra
  have values : ∀ a ∈ algebraCarrier(A), ∀ m ∈ M.carrier, call2(Module.smul(N), a, f(m)) ∈ Module.carrier(N)
    intros b hb n hn
    have fn := LinearMap.value_mem with linear, hn
    rw ceR at fn
    unfold algebraCarrier at hb
    exact Module.smul_mem at Algebra.ring(A), N, b, f(n) with ringS, moduleN, hb, fn
  exact liftBaseChangePairs.graph_entry at A, M, N, f, a, m with values, ha, hm

theorem liftBaseChangePairs.bilinear (N f : Set)
  requires moduleN : Module(N, Algebra.ring(A))
  requires linear : LinearMap(f, M, Algebra.base(A), restrictedModule(A, N))
  shows BilinearMap(liftBaseChangePairs(A, M, N, f), algebraModule(A), M, restrictedModule(A, N), Algebra.base(A))
proof
  obtain ⟨ringK, mA, tp, ringS⟩ := baseChange.setup at A, M with algebra, module
  have rN := restrictedModule.module at A, M, N with algebra, module, moduleN
  have ceR := restrictedModule.carrier_eq at A, N
  have aeR := restrictedModule.add_eq at A, N
  have ceA := algebraModule.carrier_eq at A
  have cr := Algebra.comm_ring at A with algebra
  have values : ∀ a ∈ algebraCarrier(A), ∀ m ∈ M.carrier, call2(Module.smul(N), a, f(m)) ∈ Module.carrier(N)
    intros b hb n hn
    have fn := LinearMap.value_mem with linear, hn
    rw ceR at fn
    unfold algebraCarrier at hb
    exact Module.smul_mem at Algebra.ring(A), N, b, f(n) with ringS, moduleN, hb, fn
  have function := liftBaseChangePairs.graph_function at A, M, N, f with values
  rw [← ceA, ← ceR] at function
  have ringR := CommRing.to_ring with ringK
  have aeA := algebraModule.add_eq at A
  unfold BilinearMap
  refine ⟨mA, module, rN, function, ?_, ?_, ?_⟩
  . intros v hv w hw x hx
    rw ceA at hv
    rw ceA at hw
    rw [aeA, aeR]
    have vw := algebraCarrier.add_mem at A, v, w with algebra, hv, hw
    have e1 := liftBaseChangePairs.value at A, M, N, f, call2(Ring.add(Algebra.ring(A)), v, w), x with algebra, module, moduleN, linear, vw, hx
    have e2 := liftBaseChangePairs.value at A, M, N, f, v, x with algebra, module, moduleN, linear, hv, hx
    have e3 := liftBaseChangePairs.value at A, M, N, f, w, x with algebra, module, moduleN, linear, hw, hx
    have fx := LinearMap.value_mem with linear, hx
    rw ceR at fx
    unfold algebraCarrier at hv
    unfold algebraCarrier at hw
    have law := add_smul at Algebra.ring(A), N, v, w, f(x) with ringS, moduleN, hv, hw, fx
    rw [e1, e2, e3, law]
  . intros v hv x hx y hy
    rw ceA at hv
    rw aeR
    have xy := Module.add_mem at Algebra.base(A), M, x, y with ringR, module, hx, hy
    have e1 := liftBaseChangePairs.value at A, M, N, f, v, call2(Module.add(M), x, y) with algebra, module, moduleN, linear, hv, xy
    have e2 := liftBaseChangePairs.value at A, M, N, f, v, x with algebra, module, moduleN, linear, hv, hx
    have e3 := liftBaseChangePairs.value at A, M, N, f, v, y with algebra, module, moduleN, linear, hv, hy
    have fa := LinearMap.add_law with linear, hx, hy
    rw aeR at fa
    have fx := LinearMap.value_mem with linear, hx
    have fy := LinearMap.value_mem with linear, hy
    rw ceR at fx
    rw ceR at fy
    unfold algebraCarrier at hv
    have law := smul_add at Algebra.ring(A), N, v, f(x), f(y) with ringS, moduleN, hv, fx, fy
    rw [e1, e2, e3, fa, law]
  . intros r hr v hv x hx
    rw ceA at hv
    have mr := Algebra.map_mem at A, r with algebra, hr
    have sv := algebraModule.smul_value at A, r, v with algebra, hr, hv
    have mra := algebraCarrier.map_mem at A, r with algebra, hr
    have rv := algebraCarrier.mul_mem at A, Algebra.map(A)(r), v with algebra, mra, hv
    have rx := Module.smul_mem at Algebra.base(A), M, r, x with ringR, module, hr, hx
    have e1 := liftBaseChangePairs.value at A, M, N, f, call2(Ring.mul(Algebra.ring(A)), Algebra.map(A)(r), v), x with algebra, module, moduleN, linear, rv, hx
    have e2 := liftBaseChangePairs.value at A, M, N, f, v, x with algebra, module, moduleN, linear, hv, hx
    have e3 := liftBaseChangePairs.value at A, M, N, f, v, call2(Module.smul(M), r, x) with algebra, module, moduleN, linear, hv, rx
    have fx := LinearMap.value_mem with linear, hx
    rw ceR at fx
    unfold algebraCarrier at hv
    have vfx := Module.smul_mem at Algebra.ring(A), N, v, f(x) with ringS, moduleN, hv, fx
    have r1 := restrictedModule.smul_value at A, N, r, call2(Module.smul(N), v, f(x)) with algebra, moduleN, hr, vfx
    have fs := LinearMap.smul_law with linear, hr, hx
    have r2 := restrictedModule.smul_value at A, N, r, f(x) with algebra, moduleN, hr, fx
    have m1 := mul_smul at Algebra.ring(A), N, Algebra.map(A)(r), v, f(x) with ringS, moduleN, mr, hv, fx
    have m2 := mul_smul at Algebra.ring(A), N, v, Algebra.map(A)(r), f(x) with ringS, moduleN, hv, mr, fx
    have swap : call2(Ring.mul(Algebra.ring(A)), v, Algebra.map(A)(r)) = call2(Ring.mul(Algebra.ring(A)), Algebra.map(A)(r), v)
      ring
    rw [sv, e1, e2, e3, r1, fs, r2, ← m2, swap, m1]
    exact ⟨rfl, rfl⟩

theorem liftBaseChange.parts (N f : Set)
  requires moduleN : Module(N, Algebra.ring(A))
  requires linear : LinearMap(f, M, Algebra.base(A), restrictedModule(A, N))
  shows LinearMap(liftBaseChange(A, M, N, f), tensorProduct(algebraModule(A), Algebra.base(A), M), Algebra.base(A), restrictedModule(A, N)) ∧
    (∀ a ∈ algebraCarrier(A), ∀ m ∈ M.carrier, liftBaseChange(A, M, N, f)(tmul(algebraModule(A), Algebra.base(A), M, a, m)) = call2(Module.smul(N), a, f(m)))
proof
  obtain ⟨ringK, mA, tp, ringS⟩ := baseChange.setup at A, M with algebra, module
  have rN := restrictedModule.module at A, M, N with algebra, module, moduleN
  have ceR := restrictedModule.carrier_eq at A, N
  have aeR := restrictedModule.add_eq at A, N
  have ceA := algebraModule.carrier_eq at A
  have cr := Algebra.comm_ring at A with algebra
  have bil := liftBaseChangePairs.bilinear at A, M, N, f with algebra, module, moduleN, linear
  obtain ⟨lin, val⟩ := tensorLift.parts at Algebra.base(A), algebraModule(A), M, restrictedModule(A, N), liftBaseChangePairs(A, M, N, f) with ringK, mA, module, bil
  unfold liftBaseChange
  refine ⟨lin, ?_⟩
  intros a ha m hm
  have ha2 := algebraModule.mem at A, a with ha
  have v := val with a, ha2, m, hm
  have p := liftBaseChangePairs.value at A, M, N, f, a, m with algebra, module, moduleN, linear, ha, hm
  rw [v, p]

-- r · t = (r · 1) t on A ⊗ M.
theorem baseChange.scalar_action (r t : Set)
  requires hr : r ∈ Ring.carrier(Algebra.base(A))
  requires ht : t ∈ Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), M))
  shows call2(Module.smul(tensorProduct(algebraModule(A), Algebra.base(A), M)), r, t) = rightTensor(algebraModule(A), Algebra.base(A), M, algebraModule(A), algebraMultiplication(A, Algebra.map(A)(r)))(t)
proof
  obtain ⟨ringK, mA, tp, ringS⟩ := baseChange.setup at A, M with algebra, module
  have ceA := algebraModule.carrier_eq at A
  have cr := Algebra.comm_ring at A with algebra
  have mr := algebraCarrier.map_mem at A, r with algebra, hr
  obtain ⟨lr, vr⟩ := baseChangeRho.parts at A, M, Algebra.map(A)(r) with algebra, module, mr
  have idT := LinearMap.identity at tensorProduct(algebraModule(A), Algebra.base(A), M), Algebra.base(A) with tp
  have sm := LinearMap.pointwise_smul at identity(Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), M))), tensorProduct(algebraModule(A), Algebra.base(A), M), Algebra.base(A), tensorProduct(algebraModule(A), Algebra.base(A), M), r with ringK, idT, hr
  have idS := functionSpace.mem_iff.backward with (LinearMap.function_of with idT)
  have agree : ∀ x ∈ Module.carrier(algebraModule(A)), ∀ m ∈ M.carrier, pointwiseSmul(Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), M)), tensorProduct(algebraModule(A), Algebra.base(A), M), r, identity(Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), M))))(tmul(algebraModule(A), Algebra.base(A), M, x, m)) = rightTensor(algebraModule(A), Algebra.base(A), M, algebraModule(A), algebraMultiplication(A, Algebra.map(A)(r)))(tmul(algebraModule(A), Algebra.base(A), M, x, m))
    intros x hx m hm
    have tIn := tmul.mem at Algebra.base(A), algebraModule(A), M, x, m with ringK, mA, module, hx, hm
    have p := pointwiseSmul.at at Algebra.base(A), Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), M)), tensorProduct(algebraModule(A), Algebra.base(A), M), r, identity(Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), M))), tmul(algebraModule(A), Algebra.base(A), M, x, m) with tp, hr, idS, tIn
    have t := tmul.smul_left at Algebra.base(A), algebraModule(A), M, r, x, m with ringK, mA, module, hr, hx, hm
    rw ceA at hx
    have sx := algebraModule.smul_value at A, r, x with algebra, hr, hx
    have v := vr with x, hx, m, hm
    rw [p, identity.apply with tIn, ← t, sx, v]
  have same := tensorProduct.ext_pure at Algebra.base(A), algebraModule(A), M, tensorProduct(algebraModule(A), Algebra.base(A), M), pointwiseSmul(Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), M)), tensorProduct(algebraModule(A), Algebra.base(A), M), r, identity(Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), M)))), rightTensor(algebraModule(A), Algebra.base(A), M, algebraModule(A), algebraMultiplication(A, Algebra.map(A)(r))) with ringK, mA, module, sm, lr, agree
  have p := pointwiseSmul.at at Algebra.base(A), Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), M)), tensorProduct(algebraModule(A), Algebra.base(A), M), r, identity(Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), M))), t with tp, hr, idS, ht
  rw [identity.apply with ht, same] at p
  symm
  exact p

-- An A-linear map out of A ⊗ M is R-linear into N restricted.
theorem baseChange.restrict_linear (N g : Set)
  requires moduleN : Module(N, Algebra.ring(A))
  requires other : LinearMap(g, baseChange(A, M), Algebra.ring(A), N)
  shows LinearMap(g, tensorProduct(algebraModule(A), Algebra.base(A), M), Algebra.base(A), restrictedModule(A, N))
proof
  obtain ⟨ringK, mA, tp, ringS⟩ := baseChange.setup at A, M with algebra, module
  have rN := restrictedModule.module at A, M, N with algebra, module, moduleN
  have ceR := restrictedModule.carrier_eq at A, N
  have aeR := restrictedModule.add_eq at A, N
  have ceA := algebraModule.carrier_eq at A
  have cr := Algebra.comm_ring at A with algebra
  have ceB := baseChange.carrier_eq at A, M with algebra, module
  have aeB := baseChange.add_eq at A, M with algebra, module
  have gF := LinearMap.function_of with other
  rw [ceB, ← ceR] at gF
  apply LinearMap.of_laws with tp, rN, gF
  . intros v hv w hw
    rw aeR
    have hv2 : v ∈ Module.carrier(baseChange(A, M))
      rw ceB
      exact hv
    have hw2 : w ∈ Module.carrier(baseChange(A, M))
      rw ceB
      exact hw
    have l := LinearMap.add_law with other, hv2, hw2
    rw aeB at l
    exact l
  . intros r hr v hv
    have mr := algebraCarrier.map_mem at A, r with algebra, hr
    have mr1 := Algebra.map_mem at A, r with algebra, hr
    have hv2 : v ∈ Module.carrier(baseChange(A, M))
      rw ceB
      exact hv
    have sa := baseChange.scalar_action at A, M, r, v with algebra, module, hr, hv
    have sv := baseChange.smul_value at A, M, Algebra.map(A)(r), v with algebra, module, mr, hv
    have l := LinearMap.smul_law with other, mr1, hv2
    rw [sv] at l
    have gv := LinearMap.value_mem with other, hv2
    have rs := restrictedModule.smul_value at A, N, r, g(v) with algebra, moduleN, hr, gv
    rw [sa, l, rs]

-- LinearMap.liftBaseChange.
theorem liftBaseChange.linear (N f : Set)
  requires moduleN : Module(N, Algebra.ring(A))
  requires linear : LinearMap(f, M, Algebra.base(A), restrictedModule(A, N))
  shows LinearMap(liftBaseChange(A, M, N, f), baseChange(A, M), Algebra.ring(A), N)
proof
  obtain ⟨ringK, mA, tp, ringS⟩ := baseChange.setup at A, M with algebra, module
  have rN := restrictedModule.module at A, M, N with algebra, module, moduleN
  have ceR := restrictedModule.carrier_eq at A, N
  have aeR := restrictedModule.add_eq at A, N
  have ceA := algebraModule.carrier_eq at A
  have cr := Algebra.comm_ring at A with algebra
  obtain ⟨lin, val⟩ := liftBaseChange.parts at A, M, N, f with algebra, module, moduleN, linear
  have ceB := baseChange.carrier_eq at A, M with algebra, module
  have aeB := baseChange.add_eq at A, M with algebra, module
  have bcM := baseChange.module at A, M with algebra, module
  have lF := LinearMap.function_of with lin
  rw [← ceB, ceR] at lF
  apply LinearMap.of_laws with bcM, moduleN, lF
  . rw [ceB, aeB]
    intros v hv w hw
    have l := LinearMap.add_law with lin, hv, hw
    rw aeR at l
    exact l
  . rw ceB
    intros a ha t ht
    have ha2 : a ∈ algebraCarrier(A)
      unfold algebraCarrier
      exact ha
    have sv := baseChange.smul_value at A, M, a, t with algebra, module, ha2, ht
    rw sv
    obtain ⟨la, va⟩ := baseChangeRho.parts at A, M, a with algebra, module, ha2
    have comp := LinearMap.compose at rightTensor(algebraModule(A), Algebra.base(A), M, algebraModule(A), algebraMultiplication(A, a)), liftBaseChange(A, M, N, f), tensorProduct(algebraModule(A), Algebra.base(A), M), Algebra.base(A), tensorProduct(algebraModule(A), Algebra.base(A), M), restrictedModule(A, N) with la, lin
    have lS : liftBaseChange(A, M, N, f) ∈ functionSpace(Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), M)), Module.carrier(N))
      have lF2 := LinearMap.function_of with lin
      rw ceR at lF2
      exact functionSpace.mem_iff.backward with lF2
    have values : ∀ i ∈ Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), M)), call2(Module.smul(N), a, liftBaseChange(A, M, N, f)(i)) ∈ Module.carrier(N)
      intros i hi
      have li := LinearMap.value_mem with lin, hi
      rw ceR at li
      exact Module.smul_mem at Algebra.ring(A), N, a, liftBaseChange(A, M, N, f)(i) with ringS, moduleN, ha, li
    have psF := pointwiseSmul.graph_function at Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), M)), N, a, liftBaseChange(A, M, N, f) with values
    rw ← ceR at psF
    have ringR := CommRing.to_ring with ringK
    have psL : LinearMap(pointwiseSmul(Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), M)), N, a, liftBaseChange(A, M, N, f)), tensorProduct(algebraModule(A), Algebra.base(A), M), Algebra.base(A), restrictedModule(A, N))
      apply LinearMap.of_laws with tp, rN, psF
      . intros v hv w hw
        have vw := Module.add_mem at Algebra.base(A), tensorProduct(algebraModule(A), Algebra.base(A), M), v, w with ringR, tp, hv, hw
        have p1 := pointwiseSmul.at at Algebra.ring(A), Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), M)), N, a, liftBaseChange(A, M, N, f), call2(Module.add(tensorProduct(algebraModule(A), Algebra.base(A), M)), v, w) with moduleN, ha, lS, vw
        have p2 := pointwiseSmul.at at Algebra.ring(A), Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), M)), N, a, liftBaseChange(A, M, N, f), v with moduleN, ha, lS, hv
        have p3 := pointwiseSmul.at at Algebra.ring(A), Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), M)), N, a, liftBaseChange(A, M, N, f), w with moduleN, ha, lS, hw
        have l := LinearMap.add_law with lin, hv, hw
        rw aeR at l
        have lv := LinearMap.value_mem with lin, hv
        have lw := LinearMap.value_mem with lin, hw
        rw ceR at lv
        rw ceR at lw
        have law := smul_add at Algebra.ring(A), N, a, liftBaseChange(A, M, N, f)(v), liftBaseChange(A, M, N, f)(w) with ringS, moduleN, ha, lv, lw
        rw [aeR, p1, p2, p3, l, law]
      . intros r hr v hv
        have rv := Module.smul_mem at Algebra.base(A), tensorProduct(algebraModule(A), Algebra.base(A), M), r, v with ringR, tp, hr, hv
        have p1 := pointwiseSmul.at at Algebra.ring(A), Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), M)), N, a, liftBaseChange(A, M, N, f), call2(Module.smul(tensorProduct(algebraModule(A), Algebra.base(A), M)), r, v) with moduleN, ha, lS, rv
        have p2 := pointwiseSmul.at at Algebra.ring(A), Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), M)), N, a, liftBaseChange(A, M, N, f), v with moduleN, ha, lS, hv
        have l := LinearMap.smul_law with lin, hr, hv
        have lv := LinearMap.value_mem with lin, hv
        rw ceR at lv
        have r1 := restrictedModule.smul_value at A, N, r, liftBaseChange(A, M, N, f)(v) with algebra, moduleN, hr, lv
        have av := Module.smul_mem at Algebra.ring(A), N, a, liftBaseChange(A, M, N, f)(v) with ringS, moduleN, ha, lv
        have r2 := restrictedModule.smul_value at A, N, r, call2(Module.smul(N), a, liftBaseChange(A, M, N, f)(v)) with algebra, moduleN, hr, av
        have mr := Algebra.map_mem at A, r with algebra, hr
        have m1 := mul_smul at Algebra.ring(A), N, a, Algebra.map(A)(r), liftBaseChange(A, M, N, f)(v) with ringS, moduleN, ha, mr, lv
        have m2 := mul_smul at Algebra.ring(A), N, Algebra.map(A)(r), a, liftBaseChange(A, M, N, f)(v) with ringS, moduleN, mr, ha, lv
        have swap : call2(Ring.mul(Algebra.ring(A)), a, Algebra.map(A)(r)) = call2(Ring.mul(Algebra.ring(A)), Algebra.map(A)(r), a)
          ring
        rw [p1, p2, l, r1, r2, ← m1, swap, m2]
    have fa := LinearMap.function_of with la
    have fl := LinearMap.function_of with lin
    have agree : ∀ x ∈ Module.carrier(algebraModule(A)), ∀ m ∈ M.carrier, compose(liftBaseChange(A, M, N, f), rightTensor(algebraModule(A), Algebra.base(A), M, algebraModule(A), algebraMultiplication(A, a)), Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), M)), Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), M)), Module.carrier(restrictedModule(A, N)))(tmul(algebraModule(A), Algebra.base(A), M, x, m)) = pointwiseSmul(Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), M)), N, a, liftBaseChange(A, M, N, f))(tmul(algebraModule(A), Algebra.base(A), M, x, m))
      intros x hx m hm
      have tIn := tmul.mem at Algebra.base(A), algebraModule(A), M, x, m with ringK, mA, module, hx, hm
      have c0 := compose.apply at liftBaseChange(A, M, N, f), rightTensor(algebraModule(A), Algebra.base(A), M, algebraModule(A), algebraMultiplication(A, a)), Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), M)), Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), M)), Module.carrier(restrictedModule(A, N)), tmul(algebraModule(A), Algebra.base(A), M, x, m) with fa, fl, tIn
      have p := pointwiseSmul.at at Algebra.ring(A), Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), M)), N, a, liftBaseChange(A, M, N, f), tmul(algebraModule(A), Algebra.base(A), M, x, m) with moduleN, ha, lS, tIn
      rw ceA at hx
      have ax := algebraCarrier.mul_mem at A, a, x with algebra, ha2, hx
      have e1 := va with x, hx, m, hm
      have e2 := val with call2(Ring.mul(Algebra.ring(A)), a, x), ax, m, hm
      have e3 := val with x, hx, m, hm
      have fm := LinearMap.value_mem with linear, hm
      rw ceR at fm
      unfold algebraCarrier at hx
      have law := mul_smul at Algebra.ring(A), N, a, x, f(m) with ringS, moduleN, ha, hx, fm
      rw [c0, p, e1, e2, e3, law]
    have same := tensorProduct.ext_pure at Algebra.base(A), algebraModule(A), M, restrictedModule(A, N), compose(liftBaseChange(A, M, N, f), rightTensor(algebraModule(A), Algebra.base(A), M, algebraModule(A), algebraMultiplication(A, a)), Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), M)), Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), M)), Module.carrier(restrictedModule(A, N))), pointwiseSmul(Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), M)), N, a, liftBaseChange(A, M, N, f)) with ringK, mA, module, comp, psL, agree
    have c0 := compose.apply at liftBaseChange(A, M, N, f), rightTensor(algebraModule(A), Algebra.base(A), M, algebraModule(A), algebraMultiplication(A, a)), Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), M)), Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), M)), Module.carrier(restrictedModule(A, N)), t with fa, fl, ht
    have p := pointwiseSmul.at at Algebra.ring(A), Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), M)), N, a, liftBaseChange(A, M, N, f), t with moduleN, ha, lS, ht
    rw [← c0, same, p]

theorem liftBaseChange.tmul (N f a m : Set)
  requires moduleN : Module(N, Algebra.ring(A))
  requires linear : LinearMap(f, M, Algebra.base(A), restrictedModule(A, N))
  requires scalar : a ∈ algebraCarrier(A)
  requires vector : m ∈ M.carrier
  shows liftBaseChange(A, M, N, f)(tmul(algebraModule(A), Algebra.base(A), M,
    a, m)) = call2(Module.smul(N), a, f(m))
proof
  obtain ⟨_, val⟩ := liftBaseChange.parts at A, M, N, f with algebra, module, moduleN, linear
  exact val with a, scalar, m, vector

-- LinearMap.liftBaseChangeEquiv: A-linear maps A ⊗ M → N are the R-linear
-- maps M → N, by g ↦ (m ↦ g(1 ⊗ m)) with inverse liftBaseChange.
theorem liftBaseChange.unique (N f g : Set)
  requires moduleN : Module(N, Algebra.ring(A))
  requires linear : LinearMap(f, M, Algebra.base(A), restrictedModule(A, N))
  requires other : LinearMap(g, baseChange(A, M), Algebra.ring(A), N)
  requires agree : ∀ m ∈ M.carrier,
    g(tmul(algebraModule(A), Algebra.base(A), M, Ring.one(Algebra.ring(A)), m)) =
      f(m)
  shows g = liftBaseChange(A, M, N, f)
proof
  obtain ⟨ringK, mA, tp, ringS⟩ := baseChange.setup at A, M with algebra, module
  have rN := restrictedModule.module at A, M, N with algebra, module, moduleN
  have ceR := restrictedModule.carrier_eq at A, N
  have aeR := restrictedModule.add_eq at A, N
  have ceA := algebraModule.carrier_eq at A
  have cr := Algebra.comm_ring at A with algebra
  obtain ⟨lin, val⟩ := liftBaseChange.parts at A, M, N, f with algebra, module, moduleN, linear
  have gR := baseChange.restrict_linear at A, M, N, g with algebra, module, moduleN, other
  have ceB := baseChange.carrier_eq at A, M with algebra, module
  apply tensorProduct.ext_pure at Algebra.base(A), algebraModule(A), M, restrictedModule(A, N), g, liftBaseChange(A, M, N, f) with ringK, mA, module, gR, lin
  intros x hx m hm
  have one := Ring.one_mem at Algebra.ring(A) with ringS
  have one2 : Ring.one(Algebra.ring(A)) ∈ algebraCarrier(A)
    unfold algebraCarrier
    exact one
  have one3 := algebraModule.mem at A, Ring.one(Algebra.ring(A)) with one2
  have t1 := tmul.mem at Algebra.base(A), algebraModule(A), M, Ring.one(Algebra.ring(A)), m with ringK, mA, module, one3, hm
  rw ceA at hx
  obtain ⟨_, vx⟩ := baseChangeRho.parts at A, M, x with algebra, module, hx
  have e1 := vx with Ring.one(Algebra.ring(A)), one2, m, hm
  have u : call2(Ring.mul(Algebra.ring(A)), x, Ring.one(Algebra.ring(A))) = x
    unfold algebraCarrier at hx
    ring
  rw u at e1
  have sv := baseChange.smul_value at A, M, x, tmul(algebraModule(A), Algebra.base(A), M, Ring.one(Algebra.ring(A)), m) with algebra, module, hx, t1
  rw e1 at sv
  have t2 : tmul(algebraModule(A), Algebra.base(A), M, Ring.one(Algebra.ring(A)), m) ∈ Module.carrier(baseChange(A, M))
    rw ceB
    exact t1
  have hx1 : x ∈ Ring.carrier(Algebra.ring(A))
    unfold algebraCarrier at hx
    exact hx
  have l := LinearMap.smul_law with other, hx1, t2
  rw sv at l
  have a := agree with m, hm
  have v := val with x, hx, m, hm
  rw [l, a, v]

theorem liftBaseChange.restrict (N g : Set)
  requires moduleN : Module(N, Algebra.ring(A))
  requires linear : LinearMap(g, baseChange(A, M), Algebra.ring(A), N)
  shows LinearMap(compose(g, baseChangeUnit(A, M), M.carrier,
      Module.carrier(baseChange(A, M)), N.carrier),
    M, Algebra.base(A), restrictedModule(A, N))
proof
  obtain ⟨ringK, mA, tp, ringS⟩ := baseChange.setup at A, M with algebra, module
  have rN := restrictedModule.module at A, M, N with algebra, module, moduleN
  have ceR := restrictedModule.carrier_eq at A, N
  have aeR := restrictedModule.add_eq at A, N
  have ceA := algebraModule.carrier_eq at A
  have cr := Algebra.comm_ring at A with algebra
  have gR := baseChange.restrict_linear at A, M, N, g with algebra, module, moduleN, linear
  have ceB := baseChange.carrier_eq at A, M with algebra, module
  have one := Ring.one_mem at Algebra.ring(A) with ringS
  have one2 : Ring.one(Algebra.ring(A)) ∈ algebraCarrier(A)
    unfold algebraCarrier
    exact one
  have one3 := algebraModule.mem at A, Ring.one(Algebra.ring(A)) with one2
  have values : ∀ m ∈ M.carrier, tmul(algebraModule(A), Algebra.base(A), M, Ring.one(Algebra.ring(A)), m) ∈ Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), M))
    intros n hn
    exact tmul.mem at Algebra.base(A), algebraModule(A), M, Ring.one(Algebra.ring(A)), n with ringK, mA, module, one3, hn
  have uF := baseChangeUnit.graph_function at A, M with values
  have ringR := CommRing.to_ring with ringK
  have uL : LinearMap(baseChangeUnit(A, M), M, Algebra.base(A), tensorProduct(algebraModule(A), Algebra.base(A), M))
    apply LinearMap.of_laws with module, tp, uF
    . intros v hv w hw
      have vw := Module.add_mem at Algebra.base(A), M, v, w with ringR, module, hv, hw
      have e1 := baseChangeUnit.graph_apply at A, M, call2(Module.add(M), v, w) with values, vw
      have e2 := baseChangeUnit.graph_apply at A, M, v with values, hv
      have e3 := baseChangeUnit.graph_apply at A, M, w with values, hw
      have t := tmul.add_right at Algebra.base(A), algebraModule(A), M, Ring.one(Algebra.ring(A)), v, w with ringK, mA, module, one3, hv, hw
      rw [e1, e2, e3, t]
    . intros r hr v hv
      have rv := Module.smul_mem at Algebra.base(A), M, r, v with ringR, module, hr, hv
      have e1 := baseChangeUnit.graph_apply at A, M, call2(Module.smul(M), r, v) with values, rv
      have e2 := baseChangeUnit.graph_apply at A, M, v with values, hv
      have t1 := tmul.smul_right at Algebra.base(A), algebraModule(A), M, r, Ring.one(Algebra.ring(A)), v with ringK, mA, module, hr, one3, hv
      have t2 := tmul.smul_left at Algebra.base(A), algebraModule(A), M, r, Ring.one(Algebra.ring(A)), v with ringK, mA, module, hr, one3, hv
      rw [e1, e2, t1, t2]
  rw ceB
  have c := LinearMap.compose at baseChangeUnit(A, M), g, M, Algebra.base(A), tensorProduct(algebraModule(A), Algebra.base(A), M), restrictedModule(A, N) with uL, gR
  rw ceR at c
  exact c

end BaseChange

-- Section: The multiplication of A ⊗ B
-- x ⊗ y ↦ (a x) ⊗ (b y), the pairs (a, b) ↦ that map, its lift
-- Φ : A ⊗ B → End(A ⊗ B), and (s, t) ↦ Φ(s)(t).
def algebraTensorLeft (A B a b : Set) : Set :=
  tensorMap(algebraMultiplication(A, a), algebraMultiplication(B, b),
    algebraModule(A), algebraModule(B), algebraModule(A), Algebra.base(A), algebraModule(B))

def algebraTensorPairs (A B : Set) : Set :=
  { p ∈ (algebraCarrier(A) × algebraCarrier(B)) × linearMaps(tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B)), Algebra.base(A), tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B))) |
    ∃ a ∈ algebraCarrier(A), ∃ b ∈ algebraCarrier(B),
      p = ((a, b), algebraTensorLeft(A, B, a, b)) }

def algebraTensorAction (A B : Set) : Set :=
  tensorLift(algebraModule(A), Algebra.base(A), algebraModule(B), homModule(tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B)), Algebra.base(A), tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B))), algebraTensorPairs(A, B))

def algebraTensorProductGraph (A B : Set) : Set :=
  { p ∈ (Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B))) × Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B)))) × Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B))) |
    ∃ s ∈ Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B))), ∃ t ∈ Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B))), p = ((s, t), algebraTensorAction(A, B)(s)(t)) }

theorem algebraTensorPairs.graph_relates (A B a b : Set)
  requires rowIn : a ∈ algebraCarrier(A)
  requires colIn : b ∈ algebraCarrier(B)
  requires valueIn : algebraTensorLeft(A, B, a, b) ∈ linearMaps(tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B)), Algebra.base(A), tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B)))
  shows relates(algebraTensorPairs(A, B), (a, b), algebraTensorLeft(A, B, a, b))
proof
  have pairIn := product.pair at a, b, algebraCarrier(A), algebraCarrier(B) with rowIn, colIn
  have outer := product.pair at (a, b), algebraTensorLeft(A, B, a, b), algebraCarrier(A) × algebraCarrier(B), linearMaps(tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B)), Algebra.base(A), tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B))) with pairIn, valueIn
  unfold relates
  apply algebraTensorPairs.membership.backward
  exact ⟨outer, a, rowIn, b, colIn, rfl⟩

theorem algebraTensorPairs.graph_function (A B : Set)
  requires values : ∀ a ∈ algebraCarrier(A), ∀ b ∈ algebraCarrier(B), algebraTensorLeft(A, B, a, b) ∈ linearMaps(tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B)), Algebra.base(A), tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B)))
  shows algebraTensorPairs(A, B) : algebraCarrier(A) × algebraCarrier(B) → linearMaps(tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B)), Algebra.base(A), tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B)))
proof
  constructor
    intros q0 member
    obtain ⟨bounded, witnesses⟩ := algebraTensorPairs.membership.forward with member
    exact bounded
  . constructor
      intros z0 first xFirst second xSecond
      unfold relates at xFirst
      obtain ⟨_, a1, a1In, b1, b1In, firstShape⟩ := algebraTensorPairs.membership.forward with xFirst
      unfold relates at xSecond
      obtain ⟨_, a2, a2In, b2, b2In, secondShape⟩ := algebraTensorPairs.membership.forward with xSecond
      obtain ⟨xi, firstEqual⟩ := orderedPair.injective with firstShape
      obtain ⟨xj, secondEqual⟩ := orderedPair.injective with secondShape
      rw xi at xj
      obtain ⟨aa, bb⟩ := orderedPair.injective with xj
      rw [firstEqual, secondEqual]
      cc
    . intros q0 pIn
      obtain ⟨bound, a, rowIn, b, colIn, shape⟩ := product.membership.forward with pIn
      have valueIn := values with a, rowIn, b, colIn
      have mapped := algebraTensorPairs.graph_relates at A, B, a, b with rowIn, colIn, valueIn
      rw shape
      exact ⟨algebraTensorLeft(A, B, a, b), valueIn, mapped⟩

theorem algebraTensorPairs.graph_entry (A B a b : Set)
  requires values : ∀ a ∈ algebraCarrier(A), ∀ b ∈ algebraCarrier(B), algebraTensorLeft(A, B, a, b) ∈ linearMaps(tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B)), Algebra.base(A), tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B)))
  requires rowIn : a ∈ algebraCarrier(A)
  requires colIn : b ∈ algebraCarrier(B)
  shows algebraTensorPairs(A, B)((a, b)) = algebraTensorLeft(A, B, a, b)
proof
  have function := algebraTensorPairs.graph_function at A, B with values
  have valueIn := values with a, rowIn, b, colIn
  have mapped := algebraTensorPairs.graph_relates at A, B, a, b with rowIn, colIn, valueIn
  have pairIn := product.pair at a, b, algebraCarrier(A), algebraCarrier(B) with rowIn, colIn
  exact FunctionBetween.apply_value with function, pairIn, mapped

theorem algebraTensorProductGraph.graph_relates (A B s t : Set)
  requires rowIn : s ∈ Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B)))
  requires colIn : t ∈ Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B)))
  requires valueIn : algebraTensorAction(A, B)(s)(t) ∈ Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B)))
  shows relates(algebraTensorProductGraph(A, B), (s, t), algebraTensorAction(A, B)(s)(t))
proof
  have pairIn := product.pair at s, t, Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B))), Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B))) with rowIn, colIn
  have outer := product.pair at (s, t), algebraTensorAction(A, B)(s)(t), Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B))) × Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B))), Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B))) with pairIn, valueIn
  unfold relates
  apply algebraTensorProductGraph.membership.backward
  exact ⟨outer, s, rowIn, t, colIn, rfl⟩

theorem algebraTensorProductGraph.graph_function (A B : Set)
  requires values : ∀ s ∈ Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B))), ∀ t ∈ Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B))), algebraTensorAction(A, B)(s)(t) ∈ Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B)))
  shows algebraTensorProductGraph(A, B) : Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B))) × Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B))) → Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B)))
proof
  constructor
    intros q0 member
    obtain ⟨bounded, witnesses⟩ := algebraTensorProductGraph.membership.forward with member
    exact bounded
  . constructor
      intros z0 first xFirst second xSecond
      unfold relates at xFirst
      obtain ⟨_, a1, a1In, b1, b1In, firstShape⟩ := algebraTensorProductGraph.membership.forward with xFirst
      unfold relates at xSecond
      obtain ⟨_, a2, a2In, b2, b2In, secondShape⟩ := algebraTensorProductGraph.membership.forward with xSecond
      obtain ⟨xi, firstEqual⟩ := orderedPair.injective with firstShape
      obtain ⟨xj, secondEqual⟩ := orderedPair.injective with secondShape
      rw xi at xj
      obtain ⟨aa, bb⟩ := orderedPair.injective with xj
      rw [firstEqual, secondEqual]
      cc
    . intros q0 pIn
      obtain ⟨bound, s, rowIn, t, colIn, shape⟩ := product.membership.forward with pIn
      have valueIn := values with s, rowIn, t, colIn
      have mapped := algebraTensorProductGraph.graph_relates at A, B, s, t with rowIn, colIn, valueIn
      rw shape
      exact ⟨algebraTensorAction(A, B)(s)(t), valueIn, mapped⟩

theorem algebraTensorProductGraph.graph_entry (A B s t : Set)
  requires values : ∀ s ∈ Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B))), ∀ t ∈ Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B))), algebraTensorAction(A, B)(s)(t) ∈ Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B)))
  requires rowIn : s ∈ Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B)))
  requires colIn : t ∈ Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B)))
  shows algebraTensorProductGraph(A, B)((s, t)) = algebraTensorAction(A, B)(s)(t)
proof
  have function := algebraTensorProductGraph.graph_function at A, B with values
  have valueIn := values with s, rowIn, t, colIn
  have mapped := algebraTensorProductGraph.graph_relates at A, B, s, t with rowIn, colIn, valueIn
  have pairIn := product.pair at s, t, Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B))), Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B))) with rowIn, colIn
  exact FunctionBetween.apply_value with function, pairIn, mapped


section AlgebraTensorConstruction
variable (A B : Set)
hypothesis algebraA : Algebra(A)
hypothesis algebraB : Algebra(B)
hypothesis sameBase : Algebra.base(A) = Algebra.base(B)

theorem algebraTensor.setup
  shows CommRing(Algebra.base(A)) ∧ Module(algebraModule(A), Algebra.base(A)) ∧ Module(algebraModule(B), Algebra.base(A)) ∧
    Module(tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B)), Algebra.base(A)) ∧ Module(homModule(tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B)), Algebra.base(A), tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B))), Algebra.base(A))
proof
  have ringK := Algebra.base_comm_ring at A with algebraA
  have mA := algebraModule.module_of at A with algebraA
  have mB : Module(algebraModule(B), Algebra.base(A))
    rw sameBase
    exact algebraModule.module_of at B with algebraB
  have tp := tensorProduct.module at Algebra.base(A), algebraModule(A), algebraModule(B) with ringK, mA, mB
  have hm := homModule.module at Algebra.base(A), tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B)), tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B)) with ringK, tp, tp
  exact ⟨ringK, mA, mB, tp, hm⟩

theorem algebraTensorLeft.linear (a b : Set)
  requires ha : a ∈ algebraCarrier(A)
  requires hb : b ∈ algebraCarrier(B)
  shows LinearMap(algebraTensorLeft(A, B, a, b), tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B)), Algebra.base(A), tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B)))
proof
  obtain ⟨ringK, mA, mB, tp, hm⟩ := algebraTensor.setup at A, B with algebraA, algebraB, sameBase
  have la := algebraMultiplication.linear at A, a with algebraA, ha
  have lb := algebraMultiplication.linear at B, b with algebraB, hb
  rw ← sameBase at lb
  unfold algebraTensorLeft
  exact tensorMap.linear at Algebra.base(A), algebraModule(A), algebraModule(B), algebraModule(A), algebraModule(B), algebraMultiplication(A, a), algebraMultiplication(B, b) with ringK, mA, mB, la, lb

theorem algebraTensorLeft.tmul (a b x y : Set)
  requires ha : a ∈ algebraCarrier(A)
  requires hb : b ∈ algebraCarrier(B)
  requires hx : x ∈ algebraCarrier(A)
  requires hy : y ∈ algebraCarrier(B)
  shows algebraTensorLeft(A, B, a, b)(tmul(algebraModule(A), Algebra.base(A), algebraModule(B), x, y)) = tmul(algebraModule(A), Algebra.base(A), algebraModule(B), call2(Ring.mul(Algebra.ring(A)), a, x), call2(Ring.mul(Algebra.ring(B)), b, y))
proof
  obtain ⟨ringK, mA, mB, tp, hm⟩ := algebraTensor.setup at A, B with algebraA, algebraB, sameBase
  have la := algebraMultiplication.linear at A, a with algebraA, ha
  have lb := algebraMultiplication.linear at B, b with algebraB, hb
  rw ← sameBase at lb
  have hx2 := algebraModule.mem at A, x with hx
  have hy2 := algebraModule.mem at B, y with hy
  have e := tensorMap.tmul at Algebra.base(A), algebraModule(A), algebraModule(B), algebraModule(A), algebraModule(B), algebraMultiplication(A, a), algebraMultiplication(B, b), x, y with ringK, mA, mB, la, lb, hx2, hy2
  have v1 := algebraMultiplication.value at A, a, x with algebraA, ha, hx
  have v2 := algebraMultiplication.value at B, b, y with algebraB, hb, hy
  unfold algebraTensorLeft
  rw [e, v1, v2]

theorem algebraTensorPairs.value (a b : Set)
  requires ha : a ∈ algebraCarrier(A)
  requires hb : b ∈ algebraCarrier(B)
  shows algebraTensorPairs(A, B)((a, b)) = algebraTensorLeft(A, B, a, b)
proof
  have values : ∀ a ∈ algebraCarrier(A), ∀ b ∈ algebraCarrier(B), algebraTensorLeft(A, B, a, b) ∈ linearMaps(tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B)), Algebra.base(A), tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B)))
    intros c hc d hd
    have l := algebraTensorLeft.linear at A, B, c, d with algebraA, algebraB, sameBase, hc, hd
    exact linearMaps.of_linear with l
  exact algebraTensorPairs.graph_entry at A, B, a, b with values, ha, hb

