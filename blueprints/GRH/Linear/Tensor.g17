-- Tensor products of modules over a commutative ring, constructed as the
-- quotient of the free module on pairs by the bilinearity relations: pure
-- tensors and their laws, the universal property for bilinear maps,
-- functoriality (TensorProduct.map, lTensor, rTensor), the unit,
-- commutativity, and associativity isomorphisms, right exactness, bases
-- and ranks; base change along an algebra with its universal property
-- (LinearMap.liftBaseChange); and the tensor product of commutative
-- algebras with its inclusions and product map.
-- Part of the GRH blueprint.
-- Planned home: Algebra/Module/TensorProduct.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Linear.Tensor
import GRH.Linear.Dual
import Grace.Cumulus.Algebra.Algebras.Basic

-- Section: The construction
-- The free module R^(M × N) on the pairs, the generator [m, n] of a pair,
-- and the relators [m + m', n] − [m, n] − [m', n],
-- [m, n + n'] − [m, n] − [m, n'], [r m, n] − r [m, n], [m, r n] − r [m, n].
def pairModule (M R N : Set) : Set :=
  freeModule(R, Module.carrier(M) × Module.carrier(N))

def pairGenerator (M R N m n : Set) : Set :=
  unitVector(R, Module.carrier(M) × Module.carrier(N), (m, n))

-- a − b − c and a − r • b in the free module on pairs.
def pairDifference (M R N a b c : Set) : Set :=
  call2(Module.add(pairModule(M, R, N)),
    call2(Module.add(pairModule(M, R, N)), a,
      apply(Module.neg(pairModule(M, R, N)), b)),
    apply(Module.neg(pairModule(M, R, N)), c))

def pairScaledDifference (M R N a r b : Set) : Set :=
  call2(Module.add(pairModule(M, R, N)), a,
    apply(Module.neg(pairModule(M, R, N)),
      call2(Module.smul(pairModule(M, R, N)), r, b)))

def tensorRelators (M R N : Set) : Set :=
  { z ∈ finitelySupported(R, Module.carrier(M) × Module.carrier(N)) |
    (∃ m m2 ∈ Module.carrier(M), ∃ n ∈ Module.carrier(N),
      z = pairDifference(M, R, N,
        pairGenerator(M, R, N, call2(Module.add(M), m, m2), n),
        pairGenerator(M, R, N, m, n), pairGenerator(M, R, N, m2, n))) ∨
    (∃ m ∈ Module.carrier(M), ∃ n n2 ∈ Module.carrier(N),
      z = pairDifference(M, R, N,
        pairGenerator(M, R, N, m, call2(Module.add(N), n, n2)),
        pairGenerator(M, R, N, m, n), pairGenerator(M, R, N, m, n2))) ∨
    (∃ r ∈ Ring.carrier(R), ∃ m ∈ Module.carrier(M), ∃ n ∈ Module.carrier(N),
      z = pairScaledDifference(M, R, N,
        pairGenerator(M, R, N, call2(Module.smul(M), r, m), n), r,
        pairGenerator(M, R, N, m, n))) ∨
    (∃ r ∈ Ring.carrier(R), ∃ m ∈ Module.carrier(M), ∃ n ∈ Module.carrier(N),
      z = pairScaledDifference(M, R, N,
        pairGenerator(M, R, N, m, call2(Module.smul(N), r, n)), r,
        pairGenerator(M, R, N, m, n))) }

def tensorRelations (M R N : Set) : Set :=
  moduleSpan(pairModule(M, R, N), R, tensorRelators(M, R, N))

-- M ⊗[R] N, the pure tensor m ⊗ n, and the bilinear map (m, n) ↦ m ⊗ n
-- (Mathlib's TensorProduct, TensorProduct.tmul, TensorProduct.mk).
def tensorProduct (M R N : Set) : Set :=
  quotientModule(pairModule(M, R, N), R, tensorRelations(M, R, N))

def tmul (M R N m n : Set) : Set :=
  quotientModuleMap(pairModule(M, R, N), tensorRelations(M, R, N))(
    pairGenerator(M, R, N, m, n))

def tensorMk (M R N : Set) : Set :=
  { p ∈ (Module.carrier(M) × Module.carrier(N)) ×
      Module.carrier(tensorProduct(M, R, N)) |
    ∃ m ∈ Module.carrier(M), ∃ n ∈ Module.carrier(N),
      p = ((m, n), tmul(M, R, N, m, n)) }

-- The families i ↦ (u(i), w(i)) and (i, j) ↦ (v(i), w(j)) of pairs.
def pairFamily (k X Y u w : Set) : Set :=
  { p ∈ k × (X × Y) | ∃ i ∈ k, p = (i, (u(i), w(i))) }

def productFamily (I J X Y v w : Set) : Set :=
  { p ∈ (I × J) × (X × Y) | ∃ i ∈ I, ∃ j ∈ J, p = ((i, j), (v(i), w(j))) }

-- The linear map M ⊗ N → P of a bilinear map B : M × N → P,
-- m ⊗ n ↦ B(m, n) (TensorProduct.lift): the free extension of B to the
-- pairs, through the quotient.
def tensorLift (M R N P B : Set) : Set :=
  quotientLift(freeLift(P, R, Module.carrier(M) × Module.carrier(N), B),
    pairModule(M, R, N), tensorRelations(M, R, N), P)

-- f ⊗ g : M ⊗ N → M' ⊗ N', m ⊗ n ↦ f(m) ⊗ g(n) (TensorProduct.map),
-- and its one-sided cases lTensor (id ⊗ g) and rTensor (f ⊗ id).
def tensorMapPairs (f g M N M2 R N2 : Set) : Set :=
  { p ∈ (Module.carrier(M) × Module.carrier(N)) ×
      Module.carrier(tensorProduct(M2, R, N2)) |
    ∃ m ∈ Module.carrier(M), ∃ n ∈ Module.carrier(N),
      p = ((m, n), tmul(M2, R, N2, f(m), g(n))) }

def tensorMap (f g M N M2 R N2 : Set) : Set :=
  tensorLift(M, R, N, tensorProduct(M2, R, N2),
    tensorMapPairs(f, g, M, N, M2, R, N2))

def leftTensor (M R N N2 g : Set) : Set :=
  tensorMap(identity(Module.carrier(M)), g, M, N, M, R, N2)

def rightTensor (M R N M2 f : Set) : Set :=
  tensorMap(f, identity(Module.carrier(N)), M, N, M2, R, N)

-- R ⊗ M → M, r ⊗ m ↦ r m (TensorProduct.lid), and M ⊗ N → N ⊗ M,
-- m ⊗ n ↦ n ⊗ m (TensorProduct.comm).
def scalarTensorMap (M R : Set) : Set :=
  tensorLift(selfModule(R), R, M, M, Module.smul(M))

def tensorSwapPairs (M R N : Set) : Set :=
  { p ∈ (Module.carrier(M) × Module.carrier(N)) ×
      Module.carrier(tensorProduct(N, R, M)) |
    ∃ m ∈ Module.carrier(M), ∃ n ∈ Module.carrier(N),
      p = ((m, n), tmul(N, R, M, n, m)) }

def tensorSwap (M R N : Set) : Set :=
  tensorLift(M, R, N, tensorProduct(N, R, M), tensorSwapPairs(M, R, N))

-- Section: Base change
-- A commutative R-algebra A (Cumulus's Algebra, base R) as an R-module,
-- a ↦ r a acting through the structure map, and an A-module N as an
-- R-module by restriction of scalars.
def algebraAction (A : Set) : Set :=
  { p ∈ (Ring.carrier(Algebra.base(A)) × algebraCarrier(A)) × algebraCarrier(A) |
    ∃ r ∈ Ring.carrier(Algebra.base(A)), ∃ a ∈ algebraCarrier(A),
      p = ((r, a), call2(Ring.mul(Algebra.ring(A)), Algebra.map(A)(r), a)) }

def algebraModule (A : Set) : Set :=
  Module.mk(algebraCarrier(A), Ring.add(Algebra.ring(A)),
    Ring.zero(Algebra.ring(A)), Ring.neg(Algebra.ring(A)), algebraAction(A))

def restrictedAction (A N : Set) : Set :=
  { p ∈ (Ring.carrier(Algebra.base(A)) × Module.carrier(N)) × Module.carrier(N) |
    ∃ r ∈ Ring.carrier(Algebra.base(A)), ∃ x ∈ Module.carrier(N),
      p = ((r, x), call2(Module.smul(N), Algebra.map(A)(r), x)) }

def restrictedModule (A N : Set) : Set :=
  Module.mk(Module.carrier(N), Module.add(N), Module.zero(N), Module.neg(N),
    restrictedAction(A, N))

-- Multiplication by a ∈ A as an R-linear map of A.
def algebraMultiplication (A a : Set) : Set :=
  { p ∈ algebraCarrier(A) × algebraCarrier(A) | ∃ b ∈ algebraCarrier(A),
    p = (b, call2(Ring.mul(Algebra.ring(A)), a, b)) }

-- A ⊗[R] M as an A-module, a (b ⊗ m) = (a b) ⊗ m (Mathlib's
-- TensorProduct.leftModule on A ⊗ M, the base change of M).
def baseChangeAction (A M : Set) : Set :=
  { p ∈ (algebraCarrier(A) ×
      Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), M))) ×
      Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), M)) |
    ∃ a ∈ algebraCarrier(A),
    ∃ t ∈ Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), M)),
      p = ((a, t), rightTensor(algebraModule(A), Algebra.base(A), M,
        algebraModule(A), algebraMultiplication(A, a))(t)) }

def baseChange (A M : Set) : Set :=
  Module.mk(
    Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), M)),
    Module.add(tensorProduct(algebraModule(A), Algebra.base(A), M)),
    Module.zero(tensorProduct(algebraModule(A), Algebra.base(A), M)),
    Module.neg(tensorProduct(algebraModule(A), Algebra.base(A), M)),
    baseChangeAction(A, M))

-- m ↦ 1 ⊗ m, the R-linear map M → A ⊗ M.
def baseChangeUnit (A M : Set) : Set :=
  { p ∈ Module.carrier(M) ×
      Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A), M)) |
    ∃ m ∈ Module.carrier(M), p = (m, tmul(algebraModule(A), Algebra.base(A),
      M, Ring.one(Algebra.ring(A)), m)) }

-- For an A-module N and an R-linear f : M → N, the A-linear map
-- A ⊗ M → N, a ⊗ m ↦ a f(m) (LinearMap.liftBaseChange).
def liftBaseChangePairs (A M N f : Set) : Set :=
  { p ∈ (algebraCarrier(A) × Module.carrier(M)) × Module.carrier(N) |
    ∃ a ∈ algebraCarrier(A), ∃ m ∈ Module.carrier(M),
      p = ((a, m), call2(Module.smul(N), a, f(m))) }

def liftBaseChange (A M N f : Set) : Set :=
  tensorLift(algebraModule(A), Algebra.base(A), M, restrictedModule(A, N),
    liftBaseChangePairs(A, M, N, f))

-- Section: Tensor products of algebras
-- For commutative R-algebras A and B, the multiplication of A ⊗ B: the
-- unique map T × T → T, bilinear for the R-module structure, with
-- (a ⊗ b)(a' ⊗ b') = (a a') ⊗ (b b') (Algebra.TensorProduct.mul).
defunique algebraTensorMultiplication (A B : Set)
    (μ ∈ functionSpace(
      Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A),
        algebraModule(B))) ×
      Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A),
        algebraModule(B))),
      Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A),
        algebraModule(B))))) :=
  BilinearMap(μ, tensorProduct(algebraModule(A), Algebra.base(A),
      algebraModule(B)),
    tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B)),
    tensorProduct(algebraModule(A), Algebra.base(A), algebraModule(B)),
    Algebra.base(A)) ∧
  (∀ a a2 ∈ algebraCarrier(A), ∀ b b2 ∈ algebraCarrier(B),
    μ((tmul(algebraModule(A), Algebra.base(A), algebraModule(B), a, b),
       tmul(algebraModule(A), Algebra.base(A), algebraModule(B), a2, b2))) =
    tmul(algebraModule(A), Algebra.base(A), algebraModule(B),
      call2(Ring.mul(Algebra.ring(A)), a, a2),
      call2(Ring.mul(Algebra.ring(B)), b, b2)))
requires algebraA : Algebra(A)
requires algebraB : Algebra(B)
requires sameBase : Algebra.base(A) = Algebra.base(B)
proof
  sorry
uniqueness
  sorry

-- The ring A ⊗ B, with one 1 ⊗ 1, and the R-algebra with structure map
-- r ↦ (r · 1) ⊗ 1.
def algebraTensorRing (A B : Set) : Set :=
  Ring.mk(
    Module.carrier(tensorProduct(algebraModule(A), Algebra.base(A),
      algebraModule(B))),
    Module.add(tensorProduct(algebraModule(A), Algebra.base(A),
      algebraModule(B))),
    Module.zero(tensorProduct(algebraModule(A), Algebra.base(A),
      algebraModule(B))),
    Module.neg(tensorProduct(algebraModule(A), Algebra.base(A),
      algebraModule(B))),
    algebraTensorMultiplication(A, B),
    tmul(algebraModule(A), Algebra.base(A), algebraModule(B),
      Ring.one(Algebra.ring(A)), Ring.one(Algebra.ring(B))))

def algebraTensorMap (A B : Set) : Set :=
  { p ∈ Ring.carrier(Algebra.base(A)) × Ring.carrier(algebraTensorRing(A, B)) |
    ∃ r ∈ Ring.carrier(Algebra.base(A)),
      p = (r, tmul(algebraModule(A), Algebra.base(A), algebraModule(B),
        Algebra.map(A)(r), Ring.one(Algebra.ring(B)))) }

def algebraTensor (A B : Set) : Set :=
  Algebra.mk(Algebra.base(A), algebraTensorRing(A, B), algebraTensorMap(A, B))

-- a ↦ a ⊗ 1 and b ↦ 1 ⊗ b (Algebra.TensorProduct.includeLeft,
-- includeRight).
def includeLeft (A B : Set) : Set :=
  { p ∈ algebraCarrier(A) × Ring.carrier(algebraTensorRing(A, B)) |
    ∃ a ∈ algebraCarrier(A), p = (a, tmul(algebraModule(A), Algebra.base(A),
      algebraModule(B), a, Ring.one(Algebra.ring(B)))) }

def includeRight (A B : Set) : Set :=
  { p ∈ algebraCarrier(B) × Ring.carrier(algebraTensorRing(A, B)) |
    ∃ b ∈ algebraCarrier(B), p = (b, tmul(algebraModule(A), Algebra.base(A),
      algebraModule(B), Ring.one(Algebra.ring(A)), b)) }

-- For algebra maps f : A → C and g : B → C, the algebra map A ⊗ B → C,
-- a ⊗ b ↦ f(a) g(b) (Algebra.TensorProduct.productMap).
def productMapPairs (A B C f g : Set) : Set :=
  { p ∈ (algebraCarrier(A) × algebraCarrier(B)) × algebraCarrier(C) |
    ∃ a ∈ algebraCarrier(A), ∃ b ∈ algebraCarrier(B),
      p = ((a, b), call2(Ring.mul(Algebra.ring(C)), f(a), g(b))) }

def productMap (A B C f g : Set) : Set :=
  tensorLift(algebraModule(A), Algebra.base(A), algebraModule(B),
    algebraModule(C), productMapPairs(A, B, C, f, g))

-- Section: Graph lemmas
theorem tensorMk.graph_relates (M R N m n : Set)
  requires rowIn : m ∈ Module.carrier(M)
  requires colIn : n ∈ Module.carrier(N)
  requires valueIn : tmul(M, R, N, m, n) ∈ Module.carrier(tensorProduct(M, R, N))
  shows relates(tensorMk(M, R, N), (m, n), tmul(M, R, N, m, n))
proof
  have pairIn := product.pair at m, n, Module.carrier(M), Module.carrier(N) with rowIn, colIn
  have outer := product.pair at (m, n), tmul(M, R, N, m, n), Module.carrier(M) × Module.carrier(N), Module.carrier(tensorProduct(M, R, N)) with pairIn, valueIn
  unfold relates
  apply tensorMk.membership.backward
  exact ⟨outer, m, rowIn, n, colIn, rfl⟩

theorem tensorMk.graph_function (M R N : Set)
  requires values : ∀ m ∈ Module.carrier(M), ∀ n ∈ Module.carrier(N), tmul(M, R, N, m, n) ∈ Module.carrier(tensorProduct(M, R, N))
  shows tensorMk(M, R, N) : Module.carrier(M) × Module.carrier(N) → Module.carrier(tensorProduct(M, R, N))
proof
  constructor
    intros q0 member
    obtain ⟨bounded, witnesses⟩ := tensorMk.membership.forward with member
    exact bounded
  . constructor
      intros z0 first xFirst second xSecond
      unfold relates at xFirst
      obtain ⟨_, a1, a1In, b1, b1In, firstShape⟩ := tensorMk.membership.forward with xFirst
      unfold relates at xSecond
      obtain ⟨_, a2, a2In, b2, b2In, secondShape⟩ := tensorMk.membership.forward with xSecond
      obtain ⟨xi, firstEqual⟩ := orderedPair.injective with firstShape
      obtain ⟨xj, secondEqual⟩ := orderedPair.injective with secondShape
      rw xi at xj
      obtain ⟨aa, bb⟩ := orderedPair.injective with xj
      rw [firstEqual, secondEqual]
      cc
    . intros q0 pIn
      obtain ⟨bound, m, rowIn, n, colIn, shape⟩ := product.membership.forward with pIn
      have valueIn := values with m, rowIn, n, colIn
      have mapped := tensorMk.graph_relates at M, R, N, m, n with rowIn, colIn, valueIn
      rw shape
      exact ⟨tmul(M, R, N, m, n), valueIn, mapped⟩

theorem tensorMk.graph_entry (M R N m n : Set)
  requires values : ∀ m ∈ Module.carrier(M), ∀ n ∈ Module.carrier(N), tmul(M, R, N, m, n) ∈ Module.carrier(tensorProduct(M, R, N))
  requires rowIn : m ∈ Module.carrier(M)
  requires colIn : n ∈ Module.carrier(N)
  shows tensorMk(M, R, N)((m, n)) = tmul(M, R, N, m, n)
proof
  have function := tensorMk.graph_function at M, R, N with values
  have valueIn := values with m, rowIn, n, colIn
  have mapped := tensorMk.graph_relates at M, R, N, m, n with rowIn, colIn, valueIn
  have pairIn := product.pair at m, n, Module.carrier(M), Module.carrier(N) with rowIn, colIn
  exact FunctionBetween.apply_value with function, pairIn, mapped

theorem tensorMapPairs.graph_relates (f g M N M2 R N2 m n : Set)
  requires rowIn : m ∈ Module.carrier(M)
  requires colIn : n ∈ Module.carrier(N)
  requires valueIn : tmul(M2, R, N2, f(m), g(n)) ∈ Module.carrier(tensorProduct(M2, R, N2))
  shows relates(tensorMapPairs(f, g, M, N, M2, R, N2), (m, n), tmul(M2, R, N2, f(m), g(n)))
proof
  have pairIn := product.pair at m, n, Module.carrier(M), Module.carrier(N) with rowIn, colIn
  have outer := product.pair at (m, n), tmul(M2, R, N2, f(m), g(n)), Module.carrier(M) × Module.carrier(N), Module.carrier(tensorProduct(M2, R, N2)) with pairIn, valueIn
  unfold relates
  apply tensorMapPairs.membership.backward
  exact ⟨outer, m, rowIn, n, colIn, rfl⟩

theorem tensorMapPairs.graph_function (f g M N M2 R N2 : Set)
  requires values : ∀ m ∈ Module.carrier(M), ∀ n ∈ Module.carrier(N), tmul(M2, R, N2, f(m), g(n)) ∈ Module.carrier(tensorProduct(M2, R, N2))
  shows tensorMapPairs(f, g, M, N, M2, R, N2) : Module.carrier(M) × Module.carrier(N) → Module.carrier(tensorProduct(M2, R, N2))
proof
  constructor
    intros q0 member
    obtain ⟨bounded, witnesses⟩ := tensorMapPairs.membership.forward with member
    exact bounded
  . constructor
      intros z0 first xFirst second xSecond
      unfold relates at xFirst
      obtain ⟨_, a1, a1In, b1, b1In, firstShape⟩ := tensorMapPairs.membership.forward with xFirst
      unfold relates at xSecond
      obtain ⟨_, a2, a2In, b2, b2In, secondShape⟩ := tensorMapPairs.membership.forward with xSecond
      obtain ⟨xi, firstEqual⟩ := orderedPair.injective with firstShape
      obtain ⟨xj, secondEqual⟩ := orderedPair.injective with secondShape
      rw xi at xj
      obtain ⟨aa, bb⟩ := orderedPair.injective with xj
      rw [firstEqual, secondEqual]
      cc
    . intros q0 pIn
      obtain ⟨bound, m, rowIn, n, colIn, shape⟩ := product.membership.forward with pIn
      have valueIn := values with m, rowIn, n, colIn
      have mapped := tensorMapPairs.graph_relates at f, g, M, N, M2, R, N2, m, n with rowIn, colIn, valueIn
      rw shape
      exact ⟨tmul(M2, R, N2, f(m), g(n)), valueIn, mapped⟩

theorem tensorMapPairs.graph_entry (f g M N M2 R N2 m n : Set)
  requires values : ∀ m ∈ Module.carrier(M), ∀ n ∈ Module.carrier(N), tmul(M2, R, N2, f(m), g(n)) ∈ Module.carrier(tensorProduct(M2, R, N2))
  requires rowIn : m ∈ Module.carrier(M)
  requires colIn : n ∈ Module.carrier(N)
  shows tensorMapPairs(f, g, M, N, M2, R, N2)((m, n)) = tmul(M2, R, N2, f(m), g(n))
proof
  have function := tensorMapPairs.graph_function at f, g, M, N, M2, R, N2 with values
  have valueIn := values with m, rowIn, n, colIn
  have mapped := tensorMapPairs.graph_relates at f, g, M, N, M2, R, N2, m, n with rowIn, colIn, valueIn
  have pairIn := product.pair at m, n, Module.carrier(M), Module.carrier(N) with rowIn, colIn
  exact FunctionBetween.apply_value with function, pairIn, mapped

theorem tensorSwapPairs.graph_relates (M R N m n : Set)
  requires rowIn : m ∈ Module.carrier(M)
  requires colIn : n ∈ Module.carrier(N)
  requires valueIn : tmul(N, R, M, n, m) ∈ Module.carrier(tensorProduct(N, R, M))
  shows relates(tensorSwapPairs(M, R, N), (m, n), tmul(N, R, M, n, m))
proof
  have pairIn := product.pair at m, n, Module.carrier(M), Module.carrier(N) with rowIn, colIn
  have outer := product.pair at (m, n), tmul(N, R, M, n, m), Module.carrier(M) × Module.carrier(N), Module.carrier(tensorProduct(N, R, M)) with pairIn, valueIn
  unfold relates
  apply tensorSwapPairs.membership.backward
  exact ⟨outer, m, rowIn, n, colIn, rfl⟩

theorem tensorSwapPairs.graph_function (M R N : Set)
  requires values : ∀ m ∈ Module.carrier(M), ∀ n ∈ Module.carrier(N), tmul(N, R, M, n, m) ∈ Module.carrier(tensorProduct(N, R, M))
  shows tensorSwapPairs(M, R, N) : Module.carrier(M) × Module.carrier(N) → Module.carrier(tensorProduct(N, R, M))
proof
  constructor
    intros q0 member
    obtain ⟨bounded, witnesses⟩ := tensorSwapPairs.membership.forward with member
    exact bounded
  . constructor
      intros z0 first xFirst second xSecond
      unfold relates at xFirst
      obtain ⟨_, a1, a1In, b1, b1In, firstShape⟩ := tensorSwapPairs.membership.forward with xFirst
      unfold relates at xSecond
      obtain ⟨_, a2, a2In, b2, b2In, secondShape⟩ := tensorSwapPairs.membership.forward with xSecond
      obtain ⟨xi, firstEqual⟩ := orderedPair.injective with firstShape
      obtain ⟨xj, secondEqual⟩ := orderedPair.injective with secondShape
      rw xi at xj
      obtain ⟨aa, bb⟩ := orderedPair.injective with xj
      rw [firstEqual, secondEqual]
      cc
    . intros q0 pIn
      obtain ⟨bound, m, rowIn, n, colIn, shape⟩ := product.membership.forward with pIn
      have valueIn := values with m, rowIn, n, colIn
      have mapped := tensorSwapPairs.graph_relates at M, R, N, m, n with rowIn, colIn, valueIn
      rw shape
      exact ⟨tmul(N, R, M, n, m), valueIn, mapped⟩

theorem tensorSwapPairs.graph_entry (M R N m n : Set)
  requires values : ∀ m ∈ Module.carrier(M), ∀ n ∈ Module.carrier(N), tmul(N, R, M, n, m) ∈ Module.carrier(tensorProduct(N, R, M))
  requires rowIn : m ∈ Module.carrier(M)
  requires colIn : n ∈ Module.carrier(N)
  shows tensorSwapPairs(M, R, N)((m, n)) = tmul(N, R, M, n, m)
proof
  have function := tensorSwapPairs.graph_function at M, R, N with values
  have valueIn := values with m, rowIn, n, colIn
  have mapped := tensorSwapPairs.graph_relates at M, R, N, m, n with rowIn, colIn, valueIn
  have pairIn := product.pair at m, n, Module.carrier(M), Module.carrier(N) with rowIn, colIn
  exact FunctionBetween.apply_value with function, pairIn, mapped

theorem liftBaseChangePairs.graph_relates (A M N f a m : Set)
  requires rowIn : a ∈ algebraCarrier(A)
  requires colIn : m ∈ Module.carrier(M)
  requires valueIn : call2(Module.smul(N), a, f(m)) ∈ Module.carrier(N)
  shows relates(liftBaseChangePairs(A, M, N, f), (a, m), call2(Module.smul(N), a, f(m)))
proof
  have pairIn := product.pair at a, m, algebraCarrier(A), Module.carrier(M) with rowIn, colIn
  have outer := product.pair at (a, m), call2(Module.smul(N), a, f(m)), algebraCarrier(A) × Module.carrier(M), Module.carrier(N) with pairIn, valueIn
  unfold relates
  apply liftBaseChangePairs.membership.backward
  exact ⟨outer, a, rowIn, m, colIn, rfl⟩

theorem liftBaseChangePairs.graph_function (A M N f : Set)
  requires values : ∀ a ∈ algebraCarrier(A), ∀ m ∈ Module.carrier(M), call2(Module.smul(N), a, f(m)) ∈ Module.carrier(N)
  shows liftBaseChangePairs(A, M, N, f) : algebraCarrier(A) × Module.carrier(M) → Module.carrier(N)
proof
  constructor
    intros q0 member
    obtain ⟨bounded, witnesses⟩ := liftBaseChangePairs.membership.forward with member
    exact bounded
  . constructor
      intros z0 first xFirst second xSecond
      unfold relates at xFirst
      obtain ⟨_, a1, a1In, b1, b1In, firstShape⟩ := liftBaseChangePairs.membership.forward with xFirst
      unfold relates at xSecond
      obtain ⟨_, a2, a2In, b2, b2In, secondShape⟩ := liftBaseChangePairs.membership.forward with xSecond
      obtain ⟨xi, firstEqual⟩ := orderedPair.injective with firstShape
      obtain ⟨xj, secondEqual⟩ := orderedPair.injective with secondShape
      rw xi at xj
      obtain ⟨aa, bb⟩ := orderedPair.injective with xj
      rw [firstEqual, secondEqual]
      cc
    . intros q0 pIn
      obtain ⟨bound, a, rowIn, m, colIn, shape⟩ := product.membership.forward with pIn
      have valueIn := values with a, rowIn, m, colIn
      have mapped := liftBaseChangePairs.graph_relates at A, M, N, f, a, m with rowIn, colIn, valueIn
      rw shape
      exact ⟨call2(Module.smul(N), a, f(m)), valueIn, mapped⟩

theorem liftBaseChangePairs.graph_entry (A M N f a m : Set)
  requires values : ∀ a ∈ algebraCarrier(A), ∀ m ∈ Module.carrier(M), call2(Module.smul(N), a, f(m)) ∈ Module.carrier(N)
  requires rowIn : a ∈ algebraCarrier(A)
  requires colIn : m ∈ Module.carrier(M)
  shows liftBaseChangePairs(A, M, N, f)((a, m)) = call2(Module.smul(N), a, f(m))
proof
  have function := liftBaseChangePairs.graph_function at A, M, N, f with values
  have valueIn := values with a, rowIn, m, colIn
  have mapped := liftBaseChangePairs.graph_relates at A, M, N, f, a, m with rowIn, colIn, valueIn
  have pairIn := product.pair at a, m, algebraCarrier(A), Module.carrier(M) with rowIn, colIn
  exact FunctionBetween.apply_value with function, pairIn, mapped

theorem productMapPairs.graph_relates (A B C f g a b : Set)
  requires rowIn : a ∈ algebraCarrier(A)
  requires colIn : b ∈ algebraCarrier(B)
  requires valueIn : call2(Ring.mul(Algebra.ring(C)), f(a), g(b)) ∈ algebraCarrier(C)
  shows relates(productMapPairs(A, B, C, f, g), (a, b), call2(Ring.mul(Algebra.ring(C)), f(a), g(b)))
proof
  have pairIn := product.pair at a, b, algebraCarrier(A), algebraCarrier(B) with rowIn, colIn
  have outer := product.pair at (a, b), call2(Ring.mul(Algebra.ring(C)), f(a), g(b)), algebraCarrier(A) × algebraCarrier(B), algebraCarrier(C) with pairIn, valueIn
  unfold relates
  apply productMapPairs.membership.backward
  exact ⟨outer, a, rowIn, b, colIn, rfl⟩

theorem productMapPairs.graph_function (A B C f g : Set)
  requires values : ∀ a ∈ algebraCarrier(A), ∀ b ∈ algebraCarrier(B), call2(Ring.mul(Algebra.ring(C)), f(a), g(b)) ∈ algebraCarrier(C)
  shows productMapPairs(A, B, C, f, g) : algebraCarrier(A) × algebraCarrier(B) → algebraCarrier(C)
proof
  constructor
    intros q0 member
    obtain ⟨bounded, witnesses⟩ := productMapPairs.membership.forward with member
    exact bounded
  . constructor
      intros z0 first xFirst second xSecond
      unfold relates at xFirst
      obtain ⟨_, a1, a1In, b1, b1In, firstShape⟩ := productMapPairs.membership.forward with xFirst
      unfold relates at xSecond
      obtain ⟨_, a2, a2In, b2, b2In, secondShape⟩ := productMapPairs.membership.forward with xSecond
      obtain ⟨xi, firstEqual⟩ := orderedPair.injective with firstShape
      obtain ⟨xj, secondEqual⟩ := orderedPair.injective with secondShape
      rw xi at xj
      obtain ⟨aa, bb⟩ := orderedPair.injective with xj
      rw [firstEqual, secondEqual]
      cc
    . intros q0 pIn
      obtain ⟨bound, a, rowIn, b, colIn, shape⟩ := product.membership.forward with pIn
      have valueIn := values with a, rowIn, b, colIn
      have mapped := productMapPairs.graph_relates at A, B, C, f, g, a, b with rowIn, colIn, valueIn
      rw shape
      exact ⟨call2(Ring.mul(Algebra.ring(C)), f(a), g(b)), valueIn, mapped⟩

theorem productMapPairs.graph_entry (A B C f g a b : Set)
  requires values : ∀ a ∈ algebraCarrier(A), ∀ b ∈ algebraCarrier(B), call2(Ring.mul(Algebra.ring(C)), f(a), g(b)) ∈ algebraCarrier(C)
  requires rowIn : a ∈ algebraCarrier(A)
  requires colIn : b ∈ algebraCarrier(B)
  shows productMapPairs(A, B, C, f, g)((a, b)) = call2(Ring.mul(Algebra.ring(C)), f(a), g(b))
proof
  have function := productMapPairs.graph_function at A, B, C, f, g with values
  have valueIn := values with a, rowIn, b, colIn
  have mapped := productMapPairs.graph_relates at A, B, C, f, g, a, b with rowIn, colIn, valueIn
  have pairIn := product.pair at a, b, algebraCarrier(A), algebraCarrier(B) with rowIn, colIn
  exact FunctionBetween.apply_value with function, pairIn, mapped

theorem productFamily.graph_relates (I J X Y v w i j : Set)
  requires rowIn : i ∈ I
  requires colIn : j ∈ J
  requires valueIn : (v(i), w(j)) ∈ X × Y
  shows relates(productFamily(I, J, X, Y, v, w), (i, j), (v(i), w(j)))
proof
  have pairIn := product.pair at i, j, I, J with rowIn, colIn
  have outer := product.pair at (i, j), (v(i), w(j)), I × J, X × Y with pairIn, valueIn
  unfold relates
  apply productFamily.membership.backward
  exact ⟨outer, i, rowIn, j, colIn, rfl⟩

theorem productFamily.graph_function (I J X Y v w : Set)
  requires values : ∀ i ∈ I, ∀ j ∈ J, (v(i), w(j)) ∈ X × Y
  shows productFamily(I, J, X, Y, v, w) : I × J → X × Y
proof
  constructor
    intros q0 member
    obtain ⟨bounded, witnesses⟩ := productFamily.membership.forward with member
    exact bounded
  . constructor
      intros z0 first xFirst second xSecond
      unfold relates at xFirst
      obtain ⟨_, a1, a1In, b1, b1In, firstShape⟩ := productFamily.membership.forward with xFirst
      unfold relates at xSecond
      obtain ⟨_, a2, a2In, b2, b2In, secondShape⟩ := productFamily.membership.forward with xSecond
      obtain ⟨xi, firstEqual⟩ := orderedPair.injective with firstShape
      obtain ⟨xj, secondEqual⟩ := orderedPair.injective with secondShape
      rw xi at xj
      obtain ⟨aa, bb⟩ := orderedPair.injective with xj
      rw [firstEqual, secondEqual]
      cc
    . intros q0 pIn
      obtain ⟨bound, i, rowIn, j, colIn, shape⟩ := product.membership.forward with pIn
      have valueIn := values with i, rowIn, j, colIn
      have mapped := productFamily.graph_relates at I, J, X, Y, v, w, i, j with rowIn, colIn, valueIn
      rw shape
      exact ⟨(v(i), w(j)), valueIn, mapped⟩

theorem productFamily.graph_entry (I J X Y v w i j : Set)
  requires values : ∀ i ∈ I, ∀ j ∈ J, (v(i), w(j)) ∈ X × Y
  requires rowIn : i ∈ I
  requires colIn : j ∈ J
  shows productFamily(I, J, X, Y, v, w)((i, j)) = (v(i), w(j))
proof
  have function := productFamily.graph_function at I, J, X, Y, v, w with values
  have valueIn := values with i, rowIn, j, colIn
  have mapped := productFamily.graph_relates at I, J, X, Y, v, w, i, j with rowIn, colIn, valueIn
  have pairIn := product.pair at i, j, I, J with rowIn, colIn
  exact FunctionBetween.apply_value with function, pairIn, mapped

theorem pairFamily.graph_relates (k X Y u w i : Set)
  requires index : i ∈ k
  requires valueIn : (u(i), w(i)) ∈ X × Y
  shows relates(pairFamily(k, X, Y, u, w), i, (u(i), w(i)))
proof
  unfold relates
  apply pairFamily.membership.backward
  refine ⟨(product.pair at i, (u(i), w(i)), k, X × Y with index, valueIn), i, index, rfl⟩

theorem pairFamily.graph_function (k X Y u w : Set)
  requires values : ∀ i ∈ k, (u(i), w(i)) ∈ X × Y
  shows pairFamily(k, X, Y, u, w) : k → X × Y
proof
  constructor
    intros q0 member
    obtain ⟨bounded, witnesses⟩ := pairFamily.membership.forward with member
    exact bounded
  . constructor
      intros z0 first xFirst second xSecond
      unfold relates at xFirst
      obtain ⟨_, a1, a1In, firstShape⟩ := pairFamily.membership.forward with xFirst
      unfold relates at xSecond
      obtain ⟨_, a2, a2In, secondShape⟩ := pairFamily.membership.forward with xSecond
      obtain ⟨xi, firstEqual⟩ := orderedPair.injective with firstShape
      obtain ⟨xj, secondEqual⟩ := orderedPair.injective with secondShape
      rw [firstEqual, secondEqual]
      cc
    . intros i xIn
      have valueIn := values with i, xIn
      refine ⟨(u(i), w(i)), valueIn, (pairFamily.graph_relates at k, X, Y, u, w, i with xIn, valueIn)⟩

theorem pairFamily.graph_apply (k X Y u w i : Set)
  requires values : ∀ i ∈ k, (u(i), w(i)) ∈ X × Y
  requires index : i ∈ k
  shows pairFamily(k, X, Y, u, w)(i) = (u(i), w(i))
proof
  have function := pairFamily.graph_function at k, X, Y, u, w with values
  have valueIn := values with i, index
  have mapped := pairFamily.graph_relates at k, X, Y, u, w, i with index, valueIn
  exact FunctionBetween.apply_value with function, index, mapped


-- Section: Linear maps killing differences
section TensorToolkit
variable (R A B f : Set)
hypothesis ringT : Ring(R)
hypothesis linearT : LinearMap(f, A, R, B)

theorem LinearMap.difference_zero (a b c : Set)
  requires ha : a ∈ Module.carrier(A)
  requires hb : b ∈ Module.carrier(A)
  requires hc : c ∈ Module.carrier(A)
  requires zero : f(call2(Module.add(A), call2(Module.add(A), a,
    apply(Module.neg(A), b)), apply(Module.neg(A), c))) = Module.zero(B)
  shows f(a) = call2(Module.add(B), f(b), f(c))
proof
  have moduleA := LinearMap.source_module with linearT
  have moduleB := LinearMap.target_module with linearT
  have nb := Module.neg_mem at R, A, b with *
  have nc := Module.neg_mem at R, A, c with *
  have ab := Module.add_mem at R, A, a, apply(Module.neg(A), b) with *
  have e1 := LinearMap.add_law at f, A, R, B, call2(Module.add(A), a, apply(Module.neg(A), b)), apply(Module.neg(A), c) with *
  have e2 := LinearMap.add_law at f, A, R, B, a, apply(Module.neg(A), b) with *
  have e3 := LinearMap.neg_law at R, A, B, f, b with *
  have e4 := LinearMap.neg_law at R, A, B, f, c with *
  rw [e1, e2, e3, e4] at zero
  have fa := LinearMap.value_mem at f, A, R, B, a with *
  have fb := LinearMap.value_mem at f, A, R, B, b with *
  have fc := LinearMap.value_mem at f, A, R, B, c with *
  have nfb := Module.neg_mem at R, B, f(b) with *
  have nfc := Module.neg_mem at R, B, f(c) with *
  have s1 := Module.add_mem at R, B, f(a), apply(Module.neg(B), f(b)) with *
  have s2 := (Module.sub_eq_zero_iff at R, B, call2(Module.add(B), f(a), apply(Module.neg(B), f(b))), f(c) with *).forward with zero
  have s4 := Module.add_assoc at R, B, f(a), apply(Module.neg(B), f(b)), f(b) with *
  have s5 := Module.neg_add at R, B, f(b) with *
  have s6 := Module.add_zero at R, B, f(a) with *
  have s7 := Module.add_comm at R, B, f(c), f(b) with *
  rw [s2, s5, s6] at s4
  rw [← s7, ← s4]

theorem LinearMap.scaled_difference_zero (a r b : Set)
  requires ha : a ∈ Module.carrier(A)
  requires hr : r ∈ Ring.carrier(R)
  requires hb : b ∈ Module.carrier(A)
  requires zero : f(call2(Module.add(A), a,
    apply(Module.neg(A), call2(Module.smul(A), r, b)))) = Module.zero(B)
  shows f(a) = call2(Module.smul(B), r, f(b))
proof
  have moduleA := LinearMap.source_module with linearT
  have moduleB := LinearMap.target_module with linearT
  have rb := Module.smul_mem at R, A, r, b with *
  have nrb := Module.neg_mem at R, A, call2(Module.smul(A), r, b) with *
  have e1 := LinearMap.add_law at f, A, R, B, a, apply(Module.neg(A), call2(Module.smul(A), r, b)) with *
  have e2 := LinearMap.neg_law at R, A, B, f, call2(Module.smul(A), r, b) with *
  have e3 := LinearMap.smul_law at f, A, R, B, r, b with *
  rw [e1, e2, e3] at zero
  have fa := LinearMap.value_mem at f, A, R, B, a with *
  have fb := LinearMap.value_mem at f, A, R, B, b with *
  have rfb := Module.smul_mem at R, B, r, f(b) with *
  exact (Module.sub_eq_zero_iff at R, B, f(a), call2(Module.smul(B), r, f(b)) with *).forward with zero

end TensorToolkit

-- Section: Laws of tensor products
section Tensors
variable (R M N : Set)
hypothesis ring : CommRing(R)
hypothesis moduleM : Module(M, R)
hypothesis moduleN : Module(N, R)

theorem tensorRelations.submodule
  shows SubmoduleOf(tensorRelations(M, R, N), pairModule(M, R, N), R)
proof
  have ringR := CommRing.to_ring with ring
  have pm : Module(pairModule(M, R, N), R)
    unfold pairModule
    exact freeModule.module at R, M.carrier × N.carrier with ring
  unfold tensorRelations
  exact moduleSpan.submodule_of at R, pairModule(M, R, N), tensorRelators(M, R, N) with ringR, pm

theorem pairModule.module
  shows Module(pairModule(M, R, N), R)
proof
  unfold pairModule
  exact freeModule.module at R, M.carrier × N.carrier with ring

theorem pairModule.carrier_eq
  shows Module.carrier(pairModule(M, R, N)) =
    finitelySupported(R, M.carrier × N.carrier)
proof
  unfold pairModule
  exact freeModule.carrierOf at R, M.carrier × N.carrier with ring

theorem pairGenerator.mem (m n : Set)
  requires hm : m ∈ M.carrier
  requires hn : n ∈ N.carrier
  shows pairGenerator(M, R, N, m, n) ∈ Module.carrier(pairModule(M, R, N))
proof
  have pair := product.pair at m, n, M.carrier, N.carrier with hm, hn
  have u := unitVector.finitely_supported at R, M.carrier × N.carrier, (m, n) with ring, pair
  have c := pairModule.carrier_eq at R, M, N with *
  rw c
  unfold pairGenerator
  exact u

theorem pairDifference.mem (a b c : Set)
  requires ha : a ∈ Module.carrier(pairModule(M, R, N))
  requires hb : b ∈ Module.carrier(pairModule(M, R, N))
  requires hc : c ∈ Module.carrier(pairModule(M, R, N))
  shows pairDifference(M, R, N, a, b, c) ∈ Module.carrier(pairModule(M, R, N))
proof
  have ringR := CommRing.to_ring with ring
  have pm := pairModule.module at R, M, N with *
  have nb := Module.neg_mem at R, pairModule(M, R, N), b with *
  have nc := Module.neg_mem at R, pairModule(M, R, N), c with *
  have ab := Module.add_mem at R, pairModule(M, R, N), a, apply(Module.neg(pairModule(M, R, N)), b) with *
  unfold pairDifference
  exact Module.add_mem at R, pairModule(M, R, N), call2(Module.add(pairModule(M, R, N)), a, apply(Module.neg(pairModule(M, R, N)), b)), apply(Module.neg(pairModule(M, R, N)), c) with *

theorem pairScaledDifference.mem (a r b : Set)
  requires ha : a ∈ Module.carrier(pairModule(M, R, N))
  requires hr : r ∈ R.carrier
  requires hb : b ∈ Module.carrier(pairModule(M, R, N))
  shows pairScaledDifference(M, R, N, a, r, b) ∈ Module.carrier(pairModule(M, R, N))
proof
  have ringR := CommRing.to_ring with ring
  have pm := pairModule.module at R, M, N with *
  have rb := Module.smul_mem at R, pairModule(M, R, N), r, b with *
  have nrb := Module.neg_mem at R, pairModule(M, R, N), call2(Module.smul(pairModule(M, R, N)), r, b) with *
  unfold pairScaledDifference
  exact Module.add_mem at R, pairModule(M, R, N), a, apply(Module.neg(pairModule(M, R, N)), call2(Module.smul(pairModule(M, R, N)), r, b)) with *

theorem tensorRelators.subset
  shows tensorRelators(M, R, N) ⊆ Module.carrier(pairModule(M, R, N))
proof
  have c := pairModule.carrier_eq at R, M, N with *
  intros z hz
  obtain ⟨zIn, _⟩ := tensorRelators.membership.forward with hz
  rw c
  exact zIn

theorem tensorQuotient.linear
  shows LinearMap(quotientModuleMap(pairModule(M, R, N), tensorRelations(M, R, N)),
    pairModule(M, R, N), R, tensorProduct(M, R, N))
proof
  have ringR := CommRing.to_ring with ring
  have pm := pairModule.module at R, M, N with *
  have sub := tensorRelations.submodule at R, M, N with *
  unfold tensorProduct
  exact SubmoduleOf.quotient_map_linear at R, pairModule(M, R, N), tensorRelations(M, R, N) with ringR, pm, sub

theorem tensorRelations.kills (z : Set)
  requires hz : z ∈ tensorRelations(M, R, N)
  shows quotientModuleMap(pairModule(M, R, N), tensorRelations(M, R, N))(z) =
    Module.zero(tensorProduct(M, R, N))
proof
  have ringR := CommRing.to_ring with ring
  have pm := pairModule.module at R, M, N with *
  have sub := tensorRelations.submodule at R, M, N with *
  have ker := SubmoduleOf.quotient_kernel at R, pairModule(M, R, N), tensorRelations(M, R, N) with ringR, pm, sub
  rw ← ker at hz
  obtain ⟨_, zero⟩ := linearKernel.membership.forward with hz
  unfold tensorProduct
  exact zero

theorem tensorRelators.kills (z : Set)
  requires hz : z ∈ tensorRelators(M, R, N)
  shows quotientModuleMap(pairModule(M, R, N), tensorRelations(M, R, N))(z) =
    Module.zero(tensorProduct(M, R, N))
proof
  have ringR := CommRing.to_ring with ring
  have pm := pairModule.module at R, M, N with *
  have inside := tensorRelators.subset at R, M, N with *
  have span := moduleSpan.subset_of at R, pairModule(M, R, N), tensorRelators(M, R, N) with ringR, pm, inside
  have zIn := span with z, hz
  have zRel : z ∈ tensorRelations(M, R, N)
    unfold tensorRelations
    exact zIn
  exact tensorRelations.kills at R, M, N, z with *

theorem tensorProduct.module
  shows Module(tensorProduct(M, R, N), R)
proof
  have ringR := CommRing.to_ring with ring
  have pm := pairModule.module at R, M, N with *
  have sub := tensorRelations.submodule at R, M, N with *
  unfold tensorProduct
  exact SubmoduleOf.quotient_module at R, pairModule(M, R, N), tensorRelations(M, R, N) with ringR, pm, sub

theorem tmul.mem (m : M) (n : N)
  shows tmul(M, R, N, m, n) ∈ Module.carrier(tensorProduct(M, R, N))
proof
  have lin := tensorQuotient.linear at R, M, N with *
  have g := pairGenerator.mem at R, M, N, m, n with *
  unfold tmul
  exact LinearMap.value_mem with lin, g

-- TensorProduct.add_tmul and tmul_add.
theorem tmul.add_left (m m2 : M) (n : N)
  shows tmul(M, R, N, m + m2, n) = call2(Module.add(tensorProduct(M, R, N)),
    tmul(M, R, N, m, n), tmul(M, R, N, m2, n))
proof
  have hm : m ∈ M.carrier by assumption
  have hm2 : m2 ∈ M.carrier by assumption
  have hn : n ∈ N.carrier by assumption
  have ringR := CommRing.to_ring with ring
  have hsum := Module.add_mem at R, M, m, m2 with *
  have lin := tensorQuotient.linear at R, M, N with *
  have ga := pairGenerator.mem at R, M, N, m + m2, n with *
  have gb := pairGenerator.mem at R, M, N, m, n with *
  have gc := pairGenerator.mem at R, M, N, m2, n with *
  have dIn := pairDifference.mem at R, M, N, pairGenerator(M, R, N, m + m2, n), pairGenerator(M, R, N, m, n), pairGenerator(M, R, N, m2, n) with *
  have c := pairModule.carrier_eq at R, M, N with *
  rw c at dIn
  have rel : pairDifference(M, R, N, pairGenerator(M, R, N, m + m2, n), pairGenerator(M, R, N, m, n), pairGenerator(M, R, N, m2, n)) ∈ tensorRelators(M, R, N)
    apply tensorRelators.membership.backward
    refine ⟨dIn, ?_⟩
    left
    exact ⟨m, hm, m2, hm2, n, hn, rfl⟩
  have zero := tensorRelators.kills at R, M, N with rel
  unfold pairDifference at zero
  unfold tmul
  exact LinearMap.difference_zero at R, pairModule(M, R, N), tensorProduct(M, R, N), quotientModuleMap(pairModule(M, R, N), tensorRelations(M, R, N)) with ringR, lin, ga, gb, gc, zero

theorem tmul.add_right (m : M) (n n2 : N)
  shows tmul(M, R, N, m, n + n2) = call2(Module.add(tensorProduct(M, R, N)),
    tmul(M, R, N, m, n), tmul(M, R, N, m, n2))
proof
  have hm : m ∈ M.carrier by assumption
  have hn : n ∈ N.carrier by assumption
  have hn2 : n2 ∈ N.carrier by assumption
  have ringR := CommRing.to_ring with ring
  have hsum := Module.add_mem at R, N, n, n2 with *
  have lin := tensorQuotient.linear at R, M, N with *
  have ga := pairGenerator.mem at R, M, N, m, n + n2 with *
  have gb := pairGenerator.mem at R, M, N, m, n with *
  have gc := pairGenerator.mem at R, M, N, m, n2 with *
  have dIn := pairDifference.mem at R, M, N, pairGenerator(M, R, N, m, n + n2), pairGenerator(M, R, N, m, n), pairGenerator(M, R, N, m, n2) with *
  have c := pairModule.carrier_eq at R, M, N with *
  rw c at dIn
  have rel : pairDifference(M, R, N, pairGenerator(M, R, N, m, n + n2), pairGenerator(M, R, N, m, n), pairGenerator(M, R, N, m, n2)) ∈ tensorRelators(M, R, N)
    apply tensorRelators.membership.backward
    refine ⟨dIn, ?_⟩
    right
    left
    exact ⟨m, hm, n, hn, n2, hn2, rfl⟩
  have zero := tensorRelators.kills at R, M, N with rel
  unfold pairDifference at zero
  unfold tmul
  exact LinearMap.difference_zero at R, pairModule(M, R, N), tensorProduct(M, R, N), quotientModuleMap(pairModule(M, R, N), tensorRelations(M, R, N)) with ringR, lin, ga, gb, gc, zero

-- TensorProduct.smul_tmul' and smul_tmul: r (m ⊗ n) = (r m) ⊗ n =
-- m ⊗ (r n).
theorem tmul.smul_left (r : R) (m : M) (n : N)
  shows tmul(M, R, N, r • m, n) = call2(Module.smul(tensorProduct(M, R, N)),
    r, tmul(M, R, N, m, n))
proof
  have hr : r ∈ R.carrier by assumption
  have hm : m ∈ M.carrier by assumption
  have hn : n ∈ N.carrier by assumption
  have ringR := CommRing.to_ring with ring
  have hrm := Module.smul_mem at R, M, r, m with *
  have lin := tensorQuotient.linear at R, M, N with *
  have ga := pairGenerator.mem at R, M, N, r • m, n with *
  have gb := pairGenerator.mem at R, M, N, m, n with *
  have dIn := pairScaledDifference.mem at R, M, N, pairGenerator(M, R, N, r • m, n), r, pairGenerator(M, R, N, m, n) with *
  have c := pairModule.carrier_eq at R, M, N with *
  rw c at dIn
  have rel : pairScaledDifference(M, R, N, pairGenerator(M, R, N, r • m, n), r, pairGenerator(M, R, N, m, n)) ∈ tensorRelators(M, R, N)
    apply tensorRelators.membership.backward
    refine ⟨dIn, ?_⟩
    right
    right
    left
    exact ⟨r, hr, m, hm, n, hn, rfl⟩
  have zero := tensorRelators.kills at R, M, N with rel
  unfold pairScaledDifference at zero
  unfold tmul
  exact LinearMap.scaled_difference_zero at R, pairModule(M, R, N), tensorProduct(M, R, N), quotientModuleMap(pairModule(M, R, N), tensorRelations(M, R, N)) with ringR, lin, ga, hr, gb, zero

theorem tmul.smul_right (r : R) (m : M) (n : N)
  shows tmul(M, R, N, m, r • n) = tmul(M, R, N, r • m, n)
proof
  have hr : r ∈ R.carrier by assumption
  have hm : m ∈ M.carrier by assumption
  have hn : n ∈ N.carrier by assumption
  have ringR := CommRing.to_ring with ring
  have hrn := Module.smul_mem at R, N, r, n with *
  have lin := tensorQuotient.linear at R, M, N with *
  have ga := pairGenerator.mem at R, M, N, m, r • n with *
  have gb := pairGenerator.mem at R, M, N, m, n with *
  have dIn := pairScaledDifference.mem at R, M, N, pairGenerator(M, R, N, m, r • n), r, pairGenerator(M, R, N, m, n) with *
  have c := pairModule.carrier_eq at R, M, N with *
  rw c at dIn
  have rel : pairScaledDifference(M, R, N, pairGenerator(M, R, N, m, r • n), r, pairGenerator(M, R, N, m, n)) ∈ tensorRelators(M, R, N)
    apply tensorRelators.membership.backward
    refine ⟨dIn, ?_⟩
    right
    right
    right
    exact ⟨r, hr, m, hm, n, hn, rfl⟩
  have zero := tensorRelators.kills at R, M, N with rel
  unfold pairScaledDifference at zero
  have e1 : tmul(M, R, N, m, r • n) = call2(Module.smul(tensorProduct(M, R, N)), r, tmul(M, R, N, m, n))
    unfold tmul
    exact LinearMap.scaled_difference_zero at R, pairModule(M, R, N), tensorProduct(M, R, N), quotientModuleMap(pairModule(M, R, N), tensorRelations(M, R, N)) with ringR, lin, ga, hr, gb, zero
  have e2 := tmul.smul_left at R, M, N, r, m, n with *
  rw [e1, e2]

theorem tmul.zero_left (n : N)
  shows tmul(M, R, N, M.zero, n) = Module.zero(tensorProduct(M, R, N))
proof
  have ringR := CommRing.to_ring with ring
  have tp := tensorProduct.module at R, M, N with *
  have z := Module.zero_mem at R, M with *
  have zR := Ring.zero_mem at R with ringR
  have t0 := tmul.mem at R, M, N, M.zero, n with *
  have e1 := zero_smul at R, M, M.zero with *
  have e2 := tmul.smul_left at R, M, N, R.zero, M.zero, n with *
  have e3 := zero_smul at R, tensorProduct(M, R, N), tmul(M, R, N, M.zero, n) with *
  rw [e1, e3] at e2
  exact e2

theorem tmul.zero_right (m : M)
  shows tmul(M, R, N, m, N.zero) = Module.zero(tensorProduct(M, R, N))
proof
  have ringR := CommRing.to_ring with ring
  have tp := tensorProduct.module at R, M, N with *
  have z := Module.zero_mem at R, N with *
  have zR := Ring.zero_mem at R with ringR
  have zM := Module.zero_mem at R, M with *
  have e1 := zero_smul at R, N, N.zero with *
  have e2 := tmul.smul_right at R, M, N, R.zero, m, N.zero with *
  have e3 := zero_smul at R, M, m with *
  have e4 := tmul.zero_left at R, M, N, N.zero with *
  rw [e1, e3, e4] at e2
  exact e2

-- TensorProduct.tmul_sub and neg_tmul.
theorem tmul.neg_left (m : M) (n : N)
  shows tmul(M, R, N, -m, n) =
    apply(Module.neg(tensorProduct(M, R, N)), tmul(M, R, N, m, n))
proof
  have ringR := CommRing.to_ring with ring
  have tp := tensorProduct.module at R, M, N with *
  have nm := Module.neg_mem at R, M, m with *
  have e1 := tmul.add_left at R, M, N, -m, m, n with *
  have e2 := Module.neg_add at R, M, m with *
  have e3 := tmul.zero_left at R, M, N, n with *
  rw [e2, e3] at e1
  have t1 := tmul.mem at R, M, N, -m, n with *
  have t2 := tmul.mem at R, M, N, m, n with *
  symm at e1
  exact Module.eq_neg_of_add_eq_zero at R, tensorProduct(M, R, N), tmul(M, R, N, -m, n), tmul(M, R, N, m, n) with *

theorem tmul.neg_right (m : M) (n : N)
  shows tmul(M, R, N, m, -n) =
    apply(Module.neg(tensorProduct(M, R, N)), tmul(M, R, N, m, n))
proof
  have ringR := CommRing.to_ring with ring
  have tp := tensorProduct.module at R, M, N with *
  have nn := Module.neg_mem at R, N, n with *
  have e1 := tmul.add_right at R, M, N, m, -n, n with *
  have e2 := Module.neg_add at R, N, n with *
  have e3 := tmul.zero_right at R, M, N, m with *
  rw [e2, e3] at e1
  have t1 := tmul.mem at R, M, N, m, -n with *
  have t2 := tmul.mem at R, M, N, m, n with *
  symm at e1
  exact Module.eq_neg_of_add_eq_zero at R, tensorProduct(M, R, N), tmul(M, R, N, m, -n), tmul(M, R, N, m, n) with *

-- TensorProduct.mk is bilinear.
theorem tensorMk.bilinear
  shows BilinearMap(tensorMk(M, R, N), M, N, tensorProduct(M, R, N), R)
proof
  have tp := tensorProduct.module at R, M, N with *
  have values : ∀ m ∈ M.carrier, ∀ n ∈ N.carrier, tmul(M, R, N, m, n) ∈ Module.carrier(tensorProduct(M, R, N))
    intros a ha b hb
    exact tmul.mem at R, M, N, a, b with *
  have function := tensorMk.graph_function at M, R, N with values
  have ap : ∀ a ∈ M.carrier, ∀ b ∈ N.carrier, tensorMk(M, R, N)((a, b)) = tmul(M, R, N, a, b)
    intros a ha b hb
    exact tensorMk.graph_entry at M, R, N, a, b with values, ha, hb
  unfold BilinearMap
  refine ⟨moduleM, moduleN, tp, function, ?_, ?_, ?_⟩
  . intros v hv w hw x hx
    have vw := Module.add_mem at R, M, v, w with *
    have a0 := ap with v + w, vw, x, hx
    have a1 := ap with v, hv, x, hx
    have a2 := ap with w, hw, x, hx
    rw [a0, a1, a2]
    exact tmul.add_left at R, M, N, v, w, x with *
  . intros v hv x hx y hy
    have xy := Module.add_mem at R, N, x, y with *
    have a0 := ap with v, hv, x + y, xy
    have a1 := ap with v, hv, x, hx
    have a2 := ap with v, hv, y, hy
    rw [a0, a1, a2]
    exact tmul.add_right at R, M, N, v, x, y with *
  . intros r hr v hv x hx
    have rv := Module.smul_mem at R, M, r, v with *
    have rx := Module.smul_mem at R, N, r, x with *
    have a0 := ap with r • v, rv, x, hx
    have a1 := ap with v, hv, x, hx
    have a2 := ap with v, hv, r • x, rx
    have e1 := tmul.smul_right at R, M, N, r, v, x with *
    have e2 := tmul.smul_left at R, M, N, r, v, x with *
    rw [a0, a1, a2, e1, e2]
    exact ⟨rfl, rfl⟩

theorem tensorMk.apply (m : M) (n : N)
  shows tensorMk(M, R, N)((m, n)) = tmul(M, R, N, m, n)
proof
  have values : ∀ m ∈ M.carrier, ∀ n ∈ N.carrier, tmul(M, R, N, m, n) ∈ Module.carrier(tensorProduct(M, R, N))
    intros a ha b hb
    exact tmul.mem at R, M, N, a, b with *
  exact tensorMk.graph_entry at M, R, N, m, n with values, *

-- TensorProduct.span_tmul_eq_top and induction_on: the pure tensors span.
theorem tensorProduct.span_pure
  shows moduleSpan(tensorProduct(M, R, N), R,
      functionImage(tensorMk(M, R, N), M.carrier × N.carrier,
        Module.carrier(tensorProduct(M, R, N)))) =
    Module.carrier(tensorProduct(M, R, N))
proof
  sorry

-- Every element is a finite sum of pure tensors.
theorem tensorProduct.finite_sum (t : Set)
  requires member : t ∈ Module.carrier(tensorProduct(M, R, N))
  shows ∃ k, Nat(k) ∧ ∃ u, ∃ w, (u : k → M.carrier) ∧ (w : k → N.carrier) ∧
    t = moduleSum(tensorProduct(M, R, N), k,
      compose(tensorMk(M, R, N), pairFamily(k, M.carrier, N.carrier, u, w), k, M.carrier × N.carrier,
        Module.carrier(tensorProduct(M, R, N))))
proof
  sorry

-- TensorProduct.lift: the universal property.
theorem tensorLift.linear (P B : Set)
  requires bilinear : BilinearMap(B, M, N, P, R)
  shows LinearMap(tensorLift(M, R, N, P, B), tensorProduct(M, R, N), R, P)
proof
  sorry

theorem tensorLift.tmul (P B : Set) (m : M) (n : N)
  requires bilinear : BilinearMap(B, M, N, P, R)
  shows tensorLift(M, R, N, P, B)(tmul(M, R, N, m, n)) = B((m, n))
proof
  sorry

-- TensorProduct.ext': linear maps out of M ⊗ N agreeing on pure tensors
-- are equal.
theorem tensorProduct.ext (P f g : Set)
  requires first : LinearMap(f, tensorProduct(M, R, N), R, P)
  requires second : LinearMap(g, tensorProduct(M, R, N), R, P)
  requires agree : ∀ m ∈ M.carrier, ∀ n ∈ N.carrier,
    f(tmul(M, R, N, m, n)) = g(tmul(M, R, N, m, n))
  shows f = g
proof
  sorry

theorem tensorLift.unique (P B f : Set)
  requires bilinear : BilinearMap(B, M, N, P, R)
  requires linear : LinearMap(f, tensorProduct(M, R, N), R, P)
  requires agree : ∀ m ∈ M.carrier, ∀ n ∈ N.carrier,
    f(tmul(M, R, N, m, n)) = B((m, n))
  shows f = tensorLift(M, R, N, P, B)
proof
  sorry

-- TensorProduct.map and its laws.
theorem tensorMap.linear (M2 N2 f g : Set)
  requires first : LinearMap(f, M, R, M2)
  requires second : LinearMap(g, N, R, N2)
  shows LinearMap(tensorMap(f, g, M, N, M2, R, N2), tensorProduct(M, R, N), R,
    tensorProduct(M2, R, N2))
proof
  sorry

theorem tensorMap.tmul (M2 N2 f g : Set) (m : M) (n : N)
  requires first : LinearMap(f, M, R, M2)
  requires second : LinearMap(g, N, R, N2)
  shows tensorMap(f, g, M, N, M2, R, N2)(tmul(M, R, N, m, n)) =
    tmul(M2, R, N2, f(m), g(n))
proof
  sorry

theorem tensorMap.identity
  shows tensorMap(identity(M.carrier), identity(N.carrier), M, N, M, R, N) =
    identity(Module.carrier(tensorProduct(M, R, N)))
proof
  sorry

theorem tensorMap.compose (M2 N2 M3 N3 f g f2 g2 : Set)
  requires first : LinearMap(f, M, R, M2)
  requires second : LinearMap(g, N, R, N2)
  requires third : LinearMap(f2, M2, R, M3)
  requires fourth : LinearMap(g2, N2, R, N3)
  shows compose(tensorMap(f2, g2, M2, N2, M3, R, N3),
      tensorMap(f, g, M, N, M2, R, N2),
      Module.carrier(tensorProduct(M, R, N)),
      Module.carrier(tensorProduct(M2, R, N2)),
      Module.carrier(tensorProduct(M3, R, N3))) =
    tensorMap(compose(f2, f, M.carrier, Module.carrier(M2), Module.carrier(M3)),
      compose(g2, g, N.carrier, Module.carrier(N2), Module.carrier(N3)),
      M, N, M3, R, N3)
proof
  sorry

-- LinearMap.lTensor_surjective and rTensor_surjective.
theorem leftTensor.surjective (N2 g : Set)
  requires linear : LinearMap(g, N, R, N2)
  requires surjective : SurjectiveBetween(g, N.carrier, Module.carrier(N2))
  shows SurjectiveBetween(leftTensor(M, R, N, N2, g),
    Module.carrier(tensorProduct(M, R, N)), Module.carrier(tensorProduct(M, R, N2)))
proof
  sorry

theorem rightTensor.surjective (M2 f : Set)
  requires linear : LinearMap(f, M, R, M2)
  requires surjective : SurjectiveBetween(f, M.carrier, Module.carrier(M2))
  shows SurjectiveBetween(rightTensor(M, R, N, M2, f),
    Module.carrier(tensorProduct(M, R, N)), Module.carrier(tensorProduct(M2, R, N)))
proof
  sorry

-- lTensor_exact: tensoring with M is right exact. For N1 →f N →g N2 → 0
-- exact, M ⊗ N1 → M ⊗ N → M ⊗ N2 → 0 is exact.
theorem leftTensor.exact (N1 N2 f g : Set)
  requires first : LinearMap(f, N1, R, N)
  requires second : LinearMap(g, N, R, N2)
  requires exact : ExactPair(f, g, N1, N, N2)
  requires surjective : SurjectiveBetween(g, N.carrier, Module.carrier(N2))
  shows ExactPair(leftTensor(M, R, N1, N, f), leftTensor(M, R, N, N2, g),
    tensorProduct(M, R, N1), tensorProduct(M, R, N), tensorProduct(M, R, N2))
proof
  sorry

theorem rightTensor.exact (M1 M2 f g : Set)
  requires first : LinearMap(f, M1, R, M)
  requires second : LinearMap(g, M, R, M2)
  requires exact : ExactPair(f, g, M1, M, M2)
  requires surjective : SurjectiveBetween(g, M.carrier, Module.carrier(M2))
  shows ExactPair(rightTensor(M1, R, N, M, f), rightTensor(M, R, N, M2, g),
    tensorProduct(M1, R, N), tensorProduct(M, R, N), tensorProduct(M2, R, N))
proof
  sorry

-- TensorProduct.comm.
theorem tensorSwap.equiv
  shows LinearEquiv(tensorSwap(M, R, N), tensorProduct(M, R, N), R,
    tensorProduct(N, R, M))
proof
  sorry

theorem tensorSwap.tmul (m : M) (n : N)
  shows tensorSwap(M, R, N)(tmul(M, R, N, m, n)) = tmul(N, R, M, n, m)
proof
  sorry

-- TensorProduct.assoc: (M ⊗ N) ⊗ P ≅ M ⊗ (N ⊗ P).
theorem tensorProduct.assoc (P : Set)
  requires moduleP : Module(P, R)
  shows ∃ e, LinearEquiv(e, tensorProduct(tensorProduct(M, R, N), R, P), R,
      tensorProduct(M, R, tensorProduct(N, R, P))) ∧
    (∀ m ∈ M.carrier, ∀ n ∈ N.carrier, ∀ p ∈ P.carrier,
      e(tmul(tensorProduct(M, R, N), R, P, tmul(M, R, N, m, n), p)) =
        tmul(M, R, tensorProduct(N, R, P), m, tmul(N, R, P, n, p)))
proof
  sorry

-- Basis.tensorProduct: pure tensors of basis vectors form a basis, so the
-- rank is multiplicative (Module.finrank_tensorProduct).
theorem tensorProduct.basis (I J v w : Set)
  requires first : ModuleBasis(M, R, I, v)
  requires second : ModuleBasis(N, R, J, w)
  shows ModuleBasis(tensorProduct(M, R, N), R, I × J,
    compose(tensorMk(M, R, N), productFamily(I, J, M.carrier, N.carrier, v, w), I × J,
      M.carrier × N.carrier, Module.carrier(tensorProduct(M, R, N))))
proof
  sorry

theorem tensorProduct.finrank
  requires nontrivial : R.zero ≠ R.one
  requires freeM : FiniteFreeModule(M, R)
  requires freeN : FiniteFreeModule(N, R)
  shows FiniteFreeModule(tensorProduct(M, R, N), R) ∧
    finrank(tensorProduct(M, R, N), R) = finrank(M, R) * finrank(N, R)
proof
  sorry

end Tensors

section Unit
variable (R M : Set)
hypothesis ring : CommRing(R)
hypothesis module : Module(M, R)

-- TensorProduct.lid: R ⊗ M ≅ M.
theorem scalarTensorMap.equiv
  shows LinearEquiv(scalarTensorMap(M, R), tensorProduct(selfModule(R), R, M),
    R, M)
proof
  sorry

theorem scalarTensorMap.tmul (r : R) (m : M)
  shows scalarTensorMap(M, R)(tmul(selfModule(R), R, M, r, m)) = r • m
proof
  sorry

-- Rᴵ ⊗ M ≅ Mᴵ for finite I.
theorem tensorProduct.coordinate (I : Set)
  requires finite : Finite(I)
  shows ModuleIsomorphic(tensorProduct(coordinateModule(R, I), R, M), R,
    functionModule(R, I, M))
proof
  sorry

end Unit

-- Section: Laws of base change
section BaseChange
variable (A M : Set)
hypothesis algebra : Algebra(A)
hypothesis module : Module(M, Algebra.base(A))

theorem algebraModule.module
  shows Module(algebraModule(A), Algebra.base(A))
proof
  sorry

theorem restrictedModule.module (N : Set)
  requires moduleN : Module(N, Algebra.ring(A))
  shows Module(restrictedModule(A, N), Algebra.base(A))
proof
  sorry

theorem baseChange.module
  shows Module(baseChange(A, M), Algebra.ring(A))
proof
  sorry

-- a (b ⊗ m) = (a b) ⊗ m.
theorem baseChange.smul_tmul (a b m : Set)
  requires first : a ∈ algebraCarrier(A)
  requires second : b ∈ algebraCarrier(A)
  requires vector : m ∈ M.carrier
  shows call2(Module.smul(baseChange(A, M)), a,
      tmul(algebraModule(A), Algebra.base(A), M, b, m)) =
    tmul(algebraModule(A), Algebra.base(A), M,
      call2(Ring.mul(Algebra.ring(A)), a, b), m)
proof
  sorry

-- A basis v of M gives the basis 1 ⊗ v of A ⊗ M over A
-- (Basis.baseChange).
theorem baseChange.basis (I v : Set)
  requires basis : ModuleBasis(M, Algebra.base(A), I, v)
  shows ModuleBasis(baseChange(A, M), Algebra.ring(A), I,
    compose(baseChangeUnit(A, M), v, I, M.carrier,
      Module.carrier(baseChange(A, M))))
proof
  sorry

-- LinearMap.liftBaseChange.
theorem liftBaseChange.linear (N f : Set)
  requires moduleN : Module(N, Algebra.ring(A))
  requires linear : LinearMap(f, M, Algebra.base(A), restrictedModule(A, N))
  shows LinearMap(liftBaseChange(A, M, N, f), baseChange(A, M), Algebra.ring(A), N)
proof
  sorry

theorem liftBaseChange.tmul (N f a m : Set)
  requires moduleN : Module(N, Algebra.ring(A))
  requires linear : LinearMap(f, M, Algebra.base(A), restrictedModule(A, N))
  requires scalar : a ∈ algebraCarrier(A)
  requires vector : m ∈ M.carrier
  shows liftBaseChange(A, M, N, f)(tmul(algebraModule(A), Algebra.base(A), M,
    a, m)) = call2(Module.smul(N), a, f(m))
proof
  sorry

-- LinearMap.liftBaseChangeEquiv: A-linear maps A ⊗ M → N are the R-linear
-- maps M → N, by g ↦ (m ↦ g(1 ⊗ m)) with inverse liftBaseChange.
theorem liftBaseChange.unique (N f g : Set)
  requires moduleN : Module(N, Algebra.ring(A))
  requires linear : LinearMap(f, M, Algebra.base(A), restrictedModule(A, N))
  requires other : LinearMap(g, baseChange(A, M), Algebra.ring(A), N)
  requires agree : ∀ m ∈ M.carrier,
    g(tmul(algebraModule(A), Algebra.base(A), M, Ring.one(Algebra.ring(A)), m)) =
      f(m)
  shows g = liftBaseChange(A, M, N, f)
proof
  sorry

theorem liftBaseChange.restrict (N g : Set)
  requires moduleN : Module(N, Algebra.ring(A))
  requires linear : LinearMap(g, baseChange(A, M), Algebra.ring(A), N)
  shows LinearMap(compose(g, baseChangeUnit(A, M), M.carrier,
      Module.carrier(baseChange(A, M)), N.carrier),
    M, Algebra.base(A), restrictedModule(A, N))
proof
  sorry

end BaseChange

-- Section: Laws of tensor products of algebras
section AlgebraTensor
variable (A B : Set)
hypothesis algebraA : Algebra(A)
hypothesis algebraB : Algebra(B)
hypothesis sameBase : Algebra.base(A) = Algebra.base(B)

theorem algebraTensor.algebra
  shows Algebra(algebraTensor(A, B))
proof
  sorry

theorem algebraTensor.mul_tmul (a a2 b b2 : Set)
  requires firstA : a ∈ algebraCarrier(A)
  requires secondA : a2 ∈ algebraCarrier(A)
  requires firstB : b ∈ algebraCarrier(B)
  requires secondB : b2 ∈ algebraCarrier(B)
  shows call2(Ring.mul(algebraTensorRing(A, B)),
      tmul(algebraModule(A), Algebra.base(A), algebraModule(B), a, b),
      tmul(algebraModule(A), Algebra.base(A), algebraModule(B), a2, b2)) =
    tmul(algebraModule(A), Algebra.base(A), algebraModule(B),
      call2(Ring.mul(Algebra.ring(A)), a, a2),
      call2(Ring.mul(Algebra.ring(B)), b, b2))
proof
  sorry

theorem includeLeft.hom
  shows AlgebraHom(includeLeft(A, B), A, algebraTensor(A, B))
proof
  sorry

theorem includeRight.hom
  shows AlgebraHom(includeRight(A, B), B, algebraTensor(A, B))
proof
  sorry

-- Algebra.TensorProduct.productMap: algebra maps f : A → C and g : B → C
-- give the algebra map a ⊗ b ↦ f(a) g(b), the unique one restricting to
-- f and g.
theorem productMap.hom (C f g : Set)
  requires first : AlgebraHom(f, A, C)
  requires second : AlgebraHom(g, B, C)
  shows AlgebraHom(productMap(A, B, C, f, g), algebraTensor(A, B), C)
proof
  sorry

theorem productMap.tmul (C f g a b : Set)
  requires first : AlgebraHom(f, A, C)
  requires second : AlgebraHom(g, B, C)
  requires memberA : a ∈ algebraCarrier(A)
  requires memberB : b ∈ algebraCarrier(B)
  shows productMap(A, B, C, f, g)(tmul(algebraModule(A), Algebra.base(A),
    algebraModule(B), a, b)) = call2(Ring.mul(Algebra.ring(C)), f(a), g(b))
proof
  sorry

theorem productMap.unique (C f g h : Set)
  requires first : AlgebraHom(f, A, C)
  requires second : AlgebraHom(g, B, C)
  requires hom : AlgebraHom(h, algebraTensor(A, B), C)
  requires left : ∀ a ∈ algebraCarrier(A), h(includeLeft(A, B)(a)) = f(a)
  requires right : ∀ b ∈ algebraCarrier(B), h(includeRight(A, B)(b)) = g(b)
  shows h = productMap(A, B, C, f, g)
proof
  sorry

end AlgebraTensor
