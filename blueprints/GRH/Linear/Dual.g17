-- Duality: the dual module of linear forms, the dual basis of a finite
-- basis, the transpose of a linear map, the evaluation map into the double
-- dual, annihilators, bilinear maps, and nondegenerate pairings of
-- finite-dimensional spaces.
-- Part of the GRH blueprint.
-- Planned home: Algebra/Module/Dual.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Linear.Dual
import GRH.Linear.Dimension

-- Section: Definitions
-- The dual M* = Hom(M, R) of a module over a commutative ring (Mathlib's
-- Module.Dual), and its set of linear forms.
def linearForms (M R : Set) : Set := linearMaps(M, R, selfModule(R))

def dualModule (M R : Set) : Set := homModule(M, R, selfModule(R))

-- The dual basis i ↦ (the i-th coordinate) of a finite basis
-- (Basis.dualBasis).
def dualFamily (M R I v : Set) : Set :=
  { p ∈ I × linearForms(M, R) | ∃ i ∈ I,
    p = (i, basisCoordinate(M, R, I, v, i)) }

-- The transpose f* : N* → M*, φ ↦ φ ∘ f (Module.Dual.transpose,
-- LinearMap.dualMap).
def dualMap (f M R N : Set) : Set :=
  { p ∈ linearForms(N, R) × linearForms(M, R) | ∃ φ ∈ linearForms(N, R),
    p = (φ, compose(φ, f, Module.carrier(M), Module.carrier(N),
      Ring.carrier(R))) }

-- Evaluation at v, the linear form φ ↦ φ(v) on M*, and the map
-- M → M**, v ↦ (φ ↦ φ(v)) (Module.Dual.eval).
def evaluationForm (M R v : Set) : Set :=
  { p ∈ linearForms(M, R) × Ring.carrier(R) | ∃ φ ∈ linearForms(M, R),
    p = (φ, φ(v)) }

def doubleDualMap (M R : Set) : Set :=
  { p ∈ Module.carrier(M) × linearForms(dualModule(M, R), R) |
    ∃ v ∈ Module.carrier(M), p = (v, evaluationForm(M, R, v)) }

-- The annihilator W⁰ ⊆ M* of W ⊆ M and the common kernel of a set of
-- forms (Submodule.dualAnnihilator, dualCoannihilator).
def dualAnnihilator (M R W : Set) : Set :=
  { φ ∈ linearForms(M, R) | ∀ w ∈ W, φ(w) = Ring.zero(R) }

def dualCoannihilator (M R Φ : Set) : Set :=
  { v ∈ Module.carrier(M) | ∀ φ ∈ Φ, φ(v) = Ring.zero(R) }

-- Section: Bilinear maps and pairings
-- B : M × N → P linear in each argument (Mathlib's LinearMap.mk₂ and
-- M →ₗ[R] N →ₗ[R] P, uncurried).
predicate BilinearMap (B M N P R : Set) :=
  Module(M, R) ∧ Module(N, R) ∧ Module(P, R) ∧
  (B : M.carrier × N.carrier → P.carrier) ∧
  (∀ v w ∈ M.carrier, ∀ x ∈ N.carrier,
    B((call2(M.add, v, w), x)) = call2(P.add, B((v, x)), B((w, x)))) ∧
  (∀ v ∈ M.carrier, ∀ x y ∈ N.carrier,
    B((v, call2(N.add, x, y))) = call2(P.add, B((v, x)), B((v, y)))) ∧
  (∀ r ∈ Ring.carrier(R), ∀ v ∈ M.carrier, ∀ x ∈ N.carrier,
    B((call2(M.smul, r, v), x)) = call2(P.smul, r, B((v, x))) ∧
    B((v, call2(N.smul, r, x))) = call2(P.smul, r, B((v, x))))

-- The map M → N*, v ↦ B(v, ·), of a pairing B : M × N → R.
def pairingSlice (B N R v : Set) : Set :=
  { q ∈ Module.carrier(N) × Ring.carrier(R) |
    ∃ x ∈ Module.carrier(N), q = (x, B((v, x))) }

def pairingLeft (B M R N : Set) : Set :=
  { p ∈ Module.carrier(M) × linearForms(N, R) | ∃ v ∈ Module.carrier(M),
    p = (v, pairingSlice(B, N, R, v)) }

-- A pairing is nondegenerate when only 0 pairs to zero with everything,
-- on either side.
predicate NondegeneratePairing (B M R N : Set) :=
  BilinearMap(B, M, N, selfModule(R), R) ∧
  (∀ v ∈ M.carrier, (∀ x ∈ N.carrier, B((v, x)) = Ring.zero(R)) →
    v = M.zero) ∧
  (∀ x ∈ N.carrier, (∀ v ∈ M.carrier, B((v, x)) = Ring.zero(R)) →
    x = N.zero)

-- Section: Graph laws of the constructions
theorem dualFamily.graph_relates (M R I v i : Set)
  requires index : i ∈ I
  requires valueIn : basisCoordinate(M, R, I, v, i) ∈ linearForms(M, R)
  shows relates(dualFamily(M, R, I, v), i, basisCoordinate(M, R, I, v, i))
proof
  unfold relates
  apply dualFamily.membership.backward
  refine ⟨(product.pair at i, basisCoordinate(M, R, I, v, i), I, linearForms(M, R) with index, valueIn), i, index, rfl⟩

theorem dualFamily.graph_function (M R I v : Set)
  requires values : ∀ i ∈ I, basisCoordinate(M, R, I, v, i) ∈ linearForms(M, R)
  shows dualFamily(M, R, I, v) : I → linearForms(M, R)
proof
  constructor
    intros q0 member
    obtain ⟨bounded, witnesses⟩ := dualFamily.membership.forward with member
    exact bounded
  . constructor
      intros z0 first xFirst second xSecond
      unfold relates at xFirst
      obtain ⟨_, a1, a1In, firstShape⟩ := dualFamily.membership.forward with xFirst
      unfold relates at xSecond
      obtain ⟨_, a2, a2In, secondShape⟩ := dualFamily.membership.forward with xSecond
      obtain ⟨xi, firstEqual⟩ := orderedPair.injective with firstShape
      obtain ⟨xj, secondEqual⟩ := orderedPair.injective with secondShape
      rw [firstEqual, secondEqual]
      cc
    . intros i xIn
      have valueIn := values with i, xIn
      refine ⟨basisCoordinate(M, R, I, v, i), valueIn, (dualFamily.graph_relates at M, R, I, v, i with xIn, valueIn)⟩

theorem dualFamily.graph_apply (M R I v i : Set)
  requires values : ∀ i ∈ I, basisCoordinate(M, R, I, v, i) ∈ linearForms(M, R)
  requires index : i ∈ I
  shows dualFamily(M, R, I, v)(i) = basisCoordinate(M, R, I, v, i)
proof
  have function := dualFamily.graph_function at M, R, I, v with values
  have valueIn := values with i, index
  have mapped := dualFamily.graph_relates at M, R, I, v, i with index, valueIn
  exact FunctionBetween.apply_value with function, index, mapped

theorem dualMap.graph_relates (f M R N φ : Set)
  requires index : φ ∈ linearForms(N, R)
  requires valueIn : compose(φ, f, Module.carrier(M), Module.carrier(N), Ring.carrier(R)) ∈ linearForms(M, R)
  shows relates(dualMap(f, M, R, N), φ, compose(φ, f, Module.carrier(M), Module.carrier(N), Ring.carrier(R)))
proof
  unfold relates
  apply dualMap.membership.backward
  refine ⟨(product.pair at φ, compose(φ, f, Module.carrier(M), Module.carrier(N), Ring.carrier(R)), linearForms(N, R), linearForms(M, R) with index, valueIn), φ, index, rfl⟩

theorem dualMap.graph_function (f M R N : Set)
  requires values : ∀ φ ∈ linearForms(N, R), compose(φ, f, Module.carrier(M), Module.carrier(N), Ring.carrier(R)) ∈ linearForms(M, R)
  shows dualMap(f, M, R, N) : linearForms(N, R) → linearForms(M, R)
proof
  constructor
    intros q0 member
    obtain ⟨bounded, witnesses⟩ := dualMap.membership.forward with member
    exact bounded
  . constructor
      intros z0 first xFirst second xSecond
      unfold relates at xFirst
      obtain ⟨_, a1, a1In, firstShape⟩ := dualMap.membership.forward with xFirst
      unfold relates at xSecond
      obtain ⟨_, a2, a2In, secondShape⟩ := dualMap.membership.forward with xSecond
      obtain ⟨xi, firstEqual⟩ := orderedPair.injective with firstShape
      obtain ⟨xj, secondEqual⟩ := orderedPair.injective with secondShape
      rw [firstEqual, secondEqual]
      cc
    . intros φ xIn
      have valueIn := values with φ, xIn
      refine ⟨compose(φ, f, Module.carrier(M), Module.carrier(N), Ring.carrier(R)), valueIn, (dualMap.graph_relates at f, M, R, N, φ with xIn, valueIn)⟩

theorem dualMap.graph_apply (f M R N φ : Set)
  requires values : ∀ φ ∈ linearForms(N, R), compose(φ, f, Module.carrier(M), Module.carrier(N), Ring.carrier(R)) ∈ linearForms(M, R)
  requires index : φ ∈ linearForms(N, R)
  shows dualMap(f, M, R, N)(φ) = compose(φ, f, Module.carrier(M), Module.carrier(N), Ring.carrier(R))
proof
  have function := dualMap.graph_function at f, M, R, N with values
  have valueIn := values with φ, index
  have mapped := dualMap.graph_relates at f, M, R, N, φ with index, valueIn
  exact FunctionBetween.apply_value with function, index, mapped

theorem evaluationForm.graph_relates (M R v φ : Set)
  requires index : φ ∈ linearForms(M, R)
  requires valueIn : φ(v) ∈ Ring.carrier(R)
  shows relates(evaluationForm(M, R, v), φ, φ(v))
proof
  unfold relates
  apply evaluationForm.membership.backward
  refine ⟨(product.pair at φ, φ(v), linearForms(M, R), Ring.carrier(R) with index, valueIn), φ, index, rfl⟩

theorem evaluationForm.graph_function (M R v : Set)
  requires values : ∀ φ ∈ linearForms(M, R), φ(v) ∈ Ring.carrier(R)
  shows evaluationForm(M, R, v) : linearForms(M, R) → Ring.carrier(R)
proof
  constructor
    intros q0 member
    obtain ⟨bounded, witnesses⟩ := evaluationForm.membership.forward with member
    exact bounded
  . constructor
      intros z0 first xFirst second xSecond
      unfold relates at xFirst
      obtain ⟨_, a1, a1In, firstShape⟩ := evaluationForm.membership.forward with xFirst
      unfold relates at xSecond
      obtain ⟨_, a2, a2In, secondShape⟩ := evaluationForm.membership.forward with xSecond
      obtain ⟨xi, firstEqual⟩ := orderedPair.injective with firstShape
      obtain ⟨xj, secondEqual⟩ := orderedPair.injective with secondShape
      rw [firstEqual, secondEqual]
      cc
    . intros φ xIn
      have valueIn := values with φ, xIn
      refine ⟨φ(v), valueIn, (evaluationForm.graph_relates at M, R, v, φ with xIn, valueIn)⟩

theorem evaluationForm.graph_apply (M R v φ : Set)
  requires values : ∀ φ ∈ linearForms(M, R), φ(v) ∈ Ring.carrier(R)
  requires index : φ ∈ linearForms(M, R)
  shows evaluationForm(M, R, v)(φ) = φ(v)
proof
  have function := evaluationForm.graph_function at M, R, v with values
  have valueIn := values with φ, index
  have mapped := evaluationForm.graph_relates at M, R, v, φ with index, valueIn
  exact FunctionBetween.apply_value with function, index, mapped

theorem doubleDualMap.graph_relates (M R v : Set)
  requires index : v ∈ Module.carrier(M)
  requires valueIn : evaluationForm(M, R, v) ∈ linearForms(dualModule(M, R), R)
  shows relates(doubleDualMap(M, R), v, evaluationForm(M, R, v))
proof
  unfold relates
  apply doubleDualMap.membership.backward
  refine ⟨(product.pair at v, evaluationForm(M, R, v), Module.carrier(M), linearForms(dualModule(M, R), R) with index, valueIn), v, index, rfl⟩

theorem doubleDualMap.graph_function (M R : Set)
  requires values : ∀ v ∈ Module.carrier(M), evaluationForm(M, R, v) ∈ linearForms(dualModule(M, R), R)
  shows doubleDualMap(M, R) : Module.carrier(M) → linearForms(dualModule(M, R), R)
proof
  constructor
    intros q0 member
    obtain ⟨bounded, witnesses⟩ := doubleDualMap.membership.forward with member
    exact bounded
  . constructor
      intros z0 first xFirst second xSecond
      unfold relates at xFirst
      obtain ⟨_, a1, a1In, firstShape⟩ := doubleDualMap.membership.forward with xFirst
      unfold relates at xSecond
      obtain ⟨_, a2, a2In, secondShape⟩ := doubleDualMap.membership.forward with xSecond
      obtain ⟨xi, firstEqual⟩ := orderedPair.injective with firstShape
      obtain ⟨xj, secondEqual⟩ := orderedPair.injective with secondShape
      rw [firstEqual, secondEqual]
      cc
    . intros v xIn
      have valueIn := values with v, xIn
      refine ⟨evaluationForm(M, R, v), valueIn, (doubleDualMap.graph_relates at M, R, v with xIn, valueIn)⟩

theorem doubleDualMap.graph_apply (M R v : Set)
  requires values : ∀ v ∈ Module.carrier(M), evaluationForm(M, R, v) ∈ linearForms(dualModule(M, R), R)
  requires index : v ∈ Module.carrier(M)
  shows doubleDualMap(M, R)(v) = evaluationForm(M, R, v)
proof
  have function := doubleDualMap.graph_function at M, R with values
  have valueIn := values with v, index
  have mapped := doubleDualMap.graph_relates at M, R, v with index, valueIn
  exact FunctionBetween.apply_value with function, index, mapped

theorem pairingSlice.graph_relates (B N R v x : Set)
  requires index : x ∈ Module.carrier(N)
  requires valueIn : B((v, x)) ∈ Ring.carrier(R)
  shows relates(pairingSlice(B, N, R, v), x, B((v, x)))
proof
  unfold relates
  apply pairingSlice.membership.backward
  refine ⟨(product.pair at x, B((v, x)), Module.carrier(N), Ring.carrier(R) with index, valueIn), x, index, rfl⟩

theorem pairingSlice.graph_function (B N R v : Set)
  requires values : ∀ x ∈ Module.carrier(N), B((v, x)) ∈ Ring.carrier(R)
  shows pairingSlice(B, N, R, v) : Module.carrier(N) → Ring.carrier(R)
proof
  constructor
    intros q0 member
    obtain ⟨bounded, witnesses⟩ := pairingSlice.membership.forward with member
    exact bounded
  . constructor
      intros z0 first xFirst second xSecond
      unfold relates at xFirst
      obtain ⟨_, a1, a1In, firstShape⟩ := pairingSlice.membership.forward with xFirst
      unfold relates at xSecond
      obtain ⟨_, a2, a2In, secondShape⟩ := pairingSlice.membership.forward with xSecond
      obtain ⟨xi, firstEqual⟩ := orderedPair.injective with firstShape
      obtain ⟨xj, secondEqual⟩ := orderedPair.injective with secondShape
      rw [firstEqual, secondEqual]
      cc
    . intros x xIn
      have valueIn := values with x, xIn
      refine ⟨B((v, x)), valueIn, (pairingSlice.graph_relates at B, N, R, v, x with xIn, valueIn)⟩

theorem pairingSlice.graph_apply (B N R v x : Set)
  requires values : ∀ x ∈ Module.carrier(N), B((v, x)) ∈ Ring.carrier(R)
  requires index : x ∈ Module.carrier(N)
  shows pairingSlice(B, N, R, v)(x) = B((v, x))
proof
  have function := pairingSlice.graph_function at B, N, R, v with values
  have valueIn := values with x, index
  have mapped := pairingSlice.graph_relates at B, N, R, v, x with index, valueIn
  exact FunctionBetween.apply_value with function, index, mapped

theorem pairingLeft.graph_relates (B M R N v : Set)
  requires index : v ∈ Module.carrier(M)
  requires valueIn : pairingSlice(B, N, R, v) ∈ linearForms(N, R)
  shows relates(pairingLeft(B, M, R, N), v, pairingSlice(B, N, R, v))
proof
  unfold relates
  apply pairingLeft.membership.backward
  refine ⟨(product.pair at v, pairingSlice(B, N, R, v), Module.carrier(M), linearForms(N, R) with index, valueIn), v, index, rfl⟩

theorem pairingLeft.graph_function (B M R N : Set)
  requires values : ∀ v ∈ Module.carrier(M), pairingSlice(B, N, R, v) ∈ linearForms(N, R)
  shows pairingLeft(B, M, R, N) : Module.carrier(M) → linearForms(N, R)
proof
  constructor
    intros q0 member
    obtain ⟨bounded, witnesses⟩ := pairingLeft.membership.forward with member
    exact bounded
  . constructor
      intros z0 first xFirst second xSecond
      unfold relates at xFirst
      obtain ⟨_, a1, a1In, firstShape⟩ := pairingLeft.membership.forward with xFirst
      unfold relates at xSecond
      obtain ⟨_, a2, a2In, secondShape⟩ := pairingLeft.membership.forward with xSecond
      obtain ⟨xi, firstEqual⟩ := orderedPair.injective with firstShape
      obtain ⟨xj, secondEqual⟩ := orderedPair.injective with secondShape
      rw [firstEqual, secondEqual]
      cc
    . intros v xIn
      have valueIn := values with v, xIn
      refine ⟨pairingSlice(B, N, R, v), valueIn, (pairingLeft.graph_relates at B, M, R, N, v with xIn, valueIn)⟩

theorem pairingLeft.graph_apply (B M R N v : Set)
  requires values : ∀ v ∈ Module.carrier(M), pairingSlice(B, N, R, v) ∈ linearForms(N, R)
  requires index : v ∈ Module.carrier(M)
  shows pairingLeft(B, M, R, N)(v) = pairingSlice(B, N, R, v)
proof
  have function := pairingLeft.graph_function at B, M, R, N with values
  have valueIn := values with v, index
  have mapped := pairingLeft.graph_relates at B, M, R, N, v with index, valueIn
  exact FunctionBetween.apply_value with function, index, mapped


theorem dualModule.unfold_eq (M R : Set)
  shows dualModule(M, R) = homModule(M, R, selfModule(R))
proof
  unfold dualModule
  rfl

theorem linearForms.unfold_eq (M R : Set)
  shows linearForms(M, R) = linearMaps(M, R, selfModule(R))
proof
  unfold linearForms
  rfl

theorem linearForms.linear_of (M R φ : Set)
  requires form : φ ∈ linearForms(M, R)
  shows LinearMap(φ, M, R, selfModule(R))
proof
  rw linearForms.unfold_eq at form
  exact linearMaps.linear with form

theorem linearForms.of_linear_map (M R φ : Set)
  requires linear : LinearMap(φ, M, R, selfModule(R))
  shows φ ∈ linearForms(M, R)
proof
  rw linearForms.unfold_eq
  exact linearMaps.of_linear with linear

theorem linearForms.function_of (M R φ : Set)
  requires form : φ ∈ linearForms(M, R)
  shows φ : Module.carrier(M) → Ring.carrier(R)
proof
  have linear := linearForms.linear_of with form
  have function := LinearMap.function_of with linear
  rw selfModule.carrier_eq at function
  exact function

theorem linearForms.value_mem (M R φ v : Set)
  requires form : φ ∈ linearForms(M, R)
  requires vector : v ∈ Module.carrier(M)
  shows φ(v) ∈ Ring.carrier(R)
proof
  have function := linearForms.function_of with form
  exact FunctionBetween.apply_closed with function, vector

theorem dualMap.values (M R N f : Set)
  requires linear : LinearMap(f, M, R, N)
  shows ∀ φ ∈ linearForms(N, R), compose(φ, f, Module.carrier(M),
    Module.carrier(N), Ring.carrier(R)) ∈ linearForms(M, R)
proof
  intros φ form
  have lφ := linearForms.linear_of with form
  have c := LinearMap.compose at f, φ, M, R, N, selfModule(R) with linear, lφ
  rw selfModule.carrier_eq at c
  exact linearForms.of_linear_map with c

theorem dualMap.value_apply (f M R N φ v : Set)
  requires linear : LinearMap(f, M, R, N)
  requires form : φ ∈ linearForms(N, R)
  requires vector : v ∈ Module.carrier(M)
  shows dualMap(f, M, R, N)(φ)(v) = φ(f(v))
proof
  have values := dualMap.values at M, R, N, f with linear
  have e1 := dualMap.graph_apply at f, M, R, N, φ with values, form
  rw e1
  have fF := LinearMap.function_of with linear
  have φF := linearForms.function_of with form
  exact compose.apply at φ, f, Module.carrier(M), Module.carrier(N), Ring.carrier(R), v with fF, φF, vector

theorem evaluationForm.apply_of (M R v φ : Set)
  requires vector : v ∈ Module.carrier(M)
  requires form : φ ∈ linearForms(M, R)
  shows evaluationForm(M, R, v)(φ) = φ(v)
proof
  have values : ∀ ψ ∈ linearForms(M, R), ψ(v) ∈ Ring.carrier(R)
    intros ψ hψ
    exact linearForms.value_mem with hψ, vector
  exact evaluationForm.graph_apply at M, R, v, φ with values, form

theorem linearForms.map_add (M R φ v w : Set)
  requires form : φ ∈ linearForms(M, R)
  requires first : v ∈ Module.carrier(M)
  requires second : w ∈ Module.carrier(M)
  shows φ(call2(Module.add(M), v, w)) = call2(Ring.add(R), φ(v), φ(w))
proof
  have linear := linearForms.linear_of with form
  obtain ⟨_, _, _, additive, _⟩ := linear
  have e := additive with v, first, w, second
  rw selfModule.add_eq at e
  exact e

theorem linearForms.map_smul (M R φ r v : Set)
  requires form : φ ∈ linearForms(M, R)
  requires scalar : r ∈ Ring.carrier(R)
  requires vector : v ∈ Module.carrier(M)
  shows φ(call2(Module.smul(M), r, v)) = call2(Ring.mul(R), r, φ(v))
proof
  have linear := linearForms.linear_of with form
  obtain ⟨_, _, _, _, homogeneous⟩ := linear
  have e := homogeneous with r, scalar, v, vector
  rw selfModule.smul_eq at e
  exact e

theorem unitVector.symm (R I i j : Set)
  requires ring : CommRing(R)
  requires first : i ∈ I
  requires second : j ∈ I
  shows unitVector(R, I, j)(i) = unitVector(R, I, i)(j)
proof
  by_cases same : i = j
  . rw same
  . have ne2 : j ≠ i
      intro h
      apply same
      symm
      exact h
    have e1 := unitVector.apply_other at R, I, j, i with ring, first, same
    have e2 := unitVector.apply_other at R, I, i, j with ring, second, ne2
    rw [e1, e2]

theorem selfCombination.comm (R I a b : Set)
  requires ring : CommRing(R)
  requires first : a : I → Ring.carrier(R)
  requires second : b : I → Ring.carrier(R)
  shows moduleCombination(selfModule(R), R, I, a, b) =
    moduleCombination(selfModule(R), R, I, b, a)
proof
  have ringR := CommRing.to_ring with ring
  have selfM := Ring.to_module with ringR
  have selfCarrier := selfModule.carrier_eq at R
  have aS : a : I → Module.carrier(selfModule(R))
    rw selfCarrier
    exact first
  have bS : b : I → Module.carrier(selfModule(R))
    rw selfCarrier
    exact second
  have tF1 := combinationTerms.function at selfModule(R), R, I, a, b with selfM, first, bS
  have tF2 := combinationTerms.function at selfModule(R), R, I, b, a with selfM, second, aS
  have same : combinationTerms(selfModule(R), R, I, a, b) = combinationTerms(selfModule(R), R, I, b, a)
    apply FunctionBetween.ext with tF1, tF2
    intros i hi
    have e1 := combinationTerms.value at selfModule(R), R, I, a, b, i with selfM, first, bS, hi
    have e2 := combinationTerms.value at selfModule(R), R, I, b, a, i with selfM, second, aS, hi
    have ai := FunctionBetween.apply_closed with first, hi
    have bi := FunctionBetween.apply_closed with second, hi
    rw [e1, e2, selfModule.smul_eq]
    ring
  unfold moduleCombination
  rw same

theorem quotientModuleMap.submodule_zero (R V W u : Set)
  requires ring : Ring(R)
  requires module : Module(V, R)
  requires sub : SubmoduleOf(W, V, R)
  requires member : u ∈ W
  shows quotientModuleMap(V, W)(u) = Module.zero(quotientModule(V, R, W))
proof
  have qM := SubmoduleOf.quotient_module at R, V, W with ring, module, sub
  have qL := SubmoduleOf.quotient_map_linear at R, V, W with ring, module, sub
  have zeroIn := Module.zero_mem at R, V with ring, module
  have qz := LinearMap.map_zero at R, V, quotientModule(V, R, W), quotientModuleMap(V, W) with ring, module, qM, qL
  have negZero := Module.neg_zero at R, V with ring, module
  have sub0 := sub
  obtain ⟨_, WV, _⟩ := sub0
  have uV := WV with u, member
  have iff := SubmoduleOf.quotient_eq at R, V, W, u, Module.zero(V) with ring, module, sub, uV, zeroIn
  have az := Module.add_zero at R, V, u with ring, module, uV
  have inW : call2(Module.add(V), u, apply(Module.neg(V), Module.zero(V))) ∈ W
    rw [negZero, az]
    exact member
  have same := iff.backward with inW
  rw [same, qz]

theorem LinearMap.injective_of_zero (R M N f : Set)
  requires ring : Ring(R)
  requires linear : LinearMap(f, M, R, N)
  requires trivial : ∀ v ∈ Module.carrier(M), f(v) = Module.zero(N) →
    v = Module.zero(M)
  shows InjectiveBetween(f, Module.carrier(M), Module.carrier(N))
proof
  have moduleM := LinearMap.source_module_of with linear
  have moduleN := LinearMap.target_module_of with linear
  have iff := LinearMap.injective_iff_kernel at R, M, N, f with ring, moduleM, moduleN, linear
  apply iff.backward
  ext v
  constructor
  . intro hv
    obtain ⟨vIn, fv⟩ := linearKernel.membership.forward with hv
    have z := trivial with v, vIn, fv
    rw z
    exact singleton.self at Module.zero(M)
  . intro hv
    have z := singleton.membership.forward with hv
    rw z
    apply linearKernel.membership.backward
    have zeroIn := Module.zero_mem at R, M with ring, moduleM
    have mz := LinearMap.map_zero at R, M, N, f with ring, moduleM, moduleN, linear
    exact ⟨zeroIn, mz⟩

-- Section: Laws
section Duality
variable (R M : Set)
hypothesis ring : CommRing(R)
hypothesis module : Module(M, R)

theorem dualModule.module
  shows Module(dualModule(M, R), R)
proof
  have ringR := CommRing.to_ring with ring
  have selfM := Ring.to_module with ringR
  rw dualModule.unfold_eq
  exact homModule.module at R, M, selfModule(R) with ring, module, selfM

theorem dualModule.carrierOf
  shows Module.carrier(dualModule(M, R)) = linearForms(M, R)
proof
  rw [dualModule.unfold_eq, linearForms.unfold_eq]
  exact homModule.carrier_eq at M, R, selfModule(R)

theorem dualModule.add_apply (φ ψ v : Set)
  requires first : φ ∈ linearForms(M, R)
  requires second : ψ ∈ linearForms(M, R)
  requires vector : v ∈ Module.carrier(M)
  shows call2(Module.add(dualModule(M, R)), φ, ψ)(v) =
    call2(Ring.add(R), φ(v), ψ(v))
proof
  have ringR := CommRing.to_ring with ring
  have selfM := Ring.to_module with ringR
  have lφ := linearForms.linear_of with first
  have lψ := linearForms.linear_of with second
  have e := homModule.add_apply at R, M, selfModule(R), φ, ψ, v with ring, module, selfM, lφ, lψ, vector
  rw [dualModule.unfold_eq, e, selfModule.add_eq]

theorem dualModule.smul_apply (r φ v : Set)
  requires scalar : r ∈ Ring.carrier(R)
  requires form : φ ∈ linearForms(M, R)
  requires vector : v ∈ Module.carrier(M)
  shows call2(Module.smul(dualModule(M, R)), r, φ)(v) =
    call2(Ring.mul(R), r, φ(v))
proof
  have ringR := CommRing.to_ring with ring
  have selfM := Ring.to_module with ringR
  have lφ := linearForms.linear_of with form
  have e := homModule.smul_apply at R, M, selfModule(R), r, φ, v with ring, module, selfM, scalar, lφ, vector
  rw [dualModule.unfold_eq, e, selfModule.smul_eq]

theorem dualModule.zero_apply (v : Set)
  requires vector : v ∈ Module.carrier(M)
  shows Module.zero(dualModule(M, R))(v) = Ring.zero(R)
proof
  have ringR := CommRing.to_ring with ring
  have z : Module.zero(dualModule(M, R)) = constantFunction(Module.carrier(M), Module.carrier(selfModule(R)), Module.zero(selfModule(R)))
    rw dualModule.unfold_eq
    unfold homModule
    module_projections
  rw [z, selfModule.carrier_eq, selfModule.zero_eq]
  have zeroIn := Ring.zero_mem at R with ringR
  exact constantFunction.apply at Module.carrier(M), Ring.carrier(R), v, Ring.zero(R) with vector, zeroIn

theorem dualModule.add_mem (φ ψ : Set)
  requires first : φ ∈ linearForms(M, R)
  requires second : ψ ∈ linearForms(M, R)
  shows call2(Module.add(dualModule(M, R)), φ, ψ) ∈ linearForms(M, R)
proof
  have ringR := CommRing.to_ring with ring
  have dualM := dualModule.module at R, M with ring, module
  have carrier := dualModule.carrierOf at R, M with ring, module
  rw ← carrier at first
  rw ← carrier at second
  have sumIn := Module.add_mem at R, dualModule(M, R), φ, ψ with *
  rw carrier at sumIn
  exact sumIn

theorem dualModule.smul_mem (r φ : Set)
  requires scalar : r ∈ Ring.carrier(R)
  requires form : φ ∈ linearForms(M, R)
  shows call2(Module.smul(dualModule(M, R)), r, φ) ∈ linearForms(M, R)
proof
  have ringR := CommRing.to_ring with ring
  have dualM := dualModule.module at R, M with ring, module
  have carrier := dualModule.carrierOf at R, M with ring, module
  rw ← carrier at form
  have prodIn := Module.smul_mem at R, dualModule(M, R), r, φ with *
  rw carrier at prodIn
  exact prodIn

theorem dualModule.zero_mem
  shows Module.zero(dualModule(M, R)) ∈ linearForms(M, R)
proof
  have ringR := CommRing.to_ring with ring
  have dualM := dualModule.module at R, M with ring, module
  have carrier := dualModule.carrierOf at R, M with ring, module
  have zeroIn := Module.zero_mem at R, dualModule(M, R) with *
  rw carrier at zeroIn
  exact zeroIn

theorem basisCoordinates.function_of (I v x : Set)
  requires finite : Finite(I)
  requires basis : ModuleBasis(M, R, I, v)
  requires vector : x ∈ Module.carrier(M)
  shows basisCoordinates(M, R, I, v, x) : I → Ring.carrier(R)
proof
  have selected := basisCoordinates.selected at M, R, I, v, x with basis, finite, vector
  exact functionSpace.mem_iff.forward with selected.left

theorem dualFamily.values (I v : Set)
  requires finite : Finite(I)
  requires basis : ModuleBasis(M, R, I, v)
  shows ∀ i ∈ I, basisCoordinate(M, R, I, v, i) ∈ linearForms(M, R)
proof
  intros i hi
  have lin := basisCoordinate.linear at R, M, I, v, i with ring, module, basis, finite, hi
  exact linearForms.of_linear_map with lin

theorem dualFamily.apply_vector (I v i x : Set)
  requires finite : Finite(I)
  requires basis : ModuleBasis(M, R, I, v)
  requires index : i ∈ I
  requires vector : x ∈ Module.carrier(M)
  shows dualFamily(M, R, I, v)(i)(x) = basisCoordinates(M, R, I, v, x)(i)
proof
  have dvals := dualFamily.values at R, M, I, v with ring, module, finite, basis
  have a2 := dualFamily.graph_apply at M, R, I, v, i with dvals, index
  have values : ∀ y ∈ Module.carrier(M), basisCoordinates(M, R, I, v, y)(i) ∈ Ring.carrier(R)
    intros y hy
    have cF := basisCoordinates.function_of at R, M, I, v, y with ring, module, finite, basis, hy
    exact FunctionBetween.apply_closed with cF, index
  have a4 := basisCoordinate.graph_apply at M, R, I, v, i, x with values, vector
  rw [a2, a4]

theorem dualFamily.function_of (I v : Set)
  requires finite : Finite(I)
  requires basis : ModuleBasis(M, R, I, v)
  shows dualFamily(M, R, I, v) : I → Module.carrier(dualModule(M, R))
proof
  have dvals := dualFamily.values at R, M, I, v with ring, module, finite, basis
  have dF := dualFamily.graph_function at M, R, I, v with dvals
  have carrier := dualModule.carrierOf at R, M with ring, module
  rw carrier
  exact dF

theorem dualFamily.vector_ext (I v x y : Set)
  requires finite : Finite(I)
  requires basis : ModuleBasis(M, R, I, v)
  requires first : x ∈ Module.carrier(M)
  requires second : y ∈ Module.carrier(M)
  requires agree : ∀ i ∈ I, dualFamily(M, R, I, v)(i)(x) = dualFamily(M, R, I, v)(i)(y)
  shows x = y
proof
  have sx := basisCoordinates.selected at M, R, I, v, x with basis, finite, first
  have sy := basisCoordinates.selected at M, R, I, v, y with basis, finite, second
  have same : basisCoordinates(M, R, I, v, x) = basisCoordinates(M, R, I, v, y)
    apply functionSpace.ext_of with sx.left, sy.left
    intros i hi
    have a1 := dualFamily.apply_vector at R, M, I, v, i, x with ring, module, finite, basis, hi, first
    have a2 := dualFamily.apply_vector at R, M, I, v, i, y with ring, module, finite, basis, hi, second
    have a3 := agree with i, hi
    rw [← a1, ← a2, a3]
  have xe := basisCoordinates.combination at R, M, I, v, x with ring, module, basis, finite, first
  have ye := basisCoordinates.combination at R, M, I, v, y with ring, module, basis, finite, second
  cc

-- Basis.dualBasis_apply_self: ⟨v*ᵢ, v(j)⟩ = δᵢⱼ.
theorem dualFamily.apply_basis (I v i j : Set)
  requires finite : Finite(I)
  requires basis : ModuleBasis(M, R, I, v)
  requires first : i ∈ I
  requires second : j ∈ I
  shows dualFamily(M, R, I, v)(i)(v(j)) = unitVector(R, I, i)(j)
proof
  have basis0 := basis
  obtain ⟨_, spans⟩ := basis0
  obtain ⟨_, vF, _⟩ := spans
  have vjIn := FunctionBetween.apply_closed with vF, second
  have a := dualFamily.apply_vector at R, M, I, v, i, v(j) with ring, module, finite, basis, first, vjIn
  have b := basisCoordinates.basis_vector at R, M, I, v, j with ring, module, basis, finite, second
  have c := unitVector.symm at R, I, i, j with ring, first, second
  rw [a, b, c]

theorem evaluationForm.linear (v : M)
  shows LinearMap(evaluationForm(M, R, v), dualModule(M, R), R, selfModule(R))
proof
  have vIn : v ∈ Module.carrier(M) by assumption
  have ringR := CommRing.to_ring with ring
  have selfM := Ring.to_module with ringR
  have dualM := dualModule.module at R, M with ring, module
  have carrier := dualModule.carrierOf at R, M with ring, module
  have selfCarrier := selfModule.carrier_eq at R
  have values : ∀ φ ∈ linearForms(M, R), φ(v) ∈ Ring.carrier(R)
    intros φ hφ
    rw linearForms.unfold_eq at hφ
    have lin := linearMaps.linear with hφ
    have c := LinearMap.value_mem with lin, vIn
    rw selfCarrier at c
    exact c
  have function := evaluationForm.graph_function at M, R, v with values
  have fn : evaluationForm(M, R, v) : Module.carrier(dualModule(M, R)) → Module.carrier(selfModule(R))
    rw [carrier, selfCarrier]
    exact function
  have additive : ∀ φ ψ ∈ Module.carrier(dualModule(M, R)), evaluationForm(M, R, v)(call2(Module.add(dualModule(M, R)), φ, ψ)) = call2(Module.add(selfModule(R)), evaluationForm(M, R, v)(φ), evaluationForm(M, R, v)(ψ))
    intros φ φIn ψ ψIn
    have sumIn := Module.add_mem at R, dualModule(M, R), φ, ψ with *
    rw carrier at φIn
    rw carrier at ψIn
    rw carrier at sumIn
    have e1 := evaluationForm.graph_apply at M, R, v, call2(Module.add(dualModule(M, R)), φ, ψ) with values, sumIn
    have e2 := evaluationForm.graph_apply at M, R, v, φ with values, φIn
    have e3 := evaluationForm.graph_apply at M, R, v, ψ with values, ψIn
    rw linearForms.unfold_eq at φIn
    rw linearForms.unfold_eq at ψIn
    have lφ := linearMaps.linear with φIn
    have lψ := linearMaps.linear with ψIn
    have e4 := homModule.add_apply at R, M, selfModule(R), φ, ψ, v with ring, module, selfM, lφ, lψ, vIn
    rw [e1, e2, e3, dualModule.unfold_eq, e4]
  have homogeneous : ∀ r ∈ Ring.carrier(R), ∀ φ ∈ Module.carrier(dualModule(M, R)), evaluationForm(M, R, v)(call2(Module.smul(dualModule(M, R)), r, φ)) = call2(Module.smul(selfModule(R)), r, evaluationForm(M, R, v)(φ))
    intros r rIn φ φIn
    have prodIn := Module.smul_mem at R, dualModule(M, R), r, φ with *
    rw carrier at φIn
    rw carrier at prodIn
    have e1 := evaluationForm.graph_apply at M, R, v, call2(Module.smul(dualModule(M, R)), r, φ) with values, prodIn
    have e2 := evaluationForm.graph_apply at M, R, v, φ with values, φIn
    rw linearForms.unfold_eq at φIn
    have lφ := linearMaps.linear with φIn
    have e4 := homModule.smul_apply at R, M, selfModule(R), r, φ, v with ring, module, selfM, rIn, lφ, vIn
    rw [e1, e2, dualModule.unfold_eq, e4]
  exact LinearMap.of_laws with dualM, selfM, fn, additive, homogeneous

theorem dualFamily.combination_apply (I v c x : Set)
  requires finite : Finite(I)
  requires basis : ModuleBasis(M, R, I, v)
  requires coefficients : c : I → Ring.carrier(R)
  requires vector : x ∈ Module.carrier(M)
  shows moduleCombination(dualModule(M, R), R, I, c, dualFamily(M, R, I, v))(x) =
    moduleCombination(selfModule(R), R, I, c, basisCoordinates(M, R, I, v, x))
proof
  have ringR := CommRing.to_ring with ring
  have selfM := Ring.to_module with ringR
  have dualM := dualModule.module at R, M with ring, module
  have carrier := dualModule.carrierOf at R, M with ring, module
  have selfCarrier := selfModule.carrier_eq at R
  have dF := dualFamily.function_of at R, M, I, v with ring, module, finite, basis
  have evLin := evaluationForm.linear at R, M, x with *
  have combIn := moduleCombination.mem_of at R, dualModule(M, R), I, c, dualFamily(M, R, I, v) with ringR, dualM, finite, coefficients, dF
  rw carrier at combIn
  have e1 := evaluationForm.apply_of with vector, combIn
  have e2 := LinearMap.map_combination at R, dualModule(M, R), selfModule(R), evaluationForm(M, R, x), I, c, dualFamily(M, R, I, v) with ringR, dualM, selfM, evLin, finite, coefficients, dF
  have evF := LinearMap.function_of with evLin
  have cF := compose.function at evaluationForm(M, R, x), dualFamily(M, R, I, v), I, Module.carrier(dualModule(M, R)), Module.carrier(selfModule(R)) with dF, evF
  have coordF := basisCoordinates.function_of at R, M, I, v, x with ring, module, finite, basis, vector
  rw ← selfCarrier at coordF
  have cmp : compose(evaluationForm(M, R, x), dualFamily(M, R, I, v), I, Module.carrier(dualModule(M, R)), Module.carrier(selfModule(R))) = basisCoordinates(M, R, I, v, x)
    apply FunctionBetween.ext with cF, coordF
    intros i hi
    have a1 := compose.apply at evaluationForm(M, R, x), dualFamily(M, R, I, v), I, Module.carrier(dualModule(M, R)), Module.carrier(selfModule(R)), i with dF, evF, hi
    have biIn := FunctionBetween.apply_closed with dF, hi
    rw carrier at biIn
    have a3 := evaluationForm.apply_of with vector, biIn
    have a4 := dualFamily.apply_vector at R, M, I, v, i, x with ring, module, finite, basis, hi, vector
    rw [a1, a3, a4]
  rw [← e1, e2, cmp]

theorem dualFamily.spans_form (I v φ : Set)
  requires finite : Finite(I)
  requires basis : ModuleBasis(M, R, I, v)
  requires form : φ ∈ linearForms(M, R)
  shows φ = moduleCombination(dualModule(M, R), R, I,
    compose(φ, v, I, Module.carrier(M), Ring.carrier(R)), dualFamily(M, R, I, v))
proof
  have ringR := CommRing.to_ring with ring
  have selfM := Ring.to_module with ringR
  have dualM := dualModule.module at R, M with ring, module
  have carrier := dualModule.carrierOf at R, M with ring, module
  have selfCarrier := selfModule.carrier_eq at R
  have basis0 := basis
  obtain ⟨_, spans⟩ := basis0
  obtain ⟨_, vF, _⟩ := spans
  have φF := linearForms.function_of with form
  have cφF := compose.function at φ, v, I, Module.carrier(M), Ring.carrier(R) with vF, φF
  have dF := dualFamily.function_of at R, M, I, v with ring, module, finite, basis
  have combIn := moduleCombination.mem_of at R, dualModule(M, R), I, compose(φ, v, I, Module.carrier(M), Ring.carrier(R)), dualFamily(M, R, I, v) with ringR, dualM, finite, cφF, dF
  rw carrier at combIn
  have lφ := linearForms.linear_of with form
  have lC := linearForms.linear_of with combIn
  apply LinearMap.ext with lφ, lC
  intros x xIn
  have k := dualFamily.combination_apply at R, M, I, v, compose(φ, v, I, Module.carrier(M), Ring.carrier(R)), x with ring, module, finite, basis, cφF, xIn
  have xe := basisCoordinates.combination at R, M, I, v, x with ring, module, basis, finite, xIn
  have coordF := basisCoordinates.function_of at R, M, I, v, x with ring, module, finite, basis, xIn
  have m := LinearMap.map_combination at R, M, selfModule(R), φ, I, basisCoordinates(M, R, I, v, x), v with ringR, module, selfM, lφ, finite, coordF, vF
  rw selfCarrier at m
  have comm := selfCombination.comm at R, I, basisCoordinates(M, R, I, v, x), compose(φ, v, I, Module.carrier(M), Ring.carrier(R)) with ring, coordF, cφF
  cc

theorem dualFamily.combination_basis_vector (I v c k : Set)
  requires finite : Finite(I)
  requires basis : ModuleBasis(M, R, I, v)
  requires coefficients : c : I → Ring.carrier(R)
  requires index : k ∈ I
  shows moduleCombination(dualModule(M, R), R, I, c, dualFamily(M, R, I, v))(v(k)) = c(k)
proof
  have ringR := CommRing.to_ring with ring
  have selfM := Ring.to_module with ringR
  have basis0 := basis
  obtain ⟨_, spans⟩ := basis0
  obtain ⟨_, vF, _⟩ := spans
  have vkIn := FunctionBetween.apply_closed with vF, index
  have a := dualFamily.combination_apply at R, M, I, v, c, v(k) with ring, module, finite, basis, coefficients, vkIn
  have b := basisCoordinates.basis_vector at R, M, I, v, k with ring, module, basis, finite, index
  have uF0 := unitVector.mem at R, I, k with ring
  have uF := functionSpace.mem_iff.forward with uF0
  have comm := selfCombination.comm at R, I, c, unitVector(R, I, k) with ring, coefficients, uF
  have cS : c : I → Module.carrier(selfModule(R))
    rw selfModule.carrier_eq
    exact coefficients
  have u := moduleCombination.unit_vector at R, selfModule(R), I, c, k with ring, selfM, finite, cS, index
  rw [a, b, comm, u]

-- Basis.dualBasis: the coordinate forms are a basis of M*.
theorem dualFamily.basis (I v : Set)
  requires finite : Finite(I)
  requires basis : ModuleBasis(M, R, I, v)
  shows ModuleBasis(dualModule(M, R), R, I, dualFamily(M, R, I, v))
proof
  have ringR := CommRing.to_ring with ring
  have dualM := dualModule.module at R, M with ring, module
  have carrierD := dualModule.carrierOf at R, M with ring, module
  have dF := dualFamily.function_of at R, M, I, v with ring, module, finite, basis
  have basis0 := basis
  obtain ⟨_, spans⟩ := basis0
  obtain ⟨_, vF, _⟩ := spans
  have lin := combinationMap.linear at R, dualModule(M, R), I, dualFamily(M, R, I, v) with ring, dualM, finite, dF
  have carrier := coordinateModule.carrier_space at R, I
  have values : ∀ c ∈ functionSpace(I, R.carrier), moduleCombination(dualModule(M, R), R, I, c, dualFamily(M, R, I, v)) ∈ Module.carrier(dualModule(M, R))
    intros c hc
    have cF := functionSpace.mem_iff.forward with hc
    exact moduleCombination.mem_of at R, dualModule(M, R), I, c, dualFamily(M, R, I, v) with ringR, dualM, finite, cF, dF
  have fF := combinationMap.graph_function at dualModule(M, R), R, I, dualFamily(M, R, I, v) with values
  have cancel : ∀ c ∈ functionSpace(I, R.carrier), ∀ d ∈ functionSpace(I, R.carrier), combinationMap(dualModule(M, R), R, I, dualFamily(M, R, I, v))(c) = combinationMap(dualModule(M, R), R, I, dualFamily(M, R, I, v))(d) → c = d
    intros c hc d hd same
    have a1 := combinationMap.graph_apply at dualModule(M, R), R, I, dualFamily(M, R, I, v), c with values, hc
    have a2 := combinationMap.graph_apply at dualModule(M, R), R, I, dualFamily(M, R, I, v), d with values, hd
    rw [a1, a2] at same
    have cF := functionSpace.mem_iff.forward with hc
    have dF2 := functionSpace.mem_iff.forward with hd
    apply functionSpace.ext_of with hc, hd
    intros k hk
    have e1 := dualFamily.combination_basis_vector at R, M, I, v, c, k with ring, module, finite, basis, cF, hk
    have e2 := dualFamily.combination_basis_vector at R, M, I, v, d, k with ring, module, finite, basis, dF2, hk
    rw [← e1, ← e2, same]
  have inj := Injective.of_pointwise with fF, cancel
  have covers : ∀ y ∈ Module.carrier(dualModule(M, R)), ∃ c ∈ functionSpace(I, R.carrier), combinationMap(dualModule(M, R), R, I, dualFamily(M, R, I, v))(c) = y
    intros y hy
    rw carrierD at hy
    have yF := linearForms.function_of with hy
    have cyF := compose.function at y, v, I, Module.carrier(M), Ring.carrier(R) with vF, yF
    have cyIn := functionSpace.mem_iff.backward with cyF
    refine ⟨compose(y, v, I, Module.carrier(M), Ring.carrier(R)), cyIn, ?_⟩
    have a1 := combinationMap.graph_apply at dualModule(M, R), R, I, dualFamily(M, R, I, v), compose(y, v, I, Module.carrier(M), Ring.carrier(R)) with values, cyIn
    have sp := dualFamily.spans_form at R, M, I, v, y with ring, module, finite, basis, hy
    rw a1
    symm
    exact sp
  have surj := Surjective.of_pointwise with fF, covers
  have bij : BijectiveBetween(combinationMap(dualModule(M, R), R, I, dualFamily(M, R, I, v)), Module.carrier(coordinateModule(R, I)), Module.carrier(dualModule(M, R)))
    rw carrier
    exact ⟨inj, surj⟩
  have equiv := LinearEquiv.of_bijective with lin, bij
  exact ModuleBasis.of_combination_map_equiv at R, dualModule(M, R), I, dualFamily(M, R, I, v) with ring, dualM, finite, dF, equiv

-- The coordinates of a form in the dual basis are its values on the basis
-- (Basis.dualBasis_repr).
theorem dualFamily.coordinates (I v φ : Set)
  requires finite : Finite(I)
  requires basis : ModuleBasis(M, R, I, v)
  requires form : φ ∈ linearForms(M, R)
  shows basisCoordinates(dualModule(M, R), R, I, dualFamily(M, R, I, v), φ) =
    compose(φ, v, I, M.carrier, R.carrier)
proof
  have dualM := dualModule.module at R, M with ring, module
  have basis0 := basis
  obtain ⟨_, spans⟩ := basis0
  obtain ⟨_, vF, _⟩ := spans
  have φF := linearForms.function_of with form
  have cφF := compose.function at φ, v, I, Module.carrier(M), Ring.carrier(R) with vF, φF
  have bas := dualFamily.basis at R, M, I, v with ring, module, finite, basis
  have e := dualFamily.spans_form at R, M, I, v, φ with ring, module, finite, basis, form
  have o := basisCoordinates.of_combination at R, dualModule(M, R), I, dualFamily(M, R, I, v), compose(φ, v, I, Module.carrier(M), Ring.carrier(R)) with ring, dualM, bas, finite, cφF
  cc

-- Module.finrank_dual: M* has the rank of M.
theorem dualModule.finrank
  requires nontrivial : R.zero ≠ R.one
  requires free : FiniteFreeModule(M, R)
  shows FiniteFreeModule(dualModule(M, R), R) ∧
    finrank(dualModule(M, R), R) = finrank(M, R)
proof
  have dualM := dualModule.module at R, M with ring, module
  obtain ⟨I, v, finite, basis⟩ := free
  have bas := dualFamily.basis at R, M, I, v with ring, module, finite, basis
  have r1 := finrank.of_basis at R, dualModule(M, R), I, dualFamily(M, R, I, v) with ring, nontrivial, dualM, finite, bas
  have r2 := finrank.of_basis at R, M, I, v with ring, nontrivial, module, finite, basis
  have freeD : FiniteFreeModule(dualModule(M, R), R)
    unfold FiniteFreeModule
    refine ⟨I, dualFamily(M, R, I, v), finite, bas⟩
  refine ⟨freeD, ?_⟩
  rw [r1, r2]

theorem doubleDualMap.linear
  shows LinearMap(doubleDualMap(M, R), M, R, dualModule(dualModule(M, R), R))
proof
  have ringR := CommRing.to_ring with ring
  have dualM := dualModule.module at R, M with ring, module
  have ddM := dualModule.module at R, dualModule(M, R) with ring, dualM
  have carrierDD := dualModule.carrierOf at R, dualModule(M, R) with ring, dualM
  have carrierD := dualModule.carrierOf at R, M with ring, module
  have values : ∀ v ∈ Module.carrier(M), evaluationForm(M, R, v) ∈ linearForms(dualModule(M, R), R)
    intros v vIn
    have lin := evaluationForm.linear at R, M, v with *
    exact linearForms.of_linear_map with lin
  have function := doubleDualMap.graph_function at M, R with values
  have fn : doubleDualMap(M, R) : Module.carrier(M) → Module.carrier(dualModule(dualModule(M, R), R))
    rw carrierDD
    exact function
  have additive : ∀ v w ∈ Module.carrier(M), doubleDualMap(M, R)(call2(Module.add(M), v, w)) = call2(Module.add(dualModule(dualModule(M, R), R)), doubleDualMap(M, R)(v), doubleDualMap(M, R)(w))
    intros v vIn w wIn
    have sumIn := Module.add_mem at R, M, v, w with *
    have e1 := doubleDualMap.graph_apply at M, R, call2(Module.add(M), v, w) with values, sumIn
    have e2 := doubleDualMap.graph_apply at M, R, v with values, vIn
    have e3 := doubleDualMap.graph_apply at M, R, w with values, wIn
    rw [e1, e2, e3]
    have evIn := values with v, vIn
    have ewIn := values with w, wIn
    have esIn := values with call2(Module.add(M), v, w), sumIn
    have rhsIn := dualModule.add_mem at R, dualModule(M, R), evaluationForm(M, R, v), evaluationForm(M, R, w) with ring, dualM, evIn, ewIn
    have l1 := linearForms.linear_of with esIn
    have l2 := linearForms.linear_of with rhsIn
    apply LinearMap.ext with l1, l2
    intros φ φIn
    have φL : φ ∈ linearForms(M, R)
      rw ← carrierD
      exact φIn
    have a1 := evaluationForm.apply_of with sumIn, φL
    have a2 := evaluationForm.apply_of with vIn, φL
    have a3 := evaluationForm.apply_of with wIn, φL
    have a4 := linearForms.map_add with φL, vIn, wIn
    have a5 := dualModule.add_apply at R, dualModule(M, R), evaluationForm(M, R, v), evaluationForm(M, R, w), φ with ring, dualM, evIn, ewIn, φIn
    rw [a1, a4, a5, a2, a3]
  have homogeneous : ∀ r ∈ Ring.carrier(R), ∀ v ∈ Module.carrier(M), doubleDualMap(M, R)(call2(Module.smul(M), r, v)) = call2(Module.smul(dualModule(dualModule(M, R), R)), r, doubleDualMap(M, R)(v))
    intros r rIn v vIn
    have prodIn := Module.smul_mem at R, M, r, v with *
    have e1 := doubleDualMap.graph_apply at M, R, call2(Module.smul(M), r, v) with values, prodIn
    have e2 := doubleDualMap.graph_apply at M, R, v with values, vIn
    rw [e1, e2]
    have evIn := values with v, vIn
    have esIn := values with call2(Module.smul(M), r, v), prodIn
    have rhsIn := dualModule.smul_mem at R, dualModule(M, R), r, evaluationForm(M, R, v) with ring, dualM, rIn, evIn
    have l1 := linearForms.linear_of with esIn
    have l2 := linearForms.linear_of with rhsIn
    apply LinearMap.ext with l1, l2
    intros φ φIn
    have φL : φ ∈ linearForms(M, R)
      rw ← carrierD
      exact φIn
    have a1 := evaluationForm.apply_of with prodIn, φL
    have a2 := evaluationForm.apply_of with vIn, φL
    have a4 := linearForms.map_smul with φL, rIn, vIn
    have a5 := dualModule.smul_apply at R, dualModule(M, R), r, evaluationForm(M, R, v), φ with ring, dualM, rIn, evIn, φIn
    rw [a1, a4, a5, a2]
  exact LinearMap.of_laws with module, ddM, fn, additive, homogeneous

-- Module.evalEquiv: for a finite free module M ≅ M** by evaluation.
theorem doubleDualMap.equiv
  requires free : FiniteFreeModule(M, R)
  shows LinearEquiv(doubleDualMap(M, R), M, R, dualModule(dualModule(M, R), R))
proof
  have ringR := CommRing.to_ring with ring
  have lin := doubleDualMap.linear at R, M with ring, module
  have dualM := dualModule.module at R, M with ring, module
  have carrierD := dualModule.carrierOf at R, M with ring, module
  have carrierDD := dualModule.carrierOf at R, dualModule(M, R) with ring, dualM
  have fF := LinearMap.function_of with lin
  obtain ⟨I, v, finite, basis⟩ := free
  have bas := dualFamily.basis at R, M, I, v with ring, module, finite, basis
  have dvals := dualFamily.values at R, M, I, v with ring, module, finite, basis
  have dF := dualFamily.function_of at R, M, I, v with ring, module, finite, basis
  have values : ∀ x ∈ Module.carrier(M), evaluationForm(M, R, x) ∈ linearForms(dualModule(M, R), R)
    intros x xIn
    have l := evaluationForm.linear at R, M, x with *
    exact linearForms.of_linear_map with l
  have cancel : ∀ x ∈ Module.carrier(M), ∀ y ∈ Module.carrier(M), doubleDualMap(M, R)(x) = doubleDualMap(M, R)(y) → x = y
    intros x xIn y yIn same
    have a1 := doubleDualMap.graph_apply at M, R, x with values, xIn
    have a2 := doubleDualMap.graph_apply at M, R, y with values, yIn
    rw [a1, a2] at same
    apply dualFamily.vector_ext at R, M, I, v, x, y with ring, module, finite, basis, xIn, yIn
    intros i hi
    have dIn := dvals with i, hi
    have e := dualFamily.graph_apply at M, R, I, v, i with dvals, hi
    have b1 := evaluationForm.apply_of with xIn, dIn
    have b2 := evaluationForm.apply_of with yIn, dIn
    rw [e, ← b1, ← b2, same]
  have inj := Injective.of_pointwise with fF, cancel
  have covers : ∀ Λ ∈ Module.carrier(dualModule(dualModule(M, R), R)), ∃ x ∈ Module.carrier(M), doubleDualMap(M, R)(x) = Λ
    intros Λ ΛIn
    rw carrierDD at ΛIn
    have ΛF := linearForms.function_of with ΛIn
    rw carrierD at ΛF
    rw carrierD at dF
    have cF := compose.function at Λ, dualFamily(M, R, I, v), I, linearForms(M, R), Ring.carrier(R) with dF, ΛF
    have basis0 := basis
    obtain ⟨_, spans⟩ := basis0
    obtain ⟨_, vF, _⟩ := spans
    have xIn := moduleCombination.mem_of at R, M, I, compose(Λ, dualFamily(M, R, I, v), I, linearForms(M, R), Ring.carrier(R)), v with ringR, module, finite, cF, vF
    refine ⟨moduleCombination(M, R, I, compose(Λ, dualFamily(M, R, I, v), I, linearForms(M, R), Ring.carrier(R)), v), xIn, ?_⟩
    have a1 := doubleDualMap.graph_apply at M, R, moduleCombination(M, R, I, compose(Λ, dualFamily(M, R, I, v), I, linearForms(M, R), Ring.carrier(R)), v) with values, xIn
    rw a1
    have evIn := values with moduleCombination(M, R, I, compose(Λ, dualFamily(M, R, I, v), I, linearForms(M, R), Ring.carrier(R)), v), xIn
    have l1 := linearForms.linear_of with evIn
    have l2 := linearForms.linear_of with ΛIn
    apply ModuleBasis.ext at R, dualModule(M, R), selfModule(R), evaluationForm(M, R, moduleCombination(M, R, I, compose(Λ, dualFamily(M, R, I, v), I, linearForms(M, R), Ring.carrier(R)), v)), Λ, I, dualFamily(M, R, I, v) with ring, dualM, bas, l1, l2
    intros j hj
    have dIn := dvals with j, hj
    have e := dualFamily.graph_apply at M, R, I, v, j with dvals, hj
    have b1 := evaluationForm.apply_of with xIn, dIn
    have b2 := dualFamily.apply_vector at R, M, I, v, j, moduleCombination(M, R, I, compose(Λ, dualFamily(M, R, I, v), I, linearForms(M, R), Ring.carrier(R)), v) with ring, module, finite, basis, hj, xIn
    have b3 := basisCoordinates.of_combination at R, M, I, v, compose(Λ, dualFamily(M, R, I, v), I, linearForms(M, R), Ring.carrier(R)) with ring, module, basis, finite, cF
    have b4 := compose.apply at Λ, dualFamily(M, R, I, v), I, linearForms(M, R), Ring.carrier(R), j with dF, ΛF, hj
    rw [e, b1]
    rw ← e
    rw [b2, b3, b4]
  have surj := Surjective.of_pointwise with fF, covers
  exact LinearEquiv.of_bijective with lin, ⟨inj, surj⟩

-- Forms separate the vectors of a finite free module
-- (Module.forall_dual_apply_eq_zero_iff).
theorem dualModule.separates (v : M)
  requires free : FiniteFreeModule(M, R)
  requires vanishing : ∀ φ ∈ linearForms(M, R), φ(v) = R.zero
  shows v = M.zero
proof
  have ringR := CommRing.to_ring with ring
  have selfM := Ring.to_module with ringR
  have vIn : v ∈ Module.carrier(M) by assumption
  obtain ⟨I, b, finite, basis⟩ := free
  have zeroIn := Module.zero_mem at R, M with ringR, module
  have dvals := dualFamily.values at R, M, I, b with ring, module, finite, basis
  apply dualFamily.vector_ext at R, M, I, b, v, Module.zero(M) with ring, module, finite, basis, vIn, zeroIn
  intros i hi
  have a := dualFamily.graph_apply at M, R, I, b, i with dvals, hi
  have form := dvals with i, hi
  have z1 := vanishing with basisCoordinate(M, R, I, b, i), form
  have lin := linearForms.linear_of with form
  have z2 := LinearMap.map_zero at R, M, selfModule(R), basisCoordinate(M, R, I, b, i) with ringR, module, selfM, lin
  rw [a, z1, z2, selfModule.zero_eq]

theorem dualMap.linear (N f : Set)
  requires linear : LinearMap(f, M, R, N)
  shows LinearMap(dualMap(f, M, R, N), dualModule(N, R), R, dualModule(M, R))
proof
  have ringR := CommRing.to_ring with ring
  have values := dualMap.values at M, R, N, f with linear
  have function := dualMap.graph_function at f, M, R, N with values
  have moduleN := LinearMap.target_module_of with linear
  have dualN := dualModule.module at R, N with ring, moduleN
  have dualM := dualModule.module at R, M with ring, module
  have carrierN := dualModule.carrierOf at R, N with ring, moduleN
  have carrierM := dualModule.carrierOf at R, M with ring, module
  have fn : dualMap(f, M, R, N) : Module.carrier(dualModule(N, R)) → Module.carrier(dualModule(M, R))
    rw [carrierN, carrierM]
    exact function
  have additive : ∀ φ ψ ∈ Module.carrier(dualModule(N, R)), dualMap(f, M, R, N)(call2(Module.add(dualModule(N, R)), φ, ψ)) = call2(Module.add(dualModule(M, R)), dualMap(f, M, R, N)(φ), dualMap(f, M, R, N)(ψ))
    intros φ φIn ψ ψIn
    rw carrierN at φIn
    rw carrierN at ψIn
    have sumIn := dualModule.add_mem at R, N, φ, ψ with ring, moduleN, φIn, ψIn
    have lhsIn := FunctionBetween.apply_closed with function, sumIn
    have dφIn := FunctionBetween.apply_closed with function, φIn
    have dψIn := FunctionBetween.apply_closed with function, ψIn
    have rhsIn := dualModule.add_mem at R, M, dualMap(f, M, R, N)(φ), dualMap(f, M, R, N)(ψ) with ring, module, dφIn, dψIn
    have l1 := linearForms.linear_of with lhsIn
    have l2 := linearForms.linear_of with rhsIn
    apply LinearMap.ext with l1, l2
    intros v vIn
    have fvIn := LinearMap.value_mem with linear, vIn
    have e1 := dualMap.value_apply with linear, sumIn, vIn
    have e2 := dualModule.add_apply at R, N, φ, ψ, f(v) with ring, moduleN, φIn, ψIn, fvIn
    have e3 := dualModule.add_apply at R, M, dualMap(f, M, R, N)(φ), dualMap(f, M, R, N)(ψ), v with ring, module, dφIn, dψIn, vIn
    have e4 := dualMap.value_apply with linear, φIn, vIn
    have e5 := dualMap.value_apply with linear, ψIn, vIn
    rw [e1, e2, e3, e4, e5]
  have homogeneous : ∀ r ∈ Ring.carrier(R), ∀ φ ∈ Module.carrier(dualModule(N, R)), dualMap(f, M, R, N)(call2(Module.smul(dualModule(N, R)), r, φ)) = call2(Module.smul(dualModule(M, R)), r, dualMap(f, M, R, N)(φ))
    intros r rIn φ φIn
    rw carrierN at φIn
    have prodIn := dualModule.smul_mem at R, N, r, φ with ring, moduleN, rIn, φIn
    have lhsIn := FunctionBetween.apply_closed with function, prodIn
    have dφIn := FunctionBetween.apply_closed with function, φIn
    have rhsIn := dualModule.smul_mem at R, M, r, dualMap(f, M, R, N)(φ) with ring, module, rIn, dφIn
    have l1 := linearForms.linear_of with lhsIn
    have l2 := linearForms.linear_of with rhsIn
    apply LinearMap.ext with l1, l2
    intros v vIn
    have fvIn := LinearMap.value_mem with linear, vIn
    have e1 := dualMap.value_apply with linear, prodIn, vIn
    have e2 := dualModule.smul_apply at R, N, r, φ, f(v) with ring, moduleN, rIn, φIn, fvIn
    have e3 := dualModule.smul_apply at R, M, r, dualMap(f, M, R, N)(φ), v with ring, module, rIn, dφIn, vIn
    have e4 := dualMap.value_apply with linear, φIn, vIn
    rw [e1, e2, e3, e4]
  exact LinearMap.of_laws with dualN, dualM, fn, additive, homogeneous

theorem dualMap.apply (N f φ v : Set)
  requires linear : LinearMap(f, M, R, N)
  requires form : φ ∈ linearForms(N, R)
  requires vector : v ∈ M.carrier
  shows dualMap(f, M, R, N)(φ)(v) = φ(f(v))
proof
  exact dualMap.value_apply with linear, form, vector

theorem dualMap.identity
  shows dualMap(identity(M.carrier), M, R, M) = identity(linearForms(M, R))
proof
  have lin := LinearMap.identity at M, R with module
  have values := dualMap.values at M, R, M, identity(Module.carrier(M)) with lin
  have function := dualMap.graph_function at identity(Module.carrier(M)), M, R, M with values
  have idF := identity.function at linearForms(M, R)
  apply FunctionBetween.ext with function, idF
  intros φ form
  have e1 := dualMap.graph_apply at identity(Module.carrier(M)), M, R, M, φ with values, form
  have e2 := identity.apply at φ, linearForms(M, R) with form
  have φF := linearForms.function_of with form
  have e3 := compose.identity_right at φ, Module.carrier(M), Ring.carrier(R) with φF
  rw [e1, e2, e3]

theorem dualMap.compose (N P f g : Set)
  requires first : LinearMap(f, M, R, N)
  requires second : LinearMap(g, N, R, P)
  shows dualMap(compose(g, f, M.carrier, N.carrier, P.carrier), M, R, P) =
    compose(dualMap(f, M, R, N), dualMap(g, N, R, P), linearForms(P, R),
      linearForms(N, R), linearForms(M, R))
proof
  have gf := LinearMap.compose at f, g, M, R, N, P with first, second
  have moduleN := LinearMap.target_module_of with first
  have valuesGF := dualMap.values at M, R, P, compose(g, f, Module.carrier(M), Module.carrier(N), Module.carrier(P)) with gf
  have valuesF := dualMap.values at M, R, N, f with first
  have valuesG := dualMap.values at N, R, P, g with second
  have function := dualMap.graph_function at compose(g, f, Module.carrier(M), Module.carrier(N), Module.carrier(P)), M, R, P with valuesGF
  have fF := dualMap.graph_function at f, M, R, N with valuesF
  have gF := dualMap.graph_function at g, N, R, P with valuesG
  have cF := compose.function at dualMap(f, M, R, N), dualMap(g, N, R, P), linearForms(P, R), linearForms(N, R), linearForms(M, R) with gF, fF
  apply FunctionBetween.ext with function, cF
  intros φ form
  have e1 := dualMap.graph_apply at compose(g, f, Module.carrier(M), Module.carrier(N), Module.carrier(P)), M, R, P, φ with valuesGF, form
  have e2 := compose.apply at dualMap(f, M, R, N), dualMap(g, N, R, P), linearForms(P, R), linearForms(N, R), linearForms(M, R), φ with gF, fF, form
  have gφIn := valuesG with φ, form
  have e3 := dualMap.graph_apply at g, N, R, P, φ with valuesG, form
  have e4 := dualMap.graph_apply at f, M, R, N, compose(φ, g, Module.carrier(N), Module.carrier(P), Ring.carrier(R)) with valuesF, gφIn
  have φF := linearForms.function_of with form
  have fFun := LinearMap.function_of with first
  have gFun := LinearMap.function_of with second
  have assoc := compose.associative at φ, g, f, Module.carrier(M), Module.carrier(N), Module.carrier(P), Ring.carrier(R) with fFun, gFun, φF
  rw [e1, e2, e3, e4, assoc]

-- The dual of Rᴵ: the forms on Rᴵ are u ↦ Σ c(i) u(i) for a unique c.
theorem coordinateModule.forms (I φ : Set)
  requires finite : Finite(I)
  requires form : φ ∈ linearForms(coordinateModule(R, I), R)
  shows ∃ c ∈ functionSpace(I, R.carrier), ∀ u ∈ functionSpace(I, R.carrier),
    φ(u) = finiteRingSum(I, R.carrier, R.add, R.zero, R.neg, R.mul, R.one,
      combinationTerms(selfModule(R), R, I, c, u))
proof
  have ringR := CommRing.to_ring with ring
  have selfM := Ring.to_module with ringR
  have coordM := coordinateModule.module at R, I with *
  have carrier := coordinateModule.carrier_space at R, I
  have sbBasis := standardBasis.basis at R, I with ring, finite
  have sb0 := sbBasis
  obtain ⟨_, spans⟩ := sb0
  obtain ⟨_, sbF, _⟩ := spans
  have φF := linearForms.function_of with form
  have cF := compose.function at φ, standardBasis(R, I), I, Module.carrier(coordinateModule(R, I)), Ring.carrier(R) with sbF, φF
  have cIn := functionSpace.mem_iff.backward with cF
  refine ⟨compose(φ, standardBasis(R, I), I, Module.carrier(coordinateModule(R, I)), Ring.carrier(R)), cIn, ?_⟩
  intros u uIn
  have uF := functionSpace.mem_iff.forward with uIn
  have ue := standardBasis.combination at R, I, u with ring, finite, uF
  have lφ := linearForms.linear_of with form
  have m := LinearMap.map_combination at R, coordinateModule(R, I), selfModule(R), φ, I, u, standardBasis(R, I) with ringR, coordM, selfM, lφ, finite, uF, sbF
  rw selfModule.carrier_eq at m
  have comm := selfCombination.comm at R, I, u, compose(φ, standardBasis(R, I), I, Module.carrier(coordinateModule(R, I)), Ring.carrier(R)) with ring, uF, cF
  have cS : compose(φ, standardBasis(R, I), I, Module.carrier(coordinateModule(R, I)), Ring.carrier(R)) : I → Module.carrier(selfModule(R))
    rw selfModule.carrier_eq
    exact cF
  have uS : u : I → Module.carrier(selfModule(R))
    rw selfModule.carrier_eq
    exact uF
  have tF := combinationTerms.function at selfModule(R), R, I, compose(φ, standardBasis(R, I), I, Module.carrier(coordinateModule(R, I)), Ring.carrier(R)), u with selfM, cF, uS
  rw selfModule.carrier_eq at tF
  have sr := moduleSum.self_ring_sum at R, I, combinationTerms(selfModule(R), R, I, compose(φ, standardBasis(R, I), I, Module.carrier(coordinateModule(R, I)), Ring.carrier(R)), u) with ring, finite, tF
  have mc : moduleCombination(selfModule(R), R, I, compose(φ, standardBasis(R, I), I, Module.carrier(coordinateModule(R, I)), Ring.carrier(R)), u) = moduleSum(selfModule(R), I, combinationTerms(selfModule(R), R, I, compose(φ, standardBasis(R, I), I, Module.carrier(coordinateModule(R, I)), Ring.carrier(R)), u))
    unfold moduleCombination
    rfl
  cc

theorem dualAnnihilator.submodule (W : Set)
  shows SubmoduleOf(dualAnnihilator(M, R, W), dualModule(M, R), R)
proof
  sorry

theorem dualCoannihilator.submodule (Φ : Set)
  shows SubmoduleOf(dualCoannihilator(M, R, Φ), M, R)
proof
  sorry

theorem dualMap.injective_of_surjective (N f : Set)
  requires linear : LinearMap(f, M, R, N)
  requires surjective : SurjectiveBetween(f, M.carrier, N.carrier)
  shows InjectiveBetween(dualMap(f, M, R, N), linearForms(N, R),
    linearForms(M, R))
proof
  have values := dualMap.values at M, R, N, f with linear
  have fF := dualMap.graph_function at f, M, R, N with values
  apply Injective.of_pointwise with fF
  intros φ φIn ψ ψIn same
  have lφ := linearForms.linear_of with φIn
  have lψ := linearForms.linear_of with ψIn
  apply LinearMap.ext with lφ, lψ
  intros w wIn
  obtain ⟨v, vIn, fv⟩ := Surjective.apply_exists with surjective, wIn
  have a1 := dualMap.value_apply with linear, φIn, vIn
  have a2 := dualMap.value_apply with linear, ψIn, vIn
  rw same at a1
  rw ← fv
  cc

end Duality

section VectorToolkit
variable (K V : Set)
hypothesis field : Field(K)
hypothesis module : Module(V, K)
hypothesis finiteDimensional : FiniteDimensional(V, K)

theorem finrank.zero_submodule
  shows finrank(submoduleModule(V, K, {V.zero}), K) = 0
proof
  have comm := Field.to_comm_ring with field
  have ringK := CommRing.to_ring with comm
  have parts := Field.parts with field
  obtain ⟨_, nontrivialParts, _⟩ := parts
  obtain ⟨_, _, nontrivial⟩ := nontrivialParts
  have sub := SubmoduleOf.zero_submodule at K, V with ringK, module
  obtain ⟨fd, _⟩ := SubmoduleOf.finite_dimensional at K, V, {V.zero} with field, module, finiteDimensional, sub
  have subM := SubmoduleOf.submodule_module at K, V, {V.zero} with ringK, module, sub
  have free := FiniteDimensional.finite_free at K, submoduleModule(V, K, {V.zero}) with field, subM, fd
  have iff := finrank.zero_iff at K, submoduleModule(V, K, {V.zero}) with comm, nontrivial, subM, free
  apply iff.backward
  rw [submoduleModule.carrier_eq, submoduleModule.zero_eq]

theorem LinearMap.injective_range_finrank (W f : Set)
  requires linear : LinearMap(f, V, K, W)
  requires injective : InjectiveBetween(f, V.carrier, W.carrier)
  shows finrank(submoduleModule(W, K, linearRange(f, V, W)), K) = finrank(V, K)
proof
  have comm := Field.to_comm_ring with field
  have ringK := CommRing.to_ring with comm
  have moduleW := LinearMap.target_module_of with linear
  have rn := LinearMap.rank_nullity at K, V, W, f with field, module, finiteDimensional, linear
  have kerIff := LinearMap.injective_iff_kernel at K, V, W, f with ringK, module, moduleW, linear
  have ker := kerIff.forward with injective
  rw ker at rn
  have z := finrank.zero_submodule at K, V with field, module, finiteDimensional
  rw z at rn
  simp [add] at rn
  exact rn

theorem dualAnnihilator.separates (U x : Set)
  requires sub : SubmoduleOf(U, V, K)
  requires vector : x ∈ Module.carrier(V)
  requires outside : x ∉ U
  shows ∃ φ ∈ linearForms(V, K), (∀ u ∈ U, φ(u) = Ring.zero(K)) ∧
    φ(x) = Ring.one(K)
proof
  have comm := Field.to_comm_ring with field
  have ringK := CommRing.to_ring with comm
  have selfM := Ring.to_module with ringK
  have qM := SubmoduleOf.quotient_module at K, V, U with ringK, module, sub
  have qL := SubmoduleOf.quotient_map_linear at K, V, U with ringK, module, sub
  have qS := SubmoduleOf.quotient_map_surjective at K, V, U with ringK, module, sub
  have qFD := LinearMap.surjective_finite_dimensional at K, V, quotientModule(V, K, U), quotientModuleMap(V, U) with field, module, finiteDimensional, qL, qS
  have zeroIn := Module.zero_mem at K, V with ringK, module
  have qz := LinearMap.map_zero at K, V, quotientModule(V, K, U), quotientModuleMap(V, U) with ringK, module, qM, qL
  have negZero := Module.neg_zero at K, V with ringK, module
  have sub0 := sub
  obtain ⟨_, UV, _⟩ := sub0
  have classZero : ∀ u ∈ U, quotientModuleMap(V, U)(u) = Module.zero(quotientModule(V, K, U))
    intros u uIn
    have uV := UV with u, uIn
    have iff := SubmoduleOf.quotient_eq at K, V, U, u, Module.zero(V) with ringK, module, sub, uV, zeroIn
    have az := Module.add_zero at K, V, u with ringK, module, uV
    have inU : call2(Module.add(V), u, apply(Module.neg(V), Module.zero(V))) ∈ U
      rw [negZero, az]
      exact uIn
    have same := iff.backward with inU
    rw [same, qz]
  have qxIn := LinearMap.value_mem with qL, vector
  have nonzero : quotientModuleMap(V, U)(x) ≠ Module.zero(quotientModule(V, K, U))
    intro h
    rw ← qz at h
    have iff := SubmoduleOf.quotient_eq at K, V, U, x, Module.zero(V) with ringK, module, sub, vector, zeroIn
    have inU := iff.forward with h
    have az := Module.add_zero at K, V, x with ringK, module, vector
    rw [negZero, az] at inU
    contradiction
  obtain ⟨ψ, ψL, ψx⟩ := FiniteDimensional.exists_form at K, quotientModule(V, K, U), quotientModuleMap(V, U)(x) with field, qM, qFD, nonzero
  have φL := LinearMap.compose at quotientModuleMap(V, U), ψ, V, K, quotientModule(V, K, U), selfModule(K) with qL, ψL
  rw selfModule.carrier_eq at φL
  have φIn := linearForms.of_linear_map with φL
  have qF := LinearMap.function_of with qL
  have ψF := LinearMap.function_of with ψL
  rw selfModule.carrier_eq at ψF
  have ψ0 := LinearMap.map_zero at K, quotientModule(V, K, U), selfModule(K), ψ with ringK, qM, selfM, ψL
  rw selfModule.zero_eq at ψ0
  refine ⟨compose(ψ, quotientModuleMap(V, U), Module.carrier(V), Module.carrier(quotientModule(V, K, U)), Ring.carrier(K)), φIn, ?_, ?_⟩
  . intros u uIn
    have uV := UV with u, uIn
    have a := compose.apply at ψ, quotientModuleMap(V, U), Module.carrier(V), Module.carrier(quotientModule(V, K, U)), Ring.carrier(K), u with qF, ψF, uV
    have c := classZero with u, uIn
    rw [a, c, ψ0]
  . have a := compose.apply at ψ, quotientModuleMap(V, U), Module.carrier(V), Module.carrier(quotientModule(V, K, U)), Ring.carrier(K), x with qF, ψF, vector
    rw [a, ψx]

theorem dualModule.finite_dimensional
  shows FiniteDimensional(dualModule(V, K), K) ∧
    finrank(dualModule(V, K), K) = finrank(V, K)
proof
  have comm := Field.to_comm_ring with field
  have parts := Field.parts with field
  obtain ⟨_, nontrivialParts, _⟩ := parts
  obtain ⟨_, _, nontrivial⟩ := nontrivialParts
  have free := FiniteDimensional.finite_free at K, V with field, module, finiteDimensional
  obtain ⟨freeD, rank⟩ := dualModule.finrank at K, V with comm, module, nontrivial, free
  have dualM := dualModule.module at K, V with comm, module
  have fd := FiniteDimensional.of_finite_free at K, dualModule(V, K) with field, dualM, freeD
  exact ⟨fd, rank⟩

theorem LinearMap.injective_finrank_le (W f : Set)
  requires finiteW : FiniteDimensional(W, K)
  requires linear : LinearMap(f, V, K, W)
  requires injective : InjectiveBetween(f, V.carrier, W.carrier)
  shows finrank(V, K) ≤ finrank(W, K)
proof
  have comm := Field.to_comm_ring with field
  have ringK := CommRing.to_ring with comm
  have moduleW := LinearMap.target_module_of with linear
  have rangeSub := LinearMap.range_submodule at K, V, W, f with ringK, module, moduleW, linear
  obtain ⟨_, le⟩ := SubmoduleOf.finite_dimensional at K, W, linearRange(f, V, W) with field, moduleW, finiteW, rangeSub
  have same := LinearMap.injective_range_finrank at K, V, W, f with field, module, finiteDimensional, linear, injective
  rw same at le
  exact le

end VectorToolkit

section VectorSpaces
variable (K V : Set)
hypothesis field : Field(K)
hypothesis module : Module(V, K)
hypothesis finiteDimensional : FiniteDimensional(V, K)

-- Subspace.finrank_add_finrank_dualAnnihilator_eq.
theorem dualAnnihilator.finrank (W : Set)
  requires sub : SubmoduleOf(W, V, K)
  shows finrank(submoduleModule(V, K, W), K) +
      finrank(submoduleModule(dualModule(V, K), K, dualAnnihilator(V, K, W)), K) =
    finrank(V, K)
proof
  have comm := Field.to_comm_ring with field
  have ringK := CommRing.to_ring with comm
  have selfM := Ring.to_module with ringK
  have qM := SubmoduleOf.quotient_module at K, V, W with ringK, module, sub
  have qL := SubmoduleOf.quotient_map_linear at K, V, W with ringK, module, sub
  have qS := SubmoduleOf.quotient_map_surjective at K, V, W with ringK, module, sub
  have qFD := LinearMap.surjective_finite_dimensional at K, V, quotientModule(V, K, W), quotientModuleMap(V, W) with field, module, finiteDimensional, qL, qS
  have qsL := dualMap.linear at K, V, quotientModule(V, K, W), quotientModuleMap(V, W) with comm, module, qL
  have qsInj := dualMap.injective_of_surjective at K, V, quotientModule(V, K, W), quotientModuleMap(V, W) with comm, module, qL, qS
  have dualQ := dualModule.module at K, quotientModule(V, K, W) with comm, qM
  have dualV := dualModule.module at K, V with comm, module
  have carrierQ := dualModule.carrierOf at K, quotientModule(V, K, W) with comm, qM
  have carrierV := dualModule.carrierOf at K, V with comm, module
  rw ← carrierQ at qsInj
  rw ← carrierV at qsInj
  obtain ⟨fdQ, rankQ⟩ := dualModule.finite_dimensional at K, quotientModule(V, K, W) with field, qM, qFD
  have rr := LinearMap.injective_range_finrank at K, dualModule(quotientModule(V, K, W), K), dualModule(V, K), dualMap(quotientModuleMap(V, W), V, K, quotientModule(V, K, W)) with field, dualQ, fdQ, qsL, qsInj
  have values := dualMap.values at V, K, quotientModule(V, K, W), quotientModuleMap(V, W) with qL
  have qsF := dualMap.graph_function at quotientModuleMap(V, W), V, K, quotientModule(V, K, W) with values
  have rangeEq : linearRange(dualMap(quotientModuleMap(V, W), V, K, quotientModule(V, K, W)), dualModule(quotientModule(V, K, W), K), dualModule(V, K)) = dualAnnihilator(V, K, W)
    ext φ
    constructor
    . intro hφ
      obtain ⟨φIn, χ, χIn, χφ⟩ := linearRange.membership.forward with hφ
      rw carrierV at φIn
      rw carrierQ at χIn
      apply dualAnnihilator.membership.backward
      refine ⟨φIn, ?_⟩
      intros w wW
      have sub0 := sub
      obtain ⟨_, WV, _⟩ := sub0
      have wV := WV with w, wW
      have a1 := dualMap.value_apply with qL, χIn, wV
      have c := quotientModuleMap.submodule_zero at K, V, W, w with ringK, module, sub, wW
      have lχ := linearForms.linear_of with χIn
      have z := LinearMap.map_zero at K, quotientModule(V, K, W), selfModule(K), χ with ringK, qM, selfM, lχ
      rw [← χφ, a1, c, z, selfModule.zero_eq]
    . intro hφ
      obtain ⟨φIn, φW⟩ := dualAnnihilator.membership.forward with hφ
      have lφ := linearForms.linear_of with φIn
      have vanishes : W ⊆ linearKernel(φ, V, selfModule(K))
        intros w wW
        have sub0 := sub
        obtain ⟨_, WV, _⟩ := sub0
        have wV := WV with w, wW
        apply linearKernel.membership.backward
        have z := φW with w, wW
        rw selfModule.zero_eq
        exact ⟨wV, z⟩
      obtain ⟨χL, χq⟩ := SubmoduleOf.quotient_lift at K, V, W, φ, selfModule(K) with ringK, module, sub, lφ, vanishes
      have χIn := linearForms.of_linear_map with χL
      apply linearRange.membership.backward
      have φD : φ ∈ Module.carrier(dualModule(V, K))
        rw carrierV
        exact φIn
      have χD : quotientLift(φ, V, W, selfModule(K)) ∈ Module.carrier(dualModule(quotientModule(V, K, W), K))
        rw carrierQ
        exact χIn
      refine ⟨φD, quotientLift(φ, V, W, selfModule(K)), χD, ?_⟩
      have imgIn := FunctionBetween.apply_closed with qsF, χIn
      have l1 := linearForms.linear_of with imgIn
      apply LinearMap.ext with l1, lφ
      intros v vIn
      have a1 := dualMap.value_apply with qL, χIn, vIn
      have a2 := χq with v, vIn
      rw [a1, a2]
  rw rangeEq at rr
  have fq := SubmoduleOf.finrank_quotient at K, V, W with field, module, finiteDimensional, sub
  obtain ⟨dimW, _⟩ := SubmoduleOf.finite_dimensional at K, V, W with field, module, finiteDimensional, sub
  have subModule := SubmoduleOf.submodule_module at K, V, W with ringK, module, sub
  have m1 := FiniteDimensional.finrank_member at K, submoduleModule(V, K, W) with field, subModule, dimW
  have m2 := FiniteDimensional.finrank_member at K, quotientModule(V, K, W) with field, qM, qFD
  have n1 := nat.omega.backward with m1
  have n2 := nat.omega.backward with m2
  rw [rr, rankQ]
  arith

-- Subspace.dualAnnihilator_dualCoannihilator_eq.
theorem dualCoannihilator.of_annihilator (W : Set)
  requires sub : SubmoduleOf(W, V, K)
  shows dualCoannihilator(V, K, dualAnnihilator(V, K, W)) = W
proof
  have parts := Field.parts with field
  obtain ⟨_, nontrivialParts, _⟩ := parts
  obtain ⟨_, _, nontrivial⟩ := nontrivialParts
  have sub0 := sub
  obtain ⟨_, WV, _⟩ := sub0
  ext x
  constructor
  . intro hx
    obtain ⟨xV, vanish⟩ := dualCoannihilator.membership.forward with hx
    by_contra notW
    obtain ⟨φ, φIn, φW, φx⟩ := dualAnnihilator.separates at K, V, W, x with field, module, finiteDimensional, sub, xV, notW
    have ann : φ ∈ dualAnnihilator(V, K, W)
      apply dualAnnihilator.membership.backward
      exact ⟨φIn, φW⟩
    have z := vanish with φ, ann
    rw φx at z
    apply nontrivial
    symm
    exact z
  . intro hx
    apply dualCoannihilator.membership.backward
    refine ⟨(WV with x, hx), ?_⟩
    intros φ φIn
    obtain ⟨_, φW⟩ := dualAnnihilator.membership.forward with φIn
    exact φW with x, hx

-- The transpose of an injective map is surjective and conversely
-- (LinearMap.dualMap_surjective_iff, dualMap_injective_iff).
theorem dualMap.surjective_iff (W f : Set)
  requires finiteW : FiniteDimensional(W, K)
  requires linear : LinearMap(f, V, K, W)
  shows SurjectiveBetween(dualMap(f, V, K, W), linearForms(W, K),
      linearForms(V, K)) ↔ InjectiveBetween(f, V.carrier, W.carrier)
proof
  have comm := Field.to_comm_ring with field
  have ringK := CommRing.to_ring with comm
  have moduleW := LinearMap.target_module_of with linear
  have fsL := dualMap.linear at K, V, W, f with comm, module, linear
  have values := dualMap.values at V, K, W, f with linear
  have fsF := dualMap.graph_function at f, V, K, W with values
  constructor
  . intro surj
    have fF := LinearMap.function_of with linear
    apply Injective.of_pointwise with fF
    intros x xIn y yIn same
    have free := FiniteDimensional.finite_free at K, V with field, module, finiteDimensional
    obtain ⟨I, b, finite, basis⟩ := free
    apply dualFamily.vector_ext at K, V, I, b, x, y with comm, module, finite, basis, xIn, yIn
    intros i hi
    have dvals := dualFamily.values at K, V, I, b with comm, module, finite, basis
    have e := dualFamily.graph_apply at V, K, I, b, i with dvals, hi
    have eIn := dvals with i, hi
    obtain ⟨ψ, ψIn, ψe⟩ := Surjective.apply_exists with surj, eIn
    have a1 := dualMap.value_apply with linear, ψIn, xIn
    have a2 := dualMap.value_apply with linear, ψIn, yIn
    rw [e, ← ψe, a1, a2, same]
  . intro inj
    have dualV := dualModule.module at K, V with comm, module
    have dualW := dualModule.module at K, W with comm, moduleW
    have carrierV := dualModule.carrierOf at K, V with comm, module
    have carrierW := dualModule.carrierOf at K, W with comm, moduleW
    obtain ⟨fdW, rankW⟩ := dualModule.finite_dimensional at K, W with field, moduleW, finiteW
    obtain ⟨fdV, rankV⟩ := dualModule.finite_dimensional at K, V with field, module, finiteDimensional
    have rn := LinearMap.rank_nullity at K, dualModule(W, K), dualModule(V, K), dualMap(f, V, K, W) with field, dualW, fdW, fsL
    have kerEq : linearKernel(dualMap(f, V, K, W), dualModule(W, K), dualModule(V, K)) = dualAnnihilator(W, K, linearRange(f, V, W))
      ext φ
      constructor
      . intro hφ
        obtain ⟨φD, zero⟩ := linearKernel.membership.forward with hφ
        rw carrierW at φD
        apply dualAnnihilator.membership.backward
        refine ⟨φD, ?_⟩
        intros w wR
        obtain ⟨_, v, vIn, fv⟩ := linearRange.membership.forward with wR
        have a1 := dualMap.value_apply with linear, φD, vIn
        have z := dualModule.zero_apply at K, V, v with comm, module, vIn
        rw [← fv, ← a1, zero, z]
      . intro hφ
        obtain ⟨φIn, φR⟩ := dualAnnihilator.membership.forward with hφ
        apply linearKernel.membership.backward
        have φD : φ ∈ Module.carrier(dualModule(W, K))
          rw carrierW
          exact φIn
        refine ⟨φD, ?_⟩
        have i1 := FunctionBetween.apply_closed with fsF, φIn
        have zIn := dualModule.zero_mem at K, V with comm, module
        have l1 := linearForms.linear_of with i1
        have l2 := linearForms.linear_of with zIn
        apply LinearMap.ext with l1, l2
        intros v vIn
        have fvIn := LinearMap.value_mem with linear, vIn
        have fvR : f(v) ∈ linearRange(f, V, W)
          apply linearRange.membership.backward
          exact ⟨fvIn, v, vIn, rfl⟩
        have a1 := dualMap.value_apply with linear, φIn, vIn
        have z1 := φR with f(v), fvR
        have z2 := dualModule.zero_apply at K, V, v with comm, module, vIn
        rw [a1, z1, z2]
    have kerSub := LinearMap.kernel_submodule at K, dualModule(W, K), dualModule(V, K), dualMap(f, V, K, W) with ringK, dualW, dualV, fsL
    rw kerEq at kerSub
    rw kerEq at rn
    have rangeF := LinearMap.range_submodule at K, V, W, f with ringK, module, moduleW, linear
    have af := dualAnnihilator.finrank at K, W, linearRange(f, V, W) with field, moduleW, finiteW, rangeF
    have ir := LinearMap.injective_range_finrank at K, V, W, f with field, module, finiteDimensional, linear, inj
    have rangeFs := LinearMap.range_submodule at K, dualModule(W, K), dualModule(V, K), dualMap(f, V, K, W) with ringK, dualW, dualV, fsL
    obtain ⟨fd1, _⟩ := SubmoduleOf.finite_dimensional at K, dualModule(W, K), dualAnnihilator(W, K, linearRange(f, V, W)) with field, dualW, fdW, kerSub
    obtain ⟨fd2, _⟩ := SubmoduleOf.finite_dimensional at K, dualModule(V, K), linearRange(dualMap(f, V, K, W), dualModule(W, K), dualModule(V, K)) with field, dualV, fdV, rangeFs
    have sm1 := SubmoduleOf.submodule_module at K, dualModule(W, K), dualAnnihilator(W, K, linearRange(f, V, W)) with ringK, dualW, kerSub
    have sm2 := SubmoduleOf.submodule_module at K, dualModule(V, K), linearRange(dualMap(f, V, K, W), dualModule(W, K), dualModule(V, K)) with ringK, dualV, rangeFs
    have m1 := FiniteDimensional.finrank_member at K, submoduleModule(dualModule(W, K), K, dualAnnihilator(W, K, linearRange(f, V, W))) with field, sm1, fd1
    have m2 := FiniteDimensional.finrank_member at K, submoduleModule(dualModule(V, K), K, linearRange(dualMap(f, V, K, W), dualModule(W, K), dualModule(V, K))) with field, sm2, fd2
    have m3 := FiniteDimensional.finrank_member at K, V with field, module, finiteDimensional
    have m4 := FiniteDimensional.finrank_member at K, W with field, moduleW, finiteW
    have n1 := nat.omega.backward with m1
    have n2 := nat.omega.backward with m2
    have n3 := nat.omega.backward with m3
    have n4 := nat.omega.backward with m4
    rw [rankW] at rn
    rw [ir] at af
    have same : finrank(submoduleModule(dualModule(V, K), K, linearRange(dualMap(f, V, K, W), dualModule(W, K), dualModule(V, K))), K) = finrank(dualModule(V, K), K)
      rw rankV
      arith
    have eq := SubmoduleOf.eq_of_finrank_eq at K, dualModule(V, K), linearRange(dualMap(f, V, K, W), dualModule(W, K), dualModule(V, K)) with field, dualV, fdV, rangeFs, same
    have surjIff := LinearMap.surjective_iff_range at K, dualModule(W, K), dualModule(V, K), dualMap(f, V, K, W) with ringK, dualW, dualV, fsL
    have s := surjIff.backward with eq
    rw [carrierW, carrierV] at s
    exact s

theorem dualMap.injective_iff (W f : Set)
  requires finiteW : FiniteDimensional(W, K)
  requires linear : LinearMap(f, V, K, W)
  shows InjectiveBetween(dualMap(f, V, K, W), linearForms(W, K),
      linearForms(V, K)) ↔ SurjectiveBetween(f, V.carrier, W.carrier)
proof
  have comm := Field.to_comm_ring with field
  have ringK := CommRing.to_ring with comm
  have parts := Field.parts with field
  obtain ⟨_, nontrivialParts, _⟩ := parts
  obtain ⟨_, _, nontrivial⟩ := nontrivialParts
  have moduleW := LinearMap.target_module_of with linear
  have values := dualMap.values at V, K, W, f with linear
  have fsF := dualMap.graph_function at f, V, K, W with values
  have rangeF := LinearMap.range_submodule at K, V, W, f with ringK, module, moduleW, linear
  constructor
  . intro inj
    have fF := LinearMap.function_of with linear
    apply Surjective.of_pointwise with fF
    intros w wIn
    by_contra none
    have notIn : w ∉ linearRange(f, V, W)
      intro h
      obtain ⟨_, v, vIn, fv⟩ := linearRange.membership.forward with h
      apply none
      exact ⟨v, vIn, fv⟩
    obtain ⟨φ, φIn, φR, φw⟩ := dualAnnihilator.separates at K, W, linearRange(f, V, W), w with field, moduleW, finiteW, rangeF, wIn, notIn
    have zIn := dualModule.zero_mem at K, W with comm, moduleW
    have i1 := FunctionBetween.apply_closed with fsF, φIn
    have i2 := FunctionBetween.apply_closed with fsF, zIn
    have l1 := linearForms.linear_of with i1
    have l2 := linearForms.linear_of with i2
    have same : dualMap(f, V, K, W)(φ) = dualMap(f, V, K, W)(Module.zero(dualModule(W, K)))
      apply LinearMap.ext with l1, l2
      intros v vIn
      have fvIn := LinearMap.value_mem with linear, vIn
      have fvR : f(v) ∈ linearRange(f, V, W)
        apply linearRange.membership.backward
        exact ⟨fvIn, v, vIn, rfl⟩
      have a1 := dualMap.value_apply with linear, φIn, vIn
      have a2 := dualMap.value_apply with linear, zIn, vIn
      have z1 := φR with f(v), fvR
      have z2 := dualModule.zero_apply at K, W, f(v) with comm, moduleW, fvIn
      rw [a1, a2, z1, z2]
    have eq := InjectiveBetween.apply_cancel with inj, φIn, zIn, same
    have z3 := dualModule.zero_apply at K, W, w with comm, moduleW, wIn
    rw eq at φw
    rw z3 at φw
    apply nontrivial
    exact φw
  . intro surj
    exact dualMap.injective_of_surjective at K, V, W, f with comm, module, linear, surj

end VectorSpaces

section Bilinear
variable (R : Set)
hypothesis ring : CommRing(R)

theorem BilinearMap.zero_left (B M N P x : Set)
  requires bilinear : BilinearMap(B, M, N, P, R)
  requires vector : x ∈ Module.carrier(N)
  shows B((Module.zero(M), x)) = Module.zero(P)
proof
  have ringR := CommRing.to_ring with ring
  obtain ⟨mM, mN, mP, Bf, addL, addR, smulLR⟩ := bilinear
  have zeroIn := Module.zero_mem at R, M with ringR, mM
  have zeroR := Ring.zero_mem at R with ringR
  have s := smul_zero at R, M, Ring.zero(R) with *
  have e := smulLR with Ring.zero(R), zeroR, Module.zero(M), zeroIn, x, vector
  obtain ⟨left, _⟩ := e
  rw s at left
  have pairIn := product.pair at Module.zero(M), x, Module.carrier(M), Module.carrier(N) with zeroIn, vector
  have bIn := FunctionBetween.apply_closed with Bf, pairIn
  have z := zero_smul at R, P, B((Module.zero(M), x)) with *
  rw z at left
  exact left

theorem BilinearMap.zero_right (B M N P v : Set)
  requires bilinear : BilinearMap(B, M, N, P, R)
  requires vector : v ∈ Module.carrier(M)
  shows B((v, Module.zero(N))) = Module.zero(P)
proof
  have ringR := CommRing.to_ring with ring
  obtain ⟨mM, mN, mP, Bf, addL, addR, smulLR⟩ := bilinear
  have zeroIn := Module.zero_mem at R, N with ringR, mN
  have zeroR := Ring.zero_mem at R with ringR
  have s := smul_zero at R, N, Ring.zero(R) with *
  have e := smulLR with Ring.zero(R), zeroR, v, vector, Module.zero(N), zeroIn
  obtain ⟨_, right⟩ := e
  rw s at right
  have pairIn := product.pair at v, Module.zero(N), Module.carrier(M), Module.carrier(N) with vector, zeroIn
  have bIn := FunctionBetween.apply_closed with Bf, pairIn
  have z := zero_smul at R, P, B((v, Module.zero(N))) with *
  rw z at right
  exact right

-- LinearMap.compl₁₂ / composition: a linear map after a bilinear map is
-- bilinear.
theorem BilinearMap.compose_linear (B M N P Q f : Set)
  requires bilinear : BilinearMap(B, M, N, P, R)
  requires linear : LinearMap(f, P, R, Q)
  shows BilinearMap(compose(f, B, Module.carrier(M) × Module.carrier(N),
    Module.carrier(P), Module.carrier(Q)), M, N, Q, R)
proof
  have ringR := CommRing.to_ring with ring
  obtain ⟨mM, mN, mP, Bf, addL, addR, smulLR⟩ := bilinear
  have mQ := LinearMap.target_module_of with linear
  have fF := LinearMap.function_of with linear
  obtain ⟨_, _, _, fAdd, fSmul⟩ := linear
  have cF := compose.function at f, B, Module.carrier(M) × Module.carrier(N), Module.carrier(P), Module.carrier(Q) with Bf, fF
  have ap : ∀ v ∈ Module.carrier(M), ∀ x ∈ Module.carrier(N), compose(f, B, Module.carrier(M) × Module.carrier(N), Module.carrier(P), Module.carrier(Q))((v, x)) = f(B((v, x)))
    intros v vIn x xIn
    have pairIn := product.pair at v, x, Module.carrier(M), Module.carrier(N) with vIn, xIn
    exact compose.apply at f, B, Module.carrier(M) × Module.carrier(N), Module.carrier(P), Module.carrier(Q), (v, x) with Bf, fF, pairIn
  have bIn : ∀ v ∈ Module.carrier(M), ∀ x ∈ Module.carrier(N), B((v, x)) ∈ Module.carrier(P)
    intros v vIn x xIn
    have pairIn := product.pair at v, x, Module.carrier(M), Module.carrier(N) with vIn, xIn
    exact FunctionBetween.apply_closed with Bf, pairIn
  unfold BilinearMap
  refine ⟨mM, mN, mQ, cF, ?_, ?_, ?_⟩
  . intros v vIn w wIn x xIn
    have sumIn := Module.add_mem at R, M, v, w with *
    have b1 := bIn with v, vIn, x, xIn
    have b2 := bIn with w, wIn, x, xIn
    have e1 := ap with call2(Module.add(M), v, w), sumIn, x, xIn
    have e2 := ap with v, vIn, x, xIn
    have e3 := ap with w, wIn, x, xIn
    have e4 := addL with v, vIn, w, wIn, x, xIn
    have e5 := fAdd with B((v, x)), b1, B((w, x)), b2
    rw [e1, e2, e3, e4, e5]
  . intros v vIn x xIn y yIn
    have sumIn := Module.add_mem at R, N, x, y with *
    have b1 := bIn with v, vIn, x, xIn
    have b2 := bIn with v, vIn, y, yIn
    have e1 := ap with v, vIn, call2(Module.add(N), x, y), sumIn
    have e2 := ap with v, vIn, x, xIn
    have e3 := ap with v, vIn, y, yIn
    have e4 := addR with v, vIn, x, xIn, y, yIn
    have e5 := fAdd with B((v, x)), b1, B((v, y)), b2
    rw [e1, e2, e3, e4, e5]
  . intros r rIn v vIn x xIn
    have b1 := bIn with v, vIn, x, xIn
    have p1 := Module.smul_mem at R, M, r, v with *
    have p2 := Module.smul_mem at R, N, r, x with *
    have e1 := ap with call2(Module.smul(M), r, v), p1, x, xIn
    have e2 := ap with v, vIn, call2(Module.smul(N), r, x), p2
    have e3 := ap with v, vIn, x, xIn
    obtain ⟨s1, s2⟩ := smulLR with r, rIn, v, vIn, x, xIn
    have e5 := fSmul with r, rIn, B((v, x)), b1
    rw [e1, e2, e3, s1, s2, e5]
    exact ⟨rfl, rfl⟩

theorem pairingSlice.mem (B M N : Set)
  requires bilinear : BilinearMap(B, M, N, selfModule(R), R)
  shows ∀ v ∈ Module.carrier(M), pairingSlice(B, N, R, v) ∈ linearForms(N, R)
proof
  have ringR := CommRing.to_ring with ring
  have selfM := Ring.to_module with ringR
  have selfCarrier := selfModule.carrier_eq at R
  obtain ⟨mM, mN, mS, Bf, addL, addR, smulLR⟩ := bilinear
  have bIn : ∀ v ∈ Module.carrier(M), ∀ x ∈ Module.carrier(N), B((v, x)) ∈ Ring.carrier(R)
    intros v vIn x xIn
    have pairIn := product.pair at v, x, Module.carrier(M), Module.carrier(N) with vIn, xIn
    have c := FunctionBetween.apply_closed with Bf, pairIn
    rw selfCarrier at c
    exact c
  have sliceApply : ∀ v ∈ Module.carrier(M), ∀ x ∈ Module.carrier(N), pairingSlice(B, N, R, v)(x) = B((v, x))
    intros v vIn x xIn
    have vals : ∀ y ∈ Module.carrier(N), B((v, y)) ∈ Ring.carrier(R)
      intros y yIn
      exact bIn with v, vIn, y, yIn
    exact pairingSlice.graph_apply at B, N, R, v, x with vals, xIn
  have values : ∀ v ∈ Module.carrier(M), pairingSlice(B, N, R, v) ∈ linearForms(N, R)
    intros v vIn
    have vals : ∀ y ∈ Module.carrier(N), B((v, y)) ∈ Ring.carrier(R)
      intros y yIn
      exact bIn with v, vIn, y, yIn
    have sF := pairingSlice.graph_function at B, N, R, v with vals
    have fn : pairingSlice(B, N, R, v) : Module.carrier(N) → Module.carrier(selfModule(R))
      rw selfCarrier
      exact sF
    have additive : ∀ x y ∈ Module.carrier(N), pairingSlice(B, N, R, v)(call2(Module.add(N), x, y)) = call2(Module.add(selfModule(R)), pairingSlice(B, N, R, v)(x), pairingSlice(B, N, R, v)(y))
      intros x xIn y yIn
      have sumIn := Module.add_mem at R, N, x, y with *
      have e1 := sliceApply with v, vIn, call2(Module.add(N), x, y), sumIn
      have e2 := sliceApply with v, vIn, x, xIn
      have e3 := sliceApply with v, vIn, y, yIn
      have e4 := addR with v, vIn, x, xIn, y, yIn
      rw [e1, e2, e3, e4]
    have homogeneous : ∀ r ∈ Ring.carrier(R), ∀ x ∈ Module.carrier(N), pairingSlice(B, N, R, v)(call2(Module.smul(N), r, x)) = call2(Module.smul(selfModule(R)), r, pairingSlice(B, N, R, v)(x))
      intros r rIn x xIn
      have prodIn := Module.smul_mem at R, N, r, x with *
      have e1 := sliceApply with v, vIn, call2(Module.smul(N), r, x), prodIn
      have e2 := sliceApply with v, vIn, x, xIn
      obtain ⟨_, e4⟩ := smulLR with r, rIn, v, vIn, x, xIn
      rw [e1, e2, e4]
    have lin := LinearMap.of_laws with mN, selfM, fn, additive, homogeneous
    exact linearForms.of_linear_map with lin
  exact values

theorem pairingLeft.apply_of (B M N v x : Set)
  requires bilinear : BilinearMap(B, M, N, selfModule(R), R)
  requires first : v ∈ Module.carrier(M)
  requires second : x ∈ Module.carrier(N)
  shows pairingLeft(B, M, R, N)(v)(x) = B((v, x))
proof
  have values := pairingSlice.mem at R, B, M, N with ring, bilinear
  obtain ⟨mM, mN, mS, Bf, _⟩ := bilinear
  have vals : ∀ y ∈ Module.carrier(N), B((v, y)) ∈ Ring.carrier(R)
    intros y yIn
    have pairIn := product.pair at v, y, Module.carrier(M), Module.carrier(N) with first, yIn
    have c := FunctionBetween.apply_closed with Bf, pairIn
    rw selfModule.carrier_eq at c
    exact c
  have e1 := pairingLeft.graph_apply at B, M, R, N, v with values, first
  have e2 := pairingSlice.graph_apply at B, N, R, v, x with vals, second
  rw [e1, e2]

theorem pairingLeft.linear (B M N : Set)
  requires bilinear : BilinearMap(B, M, N, selfModule(R), R)
  shows LinearMap(pairingLeft(B, M, R, N), M, R, dualModule(N, R))
proof
  have ringR := CommRing.to_ring with ring
  have selfM := Ring.to_module with ringR
  have selfCarrier := selfModule.carrier_eq at R
  obtain ⟨mM, mN, mS, Bf, addL, addR, smulLR⟩ := bilinear
  have bIn : ∀ v ∈ Module.carrier(M), ∀ x ∈ Module.carrier(N), B((v, x)) ∈ Ring.carrier(R)
    intros v vIn x xIn
    have pairIn := product.pair at v, x, Module.carrier(M), Module.carrier(N) with vIn, xIn
    have c := FunctionBetween.apply_closed with Bf, pairIn
    rw selfCarrier at c
    exact c
  have sliceApply : ∀ v ∈ Module.carrier(M), ∀ x ∈ Module.carrier(N), pairingSlice(B, N, R, v)(x) = B((v, x))
    intros v vIn x xIn
    have vals : ∀ y ∈ Module.carrier(N), B((v, y)) ∈ Ring.carrier(R)
      intros y yIn
      exact bIn with v, vIn, y, yIn
    exact pairingSlice.graph_apply at B, N, R, v, x with vals, xIn
  have values : ∀ v ∈ Module.carrier(M), pairingSlice(B, N, R, v) ∈ linearForms(N, R)
    intros v vIn
    have vals : ∀ y ∈ Module.carrier(N), B((v, y)) ∈ Ring.carrier(R)
      intros y yIn
      exact bIn with v, vIn, y, yIn
    have sF := pairingSlice.graph_function at B, N, R, v with vals
    have fn : pairingSlice(B, N, R, v) : Module.carrier(N) → Module.carrier(selfModule(R))
      rw selfCarrier
      exact sF
    have additive : ∀ x y ∈ Module.carrier(N), pairingSlice(B, N, R, v)(call2(Module.add(N), x, y)) = call2(Module.add(selfModule(R)), pairingSlice(B, N, R, v)(x), pairingSlice(B, N, R, v)(y))
      intros x xIn y yIn
      have sumIn := Module.add_mem at R, N, x, y with *
      have e1 := sliceApply with v, vIn, call2(Module.add(N), x, y), sumIn
      have e2 := sliceApply with v, vIn, x, xIn
      have e3 := sliceApply with v, vIn, y, yIn
      have e4 := addR with v, vIn, x, xIn, y, yIn
      rw [e1, e2, e3, e4]
    have homogeneous : ∀ r ∈ Ring.carrier(R), ∀ x ∈ Module.carrier(N), pairingSlice(B, N, R, v)(call2(Module.smul(N), r, x)) = call2(Module.smul(selfModule(R)), r, pairingSlice(B, N, R, v)(x))
      intros r rIn x xIn
      have prodIn := Module.smul_mem at R, N, r, x with *
      have e1 := sliceApply with v, vIn, call2(Module.smul(N), r, x), prodIn
      have e2 := sliceApply with v, vIn, x, xIn
      obtain ⟨_, e4⟩ := smulLR with r, rIn, v, vIn, x, xIn
      rw [e1, e2, e4]
    have lin := LinearMap.of_laws with mN, selfM, fn, additive, homogeneous
    exact linearForms.of_linear_map with lin
  have function := pairingLeft.graph_function at B, M, R, N with values
  have dualN := dualModule.module at R, N with ring, mN
  have carrierN := dualModule.carrierOf at R, N with ring, mN
  have fn : pairingLeft(B, M, R, N) : Module.carrier(M) → Module.carrier(dualModule(N, R))
    rw carrierN
    exact function
  have additive : ∀ v w ∈ Module.carrier(M), pairingLeft(B, M, R, N)(call2(Module.add(M), v, w)) = call2(Module.add(dualModule(N, R)), pairingLeft(B, M, R, N)(v), pairingLeft(B, M, R, N)(w))
    intros v vIn w wIn
    have sumIn := Module.add_mem at R, M, v, w with *
    have e1 := pairingLeft.graph_apply at B, M, R, N, call2(Module.add(M), v, w) with values, sumIn
    have e2 := pairingLeft.graph_apply at B, M, R, N, v with values, vIn
    have e3 := pairingLeft.graph_apply at B, M, R, N, w with values, wIn
    rw [e1, e2, e3]
    have svIn := values with v, vIn
    have swIn := values with w, wIn
    have ssIn := values with call2(Module.add(M), v, w), sumIn
    have rhsIn := dualModule.add_mem at R, N, pairingSlice(B, N, R, v), pairingSlice(B, N, R, w) with ring, mN, svIn, swIn
    have l1 := linearForms.linear_of with ssIn
    have l2 := linearForms.linear_of with rhsIn
    apply LinearMap.ext with l1, l2
    intros x xIn
    have a1 := sliceApply with call2(Module.add(M), v, w), sumIn, x, xIn
    have a2 := sliceApply with v, vIn, x, xIn
    have a3 := sliceApply with w, wIn, x, xIn
    have a4 := addL with v, vIn, w, wIn, x, xIn
    have a5 := dualModule.add_apply at R, N, pairingSlice(B, N, R, v), pairingSlice(B, N, R, w), x with ring, mN, svIn, swIn, xIn
    rw [a1, a4, a5, a2, a3, selfModule.add_eq]
  have homogeneous : ∀ r ∈ Ring.carrier(R), ∀ v ∈ Module.carrier(M), pairingLeft(B, M, R, N)(call2(Module.smul(M), r, v)) = call2(Module.smul(dualModule(N, R)), r, pairingLeft(B, M, R, N)(v))
    intros r rIn v vIn
    have prodIn := Module.smul_mem at R, M, r, v with *
    have e1 := pairingLeft.graph_apply at B, M, R, N, call2(Module.smul(M), r, v) with values, prodIn
    have e2 := pairingLeft.graph_apply at B, M, R, N, v with values, vIn
    rw [e1, e2]
    have svIn := values with v, vIn
    have ssIn := values with call2(Module.smul(M), r, v), prodIn
    have rhsIn := dualModule.smul_mem at R, N, r, pairingSlice(B, N, R, v) with ring, mN, rIn, svIn
    have l1 := linearForms.linear_of with ssIn
    have l2 := linearForms.linear_of with rhsIn
    apply LinearMap.ext with l1, l2
    intros x xIn
    have a1 := sliceApply with call2(Module.smul(M), r, v), prodIn, x, xIn
    have a2 := sliceApply with v, vIn, x, xIn
    obtain ⟨a4, _⟩ := smulLR with r, rIn, v, vIn, x, xIn
    have a5 := dualModule.smul_apply at R, N, r, pairingSlice(B, N, R, v), x with ring, mN, rIn, svIn, xIn
    rw [a1, a4, a5, a2, selfModule.smul_eq]
  exact LinearMap.of_laws with mM, dualN, fn, additive, homogeneous

end Bilinear

-- The pairing laws need pairingLeft.linear above, so the last theorem of
-- the vector-space section sits in a section of its own.
section Pairings
variable (K V : Set)
hypothesis field : Field(K)
hypothesis module : Module(V, K)
hypothesis finiteDimensional : FiniteDimensional(V, K)

-- A nondegenerate pairing of finite-dimensional spaces identifies V with
-- the dual of W.
theorem NondegeneratePairing.equiv (W B : Set)
  requires finiteW : FiniteDimensional(W, K)
  requires pairing : NondegeneratePairing(B, V, K, W)
  shows LinearEquiv(pairingLeft(B, V, K, W), V, K, dualModule(W, K)) ∧
    finrank(V, K) = finrank(W, K)
proof
  have comm := Field.to_comm_ring with field
  have ringK := CommRing.to_ring with comm
  have pairing0 := pairing
  obtain ⟨bil, left, right⟩ := pairing0
  have bil0 := bil
  obtain ⟨_, moduleW, selfM, _⟩ := bil0
  have PL := pairingLeft.linear at K, B, V, W with comm, bil
  have dualV := dualModule.module at K, V with comm, module
  have dualW := dualModule.module at K, W with comm, moduleW
  have carrierW := dualModule.carrierOf at K, W with comm, moduleW
  obtain ⟨fdW, rankW⟩ := dualModule.finite_dimensional at K, W with field, moduleW, finiteW
  obtain ⟨fdV, rankV⟩ := dualModule.finite_dimensional at K, V with field, module, finiteDimensional
  have PF := LinearMap.function_of with PL
  have trivP : ∀ v ∈ Module.carrier(V), pairingLeft(B, V, K, W)(v) = Module.zero(dualModule(W, K)) → v = Module.zero(V)
    intros v vIn zero
    apply left with v, vIn
    intros x xIn
    have a1 := pairingLeft.apply_of at K, B, V, W, v, x with comm, bil, vIn, xIn
    have z := dualModule.zero_apply at K, W, x with comm, moduleW, xIn
    rw [← a1, zero, z]
  have PInj := LinearMap.injective_of_zero at K, V, dualModule(W, K), pairingLeft(B, V, K, W) with ringK, PL, trivP
  have ddL := doubleDualMap.linear at K, W with comm, moduleW
  have PsL := dualMap.linear at K, V, dualModule(W, K), pairingLeft(B, V, K, W) with comm, module, PL
  have hL := LinearMap.compose at doubleDualMap(W, K), dualMap(pairingLeft(B, V, K, W), V, K, dualModule(W, K)), W, K, dualModule(dualModule(W, K), K), dualModule(V, K) with ddL, PsL
  have ddF := LinearMap.function_of with ddL
  have PsF := LinearMap.function_of with PsL
  have trivH : ∀ x ∈ Module.carrier(W), compose(dualMap(pairingLeft(B, V, K, W), V, K, dualModule(W, K)), doubleDualMap(W, K), Module.carrier(W), Module.carrier(dualModule(dualModule(W, K), K)), Module.carrier(dualModule(V, K)))(x) = Module.zero(dualModule(V, K)) → x = Module.zero(W)
    intros x xIn zero
    apply right with x, xIn
    intros v vIn
    have c1 := compose.apply at dualMap(pairingLeft(B, V, K, W), V, K, dualModule(W, K)), doubleDualMap(W, K), Module.carrier(W), Module.carrier(dualModule(dualModule(W, K), K)), Module.carrier(dualModule(V, K)), x with ddF, PsF, xIn
    rw c1 at zero
    have evValues : ∀ y ∈ Module.carrier(W), evaluationForm(W, K, y) ∈ linearForms(dualModule(W, K), K)
      intros y yIn
      have l := evaluationForm.linear at K, W, y with *
      exact linearForms.of_linear_map with l
    have c2 := doubleDualMap.graph_apply at W, K, x with evValues, xIn
    rw c2 at zero
    have evIn := evValues with x, xIn
    have c3 := dualMap.value_apply with PL, evIn, vIn
    have PvIn := FunctionBetween.apply_closed with PF, vIn
    rw carrierW at PvIn
    have c4 := evaluationForm.apply_of with xIn, PvIn
    have c5 := pairingLeft.apply_of at K, B, V, W, v, x with comm, bil, vIn, xIn
    have z := dualModule.zero_apply at K, V, v with comm, module, vIn
    rw [← c5, ← c4, ← c3, zero, z]
  have hInj := LinearMap.injective_of_zero at K, W, dualModule(V, K), compose(dualMap(pairingLeft(B, V, K, W), V, K, dualModule(W, K)), doubleDualMap(W, K), Module.carrier(W), Module.carrier(dualModule(dualModule(W, K), K)), Module.carrier(dualModule(V, K))) with ringK, hL, trivH
  have le1 := LinearMap.injective_finrank_le at K, V, dualModule(W, K), pairingLeft(B, V, K, W) with field, module, finiteDimensional, fdW, PL, PInj
  have le2 := LinearMap.injective_finrank_le at K, W, dualModule(V, K), compose(dualMap(pairingLeft(B, V, K, W), V, K, dualModule(W, K)), doubleDualMap(W, K), Module.carrier(W), Module.carrier(dualModule(dualModule(W, K), K)), Module.carrier(dualModule(V, K))) with field, moduleW, finiteW, fdV, hL, hInj
  rw rankW at le1
  rw rankV at le2
  have m3 := FiniteDimensional.finrank_member at K, V with field, module, finiteDimensional
  have m4 := FiniteDimensional.finrank_member at K, W with field, moduleW, finiteW
  have n3 := nat.omega.backward with m3
  have n4 := nat.omega.backward with m4
  have same : finrank(V, K) = finrank(W, K) by arith
  have sameD : finrank(V, K) = finrank(dualModule(W, K), K)
    rw rankW
    exact same
  have iff := LinearMap.injective_iff_surjective at K, V, dualModule(W, K), pairingLeft(B, V, K, W) with field, module, finiteDimensional, fdW, sameD, PL
  have PSurj := iff.forward with PInj
  have equiv := LinearEquiv.of_bijective with PL, ⟨PInj, PSurj⟩
  exact ⟨equiv, same⟩

end Pairings
