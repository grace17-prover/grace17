-- Morphisms of schemes and their properties: fibre products by their
-- universal property, with existence, the affine case Spec(A ⊗_R B), and
-- points of a fibre product; surjective, quasi-compact, affine and finite
-- morphisms; morphisms locally of finite type or presentation, flat,
-- smooth, étale and smooth of relative dimension n (affine-locally,
-- through the ring maps O_Y(U) → O_X(V)); open and closed immersions;
-- separated, universally closed and proper morphisms with the valuative
-- criterion; stability under composition and base change, and the
-- criteria for Spec of a ring map.
-- Part of the GRH blueprint.
-- Planned home: AlgebraicGeometry/Morphisms and AlgebraicGeometry/Pullbacks.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Scheme.Morphisms
import GRH.Scheme.Basic
import GRH.Algebra.DVR

-- Section: Morphisms of schemes and fibre products
-- The source and target of a morphism ((X, Y), (f, φ)).
def homSource (m : Set) : Set := fst(fst(m))

def homTarget (m : Set) : Set := snd(fst(m))

-- A morphism of schemes (Scheme.Hom).
predicate SchemeHom (m X Y : Set) := Scheme(X) ∧ Scheme(Y) ∧ LocallyRingedHom(m, X, Y)

-- (P, p₁, p₂) is a fibre product of f : X → S and g : Y → S
-- (IsPullback in the category of schemes): the square commutes and every
-- commuting square from a scheme Q factors uniquely. The quantifier over
-- schemes Q is a class quantifier of the formula; no set of all schemes
-- is formed.
predicate IsSchemePullback (P p1 p2 f g : Set) :=
  SchemeHom(f, homSource(f), homTarget(f)) ∧ SchemeHom(g, homSource(g), homTarget(f)) ∧
  SchemeHom(p1, P, homSource(f)) ∧ SchemeHom(p2, P, homSource(g)) ∧
  compositeHom(f, p1) = compositeHom(g, p2) ∧
  (∀ Q, ∀ q1, ∀ q2, SchemeHom(q1, Q, homSource(f)) → SchemeHom(q2, Q, homSource(g)) →
    compositeHom(f, q1) = compositeHom(g, q2) →
    (∃ u, SchemeHom(u, Q, P) ∧ compositeHom(p1, u) = q1 ∧ compositeHom(p2, u) = q2 ∧
      (∀ v, SchemeHom(v, Q, P) → compositeHom(p1, v) = q1 →
        compositeHom(p2, v) = q2 → v = u)))

-- Section: Properties of morphisms
-- Surjective on points (Surjective), quasi-compact (QuasiCompact:
-- preimages of quasi-compact opens are quasi-compact).
predicate SurjectiveHom (m : Set) :=
  SurjectiveBetween(homPoints(m), RingedSpace.points(homSource(m)),
    RingedSpace.points(homTarget(m)))

predicate QuasiCompactHom (m : Set) :=
  ∀ V ∈ RingedSpace.opens(homTarget(m)),
    IsCompact(RingedSpace.points(homTarget(m)), RingedSpace.opens(homTarget(m)), V) →
    IsCompact(RingedSpace.points(homSource(m)), RingedSpace.opens(homSource(m)),
      openPreimage(homSource(m), homPoints(m), V))

-- The ring map O_Y(U) → O_X(V) for V ⊆ f⁻¹(U) (Scheme.Hom.appLE), and the
-- O_Y(U)-algebra O_X(V) it makes.
def appLE (m U V : Set) : Set :=
  compose(RingedSpace.restriction(homSource(m))((openPreimage(homSource(m), homPoints(m), U), V)),
    homSheaf(m)(U), sectionsOf(homTarget(m), U),
    sectionsOf(homSource(m), openPreimage(homSource(m), homPoints(m), U)),
    sectionsOf(homSource(m), V))

def appLEAlgebra (m U V : Set) : Set :=
  Algebra.mk(RingedSpace.sections(homTarget(m))(U), RingedSpace.sections(homSource(m))(V),
    appLE(m, U, V))

-- U ⊆ Y and V ⊆ f⁻¹(U) ⊆ X affine opens.
predicate AffinePair (m U V : Set) :=
  IsAffineOpen(homTarget(m), U) ∧ IsAffineOpen(homSource(m), V) ∧
  V ⊆ openPreimage(homSource(m), homPoints(m), U)

-- Affine-local properties (HasRingHomProperty with affineLocally): the
-- ring maps of all affine pairs have the property.
predicate LocallyOfFiniteType (m : Set) :=
  ∀ U ∈ RingedSpace.opens(homTarget(m)), ∀ V ∈ RingedSpace.opens(homSource(m)),
    AffinePair(m, U, V) → FiniteTypeAlgebra(appLEAlgebra(m, U, V))

predicate LocallyOfFinitePresentation (m : Set) :=
  ∀ U ∈ RingedSpace.opens(homTarget(m)), ∀ V ∈ RingedSpace.opens(homSource(m)),
    AffinePair(m, U, V) → FinitePresentationAlgebra(appLEAlgebra(m, U, V))

predicate FlatHom (m : Set) :=
  ∀ U ∈ RingedSpace.opens(homTarget(m)), ∀ V ∈ RingedSpace.opens(homSource(m)),
    AffinePair(m, U, V) → FlatAlgebra(appLEAlgebra(m, U, V))

predicate SmoothHom (m : Set) :=
  ∀ U ∈ RingedSpace.opens(homTarget(m)), ∀ V ∈ RingedSpace.opens(homSource(m)),
    AffinePair(m, U, V) → SmoothAlgebra(appLEAlgebra(m, U, V))

predicate EtaleHom (m : Set) :=
  ∀ U ∈ RingedSpace.opens(homTarget(m)), ∀ V ∈ RingedSpace.opens(homSource(m)),
    AffinePair(m, U, V) → EtaleAlgebra(appLEAlgebra(m, U, V))

-- Smooth of relative dimension n: every point has affine neighbourhoods
-- V ⊆ f⁻¹(U) on which O_Y(U) → O_X(V) is standard smooth of relative
-- dimension n (SmoothOfRelativeDimension, through
-- IsStandardSmoothOfRelativeDimension).
predicate SmoothOfRelativeDimension (m : Set, n : Nat) :=
  ∀ x ∈ RingedSpace.points(homSource(m)),
    ∃ U ∈ RingedSpace.opens(homTarget(m)), ∃ V ∈ RingedSpace.opens(homSource(m)),
      x ∈ V ∧ AffinePair(m, U, V) ∧ StandardSmooth(appLEAlgebra(m, U, V), n)

-- Affine morphisms: preimages of affine opens are affine (IsAffineHom);
-- finite morphisms: affine with O_Y(U) → O_X(f⁻¹U) finite (IsFinite).
predicate IsAffineHom (m : Set) :=
  ∀ U ∈ RingedSpace.opens(homTarget(m)), IsAffineOpen(homTarget(m), U) →
    IsAffineOpen(homSource(m), openPreimage(homSource(m), homPoints(m), U))

predicate IsFiniteHom (m : Set) :=
  IsAffineHom(m) ∧ (∀ U ∈ RingedSpace.opens(homTarget(m)), IsAffineOpen(homTarget(m), U) →
    FiniteAlgebra(appLEAlgebra(m, U, openPreimage(homSource(m), homPoints(m), U))))

-- Open immersions: an open embedding on points with isomorphisms on
-- stalks (IsOpenImmersion); closed immersions: a closed embedding on
-- points with surjections on stalks (IsClosedImmersion).
predicate IsOpenImmersion (m : Set) :=
  InjectiveBetween(homPoints(m), RingedSpace.points(homSource(m)),
    RingedSpace.points(homTarget(m))) ∧
  OpenMap(homPoints(m), RingedSpace.points(homSource(m)), RingedSpace.opens(homSource(m)),
    RingedSpace.points(homTarget(m)), RingedSpace.opens(homTarget(m))) ∧
  (∀ x ∈ RingedSpace.points(homSource(m)), RingIso(stalkMap(m, x),
    stalk(homTarget(m), homPoints(m)(x)), stalk(homSource(m), x)))

predicate IsClosedImmersion (m : Set) :=
  InjectiveBetween(homPoints(m), RingedSpace.points(homSource(m)),
    RingedSpace.points(homTarget(m))) ∧
  ClosedMap(homPoints(m), RingedSpace.points(homSource(m)), RingedSpace.opens(homSource(m)),
    RingedSpace.points(homTarget(m)), RingedSpace.opens(homTarget(m))) ∧
  (∀ x ∈ RingedSpace.points(homSource(m)), SurjectiveBetween(stalkMap(m, x),
    Ring.carrier(stalk(homTarget(m), homPoints(m)(x))), Ring.carrier(stalk(homSource(m), x))))

-- Separated: for affine W ⊆ Y and affine U, V ⊆ f⁻¹(W), U ∩ V is affine
-- and O(U) ⊗_{O(W)} O(V) → O(U ∩ V) is onto (IsSeparated; the
-- equivalence with a closed diagonal is IsSeparated.diagonal below).
-- The map O(U) ⊗_{O(W)} O(V) → O(U ∩ V), u ⊗ v ↦ u|_{U∩V} v|_{U∩V}.
def overlapTensorMap (m W U V : Set) : Set :=
  productMap(appLEAlgebra(m, W, U), appLEAlgebra(m, W, V),
    appLEAlgebra(m, W, U ∩ V),
    RingedSpace.restriction(homSource(m))((U, U ∩ V)),
    RingedSpace.restriction(homSource(m))((V, U ∩ V)))

predicate IsSeparated (m : Set) :=
  ∀ W ∈ RingedSpace.opens(homTarget(m)), ∀ U ∈ RingedSpace.opens(homSource(m)),
    ∀ V ∈ RingedSpace.opens(homSource(m)), AffinePair(m, W, U) → AffinePair(m, W, V) →
      IsAffineOpen(homSource(m), U ∩ V) ∧
      SurjectiveBetween(overlapTensorMap(m, W, U, V),
        Ring.carrier(algebraTensorRing(appLEAlgebra(m, W, U), appLEAlgebra(m, W, V))),
        sectionsOf(homSource(m), U ∩ V))

-- Universally closed: every base change is closed on points
-- (UniversallyClosed); proper: separated, universally closed and locally
-- of finite type (IsProper).
predicate UniversallyClosed (m : Set) :=
  ∀ g, ∀ P, ∀ p1, ∀ p2, IsSchemePullback(P, p1, p2, m, g) →
    ClosedMap(homPoints(p2), RingedSpace.points(P), RingedSpace.opens(P),
      RingedSpace.points(homSource(g)), RingedSpace.opens(homSource(g)))

predicate IsProper (m : Set) :=
  IsSeparated(m) ∧ UniversallyClosed(m) ∧ LocallyOfFiniteType(m)

-- Dominant: the image is dense (IsDominant).
predicate IsDominant (m : Set) :=
  IsDense(RingedSpace.points(homTarget(m)), RingedSpace.opens(homTarget(m)),
    functionImage(homPoints(m), RingedSpace.points(homSource(m)),
      RingedSpace.points(homTarget(m))))

-- A reduced scheme: every ring of sections is reduced (IsReduced).
predicate ReducedScheme (X : Set) :=
  Scheme(X) ∧ (∀ U ∈ RingedSpace.opens(X), ReducedRing(RingedSpace.sections(X)(U)))

-- The valuative lifting property for one valuation ring V
-- (ValuativeCriterion.Existence): every square Spec K → X, Spec V → Y over
-- f, with K the fraction field of V, has a diagonal lift Spec V → X.
def fractionInclusion (V : Set) : Set :=
  specMap(localizationMap(V, nonZeroDivisors(V)), V, fractionRing(V))

predicate ValuativeLifting (m V : Set) :=
  ValuationRing(V) ∧
  (∀ a, ∀ b, SchemeHom(a, Spec(fractionRing(V)), homSource(m)) →
    SchemeHom(b, Spec(V), homTarget(m)) →
    compositeHom(m, a) = compositeHom(b, fractionInclusion(V)) →
    (∃ l, SchemeHom(l, Spec(V), homSource(m)) ∧
      compositeHom(l, fractionInclusion(V)) = a ∧ compositeHom(m, l) = b))

-- Section: Fibre products
-- Fibre products of schemes exist (Scheme.Pullback, HasPullbacks), are
-- unique up to isomorphism, and are symmetric.
theorem IsSchemePullback.exists (f g : Set)
  requires first : SchemeHom(f, homSource(f), homTarget(f))
  requires second : SchemeHom(g, homSource(g), homTarget(f))
  shows ∃ P, ∃ p1, ∃ p2, IsSchemePullback(P, p1, p2, f, g)
proof
  sorry

theorem IsSchemePullback.unique (P p1 p2 Q q1 q2 f g : Set)
  requires first : IsSchemePullback(P, p1, p2, f, g)
  requires second : IsSchemePullback(Q, q1, q2, f, g)
  shows ∃ u, LocallyRingedIso(u, Q, P) ∧ compositeHom(p1, u) = q1 ∧
    compositeHom(p2, u) = q2
proof
  sorry

theorem IsSchemePullback.flip (P p1 p2 f g : Set)
  requires pullback : IsSchemePullback(P, p1, p2, f, g)
  shows IsSchemePullback(P, p2, p1, g, f)
proof
  sorry

-- Pasting of pullback squares (IsPullback.paste_horiz for schemes): the
-- base change of a base change is a base change of the composite.
theorem IsSchemePullback.paste (P p1 p2 Q q1 q2 f g h : Set)
  requires right : IsSchemePullback(P, p1, p2, f, g)
  requires left : IsSchemePullback(Q, q1, q2, p2, h)
  shows IsSchemePullback(Q, compositeHom(p1, q1), q2, f, compositeHom(g, h))
proof
  sorry

-- The affine case: Spec(B ⊗_A D) is the fibre product of Spec B and
-- Spec D over Spec A (pullbackSpecIso).
theorem IsSchemePullback.spec_tensor (B D : Set)
  requires first : Algebra(B)
  requires second : Algebra(D)
  requires sameBase : Algebra.base(B) = Algebra.base(D)
  shows IsSchemePullback(Spec(algebraTensorRing(B, D)),
    specMap(includeLeft(B, D), Algebra.ring(B), algebraTensorRing(B, D)),
    specMap(includeRight(B, D), Algebra.ring(D), algebraTensorRing(B, D)),
    specMap(Algebra.map(B), Algebra.base(B), Algebra.ring(B)),
    specMap(Algebra.map(D), Algebra.base(D), Algebra.ring(D)))
proof
  sorry

-- Points of a fibre product: over x ∈ X and y ∈ Y with the same image in S
-- lies a point of P (Scheme.Pullback.exists_preimage_pullback).
theorem IsSchemePullback.exists_point (P p1 p2 f g x y : Set)
  requires pullback : IsSchemePullback(P, p1, p2, f, g)
  requires first : x ∈ RingedSpace.points(homSource(f))
  requires second : y ∈ RingedSpace.points(homSource(g))
  requires same : homPoints(f)(x) = homPoints(g)(y)
  shows ∃ z ∈ RingedSpace.points(P), homPoints(p1)(z) = x ∧ homPoints(p2)(z) = y
proof
  sorry

-- Section: Composition
theorem SchemeHom.comp (m n X Y Z : Set)
  requires first : SchemeHom(m, X, Y)
  requires second : SchemeHom(n, Y, Z)
  shows SchemeHom(compositeHom(n, m), X, Z)
proof
  sorry

theorem SchemeHom.endpoints (m X Y : Set)
  requires hom : SchemeHom(m, X, Y)
  shows homSource(m) = X ∧ homTarget(m) = Y
proof
  sorry

section Composition
variable (m n X Y Z : Set)
hypothesis first : SchemeHom(m, X, Y)
hypothesis second : SchemeHom(n, Y, Z)

theorem SurjectiveHom.comp
  requires surjM : SurjectiveHom(m)
  requires surjN : SurjectiveHom(n)
  shows SurjectiveHom(compositeHom(n, m))
proof
  sorry

-- Surjective.of_comp: if n ∘ m is surjective, so is n.
theorem SurjectiveHom.of_comp
  requires surjective : SurjectiveHom(compositeHom(n, m))
  shows SurjectiveHom(n)
proof
  sorry

theorem FlatHom.comp
  requires flatM : FlatHom(m)
  requires flatN : FlatHom(n)
  shows FlatHom(compositeHom(n, m))
proof
  sorry

theorem LocallyOfFiniteType.comp
  requires typeM : LocallyOfFiniteType(m)
  requires typeN : LocallyOfFiniteType(n)
  shows LocallyOfFiniteType(compositeHom(n, m))
proof
  sorry

-- smoothOfRelativeDimension_comp: relative dimensions add.
theorem SmoothOfRelativeDimension.comp (j k : Nat)
  requires smoothM : SmoothOfRelativeDimension(m, j)
  requires smoothN : SmoothOfRelativeDimension(n, k)
  shows SmoothOfRelativeDimension(compositeHom(n, m), j + k)
proof
  sorry

theorem IsClosedImmersion.comp
  requires closedM : IsClosedImmersion(m)
  requires closedN : IsClosedImmersion(n)
  shows IsClosedImmersion(compositeHom(n, m))
proof
  sorry

theorem IsOpenImmersion.comp
  requires openM : IsOpenImmersion(m)
  requires openN : IsOpenImmersion(n)
  shows IsOpenImmersion(compositeHom(n, m))
proof
  sorry

theorem IsSeparated.comp
  requires sepM : IsSeparated(m)
  requires sepN : IsSeparated(n)
  shows IsSeparated(compositeHom(n, m))
proof
  sorry

theorem UniversallyClosed.comp
  requires closedM : UniversallyClosed(m)
  requires closedN : UniversallyClosed(n)
  shows UniversallyClosed(compositeHom(n, m))
proof
  sorry

theorem IsProper.comp
  requires properM : IsProper(m)
  requires properN : IsProper(n)
  shows IsProper(compositeHom(n, m))
proof
  sorry

-- IsProper.of_comp: if n ∘ m is proper and n separated, m is proper.
theorem IsProper.of_comp
  requires proper : IsProper(compositeHom(n, m))
  requires separated : IsSeparated(n)
  shows IsProper(m)
proof
  sorry

-- If n ∘ m is separated, so is m (IsSeparated.of_comp).
theorem IsSeparated.of_comp
  requires separated : IsSeparated(compositeHom(n, m))
  shows IsSeparated(m)
proof
  sorry

end Composition

-- Section: Base change
-- Properties stable under base change: in a pullback square of f along g,
-- the projection p₂ : P → Y inherits the property of f
-- (MorphismProperty.IsStableUnderBaseChange).
section BaseChange
variable (P p1 p2 f g : Set)
hypothesis pullback : IsSchemePullback(P, p1, p2, f, g)

theorem SurjectiveHom.base_change
  requires surjective : SurjectiveHom(f)
  shows SurjectiveHom(p2)
proof
  sorry

theorem FlatHom.base_change
  requires flat : FlatHom(f)
  shows FlatHom(p2)
proof
  sorry

theorem LocallyOfFiniteType.base_change
  requires finiteType : LocallyOfFiniteType(f)
  shows LocallyOfFiniteType(p2)
proof
  sorry

-- smoothOfRelativeDimension_isStableUnderBaseChange.
theorem SmoothOfRelativeDimension.base_change (n : Nat)
  requires smooth : SmoothOfRelativeDimension(f, n)
  shows SmoothOfRelativeDimension(p2, n)
proof
  sorry

theorem EtaleHom.base_change
  requires etale : EtaleHom(f)
  shows EtaleHom(p2)
proof
  sorry

theorem IsClosedImmersion.base_change
  requires closed : IsClosedImmersion(f)
  shows IsClosedImmersion(p2)
proof
  sorry

theorem IsOpenImmersion.base_change
  requires open : IsOpenImmersion(f)
  shows IsOpenImmersion(p2)
proof
  sorry

theorem IsSeparated.base_change
  requires separated : IsSeparated(f)
  shows IsSeparated(p2)
proof
  sorry

theorem UniversallyClosed.base_change
  requires closed : UniversallyClosed(f)
  shows UniversallyClosed(p2)
proof
  sorry

theorem IsProper.base_change
  requires proper : IsProper(f)
  shows IsProper(p2)
proof
  sorry

theorem IsFiniteHom.base_change
  requires finite : IsFiniteHom(f)
  shows IsFiniteHom(p2)
proof
  sorry

end BaseChange

-- Section: Spec of a ring map
-- For f : R → S, write S as the R-algebra Algebra.mk(R, S, f).
section SpecCriteria
variable (f R S : Set)
hypothesis hom : RingHom(f, R, S)
hypothesis comm : CommRing(R) ∧ CommRing(S)

-- HasRingHomProperty.Spec_iff for the affine-local properties.
theorem FlatHom.spec_iff
  shows FlatHom(specMap(f, R, S)) ↔ FlatAlgebra(Algebra.mk(R, S, f))
proof
  sorry

theorem LocallyOfFiniteType.spec_iff
  shows LocallyOfFiniteType(specMap(f, R, S)) ↔ FiniteTypeAlgebra(Algebra.mk(R, S, f))
proof
  sorry

-- LocallyOfFinitePresentation.SpecMap_iff.
theorem LocallyOfFinitePresentation.spec_iff
  shows LocallyOfFinitePresentation(specMap(f, R, S)) ↔
    FinitePresentationAlgebra(Algebra.mk(R, S, f))
proof
  sorry

theorem SmoothHom.spec_iff
  shows SmoothHom(specMap(f, R, S)) ↔ SmoothAlgebra(Algebra.mk(R, S, f))
proof
  sorry

theorem EtaleHom.spec_iff
  shows EtaleHom(specMap(f, R, S)) ↔ EtaleAlgebra(Algebra.mk(R, S, f))
proof
  sorry

-- IsFinite.SpecMap_iff.
theorem IsFiniteHom.spec_iff
  shows IsFiniteHom(specMap(f, R, S)) ↔ FiniteAlgebra(Algebra.mk(R, S, f))
proof
  sorry

-- A standard smooth algebra of relative dimension n gives a morphism
-- smooth of relative dimension n.
theorem SmoothOfRelativeDimension.spec (n : Nat)
  requires standard : StandardSmooth(Algebra.mk(R, S, f), n)
  shows SmoothOfRelativeDimension(specMap(f, R, S), n)
proof
  sorry

-- A surjective ring map gives a closed immersion
-- (IsClosedImmersion.spec_of_surjective), and Spec.map is surjective when
-- f is injective and integral (Spec.map_surjective of lying over).
theorem IsClosedImmersion.spec_of_surjective
  requires surjective : SurjectiveBetween(f, Ring.carrier(R), Ring.carrier(S))
  shows IsClosedImmersion(specMap(f, R, S))
proof
  sorry

theorem SurjectiveHom.spec_of_integral
  requires injective : InjectiveBetween(f, Ring.carrier(R), Ring.carrier(S))
  requires integral : IntegralAlgebra(Algebra.mk(R, S, f))
  shows SurjectiveHom(specMap(f, R, S))
proof
  sorry

-- A faithfully flat ring map gives a surjective morphism.
theorem SurjectiveHom.spec_of_faithfully_flat
  requires flat : FaithfullyFlatModule(algebraModule(Algebra.mk(R, S, f)), R)
  shows SurjectiveHom(specMap(f, R, S))
proof
  sorry

-- Morphisms between affine schemes are affine, separated, and
-- quasi-compact.
theorem specMap.affine_separated
  shows IsAffineHom(specMap(f, R, S)) ∧ IsSeparated(specMap(f, R, S)) ∧
    QuasiCompactHom(specMap(f, R, S))
proof
  sorry

end SpecCriteria

-- Section: Relations between the properties
section Relations
variable (m X Y : Set)
hypothesis hom : SchemeHom(m, X, Y)

-- Smooth morphisms are flat and locally of finite presentation; étale is
-- smooth of relative dimension 0 (smoothOfRelativeDimension_zero_iff_etale);
-- smooth of some relative dimension is smooth.
theorem SmoothHom.flat
  requires smooth : SmoothHom(m)
  shows FlatHom(m) ∧ LocallyOfFinitePresentation(m)
proof
  sorry

theorem EtaleHom.iff_relative_dimension_zero
  shows EtaleHom(m) ↔ SmoothOfRelativeDimension(m, 0)
proof
  sorry

theorem SmoothOfRelativeDimension.smooth (n : Nat)
  requires smooth : SmoothOfRelativeDimension(m, n)
  shows SmoothHom(m)
proof
  sorry

-- Smooth.exists_isStandardSmooth: a smooth morphism is locally standard
-- smooth of some relative dimension.
theorem SmoothHom.locally_standard (x : Set)
  requires smooth : SmoothHom(m)
  requires point : x ∈ RingedSpace.points(X)
  shows ∃ n ∈ ℕ, ∃ U ∈ RingedSpace.opens(Y), ∃ V ∈ RingedSpace.opens(X),
    x ∈ V ∧ AffinePair(m, U, V) ∧ StandardSmooth(appLEAlgebra(m, U, V), n)
proof
  sorry

-- Open immersions are étale; closed immersions are proper, finite and
-- affine; finite morphisms are proper.
theorem IsOpenImmersion.etale
  requires open : IsOpenImmersion(m)
  shows EtaleHom(m)
proof
  sorry

theorem IsClosedImmersion.finite
  requires closed : IsClosedImmersion(m)
  shows IsFiniteHom(m) ∧ IsProper(m)
proof
  sorry

theorem IsFiniteHom.proper
  requires finite : IsFiniteHom(m)
  shows IsProper(m)
proof
  sorry

-- Universally closed morphisms are quasi-compact, hence so are proper ones.
theorem UniversallyClosed.quasi_compact
  requires closed : UniversallyClosed(m)
  shows QuasiCompactHom(m)
proof
  sorry

-- IsClosedImmersion.iff_isProper_and_mono: closed immersions are the
-- proper monomorphisms of schemes.
theorem IsClosedImmersion.iff_proper_mono
  shows IsClosedImmersion(m) ↔ (IsProper(m) ∧
    (∀ W, ∀ a, ∀ b, SchemeHom(a, W, X) → SchemeHom(b, W, X) →
      compositeHom(m, a) = compositeHom(m, b) → a = b))
proof
  sorry

-- The valuative criterion (UniversallyClosed.eq_valuativeCriterion): a
-- quasi-compact morphism is universally closed iff it has the lifting
-- property for every valuation ring; a universally closed morphism has it
-- in particular for the test valuation rings, which the source uses
-- (ProperSchemes.lean).
theorem UniversallyClosed.valuative
  requires closed : UniversallyClosed(m)
  shows ∀ V, ValuationRing(V) → ValuativeLifting(m, V)
proof
  sorry

theorem UniversallyClosed.of_valuative
  requires compact : QuasiCompactHom(m)
  requires lifting : ∀ V, ValuationRing(V) → ValuativeLifting(m, V)
  shows UniversallyClosed(m)
proof
  sorry

-- IsSeparated is the closedness of the diagonal: for a fibre product of
-- m with itself, the diagonal is a closed immersion.
theorem IsSeparated.diagonal (P p1 p2 d : Set)
  requires pullback : IsSchemePullback(P, p1, p2, m, m)
  requires diagonal : SchemeHom(d, X, P) ∧ compositeHom(p1, d) = identityHom(X) ∧
    compositeHom(p2, d) = identityHom(X)
  shows IsSeparated(m) ↔ IsClosedImmersion(d)
proof
  sorry

end Relations

-- ext_of_isDominant_of_isSeparated: two morphisms a, b : X → Y from a
-- reduced scheme, equal over a separated s : Y → S, that agree after a
-- dominant ι : W → X, are equal.
theorem SchemeHom.ext_of_dominant (a b ι W X Y s : Set)
  requires reduced : ReducedScheme(X)
  requires dominant : IsDominant(ι)
  requires maps : SchemeHom(ι, W, X) ∧ SchemeHom(a, X, Y) ∧ SchemeHom(b, X, Y)
  requires base : SchemeHom(s, Y, homTarget(s)) ∧ IsSeparated(s) ∧
    compositeHom(s, a) = compositeHom(s, b)
  requires agree : compositeHom(a, ι) = compositeHom(b, ι)
  shows a = b
proof
  sorry

-- An open subspace includes as an open immersion.
def openInclusionSheafMap (X U : Set) : Set :=
  { (V, RingedSpace.restriction(X)((V, V ∩ U))) | V ∈ RingedSpace.opens(X) }

def openInclusion (X U : Set) : Set :=
  ((restrictSpace(X, U), X), (identity(U), openInclusionSheafMap(X, U)))

theorem openInclusion.open_immersion (X U : Set)
  requires scheme : Scheme(X)
  requires open : U ∈ RingedSpace.opens(X)
  shows SchemeHom(openInclusion(X, U), restrictSpace(X, U), X) ∧
    IsOpenImmersion(openInclusion(X, U))
proof
  sorry
