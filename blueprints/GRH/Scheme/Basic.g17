-- Schemes as locally ringed spaces: the prime spectrum with its Zariski
-- topology, basic opens and zero loci; ringed spaces (a topology with a
-- sheaf of commutative rings), stalks as germs, locally ringed spaces and
-- their morphisms (local on stalks); the structure sheaf of Spec R by
-- locally fractional sections and Spec of a ring map; schemes, affine
-- opens, and the adjunction between Spec and global sections. A scheme is
-- a set, and no statement quantifies over a universe.
-- Part of the GRH blueprint.
-- Planned home: AlgebraicGeometry/PrimeSpectrum, AlgebraicGeometry/
-- RingedSpace and AlgebraicGeometry/Scheme.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Scheme.Basic
import GRH.Category.Basic
import GRH.Topology.Compactness
import GRH.Algebra.Integral

-- Section: The prime spectrum
-- Spec R as a set of prime ideals (PrimeSpectrum), the zero locus V(S),
-- the basic open D(f), and the vanishing ideal of a set of primes.
def primeSpectrum (R : Set) : Set := { P ∈ 𝒫(Ring.carrier(R)) | PrimeIdeal(R, P) }

def zeroLocus (R S : Set) : Set := { P ∈ primeSpectrum(R) | S ⊆ P }

def basicOpen (R f : Set) : Set := { P ∈ primeSpectrum(R) | ¬(f ∈ P) }

def vanishingIdeal (R Z : Set) : Set := { f ∈ Ring.carrier(R) | ∀ P ∈ Z, f ∈ P }

-- The Zariski topology: the complements of the zero loci.
def zariskiTopology (R : Set) : Set :=
  { U ∈ 𝒫(primeSpectrum(R)) |
    ∃ S ∈ 𝒫(Ring.carrier(R)), U = primeSpectrum(R) ∖ zeroLocus(R, S) }

-- The map Spec S → Spec R, Q ↦ f⁻¹(Q), of f : R → S (PrimeSpectrum.comap).
def specComap (f R S : Set) : Set :=
  { (Q, functionPreimage(f, Ring.carrier(R), Q)) | Q ∈ primeSpectrum(S) }

-- Section: Ringed spaces
-- The pairs (U, V) of opens with V ⊆ U.
def inclusionPairs (T : Set) : Set := { p ∈ T × T | snd(p) ⊆ fst(p) }

-- A ringed space: points, a topology, the ring of sections O(U) of each
-- open U, and restriction homomorphisms O(U) → O(V) for V ⊆ U,
-- functorial (a presheaf of commutative rings; TopCat.Presheaf CommRingCat).
structure RingedSpace
  | points opens sections restriction : Set
  where
    topology : IsTopology(points, opens)
    rings : ∀ U ∈ opens, CommRing(sections(U))
    homs : ∀ U ∈ opens, ∀ V ∈ opens, V ⊆ U →
      RingHom(restriction((U, V)), sections(U), sections(V))
    identities : ∀ U ∈ opens,
      restriction((U, U)) = identity(Ring.carrier(sections(U)))
    composites : ∀ U ∈ opens, ∀ V ∈ opens, ∀ W ∈ opens, W ⊆ V → V ⊆ U →
      restriction((U, W)) = compose(restriction((V, W)), restriction((U, V)),
        Ring.carrier(sections(U)), Ring.carrier(sections(V)),
        Ring.carrier(sections(W)))

-- The carrier O(U) and the restriction s ↦ s|V.
def sectionsOf (X U : Set) : Set := Ring.carrier(RingedSpace.sections(X)(U))

def restrictSection (X U V s : Set) : Set := RingedSpace.restriction(X)((U, V))(s)

def sectionCarriers (X : Set) : Set := { sectionsOf(X, U) | U ∈ RingedSpace.opens(X) }

-- The sheaf condition: sections over a union of opens agree when they
-- agree on each, and compatible families glue (TopCat.Presheaf.IsSheaf).
predicate SheafCondition (X : Set) :=
  ∀ U ∈ RingedSpace.opens(X), ∀ K ∈ 𝒫(RingedSpace.opens(X)), ⋃(K) = U →
    (∀ s ∈ sectionsOf(X, U), ∀ t ∈ sectionsOf(X, U),
      (∀ V ∈ K, restrictSection(X, U, V, s) = restrictSection(X, U, V, t)) → s = t) ∧
    (∀ σ ∈ functionSpace(K, ⋃(sectionCarriers(X))),
      (∀ V ∈ K, σ(V) ∈ sectionsOf(X, V)) →
      (∀ V ∈ K, ∀ W ∈ K, restrictSection(X, V, V ∩ W, σ(V)) =
        restrictSection(X, W, V ∩ W, σ(W))) →
      (∃ s ∈ sectionsOf(X, U), ∀ V ∈ K, restrictSection(X, U, V, s) = σ(V)))

-- Section: Stalks
-- Germs at x: pairs (U, s) with x ∈ U and s ∈ O(U), identified when they
-- agree on a smaller open neighbourhood (TopCat.Presheaf.stalk, as a
-- filtered colimit computed by hand).
def germPairs (X x : Set) : Set :=
  { p ∈ RingedSpace.opens(X) × ⋃(sectionCarriers(X)) |
    ∃ U ∈ RingedSpace.opens(X), ∃ s ∈ sectionsOf(X, U), x ∈ U ∧ p = (U, s) }

def germRelation (X x : Set) : Set :=
  { q ∈ germPairs(X, x) × germPairs(X, x) |
    ∃ W ∈ RingedSpace.opens(X), x ∈ W ∧ W ⊆ fst(fst(q)) ∧ W ⊆ fst(snd(q)) ∧
      restrictSection(X, fst(fst(q)), W, snd(fst(q))) =
        restrictSection(X, fst(snd(q)), W, snd(snd(q))) }

def stalkCarrier (X x : Set) : Set := germPairs(X, x) ⧸ germRelation(X, x)

def germ (X x p : Set) : Set := ⟦p⟧[germPairs(X, x), germRelation(X, x)]

-- Sums and products of germs are computed on the intersection of the
-- opens; the zero and one are the germs of 0 and 1 on the whole space.
def germOp (X op p q : Set) : Set :=
  (fst(p) ∩ fst(q), call2(op(fst(p) ∩ fst(q)),
    restrictSection(X, fst(p), fst(p) ∩ fst(q), snd(p)),
    restrictSection(X, fst(q), fst(p) ∩ fst(q), snd(q))))

def sectionAdditions (X : Set) : Set :=
  { (U, Ring.add(RingedSpace.sections(X)(U))) | U ∈ RingedSpace.opens(X) }

def sectionMultiplications (X : Set) : Set :=
  { (U, Ring.mul(RingedSpace.sections(X)(U))) | U ∈ RingedSpace.opens(X) }

def stalkAdd (X x : Set) : Set :=
  { u ∈ (stalkCarrier(X, x) × stalkCarrier(X, x)) × stalkCarrier(X, x) |
    ∃ p ∈ germPairs(X, x), ∃ q ∈ germPairs(X, x),
      u = ((germ(X, x, p), germ(X, x, q)),
        germ(X, x, germOp(X, sectionAdditions(X), p, q))) }

def stalkMul (X x : Set) : Set :=
  { u ∈ (stalkCarrier(X, x) × stalkCarrier(X, x)) × stalkCarrier(X, x) |
    ∃ p ∈ germPairs(X, x), ∃ q ∈ germPairs(X, x),
      u = ((germ(X, x, p), germ(X, x, q)),
        germ(X, x, germOp(X, sectionMultiplications(X), p, q))) }

def stalkNeg (X x : Set) : Set :=
  { u ∈ stalkCarrier(X, x) × stalkCarrier(X, x) |
    ∃ p ∈ germPairs(X, x), u = (germ(X, x, p),
      germ(X, x, (fst(p), apply(Ring.neg(RingedSpace.sections(X)(fst(p))), snd(p))))) }

def stalk (X x : Set) : Set :=
  Ring.mk(stalkCarrier(X, x), stalkAdd(X, x),
    germ(X, x, (RingedSpace.points(X),
      Ring.zero(RingedSpace.sections(X)(RingedSpace.points(X))))),
    stalkNeg(X, x), stalkMul(X, x),
    germ(X, x, (RingedSpace.points(X),
      Ring.one(RingedSpace.sections(X)(RingedSpace.points(X))))))

-- The germ map O(U) → O_{X,x} (TopCat.Presheaf.germ).
def germMap (X U x : Set) : Set := { (s, germ(X, x, (U, s))) | s ∈ sectionsOf(X, U) }

-- A locally ringed space: a sheaf of rings whose stalks are local rings
-- (LocallyRingedSpace).
predicate LocallyRingedSpace (X : Set) :=
  RingedSpace(X) ∧ SheafCondition(X) ∧
  (∀ x ∈ RingedSpace.points(X), LocalRing(stalk(X, x)))

-- Section: Morphisms
-- A morphism X → Y of ringed spaces, recorded with its endpoints as
-- ((X, Y), (f, φ)): f continuous, and φ(V) : O_Y(V) → O_X(f⁻¹V) ring
-- homomorphisms compatible with restriction.
def homPoints (m : Set) : Set := fst(snd(m))

def homSheaf (m : Set) : Set := snd(snd(m))

def openPreimage (X f V : Set) : Set := functionPreimage(f, RingedSpace.points(X), V)

predicate RingedSpaceHom (m X Y : Set) :=
  RingedSpace(X) ∧ RingedSpace(Y) ∧ m = ((X, Y), (homPoints(m), homSheaf(m))) ∧
  ContinuousMap(homPoints(m), RingedSpace.points(X), RingedSpace.opens(X),
    RingedSpace.points(Y), RingedSpace.opens(Y)) ∧
  (∀ V ∈ RingedSpace.opens(Y), RingHom(homSheaf(m)(V), RingedSpace.sections(Y)(V),
    RingedSpace.sections(X)(openPreimage(X, homPoints(m), V)))) ∧
  (∀ V ∈ RingedSpace.opens(Y), ∀ W ∈ RingedSpace.opens(Y), W ⊆ V →
    ∀ s ∈ sectionsOf(Y, V),
      restrictSection(X, openPreimage(X, homPoints(m), V),
        openPreimage(X, homPoints(m), W), homSheaf(m)(V)(s)) =
      homSheaf(m)(W)(restrictSection(Y, V, W, s)))

-- The induced map of stalks O_{Y,f(x)} → O_{X,x}
-- (PresheafedSpace.Hom.stalkMap): [V, s] ↦ [f⁻¹V, φ(V)(s)].
def stalkMap (m x : Set) : Set :=
  { u ∈ stalkCarrier(snd(fst(m)), homPoints(m)(x)) × stalkCarrier(fst(fst(m)), x) |
    ∃ p ∈ germPairs(snd(fst(m)), homPoints(m)(x)),
      u = (germ(snd(fst(m)), homPoints(m)(x), p),
        germ(fst(fst(m)), x, (openPreimage(fst(fst(m)), homPoints(m), fst(p)),
          homSheaf(m)(fst(p))(snd(p))))) }

-- A morphism of locally ringed spaces: local on every stalk
-- (LocallyRingedSpace.Hom). Morphisms of schemes are these.
predicate LocallyRingedHom (m X Y : Set) :=
  LocallyRingedSpace(X) ∧ LocallyRingedSpace(Y) ∧ RingedSpaceHom(m, X, Y) ∧
  (∀ x ∈ RingedSpace.points(X), LocalRingHom(stalkMap(m, x),
    stalk(Y, homPoints(m)(x)), stalk(X, x)))

-- The identity and the composite n ∘ m (Scheme.Hom.comp).
def identitySheafMap (X : Set) : Set :=
  { (U, identity(sectionsOf(X, U))) | U ∈ RingedSpace.opens(X) }

def identityHom (X : Set) : Set :=
  ((X, X), (identity(RingedSpace.points(X)), identitySheafMap(X)))

def compositeSheafMap (n m : Set) : Set :=
  { (W, compose(homSheaf(m)(openPreimage(snd(fst(m)), homPoints(n), W)),
      homSheaf(n)(W), sectionsOf(snd(fst(n)), W),
      sectionsOf(snd(fst(m)), openPreimage(snd(fst(m)), homPoints(n), W)),
      sectionsOf(fst(fst(m)), openPreimage(fst(fst(m)), homPoints(m),
        openPreimage(snd(fst(m)), homPoints(n), W))))) |
    W ∈ RingedSpace.opens(snd(fst(n))) }

def compositeHom (n m : Set) : Set :=
  ((fst(fst(m)), snd(fst(n))),
    (compose(homPoints(n), homPoints(m), RingedSpace.points(fst(fst(m))),
      RingedSpace.points(snd(fst(m))), RingedSpace.points(snd(fst(n)))),
      compositeSheafMap(n, m)))

-- An isomorphism of locally ringed spaces.
predicate LocallyRingedIso (m X Y : Set) :=
  LocallyRingedHom(m, X, Y) ∧ (∃ n, LocallyRingedHom(n, Y, X) ∧
    compositeHom(n, m) = identityHom(X) ∧ compositeHom(m, n) = identityHom(Y))

-- Section: The spectrum as a locally ringed space
-- Sections of Spec R over U: functions s with s(P) ∈ R_P, locally of the
-- form a/g (AlgebraicGeometry.StructureSheaf.isLocallyFraction).
def localRingCarriers (R U : Set) : Set :=
  { Ring.carrier(localizationAtPrime(R, P)) | P ∈ U }

def specSectionCarrier (R U : Set) : Set :=
  { s ∈ functionSpace(U, ⋃(localRingCarriers(R, U))) |
    (∀ P ∈ U, s(P) ∈ Ring.carrier(localizationAtPrime(R, P))) ∧
    (∀ P ∈ U, ∃ V ∈ zariskiTopology(R), P ∈ V ∧ V ⊆ U ∧
      (∃ a ∈ Ring.carrier(R), ∃ g ∈ Ring.carrier(R), ∀ Q ∈ V,
        ¬(g ∈ Q) ∧ s(Q) = fraction(R, primeComplement(R, Q), a, g))) }

-- Pointwise operations in the local rings.
def localPointwise (R U op s t : Set) : Set :=
  { (P, call2(op(P), s(P), t(P))) | P ∈ U }

def localAdditions (R U : Set) : Set :=
  { (P, Ring.add(localizationAtPrime(R, P))) | P ∈ U }

def localMultiplications (R U : Set) : Set :=
  { (P, Ring.mul(localizationAtPrime(R, P))) | P ∈ U }

def localNegative (R U s : Set) : Set :=
  { (P, apply(Ring.neg(localizationAtPrime(R, P)), s(P))) | P ∈ U }

def localConstant (R U a : Set) : Set :=
  { (P, fraction(R, primeComplement(R, P), a, Ring.one(R))) | P ∈ U }

def specSectionAdd (R U : Set) : Set :=
  { (p, localPointwise(R, U, localAdditions(R, U), fst(p), snd(p))) |
    p ∈ specSectionCarrier(R, U) × specSectionCarrier(R, U) }

def specSectionMul (R U : Set) : Set :=
  { (p, localPointwise(R, U, localMultiplications(R, U), fst(p), snd(p))) |
    p ∈ specSectionCarrier(R, U) × specSectionCarrier(R, U) }

def specSectionNeg (R U : Set) : Set :=
  { (s, localNegative(R, U, s)) | s ∈ specSectionCarrier(R, U) }

def specSectionRing (R U : Set) : Set :=
  Ring.mk(specSectionCarrier(R, U), specSectionAdd(R, U),
    localConstant(R, U, Ring.zero(R)), specSectionNeg(R, U),
    specSectionMul(R, U), localConstant(R, U, Ring.one(R)))

def specSections (R : Set) : Set :=
  { (U, specSectionRing(R, U)) | U ∈ zariskiTopology(R) }

def specRestrictionMap (R U V : Set) : Set :=
  { (s, restrict(s, V)) | s ∈ specSectionCarrier(R, U) }

def specRestriction (R : Set) : Set :=
  { (p, specRestrictionMap(R, fst(p), snd(p))) | p ∈ inclusionPairs(zariskiTopology(R)) }

-- Spec R (AlgebraicGeometry.Spec, Scheme.Spec).
def Spec (R : Set) : Set :=
  RingedSpace.mk(primeSpectrum(R), zariskiTopology(R), specSections(R),
    specRestriction(R))

-- Spec of a ring map f : R → S, a morphism Spec S → Spec R (Spec.map):
-- on points Q ↦ f⁻¹(Q); on sections, s ↦ (Q ↦ f_Q(s(f⁻¹Q))) with
-- f_Q : R_{f⁻¹Q} → S_Q the localized map.
def localizedHom (f R S Q : Set) : Set :=
  localizationLift(R, primeComplement(R, functionPreimage(f, Ring.carrier(R), Q)),
    localizationAtPrime(S, Q),
    compose(localizationMap(S, primeComplement(S, Q)), f, Ring.carrier(R),
      Ring.carrier(S), Ring.carrier(localizationAtPrime(S, Q))))

def specPullSection (f R S V s : Set) : Set :=
  { (Q, localizedHom(f, R, S, Q)(s(functionPreimage(f, Ring.carrier(R), Q)))) |
    Q ∈ functionPreimage(specComap(f, R, S), primeSpectrum(S), V) }

def specPullMap (f R S V : Set) : Set :=
  { (s, specPullSection(f, R, S, V, s)) | s ∈ specSectionCarrier(R, V) }

def specSheafMap (f R S : Set) : Set :=
  { (V, specPullMap(f, R, S, V)) | V ∈ zariskiTopology(R) }

def specMap (f R S : Set) : Set :=
  ((Spec(S), Spec(R)), (specComap(f, R, S), specSheafMap(f, R, S)))

-- Section: Schemes
-- The open subspace on an open U (Scheme.Opens.toScheme, restrict).
def opensWithin (X U : Set) : Set := { V ∈ RingedSpace.opens(X) | V ⊆ U }

def restrictSpace (X U : Set) : Set :=
  RingedSpace.mk(U, opensWithin(X, U), restrict(RingedSpace.sections(X), opensWithin(X, U)),
    restrict(RingedSpace.restriction(X), inclusionPairs(opensWithin(X, U))))

-- The global sections Γ(X) = O_X(X) (Scheme.Γ).
def globalSections (X : Set) : Set := RingedSpace.sections(X)(RingedSpace.points(X))

-- U is an affine open: the open subspace on U is isomorphic to Spec of its
-- ring of sections (IsAffineOpen; equivalently, isomorphic to Spec of
-- some ring, IsAffineOpen.of_spec below).
predicate IsAffineOpen (X U : Set) :=
  U ∈ RingedSpace.opens(X) ∧
  (∃ m, LocallyRingedIso(m, restrictSpace(X, U), Spec(RingedSpace.sections(X)(U))))

-- A scheme: a locally ringed space covered by affine opens
-- (AlgebraicGeometry.Scheme). An affine scheme: X itself is affine
-- (IsAffine).
predicate Scheme (X : Set) :=
  LocallyRingedSpace(X) ∧
  (∀ x ∈ RingedSpace.points(X), ∃ U, x ∈ U ∧ IsAffineOpen(X, U))

predicate AffineScheme (X : Set) := Scheme(X) ∧ IsAffineOpen(X, RingedSpace.points(X))

-- The affine opens of X.
def affineOpens (X : Set) : Set := { U ∈ RingedSpace.opens(X) | IsAffineOpen(X, U) }

-- The canonical morphism X → Spec Γ(X) of a locally ringed space
-- (toSpecΓ): x ↦ the sections not invertible at x. Stated through its
-- points; the existence of its sheaf part is a theorem.
def nonInvertibleAt (X x : Set) : Set :=
  { s ∈ sectionsOf(X, RingedSpace.points(X)) |
    ¬RingUnit(stalk(X, x), germMap(X, RingedSpace.points(X), x)(s)) }

def toSpecGlobalPoints (X : Set) : Set :=
  { (x, nonInvertibleAt(X, x)) | x ∈ RingedSpace.points(X) }

def basicOpens (R : Set) : Set := { basicOpen(R, f) | f ∈ Ring.carrier(R) }

-- Section: Laws of the prime spectrum
section Spectrum
variable (R : Set)
hypothesis comm : CommRing(R)

-- The Zariski topology is a topology, with the basic opens as a basis
-- (PrimeSpectrum.isTopologicalBasis_basic_opens), and Spec R is
-- quasi-compact (PrimeSpectrum.compactSpace).
theorem zariskiTopology.topology
  shows IsTopology(primeSpectrum(R), zariskiTopology(R))
proof
  sorry

theorem basicOpen.open (f : Set)
  requires element : f ∈ Ring.carrier(R)
  shows basicOpen(R, f) ∈ zariskiTopology(R)
proof
  sorry

theorem basicOpen.basis
  shows Basis(primeSpectrum(R), zariskiTopology(R), basicOpens(R))
proof
  sorry

theorem primeSpectrum.compact
  shows IsCompact(primeSpectrum(R), zariskiTopology(R), primeSpectrum(R))
proof
  sorry

-- Basic opens are quasi-compact, and D(f) ∩ D(g) = D(fg)
-- (PrimeSpectrum.isCompact_basicOpen, basicOpen_mul).
theorem basicOpen.compact (f : Set)
  requires element : f ∈ Ring.carrier(R)
  shows IsCompact(primeSpectrum(R), zariskiTopology(R), basicOpen(R, f))
proof
  sorry

theorem basicOpen.mul (f g : Set)
  requires first : f ∈ Ring.carrier(R)
  requires second : g ∈ Ring.carrier(R)
  shows basicOpen(R, call2(Ring.mul(R), f, g)) = basicOpen(R, f) ∩ basicOpen(R, g)
proof
  sorry

-- The zero locus is closed, of S and of the ideal S generates alike
-- (isClosed_zeroLocus, zeroLocus_span), and it is empty iff the ideal is
-- the whole ring (zeroLocus_empty_iff_eq_top).
theorem zeroLocus.closed (S : Set)
  requires subset : S ⊆ Ring.carrier(R)
  shows IsClosed(primeSpectrum(R), zariskiTopology(R), zeroLocus(R, S))
proof
  sorry

theorem zeroLocus.span (S : Set)
  requires subset : S ⊆ Ring.carrier(R)
  shows zeroLocus(R, generatedIdeal(R, S)) = zeroLocus(R, S)
proof
  sorry

theorem zeroLocus.empty_iff (I : Set)
  requires ideal : Ideal(R, I)
  shows zeroLocus(R, I) = ∅ ↔ I = Ring.carrier(R)
proof
  sorry

-- V(I(Z)) is the closure of Z, and I(V(J)) is the radical of J
-- (zeroLocus_vanishingIdeal_eq_closure, vanishingIdeal_zeroLocus_eq_radical;
-- isRadical_vanishingIdeal).
theorem zeroLocus.vanishing_closure (Z : Set)
  requires subset : Z ⊆ primeSpectrum(R)
  shows zeroLocus(R, vanishingIdeal(R, Z)) = closure(primeSpectrum(R), zariskiTopology(R), Z)
proof
  sorry

theorem vanishingIdeal.zero_locus (J : Set)
  requires ideal : Ideal(R, J)
  shows vanishingIdeal(R, zeroLocus(R, J)) = idealRadical(R, J)
proof
  sorry

-- Specialization is inclusion: Q lies in the closure of {P} iff P ⊆ Q
-- (PrimeSpectrum.le_iff_specializes); the closed points are the maximal
-- ideals.
theorem primeSpectrum.specializes (P Q : Set)
  requires first : P ∈ primeSpectrum(R)
  requires second : Q ∈ primeSpectrum(R)
  shows P ⊆ Q ↔ Q ∈ closure(primeSpectrum(R), zariskiTopology(R), {P})
proof
  sorry

theorem primeSpectrum.closed_point (P : Set)
  requires point : P ∈ primeSpectrum(R)
  shows IsClosed(primeSpectrum(R), zariskiTopology(R), {P}) ↔ MaximalIdeal(R, P)
proof
  sorry

-- The clopen subsets of Spec R are the basic opens of idempotents
-- (PrimeSpectrum.isClopen_iff, isIdempotentElemEquivClopens), and
-- distinct idempotents give distinct ones (basicOpen_injOn_isIdempotentElem).
theorem primeSpectrum.clopen_iff (U : Set)
  shows (U ∈ zariskiTopology(R) ∧
      IsClosed(primeSpectrum(R), zariskiTopology(R), U)) ↔
    (∃ e ∈ Ring.carrier(R), call2(Ring.mul(R), e, e) = e ∧ U = basicOpen(R, e))
proof
  sorry

theorem basicOpen.idempotent_injective (e e2 : Set)
  requires first : e ∈ Ring.carrier(R) ∧ call2(Ring.mul(R), e, e) = e
  requires second : e2 ∈ Ring.carrier(R) ∧ call2(Ring.mul(R), e2, e2) = e2
  requires same : basicOpen(R, e) = basicOpen(R, e2)
  shows e = e2
proof
  sorry

-- R → ∏_P R_P is injective (PrimeSpectrum.toPiLocalization_injective):
-- an element vanishing in every localization at a prime is zero.
theorem primeSpectrum.local_zero (a : Set)
  requires element : a ∈ Ring.carrier(R)
  requires vanishes : ∀ P ∈ primeSpectrum(R),
    fraction(R, primeComplement(R, P), a, Ring.one(R)) =
      Ring.zero(localizationAtPrime(R, P))
  shows a = Ring.zero(R)
proof
  sorry

end Spectrum

-- Comap: continuous, functorial, a homeomorphism for an isomorphism
-- (PrimeSpectrum.continuous_comap, comap_comp, isHomeomorph_comap,
-- homeomorphOfRingEquiv), with preimages of zero loci and basic opens
-- (preimage_comap_zeroLocus).
theorem specComap.continuous (f R S : Set)
  requires hom : RingHom(f, R, S)
  requires comm : CommRing(R) ∧ CommRing(S)
  shows ContinuousMap(specComap(f, R, S), primeSpectrum(S), zariskiTopology(S),
    primeSpectrum(R), zariskiTopology(R))
proof
  sorry

theorem specComap.zero_locus (f R S T : Set)
  requires hom : RingHom(f, R, S)
  requires comm : CommRing(R) ∧ CommRing(S)
  requires subset : T ⊆ Ring.carrier(R)
  shows functionPreimage(specComap(f, R, S), primeSpectrum(S), zeroLocus(R, T)) =
    zeroLocus(S, functionImage(f, T, Ring.carrier(S)))
proof
  sorry

theorem specComap.homeomorphism (f R S : Set)
  requires iso : RingIso(f, R, S)
  requires comm : CommRing(R) ∧ CommRing(S)
  shows IsHomeomorphism(specComap(f, R, S), primeSpectrum(S), zariskiTopology(S),
    primeSpectrum(R), zariskiTopology(R))
proof
  sorry

-- The image of Spec S → Spec R is dense iff the kernel of f lies in the
-- nilradical (PrimeSpectrum.denseRange_comap_iff_ker_le_nilRadical).
theorem specComap.dense_iff (f R S : Set)
  requires hom : RingHom(f, R, S)
  requires comm : CommRing(R) ∧ CommRing(S)
  shows IsDense(primeSpectrum(R), zariskiTopology(R),
      functionImage(specComap(f, R, S), primeSpectrum(S), primeSpectrum(R))) ↔
    ringKernel(f, Ring.carrier(R), Ring.zero(S)) ⊆ nilradical(R)
proof
  sorry

-- For a surjection R → R ⧸ I, Spec(R ⧸ I) → V(I) is a homeomorphism onto
-- the closed set V(I) (PrimeSpectrum.isClosedEmbedding_comap_of_surjective).
theorem specComap.quotient (R I : Set)
  requires comm : CommRing(R)
  requires ideal : Ideal(R, I)
  shows functionImage(specComap(quotientMk(R, I), R, quotientRing(R, I)),
      primeSpectrum(quotientRing(R, I)), primeSpectrum(R)) = zeroLocus(R, I) ∧
    InjectiveBetween(specComap(quotientMk(R, I), R, quotientRing(R, I)),
      primeSpectrum(quotientRing(R, I)), primeSpectrum(R))
proof
  sorry

-- For an integral injective map the comap is surjective (lying over,
-- PrimeSpectrum.comap surjective for integral extensions).
theorem specComap.surjective_of_integral (A : Set)
  requires integral : IntegralAlgebra(A)
  requires injective : InjectiveBetween(Algebra.map(A), Ring.carrier(Algebra.base(A)),
    algebraCarrier(A))
  shows SurjectiveBetween(specComap(Algebra.map(A), Algebra.base(A), Algebra.ring(A)),
    primeSpectrum(Algebra.ring(A)), primeSpectrum(Algebra.base(A)))
proof
  sorry

-- Section: Laws of ringed spaces and stalks
section Stalks
variable (X : Set)
hypothesis ringed : RingedSpace(X)

-- The stalk is a commutative ring and the germ maps are ring
-- homomorphisms (TopCat.Presheaf.germ).
theorem stalk.comm_ring (x : Set)
  requires point : x ∈ RingedSpace.points(X)
  shows CommRing(stalk(X, x))
proof
  sorry

theorem germMap.hom (U x : Set)
  requires open : U ∈ RingedSpace.opens(X)
  requires point : x ∈ U
  shows RingHom(germMap(X, U, x), RingedSpace.sections(X)(U), stalk(X, x))
proof
  sorry

-- Germs are compatible with restriction (TopCat.Presheaf.germ_res).
theorem germMap.restrict (U V x s : Set)
  requires openU : U ∈ RingedSpace.opens(X)
  requires openV : V ∈ RingedSpace.opens(X)
  requires subset : V ⊆ U
  requires point : x ∈ V
  requires section : s ∈ sectionsOf(X, U)
  shows germMap(X, V, x)(restrictSection(X, U, V, s)) = germMap(X, U, x)(s)
proof
  sorry

-- Every element of the stalk is a germ, and germs that are equal agree on
-- a neighbourhood (TopCat.Presheaf.germ_exist, germ_eq).
theorem stalk.germ_exists (x t : Set)
  requires point : x ∈ RingedSpace.points(X)
  requires element : t ∈ Ring.carrier(stalk(X, x))
  shows ∃ U ∈ RingedSpace.opens(X), x ∈ U ∧ ∃ s ∈ sectionsOf(X, U),
    germMap(X, U, x)(s) = t
proof
  sorry

theorem stalk.germ_eq (U V x s t : Set)
  requires openU : U ∈ RingedSpace.opens(X)
  requires openV : V ∈ RingedSpace.opens(X)
  requires pointU : x ∈ U
  requires pointV : x ∈ V
  requires first : s ∈ sectionsOf(X, U)
  requires second : t ∈ sectionsOf(X, V)
  requires same : germMap(X, U, x)(s) = germMap(X, V, x)(t)
  shows ∃ W ∈ RingedSpace.opens(X), x ∈ W ∧ W ⊆ U ∧ W ⊆ V ∧
    restrictSection(X, U, W, s) = restrictSection(X, V, W, t)
proof
  sorry

-- The open subspace on an open set is a ringed space, a locally ringed
-- space, a scheme, with the same stalks.
theorem restrictSpace.ringed (U : Set)
  requires open : U ∈ RingedSpace.opens(X)
  shows RingedSpace(restrictSpace(X, U))
proof
  sorry

end Stalks

theorem restrictSpace.scheme (X U : Set)
  requires scheme : Scheme(X)
  requires open : U ∈ RingedSpace.opens(X)
  shows Scheme(restrictSpace(X, U))
proof
  sorry

-- Composition and identities of morphisms of locally ringed spaces
-- (Scheme.Hom.comp, Category laws).
theorem LocallyRingedHom.identity (X : Set)
  requires space : LocallyRingedSpace(X)
  shows LocallyRingedHom(identityHom(X), X, X)
proof
  sorry

theorem LocallyRingedHom.comp (m n X Y Z : Set)
  requires first : LocallyRingedHom(m, X, Y)
  requires second : LocallyRingedHom(n, Y, Z)
  shows LocallyRingedHom(compositeHom(n, m), X, Z)
proof
  sorry

theorem compositeHom.associative (m n k X Y Z W : Set)
  requires first : LocallyRingedHom(m, X, Y)
  requires second : LocallyRingedHom(n, Y, Z)
  requires third : LocallyRingedHom(k, Z, W)
  shows compositeHom(k, compositeHom(n, m)) = compositeHom(compositeHom(k, n), m)
proof
  sorry

theorem compositeHom.identities (m X Y : Set)
  requires hom : LocallyRingedHom(m, X, Y)
  shows compositeHom(identityHom(Y), m) = m ∧ compositeHom(m, identityHom(X)) = m
proof
  sorry

-- Scheme.Hom.comp_apply: composition on points.
theorem compositeHom.points (m n X Y Z x : Set)
  requires first : LocallyRingedHom(m, X, Y)
  requires second : LocallyRingedHom(n, Y, Z)
  requires point : x ∈ RingedSpace.points(X)
  shows homPoints(compositeHom(n, m))(x) = homPoints(n)(homPoints(m)(x))
proof
  sorry

-- Γ(Spec R) ≅ R, by a ↦ (P ↦ a/1) (Scheme.ΓSpecIso,
-- StructureSheaf.globalSectionsIso).
def specGlobalMap (R : Set) : Set :=
  { (a, localConstant(R, primeSpectrum(R), a)) | a ∈ Ring.carrier(R) }

-- Section: Spec
section SpecLaws
variable (R : Set)
hypothesis comm : CommRing(R)

-- Spec R is a ringed space, its structure presheaf a sheaf, its stalks
-- the local rings R_P (StructureSheaf.stalkIso; IsAffineOpen.
-- isLocalization_stalk); Spec R is an affine scheme.
theorem Spec.ringed
  shows RingedSpace(Spec(R))
proof
  sorry

theorem Spec.sheaf
  shows SheafCondition(Spec(R))
proof
  sorry

theorem Spec.stalk (P : Set)
  requires point : P ∈ primeSpectrum(R)
  shows ∃ φ, RingIso(φ, localizationAtPrime(R, P), stalk(Spec(R), P))
proof
  sorry

theorem Spec.locally_ringed
  shows LocallyRingedSpace(Spec(R))
proof
  sorry

theorem Spec.affine
  shows AffineScheme(Spec(R))
proof
  sorry

theorem Spec.global_sections
  shows RingIso(specGlobalMap(R), R, globalSections(Spec(R)))
proof
  sorry

-- Sections over a basic open: O(D(f)) ≅ R_f (StructureSheaf.basicOpenIso).
theorem Spec.basic_open_sections (f : Set)
  requires element : f ∈ Ring.carrier(R)
  shows ∃ φ, RingIso(φ, localizationAway(R, f), RingedSpace.sections(Spec(R))(basicOpen(R, f)))
proof
  sorry

end SpecLaws

-- Spec.map is a morphism of locally ringed spaces, functorial
-- (Spec.map_id, Spec.map_comp), and injective on maps (Spec.map_inj).
theorem specMap.hom (f R S : Set)
  requires hom : RingHom(f, R, S)
  requires comm : CommRing(R) ∧ CommRing(S)
  shows LocallyRingedHom(specMap(f, R, S), Spec(S), Spec(R))
proof
  sorry

theorem specMap.id (R : Set)
  requires comm : CommRing(R)
  shows specMap(identity(Ring.carrier(R)), R, R) = identityHom(Spec(R))
proof
  sorry

theorem specMap.comp (f g R S T : Set)
  requires first : RingHom(f, R, S)
  requires second : RingHom(g, S, T)
  requires comm : CommRing(R) ∧ CommRing(S) ∧ CommRing(T)
  shows specMap(compose(g, f, Ring.carrier(R), Ring.carrier(S), Ring.carrier(T)), R, T) =
    compositeHom(specMap(f, R, S), specMap(g, S, T))
proof
  sorry

theorem specMap.injective (f g R S : Set)
  requires first : RingHom(f, R, S)
  requires second : RingHom(g, R, S)
  requires comm : CommRing(R) ∧ CommRing(S)
  requires same : specMap(f, R, S) = specMap(g, R, S)
  shows f = g
proof
  sorry

-- Spec is fully faithful: every morphism Spec S → Spec R is Spec.map of a
-- unique ring map (Spec.homEquiv, Spec.map_surjective, Spec.preimage).
-- More generally, morphisms X → Spec R correspond to ring maps R → Γ(X)
-- (ΓSpec.adjunction; Spec.homEquiv for X = Spec S).
theorem specMap.surjective (m R S : Set)
  requires comm : CommRing(R) ∧ CommRing(S)
  requires hom : LocallyRingedHom(m, Spec(S), Spec(R))
  shows ∃ f, RingHom(f, R, S) ∧ m = specMap(f, R, S)
proof
  sorry

-- The ring map Γ(Y) → Γ(X) of a morphism m : X → Y (Scheme.Hom.appTop).
def globalMap (m : Set) : Set := homSheaf(m)(RingedSpace.points(snd(fst(m))))

theorem toSpec.adjunction (X R g : Set)
  requires space : LocallyRingedSpace(X)
  requires comm : CommRing(R)
  requires hom : RingHom(g, R, globalSections(X))
  shows ∃ m, LocallyRingedHom(m, X, Spec(R)) ∧
    compose(globalMap(m), specGlobalMap(R), Ring.carrier(R),
      Ring.carrier(globalSections(Spec(R))), Ring.carrier(globalSections(X))) = g ∧
    (∀ n, LocallyRingedHom(n, X, Spec(R)) →
      compose(globalMap(n), specGlobalMap(R), Ring.carrier(R),
        Ring.carrier(globalSections(Spec(R))), Ring.carrier(globalSections(X))) = g →
      n = m)
proof
  sorry

-- The points of the canonical map X → Spec Γ(X) are primes (toSpecΓ).
theorem toSpecGlobalPoints.function (X : Set)
  requires space : LocallyRingedSpace(X)
  shows toSpecGlobalPoints(X) : RingedSpace.points(X) → primeSpectrum(globalSections(X))
proof
  sorry

def sectionBasicOpen (X U f : Set) : Set :=
  { x ∈ U | RingUnit(stalk(X, x), germMap(X, U, x)(f)) }

-- Section: Affine opens
section AffineOpens
variable (X : Set)
hypothesis scheme : Scheme(X)

-- U is affine iff its open subspace is isomorphic to Spec of some ring.
theorem IsAffineOpen.of_spec (U R : Set)
  requires comm : CommRing(R)
  requires open : U ∈ RingedSpace.opens(X)
  requires iso : ∃ m, LocallyRingedIso(m, restrictSpace(X, U), Spec(R))
  shows IsAffineOpen(X, U)
proof
  sorry

-- An affine scheme is an affine open of itself (isAffineOpen_top); the
-- affine opens form a basis (exists_isAffineOpen_mem_and_subset;
-- isBasis_affine_open).
theorem IsAffineOpen.top
  requires affine : AffineScheme(X)
  shows IsAffineOpen(X, RingedSpace.points(X))
proof
  sorry

theorem IsAffineOpen.basis (x V : Set)
  requires open : V ∈ RingedSpace.opens(X)
  requires point : x ∈ V
  shows ∃ U, IsAffineOpen(X, U) ∧ x ∈ U ∧ U ⊆ V
proof
  sorry

-- The basic open X_f = {x : f invertible at x} of a section over an affine
-- U is affine, and inside an affine U every open neighbourhood contains a
-- basic one (IsAffineOpen.basicOpen, IsAffineOpen.exists_basicOpen_le).
theorem IsAffineOpen.basic_open (U f : Set)
  requires affine : IsAffineOpen(X, U)
  requires section : f ∈ sectionsOf(X, U)
  shows IsAffineOpen(X, sectionBasicOpen(X, U, f))
proof
  sorry

theorem IsAffineOpen.exists_basic_open_le (U V x : Set)
  requires affine : IsAffineOpen(X, U)
  requires open : V ∈ RingedSpace.opens(X)
  requires inside : V ⊆ U
  requires point : x ∈ V
  shows ∃ f ∈ sectionsOf(X, U), x ∈ sectionBasicOpen(X, U, f) ∧
    sectionBasicOpen(X, U, f) ⊆ V
proof
  sorry

-- The stalk at a point of an affine open U is the localization of O(U)
-- at the corresponding prime (IsAffineOpen.isLocalization_stalk).
theorem IsAffineOpen.stalk (U x : Set)
  requires affine : IsAffineOpen(X, U)
  requires point : x ∈ U
  shows ∃ φ, RingIso(φ, localizationAtPrime(RingedSpace.sections(X)(U),
      nonInvertibleAt(restrictSpace(X, U), x)), stalk(X, x))
proof
  sorry

-- A scheme is quasi-compact iff it is covered by finitely many affine
-- opens (OpenCover.finiteSubcover; QuasiCompact.compactSpace_of_compactSpace).
theorem Scheme.compact_finite_affine_cover
  requires compact : IsCompact(RingedSpace.points(X), RingedSpace.opens(X),
    RingedSpace.points(X))
  shows ∃ K, Finite(K) ∧ K ⊆ affineOpens(X) ∧ ⋃(K) = RingedSpace.points(X)
proof
  sorry

end AffineOpens

-- A locally ringed space isomorphic to a scheme is a scheme.
theorem Scheme.of_iso (m X Y : Set)
  requires scheme : Scheme(Y)
  requires iso : LocallyRingedIso(m, X, Y)
  shows Scheme(X)
proof
  sorry
