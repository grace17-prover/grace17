-- Points of schemes: residue fields κ(x) and the morphism Spec κ(x) → X;
-- morphisms from the spectrum of a field as pairs of a point and a field
-- embedding; closed points, of Spec of a local ring and of schemes of
-- finite type over a field or over ℤ (finite residue fields); generic
-- points and function fields; fibres over a point; and the functor of
-- points of a scheme on the test rings 𝒰, the link from schemes to the
-- spaces of the cohomology region (the source's `TestCohomology.lean:64`
-- and `algPoints`).
-- Part of the GRH blueprint.
-- Planned home: AlgebraicGeometry/ResidueField and AlgebraicGeometry/
-- FunctorOfPoints.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Scheme.Points
import GRH.Scheme.Morphisms

-- Section: Residue fields
-- κ(x), the residue field of the stalk (Scheme.residueField), and the
-- residue map O_X(U) → κ(x) of a section (Scheme.evaluation).
def residueFieldAt (X x : Set) : Set := residueField(stalk(X, x))

def evaluationAt (X U x : Set) : Set :=
  compose(residueMap(stalk(X, x)), germMap(X, U, x), sectionsOf(X, U),
    Ring.carrier(stalk(X, x)), Ring.carrier(residueFieldAt(X, x)))

-- The morphism Spec κ(x) → X (Scheme.fromSpecResidueField): the one point
-- goes to x, and a section s over V goes to the constant section with
-- value s(x) on the preimage of V.
def residuePointMap (X x : Set) : Set :=
  { (P, x) | P ∈ primeSpectrum(residueFieldAt(X, x)) }

def residueSheafComponent (X x V : Set) : Set :=
  { (s, localConstant(residueFieldAt(X, x),
      openPreimage(Spec(residueFieldAt(X, x)), residuePointMap(X, x), V),
      residueMap(stalk(X, x))(germMap(X, V, x)(s)))) | s ∈ sectionsOf(X, V) }

def residueSheafMap (X x : Set) : Set :=
  { (V, residueSheafComponent(X, x, V)) | V ∈ RingedSpace.opens(X) }

def fromSpecResidueField (X x : Set) : Set :=
  ((Spec(residueFieldAt(X, x)), X), (residuePointMap(X, x), residueSheafMap(X, x)))

-- The map κ(f(x)) → κ(x) of a morphism (Scheme.Hom.residueFieldMap).
def residueFieldMapAt (m x : Set) : Set :=
  residueFieldMap(stalkMap(m, x), stalk(homTarget(m), homPoints(m)(x)),
    stalk(homSource(m), x))

-- For X over Spec R through s, the map R → Γ(X) → κ(x) making κ(x) an
-- R-algebra.
def baseToGlobal (s R : Set) : Set :=
  compose(globalMap(s), specGlobalMap(R), Ring.carrier(R),
    Ring.carrier(globalSections(Spec(R))), Ring.carrier(globalSections(homSource(s))))

def baseToResidue (s R x : Set) : Set :=
  compose(evaluationAt(homSource(s), RingedSpace.points(homSource(s)), x),
    baseToGlobal(s, R), Ring.carrier(R), Ring.carrier(globalSections(homSource(s))),
    Ring.carrier(residueFieldAt(homSource(s), x)))

-- Section: Closed and generic points
-- x is a closed point: {x} is closed.
predicate ClosedPoint (X x : Set) :=
  x ∈ RingedSpace.points(X) ∧
  IsClosed(RingedSpace.points(X), RingedSpace.opens(X), {x})

-- The closed point of Spec R for a local ring R (IsLocalRing.closedPoint).
def closedPointOf (R : Set) : Set := localMaximalIdeal(R)

-- η is a generic point: its closure is the whole space.
predicate GenericPoint (X η : Set) :=
  η ∈ RingedSpace.points(X) ∧
  closure(RingedSpace.points(X), RingedSpace.opens(X), {η}) = RingedSpace.points(X)

-- An integral scheme: nonempty, with every ring of sections over a
-- nonempty open a domain (IsIntegral); its function field is the stalk at
-- the generic point (Scheme.functionField).
predicate IntegralScheme (X : Set) :=
  Scheme(X) ∧ RingedSpace.points(X) ≠ ∅ ∧
  (∀ U ∈ RingedSpace.opens(X), U ≠ ∅ → IntegralDomain(RingedSpace.sections(X)(U)))

def functionFieldAt (X η : Set) : Set := stalk(X, η)

-- Section: The functor of points
-- The data of morphisms X → Y lie in a set built from X and Y.
def homBound (X Y : Set) : Set :=
  {(X, Y)} × (𝒫(RingedSpace.points(X) × RingedSpace.points(Y)) ×
    𝒫(RingedSpace.opens(Y) × 𝒫(⋃(sectionCarriers(Y)) × ⋃(sectionCarriers(X)))))

-- X(A) = Hom(Spec A, X), the A-points of X (the functor of points).
def schemePoints (X A : Set) : Set :=
  { a ∈ homBound(Spec(A), X) | SchemeHom(a, Spec(A), X) }

-- The functor of points on the test rings, A ↦ Hom(Spec A, X), a ring map
-- u : A → B acting by precomposition with Spec(u)
-- (`Scheme.Spec.rightOp ⋙ uliftYoneda X`, TestCohomology.lean:64).
def pointsPrecompose (X A B u : Set) : Set :=
  { (a, compositeHom(a, specMap(u, A, B))) | a ∈ schemePoints(X, A) }

def pointsObjects (X : Set) : Set := { (A, schemePoints(X, A)) | A ∈ testRings }

def pointsMorphisms (X : Set) : Set :=
  { (m, setArrow(valueStage, schemePoints(X, snd(fst(m))),
      pointsPrecompose(X, fst(fst(m)), snd(fst(m)), snd(m)))) | m ∈ mor(testCategory) }

def pointsFunctor (X : Set) : Set :=
  Functor.mk(pointsObjects(X), pointsMorphisms(X), testCategory, valueSets)

-- A morphism m : X → Y acts on points by postcomposition.
def pointsPostcomposeAt (m A : Set) : Set :=
  { (a, compositeHom(m, a)) | a ∈ schemePoints(homSource(m), A) }

def pointsPostcompose (m : Set) : Set :=
  { (A, setArrow(valueStage, schemePoints(homTarget(m), A), pointsPostcomposeAt(m, A))) |
    A ∈ testRings }

-- Section: Laws of residue fields
section ResidueFields
variable (X : Set)
hypothesis scheme : Scheme(X)

theorem residueFieldAt.field (x : Set)
  requires point : x ∈ RingedSpace.points(X)
  shows Field(residueFieldAt(X, x))
proof
  sorry

theorem evaluationAt.hom (U x : Set)
  requires open : U ∈ RingedSpace.opens(X)
  requires point : x ∈ U
  shows RingHom(evaluationAt(X, U, x), RingedSpace.sections(X)(U), residueFieldAt(X, x))
proof
  sorry

-- A section is invertible at x iff its value in κ(x) is nonzero
-- (Scheme.evaluation_ne_zero_iff_mem_basicOpen).
theorem evaluationAt.ne_zero_iff (U x s : Set)
  requires open : U ∈ RingedSpace.opens(X)
  requires point : x ∈ U
  requires section : s ∈ sectionsOf(X, U)
  shows evaluationAt(X, U, x)(s) ≠ Ring.zero(residueFieldAt(X, x)) ↔
    x ∈ sectionBasicOpen(X, U, s)
proof
  sorry

theorem fromSpecResidueField.hom (x : Set)
  requires point : x ∈ RingedSpace.points(X)
  shows SchemeHom(fromSpecResidueField(X, x), Spec(residueFieldAt(X, x)), X)
proof
  sorry

-- Its image is {x} (Scheme.range_fromSpecResidueField).
theorem fromSpecResidueField.range (x : Set)
  requires point : x ∈ RingedSpace.points(X)
  shows functionImage(residuePointMap(X, x), primeSpectrum(residueFieldAt(X, x)),
    RingedSpace.points(X)) = {x}
proof
  sorry

-- At a point of an affine open U, κ(x) is the residue field of O(U) at
-- the corresponding prime (IsAffineOpen.primeIdealOf, residue fields
-- agree; PrimeSpectrum.residueField_comap).
theorem residueFieldAt.affine (U x : Set)
  requires affine : IsAffineOpen(X, U)
  requires point : x ∈ U
  shows ∃ φ, RingIso(φ, primeResidueField(RingedSpace.sections(X)(U),
    nonInvertibleAt(restrictSpace(X, U), x)), residueFieldAt(X, x))
proof
  sorry

-- Morphisms from the spectrum of a field K are the pairs of a point x and
-- an embedding κ(x) → K (Scheme.SpecToEquivOfField).
theorem fromSpecField.factor (K a : Set)
  requires field : Field(K)
  requires hom : SchemeHom(a, Spec(K), X)
  shows ∃ x ∈ RingedSpace.points(X), ∃ ι, RingHom(ι, residueFieldAt(X, x), K) ∧
    a = compositeHom(fromSpecResidueField(X, x), specMap(ι, residueFieldAt(X, x), K)) ∧
    (∀ y ∈ RingedSpace.points(X), ∀ ι2, RingHom(ι2, residueFieldAt(X, y), K) →
      a = compositeHom(fromSpecResidueField(X, y), specMap(ι2, residueFieldAt(X, y), K)) →
      y = x ∧ ι2 = ι)
proof
  sorry

end ResidueFields

-- The residue field maps of a morphism are field embeddings, functorial.
theorem residueFieldMapAt.hom (m X Y x : Set)
  requires hom : SchemeHom(m, X, Y)
  requires point : x ∈ RingedSpace.points(X)
  shows RingHom(residueFieldMapAt(m, x), residueFieldAt(Y, homPoints(m)(x)),
    residueFieldAt(X, x))
proof
  sorry

-- fromSpecResidueField commutes with morphisms:
-- m ∘ (Spec κ(x) → X) = (Spec κ(f x) → Y) ∘ Spec(κ(f x) → κ(x)).
theorem fromSpecResidueField.naturality (m X Y x : Set)
  requires hom : SchemeHom(m, X, Y)
  requires point : x ∈ RingedSpace.points(X)
  shows compositeHom(m, fromSpecResidueField(X, x)) =
    compositeHom(fromSpecResidueField(Y, homPoints(m)(x)),
      specMap(residueFieldMapAt(m, x), residueFieldAt(Y, homPoints(m)(x)),
        residueFieldAt(X, x)))
proof
  sorry

-- Section: Closed points
-- Spec of a local ring has the maximal ideal as its unique closed point
-- (IsLocalRing.closedPoint, isClosed_singleton_closedPoint).
theorem closedPointOf.closed (R : Set)
  requires local : LocalRing(R)
  shows ClosedPoint(Spec(R), closedPointOf(R)) ∧
    (∀ P, ClosedPoint(Spec(R), P) → P = closedPointOf(R))
proof
  sorry

-- A local homomorphism R → S of local rings sends the closed point of
-- Spec S to that of Spec R.
theorem closedPointOf.local_hom (f R S : Set)
  requires localR : LocalRing(R)
  requires localS : LocalRing(S)
  requires hom : LocalRingHom(f, R, S)
  shows specComap(f, R, S)(closedPointOf(S)) = closedPointOf(R)
proof
  sorry

-- The closed points of an affine scheme are the maximal ideals.
theorem ClosedPoint.spec_iff (R P : Set)
  requires comm : CommRing(R)
  shows ClosedPoint(Spec(R), P) ↔ MaximalIdeal(R, P)
proof
  sorry

-- A quasi-compact nonempty scheme has a closed point
-- (exists_closedPoint for quasi-compact spaces).
theorem ClosedPoint.exists (X : Set)
  requires scheme : Scheme(X)
  requires nonempty : RingedSpace.points(X) ≠ ∅
  requires compact : IsCompact(RingedSpace.points(X), RingedSpace.opens(X),
    RingedSpace.points(X))
  shows ∃ x, ClosedPoint(X, x)
proof
  sorry

-- For X locally of finite type over a field k, a point is closed iff its
-- residue field is finite over k (Hilbert's Nullstellensatz), and closed
-- points lie in every nonempty closed set (X is Jacobson).
theorem ClosedPoint.finite_over_field (s X k x : Set)
  requires field : Field(k)
  requires hom : SchemeHom(s, X, Spec(k))
  requires finiteType : LocallyOfFiniteType(s)
  requires point : x ∈ RingedSpace.points(X)
  shows ClosedPoint(X, x) ↔
    FiniteAlgebra(Algebra.mk(k, residueFieldAt(X, x), baseToResidue(s, k, x)))
proof
  sorry

theorem ClosedPoint.dense_in_closed (s X k Z : Set)
  requires field : Field(k)
  requires hom : SchemeHom(s, X, Spec(k))
  requires finiteType : LocallyOfFiniteType(s)
  requires closed : IsClosed(RingedSpace.points(X), RingedSpace.opens(X), Z)
  requires nonempty : Z ≠ ∅
  shows ∃ x ∈ Z, ClosedPoint(X, x)
proof
  sorry

-- For X locally of finite type over Spec R with R of finite type over ℤ
-- (a localization of a ring of integers, as for the integral models of
-- the source), the residue fields of closed points are finite.
theorem ClosedPoint.finite_residue_field (s X R x : Set)
  requires comm : CommRing(R)
  requires finitelyGenerated : ∃ G, G ⊆ Ring.carrier(R) ∧ Finite(G) ∧
    generatedSubring(Ring.carrier(R), Ring.add(R), Ring.zero(R), Ring.neg(R),
      Ring.mul(R), Ring.one(R), G) = Ring.carrier(R)
  requires hom : SchemeHom(s, X, Spec(R))
  requires finiteType : LocallyOfFiniteType(s)
  requires closed : ClosedPoint(X, x)
  shows Finite(Ring.carrier(residueFieldAt(X, x)))
proof
  sorry

-- Section: Generic points and function fields
section Integral
variable (X : Set)
hypothesis integral : IntegralScheme(X)

-- An integral scheme has a unique generic point, and its stalk there is
-- a field containing every ring of sections over a nonempty open
-- (Scheme.functionField, germToFunctionField injective).
theorem GenericPoint.exists_unique
  shows ∃ η, GenericPoint(X, η) ∧ (∀ ξ, GenericPoint(X, ξ) → ξ = η)
proof
  sorry

theorem functionFieldAt.field (η : Set)
  requires generic : GenericPoint(X, η)
  shows Field(functionFieldAt(X, η))
proof
  sorry

theorem functionFieldAt.germ_injective (η U : Set)
  requires generic : GenericPoint(X, η)
  requires open : U ∈ RingedSpace.opens(X)
  requires nonempty : U ≠ ∅
  shows InjectiveBetween(germMap(X, U, η), sectionsOf(X, U),
    Ring.carrier(functionFieldAt(X, η)))
proof
  sorry

end Integral

-- Section: Fibres
-- The fibre of m : X → Y over y, the base change along Spec κ(y) → Y, has
-- the points of X over y as its points, with the subspace topology
-- (Scheme.Hom.fiber, Spec.fiberToSpecResidueFieldIso; the points of a
-- fibre).
theorem fibre.points (m X Y y P p1 p2 : Set)
  requires hom : SchemeHom(m, X, Y)
  requires point : y ∈ RingedSpace.points(Y)
  requires pullback : IsSchemePullback(P, p1, p2, m, fromSpecResidueField(Y, y))
  shows IsHomeomorphism(homPoints(p1), RingedSpace.points(P), RingedSpace.opens(P),
    functionPreimage(homPoints(m), RingedSpace.points(X), {y}),
    subspaceTopology(RingedSpace.opens(X),
      functionPreimage(homPoints(m), RingedSpace.points(X), {y})))
proof
  sorry

-- A surjective morphism has nonempty fibres, and conversely.
theorem SurjectiveHom.iff_fibres (m X Y : Set)
  requires hom : SchemeHom(m, X, Y)
  shows SurjectiveHom(m) ↔ (∀ y ∈ RingedSpace.points(Y),
    ∃ x ∈ RingedSpace.points(X), homPoints(m)(x) = y)
proof
  sorry

-- A morphism to the spectrum of a field from the spectrum of a field
-- extension is surjective.
theorem SurjectiveHom.of_field (f K L : Set)
  requires first : Field(K)
  requires second : Field(L)
  requires hom : RingHom(f, K, L)
  shows SurjectiveHom(specMap(f, K, L))
proof
  sorry

-- Section: The functor of points
-- For a scheme X in V(θ), A ↦ X(A) is a space on the test rings: the
-- source's functor of points of a scheme (TestCohomology.lean:64), with
-- morphisms of schemes acting naturally.
theorem schemePoints.membership (X A a : Set)
  shows a ∈ schemePoints(X, A) ↔ SchemeHom(a, Spec(A), X)
proof
  sorry

theorem pointsFunctor.functor (X : Set)
  requires scheme : Scheme(X)
  requires small : X ∈ valueStage
  shows pointsFunctor(X) : testCategory ⥤ valueSets
proof
  sorry

theorem pointsPostcompose.natural (m X Y : Set)
  requires hom : SchemeHom(m, X, Y)
  requires small : X ∈ valueStage ∧ Y ∈ valueStage
  shows pointsPostcompose(m) : pointsFunctor(X) ⟹ pointsFunctor(Y)
proof
  sorry

-- The points of Spec R are the ring maps out of R: X(A) for X = Spec R is
-- the representable h_R (Spec.homEquiv, ΓSpec.adjunction), naturally.
def specPointsMap (R A : Set) : Set :=
  { (a, compose(globalMap(a), specGlobalMap(R), Ring.carrier(R),
      Ring.carrier(globalSections(Spec(R))), Ring.carrier(globalSections(Spec(A))))) |
    a ∈ schemePoints(Spec(R), A) }

def ringHomsBetween (R S : Set) : Set :=
  { f ∈ 𝒫(Ring.carrier(R) × Ring.carrier(S)) | RingHom(f, R, S) }

theorem specPointsMap.bijective (R A : Set)
  requires test : R ∈ testRings
  requires point : A ∈ testRings
  shows BijectiveBetween(specPointsMap(R, A), schemePoints(Spec(R), A),
    ringHomsBetween(R, globalSections(Spec(A))))
proof
  sorry

-- The functor of points on 𝒰 is faithful on schemes whose rings of
-- sections over affine opens are test rings: two morphisms X → Y that
-- agree on A-points for every test ring A are equal.
theorem pointsFunctor.faithful (m n X Y : Set)
  requires first : SchemeHom(m, X, Y)
  requires second : SchemeHom(n, X, Y)
  requires small : ∀ U ∈ affineOpens(X), RingedSpace.sections(X)(U) ∈ testRings
  requires agree : pointsPostcompose(m) = pointsPostcompose(n)
  shows m = n
proof
  sorry
