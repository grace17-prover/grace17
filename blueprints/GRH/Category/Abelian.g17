-- Additive and abelian categories, as the region uses them: zero objects
-- and zero morphisms, kernels, cokernels, exactness and short exact
-- sequences; preadditive and abelian categories; the abelian categories
-- of abelian groups, of modules and of abelian presheaves (functors from
-- a small site to the coefficient groups); additive and exact functors;
-- injective and projective objects; free abelian groups and the free
-- abelian presheaf ℤ[Y] on a space, projective on representables, and the
-- canonical projective cover of an abelian presheaf.
-- Part of the GRH blueprint.
-- Planned home: Category/Abelian, Category/Preadditive and
-- Algebra/Group/Free.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Category.Abelian
import GRH.Category.Basic
import Grace.Cumulus.Int.Ring
import Grace.Cumulus.Algebra.Group.Quotient

-- Section: Zero morphisms, kernels, cokernels and exactness
-- C has a zero object.
predicate HasZeroObject (C : Set) := ∃ z, ZeroObject(C, z)

-- f is a zero morphism: it factors through a zero object
-- (Limits.HasZeroMorphisms, with the zero morphisms of a category with a
-- zero object).
predicate ZeroMorphism (C f : Set) :=
  Category(C) ∧ f ∈ mor(C) ∧ (∃ z, ZeroObject(C, z) ∧
    (∃ u ∈ hom(C, dom(C)(f), z), ∃ v ∈ hom(C, z, cod(C)(f)),
      f = call2(Category.comp(C), v, u)))

-- k is a kernel of f: f ∘ k = 0, and every g with f ∘ g = 0 factors
-- uniquely through k (Limits.IsLimit of a KernelFork).
predicate IsKernel (C k f : Set) :=
  Category(C) ∧ k ∈ mor(C) ∧ f ∈ mor(C) ∧ cod(C)(k) = dom(C)(f) ∧
  ZeroMorphism(C, call2(Category.comp(C), f, k)) ∧
  (∀ x ∈ Category.obj(C), ∀ g ∈ hom(C, x, dom(C)(f)),
    ZeroMorphism(C, call2(Category.comp(C), f, g)) →
    (∃ u ∈ hom(C, x, dom(C)(k)), call2(Category.comp(C), k, u) = g ∧
      (∀ v ∈ hom(C, x, dom(C)(k)), call2(Category.comp(C), k, v) = g → v = u)))

-- c is a cokernel of f (Limits.IsColimit of a CokernelCofork).
predicate IsCokernel (C c f : Set) :=
  Category(C) ∧ c ∈ mor(C) ∧ f ∈ mor(C) ∧ dom(C)(c) = cod(C)(f) ∧
  ZeroMorphism(C, call2(Category.comp(C), c, f)) ∧
  (∀ x ∈ Category.obj(C), ∀ g ∈ hom(C, cod(C)(f), x),
    ZeroMorphism(C, call2(Category.comp(C), g, f)) →
    (∃ u ∈ hom(C, cod(C)(c), x), call2(Category.comp(C), u, c) = g ∧
      (∀ v ∈ hom(C, cod(C)(c), x), call2(Category.comp(C), v, c) = g → v = u)))

-- f then g is exact: g ∘ f = 0, and the kernel of g composed with the
-- cokernel of f is zero (ShortComplex.Exact, in its kernel–cokernel form,
-- equivalent in an abelian category).
predicate ExactAt (C f g : Set) :=
  Category(C) ∧ f ∈ mor(C) ∧ g ∈ mor(C) ∧ cod(C)(f) = dom(C)(g) ∧
  ZeroMorphism(C, call2(Category.comp(C), g, f)) ∧
  (∀ k, ∀ c, IsKernel(C, k, g) → IsCokernel(C, c, f) →
    ZeroMorphism(C, call2(Category.comp(C), c, k)))

-- 0 → A → B → C → 0 is short exact (ShortComplex.ShortExact).
predicate ShortExact (C f g : Set) :=
  ExactAt(C, f, g) ∧ Monomorphism(C, f) ∧ Epimorphism(C, g)

-- Section: Preadditive and abelian categories
-- The pairs of parallel morphisms, and the addition A on them restricted
-- to one hom-set.
def parallelPairs (C : Set) : Set :=
  { p ∈ mor(C) × mor(C) |
    dom(C)(fst(p)) = dom(C)(snd(p)) ∧ cod(C)(fst(p)) = cod(C)(snd(p)) }

def homAddition (C A a b : Set) : Set :=
  restrict(A, hom(C, a, b) × hom(C, a, b))

-- A preadditive category: each hom-set an abelian group under A, and
-- composition bilinear (CategoryTheory.Preadditive). The structure is the
-- addition A, a function on parallel pairs.
predicate Preadditive (C A : Set) :=
  Category(C) ∧ (A : parallelPairs(C) → mor(C)) ∧
  (∀ a b ∈ Category.obj(C), ∀ f g ∈ hom(C, a, b), A((f, g)) ∈ hom(C, a, b)) ∧
  (∀ a b ∈ Category.obj(C), ∃ z, ∃ n,
    AbelianGroup(Group.mk(hom(C, a, b), homAddition(C, A, a, b), z, n))) ∧
  (∀ a b c ∈ Category.obj(C), ∀ f ∈ hom(C, a, b), ∀ g h ∈ hom(C, b, c),
    call2(Category.comp(C), A((g, h)), f) =
      A((call2(Category.comp(C), g, f), call2(Category.comp(C), h, f)))) ∧
  (∀ a b c ∈ Category.obj(C), ∀ f g ∈ hom(C, a, b), ∀ h ∈ hom(C, b, c),
    call2(Category.comp(C), h, A((f, g))) =
      A((call2(Category.comp(C), h, f), call2(Category.comp(C), h, g))))

-- (p, i₁, i₂, π₁, π₂) is a biproduct of a and b (Limits.BinaryBiproduct):
-- πⱼ ∘ iⱼ = id, π₂ ∘ i₁ = 0, π₁ ∘ i₂ = 0, i₁π₁ + i₂π₂ = id.
predicate IsBiproduct (C A a b p i1 i2 q1 q2 : Set) :=
  Preadditive(C, A) ∧ i1 ∈ hom(C, a, p) ∧ i2 ∈ hom(C, b, p) ∧
  q1 ∈ hom(C, p, a) ∧ q2 ∈ hom(C, p, b) ∧
  call2(Category.comp(C), q1, i1) = Category.id(C)(a) ∧
  call2(Category.comp(C), q2, i2) = Category.id(C)(b) ∧
  ZeroMorphism(C, call2(Category.comp(C), q2, i1)) ∧
  ZeroMorphism(C, call2(Category.comp(C), q1, i2)) ∧
  A((call2(Category.comp(C), i1, q1), call2(Category.comp(C), i2, q2))) =
    Category.id(C)(p)

-- An abelian category (CategoryTheory.Abelian): preadditive with a zero
-- object, binary biproducts, kernels and cokernels, every monomorphism a
-- kernel and every epimorphism a cokernel.
predicate AbelianCategory (C A : Set) :=
  Preadditive(C, A) ∧ HasZeroObject(C) ∧
  (∀ a b ∈ Category.obj(C), ∃ p, ∃ i1, ∃ i2, ∃ q1, ∃ q2,
    IsBiproduct(C, A, a, b, p, i1, i2, q1, q2)) ∧
  (∀ f ∈ mor(C), ∃ k, IsKernel(C, k, f)) ∧
  (∀ f ∈ mor(C), ∃ c, IsCokernel(C, c, f)) ∧
  (∀ f ∈ mor(C), Monomorphism(C, f) → ∃ g, IsKernel(C, f, g)) ∧
  (∀ f ∈ mor(C), Epimorphism(C, f) → ∃ g, IsCokernel(C, f, g))

-- Additive functors (Functor.Additive) and exact functors: those that
-- send short exact sequences to short exact sequences (preserving finite
-- limits and colimits; ShortComplex.ShortExact.map_of_exact).
predicate AdditiveFunctor (Φ C A D B : Set) :=
  Functor(Φ, C, D) ∧ Preadditive(C, A) ∧ Preadditive(D, B) ∧
  (∀ p ∈ parallelPairs(C),
    Functor.map(Φ)(A(p)) = B((Functor.map(Φ)(fst(p)), Functor.map(Φ)(snd(p)))))

predicate ExactFunctor (Φ C D : Set) :=
  Functor(Φ, C, D) ∧
  (∀ f, ∀ g, ShortExact(C, f, g) → ShortExact(D, Functor.map(Φ)(f), Functor.map(Φ)(g)))

-- Section: Injective and projective objects
-- I is injective: maps into I extend along monomorphisms
-- (CategoryTheory.Injective); P is projective: maps out of P lift along
-- epimorphisms (CategoryTheory.Projective).
predicate Injective (C I : Set) :=
  Category(C) ∧ I ∈ Category.obj(C) ∧
  (∀ a b ∈ Category.obj(C), ∀ m ∈ hom(C, a, b), ∀ f ∈ hom(C, a, I),
    Monomorphism(C, m) → (∃ g ∈ hom(C, b, I), call2(Category.comp(C), g, m) = f))

predicate Projective (C P : Set) :=
  Category(C) ∧ P ∈ Category.obj(C) ∧
  (∀ a b ∈ Category.obj(C), ∀ e ∈ hom(C, a, b), ∀ f ∈ hom(C, P, b),
    Epimorphism(C, e) → (∃ g ∈ hom(C, P, a), call2(Category.comp(C), e, g) = f))

predicate EnoughInjectives (C : Set) :=
  Category(C) ∧ (∀ a ∈ Category.obj(C), ∃ I, ∃ m ∈ hom(C, a, I),
    Injective(C, I) ∧ Monomorphism(C, m))

predicate EnoughProjectives (C : Set) :=
  Category(C) ∧ (∀ a ∈ Category.obj(C), ∃ P, ∃ e ∈ hom(C, P, a),
    Projective(C, P) ∧ Epimorphism(C, e))

-- Section: The additions of the concrete abelian categories
-- f + g for homomorphisms G → H, and 0, −f.
def pointwiseGroupSum (G H f g : Set) : Set :=
  { (x, call2(Group.mul(H), f(x), g(x))) | x ∈ Group.carrier(G) }

def zeroGroupHom (G H : Set) : Set := { (x, Group.one(H)) | x ∈ Group.carrier(G) }

def negGroupHom (G H f : Set) : Set :=
  { (x, Group.inv(H)(f(x))) | x ∈ Group.carrier(G) }

-- The addition of the category of abelian groups in U: on ((G, H), f) and
-- ((G, H), g) it gives ((G, H), f + g).
def groupHomAddition (U : Set) : Set :=
  { (p, (fst(fst(p)), pointwiseGroupSum(fst(fst(fst(p))), snd(fst(fst(p))),
      snd(fst(p)), snd(snd(p))))) | p ∈ parallelPairs(abelianGroupCategory(U)) }

-- The addition of the category of R-modules in U.
def pointwiseModuleSum (M N f g : Set) : Set :=
  { (x, call2(Module.add(N), f(x), g(x))) | x ∈ Module.carrier(M) }

def moduleHomAddition (U R : Set) : Set :=
  { (p, (fst(fst(p)), pointwiseModuleSum(fst(fst(fst(p))), snd(fst(fst(p))),
      snd(fst(p)), snd(snd(p))))) | p ∈ parallelPairs(moduleCategory(U, R)) }

-- The addition of a functor category into a preadditive category,
-- componentwise: (η + θ)(a) = η(a) + θ(a).
def componentSum (C A η θ : Set) : Set :=
  { (a, A((η(a), θ(a)))) | a ∈ Category.obj(C) }

def transformationAddition (C D A : Set) : Set :=
  { (p, (fst(fst(p)), componentSum(C, A, snd(fst(p)), snd(snd(p))))) |
    p ∈ parallelPairs(functorCategory(C, D)) }

-- Abelian presheaves on a site C: functors C ⥤ Ab(V(θ)), the source's
-- `AbFunctor C := C ⥤ AddCommGrpCat.{1}` (Defs.lean:27), with their
-- addition.
def coefficientCategory (C : Set) : Set := functorCategory(C, coefficientGroups)

def coefficientAddition (C : Set) : Set :=
  transformationAddition(C, coefficientGroups, groupHomAddition(valueStage))

-- The sites the region computes on: categories whose objects and
-- morphisms are members of V(θ) and inject into V(ω·2), so that hom-sets
-- are values of spaces and products and sums indexed by the site stay in
-- V(θ). Every site cut from 𝒰 is one (SmallSite.test_category below), and
-- so is the category of elements of a space with values of cardinality
-- at most that of V(ω·2).
predicate SmallSite (C : Set) :=
  Category(C) ∧ Category.obj(C) ⊆ valueStage ∧ mor(C) ⊆ valueStage ∧
  (∃ f, InjectiveBetween(f, mor(C), testStage)) ∧
  (∃ f, InjectiveBetween(f, Category.obj(C), testStage))

-- Section: Exactness of abelian groups
-- The image of f and the kernel of g, as subsets of the carriers.
def groupImage (f G H : Set) : Set :=
  functionImage(f, Group.carrier(G), Group.carrier(H))

def groupKernel (g H K : Set) : Set :=
  { y ∈ Group.carrier(H) | g(y) = Group.one(K) }

-- A subgroup with the restricted operations.
def restrictedGroup (G K : Set) : Set :=
  Group.mk(K, restrict(Group.mul(G), K × K), Group.one(G),
    restrict(Group.inv(G), K))

-- Section: Free abelian groups
-- ℤ[X]: the finitely supported functions X → ℤ under pointwise addition
-- (FreeAbelianGroup, Finsupp X ℤ).
def freeCarrier (X : Set) : Set :=
  { u ∈ functionSpace(X, ℤ) | Finite(functionSupport(u, X, integerZero)) }

def freeSum (X u v : Set) : Set := { (x, call2(integerAdd, u(x), v(x))) | x ∈ X }

def freeAddition (X : Set) : Set :=
  { (p, freeSum(X, fst(p), snd(p))) | p ∈ freeCarrier(X) × freeCarrier(X) }

def freeZero (X : Set) : Set := { (x, integerZero) | x ∈ X }

def freeNeg (X u : Set) : Set := { (x, integerNeg(u(x))) | x ∈ X }

def freeNegation (X : Set) : Set := { (u, freeNeg(X, u)) | u ∈ freeCarrier(X) }

def freeAbelianGroup (X : Set) : Set :=
  Group.mk(freeCarrier(X), freeAddition(X), freeZero(X), freeNegation(X))

-- The generator [x]: 1 at x and 0 elsewhere (FreeAbelianGroup.of).
def freeGenerator (X x : Set) : Set :=
  { p ∈ X × ℤ | (p = (x, integerOne)) ∨
    (∃ y ∈ X, y ≠ x ∧ p = (y, integerZero)) }

-- The homomorphism ℤ[X] → G extending g : X → G (FreeAbelianGroup.lift),
-- the unique one sending [x] to g(x).
defunique freeLift (X G g : Set)
    (h ∈ functionSpace(freeCarrier(X), Group.carrier(G))) :=
  AdditiveHom(h, freeAbelianGroup(X), G) ∧
  (∀ x ∈ X, h(freeGenerator(X, x)) = g(x))
requires group : AbelianGroup(G)
requires values : g : X → Group.carrier(G)
proof
  sorry
uniqueness
  sorry

-- ℤ[f] : ℤ[X] → ℤ[Y] for f : X → Y (FreeAbelianGroup.map).
def generatorMap (X Y f : Set) : Set := { (x, freeGenerator(Y, f(x))) | x ∈ X }

def freeMap (X Y f : Set) : Set :=
  freeLift(X, freeAbelianGroup(Y), generatorMap(X, Y, f))

-- The free abelian presheaf ℤ[Y] on a space Y : C ⥤ valueSets, objectwise
-- (the source's `freeAb`, Defs.lean:61).
def freePresheafObjects (Y C : Set) : Set :=
  { (a, freeAbelianGroup(Functor.obj(Y)(a))) | a ∈ Category.obj(C) }

def freePresheafMorphisms (Y C : Set) : Set :=
  { (f, ((freeAbelianGroup(Functor.obj(Y)(dom(C)(f))),
        freeAbelianGroup(Functor.obj(Y)(cod(C)(f)))),
      freeMap(Functor.obj(Y)(dom(C)(f)), Functor.obj(Y)(cod(C)(f)),
        Functor.map(Y)(f)))) | f ∈ mor(C) }

def freePresheaf (Y C : Set) : Set :=
  Functor.mk(freePresheafObjects(Y, C), freePresheafMorphisms(Y, C), C,
    coefficientGroups)

-- ℤ[h_A], the free abelian presheaf on the representable at A.
def freeRepresentable (C A : Set) : Set := freePresheaf(representableOn(C, A), C)

-- Section: The canonical projective cover
-- For an abelian presheaf N, the space of its elements over each B:
-- triples ((A, x), f) with x ∈ N(A) and f : A ⟶ B. ℤ of it is the sum
-- ⊕_{(A, x)} ℤ[h_A], and ((A, x), f) ↦ N(f)(x) is onto N.
def presheafValues (N C : Set) : Set :=
  { Group.carrier(Functor.obj(N)(a)) | a ∈ Category.obj(C) }

def coverElements (N C b : Set) : Set :=
  { e ∈ (Category.obj(C) × ⋃(presheafValues(N, C))) × mor(C) |
    ∃ a ∈ Category.obj(C), ∃ x ∈ Group.carrier(Functor.obj(N)(a)),
      ∃ f ∈ hom(C, a, b), e = ((a, x), f) }

def coverShift (N C g : Set) : Set :=
  { (e, (fst(e), call2(Category.comp(C), g, snd(e)))) |
    e ∈ coverElements(N, C, dom(C)(g)) }

def coverSpaceObjects (N C : Set) : Set :=
  { (b, coverElements(N, C, b)) | b ∈ Category.obj(C) }

def coverSpaceMorphisms (N C : Set) : Set :=
  { (g, setArrow(valueStage, coverElements(N, C, cod(C)(g)), coverShift(N, C, g))) |
    g ∈ mor(C) }

def coverSpace (N C : Set) : Set :=
  Functor.mk(coverSpaceObjects(N, C), coverSpaceMorphisms(N, C), C, valueSets)

def canonicalCover (N C : Set) : Set := freePresheaf(coverSpace(N, C), C)

-- The augmentation ℤ[elements] ⟶ N, ((A, x), f) ↦ N(f)(x).
def coverEvaluation (N C b : Set) : Set :=
  { (e, snd(Functor.map(N)(snd(e)))(snd(fst(e)))) | e ∈ coverElements(N, C, b) }

def coverAugmentation (N C : Set) : Set :=
  { (b, ((freeAbelianGroup(coverElements(N, C, b)), Functor.obj(N)(b)),
      freeLift(coverElements(N, C, b), Functor.obj(N)(b), coverEvaluation(N, C, b)))) |
    b ∈ Category.obj(C) }

-- Section: Kernels of abelian presheaves
-- The kernel of η : F ⟹ G, objectwise ker η(a) with the restricted maps.
def kernelGroupAt (η F G a : Set) : Set :=
  restrictedGroup(Functor.obj(F)(a),
    groupKernel(snd(η(a)), Functor.obj(F)(a), Functor.obj(G)(a)))

def kernelPresheafObjects (η F G C : Set) : Set :=
  { (a, kernelGroupAt(η, F, G, a)) | a ∈ Category.obj(C) }

def kernelPresheafMorphisms (η F G C : Set) : Set :=
  { (f, ((kernelGroupAt(η, F, G, dom(C)(f)), kernelGroupAt(η, F, G, cod(C)(f))),
      restrict(snd(Functor.map(F)(f)),
        groupKernel(snd(η(dom(C)(f))), Functor.obj(F)(dom(C)(f)),
          Functor.obj(G)(dom(C)(f)))))) | f ∈ mor(C) }

def kernelPresheaf (η F G C : Set) : Set :=
  Functor.mk(kernelPresheafObjects(η, F, G, C), kernelPresheafMorphisms(η, F, G, C),
    C, coefficientGroups)

-- The inclusion ker η ⟶ F.
def kernelInclusion (η F G C : Set) : Set :=
  { (a, ((kernelGroupAt(η, F, G, a), Functor.obj(F)(a)),
      identity(groupKernel(snd(η(a)), Functor.obj(F)(a), Functor.obj(G)(a))))) |
    a ∈ Category.obj(C) }

-- Section: Laws in a category
section CategoryLaws
variable (C : Set)
hypothesis category : Category(C)

-- Kernels and cokernels are unique up to isomorphism, and a kernel is a
-- monomorphism, a cokernel an epimorphism.
theorem IsKernel.mono (k f : Set)
  requires kernel : IsKernel(C, k, f)
  shows Monomorphism(C, k)
proof
  sorry

theorem IsCokernel.epi (c f : Set)
  requires cokernel : IsCokernel(C, c, f)
  shows Epimorphism(C, c)
proof
  sorry

theorem IsKernel.unique (k l f : Set)
  requires first : IsKernel(C, k, f)
  requires second : IsKernel(C, l, f)
  shows ∃ u ∈ hom(C, dom(C)(l), dom(C)(k)), Isomorphism(C, u) ∧
    call2(Category.comp(C), k, u) = l
proof
  sorry

-- A morphism is zero iff it factors through some, equivalently every,
-- zero object.
theorem ZeroMorphism.comp_left (f g : Set)
  requires zero : ZeroMorphism(C, f)
  requires arrow : g ∈ mor(C)
  requires composable : dom(C)(g) = cod(C)(f)
  shows ZeroMorphism(C, call2(Category.comp(C), g, f))
proof
  sorry

theorem ZeroMorphism.comp_right (f g : Set)
  requires zero : ZeroMorphism(C, g)
  requires arrow : f ∈ mor(C)
  requires composable : dom(C)(g) = cod(C)(f)
  shows ZeroMorphism(C, call2(Category.comp(C), g, f))
proof
  sorry

-- ShortComplex.exact_kernel / exact_cokernel: a kernel and its morphism,
-- a morphism and its cokernel, are exact.
theorem ExactAt.kernel (k f : Set)
  requires abelian : ∃ A, AbelianCategory(C, A)
  requires kernel : IsKernel(C, k, f)
  shows ExactAt(C, k, f)
proof
  sorry

theorem ExactAt.cokernel (c f : Set)
  requires abelian : ∃ A, AbelianCategory(C, A)
  requires cokernel : IsCokernel(C, c, f)
  shows ExactAt(C, f, c)
proof
  sorry

-- Isomorphisms are exactly the monomorphisms that are epimorphisms, in an
-- abelian category (Abelian.isIso_of_mono_of_epi).
theorem AbelianCategory.iso_of_mono_epi (A f : Set)
  requires abelian : AbelianCategory(C, A)
  requires mono : Monomorphism(C, f)
  requires epi : Epimorphism(C, f)
  shows Isomorphism(C, f)
proof
  sorry

-- An injective object splits every monomorphism out of it, and Hom(−, I)
-- is exact (injective_of_mono, Injective.factorThru).
theorem Injective.split (I b m : Set)
  requires injective : Injective(C, I)
  requires arrow : m ∈ hom(C, I, b)
  requires mono : Monomorphism(C, m)
  shows ∃ r ∈ hom(C, b, I), call2(Category.comp(C), r, m) = Category.id(C)(I)
proof
  sorry

theorem Projective.split (P b e : Set)
  requires projective : Projective(C, P)
  requires arrow : e ∈ hom(C, b, P)
  requires epi : Epimorphism(C, e)
  shows ∃ s ∈ hom(C, P, b), call2(Category.comp(C), e, s) = Category.id(C)(P)
proof
  sorry

-- Objects isomorphic to injective (projective) objects are injective
-- (projective).
theorem Injective.of_iso (I J u : Set)
  requires injective : Injective(C, I)
  requires arrow : u ∈ hom(C, I, J)
  requires iso : Isomorphism(C, u)
  shows Injective(C, J)
proof
  sorry

theorem Projective.of_iso (P Q u : Set)
  requires projective : Projective(C, P)
  requires arrow : u ∈ hom(C, P, Q)
  requires iso : Isomorphism(C, u)
  shows Projective(C, Q)
proof
  sorry

end CategoryLaws

-- Section: Abelian groups, modules and abelian presheaves
-- Ab(U) is abelian for U = V(θ) (and for every limit stage); so is the
-- category of R-modules in V(θ).
theorem coefficientGroups.abelian
  shows AbelianCategory(coefficientGroups, groupHomAddition(valueStage))
proof
  sorry

theorem moduleCategory.abelian (R : Set)
  requires ring : CommRing(R)
  requires stage : R ∈ valueStage
  shows AbelianCategory(moduleCategory(valueStage, R), moduleHomAddition(valueStage, R))
proof
  sorry

-- The category of abelian presheaves on a site is abelian, with kernels,
-- cokernels and exactness objectwise (Functor.category abelian).
theorem coefficientCategory.abelian (C : Set)
  requires site : Category(C)
  shows AbelianCategory(coefficientCategory(C), coefficientAddition(C))
proof
  sorry

-- A preadditive category of functors: a functor category into a
-- preadditive category, with the componentwise addition.
theorem transformationAddition.preadditive (C D A : Set)
  requires site : Category(C)
  requires preadditive : Preadditive(D, A)
  shows Preadditive(functorCategory(C, D), transformationAddition(C, D, A))
proof
  sorry

-- Zero morphisms of abelian groups are the constant maps to the unit
-- (Hom.zero_def).
theorem coefficientGroups.zero_morphism (G H f : Set)
  requires first : G ∈ abelianGroupsIn(valueStage)
  requires second : H ∈ abelianGroupsIn(valueStage)
  requires arrow : ((G, H), f) ∈ mor(coefficientGroups)
  shows ZeroMorphism(coefficientGroups, ((G, H), f)) ↔ f = zeroGroupHom(G, H)
proof
  sorry

-- ShortComplex.ab_exact_iff_function_exact: in Ab, exactness is image =
-- kernel; ab_injective_f, ab_surjective_g: a short exact sequence has f
-- injective and g surjective, and conversely.
theorem coefficientGroups.exact_iff (G H K f g : Set)
  requires first : ((G, H), f) ∈ mor(coefficientGroups)
  requires second : ((H, K), g) ∈ mor(coefficientGroups)
  shows ExactAt(coefficientGroups, ((G, H), f), ((H, K), g)) ↔
    groupImage(f, G, H) = groupKernel(g, H, K)
proof
  sorry

theorem coefficientGroups.short_exact_iff (G H K f g : Set)
  requires first : ((G, H), f) ∈ mor(coefficientGroups)
  requires second : ((H, K), g) ∈ mor(coefficientGroups)
  shows ShortExact(coefficientGroups, ((G, H), f), ((H, K), g)) ↔
    (InjectiveBetween(f, Group.carrier(G), Group.carrier(H)) ∧
      SurjectiveBetween(g, Group.carrier(H), Group.carrier(K)) ∧
      groupImage(f, G, H) = groupKernel(g, H, K))
proof
  sorry

-- Exactness of abelian presheaves is objectwise: a sequence is short exact
-- iff its evaluation at every object is (evaluation is exact and jointly
-- reflects exactness).
theorem coefficientCategory.short_exact_iff (C F G H η θ : Set)
  requires site : Category(C)
  requires first : ((F, G), η) ∈ mor(coefficientCategory(C))
  requires second : ((G, H), θ) ∈ mor(coefficientCategory(C))
  shows ShortExact(coefficientCategory(C), ((F, G), η), ((G, H), θ)) ↔
    (∀ a ∈ Category.obj(C), ShortExact(coefficientGroups, η(a), θ(a)))
proof
  sorry

theorem evaluationFunctor.exact (C a : Set)
  requires site : Category(C)
  requires object : a ∈ Category.obj(C)
  shows ExactFunctor(evaluationFunctor(C, coefficientGroups, a),
    coefficientCategory(C), coefficientGroups)
proof
  sorry

-- Restriction along a functor of sites is exact and additive (the
-- source's `restrictAlong`, Defs.lean:115).
theorem restrictAlong.exact (Φ E C : Set)
  requires along : Φ : E ⥤ C
  shows ExactFunctor(restrictAlong(Φ, E, C, coefficientGroups),
    coefficientCategory(C), coefficientCategory(E)) ∧
    AdditiveFunctor(restrictAlong(Φ, E, C, coefficientGroups),
      coefficientCategory(C), coefficientAddition(C),
      coefficientCategory(E), coefficientAddition(E))
proof
  sorry

-- Kernels of abelian presheaves are computed objectwise.
theorem kernelPresheaf.kernel (C F G η : Set)
  requires site : Category(C)
  requires arrow : ((F, G), η) ∈ mor(coefficientCategory(C))
  shows kernelPresheaf(η, F, G, C) : C ⥤ coefficientGroups ∧
    IsKernel(coefficientCategory(C),
      ((kernelPresheaf(η, F, G, C), F), kernelInclusion(η, F, G, C)), ((F, G), η))
proof
  sorry

-- Section: Sites
-- The test category and the over- and full subcategories cut from it are
-- small sites.
theorem SmallSite.test_category
  shows SmallSite(testCategory)
proof
  sorry

theorem SmallSite.full_subcategory (C P : Set)
  requires site : SmallSite(C)
  requires subset : P ⊆ Category.obj(C)
  shows SmallSite(fullSubcategory(C, P))
proof
  sorry

theorem SmallSite.over (C X : Set)
  requires site : SmallSite(C)
  requires object : X ∈ Category.obj(C)
  shows SmallSite(overCategory(C, X)) ∧ SmallSite(underCategory(C, X))
proof
  sorry

theorem SmallSite.test_algebras (A : Set)
  requires test : A ∈ testRings
  shows SmallSite(testAlgebraCategory(A))
proof
  sorry

-- Section: Injectives and projectives of abelian groups and presheaves
-- A divisible abelian group is injective (Baer's criterion for ℤ;
-- AddCommGrp.injective_of_divisible), and Ab(V(θ)) has enough injectives.
predicate DivisibleGroup (G : Set) :=
  AbelianGroup(G) ∧ (∀ y ∈ Group.carrier(G), ∀ n ∈ ℕ, n ≠ (0:N) →
    (∃ x ∈ Group.carrier(G), monoidPow(Group.mul(G), Group.one(G), x, n) = y))

theorem DivisibleGroup.injective (G : Set)
  requires member : G ∈ abelianGroupsIn(valueStage)
  requires divisible : DivisibleGroup(G)
  shows Injective(coefficientGroups, G)
proof
  sorry

theorem coefficientGroups.enough_injectives
  shows EnoughInjectives(coefficientGroups)
proof
  sorry

-- Abelian presheaves on a small site have enough injectives: F embeds in
-- ∏_A R_A(Q(F(A))), with R_A right adjoint to evaluation at A and Q a
-- divisible envelope (the source's IsGrothendieckAbelian, used at
-- Functoriality.lean:36). Uses Choice.
theorem coefficientCategory.enough_injectives (C : Set)
  requires site : SmallSite(C)
  shows EnoughInjectives(coefficientCategory(C))
proof
  sorry

-- ℤ[X] is free on the generators (FreeAbelianGroup.lift.of), and ℤ[X] is
-- a member of V(θ) for X ∈ V(θ).
theorem freeAbelianGroup.abelian (X : Set)
  shows AbelianGroup(freeAbelianGroup(X))
proof
  sorry

theorem freeAbelianGroup.stage (X : Set)
  requires member : X ∈ valueStage
  shows freeAbelianGroup(X) ∈ abelianGroupsIn(valueStage)
proof
  sorry

theorem freeLift.generator (X G g x : Set)
  requires group : AbelianGroup(G)
  requires values : g : X → Group.carrier(G)
  requires point : x ∈ X
  shows freeLift(X, G, g)(freeGenerator(X, x)) = g(x)
proof
  sorry

theorem freeLift.hom (X G g : Set)
  requires group : AbelianGroup(G)
  requires values : g : X → Group.carrier(G)
  shows AdditiveHom(freeLift(X, G, g), freeAbelianGroup(X), G)
proof
  sorry

theorem freeLift.eq_of_generators (X G g h : Set)
  requires group : AbelianGroup(G)
  requires values : g : X → Group.carrier(G)
  requires hom : AdditiveHom(h, freeAbelianGroup(X), G)
  requires agrees : ∀ x ∈ X, h(freeGenerator(X, x)) = g(x)
  shows h = freeLift(X, G, g)
proof
  sorry

-- The free abelian presheaf on a space is an abelian presheaf, and it is
-- left adjoint to the forgetful functor: Hom(ℤ[Y], F) ≅ Hom(Y, F) as sets.
theorem freePresheaf.functor (Y C : Set)
  requires site : SmallSite(C)
  requires space : Y : C ⥤ valueSets
  shows freePresheaf(Y, C) : C ⥤ coefficientGroups
proof
  sorry

-- ℤ[h_A] is projective (the source's `Projective (freeAb (reprBy A))`,
-- WitnessCocycles.lean:35), and Hom(ℤ[h_A], F) ≅ F(A) by evaluation at
-- [id_A] (homReprEquiv).
theorem freeRepresentable.projective (C A : Set)
  requires site : SmallSite(C)
  requires object : A ∈ Category.obj(C)
  shows Projective(coefficientCategory(C), freeRepresentable(C, A))
proof
  sorry

def representableEvaluation (C A F : Set) : Set :=
  { (η, snd(η(A))(freeGenerator(hom(C, A, A), Category.id(C)(A)))) |
    η ∈ NatTrans(freeRepresentable(C, A), F) }

theorem freeRepresentable.hom_equiv (C A F : Set)
  requires site : SmallSite(C)
  requires object : A ∈ Category.obj(C)
  requires presheaf : F : C ⥤ coefficientGroups
  shows BijectiveBetween(representableEvaluation(C, A, F),
    NatTrans(freeRepresentable(C, A), F), Group.carrier(Functor.obj(F)(A)))
proof
  sorry

-- The canonical cover: ℤ of the elements of N is projective, and the
-- augmentation is an epimorphism onto N. Hence enough projectives.
theorem canonicalCover.projective (N C : Set)
  requires site : SmallSite(C)
  requires presheaf : N : C ⥤ coefficientGroups
  shows Projective(coefficientCategory(C), canonicalCover(N, C))
proof
  sorry

theorem coverAugmentation.epi (N C : Set)
  requires site : SmallSite(C)
  requires presheaf : N : C ⥤ coefficientGroups
  shows ((canonicalCover(N, C), N), coverAugmentation(N, C)) ∈
      hom(coefficientCategory(C), canonicalCover(N, C), N) ∧
    Epimorphism(coefficientCategory(C),
      ((canonicalCover(N, C), N), coverAugmentation(N, C)))
proof
  sorry

theorem coefficientCategory.enough_projectives (C : Set)
  requires site : SmallSite(C)
  shows EnoughProjectives(coefficientCategory(C))
proof
  sorry

-- Biproducts and products of abelian presheaves (the source's
-- `piAbFunctor`, Defs.lean:197, indexed by a set in V(ω·2)).
theorem coefficientCategory.biproduct (C F G : Set)
  requires site : Category(C)
  requires first : F ∈ Category.obj(coefficientCategory(C))
  requires second : G ∈ Category.obj(coefficientCategory(C))
  shows ∃ p, ∃ i1, ∃ i2, ∃ q1, ∃ q2,
    IsBiproduct(coefficientCategory(C), coefficientAddition(C), F, G, p, i1, i2, q1, q2)
proof
  sorry
