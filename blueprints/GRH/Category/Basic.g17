-- The categories of the cohomology region, as sets: the stages V(ω·2) and
-- V(θ) of the cumulative hierarchy, the set 𝒰 of test rings (commutative
-- rings in V(ω·2)) and its closure under the constructions the region
-- performs; full subcategories, concrete categories (rings, algebras,
-- abelian groups and modules with carriers in a stage), over- and
-- under-categories, functor categories, spaces and representables,
-- subfunctors, and pullbacks. Built on Cumulus `Category`. No large
-- cardinal: every category here is a set that ZFC proves exists.
-- Part of the GRH blueprint.
-- Planned home: Category/Concrete, Category/Over, Category/FunctorCategory,
-- Category/Subfunctor, Category/Pullback and Set/Stage.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Category.Basic
import GRH.Algebra.Flat
import Grace.Cumulus.Category.Yoneda
import Grace.Cumulus.Set.Hierarchy

-- Section: The stages
-- α + n by recursion on n, and α + ω as the union of the α + n. The
-- ordinal ω·2 = ω + ω and ω·3 = ω·2 + ω are written without ordinal
-- arithmetic, so that the definitions name the sets directly.
def ordinalShift (α : Set, n : Nat) → Set
  | α, zero => α
  | α, succ(k) => next(ordinalShift(α, k))

def ordinalShifts (α : Set) : Set := { ordinalShift(α, n) | n ∈ ℕ }

def plusOmega (α : Set) : Set := ⋃(ordinalShifts(α))

def omegaTwo : Set := plusOmega(ω)

-- The stage of the test rings: V(ω·2), a model of Zermelo set theory, of
-- cardinality ℶ_ω (README, Universes). It plays the part of Lean's
-- `Type 0` in the region: every ring that serves as a point lies here.
def testStage : Set := V(omegaTwo)

-- The stage of the values of spaces and coefficients: V(θ) for θ the
-- Hartogs ordinal of V(ω·2), the least ordinal that does not inject into
-- V(ω·2). θ is a regular cardinal above ℶ_ω (with Choice), so V(θ) holds
-- every family of fewer than θ of its members: sums and products indexed
-- by the test category, injective envelopes, free resolutions. It plays
-- the part of Lean's `Type 1` (`AbFunctor C := C ⥤ AddCommGrpCat.{1}`).
def valueStage : Set := V(hartogsBound(testStage))

-- Section: Facts about the stages
theorem ordinalShift.ordinal (α : Set, n : Nat)
  requires ordinal : α ∈ Ordinal
  shows ordinalShift(α, n) ∈ Ordinal
proof
  induction n
  | zero =>
    rw ordinalShift
    exact ordinal
  | succ(k) using ih =>
    rw ordinalShift
    exact Ordinal.next with ih

theorem tkInext.member (β γ : Set)
  requires ordinal : γ ∈ Ordinal
  requires member : β ∈ γ
  shows next(β) ∈ next(γ)
proof
  have βO := Ordinal.member with ordinal, member
  have nO := Ordinal.next with βO
  have tr := Ordinal.transitive with ordinal
  have sub : next(β) ⊆ γ
    intros x xIn
    have cases := next.membership.forward with xIn
    cases cases with inB | isB
    . have bSub := tr with β, member
      exact bSub with x, inB
    . rw isB
      exact member
  exact Ordinal.subset_bound with nO, ordinal, sub

theorem plusOmega.contains (α : Set, n : Nat)
  requires ordinal : α ∈ Ordinal
  shows ordinalShift(α, n) ∈ plusOmega(α)
proof
  have succIn : succ(n) ∈ ℕ by typecheck
  have inShifts : ordinalShift(α, succ(n)) ∈ ordinalShifts(α) :=
    ordinalShifts.membership.backward with ⟨succ(n), succIn, rfl⟩
  have self : ordinalShift(α, n) ∈ ordinalShift(α, succ(n))
    rw ordinalShift
    exact next.contains at ordinalShift(α, n)
  unfold plusOmega
  exact set.union.backward with ⟨ordinalShift(α, succ(n)), inShifts, self⟩

theorem plusOmega.limit (α : Set)
  requires ordinal : α ∈ Ordinal
  shows Limit(plusOmega(α))
proof
  have ords : ∀ x ∈ ordinalShifts(α), x ∈ Ordinal
    intros x xIn
    obtain ⟨n, nIn, e⟩ := ordinalShifts.membership.forward with xIn
    have nNat : Nat(n) := nIn
    have o := ordinalShift.ordinal at α, n with ordinal
    rw ← e
    exact o
  have lo := Ordinal.union with ords
  have zeroShift : ordinalShift(α, 0) = α
    rw ordinalShift
  have c := plusOmega.contains at α, 0 with ordinal
  rw zeroShift at c
  refine ⟨?_, ?_, ?_⟩
  . unfold plusOmega
    exact lo
  . intro empty
    rw empty at c
    exact set.empty with c
  . intros β βIn
    unfold plusOmega at βIn
    obtain ⟨X, XIn, βX⟩ := set.union.forward with βIn
    obtain ⟨n, nIn, e⟩ := ordinalShifts.membership.forward with XIn
    have nNat : Nat(n) := nIn
    rw ← e at βX
    have o := ordinalShift.ordinal at α, n with ordinal
    have nx := tkInext.member with o, βX
    have succShift : ordinalShift(α, succ(n)) = next(ordinalShift(α, n))
      rw ordinalShift
    rw ← succShift at nx
    have succIn : succ(n) ∈ ℕ by typecheck
    have inShifts : ordinalShift(α, succ(n)) ∈ ordinalShifts(α) :=
      ordinalShifts.membership.backward with ⟨succ(n), succIn, rfl⟩
    unfold plusOmega
    exact set.union.backward with ⟨ordinalShift(α, succ(n)), inShifts, nx⟩

-- ω ∈ ω·2, and ω·2 is a limit ordinal.
theorem omegaTwo.limit
  shows Limit(omegaTwo)
proof
  unfold omegaTwo
  exact plusOmega.limit with Ordinal.omega

theorem omegaTwo.contains_omega
  shows ω ∈ omegaTwo
proof
  have zeroShift : ordinalShift(ω, 0) = ω
    rw ordinalShift
  have c := plusOmega.contains at ω, 0 with Ordinal.omega
  rw zeroShift at c
  unfold omegaTwo
  exact c

-- V(ω·2) is transitive and closed under the operations of Zermelo set
-- theory.
theorem testStage.transitive
  shows Transitive(testStage)
proof
  have lim := omegaTwo.limit
  obtain ⟨o, _, _⟩ := lim
  unfold testStage
  exact V.transitive with o

theorem tkIstage.at (x : Set)
  shows x ∈ testStage ↔ ∃ β ∈ omegaTwo, x ∈ V(β)
proof
  have lim := omegaTwo.limit
  unfold testStage
  exact V.limit_membership at x, omegaTwo with lim
theorem tkIstage.lift (x β : Set)
  requires index : β ∈ omegaTwo
  requires subset : x ⊆ V(β)
  shows x ∈ testStage
proof
  have lim := omegaTwo.limit
  obtain ⟨o, _, closed⟩ := lim
  have βO := Ordinal.member with o, index
  have nIn := closed with β, index
  have xIn : x ∈ 𝒫(V(β)) := powerset.membership_iff.backward with subset
  rw ← (V.next at β) at xIn
  exact (tkIstage.at at x).backward with ⟨next(β), nIn, xIn⟩
theorem tkIstage.below (x : Set)
  requires member : x ∈ testStage
  shows ∃ β ∈ omegaTwo, x ∈ V(β) ∧ x ⊆ V(β)
proof
  obtain ⟨β, βIn, xIn⟩ := (tkIstage.at at x).forward with member
  have lim := omegaTwo.limit
  obtain ⟨o, _, _⟩ := lim
  have βO := Ordinal.member with o, βIn
  have tr := V.transitive with βO
  have sub := tr with x, xIn
  exact ⟨β, βIn, xIn, sub⟩
theorem tkIstage.two (x y : Set)
  requires first : x ∈ testStage
  requires second : y ∈ testStage
  shows ∃ β ∈ omegaTwo, x ⊆ V(β) ∧ y ⊆ V(β) ∧ x ∈ V(β) ∧ y ∈ V(β)
proof
  obtain ⟨β1, β1In, x1, xs⟩ := tkIstage.below with first
  obtain ⟨β2, β2In, y2, ys⟩ := tkIstage.below with second
  have lim := omegaTwo.limit
  obtain ⟨o, _, _⟩ := lim
  have o1 := Ordinal.member with o, β1In
  have o2 := Ordinal.member with o, β2In
  have tr1 := V.transitive with o1
  have tr2 := V.transitive with o2
  have tri := Ordinal.trichotomy at β1 with o1
  have cases := tri with β2, o2
  cases cases with lt | rest
  . have b : β1 ∈ next(β2)
      apply next.membership.backward
      left
      exact lt
    have mono := V.monotone with o1, o2, b
    have xs2 : x ⊆ V(β2) := Subset.transitive with xs, mono
    have x2 := mono with x, x1
    exact ⟨β2, β2In, xs2, ys, x2, y2⟩
  . cases rest with eq | gt
    . rw eq at xs
      rw eq at x1
      exact ⟨β2, β2In, xs, ys, x1, y2⟩
    . have b : β2 ∈ next(β1)
        apply next.membership.backward
        left
        exact gt
      have mono := V.monotone with o2, o1, b
      have ys2 : y ⊆ V(β1) := Subset.transitive with ys, mono
      have y1 := mono with y, y2
      exact ⟨β1, β1In, xs, ys2, x1, y1⟩

theorem testStage.member_subset (x y : Set)
  requires member : x ∈ testStage
  requires subset : y ⊆ x
  shows y ∈ testStage
proof
  obtain ⟨β, βIn, xIn, xs⟩ := tkIstage.below with member
  have ys : y ⊆ V(β) := Subset.transitive with subset, xs
  exact tkIstage.lift with βIn, ys

theorem testStage.pair (x y : Set)
  requires first : x ∈ testStage
  requires second : y ∈ testStage
  shows (x, y) ∈ testStage
proof
  have pairIn : ∀ u, ∀ v, u ∈ testStage → v ∈ testStage → {u, v} ∈ testStage
    intros u v uIn vIn
    obtain ⟨β, βIn, us, vs, u1, v1⟩ := tkIstage.two with uIn, vIn
    have sub : {u, v} ⊆ V(β)
      intros z zIn
      have c := pair.membership.forward with zIn
      cases c with zu | zv
      . rw zu
        exact u1
      . rw zv
        exact v1
    exact tkIstage.lift with βIn, sub
  have xx := pairIn with x, x, first, first
  have xy := pairIn with x, y, first, second
  have whole := pairIn with {x, x}, {x, y}, xx, xy
  unfold orderedPair
  exact whole

theorem testStage.powerset (x : Set)
  requires member : x ∈ testStage
  shows 𝒫(x) ∈ testStage
proof
  obtain ⟨β, βIn, xIn, xs⟩ := tkIstage.below with member
  have lim := omegaTwo.limit
  obtain ⟨o, _, closed⟩ := lim
  have nIn := closed with β, βIn
  have βO := Ordinal.member with o, βIn
  have ps : 𝒫(x) ⊆ V(next(β))
    rw (V.next at β with βO)
    intros z zIn
    have zs := powerset.membership_iff.forward with zIn
    have zs2 : z ⊆ V(β) := Subset.transitive with zs, xs
    exact powerset.membership_iff.backward with zs2
  exact tkIstage.lift with nIn, ps

theorem testStage.union (x : Set)
  requires member : x ∈ testStage
  shows ⋃(x) ∈ testStage
proof
  obtain ⟨β, βIn, xIn, xs⟩ := tkIstage.below with member
  have lim := omegaTwo.limit
  obtain ⟨o, _, _⟩ := lim
  have βO := Ordinal.member with o, βIn
  have tr := V.transitive with βO
  have us : ⋃(x) ⊆ V(β)
    intros z zIn
    obtain ⟨w, wIn, zw⟩ := set.union.forward with zIn
    have wV := xs with w, wIn
    have ws := tr with w, wV
    exact ws with z, zw
  exact tkIstage.lift with βIn, us

theorem testStage.product (x y : Set)
  requires first : x ∈ testStage
  requires second : y ∈ testStage
  shows x × y ∈ testStage
proof
  obtain ⟨β, βIn, xs, ys, x1, y1⟩ := tkIstage.two with first, second
  have us : x ∪ y ⊆ V(β)
    intros z zIn
    have c := union2.membership.forward with zIn
    cases c with zx | zy
    . exact xs with z, zx
    . exact ys with z, zy
  have uIn := tkIstage.lift with βIn, us
  have p1 := testStage.powerset with uIn
  have p2 := testStage.powerset with p1
  have sub : x × y ⊆ productBound(x, y)
    intros p pIn
    exact (product.membership.forward with pIn).left
  unfold productBound at sub
  exact testStage.member_subset with p2, sub

theorem testStage.function_space (x y : Set)
  requires first : x ∈ testStage
  requires second : y ∈ testStage
  shows functionSpace(x, y) ∈ testStage
proof
  have pr := testStage.product with first, second
  have pw := testStage.powerset with pr
  have sub : functionSpace(x, y) ⊆ 𝒫(x × y)
    intros f fIn
    exact (functionSpace.membership.forward with fIn).left
  exact testStage.member_subset with pw, sub

theorem tkInat.below (n : Nat)
  shows n ⊆ V(n)
proof
  induction n
  | zero =>
    intros x xIn
    simp [nat.zero, set.empty] at xIn
  | succ(k) using ih =>
    have kO := Ordinal.natural at k
    have tr := V.transitive with kO
    have up := V.subset_next with kO, tr
    rw (next.natural at k)
    intros x xIn
    have c := next.membership.forward with xIn
    cases c with inK | isK
    . have xv := ih with x, inK
      exact up with x, xv
    . rw isK
      rw (V.next at k with kO)
      exact powerset.membership_iff.backward with ih

theorem testStage.naturals
  shows ℕ ∈ testStage
proof
  have omegaBelow : ω ⊆ V(ω)
    intros n nIn
    have nNat : Nat(n) := nIn
    have sub := tkInat.below at n
    have nO := Ordinal.natural at n
    have inNext : n ∈ 𝒫(V(n)) := powerset.membership_iff.backward with sub
    rw ← (V.next at n with nO) at inNext
    have lim := Limit.omega
    obtain ⟨_, _, closed⟩ := lim
    have nextIn := closed with n, nIn
    exact (V.limit_membership at n, ω with Limit.omega).backward with ⟨next(n), nextIn, inNext⟩
  have wIn := omegaTwo.contains_omega
  exact tkIstage.lift with wIn, omegaBelow

-- 𝒫(𝒫(ℕ)) lies in V(ω·2), so by testRings.essentially_of_injection below
-- every ring of cardinality at most 2^ℵ₀ (the starting rings ℂ, ℂ_p,
-- A_inf, B_cris) is isomorphic to a test ring.
theorem testStage.continuum
  shows 𝒫(𝒫(ℕ)) ∈ testStage
proof
  have n := testStage.naturals
  have p1 := testStage.powerset with n
  exact testStage.powerset with p1

-- A set lies in V(ω·2) exactly when it lies in some V(ω + n).
theorem testStage.membership (x : Set)
  shows x ∈ testStage ↔ (∃ n ∈ ℕ, x ∈ V(ordinalShift(ω, n)))
proof
  have lim := omegaTwo.limit
  obtain ⟨o, _, _⟩ := lim
  constructor
  . intro member
    obtain ⟨β, βIn, xIn⟩ := (tkIstage.at at x).forward with member
    have βIn2 := βIn
    unfold omegaTwo at βIn2
    unfold plusOmega at βIn2
    obtain ⟨X, XIn, βX⟩ := set.union.forward with βIn2
    obtain ⟨n, nIn, e⟩ := ordinalShifts.membership.forward with XIn
    have nNat : Nat(n) := nIn
    rw ← e at βX
    have so := ordinalShift.ordinal at ω, n with Ordinal.omega
    have βO := Ordinal.member with so, βX
    have b : β ∈ next(ordinalShift(ω, n))
      apply next.membership.backward
      left
      exact βX
    have mono := V.monotone with βO, so, b
    have xIn2 := mono with x, xIn
    exact ⟨n, nIn, xIn2⟩
  . intro h
    obtain ⟨n, nIn, xIn⟩ := h
    have nNat : Nat(n) := nIn
    have c := plusOmega.contains at ω, n with Ordinal.omega
    have c2 : ordinalShift(ω, n) ∈ omegaTwo
      unfold omegaTwo
      exact c
    exact (tkIstage.at at x).backward with ⟨ordinalShift(ω, n), c2, xIn⟩

theorem tkIordinal.below (α : Set)
  shows α ∈ Ordinal → α ⊆ V(α)
proof
  induction α using membership
  intros current ih hO
  intros β βIn
  have βO := Ordinal.member with hO, βIn
  have sub : β ⊆ V(β)
    have imp := ih with β, βIn
    apply imp
  have p : β ∈ 𝒫(V(β)) := powerset.membership_iff.backward with sub
  rw ← (V.next at β with βO) at p
  have nO := Ordinal.next with βO
  have b := tkInext.member with hO, βIn
  have mono := V.monotone with nO, hO, b
  exact mono with β, p

theorem tkIomegaTwo.below_theta
  shows omegaTwo ∈ hartogsBound(testStage)
proof
  have lim := omegaTwo.limit
  obtain ⟨o, _, _⟩ := lim
  have sub : omegaTwo ⊆ V(omegaTwo)
    have imp := tkIordinal.below at omegaTwo
    apply imp
  unfold testStage
  exact hartogsBound.above_ordinal_subset with o, sub

-- V(θ): a limit stage above V(ω·2), closed under the Zermelo operations
-- and under unions of families indexed by subsets of V(ω·2). The last
-- uses Choice (the regularity of θ).
theorem valueStage.contains_test_stage
  shows testStage ∈ valueStage
proof
  have lim := omegaTwo.limit
  obtain ⟨o, _, _⟩ := lim
  have below := tkIomegaTwo.below_theta
  have θO := hartogsBound.ordinal at testStage
  have nO := Ordinal.next with o
  have b := tkInext.member with θO, below
  have mono := V.monotone with nO, θO, b
  have refl : V(omegaTwo) ⊆ V(omegaTwo) := Subset.reflexive at V(omegaTwo)
  have p : V(omegaTwo) ∈ 𝒫(V(omegaTwo)) := powerset.membership_iff.backward with refl
  rw ← (V.next at omegaTwo with o) at p
  have m := mono with V(omegaTwo), p
  have e : testStage = V(omegaTwo)
    unfold testStage
    rfl
  rw ← e at m
  unfold valueStage
  exact m

theorem valueStage.extends_test_stage
  shows testStage ⊆ valueStage
proof
  have lim := omegaTwo.limit
  obtain ⟨o, _, _⟩ := lim
  have below := tkIomegaTwo.below_theta
  have θO := hartogsBound.ordinal at testStage
  have b : omegaTwo ∈ next(hartogsBound(testStage))
    apply next.membership.backward
    left
    exact below
  have m := V.monotone with o, θO, b
  have e : testStage = V(omegaTwo)
    unfold testStage
    rfl
  rw ← e at m
  unfold valueStage
  exact m

theorem valueStage.transitive
  shows Transitive(valueStage)
proof
  have o := hartogsBound.ordinal at testStage
  unfold valueStage
  exact V.transitive with o

theorem valueStage.pair (x y : Set)
  requires first : x ∈ valueStage
  requires second : y ∈ valueStage
  shows (x, y) ∈ valueStage
proof
  sorry

theorem valueStage.powerset (x : Set)
  requires member : x ∈ valueStage
  shows 𝒫(x) ∈ valueStage
proof
  sorry

theorem valueStage.product (x y : Set)
  requires first : x ∈ valueStage
  requires second : y ∈ valueStage
  shows x × y ∈ valueStage
proof
  sorry

-- The union of a family of members of V(θ) indexed by a set that injects
-- into V(ω·2) is a member of V(θ) (θ is regular and above |V(ω·2)|).
theorem valueStage.indexed_union (I F f : Set)
  requires injection : InjectiveBetween(f, I, testStage)
  requires family : F : I → valueStage
  shows ⋃(Relation.range(F)) ∈ valueStage
proof
  sorry

theorem valueStage.small_subset (X f : Set)
  requires subset : X ⊆ valueStage
  requires injection : InjectiveBetween(f, X, testStage)
  shows X ∈ valueStage
proof
  sorry

-- Section: Concrete categories
-- A concrete category of structures: objects O, a carrier assignment
-- κ : O → sets (a function graph), and morphisms M, each of the form
-- ((a, b), f) with f : κ(a) → κ(b) a function. Domain and codomain read
-- the pair, the identity of a is ((a, a), id), and composition composes
-- the functions (Mathlib's ConcreteCategory, with the morphisms recorded
-- with their endpoints).
def concreteDom (M : Set) : Set := { (m, fst(fst(m))) | m ∈ M }

def concreteCod (M : Set) : Set := { (m, snd(fst(m))) | m ∈ M }

def concreteId (O κ : Set) : Set := { (a, ((a, a), identity(κ(a)))) | a ∈ O }

def concreteComp (κ M : Set) : Set :=
  { (p, ((fst(fst(snd(p))), snd(fst(fst(p)))),
      compose(snd(fst(p)), snd(snd(p)), κ(fst(fst(snd(p)))),
        κ(snd(fst(snd(p)))), κ(snd(fst(fst(p))))))) |
    p ∈ composablePairsOf(M, concreteDom(M), concreteCod(M)) }

def concreteCategory (O κ M : Set) : Set :=
  Category.mk(O, M, concreteDom(M), concreteCod(M), concreteId(O, κ),
    concreteComp(κ, M))

-- The data of a concrete category: κ is a function on O, every morphism
-- is a function between carriers, and M holds the identities and is
-- closed under composition.
predicate ConcreteData (O κ M : Set) :=
  (κ : O → Relation.range(κ)) ∧
  (∀ m ∈ M, ∃ a ∈ O, ∃ b ∈ O, ∃ f, m = ((a, b), f) ∧ (f : κ(a) → κ(b))) ∧
  (∀ a ∈ O, ((a, a), identity(κ(a))) ∈ M) ∧
  (∀ a b c ∈ O, ∀ f, ∀ g, ((a, b), f) ∈ M → ((b, c), g) ∈ M →
    ((a, c), compose(g, f, κ(a), κ(b), κ(c))) ∈ M)

-- The forgetful functor to Sets(U), for carriers inside U
-- (CategoryTheory.forget): an object goes to its carrier and a morphism
-- to its function.
def forgetMap (κ M U : Set) : Set :=
  { (m, setArrow(U, κ(snd(fst(m))), snd(m))) | m ∈ M }

def forgetFunctor (O κ M U : Set) : Set :=
  Functor.mk(κ, forgetMap(κ, M, U), concreteCategory(O, κ, M), Sets(U))

-- Section: Rings, algebras, abelian groups and modules in a set
-- The carriers of the members of K, and the carrier assignment.
def categoryRingCarriers (K : Set) : Set := { Ring.carrier(R) | R ∈ K }

def ringCarrierMap (K : Set) : Set := { (R, Ring.carrier(R)) | R ∈ K }

-- The ring homomorphisms between members of K, as morphisms ((R, S), f).
def ringHoms (K : Set) : Set :=
  { m ∈ (K × K) × 𝒫(⋃(categoryRingCarriers(K)) × ⋃(categoryRingCarriers(K))) |
    ∃ R ∈ K, ∃ S ∈ K, ∃ f, m = ((R, S), f) ∧ RingHom(f, R, S) }

-- The category of the rings in K and their homomorphisms (CommRingCat,
-- restricted to K).
def ringCategory (K : Set) : Set :=
  concreteCategory(K, ringCarrierMap(K), ringHoms(K))

-- The algebras over A whose ring lies in K, written Algebra.mk(A, S, φ),
-- with their homomorphisms (CommAlgCat A, restricted to K).
def algebraShapes (K A : Set) : Set :=
  { Algebra.mk(A, fst(q), snd(q)) |
    q ∈ K × 𝒫(Ring.carrier(A) × ⋃(categoryRingCarriers(K))) }

def algebrasOver (K A : Set) : Set :=
  { B ∈ algebraShapes(K, A) | Algebra(B) }

def algebraCarrierMap (K A : Set) : Set :=
  { (B, algebraCarrier(B)) | B ∈ algebrasOver(K, A) }

def algebraHoms (K A : Set) : Set :=
  { m ∈ (algebrasOver(K, A) × algebrasOver(K, A)) ×
      𝒫(⋃(categoryRingCarriers(K)) × ⋃(categoryRingCarriers(K))) |
    ∃ B ∈ algebrasOver(K, A), ∃ C ∈ algebrasOver(K, A), ∃ f,
      m = ((B, C), f) ∧ AlgebraHom(f, B, C) }

def algebraCategory (K A : Set) : Set :=
  concreteCategory(algebrasOver(K, A), algebraCarrierMap(K, A),
    algebraHoms(K, A))

-- A homomorphism of abelian groups (AddMonoidHom; Cumulus GroupHom, stated
-- here on the carriers, outside this module's import closure).
predicate AdditiveHom (f G H : Set) :=
  AbelianGroup(G) ∧ AbelianGroup(H) ∧
  (f : Group.carrier(G) → Group.carrier(H)) ∧
  (∀ x y ∈ Group.carrier(G),
    f(call2(Group.mul(G), x, y)) = call2(Group.mul(H), f(x), f(y)))

-- The abelian groups that are members of a set U, with their
-- homomorphisms (AddCommGrpCat, Ab, restricted to U).
def abelianGroupsIn (U : Set) : Set := { G ∈ U | AbelianGroup(G) }

def groupCarriers (U : Set) : Set := { Group.carrier(G) | G ∈ abelianGroupsIn(U) }

def groupCarrierMap (U : Set) : Set :=
  { (G, Group.carrier(G)) | G ∈ abelianGroupsIn(U) }

def groupHoms (U : Set) : Set :=
  { m ∈ (abelianGroupsIn(U) × abelianGroupsIn(U)) ×
      𝒫(⋃(groupCarriers(U)) × ⋃(groupCarriers(U))) |
    ∃ G ∈ abelianGroupsIn(U), ∃ H ∈ abelianGroupsIn(U), ∃ f,
      m = ((G, H), f) ∧ AdditiveHom(f, G, H) }

def abelianGroupCategory (U : Set) : Set :=
  concreteCategory(abelianGroupsIn(U), groupCarrierMap(U), groupHoms(U))

-- The R-modules that are members of U, with the R-linear maps (ModuleCat R,
-- restricted to U).
def modulesIn (U R : Set) : Set := { M ∈ U | Module(M, R) }

def moduleCarriers (U R : Set) : Set := { Module.carrier(M) | M ∈ modulesIn(U, R) }

def moduleCarrierMap (U R : Set) : Set :=
  { (M, Module.carrier(M)) | M ∈ modulesIn(U, R) }

def moduleHoms (U R : Set) : Set :=
  { m ∈ (modulesIn(U, R) × modulesIn(U, R)) ×
      𝒫(⋃(moduleCarriers(U, R)) × ⋃(moduleCarriers(U, R))) |
    ∃ M ∈ modulesIn(U, R), ∃ N ∈ modulesIn(U, R), ∃ f,
      m = ((M, N), f) ∧ LinearMap(f, M, R, N) }

def moduleCategory (U R : Set) : Set :=
  concreteCategory(modulesIn(U, R), moduleCarrierMap(U, R), moduleHoms(U, R))

-- Helpers (track I): values of graphs given by replacement, and the
-- categories whose morphisms are tagged ((a, b), x) with their endpoints.
theorem tkIfun.pairs_domain (G : Set)
  requires pairs : ∀ p ∈ G, ∃ x, ∃ y, (x, y) = p
  requires functional : Functional(G)
  shows G : domain(G) → range(G)
proof
  refine ⟨?_, functional, ?_⟩
  . intros p hp
    obtain ⟨x, y, shape⟩ := pairs with p, hp
    rw ← shape at hp
    have xIn := domain.contains with hp
    have yIn := range.contains with hp
    rw ← shape
    exact product.pair with xIn, yIn
  . intros x hx
    obtain ⟨_, y, hy⟩ := domain.membership.forward with hx
    have yIn := range.contains with hy
    exact ⟨y, yIn, hy⟩

theorem tkIfun.apply (G a b : Set)
  requires pairs : ∀ p ∈ G, ∃ x, ∃ y, (x, y) = p
  requires functional : Functional(G)
  requires member : (a, b) ∈ G
  shows G(a) = b
proof
  have fn := tkIfun.pairs_domain with pairs, functional
  have aIn := domain.contains with member
  exact FunctionBetween.apply_value with fn, aIn, member

theorem tkIfun.between (G A B : Set)
  requires pairs : ∀ p ∈ G, ∃ x ∈ A, ∃ y ∈ B, (x, y) = p
  requires functional : Functional(G)
  requires total : ∀ x ∈ A, ∃ y ∈ B, (x, y) ∈ G
  shows G : A → B
proof
  refine ⟨?_, functional, ?_⟩
  . intros p hp
    obtain ⟨x, xIn, y, yIn, shape⟩ := pairs with p, hp
    rw ← shape
    exact product.pair with xIn, yIn
  . intros x hx
    obtain ⟨y, yIn, member⟩ := total with x, hx
    exact ⟨y, yIn, member⟩

theorem tkIconcreteDom.apply (M m : Set)
  requires member : m ∈ M
  shows concreteDom(M)(m) = fst(fst(m))
proof
  have pairs : ∀ p ∈ concreteDom(M), ∃ x, ∃ y, (x, y) = p
    intros p hp
    obtain ⟨n, nIn, shape⟩ := concreteDom.membership.forward with hp
    exact ⟨n, fst(fst(n)), shape⟩
  have functional : Functional(concreteDom(M))
    intros x y hxy z hxz
    obtain ⟨n1, n1In, e1⟩ := concreteDom.membership.forward with hxy
    obtain ⟨n2, n2In, e2⟩ := concreteDom.membership.forward with hxz
    obtain ⟨x1, y1⟩ := orderedPair.injective with e1
    obtain ⟨x2, z2⟩ := orderedPair.injective with e2
    cc
  have mem : (m, fst(fst(m))) ∈ concreteDom(M) :=
    concreteDom.membership.backward with ⟨m, member, rfl⟩
  exact tkIfun.apply with pairs, functional, mem

theorem tkIconcreteCod.apply (M m : Set)
  requires member : m ∈ M
  shows concreteCod(M)(m) = snd(fst(m))
proof
  have pairs : ∀ p ∈ concreteCod(M), ∃ x, ∃ y, (x, y) = p
    intros p hp
    obtain ⟨n, nIn, shape⟩ := concreteCod.membership.forward with hp
    exact ⟨n, snd(fst(n)), shape⟩
  have functional : Functional(concreteCod(M))
    intros x y hxy z hxz
    obtain ⟨n1, n1In, e1⟩ := concreteCod.membership.forward with hxy
    obtain ⟨n2, n2In, e2⟩ := concreteCod.membership.forward with hxz
    obtain ⟨x1, y1⟩ := orderedPair.injective with e1
    obtain ⟨x2, z2⟩ := orderedPair.injective with e2
    cc
  have mem : (m, snd(fst(m))) ∈ concreteCod(M) :=
    concreteCod.membership.backward with ⟨m, member, rfl⟩
  exact tkIfun.apply with pairs, functional, mem

theorem tkIconcreteDom.function (O M : Set)
  requires shape : ∀ m ∈ M, ∃ a ∈ O, ∃ b ∈ O, ∃ x, m = ((a, b), x)
  shows (concreteDom(M) : M → O) ∧ (concreteCod(M) : M → O)
proof
  constructor
  . apply tkIfun.between
    . intros p hp
      obtain ⟨n, nIn, e⟩ := concreteDom.membership.forward with hp
      obtain ⟨a, aIn, b, bIn, x, nShape⟩ := shape with n, nIn
      have v : fst(fst(n)) = a
        rw nShape
        rw [fst.pair, fst.pair]
      rw v at e
      exact ⟨n, nIn, a, aIn, e⟩
    . intros x y hxy z hxz
      obtain ⟨n1, n1In, e1⟩ := concreteDom.membership.forward with hxy
      obtain ⟨n2, n2In, e2⟩ := concreteDom.membership.forward with hxz
      obtain ⟨x1, y1⟩ := orderedPair.injective with e1
      obtain ⟨x2, z2⟩ := orderedPair.injective with e2
      cc
    . intros n nIn
      obtain ⟨a, aIn, b, bIn, x, nShape⟩ := shape with n, nIn
      have v : fst(fst(n)) = a
        rw nShape
        rw [fst.pair, fst.pair]
      have mem : (n, fst(fst(n))) ∈ concreteDom(M) :=
        concreteDom.membership.backward with ⟨n, nIn, rfl⟩
      rw v at mem
      exact ⟨a, aIn, mem⟩
  . apply tkIfun.between
    . intros p hp
      obtain ⟨n, nIn, e⟩ := concreteCod.membership.forward with hp
      obtain ⟨a, aIn, b, bIn, x, nShape⟩ := shape with n, nIn
      have v : snd(fst(n)) = b
        rw nShape
        rw [fst.pair, snd.pair]
      rw v at e
      exact ⟨n, nIn, b, bIn, e⟩
    . intros x y hxy z hxz
      obtain ⟨n1, n1In, e1⟩ := concreteCod.membership.forward with hxy
      obtain ⟨n2, n2In, e2⟩ := concreteCod.membership.forward with hxz
      obtain ⟨x1, y1⟩ := orderedPair.injective with e1
      obtain ⟨x2, z2⟩ := orderedPair.injective with e2
      cc
    . intros n nIn
      obtain ⟨a, aIn, b, bIn, x, nShape⟩ := shape with n, nIn
      have v : snd(fst(n)) = b
        rw nShape
        rw [fst.pair, snd.pair]
      have mem : (n, snd(fst(n))) ∈ concreteCod(M) :=
        concreteCod.membership.backward with ⟨n, nIn, rfl⟩
      rw v at mem
      exact ⟨b, bIn, mem⟩

theorem tkIcomposable.iff (M g f : Set)
  shows (g, f) ∈ composablePairsOf(M, concreteDom(M), concreteCod(M)) ↔
    (g ∈ M ∧ f ∈ M ∧ fst(fst(g)) = snd(fst(f)))
proof
  constructor
  . intro member
    obtain ⟨_, g2, g2In, f2, f2In, shape, comp⟩ :=
      composablePairsOf.membership.forward with member
    obtain ⟨gE, fE⟩ := orderedPair.injective with shape
    rw [gE, fE]
    have d := tkIconcreteDom.apply with g2In
    have c := tkIconcreteCod.apply with f2In
    refine ⟨g2In, f2In, ?_⟩
    cc
  . intro h
    obtain ⟨gIn, fIn, comp⟩ := h
    have d := tkIconcreteDom.apply with gIn
    have c := tkIconcreteCod.apply with fIn
    have same : concreteDom(M)(g) = concreteCod(M)(f) by cc
    exact composablePairsOf.pair with gIn, fIn, same

theorem tkItagged.category (O M I K : Set)
  requires shape : ∀ m ∈ M, ∃ a ∈ O, ∃ b ∈ O, ∃ x, m = ((a, b), x)
  requires idFn : I : O → M
  requires idShape : ∀ a ∈ O, fst(I(a)) = (a, a)
  requires compFn : K : composablePairsOf(M, concreteDom(M), concreteCod(M)) → M
  requires compShape : ∀ g ∈ M, ∀ f ∈ M, fst(fst(g)) = snd(fst(f)) →
    fst(K(g, f)) = (fst(fst(f)), snd(fst(g)))
  requires units : ∀ f ∈ M, K(I(snd(fst(f))), f) = f ∧ K(f, I(fst(fst(f)))) = f
  requires assoc : ∀ h ∈ M, ∀ g ∈ M, ∀ f ∈ M, fst(fst(h)) = snd(fst(g)) →
    fst(fst(g)) = snd(fst(f)) → K(K(h, g), f) = K(h, K(g, f))
  shows Category(Category.mk(O, M, concreteDom(M), concreteCod(M), I, K))
proof
  obtain ⟨domFn, codFn⟩ := tkIconcreteDom.function with shape
  apply Category.intro with domFn, codFn, idFn, compFn
  . intros a aIn
    have iIn := FunctionBetween.apply_closed with idFn, aIn
    have d := tkIconcreteDom.apply with iIn
    have c := tkIconcreteCod.apply with iIn
    have s := idShape with a, aIn
    rw [d, c, s, fst.pair, snd.pair]
    refine ⟨rfl, rfl⟩
  . intros g gIn f fIn composable
    have dg := tkIconcreteDom.apply with gIn
    have cf := tkIconcreteCod.apply with fIn
    have df := tkIconcreteDom.apply with fIn
    have cg := tkIconcreteCod.apply with gIn
    have comp : fst(fst(g)) = snd(fst(f)) by cc
    have pairIn := composablePairsOf.pair with gIn, fIn, composable
    have kIn : K(g, f) ∈ M
      unfold call2
      exact FunctionBetween.apply_closed with compFn, pairIn
    have dk := tkIconcreteDom.apply with kIn
    have ck := tkIconcreteCod.apply with kIn
    have s := compShape with g, gIn, f, fIn, comp
    rw [dk, ck, s, fst.pair, snd.pair, df, cg]
    refine ⟨rfl, rfl⟩
  . intros f fIn
    have df := tkIconcreteDom.apply with fIn
    have cf := tkIconcreteCod.apply with fIn
    rw [df, cf]
    exact units with f, fIn
  . intros h hIn g gIn f fIn hg gf
    have dh := tkIconcreteDom.apply with hIn
    have cg := tkIconcreteCod.apply with gIn
    have dg := tkIconcreteDom.apply with gIn
    have cf := tkIconcreteCod.apply with fIn
    rw [dh, cg] at hg
    rw [dg, cf] at gf
    exact assoc with h, hIn, g, gIn, f, fIn, hg, gf

theorem tkIconcreteId.apply (O κ a : Set)
  requires member : a ∈ O
  shows concreteId(O, κ)(a) = ((a, a), identity(κ(a)))
proof
  have pairs : ∀ p ∈ concreteId(O, κ), ∃ x, ∃ y, (x, y) = p
    intros p hp
    obtain ⟨n, nIn, shape⟩ := concreteId.membership.forward with hp
    exact ⟨n, ((n, n), identity(κ(n))), shape⟩
  have functional : Functional(concreteId(O, κ))
    intros x y hxy z hxz
    obtain ⟨n1, n1In, e1⟩ := concreteId.membership.forward with hxy
    obtain ⟨n2, n2In, e2⟩ := concreteId.membership.forward with hxz
    obtain ⟨x1, y1⟩ := orderedPair.injective with e1
    obtain ⟨x2, z2⟩ := orderedPair.injective with e2
    cc
  have mem : (a, ((a, a), identity(κ(a)))) ∈ concreteId(O, κ) :=
    concreteId.membership.backward with ⟨a, member, rfl⟩
  exact tkIfun.apply with pairs, functional, mem

theorem tkIconcreteComp.graph (κ M : Set)
  shows (∀ p ∈ concreteComp(κ, M), ∃ x, ∃ y, (x, y) = p) ∧
    Functional(concreteComp(κ, M))
proof
  constructor
  . intros p hp
    obtain ⟨n, nIn, shape⟩ := concreteComp.membership.forward with hp
    refine ⟨n, snd(p), ?_⟩
    rw ← shape
    rw snd.pair
  . intros x y hxy z hxz
    obtain ⟨n1, n1In, e1⟩ := concreteComp.membership.forward with hxy
    obtain ⟨n2, n2In, e2⟩ := concreteComp.membership.forward with hxz
    obtain ⟨x1, y1⟩ := orderedPair.injective with e1
    obtain ⟨x2, z2⟩ := orderedPair.injective with e2
    cc

theorem tkIconcreteComp.apply (κ M a b c f g : Set)
  requires first : ((a, b), f) ∈ M
  requires second : ((b, c), g) ∈ M
  shows concreteComp(κ, M)(((b, c), g), ((a, b), f)) =
    ((a, c), compose(g, f, κ(a), κ(b), κ(c)))
proof
  obtain ⟨pairs, functional⟩ := tkIconcreteComp.graph at κ, M
  have comp : fst(fst(((b, c), g))) = snd(fst(((a, b), f)))
    rw [fst.pair, fst.pair, fst.pair, snd.pair]
  have qIn := (tkIcomposable.iff at M, ((b, c), g), ((a, b), f)).backward with
    ⟨second, first, comp⟩
  have mem : ((((b, c), g), ((a, b), f)),
      ((a, c), compose(g, f, κ(a), κ(b), κ(c)))) ∈ concreteComp(κ, M)
    apply concreteComp.membership.backward
    refine ⟨(((b, c), g), ((a, b), f)), qIn, ?_⟩
    simp [fst.pair, snd.pair]
  unfold call2
  exact tkIfun.apply with pairs, functional, mem

theorem tkIconcreteComp.shape (O κ M q : Set)
  requires data : ConcreteData(O, κ, M)
  requires member : q ∈ composablePairsOf(M, concreteDom(M), concreteCod(M))
  shows ∃ a ∈ O, ∃ b ∈ O, ∃ c ∈ O, ∃ f, ∃ g, q = (((b, c), g), ((a, b), f)) ∧
    ((a, b), f) ∈ M ∧ ((b, c), g) ∈ M ∧ (f : κ(a) → κ(b)) ∧ (g : κ(b) → κ(c))
proof
  obtain ⟨κfn, shape, idsIn, closed⟩ := data
  obtain ⟨_, G, GIn, F, FIn, qShape, compo⟩ :=
    composablePairsOf.membership.forward with member
  have dG := tkIconcreteDom.apply with GIn
  have cF := tkIconcreteCod.apply with FIn
  obtain ⟨b2, b2In, c, cIn, g, gE, gFn⟩ := shape with G, GIn
  obtain ⟨a, aIn, b, bIn, f, fE, fFn⟩ := shape with F, FIn
  rw [dG, cF] at compo
  rw [gE, fE, fst.pair, fst.pair, fst.pair, snd.pair] at compo
  rw compo at gE
  rw compo at gFn
  rw gE at GIn
  rw fE at FIn
  refine ⟨a, aIn, b, bIn, c, cIn, f, g, ?_, FIn, GIn, fFn, gFn⟩
  rw [qShape, gE, fE]

theorem tkIconcreteData.functions (O κ M : Set)
  requires data : ConcreteData(O, κ, M)
  shows (concreteId(O, κ) : O → M) ∧
    (concreteComp(κ, M) : composablePairsOf(M, concreteDom(M), concreteCod(M)) → M)
proof
  have data2 := data
  obtain ⟨κfn, shape, idsIn, closed⟩ := data2
  constructor
  . apply tkIfun.between
    . intros p hp
      obtain ⟨a, aIn, e⟩ := concreteId.membership.forward with hp
      have idIn := idsIn with a, aIn
      exact ⟨a, aIn, ((a, a), identity(κ(a))), idIn, e⟩
    . intros x y hxy z hxz
      obtain ⟨n1, n1In, e1⟩ := concreteId.membership.forward with hxy
      obtain ⟨n2, n2In, e2⟩ := concreteId.membership.forward with hxz
      obtain ⟨x1, y1⟩ := orderedPair.injective with e1
      obtain ⟨x2, z2⟩ := orderedPair.injective with e2
      cc
    . intros a aIn
      have idIn := idsIn with a, aIn
      have mem : (a, ((a, a), identity(κ(a)))) ∈ concreteId(O, κ) :=
        concreteId.membership.backward with ⟨a, aIn, rfl⟩
      exact ⟨((a, a), identity(κ(a))), idIn, mem⟩
  . obtain ⟨pairs, functional⟩ := tkIconcreteComp.graph at κ, M
    apply tkIfun.between
    . intros p hp
      obtain ⟨q, qIn, e⟩ := concreteComp.membership.forward with hp
      obtain ⟨a, aIn, b, bIn, c, cIn, f, g, qE, FIn, GIn, fFn, gFn⟩ :=
        tkIconcreteComp.shape with data, qIn
      have closedIn := closed with a, aIn, b, bIn, c, cIn, f, g, FIn, GIn
      rw qE at e
      rw qE at qIn
      simp [fst.pair, snd.pair] at e
      exact ⟨(((b, c), g), ((a, b), f)), qIn,
        ((a, c), compose(g, f, κ(a), κ(b), κ(c))), closedIn, e⟩
    . exact functional
    . intros q qIn
      obtain ⟨a, aIn, b, bIn, c, cIn, f, g, qE, FIn, GIn, fFn, gFn⟩ :=
        tkIconcreteComp.shape with data, qIn
      have closedIn := closed with a, aIn, b, bIn, c, cIn, f, g, FIn, GIn
      have mem : (q, ((a, c), compose(g, f, κ(a), κ(b), κ(c)))) ∈ concreteComp(κ, M)
        apply concreteComp.membership.backward
        refine ⟨q, qIn, ?_⟩
        rw qE
        simp [fst.pair, snd.pair]
      exact ⟨((a, c), compose(g, f, κ(a), κ(b), κ(c))), closedIn, mem⟩

-- Section: The test rings 𝒰
-- 𝒰: the commutative rings that are members of V(ω·2) — equivalently
-- (testRings.membership) whose carrier is a member of V(ω·2). The source's
-- `CommRingCat.{0}`, the universe of points of the region.
def testRings : Set := { R ∈ testStage | CommRing(R) }

-- The category of test rings: the set-sized stand-in for CommRingCat.{0}
-- (`PointFunctor := CommRingCat.{0} ⥤ Type 1`, TestCohomology.lean:32).
def testCategory : Set := ringCategory(testRings)

-- The test A-algebras: `CommAlg k := CommAlgCat.{0,0} k`
-- (LocalTerms.lean:23), restricted to rings in 𝒰.
def testAlgebraCategory (A : Set) : Set := algebraCategory(testRings, A)

-- The coefficient groups: abelian groups in V(θ) (`Ab.{1}`).
def coefficientGroups : Set := abelianGroupCategory(valueStage)

-- R is isomorphic to a member of K.
predicate EssentiallyIn (K R : Set) := ∃ S ∈ K, ∃ φ, RingIso(φ, R, S)

-- Section: Laws of concrete categories
section ConcreteLaws
variable (O κ M : Set)
hypothesis data : ConcreteData(O, κ, M)

theorem concreteCategory.category
  shows Category(concreteCategory(O, κ, M))
proof
  have data2 := data
  obtain ⟨κfn, shape, idsIn, closed⟩ := data2
  obtain ⟨idFn, compFn⟩ := tkIconcreteData.functions with data
  have shape2 : ∀ m ∈ M, ∃ a ∈ O, ∃ b ∈ O, ∃ x, m = ((a, b), x)
    intros m mIn
    obtain ⟨a, aIn, b, bIn, f, e, fFn⟩ := shape with m, mIn
    exact ⟨a, aIn, b, bIn, f, e⟩
  have idShape : ∀ a ∈ O, fst(concreteId(O, κ)(a)) = (a, a)
    intros a aIn
    rw (tkIconcreteId.apply at O, κ, a with aIn)
    rw fst.pair
  have compShape : ∀ g ∈ M, ∀ f ∈ M, fst(fst(g)) = snd(fst(f)) →
      fst(concreteComp(κ, M)(g, f)) = (fst(fst(f)), snd(fst(g)))
    intros g gIn f fIn comp
    obtain ⟨b2, b2In, c, cIn, g1, gE, gFn⟩ := shape with g, gIn
    obtain ⟨a, aIn, b, bIn, f1, fE, fFn⟩ := shape with f, fIn
    rw [gE, fE, fst.pair, fst.pair, fst.pair, snd.pair] at comp
    rw comp at gE
    rw gE at gIn
    rw fE at fIn
    rw [gE, fE]
    rw (tkIconcreteComp.apply at κ, M, a, b, c, f1, g1 with fIn, gIn)
    simp [fst.pair, snd.pair]
  have units : ∀ f ∈ M, concreteComp(κ, M)(concreteId(O, κ)(snd(fst(f))), f) = f ∧
      concreteComp(κ, M)(f, concreteId(O, κ)(fst(fst(f)))) = f
    intros f fIn
    obtain ⟨a, aIn, b, bIn, f1, fE, fFn⟩ := shape with f, fIn
    rw fE at fIn
    rw fE
    simp [fst.pair, snd.pair]
    rw (tkIconcreteId.apply at O, κ, a with aIn)
    rw (tkIconcreteId.apply at O, κ, b with bIn)
    have idA := idsIn with a, aIn
    have idB := idsIn with b, bIn
    rw (tkIconcreteComp.apply at κ, M, a, b, b, f1, identity(κ(b)) with fIn, idB)
    rw (tkIconcreteComp.apply at κ, M, a, a, b, identity(κ(a)), f1 with idA, fIn)
    rw [compose.identity_left with fFn, compose.identity_right with fFn]
    refine ⟨rfl, rfl⟩
  have assoc : ∀ h ∈ M, ∀ g ∈ M, ∀ f ∈ M, fst(fst(h)) = snd(fst(g)) →
      fst(fst(g)) = snd(fst(f)) → concreteComp(κ, M)(concreteComp(κ, M)(h, g), f) =
        concreteComp(κ, M)(h, concreteComp(κ, M)(g, f))
    intros h hIn g gIn f fIn hg gf
    obtain ⟨c2, c2In, d, dIn, h1, hE, hFn⟩ := shape with h, hIn
    obtain ⟨b2, b2In, c, cIn, g1, gE, gFn⟩ := shape with g, gIn
    obtain ⟨a, aIn, b, bIn, f1, fE, fFn⟩ := shape with f, fIn
    rw [hE, gE, fst.pair, fst.pair, fst.pair, snd.pair] at hg
    rw [gE, fE, fst.pair, fst.pair, fst.pair, snd.pair] at gf
    rw hg at hE
    rw hg at hFn
    rw gf at gE
    rw gf at gFn
    rw hE at hIn
    rw gE at gIn
    rw fE at fIn
    rw [hE, gE, fE]
    have hgIn := closed with b, bIn, c, cIn, d, dIn, g1, h1, gIn, hIn
    have gfIn := closed with a, aIn, b, bIn, c, cIn, f1, g1, fIn, gIn
    rw (tkIconcreteComp.apply at κ, M, b, c, d, g1, h1 with gIn, hIn)
    rw (tkIconcreteComp.apply at κ, M, a, b, c, f1, g1 with fIn, gIn)
    rw (tkIconcreteComp.apply at κ, M, a, b, d, f1, compose(h1, g1, κ(b), κ(c), κ(d)) with fIn, hgIn)
    rw (tkIconcreteComp.apply at κ, M, a, c, d, compose(g1, f1, κ(a), κ(b), κ(c)), h1 with gfIn, hIn)
    rw (compose.associative with fFn, gFn, hFn)
  unfold concreteCategory
  exact tkItagged.category with shape2, idFn, idShape, compFn, compShape, units, assoc

theorem concreteCategory.obj
  shows Category.obj(concreteCategory(O, κ, M)) = O
proof
  simp [concreteCategory, Category.mk.obj]

theorem concreteCategory.mor
  shows mor(concreteCategory(O, κ, M)) = M
proof
  simp [concreteCategory, Category.mk.mor]

-- The hom-set from a to b is the set of the ((a, b), f) in M.
theorem concreteCategory.hom (a b f : Set)
  requires first : a ∈ O
  requires second : b ∈ O
  shows ((a, b), f) ∈ hom(concreteCategory(O, κ, M), a, b) ↔ ((a, b), f) ∈ M
proof
  constructor
  . intro member
    obtain ⟨mIn, _, _⟩ := hom.membership.forward with member
    simp [concreteCategory, Category.mk.mor] at mIn
    exact mIn
  . intro member
    apply hom.membership.backward
    have d := tkIconcreteDom.apply with member
    have c := tkIconcreteCod.apply with member
    simp [concreteCategory, Category.mk.mor, Category.mk.dom, Category.mk.cod]
    rw [d, c, fst.pair, fst.pair, snd.pair]
    refine ⟨member, rfl, rfl⟩

theorem concreteCategory.id_value (a : Set)
  requires object : a ∈ O
  shows Category.id(concreteCategory(O, κ, M))(a) = ((a, a), identity(κ(a)))
proof
  simp [concreteCategory, Category.mk.id]
  exact tkIconcreteId.apply with object

theorem concreteCategory.comp_value (a b c f g : Set)
  requires first : ((a, b), f) ∈ M
  requires second : ((b, c), g) ∈ M
  shows call2(Category.comp(concreteCategory(O, κ, M)), ((b, c), g), ((a, b), f)) =
    ((a, c), compose(g, f, κ(a), κ(b), κ(c)))
proof
  simp [concreteCategory, Category.mk.comp]
  exact tkIconcreteComp.apply with first, second

-- The forgetful functor is a faithful functor (ConcreteCategory.hom_ext).
theorem forgetFunctor.functor (U : Set)
  requires bounded : ∀ a ∈ O, κ(a) ⊆ U
  shows forgetFunctor(O, κ, M, U) : concreteCategory(O, κ, M) ⥤ Sets(U)
proof
  sorry

theorem forgetFunctor.faithful (U : Set)
  requires bounded : ∀ a ∈ O, κ(a) ⊆ U
  shows Faithful(forgetFunctor(O, κ, M, U), concreteCategory(O, κ, M), Sets(U))
proof
  sorry

end ConcreteLaws

theorem tkIringHom.id (R : Set)
  requires ring : Ring(R)
  shows identity(Ring.carrier(R)) : R →+* R
proof
  have fn := identity.function at Ring.carrier(R)
  unfold RingHom
  refine ⟨ring, ring, fn, ?_, ?_, ?_, ?_, ?_⟩
  . have z : R[0] ∈ Ring.carrier(R) by typecheck
    exact identity.apply with z
  . have z : R[1] ∈ Ring.carrier(R) by typecheck
    exact identity.apply with z
  . intros x xIn
    have n : -x ∈ Ring.carrier(R) by typecheck
    rw [(identity.apply with n), (identity.apply with xIn)]
  . intros x xIn y yIn
    have n : x + y ∈ Ring.carrier(R) by typecheck
    rw [(identity.apply with n), (identity.apply with xIn), (identity.apply with yIn)]
  . intros x xIn y yIn
    have n : x * y ∈ Ring.carrier(R) by typecheck
    rw [(identity.apply with n), (identity.apply with xIn), (identity.apply with yIn)]

theorem tkIringHom.comp (f g R S T : Set)
  requires first : f : R →+* S
  requires second : g : S →+* T
  shows compose(g, f, Ring.carrier(R), Ring.carrier(S), Ring.carrier(T)) : R →+* T
proof
  obtain ⟨rR, rS, fFn, f0, f1, fneg, fadd, fmul⟩ := first
  obtain ⟨_, rT, gFn, g0, g1, gneg, gadd, gmul⟩ := second
  have fn := compose.function with fFn, gFn
  unfold RingHom
  refine ⟨rR, rT, fn, ?_, ?_, ?_, ?_, ?_⟩
  . have z : R[0] ∈ Ring.carrier(R) by typecheck
    rw [(compose.apply with fFn, gFn, z), f0, g0]
  . have z : R[1] ∈ Ring.carrier(R) by typecheck
    rw [(compose.apply with fFn, gFn, z), f1, g1]
  . intros x xIn
    have n : -x ∈ Ring.carrier(R) by typecheck
    have fx := FunctionBetween.apply_closed with fFn, xIn
    rw [(compose.apply with fFn, gFn, n), (compose.apply with fFn, gFn, xIn)]
    rw [(fneg with x, xIn), (gneg with f(x), fx)]
  . intros x xIn y yIn
    have n : x + y ∈ Ring.carrier(R) by typecheck
    have fx := FunctionBetween.apply_closed with fFn, xIn
    have fy := FunctionBetween.apply_closed with fFn, yIn
    rw [(compose.apply with fFn, gFn, n), (compose.apply with fFn, gFn, xIn),
      (compose.apply with fFn, gFn, yIn)]
    rw [(fadd with x, xIn, y, yIn), (gadd with f(x), fx, f(y), fy)]
  . intros x xIn y yIn
    have n : x * y ∈ Ring.carrier(R) by typecheck
    have fx := FunctionBetween.apply_closed with fFn, xIn
    have fy := FunctionBetween.apply_closed with fFn, yIn
    rw [(compose.apply with fFn, gFn, n), (compose.apply with fFn, gFn, xIn),
      (compose.apply with fFn, gFn, yIn)]
    rw [(fmul with x, xIn, y, yIn), (gmul with f(x), fx, f(y), fy)]

theorem tkIbound (f A B X Y : Set)
  requires function : f : A → B
  requires first : A ⊆ X
  requires second : B ⊆ Y
  shows f ∈ 𝒫(X × Y)
proof
  have rel := FunctionBetween.relation with function
  unfold RelationBetween at rel
  have mono := product.monotone with first, second
  have sub := Subset.transitive with rel, mono
  exact powerset.membership_iff.backward with sub

theorem tkIringCarrier.apply (K R : Set)
  requires member : R ∈ K
  shows ringCarrierMap(K)(R) = Ring.carrier(R) ∧ Ring.carrier(R) ⊆ ⋃(categoryRingCarriers(K))
proof
  constructor
  . have pairs : ∀ p ∈ ringCarrierMap(K), ∃ x, ∃ y, (x, y) = p
      intros p hp
      obtain ⟨n, nIn, shape⟩ := ringCarrierMap.membership.forward with hp
      exact ⟨n, Ring.carrier(n), shape⟩
    have functional : Functional(ringCarrierMap(K))
      intros x y hxy z hxz
      obtain ⟨n1, n1In, e1⟩ := ringCarrierMap.membership.forward with hxy
      obtain ⟨n2, n2In, e2⟩ := ringCarrierMap.membership.forward with hxz
      obtain ⟨x1, y1⟩ := orderedPair.injective with e1
      obtain ⟨x2, z2⟩ := orderedPair.injective with e2
      cc
    have mem : (R, Ring.carrier(R)) ∈ ringCarrierMap(K) :=
      ringCarrierMap.membership.backward with ⟨R, member, rfl⟩
    exact tkIfun.apply with pairs, functional, mem
  . intros x xIn
    have cIn : Ring.carrier(R) ∈ categoryRingCarriers(K) :=
      categoryRingCarriers.membership.backward with ⟨R, member, rfl⟩
    exact set.union.backward with ⟨Ring.carrier(R), cIn, xIn⟩

-- Section: Laws of the categories of structures
theorem ringHoms.concrete (K : Set)
  requires rings : ∀ R ∈ K, Ring(R)
  shows ConcreteData(K, ringCarrierMap(K), ringHoms(K))
proof
  have kfn : ringCarrierMap(K) : K → Relation.range(ringCarrierMap(K))
    apply tkIfun.between
    . intros p hp
      obtain ⟨R, RIn, e⟩ := ringCarrierMap.membership.forward with hp
      have pIn := hp
      rw ← e at pIn
      have rIn := Relation.range.contains with pIn
      exact ⟨R, RIn, Ring.carrier(R), rIn, e⟩
    . intros x y hxy z hxz
      obtain ⟨n1, n1In, e1⟩ := ringCarrierMap.membership.forward with hxy
      obtain ⟨n2, n2In, e2⟩ := ringCarrierMap.membership.forward with hxz
      obtain ⟨x1, y1⟩ := orderedPair.injective with e1
      obtain ⟨x2, z2⟩ := orderedPair.injective with e2
      cc
    . intros R RIn
      have mem : (R, Ring.carrier(R)) ∈ ringCarrierMap(K) :=
        ringCarrierMap.membership.backward with ⟨R, RIn, rfl⟩
      have rIn := Relation.range.contains with mem
      exact ⟨Ring.carrier(R), rIn, mem⟩
  refine ⟨kfn, ?_, ?_, ?_⟩
  . intros m mIn
    obtain ⟨_, R, RIn, S, SIn, f, e, hom⟩ := ringHoms.membership.forward with mIn
    obtain ⟨_, _, fFn, _⟩ := hom
    obtain ⟨cR, _⟩ := tkIringCarrier.apply with RIn
    obtain ⟨cS, _⟩ := tkIringCarrier.apply with SIn
    refine ⟨R, RIn, S, SIn, f, e, ?_⟩
    rw [cR, cS]
    exact fFn
  . intros R RIn
    have ring := rings with R, RIn
    have hom := tkIringHom.id with ring
    obtain ⟨cR, sub⟩ := tkIringCarrier.apply with RIn
    rw cR
    have fn := identity.function at Ring.carrier(R)
    have b := tkIbound with fn, sub, sub
    have p := product.pair with RIn, RIn
    have p2 := product.pair with p, b
    apply ringHoms.membership.backward
    exact ⟨p2, R, RIn, R, RIn, identity(Ring.carrier(R)), rfl, hom⟩
  . intros R RIn S SIn T TIn f g fIn gIn
    obtain ⟨_, R1, R1In, S1, S1In, f1, e1, hom1⟩ := ringHoms.membership.forward with fIn
    obtain ⟨_, S2, S2In, T2, T2In, g2, e2, hom2⟩ := ringHoms.membership.forward with gIn
    obtain ⟨rs, ff⟩ := orderedPair.injective with e1
    obtain ⟨rr, ss⟩ := orderedPair.injective with rs
    obtain ⟨st, gg⟩ := orderedPair.injective with e2
    obtain ⟨ss2, tt⟩ := orderedPair.injective with st
    rw [← rr, ← ss, ← ff] at hom1
    rw [← ss2, ← tt, ← gg] at hom2
    have hom := tkIringHom.comp with hom1, hom2
    obtain ⟨cR, subR⟩ := tkIringCarrier.apply with RIn
    obtain ⟨cS, _⟩ := tkIringCarrier.apply with SIn
    obtain ⟨cT, subT⟩ := tkIringCarrier.apply with TIn
    rw [cR, cS, cT]
    obtain ⟨_, _, fn, _⟩ := hom
    have b := tkIbound with fn, subR, subT
    have p := product.pair with RIn, TIn
    have p2 := product.pair with p, b
    apply ringHoms.membership.backward
    exact ⟨p2, R, RIn, T, TIn, compose(g, f, Ring.carrier(R), Ring.carrier(S),
      Ring.carrier(T)), rfl, hom⟩

theorem ringCategory.category (K : Set)
  requires rings : ∀ R ∈ K, Ring(R)
  shows Category(ringCategory(K))
proof
  have data := ringHoms.concrete with rings
  unfold ringCategory
  exact concreteCategory.category with data

theorem ringCategory.hom (K R S f : Set)
  requires first : R ∈ K
  requires second : S ∈ K
  shows ((R, S), f) ∈ hom(ringCategory(K), R, S) ↔ RingHom(f, R, S)
proof
  constructor
  . intro member
    obtain ⟨mIn, _, _⟩ := hom.membership.forward with member
    simp [ringCategory, concreteCategory, Category.mk.mor] at mIn
    obtain ⟨_, R1, R1In, S1, S1In, f1, e1, hom1⟩ := ringHoms.membership.forward with mIn
    obtain ⟨rs, ff⟩ := orderedPair.injective with e1
    obtain ⟨rr, ss⟩ := orderedPair.injective with rs
    rw [rr, ss, ff]
    exact hom1
  . intro hom
    have hom2 := hom
    obtain ⟨_, _, fn, _⟩ := hom2
    obtain ⟨_, subR⟩ := tkIringCarrier.apply with first
    obtain ⟨_, subS⟩ := tkIringCarrier.apply with second
    have b := tkIbound with fn, subR, subS
    have p := product.pair with first, second
    have p2 := product.pair with p, b
    have mIn : ((R, S), f) ∈ ringHoms(K)
      apply ringHoms.membership.backward
      exact ⟨p2, R, first, S, second, f, rfl, hom⟩
    apply hom.membership.backward
    simp [ringCategory, concreteCategory, Category.mk.mor, Category.mk.dom, Category.mk.cod]
    rw [(tkIconcreteDom.apply with mIn), (tkIconcreteCod.apply with mIn)]
    simp [fst.pair, snd.pair]

-- An isomorphism in the category of rings is a bijective homomorphism
-- (ConcreteCategory.isIso_iff_bijective for CommRingCat).
theorem ringCategory.isomorphism (K R S f : Set)
  requires rings : ∀ T ∈ K, Ring(T)
  requires first : R ∈ K
  requires second : S ∈ K
  requires hom : RingHom(f, R, S)
  shows Isomorphism(ringCategory(K), ((R, S), f)) ↔ RingIso(f, R, S)
proof
  sorry

theorem tkIalgebrasOver.ring (K A B : Set)
  requires member : B ∈ algebrasOver(K, A)
  shows Algebra(B) ∧ Algebra.ring(B) ∈ K
proof
  obtain ⟨sIn, alg⟩ := member
  obtain ⟨q, qIn, e⟩ := algebraShapes.membership.forward with sIn
  obtain ⟨_, S, SIn, φ, φIn, qE⟩ := product.membership.forward with qIn
  refine ⟨alg, ?_⟩
  rw [← e, Algebra.mk.ring, qE, fst.pair]
  exact SIn

theorem tkIalgebraCarrier.apply (K A B : Set)
  requires member : B ∈ algebrasOver(K, A)
  shows algebraCarrierMap(K, A)(B) = algebraCarrier(B) ∧
    algebraCarrier(B) ⊆ ⋃(categoryRingCarriers(K))
proof
  constructor
  . have pairs : ∀ p ∈ algebraCarrierMap(K, A), ∃ x, ∃ y, (x, y) = p
      intros p hp
      obtain ⟨n, nIn, shape⟩ := algebraCarrierMap.membership.forward with hp
      exact ⟨n, algebraCarrier(n), shape⟩
    have functional : Functional(algebraCarrierMap(K, A))
      intros x y hxy z hxz
      obtain ⟨n1, n1In, e1⟩ := algebraCarrierMap.membership.forward with hxy
      obtain ⟨n2, n2In, e2⟩ := algebraCarrierMap.membership.forward with hxz
      obtain ⟨x1, y1⟩ := orderedPair.injective with e1
      obtain ⟨x2, z2⟩ := orderedPair.injective with e2
      cc
    have mem : (B, algebraCarrier(B)) ∈ algebraCarrierMap(K, A) :=
      algebraCarrierMap.membership.backward with ⟨B, member, rfl⟩
    exact tkIfun.apply with pairs, functional, mem
  . obtain ⟨_, ringIn⟩ := tkIalgebrasOver.ring with member
    obtain ⟨_, sub⟩ := tkIringCarrier.apply with ringIn
    unfold algebraCarrier
    exact sub

theorem tkIalgebraHoms.concrete (K A : Set)
  shows ConcreteData(algebrasOver(K, A), algebraCarrierMap(K, A), algebraHoms(K, A))
proof
  have kfn : algebraCarrierMap(K, A) : algebrasOver(K, A) →
      Relation.range(algebraCarrierMap(K, A))
    apply tkIfun.between
    . intros p hp
      obtain ⟨X, XIn, e⟩ := algebraCarrierMap.membership.forward with hp
      have pIn := hp
      rw ← e at pIn
      have rIn := Relation.range.contains with pIn
      exact ⟨X, XIn, algebraCarrier(X), rIn, e⟩
    . intros x y hxy z hxz
      obtain ⟨n1, n1In, e1⟩ := algebraCarrierMap.membership.forward with hxy
      obtain ⟨n2, n2In, e2⟩ := algebraCarrierMap.membership.forward with hxz
      obtain ⟨x1, y1⟩ := orderedPair.injective with e1
      obtain ⟨x2, z2⟩ := orderedPair.injective with e2
      cc
    . intros X XIn
      have mem : (X, algebraCarrier(X)) ∈ algebraCarrierMap(K, A) :=
        algebraCarrierMap.membership.backward with ⟨X, XIn, rfl⟩
      have rIn := Relation.range.contains with mem
      exact ⟨algebraCarrier(X), rIn, mem⟩
  refine ⟨kfn, ?_, ?_, ?_⟩
  . intros m mIn
    obtain ⟨_, X, XIn, Y, YIn, f, e, hom⟩ := algebraHoms.membership.forward with mIn
    obtain ⟨_, _, _, rh, _⟩ := hom
    obtain ⟨_, _, fFn, _⟩ := rh
    obtain ⟨cX, _⟩ := tkIalgebraCarrier.apply with XIn
    obtain ⟨cY, _⟩ := tkIalgebraCarrier.apply with YIn
    refine ⟨X, XIn, Y, YIn, f, e, ?_⟩
    rw [cX, cY]
    unfold algebraCarrier
    exact fFn
  . intros X XIn
    obtain ⟨alg, _⟩ := tkIalgebrasOver.ring with XIn
    have hom := AlgebraHom.identity with alg
    obtain ⟨cX, sub⟩ := tkIalgebraCarrier.apply with XIn
    rw cX
    have fn := identity.function at algebraCarrier(X)
    have b := tkIbound with fn, sub, sub
    have p := product.pair with XIn, XIn
    have p2 := product.pair with p, b
    apply algebraHoms.membership.backward
    exact ⟨p2, X, XIn, X, XIn, identity(algebraCarrier(X)), rfl, hom⟩
  . intros X XIn Y YIn Z ZIn f g fIn gIn
    obtain ⟨_, X1, X1In, Y1, Y1In, f1, e1, hom1⟩ := algebraHoms.membership.forward with fIn
    obtain ⟨_, Y2, Y2In, Z2, Z2In, g2, e2, hom2⟩ := algebraHoms.membership.forward with gIn
    obtain ⟨rs, ff⟩ := orderedPair.injective with e1
    obtain ⟨rr, ss⟩ := orderedPair.injective with rs
    obtain ⟨st, gg⟩ := orderedPair.injective with e2
    obtain ⟨ss2, tt⟩ := orderedPair.injective with st
    rw [← rr, ← ss, ← ff] at hom1
    rw [← ss2, ← tt, ← gg] at hom2
    have hom := AlgebraHom.compose with hom1, hom2
    obtain ⟨cX, subX⟩ := tkIalgebraCarrier.apply with XIn
    obtain ⟨cY, _⟩ := tkIalgebraCarrier.apply with YIn
    obtain ⟨cZ, subZ⟩ := tkIalgebraCarrier.apply with ZIn
    rw [cX, cY, cZ]
    have homb := hom
    obtain ⟨_, _, _, rh, _⟩ := homb
    obtain ⟨_, _, fn, _⟩ := rh
    unfold algebraCarrier at subX
    unfold algebraCarrier at subZ
    have b := tkIbound with fn, subX, subZ
    have p := product.pair with XIn, ZIn
    have p2 := product.pair with p, b
    apply algebraHoms.membership.backward
    exact ⟨p2, X, XIn, Z, ZIn, compose(g, f, algebraCarrier(X),
      algebraCarrier(Y), algebraCarrier(Z)), rfl, hom⟩

theorem algebraCategory.category (K A : Set)
  requires base : CommRing(A)
  shows Category(algebraCategory(K, A))
proof
  have data := tkIalgebraHoms.concrete at K, A
  unfold algebraCategory
  exact concreteCategory.category with data

theorem algebraCategory.hom (K A B C f : Set)
  requires first : B ∈ algebrasOver(K, A)
  requires second : C ∈ algebrasOver(K, A)
  shows ((B, C), f) ∈ hom(algebraCategory(K, A), B, C) ↔ AlgebraHom(f, B, C)
proof
  have data := tkIalgebraHoms.concrete at K, A
  have h := concreteCategory.hom at algebrasOver(K, A), algebraCarrierMap(K, A), algebraHoms(K, A), B, C, f with data, first, second
  unfold algebraCategory
  rw h
  constructor
  . intro mIn
    obtain ⟨_, R1, R1In, S1, S1In, f1, e1, hom1⟩ := algebraHoms.membership.forward with mIn
    obtain ⟨rs, ff⟩ := orderedPair.injective with e1
    obtain ⟨rr, ss⟩ := orderedPair.injective with rs
    rw [rr, ss, ff]
    exact hom1
  . intro hom
    have hom2 := hom
    obtain ⟨_, _, _, rh, _⟩ := hom2
    obtain ⟨_, _, fn, _⟩ := rh
    obtain ⟨_, subR⟩ := tkIalgebraCarrier.apply with first
    obtain ⟨_, subS⟩ := tkIalgebraCarrier.apply with second
    unfold algebraCarrier at subR
    unfold algebraCarrier at subS
    have b := tkIbound with fn, subR, subS
    have p := product.pair with first, second
    have p2 := product.pair with p, b
    apply algebraHoms.membership.backward
    exact ⟨p2, B, first, C, second, f, rfl, hom⟩

-- The algebras over A in K are exactly the algebras with base A whose ring
-- lies in K.
theorem algebrasOver.membership (K A B : Set)
  shows B ∈ algebrasOver(K, A) ↔
    (Algebra(B) ∧ Algebra.base(B) = A ∧ Algebra.ring(B) ∈ K)
proof
  constructor
  . intro m
    obtain ⟨sIn, alg⟩ := m
    obtain ⟨q, qIn, e⟩ := algebraShapes.membership.forward with sIn
    obtain ⟨_, S, SIn, φ, φIn, qE⟩ := product.membership.forward with qIn
    refine ⟨alg, ?_, ?_⟩
    . rw [← e, Algebra.mk.base]
    . rw [← e, Algebra.mk.ring, qE, fst.pair]
      exact SIn
  . intro h
    obtain ⟨alg, baseEq, ringIn⟩ := h
    have data := alg.left
    have eta := Algebra.eta with data
    have mapFn := Algebra.map_function with alg
    obtain ⟨_, sub⟩ := tkIringCarrier.apply with ringIn
    unfold algebraCarrier at mapFn
    rw baseEq at mapFn
    have refl : Ring.carrier(A) ⊆ Ring.carrier(A) := Subset.reflexive at Ring.carrier(A)
    have b := tkIbound with mapFn, refl, sub
    have qIn := product.pair with ringIn, b
    have sIn : B ∈ algebraShapes(K, A)
      apply algebraShapes.membership.backward
      refine ⟨(Algebra.ring(B), Algebra.map(B)), qIn, ?_⟩
      rw [fst.pair, snd.pair, ← baseEq]
      symm
      exact eta
    exact ⟨sIn, alg⟩

theorem tkIadditiveHom.id (G : Set)
  requires group : AbelianGroup(G)
  shows AdditiveHom(identity(Group.carrier(G)), G, G)
proof
  have fn := identity.function at Group.carrier(G)
  refine ⟨group, group, fn, ?_⟩
  intros x xIn y yIn
  have n : call2(Group.mul(G), x, y) ∈ Group.carrier(G) by typecheck
  rw [(identity.apply with n), (identity.apply with xIn), (identity.apply with yIn)]

theorem tkIadditiveHom.comp (f g G H L : Set)
  requires first : AdditiveHom(f, G, H)
  requires second : AdditiveHom(g, H, L)
  shows AdditiveHom(compose(g, f, Group.carrier(G), Group.carrier(H), Group.carrier(L)), G, L)
proof
  obtain ⟨aG, aH, fFn, fmul⟩ := first
  obtain ⟨_, aL, gFn, gmul⟩ := second
  have fn := compose.function with fFn, gFn
  refine ⟨aG, aL, fn, ?_⟩
  intros x xIn y yIn
  have n : call2(Group.mul(G), x, y) ∈ Group.carrier(G) by typecheck
  have fx := FunctionBetween.apply_closed with fFn, xIn
  have fy := FunctionBetween.apply_closed with fFn, yIn
  rw [(compose.apply with fFn, gFn, n), (compose.apply with fFn, gFn, xIn),
    (compose.apply with fFn, gFn, yIn)]
  rw [(fmul with x, xIn, y, yIn), (gmul with f(x), fx, f(y), fy)]

theorem tkIgroupCarrier.apply (U G : Set)
  requires member : G ∈ abelianGroupsIn(U)
  shows groupCarrierMap(U)(G) = Group.carrier(G) ∧ Group.carrier(G) ⊆ ⋃(groupCarriers(U))
proof
  constructor
  . have pairs : ∀ p ∈ groupCarrierMap(U), ∃ x, ∃ y, (x, y) = p
      intros p hp
      obtain ⟨n, nIn, shape⟩ := groupCarrierMap.membership.forward with hp
      exact ⟨n, Group.carrier(n), shape⟩
    have functional : Functional(groupCarrierMap(U))
      intros x y hxy z hxz
      obtain ⟨n1, n1In, e1⟩ := groupCarrierMap.membership.forward with hxy
      obtain ⟨n2, n2In, e2⟩ := groupCarrierMap.membership.forward with hxz
      obtain ⟨x1, y1⟩ := orderedPair.injective with e1
      obtain ⟨x2, z2⟩ := orderedPair.injective with e2
      cc
    have mem : (G, Group.carrier(G)) ∈ groupCarrierMap(U) :=
      groupCarrierMap.membership.backward with ⟨G, member, rfl⟩
    exact tkIfun.apply with pairs, functional, mem
  . intros x xIn
    have cIn : Group.carrier(G) ∈ groupCarriers(U) :=
      groupCarriers.membership.backward with ⟨G, member, rfl⟩
    exact set.union.backward with ⟨Group.carrier(G), cIn, xIn⟩

theorem tkIgroupHoms.concrete (U : Set)
  shows ConcreteData(abelianGroupsIn(U), groupCarrierMap(U), groupHoms(U))
proof
  have kfn : groupCarrierMap(U) : abelianGroupsIn(U) → Relation.range(groupCarrierMap(U))
    apply tkIfun.between
    . intros p hp
      obtain ⟨R, RIn, e⟩ := groupCarrierMap.membership.forward with hp
      have pIn := hp
      rw ← e at pIn
      have rIn := Relation.range.contains with pIn
      exact ⟨R, RIn, Group.carrier(R), rIn, e⟩
    . intros x y hxy z hxz
      obtain ⟨n1, n1In, e1⟩ := groupCarrierMap.membership.forward with hxy
      obtain ⟨n2, n2In, e2⟩ := groupCarrierMap.membership.forward with hxz
      obtain ⟨x1, y1⟩ := orderedPair.injective with e1
      obtain ⟨x2, z2⟩ := orderedPair.injective with e2
      cc
    . intros R RIn
      have mem : (R, Group.carrier(R)) ∈ groupCarrierMap(U) :=
        groupCarrierMap.membership.backward with ⟨R, RIn, rfl⟩
      have rIn := Relation.range.contains with mem
      exact ⟨Group.carrier(R), rIn, mem⟩
  refine ⟨kfn, ?_, ?_, ?_⟩
  . intros m mIn
    obtain ⟨_, R, RIn, S, SIn, f, e, hom⟩ := groupHoms.membership.forward with mIn
    obtain ⟨_, _, fFn, _⟩ := hom
    obtain ⟨cR, _⟩ := tkIgroupCarrier.apply with RIn
    obtain ⟨cS, _⟩ := tkIgroupCarrier.apply with SIn
    refine ⟨R, RIn, S, SIn, f, e, ?_⟩
    rw [cR, cS]
    exact fFn
  . intros R RIn
    obtain ⟨_, ab⟩ := abelianGroupsIn.membership.forward with RIn
    have hom := tkIadditiveHom.id with ab
    obtain ⟨cR, sub⟩ := tkIgroupCarrier.apply with RIn
    rw cR
    have fn := identity.function at Group.carrier(R)
    have b := tkIbound with fn, sub, sub
    have p := product.pair with RIn, RIn
    have p2 := product.pair with p, b
    apply groupHoms.membership.backward
    exact ⟨p2, R, RIn, R, RIn, identity(Group.carrier(R)), rfl, hom⟩
  . intros R RIn S SIn T TIn f g fIn gIn
    obtain ⟨_, R1, R1In, S1, S1In, f1, e1, hom1⟩ := groupHoms.membership.forward with fIn
    obtain ⟨_, S2, S2In, T2, T2In, g2, e2, hom2⟩ := groupHoms.membership.forward with gIn
    obtain ⟨rs, ff⟩ := orderedPair.injective with e1
    obtain ⟨rr, ss⟩ := orderedPair.injective with rs
    obtain ⟨st, gg⟩ := orderedPair.injective with e2
    obtain ⟨ss2, tt⟩ := orderedPair.injective with st
    rw [← rr, ← ss, ← ff] at hom1
    rw [← ss2, ← tt, ← gg] at hom2
    have hom := tkIadditiveHom.comp with hom1, hom2
    obtain ⟨cR, subR⟩ := tkIgroupCarrier.apply with RIn
    obtain ⟨cS, _⟩ := tkIgroupCarrier.apply with SIn
    obtain ⟨cT, subT⟩ := tkIgroupCarrier.apply with TIn
    rw [cR, cS, cT]
    have hom2b := hom
    obtain ⟨_, _, fn, _⟩ := hom2b
    have b := tkIbound with fn, subR, subT
    have p := product.pair with RIn, TIn
    have p2 := product.pair with p, b
    apply groupHoms.membership.backward
    exact ⟨p2, R, RIn, T, TIn, compose(g, f, Group.carrier(R), Group.carrier(S),
      Group.carrier(T)), rfl, hom⟩

theorem abelianGroupCategory.category (U : Set)
  shows Category(abelianGroupCategory(U))
proof
  have data := tkIgroupHoms.concrete at U
  unfold abelianGroupCategory
  exact concreteCategory.category with data

theorem abelianGroupCategory.hom (U G H f : Set)
  requires first : G ∈ abelianGroupsIn(U)
  requires second : H ∈ abelianGroupsIn(U)
  shows ((G, H), f) ∈ hom(abelianGroupCategory(U), G, H) ↔ AdditiveHom(f, G, H)
proof
  have data := tkIgroupHoms.concrete at U
  have h := concreteCategory.hom at abelianGroupsIn(U), groupCarrierMap(U), groupHoms(U), G, H, f with data, first, second
  unfold abelianGroupCategory
  rw h
  constructor
  . intro mIn
    obtain ⟨_, R1, R1In, S1, S1In, f1, e1, hom1⟩ := groupHoms.membership.forward with mIn
    obtain ⟨rs, ff⟩ := orderedPair.injective with e1
    obtain ⟨rr, ss⟩ := orderedPair.injective with rs
    rw [rr, ss, ff]
    exact hom1
  . intro hom
    have hom2 := hom
    obtain ⟨_, _, fn, _⟩ := hom2
    obtain ⟨_, subR⟩ := tkIgroupCarrier.apply with first
    obtain ⟨_, subS⟩ := tkIgroupCarrier.apply with second
    have b := tkIbound with fn, subR, subS
    have p := product.pair with first, second
    have p2 := product.pair with p, b
    apply groupHoms.membership.backward
    exact ⟨p2, G, first, H, second, f, rfl, hom⟩

-- AddCommGrpCat: isomorphisms are the bijective homomorphisms.
theorem abelianGroupCategory.isomorphism (U G H f : Set)
  requires first : G ∈ abelianGroupsIn(U)
  requires second : H ∈ abelianGroupsIn(U)
  requires hom : AdditiveHom(f, G, H)
  shows Isomorphism(abelianGroupCategory(U), ((G, H), f)) ↔
    BijectiveBetween(f, Group.carrier(G), Group.carrier(H))
proof
  sorry

theorem tkImoduleCarrier.apply (U R G : Set)
  requires member : G ∈ modulesIn(U, R)
  shows moduleCarrierMap(U, R)(G) = Module.carrier(G) ∧
    Module.carrier(G) ⊆ ⋃(moduleCarriers(U, R))
proof
  constructor
  . have pairs : ∀ p ∈ moduleCarrierMap(U, R), ∃ x, ∃ y, (x, y) = p
      intros p hp
      obtain ⟨n, nIn, shape⟩ := moduleCarrierMap.membership.forward with hp
      exact ⟨n, Module.carrier(n), shape⟩
    have functional : Functional(moduleCarrierMap(U, R))
      intros x y hxy z hxz
      obtain ⟨n1, n1In, e1⟩ := moduleCarrierMap.membership.forward with hxy
      obtain ⟨n2, n2In, e2⟩ := moduleCarrierMap.membership.forward with hxz
      obtain ⟨x1, y1⟩ := orderedPair.injective with e1
      obtain ⟨x2, z2⟩ := orderedPair.injective with e2
      cc
    have mem : (G, Module.carrier(G)) ∈ moduleCarrierMap(U, R) :=
      moduleCarrierMap.membership.backward with ⟨G, member, rfl⟩
    exact tkIfun.apply with pairs, functional, mem
  . intros x xIn
    have cIn : Module.carrier(G) ∈ moduleCarriers(U, R) :=
      moduleCarriers.membership.backward with ⟨G, member, rfl⟩
    exact set.union.backward with ⟨Module.carrier(G), cIn, xIn⟩

theorem tkImoduleHoms.concrete (U R : Set)
  shows ConcreteData(modulesIn(U, R), moduleCarrierMap(U, R), moduleHoms(U, R))
proof
  have kfn : moduleCarrierMap(U, R) : modulesIn(U, R) → Relation.range(moduleCarrierMap(U, R))
    apply tkIfun.between
    . intros p hp
      obtain ⟨X, XIn, e⟩ := moduleCarrierMap.membership.forward with hp
      have pIn := hp
      rw ← e at pIn
      have rIn := Relation.range.contains with pIn
      exact ⟨X, XIn, Module.carrier(X), rIn, e⟩
    . intros x y hxy z hxz
      obtain ⟨n1, n1In, e1⟩ := moduleCarrierMap.membership.forward with hxy
      obtain ⟨n2, n2In, e2⟩ := moduleCarrierMap.membership.forward with hxz
      obtain ⟨x1, y1⟩ := orderedPair.injective with e1
      obtain ⟨x2, z2⟩ := orderedPair.injective with e2
      cc
    . intros X XIn
      have mem : (X, Module.carrier(X)) ∈ moduleCarrierMap(U, R) :=
        moduleCarrierMap.membership.backward with ⟨X, XIn, rfl⟩
      have rIn := Relation.range.contains with mem
      exact ⟨Module.carrier(X), rIn, mem⟩
  refine ⟨kfn, ?_, ?_, ?_⟩
  . intros m mIn
    obtain ⟨_, X, XIn, Y, YIn, f, e, hom⟩ := moduleHoms.membership.forward with mIn
    obtain ⟨_, _, fFn, _⟩ := hom
    obtain ⟨cX, _⟩ := tkImoduleCarrier.apply with XIn
    obtain ⟨cY, _⟩ := tkImoduleCarrier.apply with YIn
    refine ⟨X, XIn, Y, YIn, f, e, ?_⟩
    rw [cX, cY]
    exact fFn
  . intros X XIn
    obtain ⟨_, md⟩ := modulesIn.membership.forward with XIn
    have hom := LinearMap.identity with md
    obtain ⟨cX, sub⟩ := tkImoduleCarrier.apply with XIn
    rw cX
    have fn := identity.function at Module.carrier(X)
    have b := tkIbound with fn, sub, sub
    have p := product.pair with XIn, XIn
    have p2 := product.pair with p, b
    apply moduleHoms.membership.backward
    exact ⟨p2, X, XIn, X, XIn, identity(Module.carrier(X)), rfl, hom⟩
  . intros X XIn Y YIn Z ZIn f g fIn gIn
    obtain ⟨_, X1, X1In, Y1, Y1In, f1, e1, hom1⟩ := moduleHoms.membership.forward with fIn
    obtain ⟨_, Y2, Y2In, Z2, Z2In, g2, e2, hom2⟩ := moduleHoms.membership.forward with gIn
    obtain ⟨rs, ff⟩ := orderedPair.injective with e1
    obtain ⟨rr, ss⟩ := orderedPair.injective with rs
    obtain ⟨st, gg⟩ := orderedPair.injective with e2
    obtain ⟨ss2, tt⟩ := orderedPair.injective with st
    rw [← rr, ← ss, ← ff] at hom1
    rw [← ss2, ← tt, ← gg] at hom2
    have hom := LinearMap.compose with hom1, hom2
    obtain ⟨cX, subX⟩ := tkImoduleCarrier.apply with XIn
    obtain ⟨cY, _⟩ := tkImoduleCarrier.apply with YIn
    obtain ⟨cZ, subZ⟩ := tkImoduleCarrier.apply with ZIn
    rw [cX, cY, cZ]
    have homb := hom
    obtain ⟨_, _, fn, _⟩ := homb
    have b := tkIbound with fn, subX, subZ
    have p := product.pair with XIn, ZIn
    have p2 := product.pair with p, b
    apply moduleHoms.membership.backward
    exact ⟨p2, X, XIn, Z, ZIn, compose(g, f, Module.carrier(X), Module.carrier(Y),
      Module.carrier(Z)), rfl, hom⟩

theorem moduleCategory.category (U R : Set)
  requires ring : Ring(R)
  shows Category(moduleCategory(U, R))
proof
  have data := tkImoduleHoms.concrete at U, R
  unfold moduleCategory
  exact concreteCategory.category with data

theorem moduleCategory.hom (U R M N f : Set)
  requires first : M ∈ modulesIn(U, R)
  requires second : N ∈ modulesIn(U, R)
  shows ((M, N), f) ∈ hom(moduleCategory(U, R), M, N) ↔ LinearMap(f, M, R, N)
proof
  have data := tkImoduleHoms.concrete at U, R
  have h := concreteCategory.hom at modulesIn(U, R), moduleCarrierMap(U, R), moduleHoms(U, R), M, N, f with data, first, second
  unfold moduleCategory
  rw h
  constructor
  . intro mIn
    obtain ⟨_, R1, R1In, S1, S1In, f1, e1, hom1⟩ := moduleHoms.membership.forward with mIn
    obtain ⟨rs, ff⟩ := orderedPair.injective with e1
    obtain ⟨rr, ss⟩ := orderedPair.injective with rs
    rw [rr, ss, ff]
    exact hom1
  . intro hom
    have hom2 := hom
    obtain ⟨_, _, fn, _⟩ := hom2
    obtain ⟨_, subR⟩ := tkImoduleCarrier.apply with first
    obtain ⟨_, subS⟩ := tkImoduleCarrier.apply with second
    have b := tkIbound with fn, subR, subS
    have p := product.pair with first, second
    have p2 := product.pair with p, b
    apply moduleHoms.membership.backward
    exact ⟨p2, M, first, N, second, f, rfl, hom⟩

-- Section: 𝒰 is a set of rings closed under the region's constructions
-- A ring structure lies in V(ω·2) exactly when its carrier does: the
-- operations are subsets of finite products of the carrier.
theorem testRings.membership (R : Set)
  requires comm : CommRing(R)
  shows R ∈ testRings ↔ Ring.carrier(R) ∈ testStage
proof
  sorry

theorem testCategory.category
  shows Category(testCategory)
proof
  have rings : ∀ R ∈ testRings, Ring(R)
    intros R RIn
    obtain ⟨_, comm⟩ := RIn
    exact CommRing.to_ring with comm
  unfold testCategory
  exact ringCategory.category with rings

theorem testCategory.obj
  shows Category.obj(testCategory) = testRings
proof
  simp [testCategory, ringCategory, concreteCategory, Category.mk.obj]

-- Transport of structure (README, Universes: "every ring of cardinality
-- < ℶ_ω has a copy in 𝒰"): a commutative ring whose carrier injects into a
-- member of V(ω·2) is isomorphic to a test ring.
theorem testRings.essentially_of_injection (R X f : Set)
  requires comm : CommRing(R)
  requires stage : X ∈ testStage
  requires injection : InjectiveBetween(f, Ring.carrier(R), X)
  shows EssentiallyIn(testRings, R)
proof
  sorry

-- Rings of cardinality at most 2^ℵ₀ (the base rings ℤ, ℚ, ℚ̄, ℂ, ℚ_p, ℂ_p,
-- O_C, A_inf, A_max, B_cris of the region).
theorem testRings.essentially_of_continuum (R f : Set)
  requires comm : CommRing(R)
  requires injection : InjectiveBetween(f, Ring.carrier(R), 𝒫(𝒫(ℕ)))
  shows EssentiallyIn(testRings, R)
proof
  sorry

-- Quotients and localizations preserve rank: they are closed on the nose
-- (audit C1, C2, C3).
theorem testRings.quotient (R I : Set)
  requires test : R ∈ testRings
  requires ideal : Ideal(R, I)
  shows quotientRing(R, I) ∈ testRings
proof
  sorry

theorem testRings.localization (R S : Set)
  requires test : R ∈ testRings
  requires multiplicative : MultiplicativeSubset(R, S)
  shows localizationRing(R, S) ∈ testRings
proof
  sorry

theorem testRings.localization_away (R x : Set)
  requires test : R ∈ testRings
  requires element : x ∈ Ring.carrier(R)
  shows localizationAway(R, x) ∈ testRings
proof
  sorry

theorem testRings.localization_at_prime (R P : Set)
  requires test : R ∈ testRings
  requires prime : PrimeIdeal(R, P)
  shows localizationAtPrime(R, P) ∈ testRings
proof
  sorry

theorem testRings.fraction_ring (R : Set)
  requires test : R ∈ testRings
  shows fractionRing(R) ∈ testRings
proof
  sorry

theorem testRings.residue_field (R P : Set)
  requires test : R ∈ testRings
  requires prime : PrimeIdeal(R, P)
  shows primeResidueField(R, P) ∈ testRings
proof
  sorry

-- Subrings (audit C8).
theorem testRings.subring (R S : Set)
  requires test : R ∈ testRings
  requires subring : Subring(R, S)
  shows subringRing(R, S) ∈ testRings
proof
  sorry

-- Polynomial rings over an index set in V(ω·2) (audit C4), products over
-- index sets in V(ω·2), finite ones included (C5, C6), tensor products of
-- algebras over a common base (C7) and adic completions (C11): closed up
-- to isomorphism.
theorem testRings.polynomial (R I : Set)
  requires test : R ∈ testRings
  requires index : I ∈ testStage
  shows EssentiallyIn(testRings, polynomialRing(R, I))
proof
  sorry

theorem testRings.product (I F : Set)
  requires index : I ∈ testStage
  requires family : F : I → testRings
  shows EssentiallyIn(testRings, piRing(I, F))
proof
  sorry

theorem testRings.tensor_product (A B : Set)
  requires first : Algebra(A)
  requires second : Algebra(B)
  requires sameBase : Algebra.base(A) = Algebra.base(B)
  requires baseTest : Algebra.base(A) ∈ testRings
  requires testA : Algebra.ring(A) ∈ testRings
  requires testB : Algebra.ring(B) ∈ testRings
  shows EssentiallyIn(testRings, algebraTensorRing(A, B))
proof
  sorry

theorem testRings.completion (R I : Set)
  requires test : R ∈ testRings
  requires ideal : Ideal(R, I)
  shows EssentiallyIn(testRings, adicCompletionRing(R, I))
proof
  sorry

-- Finitely generated algebras: quotients of polynomial rings in finitely
-- many variables, in particular finite, étale and smooth algebras (C20).
theorem testRings.finite_type (A : Set)
  requires finiteType : FiniteTypeAlgebra(A)
  requires baseTest : Algebra.base(A) ∈ testRings
  shows EssentiallyIn(testRings, Algebra.ring(A))
proof
  sorry

-- Transport: a ring isomorphic to a test ring is essentially in 𝒰, and an
-- essentially-in ring has an isomorphic copy in the test category, so
-- every statement about test rings transports along the isomorphism.
theorem EssentiallyIn.of_iso (R S φ : Set)
  requires essential : EssentiallyIn(testRings, S)
  requires iso : RingIso(φ, R, S)
  shows EssentiallyIn(testRings, R)
proof
  obtain ⟨T, TIn, ψ, isoST⟩ := essential
  obtain ⟨homRS, bijRS⟩ := iso
  obtain ⟨homST, bijST⟩ := isoST
  have hom := tkIringHom.comp with homRS, homST
  have bij := compose.bijective with bijRS, bijST
  exact ⟨T, TIn, compose(ψ, φ, Ring.carrier(R), Ring.carrier(S), Ring.carrier(T)), hom, bij⟩

-- Section: Full subcategories
-- The full subcategory of C on a set P of objects (ObjectProperty.
-- FullSubcategory): the morphisms of C between members of P, with the
-- structure of C restricted.
def fullMorphisms (C P : Set) : Set :=
  { f ∈ mor(C) | dom(C)(f) ∈ P ∧ cod(C)(f) ∈ P }

def fullSubcategory (C P : Set) : Set :=
  Category.mk(P, fullMorphisms(C, P), restrict(dom(C), fullMorphisms(C, P)),
    restrict(cod(C), fullMorphisms(C, P)), restrict(Category.id(C), P),
    restrict(Category.comp(C),
      composablePairsOf(fullMorphisms(C, P), dom(C), cod(C))))

-- The inclusion functor (ObjectProperty.ι).
def fullInclusion (C P : Set) : Set :=
  Functor.mk(identity(P), identity(fullMorphisms(C, P)), fullSubcategory(C, P), C)

-- The full subcategory of C on the objects of the form F(a), for a
-- functor F (ObjectProperty.lift factors a functor through it).
def fullCorestriction (F C D P : Set) : Set :=
  Functor.mk(Functor.obj(F), Functor.map(F), C, fullSubcategory(D, P))

section FullSubcategories
variable (C P : Set)
hypothesis category : Category(C)
hypothesis objects : P ⊆ Category.obj(C)

theorem tkIfull.member (f : Set)
  shows f ∈ fullMorphisms(C, P) ↔ (f ∈ mor(C) ∧ dom(C)(f) ∈ P ∧ cod(C)(f) ∈ P)
proof
  constructor
  . intro h
    obtain ⟨fIn, d, c⟩ := fullMorphisms.membership.forward with h
    exact ⟨fIn, d, c⟩
  . intro h
    obtain ⟨fIn, d, c⟩ := h
    exact fullMorphisms.membership.backward with ⟨fIn, d, c⟩

theorem tkIfull.subset
  shows fullMorphisms(C, P) ⊆ mor(C)
proof
  intros f fIn
  obtain ⟨m, _, _⟩ := fullMorphisms.membership.forward with fIn
  exact m

theorem tkIfull.dom (f : Set)
  requires member : f ∈ fullMorphisms(C, P)
  shows restrict(dom(C), fullMorphisms(C, P))(f) = dom(C)(f)
proof
  have fn := Category.dom_function with category
  have sub := tkIfull.subset at C, P with category, objects
  exact restrict.domain_apply with fn, sub, member

theorem tkIfull.cod (f : Set)
  requires member : f ∈ fullMorphisms(C, P)
  shows restrict(cod(C), fullMorphisms(C, P))(f) = cod(C)(f)
proof
  have fn := Category.cod_function with category
  have sub := tkIfull.subset at C, P with category, objects
  exact restrict.domain_apply with fn, sub, member

theorem tkIfull.id (a : Set)
  requires member : a ∈ P
  shows restrict(Category.id(C), P)(a) = Category.id(C)(a)
proof
  have fn := Category.id_function with category
  exact restrict.domain_apply with fn, objects, member

theorem tkIfull.pairs
  shows composablePairsOf(fullMorphisms(C, P), dom(C), cod(C)) ⊆ composablePairs(C)
proof
  intros q qIn
  obtain ⟨_, g, gIn, f, fIn, shape, comp⟩ := composablePairsOf.membership.forward with qIn
  have sub := tkIfull.subset at C, P with category, objects
  have gM := sub with g, gIn
  have fM := sub with f, fIn
  rw shape
  exact composablePairs.pair with gM, fM, comp

theorem tkIfull.comp (f g : Set)
  requires first : f ∈ fullMorphisms(C, P)
  requires second : g ∈ fullMorphisms(C, P)
  requires composable : dom(C)(g) = cod(C)(f)
  shows call2(restrict(Category.comp(C),
      composablePairsOf(fullMorphisms(C, P), dom(C), cod(C))), g, f) =
    call2(Category.comp(C), g, f)
proof
  have fn := Category.comp_function with category
  have sub := tkIfull.pairs at C, P with category, objects
  have qIn := composablePairsOf.pair with second, first, composable
  unfold call2
  exact restrict.domain_apply with fn, sub, qIn

theorem tkIfull.composable_eq
  shows composablePairsOf(fullMorphisms(C, P), restrict(dom(C), fullMorphisms(C, P)),
      restrict(cod(C), fullMorphisms(C, P))) =
    composablePairsOf(fullMorphisms(C, P), dom(C), cod(C))
proof
  ext q
  constructor
  . intro qIn
    obtain ⟨_, g, gIn, f, fIn, shape, comp⟩ := composablePairsOf.membership.forward with qIn
    have d := tkIfull.dom at C, P, g with category, objects, gIn
    have c := tkIfull.cod at C, P, f with category, objects, fIn
    rw [d, c] at comp
    rw shape
    exact composablePairsOf.pair with gIn, fIn, comp
  . intro qIn
    obtain ⟨_, g, gIn, f, fIn, shape, comp⟩ := composablePairsOf.membership.forward with qIn
    have d := tkIfull.dom at C, P, g with category, objects, gIn
    have c := tkIfull.cod at C, P, f with category, objects, fIn
    rw [← d, ← c] at comp
    rw shape
    exact composablePairsOf.pair with gIn, fIn, comp

theorem fullSubcategory.category
  shows Category(fullSubcategory(C, P))
proof
  have sub := tkIfull.subset at C, P with category, objects
  have domC := Category.dom_function with category
  have codC := Category.cod_function with category
  have idC := Category.id_function with category
  have compC := Category.comp_function with category
  have domFn : restrict(dom(C), fullMorphisms(C, P)) : fullMorphisms(C, P) → P
    apply restrict.function with domC, sub
    intros f fIn
    obtain ⟨_, d, _⟩ := fullMorphisms.membership.forward with fIn
    exact d
  have codFn : restrict(cod(C), fullMorphisms(C, P)) : fullMorphisms(C, P) → P
    apply restrict.function with codC, sub
    intros f fIn
    obtain ⟨_, _, c⟩ := fullMorphisms.membership.forward with fIn
    exact c
  have idFn : restrict(Category.id(C), P) : P → fullMorphisms(C, P)
    apply restrict.function with idC, objects
    intros a aIn
    have aO := objects with a, aIn
    have iM := Category.id_closed with category, aO
    have d := Category.id_dom with category, aO
    have c := Category.id_cod with category, aO
    apply fullMorphisms.membership.backward
    rw [d, c]
    exact ⟨iM, aIn, aIn⟩
  have pairsSub := tkIfull.pairs at C, P with category, objects
  have compFn0 : restrict(Category.comp(C),
      composablePairsOf(fullMorphisms(C, P), dom(C), cod(C))) :
      composablePairsOf(fullMorphisms(C, P), dom(C), cod(C)) → fullMorphisms(C, P)
    apply restrict.function with compC, pairsSub
    intros q qIn
    obtain ⟨_, g, gIn, f, fIn, shape, comp⟩ := composablePairsOf.membership.forward with qIn
    obtain ⟨gM, gd, gc⟩ := fullMorphisms.membership.forward with gIn
    obtain ⟨fM, fd, fc⟩ := fullMorphisms.membership.forward with fIn
    have kM := Category.comp_closed with category, gM, fM, comp
    have kd := Category.comp_dom with category, gM, fM, comp
    have kc := Category.comp_cod with category, gM, fM, comp
    rw shape
    rw ← (Category.comp_value at C, g, f with category)
    apply fullMorphisms.membership.backward
    rw [kd, kc]
    exact ⟨kM, fd, gc⟩
  have eqPairs := tkIfull.composable_eq at C, P with category, objects
  have compFn : restrict(Category.comp(C),
      composablePairsOf(fullMorphisms(C, P), dom(C), cod(C))) :
      composablePairsOf(fullMorphisms(C, P), restrict(dom(C), fullMorphisms(C, P)),
        restrict(cod(C), fullMorphisms(C, P))) → fullMorphisms(C, P)
    rw eqPairs
    exact compFn0
  unfold fullSubcategory
  apply Category.intro with domFn, codFn, idFn, compFn
  . intros a aIn
    have aO := objects with a, aIn
    have iv := tkIfull.id at C, P, a with category, objects, aIn
    have iM := Category.id_closed with category, aO
    have d := Category.id_dom with category, aO
    have c := Category.id_cod with category, aO
    have iIn : Category.id(C)(a) ∈ fullMorphisms(C, P)
      apply fullMorphisms.membership.backward
      rw [d, c]
      exact ⟨iM, aIn, aIn⟩
    rw iv
    rw (tkIfull.dom at C, P, Category.id(C)(a) with category, objects, iIn)
    rw (tkIfull.cod at C, P, Category.id(C)(a) with category, objects, iIn)
    exact ⟨d, c⟩
  . intros g gIn f fIn composable
    rw (tkIfull.dom at C, P, g with category, objects, gIn) at composable
    rw (tkIfull.cod at C, P, f with category, objects, fIn) at composable
    rw (tkIfull.comp at C, P, f, g with category, objects, fIn, gIn, composable)
    obtain ⟨gM, gd, gc⟩ := fullMorphisms.membership.forward with gIn
    obtain ⟨fM, fd, fc⟩ := fullMorphisms.membership.forward with fIn
    have kM := Category.comp_closed with category, gM, fM, composable
    have kd := Category.comp_dom with category, gM, fM, composable
    have kc := Category.comp_cod with category, gM, fM, composable
    have kIn : call2(Category.comp(C), g, f) ∈ fullMorphisms(C, P)
      apply fullMorphisms.membership.backward
      rw [kd, kc]
      exact ⟨kM, fd, gc⟩
    rw (tkIfull.dom at C, P, call2(Category.comp(C), g, f) with category, objects, kIn)
    rw (tkIfull.cod at C, P, call2(Category.comp(C), g, f) with category, objects, kIn)
    rw (tkIfull.dom at C, P, f with category, objects, fIn)
    rw (tkIfull.cod at C, P, g with category, objects, gIn)
    exact ⟨kd, kc⟩
  . intros f fIn
    obtain ⟨fM, fd, fc⟩ := fullMorphisms.membership.forward with fIn
    rw (tkIfull.dom at C, P, f with category, objects, fIn)
    rw (tkIfull.cod at C, P, f with category, objects, fIn)
    rw (tkIfull.id at C, P, cod(C)(f) with category, objects, fc)
    rw (tkIfull.id at C, P, dom(C)(f) with category, objects, fd)
    have cO := objects with cod(C)(f), fc
    have dO := objects with dom(C)(f), fd
    have iM := Category.id_closed with category, cO
    have id2 := Category.id_dom with category, cO
    have ic := Category.id_cod with category, cO
    have jM := Category.id_closed with category, dO
    have jd := Category.id_dom with category, dO
    have jc := Category.id_cod with category, dO
    have iIn : Category.id(C)(cod(C)(f)) ∈ fullMorphisms(C, P)
      apply fullMorphisms.membership.backward
      rw [id2, ic]
      exact ⟨iM, fc, fc⟩
    have jIn : Category.id(C)(dom(C)(f)) ∈ fullMorphisms(C, P)
      apply fullMorphisms.membership.backward
      rw [jd, jc]
      exact ⟨jM, fd, fd⟩
    have c1 : dom(C)(Category.id(C)(cod(C)(f))) = cod(C)(f) := id2
    have c2 : dom(C)(f) = cod(C)(Category.id(C)(dom(C)(f)))
      rw jc
    rw (tkIfull.comp at C, P, f, Category.id(C)(cod(C)(f)) with category, objects, fIn, iIn, c1)
    rw (tkIfull.comp at C, P, Category.id(C)(dom(C)(f)), f with category, objects, jIn, fIn, c2)
    have l := Category.left_unit with category, fM
    have r := Category.right_unit with category, fM
    exact ⟨l, r⟩
  . intros h hIn g gIn f fIn hg gf
    rw (tkIfull.dom at C, P, h with category, objects, hIn) at hg
    rw (tkIfull.cod at C, P, g with category, objects, gIn) at hg
    rw (tkIfull.dom at C, P, g with category, objects, gIn) at gf
    rw (tkIfull.cod at C, P, f with category, objects, fIn) at gf
    obtain ⟨hM, hd, hc⟩ := fullMorphisms.membership.forward with hIn
    obtain ⟨gM, gd, gc⟩ := fullMorphisms.membership.forward with gIn
    obtain ⟨fM, fd, fc⟩ := fullMorphisms.membership.forward with fIn
    have hgM := Category.comp_closed with category, hM, gM, hg
    have hgd := Category.comp_dom with category, hM, gM, hg
    have hgc := Category.comp_cod with category, hM, gM, hg
    have gfM := Category.comp_closed with category, gM, fM, gf
    have gfd := Category.comp_dom with category, gM, fM, gf
    have gfc := Category.comp_cod with category, gM, fM, gf
    have hgIn : call2(Category.comp(C), h, g) ∈ fullMorphisms(C, P)
      apply fullMorphisms.membership.backward
      rw [hgd, hgc]
      exact ⟨hgM, gd, hc⟩
    have gfIn : call2(Category.comp(C), g, f) ∈ fullMorphisms(C, P)
      apply fullMorphisms.membership.backward
      rw [gfd, gfc]
      exact ⟨gfM, fd, gc⟩
    have e1 : dom(C)(call2(Category.comp(C), h, g)) = cod(C)(f) by cc
    have e2 : dom(C)(h) = cod(C)(call2(Category.comp(C), g, f)) by cc
    rw (tkIfull.comp at C, P, g, h with category, objects, gIn, hIn, hg)
    rw (tkIfull.comp at C, P, f, g with category, objects, fIn, gIn, gf)
    rw (tkIfull.comp at C, P, f, call2(Category.comp(C), h, g) with category, objects, fIn, hgIn, e1)
    rw (tkIfull.comp at C, P, call2(Category.comp(C), g, f), h with category, objects, gfIn, hIn, e2)
    exact Category.associative with category, hM, gM, fM, hg, gf

theorem tkIfull.projections
  shows Category.obj(fullSubcategory(C, P)) = P ∧
    mor(fullSubcategory(C, P)) = fullMorphisms(C, P) ∧
    dom(fullSubcategory(C, P)) = restrict(dom(C), fullMorphisms(C, P)) ∧
    cod(fullSubcategory(C, P)) = restrict(cod(C), fullMorphisms(C, P)) ∧
    Category.id(fullSubcategory(C, P)) = restrict(Category.id(C), P) ∧
    Category.comp(fullSubcategory(C, P)) = restrict(Category.comp(C),
      composablePairsOf(fullMorphisms(C, P), dom(C), cod(C)))
proof
  simp [fullSubcategory, Category.mk.obj, Category.mk.mor, Category.mk.dom,
    Category.mk.cod, Category.mk.id, Category.mk.comp]

theorem tkIfull.hom_iff (a b f : Set)
  requires first : a ∈ P
  requires second : b ∈ P
  shows f ∈ hom(fullSubcategory(C, P), a, b) ↔ f ∈ hom(C, a, b)
proof
  obtain ⟨pO, pM, pD, pC, pI, pK⟩ := tkIfull.projections at C, P with category, objects
  constructor
  . intro m
    obtain ⟨fIn, d, c⟩ := hom.membership.forward with m
    rw pM at fIn
    rw pD at d
    rw pC at c
    rw (tkIfull.dom at C, P, f with category, objects, fIn) at d
    rw (tkIfull.cod at C, P, f with category, objects, fIn) at c
    obtain ⟨fM, _, _⟩ := fullMorphisms.membership.forward with fIn
    exact hom.membership.backward with ⟨fM, d, c⟩
  . intro m
    obtain ⟨fM, d, c⟩ := hom.membership.forward with m
    have dP : dom(C)(f) ∈ P
      rw d
      exact first
    have cP : cod(C)(f) ∈ P
      rw c
      exact second
    have fIn := fullMorphisms.membership.backward with ⟨fM, dP, cP⟩
    apply hom.membership.backward
    rw [pM, pD, pC]
    rw (tkIfull.dom at C, P, f with category, objects, fIn)
    rw (tkIfull.cod at C, P, f with category, objects, fIn)
    exact ⟨fIn, d, c⟩

theorem fullSubcategory.hom (a b : Set)
  requires first : a ∈ P
  requires second : b ∈ P
  shows hom(fullSubcategory(C, P), a, b) = hom(C, a, b)
proof
  ext f
  exact tkIfull.hom_iff at C, P, a, b, f with category, objects, first, second

theorem fullSubcategory.comp (f g : Set)
  requires first : f ∈ fullMorphisms(C, P)
  requires second : g ∈ fullMorphisms(C, P)
  requires composable : dom(C)(g) = cod(C)(f)
  shows call2(Category.comp(fullSubcategory(C, P)), g, f) =
    call2(Category.comp(C), g, f)
proof
  obtain ⟨pO, pM, pD, pC, pI, pK⟩ := tkIfull.projections at C, P with category, objects
  rw pK
  exact tkIfull.comp at C, P, f, g with category, objects, first, second, composable

theorem fullInclusion.functor
  shows fullInclusion(C, P) : fullSubcategory(C, P) ⥤ C
proof
  obtain ⟨pO, pM, pD, pC, pI, pK⟩ := tkIfull.projections at C, P with category, objects
  have cat := fullSubcategory.category at C, P with category, objects
  have sub := tkIfull.subset at C, P with category, objects
  have oFn := identity.inclusion with objects
  have mFn := identity.inclusion with sub
  unfold fullInclusion
  apply Functor.intro with cat, category
  . rw pO
    exact oFn
  . rw pM
    exact mFn
  . intros a aIn b bIn f fHom
    rw pO at aIn
    rw pO at bIn
    have m := Morphism.hom with fHom
    have m2 := (tkIfull.hom_iff at C, P, a, b, f with category, objects, aIn, bIn).forward with m
    obtain ⟨fIn, _, _⟩ := hom.membership.forward with m
    rw pM at fIn
    rw [(identity.apply with fIn), (identity.apply with aIn), (identity.apply with bIn)]
    exact Morphism.of_hom with m2
  . intros a aIn
    rw pO at aIn
    have aO := objects with a, aIn
    have iM := Category.id_closed with category, aO
    have d := Category.id_dom with category, aO
    have c := Category.id_cod with category, aO
    have iIn : Category.id(C)(a) ∈ fullMorphisms(C, P)
      apply fullMorphisms.membership.backward
      rw [d, c]
      exact ⟨iM, aIn, aIn⟩
    rw [pI, (tkIfull.id at C, P, a with category, objects, aIn)]
    rw [(identity.apply with iIn), (identity.apply with aIn)]
  . intros a aIn b bIn c cIn f fHom g gHom
    rw pO at aIn
    rw pO at bIn
    rw pO at cIn
    have mf := Morphism.hom with fHom
    have mg := Morphism.hom with gHom
    have mf2 := (tkIfull.hom_iff at C, P, a, b, f with category, objects, aIn, bIn).forward with mf
    have mg2 := (tkIfull.hom_iff at C, P, b, c, g with category, objects, bIn, cIn).forward with mg
    have mgf := hom.comp with cat, mg, mf
    obtain ⟨gfIn, _, _⟩ := hom.membership.forward with mgf
    obtain ⟨fIn, _, _⟩ := hom.membership.forward with mf
    obtain ⟨gIn, _, _⟩ := hom.membership.forward with mg
    rw pM at gfIn
    rw pM at fIn
    rw pM at gIn
    have comp := hom.composable with mg2, mf2
    rw [(identity.apply with gfIn), (identity.apply with fIn), (identity.apply with gIn)]
    rw pK
    exact tkIfull.comp at C, P, f, g with category, objects, fIn, gIn, comp
  . rfl
  . rfl

theorem fullInclusion.full
  shows Full(fullInclusion(C, P), fullSubcategory(C, P), C)
proof
  obtain ⟨pO, pM, pD, pC, pI, pK⟩ := tkIfull.projections at C, P with category, objects
  have functor := fullInclusion.functor at C, P with category, objects
  have fo : Functor.obj(fullInclusion(C, P)) = identity(P)
    simp [fullInclusion, Functor.mk.obj]
  have fm : Functor.map(fullInclusion(C, P)) = identity(fullMorphisms(C, P))
    simp [fullInclusion, Functor.mk.map]
  refine ⟨functor, ?_⟩
  intros a aIn b bIn h hHom
  rw pO at aIn
  rw pO at bIn
  rw [fo, (identity.apply with aIn), (identity.apply with bIn)] at hHom
  have m := Morphism.hom with hHom
  have m2 := (tkIfull.hom_iff at C, P, a, b, h with category, objects, aIn, bIn).backward with m
  obtain ⟨hIn, _, _⟩ := hom.membership.forward with m2
  rw pM at hIn
  have typed := Morphism.of_hom with m2
  refine ⟨h, typed, ?_⟩
  rw [fm, (identity.apply with hIn)]

theorem fullInclusion.faithful
  shows Faithful(fullInclusion(C, P), fullSubcategory(C, P), C)
proof
  obtain ⟨pO, pM, pD, pC, pI, pK⟩ := tkIfull.projections at C, P with category, objects
  have functor := fullInclusion.functor at C, P with category, objects
  have fm : Functor.map(fullInclusion(C, P)) = identity(fullMorphisms(C, P))
    simp [fullInclusion, Functor.mk.map]
  refine ⟨functor, ?_⟩
  intros a aIn b bIn f fHom g gHom same
  have mf := Morphism.hom with fHom
  have mg := Morphism.hom with gHom
  obtain ⟨fIn, _, _⟩ := hom.membership.forward with mf
  obtain ⟨gIn, _, _⟩ := hom.membership.forward with mg
  rw pM at fIn
  rw pM at gIn
  rw [fm, (identity.apply with fIn), (identity.apply with gIn)] at same
  exact same

-- Isomorphic objects of the subcategory are isomorphic in C and
-- conversely (full subcategories reflect isomorphisms).
theorem fullSubcategory.isomorphic (a b : Set)
  requires first : a ∈ P
  requires second : b ∈ P
  shows Isomorphic(fullSubcategory(C, P), a, b) ↔ Isomorphic(C, a, b)
proof
  obtain ⟨pO, pM, pD, pC, pI, pK⟩ := tkIfull.projections at C, P with category, objects
  constructor
  . intro iso
    obtain ⟨f, fHom, g, inv⟩ := iso
    obtain ⟨fIn, gIn, dg, cg, gf, fg⟩ := inv
    have fHomC := (tkIfull.hom_iff at C, P, a, b, f with category, objects, first, second).forward with fHom
    rw pM at fIn
    rw pM at gIn
    rw [pD, pC] at dg
    rw [pD, pC] at cg
    rw [(tkIfull.dom at C, P, g with category, objects, gIn), (tkIfull.cod at C, P, f with category, objects, fIn)] at dg
    rw [(tkIfull.cod at C, P, g with category, objects, gIn), (tkIfull.dom at C, P, f with category, objects, fIn)] at cg
    have dg2 : dom(C)(f) = cod(C)(g)
      rw cg
    rw [pK, pI, pD] at gf
    rw [pK, pI, pC] at fg
    rw (tkIfull.comp at C, P, f, g with category, objects, fIn, gIn, dg) at gf
    rw (tkIfull.comp at C, P, g, f with category, objects, gIn, fIn, dg2) at fg
    rw (tkIfull.dom at C, P, f with category, objects, fIn) at gf
    rw (tkIfull.cod at C, P, f with category, objects, fIn) at fg
    obtain ⟨fM, fd, fc⟩ := fullMorphisms.membership.forward with fIn
    obtain ⟨gM, gd, gc⟩ := fullMorphisms.membership.forward with gIn
    rw (tkIfull.id at C, P, dom(C)(f) with category, objects, fd) at gf
    rw (tkIfull.id at C, P, cod(C)(f) with category, objects, fc) at fg
    refine ⟨f, fHomC, g, ?_⟩
    exact ⟨fM, gM, dg, cg, gf, fg⟩
  . intro iso
    obtain ⟨f, fHomC, g, inv⟩ := iso
    obtain ⟨fM, gM, dg, cg, gf, fg⟩ := inv
    have fHom := (tkIfull.hom_iff at C, P, a, b, f with category, objects, first, second).backward with fHomC
    obtain ⟨_, fd, fc⟩ := hom.membership.forward with fHomC
    have fdP : dom(C)(f) ∈ P
      rw fd
      exact first
    have fcP : cod(C)(f) ∈ P
      rw fc
      exact second
    have gdP : dom(C)(g) ∈ P
      rw dg
      exact fcP
    have gcP : cod(C)(g) ∈ P
      rw cg
      exact fdP
    have fIn := fullMorphisms.membership.backward with ⟨fM, fdP, fcP⟩
    have gIn := fullMorphisms.membership.backward with ⟨gM, gdP, gcP⟩
    have dg2 : dom(C)(f) = cod(C)(g)
      rw cg
    refine ⟨f, fHom, g, ?_⟩
    refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩
    . rw pM
      exact fIn
    . rw pM
      exact gIn
    . rw [pD, pC]
      rw [(tkIfull.dom at C, P, g with category, objects, gIn), (tkIfull.cod at C, P, f with category, objects, fIn)]
      exact dg
    . rw [pD, pC]
      rw [(tkIfull.cod at C, P, g with category, objects, gIn), (tkIfull.dom at C, P, f with category, objects, fIn)]
      exact cg
    . rw [pK, pI, pD]
      rw (tkIfull.comp at C, P, f, g with category, objects, fIn, gIn, dg)
      rw (tkIfull.dom at C, P, f with category, objects, fIn)
      rw (tkIfull.id at C, P, dom(C)(f) with category, objects, fdP)
      exact gf
    . rw [pK, pI, pC]
      rw (tkIfull.comp at C, P, g, f with category, objects, gIn, fIn, dg2)
      rw (tkIfull.cod at C, P, f with category, objects, fIn)
      rw (tkIfull.id at C, P, cod(C)(f) with category, objects, fcP)
      exact fg

end FullSubcategories

theorem fullCorestriction.functor (F C D P : Set)
  requires functor : F : C ⥤ D
  requires subset : P ⊆ Category.obj(D)
  requires lands : ∀ a ∈ Category.obj(C), Functor.obj(F)(a) ∈ P
  shows fullCorestriction(F, C, D, P) : C ⥤ fullSubcategory(D, P)
proof
  have source := Functor.source_category at F, C, D with functor
  have target := Functor.target_category at F, C, D with functor
  obtain ⟨pO, pM, pD, pC, pI, pK⟩ := tkIfull.projections at D, P with target, subset
  have cat := fullSubcategory.category at D, P with target, subset
  have oFn := Functor.object_function at F, C, D with functor
  have mFn := Functor.morphism_function at F, C, D with functor
  have mapIn : ∀ f ∈ mor(C), Functor.map(F)(f) ∈ fullMorphisms(D, P)
    intros f fIn
    have fHom := hom.of_morphism with fIn
    have dO := Category.dom_closed with source, fIn
    have cO := Category.cod_closed with source, fIn
    have typed := Morphism.of_hom with fHom
    have image := Functor.hom at F, C, D, dom(C)(f), cod(C)(f), f with functor, fHom
    obtain ⟨mM, md, mc⟩ := hom.membership.forward with image
    have dP := lands with dom(C)(f), dO
    have cP := lands with cod(C)(f), cO
    apply fullMorphisms.membership.backward
    rw [md, mc]
    exact ⟨mM, dP, cP⟩
  unfold fullCorestriction
  apply Functor.intro with source, cat
  . rw pO
    apply FunctionBetween.codomain_of_values with oFn
    exact lands
  . rw pM
    apply FunctionBetween.codomain_of_values with mFn
    exact mapIn
  . intros a aIn b bIn f fHom
    have m := Morphism.hom with fHom
    have image := Functor.hom at F, C, D, a, b, f with functor, m
    have aP := lands with a, aIn
    have bP := lands with b, bIn
    have m2 := (tkIfull.hom_iff at D, P, Functor.obj(F)(a), Functor.obj(F)(b), Functor.map(F)(f) with target, subset, aP, bP).backward with image
    exact Morphism.of_hom with m2
  . intros a aIn
    have aP := lands with a, aIn
    have law := Functor.map_id at F, C, D, a with functor, aIn
    rw [pI, (tkIfull.id at D, P, Functor.obj(F)(a) with target, subset, aP)]
    exact law
  . intros a aIn b bIn c cIn f fHom g gHom
    have law := Functor.map_comp at F, C, D, a, b, c, f, g with functor, aIn, bIn, cIn, fHom, gHom
    have mf := Morphism.hom with fHom
    have mg := Morphism.hom with gHom
    have imf := Functor.hom at F, C, D, a, b, f with functor, mf
    have img := Functor.hom at F, C, D, b, c, g with functor, mg
    have comp := hom.composable with img, imf
    obtain ⟨fM, _, _⟩ := hom.membership.forward with mf
    obtain ⟨gM, _, _⟩ := hom.membership.forward with mg
    have fIn := mapIn with f, fM
    have gIn := mapIn with g, gM
    rw pK
    rw (tkIfull.comp at D, P, Functor.map(F)(f), Functor.map(F)(g) with target, subset, fIn, gIn, comp)
    exact law
  . rfl
  . rfl

-- Section: Over- and under-categories
-- Over X: objects (a, f) with f : a ⟶ X; a morphism (a, f) ⟶ (b, g) is
-- ((p, q), h) with h : a ⟶ b and g ∘ h = f (CategoryTheory.Over).
def overObjects (C X : Set) : Set :=
  { p ∈ Category.obj(C) × mor(C) | ∃ a ∈ Category.obj(C), ∃ f ∈ hom(C, a, X), p = (a, f) }

def overMorphisms (C X : Set) : Set :=
  { m ∈ (overObjects(C, X) × overObjects(C, X)) × mor(C) |
    ∃ p ∈ overObjects(C, X), ∃ q ∈ overObjects(C, X),
      ∃ h ∈ hom(C, fst(p), fst(q)),
        m = ((p, q), h) ∧ call2(Category.comp(C), snd(q), h) = snd(p) }

-- Identity and composition on morphisms ((p, q), h) whose last entry is a
-- morphism of C: shared by over- and under-categories.
def innerId (C O : Set) : Set :=
  { (p, ((p, p), Category.id(C)(fst(p)))) | p ∈ O }

def innerComp (C M : Set) : Set :=
  { (r, ((fst(fst(snd(r))), snd(fst(fst(r)))),
      call2(Category.comp(C), snd(fst(r)), snd(snd(r))))) |
    r ∈ composablePairsOf(M, concreteDom(M), concreteCod(M)) }

def overCategory (C X : Set) : Set :=
  Category.mk(overObjects(C, X), overMorphisms(C, X),
    concreteDom(overMorphisms(C, X)), concreteCod(overMorphisms(C, X)),
    innerId(C, overObjects(C, X)), innerComp(C, overMorphisms(C, X)))

-- Under X: objects (a, f) with f : X ⟶ a, morphisms h with h ∘ f = g
-- (CategoryTheory.Under).
def underObjects (C X : Set) : Set :=
  { p ∈ Category.obj(C) × mor(C) | ∃ a ∈ Category.obj(C), ∃ f ∈ hom(C, X, a), p = (a, f) }

def underMorphisms (C X : Set) : Set :=
  { m ∈ (underObjects(C, X) × underObjects(C, X)) × mor(C) |
    ∃ p ∈ underObjects(C, X), ∃ q ∈ underObjects(C, X),
      ∃ h ∈ hom(C, fst(p), fst(q)),
        m = ((p, q), h) ∧ call2(Category.comp(C), h, snd(p)) = snd(q) }

def underCategory (C X : Set) : Set :=
  Category.mk(underObjects(C, X), underMorphisms(C, X),
    concreteDom(underMorphisms(C, X)), concreteCod(underMorphisms(C, X)),
    innerId(C, underObjects(C, X)), innerComp(C, underMorphisms(C, X)))

-- Over.forget: (a, f) ↦ a, ((p, q), h) ↦ h; Under.forget likewise.
def firstEntries (O : Set) : Set := { (p, fst(p)) | p ∈ O }

def lastEntries (M : Set) : Set := { (m, snd(m)) | m ∈ M }

def overForget (C X : Set) : Set :=
  Functor.mk(firstEntries(overObjects(C, X)), lastEntries(overMorphisms(C, X)),
    overCategory(C, X), C)

-- Over.map along g : X ⟶ Y: (a, f) ↦ (a, g ∘ f).
def overPushObject (C g p : Set) : Set := (fst(p), call2(Category.comp(C), g, snd(p)))

def overMapObjects (C X g : Set) : Set :=
  { (p, overPushObject(C, g, p)) | p ∈ overObjects(C, X) }

def overMapMorphisms (C X g : Set) : Set :=
  { (m, ((overPushObject(C, g, fst(fst(m))), overPushObject(C, g, snd(fst(m)))),
      snd(m))) | m ∈ overMorphisms(C, X) }

def overMap (C X Y g : Set) : Set :=
  Functor.mk(overMapObjects(C, X, g), overMapMorphisms(C, X, g),
    overCategory(C, X), overCategory(C, Y))

theorem tkIinnerId.apply (C O p : Set)
  requires member : p ∈ O
  shows innerId(C, O)(p) = ((p, p), Category.id(C)(fst(p)))
proof
  have pairs : ∀ t ∈ innerId(C, O), ∃ x, ∃ y, (x, y) = t
    intros t ht
    obtain ⟨n, nIn, shape⟩ := innerId.membership.forward with ht
    exact ⟨n, ((n, n), Category.id(C)(fst(n))), shape⟩
  have functional : Functional(innerId(C, O))
    intros x y hxy z hxz
    obtain ⟨n1, n1In, e1⟩ := innerId.membership.forward with hxy
    obtain ⟨n2, n2In, e2⟩ := innerId.membership.forward with hxz
    obtain ⟨x1, y1⟩ := orderedPair.injective with e1
    obtain ⟨x2, z2⟩ := orderedPair.injective with e2
    cc
  have mem : (p, ((p, p), Category.id(C)(fst(p)))) ∈ innerId(C, O) :=
    innerId.membership.backward with ⟨p, member, rfl⟩
  exact tkIfun.apply with pairs, functional, mem

theorem tkIinnerComp.graph (C M : Set)
  shows (∀ p ∈ innerComp(C, M), ∃ x, ∃ y, (x, y) = p) ∧ Functional(innerComp(C, M))
proof
  constructor
  . intros p hp
    obtain ⟨n, nIn, shape⟩ := innerComp.membership.forward with hp
    refine ⟨n, snd(p), ?_⟩
    rw ← shape
    rw snd.pair
  . intros x y hxy z hxz
    obtain ⟨n1, n1In, e1⟩ := innerComp.membership.forward with hxy
    obtain ⟨n2, n2In, e2⟩ := innerComp.membership.forward with hxz
    obtain ⟨x1, y1⟩ := orderedPair.injective with e1
    obtain ⟨x2, z2⟩ := orderedPair.injective with e2
    cc

theorem tkIinnerComp.apply (C M p q r h k : Set)
  requires first : ((p, q), h) ∈ M
  requires second : ((q, r), k) ∈ M
  shows innerComp(C, M)(((q, r), k), ((p, q), h)) =
    ((p, r), call2(Category.comp(C), k, h))
proof
  obtain ⟨pairs, functional⟩ := tkIinnerComp.graph at C, M
  have comp : fst(fst(((q, r), k))) = snd(fst(((p, q), h)))
    rw [fst.pair, fst.pair, fst.pair, snd.pair]
  have qIn := (tkIcomposable.iff at M, ((q, r), k), ((p, q), h)).backward with
    ⟨second, first, comp⟩
  have mem : ((((q, r), k), ((p, q), h)),
      ((p, r), call2(Category.comp(C), k, h))) ∈ innerComp(C, M)
    apply innerComp.membership.backward
    refine ⟨(((q, r), k), ((p, q), h)), qIn, ?_⟩
    simp [fst.pair, snd.pair]
  have v := tkIfun.apply with pairs, functional, mem
  unfold call2 at v
  unfold call2
  exact v

theorem tkIinner.category (C O M : Set)
  requires category : Category(C)
  requires shape : ∀ m ∈ M, ∃ p ∈ O, ∃ q ∈ O, ∃ h ∈ hom(C, fst(p), fst(q)),
    m = ((p, q), h)
  requires ids : ∀ p ∈ O, ((p, p), Category.id(C)(fst(p))) ∈ M
  requires closed : ∀ p, ∀ q, ∀ r, ∀ h, ∀ k, ((p, q), h) ∈ M → ((q, r), k) ∈ M →
    ((p, r), call2(Category.comp(C), k, h)) ∈ M
  shows Category(Category.mk(O, M, concreteDom(M), concreteCod(M), innerId(C, O),
    innerComp(C, M)))
proof
  have shape2 : ∀ m ∈ M, ∃ a ∈ O, ∃ b ∈ O, ∃ x, m = ((a, b), x)
    intros m mIn
    obtain ⟨p, pIn, q, qIn, h, hHom, e⟩ := shape with m, mIn
    exact ⟨p, pIn, q, qIn, h, e⟩
  obtain ⟨pairs, functional⟩ := tkIinnerComp.graph at C, M
  have idFn : innerId(C, O) : O → M
    apply tkIfun.between
    . intros t ht
      obtain ⟨p, pIn, e⟩ := innerId.membership.forward with ht
      have idIn := ids with p, pIn
      exact ⟨p, pIn, ((p, p), Category.id(C)(fst(p))), idIn, e⟩
    . intros x y hxy z hxz
      obtain ⟨n1, n1In, e1⟩ := innerId.membership.forward with hxy
      obtain ⟨n2, n2In, e2⟩ := innerId.membership.forward with hxz
      obtain ⟨x1, y1⟩ := orderedPair.injective with e1
      obtain ⟨x2, z2⟩ := orderedPair.injective with e2
      cc
    . intros p pIn
      have idIn := ids with p, pIn
      have mem : (p, ((p, p), Category.id(C)(fst(p)))) ∈ innerId(C, O) :=
        innerId.membership.backward with ⟨p, pIn, rfl⟩
      exact ⟨((p, p), Category.id(C)(fst(p))), idIn, mem⟩
  have pairShape : ∀ t ∈ composablePairsOf(M, concreteDom(M), concreteCod(M)),
      ∃ p, ∃ q, ∃ r, ∃ h, ∃ k, t = (((q, r), k), ((p, q), h)) ∧
        ((p, q), h) ∈ M ∧ ((q, r), k) ∈ M
    intros t tIn
    obtain ⟨_, G, GIn, F, FIn, tShape, compo⟩ :=
      composablePairsOf.membership.forward with tIn
    have dG := tkIconcreteDom.apply with GIn
    have cF := tkIconcreteCod.apply with FIn
    obtain ⟨q2, q2In, r, rIn, k, kHom, gE⟩ := shape with G, GIn
    obtain ⟨p, pIn, q, qIn, h, hHom, fE⟩ := shape with F, FIn
    rw [dG, cF] at compo
    rw [gE, fE, fst.pair, fst.pair, fst.pair, snd.pair] at compo
    rw compo at gE
    rw gE at GIn
    rw fE at FIn
    refine ⟨p, q, r, h, k, ?_, FIn, GIn⟩
    rw [tShape, gE, fE]
  have compFn : innerComp(C, M) : composablePairsOf(M, concreteDom(M), concreteCod(M)) → M
    apply tkIfun.between
    . intros t ht
      obtain ⟨u, uIn, e⟩ := innerComp.membership.forward with ht
      obtain ⟨p, q, r, h, k, uE, FIn, GIn⟩ := pairShape with u, uIn
      have closedIn := closed with p, q, r, h, k, FIn, GIn
      rw uE at e
      rw uE at uIn
      simp [fst.pair, snd.pair] at e
      exact ⟨(((q, r), k), ((p, q), h)), uIn,
        ((p, r), call2(Category.comp(C), k, h)), closedIn, e⟩
    . exact functional
    . intros u uIn
      obtain ⟨p, q, r, h, k, uE, FIn, GIn⟩ := pairShape with u, uIn
      have closedIn := closed with p, q, r, h, k, FIn, GIn
      have mem : (u, ((p, r), call2(Category.comp(C), k, h))) ∈ innerComp(C, M)
        apply innerComp.membership.backward
        refine ⟨u, uIn, ?_⟩
        rw uE
        simp [fst.pair, snd.pair]
      exact ⟨((p, r), call2(Category.comp(C), k, h)), closedIn, mem⟩
  have idShape : ∀ p ∈ O, fst(innerId(C, O)(p)) = (p, p)
    intros p pIn
    rw (tkIinnerId.apply at C, O, p with pIn)
    rw fst.pair
  have compShape : ∀ g ∈ M, ∀ f ∈ M, fst(fst(g)) = snd(fst(f)) →
      fst(innerComp(C, M)(g, f)) = (fst(fst(f)), snd(fst(g)))
    intros g gIn f fIn comp
    obtain ⟨q2, q2In, r, rIn, k, kHom, gE⟩ := shape with g, gIn
    obtain ⟨p, pIn, q, qIn, h, hHom, fE⟩ := shape with f, fIn
    rw [gE, fE, fst.pair, fst.pair, fst.pair, snd.pair] at comp
    rw comp at gE
    rw gE at gIn
    rw fE at fIn
    rw [gE, fE]
    rw (tkIinnerComp.apply at C, M, p, q, r, h, k with fIn, gIn)
    simp [fst.pair, snd.pair]
  have units : ∀ f ∈ M, innerComp(C, M)(innerId(C, O)(snd(fst(f))), f) = f ∧
      innerComp(C, M)(f, innerId(C, O)(fst(fst(f)))) = f
    intros f fIn
    obtain ⟨p, pIn, q, qIn, h, hHom, fE⟩ := shape with f, fIn
    rw fE at fIn
    rw fE
    simp [fst.pair, snd.pair]
    rw (tkIinnerId.apply at C, O, p with pIn)
    rw (tkIinnerId.apply at C, O, q with qIn)
    have idP := ids with p, pIn
    have idQ := ids with q, qIn
    rw (tkIinnerComp.apply at C, M, p, q, q, h, Category.id(C)(fst(q)) with fIn, idQ)
    rw (tkIinnerComp.apply at C, M, p, p, q, Category.id(C)(fst(p)), h with idP, fIn)
    rw [(Category.id_left_hom with category, hHom), (Category.id_right_hom with category, hHom)]
    refine ⟨rfl, rfl⟩
  have assoc : ∀ l ∈ M, ∀ g ∈ M, ∀ f ∈ M, fst(fst(l)) = snd(fst(g)) →
      fst(fst(g)) = snd(fst(f)) → innerComp(C, M)(innerComp(C, M)(l, g), f) =
        innerComp(C, M)(l, innerComp(C, M)(g, f))
    intros l lIn g gIn f fIn lg gf
    obtain ⟨r2, r2In, s, sIn, l1, lHom, lE⟩ := shape with l, lIn
    obtain ⟨q2, q2In, r, rIn, k, kHom, gE⟩ := shape with g, gIn
    obtain ⟨p, pIn, q, qIn, h, hHom, fE⟩ := shape with f, fIn
    rw [lE, gE, fst.pair, fst.pair, fst.pair, snd.pair] at lg
    rw [gE, fE, fst.pair, fst.pair, fst.pair, snd.pair] at gf
    rw lg at lE
    rw lg at lHom
    rw gf at gE
    rw gf at kHom
    rw lE at lIn
    rw gE at gIn
    rw fE at fIn
    rw [lE, gE, fE]
    have lkIn := closed with q, r, s, k, l1, gIn, lIn
    have khIn := closed with p, q, r, h, k, fIn, gIn
    rw (tkIinnerComp.apply at C, M, q, r, s, k, l1 with gIn, lIn)
    rw (tkIinnerComp.apply at C, M, p, q, r, h, k with fIn, gIn)
    rw (tkIinnerComp.apply at C, M, p, q, s, h, call2(Category.comp(C), l1, k) with fIn, lkIn)
    rw (tkIinnerComp.apply at C, M, p, r, s, call2(Category.comp(C), k, h), l1 with khIn, lIn)
    rw (Category.assoc_hom with category, lHom, kHom, hHom)
  exact tkItagged.category with shape2, idFn, idShape, compFn, compShape, units, assoc

theorem tkIentries.apply (O M p m : Set)
  shows (p ∈ O → firstEntries(O)(p) = fst(p)) ∧ (m ∈ M → lastEntries(M)(m) = snd(m))
proof
  constructor
  . intro member
    have pairs : ∀ t ∈ firstEntries(O), ∃ x, ∃ y, (x, y) = t
      intros t ht
      obtain ⟨n, nIn, shape⟩ := firstEntries.membership.forward with ht
      exact ⟨n, fst(n), shape⟩
    have functional : Functional(firstEntries(O))
      intros x y hxy z hxz
      obtain ⟨n1, n1In, e1⟩ := firstEntries.membership.forward with hxy
      obtain ⟨n2, n2In, e2⟩ := firstEntries.membership.forward with hxz
      obtain ⟨x1, y1⟩ := orderedPair.injective with e1
      obtain ⟨x2, z2⟩ := orderedPair.injective with e2
      cc
    have mem : (p, fst(p)) ∈ firstEntries(O) :=
      firstEntries.membership.backward with ⟨p, member, rfl⟩
    exact tkIfun.apply with pairs, functional, mem
  . intro member
    have pairs : ∀ t ∈ lastEntries(M), ∃ x, ∃ y, (x, y) = t
      intros t ht
      obtain ⟨n, nIn, shape⟩ := lastEntries.membership.forward with ht
      exact ⟨n, snd(n), shape⟩
    have functional : Functional(lastEntries(M))
      intros x y hxy z hxz
      obtain ⟨n1, n1In, e1⟩ := lastEntries.membership.forward with hxy
      obtain ⟨n2, n2In, e2⟩ := lastEntries.membership.forward with hxz
      obtain ⟨x1, y1⟩ := orderedPair.injective with e1
      obtain ⟨x2, z2⟩ := orderedPair.injective with e2
      cc
    have mem : (m, snd(m)) ∈ lastEntries(M) :=
      lastEntries.membership.backward with ⟨m, member, rfl⟩
    exact tkIfun.apply with pairs, functional, mem

theorem tkIinner.hom_iff (C O M p q m : Set)
  requires shape : ∀ m ∈ M, ∃ p ∈ O, ∃ q ∈ O, ∃ h ∈ hom(C, fst(p), fst(q)),
    m = ((p, q), h)
  shows m ∈ hom(Category.mk(O, M, concreteDom(M), concreteCod(M), innerId(C, O),
      innerComp(C, M)), p, q) ↔ (m ∈ M ∧ fst(m) = (p, q))
proof
  constructor
  . intro member
    obtain ⟨mIn, d, c⟩ := hom.membership.forward with member
    simp [Category.mk.mor] at mIn
    simp [Category.mk.dom] at d
    simp [Category.mk.cod] at c
    rw (tkIconcreteDom.apply with mIn) at d
    rw (tkIconcreteCod.apply with mIn) at c
    obtain ⟨p1, p1In, q1, q1In, h, hHom, e⟩ := shape with m, mIn
    rw e at d
    rw e at c
    rw [fst.pair, fst.pair] at d
    rw [fst.pair, snd.pair] at c
    refine ⟨mIn, ?_⟩
    rw [e, fst.pair, d, c]
  . intro h
    obtain ⟨mIn, e⟩ := h
    apply hom.membership.backward
    simp [Category.mk.mor, Category.mk.dom, Category.mk.cod]
    rw [(tkIconcreteDom.apply with mIn), (tkIconcreteCod.apply with mIn), e, fst.pair, snd.pair]
    exact ⟨mIn, rfl, rfl⟩

theorem tkIinner.forget (C O M : Set)
  requires category : Category(C)
  requires shape : ∀ m ∈ M, ∃ p ∈ O, ∃ q ∈ O, ∃ h ∈ hom(C, fst(p), fst(q)),
    m = ((p, q), h)
  requires ids : ∀ p ∈ O, ((p, p), Category.id(C)(fst(p))) ∈ M
  requires closed : ∀ p, ∀ q, ∀ r, ∀ h, ∀ k, ((p, q), h) ∈ M → ((q, r), k) ∈ M →
    ((p, r), call2(Category.comp(C), k, h)) ∈ M
  requires objs : ∀ p ∈ O, fst(p) ∈ Category.obj(C)
  shows Faithful(Functor.mk(firstEntries(O), lastEntries(M), Category.mk(O, M,
      concreteDom(M), concreteCod(M), innerId(C, O), innerComp(C, M)), C),
    Category.mk(O, M, concreteDom(M), concreteCod(M), innerId(C, O), innerComp(C, M)), C)
proof
  have cat := tkIinner.category with category, shape, ids, closed
  have pO : Category.obj(Category.mk(O, M, concreteDom(M), concreteCod(M), innerId(C, O),
      innerComp(C, M))) = O
    simp [Category.mk.obj]
  have pM : mor(Category.mk(O, M, concreteDom(M), concreteCod(M), innerId(C, O),
      innerComp(C, M))) = M
    simp [Category.mk.mor]
  have pI : Category.id(Category.mk(O, M, concreteDom(M), concreteCod(M), innerId(C, O),
      innerComp(C, M))) = innerId(C, O)
    simp [Category.mk.id]
  have pK : Category.comp(Category.mk(O, M, concreteDom(M), concreteCod(M), innerId(C, O),
      innerComp(C, M))) = innerComp(C, M)
    simp [Category.mk.comp]
  have mapIn : ∀ m ∈ M, snd(m) ∈ mor(C)
    intros m mIn
    obtain ⟨p, pIn, q, qIn, h, hHom, e⟩ := shape with m, mIn
    rw [e, snd.pair]
    exact hom.in_morphisms with hHom
  have oFn : firstEntries(O) : O → Category.obj(C)
    apply tkIfun.between
    . intros t ht
      obtain ⟨p, pIn, e⟩ := firstEntries.membership.forward with ht
      have o := objs with p, pIn
      exact ⟨p, pIn, fst(p), o, e⟩
    . intros x y hxy z hxz
      obtain ⟨n1, n1In, e1⟩ := firstEntries.membership.forward with hxy
      obtain ⟨n2, n2In, e2⟩ := firstEntries.membership.forward with hxz
      obtain ⟨x1, y1⟩ := orderedPair.injective with e1
      obtain ⟨x2, z2⟩ := orderedPair.injective with e2
      cc
    . intros p pIn
      have o := objs with p, pIn
      have mem : (p, fst(p)) ∈ firstEntries(O) :=
        firstEntries.membership.backward with ⟨p, pIn, rfl⟩
      exact ⟨fst(p), o, mem⟩
  have mFn : lastEntries(M) : M → mor(C)
    apply tkIfun.between
    . intros t ht
      obtain ⟨m, mIn, e⟩ := lastEntries.membership.forward with ht
      have o := mapIn with m, mIn
      exact ⟨m, mIn, snd(m), o, e⟩
    . intros x y hxy z hxz
      obtain ⟨n1, n1In, e1⟩ := lastEntries.membership.forward with hxy
      obtain ⟨n2, n2In, e2⟩ := lastEntries.membership.forward with hxz
      obtain ⟨x1, y1⟩ := orderedPair.injective with e1
      obtain ⟨x2, z2⟩ := orderedPair.injective with e2
      cc
    . intros m mIn
      have o := mapIn with m, mIn
      have mem : (m, snd(m)) ∈ lastEntries(M) :=
        lastEntries.membership.backward with ⟨m, mIn, rfl⟩
      exact ⟨snd(m), o, mem⟩
  have homs : ∀ p, ∀ q, ∀ m, m ∈ hom(Category.mk(O, M, concreteDom(M), concreteCod(M),
      innerId(C, O), innerComp(C, M)), p, q) →
      m ∈ M ∧ m = ((p, q), snd(m)) ∧ snd(m) ∈ hom(C, fst(p), fst(q))
    intros p q m member
    obtain ⟨mIn, e⟩ := (tkIinner.hom_iff at C, O, M, p, q, m with shape).forward with member
    obtain ⟨p1, p1In, q1, q1In, h, hHom, mE⟩ := shape with m, mIn
    rw [mE, fst.pair] at e
    obtain ⟨pp, qq⟩ := orderedPair.injective with e
    rw [← pp, ← qq]
    rw [mE, snd.pair]
    rw mE at mIn
    exact ⟨mIn, rfl, hHom⟩
  have functor : Functor(Functor.mk(firstEntries(O), lastEntries(M), Category.mk(O, M,
      concreteDom(M), concreteCod(M), innerId(C, O), innerComp(C, M)), C),
      Category.mk(O, M, concreteDom(M), concreteCod(M), innerId(C, O), innerComp(C, M)), C)
    apply Functor.intro with cat, category
    . rw pO
      exact oFn
    . rw pM
      exact mFn
    . intros a aIn b bIn f fHom
      rw pO at aIn
      rw pO at bIn
      have m := Morphism.hom with fHom
      obtain ⟨fIn, _, sHom⟩ := homs with a, b, f, m
      obtain ⟨fa, _⟩ := tkIentries.apply at O, M, a, f
      obtain ⟨fb, lf⟩ := tkIentries.apply at O, M, b, f
      rw [(fa with aIn), (fb with bIn), (lf with fIn)]
      exact Morphism.of_hom with sHom
    . intros a aIn
      rw pO at aIn
      have idIn := ids with a, aIn
      obtain ⟨fa, li⟩ := tkIentries.apply at O, M, a, ((a, a), Category.id(C)(fst(a)))
      rw [pI, (tkIinnerId.apply at C, O, a with aIn), (li with idIn), (fa with aIn), snd.pair]
    . intros a aIn b bIn c cIn f fHom g gHom
      rw pO at aIn
      rw pO at bIn
      rw pO at cIn
      have mf := Morphism.hom with fHom
      have mg := Morphism.hom with gHom
      obtain ⟨fIn, fE, fsHom⟩ := homs with a, b, f, mf
      obtain ⟨gIn, gE, gsHom⟩ := homs with b, c, g, mg
      rw fE at fIn
      rw gE at gIn
      have gfIn := closed with a, b, c, snd(f), snd(g), fIn, gIn
      obtain ⟨_, lf⟩ := tkIentries.apply at O, M, a, ((a, b), snd(f))
      obtain ⟨_, lg⟩ := tkIentries.apply at O, M, a, ((b, c), snd(g))
      obtain ⟨_, lgf⟩ := tkIentries.apply at O, M, a, ((a, c), call2(Category.comp(C), snd(g), snd(f)))
      rw [pK, fE, gE]
      rw (tkIinnerComp.apply at C, M, a, b, c, snd(f), snd(g) with fIn, gIn)
      rw [(lgf with gfIn), (lf with fIn), (lg with gIn), snd.pair, snd.pair, snd.pair]
    . rfl
    . rfl
  refine ⟨functor, ?_⟩
  intros a aIn b bIn f fHom g gHom same
  rw pO at aIn
  rw pO at bIn
  have mf := Morphism.hom with fHom
  have mg := Morphism.hom with gHom
  obtain ⟨fIn, fE, _⟩ := homs with a, b, f, mf
  obtain ⟨gIn, gE, _⟩ := homs with a, b, g, mg
  obtain ⟨_, lf⟩ := tkIentries.apply at O, M, a, f
  obtain ⟨_, lg⟩ := tkIentries.apply at O, M, a, g
  simp [Functor.mk.map] at same
  rw [(lf with fIn), (lg with gIn)] at same
  rw [fE, gE, same]

def underForget (C X : Set) : Set :=
  Functor.mk(firstEntries(underObjects(C, X)), lastEntries(underMorphisms(C, X)),
    underCategory(C, X), C)

section OverLaws
variable (C X : Set)
hypothesis category : Category(C)
hypothesis object : X ∈ Category.obj(C)

theorem tkIover.member (m : Set)
  shows m ∈ overMorphisms(C, X) ↔ (m ∈ (overObjects(C, X) × overObjects(C, X)) × mor(C) ∧
    ∃ p ∈ overObjects(C, X), ∃ q ∈ overObjects(C, X), ∃ h ∈ hom(C, fst(p), fst(q)),
      m = ((p, q), h) ∧ call2(Category.comp(C), snd(q), h) = snd(p))
proof
  constructor
  . intro h
    exact overMorphisms.membership.forward with h
  . intro h
    exact overMorphisms.membership.backward with h

theorem tkIover.object (p : Set)
  requires member : p ∈ overObjects(C, X)
  shows ∃ a ∈ Category.obj(C), ∃ f ∈ hom(C, a, X), p = (a, f)
proof
  obtain ⟨_, rest⟩ := overObjects.membership.forward with member
  exact rest

theorem tkIover.laws
  shows (∀ m ∈ overMorphisms(C, X), ∃ p ∈ overObjects(C, X), ∃ q ∈ overObjects(C, X),
      ∃ h ∈ hom(C, fst(p), fst(q)), m = ((p, q), h)) ∧
    (∀ p ∈ overObjects(C, X), ((p, p), Category.id(C)(fst(p))) ∈ overMorphisms(C, X)) ∧
    (∀ p, ∀ q, ∀ r, ∀ h, ∀ k, ((p, q), h) ∈ overMorphisms(C, X) →
      ((q, r), k) ∈ overMorphisms(C, X) →
      ((p, r), call2(Category.comp(C), k, h)) ∈ overMorphisms(C, X))
proof
  refine ⟨?_, ?_, ?_⟩
  . intros m mIn
    obtain ⟨_, p, pIn, q, qIn, h, hHom, e, _⟩ := overMorphisms.membership.forward with mIn
    exact ⟨p, pIn, q, qIn, h, hHom, e⟩
  . intros p pIn
    obtain ⟨a, aIn, f, fHom, pE⟩ := tkIover.object at C, X, p with category, object, pIn
    have idHom := hom.id with category, aIn
    have fstP : fst(p) = a
      rw pE
      rw fst.pair
    have sndP : snd(p) = f
      rw pE
      rw snd.pair
    have idHom2 : Category.id(C)(fst(p)) ∈ hom(C, fst(p), fst(p))
      rw fstP
      exact idHom
    have law := Category.id_right_hom with category, fHom
    have idM := hom.in_morphisms with idHom2
    have bound := product.pair with pIn, pIn
    have bound2 := product.pair with bound, idM
    apply overMorphisms.membership.backward
    refine ⟨bound2, p, pIn, p, pIn, Category.id(C)(fst(p)), idHom2, rfl, ?_⟩
    rw [sndP, fstP]
    exact law
  . intros p q r h k first second
    obtain ⟨_, p1, p1In, q1, q1In, h1, h1Hom, e1, w1⟩ :=
      overMorphisms.membership.forward with first
    obtain ⟨_, q2, q2In, r2, r2In, k2, k2Hom, e2, w2⟩ :=
      overMorphisms.membership.forward with second
    obtain ⟨pq, hh⟩ := orderedPair.injective with e1
    obtain ⟨pp, qq⟩ := orderedPair.injective with pq
    obtain ⟨qr, kk⟩ := orderedPair.injective with e2
    obtain ⟨qq2, rr⟩ := orderedPair.injective with qr
    rw [← pp, ← qq, ← hh] at w1
    rw [← pp, ← qq, ← hh] at h1Hom
    rw [← qq2, ← rr, ← kk] at w2
    rw [← qq2, ← rr, ← kk] at k2Hom
    rw ← pp at p1In
    rw ← rr at r2In
    have khHom := hom.comp with category, k2Hom, h1Hom
    have khM := hom.in_morphisms with khHom
    obtain ⟨a, aIn, f, fHom, rE⟩ := tkIover.object at C, X, r with category, object, r2In
    have sndR : snd(r) ∈ hom(C, fst(r), X)
      rw rE
      rw [fst.pair, snd.pair]
      exact fHom
    have assocLaw := Category.assoc_hom with category, sndR, k2Hom, h1Hom
    have bound := product.pair with p1In, r2In
    have bound2 := product.pair with bound, khM
    apply overMorphisms.membership.backward
    refine ⟨bound2, p, p1In, r, r2In, call2(Category.comp(C), k, h), khHom, rfl, ?_⟩
    rw ← assocLaw
    rw [w2, w1]

theorem overCategory.category
  shows Category(overCategory(C, X))
proof
  obtain ⟨shape, ids, closed⟩ := tkIover.laws at C, X with category, object
  unfold overCategory
  exact tkIinner.category with category, shape, ids, closed

theorem tkIunder.object (p : Set)
  requires member : p ∈ underObjects(C, X)
  shows ∃ a ∈ Category.obj(C), ∃ f ∈ hom(C, X, a), p = (a, f)
proof
  obtain ⟨_, rest⟩ := underObjects.membership.forward with member
  exact rest

theorem tkIunder.laws
  shows (∀ m ∈ underMorphisms(C, X), ∃ p ∈ underObjects(C, X), ∃ q ∈ underObjects(C, X),
      ∃ h ∈ hom(C, fst(p), fst(q)), m = ((p, q), h)) ∧
    (∀ p ∈ underObjects(C, X), ((p, p), Category.id(C)(fst(p))) ∈ underMorphisms(C, X)) ∧
    (∀ p, ∀ q, ∀ r, ∀ h, ∀ k, ((p, q), h) ∈ underMorphisms(C, X) →
      ((q, r), k) ∈ underMorphisms(C, X) →
      ((p, r), call2(Category.comp(C), k, h)) ∈ underMorphisms(C, X))
proof
  refine ⟨?_, ?_, ?_⟩
  . intros m mIn
    obtain ⟨_, p, pIn, q, qIn, h, hHom, e, _⟩ := underMorphisms.membership.forward with mIn
    exact ⟨p, pIn, q, qIn, h, hHom, e⟩
  . intros p pIn
    obtain ⟨a, aIn, f, fHom, pE⟩ := tkIunder.object at C, X, p with category, object, pIn
    have idHom := hom.id with category, aIn
    have fstP : fst(p) = a
      rw pE
      rw fst.pair
    have sndP : snd(p) = f
      rw pE
      rw snd.pair
    have idHom2 : Category.id(C)(fst(p)) ∈ hom(C, fst(p), fst(p))
      rw fstP
      exact idHom
    have law := Category.id_left_hom with category, fHom
    have idM := hom.in_morphisms with idHom2
    have bound := product.pair with pIn, pIn
    have bound2 := product.pair with bound, idM
    apply underMorphisms.membership.backward
    refine ⟨bound2, p, pIn, p, pIn, Category.id(C)(fst(p)), idHom2, rfl, ?_⟩
    rw [sndP, fstP]
    exact law
  . intros p q r h k first second
    obtain ⟨_, p1, p1In, q1, q1In, h1, h1Hom, e1, w1⟩ :=
      underMorphisms.membership.forward with first
    obtain ⟨_, q2, q2In, r2, r2In, k2, k2Hom, e2, w2⟩ :=
      underMorphisms.membership.forward with second
    obtain ⟨pq, hh⟩ := orderedPair.injective with e1
    obtain ⟨pp, qq⟩ := orderedPair.injective with pq
    obtain ⟨qr, kk⟩ := orderedPair.injective with e2
    obtain ⟨qq2, rr⟩ := orderedPair.injective with qr
    rw [← pp, ← qq, ← hh] at w1
    rw [← pp, ← qq, ← hh] at h1Hom
    rw [← qq2, ← rr, ← kk] at w2
    rw [← qq2, ← rr, ← kk] at k2Hom
    rw ← pp at p1In
    rw ← rr at r2In
    have khHom := hom.comp with category, k2Hom, h1Hom
    have khM := hom.in_morphisms with khHom
    obtain ⟨a, aIn, f, fHom, pE⟩ := tkIunder.object at C, X, p with category, object, p1In
    have sndP : snd(p) ∈ hom(C, X, fst(p))
      rw pE
      rw [fst.pair, snd.pair]
      exact fHom
    have assocLaw := Category.assoc_hom with category, k2Hom, h1Hom, sndP
    have bound := product.pair with p1In, r2In
    have bound2 := product.pair with bound, khM
    apply underMorphisms.membership.backward
    refine ⟨bound2, p, p1In, r, r2In, call2(Category.comp(C), k, h), khHom, rfl, ?_⟩
    rw assocLaw
    rw [w1, w2]

theorem tkIover.projections
  shows Category.obj(overCategory(C, X)) = overObjects(C, X) ∧
    mor(overCategory(C, X)) = overMorphisms(C, X) ∧
    dom(overCategory(C, X)) = concreteDom(overMorphisms(C, X)) ∧
    cod(overCategory(C, X)) = concreteCod(overMorphisms(C, X)) ∧
    Category.id(overCategory(C, X)) = innerId(C, overObjects(C, X)) ∧
    Category.comp(overCategory(C, X)) = innerComp(C, overMorphisms(C, X))
proof
  simp [overCategory, Category.mk.obj, Category.mk.mor, Category.mk.dom,
    Category.mk.cod, Category.mk.id, Category.mk.comp]

theorem tkIover.hom_iff (p q m : Set)
  shows m ∈ hom(overCategory(C, X), p, q) ↔ (m ∈ overMorphisms(C, X) ∧ fst(m) = (p, q))
proof
  obtain ⟨pO, pM, pD, pC, pI, pK⟩ := tkIover.projections at C, X with category, object
  constructor
  . intro member
    obtain ⟨mIn, d, c⟩ := hom.membership.forward with member
    rw pM at mIn
    rw pD at d
    rw pC at c
    rw (tkIconcreteDom.apply with mIn) at d
    rw (tkIconcreteCod.apply with mIn) at c
    obtain ⟨shape, _, _⟩ := tkIover.laws at C, X with category, object
    obtain ⟨p1, p1In, q1, q1In, h, hHom, e⟩ := shape with m, mIn
    rw e at d
    rw e at c
    rw [fst.pair, fst.pair] at d
    rw [fst.pair, snd.pair] at c
    refine ⟨mIn, ?_⟩
    rw [e, fst.pair, d, c]
  . intro h
    obtain ⟨mIn, e⟩ := h
    apply hom.membership.backward
    rw [pM, pD, pC]
    rw [(tkIconcreteDom.apply with mIn), (tkIconcreteCod.apply with mIn), e, fst.pair, snd.pair]
    exact ⟨mIn, rfl, rfl⟩

theorem underCategory.category
  shows Category(underCategory(C, X))
proof
  obtain ⟨shape, ids, closed⟩ := tkIunder.laws at C, X with category, object
  unfold underCategory
  exact tkIinner.category with category, shape, ids, closed

-- Over.w: a morphism of the over-category commutes with the structure maps.
theorem overCategory.w (p q m : Set)
  requires morphism : m ∈ hom(overCategory(C, X), p, q)
  shows call2(Category.comp(C), snd(q), snd(m)) = snd(p)
proof
  obtain ⟨mIn, e⟩ := (tkIover.hom_iff at C, X, p, q, m with category, object).forward with morphism
  obtain ⟨_, p1, p1In, q1, q1In, h, hHom, mE, w⟩ := overMorphisms.membership.forward with mIn
  rw [mE, fst.pair] at e
  obtain ⟨pp, qq⟩ := orderedPair.injective with e
  rw [mE, snd.pair, ← pp, ← qq]
  exact w

-- Over.homMk and Over.OverMorphism.ext: a morphism of C commuting with the
-- structure maps is a morphism over X, determined by it.
theorem overCategory.hom_mk (p q h : Set)
  requires first : p ∈ overObjects(C, X)
  requires second : q ∈ overObjects(C, X)
  requires arrow : h ∈ hom(C, fst(p), fst(q))
  requires commutes : call2(Category.comp(C), snd(q), h) = snd(p)
  shows ((p, q), h) ∈ hom(overCategory(C, X), p, q)
proof
  have hM := hom.in_morphisms with arrow
  have bound := product.pair with first, second
  have bound2 := product.pair with bound, hM
  have mIn : ((p, q), h) ∈ overMorphisms(C, X)
    apply overMorphisms.membership.backward
    exact ⟨bound2, p, first, q, second, h, arrow, rfl, commutes⟩
  apply (tkIover.hom_iff at C, X, p, q, ((p, q), h) with category, object).backward
  refine ⟨mIn, ?_⟩
  rw fst.pair

theorem overCategory.ext (p q m n : Set)
  requires first : m ∈ hom(overCategory(C, X), p, q)
  requires second : n ∈ hom(overCategory(C, X), p, q)
  requires same : snd(m) = snd(n)
  shows m = n
proof
  obtain ⟨mIn, me⟩ := (tkIover.hom_iff at C, X, p, q, m with category, object).forward with first
  obtain ⟨nIn, ne⟩ := (tkIover.hom_iff at C, X, p, q, n with category, object).forward with second
  obtain ⟨shape, _, _⟩ := tkIover.laws at C, X with category, object
  obtain ⟨p1, p1In, q1, q1In, h, hHom, mE⟩ := shape with m, mIn
  obtain ⟨p2, p2In, q2, q2In, k, kHom, nE⟩ := shape with n, nIn
  rw [mE, fst.pair] at me
  rw [nE, fst.pair] at ne
  rw [mE, snd.pair] at same
  rw [nE, snd.pair] at same
  rw [mE, nE, me, ne, same]

-- Over.comp_left: composition is composition in C.
theorem overCategory.comp_left (m n : Set)
  requires first : m ∈ overMorphisms(C, X)
  requires second : n ∈ overMorphisms(C, X)
  requires composable : snd(fst(m)) = fst(fst(n))
  shows snd(call2(Category.comp(overCategory(C, X)), n, m)) =
    call2(Category.comp(C), snd(n), snd(m))
proof
  obtain ⟨pO, pM, pD, pC, pI, pK⟩ := tkIover.projections at C, X with category, object
  obtain ⟨shape, _, _⟩ := tkIover.laws at C, X with category, object
  obtain ⟨p1, p1In, q1, q1In, h, hHom, mE⟩ := shape with m, first
  obtain ⟨q2, q2In, r2, r2In, k, kHom, nE⟩ := shape with n, second
  rw [mE, nE, fst.pair, fst.pair, fst.pair, snd.pair] at composable
  rw ← composable at nE
  rw nE at second
  rw mE at first
  rw [pK, mE, nE]
  rw (tkIinnerComp.apply at C, overMorphisms(C, X), p1, q1, r2, h, k with first, second)
  rw [snd.pair, snd.pair, snd.pair]

theorem overForget.functor
  shows overForget(C, X) : overCategory(C, X) ⥤ C
proof
  obtain ⟨shape, ids, closed⟩ := tkIover.laws at C, X with category, object
  have objs : ∀ p ∈ overObjects(C, X), fst(p) ∈ Category.obj(C)
    intros p pIn
    obtain ⟨a, aIn, f, fHom, e⟩ := tkIover.object at C, X, p with category, object, pIn
    rw [e, fst.pair]
    exact aIn
  have faithful := tkIinner.forget with category, shape, ids, closed, objs
  unfold overForget
  unfold overCategory
  exact faithful.left

theorem overForget.faithful
  shows Faithful(overForget(C, X), overCategory(C, X), C)
proof
  obtain ⟨shape, ids, closed⟩ := tkIover.laws at C, X with category, object
  have objs : ∀ p ∈ overObjects(C, X), fst(p) ∈ Category.obj(C)
    intros p pIn
    obtain ⟨a, aIn, f, fHom, e⟩ := tkIover.object at C, X, p with category, object, pIn
    rw [e, fst.pair]
    exact aIn
  unfold overForget
  unfold overCategory
  exact tkIinner.forget with category, shape, ids, closed, objs

theorem underForget.functor
  shows underForget(C, X) : underCategory(C, X) ⥤ C
proof
  obtain ⟨shape, ids, closed⟩ := tkIunder.laws at C, X with category, object
  have objs : ∀ p ∈ underObjects(C, X), fst(p) ∈ Category.obj(C)
    intros p pIn
    obtain ⟨a, aIn, f, fHom, e⟩ := tkIunder.object at C, X, p with category, object, pIn
    rw [e, fst.pair]
    exact aIn
  have faithful := tkIinner.forget with category, shape, ids, closed, objs
  unfold underForget
  unfold underCategory
  exact faithful.left

-- (X, id) is terminal in the over-category (Over.mkIdTerminal).
theorem overCategory.terminal
  shows Terminal(overCategory(C, X), (X, Category.id(C)(X)))
proof
  obtain ⟨pO, pM, pD, pC, pI, pK⟩ := tkIover.projections at C, X with category, object
  have idHom := hom.id with category, object
  have idM := hom.in_morphisms with idHom
  have objPair := product.pair with object, idM
  have tIn : (X, Category.id(C)(X)) ∈ overObjects(C, X)
    apply overObjects.membership.backward
    exact ⟨objPair, X, object, Category.id(C)(X), idHom, rfl⟩
  refine ⟨?_, ?_⟩
  . rw pO
    exact tIn
  . intros a aIn
    rw pO at aIn
    obtain ⟨b, bIn, f, fHom, aE⟩ := tkIover.object at C, X, a with category, object, aIn
    have fstA : fst(a) = b
      rw [aE, fst.pair]
    have sndA : snd(a) = f
      rw [aE, snd.pair]
    have fHom2 : f ∈ hom(C, fst(a), fst((X, Category.id(C)(X))))
      rw [fstA, fst.pair]
      exact fHom
    have law := Category.id_left_hom with category, fHom
    have commutes : call2(Category.comp(C), snd((X, Category.id(C)(X))), f) = snd(a)
      rw [snd.pair, sndA]
      exact law
    have mHom := overCategory.hom_mk at C, X, a, (X, Category.id(C)(X)), f with category, object, aIn, tIn, fHom2, commutes
    refine ⟨((a, (X, Category.id(C)(X))), f), mHom, ?_⟩
    intros g gHom
    have w := overCategory.w at C, X, a, (X, Category.id(C)(X)), g with category, object, gHom
    obtain ⟨gIn, gE⟩ := (tkIover.hom_iff at C, X, a, (X, Category.id(C)(X)), g with category, object).forward with gHom
    obtain ⟨shape, _, _⟩ := tkIover.laws at C, X with category, object
    obtain ⟨p1, p1In, q1, q1In, h, hHom, mE⟩ := shape with g, gIn
    rw [mE, fst.pair] at gE
    obtain ⟨pp, qq⟩ := orderedPair.injective with gE
    rw [pp, fstA] at hHom
    rw [qq, fst.pair] at hHom
    have law2 := Category.id_left_hom with category, hHom
    rw [snd.pair, sndA, mE, snd.pair, law2] at w
    apply overCategory.ext at C, X, a, (X, Category.id(C)(X)), g, ((a, (X, Category.id(C)(X))), f) with category, object, gHom, mHom
    rw [mE, snd.pair, snd.pair, w]

end OverLaws

theorem overMap.functor (C X Y g : Set)
  requires category : Category(C)
  requires arrow : g ∈ hom(C, X, Y)
  shows overMap(C, X, Y, g) : overCategory(C, X) ⥤ overCategory(C, Y)
proof
  sorry

-- The under-category of a ring A in the category of rings is the category
-- of A-algebras: (S, φ) ↦ Algebra.mk(A, S, φ) (CommRingCat.toAlgebra; the
-- source's `CommAlg k` and `Under k` are interchangeable). Stated as an
-- isomorphism of categories given by an explicit functor.
-- p = (S, ((A, S), φ)) goes to the algebra Algebra.mk(A, S, φ).
def underAlgebra (A p : Set) : Set := Algebra.mk(A, fst(p), snd(snd(p)))

def underToAlgebraObjects (K A : Set) : Set :=
  { (p, underAlgebra(A, p)) | p ∈ underObjects(ringCategory(K), A) }

def underToAlgebraMorphisms (K A : Set) : Set :=
  { (m, ((underAlgebra(A, fst(fst(m))), underAlgebra(A, snd(fst(m)))),
      snd(snd(m)))) | m ∈ underMorphisms(ringCategory(K), A) }

def underToAlgebra (K A : Set) : Set :=
  Functor.mk(underToAlgebraObjects(K, A), underToAlgebraMorphisms(K, A),
    underCategory(ringCategory(K), A), algebraCategory(K, A))

theorem underToAlgebra.functor (K A : Set)
  requires rings : ∀ R ∈ K, CommRing(R)
  requires base : A ∈ K
  shows underToAlgebra(K, A) : underCategory(ringCategory(K), A) ⥤ algebraCategory(K, A)
proof
  sorry

theorem underToAlgebra.full (K A : Set)
  requires rings : ∀ R ∈ K, CommRing(R)
  requires base : A ∈ K
  shows Full(underToAlgebra(K, A), underCategory(ringCategory(K), A),
    algebraCategory(K, A)) ∧
    Faithful(underToAlgebra(K, A), underCategory(ringCategory(K), A),
      algebraCategory(K, A))
proof
  sorry

-- Section: Functor categories
-- The functors C ⥤ D, for categories C and D that are sets, form a set:
-- each is Functor.mk(o, m, C, D) with o and m functions between the object
-- and morphism sets. A morphism is ((F, G), η) with η : F ⟹ G, composed
-- vertically (CategoryTheory.Functor.category). The functor categories of
-- the region are these, so they are small; no universe is involved.
def functorShapes (C D : Set) : Set :=
  { Functor.mk(fst(q), snd(q), C, D) |
    q ∈ functionSpace(Category.obj(C), Category.obj(D)) × functionSpace(mor(C), mor(D)) }

def functorObjects (C D : Set) : Set :=
  { F ∈ functorShapes(C, D) | Functor(F, C, D) }

def functorMorphisms (C D : Set) : Set :=
  { m ∈ (functorObjects(C, D) × functorObjects(C, D)) ×
      functionSpace(Category.obj(C), mor(D)) |
    ∃ F ∈ functorObjects(C, D), ∃ G ∈ functorObjects(C, D), ∃ η,
      m = ((F, G), η) ∧ η : F ⟹ G }

def functorIdentity (C D : Set) : Set :=
  { (F, ((F, F), identityTransformation(F))) | F ∈ functorObjects(C, D) }

def functorComposition (C D : Set) : Set :=
  { (p, ((fst(fst(snd(p))), snd(fst(fst(p)))),
      verticalComposition(snd(snd(p)), snd(fst(p)), fst(fst(snd(p))),
        snd(fst(snd(p))), snd(fst(fst(p)))))) |
    p ∈ composablePairsOf(functorMorphisms(C, D),
      concreteDom(functorMorphisms(C, D)), concreteCod(functorMorphisms(C, D))) }

def functorCategory (C D : Set) : Set :=
  Category.mk(functorObjects(C, D), functorMorphisms(C, D),
    concreteDom(functorMorphisms(C, D)), concreteCod(functorMorphisms(C, D)),
    functorIdentity(C, D), functorComposition(C, D))

-- Evaluation at an object a (CategoryTheory.evaluation): F ↦ F(a),
-- ((F, G), η) ↦ η(a).
def evaluationObjects (C D a : Set) : Set :=
  { (F, Functor.obj(F)(a)) | F ∈ functorObjects(C, D) }

def evaluationMorphisms (C D a : Set) : Set :=
  { (m, snd(m)(a)) | m ∈ functorMorphisms(C, D) }

def evaluationFunctor (C D a : Set) : Set :=
  Functor.mk(evaluationObjects(C, D, a), evaluationMorphisms(C, D, a),
    functorCategory(C, D), D)

-- Precomposition with a functor Φ : E ⥤ C (restriction of presheaves
-- along a functor of sites, the source's `restrictAlong`): F ↦ Φ ⋙ F.
def whiskerComponents (Φ η : Set) : Set :=
  { (a, η(Functor.obj(Φ)(a))) | a ∈ Category.obj(Functor.src(Φ)) }

def restrictObjects (Φ C D : Set) : Set :=
  { (F, composeFunctor(Φ, F)) | F ∈ functorObjects(C, D) }

def restrictMorphisms (Φ C D : Set) : Set :=
  { (m, ((composeFunctor(Φ, fst(fst(m))), composeFunctor(Φ, snd(fst(m)))),
      whiskerComponents(Φ, snd(m)))) | m ∈ functorMorphisms(C, D) }

def restrictAlong (Φ E C D : Set) : Set :=
  Functor.mk(restrictObjects(Φ, C, D), restrictMorphisms(Φ, C, D),
    functorCategory(C, D), functorCategory(E, D))

-- The sets that are members of V(θ), with all functions between them: the
-- full subcategory of Sets(V(θ)) on V(θ), the source's `Type 1`.
def valueSets : Set := fullSubcategory(Sets(valueStage), valueStage)

-- Spaces on a category C: functors C ⥤ valueSets, the source's
-- `C ⥤ Type 1`. The test spaces are the spaces on 𝒰
-- (`PointFunctor := CommRingCat.{0} ⥤ Type 1`).
def spaceCategory (C : Set) : Set := functorCategory(C, valueSets)

def testSpaces : Set := spaceCategory(testCategory)

-- The representable space h_A = Hom(A, −) of a test ring
-- (`reprFunctor := uliftCoyoneda.{1}`, Defs.lean:69; uliftCoyoneda).
def representableOn (C A : Set) : Set :=
  fullCorestriction(homFunctor(C, valueStage, A), C, Sets(valueStage), valueStage)

def representable (A : Set) : Set := representableOn(testCategory, A)

section FunctorCategories
variable (C D : Set)
hypothesis source : Category(C)
hypothesis target : Category(D)

theorem functorCategory.category
  shows Category(functorCategory(C, D))
proof
  sorry

theorem functorCategory.obj (F : Set)
  shows F ∈ Category.obj(functorCategory(C, D)) ↔ F : C ⥤ D
proof
  sorry

theorem functorCategory.hom (F G η : Set)
  requires first : F : C ⥤ D
  requires second : G : C ⥤ D
  shows ((F, G), η) ∈ hom(functorCategory(C, D), F, G) ↔ η : F ⟹ G
proof
  sorry

theorem functorCategory.comp_app (F G H η θ a : Set)
  requires first : ((F, G), η) ∈ functorMorphisms(C, D)
  requires second : ((G, H), θ) ∈ functorMorphisms(C, D)
  requires object : a ∈ Category.obj(C)
  shows snd(call2(Category.comp(functorCategory(C, D)), ((G, H), θ),
      ((F, G), η)))(a) = call2(Category.comp(D), θ(a), η(a))
proof
  sorry

-- A natural transformation is an isomorphism of the functor category iff
-- each component is (NatIso.ofComponents, NatIso.isIso_of_isIso_app).
theorem functorCategory.isomorphism (F G η : Set)
  requires natural : ((F, G), η) ∈ functorMorphisms(C, D)
  shows Isomorphism(functorCategory(C, D), ((F, G), η)) ↔
    (∀ a ∈ Category.obj(C), Isomorphism(D, η(a)))
proof
  sorry

-- A transformation is a monomorphism iff each component is, when D has
-- pullbacks computed objectwise (NatTrans.mono_iff_mono_app), here for
-- the categories of sets and of abelian groups.
theorem functorCategory.mono_sets (F G η U : Set)
  requires natural : ((F, G), η) ∈ functorMorphisms(C, Sets(U))
  shows Monomorphism(functorCategory(C, Sets(U)), ((F, G), η)) ↔
    (∀ a ∈ Category.obj(C), Monomorphism(Sets(U), η(a)))
proof
  sorry

theorem evaluationFunctor.functor (a : Set)
  requires object : a ∈ Category.obj(C)
  shows evaluationFunctor(C, D, a) : functorCategory(C, D) ⥤ D
proof
  sorry

theorem restrictAlong.functor (Φ E : Set)
  requires along : Φ : E ⥤ C
  shows restrictAlong(Φ, E, C, D) : functorCategory(C, D) ⥤ functorCategory(E, D)
proof
  sorry

end FunctorCategories

-- The functor categories of the region are sets: the test spaces are a
-- category, and every representable on a site is a space.
theorem representableOn.functor (C A : Set)
  requires site : Category(C)
  requires bounded : mor(C) ⊆ valueStage
  requires object : A ∈ Category.obj(C)
  shows representableOn(C, A) : C ⥤ valueSets
proof
  sorry

theorem valueSets.category
  shows Category(valueSets)
proof
  have sets := Sets.category at valueStage
  have tr := valueStage.transitive
  have sub : valueStage ⊆ Category.obj(Sets(valueStage))
    rw Sets.obj
    intros x xIn
    have xs := tr with x, xIn
    exact powerset.membership_iff.backward with xs
  unfold valueSets
  exact fullSubcategory.category with sets, sub

theorem testSpaces.category
  shows Category(testSpaces)
proof
  sorry

theorem representable.functor (A : Set)
  requires test : A ∈ testRings
  shows representable(A) : testCategory ⥤ valueSets
proof
  sorry

theorem representable.object (A : Set)
  requires test : A ∈ testRings
  shows representable(A) ∈ Category.obj(testSpaces)
proof
  sorry

-- The Yoneda lemma for spaces on 𝒰 (uliftCoyonedaEquiv): natural
-- transformations h_A ⟹ F correspond to elements of F(A), by evaluation
-- at the identity.
def yonedaEvaluation (C A F : Set) : Set :=
  { (η, η(A)(Category.id(C)(A))) | η ∈ NatTrans(representableOn(C, A), F) }

theorem representable.yoneda (A F : Set)
  requires test : A ∈ testRings
  requires space : F : testCategory ⥤ valueSets
  shows BijectiveBetween(yonedaEvaluation(testCategory, A, F),
    NatTrans(representable(A), F), Functor.obj(F)(A))
proof
  sorry

-- Section: Subfunctors
-- A subfunctor of a space F : C ⥤ valueSets: a family S(a) ⊆ F(a) stable
-- under the maps of F (CategoryTheory.Subfunctor).
predicate Subfunctor (S F C : Set) :=
  Functor(F, C, valueSets) ∧ (S : Category.obj(C) → valueStage) ∧
  (∀ a ∈ Category.obj(C), S(a) ⊆ Functor.obj(F)(a)) ∧
  (∀ a b ∈ Category.obj(C), ∀ f ∈ hom(C, a, b), ∀ x ∈ S(a),
    Functor.map(F)(f)(x) ∈ S(b))

-- The subfunctor as a functor: a ↦ S(a), f ↦ F(f) restricted.
def subfunctorMap (S F C : Set) : Set :=
  { (f, setArrow(valueStage, S(cod(C)(f)),
      restrict(setsMap(valueStage, Functor.map(F)(f)), S(dom(C)(f))))) | f ∈ mor(C) }

def subfunctor (S F C : Set) : Set :=
  Functor.mk(S, subfunctorMap(S, F, C), C, valueSets)

-- The inclusion S ⟶ F (Subfunctor.ι) and, for S ⊆ T, S ⟶ T
-- (Subfunctor.homOfLe).
def subfunctorInclusion (S T C : Set) : Set :=
  { (a, setArrow(valueStage, T(a), identity(S(a)))) | a ∈ Category.obj(C) }

-- The whole functor, intersections and unions, ranges and preimages.
def topSubfunctor (F C : Set) : Set := { (a, Functor.obj(F)(a)) | a ∈ Category.obj(C) }

def subfunctorMeet (S T C : Set) : Set := { (a, S(a) ∩ T(a)) | a ∈ Category.obj(C) }

def subfunctorJoin (S T C : Set) : Set := { (a, S(a) ∪ T(a)) | a ∈ Category.obj(C) }

-- The image of η : G ⟹ F (Subfunctor.range).
def rangeSubfunctor (η G F C : Set) : Set :=
  { (a, functionImage(η(a), Functor.obj(G)(a), Functor.obj(F)(a))) | a ∈ Category.obj(C) }

-- The preimage of a subfunctor S of F under η : G ⟹ F (Subfunctor.preimage).
def preimageSubfunctor (η S G C : Set) : Set :=
  { (a, functionPreimage(η(a), Functor.obj(G)(a), S(a))) | a ∈ Category.obj(C) }

-- The corestriction G ⟶ range(η) (Subfunctor.toRange) and the lift of a
-- transformation landing in S (Subfunctor.lift).
def corestrictTransformation (η S C : Set) : Set :=
  { (a, setArrow(valueStage, S(a), setsMap(valueStage, η(a)))) | a ∈ Category.obj(C) }

section SubfunctorLaws
variable (S F C : Set)
hypothesis category : Category(C)
hypothesis sub : Subfunctor(S, F, C)

theorem subfunctor.functor
  shows subfunctor(S, F, C) : C ⥤ valueSets
proof
  sorry

theorem subfunctorInclusion.natural
  shows subfunctorInclusion(S, topSubfunctor(F, C), C) : subfunctor(S, F, C) ⟹ F
proof
  sorry

theorem subfunctorInclusion.mono
  shows Monomorphism(functorCategory(C, valueSets), ((subfunctor(S, F, C), F),
    subfunctorInclusion(S, topSubfunctor(F, C), C)))
proof
  sorry

-- Subfunctor.eq_top_iff_isIso: the inclusion is an isomorphism iff S is
-- all of F.
theorem subfunctor.eq_top_iff_iso
  shows S = topSubfunctor(F, C) ↔
    Isomorphism(functorCategory(C, valueSets), ((subfunctor(S, F, C), F),
      subfunctorInclusion(S, topSubfunctor(F, C), C)))
proof
  sorry

theorem subfunctor.meet (T : Set)
  requires other : Subfunctor(T, F, C)
  shows Subfunctor(subfunctorMeet(S, T, C), F, C)
proof
  sorry

theorem subfunctor.join (T : Set)
  requires other : Subfunctor(T, F, C)
  shows Subfunctor(subfunctorJoin(S, T, C), F, C)
proof
  sorry

theorem subfunctor.preimage (η G : Set)
  requires natural : η : G ⟹ F
  requires functorG : G : C ⥤ valueSets
  shows Subfunctor(preimageSubfunctor(η, S, G, C), G, C)
proof
  sorry

-- Subfunctor.lift: a transformation η : G ⟹ F whose components land in S
-- factors through the inclusion.
theorem subfunctor.lift (η G : Set)
  requires natural : η : G ⟹ F
  requires functorG : G : C ⥤ valueSets
  requires lands : ∀ a ∈ Category.obj(C), ∀ x ∈ Functor.obj(G)(a), η(a)(x) ∈ S(a)
  shows corestrictTransformation(η, S, C) : G ⟹ subfunctor(S, F, C)
proof
  sorry

end SubfunctorLaws

theorem subfunctor.top (F C : Set)
  requires category : Category(C)
  requires functor : F : C ⥤ valueSets
  shows Subfunctor(topSubfunctor(F, C), F, C)
proof
  have sets := Sets.category at valueStage
  have tr := valueStage.transitive
  have sub : valueStage ⊆ Category.obj(Sets(valueStage))
    rw Sets.obj
    intros x xIn
    have xs := tr with x, xIn
    exact powerset.membership_iff.backward with xs
  have vo : Category.obj(valueSets) = valueStage
    simp [valueSets, fullSubcategory, Category.mk.obj]
  have value : ∀ a ∈ Category.obj(C), topSubfunctor(F, C)(a) = Functor.obj(F)(a)
    intros a aIn
    have pairs : ∀ p ∈ topSubfunctor(F, C), ∃ x, ∃ y, (x, y) = p
      intros p hp
      obtain ⟨n, nIn, shape⟩ := topSubfunctor.membership.forward with hp
      exact ⟨n, Functor.obj(F)(n), shape⟩
    have functional : Functional(topSubfunctor(F, C))
      intros x y hxy z hxz
      obtain ⟨n1, n1In, e1⟩ := topSubfunctor.membership.forward with hxy
      obtain ⟨n2, n2In, e2⟩ := topSubfunctor.membership.forward with hxz
      obtain ⟨x1, y1⟩ := orderedPair.injective with e1
      obtain ⟨x2, z2⟩ := orderedPair.injective with e2
      cc
    have mem : (a, Functor.obj(F)(a)) ∈ topSubfunctor(F, C) :=
      topSubfunctor.membership.backward with ⟨a, aIn, rfl⟩
    exact tkIfun.apply with pairs, functional, mem
  have closed : ∀ a ∈ Category.obj(C), Functor.obj(F)(a) ∈ valueStage
    intros a aIn
    have c := Functor.object_closed at F, C, valueSets, a with functor, aIn
    rw vo at c
    exact c
  refine ⟨functor, ?_, ?_, ?_⟩
  . apply tkIfun.between
    . intros p hp
      obtain ⟨a, aIn, e⟩ := topSubfunctor.membership.forward with hp
      have c := closed with a, aIn
      exact ⟨a, aIn, Functor.obj(F)(a), c, e⟩
    . intros x y hxy z hxz
      obtain ⟨n1, n1In, e1⟩ := topSubfunctor.membership.forward with hxy
      obtain ⟨n2, n2In, e2⟩ := topSubfunctor.membership.forward with hxz
      obtain ⟨x1, y1⟩ := orderedPair.injective with e1
      obtain ⟨x2, z2⟩ := orderedPair.injective with e2
      cc
    . intros a aIn
      have c := closed with a, aIn
      have mem : (a, Functor.obj(F)(a)) ∈ topSubfunctor(F, C) :=
        topSubfunctor.membership.backward with ⟨a, aIn, rfl⟩
      exact ⟨Functor.obj(F)(a), c, mem⟩
  . intros a aIn
    rw (value with a, aIn)
    exact Subset.reflexive at Functor.obj(F)(a)
  . intros a aIn b bIn f fHom x xIn
    rw (value with a, aIn) at xIn
    rw (value with b, bIn)
    have image := Functor.hom at F, C, valueSets, a, b, f with functor, fHom
    unfold valueSets at image
    have faIn := closed with a, aIn
    have fbIn := closed with b, bIn
    have image2 := (tkIfull.hom_iff at Sets(valueStage), valueStage, Functor.obj(F)(a), Functor.obj(F)(b), Functor.map(F)(f) with sets, sub, faIn, fbIn).forward with image
    have typed := Morphism.of_hom with image2
    exact Sets.apply_closed at valueStage, Functor.obj(F)(a), Functor.obj(F)(b), Functor.map(F)(f), x with sets, typed, xIn

theorem subfunctor.range (η G F C : Set)
  requires category : Category(C)
  requires functorF : F : C ⥤ valueSets
  requires functorG : G : C ⥤ valueSets
  requires natural : η : G ⟹ F
  shows Subfunctor(rangeSubfunctor(η, G, F, C), F, C)
proof
  sorry

-- Section: Pullbacks and pushouts
-- (P, p₁, p₂) is a pullback of f : a ⟶ c and g : b ⟶ c: the square
-- commutes and every commuting square factors uniquely through it
-- (CategoryTheory.IsPullback).
predicate IsPullback (C P p1 p2 f g : Set) :=
  Category(C) ∧ (∃ a ∈ Category.obj(C), ∃ b ∈ Category.obj(C), ∃ c ∈ Category.obj(C),
    p1 ∈ hom(C, P, a) ∧ p2 ∈ hom(C, P, b) ∧ f ∈ hom(C, a, c) ∧
    g ∈ hom(C, b, c) ∧
    call2(Category.comp(C), f, p1) = call2(Category.comp(C), g, p2) ∧
    (∀ Q ∈ Category.obj(C), ∀ q1 ∈ hom(C, Q, a), ∀ q2 ∈ hom(C, Q, b),
      call2(Category.comp(C), f, q1) = call2(Category.comp(C), g, q2) →
      (∃ u ∈ hom(C, Q, P), call2(Category.comp(C), p1, u) = q1 ∧
        call2(Category.comp(C), p2, u) = q2 ∧
        (∀ v ∈ hom(C, Q, P), call2(Category.comp(C), p1, v) = q1 →
          call2(Category.comp(C), p2, v) = q2 → v = u))))

-- (P, i₁, i₂) is a pushout of f : c ⟶ a and g : c ⟶ b (IsPushout).
predicate IsPushout (C P i1 i2 f g : Set) :=
  Category(C) ∧ (∃ a ∈ Category.obj(C), ∃ b ∈ Category.obj(C), ∃ c ∈ Category.obj(C),
    i1 ∈ hom(C, a, P) ∧ i2 ∈ hom(C, b, P) ∧ f ∈ hom(C, c, a) ∧
    g ∈ hom(C, c, b) ∧
    call2(Category.comp(C), i1, f) = call2(Category.comp(C), i2, g) ∧
    (∀ Q ∈ Category.obj(C), ∀ q1 ∈ hom(C, a, Q), ∀ q2 ∈ hom(C, b, Q),
      call2(Category.comp(C), q1, f) = call2(Category.comp(C), q2, g) →
      (∃ u ∈ hom(C, P, Q), call2(Category.comp(C), u, i1) = q1 ∧
        call2(Category.comp(C), u, i2) = q2 ∧
        (∀ v ∈ hom(C, P, Q), call2(Category.comp(C), v, i1) = q1 →
          call2(Category.comp(C), v, i2) = q2 → v = u))))

-- The fibre product of spaces, objectwise: (F ×_H G)(a) = {(x, y) :
-- α(x) = β(y)} (the source's `fibreProd`, Limits.pullback in a functor
-- category to sets).
def fibreSet (F G α β a : Set) : Set :=
  { z ∈ Functor.obj(F)(a) × Functor.obj(G)(a) |
    α(a)(fst(z)) = β(a)(snd(z)) }

def fibreObjects (F G α β C : Set) : Set :=
  { (a, fibreSet(F, G, α, β, a)) | a ∈ Category.obj(C) }

def fibreMapGraph (F G α β C f : Set) : Set :=
  { (z, (Functor.map(F)(f)(fst(z)), Functor.map(G)(f)(snd(z)))) |
    z ∈ fibreSet(F, G, α, β, dom(C)(f)) }

def fibreMorphisms (F G α β C : Set) : Set :=
  { (f, setArrow(valueStage, fibreSet(F, G, α, β, cod(C)(f)),
      fibreMapGraph(F, G, α, β, C, f))) | f ∈ mor(C) }

def fibreProduct (F G α β C : Set) : Set :=
  Functor.mk(fibreObjects(F, G, α, β, C), fibreMorphisms(F, G, α, β, C),
    C, valueSets)

-- The two projections of the fibre product.
def fibreFirst (F G α β C : Set) : Set :=
  { (a, setArrow(valueStage, Functor.obj(F)(a), firstEntries(fibreSet(F, G, α, β, a)))) |
    a ∈ Category.obj(C) }

def secondEntries (O : Set) : Set := { (p, snd(p)) | p ∈ O }

def fibreSecond (F G α β C : Set) : Set :=
  { (a, setArrow(valueStage, Functor.obj(G)(a), secondEntries(fibreSet(F, G, α, β, a)))) |
    a ∈ Category.obj(C) }

section PullbackLaws
variable (C : Set)
hypothesis category : Category(C)

theorem tkIpb.object (Q P u : Set)
  requires uHom : u ∈ hom(C, Q, P)
  shows Q ∈ Category.obj(C) ∧ P ∈ Category.obj(C)
proof
  have uM := hom.in_morphisms with uHom
  have d := hom.dom with uHom
  have c := hom.cod with uHom
  have dO := Category.dom_closed with category, uM
  have cO := Category.cod_closed with category, uM
  rw d at dO
  rw c at cO
  exact ⟨dO, cO⟩

theorem tkIpb.ext (P p1 p2 f g Q u v : Set)
  requires pullback : IsPullback(C, P, p1, p2, f, g)
  requires uHom : u ∈ hom(C, Q, P)
  requires vHom : v ∈ hom(C, Q, P)
  requires first : call2(Category.comp(C), p1, u) = call2(Category.comp(C), p1, v)
  requires second : call2(Category.comp(C), p2, u) = call2(Category.comp(C), p2, v)
  shows u = v
proof
  obtain ⟨cat, a, aIn, b, bIn, c, cIn, p1Hom, p2Hom, fHom, gHom, square, universal⟩ :=
    pullback
  obtain ⟨QIn, _⟩ := tkIpb.object at C, Q, P, u with category, uHom
  have q1Hom := hom.comp with category, p1Hom, uHom
  have q2Hom := hom.comp with category, p2Hom, uHom
  have commutes : call2(Category.comp(C), f, call2(Category.comp(C), p1, u)) =
      call2(Category.comp(C), g, call2(Category.comp(C), p2, u))
    rw [← (Category.assoc_hom with category, fHom, p1Hom, uHom), square]
    rw (Category.assoc_hom with category, gHom, p2Hom, uHom)
  obtain ⟨w, wHom, w1, w2, unique⟩ :=
    universal with Q, QIn, call2(Category.comp(C), p1, u), q1Hom,
      call2(Category.comp(C), p2, u), q2Hom, commutes
  have r1 : call2(Category.comp(C), p1, u) = call2(Category.comp(C), p1, u) by rfl
  have r2 : call2(Category.comp(C), p2, u) = call2(Category.comp(C), p2, u) by rfl
  have uw := unique with u, uHom, r1, r2
  have s1 : call2(Category.comp(C), p1, v) = call2(Category.comp(C), p1, u)
    symm
    exact first
  have s2 : call2(Category.comp(C), p2, v) = call2(Category.comp(C), p2, u)
    symm
    exact second
  have vw := unique with v, vHom, s1, s2
  rw [uw, vw]

-- IsPullback.flip.
theorem IsPullback.flip (P p1 p2 f g : Set)
  requires pullback : IsPullback(C, P, p1, p2, f, g)
  shows IsPullback(C, P, p2, p1, g, f)
proof
  obtain ⟨cat, a, aIn, b, bIn, c, cIn, p1Hom, p2Hom, fHom, gHom, square, universal⟩ :=
    pullback
  refine ⟨cat, b, bIn, a, aIn, c, cIn, p2Hom, p1Hom, gHom, fHom, ?_, ?_⟩
  . symm
    exact square
  . intros Q QIn q1 q1Hom q2 q2Hom commutes
    have commutes2 : call2(Category.comp(C), f, q2) = call2(Category.comp(C), g, q1)
      symm
      exact commutes
    obtain ⟨u, uHom, first, second, unique⟩ :=
      universal with Q, QIn, q2, q2Hom, q1, q1Hom, commutes2
    refine ⟨u, uHom, second, first, ?_⟩
    intros v vHom v1 v2
    exact unique with v, vHom, v2, v1

-- Two pullbacks of one cospan are isomorphic (IsPullback.isoPullback).
theorem IsPullback.isomorphic (P p1 p2 Q q1 q2 f g : Set)
  requires first : IsPullback(C, P, p1, p2, f, g)
  requires second : IsPullback(C, Q, q1, q2, f, g)
  shows ∃ u ∈ hom(C, Q, P), Isomorphism(C, u) ∧
    call2(Category.comp(C), p1, u) = q1 ∧ call2(Category.comp(C), p2, u) = q2
proof
  sorry

-- The pasting law (IsPullback.paste_horiz and IsPullback.of_right'): in
-- two adjacent squares whose right square is a pullback, the left square
-- is a pullback iff the outer rectangle is.
theorem IsPullback.paste (P p1 p2 Q q1 q2 f g h : Set)
  requires right : IsPullback(C, P, p1, p2, f, g)
  requires left : IsPullback(C, Q, q1, q2, p2, h)
  shows IsPullback(C, Q, call2(Category.comp(C), p1, q1), q2, f,
    call2(Category.comp(C), g, h))
proof
  sorry

theorem IsPullback.of_right (P p1 p2 Q q1 q2 f g h : Set)
  requires right : IsPullback(C, P, p1, p2, f, g)
  requires outer : IsPullback(C, Q, call2(Category.comp(C), p1, q1), q2, f,
    call2(Category.comp(C), g, h))
  requires square : call2(Category.comp(C), p2, q1) = call2(Category.comp(C), h, q2)
  requires target : q1 ∈ hom(C, Q, P)
  shows IsPullback(C, Q, q1, q2, p2, h)
proof
  sorry

-- The pullback of an isomorphism is an isomorphism, and the pullback of a
-- monomorphism is a monomorphism.
theorem IsPullback.iso (P p1 p2 f g : Set)
  requires pullback : IsPullback(C, P, p1, p2, f, g)
  requires iso : Isomorphism(C, g)
  shows Isomorphism(C, p1)
proof
  sorry

theorem IsPullback.mono (P p1 p2 f g : Set)
  requires pullback : IsPullback(C, P, p1, p2, f, g)
  requires mono : Monomorphism(C, g)
  shows Monomorphism(C, p1)
proof
  have pb := pullback
  obtain ⟨cat, a, aIn, b, bIn, c, cIn, p1Hom, p2Hom, fHom, gHom, square, universal⟩ := pb
  have p1M := hom.in_morphisms with p1Hom
  refine ⟨p1M, ?_⟩
  intros u uM v vM du dv same
  have p1d := hom.dom with p1Hom
  rw p1d at du
  rw p1d at dv
  have uHom0 := hom.of_morphism with uM
  have vHom0 := hom.of_morphism with vM
  rw ← du at uHom0
  rw ← dv at vHom0
  have uHom1 := hom.comp with category, p1Hom, uHom0
  have vHom1 := hom.comp with category, p1Hom, vHom0
  have endsU := hom.dom with uHom1
  have endsV := hom.dom with vHom1
  rw same at endsU
  have domSame : dom(C)(u) = dom(C)(v) by cc
  rw domSame at uHom0
  have p2uHom := hom.comp with category, p2Hom, uHom0
  have p2vHom := hom.comp with category, p2Hom, vHom0
  have eq2 : call2(Category.comp(C), g, call2(Category.comp(C), p2, u)) =
      call2(Category.comp(C), g, call2(Category.comp(C), p2, v))
    rw [← (Category.assoc_hom with category, gHom, p2Hom, uHom0), ← square]
    rw [(Category.assoc_hom with category, fHom, p1Hom, uHom0), same]
    rw [← (Category.assoc_hom with category, fHom, p1Hom, vHom0), square]
    rw (Category.assoc_hom with category, gHom, p2Hom, vHom0)
  obtain ⟨gM, cancel⟩ := mono
  have p2uM := hom.in_morphisms with p2uHom
  have p2vM := hom.in_morphisms with p2vHom
  have gd := hom.dom with gHom
  have c1 := hom.cod with p2uHom
  have c2 := hom.cod with p2vHom
  have e1 : dom(C)(g) = cod(C)(call2(Category.comp(C), p2, u)) by cc
  have e2 : dom(C)(g) = cod(C)(call2(Category.comp(C), p2, v)) by cc
  have eq2b := cancel with call2(Category.comp(C), p2, u), p2uM,
    call2(Category.comp(C), p2, v), p2vM, e1, e2, eq2
  exact tkIpb.ext at C, P, p1, p2, f, g, dom(C)(v), u, v with category, pullback, uHom0, vHom0, same, eq2b

-- A monomorphism f has the pullback square (id, id) along itself.
theorem IsPullback.mono_iff (a b f : Set)
  requires arrow : f ∈ hom(C, a, b)
  shows Monomorphism(C, f) ↔
    IsPullback(C, a, Category.id(C)(a), Category.id(C)(a), f, f)
proof
  sorry

-- Functors that are equivalences, or isomorphic images, preserve
-- pullbacks; stated for the transport along an isomorphism of squares
-- (IsPullback.of_iso).
theorem IsPullback.of_iso (P p1 p2 Q u f g : Set)
  requires pullback : IsPullback(C, P, p1, p2, f, g)
  requires arrow : u ∈ hom(C, Q, P)
  requires iso : Isomorphism(C, u)
  shows IsPullback(C, Q, call2(Category.comp(C), p1, u),
    call2(Category.comp(C), p2, u), f, g)
proof
  sorry

theorem IsPushout.flip (P i1 i2 f g : Set)
  requires pushout : IsPushout(C, P, i1, i2, f, g)
  shows IsPushout(C, P, i2, i1, g, f)
proof
  obtain ⟨cat, a, aIn, b, bIn, c, cIn, i1Hom, i2Hom, fHom, gHom, square, universal⟩ :=
    pushout
  refine ⟨cat, b, bIn, a, aIn, c, cIn, i2Hom, i1Hom, gHom, fHom, ?_, ?_⟩
  . symm
    exact square
  . intros Q QIn q1 q1Hom q2 q2Hom commutes
    have commutes2 : call2(Category.comp(C), q2, f) = call2(Category.comp(C), q1, g)
      symm
      exact commutes
    obtain ⟨u, uHom, first, second, unique⟩ :=
      universal with Q, QIn, q2, q2Hom, q1, q1Hom, commutes2
    refine ⟨u, uHom, second, first, ?_⟩
    intros v vHom v1 v2
    exact unique with v, vHom, v2, v1

end PullbackLaws

-- Pullbacks of spaces are computed objectwise: the fibre product with its
-- projections is a pullback in the category of spaces.
theorem fibreProduct.functor (F G H α β C : Set)
  requires category : Category(C)
  requires functorF : F : C ⥤ valueSets
  requires functorG : G : C ⥤ valueSets
  requires functorH : H : C ⥤ valueSets
  requires naturalα : α : F ⟹ H
  requires naturalβ : β : G ⟹ H
  shows fibreProduct(F, G, α, β, C) : C ⥤ valueSets
proof
  sorry

theorem fibreProduct.pullback (F G H α β C : Set)
  requires category : Category(C)
  requires functorF : F : C ⥤ valueSets
  requires functorG : G : C ⥤ valueSets
  requires functorH : H : C ⥤ valueSets
  requires naturalα : α : F ⟹ H
  requires naturalβ : β : G ⟹ H
  shows IsPullback(spaceCategory(C), fibreProduct(F, G, α, β, C),
    ((fibreProduct(F, G, α, β, C), F),
      fibreFirst(F, G, α, β, C)),
    ((fibreProduct(F, G, α, β, C), G),
      fibreSecond(F, G, α, β, C)),
    ((F, H), α), ((G, H), β))
proof
  sorry

-- A square of spaces is a pullback iff it is a pullback of sets at every
-- object (evaluation preserves and jointly reflects pullbacks).
theorem IsPullback.spaces_iff (C P p1 p2 f g : Set)
  requires category : Category(C)
  requires morphisms : p1 ∈ mor(spaceCategory(C)) ∧ p2 ∈ mor(spaceCategory(C)) ∧
    f ∈ mor(spaceCategory(C)) ∧ g ∈ mor(spaceCategory(C))
  shows IsPullback(spaceCategory(C), P, p1, p2, f, g) ↔
    (∀ a ∈ Category.obj(C), IsPullback(valueSets, Functor.obj(P)(a),
      snd(p1)(a), snd(p2)(a), snd(f)(a), snd(g)(a)))
proof
  sorry

-- In the category of rings, the tensor product is the pushout
-- (CommRingCat.pushoutCocone_isColimit): for algebras B and C over A,
-- B ⊗_A C with b ↦ b ⊗ 1 and c ↦ 1 ⊗ c.
theorem algebraTensorRing.pushout (K B D : Set)
  requires rings : ∀ R ∈ K, CommRing(R)
  requires first : Algebra(B)
  requires second : Algebra(D)
  requires sameBase : Algebra.base(B) = Algebra.base(D)
  requires inK : Algebra.base(B) ∈ K ∧ Algebra.ring(B) ∈ K ∧ Algebra.ring(D) ∈ K ∧
    algebraTensorRing(B, D) ∈ K
  shows IsPushout(ringCategory(K), algebraTensorRing(B, D),
    ((Algebra.ring(B), algebraTensorRing(B, D)), includeLeft(B, D)),
    ((Algebra.ring(D), algebraTensorRing(B, D)), includeRight(B, D)),
    ((Algebra.base(B), Algebra.ring(B)), Algebra.map(B)),
    ((Algebra.base(D), Algebra.ring(D)), Algebra.map(D)))
proof
  sorry
