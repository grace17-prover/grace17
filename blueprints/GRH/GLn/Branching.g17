-- Branching of Weyl modules from rank n + 1 to rank n, Schur's lemma for
-- Π_τ U(n), Zariski density of the unitary groups, the Gram norm and its
-- submultiplicativity, the hook number clearing denominators, and the
-- duality J between Weyl lattices given by complementary minors.
-- Source: grh-compact/src/Lib/GLn/Branching/Branching.lean
-- (PolyRep.ext_schur_weylEval, scalar_of_commute_schur,
-- PolyRep.exists_int_duality_matrix, exists_dual_isometry,
-- SpansBranchingMaps, PolyRep.exists_cyclic_lower_triangular,
-- exists_branching_matrix), Lib/GLn/Branching/BranchingVector.lean
-- (weylNormSq, zariski_dense_unitary, weylNormSq_weylEval_permArray,
-- exists_toPoly_eq_hookNumber_smul, weylNormSq_le_mul_of_toPoly_eq),
-- Lib/GLn/SchurModule/Gram.lean (blockScalar).
-- Not stated: BranchingVector.lean's comultiplication matrices
-- (cm_mulVec_weylEval, vecMul_comulMatrix_eq_iff,
-- comulMatrix_isometry_and_equivariant, hasLeftInv_comulMatrix) and the
-- internal steps of exists_branching_matrix (newRowOrder, branchVector,
-- exists_smul_weylKernel_mul_eq_toPoly, PolyRep.exists_int_branching_of_weylKernel).
-- Encoding. The rows are the natural numbers n (rank n) and succ(n)
-- (rank n + 1, the added row being n, the source's n ⊕ Unit ≃ N with the
-- added row last); blockScalar g s is diag(g_τ, s_τ). The enumerations e
-- of the rows are the identity (permArray of a ↦ a) and its reversal
-- e′(a) = n − 1 − a. A field of characteristic zero is a ring record R
-- with Field(R) and natCast(R, k) ≠ 0 for k ≠ 0. Integer matrices are
-- matrices over integerRing, read in R through intCastMap.
-- Part of the GRH blueprint (layer 4, Lib/GLn, stage S3).
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.GLn.Branching
import GRH.GLn.WeightRep

section Branching
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)

-- Section: Notation
-- A field of characteristic zero.
predicate CharZeroField (R : Set) :=
  Field(R) ∧ ∀ k ∈ ℕ, k ≠ (0:N) → natCast(R, k) ≠ Ring.zero(R)

-- An integer matrix read in R.
def intMatrixIn (R m k A : Set) : Set := matMap(R, m, k, intCastMap(R), A)

-- BranchingVector.lean, weylNormSq ξ = Re ξ* G ξ.
def schurNormSq (Φ n κ u : Set) : Set :=
  complexRe(vecDot(complexRing, weylIndexSet(Φ, n, κ),
    vecConj(complexRing, complexConjMap, weylIndexSet(Φ, n, κ), u),
    mulVec(complexRing, weylIndexSet(Φ, n, κ), weylIndexSet(Φ, n, κ),
      weylGramOver(complexRing, Φ, n, κ), u)))

-- The identity numbering of the rows and its reversal a ↦ n − 1 − a.
def identityRows (n : Set) : Set := { (a, a) | a ∈ n }

def identityNumbering (Φ n : Set) : Set := { (τ, identityRows(n)) | τ ∈ Φ }

def reversedRows (n : Set) : Set := { (a, sub(sub(n, 1), a)) | a ∈ n }

def reversedNumbering (Φ n : Set) : Set := { (τ, reversedRows(n)) | τ ∈ Φ }

-- Gram.lean, blockScalar g s: diag(g_τ, s_τ) of size n + 1.
def blockEntry (R n gτ sτ q : Set) : Set :=
  ⋃({ c ∈ Ring.carrier(R) |
    (fst(q) ∈ n ∧ snd(q) ∈ n ∧ c = gτ(q)) ∨
    (fst(q) = n ∧ snd(q) = n ∧ c = sτ) ∨
    (¬(fst(q) ∈ n ∧ snd(q) ∈ n) ∧ ¬(fst(q) = n ∧ snd(q) = n) ∧ c = Ring.zero(R)) })

def blockMatrix (R n gτ sτ : Set) : Set :=
  { (q, blockEntry(R, n, gτ, sτ, q)) | q ∈ succ(n) × succ(n) }

def blockScalar (R Φ n g s : Set) : Set := { (τ, blockMatrix(R, n, g(τ), s(τ))) | τ ∈ Φ }

-- Section: Schur's lemma and density
-- BranchingVector.lean, zariski_dense_unitary: a complex polynomial in the
-- entries of a family of n × n matrices vanishing on Π_τ U(n) vanishes.
def entryAssignment (Φ n x : Set) : Set :=
  { (v, x(fst(v))(snd(v))) | v ∈ Φ × (n × n) }

theorem unitaryFamilies.zariski_dense (Φ n P : Set)
  requires finiteΦ : Finite(Φ)
  requires natural : n ∈ ℕ
  requires hP : P ∈ Ring.carrier(polynomialRing(complexRing, Φ × (n × n)))
  requires vanishes : ∀ x ∈ compactUnitaryFamilies(Φ, n),
    evaluationAt(complexRing, Φ × (n × n), entryAssignment(Φ, n, x))(P) = complexZero
  shows ∀ x ∈ matrixFamilies(complexRing, Φ, n, n),
    evaluationAt(complexRing, Φ × (n × n), entryAssignment(Φ, n, x))(P) = complexZero
proof
  sorry

-- Branching.lean, scalar_of_commute_schur (Schur's lemma): a complex matrix
-- commuting with S_κ(g) for every family g of unitary matrices is scalar.
theorem schurMatrix.commutant_scalar (Φ n κ T : Set)
  requires finiteΦ : Finite(Φ)
  requires natural : n ∈ ℕ
  requires counts : (κ : Φ × ℕ → ℕ)
  requires hT : T ∈ matrixSpace(complexRing, weylIndexSet(Φ, n, κ), weylIndexSet(Φ, n, κ))
  requires commutes : ∀ g ∈ compactUnitaryFamilies(Φ, n),
    matMul(complexRing, weylIndexSet(Φ, n, κ), weylIndexSet(Φ, n, κ), weylIndexSet(Φ, n, κ),
      T, schurMatrix(complexRing, Φ, n, n, κ, g)) =
    matMul(complexRing, weylIndexSet(Φ, n, κ), weylIndexSet(Φ, n, κ), weylIndexSet(Φ, n, κ),
      schurMatrix(complexRing, Φ, n, n, κ, g), T)
  shows ∃ a ∈ complexCarrier, T = matScalar(complexRing, weylIndexSet(Φ, n, κ), a)
proof
  sorry

-- Section: The Gram norm
-- BranchingVector.lean, weylNormSq_weylEval_permArray: the evaluation
-- vector at the permutation array of the row numbering has norm 1.
theorem schurNormSq.permArray (Φ n κ : Set)
  requires finiteΦ : Finite(Φ)
  requires natural : n ∈ ℕ
  requires counts : (κ : Φ × ℕ → ℕ)
  shows schurNormSq(Φ, n, κ, weylEval(complexRing, Φ, n, κ,
    permArray(complexRing, Φ, n, identityNumbering(Φ, n)))) = realOne
proof
  sorry

-- BranchingVector.lean, exists_toPoly_eq_hookNumber_smul: over any
-- commutative ring, hookNumber · f is toPoly(ξ) for every semi-invariant f
-- of the diagram weight.
theorem toPoly.hook_multiple (R Φ n κ f : Set)
  requires ring : CommRing(R)
  requires finiteΦ : Finite(Φ)
  requires natural : n ∈ ℕ
  requires counts : (κ : Φ × ℕ → ℕ)
  requires hf : f ∈ nablaModuleSet(R, Φ, n, κ)
  shows ∃ ξ ∈ functionSpace(weylIndexSet(Φ, n, κ), Ring.carrier(R)),
    toPoly(R, Φ, n, κ, ξ) = call2(Ring.mul(rowPolyRing(R, Φ, n)),
      mvC(R, rowVars(Φ, n), intCastMap(R)(hookNumber(Φ, n, κ))), f)
proof
  sorry

-- κ + κ′ pointwise.
def countsAdd (κ κ2 : Set) : Set := { (x, add(κ(x), κ2(x))) | x ∈ domain(κ) }

-- BranchingVector.lean, weylNormSq_le_mul_of_toPoly_eq: if the polynomial
-- of ζ (weight κ + κ′) is the product of those of ξ (κ) and η (κ′), then
-- ‖ζ‖² ≤ ‖ξ‖²‖η‖².
theorem schurNormSq.le_mul (Φ n κ κ2 ζ ξ η : Set)
  requires finiteΦ : Finite(Φ)
  requires natural : n ∈ ℕ
  requires counts : (κ : Φ × ℕ → ℕ)
  requires counts2 : (κ2 : Φ × ℕ → ℕ)
  requires hζ : ζ ∈ functionSpace(weylIndexSet(Φ, n, countsAdd(κ, κ2)), complexCarrier)
  requires hξ : ξ ∈ functionSpace(weylIndexSet(Φ, n, κ), complexCarrier)
  requires hη : η ∈ functionSpace(weylIndexSet(Φ, n, κ2), complexCarrier)
  requires product : toPoly(complexRing, Φ, n, countsAdd(κ, κ2), ζ) =
    call2(Ring.mul(rowPolyRing(complexRing, Φ, n)), toPoly(complexRing, Φ, n, κ, ξ),
      toPoly(complexRing, Φ, n, κ2, η))
  shows RealLe(schurNormSq(Φ, n, countsAdd(κ, κ2), ζ),
    realMul(schurNormSq(Φ, n, κ, ξ), schurNormSq(Φ, n, κ2, η)))
proof
  sorry

-- Section: Duality
-- κ′(τ, h) = κ(τ, n − h) for 1 ≤ h < n (Branching.lean, hκ), the family
-- g^{−T}, and the exponent −Σ_{1≤h<n} κ(τ, h).
predicate ReversedCounts (Φ n κ κ2 : Set) :=
  ∀ τ ∈ Φ, ∀ h ∈ n, h ≠ 0 → κ2((τ, h)) = κ((τ, sub(n, h)))

def inverseTransposeFamily (R Φ n g : Set) : Set :=
  { (τ, matTranspose(R, n, n, matInverse(R, n, g(τ)))) | τ ∈ Φ }

def positiveBelow (n : Set) : Set := { h ∈ n | h ≠ 0 }

def columnCountsAt (n κ τ : Set) : Set := { (h, κ((τ, h))) | h ∈ n }

def lowerColumnSum (n κ τ : Set) : Set := natSum(positiveBelow(n), columnCountsAt(n, κ, τ))

def dualExponent (Φ n κ : Set) : Set :=
  { (τ, integerNegValue(integerOfNat(lowerColumnSum(n, κ, τ)))) | τ ∈ Φ }

-- Branching.lean, exists_dual_isometry (dual of a Weyl module by Jacobi's
-- complementary minors): some unimodular integer J has JᵀG_κJ = G_{κ′}
-- and, over fields of characteristic 0, J ev_e = ev_{e′} and
-- S_κ(g^{−T})J = J ρ_{κ′, −Σκ}(g) for invertible g (e the row numbering,
-- e′ its reversal).
theorem weylLattice.dual_isometry (Φ n κ κ2 : Set)
  requires finiteΦ : Finite(Φ)
  requires natural : n ∈ ℕ
  requires counts : (κ : Φ × ℕ → ℕ)
  requires counts2 : (κ2 : Φ × ℕ → ℕ)
  requires reversed : ReversedCounts(Φ, n, κ, κ2)
  shows ∃ J ∈ matrixSpace(integerRing, weylIndexSet(Φ, n, κ), weylIndexSet(Φ, n, κ2)),
    ∃ J2 ∈ matrixSpace(integerRing, weylIndexSet(Φ, n, κ2), weylIndexSet(Φ, n, κ)),
    matMul(integerRing, weylIndexSet(Φ, n, κ), weylIndexSet(Φ, n, κ2), weylIndexSet(Φ, n, κ),
      J, J2) = matOne(integerRing, weylIndexSet(Φ, n, κ)) ∧
    matMul(integerRing, weylIndexSet(Φ, n, κ2), weylIndexSet(Φ, n, κ), weylIndexSet(Φ, n, κ2),
      J2, J) = matOne(integerRing, weylIndexSet(Φ, n, κ2)) ∧
    matMul(integerRing, weylIndexSet(Φ, n, κ2), weylIndexSet(Φ, n, κ), weylIndexSet(Φ, n, κ2),
      matTranspose(integerRing, weylIndexSet(Φ, n, κ), weylIndexSet(Φ, n, κ2), J),
      matMul(integerRing, weylIndexSet(Φ, n, κ), weylIndexSet(Φ, n, κ), weylIndexSet(Φ, n, κ2),
        weylGram(Φ, n, κ), J)) = weylGram(Φ, n, κ2) ∧
    ∀ R, CharZeroField(R) →
      mulVec(R, weylIndexSet(Φ, n, κ), weylIndexSet(Φ, n, κ2),
        intMatrixIn(R, weylIndexSet(Φ, n, κ), weylIndexSet(Φ, n, κ2), J),
        weylEval(R, Φ, n, κ2, permArray(R, Φ, n, identityNumbering(Φ, n)))) =
        weylEval(R, Φ, n, κ, permArray(R, Φ, n, reversedNumbering(Φ, n))) ∧
      ∀ g ∈ invertibleFamilies(R, Φ, n),
        matMul(R, weylIndexSet(Φ, n, κ), weylIndexSet(Φ, n, κ), weylIndexSet(Φ, n, κ2),
          schurMatrix(R, Φ, n, n, κ, inverseTransposeFamily(R, Φ, n, g)),
          intMatrixIn(R, weylIndexSet(Φ, n, κ), weylIndexSet(Φ, n, κ2), J)) =
        matMul(R, weylIndexSet(Φ, n, κ), weylIndexSet(Φ, n, κ2), weylIndexSet(Φ, n, κ2),
          intMatrixIn(R, weylIndexSet(Φ, n, κ), weylIndexSet(Φ, n, κ2), J),
          weylRep(R, Φ, n, κ2, dualExponent(Φ, n, κ), g))
proof
  sorry

-- Section: Branching
-- Branching.lean, SpansBranchingMaps ι e₀ e A: every complex T with
-- T ρ_{κ,e}(diag(g, 1)) = ρ_{κ₀,e₀}(g) T for all unitary families g is a
-- multiple of A.
def onesFamily (Φ : Set) : Set := { (τ, complexOne) | τ ∈ Φ }

predicate SpansBranchingMaps (Φ n κ κ0 e e0 A : Set) :=
  ∀ T ∈ matrixSpace(complexRing, weylIndexSet(Φ, n, κ0), weylIndexSet(Φ, succ(n), κ)),
    (∀ g ∈ compactUnitaryFamilies(Φ, n),
      matMul(complexRing, weylIndexSet(Φ, n, κ0), weylIndexSet(Φ, succ(n), κ),
        weylIndexSet(Φ, succ(n), κ), T,
        weylRep(complexRing, Φ, succ(n), κ, e,
          blockScalar(complexRing, Φ, n, g, onesFamily(Φ)))) =
      matMul(complexRing, weylIndexSet(Φ, n, κ0), weylIndexSet(Φ, n, κ0),
        weylIndexSet(Φ, succ(n), κ), weylRep(complexRing, Φ, n, κ0, e0, g), T)) →
    ∃ a ∈ complexCarrier,
      T = matSmul(complexRing, weylIndexSet(Φ, n, κ0), weylIndexSet(Φ, succ(n), κ), a, A)

-- The hypotheses of exists_branching_matrix: κ = γ + κ′,
-- κ₀(h) = κ′(h) + γ(h + 1) for 0 < h < n, κ′(i) = 0 for i < q, and
-- e₀ = e + κ′(n).
predicate BranchingData (Φ n q κ κ0 γ κ2 e e0 : Set) :=
  (κ : Φ × ℕ → ℕ) ∧ (κ0 : Φ × ℕ → ℕ) ∧ (γ : Φ × ℕ → ℕ) ∧ (κ2 : Φ × ℕ → ℕ) ∧
  (e : Φ → ℤ) ∧ (e0 : Φ → ℤ) ∧ q ∈ ℕ ∧
  (∀ x ∈ Φ × ℕ, κ(x) = add(γ(x), κ2(x))) ∧
  (∀ τ ∈ Φ, ∀ h ∈ n, h ≠ 0 → κ0((τ, h)) = add(κ2((τ, h)), γ((τ, succ(h))))) ∧
  (∀ τ ∈ Φ, ∀ i ∈ q, κ2((τ, i)) = 0) ∧
  (∀ τ ∈ Φ, e0(τ) = integerAddValue(e(τ), integerOfNat(κ2((τ, n)))))

-- s_τ^{λ_γ(τ, 0) + e_τ}, λ_γ the diagram weight of γ in rank n + 1.
def branchingScalarFactors (R Φ n γ e s : Set) : Set :=
  { (τ, ringIntPow(R, s(τ), integerAddValue(integerOfNat(diagramWeight(Φ, succ(n), γ)((τ, 0))),
      e(τ)))) | τ ∈ Φ }

-- Σ_τ Σ_{q≤h<n} h κ₀(τ, h).
def branchingTerm (q κ0 x : Set) : Set :=
  ⋃({ k ∈ ℕ | (q ⊆ snd(x) ∧ k = mul(snd(x), κ0(x))) ∨ (¬(q ⊆ snd(x)) ∧ k = 0) })

def branchingTerms (Φ n q κ0 : Set) : Set := { (x, branchingTerm(q, κ0, x)) | x ∈ Φ × n }

def branchingSize (Φ n q κ0 : Set) : Set := natSum(Φ × n, branchingTerms(Φ, n, q, κ0))

-- Branching.lean, exists_branching_matrix (branching from rank n + 1 to n):
-- some integer matrix br has br ρ_{κ,e}(diag(g, s)) =
-- ∏_τ s_τ^{λ_γ(τ,0)+e_τ} ρ_{κ₀,e₀}(g) br over fields of characteristic 0,
-- ‖br ξ‖² ≤ (L^{3L})² ‖ξ‖² whenever Σ_τ Σ_{q≤h<n} h κ₀(τ, h) ≤ L, and br
-- spans the branching maps.
theorem branchingMatrix.exists (Φ n q κ κ0 γ κ2 e e0 : Set)
  requires finiteΦ : Finite(Φ)
  requires natural : n ∈ ℕ
  requires data : BranchingData(Φ, n, q, κ, κ0, γ, κ2, e, e0)
  shows ∃ br ∈ matrixSpace(integerRing, weylIndexSet(Φ, n, κ0), weylIndexSet(Φ, succ(n), κ)),
    (∀ R, CharZeroField(R) → ∀ g ∈ invertibleFamilies(R, Φ, n),
      ∀ s ∈ functionSpace(Φ, ringUnits(R)),
        matMul(R, weylIndexSet(Φ, n, κ0), weylIndexSet(Φ, succ(n), κ),
          weylIndexSet(Φ, succ(n), κ),
          intMatrixIn(R, weylIndexSet(Φ, n, κ0), weylIndexSet(Φ, succ(n), κ), br),
          weylRep(R, Φ, succ(n), κ, e, blockScalar(R, Φ, n, g, s))) =
        matSmul(R, weylIndexSet(Φ, n, κ0), weylIndexSet(Φ, succ(n), κ),
          ringProductOver(R, Φ, branchingScalarFactors(R, Φ, n, γ, e, s)),
          matMul(R, weylIndexSet(Φ, n, κ0), weylIndexSet(Φ, n, κ0),
            weylIndexSet(Φ, succ(n), κ), weylRep(R, Φ, n, κ0, e0, g),
            intMatrixIn(R, weylIndexSet(Φ, n, κ0), weylIndexSet(Φ, succ(n), κ), br)))) ∧
    (∀ L ∈ ℕ, branchingSize(Φ, n, q, κ0) ⊆ L →
      ∀ ξ ∈ functionSpace(weylIndexSet(Φ, succ(n), κ), complexCarrier),
        RealLe(schurNormSq(Φ, n, κ0, mulVec(complexRing, weylIndexSet(Φ, n, κ0),
            weylIndexSet(Φ, succ(n), κ),
            intMatrixIn(complexRing, weylIndexSet(Φ, n, κ0), weylIndexSet(Φ, succ(n), κ), br), ξ)),
          realMul(realNat(pow(pow(L, mul(3, L)), 2)), schurNormSq(Φ, succ(n), κ, ξ)))) ∧
    SpansBranchingMaps(Φ, n, κ, κ0, e, e0,
      intMatrixIn(complexRing, weylIndexSet(Φ, n, κ0), weylIndexSet(Φ, succ(n), κ), br))
proof
  sorry

end Branching
