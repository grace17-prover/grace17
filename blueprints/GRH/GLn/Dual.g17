-- Duals of Weyl modules: the integral isometric Cartan component
-- Δ_l → Δ_kp ⊗ Δ_km of a Weyl lattice tensor a dual Weyl lattice
-- (l(τ, i) = kp(τ, i) + km(τ, n − i)), columns below a rank and the
-- product of Schur matrices, and the invariant integral pairing between
-- the weights with Harish-Chandra parameters l and −l.
-- Source: grh-compact/src/Lib/GLn/Dual/MixedCartan.lean (mixedWeight,
-- PolyRep.MixedCartanEmbedding, nonempty_mixedCartanEmbedding, mixedCartan),
-- Dual/ClassSum.lean (HasColumnsBelow, HasColumnsBelow.schur_mul_schur),
-- Dual/DualWeights.lean (exists_dual_pairing_of_isHCParam).
-- Not stated: ClassSum.lean's cartanProduct and its laws (built from a left
-- inverse chosen from mixedCartan) and its class-sum lemmas (map_classSum,
-- classSum_comm, classSum_le_card_mul_sq, …); the clause of
-- exists_dual_pairing_of_isHCParam on the matrix coefficients ofAlgForm of
-- algebraic forms (it needs SchurOrthogonality's ofAlgForm).
-- Encoding. The source's mixedCartan (a chosen element of the nonempty
-- type MixedCartanEmbedding) is replaced by the predicate
-- IsMixedCartanEmbedding on an integer matrix M with an integer left
-- inverse M′, and its existence. Tensor products of index sets are
-- products W_kp × W_km; A ⊗ B is the Kronecker product kronMatrix and
-- v ⊗ w the vector (i, j) ↦ v_i w_j.
-- Part of the GRH blueprint (layer 4, Lib/GLn, stage S5).
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.GLn.Dual
import GRH.GLn.Branching

section Dual
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)

-- Section: Kronecker products
def kronMatrix (R m1 k1 m2 k2 A B : Set) : Set :=
  { (q, call2(Ring.mul(R), A((fst(fst(q)), fst(snd(q)))), B((snd(fst(q)), snd(snd(q)))))) |
    q ∈ (m1 × m2) × (k1 × k2) }

def kronVector (R m1 m2 v w : Set) : Set :=
  { (q, call2(Ring.mul(R), v(fst(q)), w(snd(q)))) | q ∈ m1 × m2 }

-- Section: The Cartan component
-- MixedCartan.lean, mixedWeight n kp km: (τ, i) ↦ kp(τ, i) + km(τ, n − i).
def mixedWeight (n kp km : Set) : Set :=
  { (x, add(kp(x), km((fst(x), sub(n, snd(x)))))) | x ∈ domain(kp) }

-- MixedCartan.lean, PolyRep.MixedCartanEmbedding n kp km l: an integer
-- matrix M : Δ_l → Δ_kp ⊗ Δ_km with integer left inverse M′, with
-- Mᵀ(G_kp ⊗ G_km)M = G_l, sending ev₁ to ev₁ ⊗ ev_{w₀} (w₀ the reversal) and
-- intertwining ρ_{l, −Σ_{0<i<n} km}(g) with S_kp(g) ⊗ S_km(g^{−T}) over
-- fields of characteristic 0.
predicate IsMixedCartanEmbedding (Φ n kp km l M M2 : Set) :=
  M ∈ matrixSpace(integerRing, weylIndexSet(Φ, n, kp) × weylIndexSet(Φ, n, km),
    weylIndexSet(Φ, n, l)) ∧
  M2 ∈ matrixSpace(integerRing, weylIndexSet(Φ, n, l),
    weylIndexSet(Φ, n, kp) × weylIndexSet(Φ, n, km)) ∧
  matMul(integerRing, weylIndexSet(Φ, n, l), weylIndexSet(Φ, n, kp) × weylIndexSet(Φ, n, km),
    weylIndexSet(Φ, n, l), M2, M) = matOne(integerRing, weylIndexSet(Φ, n, l)) ∧
  matMul(integerRing, weylIndexSet(Φ, n, l), weylIndexSet(Φ, n, kp) × weylIndexSet(Φ, n, km),
    weylIndexSet(Φ, n, l),
    matTranspose(integerRing, weylIndexSet(Φ, n, kp) × weylIndexSet(Φ, n, km),
      weylIndexSet(Φ, n, l), M),
    matMul(integerRing, weylIndexSet(Φ, n, kp) × weylIndexSet(Φ, n, km),
      weylIndexSet(Φ, n, kp) × weylIndexSet(Φ, n, km), weylIndexSet(Φ, n, l),
      kronMatrix(integerRing, weylIndexSet(Φ, n, kp), weylIndexSet(Φ, n, kp),
        weylIndexSet(Φ, n, km), weylIndexSet(Φ, n, km), weylGram(Φ, n, kp), weylGram(Φ, n, km)),
      M)) = weylGram(Φ, n, l) ∧
  ∀ R, CharZeroField(R) →
    mulVec(R, weylIndexSet(Φ, n, kp) × weylIndexSet(Φ, n, km), weylIndexSet(Φ, n, l),
      intMatrixIn(R, weylIndexSet(Φ, n, kp) × weylIndexSet(Φ, n, km), weylIndexSet(Φ, n, l), M),
      weylEval(R, Φ, n, l, permArray(R, Φ, n, identityNumbering(Φ, n)))) =
      kronVector(R, weylIndexSet(Φ, n, kp), weylIndexSet(Φ, n, km),
        weylEval(R, Φ, n, kp, permArray(R, Φ, n, identityNumbering(Φ, n))),
        weylEval(R, Φ, n, km, permArray(R, Φ, n, reversedNumbering(Φ, n)))) ∧
    ∀ g ∈ invertibleFamilies(R, Φ, n),
      matMul(R, weylIndexSet(Φ, n, kp) × weylIndexSet(Φ, n, km), weylIndexSet(Φ, n, l),
        weylIndexSet(Φ, n, l),
        intMatrixIn(R, weylIndexSet(Φ, n, kp) × weylIndexSet(Φ, n, km), weylIndexSet(Φ, n, l), M),
        weylRep(R, Φ, n, l, dualExponent(Φ, n, km), g)) =
      matMul(R, weylIndexSet(Φ, n, kp) × weylIndexSet(Φ, n, km),
        weylIndexSet(Φ, n, kp) × weylIndexSet(Φ, n, km), weylIndexSet(Φ, n, l),
        kronMatrix(R, weylIndexSet(Φ, n, kp), weylIndexSet(Φ, n, kp),
          weylIndexSet(Φ, n, km), weylIndexSet(Φ, n, km), schurMatrix(R, Φ, n, n, kp, g),
          schurMatrix(R, Φ, n, n, km, inverseTransposeFamily(R, Φ, n, g))),
        intMatrixIn(R, weylIndexSet(Φ, n, kp) × weylIndexSet(Φ, n, km), weylIndexSet(Φ, n, l), M))

-- MixedCartan.lean, nonempty_mixedCartanEmbedding (duality for Weyl
-- lattices; the source's mixedCartan is a chosen one): an embedding exists
-- for l = mixedWeight n kp km.
theorem mixedCartan.exists (Φ n kp km : Set)
  requires finiteΦ : Finite(Φ)
  requires natural : n ∈ ℕ
  requires countsP : (kp : Φ × ℕ → ℕ)
  requires countsM : (km : Φ × ℕ → ℕ)
  shows ∃ M, ∃ M2, IsMixedCartanEmbedding(Φ, n, kp, km, mixedWeight(n, kp, km), M, M2)
proof
  sorry

-- Section: Columns below a rank
-- ClassSum.lean, HasColumnsBelow n N kp: FitsRanks N n kp and
-- schurDetExp N n kp = 0.
def zeroExponents (Φ : Set) : Set := { (τ, 0) | τ ∈ Φ }

predicate HasColumnsBelow (Φ n N kp : Set) :=
  FitsRanks(Φ, N, n, kp) ∧ schurDetExp(Φ, N, n, kp) = zeroExponents(Φ)

-- ClassSum.lean, HasColumnsBelow.schur_mul_schur: S_kp(A)S_kp(B) = S_kp(AB)
-- for A_τ of size n × N and square B_τ of size N.
theorem HasColumnsBelow.schur_mul (R Φ n N kp A B : Set)
  requires ring : CommRing(R)
  requires finiteΦ : Finite(Φ)
  requires natural : n ∈ ℕ
  requires natural2 : N ∈ ℕ
  requires counts : (kp : Φ × ℕ → ℕ)
  requires below : HasColumnsBelow(Φ, n, N, kp)
  requires hA : A ∈ matrixFamilies(R, Φ, n, N)
  requires hB : B ∈ matrixFamilies(R, Φ, N, N)
  shows matMul(R, weylIndexSet(Φ, n, kp), weylIndexSet(Φ, N, kp), weylIndexSet(Φ, N, kp),
      schurMatrix(R, Φ, N, n, kp, A), schurMatrix(R, Φ, N, N, kp, B)) =
    schurMatrix(R, Φ, N, n, kp, familyMatMul(R, Φ, n, N, N, A, B))
proof
  sorry

-- Section: Dual weights
-- −l, entrywise.
def negParamAt (n lw : Set) : Set := { (i, integerNegValue(lw(i))) | i ∈ n }

def negParam (Φ n l : Set) : Set := { (w, negParamAt(n, l(w))) | w ∈ Φ }

-- DualWeights.lean, exists_dual_pairing_of_isHCParam (without the clause on
-- ofAlgForm): for weights (κ, e), (κ′, e′) with parameters l and −l some
-- integer matrix A gives an invariant pairing v′ · A v (ρ′(g)v′ · Aρ(g)v =
-- v′ · Av over fields of characteristic 0), some integer C has CA =
-- hookNumber(κ′) · 1 on ℂ, and each v′ ↦ u · Av is ⟨v′, u⟩ for a v′ of
-- the same Gram norm as v.
theorem dualPairing.exists (E Φ n κ κ2 e e2 l : Set)
  requires finiteΦ : Finite(Φ)
  requires natural : n ∈ ℕ
  requires nonempty : n ≠ 0
  requires counts : (κ : Φ × ℕ → ℕ)
  requires counts2 : (κ2 : Φ × ℕ → ℕ)
  requires exps : (e : Φ → ℤ)
  requires exps2 : (e2 : Φ → ℤ)
  requires param : IsHCParam(Φ, n, κ, e, l)
  requires param2 : IsHCParam(Φ, n, κ2, e2, negParam(Φ, n, l))
  shows ∃ A ∈ matrixSpace(integerRing, weylIndexSet(Φ, n, κ2), weylIndexSet(Φ, n, κ)),
    (∀ R, CharZeroField(R) → ∀ g ∈ invertibleFamilies(R, Φ, n),
      ∀ v2 ∈ functionSpace(weylIndexSet(Φ, n, κ2), Ring.carrier(R)),
      ∀ v ∈ functionSpace(weylIndexSet(Φ, n, κ), Ring.carrier(R)),
        vecDot(R, weylIndexSet(Φ, n, κ2),
          mulVec(R, weylIndexSet(Φ, n, κ2), weylIndexSet(Φ, n, κ2),
            weylRep(R, Φ, n, κ2, e2, g), v2),
          mulVec(R, weylIndexSet(Φ, n, κ2), weylIndexSet(Φ, n, κ),
            intMatrixIn(R, weylIndexSet(Φ, n, κ2), weylIndexSet(Φ, n, κ), A),
            mulVec(R, weylIndexSet(Φ, n, κ), weylIndexSet(Φ, n, κ),
              weylRep(R, Φ, n, κ, e, g), v))) =
        vecDot(R, weylIndexSet(Φ, n, κ2), v2,
          mulVec(R, weylIndexSet(Φ, n, κ2), weylIndexSet(Φ, n, κ),
            intMatrixIn(R, weylIndexSet(Φ, n, κ2), weylIndexSet(Φ, n, κ), A), v))) ∧
    (∃ C ∈ matrixSpace(integerRing, weylIndexSet(Φ, n, κ), weylIndexSet(Φ, n, κ2)),
      matMul(complexRing, weylIndexSet(Φ, n, κ), weylIndexSet(Φ, n, κ2), weylIndexSet(Φ, n, κ),
        intMatrixIn(complexRing, weylIndexSet(Φ, n, κ), weylIndexSet(Φ, n, κ2), C),
        intMatrixIn(complexRing, weylIndexSet(Φ, n, κ2), weylIndexSet(Φ, n, κ), A)) =
        matScalar(complexRing, weylIndexSet(Φ, n, κ),
          intCastMap(complexRing)(hookNumber(Φ, n, κ2)))) ∧
    ∀ v ∈ functionSpace(weylIndexSet(Φ, n, κ), complexCarrier),
      ∃ v2 ∈ functionSpace(weylIndexSet(Φ, n, κ2), complexCarrier),
        schurNormSq(Φ, n, κ2, v2) = schurNormSq(Φ, n, κ, v) ∧
        ∀ u ∈ functionSpace(weylIndexSet(Φ, n, κ2), complexCarrier),
          vecDot(complexRing, weylIndexSet(Φ, n, κ2), u,
            mulVec(complexRing, weylIndexSet(Φ, n, κ2), weylIndexSet(Φ, n, κ),
              intMatrixIn(complexRing, weylIndexSet(Φ, n, κ2), weylIndexSet(Φ, n, κ), A), v)) =
          gramForm(schurWeightDatum(E, Φ, n, κ2, e2), v2, u)
proof
  sorry

end Dual
