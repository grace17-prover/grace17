-- The standard basis theorem for Schur (dual Weyl) modules over any ring
-- and its consequences: the minor products b_i are linearly independent
-- and span the Borel semi-invariants of the diagram weight; the Schur
-- matrix S_κ(z) exists under FitsRanks, is multiplicative, commutes with
-- base change and splits over the places; its value at diagonal matrices
-- and Weyl's character formula; integrality of coordinates; the Gram
-- matrix of the kernel f(yᵀx) is symmetric, positive definite, adjoint
-- for S_κ(g) and S_κ(gᵀ), and inverse to the Fock pairing up to the hook
-- number; the hook number is positive and at most L^{3L}; evaluation
-- vectors transform by S_κ.
-- Source: grh-compact/src/Lib/GLn/SchurModule/MinorBasis.lean
-- (PolyRep.exists_minorProduct_basis), SchurMatrix.lean
-- (linearIndependent_nablaBasis, span_nablaBasis,
-- PolyRep.linearIndependent_nablaBasis_mul_detPow,
-- nabla_le_span_nablaBasis_mul_detPow, PolyRep.coord_mem_of_coeff_mem,
-- weyl_character, schur_diagonal, sum_schur_smul_nablaBasis, schur_map,
-- schur_mul_left, schur_mul_right, schur_apply_eq_prod, schur_one,
-- schur_smul), Nabla.lean (minor_mem_nabla, fockPairing_rowSubst,
-- fockPairing_star_self_pos, diagramWeight_apply), Gram.lean
-- (weylKernel_symm, eval_toPoly, toPoly_weylEval, fockPairing_toPoly_nablaBasis,
-- weylGram_isSymm, weylGram_mul_fockPairing, weylGram_mul_schur,
-- weylGram_posDef, range_toPoly), Hook.lean (sum_tableauWeight,
-- sum_tableauWeight_le, schur_mulVec_weylEval, hookNumber_pos,
-- hookNumber_le), SchurContinuous.lean (continuous_schur).
-- Not stated: the internal steps of the basis theorem (Bordering.lean,
-- Interlacing.lean: column orders, row expansions, interlacing and
-- bordering), Hook.lean's map_nablaBasis_eq_mul_weylEval and
-- schur_one_row_eq_symPowMatrix, and Gram.lean's
-- PolyRep.weylGram_eq_submatrix (relabelling the places).
-- Encoding. See GRH.GLn.Tableaux. Statements over "every commutative
-- ring" quantify over ring records R with CommRing(R). A family of
-- matrices is a function on Φ; familyMul multiplies placewise.
-- Part of the GRH blueprint (layer 4, Lib/GLn, stage S2).
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.GLn.SchurModule
import GRH.GLn.Tableaux

section SchurModule
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)

-- Complex conjugation as a function on ℂ.
def complexConjMap : Set := { (z, complexConj(z)) | z ∈ complexCarrier }

-- Section: Families of matrices
-- Placewise products, maps, transposes and diagonal families.
def familyMatMul (R Φ m k l g z : Set) : Set := { (τ, matMul(R, m, k, l, g(τ), z(τ))) | τ ∈ Φ }

def familyMatMap (S Φ m k f z : Set) : Set := { (τ, matMap(S, m, k, f, z(τ))) | τ ∈ Φ }

def familyTranspose (R Φ m k z : Set) : Set := { (τ, matTranspose(R, m, k, z(τ))) | τ ∈ Φ }

def familyDiagonal (R Φ n x : Set) : Set := { (τ, matDiagonal(R, n, x(τ))) | τ ∈ Φ }

def familyOne (R Φ n : Set) : Set := { (τ, matOne(R, n)) | τ ∈ Φ }

-- Families of matrices over R of size m × k at each place.
def matrixFamilies (R Φ m k : Set) : Set := functionSpace(Φ, matrixSpace(R, m, k))

-- ∏_τ det(g_τ)^{e_τ} in R.
def familyDetFactors (R Φ n g e : Set) : Set :=
  { (τ, Ring.pow(R, matDet(R, n, g(τ)), e(τ))) | τ ∈ Φ }

def familyDetPow (R Φ n g e : Set) : Set := ringProductOver(R, Φ, familyDetFactors(R, Φ, n, g, e))

-- c·A for a scalar c.
def scaleMatrix (R m k c A : Set) : Set := matSmul(R, m, k, c, A)

-- Section: The standard basis theorem
-- SchurMatrix.lean, PolyRep.linearIndependent_nablaBasis_mul_detPow (and
-- linearIndependent_nablaBasis for e = 0; MinorBasis.lean,
-- PolyRep.exists_minorProduct_basis): over every commutative ring the
-- b_i · D_e are linearly independent.
theorem nablaBasis.independent (R Φ n κ e c : Set)
  requires ring : CommRing(R)
  requires finiteΦ : Finite(Φ)
  requires finite : Finite(n)
  requires rows : n ⊆ ℕ
  requires counts : (κ : Φ × ℕ → ℕ)
  requires exps : (e : Φ → ℕ)
  requires hc : c ∈ functionSpace(weylIndexSet(Φ, n, κ), Ring.carrier(R))
  requires zero : basisExpansion(R, Φ, n, κ, detPow(R, Φ, n, e), c) =
    Ring.zero(rowPolyRing(R, Φ, n))
  shows ∀ j ∈ weylIndexSet(Φ, n, κ), c(j) = Ring.zero(R)
proof
  sorry

-- The diagram weight of κ raised by e_τ on the first N columns at τ.
def firstColumns (N i : Set) : Set := ⋃({ k ∈ 2 | (i ∈ N ∧ k = 1) ∨ (i ∉ N ∧ k = 0) })

def raisedWeight (Φ N κ e : Set) : Set :=
  { (x, add(diagramWeight(Φ, N, κ)(x), mul(e(fst(x)), firstColumns(N, snd(x))))) | x ∈ Φ × ℕ }

-- SchurMatrix.lean, span_nablaBasis and nabla_le_span_nablaBasis_mul_detPow:
-- the semi-invariants of the weight raised by e are exactly the
-- combinations Σ_j c_j b_j D_e (for e = 0: span_nablaBasis).
theorem nablaBasis.span (R Φ n κ e f : Set)
  requires ring : CommRing(R)
  requires finiteΦ : Finite(Φ)
  requires finite : Finite(n)
  requires rows : n ⊆ ℕ
  requires counts : (κ : Φ × ℕ → ℕ)
  requires exps : (e : Φ → ℕ)
  shows BorelSemiInvariant(R, Φ, n, raisedWeight(Φ, cardinality(n), κ, e), f) ↔
    (∃ c ∈ functionSpace(weylIndexSet(Φ, n, κ), Ring.carrier(R)),
      f = basisExpansion(R, Φ, n, κ, detPow(R, Φ, n, e), c))
proof
  sorry

-- SchurMatrix.lean, PolyRep.coord_mem_of_coeff_mem: if f = Σ_j c_j b_j D_e
-- has all coefficients in an additive subgroup A of R, so has c.
theorem nablaBasis.coord_mem (R Φ n κ e c A : Set)
  requires ring : CommRing(R)
  requires finiteΦ : Finite(Φ)
  requires finite : Finite(n)
  requires rows : n ⊆ ℕ
  requires counts : (κ : Φ × ℕ → ℕ)
  requires exps : (e : Φ → ℕ)
  requires hc : c ∈ functionSpace(weylIndexSet(Φ, n, κ), Ring.carrier(R))
  requires subgroup : Subgroup(A, Ring.additive(R))
  requires coeffs : ∀ m ∈ monomials(rowVars(Φ, n)),
    basisExpansion(R, Φ, n, κ, detPow(R, Φ, n, e), c)(m) ∈ A
  shows ∀ j ∈ weylIndexSet(Φ, n, κ), c(j) ∈ A
proof
  sorry

-- Nabla.lean, minor_mem_nabla: a minor on rows of one colour τ and the
-- first h columns is semi-invariant of weight 1 at (τ, i), i < h.
def minorWeightValue (τ h x : Set) : Set :=
  ⋃({ k ∈ 2 | ((fst(x) = τ ∧ snd(x) ∈ h) ∧ k = 1) ∨ (¬(fst(x) = τ ∧ snd(x) ∈ h) ∧ k = 0) })

def minorWeight (Φ τ h : Set) : Set := { (x, minorWeightValue(τ, h, x)) | x ∈ Φ × ℕ }

theorem rowMinor.semi_invariant (R Φ n τ I : Set) (h : Nat)
  requires ring : CommRing(R)
  requires place : τ ∈ Φ
  requires rowsI : (I : h → n)
  shows BorelSemiInvariant(R, Φ, n, minorWeight(Φ, τ, h),
    rowMinor(R, Φ, n, τ, h, I))
proof
  sorry

-- Section: The Schur matrix
-- SchurMatrix.lean, sum_schur_smul_nablaBasis: under FitsRanks, row i′ of
-- S_κ(z) expands b′_{i′}(zy) = Σ_j S_κ(z)_{i′j} b_j(y) D(y), D the
-- determinant powers of schurDetExp; the coefficients are unique.
theorem schurMatrix.expansion (R Φ n n2 κ z i2 : Set)
  requires ring : CommRing(R)
  requires finiteΦ : Finite(Φ)
  requires rows : n ⊆ ℕ
  requires rows2 : n2 ⊆ ℕ
  requires finite : Finite(n)
  requires finite2 : Finite(n2)
  requires counts : (κ : Φ × ℕ → ℕ)
  requires fits : FitsRanks(Φ, n, n2, κ)
  requires hz : z ∈ matrixFamilies(R, Φ, n2, n)
  requires hi : i2 ∈ weylIndexSet(Φ, n2, κ)
  shows schurRow(R, Φ, n, n2, κ, z, i2) ∈
      functionSpace(weylIndexSet(Φ, n, κ), Ring.carrier(R)) ∧
    basisExpansion(R, Φ, n, κ, detPow(R, Φ, n, schurDetExp(Φ, n, n2, κ)),
      schurRow(R, Φ, n, n2, κ, z, i2)) =
      rowSubst(R, Φ, n, n2, z)(nablaBasis(R, Φ, n2, κ, i2)) ∧
    schurMatrix(R, Φ, n, n2, κ, z) ∈
      matrixSpace(R, weylIndexSet(Φ, n2, κ), weylIndexSet(Φ, n, κ))
proof
  sorry

-- SchurMatrix.lean, schur_map (base change): S_κ(φ(z)) = φ(S_κ(z)) for a
-- ring homomorphism φ.
theorem schurMatrix.map (R S Φ n n2 κ z φ : Set)
  requires ring : CommRing(R)
  requires ring2 : CommRing(S)
  requires hom : RingHom(φ, R, S)
  requires finiteΦ : Finite(Φ)
  requires rows : n ⊆ ℕ
  requires rows2 : n2 ⊆ ℕ
  requires finite : Finite(n)
  requires finite2 : Finite(n2)
  requires counts : (κ : Φ × ℕ → ℕ)
  requires fits : FitsRanks(Φ, n, n2, κ)
  requires hz : z ∈ matrixFamilies(R, Φ, n2, n)
  shows schurMatrix(S, Φ, n, n2, κ, familyMatMap(S, Φ, n2, n, φ, z)) =
    matMap(S, weylIndexSet(Φ, n2, κ), weylIndexSet(Φ, n, κ), φ, schurMatrix(R, Φ, n, n2, κ, z))
proof
  sorry

-- SchurMatrix.lean, schur_mul_left, schur_mul_right and schur_one: under
-- FitsRanks, S_κ(gz) = S_κ(g)S_κ(z) for square g_τ of size n′,
-- S_κ(zg) = ∏_τ det(g_τ)^{d_τ} S_κ(z)S_κ(g) for square g_τ of size n
-- (d = schurDetExp), and S_κ(1) = 1.
theorem schurMatrix.mul (R Φ n n2 κ z g g2 : Set)
  requires ring : CommRing(R)
  requires finiteΦ : Finite(Φ)
  requires rows : n ⊆ ℕ
  requires rows2 : n2 ⊆ ℕ
  requires finite : Finite(n)
  requires finite2 : Finite(n2)
  requires counts : (κ : Φ × ℕ → ℕ)
  requires fits : FitsRanks(Φ, n, n2, κ)
  requires hz : z ∈ matrixFamilies(R, Φ, n2, n)
  requires hg : g ∈ matrixFamilies(R, Φ, n2, n2)
  requires hg2 : g2 ∈ matrixFamilies(R, Φ, n, n)
  shows schurMatrix(R, Φ, n, n2, κ, familyMatMul(R, Φ, n2, n2, n, g, z)) =
      matMul(R, weylIndexSet(Φ, n2, κ), weylIndexSet(Φ, n2, κ), weylIndexSet(Φ, n, κ),
        schurMatrix(R, Φ, n2, n2, κ, g), schurMatrix(R, Φ, n, n2, κ, z)) ∧
    schurMatrix(R, Φ, n, n2, κ, familyMatMul(R, Φ, n2, n, n, z, g2)) =
      scaleMatrix(R, weylIndexSet(Φ, n2, κ), weylIndexSet(Φ, n, κ),
        familyDetPow(R, Φ, n, g2, schurDetExp(Φ, n, n2, κ)),
        matMul(R, weylIndexSet(Φ, n2, κ), weylIndexSet(Φ, n, κ), weylIndexSet(Φ, n, κ),
          schurMatrix(R, Φ, n, n2, κ, z), schurMatrix(R, Φ, n, n, κ, g2))) ∧
    schurMatrix(R, Φ, n, n, κ, familyOne(R, Φ, n)) = matOne(R, weylIndexSet(Φ, n, κ))
proof
  sorry

-- The restriction of a filling to one place τ (as a filling over {τ}).
def placeBoxes (i τ : Set) : Set := { b ∈ domain(i) | fst(b) = τ }

def fillingAt (i τ : Set) : Set := { (b, i(b)) | b ∈ placeBoxes(i, τ) }

def singlePlaceFamily (z τ : Set) : Set := { (τ, z(τ)) }

def placeSchurEntries (R n n2 κ z i2 i : Set) : Set :=
  { (τ, schurMatrix(R, {τ}, n, n2, κ, singlePlaceFamily(z, τ))((fillingAt(i2, τ),
      fillingAt(i, τ)))) | τ ∈ domain(z) }

-- SchurMatrix.lean, schur_apply_eq_prod: under FitsRanks, the (i′, i) entry
-- of S_κ(z) is the product over τ of the entries of the one-place Schur
-- matrices at the restrictions of i′ and i.
theorem schurMatrix.entry_prod (R Φ n n2 κ z i2 i : Set)
  requires ring : CommRing(R)
  requires finiteΦ : Finite(Φ)
  requires rows : n ⊆ ℕ
  requires rows2 : n2 ⊆ ℕ
  requires finite : Finite(n)
  requires finite2 : Finite(n2)
  requires counts : (κ : Φ × ℕ → ℕ)
  requires fits : FitsRanks(Φ, n, n2, κ)
  requires hz : z ∈ matrixFamilies(R, Φ, n2, n)
  requires hi2 : i2 ∈ weylIndexSet(Φ, n2, κ)
  requires hi : i ∈ weylIndexSet(Φ, n, κ)
  shows schurMatrix(R, Φ, n, n2, κ, z)((i2, i)) =
    ringProductOver(R, Φ, placeSchurEntries(R, n, n2, κ, z, i2, i))
proof
  sorry

-- ∏_τ ∏_a x_τ(a)^{tableauWeight i τ a}.
def diagonalWeightFactors (R n x i τ : Set) : Set :=
  { (a, Ring.pow(R, x(τ)(a), tableauWeight(i, τ, a))) | a ∈ n }

def diagonalSchurFactors (R Φ n x i : Set) : Set :=
  { (τ, ringProductOver(R, n, diagonalWeightFactors(R, n, x, i, τ))) | τ ∈ Φ }

def diagonalSchurEntries (R Φ n κ x : Set) : Set :=
  { (i, ringProductOver(R, Φ, diagonalSchurFactors(R, Φ, n, x, i))) | i ∈ weylIndexSet(Φ, n, κ) }

-- SchurMatrix.lean, schur_diagonal: S_κ(diag x) is diagonal with entry
-- ∏_τ ∏_a x_τ(a)^{w}, w the number of entries a of i at τ.
theorem schurMatrix.diagonal (R Φ n κ x : Set)
  requires ring : CommRing(R)
  requires finiteΦ : Finite(Φ)
  requires rows : n ⊆ ℕ
  requires finite : Finite(n)
  requires counts : (κ : Φ × ℕ → ℕ)
  requires hx : x ∈ functionSpace(Φ, functionSpace(n, Ring.carrier(R)))
  shows schurMatrix(R, Φ, n, n, κ, familyDiagonal(R, Φ, n, x)) =
    matDiagonal(R, weylIndexSet(Φ, n, κ), diagonalSchurEntries(R, Φ, n, κ, x))
proof
  sorry

-- The alternant det(x_a^{λ(τ, N−1−j)+j})_{a,j} at one place, and the
-- Vandermonde determinant det(x_a^j).
def alternantMatrix (Φ n κ x τ : Set) : Set :=
  { (q, ℂ[x(τ)(fst(q)) ^ add(diagramWeight(Φ, cardinality(n), κ)((τ,
      sub(sub(cardinality(n), 1), snd(q)))), snd(q))]) | q ∈ n × n }

def vandermondeMatrix (n x τ : Set) : Set := { (q, ℂ[x(τ)(fst(q)) ^ snd(q)]) | q ∈ n × n }

def alternantFactors (Φ n κ x : Set) : Set :=
  { (τ, matDet(complexRing, n, alternantMatrix(Φ, n, κ, x, τ))) | τ ∈ Φ }

def vandermondeFactors (Φ n x : Set) : Set :=
  { (τ, matDet(complexRing, n, vandermondeMatrix(n, x, τ))) | τ ∈ Φ }

-- SchurMatrix.lean, weyl_character (Weyl's character formula over ℂ):
-- tr S_κ(diag x) · ∏_τ det(x_{τ,a}^j) = ∏_τ det(x_{τ,a}^{λ_τ(N−1−j)+j}),
-- λ = diagramWeight (rows n a natural number N).
theorem schurMatrix.weyl_character (Φ n κ x : Set)
  requires finiteΦ : Finite(Φ)
  requires natural : n ∈ ℕ
  requires counts : (κ : Φ × ℕ → ℕ)
  requires hx : x ∈ functionSpace(Φ, functionSpace(n, complexCarrier))
  shows ℂ[matTrace(complexRing, weylIndexSet(Φ, n, κ),
      schurMatrix(complexRing, Φ, n, n, κ, familyDiagonal(complexRing, Φ, n, x))) *
      ringProductOver(complexRing, Φ, vandermondeFactors(Φ, n, x))] =
    ringProductOver(complexRing, Φ, alternantFactors(Φ, n, κ, x))
proof
  sorry

-- Section: Fock pairing, kernel and Gram matrix
-- Nabla.lean, fockPairing_rowSubst: ⟨p(zy), q⟩ = ⟨p, q(zᵀy)⟩ for square
-- z_τ (one row set at every place).
theorem fockPairing.rowSubst (R Φ n z P Q : Set)
  requires ring : CommRing(R)
  requires finiteΦ : Finite(Φ)
  requires finite : Finite(n)
  requires hz : z ∈ matrixFamilies(R, Φ, n, n)
  requires hP : P ∈ Ring.carrier(rowPolyRing(R, Φ, n))
  requires hQ : Q ∈ Ring.carrier(rowPolyRing(R, Φ, n))
  shows fockPairing(R, rowVars(Φ, n), rowSubst(R, Φ, n, n, z)(P), Q) =
    fockPairing(R, rowVars(Φ, n), P, rowSubst(R, Φ, n, n, familyTranspose(R, Φ, n, n, z))(Q))
proof
  sorry

-- Nabla.lean, fockPairing_star_self_pos (over ℂ): ⟨p̄, p⟩ > 0 for p ≠ 0.
theorem fockPairing.conj_self_pos (I P : Set)
  requires hP : P ∈ Ring.carrier(polynomialRing(complexRing, I))
  requires nonzero : P ≠ Ring.zero(polynomialRing(complexRing, I))
  shows complexIm(fockPairing(complexRing, I,
      mvMap(complexRing, complexRing, I, complexConjMap)(P), P)) = realZero ∧
    RealLess(realZero, complexRe(fockPairing(complexRing, I,
      mvMap(complexRing, complexRing, I, complexConjMap)(P), P)))
proof
  sorry

-- Gram.lean, weylGram_isSymm, weylGram_mul_fockPairing and Hook.lean
-- hookNumber_pos: the Gram matrix exists and is symmetric, the hook number
-- is positive, and G · (⟨b_i, b_j⟩)_{ij} = hookNumber · 1 over ℤ.
def fockBasisMatrix (Φ n κ : Set) : Set :=
  { (q, fockPairing(integerRing, rowVars(Φ, n), nablaBasis(integerRing, Φ, n, κ, fst(q)),
      nablaBasis(integerRing, Φ, n, κ, snd(q)))) |
    q ∈ weylIndexSet(Φ, n, κ) × weylIndexSet(Φ, n, κ) }

theorem weylGram.facts (Φ n κ : Set)
  requires finiteΦ : Finite(Φ)
  requires rows : n ⊆ ℕ
  requires finite : Finite(n)
  requires counts : (κ : Φ × ℕ → ℕ)
  shows weylGram(Φ, n, κ) ∈ matrixSpace(integerRing, weylIndexSet(Φ, n, κ),
      weylIndexSet(Φ, n, κ)) ∧
    matTranspose(integerRing, weylIndexSet(Φ, n, κ), weylIndexSet(Φ, n, κ), weylGram(Φ, n, κ)) =
      weylGram(Φ, n, κ) ∧
    hookNumber(Φ, n, κ) ∈ ℤ ∧ IntegerPositive(hookNumber(Φ, n, κ)) ∧
    matMul(integerRing, weylIndexSet(Φ, n, κ), weylIndexSet(Φ, n, κ), weylIndexSet(Φ, n, κ),
      weylGram(Φ, n, κ), fockBasisMatrix(Φ, n, κ)) =
      matScalar(integerRing, weylIndexSet(Φ, n, κ), hookNumber(Φ, n, κ))
proof
  sorry

-- Hook.lean, hookNumber_le: if Σ_τ Σ_{h<N} h κ(τ, h) ≤ L then the hook
-- number is at most L^{3L}.
theorem hookNumber.le (Φ n κ L : Set)
  requires finiteΦ : Finite(Φ)
  requires rows : n ⊆ ℕ
  requires finite : Finite(n)
  requires counts : (κ : Φ × ℕ → ℕ)
  requires hL : L ∈ ℕ
  requires boxes : boxCount(Φ, cardinality(n), κ) ⊆ L
  shows RealLe(realInt(hookNumber(Φ, n, κ)), realNat(pow(L, mul(3, L))))
proof
  sorry

-- Gram.lean, weylGram_posDef: G, as a complex matrix, is positive definite.
theorem weylGram.pos_def (Φ n κ u : Set)
  requires finiteΦ : Finite(Φ)
  requires rows : n ⊆ ℕ
  requires finite : Finite(n)
  requires counts : (κ : Φ × ℕ → ℕ)
  requires hu : u ∈ functionSpace(weylIndexSet(Φ, n, κ), complexCarrier)
  requires nonzero : ∃ i ∈ weylIndexSet(Φ, n, κ), u(i) ≠ complexZero
  shows RealLess(realZero, complexRe(vecDot(complexRing, weylIndexSet(Φ, n, κ),
    vecConj(complexRing, complexConjMap, weylIndexSet(Φ, n, κ), u),
    mulVec(complexRing, weylIndexSet(Φ, n, κ), weylIndexSet(Φ, n, κ),
      weylGramOver(complexRing, Φ, n, κ), u))))
proof
  sorry

-- Gram.lean, weylGram_mul_schur: over a domain of characteristic zero,
-- G S_κ(g) = S_κ(gᵀ)ᵀ G for square g_τ.
theorem weylGram.mul_schur (R Φ n κ g : Set)
  requires ring : CommRing(R)
  requires domain : IntegralDomain(R)
  requires charZero : ∀ k ∈ ℕ, k ≠ (0:N) → natCast(R, k) ≠ Ring.zero(R)
  requires finiteΦ : Finite(Φ)
  requires rows : n ⊆ ℕ
  requires finite : Finite(n)
  requires counts : (κ : Φ × ℕ → ℕ)
  requires hg : g ∈ matrixFamilies(R, Φ, n, n)
  shows matMul(R, weylIndexSet(Φ, n, κ), weylIndexSet(Φ, n, κ), weylIndexSet(Φ, n, κ),
      weylGramOver(R, Φ, n, κ), schurMatrix(R, Φ, n, n, κ, g)) =
    matMul(R, weylIndexSet(Φ, n, κ), weylIndexSet(Φ, n, κ), weylIndexSet(Φ, n, κ),
      matTranspose(R, weylIndexSet(Φ, n, κ), weylIndexSet(Φ, n, κ),
        schurMatrix(R, Φ, n, n, κ, familyTranspose(R, Φ, n, n, g))),
      weylGramOver(R, Φ, n, κ))
proof
  sorry

-- Gram.lean, eval_toPoly and toPoly_weylEval: toPoly(ξ)(y) = ev_yᵀ G ξ,
-- and the polynomial of ev_y is the kernel x ↦ f(yᵀx).
def kernelSpecValue (R Φ n y w : Set) : Set :=
  ⋃({ P ∈ Ring.carrier(rowPolyRing(R, Φ, n)) |
    (fst(w) = 0 ∧ P = X(R, rowVars(Φ, n), snd(w))) ∨
    (fst(w) ≠ 0 ∧ P = mvC(R, rowVars(Φ, n), y(snd(w)))) })

def kernelSpec (R Φ n y : Set) : Set :=
  { (w, kernelSpecValue(R, Φ, n, y, w)) | w ∈ doubledVars(Φ, n) }

def kernelAt (R Φ n κ y : Set) : Set :=
  mvBind(R, doubledVars(Φ, n), rowVars(Φ, n), kernelSpec(R, Φ, n, y))(weylKernel(R, Φ, n, κ))

theorem toPoly.eval (R Φ n κ ξ y : Set)
  requires ring : CommRing(R)
  requires finiteΦ : Finite(Φ)
  requires rows : n ⊆ ℕ
  requires finite : Finite(n)
  requires counts : (κ : Φ × ℕ → ℕ)
  requires hξ : ξ ∈ functionSpace(weylIndexSet(Φ, n, κ), Ring.carrier(R))
  requires hy : y ∈ functionSpace(rowVars(Φ, n), Ring.carrier(R))
  shows evaluationAt(R, rowVars(Φ, n), y)(toPoly(R, Φ, n, κ, ξ)) =
      vecDot(R, weylIndexSet(Φ, n, κ), weylEval(R, Φ, n, κ, y),
        mulVec(R, weylIndexSet(Φ, n, κ), weylIndexSet(Φ, n, κ), weylGramOver(R, Φ, n, κ), ξ)) ∧
    toPoly(R, Φ, n, κ, weylEval(R, Φ, n, κ, y)) = kernelAt(R, Φ, n, κ, y)
proof
  sorry

-- Gram.lean, range_toPoly (over ℂ): the polynomials Σ_i (Gξ)_i b_i are
-- exactly the semi-invariants of the diagram weight.
theorem toPoly.range (Φ n κ f : Set)
  requires finiteΦ : Finite(Φ)
  requires rows : n ⊆ ℕ
  requires finite : Finite(n)
  requires counts : (κ : Φ × ℕ → ℕ)
  shows f ∈ nablaModuleSet(complexRing, Φ, n, κ) ↔
    (∃ ξ ∈ functionSpace(weylIndexSet(Φ, n, κ), complexCarrier), f = toPoly(complexRing, Φ, n, κ, ξ))
proof
  sorry

-- Section: Evaluation vectors and tableau weights
-- The block y_τ of the first N columns of an array y, and zy.
def squareBlock (n y τ : Set) : Set := { (q, y(((τ, fst(q)), snd(q)))) | q ∈ n × n }

def squarePart (Φ n y : Set) : Set := { (τ, squareBlock(n, y, τ)) | τ ∈ Φ }

def substRow (n z v : Set) : Set := { (a, z(fst(fst(v)))((snd(fst(v)), a))) | a ∈ n }

def arrayColumn (n y v : Set) : Set := { (a, y(((fst(fst(v)), a), snd(v)))) | a ∈ n }

def arrayRowSubst (R Φ n n2 z y : Set) : Set :=
  { (v, vecDot(R, n, substRow(n, z, v), arrayColumn(n, y, v))) | v ∈ rowVars(Φ, n2) }

-- Hook.lean, schur_mulVec_weylEval: under FitsRanks,
-- ∏_τ det(y_τ)^{d_τ} S_κ(z) ev_y = ev_{zy}.
theorem schurMatrix.mulVec_weylEval (R Φ n n2 κ z y : Set)
  requires ring : CommRing(R)
  requires finiteΦ : Finite(Φ)
  requires rows : n ⊆ ℕ
  requires rows2 : n2 ⊆ ℕ
  requires finite : Finite(n)
  requires finite2 : Finite(n2)
  requires counts : (κ : Φ × ℕ → ℕ)
  requires fits : FitsRanks(Φ, n, n2, κ)
  requires hz : z ∈ matrixFamilies(R, Φ, n2, n)
  requires hy : y ∈ functionSpace(rowVars(Φ, n), Ring.carrier(R))
  shows vecSmul(R, weylIndexSet(Φ, n2, κ),
      familyDetPow(R, Φ, n, squarePart(Φ, n, y), schurDetExp(Φ, n, n2, κ)),
      mulVec(R, weylIndexSet(Φ, n2, κ), weylIndexSet(Φ, n, κ), schurMatrix(R, Φ, n, n2, κ, z),
        weylEval(R, Φ, n, κ, y))) =
    weylEval(R, Φ, n2, κ, arrayRowSubst(R, Φ, n, n2, z, y))
proof
  sorry

-- Hook.lean, sum_tableauWeight and sum_tableauWeight_le: the entries of i
-- at τ number Σ_{h<N} h κ(τ, h); those lying in a set A of rows number at
-- most Σ_{j<|A|} λ(τ, j), λ = diagramWeight.
def tableauWeightMap (i τ A : Set) : Set := { (a, tableauWeight(i, τ, a)) | a ∈ A }

def heightWeights (κ τ : Set) : Set := { (h, mul(h, κ((τ, h)))) | h ∈ ℕ }

def lambdaWeights (Φ N κ τ : Set) : Set := { (j, diagramWeight(Φ, N, κ)((τ, j))) | j ∈ ℕ }

theorem tableauWeight.sum (Φ n κ i τ A : Set)
  requires finiteΦ : Finite(Φ)
  requires rows : n ⊆ ℕ
  requires finite : Finite(n)
  requires counts : (κ : Φ × ℕ → ℕ)
  requires hi : i ∈ weylIndexSet(Φ, n, κ)
  requires place : τ ∈ Φ
  requires sub : A ⊆ n
  shows natSum(n, tableauWeightMap(i, τ, n)) =
      natSum(cardinality(n), heightWeights(κ, τ)) ∧
    (natSum(A, tableauWeightMap(i, τ, A)):N) ≤
      natSum(cardinality(A), lambdaWeights(Φ, cardinality(n), κ, τ))
proof
  sorry

-- Section: Continuity
-- SchurContinuous.lean, continuous_schur (over ℂ): each entry of S_κ(g) is
-- a continuous function of the entries of g.
def schurEntryFunction (Φ n κ q : Set) : Set :=
  { (g, schurMatrix(complexRing, Φ, n, n, κ, g)(q)) | g ∈ matrixFamilies(complexRing, Φ, n, n) }

theorem schurMatrix.continuous (Φ n κ q : Set)
  requires finiteΦ : Finite(Φ)
  requires rows : n ⊆ ℕ
  requires finite : Finite(n)
  requires counts : (κ : Φ × ℕ → ℕ)
  requires hq : q ∈ weylIndexSet(Φ, n, κ) × weylIndexSet(Φ, n, κ)
  shows ∀ g ∈ matrixFamilies(complexRing, Φ, n, n), ∀ ε ∈ ℝ, RealLess(realZero, ε) →
    ∃ δ ∈ ℝ, RealLess(realZero, δ) ∧ ∀ h ∈ matrixFamilies(complexRing, Φ, n, n),
      (∀ τ ∈ Φ, ∀ p ∈ n × n, RealLess(complexAbs(ℂ[h(τ)(p) - g(τ)(p)]), δ)) →
        RealLess(complexAbs(ℂ[schurEntryFunction(Φ, n, κ, q)(h) -
          schurEntryFunction(Φ, n, κ, q)(g)]), ε)
proof
  sorry

end SchurModule
