-- Determinants of square matrices on any finite index set, as Cumulus's
-- Leibniz determinant: multiplicativity, transpose and conjugate
-- transpose, diagonal, triangular and block matrices with the Schur
-- complement, reindexing, images under ring maps, linearity in a column,
-- det(1 + AB) = det(1 + BA); units of a ring and invertible matrices, the
-- adjugate and the inverse (Matrix.nonsing_inv), Cramer's rule, singular
-- matrices over a field; the determinant of an endomorphism of a finite
-- free module, independent of the basis (LinearMap.det); and the
-- determinant as the top exterior power.
-- Part of the GRH blueprint.
-- Planned home: LinearAlgebra/Matrix/Determinant.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Matrix.Determinant
import GRH.Matrix.Basic
import GRH.Linear.Exterior
import Grace.Cumulus.Algebra.Ring.DeterminantProduct
import Grace.Cumulus.Algebra.Ring.Adjugate

-- Section: Definitions
-- det A and adj A over the bundled commutative ring R, for A on n × n with
-- n finite. Cumulus's determinant and adjugate are taken at the natural
-- number card(n), on A transported along an enumeration e : card(n) → n;
-- every enumeration gives the same value, and that value is the one
-- defined. (Matrix.det uses the sign of a permutation of any finite type.
-- Cumulus's sign at an index set counts ∈-inversions, which is the sign
-- only on a natural number, so it is not applied at n itself.)
def matDetValues (R n A : Set) : Set :=
  { d ∈ Ring.carrier(R) | ∀ e, BijectiveBetween(e, cardinality(n), n) →
    d = determinant(cardinality(n), Ring.carrier(R), Ring.add(R),
      Ring.zero(R), Ring.neg(R), Ring.mul(R), Ring.one(R),
      submatrix(R, cardinality(n), cardinality(n), A, e, e)) }

def matDet (R n A : Set) : Set := ⋃(matDetValues(R, n, A))

-- The sign of a permutation σ of a finite index set n, in R: the
-- determinant of the permutation matrix (Equiv.Perm.sign, cast to R).
-- Cumulus's permutationSign at n counts ∈-inversions and is not used.
def matPermSign (R n σ : Set) : Set :=
  matDet(R, n, submatrix(R, n, n, matOne(R, n), identity(n), σ))

def matAdjugateValues (R n A : Set) : Set :=
  { B ∈ matrixSpace(R, n, n) | ∀ e, BijectiveBetween(e, cardinality(n), n) →
    submatrix(R, cardinality(n), cardinality(n), B, e, e) =
      adjugate(cardinality(n), Ring.carrier(R), Ring.add(R), Ring.zero(R),
        Ring.neg(R), Ring.mul(R), Ring.one(R),
        submatrix(R, cardinality(n), cardinality(n), A, e, e)) }

def matAdjugate (R n A : Set) : Set := ⋃(matAdjugateValues(R, n, A))

-- The units of a ring (IsUnit) and the inverse of a unit, unique.
predicate RingUnit (R a : Set) :=
  a ∈ Ring.carrier(R) ∧ (∃ b ∈ Ring.carrier(R),
    call2(Ring.mul(R), a, b) = Ring.one(R) ∧ call2(Ring.mul(R), b, a) = Ring.one(R))

def ringUnits (R : Set) : Set := { a ∈ Ring.carrier(R) | RingUnit(R, a) }

defunique ringInverse (R a : Set) (b ∈ Ring.carrier(R)) :=
  call2(Ring.mul(R), a, b) = Ring.one(R) ∧ call2(Ring.mul(R), b, a) = Ring.one(R)
requires ring : Ring(R)
requires unit : RingUnit(R, a)
proof
  obtain ⟨aIn, b, bIn, right, left⟩ := unit
  witness b
  exact ⟨bIn, right, left⟩
uniqueness
  have parts := Ring.parts with ring
  have monoid := IsRing.multiplicative with parts
  obtain ⟨aIn, _⟩ := unit
  intros b bIn first c cIn second
  obtain ⟨r1, l1⟩ := first
  obtain ⟨r2, l2⟩ := second
  have hb : IsInverse(R.carrier, R.mul, R.one, a, b)
    unfold IsInverse
    exact ⟨aIn, bIn, l1, r1⟩
  have hc : IsInverse(R.carrier, R.mul, R.one, a, c)
    unfold IsInverse
    exact ⟨aIn, cIn, l2, r2⟩
  exact IsInverse.unique with monoid, hb, hc

-- An invertible square matrix (IsUnit in Mₙ(R)), and the inverse
-- det(A)⁻¹ adj(A) of a matrix whose determinant is a unit (Matrix.inv;
-- Mathlib's value 0 at a singular matrix is not part of the definition).
predicate InvertibleMatrix (R n A : Set) :=
  A ∈ matrixSpace(R, n, n) ∧ (∃ B ∈ matrixSpace(R, n, n),
    matMul(R, n, n, n, A, B) = matOne(R, n) ∧ matMul(R, n, n, n, B, A) = matOne(R, n))

def matInverse (R n A : Set) : Set :=
  matSmul(R, n, n, ringInverse(R, matDet(R, n, A)), matAdjugate(R, n, A))

-- The family of columns j ↦ A[·, j] of an m × n matrix.
def columnFamily (R m n A : Set) : Set :=
  { q ∈ n × functionSpace(m, Ring.carrier(R)) | ∃ j ∈ n,
    q = (j, matCol(R, m, A, j)) }

-- The product of the diagonal entries.
def matDiagProduct (R n A : Set) : Set :=
  finiteRingProduct(n, Ring.carrier(R), Ring.add(R), Ring.zero(R), Ring.neg(R),
    Ring.mul(R), Ring.one(R), matDiag(R, n, A))

-- Section: Determinants on a natural number
-- Helpers at an index set k ∈ ℕ, where Cumulus's sign is the true sign:
-- the transpose, a permutation of the columns, and conjugation by a
-- permutation σ (A ↦ A ∘ (σ × σ)) keep the determinant, and the adjugate
-- commutes with that conjugation.

-- Row i of M replaced by row r of Q.
defunique matrixReplaceRowEntry (I A M Q i r p : Set) (a ∈ A) :=
  ∃ k ∈ I, ∃ j ∈ I, p = (k, j) ∧
    (k = i → a = Q[r, j]) ∧ (k ≠ i → a = M[k, j])
requires matrix : RingMatrix(I, A, M)
requires source : RingMatrix(I, A, Q)
requires sourceRow : r ∈ I
requires pair : p ∈ I × I
proof
  obtain ⟨bound, k, hk, j, hj, shape⟩ := product.membership.forward at
    I, I, p with pair
  have original := RingMatrix.entry at I, A, M, k, j with matrix, hk, hj
  have copied := RingMatrix.entry at I, A, Q, r, j with source, sourceRow, hj
  have alternatives : k = i ∨ k ≠ i
    tauto
  cases alternatives with same | different
  . refine ⟨Q[r, j], copied, k, hk, j, hj, shape, ?_⟩
    constructor
    . intro equal
      rfl
    . intro unequal
      exfalso
      exact unequal with same
  . refine ⟨M[k, j], original, k, hk, j, hj, shape, ?_⟩
    constructor
    . intro equal
      exfalso
      exact different with equal
    . intro unequal
      rfl
uniqueness
  intros u hu first v hv second
  obtain ⟨k, hk, j, hj, shapeU, sameU, otherU⟩ := first
  obtain ⟨l, hl, s, hs, shapeV, sameV, otherV⟩ := second
  have pairs : (k, j) = (l, s)
    cc
  have coordinates := orderedPair.injective at k, j, l, s with pairs
  have alternatives : k = i ∨ k ≠ i
    tauto
  cases alternatives with same | different
  . have left : u = Q[r, j]
      exact sameU with same
    have right : v = Q[r, s]
      apply sameV
      cc
    cc
  . have left : u = M[k, j]
      exact otherU with different
    have distinct : l ≠ i
      intro equal
      apply different
      cc
    have right := otherV with distinct
    cc

defgraph matrixReplaceRow (I A M Q i r : Set) (p ∈ I × I) : A :=
  matrixReplaceRowEntry(I, A, M, Q, i, r, p)
requires matrix : RingMatrix(I, A, M)
requires source : RingMatrix(I, A, Q)
requires sourceRow : r ∈ I
proof
  have selected := matrixReplaceRowEntry.selected at I, A, M, Q, i, r, p with *
  exact selected.left

theorem matrixReplaceRow.matrix (I A M Q i r : Set)
  requires matrix : RingMatrix(I, A, M)
  requires source : RingMatrix(I, A, Q)
  requires sourceRow : r ∈ I
  shows RingMatrix(I, A, matrixReplaceRow(I, A, M, Q, i, r))
proof
  unfold RingMatrix
  exact matrixReplaceRow.function with *

theorem matrixReplaceRow.entry (I A M Q i r k j : Set)
  requires matrix : RingMatrix(I, A, M)
  requires source : RingMatrix(I, A, Q)
  requires sourceRow : r ∈ I
  requires row : k ∈ I
  requires column : j ∈ I
  shows (k = i → matrixReplaceRow(I, A, M, Q, i, r)[k, j] = Q[r, j]) ∧
    (k ≠ i → matrixReplaceRow(I, A, M, Q, i, r)[k, j] = M[k, j])
proof
  have pair := product.pair at k, j, I, I with row, column
  have value := matrixReplaceRow.value at I, A, M, Q, i, r, (k, j) with *
  have selected := matrixReplaceRowEntry.selected at I, A, M, Q, i, r, (k, j)
    with *
  obtain ⟨l, hl, s, hs, shape, same, other⟩ := selected.right
  have coordinates := orderedPair.injective with shape
  rw value
  constructor
  . intro equal
    have match : l = i by cc
    have result := same with match
    cc
  . intro different
    have distinct : l ≠ i
      intro equal
      apply different
      cc
    have result := other with distinct
    cc

-- Inversion p ↦ p⁻¹ on the permutations of I.
defgraph permutationInverseMap (I : Set) (p ∈ permutations(I)) : permutations(I) :=
  converse(p, I, I)
proof
  exact permutations.converse with assumption

theorem permutations.converse_converse (I p : Set)
  requires hp : p ∈ permutations(I)
  shows converse(converse(p, I, I), I, I) = p
proof
  have inverse := permutations.converse with hp
  have twice := permutations.converse with inverse
  have function := permutations.function with hp
  have twiceFunction := permutations.function with twice
  have same : ∀ x ∈ I, converse(converse(p, I, I), I, I)(x) = p(x)
    intros x hx
    have image := permutations.apply_closed with hp, hx
    have back := permutations.inverse_apply at I, p, x with hp, hx
    have again := permutations.inverse_apply at I, converse(p, I, I), p(x)
      with inverse, image
    rw back at again
    exact again
  exact FunctionBetween.ext with twiceFunction, function, same

theorem permutationInverseMap.bijective (I : Set)
  shows BijectiveBetween(permutationInverseMap(I), permutations(I),
    permutations(I))
proof
  have function := permutationInverseMap.function at I
  have law : ∀ p ∈ permutations(I),
      permutationInverseMap(I)(permutationInverseMap(I)(p)) = p
    intros p hp
    have inverse := permutations.converse with hp
    have first := permutationInverseMap.value at I, p with hp
    have second := permutationInverseMap.value at I, converse(p, I, I)
      with inverse
    rw [first, second]
    exact permutations.converse_converse with hp
  exact Bijective.of_two_sided_inverse with function, function, law, law

-- The points a map moves.
def movedPoints (k p : Set) : Set := { i ∈ k | p(i) ≠ i }

-- A permutation other than the identity moves some point.
theorem permutations.moves (k p : Set)
  requires member : p ∈ permutations(k)
  requires different : p ≠ identity(k)
  shows ∃ i ∈ k, p(i) ≠ i
proof
  have permutation := permutations.mem_iff.forward with member
  have function := Injective.function with (Bijective.injective with permutation)
  have identityFunction := Injective.function with
    (Bijective.injective with (identity.bijective at k))
  by_contra absent
  apply different
  apply FunctionBetween.ext with function, identityFunction
  intros i hi
  have fixed : p(i) = i
    by_contra notFixed
    apply absent
    refine ⟨i, hi, notFixed⟩
  have value := identity.apply at i, k with hi
  cc

-- A finite subset of k has a maximal element for the order pulled back
-- along e : k → E from a strict linear order on E.
theorem StrictLinearOrder.finite_maximal_along (E lt k e S : Set)
  requires order : StrictLinearOrder(E, lt)
  requires function : e : k → E
  requires subset : S ⊆ k
  requires finite : Finite(S)
  shows S = ∅ ∨ (∃ m ∈ S, ∀ x ∈ S, ¬relates(lt, e(m), e(x)))
proof
  have irreflexive := StrictLinearOrder.irreflexive with order
  have transitive := StrictLinearOrder.transitive with order
  induction finite with G a
  | empty =>
    left
    rfl
  | insert using ih =>
    right
    have aIn : a ∈ G ∪ {a} := union2.right with (singleton.membership.backward with rfl)
    have ea := FunctionBetween.apply_closed with function, aMember
    have selfA : ¬relates(lt, e(a), e(a)) := irreflexive with e(a), ea
    cases ih with empty | found
    . refine ⟨a, aIn, ?_⟩
      intros x hx
      cases (union2.membership.forward with hx) with inG | isA
      . exfalso
        rw empty at inG
        exact set.empty with inG
      . rw (singleton.membership.forward with isA)
        exact selfA
    . obtain ⟨m, hm, maximal⟩ := found
      have mIn : m ∈ G ∪ {a} := union2.left with hm
      have mk := GSubset with m, hm
      have em := FunctionBetween.apply_closed with function, mk
      by_cases up : relates(lt, e(m), e(a))
      . refine ⟨a, aIn, ?_⟩
        intros x hx
        cases (union2.membership.forward with hx) with inG | isA
        . intro beyond
          have xk := GSubset with x, inG
          have ex := FunctionBetween.apply_closed with function, xk
          have chain := transitive with e(m), em, e(a), ea, e(x), ex, up, beyond
          exact (maximal with x, inG) with chain
        . rw (singleton.membership.forward with isA)
          exact selfA
      . refine ⟨m, mIn, ?_⟩
        intros x hx
        cases (union2.membership.forward with hx) with inG | isA
        . exact maximal with x, inG
        . rw (singleton.membership.forward with isA)
          exact up

section NatDeterminants
variable (A add zero neg mul one : Set)
notation ring R := (A, add, zero, neg, mul, one)
hypothesis ring : IsCommRing(R)

theorem signPower.square (c : Nat)
  shows monoidPow(mul, one, neg(one), c) * monoidPow(mul, one, neg(one), c) =
    R[1]
proof
  induction c with
  | zero =>
    rw monoidPow.zero
    ring
  | succ(k) using ih =>
    have ordinary := IsCommRing.ring with ring
    have multiplicative := IsRing.multiplicative with ordinary
    have unitIn := IsMonoid.unit_in_carrier with multiplicative
    have negative := IsRing.neg_closed with ordinary, unitIn
    have closed := monoidPow.closed at A, mul, one, neg(one), k
      with multiplicative, negative
    rw monoidPow.succ
    have e : call2(mul, call2(mul, neg(one), monoidPow(mul, one, neg(one), k)),
        call2(mul, neg(one), monoidPow(mul, one, neg(one), k))) =
      call2(mul, monoidPow(mul, one, neg(one), k),
        monoidPow(mul, one, neg(one), k)) by ring
    rw [e, ih]

theorem permutationSign.square (n : Nat) (p : Set)
  shows permutationSign(n, R, p) * permutationSign(n, R, p) = R[1]
proof
  have finite := inversions.finite at n, p with (Finite.natural at n)
  have count := cardinality.nat at inversions(n, p) with finite
  unfold permutationSign
  exact signPower.square at A, add, zero, neg, mul, one,
    cardinality(inversions(n, p)) with ring

theorem permutationSign.converse (n : Nat) (p : Set)
  requires hp : p ∈ permutations(n)
  shows permutationSign(n, R, converse(p, n, n)) = permutationSign(n, R, p)
proof
  have finite := Finite.natural at n
  have inverse := permutations.converse with hp
  have split := permutationSign.compose at A, add, zero, neg, mul, one, n, p,
    converse(p, n, n) with ring, hp, inverse
  have cancel := permutations.compose_converse at n, p with hp
  have unit := permutationSign.identity at A, add, zero, neg, mul, one, n
    with ring
  rw [cancel, unit] at split
  have square := permutationSign.square at A, add, zero, neg, mul, one, n, p
    with ring
  have s := permutationSign.closed at A, add, zero, neg, mul, one, n, p
    with ring, finite
  have t := permutationSign.closed at A, add, zero, neg, mul, one, n,
    converse(p, n, n) with ring, finite
  have e1 : permutationSign(n, R, converse(p, n, n)) =
      permutationSign(n, R, converse(p, n, n)) *
        (permutationSign(n, R, p) * permutationSign(n, R, p))
    rw square
    ring
  have e2 : permutationSign(n, R, converse(p, n, n)) *
      (permutationSign(n, R, p) * permutationSign(n, R, p)) =
    (permutationSign(n, R, p) * permutationSign(n, R, converse(p, n, n))) *
      permutationSign(n, R, p) by ring
  have e3 : (permutationSign(n, R, p) * permutationSign(n, R, converse(p, n, n))) *
      permutationSign(n, R, p) = permutationSign(n, R, p)
    rw ← split
    ring
  rw [e1, e2, e3]

theorem determinant.transpose (n : Nat) (M N : Set)
  requires matrixM : RingMatrix(n, R, M)
  requires matrixN : RingMatrix(n, R, N)
  requires entries : ∀ i ∈ n, ∀ j ∈ n, N[i, j] = M[j, i]
  shows determinant(n, R, N) = determinant(n, R, M)
proof
  have finite := Finite.natural at n
  have permutationsFinite := permutations.finite at n with finite
  have termsN := determinantTerms.function at n, A, add, zero, neg, mul, one, N
    with ring, finite, matrixN
  have termsM := determinantTerms.function at n, A, add, zero, neg, mul, one, M
    with ring, finite, matrixM
  have inverseBijective := permutationInverseMap.bijective at n
  have values : ∀ p ∈ permutations(n),
      determinantTerms(n, R, N)(p) =
      determinantTerms(n, R, M)(permutationInverseMap(n)(p))
    intros p hp
    have inverse := permutations.converse with hp
    have mapValue := permutationInverseMap.value at n, p with hp
    have termN := determinantTerms.value at n, A, add, zero, neg, mul, one, N, p
      with ring, finite, matrixN, hp
    have termM := determinantTerms.value at n, A, add, zero, neg, mul, one, M,
      converse(p, n, n) with ring, finite, matrixM, inverse
    have pBijective := permutations.bijective with hp
    have qBijective := permutations.bijective with inverse
    have entriesN := permutationEntries.function at n, A, N, p
      with matrixN, pBijective
    have entriesM := permutationEntries.function at n, A, M, converse(p, n, n)
      with matrixM, qBijective
    have products : ∀ i ∈ n, permutationEntries(n, A, N, p)(i) =
        permutationEntries(n, A, M, converse(p, n, n))(p(i))
      intros i hi
      have image := permutations.apply_closed with hp, hi
      have valueN := permutationEntries.value at n, A, N, p, i
        with matrixN, pBijective, hi
      have valueM := permutationEntries.value at n, A, M, converse(p, n, n), p(i)
        with matrixM, qBijective, image
      have cancel := permutations.inverse_apply at n, p, i with hp, hi
      have swap := entries with i, hi, p(i), image
      rw [valueN, valueM, cancel, swap]
    have productEq := finiteRingProduct.reindex at n, n, A, add, zero, neg, mul,
      one, permutationEntries(n, A, N, p),
      permutationEntries(n, A, M, converse(p, n, n)), p
      with ring, finite, entriesN, entriesM, pBijective, products
    have sign := permutationSign.converse at A, add, zero, neg, mul, one, n, p
      with ring, hp
    rw [mapValue, termN, termM, productEq, sign]
  have reindexed := finiteRingSum.reindex at permutations(n), permutations(n), A,
    add, zero, neg, mul, one, determinantTerms(n, R, N), determinantTerms(n, R, M),
    permutationInverseMap(n)
    with ring, permutationsFinite, termsN, termsM, inverseBijective, values
  unfold determinant
  exact reindexed

theorem determinant.column_permutation (n : Nat) (M N σ : Set)
  requires matrixM : RingMatrix(n, R, M)
  requires matrixN : RingMatrix(n, R, N)
  requires permutation : σ ∈ permutations(n)
  requires columns : ∀ i ∈ n, ∀ j ∈ n, N[i, j] = M[i, σ(j)]
  shows determinant(n, R, N) = permutationSign(n, R, σ) * determinant(n, R, M)
proof
  have functionM := matrixM
  unfold RingMatrix at functionM
  have functionN := matrixN
  unfold RingMatrix at functionN
  have tM := transposedMatrix.function at n, n, A, M with functionM
  have tN := transposedMatrix.function at n, n, A, N with functionN
  have matrixTM : RingMatrix(n, R, transposedMatrix(n, n, A, M))
    unfold RingMatrix
    exact tM
  have matrixTN : RingMatrix(n, R, transposedMatrix(n, n, A, N))
    unfold RingMatrix
    exact tN
  have entriesM : ∀ i ∈ n, ∀ j ∈ n, transposedMatrix(n, n, A, M)[i, j] = M[j, i]
    intros i hi j hj
    exact transposedMatrix.pair at n, n, A, M, j, i with functionM, hj, hi
  have entriesN : ∀ i ∈ n, ∀ j ∈ n, transposedMatrix(n, n, A, N)[i, j] = N[j, i]
    intros i hi j hj
    exact transposedMatrix.pair at n, n, A, N, j, i with functionN, hj, hi
  have rows : ∀ i ∈ n, ∀ j ∈ n,
      transposedMatrix(n, n, A, N)[i, j] = transposedMatrix(n, n, A, M)[σ(i), j]
    intros i hi j hj
    have image := permutations.apply_closed with permutation, hi
    have left := entriesN with i, hi, j, hj
    have right := entriesM with σ(i), image, j, hj
    have middle := columns with j, hj, i, hi
    rw [left, right, middle]
  have permuted := determinant.row_permutation at A, add, zero, neg, mul, one, n,
    transposedMatrix(n, n, A, M), transposedMatrix(n, n, A, N), σ
    with ring, matrixTM, matrixTN, permutation, rows
  have backN := determinant.transpose at A, add, zero, neg, mul, one, n, N,
    transposedMatrix(n, n, A, N) with ring, matrixN, matrixTN, entriesN
  have backM := determinant.transpose at A, add, zero, neg, mul, one, n, M,
    transposedMatrix(n, n, A, M) with ring, matrixM, matrixTM, entriesM
  rw [← backN, ← backM]
  exact permuted

-- Conjugating by a permutation keeps the determinant.
theorem determinant.conjugate (n : Nat) (M N σ : Set)
  requires matrixM : RingMatrix(n, R, M)
  requires matrixN : RingMatrix(n, R, N)
  requires permutation : σ ∈ permutations(n)
  requires entries : ∀ i ∈ n, ∀ j ∈ n, N[i, j] = M[σ(i), σ(j)]
  shows determinant(n, R, N) = determinant(n, R, M)
proof
  have function := permutations.function with permutation
  have rowsMatrix := selectedRows.matrix at n, A, M, σ with matrixM, function
  have rows : ∀ i ∈ n, ∀ j ∈ n, selectedRows(n, A, M, σ)[i, j] = M[σ(i), j]
    intros i hi j hj
    exact selectedRows.entry at n, A, M, σ, i, j with matrixM, function, hi, hj
  have columns : ∀ i ∈ n, ∀ j ∈ n, N[i, j] = selectedRows(n, A, M, σ)[i, σ(j)]
    intros i hi j hj
    have image := permutations.apply_closed with permutation, hj
    have value := rows with i, hi, σ(j), image
    have given := entries with i, hi, j, hj
    rw [given, value]
  have first := determinant.row_permutation at A, add, zero, neg, mul, one, n,
    M, selectedRows(n, A, M, σ), σ with ring, matrixM, rowsMatrix, permutation, rows
  have second := determinant.column_permutation at A, add, zero, neg, mul, one,
    n, selectedRows(n, A, M, σ), N, σ
    with ring, rowsMatrix, matrixN, permutation, columns
  have square := permutationSign.square at A, add, zero, neg, mul, one, n, σ
    with ring
  have finite := Finite.natural at n
  have s := permutationSign.closed at A, add, zero, neg, mul, one, n, σ
    with ring, finite
  have d := determinant.closed at A, add, zero, neg, mul, one, M, n
    with ring, matrixM
  rw [second, first]
  have e : permutationSign(n, R, σ) * (permutationSign(n, R, σ) *
      determinant(n, R, M)) =
    (permutationSign(n, R, σ) * permutationSign(n, R, σ)) * determinant(n, R, M)
    by ring
  rw [e, square]
  ring

-- The cofactor at (b, a) is the determinant with row b replaced by the
-- unit row e_a.
theorem cofactorRow.unit_row (n : Nat) (M b a : Set)
  requires matrix : RingMatrix(n, R, M)
  requires row : b ∈ n
  requires column : a ∈ n
  shows cofactorRow(n, R, M, b)(a) = determinant(n, R,
    matrixReplaceRow(n, A, M, identityMatrix(n, R), b, a))
proof
  have finite := Finite.natural at n
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have multiplicative := IsRing.multiplicative with ordinary
  have oneIn := IsMonoid.unit_in_carrier with multiplicative
  have identity := identityMatrix.matrix at A, add, zero, neg, mul, one, n
    with ring
  have replaced := matrixReplaceRow.matrix at n, A, M, identityMatrix(n, R), b, a
    with matrix, identity, column
  have outside : ∀ k ∈ n, k ≠ b → ∀ j ∈ n,
      matrixReplaceRow(n, A, M, identityMatrix(n, R), b, a)[k, j] = M[k, j]
    intros k hk different j hj
    have entry := matrixReplaceRow.entry at n, A, M, identityMatrix(n, R), b, a,
      k, j with matrix, identity, column, hk, hj
    exact entry.right with different
  have expansion := determinant.row_expansion at A, add, zero, neg, mul, one, n,
    M, matrixReplaceRow(n, A, M, identityMatrix(n, R), b, a), b
    with ring, matrix, replaced, row, outside
  have weights := cofactorPairWeights.function at n, A, add, zero, neg, mul, one,
    M, matrixReplaceRow(n, A, M, identityMatrix(n, R), b, a), b, b
    with ring, finite, matrix, replaced, row
  have cofactors := cofactorRow.function at n, A, add, zero, neg, mul, one, M, b
    with ring, finite, matrix
  have cofactorIn := FunctionBetween.apply_closed with cofactors, column
  have single := coefficientSingle.function at n, A, zero,
    cofactorRow(n, R, M, b)(a), a with zeroIn, cofactorIn
  have values : ∀ j ∈ n,
      cofactorPairWeights(n, R, M,
        matrixReplaceRow(n, A, M, identityMatrix(n, R), b, a), b, b)(j) =
      coefficientSingle(n, A, zero, cofactorRow(n, R, M, b)(a), a)(j)
    intros j hj
    have value := cofactorPairWeights.value at n, A, add, zero, neg, mul, one,
      M, matrixReplaceRow(n, A, M, identityMatrix(n, R), b, a), b, b, j
      with ring, finite, matrix, replaced, row, hj
    have entry := matrixReplaceRow.entry at n, A, M, identityMatrix(n, R), b, a,
      b, j with matrix, identity, column, row, hj
    have same : b = b by rfl
    have rowValue := entry.left with same
    have unitEntry := identityMatrix.entry at A, add, zero, neg, mul, one, n, a, j
      with ring, column, hj
    have cofactorJ := FunctionBetween.apply_closed with cofactors, hj
    rw [value, rowValue, unitEntry]
    have alternatives : j = a ∨ j ≠ a by tauto
    cases alternatives with equal | different
    . have reverse : a = j by cc
      have delta := singleValue.same at A, zero, one, j, a
        with zeroIn, oneIn, reverse
      have picked := coefficientSingle.same at n, A, zero,
        cofactorRow(n, R, M, b)(a), a with zeroIn, cofactorIn, column
      rw [delta, equal, picked]
      ring
    . have reverse : a ≠ j
        intro e
        apply different
        cc
      have delta := singleValue.other at A, zero, one, j, a
        with zeroIn, oneIn, reverse
      have picked := coefficientSingle.other at n, A, zero,
        cofactorRow(n, R, M, b)(a), a, j with zeroIn, cofactorIn, hj, different
      rw [delta, picked]
      ring
  have congruent := finiteRingSum.congr at n, A, add, zero, neg, mul, one,
    cofactorPairWeights(n, R, M,
      matrixReplaceRow(n, A, M, identityMatrix(n, R), b, a), b, b),
    coefficientSingle(n, A, zero, cofactorRow(n, R, M, b)(a), a)
    with ring, finite, weights, single, values
  have total := finiteRingSum.single at n, A, add, zero, neg, mul, one,
    cofactorRow(n, R, M, b)(a), a with ring, finite, cofactorIn, column
  unfold cofactorPairing at expansion
  rw [expansion, congruent, total]

-- The adjugate commutes with conjugation by a permutation.
theorem adjugate.conjugate (n : Nat) (M N σ a b : Set)
  requires matrixM : RingMatrix(n, R, M)
  requires matrixN : RingMatrix(n, R, N)
  requires permutation : σ ∈ permutations(n)
  requires entries : ∀ i ∈ n, ∀ j ∈ n, N[i, j] = M[σ(i), σ(j)]
  requires row : a ∈ n
  requires column : b ∈ n
  shows adjugate(n, R, N)[a, b] = adjugate(n, R, M)[σ(a), σ(b)]
proof
  have finite := Finite.natural at n
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have multiplicative := IsRing.multiplicative with ordinary
  have oneIn := IsMonoid.unit_in_carrier with multiplicative
  have identity := identityMatrix.matrix at A, add, zero, neg, mul, one, n
    with ring
  have imageA := permutations.apply_closed with permutation, row
  have imageB := permutations.apply_closed with permutation, column
  have adjN := adjugate.entry at n, A, add, zero, neg, mul, one, N, a, b
    with ring, finite, matrixN, row, column
  have adjM := adjugate.entry at n, A, add, zero, neg, mul, one, M, σ(a), σ(b)
    with ring, finite, matrixM, imageA, imageB
  have cofactorN := cofactorRow.unit_row at A, add, zero, neg, mul, one, n, N, b, a
    with ring, matrixN, column, row
  have cofactorM := cofactorRow.unit_row at A, add, zero, neg, mul, one, n, M,
    σ(b), σ(a) with ring, matrixM, imageB, imageA
  have replacedN := matrixReplaceRow.matrix at n, A, N, identityMatrix(n, R), b, a
    with matrixN, identity, row
  have replacedM := matrixReplaceRow.matrix at n, A, M, identityMatrix(n, R),
    σ(b), σ(a) with matrixM, identity, imageA
  have conjugated : ∀ i ∈ n, ∀ j ∈ n,
      matrixReplaceRow(n, A, N, identityMatrix(n, R), b, a)[i, j] =
      matrixReplaceRow(n, A, M, identityMatrix(n, R), σ(b), σ(a))[σ(i), σ(j)]
    intros i hi j hj
    have imageI := permutations.apply_closed with permutation, hi
    have imageJ := permutations.apply_closed with permutation, hj
    have entryN := matrixReplaceRow.entry at n, A, N, identityMatrix(n, R), b, a,
      i, j with matrixN, identity, row, hi, hj
    have entryM := matrixReplaceRow.entry at n, A, M, identityMatrix(n, R),
      σ(b), σ(a), σ(i), σ(j) with matrixM, identity, imageA, imageI, imageJ
    have alternatives : i = b ∨ i ≠ b by tauto
    cases alternatives with onRow | offRow
    . have mapped : σ(i) = σ(b) by rw onRow
      have leftValue := entryN.left with onRow
      have rightValue := entryM.left with mapped
      have unitN := identityMatrix.entry at A, add, zero, neg, mul, one, n, a, j
        with ring, row, hj
      have unitM := identityMatrix.entry at A, add, zero, neg, mul, one, n,
        σ(a), σ(j) with ring, imageA, imageJ
      rw [leftValue, rightValue, unitN, unitM]
      have cases : a = j ∨ a ≠ j by tauto
      cases cases with equal | different
      . have equalImage : σ(a) = σ(j) by rw equal
        have deltaN := singleValue.same at A, zero, one, j, a
          with zeroIn, oneIn, equal
        have deltaM := singleValue.same at A, zero, one, σ(j), σ(a)
          with zeroIn, oneIn, equalImage
        rw [deltaN, deltaM]
      . have differentImage : σ(a) ≠ σ(j)
          intro e
          apply different
          exact permutations.apply_cancel with permutation, row, hj, e
        have deltaN := singleValue.other at A, zero, one, j, a
          with zeroIn, oneIn, different
        have deltaM := singleValue.other at A, zero, one, σ(j), σ(a)
          with zeroIn, oneIn, differentImage
        rw [deltaN, deltaM]
    . have mapped : σ(i) ≠ σ(b)
        intro e
        apply offRow
        exact permutations.apply_cancel with permutation, hi, column, e
      have leftValue := entryN.right with offRow
      have rightValue := entryM.right with mapped
      have given := entries with i, hi, j, hj
      rw [leftValue, rightValue, given]
  have same := determinant.conjugate at A, add, zero, neg, mul, one, n,
    matrixReplaceRow(n, A, M, identityMatrix(n, R), σ(b), σ(a)),
    matrixReplaceRow(n, A, N, identityMatrix(n, R), b, a), σ
    with ring, replacedM, replacedN, permutation, conjugated
  rw [adjN, adjM, cofactorN, cofactorM, same]

-- Column b replaced by e_a and row a replaced by e_b give the same
-- determinant (both are the (a, b) cofactor).
theorem determinant.unit_column_row (n : Nat) (M T N a b : Set)
  requires matrixM : RingMatrix(n, R, M)
  requires matrixT : RingMatrix(n, R, T)
  requires matrixN : RingMatrix(n, R, N)
  requires row : a ∈ n
  requires column : b ∈ n
  requires columnT : ∀ i ∈ n, T[i, b] = identityMatrix(n, R)[a, i]
  requires otherT : ∀ i ∈ n, ∀ j ∈ n, j ≠ b → T[i, j] = M[i, j]
  requires rowN : ∀ j ∈ n, N[a, j] = identityMatrix(n, R)[b, j]
  requires otherN : ∀ i ∈ n, i ≠ a → ∀ j ∈ n, N[i, j] = M[i, j]
  shows determinant(n, R, T) = determinant(n, R, N)
proof
  have finite := Finite.natural at n
  have permutationsFinite := permutations.finite at n with finite
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have multiplicative := IsRing.multiplicative with ordinary
  have oneIn := IsMonoid.unit_in_carrier with multiplicative
  have termsT := determinantTerms.function at n, A, add, zero, neg, mul, one, T
    with ring, finite, matrixT
  have termsN := determinantTerms.function at n, A, add, zero, neg, mul, one, N
    with ring, finite, matrixN
  have values : ∀ p ∈ permutations(n),
      determinantTerms(n, R, T)(p) = determinantTerms(n, R, N)(p)
    intros p hp
    have pBijective := permutations.bijective with hp
    have termT := determinantTerms.value at n, A, add, zero, neg, mul, one, T, p
      with ring, finite, matrixT, hp
    have termN := determinantTerms.value at n, A, add, zero, neg, mul, one, N, p
      with ring, finite, matrixN, hp
    have entriesT := permutationEntries.function at n, A, T, p
      with matrixT, pBijective
    have entriesN := permutationEntries.function at n, A, N, p
      with matrixN, pBijective
    have imageA := permutations.apply_closed with hp, row
    have products : finiteRingProduct(n, A, add, zero, neg, mul, one,
        permutationEntries(n, A, T, p)) = finiteRingProduct(n, A, add, zero,
        neg, mul, one, permutationEntries(n, A, N, p))
      have alternatives : p(a) = b ∨ p(a) ≠ b by tauto
      cases alternatives with hit | miss
      . have same : ∀ i ∈ n, permutationEntries(n, A, T, p)(i) =
            permutationEntries(n, A, N, p)(i)
          intros i hi
          have image := permutations.apply_closed with hp, hi
          have valueT := permutationEntries.value at n, A, T, p, i
            with matrixT, pBijective, hi
          have valueN := permutationEntries.value at n, A, N, p, i
            with matrixN, pBijective, hi
          rw [valueT, valueN]
          have cases : i = a ∨ i ≠ a by tauto
          cases cases with onA | offA
          . rw [onA, hit]
            have left := columnT with a, row
            have right := rowN with b, column
            have reflA : a = a by rfl
            have reflB : b = b by rfl
            have unitA := identityMatrix.entry at A, add, zero, neg, mul, one,
              n, a, a with ring, row, row
            have unitB := identityMatrix.entry at A, add, zero, neg, mul, one,
              n, b, b with ring, column, column
            have deltaA := singleValue.same at A, zero, one, a, a
              with zeroIn, oneIn, reflA
            have deltaB := singleValue.same at A, zero, one, b, b
              with zeroIn, oneIn, reflB
            rw [left, right, unitA, unitB, deltaA, deltaB]
          . have offB : p(i) ≠ b
              intro e
              apply offA
              have back : p(i) = p(a) by rw [e, hit]
              exact permutations.apply_cancel with hp, hi, row, back
            have left := otherT with i, hi, p(i), image, offB
            have right := otherN with i, hi, offA, p(i), image
            rw [left, right]
      . exact finiteRingProduct.congr at n, A, add, zero, neg, mul, one,
          permutationEntries(n, A, T, p), permutationEntries(n, A, N, p)
          with ring, finite, entriesT, entriesN, same
      . obtain ⟨c, hc, hitC⟩ := permutations.apply_surjective with hp, column
        have distinct : a ≠ c
          intro e
          apply miss
          rw e
          exact hitC
        have valueT := permutationEntries.value at n, A, T, p, c
          with matrixT, pBijective, hc
        have unitC := identityMatrix.entry at A, add, zero, neg, mul, one,
          n, a, c with ring, row, hc
        have deltaC := singleValue.other at A, zero, one, c, a
          with zeroIn, oneIn, distinct
        have atC := columnT with c, hc
        have vanishT : permutationEntries(n, A, T, p)(c) = R[0]
          rw [valueT, hitC, atC, unitC, deltaC]
        have zeroT := finiteRingProduct.zero_of_factor at n, A, add, zero, neg,
          mul, one, permutationEntries(n, A, T, p), c
          with ring, finite, entriesT, hc, vanishT
        have valueN := permutationEntries.value at n, A, N, p, a
          with matrixN, pBijective, row
        have unitP := identityMatrix.entry at A, add, zero, neg, mul, one,
          n, b, p(a) with ring, column, imageA
        have different : b ≠ p(a)
          intro e
          apply miss
          symm
          exact e
        have deltaP := singleValue.other at A, zero, one, p(a), b
          with zeroIn, oneIn, different
        have atA := rowN with p(a), imageA
        have vanishN : permutationEntries(n, A, N, p)(a) = R[0]
          rw [valueN, atA, unitP, deltaP]
        have zeroN := finiteRingProduct.zero_of_factor at n, A, add, zero, neg,
          mul, one, permutationEntries(n, A, N, p), a
          with ring, finite, entriesN, row, vanishN
        rw [zeroT, zeroN]
    rw [termT, termN, products]
  have congruent := finiteRingSum.congr at permutations(n), A, add, zero, neg,
    mul, one, determinantTerms(n, R, T), determinantTerms(n, R, N)
    with ring, permutationsFinite, termsT, termsN, values
  unfold determinant
  exact congruent

-- The adjugate of the transpose is the transpose of the adjugate.
theorem adjugate.transpose (n : Nat) (M S a b : Set)
  requires matrixM : RingMatrix(n, R, M)
  requires matrixS : RingMatrix(n, R, S)
  requires transposed : ∀ i ∈ n, ∀ j ∈ n, S[i, j] = M[j, i]
  requires row : a ∈ n
  requires column : b ∈ n
  shows adjugate(n, R, S)[a, b] = adjugate(n, R, M)[b, a]
proof
  have finite := Finite.natural at n
  have identity := identityMatrix.matrix at A, add, zero, neg, mul, one, n
    with ring
  have adjS := adjugate.entry at n, A, add, zero, neg, mul, one, S, a, b
    with ring, finite, matrixS, row, column
  have adjM := adjugate.entry at n, A, add, zero, neg, mul, one, M, b, a
    with ring, finite, matrixM, column, row
  have cofactorS := cofactorRow.unit_row at A, add, zero, neg, mul, one, n, S,
    b, a with ring, matrixS, column, row
  have cofactorM := cofactorRow.unit_row at A, add, zero, neg, mul, one, n, M,
    a, b with ring, matrixM, row, column
  have replacedS := matrixReplaceRow.matrix at n, A, S, identityMatrix(n, R),
    b, a with matrixS, identity, row
  have replacedM := matrixReplaceRow.matrix at n, A, M, identityMatrix(n, R),
    a, b with matrixM, identity, column
  have functionS := replacedS
  unfold RingMatrix at functionS
  have tFunction := transposedMatrix.function at n, n, A,
    matrixReplaceRow(n, A, S, identityMatrix(n, R), b, a) with functionS
  have matrixT : RingMatrix(n, R, transposedMatrix(n, n, A,
      matrixReplaceRow(n, A, S, identityMatrix(n, R), b, a)))
    unfold RingMatrix
    exact tFunction
  have entriesT : ∀ i ∈ n, ∀ j ∈ n, transposedMatrix(n, n, A,
      matrixReplaceRow(n, A, S, identityMatrix(n, R), b, a))[i, j] =
      matrixReplaceRow(n, A, S, identityMatrix(n, R), b, a)[j, i]
    intros i hi j hj
    exact transposedMatrix.pair at n, n, A,
      matrixReplaceRow(n, A, S, identityMatrix(n, R), b, a), j, i
      with functionS, hj, hi
  have flip := determinant.transpose at A, add, zero, neg, mul, one, n,
    matrixReplaceRow(n, A, S, identityMatrix(n, R), b, a),
    transposedMatrix(n, n, A,
      matrixReplaceRow(n, A, S, identityMatrix(n, R), b, a))
    with ring, replacedS, matrixT, entriesT
  have columnT : ∀ i ∈ n, transposedMatrix(n, n, A,
      matrixReplaceRow(n, A, S, identityMatrix(n, R), b, a))[i, b] =
      identityMatrix(n, R)[a, i]
    intros i hi
    have entry := matrixReplaceRow.entry at n, A, S, identityMatrix(n, R), b, a,
      b, i with matrixS, identity, row, column, hi
    have same : b = b by rfl
    have value := entry.left with same
    have swapped := entriesT with i, hi, b, column
    rw [swapped, value]
  have otherT : ∀ i ∈ n, ∀ j ∈ n, j ≠ b → transposedMatrix(n, n, A,
      matrixReplaceRow(n, A, S, identityMatrix(n, R), b, a))[i, j] = M[i, j]
    intros i hi j hj different
    have entry := matrixReplaceRow.entry at n, A, S, identityMatrix(n, R), b, a,
      j, i with matrixS, identity, row, hj, hi
    have value := entry.right with different
    have swapped := entriesT with i, hi, j, hj
    have given := transposed with j, hj, i, hi
    rw [swapped, value, given]
  have rowN : ∀ j ∈ n,
      matrixReplaceRow(n, A, M, identityMatrix(n, R), a, b)[a, j] =
      identityMatrix(n, R)[b, j]
    intros j hj
    have entry := matrixReplaceRow.entry at n, A, M, identityMatrix(n, R), a, b,
      a, j with matrixM, identity, column, row, hj
    have same : a = a by rfl
    exact entry.left with same
  have otherN : ∀ i ∈ n, i ≠ a → ∀ j ∈ n,
      matrixReplaceRow(n, A, M, identityMatrix(n, R), a, b)[i, j] = M[i, j]
    intros i hi different j hj
    have entry := matrixReplaceRow.entry at n, A, M, identityMatrix(n, R), a, b,
      i, j with matrixM, identity, column, hi, hj
    exact entry.right with different
  have equal := determinant.unit_column_row at A, add, zero, neg, mul, one, n, M,
    transposedMatrix(n, n, A,
      matrixReplaceRow(n, A, S, identityMatrix(n, R), b, a)),
    matrixReplaceRow(n, A, M, identityMatrix(n, R), a, b), a, b
    with ring, matrixM, matrixT, replacedM, row, column, columnT, otherT, rowN,
      otherN
  rw [adjS, adjM, cofactorS, cofactorM, ← flip, equal]

-- The left product adj(M) M at (i, j) is the right product S adj(S) at
-- (j, i) for the transpose S of M.
theorem adjugate.left_product (n : Nat) (M i j : Set)
  requires matrixM : RingMatrix(n, R, M)
  requires row : i ∈ n
  requires column : j ∈ n
  shows matrixProductEntry(n, R, adjugate(n, R, M), M, i, j) =
    matrixProductEntry(n, R, transposedMatrix(n, n, A, M),
      adjugate(n, R, transposedMatrix(n, n, A, M)), j, i)
proof
  have finite := Finite.natural at n
  have functionM := matrixM
  unfold RingMatrix at functionM
  have tFunction := transposedMatrix.function at n, n, A, M with functionM
  have matrixS : RingMatrix(n, R, transposedMatrix(n, n, A, M))
    unfold RingMatrix
    exact tFunction
  have entriesS : ∀ x ∈ n, ∀ y ∈ n, transposedMatrix(n, n, A, M)[x, y] = M[y, x]
    intros x hx y hy
    exact transposedMatrix.pair at n, n, A, M, y, x with functionM, hy, hx
  have adjM := adjugate.matrix at n, A, add, zero, neg, mul, one, M
    with ring, finite, matrixM
  have adjS := adjugate.matrix at n, A, add, zero, neg, mul, one,
    transposedMatrix(n, n, A, M) with ring, finite, matrixS
  have left := matrixProductWeights.function at n, A, add, zero, neg, mul, one,
    adjugate(n, R, M), M, i, j with ring, adjM, matrixM, row, column
  have right := matrixProductWeights.function at n, A, add, zero, neg, mul, one,
    transposedMatrix(n, n, A, M), adjugate(n, R, transposedMatrix(n, n, A, M)),
    j, i with ring, matrixS, adjS, column, row
  have values : ∀ l ∈ n,
      matrixProductWeights(n, R, adjugate(n, R, M), M, i, j)(l) =
      matrixProductWeights(n, R, transposedMatrix(n, n, A, M),
        adjugate(n, R, transposedMatrix(n, n, A, M)), j, i)(l)
    intros l hl
    have v1 := matrixProductWeights.value at n, A, add, zero, neg, mul, one,
      adjugate(n, R, M), M, i, j, l with ring, adjM, matrixM, row, column, hl
    have v2 := matrixProductWeights.value at n, A, add, zero, neg, mul, one,
      transposedMatrix(n, n, A, M), adjugate(n, R, transposedMatrix(n, n, A, M)),
      j, i, l with ring, matrixS, adjS, column, row, hl
    have s := entriesS with j, column, l, hl
    have t := adjugate.transpose at A, add, zero, neg, mul, one, n, M,
      transposedMatrix(n, n, A, M), l, i with ring, matrixM, matrixS, entriesS,
      hl, row
    have x := RingMatrix.entry at n, A, adjugate(n, R, M), i, l with adjM, row, hl
    have y := RingMatrix.entry at n, A, M, l, j with matrixM, hl, column
    rw [v1, v2, s, t]
    ring
  unfold matrixProductEntry
  exact finiteRingSum.congr at n, A, add, zero, neg, mul, one,
    matrixProductWeights(n, R, adjugate(n, R, M), M, i, j),
    matrixProductWeights(n, R, transposedMatrix(n, n, A, M),
      adjugate(n, R, transposedMatrix(n, n, A, M)), j, i)
    with ring, finite, left, right, values

-- A determinant whose every non-identity permutation meets a zero entry is
-- the product of the diagonal.
theorem determinant.only_identity (k : Nat) (M : Set)
  requires matrix : RingMatrix(k, A, M)
  requires vanish : ∀ p ∈ permutations(k), p ≠ identity(k) →
    (∃ i ∈ k, M[i, p(i)] = zero)
  shows determinant(k, A, add, zero, neg, mul, one, M) =
    finiteRingProduct(k, A, add, zero, neg, mul, one,
      permutationEntries(k, A, M, identity(k)))
proof
  have finite := Finite.natural at k with *
  have permutationsFinite := permutations.finite with finite
  have identityBijective := identity.bijective at k
  have identityInjective := Bijective.injective with identityBijective
  have identityFunction := Injective.function with identityInjective
  have identityMember := permutations.mem_iff.backward at k, identity(k) with *
  have ordinary := IsCommRing.ring with ring
  have zeroIn := IsRing.zero_in_carrier with ordinary
  have diagonal := permutationEntries.function at k, A, M, identity(k) with *
  have productIn := finiteRingProduct.closed at k, A, add, zero, neg, mul, one,
    permutationEntries(k, A, M, identity(k)) with ring, finite, diagonal
  have terms := determinantTerms.function at k, A, add, zero, neg, mul, one, M
    with *
  have selected := coefficientSingle.function at permutations(k), A, zero,
    finiteRingProduct(k, A, add, zero, neg, mul, one,
      permutationEntries(k, A, M, identity(k))), identity(k) with *
  have entries : ∀ p ∈ permutations(k),
      determinantTerms(k, A, add, zero, neg, mul, one, M)(p) =
      coefficientSingle(permutations(k), A, zero,
        finiteRingProduct(k, A, add, zero, neg, mul, one,
          permutationEntries(k, A, M, identity(k))), identity(k))(p)
    intros p hp
    have permutation := permutations.mem_iff.forward with hp
    have injective := Bijective.injective with permutation
    have function := Injective.function with injective
    have weights := permutationEntries.function at k, A, M, p with *
    have term := determinantTerms.value at k, A, add, zero, neg, mul, one, M, p
      with *
    have signIn := permutationSign.closed at A, add, zero, neg, mul, one, k, p
      with *
    have alternatives : p = identity(k) ∨ p ≠ identity(k) by tauto
    cases alternatives with same | different
    . have sign := permutationSign.identity at A, add, zero, neg, mul, one, k
        with *
      have selectedValue := coefficientSingle.same at permutations(k), A, zero,
        finiteRingProduct(k, A, add, zero, neg, mul, one,
          permutationEntries(k, A, M, identity(k))), identity(k) with *
      rw [term, same, sign, selectedValue]
      ring
    . obtain ⟨i, hi, zeroEntry⟩ := vanish with p, hp, different
      have value := permutationEntries.value at k, A, M, p, i with *
      have vanishes : permutationEntries(k, A, M, p)(i) = zero by cc
      have product := finiteRingProduct.zero_of_factor at k, A, add, zero, neg,
        mul, one, permutationEntries(k, A, M, p), i with *
      have selectedValue := coefficientSingle.other at permutations(k), A, zero,
        finiteRingProduct(k, A, add, zero, neg, mul, one,
          permutationEntries(k, A, M, identity(k))), identity(k), p with *
      rw [term, product, selectedValue]
      ring
  have sum := finiteRingSum.congr at permutations(k), A, add, zero, neg, mul,
    one, determinantTerms(k, A, add, zero, neg, mul, one, M),
    coefficientSingle(permutations(k), A, zero,
      finiteRingProduct(k, A, add, zero, neg, mul, one,
        permutationEntries(k, A, M, identity(k))), identity(k)) with *
  have single := finiteRingSum.single at permutations(k), A, add, zero, neg,
    mul, one, finiteRingProduct(k, A, add, zero, neg, mul, one,
      permutationEntries(k, A, M, identity(k))), identity(k) with *
  unfold determinant
  cc

theorem determinant.diagonal_entries (k : Nat) (M : Set)
  requires matrix : RingMatrix(k, A, M)
  requires offDiagonal : ∀ i ∈ k, ∀ j ∈ k, i ≠ j → M[i, j] = zero
  shows determinant(k, A, add, zero, neg, mul, one, M) =
    finiteRingProduct(k, A, add, zero, neg, mul, one,
      permutationEntries(k, A, M, identity(k)))
proof
  have vanish : ∀ p ∈ permutations(k), p ≠ identity(k) →
      (∃ i ∈ k, M[i, p(i)] = zero)
    intros p hp different
    obtain ⟨i, hi, moved⟩ := permutations.moves at k, p with hp, different
    have permutation := permutations.mem_iff.forward with hp
    have function := Injective.function with (Bijective.injective with permutation)
    have column := FunctionBetween.apply_closed with function, hi
    have distinct : i ≠ p(i)
      intro equal
      apply moved
      rw ← equal
    refine ⟨i, hi, ?_⟩
    exact offDiagonal with i, hi, p(i), column, distinct
  exact determinant.only_identity at A, add, zero, neg, mul, one, k, M
    with ring, matrix, vanish

-- Triangular for the order pulled back along an injection e : k → E: the
-- determinant is the product of the diagonal.
theorem determinant.triangular_entries (k : Nat) (M E lt e : Set)
  requires matrix : RingMatrix(k, A, M)
  requires order : StrictLinearOrder(E, lt)
  requires injective : InjectiveBetween(e, k, E)
  requires below : ∀ i ∈ k, ∀ j ∈ k, relates(lt, e(j), e(i)) → M[i, j] = zero
  shows determinant(k, A, add, zero, neg, mul, one, M) =
    finiteRingProduct(k, A, add, zero, neg, mul, one,
      permutationEntries(k, A, M, identity(k)))
proof
  have function := Injective.function with injective
  have finite := Finite.natural at k
  have vanish : ∀ p ∈ permutations(k), p ≠ identity(k) →
      (∃ i ∈ k, M[i, p(i)] = zero)
    intros p hp different
    have permutation := permutations.mem_iff.forward with hp
    have pInjective := Bijective.injective with permutation
    have pFunction := Injective.function with pInjective
    have subsetS : movedPoints(k, p) ⊆ k
      intros x hx
      obtain ⟨xk, _⟩ := movedPoints.membership.forward with hx
      exact xk
    have finiteS := Finite.subset with finite, subsetS
    have split := StrictLinearOrder.finite_maximal_along at E, lt, k, e,
      movedPoints(k, p) with order, function, subsetS, finiteS
    cases split with empty | found
    . exfalso
      obtain ⟨i, hi, moved⟩ := permutations.moves at k, p with hp, different
      have member : i ∈ movedPoints(k, p)
        apply movedPoints.membership.backward
        exact ⟨hi, moved⟩
      rw empty at member
      exact set.empty with member
    . obtain ⟨m, hm, maximal⟩ := found
      obtain ⟨mk, moved⟩ := movedPoints.membership.forward with hm
      have pm := FunctionBetween.apply_closed with pFunction, mk
      have pmMoved : p(p(m)) ≠ p(m)
        intro same
        apply moved
        exact Injective.apply_cancel at p, k, k, p(m), m with pInjective, pm, mk, same
      have pmIn : p(m) ∈ movedPoints(k, p)
        apply movedPoints.membership.backward
        exact ⟨pm, pmMoved⟩
      have notUp := maximal with p(m), pmIn
      have em := FunctionBetween.apply_closed with function, mk
      have epm := FunctionBetween.apply_closed with function, pm
      have distinct : e(m) ≠ e(p(m))
        intro same
        apply moved
        have back := Injective.apply_cancel at e, k, E, m, p(m)
          with injective, mk, pm, same
        cc [back]
      have connected := StrictLinearOrder.connected with order
      have sides := connected with e(m), em, e(p(m)), epm, distinct
      cases sides with up | down
      . exfalso
        exact notUp with up
      . refine ⟨m, mk, ?_⟩
        exact below with m, mk, p(m), pm, down
  exact determinant.only_identity at A, add, zero, neg, mul, one, k, M
    with ring, matrix, vanish

-- A product of k equal factors is the k-th power.
theorem indexedRingProduct.constant (w f a : Set, k : Nat)
  requires scalar : a ∈ A
  shows (∀ i ∈ k, w(f(i)) = a) →
    indexedRingProduct(w, f, mul, one, k) = monoidPow(mul, one, a, k)
proof
  induction k
  | zero =>
    intro constant
    rw [indexedRingProduct, monoidPow.zero]
  | succ(j) using ih =>
    intro constant
    have prefix : ∀ i ∈ j, w(f(i)) = a
      intros i before
      have included := membership.into_successor at i, j with *
      exact constant with i, included
    have last := constant with j, membership.self_successor at j with *
    have previous := ih with prefix
    have ordinary := IsCommRing.ring with ring
    have monoid := IsRing.multiplicative with ordinary
    have power := monoidPow.closed at A, mul, one, a, j with monoid, scalar
    rw [indexedRingProduct, previous, last, monoidPow.succ]
    ring

-- The product of a constant family over k is the k-th power.
theorem finiteRingProduct.constant (k : Nat) (a : Set)
  requires scalar : a ∈ A
  shows finiteRingProduct(k, A, add, zero, neg, mul, one,
      constantFunction(k, A, a)) = monoidPow(mul, one, a, k)
proof
  have constant := constantFunction.function at k, A, a with scalar
  have identityBijective := identity.bijective at k
  have equal := finiteRingProduct.enumeration at k, A, add, zero, neg, mul,
    one, constantFunction(k, A, a), identity(k), k
    with ring, constant, identityBijective
  have values : ∀ i ∈ k, constantFunction(k, A, a)(identity(k)(i)) = a
    intros i hi
    have fixed := identity.apply at i, k with hi
    rw fixed
    exact constantFunction.apply at k, A, i, a with hi, scalar
  have power := indexedRingProduct.constant at A, add, zero, neg, mul, one,
    constantFunction(k, A, a), identity(k), a, k with ring, scalar
  rw equal
  exact power with values

end NatDeterminants

-- An enumeration card(n) → n of a finite set.
theorem Finite.cardinality_enumeration (n : Set)
  requires finite : Finite(n)
  shows ∃ e, BijectiveBetween(e, cardinality(n), n)
proof
  have correct := cardinality.correct with finite
  obtain ⟨natural, f, bijective⟩ := correct
  witness converse(f, n, cardinality(n))
  exact converse.bijective with bijective

-- Section: Laws of the determinant
section Determinants
variable (R : Set)
hypothesis ring : CommRing(R)

-- Every enumeration of n gives the same transported determinant.
theorem matDet.enumerations_agree (n A e f : Set)
  requires finite : Finite(n)
  requires matrix : A ∈ matrixSpace(R, n, n)
  requires first : BijectiveBetween(e, cardinality(n), n)
  requires second : BijectiveBetween(f, cardinality(n), n)
  shows determinant(cardinality(n), R.carrier, R.add, R.zero, R.neg, R.mul,
      R.one, submatrix(R, cardinality(n), cardinality(n), A, f, f)) =
    determinant(cardinality(n), R.carrier, R.add, R.zero, R.neg, R.mul,
      R.one, submatrix(R, cardinality(n), cardinality(n), A, e, e))
proof
  have parts := CommRing.parts with ring
  have count := cardinality.nat at n with finite
  have eFunction := Injective.function with (Bijective.injective with first)
  have fFunction := Injective.function with (Bijective.injective with second)
  have inverse := converse.bijective with first
  have inverseFunction := converse.function_of_bijective with first
  have composed := compose.bijective at converse(e, cardinality(n), n), f,
    cardinality(n), n, cardinality(n) with second, inverse
  have permutation := permutations.of_bijective with composed
  have matrixE := submatrix.mem_of at R, n, n, cardinality(n), cardinality(n),
    A, e, e with matrix, eFunction, eFunction
  have matrixF := submatrix.mem_of at R, n, n, cardinality(n), cardinality(n),
    A, f, f with matrix, fFunction, fFunction
  have ringE : RingMatrix(cardinality(n), R.carrier,
      submatrix(R, cardinality(n), cardinality(n), A, e, e))
    unfold RingMatrix
    exact matrixSpace.function with matrixE
  have ringF : RingMatrix(cardinality(n), R.carrier,
      submatrix(R, cardinality(n), cardinality(n), A, f, f))
    unfold RingMatrix
    exact matrixSpace.function with matrixF
  have entries : ∀ i ∈ cardinality(n), ∀ j ∈ cardinality(n),
      submatrix(R, cardinality(n), cardinality(n), A, f, f)[i, j] =
      submatrix(R, cardinality(n), cardinality(n), A, e, e)[
        compose(converse(e, cardinality(n), n), f, cardinality(n), n,
          cardinality(n))(i),
        compose(converse(e, cardinality(n), n), f, cardinality(n), n,
          cardinality(n))(j)]
    intros i hi j hj
    have si := compose.apply at converse(e, cardinality(n), n), f,
      cardinality(n), n, cardinality(n), i with fFunction, inverseFunction, hi
    have sj := compose.apply at converse(e, cardinality(n), n), f,
      cardinality(n), n, cardinality(n), j with fFunction, inverseFunction, hj
    have imageI := permutations.apply_closed with permutation, hi
    have imageJ := permutations.apply_closed with permutation, hj
    have fi := FunctionBetween.apply_closed with fFunction, hi
    have fj := FunctionBetween.apply_closed with fFunction, hj
    have backI := Bijective.apply_inverse at e, cardinality(n), n, f(i)
      with first, fi
    have backJ := Bijective.apply_inverse at e, cardinality(n), n, f(j)
      with first, fj
    have valueF := submatrix.at at R, n, n, cardinality(n), cardinality(n), A,
      f, f, i, j with matrix, fFunction, fFunction, hi, hj
    have valueE := submatrix.at at R, n, n, cardinality(n), cardinality(n), A,
      e, e, compose(converse(e, cardinality(n), n), f, cardinality(n), n,
        cardinality(n))(i),
      compose(converse(e, cardinality(n), n), f, cardinality(n), n,
        cardinality(n))(j) with matrix, eFunction, eFunction, imageI, imageJ
    rw [valueF, valueE, si, sj, backI, backJ]
  exact determinant.conjugate at R.carrier, R.add, R.zero, R.neg, R.mul, R.one,
    cardinality(n), submatrix(R, cardinality(n), cardinality(n), A, e, e),
    submatrix(R, cardinality(n), cardinality(n), A, f, f),
    compose(converse(e, cardinality(n), n), f, cardinality(n), n,
      cardinality(n)) with parts, ringE, ringF, permutation, entries

-- Along two enumerations e, f of n, A transported by f is A transported
-- by e conjugated with the permutation e⁻¹ ∘ f.
theorem submatrix.enumeration_entries (n A e f : Set)
  requires matrix : A ∈ matrixSpace(R, n, n)
  requires first : BijectiveBetween(e, cardinality(n), n)
  requires second : BijectiveBetween(f, cardinality(n), n)
  shows ∀ i ∈ cardinality(n), ∀ j ∈ cardinality(n),
    submatrix(R, cardinality(n), cardinality(n), A, f, f)[i, j] =
    submatrix(R, cardinality(n), cardinality(n), A, e, e)[
      compose(converse(e, cardinality(n), n), f, cardinality(n), n,
        cardinality(n))(i),
      compose(converse(e, cardinality(n), n), f, cardinality(n), n,
        cardinality(n))(j)]
proof
  have eFunction := Injective.function with (Bijective.injective with first)
  have fFunction := Injective.function with (Bijective.injective with second)
  have inverse := converse.bijective with first
  have inverseFunction := converse.function_of_bijective with first
  have composed := compose.bijective at converse(e, cardinality(n), n), f,
    cardinality(n), n, cardinality(n) with second, inverse
  have permutation := permutations.of_bijective with composed
  intros i hi j hj
  have si := compose.apply at converse(e, cardinality(n), n), f,
    cardinality(n), n, cardinality(n), i with fFunction, inverseFunction, hi
  have sj := compose.apply at converse(e, cardinality(n), n), f,
    cardinality(n), n, cardinality(n), j with fFunction, inverseFunction, hj
  have imageI := permutations.apply_closed with permutation, hi
  have imageJ := permutations.apply_closed with permutation, hj
  have fi := FunctionBetween.apply_closed with fFunction, hi
  have fj := FunctionBetween.apply_closed with fFunction, hj
  have backI := Bijective.apply_inverse at e, cardinality(n), n, f(i)
    with first, fi
  have backJ := Bijective.apply_inverse at e, cardinality(n), n, f(j)
    with first, fj
  have valueF := submatrix.at at R, n, n, cardinality(n), cardinality(n), A,
    f, f, i, j with matrix, fFunction, fFunction, hi, hj
  have valueE := submatrix.at at R, n, n, cardinality(n), cardinality(n), A,
    e, e, compose(converse(e, cardinality(n), n), f, cardinality(n), n,
      cardinality(n))(i),
    compose(converse(e, cardinality(n), n), f, cardinality(n), n,
      cardinality(n))(j) with matrix, eFunction, eFunction, imageI, imageJ
  rw [valueF, valueE, si, sj, backI, backJ]

-- The adjugate along e, carried back to n and transported along f, is the
-- adjugate along f.
theorem matAdjugate.transported (n A e f : Set)
  requires finite : Finite(n)
  requires matrix : A ∈ matrixSpace(R, n, n)
  requires first : BijectiveBetween(e, cardinality(n), n)
  requires second : BijectiveBetween(f, cardinality(n), n)
  shows submatrix(R, cardinality(n), cardinality(n),
      submatrix(R, n, n, adjugate(cardinality(n), R.carrier, R.add, R.zero,
        R.neg, R.mul, R.one, submatrix(R, cardinality(n), cardinality(n), A, e, e)),
        converse(e, cardinality(n), n), converse(e, cardinality(n), n)), f, f) =
    adjugate(cardinality(n), R.carrier, R.add, R.zero, R.neg, R.mul, R.one,
      submatrix(R, cardinality(n), cardinality(n), A, f, f))
proof
  have parts := CommRing.parts with ring
  have count := cardinality.nat at n with finite
  have finiteK := Finite.natural at cardinality(n)
  have eFunction := Injective.function with (Bijective.injective with first)
  have fFunction := Injective.function with (Bijective.injective with second)
  have inverse := converse.bijective with first
  have inverseFunction := converse.function_of_bijective with first
  have composed := compose.bijective at converse(e, cardinality(n), n), f,
    cardinality(n), n, cardinality(n) with second, inverse
  have permutation := permutations.of_bijective with composed
  have matrixE := submatrix.mem_of at R, n, n, cardinality(n), cardinality(n),
    A, e, e with matrix, eFunction, eFunction
  have matrixF := submatrix.mem_of at R, n, n, cardinality(n), cardinality(n),
    A, f, f with matrix, fFunction, fFunction
  have ringE : RingMatrix(cardinality(n), R.carrier,
      submatrix(R, cardinality(n), cardinality(n), A, e, e))
    unfold RingMatrix
    exact matrixSpace.function with matrixE
  have ringF : RingMatrix(cardinality(n), R.carrier,
      submatrix(R, cardinality(n), cardinality(n), A, f, f))
    unfold RingMatrix
    exact matrixSpace.function with matrixF
  have adjE := adjugate.matrix at cardinality(n), R.carrier, R.add, R.zero,
    R.neg, R.mul, R.one, submatrix(R, cardinality(n), cardinality(n), A, e, e)
    with parts, finiteK, ringE
  have adjF := adjugate.matrix at cardinality(n), R.carrier, R.add, R.zero,
    R.neg, R.mul, R.one, submatrix(R, cardinality(n), cardinality(n), A, f, f)
    with parts, finiteK, ringF
  have adjFunction := adjE
  unfold RingMatrix at adjFunction
  have adjSpace := matrixSpace.of_function with adjFunction
  have back := submatrix.mem_of at R, cardinality(n), cardinality(n), n, n,
    adjugate(cardinality(n), R.carrier, R.add, R.zero, R.neg, R.mul, R.one,
      submatrix(R, cardinality(n), cardinality(n), A, e, e)),
    converse(e, cardinality(n), n), converse(e, cardinality(n), n)
    with adjSpace, inverseFunction, inverseFunction
  have there := submatrix.mem_of at R, n, n, cardinality(n), cardinality(n),
    submatrix(R, n, n, adjugate(cardinality(n), R.carrier, R.add, R.zero,
      R.neg, R.mul, R.one, submatrix(R, cardinality(n), cardinality(n), A, e, e)),
      converse(e, cardinality(n), n), converse(e, cardinality(n), n)), f, f
    with back, fFunction, fFunction
  have ringThere := matrixSpace.function with there
  have ringLeft : RingMatrix(cardinality(n), R.carrier,
      submatrix(R, cardinality(n), cardinality(n),
        submatrix(R, n, n, adjugate(cardinality(n), R.carrier, R.add, R.zero,
          R.neg, R.mul, R.one,
          submatrix(R, cardinality(n), cardinality(n), A, e, e)),
          converse(e, cardinality(n), n), converse(e, cardinality(n), n)), f, f))
    unfold RingMatrix
    exact ringThere
  have entries := submatrix.enumeration_entries at R, n, A, e, f
    with ring, matrix, first, second
  apply RingMatrix.ext with ringLeft, adjF
  intros a ha b hb
  have fa := FunctionBetween.apply_closed with fFunction, ha
  have fb := FunctionBetween.apply_closed with fFunction, hb
  have value1 := submatrix.at at R, n, n, cardinality(n), cardinality(n),
    submatrix(R, n, n, adjugate(cardinality(n), R.carrier, R.add, R.zero,
      R.neg, R.mul, R.one, submatrix(R, cardinality(n), cardinality(n), A, e, e)),
      converse(e, cardinality(n), n), converse(e, cardinality(n), n)), f, f, a, b
    with back, fFunction, fFunction, ha, hb
  have value2 := submatrix.at at R, cardinality(n), cardinality(n), n, n,
    adjugate(cardinality(n), R.carrier, R.add, R.zero, R.neg, R.mul, R.one,
      submatrix(R, cardinality(n), cardinality(n), A, e, e)),
    converse(e, cardinality(n), n), converse(e, cardinality(n), n), f(a), f(b)
    with adjSpace, inverseFunction, inverseFunction, fa, fb
  have sa := compose.apply at converse(e, cardinality(n), n), f,
    cardinality(n), n, cardinality(n), a with fFunction, inverseFunction, ha
  have sb := compose.apply at converse(e, cardinality(n), n), f,
    cardinality(n), n, cardinality(n), b with fFunction, inverseFunction, hb
  have conjugated := adjugate.conjugate at R.carrier, R.add, R.zero, R.neg,
    R.mul, R.one, cardinality(n),
    submatrix(R, cardinality(n), cardinality(n), A, e, e),
    submatrix(R, cardinality(n), cardinality(n), A, f, f),
    compose(converse(e, cardinality(n), n), f, cardinality(n), n,
      cardinality(n)), a, b
    with parts, ringE, ringF, permutation, entries, ha, hb
  rw [value1, value2, conjugated, sa, sb]

-- det A along one enumeration.
theorem matDet.transported (n A e : Set)
  requires finite : Finite(n)
  requires matrix : A ∈ matrixSpace(R, n, n)
  requires enumeration : BijectiveBetween(e, cardinality(n), n)
  shows matDet(R, n, A) = determinant(cardinality(n), R.carrier, R.add,
    R.zero, R.neg, R.mul, R.one,
    submatrix(R, cardinality(n), cardinality(n), A, e, e))
proof
  have parts := CommRing.parts with ring
  have count := cardinality.nat at n with finite
  have eFunction := Injective.function with (Bijective.injective with enumeration)
  have matrixE := submatrix.mem_of at R, n, n, cardinality(n), cardinality(n),
    A, e, e with matrix, eFunction, eFunction
  have ringE : RingMatrix(cardinality(n), R.carrier,
      submatrix(R, cardinality(n), cardinality(n), A, e, e))
    unfold RingMatrix
    exact matrixSpace.function with matrixE
  have value := determinant.closed at R.carrier, R.add, R.zero, R.neg, R.mul,
    R.one, submatrix(R, cardinality(n), cardinality(n), A, e, e),
    cardinality(n) with parts, ringE
  have values : matDetValues(R, n, A) = {determinant(cardinality(n), R.carrier,
      R.add, R.zero, R.neg, R.mul, R.one,
      submatrix(R, cardinality(n), cardinality(n), A, e, e))}
    ext d
    constructor
    . intro member
      unfold matDetValues at member
      obtain ⟨dIn, law⟩ := member
      have equal := law with enumeration
      rw singleton.membership
      exact equal
    . intro member
      rw singleton.membership at member
      unfold matDetValues
      constructor
      . rw member
        exact value
      . intros f hf
        rw member
        have agree := matDet.enumerations_agree at R, n, A, e, f
          with ring, finite, matrix, enumeration, hf
        symm
        exact agree
  unfold matDet
  rw [values, union.singleton]

theorem matDet.mem (n A : Set)
  requires finite : Finite(n)
  requires matrix : A ∈ matrixSpace(R, n, n)
  shows matDet(R, n, A) ∈ R.carrier
proof
  have parts := CommRing.parts with ring
  have count := cardinality.nat at n with finite
  obtain ⟨e, enumeration⟩ := Finite.cardinality_enumeration with finite
  have eFunction := Injective.function with (Bijective.injective with enumeration)
  have matrixE := submatrix.mem_of at R, n, n, cardinality(n), cardinality(n),
    A, e, e with matrix, eFunction, eFunction
  have ringE : RingMatrix(cardinality(n), R.carrier,
      submatrix(R, cardinality(n), cardinality(n), A, e, e))
    unfold RingMatrix
    exact matrixSpace.function with matrixE
  have equal := matDet.transported at R, n, A, e
    with ring, finite, matrix, enumeration
  rw equal
  exact determinant.closed at R.carrier, R.add, R.zero, R.neg, R.mul,
    R.one, submatrix(R, cardinality(n), cardinality(n), A, e, e),
    cardinality(n) with parts, ringE

-- det A is Cumulus's determinant of A transported along any enumeration
-- of n (the definition's well-definedness).
theorem matDet.enumeration (n A e : Set)
  requires finite : Finite(n)
  requires matrix : A ∈ matrixSpace(R, n, n)
  requires enumeration : BijectiveBetween(e, cardinality(n), n)
  shows matDet(R, n, A) = determinant(cardinality(n), R.carrier, R.add,
    R.zero, R.neg, R.mul, R.one,
    submatrix(R, cardinality(n), cardinality(n), A, e, e))
proof
  exact matDet.transported at R, n, A, e with ring, finite, matrix, enumeration

-- adj A likewise, entrywise along any enumeration of n.
theorem matAdjugate.enumeration (n A e : Set)
  requires finite : Finite(n)
  requires matrix : A ∈ matrixSpace(R, n, n)
  requires enumeration : BijectiveBetween(e, cardinality(n), n)
  shows matAdjugate(R, n, A) ∈ matrixSpace(R, n, n) ∧
    submatrix(R, cardinality(n), cardinality(n), matAdjugate(R, n, A), e, e) =
      adjugate(cardinality(n), R.carrier, R.add, R.zero, R.neg, R.mul, R.one,
        submatrix(R, cardinality(n), cardinality(n), A, e, e))
proof
  have parts := CommRing.parts with ring
  have count := cardinality.nat at n with finite
  have finiteK := Finite.natural at cardinality(n)
  have eFunction := Injective.function with (Bijective.injective with enumeration)
  have inverseFunction := converse.function_of_bijective with enumeration
  have matrixE := submatrix.mem_of at R, n, n, cardinality(n), cardinality(n),
    A, e, e with matrix, eFunction, eFunction
  have ringE : RingMatrix(cardinality(n), R.carrier,
      submatrix(R, cardinality(n), cardinality(n), A, e, e))
    unfold RingMatrix
    exact matrixSpace.function with matrixE
  have adjE := adjugate.matrix at cardinality(n), R.carrier, R.add, R.zero,
    R.neg, R.mul, R.one, submatrix(R, cardinality(n), cardinality(n), A, e, e)
    with parts, finiteK, ringE
  have adjFunction := adjE
  unfold RingMatrix at adjFunction
  have adjSpace := matrixSpace.of_function with adjFunction
  have back := submatrix.mem_of at R, cardinality(n), cardinality(n), n, n,
    adjugate(cardinality(n), R.carrier, R.add, R.zero, R.neg, R.mul, R.one,
      submatrix(R, cardinality(n), cardinality(n), A, e, e)),
    converse(e, cardinality(n), n), converse(e, cardinality(n), n)
    with adjSpace, inverseFunction, inverseFunction
  have values : matAdjugateValues(R, n, A) = {submatrix(R, n, n,
      adjugate(cardinality(n), R.carrier, R.add, R.zero, R.neg, R.mul, R.one,
        submatrix(R, cardinality(n), cardinality(n), A, e, e)),
      converse(e, cardinality(n), n), converse(e, cardinality(n), n))}
    ext B
    constructor
    . intro member
      unfold matAdjugateValues at member
      obtain ⟨BIn, law⟩ := member
      have equal := law with enumeration
      rw singleton.membership
      have extension := matrixSpace.ext at R, n, n, B, submatrix(R, n, n,
        adjugate(cardinality(n), R.carrier, R.add, R.zero, R.neg, R.mul, R.one,
          submatrix(R, cardinality(n), cardinality(n), A, e, e)),
        converse(e, cardinality(n), n), converse(e, cardinality(n), n))
        with ring, BIn, back
      apply extension.backward
      intros x hx y hy
      have gx := FunctionBetween.apply_closed with inverseFunction, hx
      have gy := FunctionBetween.apply_closed with inverseFunction, hy
      have valueBack := submatrix.at at R, cardinality(n), cardinality(n), n, n,
        adjugate(cardinality(n), R.carrier, R.add, R.zero, R.neg, R.mul, R.one,
          submatrix(R, cardinality(n), cardinality(n), A, e, e)),
        converse(e, cardinality(n), n), converse(e, cardinality(n), n), x, y
        with adjSpace, inverseFunction, inverseFunction, hx, hy
      have valueB := submatrix.at at R, n, n, cardinality(n), cardinality(n), B,
        e, e, converse(e, cardinality(n), n)(x), converse(e, cardinality(n), n)(y)
        with BIn, eFunction, eFunction, gx, gy
      have bx := Bijective.apply_inverse at e, cardinality(n), n, x
        with enumeration, hx
      have by := Bijective.apply_inverse at e, cardinality(n), n, y
        with enumeration, hy
      rw [bx, by, equal] at valueB
      rw valueBack
      symm
      exact valueB
    . intro member
      rw singleton.membership at member
      unfold matAdjugateValues
      constructor
      . rw member
        exact back
      . intros f hf
        rw member
        exact matAdjugate.transported at R, n, A, e, f
          with ring, finite, matrix, enumeration, hf
  have collapse : matAdjugate(R, n, A) = submatrix(R, n, n,
      adjugate(cardinality(n), R.carrier, R.add, R.zero, R.neg, R.mul, R.one,
        submatrix(R, cardinality(n), cardinality(n), A, e, e)),
      converse(e, cardinality(n), n), converse(e, cardinality(n), n))
    unfold matAdjugate
    rw [values, union.singleton]
  rw collapse
  constructor
  . exact back
  . exact matAdjugate.transported at R, n, A, e, e
      with ring, finite, matrix, enumeration, enumeration

-- On a natural number k, matDet is Cumulus's determinant at k.
theorem matDet.of_nat (k : Nat) (X : Set)
  requires matrix : X ∈ matrixSpace(R, k, k)
  shows matDet(R, k, X) = determinant(k, R.carrier, R.add, R.zero, R.neg,
    R.mul, R.one, X)
proof
  have finite := Finite.natural at k
  have count := cardinality.natural at k
  have identityPermutation := permutations.identity at k
  have bijective := permutations.bijective with identityPermutation
  have enumeration : BijectiveBetween(identity(k), cardinality(k), k)
    rw count
    exact bijective
  have equal := matDet.transported at R, k, X, identity(k)
    with ring, finite, matrix, enumeration
  rw count at equal
  have identityFunction := permutations.function with identityPermutation
  have moved := submatrix.mem_of at R, k, k, k, k, X, identity(k), identity(k)
    with matrix, identityFunction, identityFunction
  have extension := matrixSpace.ext at R, k, k,
    submatrix(R, k, k, X, identity(k), identity(k)), X with ring, moved, matrix
  have same : submatrix(R, k, k, X, identity(k), identity(k)) = X
    apply extension.backward
    intros i hi j hj
    have value := submatrix.at at R, k, k, k, k, X, identity(k), identity(k),
      i, j with matrix, identityFunction, identityFunction, hi, hj
    have fi := identity.apply at i, k with hi
    have fj := identity.apply at j, k with hj
    rw [value, fi, fj]
  rw same at equal
  exact equal

-- det along an enumeration e : card(n) → n, as matDet at card(n).
theorem matDet.along (n X e : Set)
  requires finite : Finite(n)
  requires matrix : X ∈ matrixSpace(R, n, n)
  requires enumeration : BijectiveBetween(e, cardinality(n), n)
  shows matDet(R, n, X) = matDet(R, cardinality(n),
    submatrix(R, cardinality(n), cardinality(n), X, e, e))
proof
  have count := cardinality.nat at n with finite
  have eFunction := Injective.function with (Bijective.injective with enumeration)
  have moved := submatrix.mem_of at R, n, n, cardinality(n), cardinality(n),
    X, e, e with matrix, eFunction, eFunction
  have equal := matDet.transported at R, n, X, e
    with ring, finite, matrix, enumeration
  have atNat := matDet.of_nat at R, cardinality(n),
    submatrix(R, cardinality(n), cardinality(n), X, e, e) with ring, moved
  rw [equal, atNat]

-- On k ∈ ℕ the entries of a product are Cumulus's product entries.
theorem matMul.nat_entry (k : Nat) (X Y i j : Set)
  requires first : X ∈ matrixSpace(R, k, k)
  requires second : Y ∈ matrixSpace(R, k, k)
  requires row : i ∈ k
  requires column : j ∈ k
  shows matMul(R, k, k, k, X, Y)[i, j] = matrixProductEntry(k, R.carrier,
    R.add, R.zero, R.neg, R.mul, R.one, X, Y, i, j)
proof
  have finite := Finite.natural at k
  have mulEq := squareMatrixRing.mul_eq at R, k, X, Y
    with ring, finite, first, second
  have natRing := squareMatrixRing.nat at R, k with ring
  have mulOf := matrixRing.mulOf at R, k
  rw [natRing, mulOf] at mulEq
  have same : matrixSpace(R, k, k) = squareMatrices(R, k)
    rw matrixSpace.eq
    unfold squareMatrices
    rfl
  have squareX := first
  rw same at squareX
  have squareY := second
  rw same at squareY
  have applied := matrixMultiplication.apply at R, k, X, Y
    with ring, squareX, squareY
  rw applied at mulEq
  rw ← mulEq
  exact matrixProduct.entry at R, k, X, Y, i, j
    with ring, squareX, squareY, row, column

theorem matDet.mul_nat (k : Nat) (X Y : Set)
  requires first : X ∈ matrixSpace(R, k, k)
  requires second : Y ∈ matrixSpace(R, k, k)
  shows matDet(R, k, matMul(R, k, k, k, X, Y)) =
    matDet(R, k, X) * matDet(R, k, Y)
proof
  have parts := CommRing.parts with ring
  have finite := Finite.natural at k
  have product := matMul.mem_of at R, k, k, k, X, Y
    with ring, finite, first, second
  have dP := matDet.of_nat at R, k, matMul(R, k, k, k, X, Y) with ring, product
  have dX := matDet.of_nat at R, k, X with ring, first
  have dY := matDet.of_nat at R, k, Y with ring, second
  have ringX : RingMatrix(k, R.carrier, X)
    unfold RingMatrix
    exact matrixSpace.function with first
  have ringY : RingMatrix(k, R.carrier, Y)
    unfold RingMatrix
    exact matrixSpace.function with second
  have ringP : RingMatrix(k, R.carrier, matMul(R, k, k, k, X, Y))
    unfold RingMatrix
    exact matrixSpace.function with product
  have entries : ∀ i ∈ k, ∀ j ∈ k, matMul(R, k, k, k, X, Y)[i, j] =
      matrixProductEntry(k, R.carrier, R.add, R.zero, R.neg, R.mul, R.one,
        X, Y, i, j)
    intros i hi j hj
    exact matMul.nat_entry at R, k, X, Y, i, j
      with ring, first, second, hi, hj
  rw [dP, dX, dY]
  exact determinant.product at R.carrier, R.add, R.zero, R.neg, R.mul, R.one,
    k, X, Y, matMul(R, k, k, k, X, Y) with parts, ringX, ringY, ringP, entries

-- Two n × n matrices agreeing along an enumeration are equal.
theorem matrixSpace.ext_along (n X Y e : Set)
  requires first : X ∈ matrixSpace(R, n, n)
  requires second : Y ∈ matrixSpace(R, n, n)
  requires enumeration : BijectiveBetween(e, cardinality(n), n)
  requires entries : ∀ i ∈ cardinality(n), ∀ j ∈ cardinality(n),
    X[e(i), e(j)] = Y[e(i), e(j)]
  shows X = Y
proof
  have inverseFunction := converse.function_of_bijective with enumeration
  have extension := matrixSpace.ext at R, n, n, X, Y with ring, first, second
  apply extension.backward
  intros x hx y hy
  have gx := FunctionBetween.apply_closed with inverseFunction, hx
  have gy := FunctionBetween.apply_closed with inverseFunction, hy
  have bx := Bijective.apply_inverse at e, cardinality(n), n, x
    with enumeration, hx
  have by := Bijective.apply_inverse at e, cardinality(n), n, y
    with enumeration, hy
  have value := entries with converse(e, cardinality(n), n)(x), gx,
    converse(e, cardinality(n), n)(y), gy
  rw [bx, by] at value
  exact value

theorem matScalar.mem_of (n a : Set)
  requires scalar : a ∈ R.carrier
  shows matScalar(R, n, a) ∈ matrixSpace(R, n, n)
proof
  have constant := constantFunction.function at n, R.carrier, a with scalar
  have vector := functionSpace.mem_iff.backward with constant
  unfold matScalar
  exact matDiagonal.mem_of at R, n, constantFunction(n, R.carrier, a)
    with ring, vector

theorem matScalar.entry_of (n a i j : Set)
  requires scalar : a ∈ R.carrier
  requires row : i ∈ n
  requires column : j ∈ n
  shows (i = j → matScalar(R, n, a)[i, j] = a) ∧
    (i ≠ j → matScalar(R, n, a)[i, j] = R.zero)
proof
  have constant := constantFunction.function at n, R.carrier, a with scalar
  have vector := functionSpace.mem_iff.backward with constant
  have law := matDiagonal.entry at R, n, constantFunction(n, R.carrier, a), i, j
    with ring, vector, row, column
  have c := constantFunction.apply at n, R.carrier, i, a with row, scalar
  rw c at law
  unfold matScalar
  exact law

-- The product of A and its adjugate along an enumeration, entrywise.
theorem matAdjugate.product_along (n A e i j : Set)
  requires finite : Finite(n)
  requires matrix : A ∈ matrixSpace(R, n, n)
  requires enumeration : BijectiveBetween(e, cardinality(n), n)
  requires row : i ∈ cardinality(n)
  requires column : j ∈ cardinality(n)
  shows matMul(R, n, n, n, A, matAdjugate(R, n, A))[e(i), e(j)] =
      matrixProductEntry(cardinality(n), R.carrier, R.add, R.zero, R.neg,
        R.mul, R.one, submatrix(R, cardinality(n), cardinality(n), A, e, e),
        adjugate(cardinality(n), R.carrier, R.add, R.zero, R.neg, R.mul, R.one,
          submatrix(R, cardinality(n), cardinality(n), A, e, e)), i, j) ∧
    matMul(R, n, n, n, matAdjugate(R, n, A), A)[e(i), e(j)] =
      matrixProductEntry(cardinality(n), R.carrier, R.add, R.zero, R.neg,
        R.mul, R.one,
        adjugate(cardinality(n), R.carrier, R.add, R.zero, R.neg, R.mul, R.one,
          submatrix(R, cardinality(n), cardinality(n), A, e, e)),
        submatrix(R, cardinality(n), cardinality(n), A, e, e), i, j)
proof
  have count := cardinality.nat at n with finite
  have eFunction := Injective.function with (Bijective.injective with enumeration)
  have transported := matAdjugate.enumeration at R, n, A, e
    with ring, finite, matrix, enumeration
  obtain ⟨adjIn, adjAlong⟩ := transported
  have movedA := submatrix.mem_of at R, n, n, cardinality(n), cardinality(n),
    A, e, e with matrix, eFunction, eFunction
  have movedAdj := submatrix.mem_of at R, n, n, cardinality(n), cardinality(n),
    matAdjugate(R, n, A), e, e with adjIn, eFunction, eFunction
  rw adjAlong at movedAdj
  have productR := matMul.mem_of at R, n, n, n, A, matAdjugate(R, n, A)
    with ring, finite, matrix, adjIn
  have productL := matMul.mem_of at R, n, n, n, matAdjugate(R, n, A), A
    with ring, finite, adjIn, matrix
  have movedR := submatrix.mul at R, n, n, n, cardinality(n), cardinality(n),
    cardinality(n), A, matAdjugate(R, n, A), e, e, e
    with ring, finite, matrix, adjIn, eFunction, enumeration, eFunction
  have movedL := submatrix.mul at R, n, n, n, cardinality(n), cardinality(n),
    cardinality(n), matAdjugate(R, n, A), A, e, e, e
    with ring, finite, adjIn, matrix, eFunction, enumeration, eFunction
  rw adjAlong at movedR
  rw adjAlong at movedL
  have atR := submatrix.at at R, n, n, cardinality(n), cardinality(n),
    matMul(R, n, n, n, A, matAdjugate(R, n, A)), e, e, i, j
    with productR, eFunction, eFunction, row, column
  have atL := submatrix.at at R, n, n, cardinality(n), cardinality(n),
    matMul(R, n, n, n, matAdjugate(R, n, A), A), e, e, i, j
    with productL, eFunction, eFunction, row, column
  rw ← movedR at atR
  rw ← movedL at atL
  have natR := matMul.nat_entry at R, cardinality(n),
    submatrix(R, cardinality(n), cardinality(n), A, e, e),
    adjugate(cardinality(n), R.carrier, R.add, R.zero, R.neg, R.mul, R.one,
      submatrix(R, cardinality(n), cardinality(n), A, e, e)), i, j
    with ring, movedA, movedAdj, row, column
  have natL := matMul.nat_entry at R, cardinality(n),
    adjugate(cardinality(n), R.carrier, R.add, R.zero, R.neg, R.mul, R.one,
      submatrix(R, cardinality(n), cardinality(n), A, e, e)),
    submatrix(R, cardinality(n), cardinality(n), A, e, e), i, j
    with ring, movedAdj, movedA, row, column
  constructor
  . rw [← atR, natR]
  . rw [← atL, natL]

-- Section: Scalar helpers
theorem matMul.smul_right (m n p a A B : Set)
  requires finite : Finite(n)
  requires scalar : a ∈ R.carrier
  requires first : A ∈ matrixSpace(R, m, n)
  requires second : B ∈ matrixSpace(R, n, p)
  shows matMul(R, m, n, p, A, matSmul(R, n, p, a, B)) =
    matSmul(R, m, p, a, matMul(R, m, n, p, A, B))
proof
  have aB := matSmul.mem_of at R, n, p, a, B with ring, scalar, second
  have left := matMul.mem_of at R, m, n, p, A, matSmul(R, n, p, a, B)
    with ring, finite, first, aB
  have ab := matMul.mem_of at R, m, n, p, A, B with ring, finite, first, second
  have right := matSmul.mem_of at R, m, p, a, matMul(R, m, n, p, A, B)
    with ring, scalar, ab
  apply (matrixSpace.ext at R, m, p, matMul(R, m, n, p, A, matSmul(R, n, p, a, B)),
    matSmul(R, m, p, a, matMul(R, m, n, p, A, B)) with ring, left, right).backward
  intros i hi k hk
  have rowA := matRow.space at R, m, n, A, i with ring, first, hi
  have colBB := matCol.space at R, n, p, matSmul(R, n, p, a, B), k
    with ring, aB, hk
  have colB := matCol.space at R, n, p, B, k with ring, second, hk
  have e1 := matMul.at at R, m, n, p, A, matSmul(R, n, p, a, B), i, k
    with ring, finite, first, aB, hi, hk
  have e2 := matSmul.at at R, m, p, a, matMul(R, m, n, p, A, B), i, k
    with ring, scalar, ab, hi, hk
  have e3 := matMul.at at R, m, n, p, A, B, i, k
    with ring, finite, first, second, hi, hk
  rw [e1, e2, e3]
  apply vecDot.scale_of at R, n, matRow(R, n, A, i),
    matCol(R, n, matSmul(R, n, p, a, B), k), a, matRow(R, n, A, i),
    matCol(R, n, B, k) with ring, finite, scalar, rowA, colBB, rowA, colB
  intros j hj
  have x := matrixSpace.entry_mem with first, hi, hj
  have y := matrixSpace.entry_mem with second, hj, hk
  have f1 := matCol.at at R, n, p, matSmul(R, n, p, a, B), j, k
    with ring, aB, hj, hk
  have f2 := matRow.at at R, m, n, A, i, j with ring, first, hi, hj
  have f3 := matCol.at at R, n, p, B, j, k with ring, second, hj, hk
  have f4 := matSmul.at at R, n, p, a, B, j, k with ring, scalar, second, hj, hk
  rw [f1, f2, f3, f4]
  ring

theorem matSmul.scalar (n a d : Set)
  requires first : a ∈ R.carrier
  requires second : d ∈ R.carrier
  shows matSmul(R, n, n, a, matScalar(R, n, d)) = matScalar(R, n, a * d)
proof
  have ringR := CommRing.to_ring with ring
  have zeroIn := Ring.zero_mem at R with ringR
  have product := Ring.mul_mem at R, a, d with ringR, first, second
  have scalarD := matScalar.mem_of at R, n, d with ring, second
  have scaled := matSmul.mem_of at R, n, n, a, matScalar(R, n, d)
    with ring, first, scalarD
  have scalarAD := matScalar.mem_of at R, n, a * d with ring, product
  apply (matrixSpace.ext at R, n, n, matSmul(R, n, n, a, matScalar(R, n, d)),
    matScalar(R, n, a * d) with ring, scaled, scalarAD).backward
  intros i hi j hj
  have value := matSmul.entry at R, n, n, a, matScalar(R, n, d), i, j
    with ring, first, scalarD, hi, hj
  have entryD := matScalar.entry_of at R, n, d, i, j with ring, second, hi, hj
  have entryAD := matScalar.entry_of at R, n, a * d, i, j
    with ring, product, hi, hj
  rw value
  have alternatives : i = j ∨ i ≠ j by tauto
  cases alternatives with same | different
  . have v1 := entryD.left with same
    have v2 := entryAD.left with same
    rw [v1, v2]
  . have v1 := entryD.right with different
    have v2 := entryAD.right with different
    rw [v1, v2]
    ring

theorem matScalar.one (n : Set)
  shows matScalar(R, n, R.one) = matOne(R, n)
proof
  unfold matScalar
  unfold matOne
  rfl

theorem ringInverse.mul_left (a : Set)
  requires unit : RingUnit(R, a)
  shows ringInverse(R, a) * a = R.one
proof
  have ringR := CommRing.to_ring with ring
  have selected := ringInverse.selected at R, a with ringR, unit
  obtain ⟨_, _, left⟩ := selected
  exact left

theorem ringInverse.mem (a : Set)
  requires unit : RingUnit(R, a)
  shows ringInverse(R, a) ∈ R.carrier
proof
  have ringR := CommRing.to_ring with ring
  have selected := ringInverse.selected at R, a with ringR, unit
  obtain ⟨inside, _, _⟩ := selected
  exact inside

theorem ringInverse.right_law (a : Set)
  requires unit : RingUnit(R, a)
  shows a * ringInverse(R, a) = R.one
proof
  have ringR := CommRing.to_ring with ring
  have selected := ringInverse.selected at R, a with ringR, unit
  obtain ⟨_, right, _⟩ := selected
  exact right

theorem matTranspose.one (n : Set)
  shows matTranspose(R, n, n, matOne(R, n)) = matOne(R, n)
proof
  have oneIn := matOne.mem_of at R, n with ring
  have transposed := matTranspose.mem_of at R, n, n, matOne(R, n)
    with ring, oneIn
  apply (matrixSpace.ext at R, n, n, matTranspose(R, n, n, matOne(R, n)),
    matOne(R, n) with ring, transposed, oneIn).backward
  intros x hx y hy
  have flip := matTranspose.entry at R, n, n, matOne(R, n), y, x
    with ring, oneIn, hy, hx
  have first := matOne.entry at R, n, y, x with ring, hy, hx
  have second := matOne.entry at R, n, x, y with ring, hx, hy
  rw flip
  have alternatives : x = y ∨ x ≠ y by tauto
  cases alternatives with same | different
  . have reverse : y = x by cc
    have v1 := first.left with reverse
    have v2 := second.left with same
    rw [v1, v2]
  . have reverse : y ≠ x
      intro e
      apply different
      symm
      exact e
    have v1 := first.right with reverse
    have v2 := second.right with different
    rw [v1, v2]

-- det A det B = 1 makes det A a unit.
theorem RingUnit.of_product (a b : Set)
  requires first : a ∈ R.carrier
  requires second : b ∈ R.carrier
  requires product : a * b = R.one
  shows RingUnit(R, a)
proof
  have swapped : b * a = R.one
    have e : b * a = a * b by ring
    rw [e, product]
  unfold RingUnit
  exact ⟨first, b, second, product, swapped⟩

-- On n = {0, …, n − 1} it is Cumulus's det.
theorem matDet.nat (n : Nat) (A : Set)
  requires matrix : A : R ^ n × n
  shows matDet(R, n, A) = det(A)
proof
  have function := Matrix.function with matrix
  have space := matrixSpace.of_function with function
  exact matDet.of_nat at R, n, A with ring, space

-- Matrix.det_mul.
theorem matDet.mul (n A B : Set)
  requires finite : Finite(n)
  requires first : A ∈ matrixSpace(R, n, n)
  requires second : B ∈ matrixSpace(R, n, n)
  shows matDet(R, n, matMul(R, n, n, n, A, B)) = matDet(R, n, A) * matDet(R, n, B)
proof
  have count := cardinality.nat at n with finite
  obtain ⟨e, enumeration⟩ := Finite.cardinality_enumeration with finite
  have eFunction := Injective.function with (Bijective.injective with enumeration)
  have product := matMul.mem_of at R, n, n, n, A, B
    with ring, finite, first, second
  have movedA := submatrix.mem_of at R, n, n, cardinality(n), cardinality(n),
    A, e, e with first, eFunction, eFunction
  have movedB := submatrix.mem_of at R, n, n, cardinality(n), cardinality(n),
    B, e, e with second, eFunction, eFunction
  have alongP := matDet.along at R, n, matMul(R, n, n, n, A, B), e
    with ring, finite, product, enumeration
  have alongA := matDet.along at R, n, A, e with ring, finite, first, enumeration
  have alongB := matDet.along at R, n, B, e with ring, finite, second, enumeration
  have moved := submatrix.mul at R, n, n, n, cardinality(n), cardinality(n),
    cardinality(n), A, B, e, e, e
    with ring, finite, first, second, eFunction, enumeration, eFunction
  rw [alongP, alongA, alongB, ← moved]
  exact matDet.mul_nat at R, cardinality(n),
    submatrix(R, cardinality(n), cardinality(n), A, e, e),
    submatrix(R, cardinality(n), cardinality(n), B, e, e)
    with ring, movedA, movedB

theorem matDet.one (n : Set)
  requires finite : Finite(n)
  shows matDet(R, n, matOne(R, n)) = R.one
proof
  obtain ⟨e, enumeration⟩ := Finite.cardinality_enumeration with finite
  have parts := CommRing.parts with ring
  have count := cardinality.nat at n with finite
  have eFunction := Injective.function with (Bijective.injective with enumeration)
  have distinct := Injective.distinct_values with (Bijective.injective with enumeration)
  have oneIn := matOne.mem_of at R, n with ring
  have moved := submatrix.mem_of at R, n, n, cardinality(n), cardinality(n),
    matOne(R, n), e, e with oneIn, eFunction, eFunction
  have ringE : RingMatrix(cardinality(n), R.carrier,
      submatrix(R, cardinality(n), cardinality(n), matOne(R, n), e, e))
    unfold RingMatrix
    exact matrixSpace.function with moved
  have along := matDet.along at R, n, matOne(R, n), e
    with ring, finite, oneIn, enumeration
  have atNat := matDet.of_nat at R, cardinality(n),
    submatrix(R, cardinality(n), cardinality(n), matOne(R, n), e, e)
    with ring, moved
  have diagonal : ∀ i ∈ cardinality(n),
      submatrix(R, cardinality(n), cardinality(n), matOne(R, n), e, e)[i, i] =
      R.one
    intros i hi
    have ei := FunctionBetween.apply_closed with eFunction, hi
    have value := submatrix.at at R, n, n, cardinality(n), cardinality(n),
      matOne(R, n), e, e, i, i with oneIn, eFunction, eFunction, hi, hi
    have entry := matOne.entry at R, n, e(i), e(i) with ring, ei, ei
    have reflexive : e(i) = e(i) by rfl
    have unit := entry.left with reflexive
    rw [value, unit]
  have offDiagonal : ∀ i ∈ cardinality(n), ∀ j ∈ cardinality(n), i ≠ j →
      submatrix(R, cardinality(n), cardinality(n), matOne(R, n), e, e)[i, j] =
      R.zero
    intros i hi j hj different
    have ei := FunctionBetween.apply_closed with eFunction, hi
    have ej := FunctionBetween.apply_closed with eFunction, hj
    have value := submatrix.at at R, n, n, cardinality(n), cardinality(n),
      matOne(R, n), e, e, i, j with oneIn, eFunction, eFunction, hi, hj
    have entry := matOne.entry at R, n, e(i), e(j) with ring, ei, ej
    have apart : e(i) ≠ e(j)
      intro equal
      apply different
      exact distinct with i, hi, j, hj, equal
    have vanish := entry.right with apart
    rw [value, vanish]
  rw [along, atNat]
  exact determinant.identity_entries at R.carrier, R.add, R.zero, R.neg, R.mul,
    R.one, cardinality(n),
    submatrix(R, cardinality(n), cardinality(n), matOne(R, n), e, e)
    with parts, ringE, diagonal, offDiagonal

-- Matrix.det_transpose.
theorem matDet.transpose (n A : Set)
  requires finite : Finite(n)
  requires matrix : A ∈ matrixSpace(R, n, n)
  shows matDet(R, n, matTranspose(R, n, n, A)) = matDet(R, n, A)
proof
  obtain ⟨e, enumeration⟩ := Finite.cardinality_enumeration with finite
  have parts := CommRing.parts with ring
  have count := cardinality.nat at n with finite
  have eFunction := Injective.function with (Bijective.injective with enumeration)
  have transposeIn := matTranspose.mem_of at R, n, n, A with ring, matrix
  have movedA := submatrix.mem_of at R, n, n, cardinality(n), cardinality(n),
    A, e, e with matrix, eFunction, eFunction
  have movedT := submatrix.mem_of at R, n, n, cardinality(n), cardinality(n),
    matTranspose(R, n, n, A), e, e with transposeIn, eFunction, eFunction
  have ringA : RingMatrix(cardinality(n), R.carrier,
      submatrix(R, cardinality(n), cardinality(n), A, e, e))
    unfold RingMatrix
    exact matrixSpace.function with movedA
  have ringT : RingMatrix(cardinality(n), R.carrier,
      submatrix(R, cardinality(n), cardinality(n), matTranspose(R, n, n, A), e, e))
    unfold RingMatrix
    exact matrixSpace.function with movedT
  have alongA := matDet.along at R, n, A, e with ring, finite, matrix, enumeration
  have alongT := matDet.along at R, n, matTranspose(R, n, n, A), e
    with ring, finite, transposeIn, enumeration
  have natA := matDet.of_nat at R, cardinality(n),
    submatrix(R, cardinality(n), cardinality(n), A, e, e) with ring, movedA
  have natT := matDet.of_nat at R, cardinality(n),
    submatrix(R, cardinality(n), cardinality(n), matTranspose(R, n, n, A), e, e)
    with ring, movedT
  have entries : ∀ i ∈ cardinality(n), ∀ j ∈ cardinality(n),
      submatrix(R, cardinality(n), cardinality(n), matTranspose(R, n, n, A),
        e, e)[i, j] = submatrix(R, cardinality(n), cardinality(n), A, e, e)[j, i]
    intros i hi j hj
    have ei := FunctionBetween.apply_closed with eFunction, hi
    have ej := FunctionBetween.apply_closed with eFunction, hj
    have left := submatrix.at at R, n, n, cardinality(n), cardinality(n),
      matTranspose(R, n, n, A), e, e, i, j
      with transposeIn, eFunction, eFunction, hi, hj
    have right := submatrix.at at R, n, n, cardinality(n), cardinality(n),
      A, e, e, j, i with matrix, eFunction, eFunction, hj, hi
    have flip := matTranspose.entry at R, n, n, A, e(j), e(i)
      with ring, matrix, ej, ei
    rw [left, right, flip]
  rw [alongA, alongT, natA, natT]
  exact determinant.transpose at R.carrier, R.add, R.zero, R.neg, R.mul, R.one,
    cardinality(n), submatrix(R, cardinality(n), cardinality(n), A, e, e),
    submatrix(R, cardinality(n), cardinality(n), matTranspose(R, n, n, A), e, e)
    with parts, ringA, ringT, entries

-- det along any bijection g : k → n from a natural number.
theorem matDet.along_nat (k : Nat) (n X g : Set)
  requires finite : Finite(n)
  requires matrix : X ∈ matrixSpace(R, n, n)
  requires bijective : BijectiveBetween(g, k, n)
  shows matDet(R, n, X) = matDet(R, k, submatrix(R, k, k, X, g, g))
proof
  have count := cardinality.nat at n with finite
  obtain ⟨e, enumeration⟩ := Finite.cardinality_enumeration with finite
  have same := Bijective.natural_domain_unique at n, g, e, k, cardinality(n)
    with bijective, enumeration
  have moved : BijectiveBetween(g, cardinality(n), n)
    rw ← same
    exact bijective
  have along := matDet.along at R, n, X, g with ring, finite, matrix, moved
  rw ← same at along
  exact along

-- det A through the rows of the transpose, along an enumeration.
theorem matDet.columns_along (n X e : Set)
  requires finite : Finite(n)
  requires matrix : X ∈ matrixSpace(R, n, n)
  requires enumeration : BijectiveBetween(e, cardinality(n), n)
  shows matDet(R, n, X) = determinant(cardinality(n), R.carrier, R.add, R.zero,
      R.neg, R.mul, R.one, submatrix(R, cardinality(n), cardinality(n),
        matTranspose(R, n, n, X), e, e)) ∧
    RingMatrix(cardinality(n), R.carrier, submatrix(R, cardinality(n),
      cardinality(n), matTranspose(R, n, n, X), e, e)) ∧
    (∀ i ∈ cardinality(n), ∀ j ∈ cardinality(n), submatrix(R, cardinality(n),
      cardinality(n), matTranspose(R, n, n, X), e, e)[i, j] = X[e(j), e(i)])
proof
  have count := cardinality.nat at n with finite
  have eFunction := Injective.function with (Bijective.injective with enumeration)
  have transposeIn := matTranspose.mem_of at R, n, n, X with ring, matrix
  have moved := submatrix.mem_of at R, n, n, cardinality(n), cardinality(n),
    matTranspose(R, n, n, X), e, e with transposeIn, eFunction, eFunction
  have flip := matDet.transpose at R, n, X with ring, finite, matrix
  have along := matDet.transported at R, n, matTranspose(R, n, n, X), e
    with ring, finite, transposeIn, enumeration
  have ringT : RingMatrix(cardinality(n), R.carrier, submatrix(R,
      cardinality(n), cardinality(n), matTranspose(R, n, n, X), e, e))
    unfold RingMatrix
    exact matrixSpace.function with moved
  have entries : ∀ i ∈ cardinality(n), ∀ j ∈ cardinality(n), submatrix(R,
      cardinality(n), cardinality(n), matTranspose(R, n, n, X), e, e)[i, j] =
      X[e(j), e(i)]
    intros i hi j hj
    have ei := FunctionBetween.apply_closed with eFunction, hi
    have ej := FunctionBetween.apply_closed with eFunction, hj
    have value := submatrix.at at R, n, n, cardinality(n), cardinality(n),
      matTranspose(R, n, n, X), e, e, i, j
      with transposeIn, eFunction, eFunction, hi, hj
    have swap := matTranspose.entry at R, n, n, X, e(j), e(i)
      with ring, matrix, ej, ei
    rw [value, swap]
  rw [← flip, along]
  exact ⟨rfl, ringT, entries⟩

-- The matrix with column j replaced by c, as a function, and its entries.
theorem updateColumn.graph_function (m n A j c : Set)
  requires matrix : A ∈ matrixSpace(R, m, n)
  requires vector : c ∈ functionSpace(m, R.carrier)
  shows updateColumn(R, m, n, A, j, c) : m × n → R.carrier
proof
  constructor
    intros q0 member
    obtain ⟨bounded, rest⟩ := updateColumn.membership.forward with member
    exact bounded
  . constructor
      intros z0 first r1 second r2
      unfold relates at r1
      unfold relates at r2
      obtain ⟨_, i1, hi1, k1, hk1, c1⟩ := updateColumn.membership.forward with r1
      obtain ⟨_, i2, hi2, k2, hk2, c2⟩ := updateColumn.membership.forward with r2
      cases c1 with d1 | o1
      . obtain ⟨e1, s1⟩ := d1
        obtain ⟨z1, f1⟩ := orderedPair.injective with s1
        cases c2 with d2 | o2
        . obtain ⟨e2, s2⟩ := d2
          obtain ⟨z2, f2⟩ := orderedPair.injective with s2
          rw z1 at z2
          obtain ⟨ii, kk⟩ := orderedPair.injective with z2
          rw [f1, f2, ii]
        . obtain ⟨e2, s2⟩ := o2
          obtain ⟨z2, f2⟩ := orderedPair.injective with s2
          rw z1 at z2
          obtain ⟨ii, kk⟩ := orderedPair.injective with z2
          exfalso
          have same : k2 = j by cc
          exact e2 with same
      . obtain ⟨e1, s1⟩ := o1
        obtain ⟨z1, f1⟩ := orderedPair.injective with s1
        cases c2 with d2 | o2
        . obtain ⟨e2, s2⟩ := d2
          obtain ⟨z2, f2⟩ := orderedPair.injective with s2
          rw z1 at z2
          obtain ⟨ii, kk⟩ := orderedPair.injective with z2
          exfalso
          have same : k1 = j by cc
          exact e1 with same
        . obtain ⟨e2, s2⟩ := o2
          obtain ⟨z2, f2⟩ := orderedPair.injective with s2
          rw z1 at z2
          obtain ⟨ii, kk⟩ := orderedPair.injective with z2
          rw [f1, f2, ii, kk]
    . intros q0 pIn
      obtain ⟨bound, i, hi, k, hk, shape⟩ := product.membership.forward with pIn
      rw shape
      have pairIn := product.pair at i, k, m, n with hi, hk
      by_cases same : k = j
      . have ci := functionSpace.apply_mem with vector, hi
        have outer := product.pair at (i, k), c(i), m × n, R.carrier with pairIn, ci
        refine ⟨c(i), ci, ?_⟩
        unfold relates
        apply updateColumn.membership.backward
        refine ⟨outer, i, hi, k, hk, ?_⟩
        left
        exact ⟨same, rfl⟩
      . have entry := matrixSpace.entry_mem with matrix, hi, hk
        have outer := product.pair at (i, k), A((i, k)), m × n, R.carrier with pairIn, entry
        refine ⟨A((i, k)), entry, ?_⟩
        unfold relates
        apply updateColumn.membership.backward
        refine ⟨outer, i, hi, k, hk, ?_⟩
        right
        exact ⟨same, rfl⟩

theorem updateColumn.mem_of (m n A j c : Set)
  requires matrix : A ∈ matrixSpace(R, m, n)
  requires vector : c ∈ functionSpace(m, R.carrier)
  shows updateColumn(R, m, n, A, j, c) ∈ matrixSpace(R, m, n)
proof
  have function := updateColumn.graph_function at R, m, n, A, j, c
    with ring, matrix, vector
  exact matrixSpace.of_function with function

theorem updateColumn.entry (m n A j c i k : Set)
  requires matrix : A ∈ matrixSpace(R, m, n)
  requires vector : c ∈ functionSpace(m, R.carrier)
  requires row : i ∈ m
  requires column : k ∈ n
  shows (k = j → updateColumn(R, m, n, A, j, c)[i, k] = c(i)) ∧
    (k ≠ j → updateColumn(R, m, n, A, j, c)[i, k] = A[i, k])
proof
  have function := updateColumn.graph_function at R, m, n, A, j, c
    with ring, matrix, vector
  have pairIn := product.pair at i, k, m, n with row, column
  constructor
  . intro same
    have ci := functionSpace.apply_mem with vector, row
    have outer := product.pair at (i, k), c(i), m × n, R.carrier with pairIn, ci
    have mapped : relates(updateColumn(R, m, n, A, j, c), (i, k), c(i))
      unfold relates
      apply updateColumn.membership.backward
      refine ⟨outer, i, row, k, column, ?_⟩
      left
      exact ⟨same, rfl⟩
    exact FunctionBetween.apply_value with function, pairIn, mapped
  . intro other
    have entry := matrixSpace.entry_mem with matrix, row, column
    have outer := product.pair at (i, k), A((i, k)), m × n, R.carrier with pairIn, entry
    have mapped : relates(updateColumn(R, m, n, A, j, c), (i, k), A((i, k)))
      unfold relates
      apply updateColumn.membership.backward
      refine ⟨outer, i, row, k, column, ?_⟩
      right
      exact ⟨other, rfl⟩
    exact FunctionBetween.apply_value with function, pairIn, mapped

-- The transposed enumeration of updateColumn: the row converse(e)(j) is c,
-- the other rows are those of A.
theorem updateColumn.along (n A j c e i l : Set)
  requires finite : Finite(n)
  requires matrix : A ∈ matrixSpace(R, n, n)
  requires vector : c ∈ functionSpace(n, R.carrier)
  requires enumeration : BijectiveBetween(e, cardinality(n), n)
  requires row : i ∈ cardinality(n)
  requires column : l ∈ cardinality(n)
  shows (e(i) = j → submatrix(R, cardinality(n), cardinality(n),
      matTranspose(R, n, n, updateColumn(R, n, n, A, j, c)), e, e)[i, l] =
      c(e(l))) ∧
    (e(i) ≠ j → submatrix(R, cardinality(n), cardinality(n),
      matTranspose(R, n, n, updateColumn(R, n, n, A, j, c)), e, e)[i, l] =
      A[e(l), e(i)])
proof
  have updated := updateColumn.mem_of at R, n, n, A, j, c
    with ring, matrix, vector
  have columns := matDet.columns_along at R, n, updateColumn(R, n, n, A, j, c), e
    with ring, finite, updated, enumeration
  obtain ⟨_, _, entries⟩ := columns
  have eFunction := Injective.function with (Bijective.injective with enumeration)
  have ei := FunctionBetween.apply_closed with eFunction, row
  have el := FunctionBetween.apply_closed with eFunction, column
  have value := entries with i, row, l, column
  obtain ⟨onColumn, offColumn⟩ := updateColumn.entry at R, n, n, A, j, c, e(l), e(i)
    with ring, matrix, vector, el, ei
  rw value
  constructor
  . intro same
    exact onColumn with same
  . intro other
    exact offColumn with other

-- The diagonal product along an enumeration is the diagonal product.
theorem matDiagProduct.along (n A e : Set)
  requires finite : Finite(n)
  requires matrix : A ∈ matrixSpace(R, n, n)
  requires enumeration : BijectiveBetween(e, cardinality(n), n)
  shows finiteRingProduct(cardinality(n), R.carrier, R.add, R.zero, R.neg,
      R.mul, R.one, permutationEntries(cardinality(n), R.carrier,
        submatrix(R, cardinality(n), cardinality(n), A, e, e),
        identity(cardinality(n)))) = matDiagProduct(R, n, A)
proof
  have parts := CommRing.parts with ring
  have count := cardinality.nat at n with finite
  have finiteK := Finite.natural at cardinality(n)
  have eFunction := Injective.function with (Bijective.injective with enumeration)
  have matrixE := submatrix.mem_of at R, n, n, cardinality(n), cardinality(n),
    A, e, e with matrix, eFunction, eFunction
  have ringE : RingMatrix(cardinality(n), R.carrier,
      submatrix(R, cardinality(n), cardinality(n), A, e, e))
    unfold RingMatrix
    exact matrixSpace.function with matrixE
  have identityBijective := identity.bijective at cardinality(n)
  have weightsW := permutationEntries.function at cardinality(n), R.carrier,
    submatrix(R, cardinality(n), cardinality(n), A, e, e),
    identity(cardinality(n)) with ringE, identityBijective
  have weightsV := matDiag.function_of at R, n, A with ring, matrix
  have values : ∀ i ∈ cardinality(n), permutationEntries(cardinality(n),
      R.carrier, submatrix(R, cardinality(n), cardinality(n), A, e, e),
      identity(cardinality(n)))(i) = matDiag(R, n, A)(e(i))
    intros i hi
    have ei := FunctionBetween.apply_closed with eFunction, hi
    have value := permutationEntries.value at cardinality(n), R.carrier,
      submatrix(R, cardinality(n), cardinality(n), A, e, e),
      identity(cardinality(n)), i with ringE, identityBijective, hi
    have fixed := identity.apply at i, cardinality(n) with hi
    have entry := submatrix.at at R, n, n, cardinality(n), cardinality(n), A,
      e, e, i, i with matrix, eFunction, eFunction, hi, hi
    have diagonal := matDiag.at at R, n, A, e(i) with ring, matrix, ei
    rw [value, fixed, entry, diagonal]
  unfold matDiagProduct
  exact finiteRingProduct.reindex at cardinality(n), n, R.carrier, R.add,
    R.zero, R.neg, R.mul, R.one, permutationEntries(cardinality(n), R.carrier,
      submatrix(R, cardinality(n), cardinality(n), A, e, e),
      identity(cardinality(n))), matDiag(R, n, A), e
    with parts, finiteK, weightsW, weightsV, enumeration, values

-- Matrix.det_diagonal and det_of_upperTriangular: triangular matrices
-- (block-triangular for an order on n itself) have the product of the
-- diagonal as determinant.
theorem matDet.diagonal (n d : Set)
  requires finite : Finite(n)
  requires vector : d ∈ functionSpace(n, R.carrier)
  shows matDet(R, n, matDiagonal(R, n, d)) = finiteRingProduct(n, R.carrier,
    R.add, R.zero, R.neg, R.mul, R.one, d)
proof
  obtain ⟨e, enumeration⟩ := Finite.cardinality_enumeration with finite
  have parts := CommRing.parts with ring
  have count := cardinality.nat at n with finite
  have injective := Bijective.injective with enumeration
  have eFunction := Injective.function with injective
  have diagonalIn := matDiagonal.mem_of at R, n, d with ring, vector
  have matrixE := submatrix.mem_of at R, n, n, cardinality(n), cardinality(n),
    matDiagonal(R, n, d), e, e with diagonalIn, eFunction, eFunction
  have ringE : RingMatrix(cardinality(n), R.carrier,
      submatrix(R, cardinality(n), cardinality(n), matDiagonal(R, n, d), e, e))
    unfold RingMatrix
    exact matrixSpace.function with matrixE
  have off : ∀ i ∈ cardinality(n), ∀ j ∈ cardinality(n), i ≠ j →
      submatrix(R, cardinality(n), cardinality(n), matDiagonal(R, n, d), e,
        e)[i, j] = R.zero
    intros i hi j hj distinct
    have ei := FunctionBetween.apply_closed with eFunction, hi
    have ej := FunctionBetween.apply_closed with eFunction, hj
    have entry := submatrix.at at R, n, n, cardinality(n), cardinality(n),
      matDiagonal(R, n, d), e, e, i, j with diagonalIn, eFunction, eFunction,
      hi, hj
    have apart : e(i) ≠ e(j)
      intro same
      apply distinct
      exact Injective.apply_cancel at e, cardinality(n), n, i, j
        with injective, hi, hj, same
    obtain ⟨_, offValue⟩ := matDiagonal.entry at R, n, d, e(i), e(j)
      with ring, vector, ei, ej
    rw entry
    exact offValue with apart
  have equal := matDet.transported at R, n, matDiagonal(R, n, d), e
    with ring, finite, diagonalIn, enumeration
  have nat := determinant.diagonal_entries at R.carrier, R.add, R.zero,
    R.neg, R.mul, R.one, cardinality(n),
    submatrix(R, cardinality(n), cardinality(n), matDiagonal(R, n, d), e, e)
    with parts, ringE, off
  have along := matDiagProduct.along at R, n, matDiagonal(R, n, d), e
    with ring, finite, diagonalIn, enumeration
  have weightsW := matDiag.function_of at R, n, matDiagonal(R, n, d)
    with ring, diagonalIn
  have weightsV := functionSpace.mem_iff.forward with vector
  have values : ∀ i ∈ n, matDiag(R, n, matDiagonal(R, n, d))(i) = d(i)
    intros i hi
    have value := matDiag.at at R, n, matDiagonal(R, n, d), i
      with ring, diagonalIn, hi
    obtain ⟨onValue, _⟩ := matDiagonal.entry at R, n, d, i, i
      with ring, vector, hi, hi
    rw value
    exact onValue with rfl
  have same := finiteRingProduct.congr at n, R.carrier, R.add, R.zero, R.neg,
    R.mul, R.one, matDiag(R, n, matDiagonal(R, n, d)), d
    with parts, finite, weightsW, weightsV, values
  rw [equal, nat, along]
  unfold matDiagProduct
  exact same

theorem matDet.triangular (n A lt : Set)
  requires finite : Finite(n)
  requires order : StrictLinearOrder(n, lt)
  requires matrix : A ∈ matrixSpace(R, n, n)
  requires triangular : BlockTriangular(R, n, A, identity(n), lt)
  shows matDet(R, n, A) = matDiagProduct(R, n, A)
proof
  obtain ⟨e, enumeration⟩ := Finite.cardinality_enumeration with finite
  have parts := CommRing.parts with ring
  have count := cardinality.nat at n with finite
  have injective := Bijective.injective with enumeration
  have eFunction := Injective.function with injective
  have matrixE := submatrix.mem_of at R, n, n, cardinality(n), cardinality(n),
    A, e, e with matrix, eFunction, eFunction
  have ringE : RingMatrix(cardinality(n), R.carrier,
      submatrix(R, cardinality(n), cardinality(n), A, e, e))
    unfold RingMatrix
    exact matrixSpace.function with matrixE
  have below : ∀ i ∈ cardinality(n), ∀ j ∈ cardinality(n),
      relates(lt, e(j), e(i)) →
      submatrix(R, cardinality(n), cardinality(n), A, e, e)[i, j] = R.zero
    intros i hi j hj related
    have ei := FunctionBetween.apply_closed with eFunction, hi
    have ej := FunctionBetween.apply_closed with eFunction, hj
    have entry := submatrix.at at R, n, n, cardinality(n), cardinality(n), A,
      e, e, i, j with matrix, eFunction, eFunction, hi, hj
    have fi := identity.apply at e(i), n with ei
    have fj := identity.apply at e(j), n with ej
    have ordered : (identity(n)(e(j)), identity(n)(e(i))) ∈ lt
      rw [fi, fj]
      exact related
    rw entry
    exact triangular with e(i), ei, e(j), ej, ordered
  have equal := matDet.transported at R, n, A, e
    with ring, finite, matrix, enumeration
  have nat := determinant.triangular_entries at R.carrier, R.add, R.zero,
    R.neg, R.mul, R.one, cardinality(n),
    submatrix(R, cardinality(n), cardinality(n), A, e, e), n, lt, e
    with parts, ringE, order, injective, below
  have along := matDiagProduct.along at R, n, A, e
    with ring, finite, matrix, enumeration
  rw [equal, nat, along]

-- Matrix.det_smul: det(a A) = a^|n| det A.
theorem matDet.smul (n a A : Set)
  requires finite : Finite(n)
  requires scalar : a ∈ R.carrier
  requires matrix : A ∈ matrixSpace(R, n, n)
  shows matDet(R, n, matSmul(R, n, n, a, A)) =
    monoidPow(R.mul, R.one, a, cardinality(n)) * matDet(R, n, A)
proof
  have parts := CommRing.parts with ring
  have count := cardinality.nat at n with finite
  obtain ⟨e, enumeration⟩ := Finite.cardinality_enumeration with finite
  have finiteK := Finite.natural at cardinality(n)
  have constant := constantFunction.function at n, R.carrier, a with scalar
  have vector := functionSpace.mem_iff.backward with constant
  have constantK := constantFunction.function at cardinality(n), R.carrier, a
    with scalar
  have scalarIn := matScalar.mem_of at R, n, a with ring, scalar
  have product := matScalar.mul at R, n, n, a, A with ring, finite, scalar, matrix
  have multiplicative := matDet.mul at R, n, matScalar(R, n, a), A
    with ring, finite, scalarIn, matrix
  have diagonal := matDet.diagonal at R, n, constantFunction(n, R.carrier, a)
    with ring, finite, vector
  have values : ∀ i ∈ cardinality(n),
      constantFunction(cardinality(n), R.carrier, a)(i) =
      constantFunction(n, R.carrier, a)(e(i))
    intros i hi
    have eFunction := Injective.function with (Bijective.injective with enumeration)
    have ei := FunctionBetween.apply_closed with eFunction, hi
    have c1 := constantFunction.apply at cardinality(n), R.carrier, i, a
      with hi, scalar
    have c2 := constantFunction.apply at n, R.carrier, e(i), a with ei, scalar
    rw [c1, c2]
  have moved := finiteRingProduct.reindex at cardinality(n), n, R.carrier,
    R.add, R.zero, R.neg, R.mul, R.one,
    constantFunction(cardinality(n), R.carrier, a),
    constantFunction(n, R.carrier, a), e
    with parts, finiteK, constantK, constant, enumeration, values
  have power := finiteRingProduct.constant at R.carrier, R.add, R.zero, R.neg,
    R.mul, R.one, cardinality(n), a with parts, scalar
  rw [← product, multiplicative]
  unfold matScalar
  rw [diagonal, ← moved, power]

theorem matMap.mem_of_hom (S m n f A : Set)
  requires hom : RingHom(f, R, S)
  requires matrix : A ∈ matrixSpace(R, m, n)
  shows matMap(S, m, n, f, A) ∈ matrixSpace(S, m, n)
proof
  obtain ⟨_, _, function, _⟩ := hom
  have values : ∀ i ∈ m, ∀ j ∈ n, f(A((i, j))) ∈ S.carrier
    intros i hi j hj
    have entry := matrixSpace.entry_mem with matrix, hi, hj
    exact FunctionBetween.apply_closed with function, entry
  have mapFunction := matMap.graph_function at S, m, n, f, A with values
  exact matrixSpace.of_function with mapFunction

-- Aᴴ is σ applied to Aᵀ.
theorem conjTranspose.as_map (σ n A : Set)
  requires involution : RingInvolution(σ, R)
  requires matrix : A ∈ matrixSpace(R, n, n)
  shows conjTranspose(R, σ, n, n, A) =
    matMap(R, n, n, σ, matTranspose(R, n, n, A))
proof
  have involution0 := involution
  obtain ⟨_, hom, _⟩ := involution0
  have transposeIn := matTranspose.mem_of at R, n, n, A with ring, matrix
  have conjIn := conjTranspose.mem_of at R, σ, n, n, A with involution, matrix
  have mapIn := matMap.mem_of_hom at R, R, n, n, σ, matTranspose(R, n, n, A)
    with ring, hom, transposeIn
  apply (matrixSpace.ext at R, n, n, conjTranspose(R, σ, n, n, A),
    matMap(R, n, n, σ, matTranspose(R, n, n, A)) with ring, conjIn, mapIn).backward
  intros x hx y hy
  have v1 := conjTranspose.entry at R, σ, n, n, A, y, x
    with involution, matrix, hy, hx
  have v2 := matMap.entry at R, R, n, n, σ, matTranspose(R, n, n, A), x, y
    with ring, hom, transposeIn, hx, hy
  have v3 := matTranspose.entry at R, n, n, A, y, x with ring, matrix, hy, hx
  rw [v1, v2, v3]

-- RingHom.map_det.
theorem matDet.map (S n f A : Set)
  requires target : CommRing(S)
  requires finite : Finite(n)
  requires hom : RingHom(f, R, S)
  requires matrix : A ∈ matrixSpace(R, n, n)
  shows f(matDet(R, n, A)) = matDet(S, n, matMap(S, n, n, f, A))
proof
  obtain ⟨e, enumeration⟩ := Finite.cardinality_enumeration with finite
  have count := cardinality.nat at n with finite
  have eFunction := Injective.function with (Bijective.injective with enumeration)
  have isHom := RingHom.parts with hom
  have partsR := CommRing.parts with ring
  have partsS := CommRing.parts with target
  have mapIn := matMap.mem_of_hom at R, S, n, n, f, A with ring, hom, matrix
  have alongR := matDet.transported at R, n, A, e
    with ring, finite, matrix, enumeration
  have alongS := matDet.transported at S, n, matMap(S, n, n, f, A), e
    with target, finite, mapIn, enumeration
  have movedA := submatrix.mem_of at R, n, n, cardinality(n), cardinality(n),
    A, e, e with matrix, eFunction, eFunction
  have movedM := submatrix.mem_of at S, n, n, cardinality(n), cardinality(n),
    matMap(S, n, n, f, A), e, e with mapIn, eFunction, eFunction
  have ringA : RingMatrix(cardinality(n), R.carrier,
      submatrix(R, cardinality(n), cardinality(n), A, e, e))
    unfold RingMatrix
    exact matrixSpace.function with movedA
  have ringM : RingMatrix(cardinality(n), S.carrier,
      submatrix(S, cardinality(n), cardinality(n), matMap(S, n, n, f, A), e, e))
    unfold RingMatrix
    exact matrixSpace.function with movedM
  have entries : ∀ i ∈ cardinality(n), ∀ j ∈ cardinality(n),
      submatrix(S, cardinality(n), cardinality(n), matMap(S, n, n, f, A),
        e, e)[i, j] = f(submatrix(R, cardinality(n), cardinality(n), A, e, e)[i, j])
    intros i hi j hj
    have ei := FunctionBetween.apply_closed with eFunction, hi
    have ej := FunctionBetween.apply_closed with eFunction, hj
    have v1 := submatrix.at at S, n, n, cardinality(n), cardinality(n),
      matMap(S, n, n, f, A), e, e, i, j with mapIn, eFunction, eFunction, hi, hj
    have v2 := submatrix.at at R, n, n, cardinality(n), cardinality(n),
      A, e, e, i, j with matrix, eFunction, eFunction, hi, hj
    have v3 := matMap.entry at R, S, n, n, f, A, e(i), e(j)
      with ring, hom, matrix, ei, ej
    rw [v1, v2, v3]
  rw [alongR, alongS]
  exact determinant.map at R.carrier, R.add, R.zero, R.neg, R.mul, R.one,
    S.carrier, S.add, S.zero, S.neg, S.mul, S.one, f, cardinality(n),
    submatrix(R, cardinality(n), cardinality(n), A, e, e),
    submatrix(S, cardinality(n), cardinality(n), matMap(S, n, n, f, A), e, e)
    with partsR, partsS, isHom, ringA, ringM, entries

-- Matrix.det_conjTranspose: det Aᴴ = σ(det A).
theorem matDet.conjTranspose (σ n A : Set)
  requires involution : RingInvolution(σ, R)
  requires finite : Finite(n)
  requires matrix : A ∈ matrixSpace(R, n, n)
  shows matDet(R, n, conjTranspose(R, σ, n, n, A)) = σ(matDet(R, n, A))
proof
  have involution0 := involution
  obtain ⟨_, hom, _⟩ := involution0
  have transposeIn := matTranspose.mem_of at R, n, n, A with ring, matrix
  have asMap := conjTranspose.as_map at R, σ, n, A with ring, involution, matrix
  have mapped := matDet.map at R, R, n, σ, matTranspose(R, n, n, A)
    with ring, ring, finite, hom, transposeIn
  have flip := matDet.transpose at R, n, A with ring, finite, matrix
  rw [asMap, ← mapped, flip]

-- Matrix.det_submatrix_equiv_self and det_reindex_self: reindexing by a
-- bijection e : n2 → n keeps the determinant.
theorem matDet.reindex (n n2 e A : Set)
  requires finite : Finite(n)
  requires bijective : BijectiveBetween(e, n2, n)
  requires matrix : A ∈ matrixSpace(R, n, n)
  shows matDet(R, n2, submatrix(R, n2, n2, A, e, e)) = matDet(R, n, A)
proof
  have inverse := converse.bijective with bijective
  have finite2 := Finite.of_equipotent at n, n2 with finite, ⟨converse(e, n2, n), inverse⟩
  have count2 := cardinality.nat at n2 with finite2
  obtain ⟨f, enumeration⟩ := Finite.cardinality_enumeration with finite2
  have eFunction := Injective.function with (Bijective.injective with bijective)
  have fFunction := Injective.function with (Bijective.injective with enumeration)
  have composed := compose.bijective at e, f, cardinality(n2), n2, n
    with enumeration, bijective
  have gFunction := Injective.function with (Bijective.injective with composed)
  have moved := submatrix.mem_of at R, n, n, n2, n2, A, e, e
    with matrix, eFunction, eFunction
  have twice := submatrix.mem_of at R, n2, n2, cardinality(n2), cardinality(n2),
    submatrix(R, n2, n2, A, e, e), f, f with moved, fFunction, fFunction
  have once := submatrix.mem_of at R, n, n, cardinality(n2), cardinality(n2),
    A, compose(e, f, cardinality(n2), n2, n), compose(e, f, cardinality(n2), n2, n)
    with matrix, gFunction, gFunction
  have left := matDet.along at R, n2, submatrix(R, n2, n2, A, e, e), f
    with ring, finite2, moved, enumeration
  have right := matDet.along_nat at R, cardinality(n2), n, A,
    compose(e, f, cardinality(n2), n2, n) with ring, finite, matrix, composed
  have same : submatrix(R, cardinality(n2), cardinality(n2),
      submatrix(R, n2, n2, A, e, e), f, f) = submatrix(R, cardinality(n2),
      cardinality(n2), A, compose(e, f, cardinality(n2), n2, n),
      compose(e, f, cardinality(n2), n2, n))
    apply (matrixSpace.ext at R, cardinality(n2), cardinality(n2),
      submatrix(R, cardinality(n2), cardinality(n2),
        submatrix(R, n2, n2, A, e, e), f, f),
      submatrix(R, cardinality(n2), cardinality(n2), A,
        compose(e, f, cardinality(n2), n2, n),
        compose(e, f, cardinality(n2), n2, n)) with ring, twice, once).backward
    intros i hi j hj
    have fi := FunctionBetween.apply_closed with fFunction, hi
    have fj := FunctionBetween.apply_closed with fFunction, hj
    have v1 := submatrix.at at R, n2, n2, cardinality(n2), cardinality(n2),
      submatrix(R, n2, n2, A, e, e), f, f, i, j
      with moved, fFunction, fFunction, hi, hj
    have v2 := submatrix.at at R, n, n, n2, n2, A, e, e, f(i), f(j)
      with matrix, eFunction, eFunction, fi, fj
    have v3 := submatrix.at at R, n, n, cardinality(n2), cardinality(n2), A,
      compose(e, f, cardinality(n2), n2, n), compose(e, f, cardinality(n2), n2, n),
      i, j with matrix, gFunction, gFunction, hi, hj
    have ci := compose.apply at e, f, cardinality(n2), n2, n, i
      with fFunction, eFunction, hi
    have cj := compose.apply at e, f, cardinality(n2), n2, n, j
      with fFunction, eFunction, hj
    rw [v1, v2, v3, ci, cj]
  rw [left, right, same]

-- Permuting the columns alone multiplies by the sign.
theorem matDet.permute_columns (n σ A : Set)
  requires finite : Finite(n)
  requires permutation : σ ∈ permutations(n)
  requires matrix : A ∈ matrixSpace(R, n, n)
  shows matDet(R, n, submatrix(R, n, n, A, identity(n), σ)) =
    matPermSign(R, n, σ) * matDet(R, n, A)
proof
  sorry

-- Matrix.det_fromBlocks_zero₂₁: a block upper-triangular matrix.
theorem matDet.fromBlocks_zero (m n A B D : Set)
  requires finiteM : Finite(m)
  requires finiteN : Finite(n)
  requires a : A ∈ matrixSpace(R, m, m)
  requires b : B ∈ matrixSpace(R, m, n)
  requires d : D ∈ matrixSpace(R, n, n)
  shows matDet(R, m ⊎ n, fromBlocks(R, m, n, m, n, A, B, matZero(R, n, m), D)) =
    matDet(R, m, A) * matDet(R, n, D)
proof
  sorry

-- Matrix.det_fromBlocks₁₁: the Schur complement, for A invertible.
theorem matDet.fromBlocks_schur (m n A B C D : Set)
  requires finiteM : Finite(m)
  requires finiteN : Finite(n)
  requires a : A ∈ matrixSpace(R, m, m)
  requires b : B ∈ matrixSpace(R, m, n)
  requires c : C ∈ matrixSpace(R, n, m)
  requires d : D ∈ matrixSpace(R, n, n)
  requires unit : RingUnit(R, matDet(R, m, A))
  shows matDet(R, m ⊎ n, fromBlocks(R, m, n, m, n, A, B, C, D)) =
    matDet(R, m, A) * matDet(R, n, matAdd(R, n, n, D, matNeg(R, n, n,
      matMul(R, n, m, n, C, matMul(R, m, m, n, matInverse(R, m, A), B)))))
proof
  sorry

-- Matrix.det_one_add_mul_comm: det(1 + A B) = det(1 + B A) for A m × n
-- and B n × m.
theorem matDet.one_add_mul_comm (m n A B : Set)
  requires finiteM : Finite(m)
  requires finiteN : Finite(n)
  requires first : A ∈ matrixSpace(R, m, n)
  requires second : B ∈ matrixSpace(R, n, m)
  shows matDet(R, m, matAdd(R, m, m, matOne(R, m), matMul(R, m, n, m, A, B))) =
    matDet(R, n, matAdd(R, n, n, matOne(R, n), matMul(R, n, m, n, B, A)))
proof
  sorry

-- Linearity in a column (Matrix.det_updateCol_add, det_updateCol_smul).
theorem matDet.update_column_add (n A j u v : Set)
  requires finite : Finite(n)
  requires matrix : A ∈ matrixSpace(R, n, n)
  requires index : j ∈ n
  requires first : u ∈ functionSpace(n, R.carrier)
  requires second : v ∈ functionSpace(n, R.carrier)
  shows matDet(R, n, updateColumn(R, n, n, A, j, vecAdd(R, n, u, v))) =
    matDet(R, n, updateColumn(R, n, n, A, j, u)) +
      matDet(R, n, updateColumn(R, n, n, A, j, v))
proof
  obtain ⟨e, enumeration⟩ := Finite.cardinality_enumeration with finite
  have parts := CommRing.parts with ring
  have count := cardinality.nat at n with finite
  have inverseFunction := converse.function_of_bijective with enumeration
  have eFunction := Injective.function with (Bijective.injective with enumeration)
  have sum := vecAdd.space at R, n, u, v with ring, first, second
  have mP := updateColumn.mem_of at R, n, n, A, j, vecAdd(R, n, u, v)
    with ring, matrix, sum
  have mM := updateColumn.mem_of at R, n, n, A, j, u with ring, matrix, first
  have mN := updateColumn.mem_of at R, n, n, A, j, v with ring, matrix, second
  obtain ⟨eqP, ringP, _⟩ := matDet.columns_along at R, n,
    updateColumn(R, n, n, A, j, vecAdd(R, n, u, v)), e
    with ring, finite, mP, enumeration
  obtain ⟨eqM, ringM, _⟩ := matDet.columns_along at R, n,
    updateColumn(R, n, n, A, j, u), e with ring, finite, mM, enumeration
  obtain ⟨eqN, ringN, _⟩ := matDet.columns_along at R, n,
    updateColumn(R, n, n, A, j, v), e with ring, finite, mN, enumeration
  rw [eqP, eqM, eqN]
  have r := FunctionBetween.apply_closed with inverseFunction, index
  have back := Bijective.apply_inverse at e, cardinality(n), n, j
    with enumeration, index
  have oneIn := Ring.one_mem at R with (CommRing.to_ring with ring)
  have outsideN : ∀ k ∈ cardinality(n), ¬(k = converse(e, cardinality(n), n)(j)) →
      ∀ l ∈ cardinality(n), submatrix(R, cardinality(n), cardinality(n),
        matTranspose(R, n, n, updateColumn(R, n, n, A, j, v)), e, e)[k, l] =
      submatrix(R, cardinality(n), cardinality(n),
        matTranspose(R, n, n, updateColumn(R, n, n, A, j, u)), e, e)[k, l]
    intros k hk other l hl
    have moved : e(k) ≠ j
      intro same
      apply other
      have inv := Bijective.inverse_apply at e, cardinality(n), n, k
        with enumeration, hk
      rw same at inv
      rw inv
    obtain ⟨_, offN⟩ := updateColumn.along at R, n, A, j, v, e, k, l
      with ring, finite, matrix, second, enumeration, hk, hl
    obtain ⟨_, offM⟩ := updateColumn.along at R, n, A, j, u, e, k, l
      with ring, finite, matrix, first, enumeration, hk, hl
    rw [offN with moved, offM with moved]
  have outsideP : ∀ k ∈ cardinality(n), ¬(k = converse(e, cardinality(n), n)(j)) →
      ∀ l ∈ cardinality(n), submatrix(R, cardinality(n), cardinality(n),
        matTranspose(R, n, n, updateColumn(R, n, n, A, j, vecAdd(R, n, u, v))),
          e, e)[k, l] =
      submatrix(R, cardinality(n), cardinality(n),
        matTranspose(R, n, n, updateColumn(R, n, n, A, j, u)), e, e)[k, l]
    intros k hk other l hl
    have moved : e(k) ≠ j
      intro same
      apply other
      have inv := Bijective.inverse_apply at e, cardinality(n), n, k
        with enumeration, hk
      rw same at inv
      rw inv
    obtain ⟨_, offP⟩ := updateColumn.along at R, n, A, j, vecAdd(R, n, u, v), e,
      k, l with ring, finite, matrix, sum, enumeration, hk, hl
    obtain ⟨_, offM⟩ := updateColumn.along at R, n, A, j, u, e, k, l
      with ring, finite, matrix, first, enumeration, hk, hl
    rw [offP with moved, offM with moved]
  have entries : ∀ l ∈ cardinality(n), submatrix(R, cardinality(n),
      cardinality(n), matTranspose(R, n, n,
        updateColumn(R, n, n, A, j, vecAdd(R, n, u, v))), e, e)[
          converse(e, cardinality(n), n)(j), l] =
      R.one * submatrix(R, cardinality(n), cardinality(n),
        matTranspose(R, n, n, updateColumn(R, n, n, A, j, u)), e, e)[
          converse(e, cardinality(n), n)(j), l] +
      R.one * submatrix(R, cardinality(n), cardinality(n),
        matTranspose(R, n, n, updateColumn(R, n, n, A, j, v)), e, e)[
          converse(e, cardinality(n), n)(j), l]
    intros l hl
    have el := FunctionBetween.apply_closed with eFunction, hl
    obtain ⟨onP, _⟩ := updateColumn.along at R, n, A, j, vecAdd(R, n, u, v), e,
      converse(e, cardinality(n), n)(j), l
      with ring, finite, matrix, sum, enumeration, r, hl
    obtain ⟨onM, _⟩ := updateColumn.along at R, n, A, j, u, e,
      converse(e, cardinality(n), n)(j), l
      with ring, finite, matrix, first, enumeration, r, hl
    obtain ⟨onN, _⟩ := updateColumn.along at R, n, A, j, v, e,
      converse(e, cardinality(n), n)(j), l
      with ring, finite, matrix, second, enumeration, r, hl
    have added := vecAdd.at at R, n, u, v, e(l) with ring, first, second, el
    have ul := functionSpace.apply_mem with first, el
    have vl := functionSpace.apply_mem with second, el
    rw [onP with back, onM with back, onN with back, added]
    ring
  have linear := determinant.row_linear at R.carrier, R.add, R.zero, R.neg,
    R.mul, R.one, cardinality(n),
    submatrix(R, cardinality(n), cardinality(n),
      matTranspose(R, n, n, updateColumn(R, n, n, A, j, u)), e, e),
    submatrix(R, cardinality(n), cardinality(n),
      matTranspose(R, n, n, updateColumn(R, n, n, A, j, v)), e, e),
    submatrix(R, cardinality(n), cardinality(n),
      matTranspose(R, n, n, updateColumn(R, n, n, A, j, vecAdd(R, n, u, v))),
        e, e),
    converse(e, cardinality(n), n)(j), R.one, R.one
    with parts, ringM, ringN, ringP, r, oneIn, oneIn, outsideN, outsideP, entries
  have dM := determinant.closed at R.carrier, R.add, R.zero, R.neg, R.mul,
    R.one, submatrix(R, cardinality(n), cardinality(n),
      matTranspose(R, n, n, updateColumn(R, n, n, A, j, u)), e, e),
    cardinality(n) with parts, ringM
  have dN := determinant.closed at R.carrier, R.add, R.zero, R.neg, R.mul,
    R.one, submatrix(R, cardinality(n), cardinality(n),
      matTranspose(R, n, n, updateColumn(R, n, n, A, j, v)), e, e),
    cardinality(n) with parts, ringN
  rw linear
  ring

theorem matDet.update_column_smul (n A j a u : Set)
  requires finite : Finite(n)
  requires matrix : A ∈ matrixSpace(R, n, n)
  requires index : j ∈ n
  requires scalar : a ∈ R.carrier
  requires vector : u ∈ functionSpace(n, R.carrier)
  shows matDet(R, n, updateColumn(R, n, n, A, j, vecSmul(R, n, a, u))) =
    a * matDet(R, n, updateColumn(R, n, n, A, j, u))
proof
  obtain ⟨e, enumeration⟩ := Finite.cardinality_enumeration with finite
  have parts := CommRing.parts with ring
  have count := cardinality.nat at n with finite
  have inverseFunction := converse.function_of_bijective with enumeration
  have eFunction := Injective.function with (Bijective.injective with enumeration)
  have scaled := vecSmul.space at R, n, a, u with ring, scalar, vector
  have mN := updateColumn.mem_of at R, n, n, A, j, vecSmul(R, n, a, u)
    with ring, matrix, scaled
  have mM := updateColumn.mem_of at R, n, n, A, j, u with ring, matrix, vector
  obtain ⟨eqN, ringN, _⟩ := matDet.columns_along at R, n,
    updateColumn(R, n, n, A, j, vecSmul(R, n, a, u)), e
    with ring, finite, mN, enumeration
  obtain ⟨eqM, ringM, _⟩ := matDet.columns_along at R, n,
    updateColumn(R, n, n, A, j, u), e with ring, finite, mM, enumeration
  rw [eqN, eqM]
  have r := FunctionBetween.apply_closed with inverseFunction, index
  have back := Bijective.apply_inverse at e, cardinality(n), n, j
    with enumeration, index
  have outside : ∀ k ∈ cardinality(n), ¬(k = converse(e, cardinality(n), n)(j)) →
      ∀ l ∈ cardinality(n), submatrix(R, cardinality(n), cardinality(n),
        matTranspose(R, n, n, updateColumn(R, n, n, A, j, vecSmul(R, n, a, u))),
          e, e)[k, l] =
      submatrix(R, cardinality(n), cardinality(n),
        matTranspose(R, n, n, updateColumn(R, n, n, A, j, u)), e, e)[k, l]
    intros k hk other l hl
    have moved : e(k) ≠ j
      intro same
      apply other
      have inv := Bijective.inverse_apply at e, cardinality(n), n, k
        with enumeration, hk
      rw same at inv
      rw inv
    obtain ⟨_, offN⟩ := updateColumn.along at R, n, A, j, vecSmul(R, n, a, u),
      e, k, l with ring, finite, matrix, scaled, enumeration, hk, hl
    obtain ⟨_, offM⟩ := updateColumn.along at R, n, A, j, u, e, k, l
      with ring, finite, matrix, vector, enumeration, hk, hl
    rw [offN with moved, offM with moved]
  have entries : ∀ l ∈ cardinality(n), submatrix(R, cardinality(n),
      cardinality(n), matTranspose(R, n, n,
        updateColumn(R, n, n, A, j, vecSmul(R, n, a, u))), e, e)[
          converse(e, cardinality(n), n)(j), l] =
      a * submatrix(R, cardinality(n), cardinality(n),
        matTranspose(R, n, n, updateColumn(R, n, n, A, j, u)), e, e)[
          converse(e, cardinality(n), n)(j), l]
    intros l hl
    have el := FunctionBetween.apply_closed with eFunction, hl
    obtain ⟨onN, _⟩ := updateColumn.along at R, n, A, j, vecSmul(R, n, a, u), e,
      converse(e, cardinality(n), n)(j), l
      with ring, finite, matrix, scaled, enumeration, r, hl
    obtain ⟨onM, _⟩ := updateColumn.along at R, n, A, j, u, e,
      converse(e, cardinality(n), n)(j), l
      with ring, finite, matrix, vector, enumeration, r, hl
    have value := vecSmul.at at R, n, a, u, e(l) with ring, scalar, vector, el
    rw [onN with back, onM with back, value]
  have zeroIn := Ring.zero_mem at R with (CommRing.to_ring with ring)
  have unchanged : ∀ k ∈ cardinality(n), ¬(k = converse(e, cardinality(n), n)(j)) →
      ∀ l ∈ cardinality(n), submatrix(R, cardinality(n), cardinality(n),
      matTranspose(R, n, n, updateColumn(R, n, n, A, j, u)), e, e)[k, l] = submatrix(R, cardinality(n), cardinality(n),
      matTranspose(R, n, n, updateColumn(R, n, n, A, j, u)), e, e)[k, l]
    intros k hk other l hl
    rfl
  have linearEntries : ∀ l ∈ cardinality(n), submatrix(R, cardinality(n),
      cardinality(n), matTranspose(R, n, n,
        updateColumn(R, n, n, A, j, vecSmul(R, n, a, u))), e, e)[
          converse(e, cardinality(n), n)(j), l] =
      a * submatrix(R, cardinality(n), cardinality(n),
      matTranspose(R, n, n, updateColumn(R, n, n, A, j, u)), e, e)[converse(e, cardinality(n), n)(j), l] +
      R.zero * submatrix(R, cardinality(n), cardinality(n),
      matTranspose(R, n, n, updateColumn(R, n, n, A, j, u)), e, e)[converse(e, cardinality(n), n)(j), l]
    intros l hl
    have closed := RingMatrix.entry at cardinality(n), R.carrier, submatrix(R, cardinality(n), cardinality(n),
      matTranspose(R, n, n, updateColumn(R, n, n, A, j, u)), e, e),
      converse(e, cardinality(n), n)(j), l with ringM, r, hl
    rw entries with l, hl
    ring
  have linear := determinant.row_linear at R.carrier, R.add, R.zero, R.neg,
    R.mul, R.one, cardinality(n), submatrix(R, cardinality(n), cardinality(n),
      matTranspose(R, n, n, updateColumn(R, n, n, A, j, u)), e, e), submatrix(R, cardinality(n), cardinality(n),
      matTranspose(R, n, n, updateColumn(R, n, n, A, j, u)), e, e),
    submatrix(R, cardinality(n), cardinality(n),
      matTranspose(R, n, n, updateColumn(R, n, n, A, j, vecSmul(R, n, a, u))),
        e, e),
    converse(e, cardinality(n), n)(j), a, R.zero
    with parts, ringM, ringM, ringN, r, scalar, zeroIn, unchanged, outside,
      linearEntries
  have dM := determinant.closed at R.carrier, R.add, R.zero, R.neg, R.mul,
    R.one, submatrix(R, cardinality(n), cardinality(n),
      matTranspose(R, n, n, updateColumn(R, n, n, A, j, u)), e, e), cardinality(n) with parts, ringM
  rw linear
  ring

-- Matrix.det_eq_zero_of_column_eq_zero and of two equal columns.
theorem matDet.zero_column (n A j : Set)
  requires finite : Finite(n)
  requires matrix : A ∈ matrixSpace(R, n, n)
  requires index : j ∈ n
  requires vanishes : ∀ i ∈ n, A[i, j] = R.zero
  shows matDet(R, n, A) = R.zero
proof
  obtain ⟨e, enumeration⟩ := Finite.cardinality_enumeration with finite
  have parts := CommRing.parts with ring
  have count := cardinality.nat at n with finite
  have inverseFunction := converse.function_of_bijective with enumeration
  have columns := matDet.columns_along at R, n, A, e
    with ring, finite, matrix, enumeration
  obtain ⟨equal, ringT, entries⟩ := columns
  rw equal
  have r := FunctionBetween.apply_closed with inverseFunction, index
  have back := Bijective.apply_inverse at e, cardinality(n), n, j
    with enumeration, index
  have row : ∀ l ∈ cardinality(n), submatrix(R, cardinality(n), cardinality(n),
      matTranspose(R, n, n, A), e, e)[converse(e, cardinality(n), n)(j), l] =
      R.zero
    intros l hl
    have eFunction := Injective.function with (Bijective.injective with enumeration)
    have el := FunctionBetween.apply_closed with eFunction, hl
    have value := entries with converse(e, cardinality(n), n)(j), r, l, hl
    rw [value, back]
    exact vanishes with e(l), el
  exact determinant.zero_row at R.carrier, R.add, R.zero, R.neg, R.mul, R.one,
    submatrix(R, cardinality(n), cardinality(n), matTranspose(R, n, n, A), e, e),
    cardinality(n), converse(e, cardinality(n), n)(j) with parts, ringT, r, row

theorem matDet.equal_columns (n A j k : Set)
  requires finite : Finite(n)
  requires matrix : A ∈ matrixSpace(R, n, n)
  requires first : j ∈ n
  requires second : k ∈ n
  requires distinct : j ≠ k
  requires same : ∀ i ∈ n, A[i, j] = A[i, k]
  shows matDet(R, n, A) = R.zero
proof
  obtain ⟨e, enumeration⟩ := Finite.cardinality_enumeration with finite
  have parts := CommRing.parts with ring
  have count := cardinality.nat at n with finite
  have inverseFunction := converse.function_of_bijective with enumeration
  have eFunction := Injective.function with (Bijective.injective with enumeration)
  have columns := matDet.columns_along at R, n, A, e
    with ring, finite, matrix, enumeration
  obtain ⟨equal, ringT, entries⟩ := columns
  rw equal
  have rj := FunctionBetween.apply_closed with inverseFunction, first
  have rk := FunctionBetween.apply_closed with inverseFunction, second
  have backJ := Bijective.apply_inverse at e, cardinality(n), n, j
    with enumeration, first
  have backK := Bijective.apply_inverse at e, cardinality(n), n, k
    with enumeration, second
  have apart : converse(e, cardinality(n), n)(j) ≠ converse(e, cardinality(n), n)(k)
    intro equalIndex
    apply distinct
    rw [← backJ, ← backK, equalIndex]
  have rows : ∀ l ∈ cardinality(n), submatrix(R, cardinality(n), cardinality(n),
      matTranspose(R, n, n, A), e, e)[converse(e, cardinality(n), n)(j), l] =
      submatrix(R, cardinality(n), cardinality(n),
      matTranspose(R, n, n, A), e, e)[converse(e, cardinality(n), n)(k), l]
    intros l hl
    have el := FunctionBetween.apply_closed with eFunction, hl
    have valueJ := entries with converse(e, cardinality(n), n)(j), rj, l, hl
    have valueK := entries with converse(e, cardinality(n), n)(k), rk, l, hl
    rw [valueJ, valueK, backJ, backK]
    exact same with e(l), el
  exact determinant.equal_rows at R.carrier, R.add, R.zero, R.neg, R.mul, R.one,
    cardinality(n), converse(e, cardinality(n), n)(j),
    converse(e, cardinality(n), n)(k),
    submatrix(R, cardinality(n), cardinality(n), matTranspose(R, n, n, A), e, e)
    with parts, ringT, rj, rk, apart, rows

-- The identity along an enumeration is the identity.
theorem submatrix.one_along (k : Nat) (n e : Set)
  requires bijective : BijectiveBetween(e, k, n)
  shows submatrix(R, k, k, matOne(R, n), e, e) = matOne(R, k)
proof
  have eFunction := Injective.function with (Bijective.injective with bijective)
  have distinct := Injective.distinct_values with (Bijective.injective with bijective)
  have oneN := matOne.mem_of at R, n with ring
  have oneK := matOne.mem_of at R, k with ring
  have moved := submatrix.mem_of at R, n, n, k, k, matOne(R, n), e, e
    with oneN, eFunction, eFunction
  apply (matrixSpace.ext at R, k, k, submatrix(R, k, k, matOne(R, n), e, e),
    matOne(R, k) with ring, moved, oneK).backward
  intros i hi j hj
  have ei := FunctionBetween.apply_closed with eFunction, hi
  have ej := FunctionBetween.apply_closed with eFunction, hj
  have value := submatrix.at at R, n, n, k, k, matOne(R, n), e, e, i, j
    with oneN, eFunction, eFunction, hi, hj
  have entryN := matOne.entry at R, n, e(i), e(j) with ring, ei, ej
  have entryK := matOne.entry at R, k, i, j with ring, hi, hj
  rw value
  have alternatives : i = j ∨ i ≠ j by tauto
  cases alternatives with same | different
  . have image : e(i) = e(j) by rw same
    have v1 := entryN.left with image
    have v2 := entryK.left with same
    rw [v1, v2]
  . have apart : e(i) ≠ e(j)
      intro equal
      apply different
      exact distinct with i, hi, j, hj, equal
    have v1 := entryN.right with apart
    have v2 := entryK.right with different
    rw [v1, v2]

-- det(P X Q) = det X when P Q = 1 and the index sets have one size.
theorem matDet.similar (n m P X Q : Set)
  requires finiteN : Finite(n)
  requires finiteM : Finite(m)
  requires left : P ∈ matrixSpace(R, m, n)
  requires matrix : X ∈ matrixSpace(R, n, n)
  requires right : Q ∈ matrixSpace(R, n, m)
  requires inverse : matMul(R, m, n, m, P, Q) = matOne(R, m)
  requires size : cardinality(n) = cardinality(m)
  shows matDet(R, m, matMul(R, m, n, m, P, matMul(R, n, n, m, X, Q))) =
    matDet(R, n, X)
proof
  have count := cardinality.nat at n with finiteN
  obtain ⟨eN, enumerationN⟩ := Finite.cardinality_enumeration with finiteN
  obtain ⟨eM, enumerationM0⟩ := Finite.cardinality_enumeration with finiteM
  have enumerationM : BijectiveBetween(eM, cardinality(n), m)
    rw size
    exact enumerationM0
  have nFunction := Injective.function with (Bijective.injective with enumerationN)
  have mFunction := Injective.function with (Bijective.injective with enumerationM)
  have finiteK := Finite.natural at cardinality(n)
  have xq := matMul.mem_of at R, n, n, m, X, Q with ring, finiteN, matrix, right
  have pxq := matMul.mem_of at R, m, n, m, P, matMul(R, n, n, m, X, Q)
    with ring, finiteN, left, xq
  have alongM := matDet.along_nat at R, cardinality(n), m,
    matMul(R, m, n, m, P, matMul(R, n, n, m, X, Q)), eM
    with ring, finiteM, pxq, enumerationM
  have alongN := matDet.along at R, n, X, eN
    with ring, finiteN, matrix, enumerationN
  have outer := submatrix.mul at R, m, n, m, cardinality(n), cardinality(n),
    cardinality(n), P, matMul(R, n, n, m, X, Q), eM, eN, eM
    with ring, finiteN, left, xq, mFunction, enumerationN, mFunction
  have inner := submatrix.mul at R, n, n, m, cardinality(n), cardinality(n),
    cardinality(n), X, Q, eN, eN, eM
    with ring, finiteN, matrix, right, nFunction, enumerationN, mFunction
  have pairing := submatrix.mul at R, m, n, m, cardinality(n), cardinality(n),
    cardinality(n), P, Q, eM, eN, eM
    with ring, finiteN, left, right, mFunction, enumerationN, mFunction
  have unitAlong := submatrix.one_along at R, cardinality(n), m, eM
    with ring, enumerationM
  rw [inverse, unitAlong] at pairing
  have p1 := submatrix.mem_of at R, m, n, cardinality(n), cardinality(n), P,
    eM, eN with left, mFunction, nFunction
  have x1 := submatrix.mem_of at R, n, n, cardinality(n), cardinality(n), X,
    eN, eN with matrix, nFunction, nFunction
  have q1 := submatrix.mem_of at R, n, m, cardinality(n), cardinality(n), Q,
    eN, eM with right, nFunction, mFunction
  have xq1 := matMul.mem_of at R, cardinality(n), cardinality(n), cardinality(n),
    submatrix(R, cardinality(n), cardinality(n), X, eN, eN),
    submatrix(R, cardinality(n), cardinality(n), Q, eN, eM)
    with ring, finiteK, x1, q1
  have d1 := matDet.mul_nat at R, cardinality(n),
    submatrix(R, cardinality(n), cardinality(n), P, eM, eN),
    matMul(R, cardinality(n), cardinality(n), cardinality(n),
      submatrix(R, cardinality(n), cardinality(n), X, eN, eN),
      submatrix(R, cardinality(n), cardinality(n), Q, eN, eM))
    with ring, p1, xq1
  have d2 := matDet.mul_nat at R, cardinality(n),
    submatrix(R, cardinality(n), cardinality(n), X, eN, eN),
    submatrix(R, cardinality(n), cardinality(n), Q, eN, eM)
    with ring, x1, q1
  have d3 := matDet.mul_nat at R, cardinality(n),
    submatrix(R, cardinality(n), cardinality(n), P, eM, eN),
    submatrix(R, cardinality(n), cardinality(n), Q, eN, eM)
    with ring, p1, q1
  have unitDet := matDet.one at R, cardinality(n) with ring, finiteK
  rw [pairing, unitDet] at d3
  have dp := matDet.mem at R, cardinality(n),
    submatrix(R, cardinality(n), cardinality(n), P, eM, eN) with ring, finiteK, p1
  have dx := matDet.mem at R, cardinality(n),
    submatrix(R, cardinality(n), cardinality(n), X, eN, eN) with ring, finiteK, x1
  have dq := matDet.mem at R, cardinality(n),
    submatrix(R, cardinality(n), cardinality(n), Q, eN, eM) with ring, finiteK, q1
  rw [alongM, ← outer, ← inner, d1, d2, alongN]
  have e1 : matDet(R, cardinality(n),
      submatrix(R, cardinality(n), cardinality(n), P, eM, eN)) *
      (matDet(R, cardinality(n),
        submatrix(R, cardinality(n), cardinality(n), X, eN, eN)) *
      matDet(R, cardinality(n),
        submatrix(R, cardinality(n), cardinality(n), Q, eN, eM))) =
    matDet(R, cardinality(n),
      submatrix(R, cardinality(n), cardinality(n), X, eN, eN)) *
    (matDet(R, cardinality(n),
      submatrix(R, cardinality(n), cardinality(n), P, eM, eN)) *
      matDet(R, cardinality(n),
        submatrix(R, cardinality(n), cardinality(n), Q, eN, eM))) by ring
  rw [e1, ← d3]
  ring

-- Two finite bases give the same determinant of an endomorphism.
theorem matDet.basis_independent (M f I b J c : Set)
  requires finiteI : Finite(I)
  requires finiteJ : Finite(J)
  requires basisB : ModuleBasis(M, R, I, b)
  requires basisC : ModuleBasis(M, R, J, c)
  requires linear : LinearMap(f, M, R, M)
  shows matDet(R, J, linearToMatrix(M, R, M, J, c, J, c, f)) =
    matDet(R, I, linearToMatrix(M, R, M, I, b, I, b, f))
proof
  have basis0 := basisB
  obtain ⟨_, spans⟩ := basis0
  obtain ⟨module, _, _⟩ := spans
  have matrixB := linearToMatrix.mem at R, M, M, I, b, I, b, f
    with ring, finiteI, finiteI, basisB, basisB, linear
  have matrixC := linearToMatrix.mem at R, M, M, J, c, J, c, f
    with ring, finiteJ, finiteJ, basisC, basisC, linear
  have dB := matDet.mem at R, I, linearToMatrix(M, R, M, I, b, I, b, f)
    with ring, finiteI, matrixB
  have dC := matDet.mem at R, J, linearToMatrix(M, R, M, J, c, J, c, f)
    with ring, finiteJ, matrixC
  have alternatives : R.zero = R.one ∨ R.zero ≠ R.one by tauto
  cases alternatives with trivial | nontrivial
  . have collapseB : matDet(R, I, linearToMatrix(M, R, M, I, b, I, b, f)) = R.zero
      have e : matDet(R, I, linearToMatrix(M, R, M, I, b, I, b, f)) =
          matDet(R, I, linearToMatrix(M, R, M, I, b, I, b, f)) * R.one by ring
      rw ← trivial at e
      have z : matDet(R, I, linearToMatrix(M, R, M, I, b, I, b, f)) * R.zero =
          R.zero by ring
      rw z at e
      exact e
    have collapseC : matDet(R, J, linearToMatrix(M, R, M, J, c, J, c, f)) = R.zero
      have e : matDet(R, J, linearToMatrix(M, R, M, J, c, J, c, f)) =
          matDet(R, J, linearToMatrix(M, R, M, J, c, J, c, f)) * R.one by ring
      rw ← trivial at e
      have z : matDet(R, J, linearToMatrix(M, R, M, J, c, J, c, f)) * R.zero =
          R.zero by ring
      rw z at e
      exact e
    rw [collapseB, collapseC]
  . have countI := cardinality.nat at I with finiteI
    have countJ := cardinality.nat at J with finiteJ
    obtain ⟨eI, enumerationI⟩ := Finite.cardinality_enumeration with finiteI
    obtain ⟨eJ, enumerationJ⟩ := Finite.cardinality_enumeration with finiteJ
    have reindexedI := ModuleBasis.reindex at R, M, I, cardinality(I), eI, b
      with ring, module, basisB, enumerationI
    have reindexedJ := ModuleBasis.reindex at R, M, J, cardinality(J), eJ, c
      with ring, module, basisC, enumerationJ
    have rankI : HasRank(M, R, cardinality(I))
      unfold HasRank
      witness compose(b, eI, cardinality(I), I, M.carrier)
      exact reindexedI
    have rankJ : HasRank(M, R, cardinality(J))
      unfold HasRank
      witness compose(c, eJ, cardinality(J), J, M.carrier)
      exact reindexedJ
    have size := HasRank.unique_of at R, M, cardinality(I), cardinality(J)
      with ring, nontrivial, module, rankI, rankJ
    have identityLinear := LinearMap.identity at M, R with module
    have matrixP := linearToMatrix.mem at R, M, M, I, b, J, c,
      identity(Module.carrier(M)) with ring, finiteI, finiteJ, basisB, basisC,
      identityLinear
    have matrixQ := linearToMatrix.mem at R, M, M, J, c, I, b,
      identity(Module.carrier(M)) with ring, finiteJ, finiteI, basisC, basisB,
      identityLinear
    have change := linearToMatrix.change_of_basis at R, M, I, b, J, c, f
      with ring, finiteI, finiteJ, basisB, basisC, linear
    have composed := linearToMatrix.compose at R, M, M, M, J, c, I, b, J, c,
      identity(Module.carrier(M)), identity(Module.carrier(M))
      with ring, finiteJ, finiteI, finiteJ, basisC, basisB, basisC,
        identityLinear, identityLinear
    have identityFunction := identity.function at Module.carrier(M)
    have collapse := compose.identity_left at identity(Module.carrier(M)),
      Module.carrier(M), Module.carrier(M) with identityFunction
    rw collapse at composed
    have unitJ := linearToMatrix.identity at R, M, J, c with ring, finiteJ, basisC
    rw unitJ at composed
    have inverse : matMul(R, J, I, J,
        linearToMatrix(M, R, M, I, b, J, c, identity(Module.carrier(M))),
        linearToMatrix(M, R, M, J, c, I, b, identity(Module.carrier(M)))) =
        matOne(R, J)
      symm
      exact composed
    have similar := matDet.similar at R, I, J,
      linearToMatrix(M, R, M, I, b, J, c, identity(Module.carrier(M))),
      linearToMatrix(M, R, M, I, b, I, b, f),
      linearToMatrix(M, R, M, J, c, I, b, identity(Module.carrier(M)))
      with ring, finiteI, finiteJ, matrixP, matrixB, matrixQ, inverse, size
    rw change at similar
    exact similar

-- Section: Adjugate and inverse
theorem matAdjugate.mem (n A : Set)
  requires finite : Finite(n)
  requires matrix : A ∈ matrixSpace(R, n, n)
  shows matAdjugate(R, n, A) ∈ matrixSpace(R, n, n)
proof
  obtain ⟨e, enumeration⟩ := Finite.cardinality_enumeration with finite
  have transported := matAdjugate.enumeration at R, n, A, e
    with ring, finite, matrix, enumeration
  exact transported.left

-- Matrix.mul_adjugate and adjugate_mul: A adj A = adj A A = det(A) 1.
theorem matAdjugate.mul_right (n A : Set)
  requires finite : Finite(n)
  requires matrix : A ∈ matrixSpace(R, n, n)
  shows matMul(R, n, n, n, A, matAdjugate(R, n, A)) = matScalar(R, n, matDet(R, n, A))
proof
  obtain ⟨e, enumeration⟩ := Finite.cardinality_enumeration with finite
  have parts := CommRing.parts with ring
  have count := cardinality.nat at n with finite
  have eFunction := Injective.function with (Bijective.injective with enumeration)
  have distinct := Injective.distinct_values with (Bijective.injective with enumeration)
  have adjIn := matAdjugate.mem at R, n, A with ring, finite, matrix
  have dIn := matDet.mem at R, n, A with ring, finite, matrix
  have scalar := matScalar.mem_of at R, n, matDet(R, n, A) with ring, dIn
  have detAlong := matDet.transported at R, n, A, e
    with ring, finite, matrix, enumeration
  have movedA := submatrix.mem_of at R, n, n, cardinality(n), cardinality(n),
    A, e, e with matrix, eFunction, eFunction
  have ringE : RingMatrix(cardinality(n), R.carrier,
      submatrix(R, cardinality(n), cardinality(n), A, e, e))
    unfold RingMatrix
    exact matrixSpace.function with movedA
  have product := matMul.mem_of at R, n, n, n, A, matAdjugate(R, n, A)
    with ring, finite, matrix, adjIn
  apply matrixSpace.ext_along at R, n, matMul(R, n, n, n, A, matAdjugate(R, n, A)),
    matScalar(R, n, matDet(R, n, A)), e with ring, product, scalar, enumeration
  intros i hi j hj
  have along := matAdjugate.product_along at R, n, A, e, i, j
    with ring, finite, matrix, enumeration, hi, hj
  rw along.left
  have alternatives : i = j ∨ i ≠ j by tauto
  cases alternatives with same | different
  . rw ← same
    have ei := FunctionBetween.apply_closed with eFunction, hi
    have entry := matScalar.entry_of at R, n, matDet(R, n, A), e(i), e(i)
      with ring, dIn, ei, ei
    have reflexive : e(i) = e(i) by rfl
    have diagonal := adjugate.right_diagonal at R.carrier, R.add, R.zero, R.neg,
      R.mul, R.one, cardinality(n),
      submatrix(R, cardinality(n), cardinality(n), A, e, e), i
      with parts, ringE, hi
    have value := entry.left with reflexive
    rw [diagonal, value, detAlong]
  . have ei := FunctionBetween.apply_closed with eFunction, hi
    have ej := FunctionBetween.apply_closed with eFunction, hj
    have entry := matScalar.entry_of at R, n, matDet(R, n, A), e(i), e(j)
      with ring, dIn, ei, ej
    have apart : e(i) ≠ e(j)
      intro equal
      apply different
      exact distinct with i, hi, j, hj, equal
    have off := adjugate.right_off_diagonal at R.carrier, R.add, R.zero, R.neg,
      R.mul, R.one, cardinality(n),
      submatrix(R, cardinality(n), cardinality(n), A, e, e), i, j
      with parts, ringE, hi, hj, different
    have value := entry.right with apart
    rw [off, value]

theorem matAdjugate.mul_left (n A : Set)
  requires finite : Finite(n)
  requires matrix : A ∈ matrixSpace(R, n, n)
  shows matMul(R, n, n, n, matAdjugate(R, n, A), A) = matScalar(R, n, matDet(R, n, A))
proof
  obtain ⟨e, enumeration⟩ := Finite.cardinality_enumeration with finite
  have parts := CommRing.parts with ring
  have count := cardinality.nat at n with finite
  have eFunction := Injective.function with (Bijective.injective with enumeration)
  have distinct := Injective.distinct_values with (Bijective.injective with enumeration)
  have adjIn := matAdjugate.mem at R, n, A with ring, finite, matrix
  have dIn := matDet.mem at R, n, A with ring, finite, matrix
  have scalar := matScalar.mem_of at R, n, matDet(R, n, A) with ring, dIn
  have detAlong := matDet.transported at R, n, A, e
    with ring, finite, matrix, enumeration
  have movedA := submatrix.mem_of at R, n, n, cardinality(n), cardinality(n),
    A, e, e with matrix, eFunction, eFunction
  have ringE : RingMatrix(cardinality(n), R.carrier,
      submatrix(R, cardinality(n), cardinality(n), A, e, e))
    unfold RingMatrix
    exact matrixSpace.function with movedA
  have product := matMul.mem_of at R, n, n, n, matAdjugate(R, n, A), A
    with ring, finite, adjIn, matrix
  have functionE := ringE
  unfold RingMatrix at functionE
  have tFunction := transposedMatrix.function at cardinality(n), cardinality(n),
    R.carrier, submatrix(R, cardinality(n), cardinality(n), A, e, e)
    with functionE
  have ringS : RingMatrix(cardinality(n), R.carrier,
      transposedMatrix(cardinality(n), cardinality(n), R.carrier,
        submatrix(R, cardinality(n), cardinality(n), A, e, e)))
    unfold RingMatrix
    exact tFunction
  have entriesS : ∀ x ∈ cardinality(n), ∀ y ∈ cardinality(n),
      transposedMatrix(cardinality(n), cardinality(n), R.carrier,
        submatrix(R, cardinality(n), cardinality(n), A, e, e))[x, y] =
      submatrix(R, cardinality(n), cardinality(n), A, e, e)[y, x]
    intros x hx y hy
    exact transposedMatrix.pair at cardinality(n), cardinality(n), R.carrier,
      submatrix(R, cardinality(n), cardinality(n), A, e, e), y, x
      with functionE, hy, hx
  have detS := determinant.transpose at R.carrier, R.add, R.zero, R.neg, R.mul,
    R.one, cardinality(n), submatrix(R, cardinality(n), cardinality(n), A, e, e),
    transposedMatrix(cardinality(n), cardinality(n), R.carrier,
      submatrix(R, cardinality(n), cardinality(n), A, e, e))
    with parts, ringE, ringS, entriesS
  apply matrixSpace.ext_along at R, n, matMul(R, n, n, n, matAdjugate(R, n, A), A),
    matScalar(R, n, matDet(R, n, A)), e with ring, product, scalar, enumeration
  intros i hi j hj
  have along := matAdjugate.product_along at R, n, A, e, i, j
    with ring, finite, matrix, enumeration, hi, hj
  have flipped := adjugate.left_product at R.carrier, R.add, R.zero, R.neg,
    R.mul, R.one, cardinality(n),
    submatrix(R, cardinality(n), cardinality(n), A, e, e), i, j
    with parts, ringE, hi, hj
  rw [along.right, flipped]
  have alternatives : i = j ∨ i ≠ j by tauto
  cases alternatives with same | different
  . rw ← same
    have ei := FunctionBetween.apply_closed with eFunction, hi
    have entry := matScalar.entry_of at R, n, matDet(R, n, A), e(i), e(i)
      with ring, dIn, ei, ei
    have reflexive : e(i) = e(i) by rfl
    have diagonal := adjugate.right_diagonal at R.carrier, R.add, R.zero, R.neg,
      R.mul, R.one, cardinality(n),
      transposedMatrix(cardinality(n), cardinality(n), R.carrier,
        submatrix(R, cardinality(n), cardinality(n), A, e, e)), i
      with parts, ringS, hi
    have value := entry.left with reflexive
    rw [diagonal, value, detAlong, detS]
  . have ei := FunctionBetween.apply_closed with eFunction, hi
    have ej := FunctionBetween.apply_closed with eFunction, hj
    have entry := matScalar.entry_of at R, n, matDet(R, n, A), e(i), e(j)
      with ring, dIn, ei, ej
    have apart : e(i) ≠ e(j)
      intro equal
      apply different
      exact distinct with i, hi, j, hj, equal
    have reverse : j ≠ i
      intro equal
      apply different
      symm
      exact equal
    have off := adjugate.right_off_diagonal at R.carrier, R.add, R.zero, R.neg,
      R.mul, R.one, cardinality(n),
      transposedMatrix(cardinality(n), cardinality(n), R.carrier,
        submatrix(R, cardinality(n), cardinality(n), A, e, e)), j, i
      with parts, ringS, hj, hi, reverse
    have value := entry.right with apart
    rw [off, value]

theorem matInverse.mem (n A : Set)
  requires finite : Finite(n)
  requires matrix : A ∈ matrixSpace(R, n, n)
  requires unit : RingUnit(R, matDet(R, n, A))
  shows matInverse(R, n, A) ∈ matrixSpace(R, n, n)
proof
  have adjIn := matAdjugate.mem at R, n, A with ring, finite, matrix
  have uIn := ringInverse.mem at R, matDet(R, n, A) with ring, unit
  unfold matInverse
  exact matSmul.mem_of at R, n, n, ringInverse(R, matDet(R, n, A)),
    matAdjugate(R, n, A) with ring, uIn, adjIn

theorem matInverse.right_identity (n A : Set)
  requires finite : Finite(n)
  requires matrix : A ∈ matrixSpace(R, n, n)
  requires unit : RingUnit(R, matDet(R, n, A))
  shows matMul(R, n, n, n, A, matInverse(R, n, A)) = matOne(R, n)
proof
  have adjIn := matAdjugate.mem at R, n, A with ring, finite, matrix
  have dIn := matDet.mem at R, n, A with ring, finite, matrix
  have uIn := ringInverse.mem at R, matDet(R, n, A) with ring, unit
  have moved := matMul.smul_right at R, n, n, n, ringInverse(R, matDet(R, n, A)),
    A, matAdjugate(R, n, A) with ring, finite, uIn, matrix, adjIn
  have identity := matAdjugate.mul_right at R, n, A with ring, finite, matrix
  have scaled := matSmul.scalar at R, n, ringInverse(R, matDet(R, n, A)),
    matDet(R, n, A) with ring, uIn, dIn
  have cancel := ringInverse.mul_left at R, matDet(R, n, A) with ring, unit
  have unitMatrix := matScalar.one at R, n with ring
  unfold matInverse
  rw [moved, identity, scaled, cancel, unitMatrix]

theorem matInverse.left_identity (n A : Set)
  requires finite : Finite(n)
  requires matrix : A ∈ matrixSpace(R, n, n)
  requires unit : RingUnit(R, matDet(R, n, A))
  shows matMul(R, n, n, n, matInverse(R, n, A), A) = matOne(R, n)
proof
  have adjIn := matAdjugate.mem at R, n, A with ring, finite, matrix
  have dIn := matDet.mem at R, n, A with ring, finite, matrix
  have uIn := ringInverse.mem at R, matDet(R, n, A) with ring, unit
  have moved := matMul.smul_left at R, n, n, n, ringInverse(R, matDet(R, n, A)),
    matAdjugate(R, n, A), A with ring, finite, uIn, adjIn, matrix
  have identity := matAdjugate.mul_left at R, n, A with ring, finite, matrix
  have scaled := matSmul.scalar at R, n, ringInverse(R, matDet(R, n, A)),
    matDet(R, n, A) with ring, uIn, dIn
  have cancel := ringInverse.mul_left at R, matDet(R, n, A) with ring, unit
  have unitMatrix := matScalar.one at R, n with ring
  unfold matInverse
  rw [moved, identity, scaled, cancel, unitMatrix]

-- Matrix.isUnit_iff_isUnit_det.
theorem InvertibleMatrix.iff_det (n A : Set)
  requires finite : Finite(n)
  requires matrix : A ∈ matrixSpace(R, n, n)
  shows InvertibleMatrix(R, n, A) ↔ RingUnit(R, matDet(R, n, A))
proof
  have dIn := matDet.mem at R, n, A with ring, finite, matrix
  constructor
  . intro invertible
    obtain ⟨_, B, BIn, right, left⟩ := invertible
    have dB := matDet.mem at R, n, B with ring, finite, BIn
    have product := matDet.mul at R, n, A, B with ring, finite, matrix, BIn
    have unitDet := matDet.one at R, n with ring, finite
    rw [right, unitDet] at product
    have equation : matDet(R, n, A) * matDet(R, n, B) = R.one
      symm
      exact product
    exact RingUnit.of_product at R, matDet(R, n, A), matDet(R, n, B)
      with ring, dIn, dB, equation
  . intro unit
    have invIn := matInverse.mem at R, n, A with ring, finite, matrix, unit
    have right := matInverse.right_identity at R, n, A with ring, finite, matrix, unit
    have left := matInverse.left_identity at R, n, A with ring, finite, matrix, unit
    unfold InvertibleMatrix
    exact ⟨matrix, matInverse(R, n, A), invIn, right, left⟩

theorem matInverse.mul_right (n A : Set)
  requires finite : Finite(n)
  requires matrix : A ∈ matrixSpace(R, n, n)
  requires unit : RingUnit(R, matDet(R, n, A))
  shows matMul(R, n, n, n, A, matInverse(R, n, A)) = matOne(R, n)
proof
  exact matInverse.right_identity at R, n, A with ring, finite, matrix, unit

theorem matInverse.mul_left (n A : Set)
  requires finite : Finite(n)
  requires matrix : A ∈ matrixSpace(R, n, n)
  requires unit : RingUnit(R, matDet(R, n, A))
  shows matMul(R, n, n, n, matInverse(R, n, A), A) = matOne(R, n)
proof
  exact matInverse.left_identity at R, n, A with ring, finite, matrix, unit

-- Matrix.inv_eq_left_inv and inv_eq_right_inv: a one-sided inverse is the
-- inverse.
theorem matInverse.eq_left_inverse (n A B : Set)
  requires finite : Finite(n)
  requires first : A ∈ matrixSpace(R, n, n)
  requires second : B ∈ matrixSpace(R, n, n)
  requires left : matMul(R, n, n, n, B, A) = matOne(R, n)
  shows RingUnit(R, matDet(R, n, A)) ∧ B = matInverse(R, n, A)
proof
  have dA := matDet.mem at R, n, A with ring, finite, first
  have dB := matDet.mem at R, n, B with ring, finite, second
  have product := matDet.mul at R, n, B, A with ring, finite, second, first
  have unitDet := matDet.one at R, n with ring, finite
  rw [left, unitDet] at product
  have equation : matDet(R, n, A) * matDet(R, n, B) = R.one
    have e : matDet(R, n, A) * matDet(R, n, B) =
        matDet(R, n, B) * matDet(R, n, A) by ring
    rw [e, ← product]
  have unit := RingUnit.of_product at R, matDet(R, n, A), matDet(R, n, B)
    with ring, dA, dB, equation
  have invIn := matInverse.mem at R, n, A with ring, finite, first, unit
  have rightInverse := matInverse.mul_right at R, n, A
    with ring, finite, first, unit
  have assoc := matMul.assoc at R, n, n, n, n, B, A, matInverse(R, n, A)
    with ring, finite, finite, second, first, invIn
  rw [left, rightInverse] at assoc
  have oneLeft := matMul.one_left at R, n, n, matInverse(R, n, A)
    with ring, finite, invIn
  have oneRight := matMul.one_right at R, n, n, B with ring, finite, second
  rw [oneLeft, oneRight] at assoc
  constructor
  . exact unit
  . symm
    exact assoc

theorem matInverse.eq_right_inverse (n A B : Set)
  requires finite : Finite(n)
  requires first : A ∈ matrixSpace(R, n, n)
  requires second : B ∈ matrixSpace(R, n, n)
  requires right : matMul(R, n, n, n, A, B) = matOne(R, n)
  shows RingUnit(R, matDet(R, n, A)) ∧ B = matInverse(R, n, A)
proof
  have dA := matDet.mem at R, n, A with ring, finite, first
  have dB := matDet.mem at R, n, B with ring, finite, second
  have product := matDet.mul at R, n, A, B with ring, finite, first, second
  have unitDet := matDet.one at R, n with ring, finite
  rw [right, unitDet] at product
  have equation : matDet(R, n, A) * matDet(R, n, B) = R.one
    symm
    exact product
  have unit := RingUnit.of_product at R, matDet(R, n, A), matDet(R, n, B)
    with ring, dA, dB, equation
  have invIn := matInverse.mem at R, n, A with ring, finite, first, unit
  have leftInverse := matInverse.mul_left at R, n, A
    with ring, finite, first, unit
  have assoc := matMul.assoc at R, n, n, n, n, matInverse(R, n, A), A, B
    with ring, finite, finite, invIn, first, second
  rw [leftInverse, right] at assoc
  have oneLeft := matMul.one_left at R, n, n, B with ring, finite, second
  have oneRight := matMul.one_right at R, n, n, matInverse(R, n, A)
    with ring, finite, invIn
  rw [oneLeft, oneRight] at assoc
  constructor
  . exact unit
  . exact assoc

-- Matrix.mul_inv_rev, det_nonsing_inv, transpose_nonsing_inv, and
-- conjTranspose_nonsing_inv.
theorem matInverse.mul (n A B : Set)
  requires finite : Finite(n)
  requires first : A ∈ matrixSpace(R, n, n)
  requires second : B ∈ matrixSpace(R, n, n)
  requires unitA : RingUnit(R, matDet(R, n, A))
  requires unitB : RingUnit(R, matDet(R, n, B))
  shows matInverse(R, n, matMul(R, n, n, n, A, B)) =
    matMul(R, n, n, n, matInverse(R, n, B), matInverse(R, n, A))
proof
  have invA := matInverse.mem at R, n, A with ring, finite, first, unitA
  have invB := matInverse.mem at R, n, B with ring, finite, second, unitB
  have product := matMul.mem_of at R, n, n, n, A, B
    with ring, finite, first, second
  have candidate := matMul.mem_of at R, n, n, n, matInverse(R, n, B),
    matInverse(R, n, A) with ring, finite, invB, invA
  have outer := matMul.assoc at R, n, n, n, n, A, B,
    matMul(R, n, n, n, matInverse(R, n, B), matInverse(R, n, A))
    with ring, finite, finite, first, second, candidate
  have inner := matMul.assoc at R, n, n, n, n, B, matInverse(R, n, B),
    matInverse(R, n, A) with ring, finite, finite, second, invB, invA
  have rightB := matInverse.mul_right at R, n, B with ring, finite, second, unitB
  have rightA := matInverse.mul_right at R, n, A with ring, finite, first, unitA
  have oneLeft := matMul.one_left at R, n, n, matInverse(R, n, A)
    with ring, finite, invA
  rw [rightB, oneLeft] at inner
  rw [← inner, rightA] at outer
  have result := matInverse.eq_right_inverse at R, n, matMul(R, n, n, n, A, B),
    matMul(R, n, n, n, matInverse(R, n, B), matInverse(R, n, A))
    with ring, finite, product, candidate, outer
  symm
  exact result.right

theorem matInverse.det (n A : Set)
  requires finite : Finite(n)
  requires matrix : A ∈ matrixSpace(R, n, n)
  requires unit : RingUnit(R, matDet(R, n, A))
  shows matDet(R, n, matInverse(R, n, A)) = ringInverse(R, matDet(R, n, A))
proof
  have invIn := matInverse.mem at R, n, A with ring, finite, matrix, unit
  have dA := matDet.mem at R, n, A with ring, finite, matrix
  have dI := matDet.mem at R, n, matInverse(R, n, A) with ring, finite, invIn
  have uIn := ringInverse.mem at R, matDet(R, n, A) with ring, unit
  have product := matDet.mul at R, n, A, matInverse(R, n, A)
    with ring, finite, matrix, invIn
  have rightA := matInverse.mul_right at R, n, A with ring, finite, matrix, unit
  have unitDet := matDet.one at R, n with ring, finite
  rw [rightA, unitDet] at product
  have cancel := ringInverse.mul_left at R, matDet(R, n, A) with ring, unit
  have e1 : matDet(R, n, matInverse(R, n, A)) =
      (ringInverse(R, matDet(R, n, A)) * matDet(R, n, A)) *
        matDet(R, n, matInverse(R, n, A))
    rw cancel
    ring
  have e2 : (ringInverse(R, matDet(R, n, A)) * matDet(R, n, A)) *
      matDet(R, n, matInverse(R, n, A)) = ringInverse(R, matDet(R, n, A)) *
      (matDet(R, n, A) * matDet(R, n, matInverse(R, n, A))) by ring
  rw [e1, e2, ← product]
  ring

theorem matInverse.transpose (n A : Set)
  requires finite : Finite(n)
  requires matrix : A ∈ matrixSpace(R, n, n)
  requires unit : RingUnit(R, matDet(R, n, A))
  shows matTranspose(R, n, n, matInverse(R, n, A)) =
    matInverse(R, n, matTranspose(R, n, n, A))
proof
  have invIn := matInverse.mem at R, n, A with ring, finite, matrix, unit
  have transposed := matTranspose.mem_of at R, n, n, A with ring, matrix
  have transposedInv := matTranspose.mem_of at R, n, n, matInverse(R, n, A)
    with ring, invIn
  have flip := matTranspose.mul at R, n, n, n, matInverse(R, n, A), A
    with ring, finite, invIn, matrix
  have leftA := matInverse.mul_left at R, n, A with ring, finite, matrix, unit
  have unitT := matTranspose.one at R, n with ring
  rw [leftA, unitT] at flip
  have equation : matMul(R, n, n, n, matTranspose(R, n, n, A),
      matTranspose(R, n, n, matInverse(R, n, A))) = matOne(R, n)
    symm
    exact flip
  have result := matInverse.eq_right_inverse at R, n, matTranspose(R, n, n, A),
    matTranspose(R, n, n, matInverse(R, n, A))
    with ring, finite, transposed, transposedInv, equation
  exact result.right

theorem matInverse.conjTranspose (σ n A : Set)
  requires involution : RingInvolution(σ, R)
  requires finite : Finite(n)
  requires matrix : A ∈ matrixSpace(R, n, n)
  requires unit : RingUnit(R, matDet(R, n, A))
  shows conjTranspose(R, σ, n, n, matInverse(R, n, A)) =
    matInverse(R, n, conjTranspose(R, σ, n, n, A))
proof
  have invIn := matInverse.mem at R, n, A with ring, finite, matrix, unit
  have conjA := conjTranspose.mem_of at R, σ, n, n, A with involution, matrix
  have conjInv := conjTranspose.mem_of at R, σ, n, n, matInverse(R, n, A)
    with involution, invIn
  have flip := conjTranspose.mul at R, σ, n, n, n, matInverse(R, n, A), A
    with involution, finite, invIn, matrix
  have leftA := matInverse.mul_left at R, n, A with ring, finite, matrix, unit
  have unitConj := conjTranspose.one at R, σ, n with involution
  rw [leftA, unitConj] at flip
  have equation : matMul(R, n, n, n, conjTranspose(R, σ, n, n, A),
      conjTranspose(R, σ, n, n, matInverse(R, n, A))) = matOne(R, n)
    symm
    exact flip
  have result := matInverse.eq_right_inverse at R, n,
    conjTranspose(R, σ, n, n, A), conjTranspose(R, σ, n, n, matInverse(R, n, A))
    with ring, finite, conjA, conjInv, equation
  exact result.right

theorem matInverse.map (S n f A : Set)
  requires target : CommRing(S)
  requires finite : Finite(n)
  requires hom : RingHom(f, R, S)
  requires matrix : A ∈ matrixSpace(R, n, n)
  requires unit : RingUnit(R, matDet(R, n, A))
  shows matMap(S, n, n, f, matInverse(R, n, A)) =
    matInverse(S, n, matMap(S, n, n, f, A))
proof
  have invIn := matInverse.mem at R, n, A with ring, finite, matrix, unit
  have mapA := matMap.mem_of_hom at R, S, n, n, f, A with ring, hom, matrix
  have mapInv := matMap.mem_of_hom at R, S, n, n, f, matInverse(R, n, A)
    with ring, hom, invIn
  have product := matMap.mul at R, S, n, n, n, f, A, matInverse(R, n, A)
    with ring, target, finite, hom, matrix, invIn
  have rightA := matInverse.mul_right at R, n, A with ring, finite, matrix, unit
  have unitMap := matMap.one at R, S, n, f with ring, target, hom
  rw [rightA, unitMap] at product
  have equation : matMul(S, n, n, n, matMap(S, n, n, f, A),
      matMap(S, n, n, f, matInverse(R, n, A))) = matOne(S, n)
    symm
    exact product
  have result := matInverse.eq_right_inverse at S, n, matMap(S, n, n, f, A),
    matMap(S, n, n, f, matInverse(R, n, A))
    with target, finite, mapA, mapInv, equation
  exact result.right

-- Matrix.cramer: for A x = b, det(A) x(i) is the determinant of A with
-- column i replaced by b.
theorem matDet.cramer (n A x b i : Set)
  requires finite : Finite(n)
  requires matrix : A ∈ matrixSpace(R, n, n)
  requires vector : x ∈ functionSpace(n, R.carrier)
  requires solves : mulVec(R, n, n, A, x) = b
  requires index : i ∈ n
  shows matDet(R, n, A) * x(i) = matDet(R, n, updateColumn(R, n, n, A, i, b))
proof
  sorry

-- The ring units: closure, and the inverse of a unit.
theorem RingUnit.mul (a b : Set)
  requires first : RingUnit(R, a)
  requires second : RingUnit(R, b)
  shows RingUnit(R, a * b)
proof
  have ringR := CommRing.to_ring with ring
  obtain ⟨aIn, a2, a2In, ra, la⟩ := first
  obtain ⟨bIn, b2, b2In, rb, lb⟩ := second
  have ab := Ring.mul_mem at R, a, b with ringR, aIn, bIn
  have ba := Ring.mul_mem at R, b2, a2 with ringR, b2In, a2In
  unfold RingUnit
  refine ⟨ab, call2(R.mul, b2, a2), ba, ?_, ?_⟩
  . have e : call2(R.mul, call2(R.mul, a, b), call2(R.mul, b2, a2)) = call2(R.mul, call2(R.mul, a, call2(R.mul, b, b2)), a2) by ring
    rw [e, rb]
    have e2 : call2(R.mul, call2(R.mul, a, R.one), a2) = call2(R.mul, a, a2) by ring
    rw [e2, ra]
  . have e : call2(R.mul, call2(R.mul, b2, a2), call2(R.mul, a, b)) = call2(R.mul, call2(R.mul, b2, call2(R.mul, a2, a)), b) by ring
    rw [e, la]
    have e2 : call2(R.mul, call2(R.mul, b2, R.one), b) = call2(R.mul, b2, b) by ring
    rw [e2, lb]

theorem ringInverse.mul_right (a : Set)
  requires unit : RingUnit(R, a)
  shows a * ringInverse(R, a) = R.one
proof
  have ringR := CommRing.to_ring with ring
  have selected := ringInverse.selected at R, a with ringR, unit
  obtain ⟨_, right, _⟩ := selected
  exact right

theorem RingUnit.map (S f a : Set)
  requires target : CommRing(S)
  requires hom : RingHom(f, R, S)
  requires unit : RingUnit(R, a)
  shows RingUnit(S, f(a))
proof
  obtain ⟨_, _, function, _, oneMap, _, _, mulMap⟩ := hom
  obtain ⟨aIn, b, bIn, right, left⟩ := unit
  have fa := FunctionBetween.apply_closed with function, aIn
  have fb := FunctionBetween.apply_closed with function, bIn
  have e1 := mulMap with a, aIn, b, bIn
  have e2 := mulMap with b, bIn, a, aIn
  rw [right, oneMap] at e1
  rw [left, oneMap] at e2
  unfold RingUnit
  refine ⟨fa, f(b), fb, ?_, ?_⟩
  . symm
    exact e1
  . symm
    exact e2

end Determinants

-- Section: Fields
section Fields
variable (K : Set)
hypothesis field : Field(K)

-- Matrix.exists_mulVec_eq_zero_iff: over a field, A v = 0 for some v ≠ 0
-- exactly when det A = 0.
theorem matDet.eq_zero_iff_kernel (n A : Set)
  requires finite : Finite(n)
  requires matrix : A ∈ matrixSpace(K, n, n)
  shows matDet(K, n, A) = K.zero ↔
    (∃ v ∈ functionSpace(n, K.carrier),
      v ≠ constantFunction(n, K.carrier, K.zero) ∧
      mulVec(K, n, n, A, v) = constantFunction(n, K.carrier, K.zero))
proof
  sorry

-- Over a field, det A ≠ 0 iff the columns are independent, iff A is
-- invertible.
theorem matDet.ne_zero_iff_independent (n A : Set)
  requires finite : Finite(n)
  requires matrix : A ∈ matrixSpace(K, n, n)
  shows matDet(K, n, A) ≠ K.zero ↔
    LinearIndependent(coordinateModule(K, n), K, n, columnFamily(K, n, n, A))
proof
  sorry

theorem InvertibleMatrix.iff_det_ne_zero (n A : Set)
  requires finite : Finite(n)
  requires matrix : A ∈ matrixSpace(K, n, n)
  shows InvertibleMatrix(K, n, A) ↔ matDet(K, n, A) ≠ K.zero
proof
  have comm := Field.to_comm_ring with field
  have parts := Field.parts with field
  obtain ⟨_, nontrivial, inverses⟩ := parts
  have equivalence := InvertibleMatrix.iff_det at K, n, A
    with comm, finite, matrix
  have dIn := matDet.mem at K, n, A with comm, finite, matrix
  constructor
  . intro invertible
    have unit := equivalence.forward with invertible
    obtain ⟨_, b, bIn, right, _⟩ := unit
    intro vanishes
    rw vanishes at right
    have z : K.zero * b = K.zero by ring
    rw z at right
    obtain ⟨_, _, distinct⟩ := nontrivial
    exact distinct with right
  . intro nonzero
    apply equivalence.backward
    obtain ⟨y, inverse⟩ := inverses with matDet(K, n, A), dIn, nonzero
    obtain ⟨_, yIn, leftLaw, rightLaw⟩ := inverse
    unfold RingUnit
    exact ⟨dIn, y, yIn, rightLaw, leftLaw⟩

end Fields

-- The determinant of an endomorphism f of a finite free module: the
-- determinant of its matrix in a finite basis, the same in every basis
-- (LinearMap.det, without a chosen basis).
defunique linearDet (M R f : Set) (d ∈ Ring.carrier(R)) :=
  ∃ I, ∃ b, Finite(I) ∧ ModuleBasis(M, R, I, b) ∧
    d = matDet(R, I, linearToMatrix(M, R, M, I, b, I, b, f))
requires ring : CommRing(R)
requires free : FiniteFreeModule(M, R)
requires linear : LinearMap(f, M, R, M)
proof
  obtain ⟨I, b, finite, basis⟩ := free
  have matrixIn := linearToMatrix.mem at R, M, M, I, b, I, b, f
    with ring, finite, finite, basis, basis, linear
  have value := matDet.mem at R, I, linearToMatrix(M, R, M, I, b, I, b, f)
    with ring, finite, matrixIn
  witness matDet(R, I, linearToMatrix(M, R, M, I, b, I, b, f))
  exact ⟨value, I, b, finite, basis, rfl⟩
uniqueness
  intros u hu first v hv second
  obtain ⟨I, b, finiteI, basisB, equalU⟩ := first
  obtain ⟨J, c, finiteJ, basisC, equalV⟩ := second
  rw [equalU, equalV]
  exact matDet.basis_independent at R, M, f, J, c, I, b
    with ring, finiteJ, finiteI, basisC, basisB, linear

-- Section: Determinants of endomorphisms
section LinearDeterminant
variable (R M : Set)
hypothesis ring : CommRing(R)
hypothesis free : FiniteFreeModule(M, R)

-- LinearMap.det_toMatrix: every basis gives the same determinant.
theorem linearDet.of_basis (f I b : Set)
  requires linear : LinearMap(f, M, R, M)
  requires finite : Finite(I)
  requires basis : ModuleBasis(M, R, I, b)
  shows linearDet(M, R, f) = matDet(R, I, linearToMatrix(M, R, M, I, b, I, b, f))
proof
  have selected := linearDet.selected at M, R, f with ring, free, linear
  obtain ⟨_, J, c, finiteJ, basisC, equal⟩ := selected
  rw equal
  exact matDet.basis_independent at R, M, f, I, b, J, c
    with ring, finite, finiteJ, basis, basisC, linear

-- LinearMap.det_comp and det_id.
theorem linearDet.compose (f g : Set)
  requires first : LinearMap(f, M, R, M)
  requires second : LinearMap(g, M, R, M)
  shows linearDet(M, R, compose(g, f, Module.carrier(M), Module.carrier(M),
    Module.carrier(M))) = call2(R.mul, linearDet(M, R, g), linearDet(M, R, f))
proof
  have free0 := free
  obtain ⟨I, b, finite, basis⟩ := free0
  have composedLinear := LinearMap.compose_of at f, g, M, R, M, M with first, second
  have ofComposed := linearDet.of_basis at R, M, compose(g, f, Module.carrier(M),
    Module.carrier(M), Module.carrier(M)), I, b
    with ring, free, composedLinear, finite, basis
  have ofG := linearDet.of_basis at R, M, g, I, b with ring, free, second, finite, basis
  have ofF := linearDet.of_basis at R, M, f, I, b with ring, free, first, finite, basis
  have product := linearToMatrix.compose at R, M, M, M, I, b, I, b, I, b, f, g
    with ring, finite, finite, finite, basis, basis, basis, first, second
  have matrixG := linearToMatrix.mem at R, M, M, I, b, I, b, g
    with ring, finite, finite, basis, basis, second
  have matrixF := linearToMatrix.mem at R, M, M, I, b, I, b, f
    with ring, finite, finite, basis, basis, first
  rw [ofComposed, ofG, ofF, product]
  exact matDet.mul at R, I, linearToMatrix(M, R, M, I, b, I, b, g),
    linearToMatrix(M, R, M, I, b, I, b, f) with ring, finite, matrixG, matrixF

theorem linearDet.identity
  shows linearDet(M, R, identity(Module.carrier(M))) = R.one
proof
  have free0 := free
  obtain ⟨I, b, finite, basis⟩ := free0
  have basis0 := basis
  obtain ⟨_, spans⟩ := basis0
  obtain ⟨module, _, _⟩ := spans
  have identityLinear := LinearMap.identity at M, R with module
  have ofBasis := linearDet.of_basis at R, M, identity(Module.carrier(M)), I, b
    with ring, free, identityLinear, finite, basis
  have unitMatrix := linearToMatrix.identity at R, M, I, b with ring, finite, basis
  rw [ofBasis, unitMatrix]
  exact matDet.one at R, I with ring, finite

-- LinearMap.det_toLin': on Rⁿ the determinant of v ↦ A v is det A.
theorem linearDet.mulVec (n A : Set)
  requires finite : Finite(n)
  requires matrix : A ∈ matrixSpace(R, n, n)
  shows linearDet(coordinateModule(R, n), R, mulVecMap(R, n, n, A)) =
    matDet(R, n, A)
proof
  have basisN := standardBasis.basis at R, n with ring, finite
  have freeN : FiniteFreeModule(coordinateModule(R, n), R)
    unfold FiniteFreeModule
    exact ⟨n, standardBasis(R, n), finite, basisN⟩
  have linearA := mulVecMap.linear at R, n, n, A with ring, finite, matrix
  have ofBasis := linearDet.of_basis at R, coordinateModule(R, n),
    mulVecMap(R, n, n, A), n, standardBasis(R, n)
    with ring, freeN, linearA, finite, basisN
  have standard := linearToMatrix.standard at R, n, n, A
    with ring, finite, finite, matrix
  rw [ofBasis, standard]

-- An endomorphism is invertible iff its determinant is a unit.
theorem linearDet.unit_iff (f : Set)
  requires linear : LinearMap(f, M, R, M)
  shows LinearEquiv(f, M, R, M) ↔ RingUnit(R, linearDet(M, R, f))
proof
  sorry

end LinearDeterminant

-- The determinant is the action on the top exterior power: ⋀(v ↦ A v)
-- sends e_n to det(A) e_n.
theorem matDet.exterior (R n lt A : Set)
  requires ring : CommRing(R)
  requires finite : Finite(n)
  requires order : StrictLinearOrder(n, lt)
  requires matrix : A ∈ matrixSpace(R, n, n)
  shows exteriorMap(R, n, lt, n, lt, mulVecMap(R, n, n, A))(
      exteriorBasisVector(R, n, n)) =
    call2(Module.smul(exteriorModule(R, n)), matDet(R, n, A),
      exteriorBasisVector(R, n, n))
proof
  sorry
