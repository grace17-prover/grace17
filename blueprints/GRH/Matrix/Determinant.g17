-- Determinants of square matrices on any finite index set, as Cumulus's
-- Leibniz determinant: multiplicativity, transpose and conjugate
-- transpose, diagonal, triangular and block matrices with the Schur
-- complement, reindexing, images under ring maps, linearity in a column,
-- det(1 + AB) = det(1 + BA); units of a ring and invertible matrices, the
-- adjugate and the inverse (Matrix.nonsing_inv), Cramer's rule, singular
-- matrices over a field; the determinant of an endomorphism of a finite
-- free module, independent of the basis (LinearMap.det); and the
-- determinant as the top exterior power.
-- Part of the GRH blueprint.
-- Planned home: LinearAlgebra/Matrix/Determinant.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Matrix.Determinant
import GRH.Matrix.Basic
import GRH.Linear.Exterior
import Grace.Cumulus.Algebra.Ring.DeterminantProduct
import Grace.Cumulus.Algebra.Ring.Adjugate

-- Section: Definitions
-- det A and adj A over the bundled commutative ring R, for A on n × n with
-- n finite. Cumulus's determinant and adjugate are taken at the natural
-- number card(n), on A transported along an enumeration e : card(n) → n;
-- every enumeration gives the same value, and that value is the one
-- defined. (Matrix.det uses the sign of a permutation of any finite type.
-- Cumulus's sign at an index set counts ∈-inversions, which is the sign
-- only on a natural number, so it is not applied at n itself.)
def matDetValues (R n A : Set) : Set :=
  { d ∈ Ring.carrier(R) | ∀ e, BijectiveBetween(e, cardinality(n), n) →
    d = determinant(cardinality(n), Ring.carrier(R), Ring.add(R),
      Ring.zero(R), Ring.neg(R), Ring.mul(R), Ring.one(R),
      submatrix(R, cardinality(n), cardinality(n), A, e, e)) }

def matDet (R n A : Set) : Set := ⋃(matDetValues(R, n, A))

def matAdjugateValues (R n A : Set) : Set :=
  { B ∈ matrixSpace(R, n, n) | ∀ e, BijectiveBetween(e, cardinality(n), n) →
    submatrix(R, cardinality(n), cardinality(n), B, e, e) =
      adjugate(cardinality(n), Ring.carrier(R), Ring.add(R), Ring.zero(R),
        Ring.neg(R), Ring.mul(R), Ring.one(R),
        submatrix(R, cardinality(n), cardinality(n), A, e, e)) }

def matAdjugate (R n A : Set) : Set := ⋃(matAdjugateValues(R, n, A))

-- The units of a ring (IsUnit) and the inverse of a unit, unique.
predicate RingUnit (R a : Set) :=
  a ∈ Ring.carrier(R) ∧ (∃ b ∈ Ring.carrier(R),
    call2(Ring.mul(R), a, b) = Ring.one(R) ∧ call2(Ring.mul(R), b, a) = Ring.one(R))

def ringUnits (R : Set) : Set := { a ∈ Ring.carrier(R) | RingUnit(R, a) }

defunique ringInverse (R a : Set) (b ∈ Ring.carrier(R)) :=
  call2(Ring.mul(R), a, b) = Ring.one(R) ∧ call2(Ring.mul(R), b, a) = Ring.one(R)
requires ring : Ring(R)
requires unit : RingUnit(R, a)
proof
  obtain ⟨aIn, b, bIn, right, left⟩ := unit
  witness b
  exact ⟨bIn, right, left⟩
uniqueness
  have parts := Ring.parts with ring
  have monoid := IsRing.multiplicative with parts
  obtain ⟨aIn, _⟩ := unit
  intros b bIn first c cIn second
  obtain ⟨r1, l1⟩ := first
  obtain ⟨r2, l2⟩ := second
  have hb : IsInverse(R.carrier, R.mul, R.one, a, b)
    unfold IsInverse
    exact ⟨aIn, bIn, l1, r1⟩
  have hc : IsInverse(R.carrier, R.mul, R.one, a, c)
    unfold IsInverse
    exact ⟨aIn, cIn, l2, r2⟩
  exact IsInverse.unique with monoid, hb, hc

-- An invertible square matrix (IsUnit in Mₙ(R)), and the inverse
-- det(A)⁻¹ adj(A) of a matrix whose determinant is a unit (Matrix.inv;
-- Mathlib's value 0 at a singular matrix is not part of the definition).
predicate InvertibleMatrix (R n A : Set) :=
  A ∈ matrixSpace(R, n, n) ∧ (∃ B ∈ matrixSpace(R, n, n),
    matMul(R, n, n, n, A, B) = matOne(R, n) ∧ matMul(R, n, n, n, B, A) = matOne(R, n))

def matInverse (R n A : Set) : Set :=
  matSmul(R, n, n, ringInverse(R, matDet(R, n, A)), matAdjugate(R, n, A))

-- The determinant of an endomorphism f of a finite free module: the
-- determinant of its matrix in a finite basis, the same in every basis
-- (LinearMap.det, without a chosen basis).
defunique linearDet (M R f : Set) (d ∈ Ring.carrier(R)) :=
  ∃ I, ∃ b, Finite(I) ∧ ModuleBasis(M, R, I, b) ∧
    d = matDet(R, I, linearToMatrix(M, R, M, I, b, I, b, f))
requires ring : CommRing(R)
requires free : FiniteFreeModule(M, R)
requires linear : LinearMap(f, M, R, M)
proof
  sorry
uniqueness
  sorry

-- The family of columns j ↦ A[·, j] of an m × n matrix.
def columnFamily (R m n A : Set) : Set :=
  { q ∈ n × functionSpace(m, Ring.carrier(R)) | ∃ j ∈ n,
    q = (j, matCol(R, m, A, j)) }

-- The product of the diagonal entries.
def matDiagProduct (R n A : Set) : Set :=
  finiteRingProduct(n, Ring.carrier(R), Ring.add(R), Ring.zero(R), Ring.neg(R),
    Ring.mul(R), Ring.one(R), matDiag(R, n, A))

-- Section: Laws of the determinant
section Determinants
variable (R : Set)
hypothesis ring : CommRing(R)

theorem matDet.mem (n A : Set)
  requires finite : Finite(n)
  requires matrix : A ∈ matrixSpace(R, n, n)
  shows matDet(R, n, A) ∈ R.carrier
proof
  sorry

-- det A is Cumulus's determinant of A transported along any enumeration
-- of n (the definition's well-definedness).
theorem matDet.enumeration (n A e : Set)
  requires finite : Finite(n)
  requires matrix : A ∈ matrixSpace(R, n, n)
  requires enumeration : BijectiveBetween(e, cardinality(n), n)
  shows matDet(R, n, A) = determinant(cardinality(n), R.carrier, R.add,
    R.zero, R.neg, R.mul, R.one,
    submatrix(R, cardinality(n), cardinality(n), A, e, e))
proof
  sorry

-- adj A likewise, entrywise along any enumeration of n.
theorem matAdjugate.enumeration (n A e : Set)
  requires finite : Finite(n)
  requires matrix : A ∈ matrixSpace(R, n, n)
  requires enumeration : BijectiveBetween(e, cardinality(n), n)
  shows matAdjugate(R, n, A) ∈ matrixSpace(R, n, n) ∧
    submatrix(R, cardinality(n), cardinality(n), matAdjugate(R, n, A), e, e) =
      adjugate(cardinality(n), R.carrier, R.add, R.zero, R.neg, R.mul, R.one,
        submatrix(R, cardinality(n), cardinality(n), A, e, e))
proof
  sorry

-- On n = {0, …, n − 1} it is Cumulus's det.
theorem matDet.nat (n : Nat) (A : Set)
  requires matrix : A : R ^ n × n
  shows matDet(R, n, A) = det(A)
proof
  sorry

-- Matrix.det_mul.
theorem matDet.mul (n A B : Set)
  requires finite : Finite(n)
  requires first : A ∈ matrixSpace(R, n, n)
  requires second : B ∈ matrixSpace(R, n, n)
  shows matDet(R, n, matMul(R, n, n, n, A, B)) = matDet(R, n, A) * matDet(R, n, B)
proof
  sorry

theorem matDet.one (n : Set)
  requires finite : Finite(n)
  shows matDet(R, n, matOne(R, n)) = R.one
proof
  sorry

-- Matrix.det_transpose.
theorem matDet.transpose (n A : Set)
  requires finite : Finite(n)
  requires matrix : A ∈ matrixSpace(R, n, n)
  shows matDet(R, n, matTranspose(R, n, n, A)) = matDet(R, n, A)
proof
  sorry

-- Matrix.det_diagonal and det_of_upperTriangular: triangular matrices
-- (block-triangular for an order on n itself) have the product of the
-- diagonal as determinant.
theorem matDet.diagonal (n d : Set)
  requires finite : Finite(n)
  requires vector : d ∈ functionSpace(n, R.carrier)
  shows matDet(R, n, matDiagonal(R, n, d)) = finiteRingProduct(n, R.carrier,
    R.add, R.zero, R.neg, R.mul, R.one, d)
proof
  sorry

theorem matDet.triangular (n A lt : Set)
  requires finite : Finite(n)
  requires order : StrictLinearOrder(n, lt)
  requires matrix : A ∈ matrixSpace(R, n, n)
  requires triangular : BlockTriangular(R, n, A, identity(n), lt)
  shows matDet(R, n, A) = matDiagProduct(R, n, A)
proof
  sorry

-- Matrix.det_smul: det(a A) = a^|n| det A.
theorem matDet.smul (n a A : Set)
  requires finite : Finite(n)
  requires scalar : a ∈ R.carrier
  requires matrix : A ∈ matrixSpace(R, n, n)
  shows matDet(R, n, matSmul(R, n, n, a, A)) =
    monoidPow(R.mul, R.one, a, cardinality(n)) * matDet(R, n, A)
proof
  sorry

-- RingHom.map_det.
theorem matDet.map (S n f A : Set)
  requires target : CommRing(S)
  requires finite : Finite(n)
  requires hom : RingHom(f, R, S)
  requires matrix : A ∈ matrixSpace(R, n, n)
  shows f(matDet(R, n, A)) = matDet(S, n, matMap(S, n, n, f, A))
proof
  sorry

-- Matrix.det_conjTranspose: det Aᴴ = σ(det A).
theorem matDet.conjTranspose (σ n A : Set)
  requires involution : RingInvolution(σ, R)
  requires finite : Finite(n)
  requires matrix : A ∈ matrixSpace(R, n, n)
  shows matDet(R, n, conjTranspose(R, σ, n, n, A)) = σ(matDet(R, n, A))
proof
  sorry

-- Matrix.det_submatrix_equiv_self and det_reindex_self: reindexing by a
-- bijection e : n2 → n keeps the determinant.
theorem matDet.reindex (n n2 e A : Set)
  requires finite : Finite(n)
  requires bijective : BijectiveBetween(e, n2, n)
  requires matrix : A ∈ matrixSpace(R, n, n)
  shows matDet(R, n2, submatrix(R, n2, n2, A, e, e)) = matDet(R, n, A)
proof
  sorry

-- Permuting the columns alone multiplies by the sign.
theorem matDet.permute_columns (n σ A : Set)
  requires finite : Finite(n)
  requires permutation : σ ∈ permutations(n)
  requires matrix : A ∈ matrixSpace(R, n, n)
  shows matDet(R, n, submatrix(R, n, n, A, identity(n), σ)) =
    permutationSign(n, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, σ) *
      matDet(R, n, A)
proof
  sorry

-- Matrix.det_fromBlocks_zero₂₁: a block upper-triangular matrix.
theorem matDet.fromBlocks_zero (m n A B D : Set)
  requires finiteM : Finite(m)
  requires finiteN : Finite(n)
  requires a : A ∈ matrixSpace(R, m, m)
  requires b : B ∈ matrixSpace(R, m, n)
  requires d : D ∈ matrixSpace(R, n, n)
  shows matDet(R, m ⊎ n, fromBlocks(R, m, n, m, n, A, B, matZero(R, n, m), D)) =
    matDet(R, m, A) * matDet(R, n, D)
proof
  sorry

-- Matrix.det_fromBlocks₁₁: the Schur complement, for A invertible.
theorem matDet.fromBlocks_schur (m n A B C D : Set)
  requires finiteM : Finite(m)
  requires finiteN : Finite(n)
  requires a : A ∈ matrixSpace(R, m, m)
  requires b : B ∈ matrixSpace(R, m, n)
  requires c : C ∈ matrixSpace(R, n, m)
  requires d : D ∈ matrixSpace(R, n, n)
  requires unit : RingUnit(R, matDet(R, m, A))
  shows matDet(R, m ⊎ n, fromBlocks(R, m, n, m, n, A, B, C, D)) =
    matDet(R, m, A) * matDet(R, n, matAdd(R, n, n, D, matNeg(R, n, n,
      matMul(R, n, m, n, C, matMul(R, m, m, n, matInverse(R, m, A), B)))))
proof
  sorry

-- Matrix.det_one_add_mul_comm: det(1 + A B) = det(1 + B A) for A m × n
-- and B n × m.
theorem matDet.one_add_mul_comm (m n A B : Set)
  requires finiteM : Finite(m)
  requires finiteN : Finite(n)
  requires first : A ∈ matrixSpace(R, m, n)
  requires second : B ∈ matrixSpace(R, n, m)
  shows matDet(R, m, matAdd(R, m, m, matOne(R, m), matMul(R, m, n, m, A, B))) =
    matDet(R, n, matAdd(R, n, n, matOne(R, n), matMul(R, n, m, n, B, A)))
proof
  sorry

-- Linearity in a column (Matrix.det_updateCol_add, det_updateCol_smul).
theorem matDet.update_column_add (n A j u v : Set)
  requires finite : Finite(n)
  requires matrix : A ∈ matrixSpace(R, n, n)
  requires index : j ∈ n
  requires first : u ∈ functionSpace(n, R.carrier)
  requires second : v ∈ functionSpace(n, R.carrier)
  shows matDet(R, n, updateColumn(R, n, n, A, j, vecAdd(R, n, u, v))) =
    matDet(R, n, updateColumn(R, n, n, A, j, u)) +
      matDet(R, n, updateColumn(R, n, n, A, j, v))
proof
  sorry

theorem matDet.update_column_smul (n A j a u : Set)
  requires finite : Finite(n)
  requires matrix : A ∈ matrixSpace(R, n, n)
  requires index : j ∈ n
  requires scalar : a ∈ R.carrier
  requires vector : u ∈ functionSpace(n, R.carrier)
  shows matDet(R, n, updateColumn(R, n, n, A, j, vecSmul(R, n, a, u))) =
    a * matDet(R, n, updateColumn(R, n, n, A, j, u))
proof
  sorry

-- Matrix.det_eq_zero_of_column_eq_zero and of two equal columns.
theorem matDet.zero_column (n A j : Set)
  requires finite : Finite(n)
  requires matrix : A ∈ matrixSpace(R, n, n)
  requires index : j ∈ n
  requires vanishes : ∀ i ∈ n, A[i, j] = R.zero
  shows matDet(R, n, A) = R.zero
proof
  sorry

theorem matDet.equal_columns (n A j k : Set)
  requires finite : Finite(n)
  requires matrix : A ∈ matrixSpace(R, n, n)
  requires first : j ∈ n
  requires second : k ∈ n
  requires distinct : j ≠ k
  requires same : ∀ i ∈ n, A[i, j] = A[i, k]
  shows matDet(R, n, A) = R.zero
proof
  sorry

-- Section: Adjugate and inverse
theorem matAdjugate.mem (n A : Set)
  requires finite : Finite(n)
  requires matrix : A ∈ matrixSpace(R, n, n)
  shows matAdjugate(R, n, A) ∈ matrixSpace(R, n, n)
proof
  sorry

-- Matrix.mul_adjugate and adjugate_mul: A adj A = adj A A = det(A) 1.
theorem matAdjugate.mul_right (n A : Set)
  requires finite : Finite(n)
  requires matrix : A ∈ matrixSpace(R, n, n)
  shows matMul(R, n, n, n, A, matAdjugate(R, n, A)) = matScalar(R, n, matDet(R, n, A))
proof
  sorry

theorem matAdjugate.mul_left (n A : Set)
  requires finite : Finite(n)
  requires matrix : A ∈ matrixSpace(R, n, n)
  shows matMul(R, n, n, n, matAdjugate(R, n, A), A) = matScalar(R, n, matDet(R, n, A))
proof
  sorry

-- Matrix.isUnit_iff_isUnit_det.
theorem InvertibleMatrix.iff_det (n A : Set)
  requires finite : Finite(n)
  requires matrix : A ∈ matrixSpace(R, n, n)
  shows InvertibleMatrix(R, n, A) ↔ RingUnit(R, matDet(R, n, A))
proof
  sorry

theorem matInverse.mul_right (n A : Set)
  requires finite : Finite(n)
  requires matrix : A ∈ matrixSpace(R, n, n)
  requires unit : RingUnit(R, matDet(R, n, A))
  shows matMul(R, n, n, n, A, matInverse(R, n, A)) = matOne(R, n)
proof
  sorry

theorem matInverse.mul_left (n A : Set)
  requires finite : Finite(n)
  requires matrix : A ∈ matrixSpace(R, n, n)
  requires unit : RingUnit(R, matDet(R, n, A))
  shows matMul(R, n, n, n, matInverse(R, n, A), A) = matOne(R, n)
proof
  sorry

-- Matrix.inv_eq_left_inv and inv_eq_right_inv: a one-sided inverse is the
-- inverse.
theorem matInverse.eq_left_inverse (n A B : Set)
  requires finite : Finite(n)
  requires first : A ∈ matrixSpace(R, n, n)
  requires second : B ∈ matrixSpace(R, n, n)
  requires left : matMul(R, n, n, n, B, A) = matOne(R, n)
  shows RingUnit(R, matDet(R, n, A)) ∧ B = matInverse(R, n, A)
proof
  sorry

theorem matInverse.eq_right_inverse (n A B : Set)
  requires finite : Finite(n)
  requires first : A ∈ matrixSpace(R, n, n)
  requires second : B ∈ matrixSpace(R, n, n)
  requires right : matMul(R, n, n, n, A, B) = matOne(R, n)
  shows RingUnit(R, matDet(R, n, A)) ∧ B = matInverse(R, n, A)
proof
  sorry

-- Matrix.mul_inv_rev, det_nonsing_inv, transpose_nonsing_inv, and
-- conjTranspose_nonsing_inv.
theorem matInverse.mul (n A B : Set)
  requires finite : Finite(n)
  requires first : A ∈ matrixSpace(R, n, n)
  requires second : B ∈ matrixSpace(R, n, n)
  requires unitA : RingUnit(R, matDet(R, n, A))
  requires unitB : RingUnit(R, matDet(R, n, B))
  shows matInverse(R, n, matMul(R, n, n, n, A, B)) =
    matMul(R, n, n, n, matInverse(R, n, B), matInverse(R, n, A))
proof
  sorry

theorem matInverse.det (n A : Set)
  requires finite : Finite(n)
  requires matrix : A ∈ matrixSpace(R, n, n)
  requires unit : RingUnit(R, matDet(R, n, A))
  shows matDet(R, n, matInverse(R, n, A)) = ringInverse(R, matDet(R, n, A))
proof
  sorry

theorem matInverse.transpose (n A : Set)
  requires finite : Finite(n)
  requires matrix : A ∈ matrixSpace(R, n, n)
  requires unit : RingUnit(R, matDet(R, n, A))
  shows matTranspose(R, n, n, matInverse(R, n, A)) =
    matInverse(R, n, matTranspose(R, n, n, A))
proof
  sorry

theorem matInverse.conjTranspose (σ n A : Set)
  requires involution : RingInvolution(σ, R)
  requires finite : Finite(n)
  requires matrix : A ∈ matrixSpace(R, n, n)
  requires unit : RingUnit(R, matDet(R, n, A))
  shows conjTranspose(R, σ, n, n, matInverse(R, n, A)) =
    matInverse(R, n, conjTranspose(R, σ, n, n, A))
proof
  sorry

theorem matInverse.map (S n f A : Set)
  requires target : CommRing(S)
  requires finite : Finite(n)
  requires hom : RingHom(f, R, S)
  requires matrix : A ∈ matrixSpace(R, n, n)
  requires unit : RingUnit(R, matDet(R, n, A))
  shows matMap(S, n, n, f, matInverse(R, n, A)) =
    matInverse(S, n, matMap(S, n, n, f, A))
proof
  sorry

-- Matrix.cramer: for A x = b, det(A) x(i) is the determinant of A with
-- column i replaced by b.
theorem matDet.cramer (n A x b i : Set)
  requires finite : Finite(n)
  requires matrix : A ∈ matrixSpace(R, n, n)
  requires vector : x ∈ functionSpace(n, R.carrier)
  requires solves : mulVec(R, n, n, A, x) = b
  requires index : i ∈ n
  shows matDet(R, n, A) * x(i) = matDet(R, n, updateColumn(R, n, n, A, i, b))
proof
  sorry

-- The ring units: closure, and the inverse of a unit.
theorem RingUnit.mul (a b : Set)
  requires first : RingUnit(R, a)
  requires second : RingUnit(R, b)
  shows RingUnit(R, a * b)
proof
  have ringR := CommRing.to_ring with ring
  obtain ⟨aIn, a2, a2In, ra, la⟩ := first
  obtain ⟨bIn, b2, b2In, rb, lb⟩ := second
  have ab := Ring.mul_mem at R, a, b with ringR, aIn, bIn
  have ba := Ring.mul_mem at R, b2, a2 with ringR, b2In, a2In
  unfold RingUnit
  refine ⟨ab, call2(R.mul, b2, a2), ba, ?_, ?_⟩
  . have e : call2(R.mul, call2(R.mul, a, b), call2(R.mul, b2, a2)) = call2(R.mul, call2(R.mul, a, call2(R.mul, b, b2)), a2) by ring
    rw [e, rb]
    have e2 : call2(R.mul, call2(R.mul, a, R.one), a2) = call2(R.mul, a, a2) by ring
    rw [e2, ra]
  . have e : call2(R.mul, call2(R.mul, b2, a2), call2(R.mul, a, b)) = call2(R.mul, call2(R.mul, b2, call2(R.mul, a2, a)), b) by ring
    rw [e, la]
    have e2 : call2(R.mul, call2(R.mul, b2, R.one), b) = call2(R.mul, b2, b) by ring
    rw [e2, lb]

theorem ringInverse.mul_right (a : Set)
  requires unit : RingUnit(R, a)
  shows a * ringInverse(R, a) = R.one
proof
  have ringR := CommRing.to_ring with ring
  have selected := ringInverse.selected at R, a with ringR, unit
  obtain ⟨_, right, _⟩ := selected
  exact right

theorem RingUnit.map (S f a : Set)
  requires target : CommRing(S)
  requires hom : RingHom(f, R, S)
  requires unit : RingUnit(R, a)
  shows RingUnit(S, f(a))
proof
  sorry

end Determinants

-- Section: Fields
section Fields
variable (K : Set)
hypothesis field : Field(K)

-- Matrix.exists_mulVec_eq_zero_iff: over a field, A v = 0 for some v ≠ 0
-- exactly when det A = 0.
theorem matDet.eq_zero_iff_kernel (n A : Set)
  requires finite : Finite(n)
  requires matrix : A ∈ matrixSpace(K, n, n)
  shows matDet(K, n, A) = K.zero ↔
    (∃ v ∈ functionSpace(n, K.carrier),
      v ≠ constantFunction(n, K.carrier, K.zero) ∧
      mulVec(K, n, n, A, v) = constantFunction(n, K.carrier, K.zero))
proof
  sorry

-- Over a field, det A ≠ 0 iff the columns are independent, iff A is
-- invertible.
theorem matDet.ne_zero_iff_independent (n A : Set)
  requires finite : Finite(n)
  requires matrix : A ∈ matrixSpace(K, n, n)
  shows matDet(K, n, A) ≠ K.zero ↔
    LinearIndependent(coordinateModule(K, n), K, n, columnFamily(K, n, n, A))
proof
  sorry

theorem InvertibleMatrix.iff_det_ne_zero (n A : Set)
  requires finite : Finite(n)
  requires matrix : A ∈ matrixSpace(K, n, n)
  shows InvertibleMatrix(K, n, A) ↔ matDet(K, n, A) ≠ K.zero
proof
  sorry

end Fields

-- Section: Determinants of endomorphisms
section LinearDeterminant
variable (R M : Set)
hypothesis ring : CommRing(R)
hypothesis free : FiniteFreeModule(M, R)

-- LinearMap.det_toMatrix: every basis gives the same determinant.
theorem linearDet.of_basis (f I b : Set)
  requires linear : LinearMap(f, M, R, M)
  requires finite : Finite(I)
  requires basis : ModuleBasis(M, R, I, b)
  shows linearDet(M, R, f) = matDet(R, I, linearToMatrix(M, R, M, I, b, I, b, f))
proof
  sorry

-- LinearMap.det_comp and det_id.
theorem linearDet.compose (f g : Set)
  requires first : LinearMap(f, M, R, M)
  requires second : LinearMap(g, M, R, M)
  shows linearDet(M, R, compose(g, f, Module.carrier(M), Module.carrier(M),
    Module.carrier(M))) = call2(R.mul, linearDet(M, R, g), linearDet(M, R, f))
proof
  sorry

theorem linearDet.identity
  shows linearDet(M, R, identity(Module.carrier(M))) = R.one
proof
  sorry

-- LinearMap.det_toLin': on Rⁿ the determinant of v ↦ A v is det A.
theorem linearDet.mulVec (n A : Set)
  requires finite : Finite(n)
  requires matrix : A ∈ matrixSpace(R, n, n)
  shows linearDet(coordinateModule(R, n), R, mulVecMap(R, n, n, A)) =
    matDet(R, n, A)
proof
  sorry

-- An endomorphism is invertible iff its determinant is a unit.
theorem linearDet.unit_iff (f : Set)
  requires linear : LinearMap(f, M, R, M)
  shows LinearEquiv(f, M, R, M) ↔ RingUnit(R, linearDet(M, R, f))
proof
  sorry

end LinearDeterminant

-- The determinant is the action on the top exterior power: ⋀(v ↦ A v)
-- sends e_n to det(A) e_n.
theorem matDet.exterior (R n lt A : Set)
  requires ring : CommRing(R)
  requires finite : Finite(n)
  requires order : StrictLinearOrder(n, lt)
  requires matrix : A ∈ matrixSpace(R, n, n)
  shows exteriorMap(R, n, lt, n, lt, mulVecMap(R, n, n, A))(
      exteriorBasisVector(R, n, n)) =
    call2(Module.smul(exteriorModule(R, n)), matDet(R, n, A),
      exteriorBasisVector(R, n, n))
proof
  sorry
