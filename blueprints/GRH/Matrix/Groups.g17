-- Matrix groups over a commutative ring: the unit group Rˣ, the general
-- linear group GLₙ(R) of invertible matrices on a finite index set, the
-- special linear group SLₙ(R), the determinant and entrywise ring maps
-- as homomorphisms, scalar matrices; for a ring with involution σ (ℂ, a
-- quadratic extension with its conjugation, a CM field and its adeles)
-- the unitary elements uσ(u) = 1 and the unitary group
-- U(J) = {g ∈ GLₙ(R) : gᴴ J g = J} of a matrix J, with its laws (the
-- inverse, invariance of the form, change of J by congruence, entrywise
-- ring maps, the determinant, block sums, reindexing); and the symplectic
-- group, U(J) for the standard alternating J and the trivial involution.
-- Part of the GRH blueprint.
-- Planned home: LinearAlgebra/Matrix/Groups.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Matrix.Groups
import GRH.Matrix.Determinant
import Grace.Cumulus.Algebra.Group.Kernel
import Grace.Cumulus.Algebra.Group.Isomorphism
import Grace.Cumulus.Algebra.Group.Product

-- Section: Units and the general linear group
-- The unit group Rˣ of a ring (Mathlib's Units R), elements being the
-- units themselves.
def unitInverseMap (R : Set) : Set :=
  { p ∈ ringUnits(R) × ringUnits(R) | ∃ a ∈ ringUnits(R),
    p = (a, ringInverse(R, a)) }

def unitGroup (R : Set) : Set :=
  Group.mk(ringUnits(R), restrict(Ring.mul(R), ringUnits(R) × ringUnits(R)),
    Ring.one(R), unitInverseMap(R))

-- GLₙ(R): the invertible n × n matrices under multiplication, with the
-- inverse det(A)⁻¹ adj(A) (Matrix.GeneralLinearGroup; its elements are the
-- matrices, so Mathlib's coercion ↑g is the identity here and
-- Matrix.coe_units_inv is matInverse).
def invertibleMatrices (R n : Set) : Set :=
  { A ∈ matrixSpace(R, n, n) | InvertibleMatrix(R, n, A) }

def matInverseMap (R n : Set) : Set :=
  { p ∈ invertibleMatrices(R, n) × invertibleMatrices(R, n) |
    ∃ A ∈ invertibleMatrices(R, n), p = (A, matInverse(R, n, A)) }

def generalLinearGroup (R n : Set) : Set :=
  Group.mk(invertibleMatrices(R, n),
    restrict(matMultiplication(R, n),
      invertibleMatrices(R, n) × invertibleMatrices(R, n)),
    matOne(R, n), matInverseMap(R, n))

-- SLₙ(R) = {A ∈ GLₙ(R) : det A = 1} (Matrix.SpecialLinearGroup), as a
-- subgroup and as a group.
def specialLinearMatrices (R n : Set) : Set :=
  { A ∈ invertibleMatrices(R, n) | matDet(R, n, A) = Ring.one(R) }

def specialLinearGroup (R n : Set) : Set :=
  Group.mk(specialLinearMatrices(R, n),
    restrict(matMultiplication(R, n),
      specialLinearMatrices(R, n) × specialLinearMatrices(R, n)),
    matOne(R, n), restrict(matInverseMap(R, n), specialLinearMatrices(R, n)))

-- det : GLₙ(R) → Rˣ (Matrix.detMonoidHom), A ↦ f(A) along a ring map
-- f : R → S (Matrix.GeneralLinearGroup.map), and a ↦ a·1 on Rˣ
-- (GeneralLinearGroup.scalar).
def determinantHom (R n : Set) : Set :=
  { p ∈ invertibleMatrices(R, n) × ringUnits(R) | ∃ A ∈ invertibleMatrices(R, n),
    p = (A, matDet(R, n, A)) }

def generalLinearMap (S n f R : Set) : Set :=
  { p ∈ invertibleMatrices(R, n) × invertibleMatrices(S, n) |
    ∃ A ∈ invertibleMatrices(R, n), p = (A, matMap(S, n, n, f, A)) }

def scalarEmbedding (R n : Set) : Set :=
  { p ∈ ringUnits(R) × invertibleMatrices(R, n) | ∃ a ∈ ringUnits(R),
    p = (a, matScalar(R, n, a)) }

-- Section: Unitary groups
-- The unitary elements of a ring with involution, u σ(u) = 1 (Mathlib's
-- unitary R on a commutative star ring).
def unitaryElements (R σ : Set) : Set :=
  { u ∈ Ring.carrier(R) | call2(Ring.mul(R), u, σ(u)) = Ring.one(R) }

def unitaryElementGroup (R σ : Set) : Set :=
  Group.mk(unitaryElements(R, σ),
    restrict(Ring.mul(R), unitaryElements(R, σ) × unitaryElements(R, σ)),
    Ring.one(R), restrict(σ, unitaryElements(R, σ)))

-- The form Pᴴ J Q of a matrix J on n × n.
def gramMatrix (R σ n m p J P Q : Set) : Set :=
  matMul(R, m, n, p, conjTranspose(R, σ, n, m, P), matMul(R, n, n, p, J, Q))

-- U(J) = {g ∈ GLₙ(R) : gᴴ J g = J}, the unitary group of the form J
-- (the source's U J in Lib/General/Groups/ValuationPair), and the group.
-- J is a hermitian or skew-hermitian form in the uses, but the definition
-- and the subgroup property need no hypothesis on J.
def formUnitaryMatrices (R σ n J : Set) : Set :=
  { g ∈ invertibleMatrices(R, n) | gramMatrix(R, σ, n, n, n, J, g, g) = J }

def formUnitaryGroup (R σ n J : Set) : Set :=
  Group.mk(formUnitaryMatrices(R, σ, n, J),
    restrict(matMultiplication(R, n),
      formUnitaryMatrices(R, σ, n, J) × formUnitaryMatrices(R, σ, n, J)),
    matOne(R, n), restrict(matInverseMap(R, n), formUnitaryMatrices(R, σ, n, J)))

-- Mathlib's unitaryGroup n R: Aᴴ A = A Aᴴ = 1, which is U(1).
def unitaryMatrices (R σ n : Set) : Set :=
  { A ∈ matrixSpace(R, n, n) |
    matMul(R, n, n, n, conjTranspose(R, σ, n, n, A), A) = matOne(R, n) ∧
    matMul(R, n, n, n, A, conjTranspose(R, σ, n, n, A)) = matOne(R, n) }

-- The diagonal sign matrix diag(ε) for ε : n → {1, −1} (the source's
-- signMatrix; U(diag ε) is U(p, q)).
predicate SignVector (R n ε : Set) :=
  (ε : n → Ring.carrier(R)) ∧
  (∀ i ∈ n, ε(i) = Ring.one(R) ∨ ε(i) = apply(Ring.neg(R), Ring.one(R)))

def signMatrix (R n ε : Set) : Set := matDiagonal(R, n, ε)

-- g ↦ x g x⁻¹, U(J') → U(J) for x with xᴴ J x = J' (the source's U.conj).
def formUnitaryConjugation (R n x : Set) : Set :=
  { p ∈ invertibleMatrices(R, n) × invertibleMatrices(R, n) |
    ∃ g ∈ invertibleMatrices(R, n), p = (g, matMul(R, n, n, n, x,
      matMul(R, n, n, n, g, matInverse(R, n, x)))) }

-- (g, h) ↦ [g 0; 0 h], U(J) × U(J') → U([J 0; 0 J']) (the source's
-- U.sum).
def blockSumMap (R m n : Set) : Set :=
  { p ∈ (invertibleMatrices(R, m) × invertibleMatrices(R, n)) ×
      invertibleMatrices(R, m ⊎ n) |
    ∃ g ∈ invertibleMatrices(R, m), ∃ h ∈ invertibleMatrices(R, n),
      p = ((g, h), fromBlocks(R, m, n, m, n, g, matZero(R, m, n),
        matZero(R, n, m), h)) }

-- g ↦ g ∘ (e, e) for a bijection e : n2 → n (the source's U.reindex).
def reindexMap (R n n2 e : Set) : Set :=
  { p ∈ invertibleMatrices(R, n) × invertibleMatrices(R, n2) |
    ∃ g ∈ invertibleMatrices(R, n), p = (g, submatrix(R, n2, n2, g, e, e)) }

-- Section: Symplectic groups
-- The standard alternating form J = [0 −1; 1 0] on l ⊎ l (Matrix.J) and
-- Sp(2l, R) = {A : A J Aᵀ = J} (Matrix.symplecticGroup).
def symplecticForm (R l : Set) : Set :=
  fromBlocks(R, l, l, l, l, matZero(R, l, l), matNeg(R, l, l, matOne(R, l)),
    matOne(R, l), matZero(R, l, l))

def symplecticMatrices (R l : Set) : Set :=
  { A ∈ matrixSpace(R, l ⊎ l, l ⊎ l) |
    matMul(R, l ⊎ l, l ⊎ l, l ⊎ l, A, matMul(R, l ⊎ l, l ⊎ l, l ⊎ l,
      symplecticForm(R, l), matTranspose(R, l ⊎ l, l ⊎ l, A))) =
    symplecticForm(R, l) }

theorem matInverseMap.graph_relates (R n A : Set)
  requires index : A ∈ invertibleMatrices(R, n)
  requires valueIn : matInverse(R, n, A) ∈ invertibleMatrices(R, n)
  shows relates(matInverseMap(R, n), A, matInverse(R, n, A))
proof
  unfold relates
  apply matInverseMap.membership.backward
  refine ⟨(product.pair at A, matInverse(R, n, A), invertibleMatrices(R, n), invertibleMatrices(R, n) with index, valueIn), A, index, rfl⟩

theorem matInverseMap.graph_function (R n : Set)
  requires values : ∀ A ∈ invertibleMatrices(R, n), matInverse(R, n, A) ∈ invertibleMatrices(R, n)
  shows matInverseMap(R, n) : invertibleMatrices(R, n) → invertibleMatrices(R, n)
proof
  constructor
    intros q0 member
    obtain ⟨bounded, witnesses⟩ := matInverseMap.membership.forward with member
    exact bounded
  . constructor
      intros z0 first xFirst second xSecond
      unfold relates at xFirst
      obtain ⟨_, a1, a1In, firstShape⟩ := matInverseMap.membership.forward with xFirst
      unfold relates at xSecond
      obtain ⟨_, a2, a2In, secondShape⟩ := matInverseMap.membership.forward with xSecond
      obtain ⟨xi, firstEqual⟩ := orderedPair.injective with firstShape
      obtain ⟨xj, secondEqual⟩ := orderedPair.injective with secondShape
      rw [firstEqual, secondEqual]
      cc
    . intros A xIn
      have valueIn := values with A, xIn
      refine ⟨matInverse(R, n, A), valueIn, (matInverseMap.graph_relates at R, n, A with xIn, valueIn)⟩

theorem matInverseMap.graph_apply (R n A : Set)
  requires values : ∀ A ∈ invertibleMatrices(R, n), matInverse(R, n, A) ∈ invertibleMatrices(R, n)
  requires index : A ∈ invertibleMatrices(R, n)
  shows matInverseMap(R, n)(A) = matInverse(R, n, A)
proof
  have function := matInverseMap.graph_function at R, n with values
  have valueIn := values with A, index
  have mapped := matInverseMap.graph_relates at R, n, A with index, valueIn
  exact FunctionBetween.apply_value with function, index, mapped


theorem unitInverseMap.graph_relates (R a : Set)
  requires index : a ∈ ringUnits(R)
  requires valueIn : ringInverse(R, a) ∈ ringUnits(R)
  shows relates(unitInverseMap(R), a, ringInverse(R, a))
proof
  unfold relates
  apply unitInverseMap.membership.backward
  refine ⟨(product.pair at a, ringInverse(R, a), ringUnits(R), ringUnits(R) with index, valueIn), a, index, rfl⟩

theorem unitInverseMap.graph_function (R : Set)
  requires values : ∀ a ∈ ringUnits(R), ringInverse(R, a) ∈ ringUnits(R)
  shows unitInverseMap(R) : ringUnits(R) → ringUnits(R)
proof
  constructor
    intros q0 member
    obtain ⟨bounded, witnesses⟩ := unitInverseMap.membership.forward with member
    exact bounded
  . constructor
      intros z0 first xFirst second xSecond
      unfold relates at xFirst
      obtain ⟨_, a1, a1In, firstShape⟩ := unitInverseMap.membership.forward with xFirst
      unfold relates at xSecond
      obtain ⟨_, a2, a2In, secondShape⟩ := unitInverseMap.membership.forward with xSecond
      obtain ⟨xi, firstEqual⟩ := orderedPair.injective with firstShape
      obtain ⟨xj, secondEqual⟩ := orderedPair.injective with secondShape
      rw [firstEqual, secondEqual]
      cc
    . intros a xIn
      have valueIn := values with a, xIn
      refine ⟨ringInverse(R, a), valueIn, (unitInverseMap.graph_relates at R, a with xIn, valueIn)⟩

theorem unitInverseMap.graph_apply (R a : Set)
  requires values : ∀ a ∈ ringUnits(R), ringInverse(R, a) ∈ ringUnits(R)
  requires index : a ∈ ringUnits(R)
  shows unitInverseMap(R)(a) = ringInverse(R, a)
proof
  have function := unitInverseMap.graph_function at R with values
  have valueIn := values with a, index
  have mapped := unitInverseMap.graph_relates at R, a with index, valueIn
  exact FunctionBetween.apply_value with function, index, mapped


theorem determinantHom.graph_relates (R n A : Set)
  requires index : A ∈ invertibleMatrices(R, n)
  requires valueIn : matDet(R, n, A) ∈ ringUnits(R)
  shows relates(determinantHom(R, n), A, matDet(R, n, A))
proof
  unfold relates
  apply determinantHom.membership.backward
  refine ⟨(product.pair at A, matDet(R, n, A), invertibleMatrices(R, n), ringUnits(R) with index, valueIn), A, index, rfl⟩

theorem determinantHom.graph_function (R n : Set)
  requires values : ∀ A ∈ invertibleMatrices(R, n), matDet(R, n, A) ∈ ringUnits(R)
  shows determinantHom(R, n) : invertibleMatrices(R, n) → ringUnits(R)
proof
  constructor
    intros q0 member
    obtain ⟨bounded, witnesses⟩ := determinantHom.membership.forward with member
    exact bounded
  . constructor
      intros z0 first xFirst second xSecond
      unfold relates at xFirst
      obtain ⟨_, a1, a1In, firstShape⟩ := determinantHom.membership.forward with xFirst
      unfold relates at xSecond
      obtain ⟨_, a2, a2In, secondShape⟩ := determinantHom.membership.forward with xSecond
      obtain ⟨xi, firstEqual⟩ := orderedPair.injective with firstShape
      obtain ⟨xj, secondEqual⟩ := orderedPair.injective with secondShape
      rw [firstEqual, secondEqual]
      cc
    . intros A xIn
      have valueIn := values with A, xIn
      refine ⟨matDet(R, n, A), valueIn, (determinantHom.graph_relates at R, n, A with xIn, valueIn)⟩

theorem determinantHom.graph_apply (R n A : Set)
  requires values : ∀ A ∈ invertibleMatrices(R, n), matDet(R, n, A) ∈ ringUnits(R)
  requires index : A ∈ invertibleMatrices(R, n)
  shows determinantHom(R, n)(A) = matDet(R, n, A)
proof
  have function := determinantHom.graph_function at R, n with values
  have valueIn := values with A, index
  have mapped := determinantHom.graph_relates at R, n, A with index, valueIn
  exact FunctionBetween.apply_value with function, index, mapped


theorem scalarEmbedding.graph_relates (R n a : Set)
  requires index : a ∈ ringUnits(R)
  requires valueIn : matScalar(R, n, a) ∈ invertibleMatrices(R, n)
  shows relates(scalarEmbedding(R, n), a, matScalar(R, n, a))
proof
  unfold relates
  apply scalarEmbedding.membership.backward
  refine ⟨(product.pair at a, matScalar(R, n, a), ringUnits(R), invertibleMatrices(R, n) with index, valueIn), a, index, rfl⟩

theorem scalarEmbedding.graph_function (R n : Set)
  requires values : ∀ a ∈ ringUnits(R), matScalar(R, n, a) ∈ invertibleMatrices(R, n)
  shows scalarEmbedding(R, n) : ringUnits(R) → invertibleMatrices(R, n)
proof
  constructor
    intros q0 member
    obtain ⟨bounded, witnesses⟩ := scalarEmbedding.membership.forward with member
    exact bounded
  . constructor
      intros z0 first xFirst second xSecond
      unfold relates at xFirst
      obtain ⟨_, a1, a1In, firstShape⟩ := scalarEmbedding.membership.forward with xFirst
      unfold relates at xSecond
      obtain ⟨_, a2, a2In, secondShape⟩ := scalarEmbedding.membership.forward with xSecond
      obtain ⟨xi, firstEqual⟩ := orderedPair.injective with firstShape
      obtain ⟨xj, secondEqual⟩ := orderedPair.injective with secondShape
      rw [firstEqual, secondEqual]
      cc
    . intros a xIn
      have valueIn := values with a, xIn
      refine ⟨matScalar(R, n, a), valueIn, (scalarEmbedding.graph_relates at R, n, a with xIn, valueIn)⟩

theorem scalarEmbedding.graph_apply (R n a : Set)
  requires values : ∀ a ∈ ringUnits(R), matScalar(R, n, a) ∈ invertibleMatrices(R, n)
  requires index : a ∈ ringUnits(R)
  shows scalarEmbedding(R, n)(a) = matScalar(R, n, a)
proof
  have function := scalarEmbedding.graph_function at R, n with values
  have valueIn := values with a, index
  have mapped := scalarEmbedding.graph_relates at R, n, a with index, valueIn
  exact FunctionBetween.apply_value with function, index, mapped


theorem generalLinearMap.graph_relates (S n f R A : Set)
  requires index : A ∈ invertibleMatrices(R, n)
  requires valueIn : matMap(S, n, n, f, A) ∈ invertibleMatrices(S, n)
  shows relates(generalLinearMap(S, n, f, R), A, matMap(S, n, n, f, A))
proof
  unfold relates
  apply generalLinearMap.membership.backward
  refine ⟨(product.pair at A, matMap(S, n, n, f, A), invertibleMatrices(R, n), invertibleMatrices(S, n) with index, valueIn), A, index, rfl⟩

theorem generalLinearMap.graph_function (S n f R : Set)
  requires values : ∀ A ∈ invertibleMatrices(R, n), matMap(S, n, n, f, A) ∈ invertibleMatrices(S, n)
  shows generalLinearMap(S, n, f, R) : invertibleMatrices(R, n) → invertibleMatrices(S, n)
proof
  constructor
    intros q0 member
    obtain ⟨bounded, witnesses⟩ := generalLinearMap.membership.forward with member
    exact bounded
  . constructor
      intros z0 first xFirst second xSecond
      unfold relates at xFirst
      obtain ⟨_, a1, a1In, firstShape⟩ := generalLinearMap.membership.forward with xFirst
      unfold relates at xSecond
      obtain ⟨_, a2, a2In, secondShape⟩ := generalLinearMap.membership.forward with xSecond
      obtain ⟨xi, firstEqual⟩ := orderedPair.injective with firstShape
      obtain ⟨xj, secondEqual⟩ := orderedPair.injective with secondShape
      rw [firstEqual, secondEqual]
      cc
    . intros A xIn
      have valueIn := values with A, xIn
      refine ⟨matMap(S, n, n, f, A), valueIn, (generalLinearMap.graph_relates at S, n, f, R, A with xIn, valueIn)⟩

theorem generalLinearMap.graph_apply (S n f R A : Set)
  requires values : ∀ A ∈ invertibleMatrices(R, n), matMap(S, n, n, f, A) ∈ invertibleMatrices(S, n)
  requires index : A ∈ invertibleMatrices(R, n)
  shows generalLinearMap(S, n, f, R)(A) = matMap(S, n, n, f, A)
proof
  have function := generalLinearMap.graph_function at S, n, f, R with values
  have valueIn := values with A, index
  have mapped := generalLinearMap.graph_relates at S, n, f, R, A with index, valueIn
  exact FunctionBetween.apply_value with function, index, mapped

-- Section: Restricted operations
-- An operation m : A × A → B restricted to S × S, applied and as a
-- function into S when S is closed.
theorem restrict.call2 (m A B S a b : Set)
  requires function : m : A × A → B
  requires subset : S ⊆ A
  requires first : a ∈ S
  requires second : b ∈ S
  shows call2(restrict(m, S × S), a, b) = call2(m, a, b)
proof
  have square := product.monotone at S, S, A, A with subset, subset
  have pairIn := product.pair at a, b, S, S with first, second
  unfold call2
  exact restrict.domain_apply at m, A × A, B, S × S, (a, b)
    with function, square, pairIn

theorem restrict.closed_operation (m A B S : Set)
  requires function : m : A × A → B
  requires subset : S ⊆ A
  requires closed : ∀ a ∈ S, ∀ b ∈ S, call2(m, a, b) ∈ S
  shows restrict(m, S × S) : S × S → S
proof
  have square := product.monotone at S, S, A, A with subset, subset
  have restricted := restrict.domain_function at m, A × A, B, S × S
    with function, square
  have values : ∀ x ∈ S × S, restrict(m, S × S)(x) ∈ S
    intros x hx
    obtain ⟨_, a, ha, b, hb, shape⟩ := product.membership.forward with hx
    have value := restrict.call2 at m, A, B, S, a, b with function, subset, ha, hb
    unfold call2 at value
    rw [shape, value]
    have inS := closed with a, ha, b, hb
    unfold call2 at inS
    exact inS
  exact FunctionBetween.codomain_of_values with restricted, values

-- Section: Laws of GL and SL
section GeneralLinear
variable (R n : Set)
hypothesis ring : CommRing(R)
hypothesis finite : Finite(n)

-- The inverse of a unit is a unit.
theorem RingUnit.inverse (a : Set)
  requires unit : RingUnit(R, a)
  shows RingUnit(R, ringInverse(R, a))
proof
  have unit0 := unit
  obtain ⟨aIn, _⟩ := unit0
  have mem := ringInverse.mem at R, a with ring, unit
  have law := ringInverse.mul_left at R, a with ring, unit
  exact RingUnit.of_product at R, ringInverse(R, a), a with ring, mem, aIn, law

theorem RingUnit.one
  shows RingUnit(R, R.one)
proof
  have oneIn := Ring.one_mem at R with (CommRing.to_ring with ring)
  have law : R.one * R.one = R.one by ring
  exact RingUnit.of_product at R, R.one, R.one with ring, oneIn, oneIn, law

theorem ringUnits.of_unit (a : Set)
  requires unit : RingUnit(R, a)
  shows a ∈ ringUnits(R)
proof
  have unit0 := unit
  obtain ⟨aIn, _⟩ := unit0
  apply ringUnits.membership.backward
  exact ⟨aIn, unit⟩

theorem ringUnits.unit (a : Set)
  requires member : a ∈ ringUnits(R)
  shows a ∈ R.carrier ∧ RingUnit(R, a)
proof
  exact ringUnits.membership.forward with member

-- Membership in GLₙ through the determinant, and closure.
theorem invertibleMatrices.unit (A : Set)
  requires member : A ∈ invertibleMatrices(R, n)
  shows A ∈ matrixSpace(R, n, n) ∧ RingUnit(R, matDet(R, n, A))
proof
  obtain ⟨matrix, invertible⟩ := invertibleMatrices.membership.forward with member
  have equivalence := InvertibleMatrix.iff_det at R, n, A
    with ring, finite, matrix
  exact ⟨matrix, equivalence.forward with invertible⟩

theorem invertibleMatrices.of_unit (A : Set)
  requires matrix : A ∈ matrixSpace(R, n, n)
  requires unit : RingUnit(R, matDet(R, n, A))
  shows A ∈ invertibleMatrices(R, n)
proof
  have equivalence := InvertibleMatrix.iff_det at R, n, A
    with ring, finite, matrix
  apply invertibleMatrices.membership.backward
  exact ⟨matrix, equivalence.backward with unit⟩

theorem invertibleMatrices.mul_mem (A B : Set)
  requires first : A ∈ invertibleMatrices(R, n)
  requires second : B ∈ invertibleMatrices(R, n)
  shows matMul(R, n, n, n, A, B) ∈ invertibleMatrices(R, n)
proof
  obtain ⟨matrixA, unitA⟩ := invertibleMatrices.unit at R, n, A
    with ring, finite, first
  obtain ⟨matrixB, unitB⟩ := invertibleMatrices.unit at R, n, B
    with ring, finite, second
  have product := matMul.mem_of at R, n, n, n, A, B
    with ring, finite, matrixA, matrixB
  have det := matDet.mul at R, n, A, B with ring, finite, matrixA, matrixB
  have unit := RingUnit.mul at R, matDet(R, n, A), matDet(R, n, B)
    with ring, unitA, unitB
  rw ← det at unit
  exact invertibleMatrices.of_unit at R, n, matMul(R, n, n, n, A, B)
    with ring, finite, product, unit

theorem invertibleMatrices.inverse_mem (A : Set)
  requires member : A ∈ invertibleMatrices(R, n)
  shows matInverse(R, n, A) ∈ invertibleMatrices(R, n)
proof
  obtain ⟨matrix, unit⟩ := invertibleMatrices.unit at R, n, A
    with ring, finite, member
  have inverse := matInverse.mem at R, n, A with ring, finite, matrix, unit
  have det := matInverse.det at R, n, A with ring, finite, matrix, unit
  have unitInverse := RingUnit.inverse at R, n, matDet(R, n, A)
    with ring, finite, unit
  rw ← det at unitInverse
  exact invertibleMatrices.of_unit at R, n, matInverse(R, n, A)
    with ring, finite, inverse, unitInverse

theorem invertibleMatrices.one_mem
  shows matOne(R, n) ∈ invertibleMatrices(R, n)
proof
  have one := matOne.mem_of at R, n with ring
  have det := matDet.one at R, n with ring, finite
  have unit := RingUnit.one at R, n with ring, finite
  rw ← det at unit
  exact invertibleMatrices.of_unit at R, n, matOne(R, n)
    with ring, finite, one, unit

theorem invertibleMatrices.subset
  shows invertibleMatrices(R, n) ⊆ matrixSpace(R, n, n)
proof
  intros X hX
  obtain ⟨matrix, _⟩ := invertibleMatrices.membership.forward with hX
  exact matrix

theorem matMultiplication.function_of
  shows matMultiplication(R, n) :
    matrixSpace(R, n, n) × matrixSpace(R, n, n) → matrixSpace(R, n, n)
proof
  have values : ∀ X ∈ matrixSpace(R, n, n), ∀ Y ∈ matrixSpace(R, n, n),
      matMul(R, n, n, n, X, Y) ∈ matrixSpace(R, n, n)
    intros X hX Y hY
    exact matMul.mem_of at R, n, n, n, X, Y with ring, finite, hX, hY
  exact matMultiplication.graph_function at R, n with values

-- The restricted multiplication of GLₙ is the matrix product.
theorem invertibleMatrices.operation (S A B : Set)
  requires inside : S ⊆ matrixSpace(R, n, n)
  requires first : A ∈ S
  requires second : B ∈ S
  shows call2(restrict(matMultiplication(R, n), S × S), A, B) =
    matMul(R, n, n, n, A, B)
proof
  have function := matMultiplication.function_of at R, n with ring, finite
  have values : ∀ X ∈ matrixSpace(R, n, n), ∀ Y ∈ matrixSpace(R, n, n),
      matMul(R, n, n, n, X, Y) ∈ matrixSpace(R, n, n)
    intros X hX Y hY
    exact matMul.mem_of at R, n, n, n, X, Y with ring, finite, hX, hY
  have matrixA := inside with A, first
  have matrixB := inside with B, second
  have restricted := restrict.call2 at matMultiplication(R, n),
    matrixSpace(R, n, n), matrixSpace(R, n, n), S, A, B
    with function, inside, first, second
  have entry := matMultiplication.graph_entry at R, n, A, B
    with values, matrixA, matrixB
  rw restricted
  unfold call2
  exact entry

-- The unit multiplication is the ring product.
theorem ringUnits.operation (a b : Set)
  requires first : a ∈ ringUnits(R)
  requires second : b ∈ ringUnits(R)
  shows call2(restrict(R.mul, ringUnits(R) × ringUnits(R)), a, b) = a * b
proof
  have parts := CommRing.parts with ring
  have monoid := IsRing.multiplicative with (IsCommRing.ring with parts)
  have magma := IsSemigroup.magma with (IsMonoid.semigroup with monoid)
  have mulF : R.mul : R.carrier × R.carrier → R.carrier
    unfold IsMagma at magma
    exact magma
  have inside : ringUnits(R) ⊆ R.carrier
    intros x hx
    obtain ⟨xIn, _⟩ := ringUnits.membership.forward with hx
    exact xIn
  exact restrict.call2 at R.mul, R.carrier, R.carrier, ringUnits(R), a, b
    with mulF, inside, first, second

-- The projections of GLₙ and of Rˣ.
theorem generalLinearGroup.carrier_eq
  shows Group.carrier(generalLinearGroup(R, n)) = invertibleMatrices(R, n)
proof
  simp [generalLinearGroup, Group.mk.carrier]

theorem unitGroup.carrier_eq
  shows Group.carrier(unitGroup(R)) = ringUnits(R)
proof
  simp [unitGroup, Group.mk.carrier]

theorem unitGroup.one_eq
  shows Group.one(unitGroup(R)) = R.one
proof
  simp [unitGroup, Group.mk.one]

theorem unitGroup.mul_eq (a b : Set)
  requires first : a ∈ ringUnits(R)
  requires second : b ∈ ringUnits(R)
  shows call2(Group.mul(unitGroup(R)), a, b) = a * b
proof
  have value := ringUnits.operation at R, n, a, b with ring, finite, first, second
  simp [unitGroup, Group.mk.mul]

-- A set of invertible matrices containing 1 and closed under products and
-- inverses is a group under the restricted operations.
theorem invertibleMatrices.closed_group (S : Set)
  requires inside : S ⊆ invertibleMatrices(R, n)
  requires oneIn : matOne(R, n) ∈ S
  requires mulIn : ∀ A ∈ S, ∀ B ∈ S, matMul(R, n, n, n, A, B) ∈ S
  requires invIn : ∀ A ∈ S, matInverse(R, n, A) ∈ S
  shows Group(Group.mk(S, restrict(matMultiplication(R, n), S × S),
    matOne(R, n), restrict(matInverseMap(R, n), S)))
proof
  have whole := invertibleMatrices.subset at R, n with ring, finite
  have matrices : S ⊆ matrixSpace(R, n, n)
    intros X hX
    exact whole with X, (inside with X, hX)
  have function := matMultiplication.function_of at R, n with ring, finite
  have closed : ∀ A ∈ S, ∀ B ∈ S, call2(matMultiplication(R, n), A, B) ∈ S
    intros A hA B hB
    have value := invertibleMatrices.operation at R, n, matrixSpace(R, n, n),
      A, B with ring, finite, (Subset.reflexive at matrixSpace(R, n, n)),
      (matrices with A, hA), (matrices with B, hB)
    have restricted := restrict.call2 at matMultiplication(R, n),
      matrixSpace(R, n, n), matrixSpace(R, n, n), matrixSpace(R, n, n), A, B
      with function, (Subset.reflexive at matrixSpace(R, n, n)),
      (matrices with A, hA), (matrices with B, hB)
    rw [← restricted, value]
    exact mulIn with A, hA, B, hB
  have invValues : ∀ A ∈ invertibleMatrices(R, n),
      matInverse(R, n, A) ∈ invertibleMatrices(R, n)
    intros A hA
    exact invertibleMatrices.inverse_mem at R, n, A with ring, finite, hA
  have invF := matInverseMap.graph_function at R, n with invValues
  have restrictedInv := restrict.domain_function at matInverseMap(R, n),
    invertibleMatrices(R, n), invertibleMatrices(R, n), S with invF, inside
  have invApply : ∀ A ∈ S, restrict(matInverseMap(R, n), S)(A) =
      matInverse(R, n, A)
    intros A hA
    have r := restrict.domain_apply at matInverseMap(R, n),
      invertibleMatrices(R, n), invertibleMatrices(R, n), S, A
      with invF, inside, hA
    have g := matInverseMap.graph_apply at R, n, A with invValues,
      (inside with A, hA)
    rw [r, g]
  have invValuesS : ∀ A ∈ S, restrict(matInverseMap(R, n), S)(A) ∈ S
    intros A hA
    rw invApply with A, hA
    exact invIn with A, hA
  have invS := FunctionBetween.codomain_of_values with restrictedInv, invValuesS
  apply Group.intro
  . exact restrict.closed_operation at matMultiplication(R, n),
      matrixSpace(R, n, n), matrixSpace(R, n, n), S
      with function, matrices, closed
  . exact oneIn
  . exact invS
  . intros A hA B hB C hC
    have AB := mulIn with A, hA, B, hB
    have BC := mulIn with B, hB, C, hC
    rw [(invertibleMatrices.operation at R, n, S, A, B
        with ring, finite, matrices, hA, hB),
      (invertibleMatrices.operation at R, n, S, B, C
        with ring, finite, matrices, hB, hC),
      (invertibleMatrices.operation at R, n, S,
        matMul(R, n, n, n, A, B), C with ring, finite, matrices, AB, hC),
      (invertibleMatrices.operation at R, n, S, A,
        matMul(R, n, n, n, B, C) with ring, finite, matrices, hA, BC)]
    exact matMul.assoc at R, n, n, n, n, A, B, C with ring, finite, finite,
      (matrices with A, hA), (matrices with B, hB), (matrices with C, hC)
  . intros A hA
    rw (invertibleMatrices.operation at R, n, S, matOne(R, n), A
      with ring, finite, matrices, oneIn, hA)
    exact matMul.one_left at R, n, n, A with ring, finite, (matrices with A, hA)
  . intros A hA
    rw (invertibleMatrices.operation at R, n, S, A, matOne(R, n)
      with ring, finite, matrices, hA, oneIn)
    exact matMul.one_right at R, n, n, A with ring, finite, (matrices with A, hA)
  . intros A hA
    obtain ⟨matrix, unit⟩ := invertibleMatrices.unit at R, n, A
      with ring, finite, (inside with A, hA)
    rw [(invApply with A, hA), (invertibleMatrices.operation at R, n, S,
      matInverse(R, n, A), A with ring, finite, matrices, (invIn with A, hA), hA)]
    exact matInverse.mul_left at R, n, A with ring, finite, matrix, unit
  . intros A hA
    obtain ⟨matrix, unit⟩ := invertibleMatrices.unit at R, n, A
      with ring, finite, (inside with A, hA)
    rw [(invApply with A, hA), (invertibleMatrices.operation at R, n, S,
      A, matInverse(R, n, A) with ring, finite, matrices, hA, (invIn with A, hA))]
    exact matInverse.mul_right at R, n, A with ring, finite, matrix, unit

-- Products of scalar matrices.
theorem matScalar.mul_scalar (a b : Set)
  requires first : a ∈ R.carrier
  requires second : b ∈ R.carrier
  shows matMul(R, n, n, n, matScalar(R, n, a), matScalar(R, n, b)) =
    matScalar(R, n, a * b)
proof
  have scalarB := matScalar.mem_of at R, n, b with ring, second
  have left := matScalar.mul at R, n, n, a, matScalar(R, n, b)
    with ring, finite, first, scalarB
  rw left
  exact matSmul.scalar at R, n, a, b with ring, first, second

-- A ring map carries GLₙ(R) into GLₙ(S).
theorem generalLinearMap.values (S f : Set)
  requires target : CommRing(S)
  requires hom : RingHom(f, R, S)
  shows ∀ A ∈ invertibleMatrices(R, n),
    matMap(S, n, n, f, A) ∈ invertibleMatrices(S, n)
proof
  intros A hA
  obtain ⟨matrix, unit⟩ := invertibleMatrices.unit at R, n, A
    with ring, finite, hA
  have mapped := matMap.mem_of_hom at R, S, n, n, f, A with ring, hom, matrix
  have det := matDet.map at R, S, n, f, A with ring, target, finite, hom, matrix
  have unitS := RingUnit.map at R, S, f, matDet(R, n, A) with ring, target, hom, unit
  rw det at unitS
  exact invertibleMatrices.of_unit at S, n, matMap(S, n, n, f, A)
    with target, finite, mapped, unitS

theorem unitGroup.group
  shows Group(unitGroup(R))
proof
  have parts := CommRing.parts with ring
  have monoid := IsRing.multiplicative with (IsCommRing.ring with parts)
  have magma := IsSemigroup.magma with (IsMonoid.semigroup with monoid)
  have mulF : R.mul : R.carrier × R.carrier → R.carrier
    unfold IsMagma at magma
    exact magma
  have inside : ringUnits(R) ⊆ R.carrier
    intros x hx
    obtain ⟨xIn, _⟩ := ringUnits.membership.forward with hx
    exact xIn
  have closed : ∀ a ∈ ringUnits(R), ∀ b ∈ ringUnits(R),
      call2(R.mul, a, b) ∈ ringUnits(R)
    intros a ha b hb
    obtain ⟨_, ua⟩ := ringUnits.unit at R, n, a with ring, finite, ha
    obtain ⟨_, ub⟩ := ringUnits.unit at R, n, b with ring, finite, hb
    have u := RingUnit.mul at R, a, b with ring, ua, ub
    exact ringUnits.of_unit at R, n, a * b with ring, finite, u
  have oneIn := ringUnits.of_unit at R, n, R.one
    with ring, finite, (RingUnit.one at R, n with ring, finite)
  have invValues : ∀ a ∈ ringUnits(R), ringInverse(R, a) ∈ ringUnits(R)
    intros a ha
    obtain ⟨_, ua⟩ := ringUnits.unit at R, n, a with ring, finite, ha
    have u := RingUnit.inverse at R, n, a with ring, finite, ua
    exact ringUnits.of_unit at R, n, ringInverse(R, a) with ring, finite, u
  have invF := unitInverseMap.graph_function at R with invValues
  unfold unitGroup
  apply Group.intro
  . exact restrict.closed_operation at R.mul, R.carrier, R.carrier,
      ringUnits(R) with mulF, inside, closed
  . exact oneIn
  . exact invF
  . intros a ha b hb c hc
    have ab := closed with a, ha, b, hb
    have bc := closed with b, hb, c, hc
    have aIn := inside with a, ha
    have bIn := inside with b, hb
    have cIn := inside with c, hc
    rw [(ringUnits.operation at R, n, a, b with ring, finite, ha, hb),
      (ringUnits.operation at R, n, b, c with ring, finite, hb, hc),
      (ringUnits.operation at R, n, a * b, c with ring, finite, ab, hc),
      (ringUnits.operation at R, n, a, b * c with ring, finite, ha, bc)]
    ring
  . intros a ha
    have aIn := inside with a, ha
    rw (ringUnits.operation at R, n, R.one, a with ring, finite, oneIn, ha)
    ring
  . intros a ha
    have aIn := inside with a, ha
    rw (ringUnits.operation at R, n, a, R.one with ring, finite, ha, oneIn)
    ring
  . intros a ha
    obtain ⟨_, ua⟩ := ringUnits.unit at R, n, a with ring, finite, ha
    have value := unitInverseMap.graph_apply at R, a with invValues, ha
    have inverseIn := invValues with a, ha
    rw [value, (ringUnits.operation at R, n, ringInverse(R, a), a
      with ring, finite, inverseIn, ha)]
    exact ringInverse.mul_left at R, a with ring, ua
  . intros a ha
    obtain ⟨_, ua⟩ := ringUnits.unit at R, n, a with ring, finite, ha
    have value := unitInverseMap.graph_apply at R, a with invValues, ha
    have inverseIn := invValues with a, ha
    rw [value, (ringUnits.operation at R, n, a, ringInverse(R, a)
      with ring, finite, ha, inverseIn)]
    exact ringInverse.mul_right at R, a with ring, ua

theorem unitGroup.abelian
  shows AbelianGroup(unitGroup(R))
proof
  have group := unitGroup.group at R, n with ring, finite
  unfold AbelianGroup
  refine ⟨group, ?_⟩
  unfold unitGroup
  group_projections
  unfold Commutative
  intros a ha b hb
  have aIn := (ringUnits.unit at R, n, a with ring, finite, ha).left
  have bIn := (ringUnits.unit at R, n, b with ring, finite, hb).left
  rw [(ringUnits.operation at R, n, a, b with ring, finite, ha, hb),
    (ringUnits.operation at R, n, b, a with ring, finite, hb, ha)]
  ring

theorem generalLinearGroup.group
  shows Group(generalLinearGroup(R, n))
proof
  have inside := invertibleMatrices.subset at R, n with ring, finite
  have function := matMultiplication.function_of at R, n with ring, finite
  have closed : ∀ A ∈ invertibleMatrices(R, n), ∀ B ∈ invertibleMatrices(R, n),
      call2(matMultiplication(R, n), A, B) ∈ invertibleMatrices(R, n)
    intros A hA B hB
    have value := invertibleMatrices.operation at R, n, matrixSpace(R, n, n),
      A, B with ring, finite, (Subset.reflexive at matrixSpace(R, n, n)),
      (inside with A, hA), (inside with B, hB)
    have restricted := restrict.call2 at matMultiplication(R, n),
      matrixSpace(R, n, n), matrixSpace(R, n, n), matrixSpace(R, n, n), A, B
      with function, (Subset.reflexive at matrixSpace(R, n, n)),
      (inside with A, hA), (inside with B, hB)
    rw [← restricted, value]
    exact invertibleMatrices.mul_mem at R, n, A, B with ring, finite, hA, hB
  have oneIn := invertibleMatrices.one_mem at R, n with ring, finite
  have invValues : ∀ A ∈ invertibleMatrices(R, n),
      matInverse(R, n, A) ∈ invertibleMatrices(R, n)
    intros A hA
    exact invertibleMatrices.inverse_mem at R, n, A with ring, finite, hA
  have invF := matInverseMap.graph_function at R, n with invValues
  unfold generalLinearGroup
  apply Group.intro
  . exact restrict.closed_operation at matMultiplication(R, n),
      matrixSpace(R, n, n), matrixSpace(R, n, n), invertibleMatrices(R, n)
      with function, inside, closed
  . exact oneIn
  . exact invF
  . intros A hA B hB C hC
    have AB := invertibleMatrices.mul_mem at R, n, A, B with ring, finite, hA, hB
    have BC := invertibleMatrices.mul_mem at R, n, B, C with ring, finite, hB, hC
    rw [(invertibleMatrices.operation at R, n, invertibleMatrices(R, n), A, B
        with ring, finite, inside, hA, hB),
      (invertibleMatrices.operation at R, n, invertibleMatrices(R, n), B, C
        with ring, finite, inside, hB, hC),
      (invertibleMatrices.operation at R, n, invertibleMatrices(R, n),
        matMul(R, n, n, n, A, B), C with ring, finite, inside, AB, hC),
      (invertibleMatrices.operation at R, n, invertibleMatrices(R, n), A,
        matMul(R, n, n, n, B, C) with ring, finite, inside, hA, BC)]
    exact matMul.assoc at R, n, n, n, n, A, B, C with ring, finite, finite,
      (inside with A, hA), (inside with B, hB), (inside with C, hC)
  . intros A hA
    rw (invertibleMatrices.operation at R, n, invertibleMatrices(R, n),
      matOne(R, n), A with ring, finite, inside, oneIn, hA)
    exact matMul.one_left at R, n, n, A with ring, finite, (inside with A, hA)
  . intros A hA
    rw (invertibleMatrices.operation at R, n, invertibleMatrices(R, n), A,
      matOne(R, n) with ring, finite, inside, hA, oneIn)
    exact matMul.one_right at R, n, n, A with ring, finite, (inside with A, hA)
  . intros A hA
    obtain ⟨matrix, unit⟩ := invertibleMatrices.unit at R, n, A
      with ring, finite, hA
    have value := matInverseMap.graph_apply at R, n, A with invValues, hA
    rw [value, (invertibleMatrices.operation at R, n, invertibleMatrices(R, n),
      matInverse(R, n, A), A with ring, finite, inside, (invValues with A, hA), hA)]
    exact matInverse.mul_left at R, n, A with ring, finite, matrix, unit
  . intros A hA
    obtain ⟨matrix, unit⟩ := invertibleMatrices.unit at R, n, A
      with ring, finite, hA
    have value := matInverseMap.graph_apply at R, n, A with invValues, hA
    rw [value, (invertibleMatrices.operation at R, n, invertibleMatrices(R, n),
      A, matInverse(R, n, A) with ring, finite, inside, hA, (invValues with A, hA))]
    exact matInverse.mul_right at R, n, A with ring, finite, matrix, unit

theorem invertibleMatrices.mem_iff (A : Set)
  shows A ∈ invertibleMatrices(R, n) ↔
    A ∈ matrixSpace(R, n, n) ∧ RingUnit(R, matDet(R, n, A))
proof
  constructor
  . intro member
    unfold invertibleMatrices at member
    obtain ⟨matrix, invertible⟩ := member
    have equivalence := InvertibleMatrix.iff_det at R, n, A
      with ring, finite, matrix
    exact ⟨matrix, equivalence.forward with invertible⟩
  . intro both
    obtain ⟨matrix, unit⟩ := both
    have equivalence := InvertibleMatrix.iff_det at R, n, A
      with ring, finite, matrix
    unfold invertibleMatrices
    exact ⟨matrix, equivalence.backward with unit⟩

theorem generalLinearGroup.mul (A B : Set)
  requires first : A ∈ invertibleMatrices(R, n)
  requires second : B ∈ invertibleMatrices(R, n)
  shows call2(Group.mul(generalLinearGroup(R, n)), A, B) = matMul(R, n, n, n, A, B)
proof
  have inside : invertibleMatrices(R, n) ⊆ matrixSpace(R, n, n)
    intros X hX
    unfold invertibleMatrices at hX
    obtain ⟨matrix, _⟩ := hX
    exact matrix
  have matrixA := inside with A, first
  have matrixB := inside with B, second
  have values : ∀ X ∈ matrixSpace(R, n, n), ∀ Y ∈ matrixSpace(R, n, n),
      matMul(R, n, n, n, X, Y) ∈ matrixSpace(R, n, n)
    intros X hX Y hY
    exact matMul.mem_of at R, n, n, n, X, Y with ring, finite, hX, hY
  have function := matMultiplication.graph_function at R, n with values
  have subset := product.monotone at invertibleMatrices(R, n),
    invertibleMatrices(R, n), matrixSpace(R, n, n), matrixSpace(R, n, n)
    with inside, inside
  have pairIn := product.pair at A, B, invertibleMatrices(R, n),
    invertibleMatrices(R, n) with first, second
  have restricted := restrict.domain_apply at matMultiplication(R, n),
    matrixSpace(R, n, n) × matrixSpace(R, n, n), matrixSpace(R, n, n),
    invertibleMatrices(R, n) × invertibleMatrices(R, n), (A, B)
    with function, subset, pairIn
  have entry := matMultiplication.graph_entry at R, n, A, B
    with values, matrixA, matrixB
  simp [generalLinearGroup, Group.mk.mul]
  unfold call2
  rw [restricted, entry]

-- Matrix.coe_units_inv: the group inverse is the matrix inverse.
theorem generalLinearGroup.inverse (A : Set)
  requires member : A ∈ invertibleMatrices(R, n)
  shows apply(Group.inv(generalLinearGroup(R, n)), A) = matInverse(R, n, A)
proof
  have invValues : ∀ X ∈ invertibleMatrices(R, n),
      matInverse(R, n, X) ∈ invertibleMatrices(R, n)
    intros X hX
    exact invertibleMatrices.inverse_mem at R, n, X with ring, finite, hX
  simp [generalLinearGroup, Group.mk.inv]
  exact matInverseMap.graph_apply at R, n, A with invValues, member

theorem generalLinearGroup.one
  shows Group.one(generalLinearGroup(R, n)) = matOne(R, n)
proof
  simp [generalLinearGroup, Group.mk.one]

-- Matrix.detMonoidHom, with kernel SLₙ(R).
theorem determinantHom.hom
  shows GroupHom(determinantHom(R, n), generalLinearGroup(R, n), unitGroup(R))
proof
  have source := generalLinearGroup.group at R, n with ring, finite
  have target := unitGroup.group at R, n with ring, finite
  have values : ∀ A ∈ invertibleMatrices(R, n), matDet(R, n, A) ∈ ringUnits(R)
    intros A hA
    have unit := (invertibleMatrices.unit at R, n, A with ring, finite, hA).right
    exact ringUnits.of_unit at R, n, matDet(R, n, A) with ring, finite, unit
  have graph := determinantHom.graph_function at R, n with values
  apply GroupHom.mk with source, target
  . rw [(generalLinearGroup.carrier_eq at R, n with ring, finite),
      (unitGroup.carrier_eq at R, n with ring, finite)]
    exact graph
  . intros A hA B hB
    rw (generalLinearGroup.carrier_eq at R, n with ring, finite) at hA
    rw (generalLinearGroup.carrier_eq at R, n with ring, finite) at hB
    obtain ⟨matrixA, _⟩ := invertibleMatrices.unit at R, n, A with ring, finite, hA
    obtain ⟨matrixB, _⟩ := invertibleMatrices.unit at R, n, B with ring, finite, hB
    have AB := invertibleMatrices.mul_mem at R, n, A, B with ring, finite, hA, hB
    rw [(generalLinearGroup.mul at R, n, A, B with ring, finite, hA, hB),
      (determinantHom.graph_apply at R, n, matMul(R, n, n, n, A, B)
        with values, AB),
      (determinantHom.graph_apply at R, n, A with values, hA),
      (determinantHom.graph_apply at R, n, B with values, hB),
      (unitGroup.mul_eq at R, n, matDet(R, n, A), matDet(R, n, B)
        with ring, finite, (values with A, hA), (values with B, hB))]
    exact matDet.mul at R, n, A, B with ring, finite, matrixA, matrixB

theorem determinantHom.kernel
  shows kernel(determinantHom(R, n), generalLinearGroup(R, n), unitGroup(R)) =
    specialLinearMatrices(R, n)
proof
  have values : ∀ A ∈ invertibleMatrices(R, n), matDet(R, n, A) ∈ ringUnits(R)
    intros A hA
    have unit := (invertibleMatrices.unit at R, n, A with ring, finite, hA).right
    exact ringUnits.of_unit at R, n, matDet(R, n, A) with ring, finite, unit
  ext A
  constructor
  . intro h
    obtain ⟨hA, value⟩ := kernel.membership.forward with h
    rw (generalLinearGroup.carrier_eq at R, n with ring, finite) at hA
    rw [(determinantHom.graph_apply at R, n, A with values, hA),
      (unitGroup.one_eq at R, n with ring, finite)] at value
    apply specialLinearMatrices.membership.backward
    exact ⟨hA, value⟩
  . intro h
    obtain ⟨hA, value⟩ := specialLinearMatrices.membership.forward with h
    apply kernel.membership.backward
    rw [(generalLinearGroup.carrier_eq at R, n with ring, finite),
      (determinantHom.graph_apply at R, n, A with values, hA),
      (unitGroup.one_eq at R, n with ring, finite)]
    exact ⟨hA, value⟩

theorem specialLinearMatrices.normal
  shows NormalSubgroup(specialLinearMatrices(R, n), generalLinearGroup(R, n))
proof
  have hom := determinantHom.hom at R, n with ring, finite
  have normal := GroupHom.kernel_normal at determinantHom(R, n),
    generalLinearGroup(R, n), unitGroup(R) with hom
  have kernelEq := determinantHom.kernel at R, n with ring, finite
  rw kernelEq at normal
  exact normal

theorem specialLinearGroup.group
  shows Group(specialLinearGroup(R, n))
proof
  have inside : specialLinearMatrices(R, n) ⊆ invertibleMatrices(R, n)
    intros X hX
    obtain ⟨member, _⟩ := specialLinearMatrices.membership.forward with hX
    exact member
  have oneIn : matOne(R, n) ∈ specialLinearMatrices(R, n)
    apply specialLinearMatrices.membership.backward
    exact ⟨(invertibleMatrices.one_mem at R, n with ring, finite),
      (matDet.one at R, n with ring, finite)⟩
  have mulIn : ∀ A ∈ specialLinearMatrices(R, n), ∀ B ∈ specialLinearMatrices(R, n),
      matMul(R, n, n, n, A, B) ∈ specialLinearMatrices(R, n)
    intros A hA B hB
    obtain ⟨memA, detA⟩ := specialLinearMatrices.membership.forward with hA
    obtain ⟨memB, detB⟩ := specialLinearMatrices.membership.forward with hB
    obtain ⟨matrixA, _⟩ := invertibleMatrices.unit at R, n, A with ring, finite, memA
    obtain ⟨matrixB, _⟩ := invertibleMatrices.unit at R, n, B with ring, finite, memB
    have det := matDet.mul at R, n, A, B with ring, finite, matrixA, matrixB
    have oneR := Ring.one_mem at R with (CommRing.to_ring with ring)
    apply specialLinearMatrices.membership.backward
    refine ⟨(invertibleMatrices.mul_mem at R, n, A, B with ring, finite, memA, memB), ?_⟩
    rw [det, detA, detB]
    ring
  have invIn : ∀ A ∈ specialLinearMatrices(R, n),
      matInverse(R, n, A) ∈ specialLinearMatrices(R, n)
    intros A hA
    obtain ⟨memA, detA⟩ := specialLinearMatrices.membership.forward with hA
    obtain ⟨matrixA, unitA⟩ := invertibleMatrices.unit at R, n, A
      with ring, finite, memA
    have det := matInverse.det at R, n, A with ring, finite, matrixA, unitA
    have law := ringInverse.mul_left at R, matDet(R, n, A) with ring, unitA
    have mem := ringInverse.mem at R, matDet(R, n, A) with ring, unitA
    rw detA at law
    rw detA at mem
    rw detA at det
    apply specialLinearMatrices.membership.backward
    refine ⟨(invertibleMatrices.inverse_mem at R, n, A with ring, finite, memA), ?_⟩
    have e : ringInverse(R, R.one) = ringInverse(R, R.one) * R.one by ring
    rw [det, e, law]
  unfold specialLinearGroup
  exact invertibleMatrices.closed_group at R, n, specialLinearMatrices(R, n)
    with ring, finite, inside, oneIn, mulIn, invIn

-- GeneralLinearGroup.map: a ring map gives a group map GLₙ(R) → GLₙ(S),
-- functorially.
theorem generalLinearMap.hom (S f : Set)
  requires target : CommRing(S)
  requires hom : RingHom(f, R, S)
  shows GroupHom(generalLinearMap(S, n, f, R), generalLinearGroup(R, n),
    generalLinearGroup(S, n))
proof
  have source := generalLinearGroup.group at R, n with ring, finite
  have targetGroup := generalLinearGroup.group at S, n with target, finite
  have values := generalLinearMap.values at R, n, S, f with ring, finite, target, hom
  have graph := generalLinearMap.graph_function at S, n, f, R with values
  apply GroupHom.mk with source, targetGroup
  . rw [(generalLinearGroup.carrier_eq at R, n with ring, finite),
      (generalLinearGroup.carrier_eq at S, n with target, finite)]
    exact graph
  . intros A hA B hB
    rw (generalLinearGroup.carrier_eq at R, n with ring, finite) at hA
    rw (generalLinearGroup.carrier_eq at R, n with ring, finite) at hB
    obtain ⟨matrixA, _⟩ := invertibleMatrices.unit at R, n, A with ring, finite, hA
    obtain ⟨matrixB, _⟩ := invertibleMatrices.unit at R, n, B with ring, finite, hB
    have AB := invertibleMatrices.mul_mem at R, n, A, B with ring, finite, hA, hB
    rw [(generalLinearGroup.mul at R, n, A, B with ring, finite, hA, hB),
      (generalLinearMap.graph_apply at S, n, f, R, matMul(R, n, n, n, A, B)
        with values, AB),
      (generalLinearMap.graph_apply at S, n, f, R, A with values, hA),
      (generalLinearMap.graph_apply at S, n, f, R, B with values, hB),
      (generalLinearGroup.mul at S, n, matMap(S, n, n, f, A),
        matMap(S, n, n, f, B) with target, finite, (values with A, hA),
        (values with B, hB))]
    exact matMap.mul at R, S, n, n, n, f, A, B
      with ring, target, finite, hom, matrixA, matrixB

theorem generalLinearMap.compose (S T f g : Set)
  requires middle : CommRing(S)
  requires target : CommRing(T)
  requires first : RingHom(f, R, S)
  requires second : RingHom(g, S, T)
  shows compose(generalLinearMap(T, n, g, S), generalLinearMap(S, n, f, R),
      invertibleMatrices(R, n), invertibleMatrices(S, n), invertibleMatrices(T, n)) =
    generalLinearMap(T, n, compose(g, f, R.carrier, S.carrier, T.carrier), R)
proof
  have valuesF := generalLinearMap.values at R, n, S, f with ring, finite, middle, first
  have valuesG := generalLinearMap.values at S, n, T, g with middle, finite, target, second
  have hom := RingHom.comp at f, g, R, S, T with ring, first, second
  have valuesH := generalLinearMap.values at R, n, T,
    compose(g, f, R.carrier, S.carrier, T.carrier) with ring, finite, target, hom
  have fF := generalLinearMap.graph_function at S, n, f, R with valuesF
  have gF := generalLinearMap.graph_function at T, n, g, S with valuesG
  have hF := generalLinearMap.graph_function at T, n,
    compose(g, f, R.carrier, S.carrier, T.carrier), R with valuesH
  have composed := compose.function at generalLinearMap(T, n, g, S),
    generalLinearMap(S, n, f, R), invertibleMatrices(R, n),
    invertibleMatrices(S, n), invertibleMatrices(T, n) with fF, gF
  have first0 := first
  obtain ⟨_, _, fFun, _⟩ := first0
  have second0 := second
  obtain ⟨_, _, gFun, _⟩ := second0
  apply FunctionBetween.ext with composed, hF
  intros A hA
  obtain ⟨matrix, _⟩ := invertibleMatrices.unit at R, n, A with ring, finite, hA
  have mappedF := matMap.mem_of_hom at R, S, n, n, f, A with ring, first, matrix
  have mappedG := matMap.mem_of_hom at S, T, n, n, g, matMap(S, n, n, f, A)
    with middle, second, mappedF
  have mappedH := matMap.mem_of_hom at R, T, n, n,
    compose(g, f, R.carrier, S.carrier, T.carrier), A with ring, hom, matrix
  rw [(compose.apply at generalLinearMap(T, n, g, S),
      generalLinearMap(S, n, f, R), invertibleMatrices(R, n),
      invertibleMatrices(S, n), invertibleMatrices(T, n), A with fF, gF, hA),
    (generalLinearMap.graph_apply at S, n, f, R, A with valuesF, hA),
    (generalLinearMap.graph_apply at T, n, g, S, matMap(S, n, n, f, A)
      with valuesG, (valuesF with A, hA)),
    (generalLinearMap.graph_apply at T, n,
      compose(g, f, R.carrier, S.carrier, T.carrier), R, A with valuesH, hA)]
  apply (matrixSpace.ext at T, n, n,
    matMap(T, n, n, g, matMap(S, n, n, f, A)),
    matMap(T, n, n, compose(g, f, R.carrier, S.carrier, T.carrier), A)
    with target, mappedG, mappedH).backward
  intros i hi j hj
  have entry := matrixSpace.entry_mem with matrix, hi, hj
  rw [(matMap.entry at S, T, n, n, g, matMap(S, n, n, f, A), i, j
      with middle, second, mappedF, hi, hj),
    (matMap.entry at R, S, n, n, f, A, i, j with ring, first, matrix, hi, hj),
    (matMap.entry at R, T, n, n, compose(g, f, R.carrier, S.carrier, T.carrier),
      A, i, j with ring, hom, matrix, hi, hj),
    (compose.apply at g, f, R.carrier, S.carrier, T.carrier, A((i, j))
      with fFun, gFun, entry)]

theorem generalLinearMap.injective (S f : Set)
  requires target : CommRing(S)
  requires hom : RingHom(f, R, S)
  requires injective : InjectiveBetween(f, R.carrier, S.carrier)
  shows InjectiveBetween(generalLinearMap(S, n, f, R), invertibleMatrices(R, n),
    invertibleMatrices(S, n))
proof
  have values := generalLinearMap.values at R, n, S, f with ring, finite, target, hom
  have graph := generalLinearMap.graph_function at S, n, f, R with values
  apply Injective.of_pointwise with graph
  intros A hA B hB same
  obtain ⟨matrixA, _⟩ := invertibleMatrices.unit at R, n, A with ring, finite, hA
  obtain ⟨matrixB, _⟩ := invertibleMatrices.unit at R, n, B with ring, finite, hB
  rw [(generalLinearMap.graph_apply at S, n, f, R, A with values, hA),
    (generalLinearMap.graph_apply at S, n, f, R, B with values, hB)] at same
  exact matMap.injective at R, S, n, n, f, A, B
    with ring, hom, injective, matrixA, matrixB, same

theorem generalLinearMap.det (S f A : Set)
  requires target : CommRing(S)
  requires hom : RingHom(f, R, S)
  requires member : A ∈ invertibleMatrices(R, n)
  shows matDet(S, n, generalLinearMap(S, n, f, R)(A)) = f(matDet(R, n, A))
proof
  have values := generalLinearMap.values at R, n, S, f with ring, finite, target, hom
  obtain ⟨matrix, _⟩ := invertibleMatrices.unit at R, n, A with ring, finite, member
  rw (generalLinearMap.graph_apply at S, n, f, R, A with values, member)
  have mapped := matDet.map at R, S, n, f, A with ring, target, finite, hom, matrix
  rw mapped

-- GeneralLinearGroup.scalar: Rˣ → GLₙ(R), with central image.
theorem scalarEmbedding.hom
  shows GroupHom(scalarEmbedding(R, n), unitGroup(R), generalLinearGroup(R, n))
proof
  have source := unitGroup.group at R, n with ring, finite
  have target := generalLinearGroup.group at R, n with ring, finite
  have values : ∀ a ∈ ringUnits(R), matScalar(R, n, a) ∈ invertibleMatrices(R, n)
    intros a ha
    obtain ⟨aIn, unit⟩ := ringUnits.unit at R, n, a with ring, finite, ha
    have bIn := ringInverse.mem at R, a with ring, unit
    have right := ringInverse.mul_right at R, a with ring, unit
    have left := ringInverse.mul_left at R, a with ring, unit
    have scalarA := matScalar.mem_of at R, n, a with ring, aIn
    have scalarB := matScalar.mem_of at R, n, ringInverse(R, a) with ring, bIn
    have p1 := matScalar.mul_scalar at R, n, a, ringInverse(R, a)
      with ring, finite, aIn, bIn
    have p2 := matScalar.mul_scalar at R, n, ringInverse(R, a), a
      with ring, finite, bIn, aIn
    rw [right, (matScalar.one at R, n with ring)] at p1
    rw [left, (matScalar.one at R, n with ring)] at p2
    apply invertibleMatrices.membership.backward
    refine ⟨scalarA, ?_⟩
    unfold InvertibleMatrix
    exact ⟨scalarA, matScalar(R, n, ringInverse(R, a)), scalarB, p1, p2⟩
  have graph := scalarEmbedding.graph_function at R, n with values
  apply GroupHom.mk with source, target
  . rw [(generalLinearGroup.carrier_eq at R, n with ring, finite),
      (unitGroup.carrier_eq at R, n with ring, finite)]
    exact graph
  . intros a ha b hb
    rw (unitGroup.carrier_eq at R, n with ring, finite) at ha
    rw (unitGroup.carrier_eq at R, n with ring, finite) at hb
    have aIn := (ringUnits.unit at R, n, a with ring, finite, ha).left
    have bIn := (ringUnits.unit at R, n, b with ring, finite, hb).left
    have ab : call2(R.mul, a, b) ∈ ringUnits(R)
      have u := RingUnit.mul at R, a, b with ring,
        (ringUnits.unit at R, n, a with ring, finite, ha).right,
        (ringUnits.unit at R, n, b with ring, finite, hb).right
      exact ringUnits.of_unit at R, n, call2(R.mul, a, b) with ring, finite, u
    rw [(unitGroup.mul_eq at R, n, a, b with ring, finite, ha, hb),
      (scalarEmbedding.graph_apply at R, n, call2(R.mul, a, b) with values, ab),
      (scalarEmbedding.graph_apply at R, n, a with values, ha),
      (scalarEmbedding.graph_apply at R, n, b with values, hb),
      (generalLinearGroup.mul at R, n, matScalar(R, n, a), matScalar(R, n, b)
        with ring, finite, (values with a, ha), (values with b, hb))]
    have product := matScalar.mul_scalar at R, n, a, b with ring, finite, aIn, bIn
    rw product

theorem scalarEmbedding.central (a A : Set)
  requires unit : a ∈ ringUnits(R)
  requires member : A ∈ invertibleMatrices(R, n)
  shows matMul(R, n, n, n, matScalar(R, n, a), A) =
    matMul(R, n, n, n, A, matScalar(R, n, a))
proof
  have aIn : a ∈ R.carrier
    unfold ringUnits at unit
    obtain ⟨inside, _⟩ := unit
    exact inside
  have matrix : A ∈ matrixSpace(R, n, n)
    unfold invertibleMatrices at member
    obtain ⟨inside, _⟩ := member
    exact inside
  have oneIn := matOne.mem_of at R, n with ring
  have leftScalar := matScalar.mul at R, n, n, a, A with ring, finite, aIn, matrix
  have scalarOne := matScalar.mul at R, n, n, a, matOne(R, n)
    with ring, finite, aIn, oneIn
  have oneRight := matMul.one_right at R, n, n, matScalar(R, n, a)
    with ring, finite, (matScalar.mem_of at R, n, a with ring, aIn)
  rw oneRight at scalarOne
  have moved := matMul.smul_right at R, n, n, n, a, A, matOne(R, n)
    with ring, finite, aIn, matrix, oneIn
  have oneA := matMul.one_right at R, n, n, A with ring, finite, matrix
  rw [leftScalar, scalarOne, moved, oneA]

-- GLₙ(R) acts on Rⁿ by v ↦ A v, and the invertible matrices are the
-- matrices of the linear automorphisms of Rⁿ.
theorem invertibleMatrices.equiv_iff (A : Set)
  requires matrix : A ∈ matrixSpace(R, n, n)
  shows A ∈ invertibleMatrices(R, n) ↔
    LinearEquiv(mulVecMap(R, n, n, A), coordinateModule(R, n), R,
      coordinateModule(R, n))
proof
  sorry

end GeneralLinear

-- Section: Laws of unitary groups
section Unitary
variable (R σ n J : Set)
hypothesis involution : RingInvolution(σ, R)
hypothesis finite : Finite(n)
hypothesis form : J ∈ matrixSpace(R, n, n)

-- gram_mul_of_gram_eq and gram_inv_of_gram_eq: congruence composes and
-- inverts.
theorem gramMatrix.compose (x y J2 J3 : Set)
  requires first : x ∈ invertibleMatrices(R, n)
  requires second : y ∈ invertibleMatrices(R, n)
  requires congruentX : gramMatrix(R, σ, n, n, n, J, x, x) = J2
  requires congruentY : gramMatrix(R, σ, n, n, n, J2, y, y) = J3
  shows gramMatrix(R, σ, n, n, n, J, matMul(R, n, n, n, x, y),
    matMul(R, n, n, n, x, y)) = J3
proof
  have involution0 := involution
  obtain ⟨ring, _, _⟩ := involution0
  obtain ⟨mx, _⟩ := invertibleMatrices.unit at R, n, x with ring, finite, first
  obtain ⟨my, _⟩ := invertibleMatrices.unit at R, n, y with ring, finite, second
  have cx := conjTranspose.mem_of at R, σ, n, n, x with involution, mx
  have cy := conjTranspose.mem_of at R, σ, n, n, y with involution, my
  have jx := matMul.mem_of at R, n, n, n, J, x with ring, finite, form, mx
  have jxy := matMul.mem_of at R, n, n, n, matMul(R, n, n, n, J, x), y with ring, finite, jx, my
  have star := conjTranspose.mul at R, σ, n, n, n, x, y with involution, finite, mx, my
  have a1 := matMul.assoc at R, n, n, n, n, J, x, y with ring, finite, finite, form, mx, my
  have a2 := matMul.assoc at R, n, n, n, n, conjTranspose(R, σ, n, n, y), conjTranspose(R, σ, n, n, x), matMul(R, n, n, n, matMul(R, n, n, n, J, x), y)
    with ring, finite, finite, cy, cx, jxy
  have a3 := matMul.assoc at R, n, n, n, n, conjTranspose(R, σ, n, n, x), matMul(R, n, n, n, J, x), y
    with ring, finite, finite, cx, jx, my
  unfold gramMatrix
  unfold gramMatrix at congruentX
  unfold gramMatrix at congruentY
  rw [star, ← a1, a2, ← a3, congruentX, congruentY]

theorem gramMatrix.inverse (x J2 : Set)
  requires member : x ∈ invertibleMatrices(R, n)
  requires congruent : gramMatrix(R, σ, n, n, n, J, x, x) = J2
  shows gramMatrix(R, σ, n, n, n, J2, matInverse(R, n, x),
    matInverse(R, n, x)) = J
proof
  have involution0 := involution
  obtain ⟨ring, _, _⟩ := involution0
  obtain ⟨mx, unit⟩ := invertibleMatrices.unit at R, n, x with ring, finite, member
  have ix := matInverse.mem at R, n, x with ring, finite, mx, unit
  have cx := conjTranspose.mem_of at R, σ, n, n, x with involution, mx
  have cix := conjTranspose.mem_of at R, σ, n, n, matInverse(R, n, x) with involution, ix
  have jx := matMul.mem_of at R, n, n, n, J, x with ring, finite, form, mx
  have one := matOne.mem_of at R, n with ring
  have star := conjTranspose.mul at R, σ, n, n, n, x, matInverse(R, n, x)
    with involution, finite, mx, ix
  have right := matInverse.mul_right at R, n, x with ring, finite, mx, unit
  rw [right, (conjTranspose.one at R, σ, n with involution)] at star
  unfold gramMatrix
  unfold gramMatrix at congruent
  rw ← congruent
  have a1 := matMul.assoc at R, n, n, n, n, conjTranspose(R, σ, n, n, x), matMul(R, n, n, n, J, x), matInverse(R, n, x)
    with ring, finite, finite, cx, jx, ix
  have a2 := matMul.assoc at R, n, n, n, n, J, x, matInverse(R, n, x)
    with ring, finite, finite, form, mx, ix
  have a3 := matMul.assoc at R, n, n, n, n, conjTranspose(R, σ, n, n, matInverse(R, n, x)), conjTranspose(R, σ, n, n, x),
    matMul(R, n, n, n, J, matMul(R, n, n, n, x, matInverse(R, n, x))) with ring, finite, finite, cix, cx,
    (matMul.mem_of at R, n, n, n, J, matMul(R, n, n, n, x, matInverse(R, n, x)) with ring, finite,
      form, (matMul.mem_of at R, n, n, n, x, matInverse(R, n, x) with ring, finite, mx, ix))
  rw [a1, a2, ← a3, ← star, right,
    (matMul.one_right at R, n, n, J with ring, finite, form),
    (matMul.one_left at R, n, n, J with ring, finite, form)]

-- U(J) lies in GLₙ, contains 1, and is closed under products and
-- inverses.
theorem formUnitaryMatrices.inside
  shows formUnitaryMatrices(R, σ, n, J) ⊆ invertibleMatrices(R, n)
proof
  intros g hg
  obtain ⟨member, _⟩ := formUnitaryMatrices.membership.forward with hg
  exact member

theorem formUnitaryMatrices.one_mem
  shows matOne(R, n) ∈ formUnitaryMatrices(R, σ, n, J)
proof
  have involution0 := involution
  obtain ⟨ring, _, _⟩ := involution0
  have oneIn := invertibleMatrices.one_mem at R, n with ring, finite
  apply formUnitaryMatrices.membership.backward
  refine ⟨oneIn, ?_⟩
  unfold gramMatrix
  rw [(conjTranspose.one at R, σ, n with involution),
    (matMul.one_right at R, n, n, J with ring, finite, form),
    (matMul.one_left at R, n, n, J with ring, finite, form)]

theorem formUnitaryMatrices.mul_mem (a b : Set)
  requires first : a ∈ formUnitaryMatrices(R, σ, n, J)
  requires second : b ∈ formUnitaryMatrices(R, σ, n, J)
  shows matMul(R, n, n, n, a, b) ∈ formUnitaryMatrices(R, σ, n, J)
proof
  have involution0 := involution
  obtain ⟨ring, _, _⟩ := involution0
  obtain ⟨ma, ga⟩ := formUnitaryMatrices.membership.forward with first
  obtain ⟨mb, gb⟩ := formUnitaryMatrices.membership.forward with second
  apply formUnitaryMatrices.membership.backward
  refine ⟨(invertibleMatrices.mul_mem at R, n, a, b with ring, finite, ma, mb), ?_⟩
  exact gramMatrix.compose at R, σ, n, J, a, b, J, J
    with involution, finite, form, ma, mb, ga, gb

theorem formUnitaryMatrices.inverse_mem (a : Set)
  requires member : a ∈ formUnitaryMatrices(R, σ, n, J)
  shows matInverse(R, n, a) ∈ formUnitaryMatrices(R, σ, n, J)
proof
  have involution0 := involution
  obtain ⟨ring, _, _⟩ := involution0
  obtain ⟨ma, ga⟩ := formUnitaryMatrices.membership.forward with member
  apply formUnitaryMatrices.membership.backward
  refine ⟨(invertibleMatrices.inverse_mem at R, n, a with ring, finite, ma), ?_⟩
  exact gramMatrix.inverse at R, σ, n, J, a, J
    with involution, finite, form, ma, ga

theorem formUnitaryMatrices.subgroup
  shows Subgroup(formUnitaryMatrices(R, σ, n, J), generalLinearGroup(R, n))
proof
  have involution0 := involution
  obtain ⟨ring, _, _⟩ := involution0
  have glGroup := generalLinearGroup.group at R, n with ring, finite
  have inside := formUnitaryMatrices.inside at R, σ, n, J with involution, finite, form
  unfold Subgroup
  rw [(generalLinearGroup.carrier_eq at R, n with ring, finite),
    (generalLinearGroup.one at R, n with ring, finite)]
  refine ⟨glGroup, inside,
    (formUnitaryMatrices.one_mem at R, σ, n, J with involution, finite, form), ?_, ?_⟩
  . intros a ha b hb
    rw (generalLinearGroup.mul at R, n, a, b with ring, finite, (inside with a, ha),
      (inside with b, hb))
    exact formUnitaryMatrices.mul_mem at R, σ, n, J, a, b
      with involution, finite, form, ha, hb
  . intros a ha
    rw (generalLinearGroup.inverse at R, n, a with ring, finite, (inside with a, ha))
    exact formUnitaryMatrices.inverse_mem at R, σ, n, J, a
      with involution, finite, form, ha

theorem formUnitaryGroup.group
  shows Group(formUnitaryGroup(R, σ, n, J))
proof
  have involution0 := involution
  obtain ⟨ring, _, _⟩ := involution0
  have inside := formUnitaryMatrices.inside at R, σ, n, J with involution, finite, form
  have oneIn := formUnitaryMatrices.one_mem at R, σ, n, J with involution, finite, form
  have mulIn : ∀ A ∈ formUnitaryMatrices(R, σ, n, J), ∀ B ∈ formUnitaryMatrices(R, σ, n, J),
      matMul(R, n, n, n, A, B) ∈ formUnitaryMatrices(R, σ, n, J)
    intros A hA B hB
    exact formUnitaryMatrices.mul_mem at R, σ, n, J, A, B
      with involution, finite, form, hA, hB
  have invIn : ∀ A ∈ formUnitaryMatrices(R, σ, n, J),
      matInverse(R, n, A) ∈ formUnitaryMatrices(R, σ, n, J)
    intros A hA
    exact formUnitaryMatrices.inverse_mem at R, σ, n, J, A
      with involution, finite, form, hA
  unfold formUnitaryGroup
  exact invertibleMatrices.closed_group at R, n, formUnitaryMatrices(R, σ, n, J)
    with ring, finite, inside, oneIn, mulIn, invIn

-- mem_U.
theorem formUnitaryMatrices.mem_iff (g : Set)
  shows g ∈ formUnitaryMatrices(R, σ, n, J) ↔
    g ∈ invertibleMatrices(R, n) ∧ gramMatrix(R, σ, n, n, n, J, g, g) = J
proof
  constructor
  . intro h
    exact formUnitaryMatrices.membership.forward with h
  . intro h
    exact formUnitaryMatrices.membership.backward with h

-- U.of: for invertible J, a matrix M with Mᴴ J M = J is invertible, so it
-- lies in U(J).
theorem formUnitaryMatrices.of_form (M : Set)
  requires invertible : InvertibleMatrix(R, n, J)
  requires matrix : M ∈ matrixSpace(R, n, n)
  requires preserves : gramMatrix(R, σ, n, n, n, J, M, M) = J
  shows M ∈ formUnitaryMatrices(R, σ, n, J)
proof
  sorry

-- U.form_mul_inv_eq: J g⁻¹ = gᴴ J; with J² = 1, g⁻¹ = J gᴴ J (U.coe_inv);
-- in U(1), g⁻¹ = gᴴ (U.inv_val_eq_conjTranspose).
theorem formUnitaryMatrices.form_mul_inverse (g : Set)
  requires member : g ∈ formUnitaryMatrices(R, σ, n, J)
  shows matMul(R, n, n, n, J, matInverse(R, n, g)) =
    matMul(R, n, n, n, conjTranspose(R, σ, n, n, g), J)
proof
  have involution0 := involution
  obtain ⟨ring, _, _⟩ := involution0
  obtain ⟨memG, gram⟩ := formUnitaryMatrices.membership.forward with member
  obtain ⟨mg, unit⟩ := invertibleMatrices.unit at R, n, g with ring, finite, memG
  have ig := matInverse.mem at R, n, g with ring, finite, mg, unit
  have cg := conjTranspose.mem_of at R, σ, n, n, g with involution, mg
  have jg := matMul.mem_of at R, n, n, n, J, g with ring, finite, form, mg
  unfold gramMatrix at gram
  have e : matMul(R, n, n, n, matMul(R, n, n, n, conjTranspose(R, σ, n, n, g),
      matMul(R, n, n, n, J, g)), matInverse(R, n, g)) =
      matMul(R, n, n, n, J, matInverse(R, n, g))
    rw gram
  have a1 := matMul.assoc at R, n, n, n, n, conjTranspose(R, σ, n, n, g),
    matMul(R, n, n, n, J, g), matInverse(R, n, g)
    with ring, finite, finite, cg, jg, ig
  have a2 := matMul.assoc at R, n, n, n, n, J, g, matInverse(R, n, g)
    with ring, finite, finite, form, mg, ig
  have right := matInverse.mul_right at R, n, g with ring, finite, mg, unit
  rw [a1, a2, right, (matMul.one_right at R, n, n, J with ring, finite, form)] at e
  rw ← e

theorem formUnitaryMatrices.inverse_of_involutive_form (g : Set)
  requires square : matMul(R, n, n, n, J, J) = matOne(R, n)
  requires member : g ∈ formUnitaryMatrices(R, σ, n, J)
  shows matInverse(R, n, g) = matMul(R, n, n, n, J,
    matMul(R, n, n, n, conjTranspose(R, σ, n, n, g), J))
proof
  have involution0 := involution
  obtain ⟨ring, _, _⟩ := involution0
  obtain ⟨memG, _⟩ := formUnitaryMatrices.membership.forward with member
  obtain ⟨mg, unit⟩ := invertibleMatrices.unit at R, n, g with ring, finite, memG
  have ig := matInverse.mem at R, n, g with ring, finite, mg, unit
  have f := formUnitaryMatrices.form_mul_inverse at R, σ, n, J, g
    with involution, finite, form, member
  have a := matMul.assoc at R, n, n, n, n, J, J, matInverse(R, n, g)
    with ring, finite, finite, form, form, ig
  rw [square, (matMul.one_left at R, n, n, matInverse(R, n, g) with ring, finite, ig),
    f] at a
  exact a

-- U.gram_invariant: (g A)ᴴ J (g B) = Aᴴ J B for A, B with n rows.
theorem formUnitaryMatrices.gram_invariant (g a b A B : Set)
  requires member : g ∈ formUnitaryMatrices(R, σ, n, J)
  requires first : A ∈ matrixSpace(R, n, a)
  requires second : B ∈ matrixSpace(R, n, b)
  shows gramMatrix(R, σ, n, a, b, J, matMul(R, n, n, a, g, A),
      matMul(R, n, n, b, g, B)) = gramMatrix(R, σ, n, a, b, J, A, B)
proof
  have involution0 := involution
  obtain ⟨ring, _, _⟩ := involution0
  obtain ⟨memG, gram⟩ := formUnitaryMatrices.membership.forward with member
  obtain ⟨mg, _⟩ := invertibleMatrices.unit at R, n, g with ring, finite, memG
  have cg := conjTranspose.mem_of at R, σ, n, n, g with involution, mg
  have cA := conjTranspose.mem_of at R, σ, n, a, A with involution, first
  have jg := matMul.mem_of at R, n, n, n, J, g with ring, finite, form, mg
  have gB := matMul.mem_of at R, n, n, b, g, B with ring, finite, mg, second
  have jgB := matMul.mem_of at R, n, n, b, J, matMul(R, n, n, b, g, B)
    with ring, finite, form, gB
  have star := conjTranspose.mul at R, σ, n, n, a, g, A with involution, finite, mg, first
  have a1 := matMul.assoc at R, a, n, n, b, conjTranspose(R, σ, n, a, A),
    conjTranspose(R, σ, n, n, g), matMul(R, n, n, b, J, matMul(R, n, n, b, g, B))
    with ring, finite, finite, cA, cg, jgB
  have a2 := matMul.assoc at R, n, n, n, b, J, g, B with ring, finite, finite, form, mg, second
  have a3 := matMul.assoc at R, n, n, n, b, conjTranspose(R, σ, n, n, g),
    matMul(R, n, n, n, J, g), B with ring, finite, finite, cg, jg, second
  unfold gramMatrix at gram
  unfold gramMatrix
  rw [star, a1, ← a2, ← a3, gram]

-- U.form_mulVec_mulVec: σ(g x) ⬝ J (g y) = σ(x) ⬝ J y.
theorem formUnitaryMatrices.form_vectors (g x y : Set)
  requires member : g ∈ formUnitaryMatrices(R, σ, n, J)
  requires first : x ∈ functionSpace(n, R.carrier)
  requires second : y ∈ functionSpace(n, R.carrier)
  shows vecDot(R, n, vecConj(R, σ, n, mulVec(R, n, n, g, x)),
      mulVec(R, n, n, J, mulVec(R, n, n, g, y))) =
    vecDot(R, n, vecConj(R, σ, n, x), mulVec(R, n, n, J, y))
proof
  sorry

-- U.conj: for x ∈ GLₙ(R) with xᴴ J x = J', g ↦ x g x⁻¹ is an
-- isomorphism U(J') ≅ U(J).
theorem formUnitaryConjugation.iso (x J2 : Set)
  requires member : x ∈ invertibleMatrices(R, n)
  requires congruent : gramMatrix(R, σ, n, n, n, J, x, x) = J2
  shows GroupIso(restrict(formUnitaryConjugation(R, n, x),
      formUnitaryMatrices(R, σ, n, J2)),
    formUnitaryGroup(R, σ, n, J2), formUnitaryGroup(R, σ, n, J))
proof
  sorry

-- U.map: a ring map f with f ∘ σ = τ ∘ f carrying J to J' maps U(J) to
-- U(J'); it is injective when f is.
theorem formUnitaryMatrices.map (S τ f J2 : Set)
  requires target : RingInvolution(τ, S)
  requires hom : RingHom(f, R, S)
  requires equivariant : ∀ x ∈ R.carrier, f(σ(x)) = τ(f(x))
  requires carries : matMap(S, n, n, f, J) = J2
  shows GroupHom(restrict(generalLinearMap(S, n, f, R),
      formUnitaryMatrices(R, σ, n, J)),
    formUnitaryGroup(R, σ, n, J), formUnitaryGroup(S, τ, n, J2))
proof
  sorry

-- U.mem_range_map: for f injective and J invertible, a g ∈ U(J') whose
-- entries come from R lies in the image.
theorem formUnitaryMatrices.mem_range_map (S τ f J2 g M : Set)
  requires target : RingInvolution(τ, S)
  requires hom : RingHom(f, R, S)
  requires injective : InjectiveBetween(f, R.carrier, S.carrier)
  requires equivariant : ∀ x ∈ R.carrier, f(σ(x)) = τ(f(x))
  requires invertible : InvertibleMatrix(R, n, J)
  requires carries : matMap(S, n, n, f, J) = J2
  requires member : g ∈ formUnitaryMatrices(S, τ, n, J2)
  requires matrix : M ∈ matrixSpace(R, n, n)
  requires lifts : matMap(S, n, n, f, M) = g
  shows M ∈ formUnitaryMatrices(R, σ, n, J)
proof
  sorry

-- U.det: when det J is a unit, det maps U(J) to the unitary elements.
theorem formUnitaryMatrices.det (g : Set)
  requires unit : RingUnit(R, matDet(R, n, J))
  requires member : g ∈ formUnitaryMatrices(R, σ, n, J)
  shows matDet(R, n, g) ∈ unitaryElements(R, σ)
proof
  sorry

theorem formUnitaryMatrices.det_hom
  requires unit : RingUnit(R, matDet(R, n, J))
  shows GroupHom(restrict(determinantHom(R, n), formUnitaryMatrices(R, σ, n, J)),
    formUnitaryGroup(R, σ, n, J), unitaryElementGroup(R, σ))
proof
  sorry

-- U.reindex: reindexing by a bijection e : n2 → n identifies U(J) with
-- U(J ∘ (e, e)).
theorem reindexMap.iso (n2 e : Set)
  requires bijective : BijectiveBetween(e, n2, n)
  shows GroupIso(restrict(reindexMap(R, n, n2, e), formUnitaryMatrices(R, σ, n, J)),
    formUnitaryGroup(R, σ, n, J),
    formUnitaryGroup(R, σ, n2, submatrix(R, n2, n2, J, e, e)))
proof
  sorry

end Unitary

section UnitaryMore
variable (R σ : Set)
hypothesis involution : RingInvolution(σ, R)

theorem unitaryElements.group
  shows Group(unitaryElementGroup(R, σ)) ∧
    Subgroup(unitaryElements(R, σ), unitGroup(R))
proof
  sorry

-- U(1) is Mathlib's unitaryGroup (U_one_mem_unitaryGroup).
theorem unitaryMatrices.eq_form_one (n : Set)
  requires finite : Finite(n)
  shows formUnitaryMatrices(R, σ, n, matOne(R, n)) = unitaryMatrices(R, σ, n)
proof
  sorry

theorem unitaryMatrices.inverse (n g : Set)
  requires finite : Finite(n)
  requires member : g ∈ unitaryMatrices(R, σ, n)
  shows matInverse(R, n, g) = conjTranspose(R, σ, n, n, g)
proof
  sorry

-- U.sum: the block sum U(J) × U(J') → U([J 0; 0 J']) is an injective group
-- map.
theorem blockSumMap.hom (m n J J2 : Set)
  requires finiteM : Finite(m)
  requires finiteN : Finite(n)
  requires first : J ∈ matrixSpace(R, m, m)
  requires second : J2 ∈ matrixSpace(R, n, n)
  shows GroupHom(restrict(blockSumMap(R, m, n),
      formUnitaryMatrices(R, σ, m, J) × formUnitaryMatrices(R, σ, n, J2)),
    productGroup(formUnitaryGroup(R, σ, m, J), formUnitaryGroup(R, σ, n, J2)),
    formUnitaryGroup(R, σ, m ⊎ n, fromBlocks(R, m, n, m, n, J,
      matZero(R, m, n), matZero(R, n, m), J2))) ∧
    InjectiveBetween(restrict(blockSumMap(R, m, n),
        formUnitaryMatrices(R, σ, m, J) × formUnitaryMatrices(R, σ, n, J2)),
      formUnitaryMatrices(R, σ, m, J) × formUnitaryMatrices(R, σ, n, J2),
      formUnitaryMatrices(R, σ, m ⊎ n, fromBlocks(R, m, n, m, n, J,
        matZero(R, m, n), matZero(R, n, m), J2)))
proof
  sorry

-- A sign matrix is hermitian with square 1.
theorem signMatrix.hermitian (n ε : Set)
  requires finite : Finite(n)
  requires signs : SignVector(R, n, ε)
  shows IsHermitianMatrix(R, σ, n, signMatrix(R, n, ε)) ∧
    matMul(R, n, n, n, signMatrix(R, n, ε), signMatrix(R, n, ε)) = matOne(R, n)
proof
  sorry

end UnitaryMore

-- Section: Laws of symplectic groups
section Symplectic
variable (R l : Set)
hypothesis ring : CommRing(R)
hypothesis finite : Finite(l)

-- J² = −1 and det J = 1 (Matrix.J_squared, Matrix.J_det).
theorem symplecticForm.square
  shows matMul(R, l ⊎ l, l ⊎ l, l ⊎ l, symplecticForm(R, l), symplecticForm(R, l)) =
    matNeg(R, l ⊎ l, l ⊎ l, matOne(R, l ⊎ l))
proof
  sorry

theorem symplecticForm.det
  shows matDet(R, l ⊎ l, symplecticForm(R, l)) = R.one
proof
  sorry

theorem symplecticMatrices.subgroup
  shows Subgroup(symplecticMatrices(R, l), generalLinearGroup(R, l ⊎ l))
proof
  sorry

-- Matrix.symplecticGroup.transpose_mem: Sp is closed under transpose, so
-- it is U(J) for the trivial involution.
theorem symplecticMatrices.transpose (A : Set)
  requires member : A ∈ symplecticMatrices(R, l)
  shows matTranspose(R, l ⊎ l, l ⊎ l, A) ∈ symplecticMatrices(R, l)
proof
  sorry

theorem symplecticMatrices.eq_form_unitary
  shows symplecticMatrices(R, l) =
    formUnitaryMatrices(R, identity(R.carrier), l ⊎ l, symplecticForm(R, l))
proof
  sorry

-- Symplectic matrices have determinant 1 (over a field, or any
-- commutative ring: the Pfaffian identity).
theorem symplecticMatrices.det (A : Set)
  requires member : A ∈ symplecticMatrices(R, l)
  shows matDet(R, l ⊎ l, A) = R.one
proof
  sorry

end Symplectic
