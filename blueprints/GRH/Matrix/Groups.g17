-- Matrix groups over a commutative ring: the unit group Rˣ, the general
-- linear group GLₙ(R) of invertible matrices on a finite index set, the
-- special linear group SLₙ(R), the determinant and entrywise ring maps
-- as homomorphisms, scalar matrices; for a ring with involution σ (ℂ, a
-- quadratic extension with its conjugation, a CM field and its adeles)
-- the unitary elements uσ(u) = 1 and the unitary group
-- U(J) = {g ∈ GLₙ(R) : gᴴ J g = J} of a matrix J, with its laws (the
-- inverse, invariance of the form, change of J by congruence, entrywise
-- ring maps, the determinant, block sums, reindexing); and the symplectic
-- group, U(J) for the standard alternating J and the trivial involution.
-- Part of the GRH blueprint.
-- Planned home: LinearAlgebra/Matrix/Groups.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Matrix.Groups
import GRH.Matrix.Determinant
import Grace.Cumulus.Algebra.Group.Kernel
import Grace.Cumulus.Algebra.Group.Isomorphism
import Grace.Cumulus.Algebra.Group.Product

-- Section: Units and the general linear group
-- The unit group Rˣ of a ring (Mathlib's Units R), elements being the
-- units themselves.
def unitInverseMap (R : Set) : Set :=
  { p ∈ ringUnits(R) × ringUnits(R) | ∃ a ∈ ringUnits(R),
    p = (a, ringInverse(R, a)) }

def unitGroup (R : Set) : Set :=
  Group.mk(ringUnits(R), restrict(Ring.mul(R), ringUnits(R) × ringUnits(R)),
    Ring.one(R), unitInverseMap(R))

-- GLₙ(R): the invertible n × n matrices under multiplication, with the
-- inverse det(A)⁻¹ adj(A) (Matrix.GeneralLinearGroup; its elements are the
-- matrices, so Mathlib's coercion ↑g is the identity here and
-- Matrix.coe_units_inv is matInverse).
def invertibleMatrices (R n : Set) : Set :=
  { A ∈ matrixSpace(R, n, n) | InvertibleMatrix(R, n, A) }

def matInverseMap (R n : Set) : Set :=
  { p ∈ invertibleMatrices(R, n) × invertibleMatrices(R, n) |
    ∃ A ∈ invertibleMatrices(R, n), p = (A, matInverse(R, n, A)) }

def generalLinearGroup (R n : Set) : Set :=
  Group.mk(invertibleMatrices(R, n),
    restrict(matMultiplication(R, n),
      invertibleMatrices(R, n) × invertibleMatrices(R, n)),
    matOne(R, n), matInverseMap(R, n))

-- SLₙ(R) = {A ∈ GLₙ(R) : det A = 1} (Matrix.SpecialLinearGroup), as a
-- subgroup and as a group.
def specialLinearMatrices (R n : Set) : Set :=
  { A ∈ invertibleMatrices(R, n) | matDet(R, n, A) = Ring.one(R) }

def specialLinearGroup (R n : Set) : Set :=
  Group.mk(specialLinearMatrices(R, n),
    restrict(matMultiplication(R, n),
      specialLinearMatrices(R, n) × specialLinearMatrices(R, n)),
    matOne(R, n), restrict(matInverseMap(R, n), specialLinearMatrices(R, n)))

-- det : GLₙ(R) → Rˣ (Matrix.detMonoidHom), A ↦ f(A) along a ring map
-- f : R → S (Matrix.GeneralLinearGroup.map), and a ↦ a·1 on Rˣ
-- (GeneralLinearGroup.scalar).
def determinantHom (R n : Set) : Set :=
  { p ∈ invertibleMatrices(R, n) × ringUnits(R) | ∃ A ∈ invertibleMatrices(R, n),
    p = (A, matDet(R, n, A)) }

def generalLinearMap (S n f R : Set) : Set :=
  { p ∈ invertibleMatrices(R, n) × invertibleMatrices(S, n) |
    ∃ A ∈ invertibleMatrices(R, n), p = (A, matMap(S, n, n, f, A)) }

def scalarEmbedding (R n : Set) : Set :=
  { p ∈ ringUnits(R) × invertibleMatrices(R, n) | ∃ a ∈ ringUnits(R),
    p = (a, matScalar(R, n, a)) }

-- Section: Unitary groups
-- The unitary elements of a ring with involution, u σ(u) = 1 (Mathlib's
-- unitary R on a commutative star ring).
def unitaryElements (R σ : Set) : Set :=
  { u ∈ Ring.carrier(R) | call2(Ring.mul(R), u, σ(u)) = Ring.one(R) }

def unitaryElementGroup (R σ : Set) : Set :=
  Group.mk(unitaryElements(R, σ),
    restrict(Ring.mul(R), unitaryElements(R, σ) × unitaryElements(R, σ)),
    Ring.one(R), restrict(σ, unitaryElements(R, σ)))

-- The form Pᴴ J Q of a matrix J on n × n.
def gramMatrix (R σ n m p J P Q : Set) : Set :=
  matMul(R, m, n, p, conjTranspose(R, σ, n, m, P), matMul(R, n, n, p, J, Q))

-- U(J) = {g ∈ GLₙ(R) : gᴴ J g = J}, the unitary group of the form J
-- (the source's U J in Lib/General/Groups/ValuationPair), and the group.
-- J is a hermitian or skew-hermitian form in the uses, but the definition
-- and the subgroup property need no hypothesis on J.
def formUnitaryMatrices (R σ n J : Set) : Set :=
  { g ∈ invertibleMatrices(R, n) | gramMatrix(R, σ, n, n, n, J, g, g) = J }

def formUnitaryGroup (R σ n J : Set) : Set :=
  Group.mk(formUnitaryMatrices(R, σ, n, J),
    restrict(matMultiplication(R, n),
      formUnitaryMatrices(R, σ, n, J) × formUnitaryMatrices(R, σ, n, J)),
    matOne(R, n), restrict(matInverseMap(R, n), formUnitaryMatrices(R, σ, n, J)))

-- Mathlib's unitaryGroup n R: Aᴴ A = A Aᴴ = 1, which is U(1).
def unitaryMatrices (R σ n : Set) : Set :=
  { A ∈ matrixSpace(R, n, n) |
    matMul(R, n, n, n, conjTranspose(R, σ, n, n, A), A) = matOne(R, n) ∧
    matMul(R, n, n, n, A, conjTranspose(R, σ, n, n, A)) = matOne(R, n) }

-- The diagonal sign matrix diag(ε) for ε : n → {1, −1} (the source's
-- signMatrix; U(diag ε) is U(p, q)).
predicate SignVector (R n ε : Set) :=
  (ε : n → Ring.carrier(R)) ∧
  (∀ i ∈ n, ε(i) = Ring.one(R) ∨ ε(i) = apply(Ring.neg(R), Ring.one(R)))

def signMatrix (R n ε : Set) : Set := matDiagonal(R, n, ε)

-- g ↦ x g x⁻¹, U(J') → U(J) for x with xᴴ J x = J' (the source's U.conj).
def formUnitaryConjugation (R n x : Set) : Set :=
  { p ∈ invertibleMatrices(R, n) × invertibleMatrices(R, n) |
    ∃ g ∈ invertibleMatrices(R, n), p = (g, matMul(R, n, n, n, x,
      matMul(R, n, n, n, g, matInverse(R, n, x)))) }

-- (g, h) ↦ [g 0; 0 h], U(J) × U(J') → U([J 0; 0 J']) (the source's
-- U.sum).
def blockSumMap (R m n : Set) : Set :=
  { p ∈ (invertibleMatrices(R, m) × invertibleMatrices(R, n)) ×
      invertibleMatrices(R, m ⊎ n) |
    ∃ g ∈ invertibleMatrices(R, m), ∃ h ∈ invertibleMatrices(R, n),
      p = ((g, h), fromBlocks(R, m, n, m, n, g, matZero(R, m, n),
        matZero(R, n, m), h)) }

-- g ↦ g ∘ (e, e) for a bijection e : n2 → n (the source's U.reindex).
def reindexMap (R n n2 e : Set) : Set :=
  { p ∈ invertibleMatrices(R, n) × invertibleMatrices(R, n2) |
    ∃ g ∈ invertibleMatrices(R, n), p = (g, submatrix(R, n2, n2, g, e, e)) }

-- Section: Symplectic groups
-- The standard alternating form J = [0 −1; 1 0] on l ⊎ l (Matrix.J) and
-- Sp(2l, R) = {A : A J Aᵀ = J} (Matrix.symplecticGroup).
def symplecticForm (R l : Set) : Set :=
  fromBlocks(R, l, l, l, l, matZero(R, l, l), matNeg(R, l, l, matOne(R, l)),
    matOne(R, l), matZero(R, l, l))

def symplecticMatrices (R l : Set) : Set :=
  { A ∈ matrixSpace(R, l ⊎ l, l ⊎ l) |
    matMul(R, l ⊎ l, l ⊎ l, l ⊎ l, A, matMul(R, l ⊎ l, l ⊎ l, l ⊎ l,
      symplecticForm(R, l), matTranspose(R, l ⊎ l, l ⊎ l, A))) =
    symplecticForm(R, l) }

-- Section: Laws of GL and SL
section GeneralLinear
variable (R n : Set)
hypothesis ring : CommRing(R)
hypothesis finite : Finite(n)

theorem unitGroup.group
  shows Group(unitGroup(R))
proof
  sorry

theorem unitGroup.abelian
  shows AbelianGroup(unitGroup(R))
proof
  sorry

theorem generalLinearGroup.group
  shows Group(generalLinearGroup(R, n))
proof
  sorry

theorem invertibleMatrices.mem_iff (A : Set)
  shows A ∈ invertibleMatrices(R, n) ↔
    A ∈ matrixSpace(R, n, n) ∧ RingUnit(R, matDet(R, n, A))
proof
  sorry

theorem generalLinearGroup.mul (A B : Set)
  requires first : A ∈ invertibleMatrices(R, n)
  requires second : B ∈ invertibleMatrices(R, n)
  shows call2(Group.mul(generalLinearGroup(R, n)), A, B) = matMul(R, n, n, n, A, B)
proof
  sorry

-- Matrix.coe_units_inv: the group inverse is the matrix inverse.
theorem generalLinearGroup.inverse (A : Set)
  requires member : A ∈ invertibleMatrices(R, n)
  shows apply(Group.inv(generalLinearGroup(R, n)), A) = matInverse(R, n, A)
proof
  sorry

theorem generalLinearGroup.one
  shows Group.one(generalLinearGroup(R, n)) = matOne(R, n)
proof
  sorry

-- Matrix.detMonoidHom, with kernel SLₙ(R).
theorem determinantHom.hom
  shows GroupHom(determinantHom(R, n), generalLinearGroup(R, n), unitGroup(R))
proof
  sorry

theorem determinantHom.kernel
  shows kernel(determinantHom(R, n), generalLinearGroup(R, n), unitGroup(R)) =
    specialLinearMatrices(R, n)
proof
  sorry

theorem specialLinearMatrices.normal
  shows NormalSubgroup(specialLinearMatrices(R, n), generalLinearGroup(R, n))
proof
  sorry

theorem specialLinearGroup.group
  shows Group(specialLinearGroup(R, n))
proof
  sorry

-- GeneralLinearGroup.map: a ring map gives a group map GLₙ(R) → GLₙ(S),
-- functorially.
theorem generalLinearMap.hom (S f : Set)
  requires target : CommRing(S)
  requires hom : RingHom(f, R, S)
  shows GroupHom(generalLinearMap(S, n, f, R), generalLinearGroup(R, n),
    generalLinearGroup(S, n))
proof
  sorry

theorem generalLinearMap.compose (S T f g : Set)
  requires middle : CommRing(S)
  requires target : CommRing(T)
  requires first : RingHom(f, R, S)
  requires second : RingHom(g, S, T)
  shows compose(generalLinearMap(T, n, g, S), generalLinearMap(S, n, f, R),
      invertibleMatrices(R, n), invertibleMatrices(S, n), invertibleMatrices(T, n)) =
    generalLinearMap(T, n, compose(g, f, R.carrier, S.carrier, T.carrier), R)
proof
  sorry

theorem generalLinearMap.injective (S f : Set)
  requires target : CommRing(S)
  requires hom : RingHom(f, R, S)
  requires injective : InjectiveBetween(f, R.carrier, S.carrier)
  shows InjectiveBetween(generalLinearMap(S, n, f, R), invertibleMatrices(R, n),
    invertibleMatrices(S, n))
proof
  sorry

theorem generalLinearMap.det (S f A : Set)
  requires target : CommRing(S)
  requires hom : RingHom(f, R, S)
  requires member : A ∈ invertibleMatrices(R, n)
  shows matDet(S, n, generalLinearMap(S, n, f, R)(A)) = f(matDet(R, n, A))
proof
  sorry

-- GeneralLinearGroup.scalar: Rˣ → GLₙ(R), with central image.
theorem scalarEmbedding.hom
  shows GroupHom(scalarEmbedding(R, n), unitGroup(R), generalLinearGroup(R, n))
proof
  sorry

theorem scalarEmbedding.central (a A : Set)
  requires unit : a ∈ ringUnits(R)
  requires member : A ∈ invertibleMatrices(R, n)
  shows matMul(R, n, n, n, matScalar(R, n, a), A) =
    matMul(R, n, n, n, A, matScalar(R, n, a))
proof
  sorry

-- GLₙ(R) acts on Rⁿ by v ↦ A v, and the invertible matrices are the
-- matrices of the linear automorphisms of Rⁿ.
theorem invertibleMatrices.equiv_iff (A : Set)
  requires matrix : A ∈ matrixSpace(R, n, n)
  shows A ∈ invertibleMatrices(R, n) ↔
    LinearEquiv(mulVecMap(R, n, n, A), coordinateModule(R, n), R,
      coordinateModule(R, n))
proof
  sorry

end GeneralLinear

-- Section: Laws of unitary groups
section Unitary
variable (R σ n J : Set)
hypothesis involution : RingInvolution(σ, R)
hypothesis finite : Finite(n)
hypothesis form : J ∈ matrixSpace(R, n, n)

theorem formUnitaryMatrices.subgroup
  shows Subgroup(formUnitaryMatrices(R, σ, n, J), generalLinearGroup(R, n))
proof
  sorry

theorem formUnitaryGroup.group
  shows Group(formUnitaryGroup(R, σ, n, J))
proof
  sorry

-- mem_U.
theorem formUnitaryMatrices.mem_iff (g : Set)
  shows g ∈ formUnitaryMatrices(R, σ, n, J) ↔
    g ∈ invertibleMatrices(R, n) ∧ gramMatrix(R, σ, n, n, n, J, g, g) = J
proof
  sorry

-- U.of: for invertible J, a matrix M with Mᴴ J M = J is invertible, so it
-- lies in U(J).
theorem formUnitaryMatrices.of_form (M : Set)
  requires invertible : InvertibleMatrix(R, n, J)
  requires matrix : M ∈ matrixSpace(R, n, n)
  requires preserves : gramMatrix(R, σ, n, n, n, J, M, M) = J
  shows M ∈ formUnitaryMatrices(R, σ, n, J)
proof
  sorry

-- U.form_mul_inv_eq: J g⁻¹ = gᴴ J; with J² = 1, g⁻¹ = J gᴴ J (U.coe_inv);
-- in U(1), g⁻¹ = gᴴ (U.inv_val_eq_conjTranspose).
theorem formUnitaryMatrices.form_mul_inverse (g : Set)
  requires member : g ∈ formUnitaryMatrices(R, σ, n, J)
  shows matMul(R, n, n, n, J, matInverse(R, n, g)) =
    matMul(R, n, n, n, conjTranspose(R, σ, n, n, g), J)
proof
  sorry

theorem formUnitaryMatrices.inverse_of_involutive_form (g : Set)
  requires square : matMul(R, n, n, n, J, J) = matOne(R, n)
  requires member : g ∈ formUnitaryMatrices(R, σ, n, J)
  shows matInverse(R, n, g) = matMul(R, n, n, n, J,
    matMul(R, n, n, n, conjTranspose(R, σ, n, n, g), J))
proof
  sorry

-- U.gram_invariant: (g A)ᴴ J (g B) = Aᴴ J B for A, B with n rows.
theorem formUnitaryMatrices.gram_invariant (g a b A B : Set)
  requires member : g ∈ formUnitaryMatrices(R, σ, n, J)
  requires first : A ∈ matrixSpace(R, n, a)
  requires second : B ∈ matrixSpace(R, n, b)
  shows gramMatrix(R, σ, n, a, b, J, matMul(R, n, n, a, g, A),
      matMul(R, n, n, b, g, B)) = gramMatrix(R, σ, n, a, b, J, A, B)
proof
  sorry

-- U.form_mulVec_mulVec: σ(g x) ⬝ J (g y) = σ(x) ⬝ J y.
theorem formUnitaryMatrices.form_vectors (g x y : Set)
  requires member : g ∈ formUnitaryMatrices(R, σ, n, J)
  requires first : x ∈ functionSpace(n, R.carrier)
  requires second : y ∈ functionSpace(n, R.carrier)
  shows vecDot(R, n, vecConj(R, σ, n, mulVec(R, n, n, g, x)),
      mulVec(R, n, n, J, mulVec(R, n, n, g, y))) =
    vecDot(R, n, vecConj(R, σ, n, x), mulVec(R, n, n, J, y))
proof
  sorry

-- gram_mul_of_gram_eq and gram_inv_of_gram_eq: congruence composes and
-- inverts.
theorem gramMatrix.compose (x y J2 J3 : Set)
  requires first : x ∈ invertibleMatrices(R, n)
  requires second : y ∈ invertibleMatrices(R, n)
  requires congruentX : gramMatrix(R, σ, n, n, n, J, x, x) = J2
  requires congruentY : gramMatrix(R, σ, n, n, n, J2, y, y) = J3
  shows gramMatrix(R, σ, n, n, n, J, matMul(R, n, n, n, x, y),
    matMul(R, n, n, n, x, y)) = J3
proof
  sorry

theorem gramMatrix.inverse (x J2 : Set)
  requires member : x ∈ invertibleMatrices(R, n)
  requires congruent : gramMatrix(R, σ, n, n, n, J, x, x) = J2
  shows gramMatrix(R, σ, n, n, n, J2, matInverse(R, n, x),
    matInverse(R, n, x)) = J
proof
  sorry

-- U.conj: for x ∈ GLₙ(R) with xᴴ J x = J', g ↦ x g x⁻¹ is an
-- isomorphism U(J') ≅ U(J).
theorem formUnitaryConjugation.iso (x J2 : Set)
  requires member : x ∈ invertibleMatrices(R, n)
  requires congruent : gramMatrix(R, σ, n, n, n, J, x, x) = J2
  shows GroupIso(restrict(formUnitaryConjugation(R, n, x),
      formUnitaryMatrices(R, σ, n, J2)),
    formUnitaryGroup(R, σ, n, J2), formUnitaryGroup(R, σ, n, J))
proof
  sorry

-- U.map: a ring map f with f ∘ σ = τ ∘ f carrying J to J' maps U(J) to
-- U(J'); it is injective when f is.
theorem formUnitaryMatrices.map (S τ f J2 : Set)
  requires target : RingInvolution(τ, S)
  requires hom : RingHom(f, R, S)
  requires equivariant : ∀ x ∈ R.carrier, f(σ(x)) = τ(f(x))
  requires carries : matMap(S, n, n, f, J) = J2
  shows GroupHom(restrict(generalLinearMap(S, n, f, R),
      formUnitaryMatrices(R, σ, n, J)),
    formUnitaryGroup(R, σ, n, J), formUnitaryGroup(S, τ, n, J2))
proof
  sorry

-- U.mem_range_map: for f injective and J invertible, a g ∈ U(J') whose
-- entries come from R lies in the image.
theorem formUnitaryMatrices.mem_range_map (S τ f J2 g M : Set)
  requires target : RingInvolution(τ, S)
  requires hom : RingHom(f, R, S)
  requires injective : InjectiveBetween(f, R.carrier, S.carrier)
  requires equivariant : ∀ x ∈ R.carrier, f(σ(x)) = τ(f(x))
  requires invertible : InvertibleMatrix(R, n, J)
  requires carries : matMap(S, n, n, f, J) = J2
  requires member : g ∈ formUnitaryMatrices(S, τ, n, J2)
  requires matrix : M ∈ matrixSpace(R, n, n)
  requires lifts : matMap(S, n, n, f, M) = g
  shows M ∈ formUnitaryMatrices(R, σ, n, J)
proof
  sorry

-- U.det: when det J is a unit, det maps U(J) to the unitary elements.
theorem formUnitaryMatrices.det (g : Set)
  requires unit : RingUnit(R, matDet(R, n, J))
  requires member : g ∈ formUnitaryMatrices(R, σ, n, J)
  shows matDet(R, n, g) ∈ unitaryElements(R, σ)
proof
  sorry

theorem formUnitaryMatrices.det_hom
  requires unit : RingUnit(R, matDet(R, n, J))
  shows GroupHom(restrict(determinantHom(R, n), formUnitaryMatrices(R, σ, n, J)),
    formUnitaryGroup(R, σ, n, J), unitaryElementGroup(R, σ))
proof
  sorry

-- U.reindex: reindexing by a bijection e : n2 → n identifies U(J) with
-- U(J ∘ (e, e)).
theorem reindexMap.iso (n2 e : Set)
  requires bijective : BijectiveBetween(e, n2, n)
  shows GroupIso(restrict(reindexMap(R, n, n2, e), formUnitaryMatrices(R, σ, n, J)),
    formUnitaryGroup(R, σ, n, J),
    formUnitaryGroup(R, σ, n2, submatrix(R, n2, n2, J, e, e)))
proof
  sorry

end Unitary

section UnitaryMore
variable (R σ : Set)
hypothesis involution : RingInvolution(σ, R)

theorem unitaryElements.group
  shows Group(unitaryElementGroup(R, σ)) ∧
    Subgroup(unitaryElements(R, σ), unitGroup(R))
proof
  sorry

-- U(1) is Mathlib's unitaryGroup (U_one_mem_unitaryGroup).
theorem unitaryMatrices.eq_form_one (n : Set)
  requires finite : Finite(n)
  shows formUnitaryMatrices(R, σ, n, matOne(R, n)) = unitaryMatrices(R, σ, n)
proof
  sorry

theorem unitaryMatrices.inverse (n g : Set)
  requires finite : Finite(n)
  requires member : g ∈ unitaryMatrices(R, σ, n)
  shows matInverse(R, n, g) = conjTranspose(R, σ, n, n, g)
proof
  sorry

-- U.sum: the block sum U(J) × U(J') → U([J 0; 0 J']) is an injective group
-- map.
theorem blockSumMap.hom (m n J J2 : Set)
  requires finiteM : Finite(m)
  requires finiteN : Finite(n)
  requires first : J ∈ matrixSpace(R, m, m)
  requires second : J2 ∈ matrixSpace(R, n, n)
  shows GroupHom(restrict(blockSumMap(R, m, n),
      formUnitaryMatrices(R, σ, m, J) × formUnitaryMatrices(R, σ, n, J2)),
    productGroup(formUnitaryGroup(R, σ, m, J), formUnitaryGroup(R, σ, n, J2)),
    formUnitaryGroup(R, σ, m ⊎ n, fromBlocks(R, m, n, m, n, J,
      matZero(R, m, n), matZero(R, n, m), J2))) ∧
    InjectiveBetween(restrict(blockSumMap(R, m, n),
        formUnitaryMatrices(R, σ, m, J) × formUnitaryMatrices(R, σ, n, J2)),
      formUnitaryMatrices(R, σ, m, J) × formUnitaryMatrices(R, σ, n, J2),
      formUnitaryMatrices(R, σ, m ⊎ n, fromBlocks(R, m, n, m, n, J,
        matZero(R, m, n), matZero(R, n, m), J2)))
proof
  sorry

-- A sign matrix is hermitian with square 1.
theorem signMatrix.hermitian (n ε : Set)
  requires finite : Finite(n)
  requires signs : SignVector(R, n, ε)
  shows IsHermitianMatrix(R, σ, n, signMatrix(R, n, ε)) ∧
    matMul(R, n, n, n, signMatrix(R, n, ε), signMatrix(R, n, ε)) = matOne(R, n)
proof
  sorry

end UnitaryMore

-- Section: Laws of symplectic groups
section Symplectic
variable (R l : Set)
hypothesis ring : CommRing(R)
hypothesis finite : Finite(l)

-- J² = −1 and det J = 1 (Matrix.J_squared, Matrix.J_det).
theorem symplecticForm.square
  shows matMul(R, l ⊎ l, l ⊎ l, l ⊎ l, symplecticForm(R, l), symplecticForm(R, l)) =
    matNeg(R, l ⊎ l, l ⊎ l, matOne(R, l ⊎ l))
proof
  sorry

theorem symplecticForm.det
  shows matDet(R, l ⊎ l, symplecticForm(R, l)) = R.one
proof
  sorry

theorem symplecticMatrices.subgroup
  shows Subgroup(symplecticMatrices(R, l), generalLinearGroup(R, l ⊎ l))
proof
  sorry

-- Matrix.symplecticGroup.transpose_mem: Sp is closed under transpose, so
-- it is U(J) for the trivial involution.
theorem symplecticMatrices.transpose (A : Set)
  requires member : A ∈ symplecticMatrices(R, l)
  shows matTranspose(R, l ⊎ l, l ⊎ l, A) ∈ symplecticMatrices(R, l)
proof
  sorry

theorem symplecticMatrices.eq_form_unitary
  shows symplecticMatrices(R, l) =
    formUnitaryMatrices(R, identity(R.carrier), l ⊎ l, symplecticForm(R, l))
proof
  sorry

-- Symplectic matrices have determinant 1 (over a field, or any
-- commutative ring: the Pfaffian identity).
theorem symplecticMatrices.det (A : Set)
  requires member : A ∈ symplecticMatrices(R, l)
  shows matDet(R, l ⊎ l, A) = R.one
proof
  sorry

end Symplectic
