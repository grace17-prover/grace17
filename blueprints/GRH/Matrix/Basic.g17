  have valueIn := values with j, rowIn, i, colIn
  have mapped := linearToMatrix.graph_relates at M, R, N, I, b, J, c, f, j, i with rowIn, colIn, valueIn
  have pairIn := product.pair at j, i, J, I with rowIn, colIn
  exact FunctionBetween.apply_value with function, pairIn, mapped

-- Section: First helpers on matrices
theorem matrixSpace.eq (R m n : Set)
  shows matrixSpace(R, m, n) = functionSpace(m × n, Ring.carrier(R))
proof
  unfold matrixSpace
  rfl

theorem matrixSpace.of_function (R m n A : Set)
  requires function : A : m × n → Ring.carrier(R)
  shows A ∈ matrixSpace(R, m, n)
proof
  rw matrixSpace.eq
  exact functionSpace.mem_iff.backward with function

theorem matrixSpace.function (R m n A : Set)
  requires matrix : A ∈ matrixSpace(R, m, n)
  shows A : m × n → Ring.carrier(R)
proof
  rw matrixSpace.eq at matrix
  exact functionSpace.mem_iff.forward with matrix

theorem matrixSpace.entry_mem (R m n A i j : Set)
  requires matrix : A ∈ matrixSpace(R, m, n)
  requires row : i ∈ m
  requires column : j ∈ n
  shows A((i, j)) ∈ Ring.carrier(R)
proof
  have function := matrixSpace.function with matrix
  have pair := product.pair at i, j, m, n with row, column
  exact FunctionBetween.apply_closed with function, pair

section MatrixHelpers
variable (R : Set)
hypothesis ring : CommRing(R)

theorem vecDotTerms.function_of (n v w : Set)
  requires first : v ∈ functionSpace(n, R.carrier)
  requires second : w ∈ functionSpace(n, R.carrier)
  shows vecDotTerms(R, n, v, w) : n → R.carrier
proof
  have values : ∀ j ∈ n, call2(R.mul, v(j), w(j)) ∈ R.carrier
    intros j hj
    have vj := functionSpace.apply_mem with first, hj
    have wj := functionSpace.apply_mem with second, hj
    exact Ring.mul_mem at R, v(j), w(j) with *
  exact vecDotTerms.graph_function at R, n, v, w with values

theorem vecDotTerms.at (n v w j : Set)
  requires first : v ∈ functionSpace(n, R.carrier)
  requires second : w ∈ functionSpace(n, R.carrier)
  requires index : j ∈ n
  shows vecDotTerms(R, n, v, w)(j) = v(j) * w(j)
proof
  have values : ∀ x ∈ n, call2(R.mul, v(x), w(x)) ∈ R.carrier
    intros x hx
    have vx := functionSpace.apply_mem with first, hx
    have wx := functionSpace.apply_mem with second, hx
    exact Ring.mul_mem at R, v(x), w(x) with *
  exact vecDotTerms.graph_apply at R, n, v, w, j with values, index

theorem matRow.space (m n A i : Set)
  requires matrix : A ∈ matrixSpace(R, m, n)
  requires row : i ∈ m
  shows matRow(R, n, A, i) ∈ functionSpace(n, R.carrier)
proof
  have values : ∀ j ∈ n, A((i, j)) ∈ R.carrier
    intros j hj
    exact matrixSpace.entry_mem with matrix, row, hj
  have function := matRow.graph_function at R, n, A, i with values
  exact functionSpace.mem_iff.backward with function

theorem matRow.at (m n A i j : Set)
  requires matrix : A ∈ matrixSpace(R, m, n)
  requires row : i ∈ m
  requires column : j ∈ n
  shows matRow(R, n, A, i)(j) = A((i, j))
proof
  have values : ∀ x ∈ n, A((i, x)) ∈ R.carrier
    intros x hx
    exact matrixSpace.entry_mem with matrix, row, hx
  exact matRow.graph_apply at R, n, A, i, j with values, column

theorem matCol.space (m n A j : Set)
  requires matrix : A ∈ matrixSpace(R, m, n)
  requires column : j ∈ n
  shows matCol(R, m, A, j) ∈ functionSpace(m, R.carrier)
proof
  have values : ∀ i ∈ m, A((i, j)) ∈ R.carrier
    intros i hi
    exact matrixSpace.entry_mem with matrix, hi, column
  have function := matCol.graph_function at R, m, A, j with values
  exact functionSpace.mem_iff.backward with function

theorem matCol.at (m n A i j : Set)
  requires matrix : A ∈ matrixSpace(R, m, n)
  requires row : i ∈ m
  requires column : j ∈ n
  shows matCol(R, m, A, j)(i) = A((i, j))
proof
  have values : ∀ x ∈ m, A((x, j)) ∈ R.carrier
    intros x hx
    exact matrixSpace.entry_mem with matrix, hx, column
  exact matCol.graph_apply at R, m, A, j, i with values, row

theorem vecDot.mem_of (n v w : Set)
  requires finite : Finite(n)
  requires first : v ∈ functionSpace(n, R.carrier)
  requires second : w ∈ functionSpace(n, R.carrier)
  shows vecDot(R, n, v, w) ∈ R.carrier
proof
  have parts := CommRing.parts with ring
  have terms := vecDotTerms.function_of at R, n, v, w with *
  unfold vecDot
  exact finiteRingSum.closed at n, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, vecDotTerms(R, n, v, w) with parts, finite, terms

end MatrixHelpers

-- Section: Entries and membership
section Entries
variable (R : Set)
hypothesis ring : CommRing(R)

-- Matrix.ext_iff.
theorem matrixSpace.ext (m n A B : Set)
  requires first : A ∈ matrixSpace(R, m, n)
  requires second : B ∈ matrixSpace(R, m, n)
  shows A = B ↔ (∀ i ∈ m, ∀ j ∈ n, A[i, j] = B[i, j])
proof
  have fA := matrixSpace.function with first
  have fB := matrixSpace.function with second
  constructor
  . intro same
    intros i hi j hj
    rw same
  . intro agree
    apply FunctionBetween.ext with fA, fB
    intros p hp
    obtain ⟨bound, i, hi, j, hj, shape⟩ := product.membership.forward with hp
    rw shape
    exact agree with i, hi, j, hj

theorem matAdd.mem (m n A B : Set)
  requires first : A ∈ matrixSpace(R, m, n)
  requires second : B ∈ matrixSpace(R, m, n)
  shows matAdd(R, m, n, A, B) ∈ matrixSpace(R, m, n)
proof
  have values : ∀ i ∈ m, ∀ j ∈ n, call2(R.add, A((i, j)), B((i, j))) ∈ R.carrier
    intros i hi j hj
    have a := matrixSpace.entry_mem with first, hi, hj
    have b := matrixSpace.entry_mem with second, hi, hj
    exact Ring.add_mem at R, A((i, j)), B((i, j)) with *
  have function := matAdd.graph_function at R, m, n, A, B with values
  exact matrixSpace.of_function with function

theorem matAdd.entry (m n A B i j : Set)
  requires first : A ∈ matrixSpace(R, m, n)
  requires second : B ∈ matrixSpace(R, m, n)
  requires row : i ∈ m
  requires column : j ∈ n
  shows matAdd(R, m, n, A, B)[i, j] = A[i, j] + B[i, j]
proof
  have values : ∀ x ∈ m, ∀ y ∈ n, call2(R.add, A((x, y)), B((x, y))) ∈ R.carrier
    intros x hx y hy
    have a := matrixSpace.entry_mem with first, hx, hy
    have b := matrixSpace.entry_mem with second, hx, hy
    exact Ring.add_mem at R, A((x, y)), B((x, y)) with *
  exact matAdd.graph_entry at R, m, n, A, B, i, j with values, row, column

theorem matSmul.entry (m n a A i j : Set)
  requires scalar : a ∈ R.carrier
  requires matrix : A ∈ matrixSpace(R, m, n)
  requires row : i ∈ m
  requires column : j ∈ n
  shows matSmul(R, m, n, a, A)[i, j] = a * A[i, j]
proof
  have values : ∀ x ∈ m, ∀ y ∈ n, call2(R.mul, a, A((x, y))) ∈ R.carrier
    intros x hx y hy
    have b := matrixSpace.entry_mem with matrix, hx, hy
    exact Ring.mul_mem at R, a, A((x, y)) with *
  exact matSmul.graph_entry at R, m, n, a, A, i, j with values, row, column

theorem vecDot.mem (n v w : Set)
  requires finite : Finite(n)
  requires first : v ∈ functionSpace(n, R.carrier)
  requires second : w ∈ functionSpace(n, R.carrier)
  shows vecDot(R, n, v, w) ∈ R.carrier
proof
  exact vecDot.mem_of at R, n, v, w with *

-- dotProduct_comm.
theorem vecDot.comm (n v w : Set)
  requires finite : Finite(n)
  requires first : v ∈ functionSpace(n, R.carrier)
  requires second : w ∈ functionSpace(n, R.carrier)
  shows vecDot(R, n, v, w) = vecDot(R, n, w, v)
proof
  have parts := CommRing.parts with ring
  have t1 := vecDotTerms.function_of at R, n, v, w with *
  have t2 := vecDotTerms.function_of at R, n, w, v with *
  have agree : ∀ x ∈ n, vecDotTerms(R, n, v, w)(x) = vecDotTerms(R, n, w, v)(x)
    intros x hx
    have vx := functionSpace.apply_mem with first, hx
    have wx := functionSpace.apply_mem with second, hx
    have e1 := vecDotTerms.at at R, n, v, w, x with *
    have e2 := vecDotTerms.at at R, n, w, v, x with *
    rw [e1, e2]
    ring
  unfold vecDot
  exact finiteRingSum.congr at n, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, vecDotTerms(R, n, v, w), vecDotTerms(R, n, w, v) with parts, finite, t1, t2, agree

theorem vecDot.add_left (n u v w : Set)
  requires finite : Finite(n)
  requires first : u ∈ functionSpace(n, R.carrier)
  requires second : v ∈ functionSpace(n, R.carrier)
  requires third : w ∈ functionSpace(n, R.carrier)
  shows vecDot(R, n, vecAdd(R, n, u, v), w) = vecDot(R, n, u, w) + vecDot(R, n, v, w)
proof
  have parts := CommRing.parts with ring
  have sumValues : ∀ j ∈ n, call2(R.add, u(j), v(j)) ∈ R.carrier
    intros j hj
    have uj := functionSpace.apply_mem with first, hj
    have vj := functionSpace.apply_mem with second, hj
    exact Ring.add_mem at R, u(j), v(j) with *
  have sumF := vecAdd.graph_function at R, n, u, v with sumValues
  have sumS := functionSpace.mem_iff.backward with sumF
  have t1 := vecDotTerms.function_of at R, n, u, w with *
  have t2 := vecDotTerms.function_of at R, n, v, w with *
  have th := vecDotTerms.function_of at R, n, vecAdd(R, n, u, v), w with *
  have oneIn := Ring.one_mem at R with *
  have entries : ∀ j ∈ n, vecDotTerms(R, n, vecAdd(R, n, u, v), w)(j) = R.one * vecDotTerms(R, n, u, w)(j) + R.one * vecDotTerms(R, n, v, w)(j)
    intros j hj
    have uj := functionSpace.apply_mem with first, hj
    have vj := functionSpace.apply_mem with second, hj
    have wj := functionSpace.apply_mem with third, hj
    have e1 := vecDotTerms.at at R, n, vecAdd(R, n, u, v), w, j with *
    have e2 := vecDotTerms.at at R, n, u, w, j with *
    have e3 := vecDotTerms.at at R, n, v, w, j with *
    have e4 := vecAdd.graph_apply at R, n, u, v, j with sumValues, hj
    rw [e1, e2, e3, e4]
    ring
  have law := finiteRingSum.linear at n, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, vecDotTerms(R, n, u, w), vecDotTerms(R, n, v, w), vecDotTerms(R, n, vecAdd(R, n, u, v), w), R.one, R.one with parts, finite, t1, t2, th, oneIn, oneIn, entries
  have s1 := vecDot.mem_of at R, n, u, w with *
  have s2 := vecDot.mem_of at R, n, v, w with *
  unfold vecDot
  unfold vecDot at s1
  unfold vecDot at s2
  rw law
  ring

theorem vecDot.smul_left (n a v w : Set)
  requires finite : Finite(n)
  requires scalar : a ∈ R.carrier
  requires first : v ∈ functionSpace(n, R.carrier)
  requires second : w ∈ functionSpace(n, R.carrier)
  shows vecDot(R, n, vecSmul(R, n, a, v), w) = a * vecDot(R, n, v, w)
proof
  have parts := CommRing.parts with ring
  have scaledValues : ∀ j ∈ n, call2(R.mul, a, v(j)) ∈ R.carrier
    intros j hj
    have vj := functionSpace.apply_mem with first, hj
    exact Ring.mul_mem at R, a, v(j) with *
  have scaledF := vecSmul.graph_function at R, n, a, v with scaledValues
  have scaledS := functionSpace.mem_iff.backward with scaledF
  have t1 := vecDotTerms.function_of at R, n, v, w with *
  have th := vecDotTerms.function_of at R, n, vecSmul(R, n, a, v), w with *
  have entries : ∀ j ∈ n, vecDotTerms(R, n, vecSmul(R, n, a, v), w)(j) = a * vecDotTerms(R, n, v, w)(j)
    intros j hj
    have vj := functionSpace.apply_mem with first, hj
    have wj := functionSpace.apply_mem with second, hj
    have e1 := vecDotTerms.at at R, n, vecSmul(R, n, a, v), w, j with *
    have e2 := vecDotTerms.at at R, n, v, w, j with *
    have e3 := vecSmul.graph_apply at R, n, a, v, j with scaledValues, hj
    rw [e1, e2, e3]
    ring
  unfold vecDot
  exact finiteRingSum.scale_eq at n, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, vecDotTerms(R, n, v, w), vecDotTerms(R, n, vecSmul(R, n, a, v), w), a with parts, finite, t1, th, scalar, entries

-- dotProduct_single: v ⬝ eⱼ = v(j).
theorem vecDot.unit_vector (n v j : Set)
  requires finite : Finite(n)
  requires vector : v ∈ functionSpace(n, R.carrier)
  requires index : j ∈ n
  shows vecDot(R, n, v, unitVector(R, n, j)) = v(j)
proof
  have parts := CommRing.parts with ring
  have unitS := unitVector.mem at R, n, j with ring
  have terms := vecDotTerms.function_of at R, n, v, unitVector(R, n, j) with *
  have single : {j} ⊆ n
    intros x hx
    have same := singleton.membership.forward with hx
    rw same
    exact index
  have vanishes : ∀ x ∈ n, ¬(x ∈ {j}) → vecDotTerms(R, n, v, unitVector(R, n, j))(x) = R.zero
    intros x hx out
    have other : x ≠ j
      intro same
      rw same at out
      exact out with (singleton.self at j)
    have vx := functionSpace.apply_mem with vector, hx
    have e1 := vecDotTerms.at at R, n, v, unitVector(R, n, j), x with *
    have e2 := unitVector.apply_other at R, n, j, x with ring, hx, other
    rw [e1, e2]
    ring
  have restricted := finiteRingSum.restrict at n, {j}, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, vecDotTerms(R, n, v, unitVector(R, n, j)) with parts, finite, terms, single, vanishes
  have rF := restrict.domain_function at vecDotTerms(R, n, v, unitVector(R, n, j)), n, R.carrier, {j} with terms, single
  have one := finiteRingSum.singleton at R.carrier, R.add, R.zero, R.neg, R.mul, R.one, restrict(vecDotTerms(R, n, v, unitVector(R, n, j)), {j}), j with parts, rF
  have r0 := restrict.domain_apply at vecDotTerms(R, n, v, unitVector(R, n, j)), n, R.carrier, {j}, j with terms, single, (singleton.self at j)
  have vj := functionSpace.apply_mem with vector, index
  have e1 := vecDotTerms.at at R, n, v, unitVector(R, n, j), j with *
  have e2 := unitVector.apply_same at R, n, j with ring, index
  unfold vecDot
  rw [restricted, one, r0, e1, e2]
  ring

theorem matMul.mem (m n p A B : Set)
  requires finite : Finite(n)
  requires first : A ∈ matrixSpace(R, m, n)
  requires second : B ∈ matrixSpace(R, n, p)
  shows matMul(R, m, n, p, A, B) ∈ matrixSpace(R, m, p)
proof
  sorry

-- Matrix.mul_apply.
theorem matMul.entry (m n p A B i k : Set)
  requires finite : Finite(n)
  requires first : A ∈ matrixSpace(R, m, n)
  requires second : B ∈ matrixSpace(R, n, p)
  requires row : i ∈ m
  requires column : k ∈ p
  shows matMul(R, m, n, p, A, B)[i, k] =
    vecDot(R, n, matRow(R, n, A, i), matCol(R, n, B, k))
proof
  sorry

theorem mulVec.mem (m n A v : Set)
  requires finite : Finite(n)
  requires matrix : A ∈ matrixSpace(R, m, n)
  requires vector : v ∈ functionSpace(n, R.carrier)
  shows mulVec(R, m, n, A, v) ∈ functionSpace(m, R.carrier)
proof
  sorry

-- Matrix.mulVec_eq_sum / mulVec_apply.
theorem mulVec.apply (m n A v i : Set)
  requires finite : Finite(n)
  requires matrix : A ∈ matrixSpace(R, m, n)
  requires vector : v ∈ functionSpace(n, R.carrier)
  requires row : i ∈ m
  shows mulVec(R, m, n, A, v)(i) = vecDot(R, n, matRow(R, n, A, i), v)
proof
  sorry

theorem vecMul.apply (m n v A j : Set)
  requires finite : Finite(m)
  requires matrix : A ∈ matrixSpace(R, m, n)
  requires vector : v ∈ functionSpace(m, R.carrier)
  requires column : j ∈ n
  shows vecMul(R, m, n, v, A)(j) = vecDot(R, m, v, matCol(R, m, A, j))
proof
  sorry

theorem vecMulVec.entry (m n v w i j : Set)
  requires first : v ∈ functionSpace(m, R.carrier)
  requires second : w ∈ functionSpace(n, R.carrier)
  requires row : i ∈ m
  requires column : j ∈ n
  shows vecMulVec(R, m, n, v, w)[i, j] = v(i) * w(j)
proof
  sorry

theorem matTranspose.entry (m n A i j : Set)
  requires matrix : A ∈ matrixSpace(R, m, n)
  requires row : i ∈ m
  requires column : j ∈ n
  shows matTranspose(R, m, n, A)[j, i] = A[i, j]
proof
  sorry

theorem conjTranspose.entry (σ m n A i j : Set)
  requires involution : RingInvolution(σ, R)
  requires matrix : A ∈ matrixSpace(R, m, n)
  requires row : i ∈ m
  requires column : j ∈ n
  shows conjTranspose(R, σ, m, n, A)[j, i] = σ(A[i, j])
proof
  sorry

theorem matDiagonal.entry (n d i j : Set)
  requires vector : d ∈ functionSpace(n, R.carrier)
  requires row : i ∈ n
  requires column : j ∈ n
  shows (i = j → matDiagonal(R, n, d)[i, j] = d(i)) ∧
    (i ≠ j → matDiagonal(R, n, d)[i, j] = R.zero)
proof
  sorry

theorem matOne.entry (n i j : Set)
  requires row : i ∈ n
  requires column : j ∈ n
  shows (i = j → matOne(R, n)[i, j] = R.one) ∧
    (i ≠ j → matOne(R, n)[i, j] = R.zero)
proof
  sorry

theorem matMap.entry (S m n f A i j : Set)
  requires hom : RingHom(f, R, S)
  requires matrix : A ∈ matrixSpace(R, m, n)
  requires row : i ∈ m
  requires column : j ∈ n
  shows matMap(S, m, n, f, A)[i, j] = f(A[i, j])
proof
  sorry

theorem submatrix.entry (m n m2 n2 A f g i j : Set)
  requires matrix : A ∈ matrixSpace(R, m, n)
  requires rows : f : m2 → m
  requires columns : g : n2 → n
  requires row : i ∈ m2
  requires column : j ∈ n2
  shows submatrix(R, m2, n2, A, f, g)[i, j] = A[f(i), g(j)]
proof
  sorry

theorem fromBlocks.mem (m1 m2 n1 n2 A B C D : Set)
  requires first : A ∈ matrixSpace(R, m1, n1)
  requires second : B ∈ matrixSpace(R, m1, n2)
  requires third : C ∈ matrixSpace(R, m2, n1)
  requires fourth : D ∈ matrixSpace(R, m2, n2)
  shows fromBlocks(R, m1, m2, n1, n2, A, B, C, D) ∈
    matrixSpace(R, m1 ⊎ m2, n1 ⊎ n2)
proof
  sorry

-- Matrix.toBlocks_fromBlocks₁₁ (and the other three blocks alike).
theorem fromBlocks.blocks (m1 m2 n1 n2 A B C D : Set)
  requires first : A ∈ matrixSpace(R, m1, n1)
  requires second : B ∈ matrixSpace(R, m1, n2)
  requires third : C ∈ matrixSpace(R, m2, n1)
  requires fourth : D ∈ matrixSpace(R, m2, n2)
  shows submatrix(R, m1, n1, fromBlocks(R, m1, m2, n1, n2, A, B, C, D),
      leftInclusion(m1, m2), leftInclusion(n1, n2)) = A ∧
    submatrix(R, m1, n2, fromBlocks(R, m1, m2, n1, n2, A, B, C, D),
      leftInclusion(m1, m2), rightInclusion(n1, n2)) = B ∧
    submatrix(R, m2, n1, fromBlocks(R, m1, m2, n1, n2, A, B, C, D),
      rightInclusion(m1, m2), leftInclusion(n1, n2)) = C ∧
    submatrix(R, m2, n2, fromBlocks(R, m1, m2, n1, n2, A, B, C, D),
      rightInclusion(m1, m2), rightInclusion(n1, n2)) = D
proof
  sorry

-- Matrix.fromBlocks_toBlocks: every matrix on sums is a block matrix.
theorem fromBlocks.of_blocks (m1 m2 n1 n2 M : Set)
  requires matrix : M ∈ matrixSpace(R, m1 ⊎ m2, n1 ⊎ n2)
  shows fromBlocks(R, m1, m2, n1, n2,
    submatrix(R, m1, n1, M, leftInclusion(m1, m2), leftInclusion(n1, n2)),
    submatrix(R, m1, n2, M, leftInclusion(m1, m2), rightInclusion(n1, n2)),
    submatrix(R, m2, n1, M, rightInclusion(m1, m2), leftInclusion(n1, n2)),
    submatrix(R, m2, n2, M, rightInclusion(m1, m2), rightInclusion(n1, n2))) = M
proof
  sorry

theorem fromRows.mem (m1 m2 n A C : Set)
  requires first : A ∈ matrixSpace(R, m1, n)
  requires second : C ∈ matrixSpace(R, m2, n)
  shows fromRows(R, m1, m2, n, A, C) ∈ matrixSpace(R, m1 ⊎ m2, n)
proof
  sorry

theorem fromCols.mem (m n1 n2 A B : Set)
  requires first : A ∈ matrixSpace(R, m, n1)
  requires second : B ∈ matrixSpace(R, m, n2)
  shows fromCols(R, m, n1, n2, A, B) ∈ matrixSpace(R, m, n1 ⊎ n2)
proof
  sorry

end Entries

-- Section: Algebra of matrices
section Products
variable (R : Set)
hypothesis ring : CommRing(R)

-- Matrix.mul_assoc.
theorem matMul.assoc (m n p q A B C : Set)
  requires finiteN : Finite(n)
  requires finiteP : Finite(p)
  requires first : A ∈ matrixSpace(R, m, n)
  requires second : B ∈ matrixSpace(R, n, p)
  requires third : C ∈ matrixSpace(R, p, q)
  shows matMul(R, m, p, q, matMul(R, m, n, p, A, B), C) =
    matMul(R, m, n, q, A, matMul(R, n, p, q, B, C))
proof
  sorry

-- Matrix.mul_add and Matrix.add_mul.
theorem matMul.add_right (m n p A B C : Set)
  requires finite : Finite(n)
  requires first : A ∈ matrixSpace(R, m, n)
  requires second : B ∈ matrixSpace(R, n, p)
  requires third : C ∈ matrixSpace(R, n, p)
  shows matMul(R, m, n, p, A, matAdd(R, n, p, B, C)) =
    matAdd(R, m, p, matMul(R, m, n, p, A, B), matMul(R, m, n, p, A, C))
proof
  sorry

theorem matMul.add_left (m n p A B C : Set)
  requires finite : Finite(n)
  requires first : A ∈ matrixSpace(R, m, n)
  requires second : B ∈ matrixSpace(R, m, n)
  requires third : C ∈ matrixSpace(R, n, p)
  shows matMul(R, m, n, p, matAdd(R, m, n, A, B), C) =
    matAdd(R, m, p, matMul(R, m, n, p, A, C), matMul(R, m, n, p, B, C))
proof
  sorry

theorem matMul.smul_left (m n p a A B : Set)
  requires finite : Finite(n)
  requires scalar : a ∈ R.carrier
  requires first : A ∈ matrixSpace(R, m, n)
  requires second : B ∈ matrixSpace(R, n, p)
  shows matMul(R, m, n, p, matSmul(R, m, n, a, A), B) =
    matSmul(R, m, p, a, matMul(R, m, n, p, A, B))
proof
  sorry

theorem matMul.one_left (m n A : Set)
  requires finite : Finite(m)
  requires matrix : A ∈ matrixSpace(R, m, n)
  shows matMul(R, m, m, n, matOne(R, m), A) = A
proof
  sorry

theorem matMul.one_right (m n A : Set)
  requires finite : Finite(n)
  requires matrix : A ∈ matrixSpace(R, m, n)
  shows matMul(R, m, n, n, A, matOne(R, n)) = A
proof
  sorry

-- Matrix.diagonal_mul_diagonal and the action of diagonal matrices on
-- rows and columns (diagonal_mul, mul_diagonal).
theorem matDiagonal.mul_diagonal (n d e : Set)
  requires finite : Finite(n)
  requires first : d ∈ functionSpace(n, R.carrier)
  requires second : e ∈ functionSpace(n, R.carrier)
  shows matMul(R, n, n, n, matDiagonal(R, n, d), matDiagonal(R, n, e)) =
    matDiagonal(R, n, vecDotTerms(R, n, d, e))
proof
  sorry

theorem matDiagonal.mul_left_entry (m n d A i j : Set)
  requires finite : Finite(m)
  requires vector : d ∈ functionSpace(m, R.carrier)
  requires matrix : A ∈ matrixSpace(R, m, n)
  requires row : i ∈ m
  requires column : j ∈ n
  shows matMul(R, m, m, n, matDiagonal(R, m, d), A)[i, j] = d(i) * A[i, j]
proof
  sorry

-- Matrix.smul_eq_diagonal_mul: a A = (a·1) A.
theorem matScalar.mul (m n a A : Set)
  requires finite : Finite(m)
  requires scalar : a ∈ R.carrier
  requires matrix : A ∈ matrixSpace(R, m, n)
  shows matMul(R, m, m, n, matScalar(R, m, a), A) = matSmul(R, m, n, a, A)
proof
  sorry

-- Matrix.mulVec_mulVec: A (B v) = (A B) v.
theorem mulVec.mulVec (m n p A B v : Set)
  requires finiteN : Finite(n)
  requires finiteP : Finite(p)
  requires first : A ∈ matrixSpace(R, m, n)
  requires second : B ∈ matrixSpace(R, n, p)
  requires vector : v ∈ functionSpace(p, R.carrier)
  shows mulVec(R, m, n, A, mulVec(R, n, p, B, v)) =
    mulVec(R, m, p, matMul(R, m, n, p, A, B), v)
proof
  sorry

-- Matrix.mulVec_add, mulVec_smul, add_mulVec.
theorem mulVec.add (m n A v w : Set)
  requires finite : Finite(n)
  requires matrix : A ∈ matrixSpace(R, m, n)
  requires first : v ∈ functionSpace(n, R.carrier)
  requires second : w ∈ functionSpace(n, R.carrier)
  shows mulVec(R, m, n, A, vecAdd(R, n, v, w)) =
    vecAdd(R, m, mulVec(R, m, n, A, v), mulVec(R, m, n, A, w))
proof
  sorry

theorem mulVec.smul (m n A a v : Set)
  requires finite : Finite(n)
  requires matrix : A ∈ matrixSpace(R, m, n)
  requires scalar : a ∈ R.carrier
  requires vector : v ∈ functionSpace(n, R.carrier)
  shows mulVec(R, m, n, A, vecSmul(R, n, a, v)) = vecSmul(R, m, a, mulVec(R, m, n, A, v))
proof
  sorry

theorem mulVec.add_matrix (m n A B v : Set)
  requires finite : Finite(n)
  requires first : A ∈ matrixSpace(R, m, n)
  requires second : B ∈ matrixSpace(R, m, n)
  requires vector : v ∈ functionSpace(n, R.carrier)
  shows mulVec(R, m, n, matAdd(R, m, n, A, B), v) =
    vecAdd(R, m, mulVec(R, m, n, A, v), mulVec(R, m, n, B, v))
proof
  sorry

theorem mulVec.one (n v : Set)
  requires finite : Finite(n)
  requires vector : v ∈ functionSpace(n, R.carrier)
  shows mulVec(R, n, n, matOne(R, n), v) = v
proof
  sorry

-- Matrix.mulVec_single: A eⱼ is the j-th column.
theorem mulVec.unit_vector (m n A j : Set)
  requires finite : Finite(n)
  requires matrix : A ∈ matrixSpace(R, m, n)
  requires index : j ∈ n
  shows mulVec(R, m, n, A, unitVector(R, n, j)) = matCol(R, m, A, j)
proof
  sorry

-- Matrix.ext_iff_mulVec: matrices with the same action are equal.
theorem mulVec.ext (m n A B : Set)
  requires finite : Finite(n)
  requires first : A ∈ matrixSpace(R, m, n)
  requires second : B ∈ matrixSpace(R, m, n)
  requires agree : ∀ v ∈ functionSpace(n, R.carrier),
    mulVec(R, m, n, A, v) = mulVec(R, m, n, B, v)
  shows A = B
proof
  sorry

-- Matrix.dotProduct_mulVec: v ⬝ (A w) = (v A) ⬝ w.
theorem vecDot.mulVec (m n v A w : Set)
  requires finiteM : Finite(m)
  requires finiteN : Finite(n)
  requires first : v ∈ functionSpace(m, R.carrier)
  requires matrix : A ∈ matrixSpace(R, m, n)
  requires second : w ∈ functionSpace(n, R.carrier)
  shows vecDot(R, m, v, mulVec(R, m, n, A, w)) =
    vecDot(R, n, vecMul(R, m, n, v, A), w)
proof
  sorry

-- Matrix.vecMul_transpose: v A = Aᵀ v.
theorem vecMul.transpose (m n v A : Set)
  requires finite : Finite(m)
  requires matrix : A ∈ matrixSpace(R, m, n)
  requires vector : v ∈ functionSpace(m, R.carrier)
  shows vecMul(R, m, n, v, A) = mulVec(R, n, m, matTranspose(R, m, n, A), v)
proof
  sorry

-- Matrix.vecMulVec_mulVec and mul_vecMulVec.
theorem vecMulVec.mulVec (m n v w u : Set)
  requires finite : Finite(n)
  requires first : v ∈ functionSpace(m, R.carrier)
  requires second : w ∈ functionSpace(n, R.carrier)
  requires third : u ∈ functionSpace(n, R.carrier)
  shows mulVec(R, m, n, vecMulVec(R, m, n, v, w), u) =
    vecSmul(R, m, vecDot(R, n, w, u), v)
proof
  sorry

-- Matrix.transpose_mul and transpose_transpose.
theorem matTranspose.mul (m n p A B : Set)
  requires finite : Finite(n)
  requires first : A ∈ matrixSpace(R, m, n)
  requires second : B ∈ matrixSpace(R, n, p)
  shows matTranspose(R, m, p, matMul(R, m, n, p, A, B)) =
    matMul(R, p, n, m, matTranspose(R, n, p, B), matTranspose(R, m, n, A))
proof
  sorry

theorem matTranspose.involution (m n A : Set)
  requires matrix : A ∈ matrixSpace(R, m, n)
  shows matTranspose(R, n, m, matTranspose(R, m, n, A)) = A
proof
  sorry

-- Matrix.trace_mul_comm and trace of sums.
theorem matTrace.mul_comm (m n A B : Set)
  requires finiteM : Finite(m)
  requires finiteN : Finite(n)
  requires first : A ∈ matrixSpace(R, m, n)
  requires second : B ∈ matrixSpace(R, n, m)
  shows matTrace(R, m, matMul(R, m, n, m, A, B)) =
    matTrace(R, n, matMul(R, n, m, n, B, A))
proof
  sorry

theorem matTrace.add (n A B : Set)
  requires finite : Finite(n)
  requires first : A ∈ matrixSpace(R, n, n)
  requires second : B ∈ matrixSpace(R, n, n)
  shows matTrace(R, n, matAdd(R, n, n, A, B)) = matTrace(R, n, A) + matTrace(R, n, B)
proof
  sorry

theorem matTrace.transpose (n A : Set)
  requires finite : Finite(n)
  requires matrix : A ∈ matrixSpace(R, n, n)
  shows matTrace(R, n, matTranspose(R, n, n, A)) = matTrace(R, n, A)
proof
  sorry

-- Matrix.submatrix_mul: for a bijection of the inner index, submatrices
-- multiply.
theorem submatrix.mul (m n p m2 n2 p2 A B f g h : Set)
  requires finiteN : Finite(n)
  requires first : A ∈ matrixSpace(R, m, n)
  requires second : B ∈ matrixSpace(R, n, p)
  requires rows : f : m2 → m
  requires inner : BijectiveBetween(g, n2, n)
  requires columns : h : p2 → p
  shows matMul(R, m2, n2, p2, submatrix(R, m2, n2, A, f, g),
      submatrix(R, n2, p2, B, g, h)) =
    submatrix(R, m2, p2, matMul(R, m, n, p, A, B), f, h)
proof
  sorry

-- Matrix.fromBlocks_multiply: block matrices multiply blockwise.
theorem fromBlocks.mul (m1 m2 n1 n2 p1 p2 A B C D E F G H : Set)
  requires finiteN1 : Finite(n1)
  requires finiteN2 : Finite(n2)
  requires a : A ∈ matrixSpace(R, m1, n1)
  requires b : B ∈ matrixSpace(R, m1, n2)
  requires c : C ∈ matrixSpace(R, m2, n1)
  requires d : D ∈ matrixSpace(R, m2, n2)
  requires e : E ∈ matrixSpace(R, n1, p1)
  requires f : F ∈ matrixSpace(R, n1, p2)
  requires g : G ∈ matrixSpace(R, n2, p1)
  requires h : H ∈ matrixSpace(R, n2, p2)
  shows matMul(R, m1 ⊎ m2, n1 ⊎ n2, p1 ⊎ p2,
      fromBlocks(R, m1, m2, n1, n2, A, B, C, D),
      fromBlocks(R, n1, n2, p1, p2, E, F, G, H)) =
    fromBlocks(R, m1, m2, p1, p2,
      matAdd(R, m1, p1, matMul(R, m1, n1, p1, A, E), matMul(R, m1, n2, p1, B, G)),
      matAdd(R, m1, p2, matMul(R, m1, n1, p2, A, F), matMul(R, m1, n2, p2, B, H)),
      matAdd(R, m2, p1, matMul(R, m2, n1, p1, C, E), matMul(R, m2, n2, p1, D, G)),
      matAdd(R, m2, p2, matMul(R, m2, n1, p2, C, F), matMul(R, m2, n2, p2, D, H)))
proof
  sorry

-- Matrix.fromCols_mul_fromRows: [A B] [C; D] = A C + B D.
theorem fromCols.mul_fromRows (m n1 n2 p A B C D : Set)
  requires finiteN1 : Finite(n1)
  requires finiteN2 : Finite(n2)
  requires a : A ∈ matrixSpace(R, m, n1)
  requires b : B ∈ matrixSpace(R, m, n2)
  requires c : C ∈ matrixSpace(R, n1, p)
  requires d : D ∈ matrixSpace(R, n2, p)
  shows matMul(R, m, n1 ⊎ n2, p, fromCols(R, m, n1, n2, A, B),
      fromRows(R, n1, n2, p, C, D)) =
    matAdd(R, m, p, matMul(R, m, n1, p, A, C), matMul(R, m, n2, p, B, D))
proof
  sorry

-- Matrix.fromRows_mul: [A; C] B = [A B; C B].
theorem fromRows.mul (m1 m2 n p A C B : Set)
  requires finite : Finite(n)
  requires a : A ∈ matrixSpace(R, m1, n)
  requires c : C ∈ matrixSpace(R, m2, n)
  requires b : B ∈ matrixSpace(R, n, p)
  shows matMul(R, m1 ⊎ m2, n, p, fromRows(R, m1, m2, n, A, C), B) =
    fromRows(R, m1, m2, p, matMul(R, m1, n, p, A, B), matMul(R, m2, n, p, C, B))
proof
  sorry

-- Matrix.fromBlocks_mulVec.
theorem fromBlocks.mulVec (m1 m2 n1 n2 A B C D v : Set)
  requires finiteN1 : Finite(n1)
  requires finiteN2 : Finite(n2)
  requires a : A ∈ matrixSpace(R, m1, n1)
  requires b : B ∈ matrixSpace(R, m1, n2)
  requires c : C ∈ matrixSpace(R, m2, n1)
  requires d : D ∈ matrixSpace(R, m2, n2)
  requires vector : v ∈ functionSpace(n1 ⊎ n2, R.carrier)
  shows mulVec(R, m1 ⊎ m2, n1 ⊎ n2, fromBlocks(R, m1, m2, n1, n2, A, B, C, D), v) =
    vecAppend(R, m1, m2,
      vecAdd(R, m1, mulVec(R, m1, n1, A, compose(v, leftInclusion(n1, n2), n1,
        n1 ⊎ n2, R.carrier)), mulVec(R, m1, n2, B, compose(v,
        rightInclusion(n1, n2), n2, n1 ⊎ n2, R.carrier))),
      vecAdd(R, m2, mulVec(R, m2, n1, C, compose(v, leftInclusion(n1, n2), n1,
        n1 ⊎ n2, R.carrier)), mulVec(R, m2, n2, D, compose(v,
        rightInclusion(n1, n2), n2, n1 ⊎ n2, R.carrier))))
proof
  sorry

-- The block-triangular matrices for b and lt are closed under products
-- (Matrix.BlockTriangular.mul).
theorem BlockTriangular.mul (n A B b lt T : Set)
  requires finite : Finite(n)
  requires order : StrictLinearOrder(T, lt)
  requires blocks : b : n → T
  requires first : A ∈ matrixSpace(R, n, n)
  requires second : B ∈ matrixSpace(R, n, n)
  requires triangularA : BlockTriangular(R, n, A, b, lt)
  requires triangularB : BlockTriangular(R, n, B, b, lt)
  shows BlockTriangular(R, n, matMul(R, n, n, n, A, B), b, lt)
proof
  sorry

-- Matrix.map_mul, map_add, map_one under a ring map, and the transpose.
theorem matMap.mul (S m n p f A B : Set)
  requires target : CommRing(S)
  requires finite : Finite(n)
  requires hom : RingHom(f, R, S)
  requires first : A ∈ matrixSpace(R, m, n)
  requires second : B ∈ matrixSpace(R, n, p)
  shows matMap(S, m, p, f, matMul(R, m, n, p, A, B)) =
    matMul(S, m, n, p, matMap(S, m, n, f, A), matMap(S, n, p, f, B))
proof
  sorry

theorem matMap.add (S m n f A B : Set)
  requires target : CommRing(S)
  requires hom : RingHom(f, R, S)
  requires first : A ∈ matrixSpace(R, m, n)
  requires second : B ∈ matrixSpace(R, m, n)
  shows matMap(S, m, n, f, matAdd(R, m, n, A, B)) =
    matAdd(S, m, n, matMap(S, m, n, f, A), matMap(S, m, n, f, B))
proof
  sorry

theorem matMap.one (S n f : Set)
  requires target : CommRing(S)
  requires hom : RingHom(f, R, S)
  shows matMap(S, n, n, f, matOne(R, n)) = matOne(S, n)
proof
  sorry

theorem matMap.mulVec (S m n f A v : Set)
  requires target : CommRing(S)
  requires finite : Finite(n)
  requires hom : RingHom(f, R, S)
  requires matrix : A ∈ matrixSpace(R, m, n)
  requires vector : v ∈ functionSpace(n, R.carrier)
  shows compose(f, mulVec(R, m, n, A, v), m, R.carrier, S.carrier) =
    mulVec(S, m, n, matMap(S, m, n, f, A), compose(f, v, n, R.carrier, S.carrier))
proof
  sorry

-- Matrix.map_injective.
theorem matMap.injective (S m n f A B : Set)
  requires hom : RingHom(f, R, S)
  requires injective : InjectiveBetween(f, R.carrier, S.carrier)
  requires first : A ∈ matrixSpace(R, m, n)
  requires second : B ∈ matrixSpace(R, m, n)
  requires same : matMap(S, m, n, f, A) = matMap(S, m, n, f, B)
  shows A = B
proof
  sorry

end Products

-- Section: Conjugate transpose
section Conjugate
variable (R σ : Set)
hypothesis involution : RingInvolution(σ, R)

-- Matrix.conjTranspose_mul: (A B)ᴴ = Bᴴ Aᴴ.
theorem conjTranspose.mul (m n p A B : Set)
  requires finite : Finite(n)
  requires first : A ∈ matrixSpace(R, m, n)
  requires second : B ∈ matrixSpace(R, n, p)
  shows conjTranspose(R, σ, m, p, matMul(R, m, n, p, A, B)) =
    matMul(R, p, n, m, conjTranspose(R, σ, n, p, B), conjTranspose(R, σ, m, n, A))
proof
  sorry

theorem conjTranspose.involution (m n A : Set)
  requires matrix : A ∈ matrixSpace(R, m, n)
  shows conjTranspose(R, σ, n, m, conjTranspose(R, σ, m, n, A)) = A
proof
  sorry

theorem conjTranspose.add (m n A B : Set)
  requires first : A ∈ matrixSpace(R, m, n)
  requires second : B ∈ matrixSpace(R, m, n)
  shows conjTranspose(R, σ, m, n, matAdd(R, m, n, A, B)) =
    matAdd(R, n, m, conjTranspose(R, σ, m, n, A), conjTranspose(R, σ, m, n, B))
proof
  sorry

theorem conjTranspose.one (n : Set)
  shows conjTranspose(R, σ, n, n, matOne(R, n)) = matOne(R, n)
proof
  sorry

-- Matrix.star_mulVec: σ(A v) = σ(v) Aᴴ.
theorem conjTranspose.star_mulVec (m n A v : Set)
  requires finite : Finite(n)
  requires matrix : A ∈ matrixSpace(R, m, n)
  requires vector : v ∈ functionSpace(n, R.carrier)
  shows vecConj(R, σ, m, mulVec(R, m, n, A, v)) =
    vecMul(R, n, m, vecConj(R, σ, n, v), conjTranspose(R, σ, m, n, A))
proof
  sorry

-- Matrix.star_dotProduct: σ(v ⬝ w) = σ(v) ⬝ σ(w).
theorem vecDot.star (n v w : Set)
  requires finite : Finite(n)
  requires first : v ∈ functionSpace(n, R.carrier)
  requires second : w ∈ functionSpace(n, R.carrier)
  shows σ(vecDot(R, n, v, w)) = vecDot(R, n, vecConj(R, σ, n, v), vecConj(R, σ, n, w))
proof
  sorry

-- Matrix.conjTranspose_fromBlocks.
theorem conjTranspose.fromBlocks (m1 m2 n1 n2 A B C D : Set)
  requires a : A ∈ matrixSpace(R, m1, n1)
  requires b : B ∈ matrixSpace(R, m1, n2)
  requires c : C ∈ matrixSpace(R, m2, n1)
  requires d : D ∈ matrixSpace(R, m2, n2)
  shows conjTranspose(R, σ, m1 ⊎ m2, n1 ⊎ n2,
      fromBlocks(R, m1, m2, n1, n2, A, B, C, D)) =
    fromBlocks(R, n1, n2, m1, m2, conjTranspose(R, σ, m1, n1, A),
      conjTranspose(R, σ, m2, n1, C), conjTranspose(R, σ, m1, n2, B),
      conjTranspose(R, σ, m2, n2, D))
proof
  sorry

-- conjTranspose_fromCols_eq_fromRows_conjTranspose.
theorem conjTranspose.fromCols (m n1 n2 A B : Set)
  requires a : A ∈ matrixSpace(R, m, n1)
  requires b : B ∈ matrixSpace(R, m, n2)
  shows conjTranspose(R, σ, m, n1 ⊎ n2, fromCols(R, m, n1, n2, A, B)) =
    fromRows(R, n1, n2, m, conjTranspose(R, σ, m, n1, A),
      conjTranspose(R, σ, m, n2, B))
proof
  sorry

-- With the trivial involution the conjugate transpose is the transpose.
theorem conjTranspose.identity (m n A : Set)
  requires ring : CommRing(R)
  requires matrix : A ∈ matrixSpace(R, m, n)
  shows conjTranspose(R, identity(R.carrier), m, n, A) = matTranspose(R, m, n, A)
proof
  sorry

-- A congruence of a hermitian matrix is hermitian: (Pᴴ J P)ᴴ = Pᴴ J P.
theorem IsHermitianMatrix.congr (m n J P : Set)
  requires finiteM : Finite(m)
  requires finiteN : Finite(n)
  requires form : J ∈ matrixSpace(R, m, m)
  requires hermitian : IsHermitianMatrix(R, σ, m, J)
  requires matrix : P ∈ matrixSpace(R, m, n)
  shows IsHermitianMatrix(R, σ, n, matMul(R, n, m, n,
    conjTranspose(R, σ, m, n, P), matMul(R, m, m, n, J, P)))
proof
  sorry

end Conjugate

-- Section: Square matrices, the matrix module, and linear maps
section Rings
variable (R : Set)
hypothesis ring : CommRing(R)

theorem squareMatrixRing.ring (n : Set)
  requires finite : Finite(n)
  shows Ring(squareMatrixRing(R, n))
proof
  sorry

theorem squareMatrixRing.mul_eq (n A B : Set)
  requires first : A ∈ matrixSpace(R, n, n)
  requires second : B ∈ matrixSpace(R, n, n)
  shows call2(Ring.mul(squareMatrixRing(R, n)), A, B) = matMul(R, n, n, n, A, B)
proof
  sorry

-- On the index set n = {0, …, n − 1} the ring is Cumulus's matrixRing.
theorem squareMatrixRing.nat (n : Nat)
  shows squareMatrixRing(R, n) = matrixRing(R, n)
proof
  sorry

theorem matrixModule.module (m n : Set)
  shows Module(matrixModule(R, m, n), R)
proof
  sorry

theorem matrixModule.operations (m n A B a : Set)
  requires first : A ∈ matrixSpace(R, m, n)
  requires second : B ∈ matrixSpace(R, m, n)
  requires scalar : a ∈ R.carrier
  shows call2(Module.add(matrixModule(R, m, n)), A, B) = matAdd(R, m, n, A, B) ∧
    call2(Module.smul(matrixModule(R, m, n)), a, A) = matSmul(R, m, n, a, A)
proof
  sorry

-- Module.finrank_matrix: Rᵐˣⁿ is free of rank |m| |n|, with the
-- single-entry matrices as basis.
theorem matrixModule.finrank (m n : Set)
  requires nontrivial : R.zero ≠ R.one
  requires finiteM : Finite(m)
  requires finiteN : Finite(n)
  shows FiniteFreeModule(matrixModule(R, m, n), R) ∧
    finrank(matrixModule(R, m, n), R) = cardinality(m) * cardinality(n)
proof
  sorry

-- Matrix.toLin': A as a linear map Rⁿ → Rᵐ; every linear map Rⁿ → Rᵐ is
-- one, for a unique A (Matrix.toLin' is an equivalence).
theorem mulVecMap.linear (m n A : Set)
  requires finite : Finite(n)
  requires matrix : A ∈ matrixSpace(R, m, n)
  shows LinearMap(mulVecMap(R, m, n, A), coordinateModule(R, n), R,
    coordinateModule(R, m))
proof
  sorry

theorem mulVecMap.surjective (m n f : Set)
  requires finite : Finite(n)
  requires linear : LinearMap(f, coordinateModule(R, n), R, coordinateModule(R, m))
  shows ∃ A ∈ matrixSpace(R, m, n), f = mulVecMap(R, m, n, A)
proof
  sorry

theorem mulVecMap.compose (m n p A B : Set)
  requires finiteN : Finite(n)
  requires finiteP : Finite(p)
  requires first : A ∈ matrixSpace(R, m, n)
  requires second : B ∈ matrixSpace(R, n, p)
  shows compose(mulVecMap(R, m, n, A), mulVecMap(R, n, p, B),
      functionSpace(p, R.carrier), functionSpace(n, R.carrier),
      functionSpace(m, R.carrier)) =
    mulVecMap(R, m, p, matMul(R, m, n, p, A, B))
proof
  sorry

-- LinearMap.toMatrix_apply and its characterization: the coordinates of
-- f(x) are the matrix times the coordinates of x.
theorem linearToMatrix.mem (M N I b J c f : Set)
  requires finiteI : Finite(I)
  requires finiteJ : Finite(J)
  requires basisM : ModuleBasis(M, R, I, b)
  requires basisN : ModuleBasis(N, R, J, c)
  requires linear : LinearMap(f, M, R, N)
  shows linearToMatrix(M, R, N, I, b, J, c, f) ∈ matrixSpace(R, J, I)
proof
  sorry

theorem linearToMatrix.coordinates (M N I b J c f x : Set)
  requires finiteI : Finite(I)
  requires finiteJ : Finite(J)
  requires basisM : ModuleBasis(M, R, I, b)
  requires basisN : ModuleBasis(N, R, J, c)
  requires linear : LinearMap(f, M, R, N)
  requires vector : x ∈ Module.carrier(M)
  shows basisCoordinates(N, R, J, c, f(x)) = mulVec(R, J, I,
    linearToMatrix(M, R, N, I, b, J, c, f), basisCoordinates(M, R, I, b, x))
proof
  sorry

-- LinearMap.toMatrix_comp: the matrix of a composite is the product.
theorem linearToMatrix.compose (M N P I b J c K d f g : Set)
  requires finiteI : Finite(I)
  requires finiteJ : Finite(J)
  requires finiteK : Finite(K)
  requires basisM : ModuleBasis(M, R, I, b)
  requires basisN : ModuleBasis(N, R, J, c)
  requires basisP : ModuleBasis(P, R, K, d)
  requires first : LinearMap(f, M, R, N)
  requires second : LinearMap(g, N, R, P)
  shows linearToMatrix(M, R, P, I, b, K, d, compose(g, f, Module.carrier(M),
      Module.carrier(N), Module.carrier(P))) =
    matMul(R, K, J, I, linearToMatrix(N, R, P, J, c, K, d, g),
      linearToMatrix(M, R, N, I, b, J, c, f))
proof
  sorry

theorem linearToMatrix.identity (M I b : Set)
  requires finite : Finite(I)
  requires basis : ModuleBasis(M, R, I, b)
  shows linearToMatrix(M, R, M, I, b, I, b, identity(Module.carrier(M))) =
    matOne(R, I)
proof
  sorry

-- In the standard bases the matrix of v ↦ A v is A.
theorem linearToMatrix.standard (m n A : Set)
  requires finiteM : Finite(m)
  requires finiteN : Finite(n)
  requires matrix : A ∈ matrixSpace(R, m, n)
  shows linearToMatrix(coordinateModule(R, n), R, coordinateModule(R, m), n,
    standardBasis(R, n), m, standardBasis(R, m), mulVecMap(R, m, n, A)) = A
proof
  sorry

-- Change of basis: matrices of one endomorphism in two bases are
-- conjugate by the change-of-basis matrix.
theorem linearToMatrix.change_of_basis (M I b J c f : Set)
  requires finiteI : Finite(I)
  requires finiteJ : Finite(J)
  requires basisB : ModuleBasis(M, R, I, b)
  requires basisC : ModuleBasis(M, R, J, c)
  requires linear : LinearMap(f, M, R, M)
  shows matMul(R, J, I, J, linearToMatrix(M, R, M, I, b, J, c,
      identity(Module.carrier(M))),
      matMul(R, I, I, J, linearToMatrix(M, R, M, I, b, I, b, f),
        linearToMatrix(M, R, M, J, c, I, b, identity(Module.carrier(M))))) =
    linearToMatrix(M, R, M, J, c, J, c, f)
proof
  sorry

end Rings
