        have r2 := matCol.at at R, n1 ⊎ n2, p1 ⊎ p2, fromBlocks(R, n1, n2, p1, p2, E, F, G, H), inr(j), inr(k) with ring, mR, jIn, yIn
        have r3 := matRow.at at R, m2, n2, D, i, j with ring, d, hi, hj
