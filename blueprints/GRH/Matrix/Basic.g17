-- Authors: Grant Passmore

module GRH.Matrix.Basic
import GRH.Linear.Dimension
import Grace.Cumulus.Algebra.Ring.MatrixRing
import Grace.Cumulus.Algebra.Ring.DoubleSum
import Grace.Cumulus.Cardinal.Sum

-- Section: Matrices and their operations
-- An m × n matrix over R is a function m × n → R; its (i, j) entry is
-- A[i, j]. Index sets are arbitrary (finite where sums are taken), as
-- Mathlib's Matrix m n R; a vector is a function n → R. Every operation is
-- the graph of its entries, so it is defined without proof obligations,
-- and each comes with a membership theorem.
def matrixSpace (R m n : Set) : Set := functionSpace(m × n, Ring.carrier(R))

def matAdd (R m n A B : Set) : Set :=
  { q ∈ (m × n) × Ring.carrier(R) | ∃ i ∈ m, ∃ j ∈ n,
    q = ((i, j), call2(Ring.add(R), A[i, j], B[i, j])) }

def matNeg (R m n A : Set) : Set :=
  { q ∈ (m × n) × Ring.carrier(R) | ∃ i ∈ m, ∃ j ∈ n,
    q = ((i, j), apply(Ring.neg(R), A[i, j])) }

def matZero (R m n : Set) : Set :=
  constantFunction(m × n, Ring.carrier(R), Ring.zero(R))

def matSmul (R m n a A : Set) : Set :=
  { q ∈ (m × n) × Ring.carrier(R) | ∃ i ∈ m, ∃ j ∈ n,
    q = ((i, j), call2(Ring.mul(R), a, A[i, j])) }

-- The dot product Σ_j v(j) w(j) (Mathlib's dotProduct, v ⬝ᵥ w), rows and
-- columns of a matrix.
def vecDotTerms (R n v w : Set) : Set :=
  { q ∈ n × Ring.carrier(R) | ∃ j ∈ n, q = (j, call2(Ring.mul(R), v(j), w(j))) }

def vecDot (R n v w : Set) : Set :=
  finiteRingSum(n, Ring.carrier(R), Ring.add(R), Ring.zero(R), Ring.neg(R),
    Ring.mul(R), Ring.one(R), vecDotTerms(R, n, v, w))

def matRow (R n A i : Set) : Set :=
  { q ∈ n × Ring.carrier(R) | ∃ j ∈ n, q = (j, A[i, j]) }

def matCol (R m A j : Set) : Set :=
  { q ∈ m × Ring.carrier(R) | ∃ i ∈ m, q = (i, A[i, j]) }

-- The product (AB)[i, k] = Σ_j A[i, j] B[j, k] of an m × n and an n × p
-- matrix, A v (Matrix.mulVec, A *ᵥ v), v A (Matrix.vecMul), and the outer
-- product v wᵀ (Matrix.vecMulVec).
def matMul (R m n p A B : Set) : Set :=
  { q ∈ (m × p) × Ring.carrier(R) | ∃ i ∈ m, ∃ k ∈ p,
    q = ((i, k), vecDot(R, n, matRow(R, n, A, i), matCol(R, n, B, k))) }

def mulVec (R m n A v : Set) : Set :=
  { q ∈ m × Ring.carrier(R) | ∃ i ∈ m, q = (i, vecDot(R, n, matRow(R, n, A, i), v)) }

def vecMul (R m n v A : Set) : Set :=
  { q ∈ n × Ring.carrier(R) | ∃ j ∈ n, q = (j, vecDot(R, m, v, matCol(R, m, A, j))) }

def vecMulVec (R m n v w : Set) : Set :=
  { q ∈ (m × n) × Ring.carrier(R) | ∃ i ∈ m, ∃ j ∈ n,
    q = ((i, j), call2(Ring.mul(R), v(i), w(j))) }

-- The pointwise sum and multiple of vectors n → R.
def vecAdd (R n v w : Set) : Set :=
  { q ∈ n × Ring.carrier(R) | ∃ j ∈ n, q = (j, call2(Ring.add(R), v(j), w(j))) }

def vecSmul (R n a v : Set) : Set :=
  { q ∈ n × Ring.carrier(R) | ∃ j ∈ n, q = (j, call2(Ring.mul(R), a, v(j))) }

-- The transpose (Cumulus's transposedMatrix), and for an involution σ of R
-- the conjugate transpose Aᴴ[j, i] = σ(A[i, j]) (Matrix.conjTranspose),
-- and the conjugate σ(v) of a vector (star v).
def matTranspose (R m n A : Set) : Set := transposedMatrix(m, n, Ring.carrier(R), A)

def conjTranspose (R σ m n A : Set) : Set :=
  { q ∈ (n × m) × Ring.carrier(R) | ∃ i ∈ m, ∃ j ∈ n, q = ((j, i), σ(A[i, j])) }

def vecConj (R σ n v : Set) : Set :=
  { q ∈ n × Ring.carrier(R) | ∃ j ∈ n, q = (j, σ(v(j))) }

-- An involution of a commutative ring: a ring map σ with σ ∘ σ = id
-- (Mathlib's StarRing on a commutative ring; σ is complex conjugation on
-- ℂ, the nontrivial automorphism of a quadratic extension, or the
-- identity).
predicate RingInvolution (σ R : Set) :=
  CommRing(R) ∧ RingHom(σ, R, R) ∧ (∀ x ∈ Ring.carrier(R), σ(σ(x)) = x)

-- Diagonal matrices (Matrix.diagonal), the identity, scalar matrices
-- (Matrix.scalar), the trace (Matrix.trace), and the matrix with a in
-- place (i, j) and 0 elsewhere (Matrix.single).
def matDiagonal (R n d : Set) : Set :=
  { q ∈ (n × n) × Ring.carrier(R) | ∃ i ∈ n, ∃ j ∈ n,
    (i = j ∧ q = ((i, j), d(i))) ∨ (i ≠ j ∧ q = ((i, j), Ring.zero(R))) }

def matOne (R n : Set) : Set :=
  matDiagonal(R, n, constantFunction(n, Ring.carrier(R), Ring.one(R)))

def matScalar (R n a : Set) : Set :=
  matDiagonal(R, n, constantFunction(n, Ring.carrier(R), a))

def matDiag (R n A : Set) : Set :=
  { q ∈ n × Ring.carrier(R) | ∃ i ∈ n, q = (i, A[i, i]) }

def matTrace (R n A : Set) : Set :=
  finiteRingSum(n, Ring.carrier(R), Ring.add(R), Ring.zero(R), Ring.neg(R),
    Ring.mul(R), Ring.one(R), matDiag(R, n, A))

def matSingle (R m n i j a : Set) : Set :=
  { q ∈ (m × n) × Ring.carrier(R) | ∃ k ∈ m, ∃ l ∈ n,
    ((k = i ∧ l = j) ∧ q = ((k, l), a)) ∨
    (¬(k = i ∧ l = j) ∧ q = ((k, l), Ring.zero(R))) }

-- Column j replaced by c (Matrix.updateCol), and the matrix whose
-- columns all equal v (Matrix.replicateCol, with one column index).
def updateColumn (R m n A j c : Set) : Set :=
  { q ∈ (m × n) × Ring.carrier(R) | ∃ i ∈ m, ∃ k ∈ n,
    (k = j ∧ q = ((i, k), c(i))) ∨ (k ≠ j ∧ q = ((i, k), A[i, k])) }

def replicateColumn (R m n v : Set) : Set :=
  { q ∈ (m × n) × Ring.carrier(R) | ∃ i ∈ m, ∃ k ∈ n, q = ((i, k), v(i)) }

-- The entrywise image f(A) under a map f : R → S (Matrix.map).
def matMap (S m n f A : Set) : Set :=
  { q ∈ (m × n) × Ring.carrier(S) | ∃ i ∈ m, ∃ j ∈ n, q = ((i, j), f(A[i, j])) }

-- The submatrix (i, j) ↦ A[f(i), g(j)] for f : m2 → m, g : n2 → n
-- (Matrix.submatrix; Matrix.reindex when f and g are bijections).
def submatrix (R m2 n2 A f g : Set) : Set :=
  { q ∈ (m2 × n2) × Ring.carrier(R) | ∃ i ∈ m2, ∃ j ∈ n2,
    q = ((i, j), A[f(i), g(j)]) }

-- Section: Block matrices
-- The block matrix [A B; C D] on (m1 ⊎ m2) × (n1 ⊎ n2) (Matrix.fromBlocks),
-- the stacked rows [A; C] (Matrix.fromRows), the columns side by side
-- [A B] (Matrix.fromCols), and the inclusions of the summands, through
-- which submatrix gives the blocks back (Matrix.toBlocks₁₁, …).
def fromBlocks (R m1 m2 n1 n2 A B C D : Set) : Set :=
  { q ∈ ((m1 ⊎ m2) × (n1 ⊎ n2)) × Ring.carrier(R) |
    (∃ i ∈ m1, ∃ j ∈ n1, q = ((inl(i), inl(j)), A[i, j])) ∨
    (∃ i ∈ m1, ∃ j ∈ n2, q = ((inl(i), inr(j)), B[i, j])) ∨
    (∃ i ∈ m2, ∃ j ∈ n1, q = ((inr(i), inl(j)), C[i, j])) ∨
    (∃ i ∈ m2, ∃ j ∈ n2, q = ((inr(i), inr(j)), D[i, j])) }

def fromRows (R m1 m2 n A C : Set) : Set :=
  { q ∈ ((m1 ⊎ m2) × n) × Ring.carrier(R) |
    (∃ i ∈ m1, ∃ j ∈ n, q = ((inl(i), j), A[i, j])) ∨
    (∃ i ∈ m2, ∃ j ∈ n, q = ((inr(i), j), C[i, j])) }

def fromCols (R m n1 n2 A B : Set) : Set :=
  { q ∈ (m × (n1 ⊎ n2)) × Ring.carrier(R) |
    (∃ i ∈ m, ∃ j ∈ n1, q = ((i, inl(j)), A[i, j])) ∨
    (∃ i ∈ m, ∃ j ∈ n2, q = ((i, inr(j)), B[i, j])) }

-- The vector on m1 ⊎ m2 with parts v and w (Sum.elim v w).
def vecAppend (R m1 m2 v w : Set) : Set :=
  { q ∈ (m1 ⊎ m2) × Ring.carrier(R) |
    (∃ i ∈ m1, q = (inl(i), v(i))) ∨ (∃ i ∈ m2, q = (inr(i), w(i))) }

def leftInclusion (A B : Set) : Set :=
  { p ∈ A × (A ⊎ B) | ∃ x ∈ A, p = (x, inl(x)) }

def rightInclusion (A B : Set) : Set :=
  { p ∈ B × (A ⊎ B) | ∃ y ∈ B, p = (y, inr(y)) }

-- Block-triangular for a block map b : n → T and a strict order lt on T:
-- A[i, j] = 0 whenever b(j) < b(i) (Matrix.BlockTriangular).
predicate BlockTriangular (R n A b lt : Set) :=
  ∀ i ∈ n, ∀ j ∈ n, (b(j), b(i)) ∈ lt → A[i, j] = Ring.zero(R)

-- Diagonal and hermitian matrices (Matrix.IsDiag, Matrix.IsHermitian).
predicate IsDiagonalMatrix (R n A : Set) :=
  ∀ i ∈ n, ∀ j ∈ n, i ≠ j → A[i, j] = Ring.zero(R)

predicate IsHermitianMatrix (R σ n A : Set) := conjTranspose(R, σ, n, n, A) = A

-- Section: The ring of square matrices and the matrix module
-- The binary operations of the square matrices on a finite set n, and the
-- ring Mₙ(R) they form (Mathlib's Matrix n n R with its ring structure).
def matAddition (R n : Set) : Set :=
  { q ∈ (matrixSpace(R, n, n) × matrixSpace(R, n, n)) × matrixSpace(R, n, n) |
    ∃ A ∈ matrixSpace(R, n, n), ∃ B ∈ matrixSpace(R, n, n),
      q = ((A, B), matAdd(R, n, n, A, B)) }

def matNegation (R n : Set) : Set :=
  { q ∈ matrixSpace(R, n, n) × matrixSpace(R, n, n) |
    ∃ A ∈ matrixSpace(R, n, n), q = (A, matNeg(R, n, n, A)) }

def matMultiplication (R n : Set) : Set :=
  { q ∈ (matrixSpace(R, n, n) × matrixSpace(R, n, n)) × matrixSpace(R, n, n) |
    ∃ A ∈ matrixSpace(R, n, n), ∃ B ∈ matrixSpace(R, n, n),
      q = ((A, B), matMul(R, n, n, n, A, B)) }

def squareMatrixRing (R n : Set) : Set :=
  Ring.mk(matrixSpace(R, n, n), matAddition(R, n), matZero(R, n, n),
    matNegation(R, n), matMultiplication(R, n), matOne(R, n))

-- The R-module of m × n matrices (Matrix.module), Rᵐˣⁿ.
def matrixModule (R m n : Set) : Set := coordinateModule(R, m × n)

-- A matrix as the linear map v ↦ A v, Rⁿ → Rᵐ (Matrix.toLin', mulVecLin).
def mulVecMap (R m n A : Set) : Set :=
  { q ∈ functionSpace(n, Ring.carrier(R)) × functionSpace(m, Ring.carrier(R)) |
    ∃ v ∈ functionSpace(n, Ring.carrier(R)), q = (v, mulVec(R, m, n, A, v)) }

-- The matrix of a linear map f : M → N in finite bases b of M (indexed by
-- I) and c of N (indexed by J): column i holds the coordinates of f(b(i))
-- (LinearMap.toMatrix b c f), a J × I matrix.
def linearToMatrix (M R N I b J c f : Set) : Set :=
  { q ∈ (J × I) × Ring.carrier(R) | ∃ j ∈ J, ∃ i ∈ I,
    q = ((j, i), basisCoordinates(N, R, J, c, f(b(i)))(j)) }

-- Section: Graph laws of the matrix operations
-- Each operation defined entrywise is a function, with the displayed entries.
theorem matAdd.graph_relates (R m n A B i j : Set)
  requires rowIn : i ∈ m
  requires colIn : j ∈ n
  requires valueIn : call2(Ring.add(R), A((i, j)), B((i, j))) ∈ Ring.carrier(R)
  shows relates(matAdd(R, m, n, A, B), (i, j), call2(Ring.add(R), A((i, j)), B((i, j))))
proof
  have pairIn := product.pair at i, j, m, n with rowIn, colIn
  have outer := product.pair at (i, j), call2(Ring.add(R), A((i, j)), B((i, j))), m × n, Ring.carrier(R) with pairIn, valueIn
  unfold relates
  apply matAdd.membership.backward
  exact ⟨outer, i, rowIn, j, colIn, rfl⟩

theorem matAdd.graph_function (R m n A B : Set)
  requires values : ∀ i ∈ m, ∀ j ∈ n, call2(Ring.add(R), A((i, j)), B((i, j))) ∈ Ring.carrier(R)
  shows matAdd(R, m, n, A, B) : m × n → Ring.carrier(R)
proof
  constructor
    intros q0 member
    obtain ⟨bounded, witnesses⟩ := matAdd.membership.forward with member
    exact bounded
  . constructor
      intros z0 first xFirst second xSecond
      unfold relates at xFirst
      obtain ⟨_, a1, a1In, b1, b1In, firstShape⟩ := matAdd.membership.forward with xFirst
      unfold relates at xSecond
      obtain ⟨_, a2, a2In, b2, b2In, secondShape⟩ := matAdd.membership.forward with xSecond
      obtain ⟨xi, firstEqual⟩ := orderedPair.injective with firstShape
      obtain ⟨xj, secondEqual⟩ := orderedPair.injective with secondShape
      rw xi at xj
      obtain ⟨aa, bb⟩ := orderedPair.injective with xj
      rw [firstEqual, secondEqual]
      cc
    . intros q0 pIn
      obtain ⟨bound, i, rowIn, j, colIn, shape⟩ := product.membership.forward with pIn
      have valueIn := values with i, rowIn, j, colIn
      have mapped := matAdd.graph_relates at R, m, n, A, B, i, j with rowIn, colIn, valueIn
      rw shape
      exact ⟨call2(Ring.add(R), A((i, j)), B((i, j))), valueIn, mapped⟩

theorem matAdd.graph_entry (R m n A B i j : Set)
  requires values : ∀ i ∈ m, ∀ j ∈ n, call2(Ring.add(R), A((i, j)), B((i, j))) ∈ Ring.carrier(R)
  requires rowIn : i ∈ m
  requires colIn : j ∈ n
  shows matAdd(R, m, n, A, B)((i, j)) = call2(Ring.add(R), A((i, j)), B((i, j)))
proof
  have function := matAdd.graph_function at R, m, n, A, B with values
  have valueIn := values with i, rowIn, j, colIn
  have mapped := matAdd.graph_relates at R, m, n, A, B, i, j with rowIn, colIn, valueIn
  have pairIn := product.pair at i, j, m, n with rowIn, colIn
  exact FunctionBetween.apply_value with function, pairIn, mapped

theorem matNeg.graph_relates (R m n A i j : Set)
  requires rowIn : i ∈ m
  requires colIn : j ∈ n
  requires valueIn : apply(Ring.neg(R), A((i, j))) ∈ Ring.carrier(R)
  shows relates(matNeg(R, m, n, A), (i, j), apply(Ring.neg(R), A((i, j))))
proof
  have pairIn := product.pair at i, j, m, n with rowIn, colIn
  have outer := product.pair at (i, j), apply(Ring.neg(R), A((i, j))), m × n, Ring.carrier(R) with pairIn, valueIn
  unfold relates
  apply matNeg.membership.backward
  exact ⟨outer, i, rowIn, j, colIn, rfl⟩

theorem matNeg.graph_function (R m n A : Set)
  requires values : ∀ i ∈ m, ∀ j ∈ n, apply(Ring.neg(R), A((i, j))) ∈ Ring.carrier(R)
  shows matNeg(R, m, n, A) : m × n → Ring.carrier(R)
proof
  constructor
    intros q0 member
    obtain ⟨bounded, witnesses⟩ := matNeg.membership.forward with member
    exact bounded
  . constructor
      intros z0 first xFirst second xSecond
      unfold relates at xFirst
      obtain ⟨_, a1, a1In, b1, b1In, firstShape⟩ := matNeg.membership.forward with xFirst
      unfold relates at xSecond
      obtain ⟨_, a2, a2In, b2, b2In, secondShape⟩ := matNeg.membership.forward with xSecond
      obtain ⟨xi, firstEqual⟩ := orderedPair.injective with firstShape
      obtain ⟨xj, secondEqual⟩ := orderedPair.injective with secondShape
      rw xi at xj
      obtain ⟨aa, bb⟩ := orderedPair.injective with xj
      rw [firstEqual, secondEqual]
      cc
    . intros q0 pIn
      obtain ⟨bound, i, rowIn, j, colIn, shape⟩ := product.membership.forward with pIn
      have valueIn := values with i, rowIn, j, colIn
      have mapped := matNeg.graph_relates at R, m, n, A, i, j with rowIn, colIn, valueIn
      rw shape
      exact ⟨apply(Ring.neg(R), A((i, j))), valueIn, mapped⟩

theorem matNeg.graph_entry (R m n A i j : Set)
  requires values : ∀ i ∈ m, ∀ j ∈ n, apply(Ring.neg(R), A((i, j))) ∈ Ring.carrier(R)
  requires rowIn : i ∈ m
  requires colIn : j ∈ n
  shows matNeg(R, m, n, A)((i, j)) = apply(Ring.neg(R), A((i, j)))
proof
  have function := matNeg.graph_function at R, m, n, A with values
  have valueIn := values with i, rowIn, j, colIn
  have mapped := matNeg.graph_relates at R, m, n, A, i, j with rowIn, colIn, valueIn
  have pairIn := product.pair at i, j, m, n with rowIn, colIn
  exact FunctionBetween.apply_value with function, pairIn, mapped

theorem matSmul.graph_relates (R m n a A i j : Set)
  requires rowIn : i ∈ m
  requires colIn : j ∈ n
  requires valueIn : call2(Ring.mul(R), a, A((i, j))) ∈ Ring.carrier(R)
  shows relates(matSmul(R, m, n, a, A), (i, j), call2(Ring.mul(R), a, A((i, j))))
proof
  have pairIn := product.pair at i, j, m, n with rowIn, colIn
  have outer := product.pair at (i, j), call2(Ring.mul(R), a, A((i, j))), m × n, Ring.carrier(R) with pairIn, valueIn
  unfold relates
  apply matSmul.membership.backward
  exact ⟨outer, i, rowIn, j, colIn, rfl⟩

theorem matSmul.graph_function (R m n a A : Set)
  requires values : ∀ i ∈ m, ∀ j ∈ n, call2(Ring.mul(R), a, A((i, j))) ∈ Ring.carrier(R)
  shows matSmul(R, m, n, a, A) : m × n → Ring.carrier(R)
proof
  constructor
    intros q0 member
    obtain ⟨bounded, witnesses⟩ := matSmul.membership.forward with member
    exact bounded
  . constructor
      intros z0 first xFirst second xSecond
      unfold relates at xFirst
      obtain ⟨_, a1, a1In, b1, b1In, firstShape⟩ := matSmul.membership.forward with xFirst
      unfold relates at xSecond
      obtain ⟨_, a2, a2In, b2, b2In, secondShape⟩ := matSmul.membership.forward with xSecond
      obtain ⟨xi, firstEqual⟩ := orderedPair.injective with firstShape
      obtain ⟨xj, secondEqual⟩ := orderedPair.injective with secondShape
      rw xi at xj
      obtain ⟨aa, bb⟩ := orderedPair.injective with xj
      rw [firstEqual, secondEqual]
      cc
    . intros q0 pIn
      obtain ⟨bound, i, rowIn, j, colIn, shape⟩ := product.membership.forward with pIn
      have valueIn := values with i, rowIn, j, colIn
      have mapped := matSmul.graph_relates at R, m, n, a, A, i, j with rowIn, colIn, valueIn
      rw shape
      exact ⟨call2(Ring.mul(R), a, A((i, j))), valueIn, mapped⟩

theorem matSmul.graph_entry (R m n a A i j : Set)
  requires values : ∀ i ∈ m, ∀ j ∈ n, call2(Ring.mul(R), a, A((i, j))) ∈ Ring.carrier(R)
  requires rowIn : i ∈ m
  requires colIn : j ∈ n
  shows matSmul(R, m, n, a, A)((i, j)) = call2(Ring.mul(R), a, A((i, j)))
proof
  have function := matSmul.graph_function at R, m, n, a, A with values
  have valueIn := values with i, rowIn, j, colIn
  have mapped := matSmul.graph_relates at R, m, n, a, A, i, j with rowIn, colIn, valueIn
  have pairIn := product.pair at i, j, m, n with rowIn, colIn
  exact FunctionBetween.apply_value with function, pairIn, mapped

theorem vecDotTerms.graph_relates (R n v w j : Set)
  requires index : j ∈ n
  requires valueIn : call2(Ring.mul(R), v(j), w(j)) ∈ Ring.carrier(R)
  shows relates(vecDotTerms(R, n, v, w), j, call2(Ring.mul(R), v(j), w(j)))
proof
  unfold relates
  apply vecDotTerms.membership.backward
  refine ⟨(product.pair at j, call2(Ring.mul(R), v(j), w(j)), n, Ring.carrier(R) with index, valueIn), j, index, rfl⟩

theorem vecDotTerms.graph_function (R n v w : Set)
  requires values : ∀ j ∈ n, call2(Ring.mul(R), v(j), w(j)) ∈ Ring.carrier(R)
  shows vecDotTerms(R, n, v, w) : n → Ring.carrier(R)
proof
  constructor
    intros q0 member
    obtain ⟨bounded, witnesses⟩ := vecDotTerms.membership.forward with member
    exact bounded
  . constructor
      intros z0 first xFirst second xSecond
      unfold relates at xFirst
      obtain ⟨_, a1, a1In, firstShape⟩ := vecDotTerms.membership.forward with xFirst
      unfold relates at xSecond
      obtain ⟨_, a2, a2In, secondShape⟩ := vecDotTerms.membership.forward with xSecond
      obtain ⟨xi, firstEqual⟩ := orderedPair.injective with firstShape
      obtain ⟨xj, secondEqual⟩ := orderedPair.injective with secondShape
      rw [firstEqual, secondEqual]
      cc
    . intros j xIn
      have valueIn := values with j, xIn
      refine ⟨call2(Ring.mul(R), v(j), w(j)), valueIn, (vecDotTerms.graph_relates at R, n, v, w, j with xIn, valueIn)⟩

theorem vecDotTerms.graph_apply (R n v w j : Set)
  requires values : ∀ j ∈ n, call2(Ring.mul(R), v(j), w(j)) ∈ Ring.carrier(R)
  requires index : j ∈ n
  shows vecDotTerms(R, n, v, w)(j) = call2(Ring.mul(R), v(j), w(j))
proof
  have function := vecDotTerms.graph_function at R, n, v, w with values
  have valueIn := values with j, index
