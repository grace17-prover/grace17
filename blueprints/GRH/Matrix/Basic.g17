  have valueIn := values with j, rowIn, i, colIn
  have mapped := linearToMatrix.graph_relates at M, R, N, I, b, J, c, f, j, i with rowIn, colIn, valueIn
  have pairIn := product.pair at j, i, J, I with rowIn, colIn
  exact FunctionBetween.apply_value with function, pairIn, mapped

-- Section: First helpers on matrices
theorem matrixSpace.eq (R m n : Set)
  shows matrixSpace(R, m, n) = functionSpace(m × n, Ring.carrier(R))
proof
  unfold matrixSpace
  rfl

theorem matrixSpace.of_function (R m n A : Set)
  requires function : A : m × n → Ring.carrier(R)
  shows A ∈ matrixSpace(R, m, n)
proof
  rw matrixSpace.eq
  exact functionSpace.mem_iff.backward with function

theorem matrixSpace.function (R m n A : Set)
  requires matrix : A ∈ matrixSpace(R, m, n)
  shows A : m × n → Ring.carrier(R)
proof
  rw matrixSpace.eq at matrix
  exact functionSpace.mem_iff.forward with matrix

theorem matrixSpace.entry_mem (R m n A i j : Set)
  requires matrix : A ∈ matrixSpace(R, m, n)
  requires row : i ∈ m
  requires column : j ∈ n
  shows A((i, j)) ∈ Ring.carrier(R)
proof
  have function := matrixSpace.function with matrix
  have pair := product.pair at i, j, m, n with row, column
  exact FunctionBetween.apply_closed with function, pair

-- The diagonal matrix as a function, and its entries.
theorem matDiagonal.graph_function (R n d : Set)
  requires ring : Ring(R)
  requires vector : d ∈ functionSpace(n, Ring.carrier(R))
  shows matDiagonal(R, n, d) : n × n → Ring.carrier(R)
proof
  have zeroIn := Ring.zero_mem at R with ring
  constructor
    intros q0 member
    obtain ⟨bounded, rest⟩ := matDiagonal.membership.forward with member
    exact bounded
  . constructor
      intros z0 first r1 second r2
      unfold relates at r1
      unfold relates at r2
      obtain ⟨_, i1, hi1, j1, hj1, c1⟩ := matDiagonal.membership.forward with r1
      obtain ⟨_, i2, hi2, j2, hj2, c2⟩ := matDiagonal.membership.forward with r2
      cases c1 with d1 | o1
      . obtain ⟨e1, s1⟩ := d1
        obtain ⟨z1, f1⟩ := orderedPair.injective with s1
        cases c2 with d2 | o2
        . obtain ⟨e2, s2⟩ := d2
          obtain ⟨z2, f2⟩ := orderedPair.injective with s2
          rw z1 at z2
          obtain ⟨ii, jj⟩ := orderedPair.injective with z2
          rw [f1, f2, ii]
        . obtain ⟨e2, s2⟩ := o2
          obtain ⟨z2, f2⟩ := orderedPair.injective with s2
          rw z1 at z2
          obtain ⟨ii, jj⟩ := orderedPair.injective with z2
          exfalso
          have same : i2 = j2 by cc
          exact e2 with same
      . obtain ⟨e1, s1⟩ := o1
        obtain ⟨z1, f1⟩ := orderedPair.injective with s1
        cases c2 with d2 | o2
        . obtain ⟨e2, s2⟩ := d2
          obtain ⟨z2, f2⟩ := orderedPair.injective with s2
          rw z1 at z2
          obtain ⟨ii, jj⟩ := orderedPair.injective with z2
          exfalso
          have same : i1 = j1 by cc
          exact e1 with same
        . obtain ⟨e2, s2⟩ := o2
          obtain ⟨z2, f2⟩ := orderedPair.injective with s2
          rw [f1, f2]
    . intros q0 pIn
      obtain ⟨bound, i, hi, j, hj, shape⟩ := product.membership.forward with pIn
      rw shape
      have pairIn := product.pair at i, j, n, n with hi, hj
      by_cases same : i = j
      . have di := functionSpace.apply_mem with vector, hi
        have outer := product.pair at (i, j), d(i), n × n, Ring.carrier(R) with pairIn, di
        refine ⟨d(i), di, ?_⟩
        unfold relates
        apply matDiagonal.membership.backward
        refine ⟨outer, i, hi, j, hj, ?_⟩
        left
        exact ⟨same, rfl⟩
      . have outer := product.pair at (i, j), Ring.zero(R), n × n, Ring.carrier(R) with pairIn, zeroIn
        refine ⟨Ring.zero(R), zeroIn, ?_⟩
        unfold relates
        apply matDiagonal.membership.backward
        refine ⟨outer, i, hi, j, hj, ?_⟩
        right
        exact ⟨same, rfl⟩

theorem matDiagonal.entry_of (R n d i j : Set)
  requires ring : Ring(R)
  requires vector : d ∈ functionSpace(n, Ring.carrier(R))
  requires row : i ∈ n
  requires column : j ∈ n
  shows (i = j → matDiagonal(R, n, d)((i, j)) = d(i)) ∧
    (i ≠ j → matDiagonal(R, n, d)((i, j)) = Ring.zero(R))
proof
  have function := matDiagonal.graph_function with ring, vector
  have zeroIn := Ring.zero_mem at R with ring
  have pairIn := product.pair at i, j, n, n with row, column
  constructor
  . intro same
    have di := functionSpace.apply_mem with vector, row
    have outer := product.pair at (i, j), d(i), n × n, Ring.carrier(R) with pairIn, di
    have mapped : relates(matDiagonal(R, n, d), (i, j), d(i))
      unfold relates
      apply matDiagonal.membership.backward
      refine ⟨outer, i, row, j, column, ?_⟩
      left
      exact ⟨same, rfl⟩
    exact FunctionBetween.apply_value with function, pairIn, mapped
  . intro other
    have outer := product.pair at (i, j), Ring.zero(R), n × n, Ring.carrier(R) with pairIn, zeroIn
    have mapped : relates(matDiagonal(R, n, d), (i, j), Ring.zero(R))
      unfold relates
      apply matDiagonal.membership.backward
      refine ⟨outer, i, row, j, column, ?_⟩
      right
      exact ⟨other, rfl⟩
    exact FunctionBetween.apply_value with function, pairIn, mapped

-- The conjugate transpose as a function, and its entries.
theorem conjTranspose.graph_function (R σ m n A : Set)
  requires values : ∀ i ∈ m, ∀ j ∈ n, σ(A((i, j))) ∈ Ring.carrier(R)
  shows conjTranspose(R, σ, m, n, A) : n × m → Ring.carrier(R)
proof
  constructor
    intros q0 member
    obtain ⟨bounded, rest⟩ := conjTranspose.membership.forward with member
    exact bounded
  . constructor
      intros z0 first r1 second r2
      unfold relates at r1
      unfold relates at r2
      obtain ⟨_, i1, hi1, j1, hj1, s1⟩ := conjTranspose.membership.forward with r1
      obtain ⟨_, i2, hi2, j2, hj2, s2⟩ := conjTranspose.membership.forward with r2
      obtain ⟨z1, f1⟩ := orderedPair.injective with s1
      obtain ⟨z2, f2⟩ := orderedPair.injective with s2
      rw z1 at z2
      obtain ⟨jj, ii⟩ := orderedPair.injective with z2
      rw [f1, f2, ii, jj]
    . intros q0 pIn
      obtain ⟨bound, j, hj, i, hi, shape⟩ := product.membership.forward with pIn
      rw shape
      have valueIn := values with i, hi, j, hj
      have pairIn := product.pair at j, i, n, m with hj, hi
      have outer := product.pair at (j, i), σ(A((i, j))), n × m, Ring.carrier(R) with pairIn, valueIn
      refine ⟨σ(A((i, j))), valueIn, ?_⟩
      unfold relates
      apply conjTranspose.membership.backward
      exact ⟨outer, i, hi, j, hj, rfl⟩

theorem conjTranspose.entry_of (R σ m n A i j : Set)
  requires values : ∀ i ∈ m, ∀ j ∈ n, σ(A((i, j))) ∈ Ring.carrier(R)
  requires row : i ∈ m
  requires column : j ∈ n
  shows conjTranspose(R, σ, m, n, A)((j, i)) = σ(A((i, j)))
proof
  have function := conjTranspose.graph_function with values
  have valueIn := values with i, row, j, column
  have pairIn := product.pair at j, i, n, m with column, row
  have outer := product.pair at (j, i), σ(A((i, j))), n × m, Ring.carrier(R) with pairIn, valueIn
  have mapped : relates(conjTranspose(R, σ, m, n, A), (j, i), σ(A((i, j))))
    unfold relates
    apply conjTranspose.membership.backward
    exact ⟨outer, i, row, j, column, rfl⟩
  exact FunctionBetween.apply_value with function, pairIn, mapped

-- The block matrix as a function, and its four blocks of entries.
theorem fromBlocks.graph_function (R m1 m2 n1 n2 A B C D : Set)
  requires values0 : ∀ i ∈ m1, ∀ j ∈ n1, A((i, j)) ∈ Ring.carrier(R)
  requires values1 : ∀ i ∈ m1, ∀ j ∈ n2, B((i, j)) ∈ Ring.carrier(R)
  requires values2 : ∀ i ∈ m2, ∀ j ∈ n1, C((i, j)) ∈ Ring.carrier(R)
  requires values3 : ∀ i ∈ m2, ∀ j ∈ n2, D((i, j)) ∈ Ring.carrier(R)
  shows fromBlocks(R, m1, m2, n1, n2, A, B, C, D) : (m1 ⊎ m2) × (n1 ⊎ n2) → Ring.carrier(R)
proof
  constructor
    intros q0 member
    obtain ⟨bounded, rest⟩ := fromBlocks.membership.forward with member
    exact bounded
  . constructor
      intros z0 first r1 second r2
      unfold relates at r1
      unfold relates at r2
      obtain ⟨_, c1⟩ := fromBlocks.membership.forward with r1
      obtain ⟨_, c2⟩ := fromBlocks.membership.forward with r2
      cases c1 with a10 | b10
      . obtain ⟨i1, hi1, j1, hj1, s1⟩ := a10
        cases c2 with a20 | b20
        . obtain ⟨i2, hi2, j2, hj2, s2⟩ := a20
          obtain ⟨z1, f1⟩ := orderedPair.injective with s1
          obtain ⟨z2, f2⟩ := orderedPair.injective with s2
          rw z1 at z2
          obtain ⟨kr, kc⟩ := orderedPair.injective with z2
          have ii := inl.injective at i1, i2 with kr
          have jj := inl.injective at j1, j2 with kc
          rw [f1, f2, ii, jj]
        . cases b20 with a21 | b21
          . obtain ⟨i2, hi2, j2, hj2, s2⟩ := a21
            obtain ⟨z1, f1⟩ := orderedPair.injective with s1
            obtain ⟨z2, f2⟩ := orderedPair.injective with s2
            rw z1 at z2
            obtain ⟨kr, kc⟩ := orderedPair.injective with z2
            have ii := inl.injective at i1, i2 with kr
            exfalso
            exact (tags.disjoint at j1, j2) with kc
          . cases b21 with a22 | b22
            . obtain ⟨i2, hi2, j2, hj2, s2⟩ := a22
              obtain ⟨z1, f1⟩ := orderedPair.injective with s1
              obtain ⟨z2, f2⟩ := orderedPair.injective with s2
              rw z1 at z2
              obtain ⟨kr, kc⟩ := orderedPair.injective with z2
              exfalso
              exact (tags.disjoint at i1, i2) with kr
            . obtain ⟨i2, hi2, j2, hj2, s2⟩ := b22
              obtain ⟨z1, f1⟩ := orderedPair.injective with s1
              obtain ⟨z2, f2⟩ := orderedPair.injective with s2
              rw z1 at z2
              obtain ⟨kr, kc⟩ := orderedPair.injective with z2
              exfalso
              exact (tags.disjoint at i1, i2) with kr
      . cases b10 with a11 | b11
        . obtain ⟨i1, hi1, j1, hj1, s1⟩ := a11
          cases c2 with a20 | b20
          . obtain ⟨i2, hi2, j2, hj2, s2⟩ := a20
            obtain ⟨z1, f1⟩ := orderedPair.injective with s1
            obtain ⟨z2, f2⟩ := orderedPair.injective with s2
            rw z1 at z2
            obtain ⟨kr, kc⟩ := orderedPair.injective with z2
            have ii := inl.injective at i1, i2 with kr
            exfalso
            have back : inl(j2) = inr(j1)
              symm
              exact kc
            exact (tags.disjoint at j2, j1) with back
          . cases b20 with a21 | b21
            . obtain ⟨i2, hi2, j2, hj2, s2⟩ := a21
              obtain ⟨z1, f1⟩ := orderedPair.injective with s1
              obtain ⟨z2, f2⟩ := orderedPair.injective with s2
              rw z1 at z2
              obtain ⟨kr, kc⟩ := orderedPair.injective with z2
              have ii := inl.injective at i1, i2 with kr
              have jj := inr.injective at j1, j2 with kc
              rw [f1, f2, ii, jj]
            . cases b21 with a22 | b22
              . obtain ⟨i2, hi2, j2, hj2, s2⟩ := a22
                obtain ⟨z1, f1⟩ := orderedPair.injective with s1
                obtain ⟨z2, f2⟩ := orderedPair.injective with s2
                rw z1 at z2
                obtain ⟨kr, kc⟩ := orderedPair.injective with z2
                exfalso
                exact (tags.disjoint at i1, i2) with kr
              . obtain ⟨i2, hi2, j2, hj2, s2⟩ := b22
                obtain ⟨z1, f1⟩ := orderedPair.injective with s1
                obtain ⟨z2, f2⟩ := orderedPair.injective with s2
                rw z1 at z2
                obtain ⟨kr, kc⟩ := orderedPair.injective with z2
                exfalso
                exact (tags.disjoint at i1, i2) with kr
        . cases b11 with a12 | b12
          . obtain ⟨i1, hi1, j1, hj1, s1⟩ := a12
            cases c2 with a20 | b20
            . obtain ⟨i2, hi2, j2, hj2, s2⟩ := a20
              obtain ⟨z1, f1⟩ := orderedPair.injective with s1
              obtain ⟨z2, f2⟩ := orderedPair.injective with s2
              rw z1 at z2
              obtain ⟨kr, kc⟩ := orderedPair.injective with z2
              exfalso
              have back : inl(i2) = inr(i1)
                symm
                exact kr
              exact (tags.disjoint at i2, i1) with back
            . cases b20 with a21 | b21
              . obtain ⟨i2, hi2, j2, hj2, s2⟩ := a21
                obtain ⟨z1, f1⟩ := orderedPair.injective with s1
                obtain ⟨z2, f2⟩ := orderedPair.injective with s2
                rw z1 at z2
                obtain ⟨kr, kc⟩ := orderedPair.injective with z2
                exfalso
                have back : inl(i2) = inr(i1)
                  symm
                  exact kr
                exact (tags.disjoint at i2, i1) with back
              . cases b21 with a22 | b22
                . obtain ⟨i2, hi2, j2, hj2, s2⟩ := a22
                  obtain ⟨z1, f1⟩ := orderedPair.injective with s1
                  obtain ⟨z2, f2⟩ := orderedPair.injective with s2
                  rw z1 at z2
                  obtain ⟨kr, kc⟩ := orderedPair.injective with z2
                  have ii := inr.injective at i1, i2 with kr
                  have jj := inl.injective at j1, j2 with kc
                  rw [f1, f2, ii, jj]
                . obtain ⟨i2, hi2, j2, hj2, s2⟩ := b22
                  obtain ⟨z1, f1⟩ := orderedPair.injective with s1
                  obtain ⟨z2, f2⟩ := orderedPair.injective with s2
                  rw z1 at z2
                  obtain ⟨kr, kc⟩ := orderedPair.injective with z2
                  have ii := inr.injective at i1, i2 with kr
                  exfalso
                  exact (tags.disjoint at j1, j2) with kc
          . obtain ⟨i1, hi1, j1, hj1, s1⟩ := b12
            cases c2 with a20 | b20
            . obtain ⟨i2, hi2, j2, hj2, s2⟩ := a20
              obtain ⟨z1, f1⟩ := orderedPair.injective with s1
              obtain ⟨z2, f2⟩ := orderedPair.injective with s2
              rw z1 at z2
              obtain ⟨kr, kc⟩ := orderedPair.injective with z2
              exfalso
              have back : inl(i2) = inr(i1)
                symm
                exact kr
              exact (tags.disjoint at i2, i1) with back
            . cases b20 with a21 | b21
              . obtain ⟨i2, hi2, j2, hj2, s2⟩ := a21
                obtain ⟨z1, f1⟩ := orderedPair.injective with s1
                obtain ⟨z2, f2⟩ := orderedPair.injective with s2
                rw z1 at z2
                obtain ⟨kr, kc⟩ := orderedPair.injective with z2
                exfalso
                have back : inl(i2) = inr(i1)
                  symm
                  exact kr
                exact (tags.disjoint at i2, i1) with back
              . cases b21 with a22 | b22
                . obtain ⟨i2, hi2, j2, hj2, s2⟩ := a22
                  obtain ⟨z1, f1⟩ := orderedPair.injective with s1
                  obtain ⟨z2, f2⟩ := orderedPair.injective with s2
                  rw z1 at z2
                  obtain ⟨kr, kc⟩ := orderedPair.injective with z2
                  have ii := inr.injective at i1, i2 with kr
                  exfalso
                  have back : inl(j2) = inr(j1)
                    symm
                    exact kc
                  exact (tags.disjoint at j2, j1) with back
                . obtain ⟨i2, hi2, j2, hj2, s2⟩ := b22
                  obtain ⟨z1, f1⟩ := orderedPair.injective with s1
                  obtain ⟨z2, f2⟩ := orderedPair.injective with s2
                  rw z1 at z2
                  obtain ⟨kr, kc⟩ := orderedPair.injective with z2
                  have ii := inr.injective at i1, i2 with kr
                  have jj := inr.injective at j1, j2 with kc
                  rw [f1, f2, ii, jj]
    . intros q0 pIn
      obtain ⟨bound, x, hx, y, hy, shape⟩ := product.membership.forward with pIn
      rw shape
      have sx := disjointSum.membership.forward with hx
      have sy := disjointSum.membership.forward with hy
      cases sx with lx | rx
      . obtain ⟨i, hi, xShape⟩ := lx
        cases sy with ly | ry
        . obtain ⟨j, hj, yShape⟩ := ly
          rw [xShape, yShape]
          have valueIn := values0 with i, hi, j, hj
          have xIn := disjointSum.left at i, m1, m2 with hi
          have yIn := disjointSum.left at j, n1, n2 with hj
          have pairIn := product.pair at inl(i), inl(j), (m1 ⊎ m2), (n1 ⊎ n2) with xIn, yIn
          have outer := product.pair at (inl(i), inl(j)), A((i, j)), (m1 ⊎ m2) × (n1 ⊎ n2), Ring.carrier(R) with pairIn, valueIn
          refine ⟨A((i, j)), valueIn, ?_⟩
          unfold relates
          apply fromBlocks.membership.backward
          refine ⟨outer, ?_⟩
          left
          exact ⟨i, hi, j, hj, rfl⟩
        . obtain ⟨j, hj, yShape⟩ := ry
          rw [xShape, yShape]
          have valueIn := values1 with i, hi, j, hj
          have xIn := disjointSum.left at i, m1, m2 with hi
          have yIn := disjointSum.right at j, n1, n2 with hj
          have pairIn := product.pair at inl(i), inr(j), (m1 ⊎ m2), (n1 ⊎ n2) with xIn, yIn
          have outer := product.pair at (inl(i), inr(j)), B((i, j)), (m1 ⊎ m2) × (n1 ⊎ n2), Ring.carrier(R) with pairIn, valueIn
          refine ⟨B((i, j)), valueIn, ?_⟩
          unfold relates
          apply fromBlocks.membership.backward
          refine ⟨outer, ?_⟩
          right
          left
          exact ⟨i, hi, j, hj, rfl⟩
      . obtain ⟨i, hi, xShape⟩ := rx
        cases sy with ly | ry
        . obtain ⟨j, hj, yShape⟩ := ly
          rw [xShape, yShape]
          have valueIn := values2 with i, hi, j, hj
          have xIn := disjointSum.right at i, m1, m2 with hi
          have yIn := disjointSum.left at j, n1, n2 with hj
          have pairIn := product.pair at inr(i), inl(j), (m1 ⊎ m2), (n1 ⊎ n2) with xIn, yIn
          have outer := product.pair at (inr(i), inl(j)), C((i, j)), (m1 ⊎ m2) × (n1 ⊎ n2), Ring.carrier(R) with pairIn, valueIn
          refine ⟨C((i, j)), valueIn, ?_⟩
          unfold relates
          apply fromBlocks.membership.backward
          refine ⟨outer, ?_⟩
          right
          right
          left
          exact ⟨i, hi, j, hj, rfl⟩
        . obtain ⟨j, hj, yShape⟩ := ry
          rw [xShape, yShape]
          have valueIn := values3 with i, hi, j, hj
          have xIn := disjointSum.right at i, m1, m2 with hi
          have yIn := disjointSum.right at j, n1, n2 with hj
          have pairIn := product.pair at inr(i), inr(j), (m1 ⊎ m2), (n1 ⊎ n2) with xIn, yIn
          have outer := product.pair at (inr(i), inr(j)), D((i, j)), (m1 ⊎ m2) × (n1 ⊎ n2), Ring.carrier(R) with pairIn, valueIn
          refine ⟨D((i, j)), valueIn, ?_⟩
          unfold relates
          apply fromBlocks.membership.backward
          refine ⟨outer, ?_⟩
          right
          right
          right
          exact ⟨i, hi, j, hj, rfl⟩

theorem fromBlocks.graph_entry0 (R m1 m2 n1 n2 A B C D i j : Set)
  requires values0 : ∀ i ∈ m1, ∀ j ∈ n1, A((i, j)) ∈ Ring.carrier(R)
  requires values1 : ∀ i ∈ m1, ∀ j ∈ n2, B((i, j)) ∈ Ring.carrier(R)
  requires values2 : ∀ i ∈ m2, ∀ j ∈ n1, C((i, j)) ∈ Ring.carrier(R)
  requires values3 : ∀ i ∈ m2, ∀ j ∈ n2, D((i, j)) ∈ Ring.carrier(R)
  requires hi : i ∈ m1
  requires hj : j ∈ n1
  shows fromBlocks(R, m1, m2, n1, n2, A, B, C, D)((inl(i), inl(j))) = A((i, j))
proof
  have function := fromBlocks.graph_function at R, m1, m2, n1, n2, A, B, C, D with *
  have valueIn := values0 with i, hi, j, hj
  have xIn := disjointSum.left at i, m1, m2 with hi
  have yIn := disjointSum.left at j, n1, n2 with hj
  have pairIn := product.pair at inl(i), inl(j), (m1 ⊎ m2), (n1 ⊎ n2) with xIn, yIn
  have outer := product.pair at (inl(i), inl(j)), A((i, j)), (m1 ⊎ m2) × (n1 ⊎ n2), Ring.carrier(R) with pairIn, valueIn
  have mapped : relates(fromBlocks(R, m1, m2, n1, n2, A, B, C, D), (inl(i), inl(j)), A((i, j)))
    unfold relates
    apply fromBlocks.membership.backward
    refine ⟨outer, ?_⟩
    left
    exact ⟨i, hi, j, hj, rfl⟩
  exact FunctionBetween.apply_value with function, pairIn, mapped

theorem fromBlocks.graph_entry1 (R m1 m2 n1 n2 A B C D i j : Set)
  requires values0 : ∀ i ∈ m1, ∀ j ∈ n1, A((i, j)) ∈ Ring.carrier(R)
  requires values1 : ∀ i ∈ m1, ∀ j ∈ n2, B((i, j)) ∈ Ring.carrier(R)
  requires values2 : ∀ i ∈ m2, ∀ j ∈ n1, C((i, j)) ∈ Ring.carrier(R)
  requires values3 : ∀ i ∈ m2, ∀ j ∈ n2, D((i, j)) ∈ Ring.carrier(R)
  requires hi : i ∈ m1
  requires hj : j ∈ n2
  shows fromBlocks(R, m1, m2, n1, n2, A, B, C, D)((inl(i), inr(j))) = B((i, j))
proof
  have function := fromBlocks.graph_function at R, m1, m2, n1, n2, A, B, C, D with *
  have valueIn := values1 with i, hi, j, hj
  have xIn := disjointSum.left at i, m1, m2 with hi
  have yIn := disjointSum.right at j, n1, n2 with hj
  have pairIn := product.pair at inl(i), inr(j), (m1 ⊎ m2), (n1 ⊎ n2) with xIn, yIn
  have outer := product.pair at (inl(i), inr(j)), B((i, j)), (m1 ⊎ m2) × (n1 ⊎ n2), Ring.carrier(R) with pairIn, valueIn
  have mapped : relates(fromBlocks(R, m1, m2, n1, n2, A, B, C, D), (inl(i), inr(j)), B((i, j)))
    unfold relates
    apply fromBlocks.membership.backward
    refine ⟨outer, ?_⟩
    right
    left
    exact ⟨i, hi, j, hj, rfl⟩
  exact FunctionBetween.apply_value with function, pairIn, mapped

theorem fromBlocks.graph_entry2 (R m1 m2 n1 n2 A B C D i j : Set)
  requires values0 : ∀ i ∈ m1, ∀ j ∈ n1, A((i, j)) ∈ Ring.carrier(R)
  requires values1 : ∀ i ∈ m1, ∀ j ∈ n2, B((i, j)) ∈ Ring.carrier(R)
  requires values2 : ∀ i ∈ m2, ∀ j ∈ n1, C((i, j)) ∈ Ring.carrier(R)
