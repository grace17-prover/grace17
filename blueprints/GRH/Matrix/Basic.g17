-- Stacked rows, side-by-side columns, and appended vectors.
theorem fromRows.graph_function (R m1 m2 n A C : Set)
  requires values0 : ∀ i ∈ m1, ∀ j ∈ n, A((i, j)) ∈ Ring.carrier(R)
  requires values1 : ∀ i ∈ m2, ∀ j ∈ n, C((i, j)) ∈ Ring.carrier(R)
  shows fromRows(R, m1, m2, n, A, C) : (m1 ⊎ m2) × n → Ring.carrier(R)
proof
  constructor
    intros q0 member
    obtain ⟨bounded, rest⟩ := fromRows.membership.forward with member
    exact bounded
  . constructor
      intros z0 first r1 second r2
      unfold relates at r1
      unfold relates at r2
      obtain ⟨_, c1⟩ := fromRows.membership.forward with r1
      obtain ⟨_, c2⟩ := fromRows.membership.forward with r2
      cases c1 with a10 | b10
      . obtain ⟨i1, hi1, j1, hj1, s1⟩ := a10
        cases c2 with a20 | b20
        . obtain ⟨i2, hi2, j2, hj2, s2⟩ := a20
          obtain ⟨z1, f1⟩ := orderedPair.injective with s1
          obtain ⟨z2, f2⟩ := orderedPair.injective with s2
          rw z1 at z2
          obtain ⟨kr, kc⟩ := orderedPair.injective with z2
          have ii := inl.injective at i1, i2 with kr
          have jj := kc
          rw [f1, f2, ii, jj]
        . obtain ⟨i2, hi2, j2, hj2, s2⟩ := b20
          obtain ⟨z1, f1⟩ := orderedPair.injective with s1
          obtain ⟨z2, f2⟩ := orderedPair.injective with s2
          rw z1 at z2
          obtain ⟨kr, kc⟩ := orderedPair.injective with z2
          exfalso
          exact (tags.disjoint at i1, i2) with kr
      . obtain ⟨i1, hi1, j1, hj1, s1⟩ := b10
        cases c2 with a20 | b20
        . obtain ⟨i2, hi2, j2, hj2, s2⟩ := a20
          obtain ⟨z1, f1⟩ := orderedPair.injective with s1
          obtain ⟨z2, f2⟩ := orderedPair.injective with s2
          rw z1 at z2
          obtain ⟨kr, kc⟩ := orderedPair.injective with z2
          exfalso
          have back : inl(i2) = inr(i1)
            symm
            exact kr
          exact (tags.disjoint at i2, i1) with back
        . obtain ⟨i2, hi2, j2, hj2, s2⟩ := b20
          obtain ⟨z1, f1⟩ := orderedPair.injective with s1
          obtain ⟨z2, f2⟩ := orderedPair.injective with s2
          rw z1 at z2
          obtain ⟨kr, kc⟩ := orderedPair.injective with z2
          have ii := inr.injective at i1, i2 with kr
          have jj := kc
          rw [f1, f2, ii, jj]
    . intros q0 pIn
      obtain ⟨bound, x, hx, y, hy, shape⟩ := product.membership.forward with pIn
      rw shape
      have sx := disjointSum.membership.forward with hx
      cases sx with lx | rx
      . obtain ⟨i, hi, xShape⟩ := lx
        rw xShape
        have valueIn := values0 with i, hi, y, hy
        have xIn := disjointSum.left at i, m1, m2 with hi
        have yIn := hy
        have pairIn := product.pair at inl(i), y, (m1 ⊎ m2), n with xIn, yIn
        have outer := product.pair at (inl(i), y), A((i, y)), (m1 ⊎ m2) × n, Ring.carrier(R) with pairIn, valueIn
        refine ⟨A((i, y)), valueIn, ?_⟩
        unfold relates
        apply fromRows.membership.backward
        refine ⟨outer, ?_⟩
        left
        exact ⟨i, hi, y, hy, rfl⟩
      . obtain ⟨i, hi, xShape⟩ := rx
        rw xShape
        have valueIn := values1 with i, hi, y, hy
        have xIn := disjointSum.right at i, m1, m2 with hi
        have yIn := hy
        have pairIn := product.pair at inr(i), y, (m1 ⊎ m2), n with xIn, yIn
        have outer := product.pair at (inr(i), y), C((i, y)), (m1 ⊎ m2) × n, Ring.carrier(R) with pairIn, valueIn
        refine ⟨C((i, y)), valueIn, ?_⟩
        unfold relates
        apply fromRows.membership.backward
        refine ⟨outer, ?_⟩
        right
        exact ⟨i, hi, y, hy, rfl⟩

theorem fromRows.graph_entry0 (R m1 m2 n A C i j : Set)
  requires values0 : ∀ i ∈ m1, ∀ j ∈ n, A((i, j)) ∈ Ring.carrier(R)
  requires values1 : ∀ i ∈ m2, ∀ j ∈ n, C((i, j)) ∈ Ring.carrier(R)
  requires hi : i ∈ m1
  requires hj : j ∈ n
  shows fromRows(R, m1, m2, n, A, C)((inl(i), j)) = A((i, j))
proof
  have function := fromRows.graph_function at R, m1, m2, n, A, C with *
  have valueIn := values0 with i, hi, j, hj
  have xIn := disjointSum.left at i, m1, m2 with hi
  have yIn := hj
  have pairIn := product.pair at inl(i), j, (m1 ⊎ m2), n with xIn, yIn
  have outer := product.pair at (inl(i), j), A((i, j)), (m1 ⊎ m2) × n, Ring.carrier(R) with pairIn, valueIn
  have mapped : relates(fromRows(R, m1, m2, n, A, C), (inl(i), j), A((i, j)))
    unfold relates
    apply fromRows.membership.backward
    refine ⟨outer, ?_⟩
    left
    exact ⟨i, hi, j, hj, rfl⟩
  exact FunctionBetween.apply_value with function, pairIn, mapped

theorem fromRows.graph_entry1 (R m1 m2 n A C i j : Set)
  requires values0 : ∀ i ∈ m1, ∀ j ∈ n, A((i, j)) ∈ Ring.carrier(R)
  requires values1 : ∀ i ∈ m2, ∀ j ∈ n, C((i, j)) ∈ Ring.carrier(R)
  requires hi : i ∈ m2
  requires hj : j ∈ n
  shows fromRows(R, m1, m2, n, A, C)((inr(i), j)) = C((i, j))
proof
  have function := fromRows.graph_function at R, m1, m2, n, A, C with *
  have valueIn := values1 with i, hi, j, hj
  have xIn := disjointSum.right at i, m1, m2 with hi
  have yIn := hj
  have pairIn := product.pair at inr(i), j, (m1 ⊎ m2), n with xIn, yIn
  have outer := product.pair at (inr(i), j), C((i, j)), (m1 ⊎ m2) × n, Ring.carrier(R) with pairIn, valueIn
  have mapped : relates(fromRows(R, m1, m2, n, A, C), (inr(i), j), C((i, j)))
    unfold relates
    apply fromRows.membership.backward
    refine ⟨outer, ?_⟩
    right
    exact ⟨i, hi, j, hj, rfl⟩
  exact FunctionBetween.apply_value with function, pairIn, mapped

theorem fromCols.graph_function (R m n1 n2 A B : Set)
  requires values0 : ∀ i ∈ m, ∀ j ∈ n1, A((i, j)) ∈ Ring.carrier(R)
  requires values1 : ∀ i ∈ m, ∀ j ∈ n2, B((i, j)) ∈ Ring.carrier(R)
  shows fromCols(R, m, n1, n2, A, B) : m × (n1 ⊎ n2) → Ring.carrier(R)
proof
  constructor
    intros q0 member
    obtain ⟨bounded, rest⟩ := fromCols.membership.forward with member
    exact bounded
  . constructor
      intros z0 first r1 second r2
      unfold relates at r1
      unfold relates at r2
      obtain ⟨_, c1⟩ := fromCols.membership.forward with r1
      obtain ⟨_, c2⟩ := fromCols.membership.forward with r2
      cases c1 with a10 | b10
      . obtain ⟨i1, hi1, j1, hj1, s1⟩ := a10
        cases c2 with a20 | b20
        . obtain ⟨i2, hi2, j2, hj2, s2⟩ := a20
          obtain ⟨z1, f1⟩ := orderedPair.injective with s1
          obtain ⟨z2, f2⟩ := orderedPair.injective with s2
          rw z1 at z2
          obtain ⟨kr, kc⟩ := orderedPair.injective with z2
          have ii := kr
          have jj := inl.injective at j1, j2 with kc
          rw [f1, f2, ii, jj]
        . obtain ⟨i2, hi2, j2, hj2, s2⟩ := b20
          obtain ⟨z1, f1⟩ := orderedPair.injective with s1
          obtain ⟨z2, f2⟩ := orderedPair.injective with s2
          rw z1 at z2
          obtain ⟨kr, kc⟩ := orderedPair.injective with z2
          have ii := kr
          exfalso
          exact (tags.disjoint at j1, j2) with kc
      . obtain ⟨i1, hi1, j1, hj1, s1⟩ := b10
        cases c2 with a20 | b20
        . obtain ⟨i2, hi2, j2, hj2, s2⟩ := a20
          obtain ⟨z1, f1⟩ := orderedPair.injective with s1
          obtain ⟨z2, f2⟩ := orderedPair.injective with s2
          rw z1 at z2
          obtain ⟨kr, kc⟩ := orderedPair.injective with z2
          have ii := kr
          exfalso
          have back : inl(j2) = inr(j1)
            symm
            exact kc
          exact (tags.disjoint at j2, j1) with back
        . obtain ⟨i2, hi2, j2, hj2, s2⟩ := b20
          obtain ⟨z1, f1⟩ := orderedPair.injective with s1
          obtain ⟨z2, f2⟩ := orderedPair.injective with s2
          rw z1 at z2
          obtain ⟨kr, kc⟩ := orderedPair.injective with z2
          have ii := kr
          have jj := inr.injective at j1, j2 with kc
          rw [f1, f2, ii, jj]
    . intros q0 pIn
      obtain ⟨bound, x, hx, y, hy, shape⟩ := product.membership.forward with pIn
      rw shape
      have sy := disjointSum.membership.forward with hy
      cases sy with ly | ry
      . obtain ⟨j, hj, yShape⟩ := ly
        rw yShape
        have valueIn := values0 with x, hx, j, hj
        have xIn := hx
        have yIn := disjointSum.left at j, n1, n2 with hj
        have pairIn := product.pair at x, inl(j), m, (n1 ⊎ n2) with xIn, yIn
        have outer := product.pair at (x, inl(j)), A((x, j)), m × (n1 ⊎ n2), Ring.carrier(R) with pairIn, valueIn
        refine ⟨A((x, j)), valueIn, ?_⟩
        unfold relates
        apply fromCols.membership.backward
        refine ⟨outer, ?_⟩
        left
        exact ⟨x, hx, j, hj, rfl⟩
      . obtain ⟨j, hj, yShape⟩ := ry
        rw yShape
        have valueIn := values1 with x, hx, j, hj
        have xIn := hx
        have yIn := disjointSum.right at j, n1, n2 with hj
        have pairIn := product.pair at x, inr(j), m, (n1 ⊎ n2) with xIn, yIn
        have outer := product.pair at (x, inr(j)), B((x, j)), m × (n1 ⊎ n2), Ring.carrier(R) with pairIn, valueIn
        refine ⟨B((x, j)), valueIn, ?_⟩
        unfold relates
        apply fromCols.membership.backward
        refine ⟨outer, ?_⟩
        right
        exact ⟨x, hx, j, hj, rfl⟩

theorem fromCols.graph_entry0 (R m n1 n2 A B i j : Set)
  requires values0 : ∀ i ∈ m, ∀ j ∈ n1, A((i, j)) ∈ Ring.carrier(R)
  requires values1 : ∀ i ∈ m, ∀ j ∈ n2, B((i, j)) ∈ Ring.carrier(R)
  requires hi : i ∈ m
  requires hj : j ∈ n1
  shows fromCols(R, m, n1, n2, A, B)((i, inl(j))) = A((i, j))
proof
  have function := fromCols.graph_function at R, m, n1, n2, A, B with *
  have valueIn := values0 with i, hi, j, hj
  have xIn := hi
  have yIn := disjointSum.left at j, n1, n2 with hj
  have pairIn := product.pair at i, inl(j), m, (n1 ⊎ n2) with xIn, yIn
  have outer := product.pair at (i, inl(j)), A((i, j)), m × (n1 ⊎ n2), Ring.carrier(R) with pairIn, valueIn
  have mapped : relates(fromCols(R, m, n1, n2, A, B), (i, inl(j)), A((i, j)))
    unfold relates
    apply fromCols.membership.backward
    refine ⟨outer, ?_⟩
    left
    exact ⟨i, hi, j, hj, rfl⟩
  exact FunctionBetween.apply_value with function, pairIn, mapped

theorem fromCols.graph_entry1 (R m n1 n2 A B i j : Set)
  requires values0 : ∀ i ∈ m, ∀ j ∈ n1, A((i, j)) ∈ Ring.carrier(R)
  requires values1 : ∀ i ∈ m, ∀ j ∈ n2, B((i, j)) ∈ Ring.carrier(R)
  requires hi : i ∈ m
  requires hj : j ∈ n2
  shows fromCols(R, m, n1, n2, A, B)((i, inr(j))) = B((i, j))
proof
  have function := fromCols.graph_function at R, m, n1, n2, A, B with *
  have valueIn := values1 with i, hi, j, hj
  have xIn := hi
  have yIn := disjointSum.right at j, n1, n2 with hj
  have pairIn := product.pair at i, inr(j), m, (n1 ⊎ n2) with xIn, yIn
  have outer := product.pair at (i, inr(j)), B((i, j)), m × (n1 ⊎ n2), Ring.carrier(R) with pairIn, valueIn
  have mapped : relates(fromCols(R, m, n1, n2, A, B), (i, inr(j)), B((i, j)))
    unfold relates
    apply fromCols.membership.backward
    refine ⟨outer, ?_⟩
    right
    exact ⟨i, hi, j, hj, rfl⟩
  exact FunctionBetween.apply_value with function, pairIn, mapped

theorem vecAppend.graph_function (R m1 m2 v w : Set)
  requires values0 : ∀ i ∈ m1, v(i) ∈ Ring.carrier(R)
  requires values1 : ∀ i ∈ m2, w(i) ∈ Ring.carrier(R)
  shows vecAppend(R, m1, m2, v, w) : m1 ⊎ m2 → Ring.carrier(R)
proof
  constructor
    intros q0 member
    obtain ⟨bounded, rest⟩ := vecAppend.membership.forward with member
    exact bounded
  . constructor
      intros z0 first r1 second r2
      unfold relates at r1
      unfold relates at r2
      obtain ⟨_, c1⟩ := vecAppend.membership.forward with r1
      obtain ⟨_, c2⟩ := vecAppend.membership.forward with r2
      cases c1 with a10 | b10
      . obtain ⟨i1, hi1, s1⟩ := a10
        cases c2 with a20 | b20
        . obtain ⟨i2, hi2, s2⟩ := a20
          obtain ⟨z1, f1⟩ := orderedPair.injective with s1
          obtain ⟨z2, f2⟩ := orderedPair.injective with s2
          rw z1 at z2
          have kr := z2
          have ii := inl.injective at i1, i2 with kr
          rw [f1, f2, ii]
        . obtain ⟨i2, hi2, s2⟩ := b20
          obtain ⟨z1, f1⟩ := orderedPair.injective with s1
          obtain ⟨z2, f2⟩ := orderedPair.injective with s2
          rw z1 at z2
          have kr := z2
          exfalso
          exact (tags.disjoint at i1, i2) with kr
      . obtain ⟨i1, hi1, s1⟩ := b10
        cases c2 with a20 | b20
        . obtain ⟨i2, hi2, s2⟩ := a20
          obtain ⟨z1, f1⟩ := orderedPair.injective with s1
          obtain ⟨z2, f2⟩ := orderedPair.injective with s2
          rw z1 at z2
          have kr := z2
          exfalso
          have back : inl(i2) = inr(i1)
            symm
            exact kr
          exact (tags.disjoint at i2, i1) with back
        . obtain ⟨i2, hi2, s2⟩ := b20
          obtain ⟨z1, f1⟩ := orderedPair.injective with s1
          obtain ⟨z2, f2⟩ := orderedPair.injective with s2
          rw z1 at z2
          have kr := z2
          have ii := inr.injective at i1, i2 with kr
          rw [f1, f2, ii]
    . intros q0 pIn
      have split := disjointSum.membership.forward with pIn
      cases split with leftCase | rightCase
      . obtain ⟨i, hi, shape⟩ := leftCase
        rw shape
        have valueIn := values0 with i, hi
        have keyIn := disjointSum.left at i, m1, m2 with hi
        have outer := product.pair at inl(i), v(i), m1 ⊎ m2, Ring.carrier(R) with keyIn, valueIn
        refine ⟨v(i), valueIn, ?_⟩
        unfold relates
        apply vecAppend.membership.backward
        refine ⟨outer, ?_⟩
        left
        exact ⟨i, hi, rfl⟩
      . obtain ⟨i, hi, shape⟩ := rightCase
        rw shape
        have valueIn := values1 with i, hi
        have keyIn := disjointSum.right at i, m1, m2 with hi
        have outer := product.pair at inr(i), w(i), m1 ⊎ m2, Ring.carrier(R) with keyIn, valueIn
        refine ⟨w(i), valueIn, ?_⟩
        unfold relates
        apply vecAppend.membership.backward
        refine ⟨outer, ?_⟩
        right
        exact ⟨i, hi, rfl⟩

theorem vecAppend.graph_entry0 (R m1 m2 v w i : Set)
  requires values0 : ∀ i ∈ m1, v(i) ∈ Ring.carrier(R)
  requires values1 : ∀ i ∈ m2, w(i) ∈ Ring.carrier(R)
  requires hi : i ∈ m1
  shows vecAppend(R, m1, m2, v, w)(inl(i)) = v(i)
proof
  have function := vecAppend.graph_function at R, m1, m2, v, w with *
  have valueIn := values0 with i, hi
  have keyIn := disjointSum.left at i, m1, m2 with hi
  have outer := product.pair at inl(i), v(i), m1 ⊎ m2, Ring.carrier(R) with keyIn, valueIn
  have mapped : relates(vecAppend(R, m1, m2, v, w), inl(i), v(i))
    unfold relates
    apply vecAppend.membership.backward
    refine ⟨outer, ?_⟩
    left
    exact ⟨i, hi, rfl⟩
  exact FunctionBetween.apply_value with function, keyIn, mapped

theorem vecAppend.graph_entry1 (R m1 m2 v w i : Set)
  requires values0 : ∀ i ∈ m1, v(i) ∈ Ring.carrier(R)
  requires values1 : ∀ i ∈ m2, w(i) ∈ Ring.carrier(R)
  requires hi : i ∈ m2
  shows vecAppend(R, m1, m2, v, w)(inr(i)) = w(i)
proof
  have function := vecAppend.graph_function at R, m1, m2, v, w with *
  have valueIn := values1 with i, hi
  have keyIn := disjointSum.right at i, m1, m2 with hi
  have outer := product.pair at inr(i), w(i), m1 ⊎ m2, Ring.carrier(R) with keyIn, valueIn
  have mapped : relates(vecAppend(R, m1, m2, v, w), inr(i), w(i))
    unfold relates
    apply vecAppend.membership.backward
    refine ⟨outer, ?_⟩
    right
    exact ⟨i, hi, rfl⟩
  exact FunctionBetween.apply_value with function, keyIn, mapped

-- The inclusions of the summands of a disjoint sum.
theorem leftInclusion.function_of (A B : Set)
  shows leftInclusion(A, B) : A → A ⊎ B
proof
  have values : ∀ x ∈ A, inl(x) ∈ A ⊎ B
    intros x hx
    exact disjointSum.left at x, A, B with hx
  exact leftInclusion.graph_function at A, B with values

theorem leftInclusion.at (A B x : Set)
  requires member : x ∈ A
  shows leftInclusion(A, B)(x) = inl(x)
proof
  have values : ∀ y ∈ A, inl(y) ∈ A ⊎ B
    intros y hy
    exact disjointSum.left at y, A, B with hy
  exact leftInclusion.graph_apply at A, B, x with values, member

theorem rightInclusion.function_of (A B : Set)
  shows rightInclusion(A, B) : B → A ⊎ B
proof
  have values : ∀ y ∈ B, inr(y) ∈ A ⊎ B
    intros y hy
    exact disjointSum.right at y, A, B with hy
  exact rightInclusion.graph_function at A, B with values

theorem rightInclusion.at (A B y : Set)
  requires member : y ∈ B
  shows rightInclusion(A, B)(y) = inr(y)
proof
  have values : ∀ x ∈ B, inr(x) ∈ A ⊎ B
    intros x hx
    exact disjointSum.right at x, A, B with hx
  exact rightInclusion.graph_apply at A, B, y with values, member

theorem submatrix.mem_of (R m n m2 n2 A f g : Set)
  requires matrix : A ∈ matrixSpace(R, m, n)
  requires rows : f : m2 → m
  requires columns : g : n2 → n
  shows submatrix(R, m2, n2, A, f, g) ∈ matrixSpace(R, m2, n2)
proof
  have values : ∀ x ∈ m2, ∀ y ∈ n2, A((f(x), g(y))) ∈ Ring.carrier(R)
    intros x hx y hy
    have fx := FunctionBetween.apply_closed with rows, hx
    have gy := FunctionBetween.apply_closed with columns, hy
    exact matrixSpace.entry_mem with matrix, fx, gy
  have function := submatrix.graph_function at R, m2, n2, A, f, g with values
  exact matrixSpace.of_function with function

theorem submatrix.at (R m n m2 n2 A f g i j : Set)
  requires matrix : A ∈ matrixSpace(R, m, n)
  requires rows : f : m2 → m
  requires columns : g : n2 → n
  requires row : i ∈ m2
  requires column : j ∈ n2
  shows submatrix(R, m2, n2, A, f, g)((i, j)) = A((f(i), g(j)))
proof
  have values : ∀ x ∈ m2, ∀ y ∈ n2, A((f(x), g(y))) ∈ Ring.carrier(R)
    intros x hx y hy
    have fx := FunctionBetween.apply_closed with rows, hx
    have gy := FunctionBetween.apply_closed with columns, hy
    exact matrixSpace.entry_mem with matrix, fx, gy
  exact submatrix.graph_entry at R, m2, n2, A, f, g, i, j with values, row, column

theorem conjTranspose.mem_of (R σ m n A : Set)
  requires involution : RingInvolution(σ, R)
  requires matrix : A ∈ matrixSpace(R, m, n)
  shows conjTranspose(R, σ, m, n, A) ∈ matrixSpace(R, n, m)
proof
  obtain ⟨comm, hom, involutive⟩ := involution
  obtain ⟨src, tgt, sF, rest⟩ := hom
  have values : ∀ x ∈ m, ∀ y ∈ n, σ(A((x, y))) ∈ Ring.carrier(R)
    intros x hx y hy
    have entry := matrixSpace.entry_mem with matrix, hx, hy
    exact FunctionBetween.apply_closed with sF, entry
  have function := conjTranspose.graph_function at R, σ, m, n, A with values
  exact matrixSpace.of_function with function

theorem conjTranspose.at (R σ m n A i j : Set)
  requires involution : RingInvolution(σ, R)
  requires matrix : A ∈ matrixSpace(R, m, n)
  requires row : i ∈ m
  requires column : j ∈ n
  shows conjTranspose(R, σ, m, n, A)((j, i)) = σ(A((i, j)))
proof
  obtain ⟨comm, hom, involutive⟩ := involution
  obtain ⟨src, tgt, sF, rest⟩ := hom
  have values : ∀ x ∈ m, ∀ y ∈ n, σ(A((x, y))) ∈ Ring.carrier(R)
    intros x hx y hy
    have entry := matrixSpace.entry_mem with matrix, hx, hy
    exact FunctionBetween.apply_closed with sF, entry
  exact conjTranspose.entry_of at R, σ, m, n, A, i, j with values, row, column

section MatrixHelpers
variable (R : Set)
hypothesis ring : CommRing(R)

theorem vecDotTerms.function_of (n v w : Set)
  requires first : v ∈ functionSpace(n, R.carrier)
  requires second : w ∈ functionSpace(n, R.carrier)
  shows vecDotTerms(R, n, v, w) : n → R.carrier
proof
  have values : ∀ j ∈ n, call2(R.mul, v(j), w(j)) ∈ R.carrier
    intros j hj
    have vj := functionSpace.apply_mem with first, hj
    have wj := functionSpace.apply_mem with second, hj
    exact Ring.mul_mem at R, v(j), w(j) with *
  exact vecDotTerms.graph_function at R, n, v, w with values

theorem vecDotTerms.at (n v w j : Set)
  requires first : v ∈ functionSpace(n, R.carrier)
  requires second : w ∈ functionSpace(n, R.carrier)
  requires index : j ∈ n
  shows vecDotTerms(R, n, v, w)(j) = v(j) * w(j)
proof
  have values : ∀ x ∈ n, call2(R.mul, v(x), w(x)) ∈ R.carrier
    intros x hx
    have vx := functionSpace.apply_mem with first, hx
    have wx := functionSpace.apply_mem with second, hx
    exact Ring.mul_mem at R, v(x), w(x) with *
  exact vecDotTerms.graph_apply at R, n, v, w, j with values, index

theorem matRow.space (m n A i : Set)
  requires matrix : A ∈ matrixSpace(R, m, n)
  requires row : i ∈ m
  shows matRow(R, n, A, i) ∈ functionSpace(n, R.carrier)
proof
  have values : ∀ j ∈ n, A((i, j)) ∈ R.carrier
    intros j hj
    exact matrixSpace.entry_mem with matrix, row, hj
  have function := matRow.graph_function at R, n, A, i with values
  exact functionSpace.mem_iff.backward with function

theorem matRow.at (m n A i j : Set)
  requires matrix : A ∈ matrixSpace(R, m, n)
  requires row : i ∈ m
  requires column : j ∈ n
  shows matRow(R, n, A, i)(j) = A((i, j))
proof
  have values : ∀ x ∈ n, A((i, x)) ∈ R.carrier
    intros x hx
    exact matrixSpace.entry_mem with matrix, row, hx
  exact matRow.graph_apply at R, n, A, i, j with values, column

theorem matCol.space (m n A j : Set)
  requires matrix : A ∈ matrixSpace(R, m, n)
  requires column : j ∈ n
  shows matCol(R, m, A, j) ∈ functionSpace(m, R.carrier)
proof
  have values : ∀ i ∈ m, A((i, j)) ∈ R.carrier
    intros i hi
    exact matrixSpace.entry_mem with matrix, hi, column
  have function := matCol.graph_function at R, m, A, j with values
  exact functionSpace.mem_iff.backward with function

theorem matCol.at (m n A i j : Set)
  requires matrix : A ∈ matrixSpace(R, m, n)
  requires row : i ∈ m
  requires column : j ∈ n
  shows matCol(R, m, A, j)(i) = A((i, j))
proof
  have values : ∀ x ∈ m, A((x, j)) ∈ R.carrier
    intros x hx
    exact matrixSpace.entry_mem with matrix, hx, column
  exact matCol.graph_apply at R, m, A, j, i with values, row

theorem vecDot.mem_of (n v w : Set)
  requires finite : Finite(n)
  requires first : v ∈ functionSpace(n, R.carrier)
  requires second : w ∈ functionSpace(n, R.carrier)
  shows vecDot(R, n, v, w) ∈ R.carrier
proof
  have parts := CommRing.parts with ring
  have terms := vecDotTerms.function_of at R, n, v, w with *
  unfold vecDot
  exact finiteRingSum.closed at n, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, vecDotTerms(R, n, v, w) with parts, finite, terms

theorem vecDot.congr_of (n v w v2 w2 : Set)
  requires finite : Finite(n)
  requires h1 : v ∈ functionSpace(n, R.carrier)
  requires h2 : w ∈ functionSpace(n, R.carrier)
  requires h3 : v2 ∈ functionSpace(n, R.carrier)
  requires h4 : w2 ∈ functionSpace(n, R.carrier)
  requires agree : ∀ j ∈ n, v(j) * w(j) = v2(j) * w2(j)
  shows vecDot(R, n, v, w) = vecDot(R, n, v2, w2)
proof
  have parts := CommRing.parts with ring
  have t1 := vecDotTerms.function_of at R, n, v, w with ring, h1, h2
  have t2 := vecDotTerms.function_of at R, n, v2, w2 with ring, h3, h4
  have pointwise : ∀ x ∈ n, vecDotTerms(R, n, v, w)(x) = vecDotTerms(R, n, v2, w2)(x)
    intros x hx
    have e1 := vecDotTerms.at at R, n, v, w, x with ring, h1, h2, hx
    have e2 := vecDotTerms.at at R, n, v2, w2, x with ring, h3, h4, hx
    rw [e1, e2]
    exact agree with x, hx
  unfold vecDot
  exact finiteRingSum.congr at n, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, vecDotTerms(R, n, v, w), vecDotTerms(R, n, v2, w2) with parts, finite, t1, t2, pointwise

theorem vecDot.sum_of (n v w v1 w1 v2 w2 : Set)
  requires finite : Finite(n)
  requires h1 : v ∈ functionSpace(n, R.carrier)
  requires h2 : w ∈ functionSpace(n, R.carrier)
  requires h3 : v1 ∈ functionSpace(n, R.carrier)
  requires h4 : w1 ∈ functionSpace(n, R.carrier)
  requires h5 : v2 ∈ functionSpace(n, R.carrier)
  requires h6 : w2 ∈ functionSpace(n, R.carrier)
  requires agree : ∀ j ∈ n, v(j) * w(j) = v1(j) * w1(j) + v2(j) * w2(j)
  shows vecDot(R, n, v, w) = vecDot(R, n, v1, w1) + vecDot(R, n, v2, w2)
proof
  have parts := CommRing.parts with ring
  have ringR := CommRing.to_ring with ring
  have oneIn := Ring.one_mem at R with ringR
  have th := vecDotTerms.function_of at R, n, v, w with ring, h1, h2
  have t1 := vecDotTerms.function_of at R, n, v1, w1 with ring, h3, h4
  have t2 := vecDotTerms.function_of at R, n, v2, w2 with ring, h5, h6
  have entries : ∀ x ∈ n, vecDotTerms(R, n, v, w)(x) = R.one * vecDotTerms(R, n, v1, w1)(x) + R.one * vecDotTerms(R, n, v2, w2)(x)
    intros x hx
    have a := functionSpace.apply_mem with h1, hx
    have b := functionSpace.apply_mem with h2, hx
    have c := functionSpace.apply_mem with h3, hx
    have d := functionSpace.apply_mem with h4, hx
    have e := functionSpace.apply_mem with h5, hx
    have f := functionSpace.apply_mem with h6, hx
    have e0 := vecDotTerms.at at R, n, v, w, x with ring, h1, h2, hx
    have e1 := vecDotTerms.at at R, n, v1, w1, x with ring, h3, h4, hx
    have e2 := vecDotTerms.at at R, n, v2, w2, x with ring, h5, h6, hx
    have same := agree with x, hx
    rw [e0, e1, e2, same]
    ring
  have law := finiteRingSum.linear at n, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, vecDotTerms(R, n, v1, w1), vecDotTerms(R, n, v2, w2), vecDotTerms(R, n, v, w), R.one, R.one with parts, finite, t1, t2, th, oneIn, oneIn, entries
  have s1 := vecDot.mem_of at R, n, v1, w1 with ring, finite, h3, h4
  have s2 := vecDot.mem_of at R, n, v2, w2 with ring, finite, h5, h6
  unfold vecDot
  unfold vecDot at s1
  unfold vecDot at s2
  rw law
  ring

theorem vecDot.scale_of (n v w a v1 w1 : Set)
  requires finite : Finite(n)
  requires scalar : a ∈ R.carrier
  requires h1 : v ∈ functionSpace(n, R.carrier)
  requires h2 : w ∈ functionSpace(n, R.carrier)
  requires h3 : v1 ∈ functionSpace(n, R.carrier)
  requires h4 : w1 ∈ functionSpace(n, R.carrier)
  requires agree : ∀ j ∈ n, v(j) * w(j) = a * (v1(j) * w1(j))
  shows vecDot(R, n, v, w) = a * vecDot(R, n, v1, w1)
proof
  have parts := CommRing.parts with ring
  have th := vecDotTerms.function_of at R, n, v, w with ring, h1, h2
  have t1 := vecDotTerms.function_of at R, n, v1, w1 with ring, h3, h4
  have entries : ∀ x ∈ n, vecDotTerms(R, n, v, w)(x) = a * vecDotTerms(R, n, v1, w1)(x)
    intros x hx
    have e0 := vecDotTerms.at at R, n, v, w, x with ring, h1, h2, hx
    have e1 := vecDotTerms.at at R, n, v1, w1, x with ring, h3, h4, hx
    rw [e0, e1]
    exact agree with x, hx
  unfold vecDot
  exact finiteRingSum.scale_eq at n, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, vecDotTerms(R, n, v1, w1), vecDotTerms(R, n, v, w), a with parts, finite, t1, th, scalar, entries

-- A sum whose terms vanish off one index is that term.
theorem vecDot.single_of (n v w i : Set)
  requires finite : Finite(n)
  requires h1 : v ∈ functionSpace(n, R.carrier)
  requires h2 : w ∈ functionSpace(n, R.carrier)
  requires index : i ∈ n
  requires vanishes : ∀ j ∈ n, j ≠ i → v(j) * w(j) = R.zero
  shows vecDot(R, n, v, w) = v(i) * w(i)
proof
  have parts := CommRing.parts with ring
  have terms := vecDotTerms.function_of at R, n, v, w with ring, h1, h2
  have single : {i} ⊆ n
    intros x hx
    have same := singleton.membership.forward with hx
    rw same
    exact index
  have zeros : ∀ x ∈ n, ¬(x ∈ {i}) → vecDotTerms(R, n, v, w)(x) = R.zero
    intros x hx out
    have other : x ≠ i
      intro same
      rw same at out
      exact out with (singleton.self at i)
    have e1 := vecDotTerms.at at R, n, v, w, x with ring, h1, h2, hx
    rw e1
    exact vanishes with x, hx, other
  have restricted := finiteRingSum.restrict at n, {i}, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, vecDotTerms(R, n, v, w) with parts, finite, terms, single, zeros
  have rF := restrict.domain_function at vecDotTerms(R, n, v, w), n, R.carrier, {i} with terms, single
  have one := finiteRingSum.singleton at R.carrier, R.add, R.zero, R.neg, R.mul, R.one, restrict(vecDotTerms(R, n, v, w), {i}), i with parts, rF
  have r0 := restrict.domain_apply at vecDotTerms(R, n, v, w), n, R.carrier, {i}, i with terms, single, (singleton.self at i)
  have e1 := vecDotTerms.at at R, n, v, w, i with ring, h1, h2, index
  unfold vecDot
  rw [restricted, one, r0, e1]

theorem matAdd.mem_of (m n A B : Set)
  requires first : A ∈ matrixSpace(R, m, n)
  requires second : B ∈ matrixSpace(R, m, n)
  shows matAdd(R, m, n, A, B) ∈ matrixSpace(R, m, n)
proof
  have values : ∀ i ∈ m, ∀ j ∈ n, call2(R.add, A((i, j)), B((i, j))) ∈ R.carrier
    intros i hi j hj
    have a := matrixSpace.entry_mem with first, hi, hj
    have b := matrixSpace.entry_mem with second, hi, hj
    exact Ring.add_mem at R, A((i, j)), B((i, j)) with *
  have function := matAdd.graph_function at R, m, n, A, B with values
  exact matrixSpace.of_function with function

theorem matAdd.at (m n A B i j : Set)
  requires first : A ∈ matrixSpace(R, m, n)
  requires second : B ∈ matrixSpace(R, m, n)
  requires row : i ∈ m
  requires column : j ∈ n
  shows matAdd(R, m, n, A, B)((i, j)) = A((i, j)) + B((i, j))
proof
  have values : ∀ x ∈ m, ∀ y ∈ n, call2(R.add, A((x, y)), B((x, y))) ∈ R.carrier
    intros x hx y hy
    have a := matrixSpace.entry_mem with first, hx, hy
    have b := matrixSpace.entry_mem with second, hx, hy
    exact Ring.add_mem at R, A((x, y)), B((x, y)) with *
  exact matAdd.graph_entry at R, m, n, A, B, i, j with values, row, column

theorem matSmul.mem_of (m n a A : Set)
  requires scalar : a ∈ R.carrier
  requires matrix : A ∈ matrixSpace(R, m, n)
  shows matSmul(R, m, n, a, A) ∈ matrixSpace(R, m, n)
proof
  have values : ∀ i ∈ m, ∀ j ∈ n, call2(R.mul, a, A((i, j))) ∈ R.carrier
    intros i hi j hj
    have b := matrixSpace.entry_mem with matrix, hi, hj
    exact Ring.mul_mem at R, a, A((i, j)) with *
  have function := matSmul.graph_function at R, m, n, a, A with values
  exact matrixSpace.of_function with function

theorem matSmul.at (m n a A i j : Set)
  requires scalar : a ∈ R.carrier
  requires matrix : A ∈ matrixSpace(R, m, n)
  requires row : i ∈ m
  requires column : j ∈ n
  shows matSmul(R, m, n, a, A)((i, j)) = a * A((i, j))
proof
  have values : ∀ x ∈ m, ∀ y ∈ n, call2(R.mul, a, A((x, y))) ∈ R.carrier
    intros x hx y hy
    have b := matrixSpace.entry_mem with matrix, hx, hy
    exact Ring.mul_mem at R, a, A((x, y)) with *
  exact matSmul.graph_entry at R, m, n, a, A, i, j with values, row, column

theorem matMul.mem_of (m n p A B : Set)
  requires finite : Finite(n)
  requires first : A ∈ matrixSpace(R, m, n)
  requires second : B ∈ matrixSpace(R, n, p)
  shows matMul(R, m, n, p, A, B) ∈ matrixSpace(R, m, p)
proof
  have values : ∀ i ∈ m, ∀ k ∈ p, vecDot(R, n, matRow(R, n, A, i), matCol(R, n, B, k)) ∈ R.carrier
    intros i hi k hk
    have rowS := matRow.space at R, m, n, A, i with ring, first, hi
    have colS := matCol.space at R, n, p, B, k with ring, second, hk
    exact vecDot.mem_of at R, n, matRow(R, n, A, i), matCol(R, n, B, k) with ring, finite, rowS, colS
  have function := matMul.graph_function at R, m, n, p, A, B with values
  exact matrixSpace.of_function with function

theorem matMul.at (m n p A B i k : Set)
  requires finite : Finite(n)
  requires first : A ∈ matrixSpace(R, m, n)
  requires second : B ∈ matrixSpace(R, n, p)
  requires row : i ∈ m
  requires column : k ∈ p
  shows matMul(R, m, n, p, A, B)((i, k)) =
    vecDot(R, n, matRow(R, n, A, i), matCol(R, n, B, k))
proof
  have values : ∀ x ∈ m, ∀ y ∈ p, vecDot(R, n, matRow(R, n, A, x), matCol(R, n, B, y)) ∈ R.carrier
    intros x hx y hy
    have rowS := matRow.space at R, m, n, A, x with ring, first, hx
    have colS := matCol.space at R, n, p, B, y with ring, second, hy
    exact vecDot.mem_of at R, n, matRow(R, n, A, x), matCol(R, n, B, y) with ring, finite, rowS, colS
  exact matMul.graph_entry at R, m, n, p, A, B, i, k with values, row, column

theorem matOne.mem_of (n : Set)
  shows matOne(R, n) ∈ matrixSpace(R, n, n)
proof
  have ringR := CommRing.to_ring with ring
  have oneIn := Ring.one_mem at R with ringR
  have constant := constantFunction.function at n, R.carrier, R.one with oneIn
  have vector := functionSpace.mem_iff.backward with constant
  have function := matDiagonal.graph_function at R, n, constantFunction(n, R.carrier, R.one) with ringR, vector
  unfold matOne
  exact matrixSpace.of_function with function

theorem matDiagonal.mem_of (n d : Set)
  requires vector : d ∈ functionSpace(n, R.carrier)
  shows matDiagonal(R, n, d) ∈ matrixSpace(R, n, n)
proof
  have ringR := CommRing.to_ring with ring
  have function := matDiagonal.graph_function at R, n, d with ringR, vector
  exact matrixSpace.of_function with function

theorem matOne.same (n i : Set)
  requires row : i ∈ n
  shows matOne(R, n)((i, i)) = R.one
proof
  have ringR := CommRing.to_ring with ring
  have oneIn := Ring.one_mem at R with ringR
  have constant := constantFunction.function at n, R.carrier, R.one with oneIn
  have vector := functionSpace.mem_iff.backward with constant
  obtain ⟨diag, off⟩ := matDiagonal.entry_of at R, n, constantFunction(n, R.carrier, R.one), i, i with ringR, vector, row, row
  have value := diag with rfl
  have c := constantFunction.apply at n, R.carrier, i, R.one with row, oneIn
  unfold matOne
  rw [value, c]

theorem matOne.other (n i j : Set)
  requires row : i ∈ n
  requires column : j ∈ n
  requires different : i ≠ j
  shows matOne(R, n)((i, j)) = R.zero
proof
  have ringR := CommRing.to_ring with ring
  have oneIn := Ring.one_mem at R with ringR
  have constant := constantFunction.function at n, R.carrier, R.one with oneIn
  have vector := functionSpace.mem_iff.backward with constant
  obtain ⟨diag, off⟩ := matDiagonal.entry_of at R, n, constantFunction(n, R.carrier, R.one), i, j with ringR, vector, row, column
  unfold matOne
  exact off with different

theorem vecAdd.space (n v w : Set)
  requires first : v ∈ functionSpace(n, R.carrier)
  requires second : w ∈ functionSpace(n, R.carrier)
  shows vecAdd(R, n, v, w) ∈ functionSpace(n, R.carrier)
proof
  have values : ∀ j ∈ n, call2(R.add, v(j), w(j)) ∈ R.carrier
    intros j hj
    have vj := functionSpace.apply_mem with first, hj
    have wj := functionSpace.apply_mem with second, hj
    exact Ring.add_mem at R, v(j), w(j) with *
  have function := vecAdd.graph_function at R, n, v, w with values
  exact functionSpace.mem_iff.backward with function

theorem vecAdd.at (n v w j : Set)
  requires first : v ∈ functionSpace(n, R.carrier)
  requires second : w ∈ functionSpace(n, R.carrier)
  requires index : j ∈ n
  shows vecAdd(R, n, v, w)(j) = v(j) + w(j)
proof
  have values : ∀ x ∈ n, call2(R.add, v(x), w(x)) ∈ R.carrier
    intros x hx
    have vx := functionSpace.apply_mem with first, hx
    have wx := functionSpace.apply_mem with second, hx
    exact Ring.add_mem at R, v(x), w(x) with *
  exact vecAdd.graph_apply at R, n, v, w, j with values, index

theorem vecSmul.space (n a v : Set)
  requires scalar : a ∈ R.carrier
  requires first : v ∈ functionSpace(n, R.carrier)
  shows vecSmul(R, n, a, v) ∈ functionSpace(n, R.carrier)
proof
  have values : ∀ j ∈ n, call2(R.mul, a, v(j)) ∈ R.carrier
    intros j hj
    have vj := functionSpace.apply_mem with first, hj
    exact Ring.mul_mem at R, a, v(j) with *
  have function := vecSmul.graph_function at R, n, a, v with values
  exact functionSpace.mem_iff.backward with function

theorem vecSmul.at (n a v j : Set)
  requires scalar : a ∈ R.carrier
  requires first : v ∈ functionSpace(n, R.carrier)
  requires index : j ∈ n
  shows vecSmul(R, n, a, v)(j) = a * v(j)
proof
  have values : ∀ x ∈ n, call2(R.mul, a, v(x)) ∈ R.carrier
    intros x hx
    have vx := functionSpace.apply_mem with first, hx
    exact Ring.mul_mem at R, a, v(x) with *
  exact vecSmul.graph_apply at R, n, a, v, j with values, index

theorem matDiag.function_of (n A : Set)
  requires matrix : A ∈ matrixSpace(R, n, n)
  shows matDiag(R, n, A) : n → R.carrier
proof
  have values : ∀ i ∈ n, A((i, i)) ∈ R.carrier
    intros i hi
    exact matrixSpace.entry_mem with matrix, hi, hi
  exact matDiag.graph_function at R, n, A with values

theorem matDiag.at (n A i : Set)
  requires matrix : A ∈ matrixSpace(R, n, n)
  requires index : i ∈ n
  shows matDiag(R, n, A)(i) = A((i, i))
proof
  have values : ∀ x ∈ n, A((x, x)) ∈ R.carrier
    intros x hx
    exact matrixSpace.entry_mem with matrix, hx, hx
  exact matDiag.graph_apply at R, n, A, i with values, index

end MatrixHelpers

-- Section: Entries and membership
section Entries
variable (R : Set)
hypothesis ring : CommRing(R)

-- Matrix.ext_iff.
theorem matrixSpace.ext (m n A B : Set)
  requires first : A ∈ matrixSpace(R, m, n)
  requires second : B ∈ matrixSpace(R, m, n)
  shows A = B ↔ (∀ i ∈ m, ∀ j ∈ n, A[i, j] = B[i, j])
proof
  have fA := matrixSpace.function with first
  have fB := matrixSpace.function with second
  constructor
  . intro same
    intros i hi j hj
    rw same
  . intro agree
    apply FunctionBetween.ext with fA, fB
    intros p hp
    obtain ⟨bound, i, hi, j, hj, shape⟩ := product.membership.forward with hp
    rw shape
    exact agree with i, hi, j, hj

theorem matAdd.mem (m n A B : Set)
  requires first : A ∈ matrixSpace(R, m, n)
  requires second : B ∈ matrixSpace(R, m, n)
  shows matAdd(R, m, n, A, B) ∈ matrixSpace(R, m, n)
proof
  have values : ∀ i ∈ m, ∀ j ∈ n, call2(R.add, A((i, j)), B((i, j))) ∈ R.carrier
    intros i hi j hj
    have a := matrixSpace.entry_mem with first, hi, hj
    have b := matrixSpace.entry_mem with second, hi, hj
    exact Ring.add_mem at R, A((i, j)), B((i, j)) with *
  have function := matAdd.graph_function at R, m, n, A, B with values
  exact matrixSpace.of_function with function

theorem matAdd.entry (m n A B i j : Set)
  requires first : A ∈ matrixSpace(R, m, n)
  requires second : B ∈ matrixSpace(R, m, n)
  requires row : i ∈ m
  requires column : j ∈ n
  shows matAdd(R, m, n, A, B)[i, j] = A[i, j] + B[i, j]
proof
  have values : ∀ x ∈ m, ∀ y ∈ n, call2(R.add, A((x, y)), B((x, y))) ∈ R.carrier
    intros x hx y hy
    have a := matrixSpace.entry_mem with first, hx, hy
    have b := matrixSpace.entry_mem with second, hx, hy
    exact Ring.add_mem at R, A((x, y)), B((x, y)) with *
  exact matAdd.graph_entry at R, m, n, A, B, i, j with values, row, column

theorem matSmul.entry (m n a A i j : Set)
  requires scalar : a ∈ R.carrier
  requires matrix : A ∈ matrixSpace(R, m, n)
  requires row : i ∈ m
  requires column : j ∈ n
  shows matSmul(R, m, n, a, A)[i, j] = a * A[i, j]
proof
  have values : ∀ x ∈ m, ∀ y ∈ n, call2(R.mul, a, A((x, y))) ∈ R.carrier
    intros x hx y hy
    have b := matrixSpace.entry_mem with matrix, hx, hy
    exact Ring.mul_mem at R, a, A((x, y)) with *
  exact matSmul.graph_entry at R, m, n, a, A, i, j with values, row, column

theorem vecDot.mem (n v w : Set)
  requires finite : Finite(n)
  requires first : v ∈ functionSpace(n, R.carrier)
  requires second : w ∈ functionSpace(n, R.carrier)
  shows vecDot(R, n, v, w) ∈ R.carrier
proof
  exact vecDot.mem_of at R, n, v, w with *

-- dotProduct_comm.
theorem vecDot.comm (n v w : Set)
  requires finite : Finite(n)
  requires first : v ∈ functionSpace(n, R.carrier)
  requires second : w ∈ functionSpace(n, R.carrier)
  shows vecDot(R, n, v, w) = vecDot(R, n, w, v)
proof
  have parts := CommRing.parts with ring
  have t1 := vecDotTerms.function_of at R, n, v, w with *
  have t2 := vecDotTerms.function_of at R, n, w, v with *
  have agree : ∀ x ∈ n, vecDotTerms(R, n, v, w)(x) = vecDotTerms(R, n, w, v)(x)
    intros x hx
    have vx := functionSpace.apply_mem with first, hx
    have wx := functionSpace.apply_mem with second, hx
    have e1 := vecDotTerms.at at R, n, v, w, x with *
    have e2 := vecDotTerms.at at R, n, w, v, x with *
    rw [e1, e2]
    ring
  unfold vecDot
  exact finiteRingSum.congr at n, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, vecDotTerms(R, n, v, w), vecDotTerms(R, n, w, v) with parts, finite, t1, t2, agree

theorem vecDot.add_left (n u v w : Set)
  requires finite : Finite(n)
  requires first : u ∈ functionSpace(n, R.carrier)
  requires second : v ∈ functionSpace(n, R.carrier)
  requires third : w ∈ functionSpace(n, R.carrier)
  shows vecDot(R, n, vecAdd(R, n, u, v), w) = vecDot(R, n, u, w) + vecDot(R, n, v, w)
proof
  have parts := CommRing.parts with ring
  have sumValues : ∀ j ∈ n, call2(R.add, u(j), v(j)) ∈ R.carrier
    intros j hj
    have uj := functionSpace.apply_mem with first, hj
    have vj := functionSpace.apply_mem with second, hj
    exact Ring.add_mem at R, u(j), v(j) with *
  have sumF := vecAdd.graph_function at R, n, u, v with sumValues
  have sumS := functionSpace.mem_iff.backward with sumF
  have t1 := vecDotTerms.function_of at R, n, u, w with *
  have t2 := vecDotTerms.function_of at R, n, v, w with *
  have th := vecDotTerms.function_of at R, n, vecAdd(R, n, u, v), w with *
  have oneIn := Ring.one_mem at R with *
  have entries : ∀ j ∈ n, vecDotTerms(R, n, vecAdd(R, n, u, v), w)(j) = R.one * vecDotTerms(R, n, u, w)(j) + R.one * vecDotTerms(R, n, v, w)(j)
    intros j hj
    have uj := functionSpace.apply_mem with first, hj
    have vj := functionSpace.apply_mem with second, hj
    have wj := functionSpace.apply_mem with third, hj
    have e1 := vecDotTerms.at at R, n, vecAdd(R, n, u, v), w, j with *
    have e2 := vecDotTerms.at at R, n, u, w, j with *
    have e3 := vecDotTerms.at at R, n, v, w, j with *
    have e4 := vecAdd.graph_apply at R, n, u, v, j with sumValues, hj
    rw [e1, e2, e3, e4]
    ring
  have law := finiteRingSum.linear at n, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, vecDotTerms(R, n, u, w), vecDotTerms(R, n, v, w), vecDotTerms(R, n, vecAdd(R, n, u, v), w), R.one, R.one with parts, finite, t1, t2, th, oneIn, oneIn, entries
  have s1 := vecDot.mem_of at R, n, u, w with *
  have s2 := vecDot.mem_of at R, n, v, w with *
  unfold vecDot
  unfold vecDot at s1
  unfold vecDot at s2
  rw law
  ring

theorem vecDot.smul_left (n a v w : Set)
  requires finite : Finite(n)
  requires scalar : a ∈ R.carrier
  requires first : v ∈ functionSpace(n, R.carrier)
  requires second : w ∈ functionSpace(n, R.carrier)
  shows vecDot(R, n, vecSmul(R, n, a, v), w) = a * vecDot(R, n, v, w)
proof
  have parts := CommRing.parts with ring
  have scaledValues : ∀ j ∈ n, call2(R.mul, a, v(j)) ∈ R.carrier
    intros j hj
    have vj := functionSpace.apply_mem with first, hj
    exact Ring.mul_mem at R, a, v(j) with *
  have scaledF := vecSmul.graph_function at R, n, a, v with scaledValues
  have scaledS := functionSpace.mem_iff.backward with scaledF
  have t1 := vecDotTerms.function_of at R, n, v, w with *
  have th := vecDotTerms.function_of at R, n, vecSmul(R, n, a, v), w with *
  have entries : ∀ j ∈ n, vecDotTerms(R, n, vecSmul(R, n, a, v), w)(j) = a * vecDotTerms(R, n, v, w)(j)
    intros j hj
    have vj := functionSpace.apply_mem with first, hj
    have wj := functionSpace.apply_mem with second, hj
    have e1 := vecDotTerms.at at R, n, vecSmul(R, n, a, v), w, j with *
    have e2 := vecDotTerms.at at R, n, v, w, j with *
    have e3 := vecSmul.graph_apply at R, n, a, v, j with scaledValues, hj
    rw [e1, e2, e3]
    ring
  unfold vecDot
  exact finiteRingSum.scale_eq at n, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, vecDotTerms(R, n, v, w), vecDotTerms(R, n, vecSmul(R, n, a, v), w), a with parts, finite, t1, th, scalar, entries

-- dotProduct_single: v ⬝ eⱼ = v(j).
theorem vecDot.unit_vector (n v j : Set)
  requires finite : Finite(n)
  requires vector : v ∈ functionSpace(n, R.carrier)
  requires index : j ∈ n
  shows vecDot(R, n, v, unitVector(R, n, j)) = v(j)
proof
  have parts := CommRing.parts with ring
  have unitS := unitVector.mem at R, n, j with ring
  have terms := vecDotTerms.function_of at R, n, v, unitVector(R, n, j) with *
  have single : {j} ⊆ n
    intros x hx
    have same := singleton.membership.forward with hx
    rw same
    exact index
  have vanishes : ∀ x ∈ n, ¬(x ∈ {j}) → vecDotTerms(R, n, v, unitVector(R, n, j))(x) = R.zero
    intros x hx out
    have other : x ≠ j
      intro same
      rw same at out
      exact out with (singleton.self at j)
    have vx := functionSpace.apply_mem with vector, hx
    have e1 := vecDotTerms.at at R, n, v, unitVector(R, n, j), x with *
    have e2 := unitVector.apply_other at R, n, j, x with ring, hx, other
    rw [e1, e2]
    ring
  have restricted := finiteRingSum.restrict at n, {j}, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, vecDotTerms(R, n, v, unitVector(R, n, j)) with parts, finite, terms, single, vanishes
  have rF := restrict.domain_function at vecDotTerms(R, n, v, unitVector(R, n, j)), n, R.carrier, {j} with terms, single
  have one := finiteRingSum.singleton at R.carrier, R.add, R.zero, R.neg, R.mul, R.one, restrict(vecDotTerms(R, n, v, unitVector(R, n, j)), {j}), j with parts, rF
  have r0 := restrict.domain_apply at vecDotTerms(R, n, v, unitVector(R, n, j)), n, R.carrier, {j}, j with terms, single, (singleton.self at j)
  have vj := functionSpace.apply_mem with vector, index
  have e1 := vecDotTerms.at at R, n, v, unitVector(R, n, j), j with *
  have e2 := unitVector.apply_same at R, n, j with ring, index
  unfold vecDot
  rw [restricted, one, r0, e1, e2]
  ring

theorem matMul.mem (m n p A B : Set)
  requires finite : Finite(n)
  requires first : A ∈ matrixSpace(R, m, n)
  requires second : B ∈ matrixSpace(R, n, p)
  shows matMul(R, m, n, p, A, B) ∈ matrixSpace(R, m, p)
proof
  have values : ∀ i ∈ m, ∀ k ∈ p, vecDot(R, n, matRow(R, n, A, i), matCol(R, n, B, k)) ∈ R.carrier
    intros i hi k hk
    have rowS := matRow.space at R, m, n, A, i with ring, first, hi
    have colS := matCol.space at R, n, p, B, k with ring, second, hk
    exact vecDot.mem_of at R, n, matRow(R, n, A, i), matCol(R, n, B, k) with ring, finite, rowS, colS
  have function := matMul.graph_function at R, m, n, p, A, B with values
  exact matrixSpace.of_function with function

-- Matrix.mul_apply.
theorem matMul.entry (m n p A B i k : Set)
  requires finite : Finite(n)
  requires first : A ∈ matrixSpace(R, m, n)
  requires second : B ∈ matrixSpace(R, n, p)
  requires row : i ∈ m
  requires column : k ∈ p
  shows matMul(R, m, n, p, A, B)[i, k] =
    vecDot(R, n, matRow(R, n, A, i), matCol(R, n, B, k))
proof
  have values : ∀ x ∈ m, ∀ y ∈ p, vecDot(R, n, matRow(R, n, A, x), matCol(R, n, B, y)) ∈ R.carrier
    intros x hx y hy
    have rowS := matRow.space at R, m, n, A, x with ring, first, hx
    have colS := matCol.space at R, n, p, B, y with ring, second, hy
    exact vecDot.mem_of at R, n, matRow(R, n, A, x), matCol(R, n, B, y) with ring, finite, rowS, colS
  exact matMul.graph_entry at R, m, n, p, A, B, i, k with values, row, column

theorem mulVec.mem (m n A v : Set)
  requires finite : Finite(n)
  requires matrix : A ∈ matrixSpace(R, m, n)
  requires vector : v ∈ functionSpace(n, R.carrier)
  shows mulVec(R, m, n, A, v) ∈ functionSpace(m, R.carrier)
proof
  have values : ∀ i ∈ m, vecDot(R, n, matRow(R, n, A, i), v) ∈ R.carrier
    intros i hi
    have rowS := matRow.space at R, m, n, A, i with ring, matrix, hi
    exact vecDot.mem_of at R, n, matRow(R, n, A, i), v with ring, finite, rowS, vector
  have function := mulVec.graph_function at R, m, n, A, v with values
  exact functionSpace.mem_iff.backward with function

-- Matrix.mulVec_eq_sum / mulVec_apply.
theorem mulVec.apply (m n A v i : Set)
  requires finite : Finite(n)
  requires matrix : A ∈ matrixSpace(R, m, n)
  requires vector : v ∈ functionSpace(n, R.carrier)
  requires row : i ∈ m
  shows mulVec(R, m, n, A, v)(i) = vecDot(R, n, matRow(R, n, A, i), v)
proof
  have values : ∀ x ∈ m, vecDot(R, n, matRow(R, n, A, x), v) ∈ R.carrier
    intros x hx
    have rowS := matRow.space at R, m, n, A, x with ring, matrix, hx
    exact vecDot.mem_of at R, n, matRow(R, n, A, x), v with ring, finite, rowS, vector
  exact mulVec.graph_apply at R, m, n, A, v, i with values, row

theorem vecMul.apply (m n v A j : Set)
  requires finite : Finite(m)
  requires matrix : A ∈ matrixSpace(R, m, n)
  requires vector : v ∈ functionSpace(m, R.carrier)
  requires column : j ∈ n
  shows vecMul(R, m, n, v, A)(j) = vecDot(R, m, v, matCol(R, m, A, j))
proof
  have values : ∀ x ∈ n, vecDot(R, m, v, matCol(R, m, A, x)) ∈ R.carrier
    intros x hx
    have colS := matCol.space at R, m, n, A, x with ring, matrix, hx
    exact vecDot.mem_of at R, m, v, matCol(R, m, A, x) with ring, finite, vector, colS
  exact vecMul.graph_apply at R, m, n, v, A, j with values, column

theorem vecMulVec.entry (m n v w i j : Set)
  requires first : v ∈ functionSpace(m, R.carrier)
  requires second : w ∈ functionSpace(n, R.carrier)
  requires row : i ∈ m
  requires column : j ∈ n
  shows vecMulVec(R, m, n, v, w)[i, j] = v(i) * w(j)
proof
  have values : ∀ x ∈ m, ∀ y ∈ n, call2(R.mul, v(x), w(y)) ∈ R.carrier
    intros x hx y hy
    have vx := functionSpace.apply_mem with first, hx
    have wy := functionSpace.apply_mem with second, hy
    exact Ring.mul_mem at R, v(x), w(y) with *
  exact vecMulVec.graph_entry at R, m, n, v, w, i, j with values, row, column

theorem matTranspose.entry (m n A i j : Set)
  requires matrix : A ∈ matrixSpace(R, m, n)
  requires row : i ∈ m
  requires column : j ∈ n
  shows matTranspose(R, m, n, A)[j, i] = A[i, j]
proof
  have function := matrixSpace.function with matrix
  unfold matTranspose
  exact transposedMatrix.pair at m, n, R.carrier, A, i, j with function, row, column

theorem conjTranspose.entry (σ m n A i j : Set)
  requires involution : RingInvolution(σ, R)
  requires matrix : A ∈ matrixSpace(R, m, n)
  requires row : i ∈ m
  requires column : j ∈ n
  shows conjTranspose(R, σ, m, n, A)[j, i] = σ(A[i, j])
proof
  obtain ⟨comm, hom, involutive⟩ := involution
  obtain ⟨src, tgt, sF, rest⟩ := hom
  have values : ∀ x ∈ m, ∀ y ∈ n, σ(A((x, y))) ∈ R.carrier
    intros x hx y hy
    have entry := matrixSpace.entry_mem with matrix, hx, hy
    exact FunctionBetween.apply_closed with sF, entry
  exact conjTranspose.entry_of at R, σ, m, n, A, i, j with values, row, column

theorem matDiagonal.entry (n d i j : Set)
  requires vector : d ∈ functionSpace(n, R.carrier)
  requires row : i ∈ n
  requires column : j ∈ n
  shows (i = j → matDiagonal(R, n, d)[i, j] = d(i)) ∧
    (i ≠ j → matDiagonal(R, n, d)[i, j] = R.zero)
proof
  have ringR := CommRing.to_ring with ring
  exact matDiagonal.entry_of at R, n, d, i, j with ringR, vector, row, column

theorem matOne.entry (n i j : Set)
  requires row : i ∈ n
  requires column : j ∈ n
  shows (i = j → matOne(R, n)[i, j] = R.one) ∧
    (i ≠ j → matOne(R, n)[i, j] = R.zero)
proof
  have ringR := CommRing.to_ring with ring
  have oneIn := Ring.one_mem at R with ringR
  have constant := constantFunction.function at n, R.carrier, R.one with oneIn
  have vector := functionSpace.mem_iff.backward with constant
  have law := matDiagonal.entry_of at R, n, constantFunction(n, R.carrier, R.one), i, j with ringR, vector, row, column
  have c := constantFunction.apply at n, R.carrier, i, R.one with row, oneIn
  rw c at law
  unfold matOne
  exact law

theorem matMap.entry (S m n f A i j : Set)
  requires hom : RingHom(f, R, S)
  requires matrix : A ∈ matrixSpace(R, m, n)
  requires row : i ∈ m
  requires column : j ∈ n
  shows matMap(S, m, n, f, A)[i, j] = f(A[i, j])
proof
  have values : ∀ x ∈ m, ∀ y ∈ n, f(A((x, y))) ∈ S.carrier
    intros x hx y hy
    have entry := matrixSpace.entry_mem with matrix, hx, hy
    obtain ⟨src, tgt, fF, rest⟩ := hom
    exact FunctionBetween.apply_closed with fF, entry
  exact matMap.graph_entry at S, m, n, f, A, i, j with values, row, column

theorem submatrix.entry (m n m2 n2 A f g i j : Set)
  requires matrix : A ∈ matrixSpace(R, m, n)
  requires rows : f : m2 → m
  requires columns : g : n2 → n
  requires row : i ∈ m2
  requires column : j ∈ n2
  shows submatrix(R, m2, n2, A, f, g)[i, j] = A[f(i), g(j)]
proof
  have values : ∀ x ∈ m2, ∀ y ∈ n2, A((f(x), g(y))) ∈ R.carrier
    intros x hx y hy
    have fx := FunctionBetween.apply_closed with rows, hx
    have gy := FunctionBetween.apply_closed with columns, hy
    exact matrixSpace.entry_mem with matrix, fx, gy
  exact submatrix.graph_entry at R, m2, n2, A, f, g, i, j with values, row, column

theorem fromBlocks.mem (m1 m2 n1 n2 A B C D : Set)
  requires first : A ∈ matrixSpace(R, m1, n1)
  requires second : B ∈ matrixSpace(R, m1, n2)
  requires third : C ∈ matrixSpace(R, m2, n1)
  requires fourth : D ∈ matrixSpace(R, m2, n2)
  shows fromBlocks(R, m1, m2, n1, n2, A, B, C, D) ∈
    matrixSpace(R, m1 ⊎ m2, n1 ⊎ n2)
proof
  have values0 : ∀ i ∈ m1, ∀ j ∈ n1, A((i, j)) ∈ R.carrier
    intros i hi j hj
    exact matrixSpace.entry_mem with first, hi, hj
  have values1 : ∀ i ∈ m1, ∀ j ∈ n2, B((i, j)) ∈ R.carrier
    intros i hi j hj
    exact matrixSpace.entry_mem with second, hi, hj
  have values2 : ∀ i ∈ m2, ∀ j ∈ n1, C((i, j)) ∈ R.carrier
    intros i hi j hj
    exact matrixSpace.entry_mem with third, hi, hj
  have values3 : ∀ i ∈ m2, ∀ j ∈ n2, D((i, j)) ∈ R.carrier
    intros i hi j hj
    exact matrixSpace.entry_mem with fourth, hi, hj
  have function := fromBlocks.graph_function at R, m1, m2, n1, n2, A, B, C, D with values0, values1, values2, values3
  exact matrixSpace.of_function with function

-- Matrix.toBlocks_fromBlocks₁₁ (and the other three blocks alike).
theorem fromBlocks.blocks (m1 m2 n1 n2 A B C D : Set)
  requires first : A ∈ matrixSpace(R, m1, n1)
  requires second : B ∈ matrixSpace(R, m1, n2)
  requires third : C ∈ matrixSpace(R, m2, n1)
  requires fourth : D ∈ matrixSpace(R, m2, n2)
  shows submatrix(R, m1, n1, fromBlocks(R, m1, m2, n1, n2, A, B, C, D),
      leftInclusion(m1, m2), leftInclusion(n1, n2)) = A ∧
    submatrix(R, m1, n2, fromBlocks(R, m1, m2, n1, n2, A, B, C, D),
      leftInclusion(m1, m2), rightInclusion(n1, n2)) = B ∧
    submatrix(R, m2, n1, fromBlocks(R, m1, m2, n1, n2, A, B, C, D),
      rightInclusion(m1, m2), leftInclusion(n1, n2)) = C ∧
    submatrix(R, m2, n2, fromBlocks(R, m1, m2, n1, n2, A, B, C, D),
      rightInclusion(m1, m2), rightInclusion(n1, n2)) = D
proof
  have values0 : ∀ i ∈ m1, ∀ j ∈ n1, A((i, j)) ∈ R.carrier
    intros i hi j hj
    exact matrixSpace.entry_mem with first, hi, hj
  have values1 : ∀ i ∈ m1, ∀ j ∈ n2, B((i, j)) ∈ R.carrier
    intros i hi j hj
    exact matrixSpace.entry_mem with second, hi, hj
  have values2 : ∀ i ∈ m2, ∀ j ∈ n1, C((i, j)) ∈ R.carrier
    intros i hi j hj
    exact matrixSpace.entry_mem with third, hi, hj
  have values3 : ∀ i ∈ m2, ∀ j ∈ n2, D((i, j)) ∈ R.carrier
    intros i hi j hj
    exact matrixSpace.entry_mem with fourth, hi, hj
  have function := fromBlocks.graph_function at R, m1, m2, n1, n2, A, B, C, D with values0, values1, values2, values3
  have whole := matrixSpace.of_function with function
  have sub0 : submatrix(R, m1, n1, fromBlocks(R, m1, m2, n1, n2, A, B, C, D), leftInclusion(m1, m2), leftInclusion(n1, n2)) = A
    have rowsF := leftInclusion.function_of at m1, m2
    have colsF := leftInclusion.function_of at n1, n2
    have sm := submatrix.mem_of at R, m1 ⊎ m2, n1 ⊎ n2, m1, n1, fromBlocks(R, m1, m2, n1, n2, A, B, C, D), leftInclusion(m1, m2), leftInclusion(n1, n2) with whole, rowsF, colsF
    apply (matrixSpace.ext at R, m1, n1, submatrix(R, m1, n1, fromBlocks(R, m1, m2, n1, n2, A, B, C, D), leftInclusion(m1, m2), leftInclusion(n1, n2)), A with ring, sm, first).backward
    intros i hi j hj
    have e1 := submatrix.at at R, m1 ⊎ m2, n1 ⊎ n2, m1, n1, fromBlocks(R, m1, m2, n1, n2, A, B, C, D), leftInclusion(m1, m2), leftInclusion(n1, n2), i, j with whole, rowsF, colsF, hi, hj
    have e2 := leftInclusion.at at m1, m2, i with hi
    have e3 := leftInclusion.at at n1, n2, j with hj
    have e4 := fromBlocks.graph_entry0 at R, m1, m2, n1, n2, A, B, C, D, i, j with values0, values1, values2, values3, hi, hj
    rw [e1, e2, e3, e4]
  have sub1 : submatrix(R, m1, n2, fromBlocks(R, m1, m2, n1, n2, A, B, C, D), leftInclusion(m1, m2), rightInclusion(n1, n2)) = B
    have rowsF := leftInclusion.function_of at m1, m2
    have colsF := rightInclusion.function_of at n1, n2
    have sm := submatrix.mem_of at R, m1 ⊎ m2, n1 ⊎ n2, m1, n2, fromBlocks(R, m1, m2, n1, n2, A, B, C, D), leftInclusion(m1, m2), rightInclusion(n1, n2) with whole, rowsF, colsF
    apply (matrixSpace.ext at R, m1, n2, submatrix(R, m1, n2, fromBlocks(R, m1, m2, n1, n2, A, B, C, D), leftInclusion(m1, m2), rightInclusion(n1, n2)), B with ring, sm, second).backward
    intros i hi j hj
    have e1 := submatrix.at at R, m1 ⊎ m2, n1 ⊎ n2, m1, n2, fromBlocks(R, m1, m2, n1, n2, A, B, C, D), leftInclusion(m1, m2), rightInclusion(n1, n2), i, j with whole, rowsF, colsF, hi, hj
    have e2 := leftInclusion.at at m1, m2, i with hi
    have e3 := rightInclusion.at at n1, n2, j with hj
    have e4 := fromBlocks.graph_entry1 at R, m1, m2, n1, n2, A, B, C, D, i, j with values0, values1, values2, values3, hi, hj
    rw [e1, e2, e3, e4]
  have sub2 : submatrix(R, m2, n1, fromBlocks(R, m1, m2, n1, n2, A, B, C, D), rightInclusion(m1, m2), leftInclusion(n1, n2)) = C
    have rowsF := rightInclusion.function_of at m1, m2
    have colsF := leftInclusion.function_of at n1, n2
    have sm := submatrix.mem_of at R, m1 ⊎ m2, n1 ⊎ n2, m2, n1, fromBlocks(R, m1, m2, n1, n2, A, B, C, D), rightInclusion(m1, m2), leftInclusion(n1, n2) with whole, rowsF, colsF
    apply (matrixSpace.ext at R, m2, n1, submatrix(R, m2, n1, fromBlocks(R, m1, m2, n1, n2, A, B, C, D), rightInclusion(m1, m2), leftInclusion(n1, n2)), C with ring, sm, third).backward
    intros i hi j hj
    have e1 := submatrix.at at R, m1 ⊎ m2, n1 ⊎ n2, m2, n1, fromBlocks(R, m1, m2, n1, n2, A, B, C, D), rightInclusion(m1, m2), leftInclusion(n1, n2), i, j with whole, rowsF, colsF, hi, hj
    have e2 := rightInclusion.at at m1, m2, i with hi
    have e3 := leftInclusion.at at n1, n2, j with hj
    have e4 := fromBlocks.graph_entry2 at R, m1, m2, n1, n2, A, B, C, D, i, j with values0, values1, values2, values3, hi, hj
    rw [e1, e2, e3, e4]
  have sub3 : submatrix(R, m2, n2, fromBlocks(R, m1, m2, n1, n2, A, B, C, D), rightInclusion(m1, m2), rightInclusion(n1, n2)) = D
    have rowsF := rightInclusion.function_of at m1, m2
    have colsF := rightInclusion.function_of at n1, n2
    have sm := submatrix.mem_of at R, m1 ⊎ m2, n1 ⊎ n2, m2, n2, fromBlocks(R, m1, m2, n1, n2, A, B, C, D), rightInclusion(m1, m2), rightInclusion(n1, n2) with whole, rowsF, colsF
    apply (matrixSpace.ext at R, m2, n2, submatrix(R, m2, n2, fromBlocks(R, m1, m2, n1, n2, A, B, C, D), rightInclusion(m1, m2), rightInclusion(n1, n2)), D with ring, sm, fourth).backward
    intros i hi j hj
    have e1 := submatrix.at at R, m1 ⊎ m2, n1 ⊎ n2, m2, n2, fromBlocks(R, m1, m2, n1, n2, A, B, C, D), rightInclusion(m1, m2), rightInclusion(n1, n2), i, j with whole, rowsF, colsF, hi, hj
    have e2 := rightInclusion.at at m1, m2, i with hi
    have e3 := rightInclusion.at at n1, n2, j with hj
    have e4 := fromBlocks.graph_entry3 at R, m1, m2, n1, n2, A, B, C, D, i, j with values0, values1, values2, values3, hi, hj
    rw [e1, e2, e3, e4]
  exact ⟨sub0, sub1, sub2, sub3⟩

-- Matrix.fromBlocks_toBlocks: every matrix on sums is a block matrix.
theorem fromBlocks.of_blocks (m1 m2 n1 n2 M : Set)
  requires matrix : M ∈ matrixSpace(R, m1 ⊎ m2, n1 ⊎ n2)
  shows fromBlocks(R, m1, m2, n1, n2,
    submatrix(R, m1, n1, M, leftInclusion(m1, m2), leftInclusion(n1, n2)),
    submatrix(R, m1, n2, M, leftInclusion(m1, m2), rightInclusion(n1, n2)),
    submatrix(R, m2, n1, M, rightInclusion(m1, m2), leftInclusion(n1, n2)),
    submatrix(R, m2, n2, M, rightInclusion(m1, m2), rightInclusion(n1, n2))) = M
proof
  have lm := leftInclusion.function_of at m1, m2
  have rm := rightInclusion.function_of at m1, m2
  have ln := leftInclusion.function_of at n1, n2
  have rn := rightInclusion.function_of at n1, n2
  have mem0 := submatrix.mem_of at R, m1 ⊎ m2, n1 ⊎ n2, m1, n1, M, leftInclusion(m1, m2), leftInclusion(n1, n2) with matrix, lm, ln
  have values0 : ∀ i ∈ m1, ∀ j ∈ n1, submatrix(R, m1, n1, M, leftInclusion(m1, m2), leftInclusion(n1, n2))((i, j)) ∈ R.carrier
    intros i hi j hj
    exact matrixSpace.entry_mem with mem0, hi, hj
  have mem1 := submatrix.mem_of at R, m1 ⊎ m2, n1 ⊎ n2, m1, n2, M, leftInclusion(m1, m2), rightInclusion(n1, n2) with matrix, lm, rn
  have values1 : ∀ i ∈ m1, ∀ j ∈ n2, submatrix(R, m1, n2, M, leftInclusion(m1, m2), rightInclusion(n1, n2))((i, j)) ∈ R.carrier
    intros i hi j hj
    exact matrixSpace.entry_mem with mem1, hi, hj
  have mem2 := submatrix.mem_of at R, m1 ⊎ m2, n1 ⊎ n2, m2, n1, M, rightInclusion(m1, m2), leftInclusion(n1, n2) with matrix, rm, ln
  have values2 : ∀ i ∈ m2, ∀ j ∈ n1, submatrix(R, m2, n1, M, rightInclusion(m1, m2), leftInclusion(n1, n2))((i, j)) ∈ R.carrier
    intros i hi j hj
    exact matrixSpace.entry_mem with mem2, hi, hj
  have mem3 := submatrix.mem_of at R, m1 ⊎ m2, n1 ⊎ n2, m2, n2, M, rightInclusion(m1, m2), rightInclusion(n1, n2) with matrix, rm, rn
  have values3 : ∀ i ∈ m2, ∀ j ∈ n2, submatrix(R, m2, n2, M, rightInclusion(m1, m2), rightInclusion(n1, n2))((i, j)) ∈ R.carrier
    intros i hi j hj
    exact matrixSpace.entry_mem with mem3, hi, hj
  have function := fromBlocks.graph_function at R, m1, m2, n1, n2, submatrix(R, m1, n1, M, leftInclusion(m1, m2), leftInclusion(n1, n2)), submatrix(R, m1, n2, M, leftInclusion(m1, m2), rightInclusion(n1, n2)), submatrix(R, m2, n1, M, rightInclusion(m1, m2), leftInclusion(n1, n2)), submatrix(R, m2, n2, M, rightInclusion(m1, m2), rightInclusion(n1, n2)) with values0, values1, values2, values3
  have whole := matrixSpace.of_function with function
  apply (matrixSpace.ext at R, m1 ⊎ m2, n1 ⊎ n2, fromBlocks(R, m1, m2, n1, n2, submatrix(R, m1, n1, M, leftInclusion(m1, m2), leftInclusion(n1, n2)), submatrix(R, m1, n2, M, leftInclusion(m1, m2), rightInclusion(n1, n2)), submatrix(R, m2, n1, M, rightInclusion(m1, m2), leftInclusion(n1, n2)), submatrix(R, m2, n2, M, rightInclusion(m1, m2), rightInclusion(n1, n2))), M with ring, whole, matrix).backward
  intros x hx y hy
  have sx := disjointSum.membership.forward with hx
  have sy := disjointSum.membership.forward with hy
  cases sx with lx | rx
  . obtain ⟨i, hi, xShape⟩ := lx
    cases sy with ly | ry
    . obtain ⟨j, hj, yShape⟩ := ly
      rw [xShape, yShape]
      have e1 := fromBlocks.graph_entry0 at R, m1, m2, n1, n2, submatrix(R, m1, n1, M, leftInclusion(m1, m2), leftInclusion(n1, n2)), submatrix(R, m1, n2, M, leftInclusion(m1, m2), rightInclusion(n1, n2)), submatrix(R, m2, n1, M, rightInclusion(m1, m2), leftInclusion(n1, n2)), submatrix(R, m2, n2, M, rightInclusion(m1, m2), rightInclusion(n1, n2)), i, j with values0, values1, values2, values3, hi, hj
      have e2 := submatrix.at at R, m1 ⊎ m2, n1 ⊎ n2, m1, n1, M, leftInclusion(m1, m2), leftInclusion(n1, n2), i, j with matrix, lm, ln, hi, hj
      have e3 := leftInclusion.at at m1, m2, i with hi
      have e4 := leftInclusion.at at n1, n2, j with hj
      rw [e1, e2, e3, e4]
    . obtain ⟨j, hj, yShape⟩ := ry
      rw [xShape, yShape]
      have e1 := fromBlocks.graph_entry1 at R, m1, m2, n1, n2, submatrix(R, m1, n1, M, leftInclusion(m1, m2), leftInclusion(n1, n2)), submatrix(R, m1, n2, M, leftInclusion(m1, m2), rightInclusion(n1, n2)), submatrix(R, m2, n1, M, rightInclusion(m1, m2), leftInclusion(n1, n2)), submatrix(R, m2, n2, M, rightInclusion(m1, m2), rightInclusion(n1, n2)), i, j with values0, values1, values2, values3, hi, hj
      have e2 := submatrix.at at R, m1 ⊎ m2, n1 ⊎ n2, m1, n2, M, leftInclusion(m1, m2), rightInclusion(n1, n2), i, j with matrix, lm, rn, hi, hj
      have e3 := leftInclusion.at at m1, m2, i with hi
      have e4 := rightInclusion.at at n1, n2, j with hj
      rw [e1, e2, e3, e4]
  . obtain ⟨i, hi, xShape⟩ := rx
    cases sy with ly | ry
    . obtain ⟨j, hj, yShape⟩ := ly
      rw [xShape, yShape]
      have e1 := fromBlocks.graph_entry2 at R, m1, m2, n1, n2, submatrix(R, m1, n1, M, leftInclusion(m1, m2), leftInclusion(n1, n2)), submatrix(R, m1, n2, M, leftInclusion(m1, m2), rightInclusion(n1, n2)), submatrix(R, m2, n1, M, rightInclusion(m1, m2), leftInclusion(n1, n2)), submatrix(R, m2, n2, M, rightInclusion(m1, m2), rightInclusion(n1, n2)), i, j with values0, values1, values2, values3, hi, hj
      have e2 := submatrix.at at R, m1 ⊎ m2, n1 ⊎ n2, m2, n1, M, rightInclusion(m1, m2), leftInclusion(n1, n2), i, j with matrix, rm, ln, hi, hj
      have e3 := rightInclusion.at at m1, m2, i with hi
      have e4 := leftInclusion.at at n1, n2, j with hj
      rw [e1, e2, e3, e4]
    . obtain ⟨j, hj, yShape⟩ := ry
      rw [xShape, yShape]
      have e1 := fromBlocks.graph_entry3 at R, m1, m2, n1, n2, submatrix(R, m1, n1, M, leftInclusion(m1, m2), leftInclusion(n1, n2)), submatrix(R, m1, n2, M, leftInclusion(m1, m2), rightInclusion(n1, n2)), submatrix(R, m2, n1, M, rightInclusion(m1, m2), leftInclusion(n1, n2)), submatrix(R, m2, n2, M, rightInclusion(m1, m2), rightInclusion(n1, n2)), i, j with values0, values1, values2, values3, hi, hj
      have e2 := submatrix.at at R, m1 ⊎ m2, n1 ⊎ n2, m2, n2, M, rightInclusion(m1, m2), rightInclusion(n1, n2), i, j with matrix, rm, rn, hi, hj
      have e3 := rightInclusion.at at m1, m2, i with hi
      have e4 := rightInclusion.at at n1, n2, j with hj
      rw [e1, e2, e3, e4]

theorem fromRows.mem (m1 m2 n A C : Set)
  requires first : A ∈ matrixSpace(R, m1, n)
  requires second : C ∈ matrixSpace(R, m2, n)
  shows fromRows(R, m1, m2, n, A, C) ∈ matrixSpace(R, m1 ⊎ m2, n)
proof
  have values0 : ∀ i ∈ m1, ∀ j ∈ n, A((i, j)) ∈ R.carrier
    intros i hi j hj
    exact matrixSpace.entry_mem with first, hi, hj
  have values1 : ∀ i ∈ m2, ∀ j ∈ n, C((i, j)) ∈ R.carrier
    intros i hi j hj
    exact matrixSpace.entry_mem with second, hi, hj
  have function := fromRows.graph_function at R, m1, m2, n, A, C with values0, values1
  exact matrixSpace.of_function with function

theorem fromCols.mem (m n1 n2 A B : Set)
  requires first : A ∈ matrixSpace(R, m, n1)
  requires second : B ∈ matrixSpace(R, m, n2)
  shows fromCols(R, m, n1, n2, A, B) ∈ matrixSpace(R, m, n1 ⊎ n2)
proof
  have values0 : ∀ i ∈ m, ∀ j ∈ n1, A((i, j)) ∈ R.carrier
    intros i hi j hj
    exact matrixSpace.entry_mem with first, hi, hj
  have values1 : ∀ i ∈ m, ∀ j ∈ n2, B((i, j)) ∈ R.carrier
    intros i hi j hj
    exact matrixSpace.entry_mem with second, hi, hj
  have function := fromCols.graph_function at R, m, n1, n2, A, B with values0, values1
  exact matrixSpace.of_function with function

end Entries

-- Section: Algebra of matrices
section Products
variable (R : Set)
hypothesis ring : CommRing(R)

-- Matrix.mul_assoc.
theorem matMul.assoc (m n p q A B C : Set)
  requires finiteN : Finite(n)
  requires finiteP : Finite(p)
  requires first : A ∈ matrixSpace(R, m, n)
  requires second : B ∈ matrixSpace(R, n, p)
  requires third : C ∈ matrixSpace(R, p, q)
  shows matMul(R, m, p, q, matMul(R, m, n, p, A, B), C) =
    matMul(R, m, n, q, A, matMul(R, n, p, q, B, C))
proof
  sorry

-- Matrix.mul_add and Matrix.add_mul.
theorem matMul.add_right (m n p A B C : Set)
  requires finite : Finite(n)
  requires first : A ∈ matrixSpace(R, m, n)
  requires second : B ∈ matrixSpace(R, n, p)
  requires third : C ∈ matrixSpace(R, n, p)
  shows matMul(R, m, n, p, A, matAdd(R, n, p, B, C)) =
    matAdd(R, m, p, matMul(R, m, n, p, A, B), matMul(R, m, n, p, A, C))
proof
  have bc := matAdd.mem_of at R, n, p, B, C with ring, second, third
  have left := matMul.mem_of at R, m, n, p, A, matAdd(R, n, p, B, C) with ring, finite, first, bc
  have ab := matMul.mem_of at R, m, n, p, A, B with ring, finite, first, second
  have ac := matMul.mem_of at R, m, n, p, A, C with ring, finite, first, third
  have right := matAdd.mem_of at R, m, p, matMul(R, m, n, p, A, B), matMul(R, m, n, p, A, C) with ring, ab, ac
  apply (matrixSpace.ext at R, m, p, matMul(R, m, n, p, A, matAdd(R, n, p, B, C)), matAdd(R, m, p, matMul(R, m, n, p, A, B), matMul(R, m, n, p, A, C)) with ring, left, right).backward
  intros i hi k hk
  have rowS := matRow.space at R, m, n, A, i with ring, first, hi
  have colBC := matCol.space at R, n, p, matAdd(R, n, p, B, C), k with ring, bc, hk
  have colB := matCol.space at R, n, p, B, k with ring, second, hk
  have colC := matCol.space at R, n, p, C, k with ring, third, hk
  have e1 := matMul.at at R, m, n, p, A, matAdd(R, n, p, B, C), i, k with ring, finite, first, bc, hi, hk
  have e2 := matAdd.at at R, m, p, matMul(R, m, n, p, A, B), matMul(R, m, n, p, A, C), i, k with ring, ab, ac, hi, hk
  have e3 := matMul.at at R, m, n, p, A, B, i, k with ring, finite, first, second, hi, hk
  have e4 := matMul.at at R, m, n, p, A, C, i, k with ring, finite, first, third, hi, hk
  rw [e1, e2, e3, e4]
  apply vecDot.sum_of at R, n, matRow(R, n, A, i), matCol(R, n, matAdd(R, n, p, B, C), k), matRow(R, n, A, i), matCol(R, n, B, k), matRow(R, n, A, i), matCol(R, n, C, k) with ring, finite, rowS, colBC, rowS, colB, rowS, colC
  intros j hj
  have a := matrixSpace.entry_mem with first, hi, hj
  have b := matrixSpace.entry_mem with second, hj, hk
  have c := matrixSpace.entry_mem with third, hj, hk
  have f1 := matRow.at at R, m, n, A, i, j with ring, first, hi, hj
  have f2 := matCol.at at R, n, p, matAdd(R, n, p, B, C), j, k with ring, bc, hj, hk
  have f3 := matCol.at at R, n, p, B, j, k with ring, second, hj, hk
  have f4 := matCol.at at R, n, p, C, j, k with ring, third, hj, hk
  have f5 := matAdd.at at R, n, p, B, C, j, k with ring, second, third, hj, hk
  rw [f1, f2, f3, f4, f5]
  ring

theorem matMul.add_left (m n p A B C : Set)
  requires finite : Finite(n)
  requires first : A ∈ matrixSpace(R, m, n)
  requires second : B ∈ matrixSpace(R, m, n)
  requires third : C ∈ matrixSpace(R, n, p)
  shows matMul(R, m, n, p, matAdd(R, m, n, A, B), C) =
    matAdd(R, m, p, matMul(R, m, n, p, A, C), matMul(R, m, n, p, B, C))
proof
  have ab := matAdd.mem_of at R, m, n, A, B with ring, first, second
  have left := matMul.mem_of at R, m, n, p, matAdd(R, m, n, A, B), C with ring, finite, ab, third
  have ac := matMul.mem_of at R, m, n, p, A, C with ring, finite, first, third
  have bc := matMul.mem_of at R, m, n, p, B, C with ring, finite, second, third
  have right := matAdd.mem_of at R, m, p, matMul(R, m, n, p, A, C), matMul(R, m, n, p, B, C) with ring, ac, bc
  apply (matrixSpace.ext at R, m, p, matMul(R, m, n, p, matAdd(R, m, n, A, B), C), matAdd(R, m, p, matMul(R, m, n, p, A, C), matMul(R, m, n, p, B, C)) with ring, left, right).backward
  intros i hi k hk
  have rowAB := matRow.space at R, m, n, matAdd(R, m, n, A, B), i with ring, ab, hi
  have rowA := matRow.space at R, m, n, A, i with ring, first, hi
  have rowB := matRow.space at R, m, n, B, i with ring, second, hi
  have colC := matCol.space at R, n, p, C, k with ring, third, hk
  have e1 := matMul.at at R, m, n, p, matAdd(R, m, n, A, B), C, i, k with ring, finite, ab, third, hi, hk
  have e2 := matAdd.at at R, m, p, matMul(R, m, n, p, A, C), matMul(R, m, n, p, B, C), i, k with ring, ac, bc, hi, hk
  have e3 := matMul.at at R, m, n, p, A, C, i, k with ring, finite, first, third, hi, hk
  have e4 := matMul.at at R, m, n, p, B, C, i, k with ring, finite, second, third, hi, hk
  rw [e1, e2, e3, e4]
  apply vecDot.sum_of at R, n, matRow(R, n, matAdd(R, m, n, A, B), i), matCol(R, n, C, k), matRow(R, n, A, i), matCol(R, n, C, k), matRow(R, n, B, i), matCol(R, n, C, k) with ring, finite, rowAB, colC, rowA, colC, rowB, colC
  intros j hj
  have a := matrixSpace.entry_mem with first, hi, hj
  have b := matrixSpace.entry_mem with second, hi, hj
  have c := matrixSpace.entry_mem with third, hj, hk
  have f1 := matRow.at at R, m, n, matAdd(R, m, n, A, B), i, j with ring, ab, hi, hj
  have f2 := matRow.at at R, m, n, A, i, j with ring, first, hi, hj
  have f3 := matRow.at at R, m, n, B, i, j with ring, second, hi, hj
  have f4 := matCol.at at R, n, p, C, j, k with ring, third, hj, hk
  have f5 := matAdd.at at R, m, n, A, B, i, j with ring, first, second, hi, hj
  rw [f1, f2, f3, f4, f5]
  ring

theorem matMul.smul_left (m n p a A B : Set)
  requires finite : Finite(n)
  requires scalar : a ∈ R.carrier
  requires first : A ∈ matrixSpace(R, m, n)
  requires second : B ∈ matrixSpace(R, n, p)
  shows matMul(R, m, n, p, matSmul(R, m, n, a, A), B) =
    matSmul(R, m, p, a, matMul(R, m, n, p, A, B))
proof
  have aA := matSmul.mem_of at R, m, n, a, A with ring, scalar, first
  have left := matMul.mem_of at R, m, n, p, matSmul(R, m, n, a, A), B with ring, finite, aA, second
  have ab := matMul.mem_of at R, m, n, p, A, B with ring, finite, first, second
  have right := matSmul.mem_of at R, m, p, a, matMul(R, m, n, p, A, B) with ring, scalar, ab
  apply (matrixSpace.ext at R, m, p, matMul(R, m, n, p, matSmul(R, m, n, a, A), B), matSmul(R, m, p, a, matMul(R, m, n, p, A, B)) with ring, left, right).backward
  intros i hi k hk
  have rowAA := matRow.space at R, m, n, matSmul(R, m, n, a, A), i with ring, aA, hi
  have rowA := matRow.space at R, m, n, A, i with ring, first, hi
  have colB := matCol.space at R, n, p, B, k with ring, second, hk
  have e1 := matMul.at at R, m, n, p, matSmul(R, m, n, a, A), B, i, k with ring, finite, aA, second, hi, hk
  have e2 := matSmul.at at R, m, p, a, matMul(R, m, n, p, A, B), i, k with ring, scalar, ab, hi, hk
  have e3 := matMul.at at R, m, n, p, A, B, i, k with ring, finite, first, second, hi, hk
  rw [e1, e2, e3]
  apply vecDot.scale_of at R, n, matRow(R, n, matSmul(R, m, n, a, A), i), matCol(R, n, B, k), a, matRow(R, n, A, i), matCol(R, n, B, k) with ring, finite, scalar, rowAA, colB, rowA, colB
  intros j hj
  have x := matrixSpace.entry_mem with first, hi, hj
  have y := matrixSpace.entry_mem with second, hj, hk
  have f1 := matRow.at at R, m, n, matSmul(R, m, n, a, A), i, j with ring, aA, hi, hj
  have f2 := matRow.at at R, m, n, A, i, j with ring, first, hi, hj
  have f3 := matCol.at at R, n, p, B, j, k with ring, second, hj, hk
  have f4 := matSmul.at at R, m, n, a, A, i, j with ring, scalar, first, hi, hj
  rw [f1, f2, f3, f4]
  ring

theorem matMul.one_left (m n A : Set)
  requires finite : Finite(m)
  requires matrix : A ∈ matrixSpace(R, m, n)
  shows matMul(R, m, m, n, matOne(R, m), A) = A
proof
  have one := matOne.mem_of at R, m with ring
  have left := matMul.mem_of at R, m, m, n, matOne(R, m), A with ring, finite, one, matrix
  apply (matrixSpace.ext at R, m, n, matMul(R, m, m, n, matOne(R, m), A), A with ring, left, matrix).backward
  intros i hi k hk
  have rowS := matRow.space at R, m, m, matOne(R, m), i with ring, one, hi
  have colS := matCol.space at R, m, n, A, k with ring, matrix, hk
  have e1 := matMul.at at R, m, m, n, matOne(R, m), A, i, k with ring, finite, one, matrix, hi, hk
  have vanish : ∀ j ∈ m, j ≠ i → matRow(R, m, matOne(R, m), i)(j) * matCol(R, m, A, k)(j) = R.zero
    intros j hj other
    have different : i ≠ j
      intro same
      have back : j = i
        symm
        exact same
      exact other with back
    have f1 := matRow.at at R, m, m, matOne(R, m), i, j with ring, one, hi, hj
    have f2 := matCol.at at R, m, n, A, j, k with ring, matrix, hj, hk
    have z := matOne.other at R, m, i, j with ring, hi, hj, different
    have a := matrixSpace.entry_mem with matrix, hj, hk
    rw [f1, f2, z]
    ring
  have single := vecDot.single_of at R, m, matRow(R, m, matOne(R, m), i), matCol(R, m, A, k), i with ring, finite, rowS, colS, hi, vanish
  have f1 := matRow.at at R, m, m, matOne(R, m), i, i with ring, one, hi, hi
  have f2 := matCol.at at R, m, n, A, i, k with ring, matrix, hi, hk
  have o := matOne.same at R, m, i with ring, hi
  have a := matrixSpace.entry_mem with matrix, hi, hk
  rw [e1, single, f1, f2, o]
  ring

theorem matMul.one_right (m n A : Set)
  requires finite : Finite(n)
  requires matrix : A ∈ matrixSpace(R, m, n)
  shows matMul(R, m, n, n, A, matOne(R, n)) = A
proof
  have one := matOne.mem_of at R, n with ring
  have left := matMul.mem_of at R, m, n, n, A, matOne(R, n) with ring, finite, matrix, one
  apply (matrixSpace.ext at R, m, n, matMul(R, m, n, n, A, matOne(R, n)), A with ring, left, matrix).backward
  intros i hi k hk
  have rowS := matRow.space at R, m, n, A, i with ring, matrix, hi
  have colS := matCol.space at R, n, n, matOne(R, n), k with ring, one, hk
  have e1 := matMul.at at R, m, n, n, A, matOne(R, n), i, k with ring, finite, matrix, one, hi, hk
  have vanish : ∀ j ∈ n, j ≠ k → matRow(R, n, A, i)(j) * matCol(R, n, matOne(R, n), k)(j) = R.zero
    intros j hj other
    have f1 := matRow.at at R, m, n, A, i, j with ring, matrix, hi, hj
    have f2 := matCol.at at R, n, n, matOne(R, n), j, k with ring, one, hj, hk
    have z := matOne.other at R, n, j, k with ring, hj, hk, other
    have a := matrixSpace.entry_mem with matrix, hi, hj
    rw [f1, f2, z]
    ring
  have single := vecDot.single_of at R, n, matRow(R, n, A, i), matCol(R, n, matOne(R, n), k), k with ring, finite, rowS, colS, hk, vanish
  have f1 := matRow.at at R, m, n, A, i, k with ring, matrix, hi, hk
  have f2 := matCol.at at R, n, n, matOne(R, n), k, k with ring, one, hk, hk
  have o := matOne.same at R, n, k with ring, hk
  have a := matrixSpace.entry_mem with matrix, hi, hk
  rw [e1, single, f1, f2, o]
  ring

-- Matrix.diagonal_mul_diagonal and the action of diagonal matrices on
-- rows and columns (diagonal_mul, mul_diagonal).
theorem matDiagonal.mul_diagonal (n d e : Set)
  requires finite : Finite(n)
  requires first : d ∈ functionSpace(n, R.carrier)
  requires second : e ∈ functionSpace(n, R.carrier)
  shows matMul(R, n, n, n, matDiagonal(R, n, d), matDiagonal(R, n, e)) =
    matDiagonal(R, n, vecDotTerms(R, n, d, e))
proof
  have ringR := CommRing.to_ring with ring
  have dd := matDiagonal.mem_of at R, n, d with ring, first
  have ee := matDiagonal.mem_of at R, n, e with ring, second
  have terms := vecDotTerms.function_of at R, n, d, e with ring, first, second
  have termsS := functionSpace.mem_iff.backward with terms
  have left := matMul.mem_of at R, n, n, n, matDiagonal(R, n, d), matDiagonal(R, n, e) with ring, finite, dd, ee
  have right := matDiagonal.mem_of at R, n, vecDotTerms(R, n, d, e) with ring, termsS
  apply (matrixSpace.ext at R, n, n, matMul(R, n, n, n, matDiagonal(R, n, d), matDiagonal(R, n, e)), matDiagonal(R, n, vecDotTerms(R, n, d, e)) with ring, left, right).backward
  intros i hi k hk
  have rowS := matRow.space at R, n, n, matDiagonal(R, n, d), i with ring, dd, hi
  have colS := matCol.space at R, n, n, matDiagonal(R, n, e), k with ring, ee, hk
  have e1 := matMul.at at R, n, n, n, matDiagonal(R, n, d), matDiagonal(R, n, e), i, k with ring, finite, dd, ee, hi, hk
  have vanish : ∀ x ∈ n, x ≠ i → matRow(R, n, matDiagonal(R, n, d), i)(x) * matCol(R, n, matDiagonal(R, n, e), k)(x) = R.zero
    intros x hx other
    have different : i ≠ x
      intro same
      have back : x = i
        symm
        exact same
      exact other with back
    have f1 := matRow.at at R, n, n, matDiagonal(R, n, d), i, x with ring, dd, hi, hx
    have f2 := matCol.at at R, n, n, matDiagonal(R, n, e), x, k with ring, ee, hx, hk
    obtain ⟨_, off⟩ := matDiagonal.entry_of at R, n, d, i, x with ringR, first, hi, hx
    have z := off with different
    have a := matrixSpace.entry_mem with ee, hx, hk
    rw [f1, f2, z]
    ring
  have single := vecDot.single_of at R, n, matRow(R, n, matDiagonal(R, n, d), i), matCol(R, n, matDiagonal(R, n, e), k), i with ring, finite, rowS, colS, hi, vanish
  have f1 := matRow.at at R, n, n, matDiagonal(R, n, d), i, i with ring, dd, hi, hi
  have f2 := matCol.at at R, n, n, matDiagonal(R, n, e), i, k with ring, ee, hi, hk
  obtain ⟨onD, _⟩ := matDiagonal.entry_of at R, n, d, i, i with ringR, first, hi, hi
  have o := onD with rfl
  rw [e1, single, f1, f2, o]
  obtain ⟨onE, offE⟩ := matDiagonal.entry_of at R, n, e, i, k with ringR, second, hi, hk
  obtain ⟨onT, offT⟩ := matDiagonal.entry_of at R, n, vecDotTerms(R, n, d, e), i, k with ringR, termsS, hi, hk
  have di := functionSpace.apply_mem with first, hi
  by_cases same : i = k
  . have x1 := onE with same
    have x2 := onT with same
    have t := vecDotTerms.at at R, n, d, e, i with ring, first, second, hi
    rw [x1, x2, t]
  . have x1 := offE with same
    have x2 := offT with same
    rw [x1, x2]
    ring

theorem matDiagonal.mul_left_entry (m n d A i j : Set)
  requires finite : Finite(m)
  requires vector : d ∈ functionSpace(m, R.carrier)
  requires matrix : A ∈ matrixSpace(R, m, n)
  requires row : i ∈ m
  requires column : j ∈ n
  shows matMul(R, m, m, n, matDiagonal(R, m, d), A)[i, j] = d(i) * A[i, j]
proof
  have ringR := CommRing.to_ring with ring
  have diag := matDiagonal.mem_of at R, m, d with ring, vector
  have rowS := matRow.space at R, m, m, matDiagonal(R, m, d), i with ring, diag, row
  have colS := matCol.space at R, m, n, A, j with ring, matrix, column
  have e1 := matMul.at at R, m, m, n, matDiagonal(R, m, d), A, i, j with ring, finite, diag, matrix, row, column
  have vanish : ∀ x ∈ m, x ≠ i → matRow(R, m, matDiagonal(R, m, d), i)(x) * matCol(R, m, A, j)(x) = R.zero
    intros x hx other
    have different : i ≠ x
      intro same
      have back : x = i
        symm
        exact same
      exact other with back
    have f1 := matRow.at at R, m, m, matDiagonal(R, m, d), i, x with ring, diag, row, hx
    have f2 := matCol.at at R, m, n, A, x, j with ring, matrix, hx, column
    obtain ⟨_, off⟩ := matDiagonal.entry_of at R, m, d, i, x with ringR, vector, row, hx
    have z := off with different
    have a := matrixSpace.entry_mem with matrix, hx, column
    rw [f1, f2, z]
    ring
  have single := vecDot.single_of at R, m, matRow(R, m, matDiagonal(R, m, d), i), matCol(R, m, A, j), i with ring, finite, rowS, colS, row, vanish
  have f1 := matRow.at at R, m, m, matDiagonal(R, m, d), i, i with ring, diag, row, row
  have f2 := matCol.at at R, m, n, A, i, j with ring, matrix, row, column
  obtain ⟨on, _⟩ := matDiagonal.entry_of at R, m, d, i, i with ringR, vector, row, row
  have o := on with rfl
  rw [e1, single, f1, f2, o]

-- Matrix.smul_eq_diagonal_mul: a A = (a·1) A.
theorem matScalar.mul (m n a A : Set)
  requires finite : Finite(m)
  requires scalar : a ∈ R.carrier
  requires matrix : A ∈ matrixSpace(R, m, n)
  shows matMul(R, m, m, n, matScalar(R, m, a), A) = matSmul(R, m, n, a, A)
proof
  have ringR := CommRing.to_ring with ring
  have constant := constantFunction.function at m, R.carrier, a with scalar
  have vector := functionSpace.mem_iff.backward with constant
  have diag := matDiagonal.mem_of at R, m, constantFunction(m, R.carrier, a) with ring, vector
  have left := matMul.mem_of at R, m, m, n, matDiagonal(R, m, constantFunction(m, R.carrier, a)), A with ring, finite, diag, matrix
  have right := matSmul.mem_of at R, m, n, a, A with ring, scalar, matrix
  unfold matScalar
  apply (matrixSpace.ext at R, m, n, matMul(R, m, m, n, matDiagonal(R, m, constantFunction(m, R.carrier, a)), A), matSmul(R, m, n, a, A) with ring, left, right).backward
  intros i hi j hj
  have e1 := matDiagonal.mul_left_entry at R, m, n, constantFunction(m, R.carrier, a), A, i, j with ring, finite, vector, matrix, hi, hj
  have e2 := matSmul.at at R, m, n, a, A, i, j with ring, scalar, matrix, hi, hj
  have c := constantFunction.apply at m, R.carrier, i, a with hi, scalar
  rw [e1, e2, c]

-- Matrix.mulVec_mulVec: A (B v) = (A B) v.
theorem mulVec.mulVec (m n p A B v : Set)
  requires finiteN : Finite(n)
  requires finiteP : Finite(p)
  requires first : A ∈ matrixSpace(R, m, n)
  requires second : B ∈ matrixSpace(R, n, p)
  requires vector : v ∈ functionSpace(p, R.carrier)
  shows mulVec(R, m, n, A, mulVec(R, n, p, B, v)) =
    mulVec(R, m, p, matMul(R, m, n, p, A, B), v)
proof
  sorry

-- Matrix.mulVec_add, mulVec_smul, add_mulVec.
theorem mulVec.add (m n A v w : Set)
  requires finite : Finite(n)
  requires matrix : A ∈ matrixSpace(R, m, n)
  requires first : v ∈ functionSpace(n, R.carrier)
  requires second : w ∈ functionSpace(n, R.carrier)
  shows mulVec(R, m, n, A, vecAdd(R, n, v, w)) =
    vecAdd(R, m, mulVec(R, m, n, A, v), mulVec(R, m, n, A, w))
proof
  have vw := vecAdd.space at R, n, v, w with ring, first, second
  have left := mulVec.mem at R, m, n, A, vecAdd(R, n, v, w) with ring, finite, matrix, vw
  have av := mulVec.mem at R, m, n, A, v with ring, finite, matrix, first
  have aw := mulVec.mem at R, m, n, A, w with ring, finite, matrix, second
  have right := vecAdd.space at R, m, mulVec(R, m, n, A, v), mulVec(R, m, n, A, w) with ring, av, aw
  apply functionSpace.ext_of with left, right
  intros i hi
  have rowS := matRow.space at R, m, n, A, i with ring, matrix, hi
  have e1 := mulVec.apply at R, m, n, A, vecAdd(R, n, v, w), i with ring, finite, matrix, vw, hi
  have e2 := vecAdd.at at R, m, mulVec(R, m, n, A, v), mulVec(R, m, n, A, w), i with ring, av, aw, hi
  have e3 := mulVec.apply at R, m, n, A, v, i with ring, finite, matrix, first, hi
  have e4 := mulVec.apply at R, m, n, A, w, i with ring, finite, matrix, second, hi
  rw [e1, e2, e3, e4]
  apply vecDot.sum_of at R, n, matRow(R, n, A, i), vecAdd(R, n, v, w), matRow(R, n, A, i), v, matRow(R, n, A, i), w with ring, finite, rowS, vw, rowS, first, rowS, second
  intros j hj
  have a := matrixSpace.entry_mem with matrix, hi, hj
  have b := functionSpace.apply_mem with first, hj
  have c := functionSpace.apply_mem with second, hj
  have f1 := matRow.at at R, m, n, A, i, j with ring, matrix, hi, hj
  have f2 := vecAdd.at at R, n, v, w, j with ring, first, second, hj
  rw [f1, f2]
  ring

theorem mulVec.smul (m n A a v : Set)
  requires finite : Finite(n)
  requires matrix : A ∈ matrixSpace(R, m, n)
  requires scalar : a ∈ R.carrier
  requires vector : v ∈ functionSpace(n, R.carrier)
  shows mulVec(R, m, n, A, vecSmul(R, n, a, v)) = vecSmul(R, m, a, mulVec(R, m, n, A, v))
proof
  have av0 := vecSmul.space at R, n, a, v with ring, scalar, vector
  have left := mulVec.mem at R, m, n, A, vecSmul(R, n, a, v) with ring, finite, matrix, av0
  have av := mulVec.mem at R, m, n, A, v with ring, finite, matrix, vector
  have right := vecSmul.space at R, m, a, mulVec(R, m, n, A, v) with ring, scalar, av
  apply functionSpace.ext_of with left, right
  intros i hi
  have rowS := matRow.space at R, m, n, A, i with ring, matrix, hi
  have e1 := mulVec.apply at R, m, n, A, vecSmul(R, n, a, v), i with ring, finite, matrix, av0, hi
  have e2 := vecSmul.at at R, m, a, mulVec(R, m, n, A, v), i with ring, scalar, av, hi
  have e3 := mulVec.apply at R, m, n, A, v, i with ring, finite, matrix, vector, hi
  rw [e1, e2, e3]
  apply vecDot.scale_of at R, n, matRow(R, n, A, i), vecSmul(R, n, a, v), a, matRow(R, n, A, i), v with ring, finite, scalar, rowS, av0, rowS, vector
  intros j hj
  have x := matrixSpace.entry_mem with matrix, hi, hj
  have y := functionSpace.apply_mem with vector, hj
  have f1 := matRow.at at R, m, n, A, i, j with ring, matrix, hi, hj
  have f2 := vecSmul.at at R, n, a, v, j with ring, scalar, vector, hj
  rw [f1, f2]
  ring

theorem mulVec.add_matrix (m n A B v : Set)
  requires finite : Finite(n)
  requires first : A ∈ matrixSpace(R, m, n)
  requires second : B ∈ matrixSpace(R, m, n)
  requires vector : v ∈ functionSpace(n, R.carrier)
  shows mulVec(R, m, n, matAdd(R, m, n, A, B), v) =
    vecAdd(R, m, mulVec(R, m, n, A, v), mulVec(R, m, n, B, v))
proof
  have ab := matAdd.mem_of at R, m, n, A, B with ring, first, second
  have left := mulVec.mem at R, m, n, matAdd(R, m, n, A, B), v with ring, finite, ab, vector
  have av := mulVec.mem at R, m, n, A, v with ring, finite, first, vector
  have bv := mulVec.mem at R, m, n, B, v with ring, finite, second, vector
  have right := vecAdd.space at R, m, mulVec(R, m, n, A, v), mulVec(R, m, n, B, v) with ring, av, bv
  apply functionSpace.ext_of with left, right
  intros i hi
  have rowAB := matRow.space at R, m, n, matAdd(R, m, n, A, B), i with ring, ab, hi
  have rowA := matRow.space at R, m, n, A, i with ring, first, hi
  have rowB := matRow.space at R, m, n, B, i with ring, second, hi
  have e1 := mulVec.apply at R, m, n, matAdd(R, m, n, A, B), v, i with ring, finite, ab, vector, hi
  have e2 := vecAdd.at at R, m, mulVec(R, m, n, A, v), mulVec(R, m, n, B, v), i with ring, av, bv, hi
  have e3 := mulVec.apply at R, m, n, A, v, i with ring, finite, first, vector, hi
  have e4 := mulVec.apply at R, m, n, B, v, i with ring, finite, second, vector, hi
  rw [e1, e2, e3, e4]
  apply vecDot.sum_of at R, n, matRow(R, n, matAdd(R, m, n, A, B), i), v, matRow(R, n, A, i), v, matRow(R, n, B, i), v with ring, finite, rowAB, vector, rowA, vector, rowB, vector
  intros j hj
  have a := matrixSpace.entry_mem with first, hi, hj
  have b := matrixSpace.entry_mem with second, hi, hj
  have c := functionSpace.apply_mem with vector, hj
  have f1 := matRow.at at R, m, n, matAdd(R, m, n, A, B), i, j with ring, ab, hi, hj
  have f2 := matRow.at at R, m, n, A, i, j with ring, first, hi, hj
  have f3 := matRow.at at R, m, n, B, i, j with ring, second, hi, hj
  have f4 := matAdd.at at R, m, n, A, B, i, j with ring, first, second, hi, hj
  rw [f1, f2, f3, f4]
  ring

theorem mulVec.one (n v : Set)
  requires finite : Finite(n)
  requires vector : v ∈ functionSpace(n, R.carrier)
  shows mulVec(R, n, n, matOne(R, n), v) = v
proof
  have one := matOne.mem_of at R, n with ring
  have left := mulVec.mem at R, n, n, matOne(R, n), v with ring, finite, one, vector
  apply functionSpace.ext_of with left, vector
  intros i hi
  have rowS := matRow.space at R, n, n, matOne(R, n), i with ring, one, hi
  have e1 := mulVec.apply at R, n, n, matOne(R, n), v, i with ring, finite, one, vector, hi
  have vanish : ∀ j ∈ n, j ≠ i → matRow(R, n, matOne(R, n), i)(j) * v(j) = R.zero
    intros j hj other
    have different : i ≠ j
      intro same
      have back : j = i
        symm
        exact same
      exact other with back
    have f1 := matRow.at at R, n, n, matOne(R, n), i, j with ring, one, hi, hj
    have z := matOne.other at R, n, i, j with ring, hi, hj, different
    have a := functionSpace.apply_mem with vector, hj
    rw [f1, z]
    ring
  have single := vecDot.single_of at R, n, matRow(R, n, matOne(R, n), i), v, i with ring, finite, rowS, vector, hi, vanish
  have f1 := matRow.at at R, n, n, matOne(R, n), i, i with ring, one, hi, hi
  have o := matOne.same at R, n, i with ring, hi
  have a := functionSpace.apply_mem with vector, hi
  rw [e1, single, f1, o]
  ring

-- Matrix.mulVec_single: A eⱼ is the j-th column.
theorem mulVec.unit_vector (m n A j : Set)
  requires finite : Finite(n)
  requires matrix : A ∈ matrixSpace(R, m, n)
  requires index : j ∈ n
  shows mulVec(R, m, n, A, unitVector(R, n, j)) = matCol(R, m, A, j)
proof
  have unitS := unitVector.mem at R, n, j with ring
  have left := mulVec.mem at R, m, n, A, unitVector(R, n, j) with ring, finite, matrix, unitS
  have right := matCol.space at R, m, n, A, j with ring, matrix, index
  apply functionSpace.ext_of with left, right
  intros i hi
  have rowS := matRow.space at R, m, n, A, i with ring, matrix, hi
  have e1 := mulVec.apply at R, m, n, A, unitVector(R, n, j), i with ring, finite, matrix, unitS, hi
  have e2 := vecDot.unit_vector at R, n, matRow(R, n, A, i), j with ring, finite, rowS, index
  have e3 := matRow.at at R, m, n, A, i, j with ring, matrix, hi, index
  have e4 := matCol.at at R, m, n, A, i, j with ring, matrix, hi, index
  rw [e1, e2, e3, e4]

-- Matrix.ext_iff_mulVec: matrices with the same action are equal.
theorem mulVec.ext (m n A B : Set)
  requires finite : Finite(n)
  requires first : A ∈ matrixSpace(R, m, n)
  requires second : B ∈ matrixSpace(R, m, n)
  requires agree : ∀ v ∈ functionSpace(n, R.carrier),
    mulVec(R, m, n, A, v) = mulVec(R, m, n, B, v)
  shows A = B
proof
  apply (matrixSpace.ext at R, m, n, A, B with ring, first, second).backward
  intros i hi j hj
  have unitS := unitVector.mem at R, n, j with ring
  have same := agree with unitVector(R, n, j), unitS
  have ua := mulVec.unit_vector at R, m, n, A, j with ring, finite, first, hj
  have ub := mulVec.unit_vector at R, m, n, B, j with ring, finite, second, hj
  rw [ua, ub] at same
  have ca := matCol.at at R, m, n, A, i, j with ring, first, hi, hj
  have cb := matCol.at at R, m, n, B, i, j with ring, second, hi, hj
  rw [← ca, ← cb, same]

-- Matrix.dotProduct_mulVec: v ⬝ (A w) = (v A) ⬝ w.
theorem vecDot.mulVec (m n v A w : Set)
  requires finiteM : Finite(m)
  requires finiteN : Finite(n)
  requires first : v ∈ functionSpace(m, R.carrier)
  requires matrix : A ∈ matrixSpace(R, m, n)
  requires second : w ∈ functionSpace(n, R.carrier)
  shows vecDot(R, m, v, mulVec(R, m, n, A, w)) =
    vecDot(R, n, vecMul(R, m, n, v, A), w)
proof
  sorry

-- Matrix.vecMul_transpose: v A = Aᵀ v.
theorem vecMul.transpose (m n v A : Set)
  requires finite : Finite(m)
  requires matrix : A ∈ matrixSpace(R, m, n)
  requires vector : v ∈ functionSpace(m, R.carrier)
  shows vecMul(R, m, n, v, A) = mulVec(R, n, m, matTranspose(R, m, n, A), v)
proof
  have transposed : matTranspose(R, m, n, A) ∈ matrixSpace(R, n, m)
    have function := matrixSpace.function with matrix
    have tf := transposedMatrix.function at m, n, R.carrier, A with function
    unfold matTranspose
    exact matrixSpace.of_function with tf
  have finiteN := finite
  have values : ∀ j ∈ n, vecDot(R, m, v, matCol(R, m, A, j)) ∈ R.carrier
    intros j hj
    have colS := matCol.space at R, m, n, A, j with ring, matrix, hj
    exact vecDot.mem_of at R, m, v, matCol(R, m, A, j) with ring, finite, vector, colS
  have vf := vecMul.graph_function at R, m, n, v, A with values
  have left := functionSpace.mem_iff.backward with vf
  have right := mulVec.mem at R, n, m, matTranspose(R, m, n, A), v with ring, finite, transposed, vector
  apply functionSpace.ext_of with left, right
  intros j hj
  have colS := matCol.space at R, m, n, A, j with ring, matrix, hj
  have rowS := matRow.space at R, n, m, matTranspose(R, m, n, A), j with ring, transposed, hj
  have e1 := vecMul.apply at R, m, n, v, A, j with ring, finite, matrix, vector, hj
  have e2 := mulVec.apply at R, n, m, matTranspose(R, m, n, A), v, j with ring, finite, transposed, vector, hj
  rw [e1, e2]
  apply vecDot.congr_of at R, m, v, matCol(R, m, A, j), matRow(R, m, matTranspose(R, m, n, A), j), v with ring, finite, vector, colS, rowS, vector
  intros i hi
  have x := functionSpace.apply_mem with vector, hi
  have y := matrixSpace.entry_mem with matrix, hi, hj
  have f1 := matCol.at at R, m, n, A, i, j with ring, matrix, hi, hj
  have f2 := matRow.at at R, n, m, matTranspose(R, m, n, A), j, i with ring, transposed, hj, hi
  have f3 := matTranspose.entry at R, m, n, A, i, j with ring, matrix, hi, hj
  rw [f1, f2, f3]
  ring

-- Matrix.vecMulVec_mulVec and mul_vecMulVec.
theorem vecMulVec.mulVec (m n v w u : Set)
  requires finite : Finite(n)
  requires first : v ∈ functionSpace(m, R.carrier)
  requires second : w ∈ functionSpace(n, R.carrier)
  requires third : u ∈ functionSpace(n, R.carrier)
  shows mulVec(R, m, n, vecMulVec(R, m, n, v, w), u) =
    vecSmul(R, m, vecDot(R, n, w, u), v)
proof
  have values : ∀ x ∈ m, ∀ y ∈ n, call2(R.mul, v(x), w(y)) ∈ R.carrier
    intros x hx y hy
    have vx := functionSpace.apply_mem with first, hx
    have wy := functionSpace.apply_mem with second, hy
    exact Ring.mul_mem at R, v(x), w(y) with *
  have outer := matrixSpace.of_function with (vecMulVec.graph_function at R, m, n, v, w with values)
  have left := mulVec.mem at R, m, n, vecMulVec(R, m, n, v, w), u with ring, finite, outer, third
  have dot := vecDot.mem_of at R, n, w, u with ring, finite, second, third
  have right := vecSmul.space at R, m, vecDot(R, n, w, u), v with ring, dot, first
  apply functionSpace.ext_of with left, right
  intros i hi
  have rowS := matRow.space at R, m, n, vecMulVec(R, m, n, v, w), i with ring, outer, hi
  have vi := functionSpace.apply_mem with first, hi
  have e1 := mulVec.apply at R, m, n, vecMulVec(R, m, n, v, w), u, i with ring, finite, outer, third, hi
  have e2 := vecSmul.at at R, m, vecDot(R, n, w, u), v, i with ring, dot, first, hi
  have scaled := vecDot.scale_of at R, n, matRow(R, n, vecMulVec(R, m, n, v, w), i), u, v(i), w, u with ring, finite, vi, rowS, third, second, third
  have law : vecDot(R, n, matRow(R, n, vecMulVec(R, m, n, v, w), i), u) = v(i) * vecDot(R, n, w, u)
    apply scaled
    intros j hj
    have wj := functionSpace.apply_mem with second, hj
    have uj := functionSpace.apply_mem with third, hj
    have f1 := matRow.at at R, m, n, vecMulVec(R, m, n, v, w), i, j with ring, outer, hi, hj
    have f2 := vecMulVec.entry at R, m, n, v, w, i, j with ring, first, second, hi, hj
    rw [f1, f2]
    ring
  rw [e1, e2, law]
  ring

-- Matrix.transpose_mul and transpose_transpose.
theorem matTranspose.mul (m n p A B : Set)
  requires finite : Finite(n)
  requires first : A ∈ matrixSpace(R, m, n)
  requires second : B ∈ matrixSpace(R, n, p)
  shows matTranspose(R, m, p, matMul(R, m, n, p, A, B)) =
    matMul(R, p, n, m, matTranspose(R, n, p, B), matTranspose(R, m, n, A))
proof
  have ab := matMul.mem_of at R, m, n, p, A, B with ring, finite, first, second
  have fA := matrixSpace.function with first
  have fB := matrixSpace.function with second
  have fAB := matrixSpace.function with ab
  have tA : matTranspose(R, m, n, A) ∈ matrixSpace(R, n, m)
    unfold matTranspose
    exact matrixSpace.of_function with (transposedMatrix.function at m, n, R.carrier, A with fA)
  have tB : matTranspose(R, n, p, B) ∈ matrixSpace(R, p, n)
    unfold matTranspose
    exact matrixSpace.of_function with (transposedMatrix.function at n, p, R.carrier, B with fB)
  have tAB : matTranspose(R, m, p, matMul(R, m, n, p, A, B)) ∈ matrixSpace(R, p, m)
    unfold matTranspose
    exact matrixSpace.of_function with (transposedMatrix.function at m, p, R.carrier, matMul(R, m, n, p, A, B) with fAB)
  have right := matMul.mem_of at R, p, n, m, matTranspose(R, n, p, B), matTranspose(R, m, n, A) with ring, finite, tB, tA
  apply (matrixSpace.ext at R, p, m, matTranspose(R, m, p, matMul(R, m, n, p, A, B)), matMul(R, p, n, m, matTranspose(R, n, p, B), matTranspose(R, m, n, A)) with ring, tAB, right).backward
  intros k hk i hi
  have e1 := matTranspose.entry at R, m, p, matMul(R, m, n, p, A, B), i, k with ring, ab, hi, hk
  have e2 := matMul.at at R, m, n, p, A, B, i, k with ring, finite, first, second, hi, hk
  have e3 := matMul.at at R, p, n, m, matTranspose(R, n, p, B), matTranspose(R, m, n, A), k, i with ring, finite, tB, tA, hk, hi
  rw [e1, e2, e3]
  have rowA := matRow.space at R, m, n, A, i with ring, first, hi
  have colB := matCol.space at R, n, p, B, k with ring, second, hk
  have rowB := matRow.space at R, p, n, matTranspose(R, n, p, B), k with ring, tB, hk
  have colA := matCol.space at R, n, m, matTranspose(R, m, n, A), i with ring, tA, hi
  apply vecDot.congr_of at R, n, matRow(R, n, A, i), matCol(R, n, B, k), matRow(R, n, matTranspose(R, n, p, B), k), matCol(R, n, matTranspose(R, m, n, A), i) with ring, finite, rowA, colB, rowB, colA
  intros j hj
  have x := matrixSpace.entry_mem with first, hi, hj
  have y := matrixSpace.entry_mem with second, hj, hk
  have f1 := matRow.at at R, m, n, A, i, j with ring, first, hi, hj
  have f2 := matCol.at at R, n, p, B, j, k with ring, second, hj, hk
  have f3 := matRow.at at R, p, n, matTranspose(R, n, p, B), k, j with ring, tB, hk, hj
  have f4 := matCol.at at R, n, m, matTranspose(R, m, n, A), j, i with ring, tA, hj, hi
  have t1 := matTranspose.entry at R, n, p, B, j, k with ring, second, hj, hk
  have t2 := matTranspose.entry at R, m, n, A, i, j with ring, first, hi, hj
  rw [f1, f2, f3, f4, t1, t2]
  ring

theorem matTranspose.involution (m n A : Set)
  requires matrix : A ∈ matrixSpace(R, m, n)
  shows matTranspose(R, n, m, matTranspose(R, m, n, A)) = A
proof
  have function := matrixSpace.function with matrix
  unfold matTranspose
  exact transposedMatrix.involution at m, n, R.carrier, A with function

-- Matrix.trace_mul_comm and trace of sums.
theorem matTrace.mul_comm (m n A B : Set)
  requires finiteM : Finite(m)
  requires finiteN : Finite(n)
  requires first : A ∈ matrixSpace(R, m, n)
  requires second : B ∈ matrixSpace(R, n, m)
  shows matTrace(R, m, matMul(R, m, n, m, A, B)) =
    matTrace(R, n, matMul(R, n, m, n, B, A))
proof
  sorry

theorem matTrace.add (n A B : Set)
  requires finite : Finite(n)
  requires first : A ∈ matrixSpace(R, n, n)
  requires second : B ∈ matrixSpace(R, n, n)
  shows matTrace(R, n, matAdd(R, n, n, A, B)) = matTrace(R, n, A) + matTrace(R, n, B)
proof
  have parts := CommRing.parts with ring
  have ringR := CommRing.to_ring with ring
  have oneIn := Ring.one_mem at R with ringR
  have ab := matAdd.mem_of at R, n, n, A, B with ring, first, second
  have tA := matDiag.function_of at R, n, A with ring, first
  have tB := matDiag.function_of at R, n, B with ring, second
  have tAB := matDiag.function_of at R, n, matAdd(R, n, n, A, B) with ring, ab
  have entries : ∀ i ∈ n, matDiag(R, n, matAdd(R, n, n, A, B))(i) = R.one * matDiag(R, n, A)(i) + R.one * matDiag(R, n, B)(i)
    intros i hi
    have a := matrixSpace.entry_mem with first, hi, hi
    have b := matrixSpace.entry_mem with second, hi, hi
    have e1 := matDiag.at at R, n, matAdd(R, n, n, A, B), i with ring, ab, hi
    have e2 := matDiag.at at R, n, A, i with ring, first, hi
    have e3 := matDiag.at at R, n, B, i with ring, second, hi
    have e4 := matAdd.at at R, n, n, A, B, i, i with ring, first, second, hi, hi
    rw [e1, e2, e3, e4]
    ring
  have law := finiteRingSum.linear at n, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, matDiag(R, n, A), matDiag(R, n, B), matDiag(R, n, matAdd(R, n, n, A, B)), R.one, R.one with parts, finite, tA, tB, tAB, oneIn, oneIn, entries
  have s1 := finiteRingSum.closed at n, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, matDiag(R, n, A) with parts, finite, tA
  have s2 := finiteRingSum.closed at n, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, matDiag(R, n, B) with parts, finite, tB
  unfold matTrace
  rw law
  ring

theorem matTrace.transpose (n A : Set)
  requires finite : Finite(n)
  requires matrix : A ∈ matrixSpace(R, n, n)
  shows matTrace(R, n, matTranspose(R, n, n, A)) = matTrace(R, n, A)
proof
  have parts := CommRing.parts with ring
  have function := matrixSpace.function with matrix
  have tf := transposedMatrix.function at n, n, R.carrier, A with function
  have transposed : matTranspose(R, n, n, A) ∈ matrixSpace(R, n, n)
    unfold matTranspose
    exact matrixSpace.of_function with tf
  have t1 := matDiag.function_of at R, n, matTranspose(R, n, n, A) with ring, transposed
  have t2 := matDiag.function_of at R, n, A with ring, matrix
  have agree : ∀ i ∈ n, matDiag(R, n, matTranspose(R, n, n, A))(i) = matDiag(R, n, A)(i)
    intros i hi
    have e1 := matDiag.at at R, n, matTranspose(R, n, n, A), i with ring, transposed, hi
    have e2 := matDiag.at at R, n, A, i with ring, matrix, hi
    have e3 := matTranspose.entry at R, n, n, A, i, i with ring, matrix, hi, hi
    rw [e1, e2, e3]
  unfold matTrace
  exact finiteRingSum.congr at n, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, matDiag(R, n, matTranspose(R, n, n, A)), matDiag(R, n, A) with parts, finite, t1, t2, agree

-- Matrix.submatrix_mul: for a bijection of the inner index, submatrices
-- multiply.
theorem submatrix.mul (m n p m2 n2 p2 A B f g h : Set)
  requires finiteN : Finite(n)
  requires first : A ∈ matrixSpace(R, m, n)
  requires second : B ∈ matrixSpace(R, n, p)
  requires rows : f : m2 → m
  requires inner : BijectiveBetween(g, n2, n)
  requires columns : h : p2 → p
  shows matMul(R, m2, n2, p2, submatrix(R, m2, n2, A, f, g),
      submatrix(R, n2, p2, B, g, h)) =
    submatrix(R, m2, p2, matMul(R, m, n, p, A, B), f, h)
proof
  sorry

-- Matrix.fromBlocks_multiply: block matrices multiply blockwise.
theorem fromBlocks.mul (m1 m2 n1 n2 p1 p2 A B C D E F G H : Set)
  requires finiteN1 : Finite(n1)
  requires finiteN2 : Finite(n2)
  requires a : A ∈ matrixSpace(R, m1, n1)
  requires b : B ∈ matrixSpace(R, m1, n2)
  requires c : C ∈ matrixSpace(R, m2, n1)
  requires d : D ∈ matrixSpace(R, m2, n2)
  requires e : E ∈ matrixSpace(R, n1, p1)
  requires f : F ∈ matrixSpace(R, n1, p2)
  requires g : G ∈ matrixSpace(R, n2, p1)
  requires h : H ∈ matrixSpace(R, n2, p2)
  shows matMul(R, m1 ⊎ m2, n1 ⊎ n2, p1 ⊎ p2,
      fromBlocks(R, m1, m2, n1, n2, A, B, C, D),
      fromBlocks(R, n1, n2, p1, p2, E, F, G, H)) =
    fromBlocks(R, m1, m2, p1, p2,
      matAdd(R, m1, p1, matMul(R, m1, n1, p1, A, E), matMul(R, m1, n2, p1, B, G)),
      matAdd(R, m1, p2, matMul(R, m1, n1, p2, A, F), matMul(R, m1, n2, p2, B, H)),
      matAdd(R, m2, p1, matMul(R, m2, n1, p1, C, E), matMul(R, m2, n2, p1, D, G)),
      matAdd(R, m2, p2, matMul(R, m2, n1, p2, C, F), matMul(R, m2, n2, p2, D, H)))
proof
  sorry

-- Matrix.fromCols_mul_fromRows: [A B] [C; D] = A C + B D.
theorem fromCols.mul_fromRows (m n1 n2 p A B C D : Set)
  requires finiteN1 : Finite(n1)
  requires finiteN2 : Finite(n2)
  requires a : A ∈ matrixSpace(R, m, n1)
  requires b : B ∈ matrixSpace(R, m, n2)
  requires c : C ∈ matrixSpace(R, n1, p)
  requires d : D ∈ matrixSpace(R, n2, p)
  shows matMul(R, m, n1 ⊎ n2, p, fromCols(R, m, n1, n2, A, B),
      fromRows(R, n1, n2, p, C, D)) =
    matAdd(R, m, p, matMul(R, m, n1, p, A, C), matMul(R, m, n2, p, B, D))
proof
  sorry

-- Matrix.fromRows_mul: [A; C] B = [A B; C B].
theorem fromRows.mul (m1 m2 n p A C B : Set)
  requires finite : Finite(n)
  requires a : A ∈ matrixSpace(R, m1, n)
  requires c : C ∈ matrixSpace(R, m2, n)
  requires b : B ∈ matrixSpace(R, n, p)
  shows matMul(R, m1 ⊎ m2, n, p, fromRows(R, m1, m2, n, A, C), B) =
    fromRows(R, m1, m2, p, matMul(R, m1, n, p, A, B), matMul(R, m2, n, p, C, B))
proof
  sorry

-- Matrix.fromBlocks_mulVec.
theorem fromBlocks.mulVec (m1 m2 n1 n2 A B C D v : Set)
  requires finiteN1 : Finite(n1)
  requires finiteN2 : Finite(n2)
  requires a : A ∈ matrixSpace(R, m1, n1)
  requires b : B ∈ matrixSpace(R, m1, n2)
  requires c : C ∈ matrixSpace(R, m2, n1)
  requires d : D ∈ matrixSpace(R, m2, n2)
  requires vector : v ∈ functionSpace(n1 ⊎ n2, R.carrier)
  shows mulVec(R, m1 ⊎ m2, n1 ⊎ n2, fromBlocks(R, m1, m2, n1, n2, A, B, C, D), v) =
    vecAppend(R, m1, m2,
      vecAdd(R, m1, mulVec(R, m1, n1, A, compose(v, leftInclusion(n1, n2), n1,
        n1 ⊎ n2, R.carrier)), mulVec(R, m1, n2, B, compose(v,
        rightInclusion(n1, n2), n2, n1 ⊎ n2, R.carrier))),
      vecAdd(R, m2, mulVec(R, m2, n1, C, compose(v, leftInclusion(n1, n2), n1,
        n1 ⊎ n2, R.carrier)), mulVec(R, m2, n2, D, compose(v,
        rightInclusion(n1, n2), n2, n1 ⊎ n2, R.carrier))))
proof
  sorry

-- The block-triangular matrices for b and lt are closed under products
-- (Matrix.BlockTriangular.mul).
theorem BlockTriangular.mul (n A B b lt T : Set)
  requires finite : Finite(n)
  requires order : StrictLinearOrder(T, lt)
  requires blocks : b : n → T
  requires first : A ∈ matrixSpace(R, n, n)
  requires second : B ∈ matrixSpace(R, n, n)
  requires triangularA : BlockTriangular(R, n, A, b, lt)
  requires triangularB : BlockTriangular(R, n, B, b, lt)
  shows BlockTriangular(R, n, matMul(R, n, n, n, A, B), b, lt)
proof
  sorry

-- Matrix.map_mul, map_add, map_one under a ring map, and the transpose.
theorem matMap.mul (S m n p f A B : Set)
  requires target : CommRing(S)
  requires finite : Finite(n)
  requires hom : RingHom(f, R, S)
  requires first : A ∈ matrixSpace(R, m, n)
  requires second : B ∈ matrixSpace(R, n, p)
  shows matMap(S, m, p, f, matMul(R, m, n, p, A, B)) =
    matMul(S, m, n, p, matMap(S, m, n, f, A), matMap(S, n, p, f, B))
proof
  sorry

theorem matMap.add (S m n f A B : Set)
  requires target : CommRing(S)
  requires hom : RingHom(f, R, S)
  requires first : A ∈ matrixSpace(R, m, n)
  requires second : B ∈ matrixSpace(R, m, n)
  shows matMap(S, m, n, f, matAdd(R, m, n, A, B)) =
    matAdd(S, m, n, matMap(S, m, n, f, A), matMap(S, m, n, f, B))
proof
  obtain ⟨src, tgt, fF, f0, f1, fneg, fadd, fmul⟩ := hom
  have ab := matAdd.mem_of at R, m, n, A, B with ring, first, second
  have mapValues : ∀ i ∈ m, ∀ j ∈ n, f(A((i, j))) ∈ S.carrier
    intros i hi j hj
    have entry := matrixSpace.entry_mem with first, hi, hj
    exact FunctionBetween.apply_closed with fF, entry
  have mapValuesB : ∀ i ∈ m, ∀ j ∈ n, f(B((i, j))) ∈ S.carrier
    intros i hi j hj
    have entry := matrixSpace.entry_mem with second, hi, hj
    exact FunctionBetween.apply_closed with fF, entry
  have mapValuesAB : ∀ i ∈ m, ∀ j ∈ n, f(matAdd(R, m, n, A, B)((i, j))) ∈ S.carrier
    intros i hi j hj
    have entry := matrixSpace.entry_mem with ab, hi, hj
    exact FunctionBetween.apply_closed with fF, entry
  have mA := matrixSpace.of_function with (matMap.graph_function at S, m, n, f, A with mapValues)
  have mB := matrixSpace.of_function with (matMap.graph_function at S, m, n, f, B with mapValuesB)
  have mAB := matrixSpace.of_function with (matMap.graph_function at S, m, n, f, matAdd(R, m, n, A, B) with mapValuesAB)
  have right := matAdd.mem_of at S, m, n, matMap(S, m, n, f, A), matMap(S, m, n, f, B) with target, mA, mB
  apply (matrixSpace.ext at S, m, n, matMap(S, m, n, f, matAdd(R, m, n, A, B)), matAdd(S, m, n, matMap(S, m, n, f, A), matMap(S, m, n, f, B)) with target, mAB, right).backward
  intros i hi j hj
  have a := matrixSpace.entry_mem with first, hi, hj
  have b := matrixSpace.entry_mem with second, hi, hj
  have e1 := matMap.graph_entry at S, m, n, f, matAdd(R, m, n, A, B), i, j with mapValuesAB, hi, hj
  have e2 := matAdd.at at R, m, n, A, B, i, j with ring, first, second, hi, hj
  have e3 := matAdd.at at S, m, n, matMap(S, m, n, f, A), matMap(S, m, n, f, B), i, j with target, mA, mB, hi, hj
  have e4 := matMap.graph_entry at S, m, n, f, A, i, j with mapValues, hi, hj
  have e5 := matMap.graph_entry at S, m, n, f, B, i, j with mapValuesB, hi, hj
  have law := fadd with A((i, j)), a, B((i, j)), b
  rw [e1, e2, e3, e4, e5, law]

theorem matMap.one (S n f : Set)
  requires target : CommRing(S)
  requires hom : RingHom(f, R, S)
  shows matMap(S, n, n, f, matOne(R, n)) = matOne(S, n)
proof
  obtain ⟨src, tgt, fF, f0, f1, fneg, fadd, fmul⟩ := hom
  have oneR := matOne.mem_of at R, n with ring
  have oneS := matOne.mem_of at S, n with target
  have mapValues : ∀ i ∈ n, ∀ j ∈ n, f(matOne(R, n)((i, j))) ∈ S.carrier
    intros i hi j hj
    have entry := matrixSpace.entry_mem with oneR, hi, hj
    exact FunctionBetween.apply_closed with fF, entry
  have mapped := matrixSpace.of_function with (matMap.graph_function at S, n, n, f, matOne(R, n) with mapValues)
  apply (matrixSpace.ext at S, n, n, matMap(S, n, n, f, matOne(R, n)), matOne(S, n) with target, mapped, oneS).backward
  intros i hi j hj
  have e1 := matMap.graph_entry at S, n, n, f, matOne(R, n), i, j with mapValues, hi, hj
  rw e1
  by_cases same : i = j
  . rw same
    have r1 := matOne.same at R, n, j with ring, hj
    have r2 := matOne.same at S, n, j with target, hj
    rw [r1, r2]
    exact f1
  . have r1 := matOne.other at R, n, i, j with ring, hi, hj, same
    have r2 := matOne.other at S, n, i, j with target, hi, hj, same
    rw [r1, r2]
    exact f0

theorem matMap.mulVec (S m n f A v : Set)
  requires target : CommRing(S)
  requires finite : Finite(n)
  requires hom : RingHom(f, R, S)
  requires matrix : A ∈ matrixSpace(R, m, n)
  requires vector : v ∈ functionSpace(n, R.carrier)
  shows compose(f, mulVec(R, m, n, A, v), m, R.carrier, S.carrier) =
    mulVec(S, m, n, matMap(S, m, n, f, A), compose(f, v, n, R.carrier, S.carrier))
proof
  sorry

-- Matrix.map_injective.
theorem matMap.injective (S m n f A B : Set)
  requires hom : RingHom(f, R, S)
  requires injective : InjectiveBetween(f, R.carrier, S.carrier)
  requires first : A ∈ matrixSpace(R, m, n)
  requires second : B ∈ matrixSpace(R, m, n)
  requires same : matMap(S, m, n, f, A) = matMap(S, m, n, f, B)
  shows A = B
proof
  have fA := matrixSpace.function with first
  have fB := matrixSpace.function with second
  apply FunctionBetween.ext with fA, fB
  intros q hq
  obtain ⟨bound, i, hi, j, hj, shape⟩ := product.membership.forward with hq
  rw shape
  have a := matrixSpace.entry_mem with first, hi, hj
  have b := matrixSpace.entry_mem with second, hi, hj
  have ea := matMap.entry at R, S, m, n, f, A, i, j with ring, hom, first, hi, hj
  have eb := matMap.entry at R, S, m, n, f, B, i, j with ring, hom, second, hi, hj
  have entries : matMap(S, m, n, f, A)((i, j)) = matMap(S, m, n, f, B)((i, j))
    rw same
  rw [ea, eb] at entries
  exact InjectiveBetween.apply_cancel with injective, a, b, entries

end Products

-- Section: Conjugate transpose
section Conjugate
variable (R σ : Set)
hypothesis involution : RingInvolution(σ, R)

-- Matrix.conjTranspose_mul: (A B)ᴴ = Bᴴ Aᴴ.
theorem conjTranspose.mul (m n p A B : Set)
  requires finite : Finite(n)
  requires first : A ∈ matrixSpace(R, m, n)
  requires second : B ∈ matrixSpace(R, n, p)
  shows conjTranspose(R, σ, m, p, matMul(R, m, n, p, A, B)) =
    matMul(R, p, n, m, conjTranspose(R, σ, n, p, B), conjTranspose(R, σ, m, n, A))
proof
  sorry

theorem conjTranspose.involution (m n A : Set)
  requires matrix : A ∈ matrixSpace(R, m, n)
  shows conjTranspose(R, σ, n, m, conjTranspose(R, σ, m, n, A)) = A
proof
  have once := conjTranspose.mem_of at R, σ, m, n, A with involution, matrix
  have twice := conjTranspose.mem_of at R, σ, n, m, conjTranspose(R, σ, m, n, A) with involution, once
  obtain ⟨comm, hom, involutive⟩ := involution
  apply (matrixSpace.ext at R, m, n, conjTranspose(R, σ, n, m, conjTranspose(R, σ, m, n, A)), A with comm, twice, matrix).backward
  intros i hi j hj
  have e1 := conjTranspose.at at R, σ, n, m, conjTranspose(R, σ, m, n, A), j, i with involution, once, hj, hi
  have e2 := conjTranspose.at at R, σ, m, n, A, i, j with involution, matrix, hi, hj
  have a := matrixSpace.entry_mem with matrix, hi, hj
  have back := involutive with A((i, j)), a
  rw [e1, e2, back]

theorem conjTranspose.add (m n A B : Set)
  requires first : A ∈ matrixSpace(R, m, n)
  requires second : B ∈ matrixSpace(R, m, n)
  shows conjTranspose(R, σ, m, n, matAdd(R, m, n, A, B)) =
    matAdd(R, n, m, conjTranspose(R, σ, m, n, A), conjTranspose(R, σ, m, n, B))
proof
  have ab := matAdd.mem_of at R, m, n, A, B with (involution.left), first, second
  have left := conjTranspose.mem_of at R, σ, m, n, matAdd(R, m, n, A, B) with involution, ab
  have cA := conjTranspose.mem_of at R, σ, m, n, A with involution, first
  have cB := conjTranspose.mem_of at R, σ, m, n, B with involution, second
  obtain ⟨comm, hom, involutive⟩ := involution
  have right := matAdd.mem_of at R, n, m, conjTranspose(R, σ, m, n, A), conjTranspose(R, σ, m, n, B) with comm, cA, cB
  apply (matrixSpace.ext at R, n, m, conjTranspose(R, σ, m, n, matAdd(R, m, n, A, B)), matAdd(R, n, m, conjTranspose(R, σ, m, n, A), conjTranspose(R, σ, m, n, B)) with comm, left, right).backward
  intros j hj i hi
  have a := matrixSpace.entry_mem with first, hi, hj
  have b := matrixSpace.entry_mem with second, hi, hj
  have e1 := conjTranspose.at at R, σ, m, n, matAdd(R, m, n, A, B), i, j with involution, ab, hi, hj
  have e2 := matAdd.at at R, m, n, A, B, i, j with comm, first, second, hi, hj
  have e3 := matAdd.at at R, n, m, conjTranspose(R, σ, m, n, A), conjTranspose(R, σ, m, n, B), j, i with comm, cA, cB, hj, hi
  have e4 := conjTranspose.at at R, σ, m, n, A, i, j with involution, first, hi, hj
  have e5 := conjTranspose.at at R, σ, m, n, B, i, j with involution, second, hi, hj
  have law := RingHom.map_add at σ, R, R, A((i, j)), B((i, j)) with hom, a, b
  rw [e1, e2, e3, e4, e5, law]

theorem conjTranspose.one (n : Set)
  shows conjTranspose(R, σ, n, n, matOne(R, n)) = matOne(R, n)
proof
  obtain ⟨comm, hom, involutive⟩ := involution
  have one := matOne.mem_of at R, n with comm
  have left := conjTranspose.mem_of at R, σ, n, n, matOne(R, n) with involution, one
  apply (matrixSpace.ext at R, n, n, conjTranspose(R, σ, n, n, matOne(R, n)), matOne(R, n) with comm, left, one).backward
  intros j hj i hi
  have e1 := conjTranspose.at at R, σ, n, n, matOne(R, n), i, j with involution, one, hi, hj
  rw e1
  by_cases same : i = j
  . rw same
    have o := matOne.same at R, n, j with comm, hj
    rw o
    exact RingHom.map_one at σ, R, R with hom
  . have other : j ≠ i
      intro back
      have forth : i = j
        symm
        exact back
      exact same with forth
    have o1 := matOne.other at R, n, i, j with comm, hi, hj, same
    have o2 := matOne.other at R, n, j, i with comm, hj, hi, other
    rw [o1, o2]
    exact RingHom.map_zero at σ, R, R with hom

-- Matrix.star_mulVec: σ(A v) = σ(v) Aᴴ.
theorem conjTranspose.star_mulVec (m n A v : Set)
  requires finite : Finite(n)
  requires matrix : A ∈ matrixSpace(R, m, n)
  requires vector : v ∈ functionSpace(n, R.carrier)
  shows vecConj(R, σ, m, mulVec(R, m, n, A, v)) =
    vecMul(R, n, m, vecConj(R, σ, n, v), conjTranspose(R, σ, m, n, A))
proof
  sorry

-- Matrix.star_dotProduct: σ(v ⬝ w) = σ(v) ⬝ σ(w).
theorem vecDot.star (n v w : Set)
  requires finite : Finite(n)
  requires first : v ∈ functionSpace(n, R.carrier)
  requires second : w ∈ functionSpace(n, R.carrier)
  shows σ(vecDot(R, n, v, w)) = vecDot(R, n, vecConj(R, σ, n, v), vecConj(R, σ, n, w))
proof
  sorry

-- Matrix.conjTranspose_fromBlocks.
theorem conjTranspose.fromBlocks (m1 m2 n1 n2 A B C D : Set)
  requires a : A ∈ matrixSpace(R, m1, n1)
  requires b : B ∈ matrixSpace(R, m1, n2)
  requires c : C ∈ matrixSpace(R, m2, n1)
  requires d : D ∈ matrixSpace(R, m2, n2)
  shows conjTranspose(R, σ, m1 ⊎ m2, n1 ⊎ n2,
      fromBlocks(R, m1, m2, n1, n2, A, B, C, D)) =
    fromBlocks(R, n1, n2, m1, m2, conjTranspose(R, σ, m1, n1, A),
      conjTranspose(R, σ, m2, n1, C), conjTranspose(R, σ, m1, n2, B),
      conjTranspose(R, σ, m2, n2, D))
proof
  sorry

-- conjTranspose_fromCols_eq_fromRows_conjTranspose.
theorem conjTranspose.fromCols (m n1 n2 A B : Set)
  requires a : A ∈ matrixSpace(R, m, n1)
  requires b : B ∈ matrixSpace(R, m, n2)
  shows conjTranspose(R, σ, m, n1 ⊎ n2, fromCols(R, m, n1, n2, A, B)) =
    fromRows(R, n1, n2, m, conjTranspose(R, σ, m, n1, A),
      conjTranspose(R, σ, m, n2, B))
proof
  sorry

-- With the trivial involution the conjugate transpose is the transpose.
theorem conjTranspose.identity (m n A : Set)
  requires ring : CommRing(R)
  requires matrix : A ∈ matrixSpace(R, m, n)
  shows conjTranspose(R, identity(R.carrier), m, n, A) = matTranspose(R, m, n, A)
proof
  have ringR := CommRing.to_ring with ring
  have fA := matrixSpace.function with matrix
  have idF := identity.function at R.carrier
  have values : ∀ x ∈ m, ∀ y ∈ n, identity(R.carrier)(A((x, y))) ∈ Ring.carrier(R)
    intros x hx y hy
    have entry := matrixSpace.entry_mem with matrix, hx, hy
    exact FunctionBetween.apply_closed with idF, entry
  have left := matrixSpace.of_function with (conjTranspose.graph_function at R, identity(R.carrier), m, n, A with values)
  have right : matTranspose(R, m, n, A) ∈ matrixSpace(R, n, m)
    unfold matTranspose
    exact matrixSpace.of_function with (transposedMatrix.function at m, n, R.carrier, A with fA)
  apply (matrixSpace.ext at R, n, m, conjTranspose(R, identity(R.carrier), m, n, A), matTranspose(R, m, n, A) with ring, left, right).backward
  intros j hj i hi
  have entry := matrixSpace.entry_mem with matrix, hi, hj
  have e1 := conjTranspose.entry_of at R, identity(R.carrier), m, n, A, i, j with values, hi, hj
  have e2 := identity.apply at A((i, j)), R.carrier with entry
  have e3 := matTranspose.entry at R, m, n, A, i, j with ring, matrix, hi, hj
  rw [e1, e2, e3]

-- A congruence of a hermitian matrix is hermitian: (Pᴴ J P)ᴴ = Pᴴ J P.
theorem IsHermitianMatrix.congr (m n J P : Set)
  requires finiteM : Finite(m)
  requires finiteN : Finite(n)
  requires form : J ∈ matrixSpace(R, m, m)
  requires hermitian : IsHermitianMatrix(R, σ, m, J)
  requires matrix : P ∈ matrixSpace(R, m, n)
  shows IsHermitianMatrix(R, σ, n, matMul(R, n, m, n,
    conjTranspose(R, σ, m, n, P), matMul(R, m, m, n, J, P)))
proof
  sorry

end Conjugate

-- Section: Square matrices, the matrix module, and linear maps
section Rings
variable (R : Set)
hypothesis ring : CommRing(R)

theorem squareMatrixRing.ring (n : Set)
  requires finite : Finite(n)
  shows Ring(squareMatrixRing(R, n))
proof
  sorry

theorem squareMatrixRing.mul_eq (n A B : Set)
  requires finite : Finite(n)
  requires first : A ∈ matrixSpace(R, n, n)
  requires second : B ∈ matrixSpace(R, n, n)
  shows call2(Ring.mul(squareMatrixRing(R, n)), A, B) = matMul(R, n, n, n, A, B)
proof
  sorry

-- On the index set n = {0, …, n − 1} the ring is Cumulus's matrixRing.
theorem squareMatrixRing.nat (n : Nat)
  shows squareMatrixRing(R, n) = matrixRing(R, n)
proof
  sorry

theorem matrixModule.module (m n : Set)
  shows Module(matrixModule(R, m, n), R)
proof
  have ringR := CommRing.to_ring with ring
  unfold matrixModule
  exact coordinateModule.module at R, m × n with ringR

theorem matrixModule.operations (m n A B a : Set)
  requires first : A ∈ matrixSpace(R, m, n)
  requires second : B ∈ matrixSpace(R, m, n)
  requires scalar : a ∈ R.carrier
  shows call2(Module.add(matrixModule(R, m, n)), A, B) = matAdd(R, m, n, A, B) ∧
    call2(Module.smul(matrixModule(R, m, n)), a, A) = matSmul(R, m, n, a, A)
proof
  sorry

-- Module.finrank_matrix: Rᵐˣⁿ is free of rank |m| |n|, with the
-- single-entry matrices as basis.
theorem matrixModule.finrank (m n : Set)
  requires nontrivial : R.zero ≠ R.one
  requires finiteM : Finite(m)
  requires finiteN : Finite(n)
  shows FiniteFreeModule(matrixModule(R, m, n), R) ∧
    finrank(matrixModule(R, m, n), R) = cardinality(m) * cardinality(n)
proof
  sorry

-- Matrix.toLin': A as a linear map Rⁿ → Rᵐ; every linear map Rⁿ → Rᵐ is
-- one, for a unique A (Matrix.toLin' is an equivalence).
theorem mulVecMap.linear (m n A : Set)
  requires finite : Finite(n)
  requires matrix : A ∈ matrixSpace(R, m, n)
  shows LinearMap(mulVecMap(R, m, n, A), coordinateModule(R, n), R,
    coordinateModule(R, m))
proof
  sorry

theorem mulVecMap.surjective (m n f : Set)
  requires finite : Finite(n)
  requires linear : LinearMap(f, coordinateModule(R, n), R, coordinateModule(R, m))
  shows ∃ A ∈ matrixSpace(R, m, n), f = mulVecMap(R, m, n, A)
proof
  sorry

theorem mulVecMap.compose (m n p A B : Set)
  requires finiteN : Finite(n)
  requires finiteP : Finite(p)
  requires first : A ∈ matrixSpace(R, m, n)
  requires second : B ∈ matrixSpace(R, n, p)
  shows compose(mulVecMap(R, m, n, A), mulVecMap(R, n, p, B),
      functionSpace(p, R.carrier), functionSpace(n, R.carrier),
      functionSpace(m, R.carrier)) =
    mulVecMap(R, m, p, matMul(R, m, n, p, A, B))
proof
  sorry

-- LinearMap.toMatrix_apply and its characterization: the coordinates of
-- f(x) are the matrix times the coordinates of x.
theorem linearToMatrix.mem (M N I b J c f : Set)
  requires finiteI : Finite(I)
  requires finiteJ : Finite(J)
  requires basisM : ModuleBasis(M, R, I, b)
  requires basisN : ModuleBasis(N, R, J, c)
  requires linear : LinearMap(f, M, R, N)
  shows linearToMatrix(M, R, N, I, b, J, c, f) ∈ matrixSpace(R, J, I)
proof
  sorry

theorem linearToMatrix.coordinates (M N I b J c f x : Set)
  requires finiteI : Finite(I)
  requires finiteJ : Finite(J)
  requires basisM : ModuleBasis(M, R, I, b)
  requires basisN : ModuleBasis(N, R, J, c)
  requires linear : LinearMap(f, M, R, N)
  requires vector : x ∈ Module.carrier(M)
  shows basisCoordinates(N, R, J, c, f(x)) = mulVec(R, J, I,
    linearToMatrix(M, R, N, I, b, J, c, f), basisCoordinates(M, R, I, b, x))
proof
  sorry

-- LinearMap.toMatrix_comp: the matrix of a composite is the product.
theorem linearToMatrix.compose (M N P I b J c K d f g : Set)
  requires finiteI : Finite(I)
  requires finiteJ : Finite(J)
  requires finiteK : Finite(K)
  requires basisM : ModuleBasis(M, R, I, b)
  requires basisN : ModuleBasis(N, R, J, c)
  requires basisP : ModuleBasis(P, R, K, d)
  requires first : LinearMap(f, M, R, N)
  requires second : LinearMap(g, N, R, P)
  shows linearToMatrix(M, R, P, I, b, K, d, compose(g, f, Module.carrier(M),
      Module.carrier(N), Module.carrier(P))) =
    matMul(R, K, J, I, linearToMatrix(N, R, P, J, c, K, d, g),
      linearToMatrix(M, R, N, I, b, J, c, f))
proof
  sorry

theorem linearToMatrix.identity (M I b : Set)
  requires finite : Finite(I)
  requires basis : ModuleBasis(M, R, I, b)
  shows linearToMatrix(M, R, M, I, b, I, b, identity(Module.carrier(M))) =
    matOne(R, I)
proof
  sorry

-- In the standard bases the matrix of v ↦ A v is A.
theorem linearToMatrix.standard (m n A : Set)
  requires finiteM : Finite(m)
  requires finiteN : Finite(n)
  requires matrix : A ∈ matrixSpace(R, m, n)
  shows linearToMatrix(coordinateModule(R, n), R, coordinateModule(R, m), n,
    standardBasis(R, n), m, standardBasis(R, m), mulVecMap(R, m, n, A)) = A
proof
  sorry

-- Change of basis: matrices of one endomorphism in two bases are
-- conjugate by the change-of-basis matrix.
theorem linearToMatrix.change_of_basis (M I b J c f : Set)
  requires finiteI : Finite(I)
  requires finiteJ : Finite(J)
  requires basisB : ModuleBasis(M, R, I, b)
  requires basisC : ModuleBasis(M, R, J, c)
  requires linear : LinearMap(f, M, R, M)
  shows matMul(R, J, I, J, linearToMatrix(M, R, M, I, b, J, c,
      identity(Module.carrier(M))),
      matMul(R, I, I, J, linearToMatrix(M, R, M, I, b, I, b, f),
        linearToMatrix(M, R, M, J, c, I, b, identity(Module.carrier(M))))) =
    linearToMatrix(M, R, M, J, c, J, c, f)
proof
  sorry

end Rings
