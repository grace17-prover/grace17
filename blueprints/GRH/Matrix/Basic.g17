        have g2 := fromBlocks.graph_entry3 at R, n1, n2, p1, p2, E, F, G, H, j, k with vE, vF, vG, vH, hj, hk
        rw [r1, r2, r3, r4, g1, g2]

-- Matrix.fromCols_mul_fromRows: [A B] [C; D] = A C + B D.
theorem fromCols.mul_fromRows (m n1 n2 p A B C D : Set)
  requires finiteN1 : Finite(n1)
  requires finiteN2 : Finite(n2)
  requires a : A ∈ matrixSpace(R, m, n1)
  requires b : B ∈ matrixSpace(R, m, n2)
  requires c : C ∈ matrixSpace(R, n1, p)
  requires d : D ∈ matrixSpace(R, n2, p)
  shows matMul(R, m, n1 ⊎ n2, p, fromCols(R, m, n1, n2, A, B),
      fromRows(R, n1, n2, p, C, D)) =
    matAdd(R, m, p, matMul(R, m, n1, p, A, C), matMul(R, m, n2, p, B, D))
proof
  have fv0 : ∀ i ∈ m, ∀ j ∈ n1, A((i, j)) ∈ R.carrier
    intros i hi j hj
    exact matrixSpace.entry_mem with a, hi, hj
  have fv1 : ∀ i ∈ m, ∀ j ∈ n2, B((i, j)) ∈ R.carrier
    intros i hi j hj
    exact matrixSpace.entry_mem with b, hi, hj
  have gv0 : ∀ i ∈ n1, ∀ j ∈ p, C((i, j)) ∈ R.carrier
    intros i hi j hj
    exact matrixSpace.entry_mem with c, hi, hj
  have gv1 : ∀ i ∈ n2, ∀ j ∈ p, D((i, j)) ∈ R.carrier
    intros i hi j hj
    exact matrixSpace.entry_mem with d, hi, hj
  have fF := matrixSpace.of_function with (fromCols.graph_function at R, m, n1, n2, A, B with fv0, fv1)
  have fG := matrixSpace.of_function with (fromRows.graph_function at R, n1, n2, p, C, D with gv0, gv1)
  have finiteAll := Finite.disjointSum with finiteN1, finiteN2
  have ac := matMul.mem_of at R, m, n1, p, A, C with ring, finiteN1, a, c
  have bd := matMul.mem_of at R, m, n2, p, B, D with ring, finiteN2, b, d
  have left := matMul.mem_of at R, m, n1 ⊎ n2, p, fromCols(R, m, n1, n2, A, B), fromRows(R, n1, n2, p, C, D) with ring, finiteAll, fF, fG
  have right := matAdd.mem_of at R, m, p, matMul(R, m, n1, p, A, C), matMul(R, m, n2, p, B, D) with ring, ac, bd
  apply (matrixSpace.ext at R, m, p, matMul(R, m, n1 ⊎ n2, p, fromCols(R, m, n1, n2, A, B), fromRows(R, n1, n2, p, C, D)), matAdd(R, m, p, matMul(R, m, n1, p, A, C), matMul(R, m, n2, p, B, D)) with ring, left, right).backward
  intros i hi k hk
  have e1 := matMul.at at R, m, n1 ⊎ n2, p, fromCols(R, m, n1, n2, A, B), fromRows(R, n1, n2, p, C, D), i, k with ring, finiteAll, fF, fG, hi, hk
  have e2 := matAdd.at at R, m, p, matMul(R, m, n1, p, A, C), matMul(R, m, n2, p, B, D), i, k with ring, ac, bd, hi, hk
  have e3 := matMul.at at R, m, n1, p, A, C, i, k with ring, finiteN1, a, c, hi, hk
  have e4 := matMul.at at R, m, n2, p, B, D, i, k with ring, finiteN2, b, d, hi, hk
  rw [e1, e2, e3, e4]
  have rowF := matRow.space at R, m, n1 ⊎ n2, fromCols(R, m, n1, n2, A, B), i with ring, fF, hi
  have colG := matCol.space at R, n1 ⊎ n2, p, fromRows(R, n1, n2, p, C, D), k with ring, fG, hk
  have rowA := matRow.space at R, m, n1, A, i with ring, a, hi
  have colC := matCol.space at R, n1, p, C, k with ring, c, hk
  have rowB := matRow.space at R, m, n2, B, i with ring, b, hi
  have colD := matCol.space at R, n2, p, D, k with ring, d, hk
  apply vecDot.split at R, n1, n2, matRow(R, n1 ⊎ n2, fromCols(R, m, n1, n2, A, B), i), matCol(R, n1 ⊎ n2, fromRows(R, n1, n2, p, C, D), k), matRow(R, n1, A, i), matCol(R, n1, C, k), matRow(R, n2, B, i), matCol(R, n2, D, k) with ring, finiteN1, finiteN2, rowF, colG, rowA, colC, rowB, colD
  . intros j hj
    have jIn := disjointSum.left at j, n1, n2 with hj
    have r1 := matRow.at at R, m, n1 ⊎ n2, fromCols(R, m, n1, n2, A, B), i, inl(j) with ring, fF, hi, jIn
    have r2 := matCol.at at R, n1 ⊎ n2, p, fromRows(R, n1, n2, p, C, D), inl(j), k with ring, fG, jIn, hk
    have r3 := matRow.at at R, m, n1, A, i, j with ring, a, hi, hj
    have r4 := matCol.at at R, n1, p, C, j, k with ring, c, hj, hk
    have g1 := fromCols.graph_entry0 at R, m, n1, n2, A, B, i, j with fv0, fv1, hi, hj
    have g2 := fromRows.graph_entry0 at R, n1, n2, p, C, D, j, k with gv0, gv1, hj, hk
    rw [r1, r2, r3, r4, g1, g2]
  . intros j hj
    have jIn := disjointSum.right at j, n1, n2 with hj
    have r1 := matRow.at at R, m, n1 ⊎ n2, fromCols(R, m, n1, n2, A, B), i, inr(j) with ring, fF, hi, jIn
    have r2 := matCol.at at R, n1 ⊎ n2, p, fromRows(R, n1, n2, p, C, D), inr(j), k with ring, fG, jIn, hk
    have r3 := matRow.at at R, m, n2, B, i, j with ring, b, hi, hj
    have r4 := matCol.at at R, n2, p, D, j, k with ring, d, hj, hk
    have g1 := fromCols.graph_entry1 at R, m, n1, n2, A, B, i, j with fv0, fv1, hi, hj
    have g2 := fromRows.graph_entry1 at R, n1, n2, p, C, D, j, k with gv0, gv1, hj, hk
    rw [r1, r2, r3, r4, g1, g2]

-- Matrix.fromRows_mul: [A; C] B = [A B; C B].
theorem fromRows.mul (m1 m2 n p A C B : Set)
  requires finite : Finite(n)
  requires a : A ∈ matrixSpace(R, m1, n)
  requires c : C ∈ matrixSpace(R, m2, n)
  requires b : B ∈ matrixSpace(R, n, p)
  shows matMul(R, m1 ⊎ m2, n, p, fromRows(R, m1, m2, n, A, C), B) =
    fromRows(R, m1, m2, p, matMul(R, m1, n, p, A, B), matMul(R, m2, n, p, C, B))
proof
  have v0 : ∀ i ∈ m1, ∀ j ∈ n, A((i, j)) ∈ R.carrier
    intros i hi j hj
    exact matrixSpace.entry_mem with a, hi, hj
  have v1 : ∀ i ∈ m2, ∀ j ∈ n, C((i, j)) ∈ R.carrier
    intros i hi j hj
    exact matrixSpace.entry_mem with c, hi, hj
  have whole := matrixSpace.of_function with (fromRows.graph_function at R, m1, m2, n, A, C with v0, v1)
  have ab := matMul.mem_of at R, m1, n, p, A, B with ring, finite, a, b
  have cb := matMul.mem_of at R, m2, n, p, C, B with ring, finite, c, b
  have pv0 : ∀ i ∈ m1, ∀ j ∈ p, matMul(R, m1, n, p, A, B)((i, j)) ∈ R.carrier
    intros i hi j hj
    exact matrixSpace.entry_mem with ab, hi, hj
  have pv1 : ∀ i ∈ m2, ∀ j ∈ p, matMul(R, m2, n, p, C, B)((i, j)) ∈ R.carrier
    intros i hi j hj
    exact matrixSpace.entry_mem with cb, hi, hj
  have left := matMul.mem_of at R, m1 ⊎ m2, n, p, fromRows(R, m1, m2, n, A, C), B with ring, finite, whole, b
  have right := matrixSpace.of_function with (fromRows.graph_function at R, m1, m2, p, matMul(R, m1, n, p, A, B), matMul(R, m2, n, p, C, B) with pv0, pv1)
  apply (matrixSpace.ext at R, m1 ⊎ m2, p, matMul(R, m1 ⊎ m2, n, p, fromRows(R, m1, m2, n, A, C), B), fromRows(R, m1, m2, p, matMul(R, m1, n, p, A, B), matMul(R, m2, n, p, C, B)) with ring, left, right).backward
  intros x hx l hl
  have sx := disjointSum.membership.forward with hx
  cases sx with lx | rx
  . obtain ⟨i, hi, xShape⟩ := lx
    rw xShape
    have e1 := matMul.at at R, m1 ⊎ m2, n, p, fromRows(R, m1, m2, n, A, C), B, inl(i), l with ring, finite, whole, b, (disjointSum.left at i, m1, m2 with hi), hl
    have e2 := fromRows.graph_entry0 at R, m1, m2, p, matMul(R, m1, n, p, A, B), matMul(R, m2, n, p, C, B), i, l with pv0, pv1, hi, hl
    have e3 := matMul.at at R, m1, n, p, A, B, i, l with ring, finite, a, b, hi, hl
    rw [e1, e2, e3]
    have xIn := disjointSum.left at i, m1, m2 with hi
    have rowF := matRow.space at R, m1 ⊎ m2, n, fromRows(R, m1, m2, n, A, C), inl(i) with ring, whole, xIn
    have rowM := matRow.space at R, m1, n, A, i with ring, a, hi
    have colB := matCol.space at R, n, p, B, l with ring, b, hl
    apply vecDot.congr_of at R, n, matRow(R, n, fromRows(R, m1, m2, n, A, C), inl(i)), matCol(R, n, B, l), matRow(R, n, A, i), matCol(R, n, B, l) with ring, finite, rowF, colB, rowM, colB
    intros j hj
    have r1 := matRow.at at R, m1 ⊎ m2, n, fromRows(R, m1, m2, n, A, C), inl(i), j with ring, whole, xIn, hj
    have r2 := matRow.at at R, m1, n, A, i, j with ring, a, hi, hj
    have r3 := fromRows.graph_entry0 at R, m1, m2, n, A, C, i, j with v0, v1, hi, hj
    rw [r1, r2, r3]
  . obtain ⟨i, hi, xShape⟩ := rx
    rw xShape
    have e1 := matMul.at at R, m1 ⊎ m2, n, p, fromRows(R, m1, m2, n, A, C), B, inr(i), l with ring, finite, whole, b, (disjointSum.right at i, m1, m2 with hi), hl
    have e2 := fromRows.graph_entry1 at R, m1, m2, p, matMul(R, m1, n, p, A, B), matMul(R, m2, n, p, C, B), i, l with pv0, pv1, hi, hl
    have e3 := matMul.at at R, m2, n, p, C, B, i, l with ring, finite, c, b, hi, hl
    rw [e1, e2, e3]
    have xIn := disjointSum.right at i, m1, m2 with hi
    have rowF := matRow.space at R, m1 ⊎ m2, n, fromRows(R, m1, m2, n, A, C), inr(i) with ring, whole, xIn
    have rowM := matRow.space at R, m2, n, C, i with ring, c, hi
    have colB := matCol.space at R, n, p, B, l with ring, b, hl
    apply vecDot.congr_of at R, n, matRow(R, n, fromRows(R, m1, m2, n, A, C), inr(i)), matCol(R, n, B, l), matRow(R, n, C, i), matCol(R, n, B, l) with ring, finite, rowF, colB, rowM, colB
    intros j hj
    have r1 := matRow.at at R, m1 ⊎ m2, n, fromRows(R, m1, m2, n, A, C), inr(i), j with ring, whole, xIn, hj
    have r2 := matRow.at at R, m2, n, C, i, j with ring, c, hi, hj
    have r3 := fromRows.graph_entry1 at R, m1, m2, n, A, C, i, j with v0, v1, hi, hj
    rw [r1, r2, r3]

-- Matrix.fromBlocks_mulVec.
theorem fromBlocks.mulVec (m1 m2 n1 n2 A B C D v : Set)
  requires finiteN1 : Finite(n1)
  requires finiteN2 : Finite(n2)
  requires a : A ∈ matrixSpace(R, m1, n1)
  requires b : B ∈ matrixSpace(R, m1, n2)
  requires c : C ∈ matrixSpace(R, m2, n1)
  requires d : D ∈ matrixSpace(R, m2, n2)
  requires vector : v ∈ functionSpace(n1 ⊎ n2, R.carrier)
  shows mulVec(R, m1 ⊎ m2, n1 ⊎ n2, fromBlocks(R, m1, m2, n1, n2, A, B, C, D), v) =
    vecAppend(R, m1, m2,
      vecAdd(R, m1, mulVec(R, m1, n1, A, compose(v, leftInclusion(n1, n2), n1,
        n1 ⊎ n2, R.carrier)), mulVec(R, m1, n2, B, compose(v,
        rightInclusion(n1, n2), n2, n1 ⊎ n2, R.carrier))),
      vecAdd(R, m2, mulVec(R, m2, n1, C, compose(v, leftInclusion(n1, n2), n1,
        n1 ⊎ n2, R.carrier)), mulVec(R, m2, n2, D, compose(v,
        rightInclusion(n1, n2), n2, n1 ⊎ n2, R.carrier))))
proof
  have vA : ∀ i ∈ m1, ∀ j ∈ n1, A((i, j)) ∈ R.carrier
    intros i hi j hj
    exact matrixSpace.entry_mem with a, hi, hj
  have vB : ∀ i ∈ m1, ∀ j ∈ n2, B((i, j)) ∈ R.carrier
    intros i hi j hj
    exact matrixSpace.entry_mem with b, hi, hj
  have vC : ∀ i ∈ m2, ∀ j ∈ n1, C((i, j)) ∈ R.carrier
    intros i hi j hj
    exact matrixSpace.entry_mem with c, hi, hj
  have vD : ∀ i ∈ m2, ∀ j ∈ n2, D((i, j)) ∈ R.carrier
    intros i hi j hj
    exact matrixSpace.entry_mem with d, hi, hj
  have mL := matrixSpace.of_function with (fromBlocks.graph_function at R, m1, m2, n1, n2, A, B, C, D with vA, vB, vC, vD)
  have finiteAll := Finite.disjointSum with finiteN1, finiteN2
  have vF := functionSpace.mem_iff.forward with vector
  have lF := leftInclusion.function_of at n1, n2
  have rF := rightInclusion.function_of at n1, n2
  have vl := functionSpace.mem_iff.backward with (compose.function at v, leftInclusion(n1, n2), n1, n1 ⊎ n2, R.carrier with lF, vF)
  have vr := functionSpace.mem_iff.backward with (compose.function at v, rightInclusion(n1, n2), n2, n1 ⊎ n2, R.carrier with rF, vF)
  have atL : ∀ j ∈ n1, compose(v, leftInclusion(n1, n2), n1, n1 ⊎ n2, R.carrier)(j) = v(inl(j))
    intros j hj
    have c0 := compose.apply at v, leftInclusion(n1, n2), n1, n1 ⊎ n2, R.carrier, j with lF, vF, hj
    have l0 := leftInclusion.at at n1, n2, j with hj
    rw [c0, l0]
  have atR : ∀ j ∈ n2, compose(v, rightInclusion(n1, n2), n2, n1 ⊎ n2, R.carrier)(j) = v(inr(j))
    intros j hj
    have c0 := compose.apply at v, rightInclusion(n1, n2), n2, n1 ⊎ n2, R.carrier, j with rF, vF, hj
    have l0 := rightInclusion.at at n1, n2, j with hj
    rw [c0, l0]
  have q0a := mulVec.mem at R, m1, n1, A, compose(v, leftInclusion(n1, n2), n1, n1 ⊎ n2, R.carrier) with ring, finiteN1, a, vl
  have q0b := mulVec.mem at R, m1, n2, B, compose(v, rightInclusion(n1, n2), n2, n1 ⊎ n2, R.carrier) with ring, finiteN2, b, vr
  have s0 := vecAdd.space at R, m1, mulVec(R, m1, n1, A, compose(v, leftInclusion(n1, n2), n1, n1 ⊎ n2, R.carrier)), mulVec(R, m1, n2, B, compose(v, rightInclusion(n1, n2), n2, n1 ⊎ n2, R.carrier)) with ring, q0a, q0b
  have w0 : ∀ i ∈ m1, vecAdd(R, m1, mulVec(R, m1, n1, A, compose(v, leftInclusion(n1, n2), n1, n1 ⊎ n2, R.carrier)), mulVec(R, m1, n2, B, compose(v, rightInclusion(n1, n2), n2, n1 ⊎ n2, R.carrier)))(i) ∈ R.carrier
    intros i hi
    exact functionSpace.apply_mem with s0, hi
  have q1a := mulVec.mem at R, m2, n1, C, compose(v, leftInclusion(n1, n2), n1, n1 ⊎ n2, R.carrier) with ring, finiteN1, c, vl
  have q1b := mulVec.mem at R, m2, n2, D, compose(v, rightInclusion(n1, n2), n2, n1 ⊎ n2, R.carrier) with ring, finiteN2, d, vr
  have s1 := vecAdd.space at R, m2, mulVec(R, m2, n1, C, compose(v, leftInclusion(n1, n2), n1, n1 ⊎ n2, R.carrier)), mulVec(R, m2, n2, D, compose(v, rightInclusion(n1, n2), n2, n1 ⊎ n2, R.carrier)) with ring, q1a, q1b
  have w1 : ∀ i ∈ m2, vecAdd(R, m2, mulVec(R, m2, n1, C, compose(v, leftInclusion(n1, n2), n1, n1 ⊎ n2, R.carrier)), mulVec(R, m2, n2, D, compose(v, rightInclusion(n1, n2), n2, n1 ⊎ n2, R.carrier)))(i) ∈ R.carrier
    intros i hi
    exact functionSpace.apply_mem with s1, hi
  have left := mulVec.mem at R, m1 ⊎ m2, n1 ⊎ n2, fromBlocks(R, m1, m2, n1, n2, A, B, C, D), v with ring, finiteAll, mL, vector
  have right := functionSpace.mem_iff.backward with (vecAppend.graph_function at R, m1, m2, vecAdd(R, m1, mulVec(R, m1, n1, A, compose(v, leftInclusion(n1, n2), n1, n1 ⊎ n2, R.carrier)), mulVec(R, m1, n2, B, compose(v, rightInclusion(n1, n2), n2, n1 ⊎ n2, R.carrier))), vecAdd(R, m2, mulVec(R, m2, n1, C, compose(v, leftInclusion(n1, n2), n1, n1 ⊎ n2, R.carrier)), mulVec(R, m2, n2, D, compose(v, rightInclusion(n1, n2), n2, n1 ⊎ n2, R.carrier))) with w0, w1)
  apply functionSpace.ext_of with left, right
  intros x hx
  have sx := disjointSum.membership.forward with hx
  cases sx with lx | rx
  . obtain ⟨i, hi, xShape⟩ := lx
    rw xShape
    have xIn := disjointSum.left at i, m1, m2 with hi
    have e1 := mulVec.apply at R, m1 ⊎ m2, n1 ⊎ n2, fromBlocks(R, m1, m2, n1, n2, A, B, C, D), v, inl(i) with ring, finiteAll, mL, vector, xIn
    have e2 := vecAppend.graph_entry0 at R, m1, m2, vecAdd(R, m1, mulVec(R, m1, n1, A, compose(v, leftInclusion(n1, n2), n1, n1 ⊎ n2, R.carrier)), mulVec(R, m1, n2, B, compose(v, rightInclusion(n1, n2), n2, n1 ⊎ n2, R.carrier))), vecAdd(R, m2, mulVec(R, m2, n1, C, compose(v, leftInclusion(n1, n2), n1, n1 ⊎ n2, R.carrier)), mulVec(R, m2, n2, D, compose(v, rightInclusion(n1, n2), n2, n1 ⊎ n2, R.carrier))), i with w0, w1, hi
    have e3 := vecAdd.at at R, m1, mulVec(R, m1, n1, A, compose(v, leftInclusion(n1, n2), n1, n1 ⊎ n2, R.carrier)), mulVec(R, m1, n2, B, compose(v, rightInclusion(n1, n2), n2, n1 ⊎ n2, R.carrier)), i with ring, q0a, q0b, hi
    have e4 := mulVec.apply at R, m1, n1, A, compose(v, leftInclusion(n1, n2), n1, n1 ⊎ n2, R.carrier), i with ring, finiteN1, a, vl, hi
    have e5 := mulVec.apply at R, m1, n2, B, compose(v, rightInclusion(n1, n2), n2, n1 ⊎ n2, R.carrier), i with ring, finiteN2, b, vr, hi
    rw [e1, e2, e3, e4, e5]
    have rowL := matRow.space at R, m1 ⊎ m2, n1 ⊎ n2, fromBlocks(R, m1, m2, n1, n2, A, B, C, D), inl(i) with ring, mL, xIn
    have rowX1 := matRow.space at R, m1, n1, A, i with ring, a, hi
    have rowX2 := matRow.space at R, m1, n2, B, i with ring, b, hi
    apply vecDot.split at R, n1, n2, matRow(R, n1 ⊎ n2, fromBlocks(R, m1, m2, n1, n2, A, B, C, D), inl(i)), v, matRow(R, n1, A, i), compose(v, leftInclusion(n1, n2), n1, n1 ⊎ n2, R.carrier), matRow(R, n2, B, i), compose(v, rightInclusion(n1, n2), n2, n1 ⊎ n2, R.carrier) with ring, finiteN1, finiteN2, rowL, vector, rowX1, vl, rowX2, vr
    . intros j hj
      have jIn := disjointSum.left at j, n1, n2 with hj
      have r1 := matRow.at at R, m1 ⊎ m2, n1 ⊎ n2, fromBlocks(R, m1, m2, n1, n2, A, B, C, D), inl(i), inl(j) with ring, mL, xIn, jIn
      have r3 := matRow.at at R, m1, n1, A, i, j with ring, a, hi, hj
      have g1 := fromBlocks.graph_entry0 at R, m1, m2, n1, n2, A, B, C, D, i, j with vA, vB, vC, vD, hi, hj
      have g2 := atL with j, hj
      rw [r1, r3, g1, g2]
    . intros j hj
      have jIn := disjointSum.right at j, n1, n2 with hj
      have r1 := matRow.at at R, m1 ⊎ m2, n1 ⊎ n2, fromBlocks(R, m1, m2, n1, n2, A, B, C, D), inl(i), inr(j) with ring, mL, xIn, jIn
      have r3 := matRow.at at R, m1, n2, B, i, j with ring, b, hi, hj
      have g1 := fromBlocks.graph_entry1 at R, m1, m2, n1, n2, A, B, C, D, i, j with vA, vB, vC, vD, hi, hj
      have g2 := atR with j, hj
      rw [r1, r3, g1, g2]
  . obtain ⟨i, hi, xShape⟩ := rx
    rw xShape
    have xIn := disjointSum.right at i, m1, m2 with hi
    have e1 := mulVec.apply at R, m1 ⊎ m2, n1 ⊎ n2, fromBlocks(R, m1, m2, n1, n2, A, B, C, D), v, inr(i) with ring, finiteAll, mL, vector, xIn
    have e2 := vecAppend.graph_entry1 at R, m1, m2, vecAdd(R, m1, mulVec(R, m1, n1, A, compose(v, leftInclusion(n1, n2), n1, n1 ⊎ n2, R.carrier)), mulVec(R, m1, n2, B, compose(v, rightInclusion(n1, n2), n2, n1 ⊎ n2, R.carrier))), vecAdd(R, m2, mulVec(R, m2, n1, C, compose(v, leftInclusion(n1, n2), n1, n1 ⊎ n2, R.carrier)), mulVec(R, m2, n2, D, compose(v, rightInclusion(n1, n2), n2, n1 ⊎ n2, R.carrier))), i with w0, w1, hi
    have e3 := vecAdd.at at R, m2, mulVec(R, m2, n1, C, compose(v, leftInclusion(n1, n2), n1, n1 ⊎ n2, R.carrier)), mulVec(R, m2, n2, D, compose(v, rightInclusion(n1, n2), n2, n1 ⊎ n2, R.carrier)), i with ring, q1a, q1b, hi
    have e4 := mulVec.apply at R, m2, n1, C, compose(v, leftInclusion(n1, n2), n1, n1 ⊎ n2, R.carrier), i with ring, finiteN1, c, vl, hi
    have e5 := mulVec.apply at R, m2, n2, D, compose(v, rightInclusion(n1, n2), n2, n1 ⊎ n2, R.carrier), i with ring, finiteN2, d, vr, hi
    rw [e1, e2, e3, e4, e5]
    have rowL := matRow.space at R, m1 ⊎ m2, n1 ⊎ n2, fromBlocks(R, m1, m2, n1, n2, A, B, C, D), inr(i) with ring, mL, xIn
    have rowX1 := matRow.space at R, m2, n1, C, i with ring, c, hi
    have rowX2 := matRow.space at R, m2, n2, D, i with ring, d, hi
    apply vecDot.split at R, n1, n2, matRow(R, n1 ⊎ n2, fromBlocks(R, m1, m2, n1, n2, A, B, C, D), inr(i)), v, matRow(R, n1, C, i), compose(v, leftInclusion(n1, n2), n1, n1 ⊎ n2, R.carrier), matRow(R, n2, D, i), compose(v, rightInclusion(n1, n2), n2, n1 ⊎ n2, R.carrier) with ring, finiteN1, finiteN2, rowL, vector, rowX1, vl, rowX2, vr
    . intros j hj
      have jIn := disjointSum.left at j, n1, n2 with hj
      have r1 := matRow.at at R, m1 ⊎ m2, n1 ⊎ n2, fromBlocks(R, m1, m2, n1, n2, A, B, C, D), inr(i), inl(j) with ring, mL, xIn, jIn
      have r3 := matRow.at at R, m2, n1, C, i, j with ring, c, hi, hj
      have g1 := fromBlocks.graph_entry2 at R, m1, m2, n1, n2, A, B, C, D, i, j with vA, vB, vC, vD, hi, hj
      have g2 := atL with j, hj
      rw [r1, r3, g1, g2]
    . intros j hj
      have jIn := disjointSum.right at j, n1, n2 with hj
      have r1 := matRow.at at R, m1 ⊎ m2, n1 ⊎ n2, fromBlocks(R, m1, m2, n1, n2, A, B, C, D), inr(i), inr(j) with ring, mL, xIn, jIn
      have r3 := matRow.at at R, m2, n2, D, i, j with ring, d, hi, hj
      have g1 := fromBlocks.graph_entry3 at R, m1, m2, n1, n2, A, B, C, D, i, j with vA, vB, vC, vD, hi, hj
      have g2 := atR with j, hj
      rw [r1, r3, g1, g2]

-- The block-triangular matrices for b and lt are closed under products
-- (Matrix.BlockTriangular.mul).
theorem BlockTriangular.mul (n A B b lt T : Set)
  requires finite : Finite(n)
  requires order : StrictLinearOrder(T, lt)
  requires blocks : b : n → T
  requires first : A ∈ matrixSpace(R, n, n)
  requires second : B ∈ matrixSpace(R, n, n)
  requires triangularA : BlockTriangular(R, n, A, b, lt)
  requires triangularB : BlockTriangular(R, n, B, b, lt)
  shows BlockTriangular(R, n, matMul(R, n, n, n, A, B), b, lt)
proof
  have ringR := CommRing.to_ring with ring
  have zeroIn := Ring.zero_mem at R with ringR
  obtain ⟨strict, connected⟩ := order
  obtain ⟨relation, irreflexive, transitive⟩ := strict
  unfold BlockTriangular
  intros i hi j hj below
  have e1 := matMul.at at R, n, n, n, A, B, i, j with ring, finite, first, second, hi, hj
  rw e1
  have rowA := matRow.space at R, n, n, A, i with ring, first, hi
  have colB := matCol.space at R, n, n, B, j with ring, second, hj
  have scaled := vecDot.scale_of at R, n, matRow(R, n, A, i), matCol(R, n, B, j), R.zero, matRow(R, n, A, i), matCol(R, n, B, j) with ring, finite, zeroIn, rowA, colB, rowA, colB
  have dot := vecDot.mem_of at R, n, matRow(R, n, A, i), matCol(R, n, B, j) with ring, finite, rowA, colB
  have law : vecDot(R, n, matRow(R, n, A, i), matCol(R, n, B, j)) = R.zero * vecDot(R, n, matRow(R, n, A, i), matCol(R, n, B, j))
    apply scaled
    intros k hk
    have a := matrixSpace.entry_mem with first, hi, hk
    have c := matrixSpace.entry_mem with second, hk, hj
    have r1 := matRow.at at R, n, n, A, i, k with ring, first, hi, hk
    have r2 := matCol.at at R, n, n, B, k, j with ring, second, hk, hj
    rw [r1, r2]
    have bi := FunctionBetween.apply_closed with blocks, hi
    have bj := FunctionBetween.apply_closed with blocks, hj
    have bk := FunctionBetween.apply_closed with blocks, hk
    by_cases ki : (b(k), b(i)) ∈ T × T ∧ relates(lt, b(k), b(i))
    . obtain ⟨_, rel⟩ := ki
      unfold relates at rel
      have z := triangularA with i, hi, k, hk, rel
      rw z
      ring
    . have notKI : ¬relates(lt, b(k), b(i))
        intro rel
        have pair := product.pair at b(k), b(i), T, T with bk, bi
        exact ki with ⟨pair, rel⟩
      have jk : relates(lt, b(j), b(k))
        by_cases same : b(k) = b(i)
        . unfold relates
          rw same
          exact below
        . have cases := connected with b(k), bk, b(i), bi, same
          cases cases with ki2 | ik
          . exfalso
            exact notKI with ki2
          . have ji : relates(lt, b(j), b(i))
              unfold relates
              exact below
            exact transitive with b(j), bj, b(i), bi, b(k), bk, ji, ik
      unfold relates at jk
      have z := triangularB with k, hk, j, hj, jk
      rw z
      ring
  rw law
  ring

-- Matrix.map_mul, map_add, map_one under a ring map, and the transpose.
theorem matMap.mul (S m n p f A B : Set)
  requires target : CommRing(S)
  requires finite : Finite(n)
  requires hom : RingHom(f, R, S)
  requires first : A ∈ matrixSpace(R, m, n)
  requires second : B ∈ matrixSpace(R, n, p)
  shows matMap(S, m, p, f, matMul(R, m, n, p, A, B)) =
    matMul(S, m, n, p, matMap(S, m, n, f, A), matMap(S, n, p, f, B))
proof
  obtain ⟨src, tgt, fF, f0, f1, fneg, fadd, fmul⟩ := hom
  have ab := matMul.mem_of at R, m, n, p, A, B with ring, finite, first, second
  have vA : ∀ i ∈ m, ∀ j ∈ n, f(A((i, j))) ∈ S.carrier
    intros i hi j hj
    exact FunctionBetween.apply_closed with fF, (matrixSpace.entry_mem with first, hi, hj)
  have vB : ∀ i ∈ n, ∀ j ∈ p, f(B((i, j))) ∈ S.carrier
    intros i hi j hj
    exact FunctionBetween.apply_closed with fF, (matrixSpace.entry_mem with second, hi, hj)
  have vAB : ∀ i ∈ m, ∀ j ∈ p, f(matMul(R, m, n, p, A, B)((i, j))) ∈ S.carrier
    intros i hi j hj
    exact FunctionBetween.apply_closed with fF, (matrixSpace.entry_mem with ab, hi, hj)
  have mA := matrixSpace.of_function with (matMap.graph_function at S, m, n, f, A with vA)
  have mB := matrixSpace.of_function with (matMap.graph_function at S, n, p, f, B with vB)
  have mAB := matrixSpace.of_function with (matMap.graph_function at S, m, p, f, matMul(R, m, n, p, A, B) with vAB)
  have right := matMul.mem_of at S, m, n, p, matMap(S, m, n, f, A), matMap(S, n, p, f, B) with target, finite, mA, mB
  apply (matrixSpace.ext at S, m, p, matMap(S, m, p, f, matMul(R, m, n, p, A, B)), matMul(S, m, n, p, matMap(S, m, n, f, A), matMap(S, n, p, f, B)) with target, mAB, right).backward
  intros i hi k hk
  have e1 := matMap.graph_entry at S, m, p, f, matMul(R, m, n, p, A, B), i, k with vAB, hi, hk
  have e2 := matMul.at at R, m, n, p, A, B, i, k with ring, finite, first, second, hi, hk
  have e3 := matMul.at at S, m, n, p, matMap(S, m, n, f, A), matMap(S, n, p, f, B), i, k with target, finite, mA, mB, hi, hk
  rw [e1, e2, e3]
  have rowA := matRow.space at R, m, n, A, i with ring, first, hi
  have colB := matCol.space at R, n, p, B, k with ring, second, hk
  have rowFA := matRow.space at S, m, n, matMap(S, m, n, f, A), i with target, mA, hi
  have colFB := matCol.space at S, n, p, matMap(S, n, p, f, B), k with target, mB, hk
  apply vecDot.map_of at R, S, f, n, matRow(R, n, A, i), matCol(R, n, B, k), matRow(S, n, matMap(S, m, n, f, A), i), matCol(S, n, matMap(S, n, p, f, B), k) with ring, target, hom, finite, rowA, colB, rowFA, colFB
  intros j hj
  have a := matrixSpace.entry_mem with first, hi, hj
  have b := matrixSpace.entry_mem with second, hj, hk
  have g1 := matRow.at at S, m, n, matMap(S, m, n, f, A), i, j with target, mA, hi, hj
  have g2 := matCol.at at S, n, p, matMap(S, n, p, f, B), j, k with target, mB, hj, hk
  have g3 := matRow.at at R, m, n, A, i, j with ring, first, hi, hj
  have g4 := matCol.at at R, n, p, B, j, k with ring, second, hj, hk
  have g5 := matMap.graph_entry at S, m, n, f, A, i, j with vA, hi, hj
  have g6 := matMap.graph_entry at S, n, p, f, B, j, k with vB, hj, hk
  have law := fmul with A((i, j)), a, B((j, k)), b
  rw [g1, g2, g3, g4, g5, g6, law]

theorem matMap.add (S m n f A B : Set)
  requires target : CommRing(S)
  requires hom : RingHom(f, R, S)
  requires first : A ∈ matrixSpace(R, m, n)
  requires second : B ∈ matrixSpace(R, m, n)
  shows matMap(S, m, n, f, matAdd(R, m, n, A, B)) =
    matAdd(S, m, n, matMap(S, m, n, f, A), matMap(S, m, n, f, B))
proof
  obtain ⟨src, tgt, fF, f0, f1, fneg, fadd, fmul⟩ := hom
  have ab := matAdd.mem_of at R, m, n, A, B with ring, first, second
  have mapValues : ∀ i ∈ m, ∀ j ∈ n, f(A((i, j))) ∈ S.carrier
    intros i hi j hj
    have entry := matrixSpace.entry_mem with first, hi, hj
    exact FunctionBetween.apply_closed with fF, entry
  have mapValuesB : ∀ i ∈ m, ∀ j ∈ n, f(B((i, j))) ∈ S.carrier
    intros i hi j hj
    have entry := matrixSpace.entry_mem with second, hi, hj
    exact FunctionBetween.apply_closed with fF, entry
  have mapValuesAB : ∀ i ∈ m, ∀ j ∈ n, f(matAdd(R, m, n, A, B)((i, j))) ∈ S.carrier
    intros i hi j hj
    have entry := matrixSpace.entry_mem with ab, hi, hj
    exact FunctionBetween.apply_closed with fF, entry
  have mA := matrixSpace.of_function with (matMap.graph_function at S, m, n, f, A with mapValues)
  have mB := matrixSpace.of_function with (matMap.graph_function at S, m, n, f, B with mapValuesB)
  have mAB := matrixSpace.of_function with (matMap.graph_function at S, m, n, f, matAdd(R, m, n, A, B) with mapValuesAB)
  have right := matAdd.mem_of at S, m, n, matMap(S, m, n, f, A), matMap(S, m, n, f, B) with target, mA, mB
  apply (matrixSpace.ext at S, m, n, matMap(S, m, n, f, matAdd(R, m, n, A, B)), matAdd(S, m, n, matMap(S, m, n, f, A), matMap(S, m, n, f, B)) with target, mAB, right).backward
  intros i hi j hj
  have a := matrixSpace.entry_mem with first, hi, hj
  have b := matrixSpace.entry_mem with second, hi, hj
  have e1 := matMap.graph_entry at S, m, n, f, matAdd(R, m, n, A, B), i, j with mapValuesAB, hi, hj
  have e2 := matAdd.at at R, m, n, A, B, i, j with ring, first, second, hi, hj
  have e3 := matAdd.at at S, m, n, matMap(S, m, n, f, A), matMap(S, m, n, f, B), i, j with target, mA, mB, hi, hj
  have e4 := matMap.graph_entry at S, m, n, f, A, i, j with mapValues, hi, hj
  have e5 := matMap.graph_entry at S, m, n, f, B, i, j with mapValuesB, hi, hj
  have law := fadd with A((i, j)), a, B((i, j)), b
  rw [e1, e2, e3, e4, e5, law]

theorem matMap.one (S n f : Set)
  requires target : CommRing(S)
  requires hom : RingHom(f, R, S)
  shows matMap(S, n, n, f, matOne(R, n)) = matOne(S, n)
proof
  obtain ⟨src, tgt, fF, f0, f1, fneg, fadd, fmul⟩ := hom
  have oneR := matOne.mem_of at R, n with ring
  have oneS := matOne.mem_of at S, n with target
  have mapValues : ∀ i ∈ n, ∀ j ∈ n, f(matOne(R, n)((i, j))) ∈ S.carrier
    intros i hi j hj
    have entry := matrixSpace.entry_mem with oneR, hi, hj
    exact FunctionBetween.apply_closed with fF, entry
  have mapped := matrixSpace.of_function with (matMap.graph_function at S, n, n, f, matOne(R, n) with mapValues)
  apply (matrixSpace.ext at S, n, n, matMap(S, n, n, f, matOne(R, n)), matOne(S, n) with target, mapped, oneS).backward
  intros i hi j hj
  have e1 := matMap.graph_entry at S, n, n, f, matOne(R, n), i, j with mapValues, hi, hj
  rw e1
  by_cases same : i = j
  . rw same
    have r1 := matOne.same at R, n, j with ring, hj
    have r2 := matOne.same at S, n, j with target, hj
    rw [r1, r2]
    exact f1
  . have r1 := matOne.other at R, n, i, j with ring, hi, hj, same
    have r2 := matOne.other at S, n, i, j with target, hi, hj, same
    rw [r1, r2]
    exact f0

theorem matMap.mulVec (S m n f A v : Set)
  requires target : CommRing(S)
  requires finite : Finite(n)
  requires hom : RingHom(f, R, S)
  requires matrix : A ∈ matrixSpace(R, m, n)
  requires vector : v ∈ functionSpace(n, R.carrier)
  shows compose(f, mulVec(R, m, n, A, v), m, R.carrier, S.carrier) =
    mulVec(S, m, n, matMap(S, m, n, f, A), compose(f, v, n, R.carrier, S.carrier))
proof
  obtain ⟨src, tgt, fF, f0, f1, fneg, fadd, fmul⟩ := hom
  have vA : ∀ i ∈ m, ∀ j ∈ n, f(A((i, j))) ∈ S.carrier
    intros i hi j hj
    exact FunctionBetween.apply_closed with fF, (matrixSpace.entry_mem with matrix, hi, hj)
  have mA := matrixSpace.of_function with (matMap.graph_function at S, m, n, f, A with vA)
  have av := mulVec.mem at R, m, n, A, v with ring, finite, matrix, vector
  have avF := functionSpace.mem_iff.forward with av
  have vF := functionSpace.mem_iff.forward with vector
  have fvF := compose.function at f, v, n, R.carrier, S.carrier with vF, fF
  have fv := functionSpace.mem_iff.backward with fvF
  have left := functionSpace.mem_iff.backward with (compose.function at f, mulVec(R, m, n, A, v), m, R.carrier, S.carrier with avF, fF)
  have right := mulVec.mem at S, m, n, matMap(S, m, n, f, A), compose(f, v, n, R.carrier, S.carrier) with target, finite, mA, fv
  apply functionSpace.ext_of with left, right
  intros i hi
  have e1 := compose.apply at f, mulVec(R, m, n, A, v), m, R.carrier, S.carrier, i with avF, fF, hi
  have e2 := mulVec.apply at R, m, n, A, v, i with ring, finite, matrix, vector, hi
  have e3 := mulVec.apply at S, m, n, matMap(S, m, n, f, A), compose(f, v, n, R.carrier, S.carrier), i with target, finite, mA, fv, hi
  rw [e1, e2, e3]
  have rowA := matRow.space at R, m, n, A, i with ring, matrix, hi
  have rowFA := matRow.space at S, m, n, matMap(S, m, n, f, A), i with target, mA, hi
  apply vecDot.map_of at R, S, f, n, matRow(R, n, A, i), v, matRow(S, n, matMap(S, m, n, f, A), i), compose(f, v, n, R.carrier, S.carrier) with ring, target, hom, finite, rowA, vector, rowFA, fv
  intros j hj
  have a := matrixSpace.entry_mem with matrix, hi, hj
  have b := functionSpace.apply_mem with vector, hj
  have g1 := matRow.at at S, m, n, matMap(S, m, n, f, A), i, j with target, mA, hi, hj
  have g2 := compose.apply at f, v, n, R.carrier, S.carrier, j with vF, fF, hj
  have g3 := matRow.at at R, m, n, A, i, j with ring, matrix, hi, hj
  have g5 := matMap.graph_entry at S, m, n, f, A, i, j with vA, hi, hj
  have law := fmul with A((i, j)), a, v(j), b
  rw [g1, g2, g3, g5, law]

-- Matrix.map_injective.
theorem matMap.injective (S m n f A B : Set)
  requires hom : RingHom(f, R, S)
  requires injective : InjectiveBetween(f, R.carrier, S.carrier)
  requires first : A ∈ matrixSpace(R, m, n)
  requires second : B ∈ matrixSpace(R, m, n)
  requires same : matMap(S, m, n, f, A) = matMap(S, m, n, f, B)
  shows A = B
proof
  have fA := matrixSpace.function with first
  have fB := matrixSpace.function with second
  apply FunctionBetween.ext with fA, fB
  intros q hq
  obtain ⟨bound, i, hi, j, hj, shape⟩ := product.membership.forward with hq
  rw shape
  have a := matrixSpace.entry_mem with first, hi, hj
  have b := matrixSpace.entry_mem with second, hi, hj
  have ea := matMap.entry at R, S, m, n, f, A, i, j with ring, hom, first, hi, hj
  have eb := matMap.entry at R, S, m, n, f, B, i, j with ring, hom, second, hi, hj
  have entries : matMap(S, m, n, f, A)((i, j)) = matMap(S, m, n, f, B)((i, j))
    rw same
  rw [ea, eb] at entries
  exact InjectiveBetween.apply_cancel with injective, a, b, entries

end Products

-- Section: Conjugate transpose
section Conjugate
variable (R σ : Set)
hypothesis involution : RingInvolution(σ, R)

-- Matrix.conjTranspose_mul: (A B)ᴴ = Bᴴ Aᴴ.
theorem conjTranspose.mul (m n p A B : Set)
  requires finite : Finite(n)
  requires first : A ∈ matrixSpace(R, m, n)
  requires second : B ∈ matrixSpace(R, n, p)
  shows conjTranspose(R, σ, m, p, matMul(R, m, n, p, A, B)) =
    matMul(R, p, n, m, conjTranspose(R, σ, n, p, B), conjTranspose(R, σ, m, n, A))
proof
  have ab := matMul.mem_of at R, m, n, p, A, B with (involution.left), finite, first, second
  have left := conjTranspose.mem_of at R, σ, m, p, matMul(R, m, n, p, A, B) with involution, ab
  have cA := conjTranspose.mem_of at R, σ, m, n, A with involution, first
  have cB := conjTranspose.mem_of at R, σ, n, p, B with involution, second
  obtain ⟨comm, hom, involutive⟩ := involution
  have right := matMul.mem_of at R, p, n, m, conjTranspose(R, σ, n, p, B), conjTranspose(R, σ, m, n, A) with comm, finite, cB, cA
  apply (matrixSpace.ext at R, p, m, conjTranspose(R, σ, m, p, matMul(R, m, n, p, A, B)), matMul(R, p, n, m, conjTranspose(R, σ, n, p, B), conjTranspose(R, σ, m, n, A)) with comm, left, right).backward
  intros k hk i hi
  have e1 := conjTranspose.at at R, σ, m, p, matMul(R, m, n, p, A, B), i, k with involution, ab, hi, hk
  have e2 := matMul.at at R, m, n, p, A, B, i, k with comm, finite, first, second, hi, hk
  have e3 := matMul.at at R, p, n, m, conjTranspose(R, σ, n, p, B), conjTranspose(R, σ, m, n, A), k, i with comm, finite, cB, cA, hk, hi
  rw [e1, e2, e3]
  have rowA := matRow.space at R, m, n, A, i with comm, first, hi
  have colB := matCol.space at R, n, p, B, k with comm, second, hk
  have rowB := matRow.space at R, p, n, conjTranspose(R, σ, n, p, B), k with comm, cB, hk
  have colA := matCol.space at R, n, m, conjTranspose(R, σ, m, n, A), i with comm, cA, hi
  apply vecDot.map_of at R, R, σ, n, matRow(R, n, A, i), matCol(R, n, B, k), matRow(R, n, conjTranspose(R, σ, n, p, B), k), matCol(R, n, conjTranspose(R, σ, m, n, A), i) with comm, comm, hom, finite, rowA, colB, rowB, colA
  intros j hj
  have a := matrixSpace.entry_mem with first, hi, hj
  have b := matrixSpace.entry_mem with second, hj, hk
  have g1 := matRow.at at R, p, n, conjTranspose(R, σ, n, p, B), k, j with comm, cB, hk, hj
  have g2 := matCol.at at R, n, m, conjTranspose(R, σ, m, n, A), j, i with comm, cA, hj, hi
  have g3 := matRow.at at R, m, n, A, i, j with comm, first, hi, hj
  have g4 := matCol.at at R, n, p, B, j, k with comm, second, hj, hk
  have g5 := conjTranspose.at at R, σ, n, p, B, j, k with involution, second, hj, hk
  have g6 := conjTranspose.at at R, σ, m, n, A, i, j with involution, first, hi, hj
  have law := RingHom.map_mul at σ, R, R, A((i, j)), B((j, k)) with hom, a, b
  have sa := RingHom.map_mem at σ, R, R, A((i, j)) with hom, a
  have sb := RingHom.map_mem at σ, R, R, B((j, k)) with hom, b
  rw [g1, g2, g3, g4, g5, g6, law]
  ring

theorem conjTranspose.involution (m n A : Set)
  requires matrix : A ∈ matrixSpace(R, m, n)
  shows conjTranspose(R, σ, n, m, conjTranspose(R, σ, m, n, A)) = A
proof
  have once := conjTranspose.mem_of at R, σ, m, n, A with involution, matrix
  have twice := conjTranspose.mem_of at R, σ, n, m, conjTranspose(R, σ, m, n, A) with involution, once
  obtain ⟨comm, hom, involutive⟩ := involution
  apply (matrixSpace.ext at R, m, n, conjTranspose(R, σ, n, m, conjTranspose(R, σ, m, n, A)), A with comm, twice, matrix).backward
  intros i hi j hj
  have e1 := conjTranspose.at at R, σ, n, m, conjTranspose(R, σ, m, n, A), j, i with involution, once, hj, hi
  have e2 := conjTranspose.at at R, σ, m, n, A, i, j with involution, matrix, hi, hj
  have a := matrixSpace.entry_mem with matrix, hi, hj
  have back := involutive with A((i, j)), a
  rw [e1, e2, back]

theorem conjTranspose.add (m n A B : Set)
  requires first : A ∈ matrixSpace(R, m, n)
  requires second : B ∈ matrixSpace(R, m, n)
  shows conjTranspose(R, σ, m, n, matAdd(R, m, n, A, B)) =
    matAdd(R, n, m, conjTranspose(R, σ, m, n, A), conjTranspose(R, σ, m, n, B))
proof
  have ab := matAdd.mem_of at R, m, n, A, B with (involution.left), first, second
  have left := conjTranspose.mem_of at R, σ, m, n, matAdd(R, m, n, A, B) with involution, ab
  have cA := conjTranspose.mem_of at R, σ, m, n, A with involution, first
  have cB := conjTranspose.mem_of at R, σ, m, n, B with involution, second
  obtain ⟨comm, hom, involutive⟩ := involution
  have right := matAdd.mem_of at R, n, m, conjTranspose(R, σ, m, n, A), conjTranspose(R, σ, m, n, B) with comm, cA, cB
  apply (matrixSpace.ext at R, n, m, conjTranspose(R, σ, m, n, matAdd(R, m, n, A, B)), matAdd(R, n, m, conjTranspose(R, σ, m, n, A), conjTranspose(R, σ, m, n, B)) with comm, left, right).backward
  intros j hj i hi
  have a := matrixSpace.entry_mem with first, hi, hj
  have b := matrixSpace.entry_mem with second, hi, hj
  have e1 := conjTranspose.at at R, σ, m, n, matAdd(R, m, n, A, B), i, j with involution, ab, hi, hj
  have e2 := matAdd.at at R, m, n, A, B, i, j with comm, first, second, hi, hj
  have e3 := matAdd.at at R, n, m, conjTranspose(R, σ, m, n, A), conjTranspose(R, σ, m, n, B), j, i with comm, cA, cB, hj, hi
  have e4 := conjTranspose.at at R, σ, m, n, A, i, j with involution, first, hi, hj
  have e5 := conjTranspose.at at R, σ, m, n, B, i, j with involution, second, hi, hj
  have law := RingHom.map_add at σ, R, R, A((i, j)), B((i, j)) with hom, a, b
  rw [e1, e2, e3, e4, e5, law]

theorem conjTranspose.one (n : Set)
  shows conjTranspose(R, σ, n, n, matOne(R, n)) = matOne(R, n)
proof
  obtain ⟨comm, hom, involutive⟩ := involution
  have one := matOne.mem_of at R, n with comm
  have left := conjTranspose.mem_of at R, σ, n, n, matOne(R, n) with involution, one
  apply (matrixSpace.ext at R, n, n, conjTranspose(R, σ, n, n, matOne(R, n)), matOne(R, n) with comm, left, one).backward
  intros j hj i hi
  have e1 := conjTranspose.at at R, σ, n, n, matOne(R, n), i, j with involution, one, hi, hj
  rw e1
  by_cases same : i = j
  . rw same
    have o := matOne.same at R, n, j with comm, hj
    rw o
    exact RingHom.map_one at σ, R, R with hom
  . have other : j ≠ i
      intro back
      have forth : i = j
        symm
        exact back
      exact same with forth
    have o1 := matOne.other at R, n, i, j with comm, hi, hj, same
    have o2 := matOne.other at R, n, j, i with comm, hj, hi, other
    rw [o1, o2]
    exact RingHom.map_zero at σ, R, R with hom

-- Matrix.star_mulVec: σ(A v) = σ(v) Aᴴ.
theorem conjTranspose.star_mulVec (m n A v : Set)
  requires finite : Finite(n)
  requires matrix : A ∈ matrixSpace(R, m, n)
  requires vector : v ∈ functionSpace(n, R.carrier)
  shows vecConj(R, σ, m, mulVec(R, m, n, A, v)) =
    vecMul(R, n, m, vecConj(R, σ, n, v), conjTranspose(R, σ, m, n, A))
proof
  have vc := vecConj.space at R, σ, n, v with involution, vector
  have cA := conjTranspose.mem_of at R, σ, m, n, A with involution, matrix
  obtain ⟨comm, hom, involutive⟩ := involution
  have av := mulVec.mem at R, m, n, A, v with comm, finite, matrix, vector
  have left := vecConj.space at R, σ, m, mulVec(R, m, n, A, v) with involution, av
  have values : ∀ x ∈ m, vecDot(R, n, vecConj(R, σ, n, v), matCol(R, n, conjTranspose(R, σ, m, n, A), x)) ∈ R.carrier
    intros x hx
    have colS := matCol.space at R, n, m, conjTranspose(R, σ, m, n, A), x with comm, cA, hx
    exact vecDot.mem_of at R, n, vecConj(R, σ, n, v), matCol(R, n, conjTranspose(R, σ, m, n, A), x) with comm, finite, vc, colS
  have right := functionSpace.mem_iff.backward with (vecMul.graph_function at R, n, m, vecConj(R, σ, n, v), conjTranspose(R, σ, m, n, A) with values)
  apply functionSpace.ext_of with left, right
  intros i hi
  have e1 := vecConj.at at R, σ, m, mulVec(R, m, n, A, v), i with involution, av, hi
  have e2 := mulVec.apply at R, m, n, A, v, i with comm, finite, matrix, vector, hi
  have e3 := vecMul.apply at R, n, m, vecConj(R, σ, n, v), conjTranspose(R, σ, m, n, A), i with comm, finite, cA, vc, hi
  rw [e1, e2, e3]
  have rowA := matRow.space at R, m, n, A, i with comm, matrix, hi
  have colA := matCol.space at R, n, m, conjTranspose(R, σ, m, n, A), i with comm, cA, hi
  apply vecDot.map_of at R, R, σ, n, matRow(R, n, A, i), v, vecConj(R, σ, n, v), matCol(R, n, conjTranspose(R, σ, m, n, A), i) with comm, comm, hom, finite, rowA, vector, vc, colA
  intros j hj
  have a := matrixSpace.entry_mem with matrix, hi, hj
  have b := functionSpace.apply_mem with vector, hj
  have g1 := vecConj.at at R, σ, n, v, j with involution, vector, hj
  have g2 := matCol.at at R, n, m, conjTranspose(R, σ, m, n, A), j, i with comm, cA, hj, hi
  have g3 := matRow.at at R, m, n, A, i, j with comm, matrix, hi, hj
  have g4 := conjTranspose.at at R, σ, m, n, A, i, j with involution, matrix, hi, hj
  have law := RingHom.map_mul at σ, R, R, A((i, j)), v(j) with hom, a, b
  have sa := RingHom.map_mem at σ, R, R, A((i, j)) with hom, a
  have sb := RingHom.map_mem at σ, R, R, v(j) with hom, b
  rw [g1, g2, g3, g4, law]
  ring

-- Matrix.star_dotProduct: σ(v ⬝ w) = σ(v) ⬝ σ(w).
theorem vecDot.star (n v w : Set)
  requires finite : Finite(n)
  requires first : v ∈ functionSpace(n, R.carrier)
  requires second : w ∈ functionSpace(n, R.carrier)
  shows σ(vecDot(R, n, v, w)) = vecDot(R, n, vecConj(R, σ, n, v), vecConj(R, σ, n, w))
proof
  have vc := vecConj.space at R, σ, n, v with involution, first
  have wc := vecConj.space at R, σ, n, w with involution, second
  obtain ⟨comm, hom, involutive⟩ := involution
  apply vecDot.map_of at R, R, σ, n, v, w, vecConj(R, σ, n, v), vecConj(R, σ, n, w) with comm, comm, hom, finite, first, second, vc, wc
  intros j hj
  have a := functionSpace.apply_mem with first, hj
  have b := functionSpace.apply_mem with second, hj
  have e1 := vecConj.at at R, σ, n, v, j with involution, first, hj
  have e2 := vecConj.at at R, σ, n, w, j with involution, second, hj
  have law := RingHom.map_mul at σ, R, R, v(j), w(j) with hom, a, b
  rw [e1, e2, law]

-- Matrix.conjTranspose_fromBlocks.
theorem conjTranspose.fromBlocks (m1 m2 n1 n2 A B C D : Set)
  requires a : A ∈ matrixSpace(R, m1, n1)
  requires b : B ∈ matrixSpace(R, m1, n2)
  requires c : C ∈ matrixSpace(R, m2, n1)
  requires d : D ∈ matrixSpace(R, m2, n2)
  shows conjTranspose(R, σ, m1 ⊎ m2, n1 ⊎ n2,
      fromBlocks(R, m1, m2, n1, n2, A, B, C, D)) =
    fromBlocks(R, n1, n2, m1, m2, conjTranspose(R, σ, m1, n1, A),
      conjTranspose(R, σ, m2, n1, C), conjTranspose(R, σ, m1, n2, B),
      conjTranspose(R, σ, m2, n2, D))
proof
  have comm := involution.left
  have v0 : ∀ i ∈ m1, ∀ j ∈ n1, A((i, j)) ∈ R.carrier
    intros i hi j hj
    exact matrixSpace.entry_mem with a, hi, hj
  have cA := conjTranspose.mem_of at R, σ, m1, n1, A with involution, a
  have w0 : ∀ i ∈ n1, ∀ j ∈ m1, conjTranspose(R, σ, m1, n1, A)((i, j)) ∈ R.carrier
    intros i hi j hj
    exact matrixSpace.entry_mem with cA, hi, hj
  have v1 : ∀ i ∈ m1, ∀ j ∈ n2, B((i, j)) ∈ R.carrier
    intros i hi j hj
    exact matrixSpace.entry_mem with b, hi, hj
  have cB := conjTranspose.mem_of at R, σ, m1, n2, B with involution, b
  have w1 : ∀ i ∈ n2, ∀ j ∈ m1, conjTranspose(R, σ, m1, n2, B)((i, j)) ∈ R.carrier
    intros i hi j hj
    exact matrixSpace.entry_mem with cB, hi, hj
  have v2 : ∀ i ∈ m2, ∀ j ∈ n1, C((i, j)) ∈ R.carrier
    intros i hi j hj
    exact matrixSpace.entry_mem with c, hi, hj
  have cC := conjTranspose.mem_of at R, σ, m2, n1, C with involution, c
  have w2 : ∀ i ∈ n1, ∀ j ∈ m2, conjTranspose(R, σ, m2, n1, C)((i, j)) ∈ R.carrier
    intros i hi j hj
    exact matrixSpace.entry_mem with cC, hi, hj
  have v3 : ∀ i ∈ m2, ∀ j ∈ n2, D((i, j)) ∈ R.carrier
    intros i hi j hj
    exact matrixSpace.entry_mem with d, hi, hj
  have cD := conjTranspose.mem_of at R, σ, m2, n2, D with involution, d
  have w3 : ∀ i ∈ n2, ∀ j ∈ m2, conjTranspose(R, σ, m2, n2, D)((i, j)) ∈ R.carrier
    intros i hi j hj
    exact matrixSpace.entry_mem with cD, hi, hj
  have whole := matrixSpace.of_function with (fromBlocks.graph_function at R, m1, m2, n1, n2, A, B, C, D with v0, v1, v2, v3)
  have left := conjTranspose.mem_of at R, σ, m1 ⊎ m2, n1 ⊎ n2, fromBlocks(R, m1, m2, n1, n2, A, B, C, D) with involution, whole
  have right := matrixSpace.of_function with (fromBlocks.graph_function at R, n1, n2, m1, m2, conjTranspose(R, σ, m1, n1, A), conjTranspose(R, σ, m2, n1, C), conjTranspose(R, σ, m1, n2, B), conjTranspose(R, σ, m2, n2, D) with w0, w2, w1, w3)
  apply (matrixSpace.ext at R, n1 ⊎ n2, m1 ⊎ m2, conjTranspose(R, σ, m1 ⊎ m2, n1 ⊎ n2, fromBlocks(R, m1, m2, n1, n2, A, B, C, D)), fromBlocks(R, n1, n2, m1, m2, conjTranspose(R, σ, m1, n1, A), conjTranspose(R, σ, m2, n1, C), conjTranspose(R, σ, m1, n2, B), conjTranspose(R, σ, m2, n2, D)) with comm, left, right).backward
  intros y hy x hx
  have sx := disjointSum.membership.forward with hx
  have sy := disjointSum.membership.forward with hy
  cases sx with lx | rx
  . obtain ⟨i, hi, xShape⟩ := lx
    cases sy with ly | ry
    . obtain ⟨j, hj, yShape⟩ := ly
      rw [xShape, yShape]
      have xIn := disjointSum.left at i, m1, m2 with hi
      have yIn := disjointSum.left at j, n1, n2 with hj
      have e1 := conjTranspose.at at R, σ, m1 ⊎ m2, n1 ⊎ n2, fromBlocks(R, m1, m2, n1, n2, A, B, C, D), inl(i), inl(j) with involution, whole, xIn, yIn
      have e2 := fromBlocks.graph_entry0 at R, m1, m2, n1, n2, A, B, C, D, i, j with v0, v1, v2, v3, hi, hj
      have e3 := fromBlocks.graph_entry0 at R, n1, n2, m1, m2, conjTranspose(R, σ, m1, n1, A), conjTranspose(R, σ, m2, n1, C), conjTranspose(R, σ, m1, n2, B), conjTranspose(R, σ, m2, n2, D), j, i with w0, w2, w1, w3, hj, hi
      have e4 := conjTranspose.at at R, σ, m1, n1, A, i, j with involution, a, hi, hj
      rw [e1, e2, e3, e4]
    . obtain ⟨j, hj, yShape⟩ := ry
      rw [xShape, yShape]
      have xIn := disjointSum.left at i, m1, m2 with hi
      have yIn := disjointSum.right at j, n1, n2 with hj
      have e1 := conjTranspose.at at R, σ, m1 ⊎ m2, n1 ⊎ n2, fromBlocks(R, m1, m2, n1, n2, A, B, C, D), inl(i), inr(j) with involution, whole, xIn, yIn
      have e2 := fromBlocks.graph_entry1 at R, m1, m2, n1, n2, A, B, C, D, i, j with v0, v1, v2, v3, hi, hj
      have e3 := fromBlocks.graph_entry2 at R, n1, n2, m1, m2, conjTranspose(R, σ, m1, n1, A), conjTranspose(R, σ, m2, n1, C), conjTranspose(R, σ, m1, n2, B), conjTranspose(R, σ, m2, n2, D), j, i with w0, w2, w1, w3, hj, hi
      have e4 := conjTranspose.at at R, σ, m1, n2, B, i, j with involution, b, hi, hj
      rw [e1, e2, e3, e4]
  . obtain ⟨i, hi, xShape⟩ := rx
    cases sy with ly | ry
    . obtain ⟨j, hj, yShape⟩ := ly
      rw [xShape, yShape]
      have xIn := disjointSum.right at i, m1, m2 with hi
      have yIn := disjointSum.left at j, n1, n2 with hj
      have e1 := conjTranspose.at at R, σ, m1 ⊎ m2, n1 ⊎ n2, fromBlocks(R, m1, m2, n1, n2, A, B, C, D), inr(i), inl(j) with involution, whole, xIn, yIn
      have e2 := fromBlocks.graph_entry2 at R, m1, m2, n1, n2, A, B, C, D, i, j with v0, v1, v2, v3, hi, hj
      have e3 := fromBlocks.graph_entry1 at R, n1, n2, m1, m2, conjTranspose(R, σ, m1, n1, A), conjTranspose(R, σ, m2, n1, C), conjTranspose(R, σ, m1, n2, B), conjTranspose(R, σ, m2, n2, D), j, i with w0, w2, w1, w3, hj, hi
      have e4 := conjTranspose.at at R, σ, m2, n1, C, i, j with involution, c, hi, hj
      rw [e1, e2, e3, e4]
    . obtain ⟨j, hj, yShape⟩ := ry
      rw [xShape, yShape]
      have xIn := disjointSum.right at i, m1, m2 with hi
      have yIn := disjointSum.right at j, n1, n2 with hj
      have e1 := conjTranspose.at at R, σ, m1 ⊎ m2, n1 ⊎ n2, fromBlocks(R, m1, m2, n1, n2, A, B, C, D), inr(i), inr(j) with involution, whole, xIn, yIn
      have e2 := fromBlocks.graph_entry3 at R, m1, m2, n1, n2, A, B, C, D, i, j with v0, v1, v2, v3, hi, hj
      have e3 := fromBlocks.graph_entry3 at R, n1, n2, m1, m2, conjTranspose(R, σ, m1, n1, A), conjTranspose(R, σ, m2, n1, C), conjTranspose(R, σ, m1, n2, B), conjTranspose(R, σ, m2, n2, D), j, i with w0, w2, w1, w3, hj, hi
      have e4 := conjTranspose.at at R, σ, m2, n2, D, i, j with involution, d, hi, hj
      rw [e1, e2, e3, e4]

-- conjTranspose_fromCols_eq_fromRows_conjTranspose.
theorem conjTranspose.fromCols (m n1 n2 A B : Set)
  requires a : A ∈ matrixSpace(R, m, n1)
  requires b : B ∈ matrixSpace(R, m, n2)
  shows conjTranspose(R, σ, m, n1 ⊎ n2, fromCols(R, m, n1, n2, A, B)) =
    fromRows(R, n1, n2, m, conjTranspose(R, σ, m, n1, A),
      conjTranspose(R, σ, m, n2, B))
proof
  have comm := involution.left
  have v0 : ∀ i ∈ m, ∀ j ∈ n1, A((i, j)) ∈ R.carrier
    intros i hi j hj
    exact matrixSpace.entry_mem with a, hi, hj
  have v1 : ∀ i ∈ m, ∀ j ∈ n2, B((i, j)) ∈ R.carrier
    intros i hi j hj
    exact matrixSpace.entry_mem with b, hi, hj
  have whole := matrixSpace.of_function with (fromCols.graph_function at R, m, n1, n2, A, B with v0, v1)
  have cA := conjTranspose.mem_of at R, σ, m, n1, A with involution, a
  have cB := conjTranspose.mem_of at R, σ, m, n2, B with involution, b
  have c0 : ∀ i ∈ n1, ∀ j ∈ m, conjTranspose(R, σ, m, n1, A)((i, j)) ∈ R.carrier
    intros i hi j hj
    exact matrixSpace.entry_mem with cA, hi, hj
  have c1 : ∀ i ∈ n2, ∀ j ∈ m, conjTranspose(R, σ, m, n2, B)((i, j)) ∈ R.carrier
    intros i hi j hj
    exact matrixSpace.entry_mem with cB, hi, hj
  have left := conjTranspose.mem_of at R, σ, m, n1 ⊎ n2, fromCols(R, m, n1, n2, A, B) with involution, whole
  have right := matrixSpace.of_function with (fromRows.graph_function at R, n1, n2, m, conjTranspose(R, σ, m, n1, A), conjTranspose(R, σ, m, n2, B) with c0, c1)
  apply (matrixSpace.ext at R, n1 ⊎ n2, m, conjTranspose(R, σ, m, n1 ⊎ n2, fromCols(R, m, n1, n2, A, B)), fromRows(R, n1, n2, m, conjTranspose(R, σ, m, n1, A), conjTranspose(R, σ, m, n2, B)) with comm, left, right).backward
  intros x hx i hi
  have sx := disjointSum.membership.forward with hx
  cases sx with lx | rx
  . obtain ⟨j, hj, xShape⟩ := lx
    rw xShape
    have xIn := disjointSum.left at j, n1, n2 with hj
    have e1 := conjTranspose.at at R, σ, m, n1 ⊎ n2, fromCols(R, m, n1, n2, A, B), i, inl(j) with involution, whole, hi, xIn
    have e2 := fromCols.graph_entry0 at R, m, n1, n2, A, B, i, j with v0, v1, hi, hj
    have e3 := fromRows.graph_entry0 at R, n1, n2, m, conjTranspose(R, σ, m, n1, A), conjTranspose(R, σ, m, n2, B), j, i with c0, c1, hj, hi
    have e4 := conjTranspose.at at R, σ, m, n1, A, i, j with involution, a, hi, hj
    rw [e1, e2, e3, e4]
  . obtain ⟨j, hj, xShape⟩ := rx
    rw xShape
    have xIn := disjointSum.right at j, n1, n2 with hj
    have e1 := conjTranspose.at at R, σ, m, n1 ⊎ n2, fromCols(R, m, n1, n2, A, B), i, inr(j) with involution, whole, hi, xIn
    have e2 := fromCols.graph_entry1 at R, m, n1, n2, A, B, i, j with v0, v1, hi, hj
    have e3 := fromRows.graph_entry1 at R, n1, n2, m, conjTranspose(R, σ, m, n1, A), conjTranspose(R, σ, m, n2, B), j, i with c0, c1, hj, hi
    have e4 := conjTranspose.at at R, σ, m, n2, B, i, j with involution, b, hi, hj
    rw [e1, e2, e3, e4]

-- With the trivial involution the conjugate transpose is the transpose.
theorem conjTranspose.identity (m n A : Set)
  requires ring : CommRing(R)
  requires matrix : A ∈ matrixSpace(R, m, n)
  shows conjTranspose(R, identity(R.carrier), m, n, A) = matTranspose(R, m, n, A)
proof
  have ringR := CommRing.to_ring with ring
  have fA := matrixSpace.function with matrix
  have idF := identity.function at R.carrier
  have values : ∀ x ∈ m, ∀ y ∈ n, identity(R.carrier)(A((x, y))) ∈ Ring.carrier(R)
    intros x hx y hy
    have entry := matrixSpace.entry_mem with matrix, hx, hy
    exact FunctionBetween.apply_closed with idF, entry
  have left := matrixSpace.of_function with (conjTranspose.graph_function at R, identity(R.carrier), m, n, A with values)
  have right : matTranspose(R, m, n, A) ∈ matrixSpace(R, n, m)
    unfold matTranspose
    exact matrixSpace.of_function with (transposedMatrix.function at m, n, R.carrier, A with fA)
  apply (matrixSpace.ext at R, n, m, conjTranspose(R, identity(R.carrier), m, n, A), matTranspose(R, m, n, A) with ring, left, right).backward
  intros j hj i hi
  have entry := matrixSpace.entry_mem with matrix, hi, hj
  have e1 := conjTranspose.entry_of at R, identity(R.carrier), m, n, A, i, j with values, hi, hj
  have e2 := identity.apply at A((i, j)), R.carrier with entry
  have e3 := matTranspose.entry at R, m, n, A, i, j with ring, matrix, hi, hj
  rw [e1, e2, e3]

-- A congruence of a hermitian matrix is hermitian: (Pᴴ J P)ᴴ = Pᴴ J P.
theorem IsHermitianMatrix.congr (m n J P : Set)
  requires finiteM : Finite(m)
  requires finiteN : Finite(n)
  requires form : J ∈ matrixSpace(R, m, m)
  requires hermitian : IsHermitianMatrix(R, σ, m, J)
  requires matrix : P ∈ matrixSpace(R, m, n)
  shows IsHermitianMatrix(R, σ, n, matMul(R, n, m, n,
    conjTranspose(R, σ, m, n, P), matMul(R, m, m, n, J, P)))
proof
  have comm := involution.left
  have cP := conjTranspose.mem_of at R, σ, m, n, P with involution, matrix
  have jp := matMul.mem_of at R, m, m, n, J, P with comm, finiteM, form, matrix
  have m1 := conjTranspose.mul at R, σ, n, m, n, conjTranspose(R, σ, m, n, P), matMul(R, m, m, n, J, P) with involution, finiteM, cP, jp
  have m2 := conjTranspose.mul at R, σ, m, m, n, J, P with involution, finiteM, form, matrix
  have back := conjTranspose.involution at R, σ, m, n, P with involution, matrix
  have herm : conjTranspose(R, σ, m, m, J) = J
    exact hermitian
  have assoc := matMul.assoc at R, n, m, m, n, conjTranspose(R, σ, m, n, P), J, P with comm, finiteM, finiteM, cP, form, matrix
  unfold IsHermitianMatrix
  rw [m1, m2, back, herm, assoc]

end Conjugate

-- The operations of Rⁿ are the vector operations.
theorem coordinateModule.carrier_of (R n : Set)
  shows Module.carrier(coordinateModule(R, n)) = functionSpace(n, Ring.carrier(R))
proof
  unfold coordinateModule
  rw [functionModule.carrier_eq, selfModule.carrier_eq]

theorem coordinateModule.add_of (R n u v : Set)
  requires ring : CommRing(R)
  requires first : u ∈ functionSpace(n, Ring.carrier(R))
  requires second : v ∈ functionSpace(n, Ring.carrier(R))
  shows call2(Module.add(coordinateModule(R, n)), u, v) = vecAdd(R, n, u, v)
proof
  have ringR := CommRing.to_ring with ring
  have self := Ring.to_module at R with ringR
  have carrier := selfModule.carrier_eq at R
  have uS : u ∈ functionSpace(n, Module.carrier(selfModule(R)))
    rw carrier
    exact first
  have vS : v ∈ functionSpace(n, Module.carrier(selfModule(R)))
    rw carrier
    exact second
  have e1 := functionModuleAdd.pair_value at R, n, selfModule(R), u, v with self, uS, vS
  have sumS := pointwiseSum.space at R, n, selfModule(R), u, v with self, uS, vS
  rw carrier at sumS
  have target := vecAdd.space at R, n, u, v with ring, first, second
  unfold coordinateModule
  rw [functionModule.add_eq, e1]
  apply functionSpace.ext_of with sumS, target
  intros j hj
  have p1 := pointwiseSum.at at R, n, selfModule(R), u, v, j with self, uS, vS, hj
  have p2 := vecAdd.at at R, n, u, v, j with ring, first, second, hj
  rw [p1, p2, selfModule.add_eq]

theorem coordinateModule.smul_of (R n a u : Set)
  requires ring : CommRing(R)
  requires scalar : a ∈ Ring.carrier(R)
  requires first : u ∈ functionSpace(n, Ring.carrier(R))
  shows call2(Module.smul(coordinateModule(R, n)), a, u) = vecSmul(R, n, a, u)
proof
  have ringR := CommRing.to_ring with ring
  have self := Ring.to_module at R with ringR
  have carrier := selfModule.carrier_eq at R
  have uS : u ∈ functionSpace(n, Module.carrier(selfModule(R)))
    rw carrier
    exact first
  have e1 := functionModuleSmul.pair_value at R, n, selfModule(R), a, u with self, scalar, uS
  have smulS := pointwiseSmul.space at R, n, selfModule(R), a, u with self, scalar, uS
  rw carrier at smulS
  have target := vecSmul.space at R, n, a, u with ring, scalar, first
  unfold coordinateModule
  rw [functionModule.smul_eq, e1]
  apply functionSpace.ext_of with smulS, target
  intros j hj
  have p1 := pointwiseSmul.at at R, n, selfModule(R), a, u, j with self, scalar, uS, hj
  have p2 := vecSmul.at at R, n, a, u, j with ring, scalar, first, hj
  rw [p1, p2, selfModule.smul_eq]

-- The matrix of a linear map f : Rⁿ → Rᵐ in the standard bases: the (i, j)
-- entry is f(eⱼ)(i).
def linearMapMatrix (R m n f : Set) : Set :=
  { q ∈ (m × n) × Ring.carrier(R) | ∃ i ∈ m, ∃ j ∈ n,
    q = ((i, j), f(unitVector(R, n, j))(i)) }

theorem linearMapMatrix.graph_relates (R m n f i j : Set)
  requires rowIn : i ∈ m
  requires colIn : j ∈ n
  requires valueIn : f(unitVector(R, n, j))(i) ∈ Ring.carrier(R)
  shows relates(linearMapMatrix(R, m, n, f), (i, j), f(unitVector(R, n, j))(i))
proof
  have pairIn := product.pair at i, j, m, n with rowIn, colIn
  have outer := product.pair at (i, j), f(unitVector(R, n, j))(i), m × n, Ring.carrier(R) with pairIn, valueIn
  unfold relates
  apply linearMapMatrix.membership.backward
  exact ⟨outer, i, rowIn, j, colIn, rfl⟩

theorem linearMapMatrix.graph_function (R m n f : Set)
  requires values : ∀ i ∈ m, ∀ j ∈ n, f(unitVector(R, n, j))(i) ∈ Ring.carrier(R)
  shows linearMapMatrix(R, m, n, f) : m × n → Ring.carrier(R)
proof
  constructor
    intros q0 member
    obtain ⟨bounded, witnesses⟩ := linearMapMatrix.membership.forward with member
    exact bounded
  . constructor
      intros z0 first xFirst second xSecond
      unfold relates at xFirst
      obtain ⟨_, a1, a1In, b1, b1In, firstShape⟩ := linearMapMatrix.membership.forward with xFirst
      unfold relates at xSecond
      obtain ⟨_, a2, a2In, b2, b2In, secondShape⟩ := linearMapMatrix.membership.forward with xSecond
      obtain ⟨xi, firstEqual⟩ := orderedPair.injective with firstShape
      obtain ⟨xj, secondEqual⟩ := orderedPair.injective with secondShape
      rw xi at xj
      obtain ⟨aa, bb⟩ := orderedPair.injective with xj
      rw [firstEqual, secondEqual]
      cc
    . intros q0 pIn
      obtain ⟨bound, i, rowIn, j, colIn, shape⟩ := product.membership.forward with pIn
      have valueIn := values with i, rowIn, j, colIn
      have mapped := linearMapMatrix.graph_relates at R, m, n, f, i, j with rowIn, colIn, valueIn
      rw shape
      exact ⟨f(unitVector(R, n, j))(i), valueIn, mapped⟩

theorem linearMapMatrix.graph_entry (R m n f i j : Set)
  requires values : ∀ i ∈ m, ∀ j ∈ n, f(unitVector(R, n, j))(i) ∈ Ring.carrier(R)
  requires rowIn : i ∈ m
  requires colIn : j ∈ n
  shows linearMapMatrix(R, m, n, f)((i, j)) = f(unitVector(R, n, j))(i)
proof
  have function := linearMapMatrix.graph_function at R, m, n, f with values
  have valueIn := values with i, rowIn, j, colIn
  have mapped := linearMapMatrix.graph_relates at R, m, n, f, i, j with rowIn, colIn, valueIn
  have pairIn := product.pair at i, j, m, n with rowIn, colIn
  exact FunctionBetween.apply_value with function, pairIn, mapped

-- Section: Square matrices, the matrix module, and linear maps
section Rings
variable (R : Set)
hypothesis ring : CommRing(R)

theorem squareMatrixRing.ring (n : Set)
  requires finite : Finite(n)
  shows Ring(squareMatrixRing(R, n))
proof
  have ringR := CommRing.to_ring with ring
  have zeroR := Ring.zero_mem at R with ringR
  have addValues : ∀ X ∈ matrixSpace(R, n, n), ∀ Y ∈ matrixSpace(R, n, n), matAdd(R, n, n, X, Y) ∈ matrixSpace(R, n, n)
    intros X hX Y hY
    exact matAdd.mem_of at R, n, n, X, Y with ring, hX, hY
  have mulValues : ∀ X ∈ matrixSpace(R, n, n), ∀ Y ∈ matrixSpace(R, n, n), matMul(R, n, n, n, X, Y) ∈ matrixSpace(R, n, n)
    intros X hX Y hY
    exact matMul.mem_of at R, n, n, n, X, Y with ring, finite, hX, hY
  have negValues : ∀ X ∈ matrixSpace(R, n, n), matNeg(R, n, n, X) ∈ matrixSpace(R, n, n)
    intros X hX
    have values : ∀ i ∈ n, ∀ j ∈ n, apply(R.neg, X((i, j))) ∈ R.carrier
      intros i hi j hj
      have x := matrixSpace.entry_mem with hX, hi, hj
      exact Ring.neg_mem at R, X((i, j)) with *
    exact matrixSpace.of_function with (matNeg.graph_function at R, n, n, X with values)
  have negAt : ∀ X ∈ matrixSpace(R, n, n), ∀ i ∈ n, ∀ j ∈ n, matNeg(R, n, n, X)((i, j)) = apply(R.neg, X((i, j)))
    intros X hX i hi j hj
    have values : ∀ x ∈ n, ∀ y ∈ n, apply(R.neg, X((x, y))) ∈ R.carrier
      intros x hx y hy
      have e := matrixSpace.entry_mem with hX, hx, hy
      exact Ring.neg_mem at R, X((x, y)) with *
    exact matNeg.graph_entry at R, n, n, X, i, j with values, hi, hj
  have addF := matAddition.graph_function at R, n with addValues
  have mulF := matMultiplication.graph_function at R, n with mulValues
  have negF := matNegation.graph_function at R, n with negValues
  have zeroIn : matZero(R, n, n) ∈ matrixSpace(R, n, n)
    unfold matZero
    rw matrixSpace.eq
    exact functionSpace.constant at n × n, R.carrier, R.zero with zeroR
  have zeroAt : ∀ i ∈ n, ∀ j ∈ n, matZero(R, n, n)((i, j)) = R.zero
    intros i hi j hj
    have pair := product.pair at i, j, n, n with hi, hj
    unfold matZero
    exact constantFunction.apply at n × n, R.carrier, (i, j), R.zero with pair, zeroR
  have oneIn := matOne.mem_of at R, n with ring
  have addV : ∀ X ∈ matrixSpace(R, n, n), ∀ Y ∈ matrixSpace(R, n, n), call2(matAddition(R, n), X, Y) = matAdd(R, n, n, X, Y)
    intros X hX Y hY
    unfold call2
    exact matAddition.graph_entry at R, n, X, Y with addValues, hX, hY
  have mulV : ∀ X ∈ matrixSpace(R, n, n), ∀ Y ∈ matrixSpace(R, n, n), call2(matMultiplication(R, n), X, Y) = matMul(R, n, n, n, X, Y)
    intros X hX Y hY
    unfold call2
    exact matMultiplication.graph_entry at R, n, X, Y with mulValues, hX, hY
  have negV : ∀ X ∈ matrixSpace(R, n, n), matNegation(R, n)(X) = matNeg(R, n, n, X)
    intros X hX
    exact matNegation.graph_apply at R, n, X with negValues, hX
  have additive : IsAbelianGroup(matrixSpace(R, n, n), matAddition(R, n), matZero(R, n, n), matNegation(R, n))
    apply IsAbelianGroup.of_laws with addF, zeroIn, negF
    . intros X hX Y hY Z hZ
      have xy := addValues with X, hX, Y, hY
      have yz := addValues with Y, hY, Z, hZ
      have l := addValues with matAdd(R, n, n, X, Y), xy, Z, hZ
      have r := addValues with X, hX, matAdd(R, n, n, Y, Z), yz
      have a1 := addV with X, hX, Y, hY
      have a2 := addV with matAdd(R, n, n, X, Y), xy, Z, hZ
      have a3 := addV with Y, hY, Z, hZ
      have a4 := addV with X, hX, matAdd(R, n, n, Y, Z), yz
      rw [a1, a2, a3, a4]
      apply (matrixSpace.ext at R, n, n, matAdd(R, n, n, matAdd(R, n, n, X, Y), Z), matAdd(R, n, n, X, matAdd(R, n, n, Y, Z)) with ring, l, r).backward
      intros i hi j hj
      have x := matrixSpace.entry_mem with hX, hi, hj
      have y := matrixSpace.entry_mem with hY, hi, hj
      have z := matrixSpace.entry_mem with hZ, hi, hj
      have e1 := matAdd.at at R, n, n, matAdd(R, n, n, X, Y), Z, i, j with ring, xy, hZ, hi, hj
      have e2 := matAdd.at at R, n, n, X, Y, i, j with ring, hX, hY, hi, hj
      have e3 := matAdd.at at R, n, n, X, matAdd(R, n, n, Y, Z), i, j with ring, hX, yz, hi, hj
      have e4 := matAdd.at at R, n, n, Y, Z, i, j with ring, hY, hZ, hi, hj
      rw [e1, e2, e3, e4]
      ring
    . intros X hX Y hY
      have xy := addValues with X, hX, Y, hY
      have yx := addValues with Y, hY, X, hX
      have a1 := addV with X, hX, Y, hY
      have a2 := addV with Y, hY, X, hX
      rw [a1, a2]
      apply (matrixSpace.ext at R, n, n, matAdd(R, n, n, X, Y), matAdd(R, n, n, Y, X) with ring, xy, yx).backward
      intros i hi j hj
      have x := matrixSpace.entry_mem with hX, hi, hj
      have y := matrixSpace.entry_mem with hY, hi, hj
      have e1 := matAdd.at at R, n, n, X, Y, i, j with ring, hX, hY, hi, hj
      have e2 := matAdd.at at R, n, n, Y, X, i, j with ring, hY, hX, hi, hj
      rw [e1, e2]
      ring
    . intros X hX
      have zx := addValues with matZero(R, n, n), zeroIn, X, hX
      have a1 := addV with matZero(R, n, n), zeroIn, X, hX
      rw a1
      apply (matrixSpace.ext at R, n, n, matAdd(R, n, n, matZero(R, n, n), X), X with ring, zx, hX).backward
      intros i hi j hj
      have x := matrixSpace.entry_mem with hX, hi, hj
      have e1 := matAdd.at at R, n, n, matZero(R, n, n), X, i, j with ring, zeroIn, hX, hi, hj
      have e2 := zeroAt with i, hi, j, hj
      rw [e1, e2]
      ring
    . intros X hX
      have nx := negValues with X, hX
      have a0 := negV with X, hX
      have nxx := addValues with matNeg(R, n, n, X), nx, X, hX
      have a1 := addV with matNeg(R, n, n, X), nx, X, hX
      rw [a0, a1]
      apply (matrixSpace.ext at R, n, n, matAdd(R, n, n, matNeg(R, n, n, X), X), matZero(R, n, n) with ring, nxx, zeroIn).backward
      intros i hi j hj
      have x := matrixSpace.entry_mem with hX, hi, hj
      have e1 := matAdd.at at R, n, n, matNeg(R, n, n, X), X, i, j with ring, nx, hX, hi, hj
      have e2 := negAt with X, hX, i, hi, j, hj
      have e3 := zeroAt with i, hi, j, hj
      rw [e1, e2, e3]
      ring
  have isRing : IsRing(matrixSpace(R, n, n), matAddition(R, n), matZero(R, n, n), matNegation(R, n), matMultiplication(R, n), matOne(R, n))
    unfold IsRing
    refine ⟨additive, ?_, ?_⟩
    . unfold IsMonoid
      refine ⟨?_, ?_⟩
      . unfold IsSemigroup
        refine ⟨mulF, ?_⟩
        intros X hX Y hY Z hZ
        have xy := mulValues with X, hX, Y, hY
        have yz := mulValues with Y, hY, Z, hZ
        have m1 := mulV with X, hX, Y, hY
        have m2 := mulV with matMul(R, n, n, n, X, Y), xy, Z, hZ
        have m3 := mulV with Y, hY, Z, hZ
        have m4 := mulV with X, hX, matMul(R, n, n, n, Y, Z), yz
        have law := matMul.assoc at R, n, n, n, n, X, Y, Z with ring, finite, finite, hX, hY, hZ
        rw [m1, m2, m3, m4, law]
      . unfold Identity
        refine ⟨oneIn, ?_⟩
        intros X hX
        have m1 := mulV with matOne(R, n), oneIn, X, hX
        have m2 := mulV with X, hX, matOne(R, n), oneIn
        have l := matMul.one_left at R, n, n, X with ring, finite, hX
        have r := matMul.one_right at R, n, n, X with ring, finite, hX
        rw [m1, m2, l, r]
        exact ⟨rfl, rfl⟩
    . intros X hX Y hY Z hZ
      have yz := addValues with Y, hY, Z, hZ
      have xy := addValues with X, hX, Y, hY
      have xyM := mulValues with X, hX, Y, hY
      have xzM := mulValues with X, hX, Z, hZ
      have yzM := mulValues with Y, hY, Z, hZ
      have a1 := addV with Y, hY, Z, hZ
      have a2 := addV with X, hX, Y, hY
      have m1 := mulV with X, hX, matAdd(R, n, n, Y, Z), yz
      have m2 := mulV with X, hX, Y, hY
      have m3 := mulV with X, hX, Z, hZ
      have m4 := mulV with matAdd(R, n, n, X, Y), xy, Z, hZ
      have m5 := mulV with Y, hY, Z, hZ
      have a3 := addV with matMul(R, n, n, n, X, Y), xyM, matMul(R, n, n, n, X, Z), xzM
      have a4 := addV with matMul(R, n, n, n, X, Z), xzM, matMul(R, n, n, n, Y, Z), yzM
      have d1 := matMul.add_right at R, n, n, n, X, Y, Z with ring, finite, hX, hY, hZ
      have d2 := matMul.add_left at R, n, n, n, X, Y, Z with ring, finite, hX, hY, hZ
      constructor
      . rw [a1, m1, m2, m3, a3, d1]
      . rw [a2, m4, m3, m5, a4, d2]
  unfold squareMatrixRing
  exact Ring.of_parts with isRing

theorem squareMatrixRing.mul_eq (n A B : Set)
  requires finite : Finite(n)
  requires first : A ∈ matrixSpace(R, n, n)
  requires second : B ∈ matrixSpace(R, n, n)
  shows call2(Ring.mul(squareMatrixRing(R, n)), A, B) = matMul(R, n, n, n, A, B)
proof
  have values : ∀ X ∈ matrixSpace(R, n, n), ∀ Y ∈ matrixSpace(R, n, n), matMul(R, n, n, n, X, Y) ∈ matrixSpace(R, n, n)
    intros X hX Y hY
    exact matMul.mem_of at R, n, n, n, X, Y with ring, finite, hX, hY
  have same : call2(Ring.mul(squareMatrixRing(R, n)), A, B) = matMultiplication(R, n)((A, B))
    unfold squareMatrixRing
    ring_projections
    unfold call2
    rfl
  rw same
  exact matMultiplication.graph_entry at R, n, A, B with values, first, second

-- On the index set n = {0, …, n − 1} the ring is Cumulus's matrixRing.
theorem squareMatrixRing.nat (n : Nat)
  shows squareMatrixRing(R, n) = matrixRing(R, n)
proof
  have ringR := CommRing.to_ring with ring
  have zeroR := Ring.zero_mem at R with ringR
  have oneR := Ring.one_mem at R with ringR
  have finite := Finite.natural at n
  have same : matrixSpace(R, n, n) = squareMatrices(R, n)
    rw matrixSpace.eq
    unfold squareMatrices
    rfl
  have toSq : ∀ X ∈ matrixSpace(R, n, n), X ∈ squareMatrices(R, n)
    intros X hX
    rw ← same
    exact hX
  have addValues : ∀ X ∈ matrixSpace(R, n, n), ∀ Y ∈ matrixSpace(R, n, n), matAdd(R, n, n, X, Y) ∈ matrixSpace(R, n, n)
    intros X hX Y hY
    exact matAdd.mem_of at R, n, n, X, Y with ring, hX, hY
  have mulValues : ∀ X ∈ matrixSpace(R, n, n), ∀ Y ∈ matrixSpace(R, n, n), matMul(R, n, n, n, X, Y) ∈ matrixSpace(R, n, n)
    intros X hX Y hY
    exact matMul.mem_of at R, n, n, n, X, Y with ring, finite, hX, hY
  have negValues : ∀ X ∈ matrixSpace(R, n, n), matNeg(R, n, n, X) ∈ matrixSpace(R, n, n)
    intros X hX
    have values : ∀ i ∈ n, ∀ j ∈ n, apply(R.neg, X((i, j))) ∈ R.carrier
      intros i hi j hj
      have x := matrixSpace.entry_mem with hX, hi, hj
      exact Ring.neg_mem at R, X((i, j)) with *
    exact matrixSpace.of_function with (matNeg.graph_function at R, n, n, X with values)
  have addF := matAddition.graph_function at R, n with addValues
  have mulF := matMultiplication.graph_function at R, n with mulValues
  have negF := matNegation.graph_function at R, n with negValues
  have addG := matrixAddition.function at R, n with ringR
  have mulG := matrixMultiplication.function at R, n with ring
  have negG := matrixNegation.function at R, n with ringR
  rw ← same at addG
  rw ← same at mulG
  rw ← same at negG
  have addEq : matAddition(R, n) = matrixAddition(R, n)
    apply FunctionBetween.ext with addF, addG
    intros q hq
    obtain ⟨bound, X, hX, Y, hY, shape⟩ := product.membership.forward with hq
    rw shape
    have a1 := matAddition.graph_entry at R, n, X, Y with addValues, hX, hY
    have a2 := matrixAddition.apply at R, n, X, Y with ringR, (toSq with X, hX), (toSq with Y, hY)
    unfold call2 at a2
    rw [a1, a2]
    have sumM := addValues with X, hX, Y, hY
    have sumS := matrixSum.matrix at R, n, X, Y with ringR, (toSq with X, hX), (toSq with Y, hY)
    rw ← same at sumS
    apply (matrixSpace.ext at R, n, n, matAdd(R, n, n, X, Y), matrixSum(R, n, X, Y) with ring, sumM, sumS).backward
    intros i hi j hj
    have e1 := matAdd.at at R, n, n, X, Y, i, j with ring, hX, hY, hi, hj
    have e2 := matrixSum.entry at R, n, X, Y, i, j with ringR, (toSq with X, hX), (toSq with Y, hY), hi, hj
    rw [e1, e2]
  have negEq : matNegation(R, n) = matrixNegation(R, n)
    apply FunctionBetween.ext with negF, negG
    intros X hX
    have a1 := matNegation.graph_apply at R, n, X with negValues, hX
    have a2 := matrixNegation.value at R, n, X with ringR, (toSq with X, hX)
    rw [a1, a2]
    have negM := negValues with X, hX
    have negS := matrixNegative.matrix at R, n, X with ringR, (toSq with X, hX)
    rw ← same at negS
    apply (matrixSpace.ext at R, n, n, matNeg(R, n, n, X), matrixNegative(R, n, X) with ring, negM, negS).backward
    intros i hi j hj
    have values : ∀ x ∈ n, ∀ y ∈ n, apply(R.neg, X((x, y))) ∈ R.carrier
      intros x hx y hy
      have e := matrixSpace.entry_mem with hX, hx, hy
      exact Ring.neg_mem at R, X((x, y)) with *
    have e1 := matNeg.graph_entry at R, n, n, X, i, j with values, hi, hj
    have e2 := matrixNegative.entry at R, n, X, i, j with ringR, (toSq with X, hX), hi, hj
    rw [e1, e2]
  have mulEq : matMultiplication(R, n) = matrixMultiplication(R, n)
    apply FunctionBetween.ext with mulF, mulG
    intros q hq
    obtain ⟨bound, X, hX, Y, hY, shape⟩ := product.membership.forward with hq
    rw shape
    have a1 := matMultiplication.graph_entry at R, n, X, Y with mulValues, hX, hY
    have a2 := matrixMultiplication.apply at R, n, X, Y with ring, (toSq with X, hX), (toSq with Y, hY)
    unfold call2 at a2
    rw [a1, a2]
    have prodM := mulValues with X, hX, Y, hY
    have prodS := matrixProduct.matrix at R, n, X, Y with ring, (toSq with X, hX), (toSq with Y, hY)
    rw ← same at prodS
    apply (matrixSpace.ext at R, n, n, matMul(R, n, n, n, X, Y), matrixProduct(R, n, X, Y) with ring, prodM, prodS).backward
    intros i hi k hk
    have e1 := matMul.at at R, n, n, n, X, Y, i, k with ring, finite, hX, hY, hi, hk
    have e2 := matrixProduct.entry_sum at R, n, X, Y, i, k with ring, (toSq with X, hX), (toSq with Y, hY), hi, hk
    rw [e1, e2]
    have parts := CommRing.parts with ring
    have rowX := matRow.space at R, n, n, X, i with ring, hX, hi
    have colY := matCol.space at R, n, n, Y, k with ring, hY, hk
    have mX := squareMatrices.membership.forward with (toSq with X, hX)
    have mY := squareMatrices.membership.forward with (toSq with Y, hY)
    have t1 := vecDotTerms.function_of at R, n, matRow(R, n, X, i), matCol(R, n, Y, k) with ring, rowX, colY
    have t2 := matrixProductWeights.function at n, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, X, Y, i, k with parts, mX, mY, hi, hk
    have agree : ∀ j ∈ n, vecDotTerms(R, n, matRow(R, n, X, i), matCol(R, n, Y, k))(j) = matrixProductWeights(n, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, X, Y, i, k)(j)
      intros j hj
      have w1 := vecDotTerms.at at R, n, matRow(R, n, X, i), matCol(R, n, Y, k), j with ring, rowX, colY, hj
      have w2 := matrixProductWeights.value at n, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, X, Y, i, k, j with parts, mX, mY, hi, hk, hj
      have r1 := matRow.at at R, n, n, X, i, j with ring, hX, hi, hj
      have r2 := matCol.at at R, n, n, Y, j, k with ring, hY, hj, hk
      rw [w1, w2, r1, r2]
    unfold vecDot
    exact finiteRingSum.congr at n, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, vecDotTerms(R, n, matRow(R, n, X, i), matCol(R, n, Y, k)), matrixProductWeights(n, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, X, Y, i, k) with parts, finite, t1, t2, agree
  have zeroEq : matZero(R, n, n) = zeroMatrix(R, n)
    unfold matZero
    unfold zeroMatrix
    rfl
  have oneEq : matOne(R, n) = oneMatrix(R, n)
    have oneM := matOne.mem_of at R, n with ring
    have oneS := oneMatrix.matrix at R, n with ring
    rw ← same at oneS
    apply (matrixSpace.ext at R, n, n, matOne(R, n), oneMatrix(R, n) with ring, oneM, oneS).backward
    intros i hi j hj
    have e2 := oneMatrix.entry at R, n, i, j with ring, hi, hj
    rw e2
    by_cases eq : i = j
    . have s1 := singleValue.same at R.carrier, R.zero, R.one, j, i with zeroR, oneR, eq
      rw [s1, eq]
      exact matOne.same at R, n, j with ring, hj
    . have s1 := singleValue.other at R.carrier, R.zero, R.one, j, i with zeroR, oneR, eq
      rw s1
      exact matOne.other at R, n, i, j with ring, hi, hj, eq
  unfold squareMatrixRing
  unfold matrixRing
  rw [same, addEq, zeroEq, negEq, mulEq, oneEq]

theorem matrixModule.module (m n : Set)
  shows Module(matrixModule(R, m, n), R)
proof
  have ringR := CommRing.to_ring with ring
  unfold matrixModule
  exact coordinateModule.module at R, m × n with ringR

theorem matrixModule.operations (m n A B a : Set)
  requires first : A ∈ matrixSpace(R, m, n)
  requires second : B ∈ matrixSpace(R, m, n)
  requires scalar : a ∈ R.carrier
  shows call2(Module.add(matrixModule(R, m, n)), A, B) = matAdd(R, m, n, A, B) ∧
    call2(Module.smul(matrixModule(R, m, n)), a, A) = matSmul(R, m, n, a, A)
proof
  have ringR := CommRing.to_ring with ring
  have self := Ring.to_module at R with ringR
  have carrier := selfModule.carrier_eq at R
  have aS : A ∈ functionSpace(m × n, Module.carrier(selfModule(R)))
    rw [carrier, ← matrixSpace.eq]
    exact first
  have bS : B ∈ functionSpace(m × n, Module.carrier(selfModule(R)))
    rw [carrier, ← matrixSpace.eq]
    exact second
  have addEq := functionModule.add_eq at R, m × n, selfModule(R)
  have smulEq := functionModule.smul_eq at R, m × n, selfModule(R)
  have e1 := functionModuleAdd.pair_value at R, m × n, selfModule(R), A, B with self, aS, bS
  have e2 := functionModuleSmul.pair_value at R, m × n, selfModule(R), a, A with self, scalar, aS
  have sumS := pointwiseSum.space at R, m × n, selfModule(R), A, B with self, aS, bS
  have smulS := pointwiseSmul.space at R, m × n, selfModule(R), a, A with self, scalar, aS
  rw [carrier] at sumS
  rw [carrier] at smulS
  have addM := matAdd.mem_of at R, m, n, A, B with ring, first, second
  have smulM := matSmul.mem_of at R, m, n, a, A with ring, scalar, first
  rw matrixSpace.eq at addM
  rw matrixSpace.eq at smulM
  unfold matrixModule
  unfold coordinateModule
  rw [addEq, smulEq, e1, e2]
  constructor
  . apply functionSpace.ext_of with sumS, addM
    intros x hx
    obtain ⟨bound, i, hi, j, hj, shape⟩ := product.membership.forward with hx
    rw shape
    have xIn := product.pair at i, j, m, n with hi, hj
    have p1 := pointwiseSum.at at R, m × n, selfModule(R), A, B, (i, j) with self, aS, bS, xIn
    have p2 := matAdd.at at R, m, n, A, B, i, j with ring, first, second, hi, hj
    rw [p1, p2, selfModule.add_eq]
  . apply functionSpace.ext_of with smulS, smulM
    intros x hx
    obtain ⟨bound, i, hi, j, hj, shape⟩ := product.membership.forward with hx
    rw shape
    have xIn := product.pair at i, j, m, n with hi, hj
    have p1 := pointwiseSmul.at at R, m × n, selfModule(R), a, A, (i, j) with self, scalar, aS, xIn
    have p2 := matSmul.at at R, m, n, a, A, i, j with ring, scalar, first, hi, hj
    rw [p1, p2, selfModule.smul_eq]

-- Module.finrank_matrix: Rᵐˣⁿ is free of rank |m| |n|, with the
-- single-entry matrices as basis.
theorem matrixModule.finrank (m n : Set)
  requires nontrivial : R.zero ≠ R.one
  requires finiteM : Finite(m)
  requires finiteN : Finite(n)
  shows FiniteFreeModule(matrixModule(R, m, n), R) ∧
    finrank(matrixModule(R, m, n), R) = cardinality(m) * cardinality(n)
proof
  have ringR := CommRing.to_ring with ring
  have finite := Finite.product at m, n with finiteM, finiteN
  have coord := coordinateModule.module at R, m × n with ringR
  have basis := standardBasis.basis at R, m × n with ring, finite
  have free : FiniteFreeModule(coordinateModule(R, m × n), R)
    unfold FiniteFreeModule
    exact ⟨m × n, standardBasis(R, m × n), finite, basis⟩
  have rank := finrank.coordinate at R, coordinateModule(R, m × n), m × n with ring, nontrivial, coord, finite
  have count := cardinality.product_count at m, n with finiteM, finiteN
  unfold matrixModule
  rw [rank, count]
  exact ⟨free, rfl⟩

-- Matrix.toLin': A as a linear map Rⁿ → Rᵐ; every linear map Rⁿ → Rᵐ is
-- one, for a unique A (Matrix.toLin' is an equivalence).
theorem mulVecMap.linear (m n A : Set)
  requires finite : Finite(n)
  requires matrix : A ∈ matrixSpace(R, m, n)
  shows LinearMap(mulVecMap(R, m, n, A), coordinateModule(R, n), R,
    coordinateModule(R, m))
proof
  have ringR := CommRing.to_ring with ring
  have cn := coordinateModule.module at R, n with ringR
  have cm := coordinateModule.module at R, m with ringR
  have values : ∀ v ∈ functionSpace(n, R.carrier), mulVec(R, m, n, A, v) ∈ functionSpace(m, R.carrier)
    intros v hv
    exact mulVec.mem at R, m, n, A, v with ring, finite, matrix, hv
  have function := mulVecMap.graph_function at R, m, n, A with values
  have carrierN := coordinateModule.carrier_of at R, n
  have carrierM := coordinateModule.carrier_of at R, m
  apply LinearMap.of_laws with cn, cm
  . rw [carrierN, carrierM]
    exact function
  . rw carrierN
    intros u hu v hv
    have uv := vecAdd.space at R, n, u, v with ring, hu, hv
    have au := values with u, hu
    have av := values with v, hv
    have e1 := coordinateModule.add_of at R, n, u, v with ring, hu, hv
    have e2 := coordinateModule.add_of at R, m, mulVecMap(R, m, n, A)(u), mulVecMap(R, m, n, A)(v) with ring, (FunctionBetween.apply_closed with function, hu), (FunctionBetween.apply_closed with function, hv)
    have g1 := mulVecMap.graph_apply at R, m, n, A, vecAdd(R, n, u, v) with values, uv
    have g2 := mulVecMap.graph_apply at R, m, n, A, u with values, hu
    have g3 := mulVecMap.graph_apply at R, m, n, A, v with values, hv
    have law := mulVec.add at R, m, n, A, u, v with ring, finite, matrix, hu, hv
    rw [e1, e2, g1, g2, g3, law]
  . rw carrierN
    intros r hr v hv
    have rv := vecSmul.space at R, n, r, v with ring, hr, hv
    have e1 := coordinateModule.smul_of at R, n, r, v with ring, hr, hv
    have e2 := coordinateModule.smul_of at R, m, r, mulVecMap(R, m, n, A)(v) with ring, hr, (FunctionBetween.apply_closed with function, hv)
    have g1 := mulVecMap.graph_apply at R, m, n, A, vecSmul(R, n, r, v) with values, rv
    have g2 := mulVecMap.graph_apply at R, m, n, A, v with values, hv
    have law := mulVec.smul at R, m, n, A, r, v with ring, finite, matrix, hr, hv
    rw [e1, e2, g1, g2, law]

theorem mulVecMap.surjective (m n f : Set)
  requires finite : Finite(n)
  requires linear : LinearMap(f, coordinateModule(R, n), R, coordinateModule(R, m))
  shows ∃ A ∈ matrixSpace(R, m, n), f = mulVecMap(R, m, n, A)
proof
  have ringR := CommRing.to_ring with ring
  have cn := coordinateModule.module at R, n with ringR
  have carrierN := coordinateModule.carrier_of at R, n
  have carrierM := coordinateModule.carrier_of at R, m
  have fF0 := LinearMap.function_of with linear
  have fF : f : functionSpace(n, R.carrier) → functionSpace(m, R.carrier)
    rw [← carrierN, ← carrierM]
    exact fF0
  have values : ∀ i ∈ m, ∀ j ∈ n, f(unitVector(R, n, j))(i) ∈ R.carrier
    intros i hi j hj
    have uS := unitVector.mem at R, n, j with ring
    have fu := FunctionBetween.apply_closed with fF, uS
    exact functionSpace.apply_mem with fu, hi
  have aF := linearMapMatrix.graph_function at R, m, n, f with values
  have aS : linearMapMatrix(R, m, n, f) ∈ matrixSpace(R, m, n)
    rw matrixSpace.eq
    exact functionSpace.mem_iff.backward with aF
  refine ⟨linearMapMatrix(R, m, n, f), aS, ?_⟩
  have linA := mulVecMap.linear at R, m, n, linearMapMatrix(R, m, n, f) with ring, finite, aS
  have basis := standardBasis.basis at R, n with ring, finite
  apply ModuleBasis.ext at R, coordinateModule(R, n), coordinateModule(R, m), f, mulVecMap(R, m, n, linearMapMatrix(R, m, n, f)), n, standardBasis(R, n) with ring, cn, basis, linear, linA
  intros j hj
  have s1 := standardBasis.apply at R, n, j with ring, hj
  have uS := unitVector.mem at R, n, j with ring
  have mValues : ∀ v ∈ functionSpace(n, R.carrier), mulVec(R, m, n, linearMapMatrix(R, m, n, f), v) ∈ functionSpace(m, R.carrier)
    intros v hv
    exact mulVec.mem at R, m, n, linearMapMatrix(R, m, n, f), v with ring, finite, aS, hv
  have g1 := mulVecMap.graph_apply at R, m, n, linearMapMatrix(R, m, n, f), unitVector(R, n, j) with mValues, uS
  have u1 := mulVec.unit_vector at R, m, n, linearMapMatrix(R, m, n, f), j with ring, finite, aS, hj
  rw [s1, g1, u1]
  have fu := FunctionBetween.apply_closed with fF, uS
  have col := matCol.space at R, m, n, linearMapMatrix(R, m, n, f), j with ring, aS, hj
  apply functionSpace.ext_of with fu, col
  intros i hi
  have c1 := matCol.at at R, m, n, linearMapMatrix(R, m, n, f), i, j with ring, aS, hi, hj
  have e1 := linearMapMatrix.graph_entry at R, m, n, f, i, j with values, hi, hj
  rw [c1, e1]

theorem mulVecMap.compose (m n p A B : Set)
  requires finiteN : Finite(n)
  requires finiteP : Finite(p)
  requires first : A ∈ matrixSpace(R, m, n)
  requires second : B ∈ matrixSpace(R, n, p)
  shows compose(mulVecMap(R, m, n, A), mulVecMap(R, n, p, B),
      functionSpace(p, R.carrier), functionSpace(n, R.carrier),
      functionSpace(m, R.carrier)) =
    mulVecMap(R, m, p, matMul(R, m, n, p, A, B))
proof
  have ab := matMul.mem_of at R, m, n, p, A, B with ring, finiteN, first, second
  have valuesA : ∀ v ∈ functionSpace(n, R.carrier), mulVec(R, m, n, A, v) ∈ functionSpace(m, R.carrier)
    intros v hv
    exact mulVec.mem at R, m, n, A, v with ring, finiteN, first, hv
  have valuesB : ∀ v ∈ functionSpace(p, R.carrier), mulVec(R, n, p, B, v) ∈ functionSpace(n, R.carrier)
    intros v hv
    exact mulVec.mem at R, n, p, B, v with ring, finiteP, second, hv
  have valuesAB : ∀ v ∈ functionSpace(p, R.carrier), mulVec(R, m, p, matMul(R, m, n, p, A, B), v) ∈ functionSpace(m, R.carrier)
    intros v hv
    exact mulVec.mem at R, m, p, matMul(R, m, n, p, A, B), v with ring, finiteP, ab, hv
  have fA := mulVecMap.graph_function at R, m, n, A with valuesA
  have fB := mulVecMap.graph_function at R, n, p, B with valuesB
  have fAB := mulVecMap.graph_function at R, m, p, matMul(R, m, n, p, A, B) with valuesAB
  have both := compose.function at mulVecMap(R, m, n, A), mulVecMap(R, n, p, B), functionSpace(p, R.carrier), functionSpace(n, R.carrier), functionSpace(m, R.carrier) with fB, fA
  apply FunctionBetween.ext with both, fAB
  intros v hv
  have bv := valuesB with v, hv
  have c1 := compose.apply at mulVecMap(R, m, n, A), mulVecMap(R, n, p, B), functionSpace(p, R.carrier), functionSpace(n, R.carrier), functionSpace(m, R.carrier), v with fB, fA, hv
  have g1 := mulVecMap.graph_apply at R, n, p, B, v with valuesB, hv
  have g2 := mulVecMap.graph_apply at R, m, n, A, mulVec(R, n, p, B, v) with valuesA, bv
  have g3 := mulVecMap.graph_apply at R, m, p, matMul(R, m, n, p, A, B), v with valuesAB, hv
  have law := mulVec.mulVec at R, m, n, p, A, B, v with ring, finiteN, finiteP, first, second, hv
  rw [c1, g1, g2, g3, law]

-- Helpers for the matrix of a linear map: its entries lie in R, and its
-- columns are the coordinates of the images of the basis vectors.
theorem linearToMatrix.values_of (M N I b J c f : Set)
  requires finiteJ : Finite(J)
  requires basisM : ModuleBasis(M, R, I, b)
  requires basisN : ModuleBasis(N, R, J, c)
  requires linear : LinearMap(f, M, R, N)
  shows ∀ j ∈ J, ∀ i ∈ I, basisCoordinates(N, R, J, c, f(b(i)))(j) ∈ R.carrier
proof
  obtain ⟨_, spans⟩ := basisM
  obtain ⟨_, bF, _⟩ := spans
  have fF := LinearMap.function_of with linear
  intros j hj i hi
  have bi := FunctionBetween.apply_closed with bF, hi
  have fbi := FunctionBetween.apply_closed with fF, bi
  have selected := basisCoordinates.selected at N, R, J, c, f(b(i)) with basisN, finiteJ, fbi
  have cF := functionSpace.mem_iff.forward with selected.left
  exact FunctionBetween.apply_closed with cF, hj

theorem linearToMatrix.column (M N I b J c f i : Set)
  requires finiteJ : Finite(J)
  requires basisM : ModuleBasis(M, R, I, b)
  requires basisN : ModuleBasis(N, R, J, c)
  requires linear : LinearMap(f, M, R, N)
  requires column : i ∈ I
  shows matCol(R, J, linearToMatrix(M, R, N, I, b, J, c, f), i) =
    basisCoordinates(N, R, J, c, f(b(i)))
proof
  have values := linearToMatrix.values_of at R, M, N, I, b, J, c, f with ring, finiteJ, basisM, basisN, linear
  have lF := linearToMatrix.graph_function at M, R, N, I, b, J, c, f with values
  have lS := matrixSpace.of_function at R, J, I, linearToMatrix(M, R, N, I, b, J, c, f) with lF
  have col := matCol.space at R, J, I, linearToMatrix(M, R, N, I, b, J, c, f), i with ring, lS, column
  have basisM0 := basisM
  obtain ⟨_, spans⟩ := basisM0
  obtain ⟨_, bF, _⟩ := spans
  have fF := LinearMap.function_of with linear
  have bi := FunctionBetween.apply_closed with bF, column
  have fbi := FunctionBetween.apply_closed with fF, bi
  have selected := basisCoordinates.selected at N, R, J, c, f(b(i)) with basisN, finiteJ, fbi
  apply functionSpace.ext_of with col, selected.left
  intros j hj
  have c1 := matCol.at at R, J, I, linearToMatrix(M, R, N, I, b, J, c, f), j, i with ring, lS, hj, column
  have e1 := linearToMatrix.graph_entry at M, R, N, I, b, J, c, f, j, i with values, hj, column
  rw [c1, e1]

-- LinearMap.toMatrix_apply and its characterization: the coordinates of
-- f(x) are the matrix times the coordinates of x.
theorem linearToMatrix.mem (M N I b J c f : Set)
  requires finiteI : Finite(I)
  requires finiteJ : Finite(J)
  requires basisM : ModuleBasis(M, R, I, b)
  requires basisN : ModuleBasis(N, R, J, c)
  requires linear : LinearMap(f, M, R, N)
  shows linearToMatrix(M, R, N, I, b, J, c, f) ∈ matrixSpace(R, J, I)
proof
  have values := linearToMatrix.values_of at R, M, N, I, b, J, c, f with ring, finiteJ, basisM, basisN, linear
  have lF := linearToMatrix.graph_function at M, R, N, I, b, J, c, f with values
  exact matrixSpace.of_function at R, J, I, linearToMatrix(M, R, N, I, b, J, c, f) with lF

theorem linearToMatrix.coordinates (M N I b J c f x : Set)
  requires finiteI : Finite(I)
  requires finiteJ : Finite(J)
  requires basisM : ModuleBasis(M, R, I, b)
  requires basisN : ModuleBasis(N, R, J, c)
  requires linear : LinearMap(f, M, R, N)
  requires vector : x ∈ Module.carrier(M)
  shows basisCoordinates(N, R, J, c, f(x)) = mulVec(R, J, I,
    linearToMatrix(M, R, N, I, b, J, c, f), basisCoordinates(M, R, I, b, x))
proof
  have ringR := CommRing.to_ring with ring
  have moduleM := LinearMap.source_module_of with linear
  have moduleN := LinearMap.target_module_of with linear
  have cI := coordinateModule.module at R, I with ringR
  have cJ := coordinateModule.module at R, J with ringR
  have carrierI := coordinateModule.carrier_of at R, I
  have carrierJ := coordinateModule.carrier_of at R, J
  have fF := LinearMap.function_of with linear
  have lS := linearToMatrix.mem at R, M, N, I, b, J, c, f with ring, finiteI, finiteJ, basisM, basisN, linear
  have linL := mulVecMap.linear at R, J, I, linearToMatrix(M, R, N, I, b, J, c, f) with ring, finiteI, lS
  have eM := ModuleBasis.combination_map_equiv at R, M, I, b with ring, moduleM, finiteI, basisM
  have eN := ModuleBasis.combination_map_equiv at R, N, J, c with ring, moduleN, finiteJ, basisN
  have invM := LinearEquiv.inverse with eM
  have invN := LinearEquiv.inverse with eN
  obtain ⟨invMLin, _⟩ := invM
  obtain ⟨invNLin, _⟩ := invN
  have convMF := LinearMap.function_of with invMLin
  have convNF := LinearMap.function_of with invNLin
  have mulF := LinearMap.function_of with linL
  have linF := LinearMap.compose at f, converse(combinationMap(N, R, J, c), Module.carrier(coordinateModule(R, J)), N.carrier), M, R, N, coordinateModule(R, J) with linear, invNLin
  have linG := LinearMap.compose at converse(combinationMap(M, R, I, b), Module.carrier(coordinateModule(R, I)), M.carrier), mulVecMap(R, J, I, linearToMatrix(M, R, N, I, b, J, c, f)), M, R, coordinateModule(R, I), coordinateModule(R, J) with invMLin, linL
  have mValues : ∀ v ∈ functionSpace(I, R.carrier), mulVec(R, J, I, linearToMatrix(M, R, N, I, b, J, c, f), v) ∈ functionSpace(J, R.carrier)
    intros v hv
    exact mulVec.mem at R, J, I, linearToMatrix(M, R, N, I, b, J, c, f), v with ring, finiteI, lS, hv
  have agree : ∀ i ∈ I, compose(converse(combinationMap(N, R, J, c), Module.carrier(coordinateModule(R, J)), N.carrier), f, M.carrier, N.carrier, Module.carrier(coordinateModule(R, J)))(b(i)) = compose(mulVecMap(R, J, I, linearToMatrix(M, R, N, I, b, J, c, f)), converse(combinationMap(M, R, I, b), Module.carrier(coordinateModule(R, I)), M.carrier), M.carrier, Module.carrier(coordinateModule(R, I)), Module.carrier(coordinateModule(R, J)))(b(i))
    intros i hi
    have basisM0 := basisM
    obtain ⟨_, spans⟩ := basisM0
    obtain ⟨_, bF, _⟩ := spans
    have bi := FunctionBetween.apply_closed with bF, hi
    have fbi := FunctionBetween.apply_closed with fF, bi
    have c1 := compose.apply at converse(combinationMap(N, R, J, c), Module.carrier(coordinateModule(R, J)), N.carrier), f, M.carrier, N.carrier, Module.carrier(coordinateModule(R, J)), b(i) with fF, convNF, bi
    have c2 := ModuleBasis.coordinates_inverse at R, N, J, c, f(b(i)) with ring, moduleN, finiteJ, basisN, fbi
    have c3 := compose.apply at mulVecMap(R, J, I, linearToMatrix(M, R, N, I, b, J, c, f)), converse(combinationMap(M, R, I, b), Module.carrier(coordinateModule(R, I)), M.carrier), M.carrier, Module.carrier(coordinateModule(R, I)), Module.carrier(coordinateModule(R, J)), b(i) with convMF, mulF, bi
    have c4 := ModuleBasis.coordinates_inverse at R, M, I, b, b(i) with ring, moduleM, finiteI, basisM, bi
    have c5 := basisCoordinates.basis_vector at R, M, I, b, i with ring, moduleM, basisM, finiteI, hi
    have uS := unitVector.mem at R, I, i with ring
    have c6 := mulVecMap.graph_apply at R, J, I, linearToMatrix(M, R, N, I, b, J, c, f), unitVector(R, I, i) with mValues, uS
    have c7 := mulVec.unit_vector at R, J, I, linearToMatrix(M, R, N, I, b, J, c, f), i with ring, finiteI, lS, hi
    have c8 := linearToMatrix.column at R, M, N, I, b, J, c, f, i with ring, finiteJ, basisM, basisN, linear, hi
    rw [c1, c2, c3, c4, c5, c6, c7, c8]
  have same := ModuleBasis.ext at R, M, coordinateModule(R, J), compose(converse(combinationMap(N, R, J, c), Module.carrier(coordinateModule(R, J)), N.carrier), f, M.carrier, N.carrier, Module.carrier(coordinateModule(R, J))), compose(mulVecMap(R, J, I, linearToMatrix(M, R, N, I, b, J, c, f)), converse(combinationMap(M, R, I, b), Module.carrier(coordinateModule(R, I)), M.carrier), M.carrier, Module.carrier(coordinateModule(R, I)), Module.carrier(coordinateModule(R, J))), I, b with ring, moduleM, basisM, linF, linG, agree
  have atX : compose(converse(combinationMap(N, R, J, c), Module.carrier(coordinateModule(R, J)), N.carrier), f, M.carrier, N.carrier, Module.carrier(coordinateModule(R, J)))(x) = compose(mulVecMap(R, J, I, linearToMatrix(M, R, N, I, b, J, c, f)), converse(combinationMap(M, R, I, b), Module.carrier(coordinateModule(R, I)), M.carrier), M.carrier, Module.carrier(coordinateModule(R, I)), Module.carrier(coordinateModule(R, J)))(x)
    rw same
  have fx := FunctionBetween.apply_closed with fF, vector
  have d1 := compose.apply at converse(combinationMap(N, R, J, c), Module.carrier(coordinateModule(R, J)), N.carrier), f, M.carrier, N.carrier, Module.carrier(coordinateModule(R, J)), x with fF, convNF, vector
  have d2 := ModuleBasis.coordinates_inverse at R, N, J, c, f(x) with ring, moduleN, finiteJ, basisN, fx
  have d3 := compose.apply at mulVecMap(R, J, I, linearToMatrix(M, R, N, I, b, J, c, f)), converse(combinationMap(M, R, I, b), Module.carrier(coordinateModule(R, I)), M.carrier), M.carrier, Module.carrier(coordinateModule(R, I)), Module.carrier(coordinateModule(R, J)), x with convMF, mulF, vector
  have d4 := ModuleBasis.coordinates_inverse at R, M, I, b, x with ring, moduleM, finiteI, basisM, vector
  have selected := basisCoordinates.selected at M, R, I, b, x with basisM, finiteI, vector
  have d5 := mulVecMap.graph_apply at R, J, I, linearToMatrix(M, R, N, I, b, J, c, f), basisCoordinates(M, R, I, b, x) with mValues, selected.left
  rw [d1, d2, d3, d4, d5] at atX
  exact atX

-- LinearMap.toMatrix_comp: the matrix of a composite is the product.
theorem linearToMatrix.compose (M N P I b J c K d f g : Set)
  requires finiteI : Finite(I)
  requires finiteJ : Finite(J)
  requires finiteK : Finite(K)
  requires basisM : ModuleBasis(M, R, I, b)
  requires basisN : ModuleBasis(N, R, J, c)
  requires basisP : ModuleBasis(P, R, K, d)
  requires first : LinearMap(f, M, R, N)
  requires second : LinearMap(g, N, R, P)
  shows linearToMatrix(M, R, P, I, b, K, d, compose(g, f, Module.carrier(M),
      Module.carrier(N), Module.carrier(P))) =
    matMul(R, K, J, I, linearToMatrix(N, R, P, J, c, K, d, g),
      linearToMatrix(M, R, N, I, b, J, c, f))
proof
  have fF := LinearMap.function_of with first
  have gF := LinearMap.function_of with second
  have moduleM := LinearMap.source_module_of with first
  have linGF := LinearMap.compose at f, g, M, R, N, P with first, second
  have lS := linearToMatrix.mem at R, M, P, I, b, K, d, compose(g, f, Module.carrier(M), Module.carrier(N), Module.carrier(P)) with ring, finiteI, finiteK, basisM, basisP, linGF
  have gS := linearToMatrix.mem at R, N, P, J, c, K, d, g with ring, finiteJ, finiteK, basisN, basisP, second
  have fS := linearToMatrix.mem at R, M, N, I, b, J, c, f with ring, finiteI, finiteJ, basisM, basisN, first
  have pS := matMul.mem at R, K, J, I, linearToMatrix(N, R, P, J, c, K, d, g), linearToMatrix(M, R, N, I, b, J, c, f) with ring, finiteJ, gS, fS
  apply (matrixSpace.ext at R, K, I, linearToMatrix(M, R, P, I, b, K, d, compose(g, f, Module.carrier(M), Module.carrier(N), Module.carrier(P))), matMul(R, K, J, I, linearToMatrix(N, R, P, J, c, K, d, g), linearToMatrix(M, R, N, I, b, J, c, f)) with ring, lS, pS).backward
  intros k hk i hi
  have basisM0 := basisM
  obtain ⟨_, spans⟩ := basisM0
  obtain ⟨_, bF, _⟩ := spans
  have bi := FunctionBetween.apply_closed with bF, hi
  have fbi := FunctionBetween.apply_closed with fF, bi
  have values := linearToMatrix.values_of at R, M, P, I, b, K, d, compose(g, f, Module.carrier(M), Module.carrier(N), Module.carrier(P)) with ring, finiteK, basisM, basisP, linGF
  have e1 := linearToMatrix.graph_entry at M, R, P, I, b, K, d, compose(g, f, Module.carrier(M), Module.carrier(N), Module.carrier(P)), k, i with values, hk, hi
  have e2 := compose.apply at g, f, Module.carrier(M), Module.carrier(N), Module.carrier(P), b(i) with fF, gF, bi
  have e3 := linearToMatrix.coordinates at R, N, P, J, c, K, d, g, f(b(i)) with ring, finiteJ, finiteK, basisN, basisP, second, fbi
  have selected := basisCoordinates.selected at N, R, J, c, f(b(i)) with basisN, finiteJ, fbi
  have e4 := mulVec.apply at R, K, J, linearToMatrix(N, R, P, J, c, K, d, g), basisCoordinates(N, R, J, c, f(b(i))), k with ring, finiteJ, gS, selected.left, hk
  have e5 := matMul.entry at R, K, J, I, linearToMatrix(N, R, P, J, c, K, d, g), linearToMatrix(M, R, N, I, b, J, c, f), k, i with ring, finiteJ, gS, fS, hk, hi
  have e6 := linearToMatrix.column at R, M, N, I, b, J, c, f, i with ring, finiteJ, basisM, basisN, first, hi
  rw [e1, e2, e3, e4, e5, e6]

theorem linearToMatrix.identity (M I b : Set)
  requires finite : Finite(I)
  requires basis : ModuleBasis(M, R, I, b)
  shows linearToMatrix(M, R, M, I, b, I, b, identity(Module.carrier(M))) =
    matOne(R, I)
proof
  have ringR := CommRing.to_ring with ring
  have basis0 := basis
  obtain ⟨_, spans⟩ := basis0
  obtain ⟨module, bF, _⟩ := spans
  have idLin := LinearMap.identity at M, R with module
  have lS := linearToMatrix.mem at R, M, M, I, b, I, b, identity(Module.carrier(M)) with ring, finite, finite, basis, basis, idLin
  have oneS := matOne.mem_of at R, I with ring
  apply (matrixSpace.ext at R, I, I, linearToMatrix(M, R, M, I, b, I, b, identity(Module.carrier(M))), matOne(R, I) with ring, lS, oneS).backward
  intros j hj i hi
  have values := linearToMatrix.values_of at R, M, M, I, b, I, b, identity(Module.carrier(M)) with ring, finite, basis, basis, idLin
  have e1 := linearToMatrix.graph_entry at M, R, M, I, b, I, b, identity(Module.carrier(M)), j, i with values, hj, hi
  have bi := FunctionBetween.apply_closed with bF, hi
  have e2 := identity.apply at b(i), Module.carrier(M) with bi
  have e3 := basisCoordinates.basis_vector at R, M, I, b, i with ring, module, basis, finite, hi
  have entry := matOne.entry at R, I, j, i with ring, hj, hi
  obtain ⟨diag, off⟩ := entry
  rw [e1, e2, e3]
  by_cases same : j = i
  . have o1 := diag with same
    rw [o1, same]
    exact unitVector.apply_same at R, I, i with ring, hi
  . have o1 := off with same
    rw o1
    exact unitVector.apply_other at R, I, i, j with ring, hj, same

-- In the standard bases the matrix of v ↦ A v is A.
theorem linearToMatrix.standard (m n A : Set)
  requires finiteM : Finite(m)
  requires finiteN : Finite(n)
  requires matrix : A ∈ matrixSpace(R, m, n)
  shows linearToMatrix(coordinateModule(R, n), R, coordinateModule(R, m), n,
    standardBasis(R, n), m, standardBasis(R, m), mulVecMap(R, m, n, A)) = A
proof
  have ringR := CommRing.to_ring with ring
  have cn := coordinateModule.module at R, n with ringR
  have basisN := standardBasis.basis at R, n with ring, finiteN
  have basisM := standardBasis.basis at R, m with ring, finiteM
  have linA := mulVecMap.linear at R, m, n, A with ring, finiteN, matrix
  have lS := linearToMatrix.mem at R, coordinateModule(R, n), coordinateModule(R, m), n, standardBasis(R, n), m, standardBasis(R, m), mulVecMap(R, m, n, A) with ring, finiteN, finiteM, basisN, basisM, linA
  apply (matrixSpace.ext at R, m, n, linearToMatrix(coordinateModule(R, n), R, coordinateModule(R, m), n, standardBasis(R, n), m, standardBasis(R, m), mulVecMap(R, m, n, A)), A with ring, lS, matrix).backward
  intros j hj i hi
  have values := linearToMatrix.values_of at R, coordinateModule(R, n), coordinateModule(R, m), n, standardBasis(R, n), m, standardBasis(R, m), mulVecMap(R, m, n, A) with ring, finiteM, basisN, basisM, linA
  have e1 := linearToMatrix.graph_entry at coordinateModule(R, n), R, coordinateModule(R, m), n, standardBasis(R, n), m, standardBasis(R, m), mulVecMap(R, m, n, A), j, i with values, hj, hi
  have s1 := standardBasis.apply at R, n, i with ring, hi
  have uS := unitVector.mem at R, n, i with ring
  have mValues : ∀ v ∈ functionSpace(n, R.carrier), mulVec(R, m, n, A, v) ∈ functionSpace(m, R.carrier)
    intros v hv
    exact mulVec.mem at R, m, n, A, v with ring, finiteN, matrix, hv
  have g1 := mulVecMap.graph_apply at R, m, n, A, unitVector(R, n, i) with mValues, uS
  have u1 := mulVec.unit_vector at R, m, n, A, i with ring, finiteN, matrix, hi
  have col := matCol.space at R, m, n, A, i with ring, matrix, hi
  have s2 := standardBasis.coordinates at R, m, matCol(R, m, A, i) with ring, finiteM, col
  have c1 := matCol.at at R, m, n, A, j, i with ring, matrix, hj, hi
  rw [e1, s1, g1, u1, s2, c1]

-- Change of basis: matrices of one endomorphism in two bases are
-- conjugate by the change-of-basis matrix.
theorem linearToMatrix.change_of_basis (M I b J c f : Set)
  requires finiteI : Finite(I)
  requires finiteJ : Finite(J)
  requires basisB : ModuleBasis(M, R, I, b)
  requires basisC : ModuleBasis(M, R, J, c)
  requires linear : LinearMap(f, M, R, M)
  shows matMul(R, J, I, J, linearToMatrix(M, R, M, I, b, J, c,
      identity(Module.carrier(M))),
      matMul(R, I, I, J, linearToMatrix(M, R, M, I, b, I, b, f),
        linearToMatrix(M, R, M, J, c, I, b, identity(Module.carrier(M))))) =
    linearToMatrix(M, R, M, J, c, J, c, f)
proof
  have basisB0 := basisB
  obtain ⟨_, spansB⟩ := basisB0
  obtain ⟨module, _, _⟩ := spansB
  have fF := LinearMap.function_of with linear
  have idLin := LinearMap.identity at M, R with module
  have fid := LinearMap.compose at identity(Module.carrier(M)), f, M, R, M, M with idLin, linear
  have right := compose.identity_right at f, Module.carrier(M), Module.carrier(M) with fF
  rw right at fid
  have inner := linearToMatrix.compose at R, M, M, M, J, c, I, b, I, b, identity(Module.carrier(M)), f with ring, finiteJ, finiteI, finiteI, basisC, basisB, basisB, idLin, linear
  rw right at inner
  have outer := linearToMatrix.compose at R, M, M, M, J, c, I, b, J, c, f, identity(Module.carrier(M)) with ring, finiteJ, finiteI, finiteJ, basisC, basisB, basisC, linear, idLin
  have left := compose.identity_left at f, Module.carrier(M), Module.carrier(M) with fF
  rw left at outer
  rw [outer, inner]

end Rings
