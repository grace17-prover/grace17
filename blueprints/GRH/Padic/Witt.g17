-- Witt vectors: the ghost components wₙ(x) = Σ_{i ≤ n} pⁱ xᵢ^(p^(n−i)),
-- the Witt structure polynomials for addition, multiplication and
-- negation over ℤ, characterised by their ghost components
-- (wittAdd, wittMul, wittNeg, wittStructureInt), the ring W(R) of
-- sequences ℕ → R with the operations they define (WittVector p R), the
-- Teichmüller representative [r] = (r, 0, 0, …) (WittVector.teichmuller),
-- the coefficient, map, Verschiebung, Frobenius and truncation maps, the
-- p-th roots of a perfect ring, the expansion x = Σ pⁱ [xᵢ^(p^(−i))],
-- W(k) as a complete discrete valuation ring for a perfect field k, and
-- W(𝔽_p) ≅ ℤ_p (WittVector.equiv).
-- Part of the GRH blueprint.
-- Planned home: RingTheory/WittVector.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Padic.Witt
import GRH.Padic.Valuation

-- Section: Ghost components
-- The terms pⁱ xᵢ^(p^(n−i)), i ≤ n, and the n-th ghost component
-- wₙ(x) = Σ_{i ≤ n} pⁱ xᵢ^(p^(n−i)) of a sequence x : ℕ → R
-- (WittVector.ghostComponent, wittPolynomial p ℤ n evaluated at x).
def ghostTerms (R : Set, p n : Nat, x : Set) : Set :=
  { (i, call2(Ring.mul(R), natCast(R, pow(p, i)), Ring.pow(R, x(i), pow(p, sub(n, i))))) |
    i ∈ ℕ }

def ghostComponent (R : Set, p n : Nat, x : Set) : Set :=
  indexedRingSum(ghostTerms(R, p, n, x), identity(ℕ), Ring.add(R), Ring.zero(R), succ(n))

-- The ghost map x ↦ (wₙ(x))ₙ (WittVector.ghostMap).
def ghostSequence (R : Set, p : Nat, x : Set) : Set :=
  { (n, ghostComponent(R, p, n, x)) | n ∈ ℕ }

-- Section: Witt structure polynomials
-- Polynomials over ℤ in the variables X_{0,i}, X_{1,i} (i ∈ ℕ), indexed by
-- 2 × ℕ, and the sequences of variables X_{j,·}.
def wittPolyRing : Set := polynomialRing(integerRing, 2 × ℕ)

def wittVarSeq (j : Set) : Set := { (i, X(integerRing, 2 × ℕ, (j, i))) | i ∈ ℕ }

-- The structure polynomials of addition, multiplication and negation:
-- the unique sequences Φ of integer polynomials with wₙ(Φ) = wₙ(X₀) +
-- wₙ(X₁), wₙ(X₀) wₙ(X₁), −wₙ(X₀) for all n (wittAdd, wittMul, wittNeg,
-- wittStructureInt; that the coefficients are integers is the
-- existence half, Mathlib's wittStructureInt_prop).
defunique wittAddPoly (p : Nat) (Φ ∈ functionSpace(ℕ, Ring.carrier(wittPolyRing))) :=
  ∀ n ∈ ℕ, ghostComponent(wittPolyRing, p, n, Φ) =
    call2(Ring.add(wittPolyRing), ghostComponent(wittPolyRing, p, n, wittVarSeq(0)),
      ghostComponent(wittPolyRing, p, n, wittVarSeq(1)))
requires prime : Prime(p)
proof
  sorry
uniqueness
  sorry

defunique wittMulPoly (p : Nat) (Φ ∈ functionSpace(ℕ, Ring.carrier(wittPolyRing))) :=
  ∀ n ∈ ℕ, ghostComponent(wittPolyRing, p, n, Φ) =
    call2(Ring.mul(wittPolyRing), ghostComponent(wittPolyRing, p, n, wittVarSeq(0)),
      ghostComponent(wittPolyRing, p, n, wittVarSeq(1)))
requires prime : Prime(p)
proof
  sorry
uniqueness
  sorry

defunique wittNegPoly (p : Nat) (Φ ∈ functionSpace(ℕ, Ring.carrier(wittPolyRing))) :=
  ∀ n ∈ ℕ, ghostComponent(wittPolyRing, p, n, Φ) =
    apply(Ring.neg(wittPolyRing), ghostComponent(wittPolyRing, p, n, wittVarSeq(0)))
requires prime : Prime(p)
proof
  sorry
uniqueness
  sorry

-- Section: The ring of Witt vectors
-- Evaluation of a structure polynomial at (x, y): X_{0,i} ↦ xᵢ,
-- X_{1,i} ↦ yᵢ, along ℤ → R (MvPolynomial.eval₂ (Int.castRingHom R)).
def wittAssign (R x y : Set) : Set :=
  { u ∈ (2 × ℕ) × Ring.carrier(R) | ∃ i ∈ ℕ, u = ((0, i), x(i)) ∨ u = ((1, i), y(i)) }

def wittEval (R x y Φ : Set) : Set :=
  evaluationHom(integerRing, R, 2 × ℕ, intCastHom(R), wittAssign(R, x, y))(Φ)

def wittAddSeq (R : Set, p : Nat, x y : Set) : Set :=
  { (n, wittEval(R, x, y, wittAddPoly(p)(n))) | n ∈ ℕ }

def wittMulSeq (R : Set, p : Nat, x y : Set) : Set :=
  { (n, wittEval(R, x, y, wittMulPoly(p)(n))) | n ∈ ℕ }

def wittNegSeq (R : Set, p : Nat, x : Set) : Set :=
  { (n, wittEval(R, x, x, wittNegPoly(p)(n))) | n ∈ ℕ }

-- W(R): the sequences ℕ → R (WittVector p R, with WittVector.coeff x n =
-- x(n)), with zero (0, 0, …) and one (1, 0, 0, …).
def wittCarrier (R : Set) : Set := functionSpace(ℕ, Ring.carrier(R))

def wittAdd (R : Set, p : Nat) : Set :=
  { q ∈ (wittCarrier(R) × wittCarrier(R)) × wittCarrier(R) |
    ∃ x ∈ wittCarrier(R), ∃ y ∈ wittCarrier(R), q = ((x, y), wittAddSeq(R, p, x, y)) }

def wittMul (R : Set, p : Nat) : Set :=
  { q ∈ (wittCarrier(R) × wittCarrier(R)) × wittCarrier(R) |
    ∃ x ∈ wittCarrier(R), ∃ y ∈ wittCarrier(R), q = ((x, y), wittMulSeq(R, p, x, y)) }

def wittNeg (R : Set, p : Nat) : Set :=
  { q ∈ wittCarrier(R) × wittCarrier(R) | ∃ x ∈ wittCarrier(R), q = (x, wittNegSeq(R, p, x)) }

def wittZero (R : Set) : Set := { (n, Ring.zero(R)) | n ∈ ℕ }

-- The Teichmüller representative [r] = (r, 0, 0, …) (WittVector.teichmuller),
-- and the map r ↦ [r].
def teichmuller (R r : Set) : Set :=
  { u ∈ ℕ × Ring.carrier(R) | u = (0, r) ∨ (∃ n ∈ ℕ, n ≠ 0 ∧ u = (n, Ring.zero(R))) }

def teichmullerMap (R : Set) : Set := { (r, teichmuller(R, r)) | r ∈ Ring.carrier(R) }

def wittVectors (p : Nat, R : Set) : Set :=
  Ring.mk(wittCarrier(R), wittAdd(R, p), wittZero(R), wittNeg(R, p), wittMul(R, p),
    teichmuller(R, Ring.one(R)))

-- Section: Maps of Witt vectors
-- The ghost map W(R) → ℕ → R (WittVector.ghostMap) and the n-th ghost
-- component as a map (WittVector.ghostComponent).
def ghostMap (R : Set, p : Nat) : Set := { (x, ghostSequence(R, p, x)) | x ∈ wittCarrier(R) }

def ghostComponentMap (R : Set, p n : Nat) : Set :=
  { (x, ghostComponent(R, p, n, x)) | x ∈ wittCarrier(R) }

-- x ↦ x₀ (WittVector.constantCoeff).
def wittConstantCoeff (R : Set) : Set := { (x, x(0)) | x ∈ wittCarrier(R) }

-- W(f) : x ↦ (f(xₙ))ₙ for f : R → S (WittVector.map).
def wittMapSeq (f x : Set) : Set := { (n, f(x(n))) | n ∈ ℕ }

def wittMap (R f : Set) : Set := { (x, wittMapSeq(f, x)) | x ∈ wittCarrier(R) }

-- The n-fold Verschiebung Vⁿ x = (0, …, 0, x₀, x₁, …) (n zeros;
-- WittVector.verschiebung iterated) and V = V¹.
def wittShift (R : Set, n : Nat, x : Set) : Set :=
  { u ∈ ℕ × Ring.carrier(R) | (∃ k ∈ n, u = (k, Ring.zero(R))) ∨
    (∃ k ∈ ℕ, u = (add(n, k), x(k))) }

def verschiebung (R x : Set) : Set := wittShift(R, 1, x)

-- For R of characteristic p, the Frobenius of W(R) is W(Frob) : x ↦
-- (xₙ^p)ₙ (WittVector.frobenius_eq_map_frobenius; Mathlib's frobenius for
-- rings of other characteristic is not stated here).
def wittFrobenius (R : Set, p : Nat) : Set := wittMap(R, frobenius(R, p))

-- The truncation W(R) → Wₙ(R), with Wₙ(R) = W(R) modulo the ideal of
-- vectors whose first n coefficients vanish (WittVector.truncate,
-- TruncatedWittVector p n R; Mathlib's carrier is Fin n → R, isomorphic
-- through the coefficients).
def wittTruncKernel (R : Set, n : Nat) : Set :=
  { x ∈ wittCarrier(R) | ∀ i ∈ n, x(i) = Ring.zero(R) }

def truncatedWitt (p n : Nat, R : Set) : Set :=
  quotientRing(wittVectors(p, R), wittTruncKernel(R, n))

def wittTruncate (p n : Nat, R : Set) : Set :=
  quotientMk(wittVectors(p, R), wittTruncKernel(R, n))

-- Section: p-th roots in perfect rings
-- In a perfect ring of characteristic p, the unique y with y^(pⁱ) = a
-- (((frobeniusEquiv R p).symm)^[i] a).
defunique perfectRoot (R : Set, p i : Nat, a : Set) (y ∈ Ring.carrier(R)) :=
  Ring.pow(R, y, pow(p, i)) = a
requires perfect : PerfectRing(R, p)
requires comm : CommRing(R)
requires member : a ∈ Ring.carrier(R)
proof
  sorry
uniqueness
  sorry

-- The partial sums Σ_{i ≤ n} pⁱ [xᵢ^(p^(−i))] of the Teichmüller expansion.
def teichmullerTerms (R : Set, p : Nat, x : Set) : Set :=
  { (i, call2(Ring.mul(wittVectors(p, R)), natCast(wittVectors(p, R), pow(p, i)),
      teichmuller(R, perfectRoot(R, p, i, x(i))))) | i ∈ ℕ }

def teichmullerPartialSum (R : Set, p n : Nat, x : Set) : Set :=
  indexedRingSum(teichmullerTerms(R, p, x), identity(ℕ), Ring.add(wittVectors(p, R)),
    Ring.zero(wittVectors(p, R)), succ(n))

-- Section: The ring structure
section WittRings
variable (p : Nat, R : Set)
hypothesis prime : Prime(p)
hypothesis comm : CommRing(R)

-- W(R) is a commutative ring (WittVector's CommRing instance).
theorem wittVectors.comm_ring
  shows CommRing(wittVectors(p, R))
proof
  sorry

-- The ghost components are ring homomorphisms (WittVector.ghostComponent,
-- ghostMap as a ring hom into the product ring).
theorem ghostComponentMap.ring_hom (n : Nat)
  shows (ghostComponentMap(R, p, n) : wittVectors(p, R) →+* R)
proof
  sorry

-- WittVector.ghostMap is bijective when p is invertible in R
-- (ghostEquiv): x ↦ (wₙ(x))ₙ identifies W(R) with ℕ → R.
theorem ghostMap.bijective
  requires invertible : RingUnit(R, natCast(R, p))
  shows BijectiveBetween(ghostMap(R, p), wittCarrier(R), wittCarrier(R))
proof
  sorry

-- The zeroth coefficients add and multiply (WittVector.add_coeff_zero,
-- mul_coeff_zero): constantCoeff is a ring homomorphism, onto
-- (WittVector.constantCoeff_surjective).
theorem wittConstantCoeff.ring_hom
  shows (wittConstantCoeff(R) : wittVectors(p, R) →+* R) ∧
    SurjectiveBetween(wittConstantCoeff(R), wittCarrier(R), Ring.carrier(R))
proof
  sorry

-- The Teichmüller map is multiplicative with [0] = 0, [1] = 1
-- (WittVector.teichmuller as a monoid hom).
theorem teichmuller.mul (r s : Set)
  requires first : r ∈ Ring.carrier(R)
  requires second : s ∈ Ring.carrier(R)
  shows teichmuller(R, call2(Ring.mul(R), r, s)) =
    call2(Ring.mul(wittVectors(p, R)), teichmuller(R, r), teichmuller(R, s))
proof
  sorry

theorem teichmuller.zero
  shows teichmuller(R, Ring.zero(R)) = Ring.zero(wittVectors(p, R))
proof
  sorry

-- The ghost components of [r] are r^(pⁿ) (WittVector.ghostComponent_teichmuller).
theorem teichmuller.ghost (r : Set, n : Nat)
  requires member : r ∈ Ring.carrier(R)
  shows ghostComponent(R, p, n, teichmuller(R, r)) = Ring.pow(R, r, pow(p, n))
proof
  sorry

-- WittVector.map is a ring homomorphism, injective for injective f
-- (WittVector.map_injective), with coefficients f(xₙ) (map_coeff) and
-- W(f)[r] = [f(r)] (WittVector.map_teichmuller).
theorem wittMap.ring_hom (S f : Set)
  requires target : CommRing(S)
  requires hom : (f : R →+* S)
  shows (wittMap(R, f) : wittVectors(p, R) →+* wittVectors(p, S))
proof
  sorry

theorem wittMap.injective (S f : Set)
  requires target : CommRing(S)
  requires hom : (f : R →+* S)
  requires injective : InjectiveBetween(f, Ring.carrier(R), Ring.carrier(S))
  shows InjectiveBetween(wittMap(R, f), wittCarrier(R), wittCarrier(S))
proof
  sorry

theorem wittMap.teichmuller (S f r : Set)
  requires target : CommRing(S)
  requires hom : (f : R →+* S)
  requires member : r ∈ Ring.carrier(R)
  shows wittMap(R, f)(teichmuller(R, r)) = teichmuller(S, f(r))
proof
  sorry

-- Verschiebung is additive with nonzero values on nonzero vectors
-- (WittVector.verschiebung as an additive hom, verschiebung_nonzero).
theorem verschiebung.add (x y : Set)
  requires first : x ∈ wittCarrier(R)
  requires second : y ∈ wittCarrier(R)
  shows verschiebung(R, call2(Ring.add(wittVectors(p, R)), x, y)) =
    call2(Ring.add(wittVectors(p, R)), verschiebung(R, x), verschiebung(R, y))
proof
  sorry

theorem verschiebung.nonzero (x : Set)
  requires member : x ∈ wittCarrier(R)
  requires nonzero : x ≠ Ring.zero(wittVectors(p, R))
  shows verschiebung(R, x) ≠ Ring.zero(wittVectors(p, R))
proof
  sorry

-- WittVector.le_coeff_eq_iff_le_sub_coeff_eq_zero.
theorem wittVectors.coeff_eq_iff_sub (x y : Set, n : Nat)
  requires first : x ∈ wittCarrier(R)
  requires second : y ∈ wittCarrier(R)
  shows (∀ i ∈ n, x(i) = y(i)) ↔
    (∀ i ∈ n, Ring.sub(wittVectors(p, R), x, y)(i) = Ring.zero(R))
proof
  sorry

-- Truncation is a surjective ring homomorphism whose kernel is the
-- vectors with xᵢ = 0 for i < n (WittVector.truncate_surjective,
-- WittVector.mem_ker_truncate).
theorem wittTruncKernel.ideal (n : Nat)
  shows Ideal(wittVectors(p, R), wittTruncKernel(R, n))
proof
  sorry

theorem wittTruncate.ker (x : Set, n : Nat)
  requires member : x ∈ wittCarrier(R)
  shows wittTruncate(p, n, R)(x) = Ring.zero(truncatedWitt(p, n, R)) ↔
    (∀ i ∈ n, x(i) = Ring.zero(R))
proof
  sorry

-- WittVector.p_nonzero: p ≠ 0 in W(R) for R nontrivial.
theorem wittVectors.p_nonzero
  requires nontrivial : Ring.one(R) ≠ Ring.zero(R)
  shows natCast(wittVectors(p, R), p) ≠ Ring.zero(wittVectors(p, R))
proof
  sorry

end WittRings

-- Section: Characteristic p
section WittCharP
variable (p : Nat, R : Set)
hypothesis prime : Prime(p)
hypothesis comm : CommRing(R)
hypothesis charP : CharP(R, p)

-- WittVector.frobenius on a ring of characteristic p is W(Frob), a ring
-- endomorphism, and p x = V(F x) (WittVector.verschiebung_frobenius,
-- WittVector.mul_p): (p x)₀ = 0, (p x)ₙ₊₁ = xₙ^p.
theorem wittFrobenius.ring_hom
  shows (wittFrobenius(R, p) : wittVectors(p, R) →+* wittVectors(p, R))
proof
  sorry

theorem wittVectors.mul_p (x : Set)
  requires member : x ∈ wittCarrier(R)
  shows call2(Ring.mul(wittVectors(p, R)), natCast(wittVectors(p, R), p), x) =
    verschiebung(R, wittFrobenius(R, p)(x))
proof
  sorry

-- WittVector.iterate_verschiebung_mul_coeff:
-- (Vⁱ x · Vʲ y)_{i+j} = x₀^(pʲ) y₀^(pⁱ).
theorem wittShift.mul_coeff (x y : Set, i j : Nat)
  requires first : x ∈ wittCarrier(R)
  requires second : y ∈ wittCarrier(R)
  shows call2(Ring.mul(wittVectors(p, R)), wittShift(R, i, x), wittShift(R, j, y))(add(i, j)) =
    call2(Ring.mul(R), Ring.pow(R, x(0), pow(p, j)), Ring.pow(R, y(0), pow(p, i)))
proof
  sorry

-- WittVector.eq_zero_of_p_mul_eq_zero: for R reduced, p x = 0 forces x = 0.
theorem wittVectors.eq_zero_of_p_mul (x : Set)
  requires reduced : ∀ a ∈ Ring.carrier(R), ∀ n ∈ ℕ, Ring.pow(R, a, n) = Ring.zero(R) →
    a = Ring.zero(R)
  requires member : x ∈ wittCarrier(R)
  requires zero : call2(Ring.mul(wittVectors(p, R)), natCast(wittVectors(p, R), p), x) =
    Ring.zero(wittVectors(p, R))
  shows x = Ring.zero(wittVectors(p, R))
proof
  sorry

end WittCharP

-- Section: Perfect rings
section WittPerfect
variable (p : Nat, R : Set)
hypothesis prime : Prime(p)
hypothesis comm : CommRing(R)
hypothesis perfect : PerfectRing(R, p)

-- WittVector.frobenius_bijective.
theorem wittFrobenius.bijective
  shows BijectiveBetween(wittFrobenius(R, p), wittCarrier(R), wittCarrier(R))
proof
  sorry

-- WittVector.mem_span_p_pow_iff_le_coeff_eq_zero: x ∈ (pⁿ) exactly when
-- xᵢ = 0 for i < n; WittVector.ker_constantCoeff: the kernel of x ↦ x₀ is
-- (p).
theorem wittVectors.mem_p_pow_iff (x : Set, n : Nat)
  requires member : x ∈ wittCarrier(R)
  shows x ∈ ringMultiples(wittVectors(p, R), natCast(wittVectors(p, R), pow(p, n))) ↔
    (∀ i ∈ n, x(i) = Ring.zero(R))
proof
  sorry

theorem wittConstantCoeff.ker (x : Set)
  requires member : x ∈ wittCarrier(R)
  shows x(0) = Ring.zero(R) ↔
    x ∈ ringMultiples(wittVectors(p, R), natCast(wittVectors(p, R), p))
proof
  sorry

-- WittVector.dvd_sub_sum_teichmuller_iterateFrobeniusEquiv_coeff:
-- p^(n+1) divides x − Σ_{i ≤ n} pⁱ [xᵢ^(p^(−i))].
theorem wittVectors.teichmuller_expansion (x : Set, n : Nat)
  requires member : x ∈ wittCarrier(R)
  shows RingDvd(wittVectors(p, R), natCast(wittVectors(p, R), pow(p, succ(n))),
    Ring.sub(wittVectors(p, R), x, teichmullerPartialSum(R, p, n, x)))
proof
  sorry

-- W(R) is p-adically complete (WittVector.isAdicComplete for perfect R).
theorem wittVectors.adic_complete
  shows AdicCompleteRing(wittVectors(p, R),
    ringMultiples(wittVectors(p, R), natCast(wittVectors(p, R), p)))
proof
  sorry

-- Ring homomorphisms out of W(R) into a p-adically separated ring are
-- determined by their values on Teichmüller representatives (the source's
-- witt_hom_ext, from the expansion above).
theorem wittVectors.hom_ext (S f g : Set)
  requires target : CommRing(S)
  requires separated : AdicHausdorff(selfModule(S), S,
    ringMultiples(S, natCast(S, p)))
  requires first : (f : wittVectors(p, R) →+* S)
  requires second : (g : wittVectors(p, R) →+* S)
  requires agree : ∀ r ∈ Ring.carrier(R), f(teichmuller(R, r)) = g(teichmuller(R, r))
  shows ∀ x ∈ wittCarrier(R), f(x) = g(x)
proof
  sorry

end WittPerfect

-- Section: Perfect fields
section WittPerfectFields
variable (p : Nat, k : Set)
hypothesis prime : Prime(p)
hypothesis field : Field(k)
hypothesis comm : CommRing(k)
hypothesis perfect : PerfectRing(k, p)

-- W(k) is a discrete valuation ring with uniformizer p
-- (WittVector.instIsDiscreteValuationRing, WittVector.irreducible).
theorem wittVectors.dvr
  shows DiscreteValuationRing(wittVectors(p, k)) ∧
    Uniformizer(wittVectors(p, k), natCast(wittVectors(p, k), p))
proof
  sorry

-- WittVector.isUnit_of_coeff_zero_ne_zero.
theorem wittVectors.unit_of_coeff_zero (x : Set)
  requires member : x ∈ wittCarrier(k)
  requires nonzero : x(0) ≠ Ring.zero(k)
  shows RingUnit(wittVectors(p, k), x)
proof
  sorry

-- WittVector.exists_eq_pow_p_mul: a nonzero x is pᵐ b with b₀ ≠ 0.
theorem wittVectors.exists_eq_pow_p_mul (x : Set)
  requires member : x ∈ wittCarrier(k)
  requires nonzero : x ≠ Ring.zero(wittVectors(p, k))
  shows ∃ m ∈ ℕ, ∃ b ∈ wittCarrier(k), b(0) ≠ Ring.zero(k) ∧
    x = call2(Ring.mul(wittVectors(p, k)), natCast(wittVectors(p, k), pow(p, m)), b)
proof
  sorry

-- WittVector.quotientPEquiv: W(k)/(p) ≅ k through x ↦ x₀.
theorem wittVectors.quotient_p
  shows ∃ φ, RingIso(φ, quotientRing(wittVectors(p, k),
      ringMultiples(wittVectors(p, k), natCast(wittVectors(p, k), p))), k) ∧
    (∀ x ∈ wittCarrier(k), φ(quotientMk(wittVectors(p, k),
      ringMultiples(wittVectors(p, k), natCast(wittVectors(p, k), p)))(x)) = x(0))
proof
  sorry

end WittPerfectFields

-- Section: W(𝔽_p) = ℤ_p
-- WittVector.equiv (with toPadicInt, fromPadicInt): W(ℤ/pℤ) ≅ ℤ_p, and
-- the isomorphism is the only ring homomorphism between them.
theorem wittVectors.zmod_equiv (p : Nat)
  requires prime : Prime(p)
  shows ∃ φ, RingIso(φ, wittVectors(p, zmod(p)), padicIntRing(p)) ∧
    (∀ ψ, (ψ : wittVectors(p, zmod(p)) →+* padicIntRing(p)) →
      (∀ x ∈ wittCarrier(zmod(p)), ψ(x) = φ(x)))
proof
  sorry
