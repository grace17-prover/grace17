-- The algebraic closure of ℚ_p and its completion ℂ_p. An algebraic
-- closure Q̄_p of ℚ_p is not made by a definition: Mathlib's
-- AlgebraicClosure is built with choice, so here Q̄_p is any ℚ_p-algebra E
-- with IsAlgebraicClosure(E), a parameter of every definition, and its
-- existence and uniqueness are theorems (PadicAlgCl, IsAlgClosure). From E
-- everything is explicit: the spectral norm ‖x‖ = |N(x)|_p^(1/n) through
-- the minimal polynomial (spectralNorm), its integers, the Galois action,
-- ℂ_p as the completion of (E, ‖·‖) by Cauchy sequences (PadicComplex,
-- ℂ_[p]), its norm, the embeddings of ℚ_p and E, its integers O_C
-- (PadicComplexInt), the extension of the Galois action to ℂ_p, and the
-- independence of ℂ_p from the choice of E.
-- Part of the GRH blueprint.
-- Planned home: NumberTheory/Padic/Complex.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Padic.Cp
import GRH.Padic.Valuation

-- Section: Algebraic closures of ℚ_p
-- E is an algebraic closure of ℚ_p (PadicAlgCl p = AlgebraicClosure ℚ_[p],
-- characterised by IsAlgClosure ℚ_[p] E).
predicate PadicAlgebraicClosure (p : Nat, E : Set) :=
  Prime(p) ∧ IsAlgebraicClosure(E) ∧ Algebra.base(E) = padicField(p)

-- The spectral norm on E (spectralNorm ℚ_[p] E, the norm of
-- PadicAlgCl.normedField): ‖x‖ is the nonnegative real with
-- ‖x‖ⁿ = |a₀|_p, where a₀ is the constant coefficient and n the degree of
-- the minimal polynomial of x over ℚ_p (|a₀|_p = |N(x)|_p for the norm of
-- ℚ_p(x)/ℚ_p).
defunique padicAlgClNormValue (p : Nat, E x : Set) (y ∈ ℝ) :=
  RealLe(realZero, y) ∧
  realPow(y, polyNatDegree(padicField(p), minpoly(E, x))) =
    padicNorm(p)(mvConstantCoeff(padicField(p), {0}, minpoly(E, x)))
requires closure : PadicAlgebraicClosure(p, E)
requires member : x ∈ algebraCarrier(E)
proof
  sorry
uniqueness
  sorry

def padicAlgClNorm (p : Nat, E : Set) : Set :=
  { (x, padicAlgClNormValue(p, E, x)) | x ∈ algebraCarrier(E) }

-- The integers of E, {‖x‖ ≤ 1} (the valuation subring intQpBar of the
-- source, (PadicAlgCl.valued p).v.valuationSubring).
def padicAlgClIntegers (p : Nat, E : Set) : Set :=
  normUnitBall(Algebra.ring(E), padicAlgClNorm(p, E))

-- E as an algebra over ℤ_p, through the restriction of ℚ_p → E.
def padicAlgClIntAlgebra (p : Nat, E : Set) : Set :=
  Algebra.mk(padicIntRing(p), Algebra.ring(E), restrict(Algebra.map(E), padicIntCarrier(p)))

-- Section: ℂ_p
-- ℂ_[p] = the completion of (E, ‖·‖) (PadicComplex p =
-- UniformSpace.Completion (PadicAlgCl p)), its norm, and the embeddings
-- E → ℂ_p (the coercion) and ℚ_p → ℂ_p (algebraMap ℚ_[p] ℂ_[p]).
def cpField (p : Nat, E : Set) : Set := normCompletion(Algebra.ring(E), padicAlgClNorm(p, E))

def cpNorm (p : Nat, E : Set) : Set :=
  normCompletionNorm(Algebra.ring(E), padicAlgClNorm(p, E))

def cpOfAlgCl (p : Nat, E : Set) : Set :=
  normCompletionOf(Algebra.ring(E), padicAlgClNorm(p, E))

def cpOfPadic (p : Nat, E : Set) : Set :=
  { (a, cpOfAlgCl(p, E)(Algebra.map(E)(a))) | a ∈ Ring.carrier(padicField(p)) }

-- ℂ_p as a ℚ_p-algebra.
def cpAlgebra (p : Nat, E : Set) : Set :=
  Algebra.mk(padicField(p), cpField(p, E), cpOfPadic(p, E))

-- The topology of ℂ_p.
def cpSpace (p : Nat, E : Set) : Set :=
  normTopology(Ring.additive(cpField(p, E)), cpNorm(p, E))

-- O_C = {x ∈ ℂ_p | ‖x‖ ≤ 1} (PadicComplexInt, 𝓞_ℂ_[p]) and its ring.
def cpIntegers (p : Nat, E : Set) : Set := normUnitBall(cpField(p, E), cpNorm(p, E))

def cpIntegerRing (p : Nat, E : Set) : Set := subringRing(cpField(p, E), cpIntegers(p, E))

-- Section: The Galois action
-- σ ∈ Gal(Q̄_p/ℚ_p) acts on ℂ_p by [u] ↦ [σ ∘ u] (the continuous extension
-- of the isometric action; Lib.PadicHodge.PeriodRings.CpIntegers in the
-- source).
def seqMap (f u : Set) : Set := { (n, f(u(n))) | n ∈ ℕ }

def cpGaloisAction (p : Nat, E σ : Set) : Set :=
  { q ∈ Ring.carrier(cpField(p, E)) × Ring.carrier(cpField(p, E)) |
    ∃ u ∈ normCauchySeqs(Algebra.ring(E), padicAlgClNorm(p, E)),
      q = (normClass(Algebra.ring(E), padicAlgClNorm(p, E), u),
        normClass(Algebra.ring(E), padicAlgClNorm(p, E), seqMap(σ, u))) }

-- Section: Algebraic closures of ℚ_p exist and are unique
-- AlgebraicClosure ℚ_[p] with IsAlgClosure (the proof uses choice), and
-- IsAlgClosure.equiv: any two are isomorphic over ℚ_p.
theorem PadicAlgebraicClosure.exists (p : Nat)
  requires prime : Prime(p)
  shows ∃ E, PadicAlgebraicClosure(p, E)
proof
  sorry

theorem PadicAlgebraicClosure.unique (p : Nat, E E2 : Set)
  requires first : PadicAlgebraicClosure(p, E)
  requires second : PadicAlgebraicClosure(p, E2)
  shows ∃ σ, AlgebraIso(σ, E, E2)
proof
  sorry

-- Section: The norm on Q̄_p
section AlgebraicClosure
variable (p : Nat, E : Set)
hypothesis closure : PadicAlgebraicClosure(p, E)

-- PadicAlgCl.normedField, isUltrametricDist, nontriviallyNormedField.
theorem padicAlgClNorm.normed_field
  shows NontriviallyNormedField(Algebra.ring(E), padicAlgClNorm(p, E)) ∧
    NonarchimedeanNorm(Algebra.ring(E), padicAlgClNorm(p, E))
proof
  sorry

-- PadicAlgCl.norm_extends: ‖a‖ = ‖a‖_p for a ∈ ℚ_p.
theorem padicAlgClNorm.extends (a : Set)
  requires member : a ∈ Ring.carrier(padicField(p))
  shows padicAlgClNorm(p, E)(Algebra.map(E)(a)) = padicNorm(p)(a)
proof
  sorry

-- spectralNorm_unique: it is the only field norm on E extending ‖·‖_p.
theorem padicAlgClNorm.unique (norm : Set)
  requires normed : NormedField(Algebra.ring(E), norm)
  requires extends : ∀ a ∈ Ring.carrier(padicField(p)), norm(Algebra.map(E)(a)) = padicNorm(p)(a)
  shows norm = padicAlgClNorm(p, E)
proof
  sorry

-- spectralNorm_aut_isom: Galois conjugates have the same norm.
theorem padicAlgClNorm.galois_invariant (σ x : Set)
  requires automorphism : σ ∈ algebraAutomorphisms(E)
  requires member : x ∈ algebraCarrier(E)
  shows padicAlgClNorm(p, E)(σ(x)) = padicAlgClNorm(p, E)(x)
proof
  sorry

-- The values of the norm are rational powers of p: ‖x‖^m = p^k for some
-- m ≥ 1 and k ∈ ℤ when x ≠ 0.
theorem padicAlgClNorm.value (x : Set)
  requires member : x ∈ algebraCarrier(E)
  requires nonzero : x ≠ Ring.zero(Algebra.ring(E))
  shows ∃ m ∈ ℕ, ∃ k ∈ ℤ, m ≠ 0 ∧
    realPow(padicAlgClNorm(p, E)(x), m) = realZpow(realNat(p), k)
proof
  sorry

-- PadicAlgCl.charZero.
theorem padicAlgCl.char_zero (n : Nat)
  requires zero : natCast(Algebra.ring(E), n) = Ring.zero(Algebra.ring(E))
  shows n = 0
proof
  sorry

-- The integers of E are a valuation subring, the integral closure of
-- ℤ_p in E (Valuation.Integers.mem_of_integral, the source's intQpBar).
theorem padicAlgClIntegers.valuation_subring
  shows ValuationSubring(Algebra.ring(E), padicAlgClIntegers(p, E)) ∧
    padicAlgClIntegers(p, E) = integralClosure(padicAlgClIntAlgebra(p, E))
proof
  sorry

-- Section: ℂ_p
-- ℂ_[p] is a complete, nontrivially normed, nonarchimedean field
-- (PadicComplex.normedField, nontriviallyNormedField, isUltrametricDist,
-- completeSpace).
theorem cpField.normed_field
  shows NontriviallyNormedField(cpField(p, E), cpNorm(p, E)) ∧
    NonarchimedeanNorm(cpField(p, E), cpNorm(p, E)) ∧
    NormComplete(cpField(p, E), cpNorm(p, E))
proof
  obtain ⟨nn, ultraE⟩ := padicAlgClNorm.normed_field at p, E with closure
  obtain ⟨normedE, big⟩ := nn
  have a := normCompletion.normed_field at Algebra.ring(E), padicAlgClNorm(p, E) with normedE
  have b := normCompletion.nonarchimedean at Algebra.ring(E), padicAlgClNorm(p, E) with normedE, ultraE
  have c := normCompletion.complete at Algebra.ring(E), padicAlgClNorm(p, E) with normedE
  have hom := normCompletionOf.ring_hom at Algebra.ring(E), padicAlgClNorm(p, E) with normedE
  obtain ⟨ringE, ringC, fF, rest⟩ := hom
  obtain ⟨x, xIn, gt⟩ := big
  have iso := normCompletionOf.isometry at Algebra.ring(E), padicAlgClNorm(p, E), x with normedE, xIn
  have yIn := FunctionBetween.apply_closed with fF, xIn
  have nt : NontriviallyNormedField(normCompletion(Algebra.ring(E), padicAlgClNorm(p, E)),
      normCompletionNorm(Algebra.ring(E), padicAlgClNorm(p, E)))
    unfold NontriviallyNormedField
    refine ⟨a, normCompletionOf(Algebra.ring(E), padicAlgClNorm(p, E))(x), yIn, ?_⟩
    rw iso
    exact gt
  unfold cpField
  unfold cpNorm
  exact ⟨nt, b, c⟩

-- PadicComplex.isAlgClosed: ℂ_p is algebraically closed.
theorem cpField.algebraically_closed
  shows AlgebraicallyClosed(cpField(p, E))
proof
  sorry

-- The embedding of E is an isometric ring homomorphism with dense image
-- (PadicComplex.coe_eq, PadicComplex.norm_extends, UniformSpace.Completion.denseRange_coe).
theorem cpOfAlgCl.isometry
  shows (cpOfAlgCl(p, E) : Algebra.ring(E) →+* cpField(p, E)) ∧
    (∀ x ∈ algebraCarrier(E), cpNorm(p, E)(cpOfAlgCl(p, E)(x)) = padicAlgClNorm(p, E)(x))
proof
  obtain ⟨nn, ultraE⟩ := padicAlgClNorm.normed_field at p, E with closure
  obtain ⟨normedE, big⟩ := nn
  have hom := normCompletionOf.ring_hom at Algebra.ring(E), padicAlgClNorm(p, E) with normedE
  unfold cpOfAlgCl
  unfold cpField
  unfold cpNorm
  refine ⟨hom, ?_⟩
  intros x hx
  have xIn : x ∈ Ring.carrier(Algebra.ring(E))
    unfold algebraCarrier at hx
    exact hx
  exact normCompletionOf.isometry at Algebra.ring(E), padicAlgClNorm(p, E), x with normedE, xIn

-- PadicComplex.charZero (moved below cpOfAlgCl.isometry, unchanged).
theorem cpField.char_zero (n : Nat)
  requires zero : natCast(cpField(p, E), n) = Ring.zero(cpField(p, E))
  shows n = 0
proof
  obtain ⟨nn, ultraE⟩ := padicAlgClNorm.normed_field at p, E with closure
  obtain ⟨normedE, bigE⟩ := nn
  obtain ⟨efield, ecomm, eNR, emult, eone⟩ := normedE
  obtain ⟨ering, eNG, esub⟩ := eNR
  obtain ⟨eab, eIsNorm⟩ := eNG
  obtain ⟨enF, enn, ezero, eneg, etri⟩ := eIsNorm
  ring_additive at ezero
  obtain ⟨nt, ultra, complete⟩ := cpField.normed_field at p, E with closure
  obtain ⟨cnormed, big⟩ := nt
  obtain ⟨cfield, ccomm, cNR, cmult, cone⟩ := cnormed
  obtain ⟨cring, cNG, csub⟩ := cNR
  obtain ⟨cab, cIsNorm⟩ := cNG
  obtain ⟨cnF, cnn, czero, cneg, ctri⟩ := cIsNorm
  ring_additive at czero
  have iso := cpOfAlgCl.isometry at p, E with closure
  obtain ⟨hom, isometric⟩ := iso
  have nm := RingHom.map_numeral at Algebra.ring(E), cpField(p, E), cpOfAlgCl(p, E), n with ecomm, ccomm, hom
  have parts := Ring.parts with ering
  have yIn := IsRing.numeral_closed at Ring.carrier(Algebra.ring(E)), Ring.add(Algebra.ring(E)),
    Ring.zero(Algebra.ring(E)), Ring.neg(Algebra.ring(E)), Ring.mul(Algebra.ring(E)), Ring.one(Algebra.ring(E)), n with parts
  have yA : ringNat(Ring.add(Algebra.ring(E)), Ring.zero(Algebra.ring(E)), Ring.one(Algebra.ring(E)), n) ∈ algebraCarrier(E)
    unfold algebraCarrier
    exact yIn
  have i := isometric with ringNat(Ring.add(Algebra.ring(E)), Ring.zero(Algebra.ring(E)), Ring.one(Algebra.ring(E)), n), yA
  rw nm at i
  unfold natCast at zero
  rw zero at i
  have czeroIn := Ring.zero_mem with cring
  have cz := czero with Ring.zero(cpField(p, E)), czeroIn
  have c0 := cz.backward with rfl
  rw c0 at i
  symm at i
  have ez := ezero with ringNat(Ring.add(Algebra.ring(E)), Ring.zero(Algebra.ring(E)), Ring.one(Algebra.ring(E)), n), yIn
  have y0 := ez.forward with i
  have cz2 : natCast(Algebra.ring(E), n) = Ring.zero(Algebra.ring(E))
    unfold natCast
    exact y0
  exact padicAlgCl.char_zero at p, E, n with closure, cz2

theorem cpOfAlgCl.dense
  shows Dense(cpSpace(p, E),
    functionImage(cpOfAlgCl(p, E), algebraCarrier(E), Ring.carrier(cpField(p, E))))
proof
  obtain ⟨nn, ultraE⟩ := padicAlgClNorm.normed_field at p, E with closure
  obtain ⟨normedE, big⟩ := nn
  have d := normCompletionOf.dense at Algebra.ring(E), padicAlgClNorm(p, E) with normedE
  unfold cpSpace
  unfold cpOfAlgCl
  unfold cpField
  unfold cpNorm
  unfold algebraCarrier
  exact d

-- Helpers (track H): the structure map of E and the embedding of ℚ_p.
theorem tkH.cp.map_mem (a : Set)
  requires member : a ∈ Ring.carrier(padicField(p))
  shows Algebra.map(E)(a) ∈ algebraCarrier(E)
proof
  obtain ⟨pr, iac, base⟩ := closure
  obtain ⟨algExt, ac⟩ := iac
  obtain ⟨fe, aa⟩ := algExt
  obtain ⟨alg, fb, fr⟩ := fe
  obtain ⟨shape, baseRing, ringRing, structMap⟩ := alg
  obtain ⟨r1, r2, mapF, rest⟩ := structMap
  rw base at mapF
  unfold algebraCarrier
  exact FunctionBetween.apply_closed with mapF, member

theorem tkH.cp.of_padic (a : Set)
  requires member : a ∈ Ring.carrier(padicField(p))
  shows cpOfPadic(p, E)(a) = cpOfAlgCl(p, E)(Algebra.map(E)(a))
proof
  have relation : RelationBetween(cpOfPadic(p, E), Ring.carrier(padicField(p)), range(cpOfPadic(p, E)))
    unfold RelationBetween
    intros q hq
    obtain ⟨b, hb, eq⟩ := cpOfPadic.membership.forward with hq
    rw ← eq
    rw ← eq at hq
    have inRange := range.contains with hq
    exact product.pair with hb, inRange
  have functional : Functional(cpOfPadic(p, E))
    unfold Functional
    intros x y hxy z hxz
    unfold relates at hxy
    unfold relates at hxz
    obtain ⟨b, hb, eb⟩ := cpOfPadic.membership.forward with hxy
    obtain ⟨c, hc, ec⟩ := cpOfPadic.membership.forward with hxz
    obtain ⟨bx, vy⟩ := orderedPair.injective with eb
    obtain ⟨cx, vz⟩ := orderedPair.injective with ec
    rw ← vy
    rw ← vz
    rw bx
    rw cx
  have mapped : relates(cpOfPadic(p, E), a, cpOfAlgCl(p, E)(Algebra.map(E)(a)))
    unfold relates
    apply cpOfPadic.membership.backward
    exact ⟨a, member, rfl⟩
  exact tkH.graph.apply with relation, functional, mapped

-- ℂ_p is a ℚ_p-algebra whose norm extends ‖·‖_p (PadicComplex.norm_extends',
-- PadicComplex.norm_eq_norm, IsScalarTower ℚ_[p] (PadicAlgCl p) ℂ_[p]).
theorem cpAlgebra.algebra
  shows Algebra(cpAlgebra(p, E)) ∧
    (cpOfPadic(p, E) : padicField(p) →+* cpField(p, E))
proof
  have value : ∀ a ∈ Ring.carrier(padicField(p)), cpOfPadic(p, E)(a) = cpOfAlgCl(p, E)(Algebra.map(E)(a))
    intros a ha
    exact tkH.cp.of_padic at p, E, a with closure, ha
  have iso := cpOfAlgCl.isometry at p, E with closure
  obtain ⟨cHom, isometric⟩ := iso
  obtain ⟨nt, ultra, complete⟩ := cpField.normed_field at p, E with closure
  obtain ⟨cnormed, big⟩ := nt
  obtain ⟨cfield, cpComm, rest⟩ := cnormed
  obtain ⟨pr, iac, base⟩ := closure
  obtain ⟨algExt, ac⟩ := iac
  obtain ⟨fe, aa⟩ := algExt
  obtain ⟨alg, fb, fr⟩ := fe
  obtain ⟨shape, baseRing, ringRing, structMap⟩ := alg
  rw base at structMap
  rw base at baseRing
  obtain ⟨r1, r2, mapF, m0, m1, mneg, madd, mmul⟩ := structMap
  obtain ⟨s1, s2, cF, c0, c1, cneg, cadd, cmul⟩ := cHom
  have function : FunctionBetween(cpOfPadic(p, E), Ring.carrier(padicField(p)), Ring.carrier(cpField(p, E)))
    unfold FunctionBetween
    refine ⟨?_, ?_, ?_⟩
    . unfold RelationBetween
      intros q hq
      obtain ⟨b, hb, eq⟩ := cpOfPadic.membership.forward with hq
      rw ← eq
      have mb := FunctionBetween.apply_closed with mapF, hb
      have cb := FunctionBetween.apply_closed with cF, mb
      exact product.pair with hb, cb
    . unfold Functional
      intros x y hxy z hxz
      unfold relates at hxy
      unfold relates at hxz
      obtain ⟨b, hb, eb⟩ := cpOfPadic.membership.forward with hxy
      obtain ⟨c, hc, ec⟩ := cpOfPadic.membership.forward with hxz
      obtain ⟨bx, vy⟩ := orderedPair.injective with eb
      obtain ⟨cx, vz⟩ := orderedPair.injective with ec
      rw ← vy
      rw ← vz
      rw bx
      rw cx
    . intros a ha
      have ma := FunctionBetween.apply_closed with mapF, ha
      have ca := FunctionBetween.apply_closed with cF, ma
      have mapped : relates(cpOfPadic(p, E), a, cpOfAlgCl(p, E)(Algebra.map(E)(a)))
        unfold relates
        apply cpOfPadic.membership.backward
        exact ⟨a, ha, rfl⟩
      exact ⟨cpOfAlgCl(p, E)(Algebra.map(E)(a)), ca, mapped⟩
  have zeroQ := Ring.zero_mem with r1
  have oneQ := Ring.one_mem with r1
  have hom : RingHom(cpOfPadic(p, E), padicField(p), cpField(p, E))
    unfold RingHom
    refine ⟨r1, s2, function, ?_, ?_, ?_, ?_, ?_⟩
    . have v := value with Ring.zero(padicField(p)), zeroQ
      rw v
      rw m0
      exact c0
    . have v := value with Ring.one(padicField(p)), oneQ
      rw v
      rw m1
      exact c1
    . intros x hx
      have nx := Ring.neg_mem at padicField(p), x with r1, hx
      have v1 := value with apply(Ring.neg(padicField(p)), x), nx
      have v2 := value with x, hx
      rw v1
      rw v2
      have e1 := mneg with x, hx
      rw e1
      have mx := FunctionBetween.apply_closed with mapF, hx
      exact cneg with Algebra.map(E)(x), mx
    . intros x hx y hy
      have sxy := Ring.add_mem at padicField(p), x, y with r1, hx, hy
      have v1 := value with call2(Ring.add(padicField(p)), x, y), sxy
      have v2 := value with x, hx
      have v3 := value with y, hy
      rw v1
      rw v2
      rw v3
      have e1 := madd with x, hx, y, hy
      rw e1
      have mx := FunctionBetween.apply_closed with mapF, hx
      have my := FunctionBetween.apply_closed with mapF, hy
      exact cadd with Algebra.map(E)(x), mx, Algebra.map(E)(y), my
    . intros x hx y hy
      have sxy := Ring.mul_mem at padicField(p), x, y with r1, hx, hy
      have v1 := value with call2(Ring.mul(padicField(p)), x, y), sxy
      have v2 := value with x, hx
      have v3 := value with y, hy
      rw v1
      rw v2
      rw v3
      have e1 := mmul with x, hx, y, hy
      rw e1
      have mx := FunctionBetween.apply_closed with mapF, hx
      have my := FunctionBetween.apply_closed with mapF, hy
      exact cmul with Algebra.map(E)(x), mx, Algebra.map(E)(y), my
  have a := Algebra.intro at padicField(p), cpField(p, E), cpOfPadic(p, E) with baseRing, cpComm, hom
  unfold cpAlgebra
  exact ⟨a, hom⟩

theorem cpNorm.extends (a : Set)
  requires member : a ∈ Ring.carrier(padicField(p))
  shows cpNorm(p, E)(cpOfPadic(p, E)(a)) = padicNorm(p)(a)
proof
  have e := tkH.cp.of_padic at p, E, a with closure, member
  have m := tkH.cp.map_mem at p, E, a with closure, member
  have iso := cpOfAlgCl.isometry at p, E with closure
  obtain ⟨hom, isometric⟩ := iso
  have i := isometric with Algebra.map(E)(a), m
  have x := padicAlgClNorm.extends at p, E, a with closure, member
  rw e
  rw i
  exact x

-- ‖p‖ = 1/p in ℂ_p.
theorem cpNorm.p
  shows realMulValue(cpNorm(p, E)(natCast(cpField(p, E), p)), realNat(p)) = realOne
proof
  have prime := closure.left
  obtain ⟨qnormed, qultra⟩ := tkH.qp.normed at p with prime
  obtain ⟨qfield, qcomm, rest⟩ := qnormed
  obtain ⟨nt, ultra, complete⟩ := cpField.normed_field at p, E with closure
  obtain ⟨cnormed, big⟩ := nt
  obtain ⟨cfield, ccomm, rest2⟩ := cnormed
  have alg := cpAlgebra.algebra at p, E with closure
  obtain ⟨isAlg, hom⟩ := alg
  have nm := RingHom.map_numeral at padicField(p), cpField(p, E), cpOfPadic(p, E), p with qcomm, ccomm, hom
  have qring := CommRing.to_ring with qcomm
  have parts := Ring.parts with qring
  have aIn := IsRing.numeral_closed at Ring.carrier(padicField(p)), Ring.add(padicField(p)),
    Ring.zero(padicField(p)), Ring.neg(padicField(p)), Ring.mul(padicField(p)), Ring.one(padicField(p)), p with parts
  have ext := cpNorm.extends at p, E, ringNat(Ring.add(padicField(p)), Ring.zero(padicField(p)), Ring.one(padicField(p)), p) with closure, aIn
  rw nm at ext
  have np := padicNorm.p at p with prime
  unfold natCast
  unfold natCast at np
  rw ext
  exact np

-- The value group of ℂ_p is p^ℚ: every nonzero x has ‖x‖^m = p^k for
-- some m ≥ 1, k ∈ ℤ, and every such power is a norm.
theorem cpNorm.value (x : Set)
  requires member : x ∈ Ring.carrier(cpField(p, E))
  requires nonzero : x ≠ Ring.zero(cpField(p, E))
  shows ∃ m ∈ ℕ, ∃ k ∈ ℤ, m ≠ 0 ∧ realPow(cpNorm(p, E)(x), m) = realZpow(realNat(p), k)
proof
  sorry

theorem cpNorm.value_surjective (m : Nat, k : Set)
  requires positive : m ≠ 0
  requires integer : k ∈ ℤ
  shows ∃ x ∈ Ring.carrier(cpField(p, E)),
    realPow(cpNorm(p, E)(x), m) = realZpow(realNat(p), k)
proof
  sorry

-- Section: O_C
-- PadicComplexInt.integers: O_C is a valuation subring with maximal ideal
-- {‖x‖ < 1} and units {‖x‖ = 1}.
theorem cpIntegers.valuation_subring
  shows ValuationSubring(cpField(p, E), cpIntegers(p, E)) ∧
    cpIntegers(p, E) = valuationInteger(cpField(p, E), nnRealValues, cpNorm(p, E))
proof
  obtain ⟨nt, ultra, complete⟩ := cpField.normed_field at p, E with closure
  obtain ⟨normed, big⟩ := nt
  unfold cpIntegers
  exact normUnitBall.valuation_subring at cpField(p, E), cpNorm(p, E) with normed, ultra

theorem cpIntegers.maximal_ideal
  shows ValuationRing(cpIntegerRing(p, E)) ∧ LocalRing(cpIntegerRing(p, E)) ∧
    localMaximalIdeal(cpIntegerRing(p, E)) =
      valuationMaximal(cpField(p, E), nnRealValues, cpNorm(p, E))
proof
  obtain ⟨nt, ultra, complete⟩ := cpField.normed_field at p, E with closure
  obtain ⟨normed, big⟩ := nt
  have vs := cpIntegers.valuation_subring at p, E with closure
  obtain ⟨sub, same⟩ := vs
  have vr := ValuationSubring.valuation_ring at cpField(p, E), cpIntegers(p, E) with sub
  obtain ⟨vring, local, m⟩ := vr
  have valued := normValuation.valuation at cpField(p, E), cpNorm(p, E) with normed, ultra
  have mi := valuationInteger.maximal_ideal at cpField(p, E), nnRealValues, cpNorm(p, E) with valued
  obtain ⟨local2, m2⟩ := mi
  unfold cpIntegerRing
  rw same
  rw same at vring
  rw same at local
  exact ⟨vring, local, m2⟩

-- O_C is p-adically complete, p is not a unit, and O_C is not noetherian
-- in the sense that it is not a DVR (its value group is divisible).
theorem cpIntegerRing.adic_complete
  shows AdicCompleteRing(cpIntegerRing(p, E),
      ringMultiples(cpIntegerRing(p, E), natCast(cpIntegerRing(p, E), p))) ∧
    ¬RingUnit(cpIntegerRing(p, E), natCast(cpIntegerRing(p, E), p))
proof
  sorry

theorem cpIntegerRing.not_dvr
  shows ¬DiscreteValuationRing(cpIntegerRing(p, E))
proof
  sorry

-- O_C is integrally closed with all roots of monic polynomials: in
-- particular every element has a p-th root (the IsAIC property the
-- source uses for untilt_surjective_of_isAIC).
theorem cpIntegers.pow_surjective (x : Set, n : Nat)
  requires member : x ∈ cpIntegers(p, E)
  requires positive : n ≠ 0
  shows ∃ y ∈ cpIntegers(p, E), Ring.pow(cpField(p, E), y, n) = x
proof
  sorry

theorem cpIntegerRing.algebraically_closed_integers (f : Set)
  requires monic : PolyMonic(cpIntegerRing(p, E), f)
  requires nonconstant : polyNatDegree(cpIntegerRing(p, E), f) ≠ 0
  shows ∃ y ∈ cpIntegers(p, E), PolyIsRoot(cpIntegerRing(p, E), f, y)
proof
  sorry

-- Section: The Galois action on ℂ_p
-- The action of σ ∈ Gal(Q̄_p/ℚ_p) extends uniquely to a continuous
-- isometric ring automorphism of ℂ_p fixing ℚ_p; the extension respects
-- composition.
theorem cpGaloisAction.automorphism (σ : Set)
  requires automorphism : σ ∈ algebraAutomorphisms(E)
  shows AlgebraIso(cpGaloisAction(p, E, σ), cpAlgebra(p, E), cpAlgebra(p, E)) ∧
    (∀ x ∈ algebraCarrier(E), cpGaloisAction(p, E, σ)(cpOfAlgCl(p, E)(x)) =
      cpOfAlgCl(p, E)(σ(x))) ∧
    (∀ x ∈ Ring.carrier(cpField(p, E)), cpNorm(p, E)(cpGaloisAction(p, E, σ)(x)) = cpNorm(p, E)(x))
proof
  sorry

theorem cpGaloisAction.continuous (σ : Set)
  requires automorphism : σ ∈ algebraAutomorphisms(E)
  shows cpGaloisAction(p, E, σ) : cpSpace(p, E) ⇒ cpSpace(p, E)
proof
  sorry

theorem cpGaloisAction.compose (σ τ x : Set)
  requires first : σ ∈ algebraAutomorphisms(E)
  requires second : τ ∈ algebraAutomorphisms(E)
  requires member : x ∈ Ring.carrier(cpField(p, E))
  shows cpGaloisAction(p, E, call2(Group.mul(galoisGroup(E)), σ, τ))(x) =
    cpGaloisAction(p, E, σ)(cpGaloisAction(p, E, τ)(x))
proof
  sorry

-- The Galois action preserves O_C.
theorem cpGaloisAction.integers (σ x : Set)
  requires automorphism : σ ∈ algebraAutomorphisms(E)
  requires member : x ∈ cpIntegers(p, E)
  shows cpGaloisAction(p, E, σ)(x) ∈ cpIntegers(p, E)
proof
  have aut := cpGaloisAction.automorphism at p, E, σ with closure, automorphism
  obtain ⟨iso, fixes, normEq⟩ := aut
  obtain ⟨hom, bij⟩ := iso
  obtain ⟨inj, surj⟩ := bij
  obtain ⟨function, rest⟩ := inj
  have carrier : algebraCarrier(cpAlgebra(p, E)) = Ring.carrier(cpField(p, E))
    unfold algebraCarrier
    unfold cpAlgebra
    simp [Algebra.mk.ring]
  rw carrier at function
  unfold cpIntegers at member
  obtain ⟨xIn, le⟩ := normUnitBall.membership.forward with member
  have yIn := FunctionBetween.apply_closed with function, xIn
  have n := normEq with x, xIn
  unfold cpIntegers
  apply normUnitBall.membership.backward
  rw n
  exact ⟨yIn, le⟩

end AlgebraicClosure

-- Section: Independence of the choice
-- ℂ_p does not depend on the algebraic closure up to isometric ℚ_p-algebra
-- isomorphism (from IsAlgClosure.equiv and the uniqueness of the norm).
theorem cpField.independent (p : Nat, E E2 : Set)
  requires first : PadicAlgebraicClosure(p, E)
  requires second : PadicAlgebraicClosure(p, E2)
  shows ∃ φ, AlgebraIso(φ, cpAlgebra(p, E), cpAlgebra(p, E2)) ∧
    (∀ x ∈ Ring.carrier(cpField(p, E)), cpNorm(p, E2)(φ(x)) = cpNorm(p, E)(x))
proof
  sorry
