-- Perfections and tilts: the perfection of a ring of characteristic p as
-- the sequences (xₙ) with x_{n+1}^p = xₙ (Ring.Perfection, Perfection.coeff,
-- Perfection.pthRoot, Perfection.map, Perfection.lift), O/p (ModP), the
-- tilt O♭ = Perf(O/p) (PreTilt) and its fraction field (Tilt), the
-- multiplicative identification of O♭ with lim_{x ↦ x^p} O for O
-- p-adically complete (Perfection.quotientMulEquiv), the untilt x ↦ x♯
-- (PreTilt.untilt), Fontaine's θ : W(O♭) → O (WittVector.fontaineTheta),
-- functoriality along ring homomorphisms (the source's tiltMap), and the
-- tilt of O_C.
-- Part of the GRH blueprint.
-- Planned home: RingTheory/Perfectoid.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Padic.Tilt
import GRH.Padic.Witt
import GRH.Padic.Cp

-- Section: Perfection
-- The sequences (xₙ) in R with x_{n+1}^p = xₙ (the carrier of
-- Ring.Perfection R p, and of Perfection M p for the monoid of R).
def perfectionCarrier (R : Set, p : Nat) : Set :=
  { f ∈ functionSpace(ℕ, Ring.carrier(R)) | ∀ n ∈ ℕ, Ring.pow(R, f(succ(n)), p) = f(n) }

-- The termwise operations (Ring.Perfection as a subring of ℕ → R).
def perfectionAdd (R : Set, p : Nat) : Set :=
  { q ∈ (perfectionCarrier(R, p) × perfectionCarrier(R, p)) × perfectionCarrier(R, p) |
    ∃ f ∈ perfectionCarrier(R, p), ∃ g ∈ perfectionCarrier(R, p), q = ((f, g), seqAdd(R, f, g)) }

def perfectionMul (R : Set, p : Nat) : Set :=
  { q ∈ (perfectionCarrier(R, p) × perfectionCarrier(R, p)) × perfectionCarrier(R, p) |
    ∃ f ∈ perfectionCarrier(R, p), ∃ g ∈ perfectionCarrier(R, p), q = ((f, g), seqMul(R, f, g)) }

def perfectionNeg (R : Set, p : Nat) : Set :=
  { q ∈ perfectionCarrier(R, p) × perfectionCarrier(R, p) |
    ∃ f ∈ perfectionCarrier(R, p), q = (f, seqNeg(R, f)) }

def perfection (R : Set, p : Nat) : Set :=
  Ring.mk(perfectionCarrier(R, p), perfectionAdd(R, p), seqConst(Ring.zero(R)),
    perfectionNeg(R, p), perfectionMul(R, p), seqConst(Ring.one(R)))

-- The n-th coefficient f ↦ f(n) (Perfection.coeff), the p-th root
-- (f(n))ₙ ↦ (f(n + 1))ₙ (Perfection.pthRoot), and the map induced by
-- φ : R → S (Perfection.map).
def perfectionCoeff (R : Set, p n : Nat) : Set :=
  { (f, f(n)) | f ∈ perfectionCarrier(R, p) }

def seqShift (f : Set) : Set := { (n, f(succ(n))) | n ∈ ℕ }

def perfectionPthRoot (R : Set, p : Nat) : Set :=
  { (f, seqShift(f)) | f ∈ perfectionCarrier(R, p) }

def perfectionMap (R : Set, p : Nat, φ : Set) : Set :=
  { (f, seqMap(φ, f)) | f ∈ perfectionCarrier(R, p) }

-- Section: The tilt
-- O/p (ModP O p) and its quotient map, the tilt O♭ = Perf(O/p)
-- (PreTilt O p), and its fraction field (Tilt, the FractionRing of PreTilt).
def modPIdeal (O : Set, p : Nat) : Set := ringMultiples(O, natCast(O, p))

def modP (O : Set, p : Nat) : Set := quotientRing(O, modPIdeal(O, p))

def modPMk (O : Set, p : Nat) : Set := quotientMk(O, modPIdeal(O, p))

def preTilt (O : Set, p : Nat) : Set := perfection(modP(O, p), p)

def tiltField (O : Set, p : Nat) : Set := fractionRing(preTilt(O, p))

-- Reduction modulo p of a multiplicative p-power compatible sequence
-- in O (Perfection.mapMonoidHom (Ideal.Quotient.mk), whose inverse is
-- Perfection.quotientMulEquiv).
def perfectionReduce (O : Set, p : Nat) : Set :=
  { (f, seqMap(modPMk(O, p), f)) | f ∈ perfectionCarrier(O, p) }

-- The tilt of a ring homomorphism f : O → O' (the source's tiltMap,
-- Perfection.map of the induced map O/p → O'/p).
def tiltMap (O S : Set, p : Nat, f : Set) : Set :=
  perfectionMap(modP(O, p), p, quotientRingMap(O, S, f, modPIdeal(O, p), modPIdeal(S, p)))

-- Section: The untilt and θ
-- The untilt x♯ of x ∈ O♭ for O p-adically complete (PreTilt.untilt,
-- Perfection.teichmuller₀): the limit of a^(pⁿ) over lifts a of xₙ, that
-- is, the unique y with y ≡ a^(pⁿ) mod p^(n+1) for every n and every lift
-- a ∈ O of xₙ (Perfection.teichmuller_spec).
defunique untilt (O : Set, p : Nat, x : Set) (y ∈ Ring.carrier(O)) :=
  ∀ n ∈ ℕ, ∀ a ∈ Ring.carrier(O), modPMk(O, p)(a) = x(n) →
    Ring.sub(O, y, Ring.pow(O, a, pow(p, n))) ∈ idealPow(O, modPIdeal(O, p), succ(n))
requires prime : Prime(p)
requires comm : CommRing(O)
requires complete : AdicCompleteRing(O, modPIdeal(O, p))
requires member : x ∈ perfectionCarrier(modP(O, p), p)
proof
  sorry
uniqueness
  sorry

def untiltMap (O : Set, p : Nat) : Set :=
  { (x, untilt(O, p, x)) | x ∈ perfectionCarrier(modP(O, p), p) }

-- Fontaine's θ : W(O♭) → O (WittVector.fontaineTheta): with the
-- expansion x = Σ pⁱ [xᵢ^(p^(−i))] of x ∈ W(O♭), θ(x) = Σ pⁱ (xᵢ^(p^(−i)))♯,
-- the unique y congruent to the partial sums modulo p^(n+1) (Mathlib's θ
-- is the limit of its reductions fontaineThetaModPPow, which agree with
-- these partial sums).
def thetaTerms (O : Set, p : Nat, x : Set) : Set :=
  { (i, call2(Ring.mul(O), natCast(O, pow(p, i)),
      untilt(O, p, perfectRoot(preTilt(O, p), p, i, x(i))))) | i ∈ ℕ }

def thetaPartialSum (O : Set, p n : Nat, x : Set) : Set :=
  indexedRingSum(thetaTerms(O, p, x), identity(ℕ), Ring.add(O), Ring.zero(O), succ(n))

defunique fontaineThetaValue (O : Set, p : Nat, x : Set) (y ∈ Ring.carrier(O)) :=
  ∀ n ∈ ℕ, Ring.sub(O, y, thetaPartialSum(O, p, n, x)) ∈ idealPow(O, modPIdeal(O, p), succ(n))
requires prime : Prime(p)
requires comm : CommRing(O)
requires complete : AdicCompleteRing(O, modPIdeal(O, p))
requires nonunit : ¬RingUnit(O, natCast(O, p))
requires member : x ∈ wittCarrier(preTilt(O, p))
proof
  sorry
uniqueness
  sorry

def fontaineTheta (O : Set, p : Nat) : Set :=
  { (x, fontaineThetaValue(O, p, x)) | x ∈ wittCarrier(preTilt(O, p)) }

-- Section: Laws of the perfection
section Perfections
variable (R : Set, p : Nat)
hypothesis prime : Prime(p)
hypothesis comm : CommRing(R)
hypothesis charP : CharP(R, p)

-- Helpers (track H): coefficients of perfection sequences.
theorem tkH.pf.coeff (f : Set, n : Nat)
  requires member : f ∈ perfectionCarrier(R, p)
  shows perfectionCoeff(R, p, n)(f) = f(n)
proof
  have relation : RelationBetween(perfectionCoeff(R, p, n), perfectionCarrier(R, p),
      range(perfectionCoeff(R, p, n)))
    unfold RelationBetween
    intros q hq
    obtain ⟨g, hg, eq⟩ := perfectionCoeff.membership.forward with hq
    rw ← eq
    rw ← eq at hq
    have inRange := range.contains with hq
    exact product.pair with hg, inRange
  have functional : Functional(perfectionCoeff(R, p, n))
    unfold Functional
    intros a b hab c hac
    unfold relates at hab
    unfold relates at hac
    obtain ⟨x, hx, ex⟩ := perfectionCoeff.membership.forward with hab
    obtain ⟨y, hy, ey⟩ := perfectionCoeff.membership.forward with hac
    obtain ⟨xa, vb⟩ := orderedPair.injective with ex
    obtain ⟨ya, vc⟩ := orderedPair.injective with ey
    rw ← vb
    rw ← vc
    rw xa
    rw ya
  have mapped : relates(perfectionCoeff(R, p, n), f, f(n))
    unfold relates
    apply perfectionCoeff.membership.backward
    exact ⟨f, member, rfl⟩
  exact tkH.graph.apply with relation, functional, mapped

theorem tkH.pf.value (f : Set, n : Nat)
  requires member : f ∈ perfectionCarrier(R, p)
  shows f(n) ∈ Ring.carrier(R) ∧ Ring.pow(R, f(succ(n)), p) = f(n)
proof
  obtain ⟨fs, law⟩ := perfectionCarrier.membership.forward with member
  obtain ⟨pw, function⟩ := functionSpace.membership.forward with fs
  have nIn : n ∈ ℕ by typecheck
  have v := FunctionBetween.apply_closed with function, nIn
  have l := law with n, nIn
  exact ⟨v, l⟩

-- f(n + k)^(p^k) = f(n).
theorem tkH.pf.shift (f : Set, n k : Nat)
  requires member : f ∈ perfectionCarrier(R, p)
  shows Ring.pow(R, f(add(n, k)), pow(p, k)) = f(n)
proof
  have ring := CommRing.to_ring with comm
  induction k with
  | zero =>
    rw add.right_unit
    rw pow.zero
    obtain ⟨v, l⟩ := tkH.pf.value at R, p, f, n with prime, comm, charP, member
    exact Ring.pow_one at R, f(n) with ring, v
  | succ(j) using ih =>
    rw add.succ_right
    rw pow.succ
    obtain ⟨v, l⟩ := tkH.pf.value at R, p, f, add(n, j) with prime, comm, charP, member
    obtain ⟨v2, l2⟩ := tkH.pf.value at R, p, f, succ(add(n, j)) with prime, comm, charP, member
    have pj := pow.closed at p, j
    have m := Ring.pow_mul at R, f(succ(add(n, j))), p, pow(p, j) with ring, v2
    rw m
    rw l
    exact ih

-- Ring.Perfection R p is a perfect ring of characteristic p
-- (Perfection.perfectRing, Perfection.charP).
theorem perfection.perfect_ring
  shows CommRing(perfection(R, p)) ∧ PerfectRing(perfection(R, p), p)
proof
  sorry

-- Perfection.coeff is a ring homomorphism; coeff (n+1) f ^ p = coeff n f
-- (Perfection.coeff_pow_p'); coeff n f ^ (pⁿ) = coeff 0 f
-- (Perfection.coeffMonoidHom_pow_p_pow_self).
theorem perfectionCoeff.ring_hom (n : Nat)
  shows (perfectionCoeff(R, p, n) : perfection(R, p) →+* R)
proof
  sorry

theorem perfectionCoeff.pow_p (f : Set, n : Nat)
  requires member : f ∈ perfectionCarrier(R, p)
  shows Ring.pow(R, perfectionCoeff(R, p, succ(n))(f), p) = perfectionCoeff(R, p, n)(f)
proof
  have c1 := tkH.pf.coeff at R, p, f, succ(n) with prime, comm, charP, member
  have c0 := tkH.pf.coeff at R, p, f, n with prime, comm, charP, member
  rw [c1, c0]
  obtain ⟨v, l⟩ := tkH.pf.value at R, p, f, n with prime, comm, charP, member
  exact l

theorem perfectionCoeff.pow_p_pow_self (f : Set, n : Nat)
  requires member : f ∈ perfectionCarrier(R, p)
  shows Ring.pow(R, perfectionCoeff(R, p, n)(f), pow(p, n)) = perfectionCoeff(R, p, 0)(f)
proof
  have c1 := tkH.pf.coeff at R, p, f, n with prime, comm, charP, member
  have c0 := tkH.pf.coeff at R, p, f, 0 with prime, comm, charP, member
  rw [c1, c0]
  have s := tkH.pf.shift at R, p, f, 0, n with prime, comm, charP, member
  have z : add(0, n) = n by arith
  rw z at s
  exact s

-- Perfection.coeff_frobenius, Perfection.coeff_iterate_frobenius:
-- coeff (n + m) (f^(p^m)) = coeff n f.
theorem perfectionCoeff.iterate_frobenius (f : Set, n m : Nat)
  requires member : f ∈ perfectionCarrier(R, p)
  shows perfectionCoeff(R, p, add(n, m))(Ring.pow(perfection(R, p), f, pow(p, m))) =
    perfectionCoeff(R, p, n)(f)
proof
  sorry

-- Perfection.ext.
theorem perfection.ext (f g : Set)
  requires first : f ∈ perfectionCarrier(R, p)
  requires second : g ∈ perfectionCarrier(R, p)
  requires agree : ∀ n ∈ ℕ, perfectionCoeff(R, p, n)(f) = perfectionCoeff(R, p, n)(g)
  shows f = g
proof
  obtain ⟨fs, law⟩ := perfectionCarrier.membership.forward with first
  obtain ⟨pw, ff⟩ := functionSpace.membership.forward with fs
  obtain ⟨gs, law2⟩ := perfectionCarrier.membership.forward with second
  obtain ⟨pw2, gf⟩ := functionSpace.membership.forward with gs
  apply FunctionBetween.ext at f, g, ℕ, Ring.carrier(R) with ff, gf
  intros n hn
  have nNat : Nat(n) := hn
  have a := agree with n, hn
  have c1 := tkH.pf.coeff at R, p, f, n with prime, comm, charP, first
  have c2 := tkH.pf.coeff at R, p, g, n with prime, comm, charP, second
  rw [c1, c2] at a
  exact a

-- Perfection.pthRoot is the inverse of the Frobenius
-- (Perfection.pthRoot_frobenius, frobenius_pthRoot,
-- coe_pthRoot_eq_symm_frobeniusEquiv).
theorem perfectionPthRoot.inverse
  shows (perfectionPthRoot(R, p) : perfection(R, p) →+* perfection(R, p)) ∧
    (∀ f ∈ perfectionCarrier(R, p),
      perfectionPthRoot(R, p)(Ring.pow(perfection(R, p), f, p)) = f) ∧
    (∀ f ∈ perfectionCarrier(R, p),
      Ring.pow(perfection(R, p), perfectionPthRoot(R, p)(f), p) = f)
proof
  sorry

-- Perfection.coeff_surjective: when the Frobenius of R is onto, so is
-- each coefficient.
theorem perfectionCoeff.surjective (n : Nat)
  requires onto : SurjectiveBetween(frobenius(R, p), Ring.carrier(R), Ring.carrier(R))
  shows SurjectiveBetween(perfectionCoeff(R, p, n), perfectionCarrier(R, p), Ring.carrier(R))
proof
  sorry

-- Perfection.coeff_ne_zero_of_le, Perfection.coeff_add_ne_zero.
theorem perfectionCoeff.ne_zero_of_le (f : Set, m n : Nat)
  requires member : f ∈ perfectionCarrier(R, p)
  requires nonzero : perfectionCoeff(R, p, m)(f) ≠ Ring.zero(R)
  requires le : m ≤ n
  shows perfectionCoeff(R, p, n)(f) ≠ Ring.zero(R)
proof
  have ring := CommRing.to_ring with comm
  have c1 := tkH.pf.coeff at R, p, f, m with prime, comm, charP, member
  have c2 := tkH.pf.coeff at R, p, f, n with prime, comm, charP, member
  rw c1 at nonzero
  rw c2
  intro z
  obtain ⟨k, kNat, kEq⟩ := le
  have s := tkH.pf.shift at R, p, f, m, k with prime, comm, charP, member
  rw kEq at s
  rw z at s
  have big := Prime.greater_than_one with prime
  have pPos : 0 < p by arith
  have pos := pow.positive at p, k with pPos
  obtain ⟨j, jNat, jEq⟩ := pos
  have pk := pow.closed at p, k
  have e : pow(p, k) = j + 1 by arith
  rw e at s
  have zeroR := Ring.zero_mem with ring
  have sl := Ring.pow_succ_left at R, Ring.zero(R), j with ring, zeroR
  rw sl at s
  have pj := Ring.pow_mem at R, Ring.zero(R), j with ring, zeroR
  have zz : call2(Ring.mul(R), Ring.zero(R), Ring.pow(R, Ring.zero(R), j)) = Ring.zero(R) by ring
  rw zz at s
  symm at s
  exact nonzero with s

-- Perfection.map is a ring homomorphism with coeff n (map φ f) =
-- φ (coeff n f) (Perfection.coeff_map).
theorem perfectionMap.ring_hom (S φ : Set)
  requires target : CommRing(S)
  requires charS : CharP(S, p)
  requires hom : (φ : R →+* S)
  shows (perfectionMap(R, p, φ) : perfection(R, p) →+* perfection(S, p)) ∧
    (∀ f ∈ perfectionCarrier(R, p), ∀ n ∈ ℕ,
      perfectionCoeff(S, p, n)(perfectionMap(R, p, φ)(f)) = φ(perfectionCoeff(R, p, n)(f)))
proof
  sorry

-- Perfection.lift: for a perfect ring P of characteristic p, ring maps
-- P → R lift uniquely through coeff 0 to ring maps P → Perf(R).
theorem perfection.lift (P f : Set)
  requires source : CommRing(P)
  requires perfect : PerfectRing(P, p)
  requires hom : (f : P →+* R)
  shows ∃ g, (g : P →+* perfection(R, p)) ∧
    (∀ x ∈ Ring.carrier(P), perfectionCoeff(R, p, 0)(g(x)) = f(x)) ∧
    (∀ h, (h : P →+* perfection(R, p)) →
      (∀ x ∈ Ring.carrier(P), perfectionCoeff(R, p, 0)(h(x)) = f(x)) →
      (∀ x ∈ Ring.carrier(P), h(x) = g(x)))
proof
  sorry

end Perfections

-- Section: Laws of the tilt
section Tilts
variable (O : Set, p : Nat)
hypothesis prime : Prime(p)
hypothesis comm : CommRing(O)
hypothesis nonunit : ¬RingUnit(O, natCast(O, p))

-- O/p has characteristic p (ModP.charP) and O♭ is a perfect ring of
-- characteristic p (PreTilt's PerfectRing and CharP instances).
theorem modP.char_p
  shows CommRing(modP(O, p)) ∧ CharP(modP(O, p), p)
proof
  sorry

theorem preTilt.perfect_ring
  shows CommRing(preTilt(O, p)) ∧ PerfectRing(preTilt(O, p), p)
proof
  sorry

-- The tilt of a ring homomorphism is a ring homomorphism, functorial
-- (the source's tiltMap, tiltMap_id, tiltMap_comp, coeff_tiltMap).
theorem tiltMap.ring_hom (S f : Set)
  requires target : CommRing(S)
  requires nonunitS : ¬RingUnit(S, natCast(S, p))
  requires hom : (f : O →+* S)
  shows (tiltMap(O, S, p, f) : preTilt(O, p) →+* preTilt(S, p))
proof
  sorry

theorem tiltMap.id (x : Set)
  requires member : x ∈ perfectionCarrier(modP(O, p), p)
  shows tiltMap(O, O, p, identity(Ring.carrier(O)))(x) = x
proof
  sorry

theorem tiltMap.comp (S T f g x : Set)
  requires second : CommRing(S)
  requires third : CommRing(T)
  requires nonunitS : ¬RingUnit(S, natCast(S, p))
  requires nonunitT : ¬RingUnit(T, natCast(T, p))
  requires homF : (f : O →+* S)
  requires homG : (g : S →+* T)
  requires member : x ∈ perfectionCarrier(modP(O, p), p)
  shows tiltMap(O, T, p, compose(g, f, Ring.carrier(O), Ring.carrier(S), Ring.carrier(T)))(x) =
    tiltMap(S, T, p, g)(tiltMap(O, S, p, f)(x))
proof
  sorry

-- Section: p-adically complete rings
-- Perfection.quotientMulEquiv: reduction mod p is a multiplicative
-- bijection from lim_{x ↦ x^p} O onto O♭.
theorem perfectionReduce.bijective
  requires complete : AdicCompleteRing(O, modPIdeal(O, p))
  shows BijectiveBetween(perfectionReduce(O, p), perfectionCarrier(O, p),
      perfectionCarrier(modP(O, p), p)) ∧
    (∀ f ∈ perfectionCarrier(O, p), ∀ g ∈ perfectionCarrier(O, p),
      perfectionReduce(O, p)(seqMul(O, f, g)) =
        call2(Ring.mul(preTilt(O, p)), perfectionReduce(O, p)(f), perfectionReduce(O, p)(g)))
proof
  sorry

-- PreTilt.untilt is multiplicative with 0♯ = 0 and 1♯ = 1 (a monoid hom).
theorem untilt.mul (x y : Set)
  requires complete : AdicCompleteRing(O, modPIdeal(O, p))
  requires first : x ∈ perfectionCarrier(modP(O, p), p)
  requires second : y ∈ perfectionCarrier(modP(O, p), p)
  shows untilt(O, p, call2(Ring.mul(preTilt(O, p)), x, y)) =
    call2(Ring.mul(O), untilt(O, p, x), untilt(O, p, y))
proof
  sorry

theorem untilt.one_zero
  requires complete : AdicCompleteRing(O, modPIdeal(O, p))
  shows untilt(O, p, Ring.one(preTilt(O, p))) = Ring.one(O) ∧
    untilt(O, p, Ring.zero(preTilt(O, p))) = Ring.zero(O)
proof
  sorry

-- PreTilt.mk_untilt_eq_coeff_zero: x♯ mod p = coeff 0 x.
theorem untilt.mod_p (x : Set)
  requires complete : AdicCompleteRing(O, modPIdeal(O, p))
  requires member : x ∈ perfectionCarrier(modP(O, p), p)
  shows modPMk(O, p)(untilt(O, p, x)) = perfectionCoeff(modP(O, p), p, 0)(x)
proof
  sorry

-- PreTilt.untilt_iterate_frobeniusEquiv_symm_pow: (x^(p^(−n)))♯^(pⁿ) = x♯.
theorem untilt.root_pow (x : Set, n : Nat)
  requires complete : AdicCompleteRing(O, modPIdeal(O, p))
  requires member : x ∈ perfectionCarrier(modP(O, p), p)
  shows Ring.pow(O, untilt(O, p, perfectRoot(preTilt(O, p), p, n, x)), pow(p, n)) =
    untilt(O, p, x)
proof
  sorry

-- The untilt commutes with tilts of homomorphisms (the source's
-- untilt_tiltMap).
theorem untilt.tiltMap (S f x : Set)
  requires complete : AdicCompleteRing(O, modPIdeal(O, p))
  requires target : CommRing(S)
  requires completeS : AdicCompleteRing(S, modPIdeal(S, p))
  requires nonunitS : ¬RingUnit(S, natCast(S, p))
  requires hom : (f : O →+* S)
  requires member : x ∈ perfectionCarrier(modP(O, p), p)
  shows untilt(S, p, tiltMap(O, S, p, f)(x)) = f(untilt(O, p, x))
proof
  sorry

-- For O an integrally closed domain, x♯ ∣ y♯ ↔ x ∣ y (the source's
-- untilt_dvd_iff).
theorem untilt.dvd_iff (x y : Set)
  requires complete : AdicCompleteRing(O, modPIdeal(O, p))
  requires closed : IntegrallyClosedDomain(O)
  requires first : x ∈ perfectionCarrier(modP(O, p), p)
  requires second : y ∈ perfectionCarrier(modP(O, p), p)
  shows RingDvd(O, untilt(O, p, x), untilt(O, p, y)) ↔ RingDvd(preTilt(O, p), x, y)
proof
  sorry

-- WittVector.fontaineTheta is a ring homomorphism with θ([x]) = x♯
-- (WittVector.fontaineTheta_teichmuller) and θ(x) mod p = coeff 0 (x₀)
-- (WittVector.mk_fontaineTheta).
theorem fontaineTheta.ring_hom
  requires complete : AdicCompleteRing(O, modPIdeal(O, p))
  shows (fontaineTheta(O, p) : wittVectors(p, preTilt(O, p)) →+* O)
proof
  sorry

theorem fontaineTheta.teichmuller (x : Set)
  requires complete : AdicCompleteRing(O, modPIdeal(O, p))
  requires member : x ∈ perfectionCarrier(modP(O, p), p)
  shows fontaineTheta(O, p)(teichmuller(preTilt(O, p), x)) = untilt(O, p, x)
proof
  sorry

theorem fontaineTheta.mod_p (x : Set)
  requires complete : AdicCompleteRing(O, modPIdeal(O, p))
  requires member : x ∈ wittCarrier(preTilt(O, p))
  shows modPMk(O, p)(fontaineTheta(O, p)(x)) = perfectionCoeff(modP(O, p), p, 0)(x(0))
proof
  sorry

-- θ commutes with tilts of homomorphisms (the source's
-- fontaineTheta_map_tiltMap).
theorem fontaineTheta.tiltMap (S f x : Set)
  requires complete : AdicCompleteRing(O, modPIdeal(O, p))
  requires target : CommRing(S)
  requires completeS : AdicCompleteRing(S, modPIdeal(S, p))
  requires nonunitS : ¬RingUnit(S, natCast(S, p))
  requires hom : (f : O →+* S)
  requires member : x ∈ wittCarrier(preTilt(O, p))
  shows fontaineTheta(S, p)(wittMap(preTilt(O, p), tiltMap(O, S, p, f))(x)) =
    f(fontaineTheta(O, p)(x))
proof
  sorry

end Tilts

-- Section: The tilt of O_C
section CpTilt
variable (p : Nat, E : Set)
hypothesis closure : PadicAlgebraicClosure(p, E)

-- O_C♭ is a domain and a valuation ring (the source's IsDomain and
-- ValuationRing instances on PreTilt of a complete valuation ring), and
-- its fraction field C♭ is a field.
theorem cpIntegerRing.tilt_valuation_ring
  shows ValuationRing(preTilt(cpIntegerRing(p, E), p)) ∧
    Field(tiltField(cpIntegerRing(p, E), p))
proof
  sorry

-- The untilt and θ are onto O_C, since every element of O_C has p-th
-- roots (the source's untilt_surjective_of_isAIC,
-- fontaineTheta_surjective_of_isAIC).
theorem cpIntegerRing.untilt_surjective
  shows SurjectiveBetween(untiltMap(cpIntegerRing(p, E), p),
    perfectionCarrier(modP(cpIntegerRing(p, E), p), p), cpIntegers(p, E))
proof
  sorry

theorem cpIntegerRing.theta_surjective
  shows SurjectiveBetween(fontaineTheta(cpIntegerRing(p, E), p),
    wittCarrier(preTilt(cpIntegerRing(p, E), p)), cpIntegers(p, E))
proof
  sorry

end CpTilt
