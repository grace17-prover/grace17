-- Valuations: linearly ordered commutative groups with zero as value
-- monoids (with ℝ≥0 as the standard one), Krull valuations of rings
-- (Valuation), their integers, maximal ideals and ball ideals
-- (Valuation.integer, leIdeal), equivalence of valuations
-- (Valuation.IsEquiv), valuation subrings of a field (ValuationSubring)
-- with their units, nonunits and principal units, the valuation of a
-- valuation subring with values in K^×/A^× (ValuationSubring.valuation),
-- valued fields and their topology (Valued), nonarchimedean groups and
-- norms (NonarchimedeanGroup, IsUltrametricDist), the valuation of a
-- nonarchimedean normed field (NormedField.valuation), and ℤ_p as the
-- valuation subring of ℚ_p, p-adically complete.
-- Part of the GRH blueprint.
-- Planned home: Algebra/Valuation.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Padic.Valuation
import GRH.Padic.Numbers
import GRH.Algebra.Completion

-- Section: Value monoids
-- A value monoid Γ₀: a carrier with a multiplication, one, zero, and an
-- order relation, built by ValueMonoid.mk and read back by its
-- projections (the data of Mathlib's LinearOrderedCommGroupWithZero).
structure ValueMonoid
  | carrier : Set
  | mul : Set
  | one : Set
  | zero : Set
  | le : Set

-- a ≤ b and a < b in Γ₀.
predicate ValueLe (Γ a b : Set) := relates(ValueMonoid.le(Γ), a, b)
predicate ValueLt (Γ a b : Set) := ValueLe(Γ, a, b) ∧ a ≠ b

-- The laws (LinearOrderedCommGroupWithZero): a commutative monoid with an
-- absorbing zero ≠ 1 whose nonzero elements form a group, linearly
-- ordered with zero least and multiplication monotone.
predicate LinearOrderedCommGroupWithZero (Γ : Set) :=
  FunctionBetween(ValueMonoid.mul(Γ), ValueMonoid.carrier(Γ) × ValueMonoid.carrier(Γ),
    ValueMonoid.carrier(Γ)) ∧
  ValueMonoid.one(Γ) ∈ ValueMonoid.carrier(Γ) ∧
  ValueMonoid.zero(Γ) ∈ ValueMonoid.carrier(Γ) ∧
  ValueMonoid.zero(Γ) ≠ ValueMonoid.one(Γ) ∧
  (∀ a ∈ ValueMonoid.carrier(Γ), ∀ b ∈ ValueMonoid.carrier(Γ), ∀ c ∈ ValueMonoid.carrier(Γ),
    call2(ValueMonoid.mul(Γ), call2(ValueMonoid.mul(Γ), a, b), c) =
      call2(ValueMonoid.mul(Γ), a, call2(ValueMonoid.mul(Γ), b, c))) ∧
  (∀ a ∈ ValueMonoid.carrier(Γ), ∀ b ∈ ValueMonoid.carrier(Γ),
    call2(ValueMonoid.mul(Γ), a, b) = call2(ValueMonoid.mul(Γ), b, a)) ∧
  (∀ a ∈ ValueMonoid.carrier(Γ), call2(ValueMonoid.mul(Γ), ValueMonoid.one(Γ), a) = a) ∧
  (∀ a ∈ ValueMonoid.carrier(Γ),
    call2(ValueMonoid.mul(Γ), ValueMonoid.zero(Γ), a) = ValueMonoid.zero(Γ)) ∧
  (∀ a ∈ ValueMonoid.carrier(Γ), a ≠ ValueMonoid.zero(Γ) →
    (∃ b ∈ ValueMonoid.carrier(Γ), call2(ValueMonoid.mul(Γ), a, b) = ValueMonoid.one(Γ))) ∧
  IsLinearOrder(ValueMonoid.carrier(Γ), ValueMonoid.le(Γ)) ∧
  (∀ a ∈ ValueMonoid.carrier(Γ), ValueLe(Γ, ValueMonoid.zero(Γ), a)) ∧
  (∀ a ∈ ValueMonoid.carrier(Γ), ∀ b ∈ ValueMonoid.carrier(Γ), ∀ c ∈ ValueMonoid.carrier(Γ),
    ValueLe(Γ, a, b) →
      ValueLe(Γ, call2(ValueMonoid.mul(Γ), a, c), call2(ValueMonoid.mul(Γ), b, c)))

-- ℝ≥0 with its multiplication and order (NNReal), the value monoid of
-- norms.
def nnReals : Set := { x ∈ ℝ | realZero ≤ x }

def nnRealMul : Set :=
  { q ∈ (nnReals × nnReals) × nnReals | snd(q) = realMulValue(fst(fst(q)), snd(fst(q))) }

def nnRealLe : Set := { q ∈ nnReals × nnReals | RealLe(fst(q), snd(q)) }

def nnRealValues : Set := ValueMonoid.mk(nnReals, nnRealMul, realOne, realZero, nnRealLe)

-- Section: Valuations
-- v : R → Γ₀ is a valuation (Valuation R Γ₀): v(0) = 0, v(1) = 1,
-- v(xy) = v(x) v(y), and v(x + y) ≤ max(v(x), v(y)).
predicate Valuation (R Γ v : Set) :=
  Ring(R) ∧ LinearOrderedCommGroupWithZero(Γ) ∧
  FunctionBetween(v, Ring.carrier(R), ValueMonoid.carrier(Γ)) ∧
  v(Ring.zero(R)) = ValueMonoid.zero(Γ) ∧ v(Ring.one(R)) = ValueMonoid.one(Γ) ∧
  (∀ x ∈ Ring.carrier(R), ∀ y ∈ Ring.carrier(R),
    v(call2(Ring.mul(R), x, y)) = call2(ValueMonoid.mul(Γ), v(x), v(y))) ∧
  (∀ x ∈ Ring.carrier(R), ∀ y ∈ Ring.carrier(R),
    ValueLe(Γ, v(call2(Ring.add(R), x, y)), v(x)) ∨
    ValueLe(Γ, v(call2(Ring.add(R), x, y)), v(y)))

-- The integers {v ≤ 1} (Valuation.integer, Valuation.valuationSubring),
-- the elements of value < 1, and the elements of value 1.
def valuationInteger (R Γ v : Set) : Set :=
  { x ∈ Ring.carrier(R) | ValueLe(Γ, v(x), ValueMonoid.one(Γ)) }

def valuationMaximal (R Γ v : Set) : Set :=
  { x ∈ Ring.carrier(R) | ValueLt(Γ, v(x), ValueMonoid.one(Γ)) }

def valuationUnits (R Γ v : Set) : Set :=
  { x ∈ Ring.carrier(R) | v(x) = ValueMonoid.one(Γ) }

-- The ideals {v ≤ γ} and {v < γ} of the integers (Valuation.leIdeal,
-- leSubmodule, leAddSubgroup; ltSubmodule, ltAddSubgroup).
def valuationLeIdeal (R Γ v γ : Set) : Set :=
  { x ∈ Ring.carrier(R) | ValueLe(Γ, v(x), γ) }

def valuationLtIdeal (R Γ v γ : Set) : Set :=
  { x ∈ Ring.carrier(R) | ValueLt(Γ, v(x), γ) }

-- Equivalent valuations induce the same order (Valuation.IsEquiv).
predicate ValuationEquiv (R Γ v Δ w : Set) :=
  Valuation(R, Γ, v) ∧ Valuation(R, Δ, w) ∧
  (∀ x ∈ Ring.carrier(R), ∀ y ∈ Ring.carrier(R),
    ValueLe(Γ, v(x), v(y)) ↔ ValueLe(Δ, w(x), w(y)))

-- The pullback v ∘ f along a ring homomorphism f : S → R (Valuation.comap).
def valuationComap (S v f : Set) : Set := { (x, v(f(x))) | x ∈ Ring.carrier(S) }

-- Section: Valuation subrings
-- A valuation subring of a field K (ValuationSubring K): a subring
-- containing x or x⁻¹ for every nonzero x.
predicate ValuationSubring (K A : Set) :=
  Field(K) ∧ CommRing(K) ∧ Subring(K, A) ∧
  (∀ x ∈ Ring.carrier(K), x ∈ A ∨
    (∃ y ∈ A, call2(Ring.mul(K), x, y) = Ring.one(K)))

-- Its units (ValuationSubring.unitGroup), nonunits (ValuationSubring.nonunits,
-- the maximal ideal), and principal units 1 + m (principalUnitGroup).
def valuationSubringUnits (K A : Set) : Set :=
  { x ∈ A | ∃ y ∈ A, call2(Ring.mul(K), x, y) = Ring.one(K) }

def valuationSubringNonunits (K A : Set) : Set := A ∖ valuationSubringUnits(K, A)

def principalUnits (K A : Set) : Set :=
  { x ∈ Ring.carrier(K) | x ≠ Ring.zero(K) ∧
    Ring.sub(K, x, Ring.one(K)) ∈ valuationSubringNonunits(K, A) }

-- The valuation of a valuation subring (ValuationSubring.valuation, with
-- values in ValuationSubring.ValueGroup): x ~ y when y = u x for a unit u
-- of A; the classes, with [x][y] = [xy] and [x] ≤ [y] when x = a y for
-- some a ∈ A.
def valueRelation (K A : Set) : Set :=
  { q ∈ Ring.carrier(K) × Ring.carrier(K) |
    ∃ u ∈ valuationSubringUnits(K, A), snd(q) = call2(Ring.mul(K), u, fst(q)) }

def valueClasses (K A : Set) : Set := Ring.carrier(K) ⧸ valueRelation(K, A)

def valueClass (K A x : Set) : Set := ⟦x⟧[Ring.carrier(K), valueRelation(K, A)]

def valueClassMul (K A : Set) : Set :=
  { q ∈ (valueClasses(K, A) × valueClasses(K, A)) × valueClasses(K, A) |
    ∃ x ∈ Ring.carrier(K), ∃ y ∈ Ring.carrier(K),
      q = ((valueClass(K, A, x), valueClass(K, A, y)),
        valueClass(K, A, call2(Ring.mul(K), x, y))) }

def valueClassLe (K A : Set) : Set :=
  { q ∈ valueClasses(K, A) × valueClasses(K, A) |
    ∃ x ∈ Ring.carrier(K), ∃ y ∈ Ring.carrier(K), ∃ a ∈ A,
      q = (valueClass(K, A, x), valueClass(K, A, y)) ∧ x = call2(Ring.mul(K), a, y) }

def valueGroupOf (K A : Set) : Set :=
  ValueMonoid.mk(valueClasses(K, A), valueClassMul(K, A), valueClass(K, A, Ring.one(K)),
    valueClass(K, A, Ring.zero(K)), valueClassLe(K, A))

def valuationOfSubring (K A : Set) : Set :=
  { (x, valueClass(K, A, x)) | x ∈ Ring.carrier(K) }

-- Section: Valued fields
-- A valued field (Valued K Γ₀): a field with a valuation; its topology,
-- in which U is open when around each x ∈ U some ball {y | v(y − x) < γ},
-- γ ≠ 0, lies in U (Valued.mk', Valuation.subgroups_basis).
predicate Valued (K Γ v : Set) := Field(K) ∧ CommRing(K) ∧ Valuation(K, Γ, v)

def valuationBall (K Γ v x γ : Set) : Set :=
  { y ∈ Ring.carrier(K) | ValueLt(Γ, v(Ring.sub(K, y, x)), γ) }

def valuationOpens (K Γ v : Set) : Set :=
  { U ∈ 𝒫(Ring.carrier(K)) | ∀ x ∈ U, ∃ γ ∈ ValueMonoid.carrier(Γ),
    γ ≠ ValueMonoid.zero(Γ) ∧ valuationBall(K, Γ, v, x, γ) ⊆ U }

def valuationSphere (K Γ v γ : Set) : Set := { x ∈ Ring.carrier(K) | v(x) = γ }

-- The sequence n ↦ xⁿ.
def powSequence (K x : Set) : Set := { (n, Ring.pow(K, x, n)) | n ∈ ℕ }

def valuationTopology (K Γ v : Set) : Set :=
  TopologicalSpace.mk(Ring.carrier(K), valuationOpens(K, Γ, v))

-- A nonarchimedean topological additive group: every neighbourhood of 0
-- contains an open subgroup (NonarchimedeanAddGroup).
predicate NonarchimedeanAddGroup (G X : Set) :=
  TopologicalGroup(G, X) ∧
  (∀ U, Neighborhood(X, U, Group.one(G)) → (∃ H, OpenSubgroup(H, G, X) ∧ H ⊆ U))

-- The unit ball and the closed balls of a normed field.
def normUnitBall (K norm : Set) : Set := { x ∈ Ring.carrier(K) | norm(x) ≤ realOne }

def normClosedBall (K norm x r : Set) : Set :=
  { y ∈ Ring.carrier(K) | RealLe(norm(Ring.sub(K, y, x)), r) }

-- Helpers (track H): the order and multiplication laws of a value monoid.
section TkHValueMonoid
variable (Γ : Set)
hypothesis ordered : LinearOrderedCommGroupWithZero(Γ)

theorem tkH.vm.mul_closed (a b : Set)
  requires first : a ∈ ValueMonoid.carrier(Γ)
  requires second : b ∈ ValueMonoid.carrier(Γ)
  shows call2(ValueMonoid.mul(Γ), a, b) ∈ ValueMonoid.carrier(Γ)
proof
  obtain ⟨mulF, rest⟩ := ordered
  unfold call2
  have pairIn := product.pair at a, b, ValueMonoid.carrier(Γ), ValueMonoid.carrier(Γ) with first, second
  exact FunctionBetween.apply_closed with mulF, pairIn

theorem tkH.vm.one_in
  shows ValueMonoid.one(Γ) ∈ ValueMonoid.carrier(Γ)
proof
  obtain ⟨mulF, oneIn, rest⟩ := ordered
  exact oneIn

theorem tkH.vm.zero_in
  shows ValueMonoid.zero(Γ) ∈ ValueMonoid.carrier(Γ)
proof
  obtain ⟨mulF, oneIn, zeroIn, rest⟩ := ordered
  exact zeroIn

theorem tkH.vm.le_refl (a : Set)
  requires member : a ∈ ValueMonoid.carrier(Γ)
  shows ValueLe(Γ, a, a)
proof
  obtain ⟨mulF, oneIn, zeroIn, ne, assoc, comm, oneMul, zeroMul, inv, lin, rest⟩ := ordered
  obtain ⟨partial, total⟩ := lin
  obtain ⟨pre, anti⟩ := partial
  obtain ⟨rel, refl, trans⟩ := pre
  unfold ValueLe
  exact refl with member

theorem tkH.vm.le_trans (a b c : Set)
  requires ma : a ∈ ValueMonoid.carrier(Γ)
  requires mb : b ∈ ValueMonoid.carrier(Γ)
  requires mc : c ∈ ValueMonoid.carrier(Γ)
  requires first : ValueLe(Γ, a, b)
  requires second : ValueLe(Γ, b, c)
  shows ValueLe(Γ, a, c)
proof
  obtain ⟨mulF, oneIn, zeroIn, ne, assoc, comm, oneMul, zeroMul, inv, lin, rest⟩ := ordered
  obtain ⟨partial, total⟩ := lin
  obtain ⟨pre, anti⟩ := partial
  obtain ⟨rel, refl, trans⟩ := pre
  unfold ValueLe at first
  unfold ValueLe at second
  unfold ValueLe
  unfold TransitiveOn at trans
  exact trans with a, ma, b, mb, c, mc, first, second

theorem tkH.vm.le_antisymm (a b : Set)
  requires ma : a ∈ ValueMonoid.carrier(Γ)
  requires mb : b ∈ ValueMonoid.carrier(Γ)
  requires first : ValueLe(Γ, a, b)
  requires second : ValueLe(Γ, b, a)
  shows a = b
proof
  obtain ⟨mulF, oneIn, zeroIn, ne, assoc, comm, oneMul, zeroMul, inv, lin, rest⟩ := ordered
  obtain ⟨partial, total⟩ := lin
  obtain ⟨pre, anti⟩ := partial
  unfold ValueLe at first
  unfold ValueLe at second
  unfold AntisymmetricOn at anti
  exact anti with a, ma, b, mb, first, second

theorem tkH.vm.le_total (a b : Set)
  requires ma : a ∈ ValueMonoid.carrier(Γ)
  requires mb : b ∈ ValueMonoid.carrier(Γ)
  shows ValueLe(Γ, a, b) ∨ ValueLe(Γ, b, a)
proof
  obtain ⟨mulF, oneIn, zeroIn, ne, assoc, comm, oneMul, zeroMul, inv, lin, rest⟩ := ordered
  obtain ⟨partial, total⟩ := lin
  unfold ValueLe
  exact total with a, ma, b, mb

theorem tkH.vm.mul_comm (a b : Set)
  requires ma : a ∈ ValueMonoid.carrier(Γ)
  requires mb : b ∈ ValueMonoid.carrier(Γ)
  shows call2(ValueMonoid.mul(Γ), a, b) = call2(ValueMonoid.mul(Γ), b, a)
proof
  obtain ⟨mulF, oneIn, zeroIn, ne, assoc, comm, rest⟩ := ordered
  exact comm with a, ma, b, mb

theorem tkH.vm.mul_assoc (a b c : Set)
  requires ma : a ∈ ValueMonoid.carrier(Γ)
  requires mb : b ∈ ValueMonoid.carrier(Γ)
  requires mc : c ∈ ValueMonoid.carrier(Γ)
  shows call2(ValueMonoid.mul(Γ), call2(ValueMonoid.mul(Γ), a, b), c) =
    call2(ValueMonoid.mul(Γ), a, call2(ValueMonoid.mul(Γ), b, c))
proof
  obtain ⟨mulF, oneIn, zeroIn, ne, assoc, rest⟩ := ordered
  exact assoc with a, ma, b, mb, c, mc

theorem tkH.vm.one_mul (a : Set)
  requires ma : a ∈ ValueMonoid.carrier(Γ)
  shows call2(ValueMonoid.mul(Γ), ValueMonoid.one(Γ), a) = a
proof
  obtain ⟨mulF, oneIn, zeroIn, ne, assoc, comm, oneMul, rest⟩ := ordered
  exact oneMul with a, ma

theorem tkH.vm.mul_one (a : Set)
  requires ma : a ∈ ValueMonoid.carrier(Γ)
  shows call2(ValueMonoid.mul(Γ), a, ValueMonoid.one(Γ)) = a
proof
  have oneIn := tkH.vm.one_in with ordered
  have c := tkH.vm.mul_comm at Γ, a, ValueMonoid.one(Γ) with ordered, ma, oneIn
  have o := tkH.vm.one_mul at Γ, a with ordered, ma
  rw c
  exact o

theorem tkH.vm.zero_mul (a : Set)
  requires ma : a ∈ ValueMonoid.carrier(Γ)
  shows call2(ValueMonoid.mul(Γ), ValueMonoid.zero(Γ), a) = ValueMonoid.zero(Γ)
proof
  obtain ⟨mulF, oneIn, zeroIn, ne, assoc, comm, oneMul, zeroMul, rest⟩ := ordered
  exact zeroMul with a, ma

theorem tkH.vm.mul_zero (a : Set)
  requires ma : a ∈ ValueMonoid.carrier(Γ)
  shows call2(ValueMonoid.mul(Γ), a, ValueMonoid.zero(Γ)) = ValueMonoid.zero(Γ)
proof
  have zeroIn := tkH.vm.zero_in with ordered
  have c := tkH.vm.mul_comm at Γ, a, ValueMonoid.zero(Γ) with ordered, ma, zeroIn
  have o := tkH.vm.zero_mul at Γ, a with ordered, ma
  rw c
  exact o

theorem tkH.vm.zero_ne_one
  shows ValueMonoid.zero(Γ) ≠ ValueMonoid.one(Γ)
proof
  obtain ⟨mulF, oneIn, zeroIn, ne, rest⟩ := ordered
  exact ne

theorem tkH.vm.inverse (a : Set)
  requires ma : a ∈ ValueMonoid.carrier(Γ)
  requires nonzero : a ≠ ValueMonoid.zero(Γ)
  shows ∃ b ∈ ValueMonoid.carrier(Γ), call2(ValueMonoid.mul(Γ), a, b) = ValueMonoid.one(Γ)
proof
  obtain ⟨mulF, oneIn, zeroIn, ne, assoc, comm, oneMul, zeroMul, inv, rest⟩ := ordered
  exact inv with a, ma, nonzero

theorem tkH.vm.zero_le (a : Set)
  requires ma : a ∈ ValueMonoid.carrier(Γ)
  shows ValueLe(Γ, ValueMonoid.zero(Γ), a)
proof
  obtain ⟨mulF, oneIn, zeroIn, ne, assoc, comm, oneMul, zeroMul, inv, lin, least, mono⟩ := ordered
  exact least with a, ma

theorem tkH.vm.mul_le_right (a b c : Set)
  requires ma : a ∈ ValueMonoid.carrier(Γ)
  requires mb : b ∈ ValueMonoid.carrier(Γ)
  requires mc : c ∈ ValueMonoid.carrier(Γ)
  requires le : ValueLe(Γ, a, b)
  shows ValueLe(Γ, call2(ValueMonoid.mul(Γ), a, c), call2(ValueMonoid.mul(Γ), b, c))
proof
  obtain ⟨mulF, oneIn, zeroIn, ne, assoc, comm, oneMul, zeroMul, inv, lin, least, mono⟩ := ordered
  exact mono with a, ma, b, mb, c, mc, le

theorem tkH.vm.mul_le_left (a b c : Set)
  requires ma : a ∈ ValueMonoid.carrier(Γ)
  requires mb : b ∈ ValueMonoid.carrier(Γ)
  requires mc : c ∈ ValueMonoid.carrier(Γ)
  requires le : ValueLe(Γ, a, b)
  shows ValueLe(Γ, call2(ValueMonoid.mul(Γ), c, a), call2(ValueMonoid.mul(Γ), c, b))
proof
  have m := tkH.vm.mul_le_right at Γ, a, b, c with ordered, ma, mb, mc, le
  have c1 := tkH.vm.mul_comm at Γ, c, a with ordered, mc, ma
  have c2 := tkH.vm.mul_comm at Γ, c, b with ordered, mc, mb
  rw c1
  rw c2
  exact m

-- a ≤ γ and b ≤ γ, and c ≤ a or c ≤ b, give c ≤ γ.
theorem tkH.vm.le_of_max (a b c γ : Set)
  requires ma : a ∈ ValueMonoid.carrier(Γ)
  requires mb : b ∈ ValueMonoid.carrier(Γ)
  requires mc : c ∈ ValueMonoid.carrier(Γ)
  requires mγ : γ ∈ ValueMonoid.carrier(Γ)
  requires left : ValueLe(Γ, a, γ)
  requires right : ValueLe(Γ, b, γ)
  requires either : ValueLe(Γ, c, a) ∨ ValueLe(Γ, c, b)
  shows ValueLe(Γ, c, γ)
proof
  rcases either with ca | cb
  . exact tkH.vm.le_trans at Γ, c, a, γ with ordered, mc, ma, mγ, ca, left
  . exact tkH.vm.le_trans at Γ, c, b, γ with ordered, mc, mb, mγ, cb, right

theorem tkH.vm.lt_of_le_of_lt (a b c : Set)
  requires ma : a ∈ ValueMonoid.carrier(Γ)
  requires mb : b ∈ ValueMonoid.carrier(Γ)
  requires mc : c ∈ ValueMonoid.carrier(Γ)
  requires first : ValueLe(Γ, a, b)
  requires second : ValueLt(Γ, b, c)
  shows ValueLt(Γ, a, c)
proof
  obtain ⟨bc, bne⟩ := second
  have ac := tkH.vm.le_trans at Γ, a, b, c with ordered, ma, mb, mc, first, bc
  unfold ValueLt
  refine ⟨ac, ?_⟩
  intro same
  rw same at first
  have eq := tkH.vm.le_antisymm at Γ, b, c with ordered, mb, mc, bc, first
  exact bne with eq

theorem tkH.vm.lt_of_lt_of_le (a b c : Set)
  requires ma : a ∈ ValueMonoid.carrier(Γ)
  requires mb : b ∈ ValueMonoid.carrier(Γ)
  requires mc : c ∈ ValueMonoid.carrier(Γ)
  requires first : ValueLt(Γ, a, b)
  requires second : ValueLe(Γ, b, c)
  shows ValueLt(Γ, a, c)
proof
  obtain ⟨ab, ane⟩ := first
  have ac := tkH.vm.le_trans at Γ, a, b, c with ordered, ma, mb, mc, ab, second
  unfold ValueLt
  refine ⟨ac, ?_⟩
  intro same
  rw ← same at second
  have eq := tkH.vm.le_antisymm at Γ, a, b with ordered, ma, mb, ab, second
  exact ane with eq

theorem tkH.vm.lt_of_not_le (a b : Set)
  requires ma : a ∈ ValueMonoid.carrier(Γ)
  requires mb : b ∈ ValueMonoid.carrier(Γ)
  requires notLe : ¬ValueLe(Γ, b, a)
  shows ValueLt(Γ, a, b)
proof
  have tot := tkH.vm.le_total at Γ, a, b with ordered, ma, mb
  rcases tot with ab | ba
  . unfold ValueLt
    refine ⟨ab, ?_⟩
    intro same
    rw same at notLe
    have r := tkH.vm.le_refl at Γ, b with ordered, mb
    exact notLe with r
  . exfalso
    exact notLe with ba

theorem tkH.vm.not_le_of_lt (a b : Set)
  requires ma : a ∈ ValueMonoid.carrier(Γ)
  requires mb : b ∈ ValueMonoid.carrier(Γ)
  requires lt : ValueLt(Γ, a, b)
  shows ¬ValueLe(Γ, b, a)
proof
  intro ba
  obtain ⟨ab, ne⟩ := lt
  have eq := tkH.vm.le_antisymm at Γ, a, b with ordered, ma, mb, ab, ba
  exact ne with eq

-- a · a = 1 forces a = 1.
theorem tkH.vm.sq_eq_one (a : Set)
  requires ma : a ∈ ValueMonoid.carrier(Γ)
  requires square : call2(ValueMonoid.mul(Γ), a, a) = ValueMonoid.one(Γ)
  shows a = ValueMonoid.one(Γ)
proof
  have oneIn := tkH.vm.one_in with ordered
  have oneA := tkH.vm.one_mul at Γ, a with ordered, ma
  have tot := tkH.vm.le_total at Γ, a, ValueMonoid.one(Γ) with ordered, ma, oneIn
  rcases tot with small | large
  . have m := tkH.vm.mul_le_right at Γ, a, ValueMonoid.one(Γ), a with ordered, ma, oneIn, ma, small
    rw square at m
    rw oneA at m
    exact tkH.vm.le_antisymm at Γ, a, ValueMonoid.one(Γ) with ordered, ma, oneIn, small, m
  . have m := tkH.vm.mul_le_right at Γ, ValueMonoid.one(Γ), a, a with ordered, oneIn, ma, ma, large
    rw square at m
    rw oneA at m
    exact tkH.vm.le_antisymm at Γ, a, ValueMonoid.one(Γ) with ordered, ma, oneIn, m, large

theorem tkH.vm.le_mem (a b : Set)
  requires le : ValueLe(Γ, a, b)
  shows a ∈ ValueMonoid.carrier(Γ) ∧ b ∈ ValueMonoid.carrier(Γ)
proof
  obtain ⟨mulF, oneIn, zeroIn, ne, assoc, comm, oneMul, zeroMul, inv, lin, rest⟩ := ordered
  obtain ⟨partial, total⟩ := lin
  obtain ⟨pre, anti⟩ := partial
  obtain ⟨rel, refl, trans⟩ := pre
  unfold ValueLe at le
  exact RelationBetween.bounds with rel, le

theorem tkH.vm.le_of_mul_le (a b c d : Set)
  requires ma : a ∈ ValueMonoid.carrier(Γ)
  requires mb : b ∈ ValueMonoid.carrier(Γ)
  requires mc : c ∈ ValueMonoid.carrier(Γ)
  requires md : d ∈ ValueMonoid.carrier(Γ)
  requires inverse : call2(ValueMonoid.mul(Γ), c, d) = ValueMonoid.one(Γ)
  requires le : ValueLe(Γ, call2(ValueMonoid.mul(Γ), a, c), call2(ValueMonoid.mul(Γ), b, c))
  shows ValueLe(Γ, a, b)
proof
  have ac := tkH.vm.mul_closed at Γ, a, c with ordered, ma, mc
  have bc := tkH.vm.mul_closed at Γ, b, c with ordered, mb, mc
  have step := tkH.vm.mul_le_right at Γ, call2(ValueMonoid.mul(Γ), a, c), call2(ValueMonoid.mul(Γ), b, c), d with ordered, ac, bc, md, le
  have aa := tkH.vm.mul_assoc at Γ, a, c, d with ordered, ma, mc, md
  have ba := tkH.vm.mul_assoc at Γ, b, c, d with ordered, mb, mc, md
  rw aa at step
  rw ba at step
  rw inverse at step
  have a1 := tkH.vm.mul_one at Γ, a with ordered, ma
  have b1 := tkH.vm.mul_one at Γ, b with ordered, mb
  rw a1 at step
  rw b1 at step
  exact step

end TkHValueMonoid

-- Helpers (track H): application of a functional graph of pairs.
theorem tkH.graph.function (G A B : Set)
  requires relation : RelationBetween(G, A, B)
  requires functional : Functional(G)
  shows FunctionBetween(G, domain(G), B)
proof
  unfold FunctionBetween
  refine ⟨?_, functional, ?_⟩
  . unfold RelationBetween
    intros p hp
    have included : G ⊆ A × B := relation
    have shape : p ∈ A × B := included with p, hp
    simp [product.membership] at shape
    obtain ⟨bound, x, hx, y, hy, equation⟩ := shape
    rw equation at hp
    rw equation
    have inDomain := domain.contains at x, y, G with hp
    exact product.pair with inDomain, hy
  . intros x hx
    have some := domain.membership_iff.forward at x, G with hx
    obtain ⟨y, hy⟩ := some
    have bounds := RelationBetween.bounds with relation, hy
    exact ⟨y, bounds.right, hy⟩

theorem tkH.graph.apply (G A B x y : Set)
  requires relation : RelationBetween(G, A, B)
  requires functional : Functional(G)
  requires mapped : relates(G, x, y)
  shows G(x) = y
proof
  have function := tkH.graph.function with relation, functional
  have inDomain := domain.contains at x, y, G with mapped
  exact FunctionBetween.apply_value with function, inDomain, mapped

-- Helpers (track H): the operations of the ring on a subset.
section TkHSubringOps
variable (R S : Set)
hypothesis ring : Ring(R)
hypothesis subset : S ⊆ Ring.carrier(R)

theorem tkH.sub.add (x y : Set)
  requires first : x ∈ S
  requires second : y ∈ S
  shows call2(Ring.add(subringRing(R, S)), x, y) = call2(Ring.add(R), x, y)
proof
  have parts := Ring.parts with ring
  obtain ⟨addF, zeroIn, negF, mulF, oneIn⟩ := IsRing.typing_of_parts with parts
  have sq := product.monotone at S, S, Ring.carrier(R), Ring.carrier(R) with subset, subset
  have pairIn := product.pair at x, y, S, S with first, second
  have e := restrict.domain_apply at Ring.add(R), Ring.carrier(R) × Ring.carrier(R),
    Ring.carrier(R), S × S, (x, y) with addF, sq, pairIn
  unfold subringRing
  ring_projections
  unfold call2
  exact e

theorem tkH.sub.mul (x y : Set)
  requires first : x ∈ S
  requires second : y ∈ S
  shows call2(Ring.mul(subringRing(R, S)), x, y) = call2(Ring.mul(R), x, y)
proof
  have parts := Ring.parts with ring
  obtain ⟨addF, zeroIn, negF, mulF, oneIn⟩ := IsRing.typing_of_parts with parts
  have sq := product.monotone at S, S, Ring.carrier(R), Ring.carrier(R) with subset, subset
  have pairIn := product.pair at x, y, S, S with first, second
  have e := restrict.domain_apply at Ring.mul(R), Ring.carrier(R) × Ring.carrier(R),
    Ring.carrier(R), S × S, (x, y) with mulF, sq, pairIn
  unfold subringRing
  ring_projections
  unfold call2
  exact e

theorem tkH.sub.neg (x : Set)
  requires first : x ∈ S
  shows apply(Ring.neg(subringRing(R, S)), x) = apply(Ring.neg(R), x)
proof
  have parts := Ring.parts with ring
  obtain ⟨addF, zeroIn, negF, mulF, oneIn⟩ := IsRing.typing_of_parts with parts
  have e := restrict.domain_apply at Ring.neg(R), Ring.carrier(R), Ring.carrier(R), S, x
    with negF, subset, first
  unfold subringRing
  ring_projections

end TkHSubringOps

theorem tkH.sub.zero (R S : Set)
  shows Ring.zero(subringRing(R, S)) = Ring.zero(R)
proof
  unfold subringRing
  ring_projections

theorem tkH.sub.one (R S : Set)
  shows Ring.one(subringRing(R, S)) = Ring.one(R)
proof
  unfold subringRing
  ring_projections

-- Helpers (track H): identities of a not necessarily commutative ring.
section TkHRingLaws
variable (R : Set)
hypothesis ring : Ring(R)

theorem tkH.ring.neg_one_mul (x : Set)
  requires member : x ∈ Ring.carrier(R)
  shows call2(Ring.mul(R), apply(Ring.neg(R), Ring.one(R)), x) = apply(Ring.neg(R), x)
proof
  have parts := Ring.parts with ring
  have oneIn := Ring.one_mem with ring
  have nm := IsRing.neg_mul at Ring.carrier(R), Ring.add(R), Ring.zero(R), Ring.neg(R),
    Ring.mul(R), Ring.one(R), Ring.one(R), x with parts, oneIn, member
  have monoid := IsRing.multiplicative with parts
  have lid := IsMonoid.left_identity at Ring.carrier(R), Ring.mul(R), Ring.one(R), x with monoid, member
  rw nm
  rw lid

theorem tkH.ring.neg_one_sq
  shows call2(Ring.mul(R), apply(Ring.neg(R), Ring.one(R)), apply(Ring.neg(R), Ring.one(R))) =
    Ring.one(R)
proof
  have parts := Ring.parts with ring
  have oneIn := Ring.one_mem with ring
  have negIn := Ring.neg_mem at R, Ring.one(R) with ring, oneIn
  have m := tkH.ring.neg_one_mul at R, apply(Ring.neg(R), Ring.one(R)) with ring, negIn
  rw m
  have group := IsAbelianGroup.group with (IsRing.additive with parts)
  exact IsGroup.inverse_involutive at Ring.carrier(R), Ring.add(R), Ring.zero(R), Ring.neg(R),
    Ring.one(R) with group, oneIn

theorem tkH.ring.neg_sub (x y : Set)
  requires first : x ∈ Ring.carrier(R)
  requires second : y ∈ Ring.carrier(R)
  shows apply(Ring.neg(R), Ring.sub(R, y, x)) = Ring.sub(R, x, y)
proof
  have parts := Ring.parts with ring
  have additive := IsRing.additive with parts
  have group := IsAbelianGroup.group with additive
  have negX := Ring.neg_mem at R, x with ring, first
  have io := IsAbelianGroup.inverse_op at Ring.carrier(R), Ring.add(R), Ring.zero(R), Ring.neg(R),
    y, apply(Ring.neg(R), x) with additive, second, negX
  have inv := IsGroup.inverse_involutive at Ring.carrier(R), Ring.add(R), Ring.zero(R), Ring.neg(R),
    x with group, first
  have negY := Ring.neg_mem at R, y with ring, second
  have comm := IsAbelianGroup.commutative with additive
  have c := comm with apply(Ring.neg(R), y), negY, x, first
  unfold Ring.sub
  rw io
  rw inv
  exact c

-- (x + y) + (−x) = y.
theorem tkH.ring.add_sub_cancel_left (x y : Set)
  requires first : x ∈ Ring.carrier(R)
  requires second : y ∈ Ring.carrier(R)
  shows call2(Ring.add(R), call2(Ring.add(R), x, y), apply(Ring.neg(R), x)) = y
proof
  have parts := Ring.parts with ring
  have additive := IsRing.additive with parts
  have comm := IsAbelianGroup.commutative with additive
  have negX := Ring.neg_mem at R, x with ring, first
  have c := comm with x, first, y, second
  have assoc := IsRing.add_associative with parts
  have a := assoc with y, second, x, first, apply(Ring.neg(R), x), negX
  have inv := IsRing.add_inverse_right at Ring.carrier(R), Ring.add(R), Ring.zero(R), Ring.neg(R),
    Ring.mul(R), Ring.one(R), x with parts, first
  have rid := IsRing.add_right_identity at Ring.carrier(R), Ring.add(R), Ring.zero(R), Ring.neg(R),
    Ring.mul(R), Ring.one(R), y with parts, second
  rw c
  rw a
  rw inv
  exact rid

-- (y − x) + x = y.
theorem tkH.ring.sub_add_cancel (x y : Set)
  requires first : x ∈ Ring.carrier(R)
  requires second : y ∈ Ring.carrier(R)
  shows call2(Ring.add(R), Ring.sub(R, y, x), x) = y
proof
  have parts := Ring.parts with ring
  have negX := Ring.neg_mem at R, x with ring, first
  have assoc := IsRing.add_associative with parts
  have a := assoc with y, second, apply(Ring.neg(R), x), negX, x, first
  have inv := IsRing.add_inverse_left at Ring.carrier(R), Ring.add(R), Ring.zero(R), Ring.neg(R),
    Ring.mul(R), Ring.one(R), x with parts, first
  have rid := IsRing.add_right_identity at Ring.carrier(R), Ring.add(R), Ring.zero(R), Ring.neg(R),
    Ring.mul(R), Ring.one(R), y with parts, second
  unfold Ring.sub
  rw a
  rw inv
  exact rid

theorem tkH.ring.add_comm (x y : Set)
  requires first : x ∈ Ring.carrier(R)
  requires second : y ∈ Ring.carrier(R)
  shows call2(Ring.add(R), x, y) = call2(Ring.add(R), y, x)
proof
  have parts := Ring.parts with ring
  have additive := IsRing.additive with parts
  have comm := IsAbelianGroup.commutative with additive
  exact comm with x, first, y, second

end TkHRingLaws

-- Helpers (track H): ℝ≥0 as a value monoid.
theorem tkH.nn.proj
  shows ValueMonoid.carrier(nnRealValues) = nnReals ∧ ValueMonoid.mul(nnRealValues) = nnRealMul ∧
    ValueMonoid.one(nnRealValues) = realOne ∧ ValueMonoid.zero(nnRealValues) = realZero ∧
    ValueMonoid.le(nnRealValues) = nnRealLe
proof
  unfold nnRealValues
  simp [ValueMonoid.mk.carrier, ValueMonoid.mk.mul, ValueMonoid.mk.one, ValueMonoid.mk.zero,
    ValueMonoid.mk.le]

theorem tkH.real.mul_value (a b : Set)
  requires first : a ∈ ℝ
  requires second : b ∈ ℝ
  shows realMulValue(a, b) = (a:R) * (b:R)
proof
  unfold realMulValue
  unfold call2
  rfl

theorem tkH.nn.mul_mem (a b : Set)
  requires first : a ∈ nnReals
  requires second : b ∈ nnReals
  shows realMulValue(a, b) ∈ nnReals
proof
  obtain ⟨aR, a0⟩ := nnReals.membership.forward with first
  obtain ⟨bR, b0⟩ := nnReals.membership.forward with second
  have aReal : Real(a) := aR
  have bReal : Real(b) := bR
  have p := realMulValue.nonnegative at a, b with a0, b0
  have pR := realMulValue.real at a, b
  unfold Real at pR
  apply nnReals.membership.backward
  have e : realMulValue(a, b) = (a:R) * (b:R)
    unfold realMulValue
    unfold call2
    rfl
  rw e
  exact ⟨pR, p⟩

theorem tkH.nn.relation
  shows RelationBetween(nnRealMul, nnReals × nnReals, nnReals)
proof
  unfold RelationBetween
  intros q hq
  have m := nnRealMul.membership.forward with hq
  exact m.left

theorem tkH.nn.functional
  shows Functional(nnRealMul)
proof
  unfold Functional
  intros p r hr s hs
  unfold relates at hr
  unfold relates at hs
  obtain ⟨rIn, rEq⟩ := nnRealMul.membership.forward with hr
  obtain ⟨sIn, sEq⟩ := nnRealMul.membership.forward with hs
  simp [fst.pair, snd.pair] at rEq
  simp [fst.pair, snd.pair] at sEq
  rw rEq
  rw sEq

theorem tkH.nn.relates (a b : Set)
  requires first : a ∈ nnReals
  requires second : b ∈ nnReals
  shows relates(nnRealMul, (a, b), realMulValue(a, b))
proof
  have pm := tkH.nn.mul_mem at a, b with first, second
  unfold relates
  apply nnRealMul.membership.backward
  have ab := product.pair at a, b, nnReals, nnReals with first, second
  have q := product.pair at (a, b), realMulValue(a, b), nnReals × nnReals, nnReals with ab, pm
  refine ⟨q, ?_⟩
  simp [fst.pair, snd.pair]

theorem tkH.nn.mul_apply (a b : Set)
  requires first : a ∈ nnReals
  requires second : b ∈ nnReals
  shows call2(nnRealMul, a, b) = realMulValue(a, b)
proof
  have relation := tkH.nn.relation
  have functional := tkH.nn.functional
  have mapped := tkH.nn.relates at a, b with first, second
  unfold call2
  exact tkH.graph.apply with relation, functional, mapped

theorem tkH.nn.function
  shows FunctionBetween(nnRealMul, nnReals × nnReals, nnReals)
proof
  have relation := tkH.nn.relation
  have functional := tkH.nn.functional
  unfold FunctionBetween
  refine ⟨relation, functional, ?_⟩
  intros p hp
  obtain ⟨bound, a, ha, b, hb, pEq⟩ := product.membership.forward with hp
  rw pEq
  have pm := tkH.nn.mul_mem at a, b with ha, hb
  have mapped := tkH.nn.relates at a, b with ha, hb
  exact ⟨realMulValue(a, b), pm, mapped⟩

theorem tkH.nn.rel_iff (a b : Set)
  requires first : a ∈ nnReals
  requires second : b ∈ nnReals
  shows relates(nnRealLe, a, b) ↔ RealLe(a, b)
proof
  constructor
  . intro r
    unfold relates at r
    obtain ⟨rIn, le⟩ := nnRealLe.membership.forward with r
    simp [fst.pair, snd.pair] at le
    exact le
  . intro le
    unfold relates
    apply nnRealLe.membership.backward
    have ab := product.pair at a, b, nnReals, nnReals with first, second
    refine ⟨ab, ?_⟩
    simp [fst.pair, snd.pair]

theorem tkH.nn.le_iff (a b : Set)
  requires first : a ∈ nnReals
  requires second : b ∈ nnReals
  shows ValueLe(nnRealValues, a, b) ↔ RealLe(a, b)
proof
  obtain ⟨pc, pm, po, pz, pl⟩ := tkH.nn.proj
  unfold ValueLe
  rw pl
  constructor
  . intro r
    unfold relates at r
    obtain ⟨rIn, le⟩ := nnRealLe.membership.forward with r
    simp [fst.pair, snd.pair] at le
    exact le
  . intro le
    unfold relates
    apply nnRealLe.membership.backward
    have ab := product.pair at a, b, nnReals, nnReals with first, second
    refine ⟨ab, ?_⟩
    simp [fst.pair, snd.pair]

theorem tkH.nn.mul_eq (a b : Set)
  requires first : a ∈ nnReals
  requires second : b ∈ nnReals
  shows call2(nnRealMul, a, b) = (a:R) * (b:R) ∧ (a:R) * (b:R) ∈ nnReals
proof
  obtain ⟨aR, a0⟩ := nnReals.membership.forward with first
  obtain ⟨bR, b0⟩ := nnReals.membership.forward with second
  have e := tkH.nn.mul_apply at a, b with first, second
  have m := tkH.real.mul_value at a, b with aR, bR
  have pm := tkH.nn.mul_mem at a, b with first, second
  rw m at e
  rw m at pm
  exact ⟨e, pm⟩

theorem tkH.nn.real (a : Set)
  requires member : a ∈ nnReals
  shows a ∈ ℝ ∧ (0:R) ≤ (a:R)
proof
  exact nnReals.membership.forward with member

-- Section: The value monoid ℝ≥0
-- ℝ≥0 is a linearly ordered commutative group with zero (NNReal's
-- LinearOrderedCommGroupWithZero instance).
theorem nnRealValues.ordered
  shows LinearOrderedCommGroupWithZero(nnRealValues)
proof
  obtain ⟨pc, pm, po, pz, pl⟩ := tkH.nn.proj
  have function := tkH.nn.function
  have oneR : realOne ∈ ℝ by typecheck
  have zeroR : realZero ∈ ℝ by typecheck
  have zeroOne : (0:R) ≤ (1:R) by linarith
  have oneNN : realOne ∈ nnReals
    apply nnReals.membership.backward
    exact ⟨oneR, zeroOne⟩
  have zeroLe : (0:R) ≤ (0:R) by linarith
  have zeroNN : realZero ∈ nnReals
    apply nnReals.membership.backward
    exact ⟨zeroR, zeroLe⟩
  have ne : realZero ≠ realOne
    intro e
    have bad : (0:R) < (1:R) by linarith
    rw e at bad
    have irr := realLess.not_self at realOne
    exact irr with bad
  have leIff : ∀ a ∈ nnReals, ∀ b ∈ nnReals, ValueLe(nnRealValues, a, b) ↔ RealLe(a, b)
    intros a ha b hb
    unfold ValueLe
    rw pl
    exact tkH.nn.rel_iff at a, b with ha, hb
  unfold LinearOrderedCommGroupWithZero
  rw [pc, pm, po, pz, pl]
  refine ⟨function, oneNN, zeroNN, ne, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  . intros a ha b hb c hc
    rw pc at ha
    rw pc at hb
    rw pc at hc
    rw pm
    obtain ⟨aR, a0⟩ := tkH.nn.real at a with ha
    obtain ⟨bR, b0⟩ := tkH.nn.real at b with hb
    obtain ⟨cR, c0⟩ := tkH.nn.real at c with hc
    obtain ⟨e1, m1⟩ := tkH.nn.mul_eq at a, b with ha, hb
    obtain ⟨e2, m2⟩ := tkH.nn.mul_eq at b, c with hb, hc
    rw e1
    rw e2
    obtain ⟨e3, m3⟩ := tkH.nn.mul_eq at (a:R) * (b:R), c with m1, hc
    obtain ⟨e4, m4⟩ := tkH.nn.mul_eq at a, (b:R) * (c:R) with ha, m2
    rw e3
    rw e4
    ring
  . intros a ha b hb
    rw pc at ha
    rw pc at hb
    rw pm
    obtain ⟨aR, a0⟩ := tkH.nn.real at a with ha
    obtain ⟨bR, b0⟩ := tkH.nn.real at b with hb
    obtain ⟨e1, m1⟩ := tkH.nn.mul_eq at a, b with ha, hb
    obtain ⟨e2, m2⟩ := tkH.nn.mul_eq at b, a with hb, ha
    rw e1
    rw e2
    ring
  . intros a ha
    rw pc at ha
    rw pm
    rw po
    obtain ⟨aR, a0⟩ := tkH.nn.real at a with ha
    obtain ⟨e1, m1⟩ := tkH.nn.mul_eq at realOne, a with oneNN, ha
    rw e1
    ring
  . intros a ha
    rw pc at ha
    rw pm
    rw pz
    obtain ⟨aR, a0⟩ := tkH.nn.real at a with ha
    obtain ⟨e1, m1⟩ := tkH.nn.mul_eq at realZero, a with zeroNN, ha
    rw e1
    ring
  . intros a ha nz
    rw pc at ha
    rw pz at nz
    rw pm
    rw po
    rw pc
    obtain ⟨aR, a0⟩ := tkH.nn.real at a with ha
    have aReal : Real(a) := aR
    have nz2 : (a:R) ≠ (0:R) := nz
    have inv := realInvValue.mul_right at a with nz2
    have bR := realInvValue.real at a
    unfold Real at bR
    have b0 : (0:R) ≤ realInvValue(a)
      by_contra neg
      have lt := realLess.of_not_le at (0:R), realInvValue(a) with neg
      have nb : (0:R) ≤ -realInvValue(a) by linarith
      have p := realMulValue.nonnegative at a, -realInvValue(a) with a0, nb
      have e : (a:R) * (-realInvValue(a)) = -((a:R) * realInvValue(a)) by ring
      rw e at p
      rw inv at p
      linarith
    have bNN : realInvValue(a) ∈ nnReals
      apply nnReals.membership.backward
      exact ⟨bR, b0⟩
    obtain ⟨e1, m1⟩ := tkH.nn.mul_eq at a, realInvValue(a) with ha, bNN
    refine ⟨realInvValue(a), bNN, ?_⟩
    rw e1
    exact inv
  . unfold IsLinearOrder
    unfold IsPartialOrder
    unfold IsPreorder
    refine ⟨⟨⟨?_, ?_, ?_⟩, ?_⟩, ?_⟩
    . unfold RelationBetween
      intros q hq
      have m := nnRealLe.membership.forward with hq
      exact m.left
    . unfold ReflexiveOn
      intros a ha
      have r := tkH.nn.rel_iff at a, a with ha, ha
      obtain ⟨aR, a0⟩ := tkH.nn.real at a with ha
      have aReal : Real(a) := aR
      exact r.backward with (RealLe.reflexive at a with aReal)
    . unfold TransitiveOn
      intros a ha b hb c hc ab bc
      have r1 := tkH.nn.rel_iff at a, b with ha, hb
      have r2 := tkH.nn.rel_iff at b, c with hb, hc
      have r3 := tkH.nn.rel_iff at a, c with ha, hc
      have l1 := r1.forward with ab
      have l2 := r2.forward with bc
      exact r3.backward with (RealLe.transitive with l1, l2)
    . unfold AntisymmetricOn
      intros a ha b hb ab ba
      have r1 := tkH.nn.rel_iff at a, b with ha, hb
      have r2 := tkH.nn.rel_iff at b, a with hb, ha
      have l1 := r1.forward with ab
      have l2 := r2.forward with ba
      exact RealLe.antisymmetric with l1, l2
    . intros a ha b hb
      have r1 := tkH.nn.rel_iff at a, b with ha, hb
      have r2 := tkH.nn.rel_iff at b, a with hb, ha
      obtain ⟨aR, a0⟩ := tkH.nn.real at a with ha
      obtain ⟨bR, b0⟩ := tkH.nn.real at b with hb
      by_cases le : (a:R) ≤ (b:R)
      . left
        have c := realLe.characterization.forward with le
        exact r1.backward with c
      . right
        have lt := realLess.of_not_le at a, b with le
        have le2 : (b:R) ≤ (a:R) by linarith
        have c := realLe.characterization.forward with le2
        exact r2.backward with c
  . intros a ha
    rw pc at ha
    rw pz
    have l := leIff with realZero, zeroNN, a, ha
    obtain ⟨aR, a0⟩ := tkH.nn.real at a with ha
    have c := realLe.characterization.forward with a0
    exact l.backward with c
  . intros a ha b hb c hc le
    rw pc at ha
    rw pc at hb
    rw pc at hc
    rw pm
    obtain ⟨aR, a0⟩ := tkH.nn.real at a with ha
    obtain ⟨bR, b0⟩ := tkH.nn.real at b with hb
    obtain ⟨cR, c0⟩ := tkH.nn.real at c with hc
    obtain ⟨e1, m1⟩ := tkH.nn.mul_eq at a, c with ha, hc
    obtain ⟨e2, m2⟩ := tkH.nn.mul_eq at b, c with hb, hc
    rw e1
    rw e2
    have l := leIff with a, ha, b, hb
    have r := l.forward with le
    have r2 := realLe.characterization.backward with r
    have m := realLe.mul_right_of_nonnegative at a, b, c with r2, c0
    have l2 := leIff with (a:R) * (c:R), m1, (b:R) * (c:R), m2
    have c2 := realLe.characterization.forward with m
    exact l2.backward with c2

-- Section: Laws of valuations
section Valuations
variable (R Γ v : Set)
hypothesis valuation : Valuation(R, Γ, v)

-- Helpers (track H): the parts of a valuation.
theorem tkH.val.ring
  shows Ring(R)
proof
  obtain ⟨ring, rest⟩ := valuation
  exact ring

theorem tkH.val.ordered
  shows LinearOrderedCommGroupWithZero(Γ)
proof
  obtain ⟨ring, ordered, rest⟩ := valuation
  exact ordered

theorem tkH.val.mem (x : Set)
  requires member : x ∈ Ring.carrier(R)
  shows v(x) ∈ ValueMonoid.carrier(Γ)
proof
  obtain ⟨ring, ordered, function, rest⟩ := valuation
  exact FunctionBetween.apply_closed with function, member

theorem tkH.val.zero
  shows v(Ring.zero(R)) = ValueMonoid.zero(Γ)
proof
  obtain ⟨ring, ordered, function, zero, rest⟩ := valuation
  exact zero

theorem tkH.val.one
  shows v(Ring.one(R)) = ValueMonoid.one(Γ)
proof
  obtain ⟨ring, ordered, function, zero, one, rest⟩ := valuation
  exact one

theorem tkH.val.mul (x y : Set)
  requires first : x ∈ Ring.carrier(R)
  requires second : y ∈ Ring.carrier(R)
  shows v(call2(Ring.mul(R), x, y)) = call2(ValueMonoid.mul(Γ), v(x), v(y))
proof
  obtain ⟨ring, ordered, function, zero, one, mul, add⟩ := valuation
  exact mul with x, first, y, second

theorem tkH.val.add (x y : Set)
  requires first : x ∈ Ring.carrier(R)
  requires second : y ∈ Ring.carrier(R)
  shows ValueLe(Γ, v(call2(Ring.add(R), x, y)), v(x)) ∨
    ValueLe(Γ, v(call2(Ring.add(R), x, y)), v(y))
proof
  obtain ⟨ring, ordered, function, zero, one, mul, add⟩ := valuation
  exact add with x, first, y, second

theorem tkH.val.neg_one
  shows v(apply(Ring.neg(R), Ring.one(R))) = ValueMonoid.one(Γ)
proof
  have ring := tkH.val.ring with valuation
  have ordered := tkH.val.ordered with valuation
  have oneIn := Ring.one_mem with ring
  have negIn := Ring.neg_mem at R, Ring.one(R) with ring, oneIn
  have sq := tkH.ring.neg_one_sq with ring
  have m := tkH.val.mul at R, Γ, v, apply(Ring.neg(R), Ring.one(R)),
    apply(Ring.neg(R), Ring.one(R)) with valuation, negIn, negIn
  rw sq at m
  have o := tkH.val.one with valuation
  rw o at m
  have vIn := tkH.val.mem at R, Γ, v, apply(Ring.neg(R), Ring.one(R)) with valuation, negIn
  symm at m
  exact tkH.vm.sq_eq_one with ordered, vIn, m

-- Valuation.map_neg, Valuation.map_sub_swap.
theorem Valuation.map_neg (x : Set)
  requires member : x ∈ Ring.carrier(R)
  shows v(apply(Ring.neg(R), x)) = v(x)
proof
  have ring := tkH.val.ring with valuation
  have ordered := tkH.val.ordered with valuation
  have oneIn := Ring.one_mem with ring
  have negIn := Ring.neg_mem at R, Ring.one(R) with ring, oneIn
  have e := tkH.ring.neg_one_mul at R, x with ring, member
  have m := tkH.val.mul at R, Γ, v, apply(Ring.neg(R), Ring.one(R)), x with valuation, negIn, member
  rw e at m
  have n1 := tkH.val.neg_one with valuation
  rw n1 at m
  have vIn := tkH.val.mem at R, Γ, v, x with valuation, member
  have o := tkH.vm.one_mul at Γ, v(x) with ordered, vIn
  rw o at m
  exact m

theorem Valuation.map_sub_swap (x y : Set)
  requires first : x ∈ Ring.carrier(R)
  requires second : y ∈ Ring.carrier(R)
  shows v(Ring.sub(R, x, y)) = v(Ring.sub(R, y, x))
proof
  have ring := tkH.val.ring with valuation
  have e := tkH.ring.neg_sub at R, x, y with ring, first, second
  have sIn := Ring.sub_mem at R, y, x with ring, second, first
  have n := Valuation.map_neg at R, Γ, v, Ring.sub(R, y, x) with valuation, sIn
  rw e at n
  exact n

-- Valuation.map_add_le, Valuation.map_sub_le: values ≤ γ are closed
-- under sums and differences; Valuation.map_add_lt, Valuation.map_sub_lt
-- the same for < γ.
theorem Valuation.map_add_le (x y γ : Set)
  requires first : x ∈ Ring.carrier(R)
  requires second : y ∈ Ring.carrier(R)
  requires left : ValueLe(Γ, v(x), γ)
  requires right : ValueLe(Γ, v(y), γ)
  shows ValueLe(Γ, v(call2(Ring.add(R), x, y)), γ)
proof
  have ring := tkH.val.ring with valuation
  have ordered := tkH.val.ordered with valuation
  have sIn := Ring.add_mem at R, x, y with ring, first, second
  have vx := tkH.val.mem at R, Γ, v, x with valuation, first
  have vy := tkH.val.mem at R, Γ, v, y with valuation, second
  have vs := tkH.val.mem at R, Γ, v, call2(Ring.add(R), x, y) with valuation, sIn
  have tri := tkH.val.add at R, Γ, v, x, y with valuation, first, second
  have bounds := tkH.vm.le_mem at Γ, v(x), γ with ordered, left
  have γIn := bounds.right
  exact tkH.vm.le_of_max at Γ, v(x), v(y), v(call2(Ring.add(R), x, y)), γ with ordered, vx, vy, vs, γIn, left, right, tri

theorem Valuation.map_sub_le (x y γ : Set)
  requires first : x ∈ Ring.carrier(R)
  requires second : y ∈ Ring.carrier(R)
  requires left : ValueLe(Γ, v(x), γ)
  requires right : ValueLe(Γ, v(y), γ)
  shows ValueLe(Γ, v(Ring.sub(R, x, y)), γ)
proof
  have ring := tkH.val.ring with valuation
  have negIn := Ring.neg_mem at R, y with ring, second
  have n := Valuation.map_neg at R, Γ, v, y with valuation, second
  have right2 : ValueLe(Γ, v(apply(Ring.neg(R), y)), γ)
    rw n
    exact right
  unfold Ring.sub
  exact Valuation.map_add_le at R, Γ, v, x, apply(Ring.neg(R), y), γ with valuation, first, negIn, left, right2

theorem Valuation.map_add_lt (x y γ : Set)
  requires first : x ∈ Ring.carrier(R)
  requires second : y ∈ Ring.carrier(R)
  requires left : ValueLt(Γ, v(x), γ)
  requires right : ValueLt(Γ, v(y), γ)
  shows ValueLt(Γ, v(call2(Ring.add(R), x, y)), γ)
proof
  have ring := tkH.val.ring with valuation
  have ordered := tkH.val.ordered with valuation
  have sIn := Ring.add_mem at R, x, y with ring, first, second
  have vx := tkH.val.mem at R, Γ, v, x with valuation, first
  have vy := tkH.val.mem at R, Γ, v, y with valuation, second
  have vs := tkH.val.mem at R, Γ, v, call2(Ring.add(R), x, y) with valuation, sIn
  obtain ⟨leftLe, leftNe⟩ := left
  have bounds := tkH.vm.le_mem at Γ, v(x), γ with ordered, leftLe
  have γIn := bounds.right
  have tri := tkH.val.add at R, Γ, v, x, y with valuation, first, second
  rcases tri with sx | sy
  . exact tkH.vm.lt_of_le_of_lt at Γ, v(call2(Ring.add(R), x, y)), v(x), γ with ordered, vs, vx, γIn, sx, left
  . exact tkH.vm.lt_of_le_of_lt at Γ, v(call2(Ring.add(R), x, y)), v(y), γ with ordered, vs, vy, γIn, sy, right

theorem Valuation.map_sub_lt (x y γ : Set)
  requires first : x ∈ Ring.carrier(R)
  requires second : y ∈ Ring.carrier(R)
  requires left : ValueLt(Γ, v(x), γ)
  requires right : ValueLt(Γ, v(y), γ)
  shows ValueLt(Γ, v(Ring.sub(R, x, y)), γ)
proof
  have ring := tkH.val.ring with valuation
  have negIn := Ring.neg_mem at R, y with ring, second
  have n := Valuation.map_neg at R, Γ, v, y with valuation, second
  have right2 : ValueLt(Γ, v(apply(Ring.neg(R), y)), γ)
    rw n
    exact right
  unfold Ring.sub
  exact Valuation.map_add_lt at R, Γ, v, x, apply(Ring.neg(R), y), γ with valuation, first, negIn, left, right2

-- Valuation.map_add_eq_of_lt_right, Valuation.map_sub_eq_of_lt_right:
-- v(x) < v(y) gives v(x + y) = v(x − y) = v(y).
theorem Valuation.map_add_eq_of_lt_right (x y : Set)
  requires first : x ∈ Ring.carrier(R)
  requires second : y ∈ Ring.carrier(R)
  requires lt : ValueLt(Γ, v(x), v(y))
  shows v(call2(Ring.add(R), x, y)) = v(y)
proof
  have ring := tkH.val.ring with valuation
  have ordered := tkH.val.ordered with valuation
  have sIn := Ring.add_mem at R, x, y with ring, first, second
  have negX := Ring.neg_mem at R, x with ring, first
  have vx := tkH.val.mem at R, Γ, v, x with valuation, first
  have vy := tkH.val.mem at R, Γ, v, y with valuation, second
  have vs := tkH.val.mem at R, Γ, v, call2(Ring.add(R), x, y) with valuation, sIn
  have tri := tkH.val.add at R, Γ, v, x, y with valuation, first, second
  obtain ⟨ltLe, ltNe⟩ := lt
  have upper : ValueLe(Γ, v(call2(Ring.add(R), x, y)), v(y))
    rcases tri with sx | sy
    . exact tkH.vm.le_trans at Γ, v(call2(Ring.add(R), x, y)), v(x), v(y) with ordered, vs, vx, vy, sx, ltLe
    . exact sy
  have back := tkH.ring.add_sub_cancel_left at R, x, y with ring, first, second
  have tri2 := tkH.val.add at R, Γ, v, call2(Ring.add(R), x, y), apply(Ring.neg(R), x) with valuation, sIn, negX
  rw back at tri2
  have nx := Valuation.map_neg at R, Γ, v, x with valuation, first
  rw nx at tri2
  have lower : ValueLe(Γ, v(y), v(call2(Ring.add(R), x, y)))
    rcases tri2 with a | b
    . exact a
    . exfalso
      have bad := tkH.vm.not_le_of_lt at Γ, v(x), v(y) with ordered, vx, vy, lt
      exact bad with b
  exact tkH.vm.le_antisymm at Γ, v(call2(Ring.add(R), x, y)), v(y) with ordered, vs, vy, upper, lower

theorem Valuation.map_sub_eq_of_lt_right (x y : Set)
  requires first : x ∈ Ring.carrier(R)
  requires second : y ∈ Ring.carrier(R)
  requires lt : ValueLt(Γ, v(x), v(y))
  shows v(Ring.sub(R, x, y)) = v(y)
proof
  have ring := tkH.val.ring with valuation
  have negIn := Ring.neg_mem at R, y with ring, second
  have n := Valuation.map_neg at R, Γ, v, y with valuation, second
  have lt2 : ValueLt(Γ, v(x), v(apply(Ring.neg(R), y)))
    rw n
    exact lt
  have e := Valuation.map_add_eq_of_lt_right at R, Γ, v, x, apply(Ring.neg(R), y) with valuation, first, negIn, lt2
  rw n at e
  unfold Ring.sub
  exact e

-- Valuation.map_eq_of_sub_lt: v(y − x) < v(x) gives v(y) = v(x).
theorem Valuation.map_eq_of_sub_lt (x y : Set)
  requires first : x ∈ Ring.carrier(R)
  requires second : y ∈ Ring.carrier(R)
  requires lt : ValueLt(Γ, v(Ring.sub(R, y, x)), v(x))
  shows v(y) = v(x)
proof
  have ring := tkH.val.ring with valuation
  have dIn := Ring.sub_mem at R, y, x with ring, second, first
  have e := Valuation.map_add_eq_of_lt_right at R, Γ, v, Ring.sub(R, y, x), x with valuation, dIn, first, lt
  have c := tkH.ring.sub_add_cancel at R, x, y with ring, first, second
  rw c at e
  exact e

-- Valuation.map_one_add_of_lt, Valuation.map_one_sub_of_lt.
theorem Valuation.map_one_add_of_lt (x : Set)
  requires member : x ∈ Ring.carrier(R)
  requires lt : ValueLt(Γ, v(x), ValueMonoid.one(Γ))
  shows v(call2(Ring.add(R), Ring.one(R), x)) = ValueMonoid.one(Γ)
proof
  have ring := tkH.val.ring with valuation
  have oneIn := Ring.one_mem with ring
  have o := tkH.val.one with valuation
  have lt2 : ValueLt(Γ, v(x), v(Ring.one(R)))
    rw o
    exact lt
  have e := Valuation.map_add_eq_of_lt_right at R, Γ, v, x, Ring.one(R) with valuation, member, oneIn, lt2
  have c := tkH.ring.add_comm at R, Ring.one(R), x with ring, oneIn, member
  rw c
  rw e
  exact o

theorem Valuation.map_one_sub_of_lt (x : Set)
  requires member : x ∈ Ring.carrier(R)
  requires lt : ValueLt(Γ, v(x), ValueMonoid.one(Γ))
  shows v(Ring.sub(R, Ring.one(R), x)) = ValueMonoid.one(Γ)
proof
  have ring := tkH.val.ring with valuation
  have oneIn := Ring.one_mem with ring
  have o := tkH.val.one with valuation
  have lt2 : ValueLt(Γ, v(x), v(Ring.one(R)))
    rw o
    exact lt
  have e := Valuation.map_sub_eq_of_lt_right at R, Γ, v, x, Ring.one(R) with valuation, member, oneIn, lt2
  have sw := Valuation.map_sub_swap at R, Γ, v, Ring.one(R), x with valuation, oneIn, member
  rw sw
  rw e
  exact o

-- Valuation.map_sum_lt': a finite sum of terms of value < γ, γ ≠ 0, has
-- value < γ.
theorem Valuation.map_sum_lt (V w γ : Set)
  requires comm : CommRing(R)
  requires finite : Finite(V)
  requires terms : FunctionBetween(w, V, Ring.carrier(R))
  requires nonzero : γ ≠ ValueMonoid.zero(Γ)
  requires bound : ∀ i ∈ V, ValueLt(Γ, v(w(i)), γ)
  shows ValueLt(Γ, v(finiteRingSum(V, Ring.carrier(R), Ring.add(R), Ring.zero(R),
    Ring.neg(R), Ring.mul(R), Ring.one(R), w)), γ)
proof
  sorry

-- The integers form a subring and the ball sets are ideals of it
-- (Valuation.integer, Valuation.leIdeal, Valuation.ltSubmodule).
theorem valuationInteger.subring
  shows Subring(R, valuationInteger(R, Γ, v))
proof
  have ring := tkH.val.ring with valuation
  have ordered := tkH.val.ordered with valuation
  have oneIn := tkH.vm.one_in with ordered
  have zeroR := Ring.zero_mem with ring
  have oneR := Ring.one_mem with ring
  unfold Subring
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩
  . intros x hx
    have m := valuationInteger.membership.forward with hx
    exact m.left
  . apply valuationInteger.membership.backward
    have z := tkH.val.zero with valuation
    have zl := tkH.vm.zero_le at Γ, ValueMonoid.one(Γ) with ordered, oneIn
    rw z
    exact ⟨zeroR, zl⟩
  . apply valuationInteger.membership.backward
    have o := tkH.val.one with valuation
    have r := tkH.vm.le_refl at Γ, ValueMonoid.one(Γ) with ordered, oneIn
    rw o
    exact ⟨oneR, r⟩
  . intros x hx
    obtain ⟨xR, xle⟩ := valuationInteger.membership.forward with hx
    apply valuationInteger.membership.backward
    have negIn := Ring.neg_mem at R, x with ring, xR
    have n := Valuation.map_neg at R, Γ, v, x with valuation, xR
    rw n
    exact ⟨negIn, xle⟩
  . intros x hx y hy
    obtain ⟨xR, xle⟩ := valuationInteger.membership.forward with hx
    obtain ⟨yR, yle⟩ := valuationInteger.membership.forward with hy
    apply valuationInteger.membership.backward
    have sIn := Ring.add_mem at R, x, y with ring, xR, yR
    have le := Valuation.map_add_le at R, Γ, v, x, y, ValueMonoid.one(Γ) with valuation, xR, yR, xle, yle
    exact ⟨sIn, le⟩
  . intros x hx y hy
    obtain ⟨xR, xle⟩ := valuationInteger.membership.forward with hx
    obtain ⟨yR, yle⟩ := valuationInteger.membership.forward with hy
    apply valuationInteger.membership.backward
    have pIn := Ring.mul_mem at R, x, y with ring, xR, yR
    have vx := tkH.val.mem at R, Γ, v, x with valuation, xR
    have vy := tkH.val.mem at R, Γ, v, y with valuation, yR
    have m := tkH.val.mul at R, Γ, v, x, y with valuation, xR, yR
    have step := tkH.vm.mul_le_left at Γ, v(y), ValueMonoid.one(Γ), v(x) with ordered, vy, oneIn, vx, yle
    have o := tkH.vm.mul_one at Γ, v(x) with ordered, vx
    rw o at step
    have pv := tkH.vm.mul_closed at Γ, v(x), v(y) with ordered, vx, vy
    have le := tkH.vm.le_trans at Γ, call2(ValueMonoid.mul(Γ), v(x), v(y)), v(x), ValueMonoid.one(Γ) with ordered, pv, vx, oneIn, step, xle
    rw m
    exact ⟨pIn, le⟩

theorem valuationLeIdeal.ideal (γ : Set)
  requires comm : CommRing(R)
  requires member : γ ∈ ValueMonoid.carrier(Γ)
  requires small : ValueLe(Γ, γ, ValueMonoid.one(Γ))
  shows Ideal(subringRing(R, valuationInteger(R, Γ, v)), valuationLeIdeal(R, Γ, v, γ)) ∧
    Ideal(subringRing(R, valuationInteger(R, Γ, v)), valuationLtIdeal(R, Γ, v, γ))
proof
  sorry

-- Helpers (track H): the graph of the pullback.
theorem tkH.comap.functional (S f : Set)
  shows Functional(valuationComap(S, v, f))
proof
  unfold Functional
  intros a b hab c hac
  unfold relates at hab
  unfold relates at hac
  obtain ⟨x, hx, ex⟩ := valuationComap.membership.forward with hab
  obtain ⟨y, hy, ey⟩ := valuationComap.membership.forward with hac
  obtain ⟨xa, vb⟩ := orderedPair.injective with ex
  obtain ⟨ya, vc⟩ := orderedPair.injective with ey
  rw ← vb
  rw ← vc
  rw xa
  rw ya

theorem tkH.comap.relates (S f x : Set)
  requires member : x ∈ Ring.carrier(S)
  shows relates(valuationComap(S, v, f), x, v(f(x)))
proof
  unfold relates
  apply valuationComap.membership.backward
  exact ⟨x, member, rfl⟩

theorem tkH.comap.relation (S f : Set)
  shows RelationBetween(valuationComap(S, v, f), Ring.carrier(S), range(valuationComap(S, v, f)))
proof
  unfold RelationBetween
  intros p hp
  obtain ⟨x, hx, ex⟩ := valuationComap.membership.forward with hp
  rw ← ex
  rw ← ex at hp
  have inRange := range.contains with hp
  exact product.pair with hx, inRange

-- Valuation.comap is a valuation, with value v(f(x)) (Valuation.comap_apply).
theorem valuationComap.apply (S f x : Set)
  requires member : x ∈ Ring.carrier(S)
  shows valuationComap(S, v, f)(x) = v(f(x))
proof
  have relation := tkH.comap.relation at R, Γ, v, S, f with valuation
  have functional := tkH.comap.functional at R, Γ, v, S, f with valuation
  have mapped := tkH.comap.relates at R, Γ, v, S, f, x with valuation, member
  exact tkH.graph.apply with relation, functional, mapped

theorem valuationComap.valuation (S f : Set)
  requires hom : (f : S →+* R)
  shows Valuation(S, Γ, valuationComap(S, v, f))
proof
  obtain ⟨ringS, ringR, fF, f0, f1, fneg, fadd, fmul⟩ := hom
  have ordered := tkH.val.ordered with valuation
  have value : ∀ x ∈ Ring.carrier(S), valuationComap(S, v, f)(x) = v(f(x))
    intros x hx
    exact valuationComap.apply at R, Γ, v, S, f, x with valuation, hx
  have zeroS := Ring.zero_mem with ringS
  have oneS := Ring.one_mem with ringS
  have function : FunctionBetween(valuationComap(S, v, f), Ring.carrier(S), ValueMonoid.carrier(Γ))
    unfold FunctionBetween
    have functional := tkH.comap.functional at R, Γ, v, S, f with valuation
    refine ⟨?_, functional, ?_⟩
    . unfold RelationBetween
      intros p hp
      obtain ⟨x, hx, ex⟩ := valuationComap.membership.forward with hp
      rw ← ex
      have fx := FunctionBetween.apply_closed with fF, hx
      have vx := tkH.val.mem at R, Γ, v, f(x) with valuation, fx
      exact product.pair with hx, vx
    . intros x hx
      have fx := FunctionBetween.apply_closed with fF, hx
      have vx := tkH.val.mem at R, Γ, v, f(x) with valuation, fx
      have mapped := tkH.comap.relates at R, Γ, v, S, f, x with valuation, hx
      exact ⟨v(f(x)), vx, mapped⟩
  unfold Valuation
  refine ⟨ringS, ordered, function, ?_, ?_, ?_, ?_⟩
  . have e := value with Ring.zero(S), zeroS
    rw e
    rw f0
    exact tkH.val.zero with valuation
  . have e := value with Ring.one(S), oneS
    rw e
    rw f1
    exact tkH.val.one with valuation
  . intros x hx y hy
    have xy := Ring.mul_mem at S, x, y with ringS, hx, hy
    have e := value with call2(Ring.mul(S), x, y), xy
    have ex := value with x, hx
    have ey := value with y, hy
    rw e
    rw ex
    rw ey
    have m := fmul with x, hx, y, hy
    rw m
    have fx := FunctionBetween.apply_closed with fF, hx
    have fy := FunctionBetween.apply_closed with fF, hy
    exact tkH.val.mul at R, Γ, v, f(x), f(y) with valuation, fx, fy
  . intros x hx y hy
    have xy := Ring.add_mem at S, x, y with ringS, hx, hy
    have e := value with call2(Ring.add(S), x, y), xy
    have ex := value with x, hx
    have ey := value with y, hy
    rw e
    rw ex
    rw ey
    have a := fadd with x, hx, y, hy
    rw a
    have fx := FunctionBetween.apply_closed with fF, hx
    have fy := FunctionBetween.apply_closed with fF, hy
    exact tkH.val.add at R, Γ, v, f(x), f(y) with valuation, fx, fy

end Valuations

-- Section: Valuations on fields
section FieldValuations
variable (K Γ v : Set)
hypothesis valued : Valued(K, Γ, v)

-- Helpers (track H): the parts of a valued field.
theorem tkH.fv.valuation
  shows Valuation(K, Γ, v)
proof
  obtain ⟨field, comm, valuation⟩ := valued
  exact valuation

theorem tkH.fv.inverse (x : Set)
  requires member : x ∈ Ring.carrier(K)
  requires nonzero : x ≠ Ring.zero(K)
  shows ∃ y ∈ Ring.carrier(K), call2(Ring.mul(K), x, y) = Ring.one(K)
proof
  obtain ⟨field, comm, valuation⟩ := valued
  have parts := Field.parts with field
  obtain ⟨y, hy⟩ := IsField.inverse_exists with parts, member, nonzero
  obtain ⟨xIn, yIn, left, right⟩ := hy
  exact ⟨y, yIn, right⟩

-- Valuation.pos_iff, Valuation.zero_iff: v(x) = 0 only at x = 0.
theorem Valuation.eq_zero_iff (x : Set)
  requires member : x ∈ Ring.carrier(K)
  shows v(x) = ValueMonoid.zero(Γ) ↔ x = Ring.zero(K)
proof
  have valuation := tkH.fv.valuation with valued
  have ordered := tkH.val.ordered with valuation
  constructor
  . intro zero
    by_contra nonzero
    obtain ⟨y, yIn, inv⟩ := tkH.fv.inverse at K, Γ, v, x with valued, member, nonzero
    have m := tkH.val.mul at K, Γ, v, x, y with valuation, member, yIn
    rw inv at m
    rw zero at m
    have o := tkH.val.one with valuation
    rw o at m
    have vy := tkH.val.mem at K, Γ, v, y with valuation, yIn
    have z := tkH.vm.zero_mul at Γ, v(y) with ordered, vy
    rw z at m
    have ne := tkH.vm.zero_ne_one with ordered
    symm at m
    exact ne with m
  . intro zero
    rw zero
    exact tkH.val.zero with valuation

-- Valuation.map_inv: v(x⁻¹) v(x) = 1 for x ≠ 0.
theorem Valuation.map_inv (x y : Set)
  requires first : x ∈ Ring.carrier(K)
  requires second : y ∈ Ring.carrier(K)
  requires inverse : call2(Ring.mul(K), x, y) = Ring.one(K)
  shows call2(ValueMonoid.mul(Γ), v(y), v(x)) = ValueMonoid.one(Γ)
proof
  have valuation := tkH.fv.valuation with valued
  have ordered := tkH.val.ordered with valuation
  have m := tkH.val.mul at K, Γ, v, x, y with valuation, first, second
  rw inverse at m
  have o := tkH.val.one with valuation
  rw o at m
  have vx := tkH.val.mem at K, Γ, v, x with valuation, first
  have vy := tkH.val.mem at K, Γ, v, y with valuation, second
  have c := tkH.vm.mul_comm at Γ, v(y), v(x) with ordered, vy, vx
  rw c
  symm
  exact m

-- Valuation.valuationSubring: the integers of a valuation on a field are
-- a valuation subring.
theorem valuationInteger.valuation_subring
  shows ValuationSubring(K, valuationInteger(K, Γ, v))
proof
  obtain ⟨field, comm, valuation⟩ := valued
  have ordered := tkH.val.ordered with valuation
  have oneIn := tkH.vm.one_in with ordered
  have sub := valuationInteger.subring at K, Γ, v with valuation
  unfold ValuationSubring
  refine ⟨field, comm, sub, ?_⟩
  intros x hx
  have vx := tkH.val.mem at K, Γ, v, x with valuation, hx
  by_cases small : ValueLe(Γ, v(x), ValueMonoid.one(Γ))
  . left
    apply valuationInteger.membership.backward
    exact ⟨hx, small⟩
  . right
    have nonzero : x ≠ Ring.zero(K)
      intro same
      have z := tkH.val.zero with valuation
      rw same at small
      rw z at small
      have zl := tkH.vm.zero_le at Γ, ValueMonoid.one(Γ) with ordered, oneIn
      exact small with zl
    obtain ⟨y, yIn, inv⟩ := tkH.fv.inverse at K, Γ, v, x with valued, hx, nonzero
    have vy := tkH.val.mem at K, Γ, v, y with valuation, yIn
    have m := tkH.val.mul at K, Γ, v, x, y with valuation, hx, yIn
    rw inv at m
    have o := tkH.val.one with valuation
    rw o at m
    have yle : ValueLe(Γ, v(y), ValueMonoid.one(Γ))
      by_contra large
      have lt := tkH.vm.lt_of_not_le at Γ, ValueMonoid.one(Γ), v(y) with ordered, oneIn, vy, large
      obtain ⟨ltLe, ltNe⟩ := lt
      have step := tkH.vm.mul_le_left at Γ, ValueMonoid.one(Γ), v(y), v(x) with ordered, oneIn, vy, vx, ltLe
      have mo := tkH.vm.mul_one at Γ, v(x) with ordered, vx
      rw mo at step
      rw ← m at step
      exact small with step
    have yI : y ∈ valuationInteger(K, Γ, v)
      apply valuationInteger.membership.backward
      exact ⟨yIn, yle⟩
    exact ⟨y, yI, inv⟩

theorem tkH.fv.int_subset
  shows valuationInteger(K, Γ, v) ⊆ Ring.carrier(K)
proof
  intros x hx
  have m := valuationInteger.membership.forward with hx
  exact m.left

-- Valuation.integer.integers: in the integers, the units are the elements
-- of value 1 (Valuation.Integers.isUnit_iff_valuation_eq_one) and the
-- maximal ideal is {v < 1} (Valuation.mem_maximalIdeal_iff,
-- Valuation.mem_unitGroup_iff).
theorem valuationInteger.unit_iff (x : Set)
  requires member : x ∈ valuationInteger(K, Γ, v)
  shows RingUnit(subringRing(K, valuationInteger(K, Γ, v)), x) ↔ v(x) = ValueMonoid.one(Γ)
proof
  obtain ⟨field, comm, valuation⟩ := valued
  have ring := CommRing.to_ring with comm
  have ordered := tkH.val.ordered with valuation
  have oneIn := tkH.vm.one_in with ordered
  have subset := tkH.fv.int_subset at K, Γ, v with valued
  obtain ⟨xK, xle⟩ := valuationInteger.membership.forward with member
  have vx := tkH.val.mem at K, Γ, v, x with valuation, xK
  have carrier := subringRing.carrierOf at K, valuationInteger(K, Γ, v)
  have o1 := tkH.sub.one at K, valuationInteger(K, Γ, v)
  constructor
  . intro unit
    obtain ⟨xs, b, bIn, xb, bx⟩ := unit
    rw carrier at bIn
    have sm := tkH.sub.mul at K, valuationInteger(K, Γ, v), x, b with ring, subset, member, bIn
    rw sm at xb
    rw o1 at xb
    obtain ⟨bK, ble⟩ := valuationInteger.membership.forward with bIn
    have vb := tkH.val.mem at K, Γ, v, b with valuation, bK
    have m := tkH.val.mul at K, Γ, v, x, b with valuation, xK, bK
    rw xb at m
    have o := tkH.val.one with valuation
    rw o at m
    have step := tkH.vm.mul_le_left at Γ, v(b), ValueMonoid.one(Γ), v(x) with ordered, vb, oneIn, vx, ble
    have mo := tkH.vm.mul_one at Γ, v(x) with ordered, vx
    rw mo at step
    rw ← m at step
    exact tkH.vm.le_antisymm at Γ, v(x), ValueMonoid.one(Γ) with ordered, vx, oneIn, xle, step
  . intro one
    have nonzero : x ≠ Ring.zero(K)
      intro same
      have z := tkH.val.zero with valuation
      rw same at one
      rw z at one
      have ne := tkH.vm.zero_ne_one with ordered
      exact ne with one
    obtain ⟨y, yK, inv⟩ := tkH.fv.inverse at K, Γ, v, x with valued, xK, nonzero
    have vy := tkH.val.mem at K, Γ, v, y with valuation, yK
    have m := tkH.val.mul at K, Γ, v, x, y with valuation, xK, yK
    rw inv at m
    have o := tkH.val.one with valuation
    rw o at m
    rw one at m
    have om := tkH.vm.one_mul at Γ, v(y) with ordered, vy
    rw om at m
    have yle : ValueLe(Γ, v(y), ValueMonoid.one(Γ))
      rw ← m
      exact tkH.vm.le_refl at Γ, ValueMonoid.one(Γ) with ordered, oneIn
    have yI : y ∈ valuationInteger(K, Γ, v)
      apply valuationInteger.membership.backward
      exact ⟨yK, yle⟩
    have sm1 := tkH.sub.mul at K, valuationInteger(K, Γ, v), x, y with ring, subset, member, yI
    have sm2 := tkH.sub.mul at K, valuationInteger(K, Γ, v), y, x with ring, subset, yI, member
    have parts := CommRing.parts with comm
    have c := IsCommRing.mul_comm at Ring.carrier(K), Ring.add(K), Ring.zero(K), Ring.neg(K), Ring.mul(K), Ring.one(K), y, x with parts, yK, xK
    have yS : y ∈ Ring.carrier(subringRing(K, valuationInteger(K, Γ, v)))
      rw carrier
      exact yI
    have xS : x ∈ Ring.carrier(subringRing(K, valuationInteger(K, Γ, v)))
      rw carrier
      exact member
    unfold RingUnit
    refine ⟨xS, y, yS, ?_, ?_⟩
    . rw sm1
      rw o1
      exact inv
    . rw sm2
      rw o1
      rw c
      exact inv

theorem tkH.fv.units_iff (x : Set)
  requires member : x ∈ valuationInteger(K, Γ, v)
  shows x ∈ valuationSubringUnits(K, valuationInteger(K, Γ, v)) ↔ v(x) = ValueMonoid.one(Γ)
proof
  obtain ⟨field, comm, valuation⟩ := valued
  have ordered := tkH.val.ordered with valuation
  have oneIn := tkH.vm.one_in with ordered
  obtain ⟨xK, xle⟩ := valuationInteger.membership.forward with member
  have vx := tkH.val.mem at K, Γ, v, x with valuation, xK
  constructor
  . intro unit
    obtain ⟨xI, b, bIn, xb⟩ := valuationSubringUnits.membership.forward with unit
    obtain ⟨bK, ble⟩ := valuationInteger.membership.forward with bIn
    have vb := tkH.val.mem at K, Γ, v, b with valuation, bK
    have m := tkH.val.mul at K, Γ, v, x, b with valuation, xK, bK
    rw xb at m
    have o := tkH.val.one with valuation
    rw o at m
    have step := tkH.vm.mul_le_left at Γ, v(b), ValueMonoid.one(Γ), v(x) with ordered, vb, oneIn, vx, ble
    have mo := tkH.vm.mul_one at Γ, v(x) with ordered, vx
    rw mo at step
    rw ← m at step
    exact tkH.vm.le_antisymm at Γ, v(x), ValueMonoid.one(Γ) with ordered, vx, oneIn, xle, step
  . intro one
    have nonzero : x ≠ Ring.zero(K)
      intro same
      have z := tkH.val.zero with valuation
      rw same at one
      rw z at one
      have ne := tkH.vm.zero_ne_one with ordered
      exact ne with one
    obtain ⟨y, yK, inv⟩ := tkH.fv.inverse at K, Γ, v, x with valued, xK, nonzero
    have vy := tkH.val.mem at K, Γ, v, y with valuation, yK
    have m := tkH.val.mul at K, Γ, v, x, y with valuation, xK, yK
    rw inv at m
    have o := tkH.val.one with valuation
    rw o at m
    rw one at m
    have om := tkH.vm.one_mul at Γ, v(y) with ordered, vy
    rw om at m
    have yle : ValueLe(Γ, v(y), ValueMonoid.one(Γ))
      rw ← m
      exact tkH.vm.le_refl at Γ, ValueMonoid.one(Γ) with ordered, oneIn
    have yI : y ∈ valuationInteger(K, Γ, v)
      apply valuationInteger.membership.backward
      exact ⟨yK, yle⟩
    apply valuationSubringUnits.membership.backward
    exact ⟨member, y, yI, inv⟩

theorem valuationInteger.maximal_ideal
  shows LocalRing(subringRing(K, valuationInteger(K, Γ, v))) ∧
    localMaximalIdeal(subringRing(K, valuationInteger(K, Γ, v))) = valuationMaximal(K, Γ, v)
proof
  have valuation := tkH.fv.valuation with valued
  obtain ⟨field, comm, valuation2⟩ := valued
  have ring := CommRing.to_ring with comm
  have ordered := tkH.val.ordered with valuation
  have oneIn := tkH.vm.one_in with ordered
  have subset := tkH.fv.int_subset at K, Γ, v with valued
  have sub := valuationInteger.subring at K, Γ, v with valuation
  have carrier := subringRing.carrierOf at K, valuationInteger(K, Γ, v)
  have subComm := subringRing.comm_ring at K, valuationInteger(K, Γ, v) with comm, sub
  have local : LocalRing(subringRing(K, valuationInteger(K, Γ, v)))
    unfold LocalRing
    refine ⟨subComm, ?_, ?_⟩
    . have z := tkH.sub.zero at K, valuationInteger(K, Γ, v)
      have o := tkH.sub.one at K, valuationInteger(K, Γ, v)
      rw z
      rw o
      have parts := Field.parts with field
      have nt := IsField.nontrivial with parts
      obtain ⟨z1, o1, ne⟩ := nt
      exact ne
    . intros a ha b hb sum
      rw carrier at ha
      rw carrier at hb
      have sa := tkH.sub.add at K, valuationInteger(K, Γ, v), a, b with ring, subset, ha, hb
      rw sa at sum
      have o := tkH.sub.one at K, valuationInteger(K, Γ, v)
      rw o at sum
      obtain ⟨aK, ale⟩ := valuationInteger.membership.forward with ha
      obtain ⟨bK, ble⟩ := valuationInteger.membership.forward with hb
      have va := tkH.val.mem at K, Γ, v, a with valuation, aK
      have vb := tkH.val.mem at K, Γ, v, b with valuation, bK
      have tri := tkH.val.add at K, Γ, v, a, b with valuation, aK, bK
      rw sum at tri
      have vo := tkH.val.one with valuation
      rw vo at tri
      rcases tri with ga | gb
      . left
        have e := tkH.vm.le_antisymm at Γ, v(a), ValueMonoid.one(Γ) with ordered, va, oneIn, ale, ga
        have u := valuationInteger.unit_iff at K, Γ, v, a with valued, ha
        exact u.backward with e
      . right
        have e := tkH.vm.le_antisymm at Γ, v(b), ValueMonoid.one(Γ) with ordered, vb, oneIn, ble, gb
        have u := valuationInteger.unit_iff at K, Γ, v, b with valued, hb
        exact u.backward with e
  refine ⟨local, ?_⟩
  unfold localMaximalIdeal
  unfold ringNonunits
  rw carrier
  ext x
  constructor
  . intro hx
    simp at hx
    obtain ⟨xI, notUnit⟩ := hx
    obtain ⟨xK, xle⟩ := valuationInteger.membership.forward with xI
    apply valuationMaximal.membership.backward
    refine ⟨xK, xle, ?_⟩
    intro one
    have u := valuationInteger.unit_iff at K, Γ, v, x with valued, xI
    have unit := u.backward with one
    have inUnits : x ∈ ringUnits(subringRing(K, valuationInteger(K, Γ, v)))
      apply ringUnits.membership.backward
      rw carrier
      exact ⟨xI, unit⟩
    exact notUnit with inUnits
  . intro hx
    obtain ⟨xK, xlt⟩ := valuationMaximal.membership.forward with hx
    obtain ⟨xle, xne⟩ := xlt
    have xI : x ∈ valuationInteger(K, Γ, v)
      apply valuationInteger.membership.backward
      exact ⟨xK, xle⟩
    apply difference.membership.backward
    refine ⟨xI, ?_⟩
    intro inUnits
    obtain ⟨xs, unit⟩ := ringUnits.membership.forward with inUnits
    have u := valuationInteger.unit_iff at K, Γ, v, x with valued, xI
    have one := u.forward with unit
    exact xne with one

-- Valuation.Integers.mem_of_integral: the integers are integrally closed
-- in K.
theorem valuationInteger.mem_of_integral (x : Set)
  requires member : x ∈ Ring.carrier(K)
  requires integral : IntegralElement(Algebra.mk(subringRing(K, valuationInteger(K, Γ, v)), K,
    identity(valuationInteger(K, Γ, v))), x)
  shows x ∈ valuationInteger(K, Γ, v)
proof
  sorry

theorem tkH.fv.le_iff_mul (x y z : Set)
  requires mx : x ∈ Ring.carrier(K)
  requires my : y ∈ Ring.carrier(K)
  requires mz : z ∈ Ring.carrier(K)
  requires inverse : call2(Ring.mul(K), y, z) = Ring.one(K)
  shows ValueLe(Γ, v(x), v(y)) ↔ ValueLe(Γ, v(call2(Ring.mul(K), x, z)), ValueMonoid.one(Γ))
proof
  have valuation := tkH.fv.valuation with valued
  have ordered := tkH.val.ordered with valuation
  have vx := tkH.val.mem at K, Γ, v, x with valuation, mx
  have vy := tkH.val.mem at K, Γ, v, y with valuation, my
  have vz := tkH.val.mem at K, Γ, v, z with valuation, mz
  have myz := tkH.val.mul at K, Γ, v, y, z with valuation, my, mz
  rw inverse at myz
  have o := tkH.val.one with valuation
  rw o at myz
  have mxz := tkH.val.mul at K, Γ, v, x, z with valuation, mx, mz
  rw mxz
  constructor
  . intro le
    have step := tkH.vm.mul_le_right at Γ, v(x), v(y), v(z) with ordered, vx, vy, vz, le
    rw ← myz at step
    exact step
  . intro le
    have le2 : ValueLe(Γ, call2(ValueMonoid.mul(Γ), v(x), v(z)), call2(ValueMonoid.mul(Γ), v(y), v(z)))
      rw ← myz
      exact le
    have c := tkH.vm.mul_comm at Γ, v(z), v(y) with ordered, vz, vy
    have inv2 : call2(ValueMonoid.mul(Γ), v(z), v(y)) = ValueMonoid.one(Γ)
      rw c
      symm
      exact myz
    exact tkH.vm.le_of_mul_le at Γ, v(x), v(y), v(z), v(y) with ordered, vx, vy, vz, vy, inv2, le2

theorem tkH.fv.le_zero_iff (x : Set)
  requires mx : x ∈ Ring.carrier(K)
  shows ValueLe(Γ, v(x), v(Ring.zero(K))) ↔ x = Ring.zero(K)
proof
  have valuation := tkH.fv.valuation with valued
  have ordered := tkH.val.ordered with valuation
  have vx := tkH.val.mem at K, Γ, v, x with valuation, mx
  have z := tkH.val.zero with valuation
  have zeroIn := tkH.vm.zero_in with ordered
  rw z
  have ez := Valuation.eq_zero_iff at K, Γ, v, x with valued, mx
  constructor
  . intro le
    have zl := tkH.vm.zero_le at Γ, v(x) with ordered, vx
    have e := tkH.vm.le_antisymm at Γ, v(x), ValueMonoid.zero(Γ) with ordered, vx, zeroIn, le, zl
    exact ez.forward with e
  . intro same
    have e := ez.backward with same
    rw e
    exact tkH.vm.le_refl at Γ, ValueMonoid.zero(Γ) with ordered, zeroIn

theorem ValuationEquiv.of_le_one (Δ w : Set)
  requires other : Valued(K, Δ, w)
  requires same : ∀ x ∈ Ring.carrier(K),
    ValueLe(Γ, v(x), ValueMonoid.one(Γ)) ↔ ValueLe(Δ, w(x), ValueMonoid.one(Δ))
  shows ValuationEquiv(K, Γ, v, Δ, w)
proof
  have vv := tkH.fv.valuation with valued
  have ww := tkH.fv.valuation at K, Δ, w with other
  unfold ValuationEquiv
  refine ⟨vv, ww, ?_⟩
  intros x hx y hy
  by_cases yz : y = Ring.zero(K)
  . rw yz
    have a := tkH.fv.le_zero_iff at K, Γ, v, x with valued, hx
    have b := tkH.fv.le_zero_iff at K, Δ, w, x with other, hx
    rw a
    rw b
  . obtain ⟨z, zK, inv⟩ := tkH.fv.inverse at K, Γ, v, y with valued, hy, yz
    have a := tkH.fv.le_iff_mul at K, Γ, v, x, y, z with valued, hx, hy, zK, inv
    have b := tkH.fv.le_iff_mul at K, Δ, w, x, y, z with other, hx, hy, zK, inv
    obtain ⟨field, comm, valuation⟩ := valued
    have ring := CommRing.to_ring with comm
    have xz := Ring.mul_mem at K, x, z with ring, hx, zK
    have c := same with call2(Ring.mul(K), x, z), xz
    rw a
    rw b
    exact c

-- Valuation.IsEquiv.le_one_iff_le_one, lt_one_iff_lt_one, eq_one_iff_eq_one.
theorem ValuationEquiv.one_iff (Δ w x : Set)
  requires equivalent : ValuationEquiv(K, Γ, v, Δ, w)
  requires member : x ∈ Ring.carrier(K)
  shows (ValueLe(Γ, v(x), ValueMonoid.one(Γ)) ↔ ValueLe(Δ, w(x), ValueMonoid.one(Δ))) ∧
    (ValueLt(Γ, v(x), ValueMonoid.one(Γ)) ↔ ValueLt(Δ, w(x), ValueMonoid.one(Δ))) ∧
    (v(x) = ValueMonoid.one(Γ) ↔ w(x) = ValueMonoid.one(Δ))
proof
  obtain ⟨vv, ww, iff⟩ := equivalent
  have ring := tkH.val.ring with vv
  have ordered := tkH.val.ordered with vv
  have ordered2 := tkH.val.ordered with ww
  have oneK := Ring.one_mem with ring
  have v1 := tkH.val.one with vv
  have w1 := tkH.val.one with ww
  have vx := tkH.val.mem at K, Γ, v, x with vv, member
  have wx := tkH.val.mem at K, Δ, w, x with ww, member
  have oneΓ := tkH.vm.one_in with ordered
  have oneΔ := tkH.vm.one_in with ordered2
  have up := iff with x, member, Ring.one(K), oneK
  have down := iff with Ring.one(K), oneK, x, member
  rw v1 at up
  rw w1 at up
  rw v1 at down
  rw w1 at down
  have eqIff : v(x) = ValueMonoid.one(Γ) ↔ w(x) = ValueMonoid.one(Δ)
    constructor
    . intro e
      have l1 : ValueLe(Γ, v(x), ValueMonoid.one(Γ))
        rw e
        exact tkH.vm.le_refl at Γ, ValueMonoid.one(Γ) with ordered, oneΓ
      have l2 : ValueLe(Γ, ValueMonoid.one(Γ), v(x))
        rw e
        exact tkH.vm.le_refl at Γ, ValueMonoid.one(Γ) with ordered, oneΓ
      have m1 := up.forward with l1
      have m2 := down.forward with l2
      exact tkH.vm.le_antisymm at Δ, w(x), ValueMonoid.one(Δ) with ordered2, wx, oneΔ, m1, m2
    . intro e
      have l1 : ValueLe(Δ, w(x), ValueMonoid.one(Δ))
        rw e
        exact tkH.vm.le_refl at Δ, ValueMonoid.one(Δ) with ordered2, oneΔ
      have l2 : ValueLe(Δ, ValueMonoid.one(Δ), w(x))
        rw e
        exact tkH.vm.le_refl at Δ, ValueMonoid.one(Δ) with ordered2, oneΔ
      have m1 := up.backward with l1
      have m2 := down.backward with l2
      exact tkH.vm.le_antisymm at Γ, v(x), ValueMonoid.one(Γ) with ordered, vx, oneΓ, m1, m2
  refine ⟨up, ?_, eqIff⟩
  constructor
  . intro lt
    obtain ⟨le, ne⟩ := lt
    unfold ValueLt
    refine ⟨(up.forward with le), ?_⟩
    intro e
    have e2 := eqIff.backward with e
    exact ne with e2
  . intro lt
    obtain ⟨le, ne⟩ := lt
    unfold ValueLt
    refine ⟨(up.backward with le), ?_⟩
    intro e
    have e2 := eqIff.forward with e
    exact ne with e2

-- Valuation.isEquiv_iff_valuationSubring: two valuations of a field are
-- equivalent exactly when they have the same integers; and
-- Valuation.isEquiv_of_val_le_one.
theorem ValuationEquiv.iff_integer (Δ w : Set)
  requires other : Valued(K, Δ, w)
  shows ValuationEquiv(K, Γ, v, Δ, w) ↔ valuationInteger(K, Γ, v) = valuationInteger(K, Δ, w)
proof
  have vv := tkH.fv.valuation with valued
  have ww := tkH.fv.valuation at K, Δ, w with other
  constructor
  . intro equivalent
    ext x
    constructor
    . intro hx
      obtain ⟨xK, xle⟩ := valuationInteger.membership.forward with hx
      have o := ValuationEquiv.one_iff at K, Γ, v, Δ, w, x with valued, equivalent, xK
      obtain ⟨leIff, rest⟩ := o
      apply valuationInteger.membership.backward
      exact ⟨xK, (leIff.forward with xle)⟩
    . intro hx
      obtain ⟨xK, xle⟩ := valuationInteger.membership.forward with hx
      have o := ValuationEquiv.one_iff at K, Γ, v, Δ, w, x with valued, equivalent, xK
      obtain ⟨leIff, rest⟩ := o
      apply valuationInteger.membership.backward
      exact ⟨xK, (leIff.backward with xle)⟩
  . intro same
    apply ValuationEquiv.of_le_one at K, Γ, v, Δ, w with valued, other
    intros x hx
    constructor
    . intro le
      have m : x ∈ valuationInteger(K, Γ, v)
        apply valuationInteger.membership.backward
        exact ⟨hx, le⟩
      rw same at m
      have m2 := valuationInteger.membership.forward with m
      exact m2.right
    . intro le
      have m : x ∈ valuationInteger(K, Δ, w)
        apply valuationInteger.membership.backward
        exact ⟨hx, le⟩
      rw ← same at m
      have m2 := valuationInteger.membership.forward with m
      exact m2.right

-- Valuation.isEquiv_valuation_valuationSubring: v is equivalent to the
-- valuation of its valuation subring.
theorem ValuationEquiv.of_subring
  shows ValuationEquiv(K, Γ, v, valueGroupOf(K, valuationInteger(K, Γ, v)),
    valuationOfSubring(K, valuationInteger(K, Γ, v)))
proof
  sorry

-- Helpers (track H): balls and open sets of the valuation topology.
theorem tkH.top.opens
  shows TopologicalSpace.opens(valuationTopology(K, Γ, v)) = valuationOpens(K, Γ, v) ∧
    TopologicalSpace.carrier(valuationTopology(K, Γ, v)) = Ring.carrier(K)
proof
  unfold valuationTopology
  topology_projections

theorem tkH.top.opens_intro (U : Set)
  requires subset : U ⊆ Ring.carrier(K)
  requires balls : ∀ x ∈ U, ∃ γ ∈ ValueMonoid.carrier(Γ),
    γ ≠ ValueMonoid.zero(Γ) ∧ valuationBall(K, Γ, v, x, γ) ⊆ U
  shows U ∈ valuationOpens(K, Γ, v)
proof
  apply valuationOpens.membership.backward
  have p := powerset.membership_iff.backward at U, Ring.carrier(K) with subset
  exact ⟨p, balls⟩

theorem tkH.top.center (x γ : Set)
  requires member : x ∈ Ring.carrier(K)
  requires mγ : γ ∈ ValueMonoid.carrier(Γ)
  requires nonzero : γ ≠ ValueMonoid.zero(Γ)
  shows x ∈ valuationBall(K, Γ, v, x, γ)
proof
  obtain ⟨field, comm, valuation⟩ := valued
  have ordered := tkH.val.ordered with valuation
  have same : Ring.sub(K, x, x) = Ring.zero(K) by ring
  apply valuationBall.membership.backward
  refine ⟨member, ?_⟩
  rw same
  have z := tkH.val.zero with valuation
  rw z
  have zl := tkH.vm.zero_le at Γ, γ with ordered, mγ
  unfold ValueLt
  refine ⟨zl, ?_⟩
  intro e
  symm at e
  exact nonzero with e

theorem tkH.top.ball_sub (x y γ : Set)
  requires mx : x ∈ Ring.carrier(K)
  requires inside : y ∈ valuationBall(K, Γ, v, x, γ)
  shows valuationBall(K, Γ, v, y, γ) ⊆ valuationBall(K, Γ, v, x, γ)
proof
  obtain ⟨field, comm, valuation⟩ := valued
  have ring := CommRing.to_ring with comm
  obtain ⟨my, yx⟩ := valuationBall.membership.forward with inside
  intros z hz
  obtain ⟨mz, zy⟩ := valuationBall.membership.forward with hz
  have split : Ring.sub(K, z, x) = call2(Ring.add(K), Ring.sub(K, z, y), Ring.sub(K, y, x)) by ring
  have zyIn := Ring.sub_mem at K, z, y with ring, mz, my
  have yxIn := Ring.sub_mem at K, y, x with ring, my, mx
  have lt := Valuation.map_add_lt at K, Γ, v, Ring.sub(K, z, y), Ring.sub(K, y, x), γ with valuation, zyIn, yxIn, zy, yx
  rw ← split at lt
  apply valuationBall.membership.backward
  exact ⟨mz, lt⟩

theorem tkH.top.ball_open (x γ : Set)
  requires mx : x ∈ Ring.carrier(K)
  requires mγ : γ ∈ ValueMonoid.carrier(Γ)
  requires nonzero : γ ≠ ValueMonoid.zero(Γ)
  shows valuationBall(K, Γ, v, x, γ) ∈ valuationOpens(K, Γ, v)
proof
  apply tkH.top.opens_intro at K, Γ, v, valuationBall(K, Γ, v, x, γ) with valued
  . intros y hy
    have m := valuationBall.membership.forward with hy
    exact m.left
  . intros y hy
    have s := tkH.top.ball_sub at K, Γ, v, x, y, γ with valued, mx, hy
    exact ⟨γ, mγ, nonzero, s⟩

-- Section: The topology of a valued field
-- The valuation topology is a topology making K a topological ring
-- (Valued.isTopologicalRing), nonarchimedean (Valued.isNonarchimedean).
theorem valuationTopology.topological_ring
  shows TopologicalRing(K, valuationTopology(K, Γ, v)) ∧
    NonarchimedeanAddGroup(Ring.additive(K), valuationTopology(K, Γ, v))
proof
  sorry

-- Valued.mem_nhds: U is a neighbourhood of x exactly when it contains a
-- ball {y | v(y − x) < γ} with γ ≠ 0.
theorem valuationTopology.mem_nhds (U x : Set)
  requires member : x ∈ Ring.carrier(K)
  shows Neighborhood(valuationTopology(K, Γ, v), U, x) ↔
    U ⊆ Ring.carrier(K) ∧ (∃ γ ∈ ValueMonoid.carrier(Γ),
      γ ≠ ValueMonoid.zero(Γ) ∧ valuationBall(K, Γ, v, x, γ) ⊆ U)
proof
  have tp := tkH.top.opens at K, Γ, v with valued
  obtain ⟨opensEq, carrierEq⟩ := tp
  constructor
  . intro nb
    unfold Neighborhood at nb
    obtain ⟨sub, W, hW, xW, WU⟩ := nb
    rw carrierEq at sub
    rw opensEq at hW
    obtain ⟨pw, balls⟩ := valuationOpens.membership.forward with hW
    obtain ⟨γ, mγ, ne, bW⟩ := balls with x, xW
    have bU := Subset.transitive with bW, WU
    exact ⟨sub, γ, mγ, ne, bU⟩
  . intro h
    obtain ⟨sub, γ, mγ, ne, bU⟩ := h
    have bo := tkH.top.ball_open at K, Γ, v, x, γ with valued, member, mγ, ne
    have c := tkH.top.center at K, Γ, v, x, γ with valued, member, mγ, ne
    unfold Neighborhood
    rw carrierEq
    rw opensEq
    exact ⟨sub, valuationBall(K, Γ, v, x, γ), bo, c, bU⟩

-- Valued.isOpen_ball, Valued.isOpen_sphere: {v < γ} and, for γ ≠ 0,
-- {v = γ} are open.
theorem valuationTopology.open_ball (γ : Set)
  requires member : γ ∈ ValueMonoid.carrier(Γ)
  shows valuationLtIdeal(K, Γ, v, γ) ∈ valuationOpens(K, Γ, v)
proof
  obtain ⟨field, comm, valuation⟩ := valued
  have ring := CommRing.to_ring with comm
  have ordered := tkH.val.ordered with valuation
  apply tkH.top.opens_intro at K, Γ, v, valuationLtIdeal(K, Γ, v, γ) with valued
  . intros y hy
    have m := valuationLtIdeal.membership.forward with hy
    exact m.left
  . intros x hx
    obtain ⟨xK, xlt⟩ := valuationLtIdeal.membership.forward with hx
    have vx := tkH.val.mem at K, Γ, v, x with valuation, xK
    have ne : γ ≠ ValueMonoid.zero(Γ)
      intro e
      rw e at xlt
      have zl := tkH.vm.zero_le at Γ, v(x) with ordered, vx
      have bad := tkH.vm.not_le_of_lt at Γ, v(x), ValueMonoid.zero(Γ) with ordered, vx, (tkH.vm.zero_in with ordered), xlt
      exact bad with zl
    refine ⟨γ, member, ne, ?_⟩
    intros y hy
    obtain ⟨yK, yx⟩ := valuationBall.membership.forward with hy
    have yxIn := Ring.sub_mem at K, y, x with ring, yK, xK
    have lt := Valuation.map_add_lt at K, Γ, v, Ring.sub(K, y, x), x, γ with valuation, yxIn, xK, yx, xlt
    have c := tkH.ring.sub_add_cancel at K, x, y with ring, xK, yK
    rw c at lt
    apply valuationLtIdeal.membership.backward
    exact ⟨yK, lt⟩

theorem valuationTopology.open_sphere (γ : Set)
  requires member : γ ∈ ValueMonoid.carrier(Γ)
  requires nonzero : γ ≠ ValueMonoid.zero(Γ)
  shows valuationSphere(K, Γ, v, γ) ∈ valuationOpens(K, Γ, v)
proof
  obtain ⟨field, comm, valuation⟩ := valued
  have ring := CommRing.to_ring with comm
  apply tkH.top.opens_intro at K, Γ, v, valuationSphere(K, Γ, v, γ) with valued
  . intros y hy
    have m := valuationSphere.membership.forward with hy
    exact m.left
  . intros x hx
    obtain ⟨xK, xγ⟩ := valuationSphere.membership.forward with hx
    refine ⟨γ, member, nonzero, ?_⟩
    intros y hy
    obtain ⟨yK, yx⟩ := valuationBall.membership.forward with hy
    rw ← xγ at yx
    have e := Valuation.map_eq_of_sub_lt at K, Γ, v, x, y with valuation, xK, yK, yx
    rw xγ at e
    apply valuationSphere.membership.backward
    exact ⟨yK, e⟩

-- Valued.isOpen_integer, Valued.isOpen_valuationSubring,
-- Valued.isClosed_integer: the integers are open and closed.
theorem valuationTopology.integer_clopen
  shows Clopen(valuationTopology(K, Γ, v), valuationInteger(K, Γ, v))
proof
  obtain ⟨field, comm, valuation⟩ := valued
  have ring := CommRing.to_ring with comm
  have ordered := tkH.val.ordered with valuation
  have oneIn := tkH.vm.one_in with ordered
  have zeroIn := tkH.vm.zero_in with ordered
  have tp := tkH.top.opens at K, Γ, v with valued
  obtain ⟨opensEq, carrierEq⟩ := tp
  have subset := tkH.fv.int_subset at K, Γ, v with valued
  have isOpen : valuationInteger(K, Γ, v) ∈ valuationOpens(K, Γ, v)
    apply tkH.top.opens_intro at K, Γ, v, valuationInteger(K, Γ, v) with valued
    . exact subset
    . intros x hx
      obtain ⟨xK, xle⟩ := valuationInteger.membership.forward with hx
      have ne : ValueMonoid.one(Γ) ≠ ValueMonoid.zero(Γ)
        intro e
        have n := tkH.vm.zero_ne_one with ordered
        symm at e
        exact n with e
      refine ⟨ValueMonoid.one(Γ), oneIn, ne, ?_⟩
      intros y hy
      obtain ⟨yK, yx⟩ := valuationBall.membership.forward with hy
      obtain ⟨yxle, yxne⟩ := yx
      have yxIn := Ring.sub_mem at K, y, x with ring, yK, xK
      have le := Valuation.map_add_le at K, Γ, v, Ring.sub(K, y, x), x, ValueMonoid.one(Γ) with valuation, yxIn, xK, yxle, xle
      have c := tkH.ring.sub_add_cancel at K, x, y with ring, xK, yK
      rw c at le
      apply valuationInteger.membership.backward
      exact ⟨yK, le⟩
  have isClosed : complement(Ring.carrier(K), valuationInteger(K, Γ, v)) ∈ valuationOpens(K, Γ, v)
    apply tkH.top.opens_intro at K, Γ, v, complement(Ring.carrier(K), valuationInteger(K, Γ, v)) with valued
    . intros y hy
      have m := complement.membership.forward with hy
      exact m.left
    . intros x hx
      obtain ⟨xK, notI⟩ := complement.membership.forward with hx
      have vx := tkH.val.mem at K, Γ, v, x with valuation, xK
      have big : ¬ValueLe(Γ, v(x), ValueMonoid.one(Γ))
        intro le
        have m : x ∈ valuationInteger(K, Γ, v)
          apply valuationInteger.membership.backward
          exact ⟨xK, le⟩
        exact notI with m
      have ne : v(x) ≠ ValueMonoid.zero(Γ)
        intro e
        rw e at big
        have zl := tkH.vm.zero_le at Γ, ValueMonoid.one(Γ) with ordered, oneIn
        exact big with zl
      refine ⟨v(x), vx, ne, ?_⟩
      intros y hy
      obtain ⟨yK, yx⟩ := valuationBall.membership.forward with hy
      have e := Valuation.map_eq_of_sub_lt at K, Γ, v, x, y with valuation, xK, yK, yx
      apply complement.membership.backward
      refine ⟨yK, ?_⟩
      intro yI
      obtain ⟨yK2, yle⟩ := valuationInteger.membership.forward with yI
      rw e at yle
      exact big with yle
  unfold Clopen
  unfold Closed
  unfold IsClosed
  rw opensEq
  rw carrierEq
  exact ⟨isOpen, subset, isClosed⟩

-- Valued.locally_const: v is locally constant away from 0.
theorem valuationTopology.locally_const (x : Set)
  requires member : x ∈ Ring.carrier(K)
  requires nonzero : x ≠ Ring.zero(K)
  shows Neighborhood(valuationTopology(K, Γ, v), valuationSphere(K, Γ, v, v(x)), x)
proof
  have valuation := tkH.fv.valuation with valued
  have ordered := tkH.val.ordered with valuation
  have vx := tkH.val.mem at K, Γ, v, x with valuation, member
  have ne : v(x) ≠ ValueMonoid.zero(Γ)
    intro e
    have ez := Valuation.eq_zero_iff at K, Γ, v, x with valued, member
    have z := ez.forward with e
    exact nonzero with z
  have o := valuationTopology.open_sphere at K, Γ, v, v(x) with valued, vx, ne
  have xIn : x ∈ valuationSphere(K, Γ, v, v(x))
    apply valuationSphere.membership.backward
    exact ⟨member, rfl⟩
  have tp := tkH.top.opens at K, Γ, v with valued
  obtain ⟨opensEq, carrierEq⟩ := tp
  have sub : valuationSphere(K, Γ, v, v(x)) ⊆ Ring.carrier(K)
    intros y hy
    have m := valuationSphere.membership.forward with hy
    exact m.left
  have refl := Subset.reflexive at valuationSphere(K, Γ, v, v(x))
  unfold Neighborhood
  rw carrierEq
  rw opensEq
  exact ⟨sub, valuationSphere(K, Γ, v, v(x)), o, xIn, refl⟩

-- Valued.tendsto_zero_pow_of_v_lt_one: xⁿ → 0 when v(x) < 1.
theorem valuationTopology.pow_tendsto_zero (x : Set)
  requires member : x ∈ Ring.carrier(K)
  requires small : ValueLt(Γ, v(x), ValueMonoid.one(Γ))
  shows Converges(valuationTopology(K, Γ, v), powSequence(K, x), Ring.zero(K))
proof
  sorry

end FieldValuations

-- Section: Valuation subrings
section ValuationSubrings
variable (K A : Set)
hypothesis subring : ValuationSubring(K, A)

-- Helpers (track H): the parts of a valuation subring.
theorem tkH.vs.subset
  shows A ⊆ Ring.carrier(K)
proof
  obtain ⟨field, comm, sub, total⟩ := subring
  obtain ⟨s, rest⟩ := sub
  exact s

theorem tkH.vs.unit_iff (x : Set)
  requires member : x ∈ A
  shows RingUnit(subringRing(K, A), x) ↔ (∃ y ∈ A, call2(Ring.mul(K), x, y) = Ring.one(K))
proof
  obtain ⟨field, comm, sub, total⟩ := subring
  have ring := CommRing.to_ring with comm
  have subset := tkH.vs.subset at K, A with subring
  have carrier := subringRing.carrierOf at K, A
  have o1 := tkH.sub.one at K, A
  constructor
  . intro unit
    obtain ⟨xs, b, bIn, xb, bx⟩ := unit
    rw carrier at bIn
    have sm := tkH.sub.mul at K, A, x, b with ring, subset, member, bIn
    rw sm at xb
    rw o1 at xb
    exact ⟨b, bIn, xb⟩
  . intro h
    obtain ⟨y, yA, xy⟩ := h
    have xK : x ∈ Ring.carrier(K) := subset with x, member
    have yK : y ∈ Ring.carrier(K) := subset with y, yA
    have sm1 := tkH.sub.mul at K, A, x, y with ring, subset, member, yA
    have sm2 := tkH.sub.mul at K, A, y, x with ring, subset, yA, member
    have parts := CommRing.parts with comm
    have c := IsCommRing.mul_comm at Ring.carrier(K), Ring.add(K), Ring.zero(K), Ring.neg(K), Ring.mul(K), Ring.one(K), y, x with parts, yK, xK
    have yS : y ∈ Ring.carrier(subringRing(K, A))
      rw carrier
      exact yA
    have xS : x ∈ Ring.carrier(subringRing(K, A))
      rw carrier
      exact member
    unfold RingUnit
    refine ⟨xS, y, yS, ?_, ?_⟩
    . rw sm1
      rw o1
      exact xy
    . rw sm2
      rw o1
      rw c
      exact xy

-- For a ≠ 0 in A and b ∈ A: b = a c with c ∈ A, or a = b c with c ∈ A.
theorem tkH.vs.divides (a b : Set)
  requires ma : a ∈ A
  requires mb : b ∈ A
  requires nonzero : a ≠ Ring.zero(K)
  shows (∃ c ∈ A, b = call2(Ring.mul(K), a, c)) ∨ (∃ c ∈ A, a = call2(Ring.mul(K), b, c))
proof
  obtain ⟨field, comm, sub, total⟩ := subring
  have ring := CommRing.to_ring with comm
  have subset := tkH.vs.subset at K, A with subring
  have aK : a ∈ Ring.carrier(K) := subset with a, ma
  have bK : b ∈ Ring.carrier(K) := subset with b, mb
  have parts := Field.parts with field
  obtain ⟨ai, inv⟩ := IsField.inverse_exists with parts, aK, nonzero
  obtain ⟨aIn, aiK, left, right⟩ := inv
  have xK := Ring.mul_mem at K, b, ai with ring, bK, aiK
  have t := total with call2(Ring.mul(K), b, ai), xK
  rcases t with inA | other
  . left
    have e : b = call2(Ring.mul(K), a, call2(Ring.mul(K), b, ai))
      linear_combination apply(Ring.neg(K), b) * right
    exact ⟨call2(Ring.mul(K), b, ai), inA, e⟩
  . right
    obtain ⟨y, yA, xy⟩ := other
    have yK : y ∈ Ring.carrier(K) := subset with y, yA
    have e : a = call2(Ring.mul(K), b, y)
      linear_combination apply(Ring.neg(K), a) * xy + call2(Ring.mul(K), b, y) * right
    exact ⟨y, yA, e⟩

-- A valuation subring is a local valuation ring (ValuationSubring's
-- ValuationRing and IsLocalRing instances), with maximal ideal its
-- nonunits.
theorem ValuationSubring.valuation_ring
  shows ValuationRing(subringRing(K, A)) ∧ LocalRing(subringRing(K, A)) ∧
    localMaximalIdeal(subringRing(K, A)) = valuationSubringNonunits(K, A)
proof
  have subset := tkH.vs.subset at K, A with subring
  obtain ⟨field, comm, sub, total⟩ := subring
  have ring := CommRing.to_ring with comm
  have carrier := subringRing.carrierOf at K, A
  have subComm := subringRing.comm_ring at K, A with comm, sub
  have parts := Field.parts with field
  have nt := IsField.nontrivial with parts
  obtain ⟨z1, o1, ne⟩ := nt
  have zs := tkH.sub.zero at K, A
  have os := tkH.sub.one at K, A
  have neS : Ring.zero(subringRing(K, A)) ≠ Ring.one(subringRing(K, A))
    rw zs
    rw os
    exact ne
  have zeroA : Ring.zero(K) ∈ A
    obtain ⟨s, z, rest⟩ := sub
    exact z
  have oneA : Ring.one(K) ∈ A
    obtain ⟨s, z, o, rest⟩ := sub
    exact o
  have domain : IntegralDomain(subringRing(K, A))
    unfold IntegralDomain
    refine ⟨subComm, neS, ?_⟩
    intros x hx y hy xy
    rw carrier at hx
    rw carrier at hy
    have sm := tkH.sub.mul at K, A, x, y with ring, subset, hx, hy
    rw sm at xy
    rw zs at xy
    rw zs
    have nzd := IsField.no_zero_divisors at Ring.carrier(K), Ring.add(K), Ring.zero(K), Ring.neg(K), Ring.mul(K), Ring.one(K) with parts
    have xK : x ∈ Ring.carrier(K) := subset with x, hx
    have yK : y ∈ Ring.carrier(K) := subset with y, hy
    exact nzd with x, xK, y, yK, xy
  have dvd : ∀ a ∈ Ring.carrier(subringRing(K, A)), ∀ b ∈ Ring.carrier(subringRing(K, A)),
      RingDvd(subringRing(K, A), a, b) ∨ RingDvd(subringRing(K, A), b, a)
    intros a ha b hb
    have aA : a ∈ A
      rw ← carrier
      exact ha
    have bA : b ∈ A
      rw ← carrier
      exact hb
    by_cases az : a = Ring.zero(K)
    . right
      have zS : Ring.zero(K) ∈ Ring.carrier(subringRing(K, A))
        rw carrier
        exact zeroA
      have sm := tkH.sub.mul at K, A, b, Ring.zero(K) with ring, subset, bA, zeroA
      have bK : b ∈ Ring.carrier(K) := subset with b, bA
      have m0 : call2(Ring.mul(K), b, Ring.zero(K)) = Ring.zero(K) by ring
      unfold RingDvd
      refine ⟨hb, ha, Ring.zero(K), zS, ?_⟩
      rw sm
      rw m0
      exact az
    . have d := tkH.vs.divides at K, A, a, b with subring, aA, bA, az
      rcases d with l | r
      . left
        obtain ⟨c, cA, e⟩ := l
        have cS : c ∈ Ring.carrier(subringRing(K, A))
          rw carrier
          exact cA
        have sm := tkH.sub.mul at K, A, a, c with ring, subset, aA, cA
        unfold RingDvd
        refine ⟨ha, hb, c, cS, ?_⟩
        rw sm
        exact e
      . right
        obtain ⟨c, cA, e⟩ := r
        have cS : c ∈ Ring.carrier(subringRing(K, A))
          rw carrier
          exact cA
        have sm := tkH.sub.mul at K, A, b, c with ring, subset, bA, cA
        unfold RingDvd
        refine ⟨hb, ha, c, cS, ?_⟩
        rw sm
        exact e
  have vr : ValuationRing(subringRing(K, A))
    unfold ValuationRing
    exact ⟨domain, dvd⟩
  have local : LocalRing(subringRing(K, A))
    unfold LocalRing
    refine ⟨subComm, neS, ?_⟩
    intros a ha b hb sum
    rw carrier at ha
    rw carrier at hb
    have sa := tkH.sub.add at K, A, a, b with ring, subset, ha, hb
    rw sa at sum
    rw os at sum
    have aK : a ∈ Ring.carrier(K) := subset with a, ha
    have bK : b ∈ Ring.carrier(K) := subset with b, hb
    by_cases az : a = Ring.zero(K)
    . right
      have u := tkH.vs.unit_iff at K, A, b with subring, hb
      apply u.backward
      have e : call2(Ring.mul(K), b, Ring.one(K)) = Ring.one(K)
        rw az at sum
        linear_combination sum
      exact ⟨Ring.one(K), oneA, e⟩
    . have d := tkH.vs.divides at K, A, a, b with subring, ha, hb, az
      rcases d with l | r
      . left
        obtain ⟨c, cA, e⟩ := l
        have cK : c ∈ Ring.carrier(K) := subset with c, cA
        have u := tkH.vs.unit_iff at K, A, a with subring, ha
        apply u.backward
        have plus : call2(Ring.add(K), Ring.one(K), c) ∈ A
          obtain ⟨s, z, o, n, ad, m⟩ := sub
          exact ad with Ring.one(K), oneA, c, cA
        have e2 : call2(Ring.mul(K), a, call2(Ring.add(K), Ring.one(K), c)) = Ring.one(K)
          linear_combination sum - e
        exact ⟨call2(Ring.add(K), Ring.one(K), c), plus, e2⟩
      . right
        obtain ⟨c, cA, e⟩ := r
        have cK : c ∈ Ring.carrier(K) := subset with c, cA
        have u := tkH.vs.unit_iff at K, A, b with subring, hb
        apply u.backward
        have plus : call2(Ring.add(K), c, Ring.one(K)) ∈ A
          obtain ⟨s, z, o, n, ad, m⟩ := sub
          exact ad with c, cA, Ring.one(K), oneA
        have e2 : call2(Ring.mul(K), b, call2(Ring.add(K), c, Ring.one(K))) = Ring.one(K)
          linear_combination sum - e
        exact ⟨call2(Ring.add(K), c, Ring.one(K)), plus, e2⟩
  refine ⟨vr, local, ?_⟩
  unfold localMaximalIdeal
  unfold ringNonunits
  unfold valuationSubringNonunits
  rw carrier
  ext x
  constructor
  . intro hx
    obtain ⟨xA, notUnit⟩ := difference.membership.forward with hx
    apply difference.membership.backward
    refine ⟨xA, ?_⟩
    intro unit
    obtain ⟨xA2, y, yA, xy⟩ := valuationSubringUnits.membership.forward with unit
    have u := tkH.vs.unit_iff at K, A, x with subring, xA
    have ru := u.backward with ⟨y, yA, xy⟩
    have xS : x ∈ Ring.carrier(subringRing(K, A))
      rw carrier
      exact xA
    have inUnits : x ∈ ringUnits(subringRing(K, A))
      apply ringUnits.membership.backward
      exact ⟨xS, ru⟩
    exact notUnit with inUnits
  . intro hx
    obtain ⟨xA, notUnit⟩ := difference.membership.forward with hx
    apply difference.membership.backward
    refine ⟨xA, ?_⟩
    intro inUnits
    obtain ⟨xS, ru⟩ := ringUnits.membership.forward with inUnits
    have u := tkH.vs.unit_iff at K, A, x with subring, xA
    have ex := u.forward with ru
    obtain ⟨y, yA, xy⟩ := ex
    have unit : x ∈ valuationSubringUnits(K, A)
      apply valuationSubringUnits.membership.backward
      exact ⟨xA, y, yA, xy⟩
    exact notUnit with unit

-- ValuationSubring.valuation is a valuation whose integers are A
-- (ValuationSubring.valuation_le_one_iff, mem_of_valuation_le_one,
-- valuationSubring_valuation).
theorem valuationOfSubring.valuation
  shows Valued(K, valueGroupOf(K, A), valuationOfSubring(K, A)) ∧
    valuationInteger(K, valueGroupOf(K, A), valuationOfSubring(K, A)) = A
proof
  sorry

-- ValuationSubring.valuation_eq_one_iff, ValuationSubring.valuation_lt_one_iff.
theorem valuationOfSubring.eq_one_iff (x : Set)
  requires member : x ∈ A
  shows valuationOfSubring(K, A)(x) = ValueMonoid.one(valueGroupOf(K, A)) ↔
    x ∈ valuationSubringUnits(K, A)
proof
  sorry

theorem valuationOfSubring.lt_one_iff (x : Set)
  requires member : x ∈ A
  shows ValueLt(valueGroupOf(K, A), valuationOfSubring(K, A)(x),
      ValueMonoid.one(valueGroupOf(K, A))) ↔
    x ∈ valuationSubringNonunits(K, A)
proof
  sorry

-- ValuationSubring.mem_nonunits_iff_exists_mem_maximalIdeal,
-- coe_mem_nonunits_iff: for a valuation with integers A, the nonunits of
-- A are the elements of value < 1.
theorem valuationSubringNonunits.iff (Γ v x : Set)
  requires valued : Valued(K, Γ, v)
  requires integers : valuationInteger(K, Γ, v) = A
  requires member : x ∈ Ring.carrier(K)
  shows x ∈ valuationSubringNonunits(K, A) ↔ ValueLt(Γ, v(x), ValueMonoid.one(Γ))
proof
  rw ← integers
  have vv := tkH.fv.valuation at K, Γ, v with valued
  have vx := tkH.val.mem at K, Γ, v, x with vv, member
  unfold valuationSubringNonunits
  constructor
  . intro h
    obtain ⟨xI, notUnit⟩ := difference.membership.forward with h
    obtain ⟨xK, xle⟩ := valuationInteger.membership.forward with xI
    unfold ValueLt
    refine ⟨xle, ?_⟩
    intro one
    have u := tkH.fv.units_iff at K, Γ, v, x with valued, xI
    have unit := u.backward with one
    exact notUnit with unit
  . intro lt
    obtain ⟨xle, xne⟩ := lt
    have xI : x ∈ valuationInteger(K, Γ, v)
      apply valuationInteger.membership.backward
      exact ⟨member, xle⟩
    apply difference.membership.backward
    refine ⟨xI, ?_⟩
    intro unit
    have u := tkH.fv.units_iff at K, Γ, v, x with valued, xI
    have one := u.forward with unit
    exact xne with one

-- ValuationSubring.principalUnitGroup: x is a principal unit when
-- v(x − 1) < 1.
theorem principalUnits.iff (Γ v x : Set)
  requires valued : Valued(K, Γ, v)
  requires integers : valuationInteger(K, Γ, v) = A
  requires member : x ∈ Ring.carrier(K)
  shows x ∈ principalUnits(K, A) ↔
    ValueLt(Γ, v(Ring.sub(K, x, Ring.one(K))), ValueMonoid.one(Γ))
proof
  obtain ⟨field, comm, valuation⟩ := valued
  have ring := CommRing.to_ring with comm
  have ordered := tkH.val.ordered with valuation
  have oneK := Ring.one_mem with ring
  have dIn := Ring.sub_mem at K, x, Ring.one(K) with ring, member, oneK
  have n := valuationSubringNonunits.iff at K, A, Γ, v, Ring.sub(K, x, Ring.one(K)) with subring, valued, integers, dIn
  constructor
  . intro h
    obtain ⟨xK, nz, d⟩ := principalUnits.membership.forward with h
    exact n.forward with d
  . intro lt
    have d := n.backward with lt
    have nz : x ≠ Ring.zero(K)
      intro same
      rw same at lt
      have zeroK := Ring.zero_mem with ring
      have sw := Valuation.map_sub_swap at K, Γ, v, Ring.zero(K), Ring.one(K) with valuation, zeroK, oneK
      have e : Ring.sub(K, Ring.one(K), Ring.zero(K)) = Ring.one(K) by ring
      rw sw at lt
      rw e at lt
      have o := tkH.val.one with valuation
      rw o at lt
      obtain ⟨le, ne⟩ := lt
      exact ne with rfl
    apply principalUnits.membership.backward
    exact ⟨member, nz, d⟩

-- ValuationSubring.surjective_unitGroupToResidueFieldUnits: every unit of
-- the residue field lifts to a unit of A.
theorem valuationSubringUnits.residue_surjective (c : Set)
  requires unit : RingUnit(residueField(subringRing(K, A)), c)
  shows ∃ x ∈ valuationSubringUnits(K, A), residueMap(subringRing(K, A))(x) = c
proof
  have parts3 := ValuationSubring.valuation_ring at K, A with subring
  obtain ⟨vr, local, mEq⟩ := parts3
  have subset := tkH.vs.subset at K, A with subring
  obtain ⟨field, comm, sub, total⟩ := subring
  have carrier := subringRing.carrierOf at K, A
  have commS := subringRing.comm_ring at K, A with comm, sub
  have idealM := localMaximalIdeal.ideal at subringRing(K, A) with local
  have hom := quotientMk.hom at subringRing(K, A), localMaximalIdeal(subringRing(K, A)) with commS, idealM
  have surj := quotientMk.surjective at subringRing(K, A), localMaximalIdeal(subringRing(K, A)) with commS, idealM
  have commQ := quotientRing.comm_ring_of_ideal at subringRing(K, A), localMaximalIdeal(subringRing(K, A)) with commS, idealM
  unfold residueField at unit
  unfold residueMap
  obtain ⟨cIn, b, bIn, cb, bc⟩ := unit
  obtain ⟨fF, onto⟩ := surj
  obtain ⟨a, aS, rel⟩ := onto with c, cIn
  have value := FunctionBetween.apply_value with fF, aS, rel
  have aA : a ∈ A
    rw ← carrier
    exact aS
  refine ⟨a, ?_, value⟩
  by_contra notUnit
  have inM : a ∈ localMaximalIdeal(subringRing(K, A))
    rw mEq
    unfold valuationSubringNonunits
    apply difference.membership.backward
    exact ⟨aA, notUnit⟩
  have z := quotientMk.eq_zero_iff at subringRing(K, A), localMaximalIdeal(subringRing(K, A)), a with commS, idealM, aS
  have az := z.backward with inM
  rw value at az
  rw az at cb
  have zb : call2(Ring.mul(quotientRing(subringRing(K, A), localMaximalIdeal(subringRing(K, A)))),
      Ring.zero(quotientRing(subringRing(K, A), localMaximalIdeal(subringRing(K, A)))), b) =
      Ring.zero(quotientRing(subringRing(K, A), localMaximalIdeal(subringRing(K, A)))) by ring
  rw zb at cb
  obtain ⟨ringS, ringQ, mkF, mk0, mk1, rest⟩ := hom
  have oneS := Ring.one_mem with ringS
  rw ← cb at mk1
  have z1 := quotientMk.eq_zero_iff at subringRing(K, A), localMaximalIdeal(subringRing(K, A)), Ring.one(subringRing(K, A)) with commS, idealM, oneS
  have oneM := z1.forward with mk1
  rw mEq at oneM
  unfold valuationSubringNonunits at oneM
  obtain ⟨oneA, notU⟩ := difference.membership.forward with oneM
  have os := tkH.sub.one at K, A
  rw os at notU
  rw os at oneA
  have ring := CommRing.to_ring with comm
  have oneK := Ring.one_mem with ring
  have e : call2(Ring.mul(K), Ring.one(K), Ring.one(K)) = Ring.one(K) by ring
  have u : Ring.one(K) ∈ valuationSubringUnits(K, A)
    apply valuationSubringUnits.membership.backward
    exact ⟨oneA, Ring.one(K), oneA, e⟩
  exact notU with u

end ValuationSubrings

-- LocalSubring.exists_le_valuationSubring: a local subring B of a field
-- is dominated by a valuation subring (Chevalley; the proof uses Zorn's
-- lemma).
theorem ValuationSubring.exists_dominating (K B : Set)
  requires field : Field(K)
  requires comm : CommRing(K)
  requires subring : Subring(K, B)
  requires local : LocalRing(subringRing(K, B))
  shows ∃ A, ValuationSubring(K, A) ∧ B ⊆ A ∧
    localMaximalIdeal(subringRing(K, B)) ⊆ valuationSubringNonunits(K, A)
proof
  sorry

-- ValuationRing.iff_dvd_total and PreValuationRing.iff_dvd_total: a
-- domain is a valuation ring exactly when it is a pre-valuation ring.
theorem ValuationRing.iff_pre (R : Set)
  requires domain : IntegralDomain(R)
  requires comm : CommRing(R)
  shows ValuationRing(R) ↔ PreValuationRing(R)
proof
  constructor
  . intro vr
    obtain ⟨dom, total⟩ := vr
    unfold PreValuationRing
    refine ⟨comm, ?_⟩
    intros a ha b hb
    exact total with a, ha, b, hb
  . intro pre
    obtain ⟨c, total⟩ := pre
    unfold ValuationRing
    refine ⟨domain, ?_⟩
    intros a ha b hb
    exact total with a, ha, b, hb

-- Section: Nonarchimedean normed fields
section NonarchimedeanFields
variable (K norm : Set)
hypothesis normed : NormedField(K, norm)
hypothesis ultrametric : NonarchimedeanNorm(K, norm)

-- Helpers (track H): the parts of a nonarchimedean normed field.
theorem tkH.nf.nonneg (x : Set)
  requires member : x ∈ Ring.carrier(K)
  shows norm(x) ∈ ℝ ∧ (0:R) ≤ (norm(x):R) ∧ norm(x) ∈ nnReals
proof
  obtain ⟨field, comm, normedRing, mult, normOne⟩ := normed
  obtain ⟨ring, normedGroup, submult⟩ := normedRing
  obtain ⟨abelian, isNorm⟩ := normedGroup
  obtain ⟨normF, nonneg, zeroIff, negInv, tri⟩ := isNorm
  ring_additive at normF
  ring_additive at nonneg
  have r := FunctionBetween.apply_closed with normF, member
  have n := nonneg with x, member
  have nn : norm(x) ∈ nnReals
    apply nnReals.membership.backward
    exact ⟨r, n⟩
  exact ⟨r, n, nn⟩

theorem tkH.nf.zero_iff (x : Set)
  requires member : x ∈ Ring.carrier(K)
  shows norm(x) = realZero ↔ x = Ring.zero(K)
proof
  obtain ⟨field, comm, normedRing, mult, normOne⟩ := normed
  obtain ⟨ring, normedGroup, submult⟩ := normedRing
  obtain ⟨abelian, isNorm⟩ := normedGroup
  obtain ⟨normF, nonneg, zeroIff, negInv, tri⟩ := isNorm
  ring_additive at zeroIff
  exact zeroIff with x, member

theorem tkH.nf.mul (x y : Set)
  requires first : x ∈ Ring.carrier(K)
  requires second : y ∈ Ring.carrier(K)
  shows norm(call2(Ring.mul(K), x, y)) = (norm(x):R) * (norm(y):R)
proof
  obtain ⟨field, comm, normedRing, mult, normOne⟩ := normed
  exact mult with x, first, y, second

theorem tkH.nf.one
  shows norm(Ring.one(K)) = realOne
proof
  obtain ⟨field, comm, normedRing, mult, normOne⟩ := normed
  exact normOne

theorem tkH.nf.ultra (x y : Set)
  requires first : x ∈ Ring.carrier(K)
  requires second : y ∈ Ring.carrier(K)
  shows (norm(call2(Ring.add(K), x, y)):R) ≤ (norm(x):R) ∨
    (norm(call2(Ring.add(K), x, y)):R) ≤ (norm(y):R)
proof
  obtain ⟨nr, ultra⟩ := ultrametric
  exact ultra with x, first, y, second

-- NormedField.valuation, Valuation.norm_def: the norm of a nonarchimedean
-- normed field is a valuation with values in ℝ≥0, and its topology is the
-- norm topology (Valued.toNormedField, NormedField.toValued).
theorem normValuation.valuation
  shows Valued(K, nnRealValues, norm)
proof
  obtain ⟨field, comm, normedRing, mult, normOne⟩ := normed
  obtain ⟨ring, normedGroup, submult⟩ := normedRing
  obtain ⟨abelian, isNorm⟩ := normedGroup
  obtain ⟨normF, nonneg, zeroIff, negInv, tri⟩ := isNorm
  ring_additive at normF
  obtain ⟨pc, pm, po, pz, pl⟩ := tkH.nn.proj
  have ordered := nnRealValues.ordered
  have function : FunctionBetween(norm, Ring.carrier(K), nnReals)
    apply FunctionBetween.codomain_of_values at norm, Ring.carrier(K), ℝ, nnReals with normF
    intros x hx
    have p := tkH.nf.nonneg at K, norm, x with normed, ultrametric, hx
    exact p.right.right
  have zeroK := Ring.zero_mem with ring
  have nz := tkH.nf.zero_iff at K, norm, Ring.zero(K) with normed, ultrametric, zeroK
  have n0 := nz.backward with rfl
  unfold Valued
  refine ⟨field, comm, ?_⟩
  unfold Valuation
  rw [pc, pm, po, pz]
  refine ⟨ring, ordered, function, n0, normOne, ?_, ?_⟩
  . intros x hx y hy
    have px := tkH.nf.nonneg at K, norm, x with normed, ultrametric, hx
    have py := tkH.nf.nonneg at K, norm, y with normed, ultrametric, hy
    obtain ⟨e, m⟩ := tkH.nn.mul_eq at norm(x), norm(y) with px.right.right, py.right.right
    rw e
    exact tkH.nf.mul at K, norm, x, y with normed, ultrametric, hx, hy
  . intros x hx y hy
    have xy := Ring.add_mem at K, x, y with ring, hx, hy
    have px := tkH.nf.nonneg at K, norm, x with normed, ultrametric, hx
    have py := tkH.nf.nonneg at K, norm, y with normed, ultrametric, hy
    have pxy := tkH.nf.nonneg at K, norm, call2(Ring.add(K), x, y) with normed, ultrametric, xy
    have u := tkH.nf.ultra at K, norm, x, y with normed, ultrametric, hx, hy
    have i1 := tkH.nn.rel_iff at norm(call2(Ring.add(K), x, y)), norm(x) with pxy.right.right, px.right.right
    have i2 := tkH.nn.rel_iff at norm(call2(Ring.add(K), x, y)), norm(y) with pxy.right.right, py.right.right
    unfold ValueLe
    rw pl
    rcases u with a | b
    . left
      exact i1.backward with (realLe.characterization.forward with a)
    . right
      exact i2.backward with (realLe.characterization.forward with b)

theorem normValuation.topology
  shows valuationTopology(K, nnRealValues, norm) = normTopology(Ring.additive(K), norm)
proof
  sorry

-- The unit ball is a valuation subring (Valued.integer), its units are
-- the elements of norm 1 (Valued.integer.isUnit_iff_norm_eq_one), and it
-- is open (Valued.isOpen_integer).
theorem normUnitBall.valuation_subring
  shows ValuationSubring(K, normUnitBall(K, norm)) ∧
    normUnitBall(K, norm) = valuationInteger(K, nnRealValues, norm)
proof
  have valued := normValuation.valuation at K, norm with normed, ultrametric
  have vs := valuationInteger.valuation_subring at K, nnRealValues, norm with valued
  obtain ⟨pc, pm, po, pz, pl⟩ := tkH.nn.proj
  have same : normUnitBall(K, norm) = valuationInteger(K, nnRealValues, norm)
    ext x
    constructor
    . intro hx
      obtain ⟨xK, le⟩ := normUnitBall.membership.forward with hx
      have px := tkH.nf.nonneg at K, norm, x with normed, ultrametric, xK
      have oneNN := tkH.vm.one_in at nnRealValues with nnRealValues.ordered
      rw [pc, po] at oneNN
      have i := tkH.nn.rel_iff at norm(x), realOne with px.right.right, oneNN
      apply valuationInteger.membership.backward
      refine ⟨xK, ?_⟩
      unfold ValueLe
      rw [pl, po]
      exact i.backward with (realLe.characterization.forward with le)
    . intro hx
      obtain ⟨xK, le⟩ := valuationInteger.membership.forward with hx
      have px := tkH.nf.nonneg at K, norm, x with normed, ultrametric, xK
      have oneNN := tkH.vm.one_in at nnRealValues with nnRealValues.ordered
      rw [pc, po] at oneNN
      have i := tkH.nn.rel_iff at norm(x), realOne with px.right.right, oneNN
      unfold ValueLe at le
      rw [pl, po] at le
      have r := i.forward with le
      apply normUnitBall.membership.backward
      exact ⟨xK, (realLe.characterization.backward with r)⟩
  rw same
  exact ⟨vs, rfl⟩

theorem normUnitBall.unit_iff (x : Set)
  requires member : x ∈ normUnitBall(K, norm)
  shows RingUnit(subringRing(K, normUnitBall(K, norm)), x) ↔ norm(x) = realOne
proof
  have valued := normValuation.valuation at K, norm with normed, ultrametric
  have vs := normUnitBall.valuation_subring at K, norm with normed, ultrametric
  obtain ⟨sub, same⟩ := vs
  obtain ⟨pc, pm, po, pz, pl⟩ := tkH.nn.proj
  rw same at member
  rw same
  have u := valuationInteger.unit_iff at K, nnRealValues, norm, x with valued, member
  rw po at u
  exact u

-- IsUltrametricDist.norm_add_eq_max_of_norm_ne_norm and
-- norm_sub_eq_max_of_norm_sub_ne_norm_sub, in the case ‖x‖ < ‖y‖.
theorem NonarchimedeanNorm.add_eq_of_lt (x y : Set)
  requires first : x ∈ Ring.carrier(K)
  requires second : y ∈ Ring.carrier(K)
  requires lt : norm(x) < norm(y)
  shows norm(call2(Ring.add(K), x, y)) = norm(y)
proof
  have valued := normValuation.valuation at K, norm with normed, ultrametric
  have valuation := tkH.fv.valuation with valued
  obtain ⟨pc, pm, po, pz, pl⟩ := tkH.nn.proj
  have px := tkH.nf.nonneg at K, norm, x with normed, ultrametric, first
  have py := tkH.nf.nonneg at K, norm, y with normed, ultrametric, second
  have i := tkH.nn.rel_iff at norm(x), norm(y) with px.right.right, py.right.right
  have le : (norm(x):R) ≤ (norm(y):R) by linarith
  have vlt : ValueLt(nnRealValues, norm(x), norm(y))
    unfold ValueLt
    unfold ValueLe
    rw pl
    refine ⟨(i.backward with (realLe.characterization.forward with le)), ?_⟩
    intro e
    rw e at lt
    have irr := realLess.not_self at norm(y)
    exact irr with lt
  exact Valuation.map_add_eq_of_lt_right at K, nnRealValues, norm, x, y with valuation, first, second, vlt

-- IsUltrametricDist.norm_natCast_le_one, norm_intCast_le_one.
theorem NonarchimedeanNorm.nat_le_one (n : Nat)
  shows norm(natCast(K, n)) ≤ realOne
proof
  obtain ⟨field, comm, normedRing, mult, normOne⟩ := normed
  have ring := CommRing.to_ring with comm
  have parts := Ring.parts with ring
  have oneK := Ring.one_mem with ring
  have zeroK := Ring.zero_mem with ring
  have n0 := tkH.nf.zero_iff at K, norm, Ring.zero(K) with normed, ultrametric, zeroK
  have z0 := n0.backward with rfl
  have o1 := tkH.nf.one at K, norm with normed, ultrametric
  induction n with
  | zero =>
    unfold natCast
    rw ringNat.zero
    rw z0
    linarith
  | succ(m) using ih =>
    unfold natCast at ih
    unfold natCast
    rw ringNat.succ
    have mIn := IsRing.numeral_closed at Ring.carrier(K), Ring.add(K), Ring.zero(K), Ring.neg(K),
      Ring.mul(K), Ring.one(K), m with parts
    have u := tkH.nf.ultra at K, norm, ringNat(Ring.add(K), Ring.zero(K), Ring.one(K), m), Ring.one(K)
      with normed, ultrametric, mIn, oneK
    have sIn := Ring.add_mem at K, ringNat(Ring.add(K), Ring.zero(K), Ring.one(K), m), Ring.one(K) with ring, mIn, oneK
    have ps := tkH.nf.nonneg at K, norm, call2(Ring.add(K), ringNat(Ring.add(K), Ring.zero(K), Ring.one(K), m), Ring.one(K)) with normed, ultrametric, sIn
    have pm := tkH.nf.nonneg at K, norm, ringNat(Ring.add(K), Ring.zero(K), Ring.one(K), m) with normed, ultrametric, mIn
    rw o1 at u
    rcases u with a | b
    . linarith
    . linarith

theorem NonarchimedeanNorm.int_le_one (z : Set)
  requires integer : z ∈ ℤ
  shows norm(intCastHom(K)(z)) ≤ realOne
proof
  sorry

theorem tkH.nf.ball_step (x y z r : Set)
  requires mx : x ∈ Ring.carrier(K)
  requires my : y ∈ Ring.carrier(K)
  requires mz : z ∈ Ring.carrier(K)
  requires real : r ∈ ℝ
  requires first : RealLe(norm(Ring.sub(K, z, y)), r)
  requires second : RealLe(norm(Ring.sub(K, y, x)), r)
  shows RealLe(norm(Ring.sub(K, z, x)), r)
proof
  obtain ⟨field, comm, normedRing, mult, normOne⟩ := normed
  have ring := CommRing.to_ring with comm
  have zy := Ring.sub_mem at K, z, y with ring, mz, my
  have yx := Ring.sub_mem at K, y, x with ring, my, mx
  have zx := Ring.sub_mem at K, z, x with ring, mz, mx
  have split : Ring.sub(K, z, x) = call2(Ring.add(K), Ring.sub(K, z, y), Ring.sub(K, y, x)) by ring
  have u := tkH.nf.ultra at K, norm, Ring.sub(K, z, y), Ring.sub(K, y, x) with normed, ultrametric, zy, yx
  rw ← split at u
  have a := realLe.characterization.backward with first
  have b := realLe.characterization.backward with second
  have p1 := tkH.nf.nonneg at K, norm, Ring.sub(K, z, y) with normed, ultrametric, zy
  have p2 := tkH.nf.nonneg at K, norm, Ring.sub(K, y, x) with normed, ultrametric, yx
  have p3 := tkH.nf.nonneg at K, norm, Ring.sub(K, z, x) with normed, ultrametric, zx
  have c : (norm(Ring.sub(K, z, x)):R) ≤ (r:R)
    rcases u with l | l
    . linarith
    . linarith
  exact realLe.characterization.forward with c

-- IsUltrametricDist.isClosed_ball, isOpen_closedBall,
-- closedBall_eq_of_mem: closed balls of positive radius are open and
-- closed, and every point of a closed ball is a centre.
theorem normClosedBall.clopen (x r : Set)
  requires member : x ∈ Ring.carrier(K)
  requires real : r ∈ ℝ
  requires positive : realZero < r
  shows Clopen(normTopology(Ring.additive(K), norm), normClosedBall(K, norm, x, r))
proof
  sorry

theorem normClosedBall.eq_of_mem (x y r : Set)
  requires member : x ∈ Ring.carrier(K)
  requires real : r ∈ ℝ
  requires inside : y ∈ normClosedBall(K, norm, x, r)
  shows normClosedBall(K, norm, y, r) = normClosedBall(K, norm, x, r)
proof
  have valued := normValuation.valuation at K, norm with normed, ultrametric
  have valuation := tkH.fv.valuation with valued
  obtain ⟨yK, yx⟩ := normClosedBall.membership.forward with inside
  have sw := Valuation.map_sub_swap at K, nnRealValues, norm, y, x with valuation, yK, member
  ext z
  constructor
  . intro hz
    obtain ⟨zK, zy⟩ := normClosedBall.membership.forward with hz
    have s := tkH.nf.ball_step at K, norm, x, y, z, r with normed, ultrametric, member, yK, zK, real, zy, yx
    apply normClosedBall.membership.backward
    exact ⟨zK, s⟩
  . intro hz
    obtain ⟨zK, zx⟩ := normClosedBall.membership.forward with hz
    have xy : RealLe(norm(Ring.sub(K, x, y)), r)
      rw ← sw
      exact yx
    have s := tkH.nf.ball_step at K, norm, y, x, z, r with normed, ultrametric, yK, member, zK, real, zx, xy
    apply normClosedBall.membership.backward
    exact ⟨zK, s⟩

end NonarchimedeanFields

-- Section: ℤ_p as a valuation subring
section PadicValued
variable (p : Nat)
hypothesis prime : Prime(p)

-- ℤ_p is the valuation subring of ℚ_p's norm (PadicInt and
-- Valued ℚ_[p]).
theorem padicIntCarrier.valuation_subring
  shows ValuationSubring(padicField(p), padicIntCarrier(p)) ∧
    padicIntCarrier(p) = valuationInteger(padicField(p), nnRealValues, padicNorm(p))
proof
  sorry

-- ℤ_p is p-adically complete (PadicInt.isAdicComplete,
-- IsAdicComplete (maximalIdeal ℤ_[p]) ℤ_[p]).
theorem padicIntRing.adic_complete
  shows AdicCompleteRing(padicIntRing(p), ringMultiples(padicIntRing(p), natCast(padicIntRing(p), p)))
proof
  sorry

-- The residue field of ℤ_p has p elements (PadicInt.residueField).
theorem padicIntRing.residue_card
  shows HasCardinality(Ring.carrier(residueField(padicIntRing(p))), p)
proof
  sorry

end PadicValued
