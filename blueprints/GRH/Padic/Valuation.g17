-- Valuations: linearly ordered commutative groups with zero as value
-- monoids (with ℝ≥0 as the standard one), Krull valuations of rings
-- (Valuation), their integers, maximal ideals and ball ideals
-- (Valuation.integer, leIdeal), equivalence of valuations
-- (Valuation.IsEquiv), valuation subrings of a field (ValuationSubring)
-- with their units, nonunits and principal units, the valuation of a
-- valuation subring with values in K^×/A^× (ValuationSubring.valuation),
-- valued fields and their topology (Valued), nonarchimedean groups and
-- norms (NonarchimedeanGroup, IsUltrametricDist), the valuation of a
-- nonarchimedean normed field (NormedField.valuation), and ℤ_p as the
-- valuation subring of ℚ_p, p-adically complete.
-- Part of the GRH blueprint.
-- Planned home: Algebra/Valuation.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Padic.Valuation
import GRH.Padic.Numbers
import GRH.Algebra.Completion

-- Section: Value monoids
-- A value monoid Γ₀: a carrier with a multiplication, one, zero, and an
-- order relation, built by ValueMonoid.mk and read back by its
-- projections (the data of Mathlib's LinearOrderedCommGroupWithZero).
structure ValueMonoid
  | carrier : Set
  | mul : Set
  | one : Set
  | zero : Set
  | le : Set

-- a ≤ b and a < b in Γ₀.
predicate ValueLe (Γ a b : Set) := relates(ValueMonoid.le(Γ), a, b)
predicate ValueLt (Γ a b : Set) := ValueLe(Γ, a, b) ∧ a ≠ b

-- The laws (LinearOrderedCommGroupWithZero): a commutative monoid with an
-- absorbing zero ≠ 1 whose nonzero elements form a group, linearly
-- ordered with zero least and multiplication monotone.
predicate LinearOrderedCommGroupWithZero (Γ : Set) :=
  FunctionBetween(ValueMonoid.mul(Γ), ValueMonoid.carrier(Γ) × ValueMonoid.carrier(Γ),
    ValueMonoid.carrier(Γ)) ∧
  ValueMonoid.one(Γ) ∈ ValueMonoid.carrier(Γ) ∧
  ValueMonoid.zero(Γ) ∈ ValueMonoid.carrier(Γ) ∧
  ValueMonoid.zero(Γ) ≠ ValueMonoid.one(Γ) ∧
  (∀ a ∈ ValueMonoid.carrier(Γ), ∀ b ∈ ValueMonoid.carrier(Γ), ∀ c ∈ ValueMonoid.carrier(Γ),
    call2(ValueMonoid.mul(Γ), call2(ValueMonoid.mul(Γ), a, b), c) =
      call2(ValueMonoid.mul(Γ), a, call2(ValueMonoid.mul(Γ), b, c))) ∧
  (∀ a ∈ ValueMonoid.carrier(Γ), ∀ b ∈ ValueMonoid.carrier(Γ),
    call2(ValueMonoid.mul(Γ), a, b) = call2(ValueMonoid.mul(Γ), b, a)) ∧
  (∀ a ∈ ValueMonoid.carrier(Γ), call2(ValueMonoid.mul(Γ), ValueMonoid.one(Γ), a) = a) ∧
  (∀ a ∈ ValueMonoid.carrier(Γ),
    call2(ValueMonoid.mul(Γ), ValueMonoid.zero(Γ), a) = ValueMonoid.zero(Γ)) ∧
  (∀ a ∈ ValueMonoid.carrier(Γ), a ≠ ValueMonoid.zero(Γ) →
    (∃ b ∈ ValueMonoid.carrier(Γ), call2(ValueMonoid.mul(Γ), a, b) = ValueMonoid.one(Γ))) ∧
  IsLinearOrder(ValueMonoid.carrier(Γ), ValueMonoid.le(Γ)) ∧
  (∀ a ∈ ValueMonoid.carrier(Γ), ValueLe(Γ, ValueMonoid.zero(Γ), a)) ∧
  (∀ a ∈ ValueMonoid.carrier(Γ), ∀ b ∈ ValueMonoid.carrier(Γ), ∀ c ∈ ValueMonoid.carrier(Γ),
    ValueLe(Γ, a, b) →
      ValueLe(Γ, call2(ValueMonoid.mul(Γ), a, c), call2(ValueMonoid.mul(Γ), b, c)))

-- ℝ≥0 with its multiplication and order (NNReal), the value monoid of
-- norms.
def nnReals : Set := { x ∈ ℝ | realZero ≤ x }

def nnRealMul : Set :=
  { q ∈ (nnReals × nnReals) × nnReals | snd(q) = realMulValue(fst(fst(q)), snd(fst(q))) }

def nnRealLe : Set := { q ∈ nnReals × nnReals | RealLe(fst(q), snd(q)) }

def nnRealValues : Set := ValueMonoid.mk(nnReals, nnRealMul, realOne, realZero, nnRealLe)

-- Section: Valuations
-- v : R → Γ₀ is a valuation (Valuation R Γ₀): v(0) = 0, v(1) = 1,
-- v(xy) = v(x) v(y), and v(x + y) ≤ max(v(x), v(y)).
predicate Valuation (R Γ v : Set) :=
  Ring(R) ∧ LinearOrderedCommGroupWithZero(Γ) ∧
  FunctionBetween(v, Ring.carrier(R), ValueMonoid.carrier(Γ)) ∧
  v(Ring.zero(R)) = ValueMonoid.zero(Γ) ∧ v(Ring.one(R)) = ValueMonoid.one(Γ) ∧
  (∀ x ∈ Ring.carrier(R), ∀ y ∈ Ring.carrier(R),
    v(call2(Ring.mul(R), x, y)) = call2(ValueMonoid.mul(Γ), v(x), v(y))) ∧
  (∀ x ∈ Ring.carrier(R), ∀ y ∈ Ring.carrier(R),
    ValueLe(Γ, v(call2(Ring.add(R), x, y)), v(x)) ∨
    ValueLe(Γ, v(call2(Ring.add(R), x, y)), v(y)))

-- The integers {v ≤ 1} (Valuation.integer, Valuation.valuationSubring),
-- the elements of value < 1, and the elements of value 1.
def valuationInteger (R Γ v : Set) : Set :=
  { x ∈ Ring.carrier(R) | ValueLe(Γ, v(x), ValueMonoid.one(Γ)) }

def valuationMaximal (R Γ v : Set) : Set :=
  { x ∈ Ring.carrier(R) | ValueLt(Γ, v(x), ValueMonoid.one(Γ)) }

def valuationUnits (R Γ v : Set) : Set :=
  { x ∈ Ring.carrier(R) | v(x) = ValueMonoid.one(Γ) }

-- The ideals {v ≤ γ} and {v < γ} of the integers (Valuation.leIdeal,
-- leSubmodule, leAddSubgroup; ltSubmodule, ltAddSubgroup).
def valuationLeIdeal (R Γ v γ : Set) : Set :=
  { x ∈ Ring.carrier(R) | ValueLe(Γ, v(x), γ) }

def valuationLtIdeal (R Γ v γ : Set) : Set :=
  { x ∈ Ring.carrier(R) | ValueLt(Γ, v(x), γ) }

-- Equivalent valuations induce the same order (Valuation.IsEquiv).
predicate ValuationEquiv (R Γ v Δ w : Set) :=
  Valuation(R, Γ, v) ∧ Valuation(R, Δ, w) ∧
  (∀ x ∈ Ring.carrier(R), ∀ y ∈ Ring.carrier(R),
    ValueLe(Γ, v(x), v(y)) ↔ ValueLe(Δ, w(x), w(y)))

-- The pullback v ∘ f along a ring homomorphism f : S → R (Valuation.comap).
def valuationComap (S v f : Set) : Set := { (x, v(f(x))) | x ∈ Ring.carrier(S) }

-- Section: Valuation subrings
-- A valuation subring of a field K (ValuationSubring K): a subring
-- containing x or x⁻¹ for every nonzero x.
predicate ValuationSubring (K A : Set) :=
  Field(K) ∧ CommRing(K) ∧ Subring(K, A) ∧
  (∀ x ∈ Ring.carrier(K), x ∈ A ∨
    (∃ y ∈ A, call2(Ring.mul(K), x, y) = Ring.one(K)))

-- Its units (ValuationSubring.unitGroup), nonunits (ValuationSubring.nonunits,
-- the maximal ideal), and principal units 1 + m (principalUnitGroup).
def valuationSubringUnits (K A : Set) : Set :=
  { x ∈ A | ∃ y ∈ A, call2(Ring.mul(K), x, y) = Ring.one(K) }

def valuationSubringNonunits (K A : Set) : Set := A ∖ valuationSubringUnits(K, A)

def principalUnits (K A : Set) : Set :=
  { x ∈ Ring.carrier(K) | x ≠ Ring.zero(K) ∧
    Ring.sub(K, x, Ring.one(K)) ∈ valuationSubringNonunits(K, A) }

-- The valuation of a valuation subring (ValuationSubring.valuation, with
-- values in ValuationSubring.ValueGroup): x ~ y when y = u x for a unit u
-- of A; the classes, with [x][y] = [xy] and [x] ≤ [y] when x = a y for
-- some a ∈ A.
def valueRelation (K A : Set) : Set :=
  { q ∈ Ring.carrier(K) × Ring.carrier(K) |
    ∃ u ∈ valuationSubringUnits(K, A), snd(q) = call2(Ring.mul(K), u, fst(q)) }

def valueClasses (K A : Set) : Set := Ring.carrier(K) ⧸ valueRelation(K, A)

def valueClass (K A x : Set) : Set := ⟦x⟧[Ring.carrier(K), valueRelation(K, A)]

def valueClassMul (K A : Set) : Set :=
  { q ∈ (valueClasses(K, A) × valueClasses(K, A)) × valueClasses(K, A) |
    ∃ x ∈ Ring.carrier(K), ∃ y ∈ Ring.carrier(K),
      q = ((valueClass(K, A, x), valueClass(K, A, y)),
        valueClass(K, A, call2(Ring.mul(K), x, y))) }

def valueClassLe (K A : Set) : Set :=
  { q ∈ valueClasses(K, A) × valueClasses(K, A) |
    ∃ x ∈ Ring.carrier(K), ∃ y ∈ Ring.carrier(K), ∃ a ∈ A,
      q = (valueClass(K, A, x), valueClass(K, A, y)) ∧ x = call2(Ring.mul(K), a, y) }

def valueGroupOf (K A : Set) : Set :=
  ValueMonoid.mk(valueClasses(K, A), valueClassMul(K, A), valueClass(K, A, Ring.one(K)),
    valueClass(K, A, Ring.zero(K)), valueClassLe(K, A))

def valuationOfSubring (K A : Set) : Set :=
  { (x, valueClass(K, A, x)) | x ∈ Ring.carrier(K) }

-- Section: Valued fields
-- A valued field (Valued K Γ₀): a field with a valuation; its topology,
-- in which U is open when around each x ∈ U some ball {y | v(y − x) < γ},
-- γ ≠ 0, lies in U (Valued.mk', Valuation.subgroups_basis).
predicate Valued (K Γ v : Set) := Field(K) ∧ CommRing(K) ∧ Valuation(K, Γ, v)

def valuationBall (K Γ v x γ : Set) : Set :=
  { y ∈ Ring.carrier(K) | ValueLt(Γ, v(Ring.sub(K, y, x)), γ) }

def valuationOpens (K Γ v : Set) : Set :=
  { U ∈ 𝒫(Ring.carrier(K)) | ∀ x ∈ U, ∃ γ ∈ ValueMonoid.carrier(Γ),
    γ ≠ ValueMonoid.zero(Γ) ∧ valuationBall(K, Γ, v, x, γ) ⊆ U }

def valuationSphere (K Γ v γ : Set) : Set := { x ∈ Ring.carrier(K) | v(x) = γ }

-- The sequence n ↦ xⁿ.
def powSequence (K x : Set) : Set := { (n, Ring.pow(K, x, n)) | n ∈ ℕ }

def valuationTopology (K Γ v : Set) : Set :=
  TopologicalSpace.mk(Ring.carrier(K), valuationOpens(K, Γ, v))

-- A nonarchimedean topological additive group: every neighbourhood of 0
-- contains an open subgroup (NonarchimedeanAddGroup).
predicate NonarchimedeanAddGroup (G X : Set) :=
  TopologicalGroup(G, X) ∧
  (∀ U, Neighborhood(X, U, Group.one(G)) → (∃ H, OpenSubgroup(H, G, X) ∧ H ⊆ U))

-- The unit ball and the closed balls of a normed field.
def normUnitBall (K norm : Set) : Set := { x ∈ Ring.carrier(K) | norm(x) ≤ realOne }

def normClosedBall (K norm x r : Set) : Set :=
  { y ∈ Ring.carrier(K) | RealLe(norm(Ring.sub(K, y, x)), r) }

-- Section: The value monoid ℝ≥0
-- ℝ≥0 is a linearly ordered commutative group with zero (NNReal's
-- LinearOrderedCommGroupWithZero instance).
theorem nnRealValues.ordered
  shows LinearOrderedCommGroupWithZero(nnRealValues)
proof
  sorry

-- Section: Laws of valuations
section Valuations
variable (R Γ v : Set)
hypothesis valuation : Valuation(R, Γ, v)

-- Valuation.map_neg, Valuation.map_sub_swap.
theorem Valuation.map_neg (x : Set)
  requires member : x ∈ Ring.carrier(R)
  shows v(apply(Ring.neg(R), x)) = v(x)
proof
  sorry

theorem Valuation.map_sub_swap (x y : Set)
  requires first : x ∈ Ring.carrier(R)
  requires second : y ∈ Ring.carrier(R)
  shows v(Ring.sub(R, x, y)) = v(Ring.sub(R, y, x))
proof
  sorry

-- Valuation.map_add_le, Valuation.map_sub_le: values ≤ γ are closed
-- under sums and differences; Valuation.map_add_lt, Valuation.map_sub_lt
-- the same for < γ.
theorem Valuation.map_add_le (x y γ : Set)
  requires first : x ∈ Ring.carrier(R)
  requires second : y ∈ Ring.carrier(R)
  requires left : ValueLe(Γ, v(x), γ)
  requires right : ValueLe(Γ, v(y), γ)
  shows ValueLe(Γ, v(call2(Ring.add(R), x, y)), γ)
proof
  sorry

theorem Valuation.map_sub_le (x y γ : Set)
  requires first : x ∈ Ring.carrier(R)
  requires second : y ∈ Ring.carrier(R)
  requires left : ValueLe(Γ, v(x), γ)
  requires right : ValueLe(Γ, v(y), γ)
  shows ValueLe(Γ, v(Ring.sub(R, x, y)), γ)
proof
  sorry

theorem Valuation.map_add_lt (x y γ : Set)
  requires first : x ∈ Ring.carrier(R)
  requires second : y ∈ Ring.carrier(R)
  requires left : ValueLt(Γ, v(x), γ)
  requires right : ValueLt(Γ, v(y), γ)
  shows ValueLt(Γ, v(call2(Ring.add(R), x, y)), γ)
proof
  sorry

theorem Valuation.map_sub_lt (x y γ : Set)
  requires first : x ∈ Ring.carrier(R)
  requires second : y ∈ Ring.carrier(R)
  requires left : ValueLt(Γ, v(x), γ)
  requires right : ValueLt(Γ, v(y), γ)
  shows ValueLt(Γ, v(Ring.sub(R, x, y)), γ)
proof
  sorry

-- Valuation.map_add_eq_of_lt_right, Valuation.map_sub_eq_of_lt_right:
-- v(x) < v(y) gives v(x + y) = v(x − y) = v(y).
theorem Valuation.map_add_eq_of_lt_right (x y : Set)
  requires first : x ∈ Ring.carrier(R)
  requires second : y ∈ Ring.carrier(R)
  requires lt : ValueLt(Γ, v(x), v(y))
  shows v(call2(Ring.add(R), x, y)) = v(y)
proof
  sorry

theorem Valuation.map_sub_eq_of_lt_right (x y : Set)
  requires first : x ∈ Ring.carrier(R)
  requires second : y ∈ Ring.carrier(R)
  requires lt : ValueLt(Γ, v(x), v(y))
  shows v(Ring.sub(R, x, y)) = v(y)
proof
  sorry

-- Valuation.map_eq_of_sub_lt: v(y − x) < v(x) gives v(y) = v(x).
theorem Valuation.map_eq_of_sub_lt (x y : Set)
  requires first : x ∈ Ring.carrier(R)
  requires second : y ∈ Ring.carrier(R)
  requires lt : ValueLt(Γ, v(Ring.sub(R, y, x)), v(x))
  shows v(y) = v(x)
proof
  sorry

-- Valuation.map_one_add_of_lt, Valuation.map_one_sub_of_lt.
theorem Valuation.map_one_add_of_lt (x : Set)
  requires member : x ∈ Ring.carrier(R)
  requires lt : ValueLt(Γ, v(x), ValueMonoid.one(Γ))
  shows v(call2(Ring.add(R), Ring.one(R), x)) = ValueMonoid.one(Γ)
proof
  sorry

theorem Valuation.map_one_sub_of_lt (x : Set)
  requires member : x ∈ Ring.carrier(R)
  requires lt : ValueLt(Γ, v(x), ValueMonoid.one(Γ))
  shows v(Ring.sub(R, Ring.one(R), x)) = ValueMonoid.one(Γ)
proof
  sorry

-- Valuation.map_sum_lt': a finite sum of terms of value < γ, γ ≠ 0, has
-- value < γ.
theorem Valuation.map_sum_lt (V w γ : Set)
  requires comm : CommRing(R)
  requires finite : Finite(V)
  requires terms : FunctionBetween(w, V, Ring.carrier(R))
  requires nonzero : γ ≠ ValueMonoid.zero(Γ)
  requires bound : ∀ i ∈ V, ValueLt(Γ, v(w(i)), γ)
  shows ValueLt(Γ, v(finiteRingSum(V, Ring.carrier(R), Ring.add(R), Ring.zero(R),
    Ring.neg(R), Ring.mul(R), Ring.one(R), w)), γ)
proof
  sorry

-- The integers form a subring and the ball sets are ideals of it
-- (Valuation.integer, Valuation.leIdeal, Valuation.ltSubmodule).
theorem valuationInteger.subring
  shows Subring(R, valuationInteger(R, Γ, v))
proof
  sorry

theorem valuationLeIdeal.ideal (γ : Set)
  requires comm : CommRing(R)
  requires member : γ ∈ ValueMonoid.carrier(Γ)
  requires small : ValueLe(Γ, γ, ValueMonoid.one(Γ))
  shows Ideal(subringRing(R, valuationInteger(R, Γ, v)), valuationLeIdeal(R, Γ, v, γ)) ∧
    Ideal(subringRing(R, valuationInteger(R, Γ, v)), valuationLtIdeal(R, Γ, v, γ))
proof
  sorry

-- Valuation.comap is a valuation, with value v(f(x)) (Valuation.comap_apply).
theorem valuationComap.valuation (S f : Set)
  requires hom : (f : S →+* R)
  shows Valuation(S, Γ, valuationComap(S, v, f))
proof
  sorry

theorem valuationComap.apply (S f x : Set)
  requires member : x ∈ Ring.carrier(S)
  shows valuationComap(S, v, f)(x) = v(f(x))
proof
  sorry

end Valuations

-- Section: Valuations on fields
section FieldValuations
variable (K Γ v : Set)
hypothesis valued : Valued(K, Γ, v)

-- Valuation.pos_iff, Valuation.zero_iff: v(x) = 0 only at x = 0.
theorem Valuation.eq_zero_iff (x : Set)
  requires member : x ∈ Ring.carrier(K)
  shows v(x) = ValueMonoid.zero(Γ) ↔ x = Ring.zero(K)
proof
  sorry

-- Valuation.map_inv: v(x⁻¹) v(x) = 1 for x ≠ 0.
theorem Valuation.map_inv (x y : Set)
  requires first : x ∈ Ring.carrier(K)
  requires second : y ∈ Ring.carrier(K)
  requires inverse : call2(Ring.mul(K), x, y) = Ring.one(K)
  shows call2(ValueMonoid.mul(Γ), v(y), v(x)) = ValueMonoid.one(Γ)
proof
  sorry

-- Valuation.valuationSubring: the integers of a valuation on a field are
-- a valuation subring.
theorem valuationInteger.valuation_subring
  shows ValuationSubring(K, valuationInteger(K, Γ, v))
proof
  sorry

-- Valuation.integer.integers: in the integers, the units are the elements
-- of value 1 (Valuation.Integers.isUnit_iff_valuation_eq_one) and the
-- maximal ideal is {v < 1} (Valuation.mem_maximalIdeal_iff,
-- Valuation.mem_unitGroup_iff).
theorem valuationInteger.unit_iff (x : Set)
  requires member : x ∈ valuationInteger(K, Γ, v)
  shows RingUnit(subringRing(K, valuationInteger(K, Γ, v)), x) ↔ v(x) = ValueMonoid.one(Γ)
proof
  sorry

theorem valuationInteger.maximal_ideal
  shows LocalRing(subringRing(K, valuationInteger(K, Γ, v))) ∧
    localMaximalIdeal(subringRing(K, valuationInteger(K, Γ, v))) = valuationMaximal(K, Γ, v)
proof
  sorry

-- Valuation.Integers.mem_of_integral: the integers are integrally closed
-- in K.
theorem valuationInteger.mem_of_integral (x : Set)
  requires member : x ∈ Ring.carrier(K)
  requires integral : IntegralElement(Algebra.mk(subringRing(K, valuationInteger(K, Γ, v)), K,
    identity(valuationInteger(K, Γ, v))), x)
  shows x ∈ valuationInteger(K, Γ, v)
proof
  sorry

-- Valuation.isEquiv_iff_valuationSubring: two valuations of a field are
-- equivalent exactly when they have the same integers; and
-- Valuation.isEquiv_of_val_le_one.
theorem ValuationEquiv.iff_integer (Δ w : Set)
  requires other : Valued(K, Δ, w)
  shows ValuationEquiv(K, Γ, v, Δ, w) ↔ valuationInteger(K, Γ, v) = valuationInteger(K, Δ, w)
proof
  sorry

theorem ValuationEquiv.of_le_one (Δ w : Set)
  requires other : Valued(K, Δ, w)
  requires same : ∀ x ∈ Ring.carrier(K),
    ValueLe(Γ, v(x), ValueMonoid.one(Γ)) ↔ ValueLe(Δ, w(x), ValueMonoid.one(Δ))
  shows ValuationEquiv(K, Γ, v, Δ, w)
proof
  sorry

-- Valuation.IsEquiv.le_one_iff_le_one, lt_one_iff_lt_one, eq_one_iff_eq_one.
theorem ValuationEquiv.one_iff (Δ w x : Set)
  requires equivalent : ValuationEquiv(K, Γ, v, Δ, w)
  requires member : x ∈ Ring.carrier(K)
  shows (ValueLe(Γ, v(x), ValueMonoid.one(Γ)) ↔ ValueLe(Δ, w(x), ValueMonoid.one(Δ))) ∧
    (ValueLt(Γ, v(x), ValueMonoid.one(Γ)) ↔ ValueLt(Δ, w(x), ValueMonoid.one(Δ))) ∧
    (v(x) = ValueMonoid.one(Γ) ↔ w(x) = ValueMonoid.one(Δ))
proof
  sorry

-- Valuation.isEquiv_valuation_valuationSubring: v is equivalent to the
-- valuation of its valuation subring.
theorem ValuationEquiv.of_subring
  shows ValuationEquiv(K, Γ, v, valueGroupOf(K, valuationInteger(K, Γ, v)),
    valuationOfSubring(K, valuationInteger(K, Γ, v)))
proof
  sorry

-- Section: The topology of a valued field
-- The valuation topology is a topology making K a topological ring
-- (Valued.isTopologicalRing), nonarchimedean (Valued.isNonarchimedean).
theorem valuationTopology.topological_ring
  shows TopologicalRing(K, valuationTopology(K, Γ, v)) ∧
    NonarchimedeanAddGroup(Ring.additive(K), valuationTopology(K, Γ, v))
proof
  sorry

-- Valued.mem_nhds: U is a neighbourhood of x exactly when it contains a
-- ball {y | v(y − x) < γ} with γ ≠ 0.
theorem valuationTopology.mem_nhds (U x : Set)
  requires member : x ∈ Ring.carrier(K)
  shows Neighborhood(valuationTopology(K, Γ, v), U, x) ↔
    U ⊆ Ring.carrier(K) ∧ (∃ γ ∈ ValueMonoid.carrier(Γ),
      γ ≠ ValueMonoid.zero(Γ) ∧ valuationBall(K, Γ, v, x, γ) ⊆ U)
proof
  sorry

-- Valued.isOpen_ball, Valued.isOpen_sphere: {v < γ} and, for γ ≠ 0,
-- {v = γ} are open.
theorem valuationTopology.open_ball (γ : Set)
  requires member : γ ∈ ValueMonoid.carrier(Γ)
  shows valuationLtIdeal(K, Γ, v, γ) ∈ valuationOpens(K, Γ, v)
proof
  sorry

theorem valuationTopology.open_sphere (γ : Set)
  requires member : γ ∈ ValueMonoid.carrier(Γ)
  requires nonzero : γ ≠ ValueMonoid.zero(Γ)
  shows valuationSphere(K, Γ, v, γ) ∈ valuationOpens(K, Γ, v)
proof
  sorry

-- Valued.isOpen_integer, Valued.isOpen_valuationSubring,
-- Valued.isClosed_integer: the integers are open and closed.
theorem valuationTopology.integer_clopen
  shows Clopen(valuationTopology(K, Γ, v), valuationInteger(K, Γ, v))
proof
  sorry

-- Valued.locally_const: v is locally constant away from 0.
theorem valuationTopology.locally_const (x : Set)
  requires member : x ∈ Ring.carrier(K)
  requires nonzero : x ≠ Ring.zero(K)
  shows Neighborhood(valuationTopology(K, Γ, v), valuationSphere(K, Γ, v, v(x)), x)
proof
  sorry

-- Valued.tendsto_zero_pow_of_v_lt_one: xⁿ → 0 when v(x) < 1.
theorem valuationTopology.pow_tendsto_zero (x : Set)
  requires member : x ∈ Ring.carrier(K)
  requires small : ValueLt(Γ, v(x), ValueMonoid.one(Γ))
  shows Converges(valuationTopology(K, Γ, v), powSequence(K, x), Ring.zero(K))
proof
  sorry

end FieldValuations

-- Section: Valuation subrings
section ValuationSubrings
variable (K A : Set)
hypothesis subring : ValuationSubring(K, A)

-- A valuation subring is a local valuation ring (ValuationSubring's
-- ValuationRing and IsLocalRing instances), with maximal ideal its
-- nonunits.
theorem ValuationSubring.valuation_ring
  shows ValuationRing(subringRing(K, A)) ∧ LocalRing(subringRing(K, A)) ∧
    localMaximalIdeal(subringRing(K, A)) = valuationSubringNonunits(K, A)
proof
  sorry

-- ValuationSubring.valuation is a valuation whose integers are A
-- (ValuationSubring.valuation_le_one_iff, mem_of_valuation_le_one,
-- valuationSubring_valuation).
theorem valuationOfSubring.valuation
  shows Valued(K, valueGroupOf(K, A), valuationOfSubring(K, A)) ∧
    valuationInteger(K, valueGroupOf(K, A), valuationOfSubring(K, A)) = A
proof
  sorry

-- ValuationSubring.valuation_eq_one_iff, ValuationSubring.valuation_lt_one_iff.
theorem valuationOfSubring.eq_one_iff (x : Set)
  requires member : x ∈ A
  shows valuationOfSubring(K, A)(x) = ValueMonoid.one(valueGroupOf(K, A)) ↔
    x ∈ valuationSubringUnits(K, A)
proof
  sorry

theorem valuationOfSubring.lt_one_iff (x : Set)
  requires member : x ∈ A
  shows ValueLt(valueGroupOf(K, A), valuationOfSubring(K, A)(x),
      ValueMonoid.one(valueGroupOf(K, A))) ↔
    x ∈ valuationSubringNonunits(K, A)
proof
  sorry

-- ValuationSubring.mem_nonunits_iff_exists_mem_maximalIdeal,
-- coe_mem_nonunits_iff: for a valuation with integers A, the nonunits of
-- A are the elements of value < 1.
theorem valuationSubringNonunits.iff (Γ v x : Set)
  requires valued : Valued(K, Γ, v)
  requires integers : valuationInteger(K, Γ, v) = A
  requires member : x ∈ Ring.carrier(K)
  shows x ∈ valuationSubringNonunits(K, A) ↔ ValueLt(Γ, v(x), ValueMonoid.one(Γ))
proof
  sorry

-- ValuationSubring.principalUnitGroup: x is a principal unit when
-- v(x − 1) < 1.
theorem principalUnits.iff (Γ v x : Set)
  requires valued : Valued(K, Γ, v)
  requires integers : valuationInteger(K, Γ, v) = A
  requires member : x ∈ Ring.carrier(K)
  shows x ∈ principalUnits(K, A) ↔
    ValueLt(Γ, v(Ring.sub(K, x, Ring.one(K))), ValueMonoid.one(Γ))
proof
  sorry

-- ValuationSubring.surjective_unitGroupToResidueFieldUnits: every unit of
-- the residue field lifts to a unit of A.
theorem valuationSubringUnits.residue_surjective (c : Set)
  requires unit : RingUnit(residueField(subringRing(K, A)), c)
  shows ∃ x ∈ valuationSubringUnits(K, A), residueMap(subringRing(K, A))(x) = c
proof
  sorry

end ValuationSubrings

-- LocalSubring.exists_le_valuationSubring: a local subring B of a field
-- is dominated by a valuation subring (Chevalley; the proof uses Zorn's
-- lemma).
theorem ValuationSubring.exists_dominating (K B : Set)
  requires field : Field(K)
  requires comm : CommRing(K)
  requires subring : Subring(K, B)
  requires local : LocalRing(subringRing(K, B))
  shows ∃ A, ValuationSubring(K, A) ∧ B ⊆ A ∧
    localMaximalIdeal(subringRing(K, B)) ⊆ valuationSubringNonunits(K, A)
proof
  sorry

-- ValuationRing.iff_dvd_total and PreValuationRing.iff_dvd_total: a
-- domain is a valuation ring exactly when it is a pre-valuation ring.
theorem ValuationRing.iff_pre (R : Set)
  requires domain : IntegralDomain(R)
  requires comm : CommRing(R)
  shows ValuationRing(R) ↔ PreValuationRing(R)
proof
  sorry

-- Section: Nonarchimedean normed fields
section NonarchimedeanFields
variable (K norm : Set)
hypothesis normed : NormedField(K, norm)
hypothesis ultrametric : NonarchimedeanNorm(K, norm)

-- NormedField.valuation, Valuation.norm_def: the norm of a nonarchimedean
-- normed field is a valuation with values in ℝ≥0, and its topology is the
-- norm topology (Valued.toNormedField, NormedField.toValued).
theorem normValuation.valuation
  shows Valued(K, nnRealValues, norm)
proof
  sorry

theorem normValuation.topology
  shows valuationTopology(K, nnRealValues, norm) = normTopology(Ring.additive(K), norm)
proof
  sorry

-- The unit ball is a valuation subring (Valued.integer), its units are
-- the elements of norm 1 (Valued.integer.isUnit_iff_norm_eq_one), and it
-- is open (Valued.isOpen_integer).
theorem normUnitBall.valuation_subring
  shows ValuationSubring(K, normUnitBall(K, norm)) ∧
    normUnitBall(K, norm) = valuationInteger(K, nnRealValues, norm)
proof
  sorry

theorem normUnitBall.unit_iff (x : Set)
  requires member : x ∈ normUnitBall(K, norm)
  shows RingUnit(subringRing(K, normUnitBall(K, norm)), x) ↔ norm(x) = realOne
proof
  sorry

-- IsUltrametricDist.norm_add_eq_max_of_norm_ne_norm and
-- norm_sub_eq_max_of_norm_sub_ne_norm_sub, in the case ‖x‖ < ‖y‖.
theorem NonarchimedeanNorm.add_eq_of_lt (x y : Set)
  requires first : x ∈ Ring.carrier(K)
  requires second : y ∈ Ring.carrier(K)
  requires lt : norm(x) < norm(y)
  shows norm(call2(Ring.add(K), x, y)) = norm(y)
proof
  sorry

-- IsUltrametricDist.norm_natCast_le_one, norm_intCast_le_one.
theorem NonarchimedeanNorm.nat_le_one (n : Nat)
  shows norm(natCast(K, n)) ≤ realOne
proof
  sorry

theorem NonarchimedeanNorm.int_le_one (z : Set)
  requires integer : z ∈ ℤ
  shows norm(intCastHom(K)(z)) ≤ realOne
proof
  sorry

-- IsUltrametricDist.isClosed_ball, isOpen_closedBall,
-- closedBall_eq_of_mem: closed balls of positive radius are open and
-- closed, and every point of a closed ball is a centre.
theorem normClosedBall.clopen (x r : Set)
  requires member : x ∈ Ring.carrier(K)
  requires real : r ∈ ℝ
  requires positive : realZero < r
  shows Clopen(normTopology(Ring.additive(K), norm), normClosedBall(K, norm, x, r))
proof
  sorry

theorem normClosedBall.eq_of_mem (x y r : Set)
  requires member : x ∈ Ring.carrier(K)
  requires real : r ∈ ℝ
  requires inside : y ∈ normClosedBall(K, norm, x, r)
  shows normClosedBall(K, norm, y, r) = normClosedBall(K, norm, x, r)
proof
  sorry

end NonarchimedeanFields

-- Section: ℤ_p as a valuation subring
section PadicValued
variable (p : Nat)
hypothesis prime : Prime(p)

-- ℤ_p is the valuation subring of ℚ_p's norm (PadicInt and
-- Valued ℚ_[p]).
theorem padicIntCarrier.valuation_subring
  shows ValuationSubring(padicField(p), padicIntCarrier(p)) ∧
    padicIntCarrier(p) = valuationInteger(padicField(p), nnRealValues, padicNorm(p))
proof
  sorry

-- ℤ_p is p-adically complete (PadicInt.isAdicComplete,
-- IsAdicComplete (maximalIdeal ℤ_[p]) ℤ_[p]).
theorem padicIntRing.adic_complete
  shows AdicCompleteRing(padicIntRing(p), ringMultiples(padicIntRing(p), natCast(padicIntRing(p), p)))
proof
  sorry

-- The residue field of ℤ_p has p elements (PadicInt.residueField).
theorem padicIntRing.residue_card
  shows HasCardinality(Ring.carrier(residueField(padicIntRing(p))), p)
proof
  sorry

end PadicValued
