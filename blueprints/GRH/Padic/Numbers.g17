-- The p-adic numbers: the p-adic valuation of naturals, integers and
-- rationals (padicValNat, padicValInt, padicValRat) with Legendre's
-- formula, the p-adic absolute value on ℚ (padicNorm), the completion of
-- a normed field as classes of Cauchy sequences, ℚ_p as the completion of
-- ℚ for the p-adic absolute value (Padic), its norm and valuation, the
-- p-adic integers ℤ_p as its unit ball (PadicInt), and the reductions
-- ℤ_p → ℤ/pⁿℤ (PadicInt.toZModPow) that identify ℤ_p with the inverse
-- limit of the ℤ/pⁿℤ.
-- Part of the GRH blueprint.
-- Planned home: NumberTheory/Padic/Numbers.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Padic.Numbers
import GRH.Cyclotomy.Fields
import GRH.Algebra.DVR
import GRH.Normed.Groups

-- Section: The p-adic valuation of naturals, integers and rationals
-- v_p(n): the largest k with p^k ∣ n, and 0 when n = 0 or p ≤ 1
-- (padicValNat p n, which Mathlib defines for every p in the same way).
defunique padicValNat (p n : Nat) (k ∈ ℕ) :=
  ((n = (0:N) ∨ p ≤ 1) ∧ k = (0:N)) ∨
  (n ≠ (0:N) ∧ 1 < p ∧ p ^ k ∣ n ∧ ¬(p ^ succ(k) ∣ n))
proof
  sorry
uniqueness
  sorry

-- v_p(z) = v_p(|z|) (padicValInt p z).
def padicValInt (p : Nat, z : Set) : Set := padicValNat(p, integerNatAbs(z))

-- v_p(q) for q ∈ ℚ, q = (a − b)/m: v_p(|a − b|) − v_p(m), independent of
-- the representation for p prime; 0 at q = 0 (padicValRat p q).
defunique padicValRat (p : Nat, q : Set) (k ∈ ℤ) :=
  (q = rationalZero ∧ k = integerZero) ∨
  (q ≠ rationalZero ∧ (∃ a ∈ ℕ, ∃ b ∈ ℕ, ∃ m ∈ ℕ, m ≠ 0 ∧
    q = rationalClass(a, b, m) ∧
    k = integerAddValue(integerOfNat(padicValNat(p, integerNatAbs(integerClass(a, b)))),
      integerNegValue(integerOfNat(padicValNat(p, m))))))
requires prime : Prime(p)
requires member : q ∈ ℚ
proof
  sorry
uniqueness
  sorry

-- The p-adic absolute value on ℚ: |q|_p = p^(−v_p(q)), |0|_p = 0
-- (padicNorm p), as a value and as a function ℚ → ℝ.
defunique ratPadicNormValue (p : Nat, q : Set) (y ∈ ℝ) :=
  (q = rationalZero ∧ y = realZero) ∨
  (q ≠ rationalZero ∧ y = realZpow(realNat(p), integerNegValue(padicValRat(p, q))))
requires prime : Prime(p)
requires member : q ∈ ℚ
proof
  sorry
uniqueness
  sorry

def ratPadicNorm (p : Nat) : Set := { (q, ratPadicNormValue(p, q)) | q ∈ ℚ }

-- Legendre's formula: the family i ↦ ⌊n / p^i⌋ and the set {1, …, b − 1}.
def legendreTerms (p n : Nat) : Set := { (i, quotientNat(n, pow(p, i))) | i ∈ ℕ }

def natIco (a b : Nat) : Set := b ∖ a

-- Section: ℚ_p and ℤ_p
-- ℚ_[p]: the completion of ℚ for |·|_p (Padic p), its norm (‖·‖ on
-- Padic), the embedding of ℚ (Rat.cast), and the valuation (Padic.valuation;
-- defined for x ≠ 0 by ‖x‖ = p^(−v(x)), where Mathlib sets v(0) = 0).
def padicField (p : Nat) : Set := normCompletion(rationalRing, ratPadicNorm(p))

def padicNorm (p : Nat) : Set := normCompletionNorm(rationalRing, ratPadicNorm(p))

def padicOfRat (p : Nat) : Set := normCompletionOf(rationalRing, ratPadicNorm(p))

defunique padicValuation (p : Nat, x : Set) (k ∈ ℤ) :=
  padicNorm(p)(x) = realZpow(realNat(p), integerNegValue(k))
requires prime : Prime(p)
requires member : x ∈ Ring.carrier(padicField(p))
requires nonzero : x ≠ Ring.zero(padicField(p))
proof
  sorry
uniqueness
  sorry

-- ℤ_[p] = {x ∈ ℚ_p | ‖x‖ ≤ 1} (PadicInt, PadicInt.subring), as a ring.
def padicIntCarrier (p : Nat) : Set :=
  { x ∈ Ring.carrier(padicField(p)) | padicNorm(p)(x) ≤ realOne }

def padicIntRing (p : Nat) : Set := subringRing(padicField(p), padicIntCarrier(p))

-- The reduction ℤ_p → ℤ/pⁿℤ (PadicInt.toZModPow n): x ↦ the class of any
-- integer a with ‖x − a‖ ≤ p^(−n); and ℤ_p → ℤ/pℤ (PadicInt.toZMod).
defunique padicToZModPowValue (p n : Nat, x : Set) (c ∈ Ring.carrier(zmod(p ^ n))) :=
  ∃ a ∈ ℤ, zmodCast(p ^ n)(a) = c ∧
    padicNorm(p)(Ring.sub(padicField(p), x, intCastHom(padicField(p))(a))) ≤
      realZpow(realNat(p), integerNegValue(integerOfNat(n)))
requires prime : Prime(p)
requires member : x ∈ padicIntCarrier(p)
proof
  sorry
uniqueness
  sorry

def padicToZModPow (p n : Nat) : Set :=
  { (x, padicToZModPowValue(p, n, x)) | x ∈ padicIntCarrier(p) }

def padicToZMod (p : Nat) : Set := padicToZModPow(p, 1)

-- The compatible families (cₙ) with cₙ ∈ ℤ/pⁿℤ and cₘ the reduction of cₙ
-- for m ≤ n: the inverse limit lim ℤ/pⁿℤ, as a set of sequences.
def zmodPowCarriers (p : Nat) : Set := { Ring.carrier(zmod(pow(p, n))) | n ∈ ℕ }

def zmodPowLimit (p : Nat) : Set :=
  { c ∈ functionSpace(ℕ, ⋃(zmodPowCarriers(p))) |
    (∀ n ∈ ℕ, c(n) ∈ Ring.carrier(zmod(p ^ n))) ∧
    (∀ m ∈ ℕ, ∀ n ∈ ℕ, m ≤ n → ∀ a ∈ ℤ, c(n) = zmodCast(p ^ n)(a) →
      c(m) = zmodCast(p ^ m)(a)) }

-- The map x ↦ (toZModPow n x)ₙ into the inverse limit.
def padicToLimitSeq (p x : Set) : Set := { (n, padicToZModPow(p, n)(x)) | n ∈ ℕ }

def padicToLimit (p : Nat) : Set :=
  { (x, padicToLimitSeq(p, x)) | x ∈ padicIntCarrier(p) }

-- The digit sum of n in base p: Σᵢ ⌊n / pⁱ⌋ mod p over i ≤ n
-- ((Nat.digits p n).sum for p ≥ 2).
def natDigitTerms (p n : Nat) : Set := { (i, quotientNat(n, pow(p, i)) % p) | i ∈ ℕ }

def natDigitSum (p n : Nat) : Set := natSum(succ(n), natDigitTerms(p, n))

-- Section: Laws of the p-adic valuation
section PadicValuations
variable (p : Nat)
hypothesis prime : Prime(p)

-- padicValNat.zero, padicValNat.one, padicValNat.self, padicValNat.prime_pow.
theorem padicValNat.zero
  shows padicValNat(p, 0) = 0
proof
  sorry

theorem padicValNat.one
  shows padicValNat(p, 1) = 0
proof
  sorry

theorem padicValNat.self
  shows padicValNat(p, p) = 1
proof
  sorry

theorem padicValNat.prime_pow (n : Nat)
  shows padicValNat(p, p ^ n) = n
proof
  sorry

-- padicValNat.mul: v(ab) = v(a) + v(b) for a, b ≠ 0.
theorem padicValNat.mul (a b : Nat)
  requires left : a ≠ 0
  requires right : b ≠ 0
  shows padicValNat(p, mul(a, b)) = add(padicValNat(p, a), padicValNat(p, b))
proof
  sorry

-- pow_padicValNat_dvd, padicValNat_dvd_iff_le, padicValNat_dvd_iff.
theorem padicValNat.pow_dvd (n : Nat)
  shows p ^ padicValNat(p, n) ∣ n
proof
  sorry

theorem padicValNat.dvd_iff_le (n k : Nat)
  requires nonzero : n ≠ 0
  shows p ^ k ∣ n ↔ k ≤ padicValNat(p, n)
proof
  sorry

theorem padicValNat.dvd_iff (n k : Nat)
  shows p ^ k ∣ n ↔ n = 0 ∨ k ≤ padicValNat(p, n)
proof
  sorry

-- padicValNat.eq_zero_of_not_dvd, one_le_padicValNat_of_dvd.
theorem padicValNat.eq_zero_of_not_dvd (n : Nat)
  requires coprime : ¬(p ∣ n)
  shows padicValNat(p, n) = 0
proof
  sorry

theorem padicValNat.one_le_of_dvd (n : Nat)
  requires nonzero : n ≠ 0
  requires divides : p ∣ n
  shows 1 ≤ padicValNat(p, n)
proof
  sorry

-- padicValNat_le_nat_log, read as p^v(n) ≤ n.
theorem padicValNat.pow_le (n : Nat)
  requires nonzero : n ≠ 0
  shows p ^ padicValNat(p, n) ≤ n
proof
  sorry

-- Legendre's formula (padicValNat_factorial): for n < p^b,
-- v(n!) = Σ_{1 ≤ i < b} ⌊n / pⁱ⌋.
theorem padicValNat.factorial (n b : Nat)
  requires bound : n < p ^ b
  shows padicValNat(p, factorial(n)) = natSum(natIco(1, b), legendreTerms(p, n))
proof
  sorry

-- sub_one_mul_padicValNat_factorial: (p − 1) v(n!) = n − (digit sum).
theorem padicValNat.sub_one_mul_factorial (n : Nat)
  shows mul(sub(p, 1), padicValNat(p, factorial(n))) = sub(n, natDigitSum(p, n))
proof
  sorry

-- padicValNat_factorial_lt_of_ne_zero: (p − 1) v(n!) < n for n ≠ 0.
theorem padicValNat.factorial_lt (n : Nat)
  requires nonzero : n ≠ 0
  shows mul(sub(p, 1), padicValNat(p, factorial(n))) < n
proof
  sorry

-- padicValNat_factorial_mul: v((p n)!) = v(n!) + n.
theorem padicValNat.factorial_mul (n : Nat)
  shows padicValNat(p, factorial(mul(p, n))) = add(padicValNat(p, factorial(n)), n)
proof
  sorry

-- padicValNat_mul_div_factorial: v((p ⌊n / p⌋)!) = v(n!).
theorem padicValNat.mul_div_factorial (n : Nat)
  shows padicValNat(p, factorial(mul(p, quotientNat(n, p)))) = padicValNat(p, factorial(n))
proof
  sorry

-- padicValInt.eq_zero_iff (with p ≠ 1), padicValInt.mul.
theorem padicValInt.eq_zero_iff (z : Set)
  requires integer : z ∈ ℤ
  shows padicValInt(p, z) = 0 ↔ z = integerZero ∨ ¬IntegerDivides(integerOfNat(p), z)
proof
  sorry

theorem padicValInt.mul (y z : Set)
  requires first : y ∈ ℤ
  requires second : z ∈ ℤ
  requires left : y ≠ integerZero
  requires right : z ≠ integerZero
  shows padicValInt(p, integerMulValue(y, z)) = add(padicValInt(p, y), padicValInt(p, z))
proof
  sorry

-- padicValRat.of_nat and padicValRat.mul.
theorem padicValRat.of_nat (n : Nat)
  shows padicValRat(p, rationalClass(n, 0, 1)) = integerOfNat(padicValNat(p, n))
proof
  sorry

theorem padicValRat.mul (q r : Set)
  requires first : q ∈ ℚ
  requires second : r ∈ ℚ
  requires left : q ≠ rationalZero
  requires right : r ≠ rationalZero
  shows padicValRat(p, rationalMulValue(q, r)) =
    integerAddValue(padicValRat(p, q), padicValRat(p, r))
proof
  sorry

-- Section: The p-adic absolute value on ℚ
-- padicNorm is a nonarchimedean absolute value (padicNorm.nonarchimedean,
-- padicNorm.mul, padicNorm.triangle_ineq, padicNorm.zero_of_padicNorm_eq_zero).
theorem ratPadicNorm.nonarchimedean
  shows NormedField(rationalRing, ratPadicNorm(p)) ∧
    NonarchimedeanNorm(rationalRing, ratPadicNorm(p))
proof
  sorry

-- padicNorm.padicNorm_p: |p|_p = 1/p.
theorem ratPadicNorm.p
  shows realMulValue(ratPadicNorm(p)(rationalClass(p, 0, 1)), realNat(p)) = realOne
proof
  sorry

-- padicNorm.of_int: |z|_p ≤ 1 for z = a − b ∈ ℤ.
theorem ratPadicNorm.int_le_one (a b : Nat)
  shows ratPadicNorm(p)(rationalClass(a, b, 1)) ≤ realOne
proof
  sorry

-- padicNorm.int_lt_one_iff: |z|_p < 1 ↔ p ∣ z.
theorem ratPadicNorm.int_lt_one_iff (a b : Nat)
  shows ratPadicNorm(p)(rationalClass(a, b, 1)) < realOne ↔
    IntegerDivides(integerOfNat(p), integerClass(a, b))
proof
  sorry

end PadicValuations

-- Section: ℚ_p
section PadicField
variable (p : Nat)
hypothesis prime : Prime(p)

-- ℚ_[p] is a complete nonarchimedean normed field, nontrivially normed
-- (Padic.field, Padic.normedField, Padic.complete, Padic.nonarchimedean).
theorem padicField.normed_field
  shows NontriviallyNormedField(padicField(p), padicNorm(p)) ∧
    NonarchimedeanNorm(padicField(p), padicNorm(p))
proof
  sorry

theorem padicField.complete
  shows NormComplete(padicField(p), padicNorm(p))
proof
  sorry

-- ℚ_[p] has characteristic zero (Padic.charZero).
theorem padicField.char_zero (n : Nat)
  requires zero : natCast(padicField(p), n) = Ring.zero(padicField(p))
  shows n = 0
proof
  sorry

-- The embedding of ℚ is a ring homomorphism with dense image, and the
-- norm extends |·|_p (Padic.eq_padicNorm, Padic.coe_add, Padic.denseRange_ratCast).
theorem padicOfRat.ring_hom
  shows (padicOfRat(p) : rationalRing →+* padicField(p))
proof
  sorry

theorem padicNorm.of_rat (q : Set)
  requires member : q ∈ ℚ
  shows padicNorm(p)(padicOfRat(p)(q)) = ratPadicNorm(p)(q)
proof
  sorry

theorem padicOfRat.dense
  shows Dense(normTopology(Ring.additive(padicField(p)), padicNorm(p)),
    functionImage(padicOfRat(p), ℚ, Ring.carrier(padicField(p))))
proof
  sorry

-- Padic.norm_p, Padic.norm_p_lt_one: ‖p‖ = 1/p < 1.
theorem padicNorm.p
  shows realMulValue(padicNorm(p)(natCast(padicField(p), p)), realNat(p)) = realOne
proof
  sorry

theorem padicNorm.p_lt_one
  shows padicNorm(p)(natCast(padicField(p), p)) < realOne
proof
  sorry

-- Padic.norm_natCast_lt_one_iff, Padic.norm_natCast_eq_one_iff, and
-- ‖n‖ ≤ 1 (padicNormE.norm_natCast_le_one).
theorem padicNorm.nat_le_one (n : Nat)
  shows padicNorm(p)(natCast(padicField(p), n)) ≤ realOne
proof
  sorry

theorem padicNorm.nat_lt_one_iff (n : Nat)
  shows padicNorm(p)(natCast(padicField(p), n)) < realOne ↔ p ∣ n
proof
  sorry

theorem padicNorm.nat_eq_one_iff (n : Nat)
  shows padicNorm(p)(natCast(padicField(p), n)) = realOne ↔ ¬(p ∣ n)
proof
  sorry

-- Padic.norm_eq_zpow_neg_valuation: ‖x‖ = p^(−v(x)) for x ≠ 0; the values
-- of the norm are the integer powers of p.
theorem padicNorm.eq_zpow_neg_valuation (x : Set)
  requires member : x ∈ Ring.carrier(padicField(p))
  requires nonzero : x ≠ Ring.zero(padicField(p))
  shows padicNorm(p)(x) = realZpow(realNat(p), integerNegValue(padicValuation(p, x)))
proof
  sorry

-- Padic.valuation_ratCast and Padic.valuation_mul.
theorem padicValuation.of_rat (q : Set)
  requires member : q ∈ ℚ
  requires nonzero : q ≠ rationalZero
  shows padicValuation(p, padicOfRat(p)(q)) = padicValRat(p, q)
proof
  sorry

theorem padicValuation.mul (x y : Set)
  requires first : x ∈ Ring.carrier(padicField(p))
  requires second : y ∈ Ring.carrier(padicField(p))
  requires left : x ≠ Ring.zero(padicField(p))
  requires right : y ≠ Ring.zero(padicField(p))
  shows padicValuation(p, call2(Ring.mul(padicField(p)), x, y)) =
    integerAddValue(padicValuation(p, x), padicValuation(p, y))
proof
  sorry

-- Section: ℤ_p
-- ℤ_[p] is a subring and a discrete valuation ring with maximal ideal (p)
-- and uniformizer p (PadicInt.subring, PadicInt.isDiscreteValuationRing,
-- PadicInt.maximalIdeal_eq_span_p, PadicInt.irreducible_p, PadicInt.prime_p).
theorem padicIntCarrier.subring
  shows Subring(padicField(p), padicIntCarrier(p))
proof
  sorry

theorem padicIntRing.dvr
  shows DiscreteValuationRing(padicIntRing(p))
proof
  sorry

theorem padicIntRing.maximal_ideal
  shows localMaximalIdeal(padicIntRing(p)) =
    ringMultiples(padicIntRing(p), natCast(padicIntRing(p), p))
proof
  sorry

theorem padicIntRing.uniformizer
  shows Uniformizer(padicIntRing(p), natCast(padicIntRing(p), p))
proof
  sorry

-- The operations of ℤ_p are those of ℚ_p (PadicInt.coe_add, coe_mul,
-- coe_natCast).
theorem padicIntRing.nat_cast (n : Nat)
  shows natCast(padicIntRing(p), n) = natCast(padicField(p), n)
proof
  sorry

-- PadicInt.isUnit_iff: x is a unit exactly when ‖x‖ = 1.
theorem padicIntRing.unit_iff (x : Set)
  requires member : x ∈ padicIntCarrier(p)
  shows RingUnit(padicIntRing(p), x) ↔ padicNorm(p)(x) = realOne
proof
  sorry

-- PadicInt.norm_le_pow_iff_mem_span_pow: ‖x‖ ≤ p^(−n) ↔ x ∈ (pⁿ).
theorem padicIntRing.norm_le_pow_iff (x : Set, n : Nat)
  requires member : x ∈ padicIntCarrier(p)
  shows padicNorm(p)(x) ≤ realZpow(realNat(p), integerNegValue(integerOfNat(n))) ↔
    x ∈ ringMultiples(padicIntRing(p), natCast(padicIntRing(p), p ^ n))
proof
  sorry

-- PadicInt.norm_p, PadicInt.norm_p_pow: ‖pⁿ‖ = p^(−n).
theorem padicIntRing.norm_p_pow (n : Nat)
  shows padicNorm(p)(natCast(padicIntRing(p), p ^ n)) =
    realZpow(realNat(p), integerNegValue(integerOfNat(n)))
proof
  sorry

-- PadicInt.norm_natCast_eq_one_iff.
theorem padicIntRing.nat_unit_iff (n : Nat)
  shows RingUnit(padicIntRing(p), natCast(padicIntRing(p), n)) ↔ ¬(p ∣ n)
proof
  sorry

-- PadicInt.unitCoeff_spec: x ≠ 0 is u pⁿ with u a unit and n = v(x).
theorem padicIntRing.unit_coeff (x : Set)
  requires member : x ∈ padicIntCarrier(p)
  requires nonzero : x ≠ Ring.zero(padicField(p))
  shows ∃ u ∈ padicIntCarrier(p), ∃ n ∈ ℕ, RingUnit(padicIntRing(p), u) ∧
    integerOfNat(n) = padicValuation(p, x) ∧
    x = call2(Ring.mul(padicField(p)), u, natCast(padicField(p), p ^ n))
proof
  sorry

-- PadicInt.exists_pow_neg_lt: p^(−k) < ε for some k.
theorem padicIntRing.exists_pow_neg_lt (ε : Set)
  requires real : ε ∈ ℝ
  requires positive : realZero < ε
  shows ∃ k ∈ ℕ, realZpow(realNat(p), integerNegValue(integerOfNat(k))) < ε
proof
  sorry

-- PadicInt.pow_p_dvd_int_iff: pⁿ ∣ z in ℤ_p exactly when pⁿ ∣ z in ℤ.
theorem padicIntRing.pow_dvd_int_iff (z : Set, n : Nat)
  requires integer : z ∈ ℤ
  shows RingDvd(padicIntRing(p), natCast(padicIntRing(p), p ^ n),
      intCastHom(padicIntRing(p))(z)) ↔
    IntegerDivides(integerOfNat(p ^ n), z)
proof
  sorry

-- PadicInt.appr_spec, PadicInt.denseRange_natCast: every x is congruent
-- modulo pⁿ to a natural number a < pⁿ; ℕ is dense in ℤ_p.
theorem padicIntRing.appr (x : Set, n : Nat)
  requires member : x ∈ padicIntCarrier(p)
  shows ∃ a ∈ ℕ, a < p ^ n ∧
    Ring.sub(padicField(p), x, natCast(padicField(p), a)) ∈
      ringMultiples(padicIntRing(p), natCast(padicIntRing(p), p ^ n))
proof
  sorry

theorem padicIntRing.nat_dense (x ε : Set)
  requires member : x ∈ padicIntCarrier(p)
  requires real : ε ∈ ℝ
  requires positive : realZero < ε
  shows ∃ a ∈ ℕ, padicNorm(p)(Ring.sub(padicField(p), x, natCast(padicField(p), a))) < ε
proof
  sorry

-- ℤ_p is compact (PadicInt.compactSpace), and open and closed in ℚ_p.
theorem padicIntCarrier.compact
  shows Compact(normTopology(Ring.additive(padicField(p)), padicNorm(p)), padicIntCarrier(p))
proof
  sorry

theorem padicIntCarrier.clopen
  shows Clopen(normTopology(Ring.additive(padicField(p)), padicNorm(p)), padicIntCarrier(p))
proof
  sorry

-- Section: ℤ_p as an inverse limit
-- PadicInt.toZModPow is a surjective ring homomorphism with kernel (pⁿ)
-- (PadicInt.ker_toZModPow, PadicInt.zmod_congr_of_sub_mem_span), and it
-- sends integers to their classes (PadicInt.toZModPow on Int.cast).
theorem padicToZModPow.ring_hom (n : Nat)
  shows (padicToZModPow(p, n) : padicIntRing(p) →+* zmod(p ^ n)) ∧
    SurjectiveBetween(padicToZModPow(p, n), padicIntCarrier(p), Ring.carrier(zmod(p ^ n)))
proof
  sorry

theorem padicToZModPow.ker (x : Set, n : Nat)
  requires member : x ∈ padicIntCarrier(p)
  shows padicToZModPow(p, n)(x) = Ring.zero(zmod(p ^ n)) ↔
    x ∈ ringMultiples(padicIntRing(p), natCast(padicIntRing(p), p ^ n))
proof
  sorry

theorem padicToZModPow.int_cast (z : Set, n : Nat)
  requires integer : z ∈ ℤ
  shows padicToZModPow(p, n)(intCastHom(padicIntRing(p))(z)) = zmodCast(p ^ n)(z)
proof
  sorry

-- PadicInt.cast_toZModPow: the reductions are compatible.
theorem padicToZModPow.compatible (x a : Set, m n : Nat)
  requires member : x ∈ padicIntCarrier(p)
  requires integer : a ∈ ℤ
  requires le : m ≤ n
  requires value : padicToZModPow(p, n)(x) = zmodCast(p ^ n)(a)
  shows padicToZModPow(p, m)(x) = zmodCast(p ^ m)(a)
proof
  sorry

-- PadicInt.ext_of_toZModPow.
theorem padicToZModPow.ext (x y : Set)
  requires first : x ∈ padicIntCarrier(p)
  requires second : y ∈ padicIntCarrier(p)
  shows x = y ↔ (∀ n ∈ ℕ, padicToZModPow(p, n)(x) = padicToZModPow(p, n)(y))
proof
  sorry

-- ℤ_p ≅ lim ℤ/pⁿℤ (PadicInt.lift with its uniqueness, the inverse-limit
-- description of ℤ_p): x ↦ (toZModPow n x)ₙ is a bijection onto the
-- compatible families.
theorem padicToLimit.bijective
  shows BijectiveBetween(padicToLimit(p), padicIntCarrier(p), zmodPowLimit(p))
proof
  sorry

-- PadicInt.toZMod: the residue field of ℤ_p is ℤ/pℤ, through the
-- reduction, whose kernel is the maximal ideal.
theorem padicToZMod.ker (x : Set)
  requires member : x ∈ padicIntCarrier(p)
  shows padicToZMod(p)(x) = Ring.zero(zmod(p)) ↔ x ∈ localMaximalIdeal(padicIntRing(p))
proof
  sorry

end PadicField
