-- The p-adic numbers: the p-adic valuation of naturals, integers and
-- rationals (padicValNat, padicValInt, padicValRat) with Legendre's
-- formula, the p-adic absolute value on ℚ (padicNorm), the completion of
-- a normed field as classes of Cauchy sequences, ℚ_p as the completion of
-- ℚ for the p-adic absolute value (Padic), its norm and valuation, the
-- p-adic integers ℤ_p as its unit ball (PadicInt), and the reductions
-- ℤ_p → ℤ/pⁿℤ (PadicInt.toZModPow) that identify ℤ_p with the inverse
-- limit of the ℤ/pⁿℤ.
-- Part of the GRH blueprint.
-- Planned home: NumberTheory/Padic/Numbers.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Padic.Numbers
import GRH.Cyclotomy.Fields
import GRH.Algebra.DVR
import GRH.Normed.Groups

-- Helpers (track H): powers dividing a natural number.
theorem tkH.pv.all_pow (p n k : Nat)
  requires step : ∀ i ∈ ℕ, p ^ i ∣ n → p ^ succ(i) ∣ n
  shows p ^ k ∣ n
proof
  induction k with
  | zero =>
    rw pow.zero
    exact one.divides at n
  | succ(j) using ih =>
    have jIn : j ∈ ℕ by typecheck
    exact step with j, jIn, ih

theorem tkH.pv.lt_pow (p n : Nat)
  requires big : 1 < p
  shows n < p ^ n
proof
  have two : 2 ≤ p by arith
  have a := pow.two_gt at n
  have b := pow.base_monotone at 2, p, n with two
  have pn := pow.closed at p, n
  have tn := pow.closed at 2, n
  arith

theorem tkH.pv.exists (p n : Nat)
  requires nonzero : n ≠ 0
  requires big : 1 < p
  shows ∃ k ∈ ℕ, p ^ k ∣ n ∧ ¬(p ^ succ(k) ∣ n)
proof
  by_contra none
  have step : ∀ k ∈ ℕ, p ^ k ∣ n → p ^ succ(k) ∣ n
    intros k hk dk
    by_contra nd
    exact none with ⟨k, hk, dk, nd⟩
  have d := tkH.pv.all_pow at p, n, n with step
  have pn := pow.closed at p, n
  have le := divides.le at p ^ n, n with d, nonzero
  have lt := tkH.pv.lt_pow at p, n with big
  arith

theorem tkH.pv.unique (p n k j : Nat)
  requires dk : p ^ k ∣ n
  requires nk : ¬(p ^ succ(k) ∣ n)
  requires dj : p ^ j ∣ n
  requires nj : ¬(p ^ succ(j) ∣ n)
  shows k = j
proof
  have tri := Less.trichotomy at k, j with *
  rcases tri with kj | same | jk
  . exfalso
    have le : succ(k) ≤ j by arith
    have d := divides.pow_of_le at p, succ(k), j with le
    have pk := pow.closed at p, succ(k)
    have pj := pow.closed at p, j
    have t := divides.transitive at p ^ succ(k), p ^ j, n with d, dj
    exact nk with t
  . exact same
  . exfalso
    have le : succ(j) ≤ k by arith
    have d := divides.pow_of_le at p, succ(j), k with le
    have pk := pow.closed at p, succ(j)
    have pj := pow.closed at p, k
    have t := divides.transitive at p ^ succ(j), p ^ k, n with d, dk
    exact nj with t

-- Section: The p-adic valuation of naturals, integers and rationals
-- v_p(n): the largest k with p^k ∣ n, and 0 when n = 0 or p ≤ 1
-- (padicValNat p n, which Mathlib defines for every p in the same way).
defunique padicValNat (p n : Nat) (k ∈ ℕ) :=
  ((n = (0:N) ∨ p ≤ 1) ∧ k = (0:N)) ∨
  (n ≠ (0:N) ∧ 1 < p ∧ p ^ k ∣ n ∧ ¬(p ^ succ(k) ∣ n))
proof
  by_cases trivial : n = (0:N) ∨ p ≤ 1
  . have zIn : (0:N) ∈ ℕ by typecheck
    refine ⟨(0:N), zIn, ?_⟩
    left
    exact ⟨trivial, rfl⟩
  . have nz : n ≠ (0:N)
      intro e
      apply trivial
      left
      exact e
    have big : 1 < p
      by_contra small
      apply trivial
      right
      arith
    obtain ⟨k, hk, dk, nk⟩ := tkH.pv.exists at p, n with nz, big
    refine ⟨k, hk, ?_⟩
    right
    exact ⟨nz, big, dk, nk⟩
uniqueness
  intros k hk hkP j hj hjP
  have kNat : Nat(k) := hk
  have jNat : Nat(j) := hj
  rcases hkP with kt | kn
  . obtain ⟨triv, k0⟩ := kt
    rcases hjP with jt | jn
    . obtain ⟨triv2, j0⟩ := jt
      rw [k0, j0]
    . exfalso
      obtain ⟨nz, big, dj, nj⟩ := jn
      rcases triv with z | small
      . exact nz with z
      . arith
  . obtain ⟨nz, big, dk, nk⟩ := kn
    rcases hjP with jt | jn
    . exfalso
      obtain ⟨triv, j0⟩ := jt
      rcases triv with z | small
      . exact nz with z
      . arith
    . obtain ⟨nz2, big2, dj, nj⟩ := jn
      exact tkH.pv.unique at p, n, k, j with dk, nk, dj, nj

-- v_p(z) = v_p(|z|) (padicValInt p z).
def padicValInt (p : Nat, z : Set) : Set := padicValNat(p, integerNatAbs(z))

-- v_p(q) for q ∈ ℚ, q = (a − b)/m: v_p(|a − b|) − v_p(m), independent of
-- the representation for p prime; 0 at q = 0 (padicValRat p q).
defunique padicValRat (p : Nat, q : Set) (k ∈ ℤ) :=
  (q = rationalZero ∧ k = integerZero) ∨
  (q ≠ rationalZero ∧ (∃ a ∈ ℕ, ∃ b ∈ ℕ, ∃ m ∈ ℕ, m ≠ 0 ∧
    q = rationalClass(a, b, m) ∧
    k = integerAddValue(integerOfNat(padicValNat(p, integerNatAbs(integerClass(a, b)))),
      integerNegValue(integerOfNat(padicValNat(p, m))))))
requires prime : Prime(p)
requires member : q ∈ ℚ
proof
  sorry
uniqueness
  sorry

-- The p-adic absolute value on ℚ: |q|_p = p^(−v_p(q)), |0|_p = 0
-- (padicNorm p), as a value and as a function ℚ → ℝ.
defunique ratPadicNormValue (p : Nat, q : Set) (y ∈ ℝ) :=
  (q = rationalZero ∧ y = realZero) ∨
  (q ≠ rationalZero ∧ y = realZpow(realNat(p), integerNegValue(padicValRat(p, q))))
requires prime : Prime(p)
requires member : q ∈ ℚ
proof
  sorry
uniqueness
  sorry

def ratPadicNorm (p : Nat) : Set := { (q, ratPadicNormValue(p, q)) | q ∈ ℚ }

-- Legendre's formula: the family i ↦ ⌊n / p^i⌋ and the set {1, …, b − 1}.
def legendreTerms (p n : Nat) : Set := { (i, quotientNat(n, pow(p, i))) | i ∈ ℕ }

def natIco (a b : Nat) : Set := b ∖ a

-- Section: ℚ_p and ℤ_p
-- ℚ_[p]: the completion of ℚ for |·|_p (Padic p), its norm (‖·‖ on
-- Padic), the embedding of ℚ (Rat.cast), and the valuation (Padic.valuation;
-- defined for x ≠ 0 by ‖x‖ = p^(−v(x)), where Mathlib sets v(0) = 0).
def padicField (p : Nat) : Set := normCompletion(rationalRing, ratPadicNorm(p))

def padicNorm (p : Nat) : Set := normCompletionNorm(rationalRing, ratPadicNorm(p))

def padicOfRat (p : Nat) : Set := normCompletionOf(rationalRing, ratPadicNorm(p))

defunique padicValuation (p : Nat, x : Set) (k ∈ ℤ) :=
  padicNorm(p)(x) = realZpow(realNat(p), integerNegValue(k))
requires prime : Prime(p)
requires member : x ∈ Ring.carrier(padicField(p))
requires nonzero : x ≠ Ring.zero(padicField(p))
proof
  sorry
uniqueness
  sorry

-- ℤ_[p] = {x ∈ ℚ_p | ‖x‖ ≤ 1} (PadicInt, PadicInt.subring), as a ring.
def padicIntCarrier (p : Nat) : Set :=
  { x ∈ Ring.carrier(padicField(p)) | padicNorm(p)(x) ≤ realOne }

def padicIntRing (p : Nat) : Set := subringRing(padicField(p), padicIntCarrier(p))

-- The reduction ℤ_p → ℤ/pⁿℤ (PadicInt.toZModPow n): x ↦ the class of any
-- integer a with ‖x − a‖ ≤ p^(−n); and ℤ_p → ℤ/pℤ (PadicInt.toZMod).
defunique padicToZModPowValue (p n : Nat, x : Set) (c ∈ Ring.carrier(zmod(p ^ n))) :=
  ∃ a ∈ ℤ, zmodCast(p ^ n)(a) = c ∧
    padicNorm(p)(Ring.sub(padicField(p), x, intCastHom(padicField(p))(a))) ≤
      realZpow(realNat(p), integerNegValue(integerOfNat(n)))
requires prime : Prime(p)
requires member : x ∈ padicIntCarrier(p)
proof
  sorry
uniqueness
  sorry

def padicToZModPow (p n : Nat) : Set :=
  { (x, padicToZModPowValue(p, n, x)) | x ∈ padicIntCarrier(p) }

def padicToZMod (p : Nat) : Set := padicToZModPow(p, 1)

-- The compatible families (cₙ) with cₙ ∈ ℤ/pⁿℤ and cₘ the reduction of cₙ
-- for m ≤ n: the inverse limit lim ℤ/pⁿℤ, as a set of sequences.
def zmodPowCarriers (p : Nat) : Set := { Ring.carrier(zmod(pow(p, n))) | n ∈ ℕ }

def zmodPowLimit (p : Nat) : Set :=
  { c ∈ functionSpace(ℕ, ⋃(zmodPowCarriers(p))) |
    (∀ n ∈ ℕ, c(n) ∈ Ring.carrier(zmod(p ^ n))) ∧
    (∀ m ∈ ℕ, ∀ n ∈ ℕ, m ≤ n → ∀ a ∈ ℤ, c(n) = zmodCast(p ^ n)(a) →
      c(m) = zmodCast(p ^ m)(a)) }

-- The map x ↦ (toZModPow n x)ₙ into the inverse limit.
def padicToLimitSeq (p x : Set) : Set := { (n, padicToZModPow(p, n)(x)) | n ∈ ℕ }

def padicToLimit (p : Nat) : Set :=
  { (x, padicToLimitSeq(p, x)) | x ∈ padicIntCarrier(p) }

-- The digit sum of n in base p: Σᵢ ⌊n / pⁱ⌋ mod p over i ≤ n
-- ((Nat.digits p n).sum for p ≥ 2).
def natDigitTerms (p n : Nat) : Set := { (i, quotientNat(n, pow(p, i)) % p) | i ∈ ℕ }

def natDigitSum (p n : Nat) : Set := natSum(succ(n), natDigitTerms(p, n))

-- Section: Laws of the p-adic valuation
section PadicValuations
variable (p : Nat)
hypothesis prime : Prime(p)

-- Helpers (track H): the defining property of padicValNat.
theorem tkH.pv.nat (n : Nat)
  shows Nat(padicValNat(p, n))
proof
  have s := padicValNat.selected at p, n
  exact s.left

theorem tkH.pv.spec (n : Nat)
  requires nonzero : n ≠ 0
  shows p ^ padicValNat(p, n) ∣ n ∧ ¬(p ^ succ(padicValNat(p, n)) ∣ n)
proof
  have big := Prime.greater_than_one with prime
  have s := padicValNat.selected at p, n
  obtain ⟨vIn, cases⟩ := s
  rcases cases with t | r
  . exfalso
    obtain ⟨triv, v0⟩ := t
    rcases triv with z | small
    . exact nonzero with z
    . arith
  . obtain ⟨nz, b, d, nd⟩ := r
    exact ⟨d, nd⟩

theorem tkH.pv.eq_of (n k : Nat)
  requires nonzero : n ≠ 0
  requires divides : p ^ k ∣ n
  requires exact : ¬(p ^ succ(k) ∣ n)
  shows padicValNat(p, n) = k
proof
  have vNat := tkH.pv.nat at p, n with prime
  obtain ⟨d, nd⟩ := tkH.pv.spec at p, n with prime, nonzero
  exact tkH.pv.unique at p, n, padicValNat(p, n), k with d, nd, divides, exact

-- padicValNat.zero, padicValNat.one, padicValNat.self, padicValNat.prime_pow.
theorem padicValNat.zero
  shows padicValNat(p, 0) = 0
proof
  have s := padicValNat.selected at p, 0
  obtain ⟨vIn, cases⟩ := s
  rcases cases with t | r
  . exact t.right
  . exfalso
    obtain ⟨nz, rest⟩ := r
    exact nz with rfl

theorem padicValNat.one
  shows padicValNat(p, 1) = 0
proof
  have big := Prime.greater_than_one with prime
  have one : (1:N) ≠ 0 by arith
  have d : p ^ 0 ∣ 1
    rw pow.zero
    exact divides.reflexive at 1
  have nd : ¬(p ^ succ(0) ∣ 1)
    have e : p ^ succ(0) = p
      rw pow.succ
      rw pow.zero
      ring
    rw e
    intro d1
    have le := divides.le at p, 1 with d1, one
    arith
  exact tkH.pv.eq_of at p, 1, 0 with prime, one, d, nd

theorem padicValNat.self
  shows padicValNat(p, p) = 1
proof
  have big := Prime.greater_than_one with prime
  have nz : p ≠ 0 by arith
  have e1 : p ^ 1 = p := pow.one_right at p
  have d : p ^ 1 ∣ p
    rw e1
    exact divides.reflexive at p
  have nd : ¬(p ^ succ(1) ∣ p)
    intro dd
    have pp := pow.closed at p, succ(1)
    have le := divides.le at p ^ succ(1), p with dd, nz
    have lt0 : 1 < succ(1) by arith
    have lt := pow.exponent_strict at p, 1, succ(1) with big, lt0
    rw e1 at lt
    arith
  exact tkH.pv.eq_of at p, p, 1 with prime, nz, d, nd

theorem padicValNat.prime_pow (n : Nat)
  shows padicValNat(p, p ^ n) = n
proof
  have big := Prime.greater_than_one with prime
  have pz : p ≠ 0 by arith
  have nz := pow.ne_zero at p, n with pz
  have d := divides.reflexive at p ^ n
  have nd : ¬(p ^ succ(n) ∣ p ^ n)
    intro dd
    have pp := pow.closed at p, succ(n)
    have pn := pow.closed at p, n
    have le := divides.le at p ^ succ(n), p ^ n with dd, nz
    have lt0 : n < succ(n) by arith
    have lt := pow.exponent_strict at p, n, succ(n) with big, lt0
    arith
  exact tkH.pv.eq_of at p, p ^ n, n with prime, nz, d, nd

-- Helper (track H): padicValNat.mul with natural premises (the blueprint
-- statement reads its premises a ≠ 0, b ≠ 0 at the real zero).
theorem tkH.pv.mul (a b : Nat)
  requires left : a ≠ (0:N)
  requires right : b ≠ (0:N)
  shows padicValNat(p, mul(a, b)) = add(padicValNat(p, a), padicValNat(p, b))
proof
  have big := Prime.greater_than_one with prime
  have pz : p ≠ 0 by arith
  have va := tkH.pv.nat at p, a with prime
  have vb := tkH.pv.nat at p, b with prime
  obtain ⟨da, nda⟩ := tkH.pv.spec at p, a with prime, left
  obtain ⟨db, ndb⟩ := tkH.pv.spec at p, b with prime, right
  have abz : mul(a, b) ≠ (0:N)
    intro z
    have m := mul.eq_zero at b, a with z
    rcases m with az | bz
    . exact left with az
    . exact right with bz
  have pa := pow.closed at p, padicValNat(p, a)
  have pb := pow.closed at p, padicValNat(p, b)
  have split := pow.add at p, padicValNat(p, b), padicValNat(p, a)
  have d : p ^ add(padicValNat(p, a), padicValNat(p, b)) ∣ mul(a, b)
    rw split
    exact divides.mul_mono at p ^ padicValNat(p, a), a, p ^ padicValNat(p, b), b with da, db
  have nd : ¬(p ^ succ(add(padicValNat(p, a), padicValNat(p, b))) ∣ mul(a, b))
    intro dd
    obtain ⟨a1, a1Nat, aEq⟩ := da
    obtain ⟨b1, b1Nat, bEq⟩ := db
    have kNat := add.closed at padicValNat(p, a), padicValNat(p, b)
    have pk := pow.closed at p, add(padicValNat(p, a), padicValNat(p, b))
    have pkz := pow.ne_zero at p, add(padicValNat(p, a), padicValNat(p, b)) with pz
    have s := pow.succ at p, add(padicValNat(p, a), padicValNat(p, b))
    rw s at dd
    have prod : mul(mul(p ^ padicValNat(p, a), a1), mul(p ^ padicValNat(p, b), b1)) =
        mul(mul(p ^ padicValNat(p, a), p ^ padicValNat(p, b)), mul(a1, b1)) by ring
    rw [aEq, bEq] at prod
    rw ← split at prod
    rw prod at dd
    have sw : mul(p, p ^ add(padicValNat(p, a), padicValNat(p, b))) =
        mul(p ^ add(padicValNat(p, a), padicValNat(p, b)), p) by ring
    rw sw at dd
    have c := divides.mul_cancel_left at p ^ add(padicValNat(p, a), padicValNat(p, b)), p, mul(a1, b1) with pkz
    have pd := c.forward with dd
    have e := Prime.divides_mul at p, a1, b1 with prime, pd
    rcases e with pa1 | pb1
    . obtain ⟨c1, c1Nat, cEq⟩ := pa1
      have bad : p ^ succ(padicValNat(p, a)) ∣ a
        have s2 := pow.succ at p, padicValNat(p, a)
        rw s2
        have ee : mul(p ^ padicValNat(p, a), mul(p, c1)) = mul(mul(p, p ^ padicValNat(p, a)), c1) by ring
        rw cEq at ee
        rw aEq at ee
        have m1 := mul.closed at p, p ^ padicValNat(p, a)
        have dd2 := divides.mul_left_self at mul(p, p ^ padicValNat(p, a)), c1
        rw ← ee at dd2
        exact dd2
      exact nda with bad
    . obtain ⟨c1, c1Nat, cEq⟩ := pb1
      have bad : p ^ succ(padicValNat(p, b)) ∣ b
        have s2 := pow.succ at p, padicValNat(p, b)
        rw s2
        have ee : mul(p ^ padicValNat(p, b), mul(p, c1)) = mul(mul(p, p ^ padicValNat(p, b)), c1) by ring
        rw cEq at ee
        rw bEq at ee
        have m1 := mul.closed at p, p ^ padicValNat(p, b)
        have dd2 := divides.mul_left_self at mul(p, p ^ padicValNat(p, b)), c1
        rw ← ee at dd2
        exact dd2
      exact ndb with bad
  exact tkH.pv.eq_of at p, mul(a, b), add(padicValNat(p, a), padicValNat(p, b)) with prime, abz, d, nd

-- padicValNat.mul: v(ab) = v(a) + v(b) for a, b ≠ 0.
theorem padicValNat.mul (a b : Nat)
  requires left : a ≠ 0
  requires right : b ≠ 0
  shows padicValNat(p, mul(a, b)) = add(padicValNat(p, a), padicValNat(p, b))
proof
  sorry

-- pow_padicValNat_dvd, padicValNat_dvd_iff_le, padicValNat_dvd_iff.
theorem padicValNat.pow_dvd (n : Nat)
  shows p ^ padicValNat(p, n) ∣ n
proof
  by_cases z : n = 0
  . rw z
    exact divides.zero at p ^ padicValNat(p, 0)
  . have s := tkH.pv.spec at p, n with prime, z
    exact s.left

theorem padicValNat.dvd_iff_le (n k : Nat)
  requires nonzero : n ≠ 0
  shows p ^ k ∣ n ↔ k ≤ padicValNat(p, n)
proof
  have big := Prime.greater_than_one with prime
  have vNat := tkH.pv.nat at p, n with prime
  obtain ⟨d, nd⟩ := tkH.pv.spec at p, n with prime, nonzero
  constructor
  . intro dk
    by_contra gt
    have le : succ(padicValNat(p, n)) ≤ k by arith
    have dp := divides.pow_of_le at p, succ(padicValNat(p, n)), k with le
    have pk := pow.closed at p, k
    have ps := pow.closed at p, succ(padicValNat(p, n))
    have t := divides.transitive at p ^ succ(padicValNat(p, n)), p ^ k, n with dp, dk
    exact nd with t
  . intro le
    have dp := divides.pow_of_le at p, k, padicValNat(p, n) with le
    have pk := pow.closed at p, k
    have pv := pow.closed at p, padicValNat(p, n)
    exact divides.transitive at p ^ k, p ^ padicValNat(p, n), n with dp, d

theorem padicValNat.dvd_iff (n k : Nat)
  shows p ^ k ∣ n ↔ n = 0 ∨ k ≤ padicValNat(p, n)
proof
  by_cases z : n = 0
  . constructor
    . intro dk
      left
      exact z
    . intro h
      rw z
      exact divides.zero at p ^ k
  . have i := padicValNat.dvd_iff_le at p, n, k with prime, z
    constructor
    . intro dk
      right
      exact i.forward with dk
    . intro h
      rcases h with e | le
      . exfalso
        exact z with e
      . exact i.backward with le

-- padicValNat.eq_zero_of_not_dvd, one_le_padicValNat_of_dvd.
theorem padicValNat.eq_zero_of_not_dvd (n : Nat)
  requires coprime : ¬(p ∣ n)
  shows padicValNat(p, n) = 0
proof
  by_cases z : n = 0
  . rw z
    exact padicValNat.zero at p with prime
  . have d : p ^ 0 ∣ n
      rw pow.zero
      exact one.divides at n
    have nd : ¬(p ^ succ(0) ∣ n)
      have e : p ^ succ(0) = p
        rw pow.succ
        rw pow.zero
        ring
      rw e
      exact coprime
    exact tkH.pv.eq_of at p, n, 0 with prime, z, d, nd

theorem padicValNat.one_le_of_dvd (n : Nat)
  requires nonzero : n ≠ 0
  requires divides : p ∣ n
  shows 1 ≤ padicValNat(p, n)
proof
  have i := padicValNat.dvd_iff_le at p, n, 1 with prime, nonzero
  have e1 : p ^ 1 = p := pow.one_right at p
  apply i.forward
  rw e1
  exact divides

-- padicValNat_le_nat_log, read as p^v(n) ≤ n.
theorem padicValNat.pow_le (n : Nat)
  requires nonzero : n ≠ 0
  shows p ^ padicValNat(p, n) ≤ n
proof
  have s := tkH.pv.spec at p, n with prime, nonzero
  have pv := pow.closed at p, padicValNat(p, n)
  exact divides.le at p ^ padicValNat(p, n), n with s.left, nonzero

-- Legendre's formula (padicValNat_factorial): for n < p^b,
-- v(n!) = Σ_{1 ≤ i < b} ⌊n / pⁱ⌋.
theorem padicValNat.factorial (n b : Nat)
  requires bound : n < p ^ b
  shows padicValNat(p, factorial(n)) = natSum(natIco(1, b), legendreTerms(p, n))
proof
  sorry

-- sub_one_mul_padicValNat_factorial: (p − 1) v(n!) = n − (digit sum).
theorem padicValNat.sub_one_mul_factorial (n : Nat)
  shows mul(sub(p, 1), padicValNat(p, factorial(n))) = sub(n, natDigitSum(p, n))
proof
  sorry

-- padicValNat_factorial_lt_of_ne_zero: (p − 1) v(n!) < n for n ≠ 0.
theorem padicValNat.factorial_lt (n : Nat)
  requires nonzero : n ≠ 0
  shows mul(sub(p, 1), padicValNat(p, factorial(n))) < n
proof
  sorry

-- padicValNat_factorial_mul: v((p n)!) = v(n!) + n.
theorem padicValNat.factorial_mul (n : Nat)
  shows padicValNat(p, factorial(mul(p, n))) = add(padicValNat(p, factorial(n)), n)
proof
  sorry

-- padicValNat_mul_div_factorial: v((p ⌊n / p⌋)!) = v(n!).
theorem padicValNat.mul_div_factorial (n : Nat)
  shows padicValNat(p, factorial(mul(p, quotientNat(n, p)))) = padicValNat(p, factorial(n))
proof
  sorry

-- padicValInt.eq_zero_iff (with p ≠ 1), padicValInt.mul.
theorem padicValInt.eq_zero_iff (z : Set)
  requires integer : z ∈ ℤ
  shows padicValInt(p, z) = 0 ↔ z = integerZero ∨ ¬IntegerDivides(integerOfNat(p), z)
proof
  have zInt : Integer(z) := integer
  have aNat := integerNatAbs.natural at z
  have av := integerAbs.value at z
  have d1 := IntegerDivides.abs_right_iff at integerOfNat(p), z
  rw av at d1
  have d2 := IntegerDivides.ofNat_iff at p, integerNatAbs(z)
  have zi := integerNatAbs.zero_iff at z
  unfold padicValInt
  constructor
  . intro v0
    by_cases az : integerNatAbs(z) = (0:N)
    . left
      exact zi.forward with az
    . right
      intro dz
      have dn := d1.backward with dz
      have dp := d2.forward with dn
      have one := padicValNat.one_le_of_dvd at p, integerNatAbs(z) with prime, az, dp
      arith
  . intro h
    rcases h with z0 | nd
    . have a0 := zi.backward with z0
      rw a0
      exact padicValNat.zero at p with prime
    . have np : ¬(p ∣ integerNatAbs(z))
        intro dp
        have dn := d2.backward with dp
        have dz := d1.forward with dn
        exact nd with dz
      exact padicValNat.eq_zero_of_not_dvd at p, integerNatAbs(z) with prime, np

theorem padicValInt.mul (y z : Set)
  requires first : y ∈ ℤ
  requires second : z ∈ ℤ
  requires left : y ≠ integerZero
  requires right : z ≠ integerZero
  shows padicValInt(p, integerMulValue(y, z)) = add(padicValInt(p, y), padicValInt(p, z))
proof
  have yInt : Integer(y) := first
  have zInt : Integer(z) := second
  have ay := integerNatAbs.natural at y
  have az := integerNatAbs.natural at z
  have m := integerNatAbs.mul at y, z
  have yi := integerNatAbs.zero_iff at y
  have zi := integerNatAbs.zero_iff at z
  have yn : integerNatAbs(y) ≠ (0:N)
    intro e
    exact left with (yi.forward with e)
  have zn : integerNatAbs(z) ≠ (0:N)
    intro e
    exact right with (zi.forward with e)
  unfold padicValInt
  rw m
  exact tkH.pv.mul at p, integerNatAbs(y), integerNatAbs(z) with prime, yn, zn

-- padicValRat.of_nat and padicValRat.mul.
theorem padicValRat.of_nat (n : Nat)
  shows padicValRat(p, rationalClass(n, 0, 1)) = integerOfNat(padicValNat(p, n))
proof
  sorry

theorem padicValRat.mul (q r : Set)
  requires first : q ∈ ℚ
  requires second : r ∈ ℚ
  requires left : q ≠ rationalZero
  requires right : r ≠ rationalZero
  shows padicValRat(p, rationalMulValue(q, r)) =
    integerAddValue(padicValRat(p, q), padicValRat(p, r))
proof
  sorry

-- Section: The p-adic absolute value on ℚ
-- padicNorm is a nonarchimedean absolute value (padicNorm.nonarchimedean,
-- padicNorm.mul, padicNorm.triangle_ineq, padicNorm.zero_of_padicNorm_eq_zero).
theorem ratPadicNorm.nonarchimedean
  shows NormedField(rationalRing, ratPadicNorm(p)) ∧
    NonarchimedeanNorm(rationalRing, ratPadicNorm(p))
proof
  sorry

-- padicNorm.padicNorm_p: |p|_p = 1/p.
theorem ratPadicNorm.p
  shows realMulValue(ratPadicNorm(p)(rationalClass(p, 0, 1)), realNat(p)) = realOne
proof
  sorry

-- padicNorm.of_int: |z|_p ≤ 1 for z = a − b ∈ ℤ.
theorem ratPadicNorm.int_le_one (a b : Nat)
  shows ratPadicNorm(p)(rationalClass(a, b, 1)) ≤ realOne
proof
  sorry

-- padicNorm.int_lt_one_iff: |z|_p < 1 ↔ p ∣ z.
theorem ratPadicNorm.int_lt_one_iff (a b : Nat)
  shows ratPadicNorm(p)(rationalClass(a, b, 1)) < realOne ↔
    IntegerDivides(integerOfNat(p), integerClass(a, b))
proof
  sorry

end PadicValuations

-- Section: ℚ_p
section PadicField
variable (p : Nat)
hypothesis prime : Prime(p)

-- ℚ_[p] is a complete nonarchimedean normed field, nontrivially normed
-- (Padic.field, Padic.normedField, Padic.complete, Padic.nonarchimedean).
-- Helpers (track H): ℚ_p is a nonarchimedean normed field.
theorem tkH.qp.normed
  shows NormedField(padicField(p), padicNorm(p)) ∧ NonarchimedeanNorm(padicField(p), padicNorm(p))
proof
  have nf := ratPadicNorm.nonarchimedean at p with prime
  obtain ⟨normed, ultra⟩ := nf
  have a := normCompletion.normed_field at rationalRing, ratPadicNorm(p) with normed
  have b := normCompletion.nonarchimedean at rationalRing, ratPadicNorm(p) with normed, ultra
  unfold padicField
  unfold padicNorm
  exact ⟨a, b⟩

theorem padicField.complete
  shows NormComplete(padicField(p), padicNorm(p))
proof
  have nf := ratPadicNorm.nonarchimedean at p with prime
  obtain ⟨normed, ultra⟩ := nf
  unfold padicField
  unfold padicNorm
  exact normCompletion.complete at rationalRing, ratPadicNorm(p) with normed

-- ℚ_[p] has characteristic zero (Padic.charZero).
theorem padicField.char_zero (n : Nat)
  requires zero : natCast(padicField(p), n) = Ring.zero(padicField(p))
  shows n = 0
proof
  sorry

-- The embedding of ℚ is a ring homomorphism with dense image, and the
-- norm extends |·|_p (Padic.eq_padicNorm, Padic.coe_add, Padic.denseRange_ratCast).
theorem padicOfRat.ring_hom
  shows (padicOfRat(p) : rationalRing →+* padicField(p))
proof
  have nf := ratPadicNorm.nonarchimedean at p with prime
  obtain ⟨normed, ultra⟩ := nf
  unfold padicOfRat
  unfold padicField
  exact normCompletionOf.ring_hom at rationalRing, ratPadicNorm(p) with normed

theorem padicNorm.of_rat (q : Set)
  requires member : q ∈ ℚ
  shows padicNorm(p)(padicOfRat(p)(q)) = ratPadicNorm(p)(q)
proof
  have nf := ratPadicNorm.nonarchimedean at p with prime
  obtain ⟨normed, ultra⟩ := nf
  have qIn : q ∈ Ring.carrier(rationalRing)
    unfold rationalRing
    ring_projections
  unfold padicOfRat
  unfold padicNorm
  exact normCompletionOf.isometry at rationalRing, ratPadicNorm(p), q with normed, qIn

theorem padicOfRat.dense
  shows Dense(normTopology(Ring.additive(padicField(p)), padicNorm(p)),
    functionImage(padicOfRat(p), ℚ, Ring.carrier(padicField(p))))
proof
  have nf := ratPadicNorm.nonarchimedean at p with prime
  obtain ⟨normed, ultra⟩ := nf
  have d := normCompletionOf.dense at rationalRing, ratPadicNorm(p) with normed
  have c : Ring.carrier(rationalRing) = ℚ
    unfold rationalRing
    ring_projections
  rw c at d
  unfold padicOfRat
  unfold padicField
  unfold padicNorm
  exact d

-- Padic.norm_p, Padic.norm_p_lt_one: ‖p‖ = 1/p < 1.
theorem padicNorm.p
  shows realMulValue(padicNorm(p)(natCast(padicField(p), p)), realNat(p)) = realOne
proof
  sorry

theorem padicNorm.p_lt_one
  shows padicNorm(p)(natCast(padicField(p), p)) < realOne
proof
  sorry

-- Padic.field, Padic.normedField (moved below Padic.norm_p, unchanged).
theorem padicField.normed_field
  shows NontriviallyNormedField(padicField(p), padicNorm(p)) ∧
    NonarchimedeanNorm(padicField(p), padicNorm(p))
proof
  obtain ⟨normed, ultra⟩ := tkH.qp.normed at p with prime
  refine ⟨?_, ultra⟩
  unfold NontriviallyNormedField
  refine ⟨normed, ?_⟩
  obtain ⟨field, comm, normedRing, mult, normOne⟩ := normed
  obtain ⟨ring, normedGroup, submult⟩ := normedRing
  obtain ⟨abelian, isNorm⟩ := normedGroup
  obtain ⟨normF, nonneg, zeroIff, negInv, tri⟩ := isNorm
  ring_additive at normF
  ring_additive at zeroIff
  have parts := Ring.parts with ring
  have aIn := IsRing.numeral_closed at Ring.carrier(padicField(p)), Ring.add(padicField(p)),
    Ring.zero(padicField(p)), Ring.neg(padicField(p)), Ring.mul(padicField(p)), Ring.one(padicField(p)), p with parts
  have aIn2 : natCast(padicField(p), p) ∈ Ring.carrier(padicField(p))
    unfold natCast
    exact aIn
  have np := padicNorm.p at p with prime
  have naR := FunctionBetween.apply_closed with normF, aIn2
  have pR := realNat.real at p
  unfold Real at pR
  have mv := realMulValue.real at padicNorm(p)(natCast(padicField(p), p)), realNat(p)
  have e : realMulValue(padicNorm(p)(natCast(padicField(p), p)), realNat(p)) =
      (padicNorm(p)(natCast(padicField(p), p)):R) * (realNat(p):R)
    unfold realMulValue
    unfold call2
    rfl
  rw e at np
  have nz : natCast(padicField(p), p) ≠ Ring.zero(padicField(p))
    intro z
    have zi := zeroIff with natCast(padicField(p), p), aIn2
    have n0 := zi.backward with z
    rw n0 at np
    have bad : (0:R) * (realNat(p):R) = (0:R) by ring
    rw bad at np
    have one : (0:R) < (1:R) by linarith
    rw np at one
    have irr := realLess.not_self at realOne
    exact irr with one
  have fparts := Field.parts with field
  obtain ⟨y, inv⟩ := IsField.inverse_exists with fparts, aIn2, nz
  obtain ⟨aK, yK, left, right⟩ := inv
  have m := mult with natCast(padicField(p), p), aIn2, y, yK
  rw right at m
  rw normOne at m
  have nyR := FunctionBetween.apply_closed with normF, yK
  have ny : (padicNorm(p)(y):R) = (realNat(p):R)
    linear_combination (-(padicNorm(p)(y):R)) * np - (realNat(p):R) * m
  have big := Prime.greater_than_one with prime
  have lt := realNat.lt_of_lt at 1, p with big
  have r1 := realNat.one
  rw r1 at lt
  refine ⟨y, yK, ?_⟩
  rw ny
  exact lt

-- Padic.norm_natCast_lt_one_iff, Padic.norm_natCast_eq_one_iff, and
-- ‖n‖ ≤ 1 (padicNormE.norm_natCast_le_one).
theorem padicNorm.nat_le_one (n : Nat)
  shows padicNorm(p)(natCast(padicField(p), n)) ≤ realOne
proof
  sorry

theorem padicNorm.nat_lt_one_iff (n : Nat)
  shows padicNorm(p)(natCast(padicField(p), n)) < realOne ↔ p ∣ n
proof
  sorry

theorem padicNorm.nat_eq_one_iff (n : Nat)
  shows padicNorm(p)(natCast(padicField(p), n)) = realOne ↔ ¬(p ∣ n)
proof
  sorry

-- Padic.norm_eq_zpow_neg_valuation: ‖x‖ = p^(−v(x)) for x ≠ 0; the values
-- of the norm are the integer powers of p.
theorem padicNorm.eq_zpow_neg_valuation (x : Set)
  requires member : x ∈ Ring.carrier(padicField(p))
  requires nonzero : x ≠ Ring.zero(padicField(p))
  shows padicNorm(p)(x) = realZpow(realNat(p), integerNegValue(padicValuation(p, x)))
proof
  sorry

-- Padic.valuation_ratCast and Padic.valuation_mul.
theorem padicValuation.of_rat (q : Set)
  requires member : q ∈ ℚ
  requires nonzero : q ≠ rationalZero
  shows padicValuation(p, padicOfRat(p)(q)) = padicValRat(p, q)
proof
  sorry

theorem padicValuation.mul (x y : Set)
  requires first : x ∈ Ring.carrier(padicField(p))
  requires second : y ∈ Ring.carrier(padicField(p))
  requires left : x ≠ Ring.zero(padicField(p))
  requires right : y ≠ Ring.zero(padicField(p))
  shows padicValuation(p, call2(Ring.mul(padicField(p)), x, y)) =
    integerAddValue(padicValuation(p, x), padicValuation(p, y))
proof
  sorry

-- Section: ℤ_p
-- ℤ_[p] is a subring and a discrete valuation ring with maximal ideal (p)
-- and uniformizer p (PadicInt.subring, PadicInt.isDiscreteValuationRing,
-- PadicInt.maximalIdeal_eq_span_p, PadicInt.irreducible_p, PadicInt.prime_p).
theorem padicIntCarrier.subring
  shows Subring(padicField(p), padicIntCarrier(p))
proof
  obtain ⟨normed, ultra⟩ := tkH.qp.normed at p with prime
  obtain ⟨field, comm, normedRing, mult, normOne⟩ := normed
  obtain ⟨ring, normedGroup, submult⟩ := normedRing
  obtain ⟨abelian, isNorm⟩ := normedGroup
  obtain ⟨normF, nonneg, zeroIff, negInv, tri⟩ := isNorm
  obtain ⟨nr, ultraLaw⟩ := ultra
  ring_additive at normF
  ring_additive at nonneg
  ring_additive at zeroIff
  ring_additive at negInv
  have zeroK := Ring.zero_mem with ring
  have oneK := Ring.one_mem with ring
  unfold Subring
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩
  . intros x hx
    have m := padicIntCarrier.membership.forward with hx
    exact m.left
  . apply padicIntCarrier.membership.backward
    have z := zeroIff with Ring.zero(padicField(p)), zeroK
    have z0 := z.backward with rfl
    refine ⟨zeroK, ?_⟩
    rw z0
    linarith
  . apply padicIntCarrier.membership.backward
    refine ⟨oneK, ?_⟩
    rw normOne
    linarith
  . intros x hx
    obtain ⟨xK, le⟩ := padicIntCarrier.membership.forward with hx
    apply padicIntCarrier.membership.backward
    have negIn := Ring.neg_mem at padicField(p), x with ring, xK
    have n := negInv with x, xK
    rw n
    exact ⟨negIn, le⟩
  . intros x hx y hy
    obtain ⟨xK, xle⟩ := padicIntCarrier.membership.forward with hx
    obtain ⟨yK, yle⟩ := padicIntCarrier.membership.forward with hy
    apply padicIntCarrier.membership.backward
    have sIn := Ring.add_mem at padicField(p), x, y with ring, xK, yK
    have u := ultraLaw with x, xK, y, yK
    have r1 := FunctionBetween.apply_closed with normF, xK
    have r2 := FunctionBetween.apply_closed with normF, yK
    have r3 := FunctionBetween.apply_closed with normF, sIn
    refine ⟨sIn, ?_⟩
    rcases u with a | b
    . linarith
    . linarith
  . intros x hx y hy
    obtain ⟨xK, xle⟩ := padicIntCarrier.membership.forward with hx
    obtain ⟨yK, yle⟩ := padicIntCarrier.membership.forward with hy
    apply padicIntCarrier.membership.backward
    have pIn := Ring.mul_mem at padicField(p), x, y with ring, xK, yK
    have m := mult with x, xK, y, yK
    have r1 := FunctionBetween.apply_closed with normF, xK
    have r2 := FunctionBetween.apply_closed with normF, yK
    have n1 := nonneg with x, xK
    have n2 := nonneg with y, yK
    have step := realLe.mul_right_of_nonnegative at padicNorm(p)(x), realOne, padicNorm(p)(y) with xle, n2
    refine ⟨pIn, ?_⟩
    rw m
    have one : (1:R) * (padicNorm(p)(y):R) = (padicNorm(p)(y):R) by ring
    rw one at step
    linarith

theorem padicIntRing.dvr
  shows DiscreteValuationRing(padicIntRing(p))
proof
  sorry

theorem padicIntRing.maximal_ideal
  shows localMaximalIdeal(padicIntRing(p)) =
    ringMultiples(padicIntRing(p), natCast(padicIntRing(p), p))
proof
  sorry

theorem padicIntRing.uniformizer
  shows Uniformizer(padicIntRing(p), natCast(padicIntRing(p), p))
proof
  sorry

-- The operations of ℤ_p are those of ℚ_p (PadicInt.coe_add, coe_mul,
-- coe_natCast).
theorem padicIntRing.nat_cast (n : Nat)
  shows natCast(padicIntRing(p), n) = natCast(padicField(p), n)
proof
  sorry

-- PadicInt.isUnit_iff: x is a unit exactly when ‖x‖ = 1.
theorem padicIntRing.unit_iff (x : Set)
  requires member : x ∈ padicIntCarrier(p)
  shows RingUnit(padicIntRing(p), x) ↔ padicNorm(p)(x) = realOne
proof
  sorry

-- PadicInt.norm_le_pow_iff_mem_span_pow: ‖x‖ ≤ p^(−n) ↔ x ∈ (pⁿ).
theorem padicIntRing.norm_le_pow_iff (x : Set, n : Nat)
  requires member : x ∈ padicIntCarrier(p)
  shows padicNorm(p)(x) ≤ realZpow(realNat(p), integerNegValue(integerOfNat(n))) ↔
    x ∈ ringMultiples(padicIntRing(p), natCast(padicIntRing(p), p ^ n))
proof
  sorry

-- PadicInt.norm_p, PadicInt.norm_p_pow: ‖pⁿ‖ = p^(−n).
theorem padicIntRing.norm_p_pow (n : Nat)
  shows padicNorm(p)(natCast(padicIntRing(p), p ^ n)) =
    realZpow(realNat(p), integerNegValue(integerOfNat(n)))
proof
  sorry

-- PadicInt.norm_natCast_eq_one_iff.
theorem padicIntRing.nat_unit_iff (n : Nat)
  shows RingUnit(padicIntRing(p), natCast(padicIntRing(p), n)) ↔ ¬(p ∣ n)
proof
  sorry

-- PadicInt.unitCoeff_spec: x ≠ 0 is u pⁿ with u a unit and n = v(x).
theorem padicIntRing.unit_coeff (x : Set)
  requires member : x ∈ padicIntCarrier(p)
  requires nonzero : x ≠ Ring.zero(padicField(p))
  shows ∃ u ∈ padicIntCarrier(p), ∃ n ∈ ℕ, RingUnit(padicIntRing(p), u) ∧
    integerOfNat(n) = padicValuation(p, x) ∧
    x = call2(Ring.mul(padicField(p)), u, natCast(padicField(p), p ^ n))
proof
  sorry

-- PadicInt.exists_pow_neg_lt: p^(−k) < ε for some k.
theorem padicIntRing.exists_pow_neg_lt (ε : Set)
  requires real : ε ∈ ℝ
  requires positive : realZero < ε
  shows ∃ k ∈ ℕ, realZpow(realNat(p), integerNegValue(integerOfNat(k))) < ε
proof
  sorry

-- PadicInt.pow_p_dvd_int_iff: pⁿ ∣ z in ℤ_p exactly when pⁿ ∣ z in ℤ.
theorem padicIntRing.pow_dvd_int_iff (z : Set, n : Nat)
  requires integer : z ∈ ℤ
  shows RingDvd(padicIntRing(p), natCast(padicIntRing(p), p ^ n),
      intCastHom(padicIntRing(p))(z)) ↔
    IntegerDivides(integerOfNat(p ^ n), z)
proof
  sorry

-- PadicInt.appr_spec, PadicInt.denseRange_natCast: every x is congruent
-- modulo pⁿ to a natural number a < pⁿ; ℕ is dense in ℤ_p.
theorem padicIntRing.appr (x : Set, n : Nat)
  requires member : x ∈ padicIntCarrier(p)
  shows ∃ a ∈ ℕ, a < p ^ n ∧
    Ring.sub(padicField(p), x, natCast(padicField(p), a)) ∈
      ringMultiples(padicIntRing(p), natCast(padicIntRing(p), p ^ n))
proof
  sorry

theorem padicIntRing.nat_dense (x ε : Set)
  requires member : x ∈ padicIntCarrier(p)
  requires real : ε ∈ ℝ
  requires positive : realZero < ε
  shows ∃ a ∈ ℕ, padicNorm(p)(Ring.sub(padicField(p), x, natCast(padicField(p), a))) < ε
proof
  sorry

-- ℤ_p is compact (PadicInt.compactSpace), and open and closed in ℚ_p.
theorem padicIntCarrier.compact
  shows Compact(normTopology(Ring.additive(padicField(p)), padicNorm(p)), padicIntCarrier(p))
proof
  sorry

theorem padicIntCarrier.clopen
  shows Clopen(normTopology(Ring.additive(padicField(p)), padicNorm(p)), padicIntCarrier(p))
proof
  sorry

-- Section: ℤ_p as an inverse limit
-- PadicInt.toZModPow is a surjective ring homomorphism with kernel (pⁿ)
-- (PadicInt.ker_toZModPow, PadicInt.zmod_congr_of_sub_mem_span), and it
-- sends integers to their classes (PadicInt.toZModPow on Int.cast).
theorem padicToZModPow.ring_hom (n : Nat)
  shows (padicToZModPow(p, n) : padicIntRing(p) →+* zmod(p ^ n)) ∧
    SurjectiveBetween(padicToZModPow(p, n), padicIntCarrier(p), Ring.carrier(zmod(p ^ n)))
proof
  sorry

theorem padicToZModPow.ker (x : Set, n : Nat)
  requires member : x ∈ padicIntCarrier(p)
  shows padicToZModPow(p, n)(x) = Ring.zero(zmod(p ^ n)) ↔
    x ∈ ringMultiples(padicIntRing(p), natCast(padicIntRing(p), p ^ n))
proof
  sorry

theorem padicToZModPow.int_cast (z : Set, n : Nat)
  requires integer : z ∈ ℤ
  shows padicToZModPow(p, n)(intCastHom(padicIntRing(p))(z)) = zmodCast(p ^ n)(z)
proof
  sorry

-- PadicInt.cast_toZModPow: the reductions are compatible.
theorem padicToZModPow.compatible (x a : Set, m n : Nat)
  requires member : x ∈ padicIntCarrier(p)
  requires integer : a ∈ ℤ
  requires le : m ≤ n
  requires value : padicToZModPow(p, n)(x) = zmodCast(p ^ n)(a)
  shows padicToZModPow(p, m)(x) = zmodCast(p ^ m)(a)
proof
  sorry

-- PadicInt.ext_of_toZModPow.
theorem padicToZModPow.ext (x y : Set)
  requires first : x ∈ padicIntCarrier(p)
  requires second : y ∈ padicIntCarrier(p)
  shows x = y ↔ (∀ n ∈ ℕ, padicToZModPow(p, n)(x) = padicToZModPow(p, n)(y))
proof
  sorry

-- ℤ_p ≅ lim ℤ/pⁿℤ (PadicInt.lift with its uniqueness, the inverse-limit
-- description of ℤ_p): x ↦ (toZModPow n x)ₙ is a bijection onto the
-- compatible families.
theorem padicToLimit.bijective
  shows BijectiveBetween(padicToLimit(p), padicIntCarrier(p), zmodPowLimit(p))
proof
  sorry

-- PadicInt.toZMod: the residue field of ℤ_p is ℤ/pℤ, through the
-- reduction, whose kernel is the maximal ideal.
theorem padicToZMod.ker (x : Set)
  requires member : x ∈ padicIntCarrier(p)
  shows padicToZMod(p)(x) = Ring.zero(zmod(p)) ↔ x ∈ localMaximalIdeal(padicIntRing(p))
proof
  sorry

end PadicField
