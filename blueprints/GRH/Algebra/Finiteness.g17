-- Finiteness conditions in commutative algebra: finitely generated
-- submodules, finite and finitely presented modules, subalgebras and the
-- subalgebra generated by a set (Algebra.adjoin), finite algebras,
-- algebras of finite type and of finite presentation, Noetherian and
-- Artinian modules and rings with the chain conditions, the Hilbert basis
-- theorem, Artinian rings, and the length of a module of finite length.
-- Noetherian modules are defined as in Mathlib (every submodule finitely
-- generated) and Artinian modules by the minimal condition (Mathlib's
-- well-foundedness of < on submodules); the chain conditions are stated
-- beside them, and the comments say which implications need dependent
-- choice.
-- Part of the GRH blueprint.
-- Planned home: Algebra/Module/Finiteness and Algebra/Ring/Noetherian.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Algebra.Finiteness
import GRH.Algebra.LocalRings
import GRH.Polynomial.Multivariate
import Grace.Cumulus.Algebra.Adjoin

-- Section: Finitely generated submodules and finite modules
-- A finite module is track A's FinitelyGeneratedModule (Module.Finite).
-- A submodule spanned by a finite set (Submodule.FG):
predicate SubmoduleFG (M R N : Set) :=
  SubmoduleOf(N, M, R) ∧
  (∃ S, S ⊆ N ∧ Finite(S) ∧ moduleSpan(M, R, S) = N)

-- A finitely presented module: a quotient of Rⁿ by a finitely generated
-- submodule (Module.FinitePresentation).
predicate FinitelyPresentedModule (M R : Set) :=
  Module(M, R) ∧ (∃ n, Nat(n) ∧ ∃ f, LinearMap(f, coordinateModule(R, n), R, M) ∧
    SurjectiveBetween(f, Module.carrier(coordinateModule(R, n)), Module.carrier(M)) ∧
    SubmoduleFG(coordinateModule(R, n), R, linearKernel(f, coordinateModule(R, n), M)))

-- Section: Subalgebras and finiteness of algebras
-- For an R-algebra A: subalgebras, the subalgebra generated by G
-- (Algebra.adjoin), as Cumulus's forms over the projections of A.
predicate SubalgebraOf (A T : Set) :=
  Algebra(A) ∧ Subalgebra(Algebra.map(A), Ring.carrier(Algebra.base(A)),
    algebraCarrier(A), Ring.add(Algebra.ring(A)), Ring.zero(Algebra.ring(A)),
    Ring.neg(Algebra.ring(A)), Ring.mul(Algebra.ring(A)),
    Ring.one(Algebra.ring(A)), T)

def adjoinOf (A G : Set) : Set :=
  algebraAdjoin(Algebra.map(A), Ring.carrier(Algebra.base(A)),
    algebraCarrier(A), Ring.add(Algebra.ring(A)), Ring.zero(Algebra.ring(A)),
    Ring.neg(Algebra.ring(A)), Ring.mul(Algebra.ring(A)),
    Ring.one(Algebra.ring(A)), G)

-- A finite algebra: finitely generated as a module over the base
-- (Algebra.Finite, Module.Finite R A).
predicate FiniteAlgebra (A : Set) :=
  Algebra(A) ∧ FinitelyGeneratedModule(algebraModule(A), Algebra.base(A))

-- An algebra of finite type: generated by finitely many elements
-- (Algebra.FiniteType).
predicate FiniteTypeAlgebra (A : Set) :=
  Algebra(A) ∧ (∃ G, G ⊆ algebraCarrier(A) ∧ Finite(G) ∧
    adjoinOf(A, G) = algebraCarrier(A))

-- An algebra of finite presentation: a quotient of a polynomial algebra
-- in finitely many variables by a finitely generated ideal
-- (Algebra.FinitePresentation).
predicate FinitePresentationAlgebra (A : Set) :=
  Algebra(A) ∧ (∃ n, Nat(n) ∧ ∃ f,
    AlgebraHom(f, polynomialAlgebra(Algebra.base(A), n), A) ∧
    SurjectiveBetween(f, Ring.carrier(polynomialRing(Algebra.base(A), n)),
      algebraCarrier(A)) ∧
    FinitelyGeneratedIdeal(polynomialRing(Algebra.base(A), n),
      ringKernel(f, Ring.carrier(polynomialRing(Algebra.base(A), n)),
        Ring.zero(Algebra.ring(A)))))

-- Section: Noetherian and Artinian modules and rings
-- Noetherian: every submodule is finitely generated (IsNoetherian), and
-- every ideal of a Noetherian ring (IsNoetherianRing).
predicate NoetherianModule (M R : Set) :=
  Module(M, R) ∧ (∀ N, SubmoduleOf(N, M, R) → SubmoduleFG(M, R, N))

predicate NoetherianRing (R : Set) :=
  CommRing(R) ∧ (∀ I, Ideal(R, I) → FinitelyGeneratedIdeal(R, I))

-- The chain conditions on sequences: an increasing sequence of submodules
-- is eventually constant (ACC), a decreasing one is (DCC); the maximal
-- and minimal conditions on nonempty sets of submodules.
predicate AscendingChainCondition (M R : Set) :=
  ∀ N, (∀ n ∈ ℕ, SubmoduleOf(N(n), M, R)) →
    (∀ n ∈ ℕ, N(n) ⊆ N(succ(n))) → (∃ k ∈ ℕ, ∀ n ∈ ℕ, k ≤ n → N(n) = N(k))

predicate DescendingChainCondition (M R : Set) :=
  ∀ N, (∀ n ∈ ℕ, SubmoduleOf(N(n), M, R)) →
    (∀ n ∈ ℕ, N(succ(n)) ⊆ N(n)) → (∃ k ∈ ℕ, ∀ n ∈ ℕ, k ≤ n → N(n) = N(k))

predicate MaximalCondition (M R : Set) :=
  ∀ F, F ≠ ∅ → (∀ N ∈ F, SubmoduleOf(N, M, R)) →
    (∃ N ∈ F, ∀ P ∈ F, N ⊆ P → P = N)

predicate MinimalCondition (M R : Set) :=
  ∀ F, F ≠ ∅ → (∀ N ∈ F, SubmoduleOf(N, M, R)) →
    (∃ N ∈ F, ∀ P ∈ F, P ⊆ N → P = N)

-- Artinian: the minimal condition (IsArtinian, WellFoundedLT on
-- submodules); an Artinian ring is Artinian over itself (IsArtinianRing).
predicate ArtinianModule (M R : Set) := Module(M, R) ∧ MinimalCondition(M, R)

predicate ArtinianRing (R : Set) :=
  CommRing(R) ∧ ArtinianModule(selfModule(R), R)

-- Section: Length
-- A composition series of length n: submodules N(0) = 0 ⊊ N(1) ⊊ ⋯ ⊊ N(n)
-- = M with nothing strictly between consecutive terms. M has finite
-- length when it has one; its length is the n (Module.length, finite
-- case; unique by Jordan–Hölder).
predicate CompositionSeries (M R N : Set, n : Nat) :=
  (∀ k ∈ succ(n), SubmoduleOf(N(k), M, R)) ∧ N(0) = {Module.zero(M)} ∧
  N(n) = Module.carrier(M) ∧
  (∀ k ∈ n, N(k) ⊆ N(succ(k)) ∧ N(k) ≠ N(succ(k)) ∧
    (∀ P, SubmoduleOf(P, M, R) → N(k) ⊆ P → P ⊆ N(succ(k)) →
      P = N(k) ∨ P = N(succ(k))))

predicate HasLength (M R : Set, n : Nat) := ∃ N, CompositionSeries(M, R, N, n)

predicate FiniteLength (M R : Set) := Module(M, R) ∧ (∃ n ∈ ℕ, HasLength(M, R, n))

defunique moduleLength (M R : Set) (n ∈ ℕ) := HasLength(M, R, n)
requires ring : CommRing(R)
requires finiteLength : FiniteLength(M, R)
proof
  obtain ⟨_, n, nN, h⟩ := finiteLength
  witness n
  exact ⟨nN, h⟩
uniqueness
  sorry

-- A simple module: nonzero with no submodules but 0 and M (IsSimpleModule).
predicate SimpleModule (M R : Set) :=
  Module(M, R) ∧ Module.carrier(M) ≠ {Module.zero(M)} ∧
  (∀ N, SubmoduleOf(N, M, R) → N = {Module.zero(M)} ∨ N = Module.carrier(M))

-- The monoid generated by G: finite products of elements of G, as the
-- intersection of the sets containing 1 and G closed under products.
def generatedMonoid (A G : Set) : Set :=
  { x ∈ algebraCarrier(A) | ∀ T, T ⊆ algebraCarrier(A) →
    Ring.one(Algebra.ring(A)) ∈ T → G ⊆ T →
    (∀ y z ∈ T, call2(Ring.mul(Algebra.ring(A)), y, z) ∈ T) → x ∈ T }

-- The minimal primes over I, the maximal ideals, and the family of
-- localizations at a family of primes.
def minimalPrimesOver (R I : Set) : Set :=
  { P ∈ 𝒫(Ring.carrier(R)) | MinimalPrimeOver(R, I, P) }

def maximalIdeals (R : Set) : Set :=
  { M ∈ 𝒫(Ring.carrier(R)) | MaximalIdeal(R, M) }

def localizationRings (R K P : Set) : Set :=
  { localizationAtPrime(R, P(k)) | k ∈ K }

def localizationFamily (R K P : Set) : Set :=
  { u ∈ K × localizationRings(R, K, P) | ∃ k ∈ K, u = (k, localizationAtPrime(R, P(k))) }

-- Helpers (finiteness track): spans of unions and images of the whole
-- module under a surjective linear map.
theorem finHelp.span_union_spans (R M S T : Set)
  requires ring : Ring(R)
  requires module : Module(M, R)
  requires sS : S ⊆ M.carrier
  requires sT : T ⊆ M.carrier
  shows moduleSpan(M, R, S ∪ T) =
    moduleSpan(M, R, moduleSpan(M, R, S) ∪ moduleSpan(M, R, T))
proof
  have inS := moduleSpan.subset_span at R, M, S with ring, module, sS
  have inT := moduleSpan.subset_span at R, M, T with ring, module, sT
  have unionSub : S ∪ T ⊆ M.carrier
    intros x hx
    have cases := union2.membership.forward with hx
    cases cases with inA | inB
    . exact sS with x, inA
    . exact sT with x, inB
  have bigSub := moduleSpan.submodule at R, M, S ∪ T with ring, module
  have spanS := moduleSpan.mono at R, M, S, S ∪ T with ring, module, (union2.subset_left at S, T)
  have spanT := moduleSpan.mono at R, M, T, S ∪ T with ring, module, (union2.subset_right at S, T)
  have small : S ∪ T ⊆ moduleSpan(M, R, S) ∪ moduleSpan(M, R, T)
    intros x hx
    have cases := union2.membership.forward with hx
    cases cases with inA | inB
    . exact union2.left with (inS with x, inA)
    . exact union2.right with (inT with x, inB)
  have big : moduleSpan(M, R, S) ∪ moduleSpan(M, R, T) ⊆ moduleSpan(M, R, S ∪ T)
    intros x hx
    have cases := union2.membership.forward with hx
    cases cases with inA | inB
    . exact spanS with x, inA
    . exact spanT with x, inB
  have spanSM := moduleSpan.submodule at R, M, S with ring, module
  have spanTM := moduleSpan.submodule at R, M, T with ring, module
  have sSM := SubmoduleOf.subset at R, M, moduleSpan(M, R, S) with ring, module, spanSM
  have sTM := SubmoduleOf.subset at R, M, moduleSpan(M, R, T) with ring, module, spanTM
  have bothSub : moduleSpan(M, R, S) ∪ moduleSpan(M, R, T) ⊆ M.carrier
    exact Subset.transitive with big, (SubmoduleOf.subset at R, M, moduleSpan(M, R, S ∪ T) with ring, module, bigSub)
  have one := moduleSpan.mono at R, M, S ∪ T, moduleSpan(M, R, S) ∪ moduleSpan(M, R, T) with ring, module, small
  have two := (moduleSpan.least at R, M, moduleSpan(M, R, S) ∪ moduleSpan(M, R, T), moduleSpan(M, R, S ∪ T) with ring, module, bothSub, bigSub).backward with big
  exact Subset.antisymmetric with one, two

theorem finHelp.image_whole (R M N f : Set)
  requires linear : LinearMap(f, M, R, N)
  requires surjective : SurjectiveBetween(f, M.carrier, Module.carrier(N))
  shows submoduleImage(f, M, N, M.carrier) = Module.carrier(N)
proof
  ext w
  constructor
  . intro hw
    obtain ⟨wIn, _⟩ := submoduleImage.membership.forward with hw
    exact wIn
  . intro hw
    obtain ⟨v, vIn, val⟩ := Surjective.apply_exists with surjective, hw
    apply submoduleImage.membership.backward
    exact ⟨hw, v, vIn, val⟩

theorem finHelp.union_subset (S T X : Set)
  requires left : S ⊆ X
  requires right : T ⊆ X
  shows S ∪ T ⊆ X
proof
  intros x hx
  have cases := union2.membership.forward with hx
  cases cases with inA | inB
  . exact left with x, inA
  . exact right with x, inB

theorem finHelp.image_onto (f A S C : Set)
  requires surjective : SurjectiveBetween(f, A, S)
  requires subset : S ⊆ C
  shows functionImage(f, A, C) = S
proof
  ext y
  constructor
  . intro hy
    obtain ⟨yC, x, xA, val⟩ := functionImage.membership.forward with hy
    obtain ⟨fF, _⟩ := surjective
    have fx := FunctionBetween.apply_closed with fF, xA
    rw val
    exact fx
  . intro hy
    obtain ⟨x, xA, val⟩ := Surjective.apply_exists with surjective, hy
    apply functionImage.membership.backward
    have yC := subset with y, hy
    refine ⟨yC, x, xA, ?_⟩
    symm
    exact val

-- Helpers (finiteness track): a finite subset of the union of a nonempty
-- chain lies in one member, and the union of a nonempty chain of
-- submodules is a submodule.
theorem finHelp.chain_finite_cover (S T C0 : Set)
  requires start : C0 ∈ S
  requires nested : ∀ C ∈ S, ∀ D ∈ S, C ⊆ D ∨ D ⊆ C
  requires inside : T ⊆ ⋃(S)
  requires finite : Finite(T)
  shows ∃ C ∈ S, T ⊆ C
proof
  induction finite with G a
  | empty =>
    exact ⟨C0, start, (empty.subset at C0)⟩
  | insert using ih =>
    obtain ⟨C, hC, GC⟩ := ih
    obtain ⟨D, hD, aD⟩ := union.membership.forward with aMember
    cases (nested with C, hC, D, hD) with CD | DC
    . refine ⟨D, hD, ?_⟩
      intros Z hZ
      cases (union2.membership.forward with hZ) with inG | isA
      . exact CD with Z, (GC with Z, inG)
      . rwa (singleton.membership.forward with isA)
    . refine ⟨C, hC, ?_⟩
      intros Z hZ
      cases (union2.membership.forward with hZ) with inG | isA
      . exact GC with Z, inG
      . have Za := singleton.membership.forward with isA
        rw Za
        exact DC with a, aD

theorem finHelp.chain_union_submodule (R M S C0 : Set)
  requires ring : Ring(R)
  requires module : Module(M, R)
  requires start : C0 ∈ S
  requires nested : ∀ C ∈ S, ∀ D ∈ S, C ⊆ D ∨ D ⊆ C
  requires subs : ∀ C ∈ S, SubmoduleOf(C, M, R)
  shows SubmoduleOf(⋃(S), M, R)
proof
  unfold SubmoduleOf
  refine ⟨module, ?_, ?_, ?_, ?_⟩
  . intros x hx
    obtain ⟨C, hC, xC⟩ := union.membership.forward with hx
    have sC := SubmoduleOf.subset at R, M, C with ring, module, (subs with C, hC)
    exact sC with x, xC
  . have z := SubmoduleOf.zero_mem at R, M, C0 with ring, module, (subs with C0, start)
    apply union.membership.backward
    exact ⟨C0, start, z⟩
  . intros v hv w hw
    obtain ⟨C, hC, vC⟩ := union.membership.forward with hv
    obtain ⟨D, hD, wD⟩ := union.membership.forward with hw
    apply union.membership.backward
    cases (nested with C, hC, D, hD) with CD | DC
    . refine ⟨D, hD, ?_⟩
      exact SubmoduleOf.add_mem at R, M, D, v, w with ring, module, (subs with D, hD), (CD with v, vC), wD
    . refine ⟨C, hC, ?_⟩
      exact SubmoduleOf.add_mem at R, M, C, v, w with ring, module, (subs with C, hC), vC, (DC with w, wD)
  . intros r hr v hv
    obtain ⟨C, hC, vC⟩ := union.membership.forward with hv
    apply union.membership.backward
    refine ⟨C, hC, ?_⟩
    exact SubmoduleOf.smul_mem at R, M, C, r, v with ring, module, (subs with C, hC), hr, vC

-- An increasing sequence of sets is monotone, and a decreasing one antitone.
theorem finHelp.increasing_mono_at (N : Set) (n : Nat)
  requires step : ∀ m ∈ ℕ, N(m) ⊆ N(succ(m))
  shows ∀ k ∈ ℕ, k ≤ n → N(k) ⊆ N(n)
proof
  induction n
  | zero =>
    intros k hk le
    have kNat : Nat(k) := hk
    have kz : k = 0 by arith
    rw kz
    exact Subset.reflexive at N(0)
  | succ(m) using ih =>
    intros k hk le
    have kNat : Nat(k) := hk
    have mIn : m ∈ ℕ by typecheck
    by_cases same : k = succ(m)
    . rw same
      exact Subset.reflexive at N(succ(m))
    . have le2 : k ≤ m by arith
      have first := ih with k, hk, le2
      exact Subset.transitive with first, (step with m, mIn)

theorem finHelp.decreasing_anti_at (N : Set) (n : Nat)
  requires step : ∀ m ∈ ℕ, N(succ(m)) ⊆ N(m)
  shows ∀ k ∈ ℕ, k ≤ n → N(n) ⊆ N(k)
proof
  induction n
  | zero =>
    intros k hk le
    have kNat : Nat(k) := hk
    have kz : k = 0 by arith
    rw kz
    exact Subset.reflexive at N(0)
  | succ(m) using ih =>
    intros k hk le
    have kNat : Nat(k) := hk
    have mIn : m ∈ ℕ by typecheck
    by_cases same : k = succ(m)
    . rw same
      exact Subset.reflexive at N(succ(m))
    . have le2 : k ≤ m by arith
      have first := ih with k, hk, le2
      exact Subset.transitive with (step with m, mIn), first

-- Helpers (finiteness track): the range of a sequence of sets, and the
-- spans of finite subsets of a submodule.
def finSeqRange (N : Set) : Set := { N(n) | n ∈ ℕ }

def finSpanFamily (M R N : Set) : Set :=
  { P ∈ 𝒫(Module.carrier(M)) | ∃ T, T ⊆ N ∧ Finite(T) ∧ P = moduleSpan(M, R, T) }

-- Helpers (finiteness track): submodules of a submodule, spans inside a
-- submodule, images of preimages under a surjection, and two families.
def finBadFamily (M R P : Set) : Set :=
  { Q ∈ 𝒫(Module.carrier(M)) | SubmoduleOf(Q, M, R) ∧ Q ∉ P }

def finPreimages (f M F : Set) : Set := { submodulePreimage(f, M, Q) | Q ∈ F }

theorem finHelp.sub_of_sub (R M N Q : Set)
  requires ring : Ring(R)
  requires module : Module(M, R)
  requires sub : SubmoduleOf(N, M, R)
  requires subQ : SubmoduleOf(Q, submoduleModule(M, R, N), R)
  shows SubmoduleOf(Q, M, R) ∧ Q ⊆ N
proof
  have carrier := submoduleModule.carrier_eq at M, R, N
  obtain ⟨_, QS, Qz, Qa, Qs⟩ := subQ
  rw carrier at QS
  rw (submoduleModule.zero_eq at M, R, N) at Qz
  have sN := SubmoduleOf.subset at R, M, N with ring, module, sub
  refine ⟨?_, QS⟩
  unfold SubmoduleOf
  refine ⟨module, (Subset.transitive with QS, sN), Qz, ?_, ?_⟩
  . intros v hv w hw
    have a := Qa with v, hv, w, hw
    rw (submoduleModule.add_value at M, R, N, v, w with sub, (QS with v, hv), (QS with w, hw)) at a
    exact a
  . intros r hr v hv
    have a := Qs with r, hr, v, hv
    rw (submoduleModule.smul_value at M, R, N, r, v with sub, hr, (QS with v, hv)) at a
    exact a

theorem finHelp.sub_to_sub (R M N Q : Set)
  requires ring : Ring(R)
  requires module : Module(M, R)
  requires sub : SubmoduleOf(N, M, R)
  requires subQ : SubmoduleOf(Q, M, R)
  requires QN : Q ⊆ N
  shows SubmoduleOf(Q, submoduleModule(M, R, N), R)
proof
  have carrier := submoduleModule.carrier_eq at M, R, N
  have subMod := SubmoduleOf.submodule_module at R, M, N with ring, module, sub
  obtain ⟨_, QS, Qz, Qa, Qs⟩ := subQ
  unfold SubmoduleOf
  refine ⟨subMod, ?_, ?_, ?_, ?_⟩
  . rw carrier
    exact QN
  . rw (submoduleModule.zero_eq at M, R, N)
    exact Qz
  . intros v hv w hw
    rw (submoduleModule.add_value at M, R, N, v, w with sub, (QN with v, hv), (QN with w, hw))
    exact Qa with v, hv, w, hw
  . intros r hr v hv
    rw (submoduleModule.smul_value at M, R, N, r, v with sub, hr, (QN with v, hv))
    exact Qs with r, hr, v, hv

theorem finHelp.span_inside (R M U S : Set)
  requires ringK : Ring(R)
  requires module : Module(M, R)
  requires sub : SubmoduleOf(U, M, R)
  requires SU : S ⊆ U
  shows moduleSpan(submoduleModule(M, R, U), R, S) = moduleSpan(M, R, S)
proof
  have subModule := SubmoduleOf.submodule_module at R, M, U with ringK, module, sub
  have carrier := submoduleModule.carrier_eq at M, R, U
  have UV := SubmoduleOf.subset at R, M, U with ringK, module, sub
  have SV : S ⊆ M.carrier
    intros x hx
    exact UV with x, (SU with x, hx)
  have SS : S ⊆ Module.carrier(submoduleModule(M, R, U))
    rw carrier
    exact SU
  have incl := SubmoduleOf.inclusion_linear at R, M, U with ringK, module, sub
  have imageSpan := LinearMap.image_span at R, submoduleModule(M, R, U), M, identity(U), S with ringK, subModule, module, incl, SS
  have imageS : functionImage(identity(U), S, M.carrier) = S
    ext y
    constructor
    . intro hy
      obtain ⟨_, x, hx, yx⟩ := functionImage.membership.forward with hy
      have a := identity.apply at x, U with (SU with x, hx)
      rw [yx, a]
      exact hx
    . intro hy
      have a := identity.apply at y, U with (SU with y, hy)
      apply functionImage.membership.backward
      refine ⟨(SV with y, hy), y, hy, ?_⟩
      rw a
  rw imageS at imageSpan
  have spanSub := moduleSpan.submodule at R, submoduleModule(M, R, U), S with ringK, subModule
  have spanSubset := SubmoduleOf.subset at R, submoduleModule(M, R, U), moduleSpan(submoduleModule(M, R, U), R, S) with ringK, subModule, spanSub
  rw carrier at spanSubset
  rw ← imageSpan
  ext x
  constructor
  . intro hx
    have xU := spanSubset with x, hx
    have a := identity.apply at x, U with xU
    apply submoduleImage.membership.backward
    refine ⟨(UV with x, xU), x, hx, a⟩
  . intro hx
    obtain ⟨_, y, hy, yx⟩ := submoduleImage.membership.forward with hx
    have yU := spanSubset with y, hy
    have a := identity.apply at y, U with yU
    rw a at yx
    rw ← yx
    exact hy

theorem finHelp.image_preimage (f M N Q : Set)
  requires surjective : SurjectiveBetween(f, M.carrier, Module.carrier(N))
  requires inside : Q ⊆ Module.carrier(N)
  shows submoduleImage(f, M, N, submodulePreimage(f, M, Q)) = Q
proof
  ext w
  constructor
  . intro hw
    obtain ⟨_, v, hv, vw⟩ := submoduleImage.membership.forward with hw
    obtain ⟨_, fv⟩ := submodulePreimage.membership.forward with hv
    rw ← vw
    exact fv
  . intro hw
    have wN := inside with w, hw
    obtain ⟨v, vM, vw⟩ := Surjective.apply_exists with surjective, wN
    apply submoduleImage.membership.backward
    refine ⟨wN, v, ?_, vw⟩
    apply submodulePreimage.membership.backward
    rw vw
    exact ⟨vM, hw⟩

-- Helper (finiteness track): a nonempty finite family of sets has a
-- member minimal under inclusion.
theorem finHelp.finite_minimal (F : Set)
  requires finite : Finite(F)
  shows F = ∅ ∨ (∃ N ∈ F, ∀ P ∈ F, P ⊆ N → P = N)
proof
  induction finite with G a
  | empty =>
    left
    rfl
  | insert using ih =>
    right
    have aIn := union2.right at a, G, {a} with (singleton.self at a)
    cases ih with emptyG | found
    . refine ⟨a, aIn, ?_⟩
      intros P hP Pa
      cases (union2.membership.forward with hP) with inG | isA
      . rw emptyG at inG
        simp at inG
      . exact singleton.membership.forward with isA
    . obtain ⟨N, hN, minN⟩ := found
      by_cases aN : a ⊆ N
      . refine ⟨a, aIn, ?_⟩
        intros P hP Pa
        cases (union2.membership.forward with hP) with inG | isA
        . have PN := Subset.transitive with Pa, aN
          have eq := minN with P, inG, PN
          rw eq at Pa
          have aEq := Subset.antisymmetric with aN, Pa
          rw aEq
          exact eq
        . exact singleton.membership.forward with isA
      . refine ⟨N, (union2.left at N, G, {a} with hN), ?_⟩
        intros P hP PN
        cases (union2.membership.forward with hP) with inG | isA
        . exact minN with P, inG, PN
        . have Pa := singleton.membership.forward with isA
          rw Pa at PN
          exfalso
          exact aN with PN

-- Helper (finiteness track): a subalgebra is a submodule of the algebra
-- as a module over its base.
theorem finHelp.subalgebra_submodule (A T : Set)
  requires algebra : Algebra(A)
  requires subalgebra : SubalgebraOf(A, T)
  shows SubmoduleOf(T, algebraModule(A), Algebra.base(A))
proof
  have modA := algebraModule.module_of at A with algebra
  have sh := Algebra.structure_hom at A with algebra
  have hp := RingHom.parts with sh
  have mapF := IsRingHom.function with hp
  obtain ⟨_, sub⟩ := subalgebra
  obtain ⟨subring, img⟩ := sub
  obtain ⟨TS, zT, oT, negC, addC, mulC⟩ := subring
  have z : Module.zero(algebraModule(A)) = Ring.zero(Algebra.ring(A))
    unfold algebraModule
    module_projections
  have TC : T ⊆ algebraCarrier(A) := TS
  unfold SubmoduleOf
  refine ⟨modA, ?_, ?_, ?_, ?_⟩
  . rw (algebraModule.carrier_eq at A)
    exact TC
  . rw z
    exact zT
  . rw (algebraModule.add_eq at A)
    intros v hv w hw
    exact ClosedBinary.mem with addC, hv, hw
  . intros r hr v hv
    rw (algebraModule.smul_value at A, r, v with algebra, hr, (TC with v, hv))
    have mapF2 : Algebra.map(A) : Ring.carrier(Algebra.base(A)) → algebraCarrier(A)
      unfold algebraCarrier
      exact mapF
    have fv := functionImage.value at Algebra.map(A), Ring.carrier(Algebra.base(A)), algebraCarrier(A), r with mapF2, hr
    have mr := img with Algebra.map(A)(r), fv
    exact ClosedBinary.mem with mulC, mr, hv

-- Helper (finiteness track): (−1) x = −x in a commutative ring.
section FinRingHelpers
variable (R : Set)
hypothesis comm : CommRing(R)

theorem finHelp.neg_one_mul (x : R)
  shows (-R[1]) * x = -x
proof
  ring

theorem finHelp.unit_of_pow_eq (a c : R) (k : Nat)
  requires domain : IntegralDomain(R)
  requires nonzero : a ≠ R[0]
  requires equal : a ^ k = a ^ succ(k) * c
  shows RingUnit(R, a)
proof
  have ringR := CommRing.to_ring with comm
  have shift := add.right_one at k with *
  have aIn : a ∈ R.carrier by assumption
  have cIn : c ∈ R.carrier by assumption
  have s := Ring.pow_succ at R, a, k with aIn, ringR
  rw ← shift at equal
  rw s at equal
  have pne : a ^ k ≠ R[0]
    intro pz
    have az := IntegralDomain.pow_eq_zero at R, a, k with domain, aIn, pz
    exact nonzero with az
  have e2 : a ^ k * R[1] = a ^ k * (a * c)
    linear_combination equal
  have pIn : a ^ k ∈ R.carrier by typecheck
  have one : R[1] ∈ R.carrier by typecheck
  have acIn : a * c ∈ R.carrier by typecheck
  have c1 := IntegralDomain.mul_cancel at R, a ^ k, R[1], a * c with domain, pIn, one, acIn, pne, e2
  have c2 : a * c = R[1]
    symm
    exact c1
  have c3 : c * a = R[1]
    linear_combination c2
  unfold RingUnit
  exact ⟨aIn, c, cIn, c2, c3⟩

end FinRingHelpers

-- The principal ideals (aⁿ), n ∈ ℕ.
def finPowIdeals (R a : Set) : Set := { ringMultiples(R, Ring.pow(R, a, n)) | n ∈ ℕ }

-- Helper (finiteness track): finitely many elements with preimages in K
-- have preimages in a finite subset of K.
theorem finHelp.finite_lift (g K B : Set)
  requires finite : Finite(B)
  requires lifts : ∀ b ∈ B, ∃ x ∈ K, g(x) = b
  shows ∃ L, L ⊆ K ∧ Finite(L) ∧ (∀ b ∈ B, ∃ x ∈ L, g(x) = b)
proof
  induction finite with H a
  | empty =>
    refine ⟨∅, (empty.subset at K), Finite.empty, ?_⟩
    intros b hb
    simp at hb
  | insert using ih =>
    obtain ⟨L, LK, finL, cover⟩ := ih
    obtain ⟨x, xK, gx⟩ := lifts with a, aMember
    have xs := (singleton.subset_iff at x, K).backward with xK
    have LxK := finHelp.union_subset at L, {x}, K with LK, xs
    have finLx := Finite.union with finL, (Finite.singleton at x)
    refine ⟨L ∪ {x}, LxK, finLx, ?_⟩
    intros b hb
    cases (union2.membership.forward with hb) with inH | isA
    . obtain ⟨y, yL, gy⟩ := cover with b, inH
      exact ⟨y, (union2.left at y, L, {x} with yL), gy⟩
    . have ba := singleton.membership.forward with isA
      rw ba
      exact ⟨x, (union2.right at x, L, {x} with (singleton.self at x)), gx⟩

-- Section: Finite modules
section FiniteModules
variable (R M : Set)
hypothesis comm : CommRing(R)
hypothesis module : Module(M, R)

-- Module.Finite.iff_fg: M is finite iff its top submodule is f.g.
theorem FinitelyGeneratedModule.iff_fg
  shows FinitelyGeneratedModule(M, R) ↔ SubmoduleFG(M, R, M.carrier)
proof
  have ringR := CommRing.to_ring with comm
  have whole := SubmoduleOf.whole at R, M with ringR, module
  constructor
  . intro h
    obtain ⟨_, S, sub, fin, eq⟩ := h
    unfold SubmoduleFG
    exact ⟨whole, S, sub, fin, eq⟩
  . intro h
    obtain ⟨_, S, sub, fin, eq⟩ := h
    unfold FinitelyGeneratedModule
    exact ⟨module, S, sub, fin, eq⟩

-- Submodule.fg_span, isNoetherian_span_of_finite: a finite set spans an
-- f.g. submodule; f.g. submodules are closed under sums and images.
theorem SubmoduleFG.span (S : Set)
  requires subset : S ⊆ M.carrier
  requires finite : Finite(S)
  shows SubmoduleFG(M, R, moduleSpan(M, R, S))
proof
  have ringR := CommRing.to_ring with comm
  have sub := moduleSpan.submodule at R, M, S with ringR, module
  have inside := moduleSpan.subset_span at R, M, S with ringR, module, subset
  unfold SubmoduleFG
  exact ⟨sub, S, inside, finite, rfl⟩

theorem SubmoduleFG.sum (N P : Set)
  requires first : SubmoduleFG(M, R, N)
  requires second : SubmoduleFG(M, R, P)
  shows SubmoduleFG(M, R, submoduleSum(M, N, P))
proof
  have ringR := CommRing.to_ring with comm
  obtain ⟨subN, S, SN, finS, spanS⟩ := first
  obtain ⟨subP, T, TP, finT, spanT⟩ := second
  have sN := SubmoduleOf.subset at R, M, N with ringR, module, subN
  have sP := SubmoduleOf.subset at R, M, P with ringR, module, subP
  have SM := Subset.transitive with SN, sN
  have TM := Subset.transitive with TP, sP
  have sumEq := submoduleSum.span_union at R, M, N, P with ringR, module, subN, subP
  have spans := finHelp.span_union_spans at R, M, S, T with ringR, module, SM, TM
  rw [spanS, spanT] at spans
  have sumSub := submoduleSum.submodule at R, M, N, P with ringR, module, subN, subP
  have fin := Finite.union with finS, finT
  have inside : S ∪ T ⊆ submoduleSum(M, N, P)
    rw sumEq
    rw ← spans
    exact moduleSpan.subset_span at R, M, S ∪ T with ringR, module, (finHelp.union_subset at S, T, M.carrier with SM, TM)
  unfold SubmoduleFG
  refine ⟨sumSub, S ∪ T, inside, fin, ?_⟩
  rw sumEq
  exact spans

theorem SubmoduleFG.image (N f P : Set)
  requires fg : SubmoduleFG(M, R, N)
  requires linear : LinearMap(f, M, R, P)
  shows SubmoduleFG(P, R, submoduleImage(f, M, P, N))
proof
  have ringR := CommRing.to_ring with comm
  obtain ⟨sub, S, SN, fin, spanEq⟩ := fg
  have sN := SubmoduleOf.subset at R, M, N with ringR, module, sub
  have SM := Subset.transitive with SN, sN
  have moduleP := LinearMap.target_module with linear
  have fF := LinearMap.function_of with linear
  have img := LinearMap.image_span at R, M, P, f, S with ringR, module, moduleP, linear, SM
  rw spanEq at img
  have imgSub := functionImage.subset at f, S, P.carrier
  have finImg := Finite.function_image at M.carrier, P.carrier, f, S with fF, fin, SM
  have spanSub := moduleSpan.submodule at R, P, functionImage(f, S, P.carrier) with ringR, moduleP
  have inside := moduleSpan.subset_span at R, P, functionImage(f, S, P.carrier) with ringR, moduleP, imgSub
  rw ← img at spanSub
  rw ← img at inside
  unfold SubmoduleFG
  refine ⟨spanSub, functionImage(f, S, P.carrier), inside, finImg, ?_⟩
  symm
  exact img

-- Module.Finite.of_surjective and Module.Finite.equiv: images of finite
-- modules are finite.
theorem FinitelyGeneratedModule.of_surjective (N f : Set)
  requires finite : FinitelyGeneratedModule(M, R)
  requires linear : LinearMap(f, M, R, N)
  requires surjective : SurjectiveBetween(f, M.carrier, Module.carrier(N))
  shows FinitelyGeneratedModule(N, R)
proof
  have ringR := CommRing.to_ring with comm
  have fg := (FinitelyGeneratedModule.iff_fg at R, M with comm, module).forward with finite
  have img := SubmoduleFG.image at R, M, M.carrier, f, N with comm, module, fg, linear
  have whole := finHelp.image_whole at R, M, N, f with linear, surjective
  rw whole at img
  have moduleN := LinearMap.target_module with linear
  exact (FinitelyGeneratedModule.iff_fg at R, N with comm, moduleN).backward with img

-- A quotient of a finite module is finite.
theorem FinitelyGeneratedModule.quotient (N : Set)
  requires finite : FinitelyGeneratedModule(M, R)
  requires sub : SubmoduleOf(N, M, R)
  shows FinitelyGeneratedModule(quotientModule(M, R, N), R)
proof
  have ringR := CommRing.to_ring with comm
  have lin := SubmoduleOf.quotient_map_linear at R, M, N with ringR, module, sub
  have onto := SubmoduleOf.quotient_map_surjective at R, M, N with ringR, module, sub
  exact FinitelyGeneratedModule.of_surjective at R, M, quotientModule(M, R, N), quotientModuleMap(M, N) with comm, module, finite, lin, onto

-- Module.Finite.of_basis: a module with a finite basis is finite; Rⁿ is
-- finite (Module.Finite.pi).
theorem FinitelyGeneratedModule.of_basis (I v : Set)
  requires finite : Finite(I)
  requires basis : ModuleBasis(M, R, I, v)
  shows FinitelyGeneratedModule(M, R)
proof
  have ringR := CommRing.to_ring with comm
  obtain ⟨_, spans⟩ := basis
  obtain ⟨_, vF, spanEq⟩ := spans
  have imgSub := functionImage.subset at v, I, M.carrier
  have fin := Finite.function_image at I, M.carrier, v, I with vF, finite, (Subset.reflexive at I)
  unfold FinitelyGeneratedModule
  exact ⟨module, functionImage(v, I, M.carrier), imgSub, fin, spanEq⟩

theorem FinitelyGeneratedModule.coordinate (I : Set)
  requires finite : Finite(I)
  shows FinitelyGeneratedModule(coordinateModule(R, I), R)
proof
  have ringR := CommRing.to_ring with comm
  have basis := standardBasis.basis at R, I with comm, finite
  have coord := coordinateModule.module at R, I with ringR
  exact FinitelyGeneratedModule.of_basis at R, coordinateModule(R, I), I, standardBasis(R, I) with comm, coord, finite, basis

-- A finite module is a quotient of some Rⁿ (Module.Finite.exists_fin').
theorem FinitelyGeneratedModule.exists_surjection
  requires finite : FinitelyGeneratedModule(M, R)
  shows ∃ n, Nat(n) ∧ ∃ f, LinearMap(f, coordinateModule(R, n), R, M) ∧
    SurjectiveBetween(f, Module.carrier(coordinateModule(R, n)), M.carrier)
proof
  have ringR := CommRing.to_ring with comm
  obtain ⟨_, S, SM, finS, spanS⟩ := finite
  obtain ⟨n, nN, e, bij⟩ := Finite.bijective_enumeration at R, M, S with ringR, module, finS
  obtain ⟨inj, onto⟩ := bij
  obtain ⟨eS, _⟩ := onto
  have values : ∀ x ∈ n, e(x) ∈ M.carrier
    intros x hx
    exact SM with e(x), (FunctionBetween.apply_closed with eS, hx)
  have eM := FunctionBetween.codomain_of_values at e, n, S, M.carrier with eS, values
  have finN := Finite.natural at n
  have img := finHelp.image_onto at e, n, S, M.carrier with onto, SM
  have range := moduleSpan.range_family at R, M, n, e with ringR, module, finN, eM
  rw img at range
  rw spanS at range
  have lin := combinationMap.linear at R, M, n, e with comm, module, finN, eM
  have closed : ∀ c ∈ functionSpace(n, R.carrier), moduleCombination(M, R, n, c, e) ∈ M.carrier
    intros c hc
    have cF := functionSpace.mem_iff.forward with hc
    exact moduleCombination.mem_of at R, M, n, c, e with ringR, module, finN, cF, eM
  have carrierEq := coordinateModule.carrier_space at R, n
  witness n
  refine ⟨combinationMap(M, R, n, e), lin, ?_⟩
  apply Surjective.of_pointwise
  . exact LinearMap.function_of with lin
  . intros y hy
    rw range at hy
    obtain ⟨yM, c, cF, val⟩ := familyCombinations.membership.forward with hy
    have cS := functionSpace.mem_iff.backward with cF
    have app := combinationMap.graph_apply at M, R, n, e, c with closed, cS
    rw carrierEq
    refine ⟨c, cS, ?_⟩
    rw app
    symm
    exact val

-- An extension of finite modules is finite: if N and M ⧸ N are finite,
-- so is M.
theorem FinitelyGeneratedModule.of_extension (N : Set)
  requires sub : SubmoduleOf(N, M, R)
  requires finiteSub : FinitelyGeneratedModule(submoduleModule(M, R, N), R)
  requires finiteQuotient : FinitelyGeneratedModule(quotientModule(M, R, N), R)
  shows FinitelyGeneratedModule(M, R)
proof
  sorry

-- A product of two finite modules is finite (Module.Finite.prod).
theorem FinitelyGeneratedModule.product (N : Set)
  requires first : FinitelyGeneratedModule(M, R)
  requires second : FinitelyGeneratedModule(N, R)
  shows FinitelyGeneratedModule(productModule(M, R, N), R)
proof
  sorry

-- A finitely presented module is finite.
theorem FinitelyPresentedModule.finite
  requires presented : FinitelyPresentedModule(M, R)
  shows FinitelyGeneratedModule(M, R)
proof
  obtain ⟨_, n, nN, f, lin, onto, _⟩ := presented
  have fin := FinitelyGeneratedModule.coordinate at R, M, n with comm, module, (Finite.natural at n)
  have ringR := CommRing.to_ring with comm
  have coord := coordinateModule.module at R, n with ringR
  exact FinitelyGeneratedModule.of_surjective at R, coordinateModule(R, n), M, f with comm, coord, fin, lin, onto

-- Over a Noetherian ring every finite module is finitely presented
-- (Module.finitePresentation_of_finite).
theorem FinitelyPresentedModule.of_noetherian
  requires noetherian : NoetherianRing(R)
  requires finite : FinitelyGeneratedModule(M, R)
  shows FinitelyPresentedModule(M, R)
proof
  sorry

end FiniteModules

-- Section: Subalgebras and finiteness of algebras
section Algebras
variable (A : Set)
hypothesis algebra : Algebra(A)

-- Algebra.adjoin: a subalgebra containing G, the least one
-- (Algebra.subset_adjoin, Algebra.adjoin_le), monotone, and spanned as a
-- module by the products of generators (Algebra.adjoin_eq_span).
theorem adjoinOf.subalgebra (G : Set)
  requires subset : G ⊆ algebraCarrier(A)
  shows SubalgebraOf(A, adjoinOf(A, G)) ∧ G ⊆ adjoinOf(A, G)
proof
  have base := Algebra.base_comm_ring at A with algebra
  have ringA := Algebra.comm_ring at A with algebra
  have sh := Algebra.structure_hom at A with algebra
  have bp := CommRing.parts with base
  have ap := CommRing.parts with ringA
  have hp := RingHom.parts with sh
  have g := subset
  unfold algebraCarrier at g
  have s := algebraAdjoin.subalgebra at Ring.carrier(Algebra.base(A)), Ring.add(Algebra.base(A)), Ring.zero(Algebra.base(A)), Ring.neg(Algebra.base(A)), Ring.mul(Algebra.base(A)), Ring.one(Algebra.base(A)), Ring.carrier(Algebra.ring(A)), Ring.add(Algebra.ring(A)), Ring.zero(Algebra.ring(A)), Ring.neg(Algebra.ring(A)), Ring.mul(Algebra.ring(A)), Ring.one(Algebra.ring(A)), Algebra.map(A), G with bp, ap, hp, g
  have c := algebraAdjoin.contains at Ring.carrier(Algebra.base(A)), Ring.add(Algebra.base(A)), Ring.zero(Algebra.base(A)), Ring.neg(Algebra.base(A)), Ring.mul(Algebra.base(A)), Ring.one(Algebra.base(A)), Ring.carrier(Algebra.ring(A)), Ring.add(Algebra.ring(A)), Ring.zero(Algebra.ring(A)), Ring.neg(Algebra.ring(A)), Ring.mul(Algebra.ring(A)), Ring.one(Algebra.ring(A)), Algebra.map(A), G with bp, ap, hp, g
  unfold SubalgebraOf
  unfold adjoinOf
  unfold algebraCarrier
  exact ⟨⟨algebra, s⟩, c⟩

theorem adjoinOf.least (G T : Set)
  requires subset : G ⊆ algebraCarrier(A)
  requires subalgebra : SubalgebraOf(A, T)
  shows adjoinOf(A, G) ⊆ T ↔ G ⊆ T
proof
  have base := Algebra.base_comm_ring at A with algebra
  have ringA := Algebra.comm_ring at A with algebra
  have sh := Algebra.structure_hom at A with algebra
  have bp := CommRing.parts with base
  have ap := CommRing.parts with ringA
  have hp := RingHom.parts with sh
  have both := adjoinOf.subalgebra at A, G with algebra, subset
  obtain ⟨_, contains⟩ := both
  constructor
  . intro le
    exact Subset.transitive with contains, le
  . intro gt
    obtain ⟨_, sT⟩ := subalgebra
    unfold algebraCarrier at sT
    unfold adjoinOf
    unfold algebraCarrier
    exact algebraAdjoin.least at Ring.carrier(Algebra.base(A)), Ring.add(Algebra.base(A)), Ring.zero(Algebra.base(A)), Ring.neg(Algebra.base(A)), Ring.mul(Algebra.base(A)), Ring.one(Algebra.base(A)), Ring.carrier(Algebra.ring(A)), Ring.add(Algebra.ring(A)), Ring.zero(Algebra.ring(A)), Ring.neg(Algebra.ring(A)), Ring.mul(Algebra.ring(A)), Ring.one(Algebra.ring(A)), Algebra.map(A), G, T with bp, ap, hp, sT, gt

theorem adjoinOf.mono (G H : Set)
  requires subset : G ⊆ H
  requires bounded : H ⊆ algebraCarrier(A)
  shows adjoinOf(A, G) ⊆ adjoinOf(A, H)
proof
  have gb := Subset.transitive with subset, bounded
  have hs := adjoinOf.subalgebra at A, H with algebra, bounded
  obtain ⟨sub, contains⟩ := hs
  have gt := Subset.transitive with subset, contains
  have l := adjoinOf.least at A, G, adjoinOf(A, H) with algebra, gb, sub
  exact l.backward with gt

theorem adjoinOf.eq_span (G : Set)
  requires subset : G ⊆ algebraCarrier(A)
  shows adjoinOf(A, G) = moduleSpan(algebraModule(A), Algebra.base(A),
    generatedMonoid(A, G))
proof
  sorry

-- Algebra.adjoin_induction: a set containing the generators and the
-- image of R and closed under sums and products contains the adjoin.
theorem adjoinOf.induction (G P : Set)
  requires subset : G ⊆ algebraCarrier(A)
  requires generators : G ⊆ P
  requires scalars : ∀ r ∈ Ring.carrier(Algebra.base(A)), Algebra.map(A)(r) ∈ P
  requires sums : ∀ x y ∈ P ∩ algebraCarrier(A),
    call2(Ring.add(Algebra.ring(A)), x, y) ∈ P
  requires products : ∀ x y ∈ P ∩ algebraCarrier(A),
    call2(Ring.mul(Algebra.ring(A)), x, y) ∈ P
  shows adjoinOf(A, G) ⊆ P
proof
  have base := Algebra.base_comm_ring at A with algebra
  have ringA := Algebra.comm_ring at A with algebra
  have sh := Algebra.structure_hom at A with algebra
  have hp := RingHom.parts with sh
  have mapF := IsRingHom.function with hp
  have baseRing := CommRing.to_ring with base
  have ringAR := CommRing.to_ring with ringA
  have inter : ∀ x, x ∈ P → x ∈ Ring.carrier(Algebra.ring(A)) → x ∈ P ∩ algebraCarrier(A)
    intros x xP xC
    have xC2 : x ∈ algebraCarrier(A)
      unfold algebraCarrier
      exact xC
    exact intersection.membership.backward with ⟨xP, xC2⟩
  have scal : ∀ r ∈ Ring.carrier(Algebra.base(A)), Algebra.map(A)(r) ∈ P ∩ algebraCarrier(A)
    intros r hr
    have mr := FunctionBetween.apply_closed with mapF, hr
    exact inter with Algebra.map(A)(r), (scalars with r, hr), mr
  have zeroB := Ring.zero_mem at Algebra.base(A) with baseRing
  have oneB := Ring.one_mem at Algebra.base(A) with baseRing
  have z := IsRingHom.zero with hp
  have o := IsRingHom.one with hp
  have zT := scal with Ring.zero(Algebra.base(A)), zeroB
  rw z at zT
  have oT := scal with Ring.one(Algebra.base(A)), oneB
  rw o at oT
  have negOneB := Ring.neg_mem at Algebra.base(A), Ring.one(Algebra.base(A)) with oneB, baseRing
  have mT := scal with apply(Ring.neg(Algebra.base(A)), Ring.one(Algebra.base(A))), negOneB
  have mneg := IsRingHom.neg at Algebra.map(A), Ring.carrier(Algebra.base(A)), Ring.add(Algebra.base(A)), Ring.zero(Algebra.base(A)), Ring.neg(Algebra.base(A)), Ring.mul(Algebra.base(A)), Ring.one(Algebra.base(A)), Ring.carrier(Algebra.ring(A)), Ring.add(Algebra.ring(A)), Ring.zero(Algebra.ring(A)), Ring.neg(Algebra.ring(A)), Ring.mul(Algebra.ring(A)), Ring.one(Algebra.ring(A)), Ring.one(Algebra.base(A)) with hp, oneB
  rw [mneg, o] at mT
  have TS : P ∩ algebraCarrier(A) ⊆ Ring.carrier(Algebra.ring(A))
    intros x hx
    obtain ⟨_, xC⟩ := intersection.membership.forward with hx
    unfold algebraCarrier at xC
    exact xC
  have T : SubalgebraOf(A, P ∩ algebraCarrier(A))
    unfold SubalgebraOf
    refine ⟨algebra, ?_⟩
    unfold Subalgebra
    refine ⟨?_, ?_⟩
    . unfold IsSubring
      refine ⟨?_, zT, oT, ?_, ?_, ?_⟩
      . intros x hx
        obtain ⟨_, xC⟩ := intersection.membership.forward with hx
        exact xC
      . intros x hx
        have xC := TS with x, hx
        have prod := products with apply(Ring.neg(Algebra.ring(A)), Ring.one(Algebra.ring(A))), mT, x, hx
        have eq := finHelp.neg_one_mul at Algebra.ring(A), x with ringA, xC
        rw eq at prod
        have negC := Ring.neg_mem at Algebra.ring(A), x with xC, ringAR
        exact inter with apply(Ring.neg(Algebra.ring(A)), x), prod, negC
      . intros x hx y hy
        have xC := TS with x, hx
        have yC := TS with y, hy
        have s := sums with x, hx, y, hy
        have sC := Ring.add_mem at Algebra.ring(A), x, y with xC, yC, ringAR
        exact inter with call2(Ring.add(Algebra.ring(A)), x, y), s, sC
      . intros x hx y hy
        have xC := TS with x, hx
        have yC := TS with y, hy
        have s := products with x, hx, y, hy
        have sC := Ring.mul_mem at Algebra.ring(A), x, y with xC, yC, ringAR
        exact inter with call2(Ring.mul(Algebra.ring(A)), x, y), s, sC
    . intros y hy
      obtain ⟨_, r, hr, yr⟩ := functionImage.membership.forward with hy
      rw yr
      exact scal with r, hr
  have GT : G ⊆ P ∩ algebraCarrier(A)
    intros x hx
    have xC := subset with x, hx
    unfold algebraCarrier at xC
    exact inter with x, (generators with x, hx), xC
  have le := (adjoinOf.least at A, G, P ∩ algebraCarrier(A) with algebra, subset, T).backward with GT
  intros x hx
  have xI := le with x, hx
  obtain ⟨xP, _⟩ := intersection.membership.forward with xI
  exact xP

-- The adjoin of G is the image of evaluation of polynomials at G
-- (Algebra.adjoin_eq_range): x ∈ adjoin G iff x = aeval v p for p in
-- finitely many variables.
theorem adjoinOf.eq_range (n v : Set)
  requires natural : Nat(n)
  requires generators : v : n → algebraCarrier(A)
  shows adjoinOf(A, functionImage(v, n, algebraCarrier(A))) =
    functionImage(mvAeval(A, n, v), Ring.carrier(polynomialRing(Algebra.base(A), n)),
      algebraCarrier(A))
proof
  sorry

-- A finite algebra is of finite type (Algebra.FiniteType.of_finite);
-- finite type is the quotient of a polynomial algebra in finitely many
-- variables (Algebra.FiniteType.iff_quotient_mvPolynomial'').
theorem FiniteAlgebra.finite_type
  requires finite : FiniteAlgebra(A)
  shows FiniteTypeAlgebra(A)
proof
  obtain ⟨_, fg⟩ := finite
  have baseComm := Algebra.base_comm_ring at A with algebra
  have baseRing := CommRing.to_ring with baseComm
  have modA := algebraModule.module_of at A with algebra
  obtain ⟨_, S, SA, finS, spanS⟩ := fg
  have carrierEq := algebraModule.carrier_eq at A
  rw carrierEq at SA
  rw carrierEq at spanS
  have both := adjoinOf.subalgebra at A, S with algebra, SA
  obtain ⟨subAlg, contains⟩ := both
  have subMod := finHelp.subalgebra_submodule at A, adjoinOf(A, S) with algebra, subAlg
  have SM : S ⊆ Module.carrier(algebraModule(A))
    rw carrierEq
    exact SA
  have le := (moduleSpan.least at Algebra.base(A), algebraModule(A), S, adjoinOf(A, S) with baseRing, modA, SM, subMod).backward with contains
  rw spanS at le
  have ge := SubmoduleOf.subset at Algebra.base(A), algebraModule(A), adjoinOf(A, S) with baseRing, modA, subMod
  rw carrierEq at ge
  unfold FiniteTypeAlgebra
  refine ⟨algebra, S, SA, finS, ?_⟩
  exact Subset.antisymmetric with ge, le

theorem FiniteTypeAlgebra.iff_quotient
  shows FiniteTypeAlgebra(A) ↔ (∃ n, Nat(n) ∧ ∃ f,
    AlgebraHom(f, polynomialAlgebra(Algebra.base(A), n), A) ∧
    SurjectiveBetween(f, Ring.carrier(polynomialRing(Algebra.base(A), n)),
      algebraCarrier(A)))
proof
  sorry

-- Finite presentation implies finite type; over a Noetherian base the
-- converse holds (RingHom.FinitePresentation.of_finiteType,
-- Algebra.FinitePresentation.of_finiteType).
theorem FinitePresentationAlgebra.finite_type
  requires presented : FinitePresentationAlgebra(A)
  shows FiniteTypeAlgebra(A)
proof
  sorry

theorem FinitePresentationAlgebra.of_finite_type
  requires noetherian : NoetherianRing(Algebra.base(A))
  requires finiteType : FiniteTypeAlgebra(A)
  shows FinitePresentationAlgebra(A)
proof
  sorry

-- Algebra.FinitePresentation.ker_fG_of_surjective: for a finitely
-- presented A, every surjection from a polynomial algebra in finitely
-- many variables has finitely generated kernel.
theorem FinitePresentationAlgebra.kernel_fg (n f : Set)
  requires presented : FinitePresentationAlgebra(A)
  requires natural : Nat(n)
  requires hom : AlgebraHom(f, polynomialAlgebra(Algebra.base(A), n), A)
  requires surjective : SurjectiveBetween(f,
    Ring.carrier(polynomialRing(Algebra.base(A), n)), algebraCarrier(A))
  shows FinitelyGeneratedIdeal(polynomialRing(Algebra.base(A), n),
    ringKernel(f, Ring.carrier(polynomialRing(Algebra.base(A), n)),
      Ring.zero(Algebra.ring(A))))
proof
  sorry

-- Finite type passes to quotients (Algebra.FiniteType.of_surjective) and
-- polynomial algebras in finitely many variables are of finite
-- presentation (Algebra.FinitePresentation.mvPolynomial).
theorem FiniteTypeAlgebra.of_surjective (B f : Set)
  requires finiteType : FiniteTypeAlgebra(A)
  requires hom : f : A →ₐ B
  requires surjective : SurjectiveBetween(f, algebraCarrier(A), algebraCarrier(B))
  shows FiniteTypeAlgebra(B)
proof
  sorry

theorem FinitePresentationAlgebra.polynomial (n : Set)
  requires natural : Nat(n)
  shows FinitePresentationAlgebra(polynomialAlgebra(Algebra.base(A), n))
proof
  sorry

-- A finite algebra over a finite base is a finite set when the base is
-- finite (Module.finite_of_finite).
theorem FiniteAlgebra.finite_carrier
  requires finite : FiniteAlgebra(A)
  requires finiteBase : Finite(Ring.carrier(Algebra.base(A)))
  shows Finite(algebraCarrier(A))
proof
  obtain ⟨_, fg⟩ := finite
  have baseComm := Algebra.base_comm_ring at A with algebra
  have modA := algebraModule.module_of at A with algebra
  obtain ⟨n, nN, f, lin, onto⟩ := FinitelyGeneratedModule.exists_surjection at Algebra.base(A), algebraModule(A) with baseComm, modA, fg
  have carrierC := coordinateModule.carrier_space at Algebra.base(A), n
  have finSpace := functionSpace.finite at n, Ring.carrier(Algebra.base(A)) with (Finite.natural at n), finiteBase
  rw carrierC at onto
  rw (algebraModule.carrier_eq at A) at onto
  have img := Surjective.image_full at f, functionSpace(n, Ring.carrier(Algebra.base(A))), algebraCarrier(A) with onto
  obtain ⟨fF, _⟩ := onto
  have fin := Finite.function_image at functionSpace(n, Ring.carrier(Algebra.base(A))), algebraCarrier(A), f, functionSpace(n, Ring.carrier(Algebra.base(A))) with fF, finSpace, (Subset.reflexive at functionSpace(n, Ring.carrier(Algebra.base(A))))
  rw img at fin
  exact fin

end Algebras

-- Towers: finite over finite is finite (Module.Finite.trans), finite type
-- over finite type is finite type (Algebra.FiniteType.trans). The tower
-- R → A → B is written with B an A-algebra and the composite structure
-- map.
theorem FiniteAlgebra.trans (A B : Set)
  requires first : FiniteAlgebra(A)
  requires second : FiniteAlgebra(B)
  requires tower : Algebra.base(B) = Algebra.ring(A)
  shows FiniteAlgebra(Algebra.mk(Algebra.base(A), Algebra.ring(B),
    compose(Algebra.map(B), Algebra.map(A), Ring.carrier(Algebra.base(A)),
      algebraCarrier(A), algebraCarrier(B))))
proof
  sorry

theorem FiniteTypeAlgebra.trans (A B : Set)
  requires first : FiniteTypeAlgebra(A)
  requires second : FiniteTypeAlgebra(B)
  requires tower : Algebra.base(B) = Algebra.ring(A)
  shows FiniteTypeAlgebra(Algebra.mk(Algebra.base(A), Algebra.ring(B),
    compose(Algebra.map(B), Algebra.map(A), Ring.carrier(Algebra.base(A)),
      algebraCarrier(A), algebraCarrier(B))))
proof
  sorry

-- Section: Noetherian modules
section NoetherianModules
variable (R M : Set)
hypothesis comm : CommRing(R)
hypothesis module : Module(M, R)

-- The chain conditions: f.g. ⇒ ACC and maximal condition ⇒ f.g. are ZF;
-- ACC ⇒ f.g. and f.g. ⇒ maximal condition (IsNoetherian.wellFoundedGT,
-- isNoetherian_iff_fg_wellFounded, set_has_maximal_iff_noetherian) build
-- a strictly increasing sequence by dependent choice: Choice.
theorem NoetherianModule.ascending
  requires noetherian : NoetherianModule(M, R)
  shows AscendingChainCondition(M, R)
proof
  have ringR := CommRing.to_ring with comm
  intros N subs incr
  have zeroIn : 0 ∈ ℕ by typecheck
  have N0in : N(0) ∈ finSeqRange(N)
    apply finSeqRange.membership.backward
    exact ⟨0, zeroIn, rfl⟩
  have nested : ∀ C ∈ finSeqRange(N), ∀ D ∈ finSeqRange(N), C ⊆ D ∨ D ⊆ C
    intros C hC D hD
    obtain ⟨i, hi, Ci⟩ := finSeqRange.membership.forward with hC
    obtain ⟨j, hj, Dj⟩ := finSeqRange.membership.forward with hD
    have iNat : Nat(i) := hi
    have jNat : Nat(j) := hj
    rw [← Ci, ← Dj]
    by_cases ij : i ≤ j
    . left
      have mono := finHelp.increasing_mono_at at N, j with incr
      exact mono with i, hi, ij
    . right
      have ji : j ≤ i by arith
      have mono := finHelp.increasing_mono_at at N, i with incr
      exact mono with j, hj, ji
  have subsS : ∀ C ∈ finSeqRange(N), SubmoduleOf(C, M, R)
    intros C hC
    obtain ⟨i, hi, Ci⟩ := finSeqRange.membership.forward with hC
    rw ← Ci
    exact subs with i, hi
  have U := finHelp.chain_union_submodule at R, M, finSeqRange(N), N(0) with ringR, module, N0in, nested, subsS
  obtain ⟨_, all⟩ := noetherian
  obtain ⟨_, T, TU, finT, spanT⟩ := all with ⋃(finSeqRange(N)), U
  obtain ⟨C, hC, TC⟩ := finHelp.chain_finite_cover at finSeqRange(N), T, N(0) with N0in, nested, TU, finT
  obtain ⟨k, hk, Ck⟩ := finSeqRange.membership.forward with hC
  have subC := subsS with C, hC
  have sU := SubmoduleOf.subset at R, M, ⋃(finSeqRange(N)) with ringR, module, U
  have TM := Subset.transitive with TU, sU
  have le := (moduleSpan.least at R, M, T, C with ringR, module, TM, subC).backward with TC
  rw spanT at le
  rw ← Ck at le
  refine ⟨k, hk, ?_⟩
  intros n hn kn
  have nNat : Nat(n) := hn
  have mono := finHelp.increasing_mono_at at N, n with incr
  have up := mono with k, hk, kn
  have down : N(n) ⊆ N(k)
    intros x hx
    have nIn : N(n) ∈ finSeqRange(N)
      apply finSeqRange.membership.backward
      exact ⟨n, hn, rfl⟩
    have xU : x ∈ ⋃(finSeqRange(N))
      apply union.membership.backward
      exact ⟨N(n), nIn, hx⟩
    exact le with x, xU
  exact Subset.antisymmetric with down, up

theorem NoetherianModule.of_maximal
  requires maximal : MaximalCondition(M, R)
  shows NoetherianModule(M, R)
proof
  have ringR := CommRing.to_ring with comm
  unfold NoetherianModule
  refine ⟨module, ?_⟩
  intros N sub
  have sN := SubmoduleOf.subset at R, M, N with ringR, module, sub
  have spanMem : ∀ T, T ⊆ N → Finite(T) → moduleSpan(M, R, T) ∈ finSpanFamily(M, R, N)
    intros T TN finT
    have TM := Subset.transitive with TN, sN
    have sp := moduleSpan.submodule at R, M, T with ringR, module
    have spM := SubmoduleOf.subset at R, M, moduleSpan(M, R, T) with ringR, module, sp
    apply finSpanFamily.membership.backward
    exact ⟨(powerset.membership_iff.backward with spM), T, TN, finT, rfl⟩
  have emptyIn := spanMem with ∅, (empty.subset at N), Finite.empty
  have nonE : Nonempty(finSpanFamily(M, R, N))
    exact ⟨moduleSpan(M, R, ∅), emptyIn⟩
  have ne := Nonempty.ne_empty with nonE
  have subsF : ∀ P ∈ finSpanFamily(M, R, N), SubmoduleOf(P, M, R)
    intros P hP
    obtain ⟨_, T, TN, finT, PT⟩ := finSpanFamily.membership.forward with hP
    rw PT
    exact moduleSpan.submodule at R, M, T with ringR, module
  obtain ⟨P0, hP0, maxP⟩ := maximal with finSpanFamily(M, R, N), ne, subsF
  obtain ⟨_, T0, T0N, finT0, P0T⟩ := finSpanFamily.membership.forward with hP0
  have T0M := Subset.transitive with T0N, sN
  have le := (moduleSpan.least at R, M, T0, N with ringR, module, T0M, sub).backward with T0N
  have ge : N ⊆ moduleSpan(M, R, T0)
    intros x hx
    have xs := (singleton.subset_iff at x, N).backward with hx
    have xT := finHelp.union_subset at T0, {x}, N with T0N, xs
    have finX := Finite.union with finT0, (Finite.singleton at x)
    have mem := spanMem with T0 ∪ {x}, xT, finX
    have mono := moduleSpan.mono at R, M, T0, T0 ∪ {x} with ringR, module, (union2.subset_left at T0, {x})
    rw ← P0T at mono
    have eq := maxP with moduleSpan(M, R, T0 ∪ {x}), mem, mono
    have T0xM := Subset.transitive with xT, sN
    have xIn := moduleSpan.subset_span at R, M, T0 ∪ {x} with ringR, module, T0xM
    have xx := xIn with x, (union2.right at x, T0, {x} with (singleton.self at x))
    rw eq at xx
    rw P0T at xx
    exact xx
  unfold SubmoduleFG
  refine ⟨sub, T0, T0N, finT0, ?_⟩
  exact Subset.antisymmetric with le, ge

theorem NoetherianModule.of_ascending
  requires ascending : AscendingChainCondition(M, R)
  shows NoetherianModule(M, R)
proof
  sorry

theorem NoetherianModule.maximal
  requires noetherian : NoetherianModule(M, R)
  shows MaximalCondition(M, R)
proof
  have ringR := CommRing.to_ring with comm
  intros F nonempty subs
  obtain ⟨N0, hN0⟩ := Nonempty.of_ne_empty with nonempty
  have closed : ∀ S, Nonempty(S) → S ⊆ F → (∀ C ∈ S, ∀ D ∈ S, C ⊆ D ∨ D ⊆ C) → ⋃(S) ∈ F
    intros S neS SF nestedS
    obtain ⟨C0, hC0⟩ := neS
    have subsS : ∀ C ∈ S, SubmoduleOf(C, M, R)
      intros C hC
      exact subs with C, (SF with C, hC)
    have U := finHelp.chain_union_submodule at R, M, S, C0 with ringR, module, hC0, nestedS, subsS
    obtain ⟨_, all⟩ := noetherian
    obtain ⟨_, T, TU, finT, spanT⟩ := all with ⋃(S), U
    obtain ⟨C, hC, TC⟩ := finHelp.chain_finite_cover at S, T, C0 with hC0, nestedS, TU, finT
    have subC := subsS with C, hC
    have sU := SubmoduleOf.subset at R, M, ⋃(S) with ringR, module, U
    have TM := Subset.transitive with TU, sU
    have le := (moduleSpan.least at R, M, T, C with ringR, module, TM, subC).backward with TC
    rw spanT at le
    have ge : C ⊆ ⋃(S)
      intros x hx
      apply union.membership.backward
      exact ⟨C, hC, hx⟩
    have eq := Subset.antisymmetric with le, ge
    rw eq
    exact SF with C, hC
  obtain ⟨Mx, hMx, _, maxl⟩ := maximal_extension at F, N0 with hN0, closed
  exact ⟨Mx, hMx, maxl⟩

-- IsNoetherian.induction: a property of submodules inherited from all
-- strictly larger submodules holds for all. It rests on the maximal
-- condition: Choice.
theorem NoetherianModule.induction (P : Set)
  requires noetherian : NoetherianModule(M, R)
  requires step : ∀ N, SubmoduleOf(N, M, R) →
    (∀ Q, SubmoduleOf(Q, M, R) → N ⊆ Q → N ≠ Q → Q ∈ P) → N ∈ P
  shows ∀ N, SubmoduleOf(N, M, R) → N ∈ P
proof
  have ringR := CommRing.to_ring with comm
  have maxC := NoetherianModule.maximal at R, M with comm, module, noetherian
  intros N sub
  by_contra notIn
  have sN := SubmoduleOf.subset at R, M, N with ringR, module, sub
  have Nin : N ∈ finBadFamily(M, R, P)
    apply finBadFamily.membership.backward
    exact ⟨(powerset.membership_iff.backward with sN), sub, notIn⟩
  have nonE : Nonempty(finBadFamily(M, R, P))
    exact ⟨N, Nin⟩
  have ne := Nonempty.ne_empty with nonE
  have subsF : ∀ Q ∈ finBadFamily(M, R, P), SubmoduleOf(Q, M, R)
    intros Q hQ
    obtain ⟨_, subQ, _⟩ := finBadFamily.membership.forward with hQ
    exact subQ
  obtain ⟨Q0, hQ0, maxQ⟩ := maxC with finBadFamily(M, R, P), ne, subsF
  obtain ⟨_, subQ0, notQ0⟩ := finBadFamily.membership.forward with hQ0
  have larger : ∀ Q, SubmoduleOf(Q, M, R) → Q0 ⊆ Q → Q0 ≠ Q → Q ∈ P
    intros Q subQ le neq
    by_contra QnotP
    have sQ := SubmoduleOf.subset at R, M, Q with ringR, module, subQ
    have QF : Q ∈ finBadFamily(M, R, P)
      apply finBadFamily.membership.backward
      exact ⟨(powerset.membership_iff.backward with sQ), subQ, QnotP⟩
    have eq := maxQ with Q, QF, le
    symm at eq
    exact neq with eq
  have inP := step with Q0, subQ0, larger
  exact notQ0 with inP

-- Submodules and quotients of Noetherian modules are Noetherian
-- (isNoetherian_submodule', isNoetherian_of_quotient), and M is
-- Noetherian when a submodule and the quotient are
-- (isNoetherian_of_range_eq_ker).
theorem NoetherianModule.submodule (N : Set)
  requires noetherian : NoetherianModule(M, R)
  requires sub : SubmoduleOf(N, M, R)
  shows NoetherianModule(submoduleModule(M, R, N), R)
proof
  have ringR := CommRing.to_ring with comm
  have subMod := SubmoduleOf.submodule_module at R, M, N with ringR, module, sub
  unfold NoetherianModule
  refine ⟨subMod, ?_⟩
  intros Q subQ
  obtain ⟨QM, QN⟩ := finHelp.sub_of_sub at R, M, N, Q with ringR, module, sub, subQ
  obtain ⟨_, all⟩ := noetherian
  obtain ⟨_, T, TQ, finT, spanT⟩ := all with Q, QM
  have TN := Subset.transitive with TQ, QN
  have inside := finHelp.span_inside at R, M, N, T with ringR, module, sub, TN
  unfold SubmoduleFG
  refine ⟨subQ, T, TQ, finT, ?_⟩
  rw inside
  exact spanT

theorem NoetherianModule.quotient (N : Set)
  requires noetherian : NoetherianModule(M, R)
  requires sub : SubmoduleOf(N, M, R)
  shows NoetherianModule(quotientModule(M, R, N), R)
proof
  have ringR := CommRing.to_ring with comm
  have lin := SubmoduleOf.quotient_map_linear at R, M, N with ringR, module, sub
  have onto := SubmoduleOf.quotient_map_surjective at R, M, N with ringR, module, sub
  have qMod := LinearMap.target_module with lin
  unfold NoetherianModule
  refine ⟨qMod, ?_⟩
  intros Q subQ
  have pre := LinearMap.preimage_submodule at R, M, quotientModule(M, R, N), quotientModuleMap(M, N), Q with ringR, module, qMod, lin, subQ
  obtain ⟨_, all⟩ := noetherian
  have fg := all with submodulePreimage(quotientModuleMap(M, N), M, Q), pre
  have img := SubmoduleFG.image at R, M, submodulePreimage(quotientModuleMap(M, N), M, Q), quotientModuleMap(M, N), quotientModule(M, R, N) with comm, module, fg, lin
  have QS := SubmoduleOf.subset at R, quotientModule(M, R, N), Q with ringR, qMod, subQ
  have eq := finHelp.image_preimage at quotientModuleMap(M, N), M, quotientModule(M, R, N), Q with onto, QS
  rw eq at img
  exact img

theorem NoetherianModule.of_exact (P Q f g : Set)
  requires first : NoetherianModule(P, R)
  requires third : NoetherianModule(Q, R)
  requires mapF : LinearMap(f, P, R, M)
  requires mapG : LinearMap(g, M, R, Q)
  requires exact : ExactPair(f, g, P, M, Q)
  shows NoetherianModule(M, R)
proof
  have ringR := CommRing.to_ring with comm
  have exactness := exact
  unfold ExactPair at exactness
  have modP := LinearMap.source_module with mapF
  have modQ := LinearMap.target_module with mapG
  have fF := LinearMap.function_of with mapF
  have gF := LinearMap.function_of with mapG
  unfold NoetherianModule
  refine ⟨module, ?_⟩
  intros K subK
  have KM := SubmoduleOf.subset at R, M, K with ringR, module, subK
  have gKsub := LinearMap.image_submodule at R, M, Q, g, K with ringR, module, modQ, mapG, subK
  obtain ⟨_, allQ⟩ := third
  obtain ⟨_, B, BgK, finB, spanB⟩ := allQ with submoduleImage(g, M, Q, K), gKsub
  have fKsub := LinearMap.preimage_submodule at R, P, M, f, K with ringR, modP, module, mapF, subK
  obtain ⟨_, allP⟩ := first
  obtain ⟨_, Aset, AfK, finA, spanA⟩ := allP with submodulePreimage(f, P, K), fKsub
  have lifts : ∀ b ∈ B, ∃ x ∈ K, g(x) = b
    intros b hb
    obtain ⟨_, x, xK, gx⟩ := submoduleImage.membership.forward with (BgK with b, hb)
    exact ⟨x, xK, gx⟩
  obtain ⟨L, LK, finL, cover⟩ := finHelp.finite_lift at g, K, B with finB, lifts
  have LM := Subset.transitive with LK, KM
  have APc : Aset ⊆ P.carrier
    intros a ha
    obtain ⟨aP, _⟩ := submodulePreimage.membership.forward with (AfK with a, ha)
    exact aP
  have fAK : functionImage(f, Aset, M.carrier) ⊆ K
    intros y hy
    obtain ⟨_, a, ha, ya⟩ := functionImage.membership.forward with hy
    obtain ⟨_, fa⟩ := submodulePreimage.membership.forward with (AfK with a, ha)
    rw ya
    exact fa
  have fAM := functionImage.subset at f, Aset, M.carrier
  have GK := finHelp.union_subset at functionImage(f, Aset, M.carrier), L, K with fAK, LK
  have GM := finHelp.union_subset at functionImage(f, Aset, M.carrier), L, M.carrier with fAM, LM
  have finFA := Finite.function_image at P.carrier, M.carrier, f, Aset with fF, finA, APc
  have finG := Finite.union with finFA, finL
  have spanGsub := moduleSpan.submodule at R, M, functionImage(f, Aset, M.carrier) ∪ L with ringR, module
  have le := (moduleSpan.least at R, M, functionImage(f, Aset, M.carrier) ∪ L, K with ringR, module, GM, subK).backward with GK
  have spanL_G := moduleSpan.mono at R, M, L, functionImage(f, Aset, M.carrier) ∪ L with ringR, module, (union2.subset_right at functionImage(f, Aset, M.carrier), L)
  have spanA_G := moduleSpan.mono at R, M, functionImage(f, Aset, M.carrier), functionImage(f, Aset, M.carrier) ∪ L with ringR, module, (union2.subset_left at functionImage(f, Aset, M.carrier), L)
  have imgL := LinearMap.image_span at R, M, Q, g, L with ringR, module, modQ, mapG, LM
  have imgA := LinearMap.image_span at R, P, M, f, Aset with ringR, modP, module, mapF, APc
  have BgL : B ⊆ functionImage(g, L, Q.carrier)
    intros b hb
    obtain ⟨x, xL, gx⟩ := cover with b, hb
    obtain ⟨bQ, _⟩ := submoduleImage.membership.forward with (BgK with b, hb)
    apply functionImage.membership.backward
    refine ⟨bQ, x, xL, ?_⟩
    symm
    exact gx
  have spanBsub := moduleSpan.mono at R, Q, B, functionImage(g, L, Q.carrier) with ringR, modQ, BgL
  rw spanB at spanBsub
  rw ← imgL at spanBsub
  have spanLK := (moduleSpan.least at R, M, L, K with ringR, module, LM, subK).backward with LK
  have ge : K ⊆ moduleSpan(M, R, functionImage(f, Aset, M.carrier) ∪ L)
    intros k hk
    have kM := KM with k, hk
    have gkQ := FunctionBetween.apply_closed with gF, kM
    have gk : g(k) ∈ submoduleImage(g, M, Q, K)
      apply submoduleImage.membership.backward
      exact ⟨gkQ, k, hk, rfl⟩
    have gk2 := spanBsub with g(k), gk
    obtain ⟨_, y, yL, gy⟩ := submoduleImage.membership.forward with gk2
    have yK := spanLK with y, yL
    have yM := KM with y, yK
    have negY := Module.neg_mem at R, M, y with yM, ringR, module
    have negYK := SubmoduleOf.neg_mem at R, M, K, y with ringR, module, subK, yK
    have dK := SubmoduleOf.add_mem at R, M, K, k, M.neg(y) with ringR, module, subK, hk, negYK
    have dM := KM with M.add(k, M.neg(y)), dK
    have gd : g(M.add(k, M.neg(y))) = Q.zero
      have a1 := LinearMap.map_add at R, M, Q, g, k, M.neg(y) with kM, negY, ringR, module, modQ, mapG
      have a2 := LinearMap.map_neg at R, M, Q, g, y with yM, ringR, module, modQ, mapG
      rw [a1, a2, gy]
      exact Module.add_neg at R, Q, g(k) with gkQ, ringR, modQ
    have dKer : M.add(k, M.neg(y)) ∈ linearKernel(g, M, Q)
      apply linearKernel.membership.backward
      exact ⟨dM, gd⟩
    rw ← exactness at dKer
    obtain ⟨_, p, pP, fp⟩ := linearRange.membership.forward with dKer
    have pfK : p ∈ submodulePreimage(f, P, K)
      apply submodulePreimage.membership.backward
      rw fp
      exact ⟨pP, dK⟩
    rw ← spanA at pfK
    have fpIn : f(p) ∈ submoduleImage(f, P, M, moduleSpan(P, R, Aset))
      apply submoduleImage.membership.backward
      exact ⟨(FunctionBetween.apply_closed with fF, pP), p, pfK, rfl⟩
    rw imgA at fpIn
    have dG := spanA_G with f(p), fpIn
    rw fp at dG
    have yG := spanL_G with y, yL
    exact (SubmoduleOf.sub_mem_iff_left at R, M, moduleSpan(M, R, functionImage(f, Aset, M.carrier) ∪ L), k, y with ringR, module, spanGsub, kM, yG).forward with dG
  unfold SubmoduleFG
  refine ⟨subK, functionImage(f, Aset, M.carrier) ∪ L, GK, finG, ?_⟩
  exact Subset.antisymmetric with le, ge

-- A Noetherian module is finite.
theorem NoetherianModule.finite
  requires noetherian : NoetherianModule(M, R)
  shows FinitelyGeneratedModule(M, R)
proof
  have ringR := CommRing.to_ring with comm
  have whole := SubmoduleOf.whole at R, M with ringR, module
  obtain ⟨_, all⟩ := noetherian
  have fg := all with M.carrier, whole
  exact (FinitelyGeneratedModule.iff_fg at R, M with comm, module).backward with fg

-- isNoetherian_of_fg_of_noetherian: a finite module over a Noetherian ring
-- is Noetherian.
theorem NoetherianModule.of_finite
  requires noetherian : NoetherianRing(R)
  requires finite : FinitelyGeneratedModule(M, R)
  shows NoetherianModule(M, R)
proof
  sorry

-- Artinian modules: submodules and quotients, and the minimal condition
-- gives the descending chain condition (ZF); the converse uses dependent
-- choice: Choice.
theorem ArtinianModule.descending
  requires artinian : ArtinianModule(M, R)
  shows DescendingChainCondition(M, R)
proof
  have ringR := CommRing.to_ring with comm
  obtain ⟨_, minC⟩ := artinian
  intros N subs decr
  have zeroIn : 0 ∈ ℕ by typecheck
  have N0in : N(0) ∈ finSeqRange(N)
    apply finSeqRange.membership.backward
    exact ⟨0, zeroIn, rfl⟩
  have nonE : Nonempty(finSeqRange(N))
    exact ⟨N(0), N0in⟩
  have ne := Nonempty.ne_empty with nonE
  have subsS : ∀ C ∈ finSeqRange(N), SubmoduleOf(C, M, R)
    intros C hC
    obtain ⟨i, hi, Ci⟩ := finSeqRange.membership.forward with hC
    rw ← Ci
    exact subs with i, hi
  obtain ⟨C, hC, minimal⟩ := minC with finSeqRange(N), ne, subsS
  obtain ⟨k, hk, Ck⟩ := finSeqRange.membership.forward with hC
  rw ← Ck at minimal
  refine ⟨k, hk, ?_⟩
  intros n hn kn
  have nNat : Nat(n) := hn
  have anti := finHelp.decreasing_anti_at at N, n with decr
  have down := anti with k, hk, kn
  have nIn : N(n) ∈ finSeqRange(N)
    apply finSeqRange.membership.backward
    exact ⟨n, hn, rfl⟩
  exact minimal with N(n), nIn, down

theorem ArtinianModule.of_descending
  requires descending : DescendingChainCondition(M, R)
  shows ArtinianModule(M, R)
proof
  sorry

theorem ArtinianModule.submodule (N : Set)
  requires artinian : ArtinianModule(M, R)
  requires sub : SubmoduleOf(N, M, R)
  shows ArtinianModule(submoduleModule(M, R, N), R)
proof
  have ringR := CommRing.to_ring with comm
  have subMod := SubmoduleOf.submodule_module at R, M, N with ringR, module, sub
  obtain ⟨_, minC⟩ := artinian
  unfold ArtinianModule
  refine ⟨subMod, ?_⟩
  intros F ne subsF
  have subsM : ∀ Q ∈ F, SubmoduleOf(Q, M, R)
    intros Q hQ
    obtain ⟨QM, _⟩ := finHelp.sub_of_sub at R, M, N, Q with ringR, module, sub, (subsF with Q, hQ)
    exact QM
  exact minC with F, ne, subsM

theorem ArtinianModule.quotient (N : Set)
  requires artinian : ArtinianModule(M, R)
  requires sub : SubmoduleOf(N, M, R)
  shows ArtinianModule(quotientModule(M, R, N), R)
proof
  have ringR := CommRing.to_ring with comm
  have lin := SubmoduleOf.quotient_map_linear at R, M, N with ringR, module, sub
  have onto := SubmoduleOf.quotient_map_surjective at R, M, N with ringR, module, sub
  have qMod := LinearMap.target_module with lin
  obtain ⟨_, minC⟩ := artinian
  unfold ArtinianModule
  refine ⟨qMod, ?_⟩
  intros F ne subsF
  obtain ⟨Q1, hQ1⟩ := Nonempty.of_ne_empty with ne
  have Pin : submodulePreimage(quotientModuleMap(M, N), M, Q1) ∈ finPreimages(quotientModuleMap(M, N), M, F)
    apply finPreimages.membership.backward
    exact ⟨Q1, hQ1, rfl⟩
  have nonE : Nonempty(finPreimages(quotientModuleMap(M, N), M, F))
    exact ⟨submodulePreimage(quotientModuleMap(M, N), M, Q1), Pin⟩
  have neP := Nonempty.ne_empty with nonE
  have subsP : ∀ C ∈ finPreimages(quotientModuleMap(M, N), M, F), SubmoduleOf(C, M, R)
    intros C hC
    obtain ⟨Q, hQ, CQ⟩ := finPreimages.membership.forward with hC
    rw ← CQ
    exact LinearMap.preimage_submodule at R, M, quotientModule(M, R, N), quotientModuleMap(M, N), Q with ringR, module, qMod, lin, (subsF with Q, hQ)
  obtain ⟨C, hC, minimal⟩ := minC with finPreimages(quotientModuleMap(M, N), M, F), neP, subsP
  obtain ⟨Q0, hQ0, CQ0⟩ := finPreimages.membership.forward with hC
  rw ← CQ0 at minimal
  refine ⟨Q0, hQ0, ?_⟩
  intros P hP PQ
  have PS := SubmoduleOf.subset at R, quotientModule(M, R, N), P with ringR, qMod, (subsF with P, hP)
  have Q0S := SubmoduleOf.subset at R, quotientModule(M, R, N), Q0 with ringR, qMod, (subsF with Q0, hQ0)
  have Pin2 : submodulePreimage(quotientModuleMap(M, N), M, P) ∈ finPreimages(quotientModuleMap(M, N), M, F)
    apply finPreimages.membership.backward
    exact ⟨P, hP, rfl⟩
  have preLe : submodulePreimage(quotientModuleMap(M, N), M, P) ⊆ submodulePreimage(quotientModuleMap(M, N), M, Q0)
    intros v hv
    obtain ⟨vM, fv⟩ := submodulePreimage.membership.forward with hv
    apply submodulePreimage.membership.backward
    exact ⟨vM, (PQ with quotientModuleMap(M, N)(v), fv)⟩
  have same := minimal with submodulePreimage(quotientModuleMap(M, N), M, P), Pin2, preLe
  have eP := finHelp.image_preimage at quotientModuleMap(M, N), M, quotientModule(M, R, N), P with onto, PS
  have eQ := finHelp.image_preimage at quotientModuleMap(M, N), M, quotientModule(M, R, N), Q0 with onto, Q0S
  rw same at eP
  rw eQ at eP
  symm
  exact eP

-- Finite length is Noetherian and Artinian together
-- (isFiniteLength_iff_isNoetherian_isArtinian).
theorem FiniteLength.iff_noetherian_artinian
  shows FiniteLength(M, R) ↔ NoetherianModule(M, R) ∧ ArtinianModule(M, R)
proof
  sorry

-- Length: 0 exactly for the zero module, 1 exactly for simple modules
-- (Module.length_eq_zero_iff, IsSimpleModule), additive on short exact
-- sequences (Module.length_eq_add_of_exact), monotone under
-- surjections and for submodules (Module.length_le_of_surjective),
-- invariant under isomorphism (LinearEquiv.length_eq).
theorem moduleLength.zero_iff
  requires finiteLength : FiniteLength(M, R)
  shows moduleLength(M, R) = 0 ↔ M.carrier = {M.zero}
proof
  sorry

theorem moduleLength.one_iff
  requires finiteLength : FiniteLength(M, R)
  shows moduleLength(M, R) = 1 ↔ SimpleModule(M, R)
proof
  sorry

theorem moduleLength.exact (P Q f g : Set)
  requires mapF : LinearMap(f, P, R, M)
  requires mapG : LinearMap(g, M, R, Q)
  requires injective : InjectiveBetween(f, Module.carrier(P), M.carrier)
  requires surjective : SurjectiveBetween(g, M.carrier, Module.carrier(Q))
  requires exact : ExactPair(f, g, P, M, Q)
  requires finiteP : FiniteLength(P, R)
  requires finiteQ : FiniteLength(Q, R)
  shows FiniteLength(M, R) ∧
    moduleLength(M, R) = moduleLength(P, R) + moduleLength(Q, R)
proof
  sorry

theorem moduleLength.surjective_le (N f : Set)
  requires finiteLength : FiniteLength(M, R)
  requires linear : LinearMap(f, M, R, N)
  requires surjective : SurjectiveBetween(f, M.carrier, Module.carrier(N))
  shows FiniteLength(N, R) ∧ moduleLength(N, R) ≤ moduleLength(M, R)
proof
  sorry

theorem moduleLength.submodule_le (N : Set)
  requires finiteLength : FiniteLength(M, R)
  requires sub : SubmoduleOf(N, M, R)
  shows FiniteLength(submoduleModule(M, R, N), R) ∧
    moduleLength(submoduleModule(M, R, N), R) ≤ moduleLength(M, R) ∧
    moduleLength(M, R) = moduleLength(submoduleModule(M, R, N), R) +
      moduleLength(quotientModule(M, R, N), R)
proof
  sorry

theorem moduleLength.equiv (N f : Set)
  requires finiteLength : FiniteLength(M, R)
  requires equiv : LinearEquiv(f, M, R, N)
  shows FiniteLength(N, R) ∧ moduleLength(N, R) = moduleLength(M, R)
proof
  sorry

-- A proper submodule of a module of finite length has smaller length
-- (Module.length_lt_of_lt).
theorem moduleLength.submodule_lt (N : Set)
  requires finiteLength : FiniteLength(M, R)
  requires sub : SubmoduleOf(N, M, R)
  requires proper : N ≠ M.carrier
  shows moduleLength(submoduleModule(M, R, N), R) < moduleLength(M, R)
proof
  sorry

-- Over a field, length is dimension (Module.length_eq_finrank... in the
-- form finrank = length for finite-dimensional spaces).
theorem moduleLength.field
  requires field : Field(R)
  requires finiteDimensional : FiniteDimensional(M, R)
  shows FiniteLength(M, R) ∧ moduleLength(M, R) = finrank(M, R)
proof
  sorry

-- Module.length_pi_of_fintype in the case of a product of two.
theorem moduleLength.product (N : Set)
  requires first : FiniteLength(M, R)
  requires second : FiniteLength(N, R)
  shows FiniteLength(productModule(M, R, N), R) ∧
    moduleLength(productModule(M, R, N), R) = moduleLength(M, R) + moduleLength(N, R)
proof
  sorry

end NoetherianModules

-- Section: Noetherian and Artinian rings
section NoetherianRings
variable (R : Set)
hypothesis comm : CommRing(R)

-- A ring is Noetherian iff it is Noetherian as a module over itself.
theorem NoetherianRing.iff_module
  shows NoetherianRing(R) ↔ NoetherianModule(selfModule(R), R)
proof
  have ringR := CommRing.to_ring with comm
  have selfMod := Ring.to_module at R with ringR
  constructor
  . intro h
    obtain ⟨_, all⟩ := h
    unfold NoetherianModule
    refine ⟨selfMod, ?_⟩
    intros N sub
    have ideal := (Ideal.iff_submodule at R, N with comm).backward with sub
    obtain ⟨_, G, GR, finG, NG⟩ := all with N, ideal
    have span := generatedIdeal.module_span at R, G with comm, GR
    have GN := generatedIdeal.contains at R, G with comm, GR
    rw ← NG at GN
    unfold SubmoduleFG
    refine ⟨sub, G, GN, finG, ?_⟩
    rw NG
    symm
    exact span
  . intro h
    obtain ⟨_, all⟩ := h
    unfold NoetherianRing
    refine ⟨comm, ?_⟩
    intros I ideal
    have sub := (Ideal.iff_submodule at R, I with comm).forward with ideal
    obtain ⟨_, T, TI, finT, spanT⟩ := all with I, sub
    have IS := Ideal.subset at R, I with ideal
    have TR := Subset.transitive with TI, IS
    have span := generatedIdeal.module_span at R, T with comm, TR
    unfold FinitelyGeneratedIdeal
    refine ⟨ideal, T, TR, finT, ?_⟩
    rw span
    symm
    exact spanT

-- Fields and PIDs are Noetherian.
theorem NoetherianRing.of_field
  requires field : Field(R)
  shows NoetherianRing(R)
proof
  have ringR := CommRing.to_ring with comm
  unfold NoetherianRing
  refine ⟨comm, ?_⟩
  intros I ideal
  have IS := Ideal.subset at R, I with ideal
  cases (Field.ideals at R, I with field, ideal) with zero | whole
  . have eq := generatedIdeal.eq_of_ideal at R, I with comm, ideal
    have fin : Finite(I)
      rw zero
      exact Finite.singleton at R.zero
    unfold FinitelyGeneratedIdeal
    refine ⟨ideal, I, IS, fin, ?_⟩
    symm
    exact eq
  . have oneR := Ring.one_mem at R with ringR
    have sing := (singleton.subset_iff at R.one, R.carrier).backward with oneR
    have genIdeal := generatedIdeal.ideal at R, {R.one} with comm
    have contains := generatedIdeal.contains at R, {R.one} with comm, sing
    have oneIn := contains with R.one, (singleton.self at R.one)
    have unit := RingUnit.one at R with comm
    have eq := Ideal.eq_whole_of_unit_mem at R, generatedIdeal(R, {R.one}), R.one with comm, genIdeal, oneIn, unit
    unfold FinitelyGeneratedIdeal
    refine ⟨ideal, {R.one}, sing, (Finite.singleton at R.one), ?_⟩
    rw [eq, whole]

theorem NoetherianRing.of_pid
  requires pid : PrincipalIdealDomain(R)
  shows NoetherianRing(R)
proof
  obtain ⟨_, all⟩ := pid
  unfold NoetherianRing
  refine ⟨comm, ?_⟩
  intros I ideal
  obtain ⟨_, a, aR, Ia⟩ := all with I, ideal
  have gen := ringMultiples.generated at R, a with aR, comm
  have sing := (singleton.subset_iff at a, R.carrier).backward with aR
  unfold FinitelyGeneratedIdeal
  refine ⟨ideal, {a}, sing, (Finite.singleton at a), ?_⟩
  rw gen
  exact Ia

-- A finite ring is Noetherian and Artinian (IsNoetherianRing.of_finite,
-- IsArtinianRing.of_finite).
theorem NoetherianRing.of_finite
  requires finite : Finite(R.carrier)
  shows NoetherianRing(R) ∧ ArtinianRing(R)
proof
  have ringR := CommRing.to_ring with comm
  have selfMod := Ring.to_module at R with ringR
  have noeth : NoetherianRing(R)
    unfold NoetherianRing
    refine ⟨comm, ?_⟩
    intros I ideal
    have IS := Ideal.subset at R, I with ideal
    have fin := Finite.subset at I, R.carrier with finite, IS
    have eq := generatedIdeal.eq_of_ideal at R, I with comm, ideal
    unfold FinitelyGeneratedIdeal
    refine ⟨ideal, I, IS, fin, ?_⟩
    symm
    exact eq
  refine ⟨noeth, ?_⟩
  unfold ArtinianRing
  refine ⟨comm, ?_⟩
  unfold ArtinianModule
  refine ⟨selfMod, ?_⟩
  intros F ne subsF
  have FP : F ⊆ 𝒫(R.carrier)
    intros N hN
    have NS := SubmoduleOf.subset at R, selfModule(R), N with ringR, selfMod, (subsF with N, hN)
    rw (selfModule.carrier_eq at R) at NS
    exact powerset.membership_iff.backward with NS
  have finP := Finite.powerset at R.carrier with finite
  have finF := Finite.subset at F, 𝒫(R.carrier) with finP, FP
  cases (finHelp.finite_minimal at F with finF) with emptyF | found
  . exfalso
    exact ne with emptyF
  . exact found

theorem NoetherianRing.of_surjective (S f : Set)
  requires noetherian : NoetherianRing(R)
  requires target : CommRing(S)
  requires hom : f : R →+* S
  requires surjective : SurjectiveBetween(f, R.carrier, S.carrier)
  shows NoetherianRing(S)
proof
  obtain ⟨_, all⟩ := noetherian
  have hom0 := hom
  obtain ⟨_, _, fn, _⟩ := hom0
  unfold NoetherianRing
  refine ⟨target, ?_⟩
  intros J ideal
  have cIdeal := idealComap.ideal_of_hom at f, R, S, J with comm, target, hom, ideal
  obtain ⟨_, G, GR, finG, CG⟩ := all with idealComap(f, R.carrier, J), cIdeal
  have back := idealExtension.contraction_of_surjective at f, R, S, J with comm, target, hom, surjective, ideal
  have gen := idealExtension.generated at f, R, S, G with comm, target, hom, GR
  rw CG at back
  rw gen at back
  have finImg := Finite.function_image at R.carrier, S.carrier, f, G with fn, finG, GR
  unfold FinitelyGeneratedIdeal
  refine ⟨ideal, functionImage(f, G, S.carrier), (functionImage.subset at f, G, S.carrier), finImg, ?_⟩
  symm
  exact back

-- Quotients and localizations of Noetherian rings are Noetherian
-- (Ideal.Quotient.isNoetherianRing, IsLocalization.isNoetherianRing), and
-- so is the image of a homomorphism (isNoetherianRing_range).
theorem NoetherianRing.quotient (I : Set)
  requires noetherian : NoetherianRing(R)
  requires ideal : Ideal(R, I)
  shows NoetherianRing(R ⧸ I)
proof
  have qComm := quotientRing.comm_ring at R, I with comm, ideal
  have proj := quotientRing.projection_hom at R, I with comm, ideal
  have onto := quotientRing.projection_surjective at R, I with comm, ideal
  exact NoetherianRing.of_surjective at R, R ⧸ I, quotientProjection(R.carrier, quotientRelation(R, I)) with comm, noetherian, qComm, proj, onto

theorem NoetherianRing.localization (S A : Set)
  requires noetherian : NoetherianRing(R)
  requires localization : IsLocalization(S, A)
  requires base : Algebra.base(A) = R
  shows NoetherianRing(Algebra.ring(A))
proof
  sorry

-- The Hilbert basis theorem (Polynomial.isNoetherianRing,
-- MvPolynomial.isNoetherianRing): R[X] and R[X₀, …, Xₙ₋₁] are Noetherian
-- over a Noetherian R. Proved in ZF from the definition by finitely
-- generated ideals (the leading-coefficient ideals are finitely
-- generated, and finitely many generators are picked from finite sets).
theorem NoetherianRing.polynomial
  requires noetherian : NoetherianRing(R)
  shows NoetherianRing(polynomialRing(R, {0}))
proof
  sorry

theorem NoetherianRing.mv_polynomial (n : Set)
  requires noetherian : NoetherianRing(R)
  requires natural : Nat(n)
  shows NoetherianRing(polynomialRing(R, n))
proof
  sorry

-- An algebra of finite type over a Noetherian ring is Noetherian
-- (Algebra.FiniteType.isNoetherianRing).
theorem NoetherianRing.of_finite_type (A : Set)
  requires noetherian : NoetherianRing(R)
  requires finiteType : FiniteTypeAlgebra(A)
  requires base : Algebra.base(A) = R
  shows NoetherianRing(Algebra.ring(A))
proof
  sorry

-- Ideal.finite_minimalPrimes_of_isNoetherianRing: finitely many minimal
-- primes over any ideal of a Noetherian ring. Noetherian induction rests
-- on the maximal condition and minimal primes exist by Zorn: Choice.
theorem NoetherianRing.finite_minimal_primes (I : Set)
  requires noetherian : NoetherianRing(R)
  requires ideal : Ideal(R, I)
  shows Finite(minimalPrimesOver(R, I))
proof
  sorry

-- In a Noetherian ring a power of the radical lies in the ideal
-- (Ideal.exists_radical_pow_le_of_fg).
theorem NoetherianRing.radical_pow (I : Set)
  requires noetherian : NoetherianRing(R)
  requires ideal : Ideal(R, I)
  shows ∃ n ∈ ℕ, idealPow(R, idealRadical(R, I), n) ⊆ I
proof
  sorry

-- Artinian rings: every prime is maximal (IsArtinianRing.isMaximal_of_isPrime),
-- there are finitely many maximal ideals, the Jacobson radical is
-- nilpotent, an Artinian ring is Noetherian (Akizuki–Hopkins), an
-- Artinian domain is a field, and an Artinian ring is the product of its
-- localizations at its maximal ideals (IsArtinianRing.equivPi), stated
-- with the maximal ideals listed as M(0), …, M(n − 1). The existence of
-- a maximal ideal inside the descending-chain arguments uses Choice.
theorem ArtinianRing.prime_maximal (P : Set)
  requires artinian : ArtinianRing(R)
  requires prime : PrimeIdeal(R, P)
  shows MaximalIdeal(R, P)
proof
  sorry

theorem ArtinianRing.finite_maximal
  requires artinian : ArtinianRing(R)
  shows Finite(maximalIdeals(R))
proof
  sorry

theorem ArtinianRing.jacobson_nilpotent
  requires artinian : ArtinianRing(R)
  shows ∃ n ∈ ℕ, idealPow(R, jacobsonRadical(R, {R.zero}), n) = {R.zero}
proof
  sorry

theorem ArtinianRing.noetherian
  requires artinian : ArtinianRing(R)
  shows NoetherianRing(R)
proof
  sorry

theorem ArtinianRing.domain_field
  requires artinian : ArtinianRing(R)
  requires domain : IntegralDomain(R)
  shows Field(R)
proof
  have ringR := CommRing.to_ring with comm
  have art0 := artinian
  obtain ⟨_, artMod⟩ := art0
  obtain ⟨_, minC⟩ := artMod
  have nt := IntegralDomain.nontrivial at R with domain
  have units : ∀ a ∈ R.carrier, a ≠ R.zero → RingUnit(R, a)
    intros a aR ane
    have zeroIn : 0 ∈ ℕ by typecheck
    have pIn : ringMultiples(R, Ring.pow(R, a, 0)) ∈ finPowIdeals(R, a)
      apply finPowIdeals.membership.backward
      exact ⟨0, zeroIn, rfl⟩
    have nonE : Nonempty(finPowIdeals(R, a))
      exact ⟨ringMultiples(R, Ring.pow(R, a, 0)), pIn⟩
    have ne := Nonempty.ne_empty with nonE
    have subsF : ∀ J ∈ finPowIdeals(R, a), SubmoduleOf(J, selfModule(R), R)
      intros J hJ
      obtain ⟨n, nN, Jn⟩ := finPowIdeals.membership.forward with hJ
      have nNat : Nat(n) := nN
      have pR := Ring.pow_mem at R, a, n with aR, ringR
      have mi := ringMultiples.ideal at R, Ring.pow(R, a, n) with pR, comm
      rw ← Jn
      exact (Ideal.iff_submodule at R, ringMultiples(R, Ring.pow(R, a, n)) with comm).forward with mi
    obtain ⟨J0, hJ0, minJ⟩ := minC with finPowIdeals(R, a), ne, subsF
    obtain ⟨k, kN, Jk⟩ := finPowIdeals.membership.forward with hJ0
    have kNat : Nat(k) := kN
    have sk : succ(k) ∈ ℕ by typecheck
    have pkR := Ring.pow_mem at R, a, k with aR, ringR
    have pk1R := Ring.pow_mem at R, a, succ(k) with aR, ringR
    have J1 : ringMultiples(R, Ring.pow(R, a, succ(k))) ∈ finPowIdeals(R, a)
      apply finPowIdeals.membership.backward
      exact ⟨succ(k), sk, rfl⟩
    have le : k ≤ succ(k) by arith
    have d := RingDvd.pow_pow at R, a, k, succ(k) with aR, comm, le
    have sub := (ringMultiples.subset_iff at R, Ring.pow(R, a, succ(k)), Ring.pow(R, a, k) with pk1R, pkR, comm).backward with d
    rw Jk at sub
    have same := minJ with ringMultiples(R, Ring.pow(R, a, succ(k))), J1, sub
    have selfIn := ringMultiples.self_mem at R, Ring.pow(R, a, k) with pkR, comm
    rw [Jk, ← same] at selfIn
    have d2 := (ringMultiples.mem_iff at R, Ring.pow(R, a, succ(k)), Ring.pow(R, a, k) with pk1R, pkR, comm).forward with selfIn
    obtain ⟨_, _, c, cR, eq⟩ := d2
    exact finHelp.unit_of_pow_eq at R, a, c, k with comm, aR, cR, domain, ane, eq
  have ideals : ∀ I, Ideal(R, I) → I = {R.zero} ∨ I = R.carrier
    intros I ideal
    by_cases iz : I = {R.zero}
    . left
      exact iz
    . right
      by_contra notWhole
      apply iz
      have z := Ideal.zero_mem at R, I with ideal
      ext x
      constructor
      . intro hx
        by_contra xne
        have xne2 : x ≠ R.zero
          intro xz
          apply xne
          rw xz
          exact singleton.self at R.zero
        have xR := (Ideal.subset at R, I with ideal) with x, hx
        have u := units with x, xR, xne2
        exact notWhole with (Ideal.eq_whole_of_unit_mem at R, I, x with comm, ideal, hx, u)
      . intro hx
        have xz := singleton.membership.forward with hx
        rw xz
        exact z
  exact Field.of_ideals at R with comm, nt, ideals

theorem ArtinianRing.product_of_local (M : Set) (n : Nat)
  requires artinian : ArtinianRing(R)
  requires maximals : ∀ k ∈ n, MaximalIdeal(R, M(k))
  requires distinct : ∀ j k ∈ n, M(j) = M(k) → j = k
  requires all : ∀ N, MaximalIdeal(R, N) → (∃ k ∈ n, N = M(k))
  shows ∃ f, RingIso(f, R, piRing(n, localizationFamily(R, n, M))) ∧
    (∀ k ∈ n, LocalRing(localizationAtPrime(R, M(k))))
proof
  sorry

-- IsArtinianRing.isSemisimpleRing_iff_jacobson, in the reduced form: a
-- reduced Artinian ring is a finite product of fields.
theorem ArtinianRing.reduced_product_of_fields (M : Set) (n : Nat)
  requires artinian : ArtinianRing(R)
  requires reduced : ReducedRing(R)
  requires maximals : ∀ k ∈ n, MaximalIdeal(R, M(k))
  requires distinct : ∀ j k ∈ n, M(j) = M(k) → j = k
  requires all : ∀ N, MaximalIdeal(R, N) → (∃ k ∈ n, N = M(k))
  shows RingIso(chineseRemainderMap(R, n, M), R ⧸ {R.zero},
    piRing(n, quotientFamily(R, n, M))) ∧
    idealFamilyIntersection(R, n, M) = {R.zero}
proof
  sorry

-- A ring of finite length over itself is Artinian; a finite algebra over
-- a field is Artinian (IsArtinianRing.of_finite for algebras).
theorem ArtinianRing.of_finite_algebra (A : Set)
  requires field : Field(R)
  requires finite : FiniteAlgebra(A)
  requires base : Algebra.base(A) = R
  shows ArtinianRing(Algebra.ring(A))
proof
  sorry

end NoetherianRings

