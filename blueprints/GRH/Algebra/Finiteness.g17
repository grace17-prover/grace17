-- Finiteness conditions in commutative algebra: finitely generated
-- submodules, finite and finitely presented modules, subalgebras and the
-- subalgebra generated by a set (Algebra.adjoin), finite algebras,
-- algebras of finite type and of finite presentation, Noetherian and
-- Artinian modules and rings with the chain conditions, the Hilbert basis
-- theorem, Artinian rings, and the length of a module of finite length.
-- Noetherian modules are defined as in Mathlib (every submodule finitely
-- generated) and Artinian modules by the minimal condition (Mathlib's
-- well-foundedness of < on submodules); the chain conditions are stated
-- beside them, and the comments say which implications need dependent
-- choice.
-- Part of the GRH blueprint.
-- Planned home: Algebra/Module/Finiteness and Algebra/Ring/Noetherian.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Algebra.Finiteness
import GRH.Algebra.LocalRings
import GRH.Polynomial.Multivariate
import Grace.Cumulus.Algebra.Adjoin

-- Section: Finitely generated submodules and finite modules
-- A finite module is track A's FinitelyGeneratedModule (Module.Finite).
-- A submodule spanned by a finite set (Submodule.FG):
predicate SubmoduleFG (M R N : Set) :=
  SubmoduleOf(N, M, R) ∧
  (∃ S, S ⊆ N ∧ Finite(S) ∧ moduleSpan(M, R, S) = N)

-- A finitely presented module: a quotient of Rⁿ by a finitely generated
-- submodule (Module.FinitePresentation).
predicate FinitelyPresentedModule (M R : Set) :=
  Module(M, R) ∧ (∃ n, Nat(n) ∧ ∃ f, LinearMap(f, coordinateModule(R, n), R, M) ∧
    SurjectiveBetween(f, Module.carrier(coordinateModule(R, n)), Module.carrier(M)) ∧
    SubmoduleFG(coordinateModule(R, n), R, linearKernel(f, coordinateModule(R, n), M)))

-- Section: Subalgebras and finiteness of algebras
-- For an R-algebra A: subalgebras, the subalgebra generated by G
-- (Algebra.adjoin), as Cumulus's forms over the projections of A.
predicate SubalgebraOf (A T : Set) :=
  Algebra(A) ∧ Subalgebra(Algebra.map(A), Ring.carrier(Algebra.base(A)),
    algebraCarrier(A), Ring.add(Algebra.ring(A)), Ring.zero(Algebra.ring(A)),
    Ring.neg(Algebra.ring(A)), Ring.mul(Algebra.ring(A)),
    Ring.one(Algebra.ring(A)), T)

def adjoinOf (A G : Set) : Set :=
  algebraAdjoin(Algebra.map(A), Ring.carrier(Algebra.base(A)),
    algebraCarrier(A), Ring.add(Algebra.ring(A)), Ring.zero(Algebra.ring(A)),
    Ring.neg(Algebra.ring(A)), Ring.mul(Algebra.ring(A)),
    Ring.one(Algebra.ring(A)), G)

-- A finite algebra: finitely generated as a module over the base
-- (Algebra.Finite, Module.Finite R A).
predicate FiniteAlgebra (A : Set) :=
  Algebra(A) ∧ FinitelyGeneratedModule(algebraModule(A), Algebra.base(A))

-- An algebra of finite type: generated by finitely many elements
-- (Algebra.FiniteType).
predicate FiniteTypeAlgebra (A : Set) :=
  Algebra(A) ∧ (∃ G, G ⊆ algebraCarrier(A) ∧ Finite(G) ∧
    adjoinOf(A, G) = algebraCarrier(A))

-- An algebra of finite presentation: a quotient of a polynomial algebra
-- in finitely many variables by a finitely generated ideal
-- (Algebra.FinitePresentation).
predicate FinitePresentationAlgebra (A : Set) :=
  Algebra(A) ∧ (∃ n, Nat(n) ∧ ∃ f,
    AlgebraHom(f, polynomialAlgebra(Algebra.base(A), n), A) ∧
    SurjectiveBetween(f, Ring.carrier(polynomialRing(Algebra.base(A), n)),
      algebraCarrier(A)) ∧
    FinitelyGeneratedIdeal(polynomialRing(Algebra.base(A), n),
      ringKernel(f, Ring.carrier(polynomialRing(Algebra.base(A), n)),
        Ring.zero(Algebra.ring(A)))))

-- Section: Noetherian and Artinian modules and rings
-- Noetherian: every submodule is finitely generated (IsNoetherian), and
-- every ideal of a Noetherian ring (IsNoetherianRing).
predicate NoetherianModule (M R : Set) :=
  Module(M, R) ∧ (∀ N, SubmoduleOf(N, M, R) → SubmoduleFG(M, R, N))

predicate NoetherianRing (R : Set) :=
  CommRing(R) ∧ (∀ I, Ideal(R, I) → FinitelyGeneratedIdeal(R, I))

-- The chain conditions on sequences: an increasing sequence of submodules
-- is eventually constant (ACC), a decreasing one is (DCC); the maximal
-- and minimal conditions on nonempty sets of submodules.
predicate AscendingChainCondition (M R : Set) :=
  ∀ N, (∀ n ∈ ℕ, SubmoduleOf(N(n), M, R)) →
    (∀ n ∈ ℕ, N(n) ⊆ N(succ(n))) → (∃ k ∈ ℕ, ∀ n ∈ ℕ, k ≤ n → N(n) = N(k))

predicate DescendingChainCondition (M R : Set) :=
  ∀ N, (∀ n ∈ ℕ, SubmoduleOf(N(n), M, R)) →
    (∀ n ∈ ℕ, N(succ(n)) ⊆ N(n)) → (∃ k ∈ ℕ, ∀ n ∈ ℕ, k ≤ n → N(n) = N(k))

predicate MaximalCondition (M R : Set) :=
  ∀ F, F ≠ ∅ → (∀ N ∈ F, SubmoduleOf(N, M, R)) →
    (∃ N ∈ F, ∀ P ∈ F, N ⊆ P → P = N)

predicate MinimalCondition (M R : Set) :=
  ∀ F, F ≠ ∅ → (∀ N ∈ F, SubmoduleOf(N, M, R)) →
    (∃ N ∈ F, ∀ P ∈ F, P ⊆ N → P = N)

-- Artinian: the minimal condition (IsArtinian, WellFoundedLT on
-- submodules); an Artinian ring is Artinian over itself (IsArtinianRing).
predicate ArtinianModule (M R : Set) := Module(M, R) ∧ MinimalCondition(M, R)

predicate ArtinianRing (R : Set) :=
  CommRing(R) ∧ ArtinianModule(selfModule(R), R)

-- Section: Length
-- A composition series of length n: submodules N(0) = 0 ⊊ N(1) ⊊ ⋯ ⊊ N(n)
-- = M with nothing strictly between consecutive terms. M has finite
-- length when it has one; its length is the n (Module.length, finite
-- case; unique by Jordan–Hölder).
predicate CompositionSeries (M R N : Set, n : Nat) :=
  (∀ k ∈ succ(n), SubmoduleOf(N(k), M, R)) ∧ N(0) = {Module.zero(M)} ∧
  N(n) = Module.carrier(M) ∧
  (∀ k ∈ n, N(k) ⊆ N(succ(k)) ∧ N(k) ≠ N(succ(k)) ∧
    (∀ P, SubmoduleOf(P, M, R) → N(k) ⊆ P → P ⊆ N(succ(k)) →
      P = N(k) ∨ P = N(succ(k))))

predicate HasLength (M R : Set, n : Nat) := ∃ N, CompositionSeries(M, R, N, n)

predicate FiniteLength (M R : Set) := Module(M, R) ∧ (∃ n ∈ ℕ, HasLength(M, R, n))

defunique moduleLength (M R : Set) (n ∈ ℕ) := HasLength(M, R, n)
requires ring : CommRing(R)
requires finiteLength : FiniteLength(M, R)
proof
  obtain ⟨_, n, nN, h⟩ := finiteLength
  witness n
  exact ⟨nN, h⟩
uniqueness
  sorry

-- A simple module: nonzero with no submodules but 0 and M (IsSimpleModule).
predicate SimpleModule (M R : Set) :=
  Module(M, R) ∧ Module.carrier(M) ≠ {Module.zero(M)} ∧
  (∀ N, SubmoduleOf(N, M, R) → N = {Module.zero(M)} ∨ N = Module.carrier(M))

-- The monoid generated by G: finite products of elements of G, as the
-- intersection of the sets containing 1 and G closed under products.
def generatedMonoid (A G : Set) : Set :=
  { x ∈ algebraCarrier(A) | ∀ T, T ⊆ algebraCarrier(A) →
    Ring.one(Algebra.ring(A)) ∈ T → G ⊆ T →
    (∀ y z ∈ T, call2(Ring.mul(Algebra.ring(A)), y, z) ∈ T) → x ∈ T }

-- The minimal primes over I, the maximal ideals, and the family of
-- localizations at a family of primes.
def minimalPrimesOver (R I : Set) : Set :=
  { P ∈ 𝒫(Ring.carrier(R)) | MinimalPrimeOver(R, I, P) }

def maximalIdeals (R : Set) : Set :=
  { M ∈ 𝒫(Ring.carrier(R)) | MaximalIdeal(R, M) }

def localizationRings (R K P : Set) : Set :=
  { localizationAtPrime(R, P(k)) | k ∈ K }

def localizationFamily (R K P : Set) : Set :=
  { u ∈ K × localizationRings(R, K, P) | ∃ k ∈ K, u = (k, localizationAtPrime(R, P(k))) }

-- Section: Finite modules
section FiniteModules
variable (R M : Set)
hypothesis comm : CommRing(R)
hypothesis module : Module(M, R)

-- Module.Finite.iff_fg: M is finite iff its top submodule is f.g.
theorem FinitelyGeneratedModule.iff_fg
  shows FinitelyGeneratedModule(M, R) ↔ SubmoduleFG(M, R, M.carrier)
proof
  sorry

-- Submodule.fg_span, isNoetherian_span_of_finite: a finite set spans an
-- f.g. submodule; f.g. submodules are closed under sums and images.
theorem SubmoduleFG.span (S : Set)
  requires subset : S ⊆ M.carrier
  requires finite : Finite(S)
  shows SubmoduleFG(M, R, moduleSpan(M, R, S))
proof
  sorry

theorem SubmoduleFG.sum (N P : Set)
  requires first : SubmoduleFG(M, R, N)
  requires second : SubmoduleFG(M, R, P)
  shows SubmoduleFG(M, R, submoduleSum(M, N, P))
proof
  sorry

theorem SubmoduleFG.image (N f P : Set)
  requires fg : SubmoduleFG(M, R, N)
  requires linear : LinearMap(f, M, R, P)
  shows SubmoduleFG(P, R, submoduleImage(f, M, P, N))
proof
  sorry

-- Module.Finite.of_surjective and Module.Finite.equiv: images of finite
-- modules are finite.
theorem FinitelyGeneratedModule.of_surjective (N f : Set)
  requires finite : FinitelyGeneratedModule(M, R)
  requires linear : LinearMap(f, M, R, N)
  requires surjective : SurjectiveBetween(f, M.carrier, Module.carrier(N))
  shows FinitelyGeneratedModule(N, R)
proof
  sorry

-- A quotient of a finite module is finite.
theorem FinitelyGeneratedModule.quotient (N : Set)
  requires finite : FinitelyGeneratedModule(M, R)
  requires sub : SubmoduleOf(N, M, R)
  shows FinitelyGeneratedModule(quotientModule(M, R, N), R)
proof
  sorry

-- Module.Finite.of_basis: a module with a finite basis is finite; Rⁿ is
-- finite (Module.Finite.pi).
theorem FinitelyGeneratedModule.of_basis (I v : Set)
  requires finite : Finite(I)
  requires basis : ModuleBasis(M, R, I, v)
  shows FinitelyGeneratedModule(M, R)
proof
  sorry

theorem FinitelyGeneratedModule.coordinate (I : Set)
  requires finite : Finite(I)
  shows FinitelyGeneratedModule(coordinateModule(R, I), R)
proof
  sorry

-- A finite module is a quotient of some Rⁿ (Module.Finite.exists_fin').
theorem FinitelyGeneratedModule.exists_surjection
  requires finite : FinitelyGeneratedModule(M, R)
  shows ∃ n, Nat(n) ∧ ∃ f, LinearMap(f, coordinateModule(R, n), R, M) ∧
    SurjectiveBetween(f, Module.carrier(coordinateModule(R, n)), M.carrier)
proof
  sorry

-- An extension of finite modules is finite: if N and M ⧸ N are finite,
-- so is M.
theorem FinitelyGeneratedModule.of_extension (N : Set)
  requires sub : SubmoduleOf(N, M, R)
  requires finiteSub : FinitelyGeneratedModule(submoduleModule(M, R, N), R)
  requires finiteQuotient : FinitelyGeneratedModule(quotientModule(M, R, N), R)
  shows FinitelyGeneratedModule(M, R)
proof
  sorry

-- A product of two finite modules is finite (Module.Finite.prod).
theorem FinitelyGeneratedModule.product (N : Set)
  requires first : FinitelyGeneratedModule(M, R)
  requires second : FinitelyGeneratedModule(N, R)
  shows FinitelyGeneratedModule(productModule(M, R, N), R)
proof
  sorry

-- A finitely presented module is finite.
theorem FinitelyPresentedModule.finite
  requires presented : FinitelyPresentedModule(M, R)
  shows FinitelyGeneratedModule(M, R)
proof
  sorry

-- Over a Noetherian ring every finite module is finitely presented
-- (Module.finitePresentation_of_finite).
theorem FinitelyPresentedModule.of_noetherian
  requires noetherian : NoetherianRing(R)
  requires finite : FinitelyGeneratedModule(M, R)
  shows FinitelyPresentedModule(M, R)
proof
  sorry

end FiniteModules

-- Section: Subalgebras and finiteness of algebras
section Algebras
variable (A : Set)
hypothesis algebra : Algebra(A)

-- Algebra.adjoin: a subalgebra containing G, the least one
-- (Algebra.subset_adjoin, Algebra.adjoin_le), monotone, and spanned as a
-- module by the products of generators (Algebra.adjoin_eq_span).
theorem adjoinOf.subalgebra (G : Set)
  requires subset : G ⊆ algebraCarrier(A)
  shows SubalgebraOf(A, adjoinOf(A, G)) ∧ G ⊆ adjoinOf(A, G)
proof
  have base := Algebra.base_comm_ring at A with algebra
  have ringA := Algebra.comm_ring at A with algebra
  have sh := Algebra.structure_hom at A with algebra
  have bp := CommRing.parts with base
  have ap := CommRing.parts with ringA
  have hp := RingHom.parts with sh
  have g := subset
  unfold algebraCarrier at g
  have s := algebraAdjoin.subalgebra at Ring.carrier(Algebra.base(A)), Ring.add(Algebra.base(A)), Ring.zero(Algebra.base(A)), Ring.neg(Algebra.base(A)), Ring.mul(Algebra.base(A)), Ring.one(Algebra.base(A)), Ring.carrier(Algebra.ring(A)), Ring.add(Algebra.ring(A)), Ring.zero(Algebra.ring(A)), Ring.neg(Algebra.ring(A)), Ring.mul(Algebra.ring(A)), Ring.one(Algebra.ring(A)), Algebra.map(A), G with bp, ap, hp, g
  have c := algebraAdjoin.contains at Ring.carrier(Algebra.base(A)), Ring.add(Algebra.base(A)), Ring.zero(Algebra.base(A)), Ring.neg(Algebra.base(A)), Ring.mul(Algebra.base(A)), Ring.one(Algebra.base(A)), Ring.carrier(Algebra.ring(A)), Ring.add(Algebra.ring(A)), Ring.zero(Algebra.ring(A)), Ring.neg(Algebra.ring(A)), Ring.mul(Algebra.ring(A)), Ring.one(Algebra.ring(A)), Algebra.map(A), G with bp, ap, hp, g
  unfold SubalgebraOf
  unfold adjoinOf
  unfold algebraCarrier
  exact ⟨⟨algebra, s⟩, c⟩

theorem adjoinOf.least (G T : Set)
  requires subset : G ⊆ algebraCarrier(A)
  requires subalgebra : SubalgebraOf(A, T)
  shows adjoinOf(A, G) ⊆ T ↔ G ⊆ T
proof
  have base := Algebra.base_comm_ring at A with algebra
  have ringA := Algebra.comm_ring at A with algebra
  have sh := Algebra.structure_hom at A with algebra
  have bp := CommRing.parts with base
  have ap := CommRing.parts with ringA
  have hp := RingHom.parts with sh
  have both := adjoinOf.subalgebra at A, G with algebra, subset
  obtain ⟨_, contains⟩ := both
  constructor
  . intro le
    exact Subset.transitive with contains, le
  . intro gt
    obtain ⟨_, sT⟩ := subalgebra
    unfold algebraCarrier at sT
    unfold adjoinOf
    unfold algebraCarrier
    exact algebraAdjoin.least at Ring.carrier(Algebra.base(A)), Ring.add(Algebra.base(A)), Ring.zero(Algebra.base(A)), Ring.neg(Algebra.base(A)), Ring.mul(Algebra.base(A)), Ring.one(Algebra.base(A)), Ring.carrier(Algebra.ring(A)), Ring.add(Algebra.ring(A)), Ring.zero(Algebra.ring(A)), Ring.neg(Algebra.ring(A)), Ring.mul(Algebra.ring(A)), Ring.one(Algebra.ring(A)), Algebra.map(A), G, T with bp, ap, hp, sT, gt

theorem adjoinOf.mono (G H : Set)
  requires subset : G ⊆ H
  requires bounded : H ⊆ algebraCarrier(A)
  shows adjoinOf(A, G) ⊆ adjoinOf(A, H)
proof
  have gb := Subset.transitive with subset, bounded
  have hs := adjoinOf.subalgebra at A, H with algebra, bounded
  obtain ⟨sub, contains⟩ := hs
  have gt := Subset.transitive with subset, contains
  have l := adjoinOf.least at A, G, adjoinOf(A, H) with algebra, gb, sub
  exact l.backward with gt

theorem adjoinOf.eq_span (G : Set)
  requires subset : G ⊆ algebraCarrier(A)
  shows adjoinOf(A, G) = moduleSpan(algebraModule(A), Algebra.base(A),
    generatedMonoid(A, G))
proof
  sorry

-- Algebra.adjoin_induction: a set containing the generators and the
-- image of R and closed under sums and products contains the adjoin.
theorem adjoinOf.induction (G P : Set)
  requires subset : G ⊆ algebraCarrier(A)
  requires generators : G ⊆ P
  requires scalars : ∀ r ∈ Ring.carrier(Algebra.base(A)), Algebra.map(A)(r) ∈ P
  requires sums : ∀ x y ∈ P ∩ algebraCarrier(A),
    call2(Ring.add(Algebra.ring(A)), x, y) ∈ P
  requires products : ∀ x y ∈ P ∩ algebraCarrier(A),
    call2(Ring.mul(Algebra.ring(A)), x, y) ∈ P
  shows adjoinOf(A, G) ⊆ P
proof
  sorry

-- The adjoin of G is the image of evaluation of polynomials at G
-- (Algebra.adjoin_eq_range): x ∈ adjoin G iff x = aeval v p for p in
-- finitely many variables.
theorem adjoinOf.eq_range (n v : Set)
  requires natural : Nat(n)
  requires generators : v : n → algebraCarrier(A)
  shows adjoinOf(A, functionImage(v, n, algebraCarrier(A))) =
    functionImage(mvAeval(A, n, v), Ring.carrier(polynomialRing(Algebra.base(A), n)),
      algebraCarrier(A))
proof
  sorry

-- A finite algebra is of finite type (Algebra.FiniteType.of_finite);
-- finite type is the quotient of a polynomial algebra in finitely many
-- variables (Algebra.FiniteType.iff_quotient_mvPolynomial'').
theorem FiniteAlgebra.finite_type
  requires finite : FiniteAlgebra(A)
  shows FiniteTypeAlgebra(A)
proof
  sorry

theorem FiniteTypeAlgebra.iff_quotient
  shows FiniteTypeAlgebra(A) ↔ (∃ n, Nat(n) ∧ ∃ f,
    AlgebraHom(f, polynomialAlgebra(Algebra.base(A), n), A) ∧
    SurjectiveBetween(f, Ring.carrier(polynomialRing(Algebra.base(A), n)),
      algebraCarrier(A)))
proof
  sorry

-- Finite presentation implies finite type; over a Noetherian base the
-- converse holds (RingHom.FinitePresentation.of_finiteType,
-- Algebra.FinitePresentation.of_finiteType).
theorem FinitePresentationAlgebra.finite_type
  requires presented : FinitePresentationAlgebra(A)
  shows FiniteTypeAlgebra(A)
proof
  sorry

theorem FinitePresentationAlgebra.of_finite_type
  requires noetherian : NoetherianRing(Algebra.base(A))
  requires finiteType : FiniteTypeAlgebra(A)
  shows FinitePresentationAlgebra(A)
proof
  sorry

-- Algebra.FinitePresentation.ker_fG_of_surjective: for a finitely
-- presented A, every surjection from a polynomial algebra in finitely
-- many variables has finitely generated kernel.
theorem FinitePresentationAlgebra.kernel_fg (n f : Set)
  requires presented : FinitePresentationAlgebra(A)
  requires natural : Nat(n)
  requires hom : AlgebraHom(f, polynomialAlgebra(Algebra.base(A), n), A)
  requires surjective : SurjectiveBetween(f,
    Ring.carrier(polynomialRing(Algebra.base(A), n)), algebraCarrier(A))
  shows FinitelyGeneratedIdeal(polynomialRing(Algebra.base(A), n),
    ringKernel(f, Ring.carrier(polynomialRing(Algebra.base(A), n)),
      Ring.zero(Algebra.ring(A))))
proof
  sorry

-- Finite type passes to quotients (Algebra.FiniteType.of_surjective) and
-- polynomial algebras in finitely many variables are of finite
-- presentation (Algebra.FinitePresentation.mvPolynomial).
theorem FiniteTypeAlgebra.of_surjective (B f : Set)
  requires finiteType : FiniteTypeAlgebra(A)
  requires hom : f : A →ₐ B
  requires surjective : SurjectiveBetween(f, algebraCarrier(A), algebraCarrier(B))
  shows FiniteTypeAlgebra(B)
proof
  sorry

theorem FinitePresentationAlgebra.polynomial (n : Set)
  requires natural : Nat(n)
  shows FinitePresentationAlgebra(polynomialAlgebra(Algebra.base(A), n))
proof
  sorry

-- A finite algebra over a finite base is a finite set when the base is
-- finite (Module.finite_of_finite).
theorem FiniteAlgebra.finite_carrier
  requires finite : FiniteAlgebra(A)
  requires finiteBase : Finite(Ring.carrier(Algebra.base(A)))
  shows Finite(algebraCarrier(A))
proof
  sorry

end Algebras

-- Towers: finite over finite is finite (Module.Finite.trans), finite type
-- over finite type is finite type (Algebra.FiniteType.trans). The tower
-- R → A → B is written with B an A-algebra and the composite structure
-- map.
theorem FiniteAlgebra.trans (A B : Set)
  requires first : FiniteAlgebra(A)
  requires second : FiniteAlgebra(B)
  requires tower : Algebra.base(B) = Algebra.ring(A)
  shows FiniteAlgebra(Algebra.mk(Algebra.base(A), Algebra.ring(B),
    compose(Algebra.map(B), Algebra.map(A), Ring.carrier(Algebra.base(A)),
      algebraCarrier(A), algebraCarrier(B))))
proof
  sorry

theorem FiniteTypeAlgebra.trans (A B : Set)
  requires first : FiniteTypeAlgebra(A)
  requires second : FiniteTypeAlgebra(B)
  requires tower : Algebra.base(B) = Algebra.ring(A)
  shows FiniteTypeAlgebra(Algebra.mk(Algebra.base(A), Algebra.ring(B),
    compose(Algebra.map(B), Algebra.map(A), Ring.carrier(Algebra.base(A)),
      algebraCarrier(A), algebraCarrier(B))))
proof
  sorry

-- Section: Noetherian modules
section NoetherianModules
variable (R M : Set)
hypothesis comm : CommRing(R)
hypothesis module : Module(M, R)

-- The chain conditions: f.g. ⇒ ACC and maximal condition ⇒ f.g. are ZF;
-- ACC ⇒ f.g. and f.g. ⇒ maximal condition (IsNoetherian.wellFoundedGT,
-- isNoetherian_iff_fg_wellFounded, set_has_maximal_iff_noetherian) build
-- a strictly increasing sequence by dependent choice: Choice.
theorem NoetherianModule.ascending
  requires noetherian : NoetherianModule(M, R)
  shows AscendingChainCondition(M, R)
proof
  sorry

theorem NoetherianModule.of_maximal
  requires maximal : MaximalCondition(M, R)
  shows NoetherianModule(M, R)
proof
  sorry

theorem NoetherianModule.of_ascending
  requires ascending : AscendingChainCondition(M, R)
  shows NoetherianModule(M, R)
proof
  sorry

theorem NoetherianModule.maximal
  requires noetherian : NoetherianModule(M, R)
  shows MaximalCondition(M, R)
proof
  sorry

-- IsNoetherian.induction: a property of submodules inherited from all
-- strictly larger submodules holds for all. It rests on the maximal
-- condition: Choice.
theorem NoetherianModule.induction (P : Set)
  requires noetherian : NoetherianModule(M, R)
  requires step : ∀ N, SubmoduleOf(N, M, R) →
    (∀ Q, SubmoduleOf(Q, M, R) → N ⊆ Q → N ≠ Q → Q ∈ P) → N ∈ P
  shows ∀ N, SubmoduleOf(N, M, R) → N ∈ P
proof
  sorry

-- Submodules and quotients of Noetherian modules are Noetherian
-- (isNoetherian_submodule', isNoetherian_of_quotient), and M is
-- Noetherian when a submodule and the quotient are
-- (isNoetherian_of_range_eq_ker).
theorem NoetherianModule.submodule (N : Set)
  requires noetherian : NoetherianModule(M, R)
  requires sub : SubmoduleOf(N, M, R)
  shows NoetherianModule(submoduleModule(M, R, N), R)
proof
  sorry

theorem NoetherianModule.quotient (N : Set)
  requires noetherian : NoetherianModule(M, R)
  requires sub : SubmoduleOf(N, M, R)
  shows NoetherianModule(quotientModule(M, R, N), R)
proof
  sorry

theorem NoetherianModule.of_exact (P Q f g : Set)
  requires first : NoetherianModule(P, R)
  requires third : NoetherianModule(Q, R)
  requires mapF : LinearMap(f, P, R, M)
  requires mapG : LinearMap(g, M, R, Q)
  requires exact : ExactPair(f, g, P, M, Q)
  shows NoetherianModule(M, R)
proof
  sorry

-- A Noetherian module is finite.
theorem NoetherianModule.finite
  requires noetherian : NoetherianModule(M, R)
  shows FinitelyGeneratedModule(M, R)
proof
  sorry

-- isNoetherian_of_fg_of_noetherian: a finite module over a Noetherian ring
-- is Noetherian.
theorem NoetherianModule.of_finite
  requires noetherian : NoetherianRing(R)
  requires finite : FinitelyGeneratedModule(M, R)
  shows NoetherianModule(M, R)
proof
  sorry

-- Artinian modules: submodules and quotients, and the minimal condition
-- gives the descending chain condition (ZF); the converse uses dependent
-- choice: Choice.
theorem ArtinianModule.descending
  requires artinian : ArtinianModule(M, R)
  shows DescendingChainCondition(M, R)
proof
  sorry

theorem ArtinianModule.of_descending
  requires descending : DescendingChainCondition(M, R)
  shows ArtinianModule(M, R)
proof
  sorry

theorem ArtinianModule.submodule (N : Set)
  requires artinian : ArtinianModule(M, R)
  requires sub : SubmoduleOf(N, M, R)
  shows ArtinianModule(submoduleModule(M, R, N), R)
proof
  sorry

theorem ArtinianModule.quotient (N : Set)
  requires artinian : ArtinianModule(M, R)
  requires sub : SubmoduleOf(N, M, R)
  shows ArtinianModule(quotientModule(M, R, N), R)
proof
  sorry

-- Finite length is Noetherian and Artinian together
-- (isFiniteLength_iff_isNoetherian_isArtinian).
theorem FiniteLength.iff_noetherian_artinian
  shows FiniteLength(M, R) ↔ NoetherianModule(M, R) ∧ ArtinianModule(M, R)
proof
  sorry

-- Length: 0 exactly for the zero module, 1 exactly for simple modules
-- (Module.length_eq_zero_iff, IsSimpleModule), additive on short exact
-- sequences (Module.length_eq_add_of_exact), monotone under
-- surjections and for submodules (Module.length_le_of_surjective),
-- invariant under isomorphism (LinearEquiv.length_eq).
theorem moduleLength.zero_iff
  requires finiteLength : FiniteLength(M, R)
  shows moduleLength(M, R) = 0 ↔ M.carrier = {M.zero}
proof
  sorry

theorem moduleLength.one_iff
  requires finiteLength : FiniteLength(M, R)
  shows moduleLength(M, R) = 1 ↔ SimpleModule(M, R)
proof
  sorry

theorem moduleLength.exact (P Q f g : Set)
  requires mapF : LinearMap(f, P, R, M)
  requires mapG : LinearMap(g, M, R, Q)
  requires injective : InjectiveBetween(f, Module.carrier(P), M.carrier)
  requires surjective : SurjectiveBetween(g, M.carrier, Module.carrier(Q))
  requires exact : ExactPair(f, g, P, M, Q)
  requires finiteP : FiniteLength(P, R)
  requires finiteQ : FiniteLength(Q, R)
  shows FiniteLength(M, R) ∧
    moduleLength(M, R) = moduleLength(P, R) + moduleLength(Q, R)
proof
  sorry

theorem moduleLength.surjective_le (N f : Set)
  requires finiteLength : FiniteLength(M, R)
  requires linear : LinearMap(f, M, R, N)
  requires surjective : SurjectiveBetween(f, M.carrier, Module.carrier(N))
  shows FiniteLength(N, R) ∧ moduleLength(N, R) ≤ moduleLength(M, R)
proof
  sorry

theorem moduleLength.submodule_le (N : Set)
  requires finiteLength : FiniteLength(M, R)
  requires sub : SubmoduleOf(N, M, R)
  shows FiniteLength(submoduleModule(M, R, N), R) ∧
    moduleLength(submoduleModule(M, R, N), R) ≤ moduleLength(M, R) ∧
    moduleLength(M, R) = moduleLength(submoduleModule(M, R, N), R) +
      moduleLength(quotientModule(M, R, N), R)
proof
  sorry

theorem moduleLength.equiv (N f : Set)
  requires finiteLength : FiniteLength(M, R)
  requires equiv : LinearEquiv(f, M, R, N)
  shows FiniteLength(N, R) ∧ moduleLength(N, R) = moduleLength(M, R)
proof
  sorry

-- A proper submodule of a module of finite length has smaller length
-- (Module.length_lt_of_lt).
theorem moduleLength.submodule_lt (N : Set)
  requires finiteLength : FiniteLength(M, R)
  requires sub : SubmoduleOf(N, M, R)
  requires proper : N ≠ M.carrier
  shows moduleLength(submoduleModule(M, R, N), R) < moduleLength(M, R)
proof
  sorry

-- Over a field, length is dimension (Module.length_eq_finrank... in the
-- form finrank = length for finite-dimensional spaces).
theorem moduleLength.field
  requires field : Field(R)
  requires finiteDimensional : FiniteDimensional(M, R)
  shows FiniteLength(M, R) ∧ moduleLength(M, R) = finrank(M, R)
proof
  sorry

-- Module.length_pi_of_fintype in the case of a product of two.
theorem moduleLength.product (N : Set)
  requires first : FiniteLength(M, R)
  requires second : FiniteLength(N, R)
  shows FiniteLength(productModule(M, R, N), R) ∧
    moduleLength(productModule(M, R, N), R) = moduleLength(M, R) + moduleLength(N, R)
proof
  sorry

end NoetherianModules

-- Section: Noetherian and Artinian rings
section NoetherianRings
variable (R : Set)
hypothesis comm : CommRing(R)

-- A ring is Noetherian iff it is Noetherian as a module over itself.
theorem NoetherianRing.iff_module
  shows NoetherianRing(R) ↔ NoetherianModule(selfModule(R), R)
proof
  sorry

-- Fields and PIDs are Noetherian.
theorem NoetherianRing.of_field
  requires field : Field(R)
  shows NoetherianRing(R)
proof
  sorry

theorem NoetherianRing.of_pid
  requires pid : PrincipalIdealDomain(R)
  shows NoetherianRing(R)
proof
  sorry

-- A finite ring is Noetherian and Artinian (IsNoetherianRing.of_finite,
-- IsArtinianRing.of_finite).
theorem NoetherianRing.of_finite
  requires finite : Finite(R.carrier)
  shows NoetherianRing(R) ∧ ArtinianRing(R)
proof
  sorry

-- Quotients and localizations of Noetherian rings are Noetherian
-- (Ideal.Quotient.isNoetherianRing, IsLocalization.isNoetherianRing), and
-- so is the image of a homomorphism (isNoetherianRing_range).
theorem NoetherianRing.quotient (I : Set)
  requires noetherian : NoetherianRing(R)
  requires ideal : Ideal(R, I)
  shows NoetherianRing(R ⧸ I)
proof
  sorry

theorem NoetherianRing.localization (S A : Set)
  requires noetherian : NoetherianRing(R)
  requires localization : IsLocalization(S, A)
  requires base : Algebra.base(A) = R
  shows NoetherianRing(Algebra.ring(A))
proof
  sorry

theorem NoetherianRing.of_surjective (S f : Set)
  requires noetherian : NoetherianRing(R)
  requires target : CommRing(S)
  requires hom : f : R →+* S
  requires surjective : SurjectiveBetween(f, R.carrier, S.carrier)
  shows NoetherianRing(S)
proof
  sorry

-- The Hilbert basis theorem (Polynomial.isNoetherianRing,
-- MvPolynomial.isNoetherianRing): R[X] and R[X₀, …, Xₙ₋₁] are Noetherian
-- over a Noetherian R. Proved in ZF from the definition by finitely
-- generated ideals (the leading-coefficient ideals are finitely
-- generated, and finitely many generators are picked from finite sets).
theorem NoetherianRing.polynomial
  requires noetherian : NoetherianRing(R)
  shows NoetherianRing(polynomialRing(R, {0}))
proof
  sorry

theorem NoetherianRing.mv_polynomial (n : Set)
  requires noetherian : NoetherianRing(R)
  requires natural : Nat(n)
  shows NoetherianRing(polynomialRing(R, n))
proof
  sorry

-- An algebra of finite type over a Noetherian ring is Noetherian
-- (Algebra.FiniteType.isNoetherianRing).
theorem NoetherianRing.of_finite_type (A : Set)
  requires noetherian : NoetherianRing(R)
  requires finiteType : FiniteTypeAlgebra(A)
  requires base : Algebra.base(A) = R
  shows NoetherianRing(Algebra.ring(A))
proof
  sorry

-- Ideal.finite_minimalPrimes_of_isNoetherianRing: finitely many minimal
-- primes over any ideal of a Noetherian ring. Noetherian induction rests
-- on the maximal condition and minimal primes exist by Zorn: Choice.
theorem NoetherianRing.finite_minimal_primes (I : Set)
  requires noetherian : NoetherianRing(R)
  requires ideal : Ideal(R, I)
  shows Finite(minimalPrimesOver(R, I))
proof
  sorry

-- In a Noetherian ring a power of the radical lies in the ideal
-- (Ideal.exists_radical_pow_le_of_fg).
theorem NoetherianRing.radical_pow (I : Set)
  requires noetherian : NoetherianRing(R)
  requires ideal : Ideal(R, I)
  shows ∃ n ∈ ℕ, idealPow(R, idealRadical(R, I), n) ⊆ I
proof
  sorry

-- Artinian rings: every prime is maximal (IsArtinianRing.isMaximal_of_isPrime),
-- there are finitely many maximal ideals, the Jacobson radical is
-- nilpotent, an Artinian ring is Noetherian (Akizuki–Hopkins), an
-- Artinian domain is a field, and an Artinian ring is the product of its
-- localizations at its maximal ideals (IsArtinianRing.equivPi), stated
-- with the maximal ideals listed as M(0), …, M(n − 1). The existence of
-- a maximal ideal inside the descending-chain arguments uses Choice.
theorem ArtinianRing.prime_maximal (P : Set)
  requires artinian : ArtinianRing(R)
  requires prime : PrimeIdeal(R, P)
  shows MaximalIdeal(R, P)
proof
  sorry

theorem ArtinianRing.finite_maximal
  requires artinian : ArtinianRing(R)
  shows Finite(maximalIdeals(R))
proof
  sorry

theorem ArtinianRing.jacobson_nilpotent
  requires artinian : ArtinianRing(R)
  shows ∃ n ∈ ℕ, idealPow(R, jacobsonRadical(R, {R.zero}), n) = {R.zero}
proof
  sorry

theorem ArtinianRing.noetherian
  requires artinian : ArtinianRing(R)
  shows NoetherianRing(R)
proof
  sorry

theorem ArtinianRing.domain_field
  requires artinian : ArtinianRing(R)
  requires domain : IntegralDomain(R)
  shows Field(R)
proof
  sorry

theorem ArtinianRing.product_of_local (M : Set) (n : Nat)
  requires artinian : ArtinianRing(R)
  requires maximals : ∀ k ∈ n, MaximalIdeal(R, M(k))
  requires distinct : ∀ j k ∈ n, M(j) = M(k) → j = k
  requires all : ∀ N, MaximalIdeal(R, N) → (∃ k ∈ n, N = M(k))
  shows ∃ f, RingIso(f, R, piRing(n, localizationFamily(R, n, M))) ∧
    (∀ k ∈ n, LocalRing(localizationAtPrime(R, M(k))))
proof
  sorry

-- IsArtinianRing.isSemisimpleRing_iff_jacobson, in the reduced form: a
-- reduced Artinian ring is a finite product of fields.
theorem ArtinianRing.reduced_product_of_fields (M : Set) (n : Nat)
  requires artinian : ArtinianRing(R)
  requires reduced : ReducedRing(R)
  requires maximals : ∀ k ∈ n, MaximalIdeal(R, M(k))
  requires distinct : ∀ j k ∈ n, M(j) = M(k) → j = k
  requires all : ∀ N, MaximalIdeal(R, N) → (∃ k ∈ n, N = M(k))
  shows RingIso(chineseRemainderMap(R, n, M), R ⧸ {R.zero},
    piRing(n, quotientFamily(R, n, M))) ∧
    idealFamilyIntersection(R, n, M) = {R.zero}
proof
  sorry

-- A ring of finite length over itself is Artinian; a finite algebra over
-- a field is Artinian (IsArtinianRing.of_finite for algebras).
theorem ArtinianRing.of_finite_algebra (A : Set)
  requires field : Field(R)
  requires finite : FiniteAlgebra(A)
  requires base : Algebra.base(A) = R
  shows ArtinianRing(Algebra.ring(A))
proof
  sorry

end NoetherianRings

