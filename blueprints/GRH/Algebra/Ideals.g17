-- Ideals of a commutative ring: finitely generated ideals, sums,
-- products, powers and finite products of ideals, the radical, the
-- nilradical and the Jacobson radical, colon ideals, minimal primes,
-- extension and contraction along a ring homomorphism, the quotient map
-- R → R ⧸ I with its lifts and the maps between quotients, kernels and
-- the first isomorphism theorem, quotients by prime and maximal ideals,
-- products of a family of rings and the Chinese remainder theorem, the
-- index of an ideal (Submodule.cardQuot), ideals as submodules, the
-- submodule I • M, and annihilators (Mathlib's Ideal.span, Ideal.FG,
-- Ideal.mul, Ideal.radical, Ideal.jacobson, Ideal.map, Ideal.comap,
-- Ideal.Quotient.mk, Ideal.Quotient.lift, Ideal.quotientMap,
-- Ideal.Quotient.factor, RingHom.ker, Pi.ring, and
-- Ideal.quotientInfRingEquivPiQuotient).
-- Part of the GRH blueprint.
-- Planned home: Algebra/Ring/IdealOperations.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Algebra.Ideals
import GRH.Algebra.Divisibility
import Grace.Cumulus.Algebra.Ring
import Grace.Cumulus.Algebra.Field.Quotient

-- Section: Finitely generated ideals and operations on ideals
-- The ideal generated by a set is Cumulus's generatedIdeal(R, G), the
-- intersection of the ideals containing G. An ideal is finitely generated
-- when it is generated by a finite subset (Ideal.FG).
predicate FinitelyGeneratedIdeal (R I : Set) :=
  Ideal(R, I) ∧ (∃ G, G ⊆ Ring.carrier(R) ∧ Finite(G) ∧
    I = generatedIdeal(R, G))

-- I + J = {x + y}, the least ideal containing both (Ideal.sup).
def idealSum (R I J : Set) : Set :=
  { z ∈ Ring.carrier(R) | ∃ x ∈ I, ∃ y ∈ J, z = call2(Ring.add(R), x, y) }

-- The products x y with x ∈ I, y ∈ J, and the product ideal I J they
-- generate (Ideal.mul).
def idealProductGenerators (R I J : Set) : Set :=
  { z ∈ Ring.carrier(R) | ∃ x ∈ I, ∃ y ∈ J, z = call2(Ring.mul(R), x, y) }

def idealProduct (R I J : Set) : Set :=
  generatedIdeal(R, idealProductGenerators(R, I, J))

-- Iⁿ, with I⁰ = R (Monoid.npow on ideals).
def idealPow (R I : Set, n : Nat) → Set
  | R, I, zero => Ring.carrier(R)
  | R, I, succ(k) => idealProduct(R, idealPow(R, I, k), I)

-- The product I(0) ⋯ I(n − 1) of a family of ideals indexed by n
-- (Finset.prod of ideals).
def idealFamilyProduct (R I : Set, n : Nat) → Set
  | R, I, zero => Ring.carrier(R)
  | R, I, succ(k) => idealProduct(R, idealFamilyProduct(R, I, k), I(k))

-- The intersection of the ideals I(k), k ∈ K, of a family over a nonempty
-- index set (Ideal.iInf).
def idealFamilyIntersection (R K I : Set) : Set :=
  { x ∈ Ring.carrier(R) | ∀ k ∈ K, x ∈ I(k) }

-- The radical {x | xⁿ ∈ I for some n} (Ideal.radical), the nilradical
-- (the radical of 0), and radical ideals (Ideal.IsRadical).
def idealRadical (R I : Set) : Set :=
  { x ∈ Ring.carrier(R) | ∃ n ∈ ℕ, Ring.pow(R, x, n) ∈ I }

def nilradical (R : Set) : Set := idealRadical(R, {Ring.zero(R)})

predicate RadicalIdeal (R I : Set) := Ideal(R, I) ∧ idealRadical(R, I) = I

-- The intersection of the prime ideals containing I (Ideal.radical_eq_sInf).
def primeIntersection (R I : Set) : Set :=
  { x ∈ Ring.carrier(R) | ∀ P, PrimeIdeal(R, P) → I ⊆ P → x ∈ P }

-- The Jacobson radical of I: the intersection of the maximal ideals
-- containing I (Ideal.jacobson); it is the whole ring when there are
-- none.
def jacobsonRadical (R I : Set) : Set :=
  { x ∈ Ring.carrier(R) | ∀ M, MaximalIdeal(R, M) → I ⊆ M → x ∈ M }

-- The colon ideal (I : J) = {x | x J ⊆ I} (Submodule.colon).
def idealColon (R I J : Set) : Set :=
  { x ∈ Ring.carrier(R) | ∀ y ∈ J, call2(Ring.mul(R), x, y) ∈ I }

-- P is a minimal prime over I: a prime containing I and containing no
-- smaller such prime (Ideal.minimalPrimes).
predicate MinimalPrimeOver (R I P : Set) :=
  PrimeIdeal(R, P) ∧ I ⊆ P ∧
  (∀ Q, PrimeIdeal(R, Q) → I ⊆ Q → Q ⊆ P → Q = P)

-- Section: Extension and contraction
-- The extension f(I)S of an ideal I of R along f : R → S, the ideal
-- generated by the image (Ideal.map); the contraction f⁻¹(J) is Cumulus's
-- idealComap(f, R.carrier, J) (Ideal.comap).
def idealExtension (f S I : Set) : Set :=
  generatedIdeal(S, functionImage(f, I, Ring.carrier(S)))

-- P lies over p along f: p is the contraction of P (Ideal.LiesOver).
predicate LiesOver (f R P p : Set) := idealComap(f, Ring.carrier(R), P) = p

-- Section: Quotient rings and their maps
-- The quotient map R → R ⧸ I, x ↦ [x] (Ideal.Quotient.mk); R ⧸ I is
-- Cumulus's quotientRing(R, I).
def quotientMk (R I : Set) : Set :=
  quotientProjection(Ring.carrier(R), quotientRelation(R, I))

-- For f : R → S vanishing on I, the induced map R ⧸ I → S, [x] ↦ f(x)
-- (Ideal.Quotient.lift).
def quotientRingLift (R S I f : Set) : Set :=
  quotientMap(f, Ring.carrier(R), Ring.carrier(S), quotientRelation(R, I))

-- For f : R → S with I ⊆ f⁻¹(J), the map R ⧸ I → S ⧸ J, [x] ↦ [f(x)]
-- (Ideal.quotientMap).
def quotientRingMap (R S f I J : Set) : Set :=
  quotientRingLift(R, quotientRing(S, J), I,
    compose(quotientMk(S, J), f, Ring.carrier(R), Ring.carrier(S),
      Ring.carrier(quotientRing(S, J))))

-- For I ⊆ J, the surjection R ⧸ I → R ⧸ J (Ideal.Quotient.factor).
def quotientFactor (R I J : Set) : Set :=
  quotientRingLift(R, quotientRing(R, J), I, quotientMk(R, J))

-- The residue field R ⧸ M at a maximal ideal M, as a ring
-- (Ideal.ResidueField on a maximal ideal).
def residueRing (R M : Set) : Set := quotientRing(R, M)

-- Section: Products of rings
-- The product Πᵢ F(i) of a family of rings F : I → rings: the dependent
-- functions u with u(i) ∈ F(i), with the pointwise operations (Pi.ring).
def piCarriers (I F : Set) : Set := { Ring.carrier(F(i)) | i ∈ I }

def piUnion (I F : Set) : Set := ⋃(piCarriers(I, F))

def piCarrier (I F : Set) : Set :=
  { u ∈ functionSpace(I, piUnion(I, F)) | ∀ i ∈ I, u(i) ∈ Ring.carrier(F(i)) }

def piPointwiseAdd (I F u v : Set) : Set :=
  { p ∈ I × piUnion(I, F) | ∃ i ∈ I, p = (i, call2(Ring.add(F(i)), u(i), v(i))) }

def piPointwiseMul (I F u v : Set) : Set :=
  { p ∈ I × piUnion(I, F) | ∃ i ∈ I, p = (i, call2(Ring.mul(F(i)), u(i), v(i))) }

def piPointwiseNeg (I F u : Set) : Set :=
  { p ∈ I × piUnion(I, F) | ∃ i ∈ I, p = (i, apply(Ring.neg(F(i)), u(i))) }

def piZero (I F : Set) : Set :=
  { p ∈ I × piUnion(I, F) | ∃ i ∈ I, p = (i, Ring.zero(F(i))) }

def piOne (I F : Set) : Set :=
  { p ∈ I × piUnion(I, F) | ∃ i ∈ I, p = (i, Ring.one(F(i))) }

def piAdd (I F : Set) : Set :=
  { q ∈ (piCarrier(I, F) × piCarrier(I, F)) × piCarrier(I, F) |
    ∃ u ∈ piCarrier(I, F), ∃ v ∈ piCarrier(I, F),
      q = ((u, v), piPointwiseAdd(I, F, u, v)) }

def piMul (I F : Set) : Set :=
  { q ∈ (piCarrier(I, F) × piCarrier(I, F)) × piCarrier(I, F) |
    ∃ u ∈ piCarrier(I, F), ∃ v ∈ piCarrier(I, F),
      q = ((u, v), piPointwiseMul(I, F, u, v)) }

def piNeg (I F : Set) : Set :=
  { q ∈ piCarrier(I, F) × piCarrier(I, F) |
    ∃ u ∈ piCarrier(I, F), q = (u, piPointwiseNeg(I, F, u)) }

def piRing (I F : Set) : Set :=
  Ring.mk(piCarrier(I, F), piAdd(I, F), piZero(I, F), piNeg(I, F),
    piMul(I, F), piOne(I, F))

-- The projection Πⱼ F(j) → F(i) (Pi.evalRingHom) and, for a family of
-- homomorphisms f(i) : R → F(i), the homomorphism R → Πᵢ F(i),
-- x ↦ (f(i)(x))ᵢ (Pi.ringHom, RingHom.pi).
def piProjection (I F i : Set) : Set :=
  { p ∈ piCarrier(I, F) × Ring.carrier(F(i)) |
    ∃ u ∈ piCarrier(I, F), p = (u, u(i)) }

def piFamilyValue (I F f x : Set) : Set :=
  { p ∈ I × piUnion(I, F) | ∃ i ∈ I, p = (i, f(i)(x)) }

def piLift (R I F f : Set) : Set :=
  { p ∈ Ring.carrier(R) × piCarrier(I, F) |
    ∃ x ∈ Ring.carrier(R), p = (x, piFamilyValue(I, F, f, x)) }

-- The family of quotient rings k ↦ R ⧸ I(k), and the map
-- R ⧸ ⋂ I(k) → Πₖ R ⧸ I(k) of the Chinese remainder theorem
-- (Ideal.quotientInfToPiQuotient).
def quotientRings (R K I : Set) : Set := { quotientRing(R, I(k)) | k ∈ K }

def quotientMks (R K I : Set) : Set := { quotientMk(R, I(k)) | k ∈ K }

def quotientFamily (R K I : Set) : Set :=
  { p ∈ K × quotientRings(R, K, I) |
    ∃ k ∈ K, p = (k, quotientRing(R, I(k))) }

def quotientFamilyMaps (R K I : Set) : Set :=
  { p ∈ K × quotientMks(R, K, I) |
    ∃ k ∈ K, p = (k, quotientMk(R, I(k))) }

def chineseRemainderMap (R K I : Set) : Set :=
  quotientRingLift(R, piRing(K, quotientFamily(R, K, I)),
    idealFamilyIntersection(R, K, I),
    piLift(R, K, quotientFamily(R, K, I), quotientFamilyMaps(R, K, I)))

-- Section: Ideals and modules
-- The submodule I • N of an R-module M for an ideal I and a submodule N:
-- the span of the products r • v (Submodule.smul, Ideal.smul_top for
-- N = M).
def idealSmulGenerators (M R I N : Set) : Set :=
  { w ∈ Module.carrier(M) | ∃ r ∈ I, ∃ v ∈ N, w = call2(Module.smul(M), r, v) }

def idealSmul (M R I N : Set) : Set :=
  moduleSpan(M, R, idealSmulGenerators(M, R, I, N))

-- The annihilator {r | r • v = 0 for all v} of a module
-- (Module.annihilator) and the annihilator of one vector
-- (Ideal.torsionOf).
def moduleAnnihilator (M R : Set) : Set :=
  { r ∈ Ring.carrier(R) | ∀ v ∈ Module.carrier(M),
    call2(Module.smul(M), r, v) = Module.zero(M) }

def vectorAnnihilator (M R v : Set) : Set :=
  { r ∈ Ring.carrier(R) | call2(Module.smul(M), r, v) = Module.zero(M) }

-- The torsion {v | r • v = 0} by an element r (Submodule.torsionBy).
-- The image a M = {a • v} of multiplication by a.
def scalarMultipleImage (M a : Set) : Set :=
  { w ∈ Module.carrier(M) | ∃ v ∈ Module.carrier(M),
    w = call2(Module.smul(M), a, v) }

def torsionBy (M R r : Set) : Set :=
  { v ∈ Module.carrier(M) | call2(Module.smul(M), r, v) = Module.zero(M) }

-- Section: Laws of the ideal operations
-- Helper: the ideals avoiding a set S, as a family of subsets of R.
def avoidingIdeals (R S : Set) : Set :=
  { J ∈ 𝒫(Ring.carrier(R)) | Ideal(R, J) ∧ (∀ s ∈ S, s ∉ J) }

-- Helper: the powers xⁿ of an element.
def elementPowers (R x : Set) : Set :=
  { y ∈ Ring.carrier(R) | ∃ n ∈ ℕ, y = Ring.pow(R, x, n) }

-- Helper: complements of the primes between I and P, a family of subsets
-- of R ordered by inclusion (reversing the order on the primes).
def primeComplementsBelow (R I P : Set) : Set :=
  { C ∈ 𝒫(Ring.carrier(R)) | PrimeIdeal(R, Ring.carrier(R) ∖ C) ∧
    I ⊆ Ring.carrier(R) ∖ C ∧ Ring.carrier(R) ∖ C ⊆ P }

-- Helper: the complement of a complement inside A.
theorem difference.double_of_subset (A B : Set)
  requires inside : B ⊆ A
  shows A ∖ (A ∖ B) = B
proof
  ext x
  constructor
  . intro h
    obtain ⟨xA, notIn⟩ := difference.membership.forward with h
    by_contra xB
    exact notIn with (difference.membership.backward with ⟨xA, xB⟩)
  . intro h
    have xA := inside with h
    have notIn : x ∉ A ∖ B
      intro m
      obtain ⟨_, xB⟩ := difference.membership.forward with m
      exact xB with h
    exact difference.membership.backward with ⟨xA, notIn⟩

section IdealOperations
variable (R : Set)
hypothesis comm : CommRing(R)

-- Ideal.span: generatedIdeal is the least ideal containing the set
-- (Ideal.subset_span, Ideal.span_le, Ideal.span_mono).
theorem generatedIdeal.subset_iff (G I : Set)
  requires bounded : G ⊆ R.carrier
  requires ideal : Ideal(R, I)
  shows generatedIdeal(R, G) ⊆ I ↔ G ⊆ I
proof
  constructor
  . intro h
    have contains := generatedIdeal.contains at R, G with comm, bounded
    exact Subset.transitive with contains, h
  . intro h
    exact generatedIdeal.least at R, G, I with comm, ideal, h

theorem generatedIdeal.mem_pair (a b x : R)
  shows x ∈ generatedIdeal(R, {a, b}) ↔
    (∃ u v ∈ R.carrier, x = u * a + v * b)
proof
  have aIn : a ∈ R.carrier by assumption
  have bIn : b ∈ R.carrier by assumption
  have xIn : x ∈ R.carrier by assumption
  have gen := generatedIdeal.ideal at R, {a, b} with comm
  have bounded : {a, b} ⊆ R.carrier
    intros y hy
    rcases pair.membership.forward with hy with ya | yb
    . rw ya
      exact aIn
    . rw yb
      exact bIn
  have contains := generatedIdeal.contains at R, {a, b} with comm, bounded
  constructor
  . intro h
    have sub := ringPairCombos.generated at R, a, b with comm
    have m := sub with h
    obtain ⟨_, u, uIn, v, vIn, law⟩ := ringPairCombos.membership.forward at R, a, b, x with m
    exact ⟨u, uIn, v, vIn, law⟩
  . intro h
    obtain ⟨u, uIn, v, vIn, law⟩ := h
    have aG := contains with (pair.left at a, b)
    have bG := contains with (pair.right at a, b)
    have m1 := Ideal.mul_left_mem at R, generatedIdeal(R, {a, b}), u, a with gen, *
    have m2 := Ideal.mul_left_mem at R, generatedIdeal(R, {a, b}), v, b with gen, *
    have sum := Ideal.add_mem at R, generatedIdeal(R, {a, b}), call2(R.mul, u, a), call2(R.mul, v, b) with gen, m1, m2
    rw law
    exact sum

-- Ideal.mem_span_range_iff_exists_fun: over a finite family g : n → R,
-- the members of the generated ideal are the combinations Σ c(i) g(i).
theorem generatedIdeal.mem_finite (n g x : Set)
  requires natural : Nat(n)
  requires family : g : n → R.carrier
  requires element : x ∈ R.carrier
  shows x ∈ generatedIdeal(R, functionImage(g, n, R.carrier)) ↔
    (∃ c, (c : n → R.carrier) ∧ x = moduleCombination(selfModule(R), R, n, c, g))
proof
  sorry

-- Ideal.span_zero, Ideal.span_singleton_one.
theorem generatedIdeal.empty
  shows generatedIdeal(R, ∅) = {R[0]}
proof
  have ringR := CommRing.to_ring with comm
  have zeroIdeal := Ideal.zero at R with ringR
  have none : ∅ ⊆ {R[0]} by exact empty.subset at {R[0]}
  have first := generatedIdeal.least at R, ∅, {R[0]} with comm, zeroIdeal, none
  have gen := generatedIdeal.ideal at R, ∅ with comm
  have z := Ideal.zero_mem at R, generatedIdeal(R, ∅) with gen
  have second := (singleton.subset_iff at R[0], generatedIdeal(R, ∅)).backward with z
  exact Subset.antisymmetric with first, second

-- An ideal generated by finitely many elements is finitely generated, and
-- a principal ideal is finitely generated.
theorem FinitelyGeneratedIdeal.of_finite (G : Set)
  requires bounded : G ⊆ R.carrier
  requires finite : Finite(G)
  shows FinitelyGeneratedIdeal(R, generatedIdeal(R, G))
proof
  have gen := generatedIdeal.ideal at R, G with comm
  exact ⟨gen, G, bounded, finite, rfl⟩

theorem PrincipalIdeal.finitely_generated (I : Set)
  requires principal : PrincipalIdeal(R, I)
  shows FinitelyGeneratedIdeal(R, I)
proof
  obtain ⟨ideal, a, aIn, ia⟩ := principal
  have gen := ringMultiples.generated at R, a with comm
  have bounded := (singleton.subset_iff at a, R.carrier).backward with aIn
  have finite := Finite.singleton at a
  rw ← gen at ia
  exact ⟨ideal, {a}, bounded, finite, ia⟩

-- Sums: an ideal, the least one containing both summands
-- (Ideal.mem_sup_left, mem_sup_right, sup_le), and the ideal generated
-- by the union.
theorem idealSum.ideal (I J : Set)
  requires first : Ideal(R, I)
  requires second : Ideal(R, J)
  shows Ideal(R, idealSum(R, I, J))
proof
  have ringR := CommRing.to_ring with comm
  apply Ideal.mk at R, idealSum(R, I, J) with ringR
  . intros z hz
    exact (idealSum.membership.forward at R, I, J, z with hz).left
  . have zeroIn : R[0] ∈ R.carrier by typecheck
    have z1 := Ideal.zero_mem at R, I with first
    have z2 := Ideal.zero_mem at R, J with second
    have law : R[0] = R[0] + R[0] by ring
    exact idealSum.membership.backward at R, I, J, R[0] with ⟨zeroIn, R[0], z1, R[0], z2, law⟩
  . intros z hz w hw
    obtain ⟨zIn, x, xI, y, yJ, zxy⟩ := idealSum.membership.forward at R, I, J, z with hz
    obtain ⟨wIn, s, sI, t, tJ, wst⟩ := idealSum.membership.forward at R, I, J, w with hw
    have xs := Ideal.add_mem at R, I, x, s with first, xI, sI
    have yt := Ideal.add_mem at R, J, y, t with second, yJ, tJ
    have xIn := Ideal.mem_carrier at R, I, x with first, xI
    have sIn := Ideal.mem_carrier at R, I, s with first, sI
    have yIn := Ideal.mem_carrier at R, J, y with second, yJ
    have tIn := Ideal.mem_carrier at R, J, t with second, tJ
    have sumIn : z + w ∈ R.carrier by typecheck
    have law : z + w = (x + s) + (y + t)
      rw [zxy, wst]
      ring
    exact idealSum.membership.backward at R, I, J, z + w with ⟨sumIn, x + s, xs, y + t, yt, law⟩
  . intros z hz
    obtain ⟨zIn, x, xI, y, yJ, zxy⟩ := idealSum.membership.forward at R, I, J, z with hz
    have nx := Ideal.neg_mem at R, I, x with first, xI
    have ny := Ideal.neg_mem at R, J, y with second, yJ
    have xIn := Ideal.mem_carrier at R, I, x with first, xI
    have yIn := Ideal.mem_carrier at R, J, y with second, yJ
    have negIn : -z ∈ R.carrier by typecheck
    have law : -z = (-x) + (-y)
      rw zxy
      ring
    exact idealSum.membership.backward at R, I, J, -z with ⟨negIn, -x, nx, -y, ny, law⟩
  . intros r hr z hz
    obtain ⟨zIn, x, xI, y, yJ, zxy⟩ := idealSum.membership.forward at R, I, J, z with hz
    have xIn := Ideal.mem_carrier at R, I, x with first, xI
    have yIn := Ideal.mem_carrier at R, J, y with second, yJ
    have rx := Ideal.mul_left_mem at R, I, r, x with first, hr, xI
    have ry := Ideal.mul_left_mem at R, J, r, y with second, hr, yJ
    have p1 : r * z ∈ R.carrier by typecheck
    have p2 : z * r ∈ R.carrier by typecheck
    have l1 : r * z = r * x + r * y
      rw zxy
      ring
    have l2 : z * r = r * x + r * y
      rw zxy
      ring
    have m1 := idealSum.membership.backward at R, I, J, r * z with ⟨p1, r * x, rx, r * y, ry, l1⟩
    have m2 := idealSum.membership.backward at R, I, J, z * r with ⟨p2, r * x, rx, r * y, ry, l2⟩
    exact ⟨m1, m2⟩

theorem idealSum.left_subset (I J : Set)
  requires first : Ideal(R, I)
  requires second : Ideal(R, J)
  shows I ⊆ idealSum(R, I, J) ∧ J ⊆ idealSum(R, I, J)
proof
  have z1 := Ideal.zero_mem at R, I with first
  have z2 := Ideal.zero_mem at R, J with second
  have s1 : I ⊆ idealSum(R, I, J)
    intros x xI
    have xIn := Ideal.mem_carrier at R, I, x with first, xI
    have law : x = x + R[0] by ring
    exact idealSum.membership.backward at R, I, J, x with ⟨xIn, x, xI, R[0], z2, law⟩
  have s2 : J ⊆ idealSum(R, I, J)
    intros y yJ
    have yIn := Ideal.mem_carrier at R, J, y with second, yJ
    have law : y = R[0] + y by ring
    exact idealSum.membership.backward at R, I, J, y with ⟨yIn, R[0], z1, y, yJ, law⟩
  exact ⟨s1, s2⟩

theorem idealSum.least (I J K : Set)
  requires first : Ideal(R, I)
  requires second : Ideal(R, J)
  requires third : Ideal(R, K)
  shows idealSum(R, I, J) ⊆ K ↔ I ⊆ K ∧ J ⊆ K
proof
  obtain ⟨s1, s2⟩ := idealSum.left_subset at R, I, J with comm, first, second
  constructor
  . intro h
    have a := Subset.transitive with s1, h
    have b := Subset.transitive with s2, h
    exact ⟨a, b⟩
  . intro h
    obtain ⟨ik, jk⟩ := h
    intros z hz
    obtain ⟨zIn, x, xI, y, yJ, zxy⟩ := idealSum.membership.forward at R, I, J, z with hz
    have xK := ik with xI
    have yK := jk with yJ
    rw zxy
    exact Ideal.add_mem at R, K, x, y with third, xK, yK

theorem idealSum.generated (I J : Set)
  requires first : Ideal(R, I)
  requires second : Ideal(R, J)
  shows idealSum(R, I, J) = generatedIdeal(R, I ∪ J)
proof
  have sumIdeal := idealSum.ideal at R, I, J with comm, first, second
  obtain ⟨s1, s2⟩ := idealSum.left_subset at R, I, J with comm, first, second
  have bI := Ideal.subset at R, I with first
  have bJ := Ideal.subset at R, J with second
  have bounded := union2.subset at I, J, R.carrier with bI, bJ
  have gen := generatedIdeal.ideal at R, I ∪ J with comm
  have contains := generatedIdeal.contains at R, I ∪ J with comm, bounded
  have u1 := union2.subset_left at I, J
  have u2 := union2.subset_right at I, J
  have g1 := Subset.transitive with u1, contains
  have g2 := Subset.transitive with u2, contains
  have first2 := (idealSum.least at R, I, J, generatedIdeal(R, I ∪ J) with comm, first, second, gen).backward with ⟨g1, g2⟩
  have both := union2.subset at I, J, idealSum(R, I, J) with s1, s2
  have second2 := generatedIdeal.least at R, I ∪ J, idealSum(R, I, J) with comm, sumIdeal, both
  exact Subset.antisymmetric with first2, second2

theorem idealSum.comm (I J : Set)
  requires first : Ideal(R, I)
  requires second : Ideal(R, J)
  shows idealSum(R, I, J) = idealSum(R, J, I)
proof
  have a := idealSum.generated at R, I, J with comm, first, second
  have b := idealSum.generated at R, J, I with comm, second, first
  have u := union2.commutative at I, J
  rw [a, b, u]

-- Ideal.span_insert and Ideal.mem_span_pair: the ideal generated by
-- G ∪ {a} is (G) + (a); membership in (a, b) is x = u a + v b.
theorem generatedIdeal.insert (G a : Set)
  requires bounded : G ⊆ R.carrier
  requires member : a ∈ R.carrier
  shows generatedIdeal(R, G ∪ {a}) =
    idealSum(R, generatedIdeal(R, G), ringMultiples(R, a))
proof
  have aB := (singleton.subset_iff at a, R.carrier).backward with member
  have bounded2 := union2.subset at G, {a}, R.carrier with bounded, aB
  have gen := generatedIdeal.ideal at R, G ∪ {a} with comm
  have gG := generatedIdeal.ideal at R, G with comm
  have ma := ringMultiples.ideal at R, a with comm
  have sumIdeal := idealSum.ideal at R, generatedIdeal(R, G), ringMultiples(R, a) with comm, gG, ma
  obtain ⟨l1, l2⟩ := idealSum.left_subset at R, generatedIdeal(R, G), ringMultiples(R, a) with comm, gG, ma
  have cG := generatedIdeal.contains at R, G with comm, bounded
  have u1 := Subset.transitive with cG, l1
  have aS := l2 with (ringMultiples.self_mem at R, a with comm)
  have u2 := (singleton.subset_iff at a, idealSum(R, generatedIdeal(R, G), ringMultiples(R, a))).backward with aS
  have both := union2.subset at G, {a}, idealSum(R, generatedIdeal(R, G), ringMultiples(R, a)) with u1, u2
  have s1 := generatedIdeal.least at R, G ∪ {a}, idealSum(R, generatedIdeal(R, G), ringMultiples(R, a)) with comm, sumIdeal, both
  have contains := generatedIdeal.contains at R, G ∪ {a} with comm, bounded2
  have m1 := generatedIdeal.mono at R, G, G ∪ {a} with comm, (union2.subset_left at G, {a}), bounded2
  have aIn := contains with (union2.subset_right at G, {a}) with (singleton.self at a)
  have m2 := (ringMultiples.subset_ideal_iff at R, a, generatedIdeal(R, G ∪ {a}) with comm, member, gen).backward with aIn
  have s2 := (idealSum.least at R, generatedIdeal(R, G), ringMultiples(R, a), generatedIdeal(R, G ∪ {a}) with comm, gG, ma, gen).backward with ⟨m1, m2⟩
  exact Subset.antisymmetric with s1, s2

theorem Ideal.intersection (I J : Set)
  requires first : Ideal(R, I)
  requires second : Ideal(R, J)
  shows Ideal(R, I ∩ J)
proof
  have ringR := CommRing.to_ring with comm
  apply Ideal.mk at R, I ∩ J with ringR
  . have bI := Ideal.subset at R, I with first
    have i := intersection.subset_left at I, J
    exact Subset.transitive with i, bI
  . have z1 := Ideal.zero_mem at R, I with first
    have z2 := Ideal.zero_mem at R, J with second
    exact (intersection.membership at I, J, R[0]).backward with ⟨z1, z2⟩
  . intros x hx y hy
    obtain ⟨xI, xJ⟩ := (intersection.membership at I, J, x).forward with hx
    obtain ⟨yI, yJ⟩ := (intersection.membership at I, J, y).forward with hy
    have a := Ideal.add_mem at R, I, x, y with first, xI, yI
    have b := Ideal.add_mem at R, J, x, y with second, xJ, yJ
    exact (intersection.membership at I, J, call2(R.add, x, y)).backward with ⟨a, b⟩
  . intros x hx
    obtain ⟨xI, xJ⟩ := (intersection.membership at I, J, x).forward with hx
    have a := Ideal.neg_mem at R, I, x with first, xI
    have b := Ideal.neg_mem at R, J, x with second, xJ
    exact (intersection.membership at I, J, apply(R.neg, x)).backward with ⟨a, b⟩
  . intros r hr x hx
    obtain ⟨xI, xJ⟩ := (intersection.membership at I, J, x).forward with hx
    have a1 := Ideal.mul_left_mem at R, I, r, x with first, hr, xI
    have b1 := Ideal.mul_left_mem at R, J, r, x with second, hr, xJ
    have a2 := Ideal.mul_right_mem at R, I, r, x with first, hr, xI
    have b2 := Ideal.mul_right_mem at R, J, r, x with second, hr, xJ
    have m1 := (intersection.membership at I, J, call2(R.mul, r, x)).backward with ⟨a1, b1⟩
    have m2 := (intersection.membership at I, J, call2(R.mul, x, r)).backward with ⟨a2, b2⟩
    exact ⟨m1, m2⟩

-- Products: an ideal inside the intersection (Ideal.mul_le_inf), with the
-- products x y as members (Ideal.mul_mem_mul), the least ideal containing
-- them (Ideal.mul_le), commutative, associative, distributive over sums
-- (Ideal.sup_mul), with R as unit (Ideal.mul_top), monotone
-- (Ideal.mul_mono), and generated by products of generators
-- (Ideal.span_mul_span).
theorem idealProduct.ideal (I J : Set)
  shows Ideal(R, idealProduct(R, I, J))
proof
  unfold idealProduct
  exact generatedIdeal.ideal at R, idealProductGenerators(R, I, J) with comm

theorem idealProductGenerators.bounded (I J : Set)
  shows idealProductGenerators(R, I, J) ⊆ R.carrier
proof
  intros z hz
  exact (idealProductGenerators.membership.forward at R, I, J, z with hz).left

theorem idealProduct.mul_mem (I J x y : Set)
  requires first : Ideal(R, I)
  requires second : Ideal(R, J)
  requires xIn : x ∈ I
  requires yIn : y ∈ J
  shows call2(R.mul, x, y) ∈ idealProduct(R, I, J)
proof
  have xR := Ideal.mem_carrier at R, I, x with first, xIn
  have yR := Ideal.mem_carrier at R, J, y with second, yIn
  have pIn : x * y ∈ R.carrier by typecheck
  have g := idealProductGenerators.membership.backward at R, I, J, x * y with ⟨pIn, x, xIn, y, yIn, rfl⟩
  have bounded := idealProductGenerators.bounded at R, I, J with comm
  have contains := generatedIdeal.contains at R, idealProductGenerators(R, I, J) with comm, bounded
  unfold idealProduct
  exact contains with g

theorem idealProduct.least (I J K : Set)
  requires first : Ideal(R, I)
  requires second : Ideal(R, J)
  requires third : Ideal(R, K)
  shows idealProduct(R, I, J) ⊆ K ↔
    (∀ x ∈ I, ∀ y ∈ J, call2(R.mul, x, y) ∈ K)
proof
  constructor
  . intro h
    intros x xI y yJ
    have m := idealProduct.mul_mem at R, I, J, x, y with comm, first, second, xI, yJ
    exact h with m
  . intro h
    have sub : idealProductGenerators(R, I, J) ⊆ K
      intros z hz
      obtain ⟨zIn, x, xI, y, yJ, zxy⟩ := idealProductGenerators.membership.forward at R, I, J, z with hz
      rw zxy
      exact h with x, xI, y, yJ
    unfold idealProduct
    exact generatedIdeal.least at R, idealProductGenerators(R, I, J), K with comm, third, sub

theorem idealProduct.comm_of_ideals (I J : Set)
  requires first : Ideal(R, I)
  requires second : Ideal(R, J)
  shows idealProduct(R, I, J) ⊆ idealProduct(R, J, I)
proof
  have pIdeal := idealProduct.ideal at R, J, I with comm
  apply (idealProduct.least at R, I, J, idealProduct(R, J, I) with comm, first, second, pIdeal).backward
  intros x xI y yJ
  have xIn := Ideal.mem_carrier at R, I, x with first, xI
  have yIn := Ideal.mem_carrier at R, J, y with second, yJ
  have m := idealProduct.mul_mem at R, J, I, y, x with comm, second, first, yJ, xI
  have law : x * y = y * x by ring
  rw law
  exact m

-- Colon ideals (Submodule.colon, Ideal.le_colon).
theorem idealColon.ideal (I J : Set)
  requires first : Ideal(R, I)
  requires second : J ⊆ R.carrier
  shows Ideal(R, idealColon(R, I, J))
proof
  have ringR := CommRing.to_ring with comm
  apply Ideal.mk at R, idealColon(R, I, J) with ringR
  . intros z hz
    exact (idealColon.membership.forward at R, I, J, z with hz).left
  . have zeroIn : R[0] ∈ R.carrier by typecheck
    have all : ∀ y ∈ J, R[0] * y ∈ I
      intros y yJ
      have yIn := second with yJ
      have e : R[0] * y = R[0] by ring
      rw e
      exact Ideal.zero_mem at R, I with first
    exact idealColon.membership.backward at R, I, J, R[0] with ⟨zeroIn, all⟩
  . intros x hx z hz
    obtain ⟨xIn, ax⟩ := idealColon.membership.forward at R, I, J, x with hx
    obtain ⟨zIn, az⟩ := idealColon.membership.forward at R, I, J, z with hz
    have sIn : x + z ∈ R.carrier by typecheck
    have all : ∀ y ∈ J, (x + z) * y ∈ I
      intros y yJ
      have yIn := second with yJ
      have e : (x + z) * y = x * y + z * y by ring
      rw e
      exact Ideal.add_mem at R, I, x * y, z * y with first, (ax with y, yJ), (az with y, yJ)
    exact idealColon.membership.backward at R, I, J, x + z with ⟨sIn, all⟩
  . intros x hx
    obtain ⟨xIn, ax⟩ := idealColon.membership.forward at R, I, J, x with hx
    have nIn : -x ∈ R.carrier by typecheck
    have all : ∀ y ∈ J, (-x) * y ∈ I
      intros y yJ
      have yIn := second with yJ
      have e : (-x) * y = -(x * y) by ring
      rw e
      exact Ideal.neg_mem at R, I, x * y with first, (ax with y, yJ)
    exact idealColon.membership.backward at R, I, J, -x with ⟨nIn, all⟩
  . intros r hr x hx
    obtain ⟨xIn, ax⟩ := idealColon.membership.forward at R, I, J, x with hx
    have p1 : r * x ∈ R.carrier by typecheck
    have p2 : x * r ∈ R.carrier by typecheck
    have all1 : ∀ y ∈ J, (r * x) * y ∈ I
      intros y yJ
      have yIn := second with yJ
      have e : (r * x) * y = r * (x * y) by ring
      rw e
      exact Ideal.mul_left_mem at R, I, r, x * y with first, hr, (ax with y, yJ)
    have all2 : ∀ y ∈ J, (x * r) * y ∈ I
      intros y yJ
      have yIn := second with yJ
      have e : (x * r) * y = r * (x * y) by ring
      rw e
      exact Ideal.mul_left_mem at R, I, r, x * y with first, hr, (ax with y, yJ)
    have m1 := idealColon.membership.backward at R, I, J, r * x with ⟨p1, all1⟩
    have m2 := idealColon.membership.backward at R, I, J, x * r with ⟨p2, all2⟩
    exact ⟨m1, m2⟩

theorem idealProduct.subset_intersection (I J : Set)
  requires first : Ideal(R, I)
  requires second : Ideal(R, J)
  shows idealProduct(R, I, J) ⊆ I ∩ J
proof
  have inter := Ideal.intersection at R, I, J with comm, first, second
  apply (idealProduct.least at R, I, J, I ∩ J with comm, first, second, inter).backward
  intros x xI y yJ
  have a := Ideal.mul_right_mem at R, I, y, x with first, *
  have b := Ideal.mul_left_mem at R, J, x, y with second, *
  exact (intersection.membership at I, J, call2(R.mul, x, y)).backward with ⟨a, b⟩

theorem idealProduct.mono (I J K L : Set)
  requires first : I ⊆ K
  requires second : J ⊆ L
  shows idealProduct(R, I, J) ⊆ idealProduct(R, K, L)
proof
  have bounded := idealProductGenerators.bounded at R, K, L with comm
  have sub : idealProductGenerators(R, I, J) ⊆ idealProductGenerators(R, K, L)
    intros z hz
    obtain ⟨zIn, x, xI, y, yJ, zxy⟩ := idealProductGenerators.membership.forward at R, I, J, z with hz
    have xK := first with xI
    have yL := second with yJ
    exact idealProductGenerators.membership.backward at R, K, L, z with ⟨zIn, x, xK, y, yL, zxy⟩
  unfold idealProduct
  exact generatedIdeal.mono at R, idealProductGenerators(R, I, J), idealProductGenerators(R, K, L) with comm, sub, bounded

theorem idealProduct.comm (I J : Set)
  requires first : Ideal(R, I)
  requires second : Ideal(R, J)
  shows idealProduct(R, I, J) = idealProduct(R, J, I)
proof
  have a := idealProduct.comm_of_ideals at R, I, J with comm, first, second
  have b := idealProduct.comm_of_ideals at R, J, I with comm, second, first
  exact Subset.antisymmetric with a, b

-- Helper: (I J) K ⊆ L once every (x y) z lies in L.
theorem idealProduct.subset_of_triples (I J K L : Set)
  requires first : Ideal(R, I)
  requires second : Ideal(R, J)
  requires third : Ideal(R, K)
  requires target : Ideal(R, L)
  requires triples : ∀ x ∈ I, ∀ y ∈ J, ∀ z ∈ K, (x * y) * z ∈ L
  shows idealProduct(R, idealProduct(R, I, J), K) ⊆ L
proof
  have ij := idealProduct.ideal at R, I, J with comm
  apply (idealProduct.least at R, idealProduct(R, I, J), K, L with comm, ij, third, target).backward
  intros w wIJ z zK
  have zIn := Ideal.mem_carrier at R, K, z with third, zK
  have zb := (singleton.subset_iff at z, R.carrier).backward with zIn
  have col := idealColon.ideal at R, L, {z} with comm, target, zb
  have sub : idealProduct(R, I, J) ⊆ idealColon(R, L, {z})
    apply (idealProduct.least at R, I, J, idealColon(R, L, {z}) with comm, first, second, col).backward
    intros x xI y yJ
    have xIn := Ideal.mem_carrier at R, I, x with first, xI
    have yIn := Ideal.mem_carrier at R, J, y with second, yJ
    have pIn : x * y ∈ R.carrier by typecheck
    have all : ∀ v ∈ {z}, (x * y) * v ∈ L
      intros v hv
      have vz := singleton.membership.forward with hv
      rw vz
      exact triples with x, xI, y, yJ, z, zK
    exact idealColon.membership.backward at R, L, {z}, x * y with ⟨pIn, all⟩
  have wC := sub with wIJ
  obtain ⟨_, aw⟩ := idealColon.membership.forward at R, L, {z}, w with wC
  exact aw with z, (singleton.self at z)

theorem idealProduct.assoc (I J K : Set)
  requires first : Ideal(R, I)
  requires second : Ideal(R, J)
  requires third : Ideal(R, K)
  shows idealProduct(R, idealProduct(R, I, J), K) =
    idealProduct(R, I, idealProduct(R, J, K))
proof
  have ij := idealProduct.ideal at R, I, J with comm
  have jk := idealProduct.ideal at R, J, K with comm
  have left := idealProduct.ideal at R, idealProduct(R, I, J), K with comm
  have right := idealProduct.ideal at R, I, idealProduct(R, J, K) with comm
  have t1 : ∀ x ∈ I, ∀ y ∈ J, ∀ z ∈ K, (x * y) * z ∈ idealProduct(R, I, idealProduct(R, J, K))
    intros x xI y yJ z zK
    have xIn := Ideal.mem_carrier at R, I, x with first, xI
    have yIn := Ideal.mem_carrier at R, J, y with second, yJ
    have zIn := Ideal.mem_carrier at R, K, z with third, zK
    have yz := idealProduct.mul_mem at R, J, K, y, z with comm, second, third, yJ, zK
    have m := idealProduct.mul_mem at R, I, idealProduct(R, J, K), x, y * z with comm, first, jk, xI, yz
    have e : (x * y) * z = x * (y * z) by ring
    rw e
    exact m
  have s1 := idealProduct.subset_of_triples at R, I, J, K, idealProduct(R, I, idealProduct(R, J, K)) with comm, first, second, third, right, t1
  have t2 : ∀ y ∈ J, ∀ z ∈ K, ∀ x ∈ I, (y * z) * x ∈ idealProduct(R, idealProduct(R, I, J), K)
    intros y yJ z zK x xI
    have xIn := Ideal.mem_carrier at R, I, x with first, xI
    have yIn := Ideal.mem_carrier at R, J, y with second, yJ
    have zIn := Ideal.mem_carrier at R, K, z with third, zK
    have xy := idealProduct.mul_mem at R, I, J, x, y with comm, first, second, xI, yJ
    have m := idealProduct.mul_mem at R, idealProduct(R, I, J), K, x * y, z with comm, ij, third, xy, zK
    have e : (y * z) * x = (x * y) * z by ring
    rw e
    exact m
  have s2b := idealProduct.subset_of_triples at R, J, K, I, idealProduct(R, idealProduct(R, I, J), K) with comm, second, third, first, left, t2
  have c := idealProduct.comm at R, I, idealProduct(R, J, K) with comm, first, jk
  rw ← c at s2b
  exact Subset.antisymmetric with s1, s2b

theorem idealProduct.sum_left (I J K : Set)
  requires first : Ideal(R, I)
  requires second : Ideal(R, J)
  requires third : Ideal(R, K)
  shows idealProduct(R, idealSum(R, I, J), K) =
    idealSum(R, idealProduct(R, I, K), idealProduct(R, J, K))
proof
  have ij := idealSum.ideal at R, I, J with comm, first, second
  have ik := idealProduct.ideal at R, I, K with comm
  have jk := idealProduct.ideal at R, J, K with comm
  have target := idealSum.ideal at R, idealProduct(R, I, K), idealProduct(R, J, K) with comm, ik, jk
  obtain ⟨l1, l2⟩ := idealSum.left_subset at R, I, J with comm, first, second
  obtain ⟨t1, t2⟩ := idealSum.left_subset at R, idealProduct(R, I, K), idealProduct(R, J, K) with comm, ik, jk
  have s1 : idealProduct(R, idealSum(R, I, J), K) ⊆ idealSum(R, idealProduct(R, I, K), idealProduct(R, J, K))
    apply (idealProduct.least at R, idealSum(R, I, J), K, idealSum(R, idealProduct(R, I, K), idealProduct(R, J, K)) with comm, ij, third, target).backward
    intros w wIJ z zK
    obtain ⟨wIn, x, xI, y, yJ, wxy⟩ := idealSum.membership.forward at R, I, J, w with wIJ
    have xIn := Ideal.mem_carrier at R, I, x with first, xI
    have yIn := Ideal.mem_carrier at R, J, y with second, yJ
    have zIn := Ideal.mem_carrier at R, K, z with third, zK
    have a := t1 with (idealProduct.mul_mem at R, I, K, x, z with comm, first, third, xI, zK)
    have b := t2 with (idealProduct.mul_mem at R, J, K, y, z with comm, second, third, yJ, zK)
    have s := Ideal.add_mem at R, idealSum(R, idealProduct(R, I, K), idealProduct(R, J, K)), x * z, y * z with target, a, b
    have e : w * z = x * z + y * z
      rw wxy
      ring
    rw e
    exact s
  have big := idealProduct.ideal at R, idealSum(R, I, J), K with comm
  have m1 := idealProduct.mono at R, I, K, idealSum(R, I, J), K with comm, l1, (Subset.reflexive at K)
  have m2 := idealProduct.mono at R, J, K, idealSum(R, I, J), K with comm, l2, (Subset.reflexive at K)
  have s2 := (idealSum.least at R, idealProduct(R, I, K), idealProduct(R, J, K), idealProduct(R, idealSum(R, I, J), K) with comm, ik, jk, big).backward with ⟨m1, m2⟩
  exact Subset.antisymmetric with s1, s2

theorem idealProduct.whole (I : Set)
  requires ideal : Ideal(R, I)
  shows idealProduct(R, I, R.carrier) = I
proof
  have ringR := CommRing.to_ring with comm
  have whole := Ideal.whole at R with ringR
  have first := (idealProduct.least at R, I, R.carrier, I with comm, ideal, whole, ideal).backward
  have s1 : idealProduct(R, I, R.carrier) ⊆ I
    apply first
    intros x xI y yR
    exact Ideal.mul_right_mem at R, I, y, x with ideal, *
  have s2 : I ⊆ idealProduct(R, I, R.carrier)
    intros x xI
    have xIn := Ideal.mem_carrier at R, I, x with ideal, xI
    have oneIn : R[1] ∈ R.carrier by typecheck
    have m := idealProduct.mul_mem at R, I, R.carrier, x, R[1] with comm, ideal, whole, xI, oneIn
    have law : x * R[1] = x by ring
    rw law at m
    exact m
  exact Subset.antisymmetric with s1, s2

theorem idealProduct.generated (G H : Set)
  requires first : G ⊆ R.carrier
  requires second : H ⊆ R.carrier
  shows idealProduct(R, generatedIdeal(R, G), generatedIdeal(R, H)) =
    generatedIdeal(R, idealProductGenerators(R, G, H))
proof
  have idG := generatedIdeal.ideal at R, G with comm
  have idH := generatedIdeal.ideal at R, H with comm
  have cG := generatedIdeal.contains at R, G with comm, first
  have cH := generatedIdeal.contains at R, H with comm, second
  have T := generatedIdeal.ideal at R, idealProductGenerators(R, G, H) with comm
  have bT := idealProductGenerators.bounded at R, G, H with comm
  have cT := generatedIdeal.contains at R, idealProductGenerators(R, G, H) with comm, bT
  have step1 : ∀ g ∈ G, ∀ y ∈ generatedIdeal(R, H), y * g ∈ generatedIdeal(R, idealProductGenerators(R, G, H))
    intros g gG
    have gIn := first with gG
    have gb := (singleton.subset_iff at g, R.carrier).backward with gIn
    have col := idealColon.ideal at R, generatedIdeal(R, idealProductGenerators(R, G, H)), {g} with comm, T, gb
    have sub : H ⊆ idealColon(R, generatedIdeal(R, idealProductGenerators(R, G, H)), {g})
      intros h hH
      have hIn := second with hH
      have all : ∀ v ∈ {g}, h * v ∈ generatedIdeal(R, idealProductGenerators(R, G, H))
        intros v hv
        have vg := singleton.membership.forward with hv
        rw vg
        have pIn : g * h ∈ R.carrier by typecheck
        have gen := idealProductGenerators.membership.backward at R, G, H, g * h with ⟨pIn, g, gG, h, hH, rfl⟩
        have e : h * g = g * h by ring
        rw e
        exact cT with gen
      exact idealColon.membership.backward at R, generatedIdeal(R, idealProductGenerators(R, G, H)), {g}, h with ⟨hIn, all⟩
    have big := generatedIdeal.least at R, H, idealColon(R, generatedIdeal(R, idealProductGenerators(R, G, H)), {g}) with comm, col, sub
    intros y yH
    have yC := big with yH
    obtain ⟨_, ay⟩ := idealColon.membership.forward at R, generatedIdeal(R, idealProductGenerators(R, G, H)), {g}, y with yC
    exact ay with g, (singleton.self at g)
  have s1 : idealProduct(R, generatedIdeal(R, G), generatedIdeal(R, H)) ⊆ generatedIdeal(R, idealProductGenerators(R, G, H))
    apply (idealProduct.least at R, generatedIdeal(R, G), generatedIdeal(R, H), generatedIdeal(R, idealProductGenerators(R, G, H)) with comm, idG, idH, T).backward
    intros x xG y yH
    have yIn := Ideal.mem_carrier at R, generatedIdeal(R, H), y with idH, yH
    have yb := (singleton.subset_iff at y, R.carrier).backward with yIn
    have col := idealColon.ideal at R, generatedIdeal(R, idealProductGenerators(R, G, H)), {y} with comm, T, yb
    have sub : G ⊆ idealColon(R, generatedIdeal(R, idealProductGenerators(R, G, H)), {y})
      intros g gG
      have gIn := first with gG
      have all : ∀ v ∈ {y}, g * v ∈ generatedIdeal(R, idealProductGenerators(R, G, H))
        intros v hv
        have vy := singleton.membership.forward with hv
        rw vy
        have m := step1 with g, gG, y, yH
        have e : g * y = y * g by ring
        rw e
        exact m
      exact idealColon.membership.backward at R, generatedIdeal(R, idealProductGenerators(R, G, H)), {y}, g with ⟨gIn, all⟩
    have big := generatedIdeal.least at R, G, idealColon(R, generatedIdeal(R, idealProductGenerators(R, G, H)), {y}) with comm, col, sub
    have xC := big with xG
    obtain ⟨_, ax⟩ := idealColon.membership.forward at R, generatedIdeal(R, idealProductGenerators(R, G, H)), {y}, x with xC
    exact ax with y, (singleton.self at y)
  have pIdeal := idealProduct.ideal at R, generatedIdeal(R, G), generatedIdeal(R, H) with comm
  have sub2 : idealProductGenerators(R, G, H) ⊆ idealProduct(R, generatedIdeal(R, G), generatedIdeal(R, H))
    intros z hz
    obtain ⟨zIn, x, xG, y, yH, zxy⟩ := idealProductGenerators.membership.forward at R, G, H, z with hz
    rw zxy
    exact idealProduct.mul_mem at R, generatedIdeal(R, G), generatedIdeal(R, H), x, y with comm, idG, idH, (cG with xG), (cH with yH)
  have s2 := generatedIdeal.least at R, idealProductGenerators(R, G, H), idealProduct(R, generatedIdeal(R, G), generatedIdeal(R, H)) with comm, pIdeal, sub2
  exact Subset.antisymmetric with s1, s2

-- Ideal.span_singleton_mul_span_singleton.
theorem idealProduct.multiples (a b : R)
  shows idealProduct(R, ringMultiples(R, a), ringMultiples(R, b)) =
    ringMultiples(R, a * b)
proof
  have aIn : a ∈ R.carrier by assumption
  have bIn : b ∈ R.carrier by assumption
  have ia := ringMultiples.ideal at R, a with comm
  have ib := ringMultiples.ideal at R, b with comm
  have iab := ringMultiples.ideal at R, a * b with comm
  have s1 : idealProduct(R, ringMultiples(R, a), ringMultiples(R, b)) ⊆ ringMultiples(R, a * b)
    apply (idealProduct.least at R, ringMultiples(R, a), ringMultiples(R, b), ringMultiples(R, a * b) with comm, ia, ib, iab).backward
    intros x xa y yb
    obtain ⟨xIn, c, cIn, xc⟩ := ringMultiples.membership.forward at R, a, x with xa
    obtain ⟨yIn, d, dIn, yd⟩ := ringMultiples.membership.forward at R, b, y with yb
    have pIn : x * y ∈ R.carrier by typecheck
    have cdIn : c * d ∈ R.carrier by typecheck
    have law : x * y = (c * d) * (a * b)
      rw [xc, yd]
      ring
    exact ringMultiples.membership.backward at R, a * b, x * y with ⟨pIn, c * d, cdIn, law⟩
  have abP := idealProduct.mul_mem at R, ringMultiples(R, a), ringMultiples(R, b), a, b with comm, ia, ib, (ringMultiples.self_mem at R, a with comm), (ringMultiples.self_mem at R, b with comm)
  have abIn : a * b ∈ R.carrier by typecheck
  have pIdeal := idealProduct.ideal at R, ringMultiples(R, a), ringMultiples(R, b) with comm
  have s2 := (ringMultiples.subset_ideal_iff at R, a * b, idealProduct(R, ringMultiples(R, a), ringMultiples(R, b)) with comm, abIn, pIdeal).backward with abP
  exact Subset.antisymmetric with s1, s2

-- Coprime ideals: I + J = R gives I J = I ∩ J (Ideal.mul_eq_inf_of_coprime)
-- and powers stay coprime (Ideal.sup_pow_add_le_pow_sup_pow).
theorem idealProduct.coprime_eq_intersection (I J : Set)
  requires first : Ideal(R, I)
  requires second : Ideal(R, J)
  requires coprime : idealSum(R, I, J) = R.carrier
  shows idealProduct(R, I, J) = I ∩ J
proof
  have inter := Ideal.intersection at R, I, J with comm, first, second
  have s1 := idealProduct.subset_intersection at R, I, J with comm, first, second
  have s2 : I ∩ J ⊆ idealProduct(R, I, J)
    intros x hx
    obtain ⟨xI, xJ⟩ := (intersection.membership at I, J, x).forward with hx
    have xIn := Ideal.mem_carrier at R, I, x with first, xI
    have oneIn : R[1] ∈ R.carrier by typecheck
    rw ← coprime at oneIn
    obtain ⟨_, i, iI, j, jJ, law⟩ := idealSum.membership.forward at R, I, J, R[1] with oneIn
    have iIn := Ideal.mem_carrier at R, I, i with first, iI
    have jIn := Ideal.mem_carrier at R, J, j with second, jJ
    have m1 := idealProduct.mul_mem at R, I, J, i, x with comm, first, second, iI, xJ
    have m2 := idealProduct.mul_mem at R, I, J, x, j with comm, first, second, xI, jJ
    have pIdeal := idealProduct.ideal at R, I, J with comm
    have sum := Ideal.add_mem at R, idealProduct(R, I, J), call2(R.mul, i, x), call2(R.mul, x, j) with pIdeal, m1, m2
    have same : i * x + x * j = x
      have e : i * x + x * j = x * (i + j) by ring
      rw [e, ← law]
      ring
    rw same at sum
    exact sum
  exact Subset.antisymmetric with s1, s2

theorem idealPow.zero (I : Set)
  shows idealPow(R, I, 0) = R.carrier
proof
  simp [idealPow]

theorem idealPow.succ (I : Set) (n : Nat)
  shows idealPow(R, I, succ(n)) = idealProduct(R, idealPow(R, I, n), I)
proof
  simp [idealPow]

-- Powers: ideals, Iⁿ⁺¹ = Iⁿ I, decreasing in n (Ideal.pow_le_pow_right,
-- pow_le_self), xⁿ ∈ Iⁿ (Ideal.pow_mem_pow), Iᵐ Iⁿ = Iᵐ⁺ⁿ, and the
-- powers of a principal ideal (Ideal.span_singleton_pow).
theorem idealPow.ideal (I : Set) (n : Nat)
  requires ideal : Ideal(R, I)
  shows Ideal(R, idealPow(R, I, n))
proof
  have ringR := CommRing.to_ring with comm
  induction n
  | zero =>
    rw (idealPow.zero at R, I with comm)
    exact Ideal.whole at R with ringR
  | succ(k) using ih =>
    rw (idealPow.succ at R, I, k with comm)
    exact idealProduct.ideal at R, idealPow(R, I, k), I with comm

theorem idealPow.one (I : Set)
  requires ideal : Ideal(R, I)
  shows idealPow(R, I, 1) = I
proof
  have ringR := CommRing.to_ring with comm
  have whole := Ideal.whole at R with ringR
  have one : idealPow(R, I, 1) = idealProduct(R, R.carrier, I)
    have s := idealPow.succ at R, I, 0 with comm
    have z := idealPow.zero at R, I with comm
    rw z at s
    exact s
  rw one
  have w := idealProduct.whole at R, I with comm, ideal
  have a := idealProduct.comm_of_ideals at R, R.carrier, I with comm, whole, ideal
  have b := idealProduct.comm_of_ideals at R, I, R.carrier with comm, ideal, whole
  rw w at a
  rw w at b
  exact Subset.antisymmetric with a, b

theorem idealPow.antitone_add (I : Set) (m e : Nat)
  requires ideal : Ideal(R, I)
  shows idealPow(R, I, m + e) ⊆ idealPow(R, I, m)
proof
  induction e
  | zero =>
    have z : m + 0 = m by arith
    rw z
    exact Subset.reflexive at idealPow(R, I, m)
  | succ(k) using ih =>
    have s : m + succ(k) = succ(m + k) by arith
    rw s
    rw (idealPow.succ at R, I, m + k with comm)
    have pk := idealPow.ideal at R, I, m + k with comm, ideal
    have sub := idealProduct.subset_intersection at R, idealPow(R, I, m + k), I with comm, pk, ideal
    have left := intersection.subset_left at idealPow(R, I, m + k), I
    have step := Subset.transitive with sub, left
    exact Subset.transitive with step, ih

theorem idealPow.antitone (I : Set) (m n : Nat)
  requires ideal : Ideal(R, I)
  requires le : m ≤ n
  shows idealPow(R, I, n) ⊆ idealPow(R, I, m)
proof
  obtain ⟨d, dNat, nd⟩ := LessEqual.exists_add at m, n with le
  rw nd
  exact idealPow.antitone_add at R, I, m, d with comm, ideal

theorem idealPow.pow_mem (I x : Set) (n : Nat)
  requires ideal : Ideal(R, I)
  requires member : x ∈ I
  shows Ring.pow(R, x, n) ∈ idealPow(R, I, n)
proof
  have ringR := CommRing.to_ring with comm
  have xIn := Ideal.mem_carrier at R, I, x with ideal, member
  induction n
  | zero =>
    rw (idealPow.zero at R, I with comm)
    have z := Ring.pow_zero at R, x with ringR
    rw z
    typecheck
  | succ(k) using ih =>
    rw (idealPow.succ at R, I, k with comm)
    have shift := add.right_one at k with *
    rw ← shift
    have s := Ring.pow_succ at R, x, k with ringR
    rw s
    have pk := idealPow.ideal at R, I, k with comm, ideal
    exact idealProduct.mul_mem at R, idealPow(R, I, k), I, x ^ k, x with comm, pk, ideal, ih, member

theorem idealPow.add (I : Set) (m n : Nat)
  requires ideal : Ideal(R, I)
  shows idealProduct(R, idealPow(R, I, m), idealPow(R, I, n)) =
    idealPow(R, I, m + n)
proof
  induction n
  | zero =>
    have pm := idealPow.ideal at R, I, m with comm, ideal
    have z : m + 0 = m by arith
    rw [z, (idealPow.zero at R, I with comm)]
    exact idealProduct.whole at R, idealPow(R, I, m) with comm, pm
  | succ(k) using ih =>
    have pm := idealPow.ideal at R, I, m with comm, ideal
    have pk := idealPow.ideal at R, I, k with comm, ideal
    have s : m + succ(k) = succ(m + k) by arith
    rw [s, (idealPow.succ at R, I, k with comm), (idealPow.succ at R, I, m + k with comm)]
    have a := idealProduct.assoc at R, idealPow(R, I, m), idealPow(R, I, k), I with comm, pm, pk, ideal
    rw [← a, ih]

theorem idealPow.multiples (a : R) (n : Nat)
  shows idealPow(R, ringMultiples(R, a), n) = ringMultiples(R, a ^ n)
proof
  have aIn : a ∈ R.carrier by assumption
  have ringR := CommRing.to_ring with comm
  induction n
  | zero =>
    rw (idealPow.zero at R, ringMultiples(R, a) with comm)
    have z := Ring.pow_zero at R, a with ringR
    rw z
    have u := RingUnit.one at R with comm
    have w := (ringMultiples.eq_whole_iff at R, R[1] with comm).backward with u
    rw w
  | succ(k) using ih =>
    rw (idealPow.succ at R, ringMultiples(R, a), k with comm)
    rw ih
    have shift := add.right_one at k with *
    rw ← shift
    have s := Ring.pow_succ at R, a, k with ringR
    rw s
    exact idealProduct.multiples at R, a ^ k, a with comm

theorem idealPow.mono (I J : Set) (n : Nat)
  requires subset : I ⊆ J
  shows idealPow(R, I, n) ⊆ idealPow(R, J, n)
proof
  have ringR := CommRing.to_ring with comm
  induction n
  | zero =>
    rw [(idealPow.zero at R, I with comm), (idealPow.zero at R, J with comm)]
    exact Subset.reflexive at R.carrier
  | succ(k) using ih =>
    rw [(idealPow.succ at R, I, k with comm), (idealPow.succ at R, J, k with comm)]
    exact idealProduct.mono at R, idealPow(R, I, k), I, idealPow(R, J, k), J with comm, ih, subset

-- Helper: R + K = R.
theorem idealSum.whole_left (K : Set)
  requires ideal : Ideal(R, K)
  shows idealSum(R, R.carrier, K) = R.carrier
proof
  have ringR := CommRing.to_ring with comm
  have whole := Ideal.whole at R with ringR
  have sumIdeal := idealSum.ideal at R, R.carrier, K with comm, whole, ideal
  obtain ⟨s1, s2⟩ := idealSum.left_subset at R, R.carrier, K with comm, whole, ideal
  have oneIn : R[1] ∈ R.carrier by typecheck
  exact Ideal.contains_one at R, idealSum(R, R.carrier, K) with sumIdeal, (s1 with oneIn)

-- Helper: I + K = R and J + K = R give I J + K = R
-- (Ideal.IsCoprime.mul_left).
theorem idealSum.coprime_mul (I J K : Set)
  requires first : Ideal(R, I)
  requires second : Ideal(R, J)
  requires third : Ideal(R, K)
  requires left : idealSum(R, I, K) = R.carrier
  requires right : idealSum(R, J, K) = R.carrier
  shows idealSum(R, idealProduct(R, I, J), K) = R.carrier
proof
  have oneIn : R[1] ∈ R.carrier by typecheck
  have o1 := oneIn
  have o2 := oneIn
  rw ← left at o1
  rw ← right at o2
  obtain ⟨_, i, iI, k, kK, l1⟩ := idealSum.membership.forward at R, I, K, R[1] with o1
  obtain ⟨_, j, jJ, h, hK, l2⟩ := idealSum.membership.forward at R, J, K, R[1] with o2
  have iIn := Ideal.mem_carrier at R, I, i with first, iI
  have jIn := Ideal.mem_carrier at R, J, j with second, jJ
  have kIn := Ideal.mem_carrier at R, K, k with third, kK
  have hIn := Ideal.mem_carrier at R, K, h with third, hK
  have ij := idealProduct.mul_mem at R, I, J, i, j with comm, first, second, iI, jJ
  have a1 := Ideal.mul_right_mem at R, K, j, k with third, jIn, kK
  have a2 := Ideal.mul_left_mem at R, K, i, h with third, iIn, hK
  have a3 := Ideal.mul_right_mem at R, K, h, k with third, hIn, kK
  have a12 := Ideal.add_mem at R, K, k * j, i * h with third, a1, a2
  have rest := Ideal.add_mem at R, K, k * j + i * h, k * h with third, a12, a3
  have law : R[1] = i * j + (k * j + i * h + k * h)
    have e : R[1] = R[1] * R[1] by ring
    rw e
    rw l1 at e
    have e2 : R[1] * R[1] = (i + k) * (j + h)
      rw [← l1, ← l2]
    rw e2
    ring
  have pIdeal := idealProduct.ideal at R, I, J with comm
  have sumIdeal := idealSum.ideal at R, idealProduct(R, I, J), K with comm, pIdeal, third
  have m := idealSum.membership.backward at R, idealProduct(R, I, J), K, R[1] with ⟨oneIn, i * j, ij, k * j + i * h + k * h, rest, law⟩
  exact Ideal.contains_one at R, idealSum(R, idealProduct(R, I, J), K) with sumIdeal, m

-- Helper: I + J = R gives Iᵐ + J = R.
theorem idealSum.coprime_pow_left (I J : Set) (m : Nat)
  requires first : Ideal(R, I)
  requires second : Ideal(R, J)
  requires coprime : idealSum(R, I, J) = R.carrier
  shows idealSum(R, idealPow(R, I, m), J) = R.carrier
proof
  induction m
  | zero =>
    rw (idealPow.zero at R, I with comm)
    exact idealSum.whole_left at R, J with comm, second
  | succ(k) using ih =>
    rw (idealPow.succ at R, I, k with comm)
    have pk := idealPow.ideal at R, I, k with comm, first
    exact idealSum.coprime_mul at R, idealPow(R, I, k), I, J with comm, pk, first, second, ih, coprime

theorem idealSum.coprime_pow (I J : Set) (m n : Nat)
  requires first : Ideal(R, I)
  requires second : Ideal(R, J)
  requires coprime : idealSum(R, I, J) = R.carrier
  shows idealSum(R, idealPow(R, I, m), idealPow(R, J, n)) = R.carrier
proof
  have a := idealSum.coprime_pow_left at R, I, J, m with comm, first, second, coprime
  have pm := idealPow.ideal at R, I, m with comm, first
  have c1 := idealSum.comm at R, idealPow(R, I, m), J with comm, pm, second
  rw c1 at a
  have b := idealSum.coprime_pow_left at R, J, idealPow(R, I, m), n with comm, second, pm, a
  have pn := idealPow.ideal at R, J, n with comm, second
  have c2 := idealSum.comm at R, idealPow(R, J, n), idealPow(R, I, m) with comm, pn, pm
  rw c2 at b
  exact b

-- Finite products of ideals: an ideal, containing the products of members
-- (Ideal.prod_mem_prod), and for pairwise coprime ideals equal to the
-- intersection (Ideal.prod_eq_iInf_of_pairwise_isCoprime).
theorem idealFamilyProduct.ideal (I : Set) (n : Nat)
  requires ideals : ∀ k ∈ n, Ideal(R, I(k))
  shows Ideal(R, idealFamilyProduct(R, I, n))
proof
  have ringR := CommRing.to_ring with comm
  rcases natural.zero_or_successor at n with n0 | ⟨j, jNat, nj⟩
  . rw n0
    have e : idealFamilyProduct(R, I, 0) = R.carrier by simp [idealFamilyProduct]
    rw e
    exact Ideal.whole at R with ringR
  . rw nj
    have e : idealFamilyProduct(R, I, succ(j)) = idealProduct(R, idealFamilyProduct(R, I, j), I(j)) by simp [idealFamilyProduct]
    rw e
    exact idealProduct.ideal at R, idealFamilyProduct(R, I, j), I(j) with comm

theorem idealFamilyProduct.prod_mem (I x : Set) (n : Nat)
  requires ideals : ∀ k ∈ n, Ideal(R, I(k))
  requires family : x : n → R.carrier
  requires members : ∀ k ∈ n, x(k) ∈ I(k)
  shows finiteRingProduct(n, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, x) ∈
    idealFamilyProduct(R, I, n)
proof
  sorry

theorem idealFamilyProduct.coprime_eq_intersection (I : Set) (n : Nat)
  requires positive : 0 < n
  requires ideals : ∀ k ∈ n, Ideal(R, I(k))
  requires coprime : ∀ j k ∈ n, j ≠ k → idealSum(R, I(j), I(k)) = R.carrier
  shows idealFamilyProduct(R, I, n) = idealFamilyIntersection(R, n, I)
proof
  sorry

-- Intersections of ideals are ideals (Ideal.mem_iInf, Ideal.mem_sInf).
theorem idealFamilyIntersection.ideal (K I : Set)
  requires nonempty : K ≠ ∅
  requires ideals : ∀ k ∈ K, Ideal(R, I(k))
  shows Ideal(R, idealFamilyIntersection(R, K, I))
proof
  have ringR := CommRing.to_ring with comm
  apply Ideal.mk at R, idealFamilyIntersection(R, K, I) with ringR
  . intros z hz
    exact (idealFamilyIntersection.membership.forward at R, K, I, z with hz).left
  . have zeroIn : R[0] ∈ R.carrier by typecheck
    have all : ∀ k ∈ K, R[0] ∈ I(k)
      intros k kK
      exact Ideal.zero_mem at R, I(k) with (ideals with k, kK)
    exact idealFamilyIntersection.membership.backward at R, K, I, R[0] with ⟨zeroIn, all⟩
  . intros x hx y hy
    obtain ⟨xIn, ax⟩ := idealFamilyIntersection.membership.forward at R, K, I, x with hx
    obtain ⟨yIn, ay⟩ := idealFamilyIntersection.membership.forward at R, K, I, y with hy
    have sIn : x + y ∈ R.carrier by typecheck
    have all : ∀ k ∈ K, x + y ∈ I(k)
      intros k kK
      exact Ideal.add_mem at R, I(k), x, y with (ideals with k, kK), (ax with k, kK), (ay with k, kK)
    exact idealFamilyIntersection.membership.backward at R, K, I, x + y with ⟨sIn, all⟩
  . intros x hx
    obtain ⟨xIn, ax⟩ := idealFamilyIntersection.membership.forward at R, K, I, x with hx
    have nIn : -x ∈ R.carrier by typecheck
    have all : ∀ k ∈ K, -x ∈ I(k)
      intros k kK
      exact Ideal.neg_mem at R, I(k), x with (ideals with k, kK), (ax with k, kK)
    exact idealFamilyIntersection.membership.backward at R, K, I, -x with ⟨nIn, all⟩
  . intros r hr x hx
    obtain ⟨xIn, ax⟩ := idealFamilyIntersection.membership.forward at R, K, I, x with hx
    have p1 : r * x ∈ R.carrier by typecheck
    have p2 : x * r ∈ R.carrier by typecheck
    have all1 : ∀ k ∈ K, r * x ∈ I(k)
      intros k kK
      exact Ideal.mul_left_mem at R, I(k), r, x with (ideals with k, kK), hr, (ax with k, kK)
    have all2 : ∀ k ∈ K, x * r ∈ I(k)
      intros k kK
      exact Ideal.mul_right_mem at R, I(k), r, x with (ideals with k, kK), hr, (ax with k, kK)
    have m1 := idealFamilyIntersection.membership.backward at R, K, I, r * x with ⟨p1, all1⟩
    have m2 := idealFamilyIntersection.membership.backward at R, K, I, x * r with ⟨p2, all2⟩
    exact ⟨m1, m2⟩

theorem notSubset.witness (A B : Set)
  requires notSub : ¬(A ⊆ B)
  shows ∃ x ∈ A, x ∉ B
proof
  by_contra none
  have sub : A ⊆ B
    intros x xA
    by_contra xB
    exact none with ⟨x, xA, xB⟩
  exact notSub with sub

-- Prime ideals and products (Ideal.IsPrime.mul_le, IsPrime.pow_le_iff,
-- Ideal.IsPrime.prod_le).
theorem PrimeIdeal.product_subset_iff (P I J : Set)
  requires prime : PrimeIdeal(R, P)
  requires first : Ideal(R, I)
  requires second : Ideal(R, J)
  shows idealProduct(R, I, J) ⊆ P ↔ I ⊆ P ∨ J ⊆ P
proof
  have idP := PrimeIdeal.to_ideal at R, P with prime
  have ringR := CommRing.to_ring with comm
  constructor
  . intro h
    by_contra neither
    have notI : ¬(I ⊆ P)
      intro iP
      have both : I ⊆ P ∨ J ⊆ P by left; exact iP
      exact neither with both
    have notJ : ¬(J ⊆ P)
      intro jP
      have both : I ⊆ P ∨ J ⊆ P by right; exact jP
      exact neither with both
    obtain ⟨x, xI, xP⟩ := notSubset.witness at R, I, P with comm, notI
    obtain ⟨y, yJ, yP⟩ := notSubset.witness at R, J, P with comm, notJ
    have xIn := Ideal.mem_carrier at R, I, x with first, xI
    have yIn := Ideal.mem_carrier at R, J, y with second, yJ
    have m := idealProduct.mul_mem at R, I, J, x, y with comm, first, second, xI, yJ
    have mP := h with m
    rcases PrimeIdeal.mem_or_mem at R, P, x, y with ringR, prime, xIn, yIn, mP with a | b
    . exact xP with a
    . exact yP with b
  . intro h
    have sub := idealProduct.subset_intersection at R, I, J with comm, first, second
    cases h with iP | jP
    . have l := intersection.subset_left at I, J
      have t := Subset.transitive with sub, l
      exact Subset.transitive with t, iP
    . have r := intersection.subset_right at I, J
      have t := Subset.transitive with sub, r
      exact Subset.transitive with t, jP

theorem PrimeIdeal.avoid_family (P I : Set) (n : Nat)
  requires prime : PrimeIdeal(R, P)
  requires ideals : ∀ k ∈ n, Ideal(R, I(k))
  requires none : ∀ k ∈ n, ¬(I(k) ⊆ P)
  shows ∃ y ∈ R.carrier, y ∉ P ∧ (∀ k ∈ n, y ∈ I(k))
proof
  have ringR := CommRing.to_ring with comm
  induction n
  | zero =>
    intros ideals0 none0
    have oneIn : R[1] ∈ R.carrier by typecheck
    have proper := PrimeIdeal.to_proper at R, P with prime
    have out := ProperIdeal.one_not_mem at R, P with proper
    have all : ∀ k ∈ 0, R[1] ∈ I(k)
      intros k k0
      exfalso
      have kNat := natural.member at 0 with k0
      have imp := Less.of_membership at k, 0
      have lt := imp with k0
      arith
    exact ⟨R[1], oneIn, out, all⟩
  | succ(m) using ih =>
    intros idealsS noneS
    have lift : ∀ k ∈ m, k ∈ succ(m)
      intros k km
      have kNat := natural.member at m with km
      have d : k ∈ m ∨ k = m by left; exact km
      exact (membership.successor at k, m).backward with d
    have mS : m ∈ succ(m)
      have d : m ∈ m ∨ m = m by right; rfl
      exact (membership.successor at m, m).backward with d
    have idealsM : ∀ k ∈ m, Ideal(R, I(k))
      intros k km
      exact idealsS with k, (lift with k, km)
    have noneM : ∀ k ∈ m, ¬(I(k) ⊆ P)
      intros k km
      exact noneS with k, (lift with k, km)
    obtain ⟨y, yIn, yP, yAll⟩ := ih with idealsM, noneM
    have notLast := noneS with m, mS
    obtain ⟨x, xI, xP⟩ := notSubset.witness at R, I(m), P with comm, notLast
    have idealLast := idealsS with m, mS
    have xIn := Ideal.mem_carrier at R, I(m), x with idealLast, xI
    have pIn : y * x ∈ R.carrier by typecheck
    have pOut : y * x ∉ P
      intro pP
      rcases PrimeIdeal.mem_or_mem at R, P, y, x with ringR, prime, yIn, xIn, pP with a | b
      . exact yP with a
      . exact xP with b
    have all : ∀ k ∈ succ(m), y * x ∈ I(k)
      intros k kS
      have kNat := natural.member at succ(m) with kS
      rcases (membership.successor at k, m).forward with kS with km | ke
      . have idk := idealsM with k, km
        exact Ideal.mul_right_mem at R, I(k), x, y with idk, xIn, (yAll with k, km)
      . rw ke
        exact Ideal.mul_left_mem at R, I(m), y, x with idealLast, yIn, xI
    exact ⟨y * x, pIn, pOut, all⟩

theorem PrimeIdeal.of_pow_subset (P I : Set) (n : Nat)
  requires prime : PrimeIdeal(R, P)
  requires ideal : Ideal(R, I)
  requires positive : 0 < n
  requires sub : idealPow(R, I, n) ⊆ P
  shows I ⊆ P
proof
  have ringR := CommRing.to_ring with comm
  induction n
  | zero =>
    intros pos0 h0
    exfalso
    arith
  | succ(k) using ih =>
    intros posS hS
    rw (idealPow.succ at R, I, k with comm) at hS
    have pk := idealPow.ideal at R, I, k with comm, ideal
    rcases (PrimeIdeal.product_subset_iff at R, P, idealPow(R, I, k), I with comm, prime, pk, ideal).forward with hS with left | right
    . rcases natural.zero_or_successor at k with k0 | ⟨j, jNat, kj⟩
      . rw k0 at left
        rw (idealPow.zero at R, I with comm) at left
        have oneIn : R[1] ∈ R.carrier by typecheck
        have proper := PrimeIdeal.to_proper at R, P with prime
        exfalso
        exact (ProperIdeal.one_not_mem at R, P with proper) with (left with oneIn)
      . have kPos : 0 < k by arith
        exact ih with kPos, left
    . exact right

theorem PrimeIdeal.pow_subset_iff (P I : Set) (n : Nat)
  requires prime : PrimeIdeal(R, P)
  requires ideal : Ideal(R, I)
  requires positive : 0 < n
  shows idealPow(R, I, n) ⊆ P ↔ I ⊆ P
proof
  constructor
  . intro h
    exact PrimeIdeal.of_pow_subset at R, P, I, n with comm, prime, ideal, positive, h
  . intro h
    have one : 1 ≤ n by arith
    have anti := idealPow.antitone at R, I, 1, n with comm, ideal, one
    have p1 := idealPow.one at R, I with comm, ideal
    rw p1 at anti
    exact Subset.transitive with anti, h

-- Prime avoidance in its simplest form: a prime containing a finite
-- intersection of ideals contains one of them (Ideal.IsPrime.inf_le').
theorem PrimeIdeal.intersection_subset_iff (P I : Set) (n : Nat)
  requires prime : PrimeIdeal(R, P)
  requires positive : 0 < n
  requires ideals : ∀ k ∈ n, Ideal(R, I(k))
  shows idealFamilyIntersection(R, n, I) ⊆ P ↔ (∃ k ∈ n, I(k) ⊆ P)
proof
  constructor
  . intro h
    by_contra noneEx
    have none : ∀ k ∈ n, ¬(I(k) ⊆ P)
      intros k kn sub
      exact noneEx with ⟨k, kn, sub⟩
    obtain ⟨y, yIn, yP, yAll⟩ := PrimeIdeal.avoid_family at R, P, I, n with comm, prime, ideals, none
    have yInt := idealFamilyIntersection.membership.backward at R, n, I, y with ⟨yIn, yAll⟩
    exact yP with (h with yInt)
  . intro h
    obtain ⟨k, kn, sub⟩ := h
    intros x hx
    obtain ⟨_, all⟩ := idealFamilyIntersection.membership.forward at R, n, I, x with hx
    exact sub with (all with k, kn)

-- Helper: (x + y)^(a + b) is a combination of x^a and y^b.
theorem Ring.add_pow_combos (x y : R) (n : Nat)
  shows ∀ a ∈ ℕ, ∀ b ∈ ℕ, a + b = n →
    Ring.pow(R, x + y, n) ∈ ringPairCombos(R, Ring.pow(R, x, a), Ring.pow(R, y, b))
proof
  have ringR := CommRing.to_ring with comm
  induction n
  | zero =>
    intros a aIn b bIn sum
    have aNat : Nat(a) by typecheck
    have bNat : Nat(b) by typecheck
    have a0 : a = 0 by arith
    have b0 : b = 0 by arith
    rw [a0, b0]
    have z1 := Ring.pow_zero at R, x + y with ringR
    have z2 := Ring.pow_zero at R, x with ringR
    have z3 := Ring.pow_zero at R, y with ringR
    rw [z1, z2, z3]
    have oneIn : R[1] ∈ R.carrier by typecheck
    have zeroIn : R[0] ∈ R.carrier by typecheck
    have law : R[1] = R[1] * R[1] + R[0] * R[1] by ring
    exact ringPairCombos.membership.backward at R, R[1], R[1], R[1] with ⟨oneIn, R[1], oneIn, R[0], zeroIn, law⟩
  | succ(k) using ih =>
    intros a aIn b bIn sum
    have aNat : Nat(a) by typecheck
    have bNat : Nat(b) by typecheck
    have shift := add.right_one at k with *
    rw ← shift
    have zeroIn : R[0] ∈ R.carrier by typecheck
    have tIn : (x + y) ^ (k + 1) ∈ R.carrier by typecheck
    have xaIn : x ^ a ∈ R.carrier by typecheck
    have ybIn : y ^ b ∈ R.carrier by typecheck
    rcases natural.zero_or_successor at a with a0 | ⟨a1, a1Nat, aa⟩
    . rw a0
      have z := Ring.pow_zero at R, x with ringR
      rw z
      have law : (x + y) ^ (k + 1) = (x + y) ^ (k + 1) * R[1] + R[0] * y ^ b by ring
      exact ringPairCombos.membership.backward at R, R[1], y ^ b, (x + y) ^ (k + 1) with ⟨tIn, (x + y) ^ (k + 1), tIn, R[0], zeroIn, law⟩
    . rcases natural.zero_or_successor at b with b0 | ⟨b1, b1Nat, bb⟩
      . rw b0
        have z := Ring.pow_zero at R, y with ringR
        rw z
        have law : (x + y) ^ (k + 1) = R[0] * x ^ a + (x + y) ^ (k + 1) * R[1] by ring
        exact ringPairCombos.membership.backward at R, x ^ a, R[1], (x + y) ^ (k + 1) with ⟨tIn, R[0], zeroIn, (x + y) ^ (k + 1), tIn, law⟩
      . have a1In : a1 ∈ ℕ by typecheck
        have b1In : b1 ∈ ℕ by typecheck
        have s1 : a1 + b = k by arith
        have s2 : a + b1 = k by arith
        have c1 := ih with a1, a1In, b, bIn, s1
        have c2 := ih with a, aIn, b1, b1In, s2
        obtain ⟨_, u, uIn, v, vIn, l1⟩ := ringPairCombos.membership.forward at R, x ^ a1, y ^ b, (x + y) ^ k with c1
        obtain ⟨_, s, sIn, t, tIn2, l2⟩ := ringPairCombos.membership.forward at R, x ^ a, y ^ b1, (x + y) ^ k with c2
        have pa : x ^ a = x ^ a1 * x
          have sa := add.right_one at a1 with *
          rw [aa, ← sa]
          exact Ring.pow_succ at R, x, a1 with ringR
        have pb : y ^ b = y ^ b1 * y
          have sb := add.right_one at b1 with *
          rw [bb, ← sb]
          exact Ring.pow_succ at R, y, b1 with ringR
        have pk := Ring.pow_succ at R, x + y, k with ringR
        have c1In : u + s * y ∈ R.carrier by typecheck
        have c2In : v * x + t ∈ R.carrier by typecheck
        have law : (x + y) ^ (k + 1) = (u + s * y) * x ^ a + (v * x + t) * y ^ b
          have split : (x + y) ^ (k + 1) = (x + y) ^ k * x + (x + y) ^ k * y
            rw pk
            ring
          rw split
          have e1 : (x + y) ^ k * x = (u * x ^ a1 + v * y ^ b) * x
            rw ← l1
          have e2 : (x + y) ^ k * y = (s * x ^ a + t * y ^ b1) * y
            rw ← l2
          rw [e1, e2]
          have e3 : (s * x ^ a + t * y ^ b1) * y = s * y * x ^ a + t * (y ^ b1 * y) by ring
          have e4 : (u * x ^ a1 + v * y ^ b) * x = u * (x ^ a1 * x) + v * x * y ^ b by ring
          rw [e3, e4, ← pa, ← pb]
          ring
        exact ringPairCombos.membership.backward at R, x ^ a, y ^ b, (x + y) ^ (k + 1) with ⟨tIn, u + s * y, c1In, v * x + t, c2In, law⟩

-- Radicals: an ideal containing I, idempotent and monotone
-- (Ideal.le_radical, radical_idem, radical_mono, radical_le_radical_iff);
-- prime ideals are radical; a power of a finitely generated ideal inside
-- the radical of J lies in J (Ideal.exists_pow_le_of_le_radical_of_fg).
theorem idealRadical.ideal (I : Set)
  requires ideal : Ideal(R, I)
  shows Ideal(R, idealRadical(R, I))
proof
  have ringR := CommRing.to_ring with comm
  apply Ideal.mk at R, idealRadical(R, I) with ringR
  . intros z hz
    exact (idealRadical.membership.forward at R, I, z with hz).left
  . have zeroIn : R[0] ∈ R.carrier by typecheck
    have zI := Ideal.zero_mem at R, I with ideal
    have p1 := Ring.pow_one at R, R[0] with ringR
    rw ← p1 at zI
    have oneN : 1 ∈ ℕ by typecheck
    exact idealRadical.membership.backward at R, I, R[0] with ⟨zeroIn, 1, oneN, zI⟩
  . intros x hx y hy
    obtain ⟨xIn, m, mIn, xm⟩ := idealRadical.membership.forward at R, I, x with hx
    obtain ⟨yIn, n, nIn, yn⟩ := idealRadical.membership.forward at R, I, y with hy
    have mNat : Nat(m) by typecheck
    have nNat : Nat(n) by typecheck
    have mnIn : m + n ∈ ℕ by typecheck
    have c := Ring.add_pow_combos at R, x, y, m + n with comm
    have cc := c with m, mIn, n, nIn, rfl
    obtain ⟨_, u, uIn, v, vIn, law⟩ := ringPairCombos.membership.forward at R, x ^ m, y ^ n, (x + y) ^ (m + n) with cc
    have t1 := Ideal.mul_left_mem at R, I, u, x ^ m with ideal, uIn, xm
    have t2 := Ideal.mul_left_mem at R, I, v, y ^ n with ideal, vIn, yn
    have s := Ideal.add_mem at R, I, u * x ^ m, v * y ^ n with ideal, t1, t2
    rw ← law at s
    have sumIn : x + y ∈ R.carrier by typecheck
    exact idealRadical.membership.backward at R, I, x + y with ⟨sumIn, m + n, mnIn, s⟩
  . intros x hx
    obtain ⟨xIn, m, mIn, xm⟩ := idealRadical.membership.forward at R, I, x with hx
    have mNat : Nat(m) by typecheck
    have negIn : -x ∈ R.carrier by typecheck
    have split := Ring.mul_pow_comm at R, -R[1], x, m with comm
    have e : -R[1] * x = -x by ring
    rw e at split
    have t := Ideal.mul_left_mem at R, I, (-R[1]) ^ m, x ^ m with ideal, *
    rw ← split at t
    exact idealRadical.membership.backward at R, I, -x with ⟨negIn, m, mIn, t⟩
  . intros r hr x hx
    obtain ⟨xIn, m, mIn, xm⟩ := idealRadical.membership.forward at R, I, x with hx
    have mNat : Nat(m) by typecheck
    have p1 : r * x ∈ R.carrier by typecheck
    have p2 : x * r ∈ R.carrier by typecheck
    have split := Ring.mul_pow_comm at R, r, x, m with comm
    have t := Ideal.mul_left_mem at R, I, r ^ m, x ^ m with ideal, *
    rw ← split at t
    have e : r * x = x * r by ring
    have m1 := idealRadical.membership.backward at R, I, r * x with ⟨p1, m, mIn, t⟩
    rw e at t
    have m2 := idealRadical.membership.backward at R, I, x * r with ⟨p2, m, mIn, t⟩
    exact ⟨m1, m2⟩

theorem idealRadical.subset (I : Set)
  requires ideal : Ideal(R, I)
  shows I ⊆ idealRadical(R, I)
proof
  have ringR := CommRing.to_ring with comm
  intros x xI
  have xIn := Ideal.mem_carrier at R, I, x with ideal, xI
  have p1 := Ring.pow_one at R, x with ringR
  rw ← p1 at xI
  have oneN : 1 ∈ ℕ by typecheck
  exact idealRadical.membership.backward at R, I, x with ⟨xIn, 1, oneN, xI⟩

theorem idealRadical.idempotent (I : Set)
  requires ideal : Ideal(R, I)
  shows idealRadical(R, idealRadical(R, I)) = idealRadical(R, I)
proof
  have ringR := CommRing.to_ring with comm
  have rad := idealRadical.ideal at R, I with comm, ideal
  have s2 := idealRadical.subset at R, idealRadical(R, I) with comm, rad
  have s1 : idealRadical(R, idealRadical(R, I)) ⊆ idealRadical(R, I)
    intros x hx
    obtain ⟨xIn, m, mIn, xm⟩ := idealRadical.membership.forward at R, idealRadical(R, I), x with hx
    obtain ⟨_, n, nIn, xmn⟩ := idealRadical.membership.forward at R, I, Ring.pow(R, x, m) with xm
    have mNat : Nat(m) by typecheck
    have nNat : Nat(n) by typecheck
    have pm := Ring.pow_mul at R, x, m, n with ringR
    rw ← pm at xmn
    have mnIn : m * n ∈ ℕ by typecheck
    exact idealRadical.membership.backward at R, I, x with ⟨xIn, m * n, mnIn, xmn⟩
  exact Subset.antisymmetric with s1, s2

theorem idealRadical.mono (I J : Set)
  requires subset : I ⊆ J
  shows idealRadical(R, I) ⊆ idealRadical(R, J)
proof
  intros x hx
  obtain ⟨xIn, m, mIn, xm⟩ := idealRadical.membership.forward at R, I, x with hx
  have xm2 := subset with xm
  exact idealRadical.membership.backward at R, J, x with ⟨xIn, m, mIn, xm2⟩

theorem idealRadical.subset_iff (I J : Set)
  requires first : Ideal(R, I)
  requires second : Ideal(R, J)
  shows idealRadical(R, I) ⊆ idealRadical(R, J) ↔ I ⊆ idealRadical(R, J)
proof
  have radJ := idealRadical.ideal at R, J with comm, second
  constructor
  . intro h
    have s := idealRadical.subset at R, I with comm, first
    exact Subset.transitive with s, h
  . intro h
    have m := idealRadical.mono at R, I, idealRadical(R, J) with comm, h
    have idem := idealRadical.idempotent at R, J with comm, second
    rw idem at m
    exact m

theorem PrimeIdeal.radical (P : Set)
  requires prime : PrimeIdeal(R, P)
  shows RadicalIdeal(R, P)
proof
  have ideal := PrimeIdeal.to_ideal at R, P with prime
  have s2 := idealRadical.subset at R, P with comm, ideal
  have s1 : idealRadical(R, P) ⊆ P
    intros x hx
    obtain ⟨xIn, m, mIn, xm⟩ := idealRadical.membership.forward at R, P, x with hx
    have mNat : Nat(m) by typecheck
    have ringR := CommRing.to_ring with comm
    have proper := PrimeIdeal.to_proper at R, P with prime
    rcases natural.zero_or_successor at m with m0 | ⟨j, jNat, mj⟩
    . rw m0 at xm
      have z := Ring.pow_zero at R, x with ringR
      rw z at xm
      exfalso
      exact (ProperIdeal.one_not_mem at R, P with proper) with xm
    . have pos : 0 < m by arith
      exact PrimeIdeal.mem_of_pow_mem at R, P, x, m with comm, prime, xIn, xm, pos
  have eq := Subset.antisymmetric with s1, s2
  exact ⟨ideal, eq⟩

theorem idealRadical.exists_pow_subset (I J : Set)
  requires finitelyGenerated : FinitelyGeneratedIdeal(R, I)
  requires ideal : Ideal(R, J)
  requires subset : I ⊆ idealRadical(R, J)
  shows ∃ n ∈ ℕ, idealPow(R, I, n) ⊆ J
proof
  sorry

-- Helper: an ideal avoiding a multiplicative set lies in a prime avoiding
-- it (Ideal.exists_le_prime_disjoint); Zorn's lemma, so Choice.
theorem Ideal.exists_prime_avoiding (I S : Set)
  requires ideal : Ideal(R, I)
  requires bounded : S ⊆ R.carrier
  requires one : R[1] ∈ S
  requires closed : ∀ s t ∈ S, s * t ∈ S
  requires avoids : ∀ s ∈ S, s ∉ I
  shows ∃ P, PrimeIdeal(R, P) ∧ I ⊆ P ∧ (∀ s ∈ S, s ∉ P)
proof
  have ringR := CommRing.to_ring with comm
  have avoidMem : ∀ J, Ideal(R, J) → (∀ s ∈ S, s ∉ J) → J ∈ avoidingIdeals(R, S)
    intros J idJ avJ
    have sub := Ideal.subset at R, J with idJ
    unfold Subset at sub
    have pw := set.powerset.backward with sub
    exact avoidingIdeals.membership.backward with ⟨pw, idJ, avJ⟩
  have seed := avoidMem with I, ideal, avoids
  have closedF : ∀ T, Nonempty(T) → T ⊆ avoidingIdeals(R, S) →
      (∀ C ∈ T, ∀ D ∈ T, C ⊆ D ∨ D ⊆ C) → ⋃(T) ∈ avoidingIdeals(R, S)
    intros T inhabited subset nested
    have ideals : ∀ J ∈ T, IsIdeal(R.carrier, R.add, R.zero, R.neg, R.mul, J)
      intros J hJ
      have mJ := subset with J, hJ
      obtain ⟨pw, idJ, avJ⟩ := avoidingIdeals.membership.forward with mJ
      exact Ideal.parts at R, J with idJ
    have uIdeal := IsIdeal.union_chain with inhabited, ideals, nested
    have uB := Ideal.of_projections at R, ⋃(T) with uIdeal
    have uAv : ∀ s ∈ S, s ∉ ⋃(T)
      intros s sS sU
      obtain ⟨J, hJ, sJ⟩ := (union.membership at s, T).forward with sU
      have mJ := subset with J, hJ
      obtain ⟨pw, idJ, avJ⟩ := avoidingIdeals.membership.forward with mJ
      exact (avJ with s, sS) with sJ
    exact avoidMem with ⋃(T), uB, uAv
  obtain ⟨M, memberM, extends, maximal⟩ := maximal_extension with seed, closedF
  obtain ⟨pwM, idM, avM⟩ := avoidingIdeals.membership.forward with memberM
  have escape : ∀ x ∈ R.carrier, x ∉ M →
      (∃ s ∈ S, ∃ m ∈ M, ∃ a ∈ R.carrier, s = m + a * x)
    intros x xIn xOut
    have multIdeal := ringMultiples.ideal at R, x with comm
    have K := idealSum.ideal at R, M, ringMultiples(R, x) with comm, idM, multIdeal
    obtain ⟨s1, s2⟩ := idealSum.left_subset at R, M, ringMultiples(R, x) with comm, idM, multIdeal
    have xX := ringMultiples.self_mem at R, x with comm
    have xK := s2 with xX
    by_contra none
    have avK : ∀ s ∈ S, s ∉ idealSum(R, M, ringMultiples(R, x))
      intros s sS sK
      obtain ⟨sIn, m, mM, y, yX, sy⟩ := idealSum.membership.forward at R, M, ringMultiples(R, x), s with sK
      obtain ⟨yIn, a, aIn, ya⟩ := ringMultiples.membership.forward at R, x, y with yX
      rw ya at sy
      exact none with ⟨s, sS, m, mM, a, aIn, sy⟩
    have Kmem := avoidMem with idealSum(R, M, ringMultiples(R, x)), K, avK
    have eq := maximal with idealSum(R, M, ringMultiples(R, x)), Kmem, s1
    rw eq at xK
    exact xOut with xK
  have oneOut := avM with R[1], one
  have proper := ProperIdeal.mk at R, M with ringR, idM, oneOut
  have prime : PrimeIdeal(R, M)
    refine ⟨proper, ?_⟩
    intros x xIn y yIn xy
    have ax : x ∈ M ∨ x ∉ M by tauto
    cases ax with xM | xOut
    . left
      exact xM
    . have ay : y ∈ M ∨ y ∉ M by tauto
      cases ay with yM | yOut
      . right
        exact yM
      . exfalso
        obtain ⟨s, sS, m, mM, a, aIn, sx⟩ := escape with x, xIn, xOut
        obtain ⟨t, tS, n, nM, b, bIn, ty⟩ := escape with y, yIn, yOut
        have mIn := Ideal.mem_carrier at R, M, m with idM, mM
        have nIn := Ideal.mem_carrier at R, M, n with idM, nM
        have st := closed with s, sS, t, tS
        have law : s * t = m * (n + b * y) + n * (a * x) + (a * b) * (x * y)
          rw [sx, ty]
          ring
        have p1 := Ideal.mul_right_mem at R, M, n + b * y, m with idM, *, mM
        have p2 := Ideal.mul_right_mem at R, M, a * x, n with idM, *, nM
        have p3 := Ideal.mul_left_mem at R, M, a * b, x * y with idM, *, xy
        have p12 := Ideal.add_mem at R, M, m * (n + b * y), n * (a * x) with idM, p1, p2
        have p123 := Ideal.add_mem at R, M, m * (n + b * y) + n * (a * x), (a * b) * (x * y) with idM, p12, p3
        rw ← law at p123
        exact (avM with s * t, st) with p123
  exact ⟨M, prime, extends, avM⟩

theorem elementPowers.multiplicative (x : Set)
  requires element : x ∈ R.carrier
  shows elementPowers(R, x) ⊆ R.carrier ∧ R[1] ∈ elementPowers(R, x) ∧
    (∀ s t ∈ elementPowers(R, x), s * t ∈ elementPowers(R, x)) ∧
    x ∈ elementPowers(R, x)
proof
  have ringR := CommRing.to_ring with comm
  have b : elementPowers(R, x) ⊆ R.carrier
    intros y hy
    exact (elementPowers.membership.forward at R, x, y with hy).left
  have oneIn : R[1] ∈ R.carrier by typecheck
  have z := Ring.pow_zero at R, x with ringR
  have zN : 0 ∈ ℕ by typecheck
  symm at z
  have o := elementPowers.membership.backward at R, x, R[1] with ⟨oneIn, 0, zN, z⟩
  have p1 := Ring.pow_one at R, x with ringR
  have oN : 1 ∈ ℕ by typecheck
  symm at p1
  have xm := elementPowers.membership.backward at R, x, x with ⟨element, 1, oN, p1⟩
  have c : ∀ s t ∈ elementPowers(R, x), s * t ∈ elementPowers(R, x)
    intros s hs t ht
    obtain ⟨sIn, m, mN, sm⟩ := elementPowers.membership.forward at R, x, s with hs
    obtain ⟨tIn, n, nN, tn⟩ := elementPowers.membership.forward at R, x, t with ht
    have mNat : Nat(m) by typecheck
    have nNat : Nat(n) by typecheck
    have add := Ring.pow_add at R, x, m, n with ringR
    have pIn : s * t ∈ R.carrier by typecheck
    have sumN : m + n ∈ ℕ by typecheck
    have e : s * t = Ring.pow(R, x, m + n)
      rw [sm, tn, add]
    exact elementPowers.membership.backward at R, x, s * t with ⟨pIn, m + n, sumN, e⟩
  exact ⟨b, o, c, xm⟩

-- The radical is the intersection of the primes containing I
-- (Ideal.radical_eq_sInf). The inclusion of the intersection in the
-- radical builds a prime avoiding the powers of an element by Zorn's
-- lemma: Choice.
theorem idealRadical.eq_prime_intersection (I : Set)
  requires ideal : Ideal(R, I)
  shows idealRadical(R, I) = primeIntersection(R, I)
proof
  have s1 : idealRadical(R, I) ⊆ primeIntersection(R, I)
    intros x hx
    have xIn := (idealRadical.membership.forward at R, I, x with hx).left
    have all : ∀ P, PrimeIdeal(R, P) → I ⊆ P → x ∈ P
      intros P prime sub
      have m := idealRadical.mono at R, I, P with comm, sub
      have rad := PrimeIdeal.radical at R, P with comm, prime
      obtain ⟨_, eq⟩ := rad
      have xr := m with hx
      rw eq at xr
      exact xr
    exact primeIntersection.membership.backward at R, I, x with ⟨xIn, all⟩
  have s2 : primeIntersection(R, I) ⊆ idealRadical(R, I)
    intros x hx
    obtain ⟨xIn, all⟩ := primeIntersection.membership.forward at R, I, x with hx
    by_contra xOut
    obtain ⟨b, o, c, xm⟩ := elementPowers.multiplicative at R, x with comm, xIn
    have avoids : ∀ s ∈ elementPowers(R, x), s ∉ I
      intros s hs sI
      obtain ⟨sIn, n, nN, sn⟩ := elementPowers.membership.forward at R, x, s with hs
      rw sn at sI
      exact xOut with (idealRadical.membership.backward at R, I, x with ⟨xIn, n, nN, sI⟩)
    obtain ⟨P, prime, sub, avP⟩ := Ideal.exists_prime_avoiding at R, I, elementPowers(R, x) with comm, ideal, b, o, c, avoids
    have xP := all with P, prime, sub
    exact (avP with x, xm) with xP
  exact Subset.antisymmetric with s1, s2

-- The nilradical is the set of nilpotent elements, and R is reduced
-- exactly when it is zero (nilradical_eq_zero).
theorem nilradical.mem_iff (x : R)
  shows x ∈ nilradical(R) ↔ RingNilpotent(R, x)
proof
  have xIn : x ∈ R.carrier by assumption
  constructor
  . intro h
    unfold nilradical at h
    obtain ⟨_, m, mIn, xm⟩ := idealRadical.membership.forward at R, {R[0]}, x with h
    have e := singleton.membership.forward with xm
    exact ⟨xIn, m, mIn, e⟩
  . intro h
    obtain ⟨_, m, mIn, xm⟩ := h
    unfold nilradical
    have e := singleton.membership.backward at Ring.pow(R, x, m), R[0] with xm
    exact idealRadical.membership.backward at R, {R[0]}, x with ⟨xIn, m, mIn, e⟩

theorem ReducedRing.iff_nilradical
  shows ReducedRing(R) ↔ nilradical(R) = {R[0]}
proof
  have ringR := CommRing.to_ring with comm
  have zeroIdeal := Ideal.zero at R with ringR
  have zeroIn : R[0] ∈ R.carrier by typecheck
  constructor
  . intro h
    obtain ⟨_, red⟩ := h
    have s2 : {R[0]} ⊆ nilradical(R)
      unfold nilradical
      exact idealRadical.subset at R, {R[0]} with comm, zeroIdeal
    have s1 : nilradical(R) ⊆ {R[0]}
      intros x hx
      have xIn : x ∈ R.carrier
        unfold nilradical at hx
        exact (idealRadical.membership.forward at R, {R[0]}, x with hx).left
      have nil := (nilradical.mem_iff at R, x with comm).forward with hx
      have xz := red with x, xIn, nil
      exact singleton.membership.backward with xz
    exact Subset.antisymmetric with s1, s2
  . intro h
    have red : ∀ x ∈ R.carrier, RingNilpotent(R, x) → x = R[0]
      intros x xIn nil
      have m := (nilradical.mem_iff at R, x with comm).backward with nil
      rw h at m
      exact singleton.membership.forward with m
    exact ⟨comm, red⟩

-- Ideal.isRadical_iff_quotient_reduced.
theorem RadicalIdeal.iff_quotient_reduced (I : Set)
  requires ideal : Ideal(R, I)
  shows RadicalIdeal(R, I) ↔ ReducedRing(R ⧸ I)
proof
  have qc := quotientRing.comm_ring at R, I with comm, ideal
  have qh : quotientMk(R, I) : R →+* R ⧸ I
    unfold quotientMk
    exact quotientRing.projection_hom at R, I with comm, ideal
  have qk : ringKernel(quotientMk(R, I), R.carrier, Ring.zero(R ⧸ I)) = I
    unfold quotientMk
    exact quotientRing.projection_kernel at R, I with comm, ideal
  have qs : SurjectiveBetween(quotientMk(R, I), R.carrier, Ring.carrier(R ⧸ I))
    unfold quotientMk
    exact quotientRing.projection_surjective at R, I with comm, ideal
  have q0 := qh
  obtain ⟨_, _, qfn, _⟩ := q0
  have zeroIff : ∀ x ∈ R.carrier, quotientMk(R, I)(x) = Ring.zero(R ⧸ I) → x ∈ I
    intros x xIn h
    have m := ringKernel.membership.backward at quotientMk(R, I), R.carrier, Ring.zero(R ⧸ I), x with ⟨xIn, h⟩
    rw qk at m
    exact m
  have zeroOf : ∀ x ∈ I, quotientMk(R, I)(x) = Ring.zero(R ⧸ I)
    intros x xI
    have m : x ∈ ringKernel(quotientMk(R, I), R.carrier, Ring.zero(R ⧸ I))
      rw qk
      exact xI
    exact (ringKernel.membership.forward at quotientMk(R, I), R.carrier, Ring.zero(R ⧸ I), x with m).right
  have powq : ∀ x ∈ R.carrier, ∀ n ∈ ℕ, quotientMk(R, I)(Ring.pow(R, x, n)) = Ring.pow(R ⧸ I, quotientMk(R, I)(x), n)
    intros x xIn n nN
    have nNat : Nat(n) by typecheck
    exact RingHom.map_pow at R, R ⧸ I, quotientMk(R, I), x, n with comm, qc, qh
  constructor
  . intro rad
    obtain ⟨_, radEq⟩ := rad
    have all : ∀ X ∈ Ring.carrier(R ⧸ I), RingNilpotent(R ⧸ I, X) → X = Ring.zero(R ⧸ I)
      intros X XIn nil
      obtain ⟨_, n, nN, Xn⟩ := nil
      have qs0 := qs
      obtain ⟨_, onto⟩ := qs0
      obtain ⟨x, xIn, rel⟩ := onto with X, XIn
      have Xx := FunctionBetween.apply_value with qfn, xIn, rel
      rw ← Xx at Xn
      have pw := powq with x, xIn, n, nN
      rw ← pw at Xn
      have pIn : Ring.pow(R, x, n) ∈ R.carrier by typecheck
      have pI := zeroIff with Ring.pow(R, x, n), pIn, Xn
      have xr := idealRadical.membership.backward at R, I, x with ⟨xIn, n, nN, pI⟩
      rw radEq at xr
      rw ← Xx
      exact zeroOf with x, xr
    exact ⟨qc, all⟩
  . intro red
    obtain ⟨_, redAll⟩ := red
    have s1 : idealRadical(R, I) ⊆ I
      intros x hx
      obtain ⟨xIn, n, nN, xn⟩ := idealRadical.membership.forward at R, I, x with hx
      have z := zeroOf with Ring.pow(R, x, n), xn
      have pw := powq with x, xIn, n, nN
      rw pw at z
      have qxIn := FunctionBetween.apply_closed with qfn, xIn
      have nil : RingNilpotent(R ⧸ I, quotientMk(R, I)(x))
        exact ⟨qxIn, n, nN, z⟩
      have e := redAll with quotientMk(R, I)(x), qxIn, nil
      exact zeroIff with x, xIn, e
    have s2 := idealRadical.subset at R, I with comm, ideal
    have eq := Subset.antisymmetric with s1, s2
    exact ⟨ideal, eq⟩

-- The Jacobson radical: an ideal containing I; an element of the Jacobson
-- radical of 0 is one with 1 + x y a unit for every y
-- (Ideal.mem_jacobson_bot). The direction from units to membership needs
-- a maximal ideal containing a nonunit: Choice. The Jacobson radical is a
-- radical ideal (Ideal.isRadical_jacobson).
theorem jacobsonRadical.ideal (I : Set)
  requires ideal : Ideal(R, I)
  shows Ideal(R, jacobsonRadical(R, I))
proof
  have ringR := CommRing.to_ring with comm
  apply Ideal.mk at R, jacobsonRadical(R, I) with ringR
  . intros z hz
    exact (jacobsonRadical.membership.forward at R, I, z with hz).left
  . have zeroIn : R[0] ∈ R.carrier by typecheck
    have all : ∀ M, MaximalIdeal(R, M) → I ⊆ M → R[0] ∈ M
      intros M maxM sub
      have idM := MaximalIdeal.to_ideal at R, M with maxM
      exact Ideal.zero_mem at R, M with idM
    exact jacobsonRadical.membership.backward at R, I, R[0] with ⟨zeroIn, all⟩
  . intros x hx y hy
    obtain ⟨xIn, ax⟩ := jacobsonRadical.membership.forward at R, I, x with hx
    obtain ⟨yIn, ay⟩ := jacobsonRadical.membership.forward at R, I, y with hy
    have sIn : x + y ∈ R.carrier by typecheck
    have all : ∀ M, MaximalIdeal(R, M) → I ⊆ M → x + y ∈ M
      intros M maxM sub
      have idM := MaximalIdeal.to_ideal at R, M with maxM
      have xM := ax with M, maxM, sub
      have yM := ay with M, maxM, sub
      exact Ideal.add_mem at R, M, x, y with idM, xM, yM
    exact jacobsonRadical.membership.backward at R, I, x + y with ⟨sIn, all⟩
  . intros x hx
    obtain ⟨xIn, ax⟩ := jacobsonRadical.membership.forward at R, I, x with hx
    have nIn : -x ∈ R.carrier by typecheck
    have all : ∀ M, MaximalIdeal(R, M) → I ⊆ M → -x ∈ M
      intros M maxM sub
      have idM := MaximalIdeal.to_ideal at R, M with maxM
      have xM := ax with M, maxM, sub
      exact Ideal.neg_mem at R, M, x with idM, xM
    exact jacobsonRadical.membership.backward at R, I, -x with ⟨nIn, all⟩
  . intros r hr x hx
    obtain ⟨xIn, ax⟩ := jacobsonRadical.membership.forward at R, I, x with hx
    have p1 : r * x ∈ R.carrier by typecheck
    have p2 : x * r ∈ R.carrier by typecheck
    have all1 : ∀ M, MaximalIdeal(R, M) → I ⊆ M → r * x ∈ M
      intros M maxM sub
      have idM := MaximalIdeal.to_ideal at R, M with maxM
      have xM := ax with M, maxM, sub
      exact Ideal.mul_left_mem at R, M, r, x with idM, hr, xM
    have all2 : ∀ M, MaximalIdeal(R, M) → I ⊆ M → x * r ∈ M
      intros M maxM sub
      have idM := MaximalIdeal.to_ideal at R, M with maxM
      have xM := ax with M, maxM, sub
      exact Ideal.mul_right_mem at R, M, r, x with idM, hr, xM
    have m1 := jacobsonRadical.membership.backward at R, I, r * x with ⟨p1, all1⟩
    have m2 := jacobsonRadical.membership.backward at R, I, x * r with ⟨p2, all2⟩
    exact ⟨m1, m2⟩

theorem jacobsonRadical.subset (I : Set)
  requires ideal : Ideal(R, I)
  shows I ⊆ jacobsonRadical(R, I)
proof
  intros x xI
  have xIn := Ideal.mem_carrier at R, I, x with ideal, xI
  have all : ∀ M, MaximalIdeal(R, M) → I ⊆ M → x ∈ M
    intros M maxM sub
    exact sub with xI
  exact jacobsonRadical.membership.backward at R, I, x with ⟨xIn, all⟩

theorem MaximalIdeal.exists_inverse (M x : Set)
  requires maximal : MaximalIdeal(R, M)
  requires element : x ∈ R.carrier
  requires outside : x ∉ M
  shows ∃ y ∈ R.carrier, ∃ m ∈ M, call2(R.add, call2(R.mul, x, y), m) = R[1]
proof
  have parts := CommRing.parts at R with comm
  have mparts := MaximalIdeal.parts at R, M with maximal
  obtain ⟨i, iM, a, aIn, law⟩ := IsMaximalIdeal.bezout with parts, mparts, element, outside
  have idM := MaximalIdeal.to_ideal at R, M with maximal
  have iIn := Ideal.mem_carrier at R, M, i with idM, iM
  have law2 : x * a + i = R[1]
    rw law
    ring
  exact ⟨a, aIn, i, iM, law2⟩

theorem jacobsonRadical.mem_zero_iff (x : R)
  shows x ∈ jacobsonRadical(R, {R[0]}) ↔
    (∀ y ∈ R.carrier, RingUnit(R, R[1] + x * y))
proof
  have ringR := CommRing.to_ring with comm
  have xIn : x ∈ R.carrier by assumption
  have zeroIdeal := Ideal.zero at R with ringR
  constructor
  . intro h
    obtain ⟨_, all⟩ := jacobsonRadical.membership.forward at R, {R[0]}, x with h
    intros y yIn
    by_contra notUnit
    have uIn : R[1] + x * y ∈ R.carrier by typecheck
    have ideal := ringMultiples.ideal at R, R[1] + x * y with comm
    have oneOut : R[1] ∉ ringMultiples(R, R[1] + x * y)
      intro oneIn
      have whole := Ideal.contains_one at R, ringMultiples(R, R[1] + x * y) with ideal, oneIn
      have u := (ringMultiples.eq_whole_iff at R, R[1] + x * y with comm).forward with whole
      exact notUnit with u
    have proper := ProperIdeal.mk at R, ringMultiples(R, R[1] + x * y) with ringR, ideal, oneOut
    obtain ⟨M, maxM, sub⟩ := ProperIdeal.extends_maximal at R, ringMultiples(R, R[1] + x * y) with ringR, proper
    have idM := MaximalIdeal.to_ideal at R, M with maxM
    have z := Ideal.zero_mem at R, M with idM
    have zsub := (singleton.subset_iff at R[0], M).backward with z
    have xM := all with M, maxM, zsub
    have uSelf := ringMultiples.self_mem at R, R[1] + x * y with comm
    have uM := sub with uSelf
    have xyM := Ideal.mul_right_mem at R, M, y, x with idM, yIn, xM
    have d := Ideal.sub_mem at R, M, R[1] + x * y, x * y with idM, uM, xyM
    have e : (R[1] + x * y) - x * y = R[1] by ring
    rw e at d
    exact (ProperIdeal.one_not_mem at R, M with (MaximalIdeal.to_proper at R, M with maxM)) with d
  . intro h
    have all : ∀ M, MaximalIdeal(R, M) → {R[0]} ⊆ M → x ∈ M
      intros M maxM sub
      by_contra xOut
      obtain ⟨y, yIn, m, mM, law⟩ := MaximalIdeal.exists_inverse at R, M, x with comm, maxM, xIn, xOut
      have nyIn : -y ∈ R.carrier by typecheck
      have unit := h with -y, nyIn
      have idM := MaximalIdeal.to_ideal at R, M with maxM
      have mIn := Ideal.mem_carrier at R, M, m with idM, mM
      have e : R[1] + x * (-y) = m
        rw ← law
        ring
      rw e at unit
      have proper := MaximalIdeal.to_proper at R, M with maxM
      exact (ProperIdeal.not_mem_unit at R, M, m with comm, proper, unit) with mM
    exact jacobsonRadical.membership.backward at R, {R[0]}, x with ⟨xIn, all⟩

theorem jacobsonRadical.radical (I : Set)
  requires ideal : Ideal(R, I)
  shows RadicalIdeal(R, jacobsonRadical(R, I))
proof
  have jI := jacobsonRadical.ideal at R, I with comm, ideal
  have s2 := idealRadical.subset at R, jacobsonRadical(R, I) with comm, jI
  have s1 : idealRadical(R, jacobsonRadical(R, I)) ⊆ jacobsonRadical(R, I)
    intros x hx
    obtain ⟨xIn, m, mIn, xm⟩ := idealRadical.membership.forward at R, jacobsonRadical(R, I), x with hx
    obtain ⟨_, am⟩ := jacobsonRadical.membership.forward at R, I, Ring.pow(R, x, m) with xm
    have all : ∀ M, MaximalIdeal(R, M) → I ⊆ M → x ∈ M
      intros M maxM sub
      have prime := MaximalIdeal.prime at R, M with comm, maxM
      obtain ⟨_, eq⟩ := PrimeIdeal.radical at R, M with comm, prime
      have pm := am with M, maxM, sub
      have r := idealRadical.membership.backward at R, M, x with ⟨xIn, m, mIn, pm⟩
      rw eq at r
      exact r
    exact jacobsonRadical.membership.backward at R, I, x with ⟨xIn, all⟩
  have eq := Subset.antisymmetric with s1, s2
  exact ⟨jI, eq⟩

theorem nilradical.subset_jacobson
  shows nilradical(R) ⊆ jacobsonRadical(R, {R[0]})
proof
  have ringR := CommRing.to_ring with comm
  intros x hx
  have xIn : x ∈ R.carrier
    unfold nilradical at hx
    exact (idealRadical.membership.forward at R, {R[0]}, x with hx).left
  have all : ∀ M, MaximalIdeal(R, M) → {R[0]} ⊆ M → x ∈ M
    intros M maxM sub
    have prime := MaximalIdeal.prime at R, M with comm, maxM
    have radM := PrimeIdeal.radical at R, M with comm, prime
    obtain ⟨_, eq⟩ := radM
    have zeroIdeal := Ideal.zero at R with ringR
    have m := idealRadical.mono at R, {R[0]}, M with comm, sub
    unfold nilradical at hx
    have xr := m with hx
    rw eq at xr
    exact xr
  exact jacobsonRadical.membership.backward at R, {R[0]}, x with ⟨xIn, all⟩

theorem idealColon.contains (I J : Set)
  requires ideal : Ideal(R, I)
  requires inside : J ⊆ R.carrier
  shows I ⊆ idealColon(R, I, J)
proof
  intros x xI
  have xIn := Ideal.mem_carrier at R, I, x with ideal, xI
  have all : ∀ y ∈ J, x * y ∈ I
    intros y yJ
    have yIn := inside with yJ
    exact Ideal.mul_right_mem at R, I, y, x with ideal, yIn, xI
  exact idealColon.membership.backward at R, I, J, x with ⟨xIn, all⟩

-- Helper: the intersection of a nonempty chain of primes is prime; here
-- the chain is given by the complements C, ordered by inclusion.
theorem PrimeIdeal.chain_complement (T : Set)
  requires inhabited : Nonempty(T)
  requires bounded : ∀ C ∈ T, C ⊆ R.carrier
  requires primes : ∀ C ∈ T, PrimeIdeal(R, R.carrier ∖ C)
  requires nested : ∀ C ∈ T, ∀ D ∈ T, C ⊆ D ∨ D ⊆ C
  shows PrimeIdeal(R, R.carrier ∖ ⋃(T))
proof
  have ringR := CommRing.to_ring with comm
  have toAll : ∀ x, x ∈ R.carrier ∖ ⋃(T) → (∀ C ∈ T, x ∈ R.carrier ∖ C)
    intros x h C hC
    obtain ⟨xIn, notU⟩ := difference.membership.forward with h
    have notC : x ∉ C
      intro xC
      exact notU with ((union.membership at x, T).backward with ⟨C, hC, xC⟩)
    exact difference.membership.backward with ⟨xIn, notC⟩
  have fromAll : ∀ x ∈ R.carrier, (∀ C ∈ T, x ∈ R.carrier ∖ C) → x ∈ R.carrier ∖ ⋃(T)
    intros x xIn all
    have notU : x ∉ ⋃(T)
      intro xU
      obtain ⟨C, hC, xC⟩ := (union.membership at x, T).forward with xU
      obtain ⟨_, notC⟩ := difference.membership.forward with (all with C, hC)
      exact notC with xC
    exact difference.membership.backward with ⟨xIn, notU⟩
  have idealOf : ∀ C ∈ T, Ideal(R, R.carrier ∖ C)
    intros C hC
    exact PrimeIdeal.to_ideal at R, R.carrier ∖ C with (primes with C, hC)
  have ideal : Ideal(R, R.carrier ∖ ⋃(T))
    apply Ideal.mk at R, R.carrier ∖ ⋃(T) with ringR
    . exact difference.subset_left at R.carrier, ⋃(T)
    . have zeroIn : R[0] ∈ R.carrier by typecheck
      have all : ∀ C ∈ T, R[0] ∈ R.carrier ∖ C
        intros C hC
        have idC := idealOf with C, hC
        exact Ideal.zero_mem at R, R.carrier ∖ C with idC
      exact fromAll with R[0], zeroIn, all
    . intros x hx y hy
      have xIn := (difference.membership.forward with hx).left
      have yIn := (difference.membership.forward with hy).left
      have sIn : x + y ∈ R.carrier by typecheck
      have all : ∀ C ∈ T, x + y ∈ R.carrier ∖ C
        intros C hC
        have idC := idealOf with C, hC
        have t0 := toAll with x, hx, C, hC
        have t1 := toAll with y, hy, C, hC
        exact Ideal.add_mem at R, R.carrier ∖ C, x, y with idC, t0, t1
      exact fromAll with x + y, sIn, all
    . intros x hx
      have xIn := (difference.membership.forward with hx).left
      have nIn : -x ∈ R.carrier by typecheck
      have all : ∀ C ∈ T, -x ∈ R.carrier ∖ C
        intros C hC
        have idC := idealOf with C, hC
        have t0 := toAll with x, hx, C, hC
        exact Ideal.neg_mem at R, R.carrier ∖ C, x with idC, t0
      exact fromAll with -x, nIn, all
    . intros r hr x hx
      have xIn := (difference.membership.forward with hx).left
      have p1 : r * x ∈ R.carrier by typecheck
      have p2 : x * r ∈ R.carrier by typecheck
      have all1 : ∀ C ∈ T, r * x ∈ R.carrier ∖ C
        intros C hC
        have idC := idealOf with C, hC
        have t0 := toAll with x, hx, C, hC
        exact Ideal.mul_left_mem at R, R.carrier ∖ C, r, x with idC, hr, t0
      have all2 : ∀ C ∈ T, x * r ∈ R.carrier ∖ C
        intros C hC
        have idC := idealOf with C, hC
        have t0 := toAll with x, hx, C, hC
        exact Ideal.mul_right_mem at R, R.carrier ∖ C, r, x with idC, hr, t0
      exact ⟨(fromAll with r * x, p1, all1), (fromAll with x * r, p2, all2)⟩
  obtain ⟨C0, hC0⟩ := inhabited
  have oneOut : R[1] ∉ R.carrier ∖ ⋃(T)
    intro oneIn
    have m := toAll with R[1], oneIn, C0, hC0
    have proper := PrimeIdeal.to_proper at R, R.carrier ∖ C0 with (primes with C0, hC0)
    exact (ProperIdeal.one_not_mem at R, R.carrier ∖ C0 with proper) with m
  have proper := ProperIdeal.mk at R, R.carrier ∖ ⋃(T) with ringR, ideal, oneOut
  refine ⟨proper, ?_⟩
  intros x xIn y yIn xy
  have ax : x ∈ R.carrier ∖ ⋃(T) ∨ x ∉ R.carrier ∖ ⋃(T) by tauto
  cases ax with xQ | xOut
  . left
    exact xQ
  . have ay : y ∈ R.carrier ∖ ⋃(T) ∨ y ∉ R.carrier ∖ ⋃(T) by tauto
    cases ay with yQ | yOut
    . right
      exact yQ
    . exfalso
      have witness : ∀ z ∈ R.carrier, z ∉ R.carrier ∖ ⋃(T) → (∃ C ∈ T, z ∉ R.carrier ∖ C)
        intros z zIn zOut
        by_contra none
        have all : ∀ C ∈ T, z ∈ R.carrier ∖ C
          intros C hC
          by_contra zC
          exact none with ⟨C, hC, zC⟩
        exact zOut with (fromAll with z, zIn, all)
      obtain ⟨C1, h1, x1⟩ := witness with x, xIn, xOut
      obtain ⟨C2, h2, y2⟩ := witness with y, yIn, yOut
      rcases nested with C1, h1, C2, h2 with c12 | c21
      . have anti := difference.antitone at R.carrier, C1, C2 with c12
        have xNot : x ∉ R.carrier ∖ C2
          intro m
          exact x1 with (anti with m)
        have xy2 := toAll with x * y, xy, C2, h2
        rcases PrimeIdeal.mem_or_mem at R, R.carrier ∖ C2, x, y with (primes with C2, h2), xy2 with a | b
        . exact xNot with a
        . exact y2 with b
      . have anti := difference.antitone at R.carrier, C2, C1 with c21
        have yNot : y ∉ R.carrier ∖ C1
          intro m
          exact y2 with (anti with m)
        have xy1 := toAll with x * y, xy, C1, h1
        rcases PrimeIdeal.mem_or_mem at R, R.carrier ∖ C1, x, y with (primes with C1, h1), xy1 with a | b
        . exact x1 with a
        . exact yNot with b

-- Minimal primes. Every prime over I contains a minimal prime over I
-- (Ideal.exists_minimalPrimes_le): Zorn's lemma on descending chains of
-- primes, so Choice. A proper ideal has a minimal prime over it
-- (Ideal.nonempty_minimalPrimes), again Choice.
theorem MinimalPrimeOver.exists_below (I P : Set)
  requires ideal : Ideal(R, I)
  requires prime : PrimeIdeal(R, P)
  requires over : I ⊆ P
  shows ∃ Q, MinimalPrimeOver(R, I, Q) ∧ Q ⊆ P
proof
  have mem : ∀ Q, PrimeIdeal(R, Q) → I ⊆ Q → Q ⊆ P → R.carrier ∖ Q ∈ primeComplementsBelow(R, I, P)
    intros Q pQ iQ qP
    have qR := Ideal.subset at R, Q with (PrimeIdeal.to_ideal at R, Q with pQ)
    have dd := difference.double_of_subset at R.carrier, Q with qR
    have sub := difference.subset_left at R.carrier, Q
    unfold Subset at sub
    have pw := set.powerset.backward with sub
    rw ← dd at pQ
    rw ← dd at iQ
    rw ← dd at qP
    exact primeComplementsBelow.membership.backward with ⟨pw, pQ, iQ, qP⟩
  have seed := mem with P, prime, over, (Subset.reflexive at P)
  have closedF : ∀ T, Nonempty(T) → T ⊆ primeComplementsBelow(R, I, P) →
      (∀ C ∈ T, ∀ D ∈ T, C ⊆ D ∨ D ⊆ C) → ⋃(T) ∈ primeComplementsBelow(R, I, P)
    intros T inhabited subset nested
    have bounded : ∀ C ∈ T, C ⊆ R.carrier
      intros C hC
      obtain ⟨pw, _⟩ := primeComplementsBelow.membership.forward with (subset with C, hC)
      have pw2 := set.powerset.forward with pw
      intros z hz
      exact pw2 with z, hz
    have primes : ∀ C ∈ T, PrimeIdeal(R, R.carrier ∖ C)
      intros C hC
      obtain ⟨_, pC, _, _⟩ := primeComplementsBelow.membership.forward with (subset with C, hC)
      exact pC
    have pU := PrimeIdeal.chain_complement at R, T with comm, inhabited, bounded, primes, nested
    have iU : I ⊆ R.carrier ∖ ⋃(T)
      intros x xI
      have xIn := Ideal.mem_carrier at R, I, x with ideal, xI
      have notU : x ∉ ⋃(T)
        intro xU
        obtain ⟨C, hC, xC⟩ := (union.membership at x, T).forward with xU
        obtain ⟨_, _, iC, _⟩ := primeComplementsBelow.membership.forward with (subset with C, hC)
        obtain ⟨_, notC⟩ := difference.membership.forward with (iC with xI)
        exact notC with xC
      exact difference.membership.backward with ⟨xIn, notU⟩
    obtain ⟨C0, hC0⟩ := inhabited
    obtain ⟨_, _, _, c0P⟩ := primeComplementsBelow.membership.forward with (subset with C0, hC0)
    have uP : R.carrier ∖ ⋃(T) ⊆ P
      have c0U : C0 ⊆ ⋃(T)
        intros x xC
        exact (union.membership at x, T).backward with ⟨C0, hC0, xC⟩
      have anti := difference.antitone at R.carrier, C0, ⋃(T) with c0U
      exact Subset.transitive with anti, c0P
    have uR : ⋃(T) ⊆ R.carrier
      intros x xU
      obtain ⟨C, hC, xC⟩ := (union.membership at x, T).forward with xU
      exact (bounded with C, hC) with xC
    have dd := difference.double_of_subset at R.carrier, ⋃(T) with uR
    have m := mem with R.carrier ∖ ⋃(T), pU, iU, uP
    rw dd at m
    exact m
  obtain ⟨M, memberM, extends, maximal⟩ := maximal_extension with seed, closedF
  obtain ⟨_, pM, iM, mP⟩ := primeComplementsBelow.membership.forward with memberM
  witness R.carrier ∖ M
  constructor
  . refine ⟨pM, iM, ?_⟩
    intros Q pQ iQ qM
    have qP := Subset.transitive with qM, mP
    have cQ := mem with Q, pQ, iQ, qP
    have anti := difference.antitone at R.carrier, Q, R.carrier ∖ M with qM
    have qR := Ideal.subset at R, Q with (PrimeIdeal.to_ideal at R, Q with pQ)
    obtain ⟨pwM, _⟩ := primeComplementsBelow.membership.forward with memberM
    have mR0 := set.powerset.forward with pwM
    have mR : M ⊆ R.carrier
      intros z hz
      exact mR0 with z, hz
    have ddM := difference.double_of_subset at R.carrier, M with mR
    rw ddM at anti
    have eq := maximal with R.carrier ∖ Q, cQ, anti
    have ddQ := difference.double_of_subset at R.carrier, Q with qR
    rw ← eq
    symm at ddQ
    exact ddQ
  . exact mP

theorem MinimalPrimeOver.exists (I : Set)
  requires proper : ProperIdeal(R, I)
  shows ∃ P, MinimalPrimeOver(R, I, P)
proof
  have ringR := CommRing.to_ring with comm
  obtain ⟨P, prime, over⟩ := ProperIdeal.extends_prime at R, I with comm, proper
  have ideal := ProperIdeal.to_ideal at R, I with proper
  obtain ⟨Q, minimal, _⟩ := MinimalPrimeOver.exists_below at R, I, P with comm, ideal, prime, over
  exact ⟨Q, minimal⟩

-- Maximal ideals: Ideal.exists_le_maximal and Ideal.ne_top_iff_exists_maximal
-- (Choice, through Cumulus's maximal principle); a maximal ideal M with
-- x ∉ M has M + (x) = R (Ideal.IsMaximal.exists_inv).
theorem ProperIdeal.iff_exists_maximal (I : Set)
  requires ideal : Ideal(R, I)
  shows ProperIdeal(R, I) ↔ (∃ M, MaximalIdeal(R, M) ∧ I ⊆ M)
proof
  constructor
  . intro proper
    obtain ⟨ideal2, notOne⟩ := proper
    have bounded := Ideal.subset at R, I with ideal
    have same := generatedIdeal.eq_of_ideal at R, I with ideal
    have notIn : R[1] ∉ generatedIdeal(R, I)
      rw same
      exact notOne
    exact generatedIdeal.exists_maximal at R, I with bounded, notIn
  . intro h
    obtain ⟨M, maximal, sub⟩ := h
    obtain ⟨properM, rest⟩ := maximal
    obtain ⟨idealM, notOne⟩ := properM
    have notI : R[1] ∉ I
      intro oneI
      exact notOne with (sub with oneI)
    exact ⟨ideal, notI⟩

-- Distinct maximal ideals are coprime (Ideal.isCoprime_of_isMaximal).
theorem MaximalIdeal.coprime (M N : Set)
  requires first : MaximalIdeal(R, M)
  requires second : MaximalIdeal(R, N)
  requires distinct : M ≠ N
  shows idealSum(R, M, N) = R.carrier
proof
  have idM := MaximalIdeal.to_ideal at R, M with first
  have idN := MaximalIdeal.to_ideal at R, N with second
  have sumI := idealSum.ideal at R, M, N with comm, idM, idN
  obtain ⟨s1, s2⟩ := idealSum.left_subset at R, M, N with comm, idM, idN
  have first0 := first
  obtain ⟨properM, maxM⟩ := first0
  have second0 := second
  obtain ⟨properN, maxN⟩ := second0
  have ringR := CommRing.to_ring with comm
  by_contra notWhole
  have properS := (ProperIdeal.iff_ne_carrier at R, idealSum(R, M, N) with ringR, sumI).backward with notWhole
  have eqM := maxM with idealSum(R, M, N), properS, s1
  rw eqM at s2
  have eqN := maxN with M, properM, s2
  exact distinct with eqN

end IdealOperations

-- Section: Extension and contraction along a homomorphism
section ExtensionContraction
variable (f R S : Set)
hypothesis source : CommRing(R)
hypothesis target : CommRing(S)
hypothesis hom : f : R →+* S

-- Ideal.map and Ideal.comap: ideals; the Galois connection
-- (Ideal.map_le_iff_le_comap, le_comap_map, map_comap_le); functoriality
-- (Ideal.map_map, Ideal.comap_comap); monotonicity; generators
-- (Ideal.map_span); sums, products and powers (Ideal.map_sup,
-- Ideal.map_mul, Ideal.map_pow); the kernel inside every contraction
-- (Ideal.ker_le_comap).
theorem idealExtension.ideal (I : Set)
  shows Ideal(S, idealExtension(f, S, I))
proof
  unfold idealExtension
  exact generatedIdeal.ideal at S, functionImage(f, I, S.carrier) with target

theorem idealComap.ideal_of_hom (J : Set)
  requires ideal : Ideal(S, J)
  shows Ideal(R, idealComap(f, R.carrier, J))
proof
  exact idealComap.ideal at f, R, S, J with source, target, hom, ideal

theorem idealExtension.subset_iff (I J : Set)
  requires first : Ideal(R, I)
  requires second : Ideal(S, J)
  shows idealExtension(f, S, I) ⊆ J ↔ I ⊆ idealComap(f, R.carrier, J)
proof
  have hom0 := hom
  obtain ⟨_, _, fn, _⟩ := hom0
  have bI := Ideal.subset at R, I with first
  have img := functionImage.subset at f, I, S.carrier
  have gal := idealMap.galois at f, R.carrier, S.carrier, I, J with fn, bI
  unfold idealMap at gal
  have sub := generatedIdeal.subset_iff at S, functionImage(f, I, S.carrier), J with target, img, second
  unfold idealExtension
  constructor
  . intro h
    exact gal.forward with (sub.forward with h)
  . intro h
    exact sub.backward with (gal.backward with h)

theorem idealExtension.mem_of_mem (I x : Set)
  requires ideal : Ideal(R, I)
  requires member : x ∈ I
  shows f(x) ∈ idealExtension(f, S, I)
proof
  have hom0 := hom
  obtain ⟨_, _, fn, _⟩ := hom0
  have xIn := Ideal.mem_carrier at R, I, x with ideal, member
  have v := idealMap.value at f, R.carrier, S.carrier, I, x with fn, xIn, member
  unfold idealMap at v
  have img := functionImage.subset at f, I, S.carrier
  have contains := generatedIdeal.contains at S, functionImage(f, I, S.carrier) with target, img
  unfold idealExtension
  exact contains with v

theorem idealExtension.mono (I J : Set)
  requires subset : I ⊆ J
  shows idealExtension(f, S, I) ⊆ idealExtension(f, S, J)
proof
  have m := idealMap.monotone at f, S.carrier, I, J with subset
  unfold idealMap at m
  have img := functionImage.subset at f, J, S.carrier
  unfold idealExtension
  exact generatedIdeal.mono at S, functionImage(f, I, S.carrier), functionImage(f, J, S.carrier) with target, m, img

theorem idealComap.mono_of_hom (I J : Set)
  requires subset : I ⊆ J
  shows idealComap(f, R.carrier, I) ⊆ idealComap(f, R.carrier, J)
proof
  exact idealComap.monotone at f, R.carrier, I, J with subset

theorem idealExtension.whole
  shows idealExtension(f, S, R.carrier) = S.carrier
proof
  have ringR := CommRing.to_ring with source
  have whole := Ideal.whole at R with ringR
  have oneIn : R[1] ∈ R.carrier by typecheck
  have m := idealExtension.mem_of_mem at f, R, S, R.carrier, R[1] with source, target, hom, whole, oneIn
  have one := RingHom.map_one at f, R, S with hom
  rw one at m
  have ext := idealExtension.ideal at f, R, S, R.carrier with source, target, hom
  have ringS := CommRing.to_ring with target
  exact Ideal.contains_one at S, idealExtension(f, S, R.carrier) with ringS, ext, m

theorem idealExtension.generated (G : Set)
  requires bounded : G ⊆ R.carrier
  shows idealExtension(f, S, generatedIdeal(R, G)) =
    generatedIdeal(S, functionImage(f, G, S.carrier))
proof
  have hom0 := hom
  obtain ⟨_, _, fn, _⟩ := hom0
  have gR := generatedIdeal.ideal at R, G with source
  have T := generatedIdeal.ideal at S, functionImage(f, G, S.carrier) with target
  have img := functionImage.subset at f, G, S.carrier
  have cT := generatedIdeal.contains at S, functionImage(f, G, S.carrier) with target, img
  have cG := generatedIdeal.contains at R, G with source, bounded
  have comapT := idealComap.ideal_of_hom at f, R, S, generatedIdeal(S, functionImage(f, G, S.carrier)) with source, target, hom, T
  have sub : G ⊆ idealComap(f, R.carrier, generatedIdeal(S, functionImage(f, G, S.carrier)))
    intros x xG
    have xIn := bounded with xG
    have fxIn := FunctionBetween.apply_closed with fn, xIn
    have im := functionImage.membership.backward at f, G, S.carrier, f(x) with ⟨fxIn, x, xG, rfl⟩
    have m := cT with im
    exact idealComap.membership.backward at f, R.carrier, generatedIdeal(S, functionImage(f, G, S.carrier)), x with ⟨xIn, m⟩
  have big := generatedIdeal.least at R, G, idealComap(f, R.carrier, generatedIdeal(S, functionImage(f, G, S.carrier))) with source, comapT, sub
  have s1 := (idealExtension.subset_iff at f, R, S, generatedIdeal(R, G), generatedIdeal(S, functionImage(f, G, S.carrier)) with source, target, hom, gR, T).backward with big
  have eI := idealExtension.ideal at f, R, S, generatedIdeal(R, G) with source, target, hom
  have sub2 : functionImage(f, G, S.carrier) ⊆ idealExtension(f, S, generatedIdeal(R, G))
    intros y hy
    obtain ⟨yIn, x, xG, yx⟩ := functionImage.membership.forward at f, G, S.carrier, y with hy
    rw yx
    exact idealExtension.mem_of_mem at f, R, S, generatedIdeal(R, G), x with source, target, hom, gR, (cG with xG)
  have s2 := generatedIdeal.least at S, functionImage(f, G, S.carrier), idealExtension(f, S, generatedIdeal(R, G)) with target, eI, sub2
  exact Subset.antisymmetric with s1, s2

theorem idealExtension.sum (I J : Set)
  requires first : Ideal(R, I)
  requires second : Ideal(R, J)
  shows idealExtension(f, S, idealSum(R, I, J)) =
    idealSum(S, idealExtension(f, S, I), idealExtension(f, S, J))
proof
  have ij := idealSum.ideal at R, I, J with source, first, second
  have eI := idealExtension.ideal at f, R, S, I with source, target, hom
  have eJ := idealExtension.ideal at f, R, S, J with source, target, hom
  have eIJ := idealExtension.ideal at f, R, S, idealSum(R, I, J) with source, target, hom
  have T := idealSum.ideal at S, idealExtension(f, S, I), idealExtension(f, S, J) with target, eI, eJ
  obtain ⟨t1, t2⟩ := idealSum.left_subset at S, idealExtension(f, S, I), idealExtension(f, S, J) with target, eI, eJ
  have a1 := (idealExtension.subset_iff at f, R, S, I, idealSum(S, idealExtension(f, S, I), idealExtension(f, S, J)) with source, target, hom, first, T).forward with t1
  have a2 := (idealExtension.subset_iff at f, R, S, J, idealSum(S, idealExtension(f, S, I), idealExtension(f, S, J)) with source, target, hom, second, T).forward with t2
  have cT := idealComap.ideal_of_hom at f, R, S, idealSum(S, idealExtension(f, S, I), idealExtension(f, S, J)) with source, target, hom, T
  have both := (idealSum.least at R, I, J, idealComap(f, R.carrier, idealSum(S, idealExtension(f, S, I), idealExtension(f, S, J))) with source, first, second, cT).backward with ⟨a1, a2⟩
  have s1 := (idealExtension.subset_iff at f, R, S, idealSum(R, I, J), idealSum(S, idealExtension(f, S, I), idealExtension(f, S, J)) with source, target, hom, ij, T).backward with both
  obtain ⟨l1, l2⟩ := idealSum.left_subset at R, I, J with source, first, second
  have m1 := idealExtension.mono at f, R, S, I, idealSum(R, I, J) with source, target, hom, l1
  have m2 := idealExtension.mono at f, R, S, J, idealSum(R, I, J) with source, target, hom, l2
  have s2 := (idealSum.least at S, idealExtension(f, S, I), idealExtension(f, S, J), idealExtension(f, S, idealSum(R, I, J)) with target, eI, eJ, eIJ).backward with ⟨m1, m2⟩
  exact Subset.antisymmetric with s1, s2

theorem idealExtension.product (I J : Set)
  requires first : Ideal(R, I)
  requires second : Ideal(R, J)
  shows idealExtension(f, S, idealProduct(R, I, J)) =
    idealProduct(S, idealExtension(f, S, I), idealExtension(f, S, J))
proof
  have hom0 := hom
  obtain ⟨_, _, fn, _⟩ := hom0
  have ij := idealProduct.ideal at R, I, J with source
  have eI := idealExtension.ideal at f, R, S, I with source, target, hom
  have eJ := idealExtension.ideal at f, R, S, J with source, target, hom
  have eIJ := idealExtension.ideal at f, R, S, idealProduct(R, I, J) with source, target, hom
  have T := idealProduct.ideal at S, idealExtension(f, S, I), idealExtension(f, S, J) with target
  have cT := idealComap.ideal_of_hom at f, R, S, idealProduct(S, idealExtension(f, S, I), idealExtension(f, S, J)) with source, target, hom, T
  have pre : ∀ x ∈ I, ∀ y ∈ J, x * y ∈ idealComap(f, R.carrier, idealProduct(S, idealExtension(f, S, I), idealExtension(f, S, J)))
    intros x xI y yJ
    have xIn := Ideal.mem_carrier at R, I, x with first, xI
    have yIn := Ideal.mem_carrier at R, J, y with second, yJ
    have pIn : x * y ∈ R.carrier by typecheck
    have fx := idealExtension.mem_of_mem at f, R, S, I, x with source, target, hom, first, xI
    have fy := idealExtension.mem_of_mem at f, R, S, J, y with source, target, hom, second, yJ
    have m := idealProduct.mul_mem at S, idealExtension(f, S, I), idealExtension(f, S, J), f(x), f(y) with target, eI, eJ, fx, fy
    have mm := RingHom.map_mul at f, R, S, x, y with hom
    rw ← mm at m
    exact idealComap.membership.backward at f, R.carrier, idealProduct(S, idealExtension(f, S, I), idealExtension(f, S, J)), x * y with ⟨pIn, m⟩
  have both := (idealProduct.least at R, I, J, idealComap(f, R.carrier, idealProduct(S, idealExtension(f, S, I), idealExtension(f, S, J))) with source, first, second, cT).backward with pre
  have s1 := (idealExtension.subset_iff at f, R, S, idealProduct(R, I, J), idealProduct(S, idealExtension(f, S, I), idealExtension(f, S, J)) with source, target, hom, ij, T).backward with both
  have bI := functionImage.subset at f, I, S.carrier
  have bJ := functionImage.subset at f, J, S.carrier
  have gen := idealProduct.generated at S, functionImage(f, I, S.carrier), functionImage(f, J, S.carrier) with target, bI, bJ
  have sub : idealProductGenerators(S, functionImage(f, I, S.carrier), functionImage(f, J, S.carrier)) ⊆ idealExtension(f, S, idealProduct(R, I, J))
    intros z hz
    obtain ⟨zIn, u, uI, v, vJ, zuv⟩ := idealProductGenerators.membership.forward at S, functionImage(f, I, S.carrier), functionImage(f, J, S.carrier), z with hz
    obtain ⟨_, x, xI, ux⟩ := functionImage.membership.forward at f, I, S.carrier, u with uI
    obtain ⟨_, y, yJ, vy⟩ := functionImage.membership.forward at f, J, S.carrier, v with vJ
    have xIn := Ideal.mem_carrier at R, I, x with first, xI
    have yIn := Ideal.mem_carrier at R, J, y with second, yJ
    have m := idealProduct.mul_mem at R, I, J, x, y with source, first, second, xI, yJ
    have e := idealExtension.mem_of_mem at f, R, S, idealProduct(R, I, J), x * y with source, target, hom, ij, m
    have mm := RingHom.map_mul at f, R, S, x, y with hom
    rw [zuv, ux, vy, ← mm]
    exact e
  have s2a := generatedIdeal.least at S, idealProductGenerators(S, functionImage(f, I, S.carrier), functionImage(f, J, S.carrier)), idealExtension(f, S, idealProduct(R, I, J)) with target, eIJ, sub
  rw ← gen at s2a
  have s2 : idealProduct(S, idealExtension(f, S, I), idealExtension(f, S, J)) ⊆ idealExtension(f, S, idealProduct(R, I, J))
    unfold idealExtension
    unfold idealExtension at s2a
    exact s2a
  exact Subset.antisymmetric with s1, s2

theorem idealExtension.pow (I : Set) (n : Nat)
  requires ideal : Ideal(R, I)
  shows idealExtension(f, S, idealPow(R, I, n)) =
    idealPow(S, idealExtension(f, S, I), n)
proof
  induction n
  | zero =>
    rw [(idealPow.zero at R, I with source), (idealPow.zero at S, idealExtension(f, S, I) with target)]
    exact idealExtension.whole at f, R, S with source, target, hom
  | succ(k) using ih =>
    rw [(idealPow.succ at R, I, k with source), (idealPow.succ at S, idealExtension(f, S, I), k with target)]
    have pk := idealPow.ideal at R, I, k with source, ideal
    have p := idealExtension.product at f, R, S, idealPow(R, I, k), I with source, target, hom, pk, ideal
    rw [p, ih]

theorem idealComap.kernel_subset_of_hom (J : Set)
  requires ideal : Ideal(S, J)
  shows ker(f) ⊆ idealComap(f, R.carrier, J)
proof
  exact idealComap.kernel_subset at f, R, S, J with source, target, hom, ideal

-- Ideal.map_eq_bot_iff_le_ker.
theorem idealExtension.eq_zero_iff (I : Set)
  requires ideal : Ideal(R, I)
  shows idealExtension(f, S, I) = {S[0]} ↔ I ⊆ ker(f)
proof
  have ringS := CommRing.to_ring with target
  have zeroS := Ideal.zero at S with ringS
  have kerIdeal := ringKernel.ideal at f, R, S with hom
  have comapZero : idealComap(f, R.carrier, {S[0]}) = ker(f)
    have s1 : idealComap(f, R.carrier, {S[0]}) ⊆ ker(f)
      intros x hx
      obtain ⟨xIn, fx⟩ := idealComap.membership.forward at f, R.carrier, {S[0]}, x with hx
      have e := singleton.membership.forward with fx
      exact (RingHom.mem_kernel_iff at f, R, S, x with hom, xIn).backward with e
    have s2 : ker(f) ⊆ idealComap(f, R.carrier, {S[0]})
      intros x hx
      have kb := RingHom.kernel_subset at f, R, S with hom
      have xIn := kb with hx
      have e := (RingHom.mem_kernel_iff at f, R, S, x with hom, xIn).forward with hx
      have m := singleton.membership.backward at f(x), S[0] with e
      exact idealComap.membership.backward at f, R.carrier, {S[0]}, x with ⟨xIn, m⟩
    exact Subset.antisymmetric with s1, s2
  have sub := idealExtension.subset_iff at f, R, S, I, {S[0]} with source, target, hom, ideal, zeroS
  rw comapZero at sub
  have ext := idealExtension.ideal at f, R, S, I with source, target, hom
  have z := Ideal.zero_mem at S, idealExtension(f, S, I) with ext
  have zsub := (singleton.subset_iff at S[0], idealExtension(f, S, I)).backward with z
  constructor
  . intro h
    have hs : idealExtension(f, S, I) ⊆ {S[0]}
      rw h
      exact Subset.reflexive at {S[0]}
    exact sub.forward with hs
  . intro h
    have hs := sub.backward with h
    exact Subset.antisymmetric with hs, zsub

-- The contraction of a prime is prime (Ideal.comap_isPrime, under
-- RingHom.ker_isPrime for the zero ideal of a domain), and of a proper
-- ideal proper (Ideal.comap_ne_top).
theorem idealComap.prime_of_hom (P : Set)
  requires prime : PrimeIdeal(S, P)
  shows PrimeIdeal(R, idealComap(f, R.carrier, P))
proof
  exact idealComap.prime at f, R, S, P with source, target, hom, prime

-- RingHom.ker_ne_top: the kernel of a map to a nontrivial ring is proper.
theorem RingHom.kernel_proper
  requires nontrivial : S[0] ≠ S[1]
  shows ProperIdeal(R, ker(f))
proof
  have ringR := CommRing.to_ring with source
  have kerIdeal := ringKernel.ideal at f, R, S with hom
  have oneOut : R[1] ∉ ker(f)
    intro h
    have oneIn : R[1] ∈ R.carrier by typecheck
    have e := (RingHom.mem_kernel_iff at f, R, S, R[1] with hom, oneIn).forward with h
    have one := RingHom.map_one at f, R, S with hom
    rw one at e
    have e2 : S[0] = S[1] by rw e
    exact nontrivial with e2
  exact ProperIdeal.mk at R, ker(f) with ringR, kerIdeal, oneOut

theorem RingHom.kernel_prime
  requires domain : IntegralDomain(S)
  shows PrimeIdeal(R, ker(f))
proof
  have nt := IntegralDomain.nontrivial at S with domain
  have proper := RingHom.kernel_proper at f, R, S with source, target, hom, nt
  have law : ∀ x y ∈ R.carrier, x * y ∈ ker(f) → x ∈ ker(f) ∨ y ∈ ker(f)
    intros x xIn y yIn h
    have e := (RingHom.mem_kernel_iff at f, R, S, x * y with hom, *).forward with h
    have mm := RingHom.map_mul at f, R, S, x, y with hom
    rw mm at e
    have fx : f(x) ∈ S.carrier by typecheck
    have fy : f(y) ∈ S.carrier by typecheck
    rcases (IntegralDomain.mul_eq_zero at S, f(x), f(y) with domain, fx, fy).forward with e with a | b
    . left
      exact (RingHom.mem_kernel_iff at f, R, S, x with hom, xIn).backward with a
    . right
      exact (RingHom.mem_kernel_iff at f, R, S, y with hom, yIn).backward with b
  exact ⟨proper, law⟩

-- RingHom.injective_iff_ker_eq_bot.
theorem RingHom.injective_iff_kernel
  shows InjectiveBetween(f, R.carrier, S.carrier) ↔ ker(f) = {R[0]}
proof
  have ringR := CommRing.to_ring with source
  have hom0 := hom
  obtain ⟨_, _, fn, _⟩ := hom0
  have zeroIn : R[0] ∈ R.carrier by typecheck
  have kb := RingHom.kernel_subset at f, R, S with hom
  have zk := RingHom.zero_mem_kernel at f, R, S with hom
  constructor
  . intro inj
    have s1 : ker(f) ⊆ {R[0]}
      intros x hx
      have xIn := kb with hx
      have e := (RingHom.mem_kernel_iff at f, R, S, x with hom, xIn).forward with hx
      have z := RingHom.map_zero at f, R, S with hom
      rw ← z at e
      have rx := FunctionBetween.relates_apply at f, R.carrier, S.carrier, x with fn, xIn
      have r0 := FunctionBetween.relates_apply at f, R.carrier, S.carrier, R[0] with fn, zeroIn
      rw e at rx
      obtain ⟨_, cancel⟩ := inj
      have fz : f(R[0]) ∈ S.carrier by typecheck
      have xz := cancel with x, xIn, R[0], zeroIn, f(R[0]), fz, rx, r0
      exact singleton.membership.backward with xz
    have s2 := (singleton.subset_iff at R[0], ker(f)).backward with zk
    exact Subset.antisymmetric with s1, s2
  . intro h
    apply Injective.of_pointwise with fn
    intros x xIn y yIn e
    have d := (RingHom.apply_eq_iff at f, R, S, x, y with hom, xIn, yIn).forward with e
    rw h at d
    have dz := singleton.membership.forward with d
    have back : x = (x - y) + y by ring
    rw [back, dz]
    ring

-- For surjective f, extension and contraction are inverse bijections
-- between ideals of S and ideals of R containing the kernel
-- (Ideal.map_comap_of_surjective, Ideal.comap_map_of_surjective,
-- Ideal.comap_injective_of_surjective, Ideal.map_isPrime_of_surjective).
theorem idealExtension.contraction_of_surjective (J : Set)
  requires surjective : SurjectiveBetween(f, R.carrier, S.carrier)
  requires ideal : Ideal(S, J)
  shows idealExtension(f, S, idealComap(f, R.carrier, J)) = J
proof
  have bJ := Ideal.subset at S, J with ideal
  have ceq := idealMap.comap_eq at f, R.carrier, S.carrier, J with surjective, bJ
  unfold idealMap at ceq
  unfold idealExtension
  rw ceq
  exact generatedIdeal.eq_of_ideal at S, J with target, ideal

-- For surjective f, the image of an ideal is already an ideal.
theorem idealExtension.image_of_surjective (I : Set)
  requires surjective : SurjectiveBetween(f, R.carrier, S.carrier)
  requires ideal : Ideal(R, I)
  shows idealExtension(f, S, I) = functionImage(f, I, S.carrier)
proof
  have im := idealMap.ideal at f, R, S, I with source, target, hom, surjective, ideal
  unfold idealMap at im
  unfold idealExtension
  exact generatedIdeal.eq_of_ideal at S, functionImage(f, I, S.carrier) with target, im

theorem idealComap.extension_of_surjective (I : Set)
  requires surjective : SurjectiveBetween(f, R.carrier, S.carrier)
  requires ideal : Ideal(R, I)
  shows idealComap(f, R.carrier, idealExtension(f, S, I)) = idealSum(R, I, ker(f))
proof
  have hom0 := hom
  obtain ⟨_, _, fn, _⟩ := hom0
  have im := idealExtension.image_of_surjective at f, R, S, I with source, target, hom, surjective, ideal
  rw im
  have kerIdeal := ringKernel.ideal at f, R, S with hom
  ext x
  constructor
  . intro h
    obtain ⟨xIn, fx⟩ := idealComap.membership.forward at f, R.carrier, functionImage(f, I, S.carrier), x with h
    obtain ⟨_, i, iI, fxi⟩ := functionImage.membership.forward at f, I, S.carrier, f(x) with fx
    have iIn := Ideal.mem_carrier at R, I, i with ideal, iI
    have dIn : x - i ∈ R.carrier by typecheck
    have fs := RingHom.map_sub at f, R, S, x, i with hom
    have fd : f(x - i) = S[0]
      rw [fs, fxi]
      ring
    have dk := ringKernel.membership.backward at f, R.carrier, S[0], x - i with ⟨dIn, fd⟩
    have law : x = i + (x - i) by ring
    exact idealSum.membership.backward at R, I, ker(f), x with ⟨xIn, i, iI, x - i, dk, law⟩
  . intro h
    obtain ⟨xIn, i, iI, k, kK, xik⟩ := idealSum.membership.forward at R, I, ker(f), x with h
    obtain ⟨kIn, fk⟩ := ringKernel.membership.forward at f, R.carrier, S[0], k with kK
    have iIn := Ideal.mem_carrier at R, I, i with ideal, iI
    have fa := RingHom.map_add at f, R, S, i, k with hom
    have fxIn := FunctionBetween.apply_closed with fn, xIn
    have e : f(x) = f(i)
      rw [xik, fa, fk]
      ring
    have m := functionImage.membership.backward at f, I, S.carrier, f(x) with ⟨fxIn, i, iI, e⟩
    exact idealComap.membership.backward at f, R.carrier, functionImage(f, I, S.carrier), x with ⟨xIn, m⟩

theorem idealExtension.prime_of_surjective (P : Set)
  requires surjective : SurjectiveBetween(f, R.carrier, S.carrier)
  requires prime : PrimeIdeal(R, P)
  requires kernel : ker(f) ⊆ P
  shows PrimeIdeal(S, idealExtension(f, S, P))
proof
  have ideal := PrimeIdeal.to_ideal at R, P with prime
  have im := idealExtension.image_of_surjective at f, R, S, P with source, target, hom, surjective, ideal
  rw im
  have p := idealMap.prime at f, R, S, P with source, target, hom, surjective, prime, kernel
  unfold idealMap at p
  exact p

-- Ideal.map_radical_le.
theorem idealExtension.radical_subset (I : Set)
  requires ideal : Ideal(R, I)
  shows idealExtension(f, S, idealRadical(R, I)) ⊆
    idealRadical(S, idealExtension(f, S, I))
proof
  have hom0 := hom
  obtain ⟨_, _, fn, _⟩ := hom0
  have ringR := CommRing.to_ring with source
  have ringS := CommRing.to_ring with target
  have rad := idealRadical.ideal at R, I with source, ideal
  have eI := idealExtension.ideal at f, R, S, I with source, target, hom
  have T := idealRadical.ideal at S, idealExtension(f, S, I) with target, eI
  have cT := idealComap.ideal_of_hom at f, R, S, idealRadical(S, idealExtension(f, S, I)) with source, target, hom, T
  have sub : idealRadical(R, I) ⊆ idealComap(f, R.carrier, idealRadical(S, idealExtension(f, S, I)))
    intros x hx
    obtain ⟨xIn, n, nN, xn⟩ := idealRadical.membership.forward at R, I, x with hx
    have nNat : Nat(n) by typecheck
    have fxIn := FunctionBetween.apply_closed with fn, xIn
    have m := idealExtension.mem_of_mem at f, R, S, I, Ring.pow(R, x, n) with source, target, hom, ideal, xn
    have mp := RingHom.map_pow at R, S, f, x, n with source, target, hom
    rw mp at m
    have r := idealRadical.membership.backward at S, idealExtension(f, S, I), f(x) with ⟨fxIn, n, nN, m⟩
    exact idealComap.membership.backward at f, R.carrier, idealRadical(S, idealExtension(f, S, I)), x with ⟨xIn, r⟩
  exact (idealExtension.subset_iff at f, R, S, idealRadical(R, I), idealRadical(S, idealExtension(f, S, I)) with source, target, hom, rad, T).backward with sub

end ExtensionContraction

theorem idealComap.compose (f g R S T J : Set)
  requires ringR : CommRing(R)
  requires ringS : CommRing(S)
  requires ringT : CommRing(T)
  requires first : f : R →+* S
  requires second : g : S →+* T
  shows idealComap(f, Ring.carrier(R), idealComap(g, Ring.carrier(S), J)) =
    idealComap(compose(g, f, Ring.carrier(R), Ring.carrier(S),
      Ring.carrier(T)), Ring.carrier(R), J)
proof
  have f0 := first
  obtain ⟨_, _, fn, _⟩ := f0
  have g0 := second
  obtain ⟨_, _, gn, _⟩ := g0
  ext x
  constructor
  . intro h
    obtain ⟨xIn, fx⟩ := idealComap.membership.forward at f, Ring.carrier(R), idealComap(g, Ring.carrier(S), J), x with h
    obtain ⟨fxIn, gfx⟩ := idealComap.membership.forward at g, Ring.carrier(S), J, f(x) with fx
    have c := compose.apply at g, f, Ring.carrier(R), Ring.carrier(S), Ring.carrier(T), x with fn, gn, xIn
    rw ← c at gfx
    exact idealComap.membership.backward at compose(g, f, Ring.carrier(R), Ring.carrier(S), Ring.carrier(T)), Ring.carrier(R), J, x with ⟨xIn, gfx⟩
  . intro h
    obtain ⟨xIn, gfx⟩ := idealComap.membership.forward at compose(g, f, Ring.carrier(R), Ring.carrier(S), Ring.carrier(T)), Ring.carrier(R), J, x with h
    have c := compose.apply at g, f, Ring.carrier(R), Ring.carrier(S), Ring.carrier(T), x with fn, gn, xIn
    rw c at gfx
    have fxIn := FunctionBetween.apply_closed with fn, xIn
    have fx := idealComap.membership.backward at g, Ring.carrier(S), J, f(x) with ⟨fxIn, gfx⟩
    exact idealComap.membership.backward at f, Ring.carrier(R), idealComap(g, Ring.carrier(S), J), x with ⟨xIn, fx⟩

-- Functoriality of extension (Ideal.map_map) and of contraction.
theorem idealExtension.compose (f g R S T I : Set)
  requires ringR : CommRing(R)
  requires ringS : CommRing(S)
  requires ringT : CommRing(T)
  requires first : f : R →+* S
  requires second : g : S →+* T
  requires ideal : Ideal(R, I)
  shows idealExtension(g, T, idealExtension(f, S, I)) =
    idealExtension(compose(g, f, Ring.carrier(R), Ring.carrier(S),
      Ring.carrier(T)), T, I)
proof
  have gf := RingHom.comp at f, g, R, S, T with ringR, first, second
  have eS := idealExtension.ideal at f, R, S, I with ringR, ringS, first
  have L := idealExtension.ideal at g, S, T, idealExtension(f, S, I) with ringS, ringT, second
  have M := idealExtension.ideal at compose(g, f, Ring.carrier(R), Ring.carrier(S), Ring.carrier(T)), R, T, I with ringR, ringT, gf
  have cM := idealComap.ideal_of_hom at g, S, T, idealExtension(compose(g, f, Ring.carrier(R), Ring.carrier(S), Ring.carrier(T)), T, I) with ringS, ringT, second, M
  have cL := idealComap.ideal_of_hom at g, S, T, idealExtension(g, T, idealExtension(f, S, I)) with ringS, ringT, second, L
  have selfM := Subset.reflexive at idealExtension(compose(g, f, Ring.carrier(R), Ring.carrier(S), Ring.carrier(T)), T, I)
  have selfL := Subset.reflexive at idealExtension(g, T, idealExtension(f, S, I))
  have a1 := (idealExtension.subset_iff at compose(g, f, Ring.carrier(R), Ring.carrier(S), Ring.carrier(T)), R, T, I, idealExtension(compose(g, f, Ring.carrier(R), Ring.carrier(S), Ring.carrier(T)), T, I) with ringR, ringT, gf, ideal, M).forward with selfM
  have cc1 := idealComap.compose at f, g, R, S, T, idealExtension(compose(g, f, Ring.carrier(R), Ring.carrier(S), Ring.carrier(T)), T, I) with ringR, ringS, ringT, first, second
  rw ← cc1 at a1
  have a2 := (idealExtension.subset_iff at f, R, S, I, idealComap(g, Ring.carrier(S), idealExtension(compose(g, f, Ring.carrier(R), Ring.carrier(S), Ring.carrier(T)), T, I)) with ringR, ringS, first, ideal, cM).backward with a1
  have s1 := (idealExtension.subset_iff at g, S, T, idealExtension(f, S, I), idealExtension(compose(g, f, Ring.carrier(R), Ring.carrier(S), Ring.carrier(T)), T, I) with ringS, ringT, second, eS, M).backward with a2
  have b1 := (idealExtension.subset_iff at g, S, T, idealExtension(f, S, I), idealExtension(g, T, idealExtension(f, S, I)) with ringS, ringT, second, eS, L).forward with selfL
  have b2 := (idealExtension.subset_iff at f, R, S, I, idealComap(g, Ring.carrier(S), idealExtension(g, T, idealExtension(f, S, I))) with ringR, ringS, first, ideal, cL).forward with b1
  have cc2 := idealComap.compose at f, g, R, S, T, idealExtension(g, T, idealExtension(f, S, I)) with ringR, ringS, ringT, first, second
  rw cc2 at b2
  have s2 := (idealExtension.subset_iff at compose(g, f, Ring.carrier(R), Ring.carrier(S), Ring.carrier(T)), R, T, I, idealExtension(g, T, idealExtension(f, S, I)) with ringR, ringT, gf, ideal, L).backward with b2
  exact Subset.antisymmetric with s1, s2

-- Section: Quotient rings
section Quotients
variable (R I : Set)
hypothesis comm : CommRing(R)
hypothesis ideal : Ideal(R, I)

-- Ideal.Quotient.mk is a surjective homomorphism with kernel I
-- (Ideal.mk_ker, Ideal.Quotient.mk_surjective).
theorem quotientMk.hom
  shows quotientMk(R, I) : R →+* R ⧸ I
proof
  unfold quotientMk
  exact quotientRing.projection_hom at R, I with comm, ideal

theorem quotientMk.surjective
  shows SurjectiveBetween(quotientMk(R, I), R.carrier, Ring.carrier(R ⧸ I))
proof
  unfold quotientMk
  exact quotientRing.projection_surjective at R, I with comm, ideal

theorem quotientMk.kernel
  shows ringKernel(quotientMk(R, I), R.carrier, Ring.zero(R ⧸ I)) = I
proof
  unfold quotientMk
  exact quotientRing.projection_kernel at R, I with comm, ideal

theorem quotientRing.comm_ring_of_ideal
  shows CommRing(R ⧸ I)
proof
  exact quotientRing.comm_ring at R, I with comm, ideal

theorem quotientMk.apply (x : R)
  shows quotientMk(R, I)(x) = ⟦x⟧[R.carrier, quotientRelation(R, I)]
proof
  have eqv := quotientRelation.equivalence at R, I with comm, ideal
  have xIn : x ∈ R.carrier by assumption
  unfold quotientMk
  exact quotientProjection.value at R.carrier, quotientRelation(R, I), x with eqv, xIn

-- Ideal.Quotient.eq, eq_zero_iff_mem, mk_eq_one_iff_sub_mem, and
-- eq_zero_iff_dvd for a principal ideal.
theorem quotientMk.eq_iff (x y : R)
  shows quotientMk(R, I)(x) = quotientMk(R, I)(y) ↔ x - y ∈ I
proof
  rw [(quotientMk.apply at R, I, x with comm, ideal), (quotientMk.apply at R, I, y with comm, ideal)]
  exact quotientRing.class_eq_iff at R, I, x, y with comm, ideal

theorem quotientMk.eq_zero_iff (x : R)
  shows quotientMk(R, I)(x) = Ring.zero(R ⧸ I) ↔ x ∈ I
proof
  rw (quotientMk.apply at R, I, x with comm, ideal)
  rw (quotientRing.zeroOf at R, I)
  exact quotientRing.class_eq_zero_iff at R, I, x with comm, ideal

theorem quotientMk.eq_one_iff (x : R)
  shows quotientMk(R, I)(x) = Ring.one(R ⧸ I) ↔ x - R[1] ∈ I
proof
  rw (quotientMk.apply at R, I, x with comm, ideal)
  rw (quotientRing.oneOf at R, I)
  have oneIn : R[1] ∈ R.carrier by typecheck
  exact quotientRing.class_eq_iff at R, I, x, R[1] with comm, ideal

-- Ideal.Quotient.lift: a homomorphism killing I factors through R ⧸ I,
-- uniquely (Ideal.Quotient.lift_mk, Ideal.Quotient.ringHom_ext), with
-- kernel the image of its kernel (Ideal.ker_quotient_lift).
theorem quotientRingLift.hom (S f : Set)
  requires target : CommRing(S)
  requires map : f : R →+* S
  requires killed : I ⊆ ker(f)
  shows quotientRingLift(R, S, I, f) : R ⧸ I →+* S
proof
  unfold quotientRingLift
  exact RingHom.quotient_hom at f, R, S, I with comm, target, map, ideal, killed

theorem quotientRingLift.apply_mk (S f x : Set)
  requires target : CommRing(S)
  requires map : f : R →+* S
  requires killed : I ⊆ ker(f)
  requires element : x ∈ R.carrier
  shows quotientRingLift(R, S, I, f)(quotientMk(R, I)(x)) = f(x)
proof
  have fact := RingHom.quotient_factorization at f, R, S, I with comm, target, map, ideal, killed
  have map0 := map
  obtain ⟨_, _, fn, _⟩ := map0
  have eqv := quotientRelation.equivalence at R, I with comm, ideal
  have pfn := quotientProjection.function at R.carrier, quotientRelation(R, I) with eqv
  have liftHom := RingHom.quotient_hom at f, R, S, I with comm, target, map, ideal, killed
  obtain ⟨_, _, lfn, _⟩ := liftHom
  rw (quotientRing.carrierOf at R, I) at lfn
  have c := compose.apply at quotientMap(f, R.carrier, S.carrier, quotientRelation(R, I)), quotientProjection(R.carrier, quotientRelation(R, I)), R.carrier, (R.carrier ⧸ quotientRelation(R, I)), S.carrier, x with pfn, lfn, element
  rw fact at c
  unfold quotientRingLift
  unfold quotientMk
  rw c

theorem quotientRingLift.unique (S f g : Set)
  requires target : CommRing(S)
  requires map : g : R ⧸ I →+* S
  requires function : f : R.carrier → S.carrier
  requires agrees : ∀ x ∈ R.carrier, g(quotientMk(R, I)(x)) = f(x)
  shows g = quotientRingLift(R, S, I, f)
proof
  sorry

-- Ideal.Quotient.ringHom_ext.
theorem quotientRing.hom_ext (S g h : Set)
  requires target : CommRing(S)
  requires first : g : R ⧸ I →+* S
  requires second : h : R ⧸ I →+* S
  requires agrees : ∀ x ∈ R.carrier, g(quotientMk(R, I)(x)) = h(quotientMk(R, I)(x))
  shows g = h
proof
  have g0 := first
  obtain ⟨_, _, gfn, _⟩ := g0
  have h0 := second
  obtain ⟨_, _, hfn, _⟩ := h0
  apply FunctionBetween.ext with gfn, hfn
  intros X hX
  have surj := quotientMk.surjective at R, I with comm, ideal
  obtain ⟨_, onto⟩ := surj
  obtain ⟨x, xIn, rel⟩ := onto with X, hX
  have mkHom := quotientMk.hom at R, I with comm, ideal
  obtain ⟨_, _, mfn, _⟩ := mkHom
  have app := FunctionBetween.apply_value with mfn, xIn, rel
  rw ← app
  exact agrees with x, xIn

theorem quotientRingLift.kernel (S f : Set)
  requires target : CommRing(S)
  requires map : f : R →+* S
  requires killed : I ⊆ ker(f)
  shows ringKernel(quotientRingLift(R, S, I, f), Ring.carrier(R ⧸ I), S.zero) =
    functionImage(quotientMk(R, I), ker(f), Ring.carrier(R ⧸ I))
proof
  have lh := quotientRingLift.hom at R, I, S, f with comm, ideal, target, map, killed
  obtain ⟨_, _, lfn, _⟩ := lh
  have mkh := quotientMk.hom at R, I with comm, ideal
  obtain ⟨_, _, mfn, _⟩ := mkh
  have surj := quotientMk.surjective at R, I with comm, ideal
  obtain ⟨_, onto⟩ := surj
  ext X
  constructor
  . intro h
    obtain ⟨XIn, lX⟩ := ringKernel.membership.forward at quotientRingLift(R, S, I, f), Ring.carrier(R ⧸ I), S.zero, X with h
    obtain ⟨x, xIn, rel⟩ := onto with X, XIn
    have Xx := FunctionBetween.apply_value with mfn, xIn, rel
    have a := quotientRingLift.apply_mk at R, I, S, f, x with comm, ideal, target, map, killed, xIn
    rw Xx at a
    rw a at lX
    have xk := ringKernel.membership.backward at f, R.carrier, S.zero, x with ⟨xIn, lX⟩
    symm at Xx
    exact functionImage.membership.backward at quotientMk(R, I), ker(f), Ring.carrier(R ⧸ I), X with ⟨XIn, x, xk, Xx⟩
  . intro h
    obtain ⟨XIn, x, xk, Xx⟩ := functionImage.membership.forward at quotientMk(R, I), ker(f), Ring.carrier(R ⧸ I), X with h
    obtain ⟨xIn, fx⟩ := ringKernel.membership.forward at f, R.carrier, S.zero, x with xk
    have a := quotientRingLift.apply_mk at R, I, S, f, x with comm, ideal, target, map, killed, xIn
    rw ← Xx at a
    rw fx at a
    exact ringKernel.membership.backward at quotientRingLift(R, S, I, f), Ring.carrier(R ⧸ I), S.zero, X with ⟨XIn, a⟩

-- Ideals of R ⧸ I correspond to ideals of R containing I (Ideal.map_mk,
-- Ideal.comap_map_quotientMk, Ideal.map_quotient_self).
theorem quotientRing.ideal_correspondence (J : Set)
  requires idealJ : Ideal(R, J)
  requires contains : I ⊆ J
  shows Ideal(R ⧸ I, idealExtension(quotientMk(R, I), R ⧸ I, J)) ∧
    idealComap(quotientMk(R, I), R.carrier,
      idealExtension(quotientMk(R, I), R ⧸ I, J)) = J
proof
  have qc := quotientRing.comm_ring at R, I with comm, ideal
  have mkHom := quotientMk.hom at R, I with comm, ideal
  have surj := quotientMk.surjective at R, I with comm, ideal
  have img := idealExtension.image_of_surjective at quotientMk(R, I), R, R ⧸ I, J with comm, qc, mkHom, surj, idealJ
  have ext := idealExtension.ideal at quotientMk(R, I), R, R ⧸ I, J with comm, qc, mkHom
  have ker := quotientMk.kernel at R, I with comm, ideal
  have kerSub : ringKernel(quotientMk(R, I), R.carrier, Ring.zero(R ⧸ I)) ⊆ J
    rw ker
    exact contains
  have meq := idealComap.map_eq at quotientMk(R, I), R, R ⧸ I, J with comm, qc, mkHom, idealJ, kerSub
  unfold idealMap at meq
  rw img
  rw img at ext
  exact ⟨ext, meq⟩

theorem quotientRing.extension_self
  shows idealExtension(quotientMk(R, I), R ⧸ I, I) = {Ring.zero(R ⧸ I)}
proof
  have qc := quotientRing.comm_ring at R, I with comm, ideal
  have mkHom := quotientMk.hom at R, I with comm, ideal
  have ker := quotientMk.kernel at R, I with comm, ideal
  have sub : I ⊆ ringKernel(quotientMk(R, I), R.carrier, Ring.zero(R ⧸ I))
    rw ker
    exact Subset.reflexive at I
  exact (idealExtension.eq_zero_iff at quotientMk(R, I), R, R ⧸ I, I with comm, qc, mkHom, ideal).backward with sub

-- R ⧸ I is nontrivial iff I is proper, a domain iff I is prime
-- (Ideal.Quotient.isDomain_iff_prime), and a field iff I is maximal
-- (Ideal.Quotient.maximal_ideal_iff_isField_quotient, Ideal.Quotient.field).
theorem quotientRing.nontrivial_iff
  shows Ring.zero(R ⧸ I) ≠ Ring.one(R ⧸ I) ↔ ProperIdeal(R, I)
proof
  have ringR := CommRing.to_ring with comm
  have oneIn : R[1] ∈ R.carrier by typecheck
  have cz := quotientRing.class_eq_zero_iff at R, I, R[1] with comm, ideal
  rw [(quotientRing.zeroOf at R, I), (quotientRing.oneOf at R, I)]
  constructor
  . intro h
    have out : R[1] ∉ I
      intro oneI
      have e := cz.backward with oneI
      have e2 : ⟦R[0]⟧[R.carrier, quotientRelation(R, I)] = ⟦R[1]⟧[R.carrier, quotientRelation(R, I)] by rw e
      exact h with e2
    exact ProperIdeal.mk at R, I with ringR, ideal, out
  . intro h
    intro e
    have e2 : ⟦R[1]⟧[R.carrier, quotientRelation(R, I)] = ⟦R[0]⟧[R.carrier, quotientRelation(R, I)] by rw e
    have oneI := cz.forward with e2
    exact (ProperIdeal.one_not_mem at R, I with h) with oneI

theorem quotientRing.domain_iff
  shows IntegralDomain(R ⧸ I) ↔ PrimeIdeal(R, I)
proof
  have qc := quotientRing.comm_ring at R, I with comm, ideal
  have ringR := CommRing.to_ring with comm
  have nti := quotientRing.nontrivial_iff at R, I with comm, ideal
  constructor
  . intro dom
    obtain ⟨_, nt, nzd⟩ := dom
    rw (quotientRing.zeroOf at R, I) at nzd
    have proper := nti.forward with nt
    have law : ∀ x y ∈ R.carrier, x * y ∈ I → x ∈ I ∨ y ∈ I
      intros x xIn y yIn xy
      have cx : ⟦x⟧[R.carrier, quotientRelation(R, I)] ∈ Ring.carrier(R ⧸ I) by typecheck
      have cy : ⟦y⟧[R.carrier, quotientRelation(R, I)] ∈ Ring.carrier(R ⧸ I) by typecheck
      have m := quotientRing.mul_class at R, I, x, y with comm, ideal
      have z := (quotientRing.class_eq_zero_iff at R, I, x * y with comm, ideal).backward with xy
      rw z at m
      rcases nzd with ⟦x⟧[R.carrier, quotientRelation(R, I)], cx, ⟦y⟧[R.carrier, quotientRelation(R, I)], cy, m with a | b
      . left
        exact (quotientRing.class_eq_zero_iff at R, I, x with comm, ideal).forward with a
      . right
        exact (quotientRing.class_eq_zero_iff at R, I, y with comm, ideal).forward with b
    exact ⟨proper, law⟩
  . intro prime
    have proper := PrimeIdeal.to_proper at R, I with prime
    have nt := nti.backward with proper
    have nzd : ∀ X Y ∈ Ring.carrier(R ⧸ I), call2(Ring.mul(R ⧸ I), X, Y) = Ring.zero(R ⧸ I) → X = Ring.zero(R ⧸ I) ∨ Y = Ring.zero(R ⧸ I)
      intros X hX Y hY e
      rw (quotientRing.zeroOf at R, I) at e
      rw (quotientRing.zeroOf at R, I)
      obtain ⟨x, xIn, Xx⟩ := quotientRing.representative at R, I, X with comm, ideal, hX
      obtain ⟨y, yIn, Yy⟩ := quotientRing.representative at R, I, Y with comm, ideal, hY
      rw [Xx, Yy] at e
      have m := quotientRing.mul_class at R, I, x, y with comm, ideal
      rw m at e
      have xyI := (quotientRing.class_eq_zero_iff at R, I, x * y with comm, ideal).forward with e
      rcases PrimeIdeal.mem_or_mem at R, I, x, y with ringR, prime, xIn, yIn, xyI with a | b
      . left
        rw Xx
        exact (quotientRing.class_eq_zero_iff at R, I, x with comm, ideal).backward with a
      . right
        rw Yy
        exact (quotientRing.class_eq_zero_iff at R, I, y with comm, ideal).backward with b
    exact ⟨qc, nt, nzd⟩

theorem quotientRing.field_iff
  shows Field(R ⧸ I) ↔ MaximalIdeal(R, I)
proof
  have qc := quotientRing.comm_ring at R, I with comm, ideal
  have ringR := CommRing.to_ring with comm
  have ringQ := CommRing.to_ring with qc
  have nti := quotientRing.nontrivial_iff at R, I with comm, ideal
  constructor
  . intro field
    have dom := Field.domain at R ⧸ I with field
    have nt := IntegralDomain.nontrivial at R ⧸ I with dom
    have proper := nti.forward with nt
    have maximality : ∀ K, ProperIdeal(R, K) → I ⊆ K → K = I
      intros K properK sub
      have idealK := ProperIdeal.to_ideal at R, K with properK
      apply Subset.antisymmetric
      . intros x xK
        by_contra xI
        have xIn := Ideal.mem_carrier at R, K, x with idealK, xK
        have cx : ⟦x⟧[R.carrier, quotientRelation(R, I)] ∈ Ring.carrier(R ⧸ I) by typecheck
        have nz : ⟦x⟧[R.carrier, quotientRelation(R, I)] ≠ Ring.zero(R ⧸ I)
          intro e
          rw (quotientRing.zeroOf at R, I) at e
          have xI2 := (quotientRing.class_eq_zero_iff at R, I, x with comm, ideal).forward with e
          exact xI with xI2
        have u := (Field.unit_iff at R ⧸ I, ⟦x⟧[R.carrier, quotientRelation(R, I)] with field, cx).backward with nz
        obtain ⟨_, Y, hY, xy, _⟩ := u
        obtain ⟨y, yIn, Yy⟩ := quotientRing.representative at R, I, Y with comm, ideal, hY
        rw Yy at xy
        rw (quotientRing.mul_class at R, I, x, y with comm, ideal) at xy
        rw (quotientRing.oneOf at R, I) at xy
        have oneIn : R[1] ∈ R.carrier by typecheck
        have d := (quotientRing.class_eq_iff at R, I, x * y, R[1] with comm, ideal).forward with xy
        have dK := sub with d
        have xyK := Ideal.mul_right_mem at R, K, y, x with idealK, yIn, xK
        have oneK : R[1] ∈ K
          have e : R[1] = x * y - (x * y - R[1]) by ring
          rw e
          exact Ideal.sub_mem at R, K, x * y, x * y - R[1] with idealK, xyK, dK
        exact (ProperIdeal.one_not_mem at R, K with properK) with oneK
      . exact sub
    exact ⟨proper, maximality⟩
  . intro maximal
    have proper := MaximalIdeal.to_proper at R, I with maximal
    have nt := nti.backward with proper
    have parts := CommRing.parts at R ⧸ I with qc
    have zeroIn : Ring.zero(R ⧸ I) ∈ Ring.carrier(R ⧸ I) by typecheck
    have oneIn : Ring.one(R ⧸ I) ∈ Ring.carrier(R ⧸ I) by typecheck
    have inverses : ∀ X ∈ Ring.carrier(R ⧸ I), X ≠ Ring.zero(R ⧸ I) → ∃ Y, IsInverse(Ring.carrier(R ⧸ I), Ring.mul(R ⧸ I), Ring.one(R ⧸ I), X, Y)
      intros X hX nz
      obtain ⟨x, xIn, Xx⟩ := quotientRing.representative at R, I, X with comm, ideal, hX
      have xOut : x ∉ I
        intro xI
        have e := (quotientRing.class_eq_zero_iff at R, I, x with comm, ideal).backward with xI
        rw ← (quotientRing.zeroOf at R, I) at e
        rw ← Xx at e
        exact nz with e
      obtain ⟨y, yIn, m, mI, law⟩ := MaximalIdeal.exists_inverse at R, I, x with comm, maximal, xIn, xOut
      have cy : ⟦y⟧[R.carrier, quotientRelation(R, I)] ∈ Ring.carrier(R ⧸ I) by typecheck
      have xy : call2(Ring.mul(R ⧸ I), X, ⟦y⟧[R.carrier, quotientRelation(R, I)]) = Ring.one(R ⧸ I)
        rw [Xx, (quotientRing.mul_class at R, I, x, y with comm, ideal), (quotientRing.oneOf at R, I)]
        have oneR : R[1] ∈ R.carrier by typecheck
        apply (quotientRing.class_eq_iff at R, I, x * y, R[1] with comm, ideal).backward
        have mIn := Ideal.mem_carrier at R, I, m with ideal, mI
        have e : x * y - R[1] = -m
          rw ← law
          ring
        rw e
        exact Ideal.neg_mem at R, I, m with ideal, mI
      have yx : call2(Ring.mul(R ⧸ I), ⟦y⟧[R.carrier, quotientRelation(R, I)], X) = Ring.one(R ⧸ I)
        rw ← xy
        ring
      unfold IsInverse
      exact ⟨⟦y⟧[R.carrier, quotientRelation(R, I)], hX, cy, yx, xy⟩
    have isField : IsField(Ring.carrier(R ⧸ I), Ring.add(R ⧸ I), Ring.zero(R ⧸ I), Ring.neg(R ⧸ I), Ring.mul(R ⧸ I), Ring.one(R ⧸ I))
      unfold IsField
      unfold Nontrivial
      exact ⟨parts, ⟨zeroIn, oneIn, nt⟩, inverses⟩
    have eta := Ring.eta_of_ring at R ⧸ I with ringQ
    rw eta
    exact Field.of_parts with isField

-- The quotient by a finitely generated ideal I: a homomorphism killing the
-- generators kills I.
theorem quotientRing.kills_generated (S f G : Set)
  requires target : CommRing(S)
  requires map : f : R →+* S
  requires bounded : G ⊆ R.carrier
  requires generators : ∀ g ∈ G, f(g) = S[0]
  shows generatedIdeal(R, G) ⊆ ker(f)
proof
  have kerIdeal := ringKernel.ideal at f, R, S with map
  have sub : G ⊆ ker(f)
    intros g gG
    have gIn := bounded with gG
    exact (RingHom.mem_kernel_iff at f, R, S, g with map, gIn).backward with (generators with g, gG)
  exact generatedIdeal.least at R, G, ker(f) with comm, kerIdeal, sub

end Quotients

-- Maps between quotients (Ideal.quotientMap, Ideal.quotientMap_mk,
-- Ideal.quotientMap_injective', Ideal.Quotient.factor, factor_eq,
-- factor_surjective).
section QuotientMaps
variable (f R S I J : Set)
hypothesis source : CommRing(R)
hypothesis target : CommRing(S)
hypothesis hom : f : R →+* S
hypothesis idealI : Ideal(R, I)
hypothesis idealJ : Ideal(S, J)
hypothesis compatible : I ⊆ idealComap(f, R.carrier, J)

theorem quotientRingMap.composite_hom
  shows compose(quotientMk(S, J), f, R.carrier, S.carrier, Ring.carrier(quotientRing(S, J))) : R →+* quotientRing(S, J)
proof
  have mkHom := quotientMk.hom at S, J with target, idealJ
  exact RingHom.comp at f, quotientMk(S, J), R, S, quotientRing(S, J) with source, hom, mkHom

theorem quotientRingMap.composite_apply (x : R)
  shows compose(quotientMk(S, J), f, R.carrier, S.carrier, Ring.carrier(quotientRing(S, J)))(x) = quotientMk(S, J)(f(x))
proof
  have hom0 := hom
  obtain ⟨_, _, fn, _⟩ := hom0
  have mkHom := quotientMk.hom at S, J with target, idealJ
  obtain ⟨_, _, mfn, _⟩ := mkHom
  have xIn : x ∈ R.carrier by assumption
  exact compose.apply at quotientMk(S, J), f, R.carrier, S.carrier, Ring.carrier(quotientRing(S, J)), x with fn, mfn, xIn

theorem quotientRingMap.killed
  shows I ⊆ ringKernel(compose(quotientMk(S, J), f, R.carrier, S.carrier, Ring.carrier(quotientRing(S, J))), R.carrier, Ring.zero(quotientRing(S, J)))
proof
  have qc := quotientRing.comm_ring at S, J with target, idealJ
  have ch := quotientRingMap.composite_hom at f, R, S, I, J with source, target, hom, idealI, idealJ, compatible
  intros x xI
  have xIn := Ideal.mem_carrier at R, I, x with idealI, xI
  obtain ⟨_, fxJ⟩ := idealComap.membership.forward at f, R.carrier, J, x with (compatible with xI)
  have ca := quotientRingMap.composite_apply at f, R, S, I, J, x with source, target, hom, idealI, idealJ, compatible
  have fx : f(x) ∈ S.carrier by typecheck
  have z := (quotientMk.eq_zero_iff at S, J, f(x) with target, idealJ, fx).backward with fxJ
  rw z at ca
  exact (RingHom.mem_kernel_iff at compose(quotientMk(S, J), f, R.carrier, S.carrier, Ring.carrier(quotientRing(S, J))), R, quotientRing(S, J), x with ch, xIn).backward with ca

theorem quotientRingMap.hom
  shows quotientRingMap(R, S, f, I, J) : R ⧸ I →+* S ⧸ J
proof
  have qc := quotientRing.comm_ring at S, J with target, idealJ
  have ch := quotientRingMap.composite_hom at f, R, S, I, J with source, target, hom, idealI, idealJ, compatible
  have k := quotientRingMap.killed at f, R, S, I, J with source, target, hom, idealI, idealJ, compatible
  unfold quotientRingMap
  exact quotientRingLift.hom at R, I, quotientRing(S, J), compose(quotientMk(S, J), f, R.carrier, S.carrier, Ring.carrier(quotientRing(S, J))) with source, idealI, qc, ch, k

theorem quotientRingMap.apply_mk (x : R)
  shows quotientRingMap(R, S, f, I, J)(quotientMk(R, I)(x)) =
    quotientMk(S, J)(f(x))
proof
  have qc := quotientRing.comm_ring at S, J with target, idealJ
  have ch := quotientRingMap.composite_hom at f, R, S, I, J with source, target, hom, idealI, idealJ, compatible
  have k := quotientRingMap.killed at f, R, S, I, J with source, target, hom, idealI, idealJ, compatible
  have xIn : x ∈ R.carrier by assumption
  have a := quotientRingLift.apply_mk at R, I, quotientRing(S, J), compose(quotientMk(S, J), f, R.carrier, S.carrier, Ring.carrier(quotientRing(S, J))), x with source, idealI, qc, ch, k, xIn
  have ca := quotientRingMap.composite_apply at f, R, S, I, J, x with source, target, hom, idealI, idealJ, compatible
  rw ca at a
  unfold quotientRingMap
  exact a

-- The induced map is injective when I is the full contraction of J.
theorem quotientRingMap.injective
  requires contraction : idealComap(f, R.carrier, J) = I
  shows InjectiveBetween(quotientRingMap(R, S, f, I, J),
    Ring.carrier(R ⧸ I), Ring.carrier(S ⧸ J))
proof
  have mh := quotientRingMap.hom at f, R, S, I, J with source, target, hom, idealI, idealJ, compatible
  obtain ⟨_, _, mfn, _⟩ := mh
  apply Injective.of_pointwise with mfn
  intros X hX Y hY e
  have si := quotientMk.surjective at R, I with source, idealI
  obtain ⟨_, ontoI⟩ := si
  obtain ⟨x, xIn, rx⟩ := ontoI with X, hX
  obtain ⟨y, yIn, ry⟩ := ontoI with Y, hY
  have mkI := quotientMk.hom at R, I with source, idealI
  obtain ⟨_, _, mifn, _⟩ := mkI
  have xX := FunctionBetween.apply_value with mifn, xIn, rx
  have yY := FunctionBetween.apply_value with mifn, yIn, ry
  rw [← xX, ← yY] at e
  rw [← xX, ← yY]
  rw [(quotientRingMap.apply_mk at f, R, S, I, J, x with source, target, hom, idealI, idealJ, compatible), (quotientRingMap.apply_mk at f, R, S, I, J, y with source, target, hom, idealI, idealJ, compatible)] at e
  have fx : f(x) ∈ S.carrier by typecheck
  have fy : f(y) ∈ S.carrier by typecheck
  have d := (quotientMk.eq_iff at S, J, f(x), f(y) with target, idealJ, fx, fy).forward with e
  have sub := RingHom.map_sub at f, R, S, x, y with hom
  rw ← sub at d
  have dIn : x - y ∈ R.carrier by typecheck
  have c := idealComap.membership.backward at f, R.carrier, J, x - y with ⟨dIn, d⟩
  rw contraction at c
  exact (quotientMk.eq_iff at R, I, x, y with source, idealI, xIn, yIn).backward with c

theorem quotientRingMap.surjective
  requires surjective : SurjectiveBetween(f, R.carrier, S.carrier)
  shows SurjectiveBetween(quotientRingMap(R, S, f, I, J),
    Ring.carrier(R ⧸ I), Ring.carrier(S ⧸ J))
proof
  have mh := quotientRingMap.hom at f, R, S, I, J with source, target, hom, idealI, idealJ, compatible
  obtain ⟨_, _, mfn, _⟩ := mh
  refine ⟨mfn, ?_⟩
  intros Y hY
  have sj := quotientMk.surjective at S, J with target, idealJ
  obtain ⟨_, ontoJ⟩ := sj
  obtain ⟨s, sIn, relS⟩ := ontoJ with Y, hY
  have mkJ := quotientMk.hom at S, J with target, idealJ
  obtain ⟨_, _, mjfn, _⟩ := mkJ
  have ys := FunctionBetween.apply_value with mjfn, sIn, relS
  obtain ⟨_, ontoF⟩ := surjective
  obtain ⟨x, xIn, relF⟩ := ontoF with s, sIn
  have hom0 := hom
  obtain ⟨_, _, fn, _⟩ := hom0
  have fs := FunctionBetween.apply_value with fn, xIn, relF
  have mkI := quotientMk.hom at R, I with source, idealI
  obtain ⟨_, _, mifn, _⟩ := mkI
  have Xin := FunctionBetween.apply_closed with mifn, xIn
  have a := quotientRingMap.apply_mk at f, R, S, I, J, x with source, target, hom, idealI, idealJ, compatible
  rw [fs, ys] at a
  have rel := FunctionBetween.relates_apply with mfn, Xin
  rw a at rel
  exact ⟨quotientMk(R, I)(x), Xin, rel⟩

end QuotientMaps

section QuotientFactor
variable (R I J : Set)
hypothesis comm : CommRing(R)
hypothesis idealI : Ideal(R, I)
hypothesis idealJ : Ideal(R, J)
hypothesis subset : I ⊆ J

theorem quotientFactor.hom
  shows quotientFactor(R, I, J) : R ⧸ I →+* R ⧸ J
proof
  have qc := quotientRing.comm_ring at R, J with comm, idealJ
  have mkJ := quotientMk.hom at R, J with comm, idealJ
  have ker := quotientMk.kernel at R, J with comm, idealJ
  have k : I ⊆ ringKernel(quotientMk(R, J), R.carrier, Ring.zero(R ⧸ J))
    rw ker
    exact subset
  unfold quotientFactor
  exact quotientRingLift.hom at R, I, quotientRing(R, J), quotientMk(R, J) with comm, idealI, qc, mkJ, k

theorem quotientFactor.apply_mk (x : R)
  shows quotientFactor(R, I, J)(quotientMk(R, I)(x)) = quotientMk(R, J)(x)
proof
  have qc := quotientRing.comm_ring at R, J with comm, idealJ
  have mkJ := quotientMk.hom at R, J with comm, idealJ
  have ker := quotientMk.kernel at R, J with comm, idealJ
  have k : I ⊆ ringKernel(quotientMk(R, J), R.carrier, Ring.zero(R ⧸ J))
    rw ker
    exact subset
  have xIn : x ∈ R.carrier by assumption
  unfold quotientFactor
  exact quotientRingLift.apply_mk at R, I, quotientRing(R, J), quotientMk(R, J), x with comm, idealI, qc, mkJ, k, xIn

theorem quotientFactor.surjective
  shows SurjectiveBetween(quotientFactor(R, I, J), Ring.carrier(R ⧸ I),
    Ring.carrier(R ⧸ J))
proof
  have fh := quotientFactor.hom at R, I, J with comm, idealI, idealJ, subset
  obtain ⟨_, _, ffn, _⟩ := fh
  refine ⟨ffn, ?_⟩
  intros Y hY
  have sj := quotientMk.surjective at R, J with comm, idealJ
  obtain ⟨_, ontoJ⟩ := sj
  obtain ⟨x, xIn, rel⟩ := ontoJ with Y, hY
  have mkJ := quotientMk.hom at R, J with comm, idealJ
  obtain ⟨_, _, mjfn, _⟩ := mkJ
  have yx := FunctionBetween.apply_value with mjfn, xIn, rel
  have mkI := quotientMk.hom at R, I with comm, idealI
  obtain ⟨_, _, mifn, _⟩ := mkI
  have Xin := FunctionBetween.apply_closed with mifn, xIn
  have a := quotientFactor.apply_mk at R, I, J, x with comm, idealI, idealJ, subset
  rw yx at a
  have r := FunctionBetween.relates_apply with ffn, Xin
  rw a at r
  exact ⟨quotientMk(R, I)(x), Xin, r⟩

-- The third isomorphism theorem: the kernel of R ⧸ I → R ⧸ J is J ⧸ I
-- (Ideal.quotientQuotientEquivQuotient).
theorem quotientFactor.kernel
  shows ringKernel(quotientFactor(R, I, J), Ring.carrier(R ⧸ I),
      Ring.zero(R ⧸ J)) =
    functionImage(quotientMk(R, I), J, Ring.carrier(R ⧸ I))
proof
  have qc := quotientRing.comm_ring at R, J with comm, idealJ
  have mkJ := quotientMk.hom at R, J with comm, idealJ
  have ker := quotientMk.kernel at R, J with comm, idealJ
  have k : I ⊆ ringKernel(quotientMk(R, J), R.carrier, Ring.zero(R ⧸ J))
    rw ker
    exact subset
  have a := quotientRingLift.kernel at R, I, quotientRing(R, J), quotientMk(R, J) with comm, idealI, qc, mkJ, k
  rw ker at a
  unfold quotientFactor
  exact a

end QuotientFactor

-- The first isomorphism theorem for a surjective homomorphism
-- (RingHom.quotientKerEquivOfSurjective, Ideal.quotientKerAlgEquivOfSurjective).
theorem RingHom.quotient_kernel_iso (f R S : Set)
  requires source : CommRing(R)
  requires target : CommRing(S)
  requires hom : f : R →+* S
  requires surjective : SurjectiveBetween(f, Ring.carrier(R), Ring.carrier(S))
  shows quotientRingLift(R, S, ringKernel(f, Ring.carrier(R), Ring.zero(S)), f) :
    R ⧸ ringKernel(f, Ring.carrier(R), Ring.zero(S)) ≃+* S
proof
  unfold quotientRingLift
  exact RingHom.first_isomorphism with source, target, hom, surjective

-- Equal ideals give equal quotients (Ideal.quotientEquivAlgOfEq).
theorem quotientRing.congr (R I J : Set)
  requires equal : I = J
  shows quotientRing(R, I) = quotientRing(R, J)
proof
  rw equal

-- Section: Products of rings and the Chinese remainder theorem
section PiRings
variable (I F : Set)
hypothesis rings : ∀ i ∈ I, CommRing(F(i))

theorem piRing.comm_ring
  shows CommRing(piRing(I, F))
proof
  sorry

theorem piRing.carrier_mem (u : Set)
  shows u ∈ Ring.carrier(piRing(I, F)) ↔
    (u : I → piUnion(I, F)) ∧ (∀ i ∈ I, u(i) ∈ Ring.carrier(F(i)))
proof
  sorry

theorem piRing.add_apply (u v i : Set)
  requires first : u ∈ Ring.carrier(piRing(I, F))
  requires second : v ∈ Ring.carrier(piRing(I, F))
  requires index : i ∈ I
  shows call2(Ring.add(piRing(I, F)), u, v)(i) = call2(Ring.add(F(i)), u(i), v(i))
proof
  sorry

theorem piRing.mul_apply (u v i : Set)
  requires first : u ∈ Ring.carrier(piRing(I, F))
  requires second : v ∈ Ring.carrier(piRing(I, F))
  requires index : i ∈ I
  shows call2(Ring.mul(piRing(I, F)), u, v)(i) = call2(Ring.mul(F(i)), u(i), v(i))
proof
  sorry

theorem piRing.one_apply (i : Set)
  requires index : i ∈ I
  shows Ring.one(piRing(I, F))(i) = Ring.one(F(i))
proof
  sorry

theorem piRing.zero_apply (i : Set)
  requires index : i ∈ I
  shows Ring.zero(piRing(I, F))(i) = Ring.zero(F(i))
proof
  sorry

-- Pi.ext: elements agreeing at every index are equal.
theorem piRing.ext (u v : Set)
  requires first : u ∈ Ring.carrier(piRing(I, F))
  requires second : v ∈ Ring.carrier(piRing(I, F))
  requires agree : ∀ i ∈ I, u(i) = v(i)
  shows u = v
proof
  sorry

theorem piProjection.hom (i : Set)
  requires index : i ∈ I
  shows piProjection(I, F, i) : piRing(I, F) →+* F(i)
proof
  sorry

-- Pi.ringHom: a family of homomorphisms into the factors is one
-- homomorphism into the product, and it is the only one with those
-- projections.
theorem piLift.hom (R f : Set)
  requires source : CommRing(R)
  requires homs : ∀ i ∈ I, f(i) : R →+* F(i)
  shows piLift(R, I, F, f) : R →+* piRing(I, F)
proof
  sorry

theorem piLift.apply (R f x i : Set)
  requires source : CommRing(R)
  requires homs : ∀ i ∈ I, f(i) : R →+* F(i)
  requires element : x ∈ Ring.carrier(R)
  requires index : i ∈ I
  shows piLift(R, I, F, f)(x)(i) = f(i)(x)
proof
  sorry

theorem piLift.unique (R f g : Set)
  requires source : CommRing(R)
  requires map : g : R →+* piRing(I, F)
  requires agrees : ∀ i ∈ I, ∀ x ∈ Ring.carrier(R), g(x)(i) = f(i)(x)
  shows g = piLift(R, I, F, f)
proof
  sorry

end PiRings

-- The Chinese remainder theorem: for pairwise coprime ideals I(0), …,
-- I(n − 1), R ⧸ ⋂ I(k) ≅ Πₖ R ⧸ I(k) (Ideal.quotientInfRingEquivPiQuotient;
-- the injectivity Ideal.quotientInfToPiQuotient_inj holds for every
-- family). Without the isomorphism, the elementwise form
-- Ideal.exists_forall_sub_mem_ideal: congruences modulo pairwise coprime
-- ideals have a common solution.
section ChineseRemainder
variable (R I : Set) (n : Nat)
hypothesis comm : CommRing(R)
hypothesis ideals : ∀ k ∈ n, Ideal(R, I(k))

theorem chineseRemainderMap.hom
  shows chineseRemainderMap(R, n, I) :
    R ⧸ idealFamilyIntersection(R, n, I) →+* piRing(n, quotientFamily(R, n, I))
proof
  sorry

theorem chineseRemainderMap.injective
  shows InjectiveBetween(chineseRemainderMap(R, n, I),
    Ring.carrier(R ⧸ idealFamilyIntersection(R, n, I)),
    Ring.carrier(piRing(n, quotientFamily(R, n, I))))
proof
  sorry

theorem chineseRemainderMap.iso
  requires coprime : ∀ j k ∈ n, j ≠ k → idealSum(R, I(j), I(k)) = R.carrier
  shows chineseRemainderMap(R, n, I) :
    R ⧸ idealFamilyIntersection(R, n, I) ≃+* piRing(n, quotientFamily(R, n, I))
proof
  sorry

theorem chineseRemainder.exists_solution (x : Set)
  requires coprime : ∀ j k ∈ n, j ≠ k → idealSum(R, I(j), I(k)) = R.carrier
  requires targets : x : n → R.carrier
  shows ∃ y ∈ R.carrier, ∀ k ∈ n, call2(R.add, y, apply(R.neg, x(k))) ∈ I(k)
proof
  sorry

end ChineseRemainder

-- Section: The index of an ideal
-- The number of elements of R ⧸ I when it is finite (Submodule.cardQuot,
-- Ideal.absNorm on the rings where quotients are finite); outside that
-- case no value is asserted.
section IdealIndex
variable (R : Set)
hypothesis comm : CommRing(R)

theorem quotientRing.index_one
  shows HasCardinality(Ring.carrier(R ⧸ R.carrier), 1)
proof
  sorry

-- The index is 1 exactly for the whole ring (Ideal.absNorm_eq_one_iff).
theorem quotientRing.index_one_iff (I : Set)
  requires ideal : Ideal(R, I)
  shows HasCardinality(Ring.carrier(R ⧸ I), 1) ↔ I = R.carrier
proof
  sorry

-- The index is multiplicative along I ⊆ J: |R ⧸ I| = |R ⧸ J| |J ⧸ I|,
-- read as |R ⧸ I| = |R ⧸ J| · |{classes of J}| (Submodule.cardQuot_mul
-- in the tower form).
theorem quotientRing.index_tower (I J : Set) (a b : Nat)
  requires first : Ideal(R, I)
  requires second : Ideal(R, J)
  requires subset : I ⊆ J
  requires outer : HasCardinality(Ring.carrier(R ⧸ J), a)
  requires inner : HasCardinality(functionImage(quotientMk(R, I), J,
    Ring.carrier(R ⧸ I)), b)
  shows HasCardinality(Ring.carrier(R ⧸ I), a * b)
proof
  sorry

-- An ideal of finite index containing a product: in the Chinese
-- remainder situation, the index of a finite intersection of pairwise
-- coprime ideals is the product of the indices (Ideal.absNorm_mul for
-- coprime ideals).
theorem quotientRing.index_coprime (I J : Set) (a b : Nat)
  requires first : Ideal(R, I)
  requires second : Ideal(R, J)
  requires coprime : idealSum(R, I, J) = R.carrier
  requires indexI : HasCardinality(Ring.carrier(R ⧸ I), a)
  requires indexJ : HasCardinality(Ring.carrier(R ⧸ J), b)
  shows HasCardinality(Ring.carrier(R ⧸ (I ∩ J)), a * b)
proof
  sorry

end IdealIndex

-- Section: Ideals and modules
section IdealsAsModules
variable (R : Set)
hypothesis comm : CommRing(R)

-- An ideal is a submodule of R over itself (Ideal := Submodule R R), and
-- the ideal generated by G is its span.
theorem Ideal.iff_submodule (I : Set)
  shows Ideal(R, I) ↔ SubmoduleOf(I, selfModule(R), R)
proof
  have ringR := CommRing.to_ring with comm
  have mod := Ring.to_module at R with ringR
  have c := selfModule.carrier_eq at R
  have z := selfModule.zero_eq at R
  have a := selfModule.add_eq at R
  have s := selfModule.smul_eq at R
  constructor
  . intro ideal
    have sub := Ideal.subset at R, I with ideal
    have zero := Ideal.zero_mem at R, I with ideal
    have adds : ∀ v w ∈ I, v + w ∈ I
      intros v hv w hw
      exact Ideal.add_mem at R, I, v, w with ideal, hv, hw
    have smuls : ∀ r ∈ R.carrier, ∀ v ∈ I, r * v ∈ I
      intros r hr v hv
      exact Ideal.mul_left_mem at R, I, r, v with ideal, hr, hv
    unfold SubmoduleOf
    rw [c, z, a, s]
    exact ⟨mod, sub, zero, adds, smuls⟩
  . intro h
    obtain ⟨_, sub, zero, adds, smuls⟩ := h
    rw c at sub
    rw z at zero
    rw a at adds
    rw s at smuls
    apply Ideal.mk at R, I with ringR
    . exact sub
    . exact zero
    . exact adds
    . intros x hx
      have xIn := sub with hx
      have mIn : -R[1] ∈ R.carrier by typecheck
      have m := smuls with -R[1], mIn, x, hx
      have e : -R[1] * x = -x by ring
      rw e at m
      exact m
    . intros r hr x hx
      have xIn := sub with hx
      have m := smuls with r, hr, x, hx
      have e : x * r = r * x by ring
      rw ← e at m
      have m2 := smuls with r, hr, x, hx
      exact ⟨m2, m⟩

theorem generatedIdeal.module_span (G : Set)
  requires bounded : G ⊆ R.carrier
  shows generatedIdeal(R, G) = moduleSpan(selfModule(R), R, G)
proof
  have ringR := CommRing.to_ring with comm
  have mod := Ring.to_module at R with ringR
  have c := selfModule.carrier_eq at R
  have spanSub := moduleSpan.submodule at R, selfModule(R), G with ringR, mod
  have spanIdeal := (Ideal.iff_submodule at R, moduleSpan(selfModule(R), R, G) with comm).backward with spanSub
  have bounded2 : G ⊆ Module.carrier(selfModule(R))
    rw c
    exact bounded
  have inSpan := moduleSpan.subset_span at R, selfModule(R), G with ringR, mod, bounded2
  have s1 := generatedIdeal.least at R, G, moduleSpan(selfModule(R), R, G) with comm, spanIdeal, inSpan
  have gen := generatedIdeal.ideal at R, G with comm
  have genSub := (Ideal.iff_submodule at R, generatedIdeal(R, G) with comm).forward with gen
  have contains := generatedIdeal.contains at R, G with comm, bounded
  have s2 := (moduleSpan.least at R, selfModule(R), G, generatedIdeal(R, G) with ringR, mod, bounded2, genSub).backward with contains
  exact Subset.antisymmetric with s1, s2

-- The kernel of a ring homomorphism is the kernel of the underlying
-- linear map of R-modules.
theorem RingHom.kernel_ideal (f S : Set)
  requires target : CommRing(S)
  requires hom : f : R →+* S
  shows Ideal(R, ringKernel(f, R.carrier, S.zero))
proof
  exact ringKernel.ideal at f, R, S with hom

end IdealsAsModules

section IdealSmul
variable (R M : Set)
hypothesis comm : CommRing(R)
hypothesis module : Module(M, R)

-- I • N is a submodule inside N, containing r • v for r ∈ I, v ∈ N
-- (Submodule.smul_mem_smul), the least such (Submodule.smul_le);
-- monotone; (I J) • N = I • (J • N) (Submodule.mul_smul); and
-- (I + J) • N = I • N + J • N (Submodule.sup_smul).
theorem idealSmul.submodule (I N : Set)
  requires ideal : Ideal(R, I)
  requires sub : SubmoduleOf(N, M, R)
  shows SubmoduleOf(idealSmul(M, R, I, N), M, R) ∧ idealSmul(M, R, I, N) ⊆ N
proof
  have ringR := CommRing.to_ring with comm
  have gb : idealSmulGenerators(M, R, I, N) ⊆ M.carrier
    intros w hw
    exact (idealSmulGenerators.membership.forward at M, R, I, N, w with hw).left
  have spanSub := moduleSpan.submodule at R, M, idealSmulGenerators(M, R, I, N) with ringR, module
  have gN : idealSmulGenerators(M, R, I, N) ⊆ N
    intros w hw
    obtain ⟨_, r, rI, v, vN, wrv⟩ := idealSmulGenerators.membership.forward at M, R, I, N, w with hw
    have rIn := Ideal.mem_carrier at R, I, r with ideal, rI
    rw wrv
    exact SubmoduleOf.smul_mem at R, M, N, r, v with ringR, module, sub, rIn, vN
  have le := (moduleSpan.least at R, M, idealSmulGenerators(M, R, I, N), N with ringR, module, gb, sub).backward with gN
  unfold idealSmul
  exact ⟨spanSub, le⟩

theorem idealSmul.smul_mem (I N r v : Set)
  requires ideal : Ideal(R, I)
  requires sub : SubmoduleOf(N, M, R)
  requires scalar : r ∈ I
  requires vector : v ∈ N
  shows call2(M.smul, r, v) ∈ idealSmul(M, R, I, N)
proof
  have ringR := CommRing.to_ring with comm
  have gb : idealSmulGenerators(M, R, I, N) ⊆ M.carrier
    intros w hw
    exact (idealSmulGenerators.membership.forward at M, R, I, N, w with hw).left
  have rIn := Ideal.mem_carrier at R, I, r with ideal, scalar
  have vIn := SubmoduleOf.subset at R, M, N with ringR, module, sub
  have vM := vIn with vector
  have wIn : call2(M.smul, r, v) ∈ M.carrier by typecheck
  have g := idealSmulGenerators.membership.backward at M, R, I, N, call2(M.smul, r, v) with ⟨wIn, r, scalar, v, vector, rfl⟩
  have inSpan := moduleSpan.subset_span at R, M, idealSmulGenerators(M, R, I, N) with ringR, module, gb
  unfold idealSmul
  exact inSpan with g

theorem idealSmul.least (I N P : Set)
  requires ideal : Ideal(R, I)
  requires sub : SubmoduleOf(N, M, R)
  requires target : SubmoduleOf(P, M, R)
  shows idealSmul(M, R, I, N) ⊆ P ↔
    (∀ r ∈ I, ∀ v ∈ N, call2(M.smul, r, v) ∈ P)
proof
  have ringR := CommRing.to_ring with comm
  have gb : idealSmulGenerators(M, R, I, N) ⊆ M.carrier
    intros w hw
    exact (idealSmulGenerators.membership.forward at M, R, I, N, w with hw).left
  have l := moduleSpan.least at R, M, idealSmulGenerators(M, R, I, N), P with ringR, module, gb, target
  unfold idealSmul
  rw l
  constructor
  . intro h
    intros r rI v vN
    have rIn := Ideal.mem_carrier at R, I, r with ideal, rI
    have vM := (SubmoduleOf.subset at R, M, N with ringR, module, sub) with vN
    have wIn : call2(M.smul, r, v) ∈ M.carrier by typecheck
    exact h with (idealSmulGenerators.membership.backward at M, R, I, N, call2(M.smul, r, v) with ⟨wIn, r, rI, v, vN, rfl⟩)
  . intro h
    intros w hw
    obtain ⟨_, r, rI, v, vN, wrv⟩ := idealSmulGenerators.membership.forward at M, R, I, N, w with hw
    rw wrv
    exact h with r, rI, v, vN

theorem idealSmul.mono (I J N P : Set)
  requires ideals : I ⊆ J
  requires subs : N ⊆ P
  shows idealSmul(M, R, I, N) ⊆ idealSmul(M, R, J, P)
proof
  have ringR := CommRing.to_ring with comm
  have sub : idealSmulGenerators(M, R, I, N) ⊆ idealSmulGenerators(M, R, J, P)
    intros w hw
    obtain ⟨wIn, r, rI, v, vN, wrv⟩ := idealSmulGenerators.membership.forward at M, R, I, N, w with hw
    have rJ := ideals with rI
    have vP := subs with vN
    exact idealSmulGenerators.membership.backward at M, R, J, P, w with ⟨wIn, r, rJ, v, vP, wrv⟩
  unfold idealSmul
  exact moduleSpan.mono at R, M, idealSmulGenerators(M, R, I, N), idealSmulGenerators(M, R, J, P) with ringR, module, sub

theorem idealSmul.product (I J N : Set)
  requires first : Ideal(R, I)
  requires second : Ideal(R, J)
  requires sub : SubmoduleOf(N, M, R)
  shows idealSmul(M, R, idealProduct(R, I, J), N) =
    idealSmul(M, R, I, idealSmul(M, R, J, N))
proof
  sorry

theorem idealSmul.sum (I J N : Set)
  requires first : Ideal(R, I)
  requires second : Ideal(R, J)
  requires sub : SubmoduleOf(N, M, R)
  shows idealSmul(M, R, idealSum(R, I, J), N) =
    submoduleSum(M, idealSmul(M, R, I, N), idealSmul(M, R, J, N))
proof
  sorry

-- For the module R itself, I • J is the product ideal (Ideal.smul_eq_mul).
theorem idealSmul.self_module (I J : Set)
  requires first : Ideal(R, I)
  requires second : Ideal(R, J)
  shows idealSmul(selfModule(R), R, I, J) = idealProduct(R, I, J)
proof
  have c := selfModule.carrier_eq at R
  have s := selfModule.smul_eq at R
  have gensEq : idealSmulGenerators(selfModule(R), R, I, J) = idealProductGenerators(R, I, J)
    ext w
    constructor
    . intro h
      obtain ⟨wIn, r, rI, v, vJ, wrv⟩ := idealSmulGenerators.membership.forward at selfModule(R), R, I, J, w with h
      rw c at wIn
      rw s at wrv
      exact idealProductGenerators.membership.backward at R, I, J, w with ⟨wIn, r, rI, v, vJ, wrv⟩
    . intro h
      obtain ⟨wIn, r, rI, v, vJ, wrv⟩ := idealProductGenerators.membership.forward at R, I, J, w with h
      rw ← c at wIn
      rw ← s at wrv
      exact idealSmulGenerators.membership.backward at selfModule(R), R, I, J, w with ⟨wIn, r, rI, v, vJ, wrv⟩
  have bounded := idealProductGenerators.bounded at R, I, J with comm
  have ms := generatedIdeal.module_span at R, idealProductGenerators(R, I, J) with comm, bounded
  unfold idealSmul
  unfold idealProduct
  rw [gensEq, ms]

-- For a principal ideal, (a) • M = a M (Submodule.ideal_span_singleton_smul).
theorem idealSmul.multiples (a : R)
  shows idealSmul(M, R, ringMultiples(R, a), M.carrier) =
    scalarMultipleImage(M, a)
proof
  sorry

-- Annihilators: ideals (Module.annihilator, Ideal.torsionOf), the
-- annihilator of a vector is everything exactly for the zero vector
-- (Ideal.torsionOf_eq_top_iff), the torsion by r is a submodule.
theorem moduleAnnihilator.ideal
  shows Ideal(R, moduleAnnihilator(M, R))
proof
  have ringR := CommRing.to_ring with comm
  apply Ideal.mk at R, moduleAnnihilator(M, R) with ringR
  . intros r hr
    exact (moduleAnnihilator.membership.forward at M, R, r with hr).left
  . have zeroIn : R[0] ∈ R.carrier by typecheck
    have all : ∀ v ∈ M.carrier, R[0] • v = M.zero
      intros v hv
      exact zero_smul at R, M, v with ringR, module
    exact moduleAnnihilator.membership.backward at M, R, R[0] with ⟨zeroIn, all⟩
  . intros r hr s hs
    obtain ⟨rIn, ar⟩ := moduleAnnihilator.membership.forward at M, R, r with hr
    obtain ⟨sIn, as⟩ := moduleAnnihilator.membership.forward at M, R, s with hs
    have sumIn : r + s ∈ R.carrier by typecheck
    have all : ∀ v ∈ M.carrier, (r + s) • v = M.zero
      intros v hv
      have d := add_smul at R, M, r, s, v with ringR, module
      rw [d, (ar with v, hv), (as with v, hv)]
      exact Module.add_zero at R, M, M.zero with ringR, module
    exact moduleAnnihilator.membership.backward at M, R, r + s with ⟨sumIn, all⟩
  . intros r hr
    obtain ⟨rIn, ar⟩ := moduleAnnihilator.membership.forward at M, R, r with hr
    have nIn : -r ∈ R.carrier by typecheck
    have all : ∀ v ∈ M.carrier, (-r) • v = M.zero
      intros v hv
      have d := neg_smul at R, M, r, v with ringR, module
      rw [d, (ar with v, hv)]
      exact Module.neg_zero at R, M with ringR, module
    exact moduleAnnihilator.membership.backward at M, R, -r with ⟨nIn, all⟩
  . intros a ha r hr
    obtain ⟨rIn, ar⟩ := moduleAnnihilator.membership.forward at M, R, r with hr
    have p1 : a * r ∈ R.carrier by typecheck
    have p2 : r * a ∈ R.carrier by typecheck
    have all1 : ∀ v ∈ M.carrier, (a * r) • v = M.zero
      intros v hv
      have d := mul_smul at R, M, a, r, v with ringR, module
      rw [d, (ar with v, hv)]
      exact smul_zero at R, M, a with ringR, module
    have all2 : ∀ v ∈ M.carrier, (r * a) • v = M.zero
      intros v hv
      have d := mul_smul at R, M, r, a, v with ringR, module
      have av : a • v ∈ M.carrier by typecheck
      rw d
      exact ar with a • v, av
    have m1 := moduleAnnihilator.membership.backward at M, R, a * r with ⟨p1, all1⟩
    have m2 := moduleAnnihilator.membership.backward at M, R, r * a with ⟨p2, all2⟩
    exact ⟨m1, m2⟩

theorem vectorAnnihilator.ideal (v : M)
  shows Ideal(R, vectorAnnihilator(M, R, v))
proof
  have ringR := CommRing.to_ring with comm
  have vIn : v ∈ M.carrier by assumption
  apply Ideal.mk at R, vectorAnnihilator(M, R, v) with ringR
  . intros r hr
    exact (vectorAnnihilator.membership.forward at M, R, v, r with hr).left
  . have zeroIn : R[0] ∈ R.carrier by typecheck
    have z := zero_smul at R, M, v with ringR, module
    exact vectorAnnihilator.membership.backward at M, R, v, R[0] with ⟨zeroIn, z⟩
  . intros r hr s hs
    obtain ⟨rIn, ar⟩ := vectorAnnihilator.membership.forward at M, R, v, r with hr
    obtain ⟨sIn, as⟩ := vectorAnnihilator.membership.forward at M, R, v, s with hs
    have sumIn : r + s ∈ R.carrier by typecheck
    have e : (r + s) • v = M.zero
      have d := add_smul at R, M, r, s, v with ringR, module
      rw [d, ar, as]
      exact Module.add_zero at R, M, M.zero with ringR, module
    exact vectorAnnihilator.membership.backward at M, R, v, r + s with ⟨sumIn, e⟩
  . intros r hr
    obtain ⟨rIn, ar⟩ := vectorAnnihilator.membership.forward at M, R, v, r with hr
    have nIn : -r ∈ R.carrier by typecheck
    have e : (-r) • v = M.zero
      have d := neg_smul at R, M, r, v with ringR, module
      rw [d, ar]
      exact Module.neg_zero at R, M with ringR, module
    exact vectorAnnihilator.membership.backward at M, R, v, -r with ⟨nIn, e⟩
  . intros a ha r hr
    obtain ⟨rIn, ar⟩ := vectorAnnihilator.membership.forward at M, R, v, r with hr
    have p1 : a * r ∈ R.carrier by typecheck
    have p2 : r * a ∈ R.carrier by typecheck
    have e1 : (a * r) • v = M.zero
      have d := mul_smul at R, M, a, r, v with ringR, module
      rw [d, ar]
      exact smul_zero at R, M, a with ringR, module
    have e2 : (r * a) • v = M.zero
      have c : r * a = a * r by ring
      rw c
      exact e1
    have m1 := vectorAnnihilator.membership.backward at M, R, v, a * r with ⟨p1, e1⟩
    have m2 := vectorAnnihilator.membership.backward at M, R, v, r * a with ⟨p2, e2⟩
    exact ⟨m1, m2⟩

theorem vectorAnnihilator.eq_whole_iff (v : M)
  shows vectorAnnihilator(M, R, v) = R.carrier ↔ v = M.zero
proof
  have ringR := CommRing.to_ring with comm
  have vIn : v ∈ M.carrier by assumption
  constructor
  . intro h
    have oneIn : R[1] ∈ R.carrier by typecheck
    rw ← h at oneIn
    obtain ⟨_, e⟩ := vectorAnnihilator.membership.forward at M, R, v, R[1] with oneIn
    have o := one_smul at R, M, v with ringR, module
    rw o at e
    exact e
  . intro h
    have s1 : vectorAnnihilator(M, R, v) ⊆ R.carrier
      intros r hr
      exact (vectorAnnihilator.membership.forward at M, R, v, r with hr).left
    have s2 : R.carrier ⊆ vectorAnnihilator(M, R, v)
      intros r hr
      have z := smul_zero at R, M, r with ringR, module
      rw h
      exact vectorAnnihilator.membership.backward at M, R, M.zero, r with ⟨hr, z⟩
    exact Subset.antisymmetric with s1, s2

theorem torsionBy.submodule (r : R)
  shows SubmoduleOf(torsionBy(M, R, r), M, R)
proof
  have ringR := CommRing.to_ring with comm
  have rIn : r ∈ R.carrier by assumption
  have sub : torsionBy(M, R, r) ⊆ M.carrier
    intros v hv
    exact (torsionBy.membership.forward at M, R, r, v with hv).left
  have zeroIn : M.zero ∈ M.carrier by typecheck
  have z := smul_zero at R, M, r with ringR, module
  have zero := torsionBy.membership.backward at M, R, r, M.zero with ⟨zeroIn, z⟩
  have adds : ∀ v w ∈ torsionBy(M, R, r), call2(M.add, v, w) ∈ torsionBy(M, R, r)
    intros v hv w hw
    obtain ⟨vIn, av⟩ := torsionBy.membership.forward at M, R, r, v with hv
    obtain ⟨wIn, aw⟩ := torsionBy.membership.forward at M, R, r, w with hw
    have sIn : v + w ∈ M.carrier by typecheck
    have e : r • (v + w) = M.zero
      have d := smul_add at R, M, r, v, w with ringR, module
      rw [d, av, aw]
      exact Module.add_zero at R, M, M.zero with ringR, module
    exact torsionBy.membership.backward at M, R, r, v + w with ⟨sIn, e⟩
  have smuls : ∀ s ∈ R.carrier, ∀ v ∈ torsionBy(M, R, r), s • v ∈ torsionBy(M, R, r)
    intros s hs v hv
    obtain ⟨vIn, av⟩ := torsionBy.membership.forward at M, R, r, v with hv
    have svIn : s • v ∈ M.carrier by typecheck
    have e : r • (s • v) = M.zero
      have d1 := mul_smul at R, M, r, s, v with ringR, module
      have d2 := mul_smul at R, M, s, r, v with ringR, module
      have c : r * s = s * r by ring
      rw [← d1, c, d2, av]
      exact smul_zero at R, M, s with ringR, module
    exact torsionBy.membership.backward at M, R, r, s • v with ⟨svIn, e⟩
  exact ⟨module, sub, zero, adds, smuls⟩

-- The annihilator of a quotient R ⧸ I as an R-module is I.
theorem moduleAnnihilator.quotient (I : Set)
  requires ideal : Ideal(R, I)
  shows moduleAnnihilator(quotientModule(selfModule(R), R, I), R) = I
proof
  sorry

end IdealSmul
