-- Ideals of a commutative ring: finitely generated ideals, sums,
-- products, powers and finite products of ideals, the radical, the
-- nilradical and the Jacobson radical, colon ideals, minimal primes,
-- extension and contraction along a ring homomorphism, the quotient map
-- R → R ⧸ I with its lifts and the maps between quotients, kernels and
-- the first isomorphism theorem, quotients by prime and maximal ideals,
-- products of a family of rings and the Chinese remainder theorem, the
-- index of an ideal (Submodule.cardQuot), ideals as submodules, the
-- submodule I • M, and annihilators (Mathlib's Ideal.span, Ideal.FG,
-- Ideal.mul, Ideal.radical, Ideal.jacobson, Ideal.map, Ideal.comap,
-- Ideal.Quotient.mk, Ideal.Quotient.lift, Ideal.quotientMap,
-- Ideal.Quotient.factor, RingHom.ker, Pi.ring, and
-- Ideal.quotientInfRingEquivPiQuotient).
-- Part of the GRH blueprint.
-- Planned home: Algebra/Ring/IdealOperations.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Algebra.Ideals
import GRH.Algebra.Divisibility
import Grace.Cumulus.Algebra.Ring
import Grace.Cumulus.Algebra.Field.Quotient

-- Section: Finitely generated ideals and operations on ideals
-- The ideal generated by a set is Cumulus's generatedIdeal(R, G), the
-- intersection of the ideals containing G. An ideal is finitely generated
-- when it is generated by a finite subset (Ideal.FG).
predicate FinitelyGeneratedIdeal (R I : Set) :=
  Ideal(R, I) ∧ (∃ G, G ⊆ Ring.carrier(R) ∧ Finite(G) ∧
    I = generatedIdeal(R, G))

-- I + J = {x + y}, the least ideal containing both (Ideal.sup).
def idealSum (R I J : Set) : Set :=
  { z ∈ Ring.carrier(R) | ∃ x ∈ I, ∃ y ∈ J, z = call2(Ring.add(R), x, y) }

-- The products x y with x ∈ I, y ∈ J, and the product ideal I J they
-- generate (Ideal.mul).
def idealProductGenerators (R I J : Set) : Set :=
  { z ∈ Ring.carrier(R) | ∃ x ∈ I, ∃ y ∈ J, z = call2(Ring.mul(R), x, y) }

def idealProduct (R I J : Set) : Set :=
  generatedIdeal(R, idealProductGenerators(R, I, J))

-- Iⁿ, with I⁰ = R (Monoid.npow on ideals).
def idealPow (R I : Set, n : Nat) → Set
  | R, I, zero => Ring.carrier(R)
  | R, I, succ(k) => idealProduct(R, idealPow(R, I, k), I)

-- The product I(0) ⋯ I(n − 1) of a family of ideals indexed by n
-- (Finset.prod of ideals).
def idealFamilyProduct (R I : Set, n : Nat) → Set
  | R, I, zero => Ring.carrier(R)
  | R, I, succ(k) => idealProduct(R, idealFamilyProduct(R, I, k), I(k))

-- The intersection of the ideals I(k), k ∈ K, of a family over a nonempty
-- index set (Ideal.iInf).
def idealFamilyIntersection (R K I : Set) : Set :=
  { x ∈ Ring.carrier(R) | ∀ k ∈ K, x ∈ I(k) }

-- The radical {x | xⁿ ∈ I for some n} (Ideal.radical), the nilradical
-- (the radical of 0), and radical ideals (Ideal.IsRadical).
def idealRadical (R I : Set) : Set :=
  { x ∈ Ring.carrier(R) | ∃ n ∈ ℕ, Ring.pow(R, x, n) ∈ I }

def nilradical (R : Set) : Set := idealRadical(R, {Ring.zero(R)})

predicate RadicalIdeal (R I : Set) := Ideal(R, I) ∧ idealRadical(R, I) = I

-- The intersection of the prime ideals containing I (Ideal.radical_eq_sInf).
def primeIntersection (R I : Set) : Set :=
  { x ∈ Ring.carrier(R) | ∀ P, PrimeIdeal(R, P) → I ⊆ P → x ∈ P }

-- The Jacobson radical of I: the intersection of the maximal ideals
-- containing I (Ideal.jacobson); it is the whole ring when there are
-- none.
def jacobsonRadical (R I : Set) : Set :=
  { x ∈ Ring.carrier(R) | ∀ M, MaximalIdeal(R, M) → I ⊆ M → x ∈ M }

-- The colon ideal (I : J) = {x | x J ⊆ I} (Submodule.colon).
def idealColon (R I J : Set) : Set :=
  { x ∈ Ring.carrier(R) | ∀ y ∈ J, call2(Ring.mul(R), x, y) ∈ I }

-- P is a minimal prime over I: a prime containing I and containing no
-- smaller such prime (Ideal.minimalPrimes).
predicate MinimalPrimeOver (R I P : Set) :=
  PrimeIdeal(R, P) ∧ I ⊆ P ∧
  (∀ Q, PrimeIdeal(R, Q) → I ⊆ Q → Q ⊆ P → Q = P)

-- Section: Extension and contraction
-- The extension f(I)S of an ideal I of R along f : R → S, the ideal
-- generated by the image (Ideal.map); the contraction f⁻¹(J) is Cumulus's
-- idealComap(f, R.carrier, J) (Ideal.comap).
def idealExtension (f S I : Set) : Set :=
  generatedIdeal(S, functionImage(f, I, Ring.carrier(S)))

-- P lies over p along f: p is the contraction of P (Ideal.LiesOver).
predicate LiesOver (f R P p : Set) := idealComap(f, Ring.carrier(R), P) = p

-- Section: Quotient rings and their maps
-- The quotient map R → R ⧸ I, x ↦ [x] (Ideal.Quotient.mk); R ⧸ I is
-- Cumulus's quotientRing(R, I).
def quotientMk (R I : Set) : Set :=
  quotientProjection(Ring.carrier(R), quotientRelation(R, I))

-- For f : R → S vanishing on I, the induced map R ⧸ I → S, [x] ↦ f(x)
-- (Ideal.Quotient.lift).
def quotientRingLift (R S I f : Set) : Set :=
  quotientMap(f, Ring.carrier(R), Ring.carrier(S), quotientRelation(R, I))

-- For f : R → S with I ⊆ f⁻¹(J), the map R ⧸ I → S ⧸ J, [x] ↦ [f(x)]
-- (Ideal.quotientMap).
def quotientRingMap (R S f I J : Set) : Set :=
  quotientRingLift(R, quotientRing(S, J), I,
    compose(quotientMk(S, J), f, Ring.carrier(R), Ring.carrier(S),
      Ring.carrier(quotientRing(S, J))))

-- For I ⊆ J, the surjection R ⧸ I → R ⧸ J (Ideal.Quotient.factor).
def quotientFactor (R I J : Set) : Set :=
  quotientRingLift(R, quotientRing(R, J), I, quotientMk(R, J))

-- The residue field R ⧸ M at a maximal ideal M, as a ring
-- (Ideal.ResidueField on a maximal ideal).
def residueRing (R M : Set) : Set := quotientRing(R, M)

-- Section: Products of rings
-- The product Πᵢ F(i) of a family of rings F : I → rings: the dependent
-- functions u with u(i) ∈ F(i), with the pointwise operations (Pi.ring).
def piCarriers (I F : Set) : Set := { Ring.carrier(F(i)) | i ∈ I }

def piUnion (I F : Set) : Set := ⋃(piCarriers(I, F))

def piCarrier (I F : Set) : Set :=
  { u ∈ functionSpace(I, piUnion(I, F)) | ∀ i ∈ I, u(i) ∈ Ring.carrier(F(i)) }

def piPointwiseAdd (I F u v : Set) : Set :=
  { p ∈ I × piUnion(I, F) | ∃ i ∈ I, p = (i, call2(Ring.add(F(i)), u(i), v(i))) }

def piPointwiseMul (I F u v : Set) : Set :=
  { p ∈ I × piUnion(I, F) | ∃ i ∈ I, p = (i, call2(Ring.mul(F(i)), u(i), v(i))) }

def piPointwiseNeg (I F u : Set) : Set :=
  { p ∈ I × piUnion(I, F) | ∃ i ∈ I, p = (i, apply(Ring.neg(F(i)), u(i))) }

def piZero (I F : Set) : Set :=
  { p ∈ I × piUnion(I, F) | ∃ i ∈ I, p = (i, Ring.zero(F(i))) }

def piOne (I F : Set) : Set :=
  { p ∈ I × piUnion(I, F) | ∃ i ∈ I, p = (i, Ring.one(F(i))) }

def piAdd (I F : Set) : Set :=
  { q ∈ (piCarrier(I, F) × piCarrier(I, F)) × piCarrier(I, F) |
    ∃ u ∈ piCarrier(I, F), ∃ v ∈ piCarrier(I, F),
      q = ((u, v), piPointwiseAdd(I, F, u, v)) }

def piMul (I F : Set) : Set :=
  { q ∈ (piCarrier(I, F) × piCarrier(I, F)) × piCarrier(I, F) |
    ∃ u ∈ piCarrier(I, F), ∃ v ∈ piCarrier(I, F),
      q = ((u, v), piPointwiseMul(I, F, u, v)) }

def piNeg (I F : Set) : Set :=
  { q ∈ piCarrier(I, F) × piCarrier(I, F) |
    ∃ u ∈ piCarrier(I, F), q = (u, piPointwiseNeg(I, F, u)) }

def piRing (I F : Set) : Set :=
  Ring.mk(piCarrier(I, F), piAdd(I, F), piZero(I, F), piNeg(I, F),
    piMul(I, F), piOne(I, F))

-- The projection Πⱼ F(j) → F(i) (Pi.evalRingHom) and, for a family of
-- homomorphisms f(i) : R → F(i), the homomorphism R → Πᵢ F(i),
-- x ↦ (f(i)(x))ᵢ (Pi.ringHom, RingHom.pi).
def piProjection (I F i : Set) : Set :=
  { p ∈ piCarrier(I, F) × Ring.carrier(F(i)) |
    ∃ u ∈ piCarrier(I, F), p = (u, u(i)) }

def piFamilyValue (I F f x : Set) : Set :=
  { p ∈ I × piUnion(I, F) | ∃ i ∈ I, p = (i, f(i)(x)) }

def piLift (R I F f : Set) : Set :=
  { p ∈ Ring.carrier(R) × piCarrier(I, F) |
    ∃ x ∈ Ring.carrier(R), p = (x, piFamilyValue(I, F, f, x)) }

-- The family of quotient rings k ↦ R ⧸ I(k), and the map
-- R ⧸ ⋂ I(k) → Πₖ R ⧸ I(k) of the Chinese remainder theorem
-- (Ideal.quotientInfToPiQuotient).
def quotientRings (R K I : Set) : Set := { quotientRing(R, I(k)) | k ∈ K }

def quotientMks (R K I : Set) : Set := { quotientMk(R, I(k)) | k ∈ K }

def quotientFamily (R K I : Set) : Set :=
  { p ∈ K × quotientRings(R, K, I) |
    ∃ k ∈ K, p = (k, quotientRing(R, I(k))) }

def quotientFamilyMaps (R K I : Set) : Set :=
  { p ∈ K × quotientMks(R, K, I) |
    ∃ k ∈ K, p = (k, quotientMk(R, I(k))) }

def chineseRemainderMap (R K I : Set) : Set :=
  quotientRingLift(R, piRing(K, quotientFamily(R, K, I)),
    idealFamilyIntersection(R, K, I),
    piLift(R, K, quotientFamily(R, K, I), quotientFamilyMaps(R, K, I)))

-- Section: Ideals and modules
-- The submodule I • N of an R-module M for an ideal I and a submodule N:
-- the span of the products r • v (Submodule.smul, Ideal.smul_top for
-- N = M).
def idealSmulGenerators (M R I N : Set) : Set :=
  { w ∈ Module.carrier(M) | ∃ r ∈ I, ∃ v ∈ N, w = call2(Module.smul(M), r, v) }

def idealSmul (M R I N : Set) : Set :=
  moduleSpan(M, R, idealSmulGenerators(M, R, I, N))

-- The annihilator {r | r • v = 0 for all v} of a module
-- (Module.annihilator) and the annihilator of one vector
-- (Ideal.torsionOf).
def moduleAnnihilator (M R : Set) : Set :=
  { r ∈ Ring.carrier(R) | ∀ v ∈ Module.carrier(M),
    call2(Module.smul(M), r, v) = Module.zero(M) }

def vectorAnnihilator (M R v : Set) : Set :=
  { r ∈ Ring.carrier(R) | call2(Module.smul(M), r, v) = Module.zero(M) }

-- The torsion {v | r • v = 0} by an element r (Submodule.torsionBy).
-- The image a M = {a • v} of multiplication by a.
def scalarMultipleImage (M a : Set) : Set :=
  { w ∈ Module.carrier(M) | ∃ v ∈ Module.carrier(M),
    w = call2(Module.smul(M), a, v) }

def torsionBy (M R r : Set) : Set :=
  { v ∈ Module.carrier(M) | call2(Module.smul(M), r, v) = Module.zero(M) }

-- Section: Laws of the ideal operations
section IdealOperations
variable (R : Set)
hypothesis comm : CommRing(R)

-- Ideal.span: generatedIdeal is the least ideal containing the set
-- (Ideal.subset_span, Ideal.span_le, Ideal.span_mono).
theorem generatedIdeal.subset_iff (G I : Set)
  requires bounded : G ⊆ R.carrier
  requires ideal : Ideal(R, I)
  shows generatedIdeal(R, G) ⊆ I ↔ G ⊆ I
proof
  sorry

-- Ideal.span_insert and Ideal.mem_span_pair: the ideal generated by
-- G ∪ {a} is (G) + (a); membership in (a, b) is x = u a + v b.
theorem generatedIdeal.insert (G a : Set)
  requires bounded : G ⊆ R.carrier
  requires member : a ∈ R.carrier
  shows generatedIdeal(R, G ∪ {a}) =
    idealSum(R, generatedIdeal(R, G), ringMultiples(R, a))
proof
  sorry

theorem generatedIdeal.mem_pair (a b x : R)
  shows x ∈ generatedIdeal(R, {a, b}) ↔
    (∃ u v ∈ R.carrier, x = u * a + v * b)
proof
  sorry

-- Ideal.mem_span_range_iff_exists_fun: over a finite family g : n → R,
-- the members of the generated ideal are the combinations Σ c(i) g(i).
theorem generatedIdeal.mem_finite (n g x : Set)
  requires natural : Nat(n)
  requires family : g : n → R.carrier
  requires element : x ∈ R.carrier
  shows x ∈ generatedIdeal(R, functionImage(g, n, R.carrier)) ↔
    (∃ c, (c : n → R.carrier) ∧ x = moduleCombination(selfModule(R), R, n, c, g))
proof
  sorry

-- Ideal.span_zero, Ideal.span_singleton_one.
theorem generatedIdeal.empty
  shows generatedIdeal(R, ∅) = {R[0]}
proof
  sorry

-- An ideal generated by finitely many elements is finitely generated, and
-- a principal ideal is finitely generated.
theorem FinitelyGeneratedIdeal.of_finite (G : Set)
  requires bounded : G ⊆ R.carrier
  requires finite : Finite(G)
  shows FinitelyGeneratedIdeal(R, generatedIdeal(R, G))
proof
  sorry

theorem PrincipalIdeal.finitely_generated (I : Set)
  requires principal : PrincipalIdeal(R, I)
  shows FinitelyGeneratedIdeal(R, I)
proof
  sorry

-- Sums: an ideal, the least one containing both summands
-- (Ideal.mem_sup_left, mem_sup_right, sup_le), and the ideal generated
-- by the union.
theorem idealSum.ideal (I J : Set)
  requires first : Ideal(R, I)
  requires second : Ideal(R, J)
  shows Ideal(R, idealSum(R, I, J))
proof
  sorry

theorem idealSum.left_subset (I J : Set)
  requires first : Ideal(R, I)
  requires second : Ideal(R, J)
  shows I ⊆ idealSum(R, I, J) ∧ J ⊆ idealSum(R, I, J)
proof
  sorry

theorem idealSum.least (I J K : Set)
  requires first : Ideal(R, I)
  requires second : Ideal(R, J)
  requires third : Ideal(R, K)
  shows idealSum(R, I, J) ⊆ K ↔ I ⊆ K ∧ J ⊆ K
proof
  sorry

theorem idealSum.generated (I J : Set)
  requires first : Ideal(R, I)
  requires second : Ideal(R, J)
  shows idealSum(R, I, J) = generatedIdeal(R, I ∪ J)
proof
  sorry

theorem idealSum.comm (I J : Set)
  shows idealSum(R, I, J) = idealSum(R, J, I)
proof
  sorry

-- Products: an ideal inside the intersection (Ideal.mul_le_inf), with the
-- products x y as members (Ideal.mul_mem_mul), the least ideal containing
-- them (Ideal.mul_le), commutative, associative, distributive over sums
-- (Ideal.sup_mul), with R as unit (Ideal.mul_top), monotone
-- (Ideal.mul_mono), and generated by products of generators
-- (Ideal.span_mul_span).
theorem idealProduct.ideal (I J : Set)
  shows Ideal(R, idealProduct(R, I, J))
proof
  sorry

theorem idealProduct.mul_mem (I J x y : Set)
  requires first : Ideal(R, I)
  requires second : Ideal(R, J)
  requires xIn : x ∈ I
  requires yIn : y ∈ J
  shows call2(R.mul, x, y) ∈ idealProduct(R, I, J)
proof
  sorry

theorem idealProduct.least (I J K : Set)
  requires first : Ideal(R, I)
  requires second : Ideal(R, J)
  requires third : Ideal(R, K)
  shows idealProduct(R, I, J) ⊆ K ↔
    (∀ x ∈ I, ∀ y ∈ J, call2(R.mul, x, y) ∈ K)
proof
  sorry

theorem idealProduct.subset_intersection (I J : Set)
  requires first : Ideal(R, I)
  requires second : Ideal(R, J)
  shows idealProduct(R, I, J) ⊆ I ∩ J
proof
  sorry

theorem idealProduct.comm (I J : Set)
  shows idealProduct(R, I, J) = idealProduct(R, J, I)
proof
  sorry

theorem idealProduct.assoc (I J K : Set)
  requires first : Ideal(R, I)
  requires second : Ideal(R, J)
  requires third : Ideal(R, K)
  shows idealProduct(R, idealProduct(R, I, J), K) =
    idealProduct(R, I, idealProduct(R, J, K))
proof
  sorry

theorem idealProduct.sum_left (I J K : Set)
  requires first : Ideal(R, I)
  requires second : Ideal(R, J)
  requires third : Ideal(R, K)
  shows idealProduct(R, idealSum(R, I, J), K) =
    idealSum(R, idealProduct(R, I, K), idealProduct(R, J, K))
proof
  sorry

theorem idealProduct.whole (I : Set)
  requires ideal : Ideal(R, I)
  shows idealProduct(R, I, R.carrier) = I
proof
  sorry

theorem idealProduct.mono (I J K L : Set)
  requires first : I ⊆ K
  requires second : J ⊆ L
  shows idealProduct(R, I, J) ⊆ idealProduct(R, K, L)
proof
  sorry

theorem idealProduct.generated (G H : Set)
  requires first : G ⊆ R.carrier
  requires second : H ⊆ R.carrier
  shows idealProduct(R, generatedIdeal(R, G), generatedIdeal(R, H)) =
    generatedIdeal(R, idealProductGenerators(R, G, H))
proof
  sorry

-- Ideal.span_singleton_mul_span_singleton.
theorem idealProduct.multiples (a b : R)
  shows idealProduct(R, ringMultiples(R, a), ringMultiples(R, b)) =
    ringMultiples(R, a * b)
proof
  sorry

-- Coprime ideals: I + J = R gives I J = I ∩ J (Ideal.mul_eq_inf_of_coprime)
-- and powers stay coprime (Ideal.sup_pow_add_le_pow_sup_pow).
theorem idealProduct.coprime_eq_intersection (I J : Set)
  requires first : Ideal(R, I)
  requires second : Ideal(R, J)
  requires coprime : idealSum(R, I, J) = R.carrier
  shows idealProduct(R, I, J) = I ∩ J
proof
  sorry

theorem idealSum.coprime_pow (I J : Set) (m n : Nat)
  requires first : Ideal(R, I)
  requires second : Ideal(R, J)
  requires coprime : idealSum(R, I, J) = R.carrier
  shows idealSum(R, idealPow(R, I, m), idealPow(R, J, n)) = R.carrier
proof
  sorry

-- Powers: ideals, Iⁿ⁺¹ = Iⁿ I, decreasing in n (Ideal.pow_le_pow_right,
-- pow_le_self), xⁿ ∈ Iⁿ (Ideal.pow_mem_pow), Iᵐ Iⁿ = Iᵐ⁺ⁿ, and the
-- powers of a principal ideal (Ideal.span_singleton_pow).
theorem idealPow.ideal (I : Set) (n : Nat)
  requires ideal : Ideal(R, I)
  shows Ideal(R, idealPow(R, I, n))
proof
  sorry

theorem idealPow.zero (I : Set)
  shows idealPow(R, I, 0) = R.carrier
proof
  sorry

theorem idealPow.succ (I : Set) (n : Nat)
  shows idealPow(R, I, succ(n)) = idealProduct(R, idealPow(R, I, n), I)
proof
  sorry

theorem idealPow.one (I : Set)
  requires ideal : Ideal(R, I)
  shows idealPow(R, I, 1) = I
proof
  sorry

theorem idealPow.antitone (I : Set) (m n : Nat)
  requires ideal : Ideal(R, I)
  requires le : m ≤ n
  shows idealPow(R, I, n) ⊆ idealPow(R, I, m)
proof
  sorry

theorem idealPow.pow_mem (I x : Set) (n : Nat)
  requires ideal : Ideal(R, I)
  requires member : x ∈ I
  shows Ring.pow(R, x, n) ∈ idealPow(R, I, n)
proof
  sorry

theorem idealPow.add (I : Set) (m n : Nat)
  requires ideal : Ideal(R, I)
  shows idealProduct(R, idealPow(R, I, m), idealPow(R, I, n)) =
    idealPow(R, I, m + n)
proof
  sorry

theorem idealPow.multiples (a : R) (n : Nat)
  shows idealPow(R, ringMultiples(R, a), n) = ringMultiples(R, a ^ n)
proof
  sorry

theorem idealPow.mono (I J : Set) (n : Nat)
  requires subset : I ⊆ J
  shows idealPow(R, I, n) ⊆ idealPow(R, J, n)
proof
  sorry

-- Finite products of ideals: an ideal, containing the products of members
-- (Ideal.prod_mem_prod), and for pairwise coprime ideals equal to the
-- intersection (Ideal.prod_eq_iInf_of_pairwise_isCoprime).
theorem idealFamilyProduct.ideal (I : Set) (n : Nat)
  requires ideals : ∀ k ∈ n, Ideal(R, I(k))
  shows Ideal(R, idealFamilyProduct(R, I, n))
proof
  sorry

theorem idealFamilyProduct.prod_mem (I x : Set) (n : Nat)
  requires ideals : ∀ k ∈ n, Ideal(R, I(k))
  requires family : x : n → R.carrier
  requires members : ∀ k ∈ n, x(k) ∈ I(k)
  shows finiteRingProduct(n, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, x) ∈
    idealFamilyProduct(R, I, n)
proof
  sorry

theorem idealFamilyProduct.coprime_eq_intersection (I : Set) (n : Nat)
  requires positive : 0 < n
  requires ideals : ∀ k ∈ n, Ideal(R, I(k))
  requires coprime : ∀ j k ∈ n, j ≠ k → idealSum(R, I(j), I(k)) = R.carrier
  shows idealFamilyProduct(R, I, n) = idealFamilyIntersection(R, n, I)
proof
  sorry

-- Intersections of ideals are ideals (Ideal.mem_iInf, Ideal.mem_sInf).
theorem idealFamilyIntersection.ideal (K I : Set)
  requires nonempty : K ≠ ∅
  requires ideals : ∀ k ∈ K, Ideal(R, I(k))
  shows Ideal(R, idealFamilyIntersection(R, K, I))
proof
  sorry

theorem Ideal.intersection (I J : Set)
  requires first : Ideal(R, I)
  requires second : Ideal(R, J)
  shows Ideal(R, I ∩ J)
proof
  sorry

-- Prime ideals and products (Ideal.IsPrime.mul_le, IsPrime.pow_le_iff,
-- Ideal.IsPrime.prod_le).
theorem PrimeIdeal.product_subset_iff (P I J : Set)
  requires prime : PrimeIdeal(R, P)
  requires first : Ideal(R, I)
  requires second : Ideal(R, J)
  shows idealProduct(R, I, J) ⊆ P ↔ I ⊆ P ∨ J ⊆ P
proof
  sorry

theorem PrimeIdeal.pow_subset_iff (P I : Set) (n : Nat)
  requires prime : PrimeIdeal(R, P)
  requires ideal : Ideal(R, I)
  requires positive : 0 < n
  shows idealPow(R, I, n) ⊆ P ↔ I ⊆ P
proof
  sorry

-- Prime avoidance in its simplest form: a prime containing a finite
-- intersection of ideals contains one of them (Ideal.IsPrime.inf_le').
theorem PrimeIdeal.intersection_subset_iff (P I : Set) (n : Nat)
  requires prime : PrimeIdeal(R, P)
  requires positive : 0 < n
  requires ideals : ∀ k ∈ n, Ideal(R, I(k))
  shows idealFamilyIntersection(R, n, I) ⊆ P ↔ (∃ k ∈ n, I(k) ⊆ P)
proof
  sorry

-- Radicals: an ideal containing I, idempotent and monotone
-- (Ideal.le_radical, radical_idem, radical_mono, radical_le_radical_iff);
-- prime ideals are radical; a power of a finitely generated ideal inside
-- the radical of J lies in J (Ideal.exists_pow_le_of_le_radical_of_fg).
theorem idealRadical.ideal (I : Set)
  requires ideal : Ideal(R, I)
  shows Ideal(R, idealRadical(R, I))
proof
  sorry

theorem idealRadical.subset (I : Set)
  requires ideal : Ideal(R, I)
  shows I ⊆ idealRadical(R, I)
proof
  sorry

theorem idealRadical.idempotent (I : Set)
  requires ideal : Ideal(R, I)
  shows idealRadical(R, idealRadical(R, I)) = idealRadical(R, I)
proof
  sorry

theorem idealRadical.mono (I J : Set)
  requires subset : I ⊆ J
  shows idealRadical(R, I) ⊆ idealRadical(R, J)
proof
  sorry

theorem idealRadical.subset_iff (I J : Set)
  requires first : Ideal(R, I)
  requires second : Ideal(R, J)
  shows idealRadical(R, I) ⊆ idealRadical(R, J) ↔ I ⊆ idealRadical(R, J)
proof
  sorry

theorem PrimeIdeal.radical (P : Set)
  requires prime : PrimeIdeal(R, P)
  shows RadicalIdeal(R, P)
proof
  sorry

theorem idealRadical.exists_pow_subset (I J : Set)
  requires finitelyGenerated : FinitelyGeneratedIdeal(R, I)
  requires ideal : Ideal(R, J)
  requires subset : I ⊆ idealRadical(R, J)
  shows ∃ n ∈ ℕ, idealPow(R, I, n) ⊆ J
proof
  sorry

-- The radical is the intersection of the primes containing I
-- (Ideal.radical_eq_sInf). The inclusion of the intersection in the
-- radical builds a prime avoiding the powers of an element by Zorn's
-- lemma: Choice.
theorem idealRadical.eq_prime_intersection (I : Set)
  requires ideal : Ideal(R, I)
  shows idealRadical(R, I) = primeIntersection(R, I)
proof
  sorry

-- The nilradical is the set of nilpotent elements, and R is reduced
-- exactly when it is zero (nilradical_eq_zero).
theorem nilradical.mem_iff (x : R)
  shows x ∈ nilradical(R) ↔ RingNilpotent(R, x)
proof
  sorry

theorem ReducedRing.iff_nilradical
  shows ReducedRing(R) ↔ nilradical(R) = {R[0]}
proof
  sorry

-- Ideal.isRadical_iff_quotient_reduced.
theorem RadicalIdeal.iff_quotient_reduced (I : Set)
  requires ideal : Ideal(R, I)
  shows RadicalIdeal(R, I) ↔ ReducedRing(R ⧸ I)
proof
  sorry

-- The Jacobson radical: an ideal containing I; an element of the Jacobson
-- radical of 0 is one with 1 + x y a unit for every y
-- (Ideal.mem_jacobson_bot). The direction from units to membership needs
-- a maximal ideal containing a nonunit: Choice. The Jacobson radical is a
-- radical ideal (Ideal.isRadical_jacobson).
theorem jacobsonRadical.ideal (I : Set)
  requires ideal : Ideal(R, I)
  shows Ideal(R, jacobsonRadical(R, I))
proof
  sorry

theorem jacobsonRadical.subset (I : Set)
  requires ideal : Ideal(R, I)
  shows I ⊆ jacobsonRadical(R, I)
proof
  sorry

theorem jacobsonRadical.mem_zero_iff (x : R)
  shows x ∈ jacobsonRadical(R, {R[0]}) ↔
    (∀ y ∈ R.carrier, RingUnit(R, R[1] + x * y))
proof
  sorry

theorem jacobsonRadical.radical (I : Set)
  requires ideal : Ideal(R, I)
  shows RadicalIdeal(R, jacobsonRadical(R, I))
proof
  sorry

theorem nilradical.subset_jacobson
  shows nilradical(R) ⊆ jacobsonRadical(R, {R[0]})
proof
  sorry

-- Colon ideals (Submodule.colon, Ideal.le_colon).
theorem idealColon.ideal (I J : Set)
  requires first : Ideal(R, I)
  requires second : J ⊆ R.carrier
  shows Ideal(R, idealColon(R, I, J))
proof
  sorry

theorem idealColon.contains (I J : Set)
  requires ideal : Ideal(R, I)
  shows I ⊆ idealColon(R, I, J)
proof
  sorry

-- Minimal primes. Every prime over I contains a minimal prime over I
-- (Ideal.exists_minimalPrimes_le): Zorn's lemma on descending chains of
-- primes, so Choice. A proper ideal has a minimal prime over it
-- (Ideal.nonempty_minimalPrimes), again Choice.
theorem MinimalPrimeOver.exists_below (I P : Set)
  requires ideal : Ideal(R, I)
  requires prime : PrimeIdeal(R, P)
  requires over : I ⊆ P
  shows ∃ Q, MinimalPrimeOver(R, I, Q) ∧ Q ⊆ P
proof
  sorry

theorem MinimalPrimeOver.exists (I : Set)
  requires proper : ProperIdeal(R, I)
  shows ∃ P, MinimalPrimeOver(R, I, P)
proof
  sorry

-- Maximal ideals: Ideal.exists_le_maximal and Ideal.ne_top_iff_exists_maximal
-- (Choice, through Cumulus's maximal principle); a maximal ideal M with
-- x ∉ M has M + (x) = R (Ideal.IsMaximal.exists_inv).
theorem ProperIdeal.iff_exists_maximal (I : Set)
  requires ideal : Ideal(R, I)
  shows ProperIdeal(R, I) ↔ (∃ M, MaximalIdeal(R, M) ∧ I ⊆ M)
proof
  sorry

theorem MaximalIdeal.exists_inverse (M x : Set)
  requires maximal : MaximalIdeal(R, M)
  requires element : x ∈ R.carrier
  requires outside : x ∉ M
  shows ∃ y ∈ R.carrier, ∃ m ∈ M, call2(R.add, call2(R.mul, x, y), m) = R[1]
proof
  sorry

-- Distinct maximal ideals are coprime (Ideal.isCoprime_of_isMaximal).
theorem MaximalIdeal.coprime (M N : Set)
  requires first : MaximalIdeal(R, M)
  requires second : MaximalIdeal(R, N)
  requires distinct : M ≠ N
  shows idealSum(R, M, N) = R.carrier
proof
  sorry

end IdealOperations

-- Section: Extension and contraction along a homomorphism
section ExtensionContraction
variable (f R S : Set)
hypothesis source : CommRing(R)
hypothesis target : CommRing(S)
hypothesis hom : f : R →+* S

-- Ideal.map and Ideal.comap: ideals; the Galois connection
-- (Ideal.map_le_iff_le_comap, le_comap_map, map_comap_le); functoriality
-- (Ideal.map_map, Ideal.comap_comap); monotonicity; generators
-- (Ideal.map_span); sums, products and powers (Ideal.map_sup,
-- Ideal.map_mul, Ideal.map_pow); the kernel inside every contraction
-- (Ideal.ker_le_comap).
theorem idealExtension.ideal (I : Set)
  shows Ideal(S, idealExtension(f, S, I))
proof
  sorry

theorem idealComap.ideal_of_hom (J : Set)
  requires ideal : Ideal(S, J)
  shows Ideal(R, idealComap(f, R.carrier, J))
proof
  sorry

theorem idealExtension.subset_iff (I J : Set)
  requires first : Ideal(R, I)
  requires second : Ideal(S, J)
  shows idealExtension(f, S, I) ⊆ J ↔ I ⊆ idealComap(f, R.carrier, J)
proof
  sorry

theorem idealExtension.mem_of_mem (I x : Set)
  requires ideal : Ideal(R, I)
  requires member : x ∈ I
  shows f(x) ∈ idealExtension(f, S, I)
proof
  sorry

theorem idealExtension.mono (I J : Set)
  requires subset : I ⊆ J
  shows idealExtension(f, S, I) ⊆ idealExtension(f, S, J)
proof
  sorry

theorem idealComap.mono_of_hom (I J : Set)
  requires subset : I ⊆ J
  shows idealComap(f, R.carrier, I) ⊆ idealComap(f, R.carrier, J)
proof
  sorry

theorem idealExtension.generated (G : Set)
  requires bounded : G ⊆ R.carrier
  shows idealExtension(f, S, generatedIdeal(R, G)) =
    generatedIdeal(S, functionImage(f, G, S.carrier))
proof
  sorry

theorem idealExtension.sum (I J : Set)
  requires first : Ideal(R, I)
  requires second : Ideal(R, J)
  shows idealExtension(f, S, idealSum(R, I, J)) =
    idealSum(S, idealExtension(f, S, I), idealExtension(f, S, J))
proof
  sorry

theorem idealExtension.product (I J : Set)
  requires first : Ideal(R, I)
  requires second : Ideal(R, J)
  shows idealExtension(f, S, idealProduct(R, I, J)) =
    idealProduct(S, idealExtension(f, S, I), idealExtension(f, S, J))
proof
  sorry

theorem idealExtension.pow (I : Set) (n : Nat)
  requires ideal : Ideal(R, I)
  shows idealExtension(f, S, idealPow(R, I, n)) =
    idealPow(S, idealExtension(f, S, I), n)
proof
  sorry

theorem idealExtension.whole
  shows idealExtension(f, S, R.carrier) = S.carrier
proof
  sorry

theorem idealComap.kernel_subset_of_hom (J : Set)
  requires ideal : Ideal(S, J)
  shows ker(f) ⊆ idealComap(f, R.carrier, J)
proof
  sorry

-- Ideal.map_eq_bot_iff_le_ker.
theorem idealExtension.eq_zero_iff (I : Set)
  requires ideal : Ideal(R, I)
  shows idealExtension(f, S, I) = {S[0]} ↔ I ⊆ ker(f)
proof
  sorry

-- The contraction of a prime is prime (Ideal.comap_isPrime, under
-- RingHom.ker_isPrime for the zero ideal of a domain), and of a proper
-- ideal proper (Ideal.comap_ne_top).
theorem idealComap.prime_of_hom (P : Set)
  requires prime : PrimeIdeal(S, P)
  shows PrimeIdeal(R, idealComap(f, R.carrier, P))
proof
  sorry

theorem RingHom.kernel_prime
  requires domain : IntegralDomain(S)
  shows PrimeIdeal(R, ker(f))
proof
  sorry

-- RingHom.ker_ne_top: the kernel of a map to a nontrivial ring is proper.
theorem RingHom.kernel_proper
  requires nontrivial : S[0] ≠ S[1]
  shows ProperIdeal(R, ker(f))
proof
  sorry

-- RingHom.injective_iff_ker_eq_bot.
theorem RingHom.injective_iff_kernel
  shows InjectiveBetween(f, R.carrier, S.carrier) ↔ ker(f) = {R[0]}
proof
  sorry

-- For surjective f, extension and contraction are inverse bijections
-- between ideals of S and ideals of R containing the kernel
-- (Ideal.map_comap_of_surjective, Ideal.comap_map_of_surjective,
-- Ideal.comap_injective_of_surjective, Ideal.map_isPrime_of_surjective).
theorem idealExtension.contraction_of_surjective (J : Set)
  requires surjective : SurjectiveBetween(f, R.carrier, S.carrier)
  requires ideal : Ideal(S, J)
  shows idealExtension(f, S, idealComap(f, R.carrier, J)) = J
proof
  sorry

theorem idealComap.extension_of_surjective (I : Set)
  requires surjective : SurjectiveBetween(f, R.carrier, S.carrier)
  requires ideal : Ideal(R, I)
  shows idealComap(f, R.carrier, idealExtension(f, S, I)) = idealSum(R, I, ker(f))
proof
  sorry

theorem idealExtension.prime_of_surjective (P : Set)
  requires surjective : SurjectiveBetween(f, R.carrier, S.carrier)
  requires prime : PrimeIdeal(R, P)
  requires kernel : ker(f) ⊆ P
  shows PrimeIdeal(S, idealExtension(f, S, P))
proof
  sorry

-- For surjective f, the image of an ideal is already an ideal.
theorem idealExtension.image_of_surjective (I : Set)
  requires surjective : SurjectiveBetween(f, R.carrier, S.carrier)
  requires ideal : Ideal(R, I)
  shows idealExtension(f, S, I) = functionImage(f, I, S.carrier)
proof
  sorry

-- Ideal.map_radical_le.
theorem idealExtension.radical_subset (I : Set)
  requires ideal : Ideal(R, I)
  shows idealExtension(f, S, idealRadical(R, I)) ⊆
    idealRadical(S, idealExtension(f, S, I))
proof
  sorry

end ExtensionContraction

-- Functoriality of extension (Ideal.map_map) and of contraction.
theorem idealExtension.compose (f g R S T I : Set)
  requires ringR : CommRing(R)
  requires ringS : CommRing(S)
  requires ringT : CommRing(T)
  requires first : f : R →+* S
  requires second : g : S →+* T
  requires ideal : Ideal(R, I)
  shows idealExtension(g, T, idealExtension(f, S, I)) =
    idealExtension(compose(g, f, Ring.carrier(R), Ring.carrier(S),
      Ring.carrier(T)), T, I)
proof
  sorry

theorem idealComap.compose (f g R S T J : Set)
  requires ringR : CommRing(R)
  requires ringS : CommRing(S)
  requires ringT : CommRing(T)
  requires first : f : R →+* S
  requires second : g : S →+* T
  shows idealComap(f, Ring.carrier(R), idealComap(g, Ring.carrier(S), J)) =
    idealComap(compose(g, f, Ring.carrier(R), Ring.carrier(S),
      Ring.carrier(T)), Ring.carrier(R), J)
proof
  sorry

-- Section: Quotient rings
section Quotients
variable (R I : Set)
hypothesis comm : CommRing(R)
hypothesis ideal : Ideal(R, I)

-- Ideal.Quotient.mk is a surjective homomorphism with kernel I
-- (Ideal.mk_ker, Ideal.Quotient.mk_surjective).
theorem quotientMk.hom
  shows quotientMk(R, I) : R →+* R ⧸ I
proof
  sorry

theorem quotientMk.surjective
  shows SurjectiveBetween(quotientMk(R, I), R.carrier, Ring.carrier(R ⧸ I))
proof
  sorry

theorem quotientMk.kernel
  shows ringKernel(quotientMk(R, I), R.carrier, Ring.zero(R ⧸ I)) = I
proof
  sorry

theorem quotientRing.comm_ring_of_ideal
  shows CommRing(R ⧸ I)
proof
  sorry

-- Ideal.Quotient.eq, eq_zero_iff_mem, mk_eq_one_iff_sub_mem, and
-- eq_zero_iff_dvd for a principal ideal.
theorem quotientMk.eq_iff (x y : R)
  shows quotientMk(R, I)(x) = quotientMk(R, I)(y) ↔ x - y ∈ I
proof
  sorry

theorem quotientMk.eq_zero_iff (x : R)
  shows quotientMk(R, I)(x) = Ring.zero(R ⧸ I) ↔ x ∈ I
proof
  sorry

theorem quotientMk.eq_one_iff (x : R)
  shows quotientMk(R, I)(x) = Ring.one(R ⧸ I) ↔ x - R[1] ∈ I
proof
  sorry

-- Ideal.Quotient.lift: a homomorphism killing I factors through R ⧸ I,
-- uniquely (Ideal.Quotient.lift_mk, Ideal.Quotient.ringHom_ext), with
-- kernel the image of its kernel (Ideal.ker_quotient_lift).
theorem quotientRingLift.hom (S f : Set)
  requires target : CommRing(S)
  requires map : f : R →+* S
  requires killed : I ⊆ ker(f)
  shows quotientRingLift(R, S, I, f) : R ⧸ I →+* S
proof
  sorry

theorem quotientRingLift.apply_mk (S f x : Set)
  requires target : CommRing(S)
  requires map : f : R →+* S
  requires killed : I ⊆ ker(f)
  requires element : x ∈ R.carrier
  shows quotientRingLift(R, S, I, f)(quotientMk(R, I)(x)) = f(x)
proof
  sorry

theorem quotientRingLift.unique (S f g : Set)
  requires target : CommRing(S)
  requires map : g : R ⧸ I →+* S
  requires agrees : ∀ x ∈ R.carrier, g(quotientMk(R, I)(x)) = f(x)
  shows g = quotientRingLift(R, S, I, f)
proof
  sorry

-- Ideal.Quotient.ringHom_ext.
theorem quotientRing.hom_ext (S g h : Set)
  requires target : CommRing(S)
  requires first : g : R ⧸ I →+* S
  requires second : h : R ⧸ I →+* S
  requires agrees : ∀ x ∈ R.carrier, g(quotientMk(R, I)(x)) = h(quotientMk(R, I)(x))
  shows g = h
proof
  sorry

theorem quotientRingLift.kernel (S f : Set)
  requires target : CommRing(S)
  requires map : f : R →+* S
  requires killed : I ⊆ ker(f)
  shows ringKernel(quotientRingLift(R, S, I, f), Ring.carrier(R ⧸ I), S.zero) =
    functionImage(quotientMk(R, I), ker(f), Ring.carrier(R ⧸ I))
proof
  sorry

-- Ideals of R ⧸ I correspond to ideals of R containing I (Ideal.map_mk,
-- Ideal.comap_map_quotientMk, Ideal.map_quotient_self).
theorem quotientRing.ideal_correspondence (J : Set)
  requires idealJ : Ideal(R, J)
  requires contains : I ⊆ J
  shows Ideal(R ⧸ I, idealExtension(quotientMk(R, I), R ⧸ I, J)) ∧
    idealComap(quotientMk(R, I), R.carrier,
      idealExtension(quotientMk(R, I), R ⧸ I, J)) = J
proof
  sorry

theorem quotientRing.extension_self
  shows idealExtension(quotientMk(R, I), R ⧸ I, I) = {Ring.zero(R ⧸ I)}
proof
  sorry

-- R ⧸ I is nontrivial iff I is proper, a domain iff I is prime
-- (Ideal.Quotient.isDomain_iff_prime), and a field iff I is maximal
-- (Ideal.Quotient.maximal_ideal_iff_isField_quotient, Ideal.Quotient.field).
theorem quotientRing.nontrivial_iff
  shows Ring.zero(R ⧸ I) ≠ Ring.one(R ⧸ I) ↔ ProperIdeal(R, I)
proof
  sorry

theorem quotientRing.domain_iff
  shows IntegralDomain(R ⧸ I) ↔ PrimeIdeal(R, I)
proof
  sorry

theorem quotientRing.field_iff
  shows Field(R ⧸ I) ↔ MaximalIdeal(R, I)
proof
  sorry

-- The quotient by a finitely generated ideal I: a homomorphism killing the
-- generators kills I.
theorem quotientRing.kills_generated (S f G : Set)
  requires target : CommRing(S)
  requires map : f : R →+* S
  requires bounded : G ⊆ R.carrier
  requires generators : ∀ g ∈ G, f(g) = S[0]
  shows generatedIdeal(R, G) ⊆ ker(f)
proof
  sorry

end Quotients

-- Maps between quotients (Ideal.quotientMap, Ideal.quotientMap_mk,
-- Ideal.quotientMap_injective', Ideal.Quotient.factor, factor_eq,
-- factor_surjective).
section QuotientMaps
variable (f R S I J : Set)
hypothesis source : CommRing(R)
hypothesis target : CommRing(S)
hypothesis hom : f : R →+* S
hypothesis idealI : Ideal(R, I)
hypothesis idealJ : Ideal(S, J)
hypothesis compatible : I ⊆ idealComap(f, R.carrier, J)

theorem quotientRingMap.hom
  shows quotientRingMap(R, S, f, I, J) : R ⧸ I →+* S ⧸ J
proof
  sorry

theorem quotientRingMap.apply_mk (x : R)
  shows quotientRingMap(R, S, f, I, J)(quotientMk(R, I)(x)) =
    quotientMk(S, J)(f(x))
proof
  sorry

-- The induced map is injective when I is the full contraction of J.
theorem quotientRingMap.injective
  requires contraction : idealComap(f, R.carrier, J) = I
  shows InjectiveBetween(quotientRingMap(R, S, f, I, J),
    Ring.carrier(R ⧸ I), Ring.carrier(S ⧸ J))
proof
  sorry

theorem quotientRingMap.surjective
  requires surjective : SurjectiveBetween(f, R.carrier, S.carrier)
  shows SurjectiveBetween(quotientRingMap(R, S, f, I, J),
    Ring.carrier(R ⧸ I), Ring.carrier(S ⧸ J))
proof
  sorry

end QuotientMaps

section QuotientFactor
variable (R I J : Set)
hypothesis comm : CommRing(R)
hypothesis idealI : Ideal(R, I)
hypothesis idealJ : Ideal(R, J)
hypothesis subset : I ⊆ J

theorem quotientFactor.hom
  shows quotientFactor(R, I, J) : R ⧸ I →+* R ⧸ J
proof
  sorry

theorem quotientFactor.apply_mk (x : R)
  shows quotientFactor(R, I, J)(quotientMk(R, I)(x)) = quotientMk(R, J)(x)
proof
  sorry

theorem quotientFactor.surjective
  shows SurjectiveBetween(quotientFactor(R, I, J), Ring.carrier(R ⧸ I),
    Ring.carrier(R ⧸ J))
proof
  sorry

-- The third isomorphism theorem: the kernel of R ⧸ I → R ⧸ J is J ⧸ I
-- (Ideal.quotientQuotientEquivQuotient).
theorem quotientFactor.kernel
  shows ringKernel(quotientFactor(R, I, J), Ring.carrier(R ⧸ I),
      Ring.zero(R ⧸ J)) =
    functionImage(quotientMk(R, I), J, Ring.carrier(R ⧸ I))
proof
  sorry

end QuotientFactor

-- The first isomorphism theorem for a surjective homomorphism
-- (RingHom.quotientKerEquivOfSurjective, Ideal.quotientKerAlgEquivOfSurjective).
theorem RingHom.quotient_kernel_iso (f R S : Set)
  requires source : CommRing(R)
  requires target : CommRing(S)
  requires hom : f : R →+* S
  requires surjective : SurjectiveBetween(f, Ring.carrier(R), Ring.carrier(S))
  shows quotientRingLift(R, S, ringKernel(f, Ring.carrier(R), Ring.zero(S)), f) :
    R ⧸ ringKernel(f, Ring.carrier(R), Ring.zero(S)) ≃+* S
proof
  sorry

-- Equal ideals give equal quotients (Ideal.quotientEquivAlgOfEq).
theorem quotientRing.congr (R I J : Set)
  requires equal : I = J
  shows quotientRing(R, I) = quotientRing(R, J)
proof
  sorry

-- Section: Products of rings and the Chinese remainder theorem
section PiRings
variable (I F : Set)
hypothesis rings : ∀ i ∈ I, CommRing(F(i))

theorem piRing.comm_ring
  shows CommRing(piRing(I, F))
proof
  sorry

theorem piRing.carrier_mem (u : Set)
  shows u ∈ Ring.carrier(piRing(I, F)) ↔
    (u : I → piUnion(I, F)) ∧ (∀ i ∈ I, u(i) ∈ Ring.carrier(F(i)))
proof
  sorry

theorem piRing.add_apply (u v i : Set)
  requires first : u ∈ Ring.carrier(piRing(I, F))
  requires second : v ∈ Ring.carrier(piRing(I, F))
  requires index : i ∈ I
  shows call2(Ring.add(piRing(I, F)), u, v)(i) = call2(Ring.add(F(i)), u(i), v(i))
proof
  sorry

theorem piRing.mul_apply (u v i : Set)
  requires first : u ∈ Ring.carrier(piRing(I, F))
  requires second : v ∈ Ring.carrier(piRing(I, F))
  requires index : i ∈ I
  shows call2(Ring.mul(piRing(I, F)), u, v)(i) = call2(Ring.mul(F(i)), u(i), v(i))
proof
  sorry

theorem piRing.one_apply (i : Set)
  requires index : i ∈ I
  shows Ring.one(piRing(I, F))(i) = Ring.one(F(i))
proof
  sorry

theorem piRing.zero_apply (i : Set)
  requires index : i ∈ I
  shows Ring.zero(piRing(I, F))(i) = Ring.zero(F(i))
proof
  sorry

-- Pi.ext: elements agreeing at every index are equal.
theorem piRing.ext (u v : Set)
  requires first : u ∈ Ring.carrier(piRing(I, F))
  requires second : v ∈ Ring.carrier(piRing(I, F))
  requires agree : ∀ i ∈ I, u(i) = v(i)
  shows u = v
proof
  sorry

theorem piProjection.hom (i : Set)
  requires index : i ∈ I
  shows piProjection(I, F, i) : piRing(I, F) →+* F(i)
proof
  sorry

-- Pi.ringHom: a family of homomorphisms into the factors is one
-- homomorphism into the product, and it is the only one with those
-- projections.
theorem piLift.hom (R f : Set)
  requires source : CommRing(R)
  requires homs : ∀ i ∈ I, f(i) : R →+* F(i)
  shows piLift(R, I, F, f) : R →+* piRing(I, F)
proof
  sorry

theorem piLift.apply (R f x i : Set)
  requires source : CommRing(R)
  requires homs : ∀ i ∈ I, f(i) : R →+* F(i)
  requires element : x ∈ Ring.carrier(R)
  requires index : i ∈ I
  shows piLift(R, I, F, f)(x)(i) = f(i)(x)
proof
  sorry

theorem piLift.unique (R f g : Set)
  requires source : CommRing(R)
  requires map : g : R →+* piRing(I, F)
  requires agrees : ∀ i ∈ I, ∀ x ∈ Ring.carrier(R), g(x)(i) = f(i)(x)
  shows g = piLift(R, I, F, f)
proof
  sorry

end PiRings

-- The Chinese remainder theorem: for pairwise coprime ideals I(0), …,
-- I(n − 1), R ⧸ ⋂ I(k) ≅ Πₖ R ⧸ I(k) (Ideal.quotientInfRingEquivPiQuotient;
-- the injectivity Ideal.quotientInfToPiQuotient_inj holds for every
-- family). Without the isomorphism, the elementwise form
-- Ideal.exists_forall_sub_mem_ideal: congruences modulo pairwise coprime
-- ideals have a common solution.
section ChineseRemainder
variable (R I : Set) (n : Nat)
hypothesis comm : CommRing(R)
hypothesis ideals : ∀ k ∈ n, Ideal(R, I(k))

theorem chineseRemainderMap.hom
  shows chineseRemainderMap(R, n, I) :
    R ⧸ idealFamilyIntersection(R, n, I) →+* piRing(n, quotientFamily(R, n, I))
proof
  sorry

theorem chineseRemainderMap.injective
  shows InjectiveBetween(chineseRemainderMap(R, n, I),
    Ring.carrier(R ⧸ idealFamilyIntersection(R, n, I)),
    Ring.carrier(piRing(n, quotientFamily(R, n, I))))
proof
  sorry

theorem chineseRemainderMap.iso
  requires coprime : ∀ j k ∈ n, j ≠ k → idealSum(R, I(j), I(k)) = R.carrier
  shows chineseRemainderMap(R, n, I) :
    R ⧸ idealFamilyIntersection(R, n, I) ≃+* piRing(n, quotientFamily(R, n, I))
proof
  sorry

theorem chineseRemainder.exists_solution (x : Set)
  requires coprime : ∀ j k ∈ n, j ≠ k → idealSum(R, I(j), I(k)) = R.carrier
  requires targets : x : n → R.carrier
  shows ∃ y ∈ R.carrier, ∀ k ∈ n, call2(R.add, y, apply(R.neg, x(k))) ∈ I(k)
proof
  sorry

end ChineseRemainder

-- Section: The index of an ideal
-- The number of elements of R ⧸ I when it is finite (Submodule.cardQuot,
-- Ideal.absNorm on the rings where quotients are finite); outside that
-- case no value is asserted.
section IdealIndex
variable (R : Set)
hypothesis comm : CommRing(R)

theorem quotientRing.index_one
  shows HasCardinality(Ring.carrier(R ⧸ R.carrier), 1)
proof
  sorry

-- The index is 1 exactly for the whole ring (Ideal.absNorm_eq_one_iff).
theorem quotientRing.index_one_iff (I : Set)
  requires ideal : Ideal(R, I)
  shows HasCardinality(Ring.carrier(R ⧸ I), 1) ↔ I = R.carrier
proof
  sorry

-- The index is multiplicative along I ⊆ J: |R ⧸ I| = |R ⧸ J| |J ⧸ I|,
-- read as |R ⧸ I| = |R ⧸ J| · |{classes of J}| (Submodule.cardQuot_mul
-- in the tower form).
theorem quotientRing.index_tower (I J : Set) (a b : Nat)
  requires first : Ideal(R, I)
  requires second : Ideal(R, J)
  requires subset : I ⊆ J
  requires outer : HasCardinality(Ring.carrier(R ⧸ J), a)
  requires inner : HasCardinality(functionImage(quotientMk(R, I), J,
    Ring.carrier(R ⧸ I)), b)
  shows HasCardinality(Ring.carrier(R ⧸ I), a * b)
proof
  sorry

-- An ideal of finite index containing a product: in the Chinese
-- remainder situation, the index of a finite intersection of pairwise
-- coprime ideals is the product of the indices (Ideal.absNorm_mul for
-- coprime ideals).
theorem quotientRing.index_coprime (I J : Set) (a b : Nat)
  requires first : Ideal(R, I)
  requires second : Ideal(R, J)
  requires coprime : idealSum(R, I, J) = R.carrier
  requires indexI : HasCardinality(Ring.carrier(R ⧸ I), a)
  requires indexJ : HasCardinality(Ring.carrier(R ⧸ J), b)
  shows HasCardinality(Ring.carrier(R ⧸ (I ∩ J)), a * b)
proof
  sorry

end IdealIndex

-- Section: Ideals and modules
section IdealsAsModules
variable (R : Set)
hypothesis comm : CommRing(R)

-- An ideal is a submodule of R over itself (Ideal := Submodule R R), and
-- the ideal generated by G is its span.
theorem Ideal.iff_submodule (I : Set)
  shows Ideal(R, I) ↔ SubmoduleOf(I, selfModule(R), R)
proof
  sorry

theorem generatedIdeal.module_span (G : Set)
  requires bounded : G ⊆ R.carrier
  shows generatedIdeal(R, G) = moduleSpan(selfModule(R), R, G)
proof
  sorry

-- The kernel of a ring homomorphism is the kernel of the underlying
-- linear map of R-modules.
theorem RingHom.kernel_ideal (f S : Set)
  requires target : CommRing(S)
  requires hom : f : R →+* S
  shows Ideal(R, ringKernel(f, R.carrier, S.zero))
proof
  sorry

end IdealsAsModules

section IdealSmul
variable (R M : Set)
hypothesis comm : CommRing(R)
hypothesis module : Module(M, R)

-- I • N is a submodule inside N, containing r • v for r ∈ I, v ∈ N
-- (Submodule.smul_mem_smul), the least such (Submodule.smul_le);
-- monotone; (I J) • N = I • (J • N) (Submodule.mul_smul); and
-- (I + J) • N = I • N + J • N (Submodule.sup_smul).
theorem idealSmul.submodule (I N : Set)
  requires ideal : Ideal(R, I)
  requires sub : SubmoduleOf(N, M, R)
  shows SubmoduleOf(idealSmul(M, R, I, N), M, R) ∧ idealSmul(M, R, I, N) ⊆ N
proof
  sorry

theorem idealSmul.smul_mem (I N r v : Set)
  requires ideal : Ideal(R, I)
  requires sub : SubmoduleOf(N, M, R)
  requires scalar : r ∈ I
  requires vector : v ∈ N
  shows call2(M.smul, r, v) ∈ idealSmul(M, R, I, N)
proof
  sorry

theorem idealSmul.least (I N P : Set)
  requires ideal : Ideal(R, I)
  requires sub : SubmoduleOf(N, M, R)
  requires target : SubmoduleOf(P, M, R)
  shows idealSmul(M, R, I, N) ⊆ P ↔
    (∀ r ∈ I, ∀ v ∈ N, call2(M.smul, r, v) ∈ P)
proof
  sorry

theorem idealSmul.mono (I J N P : Set)
  requires ideals : I ⊆ J
  requires subs : N ⊆ P
  shows idealSmul(M, R, I, N) ⊆ idealSmul(M, R, J, P)
proof
  sorry

theorem idealSmul.product (I J N : Set)
  requires first : Ideal(R, I)
  requires second : Ideal(R, J)
  requires sub : SubmoduleOf(N, M, R)
  shows idealSmul(M, R, idealProduct(R, I, J), N) =
    idealSmul(M, R, I, idealSmul(M, R, J, N))
proof
  sorry

theorem idealSmul.sum (I J N : Set)
  requires first : Ideal(R, I)
  requires second : Ideal(R, J)
  requires sub : SubmoduleOf(N, M, R)
  shows idealSmul(M, R, idealSum(R, I, J), N) =
    submoduleSum(M, idealSmul(M, R, I, N), idealSmul(M, R, J, N))
proof
  sorry

-- For the module R itself, I • J is the product ideal (Ideal.smul_eq_mul).
theorem idealSmul.self_module (I J : Set)
  requires first : Ideal(R, I)
  requires second : Ideal(R, J)
  shows idealSmul(selfModule(R), R, I, J) = idealProduct(R, I, J)
proof
  sorry

-- For a principal ideal, (a) • M = a M (Submodule.ideal_span_singleton_smul).
theorem idealSmul.multiples (a : R)
  shows idealSmul(M, R, ringMultiples(R, a), M.carrier) =
    scalarMultipleImage(M, a)
proof
  sorry

-- Annihilators: ideals (Module.annihilator, Ideal.torsionOf), the
-- annihilator of a vector is everything exactly for the zero vector
-- (Ideal.torsionOf_eq_top_iff), the torsion by r is a submodule.
theorem moduleAnnihilator.ideal
  shows Ideal(R, moduleAnnihilator(M, R))
proof
  sorry

theorem vectorAnnihilator.ideal (v : M)
  shows Ideal(R, vectorAnnihilator(M, R, v))
proof
  sorry

theorem vectorAnnihilator.eq_whole_iff (v : M)
  shows vectorAnnihilator(M, R, v) = R.carrier ↔ v = M.zero
proof
  sorry

theorem torsionBy.submodule (r : R)
  shows SubmoduleOf(torsionBy(M, R, r), M, R)
proof
  sorry

-- The annihilator of a quotient R ⧸ I as an R-module is I.
theorem moduleAnnihilator.quotient (I : Set)
  requires ideal : Ideal(R, I)
  shows moduleAnnihilator(quotientModule(selfModule(R), R, I), R) = I
proof
  sorry

end IdealSmul
