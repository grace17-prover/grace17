-- Divisibility in a commutative ring: divisibility, associated elements,
-- non-zero-divisors, integral domains, nilpotent elements and reduced
-- rings, coprime elements, principal ideals, irreducible and prime
-- elements, principal ideal domains, and unique factorization domains
-- (Mathlib's Dvd, Associated, nonZeroDivisors, IsDomain, IsNilpotent,
-- IsReduced, IsCoprime, Ideal.span {a}, Irreducible, Prime,
-- IsPrincipalIdealRing, and UniqueFactorizationMonoid).
-- Part of the GRH blueprint.
-- Planned home: Algebra/Ring/Divisibility.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Algebra.Divisibility
import GRH.Matrix.Determinant
import Grace.Cumulus.Algebra.Ring.MaximalIdeal
import Grace.Cumulus.Algebra.Ring.Pow

-- Section: Divisibility and associates
-- a ∣ b in R: b = a c for some c ∈ R (Mathlib's Dvd on a commutative
-- monoid). The units are track A's RingUnit and ringUnits.
predicate RingDvd (R a b : Set) :=
  a ∈ Ring.carrier(R) ∧ b ∈ Ring.carrier(R) ∧
  (∃ c ∈ Ring.carrier(R), b = call2(Ring.mul(R), a, c))

-- a and b are associated when b = a u for a unit u (Mathlib's Associated,
-- a * u = b).
predicate RingAssociated (R a b : Set) :=
  a ∈ Ring.carrier(R) ∧ b ∈ Ring.carrier(R) ∧
  (∃ u ∈ ringUnits(R), b = call2(Ring.mul(R), a, u))

-- a properly divides b: a ≠ 0 and b = a x with x not a unit (Mathlib's
-- DvdNotUnit).
predicate StrictDvd (R a b : Set) :=
  a ∈ Ring.carrier(R) ∧ b ∈ Ring.carrier(R) ∧ a ≠ Ring.zero(R) ∧
  (∃ x ∈ Ring.carrier(R), ¬RingUnit(R, x) ∧ b = call2(Ring.mul(R), a, x))

-- Section: Zero divisors, domains, nilpotents
-- The non-zero-divisors {x | ∀ y, y x = 0 → y = 0} (nonZeroDivisors).
def nonZeroDivisors (R : Set) : Set :=
  { x ∈ Ring.carrier(R) | ∀ y ∈ Ring.carrier(R),
    call2(Ring.mul(R), y, x) = Ring.zero(R) → y = Ring.zero(R) }

-- An integral domain: a nontrivial commutative ring without zero divisors
-- (Mathlib's IsDomain for a commutative ring). Cumulus's IsIntegralDomain
-- is the same notion over separate pieces.
predicate IntegralDomain (R : Set) :=
  CommRing(R) ∧ Ring.zero(R) ≠ Ring.one(R) ∧
  (∀ x y ∈ Ring.carrier(R), call2(Ring.mul(R), x, y) = Ring.zero(R) →
    x = Ring.zero(R) ∨ y = Ring.zero(R))

-- x is nilpotent when some power of x is zero; a ring is reduced when 0 is
-- its only nilpotent (IsNilpotent, IsReduced).
predicate RingNilpotent (R x : Set) :=
  x ∈ Ring.carrier(R) ∧ (∃ n ∈ ℕ, Ring.pow(R, x, n) = Ring.zero(R))

predicate ReducedRing (R : Set) :=
  CommRing(R) ∧ (∀ x ∈ Ring.carrier(R), RingNilpotent(R, x) → x = Ring.zero(R))

-- Section: Coprimality and principal ideals
-- a and b are coprime when u a + v b = 1 for some u, v (Mathlib's IsCoprime).
predicate RingCoprime (R a b : Set) :=
  a ∈ Ring.carrier(R) ∧ b ∈ Ring.carrier(R) ∧
  (∃ u v ∈ Ring.carrier(R), call2(Ring.add(R), call2(Ring.mul(R), u, a),
    call2(Ring.mul(R), v, b)) = Ring.one(R))

-- The multiples {c a} of a, the principal ideal (a) (Ideal.span {a}).
def ringMultiples (R a : Set) : Set :=
  { x ∈ Ring.carrier(R) | ∃ c ∈ Ring.carrier(R), x = call2(Ring.mul(R), c, a) }

predicate PrincipalIdeal (R I : Set) :=
  Ideal(R, I) ∧ (∃ a ∈ Ring.carrier(R), I = ringMultiples(R, a))

-- Section: Irreducible and prime elements
-- p is irreducible: not a unit, and in every factorization p = a b one
-- factor is a unit (Mathlib's Irreducible). p is prime: nonzero, not a
-- unit, and p ∣ a b implies p ∣ a or p ∣ b (Mathlib's Prime).
predicate RingIrreducible (R p : Set) :=
  p ∈ Ring.carrier(R) ∧ ¬RingUnit(R, p) ∧
  (∀ a b ∈ Ring.carrier(R), p = call2(Ring.mul(R), a, b) →
    RingUnit(R, a) ∨ RingUnit(R, b))

predicate RingPrime (R p : Set) :=
  p ∈ Ring.carrier(R) ∧ p ≠ Ring.zero(R) ∧ ¬RingUnit(R, p) ∧
  (∀ a b ∈ Ring.carrier(R), RingDvd(R, p, call2(Ring.mul(R), a, b)) →
    RingDvd(R, p, a) ∨ RingDvd(R, p, b))

-- Section: Principal ideal domains and unique factorization
-- A principal ideal domain: a domain all of whose ideals are principal
-- (IsDomain with IsPrincipalIdealRing).
predicate PrincipalIdealDomain (R : Set) :=
  IntegralDomain(R) ∧ (∀ I, Ideal(R, I) → PrincipalIdeal(R, I))

-- Strict divisibility is well founded: every nonempty set of elements has
-- a member with no proper divisor in the set (Mathlib's WfDvdMonoid,
-- WellFounded DvdNotUnit, read as the minimal condition).
predicate DvdWellFounded (R : Set) :=
  ∀ S, S ⊆ Ring.carrier(R) → S ≠ ∅ →
    (∃ m ∈ S, ∀ x ∈ S, ¬StrictDvd(R, x, m))

-- A unique factorization domain: a domain where strict divisibility is
-- well founded and every irreducible is prime (Mathlib's
-- UniqueFactorizationMonoid, by its definition through
-- WfDvdMonoid and irreducible_iff_prime).
predicate UniqueFactorizationDomain (R : Set) :=
  IntegralDomain(R) ∧ DvdWellFounded(R) ∧
  (∀ p ∈ Ring.carrier(R), RingIrreducible(R, p) → RingPrime(R, p))

-- Section: Laws of divisibility and units
section DivisibilityLaws
variable (R : Set)
hypothesis comm : CommRing(R)

-- Helpers: a divisibility from a witness, and powers of products.
theorem RingDvd.intro (a b c : R)
  requires equal : b = a * c
  shows RingDvd(R, a, b)
proof
  have aIn : a ∈ R.carrier by typecheck
  have bIn : b ∈ R.carrier by typecheck
  have cIn : c ∈ R.carrier by typecheck
  exact ⟨aIn, bIn, c, cIn, equal⟩

theorem Ring.mul_pow_comm (a b : R) (n : Nat)
  shows (a * b) ^ n = a ^ n * b ^ n
proof
  have ringR := CommRing.to_ring with comm
  induction n
  | zero =>
    have z1 := Ring.pow_zero at R, a * b with ringR
    have z2 := Ring.pow_zero at R, a with ringR
    have z3 := Ring.pow_zero at R, b with ringR
    rw [z1, z2, z3]
    ring
  | succ(k) using ih =>
    have shift := add.right_one at k with *
    rw ← shift
    have s1 := Ring.pow_succ at R, a * b, k with ringR
    have s2 := Ring.pow_succ at R, a, k with ringR
    have s3 := Ring.pow_succ at R, b, k with ringR
    rw [s1, s2, s3, ih]
    ring

theorem ringUnits.mem_of_unit (a : Set)
  requires unit : RingUnit(R, a)
  shows a ∈ ringUnits(R)
proof
  have unit0 := unit
  obtain ⟨aIn, _⟩ := unit0
  exact ringUnits.membership.backward at R, a with ⟨aIn, unit⟩

theorem RingNilpotent.geometric (x : R) (k : Nat)
  shows ∃ s ∈ R.carrier, (R[1] - x) * s = R[1] - x ^ k
proof
  have ringR := CommRing.to_ring with comm
  induction k
  | zero =>
    have zeroIn : R[0] ∈ R.carrier by typecheck
    have z := Ring.pow_zero at R, x with ringR
    rw z
    have law : (R[1] - x) * R[0] = R[1] - R[1] by ring
    exact ⟨R[0], zeroIn, law⟩
  | succ(j) using ih =>
    obtain ⟨s, sIn, law⟩ := ih
    have shift := add.right_one at j with *
    rw ← shift
    have st := Ring.pow_succ at R, x, j with ringR
    rw st
    have tIn : s + x ^ j ∈ R.carrier by typecheck
    have step : (R[1] - x) * (s + x ^ j) = R[1] - x ^ j * x
      have expand : (R[1] - x) * (s + x ^ j) = (R[1] - x) * s + (R[1] - x) * x ^ j by ring
      rw [expand, law]
      ring
    exact ⟨s + x ^ j, tIn, step⟩

-- The combinations u a + v b, the ideal generated by a and b.
def ringPairCombos (a b : Set) : Set :=
  { x ∈ R.carrier | ∃ u v ∈ R.carrier, x = u * a + v * b }

theorem ringPairCombos.ideal (a b : R)
  shows Ideal(R, ringPairCombos(R, a, b))
proof
  have ringR := CommRing.to_ring with comm
  apply Ideal.mk at R, ringPairCombos(R, a, b) with ringR
  . intros x hx
    obtain ⟨xIn, _⟩ := ringPairCombos.membership.forward at R, a, b, x with hx
    exact xIn
  . have zeroIn : R[0] ∈ R.carrier by typecheck
    have law : R[0] = R[0] * a + R[0] * b by ring
    exact ringPairCombos.membership.backward at R, a, b, R[0] with ⟨zeroIn, R[0], zeroIn, R[0], zeroIn, law⟩
  . intros x hx y hy
    obtain ⟨xIn, u, uIn, v, vIn, xc⟩ := ringPairCombos.membership.forward at R, a, b, x with hx
    obtain ⟨yIn, s, sIn, t, tIn, yc⟩ := ringPairCombos.membership.forward at R, a, b, y with hy
    have zIn : x + y ∈ R.carrier by typecheck
    have w1 : u + s ∈ R.carrier by typecheck
    have w2 : v + t ∈ R.carrier by typecheck
    have law : x + y = (u + s) * a + (v + t) * b
      rw [xc, yc]
      ring
    exact ringPairCombos.membership.backward at R, a, b, x + y with ⟨zIn, u + s, w1, v + t, w2, law⟩
  . intros x hx
    obtain ⟨xIn, u, uIn, v, vIn, xc⟩ := ringPairCombos.membership.forward at R, a, b, x with hx
    have zIn : -x ∈ R.carrier by typecheck
    have w1 : -u ∈ R.carrier by typecheck
    have w2 : -v ∈ R.carrier by typecheck
    have law : -x = (-u) * a + (-v) * b
      rw xc
      ring
    exact ringPairCombos.membership.backward at R, a, b, -x with ⟨zIn, -u, w1, -v, w2, law⟩
  . intros r hr x hx
    obtain ⟨xIn, u, uIn, v, vIn, xc⟩ := ringPairCombos.membership.forward at R, a, b, x with hx
    have z1 : r * x ∈ R.carrier by typecheck
    have z2 : x * r ∈ R.carrier by typecheck
    have w1 : r * u ∈ R.carrier by typecheck
    have w2 : r * v ∈ R.carrier by typecheck
    have l1 : r * x = (r * u) * a + (r * v) * b
      rw xc
      ring
    have l2 : x * r = (r * u) * a + (r * v) * b
      rw xc
      ring
    have m1 := ringPairCombos.membership.backward at R, a, b, r * x with ⟨z1, r * u, w1, r * v, w2, l1⟩
    have m2 := ringPairCombos.membership.backward at R, a, b, x * r with ⟨z2, r * u, w1, r * v, w2, l2⟩
    exact ⟨m1, m2⟩

theorem ringPairCombos.generated (a b : R)
  shows generatedIdeal(R, {a, b}) ⊆ ringPairCombos(R, a, b)
proof
  have ideal := ringPairCombos.ideal at R, a, b with comm
  have aIn : a ∈ R.carrier by assumption
  have bIn : b ∈ R.carrier by assumption
  have zeroIn : R[0] ∈ R.carrier by typecheck
  have oneIn : R[1] ∈ R.carrier by typecheck
  have la : a = R[1] * a + R[0] * b by ring
  have lb : b = R[0] * a + R[1] * b by ring
  have ma := ringPairCombos.membership.backward at R, a, b, a with ⟨aIn, R[1], oneIn, R[0], zeroIn, la⟩
  have mb := ringPairCombos.membership.backward at R, a, b, b with ⟨bIn, R[0], zeroIn, R[1], oneIn, lb⟩
  have pair : {a, b} ⊆ ringPairCombos(R, a, b)
    intros y hy
    rcases pair.membership.forward with hy with ya | yb
    . rw ya
      exact ma
    . rw yb
      exact mb
  exact generatedIdeal.least at R, {a, b}, ringPairCombos(R, a, b) with comm, ideal, pair

-- dvd_rfl, dvd_zero, one_dvd.
theorem RingDvd.refl (a : R)
  shows RingDvd(R, a, a)
proof
  have aIn : a ∈ R.carrier by typecheck
  have oneIn : R[1] ∈ R.carrier by typecheck
  have law : a = a * R[1] by ring
  exact ⟨aIn, aIn, R[1], oneIn, law⟩

theorem RingDvd.zero (a : R)
  shows RingDvd(R, a, R[0])
proof
  have aIn : a ∈ R.carrier by typecheck
  have zeroIn : R[0] ∈ R.carrier by typecheck
  have law : R[0] = a * R[0] by ring
  exact ⟨aIn, zeroIn, R[0], zeroIn, law⟩

theorem RingDvd.one (a : R)
  shows RingDvd(R, R[1], a)
proof
  have aIn : a ∈ R.carrier by typecheck
  have oneIn : R[1] ∈ R.carrier by typecheck
  have law : a = R[1] * a by ring
  exact ⟨oneIn, aIn, a, aIn, law⟩

-- dvd_trans.
theorem RingDvd.trans (a b c : R)
  requires first : RingDvd(R, a, b)
  requires second : RingDvd(R, b, c)
  shows RingDvd(R, a, c)
proof
  obtain ⟨aIn, bIn, x, xIn, bx⟩ := first
  obtain ⟨_, cIn, y, yIn, cy⟩ := second
  have xyIn : x * y ∈ R.carrier by typecheck
  have law : c = a * (x * y)
    rw [cy, bx]
    ring
  exact ⟨aIn, cIn, x * y, xyIn, law⟩

-- dvd_mul_right, dvd_mul_left, Dvd.dvd.mul_left, Dvd.dvd.mul_right.
theorem RingDvd.mul_self_right (a b : R)
  shows RingDvd(R, a, a * b)
proof
  have law : a * b = a * b by rfl
  exact RingDvd.intro at R, a, a * b, b with comm, law

theorem RingDvd.mul_self_left (a b : R)
  shows RingDvd(R, a, b * a)
proof
  have law : b * a = a * b by ring
  exact RingDvd.intro at R, a, b * a, b with comm, law

theorem RingDvd.mul_left (a b c : R)
  requires dvd : RingDvd(R, a, b)
  shows RingDvd(R, c * a, c * b)
proof
  obtain ⟨_, _, x, xIn, bx⟩ := dvd
  have law : c * b = (c * a) * x
    rw bx
    ring
  exact RingDvd.intro at R, c * a, c * b, x with comm, law

theorem RingDvd.mul_right (a b c : R)
  requires dvd : RingDvd(R, a, b)
  shows RingDvd(R, a, b * c)
proof
  obtain ⟨_, _, x, xIn, bx⟩ := dvd
  have law : b * c = a * (x * c)
    rw bx
    ring
  exact RingDvd.intro at R, a, b * c, x * c with comm, law

-- dvd_of_mul_left_dvd, dvd_of_mul_right_dvd.
theorem RingDvd.of_mul_left (a b c : R)
  requires dvd : RingDvd(R, a * b, c)
  shows RingDvd(R, b, c)
proof
  obtain ⟨_, _, x, xIn, cx⟩ := dvd
  have law : c = b * (a * x)
    rw cx
    ring
  exact RingDvd.intro at R, b, c, a * x with comm, law

theorem RingDvd.of_mul_right (a b c : R)
  requires dvd : RingDvd(R, a * b, c)
  shows RingDvd(R, a, c)
proof
  obtain ⟨_, _, x, xIn, cx⟩ := dvd
  have law : c = a * (b * x)
    rw cx
    ring
  exact RingDvd.intro at R, a, c, b * x with comm, law

-- dvd_add, dvd_sub, dvd_neg, dvd_add_right, dvd_sub_comm.
theorem RingDvd.add (a b c : R)
  requires first : RingDvd(R, a, b)
  requires second : RingDvd(R, a, c)
  shows RingDvd(R, a, b + c)
proof
  obtain ⟨_, _, x, xIn, bx⟩ := first
  obtain ⟨_, _, y, yIn, cy⟩ := second
  have law : b + c = a * (x + y)
    rw [bx, cy]
    ring
  exact RingDvd.intro at R, a, b + c, x + y with comm, law

theorem RingDvd.sub (a b c : R)
  requires first : RingDvd(R, a, b)
  requires second : RingDvd(R, a, c)
  shows RingDvd(R, a, b - c)
proof
  obtain ⟨_, _, x, xIn, bx⟩ := first
  obtain ⟨_, _, y, yIn, cy⟩ := second
  have law : b - c = a * (x - y)
    rw [bx, cy]
    ring
  exact RingDvd.intro at R, a, b - c, x - y with comm, law

theorem RingDvd.neg (a b : R)
  shows RingDvd(R, a, -b) ↔ RingDvd(R, a, b)
proof
  constructor
  . intro h
    obtain ⟨_, _, x, xIn, bx⟩ := h
    have law : b = a * (-x)
      have back : b = -(-b) by ring
      rw [back, bx]
      ring
    exact RingDvd.intro at R, a, b, -x with comm, law
  . intro h
    obtain ⟨_, _, x, xIn, bx⟩ := h
    have law : -b = a * (-x)
      rw bx
      ring
    exact RingDvd.intro at R, a, -b, -x with comm, law

theorem RingDvd.add_right_iff (a b c : R)
  requires dvd : RingDvd(R, a, b)
  shows RingDvd(R, a, b + c) ↔ RingDvd(R, a, c)
proof
  constructor
  . intro h
    have back : c = (b + c) - b by ring
    have d := RingDvd.sub at R, a, b + c, b with comm, h, dvd
    rw ← back at d
    exact d
  . intro h
    exact RingDvd.add at R, a, b, c with comm, dvd, h

theorem RingDvd.sub_comm (a b c : R)
  shows RingDvd(R, a, b - c) ↔ RingDvd(R, a, c - b)
proof
  constructor
  . intro h
    have n := (RingDvd.neg at R, a, b - c with comm).backward with h
    have same : -(b - c) = c - b by ring
    rw same at n
    exact n
  . intro h
    have n := (RingDvd.neg at R, a, c - b with comm).backward with h
    have same : -(c - b) = b - c by ring
    rw same at n
    exact n

-- dvd_pow_self and pow_dvd_pow.
theorem RingDvd.pow_self (a : R) (n : Nat)
  requires positive : 0 < n
  shows RingDvd(R, a, a ^ n)
proof
  have ringR := CommRing.to_ring with comm
  obtain ⟨k, kNat, nk⟩ := Less.exists_add_one at 0, n with positive
  have shift : n = k + 1 by arith
  rw shift
  have s := Ring.pow_succ_left at R, a, k with ringR
  rw s
  exact RingDvd.mul_self_right at R, a, a ^ k with comm

theorem RingDvd.pow_pow (a : R) (m n : Nat)
  requires le : m ≤ n
  shows RingDvd(R, a ^ m, a ^ n)
proof
  have ringR := CommRing.to_ring with comm
  obtain ⟨k, kNat, nk⟩ := LessEqual.exists_add at m, n with le
  rw nk
  have s := Ring.pow_add at R, a, m, k with ringR
  rw s
  exact RingDvd.mul_self_right at R, a ^ m, a ^ k with comm

theorem RingDvd.pow (a b : R) (n : Nat)
  requires dvd : RingDvd(R, a, b)
  shows RingDvd(R, a ^ n, b ^ n)
proof
  obtain ⟨_, _, x, xIn, bx⟩ := dvd
  have law : b ^ n = a ^ n * x ^ n
    rw bx
    exact Ring.mul_pow_comm at R, a, x, n with comm
  exact RingDvd.intro at R, a ^ n, b ^ n, x ^ n with comm, law

-- zero_dvd_iff.
theorem RingDvd.zero_left (a : R)
  shows RingDvd(R, R[0], a) ↔ a = R[0]
proof
  constructor
  . intro h
    obtain ⟨_, _, x, xIn, ax⟩ := h
    rw ax
    ring
  . intro h
    rw h
    exact RingDvd.refl at R, R[0] with comm

-- isUnit_iff_dvd_one, isUnit_of_dvd_unit, isUnit_of_dvd_one.
theorem RingUnit.iff_dvd_one (a : R)
  shows RingUnit(R, a) ↔ RingDvd(R, a, R[1])
proof
  constructor
  . intro h
    obtain ⟨_, b, bIn, ab, _⟩ := h
    have law : R[1] = a * b by rw ab
    exact RingDvd.intro at R, a, R[1], b with comm, law
  . intro h
    obtain ⟨_, _, b, bIn, ab⟩ := h
    have aIn : a ∈ R.carrier by typecheck
    have law : a * b = R[1] by rw ab
    exact RingUnit.of_product at R, a, b with comm, aIn, bIn, law

theorem RingUnit.of_dvd_unit (a b : R)
  requires dvd : RingDvd(R, a, b)
  requires unit : RingUnit(R, b)
  shows RingUnit(R, a)
proof
  have bOne := (RingUnit.iff_dvd_one at R, b with comm).forward with unit
  have aOne := RingDvd.trans at R, a, b, R[1] with comm, dvd, bOne
  exact (RingUnit.iff_dvd_one at R, a with comm).backward with aOne

-- IsUnit.dvd: a unit divides everything.
theorem RingUnit.dvd (u b : R)
  requires unit : RingUnit(R, u)
  shows RingDvd(R, u, b)
proof
  have uOne := (RingUnit.iff_dvd_one at R, u with comm).forward with unit
  have oneB := RingDvd.one at R, b with comm
  exact RingDvd.trans at R, u, R[1], b with comm, uOne, oneB

-- IsUnit.mul, IsUnit.mul_iff, IsUnit.pow, the inverse of a
-- unit, isUnit_iff_exists_inv (isUnit_one is in Matrix.Determinant).
theorem RingUnit.mul_iff (a b : R)
  shows RingUnit(R, a * b) ↔ RingUnit(R, a) ∧ RingUnit(R, b)
proof
  constructor
  . intro h
    have da := RingDvd.mul_self_right at R, a, b with comm
    have db := RingDvd.mul_self_left at R, b, a with comm
    have ua := RingUnit.of_dvd_unit at R, a, a * b with comm, da, h
    have ub := RingUnit.of_dvd_unit at R, b, a * b with comm, db, h
    exact ⟨ua, ub⟩
  . intro h
    obtain ⟨ua, ub⟩ := h
    exact RingUnit.mul at R, a, b with comm, ua, ub

theorem RingUnit.pow (a : R) (n : Nat)
  requires unit : RingUnit(R, a)
  shows RingUnit(R, a ^ n)
proof
  have ringR := CommRing.to_ring with comm
  induction n
  | zero =>
    have z := Ring.pow_zero at R, a with ringR
    rw z
    exact RingUnit.one at R with comm
  | succ(k) using ih =>
    have shift := add.right_one at k with *
    rw ← shift
    have s := Ring.pow_succ at R, a, k with ringR
    rw s
    exact RingUnit.mul at R, a ^ k, a with comm, ih, unit

theorem RingUnit.neg (a : R)
  shows RingUnit(R, -a) ↔ RingUnit(R, a)
proof
  constructor
  . intro h
    obtain ⟨_, b, bIn, ab, _⟩ := h
    have aIn : a ∈ R.carrier by typecheck
    have nbIn : -b ∈ R.carrier by typecheck
    have law : a * (-b) = R[1]
      rw ← ab
      ring
    exact RingUnit.of_product at R, a, -b with comm, aIn, nbIn, law
  . intro h
    obtain ⟨_, b, bIn, ab, _⟩ := h
    have aIn : -a ∈ R.carrier by typecheck
    have nbIn : -b ∈ R.carrier by typecheck
    have law : (-a) * (-b) = R[1]
      rw ← ab
      ring
    exact RingUnit.of_product at R, -a, -b with comm, aIn, nbIn, law

theorem RingUnit.iff_exists_inverse (a : R)
  shows RingUnit(R, a) ↔ (∃ b ∈ R.carrier, a * b = R[1])
proof
  constructor
  . intro h
    obtain ⟨_, b, bIn, ab, _⟩ := h
    exact ⟨b, bIn, ab⟩
  . intro h
    obtain ⟨b, bIn, ab⟩ := h
    have aIn : a ∈ R.carrier by typecheck
    exact RingUnit.of_product at R, a, b with comm, aIn, bIn, ab

theorem ringInverse.unit (a : R)
  requires unit : RingUnit(R, a)
  shows RingUnit(R, ringInverse(R, a)) ∧ a * ringInverse(R, a) = R[1]
proof
  have ringR := CommRing.to_ring with comm
  have mem := ringInverse.mem at R, a with *
  have left := ringInverse.mul_left at R, a with *
  have right := ringInverse.right_law at R, a with *
  have aIn : a ∈ R.carrier by typecheck
  have inv := RingUnit.of_product at R, ringInverse(R, a), a with comm, mem, aIn, left
  exact ⟨inv, right⟩

-- IsUnit.of_pow_eq_one.
theorem RingUnit.of_pow_eq_one (a : R) (n : Nat)
  requires positive : 0 < n
  requires root : a ^ n = R[1]
  shows RingUnit(R, a)
proof
  have ringR := CommRing.to_ring with comm
  obtain ⟨k, kNat, nk⟩ := Less.exists_add_one at 0, n with positive
  have shift : n = k + 1 by arith
  rw shift at root
  have s := Ring.pow_succ_left at R, a, k with ringR
  rw s at root
  have aIn : a ∈ R.carrier by typecheck
  have pIn : a ^ k ∈ R.carrier by typecheck
  exact RingUnit.of_product at R, a, a ^ k with comm, aIn, pIn, root

-- IsUnit.ne_zero.
theorem RingUnit.ne_zero (a : R)
  requires nontrivial : R[0] ≠ R[1]
  requires unit : RingUnit(R, a)
  shows a ≠ R[0]
proof
  intro h
  obtain ⟨_, b, bIn, ab, _⟩ := unit
  rw h at ab
  have z : R[0] * b = R[0] by ring
  rw z at ab
  exact nontrivial with ab

-- Units of the form 1 − x for nilpotent x (IsNilpotent.isUnit_one_sub),
-- and a unit plus a nilpotent is a unit.
theorem RingNilpotent.unit_one_sub (x : R)
  requires nilpotent : RingNilpotent(R, x)
  shows RingUnit(R, R[1] - x)
proof
  obtain ⟨_, n, nIn, xn⟩ := nilpotent
  have nNat : Nat(n) by typecheck
  obtain ⟨s, sIn, law⟩ := RingNilpotent.geometric at R, x, n with comm
  rw xn at law
  have clean : R[1] - R[0] = R[1] by ring
  rw clean at law
  have dIn : R[1] - x ∈ R.carrier by typecheck
  exact RingUnit.of_product at R, R[1] - x, s with comm, dIn, sIn, law

theorem RingNilpotent.unit_add (u x : R)
  requires unit : RingUnit(R, u)
  requires nilpotent : RingNilpotent(R, x)
  shows RingUnit(R, u + x)
proof
  have ringR := CommRing.to_ring with comm
  obtain ⟨vIn, right⟩ := ringInverse.unit at R, u with comm, unit
  have left := ringInverse.mul_left at R, u with *
  have vIn2 := ringInverse.mem at R, u with *
  obtain ⟨_, n, nIn, xn⟩ := nilpotent
  have nNat : Nat(n) by typecheck
  have yIn : -(ringInverse(R, u) * x) ∈ R.carrier by typecheck
  have yPow : (-(ringInverse(R, u) * x)) ^ n = R[0]
    have split : -(ringInverse(R, u) * x) = (-ringInverse(R, u)) * x by ring
    rw split
    have mp := Ring.mul_pow_comm at R, -ringInverse(R, u), x, n with comm
    rw [mp, xn]
    ring
  have yNil : RingNilpotent(R, -(ringInverse(R, u) * x)) by exact ⟨yIn, n, nIn, yPow⟩
  have w := RingNilpotent.unit_one_sub at R, -(ringInverse(R, u) * x) with comm, yNil
  have prod := RingUnit.mul at R, u, R[1] - -(ringInverse(R, u) * x) with comm, unit, w
  have same : u * (R[1] - -(ringInverse(R, u) * x)) = u + x
    have expand : u * (R[1] - -(ringInverse(R, u) * x)) = u + (u * ringInverse(R, u)) * x by ring
    rw [expand, right]
    ring
  rw same at prod
  exact prod

-- Associated is an equivalence relation, implies mutual divisibility, and
-- preserves being a unit (Associated.isUnit_iff).
theorem RingAssociated.refl (a : R)
  shows RingAssociated(R, a, a)
proof
  have aIn : a ∈ R.carrier by typecheck
  have one := RingUnit.one at R with comm
  have oneIn := ringUnits.mem_of_unit at R, R[1] with comm, one
  have law : a = a * R[1] by ring
  exact ⟨aIn, aIn, R[1], oneIn, law⟩

theorem RingAssociated.symm (a b : R)
  requires associated : RingAssociated(R, a, b)
  shows RingAssociated(R, b, a)
proof
  obtain ⟨aIn, bIn, u, uMem, bu⟩ := associated
  obtain ⟨uIn, unit⟩ := ringUnits.membership.forward at R, u with uMem
  obtain ⟨invUnit, right⟩ := ringInverse.unit at R, u with comm, unit
  have vMem := ringUnits.mem_of_unit at R, ringInverse(R, u) with comm, invUnit
  have law : a = b * ringInverse(R, u)
    rw bu
    have regroup : a * u * ringInverse(R, u) = a * (u * ringInverse(R, u)) by ring
    rw [regroup, right]
    ring
  exact ⟨bIn, aIn, ringInverse(R, u), vMem, law⟩

theorem RingAssociated.trans (a b c : R)
  requires first : RingAssociated(R, a, b)
  requires second : RingAssociated(R, b, c)
  shows RingAssociated(R, a, c)
proof
  obtain ⟨aIn, bIn, u, uMem, bu⟩ := first
  obtain ⟨_, cIn, v, vMem, cv⟩ := second
  obtain ⟨uIn, uUnit⟩ := ringUnits.membership.forward at R, u with uMem
  obtain ⟨vIn, vUnit⟩ := ringUnits.membership.forward at R, v with vMem
  have uv := RingUnit.mul at R, u, v with comm, uUnit, vUnit
  have uvMem := ringUnits.mem_of_unit at R, u * v with comm, uv
  have law : c = a * (u * v)
    rw [cv, bu]
    ring
  exact ⟨aIn, cIn, u * v, uvMem, law⟩

theorem RingAssociated.dvd_dvd (a b : R)
  requires associated : RingAssociated(R, a, b)
  shows RingDvd(R, a, b) ∧ RingDvd(R, b, a)
proof
  have back := RingAssociated.symm at R, a, b with comm, associated
  obtain ⟨_, _, u, uMem, bu⟩ := associated
  obtain ⟨_, _, v, vMem, av⟩ := back
  obtain ⟨uIn, _⟩ := ringUnits.membership.forward at R, u with uMem
  obtain ⟨vIn, _⟩ := ringUnits.membership.forward at R, v with vMem
  have d1 := RingDvd.intro at R, a, b, u with comm, bu
  have d2 := RingDvd.intro at R, b, a, v with comm, av
  exact ⟨d1, d2⟩

theorem RingAssociated.unit_iff (a b : R)
  requires associated : RingAssociated(R, a, b)
  shows RingUnit(R, a) ↔ RingUnit(R, b)
proof
  obtain ⟨ab, ba⟩ := RingAssociated.dvd_dvd at R, a, b with comm, associated
  constructor
  . intro h
    exact RingUnit.of_dvd_unit at R, b, a with comm, ba, h
  . intro h
    exact RingUnit.of_dvd_unit at R, a, b with comm, ab, h

-- Coprimality: symmetric, IsCoprime.mul_right, coprime to a unit, and
-- coprimality is preserved by powers.
theorem RingCoprime.symm (a b : R)
  requires coprime : RingCoprime(R, a, b)
  shows RingCoprime(R, b, a)
proof
  obtain ⟨aIn, bIn, u, uIn, v, vIn, law⟩ := coprime
  have swap : v * b + u * a = R[1]
    rw ← law
    ring
  exact ⟨bIn, aIn, v, vIn, u, uIn, swap⟩

theorem RingCoprime.mul_right (a b c : R)
  requires first : RingCoprime(R, a, b)
  requires second : RingCoprime(R, a, c)
  shows RingCoprime(R, a, b * c)
proof
  obtain ⟨aIn, bIn, u, uIn, v, vIn, l1⟩ := first
  obtain ⟨_, cIn, s, sIn, t, tIn, l2⟩ := second
  have pIn : u * s * a + u * t * c + v * b * s ∈ R.carrier by typecheck
  have qIn : v * t ∈ R.carrier by typecheck
  have bcIn : b * c ∈ R.carrier by typecheck
  have law : (u * s * a + u * t * c + v * b * s) * a + (v * t) * (b * c) = R[1]
    have expand : (u * s * a + u * t * c + v * b * s) * a + (v * t) * (b * c) = (u * a + v * b) * (s * a + t * c) by ring
    rw [expand, l1, l2]
    ring
  exact ⟨aIn, bcIn, u * s * a + u * t * c + v * b * s, pIn, v * t, qIn, law⟩

theorem RingCoprime.of_unit (a u : R)
  requires unit : RingUnit(R, u)
  shows RingCoprime(R, a, u)
proof
  obtain ⟨_, w, wIn, uw, wu⟩ := unit
  have aIn : a ∈ R.carrier by typecheck
  have uIn : u ∈ R.carrier by typecheck
  have zeroIn : R[0] ∈ R.carrier by typecheck
  have law : R[0] * a + w * u = R[1]
    rw ← wu
    ring
  exact ⟨aIn, uIn, R[0], zeroIn, w, wIn, law⟩

theorem RingCoprime.pow_right (a b : R) (n : Nat)
  requires coprime : RingCoprime(R, a, b)
  shows RingCoprime(R, a, b ^ n)
proof
  have ringR := CommRing.to_ring with comm
  induction n
  | zero =>
    have z := Ring.pow_zero at R, b with ringR
    rw z
    have oneUnit := RingUnit.one at R with comm
    exact RingCoprime.of_unit at R, a, R[1] with comm, oneUnit
  | succ(k) using ih =>
    have shift := add.right_one at k with *
    rw ← shift
    have s := Ring.pow_succ at R, b, k with ringR
    rw s
    exact RingCoprime.mul_right at R, a, b ^ k, b with comm, ih, coprime

theorem RingCoprime.pow (a b : R) (m n : Nat)
  requires coprime : RingCoprime(R, a, b)
  shows RingCoprime(R, a ^ m, b ^ n)
proof
  have right := RingCoprime.pow_right at R, a, b, n with comm, coprime
  have flipped := RingCoprime.symm at R, a, b ^ n with comm, right
  have both := RingCoprime.pow_right at R, b ^ n, a, m with comm, flipped
  exact RingCoprime.symm at R, b ^ n, a ^ m with comm, both

-- IsCoprime.dvd_of_dvd_mul_left: a coprime to b and a ∣ b c give a ∣ c.
theorem RingCoprime.dvd_of_dvd_mul (a b c : R)
  requires coprime : RingCoprime(R, a, b)
  requires dvd : RingDvd(R, a, b * c)
  shows RingDvd(R, a, c)
proof
  obtain ⟨_, _, u, uIn, v, vIn, law⟩ := coprime
  have d1 := RingDvd.mul_self_right at R, a, c * u with comm
  have d2 := RingDvd.mul_right at R, a, b * c, v with comm, dvd
  have sum := RingDvd.add at R, a, a * (c * u), b * c * v with comm, d1, d2
  have same : a * (c * u) + b * c * v = c
    have expand : a * (c * u) + b * c * v = c * (u * a + v * b) by ring
    rw [expand, law]
    ring
  rw same at sum
  exact sum

-- IsCoprime.mul_dvd: coprime divisors of c have their product dividing c.
theorem RingCoprime.mul_dvd (a b c : R)
  requires coprime : RingCoprime(R, a, b)
  requires first : RingDvd(R, a, c)
  requires second : RingDvd(R, b, c)
  shows RingDvd(R, a * b, c)
proof
  obtain ⟨_, _, u, uIn, v, vIn, law⟩ := coprime
  obtain ⟨_, _, x, xIn, cx⟩ := first
  obtain ⟨_, _, y, yIn, cy⟩ := second
  have eq : c = (a * b) * (u * y + v * x)
    have one : c = c * (u * a + v * b)
      rw law
      ring
    have expand : c * (u * a + v * b) = u * a * c + v * b * c by ring
    rw [one, expand]
    have e1 : u * a * c = u * a * (b * y)
      rw ← cy
    have e2 : v * b * c = v * b * (a * x)
      rw ← cx
    rw [e1, e2]
    ring
  exact RingDvd.intro at R, a * b, c, u * y + v * x with comm, eq

-- Principal ideals: (a) is an ideal, it is the ideal generated by {a}
-- (Ideal.span {a}), membership is divisibility (Ideal.mem_span_singleton,
-- mem_span_singleton'), and the order of principal ideals is divisibility.
theorem ringMultiples.ideal (a : R)
  shows Ideal(R, ringMultiples(R, a))
proof
  have ringR := CommRing.to_ring with comm
  apply Ideal.mk at R, ringMultiples(R, a) with ringR
  . intros x hx
    obtain ⟨xIn, _⟩ := ringMultiples.membership.forward at R, a, x with hx
    exact xIn
  . have zeroIn : R[0] ∈ R.carrier by typecheck
    have law : R[0] = R[0] * a by ring
    exact ringMultiples.membership.backward at R, a, R[0] with ⟨zeroIn, R[0], zeroIn, law⟩
  . intros x hx y hy
    obtain ⟨xIn, c, cIn, xc⟩ := ringMultiples.membership.forward at R, a, x with hx
    obtain ⟨yIn, d, dIn, yd⟩ := ringMultiples.membership.forward at R, a, y with hy
    have sIn : x + y ∈ R.carrier by typecheck
    have wIn : c + d ∈ R.carrier by typecheck
    have law : x + y = (c + d) * a
      rw [xc, yd]
      ring
    exact ringMultiples.membership.backward at R, a, x + y with ⟨sIn, c + d, wIn, law⟩
  . intros x hx
    obtain ⟨xIn, c, cIn, xc⟩ := ringMultiples.membership.forward at R, a, x with hx
    have sIn : -x ∈ R.carrier by typecheck
    have wIn : -c ∈ R.carrier by typecheck
    have law : -x = (-c) * a
      rw xc
      ring
    exact ringMultiples.membership.backward at R, a, -x with ⟨sIn, -c, wIn, law⟩
  . intros r hr x hx
    obtain ⟨xIn, c, cIn, xc⟩ := ringMultiples.membership.forward at R, a, x with hx
    have s1 : r * x ∈ R.carrier by typecheck
    have s2 : x * r ∈ R.carrier by typecheck
    have w1 : r * c ∈ R.carrier by typecheck
    have l1 : r * x = (r * c) * a
      rw xc
      ring
    have l2 : x * r = (r * c) * a
      rw xc
      ring
    have m1 := ringMultiples.membership.backward at R, a, r * x with ⟨s1, r * c, w1, l1⟩
    have m2 := ringMultiples.membership.backward at R, a, x * r with ⟨s2, r * c, w1, l2⟩
    exact ⟨m1, m2⟩

theorem ringMultiples.mem_iff (a x : R)
  shows x ∈ ringMultiples(R, a) ↔ RingDvd(R, a, x)
proof
  constructor
  . intro h
    obtain ⟨xIn, c, cIn, xc⟩ := ringMultiples.membership.forward at R, a, x with h
    have law : x = a * c
      rw xc
      ring
    exact RingDvd.intro at R, a, x, c with comm, law
  . intro h
    obtain ⟨_, xIn, c, cIn, xc⟩ := h
    have law : x = c * a
      rw xc
      ring
    exact ringMultiples.membership.backward at R, a, x with ⟨xIn, c, cIn, law⟩

theorem ringMultiples.self_mem (a : R)
  shows a ∈ ringMultiples(R, a)
proof
  have d := RingDvd.refl at R, a with comm
  exact (ringMultiples.mem_iff at R, a, a with comm).backward with d

theorem ringMultiples.generated (a : R)
  shows generatedIdeal(R, {a}) = ringMultiples(R, a)
proof
  have ideal := ringMultiples.ideal at R, a with comm
  have aIn : a ∈ R.carrier by typecheck
  have self := ringMultiples.self_mem at R, a with comm
  have single := (singleton.subset_iff at a, ringMultiples(R, a)).backward with self
  have bounded := (singleton.subset_iff at a, R.carrier).backward with aIn
  have first := generatedIdeal.least at R, {a}, ringMultiples(R, a) with comm, ideal, single
  have gen := generatedIdeal.ideal at R, {a} with comm
  have contains := generatedIdeal.contains at R, {a} with comm, bounded
  have aGen := (singleton.subset_iff at a, generatedIdeal(R, {a})).forward with contains
  have second : ringMultiples(R, a) ⊆ generatedIdeal(R, {a})
    intros x hx
    obtain ⟨xIn, c, cIn, xc⟩ := ringMultiples.membership.forward at R, a, x with hx
    rw xc
    exact Ideal.mul_left_mem at R, generatedIdeal(R, {a}), c, a with gen, *
  exact Subset.antisymmetric with first, second

-- Ideal.span_singleton_le_span_singleton and Ideal.span_singleton_le_iff_mem.
theorem ringMultiples.subset_iff (a b : R)
  shows ringMultiples(R, a) ⊆ ringMultiples(R, b) ↔ RingDvd(R, b, a)
proof
  constructor
  . intro h
    have self := ringMultiples.self_mem at R, a with comm
    have aMem := h with self
    exact (ringMultiples.mem_iff at R, b, a with comm).forward with aMem
  . intro h
    intros x hx
    obtain ⟨xIn, _⟩ := ringMultiples.membership.forward at R, a, x with hx
    have xa := (ringMultiples.mem_iff at R, a, x with comm).forward with hx
    have xb := RingDvd.trans at R, b, a, x with comm, h, xa
    exact (ringMultiples.mem_iff at R, b, x with comm).backward with xb

theorem ringMultiples.subset_ideal_iff (a I : Set)
  requires member : a ∈ R.carrier
  requires ideal : Ideal(R, I)
  shows ringMultiples(R, a) ⊆ I ↔ a ∈ I
proof
  constructor
  . intro h
    have self := ringMultiples.self_mem at R, a with comm
    exact h with self
  . intro h
    intros x hx
    obtain ⟨xIn, c, cIn, xc⟩ := ringMultiples.membership.forward at R, a, x with hx
    rw xc
    exact Ideal.mul_left_mem at R, I, c, a with ideal, *

-- Ideal.eq_top_of_isUnit_mem: an ideal containing a unit is everything.
theorem Ideal.eq_whole_of_unit_mem (I u : Set)
  requires ideal : Ideal(R, I)
  requires member : u ∈ I
  requires unit : RingUnit(R, u)
  shows I = R.carrier
proof
  have ringR := CommRing.to_ring with comm
  obtain ⟨_, w, wIn, uw, wu⟩ := unit
  have oneIn : w * u ∈ I by exact Ideal.mul_left_mem at R, I, w, u with ideal, *
  rw wu at oneIn
  exact Ideal.contains_one at R, I with ringR, ideal, oneIn

-- Ideal.span_singleton_eq_top, span_singleton_eq_bot, span_singleton_one.
theorem ringMultiples.eq_whole_iff (a : R)
  shows ringMultiples(R, a) = R.carrier ↔ RingUnit(R, a)
proof
  constructor
  . intro h
    have one : R[1] ∈ R.carrier by typecheck
    rw ← h at one
    have d := (ringMultiples.mem_iff at R, a, R[1] with comm).forward with one
    exact (RingUnit.iff_dvd_one at R, a with comm).backward with d
  . intro h
    have ideal := ringMultiples.ideal at R, a with comm
    have self := ringMultiples.self_mem at R, a with comm
    exact Ideal.eq_whole_of_unit_mem at R, ringMultiples(R, a), a with comm, ideal, self, h

theorem ringMultiples.eq_zero_iff (a : R)
  shows ringMultiples(R, a) = {R[0]} ↔ a = R[0]
proof
  constructor
  . intro h
    have self := ringMultiples.self_mem at R, a with comm
    rw h at self
    exact singleton.membership.forward with self
  . intro h
    have ideal := ringMultiples.ideal at R, a with comm
    have zeroIn := Ideal.zero_mem at R, ringMultiples(R, a) with ideal
    have first : ringMultiples(R, a) ⊆ {R[0]}
      intros x hx
      obtain ⟨xIn, c, cIn, xc⟩ := ringMultiples.membership.forward at R, a, x with hx
      apply singleton.membership.backward
      rw [xc, h]
      ring
    have second := (singleton.subset_iff at R[0], ringMultiples(R, a)).backward with zeroIn
    exact Subset.antisymmetric with first, second

-- Ideal.span_singleton_mul_right_unit.
theorem ringMultiples.mul_unit (a u : R)
  requires unit : RingUnit(R, u)
  shows ringMultiples(R, a * u) = ringMultiples(R, a)
proof
  obtain ⟨vUnit, right⟩ := ringInverse.unit at R, u with comm, unit
  have vIn := ringInverse.mem at R, u with *
  have d1 := RingDvd.mul_self_right at R, a, u with comm
  have law : a = (a * u) * ringInverse(R, u)
    have regroup : (a * u) * ringInverse(R, u) = a * (u * ringInverse(R, u)) by ring
    rw [regroup, right]
    ring
  have d2 := RingDvd.intro at R, a * u, a, ringInverse(R, u) with comm, law
  have s1 := (ringMultiples.subset_iff at R, a * u, a with comm).backward with d1
  have s2 := (ringMultiples.subset_iff at R, a, a * u with comm).backward with d2
  exact Subset.antisymmetric with s1, s2

-- Ideal.mem_of_dvd.
theorem Ideal.mem_of_dvd (I a b : Set)
  requires ideal : Ideal(R, I)
  requires dvd : RingDvd(R, a, b)
  requires member : a ∈ I
  shows b ∈ I
proof
  obtain ⟨_, _, c, cIn, bc⟩ := dvd
  rw bc
  exact Ideal.mul_right_mem at R, I, c, a with ideal, *

-- Ideal.unit_mul_mem_iff_mem.
theorem Ideal.unit_mul_mem_iff (I u x : Set)
  requires ideal : Ideal(R, I)
  requires unit : RingUnit(R, u)
  requires element : x ∈ R.carrier
  shows call2(R.mul, u, x) ∈ I ↔ x ∈ I
proof
  have uIn : u ∈ R.carrier by exact unit.left
  constructor
  . intro h
    obtain ⟨vUnit, right⟩ := ringInverse.unit at R, u with comm, unit
    have vIn := ringInverse.mem at R, u with *
    have left := ringInverse.mul_left at R, u with *
    have m := Ideal.mul_left_mem at R, I, ringInverse(R, u), call2(R.mul, u, x) with ideal, *
    have same : ringInverse(R, u) * (u * x) = x
      have regroup : ringInverse(R, u) * (u * x) = (ringInverse(R, u) * u) * x by ring
      rw [regroup, left]
      ring
    rw same at m
    exact m
  . intro h
    exact Ideal.mul_left_mem at R, I, u, x with ideal, *

-- Ideal.IsPrime.notMem_of_isCoprime_of_mem: a prime ideal containing a
-- does not contain an element coprime to a.
theorem PrimeIdeal.not_mem_of_coprime (P a b : Set)
  requires prime : PrimeIdeal(R, P)
  requires coprime : RingCoprime(R, a, b)
  requires member : a ∈ P
  shows b ∉ P
proof
  have ringR := CommRing.to_ring with comm
  intro bIn
  obtain ⟨_, _, u, uIn, v, vIn, law⟩ := coprime
  have ideal := PrimeIdeal.to_ideal at R, P with prime
  have m1 := Ideal.mul_left_mem at R, P, u, a with ideal, *
  have m2 := Ideal.mul_left_mem at R, P, v, b with ideal, *
  have sum := Ideal.add_mem at R, P, call2(R.mul, u, a), call2(R.mul, v, b) with ideal, m1, m2
  rw law at sum
  have proper := PrimeIdeal.to_proper at R, P with prime
  have out := ProperIdeal.one_not_mem at R, P with proper
  exact out with sum

-- A prime ideal contains a power only if it contains the base
-- (Ideal.IsPrime.mem_of_pow_mem).
theorem PrimeIdeal.mem_of_pow_mem (P a : Set) (n : Nat)
  requires prime : PrimeIdeal(R, P)
  requires element : a ∈ R.carrier
  requires member : Ring.pow(R, a, n) ∈ P
  requires positive : 0 < n
  shows a ∈ P
proof
  have ringR := CommRing.to_ring with comm
  have ideal := PrimeIdeal.to_ideal at R, P with prime
  have proper := PrimeIdeal.to_proper at R, P with prime
  induction n
  | zero =>
    intros member2 positive2
    exfalso
    arith
  | succ(k) using ih =>
    intros member2 positive2
    have shift := add.right_one at k with *
    rw ← shift at member2
    have s := Ring.pow_succ at R, a, k with ringR
    rw s at member2
    have pIn : a ^ k ∈ R.carrier by typecheck
    rcases PrimeIdeal.mem_or_mem at R, P, a ^ k, a with ringR, prime, pIn, element, member2 with left | right
    . rcases natural.zero_or_successor at k with zero | ⟨j, jNat, kj⟩
      . rw zero at left
        have z := Ring.pow_zero at R, a with ringR
        rw z at left
        exfalso
        exact (ProperIdeal.one_not_mem at R, P with proper) with left
      . have kPos : 0 < k by arith
        exact ih with left, kPos
    . exact right

-- A proper ideal contains no unit (Ideal.IsPrime.ne_top, one_notMem).
theorem ProperIdeal.not_mem_unit (I u : Set)
  requires proper : ProperIdeal(R, I)
  requires unit : RingUnit(R, u)
  shows u ∉ I
proof
  intro uIn
  have ideal := ProperIdeal.to_ideal at R, I with proper
  have whole := Ideal.eq_whole_of_unit_mem at R, I, u with comm, ideal, uIn, unit
  have one : R[1] ∈ R.carrier by typecheck
  rw ← whole at one
  have out := ProperIdeal.one_not_mem at R, I with proper
  exact out with one

-- Coprime elements generate the whole ring together
-- (Ideal.isCoprime_span_singleton_iff, read on generators).
theorem RingCoprime.iff_generate (a b : R)
  shows RingCoprime(R, a, b) ↔ generatedIdeal(R, {a, b}) = R.carrier
proof
  have aIn : a ∈ R.carrier by assumption
  have bIn : b ∈ R.carrier by assumption
  have gen := generatedIdeal.ideal at R, {a, b} with comm
  have bounded : {a, b} ⊆ R.carrier
    intros y hy
    rcases pair.membership.forward with hy with ya | yb
    . rw ya
      exact aIn
    . rw yb
      exact bIn
  have contains := generatedIdeal.contains at R, {a, b} with comm, bounded
  constructor
  . intro h
    obtain ⟨_, _, u, uIn, v, vIn, law⟩ := h
    have aG := contains with (pair.left at a, b)
    have bG := contains with (pair.right at a, b)
    have m1 := Ideal.mul_left_mem at R, generatedIdeal(R, {a, b}), u, a with gen, *
    have m2 := Ideal.mul_left_mem at R, generatedIdeal(R, {a, b}), v, b with gen, *
    have sum := Ideal.add_mem at R, generatedIdeal(R, {a, b}), call2(R.mul, u, a), call2(R.mul, v, b) with gen, m1, m2
    rw law at sum
    exact (generatedIdeal.unit_iff at R, {a, b} with comm).forward with sum
  . intro h
    have one : R[1] ∈ R.carrier by typecheck
    rw ← h at one
    have sub := ringPairCombos.generated at R, a, b with comm
    have oneC := sub with one
    obtain ⟨_, u, uIn, v, vIn, law⟩ := ringPairCombos.membership.forward at R, a, b, R[1] with oneC
    have law2 : u * a + v * b = R[1] by rw law
    exact ⟨aIn, bIn, u, uIn, v, vIn, law2⟩

-- An element lies in no maximal ideal exactly when it is a unit; this
-- uses the existence of maximal ideals, so Choice.
theorem RingUnit.iff_not_mem_maximal (a : R)
  shows RingUnit(R, a) ↔ (∀ M, MaximalIdeal(R, M) → a ∉ M)
proof
  have aIn : a ∈ R.carrier by assumption
  constructor
  . intro unit
    intros M maxM
    have proper := MaximalIdeal.to_proper at R, M with maxM
    exact ProperIdeal.not_mem_unit at R, M, a with comm, proper, unit
  . intro none
    by_contra notUnit
    have ideal := ringMultiples.ideal at R, a with comm
    have oneOut : R[1] ∉ ringMultiples(R, a)
      intro oneIn
      have whole := Ideal.contains_one at R, ringMultiples(R, a) with ideal, oneIn
      have u := (ringMultiples.eq_whole_iff at R, a with comm).forward with whole
      exact notUnit with u
    have gen := ringMultiples.generated at R, a with comm
    rw ← gen at oneOut
    have bounded := (singleton.subset_iff at a, R.carrier).backward with aIn
    obtain ⟨M, maxM, sub⟩ := generatedIdeal.exists_maximal at R, {a} with comm, bounded, oneOut
    have aM := (singleton.subset_iff at a, M).forward with sub
    exact (none with M, maxM) with aM

end DivisibilityLaws

-- Section: Domains, fields, and factorization
section Domains
variable (R : Set)
hypothesis domain : IntegralDomain(R)

theorem IntegralDomain.comm_ring
  shows CommRing(R)
proof
  exact domain.left

theorem IntegralDomain.nontrivial
  shows R.zero ≠ R.one
proof
  obtain ⟨_, nt, _⟩ := domain
  exact nt

-- The bundled and the Cumulus forms agree.
theorem IntegralDomain.parts
  shows IsIntegralDomain(R.carrier, R.add, R.zero, R.neg, R.mul, R.one)
proof
  obtain ⟨comm, nt, nzd⟩ := domain
  have parts := CommRing.parts with comm
  have ringR := CommRing.to_ring with comm
  have zeroIn : R.zero ∈ R.carrier by typecheck
  have oneIn : R.one ∈ R.carrier by typecheck
  unfold IsIntegralDomain
  unfold Nontrivial
  unfold NoZeroDivisors
  exact ⟨parts, ⟨zeroIn, oneIn, nt⟩, nzd⟩

-- mul_eq_zero, mul_ne_zero, mul_left_cancel₀.
theorem IntegralDomain.mul_eq_zero (a b : Set)
  requires first : a ∈ R.carrier
  requires second : b ∈ R.carrier
  shows call2(R.mul, a, b) = R.zero ↔ a = R.zero ∨ b = R.zero
proof
  obtain ⟨comm, nt, nzd⟩ := domain
  constructor
  . intro h
    exact nzd with a, first, b, second, h
  . intro h
    cases h with za | zb
    . rw za
      have law : R.zero * b = R.zero by ring
      exact law
    . rw zb
      have law : a * R.zero = R.zero by ring
      exact law

theorem IntegralDomain.mul_cancel (a b c : Set)
  requires first : a ∈ R.carrier
  requires second : b ∈ R.carrier
  requires third : c ∈ R.carrier
  requires nonzero : a ≠ R.zero
  requires equal : call2(R.mul, a, b) = call2(R.mul, a, c)
  shows b = c
proof
  obtain ⟨comm, nt, nzd⟩ := domain
  have dIn : b - c ∈ R.carrier by typecheck
  have prod : a * (b - c) = R.zero
    have expand : a * (b - c) = a * b - a * c by ring
    rw [expand, equal]
    ring
  rcases nzd with a, first, b - c, dIn, prod with za | zd
  . exfalso
    exact nonzero with za
  . have back : b = (b - c) + c by ring
    rw [back, zd]
    ring

theorem IntegralDomain.pow_eq_zero (x : Set) (n : Nat)
  requires element : x ∈ R.carrier
  requires power : Ring.pow(R, x, n) = R.zero
  shows x = R.zero
proof
  obtain ⟨comm, nt, nzd⟩ := domain
  have ringR := CommRing.to_ring with comm
  induction n
  | zero =>
    intro p0
    have z := Ring.pow_zero at R, x with ringR
    rw z at p0
    exfalso
    have e : R.zero = R.one by rw p0
    exact nt with e
  | succ(k) using ih =>
    intro p1
    have shift := add.right_one at k with *
    rw ← shift at p1
    have s := Ring.pow_succ at R, x, k with ringR
    rw s at p1
    have pIn : x ^ k ∈ R.carrier by typecheck
    rcases (IntegralDomain.mul_eq_zero at R, x ^ k, x with domain, pIn, element).forward with p1 with left | right
    . exact ih with left
    . exact right

-- pow_eq_zero_iff: a domain is reduced.
theorem IntegralDomain.reduced
  shows ReducedRing(R)
proof
  have comm := IntegralDomain.comm_ring at R with domain
  have law : ∀ x ∈ R.carrier, RingNilpotent(R, x) → x = R.zero
    intros x xIn nil
    obtain ⟨_, n, nIn, xn⟩ := nil
    have nNat : Nat(n) by typecheck
    exact IntegralDomain.pow_eq_zero at R, x, n with domain, xIn, xn
  exact ⟨comm, law⟩

-- nonZeroDivisors of a domain are the nonzero elements
-- (mem_nonZeroDivisors_iff_ne_zero).
theorem IntegralDomain.non_zero_divisors
  shows nonZeroDivisors(R) = R.carrier ∖ {R.zero}
proof
  obtain ⟨comm, nt, nzd⟩ := domain
  have first : nonZeroDivisors(R) ⊆ R.carrier ∖ {R.zero}
    intros x hx
    obtain ⟨xIn, kills⟩ := nonZeroDivisors.membership.forward at R, x with hx
    apply (difference.singleton_membership at x, R.carrier, R.zero).backward
    refine ⟨xIn, ?_⟩
    intro xz
    have oneIn : R.one ∈ R.carrier by typecheck
    have prod : R.one * x = R.zero
      rw xz
      ring
    have bad := kills with R.one, oneIn, prod
    have e : R.zero = R.one by rw bad
    exact nt with e
  have second : R.carrier ∖ {R.zero} ⊆ nonZeroDivisors(R)
    intros x hx
    obtain ⟨xIn, xnz⟩ := (difference.singleton_membership at x, R.carrier, R.zero).forward with hx
    apply nonZeroDivisors.membership.backward at R, x
    refine ⟨xIn, ?_⟩
    intros y yIn prod
    rcases nzd with y, yIn, x, xIn, prod with yz | xz
    . exact yz
    . exfalso
      exact xnz with xz
  exact Subset.antisymmetric with first, second

-- The zero ideal is prime (Ideal.isPrime_bot); a quotient by a prime
-- ideal is a domain and conversely (Ideal.Quotient.isDomain_iff_prime).
theorem IntegralDomain.zero_prime
  shows PrimeIdeal(R, {R.zero})
proof
  have parts := IntegralDomain.parts at R with domain
  have prime := IsIntegralDomain.zero_prime with parts
  exact PrimeIdeal.of_projections with prime

-- Associated elements of a domain are the mutual divisors
-- (associated_of_dvd_dvd); principal ideals agree exactly for associates
-- (Ideal.span_singleton_eq_span_singleton).
theorem IntegralDomain.associated_iff (a b : Set)
  requires first : a ∈ R.carrier
  requires second : b ∈ R.carrier
  shows RingAssociated(R, a, b) ↔ RingDvd(R, a, b) ∧ RingDvd(R, b, a)
proof
  have comm := IntegralDomain.comm_ring at R with domain
  constructor
  . intro h
    exact RingAssociated.dvd_dvd at R, a, b with comm, h
  . intro h
    obtain ⟨ab, ba⟩ := h
    obtain ⟨_, _, x, xIn, bx⟩ := ab
    obtain ⟨_, _, y, yIn, ay⟩ := ba
    by_cases az : a = R.zero
    . have bz : b = R.zero
        rw [bx, az]
        ring
      rw [az, bz]
      exact RingAssociated.refl at R, R.zero with comm
    . have eq : a * (x * y) = a * R.one
        have l : a * (x * y) = (a * x) * y by ring
        rw [l, ← bx, ← ay]
        ring
      have oneIn : R.one ∈ R.carrier by typecheck
      have xyIn : x * y ∈ R.carrier by typecheck
      have xy := IntegralDomain.mul_cancel at R, a, x * y, R.one with domain, first, xyIn, oneIn, az, eq
      have xUnit := RingUnit.of_product at R, x, y with comm, xIn, yIn, xy
      have xMem := ringUnits.mem_of_unit at R, x with comm, xUnit
      exact ⟨first, second, x, xMem, bx⟩

theorem IntegralDomain.multiples_eq_iff (a b : Set)
  requires first : a ∈ R.carrier
  requires second : b ∈ R.carrier
  shows ringMultiples(R, a) = ringMultiples(R, b) ↔ RingAssociated(R, a, b)
proof
  have comm := IntegralDomain.comm_ring at R with domain
  have assoc := IntegralDomain.associated_iff at R, a, b with domain, first, second
  constructor
  . intro h
    have s1 : ringMultiples(R, a) ⊆ ringMultiples(R, b)
      rw h
      exact Subset.reflexive at ringMultiples(R, b)
    have s2 : ringMultiples(R, b) ⊆ ringMultiples(R, a)
      rw h
      exact Subset.reflexive at ringMultiples(R, b)
    have d1 := (ringMultiples.subset_iff at R, a, b with comm).forward with s1
    have d2 := (ringMultiples.subset_iff at R, b, a with comm).forward with s2
    exact assoc.backward with ⟨d2, d1⟩
  . intro h
    obtain ⟨ab, ba⟩ := assoc.forward with h
    have s1 := (ringMultiples.subset_iff at R, a, b with comm).backward with ba
    have s2 := (ringMultiples.subset_iff at R, b, a with comm).backward with ab
    exact Subset.antisymmetric with s1, s2

-- Prime.irreducible: in a domain primes are irreducible.
theorem RingPrime.irreducible (p : Set)
  requires prime : RingPrime(R, p)
  shows RingIrreducible(R, p)
proof
  have comm := IntegralDomain.comm_ring at R with domain
  have prime0 := prime
  obtain ⟨pIn, pnz, pnu, dvds⟩ := prime0
  refine ⟨pIn, pnu, ?_⟩
  intros a aIn b bIn split
  have oneIn0 : R.one ∈ R.carrier by typecheck
  have abIn : a * b ∈ R.carrier by typecheck
  have law0 : a * b = p * R.one
    rw split
    ring
  have selfDvd := RingDvd.intro at R, p, a * b, R.one with comm, law0
  rcases dvds with a, aIn, b, bIn, selfDvd with da | db
  . obtain ⟨_, _, c, cIn, ac⟩ := da
    have eq : p * (c * b) = p * R.one
      have l : p * (c * b) = (p * c) * b by ring
      rw [l, ← ac, ← split]
      ring
    have oneIn : R.one ∈ R.carrier by typecheck
    have cbIn : c * b ∈ R.carrier by typecheck
    have cb := IntegralDomain.mul_cancel at R, p, c * b, R.one with domain, pIn, cbIn, oneIn, pnz, eq
    have law : b * c = R.one
      rw ← cb
      ring
    right
    exact RingUnit.of_product at R, b, c with comm, bIn, cIn, law
  . obtain ⟨_, _, c, cIn, bc⟩ := db
    have eq : p * (c * a) = p * R.one
      have l : p * (c * a) = a * (p * c) by ring
      rw [l, ← bc, ← split]
      ring
    have oneIn : R.one ∈ R.carrier by typecheck
    have caIn : c * a ∈ R.carrier by typecheck
    have ca := IntegralDomain.mul_cancel at R, p, c * a, R.one with domain, pIn, caIn, oneIn, pnz, eq
    have law : a * c = R.one
      rw ← ca
      ring
    left
    exact RingUnit.of_product at R, a, c with comm, aIn, cIn, law

-- Irreducible.ne_zero.
theorem RingIrreducible.ne_zero (p : Set)
  requires irreducible : RingIrreducible(R, p)
  shows p ≠ R.zero
proof
  have comm := IntegralDomain.comm_ring at R with domain
  intro pz
  obtain ⟨pIn, pnu, factors⟩ := irreducible
  have zeroIn : R.zero ∈ R.carrier by typecheck
  have split : p = R.zero * R.zero
    rw pz
    ring
  rcases factors with R.zero, zeroIn, R.zero, zeroIn, split with u | u
  . rw ← pz at u
    exact pnu with u
  . rw ← pz at u
    exact pnu with u

-- Ideal.span_singleton_prime: a nonzero p is prime exactly when (p) is a
-- prime ideal.
theorem RingPrime.iff_multiples_prime (p : Set)
  requires member : p ∈ R.carrier
  requires nonzero : p ≠ R.zero
  shows RingPrime(R, p) ↔ PrimeIdeal(R, ringMultiples(R, p))
proof
  have comm := IntegralDomain.comm_ring at R with domain
  have ringR := CommRing.to_ring with comm
  have ideal := ringMultiples.ideal at R, p with comm
  constructor
  . intro h
    have h0 := h
    obtain ⟨_, _, pnu, dvds⟩ := h0
    have oneOut : R.one ∉ ringMultiples(R, p)
      intro oneIn
      have d := (ringMultiples.mem_iff at R, p, R.one with comm).forward with oneIn
      have u := (RingUnit.iff_dvd_one at R, p with comm).backward with d
      exact pnu with u
    have proper := ProperIdeal.mk at R, ringMultiples(R, p) with ringR, ideal, oneOut
    have law : ∀ x y ∈ R.carrier, x * y ∈ ringMultiples(R, p) → x ∈ ringMultiples(R, p) ∨ y ∈ ringMultiples(R, p)
      intros x xIn y yIn xy
      have d := (ringMultiples.mem_iff at R, p, x * y with comm).forward with xy
      rcases dvds with x, xIn, y, yIn, d with dx | dy
      . left
        exact (ringMultiples.mem_iff at R, p, x with comm).backward with dx
      . right
        exact (ringMultiples.mem_iff at R, p, y with comm).backward with dy
    exact ⟨proper, law⟩
  . intro h
    obtain ⟨proper, law⟩ := h
    have pnu : ¬RingUnit(R, p)
      intro u
      have whole := (ringMultiples.eq_whole_iff at R, p with comm).backward with u
      have oneIn : R.one ∈ R.carrier by typecheck
      rw ← whole at oneIn
      exact (ProperIdeal.one_not_mem at R, ringMultiples(R, p) with proper) with oneIn
    have dvds : ∀ a b ∈ R.carrier, RingDvd(R, p, a * b) → RingDvd(R, p, a) ∨ RingDvd(R, p, b)
      intros a aIn b bIn d
      have m := (ringMultiples.mem_iff at R, p, a * b with comm).backward with d
      rcases law with a, aIn, b, bIn, m with ma | mb
      . left
        exact (ringMultiples.mem_iff at R, p, a with comm).forward with ma
      . right
        exact (ringMultiples.mem_iff at R, p, b with comm).forward with mb
    exact ⟨member, nonzero, pnu, dvds⟩

-- Prime.dvd_of_dvd_pow.
theorem RingPrime.dvd_of_dvd_pow (p a : Set) (n : Nat)
  requires prime : RingPrime(R, p)
  requires element : a ∈ R.carrier
  requires dvd : RingDvd(R, p, Ring.pow(R, a, n))
  shows RingDvd(R, p, a)
proof
  have comm := IntegralDomain.comm_ring at R with domain
  have ringR := CommRing.to_ring with comm
  have prime0 := prime
  obtain ⟨pIn, pnz, pnu, _⟩ := prime0
  rcases natural.zero_or_successor at n with zero | ⟨j, jNat, nj⟩
  . rw zero at dvd
    have z := Ring.pow_zero at R, a with ringR
    rw z at dvd
    have u := (RingUnit.iff_dvd_one at R, p with comm).backward with dvd
    exfalso
    exact pnu with u
  . have pIdeal := (RingPrime.iff_multiples_prime at R, p with domain, pIn, pnz).forward with prime
    have m := (ringMultiples.mem_iff at R, p, Ring.pow(R, a, n) with comm).backward with dvd
    have pos : 0 < n by arith
    have ma := PrimeIdeal.mem_of_pow_mem at R, ringMultiples(R, p), a, n with comm, pIdeal, element, m, pos
    exact (ringMultiples.mem_iff at R, p, a with comm).forward with ma

theorem RingPrime.dvd_pow_aux (p : Set) (n : Nat)
  requires prime : RingPrime(R, p)
  shows ∀ a ∈ R.carrier, RingDvd(R, a, Ring.pow(R, p, n)) →
    (∃ i ∈ succ(n), RingAssociated(R, a, Ring.pow(R, p, i)))
proof
  have comm := IntegralDomain.comm_ring at R with domain
  have ringR := CommRing.to_ring with comm
  have prime0 := prime
  obtain ⟨pIn, pnz, pnu, dvds⟩ := prime0
  induction n
  | zero =>
    intros a aIn h
    have z := Ring.pow_zero at R, p with ringR
    rw z at h
    have aUnit := (RingUnit.iff_dvd_one at R, a with comm).backward with h
    obtain ⟨vUnit, right⟩ := ringInverse.unit at R, a with comm, aUnit
    have vMem := ringUnits.mem_of_unit at R, ringInverse(R, a) with comm, vUnit
    have law : Ring.pow(R, p, 0) = a * ringInverse(R, a)
      rw [z, right]
    have zle : 0 ≤ 0 by arith
    have zIn := membership.successor_of_LessEqual at 0, 0 with zle
    exact ⟨0, zIn, aIn, (Ring.pow_mem at R, p, 0 with ringR), ringInverse(R, a), vMem, law⟩
  | succ(k) using ih =>
    intros a aIn h
    have shift := add.right_one at k with *
    rw ← shift at h
    rw ← shift
    have s := Ring.pow_succ at R, p, k with ringR
    have pkIn : p ^ k ∈ R.carrier by typecheck
    obtain ⟨_, _, c, cIn, ac⟩ := h
    rw s at ac
    by_cases pa : RingDvd(R, p, a)
    . obtain ⟨_, _, a2, a2In, aa⟩ := pa
      have eq : p * (a2 * c) = p * p ^ k
        have l : p * (a2 * c) = (p * a2) * c by ring
        rw [l, ← aa, ← ac]
        ring
      have a2cIn : a2 * c ∈ R.carrier by typecheck
      have can := IntegralDomain.mul_cancel at R, p, a2 * c, p ^ k with domain, pIn, a2cIn, pkIn, pnz, eq
      have law : p ^ k = a2 * c by rw can
      have d := RingDvd.intro at R, a2, p ^ k, c with comm, law
      obtain ⟨i, iIn, assoc⟩ := ih with a2, a2In, d
      have iNat := natural.member at succ(k) with iIn
      obtain ⟨_, _, u, uMem, pu⟩ := assoc
      obtain ⟨uIn, _⟩ := ringUnits.membership.forward at R, u with uMem
      have law2 : Ring.pow(R, p, i + 1) = a * u
        have si := Ring.pow_succ at R, p, i with ringR
        rw [si, pu, aa]
        ring
      have ile := LessEqual.of_membership_successor at i, k with iIn
      have ile2 : i + 1 ≤ k + 1 by arith
      have iIn2 := membership.successor_of_LessEqual at i + 1, k + 1 with ile2
      have piIn : p ^ (i + 1) ∈ R.carrier by typecheck
      exact ⟨i + 1, iIn2, aIn, piIn, u, uMem, law2⟩
    . have pac : RingDvd(R, p, a * c)
        have law : a * c = p * p ^ k
          rw ← ac
          ring
        exact RingDvd.intro at R, p, a * c, p ^ k with comm, law
      have prime1 := prime
      obtain ⟨_, _, _, dvds⟩ := prime1
      rcases dvds with a, aIn, c, cIn, pac with pa2 | pc
      . exfalso
        exact pa with pa2
      . obtain ⟨_, _, c2, c2In, cc⟩ := pc
        have eq : p * (a * c2) = p * p ^ k
          have l : p * (a * c2) = a * (p * c2) by ring
          rw [l, ← cc, ← ac]
          ring
        have ac2In : a * c2 ∈ R.carrier by typecheck
        have can := IntegralDomain.mul_cancel at R, p, a * c2, p ^ k with domain, pIn, ac2In, pkIn, pnz, eq
        have law : p ^ k = a * c2 by rw can
        have d := RingDvd.intro at R, a, p ^ k, c2 with comm, law
        obtain ⟨i, iIn, assoc⟩ := ih with a, aIn, d
        have iNat := natural.member at succ(k) with iIn
        have ile := LessEqual.of_membership_successor at i, k with iIn
        have ile2 : i ≤ k + 1 by arith
        have iIn2 := membership.successor_of_LessEqual at i, k + 1 with ile2
        exact ⟨i, iIn2, assoc⟩

-- dvd_prime_pow: the divisors of pⁿ are the associates of pⁱ, i ≤ n.
theorem RingPrime.dvd_pow_iff (p a : Set) (n : Nat)
  requires prime : RingPrime(R, p)
  requires element : a ∈ R.carrier
  shows RingDvd(R, a, Ring.pow(R, p, n)) ↔
    (∃ i ∈ succ(n), RingAssociated(R, a, Ring.pow(R, p, i)))
proof
  have comm := IntegralDomain.comm_ring at R with domain
  have ringR := CommRing.to_ring with comm
  have pIn : p ∈ R.carrier by exact prime.left
  constructor
  . intro h
    exact RingPrime.dvd_pow_aux at R, p, n with domain, prime, a, element, h
  . intro h
    obtain ⟨i, iIn, assoc⟩ := h
    have iNat := natural.member at succ(n) with iIn
    have ile := LessEqual.of_membership_successor at i, n with iIn
    obtain ⟨d1, _⟩ := RingAssociated.dvd_dvd at R, a, Ring.pow(R, p, i) with comm, assoc
    have d2 := RingDvd.pow_pow at R, p, i, n with comm, ile
    exact RingDvd.trans at R, a, Ring.pow(R, p, i), Ring.pow(R, p, n) with comm, d1, d2

-- pow_dvd_pow_iff for a nonzero nonunit.
theorem IntegralDomain.pow_dvd_pow_iff (a : Set) (m n : Nat)
  requires element : a ∈ R.carrier
  requires nonzero : a ≠ R.zero
  requires notUnit : ¬RingUnit(R, a)
  shows RingDvd(R, Ring.pow(R, a, m), Ring.pow(R, a, n)) ↔ m ≤ n
proof
  have comm := IntegralDomain.comm_ring at R with domain
  have ringR := CommRing.to_ring with comm
  constructor
  . intro h
    by_contra notLe
    have lt : n < m by arith
    obtain ⟨k, kNat, mk⟩ := Less.exists_add_one at n, m with lt
    have split : Ring.pow(R, a, m) = Ring.pow(R, a, n) * Ring.pow(R, a, k + 1)
      rw mk
      have assoc : n + k + 1 = n + (k + 1) by arith
      rw assoc
      exact Ring.pow_add at R, a, n, k + 1 with ringR
    obtain ⟨_, _, x, xIn, nx⟩ := h
    have anIn : a ^ n ∈ R.carrier by typecheck
    have oneIn : R.one ∈ R.carrier by typecheck
    have rest : a ^ (k + 1) * x ∈ R.carrier by typecheck
    have anz : a ^ n ≠ R.zero
      intro z
      have az := IntegralDomain.pow_eq_zero at R, a, n with domain, element, z
      exact nonzero with az
    have eq : a ^ n * (a ^ (k + 1) * x) = a ^ n * R.one
      have l : a ^ n * (a ^ (k + 1) * x) = (a ^ n * a ^ (k + 1)) * x by ring
      rw [l, ← split, ← nx]
      ring
    have can := IntegralDomain.mul_cancel at R, a ^ n, a ^ (k + 1) * x, R.one with domain, anIn, rest, oneIn, anz, eq
    have akIn : a ^ (k + 1) ∈ R.carrier by typecheck
    have u := RingUnit.of_product at R, a ^ (k + 1), x with comm, akIn, xIn, can
    have pos : 0 < k + 1 by arith
    have d := RingDvd.pow_self at R, a, k + 1 with comm, pos
    have ua := RingUnit.of_dvd_unit at R, a, a ^ (k + 1) with comm, d, u
    exact notUnit with ua
  . intro h
    exact RingDvd.pow_pow at R, a, m, n with comm, h

end Domains

-- A field is a domain in which every nonzero element is a unit
-- (Field.toIsField, IsField.isDomain, isUnit_iff_ne_zero); its only
-- ideals are 0 and the whole field, and conversely.
theorem Field.domain (K : Set)
  requires field : Field(K)
  shows IntegralDomain(K)
proof
  have comm := Field.to_comm_ring at K with field
  have parts := Field.parts at K with field
  have dom := IsField.integral_domain with parts
  obtain ⟨_, ⟨_, _, nt⟩, nzd⟩ := dom
  exact ⟨comm, nt, nzd⟩

theorem Field.unit_iff (K a : Set)
  requires field : Field(K)
  requires member : a ∈ Ring.carrier(K)
  shows RingUnit(K, a) ↔ a ≠ Ring.zero(K)
proof
  have comm := Field.to_comm_ring at K with field
  have dom := Field.domain at K with field
  have nt := IntegralDomain.nontrivial at K with dom
  constructor
  . intro u
    exact RingUnit.ne_zero at K, a with comm, nt, u
  . intro nz
    have parts := Field.parts at K with field
    obtain ⟨y, inv⟩ := IsField.inverse_exists with parts, member, nz
    obtain ⟨_, yIn, ya, ay⟩ := inv
    exact ⟨member, y, yIn, ay, ya⟩

theorem Field.ideals (K I : Set)
  requires field : Field(K)
  requires ideal : Ideal(K, I)
  shows I = {Ring.zero(K)} ∨ I = Ring.carrier(K)
proof
  have comm := Field.to_comm_ring at K with field
  have ringK := CommRing.to_ring with comm
  by_cases some : ∃ x ∈ I, x ≠ Ring.zero(K)
  . right
    obtain ⟨x, xI, xnz⟩ := some
    have sub := Ideal.subset at K, I with ideal
    have xIn := sub with xI
    have u := (Field.unit_iff at K, x with field, xIn).backward with xnz
    exact Ideal.eq_whole_of_unit_mem at K, I, x with comm, ideal, xI, u
  . left
    have zeroIn := Ideal.zero_mem at K, I with ideal
    have first : I ⊆ {Ring.zero(K)}
      intros y hy
      apply singleton.membership.backward
      by_contra ynz
      exact some with ⟨y, hy, ynz⟩
    have second := (singleton.subset_iff at Ring.zero(K), I).backward with zeroIn
    exact Subset.antisymmetric with first, second

theorem Field.of_ideals (K : Set)
  requires comm : CommRing(K)
  requires nontrivial : Ring.zero(K) ≠ Ring.one(K)
  requires ideals : ∀ I, Ideal(K, I) → I = {Ring.zero(K)} ∨ I = Ring.carrier(K)
  shows Field(K)
proof
  have ringK := CommRing.to_ring with comm
  have parts := CommRing.parts at K with comm
  have zeroIn : Ring.zero(K) ∈ Ring.carrier(K) by typecheck
  have oneIn : Ring.one(K) ∈ Ring.carrier(K) by typecheck
  have inverses : ∀ x ∈ Ring.carrier(K), x ≠ Ring.zero(K) → ∃ y, IsInverse(Ring.carrier(K), Ring.mul(K), Ring.one(K), x, y)
    intros x xIn xnz
    have ideal := ringMultiples.ideal at K, x with comm
    rcases ideals with ringMultiples(K, x), ideal with zero | whole
    . have self := ringMultiples.self_mem at K, x with comm
      rw zero at self
      have xz := singleton.membership.forward with self
      exfalso
      exact xnz with xz
    . have u := (ringMultiples.eq_whole_iff at K, x with comm).forward with whole
      obtain ⟨_, y, yIn, xy, yx⟩ := u
      unfold IsInverse
      exact ⟨y, xIn, yIn, yx, xy⟩
  have isField : IsField(Ring.carrier(K), Ring.add(K), Ring.zero(K), Ring.neg(K), Ring.mul(K), Ring.one(K))
    unfold IsField
    unfold Nontrivial
    exact ⟨parts, ⟨zeroIn, oneIn, nontrivial⟩, inverses⟩
  have eta := Ring.eta_of_ring at K with ringK
  rw eta
  exact Field.of_parts with isField

-- Helper: left multiplication by x as a function on the carrier.
defgraph ringLeftMul (R x : Set) (y ∈ Ring.carrier(R)) : Ring.carrier(R) :=
  call2(Ring.mul(R), x, y)
requires comm : CommRing(R)
requires element : x ∈ Ring.carrier(R)
proof
  typecheck

-- A finite domain is a field (Fintype.fieldOfDomain, IsArtinianRing.of_finite
-- on domains).
theorem IntegralDomain.finite_field (R : Set)
  requires domain : IntegralDomain(R)
  requires finite : Finite(Ring.carrier(R))
  shows Field(R)
proof
  have comm := IntegralDomain.comm_ring at R with domain
  have nt := IntegralDomain.nontrivial at R with domain
  have ringR := CommRing.to_ring with comm
  have parts := CommRing.parts at R with comm
  have zeroIn : Ring.zero(R) ∈ Ring.carrier(R) by typecheck
  have oneIn : Ring.one(R) ∈ Ring.carrier(R) by typecheck
  have inverses : ∀ x ∈ Ring.carrier(R), x ≠ Ring.zero(R) → ∃ y, IsInverse(Ring.carrier(R), Ring.mul(R), Ring.one(R), x, y)
    intros x xIn xnz
    have fn := ringLeftMul.function at R, x with comm, xIn
    have cancel : ∀ u ∈ Ring.carrier(R), ∀ v ∈ Ring.carrier(R), ringLeftMul(R, x)(u) = ringLeftMul(R, x)(v) → u = v
      intros u uIn v vIn same
      have vu := ringLeftMul.value at R, x, u with comm, xIn, uIn
      have vv := ringLeftMul.value at R, x, v with comm, xIn, vIn
      rw [vu, vv] at same
      exact IntegralDomain.mul_cancel at R, x, u, v with domain, xIn, uIn, vIn, xnz, same
    have inj := Injective.of_pointwise with fn, cancel
    have surj := Finite.surjective_of_injective at ringLeftMul(R, x), Ring.carrier(R), Ring.carrier(R) with inj, finite, rfl
    obtain ⟨_, onto⟩ := surj
    obtain ⟨y, yIn, rel⟩ := onto with Ring.one(R), oneIn
    have app := FunctionBetween.apply_value with fn, yIn, rel
    have vy := ringLeftMul.value at R, x, y with comm, xIn, yIn
    rw vy at app
    have yx : call2(Ring.mul(R), y, x) = Ring.one(R)
      rw ← app
      ring
    unfold IsInverse
    exact ⟨y, xIn, yIn, yx, app⟩
  have isField : IsField(Ring.carrier(R), Ring.add(R), Ring.zero(R), Ring.neg(R), Ring.mul(R), Ring.one(R))
    unfold IsField
    unfold Nontrivial
    exact ⟨parts, ⟨zeroIn, oneIn, nt⟩, inverses⟩
  have eta := Ring.eta_of_ring at R with ringR
  rw eta
  exact Field.of_parts with isField

-- Section: Principal ideal domains and unique factorization domains
-- Helper: the principal ideals generated by the members of S.
def rmEPrincipalOf (R S : Set) : Set :=
  { J ∈ 𝒫(Ring.carrier(R)) | ∃ s ∈ S, J = ringMultiples(R, s) }

section PrincipalIdealDomains
variable (R : Set)
hypothesis pid : PrincipalIdealDomain(R)

theorem PrincipalIdealDomain.domain
  shows IntegralDomain(R)
proof
  exact pid.left

theorem PrincipalIdealDomain.principal (I : Set)
  requires ideal : Ideal(R, I)
  shows ∃ a ∈ R.carrier, I = ringMultiples(R, a)
proof
  obtain ⟨_, principal⟩ := pid
  have pr := principal with I, ideal
  obtain ⟨_, a, aIn, ia⟩ := pr
  exact ⟨a, aIn, ia⟩

-- Helper: a generator d of the ideal generated by a and b divides both,
-- and a unit generator makes a and b coprime.
theorem PrincipalIdealDomain.pair_generator (a b : Set)
  requires first : a ∈ R.carrier
  requires second : b ∈ R.carrier
  shows ∃ d ∈ R.carrier, RingDvd(R, d, a) ∧ RingDvd(R, d, b) ∧
    (RingUnit(R, d) → RingCoprime(R, a, b))
proof
  obtain ⟨domain, principal⟩ := pid
  have comm := IntegralDomain.comm_ring at R with domain
  have gen := generatedIdeal.ideal at R, {a, b} with comm
  have pr := principal with generatedIdeal(R, {a, b}), gen
  obtain ⟨_, d, dIn, gd⟩ := pr
  have bounded : {a, b} ⊆ R.carrier
    intros y hy
    rcases pair.membership.forward with hy with ya | yb
    . rw ya
      exact first
    . rw yb
      exact second
  have contains := generatedIdeal.contains at R, {a, b} with comm, bounded
  have aG := contains with (pair.left at a, b)
  have bG := contains with (pair.right at a, b)
  rw gd at aG
  rw gd at bG
  have da := (ringMultiples.mem_iff at R, d, a with comm).forward with aG
  have db := (ringMultiples.mem_iff at R, d, b with comm).forward with bG
  have unitCase : RingUnit(R, d) → RingCoprime(R, a, b)
    intro u
    have whole := (ringMultiples.eq_whole_iff at R, d with comm).backward with u
    rw ← gd at whole
    exact (RingCoprime.iff_generate at R, a, b with comm).backward with whole
  exact ⟨d, dIn, da, db, unitCase⟩

-- In a PID irreducibles are prime (PrincipalIdealRing.irreducible_iff_prime)
-- and generate maximal ideals.
theorem PrincipalIdealDomain.irreducible_prime (p : Set)
  requires irreducible : RingIrreducible(R, p)
  shows RingPrime(R, p)
proof
  have domain := PrincipalIdealDomain.domain at R with pid
  have comm := IntegralDomain.comm_ring at R with domain
  have pnz := RingIrreducible.ne_zero at R, p with domain, irreducible
  have irr0 := irreducible
  obtain ⟨pIn, pnu, factors⟩ := irr0
  refine ⟨pIn, pnz, pnu, ?_⟩
  intros a aIn b bIn d
  by_cases pa : RingDvd(R, p, a)
  . left
    exact pa
  . right
    obtain ⟨g, gIn, gp, ga, unitCase⟩ := PrincipalIdealDomain.pair_generator at R, p, a with pid, pIn, aIn
    obtain ⟨_, _, x, xIn, px⟩ := gp
    rcases factors with g, gIn, x, xIn, px with gu | xu
    . have cop := unitCase with gu
      exact RingCoprime.dvd_of_dvd_mul at R, p, a, b with comm, cop, d
    . exfalso
      obtain ⟨vUnit, right⟩ := ringInverse.unit at R, x with comm, xu
      have vIn := ringInverse.mem at R, x with *
      have law : g = p * ringInverse(R, x)
        rw px
        have regroup : g * x * ringInverse(R, x) = g * (x * ringInverse(R, x)) by ring
        rw [regroup, right]
        ring
      have pg := RingDvd.intro at R, p, g, ringInverse(R, x) with comm, law
      have pa2 := RingDvd.trans at R, p, g, a with comm, pg, ga
      exact pa with pa2

theorem PrincipalIdealDomain.irreducible_maximal (p : Set)
  requires irreducible : RingIrreducible(R, p)
  shows MaximalIdeal(R, ringMultiples(R, p))
proof
  have domain := PrincipalIdealDomain.domain at R with pid
  have comm := IntegralDomain.comm_ring at R with domain
  have ringR := CommRing.to_ring with comm
  have irr0 := irreducible
  obtain ⟨pIn, pnu, factors⟩ := irr0
  have ideal := ringMultiples.ideal at R, p with comm
  have oneOut : R.one ∉ ringMultiples(R, p)
    intro oneIn
    have d := (ringMultiples.mem_iff at R, p, R.one with comm).forward with oneIn
    have u := (RingUnit.iff_dvd_one at R, p with comm).backward with d
    exact pnu with u
  have proper := ProperIdeal.mk at R, ringMultiples(R, p) with ringR, ideal, oneOut
  have maximality : ∀ J, ProperIdeal(R, J) → ringMultiples(R, p) ⊆ J → J = ringMultiples(R, p)
    intros J properJ contains
    have idealJ := ProperIdeal.to_ideal at R, J with properJ
    obtain ⟨g, gIn, jg⟩ := PrincipalIdealDomain.principal at R, J with pid, idealJ
    have self := ringMultiples.self_mem at R, p with comm
    have pJ := contains with self
    rw jg at pJ
    have gp := (ringMultiples.mem_iff at R, g, p with comm).forward with pJ
    obtain ⟨_, _, x, xIn, px⟩ := gp
    rcases factors with g, gIn, x, xIn, px with gu | xu
    . exfalso
      have whole := (ringMultiples.eq_whole_iff at R, g with comm).backward with gu
      rw ← jg at whole
      have oneIn : R.one ∈ R.carrier by typecheck
      rw ← whole at oneIn
      exact (ProperIdeal.one_not_mem at R, J with properJ) with oneIn
    . have same := ringMultiples.mul_unit at R, g, x with comm, xu
      rw ← px at same
      rw [jg, same]
  exact ⟨proper, maximality⟩

-- Nonzero prime ideals of a PID are maximal
-- (IsPrime.to_maximal_ideal).
theorem PrincipalIdealDomain.prime_maximal (P : Set)
  requires prime : PrimeIdeal(R, P)
  requires nonzero : P ≠ {R.zero}
  shows MaximalIdeal(R, P)
proof
  have domain := PrincipalIdealDomain.domain at R with pid
  have comm := IntegralDomain.comm_ring at R with domain
  have ringR := CommRing.to_ring with comm
  have proper := PrimeIdeal.to_proper at R, P with prime
  have idealP := PrimeIdeal.to_ideal at R, P with prime
  obtain ⟨p, pIn, pp⟩ := PrincipalIdealDomain.principal at R, P with pid, idealP
  have pnz : p ≠ R.zero
    intro pz
    have zero := (ringMultiples.eq_zero_iff at R, p with comm).backward with pz
    rw ← pp at zero
    exact nonzero with zero
  have maximality : ∀ J, ProperIdeal(R, J) → P ⊆ J → J = P
    intros J properJ contains
    have idealJ := ProperIdeal.to_ideal at R, J with properJ
    obtain ⟨g, gIn, jg⟩ := PrincipalIdealDomain.principal at R, J with pid, idealJ
    have self := ringMultiples.self_mem at R, p with comm
    rw ← pp at self
    have pJ := contains with self
    rw jg at pJ
    have gp := (ringMultiples.mem_iff at R, g, p with comm).forward with pJ
    obtain ⟨_, _, x, xIn, px⟩ := gp
    have gxP : g * x ∈ P
      rw ← px
      exact self
    rcases PrimeIdeal.mem_or_mem at R, P, g, x with ringR, prime, gIn, xIn, gxP with gP | xP
    . have gSub := (ringMultiples.subset_ideal_iff at R, g, P with comm, gIn, idealP).backward with gP
      rw ← jg at gSub
      exact Subset.antisymmetric with gSub, contains
    . exfalso
      rw pp at xP
      have dx := (ringMultiples.mem_iff at R, p, x with comm).forward with xP
      obtain ⟨_, _, y, yIn, xy⟩ := dx
      have eq : p * (g * y) = p * R.one
        have l : p * (g * y) = g * (p * y) by ring
        rw [l, ← xy, ← px]
        ring
      have gyIn : g * y ∈ R.carrier by typecheck
      have oneIn : R.one ∈ R.carrier by typecheck
      have can := IntegralDomain.mul_cancel at R, p, g * y, R.one with domain, pIn, gyIn, oneIn, pnz, eq
      have gu := RingUnit.of_product at R, g, y with comm, gIn, yIn, can
      have whole := (ringMultiples.eq_whole_iff at R, g with comm).backward with gu
      rw ← jg at whole
      rw ← whole at oneIn
      exact (ProperIdeal.one_not_mem at R, J with properJ) with oneIn
  exact ⟨proper, maximality⟩

-- Bezout: in a PID, elements with no common nonunit divisor are coprime.
theorem PrincipalIdealDomain.coprime_of_no_common_divisor (a b : Set)
  requires first : a ∈ R.carrier
  requires second : b ∈ R.carrier
  requires noCommon : ∀ d ∈ R.carrier, RingDvd(R, d, a) → RingDvd(R, d, b) →
    RingUnit(R, d)
  shows RingCoprime(R, a, b)
proof
  obtain ⟨g, gIn, ga, gb, unitCase⟩ := PrincipalIdealDomain.pair_generator at R, a, b with pid, first, second
  have gu := noCommon with g, gIn, ga, gb
  exact unitCase with gu

-- A PID is a UFD (PrincipalIdealRing.to_uniqueFactorizationMonoid).
-- Well-foundedness of strict divisibility from the ascending chain
-- condition on principal ideals uses dependent choice: Choice.
theorem PrincipalIdealDomain.unique_factorization
  shows UniqueFactorizationDomain(R)
proof
  have domain := PrincipalIdealDomain.domain at R with pid
  have comm := IntegralDomain.comm_ring at R with domain
  have irrPrime : ∀ p ∈ R.carrier, RingIrreducible(R, p) → RingPrime(R, p)
    intros p pIn irr
    exact PrincipalIdealDomain.irreducible_prime at R, p with pid, irr
  have wf : DvdWellFounded(R)
    intros S sub ne
    have mulIn : ∀ s ∈ S, ringMultiples(R, s) ∈ rmEPrincipalOf(R, S)
      intros s hs
      have sIn := sub with s, hs
      have id := ringMultiples.ideal at R, s with comm
      obtain ⟨bounded, _⟩ := id
      unfold Subset at bounded
      have pw := set.powerset.backward with bounded
      have e : ringMultiples(R, s) = ringMultiples(R, s) by rfl
      exact rmEPrincipalOf.membership.backward at R, S, ringMultiples(R, s) with ⟨pw, s, hs, e⟩
    have closed : ∀ C, Nonempty(C) → C ⊆ rmEPrincipalOf(R, S) →
        (∀ A ∈ C, ∀ B ∈ C, A ⊆ B ∨ B ⊆ A) → ⋃(C) ∈ rmEPrincipalOf(R, S)
      intros C inhabited cSub nested
      have ideals : ∀ J ∈ C, IsIdeal(R.carrier, R.add, R.zero, R.neg, R.mul, J)
        intros J hJ
        have jF := cSub with J, hJ
        obtain ⟨_, s, hs, js⟩ := rmEPrincipalOf.membership.forward at R, S, J with jF
        have sIn := sub with s, hs
        have id := ringMultiples.ideal at R, s with comm
        rw ← js at id
        exact Ideal.parts with id
      have uIdeal := IsIdeal.union_chain with inhabited, ideals, nested
      have uBundled := Ideal.of_projections at R, ⋃(C) with uIdeal
      obtain ⟨d, dIn, ud⟩ := PrincipalIdealDomain.principal at R, ⋃(C) with pid, uBundled
      have dSelf := ringMultiples.self_mem at R, d with comm
      rw ← ud at dSelf
      obtain ⟨J, hJ, dJ⟩ := (union.membership at d, C).forward with dSelf
      have jF := cSub with J, hJ
      obtain ⟨_, s, hs, js⟩ := rmEPrincipalOf.membership.forward at R, S, J with jF
      have sIn := sub with s, hs
      have sId := ringMultiples.ideal at R, s with comm
      rw js at dJ
      have dsub := (ringMultiples.subset_ideal_iff at R, d, ringMultiples(R, s) with comm, dIn, sId).backward with dJ
      have jsub := union.subset_of_member at J, C with hJ
      have us : ⋃(C) = ringMultiples(R, s)
        apply Subset.antisymmetric
        . rw ud
          exact dsub
        . rw ← js
          exact jsub
      rw us
      exact mulIn with s, hs
    obtain ⟨s0, hs0⟩ := Nonempty.of_ne_empty at S with ne
    have seed := mulIn with s0, hs0
    obtain ⟨M, mF, _, maxl⟩ := maximal_extension with seed, closed
    obtain ⟨_, m, mS, mm⟩ := rmEPrincipalOf.membership.forward at R, S, M with mF
    refine ⟨m, mS, ?_⟩
    intros x xS strict
    obtain ⟨xIn, mIn, xnz, y, yIn, ynu, my⟩ := strict
    have xm := RingDvd.intro at R, x, m, y with comm, my
    have incl := (ringMultiples.subset_iff at R, m, x with comm).backward with xm
    rw ← mm at incl
    have xF := mulIn with x, xS
    have eq := maxl with ringMultiples(R, x), xF, incl
    have xSelf := ringMultiples.self_mem at R, x with comm
    rw [eq, mm] at xSelf
    have mx := (ringMultiples.mem_iff at R, m, x with comm).forward with xSelf
    obtain ⟨_, _, c, cIn, xc⟩ := mx
    have ycIn : call2(R.mul, y, c) ∈ R.carrier by typecheck
    have oneIn : R[1] ∈ R.carrier by typecheck
    have both : call2(R.mul, x, R.one) = call2(R.mul, x, call2(R.mul, y, c))
      have step : call2(R.mul, x, call2(R.mul, y, c)) = call2(R.mul, call2(R.mul, x, y), c) by ring
      rw [step, ← my, ← xc]
      ring
    have one := IntegralDomain.mul_cancel at R, x, R.one, call2(R.mul, y, c) with domain, xIn, oneIn, ycIn, xnz, both
    have yu : RingUnit(R, y)
      refine ⟨yIn, c, cIn, ?_, ?_⟩
      . rw one
      . rw one
        ring
    exact ynu with yu
  exact ⟨domain, wf, irrPrime⟩

end PrincipalIdealDomains

-- Helper: a is a unit times a finite product of primes.
predicate rmEPrimeFactored (R a : Set) :=
  ∃ u ∈ ringUnits(R), ∃ n, Nat(n) ∧ ∃ p, (p : n → Ring.carrier(R)) ∧
    (∀ i ∈ n, RingPrime(R, p(i))) ∧
    a = call2(Ring.mul(R), u, finiteRingProduct(n, Ring.carrier(R),
      Ring.add(R), Ring.zero(R), Ring.neg(R), Ring.mul(R), Ring.one(R), p))

-- Helper: zero and the elements with a prime factorization.
def rmEPrimeFactoredSet (R : Set) : Set :=
  { a ∈ Ring.carrier(R) | a = Ring.zero(R) ∨ rmEPrimeFactored(R, a) }

-- Helper: the values of an extended map (as in Combinatorics).
theorem rmEAdjoin.apply_new (f A B a b : Set)
  requires hf : f : A → B
  requires ha : ¬a ∈ A
  shows adjoinMap(f, a, b)(a) = b
proof
  have function := adjoinMap.function at f, A, B, a, b with hf, ha
  exact FunctionBetween.apply_value with function, (insert.self at a, A),
    (adjoinMap.relates_new at f, a, b)

theorem rmEAdjoin.apply_old (f A B a b x : Set)
  requires hf : f : A → B
  requires ha : ¬a ∈ A
  requires hx : x ∈ A
  shows adjoinMap(f, a, b)(x) = f(x)
proof
  have function := adjoinMap.function at f, A, B, a, b with hf, ha
  have related := adjoinMap.relates_old at f, a, b, x, f(x) with
    (FunctionBetween.relates_apply with hf, hx)
  exact FunctionBetween.apply_value with function, (insert.contains with hx),
    related

section UniqueFactorization
variable (R : Set)
hypothesis ufd : UniqueFactorizationDomain(R)

theorem UniqueFactorizationDomain.domain
  shows IntegralDomain(R)
proof
  exact ufd.left

-- irreducible_iff_prime.
theorem UniqueFactorizationDomain.irreducible_iff_prime (p : Set)
  requires member : p ∈ R.carrier
  shows RingIrreducible(R, p) ↔ RingPrime(R, p)
proof
  obtain ⟨domain, _, irrPrime⟩ := ufd
  constructor
  . intro h
    exact irrPrime with p, member, h
  . intro h
    exact RingPrime.irreducible at R, p with domain, h

-- Helper: the nonunit divisors of a.
def ufdNonunitDivisors (a : Set) : Set :=
  { d ∈ R.carrier | RingDvd(R, d, a) ∧ ¬RingUnit(R, d) }

-- A nonzero nonunit of a UFD has a prime divisor
-- (WfDvdMonoid.exists_irreducible_factor).
theorem UniqueFactorizationDomain.exists_prime_dvd (a : Set)
  requires member : a ∈ R.carrier
  requires nonzero : a ≠ R.zero
  requires notUnit : ¬RingUnit(R, a)
  shows ∃ p ∈ R.carrier, RingPrime(R, p) ∧ RingDvd(R, p, a)
proof
  obtain ⟨domain, wf, irrPrime⟩ := ufd
  have comm := IntegralDomain.comm_ring at R with domain
  have sub : ufdNonunitDivisors(R, a) ⊆ R.carrier
    intros y hy
    obtain ⟨yIn, _⟩ := ufdNonunitDivisors.membership.forward at R, a, y with hy
    exact yIn
  have aSelf := RingDvd.refl at R, a with comm
  have aT := ufdNonunitDivisors.membership.backward at R, a, a with ⟨member, aSelf, notUnit⟩
  have ne : ufdNonunitDivisors(R, a) ≠ ∅
    intro empty
    rw empty at aT
    exact empty.membership at a with aT
  obtain ⟨m, mT, minimal⟩ := wf with ufdNonunitDivisors(R, a), sub, ne
  obtain ⟨mIn, ma, mnu⟩ := ufdNonunitDivisors.membership.forward at R, a, m with mT
  have mnz : m ≠ R.zero
    intro mz
    obtain ⟨_, _, c, cIn, ac⟩ := ma
    have az : a = R.zero
      rw [ac, mz]
      ring
    exact nonzero with az
  have irr : RingIrreducible(R, m)
    refine ⟨mIn, mnu, ?_⟩
    intros x xIn y yIn split
    by_contra neither
    have xnu : ¬RingUnit(R, x)
      intro xu
      have both : RingUnit(R, x) ∨ RingUnit(R, y) by left; exact xu
      exact neither with both
    have ynu : ¬RingUnit(R, y)
      intro yu
      have both : RingUnit(R, x) ∨ RingUnit(R, y) by right; exact yu
      exact neither with both
    have xm := RingDvd.intro at R, x, m, y with comm, split
    have xa := RingDvd.trans at R, x, m, a with comm, xm, ma
    have xT := ufdNonunitDivisors.membership.backward at R, a, x with ⟨xIn, xa, xnu⟩
    have xnz : x ≠ R.zero
      intro xz
      have mz : m = R.zero
        rw [split, xz]
        ring
      exact mnz with mz
    have strict : StrictDvd(R, x, m) by exact ⟨xIn, mIn, xnz, y, yIn, ynu, split⟩
    exact (minimal with x, xT) with strict
  have mp := irrPrime with m, mIn, irr
  exact ⟨m, mIn, mp, ma⟩

-- UniqueFactorizationMonoid.induction_on_prime: a property of elements
-- holding at 0 and at units and preserved by multiplication by primes
-- holds everywhere.
theorem UniqueFactorizationDomain.induction_on_prime (P : Set)
  requires zero : R.zero ∈ P
  requires units : ringUnits(R) ⊆ P
  requires step : ∀ a ∈ P ∩ R.carrier, ∀ p ∈ R.carrier, RingPrime(R, p) →
    a ≠ R.zero → call2(R.mul, p, a) ∈ P
  shows R.carrier ⊆ P
proof
  have ufd0 := ufd
  obtain ⟨domain, wf, _⟩ := ufd0
  have comm := IntegralDomain.comm_ring at R with domain
  intros z zIn
  by_contra zOut
  have sub : R.carrier ∖ P ⊆ R.carrier
    intros y hy
    exact ((difference.membership at R.carrier, P, y).forward with hy).left
  have zS := (difference.membership at R.carrier, P, z).backward with ⟨zIn, zOut⟩
  have ne : R.carrier ∖ P ≠ ∅
    intro empty
    rw empty at zS
    exact empty.membership at z with zS
  obtain ⟨m, mS, minimal⟩ := wf with R.carrier ∖ P, sub, ne
  obtain ⟨mIn, mOut⟩ := (difference.membership at R.carrier, P, m).forward with mS
  have mnz : m ≠ R.zero
    intro mz
    rw mz at mOut
    exact mOut with zero
  have mnu : ¬RingUnit(R, m)
    intro mu
    have mU := ringUnits.mem_of_unit at R, m with comm, mu
    exact mOut with (units with mU)
  obtain ⟨p, pIn, pp, pm⟩ := UniqueFactorizationDomain.exists_prime_dvd at R, m with ufd, mIn, mnz, mnu
  obtain ⟨_, _, c, cIn, mc⟩ := pm
  have cnz : c ≠ R.zero
    intro cz
    have mz : m = R.zero
      rw [mc, cz]
      ring
    exact mnz with mz
  by_cases cP : c ∈ P
  . have cPR : c ∈ P ∩ R.carrier by exact (intersection.membership at P, R.carrier, c).backward with ⟨cP, cIn⟩
    have pc := step with c, cPR, p, pIn, pp, cnz
    rw ← mc at pc
    exact mOut with pc
  . have cS := (difference.membership at R.carrier, P, c).backward with ⟨cIn, cP⟩
    have pnu : ¬RingUnit(R, p) by exact pp.right.right.left
    have law : m = c * p
      rw mc
      ring
    have strict : StrictDvd(R, c, m) by exact ⟨cIn, mIn, cnz, p, pIn, pnu, law⟩
    exact (minimal with c, cS) with strict

-- Existence of a factorization into primes
-- (UniqueFactorizationMonoid.exists_prime_factors): a nonzero a is a unit
-- times a finite product of primes, written as a list.
theorem UniqueFactorizationDomain.exists_prime_factors (a : Set)
  requires member : a ∈ R.carrier
  requires nonzero : a ≠ R.zero
  shows ∃ u ∈ ringUnits(R), ∃ n, Nat(n) ∧ ∃ p, (p : n → R.carrier) ∧
    (∀ i ∈ n, RingPrime(R, p(i))) ∧
    a = call2(R.mul, u, finiteRingProduct(n, R.carrier, R.add, R.zero,
      R.neg, R.mul, R.one, p))
proof
  have ufd0 := ufd
  obtain ⟨domain, _, _⟩ := ufd0
  have comm := IntegralDomain.comm_ring at R with domain
  have parts := CommRing.parts with comm
  have zeroIn : R[0] ∈ R.carrier by typecheck
  have zeroP : R.zero ∈ rmEPrimeFactoredSet(R)
    have z : R.zero = R.zero by rfl
    have d : R.zero = R.zero ∨ rmEPrimeFactored(R, R.zero) by left; exact z
    exact rmEPrimeFactoredSet.membership.backward at R, R.zero with ⟨zeroIn, d⟩
  have unitsP : ringUnits(R) ⊆ rmEPrimeFactoredSet(R)
    intros u hu
    obtain ⟨uIn, _⟩ := ringUnits.membership.forward at R, u with hu
    have emptyF := FunctionBetween.empty at R.carrier
    have prod := finiteRingProduct.empty at R.carrier, R.add, R.zero, R.neg, R.mul, R.one, ∅ with parts, emptyF
    have none : ∀ i ∈ ∅, RingPrime(R, ∅(i))
      intros i hi
      exfalso
      exact set.empty with hi
    have law : u = call2(R.mul, u, finiteRingProduct(∅, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, ∅))
      rw prod
      ring
    have zNat : Nat(∅)
      rw ← nat.zero
      typecheck
    have f : rmEPrimeFactored(R, u) by exact ⟨u, hu, ∅, zNat, ∅, emptyF, none, law⟩
    have d : u = R.zero ∨ rmEPrimeFactored(R, u) by right; exact f
    exact rmEPrimeFactoredSet.membership.backward at R, u with ⟨uIn, d⟩
  have stepP : ∀ b ∈ rmEPrimeFactoredSet(R) ∩ R.carrier, ∀ q ∈ R.carrier, RingPrime(R, q) →
      b ≠ R.zero → call2(R.mul, q, b) ∈ rmEPrimeFactoredSet(R)
    intros b hb q qIn qp bnz
    obtain ⟨bP, bIn⟩ := (intersection.membership at rmEPrimeFactoredSet(R), R.carrier, b).forward with hb
    obtain ⟨_, alt⟩ := rmEPrimeFactoredSet.membership.forward at R, b with bP
    have fac : rmEPrimeFactored(R, b)
      rcases alt with bz | fb
      . exfalso
        exact bnz with bz
      . exact fb
    obtain ⟨u, uU, n, nNat, p, pF, pPrime, bEq⟩ := fac
    obtain ⟨uIn, _⟩ := ringUnits.membership.forward at R, u with uU
    have fresh := membership.irreflexive at n
    have ext := adjoinMap.function at p, n, R.carrier, n, q with pF, fresh
    have extC : adjoinMap(p, n, q) : insert(n, n) → R.carrier
      apply FunctionBetween.codomain_of_values with ext
      intros i hi
      rcases (insert.membership at i, n, n).forward with hi with ie | io
      . rw ie
        have nv := rmEAdjoin.apply_new at p, n, R.carrier, n, q with pF, fresh
        rwa nv
      . have ov := rmEAdjoin.apply_old at p, n, R.carrier, n, q, i with pF, fresh, io
        rw ov
        exact FunctionBetween.apply_closed with pF, io
    have si := natural.successor_as_insert at n
    have fin := Finite.natural at n
    have ins := finiteRingProduct.insert at n, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, adjoinMap(p, n, q), n with parts, fin, extC, fresh
    have sub : n ⊆ insert(n, n)
      intros x hx
      exact insert.contains with hx
    have closedR : ∀ x ∈ n, adjoinMap(p, n, q)(x) ∈ R.carrier
      intros x hx
      exact FunctionBetween.apply_closed with extC, (insert.contains at x, n, n with hx)
    have rF := restrict.function at adjoinMap(p, n, q), insert(n, n), R.carrier, n, R.carrier with extC, sub, closedR
    have agree : ∀ x ∈ n, restrict(adjoinMap(p, n, q), n)(x) = p(x)
      intros x hx
      have r1 := restrict.apply at adjoinMap(p, n, q), insert(n, n), R.carrier, n, R.carrier, x with extC, sub, closedR, hx
      have r2 := rmEAdjoin.apply_old at p, n, R.carrier, n, q, x with pF, fresh, hx
      rw [r1, r2]
    have same := finiteRingProduct.congr at n, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, restrict(adjoinMap(p, n, q), n), p with parts, fin, rF, pF, agree
    have nv := rmEAdjoin.apply_new at p, n, R.carrier, n, q with pF, fresh
    have prodIn := finiteRingProduct.closed at n, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, p with parts, fin, pF
    have law : call2(R.mul, q, b) = call2(R.mul, u, finiteRingProduct(succ(n), R.carrier, R.add, R.zero, R.neg, R.mul, R.one, adjoinMap(p, n, q)))
      rw [si, ins, same, nv, bEq]
      ring
    have sNat : Nat(succ(n)) by typecheck
    have primes : ∀ i ∈ succ(n), RingPrime(R, adjoinMap(p, n, q)(i))
      intros i hi
      rw si at hi
      rcases (insert.membership at i, n, n).forward with hi with ie | io
      . rw [ie, nv]
        exact qp
      . have ov := rmEAdjoin.apply_old at p, n, R.carrier, n, q, i with pF, fresh, io
        rw ov
        exact pPrime with i, io
    have extS : adjoinMap(p, n, q) : succ(n) → R.carrier by rwa si
    have f : rmEPrimeFactored(R, call2(R.mul, q, b)) by exact ⟨u, uU, succ(n), sNat, adjoinMap(p, n, q), extS, primes, law⟩
    have d : call2(R.mul, q, b) = R.zero ∨ rmEPrimeFactored(R, call2(R.mul, q, b)) by right; exact f
    have qbIn : call2(R.mul, q, b) ∈ R.carrier by typecheck
    exact rmEPrimeFactoredSet.membership.backward at R, call2(R.mul, q, b) with ⟨qbIn, d⟩
  have all := UniqueFactorizationDomain.induction_on_prime at R, rmEPrimeFactoredSet(R) with ufd, zeroP, unitsP, stepP
  have aP := all with member
  obtain ⟨_, alt⟩ := rmEPrimeFactoredSet.membership.forward at R, a with aP
  rcases alt with az | fa
  . exfalso
    exact nonzero with az
  . exact fa

end UniqueFactorization
