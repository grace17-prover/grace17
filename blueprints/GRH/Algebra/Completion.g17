-- Adic completion: for an ideal I of R and an R-module M, the quotients
-- M ⧸ Iⁿ M, the completion as the module of compatible sequences of
-- classes (Mathlib's AdicCompletion), the map of M into it
-- (AdicCompletion.of) and the evaluations (AdicCompletion.eval), the
-- completion of the ring R itself, Hausdorff, precomplete and adically
-- complete modules and rings (IsHausdorff, IsPrecomplete, IsAdicComplete),
-- induced maps and lifts, the Krull intersection theorem, units in
-- complete rings, Henselian rings and pairs (HenselianRing,
-- HenselianLocalRing), and Hensel's lemma.
-- Part of the GRH blueprint.
-- Planned home: Algebra/Ring/AdicCompletion.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Algebra.Completion
import GRH.Algebra.Finiteness

-- Section: The quotients M ⧸ Iⁿ M
-- The submodule Iⁿ M, the quotient module M ⧸ Iⁿ M, and the class of v in
-- it.
def adicSubmodule (M R I : Set, n : Nat) : Set :=
  idealSmul(M, R, idealPow(R, I, n), Module.carrier(M))

def adicQuotient (M R I : Set, n : Nat) : Set :=
  quotientModule(M, R, adicSubmodule(M, R, I, n))

def adicClass (M R I v : Set, n : Nat) : Set :=
  quotientModuleMap(M, adicSubmodule(M, R, I, n))(v)

-- The carriers of all the quotients, and their union.
def adicQuotientCarriers (M R I : Set) : Set :=
  { Module.carrier(adicQuotient(M, R, I, n)) | n ∈ ℕ }

def adicUnion (M R I : Set) : Set := ⋃(adicQuotientCarriers(M, R, I))

-- Section: The completion
-- A compatible sequence: x(n) ∈ M ⧸ Iⁿ M, and whenever x(n) is the class
-- of v, x(m) is the class of v for m ≤ n (AdicCompletion as a submodule of
-- Π M ⧸ Iⁿ M).
def adicCompletionCarrier (M R I : Set) : Set :=
  { x ∈ functionSpace(ℕ, adicUnion(M, R, I)) |
    (∀ n ∈ ℕ, x(n) ∈ Module.carrier(adicQuotient(M, R, I, n))) ∧
    (∀ m ∈ ℕ, ∀ n ∈ ℕ, m ≤ n → ∀ v ∈ Module.carrier(M),
      x(n) = adicClass(M, R, I, v, n) → x(m) = adicClass(M, R, I, v, m)) }

-- The componentwise operations.
def adicSequenceSum (M R I x y : Set) : Set :=
  { u ∈ ℕ × adicUnion(M, R, I) | ∃ n ∈ ℕ,
    u = (n, call2(Module.add(adicQuotient(M, R, I, n)), x(n), y(n))) }

def adicSequenceNeg (M R I x : Set) : Set :=
  { u ∈ ℕ × adicUnion(M, R, I) | ∃ n ∈ ℕ,
    u = (n, apply(Module.neg(adicQuotient(M, R, I, n)), x(n))) }

def adicSequenceSmul (M R I r x : Set) : Set :=
  { u ∈ ℕ × adicUnion(M, R, I) | ∃ n ∈ ℕ,
    u = (n, call2(Module.smul(adicQuotient(M, R, I, n)), r, x(n))) }

def adicSequenceZero (M R I : Set) : Set :=
  { u ∈ ℕ × adicUnion(M, R, I) | ∃ n ∈ ℕ,
    u = (n, Module.zero(adicQuotient(M, R, I, n))) }

def adicCompletionAdd (M R I : Set) : Set :=
  { q ∈ (adicCompletionCarrier(M, R, I) × adicCompletionCarrier(M, R, I)) ×
      adicCompletionCarrier(M, R, I) |
    ∃ x ∈ adicCompletionCarrier(M, R, I), ∃ y ∈ adicCompletionCarrier(M, R, I),
      q = ((x, y), adicSequenceSum(M, R, I, x, y)) }

def adicCompletionNeg (M R I : Set) : Set :=
  { q ∈ adicCompletionCarrier(M, R, I) × adicCompletionCarrier(M, R, I) |
    ∃ x ∈ adicCompletionCarrier(M, R, I), q = (x, adicSequenceNeg(M, R, I, x)) }

def adicCompletionSmul (M R I : Set) : Set :=
  { q ∈ (Ring.carrier(R) × adicCompletionCarrier(M, R, I)) ×
      adicCompletionCarrier(M, R, I) |
    ∃ r ∈ Ring.carrier(R), ∃ x ∈ adicCompletionCarrier(M, R, I),
      q = ((r, x), adicSequenceSmul(M, R, I, r, x)) }

-- The completion of M as an R-module (AdicCompletion I M).
def adicCompletion (M R I : Set) : Set :=
  Module.mk(adicCompletionCarrier(M, R, I), adicCompletionAdd(M, R, I),
    adicSequenceZero(M, R, I), adicCompletionNeg(M, R, I),
    adicCompletionSmul(M, R, I))

-- The sequence of classes of v, and the map v ↦ ([v]ₙ)ₙ (AdicCompletion.of).
def adicConstantSequence (M R I v : Set) : Set :=
  { u ∈ ℕ × adicUnion(M, R, I) | ∃ n ∈ ℕ, u = (n, adicClass(M, R, I, v, n)) }

def adicOf (M R I : Set) : Set :=
  { p ∈ Module.carrier(M) × adicCompletionCarrier(M, R, I) |
    ∃ v ∈ Module.carrier(M), p = (v, adicConstantSequence(M, R, I, v)) }

-- The n-th evaluation x ↦ x(n) (AdicCompletion.eval).
def adicEval (M R I : Set, n : Nat) : Set :=
  { p ∈ adicCompletionCarrier(M, R, I) × Module.carrier(adicQuotient(M, R, I, n)) |
    ∃ x ∈ adicCompletionCarrier(M, R, I), p = (x, x(n)) }

-- For a linear map f : M → N, the induced map of completions
-- (AdicCompletion.map): the class of v goes to the class of f(v).
def adicMapSequence (M R I N f x : Set) : Set :=
  { u ∈ ℕ × adicUnion(N, R, I) | ∃ n ∈ ℕ, ∃ v ∈ Module.carrier(M),
    x(n) = adicClass(M, R, I, v, n) ∧ u = (n, adicClass(N, R, I, f(v), n)) }

def adicMap (M R I N f : Set) : Set :=
  { p ∈ adicCompletionCarrier(M, R, I) × adicCompletionCarrier(N, R, I) |
    ∃ x ∈ adicCompletionCarrier(M, R, I), p = (x, adicMapSequence(M, R, I, N, f, x)) }

-- Section: The completion of a ring
-- R ⧸ Iⁿ as rings, compatible sequences of classes, and the componentwise
-- product and one (AdicCompletion I R as a ring).
def adicRingQuotient (R I : Set, n : Nat) : Set := quotientRing(R, idealPow(R, I, n))

def adicRingProduct (R I x y : Set) : Set :=
  { u ∈ ℕ × adicUnion(selfModule(R), R, I) | ∃ n ∈ ℕ,
    u = (n, call2(Ring.mul(adicRingQuotient(R, I, n)), x(n), y(n))) }

def adicRingOne (R I : Set) : Set :=
  adicConstantSequence(selfModule(R), R, I, Ring.one(R))

def adicRingMul (R I : Set) : Set :=
  { q ∈ (adicCompletionCarrier(selfModule(R), R, I) ×
      adicCompletionCarrier(selfModule(R), R, I)) ×
      adicCompletionCarrier(selfModule(R), R, I) |
    ∃ x ∈ adicCompletionCarrier(selfModule(R), R, I),
    ∃ y ∈ adicCompletionCarrier(selfModule(R), R, I),
      q = ((x, y), adicRingProduct(R, I, x, y)) }

def adicCompletionRing (R I : Set) : Set :=
  Ring.mk(adicCompletionCarrier(selfModule(R), R, I),
    adicCompletionAdd(selfModule(R), R, I),
    adicSequenceZero(selfModule(R), R, I),
    adicCompletionNeg(selfModule(R), R, I), adicRingMul(R, I),
    adicRingOne(R, I))

-- The completion as an R-algebra (AdicCompletion with algebraMap = of).
def adicCompletionAlgebra (R I : Set) : Set :=
  Algebra.mk(R, adicCompletionRing(R, I), adicOf(selfModule(R), R, I))

-- Section: Hausdorff, precomplete, complete
-- Hausdorff: ⋂ Iⁿ M = 0 (IsHausdorff); precomplete: every sequence with
-- x(m) − x(n) ∈ Iᵐ M for m ≤ n has a limit L with L − x(n) ∈ Iⁿ M
-- (IsPrecomplete); adically complete: both (IsAdicComplete).
predicate AdicHausdorff (M R I : Set) :=
  Module(M, R) ∧ Ideal(R, I) ∧
  (∀ v ∈ Module.carrier(M), (∀ n ∈ ℕ, v ∈ adicSubmodule(M, R, I, n)) →
    v = Module.zero(M))

predicate AdicPrecomplete (M R I : Set) :=
  Module(M, R) ∧ Ideal(R, I) ∧
  (∀ x, (x : ℕ → Module.carrier(M)) →
    (∀ m ∈ ℕ, ∀ n ∈ ℕ, m ≤ n → call2(Module.add(M), x(m),
      apply(Module.neg(M), x(n))) ∈ adicSubmodule(M, R, I, m)) →
    (∃ L ∈ Module.carrier(M), ∀ n ∈ ℕ,
      call2(Module.add(M), L, apply(Module.neg(M), x(n))) ∈ adicSubmodule(M, R, I, n)))

predicate AdicComplete (M R I : Set) :=
  AdicHausdorff(M, R, I) ∧ AdicPrecomplete(M, R, I)

-- A ring complete for its ideal I (IsAdicComplete I R).
predicate AdicCompleteRing (R I : Set) :=
  CommRing(R) ∧ AdicComplete(selfModule(R), R, I)

-- Section: Henselian rings
-- (R, I) is a Henselian pair: I lies in the Jacobson radical and every
-- monic f with a simple root a₀ modulo I (f(a₀) ∈ I, f'(a₀) a unit) has a
-- root a ≡ a₀ mod I (HenselianRing). A Henselian local ring is a local
-- ring Henselian for its maximal ideal (HenselianLocalRing).
predicate HenselianPair (R I : Set) :=
  CommRing(R) ∧ Ideal(R, I) ∧ I ⊆ jacobsonRadical(R, {Ring.zero(R)}) ∧
  (∀ f, ∀ a₀ ∈ Ring.carrier(R), PolyMonic(R, f) → polyEval(R, f, a₀) ∈ I →
    RingUnit(R, polyEval(R, polyDerivative(R)(f), a₀)) →
    (∃ a ∈ Ring.carrier(R), PolyIsRoot(R, f, a) ∧ Ring.sub(R, a, a₀) ∈ I))

predicate HenselianLocalRing (R : Set) :=
  LocalRing(R) ∧ HenselianPair(R, localMaximalIdeal(R))

-- Section: Laws of the completion
section Completion
variable (R M I : Set)
hypothesis comm : CommRing(R)
hypothesis module : Module(M, R)
hypothesis ideal : Ideal(R, I)

theorem adicSubmodule.submodule (n : Nat)
  shows SubmoduleOf(adicSubmodule(M, R, I, n), M, R)
proof
  have ringR := CommRing.to_ring with comm
  have pw := idealPow.ideal at R, I, n with comm, ideal
  have whole := SubmoduleOf.whole at R, M with ringR, module
  unfold adicSubmodule
  exact (idealSmul.submodule at R, M, idealPow(R, I, n), M.carrier with comm, module, pw, whole).left

-- Iⁿ⁺¹ M ⊆ Iⁿ M, I⁰ M = M.
theorem adicSubmodule.antitone (m n : Nat)
  requires le : m ≤ n
  shows adicSubmodule(M, R, I, n) ⊆ adicSubmodule(M, R, I, m)
proof
  have pw := idealPow.antitone at R, I, m, n with comm, ideal, le
  unfold adicSubmodule
  exact idealSmul.mono at R, M, idealPow(R, I, n), idealPow(R, I, m), M.carrier, M.carrier with comm, module, pw, (Subset.reflexive at M.carrier)

theorem adicSubmodule.zero
  shows adicSubmodule(M, R, I, 0) = M.carrier
proof
  have ringR := CommRing.to_ring with comm
  have whole := SubmoduleOf.whole at R, M with ringR, module
  have wi := Ideal.whole at R with ringR
  unfold adicSubmodule
  rw (idealPow.zero at R, I with comm)
  have sm := idealSmul.submodule at R, M, R.carrier, M.carrier with comm, module, wi, whole
  apply Subset.antisymmetric with sm.right
  intros v hv
  have oneIn : R.one ∈ R.carrier by typecheck
  have m := idealSmul.smul_mem at R, M, R.carrier, M.carrier, R.one, v with comm, module, wi, whole, oneIn, hv
  rw (one_smul at R, M, v with hv, module) at m
  exact m

-- AdicCompletion is an R-module, of is linear (AdicCompletion.of), and
-- eval is linear and surjective (AdicCompletion.eval, eval_surjective)
-- with eval ∘ of the quotient map (AdicCompletion.eval_of).
theorem adicCompletion.module
  shows Module(adicCompletion(M, R, I), R)
proof
  sorry

theorem adicOf.linear
  shows LinearMap(adicOf(M, R, I), M, R, adicCompletion(M, R, I))
proof
  sorry

theorem adicEval.linear (n : Nat)
  shows LinearMap(adicEval(M, R, I, n), adicCompletion(M, R, I), R,
    adicQuotient(M, R, I, n)) ∧
    SurjectiveBetween(adicEval(M, R, I, n), adicCompletionCarrier(M, R, I),
      Module.carrier(adicQuotient(M, R, I, n)))
proof
  sorry

theorem adicEval.of (v : M) (n : Nat)
  shows adicEval(M, R, I, n)(adicOf(M, R, I)(v)) = adicClass(M, R, I, v, n)
proof
  sorry

-- AdicCompletion.ext: elements with the same evaluations are equal.
theorem adicCompletion.ext (x y : Set)
  requires first : x ∈ adicCompletionCarrier(M, R, I)
  requires second : y ∈ adicCompletionCarrier(M, R, I)
  requires agree : ∀ n ∈ ℕ, x(n) = y(n)
  shows x = y
proof
  have xd := first
  unfold adicCompletionCarrier at xd
  have yd := second
  unfold adicCompletionCarrier at yd
  have xs := xd.left
  unfold functionSpace at xs
  have xF := xs.right
  have ys := yd.left
  unfold functionSpace at ys
  have yF := ys.right
  apply FunctionBetween.ext with xF, yF
  exact agree

-- AdicCompletion.mk_surjective / induction_on: every element is the limit
-- of a Cauchy sequence of M: for every x there is v : ℕ → M with
-- x(n) the class of v(n).
theorem adicCompletion.representatives (x : Set)
  requires member : x ∈ adicCompletionCarrier(M, R, I)
  shows ∃ v, (v : ℕ → M.carrier) ∧ (∀ n ∈ ℕ, x(n) = adicClass(M, R, I, v(n), n))
proof
  sorry

-- of is injective iff M is Hausdorff (AdicCompletion.of_injective_iff),
-- surjective iff M is precomplete (of_surjective_iff), bijective iff M
-- is complete (of_bijective_iff).
theorem adicOf.injective_iff
  shows InjectiveBetween(adicOf(M, R, I), M.carrier, adicCompletionCarrier(M, R, I)) ↔
    AdicHausdorff(M, R, I)
proof
  sorry

theorem adicOf.surjective_iff
  shows SurjectiveBetween(adicOf(M, R, I), M.carrier, adicCompletionCarrier(M, R, I)) ↔
    AdicPrecomplete(M, R, I)
proof
  sorry

theorem adicOf.bijective_iff
  shows BijectiveBetween(adicOf(M, R, I), M.carrier, adicCompletionCarrier(M, R, I)) ↔
    AdicComplete(M, R, I)
proof
  sorry

-- The completion of M is complete for a finitely generated I
-- (AdicCompletion.isAdicComplete), and Iⁿ times the completion is the
-- kernel of eval n (AdicCompletion.pow_smul_top_eq_ker_eval).
theorem adicCompletion.complete
  requires finitelyGenerated : FinitelyGeneratedIdeal(R, I)
  shows AdicComplete(adicCompletion(M, R, I), R, I)
proof
  sorry

theorem adicCompletion.kernel_eval (n : Nat)
  requires finitelyGenerated : FinitelyGeneratedIdeal(R, I)
  shows adicSubmodule(adicCompletion(M, R, I), R, I, n) =
    linearKernel(adicEval(M, R, I, n), adicCompletion(M, R, I), adicQuotient(M, R, I, n))
proof
  sorry

-- The induced map (AdicCompletion.map): linear, compatible with of
-- (map_of), functorial (map_comp), the identity on the identity, and
-- surjective when f is surjective
-- (AdicCompletion.map_surjective_of_mkQ_comp_surjective in the surjective case).
theorem adicMap.linear (N f : Set)
  requires linear : LinearMap(f, M, R, N)
  shows LinearMap(adicMap(M, R, I, N, f), adicCompletion(M, R, I), R,
    adicCompletion(N, R, I))
proof
  sorry

theorem adicMap.of (N f v : Set)
  requires linear : LinearMap(f, M, R, N)
  requires vector : v ∈ M.carrier
  shows adicMap(M, R, I, N, f)(adicOf(M, R, I)(v)) = adicOf(N, R, I)(f(v))
proof
  sorry

theorem adicMap.compose (N P f g : Set)
  requires first : LinearMap(f, M, R, N)
  requires second : LinearMap(g, N, R, P)
  shows adicMap(M, R, I, P, compose(g, f, M.carrier, Module.carrier(N),
      Module.carrier(P))) =
    compose(adicMap(N, R, I, P, g), adicMap(M, R, I, N, f),
      adicCompletionCarrier(M, R, I), adicCompletionCarrier(N, R, I),
      adicCompletionCarrier(P, R, I))
proof
  sorry

theorem adicMap.surjective (N f : Set)
  requires linear : LinearMap(f, M, R, N)
  requires surjective : SurjectiveBetween(f, M.carrier, Module.carrier(N))
  shows SurjectiveBetween(adicMap(M, R, I, N, f), adicCompletionCarrier(M, R, I),
    adicCompletionCarrier(N, R, I))
proof
  sorry

-- A linear equivalence induces one (AdicCompletion.ofLinearEquiv).
theorem adicMap.equiv (N f : Set)
  requires equiv : LinearEquiv(f, M, R, N)
  shows LinearEquiv(adicMap(M, R, I, N, f), adicCompletion(M, R, I), R,
    adicCompletion(N, R, I))
proof
  sorry

-- For a finite module the base change of M to the completion of R maps
-- onto the completion of M (AdicCompletion.ofTensorProduct_surjective_of_finite),
-- and bijectively over a Noetherian ring
-- (ofTensorProduct_bijective_of_finite_of_isNoetherian); stated as the
-- existence of the comparison map with those properties.
theorem adicCompletion.tensor_comparison
  requires finite : FinitelyGeneratedModule(M, R)
  shows ∃ φ, LinearMap(φ, restrictedModule(adicCompletionAlgebra(R, I),
      baseChange(adicCompletionAlgebra(R, I), M)), R, adicCompletion(M, R, I)) ∧
    SurjectiveBetween(φ, Module.carrier(baseChange(adicCompletionAlgebra(R, I), M)),
      adicCompletionCarrier(M, R, I)) ∧
    (NoetherianRing(R) → BijectiveBetween(φ,
      Module.carrier(baseChange(adicCompletionAlgebra(R, I), M)),
      adicCompletionCarrier(M, R, I)))
proof
  sorry

-- The Krull intersection theorem: a finite module over a Noetherian ring
-- with I in the Jacobson radical is I-adically Hausdorff
-- (Ideal.iInf_pow_smul_eq_bot_of_le_jacobson, iInf_pow_eq_bot_of_isLocalRing).
theorem adicHausdorff.krull
  requires noetherian : NoetherianRing(R)
  requires finite : FinitelyGeneratedModule(M, R)
  requires jacobson : I ⊆ jacobsonRadical(R, {R.zero})
  shows AdicHausdorff(M, R, I)
proof
  sorry

end Completion

-- Helper (completion track): Iⁿ R = Iⁿ for R as a module over itself.
theorem cplHelp.self_adic (R I : Set) (n : Nat)
  requires comm : CommRing(R)
  requires ideal : Ideal(R, I)
  shows adicSubmodule(selfModule(R), R, I, n) = idealPow(R, I, n)
proof
  have ringR := CommRing.to_ring with comm
  have sm := Ring.to_module at R with ringR
  have pw := idealPow.ideal at R, I, n with comm, ideal
  have wi := Ideal.whole at R with ringR
  unfold adicSubmodule
  rw (selfModule.carrier_eq at R)
  rw (idealSmul.self_module at R, selfModule(R), idealPow(R, I, n), R.carrier with comm, sm, pw, wi)
  exact idealProduct.whole at R, idealPow(R, I, n) with comm, pw

-- Helpers (completion track): the geometric sums Σ_{k<n} xᵏ, their
-- telescoping (1 − x) Σ_{k<n} xᵏ = 1 − xⁿ, and their I-adic closeness.
def cplHelp.geomSum (R x : Set, n : Nat) → Set
  | R, x, zero => Ring.zero(R)
  | R, x, succ(k) => call2(Ring.add(R), cplHelp.geomSum(R, x, k), Ring.pow(R, x, k))

theorem cplHelp.geomSum_mem (R x : Set) (n : Nat)
  requires comm : CommRing(R)
  requires point : x ∈ Ring.carrier(R)
  shows cplHelp.geomSum(R, x, n) ∈ Ring.carrier(R)
proof
  induction n
  | zero =>
    rw cplHelp.geomSum
    typecheck
  | succ(k) using ih =>
    rw cplHelp.geomSum
    have p := Ring.pow_mem at R, x, k with point, (CommRing.to_ring with comm)
    typecheck

theorem cplHelp.geomSum_telescope (R x : Set) (n : Nat)
  requires comm : CommRing(R)
  requires point : x ∈ Ring.carrier(R)
  shows call2(Ring.mul(R), Ring.sub(R, Ring.one(R), x), cplHelp.geomSum(R, x, n)) =
    Ring.sub(R, Ring.one(R), Ring.pow(R, x, n))
proof
  induction n
  | zero =>
    rw cplHelp.geomSum
    rw (Ring.pow_zero at R, x with point, (CommRing.to_ring with comm))
    ring
  | succ(k) using ih =>
    have s := cplHelp.geomSum_mem at R, x, k with comm, point
    have p := Ring.pow_mem at R, x, k with point, (CommRing.to_ring with comm)
    have same : succ(k) = k + 1 by arith
    rw cplHelp.geomSum
    rw same
    rw (Ring.pow_succ at R, x, k with point, (CommRing.to_ring with comm))
    linear_combination ih

theorem cplHelp.geomSum_close (R I x : Set) (m e : Nat)
  requires comm : CommRing(R)
  requires ideal : Ideal(R, I)
  requires member : x ∈ I
  shows Ring.sub(R, cplHelp.geomSum(R, x, m + e), cplHelp.geomSum(R, x, m)) ∈
    idealPow(R, I, m)
proof
  induction e
  | zero =>
    have xR := (Ideal.subset at R, I with ideal) with x, member
    have s := cplHelp.geomSum_mem at R, x, m with comm, xR
    have pw := idealPow.ideal at R, I, m with comm, ideal
    have same : m + 0 = m by arith
    rw same
    have z : Ring.sub(R, cplHelp.geomSum(R, x, m), cplHelp.geomSum(R, x, m)) = Ring.zero(R) by ring
    rw z
    exact Ideal.zero_mem at R, idealPow(R, I, m) with pw
  | succ(k) using ih =>
    have xR := (Ideal.subset at R, I with ideal) with x, member
    have s1 := cplHelp.geomSum_mem at R, x, m + k with comm, xR
    have s0 := cplHelp.geomSum_mem at R, x, m with comm, xR
    have p := Ring.pow_mem at R, x, m + k with xR, (CommRing.to_ring with comm)
    have pw := idealPow.ideal at R, I, m with comm, ideal
    have same : m + succ(k) = succ(m + k) by arith
    rw same
    rw cplHelp.geomSum
    have pk := idealPow.pow_mem at R, I, x, m + k with comm, ideal, member
    have anti := idealPow.antitone_add at R, I, m, k with comm, ideal
    have pm := anti with Ring.pow(R, x, m + k), pk
    have eq : Ring.sub(R, call2(Ring.add(R), cplHelp.geomSum(R, x, m + k), Ring.pow(R, x, m + k)), cplHelp.geomSum(R, x, m)) = call2(Ring.add(R), Ring.sub(R, cplHelp.geomSum(R, x, m + k), cplHelp.geomSum(R, x, m)), Ring.pow(R, x, m + k)) by ring
    rw eq
    exact Ideal.add_mem at R, idealPow(R, I, m), Ring.sub(R, cplHelp.geomSum(R, x, m + k), cplHelp.geomSum(R, x, m)), Ring.pow(R, x, m + k) with pw, ih, pm

defgraph cplHelp.geomSeq (R x : Set) (n ∈ ℕ) : Ring.carrier(R) :=
  cplHelp.geomSum(R, x, n)
requires comm : CommRing(R)
requires point : x ∈ Ring.carrier(R)
proof
  have nNat := nat.omega.backward with member
  exact cplHelp.geomSum_mem at R, x, n with comm, point

-- Helper (completion track): in a complete ring 1 − x is a unit for
-- x ∈ I, with inverse the limit of the geometric sums.
theorem cplHelp.one_sub_unit (R I x : Set)
  requires complete : AdicCompleteRing(R, I)
  requires ideal : Ideal(R, I)
  requires member : x ∈ I
  shows RingUnit(R, Ring.sub(R, Ring.one(R), x))
proof
  obtain ⟨comm, haus, pre⟩ := complete
  have ringR := CommRing.to_ring with comm
  have xR := (Ideal.subset at R, I with ideal) with x, member
  have F := cplHelp.geomSeq.function at R, x with comm, xR
  rw ← (selfModule.carrier_eq at R) at F
  have negEq : Module.neg(selfModule(R)) = Ring.neg(R)
    unfold selfModule
    module_projections
  have addEq := selfModule.add_eq at R
  have cauchy : ∀ m ∈ ℕ, ∀ n ∈ ℕ, m ≤ n → call2(Module.add(selfModule(R)), cplHelp.geomSeq(R, x)(m), apply(Module.neg(selfModule(R)), cplHelp.geomSeq(R, x)(n))) ∈ adicSubmodule(selfModule(R), R, I, m)
    intros m hm n hn le
    have mNat := nat.omega.backward with hm
    have nNat := nat.omega.backward with hn
    rw [addEq, negEq]
    rw (cplHelp.self_adic at R, I, m with comm, ideal)
    rw (cplHelp.geomSeq.value at R, x, m with comm, xR)
    rw (cplHelp.geomSeq.value at R, x, n with comm, xR)
    obtain ⟨d, dNat, nd⟩ := LessEqual.exists_add at m, n with le
    have close := cplHelp.geomSum_close at R, I, x, m, d with comm, ideal, member
    rw ← nd at close
    have pw := idealPow.ideal at R, I, m with comm, ideal
    have ng := Ideal.neg_mem at R, idealPow(R, I, m), Ring.sub(R, cplHelp.geomSum(R, x, n), cplHelp.geomSum(R, x, m)) with close, pw
    have sm := cplHelp.geomSum_mem at R, x, m with comm, xR
    have sn := cplHelp.geomSum_mem at R, x, n with comm, xR
    have eq : call2(Ring.add(R), cplHelp.geomSum(R, x, m), apply(Ring.neg(R), cplHelp.geomSum(R, x, n))) = apply(Ring.neg(R), Ring.sub(R, cplHelp.geomSum(R, x, n), cplHelp.geomSum(R, x, m))) by ring
    rw eq
    exact ng
  obtain ⟨_, _, limits⟩ := pre
  obtain ⟨L, LIn, lim⟩ := limits with cplHelp.geomSeq(R, x), F, cauchy
  rw (selfModule.carrier_eq at R) at LIn
  obtain ⟨_, _, sep⟩ := haus
  have zIn : Ring.sub(R, call2(Ring.mul(R), Ring.sub(R, Ring.one(R), x), L), Ring.one(R)) ∈ Module.carrier(selfModule(R))
    rw (selfModule.carrier_eq at R)
    typecheck
  have all : ∀ n ∈ ℕ, Ring.sub(R, call2(Ring.mul(R), Ring.sub(R, Ring.one(R), x), L), Ring.one(R)) ∈ adicSubmodule(selfModule(R), R, I, n)
    intros n hn
    have nNat := nat.omega.backward with hn
    have ln := lim with n, hn
    rw [addEq, negEq] at ln
    rw (cplHelp.self_adic at R, I, n with comm, ideal) at ln
    rw (cplHelp.geomSeq.value at R, x, n with comm, xR) at ln
    rw (cplHelp.self_adic at R, I, n with comm, ideal)
    have pw := idealPow.ideal at R, I, n with comm, ideal
    have pn := idealPow.pow_mem at R, I, x, n with comm, ideal, member
    have tel := cplHelp.geomSum_telescope at R, x, n with comm, xR
    have sn := cplHelp.geomSum_mem at R, x, n with comm, xR
    have p := Ring.pow_mem at R, x, n with xR, ringR
    have pw2 := pw
    obtain ⟨_, _, _, negC, mulC⟩ := pw2
    have uR : Ring.sub(R, Ring.one(R), x) ∈ Ring.carrier(R) by typecheck
    have t1 := (mulC with Ring.sub(R, Ring.one(R), x), uR, call2(Ring.add(R), L, apply(Ring.neg(R), cplHelp.geomSum(R, x, n))), ln).left
    have t2 := negC with Ring.pow(R, x, n), pn
    have sum := Ideal.add_mem at R, idealPow(R, I, n), call2(Ring.mul(R), Ring.sub(R, Ring.one(R), x), call2(Ring.add(R), L, apply(Ring.neg(R), cplHelp.geomSum(R, x, n)))), apply(Ring.neg(R), Ring.pow(R, x, n)) with t1, t2, pw
    have eq : Ring.sub(R, call2(Ring.mul(R), Ring.sub(R, Ring.one(R), x), L), Ring.one(R)) = call2(Ring.add(R), call2(Ring.mul(R), Ring.sub(R, Ring.one(R), x), call2(Ring.add(R), L, apply(Ring.neg(R), cplHelp.geomSum(R, x, n)))), apply(Ring.neg(R), Ring.pow(R, x, n)))
      linear_combination tel
    rw eq
    exact sum
  have z := sep with Ring.sub(R, call2(Ring.mul(R), Ring.sub(R, Ring.one(R), x), L), Ring.one(R)), zIn, all
  rw (selfModule.zero_eq at R) at z
  have uR : Ring.sub(R, Ring.one(R), x) ∈ Ring.carrier(R) by typecheck
  have e1 : call2(Ring.mul(R), Ring.sub(R, Ring.one(R), x), L) = Ring.one(R)
    linear_combination z
  have e2 : call2(Ring.mul(R), L, Ring.sub(R, Ring.one(R), x)) = Ring.one(R)
    linear_combination z
  unfold RingUnit
  exact ⟨uR, L, LIn, e1, e2⟩

-- Section: The completion of a ring and complete rings
section CompleteRings
variable (R I : Set)
hypothesis comm : CommRing(R)
hypothesis ideal : Ideal(R, I)

-- The completion of R is a commutative ring and an R-algebra with
-- structure map of; each eval is a surjective ring homomorphism onto
-- R ⧸ Iⁿ (AdicCompletion.evalₐ, evalOneₐ, AdicCompletion.ext_evalₐ).
theorem adicCompletionRing.comm_ring
  shows CommRing(adicCompletionRing(R, I))
proof
  sorry

theorem adicCompletionAlgebra.algebra
  shows Algebra(adicCompletionAlgebra(R, I))
proof
  sorry

theorem adicEval.ring_hom (n : Nat)
  shows RingHom(adicEval(selfModule(R), R, I, n), adicCompletionRing(R, I),
    adicRingQuotient(R, I, n))
proof
  sorry

-- The quotients agree: R ⧸ Iⁿ as a ring has the classes of R ⧸ Iⁿ R as a
-- module.
theorem adicRingQuotient.carrier (n : Nat)
  shows Ring.carrier(adicRingQuotient(R, I, n)) =
    Module.carrier(adicQuotient(selfModule(R), R, I, n))
proof
  sorry

-- AdicCompletion.liftRingHom: a compatible family of homomorphisms
-- g(n) : S → R ⧸ Iⁿ is one homomorphism S → completion, unique.
theorem adicCompletionRing.lift (S g : Set)
  requires source : CommRing(S)
  requires homs : ∀ n ∈ ℕ, RingHom(g(n), S, quotientRing(R, idealPow(R, I, n)))
  requires compatible : ∀ m ∈ ℕ, ∀ n ∈ ℕ, m ≤ n → ∀ s ∈ S.carrier, ∀ v ∈ R.carrier,
    g(n)(s) = adicClass(selfModule(R), R, I, v, n) →
    g(m)(s) = adicClass(selfModule(R), R, I, v, m)
  shows ∃ h, RingHom(h, S, adicCompletionRing(R, I)) ∧
    (∀ n ∈ ℕ, ∀ s ∈ S.carrier, h(s)(n) = g(n)(s)) ∧
    (∀ k, RingHom(k, S, adicCompletionRing(R, I)) →
      (∀ n ∈ ℕ, ∀ s ∈ S.carrier, k(s)(n) = g(n)(s)) → k = h)
proof
  sorry

-- In a complete ring, I lies in the Jacobson radical
-- (IsAdicComplete.le_jacobson_bot), so x is a unit iff x is a unit
-- modulo I (the source's isUnit_of_dvd_sub), and 1 − x is a unit for
-- x ∈ I with inverse Σ xⁿ.
theorem AdicCompleteRing.jacobson
  requires complete : AdicCompleteRing(R, I)
  shows I ⊆ jacobsonRadical(R, {R.zero})
proof
  intros x hx
  have xR := (Ideal.subset at R, I with ideal) with x, hx
  unfold jacobsonRadical
  refine ⟨xR, ?_⟩
  intros M maxM sub0
  by_contra xM
  have parts := CommRing.parts with comm
  have mp := MaximalIdeal.parts at R, M with maxM
  obtain ⟨i, iM, a, aR, one⟩ := IsMaximalIdeal.bezout at R.carrier, R.add, R.zero, R.neg, R.mul, R.one, M, x with parts, mp, xR, xM
  have id2 := ideal
  obtain ⟨_, _, _, _, mulC⟩ := id2
  have ax := (mulC with a, aR, x, hx).left
  have unit := cplHelp.one_sub_unit at R, I, call2(R.mul, a, x) with complete, ideal, ax
  obtain ⟨_, b, bR, e1, _⟩ := unit
  have iR := (Ideal.subset at R, M with (MaximalIdeal.to_ideal at R, M with maxM)) with i, iM
  have same : Ring.sub(R, R.one, call2(R.mul, a, x)) = i
    linear_combination one
  rw same at e1
  have mi := MaximalIdeal.to_ideal at R, M with maxM
  obtain ⟨_, _, _, _, mulM⟩ := mi
  have oneM := (mulM with b, bR, i, iM).right
  rw e1 at oneM
  have proper := MaximalIdeal.to_proper at R, M with maxM
  exact proper.right with oneM

-- A unit congruent to x modulo I makes x a unit.
theorem AdicCompleteRing.unit_of_sub_mem (x y : Set)
  requires complete : AdicCompleteRing(R, I)
  requires first : x ∈ R.carrier
  requires unit : RingUnit(R, y)
  requires close : Ring.sub(R, x, y) ∈ I
  shows RingUnit(R, x)
proof
  obtain ⟨yR, v, vR, yv, vy⟩ := unit
  have id2 := ideal
  obtain ⟨_, _, _, negC, mulC⟩ := id2
  have dI := (mulC with v, vR, Ring.sub(R, x, y), close).left
  have wI := negC with call2(R.mul, v, Ring.sub(R, x, y)), dI
  have u := cplHelp.one_sub_unit at R, I, apply(R.neg, call2(R.mul, v, Ring.sub(R, x, y))) with complete, ideal, wI
  obtain ⟨_, b, bR, e1, e2⟩ := u
  have bv : call2(R.mul, b, v) ∈ R.carrier by typecheck
  have f1 : call2(R.mul, x, call2(R.mul, b, v)) = R.one
    linear_combination (call2(R.mul, y, v)) * e1 + (R.one - call2(R.mul, Ring.sub(R, x, y), call2(R.mul, b, v))) * yv
  have f2 : call2(R.mul, call2(R.mul, b, v), x) = R.one
    linear_combination (call2(R.mul, y, v)) * e1 + (R.one - call2(R.mul, Ring.sub(R, x, y), call2(R.mul, b, v))) * yv
  unfold RingUnit
  exact ⟨first, call2(R.mul, b, v), bv, f1, f2⟩

theorem AdicCompleteRing.unit_iff (x : Set)
  requires complete : AdicCompleteRing(R, I)
  requires element : x ∈ R.carrier
  shows RingUnit(R, x) ↔ RingUnit(R ⧸ I, quotientMk(R, I)(x))
proof
  have hom := quotientMk.hom at R, I with comm, ideal
  have qc := quotientRing.comm_ring_of_ideal at R, I with comm, ideal
  constructor
  . intro u
    obtain ⟨_, y, yR, xy, yx⟩ := u
    have qx : quotientMk(R, I)(x) ∈ Ring.carrier(R ⧸ I) by typecheck
    have qy : quotientMk(R, I)(y) ∈ Ring.carrier(R ⧸ I) by typecheck
    have m1 := RingHom.map_mul at quotientMk(R, I), R, R ⧸ I, x, y with element, yR, hom
    have m2 := RingHom.map_mul at quotientMk(R, I), R, R ⧸ I, y, x with yR, element, hom
    have o := RingHom.map_one with hom
    rw xy at m1
    rw yx at m2
    rw o at m1
    rw o at m2
    unfold RingUnit
    refine ⟨qx, quotientMk(R, I)(y), qy, ?_, ?_⟩
    . symm
      exact m1
    . symm
      exact m2
  . intro u
    obtain ⟨_, b, bQ, e1, _⟩ := u
    have surj := quotientMk.surjective at R, I with comm, ideal
    obtain ⟨fn, onto⟩ := surj
    obtain ⟨y, yR, rel⟩ := onto with b, bQ
    have by := FunctionBetween.apply_value with fn, yR, rel
    rw ← by at e1
    have xyR : call2(R.mul, x, y) ∈ R.carrier by typecheck
    have m1 := RingHom.map_mul at quotientMk(R, I), R, R ⧸ I, x, y with element, yR, hom
    rw ← m1 at e1
    have close := (quotientMk.eq_one_iff at R, I, call2(R.mul, x, y) with comm, ideal, xyR).forward with e1
    have oneR : R.one ∈ R.carrier by typecheck
    have u1 : RingUnit(R, R.one)
      have o1 : call2(R.mul, R.one, R.one) = R.one by ring
      unfold RingUnit
      exact ⟨oneR, R.one, oneR, o1, o1⟩
    have uxy := AdicCompleteRing.unit_of_sub_mem at R, I, call2(R.mul, x, y), R.one with comm, ideal, complete, xyR, u1, close
    obtain ⟨_, w, wR, f1, f2⟩ := uxy
    have ywR : call2(R.mul, y, w) ∈ R.carrier by typecheck
    have g1 : call2(R.mul, x, call2(R.mul, y, w)) = R.one
      linear_combination f1
    have g2 : call2(R.mul, call2(R.mul, y, w), x) = R.one
      linear_combination f1
    unfold RingUnit
    exact ⟨element, call2(R.mul, y, w), ywR, g1, g2⟩

-- Elements agreeing modulo every Iⁿ are equal (the source's
-- eq_of_forall_pow_dvd_sub, IsHausdorff.haus).
theorem AdicCompleteRing.eq_of_close (x y : Set)
  requires hausdorff : AdicHausdorff(selfModule(R), R, I)
  requires first : x ∈ R.carrier
  requires second : y ∈ R.carrier
  requires close : ∀ n ∈ ℕ, Ring.sub(R, x, y) ∈ idealPow(R, I, n)
  shows x = y
proof
  obtain ⟨_, _, haus⟩ := hausdorff
  have dIn : Ring.sub(R, x, y) ∈ Module.carrier(selfModule(R))
    rw (selfModule.carrier_eq at R)
    typecheck
  have all : ∀ n ∈ ℕ, Ring.sub(R, x, y) ∈ adicSubmodule(selfModule(R), R, I, n)
    intros n hn
    have nNat := nat.omega.backward with hn
    rw (cplHelp.self_adic at R, I, n with comm, ideal)
    exact close with n, hn
  have z := haus with Ring.sub(R, x, y), dIn, all
  rw (selfModule.zero_eq at R) at z
  linear_combination z

-- Hensel's lemma: a complete pair is Henselian
-- (IsAdicComplete.henselianRing); a complete local ring is a Henselian
-- local ring (complete for its maximal ideal).
theorem AdicCompleteRing.henselian
  requires complete : AdicCompleteRing(R, I)
  shows HenselianPair(R, I)
proof
  sorry

theorem AdicCompleteRing.henselian_local
  requires localRing : LocalRing(R)
  requires complete : AdicCompleteRing(R, localMaximalIdeal(R))
  shows HenselianLocalRing(R)
proof
  sorry

-- The quantitative Hensel lemma (Newton's method): in a complete ring
-- with f monic, f(a₀) ∈ Iⁿ and f'(a₀) a unit, the root a with
-- a − a₀ ∈ Iⁿ exists and is unique among a ≡ a₀ mod I.
theorem AdicCompleteRing.hensel (f a₀ : Set) (n : Nat)
  requires complete : AdicCompleteRing(R, I)
  requires monic : PolyMonic(R, f)
  requires point : a₀ ∈ R.carrier
  requires positive : 0 < n
  requires small : polyEval(R, f, a₀) ∈ idealPow(R, I, n)
  requires simple : RingUnit(R, polyEval(R, polyDerivative(R)(f), a₀))
  shows ∃ a ∈ R.carrier, PolyIsRoot(R, f, a) ∧ Ring.sub(R, a, a₀) ∈ idealPow(R, I, n) ∧
    (∀ b ∈ R.carrier, PolyIsRoot(R, f, b) → Ring.sub(R, b, a₀) ∈ I → b = a)
proof
  sorry

-- Henselian local rings: the residue map gives a bijection between the
-- simple roots of a monic f and the simple roots of its reduction
-- (HenselianLocalRing.is_henselian, with uniqueness of the lift).
theorem HenselianLocalRing.lift_root (f a₀ : Set)
  requires henselian : HenselianLocalRing(R)
  requires monic : PolyMonic(R, f)
  requires point : a₀ ∈ R.carrier
  requires root : polyEval(R, f, a₀) ∈ localMaximalIdeal(R)
  requires simple : RingUnit(R, polyEval(R, polyDerivative(R)(f), a₀))
  shows ∃ a ∈ R.carrier, PolyIsRoot(R, f, a) ∧
    Ring.sub(R, a, a₀) ∈ localMaximalIdeal(R) ∧
    (∀ b ∈ R.carrier, PolyIsRoot(R, f, b) →
      Ring.sub(R, b, a₀) ∈ localMaximalIdeal(R) → b = a)
proof
  sorry

-- A quotient of a Henselian local ring is Henselian, and a finite local
-- algebra over a Henselian local ring is Henselian
-- (HenselianLocalRing of surjective images).
theorem HenselianLocalRing.quotient (J : Set)
  requires henselian : HenselianLocalRing(R)
  requires proper : ProperIdeal(R, J)
  shows HenselianLocalRing(R ⧸ J)
proof
  sorry

-- A local ring complete for a finitely generated ideal inside its maximal
-- ideal is Henselian.
theorem HenselianLocalRing.of_complete (J : Set)
  requires localRing : LocalRing(R)
  requires inside : J ⊆ localMaximalIdeal(R)
  requires complete : AdicCompleteRing(R, J)
  requires residue : HenselianLocalRing(R ⧸ J)
  shows HenselianLocalRing(R)
proof
  sorry

end CompleteRings

-- A complete DVR-like statement used for ℤ_p and its extensions: for a
-- principal ideal (π), completeness is about divisibility by powers of π
-- (the source's smodEq_span_pow_iff_dvd).
theorem adicSubmodule.principal_iff (R π x : Set) (n : Nat)
  requires comm : CommRing(R)
  requires generator : π ∈ Ring.carrier(R)
  requires element : x ∈ Ring.carrier(R)
  shows x ∈ adicSubmodule(selfModule(R), R, ringMultiples(R, π), n) ↔
    RingDvd(R, Ring.pow(R, π, n), x)
proof
  have pw := Ring.pow_mem at R, π, n with generator, (CommRing.to_ring with comm)
  have mi := ringMultiples.ideal at R, π with generator, comm
  rw (cplHelp.self_adic at R, ringMultiples(R, π), n with comm, mi)
  rw (idealPow.multiples at R, π, n with generator, comm)
  exact ringMultiples.mem_iff at R, Ring.pow(R, π, n), x with pw, element, comm
