-- Flat modules and algebras, and the infinitesimal lifting properties:
-- flatness as preservation of injectivity by − ⊗ M (Mathlib's
-- Module.Flat, through Module.Flat.rTensor_preserves_injective_linearMap
-- and the ideal criterion), flatness of free modules, of localizations
-- and under base change and towers; formally smooth, formally unramified
-- and formally étale algebras (lifting along square-zero extensions);
-- smooth, unramified and étale algebras (with finite presentation or
-- finite type); standard smooth algebras of a relative dimension through
-- a Jacobian; and the lifting of formally smooth algebras to complete
-- rings. Kähler differentials are not stated.
-- Part of the GRH blueprint.
-- Planned home: Algebra/Module/Flat and Algebra/Ring/Etale.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Algebra.Flat
import GRH.Algebra.Completion
import Grace.Cumulus.Algebra.Algebras.Quotient

-- Section: Flat modules and algebras
-- M is flat over R when f ⊗ id_M is injective for every injective linear
-- map f : N → P (Module.Flat, by rTensor_preserves_injective_linearMap;
-- Mathlib defines it by the ideal criterion, which flat.iff_ideals
-- states).
predicate FlatModule (M R : Set) :=
  Module(M, R) ∧
  (∀ N, ∀ P, ∀ f, LinearMap(f, N, R, P) →
    InjectiveBetween(f, Module.carrier(N), Module.carrier(P)) →
    InjectiveBetween(rightTensor(N, R, M, P, f), Module.carrier(tensorProduct(N, R, M)),
      Module.carrier(tensorProduct(P, R, M))))

-- A flat algebra: flat as a module over the base (Algebra.Flat, Module.Flat R A).
predicate FlatAlgebra (A : Set) :=
  Algebra(A) ∧ FlatModule(algebraModule(A), Algebra.base(A))

-- A faithfully flat module: flat, and M ⊗ N = 0 only for N = 0
-- (Module.FaithfullyFlat).
predicate FaithfullyFlatModule (M R : Set) :=
  FlatModule(M, R) ∧
  (∀ N, Module(N, R) → Module.carrier(tensorProduct(N, R, M)) =
    {Module.zero(tensorProduct(N, R, M))} → Module.carrier(N) = {Module.zero(N)})

-- The inclusion I → R of an ideal and the multiplication map
-- I ⊗ M → M, r ⊗ m ↦ r m (the map of the ideal criterion).
def idealMultiplicationMap (M R I : Set) : Set :=
  tensorLift(submoduleModule(selfModule(R), R, I), R, M, M,
    restrict(Module.smul(M), I × Module.carrier(M)))

-- Section: Infinitesimal lifting
-- A square-zero ideal: J² = 0.
predicate SquareZeroIdeal (B J : Set) :=
  Ideal(Algebra.ring(B), J) ∧ idealProduct(Algebra.ring(B), J, J) =
    {Ring.zero(Algebra.ring(B))}

-- A lift of g : A → B ⧸ J through B → B ⧸ J.
predicate LiftsThrough (A B J g h : Set) :=
  AlgebraHom(h, A, B) ∧ (∀ a ∈ algebraCarrier(A), algebraProjection(B, J)(h(a)) = g(a))

-- Formally smooth: every R-algebra map A → B ⧸ J, J² = 0, lifts to B
-- (Algebra.FormallySmooth); formally unramified: at most one lift
-- (Algebra.FormallyUnramified); formally étale: exactly one
-- (Algebra.FormallyEtale). The quantifier over R-algebras B ranges over
-- sets.
predicate FormallySmooth (A : Set) :=
  Algebra(A) ∧ (∀ B, ∀ J, ∀ g, Algebra(B) → Algebra.base(B) = Algebra.base(A) →
    SquareZeroIdeal(B, J) → AlgebraHom(g, A, quotientAlgebra(B, J)) →
    (∃ h, LiftsThrough(A, B, J, g, h)))

predicate FormallyUnramified (A : Set) :=
  Algebra(A) ∧ (∀ B, ∀ J, ∀ g, ∀ h, ∀ k, Algebra(B) → Algebra.base(B) = Algebra.base(A) →
    SquareZeroIdeal(B, J) → AlgebraHom(g, A, quotientAlgebra(B, J)) →
    LiftsThrough(A, B, J, g, h) → LiftsThrough(A, B, J, g, k) → h = k)

predicate FormallyEtale (A : Set) := FormallySmooth(A) ∧ FormallyUnramified(A)

-- Smooth, unramified, étale (Algebra.Smooth, Algebra.Unramified,
-- Algebra.Etale).
predicate SmoothAlgebra (A : Set) := FormallySmooth(A) ∧ FinitePresentationAlgebra(A)

predicate UnramifiedAlgebra (A : Set) := FormallyUnramified(A) ∧ FiniteTypeAlgebra(A)

predicate EtaleAlgebra (A : Set) := FormallyEtale(A) ∧ FinitePresentationAlgebra(A)

-- Section: Standard smooth algebras
-- The Jacobian (∂fᵢ/∂X_{n + j})_{i, j < k} of relations f : k → R[n + k],
-- evaluated in A through the presentation map φ, as a matrix over A.
def jacobianMatrix (A n k f φ : Set) : Set :=
  { u ∈ (k × k) × algebraCarrier(A) | ∃ i ∈ k, ∃ j ∈ k, ∃ c ∈ ℕ,
    c = n + j ∧ u = ((i, j),
      φ(partialDerivative(Algebra.base(A), n + k, c)(f(i)))) }

-- A is standard smooth of relative dimension n: A ≅ R[X₀, …, X_{n+k−1}] ⧸
-- (f₀, …, f_{k−1}) with the k × k Jacobian in the last k variables
-- invertible in A (Algebra.IsStandardSmoothOfRelativeDimension,
-- through a submersive presentation).
predicate StandardSmooth (A : Set, n : Nat) :=
  Algebra(A) ∧ (∃ k ∈ ℕ, ∃ f, ∃ φ,
    (f : k → Ring.carrier(polynomialRing(Algebra.base(A), n + k))) ∧
    AlgebraHom(φ, polynomialAlgebra(Algebra.base(A), n + k), A) ∧
    SurjectiveBetween(φ, Ring.carrier(polynomialRing(Algebra.base(A), n + k)),
      algebraCarrier(A)) ∧
    ringKernel(φ, Ring.carrier(polynomialRing(Algebra.base(A), n + k)),
      Ring.zero(Algebra.ring(A))) =
      generatedIdeal(polynomialRing(Algebra.base(A), n + k),
        functionImage(f, k, Ring.carrier(polynomialRing(Algebra.base(A), n + k)))) ∧
    RingUnit(Algebra.ring(A), matDet(Algebra.ring(A), k,
      jacobianMatrix(A, n, k, f, φ))))

-- Families used below: the i-th row of a matrix and the column weights
-- rᵢ aᵢⱼ.
def rowSlice (R n m a i : Set) : Set :=
  { u ∈ m × Ring.carrier(R) | ∃ j ∈ m, u = (j, a((i, j))) }

def columnWeights (R n m r a j : Set) : Set :=
  { u ∈ n × Ring.carrier(R) | ∃ i ∈ n, u = (i, call2(Ring.mul(R), r(i), a((i, j)))) }

-- Section: Laws of flatness
section Flatness
variable (R : Set)
hypothesis comm : CommRing(R)

-- The ideal criterion (Module.Flat.iff_rTensor_injective', Mathlib's
-- definition of Module.Flat): M is flat iff I ⊗ M → M is injective for
-- every finitely generated ideal I.
theorem FlatModule.iff_ideals (M : Set)
  requires module : Module(M, R)
  shows FlatModule(M, R) ↔
    (∀ I, FinitelyGeneratedIdeal(R, I) →
      InjectiveBetween(idealMultiplicationMap(M, R, I),
        Module.carrier(tensorProduct(submoduleModule(selfModule(R), R, I), R, M)),
        Module.carrier(M)))
proof
  sorry

-- Module.Flat.lTensor_preserves_injective_linearMap: the left-hand form.
theorem FlatModule.left_tensor (M N P f : Set)
  requires flat : FlatModule(M, R)
  requires linear : LinearMap(f, N, R, P)
  requires injective : InjectiveBetween(f, Module.carrier(N), Module.carrier(P))
  shows InjectiveBetween(leftTensor(M, R, N, P, f), Module.carrier(tensorProduct(M, R, N)),
    Module.carrier(tensorProduct(M, R, P)))
proof
  sorry

-- Module.Flat.rTensor_exact: tensoring with a flat module preserves exact
-- sequences.
theorem FlatModule.exact (M N P Q f g : Set)
  requires flat : FlatModule(M, R)
  requires mapF : LinearMap(f, N, R, P)
  requires mapG : LinearMap(g, P, R, Q)
  requires exact : ExactPair(f, g, N, P, Q)
  shows ExactPair(rightTensor(N, R, M, P, f), rightTensor(P, R, M, Q, g),
    tensorProduct(N, R, M), tensorProduct(P, R, M), tensorProduct(Q, R, M))
proof
  sorry

-- R is flat over itself; free modules are flat (Module.Flat.of_free),
-- and so are direct summands and products of two flat modules
-- (Module.Flat.of_retract, Module.Flat.prod).
theorem FlatModule.self
  shows FlatModule(selfModule(R), R)
proof
  sorry

theorem FlatModule.of_free (M : Set)
  requires free : FreeModule(M, R)
  shows FlatModule(M, R)
proof
  sorry

theorem FlatModule.product (M N : Set)
  requires first : FlatModule(M, R)
  requires second : FlatModule(N, R)
  shows FlatModule(productModule(M, R, N), R)
proof
  sorry

theorem FlatModule.of_retract (M N i p : Set)
  requires flat : FlatModule(N, R)
  requires inclusion : LinearMap(i, M, R, N)
  requires projection : LinearMap(p, N, R, M)
  requires retract : ∀ v ∈ Module.carrier(M), p(i(v)) = v
  shows FlatModule(M, R)
proof
  sorry

-- Flatness and torsion: over a domain a flat module is torsion-free, and
-- over a PID (more generally a Bézout domain) torsion-free implies flat
-- (Module.Flat.flat_iff_torsion_eq_bot_of_isBezout).
theorem FlatModule.torsion_free (M r v : Set)
  requires domain : IntegralDomain(R)
  requires flat : FlatModule(M, R)
  requires scalar : r ∈ R.carrier
  requires nonzero : r ≠ R.zero
  requires vector : v ∈ Module.carrier(M)
  requires kills : call2(Module.smul(M), r, v) = Module.zero(M)
  shows v = Module.zero(M)
proof
  sorry

theorem FlatModule.iff_torsion_free_pid (M : Set)
  requires pid : PrincipalIdealDomain(R)
  requires module : Module(M, R)
  shows FlatModule(M, R) ↔
    (∀ r ∈ R.carrier, ∀ v ∈ Module.carrier(M), r ≠ R.zero →
      call2(Module.smul(M), r, v) = Module.zero(M) → v = Module.zero(M))
proof
  sorry

-- The equational criterion (Module.Flat.isTrivialRelation_of_sum_smul_eq_zero):
-- a relation Σ rᵢ vᵢ = 0 in a flat module is a consequence of relations
-- in R: vᵢ = Σⱼ aᵢⱼ wⱼ with Σᵢ rᵢ aᵢⱼ = 0.
theorem FlatModule.equational (M n r v : Set)
  requires flat : FlatModule(M, R)
  requires natural : Nat(n)
  requires scalars : r : n → R.carrier
  requires vectors : v : n → Module.carrier(M)
  requires relation : moduleCombination(M, R, n, r, v) = Module.zero(M)
  shows ∃ m, Nat(m) ∧ ∃ a, ∃ w, (a : n × m → R.carrier) ∧
    (w : m → Module.carrier(M)) ∧
    (∀ i ∈ n, v(i) = moduleCombination(M, R, m, rowSlice(R, n, m, a, i), w)) ∧
    (∀ j ∈ m, finiteRingSum(n, R.carrier, R.add, R.zero, R.neg, R.mul, R.one,
      columnWeights(R, n, m, r, a, j)) = R.zero)
proof
  sorry

-- Localizations are flat (IsLocalization.flat, Localization.flat).
theorem FlatAlgebra.localization (S A : Set)
  requires localization : IsLocalization(S, A)
  requires base : Algebra.base(A) = R
  shows FlatAlgebra(A)
proof
  sorry

-- The completion of a Noetherian ring is flat (AdicCompletion.flat_of_isNoetherian).
theorem FlatAlgebra.completion (I : Set)
  requires noetherian : NoetherianRing(R)
  requires ideal : Ideal(R, I)
  shows FlatAlgebra(adicCompletionAlgebra(R, I))
proof
  sorry

-- Polynomial algebras are flat (free on the monomials).
theorem FlatAlgebra.polynomial (I : Set)
  shows FlatAlgebra(polynomialAlgebra(R, I))
proof
  sorry

end Flatness

-- Base change and towers (Module.Flat.baseChange, Module.Flat.trans).
theorem FlatModule.base_change (A M : Set)
  requires algebra : Algebra(A)
  requires flat : FlatModule(M, Algebra.base(A))
  shows FlatModule(baseChange(A, M), Algebra.ring(A))
proof
  sorry

theorem FlatModule.trans (A M : Set)
  requires flatA : FlatAlgebra(A)
  requires flatM : FlatModule(M, Algebra.ring(A))
  shows FlatModule(restrictedModule(A, M), Algebra.base(A))
proof
  sorry

-- RingHom.Flat.comp: flatness of algebras composes in towers.
theorem FlatAlgebra.trans (A B : Set)
  requires first : FlatAlgebra(A)
  requires second : FlatAlgebra(B)
  requires tower : Algebra.base(B) = Algebra.ring(A)
  shows FlatAlgebra(Algebra.mk(Algebra.base(A), Algebra.ring(B),
    compose(Algebra.map(B), Algebra.map(A), Ring.carrier(Algebra.base(A)),
      algebraCarrier(A), algebraCarrier(B))))
proof
  sorry

-- Section: Laws of the lifting properties
section Lifting
variable (A : Set)
hypothesis algebra : Algebra(A)

-- Étale is formally étale and finitely presented; it is smooth and
-- unramified (Algebra.Etale.toSmooth...), and étale is flat and
-- unramified, and conversely for a finitely presented algebra
-- (RingHom.Etale.iff_flat_and_formallyUnramified, Algebra.Smooth.flat).
theorem EtaleAlgebra.smooth
  requires etale : EtaleAlgebra(A)
  shows SmoothAlgebra(A) ∧ UnramifiedAlgebra(A)
proof
  obtain ⟨fe, fp⟩ := etale
  obtain ⟨fs, fu⟩ := fe
  have ft := FinitePresentationAlgebra.finite_type at A with algebra, fp
  unfold SmoothAlgebra
  unfold UnramifiedAlgebra
  exact ⟨⟨fs, fp⟩, ⟨fu, ft⟩⟩

theorem SmoothAlgebra.flat
  requires smooth : SmoothAlgebra(A)
  shows FlatAlgebra(A)
proof
  sorry

theorem EtaleAlgebra.iff_flat_unramified
  requires presented : FinitePresentationAlgebra(A)
  shows EtaleAlgebra(A) ↔ FlatAlgebra(A) ∧ FormallyUnramified(A)
proof
  sorry

-- Étale is standard smooth of relative dimension 0
-- (Algebra.Etale.iff_isStandardSmoothOfRelativeDimension_zero), and a
-- standard smooth algebra is smooth (IsStandardSmooth.smooth); a smooth
-- algebra is locally standard smooth (stated in the global form for the
-- relative dimension of a standard presentation).
theorem EtaleAlgebra.iff_standard_smooth_zero
  shows EtaleAlgebra(A) ↔ StandardSmooth(A, 0)
proof
  sorry

theorem StandardSmooth.smooth (n : Nat)
  requires standard : StandardSmooth(A, n)
  shows SmoothAlgebra(A)
proof
  sorry

-- Polynomial algebras in finitely many variables are smooth, standard of
-- relative dimension the number of variables.
theorem StandardSmooth.polynomial (n : Nat)
  shows StandardSmooth(polynomialAlgebra(Algebra.base(A), n), n)
proof
  sorry

-- Quotients are formally unramified (Algebra.FormallyUnramified.of_surjective,
-- quotient case), localizations formally étale
-- (Algebra.FormallyEtale.of_isLocalization).
theorem FormallyUnramified.quotient (J : Set)
  requires ideal : Ideal(Algebra.ring(A), J)
  shows FormallyUnramified(quotientAlgebra(A, J))
proof
  sorry

theorem FormallyEtale.localization (S : Set)
  requires localization : IsLocalization(S, A)
  shows FormallyEtale(A)
proof
  sorry

-- A formally unramified algebra over a field is reduced
-- (Algebra.FormallyUnramified.isReduced_of_field), when it is of finite type.
theorem FormallyUnramified.reduced_over_field
  requires field : Field(Algebra.base(A))
  requires unramified : UnramifiedAlgebra(A)
  shows ReducedRing(Algebra.ring(A))
proof
  sorry

-- Algebra.FormallySmooth.liftOfSurjective: a formally smooth A lifts along
-- any surjection B → C of R-algebras whose kernel is nilpotent.
theorem FormallySmooth.lift_nilpotent (B C p g : Set) (k : Nat)
  requires smooth : FormallySmooth(A)
  requires algebraB : Algebra(B)
  requires baseB : Algebra.base(B) = Algebra.base(A)
  requires projection : p : B →ₐ C
  requires surjective : SurjectiveBetween(p, algebraCarrier(B), algebraCarrier(C))
  requires nilpotent : idealPow(Algebra.ring(B),
    ringKernel(p, algebraCarrier(B), Ring.zero(Algebra.ring(C))), k) =
      {Ring.zero(Algebra.ring(B))}
  requires map : g : A →ₐ C
  shows ∃ h, (h : A →ₐ B) ∧ (∀ a ∈ algebraCarrier(A), p(h(a)) = g(a))
proof
  sorry

-- Algebra.FormallySmooth.exists_mkₐ_comp_eq_of_isAdicComplete: a formally
-- smooth algebra lifts to a ring complete for an ideal I from B ⧸ I.
-- The successive lifts modulo Iⁿ are chosen one after another: dependent
-- choice, so Choice.
theorem FormallySmooth.lift_complete (B I g : Set)
  requires smooth : FormallySmooth(A)
  requires algebraB : Algebra(B)
  requires baseB : Algebra.base(B) = Algebra.base(A)
  requires complete : AdicCompleteRing(Algebra.ring(B), I)
  requires map : g : A →ₐ quotientAlgebra(B, I)
  shows ∃ h, LiftsThrough(A, B, I, g, h)
proof
  sorry

-- Uniqueness of lifts for formally étale algebras to complete rings, and
-- the Hensel lifting of étale algebras through Henselian pairs is in the
-- source's own MultivariateHensel.
theorem FormallyEtale.lift_complete_unique (B I g h k : Set)
  requires etale : FormallyEtale(A)
  requires algebraB : Algebra(B)
  requires baseB : Algebra.base(B) = Algebra.base(A)
  requires complete : AdicCompleteRing(Algebra.ring(B), I)
  requires map : g : A →ₐ quotientAlgebra(B, I)
  requires first : LiftsThrough(A, B, I, g, h)
  requires second : LiftsThrough(A, B, I, g, k)
  shows h = k
proof
  sorry

end Lifting

-- Composition (Algebra.Smooth.comp, Algebra.Etale.comp, Smooth.comp) and
-- base change of the lifting properties.
theorem SmoothAlgebra.trans (A B : Set)
  requires first : SmoothAlgebra(A)
  requires second : SmoothAlgebra(B)
  requires tower : Algebra.base(B) = Algebra.ring(A)
  shows SmoothAlgebra(Algebra.mk(Algebra.base(A), Algebra.ring(B),
    compose(Algebra.map(B), Algebra.map(A), Ring.carrier(Algebra.base(A)),
      algebraCarrier(A), algebraCarrier(B))))
proof
  sorry

theorem EtaleAlgebra.trans (A B : Set)
  requires first : EtaleAlgebra(A)
  requires second : EtaleAlgebra(B)
  requires tower : Algebra.base(B) = Algebra.ring(A)
  shows EtaleAlgebra(Algebra.mk(Algebra.base(A), Algebra.ring(B),
    compose(Algebra.map(B), Algebra.map(A), Ring.carrier(Algebra.base(A)),
      algebraCarrier(A), algebraCarrier(B))))
proof
  sorry

theorem EtaleAlgebra.base_change (A B : Set)
  requires etale : EtaleAlgebra(A)
  requires algebraB : Algebra(B)
  requires sameBase : Algebra.base(B) = Algebra.base(A)
  shows EtaleAlgebra(Algebra.mk(Algebra.ring(B), algebraTensorRing(B, A),
    includeLeft(B, A)))
proof
  sorry
