-- Local rings: a nontrivial commutative ring in which a + b = 1 forces a
-- or b to be a unit (Mathlib's IsLocalRing), its maximal ideal of
-- nonunits, the residue field and the residue map, local homomorphisms
-- and the maps they induce on residue fields, quotients and localizations
-- at primes as local rings, the residue field of a prime ideal, the
-- Jacobson radical of a local ring, and Nakayama's lemma.
-- Part of the GRH blueprint.
-- Planned home: Algebra/Ring/LocalRing.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Algebra.LocalRings
import GRH.Algebra.Localization

-- Section: Local rings and residue fields
-- A local ring (IsLocalRing: Nontrivial and isUnit_or_isUnit_of_add_one).
-- The maximal ideal is defined as the set of nonunits, so no ideal is
-- chosen (IsLocalRing.maximalIdeal).
predicate LocalRing (R : Set) :=
  CommRing(R) ∧ Ring.zero(R) ≠ Ring.one(R) ∧
  (∀ a b ∈ Ring.carrier(R), call2(Ring.add(R), a, b) = Ring.one(R) →
    RingUnit(R, a) ∨ RingUnit(R, b))

def ringNonunits (R : Set) : Set := Ring.carrier(R) ∖ ringUnits(R)

def localMaximalIdeal (R : Set) : Set := ringNonunits(R)

-- The residue field R ⧸ m and the residue map R → R ⧸ m
-- (IsLocalRing.ResidueField, IsLocalRing.residue), and the residue field
-- as an R-algebra.
def residueField (R : Set) : Set := quotientRing(R, localMaximalIdeal(R))

def residueMap (R : Set) : Set := quotientMk(R, localMaximalIdeal(R))

def residueAlgebra (R : Set) : Set :=
  Algebra.mk(R, residueField(R), residueMap(R))

-- A local homomorphism reflects units (IsLocalHom), and the map it
-- induces on residue fields (IsLocalRing.ResidueField.map).
predicate LocalRingHom (f R S : Set) :=
  RingHom(f, R, S) ∧
  (∀ a ∈ Ring.carrier(R), RingUnit(S, f(a)) → RingUnit(R, a))

def residueFieldMap (f R S : Set) : Set :=
  quotientRingMap(R, S, f, localMaximalIdeal(R), localMaximalIdeal(S))

-- The residue field of a prime P of any commutative ring: the residue
-- field of the localization at P (Ideal.ResidueField), and the map from R.
def primeResidueField (R P : Set) : Set :=
  residueField(localizationAtPrime(R, P))

def primeResidueMap (R P : Set) : Set :=
  compose(residueMap(localizationAtPrime(R, P)),
    localizationMap(R, primeComplement(R, P)), Ring.carrier(R),
    Ring.carrier(localizationAtPrime(R, P)), Ring.carrier(primeResidueField(R, P)))

-- Section: Laws of local rings
section LocalLaws
variable (R : Set)
hypothesis localRing : LocalRing(R)

theorem localMaximalIdeal.mem_iff_helper (a : Set)
  shows a ∈ localMaximalIdeal(R) ↔ a ∈ R.carrier ∧ ¬RingUnit(R, a)
proof
  unfold localMaximalIdeal
  unfold ringNonunits
  constructor
  . intro h
    obtain ⟨aIn, aOut⟩ := (difference.membership at R.carrier, ringUnits(R), a).forward with h
    have nu : ¬RingUnit(R, a)
      intro u
      exact aOut with (ringUnits.membership.backward at R, a with ⟨aIn, u⟩)
    exact ⟨aIn, nu⟩
  . intro h
    obtain ⟨aIn, nu⟩ := h
    have aOut : a ∉ ringUnits(R)
      intro m
      exact nu with (ringUnits.membership.forward at R, a with m).right
    exact (difference.membership at R.carrier, ringUnits(R), a).backward with ⟨aIn, aOut⟩

theorem localMaximalIdeal.ideal
  shows Ideal(R, localMaximalIdeal(R))
proof
  obtain ⟨comm, nt, split⟩ := localRing
  have ringR := CommRing.to_ring with comm
  apply Ideal.mk at R, localMaximalIdeal(R) with ringR
  . intros z hz
    exact ((localMaximalIdeal.mem_iff_helper at R, z with localRing).forward with hz).left
  . have zeroIn : R[0] ∈ R.carrier by typecheck
    have nu : ¬RingUnit(R, R[0])
      intro u
      have nz := RingUnit.ne_zero at R, R[0] with comm, nt, u
      exact nz with rfl
    exact (localMaximalIdeal.mem_iff_helper at R, R[0] with localRing).backward with ⟨zeroIn, nu⟩
  . intros a ha b hb
    obtain ⟨aIn, anu⟩ := (localMaximalIdeal.mem_iff_helper at R, a with localRing).forward with ha
    obtain ⟨bIn, bnu⟩ := (localMaximalIdeal.mem_iff_helper at R, b with localRing).forward with hb
    have sIn : a + b ∈ R.carrier by typecheck
    have nu : ¬RingUnit(R, a + b)
      intro u
      obtain ⟨vUnit, right⟩ := ringInverse.unit at R, a + b with comm, u
      have vIn := ringInverse.mem at R, a + b with comm, u
      have avIn : a * ringInverse(R, a + b) ∈ R.carrier by typecheck
      have bvIn : b * ringInverse(R, a + b) ∈ R.carrier by typecheck
      have sum : a * ringInverse(R, a + b) + b * ringInverse(R, a + b) = R[1]
        rw ← right
        ring
      rcases split with a * ringInverse(R, a + b), avIn, b * ringInverse(R, a + b), bvIn, sum with ua | ub
      . have d := RingDvd.mul_self_right at R, a, ringInverse(R, a + b) with comm
        exact anu with (RingUnit.of_dvd_unit at R, a, a * ringInverse(R, a + b) with comm, d, ua)
      . have d := RingDvd.mul_self_right at R, b, ringInverse(R, a + b) with comm
        exact bnu with (RingUnit.of_dvd_unit at R, b, b * ringInverse(R, a + b) with comm, d, ub)
    exact (localMaximalIdeal.mem_iff_helper at R, a + b with localRing).backward with ⟨sIn, nu⟩
  . intros a ha
    obtain ⟨aIn, anu⟩ := (localMaximalIdeal.mem_iff_helper at R, a with localRing).forward with ha
    have nIn : -a ∈ R.carrier by typecheck
    have nu : ¬RingUnit(R, -a)
      intro u
      exact anu with ((RingUnit.neg at R, a with comm).forward with u)
    exact (localMaximalIdeal.mem_iff_helper at R, -a with localRing).backward with ⟨nIn, nu⟩
  . intros r hr a ha
    obtain ⟨aIn, anu⟩ := (localMaximalIdeal.mem_iff_helper at R, a with localRing).forward with ha
    have p1 : r * a ∈ R.carrier by typecheck
    have p2 : a * r ∈ R.carrier by typecheck
    have nu1 : ¬RingUnit(R, r * a)
      intro u
      obtain ⟨_, ua⟩ := (RingUnit.mul_iff at R, r, a with comm).forward with u
      exact anu with ua
    have nu2 : ¬RingUnit(R, a * r)
      intro u
      obtain ⟨ua, _⟩ := (RingUnit.mul_iff at R, a, r with comm).forward with u
      exact anu with ua
    have m1 := (localMaximalIdeal.mem_iff_helper at R, r * a with localRing).backward with ⟨p1, nu1⟩
    have m2 := (localMaximalIdeal.mem_iff_helper at R, a * r with localRing).backward with ⟨p2, nu2⟩
    exact ⟨m1, m2⟩

theorem LocalRing.comm_ring
  shows CommRing(R)
proof
  exact localRing.left

theorem LocalRing.nontrivial
  shows R.zero ≠ R.one
proof
  obtain ⟨_, nt, _⟩ := localRing
  exact nt

-- IsLocalRing.isUnit_or_isUnit_one_sub_self.
theorem LocalRing.unit_or_one_sub_unit (a : Set)
  requires element : a ∈ R.carrier
  shows RingUnit(R, a) ∨ RingUnit(R, Ring.sub(R, R.one, a))
proof
  obtain ⟨comm, nt, split⟩ := localRing
  have dIn : Ring.sub(R, R.one, a) ∈ R.carrier by typecheck
  have sum : a + Ring.sub(R, R.one, a) = R.one by ring
  exact split with a, element, Ring.sub(R, R.one, a), dIn, sum

-- IsLocalRing.isUnit_one_sub_self_of_mem_nonunits and
-- isUnit_of_mem_nonunits_one_sub_self.
theorem LocalRing.one_sub_nonunit (a : Set)
  requires nonunit : a ∈ ringNonunits(R)
  shows RingUnit(R, Ring.sub(R, R.one, a))
proof
  have m : a ∈ localMaximalIdeal(R)
    unfold localMaximalIdeal
    exact nonunit
  obtain ⟨aIn, anu⟩ := (localMaximalIdeal.mem_iff_helper at R, a with localRing).forward with m
  rcases LocalRing.unit_or_one_sub_unit at R, a with localRing, aIn with u | v
  . exfalso
    exact anu with u
  . exact v

-- IsLocalRing.nonunits_add: the nonunits are closed under addition.
theorem LocalRing.nonunits_add (a b : Set)
  requires first : a ∈ ringNonunits(R)
  requires second : b ∈ ringNonunits(R)
  shows call2(R.add, a, b) ∈ ringNonunits(R)
proof
  have ideal := localMaximalIdeal.ideal at R with localRing
  unfold localMaximalIdeal at ideal
  exact Ideal.add_mem at R, ringNonunits(R), a, b with ideal, first, second

-- A local ring is not the zero ring and its maximal ideal is proper.
theorem localMaximalIdeal.proper
  shows ProperIdeal(R, localMaximalIdeal(R))
proof
  have comm := LocalRing.comm_ring at R with localRing
  have ringR := CommRing.to_ring with comm
  have ideal := localMaximalIdeal.ideal at R with localRing
  have oneOut : R[1] ∉ localMaximalIdeal(R)
    intro m
    have nu := ((localMaximalIdeal.mem_iff_helper at R, R[1] with localRing).forward with m).right
    exact nu with (RingUnit.one at R with comm)
  exact ProperIdeal.mk at R, localMaximalIdeal(R) with ringR, ideal, oneOut

-- IsLocalRing.le_maximalIdeal: every proper ideal lies in m; m is the
-- only maximal ideal (IsLocalRing.isMaximal_iff, eq_maximalIdeal).
theorem localMaximalIdeal.contains_proper (I : Set)
  requires proper : ProperIdeal(R, I)
  shows I ⊆ localMaximalIdeal(R)
proof
  have comm := LocalRing.comm_ring at R with localRing
  have idealI := ProperIdeal.to_ideal at R, I with proper
  intros x xI
  have xIn := Ideal.mem_carrier at R, I, x with idealI, xI
  have nu : ¬RingUnit(R, x)
    intro u
    exact (ProperIdeal.not_mem_unit at R, I, x with comm, proper, u) with xI
  exact (localMaximalIdeal.mem_iff_helper at R, x with localRing).backward with ⟨xIn, nu⟩

-- IsLocalRing.maximalIdeal.isMaximal and the description of membership
-- (IsLocalRing.mem_maximalIdeal, notMem_maximalIdeal).
theorem localMaximalIdeal.maximal
  shows MaximalIdeal(R, localMaximalIdeal(R))
proof
  have proper := localMaximalIdeal.proper at R with localRing
  have maximality : ∀ J, ProperIdeal(R, J) → localMaximalIdeal(R) ⊆ J → J = localMaximalIdeal(R)
    intros J properJ sub
    have back := localMaximalIdeal.contains_proper at R, J with localRing, properJ
    exact Subset.antisymmetric with back, sub
  exact ⟨proper, maximality⟩

theorem localMaximalIdeal.mem_iff (a : Set)
  requires element : a ∈ R.carrier
  shows a ∈ localMaximalIdeal(R) ↔ ¬RingUnit(R, a)
proof
  have h := localMaximalIdeal.mem_iff_helper at R, a with localRing
  constructor
  . intro m
    exact (h.forward with m).right
  . intro nu
    exact h.backward with ⟨element, nu⟩

theorem localMaximalIdeal.unique (M : Set)
  requires maximal : MaximalIdeal(R, M)
  shows M = localMaximalIdeal(R)
proof
  have proper := MaximalIdeal.to_proper at R, M with maximal
  have sub := localMaximalIdeal.contains_proper at R, M with localRing, proper
  have mp := localMaximalIdeal.proper at R with localRing
  obtain ⟨_, maxM⟩ := maximal
  have e := maxM with localMaximalIdeal(R), mp, sub
  rw e

-- IsLocalRing.jacobson_eq_maximalIdeal (of the zero ideal).
theorem LocalRing.jacobson
  shows jacobsonRadical(R, {R.zero}) = localMaximalIdeal(R)
proof
  have comm := LocalRing.comm_ring at R with localRing
  have mm := localMaximalIdeal.maximal at R with localRing
  apply Subset.antisymmetric
  . intros x hx
    obtain ⟨_, all⟩ := jacobsonRadical.membership.forward at R, {R.zero}, x with hx
    have mIdeal := MaximalIdeal.to_ideal at R, localMaximalIdeal(R) with mm
    have z := Ideal.zero_mem at R, localMaximalIdeal(R) with mIdeal
    have zs := (singleton.subset_iff at R.zero, localMaximalIdeal(R)).backward with z
    exact all with localMaximalIdeal(R), mm, zs
  . intros x hx
    have xIn := ((localMaximalIdeal.mem_iff_helper at R, x with localRing).forward with hx).left
    have all : ∀ M, MaximalIdeal(R, M) → {R.zero} ⊆ M → x ∈ M
      intros M maxM sub
      have e := localMaximalIdeal.unique at R, M with localRing, maxM
      rw e
      exact hx
    exact jacobsonRadical.membership.backward at R, {R.zero}, x with ⟨xIn, all⟩

-- IsLocalRing.maximalIdeal_eq_bot: m = 0 iff R is a field.
theorem LocalRing.maximal_zero_iff
  shows localMaximalIdeal(R) = {R.zero} ↔ Field(R)
proof
  have comm := LocalRing.comm_ring at R with localRing
  have nt := LocalRing.nontrivial at R with localRing
  constructor
  . intro h
    apply Field.of_ideals at R with comm, nt
    intros I idealI
    have ringR := CommRing.to_ring with comm
    by_cases whole : I = R.carrier
    . right
      exact whole
    . left
      have properI := (ProperIdeal.iff_ne_carrier at R, I with ringR, idealI).backward with whole
      have sub := localMaximalIdeal.contains_proper at R, I with localRing, properI
      rw h at sub
      have z := Ideal.zero_mem at R, I with idealI
      have zs := (singleton.subset_iff at R.zero, I).backward with z
      exact Subset.antisymmetric with sub, zs
  . intro field
    have ringR := CommRing.to_ring with comm
    apply Subset.antisymmetric
    . intros x hx
      obtain ⟨xIn, nu⟩ := (localMaximalIdeal.mem_iff_helper at R, x with localRing).forward with hx
      apply singleton.membership.backward
      by_contra xnz
      exact nu with ((Field.unit_iff at R, x with field, xIn).backward with xnz)
    . have mIdeal := localMaximalIdeal.ideal at R with localRing
      have z := Ideal.zero_mem at R, localMaximalIdeal(R) with mIdeal
      exact (singleton.subset_iff at R.zero, localMaximalIdeal(R)).backward with z

-- IsLocalRing.exists_of_isUnit_sum: a finite sum that is a unit has a
-- unit term.
theorem LocalRing.unit_of_sum (n w : Set)
  requires natural : Nat(n)
  requires terms : w : n → R.carrier
  requires unit : RingUnit(R, finiteRingSum(n, R.carrier, R.add, R.zero,
    R.neg, R.mul, R.one, w))
  shows ∃ i ∈ n, RingUnit(R, w(i))
proof
  sorry

-- The residue field and map: a field (IsLocalRing.ResidueField.field), a
-- surjective homomorphism (residue_surjective) with kernel m
-- (ker_residue), vanishing exactly on m (residue_eq_zero_iff), nonzero
-- exactly on units (residue_ne_zero_iff_isUnit).
theorem residueField.field
  shows Field(residueField(R))
proof
  have comm := LocalRing.comm_ring at R with localRing
  have mm := localMaximalIdeal.maximal at R with localRing
  have mIdeal := MaximalIdeal.to_ideal at R, localMaximalIdeal(R) with mm
  unfold residueField
  exact (quotientRing.field_iff at R, localMaximalIdeal(R) with comm, mIdeal).backward with mm

theorem residueMap.hom
  shows residueMap(R) : R →+* residueField(R)
proof
  have comm := LocalRing.comm_ring at R with localRing
  have mIdeal := localMaximalIdeal.ideal at R with localRing
  unfold residueMap
  unfold residueField
  exact quotientMk.hom at R, localMaximalIdeal(R) with comm, mIdeal

theorem residueMap.surjective
  shows SurjectiveBetween(residueMap(R), R.carrier,
    Ring.carrier(residueField(R)))
proof
  have comm := LocalRing.comm_ring at R with localRing
  have mIdeal := localMaximalIdeal.ideal at R with localRing
  unfold residueMap
  unfold residueField
  exact quotientMk.surjective at R, localMaximalIdeal(R) with comm, mIdeal

theorem residueMap.kernel
  shows ringKernel(residueMap(R), R.carrier, Ring.zero(residueField(R))) =
    localMaximalIdeal(R)
proof
  have comm := LocalRing.comm_ring at R with localRing
  have mIdeal := localMaximalIdeal.ideal at R with localRing
  unfold residueMap
  unfold residueField
  exact quotientMk.kernel at R, localMaximalIdeal(R) with comm, mIdeal

theorem residueMap.eq_zero_iff (a : Set)
  requires element : a ∈ R.carrier
  shows residueMap(R)(a) = Ring.zero(residueField(R)) ↔ a ∈ localMaximalIdeal(R)
proof
  have comm := LocalRing.comm_ring at R with localRing
  have mIdeal := localMaximalIdeal.ideal at R with localRing
  unfold residueMap
  unfold residueField
  exact quotientMk.eq_zero_iff at R, localMaximalIdeal(R), a with comm, mIdeal, element

theorem residueMap.ne_zero_iff_unit (a : Set)
  requires element : a ∈ R.carrier
  shows residueMap(R)(a) ≠ Ring.zero(residueField(R)) ↔ RingUnit(R, a)
proof
  have e := residueMap.eq_zero_iff at R, a with localRing, element
  have m := localMaximalIdeal.mem_iff at R, a with localRing, element
  constructor
  . intro ne
    by_contra nu
    exact ne with (e.backward with (m.backward with nu))
  . intro u
    intro z
    exact (m.forward with (e.forward with z)) with u

theorem residueAlgebra.algebra
  shows Algebra(residueAlgebra(R))
proof
  sorry

-- A unit plus an element of m is a unit.
theorem LocalRing.unit_add_maximal (u a : Set)
  requires unit : RingUnit(R, u)
  requires member : a ∈ localMaximalIdeal(R)
  shows RingUnit(R, call2(R.add, u, a))
proof
  have comm := LocalRing.comm_ring at R with localRing
  have mIdeal := localMaximalIdeal.ideal at R with localRing
  obtain ⟨aIn, _⟩ := (localMaximalIdeal.mem_iff_helper at R, a with localRing).forward with member
  have uIn : u ∈ R.carrier by exact unit.left
  by_contra nu
  have sIn : u + a ∈ R.carrier by typecheck
  have sm := (localMaximalIdeal.mem_iff_helper at R, u + a with localRing).backward with ⟨sIn, nu⟩
  have d := Ideal.sub_mem at R, localMaximalIdeal(R), u + a, a with mIdeal, sm, member
  have e : (u + a) - a = u by ring
  rw e at d
  have unu := ((localMaximalIdeal.mem_iff_helper at R, u with localRing).forward with d).right
  exact unu with unit

-- The quotient of a local ring by a proper ideal is local, with maximal
-- ideal the image of m (IsLocalRing.of_surjective,
-- IsLocalRing.map_maximalIdeal_of_surjective).
theorem LocalRing.quotient (I : Set)
  requires proper : ProperIdeal(R, I)
  shows LocalRing(R ⧸ I) ∧
    localMaximalIdeal(R ⧸ I) =
      functionImage(quotientMk(R, I), localMaximalIdeal(R), Ring.carrier(R ⧸ I))
proof
  sorry

end LocalLaws

-- A ring is local iff its nonunits form an ideal (IsLocalRing.of_nonunits_add),
-- iff it has exactly one maximal ideal (IsLocalRing.of_unique_max_ideal).
-- The second converse puts a nonunit in a maximal ideal: Choice.
theorem LocalRing.of_nonunits_ideal (R : Set)
  requires comm : CommRing(R)
  requires nontrivial : Ring.zero(R) ≠ Ring.one(R)
  requires ideal : Ideal(R, ringNonunits(R))
  shows LocalRing(R)
proof
  have split : ∀ a b ∈ Ring.carrier(R), call2(Ring.add(R), a, b) = Ring.one(R) → RingUnit(R, a) ∨ RingUnit(R, b)
    intros a aIn b bIn sum
    by_contra neither
    have anu : ¬RingUnit(R, a)
      intro u
      have d : RingUnit(R, a) ∨ RingUnit(R, b) by left; exact u
      exact neither with d
    have bnu : ¬RingUnit(R, b)
      intro u
      have d : RingUnit(R, a) ∨ RingUnit(R, b) by right; exact u
      exact neither with d
    have aOut : a ∉ ringUnits(R)
      intro m
      exact anu with (ringUnits.membership.forward at R, a with m).right
    have bOut : b ∉ ringUnits(R)
      intro m
      exact bnu with (ringUnits.membership.forward at R, b with m).right
    have aN : a ∈ ringNonunits(R)
      unfold ringNonunits
      exact (difference.membership at Ring.carrier(R), ringUnits(R), a).backward with ⟨aIn, aOut⟩
    have bN : b ∈ ringNonunits(R)
      unfold ringNonunits
      exact (difference.membership at Ring.carrier(R), ringUnits(R), b).backward with ⟨bIn, bOut⟩
    have s := Ideal.add_mem at R, ringNonunits(R), a, b with ideal, aN, bN
    rw sum at s
    unfold ringNonunits at s
    obtain ⟨_, oneOut⟩ := (difference.membership at Ring.carrier(R), ringUnits(R), Ring.one(R)).forward with s
    have one := RingUnit.one at R with comm
    exact oneOut with (ringUnits.mem_of_unit at R, Ring.one(R) with comm, one)
  exact ⟨comm, nontrivial, split⟩

theorem LocalRing.of_unique_maximal (R M : Set)
  requires comm : CommRing(R)
  requires maximal : MaximalIdeal(R, M)
  requires unique : ∀ N, MaximalIdeal(R, N) → N = M
  shows LocalRing(R)
proof
  sorry

-- A field is local with maximal ideal 0 (Field.isLocalRing).
theorem Field.local_ring (K : Set)
  requires field : Field(K)
  shows LocalRing(K) ∧ localMaximalIdeal(K) = {Ring.zero(K)}
proof
  have comm := Field.to_comm_ring at K with field
  have dom := Field.domain at K with field
  have nt := IntegralDomain.nontrivial at K with dom
  have split : ∀ a b ∈ Ring.carrier(K), call2(Ring.add(K), a, b) = Ring.one(K) → RingUnit(K, a) ∨ RingUnit(K, b)
    intros a aIn b bIn sum
    by_cases az : a = Ring.zero(K)
    . right
      have bOne : b = Ring.one(K)
        rw ← sum
        rw az
        ring
      rw bOne
      exact RingUnit.one at K with comm
    . left
      exact (Field.unit_iff at K, a with field, aIn).backward with az
  have loc : LocalRing(K) by exact ⟨comm, nt, split⟩
  have mz := (LocalRing.maximal_zero_iff at K with loc).backward with field
  exact ⟨loc, mz⟩

-- A local ring isomorphic to R is local.
theorem LocalRing.of_iso (f R S : Set)
  requires localRing : LocalRing(R)
  requires target : CommRing(S)
  requires iso : f : R ≃+* S
  shows LocalRing(S)
proof
  sorry

-- Section: Local homomorphisms
section LocalHoms
variable (f R S : Set)
hypothesis localR : LocalRing(R)
hypothesis localS : LocalRing(S)

-- IsLocalHom: f is local iff f⁻¹(m_S) = m_R (IsLocalRing.maximalIdeal_comap)
-- iff f(m_R) ⊆ m_S.
theorem LocalRingHom.iff_comap
  requires hom : f : R →+* S
  shows LocalRingHom(f, R, S) ↔
    idealComap(f, R.carrier, localMaximalIdeal(S)) = localMaximalIdeal(R)
proof
  have cR := LocalRing.comm_ring at R with localR
  have cS := LocalRing.comm_ring at S with localS
  constructor
  . intro lh
    obtain ⟨_, reflect⟩ := lh
    apply Subset.antisymmetric
    . intros x hx
      obtain ⟨xIn, fxm⟩ := idealComap.membership.forward at f, R.carrier, localMaximalIdeal(S), x with hx
      obtain ⟨_, fnu⟩ := (localMaximalIdeal.mem_iff_helper at S, f(x) with localS).forward with fxm
      have nu : ¬RingUnit(R, x)
        intro u
        have fu := GRH.Algebra.Divisibility.RingUnit.map at R, f, S, x with cR, cS, hom, u
        exact fnu with fu
      exact (localMaximalIdeal.mem_iff_helper at R, x with localR).backward with ⟨xIn, nu⟩
    . intros x hx
      obtain ⟨xIn, nu⟩ := (localMaximalIdeal.mem_iff_helper at R, x with localR).forward with hx
      have fx : f(x) ∈ S.carrier by typecheck
      have fnu : ¬RingUnit(S, f(x))
        intro u
        exact nu with (reflect with x, xIn, u)
      have fm := (localMaximalIdeal.mem_iff_helper at S, f(x) with localS).backward with ⟨fx, fnu⟩
      exact idealComap.membership.backward at f, R.carrier, localMaximalIdeal(S), x with ⟨xIn, fm⟩
  . intro e
    have reflect : ∀ a ∈ R.carrier, RingUnit(S, f(a)) → RingUnit(R, a)
      intros a aIn u
      by_contra nu
      have am := (localMaximalIdeal.mem_iff_helper at R, a with localR).backward with ⟨aIn, nu⟩
      rw ← e at am
      obtain ⟨_, fam⟩ := idealComap.membership.forward at f, R.carrier, localMaximalIdeal(S), a with am
      obtain ⟨_, fnu⟩ := (localMaximalIdeal.mem_iff_helper at S, f(a) with localS).forward with fam
      exact fnu with u
    exact ⟨hom, reflect⟩

theorem LocalRingHom.iff_image
  requires hom : f : R →+* S
  shows LocalRingHom(f, R, S) ↔
    functionImage(f, localMaximalIdeal(R), S.carrier) ⊆ localMaximalIdeal(S)
proof
  have cR := LocalRing.comm_ring at R with localR
  have cS := LocalRing.comm_ring at S with localS
  constructor
  . intro lh
    obtain ⟨_, reflect⟩ := lh
    intros y hy
    obtain ⟨yIn, x, xm, yx⟩ := functionImage.membership.forward at f, localMaximalIdeal(R), S.carrier, y with hy
    obtain ⟨xIn, nu⟩ := (localMaximalIdeal.mem_iff_helper at R, x with localR).forward with xm
    have fnu : ¬RingUnit(S, y)
      intro u
      rw yx at u
      exact nu with (reflect with x, xIn, u)
    exact (localMaximalIdeal.mem_iff_helper at S, y with localS).backward with ⟨yIn, fnu⟩
  . intro sub
    have reflect : ∀ a ∈ R.carrier, RingUnit(S, f(a)) → RingUnit(R, a)
      intros a aIn u
      by_contra nu
      have am := (localMaximalIdeal.mem_iff_helper at R, a with localR).backward with ⟨aIn, nu⟩
      have fa : f(a) ∈ S.carrier by typecheck
      have img := functionImage.membership.backward at f, localMaximalIdeal(R), S.carrier, f(a) with ⟨fa, a, am, rfl⟩
      have fam := sub with img
      obtain ⟨_, fnu⟩ := (localMaximalIdeal.mem_iff_helper at S, f(a) with localS).forward with fam
      exact fnu with u
    exact ⟨hom, reflect⟩

-- A surjective homomorphism of local rings is local
-- (isLocalHom_of_surjective in the local case).
theorem LocalRingHom.of_surjective
  requires hom : f : R →+* S
  requires surjective : SurjectiveBetween(f, R.carrier, S.carrier)
  shows LocalRingHom(f, R, S)
proof
  sorry

-- IsLocalRing.ResidueField.map: a homomorphism of fields, commuting with
-- the residue maps.
theorem residueFieldMap.hom
  requires local : LocalRingHom(f, R, S)
  shows RingHom(residueFieldMap(f, R, S), residueField(R), residueField(S)) ∧
    (∀ a ∈ R.carrier,
      residueFieldMap(f, R, S)(residueMap(R)(a)) = residueMap(S)(f(a)))
proof
  have cR := LocalRing.comm_ring at R with localR
  have cS := LocalRing.comm_ring at S with localS
  have local0 := local
  obtain ⟨hom, _⟩ := local0
  have e := (LocalRingHom.iff_comap at f, R, S with localR, localS, hom).forward with local
  have mR := localMaximalIdeal.ideal at R with localR
  have mS := localMaximalIdeal.ideal at S with localS
  have compat : localMaximalIdeal(R) ⊆ idealComap(f, R.carrier, localMaximalIdeal(S))
    rw e
    exact Subset.reflexive at localMaximalIdeal(R)
  have h := quotientRingMap.hom at f, R, S, localMaximalIdeal(R), localMaximalIdeal(S) with cR, cS, hom, mR, mS, compat
  have ap : ∀ a ∈ R.carrier, residueFieldMap(f, R, S)(residueMap(R)(a)) = residueMap(S)(f(a))
    intros a aIn
    unfold residueFieldMap
    unfold residueMap
    exact quotientRingMap.apply_mk at f, R, S, localMaximalIdeal(R), localMaximalIdeal(S), a with cR, cS, hom, mR, mS, compat, aIn
  have h2 : RingHom(residueFieldMap(f, R, S), residueField(R), residueField(S))
    unfold residueFieldMap
    unfold residueField
    exact h
  exact ⟨h2, ap⟩

-- IsLocalRing.surjective_units_map_of_local_ringHom: a surjective local
-- homomorphism is surjective on units.
theorem LocalRingHom.units_surjective
  requires local : LocalRingHom(f, R, S)
  requires surjective : SurjectiveBetween(f, R.carrier, S.carrier)
  shows ∀ v ∈ ringUnits(S), ∃ u ∈ ringUnits(R), f(u) = v
proof
  obtain ⟨hom, reflect⟩ := local
  intros v hv
  obtain ⟨vIn, vu⟩ := ringUnits.membership.forward at S, v with hv
  obtain ⟨_, onto⟩ := surjective
  obtain ⟨u, uIn, rel⟩ := onto with v, vIn
  have hom0 := hom
  obtain ⟨_, _, fn, _⟩ := hom0
  have fu := FunctionBetween.apply_value with fn, uIn, rel
  rw ← fu at vu
  have uu := reflect with u, uIn, vu
  have cR := LocalRing.comm_ring at R with localR
  have um := ringUnits.mem_of_unit at R, u with cR, uu
  exact ⟨u, um, fu⟩

-- IsLocalRing.ResidueField.mapEquiv: an isomorphism of local rings
-- induces an isomorphism of residue fields.
theorem residueFieldMap.iso
  requires iso : f : R ≃+* S
  shows residueFieldMap(f, R, S) : residueField(R) ≃+* residueField(S)
proof
  sorry

end LocalHoms

-- Composition of local homomorphisms and of residue maps
-- (IsLocalRing.ResidueField.map_comp).
theorem LocalRingHom.compose (f g R S T : Set)
  requires first : LocalRingHom(f, R, S)
  requires second : LocalRingHom(g, S, T)
  shows LocalRingHom(compose(g, f, Ring.carrier(R), Ring.carrier(S),
    Ring.carrier(T)), R, T)
proof
  sorry

-- isLocalHom_of_le_jacobson_bot: a surjection with kernel in the Jacobson
-- radical reflects units.
theorem LocalRingHom.of_kernel_jacobson (f R S : Set)
  requires comm : CommRing(R)
  requires target : CommRing(S)
  requires hom : f : R →+* S
  requires surjective : SurjectiveBetween(f, Ring.carrier(R), Ring.carrier(S))
  requires kernel : ringKernel(f, Ring.carrier(R), Ring.zero(S)) ⊆
    jacobsonRadical(R, {Ring.zero(R)})
  shows LocalRingHom(f, R, S)
proof
  sorry

-- Section: Localization at a prime
-- The localization at a prime P is local, its maximal ideal is the
-- extension of P, and the structure map is a local homomorphism from
-- nothing but this case (Localization.AtPrime.isLocalRing,
-- IsLocalization.AtPrime.isLocalRing, AtPrime.map_eq_maximalIdeal,
-- Localization.localRingHom_to_map).
theorem IsLocalizationAtPrime.local_ring (P A : Set)
  requires atPrime : IsLocalizationAtPrime(P, A)
  shows LocalRing(Algebra.ring(A)) ∧
    localMaximalIdeal(Algebra.ring(A)) =
      idealExtension(Algebra.map(A), Algebra.ring(A), P) ∧
    idealComap(Algebra.map(A), Ring.carrier(Algebra.base(A)),
      localMaximalIdeal(Algebra.ring(A))) = P
proof
  sorry

theorem localizationAtPrime.local_ring (R P : Set)
  requires comm : CommRing(R)
  requires prime : PrimeIdeal(R, P)
  shows LocalRing(localizationAtPrime(R, P))
proof
  sorry

-- The residue field of a prime: a field, receiving R with kernel P
-- (Ideal.ker_algebraMap_residueField, algebraMap_residueField_eq_zero),
-- and the fraction field of R ⧸ P (Ideal.ResidueField as
-- FractionRing (R ⧸ P)).
theorem primeResidueField.field (R P : Set)
  requires comm : CommRing(R)
  requires prime : PrimeIdeal(R, P)
  shows Field(primeResidueField(R, P))
proof
  sorry

theorem primeResidueMap.kernel (R P : Set)
  requires comm : CommRing(R)
  requires prime : PrimeIdeal(R, P)
  shows RingHom(primeResidueMap(R, P), R, primeResidueField(R, P)) ∧
    ringKernel(primeResidueMap(R, P), Ring.carrier(R),
      Ring.zero(primeResidueField(R, P))) = P
proof
  sorry

theorem primeResidueField.fraction_field (R P : Set)
  requires comm : CommRing(R)
  requires prime : PrimeIdeal(R, P)
  shows IsFractionRing(Algebra.mk(R ⧸ P, primeResidueField(R, P),
    quotientRingLift(R, primeResidueField(R, P), P, primeResidueMap(R, P))))
proof
  sorry

-- For a maximal ideal, the residue field of the prime is R ⧸ M itself.
theorem primeResidueField.of_maximal (R M : Set)
  requires comm : CommRing(R)
  requires maximal : MaximalIdeal(R, M)
  shows RingIso(quotientRingLift(R, primeResidueField(R, M), M,
    primeResidueMap(R, M)), R ⧸ M, primeResidueField(R, M))
proof
  sorry

-- Section: Nakayama's lemma
section Nakayama
variable (R M : Set)
hypothesis comm : CommRing(R)
hypothesis module : Module(M, R)

-- Submodule.eq_bot_of_le_smul_of_le_jacobson_bot: for a finitely
-- generated M and I in the Jacobson radical, M = I M forces M = 0.
theorem Nakayama.eq_zero (I : Set)
  requires finite : FinitelyGeneratedModule(M, R)
  requires ideal : Ideal(R, I)
  requires jacobson : I ⊆ jacobsonRadical(R, {R.zero})
  requires equal : idealSmul(M, R, I, M.carrier) = M.carrier
  shows M.carrier = {M.zero}
proof
  sorry

-- Submodule.smul_le_of_le_smul_of_le_jacobson_bot and
-- Submodule.le_of_le_smul_of_le_jacobson_bot: N + I M = M forces N = M.
theorem Nakayama.submodule (I N : Set)
  requires finite : FinitelyGeneratedModule(M, R)
  requires ideal : Ideal(R, I)
  requires jacobson : I ⊆ jacobsonRadical(R, {R.zero})
  requires sub : SubmoduleOf(N, M, R)
  requires covers : submoduleSum(M, N, idealSmul(M, R, I, M.carrier)) = M.carrier
  shows N = M.carrier
proof
  sorry

-- The determinant trick (Submodule.exists_sub_one_mem_and_smul_eq_zero_of_fg_of_le_smul):
-- if M is finitely generated and I M = M, some r ≡ 1 mod I kills M.
theorem Nakayama.determinant_trick (I : Set)
  requires finite : FinitelyGeneratedModule(M, R)
  requires ideal : Ideal(R, I)
  requires equal : idealSmul(M, R, I, M.carrier) = M.carrier
  shows ∃ r ∈ R.carrier, Ring.sub(R, r, R.one) ∈ I ∧
    (∀ v ∈ M.carrier, call2(M.smul, r, v) = M.zero)
proof
  sorry

-- Over a local ring: vectors whose classes span M ⧸ m M span M
-- (IsLocalRing.span_eq_top_of_tmul_eq_basis, in the generator form).
theorem Nakayama.local_generators (S : Set)
  requires localRing : LocalRing(R)
  requires finite : FinitelyGeneratedModule(M, R)
  requires subset : S ⊆ M.carrier
  requires spansModulo : submoduleSum(M, moduleSpan(M, R, S),
    idealSmul(M, R, localMaximalIdeal(R), M.carrier)) = M.carrier
  shows moduleSpan(M, R, S) = M.carrier
proof
  sorry

-- A linear map of finitely generated modules over a local ring that is
-- surjective modulo m is surjective.
theorem Nakayama.surjective_of_residue (N f : Set)
  requires localRing : LocalRing(R)
  requires finite : FinitelyGeneratedModule(N, R)
  requires linear : LinearMap(f, M, R, N)
  requires modulo : submoduleSum(N, linearRange(f, M, N),
    idealSmul(N, R, localMaximalIdeal(R), Module.carrier(N))) = Module.carrier(N)
  shows SurjectiveBetween(f, M.carrier, Module.carrier(N))
proof
  sorry

end Nakayama
