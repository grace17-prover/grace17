-- Localization of a commutative ring at a multiplicative subset: the
-- ring of fractions a / s built on classes of pairs, the characteristic
-- predicate of a localization (Mathlib's IsLocalization) with its
-- universal property and uniqueness, localization away from an element
-- and at a prime ideal, the total ring of fractions and the fraction
-- field of a domain, and the correspondence of prime ideals
-- (IsLocalization.orderIsoOfPrime).
-- Part of the GRH blueprint.
-- Planned home: Algebra/Ring/Localization (beside Cumulus's
-- localization inside an ambient ring).
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Algebra.Localization
import GRH.Algebra.Ideals
import Grace.Cumulus.Algebra.Algebras.Basic

-- Section: Multiplicative subsets
-- A multiplicative subset: contains 1 and is closed under products
-- (Mathlib's Submonoid of a commutative ring).
predicate MultiplicativeSubset (R S : Set) :=
  S ⊆ Ring.carrier(R) ∧ Ring.one(R) ∈ S ∧
  (∀ s t ∈ S, call2(Ring.mul(R), s, t) ∈ S)

-- The powers {xⁿ} of x (Submonoid.powers) and the complement of a prime
-- ideal (Ideal.primeCompl).
def ringPowers (R x : Set) : Set :=
  { y ∈ Ring.carrier(R) | ∃ n ∈ ℕ, y = Ring.pow(R, x, n) }

def primeComplement (R P : Set) : Set := Ring.carrier(R) ∖ P

-- Section: The construction
-- Pairs (a, s) ∈ R × S, identified when u (a t − b s) = 0 for some u ∈ S.
def fractionPairs (R S : Set) : Set := Ring.carrier(R) × S

def fractionRelation (R S : Set) : Set :=
  { q ∈ fractionPairs(R, S) × fractionPairs(R, S) |
    ∃ a ∈ Ring.carrier(R), ∃ s ∈ S, ∃ b ∈ Ring.carrier(R), ∃ t ∈ S,
      q = ((a, s), (b, t)) ∧ (∃ u ∈ S, call2(Ring.mul(R), u,
        Ring.sub(R, call2(Ring.mul(R), a, t), call2(Ring.mul(R), b, s))) =
        Ring.zero(R)) }

def localizationCarrier (R S : Set) : Set :=
  fractionPairs(R, S) ⧸ fractionRelation(R, S)

-- The fraction a / s, the class of (a, s) (IsLocalization.mk').
def fraction (R S a s : Set) : Set :=
  ⟦(a, s)⟧[fractionPairs(R, S), fractionRelation(R, S)]

-- a/s + b/t = (a t + b s)/(s t), (a/s)(b/t) = (a b)/(s t), −(a/s) = (−a)/s,
-- as graphs on classes (well defined because the relation is a
-- congruence).
def localizationAdd (R S : Set) : Set :=
  { q ∈ (localizationCarrier(R, S) × localizationCarrier(R, S)) ×
      localizationCarrier(R, S) |
    ∃ a ∈ Ring.carrier(R), ∃ s ∈ S, ∃ b ∈ Ring.carrier(R), ∃ t ∈ S,
      q = ((fraction(R, S, a, s), fraction(R, S, b, t)),
        fraction(R, S, call2(Ring.add(R), call2(Ring.mul(R), a, t),
          call2(Ring.mul(R), b, s)), call2(Ring.mul(R), s, t))) }

def localizationMul (R S : Set) : Set :=
  { q ∈ (localizationCarrier(R, S) × localizationCarrier(R, S)) ×
      localizationCarrier(R, S) |
    ∃ a ∈ Ring.carrier(R), ∃ s ∈ S, ∃ b ∈ Ring.carrier(R), ∃ t ∈ S,
      q = ((fraction(R, S, a, s), fraction(R, S, b, t)),
        fraction(R, S, call2(Ring.mul(R), a, b), call2(Ring.mul(R), s, t))) }

def localizationNeg (R S : Set) : Set :=
  { q ∈ localizationCarrier(R, S) × localizationCarrier(R, S) |
    ∃ a ∈ Ring.carrier(R), ∃ s ∈ S,
      q = (fraction(R, S, a, s), fraction(R, S, apply(Ring.neg(R), a), s)) }

-- The localization S⁻¹R (Mathlib's Localization S).
def localizationRing (R S : Set) : Set :=
  Ring.mk(localizationCarrier(R, S), localizationAdd(R, S),
    fraction(R, S, Ring.zero(R), Ring.one(R)), localizationNeg(R, S),
    localizationMul(R, S), fraction(R, S, Ring.one(R), Ring.one(R)))

-- The structure map a ↦ a / 1 (algebraMap R (Localization S)), and S⁻¹R
-- as an R-algebra.
def localizationMap (R S : Set) : Set :=
  { p ∈ Ring.carrier(R) × localizationCarrier(R, S) |
    ∃ a ∈ Ring.carrier(R), p = (a, fraction(R, S, a, Ring.one(R))) }

def localizationAlgebra (R S : Set) : Set :=
  Algebra.mk(R, localizationRing(R, S), localizationMap(R, S))

-- Localization away from x and at a prime P (Localization.Away,
-- Localization.AtPrime), and the total ring of fractions (FractionRing),
-- the fraction field of a domain.
def localizationAway (R x : Set) : Set := localizationRing(R, ringPowers(R, x))

def localizationAtPrime (R P : Set) : Set :=
  localizationRing(R, primeComplement(R, P))

def fractionRing (R : Set) : Set := localizationRing(R, nonZeroDivisors(R))

-- For g : R → B sending S to units, the map a / s ↦ g(a) g(s)⁻¹
-- (IsLocalization.lift on the construction, Localization.awayLift).
def localizationLift (R S B g : Set) : Set :=
  { p ∈ localizationCarrier(R, S) × Ring.carrier(B) |
    ∃ a ∈ Ring.carrier(R), ∃ s ∈ S, p = (fraction(R, S, a, s),
      call2(Ring.mul(B), g(a), ringInverse(B, g(s)))) }

-- Section: The characteristic predicate
-- An R-algebra A (Cumulus's Algebra, with base R and structure map
-- f = Algebra.map(A)) is a localization of R at S when f sends S to units,
-- every element of A is f(a) f(s)⁻¹, and f(a) = f(b) only when c a = c b
-- for some c ∈ S (Mathlib's IsLocalization: map_units', surj',
-- exists_of_eq).
predicate IsLocalization (S A : Set) :=
  Algebra(A) ∧ MultiplicativeSubset(Algebra.base(A), S) ∧
  (∀ s ∈ S, RingUnit(Algebra.ring(A), Algebra.map(A)(s))) ∧
  (∀ z ∈ algebraCarrier(A), ∃ a ∈ Ring.carrier(Algebra.base(A)), ∃ s ∈ S,
    call2(Ring.mul(Algebra.ring(A)), z, Algebra.map(A)(s)) = Algebra.map(A)(a)) ∧
  (∀ a b ∈ Ring.carrier(Algebra.base(A)), Algebra.map(A)(a) = Algebra.map(A)(b) →
    (∃ c ∈ S, call2(Ring.mul(Algebra.base(A)), c, a) =
      call2(Ring.mul(Algebra.base(A)), c, b)))

-- IsLocalization.Away and IsLocalization.AtPrime, and IsFractionRing.
predicate IsLocalizationAway (x A : Set) :=
  IsLocalization(ringPowers(Algebra.base(A), x), A)

predicate IsLocalizationAtPrime (P A : Set) :=
  PrimeIdeal(Algebra.base(A), P) ∧
  IsLocalization(primeComplement(Algebra.base(A), P), A)

predicate IsFractionRing (A : Set) :=
  IsLocalization(nonZeroDivisors(Algebra.base(A)), A)

-- The fraction f(a) f(s)⁻¹ in a localization A (IsLocalization.mk').
def localizationFraction (A a s : Set) : Set :=
  call2(Ring.mul(Algebra.ring(A)), Algebra.map(A)(a),
    ringInverse(Algebra.ring(A), Algebra.map(A)(s)))

-- For a localization A of R at S and g : R →+* B sending S to units, the
-- unique homomorphism h : A →+* B with h ∘ f = g (IsLocalization.lift).
defunique isLocalizationLift (S A B g : Set)
    (h ∈ functionSpace(algebraCarrier(A), Ring.carrier(B))) :=
  RingHom(h, Algebra.ring(A), B) ∧
  (∀ a ∈ Ring.carrier(Algebra.base(A)), h(Algebra.map(A)(a)) = g(a))
requires localization : IsLocalization(S, A)
requires target : CommRing(B)
requires hom : g : Algebra.base(A) →+* B
requires units : ∀ s ∈ S, RingUnit(B, g(s))
proof
  sorry
uniqueness
  intros h1 h1In first h2 h2In second
  obtain ⟨hom1, agree1⟩ := first
  obtain ⟨hom2, agree2⟩ := second
  have hom1c := hom1
  obtain ⟨_, _, fn1, _⟩ := hom1c
  have hom2c := hom2
  obtain ⟨_, _, fn2, _⟩ := hom2c
  apply FunctionBetween.ext with fn1, fn2
  intros z zIn
  have loc0 := localization
  obtain ⟨alg, m, _, surj, _⟩ := loc0
  obtain ⟨sub, _, _⟩ := m
  have cA := Algebra.comm_ring at A with alg
  have cB := Algebra.base_comm_ring at A with alg
  have zA : z ∈ algebraCarrier(A)
    unfold algebraCarrier
    exact zIn
  obtain ⟨a, aIn, s, sS, law⟩ := surj with z, zA
  have sIn := sub with sS
  have fs : Algebra.map(A)(s) ∈ Ring.carrier(Algebra.ring(A)) by typecheck
  have e1 := RingHom.map_mul at h1, Algebra.ring(A), B, z, Algebra.map(A)(s) with hom1, zIn, fs
  have e2 := RingHom.map_mul at h2, Algebra.ring(A), B, z, Algebra.map(A)(s) with hom2, zIn, fs
  rw law at e1
  rw law at e2
  rw [(agree1 with a, aIn), (agree1 with s, sIn)] at e1
  rw [(agree2 with a, aIn), (agree2 with s, sIn)] at e2
  have u := units with s, sS
  obtain ⟨_, right⟩ := ringInverse.unit at B, g(s) with target, u
  have vIn := ringInverse.mem at B, g(s) with target, u
  have z1 : h1(z) ∈ Ring.carrier(B) by typecheck
  have z2 : h2(z) ∈ Ring.carrier(B) by typecheck
  have gs : g(s) ∈ Ring.carrier(B) by typecheck
  have c1 : h1(z) = call2(Ring.mul(B), g(a), ringInverse(B, g(s)))
    rw e1
    have r : call2(Ring.mul(B), call2(Ring.mul(B), h1(z), g(s)), ringInverse(B, g(s))) = call2(Ring.mul(B), h1(z), call2(Ring.mul(B), g(s), ringInverse(B, g(s)))) by ring
    rw [r, right]
    ring
  have c2 : h2(z) = call2(Ring.mul(B), g(a), ringInverse(B, g(s)))
    rw e2
    have r : call2(Ring.mul(B), call2(Ring.mul(B), h2(z), g(s)), ringInverse(B, g(s))) = call2(Ring.mul(B), h2(z), call2(Ring.mul(B), g(s), ringInverse(B, g(s)))) by ring
    rw [r, right]
    ring
  rw [c1, c2]

-- Section: Laws of multiplicative subsets
section Multiplicative
variable (R : Set)
hypothesis comm : CommRing(R)

theorem ringPowers.multiplicative (x : R)
  shows MultiplicativeSubset(R, ringPowers(R, x))
proof
  have ringR := CommRing.to_ring with comm
  have xIn : x ∈ R.carrier by assumption
  have sub : ringPowers(R, x) ⊆ R.carrier
    intros y hy
    exact (ringPowers.membership.forward at R, x, y with hy).left
  have oneIn : R[1] ∈ R.carrier by typecheck
  have zN : 0 ∈ ℕ by typecheck
  have z := Ring.pow_zero at R, x with ringR
  have z2 : R[1] = x ^ 0 by rw z
  have oneP := ringPowers.membership.backward at R, x, R[1] with ⟨oneIn, 0, zN, z2⟩
  have closed : ∀ s t ∈ ringPowers(R, x), s * t ∈ ringPowers(R, x)
    intros s hs t ht
    obtain ⟨sIn, m, mIn, sm⟩ := ringPowers.membership.forward at R, x, s with hs
    obtain ⟨tIn, n, nIn, tn⟩ := ringPowers.membership.forward at R, x, t with ht
    have mNat : Nat(m) by typecheck
    have nNat : Nat(n) by typecheck
    have pIn : s * t ∈ R.carrier by typecheck
    have mnIn : m + n ∈ ℕ by typecheck
    have law : s * t = x ^ (m + n)
      rw [sm, tn]
      have pa := Ring.pow_add at R, x, m, n with ringR
      rw pa
    exact ringPowers.membership.backward at R, x, s * t with ⟨pIn, m + n, mnIn, law⟩
  exact ⟨sub, oneP, closed⟩

theorem ringPowers.self_mem (x : R)
  shows x ∈ ringPowers(R, x)
proof
  have ringR := CommRing.to_ring with comm
  have xIn : x ∈ R.carrier by assumption
  have oN : 1 ∈ ℕ by typecheck
  have p := Ring.pow_one at R, x with ringR
  have law : x = x ^ 1 by rw p
  exact ringPowers.membership.backward at R, x, x with ⟨xIn, 1, oN, law⟩

theorem primeComplement.multiplicative (P : Set)
  requires prime : PrimeIdeal(R, P)
  shows MultiplicativeSubset(R, primeComplement(R, P))
proof
  have ringR := CommRing.to_ring with comm
  have sub : primeComplement(R, P) ⊆ R.carrier
    intros y hy
    unfold primeComplement at hy
    exact ((difference.membership at R.carrier, P, y).forward with hy).left
  have oneIn : R[1] ∈ R.carrier by typecheck
  have proper := PrimeIdeal.to_proper at R, P with prime
  have oneOut := ProperIdeal.one_not_mem at R, P with proper
  have oneC : R[1] ∈ primeComplement(R, P)
    unfold primeComplement
    exact (difference.membership at R.carrier, P, R[1]).backward with ⟨oneIn, oneOut⟩
  have closed : ∀ s t ∈ primeComplement(R, P), s * t ∈ primeComplement(R, P)
    intros s hs t ht
    unfold primeComplement at hs
    unfold primeComplement at ht
    obtain ⟨sIn, sOut⟩ := (difference.membership at R.carrier, P, s).forward with hs
    obtain ⟨tIn, tOut⟩ := (difference.membership at R.carrier, P, t).forward with ht
    have pIn : s * t ∈ R.carrier by typecheck
    have pOut : s * t ∉ P
      intro pP
      rcases PrimeIdeal.mem_or_mem at R, P, s, t with ringR, prime, sIn, tIn, pP with a | b
      . exact sOut with a
      . exact tOut with b
    unfold primeComplement
    exact (difference.membership at R.carrier, P, s * t).backward with ⟨pIn, pOut⟩
  exact ⟨sub, oneC, closed⟩

theorem nonZeroDivisors.multiplicative
  shows MultiplicativeSubset(R, nonZeroDivisors(R))
proof
  have sub : nonZeroDivisors(R) ⊆ R.carrier
    intros y hy
    exact (nonZeroDivisors.membership.forward at R, y with hy).left
  have oneIn : R[1] ∈ R.carrier by typecheck
  have oneAll : ∀ y ∈ R.carrier, y * R[1] = R[0] → y = R[0]
    intros y yIn e
    have back : y = y * R[1] by ring
    rw back
    exact e
  have oneN := nonZeroDivisors.membership.backward at R, R[1] with ⟨oneIn, oneAll⟩
  have closed : ∀ s t ∈ nonZeroDivisors(R), s * t ∈ nonZeroDivisors(R)
    intros s hs t ht
    obtain ⟨sIn, sAll⟩ := nonZeroDivisors.membership.forward at R, s with hs
    obtain ⟨tIn, tAll⟩ := nonZeroDivisors.membership.forward at R, t with ht
    have pIn : s * t ∈ R.carrier by typecheck
    have all : ∀ y ∈ R.carrier, y * (s * t) = R[0] → y = R[0]
      intros y yIn e
      have ysIn : y * s ∈ R.carrier by typecheck
      have e2 : (y * s) * t = R[0]
        rw ← e
        ring
      have ys := tAll with y * s, ysIn, e2
      exact sAll with y, yIn, ys
    exact nonZeroDivisors.membership.backward at R, s * t with ⟨pIn, all⟩
  exact ⟨sub, oneN, closed⟩

theorem ringUnits.multiplicative
  shows MultiplicativeSubset(R, ringUnits(R))
proof
  have sub : ringUnits(R) ⊆ R.carrier
    intros y hy
    exact (ringUnits.membership.forward at R, y with hy).left
  have one := RingUnit.one at R with comm
  have oneU := ringUnits.mem_of_unit at R, R[1] with comm, one
  have closed : ∀ s t ∈ ringUnits(R), s * t ∈ ringUnits(R)
    intros s hs t ht
    obtain ⟨_, su⟩ := ringUnits.membership.forward at R, s with hs
    obtain ⟨_, tu⟩ := ringUnits.membership.forward at R, t with ht
    have u := RingUnit.mul at R, s, t with comm, su, tu
    exact ringUnits.mem_of_unit at R, s * t with comm, u
  exact ⟨sub, oneU, closed⟩

-- Ideal.exists_disjoint_powers_of_span_eq_top, in its prime-avoidance
-- form: an ideal disjoint from a multiplicative set lies in a prime
-- disjoint from it (Ideal.exists_le_prime_disjoint). Zorn: Choice.
theorem MultiplicativeSubset.exists_prime_disjoint (S I : Set)
  requires multiplicative : MultiplicativeSubset(R, S)
  requires ideal : Ideal(R, I)
  requires disjoint : I ∩ S = ∅
  shows ∃ P, PrimeIdeal(R, P) ∧ I ⊆ P ∧ P ∩ S = ∅
proof
  sorry

end Multiplicative

-- Section: The construction is a localization
section Construction
variable (R S : Set)
hypothesis comm : CommRing(R)
hypothesis multiplicative : MultiplicativeSubset(R, S)

theorem fractionRelation.equivalence
  shows Equivalence(fractionRelation(R, S), fractionPairs(R, S))
proof
  sorry

theorem localizationRing.comm_ring
  shows CommRing(localizationRing(R, S))
proof
  sorry

theorem localizationMap.hom
  shows localizationMap(R, S) : R →+* localizationRing(R, S)
proof
  sorry

theorem localizationAlgebra.algebra
  shows Algebra(localizationAlgebra(R, S))
proof
  sorry

-- Localization.isLocalization.
theorem localizationAlgebra.is_localization
  shows IsLocalization(S, localizationAlgebra(R, S))
proof
  sorry

theorem fraction.mem (a s : Set)
  requires element : a ∈ R.carrier
  requires denominator : s ∈ S
  shows fraction(R, S, a, s) ∈ Ring.carrier(localizationRing(R, S))
proof
  sorry

-- Localization.mk_eq_mk_iff, Localization.r_of_eq.
theorem fraction.eq_iff (a s b t : Set)
  requires first : a ∈ R.carrier
  requires firstDenominator : s ∈ S
  requires second : b ∈ R.carrier
  requires secondDenominator : t ∈ S
  shows fraction(R, S, a, s) = fraction(R, S, b, t) ↔
    (∃ u ∈ S, call2(R.mul, u, Ring.sub(R, call2(R.mul, a, t),
      call2(R.mul, b, s))) = R.zero)
proof
  sorry

-- The operations on fractions.
theorem fraction.add (a s b t : Set)
  requires first : a ∈ R.carrier
  requires firstDenominator : s ∈ S
  requires second : b ∈ R.carrier
  requires secondDenominator : t ∈ S
  shows call2(Ring.add(localizationRing(R, S)), fraction(R, S, a, s),
      fraction(R, S, b, t)) =
    fraction(R, S, call2(R.add, call2(R.mul, a, t), call2(R.mul, b, s)),
      call2(R.mul, s, t))
proof
  sorry

theorem fraction.mul (a s b t : Set)
  requires first : a ∈ R.carrier
  requires firstDenominator : s ∈ S
  requires second : b ∈ R.carrier
  requires secondDenominator : t ∈ S
  shows call2(Ring.mul(localizationRing(R, S)), fraction(R, S, a, s),
      fraction(R, S, b, t)) =
    fraction(R, S, call2(R.mul, a, b), call2(R.mul, s, t))
proof
  sorry

-- Localization.ind: every element is a fraction.
theorem localizationRing.fraction_cases (z : Set)
  requires member : z ∈ Ring.carrier(localizationRing(R, S))
  shows ∃ a ∈ R.carrier, ∃ s ∈ S, z = fraction(R, S, a, s)
proof
  sorry

-- The construction lifts along every map sending S to units
-- (Localization.awayLift, IsLocalization.lift on Localization).
theorem localizationLift.hom (B g : Set)
  requires target : CommRing(B)
  requires hom : g : R →+* B
  requires units : ∀ s ∈ S, RingUnit(B, g(s))
  shows RingHom(localizationLift(R, S, B, g), localizationRing(R, S), B) ∧
    (∀ a ∈ R.carrier, localizationLift(R, S, B, g)(localizationMap(R, S)(a)) = g(a))
proof
  sorry

end Construction

-- Section: Laws of localizations
section Localizations
variable (S A : Set)
hypothesis localization : IsLocalization(S, A)

theorem IsLocalization.algebra
  shows Algebra(A)
proof
  exact localization.left

theorem IsLocalization.multiplicative
  shows MultiplicativeSubset(Algebra.base(A), S)
proof
  obtain ⟨_, m, _⟩ := localization
  exact m

-- IsLocalization.map_units.
theorem IsLocalization.map_units (s : Set)
  requires member : s ∈ S
  shows RingUnit(Algebra.ring(A), Algebra.map(A)(s))
proof
  obtain ⟨_, _, units, _⟩ := localization
  exact units with s, member

-- IsLocalization.surj and IsLocalization.mk'_surjective.
theorem IsLocalization.surj (z : Set)
  requires member : z ∈ algebraCarrier(A)
  shows ∃ a ∈ Ring.carrier(Algebra.base(A)), ∃ s ∈ S,
    call2(Ring.mul(Algebra.ring(A)), z, Algebra.map(A)(s)) = Algebra.map(A)(a)
proof
  obtain ⟨_, _, _, surj, _⟩ := localization
  exact surj with z, member

-- Helper: the basic facts in a localization, gathered.
theorem IsLocalization.unit_inverse (s : Set)
  requires member : s ∈ S
  shows Algebra.map(A)(s) ∈ algebraCarrier(A) ∧
    ringInverse(Algebra.ring(A), Algebra.map(A)(s)) ∈ algebraCarrier(A) ∧
    call2(Ring.mul(Algebra.ring(A)), ringInverse(Algebra.ring(A), Algebra.map(A)(s)), Algebra.map(A)(s)) = Ring.one(Algebra.ring(A)) ∧
    call2(Ring.mul(Algebra.ring(A)), Algebra.map(A)(s), ringInverse(Algebra.ring(A), Algebra.map(A)(s))) = Ring.one(Algebra.ring(A))
proof
  have loc0 := localization
  obtain ⟨alg, m, units, _⟩ := loc0
  obtain ⟨sub, _, _⟩ := m
  have sIn := sub with member
  have u := units with s, member
  have cA := Algebra.comm_ring at A with alg
  have ringA := CommRing.to_ring with cA
  have fs : Algebra.map(A)(s) ∈ Ring.carrier(Algebra.ring(A)) by typecheck
  have vIn := ringInverse.mem at Algebra.ring(A), Algebra.map(A)(s) with cA, u
  have left := ringInverse.mul_left at Algebra.ring(A), Algebra.map(A)(s) with cA, u
  have right := ringInverse.right_law at Algebra.ring(A), Algebra.map(A)(s) with cA, u
  unfold algebraCarrier
  exact ⟨fs, vIn, left, right⟩

theorem IsLocalization.fraction_surjective (z : Set)
  requires member : z ∈ algebraCarrier(A)
  shows ∃ a ∈ Ring.carrier(Algebra.base(A)), ∃ s ∈ S,
    z = localizationFraction(A, a, s)
proof
  have alg := IsLocalization.algebra at S, A with localization
  have cA := Algebra.comm_ring at A with alg
  obtain ⟨a, aIn, s, sS, law⟩ := IsLocalization.surj at S, A, z with localization, member
  obtain ⟨fs, vIn, left, right⟩ := IsLocalization.unit_inverse at S, A, s with localization, sS
  unfold algebraCarrier at member
  unfold algebraCarrier at fs
  unfold algebraCarrier at vIn
  have eq : z = localizationFraction(A, a, s)
    unfold localizationFraction
    rw ← law
    have r : call2(Ring.mul(Algebra.ring(A)), call2(Ring.mul(Algebra.ring(A)), z, Algebra.map(A)(s)), ringInverse(Algebra.ring(A), Algebra.map(A)(s))) = call2(Ring.mul(Algebra.ring(A)), z, call2(Ring.mul(Algebra.ring(A)), Algebra.map(A)(s), ringInverse(Algebra.ring(A), Algebra.map(A)(s)))) by ring
    rw [r, right]
    ring
  exact ⟨a, aIn, s, sS, eq⟩

-- IsLocalization.eq_iff_exists.
theorem IsLocalization.eq_iff_exists (a b : Set)
  requires first : a ∈ Ring.carrier(Algebra.base(A))
  requires second : b ∈ Ring.carrier(Algebra.base(A))
  shows Algebra.map(A)(a) = Algebra.map(A)(b) ↔
    (∃ c ∈ S, call2(Ring.mul(Algebra.base(A)), c, a) =
      call2(Ring.mul(Algebra.base(A)), c, b))
proof
  have loc0 := localization
  obtain ⟨alg, _, _, _, faithful⟩ := loc0
  constructor
  . intro e
    exact faithful with a, first, b, second, e
  . intro h
    obtain ⟨c, cS, cab⟩ := h
    have m := IsLocalization.multiplicative at S, A with localization
    obtain ⟨sub, _, _⟩ := m
    have cIn := sub with cS
    have u := IsLocalization.map_units at S, A, c with localization, cS
    have fh := Algebra.structure_hom at A with alg
    have cA := Algebra.comm_ring at A with alg
    have cB := Algebra.base_comm_ring at A with alg
    have e := RingHom.map_mul at Algebra.map(A), Algebra.base(A), Algebra.ring(A), c, a with fh, cIn, first
    have e2 := RingHom.map_mul at Algebra.map(A), Algebra.base(A), Algebra.ring(A), c, b with fh, cIn, second
    rw cab at e
    rw e2 at e
    obtain ⟨vUnit, right⟩ := ringInverse.unit at Algebra.ring(A), Algebra.map(A)(c) with cA, u
    have fcIn : Algebra.map(A)(c) ∈ Ring.carrier(Algebra.ring(A)) by typecheck
    have faIn : Algebra.map(A)(a) ∈ Ring.carrier(Algebra.ring(A)) by typecheck
    have fbIn : Algebra.map(A)(b) ∈ Ring.carrier(Algebra.ring(A)) by typecheck
    have vIn := ringInverse.mem at Algebra.ring(A), Algebra.map(A)(c) with *
    have left := ringInverse.mul_left at Algebra.ring(A), Algebra.map(A)(c) with *
    have ea : Algebra.map(A)(a) = ringInverse(Algebra.ring(A), Algebra.map(A)(c)) * (Algebra.map(A)(c) * Algebra.map(A)(a))
      have r : ringInverse(Algebra.ring(A), Algebra.map(A)(c)) * (Algebra.map(A)(c) * Algebra.map(A)(a)) = (ringInverse(Algebra.ring(A), Algebra.map(A)(c)) * Algebra.map(A)(c)) * Algebra.map(A)(a) by ring
      rw [r, left]
      ring
    rw [ea, ← e]
    have r2 : ringInverse(Algebra.ring(A), Algebra.map(A)(c)) * (Algebra.map(A)(c) * Algebra.map(A)(b)) = (ringInverse(Algebra.ring(A), Algebra.map(A)(c)) * Algebra.map(A)(c)) * Algebra.map(A)(b) by ring
    rw [r2, left]
    ring

-- IsLocalization.mk'_spec and mk'_eq_iff_eq.
theorem localizationFraction.spec (a s : Set)
  requires element : a ∈ Ring.carrier(Algebra.base(A))
  requires denominator : s ∈ S
  shows call2(Ring.mul(Algebra.ring(A)), localizationFraction(A, a, s),
    Algebra.map(A)(s)) = Algebra.map(A)(a)
proof
  have alg := IsLocalization.algebra at S, A with localization
  have cA := Algebra.comm_ring at A with alg
  obtain ⟨fs, vIn, left, right⟩ := IsLocalization.unit_inverse at S, A, s with localization, denominator
  unfold algebraCarrier at fs
  unfold algebraCarrier at vIn
  have fa : Algebra.map(A)(a) ∈ Ring.carrier(Algebra.ring(A)) by typecheck
  unfold localizationFraction
  have r : call2(Ring.mul(Algebra.ring(A)), call2(Ring.mul(Algebra.ring(A)), Algebra.map(A)(a), ringInverse(Algebra.ring(A), Algebra.map(A)(s))), Algebra.map(A)(s)) = call2(Ring.mul(Algebra.ring(A)), Algebra.map(A)(a), call2(Ring.mul(Algebra.ring(A)), ringInverse(Algebra.ring(A), Algebra.map(A)(s)), Algebra.map(A)(s))) by ring
  rw [r, left]
  ring

theorem localizationFraction.eq_iff (a s b t : Set)
  requires first : a ∈ Ring.carrier(Algebra.base(A))
  requires firstDenominator : s ∈ S
  requires second : b ∈ Ring.carrier(Algebra.base(A))
  requires secondDenominator : t ∈ S
  shows localizationFraction(A, a, s) = localizationFraction(A, b, t) ↔
    Algebra.map(A)(call2(Ring.mul(Algebra.base(A)), a, t)) =
      Algebra.map(A)(call2(Ring.mul(Algebra.base(A)), b, s))
proof
  sorry

-- IsLocalization.injective: f is injective when S has no zero divisors.
theorem IsLocalization.injective
  requires noZeroDivisors : S ⊆ nonZeroDivisors(Algebra.base(A))
  shows InjectiveBetween(Algebra.map(A), Ring.carrier(Algebra.base(A)),
    algebraCarrier(A))
proof
  have alg := IsLocalization.algebra at S, A with localization
  have cB := Algebra.base_comm_ring at A with alg
  have fn := Algebra.map_function at A with alg
  apply Injective.of_pointwise with fn
  intros a aIn b bIn e
  obtain ⟨c, cS, cab⟩ := (IsLocalization.eq_iff_exists at S, A, a, b with localization, aIn, bIn).forward with e
  have cN := noZeroDivisors with cS
  obtain ⟨cIn, kills⟩ := nonZeroDivisors.membership.forward at Algebra.base(A), c with cN
  have dIn : Ring.sub(Algebra.base(A), a, b) ∈ Ring.carrier(Algebra.base(A)) by typecheck
  have prod : call2(Ring.mul(Algebra.base(A)), Ring.sub(Algebra.base(A), a, b), c) = Ring.zero(Algebra.base(A))
    have r : call2(Ring.mul(Algebra.base(A)), Ring.sub(Algebra.base(A), a, b), c) = Ring.sub(Algebra.base(A), call2(Ring.mul(Algebra.base(A)), c, a), call2(Ring.mul(Algebra.base(A)), c, b)) by ring
    rw [r, cab]
    ring
  have dz := kills with Ring.sub(Algebra.base(A), a, b), dIn, prod
  have back : a = call2(Ring.add(Algebra.base(A)), Ring.sub(Algebra.base(A), a, b), b) by ring
  rw [back, dz]
  ring

-- IsLocalization.lift with IsLocalization.lift_eq, ringHom_ext and
-- algHom_ext: homomorphisms out of a localization are determined on R.
theorem isLocalizationLift.spec (B g : Set)
  requires target : CommRing(B)
  requires hom : g : Algebra.base(A) →+* B
  requires units : ∀ s ∈ S, RingUnit(B, g(s))
  shows RingHom(isLocalizationLift(S, A, B, g), Algebra.ring(A), B) ∧
    (∀ a ∈ Ring.carrier(Algebra.base(A)),
      isLocalizationLift(S, A, B, g)(Algebra.map(A)(a)) = g(a))
proof
  sorry

theorem IsLocalization.hom_ext (B h k : Set)
  requires target : CommRing(B)
  requires first : h : Algebra.ring(A) →+* B
  requires second : k : Algebra.ring(A) →+* B
  requires agree : ∀ a ∈ Ring.carrier(Algebra.base(A)),
    h(Algebra.map(A)(a)) = k(Algebra.map(A)(a))
  shows h = k
proof
  have hom1c := first
  obtain ⟨_, _, fn1, _⟩ := hom1c
  have hom2c := second
  obtain ⟨_, _, fn2, _⟩ := hom2c
  apply FunctionBetween.ext with fn1, fn2
  intros z zIn
  have alg := IsLocalization.algebra at S, A with localization
  have cA := Algebra.comm_ring at A with alg
  have zA : z ∈ algebraCarrier(A)
    unfold algebraCarrier
    exact zIn
  obtain ⟨a, aIn, s, sS, law⟩ := IsLocalization.surj at S, A, z with localization, zA
  have u := IsLocalization.map_units at S, A, s with localization, sS
  obtain ⟨fsA, vIn, left, right⟩ := IsLocalization.unit_inverse at S, A, s with localization, sS
  unfold algebraCarrier at fsA
  unfold algebraCarrier at vIn
  have zEq : z = call2(Ring.mul(Algebra.ring(A)), Algebra.map(A)(a), ringInverse(Algebra.ring(A), Algebra.map(A)(s)))
    rw ← law
    have r : call2(Ring.mul(Algebra.ring(A)), call2(Ring.mul(Algebra.ring(A)), z, Algebra.map(A)(s)), ringInverse(Algebra.ring(A), Algebra.map(A)(s))) = call2(Ring.mul(Algebra.ring(A)), z, call2(Ring.mul(Algebra.ring(A)), Algebra.map(A)(s), ringInverse(Algebra.ring(A), Algebra.map(A)(s)))) by ring
    rw [r, right]
    ring
  have m := IsLocalization.multiplicative at S, A with localization
  obtain ⟨sub, _, _⟩ := m
  have sIn := sub with sS
  have fa : Algebra.map(A)(a) ∈ Ring.carrier(Algebra.ring(A)) by typecheck
  rw zEq
  rw [(RingHom.map_mul at h, Algebra.ring(A), B, Algebra.map(A)(a), ringInverse(Algebra.ring(A), Algebra.map(A)(s)) with first, fa, vIn), (RingHom.map_mul at k, Algebra.ring(A), B, Algebra.map(A)(a), ringInverse(Algebra.ring(A), Algebra.map(A)(s)) with second, fa, vIn)]
  have hv : h(ringInverse(Algebra.ring(A), Algebra.map(A)(s))) = k(ringInverse(Algebra.ring(A), Algebra.map(A)(s)))
    have eh := RingHom.map_mul at h, Algebra.ring(A), B, ringInverse(Algebra.ring(A), Algebra.map(A)(s)), Algebra.map(A)(s) with first, vIn, fsA
    have ek := RingHom.map_mul at k, Algebra.ring(A), B, ringInverse(Algebra.ring(A), Algebra.map(A)(s)), Algebra.map(A)(s) with second, vIn, fsA
    rw [left, (RingHom.map_one at h, Algebra.ring(A), B with first)] at eh
    rw [left, (RingHom.map_one at k, Algebra.ring(A), B with second)] at ek
    have hs := agree with s, sIn
    have hvIn : h(ringInverse(Algebra.ring(A), Algebra.map(A)(s))) ∈ Ring.carrier(B) by typecheck
    have kvIn : k(ringInverse(Algebra.ring(A), Algebra.map(A)(s))) ∈ Ring.carrier(B) by typecheck
    have ksIn : k(Algebra.map(A)(s)) ∈ Ring.carrier(B) by typecheck
    have c : h(ringInverse(Algebra.ring(A), Algebra.map(A)(s))) = call2(Ring.mul(B), h(ringInverse(Algebra.ring(A), Algebra.map(A)(s))), call2(Ring.mul(B), k(Algebra.map(A)(s)), k(ringInverse(Algebra.ring(A), Algebra.map(A)(s)))))
      have rk := RingHom.map_mul at k, Algebra.ring(A), B, Algebra.map(A)(s), ringInverse(Algebra.ring(A), Algebra.map(A)(s)) with second, fsA, vIn
      rw [right, (RingHom.map_one at k, Algebra.ring(A), B with second)] at rk
      rw ← rk
      ring
    rw c
    rw ← hs
    have r : call2(Ring.mul(B), h(ringInverse(Algebra.ring(A), Algebra.map(A)(s))), call2(Ring.mul(B), h(Algebra.map(A)(s)), k(ringInverse(Algebra.ring(A), Algebra.map(A)(s))))) = call2(Ring.mul(B), call2(Ring.mul(B), h(ringInverse(Algebra.ring(A), Algebra.map(A)(s))), h(Algebra.map(A)(s))), k(ringInverse(Algebra.ring(A), Algebra.map(A)(s)))) by ring
    rw [r, ← eh]
    ring
  rw [hv, (agree with a, aIn)]

-- IsLocalization.lift_surjective_iff and lift_injective_iff, in the
-- injective form: the lift is injective when g(a) = g(b) forces
-- c a = c b for some c ∈ S.
theorem isLocalizationLift.injective (B g : Set)
  requires target : CommRing(B)
  requires hom : g : Algebra.base(A) →+* B
  requires units : ∀ s ∈ S, RingUnit(B, g(s))
  requires faithful : ∀ a b ∈ Ring.carrier(Algebra.base(A)), g(a) = g(b) →
    (∃ c ∈ S, call2(Ring.mul(Algebra.base(A)), c, a) =
      call2(Ring.mul(Algebra.base(A)), c, b))
  shows InjectiveBetween(isLocalizationLift(S, A, B, g), algebraCarrier(A),
    Ring.carrier(B))
proof
  sorry

-- Uniqueness of localizations: two localizations at S are isomorphic by
-- an algebra isomorphism (IsLocalization.algEquiv), and a ring isomorphic
-- to a localization over R is one (isLocalization_iff_of_ringEquiv).
theorem IsLocalization.unique (B : Set)
  requires other : IsLocalization(S, B)
  requires sameBase : Algebra.base(B) = Algebra.base(A)
  shows ∃ e, e : A ≃ₐ B
proof
  sorry

theorem IsLocalization.of_iso (B e : Set)
  requires iso : e : A ≃ₐ B
  shows IsLocalization(S, B)
proof
  sorry

-- IsLocalization.atUnits: localizing at units changes nothing.
theorem IsLocalization.at_units
  requires units : S ⊆ ringUnits(Algebra.base(A))
  shows BijectiveBetween(Algebra.map(A), Ring.carrier(Algebra.base(A)),
    algebraCarrier(A))
proof
  sorry

-- IsLocalization.subsingleton: localizing at a set containing 0 gives the
-- zero ring.
theorem IsLocalization.zero_mem
  requires zero : Ring.zero(Algebra.base(A)) ∈ S
  shows Ring.zero(Algebra.ring(A)) = Ring.one(Algebra.ring(A))
proof
  have alg := IsLocalization.algebra at S, A with localization
  have cA := Algebra.comm_ring at A with alg
  have fh := Algebra.structure_hom at A with alg
  have z0 := RingHom.map_zero at Algebra.map(A), Algebra.base(A), Algebra.ring(A) with fh
  obtain ⟨fs, vIn, left, right⟩ := IsLocalization.unit_inverse at S, A, Ring.zero(Algebra.base(A)) with localization, zero
  unfold algebraCarrier at vIn
  rw z0 at vIn
  rw z0 at left
  rw ← left
  ring

-- IsLocalization.exist_integer_multiples_of_finite: finitely many
-- elements of A become elements of R after one common denominator.
theorem IsLocalization.common_denominator (n z : Set)
  requires natural : Nat(n)
  requires family : z : n → algebraCarrier(A)
  shows ∃ s ∈ S, ∀ i ∈ n, ∃ a ∈ Ring.carrier(Algebra.base(A)),
    call2(Ring.mul(Algebra.ring(A)), Algebra.map(A)(s), z(i)) = Algebra.map(A)(a)
proof
  sorry

-- The kernel of the structure map: a ↦ 0 iff s a = 0 for some s ∈ S
-- (IsLocalization.map_eq_zero_iff).
theorem IsLocalization.map_eq_zero_iff (a : Set)
  requires element : a ∈ Ring.carrier(Algebra.base(A))
  shows Algebra.map(A)(a) = Ring.zero(Algebra.ring(A)) ↔
    (∃ s ∈ S, call2(Ring.mul(Algebra.base(A)), s, a) = Ring.zero(Algebra.base(A)))
proof
  have alg := IsLocalization.algebra at S, A with localization
  have cA := Algebra.comm_ring at A with alg
  have cB := Algebra.base_comm_ring at A with alg
  have fh := Algebra.structure_hom at A with alg
  have z0 := RingHom.map_zero at Algebra.map(A), Algebra.base(A), Algebra.ring(A) with fh
  have zeroIn : Ring.zero(Algebra.base(A)) ∈ Ring.carrier(Algebra.base(A)) by typecheck
  have eqv := IsLocalization.eq_iff_exists at S, A, a, Ring.zero(Algebra.base(A)) with localization, element, zeroIn
  rw z0 at eqv
  rw eqv
  have m := IsLocalization.multiplicative at S, A with localization
  obtain ⟨sub, _, _⟩ := m
  constructor
  . intro h
    obtain ⟨c, cS, e⟩ := h
    have cIn := sub with cS
    have z : call2(Ring.mul(Algebra.base(A)), c, Ring.zero(Algebra.base(A))) = Ring.zero(Algebra.base(A)) by ring
    rw z at e
    exact ⟨c, cS, e⟩
  . intro h
    obtain ⟨c, cS, e⟩ := h
    have cIn := sub with cS
    have z : call2(Ring.mul(Algebra.base(A)), c, Ring.zero(Algebra.base(A))) = Ring.zero(Algebra.base(A)) by ring
    rw ← z at e
    exact ⟨c, cS, e⟩

-- Ideals: every ideal of A is the extension of its contraction
-- (IsLocalization.map_comap), contraction is injective on ideals, and the
-- prime ideals of A correspond to the primes of R disjoint from S
-- (IsLocalization.isPrime_iff_isPrime_disjoint, orderIsoOfPrime).
theorem IsLocalization.extension_contraction (J : Set)
  requires ideal : Ideal(Algebra.ring(A), J)
  shows idealExtension(Algebra.map(A), Algebra.ring(A),
      idealComap(Algebra.map(A), Ring.carrier(Algebra.base(A)), J)) = J
proof
  sorry

theorem IsLocalization.prime_contraction (J : Set)
  requires prime : PrimeIdeal(Algebra.ring(A), J)
  shows PrimeIdeal(Algebra.base(A),
      idealComap(Algebra.map(A), Ring.carrier(Algebra.base(A)), J)) ∧
    idealComap(Algebra.map(A), Ring.carrier(Algebra.base(A)), J) ∩ S = ∅
proof
  sorry

theorem IsLocalization.prime_extension (P : Set)
  requires prime : PrimeIdeal(Algebra.base(A), P)
  requires disjoint : P ∩ S = ∅
  shows PrimeIdeal(Algebra.ring(A), idealExtension(Algebra.map(A), Algebra.ring(A), P)) ∧
    idealComap(Algebra.map(A), Ring.carrier(Algebra.base(A)),
      idealExtension(Algebra.map(A), Algebra.ring(A), P)) = P
proof
  sorry

-- IsLocalization.map_algebraMap_ne_top_iff_disjoint: the extension of an
-- ideal is proper iff the ideal misses S.
theorem IsLocalization.extension_proper_iff (I : Set)
  requires ideal : Ideal(Algebra.base(A), I)
  shows ProperIdeal(Algebra.ring(A), idealExtension(Algebra.map(A), Algebra.ring(A), I)) ↔
    I ∩ S = ∅
proof
  sorry

-- A localization of a domain at a set without 0 is a domain
-- (IsLocalization.isDomain_of_le_nonZeroDivisors).
theorem IsLocalization.domain
  requires domain : IntegralDomain(Algebra.base(A))
  requires noZero : Ring.zero(Algebra.base(A)) ∉ S
  shows IntegralDomain(Algebra.ring(A))
proof
  sorry

end Localizations

-- Transitivity: localizing a localization at the image of a larger
-- multiplicative set is a localization (IsLocalization.localization_localization_isLocalization,
-- in the form S ⊆ T).
theorem IsLocalization.tower (S T A B : Set)
  requires first : IsLocalization(S, A)
  requires subset : S ⊆ T
  requires multiplicative : MultiplicativeSubset(Algebra.base(A), T)
  requires second : IsLocalization(functionImage(Algebra.map(A), T, algebraCarrier(A)), B)
  requires overA : Algebra.base(B) = Algebra.ring(A)
  shows IsLocalization(T, Algebra.mk(Algebra.base(A), Algebra.ring(B),
    compose(Algebra.map(B), Algebra.map(A), Ring.carrier(Algebra.base(A)),
      algebraCarrier(A), algebraCarrier(B))))
proof
  sorry

-- The map of localizations induced by g : R →+* R' with g(S) ⊆ T
-- (IsLocalization.map, map_eq, map_comp), as a lift.
theorem IsLocalization.map_exists (S T A B g : Set)
  requires first : IsLocalization(S, A)
  requires second : IsLocalization(T, B)
  requires hom : g : Algebra.base(A) →+* Algebra.base(B)
  requires maps : ∀ s ∈ S, g(s) ∈ T
  shows ∃ h, RingHom(h, Algebra.ring(A), Algebra.ring(B)) ∧
    (∀ a ∈ Ring.carrier(Algebra.base(A)), h(Algebra.map(A)(a)) = Algebra.map(B)(g(a)))
proof
  sorry

-- Section: Away and at a prime
section Away
variable (x A : Set)
hypothesis away : IsLocalizationAway(x, A)

-- IsLocalization.Away.algebraMap_isUnit, Away.surj, Away.lift.
theorem IsLocalizationAway.unit
  shows RingUnit(Algebra.ring(A), Algebra.map(A)(x))
proof
  sorry

theorem IsLocalizationAway.surj (z : Set)
  requires member : z ∈ algebraCarrier(A)
  shows ∃ a ∈ Ring.carrier(Algebra.base(A)), ∃ n ∈ ℕ,
    call2(Ring.mul(Algebra.ring(A)), z,
      Ring.pow(Algebra.ring(A), Algebra.map(A)(x), n)) = Algebra.map(A)(a)
proof
  sorry

-- IsLocalization.Away.lift: a map sending x to a unit extends.
theorem IsLocalizationAway.lift (B g : Set)
  requires target : CommRing(B)
  requires hom : g : Algebra.base(A) →+* B
  requires unit : RingUnit(B, g(x))
  shows ∃ h, RingHom(h, Algebra.ring(A), B) ∧
    (∀ a ∈ Ring.carrier(Algebra.base(A)), h(Algebra.map(A)(a)) = g(a))
proof
  sorry

-- IsLocalization.Away.exists_of_eq.
theorem IsLocalizationAway.exists_of_eq (a b : Set)
  requires first : a ∈ Ring.carrier(Algebra.base(A))
  requires second : b ∈ Ring.carrier(Algebra.base(A))
  requires equal : Algebra.map(A)(a) = Algebra.map(A)(b)
  shows ∃ n ∈ ℕ, call2(Ring.mul(Algebra.base(A)), Ring.pow(Algebra.base(A), x, n), a) =
    call2(Ring.mul(Algebra.base(A)), Ring.pow(Algebra.base(A), x, n), b)
proof
  have loc := away
  unfold IsLocalizationAway at loc
  obtain ⟨c, cS, cab⟩ := (IsLocalization.eq_iff_exists at ringPowers(Algebra.base(A), x), A, a, b with loc, first, second).forward with equal
  obtain ⟨_, n, nIn, cn⟩ := ringPowers.membership.forward at Algebra.base(A), x, c with cS
  rw cn at cab
  exact ⟨n, nIn, cab⟩

end Away

-- IsLocalization.AtPrime: the image of the prime is the set of nonunits
-- (IsLocalization.AtPrime.to_map_mem_maximal_iff,
-- AtPrime.isUnit_to_map_iff); the local ring structure is in
-- GRH.Algebra.LocalRings.
theorem IsLocalizationAtPrime.unit_iff (P A a : Set)
  requires atPrime : IsLocalizationAtPrime(P, A)
  requires element : a ∈ Ring.carrier(Algebra.base(A))
  shows RingUnit(Algebra.ring(A), Algebra.map(A)(a)) ↔ a ∉ P
proof
  obtain ⟨prime, loc⟩ := atPrime
  have alg := IsLocalization.algebra at primeComplement(Algebra.base(A), P), A with loc
  have cB := Algebra.base_comm_ring at A with alg
  have cA := Algebra.comm_ring at A with alg
  have fh := Algebra.structure_hom at A with alg
  constructor
  . intro u
    intro aP
    obtain ⟨_, w, wIn, fw, _⟩ := u
    have wA : w ∈ algebraCarrier(A)
      unfold algebraCarrier
      exact wIn
    obtain ⟨b, bIn, s, sS, law⟩ := IsLocalization.surj at primeComplement(Algebra.base(A), P), A, w with loc, wA
    have m := IsLocalization.multiplicative at primeComplement(Algebra.base(A), P), A with loc
    obtain ⟨sub, _, _⟩ := m
    have sIn := sub with sS
    have fa : Algebra.map(A)(a) ∈ Ring.carrier(Algebra.ring(A)) by typecheck
    have fs : Algebra.map(A)(s) ∈ Ring.carrier(Algebra.ring(A)) by typecheck
    have e : Algebra.map(A)(s) = Algebra.map(A)(call2(Ring.mul(Algebra.base(A)), a, b))
      rw (RingHom.map_mul at Algebra.map(A), Algebra.base(A), Algebra.ring(A), a, b with fh, element, bIn)
      rw ← law
      have r : call2(Ring.mul(Algebra.ring(A)), Algebra.map(A)(a), call2(Ring.mul(Algebra.ring(A)), w, Algebra.map(A)(s))) = call2(Ring.mul(Algebra.ring(A)), call2(Ring.mul(Algebra.ring(A)), Algebra.map(A)(a), w), Algebra.map(A)(s)) by ring
      rw [r, fw]
      ring
    have abIn : call2(Ring.mul(Algebra.base(A)), a, b) ∈ Ring.carrier(Algebra.base(A)) by typecheck
    obtain ⟨c, cS, csab⟩ := (IsLocalization.eq_iff_exists at primeComplement(Algebra.base(A), P), A, s, call2(Ring.mul(Algebra.base(A)), a, b) with loc, sIn, abIn).forward with e
    have cIn := sub with cS
    have ringB := CommRing.to_ring with cB
    have idP := PrimeIdeal.to_ideal at Algebra.base(A), P with prime
    have abP := Ideal.mul_right_mem at Algebra.base(A), P, b, a with idP, bIn, aP
    have cabP := Ideal.mul_left_mem at Algebra.base(A), P, c, call2(Ring.mul(Algebra.base(A)), a, b) with idP, cIn, abP
    rw ← csab at cabP
    unfold primeComplement at cS
    unfold primeComplement at sS
    obtain ⟨_, cOut⟩ := (difference.membership at Ring.carrier(Algebra.base(A)), P, c).forward with cS
    obtain ⟨_, sOut⟩ := (difference.membership at Ring.carrier(Algebra.base(A)), P, s).forward with sS
    rcases PrimeIdeal.mem_or_mem at Algebra.base(A), P, c, s with ringB, prime, cIn, sIn, cabP with x1 | x2
    . exact cOut with x1
    . exact sOut with x2
  . intro aOut
    have aC : a ∈ primeComplement(Algebra.base(A), P)
      unfold primeComplement
      exact (difference.membership at Ring.carrier(Algebra.base(A)), P, a).backward with ⟨element, aOut⟩
    exact IsLocalization.map_units at primeComplement(Algebra.base(A), P), A, a with loc, aC

theorem IsLocalizationAtPrime.contraction_maximal (P A : Set)
  requires atPrime : IsLocalizationAtPrime(P, A)
  shows idealComap(Algebra.map(A), Ring.carrier(Algebra.base(A)),
    idealExtension(Algebra.map(A), Algebra.ring(A), P)) = P
proof
  sorry

-- IsLocalization.bot_lt_under_prime / disjoint_under_iff, primes of the
-- localization at P are the primes of R inside P.
theorem IsLocalizationAtPrime.primes (P A Q : Set)
  requires atPrime : IsLocalizationAtPrime(P, A)
  requires prime : PrimeIdeal(Algebra.base(A), Q)
  shows Q ∩ primeComplement(Algebra.base(A), P) = ∅ ↔ Q ⊆ P
proof
  obtain ⟨primeP, loc⟩ := atPrime
  have alg := IsLocalization.algebra at primeComplement(Algebra.base(A), P), A with loc
  have idQ := PrimeIdeal.to_ideal at Algebra.base(A), Q with prime
  have bQ := Ideal.subset at Algebra.base(A), Q with idQ
  constructor
  . intro disj
    intros q qQ
    by_contra qP
    have qIn := bQ with qQ
    have qC : q ∈ primeComplement(Algebra.base(A), P)
      unfold primeComplement
      exact (difference.membership at Ring.carrier(Algebra.base(A)), P, q).backward with ⟨qIn, qP⟩
    have both := (intersection.membership at Q, primeComplement(Algebra.base(A), P), q).backward with ⟨qQ, qC⟩
    rw disj at both
    exact empty.membership at q with both
  . intro sub
    apply Subset.antisymmetric
    . intros q hq
      obtain ⟨qQ, qC⟩ := (intersection.membership at Q, primeComplement(Algebra.base(A), P), q).forward with hq
      unfold primeComplement at qC
      obtain ⟨_, qP⟩ := (difference.membership at Ring.carrier(Algebra.base(A)), P, q).forward with qC
      exfalso
      exact qP with (sub with qQ)
    . exact empty.subset at Q ∩ primeComplement(Algebra.base(A), P)

-- Section: Fraction fields
-- The fraction field of a domain is a field (IsFractionRing.toField), the
-- structure map is injective (IsFractionRing.injective), and every element
-- is a / b with b ≠ 0 (IsFractionRing.div_surjective).
section FractionFields
variable (A : Set)
hypothesis fractions : IsFractionRing(A)
hypothesis domain : IntegralDomain(Algebra.base(A))

theorem IsFractionRing.field
  shows Field(Algebra.ring(A))
proof
  sorry

theorem IsFractionRing.injective
  shows InjectiveBetween(Algebra.map(A), Ring.carrier(Algebra.base(A)),
    algebraCarrier(A))
proof
  have loc := fractions
  unfold IsFractionRing at loc
  have sub : nonZeroDivisors(Algebra.base(A)) ⊆ nonZeroDivisors(Algebra.base(A)) by exact Subset.reflexive at nonZeroDivisors(Algebra.base(A))
  exact IsLocalization.injective at nonZeroDivisors(Algebra.base(A)), A with loc, sub

theorem IsFractionRing.div_surjective (z : Set)
  requires member : z ∈ algebraCarrier(A)
  shows ∃ a b ∈ Ring.carrier(Algebra.base(A)), b ≠ Ring.zero(Algebra.base(A)) ∧
    call2(Ring.mul(Algebra.ring(A)), z, Algebra.map(A)(b)) = Algebra.map(A)(a)
proof
  have loc := fractions
  unfold IsFractionRing at loc
  obtain ⟨a, aIn, s, sS, law⟩ := IsLocalization.surj at nonZeroDivisors(Algebra.base(A)), A, z with loc, member
  obtain ⟨sIn, kills⟩ := nonZeroDivisors.membership.forward at Algebra.base(A), s with sS
  have nt := IntegralDomain.nontrivial at Algebra.base(A) with domain
  have snz : s ≠ Ring.zero(Algebra.base(A))
    intro sz
    have oneIn : Ring.one(Algebra.base(A)) ∈ Ring.carrier(Algebra.base(A)) by typecheck
    have cB := IntegralDomain.comm_ring at Algebra.base(A) with domain
    have p : call2(Ring.mul(Algebra.base(A)), Ring.one(Algebra.base(A)), s) = Ring.zero(Algebra.base(A))
      rw sz
      ring
    have oz := kills with Ring.one(Algebra.base(A)), oneIn, p
    have e : Ring.zero(Algebra.base(A)) = Ring.one(Algebra.base(A)) by rw oz
    exact nt with e
  exact ⟨a, aIn, s, sIn, snz, law⟩

-- IsFractionRing.lift: an injective map into a field extends to the
-- fraction field (IsFractionRing.liftAlgHom).
theorem IsFractionRing.lift (K g : Set)
  requires field : Field(K)
  requires hom : g : Algebra.base(A) →+* K
  requires injective : InjectiveBetween(g, Ring.carrier(Algebra.base(A)),
    Ring.carrier(K))
  shows ∃ h, RingHom(h, Algebra.ring(A), K) ∧
    InjectiveBetween(h, algebraCarrier(A), Ring.carrier(K)) ∧
    (∀ a ∈ Ring.carrier(Algebra.base(A)), h(Algebra.map(A)(a)) = g(a))
proof
  sorry

end FractionFields

-- A domain's construction FractionRing is a fraction field.
theorem fractionRing.is_fraction_ring (R : Set)
  requires domain : IntegralDomain(R)
  shows IsFractionRing(localizationAlgebra(R, nonZeroDivisors(R))) ∧
    Field(fractionRing(R))
proof
  sorry

-- A field is its own fraction field.
theorem Field.is_fraction_ring_self (K : Set)
  requires field : Field(K)
  shows IsFractionRing(Algebra.mk(K, K, identity(Ring.carrier(K))))
proof
  sorry
