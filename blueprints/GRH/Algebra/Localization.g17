-- Localization of a commutative ring at a multiplicative subset: the
-- ring of fractions a / s built on classes of pairs, the characteristic
-- predicate of a localization (Mathlib's IsLocalization) with its
-- universal property and uniqueness, localization away from an element
-- and at a prime ideal, the total ring of fractions and the fraction
-- field of a domain, and the correspondence of prime ideals
-- (IsLocalization.orderIsoOfPrime).
-- Part of the GRH blueprint.
-- Planned home: Algebra/Ring/Localization (beside Cumulus's
-- localization inside an ambient ring).
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Algebra.Localization
import GRH.Algebra.Ideals
import Grace.Cumulus.Algebra.Algebras.Basic

-- Section: Multiplicative subsets
-- A multiplicative subset: contains 1 and is closed under products
-- (Mathlib's Submonoid of a commutative ring).
predicate MultiplicativeSubset (R S : Set) :=
  S ⊆ Ring.carrier(R) ∧ Ring.one(R) ∈ S ∧
  (∀ s t ∈ S, call2(Ring.mul(R), s, t) ∈ S)

-- The powers {xⁿ} of x (Submonoid.powers) and the complement of a prime
-- ideal (Ideal.primeCompl).
def ringPowers (R x : Set) : Set :=
  { y ∈ Ring.carrier(R) | ∃ n ∈ ℕ, y = Ring.pow(R, x, n) }

def primeComplement (R P : Set) : Set := Ring.carrier(R) ∖ P

-- Section: The construction
-- Pairs (a, s) ∈ R × S, identified when u (a t − b s) = 0 for some u ∈ S.
def fractionPairs (R S : Set) : Set := Ring.carrier(R) × S

def fractionRelation (R S : Set) : Set :=
  { q ∈ fractionPairs(R, S) × fractionPairs(R, S) |
    ∃ a ∈ Ring.carrier(R), ∃ s ∈ S, ∃ b ∈ Ring.carrier(R), ∃ t ∈ S,
      q = ((a, s), (b, t)) ∧ (∃ u ∈ S, call2(Ring.mul(R), u,
        Ring.sub(R, call2(Ring.mul(R), a, t), call2(Ring.mul(R), b, s))) =
        Ring.zero(R)) }

def localizationCarrier (R S : Set) : Set :=
  fractionPairs(R, S) ⧸ fractionRelation(R, S)

-- The fraction a / s, the class of (a, s) (IsLocalization.mk').
def fraction (R S a s : Set) : Set :=
  ⟦(a, s)⟧[fractionPairs(R, S), fractionRelation(R, S)]

-- a/s + b/t = (a t + b s)/(s t), (a/s)(b/t) = (a b)/(s t), −(a/s) = (−a)/s,
-- as graphs on classes (well defined because the relation is a
-- congruence).
def localizationAdd (R S : Set) : Set :=
  { q ∈ (localizationCarrier(R, S) × localizationCarrier(R, S)) ×
      localizationCarrier(R, S) |
    ∃ a ∈ Ring.carrier(R), ∃ s ∈ S, ∃ b ∈ Ring.carrier(R), ∃ t ∈ S,
      q = ((fraction(R, S, a, s), fraction(R, S, b, t)),
        fraction(R, S, call2(Ring.add(R), call2(Ring.mul(R), a, t),
          call2(Ring.mul(R), b, s)), call2(Ring.mul(R), s, t))) }

def localizationMul (R S : Set) : Set :=
  { q ∈ (localizationCarrier(R, S) × localizationCarrier(R, S)) ×
      localizationCarrier(R, S) |
    ∃ a ∈ Ring.carrier(R), ∃ s ∈ S, ∃ b ∈ Ring.carrier(R), ∃ t ∈ S,
      q = ((fraction(R, S, a, s), fraction(R, S, b, t)),
        fraction(R, S, call2(Ring.mul(R), a, b), call2(Ring.mul(R), s, t))) }

def localizationNeg (R S : Set) : Set :=
  { q ∈ localizationCarrier(R, S) × localizationCarrier(R, S) |
    ∃ a ∈ Ring.carrier(R), ∃ s ∈ S,
      q = (fraction(R, S, a, s), fraction(R, S, apply(Ring.neg(R), a), s)) }

-- The localization S⁻¹R (Mathlib's Localization S).
def localizationRing (R S : Set) : Set :=
  Ring.mk(localizationCarrier(R, S), localizationAdd(R, S),
    fraction(R, S, Ring.zero(R), Ring.one(R)), localizationNeg(R, S),
    localizationMul(R, S), fraction(R, S, Ring.one(R), Ring.one(R)))

-- The structure map a ↦ a / 1 (algebraMap R (Localization S)), and S⁻¹R
-- as an R-algebra.
def localizationMap (R S : Set) : Set :=
  { p ∈ Ring.carrier(R) × localizationCarrier(R, S) |
    ∃ a ∈ Ring.carrier(R), p = (a, fraction(R, S, a, Ring.one(R))) }

def localizationAlgebra (R S : Set) : Set :=
  Algebra.mk(R, localizationRing(R, S), localizationMap(R, S))

-- Localization away from x and at a prime P (Localization.Away,
-- Localization.AtPrime), and the total ring of fractions (FractionRing),
-- the fraction field of a domain.
def localizationAway (R x : Set) : Set := localizationRing(R, ringPowers(R, x))

def localizationAtPrime (R P : Set) : Set :=
  localizationRing(R, primeComplement(R, P))

def fractionRing (R : Set) : Set := localizationRing(R, nonZeroDivisors(R))

-- For g : R → B sending S to units, the map a / s ↦ g(a) g(s)⁻¹
-- (IsLocalization.lift on the construction, Localization.awayLift).
def localizationLift (R S B g : Set) : Set :=
  { p ∈ localizationCarrier(R, S) × Ring.carrier(B) |
    ∃ a ∈ Ring.carrier(R), ∃ s ∈ S, p = (fraction(R, S, a, s),
      call2(Ring.mul(B), g(a), ringInverse(B, g(s)))) }

-- Section: The characteristic predicate
-- An R-algebra A (Cumulus's Algebra, with base R and structure map
-- f = Algebra.map(A)) is a localization of R at S when f sends S to units,
-- every element of A is f(a) f(s)⁻¹, and f(a) = f(b) only when c a = c b
-- for some c ∈ S (Mathlib's IsLocalization: map_units', surj',
-- exists_of_eq).
predicate IsLocalization (S A : Set) :=
  Algebra(A) ∧ MultiplicativeSubset(Algebra.base(A), S) ∧
  (∀ s ∈ S, RingUnit(Algebra.ring(A), Algebra.map(A)(s))) ∧
  (∀ z ∈ algebraCarrier(A), ∃ a ∈ Ring.carrier(Algebra.base(A)), ∃ s ∈ S,
    call2(Ring.mul(Algebra.ring(A)), z, Algebra.map(A)(s)) = Algebra.map(A)(a)) ∧
  (∀ a b ∈ Ring.carrier(Algebra.base(A)), Algebra.map(A)(a) = Algebra.map(A)(b) →
    (∃ c ∈ S, call2(Ring.mul(Algebra.base(A)), c, a) =
      call2(Ring.mul(Algebra.base(A)), c, b)))

-- IsLocalization.Away and IsLocalization.AtPrime, and IsFractionRing.
predicate IsLocalizationAway (x A : Set) :=
  IsLocalization(ringPowers(Algebra.base(A), x), A)

predicate IsLocalizationAtPrime (P A : Set) :=
  PrimeIdeal(Algebra.base(A), P) ∧
  IsLocalization(primeComplement(Algebra.base(A), P), A)

predicate IsFractionRing (A : Set) :=
  IsLocalization(nonZeroDivisors(Algebra.base(A)), A)

-- The fraction f(a) f(s)⁻¹ in a localization A (IsLocalization.mk').
def localizationFraction (A a s : Set) : Set :=
  call2(Ring.mul(Algebra.ring(A)), Algebra.map(A)(a),
    ringInverse(Algebra.ring(A), Algebra.map(A)(s)))

-- Helper: cancelling a unit factor on the right.
theorem RingUnit.cancel_right (B x y u : Set)
  requires ring : CommRing(B)
  requires unit : RingUnit(B, u)
  requires first : x ∈ Ring.carrier(B)
  requires second : y ∈ Ring.carrier(B)
  requires equal : call2(Ring.mul(B), x, u) = call2(Ring.mul(B), y, u)
  shows x = y
proof
  have uIn := unit.left
  have vIn := ringInverse.mem at B, u with ring, unit
  have r := ringInverse.right_law at B, u with ring, unit
  have ex : x = call2(Ring.mul(B), call2(Ring.mul(B), x, u), ringInverse(B, u))
    have e : call2(Ring.mul(B), call2(Ring.mul(B), x, u), ringInverse(B, u)) = call2(Ring.mul(B), x, call2(Ring.mul(B), u, ringInverse(B, u))) by ring
    rw [e, r]
    ring
  have ey : y = call2(Ring.mul(B), call2(Ring.mul(B), y, u), ringInverse(B, u))
    have e : call2(Ring.mul(B), call2(Ring.mul(B), y, u), ringInverse(B, u)) = call2(Ring.mul(B), y, call2(Ring.mul(B), u, ringInverse(B, u))) by ring
    rw [e, r]
    ring
  rw [ex, ey, equal]

-- Helper: the graph of the lift of g along a localization A of R at S:
-- z ↦ y exactly when z f(s) = f(a) and y g(s) = g(a).
def localizationLiftGraph (S A B g : Set) : Set :=
  { p ∈ algebraCarrier(A) × Ring.carrier(B) |
    ∃ z ∈ algebraCarrier(A), ∃ y ∈ Ring.carrier(B),
      ∃ a ∈ Ring.carrier(Algebra.base(A)), ∃ s ∈ S, p = (z, y) ∧
      call2(Ring.mul(Algebra.ring(A)), z, Algebra.map(A)(s)) = Algebra.map(A)(a) ∧
      call2(Ring.mul(B), y, g(s)) = g(a) }

section LiftConstruction
variable (S A B g : Set)
hypothesis localization : IsLocalization(S, A)
hypothesis target : CommRing(B)
hypothesis hom : g : Algebra.base(A) →+* B
hypothesis units : ∀ s ∈ S, RingUnit(B, g(s))

theorem localizationLiftGraph.well_defined (z y1 y2 a b s t : Set)
  requires zIn : z ∈ algebraCarrier(A)
  requires y1In : y1 ∈ Ring.carrier(B)
  requires y2In : y2 ∈ Ring.carrier(B)
  requires aIn : a ∈ Ring.carrier(Algebra.base(A))
  requires bIn : b ∈ Ring.carrier(Algebra.base(A))
  requires sS : s ∈ S
  requires tS : t ∈ S
  requires za : call2(Ring.mul(Algebra.ring(A)), z, Algebra.map(A)(s)) = Algebra.map(A)(a)
  requires zb : call2(Ring.mul(Algebra.ring(A)), z, Algebra.map(A)(t)) = Algebra.map(A)(b)
  requires ya : call2(Ring.mul(B), y1, g(s)) = g(a)
  requires yb : call2(Ring.mul(B), y2, g(t)) = g(b)
  shows y1 = y2
proof
  have loc0 := localization
  obtain ⟨alg, m, _, _, eqs⟩ := loc0
  obtain ⟨sub, _, closed⟩ := m
  have cA := Algebra.comm_ring at A with alg
  have cR := Algebra.base_comm_ring at A with alg
  have sh := Algebra.structure_hom at A with alg
  have sIn := sub with sS
  have tIn := sub with tS
  have zA : z ∈ Ring.carrier(Algebra.ring(A))
    unfold algebraCarrier at zIn
    exact zIn
  have fs : Algebra.map(A)(s) ∈ Ring.carrier(Algebra.ring(A)) by typecheck
  have ft : Algebra.map(A)(t) ∈ Ring.carrier(Algebra.ring(A)) by typecheck
  have atIn : call2(Ring.mul(Algebra.base(A)), a, t) ∈ Ring.carrier(Algebra.base(A)) by typecheck
  have bsIn : call2(Ring.mul(Algebra.base(A)), b, s) ∈ Ring.carrier(Algebra.base(A)) by typecheck
  have m1 := RingHom.map_mul at Algebra.map(A), Algebra.base(A), Algebra.ring(A), a, t with sh, aIn, tIn
  have m2 := RingHom.map_mul at Algebra.map(A), Algebra.base(A), Algebra.ring(A), b, s with sh, bIn, sIn
  have e : Algebra.map(A)(call2(Ring.mul(Algebra.base(A)), a, t)) = Algebra.map(A)(call2(Ring.mul(Algebra.base(A)), b, s))
    rw [m1, m2, ← za, ← zb]
    ring
  obtain ⟨c, cS, ce⟩ := eqs with call2(Ring.mul(Algebra.base(A)), a, t), atIn, call2(Ring.mul(Algebra.base(A)), b, s), bsIn, e
  have cIn := sub with cS
  have gce : g(call2(Ring.mul(Algebra.base(A)), c, call2(Ring.mul(Algebra.base(A)), a, t))) = g(call2(Ring.mul(Algebra.base(A)), c, call2(Ring.mul(Algebra.base(A)), b, s)))
    rw ce
  have g1 := RingHom.map_mul at g, Algebra.base(A), B, c, call2(Ring.mul(Algebra.base(A)), a, t) with hom, cIn, atIn
  have g2 := RingHom.map_mul at g, Algebra.base(A), B, c, call2(Ring.mul(Algebra.base(A)), b, s) with hom, cIn, bsIn
  have g3 := RingHom.map_mul at g, Algebra.base(A), B, a, t with hom, aIn, tIn
  have g4 := RingHom.map_mul at g, Algebra.base(A), B, b, s with hom, bIn, sIn
  rw [g1, g2, g3, g4] at gce
  have us := units with s, sS
  have ut := units with t, tS
  have uc := units with c, cS
  have gsIn : g(s) ∈ Ring.carrier(B) by typecheck
  have gtIn : g(t) ∈ Ring.carrier(B) by typecheck
  have gcIn : g(c) ∈ Ring.carrier(B) by typecheck
  have gaIn : g(a) ∈ Ring.carrier(B) by typecheck
  have gbIn : g(b) ∈ Ring.carrier(B) by typecheck
  have ust := RingUnit.mul at B, g(s), g(t) with target, us, ut
  have U := RingUnit.mul at B, call2(Ring.mul(B), g(s), g(t)), g(c) with target, ust, uc
  have eq : call2(Ring.mul(B), y1, call2(Ring.mul(B), call2(Ring.mul(B), g(s), g(t)), g(c))) = call2(Ring.mul(B), y2, call2(Ring.mul(B), call2(Ring.mul(B), g(s), g(t)), g(c)))
    have l : call2(Ring.mul(B), y1, call2(Ring.mul(B), call2(Ring.mul(B), g(s), g(t)), g(c))) = call2(Ring.mul(B), g(c), call2(Ring.mul(B), call2(Ring.mul(B), y1, g(s)), g(t))) by ring
    have r : call2(Ring.mul(B), y2, call2(Ring.mul(B), call2(Ring.mul(B), g(s), g(t)), g(c))) = call2(Ring.mul(B), g(c), call2(Ring.mul(B), call2(Ring.mul(B), y2, g(t)), g(s))) by ring
    rw [l, r, ya, yb]
    exact gce
  exact RingUnit.cancel_right at B, y1, y2, call2(Ring.mul(B), call2(Ring.mul(B), g(s), g(t)), g(c)) with target, U, y1In, y2In, eq

theorem localizationLiftGraph.function
  shows localizationLiftGraph(S, A, B, g) : algebraCarrier(A) → Ring.carrier(B)
proof
  have loc0 := localization
  obtain ⟨alg, m, _, surj, _⟩ := loc0
  obtain ⟨sub, _, _⟩ := m
  unfold FunctionBetween
  refine ⟨?_, ?_, ?_⟩
  . unfold RelationBetween
    intros q hq
    exact (localizationLiftGraph.membership.forward at S, A, B, g, q with hq).left
  . unfold Functional
    intros z y1 h1 y2 h2
    unfold relates at h1
    unfold relates at h2
    obtain ⟨_, z1, z1In, w1, w1In, a, aIn, s, sS, e1, za, ya⟩ := localizationLiftGraph.membership.forward at S, A, B, g, (z, y1) with h1
    obtain ⟨_, z2, z2In, w2, w2In, b, bIn, t, tS, e2, zb, yb⟩ := localizationLiftGraph.membership.forward at S, A, B, g, (z, y2) with h2
    obtain ⟨ez1, ey1⟩ := orderedPair.injective with e1
    obtain ⟨ez2, ey2⟩ := orderedPair.injective with e2
    rw [← ez1] at za
    rw [← ez2] at zb
    rw [← ey1] at ya
    rw [← ey2] at yb
    rw [← ez1] at z1In
    rw [← ey1] at w1In
    rw [← ey2] at w2In
    exact localizationLiftGraph.well_defined at S, A, B, g, z, y1, y2, a, b, s, t with localization, target, hom, units, z1In, w1In, w2In, aIn, bIn, sS, tS, za, zb, ya, yb
  . intros z zIn
    obtain ⟨a, aIn, s, sS, za⟩ := surj with z, zIn
    have sIn := sub with sS
    have u := units with s, sS
    have vIn := ringInverse.mem at B, g(s) with target, u
    have lft := ringInverse.mul_left at B, g(s) with target, u
    have gaIn : g(a) ∈ Ring.carrier(B) by typecheck
    have gsIn : g(s) ∈ Ring.carrier(B) by typecheck
    have yIn : call2(Ring.mul(B), g(a), ringInverse(B, g(s))) ∈ Ring.carrier(B) by typecheck
    have ya : call2(Ring.mul(B), call2(Ring.mul(B), g(a), ringInverse(B, g(s))), g(s)) = g(a)
      have e : call2(Ring.mul(B), call2(Ring.mul(B), g(a), ringInverse(B, g(s))), g(s)) = call2(Ring.mul(B), g(a), call2(Ring.mul(B), ringInverse(B, g(s)), g(s))) by ring
      rw [e, lft]
      ring
    have pq := product.pair at z, call2(Ring.mul(B), g(a), ringInverse(B, g(s))), algebraCarrier(A), Ring.carrier(B) with zIn, yIn
    have mem := localizationLiftGraph.membership.backward at S, A, B, g, (z, call2(Ring.mul(B), g(a), ringInverse(B, g(s)))) with ⟨pq, z, zIn, call2(Ring.mul(B), g(a), ringInverse(B, g(s))), yIn, a, aIn, s, sS, rfl, za, ya⟩
    witness call2(Ring.mul(B), g(a), ringInverse(B, g(s)))
    unfold relates
    exact ⟨yIn, mem⟩

theorem localizationLiftGraph.value (z a s : Set)
  requires zIn : z ∈ algebraCarrier(A)
  requires aIn : a ∈ Ring.carrier(Algebra.base(A))
  requires sS : s ∈ S
  requires za : call2(Ring.mul(Algebra.ring(A)), z, Algebra.map(A)(s)) = Algebra.map(A)(a)
  shows call2(Ring.mul(B), localizationLiftGraph(S, A, B, g)(z), g(s)) = g(a)
proof
  have fn := localizationLiftGraph.function at S, A, B, g with localization, target, hom, units
  have hzIn := FunctionBetween.apply_closed with fn, zIn
  have rel := FunctionBetween.relates_apply with fn, zIn
  unfold relates at rel
  obtain ⟨_, z1, z1In, w1, w1In, b, bIn, t, tS, e1, zb, yb⟩ := localizationLiftGraph.membership.forward at S, A, B, g, (z, localizationLiftGraph(S, A, B, g)(z)) with rel
  obtain ⟨ez1, ey1⟩ := orderedPair.injective with e1
  have loc0 := localization
  obtain ⟨_, m, _⟩ := loc0
  obtain ⟨sub, _, _⟩ := m
  have sIn := sub with sS
  have u := units with s, sS
  have vIn := ringInverse.mem at B, g(s) with target, u
  have lft := ringInverse.mul_left at B, g(s) with target, u
  have gaIn : g(a) ∈ Ring.carrier(B) by typecheck
  have gsIn : g(s) ∈ Ring.carrier(B) by typecheck
  have yIn : call2(Ring.mul(B), g(a), ringInverse(B, g(s))) ∈ Ring.carrier(B) by typecheck
  have ya : call2(Ring.mul(B), call2(Ring.mul(B), g(a), ringInverse(B, g(s))), g(s)) = g(a)
    have e : call2(Ring.mul(B), call2(Ring.mul(B), g(a), ringInverse(B, g(s))), g(s)) = call2(Ring.mul(B), g(a), call2(Ring.mul(B), ringInverse(B, g(s)), g(s))) by ring
    rw [e, lft]
    ring
  rw [← ez1] at zb
  rw [← ey1] at yb
  have same := localizationLiftGraph.well_defined at S, A, B, g, z, call2(Ring.mul(B), g(a), ringInverse(B, g(s))), localizationLiftGraph(S, A, B, g)(z), a, b, s, t with localization, target, hom, units, zIn, yIn, hzIn, aIn, bIn, sS, tS, za, zb, ya, yb
  rw ← same
  exact ya

end LiftConstruction

-- For a localization A of R at S and g : R →+* B sending S to units, the
-- unique homomorphism h : A →+* B with h ∘ f = g (IsLocalization.lift).
defunique isLocalizationLift (S A B g : Set)
    (h ∈ functionSpace(algebraCarrier(A), Ring.carrier(B))) :=
  RingHom(h, Algebra.ring(A), B) ∧
  (∀ a ∈ Ring.carrier(Algebra.base(A)), h(Algebra.map(A)(a)) = g(a))
requires localization : IsLocalization(S, A)
requires target : CommRing(B)
requires hom : g : Algebra.base(A) →+* B
requires units : ∀ s ∈ S, RingUnit(B, g(s))
proof
  have loc0 := localization
  obtain ⟨alg, m, _, surj, _⟩ := loc0
  obtain ⟨sub, oneS, closed⟩ := m
  have cA := Algebra.comm_ring at A with alg
  have cR := Algebra.base_comm_ring at A with alg
  have sh := Algebra.structure_hom at A with alg
  have fn0 := localizationLiftGraph.function at S, A, B, g with localization, target, hom, units
  have fn : localizationLiftGraph(S, A, B, g) : Ring.carrier(Algebra.ring(A)) → Ring.carrier(B)
    unfold algebraCarrier at fn0
    exact fn0
  have toA : ∀ z, z ∈ Ring.carrier(Algebra.ring(A)) → z ∈ algebraCarrier(A)
    intros z zIn
    unfold algebraCarrier
    exact zIn
  have oneR : Ring.one(Algebra.base(A)) ∈ Ring.carrier(Algebra.base(A)) by typecheck
  have f1 := RingHom.map_one at Algebra.map(A), Algebra.base(A), Algebra.ring(A) with sh
  have g1 := RingHom.map_one at g, Algebra.base(A), B with hom
  have additive : ∀ x y ∈ Ring.carrier(Algebra.ring(A)), localizationLiftGraph(S, A, B, g)(call2(Ring.add(Algebra.ring(A)), x, y)) = call2(Ring.add(B), localizationLiftGraph(S, A, B, g)(x), localizationLiftGraph(S, A, B, g)(y))
    intros x xIn y yIn
    obtain ⟨a, aIn, s, sS, xa⟩ := surj with x, (toA with x, xIn)
    obtain ⟨b, bIn, t, tS, yb⟩ := surj with y, (toA with y, yIn)
    have sIn := sub with sS
    have tIn := sub with tS
    have st := closed with s, sS, t, tS
    have atIn : call2(Ring.mul(Algebra.base(A)), a, t) ∈ Ring.carrier(Algebra.base(A)) by typecheck
    have bsIn : call2(Ring.mul(Algebra.base(A)), b, s) ∈ Ring.carrier(Algebra.base(A)) by typecheck
    have nIn : call2(Ring.add(Algebra.base(A)), call2(Ring.mul(Algebra.base(A)), a, t), call2(Ring.mul(Algebra.base(A)), b, s)) ∈ Ring.carrier(Algebra.base(A)) by typecheck
    have sumIn : call2(Ring.add(Algebra.ring(A)), x, y) ∈ Ring.carrier(Algebra.ring(A)) by typecheck
    have fst := RingHom.map_mul at Algebra.map(A), Algebra.base(A), Algebra.ring(A), s, t with sh, sIn, tIn
    have fat := RingHom.map_mul at Algebra.map(A), Algebra.base(A), Algebra.ring(A), a, t with sh, aIn, tIn
    have fbs := RingHom.map_mul at Algebra.map(A), Algebra.base(A), Algebra.ring(A), b, s with sh, bIn, sIn
    have fsum := RingHom.map_add at Algebra.map(A), Algebra.base(A), Algebra.ring(A), call2(Ring.mul(Algebra.base(A)), a, t), call2(Ring.mul(Algebra.base(A)), b, s) with sh, atIn, bsIn
    have fs : Algebra.map(A)(s) ∈ Ring.carrier(Algebra.ring(A)) by typecheck
    have ft : Algebra.map(A)(t) ∈ Ring.carrier(Algebra.ring(A)) by typecheck
    have rep : call2(Ring.mul(Algebra.ring(A)), call2(Ring.add(Algebra.ring(A)), x, y), Algebra.map(A)(call2(Ring.mul(Algebra.base(A)), s, t))) = Algebra.map(A)(call2(Ring.add(Algebra.base(A)), call2(Ring.mul(Algebra.base(A)), a, t), call2(Ring.mul(Algebra.base(A)), b, s)))
      rw [fst, fsum, fat, fbs, ← xa, ← yb]
      ring
    have v1 := localizationLiftGraph.value at S, A, B, g, x, a, s with localization, target, hom, units, (toA with x, xIn), aIn, sS, xa
    have v2 := localizationLiftGraph.value at S, A, B, g, y, b, t with localization, target, hom, units, (toA with y, yIn), bIn, tS, yb
    have v3 := localizationLiftGraph.value at S, A, B, g, call2(Ring.add(Algebra.ring(A)), x, y), call2(Ring.add(Algebra.base(A)), call2(Ring.mul(Algebra.base(A)), a, t), call2(Ring.mul(Algebra.base(A)), b, s)), call2(Ring.mul(Algebra.base(A)), s, t) with localization, target, hom, units, (toA with call2(Ring.add(Algebra.ring(A)), x, y), sumIn), nIn, st, rep
    have gst := RingHom.map_mul at g, Algebra.base(A), B, s, t with hom, sIn, tIn
    have gat := RingHom.map_mul at g, Algebra.base(A), B, a, t with hom, aIn, tIn
    have gbs := RingHom.map_mul at g, Algebra.base(A), B, b, s with hom, bIn, sIn
    have gsum := RingHom.map_add at g, Algebra.base(A), B, call2(Ring.mul(Algebra.base(A)), a, t), call2(Ring.mul(Algebra.base(A)), b, s) with hom, atIn, bsIn
