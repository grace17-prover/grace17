    have hy := FunctionBetween.apply_closed with fn, yIn
    have hxy := FunctionBetween.apply_closed with fn, sumIn
    have gsIn : g(s) ∈ Ring.carrier(B) by typecheck
    have gtIn : g(t) ∈ Ring.carrier(B) by typecheck
    have U := RingUnit.mul at B, g(s), g(t) with target, (units with s, sS), (units with t, tS)
    have rhsIn : call2(Ring.add(B), localizationLiftGraph(S, A, B, g)(x), localizationLiftGraph(S, A, B, g)(y)) ∈ Ring.carrier(B) by typecheck
    have eq : call2(Ring.mul(B), localizationLiftGraph(S, A, B, g)(call2(Ring.add(Algebra.ring(A)), x, y)), call2(Ring.mul(B), g(s), g(t))) = call2(Ring.mul(B), call2(Ring.add(B), localizationLiftGraph(S, A, B, g)(x), localizationLiftGraph(S, A, B, g)(y)), call2(Ring.mul(B), g(s), g(t)))
      rw v3
      have e : call2(Ring.mul(B), call2(Ring.add(B), localizationLiftGraph(S, A, B, g)(x), localizationLiftGraph(S, A, B, g)(y)), call2(Ring.mul(B), g(s), g(t))) = call2(Ring.add(B), call2(Ring.mul(B), call2(Ring.mul(B), localizationLiftGraph(S, A, B, g)(x), g(s)), g(t)), call2(Ring.mul(B), call2(Ring.mul(B), localizationLiftGraph(S, A, B, g)(y), g(t)), g(s))) by ring
      rw [e, v1, v2]
    exact RingUnit.cancel_right at B, localizationLiftGraph(S, A, B, g)(call2(Ring.add(Algebra.ring(A)), x, y)), call2(Ring.add(B), localizationLiftGraph(S, A, B, g)(x), localizationLiftGraph(S, A, B, g)(y)), call2(Ring.mul(B), g(s), g(t)) with target, U, hxy, rhsIn, eq
  have mult : ∀ x y ∈ Ring.carrier(Algebra.ring(A)), localizationLiftGraph(S, A, B, g)(call2(Ring.mul(Algebra.ring(A)), x, y)) = call2(Ring.mul(B), localizationLiftGraph(S, A, B, g)(x), localizationLiftGraph(S, A, B, g)(y))
    intros x xIn y yIn
    obtain ⟨a, aIn, s, sS, xa⟩ := surj with x, (toA with x, xIn)
    obtain ⟨b, bIn, t, tS, yb⟩ := surj with y, (toA with y, yIn)
    have sIn := sub with sS
    have tIn := sub with tS
    have st := closed with s, sS, t, tS
    have abIn : call2(Ring.mul(Algebra.base(A)), a, b) ∈ Ring.carrier(Algebra.base(A)) by typecheck
    have prodIn : call2(Ring.mul(Algebra.ring(A)), x, y) ∈ Ring.carrier(Algebra.ring(A)) by typecheck
    have fst := RingHom.map_mul at Algebra.map(A), Algebra.base(A), Algebra.ring(A), s, t with sh, sIn, tIn
    have fab := RingHom.map_mul at Algebra.map(A), Algebra.base(A), Algebra.ring(A), a, b with sh, aIn, bIn
    have fs : Algebra.map(A)(s) ∈ Ring.carrier(Algebra.ring(A)) by typecheck
    have ft : Algebra.map(A)(t) ∈ Ring.carrier(Algebra.ring(A)) by typecheck
    have rep : call2(Ring.mul(Algebra.ring(A)), call2(Ring.mul(Algebra.ring(A)), x, y), Algebra.map(A)(call2(Ring.mul(Algebra.base(A)), s, t))) = Algebra.map(A)(call2(Ring.mul(Algebra.base(A)), a, b))
      rw [fst, fab, ← xa, ← yb]
      ring
    have v1 := localizationLiftGraph.value at S, A, B, g, x, a, s with localization, target, hom, units, (toA with x, xIn), aIn, sS, xa
    have v2 := localizationLiftGraph.value at S, A, B, g, y, b, t with localization, target, hom, units, (toA with y, yIn), bIn, tS, yb
    have v3 := localizationLiftGraph.value at S, A, B, g, call2(Ring.mul(Algebra.ring(A)), x, y), call2(Ring.mul(Algebra.base(A)), a, b), call2(Ring.mul(Algebra.base(A)), s, t) with localization, target, hom, units, (toA with call2(Ring.mul(Algebra.ring(A)), x, y), prodIn), abIn, st, rep
    have gst := RingHom.map_mul at g, Algebra.base(A), B, s, t with hom, sIn, tIn
    have gab := RingHom.map_mul at g, Algebra.base(A), B, a, b with hom, aIn, bIn
    rw [gst, gab] at v3
    have hx := FunctionBetween.apply_closed with fn, xIn
    have hy := FunctionBetween.apply_closed with fn, yIn
