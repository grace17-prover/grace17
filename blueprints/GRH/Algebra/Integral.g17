-- Integral elements and integral closure: x in an R-algebra A is integral
-- when it is a root of a monic polynomial over R (Mathlib's IsIntegral),
-- integral algebras (Algebra.IsIntegral), the integral closure as a
-- subalgebra, integral closures and integrally closed domains
-- (IsIntegralClosure, IsIntegrallyClosedIn, IsIntegrallyClosed), algebraic
-- elements over a field, the finiteness characterization, transitivity,
-- determinants of integral matrices, lying over and going up, and the
-- integral closedness of unique factorization domains.
-- Part of the GRH blueprint.
-- Planned home: Algebra/Ring/Integral (beside Cumulus's IntegralOver).
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Algebra.Integral
import GRH.Algebra.Finiteness
import Grace.Cumulus.Algebra.IntegralFinite
import Grace.Cumulus.Algebra.Field.IntegralDescent

-- Section: Integral and algebraic elements
-- x ∈ A is integral over R = Algebra.base(A): p(x) = 0 for a monic p ∈ R[X]
-- (IsIntegral). Cumulus's IntegralOver is the same notion with the monic
-- polynomial as a coefficient list.
predicate IntegralElement (A x : Set) :=
  Algebra(A) ∧ x ∈ algebraCarrier(A) ∧
  (∃ p, PolyMonic(Algebra.base(A), p) ∧
    polyAeval(A, x, p) = Ring.zero(Algebra.ring(A)))

-- x is algebraic: a root of a nonzero polynomial (IsAlgebraic).
predicate AlgebraicElement (A x : Set) :=
  Algebra(A) ∧ x ∈ algebraCarrier(A) ∧
  (∃ p ∈ Ring.carrier(polynomialRing(Algebra.base(A), {0})),
    p ≠ Ring.zero(polynomialRing(Algebra.base(A), {0})) ∧
    polyAeval(A, x, p) = Ring.zero(Algebra.ring(A)))

-- An integral algebra (Algebra.IsIntegral) and an algebraic one
-- (Algebra.IsAlgebraic).
predicate IntegralAlgebra (A : Set) :=
  Algebra(A) ∧ (∀ x ∈ algebraCarrier(A), IntegralElement(A, x))

predicate AlgebraicAlgebra (A : Set) :=
  Algebra(A) ∧ (∀ x ∈ algebraCarrier(A), AlgebraicElement(A, x))

-- The integral closure of R in A (integralClosure R A).
def integralClosure (A : Set) : Set :=
  { x ∈ algebraCarrier(A) | IntegralElement(A, x) }

-- R is integrally closed in A: the structure map is injective and its
-- image is the set of integral elements (IsIntegrallyClosedIn, i.e.
-- IsIntegralClosure R R A).
predicate IntegrallyClosedIn (A : Set) :=
  Algebra(A) ∧
  InjectiveBetween(Algebra.map(A), Ring.carrier(Algebra.base(A)), algebraCarrier(A)) ∧
  integralClosure(A) = functionImage(Algebra.map(A),
    Ring.carrier(Algebra.base(A)), algebraCarrier(A))

-- C with j : C → B is the integral closure of R in B, where B and C are
-- R-algebras and j an injective algebra homomorphism onto the integral
-- elements of B (IsIntegralClosure C R B).
predicate IsIntegralClosure (C B j : Set) :=
  AlgebraHom(j, C, B) ∧ InjectiveBetween(j, algebraCarrier(C), algebraCarrier(B)) ∧
  functionImage(j, algebraCarrier(C), algebraCarrier(B)) = integralClosure(B)

-- An integrally closed domain: integrally closed in its fraction field
-- (IsIntegrallyClosed R, by IsIntegralClosure R R (FractionRing R)).
predicate IntegrallyClosedDomain (R : Set) :=
  IntegralDomain(R) ∧ IntegrallyClosedIn(localizationAlgebra(R, nonZeroDivisors(R)))

-- An element y of a ring S is integral along f : R →+* S
-- (RingHom.IsIntegralElem), and f is integral (RingHom.IsIntegral).
predicate IntegralAlong (f R S y : Set) :=
  IntegralElement(Algebra.mk(R, S, f), y)

predicate IntegralHom (f R S : Set) :=
  RingHom(f, R, S) ∧ (∀ y ∈ Ring.carrier(S), IntegralAlong(f, R, S, y))

-- Section: Helpers for the bridge to Cumulus's monic relations
theorem intHelp.pred (k : Nat)
  requires positive : 0 < k
  shows ∃ j ∈ ℕ, k = j + 1
proof
  induction k
  | zero =>
    intro h
    exfalso
    arith
  | succ(m) using ih =>
    intro h
    have mN : m ∈ ℕ by typecheck
    refine ⟨m, mN, ?_⟩
    arith

-- The coefficients of a + X p are a, then those of p (shifted by one).
theorem intHelp.shift_coeff (R p a : Set) (j : Nat)
  requires comm : CommRing(R)
  requires member : p ∈ Ring.carrier(polynomialRing(R, {0}))
  requires scalar : a ∈ Ring.carrier(R)
  shows polyCoeff(call2(Ring.add(polynomialRing(R, {0})), polyC(R, a),
    call2(Ring.mul(polynomialRing(R, {0})), polyX(R), p)), j + 1) = polyCoeff(p, j)
proof
  have polys := polynomialRing.comm_ring at R, {0} with comm
  have pring := CommRing.to_ring with polys
  have xIn := polyX.mem at R with comm, polys
  have cIn := polyC.mem at R, a with comm, polys, scalar
  have xpIn : call2(Ring.mul(polynomialRing(R, {0})), polyX(R), p) ∈ Ring.carrier(polynomialRing(R, {0})) by typecheck
  have add := polyCoeff.add at R, polyC(R, a), call2(Ring.mul(polynomialRing(R, {0})), polyX(R), p), j + 1 with comm, polys, cIn, xpIn
  have c := polyC.coeff at R, a, j + 1 with comm, polys, scalar
  have ne : j + 1 ≠ 0 by arith
  have c0 := c.right with ne
  have pow1 := Ring.pow_one at polynomialRing(R, {0}), polyX(R) with xIn, pring
  have sh := polyCoeff.X_pow_mul at R, p, 1, j with comm, polys, member
  rw pow1 at sh
  have pj := uni.coeff_mem at R, p, j with comm, member
  rw [add, c0, sh]
  exact finHelp.zero_add at R, polyCoeff(p, j) with pj, comm

theorem intHelp.shift_coeff_zero (R p a : Set)
  requires comm : CommRing(R)
  requires member : p ∈ Ring.carrier(polynomialRing(R, {0}))
  requires scalar : a ∈ Ring.carrier(R)
  shows polyCoeff(call2(Ring.add(polynomialRing(R, {0})), polyC(R, a),
    call2(Ring.mul(polynomialRing(R, {0})), polyX(R), p)), 0) =
    call2(Ring.add(R), a, polyCoeff(call2(Ring.mul(polynomialRing(R, {0})), polyX(R), p), 0))
proof
  have polys := polynomialRing.comm_ring at R, {0} with comm
  have xIn := polyX.mem at R with comm, polys
  have cIn := polyC.mem at R, a with comm, polys, scalar
  have xpIn : call2(Ring.mul(polynomialRing(R, {0})), polyX(R), p) ∈ Ring.carrier(polynomialRing(R, {0})) by typecheck
  have add := polyCoeff.add at R, polyC(R, a), call2(Ring.mul(polynomialRing(R, {0})), polyX(R), p), 0 with comm, polys, cIn, xpIn
  have c := polyC.coeff at R, a, 0 with comm, polys, scalar
  have e : (0:Nat) = 0 by rfl
  rw [add, (c.left with e)]

-- The value of a + X p is f(a) + x · p(x).
theorem intHelp.shift_eval (R S f x p a : Set)
  requires comm : CommRing(R)
  requires target : CommRing(S)
  requires hom : f : R →+* S
  requires point : x ∈ Ring.carrier(S)
  requires member : p ∈ Ring.carrier(polynomialRing(R, {0}))
  requires scalar : a ∈ Ring.carrier(R)
  shows polyEval2(R, S, f, x, call2(Ring.add(polynomialRing(R, {0})), polyC(R, a),
    call2(Ring.mul(polynomialRing(R, {0})), polyX(R), p))) =
    call2(Ring.add(S), f(a), call2(Ring.mul(S), x, polyEval2(R, S, f, x, p)))
proof
  have polys := polynomialRing.comm_ring at R, {0} with comm
  have xIn := polyX.mem at R with comm, polys
  have cIn := polyC.mem at R, a with comm, polys, scalar
  have H := polyEval2.hom at R, S, f, x with comm, polys, target, hom, point
  have xpIn : call2(Ring.mul(polynomialRing(R, {0})), polyX(R), p) ∈ Ring.carrier(polynomialRing(R, {0})) by typecheck
  have eC := polyEval2.C at R, S, f, x, a with comm, polys, target, hom, point, scalar
  have eX := polyEval2.X at R, S, f, x with comm, polys, target, hom, point
  unfold polyEval2 at eC
  unfold polyEval2 at eX
  unfold polyEval2
  rw (RingHom.map_add at evaluationHom(R, S, {0}, f, constantFunction({0}, S.carrier, x)), polynomialRing(R, {0}), S, polyC(R, a), call2(Ring.mul(polynomialRing(R, {0})), polyX(R), p) with cIn, xpIn, H)
  rw (RingHom.map_mul at evaluationHom(R, S, {0}, f, constantFunction({0}, S.carrier, x)), polynomialRing(R, {0}), S, polyX(R), p with xIn, member, H)
  rw [eC, eX]

-- Conversely, a polynomial with leading coefficient 1 in degree n has the
-- value of a Cumulus monic list (over a nontrivial ring; dividing by X).
theorem intHelp.poly_list (R S f x : Set) (n : Nat)
  requires comm : CommRing(R)
  requires target : CommRing(S)
  requires hom : f : R →+* S
  requires point : x ∈ Ring.carrier(S)
  requires nontrivial : Ring.zero(R) ≠ Ring.one(R)
  shows ∀ p ∈ Ring.carrier(polynomialRing(R, {0})), polyCoeff(p, n) = Ring.one(R) →
    (∀ k ∈ ℕ, n < k → polyCoeff(p, k) = Ring.zero(R)) →
    ∃ cs, List(Ring.carrier(R), cs) ∧ polyEval2(R, S, f, x, p) =
      monicValue{Ring.carrier(R)}(f, Ring.add(S), Ring.mul(S), Ring.one(S), x, cs)
proof
  induction n
  | zero =>
    intros p pIn top vanish
    have polys := polynomialRing.comm_ring at R, {0} with comm
    have lt1 : p ∈ polyDegreeLT(R, 1)
      unfold polyDegreeLT
      refine ⟨pIn, ?_⟩
      intros k hk
      unfold polyDegrees at hk
      obtain ⟨kN, nz⟩ := hk
      have kNat := nat.omega.backward with kN
      by_contra ge
      have pos : 0 < k by arith
      have z := vanish with k, kN, pos
      unfold polyCoeff at z
      exact nz with z
    have pc := uni.const_of_lt_one at R, p with comm, polys, lt1
    rw top at pc
    have oneR : Ring.one(R) ∈ Ring.carrier(R) by typecheck
    have nilL : List(Ring.carrier(R), List.nil) by typecheck
    refine ⟨List.nil, nilL, ?_⟩
    rw pc
    rw monicValue
    rw (polyEval2.C at R, S, f, x, Ring.one(R) with comm, polys, target, hom, point, oneR)
    exact RingHom.map_one with hom
  | succ(m) using ih =>
    intros p pIn top vanish
    have polys := polynomialRing.comm_ring at R, {0} with comm
    have pp := CommRing.parts with polys
    have xIn := polyX.mem at R with comm, polys
    have xm := PolyMonic.X at R with comm, polys
    have e1 : (1:Nat) = 1 by rfl
    have xtop := (uni.X_coeff at R, 1 with comm, polys).left with e1
    have xvanish : ∀ k ∈ ℕ, 1 < k → polyCoeff(polyX(R), k) = Ring.zero(R)
      intros k hk lt
      have kNat := nat.omega.backward with hk
      have n1 : k ≠ 1 by arith
      exact (uni.X_coeff at R, k with comm, polys).right with n1
    have xd := (uni.monic_of at R, polyX(R), 1 with comm, polys, xIn, xtop, xvanish).right with nontrivial
    have vanishN : ∀ k ∈ ℕ, succ(m) + 1 ≤ k → polyCoeff(p, k) = Ring.zero(R)
      intros k hk le
      have kNat := nat.omega.backward with hk
      have lt : succ(m) < k by arith
      exact vanish with k, hk, lt
    obtain ⟨q, qIn, r, rIn, split, small⟩ := uni.div_exists at R, polyX(R), succ(m) + 1 with xIn, comm, polys, xm, p, pIn, vanishN
    rw xd at small
    have rc := uni.const_of_lt_one at R, r with comm, polys, small
    have r0 := uni.coeff_mem at R, r, 0 with comm, rIn
    have qx := IsCommRing.mul_comm with pp, qIn, xIn
    have xqIn : call2(Ring.mul(polynomialRing(R, {0})), polyX(R), q) ∈ Ring.carrier(polynomialRing(R, {0})) by typecheck
    have cIn := polyC.mem at R, polyCoeff(r, 0) with comm, polys, r0
    rw [qx, rc] at split
    have ac := IsCommRing.add_comm with pp, xqIn, cIn
    rw ac at split
    have shifted : ∀ j ∈ ℕ, polyCoeff(q, j) = polyCoeff(p, j + 1)
      intros j hj
      have jNat := nat.omega.backward with hj
      rw split
      rw (intHelp.shift_coeff at R, q, polyCoeff(r, 0), j with comm, qIn, r0)
    have mN : m ∈ ℕ by typecheck
    have qtop : polyCoeff(q, m) = Ring.one(R)
      rw (shifted with m, mN)
      have same : m + 1 = succ(m) by arith
      rw same
      exact top
    have qvanish : ∀ k ∈ ℕ, m < k → polyCoeff(q, k) = Ring.zero(R)
      intros k hk lt
      have kNat := nat.omega.backward with hk
      rw (shifted with k, hk)
      have k1 : k + 1 ∈ ℕ by typecheck
      have lt2 : succ(m) < k + 1 by arith
      exact vanish with k + 1, k1, lt2
    obtain ⟨cs, list, value⟩ := ih with q, qIn, qtop, qvanish
    have cons : List(Ring.carrier(R), List.cons(polyCoeff(r, 0), cs)) by typecheck
    refine ⟨List.cons(polyCoeff(r, 0), cs), cons, ?_⟩
    rw split
    rw (intHelp.shift_eval at R, S, f, x, q, polyCoeff(r, 0) with comm, target, hom, point, qIn, r0)
    rw value
    rw monicValue

-- A Cumulus monic list gives a polynomial with leading coefficient 1 in
-- degree n and the same value.
theorem intHelp.list_poly (R S f x : Set) (cs : List(Ring.carrier(R)))
  requires comm : CommRing(R)
  requires target : CommRing(S)
  requires hom : f : R →+* S
  requires point : x ∈ Ring.carrier(S)
  shows ∃ p ∈ Ring.carrier(polynomialRing(R, {0})), ∃ n ∈ ℕ,
    polyCoeff(p, n) = Ring.one(R) ∧
    (∀ k ∈ ℕ, n < k → polyCoeff(p, k) = Ring.zero(R)) ∧
    polyEval2(R, S, f, x, p) =
      monicValue{Ring.carrier(R)}(f, Ring.add(S), Ring.mul(S), Ring.one(S), x, cs)
proof
  induction cs
  | List.nil =>
    have polys := polynomialRing.comm_ring at R, {0} with comm
    have oneR : Ring.one(R) ∈ Ring.carrier(R) by typecheck
    have cIn := polyC.mem at R, Ring.one(R) with comm, polys, oneR
    have zN : (0:Nat) ∈ ℕ by typecheck
    have c := polyC.coeff at R, Ring.one(R), 0 with comm, polys, oneR
    have e : (0:Nat) = 0 by rfl
    refine ⟨polyC(R, Ring.one(R)), cIn, 0, zN, (c.left with e), ?_, ?_⟩
    . intros k hk lt
      have kNat := nat.omega.backward with hk
      have ne : k ≠ 0 by arith
      exact (polyC.coeff at R, Ring.one(R), k with comm, polys, oneR).right with ne
    . rw monicValue
      rw (polyEval2.C at R, S, f, x, Ring.one(R) with comm, polys, target, hom, point, oneR)
      exact RingHom.map_one with hom
  | List.cons(a, tail) using ih =>
    have polys := polynomialRing.comm_ring at R, {0} with comm
    have aR : a ∈ Ring.carrier(R) by assumption
    obtain ⟨p, pIn, n, nN, top, vanish, value⟩ := ih
    have nNat := nat.omega.backward with nN
    have xIn := polyX.mem at R with comm, polys
    have cIn := polyC.mem at R, a with comm, polys, aR
    have qIn : call2(Ring.add(polynomialRing(R, {0})), polyC(R, a), call2(Ring.mul(polynomialRing(R, {0})), polyX(R), p)) ∈ Ring.carrier(polynomialRing(R, {0})) by typecheck
    have sN : n + 1 ∈ ℕ by typecheck
    refine ⟨call2(Ring.add(polynomialRing(R, {0})), polyC(R, a), call2(Ring.mul(polynomialRing(R, {0})), polyX(R), p)), qIn, n + 1, sN, ?_, ?_, ?_⟩
    . rw (intHelp.shift_coeff at R, p, a, n with comm, pIn, aR)
      exact top
    . intros k hk lt
      have kNat := nat.omega.backward with hk
      have kpos : 0 < k by arith
      obtain ⟨j, jN, jk⟩ := intHelp.pred at k with kpos
      have jNat := nat.omega.backward with jN
      rw jk
      rw (intHelp.shift_coeff at R, p, a, j with comm, pIn, aR)
      have lt2 : n < j by arith
      exact vanish with j, jN, lt2
    . rw (intHelp.shift_eval at R, S, f, x, p, a with comm, target, hom, point, pIn, aR)
      rw value
      rw monicValue

-- Section: Helpers for the bridge to Cumulus's linear spans
-- Submodules of A as an R-module are Cumulus's submodules along the
-- structure map, and the two spans agree.
theorem intHelp.submodule_iff (A N : Set)
  requires algebra : Algebra(A)
  shows SubmoduleOf(N, algebraModule(A), Algebra.base(A)) ↔
    Submodule(Algebra.map(A), Ring.carrier(Algebra.base(A)), algebraCarrier(A),
      Ring.add(Algebra.ring(A)), Ring.zero(Algebra.ring(A)),
      Ring.neg(Algebra.ring(A)), Ring.mul(Algebra.ring(A)), N)
proof
  have base := Algebra.base_comm_ring at A with algebra
  have ringA := Algebra.comm_ring at A with algebra
  have ringS := CommRing.to_ring with ringA
  have modA := algebraModule.module_of at A with algebra
  have z : Module.zero(algebraModule(A)) = Ring.zero(Algebra.ring(A))
    unfold algebraModule
    module_projections
  have ce := algebraModule.carrier_eq at A
  have ae := algebraModule.add_eq at A
  constructor
  . intro sm
    obtain ⟨_, sub, zN, addC, smulC⟩ := sm
    rw ce at sub
    rw z at zN
    rw ae at addC
    unfold Submodule
    refine ⟨sub, zN, ?_, ?_, ?_⟩
    . unfold ClosedUnary
      intros v hv
      have vA := sub with v, hv
      have m1 : Ring.neg(Algebra.base(A))(Ring.one(Algebra.base(A))) ∈ Ring.carrier(Algebra.base(A)) by typecheck
      have sv := smulC with Ring.neg(Algebra.base(A))(Ring.one(Algebra.base(A))), m1, v, hv
      rw (algebraModule.smul_value at A, Ring.neg(Algebra.base(A))(Ring.one(Algebra.base(A))), v with algebra, m1, vA) at sv
      have sh := Algebra.structure_hom at A with algebra
      have oneB : Ring.one(Algebra.base(A)) ∈ Ring.carrier(Algebra.base(A)) by typecheck
      rw (RingHom.map_neg at Algebra.map(A), Algebra.base(A), Algebra.ring(A), Ring.one(Algebra.base(A)) with oneB, sh) at sv
      rw (RingHom.map_one with sh) at sv
      unfold algebraCarrier at vA
      rw (finHelp.neg_one_mul at Algebra.ring(A), v with vA, ringA) at sv
      exact sv
    . unfold ClosedBinary
      intros v hv w hw
      exact addC with v, hv, w, hw
    . intros a ha v hv
      have vA := sub with v, hv
      have sv := smulC with a, ha, v, hv
      rw (algebraModule.smul_value at A, a, v with algebra, ha, vA) at sv
      exact sv
  . intro sm
    obtain ⟨sub, zN, negC, addC, smulC⟩ := sm
    unfold SubmoduleOf
    refine ⟨modA, ?_, ?_, ?_, ?_⟩
    . rw ce
      exact sub
    . rw z
      exact zN
    . rw ae
      intros v hv w hw
      exact ClosedBinary.mem with addC, hv, hw
    . intros r hr v hv
      have vA := sub with v, hv
      rw (algebraModule.smul_value at A, r, v with algebra, hr, vA)
      exact smulC with r, hr, v, hv

theorem intHelp.span_eq (A G : Set)
  requires algebra : Algebra(A)
  shows moduleSpan(algebraModule(A), Algebra.base(A), G) =
    linearSpan(Algebra.map(A), Ring.carrier(Algebra.base(A)), algebraCarrier(A),
      Ring.add(Algebra.ring(A)), Ring.zero(Algebra.ring(A)),
      Ring.neg(Algebra.ring(A)), Ring.mul(Algebra.ring(A)), G)
proof
  have ce := algebraModule.carrier_eq at A
  ext v
  constructor
  . intro hv
    unfold moduleSpan at hv
    obtain ⟨vM, least⟩ := hv
    rw ce at vM
    unfold linearSpan
    refine ⟨vM, ?_⟩
    intros T sT gT
    have sm := (intHelp.submodule_iff at A, T with algebra).backward with sT
    exact least with T, sm, gT
  . intro hv
    unfold linearSpan at hv
    obtain ⟨vA, least⟩ := hv
    unfold moduleSpan
    rw ce
    refine ⟨vA, ?_⟩
    intros N sN gN
    have sm := (intHelp.submodule_iff at A, N with algebra).forward with sN
    exact least with N, sm, gN

-- Section: Helpers for subalgebras as rings
-- A subalgebra T of S over R, as the ring S ↾ T with f corestricted: a
-- finite span T is a finite module over R, and integrality in S ↾ T is
-- integrality in S.
section IntRestriction
variable (A add zero neg mul one B plus z minus times unit f T : Set)
notation ring R := (A, add, zero, neg, mul, one)
notation ring S := (B, plus, z, minus, times, unit)
notation ring L := S ↾ T
hypothesis source : IsCommRing(R)
hypothesis target : IsCommRing(S)
hypothesis hom : IsRingHom(f, R, S)
hypothesis subalgebra : Subalgebra(f, R, S, T)

theorem intHelp.restricted_hom
  shows IsRingHom(f, R, L)
proof
  have subring := Subalgebra.subring with *
  have smaller : IsCommRing(L)
    exact IsSubring.comm_ring with *
  have function := IsRingHom.function with hom
  have data := subalgebra
  obtain ⟨_, image⟩ := data
  have values : ∀ a ∈ A, f(a) ∈ T
    intros a ha
    have fa := functionImage.value at f, A, B, a with function, ha
    exact image with f(a), fa
  have corestricted := FunctionBetween.codomain_of_values with function, values
  have ordinary := IsCommRing.ring with target
  have bounded := IsSubring.subset_carrier with subring
  have addition : IsMagma(B, plus) by simp [IsCommRing, IsRing, IsAbelianGroup, IsGroup, IsMonoid, IsSemigroup]
  have multiplication : IsMagma(B, times) by simp [IsCommRing, IsRing, IsMonoid, IsSemigroup]
  apply IsRingHom.of_add_mul_one with source, smaller, corestricted
  . intros x hx y hy
    have fx := values with x, hx
    have fy := values with y, hy
    rw (restrictBinary.value_on_subset at B, T, plus, f(x), f(y) with *)
    exact IsRingHom.add with hom, hx, hy
  . intros x hx y hy
    have fx := values with x, hx
    have fy := values with y, hy
    rw (restrictBinary.value_on_subset at B, T, times, f(x), f(y) with *)
    exact IsRingHom.mul with hom, hx, hy
  . exact IsRingHom.one with hom

theorem intHelp.restricted_submodule (U : Set)
  requires submodule : Submodule(f, R, L, U)
  shows Submodule(f, R, S, U)
proof
  have subring := Subalgebra.subring with *
  have bounded := IsSubring.subset_carrier with subring
  have negT := IsSubring.neg_closed with subring
  have addition : IsMagma(B, plus) by simp [IsCommRing, IsRing, IsAbelianGroup, IsGroup, IsMonoid, IsSemigroup]
  have multiplication : IsMagma(B, times) by simp [IsCommRing, IsRing, IsMonoid, IsSemigroup]
  have negF : minus : B → B by simp [IsCommRing, IsRing, IsAbelianGroup, IsGroup, Inverse]
  have restrictedHom := intHelp.restricted_hom with *
  have function := IsRingHom.function with restrictedHom
  obtain ⟨UT, zU, negC, addC, smulC⟩ := submodule
  have UB := Subset.transitive with UT, bounded
  unfold Submodule
  refine ⟨UB, zU, ?_, ?_, ?_⟩
  . unfold ClosedUnary
    intros v hv
    have vT := UT with v, hv
    have c := ClosedUnary.mem with negC, hv
    rw (restrictUnary.value at B, T, minus, v with negF, bounded, negT, vT) at c
    exact c
  . unfold ClosedBinary
    intros v hv w hw
    have vT := UT with v, hv
    have wT := UT with w, hw
    have c := ClosedBinary.mem with addC, hv, hw
    rw (restrictBinary.value_on_subset at B, T, plus, v, w with addition, bounded, vT, wT) at c
    exact c
  . intros a ha v hv
    have vT := UT with v, hv
    have faT := FunctionBetween.apply_closed with function, ha
    have c := smulC with a, ha, v, hv
    rw (restrictBinary.value_on_subset at B, T, times, f(a), v with multiplication, bounded, faT, vT) at c
    exact c

theorem intHelp.restricted_submodule_back (U : Set)
  requires inside : U ⊆ T
  requires submodule : Submodule(f, R, S, U)
  shows Submodule(f, R, L, U)
proof
  have subring := Subalgebra.subring with *
  have bounded := IsSubring.subset_carrier with subring
  have negT := IsSubring.neg_closed with subring
  have addition : IsMagma(B, plus) by simp [IsCommRing, IsRing, IsAbelianGroup, IsGroup, IsMonoid, IsSemigroup]
  have multiplication : IsMagma(B, times) by simp [IsCommRing, IsRing, IsMonoid, IsSemigroup]
  have negF : minus : B → B by simp [IsCommRing, IsRing, IsAbelianGroup, IsGroup, Inverse]
  have restrictedHom := intHelp.restricted_hom with *
  have function := IsRingHom.function with restrictedHom
  obtain ⟨UB, zU, negC, addC, smulC⟩ := submodule
  unfold Submodule
  refine ⟨inside, zU, ?_, ?_, ?_⟩
  . unfold ClosedUnary
    intros v hv
    have vT := inside with v, hv
    rw (restrictUnary.value at B, T, minus, v with negF, bounded, negT, vT)
    exact ClosedUnary.mem with negC, hv
  . unfold ClosedBinary
    intros v hv w hw
    have vT := inside with v, hv
    have wT := inside with w, hw
    rw (restrictBinary.value_on_subset at B, T, plus, v, w with addition, bounded, vT, wT)
    exact ClosedBinary.mem with addC, hv, hw
  . intros a ha v hv
    have vT := inside with v, hv
    have faT := FunctionBetween.apply_closed with function, ha
    rw (restrictBinary.value_on_subset at B, T, times, f(a), v with multiplication, bounded, faT, vT)
    exact smulC with a, ha, v, hv

theorem intHelp.restricted_span (G : Set)
  requires inside : G ⊆ T
  shows linearSpan(f, R, L, G) = linearSpan(f, R, S, G)
proof
  have subring := Subalgebra.subring with *
  have bounded := IsSubring.subset_carrier with subring
  have smaller : IsCommRing(L)
    exact IsSubring.comm_ring with *
  have restrictedHom := intHelp.restricted_hom with *
  have GB := Subset.transitive with inside, bounded
  have tMod := Subalgebra.submodule with *
  have sSpan := linearSpan.least at A, add, zero, neg, mul, one, B, plus, z, minus, times, unit, f, G, T with source, target, hom, tMod, inside
  have sMod := linearSpan.submodule at A, add, zero, neg, mul, one, B, plus, z, minus, times, unit, f, G with source, target, hom
  have sModL := intHelp.restricted_submodule_back at A, add, zero, neg, mul, one, B, plus, z, minus, times, unit, f, T, linearSpan(f, R, S, G) with source, target, hom, subalgebra, sSpan, sMod
  have gS := linearSpan.contains at A, add, zero, neg, mul, one, B, plus, z, minus, times, unit, f, G with source, target, hom, GB
  have le := linearSpan.least at A, add, zero, neg, mul, one, T, restrict(plus, T × T), z, restrict(minus, T), restrict(times, T × T), unit, f, G, linearSpan(f, R, S, G) with source, smaller, restrictedHom, sModL, gS
  have lMod := linearSpan.submodule at A, add, zero, neg, mul, one, T, restrict(plus, T × T), z, restrict(minus, T), restrict(times, T × T), unit, f, G with source, smaller, restrictedHom
  have lModS := intHelp.restricted_submodule at A, add, zero, neg, mul, one, B, plus, z, minus, times, unit, f, T, linearSpan(f, R, L, G) with source, target, hom, subalgebra, lMod
  have gL := linearSpan.contains at A, add, zero, neg, mul, one, T, restrict(plus, T × T), z, restrict(minus, T), restrict(times, T × T), unit, f, G with source, smaller, restrictedHom, inside
  have ge := linearSpan.least at A, add, zero, neg, mul, one, B, plus, z, minus, times, unit, f, G, linearSpan(f, R, L, G) with source, target, hom, lModS, gL
  exact Subset.antisymmetric with le, ge

theorem intHelp.restricted_finite
  requires finite : FiniteSpan(f, R, S, T)
  shows FiniteAlgebraModule(f, R, L)
proof
  obtain ⟨G, finG, GT, span⟩ := finite
  have same := intHelp.restricted_span at A, add, zero, neg, mul, one, B, plus, z, minus, times, unit, f, T, G with source, target, hom, subalgebra, GT
  rw span at same
  unfold FiniteAlgebraModule
  exact ⟨G, finG, GT, same⟩

theorem intHelp.restricted_value (x : Set) (cs : List(A))
  requires member : x ∈ T
  shows monicValue{A}(f, restrict(plus, T × T), restrict(times, T × T), unit, x, cs) =
    monicValue{A}(f, plus, times, unit, x, cs)
proof
  induction cs
  | List.nil =>
    rw [monicValue, monicValue]
  | List.cons(a, tail) using ih =>
    have subring := Subalgebra.subring with *
    have bounded := IsSubring.subset_carrier with subring
    have addition : IsMagma(B, plus) by simp [IsCommRing, IsRing, IsAbelianGroup, IsGroup, IsMonoid, IsSemigroup]
    have multiplication : IsMagma(B, times) by simp [IsCommRing, IsRing, IsMonoid, IsSemigroup]
    have restrictedHom := intHelp.restricted_hom with *
    have function := IsRingHom.function with restrictedHom
    have aA : a ∈ A by assumption
    have faT := FunctionBetween.apply_closed with function, aA
    have xB := bounded with x, member
    have tailT := monicValue.in_subalgebra at A, add, zero, neg, mul, one, B, plus, z, minus, times, unit, f, x, T, tail with source, target, hom, xB, subalgebra, member
    have mulT := IsSubring.mul_closed with subring
    have prodT := ClosedBinary.mem with mulT, member, tailT
    rw [monicValue, monicValue, ih]
    rw (restrictBinary.value_on_subset at B, T, times, x, monicValue{A}(f, plus, times, unit, x, tail) with multiplication, bounded, member, tailT)
    rw (restrictBinary.value_on_subset at B, T, plus, f(a), call2(times, x, monicValue{A}(f, plus, times, unit, x, tail)) with addition, bounded, faT, prodT)

theorem intHelp.integral_of_finite_span (x : Set)
  requires finite : FiniteSpan(f, R, S, T)
  requires member : x ∈ T
  shows IntegralOver(f, R, S, x)
proof
  have subring := Subalgebra.subring with *
  have bounded := IsSubring.subset_carrier with subring
  have smaller : IsCommRing(L)
    exact IsSubring.comm_ring with *
  have restrictedHom := intHelp.restricted_hom with *
  have fin := intHelp.restricted_finite with *
  have io := FiniteAlgebraModule.integral at A, add, zero, neg, mul, one, T, restrict(plus, T × T), z, restrict(minus, T), restrict(times, T × T), unit, f, x with source, smaller, restrictedHom, member, fin
  obtain ⟨_, cs, list, value⟩ := io
  have same := intHelp.restricted_value at A, add, zero, neg, mul, one, B, plus, z, minus, times, unit, f, T, x, cs with list, source, target, hom, subalgebra, member
  rw same at value
  have xB := bounded with x, member
  unfold IntegralOver
  exact ⟨xB, cs, list, value⟩

end IntRestriction

-- Section: Laws of integral elements
section IntegralElements
variable (A : Set)
hypothesis algebra : Algebra(A)

-- The polynomial and the list forms agree.
theorem IntegralElement.iff_cumulus (x : Set)
  requires member : x ∈ algebraCarrier(A)
  shows IntegralElement(A, x) ↔
    IntegralOver(Algebra.map(A), Ring.carrier(Algebra.base(A)), algebraCarrier(A),
      Ring.add(Algebra.ring(A)), Ring.zero(Algebra.ring(A)),
      Ring.mul(Algebra.ring(A)), Ring.one(Algebra.ring(A)), x)
proof
  have base := Algebra.base_comm_ring at A with algebra
  have ringA := Algebra.comm_ring at A with algebra
  have sh := Algebra.structure_hom at A with algebra
  have polys := polynomialRing.comm_ring at Algebra.base(A), {0} with base
  have pt := member
  unfold algebraCarrier at pt
  constructor
  . intro integral
    obtain ⟨_, _, p, monic, root⟩ := integral
    unfold IntegralOver
    refine ⟨member, ?_⟩
    have nilL : List(Ring.carrier(Algebra.base(A)), List.nil) by typecheck
    by_cases triv : Ring.zero(Algebra.base(A)) = Ring.one(Algebra.base(A))
    . refine ⟨List.nil, nilL, ?_⟩
      rw monicValue
      have o := RingHom.map_one with sh
      have z := RingHom.map_zero with sh
      rw triv at z
      rw o at z
      exact z
    . have m0 := monic
      obtain ⟨pIn, lead⟩ := m0
      have dN : polyNatDegree(Algebra.base(A), p) ∈ ℕ by typecheck
      have dNat := nat.omega.backward with dN
      have le := uni.lead_eq at Algebra.base(A), p with base, polys
      rw le at lead
      have vanish : ∀ k ∈ ℕ, polyNatDegree(Algebra.base(A), p) < k → polyCoeff(p, k) = Ring.zero(Algebra.base(A))
        intros k hk lt
        have kNat := nat.omega.backward with hk
        exact polyNatDegree.coeff_zero_of_lt at Algebra.base(A), p, k with pIn, base, polys, lt
      have all := intHelp.poly_list at Algebra.base(A), Algebra.ring(A), Algebra.map(A), x, polyNatDegree(Algebra.base(A), p) with base, ringA, sh, pt, triv
      obtain ⟨cs, list, value⟩ := all with p, pIn, lead, vanish
      refine ⟨cs, list, ?_⟩
      rw ← value
      unfold polyAeval at root
      exact root
  . intro io
    obtain ⟨_, cs, list, value⟩ := io
    obtain ⟨p, pIn, n, nN, top, vanish, ev⟩ := intHelp.list_poly at Algebra.base(A), Algebra.ring(A), Algebra.map(A), x, cs with list, base, ringA, sh, pt
    have nNat := nat.omega.backward with nN
    have monic := (uni.monic_of at Algebra.base(A), p, n with pIn, base, polys, top, vanish).left
    unfold IntegralElement
    refine ⟨algebra, member, p, monic, ?_⟩
    unfold polyAeval
    rw ev
    exact value

-- isIntegral_algebraMap, isIntegral_zero, isIntegral_one.
theorem IntegralElement.algebra_map (a : Set)
  requires scalar : a ∈ Ring.carrier(Algebra.base(A))
  shows IntegralElement(A, Algebra.map(A)(a))
proof
  sorry

-- IsIntegral.add, mul, neg, sub, pow, smul: the integral elements form a
-- subalgebra (integralClosure).
theorem IntegralElement.add (x y : Set)
  requires first : IntegralElement(A, x)
  requires second : IntegralElement(A, y)
  shows IntegralElement(A, call2(Ring.add(Algebra.ring(A)), x, y))
proof
  sorry

theorem IntegralElement.mul (x y : Set)
  requires first : IntegralElement(A, x)
  requires second : IntegralElement(A, y)
  shows IntegralElement(A, call2(Ring.mul(Algebra.ring(A)), x, y))
proof
  sorry

theorem IntegralElement.neg (x : Set)
  requires integral : IntegralElement(A, x)
  shows IntegralElement(A, apply(Ring.neg(Algebra.ring(A)), x))
proof
  sorry

theorem IntegralElement.sub (x y : Set)
  requires first : IntegralElement(A, x)
  requires second : IntegralElement(A, y)
  shows IntegralElement(A, Ring.sub(Algebra.ring(A), x, y))
proof
  sorry

theorem IntegralElement.pow (x : Set) (n : Nat)
  requires integral : IntegralElement(A, x)
  shows IntegralElement(A, Ring.pow(Algebra.ring(A), x, n))
proof
  sorry

theorem IntegralElement.smul (a x : Set)
  requires scalar : a ∈ Ring.carrier(Algebra.base(A))
  requires integral : IntegralElement(A, x)
  shows IntegralElement(A, call2(Ring.mul(Algebra.ring(A)), Algebra.map(A)(a), x))
proof
  sorry

theorem integralClosure.subalgebra
  shows SubalgebraOf(A, integralClosure(A))
proof
  sorry

-- The finiteness criterion: x is integral iff R[x] is a finite R-module
-- (IsIntegral.fg_adjoin_singleton, isIntegral_iff_fg_adjoin), and an
-- element of a subalgebra that is a finite module is integral
-- (IsIntegral.of_mem_of_fg, IsIntegral.of_finite).
theorem IntegralElement.iff_adjoin_finite (x : Set)
  requires member : x ∈ algebraCarrier(A)
  shows IntegralElement(A, x) ↔
    SubmoduleFG(algebraModule(A), Algebra.base(A), adjoinOf(A, {x}))
proof
  sorry

theorem IntegralElement.of_mem_fg (T x : Set)
  requires subalgebra : SubalgebraOf(A, T)
  requires finite : SubmoduleFG(algebraModule(A), Algebra.base(A), T)
  requires member : x ∈ T
  shows IntegralElement(A, x)
proof
  sorry

theorem IntegralAlgebra.of_finite
  requires finite : FiniteAlgebra(A)
  shows IntegralAlgebra(A)
proof
  sorry

-- An algebra of finite type that is integral is finite
-- (Algebra.IsIntegral.finite, Cumulus's
-- FinitelyGeneratedAlgebra.finite_module_of_integral); finitely many
-- integral elements generate a finite subalgebra (fg_adjoin_of_finite).
theorem FiniteAlgebra.of_integral_finite_type
  requires integral : IntegralAlgebra(A)
  requires finiteType : FiniteTypeAlgebra(A)
  shows FiniteAlgebra(A)
proof
  sorry

theorem adjoinOf.finite_of_integral (G : Set)
  requires finite : Finite(G)
  requires integral : ∀ x ∈ G, IntegralElement(A, x)
  shows SubmoduleFG(algebraModule(A), Algebra.base(A), adjoinOf(A, G))
proof
  sorry

-- IsIntegral.map: algebra homomorphisms preserve integrality; the image
-- under a surjection of an integral algebra is integral.
theorem IntegralElement.map (B f x : Set)
  requires hom : f : A →ₐ B
  requires integral : IntegralElement(A, x)
  shows IntegralElement(B, f(x))
proof
  sorry

-- The integral closure is integrally closed (integralClosure_idem): an
-- element of A integral over the integral closure is in it.
theorem integralClosure.idempotent (x : Set)
  requires member : x ∈ algebraCarrier(A)
  requires integral : IntegralElement(Algebra.mk(subringRing(Algebra.ring(A),
    integralClosure(A)), Algebra.ring(A), identity(integralClosure(A))), x)
  shows x ∈ integralClosure(A)
proof
  sorry

-- Over a field, integral and algebraic agree (isAlgebraic_iff_isIntegral,
-- IsIntegral.isAlgebraic); over a domain an algebraic element times a
-- nonzero scalar is integral (IsAlgebraic.exists_smul_eq_mul... in the
-- form exists_integral_multiple).
theorem AlgebraicElement.iff_integral (x : Set)
  requires field : Field(Algebra.base(A))
  shows AlgebraicElement(A, x) ↔ IntegralElement(A, x)
proof
  sorry

theorem IntegralElement.algebraic (x : Set)
  requires nontrivial : Ring.zero(Algebra.base(A)) ≠ Ring.one(Algebra.base(A))
  requires integral : IntegralElement(A, x)
  shows AlgebraicElement(A, x)
proof
  sorry

theorem AlgebraicElement.integral_multiple (x : Set)
  requires domain : IntegralDomain(Algebra.base(A))
  requires algebraic : AlgebraicElement(A, x)
  shows ∃ a ∈ Ring.carrier(Algebra.base(A)), a ≠ Ring.zero(Algebra.base(A)) ∧
    IntegralElement(A, call2(Ring.mul(Algebra.ring(A)), Algebra.map(A)(a), x))
proof
  sorry

-- Over a field, the inverse of an integral element lies in R[x]
-- (the subalgebra form of IsIntegral.inv_mem_adjoin... used for field
-- towers).
theorem IntegralElement.inverse_mem_adjoin (x y : Set)
  requires field : Field(Algebra.base(A))
  requires integral : IntegralElement(A, x)
  requires inverse : call2(Ring.mul(Algebra.ring(A)), x, y) = Ring.one(Algebra.ring(A))
  requires member : y ∈ algebraCarrier(A)
  shows y ∈ adjoinOf(A, {x})
proof
  sorry

-- IsIntegral.det: the determinant of a matrix with integral entries is
-- integral.
theorem IntegralElement.det (n M : Set)
  requires finite : Finite(n)
  requires matrix : M ∈ matrixSpace(Algebra.ring(A), n, n)
  requires entries : ∀ i ∈ n, ∀ j ∈ n, IntegralElement(A, M((i, j)))
  shows IntegralElement(A, matDet(Algebra.ring(A), n, M))
proof
  sorry

end IntegralElements

-- Section: Towers and integral extensions
-- Transitivity (isIntegral_trans, Algebra.IsIntegral.trans): for
-- R → A → B with A integral over R, an element of B integral over A is
-- integral over R.
theorem IntegralElement.trans (A B x : Set)
  requires integralA : IntegralAlgebra(A)
  requires algebraB : Algebra(B)
  requires tower : Algebra.base(B) = Algebra.ring(A)
  requires integral : IntegralElement(B, x)
  shows IntegralElement(Algebra.mk(Algebra.base(A), Algebra.ring(B),
    compose(Algebra.map(B), Algebra.map(A), Ring.carrier(Algebra.base(A)),
      algebraCarrier(A), algebraCarrier(B))), x)
proof
  sorry

-- An integral extension of domains: the base is a field iff the extension
-- is (isField_of_isIntegral_of_isField', Cumulus's
-- IsField.of_integral_extension).
theorem IntegralAlgebra.field_iff (A : Set)
  requires integral : IntegralAlgebra(A)
  requires domain : IntegralDomain(Algebra.ring(A))
  requires injective : InjectiveBetween(Algebra.map(A), Ring.carrier(Algebra.base(A)),
    algebraCarrier(A))
  shows Field(Algebra.base(A)) ↔ Field(Algebra.ring(A))
proof
  sorry

-- In an integral extension the contraction of a maximal ideal is maximal
-- (Ideal.isMaximal_comap_of_isIntegral_of_isMaximal), and a prime
-- contracting to a maximal ideal is maximal
-- (Ideal.IsMaximal.of_isIntegral_of_isMaximal_comap).
theorem IntegralAlgebra.comap_maximal (A M : Set)
  requires integral : IntegralAlgebra(A)
  requires maximal : MaximalIdeal(Algebra.ring(A), M)
  shows MaximalIdeal(Algebra.base(A),
    idealComap(Algebra.map(A), Ring.carrier(Algebra.base(A)), M))
proof
  sorry

theorem IntegralAlgebra.maximal_of_comap (A P : Set)
  requires integral : IntegralAlgebra(A)
  requires prime : PrimeIdeal(Algebra.ring(A), P)
  requires maximal : MaximalIdeal(Algebra.base(A),
    idealComap(Algebra.map(A), Ring.carrier(Algebra.base(A)), P))
  shows MaximalIdeal(Algebra.ring(A), P)
proof
  sorry

-- Lying over (Ideal.exists_ideal_over_prime_of_isIntegral): for an
-- integral extension with injective structure map, every prime of R is
-- the contraction of a prime of A; going up extends a lying-over prime
-- above a larger prime. Both build a prime by Zorn's lemma: Choice.
theorem IntegralAlgebra.lying_over (A P : Set)
  requires integral : IntegralAlgebra(A)
  requires kernel : ringKernel(Algebra.map(A), Ring.carrier(Algebra.base(A)),
    Ring.zero(Algebra.ring(A))) ⊆ P
  requires prime : PrimeIdeal(Algebra.base(A), P)
  shows ∃ Q, PrimeIdeal(Algebra.ring(A), Q) ∧ LiesOver(Algebra.map(A), Algebra.base(A), Q, P)
proof
  sorry

theorem IntegralAlgebra.going_up (A P P2 Q : Set)
  requires integral : IntegralAlgebra(A)
  requires primeQ : PrimeIdeal(Algebra.ring(A), Q)
  requires over : LiesOver(Algebra.map(A), Algebra.base(A), Q, P)
  requires larger : PrimeIdeal(Algebra.base(A), P2)
  requires subset : P ⊆ P2
  shows ∃ Q2, PrimeIdeal(Algebra.ring(A), Q2) ∧ Q ⊆ Q2 ∧
    LiesOver(Algebra.map(A), Algebra.base(A), Q2, P2)
proof
  sorry

-- Incomparability (Ideal.comap_lt_comap_of_integral_mem_sdiff): primes
-- lying over the same prime are incomparable.
theorem IntegralAlgebra.incomparable (A P Q1 Q2 : Set)
  requires integral : IntegralAlgebra(A)
  requires first : PrimeIdeal(Algebra.ring(A), Q1)
  requires second : PrimeIdeal(Algebra.ring(A), Q2)
  requires overFirst : LiesOver(Algebra.map(A), Algebra.base(A), Q1, P)
  requires overSecond : LiesOver(Algebra.map(A), Algebra.base(A), Q2, P)
  requires subset : Q1 ⊆ Q2
  shows Q1 = Q2
proof
  sorry

-- Section: Integrally closed domains
-- A UFD is integrally closed (UniqueFactorizationMonoid.instIsIntegrallyClosed),
-- so is a PID, and a field.
theorem IntegrallyClosedDomain.of_ufd (R : Set)
  requires ufd : UniqueFactorizationDomain(R)
  shows IntegrallyClosedDomain(R)
proof
  sorry

theorem IntegrallyClosedDomain.of_field (K : Set)
  requires field : Field(K)
  shows IntegrallyClosedDomain(K)
proof
  sorry

-- An integrally closed domain: an element of any fraction field that is
-- integral over R lies in R (IsIntegrallyClosed.isIntegral_iff), stated
-- for every IsFractionRing algebra.
theorem IntegrallyClosedDomain.integral_iff (K x : Set)
  requires closed : IntegrallyClosedDomain(Algebra.base(K))
  requires fractions : IsFractionRing(K)
  requires member : x ∈ algebraCarrier(K)
  shows IntegralElement(K, x) ↔
    (∃ a ∈ Ring.carrier(Algebra.base(K)), x = Algebra.map(K)(a))
proof
  sorry

-- The rational root theorem behind IsLocalization.scaleRoots_commonDenom_mem_lifts:
-- a root a / b in the fraction field of a monic polynomial over a UFD has
-- b a unit.
theorem IntegrallyClosedDomain.monic_root (K p x : Set)
  requires closed : IntegrallyClosedDomain(Algebra.base(K))
  requires fractions : IsFractionRing(K)
  requires monic : PolyMonic(Algebra.base(K), p)
  requires member : x ∈ algebraCarrier(K)
  requires root : polyAeval(K, x, p) = Ring.zero(Algebra.ring(K))
  shows ∃ a ∈ Ring.carrier(Algebra.base(K)), x = Algebra.map(K)(a) ∧
    PolyIsRoot(Algebra.base(K), p, a)
proof
  sorry

-- A localization of an integrally closed domain is integrally closed
-- (IsLocalization.isIntegrallyClosed... for localizations at
-- submonoids without zero).
theorem IntegrallyClosedDomain.localization (S A : Set)
  requires closed : IntegrallyClosedDomain(Algebra.base(A))
  requires localization : IsLocalization(S, A)
  requires noZero : Ring.zero(Algebra.base(A)) ∉ S
  shows IntegrallyClosedDomain(Algebra.ring(A))
proof
  sorry

-- The integral closure of R in an algebra B is the integral closure in
-- the sense of IsIntegralClosure (integralClosure.isIntegralClosure), and
-- integral closures are unique up to isomorphism (IsIntegralClosure.equiv).
theorem integralClosure.is_integral_closure (B : Set)
  requires algebra : Algebra(B)
  shows IsIntegralClosure(Algebra.mk(Algebra.base(B),
      subringRing(Algebra.ring(B), integralClosure(B)),
      Algebra.map(B)), B, identity(integralClosure(B)))
proof
  sorry

theorem IsIntegralClosure.unique (C C2 B j j2 : Set)
  requires first : IsIntegralClosure(C, B, j)
  requires second : IsIntegralClosure(C2, B, j2)
  shows ∃ e, e : C ≃ₐ C2
proof
  sorry

-- An integral closure is integral over R (IsIntegralClosure.isIntegral),
-- and when B is a finite algebra over a Noetherian ring it is finite
-- (IsIntegralClosure.finite, IsIntegralClosure.isNoetherian under
-- finiteness of B).
theorem IsIntegralClosure.integral (C B j : Set)
  requires closure : IsIntegralClosure(C, B, j)
  shows IntegralAlgebra(C)
proof
  sorry

theorem IsIntegralClosure.finite_of_finite (C B j : Set)
  requires closure : IsIntegralClosure(C, B, j)
  requires noetherian : NoetherianRing(Algebra.base(B))
  requires finite : FiniteAlgebra(B)
  shows FiniteAlgebra(C) ∧ NoetherianRing(Algebra.ring(C))
proof
  sorry
