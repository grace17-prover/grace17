-- Integral elements and integral closure: x in an R-algebra A is integral
-- when it is a root of a monic polynomial over R (Mathlib's IsIntegral),
-- integral algebras (Algebra.IsIntegral), the integral closure as a
-- subalgebra, integral closures and integrally closed domains
-- (IsIntegralClosure, IsIntegrallyClosedIn, IsIntegrallyClosed), algebraic
-- elements over a field, the finiteness characterization, transitivity,
-- determinants of integral matrices, lying over and going up, and the
-- integral closedness of unique factorization domains.
-- Part of the GRH blueprint.
-- Planned home: Algebra/Ring/Integral (beside Cumulus's IntegralOver).
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Algebra.Integral
import GRH.Algebra.Finiteness
import Grace.Cumulus.Algebra.IntegralFinite
import Grace.Cumulus.Algebra.Field.IntegralDescent

-- Section: Integral and algebraic elements
-- x ∈ A is integral over R = Algebra.base(A): p(x) = 0 for a monic p ∈ R[X]
-- (IsIntegral). Cumulus's IntegralOver is the same notion with the monic
-- polynomial as a coefficient list.
predicate IntegralElement (A x : Set) :=
  Algebra(A) ∧ x ∈ algebraCarrier(A) ∧
  (∃ p, PolyMonic(Algebra.base(A), p) ∧
    polyAeval(A, x, p) = Ring.zero(Algebra.ring(A)))

-- x is algebraic: a root of a nonzero polynomial (IsAlgebraic).
predicate AlgebraicElement (A x : Set) :=
  Algebra(A) ∧ x ∈ algebraCarrier(A) ∧
  (∃ p ∈ Ring.carrier(polynomialRing(Algebra.base(A), {0})),
    p ≠ Ring.zero(polynomialRing(Algebra.base(A), {0})) ∧
    polyAeval(A, x, p) = Ring.zero(Algebra.ring(A)))

-- An integral algebra (Algebra.IsIntegral) and an algebraic one
-- (Algebra.IsAlgebraic).
predicate IntegralAlgebra (A : Set) :=
  Algebra(A) ∧ (∀ x ∈ algebraCarrier(A), IntegralElement(A, x))

predicate AlgebraicAlgebra (A : Set) :=
  Algebra(A) ∧ (∀ x ∈ algebraCarrier(A), AlgebraicElement(A, x))

-- The integral closure of R in A (integralClosure R A).
def integralClosure (A : Set) : Set :=
  { x ∈ algebraCarrier(A) | IntegralElement(A, x) }

-- R is integrally closed in A: the structure map is injective and its
-- image is the set of integral elements (IsIntegrallyClosedIn, i.e.
-- IsIntegralClosure R R A).
predicate IntegrallyClosedIn (A : Set) :=
  Algebra(A) ∧
  InjectiveBetween(Algebra.map(A), Ring.carrier(Algebra.base(A)), algebraCarrier(A)) ∧
  integralClosure(A) = functionImage(Algebra.map(A),
    Ring.carrier(Algebra.base(A)), algebraCarrier(A))

-- C with j : C → B is the integral closure of R in B, where B and C are
-- R-algebras and j an injective algebra homomorphism onto the integral
-- elements of B (IsIntegralClosure C R B).
predicate IsIntegralClosure (C B j : Set) :=
  AlgebraHom(j, C, B) ∧ InjectiveBetween(j, algebraCarrier(C), algebraCarrier(B)) ∧
  functionImage(j, algebraCarrier(C), algebraCarrier(B)) = integralClosure(B)

-- An integrally closed domain: integrally closed in its fraction field
-- (IsIntegrallyClosed R, by IsIntegralClosure R R (FractionRing R)).
predicate IntegrallyClosedDomain (R : Set) :=
  IntegralDomain(R) ∧ IntegrallyClosedIn(localizationAlgebra(R, nonZeroDivisors(R)))

-- An element y of a ring S is integral along f : R →+* S
-- (RingHom.IsIntegralElem), and f is integral (RingHom.IsIntegral).
predicate IntegralAlong (f R S y : Set) :=
  IntegralElement(Algebra.mk(R, S, f), y)

predicate IntegralHom (f R S : Set) :=
  RingHom(f, R, S) ∧ (∀ y ∈ Ring.carrier(S), IntegralAlong(f, R, S, y))

-- Section: Laws of integral elements
section IntegralElements
variable (A : Set)
hypothesis algebra : Algebra(A)

-- The polynomial and the list forms agree.
theorem IntegralElement.iff_cumulus (x : Set)
  requires member : x ∈ algebraCarrier(A)
  shows IntegralElement(A, x) ↔
    IntegralOver(Algebra.map(A), Ring.carrier(Algebra.base(A)), algebraCarrier(A),
      Ring.add(Algebra.ring(A)), Ring.zero(Algebra.ring(A)),
      Ring.mul(Algebra.ring(A)), Ring.one(Algebra.ring(A)), x)
proof
  sorry

-- isIntegral_algebraMap, isIntegral_zero, isIntegral_one.
theorem IntegralElement.algebra_map (a : Set)
  requires scalar : a ∈ Ring.carrier(Algebra.base(A))
  shows IntegralElement(A, Algebra.map(A)(a))
proof
  sorry

-- IsIntegral.add, mul, neg, sub, pow, smul: the integral elements form a
-- subalgebra (integralClosure).
theorem IntegralElement.add (x y : Set)
  requires first : IntegralElement(A, x)
  requires second : IntegralElement(A, y)
  shows IntegralElement(A, call2(Ring.add(Algebra.ring(A)), x, y))
proof
  sorry

theorem IntegralElement.mul (x y : Set)
  requires first : IntegralElement(A, x)
  requires second : IntegralElement(A, y)
  shows IntegralElement(A, call2(Ring.mul(Algebra.ring(A)), x, y))
proof
  sorry

theorem IntegralElement.neg (x : Set)
  requires integral : IntegralElement(A, x)
  shows IntegralElement(A, apply(Ring.neg(Algebra.ring(A)), x))
proof
  sorry

theorem IntegralElement.sub (x y : Set)
  requires first : IntegralElement(A, x)
  requires second : IntegralElement(A, y)
  shows IntegralElement(A, Ring.sub(Algebra.ring(A), x, y))
proof
  sorry

theorem IntegralElement.pow (x : Set) (n : Nat)
  requires integral : IntegralElement(A, x)
  shows IntegralElement(A, Ring.pow(Algebra.ring(A), x, n))
proof
  sorry

theorem IntegralElement.smul (a x : Set)
  requires scalar : a ∈ Ring.carrier(Algebra.base(A))
  requires integral : IntegralElement(A, x)
  shows IntegralElement(A, call2(Ring.mul(Algebra.ring(A)), Algebra.map(A)(a), x))
proof
  sorry

theorem integralClosure.subalgebra
  shows SubalgebraOf(A, integralClosure(A))
proof
  sorry

-- The finiteness criterion: x is integral iff R[x] is a finite R-module
-- (IsIntegral.fg_adjoin_singleton, isIntegral_iff_fg_adjoin), and an
-- element of a subalgebra that is a finite module is integral
-- (IsIntegral.of_mem_of_fg, IsIntegral.of_finite).
theorem IntegralElement.iff_adjoin_finite (x : Set)
  requires member : x ∈ algebraCarrier(A)
  shows IntegralElement(A, x) ↔
    SubmoduleFG(algebraModule(A), Algebra.base(A), adjoinOf(A, {x}))
proof
  sorry

theorem IntegralElement.of_mem_fg (T x : Set)
  requires subalgebra : SubalgebraOf(A, T)
  requires finite : SubmoduleFG(algebraModule(A), Algebra.base(A), T)
  requires member : x ∈ T
  shows IntegralElement(A, x)
proof
  sorry

theorem IntegralAlgebra.of_finite
  requires finite : FiniteAlgebra(A)
  shows IntegralAlgebra(A)
proof
  sorry

-- An algebra of finite type that is integral is finite
-- (Algebra.IsIntegral.finite, Cumulus's
-- FinitelyGeneratedAlgebra.finite_module_of_integral); finitely many
-- integral elements generate a finite subalgebra (fg_adjoin_of_finite).
theorem FiniteAlgebra.of_integral_finite_type
  requires integral : IntegralAlgebra(A)
  requires finiteType : FiniteTypeAlgebra(A)
  shows FiniteAlgebra(A)
proof
  sorry

theorem adjoinOf.finite_of_integral (G : Set)
  requires finite : Finite(G)
  requires integral : ∀ x ∈ G, IntegralElement(A, x)
  shows SubmoduleFG(algebraModule(A), Algebra.base(A), adjoinOf(A, G))
proof
  sorry

-- IsIntegral.map: algebra homomorphisms preserve integrality; the image
-- under a surjection of an integral algebra is integral.
theorem IntegralElement.map (B f x : Set)
  requires hom : f : A →ₐ B
  requires integral : IntegralElement(A, x)
  shows IntegralElement(B, f(x))
proof
  sorry

-- The integral closure is integrally closed (integralClosure_idem): an
-- element of A integral over the integral closure is in it.
theorem integralClosure.idempotent (x : Set)
  requires member : x ∈ algebraCarrier(A)
  requires integral : IntegralElement(Algebra.mk(subringRing(Algebra.ring(A),
    integralClosure(A)), Algebra.ring(A), identity(integralClosure(A))), x)
  shows x ∈ integralClosure(A)
proof
  sorry

-- Over a field, integral and algebraic agree (isAlgebraic_iff_isIntegral,
-- IsIntegral.isAlgebraic); over a domain an algebraic element times a
-- nonzero scalar is integral (IsAlgebraic.exists_smul_eq_mul... in the
-- form exists_integral_multiple).
theorem AlgebraicElement.iff_integral (x : Set)
  requires field : Field(Algebra.base(A))
  shows AlgebraicElement(A, x) ↔ IntegralElement(A, x)
proof
  sorry

theorem IntegralElement.algebraic (x : Set)
  requires nontrivial : Ring.zero(Algebra.base(A)) ≠ Ring.one(Algebra.base(A))
  requires integral : IntegralElement(A, x)
  shows AlgebraicElement(A, x)
proof
  sorry

theorem AlgebraicElement.integral_multiple (x : Set)
  requires domain : IntegralDomain(Algebra.base(A))
  requires algebraic : AlgebraicElement(A, x)
  shows ∃ a ∈ Ring.carrier(Algebra.base(A)), a ≠ Ring.zero(Algebra.base(A)) ∧
    IntegralElement(A, call2(Ring.mul(Algebra.ring(A)), Algebra.map(A)(a), x))
proof
  sorry

-- Over a field, the inverse of an integral element lies in R[x]
-- (the subalgebra form of IsIntegral.inv_mem_adjoin... used for field
-- towers).
theorem IntegralElement.inverse_mem_adjoin (x y : Set)
  requires field : Field(Algebra.base(A))
  requires integral : IntegralElement(A, x)
  requires inverse : call2(Ring.mul(Algebra.ring(A)), x, y) = Ring.one(Algebra.ring(A))
  requires member : y ∈ algebraCarrier(A)
  shows y ∈ adjoinOf(A, {x})
proof
  sorry

-- IsIntegral.det: the determinant of a matrix with integral entries is
-- integral.
theorem IntegralElement.det (n M : Set)
  requires finite : Finite(n)
  requires matrix : M ∈ matrixSpace(Algebra.ring(A), n, n)
  requires entries : ∀ i ∈ n, ∀ j ∈ n, IntegralElement(A, M((i, j)))
  shows IntegralElement(A, matDet(Algebra.ring(A), n, M))
proof
  sorry

end IntegralElements

-- Section: Towers and integral extensions
-- Transitivity (isIntegral_trans, Algebra.IsIntegral.trans): for
-- R → A → B with A integral over R, an element of B integral over A is
-- integral over R.
theorem IntegralElement.trans (A B x : Set)
  requires integralA : IntegralAlgebra(A)
  requires algebraB : Algebra(B)
  requires tower : Algebra.base(B) = Algebra.ring(A)
  requires integral : IntegralElement(B, x)
  shows IntegralElement(Algebra.mk(Algebra.base(A), Algebra.ring(B),
    compose(Algebra.map(B), Algebra.map(A), Ring.carrier(Algebra.base(A)),
      algebraCarrier(A), algebraCarrier(B))), x)
proof
  sorry

-- An integral extension of domains: the base is a field iff the extension
-- is (isField_of_isIntegral_of_isField', Cumulus's
-- IsField.of_integral_extension).
theorem IntegralAlgebra.field_iff (A : Set)
  requires integral : IntegralAlgebra(A)
  requires domain : IntegralDomain(Algebra.ring(A))
  requires injective : InjectiveBetween(Algebra.map(A), Ring.carrier(Algebra.base(A)),
    algebraCarrier(A))
  shows Field(Algebra.base(A)) ↔ Field(Algebra.ring(A))
proof
  sorry

-- In an integral extension the contraction of a maximal ideal is maximal
-- (Ideal.isMaximal_comap_of_isIntegral_of_isMaximal), and a prime
-- contracting to a maximal ideal is maximal
-- (Ideal.IsMaximal.of_isIntegral_of_isMaximal_comap).
theorem IntegralAlgebra.comap_maximal (A M : Set)
  requires integral : IntegralAlgebra(A)
  requires maximal : MaximalIdeal(Algebra.ring(A), M)
  shows MaximalIdeal(Algebra.base(A),
    idealComap(Algebra.map(A), Ring.carrier(Algebra.base(A)), M))
proof
  sorry

theorem IntegralAlgebra.maximal_of_comap (A P : Set)
  requires integral : IntegralAlgebra(A)
  requires prime : PrimeIdeal(Algebra.ring(A), P)
  requires maximal : MaximalIdeal(Algebra.base(A),
    idealComap(Algebra.map(A), Ring.carrier(Algebra.base(A)), P))
  shows MaximalIdeal(Algebra.ring(A), P)
proof
  sorry

-- Lying over (Ideal.exists_ideal_over_prime_of_isIntegral): for an
-- integral extension with injective structure map, every prime of R is
-- the contraction of a prime of A; going up extends a lying-over prime
-- above a larger prime. Both build a prime by Zorn's lemma: Choice.
theorem IntegralAlgebra.lying_over (A P : Set)
  requires integral : IntegralAlgebra(A)
  requires kernel : ringKernel(Algebra.map(A), Ring.carrier(Algebra.base(A)),
    Ring.zero(Algebra.ring(A))) ⊆ P
  requires prime : PrimeIdeal(Algebra.base(A), P)
  shows ∃ Q, PrimeIdeal(Algebra.ring(A), Q) ∧ LiesOver(Algebra.map(A), Algebra.base(A), Q, P)
proof
  sorry

theorem IntegralAlgebra.going_up (A P P2 Q : Set)
  requires integral : IntegralAlgebra(A)
  requires primeQ : PrimeIdeal(Algebra.ring(A), Q)
  requires over : LiesOver(Algebra.map(A), Algebra.base(A), Q, P)
  requires larger : PrimeIdeal(Algebra.base(A), P2)
  requires subset : P ⊆ P2
  shows ∃ Q2, PrimeIdeal(Algebra.ring(A), Q2) ∧ Q ⊆ Q2 ∧
    LiesOver(Algebra.map(A), Algebra.base(A), Q2, P2)
proof
  sorry

-- Incomparability (Ideal.comap_lt_comap_of_integral_mem_sdiff): primes
-- lying over the same prime are incomparable.
theorem IntegralAlgebra.incomparable (A P Q1 Q2 : Set)
  requires integral : IntegralAlgebra(A)
  requires first : PrimeIdeal(Algebra.ring(A), Q1)
  requires second : PrimeIdeal(Algebra.ring(A), Q2)
  requires overFirst : LiesOver(Algebra.map(A), Algebra.base(A), Q1, P)
  requires overSecond : LiesOver(Algebra.map(A), Algebra.base(A), Q2, P)
  requires subset : Q1 ⊆ Q2
  shows Q1 = Q2
proof
  sorry

-- Section: Integrally closed domains
-- A UFD is integrally closed (UniqueFactorizationMonoid.instIsIntegrallyClosed),
-- so is a PID, and a field.
theorem IntegrallyClosedDomain.of_ufd (R : Set)
  requires ufd : UniqueFactorizationDomain(R)
  shows IntegrallyClosedDomain(R)
proof
  sorry

theorem IntegrallyClosedDomain.of_field (K : Set)
  requires field : Field(K)
  shows IntegrallyClosedDomain(K)
proof
  sorry

-- An integrally closed domain: an element of any fraction field that is
-- integral over R lies in R (IsIntegrallyClosed.isIntegral_iff), stated
-- for every IsFractionRing algebra.
theorem IntegrallyClosedDomain.integral_iff (K x : Set)
  requires closed : IntegrallyClosedDomain(Algebra.base(K))
  requires fractions : IsFractionRing(K)
  requires member : x ∈ algebraCarrier(K)
  shows IntegralElement(K, x) ↔
    (∃ a ∈ Ring.carrier(Algebra.base(K)), x = Algebra.map(K)(a))
proof
  sorry

-- The rational root theorem behind IsLocalization.scaleRoots_commonDenom_mem_lifts:
-- a root a / b in the fraction field of a monic polynomial over a UFD has
-- b a unit.
theorem IntegrallyClosedDomain.monic_root (K p x : Set)
  requires closed : IntegrallyClosedDomain(Algebra.base(K))
  requires fractions : IsFractionRing(K)
  requires monic : PolyMonic(Algebra.base(K), p)
  requires member : x ∈ algebraCarrier(K)
  requires root : polyAeval(K, x, p) = Ring.zero(Algebra.ring(K))
  shows ∃ a ∈ Ring.carrier(Algebra.base(K)), x = Algebra.map(K)(a) ∧
    PolyIsRoot(Algebra.base(K), p, a)
proof
  sorry

-- A localization of an integrally closed domain is integrally closed
-- (IsLocalization.isIntegrallyClosed... for localizations at
-- submonoids without zero).
theorem IntegrallyClosedDomain.localization (S A : Set)
  requires closed : IntegrallyClosedDomain(Algebra.base(A))
  requires localization : IsLocalization(S, A)
  requires noZero : Ring.zero(Algebra.base(A)) ∉ S
  shows IntegrallyClosedDomain(Algebra.ring(A))
proof
  sorry

-- The integral closure of R in an algebra B is the integral closure in
-- the sense of IsIntegralClosure (integralClosure.isIntegralClosure), and
-- integral closures are unique up to isomorphism (IsIntegralClosure.equiv).
theorem integralClosure.is_integral_closure (B : Set)
  requires algebra : Algebra(B)
  shows IsIntegralClosure(Algebra.mk(Algebra.base(B),
      subringRing(Algebra.ring(B), integralClosure(B)),
      Algebra.map(B)), B, identity(integralClosure(B)))
proof
  sorry

theorem IsIntegralClosure.unique (C C2 B j j2 : Set)
  requires first : IsIntegralClosure(C, B, j)
  requires second : IsIntegralClosure(C2, B, j2)
  shows ∃ e, e : C ≃ₐ C2
proof
  sorry

-- An integral closure is integral over R (IsIntegralClosure.isIntegral),
-- and when B is a finite algebra over a Noetherian ring it is finite
-- (IsIntegralClosure.finite, IsIntegralClosure.isNoetherian under
-- finiteness of B).
theorem IsIntegralClosure.integral (C B j : Set)
  requires closure : IsIntegralClosure(C, B, j)
  shows IntegralAlgebra(C)
proof
  sorry

theorem IsIntegralClosure.finite_of_finite (C B j : Set)
  requires closure : IsIntegralClosure(C, B, j)
  requires noetherian : NoetherianRing(Algebra.base(B))
  requires finite : FiniteAlgebra(B)
  shows FiniteAlgebra(C) ∧ NoetherianRing(Algebra.ring(C))
proof
  sorry
