-- The ratio of consecutive masses of unimodular hermitian lattices over a
-- CM field with Weil data: log(mass_(j+1)/mass_j) is
-- f ((j + 1/2) log rd + log j! − (j + 1) log 2π) up to 2/2^u, uniformly in
-- the field, for 8f ≤ 2^u and j ≥ 4u + 12 (f the number of infinite places,
-- rd the root discriminant).
-- Source: grh-compact/src/Lib/SiegelWeil/Mass/MassRatio.lean
-- (abs_log_mass_ratio_sub_le).
-- Not stated (the rest of src/Lib/SiegelWeil): Formula (SiegelSets,
-- ZeroTermHeight, SiegelWeilFormula), OneVector, Mass/TorusMajorant,
-- SingularForms, StrongApproximation, Tower and RallisInner, which need
-- the hermitian spaces Space E n s, splittings, the mixed and Schrödinger
-- models of the Weil representation, theta integrals and automorphic
-- functions on the adelic unitary groups of Lib/Weil and Lib/Adelic.
-- Encoding. The source's [CMType E] [WeilData E] is a Weil datum record W
-- with IsWeilDatum(W) (GRH.Weil.Unramified); mass E l is layer 4's
-- mass(E, Φ, l) (GRH.Adelic.QuotientMeasure), a positive real read as a
-- complex number, whose real part is taken.
-- Part of the GRH blueprint (layer 4, Lib/SiegelWeil, stage S3).
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.SiegelWeil.MassRatio
import GRH.Weil.Unramified

section MassRatio
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- The mass of rank l as a real number, and the number f of infinite places.
def massReal (W : Set, l : Nat) : Set :=
  complexRe(mass(WeilDatum.field(W), WeilDatum.cmType(W), l))

def numInfPlaces (E : Set) : Set := cardinality(infinitePlaces(E))

-- The main term f ((j + 1/2) log rd + log j! − (j + 1) log 2π).
def massRatioMain (E : Set, j : Nat) : Set :=
  R[realNat(numInfPlaces(E)) *
    ((realNat(j) + realOne / 2) * realLog(rootDiscr(E)) + realLog(realNat(factorial(j))) -
      (realNat(j) + realOne) * realLog(R[2 * realPi]))]

def massRatioError (W : Set, j : Nat) : Set :=
  R[realLog(massReal(W, succ(j))) - realLog(massReal(W, j)) - massRatioMain(WeilDatum.field(W), j)]

-- abs_log_mass_ratio_sub_le (Gan–Hanke–Yu; Kirschmer 4.2.7, 4.2.9): for
-- 8f ≤ 2^u and j ≥ 4u + 12, |log(mass_(j+1)/mass_j) − main term| ≤ 2/2^u.
theorem massRatio.log_error (W : Set, j u : Nat)
  requires weil : IsWeilDatum(W)
  requires places : mul(8, numInfPlaces(WeilDatum.field(W))) ≤ pow(2, u)
  requires large : add(mul(4, u), 12) ≤ j
  shows R[-(2 / realNat(pow(2, u)))] ≤ massRatioError(W, j) ∧
    massRatioError(W, j) ≤ R[2 / realNat(pow(2, u))]
proof
  sorry

end MassRatio
