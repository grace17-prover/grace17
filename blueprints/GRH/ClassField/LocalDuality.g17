-- Authors: Grant Passmore

module GRH.ClassField.LocalDuality
import GRH.ClassField.Cohomology

section LocalDualityDefs

-- The restricted data of an open subgroup V: V as a group, its topology,
-- the action, and Ω over the fixed field of V.
def subGroupOf (G V : Set) : Set := subgroupGroup(G, V)

def subActionOf (ρ V : Set) : Set := restrict(ρ, V)

-- Z¹(Γ, μ_n): the continuous 1-cocycles into Ωˣ killed by n.
def kummerCocycles (G X ρ W : Set, n : Nat) : Set :=
  { f ∈ Z1(G, X, omegaUnits(W), unitsAction(G, ρ, W)) |
    ∀ g ∈ Group.carrier(G), Ring.pow(W, f(g), n) = Ring.one(W) }

-- The restriction of the class of an invariant to an open V.
def unitsResH2 (G X ρ W V : Set) : Set :=
  resH2(G, X, omegaUnits(W), unitsAction(G, ρ, W), V)

-- The multiples of a class β.
def classMultiples (H β : Set) : Set := { groupZpow(H, β, z) | z ∈ ℤ }

end LocalDualityDefs

section LocalBrauer
variable (G X ρ E A : Set)
hypothesis local : IsLocalGalois(G, X, ρ, E, A)

-- isClassOfInv_classOfInv: the class-of-invariant map exists and is the
-- unique one; classOfInv_bijective: ℚ/ℤ ≅ Br(k).
theorem classOfInv.spec
  shows IsClassOfInv(G, X, ρ, E, A, classOfInv(G, X, ρ, E, A)) ∧
    (∀ b, IsClassOfInv(G, X, ρ, E, A, b) → b = classOfInv(G, X, ρ, E, A))
proof
  sorry

theorem classOfInv.bijective
  shows BijectiveBetween(classOfInv(G, X, ρ, E, A), Group.carrier(qzGroup),
    Group.carrier(unitsH2(G, X, ρ, Algebra.ring(E))))
proof
  sorry

-- resH2_classOfInv: restriction to an open V multiplies the invariant by
-- [Γ : V]; resH2_classOfInv_eq_zero; exists_resH2_classOfInv_eq: every
-- class of H²(V, Ωˣ) is such a restriction.
theorem classOfInv.restrict (V r : Set)
  requires open : OpenSubgroup(V, G, X)
  requires element : r ∈ Group.carrier(qzGroup)
  shows IsLocalGalois(subGroupOf(G, V), subspace(X, V), subActionOf(ρ, V),
      fixedFieldExtension(G, ρ, E, V), A) ∧
    unitsResH2(G, X, ρ, Algebra.ring(E), V)(classOfInv(G, X, ρ, E, A)(r)) =
      classOfInv(subGroupOf(G, V), subspace(X, V), subActionOf(ρ, V),
        fixedFieldExtension(G, ρ, E, V), A)(groupPow(qzGroup, r, index(G, V)))
proof
  sorry

theorem classOfInv.restrict_surjective (V y : Set)
  requires open : OpenSubgroup(V, G, X)
  requires class : y ∈ Group.carrier(unitsH2(subGroupOf(G, V), subspace(X, V), subActionOf(ρ, V),
    Algebra.ring(E)))
  shows ∃ r ∈ Group.carrier(qzGroup),
    unitsResH2(G, X, ρ, Algebra.ring(E), V)(classOfInv(G, X, ρ, E, A)(r)) = y
proof
  sorry

-- mem_zmultiples_of_resH2_eq_zero: for V open normal and β dying on V with
-- nβ = 0 only for [Γ:V] | n, every class dying on V is a multiple of β.
theorem unitsH2.multiple_of_split (V β x : Set)
  requires open : OpenSubgroup(V, G, X)
  requires normal : NormalSubgroup(V, G)
  requires classβ : β ∈ Group.carrier(unitsH2(G, X, ρ, Algebra.ring(E)))
  requires classx : x ∈ Group.carrier(unitsH2(G, X, ρ, Algebra.ring(E)))
  requires diesβ : unitsResH2(G, X, ρ, Algebra.ring(E), V)(β) =
    Group.one(unitsH2(subGroupOf(G, V), subspace(X, V), subActionOf(ρ, V), Algebra.ring(E)))
  requires order : ∀ n ∈ ℕ, groupPow(unitsH2(G, X, ρ, Algebra.ring(E)), β, n) =
    Group.one(unitsH2(G, X, ρ, Algebra.ring(E))) → index(G, V) ∣ n
  requires diesx : unitsResH2(G, X, ρ, Algebra.ring(E), V)(x) =
    Group.one(unitsH2(subGroupOf(G, V), subspace(X, V), subActionOf(ρ, V), Algebra.ring(E)))
  shows x ∈ classMultiples(unitsH2(G, X, ρ, Algebra.ring(E)), β)
proof
  sorry

-- card_kummer_cocycles: Z¹(Γ, μ_n) has n²·#(O/n) elements.
theorem kummerCocycles.card (n : Nat)
  requires positive : 0 < n
  shows Finite(kummerCocycles(G, X, ρ, Algebra.ring(E), n)) ∧
    cardinality(kummerCocycles(G, X, ρ, Algebra.ring(E), n)) =
      mul(mul(n, n), localIntegersModCard(E, A, n))
proof
  sorry

-- finite_Z1_local: Z¹(Γ, M) is finite for a finite discrete module M.
theorem Z1.finite_local (M act : Set)
  requires module : DiscreteGModule(G, X, M, act)
  requires finite : Finite(Group.carrier(M))
  shows Finite(Z1(G, X, M, act))
proof
  sorry

-- IsLocalArtin.exists_frob_of_isUniformiser: a local Artin map sends a
-- uniformiser π to the class of φ⁻¹ for a Frobenius φ.
theorem IsLocalArtin.uniformiser_frobenius (f π : Set)
  requires artin : IsLocalArtin(G, X, ρ, E, A, E, f)
  requires unit : π ∈ ringUnits(Algebra.base(E))
  requires uniformiser : IsUniformiser(E, A, π)
  shows ∃ φ ∈ Group.carrier(G), IsFrob(G, ρ, Algebra.ring(E), A, residueCard(E, A), φ) ∧
    f(π) = abelianClass(G, X, Group.inv(G)(φ))
proof
  sorry

-- char_eq_zero_of_cyclicClass_eq_zero: a character χ with (χ, w) = 0 for
-- every w ∈ kˣ is trivial.
theorem qzChars.trivial_of_symbols (χ : Set)
  requires character : χ ∈ qzChars(G, X)
  requires symbols : ∀ w ∈ ringUnits(Algebra.base(E)),
    unitsCyclicClass(G, X, ρ, Algebra.ring(E), χ, Algebra.map(E)(w)) =
      Group.one(unitsH2(G, X, ρ, Algebra.ring(E)))
  shows ∀ g ∈ Group.carrier(G), χ(g) = Group.one(qzGroup)
proof
  sorry

end LocalBrauer

section RealPlaces
variable (G X ρ E Q : Set)
hypothesis galois : IsProGalois(G, X, ρ, E)
hypothesis qbar : IsQbar(Q)
hypothesis closure : Algebra.ring(E) = Algebra.ring(Q)
hypothesis number : NumberField(Algebra.base(E))

-- isTotallyPositive_of_isTotallyComplex: over a totally complex field
-- every element is totally positive.
theorem IsTotallyPositive.of_totally_complex (x : Set)
  requires complex : TotallyComplex(Algebra.base(E))
  requires member : x ∈ Ring.carrier(Algebra.base(E))
  shows IsTotallyPositive(Algebra.base(E), x)
proof
  sorry

-- exists_isComplexConj: a real place gives a complex conjugation in Γ;
-- IsComplexConj.mul_self: c² = 1; false_of_isTotallyComplex.
theorem IsComplexConj.exists (w : Set)
  requires real : RealPlace(Algebra.base(E), w)
  shows ∃ c, IsComplexConj(G, ρ, Algebra.ring(E), c)
proof
  sorry

theorem IsComplexConj.involution (c : Set)
  requires conj : IsComplexConj(G, ρ, Algebra.ring(E), c)
  shows Group.mul(G)(c, c) = Group.one(G)
proof
  sorry

-- (False, stated as the contradiction c ∉ Γ.)
theorem IsComplexConj.not_totally_complex (c : Set)
  requires conj : IsComplexConj(G, ρ, Algebra.ring(E), c)
  requires complex : TotallyComplex(Algebra.base(E))
  shows c ∉ Group.carrier(G)
proof
  sorry

-- IsComplexConj.cycCharMod_eq_neg_one and cycChar_eq_neg_one.
theorem IsComplexConj.cyclotomic_mod (c : Set, N : Nat)
  requires conj : IsComplexConj(G, ρ, Algebra.ring(E), c)
  requires positive : 0 < N
  shows cycCharMod(G, ρ, Algebra.ring(E), N)(c) = apply(Ring.neg(zmod(N)), Ring.one(zmod(N)))
proof
  sorry

theorem IsComplexConj.cyclotomic (c : Set, l : Nat)
  requires conj : IsComplexConj(G, ρ, Algebra.ring(E), c)
  requires prime : Prime(l)
  shows cycChar(G, ρ, Algebra.ring(E), l)(c) =
    apply(Ring.neg(padicIntRing(l)), Ring.one(padicIntRing(l)))
proof
  sorry

-- IsTotallyPositive.exists_resH2_cyclicClass_eq_zero: for x totally
-- positive, (χ, x) dies on an open subgroup containing every complex
-- conjugation.
theorem IsTotallyPositive.symbol_dies (χ x : Set)
  requires character : χ ∈ qzChars(G, X)
  requires unit : x ∈ ringUnits(Algebra.base(E))
  requires positive : IsTotallyPositive(Algebra.base(E), x)
  shows ∃ U, OpenSubgroup(U, G, X) ∧
    (∀ c, IsComplexConj(G, ρ, Algebra.ring(E), c) → c ∈ U) ∧
    unitsResH2(G, X, ρ, Algebra.ring(E), U)(unitsCyclicClass(G, X, ρ, Algebra.ring(E), χ,
      Algebra.map(E)(x))) =
      Group.one(unitsH2(subGroupOf(G, U), subspace(X, U), subActionOf(ρ, U), Algebra.ring(E)))
proof
  sorry

end RealPlaces
