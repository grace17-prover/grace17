-- Unitary Hecke characters of a CM field E with CM type Φ: continuous
-- characters of the ideles (𝔸 E)ˣ = (ℂ^Φ × 𝔸_f E)ˣ into the unit circle,
-- trivial on Eˣ; their finite part and value at uniformisers; x ↦ x/x̄ and
-- the base change μ ↦ μ(x/x̄) from characters of U(1)(𝔸); the rational and
-- tame-level points of U(1)(𝔸) and the finiteness of its class group;
-- Hilbert 90 for finite ideles; the laws of weight and tame part
-- (products, powers, existence from a character on integral points,
-- the characters of weight 0 and given tame level), Kronecker's theorem
-- for γγ̄ = 1, the p-adic absolute values and the Galois conjugates of a
-- character with a weight.
-- Source: grh-compact/src/Lib/ClassField/HeckeCharacter/CharacterDefs.lean
-- (charsTrivialOnRat, HeckeChar, HeckeChar.finPart, HeckeChar.atUnif,
-- divStar, AutChar.baseChange), CharacterLevels.lean (rationalU1,
-- integralU1, isOpen_integralU1, mem_integralU1_of_snd_eq_one,
-- exists_divStar, reduceU1, finite_u1_classGroup),
-- CharacterConjugates.lean (pow_torsionOrder_eq_one, HasWeight.one, mul,
-- inv, exists_hasWeight, exists_hasWeight_of_prod_eq_one, tameChars,
-- exists_mem_tameChars, finite_tameChars, HasWeight.exists_pow_eq_prod,
-- HasWeight.norm_padic_eq_prod, HasWeight.norm_map_eq_one,
-- HasWeight.exists_conj). Part of: "Algebraic Hecke characters (type A₀);
-- extension of the quadratic character of a CM field (known result; see
-- Lib.ClassField.HeckeCharacter.SplittingCharExists)."
-- Encoding. The characters of U(1)(𝔸) (AutChar), their weight and tame
-- part (AutChar.HasWeight) are those of GRH.Proof.Forward.Characters
-- (autChars, HasWeight), whose weight e is a function on Φ. A Hecke
-- character is a function on the ideles cmIdeles(E, Φ) (HeckeCharOf). The
-- ideles carry the units topology of 𝔸 (through u ↦ (u, u⁻¹)). The
-- source's group (_ ⧸ rationalU1 ⊔ integralU1 S) is the set of cosets of
-- the product subgroup in the group U(1)(𝔸). The source's
-- HasWeight.zpow is stated for natural powers (autCharPow), with inv for
-- the negative ones.
-- Part of the GRH blueprint (layer 4, Lib/ClassField, stage S1).
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.ClassField.HeckeCharacter
import GRH.ClassField.HeckeL

section HeckeCharacter
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)

-- Section: The ideles of 𝔸 = ℂ^Φ × 𝔸_f
-- (𝔸 E)ˣ, its group, the inverse, and its units topology.
def cmIdeles (E Φ : Set) : Set := ringUnits(cmAdeleRing(E, Φ))

def cmIdeleGroup (E Φ : Set) : Set := unitGroup(cmAdeleRing(E, Φ))

def cmAdeleInv (E Φ u : Set) : Set :=
  ⋃({ b ∈ cmAdeles(E, Φ) | call2(Ring.mul(cmAdeleRing(E, Φ)), u, b) = Ring.one(cmAdeleRing(E, Φ)) })

def cmIdeleGraphPoint (E Φ u : Set) : Set := (u, cmAdeleInv(E, Φ, u))

def cmIdelePreimage (E Φ W : Set) : Set :=
  { u ∈ cmIdeles(E, Φ) | cmIdeleGraphPoint(E, Φ, u) ∈ W }

def cmIdeleOpens (E Φ : Set) : Set :=
  { cmIdelePreimage(E, Φ, W) |
    W ∈ TopologicalSpace.opens(productSpace(cmAdeleSpace(E, Φ), cmAdeleSpace(E, Φ))) }

def cmIdeleSpace (E Φ : Set) : Set := TopologicalSpace.mk(cmIdeles(E, Φ), cmIdeleOpens(E, Φ))

def cmAdeleMul (E Φ x y : Set) : Set := call2(Ring.mul(cmAdeleRing(E, Φ)), x, y)

-- The idele (1, a) of a finite idele a (EulerProduct.lean, finIdeleIncl).
def onesOnPhi (Φ : Set) : Set := { (σ, complexOne) | σ ∈ Φ }

def finIdeleIncl (Φ a : Set) : Set := (onesOnPhi(Φ), a)

-- Section: Unitary Hecke characters
-- CharacterDefs.lean, HeckeChar E = charsTrivialOnRat E _ Units.val: the
-- continuous homomorphisms χ : (𝔸 E)ˣ → ℂ of absolute value 1, trivial on
-- the ideles of the elements of Eˣ.
predicate HeckeCharOf (E Φ χ : Set) :=
  FunctionBetween(χ, cmIdeles(E, Φ), complexCarrier) ∧
  (∀ x ∈ cmIdeles(E, Φ), ∀ y ∈ cmIdeles(E, Φ), χ(cmAdeleMul(E, Φ, x, y)) = ℂ[χ(x) * χ(y)]) ∧
  (∀ x ∈ cmIdeles(E, Φ), complexAbs(χ(x)) = realOne) ∧
  Continuous(χ, cmIdeleSpace(E, Φ), complexSpace) ∧
  (∀ a ∈ fieldUnits(E), χ(toCMAdele(E, Φ, a)) = complexOne)

def heckeChars (E Φ : Set) : Set :=
  { χ ∈ functionSpace(cmIdeles(E, Φ), complexCarrier) | HeckeCharOf(E, Φ, χ) }

-- CharacterDefs.lean, HeckeChar.finPart: the restriction a ↦ χ(1, a) to
-- the finite ideles; HeckeChar.atUnif: its value at the uniformiser ϖ_w.
def heckeFinPart (Φ χ E : Set) : Set :=
  { (a, χ(finIdeleIncl(Φ, a))) | a ∈ finIdeleUnits(E) }

def heckeAtUnif (E Φ χ ϖ w : Set) : Set := heckeFinPart(Φ, χ, E)(locIdele(E, w, ϖ(w)))

-- CharacterDefs.lean, divStar: x ↦ x/x̄ = x · (x̄)⁻¹, into U(1)(𝔸).
def divStar (E Φ x : Set) : Set :=
  cmAdeleMul(E, Φ, x, cmAdeleInv(E, Φ, cmAdeleStar(E, Φ)(x)))

def divStarMap (E Φ : Set) : Set := { (x, divStar(E, Φ, x)) | x ∈ cmIdeles(E, Φ) }

-- The product of two Hecke characters.
def heckeCharMul (E Φ χ ξ : Set) : Set := { (x, ℂ[χ(x) * ξ(x)]) | x ∈ cmIdeles(E, Φ) }

-- CharacterDefs.lean, AutChar.baseChange: μ ↦ (x ↦ μ(x/x̄)).
def autCharBaseChange (E Φ μ : Set) : Set :=
  { (x, μ(divStar(E, Φ, x))) | x ∈ cmIdeles(E, Φ) }

-- The weights e + e′ and −e, and the inverse of a character and of a
-- family of residue characters.
def weightSum (Φ e f : Set) : Set := { (τ, integerAdd(e(τ), f(τ))) | τ ∈ Φ }

def weightNeg (Φ e : Set) : Set := { (τ, integerNegValue(e(τ))) | τ ∈ Φ }

def autCharInv (E Φ μ : Set) : Set := { (u, complexInv(μ(u))) | u ∈ unitaryAdeles(E, Φ) }

def residueFamilyInv (E ψ : Set) : Set :=
  { (w, mulCharInverse(resField(E, w), complexRing, ψ(w))) | w ∈ finPlaces(E) }

-- Section: Rational and tame-level points of U(1)
-- U(1)(𝔸) as a group (the inverse of u is ū).
def unitaryAdeleGroup (E Φ : Set) : Set :=
  Group.mk(unitaryAdeles(E, Φ),
    restrict(Ring.mul(cmAdeleRing(E, Φ)), unitaryAdeles(E, Φ) × unitaryAdeles(E, Φ)),
    Ring.one(cmAdeleRing(E, Φ)), restrict(cmAdeleStar(E, Φ), unitaryAdeles(E, Φ)))

-- CharacterLevels.lean, rationalU1: the norm-one adeles that come from E.
def rationalU1 (E Φ : Set) : Set :=
  { u ∈ unitaryAdeles(E, Φ) | ∃ a ∈ Ring.carrier(E), u = toCMAdele(E, Φ, a) }

-- CharacterLevels.lean, integralU1 S: integral finite part, ≡ 1 modulo
-- every place of S.
def integralU1 (E Φ S : Set) : Set :=
  { u ∈ unitaryAdeles(E, Φ) | snd(u) ∈ finInt(E) ∧
    (∀ w ∈ S, reduceAt(E, w, snd(u)) = Ring.one(resField(E, w))) }

-- CharacterLevels.lean, reduceU1 w: u ↦ u mod w on integral u.
def reduceU1 (E w u : Set) : Set := reduceAt(E, w, snd(u))

-- The product rationalU1 · integralU1 S, and the class group of U(1) of
-- tame level S, as its cosets.
def u1LevelSubgroup (E Φ S : Set) : Set :=
  { cmAdeleMul(E, Φ, fst(p), snd(p)) | p ∈ rationalU1(E, Φ) × integralU1(E, Φ, S) }

def u1ClassGroup (E Φ S : Set) : Set :=
  leftCosets(unitaryAdeleGroup(E, Φ), u1LevelSubgroup(E, Φ, S))

-- Section: Characters of weight 0 and tame level S
-- CharacterConjugates.lean, tameChars S: the pairs (μ, ψ) with μ of
-- weight 0 and tame part ψ, ψ trivial outside S.
def zeroWeight (Φ : Set) : Set := { (τ, integerZero) | τ ∈ Φ }

def tameChars (E Φ S : Set) : Set :=
  { p ∈ autChars(E, Φ) × residueFamilies(E) |
    HasWeight(E, Φ, fst(p), zeroWeight(Φ), snd(p)) ∧
    (∀ w ∈ finPlaces(E), w ∉ S → snd(p)(w) = trivialResidueChar(E, w)) }

-- The elements γ ∈ E with γγ̄ = 1 (unitary E), and their product
-- ∏_τ τ(γ)^{e(τ)}.
def unitaryElements (E : Set) : Set :=
  { γ ∈ Ring.carrier(E) | call2(Ring.mul(E), γ, cmConjugation(E)(γ)) = Ring.one(E) }

def embeddingWeightFactors (Φ e γ : Set) : Set :=
  { (τ, complexIntPow(τ(γ), e(τ))) | τ ∈ Φ }

-- The tame factor ∏_{w∈S} ψ_w(γ mod w) of an integral γ.
def tameFactorsOn (E Φ ψ S γ : Set) : Set :=
  { (w, ψ(w)(reduceAt(E, w, finOf(E, γ)))) | w ∈ S }

-- Section: Conjugates
-- σ ∘ χ for σ : ℂ → ℂ and a residue character χ, and the family σ ∘ ψ.
def charAfter (σ χ A : Set) : Set := { (x, σ(χ(x))) | x ∈ A }

def residueFamilyAfter (E σ ψ : Set) : Set :=
  { (w, charAfter(σ, ψ(w), Ring.carrier(resField(E, w)))) | w ∈ finPlaces(E) }

-- The weight e ∘ p⁻¹ for a permutation p of Φ.
def weightTransport (Φ e p : Set) : Set :=
  { (τ, e(converse(p, Φ, Φ)(τ))) | τ ∈ Φ }

-- The w-component of a finite adele read in ℂ_p through φ : E → ℂ_p,
-- extended continuously to E_w at the place w that φ induces (the
-- source's adeleExtension φ, for any φ).
def adeleExtensionAlong (E p ι φ x : Set) : Set :=
  ⋃({ y ∈ Ring.carrier(placeCp(p, ι)) | ∃ ψ,
    CompletionExtension(E, inducedPlace(E, p, ι, φ), p, ι, φ, ψ) ∧
    y = ψ(x(inducedPlace(E, p, ι, φ))) })

-- ι ∘ τ : E → ℂ_p.
def placeAfter (E ι τ : Set) : Set := { (x, placeHom(ι)(τ(x))) | x ∈ Ring.carrier(E) }

def padicWeightFactors (E Φ p ι e u : Set) : Set :=
  { (τ, realRpow(placeCpNorm(p, ι)(adeleExtensionAlong(E, p, ι, placeAfter(E, ι, τ), snd(u))),
      realInt(integerNegValue(e(τ))))) | τ ∈ Φ }

-- The norm-one adeles with archimedean component 1.
def finiteUnitaryAdeles (E Φ : Set) : Set :=
  { u ∈ unitaryAdeles(E, Φ) | fst(u) = onesOnPhi(Φ) }

end HeckeCharacter

-- Section: Hecke characters and base change
section BaseChange
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)
variable (E Φ : Set)
hypothesis cmType : CMType(E, Φ)

-- The ideles form a topological group; principal ideles are ideles.
theorem cmIdeleGroup.topological_group
  shows AbelianGroup(cmIdeleGroup(E, Φ)) ∧ TopologicalSpace(cmIdeleSpace(E, Φ)) ∧
    TopologicalGroup(cmIdeleGroup(E, Φ), cmIdeleSpace(E, Φ))
proof
  sorry

-- The finite part of a Hecke character is a character of the finite
-- ideles with open kernel (HeckeChar.finPart).
theorem heckeFinPart.open_kernel (χ : Set)
  requires hecke : χ ∈ heckeChars(E, Φ)
  shows OpenKernelCharacter(E, heckeFinPart(Φ, χ, E))
proof
  sorry

-- divStar lands in U(1)(𝔸) and is a continuous homomorphism (coe_divStar).
theorem divStar.unitary (x y : Set)
  requires first : x ∈ cmIdeles(E, Φ)
  requires second : y ∈ cmIdeles(E, Φ)
  shows divStar(E, Φ, x) ∈ unitaryAdeles(E, Φ) ∧
    divStar(E, Φ, cmAdeleMul(E, Φ, x, y)) =
      cmAdeleMul(E, Φ, divStar(E, Φ, x), divStar(E, Φ, y))
proof
  sorry

theorem divStar.continuous
  shows divStarMap(E, Φ) : cmIdeleSpace(E, Φ) ⇒ unitaryAdeleSpace(E, Φ)
proof
  sorry

-- AutChar.baseChange: μ(x/x̄) is a unitary Hecke character, and base
-- change is a homomorphism.
theorem autCharBaseChange.hecke (μ : Set)
  requires character : μ ∈ autChars(E, Φ)
  shows autCharBaseChange(E, Φ, μ) ∈ heckeChars(E, Φ)
proof
  sorry

theorem autCharBaseChange.mul (μ ν : Set)
  requires first : μ ∈ autChars(E, Φ)
  requires second : ν ∈ autChars(E, Φ)
  shows autCharBaseChange(E, Φ, autCharMul(E, Φ, μ, ν)) =
    heckeCharMul(E, Φ, autCharBaseChange(E, Φ, μ), autCharBaseChange(E, Φ, ν))
proof
  sorry

end BaseChange

-- Section: Levels of U(1)
section Levels
variable (E Φ : Set)
hypothesis cmType : CMType(E, Φ)

theorem unitaryAdeleGroup.group
  shows AbelianGroup(unitaryAdeleGroup(E, Φ)) ∧
    TopologicalGroup(unitaryAdeleGroup(E, Φ), unitaryAdeleSpace(E, Φ))
proof
  sorry

-- rationalU1 and integralU1 S are subgroups; isOpen_integralU1.
theorem rationalU1.subgroup
  shows Subgroup(rationalU1(E, Φ), unitaryAdeleGroup(E, Φ))
proof
  sorry

theorem integralU1.open_subgroup (S : Set)
  requires places : S ⊆ finPlaces(E)
  requires finite : Finite(S)
  shows Subgroup(integralU1(E, Φ, S), unitaryAdeleGroup(E, Φ)) ∧
    integralU1(E, Φ, S) ∈ TopologicalSpace.opens(unitaryAdeleSpace(E, Φ))
proof
  sorry

-- mem_integralU1_of_snd_eq_one.
theorem integralU1.of_finite_one (S u : Set)
  requires unitary : u ∈ unitaryAdeles(E, Φ)
  requires one : snd(u) = finOne(E)
  shows u ∈ integralU1(E, Φ, S)
proof
  sorry

-- exists_divStar (Hilbert 90 for finite ideles): every finite part of a
-- norm-one adele is y/ȳ for a finite idele y.
theorem unitaryAdeles.hilbert_ninety (u : Set)
  requires unitary : u ∈ unitaryAdeles(E, Φ)
  shows ∃ y ∈ finIdeleUnits(E),
    snd(u) = finMul(E, y, finInv(E, finStar(E)(y)))
proof
  sorry

-- reduceU1 w is a homomorphism from the integral points to 𝔽_wˣ.
theorem reduceU1.hom (w u v : Set)
  requires place : w ∈ finPlaces(E)
  requires first : u ∈ integralU1(E, Φ, ∅)
  requires second : v ∈ integralU1(E, Φ, ∅)
  shows reduceU1(E, w, u) ∈ ringUnits(resField(E, w)) ∧
    reduceU1(E, w, cmAdeleMul(E, Φ, u, v)) =
      call2(Ring.mul(resField(E, w)), reduceU1(E, w, u), reduceU1(E, w, v))
proof
  sorry

-- finite_u1_classGroup: the class group of U(1) of tame level S is finite.
theorem u1ClassGroup.finite (S : Set)
  requires places : S ⊆ finPlaces(E)
  requires finite : Finite(S)
  shows Finite(u1ClassGroup(E, Φ, S))
proof
  sorry

end Levels

-- Section: Weights and tame parts
section Weights
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)
variable (E Φ : Set)
hypothesis cmType : CMType(E, Φ)

-- pow_torsionOrder_eq_one (Kronecker): an algebraic integer γ with γγ̄ = 1
-- satisfies γ^n = 1, n the number of roots of unity of E.
theorem unitaryElements.pow_torsionOrder (γ : Set)
  requires unitary : γ ∈ unitaryElements(E)
  requires integral : γ ∈ ringOfIntegers(E)
  shows Ring.pow(E, γ, torsionOrder(E)) = Ring.one(E)
proof
  sorry

-- HasWeight.one, HasWeight.mul, HasWeight.inv, HasWeight.zpow (natural
-- powers).
theorem HasWeight.trivial
  shows HasWeight(E, Φ, trivialAutChar(E, Φ), zeroWeight(Φ), trivialResidueFamily(E))
proof
  sorry

theorem HasWeight.mul (μ ν e f ψ φ : Set)
  requires first : HasWeight(E, Φ, μ, e, ψ)
  requires second : HasWeight(E, Φ, ν, f, φ)
  shows HasWeight(E, Φ, autCharMul(E, Φ, μ, ν), weightSum(Φ, e, f), residueFamilyMul(E, ψ, φ))
proof
  sorry

theorem HasWeight.inv (μ e ψ : Set)
  requires weight : HasWeight(E, Φ, μ, e, ψ)
  shows HasWeight(E, Φ, autCharInv(E, Φ, μ), weightNeg(Φ, e), residueFamilyInv(E, ψ))
proof
  sorry

theorem HasWeight.pow (μ e ψ : Set, n : Nat)
  requires weight : HasWeight(E, Φ, μ, e, ψ)
  shows HasWeight(E, Φ, autCharPow(E, Φ, μ, n), typeScale(Φ, e, n), residueFamilyPow(E, ψ, n))
proof
  sorry

-- exists_hasWeight: a homomorphism χ : U(1)(𝔸) → ℂ trivial on rational
-- points and given by the weight and tame formula on integral points (ψ
-- trivial off a finite set) is a character of weight e and tame part ψ.
theorem HasWeight.of_formula (χ e ψ S : Set)
  requires function : FunctionBetween(χ, unitaryAdeles(E, Φ), complexCarrier)
  requires hom : ∀ u ∈ unitaryAdeles(E, Φ), ∀ v ∈ unitaryAdeles(E, Φ),
    χ(cmAdeleMul(E, Φ, u, v)) = ℂ[χ(u) * χ(v)]
  requires rational : ∀ u ∈ rationalU1(E, Φ), χ(u) = complexOne
  requires weight : FunctionBetween(e, Φ, ℤ)
  requires family : ψ ∈ residueFamilies(E)
  requires finite : Finite(S)
  requires tame : ∀ w ∈ finPlaces(E), w ∉ S → ψ(w) = trivialResidueChar(E, w)
  requires formula : ∀ u ∈ unitaryAdeles(E, Φ), snd(u) ∈ finInt(E) →
    χ(u) = ℂ[charProduct(Φ, weightFactors(Φ, e, u)) *
      charProduct(ramifiedPlaces(E, ψ), tameFactors(E, ψ, u))]
  shows HasWeight(E, Φ, χ, e, ψ)
proof
  sorry

-- exists_hasWeight_of_prod_eq_one: if ∏_τ τ(u)^{e(τ)} ∏_{w∈S} ψ_w(u mod w) = 1
-- for every integer u of E with uū = 1, some character of U(1)(𝔸) has
-- weight e and tame part ψ.
theorem HasWeight.exists_of_units (e ψ S : Set)
  requires weight : FunctionBetween(e, Φ, ℤ)
  requires family : ψ ∈ residueFamilies(E)
  requires places : S ⊆ finPlaces(E)
  requires finite : Finite(S)
  requires tame : ∀ w ∈ finPlaces(E), w ∉ S → ψ(w) = trivialResidueChar(E, w)
  requires units : ∀ γ ∈ unitaryElements(E), γ ∈ ringOfIntegers(E) →
    ℂ[charProduct(Φ, embeddingWeightFactors(Φ, e, γ)) *
      charProduct(S, tameFactorsOn(E, Φ, ψ, S, γ))] = complexOne
  shows ∃ μ, HasWeight(E, Φ, μ, e, ψ)
proof
  sorry

-- exists_mem_tameChars: every complex character of the class group of
-- U(1) of tame level S, pulled back to U(1)(𝔸), has weight 0 and tame part
-- trivial off S; finite_tameChars.
theorem tameChars.of_class_character (S χ : Set)
  requires places : S ⊆ finPlaces(E)
  requires finite : Finite(S)
  requires function : FunctionBetween(χ, unitaryAdeles(E, Φ), complexCarrier)
  requires hom : ∀ u ∈ unitaryAdeles(E, Φ), ∀ v ∈ unitaryAdeles(E, Φ),
    χ(cmAdeleMul(E, Φ, u, v)) = ℂ[χ(u) * χ(v)]
  requires level : ∀ u ∈ u1LevelSubgroup(E, Φ, S), χ(u) = complexOne
  shows ∃ p ∈ tameChars(E, Φ, S), fst(p) = χ
proof
  sorry

theorem tameChars.finite (S : Set)
  requires places : S ⊆ finPlaces(E)
  requires finite : Finite(S)
  shows Finite(tameChars(E, Φ, S))
proof
  sorry

-- HasWeight.exists_pow_eq_prod: for u ∈ U(1)(𝔸) with u_∞ = 1 there are
-- n > 0 and γ ∈ E with γγ̄ = 1, uⁿγ a unit at every finite place, and
-- μ(u)ⁿ = ∏_τ τ(γ)^{e(τ)}.
theorem HasWeight.exists_pow_eq_prod (μ e ψ u : Set)
  requires weight : HasWeight(E, Φ, μ, e, ψ)
  requires point : u ∈ finiteUnitaryAdeles(E, Φ)
  shows ∃ n ∈ ℕ, 0 < n ∧ ∃ γ ∈ unitaryElements(E),
    (∀ w ∈ finPlaces(E), finMul(E, Ring.pow(finiteAdeleRing(E), snd(u), n),
      finOf(E, γ))(w) ∈ completionUnitsIn(E, w)) ∧
    ℂ[μ(u) ^ n] = charProduct(Φ, embeddingWeightFactors(Φ, e, γ))
proof
  sorry

-- AutChar.HasWeight.norm_padic_eq_prod: for ι : ℂ → ℂ_p and u with u_∞ = 1,
-- |ι μ(u)| = ∏_τ |u_τ|^{−e(τ)}, u_τ the component at the place of ι∘τ.
theorem HasWeight.padic_abs (μ e ψ ι u : Set, p : Nat)
  requires weight : HasWeight(E, Φ, μ, e, ψ)
  requires prime : Prime(p)
  requires place : ι ∈ padicPlaces(p)
  requires point : u ∈ finiteUnitaryAdeles(E, Φ)
  shows padicPlaceNorm(p, ι, μ(u)) =
    finiteRingProduct(Φ, ℝ, realAdd, realZero, realNeg, realMul, realOne,
      padicWeightFactors(E, Φ, p, ι, e, u))
proof
  sorry

-- AutChar.HasWeight.norm_map_eq_one: for u_∞ = 1, |σ(μ(u))| = 1 for every
-- ring endomorphism σ of ℂ.
theorem HasWeight.abs_conj_eq_one (μ e ψ u σ : Set)
  requires weight : HasWeight(E, Φ, μ, e, ψ)
  requires point : u ∈ finiteUnitaryAdeles(E, Φ)
  requires hom : RingHom(σ, complexRing, complexRing)
  shows complexAbs(σ(μ(u))) = realOne
proof
  sorry

-- AutChar.HasWeight.exists_conj: if σ ∈ Aut ℂ permutes the CM type,
-- σ ∘ τ = p(τ), then some ν has weight e ∘ p⁻¹, tame part σ ∘ ψ, and
-- ν(u) = σ(μ(u)) whenever u_∞ = 1.
theorem HasWeight.exists_conj (μ e ψ σ p : Set)
  requires weight : HasWeight(E, Φ, μ, e, ψ)
  requires automorphism : RingIso(σ, complexRing, complexRing)
  requires permutation : BijectiveBetween(p, Φ, Φ)
  requires permutes : ∀ τ ∈ Φ, ∀ x ∈ Ring.carrier(E), σ(τ(x)) = p(τ)(x)
  shows ∃ ν, HasWeight(E, Φ, ν, weightTransport(Φ, e, p), residueFamilyAfter(E, σ, ψ)) ∧
    (∀ u ∈ finiteUnitaryAdeles(E, Φ), ν(u) = σ(μ(u)))
proof
  sorry

end Weights
