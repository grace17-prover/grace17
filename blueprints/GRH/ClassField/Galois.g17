-- Profinite Galois groups acting on a field Ω and the local data of class
-- field theory: the fixed algebraic closure Ω of ℚ, groups Γ acting on
-- Ω as Galois groups with open stabilisers (IsProGalois), the places of
-- Ω (valuation subrings), decomposition and inertia groups, Frobenius
-- elements, places over a prime of a number field, the ℓ-adic and the
-- modular cyclotomic characters; continuous cochains of a discrete
-- Γ-module, Z¹, Z², B², H² and their functoriality; ℚ/ℤ, its continuous
-- characters and the cyclic class δχ ∪ w; the topological
-- abelianisation; uniformisers, the normalised order, the class of an
-- invariant, the local invariant property IsLocalArtin and the local
-- Artin map of a place; infinite Galois theory for such Γ.
-- Source: grh-compact/src/Lib/ClassField/Places/GaloisDefs.lean (Ω,
-- ClosurePlace, IsComplexConj, DiscreteUnits, IsProGalois, decompGroup,
-- valuationVia, valRingBelow, IsLocalGalois, unitsRep, IsFrob,
-- IsPlaceOver, inertiaGroup, cycChar, cycCharIn and their lemmas),
-- Places/ProfiniteGalois.lean (Ω.fieldEmb, the IsProGalois instances,
-- isClosed_setOf_smul, continuous_of_equivariant_emb,
-- toAlgAut_surjective, DiscreteUnits.ofBase_bijective,
-- exists_smul_emb_eq, exists_galois_restrict,
-- isClosedEmbedding_galois_restrict, isOpenEmbedding_galois_restrict,
-- fixedFieldOf_fixingSubgroup, eq_fixingSubgroup_of_isProGalois,
-- fixingSubgroup_fixedFieldOf, finrank_fixedFieldOf,
-- finiteDimensional_fixedFieldOf),
-- GaloisCohomology/ContinuousCocycles.lean (Z1, d0, Z2, B2, H2,
-- pairMapZ1, pairMapH2), GaloisCohomology/CyclicClass.lean (QZ, QZ.mk,
-- QZ.fracRep, QZ.carry, QZChar, cyclicClass and the QZ lemmas),
-- Places/LocalDefs.lean (IsUniformiser, fixedFieldOf, cycCharMod,
-- QZChar.toHom, QZChar.ker, QZChar.abelianLift, DiscreteUnits.ofBase,
-- residueCard, ordRat, IsClassOfInv, classOfInv, IsLocalArtin,
-- localArtin, placeOver).
-- Encoding. Ω is a parameter: a ℚ-algebra Q with IsQbar(Q), an
-- algebraic closure of ℚ (Ω is countable; any one serves). A number
-- field K over Ω is a Cumulus algebra E = (K, Ω, ι) (the source's
-- [Algebra K Ω], and Ω.fieldEmb is the parameter ι). A group Γ acting on
-- Ω is a group G, a topology X on its carrier, and ρ with ρ(g) the ring
-- automorphism x ↦ g • x of Ω. A place of Ω is a valuation subring A;
-- "A.valuation x < 1" is x ∈ valuationSubringNonunits(Ω, A) and
-- "≤ 1" is x ∈ A. Representations are ℤ-linear only (all the source's
-- uses here): a discrete Γ-module is an abelian group record M (its group
-- law written multiplicatively, as Ωˣ) with an action act; continuity of
-- a cochain is continuity into the discrete space on M. H² is the
-- quotient group of continuous 2-cocycles by the coboundaries.
-- ℚ/ℤ is the quotient of (ℚ, +) by the integers. The topological
-- abelianisation Γ^ab is Γ modulo the closure of its commutator subgroup;
-- a class of Γ^ab is a coset, and χ(c) for a character χ is the common
-- value χ(g), g ∈ c. The source's choices are removed: ordRat,
-- classOfInv and localArtin are "the unique" object with their defining
-- property (⋃ of the set of solutions), with existence and uniqueness
-- stated as theorems for the local case where the source uses them;
-- placeOver v (a chosen place of Ω over v) is not defined: statements
-- quantify over every A with IsPlaceOver(E, A, v). The R-linear
-- representations charRep and actionRep are not stated.
-- Part of the GRH blueprint (layer 4, Lib/ClassField, stage S1).
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.ClassField.Galois
import GRH.ClassField.HeckeL
import Grace.Cumulus.Algebra.Group.Action
import Grace.Cumulus.Algebra.Group.Restricted

section GaloisDefs

-- Section: Ω and groups acting on it
-- GaloisDefs.lean, Ω: a fixed algebraic closure of ℚ, here any ℚ-algebra
-- Q whose ring is an algebraic closure of ℚ.
predicate IsQbar (Q : Set) :=
  IsAlgebraicClosure(Q) ∧ Algebra.base(Q) = rationalRing

-- ClosurePlace: the valuation subrings of Ω.
def closurePlaces (W : Set) : Set :=
  { A ∈ 𝒫(Ring.carrier(W)) | ValuationSubring(W, A) }

-- A group G acting on the field W by ring automorphisms
-- (MulSemiringAction Γ Ω): ρ(g) is x ↦ g • x.
predicate FieldAction (G ρ W : Set) :=
  Group(G) ∧ Field(W) ∧ FunctionBetween(ρ, Group.carrier(G), ringAutomorphisms(W)) ∧
  ρ(Group.one(G)) = identity(Ring.carrier(W)) ∧
  (∀ g ∈ Group.carrier(G), ∀ h ∈ Group.carrier(G), ∀ x ∈ Ring.carrier(W),
    ρ(Group.mul(G)(g, h))(x) = ρ(g)(ρ(h)(x)))

-- GaloisDefs.lean, IsComplexConj: for some embedding j : Ω → ℂ,
-- j(cx) is the complex conjugate of j(x).
predicate IsComplexConj (G ρ W c : Set) :=
  c ∈ Group.carrier(G) ∧ (∃ j, RingHom(j, W, complexRing) ∧
    (∀ x ∈ Ring.carrier(W), j(ρ(c)(x)) = complexConj(j(x))))

-- The stabiliser of x ∈ Ω.
def actionStabilizer (G ρ x : Set) : Set :=
  { g ∈ Group.carrier(G) | ρ(g)(x) = x }

-- GaloisDefs.lean, IsProGalois Γ K Ω: Γ acts on Ω/K as a Galois group
-- (IsGaloisGroup: faithfully, K-linearly, with invariants K), Ω/K is
-- Galois, Γ is a compact totally disconnected topological group, and
-- every stabiliser is open.
predicate IsProGalois (G X ρ E : Set) :=
  IsGaloisGroup(G, ρ, E) ∧ GaloisExtension(E) ∧ TopologicalGroup(G, X) ∧
  Compact(X) ∧ TotallyDisconnected(X) ∧
  (∀ x ∈ algebraCarrier(E), actionStabilizer(G, ρ, x) ∈ TopologicalSpace.opens(X))

-- Section: Places of Ω
-- g • A, the image of a place under g, and the pullback of a place of Ω′
-- along j : Ω → Ω′ (ValuationSubring.comap).
def placeTranslate (G ρ W g A : Set) : Set := functionImage(ρ(g), A, Ring.carrier(W))

def valSubringComap (W j A : Set) : Set := { x ∈ Ring.carrier(W) | j(x) ∈ A }

-- GaloisDefs.lean, decompGroup Γ A: the g with g • A = A.
def decompGroup (G ρ W A : Set) : Set :=
  { g ∈ Group.carrier(G) | functionImage(ρ(g), A, Ring.carrier(W)) = A }

-- GaloisDefs.lean, valRingBelow K A: the valuation ring A ∩ K of K, its
-- maximal ideal, and the residue relation; residueCard K A, the number
-- of residues (a cardinal; the source's Nat.card is 0 when infinite).
def valRingBelow (E A : Set) : Set :=
  { x ∈ Ring.carrier(Algebra.base(E)) | Algebra.map(E)(x) ∈ A }

def valIdealBelow (E A : Set) : Set :=
  { x ∈ Ring.carrier(Algebra.base(E)) |
    Algebra.map(E)(x) ∈ valuationSubringNonunits(Algebra.ring(E), A) }

def residueRelation (E A : Set) : Set :=
  { p ∈ valRingBelow(E, A) × valRingBelow(E, A) |
    Ring.sub(Algebra.base(E), fst(p), snd(p)) ∈ valIdealBelow(E, A) }

def residueCard (E A : Set) : Set :=
  cardinality(valRingBelow(E, A) ⧸ residueRelation(E, A))

-- GaloisDefs.lean, IsLocalGalois Γ K Ω A: Γ = Gal(Ω/K), Ω algebraically
-- closed of characteristic 0, Γ stabilises A, and A ∩ K is a discrete
-- valuation ring with finite residue field.
predicate IsLocalGalois (G X ρ E A : Set) :=
  IsProGalois(G, X, ρ, E) ∧ AlgebraicallyClosed(Algebra.ring(E)) ∧
  CharP(Algebra.ring(E), 0) ∧ ValuationSubring(Algebra.ring(E), A) ∧
  decompGroup(G, ρ, Algebra.ring(E), A) = Group.carrier(G) ∧
  DiscreteValuationRing(subringRing(Algebra.base(E), valRingBelow(E, A))) ∧
  Finite(valRingBelow(E, A) ⧸ residueRelation(E, A))

-- GaloisDefs.lean, unitsRep: Γ acting on Ωˣ.
def unitsAction (G ρ W : Set) : Set :=
  { (p, ρ(fst(p))(snd(p))) | p ∈ Group.carrier(G) × ringUnits(W) }

-- GaloisDefs.lean, IsFrob A q σ: σ stabilises A and σx ≡ x^q modulo the
-- maximal ideal of A for every x ∈ A.
predicate IsFrob (G ρ W A q σ : Set) :=
  σ ∈ decompGroup(G, ρ, W, A) ∧
  (∀ x ∈ A, Ring.sub(W, ρ(σ)(x), Ring.pow(W, x, q)) ∈ valuationSubringNonunits(W, A))

-- GaloisDefs.lean, IsPlaceOver A v: an integer of K lies in the maximal
-- ideal of A exactly when it lies in v.
predicate IsPlaceOver (E A v : Set) :=
  ValuationSubring(Algebra.ring(E), A) ∧
  (∀ x ∈ ringOfIntegers(Algebra.base(E)),
    Algebra.map(E)(x) ∈ valuationSubringNonunits(Algebra.ring(E), A) ↔ x ∈ v)

-- GaloisDefs.lean, inertiaGroup Γ A: the Frobenius elements for q = 1.
def inertiaGroup (G ρ W A : Set) : Set :=
  { σ ∈ Group.carrier(G) | IsFrob(G, ρ, W, A, 1, σ) }

-- Section: Cyclotomic characters
-- The ℓ-adic cyclotomic character (Mathlib's cyclotomicCharacter): when
-- W has ℓⁿ ℓⁿ-th roots of unity for every n, a ring automorphism σ acts
-- on them as ζ ↦ ζ^u for a unique u ∈ ℤ_ℓˣ (u read modulo ℓⁿ).
defunique cycCharValue (W : Set, l : Nat, σ : Set) (u ∈ ringUnits(padicIntRing(l))) :=
  ∀ n ∈ ℕ, ∀ ζ ∈ rootsOfUnity(W, pow(l, n)),
    σ(ζ) = Ring.pow(W, ζ, zmodVal(pow(l, n), padicToZModPow(l, n)(u)))
requires field : Field(W)
requires prime : Prime(l)
requires roots : ∀ n ∈ ℕ, HasCardinality(rootsOfUnity(W, pow(l, n)), pow(l, n))
requires automorphism : σ ∈ ringAutomorphisms(W)
proof
  sorry
uniqueness
  sorry

-- GaloisDefs.lean, cycChar: Γ → ℤ_ℓˣ, and cycCharIn: its composite with
-- the structure map ℤ_ℓ → O of a ℤ_ℓ-algebra O (given as the algebra P).
def cycChar (G ρ W : Set, l : Nat) : Set :=
  { (g, cycCharValue(W, l, ρ(g))) | g ∈ Group.carrier(G) }

def cycCharIn (G ρ W : Set, l : Nat, P : Set) : Set :=
  { (g, Algebra.map(P)(cycCharValue(W, l, ρ(g)))) | g ∈ Group.carrier(G) }

-- LocalDefs.lean, cycCharMod N: Γ → (ℤ/N)ˣ, the action on the N-th roots
-- of unity.
def cycCharMod (G ρ W : Set, N : Nat) : Set :=
  { (g, modularCyclotomicCharacter(W, N)(ρ(g))) | g ∈ Group.carrier(G) }

-- Section: Continuous cochains
-- A discrete Γ-module: an abelian group M (written multiplicatively) with
-- an action of G by group automorphisms.
predicate DiscreteGModule (G X M act : Set) :=
  TopologicalGroup(G, X) ∧ AbelianGroup(M) ∧ Action(act, G, Group.carrier(M)) ∧
  (∀ g ∈ Group.carrier(G), ∀ m ∈ Group.carrier(M), ∀ n ∈ Group.carrier(M),
    act(g, Group.mul(M)(m, n)) = Group.mul(M)(act(g, m), act(g, n)))

-- ContinuousCocycles.lean, Z1: continuous f : G → M with
-- f(gh) = f(g) + g·f(h).
def Z1 (G X M act : Set) : Set :=
  { f ∈ functionSpace(Group.carrier(G), Group.carrier(M)) |
    f : X ⇒ discreteSpace(Group.carrier(M)) ∧
    (∀ g ∈ Group.carrier(G), ∀ h ∈ Group.carrier(G),
      f(Group.mul(G)(g, h)) = Group.mul(M)(f(g), act(g, f(h)))) }

-- ContinuousCocycles.lean, d0: m ↦ (g ↦ g·m − m).
def d0 (G M act m : Set) : Set :=
  { (g, Group.mul(M)(act(g, m), Group.inv(M)(m))) | g ∈ Group.carrier(G) }

-- ContinuousCocycles.lean, Z2: continuous f : G × G → M with
-- f(gh, k) = f(g, hk) − f(g, h) + g·f(h, k).
def Z2 (G X M act : Set) : Set :=
  { f ∈ functionSpace(Group.carrier(G) × Group.carrier(G), Group.carrier(M)) |
    f : productSpace(X, X) ⇒ discreteSpace(Group.carrier(M)) ∧
    (∀ g ∈ Group.carrier(G), ∀ h ∈ Group.carrier(G), ∀ k ∈ Group.carrier(G),
      f(Group.mul(G)(g, h), k) =
        Group.mul(M)(Group.mul(M)(f(g, Group.mul(G)(h, k)), Group.inv(M)(f(g, h))),
          act(g, f(h, k)))) }

-- The continuous 1-cochains G → M.
def continuousCochains1 (G X M : Set) : Set :=
  { c ∈ functionSpace(Group.carrier(G), Group.carrier(M)) |
    c : X ⇒ discreteSpace(Group.carrier(M)) }

-- ContinuousCocycles.lean, B2: (g, h) ↦ g·c(h) − c(gh) + c(g) for a
-- continuous c : G → M.
def B2 (G X M act : Set) : Set :=
  { f ∈ functionSpace(Group.carrier(G) × Group.carrier(G), Group.carrier(M)) |
    ∃ c ∈ continuousCochains1(G, X, M), ∀ g ∈ Group.carrier(G), ∀ h ∈ Group.carrier(G),
      f(g, h) = Group.mul(M)(Group.mul(M)(act(g, c(h)), Group.inv(M)(c(Group.mul(G)(g, h)))),
        c(g)) }

-- The pointwise group law on cochains with domain D.
def cochainMul (M D f h : Set) : Set := { (q, Group.mul(M)(f(q), h(q))) | q ∈ D }

def cochainInv (M D f : Set) : Set := { (q, Group.inv(M)(f(q))) | q ∈ D }

def cochainOne (M D : Set) : Set := { (q, Group.one(M)) | q ∈ D }

def z2Mul (G X M act : Set) : Set :=
  { (p, cochainMul(M, Group.carrier(G) × Group.carrier(G), fst(p), snd(p))) |
    p ∈ Z2(G, X, M, act) × Z2(G, X, M, act) }

def z2Inv (G X M act : Set) : Set :=
  { (f, cochainInv(M, Group.carrier(G) × Group.carrier(G), f)) | f ∈ Z2(G, X, M, act) }

-- The group of continuous 2-cocycles.
def cocycle2Group (G X M act : Set) : Set :=
  Group.mk(Z2(G, X, M, act), z2Mul(G, X, M, act),
    cochainOne(M, Group.carrier(G) × Group.carrier(G)), z2Inv(G, X, M, act))

-- ContinuousCocycles.lean, H2: continuous 2-cocycles modulo coboundaries,
-- and the class of a cocycle.
def H2 (G X M act : Set) : Set := quotientGroup(cocycle2Group(G, X, M, act), B2(G, X, M, act))

def h2Class (G X M act f : Set) : Set :=
  ⟦f⟧[Z2(G, X, M, act), cosetRelation(cocycle2Group(G, X, M, act), B2(G, X, M, act))]

-- ContinuousCocycles.lean, pairMapZ1 and pairMapH2: for φ : H → G and
-- u : M → N, f ↦ u ∘ f ∘ φ on 1-cocycles, and on 2-cocycle classes.
def pullCochain1 (H φ u f : Set) : Set := { (h, u(f(φ(h)))) | h ∈ Group.carrier(H) }

def pullCochain2 (H φ u f : Set) : Set :=
  { (q, u(f(φ(fst(q)), φ(snd(q))))) | q ∈ Group.carrier(H) × Group.carrier(H) }

def pairMapZ1 (G X M act H φ u : Set) : Set :=
  { (f, pullCochain1(H, φ, u, f)) | f ∈ Z1(G, X, M, act) }

def pairMapH2 (G X M act H Y N act2 φ u : Set) : Set :=
  { (h2Class(G, X, M, act, f), h2Class(H, Y, N, act2, pullCochain2(H, φ, u, f))) |
    f ∈ Z2(G, X, M, act) }

-- Section: ℚ/ℤ and the cyclic class
-- CyclicClass.lean, QZ: ℚ/ℤ, the quotient of (ℚ, +) by the integers,
-- with the discrete topology; QZ.mk : ℚ → ℚ/ℤ.
def ratIntegers : Set := { q ∈ ℚ | ∃ a ∈ ℕ, ∃ b ∈ ℕ, q = rationalClass(a, b, 1) }

def qzGroup : Set := quotientGroup(Ring.additive(rationalRing), ratIntegers)

def qzSpace : Set := discreteSpace(Group.carrier(qzGroup))

def qzMk (q : Set) : Set := ⟦q⟧[ℚ, cosetRelation(Ring.additive(rationalRing), ratIntegers)]

def qzMkMap : Set := { (q, qzMk(q)) | q ∈ ℚ }

-- The integer z as a rational number.
def intRat (z : Set) : Set :=
  ⋃({ q ∈ ℚ | ∃ a ∈ ℕ, ∃ b ∈ ℕ,
    z = integerAdd(integerOfNat(a), integerNegValue(integerOfNat(b))) ∧
    q = rationalClass(a, b, 1) })

-- CyclicClass.lean, QZ.fracRep: the representative in [0, 1).
def qzFracRep (a : Set) : Set :=
  ⋃({ q ∈ ℚ | (q = rationalZero ∨ relates(rationalLess, rationalZero, q)) ∧
    relates(rationalLess, q, rationalOne) ∧ qzMk(q) = a })

-- CyclicClass.lean, QZ.carry: ⌊fracRep a + fracRep b⌋ ∈ {0, 1}.
def qzCarry (a b : Set) : Set :=
  ⋃({ z ∈ ℤ |
    (z = integerZero ∧ relates(rationalLess, rationalAdd((qzFracRep(a), qzFracRep(b))),
      rationalOne)) ∨
    (z = integerOne ∧ ¬relates(rationalLess, rationalAdd((qzFracRep(a), qzFracRep(b))),
      rationalOne)) })

-- CyclicClass.lean, QZChar G: the continuous characters G → ℚ/ℤ, the
-- 1-cocycles for the trivial action.
def qzTrivialAction (G : Set) : Set :=
  { (p, snd(p)) | p ∈ Group.carrier(G) × Group.carrier(qzGroup) }

def qzChars (G X : Set) : Set := Z1(G, X, qzGroup, qzTrivialAction(G))

-- CyclicClass.lean, cyclicClass χ w: the class of the cocycle
-- (g, h) ↦ carry(χ(g), χ(h)) · w, for w invariant.
def carryMultiple (M c w : Set) : Set :=
  ⋃({ m ∈ Group.carrier(M) |
    (c = integerOne ∧ m = w) ∨ (c = integerZero ∧ m = Group.one(M)) })

def cyclicCocycle (G M χ w : Set) : Set :=
  { (q, carryMultiple(M, qzCarry(χ(fst(q)), χ(snd(q))), w)) |
    q ∈ Group.carrier(G) × Group.carrier(G) }

def cyclicClass (G X M act χ w : Set) : Set := h2Class(G, X, M, act, cyclicCocycle(G, M, χ, w))

-- Section: The topological abelianisation
-- Γ^ab = Γ / closure [Γ, Γ] (TopologicalAbelianization), the class of g,
-- and the class in Γ^ab of a class of a subgroup's abelianisation.
def commutatorSet (G : Set) : Set :=
  { c ∈ Group.carrier(G) | ∃ g ∈ Group.carrier(G), ∃ h ∈ Group.carrier(G),
    c = Group.mul(G)(Group.mul(G)(g, h), Group.mul(G)(Group.inv(G)(g), Group.inv(G)(h))) }

def closedCommutator (G X : Set) : Set := closure(X, generatedSubgroup(G, commutatorSet(G)))

def topAbelianization (G X : Set) : Set := quotientGroup(G, closedCommutator(G, X))

def abelianClass (G X g : Set) : Set :=
  ⟦g⟧[Group.carrier(G), cosetRelation(G, closedCommutator(G, X))]

def abelianIncl (G X c : Set) : Set :=
  ⋃({ a ∈ Group.carrier(topAbelianization(G, X)) | ∃ g ∈ c, a = abelianClass(G, X, g) })

-- LocalDefs.lean, QZChar.abelianLift χ: the value of χ on a class of
-- Γ^ab; QZChar.ker χ, its kernel; QZChar.toHom is χ itself.
def abelianLift (G X χ c : Set) : Set :=
  ⋃({ q ∈ Group.carrier(qzGroup) | ∃ g ∈ c, q = χ(g) })

def qzCharKernel (G χ : Set) : Set :=
  { g ∈ Group.carrier(G) | χ(g) = Group.one(qzGroup) }

-- Section: Local data
-- LocalDefs.lean, IsUniformiser A π: x ∈ K has A-valuation below 1
-- exactly when its valuation is at most that of π.
predicate IsUniformiser (E A π : Set) :=
  π ∈ Ring.carrier(Algebra.base(E)) ∧
  (∀ x ∈ Ring.carrier(Algebra.base(E)),
    Algebra.map(E)(x) ∈ valuationSubringNonunits(Algebra.ring(E), A) ↔
      ValueLe(valueGroupOf(Algebra.ring(E), A),
        valuationOfSubring(Algebra.ring(E), A)(Algebra.map(E)(x)),
        valuationOfSubring(Algebra.ring(E), A)(Algebra.map(E)(π))))

-- LocalDefs.lean, fixedFieldOf H: the elements of Ω fixed by H, and Ω
-- as an extension of it.
def fixedFieldOf (G ρ E H : Set) : Set :=
  { x ∈ algebraCarrier(E) | ∀ g ∈ H, ρ(g)(x) = x }

-- The g fixing a subset F of Ω pointwise, and the g with g x ∈ P.
def fixingGroupOf (G ρ F : Set) : Set := { g ∈ Group.carrier(G) | ∀ x ∈ F, ρ(g)(x) = x }

def actionPreimage (G ρ x P : Set) : Set := { g ∈ Group.carrier(G) | ρ(g)(x) ∈ P }

def fixedFieldExtension (G ρ E H : Set) : Set := overExtension(E, fixedFieldOf(G, ρ, E, H))

-- x^e for an integer e in a group.
def groupZpow (G x e : Set) : Set :=
  ⋃({ y ∈ Group.carrier(G) | ∃ n ∈ ℕ,
    (e = integerOfNat(n) ∧ y = groupPow(G, x, n)) ∨
    (e = integerNegValue(integerOfNat(n)) ∧ y = groupPow(G, Group.inv(G)(x), n)) })

-- LocalDefs.lean, ordRat K A: the additive f : Ωˣ → ℚ with n f(x) = a
-- exactly when xⁿ and πᵃ have the same valuation, π a uniformiser of K.
predicate IsOrdRat (E A f : Set) :=
  FunctionBetween(f, ringUnits(Algebra.ring(E)), ℚ) ∧
  (∀ x ∈ ringUnits(Algebra.ring(E)), ∀ y ∈ ringUnits(Algebra.ring(E)),
    f(call2(Ring.mul(Algebra.ring(E)), x, y)) = rationalAdd((f(x), f(y)))) ∧
  (∀ π ∈ ringUnits(Algebra.base(E)), IsUniformiser(E, A, π) →
    (∀ x ∈ ringUnits(Algebra.ring(E)), ∀ n ∈ ℕ, ∀ a ∈ ℤ,
      valueClass(Algebra.ring(E), A, Ring.pow(Algebra.ring(E), x, n)) =
          valueClass(Algebra.ring(E), A, unitZpow(Algebra.ring(E), Algebra.map(E)(π), a)) ↔
        rationalMul((rationalClass(n, 0, 1), f(x))) = intRat(a)))

def ordRat (E A : Set) : Set :=
  ⋃({ f ∈ functionSpace(ringUnits(Algebra.ring(E)), ℚ) | IsOrdRat(E, A, f) })

-- H²(Γ, Ωˣ) and the cyclic class there.
def unitsH2 (G X ρ W : Set) : Set := H2(G, X, unitGroup(W), unitsAction(G, ρ, W))

def unitsCyclicClass (G X ρ W χ w : Set) : Set :=
  cyclicClass(G, X, unitGroup(W), unitsAction(G, ρ, W), χ, w)

-- The Γ-invariant units (Ωˣ)^Γ.
def invariantUnits (G ρ W : Set) : Set := fixedPoints(unitsAction(G, ρ, W), G, ringUnits(W))

-- LocalDefs.lean, IsClassOfInv b: b : ℚ/ℤ → H²(Γ, Ωˣ) is an injective
-- homomorphism and (χ, w) = n · b(χ(φ)) for χ unramified, φ a Frobenius
-- and w invariant of order n.
predicate IsClassOfInv (G X ρ E A b : Set) :=
  GroupHom(b, qzGroup, unitsH2(G, X, ρ, Algebra.ring(E))) ∧
  InjectiveBetween(b, Group.carrier(qzGroup), Group.carrier(unitsH2(G, X, ρ, Algebra.ring(E)))) ∧
  (∀ χ ∈ qzChars(G, X), (∀ g ∈ inertiaGroup(G, ρ, Algebra.ring(E), A), χ(g) = Group.one(qzGroup)) →
    (∀ φ ∈ Group.carrier(G), IsFrob(G, ρ, Algebra.ring(E), A, residueCard(E, A), φ) →
      (∀ w ∈ invariantUnits(G, ρ, Algebra.ring(E)), ∀ n ∈ ℤ, ordRat(E, A)(w) = intRat(n) →
        unitsCyclicClass(G, X, ρ, Algebra.ring(E), χ, w) =
          groupZpow(unitsH2(G, X, ρ, Algebra.ring(E)), b(χ(φ)), n))))

-- LocalDefs.lean, classOfInv: the map with IsClassOfInv (unique in the
-- local case, IsClassOfInv.exists_unique).
def classOfInv (G X ρ E A : Set) : Set :=
  ⋃({ b ∈ functionSpace(Group.carrier(qzGroup), Group.carrier(unitsH2(G, X, ρ, Algebra.ring(E)))) |
    IsClassOfInv(G, X, ρ, E, A, b) })

-- LocalDefs.lean, IsLocalArtin Γ K A f: f : Lˣ → Γ^ab, for a field L
-- under Ω fixed by Γ (the algebra F), with χ(f x) = −inv(δχ ∪ x).
predicate IsLocalArtin (G X ρ E A F f : Set) :=
  FieldExtension(F) ∧ Algebra.ring(F) = Algebra.ring(E) ∧
  (∀ g ∈ Group.carrier(G), ∀ y ∈ Ring.carrier(Algebra.base(F)),
    ρ(g)(Algebra.map(F)(y)) = Algebra.map(F)(y)) ∧
  GroupHom(f, unitGroup(Algebra.base(F)), topAbelianization(G, X)) ∧
  (∀ χ ∈ qzChars(G, X), ∀ x ∈ ringUnits(Algebra.base(F)),
    classOfInv(G, X, ρ, E, A)(abelianLift(G, X, χ, f(x))) =
      Group.inv(unitsH2(G, X, ρ, Algebra.ring(E)))(
        unitsCyclicClass(G, X, ρ, Algebra.ring(E), χ, Algebra.map(F)(x))))

-- The decomposition group D_A as a group with its topology and action,
-- and Ω over its fixed field.
def decompSubgroup (G ρ W A : Set) : Set := subgroupGroup(G, decompGroup(G, ρ, W, A))

def decompSpace (G X ρ W A : Set) : Set := subspace(X, decompGroup(G, ρ, W, A))

def decompAction (G ρ W A : Set) : Set := restrict(ρ, decompGroup(G, ρ, W, A))

def decompField (G ρ E A : Set) : Set :=
  fixedFieldExtension(G, ρ, E, decompGroup(G, ρ, Algebra.ring(E), A))

-- f restricted along K → K_v.
def localArtinOnField (E v f : Set) : Set :=
  { (x, f(adicCompletionEmbedding(Algebra.base(E), v)(x))) | x ∈ ringUnits(Algebra.base(E)) }

-- LocalDefs.lean, localArtin Γ A v: K_vˣ → D_A^ab whose restriction to Kˣ
-- has the local invariant property for the decomposition field of A.
predicate IsLocalArtinAt (G X ρ E A v f : Set) :=
  GroupHom(f, unitGroup(adicCompletionField(Algebra.base(E), v)),
    topAbelianization(decompSubgroup(G, ρ, Algebra.ring(E), A),
      decompSpace(G, X, ρ, Algebra.ring(E), A))) ∧
  IsLocalArtin(decompSubgroup(G, ρ, Algebra.ring(E), A), decompSpace(G, X, ρ, Algebra.ring(E), A),
    decompAction(G, ρ, Algebra.ring(E), A), decompField(G, ρ, E, A), A, E,
    localArtinOnField(E, v, f))

def localArtin (G X ρ E A v : Set) : Set :=
  ⋃({ f ∈ functionSpace(locUnits(Algebra.base(E), v),
      Group.carrier(topAbelianization(decompSubgroup(G, ρ, Algebra.ring(E), A),
        decompSpace(G, X, ρ, Algebra.ring(E), A)))) |
    IsLocalArtinAt(G, X, ρ, E, A, v, f) })

end GaloisDefs

-- Section: Ω
section Closure
variable (Q : Set)
hypothesis qbar : IsQbar(Q)

-- GaloisDefs.lean, Ω: Ω is algebraically closed of characteristic 0 and
-- algebraic over ℚ (deriving IsAlgClosed, CharZero; Algebra.IsAlgebraic).
theorem IsQbar.closed
  shows AlgebraicallyClosed(Algebra.ring(Q)) ∧ CharP(Algebra.ring(Q), 0) ∧
    AlgebraicExtension(Q)
proof
  sorry

-- ProfiniteGalois.lean, instance IsAlgClosure K Ω: Ω is an algebraic
-- closure of every field K of characteristic 0 mapping to it.
theorem IsQbar.alg_closure_of (E : Set)
  requires extension : FieldExtension(E)
  requires closure : Algebra.ring(E) = Algebra.ring(Q)
  requires characteristic : CharP(Algebra.base(E), 0)
  shows IsAlgebraicClosure(E)
proof
  sorry

-- ProfiniteGalois.lean, Ω.fieldEmb: every number field embeds in Ω.
theorem IsQbar.field_emb (K : Set)
  requires numberField : NumberField(K)
  shows ∃ ι, RingHom(ι, K, Algebra.ring(Q))
proof
  sorry

-- An algebraic closure of ℚ is unique up to isomorphism (the reason the
-- choice of Ω does not matter).
theorem IsQbar.unique (Q2 : Set)
  requires other : IsQbar(Q2)
  shows ∃ e, RingIso(e, Algebra.ring(Q), Algebra.ring(Q2))
proof
  sorry

end Closure

-- Section: Decomposition, Frobenius, inertia
section Frobenius
variable (G ρ W A : Set)
hypothesis action : FieldAction(G, ρ, W)
hypothesis place : ValuationSubring(W, A)

-- mem_decompGroup_iff: σ ∈ D_A iff σx ∈ A ↔ x ∈ A for all x.
theorem decompGroup.mem_iff (σ : Set)
  requires member : σ ∈ Group.carrier(G)
  shows σ ∈ decompGroup(G, ρ, W, A) ↔
    (∀ x ∈ Ring.carrier(W), ρ(σ)(x) ∈ A ↔ x ∈ A)
proof
  sorry

-- The decomposition and inertia groups are subgroups (decompGroup as
-- stabilizer; inertiaGroup), and inertia lies in decomposition.
theorem decompGroup.subgroup
  shows Subgroup(decompGroup(G, ρ, W, A), G)
proof
  sorry

theorem inertiaGroup.subgroup
  shows Subgroup(inertiaGroup(G, ρ, W, A), G) ∧
    inertiaGroup(G, ρ, W, A) ⊆ decompGroup(G, ρ, W, A)
proof
  sorry

-- g • A is a place, and conj_mem_decompGroup_smul: gσg⁻¹ ∈ D_{gA}.
theorem placeTranslate.valuation_subring (g : Set)
  requires member : g ∈ Group.carrier(G)
  shows ValuationSubring(W, placeTranslate(G, ρ, W, g, A))
proof
  sorry

theorem decompGroup.conj (g σ : Set)
  requires member : g ∈ Group.carrier(G)
  requires decomposition : σ ∈ decompGroup(G, ρ, W, A)
  shows Group.mul(G)(Group.mul(G)(g, σ), Group.inv(G)(g)) ∈
    decompGroup(G, ρ, W, placeTranslate(G, ρ, W, g, A))
proof
  sorry

-- IsFrob.conj: gσg⁻¹ is a q-Frobenius at gA.
theorem IsFrob.conj (q g σ : Set)
  requires frobenius : IsFrob(G, ρ, W, A, q, σ)
  requires member : g ∈ Group.carrier(G)
  shows IsFrob(G, ρ, W, placeTranslate(G, ρ, W, g, A), q,
    Group.mul(G)(Group.mul(G)(g, σ), Group.inv(G)(g)))
proof
  sorry

-- IsFrob.mul_iff: for σ a q-Frobenius, στ is a qq′-Frobenius iff τ is a
-- q′-Frobenius.
theorem IsFrob.mul_iff (q q2 σ τ : Set)
  requires natural : q ∈ ℕ
  requires natural2 : q2 ∈ ℕ
  requires frobenius : IsFrob(G, ρ, W, A, q, σ)
  requires member : τ ∈ Group.carrier(G)
  shows IsFrob(G, ρ, W, A, q * q2, Group.mul(G)(σ, τ)) ↔ IsFrob(G, ρ, W, A, q2, τ)
proof
  sorry

-- IsFrob.pow: σⁿ is a qⁿ-Frobenius.
theorem IsFrob.pow (q σ : Set, n : Nat)
  requires natural : q ∈ ℕ
  requires frobenius : IsFrob(G, ρ, W, A, q, σ)
  shows IsFrob(G, ρ, W, A, pow(q, n), groupPow(G, σ, n))
proof
  sorry

-- IsFrob.inv_mul: two q-Frobenius elements differ by inertia.
theorem IsFrob.inv_mul (q σ τ : Set)
  requires natural : q ∈ ℕ
  requires first : IsFrob(G, ρ, W, A, q, σ)
  requires second : IsFrob(G, ρ, W, A, q, τ)
  shows Group.mul(G)(Group.inv(G)(σ), τ) ∈ inertiaGroup(G, ρ, W, A)
proof
  sorry

-- isEquiv_comap, val_comap_lt_one: the pullback of a place along a field
-- embedding j : W → W2 is a place, with maximal ideal the pullback.
theorem valSubringComap.valuation_subring (W2 j A2 x : Set)
  requires field : Field(W2)
  requires embedding : RingHom(j, W, W2)
  requires place2 : ValuationSubring(W2, A2)
  requires member : x ∈ Ring.carrier(W)
  shows ValuationSubring(W, valSubringComap(W, j, A2)) ∧
    (x ∈ valuationSubringNonunits(W, valSubringComap(W, j, A2)) ↔
      j(x) ∈ valuationSubringNonunits(W2, A2))
proof
  sorry

-- cycChar and cycCharMod are homomorphisms Γ → ℤ_ℓˣ, Γ → (ℤ/N)ˣ (when
-- the roots of unity are there).
theorem cycChar.hom (l : Nat)
  requires prime : Prime(l)
  requires roots : ∀ n ∈ ℕ, HasCardinality(rootsOfUnity(W, pow(l, n)), pow(l, n))
  shows GroupHom(cycChar(G, ρ, W, l), G, unitGroup(padicIntRing(l)))
proof
  sorry

theorem cycCharMod.hom (N : Nat)
  requires positive : 0 < N
  requires roots : HasCardinality(rootsOfUnity(W, N), N)
  shows GroupHom(cycCharMod(G, ρ, W, N), G, unitGroup(zmod(N)))
proof
  sorry

end Frobenius

-- Section: Functoriality of decomposition and Frobenius
section Equivariant
variable (G ρ W H σ2 W2 φ j : Set)
hypothesis action : FieldAction(G, ρ, W)
hypothesis action2 : FieldAction(H, σ2, W2)
hypothesis map : FunctionBetween(φ, Group.carrier(H), Group.carrier(G))
hypothesis embedding : RingHom(j, W, W2)
hypothesis equivariant : ∀ g ∈ Group.carrier(H), ∀ x ∈ Ring.carrier(W),
  j(ρ(φ(g))(x)) = σ2(g)(j(x))

-- decompGroup.map, IsFrob.map: along j with j(φ(g)x) = g·j(x),
-- s ∈ D_{A′} gives φ(s) ∈ D_{j⁻¹A′}, and Frobenius elements map to
-- Frobenius elements.
theorem decompGroup.map (A2 s : Set)
  requires place2 : ValuationSubring(W2, A2)
  requires decomposition : s ∈ decompGroup(H, σ2, W2, A2)
  shows φ(s) ∈ decompGroup(G, ρ, W, valSubringComap(W, j, A2))
proof
  sorry

theorem IsFrob.map (A2 q s : Set)
  requires place2 : ValuationSubring(W2, A2)
  requires frobenius : IsFrob(H, σ2, W2, A2, q, s)
  shows IsFrob(G, ρ, W, valSubringComap(W, j, A2), q, φ(s))
proof
  sorry

end Equivariant

-- Section: Profinite Galois groups
section ProfiniteGalois
variable (G X ρ E : Set)
hypothesis galois : IsProGalois(G, X, ρ, E)

-- instance IsProGalois Gal(Ω/K) K Ω: the Galois group with the Krull
-- topology, acting through the identity.
theorem IsProGalois.of_galois_extension
  shows IsProGalois(galoisGroup(E), krullTopology(E), identity(algebraAutomorphisms(E)), E)
proof
  sorry

-- The action is by field automorphisms, and Γ is profinite.
theorem IsProGalois.field_action
  shows FieldAction(G, ρ, Algebra.ring(E)) ∧ ProfiniteGroup(G, X)
proof
  sorry

-- A closed subgroup H is the Galois group of Ω over its fixed field
-- (instance IsProGalois H (fixedFieldOf H) Ω).
theorem IsProGalois.closed_subgroup (H : Set)
  requires closed : ClosedSubgroup(H, G, X)
  shows IsProGalois(subgroupGroup(G, H), subspace(X, H), restrict(ρ, H),
    fixedFieldExtension(G, ρ, E, H))
proof
  sorry

-- isClosed_setOf_smul: {g | P(g x)} is closed (here: for any set P).
theorem IsProGalois.closed_preimage (x P : Set)
  requires member : x ∈ algebraCarrier(E)
  shows Closed(X, actionPreimage(G, ρ, x, P))
proof
  sorry

-- toAlgAut_surjective: every K-automorphism of Ω comes from Γ.
theorem IsProGalois.surjective
  shows functionImage(ρ, Group.carrier(G), algebraAutomorphisms(E)) = algebraAutomorphisms(E)
proof
  sorry

-- DiscreteUnits.ofBase_bijective: Kˣ → (Ωˣ)^Γ is a bijection.
theorem IsProGalois.invariant_units
  shows functionImage(Algebra.map(E), ringUnits(Algebra.base(E)), algebraCarrier(E)) =
    invariantUnits(G, ρ, Algebra.ring(E)) ∧
    InjectiveBetween(Algebra.map(E), Ring.carrier(Algebra.base(E)), algebraCarrier(E))
proof
  sorry

-- exists_smul_emb_eq: two embeddings j, j′ : Ω → Ω′ agreeing on K differ
-- by an element of Γ.
theorem IsProGalois.exists_smul_emb_eq (W2 j j2 : Set)
  requires field : Field(W2)
  requires first : RingHom(j, Algebra.ring(E), W2)
  requires second : RingHom(j2, Algebra.ring(E), W2)
  requires agree : ∀ y ∈ Ring.carrier(Algebra.base(E)), j(Algebra.map(E)(y)) = j2(Algebra.map(E)(y))
  shows ∃ g ∈ Group.carrier(G), ∀ x ∈ algebraCarrier(E), j(ρ(g)(x)) = j2(x)
proof
  sorry

-- continuous_of_equivariant_emb: for Γ′ = Gal(Ω′/L), every φ : Γ′ → Γ
-- with j(φ(g)x) = g·j(x) is continuous.
theorem IsProGalois.continuous_of_equivariant (H Y σ2 F j φ : Set)
  requires galois2 : IsProGalois(H, Y, σ2, F)
  requires embedding : RingHom(j, Algebra.ring(E), Algebra.ring(F))
  requires map : FunctionBetween(φ, Group.carrier(H), Group.carrier(G))
  requires equivariant : ∀ g ∈ Group.carrier(H), ∀ x ∈ algebraCarrier(E),
    j(ρ(φ(g))(x)) = σ2(g)(j(x))
  shows φ : Y ⇒ X
proof
  sorry

-- exists_galois_restrict: when Γ′ fixes j(K) pointwise, there is a
-- continuous homomorphism φ : Γ′ → Γ with j(φ(g)x) = g·j(x).
theorem IsProGalois.exists_restrict (H Y σ2 F j : Set)
  requires galois2 : IsProGalois(H, Y, σ2, F)
  requires embedding : RingHom(j, Algebra.ring(E), Algebra.ring(F))
  requires fixes : ∀ g ∈ Group.carrier(H), ∀ y ∈ Ring.carrier(Algebra.base(E)),
    σ2(g)(j(Algebra.map(E)(y))) = j(Algebra.map(E)(y))
  shows ∃ φ, GroupHom(φ, H, G) ∧ φ : Y ⇒ X ∧
    (∀ g ∈ Group.carrier(H), ∀ x ∈ algebraCarrier(E), j(ρ(φ(g))(x)) = σ2(g)(j(x)))
proof
  sorry

-- isClosedEmbedding_galois_restrict, isOpenEmbedding_galois_restrict,
-- eq_fixingSubgroup_of_isProGalois: for K ⊆ L ⊆ Ω (L an intermediate
-- field F) and Γ′ acting as Gal(Ω/L), a compatible φ : Γ′ → Γ is a closed
-- embedding onto the fixing group of L, of index [L : K]; open when L/K
-- is finite.
theorem IsProGalois.restrict_embedding (H Y σ2 F φ : Set)
  requires intermediate : IntermediateField(E, F)
  requires galois2 : IsProGalois(H, Y, σ2, overExtension(E, F))
  requires hom : GroupHom(φ, H, G)
  requires compatible : ∀ g ∈ Group.carrier(H), ∀ x ∈ algebraCarrier(E), ρ(φ(g))(x) = σ2(g)(x)
  shows InjectiveBetween(φ, Group.carrier(H), Group.carrier(G)) ∧ φ : Y ⇒ X ∧
    Closed(X, functionImage(φ, Group.carrier(H), Group.carrier(G))) ∧
    functionImage(φ, Group.carrier(H), Group.carrier(G)) =
      fixingGroupOf(G, ρ, F) ∧
    (FiniteExtension(subextension(E, F)) →
      functionImage(φ, Group.carrier(H), Group.carrier(G)) ∈ TopologicalSpace.opens(X) ∧
      index(G, functionImage(φ, Group.carrier(H), Group.carrier(G))) =
        extensionDegree(subextension(E, F)))
proof
  sorry

-- fixedFieldOf_fixingSubgroup and fixingSubgroup_fixedFieldOf: the
-- Galois correspondence for Γ.
theorem IsProGalois.fixedField_fixing (F : Set)
  requires intermediate : IntermediateField(E, F)
  shows fixedFieldOf(G, ρ, E, fixingGroupOf(G, ρ, F)) = F
proof
  sorry

theorem IsProGalois.fixing_fixedField (H : Set)
  requires closed : ClosedSubgroup(H, G, X)
  shows fixingGroupOf(G, ρ, fixedFieldOf(G, ρ, E, H)) = H ∧
    IntermediateField(E, fixedFieldOf(G, ρ, E, H))
proof
  sorry

-- finrank_fixedFieldOf, finiteDimensional_fixedFieldOf, and the
-- NumberField instance: an open subgroup U has fixed field of degree
-- [Γ : U] over K, a number field when K is.
theorem IsProGalois.open_fixedField (U : Set)
  requires open : OpenSubgroup(U, G, X)
  shows FiniteExtension(subextension(E, fixedFieldOf(G, ρ, E, U))) ∧
    extensionDegree(subextension(E, fixedFieldOf(G, ρ, E, U))) = index(G, U) ∧
    (NumberField(Algebra.base(E)) →
      NumberField(subringRing(Algebra.ring(E), fixedFieldOf(G, ρ, E, U))))
proof
  sorry

end ProfiniteGalois

-- Section: Continuous cohomology
section Cohomology
variable (G X M act : Set)
hypothesis module : DiscreteGModule(G, X, M, act)

-- Z1 and Z2 are subgroups of the cochains, B2 ⊆ Z2 is a subgroup of the
-- 2-cocycles, H² is an abelian group, and d0 lands in Z1 (Z1, Z2, B2, H2
-- as modules).
theorem Z1.subgroup
  shows Z1(G, X, M, act) ⊆ continuousCochains1(G, X, M) ∧
    cochainOne(M, Group.carrier(G)) ∈ Z1(G, X, M, act) ∧
    (∀ f ∈ Z1(G, X, M, act), ∀ h ∈ Z1(G, X, M, act),
      cochainMul(M, Group.carrier(G), f, h) ∈ Z1(G, X, M, act) ∧
      cochainInv(M, Group.carrier(G), f) ∈ Z1(G, X, M, act))
proof
  sorry

theorem cocycle2Group.abelian
  shows AbelianGroup(cocycle2Group(G, X, M, act)) ∧
    Subgroup(B2(G, X, M, act), cocycle2Group(G, X, M, act))
proof
  sorry

theorem H2.abelian
  shows AbelianGroup(H2(G, X, M, act)) ∧
    (∀ f ∈ Z2(G, X, M, act), h2Class(G, X, M, act, f) ∈ Group.carrier(H2(G, X, M, act))) ∧
    (∀ f ∈ Z2(G, X, M, act),
      h2Class(G, X, M, act, f) = Group.one(H2(G, X, M, act)) ↔ f ∈ B2(G, X, M, act))
proof
  sorry

theorem d0.mem_Z1 (m : Set)
  requires member : m ∈ Group.carrier(M)
  shows d0(G, M, act, m) ∈ Z1(G, X, M, act)
proof
  sorry

-- pairMapZ1, pairMapH2: for a continuous homomorphism φ : H → G and a
-- homomorphism u : M → N with u(φ(g)·m) = g·u(m), f ↦ u ∘ f ∘ φ maps
-- Z1 to Z1 and induces a homomorphism H²(G, M) → H²(H, N).
theorem pairMapH2.hom (H Y N act2 φ u : Set)
  requires module2 : DiscreteGModule(H, Y, N, act2)
  requires hom : GroupHom(φ, H, G)
  requires continuous : φ : Y ⇒ X
  requires linear : GroupHom(u, M, N)
  requires compatible : ∀ g ∈ Group.carrier(H), ∀ m ∈ Group.carrier(M),
    u(act(φ(g), m)) = act2(g, u(m))
  shows (∀ f ∈ Z1(G, X, M, act), pullCochain1(H, φ, u, f) ∈ Z1(H, Y, N, act2)) ∧
    GroupHom(pairMapH2(G, X, M, act, H, Y, N, act2, φ, u), H2(G, X, M, act), H2(H, Y, N, act2))
proof
  sorry

end Cohomology

-- Section: ℚ/ℤ
section RatModInt

-- ℚ/ℤ is an abelian group and QZ.mk a surjective homomorphism.
theorem qzGroup.abelian
  shows AbelianGroup(qzGroup) ∧ GroupHom(qzMkMap, Ring.additive(rationalRing), qzGroup) ∧
    (∀ a ∈ Group.carrier(qzGroup), ∃ q ∈ ℚ, qzMk(q) = a)
proof
  sorry

-- QZ.mk_fracRep: fracRep a represents a, in [0, 1).
theorem qzFracRep.mk (a : Set)
  requires member : a ∈ Group.carrier(qzGroup)
  shows qzFracRep(a) ∈ ℚ ∧ qzMk(qzFracRep(a)) = a ∧
    (qzFracRep(a) = rationalZero ∨ relates(rationalLess, rationalZero, qzFracRep(a))) ∧
    relates(rationalLess, qzFracRep(a), rationalOne)
proof
  sorry

-- QZ.cast_carry: carry a b = fracRep a + fracRep b − fracRep (a + b),
-- an integer 0 or 1.
theorem qzCarry.cast (a b : Set)
  requires first : a ∈ Group.carrier(qzGroup)
  requires second : b ∈ Group.carrier(qzGroup)
  shows (qzCarry(a, b) = integerZero ∨ qzCarry(a, b) = integerOne) ∧
    intRat(qzCarry(a, b)) = rationalAdd((rationalAdd((qzFracRep(a), qzFracRep(b))),
      rationalNeg(qzFracRep(Group.mul(qzGroup)(a, b)))))
proof
  sorry

end RatModInt

-- Section: The cyclic class
section CyclicClass
variable (G X M act : Set)
hypothesis module : DiscreteGModule(G, X, M, act)

-- cyclicClass: the carry cocycle is a continuous 2-cocycle, and its class
-- δχ ∪ w is biadditive in χ and w.
theorem cyclicCocycle.mem_Z2 (χ w : Set)
  requires character : χ ∈ qzChars(G, X)
  requires invariant : w ∈ fixedPoints(act, G, Group.carrier(M))
  shows cyclicCocycle(G, M, χ, w) ∈ Z2(G, X, M, act)
proof
  sorry

theorem cyclicClass.biadditive (χ ψ w u : Set)
  requires character : χ ∈ qzChars(G, X)
  requires character2 : ψ ∈ qzChars(G, X)
  requires invariant : w ∈ fixedPoints(act, G, Group.carrier(M))
  requires invariant2 : u ∈ fixedPoints(act, G, Group.carrier(M))
  shows cyclicClass(G, X, M, act, cochainMul(qzGroup, Group.carrier(G), χ, ψ), w) =
      Group.mul(H2(G, X, M, act))(cyclicClass(G, X, M, act, χ, w), cyclicClass(G, X, M, act, ψ, w)) ∧
    cyclicClass(G, X, M, act, χ, Group.mul(M)(w, u)) =
      Group.mul(H2(G, X, M, act))(cyclicClass(G, X, M, act, χ, w), cyclicClass(G, X, M, act, χ, u))
proof
  sorry

-- QZChar.ker is an open subgroup, and abelianLift is well defined on Γ^ab
-- (QZChar.abelianLift, isOpen_ker).
theorem qzChars.abelian_lift (χ g : Set)
  requires character : χ ∈ qzChars(G, X)
  requires member : g ∈ Group.carrier(G)
  shows OpenSubgroup(qzCharKernel(G, χ), G, X) ∧
    abelianLift(G, X, χ, abelianClass(G, X, g)) = χ(g) ∧
    GroupHom(χ, G, qzGroup)
proof
  sorry

end CyclicClass

-- Section: The local invariant and the local Artin map
section LocalArtin
variable (G X ρ E A : Set)
hypothesis local : IsLocalGalois(G, X, ρ, E, A)

-- ordRat is well defined: there is exactly one normalised order.
theorem IsOrdRat.exists_unique
  shows IsOrdRat(E, A, ordRat(E, A)) ∧
    (∀ f, IsOrdRat(E, A, f) → f = ordRat(E, A))
proof
  sorry

-- A uniformiser exists (the valuation ring below is a DVR) and has order
-- 1.
theorem IsUniformiser.exists_order_one
  shows ∃ π ∈ ringUnits(Algebra.base(E)), IsUniformiser(E, A, π) ∧
    ordRat(E, A)(Algebra.map(E)(π)) = rationalOne
proof
  sorry

-- classOfInv is well defined for a local field (the property
-- IsClassOfInv has exactly one solution; the source's
-- isClassOfInv_classOfInv), and it is a bijection ℚ/ℤ ≅ H²(Γ, Ωˣ)
-- (classOfInv_bijective).
theorem IsClassOfInv.exists_unique
  shows IsClassOfInv(G, X, ρ, E, A, classOfInv(G, X, ρ, E, A)) ∧
    (∀ b, IsClassOfInv(G, X, ρ, E, A, b) → b = classOfInv(G, X, ρ, E, A)) ∧
    BijectiveBetween(classOfInv(G, X, ρ, E, A), Group.carrier(qzGroup),
      Group.carrier(unitsH2(G, X, ρ, Algebra.ring(E))))
proof
  sorry

-- The local reciprocity map exists and is unique: there is exactly one
-- homomorphism Kˣ → Γ^ab with the local invariant property
-- (IsLocalArtin, and the uniqueness through abelianization_ext).
theorem IsLocalArtin.exists_unique
  shows (∃ f, IsLocalArtin(G, X, ρ, E, A, E, f)) ∧
    (∀ f, ∀ h, IsLocalArtin(G, X, ρ, E, A, E, f) → IsLocalArtin(G, X, ρ, E, A, E, h) →
      (∀ x ∈ ringUnits(Algebra.base(E)), ∀ χ ∈ qzChars(G, X),
        abelianLift(G, X, χ, f(x)) = abelianLift(G, X, χ, h(x))))
proof
  sorry

end LocalArtin

-- Section: Places over a prime
section PlaceOver
variable (G X ρ E : Set)
hypothesis galois : IsProGalois(G, X, ρ, E)
hypothesis numberField : NumberField(Algebra.base(E))
hypothesis closed : AlgebraicallyClosed(Algebra.ring(E))
hypothesis characteristic : CharP(Algebra.ring(E), 0)

-- placeOver v: every finite place v of K has a place of Ω over it, and
-- the places over v are one Γ-orbit.
theorem IsPlaceOver.exists (v : Set)
  requires place : v ∈ finPlaces(Algebra.base(E))
  shows ∃ A ∈ closurePlaces(Algebra.ring(E)), IsPlaceOver(E, A, v)
proof
  sorry

theorem IsPlaceOver.conjugate (v A A2 : Set)
  requires over : IsPlaceOver(E, A, v)
  requires over2 : IsPlaceOver(E, A2, v)
  shows ∃ g ∈ Group.carrier(G), placeTranslate(G, ρ, Algebra.ring(E), g, A) = A2
proof
  sorry

-- localArtin is well defined at a place A over v: the decomposition field
-- is local (IsLocalGalois of D_A over its fixed field), and exactly one
-- K_vˣ → D_A^ab has the local invariant property on Kˣ.
theorem IsPlaceOver.decomp_local (v A : Set)
  requires place : v ∈ finPlaces(Algebra.base(E))
  requires over : IsPlaceOver(E, A, v)
  shows IsLocalGalois(decompSubgroup(G, ρ, Algebra.ring(E), A),
    decompSpace(G, X, ρ, Algebra.ring(E), A), decompAction(G, ρ, Algebra.ring(E), A),
    decompField(G, ρ, E, A), A)
proof
  sorry

theorem localArtin.exists_unique (v A : Set)
  requires place : v ∈ finPlaces(Algebra.base(E))
  requires over : IsPlaceOver(E, A, v)
  shows IsLocalArtinAt(G, X, ρ, E, A, v, localArtin(G, X, ρ, E, A, v)) ∧
    (∀ f, IsLocalArtinAt(G, X, ρ, E, A, v, f) → f = localArtin(G, X, ρ, E, A, v))
proof
  sorry

end PlaceOver
