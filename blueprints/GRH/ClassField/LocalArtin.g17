-- The local Artin map at a finite place of a number field and the global
-- Artin map on the finite ideles: openness of subgroups of K_wˣ
-- containing the n-th powers, continuity of homomorphisms to Γ^ab, norm
-- functoriality and density of the local Artin map, uniformisers to
-- inverse Frobenius elements and units to inertia, the local symbol in
-- Γ^ab and its value on Kˣ through the local invariant, the tame symbol,
-- and tame generators of inertia.
-- Source: grh-compact/src/Lib/ClassField/Local/ArtinMapAtPlace.lean
-- (isOpen_of_forall_pow_mem, continuous_hom_locField_units,
-- inertiaAbove, IsPlaceOver.isLocalArtin_localArtin (second part),
-- localArtin_adeleNorm, denseRange_localArtin,
-- exists_frob_inv_eq_localArtin, exists_inertia_eq_localArtin,
-- exists_localArtin_eq, artinAt_eq_of_localArtin_eq,
-- abelianLift_artinAt, abelianLift_artinAt_principal,
-- abelianLift_artinAt_eq_one_iff, localArtin_tame_symbol,
-- exists_tameGenerator, tameGenerator, tame_inertia,
-- exists_localArtin_eq_tameGenerator), with the definitions of artinAt
-- and artinMap from Lib/General/Groups/ArtinDefs.lean as STAND-INs.
-- Encoding. Γ acting on Ω/K is (G, X, ρ, E) as in GRH.ClassField.Galois,
-- with Ω the ring of E. A class of the abelianised decomposition group
-- D_A^ab "equal to g" is abelianClass of g in D_A. The source's artinAt
-- uses a chosen place over v (placeOver v); the local symbol in Γ^ab does
-- not depend on the place, so csCFArtinAt is the common value over all
-- places A over v (the ⋃ of a singleton), and csCFArtinMap is the unique
-- homomorphism with χ(Art a) = Σ_v χ(Art_v a_v) for every character χ.
-- The restriction H²(Γ, Ωˣ) → H²(D, Ωˣ) (DiscreteUnits.lean, resH2 of
-- unitsModule) is csCFUnitsResH2 here. The chosen tame generator becomes
-- any γ with IsTameGenerator. The first part of isLocalArtin_localArtin
-- (the invariant of K_w through an embedding Ω → ℚ̄_p, IsCompletionEmb)
-- is not stated. In tame_inertia the target monoid P is a group.
-- Part of the GRH blueprint (layer 4, Lib/ClassField, stage S1).
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.ClassField.LocalArtin
import GRH.ClassField.Galois
import Grace.Cumulus.Algebra.Group.Cyclic

section LocalArtinDefs

-- ArtinMapAtPlace.lean, inertiaAbove S: the union of the inertia groups
-- of the places of Ω over the primes in S.
def inertiaAbove (G ρ E S : Set) : Set :=
  { g ∈ Group.carrier(G) | ∃ v ∈ S, ∃ A ∈ closurePlaces(Algebra.ring(E)),
    IsPlaceOver(E, A, v) ∧ g ∈ inertiaGroup(G, ρ, Algebra.ring(E), A) }

-- The restriction H²(Γ, Ωˣ) → H²(U, Ωˣ) to a subgroup U
-- (DiscreteUnits.lean, resH2 for unitsModule; stated in a later module).
def csCFUnitsResH2 (G X ρ W U : Set) : Set :=
  pairMapH2(G, X, unitGroup(W), unitsAction(G, ρ, W), subgroupGroup(G, U), subspace(X, U),
    unitGroup(W), unitsAction(subgroupGroup(G, U), restrict(ρ, U), W), identity(U),
    identity(ringUnits(W)))

-- K_wˣ with the topology of K_w.
def locUnitsSpace (K w : Set) : Set := subspace(adicCompletionSpace(K, w), locUnits(K, w))

-- Γ^ab with the quotient topology.
def abelianizationSpace (G X : Set) : Set := quotientGroupSpace(G, X, closedCommutator(G, X))

-- The image of the local Artin map at A over w.
def localArtinImage (G X ρ E A w : Set) : Set :=
  functionImage(localArtin(G, X, ρ, E, A, w), locUnits(Algebra.base(E), w),
    Group.carrier(topAbelianization(decompSubgroup(G, ρ, Algebra.ring(E), A),
      decompSpace(G, X, ρ, Algebra.ring(E), A))))

-- STAND-IN for Lib/General/Groups/ArtinDefs.lean, artinAt v: the local
-- Artin map at v followed by D_A^ab → Γ^ab, for any place A over v (the
-- source takes the chosen placeOver v; the value does not depend on A).
def csCFArtinAt (G X ρ E v x : Set) : Set :=
  ⋃({ c ∈ Group.carrier(topAbelianization(G, X)) |
    ∃ A ∈ closurePlaces(Algebra.ring(E)), IsPlaceOver(E, A, v) ∧
      c = abelianIncl(G, X, localArtin(G, X, ρ, E, A, v)(x)) })

def csCFArtinAtMap (G X ρ E v : Set) : Set :=
  { (x, csCFArtinAt(G, X, ρ, E, v, x)) | x ∈ locUnits(Algebra.base(E), v) }

-- The sum in ℚ/ℤ of a family w over a finite set V.
def qzFiniteSum (V w : Set) : Set :=
  ⋃({ s ∈ Group.carrier(qzGroup) | ∃ n ∈ ℕ, ∃ f, BijectiveBetween(f, n, V) ∧
    s = indexedRingSum(w, f, Group.mul(qzGroup), Group.one(qzGroup), n) })

-- The places at which χ(Art_v a_v) ≠ 0, and the family of these values.
def artinSupport (G X ρ E χ a : Set) : Set :=
  { v ∈ finPlaces(Algebra.base(E)) |
    abelianLift(G, X, χ, csCFArtinAt(G, X, ρ, E, v, ideleAt(Algebra.base(E), v, a))) ≠
      Group.one(qzGroup) }

def artinTerms (G X ρ E χ a : Set) : Set :=
  { (v, abelianLift(G, X, χ, csCFArtinAt(G, X, ρ, E, v, ideleAt(Algebra.base(E), v, a)))) |
    v ∈ artinSupport(G, X, ρ, E, χ, a) }

-- STAND-IN for ArtinDefs.lean, artinMap: the homomorphism
-- f : (𝔸f K)ˣ → Γ^ab with χ(f a) = Σ_v χ(Art_v a_v) for every continuous
-- character χ (the source chooses one; it is unique).
predicate csCFIsArtinMap (G X ρ E f : Set) :=
  GroupHom(f, finIdeleGroup(Algebra.base(E)), topAbelianization(G, X)) ∧
  (∀ χ ∈ qzChars(G, X), ∀ a ∈ finIdeleUnits(Algebra.base(E)),
    abelianLift(G, X, χ, f(a)) =
      qzFiniteSum(artinSupport(G, X, ρ, E, χ, a), artinTerms(G, X, ρ, E, χ, a)))

def csCFArtinMap (G X ρ E : Set) : Set :=
  ⋃({ f ∈ functionSpace(finIdeleUnits(Algebra.base(E)), Group.carrier(topAbelianization(G, X))) |
    csCFIsArtinMap(G, X, ρ, E, f) })

-- ArtinMapAtPlace.lean, exists_tameGenerator: γ in the inertia group of A
-- in Gal(Ω/K) such that for every n prime to A there are a uniformiser π
-- of K and y with yⁿ = π and γy/y a primitive n-th root of unity
-- (tameGenerator is any such γ).
predicate IsTameGenerator (E A γ : Set) :=
  γ ∈ inertiaGroup(galoisGroup(E), identity(algebraAutomorphisms(E)), Algebra.ring(E), A) ∧
  (∀ n ∈ ℕ, natCast(Algebra.ring(E), n) ∈ valuationSubringUnits(Algebra.ring(E), A) →
    (∃ π ∈ ringUnits(Algebra.base(E)), ∃ y ∈ algebraCarrier(E),
      IsUniformiser(E, A, π) ∧ Ring.pow(Algebra.ring(E), y, n) = Algebra.map(E)(π) ∧
      IsPrimitiveRoot(Algebra.ring(E),
        call2(Ring.mul(Algebra.ring(E)), γ(y), ringInverse(Algebra.ring(E), y)), n)))

-- The maximal ideal of 𝓞_w (v(x) < 1).
def locMaximalIdeal (K w : Set) : Set :=
  functionImage(adicCompletionInclusion(K, w), Ring.carrier(adicCompletionIntegers(K, w)),
    Ring.carrier(adicCompletionField(K, w))) ∖ completionUnitsIn(K, w)

-- The residue in the residue field of an integer u of K_w.
def locResidue (K w u : Set) : Set :=
  ⋃({ c ∈ Ring.carrier(resField(K, w)) | ∃ a ∈ c, adicCompletionInclusion(K, w)(a) = u })

end LocalArtinDefs

-- Section: Local fields
section LocalUnits
variable (K w : Set)
hypothesis numberField : NumberField(K)
hypothesis place : w ∈ finPlaces(K)

-- isOpen_of_forall_pow_mem: a subgroup of K_wˣ containing every n-th
-- power, n ≠ 0, is open.
theorem locUnits.open_of_pow_mem (T : Set, n : Nat)
  requires nonzero : n ≠ 0
  requires subgroup : Subgroup(T, unitGroup(adicCompletionField(K, w)))
  requires powers : ∀ y ∈ locUnits(K, w), Ring.pow(adicCompletionField(K, w), y, n) ∈ T
  shows T ∈ TopologicalSpace.opens(locUnitsSpace(K, w))
proof
  sorry

-- continuous_hom_locField_units: every homomorphism K_wˣ → Γ^ab of a
-- profinite Γ is continuous.
theorem locUnits.hom_continuous (G X f : Set)
  requires profinite : ProfiniteGroup(G, X)
  requires hom : GroupHom(f, unitGroup(adicCompletionField(K, w)), topAbelianization(G, X))
  shows f : locUnitsSpace(K, w) ⇒ abelianizationSpace(G, X)
proof
  sorry

end LocalUnits

-- Section: The local Artin map at a place over v
section AtPlace
variable (G X ρ E w A : Set)
hypothesis galois : IsProGalois(G, X, ρ, E)
hypothesis numberField : NumberField(Algebra.base(E))
hypothesis closed : AlgebraicallyClosed(Algebra.ring(E))
hypothesis place : w ∈ finPlaces(Algebra.base(E))
hypothesis over : IsPlaceOver(E, A, w)

-- isLocalArtin_localArtin (second part): on Kˣ, the local Artin map at A
-- satisfies χ(f x) = −inv(δχ ∪ x) for the decomposition field of A.
theorem IsPlaceOver.isLocalArtin_localArtin
  shows IsLocalArtin(decompSubgroup(G, ρ, Algebra.ring(E), A),
    decompSpace(G, X, ρ, Algebra.ring(E), A), decompAction(G, ρ, Algebra.ring(E), A),
    decompField(G, ρ, E, A), A, E, localArtinOnField(E, w, localArtin(G, X, ρ, E, A, w)))
proof
  sorry

-- denseRange_localArtin: the local Artin map has dense image in D_A^ab.
theorem IsPlaceOver.dense_localArtin
  shows Dense(abelianizationSpace(decompSubgroup(G, ρ, Algebra.ring(E), A),
    decompSpace(G, X, ρ, Algebra.ring(E), A)), localArtinImage(G, X, ρ, E, A, w))
proof
  sorry

-- exists_frob_inv_eq_localArtin: a uniformiser x of K_w has local symbol
-- the class of s⁻¹ for an arithmetic Frobenius s ∈ D_A.
theorem IsPlaceOver.exists_frob_inv_eq_localArtin (x : Set)
  requires unit : x ∈ locUnits(Algebra.base(E), w)
  requires uniformiser : completionOrder(Algebra.base(E), w, x) = integerOne
  shows ∃ s ∈ decompGroup(G, ρ, Algebra.ring(E), A),
    IsFrob(G, ρ, Algebra.ring(E), A, placeNorm(Algebra.base(E), w), s) ∧
    localArtin(G, X, ρ, E, A, w)(x) =
      abelianClass(decompSubgroup(G, ρ, Algebra.ring(E), A),
        decompSpace(G, X, ρ, Algebra.ring(E), A), Group.inv(G)(s))
proof
  sorry

-- exists_inertia_eq_localArtin: units go to inertia.
theorem IsPlaceOver.exists_inertia_eq_localArtin (x : Set)
  requires unit : x ∈ locUnits(Algebra.base(E), w)
  requires integral : x ∈ completionUnitsIn(Algebra.base(E), w)
  shows ∃ s ∈ inertiaGroup(G, ρ, Algebra.ring(E), A),
    localArtin(G, X, ρ, E, A, w)(x) =
      abelianClass(decompSubgroup(G, ρ, Algebra.ring(E), A),
        decompSpace(G, X, ρ, Algebra.ring(E), A), s)
proof
  sorry

-- exists_localArtin_eq: if g⁻¹ is a (N w)ⁿ-Frobenius, the class of g is
-- the local symbol of some x of order −n.
theorem IsPlaceOver.exists_localArtin_eq (g : Set, n : Nat)
  requires frobenius : IsFrob(G, ρ, Algebra.ring(E), A, pow(placeNorm(Algebra.base(E), w), n),
    Group.inv(G)(g))
  shows ∃ x ∈ locUnits(Algebra.base(E), w),
    completionOrder(Algebra.base(E), w, x) = integerNegValue(integerOfNat(n)) ∧
    localArtin(G, X, ρ, E, A, w)(x) =
      abelianClass(decompSubgroup(G, ρ, Algebra.ring(E), A),
        decompSpace(G, X, ρ, Algebra.ring(E), A), g)
proof
  sorry

-- artinAt_eq_of_localArtin_eq: if the local symbol at A is the class of
-- g ∈ D_A, artinAt sends x to the class of g in Γ^ab; abelianLift_artinAt.
theorem IsPlaceOver.artinAt_eq_of_localArtin_eq (x g : Set)
  requires unit : x ∈ locUnits(Algebra.base(E), w)
  requires decomposition : g ∈ decompGroup(G, ρ, Algebra.ring(E), A)
  requires symbol : localArtin(G, X, ρ, E, A, w)(x) =
    abelianClass(decompSubgroup(G, ρ, Algebra.ring(E), A),
      decompSpace(G, X, ρ, Algebra.ring(E), A), g)
  shows csCFArtinAt(G, X, ρ, E, w, x) = abelianClass(G, X, g)
proof
  sorry

theorem IsPlaceOver.abelianLift_artinAt (χ x : Set)
  requires character : χ ∈ qzChars(G, X)
  requires unit : x ∈ locUnits(Algebra.base(E), w)
  shows abelianLift(G, X, χ, csCFArtinAt(G, X, ρ, E, w, x)) =
    abelianLift(decompSubgroup(G, ρ, Algebra.ring(E), A),
      decompSpace(G, X, ρ, Algebra.ring(E), A),
      restrict(χ, decompGroup(G, ρ, Algebra.ring(E), A)), localArtin(G, X, ρ, E, A, w)(x))
proof
  sorry

-- abelianLift_artinAt_principal: for x ∈ Kˣ, the invariant of
-- χ(Art_w x) is minus the restriction of δχ ∪ x to D_A;
-- abelianLift_artinAt_eq_one_iff: χ(Art_w x) = 0 iff that restriction
-- vanishes.
theorem IsPlaceOver.abelianLift_artinAt_principal (χ x : Set)
  requires character : χ ∈ qzChars(G, X)
  requires unit : x ∈ fieldUnits(Algebra.base(E))
  shows classOfInv(decompSubgroup(G, ρ, Algebra.ring(E), A),
      decompSpace(G, X, ρ, Algebra.ring(E), A), decompAction(G, ρ, Algebra.ring(E), A),
      decompField(G, ρ, E, A), A)(
        abelianLift(G, X, χ, csCFArtinAt(G, X, ρ, E, w,
          ideleAt(Algebra.base(E), w, principalIdele(Algebra.base(E), x))))) =
    Group.inv(unitsH2(decompSubgroup(G, ρ, Algebra.ring(E), A),
        decompSpace(G, X, ρ, Algebra.ring(E), A), decompAction(G, ρ, Algebra.ring(E), A),
        Algebra.ring(E)))(
      csCFUnitsResH2(G, X, ρ, Algebra.ring(E), decompGroup(G, ρ, Algebra.ring(E), A))(
        unitsCyclicClass(G, X, ρ, Algebra.ring(E), χ, Algebra.map(E)(x))))
proof
  sorry

theorem IsPlaceOver.abelianLift_artinAt_eq_one_iff (χ x : Set)
  requires character : χ ∈ qzChars(G, X)
  requires unit : x ∈ fieldUnits(Algebra.base(E))
  shows abelianLift(G, X, χ, csCFArtinAt(G, X, ρ, E, w,
      ideleAt(Algebra.base(E), w, principalIdele(Algebra.base(E), x)))) = Group.one(qzGroup) ↔
    csCFUnitsResH2(G, X, ρ, Algebra.ring(E), decompGroup(G, ρ, Algebra.ring(E), A))(
        unitsCyclicClass(G, X, ρ, Algebra.ring(E), χ, Algebra.map(E)(x))) =
      Group.one(unitsH2(decompSubgroup(G, ρ, Algebra.ring(E), A),
        decompSpace(G, X, ρ, Algebra.ring(E), A), decompAction(G, ρ, Algebra.ring(E), A),
        Algebra.ring(E)))
proof
  sorry

-- localArtin_tame_symbol: π a uniformiser at A, y^(N w − 1) = π, u a unit
-- of K_w with local symbol the class of s; then for x ∈ K, u ≡ x at w iff
-- sy/y ≡ x at A.
theorem IsPlaceOver.localArtin_tame_symbol (π s u y x : Set)
  requires uniformiser : IsUniformiser(E, A, π)
  requires decomposition : s ∈ decompGroup(G, ρ, Algebra.ring(E), A)
  requires unit : u ∈ locUnits(Algebra.base(E), w)
  requires integral : u ∈ completionUnitsIn(Algebra.base(E), w)
  requires symbol : localArtin(G, X, ρ, E, A, w)(u) =
    abelianClass(decompSubgroup(G, ρ, Algebra.ring(E), A),
      decompSpace(G, X, ρ, Algebra.ring(E), A), s)
  requires root : y ∈ algebraCarrier(E)
  requires power : Ring.pow(Algebra.ring(E), y, (placeNorm(Algebra.base(E), w):N) - 1) =
    Algebra.map(E)(π)
  requires member : x ∈ Ring.carrier(Algebra.base(E))
  shows Ring.sub(adicCompletionField(Algebra.base(E), w), u,
      adicCompletionEmbedding(Algebra.base(E), w)(x)) ∈
        locMaximalIdeal(Algebra.base(E), w) ↔
    Ring.sub(Algebra.ring(E), call2(Ring.mul(Algebra.ring(E)), ρ(s)(y),
        ringInverse(Algebra.ring(E), y)), Algebra.map(E)(x)) ∈
      valuationSubringNonunits(Algebra.ring(E), A)
proof
  sorry

end AtPlace

-- Section: Norm functoriality
section Norms
variable (G X ρ E H Y σ2 F P w A ψ j : Set)
hypothesis galois : IsProGalois(G, X, ρ, E)
hypothesis galois2 : IsProGalois(H, Y, σ2, F)
hypothesis numberField : NumberField(Algebra.base(E))
hypothesis numberField2 : NumberField(Algebra.base(F))
hypothesis closed : AlgebraicallyClosed(Algebra.ring(E))
hypothesis sameClosure : Algebra.ring(F) = Algebra.ring(E)
hypothesis base : RingHom(P, Algebra.base(F), Algebra.base(E))
hypothesis place : w ∈ finPlaces(Algebra.base(E))
hypothesis over : IsPlaceOver(E, A, w)
hypothesis hom : GroupHom(ψ, G, H)
hypothesis embedding : RingHom(j, Algebra.ring(E), Algebra.ring(E))
hypothesis equivariant : ∀ g ∈ Group.carrier(G), ∀ x ∈ algebraCarrier(E),
  j(σ2(ψ(g))(x)) = ρ(g)(j(x))
hypothesis tower : ∀ x ∈ Ring.carrier(Algebra.base(F)), j(Algebra.map(F)(x)) =
  Algebra.map(E)(P(x))

-- localArtin_adeleNorm: for k → K (F over k, E over K, Γ → Γ′ by ψ, and
-- j : Ω → Ω compatible), if Art_w y is the class of g, the local norm of
-- y has symbol the class of ψ(g) at the place j⁻¹A below; and if the
-- kernel of χ on D_{j⁻¹A} is ψ(D_A), every x with χ(Art x) = 0 is a local
-- norm from K_w.
theorem IsPlaceOver.localArtin_adeleNorm
  shows (∀ y ∈ locUnits(Algebra.base(E), w), ∀ g ∈ decompGroup(G, ρ, Algebra.ring(E), A),
      localArtin(G, X, ρ, E, A, w)(y) =
          abelianClass(decompSubgroup(G, ρ, Algebra.ring(E), A),
            decompSpace(G, X, ρ, Algebra.ring(E), A), g) →
        localArtin(H, Y, σ2, F, valSubringComap(Algebra.ring(E), j, A),
            placeBelow(Algebra.base(F), Algebra.base(E), P, w))(
              localNorm(Algebra.base(F), Algebra.base(E), P, w, y)) =
          abelianClass(decompSubgroup(H, σ2, Algebra.ring(E), valSubringComap(Algebra.ring(E), j, A)),
            decompSpace(H, Y, σ2, Algebra.ring(E), valSubringComap(Algebra.ring(E), j, A)),
            ψ(g))) ∧
    (∀ χ ∈ qzChars(decompSubgroup(H, σ2, Algebra.ring(E), valSubringComap(Algebra.ring(E), j, A)),
        decompSpace(H, Y, σ2, Algebra.ring(E), valSubringComap(Algebra.ring(E), j, A))),
      qzCharKernel(decompSubgroup(H, σ2, Algebra.ring(E), valSubringComap(Algebra.ring(E), j, A)),
          χ) = functionImage(ψ, decompGroup(G, ρ, Algebra.ring(E), A), Group.carrier(H)) →
      (∀ x ∈ locUnits(Algebra.base(F), placeBelow(Algebra.base(F), Algebra.base(E), P, w)),
        abelianLift(decompSubgroup(H, σ2, Algebra.ring(E), valSubringComap(Algebra.ring(E), j, A)),
            decompSpace(H, Y, σ2, Algebra.ring(E), valSubringComap(Algebra.ring(E), j, A)), χ,
            localArtin(H, Y, σ2, F, valSubringComap(Algebra.ring(E), j, A),
              placeBelow(Algebra.base(F), Algebra.base(E), P, w))(x)) = Group.one(qzGroup) →
        (∃ y ∈ locUnits(Algebra.base(E), w),
          localNorm(Algebra.base(F), Algebra.base(E), P, w, y) = x)))
proof
  sorry

end Norms

-- Section: Tame inertia
section Tame
variable (E w A : Set)
hypothesis galoisExt : GaloisExtension(E)
hypothesis numberField : NumberField(Algebra.base(E))
hypothesis closed : AlgebraicallyClosed(Algebra.ring(E))
hypothesis place : w ∈ finPlaces(Algebra.base(E))
hypothesis over : IsPlaceOver(E, A, w)

-- exists_tameGenerator.
theorem IsPlaceOver.exists_tameGenerator
  shows ∃ γ, IsTameGenerator(E, A, γ)
proof
  sorry

-- tame_inertia: for n prime to w and f : Gal(Ω/K) → P a homomorphism,
-- trivial on inertia near 1 and with fⁿ = 1 on inertia, f(s) is a power
-- of f(γ) on inertia and f(φsφ⁻¹) = f(s)^q for a q-Frobenius φ.
theorem IsPlaceOver.tame_inertia (γ Pg f : Set, n : Nat)
  requires tame : IsTameGenerator(E, A, γ)
  requires hom : GroupHom(f, galoisGroup(E), Pg)
  requires near : ∃ U ∈ krullOpens(E), identity(algebraCarrier(E)) ∈ U ∧
    (∀ g ∈ U, g ∈ inertiaGroup(galoisGroup(E), identity(algebraAutomorphisms(E)),
      Algebra.ring(E), A) → f(g) = Group.one(Pg))
  requires prime : natCast(Algebra.ring(E), n) ∈ valuationSubringUnits(Algebra.ring(E), A)
  requires torsion : ∀ g ∈ inertiaGroup(galoisGroup(E), identity(algebraAutomorphisms(E)),
    Algebra.ring(E), A), groupPow(Pg, f(g), n) = Group.one(Pg)
  shows ∀ s ∈ inertiaGroup(galoisGroup(E), identity(algebraAutomorphisms(E)), Algebra.ring(E), A),
    (∃ i ∈ ℕ, f(s) = groupPow(Pg, f(γ), i)) ∧
    (∀ q ∈ ℕ, ∀ φ, IsFrob(galoisGroup(E), identity(algebraAutomorphisms(E)), Algebra.ring(E),
        A, q, φ) →
      f(Group.mul(galoisGroup(E))(Group.mul(galoisGroup(E))(φ, s),
          Group.inv(galoisGroup(E))(φ))) = groupPow(Pg, f(s), q))
proof
  sorry

-- exists_localArtin_eq_tameGenerator: some unit u of K_w has local symbol
-- the class of γ, and its residue generates the units of the residue
-- field.
theorem IsPlaceOver.exists_localArtin_eq_tameGenerator (γ : Set)
  requires tame : IsTameGenerator(E, A, γ)
  shows ∃ u ∈ locUnits(Algebra.base(E), w), u ∈ completionUnitsIn(Algebra.base(E), w) ∧
    localArtin(galoisGroup(E), krullTopology(E), identity(algebraAutomorphisms(E)), E, A, w)(u) =
      abelianClass(decompSubgroup(galoisGroup(E), identity(algebraAutomorphisms(E)),
          Algebra.ring(E), A),
        decompSpace(galoisGroup(E), krullTopology(E), identity(algebraAutomorphisms(E)),
          Algebra.ring(E), A), γ) ∧
    powers(unitGroup(resField(Algebra.base(E), w)), locResidue(Algebra.base(E), w, u)) =
      ringUnits(resField(Algebra.base(E), w))
proof
  sorry

end Tame

-- Section: The global Artin map (stand-in definitions)
section GlobalArtin
variable (G X ρ E : Set)
hypothesis galois : IsProGalois(G, X, ρ, E)
hypothesis numberField : NumberField(Algebra.base(E))
hypothesis closed : AlgebraicallyClosed(Algebra.ring(E))

-- artinAt is well defined: its value is the image of the local symbol at
-- any place A over v.
theorem csCFArtinAt.eq_of_place_over (v A x : Set)
  requires place : v ∈ finPlaces(Algebra.base(E))
  requires over : IsPlaceOver(E, A, v)
  requires unit : x ∈ locUnits(Algebra.base(E), v)
  shows csCFArtinAt(G, X, ρ, E, v, x) = abelianIncl(G, X, localArtin(G, X, ρ, E, A, v)(x)) ∧
    GroupHom(csCFArtinAtMap(G, X, ρ, E, v), unitGroup(adicCompletionField(Algebra.base(E), v)),
      topAbelianization(G, X))
proof
  sorry

-- The support of χ(Art_v a_v) is finite (QZChar.eventually_artinAt_eq_one),
-- and artinMap is well defined: exactly one homomorphism has the product
-- formula (abelianLift_artinMap_eq_finprod).
theorem csCFArtinMap.exists_unique
  shows (∀ χ ∈ qzChars(G, X), ∀ a ∈ finIdeleUnits(Algebra.base(E)),
      Finite(artinSupport(G, X, ρ, E, χ, a))) ∧
    csCFIsArtinMap(G, X, ρ, E, csCFArtinMap(G, X, ρ, E)) ∧
    (∀ f, csCFIsArtinMap(G, X, ρ, E, f) → f = csCFArtinMap(G, X, ρ, E))
proof
  sorry

end GlobalArtin
