-- Algebraic Hecke characters of a number field K: pairs (θ, n) of a
-- character θ of the finite ideles with open kernel and an infinity type
-- n : Hom(K, ℂ) → ℤ with θ(x) = ∏_σ σ(x)^{−n_σ} on Kˣ; their product and
-- the group they form.
-- Source: grh-compact/src/Lib/General/Groups/ArtinDefs.lean
-- (algHeckeChars, AlgHeckeChar). STAND-IN: that file belongs to the group
-- Lib/General/Groups, not stated yet; this is a minimal local version for
-- Lib/ClassField (HeckeL/AutCharLFunction.lean, Global/Avatars.lean),
-- under csCF names. The real one needs only what is here: the open-kernel
-- characters of GRH.ClassField.Ideles and the subgroup laws, which are
-- stated below.
-- Encoding. A character with values in ℂˣ is a group homomorphism into
-- the units of ℂ (GRH.ClassField.Ideles, IdeleCharacter); the infinity
-- type is a function on all complex embeddings of K, as in the source.
-- Part of the GRH blueprint (layer 4, Lib/ClassField, stage S1).
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.ClassField.AlgebraicHecke
import GRH.ClassField.HeckeL

section AlgebraicHecke
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)

-- The factors σ(x)^{−n_σ} over the complex embeddings σ of K.
def csCFAlgTypeFactors (K n x : Set) : Set :=
  { (σ, complexIntPow(σ(x), integerNegValue(n(σ)))) | σ ∈ complexEmbeddings(K) }

-- STAND-IN for Lib/General/Groups/ArtinDefs.lean, algHeckeChars: θ has
-- open kernel, n is an infinity type, and θ(x) = ∏_σ σ(x)^{−n_σ} on Kˣ.
predicate csCFAlgHeckeChar (K θ n : Set) :=
  NumberField(K) ∧ OpenKernelCharacter(K, θ) ∧ FunctionBetween(n, complexEmbeddings(K), ℤ) ∧
  (∀ x ∈ fieldUnits(K), θ(principalIdele(K, x)) = charProduct(complexEmbeddings(K),
    csCFAlgTypeFactors(K, n, x)))

-- STAND-IN for ArtinDefs.lean, AlgHeckeChar K: the set of pairs (θ, n).
def csCFAlgHeckeChars (K : Set) : Set :=
  { p ∈ functionSpace(finIdeleUnits(K), complexCarrier) × functionSpace(complexEmbeddings(K), ℤ) |
    csCFAlgHeckeChar(K, fst(p), snd(p)) }

-- The product (θ, n)(θ′, n′) = (θθ′, n + n′), and the trivial pair.
def csCFIdeleCharMul (K θ ξ : Set) : Set := { (a, ℂ[θ(a) * ξ(a)]) | a ∈ finIdeleUnits(K) }

def csCFTypeSum (K n m : Set) : Set :=
  { (σ, integerAdd(n(σ), m(σ))) | σ ∈ complexEmbeddings(K) }

def csCFAlgHeckeMul (K p q : Set) : Set :=
  (csCFIdeleCharMul(K, fst(p), fst(q)), csCFTypeSum(K, snd(p), snd(q)))

def csCFTrivialIdeleChar (K : Set) : Set := { (a, complexOne) | a ∈ finIdeleUnits(K) }

def csCFZeroType (K : Set) : Set := { (σ, integerZero) | σ ∈ complexEmbeddings(K) }

def csCFTrivialAlgHecke (K : Set) : Set := (csCFTrivialIdeleChar(K), csCFZeroType(K))

end AlgebraicHecke

section AlgebraicHeckeFacts
variable (K : Set)
hypothesis numberField : NumberField(K)

-- algHeckeChars is a subgroup (Subgroup.ofDiv): it contains the trivial
-- pair and is closed under products.
theorem csCFAlgHeckeChars.one
  shows csCFTrivialAlgHecke(K) ∈ csCFAlgHeckeChars(K)
proof
  sorry

theorem csCFAlgHeckeChars.mul (p q : Set)
  requires first : p ∈ csCFAlgHeckeChars(K)
  requires second : q ∈ csCFAlgHeckeChars(K)
  shows csCFAlgHeckeMul(K, p, q) ∈ csCFAlgHeckeChars(K)
proof
  sorry

end AlgebraicHeckeFacts
