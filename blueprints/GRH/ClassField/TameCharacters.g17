-- Characters of U(1)(𝔸) on determinants of finite adelic unitary points:
-- a character of weight e and tame part ψ, ψ trivial off distinct places
-- w_i, takes ∏_i ψ_{w_i}(det(k mod w_i)) at det k for k in the integral
-- points K₀ = G_f ∩ GL_n(Ô), and 1 when ψ is trivial; υ is 1 on det K₀;
-- tamely ramified split characters (weight positive, ψ nontrivial exactly
-- on a finite set S with S ∩ S̄ = ∅) and their values on local units at
-- S; the base change of the rank twist a·υ^{n/2} for even n.
-- Source: grh-compact/src/Lib/ClassField/HeckeCharacter/CharOfDet.lean
-- (apply_det_eq_prod, apply_det_eq_one), LocalCharacters.lean
-- (upsilonU1_det_of_mem_Kf, spaceChar_rankTwist), LineParabolic.lean
-- (SplitTameChar, localChar_apply_of_isUnit). Part of: "Algebraic Hecke
-- characters (type A₀); extension of the quadratic character of a CM
-- field (known result; see Lib.ClassField.HeckeCharacter.SplittingCharExists)."
-- Encoding. G_f, K₀ are gfMatrices, kfMatrices of GRH.Adelic.QuotientMeasure
-- (unitary n × n matrices over 𝔸_f, the integral ones); the source's
-- detFin s g, the idele (1, det g) of U(1)(𝔸), is detIdele(Φ, E, n, g). A
-- family u ∈ ∏_{w∈S} E_w (LocProd S) is read as the idele equal to u_w at
-- w ∈ S and 1 elsewhere. AutChar.spaceChar k = baseChange · υ^{−k}
-- (PairDefs.lean) is written out.
-- Not stated: the rest of LineParabolic.lean (ReadsAt, namedVector,
-- localDatum, thetaIntegral, IsEquivariantLift, the line parabolic
-- coordinates lineRadical, lineLevi, RepresentedBy), the rest of
-- LocalCharacters.lean (localChar_det, SplitTameChar.exists_atPlaces_eq,
-- nu_det_of_mem_Kf, atPlaces_of_mem_trivialOn) and LevelModulus.lean
-- (Modulus, reductionK₀, levelOfSubgroup, charOfTamePart, IsTameFor, the
-- Fock polarisation, levelModulus): they are written in the vocabulary of
-- Lib/Weil (Space, the data space 𝒮, theta integrals, Fock pairing),
-- Lib/Weil/MixedModel (Modulus) and Lib/Adelic/CuspForms (LevelPlaces),
-- which layer 4 states with those groups.
-- Part of the GRH blueprint (layer 4, Lib/ClassField, stage S1).
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.ClassField.TameCharacters
import GRH.ClassField.SplittingChar

section TameCharacters
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)

-- PairDefs.lean, detFin s g: the idele (1, det g) for g ∈ G_f.
def detIdele (Φ E n g : Set) : Set := finIdeleIncl(Φ, matDet(finiteAdeleRing(E), n, g))

-- The factors ψ_{w_i}(det(k mod w_i)) over i ∈ ι.
def detResidueFactors (E n ψ w k ι : Set) : Set :=
  { (i, ψ(w(i))(matDet(resField(E, w(i)), n, reduceMatrixAt(E, n, w(i), k)))) | i ∈ ι }

-- LineParabolic.lean, SplitTameChar e: ν has weight e > 0 and tame part ψ,
-- nontrivial exactly on a nonempty finite set S of places with w̄ ∉ S for
-- w ∈ S.
predicate SplitTameChar (E Φ ν e ψ S : Set) :=
  HasWeight(E, Φ, ν, e, ψ) ∧ S ⊆ finPlaces(E) ∧ Finite(S) ∧ S ≠ ∅ ∧
  (∀ w ∈ S, conjugatePlace(E, w) ∉ S) ∧
  (∀ w ∈ finPlaces(E), ψ(w) ≠ trivialResidueChar(E, w) ↔ w ∈ S) ∧
  (∀ τ ∈ Φ, integerZero < e(τ))

-- The families t = (t_w)_{w∈S} of local units, the idele they give, and
-- ∏_{w∈S} ψ_w(t_w mod w).
def localUnitFamilies (E S : Set) : Set :=
  { t ∈ functionSpace(S, ⋃(locFieldCarriers(E))) | ∀ w ∈ S,
    t(w) ∈ locUnits(E, w) ∧ t(w) ∈ completionUnitsIn(E, w) }

def localIdeleValue (E S t u : Set) : Set :=
  ⋃({ z ∈ Ring.carrier(adicCompletionField(E, u)) |
    (u ∈ S ∧ z = t(u)) ∨ (u ∉ S ∧ z = Ring.one(adicCompletionField(E, u))) })

def localIdele (E S t : Set) : Set := { (u, localIdeleValue(E, S, t, u)) | u ∈ finPlaces(E) }

def localResidueFactors (E S ψ t : Set) : Set :=
  { (w, ψ(w)(reduceAt(E, w, localIdele(E, S, t)))) | w ∈ S }

-- AutChar.spaceChar k: x ↦ a(x/x̄) υ(x)^{−k}, for a natural k.
def spaceChar (E Φ υ a : Set, k : Nat) : Set :=
  { (x, ℂ[autCharBaseChange(E, Φ, a)(x) * complexInv(υ(x)) ^ k]) | x ∈ cmIdeles(E, Φ) }

end TameCharacters

section TameFacts
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)
variable (E Φ : Set)
hypothesis cmType : CMType(E, Φ)

-- The determinant of g ∈ G_f gives a point of U(1)(𝔸).
theorem detIdele.unitary (n g : Set)
  requires finite : Finite(n)
  requires point : g ∈ gfMatrices(E, n)
  shows detIdele(Φ, E, n, g) ∈ unitaryAdeles(E, Φ)
proof
  sorry

-- CharOfDet.lean, apply_det_eq_prod: if ψ is trivial off distinct places
-- w_i, then μ(det k) = ∏_i ψ_{w_i}(det(k mod w_i)) for k ∈ K₀.
theorem HasWeight.apply_det_eq_prod (μ e ψ n ι w k : Set)
  requires weight : HasWeight(E, Φ, μ, e, ψ)
  requires finite : Finite(n)
  requires finiteι : Finite(ι)
  requires places : InjectiveBetween(w, ι, finPlaces(E))
  requires tame : ∀ u ∈ finPlaces(E), u ∉ functionImage(w, ι, finPlaces(E)) →
    ψ(u) = trivialResidueChar(E, u)
  requires integral : k ∈ kfMatrices(E, n)
  shows μ(detIdele(Φ, E, n, k)) = charProduct(ι, detResidueFactors(E, n, ψ, w, k, ι))
proof
  sorry

-- CharOfDet.lean, apply_det_eq_one: with trivial tame part, μ(det k) = 1.
theorem HasWeight.apply_det_eq_one (μ e n k : Set)
  requires weight : HasWeight(E, Φ, μ, e, trivialResidueFamily(E))
  requires finite : Finite(n)
  requires integral : k ∈ kfMatrices(E, n)
  shows μ(detIdele(Φ, E, n, k)) = complexOne
proof
  sorry

-- LocalCharacters.lean, upsilonU1_det_of_mem_Kf: υ(det k) = 1 on K₀.
theorem upsilonU1.det_integral (υ n k : Set)
  requires splitting : CMSplittingChar(E, Φ, υ)
  requires finite : Finite(n)
  requires integral : k ∈ kfMatrices(E, n)
  shows upsilonU1(E, Φ, υ)(detIdele(Φ, E, n, k)) = complexOne
proof
  sorry

-- LocalCharacters.lean, spaceChar_rankTwist: for |n| = m even, the base
-- change of a·υ^{m/2} times υ^{−m} is the base change of a.
theorem rankTwist.space_char (υ a e ψ : Set, m : Nat)
  requires splitting : CMSplittingChar(E, Φ, υ)
  requires weight : HasWeight(E, Φ, a, e, ψ)
  requires even : 2 ∣ m
  shows spaceChar(E, Φ, υ, rankTwist(E, Φ, υ, a, m), m) = autCharBaseChange(E, Φ, a)
proof
  sorry

-- LineParabolic.lean, localChar_apply_of_isUnit: for a split tame
-- character, ν(t/t̄) at a family of local units t on S is ∏_{w∈S} ψ_w(t_w).
theorem SplitTameChar.local_units (ν e ψ S t : Set)
  requires tame : SplitTameChar(E, Φ, ν, e, ψ, S)
  requires units : t ∈ localUnitFamilies(E, S)
  shows autCharBaseChange(E, Φ, ν)(finIdeleIncl(Φ, localIdele(E, S, t))) =
    charProduct(S, localResidueFactors(E, S, ψ, t))
proof
  sorry

end TameFacts
