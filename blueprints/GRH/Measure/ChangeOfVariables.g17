-- Change of variables for Lebesgue measure: images and preimages of sets
-- under linear maps of ℝⁿ scale volume by |det A|, orthogonal maps and
-- translations preserve it; integrals under linear substitutions in ℝ and
-- ℝⁿ; the change of variables formula for injective differentiable maps
-- on open sets, with |det Df(x)|; Gaussian integrals on ℝ and ℝⁿ, real
-- and complex, with a linear term; and polar coordinates in ℝ² = ℂ.
-- Part of the GRH blueprint.
-- Planned home: MeasureTheory/Function/Jacobian and
-- Analysis/SpecialFunctions/Gaussian.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Measure.ChangeOfVariables
import GRH.Measure.Product
import GRH.Calculus.Frechet
import GRH.Matrix.Determinant

section ChangeOfVariables
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- Section: Definitions
-- ℝⁿ as a normed real space: the Euclidean module, norm and inner product.
def euclideanSpace (n : Nat) : Set := euclideanModule(realRing, n)
def euclideanNormMap (n : Nat) : Set := euclideanNorm(realRing, realAbs, n)
def euclideanSquareNorm (n : Nat, x : Set) : Set := vecDot(realRing, n, x, x)

-- The real n × n matrices, and the linear map x ↦ A x of ℝⁿ.
def realMatrices (n : Nat) : Set := matrixSpace(realRing, n, n)
def realLinearMap (n : Nat, A : Set) : Set := mulVecMap(realRing, n, n, A)
def realDet (n : Nat, A : Set) : Set := matDet(realRing, n, A)

-- A is orthogonal: Aᵀ A = 1.
predicate OrthogonalMatrix (n : Nat, A : Set) :=
  A ∈ realMatrices(n) ∧
  matMul(realRing, n, n, n, matTranspose(realRing, n, n, A), A) = matOne(realRing, n)

-- Composites with substitutions: x ↦ g(A x), x ↦ g(x + c), x ↦ g(−x),
-- and on ℝ, x ↦ g(c x) and x ↦ g(x + c).
def linearSubstitution (g : Set, n : Nat, A : Set) : Set :=
  { (x, g(mulVec(realRing, n, n, A, x))) | x ∈ functionSpace(n, ℝ) }
def vectorTranslateMap (g : Set, n : Nat, c : Set) : Set :=
  { (x, g(vectorAdd(n, x, c))) | x ∈ functionSpace(n, ℝ) }
def vectorReflectMap (g : Set, n : Nat) : Set :=
  { (x, g(vectorScale(n, R[-1], x))) | x ∈ functionSpace(n, ℝ) }
def realScaleSubstitution (g : Set, c : Real) : Set := { (X, g(R[c * X])) | X ∈ ℝ }
def realShiftSubstitution (g : Set, c : Real) : Set := { (X, g(R[X + c])) | X ∈ ℝ }
def realReflectSubstitution (g : Set, c : Real) : Set := { (X, g(R[c - X])) | X ∈ ℝ }

-- The Jacobian factor |det J(x)| · g(f(x)), in [0, ∞] and in ℂ, and the
-- one-variable factor |f'(x)| g(f(x)).
def jacobianLIntegrand (g f J : Set, n : Nat, U : Set) : Set :=
  { (x, ennMul(abs(realDet(n, J(x))), g(f(x)))) | x ∈ U }
def jacobianIntegrand (g f J : Set, n : Nat, U : Set) : Set :=
  { (x, ℂ[complexOfReal(abs(realDet(n, J(x)))) * g(f(x))]) | x ∈ U }
def derivativeIntegrand (g f d U : Set) : Set :=
  { (X, ℂ[complexOfReal(abs(d(X))) * g(f(X))]) | X ∈ U }

-- The principal power z^w = exp(w log z) for z ≠ 0 (Mathlib's cpow).
def complexPrincipalPow (z w : Set) : Set := complexExp(ℂ[w * complexLog(z)])

-- Gaussians: x ↦ e^(−b x²) on ℝ, real and complex b; x ↦ e^(−b‖x‖²) and
-- x ↦ e^(−b‖x‖² + c⟨w, x⟩) on ℝⁿ; x ↦ e^(−Σ bᵢxᵢ² + Σ cᵢxᵢ).
def realGaussian (b : Real) : Set := { (X, realExp(R[-(b * X * X)])) | X ∈ ℝ }
def complexGaussian (b : Set) : Set :=
  { (X, complexExp(ℂ[-(b * complexOfReal(R[X * X]))])) | X ∈ ℝ }
def euclideanRealGaussian (b : Real, n : Nat) : Set :=
  { (x, realExp(R[-(b * euclideanSquareNorm(n, x))])) | x ∈ functionSpace(n, ℝ) }
def euclideanGaussian (b : Set, n : Nat) : Set :=
  { (x, complexExp(ℂ[-(b * complexOfReal(euclideanSquareNorm(n, x)))])) |
    x ∈ functionSpace(n, ℝ) }
def shiftedGaussian (b c : Set, n : Nat, w : Set) : Set :=
  { (x, complexExp(ℂ[-(b * complexOfReal(euclideanSquareNorm(n, x))) +
      c * complexOfReal(vecDot(realRing, n, w, x))])) | x ∈ functionSpace(n, ℝ) }
def diagonalGaussianTerms (b c : Set, n : Nat, x : Set) : Set :=
  { (i, ℂ[-(b(i) * complexOfReal(R[x(i) * x(i)])) + c(i) * complexOfReal(x(i))]) | i ∈ n }
def diagonalGaussianExponent (b c : Set, n : Nat, x : Set) : Set :=
  groupFiniteSum(complexAdditiveGroup, n, diagonalGaussianTerms(b, c, n, x))
def diagonalGaussian (b c : Set, n : Nat) : Set :=
  { (x, complexExp(diagonalGaussianExponent(b, c, n, x))) | x ∈ functionSpace(n, ℝ) }
def diagonalGaussianFactors (b c : Set, n : Nat) : Set :=
  { (i, ℂ[complexPrincipalPow(ℂ[complexOfReal(realPi) / b(i)], complexOfReal(R[1 / 2])) *
      complexExp(ℂ[c(i) * c(i) / (complexOfReal(R[4]) * b(i))])]) | i ∈ n }

-- Polar coordinates (Mathlib's polarCoord): (r, θ) ↦ (r cos θ, r sin θ)
-- from (0, ∞) × (−π, π) onto ℝ² minus the closed negative real axis, and
-- the factor r f(r cos θ, r sin θ).
def polarMap : Set := { (p, (R[fst(p) * realCos(snd(p))], R[fst(p) * realSin(snd(p))])) | p ∈ ℝ × ℝ }
def polarSource : Set := realIoi(realZero) × realIoo(R[-realPi], realPi)
def polarTarget : Set := (ℝ × ℝ) ∖ (realIic(realZero) × {realZero})
def polarIntegrand (f : Set) : Set :=
  { (p, ℂ[complexOfReal(fst(p)) * f(polarMap(p))]) | p ∈ ℝ × ℝ }
def polarLIntegrand (f : Set) : Set := { (p, ennMul(ennOfReal(fst(p)), f(polarMap(p)))) | p ∈ ℝ × ℝ }

-- Section: Linear maps
-- Mathlib's addHaar_image_linearMap: the image of a Borel set under A has
-- volume |det A| times its volume.
theorem euclideanVolume.image_linear (n : Nat, A S : Set)
  requires matrix : A ∈ realMatrices(n)
  requires set : MeasurableSet(euclideanMeasurableSpace(n), S)
  shows euclideanVolume(n)(valuesOn(realLinearMap(n, A), S)) =
    ennMul(abs(realDet(n, A)), euclideanVolume(n)(S))
proof
  sorry

-- Mathlib's addHaar_preimage_linearMap.
theorem euclideanVolume.preimage_linear (n : Nat, A S : Set)
  requires matrix : A ∈ realMatrices(n)
  requires invertible : realDet(n, A) ≠ realZero
  requires set : MeasurableSet(euclideanMeasurableSpace(n), S)
  shows euclideanVolume(n)(functionPreimage(realLinearMap(n, A), functionSpace(n, ℝ), S)) =
    ennMul(abs(realInvValue(realDet(n, A))), euclideanVolume(n)(S))
proof
  sorry

-- Mathlib's map_linearMap_addHaar_eq_smul_addHaar.
theorem euclideanVolume.map_linear (n : Nat, A : Set)
  requires matrix : A ∈ realMatrices(n)
  requires invertible : realDet(n, A) ≠ realZero
  shows mapMeasure(realLinearMap(n, A), euclideanMeasurableSpace(n), euclideanVolume(n),
      euclideanMeasurableSpace(n)) =
    smulMeasure(abs(realInvValue(realDet(n, A))), euclideanMeasurableSpace(n),
      euclideanVolume(n))
proof
  sorry

-- Mathlib's Measure.integral_comp_linearMap form: ∫ g(A x) dx =
-- |det A|⁻¹ ∫ g.
theorem complexMeasureIntegral.linear_substitution (g : Set, n : Nat, A : Set)
  requires matrix : A ∈ realMatrices(n)
  requires invertible : realDet(n, A) ≠ realZero
  shows complexMeasureIntegral(euclideanMeasurableSpace(n), euclideanVolume(n),
      linearSubstitution(g, n, A)) =
    ℂ[complexOfReal(abs(realInvValue(realDet(n, A)))) *
      complexMeasureIntegral(euclideanMeasurableSpace(n), euclideanVolume(n), g)]
proof
  sorry

theorem ComplexIntegrable.linear_substitution (g : Set, n : Nat, A : Set)
  requires matrix : A ∈ realMatrices(n)
  requires invertible : realDet(n, A) ≠ realZero
  requires integrable : ComplexIntegrable(euclideanMeasurableSpace(n), euclideanVolume(n), g)
  shows ComplexIntegrable(euclideanMeasurableSpace(n), euclideanVolume(n),
    linearSubstitution(g, n, A))
proof
  sorry

-- Orthogonal maps preserve Lebesgue measure (Mathlib's
-- LinearIsometryEquiv.measurePreserving, LinearIsometry.integral_comp_comm).
theorem OrthogonalMatrix.measure_preserving (n : Nat, A : Set)
  requires orthogonal : OrthogonalMatrix(n, A)
  shows MeasurePreserving(realLinearMap(n, A), euclideanMeasurableSpace(n),
    euclideanVolume(n), euclideanMeasurableSpace(n), euclideanVolume(n))
proof
  sorry

theorem OrthogonalMatrix.det_abs (n : Nat, A : Set)
  requires orthogonal : OrthogonalMatrix(n, A)
  shows abs(realDet(n, A)) = realOne
proof
  sorry

-- Translations and the reflection x ↦ −x (Mathlib's
-- integral_add_right_eq_self, integral_sub_left_eq_self,
-- integral_neg_eq_self, measurePreserving_add_right).
theorem complexMeasureIntegral.translate (g : Set, n : Nat, c : Set)
  requires vector : c ∈ functionSpace(n, ℝ)
  shows complexMeasureIntegral(euclideanMeasurableSpace(n), euclideanVolume(n),
      vectorTranslateMap(g, n, c)) =
    complexMeasureIntegral(euclideanMeasurableSpace(n), euclideanVolume(n), g)
proof
  sorry

theorem complexMeasureIntegral.reflect (g : Set, n : Nat)
  shows complexMeasureIntegral(euclideanMeasurableSpace(n), euclideanVolume(n),
      vectorReflectMap(g, n)) =
    complexMeasureIntegral(euclideanMeasurableSpace(n), euclideanVolume(n), g)
proof
  sorry

theorem lintegral.translate (g : Set, n : Nat, c : Set)
  requires vector : c ∈ functionSpace(n, ℝ)
  requires values : EnnValued(euclideanMeasurableSpace(n), g)
  shows lintegral(euclideanMeasurableSpace(n), euclideanVolume(n),
      vectorTranslateMap(g, n, c)) =
    lintegral(euclideanMeasurableSpace(n), euclideanVolume(n), g)
proof
  sorry

-- On ℝ (Mathlib's Measure.integral_comp_mul_left, integral_add_right_eq_self,
-- integral_sub_left_eq_self, intervalIntegral.integral_comp_mul_left).
theorem complexMeasureIntegral.real_scale (g : Set, c : Real)
  requires nonzero : c ≠ realZero
  shows complexMeasureIntegral(realMeasurableSpace, realVolume, realScaleSubstitution(g, c)) =
    ℂ[complexOfReal(realInvValue(abs(c))) *
      complexMeasureIntegral(realMeasurableSpace, realVolume, g)]
proof
  sorry

theorem complexMeasureIntegral.real_shift (g : Set, c : Real)
  shows complexMeasureIntegral(realMeasurableSpace, realVolume, realShiftSubstitution(g, c)) =
      complexMeasureIntegral(realMeasurableSpace, realVolume, g) ∧
    complexMeasureIntegral(realMeasurableSpace, realVolume, realReflectSubstitution(g, c)) =
      complexMeasureIntegral(realMeasurableSpace, realVolume, g)
proof
  sorry

theorem complexIntervalIntegral.scale (g : Set, A B c : Real)
  requires nonzero : c ≠ realZero
  shows complexIntervalIntegral(realScaleSubstitution(g, c), A, B) =
    ℂ[complexOfReal(realInvValue(c)) * complexIntervalIntegral(g, R[c * A], R[c * B])]
proof
  sorry

theorem complexIntervalIntegral.shift (g : Set, A B c : Real)
  shows complexIntervalIntegral(realShiftSubstitution(g, c), A, B) =
    complexIntervalIntegral(g, R[A + c], R[B + c])
proof
  sorry

-- Section: Change of variables for differentiable maps
-- Mathlib's lintegral_image_eq_lintegral_abs_det_fderiv_mul: for f
-- injective on an open set U with derivative J(x) (a matrix) at each
-- x ∈ U, ∫⁻ over f(U) of g is ∫⁻ over U of |det J(x)| g(f(x)).
theorem lintegral.change_of_variables (f g J U : Set, n : Nat)
  requires open : U ∈ TopologicalSpace.opens(euclideanTopology(n))
  requires injective : InjectiveBetween(f, U, functionSpace(n, ℝ))
  requires derivative : ∀ x ∈ U, J(x) ∈ realMatrices(n) ∧
    HasFDerivAt(f, euclideanSpace(n), euclideanNormMap(n), euclideanSpace(n),
      euclideanNormMap(n), realRing, realLinearMap(n, J(x)), x)
  requires values : EnnValued(euclideanMeasurableSpace(n), g)
  shows setLIntegral(euclideanMeasurableSpace(n), euclideanVolume(n), g, valuesOn(f, U)) =
    setLIntegral(euclideanMeasurableSpace(n), euclideanVolume(n),
      jacobianLIntegrand(g, f, J, n, U), U)
proof
  sorry

-- Mathlib's addHaar_image_le_lintegral_abs_det_fderiv and the measure of
-- the image: vol(f(U)) = ∫_U |det J|.
theorem euclideanVolume.image_differentiable (f J U : Set, n : Nat)
  requires open : U ∈ TopologicalSpace.opens(euclideanTopology(n))
  requires injective : InjectiveBetween(f, U, functionSpace(n, ℝ))
  requires derivative : ∀ x ∈ U, J(x) ∈ realMatrices(n) ∧
    HasFDerivAt(f, euclideanSpace(n), euclideanNormMap(n), euclideanSpace(n),
      euclideanNormMap(n), realRing, realLinearMap(n, J(x)), x)
  shows euclideanVolume(n)(valuesOn(f, U)) =
    setLIntegral(euclideanMeasurableSpace(n), euclideanVolume(n),
      jacobianLIntegrand(constantOn(functionSpace(n, ℝ), realOne), f, J, n, U), U)
proof
  sorry

-- Mathlib's integrableOn_image_iff_integrableOn_abs_det_fderiv_smul and
-- integral_image_eq_integral_abs_det_fderiv_smul.
theorem complexSetIntegral.change_of_variables (f g J U : Set, n : Nat)
  requires open : U ∈ TopologicalSpace.opens(euclideanTopology(n))
  requires injective : InjectiveBetween(f, U, functionSpace(n, ℝ))
  requires derivative : ∀ x ∈ U, J(x) ∈ realMatrices(n) ∧
    HasFDerivAt(f, euclideanSpace(n), euclideanNormMap(n), euclideanSpace(n),
      euclideanNormMap(n), realRing, realLinearMap(n, J(x)), x)
  shows (ComplexIntegrableOn(euclideanMeasurableSpace(n), euclideanVolume(n), g,
        valuesOn(f, U)) ↔
      ComplexIntegrableOn(euclideanMeasurableSpace(n), euclideanVolume(n),
        jacobianIntegrand(g, f, J, n, U), U)) ∧
    complexSetIntegral(euclideanMeasurableSpace(n), euclideanVolume(n), g, valuesOn(f, U)) =
      complexSetIntegral(euclideanMeasurableSpace(n), euclideanVolume(n),
        jacobianIntegrand(g, f, J, n, U), U)
proof
  sorry

-- The one-variable form (Mathlib's integral_image_eq_integral_abs_deriv_smul):
-- f injective on an open U ⊆ ℝ with derivative d(x).
theorem complexSetIntegral.change_of_variables_real (f g d U : Set)
  requires open : U ∈ TopologicalSpace.opens(realLine)
  requires injective : InjectiveBetween(f, U, ℝ)
  requires derivative : ∀ X ∈ U, HasDerivativeAt(f, d(X), X)
  shows complexSetIntegral(realMeasurableSpace, realVolume, g, valuesOn(f, U)) =
    complexSetIntegral(realMeasurableSpace, realVolume, derivativeIntegrand(g, f, d, U), U)
proof
  sorry

-- Mathlib's integral_comp_exp_Ioi... in the form used: substituting
-- x = e^t, ∫_{(0,∞)} g = ∫_ℝ e^t g(e^t).
theorem complexSetIntegral.exp_substitution (g : Set)
  shows complexSetIntegral(realMeasurableSpace, realVolume, g, realIoi(realZero)) =
    complexMeasureIntegral(realMeasurableSpace, realVolume,
      derivativeIntegrand(g, realExp, realExp, ℝ))
proof
  sorry

-- Section: Gaussian integrals
-- Mathlib's integral_gaussian: ∫ e^(−b x²) dx = √(π / b) for b > 0.
theorem realGaussian.integral (b : Real)
  requires positive : realZero < b
  shows RealIntegrable(realMeasurableSpace, realVolume, realGaussian(b)) ∧
    realMeasureIntegral(realMeasurableSpace, realVolume, realGaussian(b)) =
      realSqrt(R[realPi / b])
proof
  sorry

-- Mathlib's integral_gaussian_complex: for re b > 0 the integral is the
-- principal square root (π / b)^(1/2).
theorem complexGaussian.integral (b : Set)
  requires member : b ∈ complexCarrier
  requires positive : realZero < complexRe(b)
  shows ComplexIntegrable(realMeasurableSpace, realVolume, complexGaussian(b)) ∧
    complexMeasureIntegral(realMeasurableSpace, realVolume, complexGaussian(b)) =
      complexPrincipalPow(ℂ[complexOfReal(realPi) / b], complexOfReal(R[1 / 2]))
proof
  sorry

-- Mathlib's GaussianFourier.integral_rexp_neg_mul_sq_norm and
-- integral_cexp_neg_mul_sq_norm: on ℝⁿ, (π / b)^(n/2).
theorem euclideanRealGaussian.integral (b : Real, n : Nat)
  requires positive : realZero < b
  shows RealIntegrable(euclideanMeasurableSpace(n), euclideanVolume(n),
      euclideanRealGaussian(b, n)) ∧
    realMeasureIntegral(euclideanMeasurableSpace(n), euclideanVolume(n),
      euclideanRealGaussian(b, n)) = realRpow(R[realPi / b], R[realNat(n) / 2])
proof
  sorry

theorem euclideanGaussian.integral (b : Set, n : Nat)
  requires member : b ∈ complexCarrier
  requires positive : realZero < complexRe(b)
  shows ComplexIntegrable(euclideanMeasurableSpace(n), euclideanVolume(n),
      euclideanGaussian(b, n)) ∧
    complexMeasureIntegral(euclideanMeasurableSpace(n), euclideanVolume(n),
      euclideanGaussian(b, n)) =
      complexPrincipalPow(ℂ[complexOfReal(realPi) / b], complexOfReal(R[realNat(n) / 2]))
proof
  sorry

-- Mathlib's GaussianFourier.integral_cexp_neg_mul_sq_norm_add:
-- ∫ e^(−b‖x‖² + c⟨w, x⟩) = (π / b)^(n/2) e^(c² ‖w‖² / (4b)).
theorem shiftedGaussian.integral (b c : Set, n : Nat, w : Set)
  requires memberB : b ∈ complexCarrier
  requires positive : realZero < complexRe(b)
  requires memberC : c ∈ complexCarrier
  requires vector : w ∈ functionSpace(n, ℝ)
  shows ComplexIntegrable(euclideanMeasurableSpace(n), euclideanVolume(n),
      shiftedGaussian(b, c, n, w)) ∧
    complexMeasureIntegral(euclideanMeasurableSpace(n), euclideanVolume(n),
      shiftedGaussian(b, c, n, w)) =
      ℂ[complexPrincipalPow(ℂ[complexOfReal(realPi) / b], complexOfReal(R[realNat(n) / 2])) *
        complexExp(ℂ[c * c * complexOfReal(euclideanSquareNorm(n, w)) /
          (complexOfReal(R[4]) * b)])]
proof
  sorry

-- Mathlib's GaussianFourier.integral_cexp_neg_mul_sum_add: with a
-- separate coefficient on each coordinate the integral is the product of
-- the one-variable ones.
theorem diagonalGaussian.integral (b c : Set, n : Nat)
  requires memberB : ∀ i ∈ n, b(i) ∈ complexCarrier ∧ realZero < complexRe(b(i))
  requires memberC : ∀ i ∈ n, c(i) ∈ complexCarrier
  shows ComplexIntegrable(euclideanMeasurableSpace(n), euclideanVolume(n),
      diagonalGaussian(b, c, n)) ∧
    complexMeasureIntegral(euclideanMeasurableSpace(n), euclideanVolume(n),
      diagonalGaussian(b, c, n)) = complexFiniteProduct(n, diagonalGaussianFactors(b, c, n))
proof
  sorry

-- Section: Polar coordinates
theorem polarMap.injective
  shows InjectiveBetween(polarMap, polarSource, ℝ × ℝ) ∧
    valuesOn(polarMap, polarSource) = polarTarget
proof
  sorry

-- The complement of the target is null (polarCoord_target_ae).
theorem polarTarget.conull
  shows AlmostEverywhere(complexMeasurableSpace, complexVolume, polarTarget)
proof
  sorry

-- The polar map is (r, θ) ↦ r e^(iθ) in ℂ.
theorem polarMap.complex_exp (p : Set)
  requires member : p ∈ ℝ × ℝ
  shows polarMap(p) =
    ℂ[complexOfReal(fst(p)) * complexExp(ℂ[complexImaginaryUnit * complexOfReal(snd(p))])]
proof
  sorry

-- Mathlib's integral_comp_polarCoord_symm and lintegral_comp_polarCoord_symm.
theorem complexMeasureIntegral.polar (f : Set)
  shows complexMeasureIntegral(complexMeasurableSpace, complexVolume, f) =
    complexSetIntegral(complexMeasurableSpace, complexVolume, polarIntegrand(f), polarSource)
proof
  sorry

theorem lintegral.polar (f : Set)
  requires values : EnnValued(complexMeasurableSpace, f)
  shows lintegral(complexMeasurableSpace, complexVolume, f) =
    setLIntegral(complexMeasurableSpace, complexVolume, polarLIntegrand(f), polarSource)
proof
  sorry

end ChangeOfVariables
