-- Haar measure on locally compact groups: left- and right-invariant and
-- inversion-invariant measures on the Borel sets of a topological group;
-- Haar measures (left invariant, finite on compact sets, positive on open
-- sets), their existence and uniqueness up to a positive factor, the Haar
-- measure normalized on a compact set; invariance of integrals under
-- translation and inversion; the modular function and unimodular groups;
-- the modulus of an automorphism, with |det| on ℝⁿ; Lebesgue measure as
-- the Haar measure of ℝⁿ; convolution of measures and Dirac measures; and
-- quotients by countable subgroups: fundamental domains, the unfolding of
-- integrals, the quotient measure and Minkowski's lattice point theorem.
-- Part of the GRH blueprint.
-- Planned home: MeasureTheory/Measure/Haar.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Measure.Haar
import GRH.Measure.ChangeOfVariables

section HaarMeasure
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- Section: Definitions
-- Translates g A, A g and the inverse A⁻¹ of a subset of a group (written
-- multiplicatively; an additive group has its addition in the mul slot).
def leftTranslate (G g A : Set) : Set := { Group.mul(G)(g, a) | a ∈ A }
def rightTranslate (G A g : Set) : Set := { Group.mul(G)(a, g) | a ∈ A }
def inverseSet (G A : Set) : Set := { Group.inv(G)(a) | a ∈ A }

-- Invariance of a measure μ on the Borel sets of the space X of G
-- (Mathlib's IsMulLeftInvariant, IsMulRightInvariant, IsInvInvariant).
predicate LeftInvariant (G X μ : Set) :=
  ∀ g ∈ Group.carrier(G), ∀ A ∈ borelSigma(X), μ(leftTranslate(G, g, A)) = μ(A)
predicate RightInvariant (G X μ : Set) :=
  ∀ g ∈ Group.carrier(G), ∀ A ∈ borelSigma(X), μ(rightTranslate(G, A, g)) = μ(A)
predicate InversionInvariant (G X μ : Set) :=
  ∀ A ∈ borelSigma(X), μ(inverseSet(G, A)) = μ(A)

-- A Haar measure (Mathlib's IsHaarMeasure): left invariant, finite on
-- compact sets, positive on nonempty open sets; a regular one is also
-- outer and inner regular (Measure.Regular).
predicate HaarMeasure (G X μ : Set) :=
  TopologicalGroup(G, X) ∧ Measure(borelSpace(X), μ) ∧ LeftInvariant(G, X, μ) ∧
  FiniteOnCompacts(X, μ) ∧ OpenPositive(X, μ)
predicate RegularHaarMeasure (G X μ : Set) := HaarMeasure(G, X, μ) ∧ RegularMeasure(X, μ)

-- A locally compact Hausdorff group; a second-countable space.
predicate LocallyCompactGroup (G X : Set) :=
  TopologicalGroup(G, X) ∧ LocallyCompact(X) ∧ Hausdorff(X)
predicate SecondCountable (X : Set) :=
  TopologicalSpace(X) ∧ ∃ B ⊆ TopologicalSpace.opens(X), Countable(B) ∧
    (∀ U ∈ TopologicalSpace.opens(X), ∀ x ∈ U, ∃ V ∈ B, x ∈ V ∧ V ⊆ U)

-- The regular Haar measure taking the value 1 on the compact set K with
-- nonempty interior (Mathlib's haarMeasure K₀); unique, so no choice is
-- made.
def haarMeasureNormalized (G X K : Set) : Set :=
  ⋃({ μ ∈ 𝒫(borelSigma(X) × ennreal) | RegularHaarMeasure(G, X, μ) ∧ μ(K) = realOne })

-- The factor c > 0 with ν = c μ (Mathlib's haarScalarFactor).
def haarScalarFactor (X μ ν : Set) : Set :=
  ⋃({ c ∈ ℝ | realZero < c ∧ ν = smulMeasure(c, borelSpace(X), μ) })

-- The modular function Δ: the factor with μ(A g⁻¹) = Δ(g) μ(A) for every
-- regular Haar measure μ, that is, the push-forward of μ along x ↦ x g is
-- Δ(g) μ (Mathlib's modularCharacterFun and
-- map_right_mul_eq_modularCharacterFun_smul).
def modularFunction (G X g : Set) : Set :=
  ⋃({ c ∈ ℝ | realZero < c ∧ ∀ μ, RegularHaarMeasure(G, X, μ) →
    ∀ A ∈ borelSigma(X), μ(rightTranslate(G, A, Group.inv(G)(g))) = ennMul(c, μ(A)) })
def modularFunctionGraph (G X : Set) : Set :=
  { (g, modularFunction(G, X, g)) | g ∈ Group.carrier(G) }
predicate Unimodular (G X : Set) :=
  ∀ g ∈ Group.carrier(G), modularFunction(G, X, g) = realOne

-- A topological automorphism of G: a group automorphism that is a
-- homeomorphism of X (Mathlib's G ≃ₜ* G); its modulus, the factor with
-- μ(φ(A)) = mod(φ) μ(A) for every regular Haar measure (Mathlib's
-- mulEquivHaarChar, and distribHaarChar for x ↦ g • x).
predicate TopologicalAutomorphism (φ G X : Set) :=
  BijectiveBetween(φ, Group.carrier(G), Group.carrier(G)) ∧
  (∀ a ∈ Group.carrier(G), ∀ b ∈ Group.carrier(G),
    φ(Group.mul(G)(a, b)) = Group.mul(G)(φ(a), φ(b))) ∧
  φ : X ⇒ X ∧
  converse(φ, Group.carrier(G), Group.carrier(G)) : X ⇒ X
def automorphismModulus (G X φ : Set) : Set :=
  ⋃({ c ∈ ℝ | realZero < c ∧ ∀ μ, RegularHaarMeasure(G, X, μ) →
    ∀ A ∈ borelSigma(X), μ(valuesOn(φ, A)) = ennMul(c, μ(A)) })

-- Translated and inverted maps: x ↦ f(g x), x ↦ f(x g), x ↦ f(x⁻¹),
-- x ↦ f(g x⁻¹).
def leftTranslateMap (G f g : Set) : Set :=
  { (x, f(Group.mul(G)(g, x))) | x ∈ Group.carrier(G) }
def rightTranslateMap (G f g : Set) : Set :=
  { (x, f(Group.mul(G)(x, g))) | x ∈ Group.carrier(G) }
def inverseMap (G f : Set) : Set := { (x, f(Group.inv(G)(x))) | x ∈ Group.carrier(G) }
def divLeftMap (G f g : Set) : Set :=
  { (x, f(Group.mul(G)(g, Group.inv(G)(x)))) | x ∈ Group.carrier(G) }

-- The maps x ↦ g x, (x, y) ↦ (x, x y), (x, y) ↦ (x, x⁻¹ y), and the
-- multiplication (x, y) ↦ x y.
def leftMultiplication (G g : Set) : Set := { (x, Group.mul(G)(g, x)) | x ∈ Group.carrier(G) }
def shearMap (G : Set) : Set :=
  { (p, (fst(p), Group.mul(G)(fst(p), snd(p)))) | p ∈ Group.carrier(G) × Group.carrier(G) }
def inverseShearMap (G : Set) : Set :=
  { (p, (fst(p), Group.mul(G)(Group.inv(G)(fst(p)), snd(p)))) |
    p ∈ Group.carrier(G) × Group.carrier(G) }
def multiplicationMap (G : Set) : Set :=
  { (p, Group.mul(G)(fst(p), snd(p))) | p ∈ Group.carrier(G) × Group.carrier(G) }

-- The Borel space of a group's product with itself: its Borel σ-algebra is
-- the product σ-algebra when X is second countable.
def productBorel (X : Set) : Set := productMeasurableSpace(borelSpace(X), borelSpace(X))

-- Convolution of measures μ * ν: the push-forward of μ × ν along the
-- multiplication (Mathlib's Measure.mconv).
def convolutionMeasure (G X μ ν : Set) : Set :=
  mapMeasure(multiplicationMap(G), productBorel(X),
    productMeasure(borelSpace(X), μ, borelSpace(X), ν), borelSpace(X))

-- The double integrand (x, y) ↦ f(x y), in [0, ∞] and in ℂ.
def productIntegrandOf (G f : Set) : Set :=
  { (p, f(Group.mul(G)(fst(p), snd(p)))) | p ∈ Group.carrier(G) × Group.carrier(G) }

-- ℝⁿ as an additive topological group, its standard cube [0, 1]ⁿ, and the
-- parallelepiped spanned by the columns of B (Mathlib's
-- parallelepiped of a basis).
def euclideanAdditiveGroup (n : Nat) : Set := Module.additive(euclideanSpace(n))
def unitCube (n : Nat) : Set := boxSet(n, zeroVector(n), n × {realOne})
def parallelepiped (n : Nat, B : Set) : Set := valuesOn(realLinearMap(n, B), unitCube(n))

-- Section: Quotients by countable subgroups
-- F is a fundamental domain of the subgroup Γ acting by left
-- multiplication: F is Borel, its translates γ F cover G up to a null set
-- and meet pairwise in null sets (Mathlib's IsFundamentalDomain).
def translatesOf (G Γ F : Set) : Set := { leftTranslate(G, γ, F) | γ ∈ Γ }
predicate FundamentalDomain (G X μ Γ F : Set) :=
  F ∈ borelSigma(X) ∧
  AlmostEverywhere(borelSpace(X), μ, ⋃(translatesOf(G, Γ, F))) ∧
  (∀ γ ∈ Γ, ∀ δ ∈ Γ, γ ≠ δ →
    NullSet(borelSpace(X), μ, leftTranslate(G, γ, F) ∩ leftTranslate(G, δ, F)))

-- The orbit sums x ↦ Σ_{γ ∈ Γ} f(γ x) in [0, ∞] and in ℂ, and the
-- family γ ↦ ∫⁻_F f(γ x) dμ(x).
def orbitValues (G Γ f x : Set) : Set := { (γ, f(Group.mul(G)(γ, x))) | γ ∈ Γ }
def ennOrbitSum (G Γ f : Set) : Set :=
  { (x, ennTsum(orbitValues(G, Γ, f, x), Γ)) | x ∈ Group.carrier(G) }
def complexOrbitSum (G Γ f : Set) : Set :=
  { (x, complexTsum(orbitValues(G, Γ, f, x), Γ)) | x ∈ Group.carrier(G) }
def translatedLIntegrals (G X μ Γ f F : Set) : Set :=
  { (γ, setLIntegral(borelSpace(X), μ, leftTranslateMap(G, f, γ), F)) | γ ∈ Γ }
def translatedIntegrals (G X μ Γ f F : Set) : Set :=
  { (γ, complexSetIntegral(borelSpace(X), μ, leftTranslateMap(G, f, γ), F)) | γ ∈ Γ }

-- The quotient Γ\G with the quotient topology (by the right-coset
-- relation of the left action), the class map, and the quotient measure:
-- the push-forward of μ restricted to a fundamental domain (Mathlib's
-- QuotientGroup measure from a fundamental domain).
def leftCosetRelation (G Γ : Set) : Set :=
  { p ∈ Group.carrier(G) × Group.carrier(G) |
    ∃ γ ∈ Γ, snd(p) = Group.mul(G)(γ, fst(p)) }
def cosetSpace (G X Γ : Set) : Set := quotientSpace(X, leftCosetRelation(G, Γ))
def cosetProjection (G Γ : Set) : Set :=
  quotientProjection(Group.carrier(G), leftCosetRelation(G, Γ))
def quotientMeasure (G X μ Γ F : Set) : Set :=
  mapMeasure(cosetProjection(G, Γ), borelSpace(X), restrictMeasure(borelSpace(X), μ, F),
    borelSpace(cosetSpace(G, X, Γ)))

-- A subset of ℝⁿ is convex and symmetric about 0.
predicate ConvexSymmetric (n : Nat, S : Set) :=
  S ⊆ functionSpace(n, ℝ) ∧
  (∀ x ∈ S, vectorScale(n, R[-1], x) ∈ S) ∧
  (∀ x ∈ S, ∀ y ∈ S, ∀ t ∈ realIcc(realZero, realOne),
    vectorAdd(n, vectorScale(n, t, x), vectorScale(n, R[1 - t], y)) ∈ S)

-- Section: Existence and uniqueness
-- Every locally compact Hausdorff group has a regular Haar measure
-- (Mathlib's haarMeasure and isHaarMeasure_haarMeasure).
theorem RegularHaarMeasure.exists (G X : Set)
  requires group : LocallyCompactGroup(G, X)
  shows ∃ μ, RegularHaarMeasure(G, X, μ)
proof
  sorry

-- Uniqueness up to a positive factor (Mathlib's
-- isMulLeftInvariant_eq_smul_of_regular, haarMeasure_unique).
theorem RegularHaarMeasure.unique (G X μ ν : Set)
  requires group : LocallyCompactGroup(G, X)
  requires first : RegularHaarMeasure(G, X, μ)
  requires second : RegularHaarMeasure(G, X, ν)
  shows realZero < haarScalarFactor(X, μ, ν) ∧
    ν = smulMeasure(haarScalarFactor(X, μ, ν), borelSpace(X), μ)
proof
  sorry

-- In a second-countable group every left-invariant measure finite on
-- compacts is a multiple of a Haar measure (Mathlib's
-- isMulLeftInvariant_eq_smul).
theorem HaarMeasure.unique_second_countable (G X μ ν : Set)
  requires group : LocallyCompactGroup(G, X)
  requires countable : SecondCountable(X)
  requires haar : HaarMeasure(G, X, μ)
  requires measure : Measure(borelSpace(X), ν)
  requires invariant : LeftInvariant(G, X, ν)
  requires finite : FiniteOnCompacts(X, ν)
  shows ∃ c ∈ ℝ, realZero ≤ c ∧ ν = smulMeasure(c, borelSpace(X), μ)
proof
  sorry

theorem HaarMeasure.regular_of_second_countable (G X μ : Set)
  requires group : LocallyCompactGroup(G, X)
  requires countable : SecondCountable(X)
  requires haar : HaarMeasure(G, X, μ)
  shows RegularHaarMeasure(G, X, μ)
proof
  sorry

-- Mathlib's haarMeasure_self and isHaarMeasure_haarMeasure.
theorem haarMeasureNormalized.haar (G X K : Set)
  requires group : LocallyCompactGroup(G, X)
  requires compact : Compact(X, K)
  requires inside : K ⊆ TopologicalSpace.carrier(X)
  requires interior : ∃ U ∈ TopologicalSpace.opens(X), U ≠ ∅ ∧ U ⊆ K
  shows RegularHaarMeasure(G, X, haarMeasureNormalized(G, X, K)) ∧
    haarMeasureNormalized(G, X, K)(K) = realOne
proof
  sorry

-- Mathlib's IsHaarMeasure.smul.
theorem HaarMeasure.smul (G X μ : Set, c : Real)
  requires haar : HaarMeasure(G, X, μ)
  requires positive : realZero < c
  shows HaarMeasure(G, X, smulMeasure(c, borelSpace(X), μ))
proof
  sorry

-- Mathlib's IsOpen.measure_pos, measure_pos_of_mem_nhds,
-- IsCompact.measure_lt_top.
theorem HaarMeasure.neighborhood_positive (G X μ x N : Set)
  requires haar : HaarMeasure(G, X, μ)
  requires neighborhood : N ∈ nhds(X, x)
  requires set : N ∈ borelSigma(X)
  requires member : x ∈ TopologicalSpace.carrier(X)
  shows μ(N) ≠ realZero
proof
  sorry

theorem HaarMeasure.compact_finite (G X μ K : Set)
  requires haar : HaarMeasure(G, X, μ)
  requires compact : Compact(X, K)
  requires set : K ∈ borelSigma(X)
  shows μ(K) ≠ ennTop
proof
  sorry

-- A compact group has finite Haar measure, which can be normalized to a
-- probability measure.
theorem HaarMeasure.compact_group (G X μ : Set)
  requires haar : HaarMeasure(G, X, μ)
  requires compact : Compact(X)
  requires hausdorff : Hausdorff(X)
  shows μ(TopologicalSpace.carrier(X)) ≠ ennTop ∧ μ(TopologicalSpace.carrier(X)) ≠ realZero
proof
  sorry

-- On a discrete group the Haar measures are the positive multiples of the
-- counting measure (Mathlib's Measure.count is a Haar measure).
theorem HaarMeasure.discrete (G X μ : Set)
  requires topological : TopologicalGroup(G, X)
  requires discrete : DiscreteTopology(X)
  requires haar : HaarMeasure(G, X, μ)
  shows ∃ c ∈ ℝ, realZero < c ∧ μ = smulMeasure(c, borelSpace(X), countMeasure(borelSpace(X)))
proof
  sorry

theorem countMeasure.haar (G X : Set)
  requires topological : TopologicalGroup(G, X)
  requires discrete : DiscreteTopology(X)
  shows RegularHaarMeasure(G, X, countMeasure(borelSpace(X)))
proof
  sorry

-- Section: Invariance of integrals
-- Mathlib's lintegral_mul_left_eq_self and integral_mul_left_eq_self:
-- no measurability is needed for a left-invariant measure.
theorem lintegral.mul_left (G X μ f g : Set)
  requires topological : TopologicalGroup(G, X)
  requires measure : Measure(borelSpace(X), μ)
  requires invariant : LeftInvariant(G, X, μ)
  requires member : g ∈ Group.carrier(G)
  requires values : EnnValued(borelSpace(X), f)
  shows lintegral(borelSpace(X), μ, leftTranslateMap(G, f, g)) = lintegral(borelSpace(X), μ, f)
proof
  sorry

theorem complexMeasureIntegral.mul_left (G X μ f g : Set)
  requires topological : TopologicalGroup(G, X)
  requires measure : Measure(borelSpace(X), μ)
  requires invariant : LeftInvariant(G, X, μ)
  requires member : g ∈ Group.carrier(G)
  shows complexMeasureIntegral(borelSpace(X), μ, leftTranslateMap(G, f, g)) =
    complexMeasureIntegral(borelSpace(X), μ, f)
proof
  sorry

-- Mathlib's lintegral_mul_right_eq_self and integral_mul_right_eq_self.
theorem lintegral.mul_right (G X μ f g : Set)
  requires topological : TopologicalGroup(G, X)
  requires measure : Measure(borelSpace(X), μ)
  requires invariant : RightInvariant(G, X, μ)
  requires member : g ∈ Group.carrier(G)
  requires values : EnnValued(borelSpace(X), f)
  shows lintegral(borelSpace(X), μ, rightTranslateMap(G, f, g)) = lintegral(borelSpace(X), μ, f)
proof
  sorry

theorem complexMeasureIntegral.mul_right (G X μ f g : Set)
  requires topological : TopologicalGroup(G, X)
  requires measure : Measure(borelSpace(X), μ)
  requires invariant : RightInvariant(G, X, μ)
  requires member : g ∈ Group.carrier(G)
  shows complexMeasureIntegral(borelSpace(X), μ, rightTranslateMap(G, f, g)) =
    complexMeasureIntegral(borelSpace(X), μ, f)
proof
  sorry

-- Mathlib's integral_inv_eq_self, lintegral_inv_eq_self and
-- integral_div_left_eq_self.
theorem complexMeasureIntegral.inverse (G X μ f : Set)
  requires topological : TopologicalGroup(G, X)
  requires measure : Measure(borelSpace(X), μ)
  requires invariant : InversionInvariant(G, X, μ)
  shows complexMeasureIntegral(borelSpace(X), μ, inverseMap(G, f)) =
    complexMeasureIntegral(borelSpace(X), μ, f)
proof
  sorry

theorem lintegral.inverse (G X μ f : Set)
  requires topological : TopologicalGroup(G, X)
  requires measure : Measure(borelSpace(X), μ)
  requires invariant : InversionInvariant(G, X, μ)
  requires values : EnnValued(borelSpace(X), f)
  shows lintegral(borelSpace(X), μ, inverseMap(G, f)) = lintegral(borelSpace(X), μ, f)
proof
  sorry

theorem complexMeasureIntegral.div_left (G X μ f g : Set)
  requires topological : TopologicalGroup(G, X)
  requires measure : Measure(borelSpace(X), μ)
  requires left : LeftInvariant(G, X, μ)
  requires inversion : InversionInvariant(G, X, μ)
  requires member : g ∈ Group.carrier(G)
  shows complexMeasureIntegral(borelSpace(X), μ, divLeftMap(G, f, g)) =
    complexMeasureIntegral(borelSpace(X), μ, f)
proof
  sorry

-- Mathlib's measurePreserving_mul_left, map_mul_left_eq_self and
-- forall_measure_preimage_mul_iff.
theorem LeftInvariant.measure_preserving (G X μ : Set)
  requires topological : TopologicalGroup(G, X)
  requires measure : Measure(borelSpace(X), μ)
  shows LeftInvariant(G, X, μ) ↔ (∀ h ∈ Group.carrier(G),
    MeasurePreserving(leftMultiplication(G, h), borelSpace(X), μ, borelSpace(X), μ))
proof
  sorry

theorem LeftInvariant.preimage (G X μ g A : Set)
  requires topological : TopologicalGroup(G, X)
  requires measure : Measure(borelSpace(X), μ)
  requires invariant : LeftInvariant(G, X, μ)
  requires member : g ∈ Group.carrier(G)
  requires set : A ∈ borelSigma(X)
  shows μ(functionPreimage(leftMultiplication(G, g), Group.carrier(G), A)) = μ(A)
proof
  sorry

-- Mathlib's measurePreserving_prod_mul and measurePreserving_prod_inv_mul:
-- the shears (x, y) ↦ (x, x y) and (x, y) ↦ (x, x⁻¹ y) preserve μ × ν for
-- left-invariant ν.
theorem shearMap.measure_preserving (G X μ ν : Set)
  requires topological : TopologicalGroup(G, X)
  requires countable : SecondCountable(X)
  requires first : SFinite(borelSpace(X), μ)
  requires second : SFinite(borelSpace(X), ν)
  requires invariant : LeftInvariant(G, X, ν)
  shows MeasurePreserving(shearMap(G), productBorel(X),
      productMeasure(borelSpace(X), μ, borelSpace(X), ν), productBorel(X),
      productMeasure(borelSpace(X), μ, borelSpace(X), ν)) ∧
    MeasurePreserving(inverseShearMap(G), productBorel(X),
      productMeasure(borelSpace(X), μ, borelSpace(X), ν), productBorel(X),
      productMeasure(borelSpace(X), μ, borelSpace(X), ν))
proof
  sorry

-- In an abelian group a Haar measure is right invariant, and a regular
-- one is inversion invariant (Mathlib's IsHaarMeasure.isInvInvariant_of_...).
theorem HaarMeasure.abelian (G X μ : Set)
  requires abelian : AbelianGroup(G)
  requires group : LocallyCompactGroup(G, X)
  requires haar : RegularHaarMeasure(G, X, μ)
  shows RightInvariant(G, X, μ) ∧ InversionInvariant(G, X, μ)
proof
  sorry

-- Section: The modular function
theorem modularFunction.positive (G X g : Set)
  requires group : LocallyCompactGroup(G, X)
  requires member : g ∈ Group.carrier(G)
  shows modularFunction(G, X, g) ∈ ℝ ∧ realZero < modularFunction(G, X, g)
proof
  sorry

-- Mathlib's map_right_mul_eq_modularCharacterFun_smul.
theorem modularFunction.map_right (G X μ g : Set)
  requires group : LocallyCompactGroup(G, X)
  requires haar : RegularHaarMeasure(G, X, μ)
  requires member : g ∈ Group.carrier(G)
  shows mapMeasure(rightTranslateMap(G, identity(Group.carrier(G)), g), borelSpace(X), μ,
      borelSpace(X)) = smulMeasure(modularFunction(G, X, g), borelSpace(X), μ)
proof
  sorry

-- Δ is a continuous homomorphism into the positive reals (Mathlib's
-- modularCharacter).
theorem modularFunction.mul (G X g h : Set)
  requires group : LocallyCompactGroup(G, X)
  requires memberG : g ∈ Group.carrier(G)
  requires memberH : h ∈ Group.carrier(G)
  shows modularFunction(G, X, Group.mul(G)(g, h)) =
    R[modularFunction(G, X, g) * modularFunction(G, X, h)]
proof
  sorry

theorem modularFunction.continuous (G X : Set)
  requires group : LocallyCompactGroup(G, X)
  shows modularFunctionGraph(G, X) : X ⇒ realLine
proof
  sorry

-- Right translation of integrals: ∫ f(x g) dμ(x) = Δ(g) ∫ f dμ.
theorem complexMeasureIntegral.right_translate (G X μ f g : Set)
  requires group : LocallyCompactGroup(G, X)
  requires haar : RegularHaarMeasure(G, X, μ)
  requires member : g ∈ Group.carrier(G)
  shows complexMeasureIntegral(borelSpace(X), μ, rightTranslateMap(G, f, g)) =
    ℂ[complexOfReal(modularFunction(G, X, g)) * complexMeasureIntegral(borelSpace(X), μ, f)]
proof
  sorry

-- Unimodular groups: Δ ≡ 1 exactly when Haar measures are right
-- invariant; abelian, compact and discrete groups are unimodular.
theorem Unimodular.iff_right_invariant (G X μ : Set)
  requires group : LocallyCompactGroup(G, X)
  requires haar : RegularHaarMeasure(G, X, μ)
  shows Unimodular(G, X) ↔ RightInvariant(G, X, μ)
proof
  sorry

theorem Unimodular.of_abelian (G X : Set)
  requires group : LocallyCompactGroup(G, X)
  requires abelian : AbelianGroup(G)
  shows Unimodular(G, X)
proof
  sorry

theorem Unimodular.of_compact (G X : Set)
  requires group : LocallyCompactGroup(G, X)
  requires compact : Compact(X)
  shows Unimodular(G, X)
proof
  sorry

theorem Unimodular.of_discrete (G X : Set)
  requires topological : TopologicalGroup(G, X)
  requires discrete : DiscreteTopology(X)
  shows Unimodular(G, X)
proof
  sorry

-- In a unimodular group a regular Haar measure is inversion invariant.
theorem Unimodular.inversion_invariant (G X μ : Set)
  requires group : LocallyCompactGroup(G, X)
  requires unimodular : Unimodular(G, X)
  requires haar : RegularHaarMeasure(G, X, μ)
  shows InversionInvariant(G, X, μ)
proof
  sorry

-- Section: Moduli of automorphisms
-- Mathlib's mulEquivHaarChar_pos, mulEquivHaarChar_smul_map and
-- mulEquivHaarChar_trans.
theorem automorphismModulus.positive (G X φ : Set)
  requires group : LocallyCompactGroup(G, X)
  requires automorphism : TopologicalAutomorphism(φ, G, X)
  shows automorphismModulus(G, X, φ) ∈ ℝ ∧ realZero < automorphismModulus(G, X, φ)
proof
  sorry

theorem automorphismModulus.image (G X φ μ A : Set)
  requires group : LocallyCompactGroup(G, X)
  requires automorphism : TopologicalAutomorphism(φ, G, X)
  requires haar : RegularHaarMeasure(G, X, μ)
  requires set : A ∈ borelSigma(X)
  shows μ(valuesOn(φ, A)) = ennMul(automorphismModulus(G, X, φ), μ(A))
proof
  sorry

theorem automorphismModulus.comp (G X φ ψ χ : Set)
  requires group : LocallyCompactGroup(G, X)
  requires first : TopologicalAutomorphism(φ, G, X)
  requires second : TopologicalAutomorphism(ψ, G, X)
  requires composite : ∀ x ∈ Group.carrier(G), χ(x) = ψ(φ(x))
  shows automorphismModulus(G, X, χ) =
    R[automorphismModulus(G, X, φ) * automorphismModulus(G, X, ψ)]
proof
  sorry

-- Section: Lebesgue measure as a Haar measure
theorem euclideanVolume.haar (n : Nat)
  shows RegularHaarMeasure(euclideanAdditiveGroup(n), euclideanTopology(n),
    euclideanVolume(n))
proof
  sorry

-- An invertible linear map of ℝⁿ has modulus |det A| (Mathlib's
-- addHaar_image_linearMap read as distribHaarChar).
theorem automorphismModulus.linear (n : Nat, A : Set)
  requires matrix : A ∈ realMatrices(n)
  requires invertible : realDet(n, A) ≠ realZero
  shows automorphismModulus(euclideanAdditiveGroup(n), euclideanTopology(n),
    realLinearMap(n, A)) = abs(realDet(n, A))
proof
  sorry

-- Mathlib's Basis.addHaar: the Haar measure of ℝⁿ normalized on the
-- parallelepiped of the columns of an invertible B is |det B|⁻¹ volume.
theorem haarMeasureNormalized.parallelepiped (n : Nat, B : Set)
  requires matrix : B ∈ realMatrices(n)
  requires invertible : realDet(n, B) ≠ realZero
  shows haarMeasureNormalized(euclideanAdditiveGroup(n), euclideanTopology(n),
      parallelepiped(n, B)) =
    smulMeasure(abs(realInvValue(realDet(n, B))), borelSpace(euclideanTopology(n)),
      euclideanVolume(n))
proof
  sorry

theorem euclideanVolume.unit_cube (n : Nat)
  shows euclideanVolume(n)(unitCube(n)) = realOne
proof
  sorry

-- Section: Convolution of measures
-- Mathlib's Measure.mconv_dirac_one, dirac_mconv, dirac_mconv_dirac,
-- mconv_assoc and mconv_zero.
theorem convolutionMeasure.dirac_one (G X μ : Set)
  requires topological : TopologicalGroup(G, X)
  requires countable : SecondCountable(X)
  requires finite : SFinite(borelSpace(X), μ)
  shows convolutionMeasure(G, X, μ, diracMeasure(borelSpace(X), Group.one(G))) = μ ∧
    convolutionMeasure(G, X, diracMeasure(borelSpace(X), Group.one(G)), μ) = μ
proof
  sorry

theorem convolutionMeasure.dirac_dirac (G X a b : Set)
  requires topological : TopologicalGroup(G, X)
  requires countable : SecondCountable(X)
  requires memberA : a ∈ Group.carrier(G)
  requires memberB : b ∈ Group.carrier(G)
  shows convolutionMeasure(G, X, diracMeasure(borelSpace(X), a), diracMeasure(borelSpace(X), b)) =
    diracMeasure(borelSpace(X), Group.mul(G)(a, b))
proof
  sorry

theorem convolutionMeasure.dirac_left (G X μ a : Set)
  requires topological : TopologicalGroup(G, X)
  requires countable : SecondCountable(X)
  requires finite : SFinite(borelSpace(X), μ)
  requires member : a ∈ Group.carrier(G)
  shows convolutionMeasure(G, X, diracMeasure(borelSpace(X), a), μ) =
    mapMeasure(leftMultiplication(G, a), borelSpace(X), μ, borelSpace(X))
proof
  sorry

theorem convolutionMeasure.assoc (G X μ ν ρ : Set)
  requires topological : TopologicalGroup(G, X)
  requires countable : SecondCountable(X)
  requires first : SFinite(borelSpace(X), μ)
  requires second : SFinite(borelSpace(X), ν)
  requires third : SFinite(borelSpace(X), ρ)
  shows convolutionMeasure(G, X, convolutionMeasure(G, X, μ, ν), ρ) =
    convolutionMeasure(G, X, μ, convolutionMeasure(G, X, ν, ρ))
proof
  sorry

theorem convolutionMeasure.zero (G X μ : Set)
  requires topological : TopologicalGroup(G, X)
  requires countable : SecondCountable(X)
  requires finite : SFinite(borelSpace(X), μ)
  shows convolutionMeasure(G, X, μ, zeroMeasure(borelSpace(X))) = zeroMeasure(borelSpace(X))
proof
  sorry

-- Mathlib's lintegral_mconv and integral_mconv.
theorem lintegral.convolution (G X μ ν f : Set)
  requires topological : TopologicalGroup(G, X)
  requires countable : SecondCountable(X)
  requires first : SFinite(borelSpace(X), μ)
  requires second : SFinite(borelSpace(X), ν)
  requires measurable : Measurable(f, borelSpace(X), ennMeasurableSpace)
  shows lintegral(borelSpace(X), convolutionMeasure(G, X, μ, ν), f) =
    lintegral(productBorel(X), productMeasure(borelSpace(X), μ, borelSpace(X), ν),
      productIntegrandOf(G, f))
proof
  sorry

theorem complexMeasureIntegral.convolution (G X μ ν f : Set)
  requires topological : TopologicalGroup(G, X)
  requires countable : SecondCountable(X)
  requires first : SFinite(borelSpace(X), μ)
  requires second : SFinite(borelSpace(X), ν)
  requires integrable : ComplexIntegrable(borelSpace(X), convolutionMeasure(G, X, μ, ν), f)
  shows complexMeasureIntegral(borelSpace(X), convolutionMeasure(G, X, μ, ν), f) =
    complexMeasureIntegral(productBorel(X), productMeasure(borelSpace(X), μ, borelSpace(X), ν),
      productIntegrandOf(G, f))
proof
  sorry

-- Section: Quotients
-- Mathlib's IsFundamentalDomain.lintegral_eq_tsum'': unfolding an
-- integral over G into a sum of integrals over a fundamental domain.
theorem FundamentalDomain.lintegral_unfold (G X μ Γ F f : Set)
  requires topological : TopologicalGroup(G, X)
  requires subgroup : Subgroup(Γ, G)
  requires countable : Countable(Γ)
  requires measure : Measure(borelSpace(X), μ)
  requires invariant : LeftInvariant(G, X, μ)
  requires domain : FundamentalDomain(G, X, μ, Γ, F)
  requires values : EnnValued(borelSpace(X), f)
  shows lintegral(borelSpace(X), μ, f) = ennTsum(translatedLIntegrals(G, X, μ, Γ, f, F), Γ)
proof
  sorry

-- Mathlib's IsFundamentalDomain.integral_eq_tsum''.
theorem FundamentalDomain.integral_unfold (G X μ Γ F f : Set)
  requires topological : TopologicalGroup(G, X)
  requires subgroup : Subgroup(Γ, G)
  requires countable : Countable(Γ)
  requires invariant : LeftInvariant(G, X, μ)
  requires domain : FundamentalDomain(G, X, μ, Γ, F)
  requires integrable : ComplexIntegrable(borelSpace(X), μ, f)
  shows ComplexHasSum(translatedIntegrals(G, X, μ, Γ, f, F), Γ,
    complexMeasureIntegral(borelSpace(X), μ, f))
proof
  sorry

-- The orbit sum form: ∫⁻_G f = ∫⁻_F Σ_γ f(γ x).
theorem FundamentalDomain.lintegral_orbit_sum (G X μ Γ F f : Set)
  requires topological : TopologicalGroup(G, X)
  requires subgroup : Subgroup(Γ, G)
  requires countable : Countable(Γ)
  requires invariant : LeftInvariant(G, X, μ)
  requires domain : FundamentalDomain(G, X, μ, Γ, F)
  requires measurable : Measurable(f, borelSpace(X), ennMeasurableSpace)
  shows lintegral(borelSpace(X), μ, f) =
    setLIntegral(borelSpace(X), μ, ennOrbitSum(G, Γ, f), F)
proof
  sorry

-- Any two fundamental domains have the same measure, and Γ-invariant maps
-- have the same integral over them (Mathlib's
-- IsFundamentalDomain.measure_eq, setLIntegral_eq).
theorem FundamentalDomain.measure_eq (G X μ Γ F F2 : Set)
  requires topological : TopologicalGroup(G, X)
  requires subgroup : Subgroup(Γ, G)
  requires countable : Countable(Γ)
  requires invariant : LeftInvariant(G, X, μ)
  requires first : FundamentalDomain(G, X, μ, Γ, F)
  requires second : FundamentalDomain(G, X, μ, Γ, F2)
  shows μ(F) = μ(F2)
proof
  sorry

theorem FundamentalDomain.setLIntegral_eq (G X μ Γ F F2 f : Set)
  requires topological : TopologicalGroup(G, X)
  requires subgroup : Subgroup(Γ, G)
  requires countable : Countable(Γ)
  requires invariant : LeftInvariant(G, X, μ)
  requires first : FundamentalDomain(G, X, μ, Γ, F)
  requires second : FundamentalDomain(G, X, μ, Γ, F2)
  requires values : EnnValued(borelSpace(X), f)
  requires periodic : ∀ γ ∈ Γ, ∀ x ∈ Group.carrier(G), f(Group.mul(G)(γ, x)) = f(x)
  shows setLIntegral(borelSpace(X), μ, f, F) = setLIntegral(borelSpace(X), μ, f, F2)
proof
  sorry

-- The quotient measure does not depend on the fundamental domain, and
-- integrating a map on Γ\G against it is integrating its lift over F.
theorem quotientMeasure.independent (G X μ Γ F F2 : Set)
  requires topological : TopologicalGroup(G, X)
  requires subgroup : Subgroup(Γ, G)
  requires countable : Countable(Γ)
  requires invariant : LeftInvariant(G, X, μ)
  requires first : FundamentalDomain(G, X, μ, Γ, F)
  requires second : FundamentalDomain(G, X, μ, Γ, F2)
  shows quotientMeasure(G, X, μ, Γ, F) = quotientMeasure(G, X, μ, Γ, F2)
proof
  sorry

theorem quotientMeasure.lintegral (G X μ Γ F h : Set)
  requires topological : TopologicalGroup(G, X)
  requires subgroup : Subgroup(Γ, G)
  requires countable : Countable(Γ)
  requires invariant : LeftInvariant(G, X, μ)
  requires domain : FundamentalDomain(G, X, μ, Γ, F)
  requires measurable : Measurable(h, borelSpace(cosetSpace(G, X, Γ)), ennMeasurableSpace)
  shows lintegral(borelSpace(cosetSpace(G, X, Γ)), quotientMeasure(G, X, μ, Γ, F), h) =
    setLIntegral(borelSpace(X), μ,
      composeOn(h, cosetProjection(G, Γ), Group.carrier(G)), F)
proof
  sorry

-- The class map is continuous and open, and measurable (Mathlib's
-- QuotientGroup.continuous_mk, isOpenMap_coe, measurable_coe); the
-- quotient by an open subgroup is discrete (QuotientGroup.discreteTopology).
theorem cosetProjection.continuous_open (G X Γ : Set)
  requires topological : TopologicalGroup(G, X)
  requires subgroup : Subgroup(Γ, G)
  shows cosetProjection(G, Γ) : X ⇒ cosetSpace(G, X, Γ) ∧
    (∀ U ∈ TopologicalSpace.opens(X),
      valuesOn(cosetProjection(G, Γ), U) ∈ TopologicalSpace.opens(cosetSpace(G, X, Γ))) ∧
    Measurable(cosetProjection(G, Γ), borelSpace(X), borelSpace(cosetSpace(G, X, Γ)))
proof
  sorry

theorem cosetSpace.discrete (G X H : Set)
  requires topological : TopologicalGroup(G, X)
  requires open : OpenSubgroup(H, G, X)
  shows DiscreteTopology(cosetSpace(G, X, H))
proof
  sorry

-- Minkowski's theorem (Mathlib's
-- exists_ne_zero_mem_lattice_of_measure_mul_two_pow_lt_measure): a convex
-- symmetric Borel set of volume greater than 2ⁿ times the volume of a
-- fundamental domain of a countable subgroup L of ℝⁿ contains a nonzero
-- point of L.
theorem minkowski (n : Nat, L F S : Set)
  requires subgroup : Subgroup(L, euclideanAdditiveGroup(n))
  requires countable : Countable(L)
  requires domain : FundamentalDomain(euclideanAdditiveGroup(n), euclideanTopology(n),
    euclideanVolume(n), L, F)
  requires convex : ConvexSymmetric(n, S)
  requires set : MeasurableSet(euclideanMeasurableSpace(n), S)
  requires large : EnnLt(ennMul(R[2 ^ n], euclideanVolume(n)(F)), euclideanVolume(n)(S))
  shows ∃ x ∈ L ∩ S, x ≠ zeroVector(n)
proof
  sorry

end HaarMeasure
