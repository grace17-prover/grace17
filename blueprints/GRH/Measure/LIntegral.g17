-- The lower (Lebesgue) integral of functions with values in [0, ∞]:
-- defined as the supremum, over finite measurable partitions of the
-- space, of Σ (inf of f on the piece) · μ(piece), which is Mathlib's
-- supremum over simple functions below f; monotonicity, constants and
-- indicators, additivity and scalar multiples, countable sums, monotone
-- convergence, Fatou's lemma, dominated convergence, Markov's inequality,
-- vanishing integrals, integrals over sets, push-forwards, measures with
-- density, Dirac and counting measures, and the Cauchy–Schwarz
-- inequality.
-- Part of the GRH blueprint.
-- Planned home: MeasureTheory/Integral/Lebesgue.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Measure.LIntegral
import GRH.Measure.Lebesgue

section LowerIntegral
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- Section: Definitions
-- A finite measurable partition of the carrier of X.
predicate MeasurablePartition (X P : Set) :=
  Finite(P) ∧ P ⊆ MeasurableSpace.sets(X) ∧ ⋃(P) = MeasurableSpace.carrier(X) ∧
  (∀ A ∈ P, ∀ B ∈ P, A ≠ B → Disjoint(A, B))

-- The lower sum of f over the partition P: Σ_{A ∈ P} (inf_A f) · μ(A),
-- with inf ∅ = ∞ and ∞ · 0 = 0; and the lower integral ∫⁻ f dμ, the
-- supremum of the lower sums (Mathlib's lintegral; the simple functions
-- below f are exactly the functions constant on the pieces of a finite
-- measurable partition with values below the infima). Only the values
-- of f on the carrier are read; no measurability of f is assumed.
def partitionTerms (μ f P : Set) : Set := { (A, ennMul(ennInfOn(f, A), μ(A))) | A ∈ P }
def lowerSum (μ f P : Set) : Set := ennFiniteSum(partitionTerms(μ, f, P), P)
def lowerSums (X μ f : Set) : Set :=
  { s ∈ ennreal | ∃ P ∈ 𝒫(MeasurableSpace.sets(X)),
    MeasurablePartition(X, P) ∧ s = lowerSum(μ, f, P) }
def lintegral (X μ f : Set) : Set := ennSup(lowerSums(X, μ, f))

-- ∫⁻ x in A, f x ∂μ (Mathlib's setLIntegral), and the measure with
-- density f (Mathlib's withDensity).
def setLIntegral (X μ f A : Set) : Set := lintegral(X, restrictMeasure(X, μ, A), f)
def withDensity (X μ f : Set) : Set :=
  { (A, setLIntegral(X, μ, f, A)) | A ∈ MeasurableSpace.sets(X) }

-- f maps the carrier of X into [0, ∞].
predicate EnnValued (X f : Set) := MapsInto(f, MeasurableSpace.carrier(X), ennreal)

-- Pointwise constructions on the carrier A: the constant c; f + g; c · f;
-- f · g; x ↦ ofReal(f(x)) for a real map; x ↦ |f(x)| for a real map and
-- for a complex map; the indicator of S times f.
def constantOn (A c : Set) : Set := A × {c}
def ennAddOn (f g A : Set) : Set := { (x, ennAdd(f(x), g(x))) | x ∈ A }
def ennConstMulOn (c f A : Set) : Set := { (x, ennMul(c, f(x))) | x ∈ A }
def ennMulOn (f g A : Set) : Set := { (x, ennMul(f(x), g(x))) | x ∈ A }
def ennOfRealOn (f A : Set) : Set := { (x, ennOfReal(f(x))) | x ∈ A }
def realAbsOn (f A : Set) : Set := { (x, abs(f(x))) | x ∈ A }
def complexAbsOn (f A : Set) : Set := { (x, complexAbs(f(x))) | x ∈ A }
def ennIndicatorOn (A S f : Set) : Set :=
  piecewiseOn(A, S, f, constantOn(A, realZero))

-- The points where f ≥ c, and where f = ∞.
def ennGeSet (f A c : Set) : Set := { x ∈ A | EnnLe(c, f(x)) }
def ennTopSet (f A : Set) : Set := { x ∈ A | f(x) = ennTop }

-- Convergence of a sequence in [0, ∞] to a finite or infinite limit.
predicate EnnConvergesTo (u a : Set) :=
  (a ≠ ennTop ∧ ∀ e ∈ ℝ, realZero < e → ∃ N ∈ ℕ, ∀ n ∈ ℕ, N ⊆ n →
    u(n) ≠ ennTop ∧ abs(R[u(n) - a]) < e) ∨
  (a = ennTop ∧ ∀ M ∈ ℝ, ∃ N ∈ ℕ, ∀ n ∈ ℕ, N ⊆ n → ¬EnnLe(u(n), M))

-- The sequence n ↦ ∫⁻ u(n) dμ.
def lintegralSequence (X μ u : Set) : Set := { (n, lintegral(X, μ, u(n))) | n ∈ ℕ }
def lintegralFamily (X μ u I : Set) : Set := { (i, lintegral(X, μ, u(i))) | i ∈ I }
def lintegralOverMeasures (X m f : Set) : Set := { (n, lintegral(X, m(n), f)) | n ∈ ℕ }

-- The terms c(A) · μ(A) of the integral of a function with value c(A) on
-- the piece A of a partition.
def simpleTerms (μ c P : Set) : Set := { (A, ennMul(c(A), μ(A))) | A ∈ P }

-- Where f ≤ g, and where the sequence u(n)(x) converges to f(x).
def ennLeSet (f g A : Set) : Set := { x ∈ A | EnnLe(f(x), g(x)) }
def ennConvergenceSet (u f A : Set) : Set :=
  { x ∈ A | EnnConvergesTo(familyAt(u, ℕ, x), f(x)) }

-- The pointwise supremum and lim inf of a sequence of maps into [0, ∞],
-- and the pointwise sum.
def ennSupSequenceOn (u A : Set) : Set := { (x, ennSupOn(familyAt(u, ℕ, x), ℕ)) | x ∈ A }
def ennLiminfOn (u A : Set) : Set := { (x, ennLiminf(familyAt(u, ℕ, x))) | x ∈ A }
def ennTsumOn (u A : Set) : Set := { (x, ennTsum(familyAt(u, ℕ, x), ℕ)) | x ∈ A }
def ennFiniteSumOn (u F A : Set) : Set := { (x, ennFiniteSum(familyAt(u, F, x), F)) | x ∈ A }

-- The integrals over a sequence of sets, and over the points of a set
-- against the counting measure.
def setLIntegralSequence (X μ f S : Set) : Set :=
  { (n, setLIntegral(X, μ, f, S(n))) | n ∈ ℕ }

-- Section: Helpers
theorem partitionTerms.apply (μ f P A : Set)
  requires member : A ∈ P
  shows partitionTerms(μ, f, P)(A) = ennMul(ennInfOn(f, A), μ(A))
proof
  have edge : (A, ennMul(ennInfOn(f, A), μ(A))) ∈ partitionTerms(μ, f, P)
    apply partitionTerms.membership.backward
    exact ⟨A, member, rfl⟩
  have pairs : ∀ p ∈ partitionTerms(μ, f, P), ∃ a, ∃ b, p = (a, b)
    intros p hp
    obtain ⟨k, hk, pEq⟩ := partitionTerms.membership.forward with hp
    rw ← pEq
    exact ⟨k, ennMul(ennInfOn(f, k), μ(k)), rfl⟩
  have functional : ∀ a, ∀ b, ∀ c, (a, b) ∈ partitionTerms(μ, f, P) → (a, c) ∈ partitionTerms(μ, f, P) → b = c
    intros a b c hb hc
    obtain ⟨k, hk, bEq⟩ := partitionTerms.membership.forward with hb
    obtain ⟨m, hm, cEq⟩ := partitionTerms.membership.forward with hc
    obtain ⟨ka, bb⟩ := orderedPair.injective with bEq
    obtain ⟨ma, cc⟩ := orderedPair.injective with cEq
    rw [← bb, ← cc, ka, ← ma]
  exact pairGraph.apply with pairs, functional, edge

theorem ennInfOn.member (f A : Set)
  requires values : ∀ x ∈ A, f(x) ∈ ennreal
  shows ennInfOn(f, A) ∈ ennreal
proof
  have inside : valuesOn(f, A) ⊆ ennreal
    intros a ha
    obtain ⟨x, xA, e⟩ := valuesOn.membership.forward with ha
    rw ← e
    exact values with x, xA
  have g := ennInf.greatest_lower with inside
  obtain ⟨lower, greatest⟩ := g
  obtain ⟨m, rest⟩ := lower
  unfold ennInfOn
  exact m

theorem ennInfOn.mono (f g A : Set)
  requires valuesF : ∀ x ∈ A, f(x) ∈ ennreal
  requires valuesG : ∀ x ∈ A, g(x) ∈ ennreal
  requires le : ∀ x ∈ A, EnnLe(f(x), g(x))
  shows EnnLe(ennInfOn(f, A), ennInfOn(g, A))
proof
  have insideF : valuesOn(f, A) ⊆ ennreal
    intros a ha
    obtain ⟨x, xA, e⟩ := valuesOn.membership.forward with ha
    rw ← e
    exact valuesF with x, xA
  have insideG : valuesOn(g, A) ⊆ ennreal
    intros a ha
    obtain ⟨x, xA, e⟩ := valuesOn.membership.forward with ha
    rw ← e
    exact valuesG with x, xA
  have gf := ennInf.greatest_lower with insideF
  obtain ⟨lowerF, greatestF⟩ := gf
  have gg := ennInf.greatest_lower with insideG
  obtain ⟨lowerG, greatestG⟩ := gg
  obtain ⟨mF, boundsF⟩ := lowerF
  have lower : EnnLowerBound(valuesOn(g, A), ennInf(valuesOn(f, A)))
    unfold EnnLowerBound
    refine ⟨mF, ?_⟩
    intros b hb
    obtain ⟨x, xA, e⟩ := valuesOn.membership.forward with hb
    have fx : f(x) ∈ valuesOn(f, A) := valuesOn.membership.backward with ⟨x, xA, rfl⟩
    have l1 := boundsF with f(x), fx
    have l2 := le with x, xA
    rw ← e
    exact EnnLe.transitive with l1, l2
  unfold ennInfOn
  exact greatestG with ennInf(valuesOn(f, A)), lower

theorem lintegral.upper (X μ f P : Set)
  requires partition : MeasurablePartition(X, P)
  requires member : lowerSum(μ, f, P) ∈ ennreal
  shows EnnLe(lowerSum(μ, f, P), lintegral(X, μ, f))
proof
  have inside : lowerSums(X, μ, f) ⊆ ennreal
    intros s hs
    obtain ⟨sM, rest⟩ := lowerSums.membership.forward with hs
    exact sM
  have lu := ennSup.least_upper with inside
  obtain ⟨ub, least⟩ := lu
  obtain ⟨sM, bounds⟩ := ub
  have p2 := partition
  obtain ⟨fin, sub, cover, disj⟩ := p2
  have PP := (powerset.membership_iff at P, MeasurableSpace.sets(X)).backward with sub
  have mem : lowerSum(μ, f, P) ∈ lowerSums(X, μ, f) := lowerSums.membership.backward with ⟨member, P, PP, partition, rfl⟩
  unfold lintegral
  exact bounds with lowerSum(μ, f, P), mem

-- Section: Basic laws
theorem lintegral.member (X μ f : Set)
  requires measure : Measure(X, μ)
  shows lintegral(X, μ, f) ∈ ennreal
proof
  have inside : lowerSums(X, μ, f) ⊆ ennreal
    intros s hs
    obtain ⟨sM, rest⟩ := lowerSums.membership.forward with hs
    exact sM
  have lu := ennSup.least_upper with inside
  obtain ⟨ub, least⟩ := lu
  obtain ⟨sM, bounds⟩ := ub
  unfold lintegral
  exact sM

-- Mathlib's lintegral_mono.
theorem lintegral.mono (X μ f g : Set)
  requires measure : Measure(X, μ)
  requires valuesF : EnnValued(X, f)
  requires valuesG : EnnValued(X, g)
  requires le : ∀ x ∈ MeasurableSpace.carrier(X), EnnLe(f(x), g(x))
  shows EnnLe(lintegral(X, μ, f), lintegral(X, μ, g))
proof
  have space := Measure.space with measure
  have vF2 : ∀ x ∈ MeasurableSpace.carrier(X), f(x) ∈ ennreal
    unfold EnnValued at valuesF
    unfold MapsInto at valuesF
    exact valuesF
  have vG2 : ∀ x ∈ MeasurableSpace.carrier(X), g(x) ∈ ennreal
    unfold EnnValued at valuesG
    unfold MapsInto at valuesG
    exact valuesG
  have insideF : lowerSums(X, μ, f) ⊆ ennreal
    intros s hs
    obtain ⟨sM, rest⟩ := lowerSums.membership.forward with hs
    exact sM
  have lu := ennSup.least_upper with insideF
  obtain ⟨ub, least⟩ := lu
  have gM := lintegral.member at X, μ, g with measure
  have upper : EnnUpperBound(lowerSums(X, μ, f), lintegral(X, μ, g))
    unfold EnnUpperBound
    refine ⟨gM, ?_⟩
    intros s hs
    obtain ⟨sM, P, PP, partition, e⟩ := lowerSums.membership.forward with hs
    have p2 := partition
    obtain ⟨fin, sub, cover, disj⟩ := p2
    have pieces : ∀ A ∈ P, A ⊆ MeasurableSpace.carrier(X)
      intros A hA
      have mA : MeasurableSet(X, A)
        unfold MeasurableSet
        exact sub with A, hA
      exact MeasurableSet.subset with space, mA
    have vF : ∀ A ∈ P, partitionTerms(μ, f, P)(A) ∈ ennreal
      intros A hA
      rw partitionTerms.apply with hA
      have AX := pieces with A, hA
      have fv : ∀ x ∈ A, f(x) ∈ ennreal
        intros x hx
        exact vF2 with x, (AX with x, hx)
      have im := ennInfOn.member with fv
      have mA : MeasurableSet(X, A)
        unfold MeasurableSet
        exact sub with A, hA
      have mm := Measure.member with measure, mA
      exact ennMul.member with im, mm
    have vG : ∀ A ∈ P, partitionTerms(μ, g, P)(A) ∈ ennreal
      intros A hA
      rw partitionTerms.apply with hA
      have AX := pieces with A, hA
      have gv : ∀ x ∈ A, g(x) ∈ ennreal
        intros x hx
        exact vG2 with x, (AX with x, hx)
      have im := ennInfOn.member with gv
      have mA : MeasurableSet(X, A)
        unfold MeasurableSet
        exact sub with A, hA
      have mm := Measure.member with measure, mA
      exact ennMul.member with im, mm
    have lt : ∀ A ∈ P, EnnLe(partitionTerms(μ, f, P)(A), partitionTerms(μ, g, P)(A))
      intros A hA
      rw partitionTerms.apply at μ, f, P, A with hA
      rw partitionTerms.apply at μ, g, P, A with hA
      have AX := pieces with A, hA
      have fv : ∀ x ∈ A, f(x) ∈ ennreal
        intros x hx
        exact vF2 with x, (AX with x, hx)
      have gv : ∀ x ∈ A, g(x) ∈ ennreal
        intros x hx
        exact vG2 with x, (AX with x, hx)
      have lA : ∀ x ∈ A, EnnLe(f(x), g(x))
        intros x hx
        exact le with x, (AX with x, hx)
      have im := ennInfOn.mono with fv, gv, lA
      have mA : MeasurableSet(X, A)
        unfold MeasurableSet
        exact sub with A, hA
      have mm := Measure.member with measure, mA
      have rr := EnnLe.reflexive with mm
      exact ennMul.mono with im, rr
    have l1 := ennFiniteSum.mono_fun with fin, vF, vG, lt
    have gsM : lowerSum(μ, g, P) ∈ ennreal
      unfold lowerSum
      exact ennFiniteSum.member with fin, vG
    have l2 := lintegral.upper at X, μ, g, P with partition, gsM
    rw e
    unfold lowerSum
    unfold lowerSum at l2
    exact EnnLe.transitive with l1, l2
  have r := least with lintegral(X, μ, g), upper
  unfold lintegral at r
  unfold lintegral
  exact r

-- Mathlib's lintegral_congr and lintegral_congr_ae.
theorem lintegral.congr (X μ f g : Set)
  requires agree : ∀ x ∈ MeasurableSpace.carrier(X), f(x) = g(x)
  shows lintegral(X, μ, f) = lintegral(X, μ, g)
proof
  have infEq : ∀ A, A ⊆ MeasurableSpace.carrier(X) → ennInfOn(f, A) = ennInfOn(g, A)
    intros A AX
    have v : valuesOn(f, A) = valuesOn(g, A)
      ext a
      constructor
      . intro h
        obtain ⟨x, xA, e⟩ := valuesOn.membership.forward with h
        rw agree with x, (AX with x, xA) at e
        exact valuesOn.membership.backward with ⟨x, xA, e⟩
      . intro h
        obtain ⟨x, xA, e⟩ := valuesOn.membership.forward with h
        rw ← agree with x, (AX with x, xA) at e
        exact valuesOn.membership.backward with ⟨x, xA, e⟩
    unfold ennInfOn
    rw v
  have sumEq : ∀ P, MeasurablePartition(X, P) → lowerSum(μ, f, P) = lowerSum(μ, g, P)
    intros P partition
    obtain ⟨fin, sub, cover, disj⟩ := partition
    have pieces : ∀ A ∈ P, A ⊆ MeasurableSpace.carrier(X)
      intros A hA x hx
      rw ← cover
      exact union.membership.backward with ⟨A, hA, hx⟩
    have t : partitionTerms(μ, f, P) = partitionTerms(μ, g, P)
      ext m
      constructor
      . intro h
        obtain ⟨A, hA, e⟩ := partitionTerms.membership.forward with h
        rw infEq with A, (pieces with A, hA) at e
        exact partitionTerms.membership.backward with ⟨A, hA, e⟩
      . intro h
        obtain ⟨A, hA, e⟩ := partitionTerms.membership.forward with h
        rw ← infEq with A, (pieces with A, hA) at e
        exact partitionTerms.membership.backward with ⟨A, hA, e⟩
    unfold lowerSum
    rw t
  have sums : lowerSums(X, μ, f) = lowerSums(X, μ, g)
    ext s
    constructor
    . intro h
      obtain ⟨sM, P, PP, partition, e⟩ := lowerSums.membership.forward with h
      rw sumEq with P, partition at e
      exact lowerSums.membership.backward with ⟨sM, P, PP, partition, e⟩
    . intro h
      obtain ⟨sM, P, PP, partition, e⟩ := lowerSums.membership.forward with h
      rw ← sumEq with P, partition at e
      exact lowerSums.membership.backward with ⟨sM, P, PP, partition, e⟩
  unfold lintegral
  rw sums

-- Section: Helpers for constants, indicators and partitions
theorem constantOn.apply (A c x : Set)
  requires member : x ∈ A
  shows constantOn(A, c)(x) = c
proof
  have cIn : c ∈ {c} by simp
  have edge : (x, c) ∈ A × {c} := product.pair with member, cIn
  have pairs : ∀ p ∈ A × {c}, ∃ a, ∃ b, p = (a, b)
    intros p hp
    obtain ⟨bound, a, ha, b, hb, pEq⟩ := product.membership.forward with hp
    exact ⟨a, b, pEq⟩
  have functional : ∀ a, ∀ b, ∀ d, (a, b) ∈ A × {c} → (a, d) ∈ A × {c} → b = d
    intros a b d hb hd
    obtain ⟨ha, bc⟩ := product.pair_membership.forward with hb
    obtain ⟨ha2, dc⟩ := product.pair_membership.forward with hd
    simp at bc
    simp at dc
    rw [bc, dc]
  unfold constantOn
  exact pairGraph.apply with pairs, functional, edge

theorem indicatorOn.apply (A S c z x : Set)
  requires member : x ∈ A
  shows (x ∈ S → indicatorOn(A, S, c, z)(x) = c) ∧
    (x ∉ S → indicatorOn(A, S, c, z)(x) = z)
proof
  have pairs : ∀ p ∈ indicatorOn(A, S, c, z), ∃ a, ∃ b, p = (a, b)
    intros p hp
    obtain ⟨pIn, alt⟩ := indicatorOn.membership.forward with hp
    obtain ⟨bound, a, ha, b, hb, pEq⟩ := product.membership.forward with pIn
    exact ⟨a, b, pEq⟩
  have functional : ∀ a, ∀ b, ∀ d, (a, b) ∈ indicatorOn(A, S, c, z) → (a, d) ∈ indicatorOn(A, S, c, z) → b = d
    intros a b d hb hd
    obtain ⟨pb, altB⟩ := indicatorOn.membership.forward with hb
    obtain ⟨pd, altD⟩ := indicatorOn.membership.forward with hd
    simp [fst.pair, snd.pair] at altB
    simp [fst.pair, snd.pair] at altD
    cases altB with inB | outB
    . cases altD with inD | outD
      . rw [inB.right, inD.right]
      . exfalso
        exact outD.left with inB.left
    . cases altD with inD | outD
      . exfalso
        exact outB.left with inD.left
      . rw [outB.right, outD.right]
  constructor
  . intro xS
    have cIn : c ∈ {c} ∪ {z} by simp
    have pr := product.pair with member, cIn
    have edge : (x, c) ∈ indicatorOn(A, S, c, z)
      apply indicatorOn.membership.backward
      refine ⟨pr, ?_⟩
      left
      simp [fst.pair, snd.pair, xS]
    exact pairGraph.apply with pairs, functional, edge
  . intro xS
    have zIn : z ∈ {c} ∪ {z} by simp
    have pr := product.pair with member, zIn
    have edge : (x, z) ∈ indicatorOn(A, S, c, z)
      apply indicatorOn.membership.backward
      refine ⟨pr, ?_⟩
      right
      simp [fst.pair, snd.pair, xS]
    exact pairGraph.apply with pairs, functional, edge

theorem ennInfOn.le_value (f A x : Set)
  requires values : ∀ y ∈ A, f(y) ∈ ennreal
  requires member : x ∈ A
  shows EnnLe(ennInfOn(f, A), f(x))
proof
  have inside : valuesOn(f, A) ⊆ ennreal
    intros a ha
    obtain ⟨y, yA, e⟩ := valuesOn.membership.forward with ha
    rw ← e
    exact values with y, yA
  obtain ⟨lower, greatest⟩ := ennInf.greatest_lower with inside
  obtain ⟨m, bounds⟩ := lower
  have fx : f(x) ∈ valuesOn(f, A) := valuesOn.membership.backward with ⟨x, member, rfl⟩
  unfold ennInfOn
  exact bounds with f(x), fx

theorem ennInfOn.ge (f A c : Set)
  requires values : ∀ y ∈ A, f(y) ∈ ennreal
  requires member : c ∈ ennreal
  requires bound : ∀ y ∈ A, EnnLe(c, f(y))
  shows EnnLe(c, ennInfOn(f, A))
proof
  have inside : valuesOn(f, A) ⊆ ennreal
    intros a ha
    obtain ⟨y, yA, e⟩ := valuesOn.membership.forward with ha
    rw ← e
    exact values with y, yA
  obtain ⟨lower, greatest⟩ := ennInf.greatest_lower with inside
  have lb : EnnLowerBound(valuesOn(f, A), c)
    unfold EnnLowerBound
    refine ⟨member, ?_⟩
    intros a ha
    obtain ⟨y, yA, e⟩ := valuesOn.membership.forward with ha
    rw ← e
    exact bound with y, yA
  unfold ennInfOn
  exact greatest with c, lb

theorem ennInfOn.const (f A c x : Set)
  requires member : x ∈ A
  requires value : c ∈ ennreal
  requires constant : ∀ y ∈ A, f(y) = c
  shows ennInfOn(f, A) = c
proof
  have values : ∀ y ∈ A, f(y) ∈ ennreal
    intros y hy
    rw constant with y, hy
    exact value
  have l1 := ennInfOn.le_value with values, member
  rw constant with x, member at l1
  have bound : ∀ y ∈ A, EnnLe(c, f(y))
    intros y hy
    rw constant with y, hy
    exact EnnLe.reflexive with value
  have l2 := ennInfOn.ge with values, value, bound
  exact EnnLe.antisymmetric with l1, l2

theorem MeasurablePartition.pieces (X P A : Set)
  requires space : MeasurableSpace(X)
  requires partition : MeasurablePartition(X, P)
  requires member : A ∈ P
  shows MeasurableSet(X, A) ∧ A ⊆ MeasurableSpace.carrier(X)
proof
  obtain ⟨fin, sub, cover, disj⟩ := partition
  have mA : MeasurableSet(X, A)
    unfold MeasurableSet
    exact sub with A, member
  have s := MeasurableSet.subset with space, mA
  exact ⟨mA, s⟩

theorem MeasurablePartition.whole (X : Set)
  requires space : MeasurableSpace(X)
  shows MeasurablePartition(X, {MeasurableSpace.carrier(X)})
proof
  have u := MeasurableSet.univ with space
  unfold MeasurableSet at u
  have fin := Finite.singleton at MeasurableSpace.carrier(X)
  have sub : {MeasurableSpace.carrier(X)} ⊆ MeasurableSpace.sets(X)
    intros A hA
    simp at hA
    rw hA
    exact u
  have cover : ⋃({MeasurableSpace.carrier(X)}) = MeasurableSpace.carrier(X)
    ext x
    constructor
    . intro h
      obtain ⟨A, hA, xA⟩ := union.membership.forward with h
      simp at hA
      rw hA at xA
      exact xA
    . intro h
      have cIn : MeasurableSpace.carrier(X) ∈ {MeasurableSpace.carrier(X)} by simp
      exact union.membership.backward with ⟨MeasurableSpace.carrier(X), cIn, h⟩
  have disj : ∀ A ∈ {MeasurableSpace.carrier(X)}, ∀ B ∈ {MeasurableSpace.carrier(X)}, A ≠ B → Disjoint(A, B)
    intros A hA B hB ne
    simp at hA
    simp at hB
    exfalso
    apply ne
    rw [hA, hB]
  unfold MeasurablePartition
  exact ⟨fin, sub, cover, disj⟩

-- The measures of a finite disjoint family of measurable sets add up to
-- the measure of its union.
theorem Measure.family_sum (X μ P h : Set)
  requires measure : Measure(X, μ)
  requires finite : Finite(P)
  requires sets : P ⊆ MeasurableSpace.sets(X)
  requires disjoint : ∀ A ∈ P, ∀ B ∈ P, A ≠ B → Disjoint(A, B)
  requires values : ∀ A ∈ P, h(A) = μ(A)
  shows ennFiniteSum(h, P) = μ(⋃(P))
proof
  have setsI : ∀ A ∈ P, MeasurableSet(X, identity(P)(A))
    intros A hA
    rw identity.apply with hA
    unfold MeasurableSet
    exact sets with A, hA
  have disjI : ∀ A ∈ P, ∀ B ∈ P, A ≠ B → Disjoint(identity(P)(A), identity(P)(B))
    intros A hA B hB ne
    rw identity.apply with hA
    rw identity.apply with hB
    exact disjoint with A, hA, B, hB, ne
  have valuesI : ∀ A ∈ P, h(A) = μ(identity(P)(A))
    intros A hA
    rw identity.apply with hA
    exact values with A, hA
  have all := Measure.finite_indexed_union with measure, setsI, disjI, valuesI
  have refl : P ⊆ P
    intros x hx
    exact hx
  have e := all with P, refl, finite
  have same : valuesOn(identity(P), P) = P
    ext A
    constructor
    . intro hA
      obtain ⟨B, hB, eB⟩ := valuesOn.membership.forward with hA
      rw identity.apply with hB at eB
      rw ← eB
      exact hB
    . intro hA
      have v : identity(P)(A) ∈ valuesOn(identity(P), P) := valuesOn.membership.backward with ⟨A, hA, rfl⟩
      rw identity.apply with hA at v
      exact v
  rw same at e
  rw e

theorem ennFiniteSum.mul_left (f h F c : Set)
  requires finite : Finite(F)
  requires values : ∀ i ∈ F, f(i) ∈ ennreal
  requires member : c ∈ ennreal
  requires product : ∀ i ∈ F, h(i) = ennMul(c, f(i))
  shows ennFiniteSum(h, F) = ennMul(c, ennFiniteSum(f, F))
proof
  have hv : ∀ i ∈ F, h(i) ∈ ennreal
    intros i hi
    rw product with i, hi
    exact ennMul.member with member, (values with i, hi)
  have m := ennTsum.mul_left with values, member, product
  rw ennTsum.finite with finite, hv at m
  rw ennTsum.finite with finite, values at m
  exact m

-- The lower integral is the value every lower sum takes, and is below a
-- bound of every lower sum.
theorem lintegral.le_of_all (X μ f v : Set)
  requires member : v ∈ ennreal
  requires bound : ∀ P, MeasurablePartition(X, P) → EnnLe(lowerSum(μ, f, P), v)
  shows EnnLe(lintegral(X, μ, f), v)
proof
  have inside : lowerSums(X, μ, f) ⊆ ennreal
    intros s hs
    obtain ⟨sM, rest⟩ := lowerSums.membership.forward with hs
    exact sM
  obtain ⟨ub, least⟩ := ennSup.least_upper with inside
  have upper : EnnUpperBound(lowerSums(X, μ, f), v)
    unfold EnnUpperBound
    refine ⟨member, ?_⟩
    intros s hs
    obtain ⟨sM, P, PP, partition, e⟩ := lowerSums.membership.forward with hs
    rw e
    exact bound with P, partition
  unfold lintegral
  exact least with v, upper

theorem lintegral.eq_of_all (X μ f v : Set)
  requires space : MeasurableSpace(X)
  requires member : v ∈ ennreal
  requires all : ∀ P, MeasurablePartition(X, P) → lowerSum(μ, f, P) = v
  shows lintegral(X, μ, f) = v
proof
  have bound : ∀ P, MeasurablePartition(X, P) → EnnLe(lowerSum(μ, f, P), v)
    intros P partition
    rw all with P, partition
    exact EnnLe.reflexive with member
  have l1 := lintegral.le_of_all with member, bound
  have whole := MeasurablePartition.whole with space
  have e := all with {MeasurableSpace.carrier(X)}, whole
  have sm : lowerSum(μ, f, {MeasurableSpace.carrier(X)}) ∈ ennreal
    rw e
    exact member
  have l2 := lintegral.upper with whole, sm
  rw e at l2
  exact EnnLe.antisymmetric with l1, l2

theorem partitionTerm.empty (X μ f : Set)
  requires measure : Measure(X, μ)
  shows ennMul(ennInfOn(f, ∅), μ(∅)) = realZero
proof
  have v : ∀ x ∈ ∅, f(x) ∈ ennreal
    intros x hx
    simp at hx
  have im := ennInfOn.member with v
  exact ennMul.zero_right with im, (Measure.empty with measure)

theorem partitionTerms.const (X μ c P A : Set)
  requires measure : Measure(X, μ)
  requires member : c ∈ ennreal
  requires partition : MeasurablePartition(X, P)
  requires piece : A ∈ P
  shows partitionTerms(μ, constantOn(MeasurableSpace.carrier(X), c), P)(A) = ennMul(c, μ(A))
proof
  have space := Measure.space with measure
  obtain ⟨mA, AX⟩ := MeasurablePartition.pieces with space, partition, piece
  rw partitionTerms.apply with piece
  by_cases ne : ∃ x, x ∈ A
  . obtain ⟨x, xA⟩ := ne
    have constant : ∀ y ∈ A, constantOn(MeasurableSpace.carrier(X), c)(y) = c
      intros y hy
      exact constantOn.apply with (AX with y, hy)
    rw ennInfOn.const with xA, member, constant
  . have Ae : A = ∅
      ext x
      constructor
      . intro h
        exfalso
        exact ne with ⟨x, h⟩
      . intro h
        simp at h
    rw Ae
    rw partitionTerm.empty with measure
    rw Measure.empty with measure
    rw ennMul.zero_right with member, rfl

theorem lowerSum.const (X μ c P : Set)
  requires measure : Measure(X, μ)
  requires member : c ∈ ennreal
  requires partition : MeasurablePartition(X, P)
  shows lowerSum(μ, constantOn(MeasurableSpace.carrier(X), c), P) =
    ennMul(c, μ(MeasurableSpace.carrier(X)))
proof
  have space := Measure.space with measure
  have p2 := partition
  obtain ⟨fin, sub, cover, disj⟩ := p2
  have product : ∀ A ∈ P, partitionTerms(μ, constantOn(MeasurableSpace.carrier(X), c), P)(A) = ennMul(c, μ(A))
    intros A hA
    exact partitionTerms.const with measure, member, partition, hA
  have values : ∀ A ∈ P, μ(A) ∈ ennreal
    intros A hA
    obtain ⟨mA, AX⟩ := MeasurablePartition.pieces with space, partition, hA
    exact Measure.member with measure, mA
  have m := ennFiniteSum.mul_left with fin, values, member, product
  have same : ∀ A ∈ P, μ(A) = μ(A)
    intros A hA
    rfl
  have fs := Measure.family_sum with measure, fin, sub, disj, same
  rw cover at fs
  unfold lowerSum
  rw m
  rw fs

-- A termwise bound on a lower sum.
theorem lowerSum.le_terms (X μ f P t : Set)
  requires measure : Measure(X, μ)
  requires partition : MeasurablePartition(X, P)
  requires valuesF : ∀ x ∈ MeasurableSpace.carrier(X), f(x) ∈ ennreal
  requires valuesT : ∀ A ∈ P, t(A) ∈ ennreal
  requires le : ∀ A ∈ P, EnnLe(ennMul(ennInfOn(f, A), μ(A)), t(A))
  shows EnnLe(lowerSum(μ, f, P), ennFiniteSum(t, P))
proof
  have space := Measure.space with measure
  have p2 := partition
  obtain ⟨fin, sub, cover, disj⟩ := p2
  have vP : ∀ A ∈ P, partitionTerms(μ, f, P)(A) ∈ ennreal
    intros A hA
    obtain ⟨mA, AX⟩ := MeasurablePartition.pieces with space, partition, hA
    rw partitionTerms.apply with hA
    have fv : ∀ x ∈ A, f(x) ∈ ennreal
      intros x hx
      exact valuesF with x, (AX with x, hx)
    exact ennMul.member with (ennInfOn.member with fv), (Measure.member with measure, mA)
  have lP : ∀ A ∈ P, EnnLe(partitionTerms(μ, f, P)(A), t(A))
    intros A hA
    rw partitionTerms.apply with hA
    exact le with A, hA
  unfold lowerSum
  exact ennFiniteSum.mono_fun with fin, vP, valuesT, lP

theorem lintegral.member_any (X μ f : Set)
  shows lintegral(X, μ, f) ∈ ennreal
proof
  have inside : lowerSums(X, μ, f) ⊆ ennreal
    intros s hs
    obtain ⟨sM, rest⟩ := lowerSums.membership.forward with hs
    exact sM
  obtain ⟨ub, least⟩ := ennSup.least_upper with inside
  obtain ⟨sM, bounds⟩ := ub
  unfold lintegral
  exact sM

-- The lower integral is monotone in the measure (any set functions with
-- values in [0, ∞], compared on the measurable sets).
theorem lintegral.mono_measure (X μ ν f : Set)
  requires valuesF : ∀ x ∈ MeasurableSpace.carrier(X), f(x) ∈ ennreal
  requires valuesNu : ∀ S ∈ MeasurableSpace.sets(X), ν(S) ∈ ennreal
  requires valuesMu : ∀ S ∈ MeasurableSpace.sets(X), μ(S) ∈ ennreal
  requires le : ∀ S ∈ MeasurableSpace.sets(X), EnnLe(ν(S), μ(S))
  shows EnnLe(lintegral(X, ν, f), lintegral(X, μ, f))
proof
  have lM := lintegral.member_any at X, μ, f
  apply lintegral.le_of_all with lM
  intros P partition
  have p2 := partition
  obtain ⟨fin, sub, cover, disj⟩ := p2
  have pieces : ∀ A ∈ P, A ⊆ MeasurableSpace.carrier(X)
    intros A hA x hx
    rw ← cover
    exact union.membership.backward with ⟨A, hA, hx⟩
  have fv : ∀ A ∈ P, ennInfOn(f, A) ∈ ennreal
    intros A hA
    have v : ∀ x ∈ A, f(x) ∈ ennreal
      intros x hx
      exact valuesF with x, (pieces with A, hA, x, hx)
    exact ennInfOn.member with v
  have vN : ∀ A ∈ P, partitionTerms(ν, f, P)(A) ∈ ennreal
    intros A hA
    rw partitionTerms.apply with hA
    exact ennMul.member with (fv with A, hA), (valuesNu with A, (sub with A, hA))
  have vM : ∀ A ∈ P, partitionTerms(μ, f, P)(A) ∈ ennreal
    intros A hA
    rw partitionTerms.apply with hA
    exact ennMul.member with (fv with A, hA), (valuesMu with A, (sub with A, hA))
  have lt : ∀ A ∈ P, EnnLe(partitionTerms(ν, f, P)(A), partitionTerms(μ, f, P)(A))
    intros A hA
    rw partitionTerms.apply at ν, f, P, A with hA
    rw partitionTerms.apply at μ, f, P, A with hA
    exact ennMul.mono with (EnnLe.reflexive with (fv with A, hA)), (le with A, (sub with A, hA))
  have l1 := ennFiniteSum.mono_fun with fin, vN, vM, lt
  have sm : lowerSum(μ, f, P) ∈ ennreal
    unfold lowerSum
    exact ennFiniteSum.member with fin, vM
  have l2 := lintegral.upper with partition, sm
  unfold lowerSum
  unfold lowerSum at l2
  exact EnnLe.transitive with l1, l2

-- Mathlib's lintegral_const, lintegral_one, lintegral_zero.
theorem lintegral.const (X μ c : Set)
  requires measure : Measure(X, μ)
  requires member : c ∈ ennreal
  shows lintegral(X, μ, constantOn(MeasurableSpace.carrier(X), c)) =
    ennMul(c, μ(MeasurableSpace.carrier(X)))
proof
  have space := Measure.space with measure
  have u := MeasurableSet.univ with space
  have vm := ennMul.member with member, (Measure.member with measure, u)
  apply lintegral.eq_of_all with space, vm
  intros P partition
  exact lowerSum.const with measure, member, partition

theorem lintegral.one (X μ : Set)
  requires measure : Measure(X, μ)
  shows lintegral(X, μ, constantOn(MeasurableSpace.carrier(X), realOne)) =
    μ(MeasurableSpace.carrier(X))
proof
  have oR : realOne ∈ ℝ by typecheck
  have oN : realZero ≤ realOne by linarith
  have om := ennreal.of_real with oR, oN
  rw lintegral.const with measure, om
  have space := Measure.space with measure
  have u := MeasurableSet.univ with space
  exact ennMul.one with (Measure.member with measure, u)

theorem lintegral.zero (X μ : Set)
  requires measure : Measure(X, μ)
  shows lintegral(X, μ, constantOn(MeasurableSpace.carrier(X), realZero)) = realZero
proof
  have zm := ennreal.zero_member
  rw lintegral.const with measure, zm
  have space := Measure.space with measure
  have u := MeasurableSet.univ with space
  exact ennMul.zero with (Measure.member with measure, u)

-- The pieces of a family cut down to S.
def interWith (P S : Set) : Set := { (A, A ∩ S) | A ∈ P }

theorem interWith.apply (P S A : Set)
  requires member : A ∈ P
  shows interWith(P, S)(A) = A ∩ S
proof
  have edge : (A, A ∩ S) ∈ interWith(P, S)
    apply interWith.membership.backward
    exact ⟨A, member, rfl⟩
  have pairs : ∀ p ∈ interWith(P, S), ∃ a, ∃ b, p = (a, b)
    intros p hp
    obtain ⟨k, hk, pEq⟩ := interWith.membership.forward with hp
    rw ← pEq
    exact ⟨k, k ∩ S, rfl⟩
  have functional : ∀ a, ∀ b, ∀ c, (a, b) ∈ interWith(P, S) → (a, c) ∈ interWith(P, S) → b = c
    intros a b c hb hc
    obtain ⟨k, hk, bEq⟩ := interWith.membership.forward with hb
    obtain ⟨m, hm, cEq⟩ := interWith.membership.forward with hc
    obtain ⟨ka, bb⟩ := orderedPair.injective with bEq
    obtain ⟨ma, cc⟩ := orderedPair.injective with cEq
    rw [← bb, ← cc, ka, ← ma]
  exact pairGraph.apply with pairs, functional, edge

-- Cutting the pieces of a partition down to a measurable S splits μ(S).
theorem Measure.partition_inter_sum (X μ P S : Set)
  requires measure : Measure(X, μ)
  requires partition : MeasurablePartition(X, P)
  requires set : MeasurableSet(X, S)
  shows ennFiniteSum(measureFamily(μ, interWith(P, S), P), P) = μ(S)
proof
  have space := Measure.space with measure
  have p2 := partition
  obtain ⟨fin, sub, cover, disj⟩ := p2
  have SX := MeasurableSet.subset with space, set
  have sets : ∀ A ∈ P, MeasurableSet(X, interWith(P, S)(A))
    intros A hA
    rw interWith.apply with hA
    obtain ⟨mA, AX⟩ := MeasurablePartition.pieces with space, partition, hA
    exact MeasurableSet.inter with space, mA, set
  have disjoint : ∀ A ∈ P, ∀ B ∈ P, A ≠ B → Disjoint(interWith(P, S)(A), interWith(P, S)(B))
    intros A hA B hB ne
    rw interWith.apply with hA
    rw interWith.apply with hB
    have d := disj with A, hA, B, hB, ne
    have d2 := Disjoint.iff.forward with d
    apply Disjoint.iff.backward
    intros x hx hx2
    obtain ⟨xA, xS⟩ := intersection.membership.forward with hx
    obtain ⟨xB, xS2⟩ := intersection.membership.forward with hx2
    exact d2 with x, xA, xB
  have values : ∀ A ∈ P, measureFamily(μ, interWith(P, S), P)(A) = μ(interWith(P, S)(A))
    intros A hA
    exact measureFamily.apply with hA
  have all := Measure.finite_indexed_union with measure, sets, disjoint, values
  have refl : P ⊆ P
    intros x hx
    exact hx
  have e := all with P, refl, fin
  have same : ⋃(valuesOn(interWith(P, S), P)) = S
    ext x
    constructor
    . intro h
      obtain ⟨E, EIn, xE⟩ := union.membership.forward with h
      obtain ⟨A, hA, eA⟩ := valuesOn.membership.forward with EIn
      rw ← eA at xE
      rw interWith.apply with hA at xE
      obtain ⟨xA, xS⟩ := intersection.membership.forward with xE
      exact xS
    . intro h
      have xX := SX with x, h
      rw ← cover at xX
      obtain ⟨A, hA, xA⟩ := union.membership.forward with xX
      have inV : interWith(P, S)(A) ∈ valuesOn(interWith(P, S), P) := valuesOn.membership.backward with ⟨A, hA, rfl⟩
      have xI : x ∈ interWith(P, S)(A)
        rw interWith.apply with hA
        exact intersection.membership.backward with xA, h
      exact union.membership.backward with ⟨interWith(P, S)(A), inV, xI⟩
  rw same at e
  rw ← e

theorem ennConstMulOn.apply (c f A x : Set)
  requires member : x ∈ A
  shows ennConstMulOn(c, f, A)(x) = ennMul(c, f(x))
proof
  have edge : (x, ennMul(c, f(x))) ∈ ennConstMulOn(c, f, A)
    apply ennConstMulOn.membership.backward
    exact ⟨x, member, rfl⟩
  have pairs : ∀ p ∈ ennConstMulOn(c, f, A), ∃ a, ∃ b, p = (a, b)
    intros p hp
    obtain ⟨k, hk, pEq⟩ := ennConstMulOn.membership.forward with hp
    rw ← pEq
    exact ⟨k, ennMul(c, f(k)), rfl⟩
  have functional : ∀ a, ∀ b, ∀ d, (a, b) ∈ ennConstMulOn(c, f, A) → (a, d) ∈ ennConstMulOn(c, f, A) → b = d
    intros a b d hb hd
    obtain ⟨k, hk, bEq⟩ := ennConstMulOn.membership.forward with hb
    obtain ⟨m, hm, dEq⟩ := ennConstMulOn.membership.forward with hd
    obtain ⟨ka, bb⟩ := orderedPair.injective with bEq
    obtain ⟨ma, dd⟩ := orderedPair.injective with dEq
    rw [← bb, ← dd, ka, ← ma]
  exact pairGraph.apply with pairs, functional, edge

-- The terms c(A) · μ(B ∩ A) of a simple function against a second partition.
def crossRow (μ c A Q : Set) : Set := { (B, ennMul(c(A), μ(B ∩ A))) | B ∈ Q }
def crossTerms (μ c P Q : Set) : Set := { (A, crossRow(μ, c, A, Q)) | A ∈ P }

theorem crossRow.apply (μ c A Q B : Set)
  requires member : B ∈ Q
  shows crossRow(μ, c, A, Q)(B) = ennMul(c(A), μ(B ∩ A))
proof
  have edge : (B, ennMul(c(A), μ(B ∩ A))) ∈ crossRow(μ, c, A, Q)
    apply crossRow.membership.backward
    exact ⟨B, member, rfl⟩
  have pairs : ∀ p ∈ crossRow(μ, c, A, Q), ∃ a, ∃ b, p = (a, b)
    intros p hp
    obtain ⟨k, hk, pEq⟩ := crossRow.membership.forward with hp
    rw ← pEq
    exact ⟨k, ennMul(c(A), μ(k ∩ A)), rfl⟩
  have functional : ∀ a, ∀ b, ∀ d, (a, b) ∈ crossRow(μ, c, A, Q) → (a, d) ∈ crossRow(μ, c, A, Q) → b = d
    intros a b d hb hd
    obtain ⟨k, hk, bEq⟩ := crossRow.membership.forward with hb
    obtain ⟨m, hm, dEq⟩ := crossRow.membership.forward with hd
    obtain ⟨ka, bb⟩ := orderedPair.injective with bEq
    obtain ⟨ma, dd⟩ := orderedPair.injective with dEq
    rw [← bb, ← dd, ka, ← ma]
  exact pairGraph.apply with pairs, functional, edge

theorem crossTerms.apply (μ c P Q A : Set)
  requires member : A ∈ P
  shows crossTerms(μ, c, P, Q)(A) = crossRow(μ, c, A, Q)
proof
  have edge : (A, crossRow(μ, c, A, Q)) ∈ crossTerms(μ, c, P, Q)
    apply crossTerms.membership.backward
    exact ⟨A, member, rfl⟩
  have pairs : ∀ p ∈ crossTerms(μ, c, P, Q), ∃ a, ∃ b, p = (a, b)
    intros p hp
    obtain ⟨k, hk, pEq⟩ := crossTerms.membership.forward with hp
    rw ← pEq
    exact ⟨k, crossRow(μ, c, k, Q), rfl⟩
  have functional : ∀ a, ∀ b, ∀ d, (a, b) ∈ crossTerms(μ, c, P, Q) → (a, d) ∈ crossTerms(μ, c, P, Q) → b = d
    intros a b d hb hd
    obtain ⟨k, hk, bEq⟩ := crossTerms.membership.forward with hb
    obtain ⟨m, hm, dEq⟩ := crossTerms.membership.forward with hd
    obtain ⟨ka, bb⟩ := orderedPair.injective with bEq
    obtain ⟨ma, dd⟩ := orderedPair.injective with dEq
    rw [← bb, ← dd, ka, ← ma]
  exact pairGraph.apply with pairs, functional, edge

theorem simpleTerms.apply (μ c P A : Set)
  requires member : A ∈ P
  shows simpleTerms(μ, c, P)(A) = ennMul(c(A), μ(A))
proof
  have edge : (A, ennMul(c(A), μ(A))) ∈ simpleTerms(μ, c, P)
    apply simpleTerms.membership.backward
    exact ⟨A, member, rfl⟩
  have pairs : ∀ p ∈ simpleTerms(μ, c, P), ∃ a, ∃ b, p = (a, b)
    intros p hp
    obtain ⟨k, hk, pEq⟩ := simpleTerms.membership.forward with hp
    rw ← pEq
    exact ⟨k, ennMul(c(k), μ(k)), rfl⟩
  have functional : ∀ a, ∀ b, ∀ d, (a, b) ∈ simpleTerms(μ, c, P) → (a, d) ∈ simpleTerms(μ, c, P) → b = d
    intros a b d hb hd
    obtain ⟨k, hk, bEq⟩ := simpleTerms.membership.forward with hb
    obtain ⟨m, hm, dEq⟩ := simpleTerms.membership.forward with hd
    obtain ⟨ka, bb⟩ := orderedPair.injective with bEq
    obtain ⟨ma, dd⟩ := orderedPair.injective with dEq
    rw [← bb, ← dd, ka, ← ma]
  exact pairGraph.apply with pairs, functional, edge


-- The integral of a function constant on the pieces of a partition
-- (a simple function) is Σ value · measure (Mathlib's
-- SimpleFunc.lintegral_eq_lintegral).
theorem lintegral.simple (X μ f P c : Set)
  requires measure : Measure(X, μ)
  requires partition : MeasurablePartition(X, P)
  requires values : ∀ A ∈ P, c(A) ∈ ennreal
  requires constant : ∀ A ∈ P, ∀ x ∈ A, f(x) = c(A)
  shows lintegral(X, μ, f) = ennFiniteSum(simpleTerms(μ, c, P), P)
proof
  have space := Measure.space with measure
  have p2 := partition
  obtain ⟨fin, sub, cover, disj⟩ := p2
  have vF : ∀ x ∈ MeasurableSpace.carrier(X), f(x) ∈ ennreal
    intros x hx
    rw ← cover at hx
    obtain ⟨A, hA, xA⟩ := union.membership.forward with hx
    rw constant with A, hA, x, xA
    exact values with A, hA
  have sM : ∀ A ∈ P, simpleTerms(μ, c, P)(A) ∈ ennreal
    intros A hA
    rw simpleTerms.apply with hA
    obtain ⟨mA, AX⟩ := MeasurablePartition.pieces with space, partition, hA
    exact ennMul.member with (values with A, hA), (Measure.member with measure, mA)
  have vM := ennFiniteSum.member with fin, sM
  have own : lowerSum(μ, f, P) = ennFiniteSum(simpleTerms(μ, c, P), P)
    unfold lowerSum
    apply ennFiniteSum.congr
    intros A hA
    rw partitionTerms.apply with hA
    rw simpleTerms.apply with hA
    have cA := values with A, hA
    by_cases ne : ∃ x, x ∈ A
    . obtain ⟨x, xA⟩ := ne
      have cst : ∀ y ∈ A, f(y) = c(A)
        intros y hy
        exact constant with A, hA, y, hy
      rw ennInfOn.const with xA, cA, cst
    . have Ae : A = ∅
        ext x
        constructor
        . intro h
          exfalso
          exact ne with ⟨x, h⟩
        . intro h
          simp at h
      rw Ae
      rw partitionTerm.empty with measure
      rw Measure.empty with measure
      rw Ae at cA
      rw ennMul.zero_right with cA, rfl
  have lower : EnnLe(ennFiniteSum(simpleTerms(μ, c, P), P), lintegral(X, μ, f))
    have sm : lowerSum(μ, f, P) ∈ ennreal
      rw own
      exact vM
    have up := lintegral.upper with partition, sm
    rw own at up
    exact up
  have upper : EnnLe(lintegral(X, μ, f), ennFiniteSum(simpleTerms(μ, c, P), P))
    apply lintegral.le_of_all with vM
    intros Q qpart
    have q2 := qpart
    obtain ⟨finQ, subQ, coverQ, disjQ⟩ := q2
    have cross : ∀ A ∈ P, ∀ B ∈ Q, crossTerms(μ, c, P, Q)(A)(B) = ennMul(c(A), μ(B ∩ A))
      intros A hA B hB
      rw crossTerms.apply with hA
      rw crossRow.apply with hB
    have crossM : ∀ A ∈ P, ∀ B ∈ Q, crossTerms(μ, c, P, Q)(A)(B) ∈ ennreal
      intros A hA B hB
      rw cross with A, hA, B, hB
      obtain ⟨mA, AX⟩ := MeasurablePartition.pieces with space, partition, hA
      obtain ⟨mB, BX⟩ := MeasurablePartition.pieces with space, qpart, hB
      exact ennMul.member with (values with A, hA), (Measure.member with measure, (MeasurableSet.inter with space, mB, mA))
    have comm := ennTsum.comm_finite with fin, crossM
    have rows : ∀ A ∈ P, ennSumsOf(crossTerms(μ, c, P, Q), P, Q)(A) = simpleTerms(μ, c, P)(A)
      intros A hA
      rw ennSumsOf.apply with hA
      rw simpleTerms.apply with hA
      rw crossTerms.apply with hA
      have mf : ∀ B ∈ Q, measureFamily(μ, interWith(Q, A), Q)(B) ∈ ennreal
        intros B hB
        rw measureFamily.apply with hB
        rw interWith.apply with hB
        obtain ⟨mA, AX⟩ := MeasurablePartition.pieces with space, partition, hA
        obtain ⟨mB, BX⟩ := MeasurablePartition.pieces with space, qpart, hB
        exact Measure.member with measure, (MeasurableSet.inter with space, mB, mA)
      have product : ∀ B ∈ Q, crossRow(μ, c, A, Q)(B) = ennMul(c(A), measureFamily(μ, interWith(Q, A), Q)(B))
        intros B hB
        rw crossRow.apply with hB
        rw measureFamily.apply with hB
        rw interWith.apply with hB
      rw ennTsum.mul_left with mf, (values with A, hA), product
      rw ennTsum.finite with finQ, mf
      obtain ⟨mA, AX⟩ := MeasurablePartition.pieces with space, partition, hA
      rw Measure.partition_inter_sum with measure, qpart, mA
    have rM : ∀ A ∈ P, ennSumsOf(crossTerms(μ, c, P, Q), P, Q)(A) ∈ ennreal
      intros A hA
      rw rows with A, hA
      exact sM with A, hA
    have colM : ∀ B ∈ Q, ennColumnSums(crossTerms(μ, c, P, Q), P, Q)(B) ∈ ennreal
      intros B hB
      rw ennColumnSums.apply with hB
      have v : ∀ A ∈ P, familyAt(crossTerms(μ, c, P, Q), P, B)(A) ∈ ennreal
        intros A hA
        rw familyAt.apply with hA
        exact crossM with A, hA, B, hB
      exact ennTsum.member with v
    have le : ∀ B ∈ Q, EnnLe(ennMul(ennInfOn(f, B), μ(B)), ennColumnSums(crossTerms(μ, c, P, Q), P, Q)(B))
      intros B hB
      obtain ⟨mB, BX⟩ := MeasurablePartition.pieces with space, qpart, hB
      have fB : ∀ x ∈ B, f(x) ∈ ennreal
        intros x hx
        exact vF with x, (BX with x, hx)
      have im := ennInfOn.member with fB
      rw ennColumnSums.apply with hB
      have mf : ∀ A ∈ P, measureFamily(μ, interWith(P, B), P)(A) ∈ ennreal
        intros A hA
        rw measureFamily.apply with hA
        rw interWith.apply with hA
        obtain ⟨mA, AX⟩ := MeasurablePartition.pieces with space, partition, hA
        exact Measure.member with measure, (MeasurableSet.inter with space, mA, mB)
      have split := Measure.partition_inter_sum with measure, partition, mB
      rw ← ennTsum.finite with fin, mf at split
      rw ← split
      have product : ∀ A ∈ P, ennConstMulOn(ennInfOn(f, B), measureFamily(μ, interWith(P, B), P), P)(A) = ennMul(ennInfOn(f, B), measureFamily(μ, interWith(P, B), P)(A))
        intros A hA
        exact ennConstMulOn.apply with hA
      rw ← ennTsum.mul_left with mf, im, product
      have pM : ∀ A ∈ P, ennConstMulOn(ennInfOn(f, B), measureFamily(μ, interWith(P, B), P), P)(A) ∈ ennreal
        intros A hA
        rw product with A, hA
        exact ennMul.member with im, (mf with A, hA)
      have fM : ∀ A ∈ P, familyAt(crossTerms(μ, c, P, Q), P, B)(A) ∈ ennreal
        intros A hA
        rw familyAt.apply with hA
        exact crossM with A, hA, B, hB
      apply ennTsum.mono with pM, fM
      intros A hA
      rw product with A, hA
      rw familyAt.apply with hA
      rw cross with A, hA, B, hB
      rw measureFamily.apply with hA
      rw interWith.apply with hA
      have ii := intersection.commutative at A, B
      rw ii
      obtain ⟨mA, AX⟩ := MeasurablePartition.pieces with space, partition, hA
      have iM := Measure.member with measure, (MeasurableSet.inter with space, mB, mA)
      have cA := values with A, hA
      by_cases ne : ∃ x, x ∈ B ∩ A
      . obtain ⟨x, xBA⟩ := ne
        obtain ⟨xB, xA⟩ := intersection.membership.forward with xBA
        have l1 := ennInfOn.le_value with fB, xB
        rw constant with A, hA, x, xA at l1
        exact ennMul.mono with l1, (EnnLe.reflexive with iM)
      . have Ie : B ∩ A = ∅
          ext x
          constructor
          . intro h
            exfalso
            exact ne with ⟨x, h⟩
          . intro h
            simp at h
        rw Ie
        rw Measure.empty with measure
        rw ennMul.zero_right with im, rfl
        exact EnnLe.zero with (ennMul.member with cA, ennreal.zero_member)
    have l := lowerSum.le_terms with measure, qpart, vF, colM, le
    rw ← ennTsum.finite with finQ, colM at l
    rw ← comm at l
    rw ennTsum.congr with rows at l
    rw ennTsum.finite with fin, sM at l
    exact l
  exact EnnLe.antisymmetric with upper, lower

-- Mathlib's lintegral_indicator_const and lintegral_indicator_one.
theorem lintegral.indicator_const (X μ S c : Set)
  requires measure : Measure(X, μ)
  requires set : MeasurableSet(X, S)
  requires member : c ∈ ennreal
  shows lintegral(X, μ, indicatorOn(MeasurableSpace.carrier(X), S, c, realZero)) =
    ennMul(c, μ(S))
proof
  have space := Measure.space with measure
  have SX := MeasurableSet.subset with space, set
  have zm := ennreal.zero_member
  have vF : ∀ x ∈ MeasurableSpace.carrier(X), indicatorOn(MeasurableSpace.carrier(X), S, c, realZero)(x) ∈ ennreal
    intros x hx
    obtain ⟨inS, outS⟩ := indicatorOn.apply at MeasurableSpace.carrier(X), S, c, realZero, x with hx
    by_cases xS : x ∈ S
    . rw inS with xS
      exact member
    . rw outS with xS
      exact zm
  have mS := Measure.member with measure, set
  have vm := ennMul.member with member, mS
  have lM := lintegral.member at X, μ, indicatorOn(MeasurableSpace.carrier(X), S, c, realZero) with measure
  have upper : EnnLe(lintegral(X, μ, indicatorOn(MeasurableSpace.carrier(X), S, c, realZero)), ennMul(c, μ(S)))
    apply lintegral.le_of_all with vm
    intros P partition
    have p2 := partition
    obtain ⟨fin, sub, cover, disj⟩ := p2
    have vM : ∀ A ∈ P, measureFamily(μ, interWith(P, S), P)(A) ∈ ennreal
      intros A hA
      rw measureFamily.apply with hA
      rw interWith.apply with hA
      obtain ⟨mA, AX⟩ := MeasurablePartition.pieces with space, partition, hA
      exact Measure.member with measure, (MeasurableSet.inter with space, mA, set)
    have product : ∀ A ∈ P, ennConstMulOn(c, measureFamily(μ, interWith(P, S), P), P)(A) = ennMul(c, measureFamily(μ, interWith(P, S), P)(A))
      intros A hA
      exact ennConstMulOn.apply with hA
    have vT : ∀ A ∈ P, ennConstMulOn(c, measureFamily(μ, interWith(P, S), P), P)(A) ∈ ennreal
      intros A hA
      rw product with A, hA
      exact ennMul.member with member, (vM with A, hA)
    have le : ∀ A ∈ P, EnnLe(ennMul(ennInfOn(indicatorOn(MeasurableSpace.carrier(X), S, c, realZero), A), μ(A)), ennConstMulOn(c, measureFamily(μ, interWith(P, S), P), P)(A))
      intros A hA
      have tM := vT with A, hA
      rw product with A, hA
      rw measureFamily.apply with hA
      rw interWith.apply with hA
      obtain ⟨mA, AX⟩ := MeasurablePartition.pieces with space, partition, hA
      have mm := Measure.member with measure, mA
      have fv : ∀ x ∈ A, indicatorOn(MeasurableSpace.carrier(X), S, c, realZero)(x) ∈ ennreal
        intros x hx
        exact vF with x, (AX with x, hx)
      have im := ennInfOn.member with fv
      have rM := ennMul.member with member, (Measure.member with measure, (MeasurableSet.inter with space, mA, set))
      by_cases out : ∃ x ∈ A, x ∉ S
      . obtain ⟨x, xA, xS⟩ := out
        obtain ⟨inS, outS⟩ := indicatorOn.apply at MeasurableSpace.carrier(X), S, c, realZero, x with (AX with x, xA)
        have l1 := ennInfOn.le_value with fv, xA
        rw outS with xS at l1
        have z := EnnLe.zero_iff with l1
        rw z
        rw ennMul.zero with mm
        exact EnnLe.zero with rM
      . by_cases ne : ∃ x, x ∈ A
        . obtain ⟨x, xA⟩ := ne
          have AS : A ⊆ S
            intros y hy
            by_contra yS
            exact out with ⟨y, hy, yS⟩
          have constant : ∀ y ∈ A, indicatorOn(MeasurableSpace.carrier(X), S, c, realZero)(y) = c
            intros y hy
            obtain ⟨inS, outS⟩ := indicatorOn.apply at MeasurableSpace.carrier(X), S, c, realZero, y with (AX with y, hy)
            exact inS with (AS with y, hy)
          rw ennInfOn.const with xA, member, constant
          have same : A ∩ S = A
            ext y
            constructor
            . intro h
              obtain ⟨yA, yS⟩ := intersection.membership.forward with h
              exact yA
            . intro h
              exact intersection.membership.backward with h, (AS with y, h)
          rw same
          exact EnnLe.reflexive with (ennMul.member with member, mm)
        . have Ae : A = ∅
            ext x
            constructor
            . intro h
              exfalso
              exact ne with ⟨x, h⟩
            . intro h
              simp at h
          rw Ae
          rw Ae at rM
          rw partitionTerm.empty with measure
          exact EnnLe.zero with rM
    have l := lowerSum.le_terms with measure, partition, vF, vT, le
    have m := ennFiniteSum.mul_left with fin, vM, member, product
    rw m at l
    rw Measure.partition_inter_sum with measure, partition, set at l
    exact l
  have lower : EnnLe(ennMul(c, μ(S)), lintegral(X, μ, indicatorOn(MeasurableSpace.carrier(X), S, c, realZero)))
    by_cases ne : ∃ x, x ∈ S
    . obtain ⟨x, xS⟩ := ne
      have cS := MeasurableSet.compl with space, set
      have distinct : S ≠ MeasurableSpace.carrier(X) ∖ S
        intro e
        have x2 : x ∈ MeasurableSpace.carrier(X) ∖ S
          rw ← e
          exact xS
        obtain ⟨a, b⟩ := difference.membership.forward with x2
        exact b with xS
      have fp := Finite.pair_set at S, MeasurableSpace.carrier(X) ∖ S
      have sub : {S, MeasurableSpace.carrier(X) ∖ S} ⊆ MeasurableSpace.sets(X)
        intros A hA
        simp at hA
        cases hA with a | b
        . rw a
          unfold MeasurableSet at set
          exact set
        . rw b
          unfold MeasurableSet at cS
          exact cS
      have cover : ⋃({S, MeasurableSpace.carrier(X) ∖ S}) = MeasurableSpace.carrier(X)
        ext y
        constructor
        . intro h
          obtain ⟨A, hA, yA⟩ := union.membership.forward with h
          simp at hA
          cases hA with a | b
          . rw a at yA
            exact SX with y, yA
          . rw b at yA
            obtain ⟨p, q⟩ := difference.membership.forward with yA
            exact p
        . intro h
          by_cases yS : y ∈ S
          . have AIn : S ∈ {S, MeasurableSpace.carrier(X) ∖ S} by simp
            exact union.membership.backward with ⟨S, AIn, yS⟩
          . have AIn : MeasurableSpace.carrier(X) ∖ S ∈ {S, MeasurableSpace.carrier(X) ∖ S} by simp
            have yD := difference.membership.backward with ⟨h, yS⟩
            exact union.membership.backward with ⟨MeasurableSpace.carrier(X) ∖ S, AIn, yD⟩
      have disj : ∀ A ∈ {S, MeasurableSpace.carrier(X) ∖ S}, ∀ B ∈ {S, MeasurableSpace.carrier(X) ∖ S}, A ≠ B → Disjoint(A, B)
        intros A hA B hB neAB
        apply Disjoint.iff.backward
        intros y yA yB
        simp at hA
        simp at hB
        cases hA with a1 | a2
        . cases hB with b1 | b2
          . exfalso
            apply neAB
            rw [a1, b1]
          . rw a1 at yA
            rw b2 at yB
            obtain ⟨p, q⟩ := difference.membership.forward with yB
            exact q with yA
        . cases hB with b1 | b2
          . rw a2 at yA
            rw b1 at yB
            obtain ⟨p, q⟩ := difference.membership.forward with yA
            exact q with yB
          . exfalso
            apply neAB
            rw [a2, b2]
      have partition : MeasurablePartition(X, {S, MeasurableSpace.carrier(X) ∖ S})
        unfold MeasurablePartition
        exact ⟨fp, sub, cover, disj⟩
      have SIn : S ∈ {S, MeasurableSpace.carrier(X) ∖ S} by simp
      have DIn : MeasurableSpace.carrier(X) ∖ S ∈ {S, MeasurableSpace.carrier(X) ∖ S} by simp
      have fvS : ∀ y ∈ S, indicatorOn(MeasurableSpace.carrier(X), S, c, realZero)(y) ∈ ennreal
        intros y hy
        exact vF with y, (SX with y, hy)
      have fvD : ∀ y ∈ MeasurableSpace.carrier(X) ∖ S, indicatorOn(MeasurableSpace.carrier(X), S, c, realZero)(y) ∈ ennreal
        intros y hy
        obtain ⟨p, q⟩ := difference.membership.forward with hy
        exact vF with y, p
      have mD := Measure.member with measure, cS
      have tS : partitionTerms(μ, indicatorOn(MeasurableSpace.carrier(X), S, c, realZero), {S, MeasurableSpace.carrier(X) ∖ S})(S) ∈ ennreal
        rw partitionTerms.apply with SIn
        exact ennMul.member with (ennInfOn.member with fvS), mS
      have tD : partitionTerms(μ, indicatorOn(MeasurableSpace.carrier(X), S, c, realZero), {S, MeasurableSpace.carrier(X) ∖ S})(MeasurableSpace.carrier(X) ∖ S) ∈ ennreal
        rw partitionTerms.apply with DIn
        exact ennMul.member with (ennInfOn.member with fvD), mD
      have pr := ennFiniteSum.pair with tS, tD, distinct
      have constant : ∀ y ∈ S, indicatorOn(MeasurableSpace.carrier(X), S, c, realZero)(y) = c
        intros y hy
        obtain ⟨inS, outS⟩ := indicatorOn.apply at MeasurableSpace.carrier(X), S, c, realZero, y with (SX with y, hy)
        exact inS with hy
      have tSe := partitionTerms.apply at μ, indicatorOn(MeasurableSpace.carrier(X), S, c, realZero), {S, MeasurableSpace.carrier(X) ∖ S}, S with SIn
      rw ennInfOn.const with xS, member, constant at tSe
      rw tSe at pr
      rw tSe at tS
      have sm : lowerSum(μ, indicatorOn(MeasurableSpace.carrier(X), S, c, realZero), {S, MeasurableSpace.carrier(X) ∖ S}) ∈ ennreal
        unfold lowerSum
        rw pr
        exact ennAdd.member with tS, tD
      have up := lintegral.upper with partition, sm
      unfold lowerSum at up
      rw pr at up
      have sa := EnnLe.self_add with tS, tD
      exact EnnLe.transitive with sa, up
    . have Se : S = ∅
        ext x
        constructor
        . intro h
          exfalso
          exact ne with ⟨x, h⟩
        . intro h
          simp at h
      have z : μ(S) = realZero
        rw Se
        exact Measure.empty with measure
      rw z
      rw ennMul.zero_right with member, rfl
      exact EnnLe.zero with lM
  exact EnnLe.antisymmetric with upper, lower

-- Mathlib's lintegral_indicator: the integral of f · 1_S is the integral
-- of f over S.
theorem lintegral.indicator (X μ f S : Set)
  requires measure : Measure(X, μ)
  requires values : EnnValued(X, f)
  requires set : MeasurableSet(X, S)
  shows lintegral(X, μ, ennIndicatorOn(MeasurableSpace.carrier(X), S, f)) =
    setLIntegral(X, μ, f, S)
proof
  sorry

-- Mathlib's lintegral_indicator_le / lintegral_indicator_const_le for a
-- non-measurable set: ∫⁻ c · 1_A ≤ c · μ(A) with μ(A) the outer value.
theorem lintegral.indicator_const_le (X μ A c : Set)
  requires measure : Measure(X, μ)
  requires member : c ∈ ennreal
  requires inside : A ⊆ MeasurableSpace.carrier(X)
  shows EnnLe(lintegral(X, μ, indicatorOn(MeasurableSpace.carrier(X), A, c, realZero)),
    ennMul(c, measureOf(X, μ, A)))
proof
  sorry

-- Bounds by constants (Mathlib's lintegral_le_const... and iInf_le_lintegral
-- in the form used: a bound c on f gives ∫⁻ f ≤ c · μ(X)).
theorem lintegral.le_const (X μ f c : Set)
  requires measure : Measure(X, μ)
  requires values : EnnValued(X, f)
  requires member : c ∈ ennreal
  requires bound : ∀ x ∈ MeasurableSpace.carrier(X), EnnLe(f(x), c)
  shows EnnLe(lintegral(X, μ, f), ennMul(c, μ(MeasurableSpace.carrier(X))))
proof
  have space := Measure.space with measure
  have u := MeasurableSet.univ with space
  have vm := ennMul.member with member, (Measure.member with measure, u)
  have vF : ∀ x ∈ MeasurableSpace.carrier(X), f(x) ∈ ennreal
    unfold EnnValued at values
    unfold MapsInto at values
    exact values
  apply lintegral.le_of_all with vm
  intros P partition
  have p2 := partition
  obtain ⟨fin, sub, cover, disj⟩ := p2
  have vT : ∀ A ∈ P, partitionTerms(μ, constantOn(MeasurableSpace.carrier(X), c), P)(A) ∈ ennreal
    intros A hA
    rw partitionTerms.const with measure, member, partition, hA
    obtain ⟨mA, AX⟩ := MeasurablePartition.pieces with space, partition, hA
    exact ennMul.member with member, (Measure.member with measure, mA)
  have le : ∀ A ∈ P, EnnLe(ennMul(ennInfOn(f, A), μ(A)), partitionTerms(μ, constantOn(MeasurableSpace.carrier(X), c), P)(A))
    intros A hA
    rw partitionTerms.const with measure, member, partition, hA
    obtain ⟨mA, AX⟩ := MeasurablePartition.pieces with space, partition, hA
    have mm := Measure.member with measure, mA
    have fv : ∀ x ∈ A, f(x) ∈ ennreal
      intros x hx
      exact vF with x, (AX with x, hx)
    by_cases ne : ∃ x, x ∈ A
    . obtain ⟨x, xA⟩ := ne
      have l1 := ennInfOn.le_value with fv, xA
      have l2 := bound with x, (AX with x, xA)
      have l3 := EnnLe.transitive with l1, l2
      exact ennMul.mono with l3, (EnnLe.reflexive with mm)
    . have Ae : A = ∅
        ext x
        constructor
        . intro h
          exfalso
          exact ne with ⟨x, h⟩
        . intro h
          simp at h
      rw Ae
      rw partitionTerm.empty with measure
      rw Measure.empty with measure
      rw ennMul.zero_right with member, rfl
      exact EnnLe.reflexive with ennreal.zero_member
  have l := lowerSum.le_terms with measure, partition, vF, vT, le
  unfold lowerSum at l
  have e := lowerSum.const with measure, member, partition
  unfold lowerSum at e
  rw e at l
  unfold lowerSum
  exact l

theorem lintegral.const_le (X μ f c : Set)
  requires measure : Measure(X, μ)
  requires values : EnnValued(X, f)
  requires member : c ∈ ennreal
  requires bound : ∀ x ∈ MeasurableSpace.carrier(X), EnnLe(c, f(x))
  shows EnnLe(ennMul(c, μ(MeasurableSpace.carrier(X))), lintegral(X, μ, f))
proof
  have space := Measure.space with measure
  have u := MeasurableSet.univ with space
  have mm := Measure.member with measure, u
  have vF : ∀ x ∈ MeasurableSpace.carrier(X), f(x) ∈ ennreal
    unfold EnnValued at values
    unfold MapsInto at values
    exact values
  have whole := MeasurablePartition.whole with space
  have cIn : MeasurableSpace.carrier(X) ∈ {MeasurableSpace.carrier(X)} by simp
  have im := ennInfOn.member with vF
  have tm : partitionTerms(μ, f, {MeasurableSpace.carrier(X)})(MeasurableSpace.carrier(X)) ∈ ennreal
    rw partitionTerms.apply with cIn
    exact ennMul.member with im, mm
  have single := ennFiniteSum.singleton with tm
  rw partitionTerms.apply with cIn at single
  have sm : lowerSum(μ, f, {MeasurableSpace.carrier(X)}) ∈ ennreal
    unfold lowerSum
    rw single
    exact ennMul.member with im, mm
  have up := lintegral.upper with whole, sm
  unfold lowerSum at up
  rw single at up
  have ge := ennInfOn.ge with vF, member, bound
  have l := ennMul.mono with ge, (EnnLe.reflexive with mm)
  exact EnnLe.transitive with l, up

-- Mathlib's IsFiniteMeasure.lintegral_lt_top_of_bounded_to_ennreal.
theorem lintegral.finite_of_bounded (X μ f : Set, C : Real)
  requires finite : FiniteMeasure(X, μ)
  requires values : EnnValued(X, f)
  requires bound : ∀ x ∈ MeasurableSpace.carrier(X), EnnLe(f(x), C)
  shows lintegral(X, μ, f) ≠ ennTop
proof
  obtain ⟨measure, fin⟩ := finite
  have space := Measure.space with measure
  have u := MeasurableSet.univ with space
  have mm := Measure.member with measure, u
  have vF : ∀ x ∈ MeasurableSpace.carrier(X), f(x) ∈ ennreal
    unfold EnnValued at values
    unfold MapsInto at values
    exact values
  have CR : C ∈ ℝ by typecheck
  obtain ⟨om, oT⟩ := ennOfReal.member at C
  have bound2 : ∀ x ∈ MeasurableSpace.carrier(X), EnnLe(f(x), ennOfReal(C))
    intros x hx
    have b := bound with x, hx
    have b2 := b
    obtain ⟨m1, m2, alt⟩ := b2
    have c := ennreal.cases with m2
    cases c with t | fin2
    . exfalso
      have nt := ennreal.not_top_of_real with CR
      exact nt with t
    . rw ennOfReal.of_nonneg with fin2.right
      exact b
  have le := lintegral.le_const with measure, values, om, bound2
  obtain ⟨oR, oN⟩ := ennreal.finite with om, oT
  obtain ⟨μR, μN⟩ := ennreal.finite with mm, fin
  rw ennMul.finite with oR, μR, oN, μN at le
  have pR : R[ennOfReal(C) * μ(MeasurableSpace.carrier(X))] ∈ ℝ
    have a : Real(ennOfReal(C)) by exact oR
    have b : Real(μ(MeasurableSpace.carrier(X))) by exact μR
    typecheck
  have pT := ennreal.not_top_of_real with pR
  intro top
  rw top at le
  have e := EnnLe.top_eq with le
  exact pT with e

-- Section: Refinement helpers
-- The lower sum over the refinement of a partition P by measurable pieces
-- s(C) ⊆ C (one for each C ∈ P), indexed by P.
def lintPieceTerms (μ f s P : Set) : Set :=
  { (C, ennMul(ennInfOn(f, s(C)), μ(s(C)))) | C ∈ P }

theorem lintPieceTerms.apply (μ f s P C : Set)
  requires member : C ∈ P
  shows lintPieceTerms(μ, f, s, P)(C) = ennMul(ennInfOn(f, s(C)), μ(s(C)))
proof
  have edge : (C, ennMul(ennInfOn(f, s(C)), μ(s(C)))) ∈ lintPieceTerms(μ, f, s, P)
    apply lintPieceTerms.membership.backward
    exact ⟨C, member, rfl⟩
  have pairs : ∀ p ∈ lintPieceTerms(μ, f, s, P), ∃ a, ∃ b, p = (a, b)
    intros p hp
    obtain ⟨k0, hk, pEq⟩ := lintPieceTerms.membership.forward with hp
    rw ← pEq
    exact ⟨k0, ennMul(ennInfOn(f, s(k0)), μ(s(k0))), rfl⟩
  have functional : ∀ a, ∀ b, ∀ c, (a, b) ∈ lintPieceTerms(μ, f, s, P) → (a, c) ∈ lintPieceTerms(μ, f, s, P) → b = c
    intros a b c hb hc
    obtain ⟨k0, hk, bEq⟩ := lintPieceTerms.membership.forward with hb
    obtain ⟨m0, hm, cEq⟩ := lintPieceTerms.membership.forward with hc
    obtain ⟨ka, bb⟩ := orderedPair.injective with bEq
    obtain ⟨ma, cc⟩ := orderedPair.injective with cEq
    rw [← bb, ← cc, ka, ← ma]
  exact pairGraph.apply with pairs, functional, edge


theorem valuesOn.lint_insert (s H a : Set)
  shows valuesOn(s, H ∪ {a}) = valuesOn(s, H) ∪ {s(a)}
proof
  ext y
  constructor
  . intro h
    obtain ⟨i, hi, e⟩ := valuesOn.membership.forward with h
    have c := union2.membership.forward with hi
    cases c with iH | ia
    . have inV : s(i) ∈ valuesOn(s, H) := valuesOn.membership.backward with ⟨i, iH, rfl⟩
      rw ← e
      simp [inV]
    . simp at ia
      rw ← e
      rw ia
      simp
  . intro h
    have c := union2.membership.forward with h
    cases c with yV | ya
    . obtain ⟨i, hi, e⟩ := valuesOn.membership.forward with yV
      have iU : i ∈ H ∪ {a} by simp [hi]
      exact valuesOn.membership.backward with ⟨i, iU, e⟩
    . simp at ya
      have aU : a ∈ H ∪ {a} by simp
      rw ya
      exact valuesOn.membership.backward with ⟨a, aU, rfl⟩

theorem valuesOn.lint_empty (s : Set)
  shows valuesOn(s, ∅) = ∅
proof
  ext y
  constructor
  . intro h
    obtain ⟨i, hi, e⟩ := valuesOn.membership.forward with h
    simp at hi
  . intro h
    simp at h

theorem valuesOn.lint_finite (s P : Set)
  requires finite : Finite(P)
  shows Finite(valuesOn(s, P))
proof
  induction finite with H a
  | empty =>
    rw valuesOn.lint_empty
    exact Finite.empty
  | insert using ih =>
    rw valuesOn.lint_insert
    exact Finite.union with ih, (Finite.singleton at s(a))

-- A finite sum over the values s(C) is the sum over the indices C when
-- two indices share a value only where the term vanishes.
theorem ennFiniteSum.lint_image (t s g P : Set)
  requires finite : Finite(P)
  requires values : ∀ A ∈ P, g(A) ∈ ennreal
  requires agree : ∀ A ∈ P, g(A) = t(s(A))
  requires collide : ∀ A ∈ P, ∀ B ∈ P, A ≠ B → s(A) = s(B) → g(A) = realZero
  shows ennFiniteSum(t, valuesOn(s, P)) = ennFiniteSum(g, P)
proof
  induction finite with H a
  | empty =>
    rw valuesOn.lint_empty
    rw ennFiniteSum.empty
    rw ennFiniteSum.empty
  | insert using ih =>
    have valuesH : ∀ A ∈ H, g(A) ∈ ennreal
      intros A hA
      exact values with A, (HSubset with A, hA)
    have tH : ∀ D ∈ valuesOn(s, H), t(D) ∈ ennreal
      intros D hD
      obtain ⟨i, hi, e⟩ := valuesOn.membership.forward with hD
      rw ← e
      have iP := HSubset with i, hi
      have ag := agree with i, iP
      rw ← ag
      exact values with i, iP
    have ga := values with a, aMember
    have aga := agree with a, aMember
    have gv : ∀ A ∈ H ∪ {a}, g(A) ∈ ennreal
      intros A hA
      have c := union2.membership.forward with hA
      cases c with aH | aa
      . exact valuesH with A, aH
      . simp at aa
        rw aa
        exact ga
    have fv := valuesOn.lint_finite at s, H with HFinite
    have sH := ennFiniteSum.member with fv, tH
    have stepG := ennFiniteSum.insert with HFinite, gv, aFresh
    rw stepG
    rw ← ih
    rw valuesOn.lint_insert
    by_cases old : s(a) ∈ valuesOn(s, H)
    . obtain ⟨B, hB, e⟩ := valuesOn.membership.forward with old
      have BP := HSubset with B, hB
      have ne : a ≠ B
        intro same
        apply aFresh
        rw same
        exact hB
      have e2 : s(a) = s(B)
        symm
        exact e
      have z := collide with a, aMember, B, BP, ne, e2
      have same : valuesOn(s, H) ∪ {s(a)} = valuesOn(s, H)
        ext y
        constructor
        . intro h
          have c := union2.membership.forward with h
          cases c with yV | ya
          . exact yV
          . simp at ya
            rw ya
            exact old
        . intro h
          simp [h]
      rw same
      rw z
      rw ennAdd.zero with sH
    . have tv : ∀ D ∈ valuesOn(s, H) ∪ {s(a)}, t(D) ∈ ennreal
        intros D hD
        have c := union2.membership.forward with hD
        cases c with dV | da
        . exact tH with D, dV
        . simp at da
          rw da
          rw ← aga
          exact ga
      have step := ennFiniteSum.insert at t, valuesOn(s, H), s(a) with fv, tv, old
      rw step
      rw aga

-- A lower bound for the integral from values b(C) taken below f on
-- measurable pieces s(C) ⊆ C of a partition P.
theorem lintegral.lint_lower (X μ f P s b h : Set)
  requires measure : Measure(X, μ)
  requires values : EnnValued(X, f)
  requires partition : MeasurablePartition(X, P)
  requires sets : ∀ C ∈ P, MeasurableSet(X, s(C))
  requires inside : ∀ C ∈ P, s(C) ⊆ C
  requires bvalues : ∀ C ∈ P, b(C) ∈ ennreal
  requires bound : ∀ C ∈ P, ∀ x ∈ s(C), EnnLe(b(C), f(x))
  requires terms : ∀ C ∈ P, h(C) = ennMul(b(C), μ(s(C)))
  shows EnnLe(ennFiniteSum(h, P), lintegral(X, μ, f))
proof
  have space := Measure.space with measure
  have p2 := partition
  obtain ⟨fin, sub, cover, disj⟩ := p2
  have vF : ∀ x ∈ MeasurableSpace.carrier(X), f(x) ∈ ennreal
    unfold EnnValued at values
    unfold MapsInto at values
    exact values
  have pieceX : ∀ C ∈ P, C ⊆ MeasurableSpace.carrier(X)
    intros C hC
    have pc := MeasurablePartition.pieces with space, partition, hC
    exact pc.right
  have sX : ∀ C ∈ P, s(C) ⊆ MeasurableSpace.carrier(X)
    intros C hC x hx
    exact pieceX with C, hC, x, (inside with C, hC, x, hx)
  have Q1fin := valuesOn.lint_finite at s, P with fin
  have Q1sets : ∀ D ∈ valuesOn(s, P), MeasurableSet(X, D)
    intros D hD
    obtain ⟨C, hC, e⟩ := valuesOn.membership.forward with hD
    rw ← e
    exact sets with C, hC
  have Umeas := MeasurableSet.countable_union_helper with space, (Countable.of_finite with Q1fin), Q1sets
  have Rmeas := MeasurableSet.compl with space, Umeas
  have Qfin := Finite.union with Q1fin, (Finite.singleton at MeasurableSpace.carrier(X) ∖ ⋃(valuesOn(s, P)))
  have Qsets : valuesOn(s, P) ∪ {MeasurableSpace.carrier(X) ∖ ⋃(valuesOn(s, P))} ⊆ MeasurableSpace.sets(X)
    intros D hD
    have c := union2.membership.forward with hD
    cases c with d1 | d2
    . have m := Q1sets with D, d1
      unfold MeasurableSet at m
      exact m
    . simp at d2
      rw d2
      unfold MeasurableSet at Rmeas
      exact Rmeas
  have Qcover : ⋃(valuesOn(s, P) ∪ {MeasurableSpace.carrier(X) ∖ ⋃(valuesOn(s, P))}) = MeasurableSpace.carrier(X)
    ext x
    constructor
    . intro hx
      obtain ⟨D, hD, xD⟩ := union.membership.forward with hx
      have c := union2.membership.forward with hD
      cases c with d1 | d2
      . obtain ⟨C, hC, e⟩ := valuesOn.membership.forward with d1
        rw ← e at xD
        exact sX with C, hC, x, xD
      . simp at d2
        rw d2 at xD
        simp at xD
        exact xD.left
    . intro hx
      by_cases inU : x ∈ ⋃(valuesOn(s, P))
      . obtain ⟨D, hD, xD⟩ := union.membership.forward with inU
        have dQ : D ∈ valuesOn(s, P) ∪ {MeasurableSpace.carrier(X) ∖ ⋃(valuesOn(s, P))} by simp [hD]
        exact union.membership.backward with ⟨D, dQ, xD⟩
      . have xR : x ∈ MeasurableSpace.carrier(X) ∖ ⋃(valuesOn(s, P)) by simp [hx, inU]
        have dQ : MeasurableSpace.carrier(X) ∖ ⋃(valuesOn(s, P)) ∈ valuesOn(s, P) ∪ {MeasurableSpace.carrier(X) ∖ ⋃(valuesOn(s, P))} by simp
        exact union.membership.backward with ⟨MeasurableSpace.carrier(X) ∖ ⋃(valuesOn(s, P)), dQ, xR⟩
  have pieceDisj : ∀ C ∈ P, ∀ C2 ∈ P, s(C) ≠ s(C2) → Disjoint(s(C), s(C2))
    intros C hC C2 hC2 ne
    have neC : C ≠ C2
      intro same
      apply ne
      rw same
    have d := disj with C, hC, C2, hC2, neC
    unfold Disjoint at d
    unfold Disjoint
    ext x
    constructor
    . intro hx
      obtain ⟨a1, a2⟩ := intersection.membership.forward with hx
      have m := intersection.membership.backward with (inside with C, hC, x, a1), (inside with C2, hC2, x, a2)
      rw d at m
      exact m
    . intro hx
      simp at hx
  have Qdisj : ∀ A ∈ valuesOn(s, P) ∪ {MeasurableSpace.carrier(X) ∖ ⋃(valuesOn(s, P))}, ∀ B ∈ valuesOn(s, P) ∪ {MeasurableSpace.carrier(X) ∖ ⋃(valuesOn(s, P))}, A ≠ B → Disjoint(A, B)
    intros A hA B hB ne
    unfold Disjoint
    ext x
    constructor
    . intro hx
      obtain ⟨xA, xB⟩ := intersection.membership.forward with hx
      have cA := union2.membership.forward with hA
      have cB := union2.membership.forward with hB
      cases cA with a1 | a2
      . cases cB with b1 | b2
        . obtain ⟨C, hC, eA⟩ := valuesOn.membership.forward with a1
          obtain ⟨C2, hC2, eB⟩ := valuesOn.membership.forward with b1
          have ne2 : s(C) ≠ s(C2)
            intro same
            apply ne
            rw [← eA, ← eB, same]
          have d := pieceDisj with C, hC, C2, hC2, ne2
          unfold Disjoint at d
          rw ← eA at xA
          rw ← eB at xB
          have m := intersection.membership.backward with xA, xB
          rw d at m
          exact m
        . simp at b2
          rw b2 at xB
          simp at xB
          have u := union.membership.backward with ⟨A, a1, xA⟩
          exfalso
          exact xB.right with u
      . simp at a2
        rw a2 at xA
        simp at xA
        cases cB with b1 | b2
        . have u := union.membership.backward with ⟨B, b1, xB⟩
          exfalso
          exact xA.right with u
        . simp at b2
          exfalso
          apply ne
          rw [a2, b2]
    . intro hx
      simp at hx
  have Qpart : MeasurablePartition(X, valuesOn(s, P) ∪ {MeasurableSpace.carrier(X) ∖ ⋃(valuesOn(s, P))})
    unfold MeasurablePartition
    exact ⟨Qfin, Qsets, Qcover, Qdisj⟩
  have termV : ∀ D ∈ valuesOn(s, P) ∪ {MeasurableSpace.carrier(X) ∖ ⋃(valuesOn(s, P))}, partitionTerms(μ, f, valuesOn(s, P) ∪ {MeasurableSpace.carrier(X) ∖ ⋃(valuesOn(s, P))})(D) ∈ ennreal
    intros D hD
    rw partitionTerms.apply with hD
    have DX : D ⊆ MeasurableSpace.carrier(X)
      have m := Qsets with D, hD
      have m2 : MeasurableSet(X, D)
        unfold MeasurableSet
        exact m
      exact MeasurableSet.subset with space, m2
    have vD : ∀ x ∈ D, f(x) ∈ ennreal
      intros x hx
      exact vF with x, (DX with x, hx)
    have m := Qsets with D, hD
    have m2 : MeasurableSet(X, D)
      unfold MeasurableSet
      exact m
    exact ennMul.member with (ennInfOn.member with vD), (Measure.member with measure, m2)
  have sumM : lowerSum(μ, f, valuesOn(s, P) ∪ {MeasurableSpace.carrier(X) ∖ ⋃(valuesOn(s, P))}) ∈ ennreal
    unfold lowerSum
    exact ennFiniteSum.member with Qfin, termV
  have up := lintegral.upper with Qpart, sumM
  have sub1 : valuesOn(s, P) ⊆ valuesOn(s, P) ∪ {MeasurableSpace.carrier(X) ∖ ⋃(valuesOn(s, P))}
    intros D hD
    simp [hD]
  have mono1 := ennFiniteSum.mono_set with Qfin, sub1, termV
  have gV : ∀ C ∈ P, lintPieceTerms(μ, f, s, P)(C) ∈ ennreal
    intros C hC
    rw lintPieceTerms.apply with hC
    have vD : ∀ x ∈ s(C), f(x) ∈ ennreal
      intros x hx
      exact vF with x, (sX with C, hC, x, hx)
    exact ennMul.member with (ennInfOn.member with vD), (Measure.member with measure, (sets with C, hC))
  have agree : ∀ C ∈ P, lintPieceTerms(μ, f, s, P)(C) = partitionTerms(μ, f, valuesOn(s, P) ∪ {MeasurableSpace.carrier(X) ∖ ⋃(valuesOn(s, P))})(s(C))
    intros C hC
    have sQ1 : s(C) ∈ valuesOn(s, P) := valuesOn.membership.backward with ⟨C, hC, rfl⟩
    have sQ := sub1 with s(C), sQ1
    rw lintPieceTerms.apply with hC
    rw partitionTerms.apply with sQ
  have collide : ∀ A ∈ P, ∀ B ∈ P, A ≠ B → s(A) = s(B) → lintPieceTerms(μ, f, s, P)(A) = realZero
    intros A hA B hB ne e
    have d := disj with A, hA, B, hB, ne
    unfold Disjoint at d
    have empty : s(A) = ∅
      ext x
      constructor
      . intro hx
        have xB : x ∈ s(B)
          rw ← e
          exact hx
        have m := intersection.membership.backward with (inside with A, hA, x, hx), (inside with B, hB, x, xB)
        rw d at m
        exact m
      . intro hx
        simp at hx
    rw lintPieceTerms.apply with hA
    rw empty
    exact partitionTerm.empty with measure
  have img := ennFiniteSum.lint_image with fin, gV, agree, collide
  have hV : ∀ C ∈ P, h(C) ∈ ennreal
    intros C hC
    rw terms with C, hC
    exact ennMul.member with (bvalues with C, hC), (Measure.member with measure, (sets with C, hC))
  have hle : ∀ C ∈ P, EnnLe(h(C), lintPieceTerms(μ, f, s, P)(C))
    intros C hC
    rw terms with C, hC
    rw lintPieceTerms.apply with hC
    have vD : ∀ x ∈ s(C), f(x) ∈ ennreal
      intros x hx
      exact vF with x, (sX with C, hC, x, hx)
    have bi := ennInfOn.ge with vD, (bvalues with C, hC), (bound with C, hC)
    have mm := Measure.member with measure, (sets with C, hC)
    exact ennMul.mono with bi, (EnnLe.reflexive with mm)
  have mono2 := ennFiniteSum.mono_fun with fin, hV, gV, hle
  rw img at mono1
  unfold lowerSum at up
  have t1 := EnnLe.transitive with mono2, mono1
  exact EnnLe.transitive with t1, up

-- Removing a null set does not change the measure.
theorem Measure.lint_diff_null (X μ C N : Set)
  requires measure : Measure(X, μ)
  requires setC : MeasurableSet(X, C)
  requires setN : MeasurableSet(X, N)
  requires null : μ(N) = realZero
  shows μ(C ∖ N) = μ(C)
proof
  have space := Measure.space with measure
  have CN := MeasurableSet.inter with space, setC, setN
  have sub : C ∩ N ⊆ C
    intros x hx
    obtain ⟨a, b⟩ := intersection.membership.forward with hx
    exact a
  have sub2 : C ∩ N ⊆ N
    intros x hx
    obtain ⟨a, b⟩ := intersection.membership.forward with hx
    exact b
  have d := Measure.diff_add with measure, CN, setC, sub
  have le := Measure.mono with measure, CN, setN, sub2
  rw null at le
  have z := EnnLe.antisymmetric with le, (EnnLe.zero with (Measure.member with measure, CN))
  have same : C ∖ (C ∩ N) = C ∖ N
    ext x
    constructor
    . intro h
      simp at h
      simp [h]
    . intro h
      simp at h
      simp [h]
  rw same at d
  rw z at d
  have m := Measure.member with measure, (MeasurableSet.diff with space, setC, setN)
  rw ennAdd.zero with m at d
  symm
  exact d

-- The pieces C ∖ N and the infima of f on the pieces of a partition.
def lintDiffs (P N : Set) : Set := { (C, C ∖ N) | C ∈ P }
def lintInfs (f P : Set) : Set := { (C, ennInfOn(f, C)) | C ∈ P }

theorem lintDiffs.apply (P N C : Set)
  requires member : C ∈ P
  shows lintDiffs(P, N)(C) = C ∖ N
proof
  have edge : (C, C ∖ N) ∈ lintDiffs(P, N)
    apply lintDiffs.membership.backward
    exact ⟨C, member, rfl⟩
  have pairs : ∀ p ∈ lintDiffs(P, N), ∃ a, ∃ b, p = (a, b)
    intros p hp
    obtain ⟨k0, hk, pEq⟩ := lintDiffs.membership.forward with hp
    rw ← pEq
    exact ⟨k0, k0 ∖ N, rfl⟩
  have functional : ∀ a, ∀ b, ∀ c, (a, b) ∈ lintDiffs(P, N) → (a, c) ∈ lintDiffs(P, N) → b = c
    intros a b c hb hc
    obtain ⟨k0, hk, bEq⟩ := lintDiffs.membership.forward with hb
    obtain ⟨m0, hm, cEq⟩ := lintDiffs.membership.forward with hc
    obtain ⟨ka, bb⟩ := orderedPair.injective with bEq
    obtain ⟨ma, cc⟩ := orderedPair.injective with cEq
    rw [← bb, ← cc, ka, ← ma]
  exact pairGraph.apply with pairs, functional, edge


theorem lintInfs.apply (f P C : Set)
  requires member : C ∈ P
  shows lintInfs(f, P)(C) = ennInfOn(f, C)
proof
  have edge : (C, ennInfOn(f, C)) ∈ lintInfs(f, P)
    apply lintInfs.membership.backward
    exact ⟨C, member, rfl⟩
  have pairs : ∀ p ∈ lintInfs(f, P), ∃ a, ∃ b, p = (a, b)
    intros p hp
    obtain ⟨k0, hk, pEq⟩ := lintInfs.membership.forward with hp
    rw ← pEq
    exact ⟨k0, ennInfOn(f, k0), rfl⟩
  have functional : ∀ a, ∀ b, ∀ c, (a, b) ∈ lintInfs(f, P) → (a, c) ∈ lintInfs(f, P) → b = c
    intros a b c hb hc
    obtain ⟨k0, hk, bEq⟩ := lintInfs.membership.forward with hb
    obtain ⟨m0, hm, cEq⟩ := lintInfs.membership.forward with hc
    obtain ⟨ka, bb⟩ := orderedPair.injective with bEq
    obtain ⟨ma, cc⟩ := orderedPair.injective with cEq
    rw [← bb, ← cc, ka, ← ma]
  exact pairGraph.apply with pairs, functional, edge

-- Mathlib's lintegral_mono_ae.
theorem lintegral.mono_ae (X μ f g : Set)
  requires measure : Measure(X, μ)
  requires valuesF : EnnValued(X, f)
  requires valuesG : EnnValued(X, g)
  requires le : AlmostEverywhere(X, μ, ennLeSet(f, g, MeasurableSpace.carrier(X)))
  shows EnnLe(lintegral(X, μ, f), lintegral(X, μ, g))
proof
  have space := Measure.space with measure
  have vF : ∀ x ∈ MeasurableSpace.carrier(X), f(x) ∈ ennreal
    unfold EnnValued at valuesF
    unfold MapsInto at valuesF
    exact valuesF
  have vG : ∀ x ∈ MeasurableSpace.carrier(X), g(x) ∈ ennreal
    unfold EnnValued at valuesG
    unfold MapsInto at valuesG
    exact valuesG
  have le2 := le
  unfold AlmostEverywhere at le2
  unfold NullSet at le2
  obtain ⟨N, hN, sub, zero⟩ := le2
  have Nm : MeasurableSet(X, N)
    unfold MeasurableSet
    exact hN
  apply lintegral.le_of_all with (lintegral.member with measure)
  intros P partition
  have sets : ∀ C ∈ P, MeasurableSet(X, lintDiffs(P, N)(C))
    intros C hC
    rw lintDiffs.apply with hC
    have pc := MeasurablePartition.pieces with space, partition, hC
    exact MeasurableSet.diff with space, pc.left, Nm
  have inside : ∀ C ∈ P, lintDiffs(P, N)(C) ⊆ C
    intros C hC x hx
    rw lintDiffs.apply with hC at hx
    simp at hx
    exact hx.left
  have bvalues : ∀ C ∈ P, lintInfs(f, P)(C) ∈ ennreal
    intros C hC
    rw lintInfs.apply with hC
    have pc := MeasurablePartition.pieces with space, partition, hC
    have vC : ∀ x ∈ C, f(x) ∈ ennreal
      intros x hx
      exact vF with x, (pc.right with x, hx)
    exact ennInfOn.member with vC
  have bound : ∀ C ∈ P, ∀ x ∈ lintDiffs(P, N)(C), EnnLe(lintInfs(f, P)(C), g(x))
    intros C hC x hx
    rw lintDiffs.apply with hC at hx
    rw lintInfs.apply with hC
    simp at hx
    have pc := MeasurablePartition.pieces with space, partition, hC
    have vC : ∀ y ∈ C, f(y) ∈ ennreal
      intros y hy
      exact vF with y, (pc.right with y, hy)
    have xX := pc.right with x, hx.left
    have inLe : x ∈ ennLeSet(f, g, MeasurableSpace.carrier(X))
      by_contra notLe
      have xc : x ∈ MeasurableSpace.carrier(X) ∖ ennLeSet(f, g, MeasurableSpace.carrier(X)) by simp [xX, notLe]
      exact hx.right with (sub with x, xc)
    simp at inLe
    have l1 := ennInfOn.le_value with vC, hx.left
    exact EnnLe.transitive with l1, inLe.right
  have terms : ∀ C ∈ P, partitionTerms(μ, f, P)(C) = ennMul(lintInfs(f, P)(C), μ(lintDiffs(P, N)(C)))
    intros C hC
    rw partitionTerms.apply with hC
    rw lintInfs.apply with hC
    rw lintDiffs.apply with hC
    have pc := MeasurablePartition.pieces with space, partition, hC
    rw Measure.lint_diff_null with measure, pc.left, Nm, zero
  have gen := lintegral.lint_lower with measure, valuesG, partition, sets, inside, bvalues, bound, terms
  unfold lowerSum
  exact gen

theorem lintegral.congr_ae (X μ f g : Set)
  requires measure : Measure(X, μ)
  requires valuesF : EnnValued(X, f)
  requires valuesG : EnnValued(X, g)
  requires equal : AEEqual(X, μ, f, g)
  shows lintegral(X, μ, f) = lintegral(X, μ, g)
proof
  have eq2 := equal
  unfold AEEqual at eq2
  have s1 : equalizer(f, g, MeasurableSpace.carrier(X)) ∩ MeasurableSpace.carrier(X) ⊆ ennLeSet(f, g, MeasurableSpace.carrier(X))
    intros x hx
    obtain ⟨a, b⟩ := intersection.membership.forward with hx
    have e : f(x) = g(x)
      unfold equalizer at a
      simp at a
      exact a.right
    have fx : f(x) ∈ ennreal
      unfold EnnValued at valuesF
      unfold MapsInto at valuesF
      exact valuesF with x, b
    have r := EnnLe.reflexive with fx
    have r2 : EnnLe(f(x), g(x))
      rw ← e
      exact r
    unfold ennLeSet
    simp [b, r2]
  have s2 : equalizer(f, g, MeasurableSpace.carrier(X)) ∩ MeasurableSpace.carrier(X) ⊆ ennLeSet(g, f, MeasurableSpace.carrier(X))
    intros x hx
    obtain ⟨a, b⟩ := intersection.membership.forward with hx
    have e : f(x) = g(x)
      unfold equalizer at a
      simp at a
      exact a.right
    have fx : f(x) ∈ ennreal
      unfold EnnValued at valuesF
      unfold MapsInto at valuesF
      exact valuesF with x, b
    have r := EnnLe.reflexive with fx
    have r2 : EnnLe(g(x), f(x))
      rw ← e
      exact r
    unfold ennLeSet
    simp [b, r2]
  have ae1 := AlmostEverywhere.mono with eq2, s1
  have ae2 := AlmostEverywhere.mono with eq2, s2
  have l1 := lintegral.mono_ae with measure, valuesF, valuesG, ae1
  have l2 := lintegral.mono_ae with measure, valuesG, valuesF, ae2
  exact EnnLe.antisymmetric with l1, l2

-- Section: Suprema of sequences in [0, ∞]
theorem EnnLe.lint_to_real (x y : Set)
  requires le : EnnLe(x, y)
  requires finite : y ≠ ennTop
  shows x ≠ ennTop ∧ x ∈ ℝ ∧ y ∈ ℝ ∧ (x:R) ≤ (y:R) ∧ realZero ≤ x
proof
  have l2 := le
  unfold EnnLe at l2
  obtain ⟨xm, ym, alt⟩ := l2
  cases alt with yt | rest
  . exfalso
    exact finite with yt
  . obtain ⟨xt, xy⟩ := rest
    obtain ⟨xR, xNn⟩ := ennreal.finite with xm, xt
    obtain ⟨yR, yNn⟩ := ennreal.finite with ym, finite
    exact ⟨xt, xR, yR, xy, xNn⟩

theorem EnnLe.lint_of_real (x y : Set)
  requires realX : x ∈ ℝ
  requires realY : y ∈ ℝ
  requires nonneg : realZero ≤ x
  requires le : (x:R) ≤ (y:R)
  shows EnnLe(x, y)
proof
  have xm := ennreal.of_real with realX, nonneg
  have yNn : realZero ≤ y by linarith
  have ym := ennreal.of_real with realY, yNn
  have xt := ennreal.not_top_of_real with realX
  unfold EnnLe
  refine ⟨xm, ym, ?_⟩
  right
  exact ⟨xt, le⟩

theorem ennSupOn.lint_bounds (a : Set)
  requires values : ∀ n ∈ ℕ, a(n) ∈ ennreal
  shows ennSupOn(a, ℕ) ∈ ennreal ∧ (∀ n ∈ ℕ, EnnLe(a(n), ennSupOn(a, ℕ))) ∧
    (∀ c ∈ ennreal, (∀ n ∈ ℕ, EnnLe(a(n), c)) → EnnLe(ennSupOn(a, ℕ), c))
proof
  have inside : valuesOn(a, ℕ) ⊆ ennreal
    intros v hv
    obtain ⟨n, hn, e⟩ := valuesOn.membership.forward with hv
    rw ← e
    exact values with n, hn
  have lu := ennSup.least_upper with inside
  obtain ⟨ub, least⟩ := lu
  obtain ⟨sM, bounds⟩ := ub
  unfold ennSupOn
  refine ⟨sM, ?_, ?_⟩
  . intros n hn
    have v : a(n) ∈ valuesOn(a, ℕ) := valuesOn.membership.backward with ⟨n, hn, rfl⟩
    exact bounds with a(n), v
  . intros c hc all
    have ubc : EnnUpperBound(valuesOn(a, ℕ), c)
      unfold EnnUpperBound
      refine ⟨hc, ?_⟩
      intros v hv
      obtain ⟨n, hn, e⟩ := valuesOn.membership.forward with hv
      rw ← e
      exact all with n, hn
    exact least with c, ubc

-- c · sup a ≤ sup (c · a).
theorem ennMul.lint_le_sup (c a m : Set)
  requires member : c ∈ ennreal
  requires values : ∀ n ∈ ℕ, a(n) ∈ ennreal
  requires product : ∀ n ∈ ℕ, m(n) = ennMul(c, a(n))
  shows EnnLe(ennMul(c, ennSupOn(a, ℕ)), ennSupOn(m, ℕ))
proof
  have mv : ∀ n ∈ ℕ, m(n) ∈ ennreal
    intros n hn
    rw product with n, hn
    exact ennMul.member with member, (values with n, hn)
  obtain ⟨aM, aUp, aLeast⟩ := ennSupOn.lint_bounds with values
  obtain ⟨mM, mUp, mLeast⟩ := ennSupOn.lint_bounds with mv
  have pM := ennMul.member with member, aM
  by_cases mt : ennSupOn(m, ℕ) = ennTop
  . rw mt
    exact EnnLe.top with pM
  . by_cases c0 : c = realZero
    . rw ennMul.zero_left with c0, aM
      exact EnnLe.zero with mM
    . by_cases a0 : ennSupOn(a, ℕ) = realZero
      . rw ennMul.zero_right with member, a0
        exact EnnLe.zero with mM
      . by_cases ct : c = ennTop
        . exfalso
          have inside : valuesOn(a, ℕ) ⊆ ennreal
            intros v hv
            obtain ⟨n, hn, e⟩ := valuesOn.membership.forward with hv
            rw ← e
            exact values with n, hn
          have zm := ennreal.zero_member
          have lt : EnnLt(realZero, ennSup(valuesOn(a, ℕ)))
            unfold EnnLt
            have z := EnnLe.zero with aM
            unfold ennSupOn at z
            refine ⟨z, ?_⟩
            intro e
            apply a0
            unfold ennSupOn
            symm
            exact e
          have ex := (ennSup.lt_iff with inside, zm).forward with lt
          obtain ⟨v, hv, vlt⟩ := ex
          obtain ⟨n, hn, e⟩ := valuesOn.membership.forward with hv
          unfold EnnLt at vlt
          have ane : a(n) ≠ realZero
            intro z
            apply vlt.right
            rw ← e
            symm
            exact z
          have mn := product with n, hn
          rw ennMul.top_left with ct, ane at mn
          have le := mUp with n, hn
          rw mn at le
          have tt := EnnLe.top_eq with le
          exact mt with tt
        . obtain ⟨cR, cNn⟩ := ennreal.finite with member, ct
          have cPos : realZero < c
            by_contra np
            apply c0
            linarith
          obtain ⟨mR, mNn⟩ := ennreal.finite with mM, mt
          have cNe : (c:R) ≠ realZero
            intro z
            apply c0
            exact z
          have invR : realInvValue(c) ∈ ℝ by typecheck
          have invPos := realInvValue.positive with cPos
          have invL := realInvValue.mul_right with cNe
          have dR : R[ennSupOn(m, ℕ) * realInvValue(c)] ∈ ℝ by typecheck
          have dNn0 := realLe.mul_right_of_nonnegative at realZero, ennSupOn(m, ℕ), realInvValue(c) with mNn, (realLess.implies_le with invPos)
          have z0 : R[realZero * realInvValue(c)] = realZero by ring
          rw z0 at dNn0
          have dNn : realZero ≤ R[ennSupOn(m, ℕ) * realInvValue(c)] := dNn0
          have dM := ennreal.of_real with dR, dNn
          have bound : ∀ n ∈ ℕ, EnnLe(a(n), R[ennSupOn(m, ℕ) * realInvValue(c)])
            intros n hn
            have le := mUp with n, hn
            rw product with n, hn at le
            have an := values with n, hn
            by_cases aT : a(n) = ennTop
            . exfalso
              rw ennMul.top_right with c0, aT at le
              have tt := EnnLe.top_eq with le
              exact mt with tt
            . obtain ⟨anR, anNn⟩ := ennreal.finite with an, aT
              rw ennMul.finite with cR, anR, cNn, anNn at le
              obtain ⟨u1, u2, u3, ineq, u5⟩ := EnnLe.lint_to_real with le, mt
              have mul := realLe.mul_right_of_nonnegative with ineq, (realLess.implies_le with invPos)
              have e : R[c * a(n) * realInvValue(c)] = a(n)
                linear_combination a(n) * invL
              rw e at mul
              exact EnnLe.lint_of_real with anR, dR, anNn, mul
          have sa := aLeast with R[ennSupOn(m, ℕ) * realInvValue(c)], dM, bound
          have mono := ennMul.mono with (EnnLe.reflexive with member), sa
          rw ennMul.finite with cR, dR, cNn, dNn at mono
          have e : R[c * (ennSupOn(m, ℕ) * realInvValue(c))] = ennSupOn(m, ℕ)
            linear_combination ennSupOn(m, ℕ) * invL
          rw e at mono
          exact mono

theorem natural.lint_total (m n : Set)
  requires hm : m ∈ ℕ
  requires hn : n ∈ ℕ
  shows m ⊆ n ∨ n ⊆ m
proof
  have mN := nat.omega.backward with hm
  have nN := nat.omega.backward with hn
  have t := LessEqual.total at m, n
  unfold LessEqual at t
  cases t with a | b
  . obtain ⟨x, y, k, kN, e⟩ := a
    left
    have s := natural.subset_add at m, k
    rw e at s
    exact s
  . obtain ⟨x, y, k, kN, e⟩ := b
    right
    have s := natural.subset_add at n, k
    rw e at s
    exact s

-- sup a + sup b ≤ sup (a + b) for increasing sequences.
theorem ennAdd.lint_le_sup (a b m : Set)
  requires valuesA : ∀ n ∈ ℕ, a(n) ∈ ennreal
  requires valuesB : ∀ n ∈ ℕ, b(n) ∈ ennreal
  requires increasingA : ∀ k ∈ ℕ, ∀ n ∈ ℕ, k ⊆ n → EnnLe(a(k), a(n))
  requires increasingB : ∀ k ∈ ℕ, ∀ n ∈ ℕ, k ⊆ n → EnnLe(b(k), b(n))
  requires sum : ∀ n ∈ ℕ, m(n) = ennAdd(a(n), b(n))
  shows EnnLe(ennAdd(ennSupOn(a, ℕ), ennSupOn(b, ℕ)), ennSupOn(m, ℕ))
proof
  have mv : ∀ n ∈ ℕ, m(n) ∈ ennreal
    intros n hn
    rw sum with n, hn
    exact ennAdd.member with (valuesA with n, hn), (valuesB with n, hn)
  obtain ⟨aM, aUp, aLeast⟩ := ennSupOn.lint_bounds with valuesA
  obtain ⟨bM, bUp, bLeast⟩ := ennSupOn.lint_bounds with valuesB
  obtain ⟨mM, mUp, mLeast⟩ := ennSupOn.lint_bounds with mv
  have pM := ennAdd.member with aM, bM
  by_cases mt : ennSupOn(m, ℕ) = ennTop
  . rw mt
    exact EnnLe.top with pM
  . obtain ⟨mR, mNn⟩ := ennreal.finite with mM, mt
    have fin : ∀ n ∈ ℕ, a(n) ≠ ennTop ∧ b(n) ≠ ennTop ∧ a(n) ∈ ℝ ∧ b(n) ∈ ℝ ∧ realZero ≤ a(n) ∧ realZero ≤ b(n) ∧ R[a(n) + b(n)] ≤ ennSupOn(m, ℕ)
      intros n hn
      have le := mUp with n, hn
      rw sum with n, hn at le
      have an := valuesA with n, hn
      have bn := valuesB with n, hn
      by_cases aT : a(n) = ennTop
      . exfalso
        rw ennAdd.top_left with aT at le
        have tt := EnnLe.top_eq with le
        exact mt with tt
      . by_cases bT : b(n) = ennTop
        . exfalso
          rw ennAdd.top_right with bT at le
          have tt := EnnLe.top_eq with le
          exact mt with tt
        . obtain ⟨aR, aNn⟩ := ennreal.finite with an, aT
          obtain ⟨bR, bNn⟩ := ennreal.finite with bn, bT
          rw ennAdd.finite with aR, bR, aNn, bNn at le
          obtain ⟨u1, u2, u3, ineq, u5⟩ := EnnLe.lint_to_real with le, mt
          exact ⟨aT, bT, aR, bR, aNn, bNn, ineq⟩
    have pair : ∀ k ∈ ℕ, ∀ n ∈ ℕ, R[a(k) + b(n)] ≤ ennSupOn(m, ℕ)
      intros k hk n hn
      obtain ⟨akT, bkT, akR, bkR, akNn, bkNn, kSum⟩ := fin with k, hk
      obtain ⟨anT, bnT, anR, bnR, anNn, bnNn, nSum⟩ := fin with n, hn
      have tot := natural.lint_total with hk, hn
      cases tot with kn | nk
      . have l := increasingA with k, hk, n, hn, kn
        obtain ⟨u1, u2, u3, lr, u5⟩ := EnnLe.lint_to_real with l, anT
        linarith
      . have l := increasingB with n, hn, k, hk, nk
        obtain ⟨u1, u2, u3, lr, u5⟩ := EnnLe.lint_to_real with l, bkT
        linarith
    have saB : ∀ n ∈ ℕ, EnnLe(ennSupOn(a, ℕ), R[ennSupOn(m, ℕ) - b(n)])
      intros n hn
      obtain ⟨anT, bnT, anR, bnR, anNn, bnNn, nSum⟩ := fin with n, hn
      have dR : R[ennSupOn(m, ℕ) - b(n)] ∈ ℝ by typecheck
      have dNn : realZero ≤ R[ennSupOn(m, ℕ) - b(n)] by linarith
      have dM := ennreal.of_real with dR, dNn
      apply aLeast with dM
      intros k hk
      obtain ⟨akT, bkT, akR, bkR, akNn, bkNn, kSum⟩ := fin with k, hk
      have p := pair with k, hk, n, hn
      have l : (a(k):R) ≤ R[ennSupOn(m, ℕ) - b(n)] by linarith
      exact EnnLe.lint_of_real with akR, dR, akNn, l
    have zN : ∅ ∈ ℕ by typecheck
    obtain ⟨a0T, b0T, a0R, b0R, a0Nn, b0Nn, zSum⟩ := fin with ∅, zN
    have s0 := saB with ∅, zN
    have d0R : R[ennSupOn(m, ℕ) - b(∅)] ∈ ℝ by typecheck
    obtain ⟨saT, saR, u3, u4, saNn⟩ := EnnLe.lint_to_real with s0, (ennreal.not_top_of_real with d0R)
    have eR : R[ennSupOn(m, ℕ) - ennSupOn(a, ℕ)] ∈ ℝ by typecheck
    have sbB : EnnLe(ennSupOn(b, ℕ), R[ennSupOn(m, ℕ) - ennSupOn(a, ℕ)])
      have l0 : (ennSupOn(a, ℕ):R) ≤ R[ennSupOn(m, ℕ) - b(∅)]
        obtain ⟨v1, v2, v3, v4, v5⟩ := EnnLe.lint_to_real with s0, (ennreal.not_top_of_real with d0R)
        exact v4
      have eNn : realZero ≤ R[ennSupOn(m, ℕ) - ennSupOn(a, ℕ)] by linarith
      have eM := ennreal.of_real with eR, eNn
      apply bLeast with eM
      intros n hn
      obtain ⟨anT, bnT, anR, bnR, anNn, bnNn, nSum⟩ := fin with n, hn
      have dR : R[ennSupOn(m, ℕ) - b(n)] ∈ ℝ by typecheck
      obtain ⟨v1, v2, v3, v4, v5⟩ := EnnLe.lint_to_real with (saB with n, hn), (ennreal.not_top_of_real with dR)
      have l : (b(n):R) ≤ R[ennSupOn(m, ℕ) - ennSupOn(a, ℕ)] by linarith
      exact EnnLe.lint_of_real with bnR, eR, bnNn, l
    obtain ⟨sbT, sbR, w3, sbLe, sbNn⟩ := EnnLe.lint_to_real with sbB, (ennreal.not_top_of_real with eR)
    rw ennAdd.finite with saR, sbR, saNn, sbNn
    have tR : R[ennSupOn(a, ℕ) + ennSupOn(b, ℕ)] ∈ ℝ by typecheck
    have tNn : realZero ≤ R[ennSupOn(a, ℕ) + ennSupOn(b, ℕ)] by linarith
    have l : R[ennSupOn(a, ℕ) + ennSupOn(b, ℕ)] ≤ (ennSupOn(m, ℕ):R) by linarith
    exact EnnLe.lint_of_real with tR, mR, tNn, l


-- The finite sums over F of the terms of a sequence of families.
def lintFinSums (u F : Set) : Set := { (n, ennFiniteSum(u(n), F)) | n ∈ ℕ }

theorem lintFinSums.apply (u F n : Set)
  requires member : n ∈ ℕ
  shows lintFinSums(u, F)(n) = ennFiniteSum(u(n), F)
proof
  have edge : (n, ennFiniteSum(u(n), F)) ∈ lintFinSums(u, F)
    apply lintFinSums.membership.backward
    exact ⟨n, member, rfl⟩
  have pairs : ∀ p ∈ lintFinSums(u, F), ∃ a, ∃ b, p = (a, b)
    intros p hp
    obtain ⟨k0, hk, pEq⟩ := lintFinSums.membership.forward with hp
    rw ← pEq
    exact ⟨k0, ennFiniteSum(u(k0), F), rfl⟩
  have functional : ∀ a, ∀ b, ∀ c, (a, b) ∈ lintFinSums(u, F) → (a, c) ∈ lintFinSums(u, F) → b = c
    intros a b c hb hc
    obtain ⟨k0, hk, bEq⟩ := lintFinSums.membership.forward with hb
    obtain ⟨m0, hm, cEq⟩ := lintFinSums.membership.forward with hc
    obtain ⟨ka, bb⟩ := orderedPair.injective with bEq
    obtain ⟨ma, cc⟩ := orderedPair.injective with cEq
    rw [← bb, ← cc, ka, ← ma]
  exact pairGraph.apply with pairs, functional, edge


-- A finite sum of increasing limits is the limit of the finite sums.
theorem ennFiniteSum.lint_le_sup (u L P : Set)
  requires finite : Finite(P)
  requires values : ∀ n ∈ ℕ, ∀ C ∈ P, u(n)(C) ∈ ennreal
  requires increasing : ∀ k ∈ ℕ, ∀ n ∈ ℕ, k ⊆ n → ∀ C ∈ P, EnnLe(u(k)(C), u(n)(C))
  requires sups : ∀ C ∈ P, L(C) = ennSupOn(familyAt(u, ℕ, C), ℕ)
  shows EnnLe(ennFiniteSum(L, P), ennSupOn(lintFinSums(u, P), ℕ))
proof
  induction finite with H a
  | empty =>
    have v : ∀ n ∈ ℕ, lintFinSums(u, ∅)(n) ∈ ennreal
      intros n hn
      rw lintFinSums.apply with hn
      rw ennFiniteSum.empty
      exact ennreal.zero_member
    obtain ⟨sM, sUp, sLeast⟩ := ennSupOn.lint_bounds with v
    rw ennFiniteSum.empty
    exact EnnLe.zero with sM
  | insert using ih =>
    have vH : ∀ n ∈ ℕ, ∀ C ∈ H, u(n)(C) ∈ ennreal
      intros n hn C hC
      exact values with n, hn, C, (HSubset with C, hC)
    have tV : ∀ n ∈ ℕ, lintFinSums(u, H)(n) ∈ ennreal
      intros n hn
      rw lintFinSums.apply with hn
      exact ennFiniteSum.member with HFinite, (vH with n, hn)
    have fV : ∀ n ∈ ℕ, familyAt(u, ℕ, a)(n) ∈ ennreal
      intros n hn
      rw familyAt.apply with hn
      exact values with n, hn, a, aMember
    have tInc : ∀ k ∈ ℕ, ∀ n ∈ ℕ, k ⊆ n → EnnLe(lintFinSums(u, H)(k), lintFinSums(u, H)(n))
      intros k hk n hn kn
      rw lintFinSums.apply with hk
      rw lintFinSums.apply with hn
      have le : ∀ C ∈ H, EnnLe(u(k)(C), u(n)(C))
        intros C hC
        exact increasing with k, hk, n, hn, kn, C, (HSubset with C, hC)
      exact ennFiniteSum.mono_fun with HFinite, (vH with k, hk), (vH with n, hn), le
    have fInc : ∀ k ∈ ℕ, ∀ n ∈ ℕ, k ⊆ n → EnnLe(familyAt(u, ℕ, a)(k), familyAt(u, ℕ, a)(n))
      intros k hk n hn kn
      rw familyAt.apply with hk
      rw familyAt.apply with hn
      exact increasing with k, hk, n, hn, kn, a, aMember
    have sum : ∀ n ∈ ℕ, lintFinSums(u, H ∪ {a})(n) = ennAdd(lintFinSums(u, H)(n), familyAt(u, ℕ, a)(n))
      intros n hn
      rw lintFinSums.apply with hn
      rw familyAt.apply with hn
      have vU : ∀ C ∈ H ∪ {a}, u(n)(C) ∈ ennreal
        intros C hC
        have c := union2.membership.forward with hC
        cases c with cH | ca
        . exact vH with n, hn, C, cH
        . simp at ca
          rw ca
          exact values with n, hn, a, aMember
      exact ennFiniteSum.insert with HFinite, vU, aFresh
    have big := ennAdd.lint_le_sup with tV, fV, tInc, fInc, sum
    have lV : ∀ C ∈ H ∪ {a}, L(C) ∈ ennreal
      intros C hC
      have CP : C ∈ P
        have c := union2.membership.forward with hC
        cases c with cH | ca
        . exact HSubset with C, cH
        . simp at ca
          rw ca
          exact aMember
      rw sups with C, CP
      have fC : ∀ n ∈ ℕ, familyAt(u, ℕ, C)(n) ∈ ennreal
        intros n hn
        rw familyAt.apply with hn
        exact values with n, hn, C, CP
      obtain ⟨m1, m2, m3⟩ := ennSupOn.lint_bounds with fC
      exact m1
    rw ennFiniteSum.insert with HFinite, lV, aFresh
    rw sups with a, aMember
    obtain ⟨fM, fUp, fLeast⟩ := ennSupOn.lint_bounds with fV
    have step := ennAdd.mono with ih, (EnnLe.reflexive with fM)
    exact EnnLe.transitive with step, big

-- Approximations of c ∈ [0, ∞] from below: c · (1 − 1/(k + 1)) for finite
-- c and k for c = ∞.
def lintRatio (k : Set) : Set := R[realOne - realInvValue(realNat(k) + realOne)]
def lintApprox (c k : Set) : Set :=
  ⋃({ S ∈ ennreal | (c = ennTop ∧ S = realNat(k)) ∨
    (c ≠ ennTop ∧ S = ennMul(c, lintRatio(k))) })

theorem natural.lint_le_of_subset (k n : Set)
  requires hk : k ∈ ℕ
  requires hn : n ∈ ℕ
  requires sub : k ⊆ n
  shows k ≤ n
proof
  have kN := nat.omega.backward with hk
  have nN := nat.omega.backward with hn
  have t := LessEqual.total at k, n
  cases t with a | b
  . exact a
  . have b2 := b
    unfold LessEqual at b2
    obtain ⟨j, jN, e⟩ := b2
    have s := natural.subset_add at n, j
    rw e at s
    have same : k = n
      ext z
      constructor
      . intro h
        exact sub with z, h
      . intro h
        exact s with z, h
    rw same
    exact LessEqual.reflexive at n

theorem lintRatio.facts (k : Set)
  requires hk : k ∈ ℕ
  shows lintRatio(k) ∈ ℝ ∧ realZero ≤ lintRatio(k) ∧ lintRatio(k) < realOne ∧
    lintRatio(k) ∈ ennreal
proof
  have kN := nat.omega.backward with hk
  have nn := realNat.nonnegative at k
  have nR := realNat.real at k
  have ge : (1:R) ≤ R[realNat(k) + realOne] by linarith
  have pos : (0:R) < R[realNat(k) + realOne] by linarith
  have hPos := realInvValue.positive with pos
  have ne : R[realNat(k) + realOne] ≠ realZero
    intro z
    rw z at pos
    linarith
  have law := realInvValue.mul_left with ne
  have m := realLe.mul_left_of_nonnegative at (1:R), R[realNat(k) + realOne], realInvValue(R[realNat(k) + realOne]) with ge, (realLess.implies_le with hPos)
  have e1 : R[realInvValue(R[realNat(k) + realOne]) * (1:R)] = realInvValue(R[realNat(k) + realOne]) by ring
  rw e1 at m
  rw law at m
  have hR : realInvValue(R[realNat(k) + realOne]) ∈ ℝ by typecheck
  have rR : lintRatio(k) ∈ ℝ
    unfold lintRatio
    typecheck
  have e : lintRatio(k) = R[realOne - realInvValue(realNat(k) + realOne)]
    unfold lintRatio
    rfl
  have r0 : realZero ≤ lintRatio(k)
    rw e
    linarith
  have r1 : lintRatio(k) < realOne
    rw e
    linarith
  exact ⟨rR, r0, r1, (ennreal.of_real with rR, r0)⟩

theorem lintRatio.mono (k n : Set)
  requires hk : k ∈ ℕ
  requires hn : n ∈ ℕ
  requires sub : k ⊆ n
  shows (lintRatio(k):R) ≤ (lintRatio(n):R)
proof
  have kN := nat.omega.backward with hk
  have nN := nat.omega.backward with hn
  have le := natural.lint_le_of_subset with hk, hn, sub
  have m := realNat.monotone with le
  have nnk := realNat.nonnegative at k
  have pos : (0:R) < R[realNat(k) + realOne] by linarith
  have le2 : R[realNat(k) + realOne] ≤ R[realNat(n) + realOne] by linarith
  have inv := realInvValue.antitone_le with pos, le2
  unfold lintRatio
  linarith

theorem lintRatio.near (d : Set)
  requires real : d ∈ ℝ
  requires positive : realZero < d
  shows ∃ n ∈ ℕ, R[realOne - d] < lintRatio(n)
proof
  have dNe : (d:R) ≠ realZero
    intro z
    rw z at positive
    linarith
  obtain ⟨n, nN, big⟩ := Real.below_natural at realInvValue(d)
  have hn : n ∈ ℕ by typecheck
  have invPos := realInvValue.positive with positive
  have nn := realNat.nonnegative at n
  have lt : realInvValue(d) < R[realNat(n) + realOne] by linarith
  have anti := realInvValue.antitone_positive with invPos, lt
  rw realInvValue.involutive with dNe at anti
  refine ⟨n, hn, ?_⟩
  unfold lintRatio
  linarith

theorem lintApprox.top (k : Set)
  requires hk : k ∈ ℕ
  shows lintApprox(ennTop, k) = realNat(k)
proof
  have kN := nat.omega.backward with hk
  have nR := realNat.real at k
  have nn := realNat.nonnegative at k
  have nR2 : realNat(k) ∈ ℝ by typecheck
  have m := ennreal.of_real with nR2, nn
  unfold lintApprox
  apply union.of_unique
  . apply lintApprox.family.membership.backward
    refine ⟨m, ?_⟩
    left
    exact ⟨rfl, rfl⟩
  . intros w hw
    obtain ⟨wIn, alt⟩ := lintApprox.family.membership.forward with hw
    cases alt with p | q
    . exact p.right
    . exfalso
      exact q.left with rfl

theorem lintApprox.finite (c k : Set)
  requires member : c ∈ ennreal
  requires finite : c ≠ ennTop
  requires hk : k ∈ ℕ
  shows lintApprox(c, k) = ennMul(c, lintRatio(k))
proof
  obtain ⟨rR, r0, r1, rM⟩ := lintRatio.facts with hk
  have m := ennMul.member with member, rM
  unfold lintApprox
  apply union.of_unique
  . apply lintApprox.family.membership.backward
    refine ⟨m, ?_⟩
    right
    exact ⟨finite, rfl⟩
  . intros w hw
    obtain ⟨wIn, alt⟩ := lintApprox.family.membership.forward with hw
    cases alt with p | q
    . exfalso
      exact finite with p.left
    . exact q.right

theorem lintApprox.facts (c k : Set)
  requires member : c ∈ ennreal
  requires hk : k ∈ ℕ
  shows lintApprox(c, k) ∈ ennreal ∧
    (lintApprox(c, k) = realZero ∨ EnnLt(lintApprox(c, k), c))
proof
  by_cases ct : c = ennTop
  . rw ct
    rw lintApprox.top with hk
    have kN := nat.omega.backward with hk
    have nn := realNat.nonnegative at k
    have nR2 : realNat(k) ∈ ℝ by typecheck
    have m := ennreal.of_real with nR2, nn
    have nt := ennreal.not_top_of_real with nR2
    refine ⟨m, ?_⟩
    right
    unfold EnnLt
    exact ⟨(EnnLe.top with m), nt⟩
  . rw lintApprox.finite with member, ct, hk
    obtain ⟨rR, r0, r1, rM⟩ := lintRatio.facts with hk
    have m := ennMul.member with member, rM
    refine ⟨m, ?_⟩
    obtain ⟨cR, cNn⟩ := ennreal.finite with member, ct
    rw ennMul.finite with cR, rR, cNn, r0
    by_cases c0 : c = realZero
    . left
      rw c0
      ring
    . right
      have cPos : realZero < c
        by_contra np
        apply c0
        linarith
      have pR : R[c * lintRatio(k)] ∈ ℝ by typecheck
      have m1 := realLe.mul_left_of_nonnegative at realZero, lintRatio(k), c with r0, cNn
      have z0 : R[c * realZero] = realZero by ring
      rw z0 at m1
      have lt : R[c * lintRatio(k)] < c
        have d : R[c - c * lintRatio(k)] = R[c * (realOne - lintRatio(k))] by ring
        have pos1 : realZero < R[realOne - lintRatio(k)] by linarith
        have pp := realMulValue.positive with cPos, pos1
        linarith
      unfold EnnLt
      refine ⟨?_, ?_⟩
      . exact EnnLe.lint_of_real with pR, cR, m1, (realLess.implies_le with lt)
      . intro e
        rw e at lt
        linarith

theorem lintApprox.mono (c k n : Set)
  requires member : c ∈ ennreal
  requires hk : k ∈ ℕ
  requires hn : n ∈ ℕ
  requires sub : k ⊆ n
  shows EnnLe(lintApprox(c, k), lintApprox(c, n))
proof
  by_cases ct : c = ennTop
  . rw ct
    rw lintApprox.top with hk
    rw lintApprox.top with hn
    have kN := nat.omega.backward with hk
    have nN := nat.omega.backward with hn
    have le := natural.lint_le_of_subset with hk, hn, sub
    have m := realNat.monotone with le
    have nn := realNat.nonnegative at k
    have kR : realNat(k) ∈ ℝ by typecheck
    have nR : realNat(n) ∈ ℝ by typecheck
    exact EnnLe.lint_of_real with kR, nR, nn, m
  . rw lintApprox.finite with member, ct, hk
    rw lintApprox.finite with member, ct, hn
    obtain ⟨rkR, rk0, rk1, rkM⟩ := lintRatio.facts with hk
    obtain ⟨rnR, rn0, rn1, rnM⟩ := lintRatio.facts with hn
    have mono := lintRatio.mono with hk, hn, sub
    have le := EnnLe.lint_of_real with rkR, rnR, rk0, mono
    exact ennMul.mono with (EnnLe.reflexive with member), le


def lintRatios : Set := { (k, lintRatio(k)) | k ∈ ℕ }

theorem lintRatios.apply (k : Set)
  requires member : k ∈ ℕ
  shows lintRatios(k) = lintRatio(k)
proof
  have edge : (k, lintRatio(k)) ∈ lintRatios
    apply lintRatios.membership.backward
    exact ⟨k, member, rfl⟩
  have pairs : ∀ p ∈ lintRatios, ∃ a, ∃ b, p = (a, b)
    intros p hp
    obtain ⟨k0, hk, pEq⟩ := lintRatios.membership.forward with hp
    rw ← pEq
    exact ⟨k0, lintRatio(k0), rfl⟩
  have functional : ∀ a, ∀ b, ∀ c, (a, b) ∈ lintRatios → (a, c) ∈ lintRatios → b = c
    intros a b c hb hc
    obtain ⟨k0, hk, bEq⟩ := lintRatios.membership.forward with hb
    obtain ⟨m0, hm, cEq⟩ := lintRatios.membership.forward with hc
    obtain ⟨ka, bb⟩ := orderedPair.injective with bEq
    obtain ⟨ma, cc⟩ := orderedPair.injective with cEq
    rw [← bb, ← cc, ka, ← ma]
  exact pairGraph.apply with pairs, functional, edge


-- The approximations of c increase to c.
theorem lintApprox.sup (c b : Set)
  requires member : c ∈ ennreal
  requires approx : ∀ k ∈ ℕ, b(k) = lintApprox(c, k)
  shows EnnLe(c, ennSupOn(b, ℕ))
proof
  have bv : ∀ k ∈ ℕ, b(k) ∈ ennreal
    intros k hk
    rw approx with k, hk
    have f := lintApprox.facts with member, hk
    exact f.left
  obtain ⟨bM, bUp, bLeast⟩ := ennSupOn.lint_bounds with bv
  by_cases ct : c = ennTop
  . by_cases st : ennSupOn(b, ℕ) = ennTop
    . rw st
      rw ct
      exact EnnLe.reflexive with ennreal.top_member
    . exfalso
      obtain ⟨sR, sNn⟩ := ennreal.finite with bM, st
      obtain ⟨n, nN, big⟩ := Real.below_natural at ennSupOn(b, ℕ)
      have hn : n ∈ ℕ by typecheck
      have le := bUp with n, hn
      rw approx with n, hn at le
      rw ct at le
      rw lintApprox.top with hn at le
      obtain ⟨u1, u2, u3, ineq, u5⟩ := EnnLe.lint_to_real with le, st
      linarith
  . have rv : ∀ k ∈ ℕ, lintRatios(k) ∈ ennreal
      intros k hk
      rw lintRatios.apply with hk
      have f := lintRatio.facts with hk
      exact f.right.right.right
    have prod : ∀ k ∈ ℕ, b(k) = ennMul(c, lintRatios(k))
      intros k hk
      rw approx with k, hk
      rw lintRatios.apply with hk
      exact lintApprox.finite with member, ct, hk
    have e5 := ennMul.lint_le_sup with member, rv, prod
    obtain ⟨rM, rUp, rLeast⟩ := ennSupOn.lint_bounds with rv
    have oneR : realOne ∈ ℝ by typecheck
    have oneNn : realZero ≤ realOne by linarith
    have oneM := ennreal.of_real with oneR, oneNn
    have oneLe : EnnLe(realOne, ennSupOn(lintRatios, ℕ))
      by_cases rt : ennSupOn(lintRatios, ℕ) = ennTop
      . rw rt
        exact EnnLe.top with oneM
      . obtain ⟨rR, rNn⟩ := ennreal.finite with rM, rt
        have real1 : (realOne:R) ≤ (ennSupOn(lintRatios, ℕ):R)
          by_contra small
          have dR : R[realOne - ennSupOn(lintRatios, ℕ)] ∈ ℝ by typecheck
          have dPos : realZero < R[realOne - ennSupOn(lintRatios, ℕ)] by linarith
          obtain ⟨n, hn, near⟩ := lintRatio.near with dR, dPos
          have le := rUp with n, hn
          rw lintRatios.apply with hn at le
          obtain ⟨u1, u2, u3, ineq, u5⟩ := EnnLe.lint_to_real with le, rt
          linarith
        exact EnnLe.lint_of_real with oneR, rR, oneNn, real1
    have m1 := ennMul.mono with (EnnLe.reflexive with member), oneLe
    rw ennMul.comm with member, oneM at m1
    rw ennMul.one with member at m1
    exact EnnLe.transitive with m1, e5

-- The sets {f > t} of a measurable map into [0, ∞] are measurable.
theorem MeasurableSet.lint_gt (f X t : Set)
  requires measurable : Measurable(f, X, ennMeasurableSpace)
  requires member : t ∈ ennreal
  shows MeasurableSet(X, ennGtSet(f, MeasurableSpace.carrier(X), t))
proof
  have sub : ennIoi(t) ⊆ ennreal
    intros a ha
    simp at ha
    exact ha.left
  have ray : ennIoi(t) ∈ ennRays
    have pw := (powerset.membership_iff at ennIoi(t), ennreal).backward with sub
    apply ennRays.membership.backward
    exact ⟨pw, t, member, rfl⟩
  have g := generatedSigma.generator with ray, sub
  have ms : MeasurableSet(ennMeasurableSpace, ennIoi(t))
    unfold MeasurableSet
    unfold ennMeasurableSpace
    unfold generatedSpace
    rw MeasurableSpace.mk.sets
    exact g
  have pre := Measurable.preimage with measurable, ms
  have same : functionPreimage(f, MeasurableSpace.carrier(X), ennIoi(t)) = ennGtSet(f, MeasurableSpace.carrier(X), t)
    ext x
    constructor
    . intro h
      simp at h
      simp
    . intro h
      unfold ennGtSet at h
      simp at h
      have fx := Measurable.maps with measurable, h.left
      rw ennMeasurableSpace.carrier at fx
      unfold functionPreimage
      unfold ennIoi
      simp
  rw same at pre
  exact pre

def lintGtPieces (u X B n P : Set) : Set :=
  { (C, C ∩ ennGtSet(u(n), MeasurableSpace.carrier(X), B(C))) | C ∈ P }
def lintGtTerms (μ u X B P n : Set) : Set :=
  { (C, ennMul(B(C), μ(C ∩ ennGtSet(u(n), MeasurableSpace.carrier(X), B(C))))) | C ∈ P }
def lintGtSeq (μ u X B P : Set) : Set := { (n, lintGtTerms(μ, u, X, B, P, n)) | n ∈ ℕ }
def lintGtSets (u X C t : Set) : Set :=
  { (n, C ∩ ennGtSet(u(n), MeasurableSpace.carrier(X), t)) | n ∈ ℕ }

theorem lintGtPieces.apply (u X B n P C : Set)
  requires member : C ∈ P
  shows lintGtPieces(u, X, B, n, P)(C) = C ∩ ennGtSet(u(n), MeasurableSpace.carrier(X), B(C))
proof
  have edge : (C, C ∩ ennGtSet(u(n), MeasurableSpace.carrier(X), B(C))) ∈ lintGtPieces(u, X, B, n, P)
    apply lintGtPieces.membership.backward
    exact ⟨C, member, rfl⟩
  have pairs : ∀ p ∈ lintGtPieces(u, X, B, n, P), ∃ a, ∃ b, p = (a, b)
    intros p hp
    obtain ⟨k0, hk, pEq⟩ := lintGtPieces.membership.forward with hp
    rw ← pEq
    exact ⟨k0, k0 ∩ ennGtSet(u(n), MeasurableSpace.carrier(X), B(k0)), rfl⟩
  have functional : ∀ a, ∀ b, ∀ c, (a, b) ∈ lintGtPieces(u, X, B, n, P) → (a, c) ∈ lintGtPieces(u, X, B, n, P) → b = c
    intros a b c hb hc
    obtain ⟨k0, hk, bEq⟩ := lintGtPieces.membership.forward with hb
    obtain ⟨m0, hm, cEq⟩ := lintGtPieces.membership.forward with hc
    obtain ⟨ka, bb⟩ := orderedPair.injective with bEq
    obtain ⟨ma, cc⟩ := orderedPair.injective with cEq
    rw [← bb, ← cc, ka, ← ma]
  exact pairGraph.apply with pairs, functional, edge


theorem lintGtTerms.apply (μ u X B P n C : Set)
  requires member : C ∈ P
  shows lintGtTerms(μ, u, X, B, P, n)(C) = ennMul(B(C), μ(C ∩ ennGtSet(u(n), MeasurableSpace.carrier(X), B(C))))
proof
  have edge : (C, ennMul(B(C), μ(C ∩ ennGtSet(u(n), MeasurableSpace.carrier(X), B(C))))) ∈ lintGtTerms(μ, u, X, B, P, n)
    apply lintGtTerms.membership.backward
    exact ⟨C, member, rfl⟩
  have pairs : ∀ p ∈ lintGtTerms(μ, u, X, B, P, n), ∃ a, ∃ b, p = (a, b)
    intros p hp
    obtain ⟨k0, hk, pEq⟩ := lintGtTerms.membership.forward with hp
    rw ← pEq
    exact ⟨k0, ennMul(B(k0), μ(k0 ∩ ennGtSet(u(n), MeasurableSpace.carrier(X), B(k0)))), rfl⟩
  have functional : ∀ a, ∀ b, ∀ c, (a, b) ∈ lintGtTerms(μ, u, X, B, P, n) → (a, c) ∈ lintGtTerms(μ, u, X, B, P, n) → b = c
    intros a b c hb hc
    obtain ⟨k0, hk, bEq⟩ := lintGtTerms.membership.forward with hb
    obtain ⟨m0, hm, cEq⟩ := lintGtTerms.membership.forward with hc
    obtain ⟨ka, bb⟩ := orderedPair.injective with bEq
    obtain ⟨ma, cc⟩ := orderedPair.injective with cEq
    rw [← bb, ← cc, ka, ← ma]
  exact pairGraph.apply with pairs, functional, edge


theorem lintGtSeq.apply (μ u X B P n : Set)
  requires member : n ∈ ℕ
  shows lintGtSeq(μ, u, X, B, P)(n) = lintGtTerms(μ, u, X, B, P, n)
proof
  have edge : (n, lintGtTerms(μ, u, X, B, P, n)) ∈ lintGtSeq(μ, u, X, B, P)
    apply lintGtSeq.membership.backward
    exact ⟨n, member, rfl⟩
  have pairs : ∀ p ∈ lintGtSeq(μ, u, X, B, P), ∃ a, ∃ b, p = (a, b)
    intros p hp
    obtain ⟨k0, hk, pEq⟩ := lintGtSeq.membership.forward with hp
    rw ← pEq
    exact ⟨k0, lintGtTerms(μ, u, X, B, P, k0), rfl⟩
  have functional : ∀ a, ∀ b, ∀ c, (a, b) ∈ lintGtSeq(μ, u, X, B, P) → (a, c) ∈ lintGtSeq(μ, u, X, B, P) → b = c
    intros a b c hb hc
    obtain ⟨k0, hk, bEq⟩ := lintGtSeq.membership.forward with hb
    obtain ⟨m0, hm, cEq⟩ := lintGtSeq.membership.forward with hc
    obtain ⟨ka, bb⟩ := orderedPair.injective with bEq
    obtain ⟨ma, cc⟩ := orderedPair.injective with cEq
    rw [← bb, ← cc, ka, ← ma]
  exact pairGraph.apply with pairs, functional, edge


theorem lintGtSets.apply (u X C t n : Set)
  requires member : n ∈ ℕ
  shows lintGtSets(u, X, C, t)(n) = C ∩ ennGtSet(u(n), MeasurableSpace.carrier(X), t)
proof
  have edge : (n, C ∩ ennGtSet(u(n), MeasurableSpace.carrier(X), t)) ∈ lintGtSets(u, X, C, t)
    apply lintGtSets.membership.backward
    exact ⟨n, member, rfl⟩
  have pairs : ∀ p ∈ lintGtSets(u, X, C, t), ∃ a, ∃ b, p = (a, b)
    intros p hp
    obtain ⟨k0, hk, pEq⟩ := lintGtSets.membership.forward with hp
    rw ← pEq
    exact ⟨k0, C ∩ ennGtSet(u(k0), MeasurableSpace.carrier(X), t), rfl⟩
  have functional : ∀ a, ∀ b, ∀ c, (a, b) ∈ lintGtSets(u, X, C, t) → (a, c) ∈ lintGtSets(u, X, C, t) → b = c
    intros a b c hb hc
    obtain ⟨k0, hk, bEq⟩ := lintGtSets.membership.forward with hb
    obtain ⟨m0, hm, cEq⟩ := lintGtSets.membership.forward with hc
    obtain ⟨ka, bb⟩ := orderedPair.injective with bEq
    obtain ⟨ma, cc⟩ := orderedPair.injective with cEq
    rw [← bb, ← cc, ka, ← ma]
  exact pairGraph.apply with pairs, functional, edge


theorem lintegralSequence.lint_apply (X μ u n : Set)
  requires member : n ∈ ℕ
  shows lintegralSequence(X, μ, u)(n) = lintegral(X, μ, u(n))
proof
  have edge : (n, lintegral(X, μ, u(n))) ∈ lintegralSequence(X, μ, u)
    apply lintegralSequence.membership.backward
    exact ⟨n, member, rfl⟩
  have pairs : ∀ p ∈ lintegralSequence(X, μ, u), ∃ a, ∃ b, p = (a, b)
    intros p hp
    obtain ⟨k0, hk, pEq⟩ := lintegralSequence.membership.forward with hp
    rw ← pEq
    exact ⟨k0, lintegral(X, μ, u(k0)), rfl⟩
  have functional : ∀ a, ∀ b, ∀ c, (a, b) ∈ lintegralSequence(X, μ, u) → (a, c) ∈ lintegralSequence(X, μ, u) → b = c
    intros a b c hb hc
    obtain ⟨k0, hk, bEq⟩ := lintegralSequence.membership.forward with hb
    obtain ⟨m0, hm, cEq⟩ := lintegralSequence.membership.forward with hc
    obtain ⟨ka, bb⟩ := orderedPair.injective with bEq
    obtain ⟨ma, cc⟩ := orderedPair.injective with cEq
    rw [← bb, ← cc, ka, ← ma]
  exact pairGraph.apply with pairs, functional, edge


theorem ennPointwiseSup.lint_apply (u I i : Set)
  requires member : i ∈ I
  shows ennPointwiseSup(u, I)(i) = ennSupOn(familyAt(u, ℕ, i), ℕ)
proof
  have edge : (i, ennSupOn(familyAt(u, ℕ, i), ℕ)) ∈ ennPointwiseSup(u, I)
    apply ennPointwiseSup.membership.backward
    exact ⟨i, member, rfl⟩
  have pairs : ∀ p ∈ ennPointwiseSup(u, I), ∃ a, ∃ b, p = (a, b)
    intros p hp
    obtain ⟨k0, hk, pEq⟩ := ennPointwiseSup.membership.forward with hp
    rw ← pEq
    exact ⟨k0, ennSupOn(familyAt(u, ℕ, k0), ℕ), rfl⟩
  have functional : ∀ a, ∀ b, ∀ c, (a, b) ∈ ennPointwiseSup(u, I) → (a, c) ∈ ennPointwiseSup(u, I) → b = c
    intros a b c hb hc
    obtain ⟨k0, hk, bEq⟩ := ennPointwiseSup.membership.forward with hb
    obtain ⟨m0, hm, cEq⟩ := ennPointwiseSup.membership.forward with hc
    obtain ⟨ka, bb⟩ := orderedPair.injective with bEq
    obtain ⟨ma, cc⟩ := orderedPair.injective with cEq
    rw [← bb, ← cc, ka, ← ma]
  exact pairGraph.apply with pairs, functional, edge


theorem ennSupSequenceOn.lint_apply (u A x : Set)
  requires member : x ∈ A
  shows ennSupSequenceOn(u, A)(x) = ennSupOn(familyAt(u, ℕ, x), ℕ)
proof
  have edge : (x, ennSupOn(familyAt(u, ℕ, x), ℕ)) ∈ ennSupSequenceOn(u, A)
    apply ennSupSequenceOn.membership.backward
    exact ⟨x, member, rfl⟩
  have pairs : ∀ p ∈ ennSupSequenceOn(u, A), ∃ a, ∃ b, p = (a, b)
    intros p hp
    obtain ⟨k0, hk, pEq⟩ := ennSupSequenceOn.membership.forward with hp
    rw ← pEq
    exact ⟨k0, ennSupOn(familyAt(u, ℕ, k0), ℕ), rfl⟩
  have functional : ∀ a, ∀ b, ∀ c, (a, b) ∈ ennSupSequenceOn(u, A) → (a, c) ∈ ennSupSequenceOn(u, A) → b = c
    intros a b c hb hc
    obtain ⟨k0, hk, bEq⟩ := ennSupSequenceOn.membership.forward with hb
    obtain ⟨m0, hm, cEq⟩ := ennSupSequenceOn.membership.forward with hc
    obtain ⟨ka, bb⟩ := orderedPair.injective with bEq
    obtain ⟨ma, cc⟩ := orderedPair.injective with cEq
    rw [← bb, ← cc, ka, ← ma]
  exact pairGraph.apply with pairs, functional, edge


-- The heart of monotone convergence: values B(C) below the infima of the
-- pointwise supremum give a sum below the supremum of the integrals.
theorem lintegral.lint_mct_key (X μ u F P B : Set)
  requires measure : Measure(X, μ)
  requires measurable : ∀ n ∈ ℕ, Measurable(u(n), X, ennMeasurableSpace)
  requires increasing : ∀ m ∈ ℕ, ∀ n ∈ ℕ, m ⊆ n →
    ∀ x ∈ MeasurableSpace.carrier(X), EnnLe(u(m)(x), u(n)(x))
  requires partition : MeasurablePartition(X, P)
  requires sup : ∀ x ∈ MeasurableSpace.carrier(X), F(x) = ennSupOn(familyAt(u, ℕ, x), ℕ)
  requires bvalues : ∀ C ∈ P, B(C) ∈ ennreal
  requires below : ∀ C ∈ P, B(C) = realZero ∨ EnnLt(B(C), ennInfOn(F, C))
  shows EnnLe(ennFiniteSum(simpleTerms(μ, B, P), P),
    ennSupOn(lintegralSequence(X, μ, u), ℕ))
proof
  have space := Measure.space with measure
  have p2 := partition
  obtain ⟨fin, sub, cover, disj⟩ := p2
  have pieceX : ∀ C ∈ P, MeasurableSet(X, C) ∧ C ⊆ MeasurableSpace.carrier(X)
    intros C hC
    exact MeasurablePartition.pieces with space, partition, hC
  have vU : ∀ n ∈ ℕ, ∀ x ∈ MeasurableSpace.carrier(X), u(n)(x) ∈ ennreal
    intros n hn x hx
    have m := Measurable.maps with (measurable with n, hn), hx
    rw ennMeasurableSpace.carrier at m
    exact m
  have valuesN : ∀ n ∈ ℕ, EnnValued(X, u(n))
    intros n hn
    unfold EnnValued
    unfold MapsInto
    exact vU with n, hn
  have iv : ∀ n ∈ ℕ, lintegralSequence(X, μ, u)(n) ∈ ennreal
    intros n hn
    rw lintegralSequence.lint_apply with hn
    exact lintegral.member with measure
  obtain ⟨sM, sUp, sLeast⟩ := ennSupOn.lint_bounds with iv
  have gtM : ∀ n ∈ ℕ, ∀ C ∈ P, MeasurableSet(X, C ∩ ennGtSet(u(n), MeasurableSpace.carrier(X), B(C)))
    intros n hn C hC
    have g := MeasurableSet.lint_gt with (measurable with n, hn), (bvalues with C, hC)
    have pc := pieceX with C, hC
    exact MeasurableSet.inter with space, pc.left, g
  have gtInc : ∀ C ∈ P, ∀ k ∈ ℕ, ∀ n ∈ ℕ, k ⊆ n → C ∩ ennGtSet(u(k), MeasurableSpace.carrier(X), B(C)) ⊆ C ∩ ennGtSet(u(n), MeasurableSpace.carrier(X), B(C))
    intros C hC k hk n hn kn x hx
    obtain ⟨xC, xG⟩ := intersection.membership.forward with hx
    unfold ennGtSet at xG
    simp at xG
    obtain ⟨xX, nle⟩ := xG
    have nle2 : ¬EnnLe(u(n)(x), B(C))
      intro le
      apply nle
      exact EnnLe.transitive with (increasing with k, hk, n, hn, kn, x, xX), le
    have g : x ∈ ennGtSet(u(n), MeasurableSpace.carrier(X), B(C))
      unfold ennGtSet
      simp [xX, nle2]
    exact intersection.membership.backward with xC, g
  have Vv : ∀ n ∈ ℕ, ∀ C ∈ P, lintGtSeq(μ, u, X, B, P)(n)(C) ∈ ennreal
    intros n hn C hC
    rw lintGtSeq.apply with hn
    rw lintGtTerms.apply with hC
    exact ennMul.member with (bvalues with C, hC), (Measure.member with measure, (gtM with n, hn, C, hC))
  have Vinc : ∀ k ∈ ℕ, ∀ n ∈ ℕ, k ⊆ n → ∀ C ∈ P, EnnLe(lintGtSeq(μ, u, X, B, P)(k)(C), lintGtSeq(μ, u, X, B, P)(n)(C))
    intros k hk n hn kn C hC
    rw lintGtSeq.apply with hk
    rw lintGtSeq.apply with hn
    rw lintGtTerms.apply at μ, u, X, B, P, k, C with hC
    rw lintGtTerms.apply at μ, u, X, B, P, n, C with hC
    have inc := gtInc with C, hC, k, hk, n, hn, kn
    have mono := Measure.mono with measure, (gtM with k, hk, C, hC), (gtM with n, hn, C, hC), inc
    exact ennMul.mono with (EnnLe.reflexive with (bvalues with C, hC)), mono
  have perN : ∀ n ∈ ℕ, EnnLe(lintFinSums(lintGtSeq(μ, u, X, B, P), P)(n), ennSupOn(lintegralSequence(X, μ, u), ℕ))
    intros n hn
    rw lintFinSums.apply with hn
    rw lintGtSeq.apply with hn
    have setsG : ∀ C ∈ P, MeasurableSet(X, lintGtPieces(u, X, B, n, P)(C))
      intros C hC
      rw lintGtPieces.apply with hC
      exact gtM with n, hn, C, hC
    have insideG : ∀ C ∈ P, lintGtPieces(u, X, B, n, P)(C) ⊆ C
      intros C hC x hx
      rw lintGtPieces.apply with hC at hx
      obtain ⟨a, b⟩ := intersection.membership.forward with hx
      exact a
    have boundG : ∀ C ∈ P, ∀ x ∈ lintGtPieces(u, X, B, n, P)(C), EnnLe(B(C), u(n)(x))
      intros C hC x hx
      rw lintGtPieces.apply with hC at hx
      obtain ⟨a, b⟩ := intersection.membership.forward with hx
      unfold ennGtSet at b
      simp at b
      obtain ⟨xX, nle⟩ := b
      have ux := vU with n, hn, x, xX
      have tot := EnnLe.total with (bvalues with C, hC), ux
      cases tot with l | r
      . exact l
      . exfalso
        exact nle with r
    have termsG : ∀ C ∈ P, lintGtTerms(μ, u, X, B, P, n)(C) = ennMul(B(C), μ(lintGtPieces(u, X, B, n, P)(C)))
      intros C hC
      rw lintGtTerms.apply with hC
      rw lintGtPieces.apply with hC
    have gen := lintegral.lint_lower with measure, (valuesN with n, hn), partition, setsG, insideG, bvalues, boundG, termsG
    have up := sUp with n, hn
    rw lintegralSequence.lint_apply with hn at up
    exact EnnLe.transitive with gen, up
  have fsv : ∀ n ∈ ℕ, lintFinSums(lintGtSeq(μ, u, X, B, P), P)(n) ∈ ennreal
    intros n hn
    rw lintFinSums.apply with hn
    exact ennFiniteSum.member with fin, (Vv with n, hn)
  obtain ⟨tM, tUp, tLeast⟩ := ennSupOn.lint_bounds with fsv
  have tle := tLeast with ennSupOn(lintegralSequence(X, μ, u), ℕ), sM, perN
  have sups : ∀ C ∈ P, ennPointwiseSup(lintGtSeq(μ, u, X, B, P), P)(C) = ennSupOn(familyAt(lintGtSeq(μ, u, X, B, P), ℕ, C), ℕ)
    intros C hC
    exact ennPointwiseSup.lint_apply with hC
  have e7 := ennFiniteSum.lint_le_sup with fin, Vv, Vinc, sups
  have famV : ∀ C ∈ P, ∀ n ∈ ℕ, familyAt(lintGtSeq(μ, u, X, B, P), ℕ, C)(n) ∈ ennreal
    intros C hC n hn
    rw familyAt.apply with hn
    exact Vv with n, hn, C, hC
  have perC : ∀ C ∈ P, EnnLe(simpleTerms(μ, B, P)(C), ennPointwiseSup(lintGtSeq(μ, u, X, B, P), P)(C))
    intros C hC
    rw simpleTerms.apply with hC
    rw ennPointwiseSup.lint_apply with hC
    obtain ⟨fM, fUp, fLeast⟩ := ennSupOn.lint_bounds with (famV with C, hC)
    have pc := pieceX with C, hC
    have bC := bvalues with C, hC
    have below2 := below with C, hC
    cases below2 with b0 | blt
    . rw ennMul.zero_left with b0, (Measure.member with measure, pc.left)
      exact EnnLe.zero with fM
    . have Gsets : ∀ n ∈ ℕ, MeasurableSet(X, lintGtSets(u, X, C, B(C))(n))
        intros n hn
        rw lintGtSets.apply with hn
        exact gtM with n, hn, C, hC
      have Ginc : ∀ m ∈ ℕ, ∀ n ∈ ℕ, m ⊆ n → lintGtSets(u, X, C, B(C))(m) ⊆ lintGtSets(u, X, C, B(C))(n)
        intros m hm n hn mn
        rw lintGtSets.apply with hm
        rw lintGtSets.apply with hn
        exact gtInc with C, hC, m, hm, n, hn, mn
      have iu := Measure.increasing_union with measure, Gsets, Ginc
      have vFC : ∀ y ∈ C, F(y) ∈ ennreal
        intros y hy
        have yX := pc.right with y, hy
        rw sup with y, yX
        have fy : ∀ n ∈ ℕ, familyAt(u, ℕ, y)(n) ∈ ennreal
          intros n hn
          rw familyAt.apply with hn
          exact vU with n, hn, y, yX
        obtain ⟨m1, m2, m3⟩ := ennSupOn.lint_bounds with fy
        exact m1
      have cov : sequenceUnion(lintGtSets(u, X, C, B(C))) = C
        ext x
        constructor
        . intro hx
          unfold sequenceUnion at hx
          obtain ⟨D, hD, xD⟩ := union.membership.forward with hx
          obtain ⟨n, hn, e⟩ := valuesOn.membership.forward with hD
          rw ← e at xD
          rw lintGtSets.apply with hn at xD
          obtain ⟨a, b⟩ := intersection.membership.forward with xD
          exact a
        . intro xC
          have xX := pc.right with x, xC
          have cle := ennInfOn.le_value with vFC, xC
          rw sup with x, xX at cle
          have inside : valuesOn(familyAt(u, ℕ, x), ℕ) ⊆ ennreal
            intros v hv
            obtain ⟨n, hn, e⟩ := valuesOn.membership.forward with hv
            rw ← e
            rw familyAt.apply with hn
            exact vU with n, hn, x, xX
          have blt2 := blt
          unfold EnnLt at blt2
          obtain ⟨ble, bne⟩ := blt2
          have le2 := EnnLe.transitive with ble, cle
          unfold ennSupOn at le2
          unfold ennSupOn at cle
          have lt2 : EnnLt(B(C), ennSup(valuesOn(familyAt(u, ℕ, x), ℕ)))
            unfold EnnLt
            refine ⟨le2, ?_⟩
            intro e
            apply bne
            rw ← e at cle
            exact EnnLe.antisymmetric with ble, cle
          have ex := (ennSup.lt_iff with inside, bC).forward with lt2
          obtain ⟨v, hv, vlt⟩ := ex
          obtain ⟨n, hn, e⟩ := valuesOn.membership.forward with hv
          rw familyAt.apply with hn at e
          unfold EnnLt at vlt
          obtain ⟨vle, vne⟩ := vlt
          have ngt : ¬EnnLe(u(n)(x), B(C))
            intro le
            apply vne
            rw ← e
            rw ← e at vle
            exact EnnLe.antisymmetric with vle, le
          have g : x ∈ ennGtSet(u(n), MeasurableSpace.carrier(X), B(C))
            unfold ennGtSet
            simp [xX, ngt]
          have xg : x ∈ lintGtSets(u, X, C, B(C))(n)
            rw lintGtSets.apply with hn
            exact intersection.membership.backward with xC, g
          have inV : lintGtSets(u, X, C, B(C))(n) ∈ valuesOn(lintGtSets(u, X, C, B(C)), ℕ) := valuesOn.membership.backward with ⟨n, hn, rfl⟩
          unfold sequenceUnion
          exact union.membership.backward with ⟨lintGtSets(u, X, C, B(C))(n), inV, xg⟩
      rw cov at iu
      have msv : ∀ n ∈ ℕ, measureSequence(μ, lintGtSets(u, X, C, B(C)))(n) ∈ ennreal
        intros n hn
        rw measureSequence.apply with hn
        exact Measure.member with measure, (Gsets with n, hn)
      have prod : ∀ n ∈ ℕ, familyAt(lintGtSeq(μ, u, X, B, P), ℕ, C)(n) = ennMul(B(C), measureSequence(μ, lintGtSets(u, X, C, B(C)))(n))
        intros n hn
        rw familyAt.apply with hn
        rw lintGtSeq.apply with hn
        rw lintGtTerms.apply with hC
        rw measureSequence.apply with hn
        rw lintGtSets.apply with hn
      have e5 := ennMul.lint_le_sup with bC, msv, prod
      rw ← iu at e5
      exact e5
  have svv : ∀ C ∈ P, simpleTerms(μ, B, P)(C) ∈ ennreal
    intros C hC
    rw simpleTerms.apply with hC
    have pc := pieceX with C, hC
    exact ennMul.member with (bvalues with C, hC), (Measure.member with measure, pc.left)
  have Lv : ∀ C ∈ P, ennPointwiseSup(lintGtSeq(μ, u, X, B, P), P)(C) ∈ ennreal
    intros C hC
    rw ennPointwiseSup.lint_apply with hC
    obtain ⟨fM, fUp, fLeast⟩ := ennSupOn.lint_bounds with (famV with C, hC)
    exact fM
  have m1 := ennFiniteSum.mono_fun with fin, svv, Lv, perC
  have t1 := EnnLe.transitive with m1, e7
  exact EnnLe.transitive with t1, tle


def lintBetas (F P k : Set) : Set := { (C, lintApprox(ennInfOn(F, C), k)) | C ∈ P }
def lintBetaFam (F P : Set) : Set := { (k, lintBetas(F, P, k)) | k ∈ ℕ }
def lintBetaSeq (μ F P : Set) : Set := { (k, simpleTerms(μ, lintBetas(F, P, k), P)) | k ∈ ℕ }

theorem lintBetas.apply (F P k C : Set)
  requires member : C ∈ P
  shows lintBetas(F, P, k)(C) = lintApprox(ennInfOn(F, C), k)
proof
  have edge : (C, lintApprox(ennInfOn(F, C), k)) ∈ lintBetas(F, P, k)
    apply lintBetas.membership.backward
    exact ⟨C, member, rfl⟩
  have pairs : ∀ p ∈ lintBetas(F, P, k), ∃ a, ∃ b, p = (a, b)
    intros p hp
    obtain ⟨k0, hk, pEq⟩ := lintBetas.membership.forward with hp
    rw ← pEq
    exact ⟨k0, lintApprox(ennInfOn(F, k0), k), rfl⟩
  have functional : ∀ a, ∀ b, ∀ c, (a, b) ∈ lintBetas(F, P, k) → (a, c) ∈ lintBetas(F, P, k) → b = c
    intros a b c hb hc
    obtain ⟨k0, hk, bEq⟩ := lintBetas.membership.forward with hb
    obtain ⟨m0, hm, cEq⟩ := lintBetas.membership.forward with hc
    obtain ⟨ka, bb⟩ := orderedPair.injective with bEq
    obtain ⟨ma, cc⟩ := orderedPair.injective with cEq
    rw [← bb, ← cc, ka, ← ma]
  exact pairGraph.apply with pairs, functional, edge


theorem lintBetaFam.apply (F P k : Set)
  requires member : k ∈ ℕ
  shows lintBetaFam(F, P)(k) = lintBetas(F, P, k)
proof
  have edge : (k, lintBetas(F, P, k)) ∈ lintBetaFam(F, P)
    apply lintBetaFam.membership.backward
    exact ⟨k, member, rfl⟩
  have pairs : ∀ p ∈ lintBetaFam(F, P), ∃ a, ∃ b, p = (a, b)
    intros p hp
    obtain ⟨k0, hk, pEq⟩ := lintBetaFam.membership.forward with hp
    rw ← pEq
    exact ⟨k0, lintBetas(F, P, k0), rfl⟩
  have functional : ∀ a, ∀ b, ∀ c, (a, b) ∈ lintBetaFam(F, P) → (a, c) ∈ lintBetaFam(F, P) → b = c
    intros a b c hb hc
    obtain ⟨k0, hk, bEq⟩ := lintBetaFam.membership.forward with hb
    obtain ⟨m0, hm, cEq⟩ := lintBetaFam.membership.forward with hc
    obtain ⟨ka, bb⟩ := orderedPair.injective with bEq
    obtain ⟨ma, cc⟩ := orderedPair.injective with cEq
    rw [← bb, ← cc, ka, ← ma]
  exact pairGraph.apply with pairs, functional, edge


theorem lintBetaSeq.apply (μ F P k : Set)
  requires member : k ∈ ℕ
  shows lintBetaSeq(μ, F, P)(k) = simpleTerms(μ, lintBetas(F, P, k), P)
proof
  have edge : (k, simpleTerms(μ, lintBetas(F, P, k), P)) ∈ lintBetaSeq(μ, F, P)
    apply lintBetaSeq.membership.backward
    exact ⟨k, member, rfl⟩
  have pairs : ∀ p ∈ lintBetaSeq(μ, F, P), ∃ a, ∃ b, p = (a, b)
    intros p hp
    obtain ⟨k0, hk, pEq⟩ := lintBetaSeq.membership.forward with hp
    rw ← pEq
    exact ⟨k0, simpleTerms(μ, lintBetas(F, P, k0), P), rfl⟩
  have functional : ∀ a, ∀ b, ∀ c, (a, b) ∈ lintBetaSeq(μ, F, P) → (a, c) ∈ lintBetaSeq(μ, F, P) → b = c
    intros a b c hb hc
    obtain ⟨k0, hk, bEq⟩ := lintBetaSeq.membership.forward with hb
    obtain ⟨m0, hm, cEq⟩ := lintBetaSeq.membership.forward with hc
    obtain ⟨ka, bb⟩ := orderedPair.injective with bEq
    obtain ⟨ma, cc⟩ := orderedPair.injective with cEq
    rw [← bb, ← cc, ka, ← ma]
  exact pairGraph.apply with pairs, functional, edge


def lintApproxSeq (t : Set) : Set := { (k, lintApprox(t, k)) | k ∈ ℕ }
def lintLeSets (f X t : Set) : Set :=
  { (k, MeasurableSpace.carrier(X) ∖ ennGtSet(f, MeasurableSpace.carrier(X), lintApprox(t, k))) | k ∈ ℕ }

theorem lintApproxSeq.apply (t k : Set)
  requires member : k ∈ ℕ
  shows lintApproxSeq(t)(k) = lintApprox(t, k)
proof
  have edge : (k, lintApprox(t, k)) ∈ lintApproxSeq(t)
    apply lintApproxSeq.membership.backward
    exact ⟨k, member, rfl⟩
  have pairs : ∀ p ∈ lintApproxSeq(t), ∃ a, ∃ b, p = (a, b)
    intros p hp
    obtain ⟨k0, hk, pEq⟩ := lintApproxSeq.membership.forward with hp
    rw ← pEq
    exact ⟨k0, lintApprox(t, k0), rfl⟩
  have functional : ∀ a, ∀ b, ∀ c, (a, b) ∈ lintApproxSeq(t) → (a, c) ∈ lintApproxSeq(t) → b = c
    intros a b c hb hc
    obtain ⟨k0, hk, bEq⟩ := lintApproxSeq.membership.forward with hb
    obtain ⟨m0, hm, cEq⟩ := lintApproxSeq.membership.forward with hc
    obtain ⟨ka, bb⟩ := orderedPair.injective with bEq
    obtain ⟨ma, cc⟩ := orderedPair.injective with cEq
    rw [← bb, ← cc, ka, ← ma]
  exact pairGraph.apply with pairs, functional, edge


theorem lintLeSets.apply (f X t k : Set)
  requires member : k ∈ ℕ
  shows lintLeSets(f, X, t)(k) = MeasurableSpace.carrier(X) ∖ ennGtSet(f, MeasurableSpace.carrier(X), lintApprox(t, k))
proof
  have edge : (k, MeasurableSpace.carrier(X) ∖ ennGtSet(f, MeasurableSpace.carrier(X), lintApprox(t, k))) ∈ lintLeSets(f, X, t)
    apply lintLeSets.membership.backward
    exact ⟨k, member, rfl⟩
  have pairs : ∀ p ∈ lintLeSets(f, X, t), ∃ a, ∃ b, p = (a, b)
    intros p hp
    obtain ⟨k0, hk, pEq⟩ := lintLeSets.membership.forward with hp
    rw ← pEq
    exact ⟨k0, MeasurableSpace.carrier(X) ∖ ennGtSet(f, MeasurableSpace.carrier(X), lintApprox(t, k0)), rfl⟩
  have functional : ∀ a, ∀ b, ∀ c, (a, b) ∈ lintLeSets(f, X, t) → (a, c) ∈ lintLeSets(f, X, t) → b = c
    intros a b c hb hc
    obtain ⟨k0, hk, bEq⟩ := lintLeSets.membership.forward with hb
    obtain ⟨m0, hm, cEq⟩ := lintLeSets.membership.forward with hc
    obtain ⟨ka, bb⟩ := orderedPair.injective with bEq
    obtain ⟨ma, cc⟩ := orderedPair.injective with cEq
    rw [← bb, ← cc, ka, ← ma]
  exact pairGraph.apply with pairs, functional, edge


-- The sets {f ≥ t} of a measurable map into [0, ∞] are measurable.
theorem MeasurableSet.lint_ge (f X t : Set)
  requires measurable : Measurable(f, X, ennMeasurableSpace)
  requires member : t ∈ ennreal
  shows MeasurableSet(X, ennGeSet(f, MeasurableSpace.carrier(X), t))
proof
  have space : MeasurableSpace(X)
    unfold Measurable at measurable
    exact measurable.left
  have fv : ∀ x ∈ MeasurableSpace.carrier(X), f(x) ∈ ennreal
    intros x hx
    have m := Measurable.maps with measurable, hx
    rw ennMeasurableSpace.carrier at m
    exact m
  by_cases t0 : t = realZero
  . have same : ennGeSet(f, MeasurableSpace.carrier(X), t) = MeasurableSpace.carrier(X)
      ext x
      constructor
      . intro h
        unfold ennGeSet at h
        simp at h
        exact h.left
      . intro h
        have z := EnnLe.zero with (fv with x, h)
        rw ← t0 at z
        unfold ennGeSet
        simp [h, z]
    rw same
    exact MeasurableSet.univ with space
  . have Lm : ∀ k ∈ ℕ, MeasurableSet(X, lintLeSets(f, X, t)(k))
      intros k hk
      rw lintLeSets.apply with hk
      have f1 := lintApprox.facts with member, hk
      have g := MeasurableSet.lint_gt with measurable, f1.left
      exact MeasurableSet.compl with space, g
    have av : ∀ k ∈ ℕ, lintApproxSeq(t)(k) = lintApprox(t, k)
      intros k hk
      exact lintApproxSeq.apply with hk
    have asup := lintApprox.sup with member, av
    have avv : ∀ k ∈ ℕ, lintApproxSeq(t)(k) ∈ ennreal
      intros k hk
      rw av with k, hk
      have f1 := lintApprox.facts with member, hk
      exact f1.left
    have inside : valuesOn(lintApproxSeq(t), ℕ) ⊆ ennreal
      intros v hv
      obtain ⟨k, hk, e⟩ := valuesOn.membership.forward with hv
      rw ← e
      exact avv with k, hk
    have same : sequenceUnion(lintLeSets(f, X, t)) = MeasurableSpace.carrier(X) ∖ ennGeSet(f, MeasurableSpace.carrier(X), t)
      ext x
      constructor
      . intro hx
        unfold sequenceUnion at hx
        obtain ⟨D, hD, xD⟩ := union.membership.forward with hx
        obtain ⟨k, hk, e⟩ := valuesOn.membership.forward with hD
        rw ← e at xD
        rw lintLeSets.apply with hk at xD
        obtain ⟨xX, xNot⟩ := difference.membership.forward with xD
        have fx := fv with x, xX
        have f1 := lintApprox.facts with member, hk
        have le : EnnLe(f(x), lintApprox(t, k))
          by_contra nle
          apply xNot
          unfold ennGtSet
          simp [xX, nle]
        have nge : ¬EnnLe(t, f(x))
          intro tle
          have tk := EnnLe.transitive with tle, le
          obtain ⟨am, alt⟩ := f1
          cases alt with a0 | alt2
          . rw a0 at tk
            apply t0
            exact EnnLe.antisymmetric with tk, (EnnLe.zero with member)
          . unfold EnnLt at alt2
            apply alt2.right
            exact EnnLe.antisymmetric with alt2.left, tk
        have g : x ∉ ennGeSet(f, MeasurableSpace.carrier(X), t)
          intro h
          unfold ennGeSet at h
          simp at h
        exact difference.membership.backward with xX, g
      . intro hx
        obtain ⟨xX, xNot⟩ := difference.membership.forward with hx
        have fx := fv with x, xX
        have nge : ¬EnnLe(t, f(x))
          intro h
          apply xNot
          unfold ennGeSet
          simp [xX, h]
        have tot := EnnLe.total with fx, member
        cases tot with fle | tle
        . have lt : EnnLt(f(x), ennSup(valuesOn(lintApproxSeq(t), ℕ)))
            have l2 := EnnLe.transitive with fle, asup
            unfold ennSupOn at l2
            unfold ennSupOn at asup
            unfold EnnLt
            refine ⟨l2, ?_⟩
            intro e
            apply nge
            rw e
            exact asup
          have ex := (ennSup.lt_iff with inside, fx).forward with lt
          obtain ⟨v, hv, vlt⟩ := ex
          obtain ⟨k, hk, e⟩ := valuesOn.membership.forward with hv
          rw av with k, hk at e
          rw ← e at vlt
          unfold EnnLt at vlt
          have xL : x ∈ lintLeSets(f, X, t)(k)
            rw lintLeSets.apply with hk
            have g : x ∉ ennGtSet(f, MeasurableSpace.carrier(X), lintApprox(t, k))
              intro h
              unfold ennGtSet at h
              simp at h
              exact h.right with vlt.left
            exact difference.membership.backward with xX, g
          have inV : lintLeSets(f, X, t)(k) ∈ valuesOn(lintLeSets(f, X, t), ℕ) := valuesOn.membership.backward with ⟨k, hk, rfl⟩
          unfold sequenceUnion
          exact union.membership.backward with ⟨lintLeSets(f, X, t)(k), inV, xL⟩
        . exfalso
          exact nge with tle
    have um := MeasurableSet.sequence_union with space, Lm
    rw same at um
    have cm := MeasurableSet.compl with space, um
    have same2 : MeasurableSpace.carrier(X) ∖ (MeasurableSpace.carrier(X) ∖ ennGeSet(f, MeasurableSpace.carrier(X), t)) = ennGeSet(f, MeasurableSpace.carrier(X), t)
      ext x
      constructor
      . intro h
        obtain ⟨xX, notIn⟩ := difference.membership.forward with h
        by_contra nin
        apply notIn
        exact difference.membership.backward with xX, nin
      . intro h
        have h2 := h
        unfold ennGeSet at h2
        simp at h2
        simp [h, h2]
    rw same2 at cm
    exact cm


def lintGeSets (f X : Set) : Set :=
  { (k, ennGeSet(f, MeasurableSpace.carrier(X), R[realOne - lintRatio(k)])) | k ∈ ℕ }

theorem lintGeSets.apply (f X k : Set)
  requires member : k ∈ ℕ
  shows lintGeSets(f, X)(k) = ennGeSet(f, MeasurableSpace.carrier(X), R[realOne - lintRatio(k)])
proof
  have edge : (k, ennGeSet(f, MeasurableSpace.carrier(X), R[realOne - lintRatio(k)])) ∈ lintGeSets(f, X)
    apply lintGeSets.membership.backward
    exact ⟨k, member, rfl⟩
  have pairs : ∀ p ∈ lintGeSets(f, X), ∃ a, ∃ b, p = (a, b)
    intros p hp
    obtain ⟨k0, hk, pEq⟩ := lintGeSets.membership.forward with hp
    rw ← pEq
    exact ⟨k0, ennGeSet(f, MeasurableSpace.carrier(X), R[realOne - lintRatio(k0)]), rfl⟩
  have functional : ∀ a, ∀ b, ∀ c, (a, b) ∈ lintGeSets(f, X) → (a, c) ∈ lintGeSets(f, X) → b = c
    intros a b c hb hc
    obtain ⟨k0, hk, bEq⟩ := lintGeSets.membership.forward with hb
    obtain ⟨m0, hm, cEq⟩ := lintGeSets.membership.forward with hc
    obtain ⟨ka, bb⟩ := orderedPair.injective with bEq
    obtain ⟨ma, cc⟩ := orderedPair.injective with cEq
    rw [← bb, ← cc, ka, ← ma]
  exact pairGraph.apply with pairs, functional, edge

-- Section: Helpers for additivity
-- The piece of a partition containing x; a map constant on the pieces
-- with value w(C) on C; the scaled infima C ↦ inf_C h · t.
def lintPieceSet (P x : Set) : Set := { C ∈ P | x ∈ C }
def lintPieceOf (P x : Set) : Set := ⋃(lintPieceSet(P, x))
def lintStepOn (P w A : Set) : Set := { (x, w(lintPieceOf(P, x))) | x ∈ A }
def lintScaledInfs (h P t : Set) : Set := { (C, ennMul(ennInfOn(h, C), t)) | C ∈ P }

-- The levels j/(k + 1) and the remainders 1 − (j + 1)/(k + 1), and the
-- band of C where a · j/(k + 1) ≤ f < a · (j + 1)/(k + 1) (no upper bound
-- for j = k); the bands of the pieces of a partition; and the pieces
-- A ∩ B of two partitions.
def lintLev (k j : Set) : Set := R[realNat(j) * realInvValue(realNat(k) + realOne)]
def lintRest (k j : Set) : Set :=
  R[realOne - (realNat(j) + realOne) * realInvValue(realNat(k) + realOne)]
def lintLevSeq (s k : Set) : Set := { (j, ennMul(s, lintLev(k, j))) | j ∈ ℕ }
def lintBand (f C a k j : Set) : Set :=
  { x ∈ C | EnnLe(ennMul(a, lintLev(k, j)), f(x)) ∧
    (j = k ∨ ¬EnnLe(ennMul(a, lintLev(k, succ(j))), f(x))) }
def lintBandFam (f h C k : Set) : Set := { (j, lintBand(f, C, ennInfOn(h, C), k, j)) | j ∈ succ(k) }
def lintBandRows (f h k P : Set) : Set :=
  { (C, valuesOn(lintBandFam(f, h, C, k), succ(k))) | C ∈ P }
def lintInterRows (P Q : Set) : Set := { (A, valuesOn(interWith(Q, A), Q)) | A ∈ P }

theorem lintStepOn.apply (P w A x : Set)
  requires member : x ∈ A
  shows lintStepOn(P, w, A)(x) = w(lintPieceOf(P, x))
proof
  have edge : (x, w(lintPieceOf(P, x))) ∈ lintStepOn(P, w, A)
    apply lintStepOn.membership.backward
    exact ⟨x, member, rfl⟩
  have pairs : ∀ p ∈ lintStepOn(P, w, A), ∃ a, ∃ b, p = (a, b)
    intros p hp
    obtain ⟨k0, hk, pEq⟩ := lintStepOn.membership.forward with hp
    rw ← pEq
    exact ⟨k0, w(lintPieceOf(P, k0)), rfl⟩
  have functional : ∀ a, ∀ b, ∀ c, (a, b) ∈ lintStepOn(P, w, A) → (a, c) ∈ lintStepOn(P, w, A) → b = c
    intros a b c hb hc
    obtain ⟨k0, hk, bEq⟩ := lintStepOn.membership.forward with hb
    obtain ⟨m0, hm, cEq⟩ := lintStepOn.membership.forward with hc
    obtain ⟨ka, bb⟩ := orderedPair.injective with bEq
    obtain ⟨ma, cc⟩ := orderedPair.injective with cEq
    rw [← bb, ← cc, ka, ← ma]
  exact pairGraph.apply with pairs, functional, edge

theorem lintScaledInfs.apply (h P t C : Set)
  requires member : C ∈ P
  shows lintScaledInfs(h, P, t)(C) = ennMul(ennInfOn(h, C), t)
proof
  have edge : (C, ennMul(ennInfOn(h, C), t)) ∈ lintScaledInfs(h, P, t)
    apply lintScaledInfs.membership.backward
    exact ⟨C, member, rfl⟩
  have pairs : ∀ p ∈ lintScaledInfs(h, P, t), ∃ a, ∃ b, p = (a, b)
    intros p hp
    obtain ⟨k0, hk, pEq⟩ := lintScaledInfs.membership.forward with hp
    rw ← pEq
    exact ⟨k0, ennMul(ennInfOn(h, k0), t), rfl⟩
  have functional : ∀ a, ∀ b, ∀ c, (a, b) ∈ lintScaledInfs(h, P, t) → (a, c) ∈ lintScaledInfs(h, P, t) → b = c
    intros a b c hb hc
    obtain ⟨k0, hk, bEq⟩ := lintScaledInfs.membership.forward with hb
    obtain ⟨m0, hm, cEq⟩ := lintScaledInfs.membership.forward with hc
    obtain ⟨ka, bb⟩ := orderedPair.injective with bEq
    obtain ⟨ma, cc⟩ := orderedPair.injective with cEq
    rw [← bb, ← cc, ka, ← ma]
  exact pairGraph.apply with pairs, functional, edge

theorem lintLevSeq.apply (s k j : Set)
  requires member : j ∈ ℕ
  shows lintLevSeq(s, k)(j) = ennMul(s, lintLev(k, j))
proof
  have edge : (j, ennMul(s, lintLev(k, j))) ∈ lintLevSeq(s, k)
    apply lintLevSeq.membership.backward
    exact ⟨j, member, rfl⟩
  have pairs : ∀ p ∈ lintLevSeq(s, k), ∃ a, ∃ b, p = (a, b)
    intros p hp
    obtain ⟨k0, hk, pEq⟩ := lintLevSeq.membership.forward with hp
    rw ← pEq
    exact ⟨k0, ennMul(s, lintLev(k, k0)), rfl⟩
  have functional : ∀ a, ∀ b, ∀ c, (a, b) ∈ lintLevSeq(s, k) → (a, c) ∈ lintLevSeq(s, k) → b = c
    intros a b c hb hc
    obtain ⟨k0, hk, bEq⟩ := lintLevSeq.membership.forward with hb
    obtain ⟨m0, hm, cEq⟩ := lintLevSeq.membership.forward with hc
    obtain ⟨ka, bb⟩ := orderedPair.injective with bEq
    obtain ⟨ma, cc⟩ := orderedPair.injective with cEq
    rw [← bb, ← cc, ka, ← ma]
  exact pairGraph.apply with pairs, functional, edge

theorem lintBandFam.apply (f h C k j : Set)
  requires member : j ∈ succ(k)
  shows lintBandFam(f, h, C, k)(j) = lintBand(f, C, ennInfOn(h, C), k, j)
proof
  have edge : (j, lintBand(f, C, ennInfOn(h, C), k, j)) ∈ lintBandFam(f, h, C, k)
    apply lintBandFam.membership.backward
    exact ⟨j, member, rfl⟩
  have pairs : ∀ p ∈ lintBandFam(f, h, C, k), ∃ a, ∃ b, p = (a, b)
    intros p hp
    obtain ⟨k0, hk, pEq⟩ := lintBandFam.membership.forward with hp
    rw ← pEq
    exact ⟨k0, lintBand(f, C, ennInfOn(h, C), k, k0), rfl⟩
  have functional : ∀ a, ∀ b, ∀ c, (a, b) ∈ lintBandFam(f, h, C, k) → (a, c) ∈ lintBandFam(f, h, C, k) → b = c
    intros a b c hb hc
    obtain ⟨k0, hk, bEq⟩ := lintBandFam.membership.forward with hb
    obtain ⟨m0, hm, cEq⟩ := lintBandFam.membership.forward with hc
    obtain ⟨ka, bb⟩ := orderedPair.injective with bEq
    obtain ⟨ma, cc⟩ := orderedPair.injective with cEq
    rw [← bb, ← cc, ka, ← ma]
  exact pairGraph.apply with pairs, functional, edge

theorem lintBandRows.apply (f h k P C : Set)
  requires member : C ∈ P
  shows lintBandRows(f, h, k, P)(C) = valuesOn(lintBandFam(f, h, C, k), succ(k))
proof
  have edge : (C, valuesOn(lintBandFam(f, h, C, k), succ(k))) ∈ lintBandRows(f, h, k, P)
    apply lintBandRows.membership.backward
    exact ⟨C, member, rfl⟩
  have pairs : ∀ p ∈ lintBandRows(f, h, k, P), ∃ a, ∃ b, p = (a, b)
    intros p hp
    obtain ⟨k0, hk, pEq⟩ := lintBandRows.membership.forward with hp
    rw ← pEq
    exact ⟨k0, valuesOn(lintBandFam(f, h, k0, k), succ(k)), rfl⟩
  have functional : ∀ a, ∀ b, ∀ c, (a, b) ∈ lintBandRows(f, h, k, P) → (a, c) ∈ lintBandRows(f, h, k, P) → b = c
    intros a b c hb hc
    obtain ⟨k0, hk, bEq⟩ := lintBandRows.membership.forward with hb
    obtain ⟨m0, hm, cEq⟩ := lintBandRows.membership.forward with hc
    obtain ⟨ka, bb⟩ := orderedPair.injective with bEq
    obtain ⟨ma, cc⟩ := orderedPair.injective with cEq
    rw [← bb, ← cc, ka, ← ma]
  exact pairGraph.apply with pairs, functional, edge

theorem lintInterRows.apply (P Q A : Set)
  requires member : A ∈ P
  shows lintInterRows(P, Q)(A) = valuesOn(interWith(Q, A), Q)
proof
  have edge : (A, valuesOn(interWith(Q, A), Q)) ∈ lintInterRows(P, Q)
    apply lintInterRows.membership.backward
    exact ⟨A, member, rfl⟩
  have pairs : ∀ p ∈ lintInterRows(P, Q), ∃ a, ∃ b, p = (a, b)
    intros p hp
    obtain ⟨k0, hk, pEq⟩ := lintInterRows.membership.forward with hp
    rw ← pEq
    exact ⟨k0, valuesOn(interWith(Q, k0), Q), rfl⟩
  have functional : ∀ a, ∀ b, ∀ c, (a, b) ∈ lintInterRows(P, Q) → (a, c) ∈ lintInterRows(P, Q) → b = c
    intros a b c hb hc
    obtain ⟨k0, hk, bEq⟩ := lintInterRows.membership.forward with hb
    obtain ⟨m0, hm, cEq⟩ := lintInterRows.membership.forward with hc
    obtain ⟨ka, bb⟩ := orderedPair.injective with bEq
    obtain ⟨ma, cc⟩ := orderedPair.injective with cEq
    rw [← bb, ← cc, ka, ← ma]
  exact pairGraph.apply with pairs, functional, edge

theorem lintPieceOf.eq (X P C x : Set)
  requires partition : MeasurablePartition(X, P)
  requires piece : C ∈ P
  requires member : x ∈ C
  shows lintPieceOf(P, x) = C
proof
  have p2 := partition
  obtain ⟨fin, sub, cover, disj⟩ := p2
  have same : lintPieceSet(P, x) = {C}
    ext D
    unfold lintPieceSet
    constructor
    . intro h
      simp at h
      obtain ⟨DP, xD⟩ := h
      have e : D = C
        by_contra ne
        have d := disj with D, DP, C, piece, ne
        have d2 := Disjoint.iff.forward with d
        exact d2 with x, xD, member
      rw e
      simp
    . intro h
      simp at h
      rw h
      simp [piece, member]
  unfold lintPieceOf
  rw same
  exact union.singleton at C

theorem lintStepOn.on_piece (X P w A C x : Set)
  requires partition : MeasurablePartition(X, P)
  requires piece : C ∈ P
  requires member : x ∈ C
  requires inA : x ∈ A
  shows lintStepOn(P, w, A)(x) = w(C)
proof
  rw lintStepOn.apply with inA
  rw lintPieceOf.eq with partition, piece, member

theorem lintLev.facts (k j : Set)
  requires hk : k ∈ ℕ
  requires hj : j ∈ ℕ
  shows lintLev(k, j) ∈ ℝ ∧ realZero ≤ lintLev(k, j) ∧ lintRest(k, j) ∈ ℝ ∧
    R[lintLev(k, j) + lintRest(k, j)] = lintRatio(k) ∧
    R[lintLev(k, succ(j)) + lintRest(k, j)] = realOne ∧ lintLev(k, succ(j)) ∈ ℝ ∧
    lintLev(k, zero) = realZero
proof
  have kN := nat.omega.backward with hk
  have jN := nat.omega.backward with hj
  have nk := realNat.nonnegative at k
  have nj := realNat.nonnegative at j
  have pos : (0:R) < R[realNat(k) + realOne] by linarith
  have iPos := realInvValue.positive with pos
  have iR : realInvValue(R[realNat(k) + realOne]) ∈ ℝ by typecheck
  have lR : lintLev(k, j) ∈ ℝ
    unfold lintLev
    typecheck
  have l0 : realZero ≤ lintLev(k, j)
    unfold lintLev
    exact realMulValue.nonnegative with nj, (realLess.implies_le with iPos)
  have rR : lintRest(k, j) ∈ ℝ
    unfold lintRest
    typecheck
  have sj := realNat.succ at j
  have sum1 : R[lintLev(k, j) + lintRest(k, j)] = lintRatio(k)
    unfold lintLev
    unfold lintRest
    unfold lintRatio
    ring
  have sum2 : R[lintLev(k, succ(j)) + lintRest(k, j)] = realOne
    unfold lintLev
    unfold lintRest
    rw sj
    ring
  have sR : lintLev(k, succ(j)) ∈ ℝ
    unfold lintLev
    typecheck
  have z : lintLev(k, zero) = realZero
    unfold lintLev
    rw realNat.zero
    ring
  exact ⟨lR, l0, rR, sum1, sum2, sR, z⟩

-- Refining each piece C of a partition by a finite measurable partition
-- F(C) of C gives a partition.
theorem MeasurablePartition.lint_refine (X P F : Set)
  requires partition : MeasurablePartition(X, P)
  requires finite : ∀ C ∈ P, Finite(F(C))
  requires pieces : ∀ C ∈ P, ∀ E ∈ F(C), MeasurableSet(X, E) ∧ E ⊆ C
  requires cover : ∀ C ∈ P, ∀ x ∈ C, ∃ E ∈ F(C), x ∈ E
  requires disjoint : ∀ C ∈ P, ∀ E ∈ F(C), ∀ D ∈ F(C), E ≠ D → Disjoint(E, D)
  shows MeasurablePartition(X, ⋃(valuesOn(F, P)))
proof
  have p2 := partition
  obtain ⟨fin, sub, cov, disj⟩ := p2
  have inRef : ∀ E ∈ ⋃(valuesOn(F, P)), ∃ C ∈ P, E ∈ F(C)
    intros E hE
    obtain ⟨R, RIn, ER⟩ := union.membership.forward with hE
    obtain ⟨C, hC, e⟩ := valuesOn.membership.forward with RIn
    rw ← e at ER
    exact ⟨C, hC, ER⟩
  have finU : Finite(⋃(valuesOn(F, P)))
    have fv := valuesOn.lint_finite at F, P with fin
    apply Finite.big_union with fv
    intros S hS
    obtain ⟨C, hC, e⟩ := valuesOn.membership.forward with hS
    rw ← e
    exact finite with C, hC
  have subU : ⋃(valuesOn(F, P)) ⊆ MeasurableSpace.sets(X)
    intros E hE
    obtain ⟨C, hC, EF⟩ := inRef with E, hE
    have pc := pieces with C, hC, E, EF
    have m := pc.left
    unfold MeasurableSet at m
    exact m
  have covU : ⋃(⋃(valuesOn(F, P))) = MeasurableSpace.carrier(X)
    ext x
    constructor
    . intro h
      obtain ⟨E, EIn, xE⟩ := union.membership.forward with h
      obtain ⟨C, hC, EF⟩ := inRef with E, EIn
      have pc := pieces with C, hC, E, EF
      have xC := pc.right with x, xE
      rw ← cov
      exact union.membership.backward with ⟨C, hC, xC⟩
    . intro h
      rw ← cov at h
      obtain ⟨C, hC, xC⟩ := union.membership.forward with h
      obtain ⟨E, EF, xE⟩ := cover with C, hC, x, xC
      have inV : F(C) ∈ valuesOn(F, P) := valuesOn.membership.backward with ⟨C, hC, rfl⟩
      have EIn : E ∈ ⋃(valuesOn(F, P)) := union.membership.backward with ⟨F(C), inV, EF⟩
      exact union.membership.backward with ⟨E, EIn, xE⟩
  have disjU : ∀ A ∈ ⋃(valuesOn(F, P)), ∀ B ∈ ⋃(valuesOn(F, P)), A ≠ B → Disjoint(A, B)
    intros A hA B hB ne
    obtain ⟨C, hC, AF⟩ := inRef with A, hA
    obtain ⟨D, hD, BF⟩ := inRef with B, hB
    by_cases cd : C = D
    . rw cd at AF
      exact disjoint with D, hD, A, AF, B, BF, ne
    . have d := disj with C, hC, D, hD, cd
      have d2 := Disjoint.iff.forward with d
      apply Disjoint.iff.backward
      intros x xA xB
      have pa := pieces with C, hC, A, AF
      have pb := pieces with D, hD, B, BF
      exact d2 with x, (pa.right with x, xA), (pb.right with x, xB)
  unfold MeasurablePartition
  exact ⟨finU, subU, covU, disjU⟩

-- Below a value v with L(0) ≤ v, the first m levels either contain a
-- step L(j) ≤ v < L(j + 1) or stay below v.
theorem lintLevels.cover (L v : Set, m : Nat)
  requires base : EnnLe(L(zero), v)
  shows (∃ j ∈ m, EnnLe(L(j), v) ∧ ¬EnnLe(L(succ(j)), v)) ∨ EnnLe(L(m), v)
proof
  induction m
  | zero =>
    right
    exact base
  | succ(k) using ih =>
    cases ih with ex | le
    . left
      obtain ⟨j, hj, a, b⟩ := ex
      have hj2 : j ∈ succ(k) by simp [hj]
      exact ⟨j, hj2, a, b⟩
    . by_cases nxt : EnnLe(L(succ(k)), v)
      . right
        exact nxt
      . left
        have hk : k ∈ succ(k) by simp
        exact ⟨k, hk, le, nxt⟩

theorem lintLev.mono (k : Set, i j : Nat)
  requires hk : k ∈ ℕ
  requires le : i ≤ j
  shows (lintLev(k, i):R) ≤ (lintLev(k, j):R)
proof
  have kN := nat.omega.backward with hk
  have r := realNat.le_of_natural_le with le
  have nk := realNat.nonnegative at k
  have pos : (0:R) < R[realNat(k) + realOne] by linarith
  have iPos := realInvValue.positive with pos
  have m := realLe.mul_left_of_nonnegative with r, (realLess.implies_le with iPos)
  have e1 : lintLev(k, i) = R[realInvValue(realNat(k) + realOne) * realNat(i)]
    unfold lintLev
    ring
  have e2 : lintLev(k, j) = R[realInvValue(realNat(k) + realOne) * realNat(j)]
    unfold lintLev
    ring
  rw [e1, e2]
  exact m

theorem lintRest.facts (k j : Set)
  requires hk : k ∈ ℕ
  requires hj : j ∈ succ(k)
  shows realZero ≤ lintRest(k, j) ∧ lintRest(k, k) = realZero
proof
  have kN := nat.omega.backward with hk
  have skN : succ(k) ∈ ℕ by typecheck
  have jIn : j ∈ ℕ := natural.member at succ(k), j with hj
  have jN := nat.omega.backward with jIn
  have jk := LessEqual.of_membership_successor with hj
  have r := realNat.le_of_natural_le with jk
  have nk := realNat.nonnegative at k
  have pos : (0:R) < R[realNat(k) + realOne] by linarith
  have ne : R[realNat(k) + realOne] ≠ realZero
    intro z
    rw z at pos
    linarith
  have law := realInvValue.mul_left with ne
  have iPos := realInvValue.positive with pos
  have m := realLe.mul_left_of_nonnegative with r, (realLess.implies_le with iPos)
  have e1 : R[(realNat(j) + realOne) * realInvValue(realNat(k) + realOne)] = R[realInvValue(realNat(k) + realOne) * realNat(j) + realInvValue(realNat(k) + realOne)] by ring
  have e3 : R[(realNat(k) + realOne) * realInvValue(realNat(k) + realOne)] = R[realInvValue(realNat(k) + realOne) * realNat(k) + realInvValue(realNat(k) + realOne)] by ring
  have e2 : R[realInvValue(realNat(k) + realOne) * (realNat(k) + realOne)] = R[realInvValue(realNat(k) + realOne) * realNat(k) + realInvValue(realNat(k) + realOne)] by ring
  rw e2 at law
  have r0 : realZero ≤ lintRest(k, j)
    unfold lintRest
    rw e1
    linarith
  have rk : lintRest(k, k) = realZero
    unfold lintRest
    rw e3
    linarith
  exact ⟨r0, rk⟩

-- Every point of C lies in a band.
theorem lintBand.cover (f C a k x : Set)
  requires hk : k ∈ ℕ
  requires member : a ∈ ennreal
  requires xC : x ∈ C
  requires value : f(x) ∈ ennreal
  shows ∃ j ∈ succ(k), x ∈ lintBand(f, C, a, k, j)
proof
  have kN := nat.omega.backward with hk
  have zN : zero ∈ ℕ by typecheck
  obtain ⟨lR, l0, rR, s1, s2, sR, z⟩ := lintLev.facts with hk, zN
  have base : EnnLe(lintLevSeq(a, k)(zero), f(x))
    rw lintLevSeq.apply with zN
    rw z
    rw ennMul.zero_right with member, rfl
    exact EnnLe.zero with value
  have c := lintLevels.cover at lintLevSeq(a, k), f(x), k with base
  cases c with ex | top
  . obtain ⟨j, hj, le, nle⟩ := ex
    have jN : j ∈ ℕ := natural.member at k, j with hj
    have jNat := nat.omega.backward with jN
    have sjN : succ(j) ∈ ℕ by typecheck
    rw lintLevSeq.apply with jN at le
    rw lintLevSeq.apply with sjN at nle
    have hj2 : j ∈ succ(k) by simp [hj]
    have xb : x ∈ lintBand(f, C, a, k, j)
      unfold lintBand
      simp [xC, le, nle]
    exact ⟨j, hj2, xb⟩
  . rw lintLevSeq.apply with hk at top
    have hk2 : k ∈ succ(k) by simp
    have xb : x ∈ lintBand(f, C, a, k, k)
      unfold lintBand
      simp [xC, top]
    exact ⟨k, hk2, xb⟩

-- A point lies in at most one band.
theorem lintBand.unique (f C a k i j x : Set)
  requires hk : k ∈ ℕ
  requires member : a ∈ ennreal
  requires hi : i ∈ succ(k)
  requires hj : j ∈ succ(k)
  requires xi : x ∈ lintBand(f, C, a, k, i)
  requires xj : x ∈ lintBand(f, C, a, k, j)
  shows i = j
proof
  have kN := nat.omega.backward with hk
  have key : ∀ p ∈ succ(k), ∀ q ∈ succ(k), p ⊆ q → p ≠ q → x ∈ lintBand(f, C, a, k, p) → x ∉ lintBand(f, C, a, k, q)
    intros p hp q hq pq ne2 xp xq
    have pN : p ∈ ℕ := natural.member at succ(k), p with hp
    have qN : q ∈ ℕ := natural.member at succ(k), q with hq
    have pNat := nat.omega.backward with pN
    have qNat := nat.omega.backward with qN
    unfold lintBand at xp
    simp at xp
    obtain ⟨xC, lp, alt⟩ := xp
    unfold lintBand at xq
    simp at xq
    obtain ⟨xC2, lq, alt2⟩ := xq
    have qk := LessEqual.of_membership_successor with hq
    have ple := natural.lint_le_of_subset with pN, qN, pq
    have plt := Less.of_LessEqual_ne with ple, ne2
    have spq : succ(p) ≤ q by arith
    cases alt with pe | nl
    . rw pe at plt
      have bad := Less.not_LessEqual with plt
      exact bad with qk
    . have spN : succ(p) ∈ ℕ by typecheck
      obtain ⟨lR, l0, rR, s1, s2, sR, z⟩ := lintLev.facts with hk, spN
      obtain ⟨qR, q0, qrR, t1, t2, tR, z2⟩ := lintLev.facts with hk, qN
      have lm := lintLev.mono at k, succ(p), q with hk, spq
      have rl := EnnLe.lint_of_real with lR, qR, l0, lm
      have el := ennMul.mono with (EnnLe.reflexive with member), rl
      exact nl with (EnnLe.transitive with el, lq)
  have iN : i ∈ ℕ := natural.member at succ(k), i with hi
  have jN : j ∈ ℕ := natural.member at succ(k), j with hj
  by_contra ne
  have tot := natural.lint_total with iN, jN
  cases tot with a1 | a2
  . have kk := key with i, hi, j, hj, a1, ne, xi
    exact kk with xj
  . have ne2 : j ≠ i
      intro e
      apply ne
      rw e
    have kk := key with j, hj, i, hi, a2, ne2, xj
    exact kk with xi

-- On the band j of C, where a ≤ f + g: f ≥ a · j/(k + 1) and
-- g ≥ a · (1 − (j + 1)/(k + 1)).
theorem lintBand.bounds (f g C a k j x : Set)
  requires hk : k ∈ ℕ
  requires hj : j ∈ succ(k)
  requires member : a ∈ ennreal
  requires valueF : f(x) ∈ ennreal
  requires valueG : g(x) ∈ ennreal
  requires below : EnnLe(a, ennAdd(f(x), g(x)))
  requires xb : x ∈ lintBand(f, C, a, k, j)
  shows EnnLe(ennMul(a, lintLev(k, j)), f(x)) ∧ EnnLe(ennMul(a, lintRest(k, j)), g(x))
proof
  have kN := nat.omega.backward with hk
  unfold lintBand at xb
  simp at xb
  obtain ⟨xC, lf, alt⟩ := xb
  have jN : j ∈ ℕ := natural.member at succ(k), j with hj
  have jNat := nat.omega.backward with jN
  obtain ⟨lR, l0, rR, s1, s2, sR, z⟩ := lintLev.facts with hk, jN
  obtain ⟨r0, rk⟩ := lintRest.facts with hk, hj
  have restM := ennreal.of_real with rR, r0
  have second : EnnLe(ennMul(a, lintRest(k, j)), g(x))
    cases alt with jk | nl
    . rw jk
      rw rk
      rw ennMul.zero_right with member, rfl
      exact EnnLe.zero with valueG
    . by_cases gt : g(x) = ennTop
      . rw gt
        exact EnnLe.top with (ennMul.member with member, restM)
      . obtain ⟨gR, g0⟩ := ennreal.finite with valueG, gt
        have sjN : succ(j) ∈ ℕ by typecheck
        obtain ⟨sR2, s0, x1, x2, x3, x4, x5⟩ := lintLev.facts with hk, sjN
        have sM := ennreal.of_real with sR, s0
        have Lm := ennMul.member with member, sM
        have ft : f(x) ≠ ennTop
          intro e
          apply nl
          rw e
          exact EnnLe.top with Lm
        obtain ⟨fR, f0⟩ := ennreal.finite with valueF, ft
        have fReal : Real(f(x)) by exact fR
        have gReal : Real(g(x)) by exact gR
        have sumE := ennAdd.finite with fR, gR, f0, g0
        rw sumE at below
        have sumR : R[f(x) + g(x)] ∈ ℝ by typecheck
        have sumNT := ennreal.not_top_of_real with sumR
        have aT : a ≠ ennTop
          intro e
          rw e at below
          have t := EnnLe.top_eq with below
          exact sumNT with t
        obtain ⟨aR, a0⟩ := ennreal.finite with member, aT
        have aReal : Real(a) by exact aR
        have sReal : Real(lintLev(k, succ(j))) by exact sR
        have rReal : Real(lintRest(k, j)) by exact rR
        have L1 := ennMul.finite with aR, sR, a0, s0
        rw L1 at nl
        have pR : R[a * lintLev(k, succ(j))] ∈ ℝ by typecheck
        have p0 := realMulValue.nonnegative at a, lintLev(k, succ(j)) with a0, s0
        have fLt : (f(x):R) < (R[a * lintLev(k, succ(j))]:R)
          by_contra nlt
          have le2 : (R[a * lintLev(k, succ(j))]:R) ≤ (f(x):R) by linarith
          exact nl with (EnnLe.lint_of_real with pR, fR, p0, le2)
        obtain ⟨n1, n2, n3, aleR, n5⟩ := EnnLe.lint_to_real with below, sumNT
        have L2 := ennMul.finite with aR, rR, a0, r0
        rw L2
        have e0 : R[a * lintLev(k, succ(j)) + a * lintRest(k, j)] = R[a * (lintLev(k, succ(j)) + lintRest(k, j))] by ring
        rw s2 at e0
        have e1 : R[a * realOne] = a by ring
        have pR2 : R[a * lintRest(k, j)] ∈ ℝ by typecheck
        have p02 := realMulValue.nonnegative at a, lintRest(k, j) with a0, r0
        have le3 : (R[a * lintRest(k, j)]:R) ≤ (g(x):R) by linarith
        exact EnnLe.lint_of_real with pR2, gR, p02, le3
  exact ⟨lf, second⟩

-- The bands are measurable subsets of C.
theorem lintBand.measurable (f X C a k j : Set)
  requires measurable : Measurable(f, X, ennMeasurableSpace)
  requires set : MeasurableSet(X, C)
  requires member : a ∈ ennreal
  requires hk : k ∈ ℕ
  requires hj : j ∈ ℕ
  shows MeasurableSet(X, lintBand(f, C, a, k, j)) ∧ lintBand(f, C, a, k, j) ⊆ C
proof
  have space : MeasurableSpace(X)
    unfold Measurable at measurable
    exact measurable.left
  have jNat := nat.omega.backward with hj
  have sjN : succ(j) ∈ ℕ by typecheck
  obtain ⟨lR, l0, rR, s1, s2, sR, z⟩ := lintLev.facts with hk, hj
  obtain ⟨sR2, s0, x1, x2, x3, x4, x5⟩ := lintLev.facts with hk, sjN
  have L1M := ennMul.member with member, (ennreal.of_real with lR, l0)
  have L2M := ennMul.member with member, (ennreal.of_real with sR, s0)
  have G1 := MeasurableSet.lint_ge with measurable, L1M
  have G2 := MeasurableSet.lint_ge with measurable, L2M
  have CX := MeasurableSet.subset with space, set
  have sub : lintBand(f, C, a, k, j) ⊆ C
    intros x hx
    unfold lintBand at hx
    simp at hx
    exact hx.left
  by_cases jk : j = k
  . have same : lintBand(f, C, a, k, j) = C ∩ ennGeSet(f, MeasurableSpace.carrier(X), ennMul(a, lintLev(k, j)))
      ext x
      constructor
      . intro h
        unfold lintBand at h
        simp at h
        obtain ⟨xC, l1, alt⟩ := h
        have xX := CX with x, xC
        have g1 : x ∈ ennGeSet(f, MeasurableSpace.carrier(X), ennMul(a, lintLev(k, j)))
          unfold ennGeSet
          simp [xX, l1]
        exact intersection.membership.backward with xC, g1
      . intro h
        obtain ⟨xC, g1⟩ := intersection.membership.forward with h
        unfold ennGeSet at g1
        simp at g1
        unfold lintBand
        simp [xC, g1.right, jk]
    have m : MeasurableSet(X, lintBand(f, C, a, k, j))
      rw same
      exact MeasurableSet.inter with space, set, G1
    exact ⟨m, sub⟩
  . have same : lintBand(f, C, a, k, j) = (C ∩ ennGeSet(f, MeasurableSpace.carrier(X), ennMul(a, lintLev(k, j)))) ∖ ennGeSet(f, MeasurableSpace.carrier(X), ennMul(a, lintLev(k, succ(j))))
      ext x
      constructor
      . intro h
        unfold lintBand at h
        simp at h
        obtain ⟨xC, l1, alt⟩ := h
        have xX := CX with x, xC
        have g1 : x ∈ ennGeSet(f, MeasurableSpace.carrier(X), ennMul(a, lintLev(k, j)))
          unfold ennGeSet
          simp [xX, l1]
        cases alt with e | nl
        . exfalso
          exact jk with e
        . have g2 : x ∉ ennGeSet(f, MeasurableSpace.carrier(X), ennMul(a, lintLev(k, succ(j))))
            intro h2
            unfold ennGeSet at h2
            simp at h2
          have inter := intersection.membership.backward with xC, g1
          exact difference.membership.backward with inter, g2
      . intro h
        obtain ⟨xCG, xn⟩ := difference.membership.forward with h
        obtain ⟨xC, g1⟩ := intersection.membership.forward with xCG
        unfold ennGeSet at g1
        simp at g1
        have nl : ¬EnnLe(ennMul(a, lintLev(k, succ(j))), f(x))
          intro l
          apply xn
          unfold ennGeSet
          simp [g1.left, l]
        unfold lintBand
        simp [xC, g1.right, nl]
    have m : MeasurableSet(X, lintBand(f, C, a, k, j))
      rw same
      exact MeasurableSet.diff with space, (MeasurableSet.inter with space, set, G1), G2
    exact ⟨m, sub⟩

def lintSumTerms (μ f g P : Set) : Set :=
  { (E, ennAdd(ennMul(ennInfOn(f, E), μ(E)), ennMul(ennInfOn(g, E), μ(E)))) | E ∈ P }

theorem lintSumTerms.apply (μ f g P E : Set)
  requires member : E ∈ P
  shows lintSumTerms(μ, f, g, P)(E) = ennAdd(ennMul(ennInfOn(f, E), μ(E)), ennMul(ennInfOn(g, E), μ(E)))
proof
  have edge : (E, ennAdd(ennMul(ennInfOn(f, E), μ(E)), ennMul(ennInfOn(g, E), μ(E)))) ∈ lintSumTerms(μ, f, g, P)
    apply lintSumTerms.membership.backward
    exact ⟨E, member, rfl⟩
  have pairs : ∀ p ∈ lintSumTerms(μ, f, g, P), ∃ a, ∃ b, p = (a, b)
    intros p hp
    obtain ⟨k0, hk, pEq⟩ := lintSumTerms.membership.forward with hp
    rw ← pEq
    exact ⟨k0, ennAdd(ennMul(ennInfOn(f, k0), μ(k0)), ennMul(ennInfOn(g, k0), μ(k0))), rfl⟩
  have functional : ∀ a, ∀ b, ∀ c, (a, b) ∈ lintSumTerms(μ, f, g, P) → (a, c) ∈ lintSumTerms(μ, f, g, P) → b = c
    intros a b c hb hc
    obtain ⟨k0, hk, bEq⟩ := lintSumTerms.membership.forward with hb
    obtain ⟨m0, hm, cEq⟩ := lintSumTerms.membership.forward with hc
    obtain ⟨ka, bb⟩ := orderedPair.injective with bEq
    obtain ⟨ma, cc⟩ := orderedPair.injective with cEq
    rw [← bb, ← cc, ka, ← ma]
  exact pairGraph.apply with pairs, functional, edge

theorem ennAddOn.lint_apply (f g A x : Set)
  requires member : x ∈ A
  shows ennAddOn(f, g, A)(x) = ennAdd(f(x), g(x))
proof
  have edge : (x, ennAdd(f(x), g(x))) ∈ ennAddOn(f, g, A)
    apply ennAddOn.membership.backward
    exact ⟨x, member, rfl⟩
  have pairs : ∀ p ∈ ennAddOn(f, g, A), ∃ a, ∃ b, p = (a, b)
    intros p hp
    obtain ⟨k0, hk, pEq⟩ := ennAddOn.membership.forward with hp
    rw ← pEq
    exact ⟨k0, ennAdd(f(k0), g(k0)), rfl⟩
  have functional : ∀ a, ∀ b, ∀ c, (a, b) ∈ ennAddOn(f, g, A) → (a, c) ∈ ennAddOn(f, g, A) → b = c
    intros a b c hb hc
    obtain ⟨k0, hk, bEq⟩ := ennAddOn.membership.forward with hb
    obtain ⟨m0, hm, cEq⟩ := ennAddOn.membership.forward with hc
    obtain ⟨ka, bb⟩ := orderedPair.injective with bEq
    obtain ⟨ma, cc⟩ := orderedPair.injective with cEq
    rw [← bb, ← cc, ka, ← ma]
  exact pairGraph.apply with pairs, functional, edge

theorem ennFiniteSum.lint_add (f g h F : Set)
  requires finite : Finite(F)
  requires valuesF : ∀ i ∈ F, f(i) ∈ ennreal
  requires valuesG : ∀ i ∈ F, g(i) ∈ ennreal
  requires sum : ∀ i ∈ F, h(i) = ennAdd(f(i), g(i))
  shows ennFiniteSum(h, F) = ennAdd(ennFiniteSum(f, F), ennFiniteSum(g, F))
proof
  have hv : ∀ i ∈ F, h(i) ∈ ennreal
    intros i hi
    rw sum with i, hi
    exact ennAdd.member with (valuesF with i, hi), (valuesG with i, hi)
  have t := ennTsum.add with valuesF, valuesG, sum
  rw ennTsum.finite with finite, hv at t
  rw ennTsum.finite with finite, valuesF at t
  rw ennTsum.finite with finite, valuesG at t
  exact t

theorem lowerSum.lint_member (X μ f P : Set)
  requires measure : Measure(X, μ)
  requires partition : MeasurablePartition(X, P)
  requires values : ∀ x ∈ MeasurableSpace.carrier(X), f(x) ∈ ennreal
  shows lowerSum(μ, f, P) ∈ ennreal ∧ (∀ E ∈ P, partitionTerms(μ, f, P)(E) ∈ ennreal)
proof
  have space := Measure.space with measure
  have p2 := partition
  obtain ⟨fin, sub, cover, disj⟩ := p2
  have tm : ∀ E ∈ P, partitionTerms(μ, f, P)(E) ∈ ennreal
    intros E hE
    rw partitionTerms.apply with hE
    have pe := MeasurablePartition.pieces with space, partition, hE
    have vE : ∀ y ∈ E, f(y) ∈ ennreal
      intros y hy
      exact values with y, (pe.right with y, hy)
    exact ennMul.member with (ennInfOn.member with vE), (Measure.member with measure, pe.left)
  have s : lowerSum(μ, f, P) ∈ ennreal
    unfold lowerSum
    exact ennFiniteSum.member with fin, tm
  exact ⟨s, tm⟩

theorem lowerSum.lint_add (X μ f g P : Set)
  requires measure : Measure(X, μ)
  requires partition : MeasurablePartition(X, P)
  requires valuesF : ∀ x ∈ MeasurableSpace.carrier(X), f(x) ∈ ennreal
  requires valuesG : ∀ x ∈ MeasurableSpace.carrier(X), g(x) ∈ ennreal
  shows ennFiniteSum(lintSumTerms(μ, f, g, P), P) = ennAdd(lowerSum(μ, f, P), lowerSum(μ, g, P))
proof
  have p2 := partition
  obtain ⟨fin, sub, cover, disj⟩ := p2
  obtain ⟨sf, tf⟩ := lowerSum.lint_member with measure, partition, valuesF
  obtain ⟨sg, tg⟩ := lowerSum.lint_member with measure, partition, valuesG
  unfold lowerSum
  apply ennFiniteSum.lint_add with fin, tf, tg
  intros E hE
  rw lintSumTerms.apply with hE
  rw partitionTerms.apply with hE

-- If θ_k · c ≤ V for every k then c ≤ V.
theorem lintRatio.lint_limit (c V : Set)
  requires member : c ∈ ennreal
  requires memberV : V ∈ ennreal
  requires bound : ∀ k ∈ ℕ, EnnLe(ennMul(lintRatio(k), c), V)
  shows EnnLe(c, V)
proof
  have av : ∀ k ∈ ℕ, lintApproxSeq(c)(k) = lintApprox(c, k)
    intros k hk
    exact lintApproxSeq.apply with hk
  have asup := lintApprox.sup with member, av
  have avv : ∀ k ∈ ℕ, lintApproxSeq(c)(k) ∈ ennreal
    intros k hk
    rw av with k, hk
    have f1 := lintApprox.facts with member, hk
    exact f1.left
  obtain ⟨sM, ub, lst⟩ := ennSupOn.lint_bounds with avv
  have le : EnnLe(ennSupOn(lintApproxSeq(c), ℕ), V)
    apply lst with memberV
    intros k hk
    rw av with k, hk
    have f1 := lintApprox.facts with member, hk
    by_cases ct : c = ennTop
    . have oneR : realOne ∈ ℝ by typecheck
      have onePos : realZero < realOne by linarith
      obtain ⟨n, hn, near⟩ := lintRatio.near with oneR, onePos
      obtain ⟨rR, r0, r1, rM⟩ := lintRatio.facts with hn
      have rReal : Real(lintRatio(n)) by exact rR
      have rnz : lintRatio(n) ≠ realZero
        intro e
        rw e at near
        linarith
      have b := bound with n, hn
      rw ennMul.top_right with rnz, ct at b
      have Vt := EnnLe.top_eq with b
      rw Vt
      exact EnnLe.top with f1.left
    . obtain ⟨rR, r0, r1, rM⟩ := lintRatio.facts with hk
      rw lintApprox.finite with member, ct, hk
      have b := bound with k, hk
      rw ennMul.comm with rM, member at b
      exact b
  exact EnnLe.transitive with asup, le

-- One step of subadditivity: θ_k · (lower sum of f + g over R) ≤ ∫ f + ∫ g,
-- by cutting each piece of R into bands of f.
theorem lintegral.lint_add_step (X μ f g h W k : Set)
  requires measure : Measure(X, μ)
  requires measurable : Measurable(f, X, ennMeasurableSpace)
  requires values : EnnValued(X, g)
  requires sum : ∀ x ∈ MeasurableSpace.carrier(X), h(x) = ennAdd(f(x), g(x))
  requires partition : MeasurablePartition(X, W)
  requires hk : k ∈ ℕ
  shows EnnLe(ennMul(lintRatio(k), lowerSum(μ, h, W)),
    ennAdd(lintegral(X, μ, f), lintegral(X, μ, g)))
proof
  have space := Measure.space with measure
  have kN := nat.omega.backward with hk
  have p2 := partition
  obtain ⟨fin, sub, cover, disj⟩ := p2
  have vF : ∀ x ∈ MeasurableSpace.carrier(X), f(x) ∈ ennreal
    intros x hx
    have m := Measurable.maps with measurable, hx
    rw ennMeasurableSpace.carrier at m
    exact m
  have vG : ∀ x ∈ MeasurableSpace.carrier(X), g(x) ∈ ennreal
    unfold EnnValued at values
    unfold MapsInto at values
    exact values
  have vH : ∀ x ∈ MeasurableSpace.carrier(X), h(x) ∈ ennreal
    intros x hx
    rw sum with x, hx
    exact ennAdd.member with (vF with x, hx), (vG with x, hx)
  have aM : ∀ D ∈ W, ennInfOn(h, D) ∈ ennreal
    intros D hD
    have pd := MeasurablePartition.pieces with space, partition, hD
    have vD : ∀ x ∈ D, h(x) ∈ ennreal
      intros x hx
      exact vH with x, (pd.right with x, hx)
    exact ennInfOn.member with vD
  obtain ⟨θR, θ0, θ1, θM⟩ := lintRatio.facts with hk
  have sk : succ(k) ∈ ℕ by typecheck
  have skNat := nat.omega.backward with sk
  have finK := Finite.natural at succ(k)
  have bandsOf : ∀ D ∈ W, ∀ E ∈ lintBandRows(f, h, k, W)(D), ∃ j ∈ succ(k), E = lintBand(f, D, ennInfOn(h, D), k, j)
    intros D hD E hE
    rw lintBandRows.apply with hD at hE
    obtain ⟨j, hj, e⟩ := valuesOn.membership.forward with hE
    rw lintBandFam.apply with hj at e
    have e2 : E = lintBand(f, D, ennInfOn(h, D), k, j)
      rw ← e
    exact ⟨j, hj, e2⟩
  have rowFin : ∀ D ∈ W, Finite(lintBandRows(f, h, k, W)(D))
    intros D hD
    rw lintBandRows.apply with hD
    exact valuesOn.lint_finite at lintBandFam(f, h, D, k), succ(k) with finK
  have rowPieces : ∀ D ∈ W, ∀ E ∈ lintBandRows(f, h, k, W)(D), MeasurableSet(X, E) ∧ E ⊆ D
    intros D hD E hE
    obtain ⟨j, hj, e⟩ := bandsOf with D, hD, E, hE
    rw e
    have jN : j ∈ ℕ := natural.member at succ(k), j with hj
    have pd := MeasurablePartition.pieces with space, partition, hD
    exact lintBand.measurable with measurable, pd.left, (aM with D, hD), hk, jN
  have rowCover : ∀ D ∈ W, ∀ x ∈ D, ∃ E ∈ lintBandRows(f, h, k, W)(D), x ∈ E
    intros D hD x hx
    have pd := MeasurablePartition.pieces with space, partition, hD
    have fx := vF with x, (pd.right with x, hx)
    obtain ⟨j, hj, xb⟩ := lintBand.cover with hk, (aM with D, hD), hx, fx
    rw lintBandRows.apply with hD
    have inV : lintBandFam(f, h, D, k)(j) ∈ valuesOn(lintBandFam(f, h, D, k), succ(k)) := valuesOn.membership.backward with ⟨j, hj, rfl⟩
    rw lintBandFam.apply with hj at inV
    exact ⟨lintBand(f, D, ennInfOn(h, D), k, j), inV, xb⟩
  have rowDisj : ∀ D ∈ W, ∀ E ∈ lintBandRows(f, h, k, W)(D), ∀ E2 ∈ lintBandRows(f, h, k, W)(D), E ≠ E2 → Disjoint(E, E2)
    intros D hD E hE E2 hE2 ne
    obtain ⟨i, hi, ei⟩ := bandsOf with D, hD, E, hE
    obtain ⟨j, hj, ej⟩ := bandsOf with D, hD, E2, hE2
    apply Disjoint.iff.backward
    intros x xE xE2
    rw ei at xE
    rw ej at xE2
    have u := lintBand.unique with hk, (aM with D, hD), hi, hj, xE, xE2
    apply ne
    rw [ei, ej, u]
  have refined := MeasurablePartition.lint_refine with partition, rowFin, rowPieces, rowCover, rowDisj
  have inP : ∀ E ∈ ⋃(valuesOn(lintBandRows(f, h, k, W), W)), ∃ D ∈ W, ∃ j ∈ succ(k), E = lintBand(f, D, ennInfOn(h, D), k, j)
    intros E hE
    obtain ⟨S, SIn, ES⟩ := union.membership.forward with hE
    obtain ⟨D, hD, e⟩ := valuesOn.membership.forward with SIn
    rw ← e at ES
    obtain ⟨j, hj, e2⟩ := bandsOf with D, hD, E, ES
    exact ⟨D, hD, j, hj, e2⟩
  have inD : ∀ E ∈ ⋃(valuesOn(lintBandRows(f, h, k, W), W)), ∃ D ∈ W, E ⊆ D
    intros E hE
    obtain ⟨S, SIn, ES⟩ := union.membership.forward with hE
    obtain ⟨D, hD, e⟩ := valuesOn.membership.forward with SIn
    rw ← e at ES
    have pc := rowPieces with D, hD, E, ES
    exact ⟨D, hD, pc.right⟩
  have psiOn : ∀ D ∈ W, ∀ x ∈ D, lintStepOn(W, lintScaledInfs(h, W, lintRatio(k)), MeasurableSpace.carrier(X))(x) = ennMul(ennInfOn(h, D), lintRatio(k))
    intros D hD x hx
    have pd := MeasurablePartition.pieces with space, partition, hD
    rw lintStepOn.on_piece with partition, hD, hx, (pd.right with x, hx)
    exact lintScaledInfs.apply with hD
  have cM : ∀ D ∈ W, lintScaledInfs(h, W, lintRatio(k))(D) ∈ ennreal
    intros D hD
    rw lintScaledInfs.apply with hD
    exact ennMul.member with (aM with D, hD), θM
  have constW : ∀ D ∈ W, ∀ x ∈ D, lintStepOn(W, lintScaledInfs(h, W, lintRatio(k)), MeasurableSpace.carrier(X))(x) = lintScaledInfs(h, W, lintRatio(k))(D)
    intros D hD x hx
    rw psiOn with D, hD, x, hx
    rw lintScaledInfs.apply with hD
  have int1 := lintegral.simple with measure, partition, cM, constW
  have left : ennFiniteSum(simpleTerms(μ, lintScaledInfs(h, W, lintRatio(k)), W), W) = ennMul(lintRatio(k), lowerSum(μ, h, W))
    obtain ⟨sh, th⟩ := lowerSum.lint_member with measure, partition, vH
    unfold lowerSum
    apply ennFiniteSum.mul_left with fin, th, θM
    intros D hD
    rw simpleTerms.apply with hD
    rw lintScaledInfs.apply with hD
    rw partitionTerms.apply with hD
    have aD := aM with D, hD
    have pd := MeasurablePartition.pieces with space, partition, hD
    have muD := Measure.member with measure, pd.left
    rw ennMul.comm with aD, θM
    exact ennMul.assoc with θM, aD, muD
  have psiM : ∀ D ∈ W, ∀ x ∈ D, lintStepOn(W, lintScaledInfs(h, W, lintRatio(k)), MeasurableSpace.carrier(X))(x) ∈ ennreal
    intros D hD x hx
    rw psiOn with D, hD, x, hx
    exact ennMul.member with (aM with D, hD), θM
  have psiE : ∀ E ∈ ⋃(valuesOn(lintBandRows(f, h, k, W), W)), ∀ y ∈ E, lintStepOn(W, lintScaledInfs(h, W, lintRatio(k)), MeasurableSpace.carrier(X))(y) ∈ ennreal
    intros E hE y hy
    obtain ⟨D, hD, ED⟩ := inD with E, hE
    exact psiM with D, hD, y, (ED with y, hy)
  have constP : ∀ E ∈ ⋃(valuesOn(lintBandRows(f, h, k, W), W)), ∀ x ∈ E, lintStepOn(W, lintScaledInfs(h, W, lintRatio(k)), MeasurableSpace.carrier(X))(x) = lintInfs(lintStepOn(W, lintScaledInfs(h, W, lintRatio(k)), MeasurableSpace.carrier(X)), ⋃(valuesOn(lintBandRows(f, h, k, W), W)))(E)
    intros E hE x hx
    obtain ⟨D, hD, ED⟩ := inD with E, hE
    rw lintInfs.apply with hE
    have val := ennMul.member with (aM with D, hD), θM
    have cst : ∀ y ∈ E, lintStepOn(W, lintScaledInfs(h, W, lintRatio(k)), MeasurableSpace.carrier(X))(y) = ennMul(ennInfOn(h, D), lintRatio(k))
      intros y hy
      exact psiOn with D, hD, y, (ED with y, hy)
    rw ennInfOn.const with hx, val, cst
    exact psiOn with D, hD, x, (ED with x, hx)
  have cPM : ∀ E ∈ ⋃(valuesOn(lintBandRows(f, h, k, W), W)), lintInfs(lintStepOn(W, lintScaledInfs(h, W, lintRatio(k)), MeasurableSpace.carrier(X)), ⋃(valuesOn(lintBandRows(f, h, k, W), W)))(E) ∈ ennreal
    intros E hE
    rw lintInfs.apply with hE
    exact ennInfOn.member with (psiE with E, hE)
  have int2 := lintegral.simple with measure, refined, cPM, constP
  have r2 := refined
  obtain ⟨finP, subP, coverP, disjP⟩ := r2
  have stM : ∀ E ∈ ⋃(valuesOn(lintBandRows(f, h, k, W), W)), simpleTerms(μ, lintInfs(lintStepOn(W, lintScaledInfs(h, W, lintRatio(k)), MeasurableSpace.carrier(X)), ⋃(valuesOn(lintBandRows(f, h, k, W), W))), ⋃(valuesOn(lintBandRows(f, h, k, W), W)))(E) ∈ ennreal
    intros E hE
    rw simpleTerms.apply with hE
    have pE := MeasurablePartition.pieces with space, refined, hE
    exact ennMul.member with (cPM with E, hE), (Measure.member with measure, pE.left)
  have sumM : ∀ E ∈ ⋃(valuesOn(lintBandRows(f, h, k, W), W)), lintSumTerms(μ, f, g, ⋃(valuesOn(lintBandRows(f, h, k, W), W)))(E) ∈ ennreal
    intros E hE
    rw lintSumTerms.apply with hE
    have pE := MeasurablePartition.pieces with space, refined, hE
    have muE := Measure.member with measure, pE.left
    have vfE : ∀ y ∈ E, f(y) ∈ ennreal
      intros y hy
      exact vF with y, (pE.right with y, hy)
    have vgE : ∀ y ∈ E, g(y) ∈ ennreal
      intros y hy
      exact vG with y, (pE.right with y, hy)
    exact ennAdd.member with (ennMul.member with (ennInfOn.member with vfE), muE), (ennMul.member with (ennInfOn.member with vgE), muE)
  have term : ∀ E ∈ ⋃(valuesOn(lintBandRows(f, h, k, W), W)), EnnLe(simpleTerms(μ, lintInfs(lintStepOn(W, lintScaledInfs(h, W, lintRatio(k)), MeasurableSpace.carrier(X)), ⋃(valuesOn(lintBandRows(f, h, k, W), W))), ⋃(valuesOn(lintBandRows(f, h, k, W), W)))(E), lintSumTerms(μ, f, g, ⋃(valuesOn(lintBandRows(f, h, k, W), W)))(E))
    intros E hE
    have sM := sumM with E, hE
    rw simpleTerms.apply with hE
    rw lintSumTerms.apply with hE
    rw lintSumTerms.apply with hE at sM
    rw lintInfs.apply with hE
    have pE := MeasurablePartition.pieces with space, refined, hE
    have muE := Measure.member with measure, pE.left
    have vfE : ∀ y ∈ E, f(y) ∈ ennreal
      intros y hy
      exact vF with y, (pE.right with y, hy)
    have vgE : ∀ y ∈ E, g(y) ∈ ennreal
      intros y hy
      exact vG with y, (pE.right with y, hy)
    have ifM := ennInfOn.member with vfE
    have igM := ennInfOn.member with vgE
    have ipM := ennInfOn.member with (psiE with E, hE)
    by_cases ne : ∃ x, x ∈ E
    . obtain ⟨x0, x0E⟩ := ne
      obtain ⟨D, hD, j, hj, e⟩ := inP with E, hE
      obtain ⟨D2, hD2, ED⟩ := inD with E, hE
      have pdE : E ⊆ D
        rw e
        intros y hy
        unfold lintBand at hy
        simp at hy
        exact hy.left
      have aD := aM with D, hD
      have pD := MeasurablePartition.pieces with space, partition, hD
      have vHD : ∀ z ∈ D, h(z) ∈ ennreal
        intros z hz
        exact vH with z, (pD.right with z, hz)
      have jN : j ∈ ℕ := natural.member at succ(k), j with hj
      obtain ⟨lR, l0, rR, s1, s2, sR, z⟩ := lintLev.facts with hk, jN
      obtain ⟨r0, rk⟩ := lintRest.facts with hk, hj
      have levM := ennreal.of_real with lR, l0
      have restM := ennreal.of_real with rR, r0
      have lM := ennMul.member with aD, levM
      have rM := ennMul.member with aD, restM
      have boundsE : ∀ y ∈ E, EnnLe(ennMul(ennInfOn(h, D), lintLev(k, j)), f(y)) ∧ EnnLe(ennMul(ennInfOn(h, D), lintRest(k, j)), g(y))
        intros y hy
        have yX := pE.right with y, hy
        have below : EnnLe(ennInfOn(h, D), ennAdd(f(y), g(y)))
          rw ← sum with y, yX
          exact ennInfOn.le_value with vHD, (pdE with y, hy)
        have yb : y ∈ lintBand(f, D, ennInfOn(h, D), k, j)
          rw ← e
          exact hy
        exact lintBand.bounds with hk, hj, aD, (vF with y, yX), (vG with y, yX), below, yb
      have lf : EnnLe(ennMul(ennInfOn(h, D), lintLev(k, j)), ennInfOn(f, E))
        apply ennInfOn.ge with vfE, lM
        intros y hy
        have b := boundsE with y, hy
        exact b.left
      have lg : EnnLe(ennMul(ennInfOn(h, D), lintRest(k, j)), ennInfOn(g, E))
        apply ennInfOn.ge with vgE, rM
        intros y hy
        have b := boundsE with y, hy
        exact b.right
      have cst : ∀ y ∈ E, lintStepOn(W, lintScaledInfs(h, W, lintRatio(k)), MeasurableSpace.carrier(X))(y) = ennMul(ennInfOn(h, D), lintRatio(k))
        intros y hy
        exact psiOn with D, hD, y, (pdE with y, hy)
      rw ennInfOn.const with x0E, (ennMul.member with aD, θM), cst
      have ad := ennAdd.finite with lR, rR, l0, r0
      rw s1 at ad
      have split : ennMul(ennInfOn(h, D), lintRatio(k)) = ennAdd(ennMul(ennInfOn(h, D), lintLev(k, j)), ennMul(ennInfOn(h, D), lintRest(k, j)))
        rw ← ad
        exact ennMul.add_right with aD, levM, restM
      rw split
      have le1 := ennAdd.mono with lf, lg
      have le2 := ennMul.mono with le1, (EnnLe.reflexive with muE)
      have dist : ennMul(ennAdd(ennInfOn(f, E), ennInfOn(g, E)), μ(E)) = ennAdd(ennMul(ennInfOn(f, E), μ(E)), ennMul(ennInfOn(g, E), μ(E)))
        rw ennMul.comm with (ennAdd.member with ifM, igM), muE
        rw ennMul.add_right with muE, ifM, igM
        rw ennMul.comm with muE, ifM
        rw ennMul.comm with muE, igM
      rw ← dist
      exact le2
    . have Ee : E = ∅
        ext x
        constructor
        . intro hx
          exfalso
          exact ne with ⟨x, hx⟩
        . intro hx
          simp at hx
      have m0 : μ(E) = realZero
        rw Ee
        exact Measure.empty with measure
      rw ennMul.zero_right with ipM, m0
      exact EnnLe.zero with sM
  have mono := ennFiniteSum.mono_fun with finP, stM, sumM, term
  rw lowerSum.lint_add with measure, refined, vF, vG at mono
  obtain ⟨sf, tf⟩ := lowerSum.lint_member with measure, refined, vF
  obtain ⟨sg, tg⟩ := lowerSum.lint_member with measure, refined, vG
  have uf := lintegral.upper at X, μ, f, ⋃(valuesOn(lintBandRows(f, h, k, W), W)) with refined, sf
  have ug := lintegral.upper at X, μ, g, ⋃(valuesOn(lintBandRows(f, h, k, W), W)) with refined, sg
  have tot := EnnLe.transitive with mono, (ennAdd.mono with uf, ug)
  rw ← int2 at tot
  rw int1 at tot
  rw left at tot
  exact tot

theorem lintegral.lint_add_le (X μ f g h : Set)
  requires measure : Measure(X, μ)
  requires measurable : Measurable(f, X, ennMeasurableSpace)
  requires values : EnnValued(X, g)
  requires sum : ∀ x ∈ MeasurableSpace.carrier(X), h(x) = ennAdd(f(x), g(x))
  shows EnnLe(lintegral(X, μ, h), ennAdd(lintegral(X, μ, f), lintegral(X, μ, g)))
proof
  have vF : ∀ x ∈ MeasurableSpace.carrier(X), f(x) ∈ ennreal
    intros x hx
    have m := Measurable.maps with measurable, hx
    rw ennMeasurableSpace.carrier at m
    exact m
  have vG : ∀ x ∈ MeasurableSpace.carrier(X), g(x) ∈ ennreal
    unfold EnnValued at values
    unfold MapsInto at values
    exact values
  have vH : ∀ x ∈ MeasurableSpace.carrier(X), h(x) ∈ ennreal
    intros x hx
    rw sum with x, hx
    exact ennAdd.member with (vF with x, hx), (vG with x, hx)
  have V := ennAdd.member with (lintegral.member at X, μ, f with measure), (lintegral.member at X, μ, g with measure)
  apply lintegral.le_of_all with V
  intros W partition
  obtain ⟨sh, th⟩ := lowerSum.lint_member with measure, partition, vH
  apply lintRatio.lint_limit with sh, V
  intros k hk
  exact lintegral.lint_add_step with measure, measurable, values, sum, partition, hk

-- A step function over P has lower sum Σ w(A) μ(A) over any refinement W.
theorem lintStepOn.lint_lower (X μ P W w : Set)
  requires measure : Measure(X, μ)
  requires partitionP : MeasurablePartition(X, P)
  requires partitionW : MeasurablePartition(X, W)
  requires refine : ∀ E ∈ W, ∃ A ∈ P, E ⊆ A
  requires values : ∀ A ∈ P, w(A) ∈ ennreal
  shows lowerSum(μ, lintStepOn(P, w, MeasurableSpace.carrier(X)), W) =
    ennFiniteSum(simpleTerms(μ, w, P), P)
proof
  have space := Measure.space with measure
  have onA : ∀ A ∈ P, ∀ x ∈ A, lintStepOn(P, w, MeasurableSpace.carrier(X))(x) = w(A)
    intros A hA x hx
    have pa := MeasurablePartition.pieces with space, partitionP, hA
    exact lintStepOn.on_piece with partitionP, hA, hx, (pa.right with x, hx)
  have int1 := lintegral.simple with measure, partitionP, values, onA
  have vE : ∀ E ∈ W, ∀ y ∈ E, lintStepOn(P, w, MeasurableSpace.carrier(X))(y) ∈ ennreal
    intros E hE y hy
    obtain ⟨A, hA, EA⟩ := refine with E, hE
    rw onA with A, hA, y, (EA with y, hy)
    exact values with A, hA
  have cM : ∀ E ∈ W, lintInfs(lintStepOn(P, w, MeasurableSpace.carrier(X)), W)(E) ∈ ennreal
    intros E hE
    rw lintInfs.apply with hE
    exact ennInfOn.member with (vE with E, hE)
  have constW : ∀ E ∈ W, ∀ x ∈ E, lintStepOn(P, w, MeasurableSpace.carrier(X))(x) = lintInfs(lintStepOn(P, w, MeasurableSpace.carrier(X)), W)(E)
    intros E hE x hx
    obtain ⟨A, hA, EA⟩ := refine with E, hE
    rw lintInfs.apply with hE
    have cst : ∀ y ∈ E, lintStepOn(P, w, MeasurableSpace.carrier(X))(y) = w(A)
      intros y hy
      exact onA with A, hA, y, (EA with y, hy)
    rw ennInfOn.const with hx, (values with A, hA), cst
    exact onA with A, hA, x, (EA with x, hx)
  have int2 := lintegral.simple with measure, partitionW, cM, constW
  have same : lowerSum(μ, lintStepOn(P, w, MeasurableSpace.carrier(X)), W) = ennFiniteSum(simpleTerms(μ, lintInfs(lintStepOn(P, w, MeasurableSpace.carrier(X)), W), W), W)
    unfold lowerSum
    apply ennFiniteSum.congr
    intros E hE
    rw partitionTerms.apply with hE
    rw simpleTerms.apply with hE
    rw lintInfs.apply with hE
  rw same
  rw ← int2
  exact int1

-- Superadditivity on a pair of partitions, through their common refinement.
theorem lintegral.lint_pair_lower (X μ f g h P Q : Set)
  requires measure : Measure(X, μ)
  requires valuesF : ∀ x ∈ MeasurableSpace.carrier(X), f(x) ∈ ennreal
  requires valuesG : ∀ x ∈ MeasurableSpace.carrier(X), g(x) ∈ ennreal
  requires sum : ∀ x ∈ MeasurableSpace.carrier(X), h(x) = ennAdd(f(x), g(x))
  requires partitionP : MeasurablePartition(X, P)
  requires partitionQ : MeasurablePartition(X, Q)
  shows EnnLe(ennAdd(lowerSum(μ, f, P), lowerSum(μ, g, Q)), lintegral(X, μ, h))
proof
  have space := Measure.space with measure
  have pp := partitionP
  obtain ⟨finP, subP, coverP, disjP⟩ := pp
  have qq := partitionQ
  obtain ⟨finQ, subQ, coverQ, disjQ⟩ := qq
  have vH : ∀ x ∈ MeasurableSpace.carrier(X), h(x) ∈ ennreal
    intros x hx
    rw sum with x, hx
    exact ennAdd.member with (valuesF with x, hx), (valuesG with x, hx)
  have rowsOf : ∀ A ∈ P, ∀ E ∈ lintInterRows(P, Q)(A), ∃ B ∈ Q, E = B ∩ A
    intros A hA E hE
    rw lintInterRows.apply with hA at hE
    obtain ⟨B, hB, e⟩ := valuesOn.membership.forward with hE
    rw interWith.apply with hB at e
    have e2 : E = B ∩ A
      rw ← e
    exact ⟨B, hB, e2⟩
  have rowFin : ∀ A ∈ P, Finite(lintInterRows(P, Q)(A))
    intros A hA
    rw lintInterRows.apply with hA
    exact valuesOn.lint_finite at interWith(Q, A), Q with finQ
  have rowPieces : ∀ A ∈ P, ∀ E ∈ lintInterRows(P, Q)(A), MeasurableSet(X, E) ∧ E ⊆ A
    intros A hA E hE
    obtain ⟨B, hB, e⟩ := rowsOf with A, hA, E, hE
    rw e
    have pa := MeasurablePartition.pieces with space, partitionP, hA
    have pb := MeasurablePartition.pieces with space, partitionQ, hB
    have m := MeasurableSet.inter with space, pb.left, pa.left
    have s : B ∩ A ⊆ A
      intros x hx
      obtain ⟨xB, xA⟩ := intersection.membership.forward with hx
      exact xA
    exact ⟨m, s⟩
  have rowCover : ∀ A ∈ P, ∀ x ∈ A, ∃ E ∈ lintInterRows(P, Q)(A), x ∈ E
    intros A hA x hx
    have pa := MeasurablePartition.pieces with space, partitionP, hA
    have xX := pa.right with x, hx
    rw ← coverQ at xX
    obtain ⟨B, hB, xB⟩ := union.membership.forward with xX
    rw lintInterRows.apply with hA
    have inV : interWith(Q, A)(B) ∈ valuesOn(interWith(Q, A), Q) := valuesOn.membership.backward with ⟨B, hB, rfl⟩
    rw interWith.apply with hB at inV
    exact ⟨B ∩ A, inV, (intersection.membership.backward with xB, hx)⟩
  have rowDisj : ∀ A ∈ P, ∀ E ∈ lintInterRows(P, Q)(A), ∀ E2 ∈ lintInterRows(P, Q)(A), E ≠ E2 → Disjoint(E, E2)
    intros A hA E hE E2 hE2 ne
    obtain ⟨B, hB, e⟩ := rowsOf with A, hA, E, hE
    obtain ⟨B2, hB2, e2⟩ := rowsOf with A, hA, E2, hE2
    have nb : B ≠ B2
      intro bb
      apply ne
      rw [e, e2, bb]
    have d := disjQ with B, hB, B2, hB2, nb
    have d2 := Disjoint.iff.forward with d
    apply Disjoint.iff.backward
    intros x xE xE2
    rw e at xE
    rw e2 at xE2
    obtain ⟨xB, xA⟩ := intersection.membership.forward with xE
    obtain ⟨xB2, xA2⟩ := intersection.membership.forward with xE2
    exact d2 with x, xB, xB2
  have refined := MeasurablePartition.lint_refine with partitionP, rowFin, rowPieces, rowCover, rowDisj
  have inW : ∀ E ∈ ⋃(valuesOn(lintInterRows(P, Q), P)), ∃ A ∈ P, ∃ B ∈ Q, E = B ∩ A
    intros E hE
    obtain ⟨S, SIn, ES⟩ := union.membership.forward with hE
    obtain ⟨A, hA, e⟩ := valuesOn.membership.forward with SIn
    rw ← e at ES
    obtain ⟨B, hB, e2⟩ := rowsOf with A, hA, E, ES
    exact ⟨A, hA, B, hB, e2⟩
  have refineP : ∀ E ∈ ⋃(valuesOn(lintInterRows(P, Q), P)), ∃ A ∈ P, E ⊆ A
    intros E hE
    obtain ⟨A, hA, B, hB, e⟩ := inW with E, hE
    rw e
    have s : B ∩ A ⊆ A
      intros x hx
      obtain ⟨xB, xA⟩ := intersection.membership.forward with hx
      exact xA
    exact ⟨A, hA, s⟩
  have refineQ : ∀ E ∈ ⋃(valuesOn(lintInterRows(P, Q), P)), ∃ B ∈ Q, E ⊆ B
    intros E hE
    obtain ⟨A, hA, B, hB, e⟩ := inW with E, hE
    rw e
    have s : B ∩ A ⊆ B
      intros x hx
      obtain ⟨xB, xA⟩ := intersection.membership.forward with hx
      exact xB
    exact ⟨B, hB, s⟩
  have infF : ∀ A ∈ P, ennInfOn(f, A) ∈ ennreal ∧ (∀ y ∈ A, EnnLe(ennInfOn(f, A), f(y)))
    intros A hA
    have pa := MeasurablePartition.pieces with space, partitionP, hA
    have vA : ∀ y ∈ A, f(y) ∈ ennreal
      intros y hy
      exact valuesF with y, (pa.right with y, hy)
    have lv : ∀ y ∈ A, EnnLe(ennInfOn(f, A), f(y))
      intros y hy
      exact ennInfOn.le_value with vA, hy
    exact ⟨(ennInfOn.member with vA), lv⟩
  have infG : ∀ B ∈ Q, ennInfOn(g, B) ∈ ennreal ∧ (∀ y ∈ B, EnnLe(ennInfOn(g, B), g(y)))
    intros B hB
    have pb := MeasurablePartition.pieces with space, partitionQ, hB
    have vB : ∀ y ∈ B, g(y) ∈ ennreal
      intros y hy
      exact valuesG with y, (pb.right with y, hy)
    have lv : ∀ y ∈ B, EnnLe(ennInfOn(g, B), g(y))
      intros y hy
      exact ennInfOn.le_value with vB, hy
    exact ⟨(ennInfOn.member with vB), lv⟩
  have wf : ∀ A ∈ P, lintInfs(f, P)(A) ∈ ennreal
    intros A hA
    rw lintInfs.apply with hA
    have i := infF with A, hA
    exact i.left
  have wg : ∀ B ∈ Q, lintInfs(g, Q)(B) ∈ ennreal
    intros B hB
    rw lintInfs.apply with hB
    have i := infG with B, hB
    exact i.left
  have lsf := lintStepOn.lint_lower with measure, partitionP, refined, refineP, wf
  have lsg := lintStepOn.lint_lower with measure, partitionQ, refined, refineQ, wg
  have eqf : ennFiniteSum(simpleTerms(μ, lintInfs(f, P), P), P) = lowerSum(μ, f, P)
    unfold lowerSum
    apply ennFiniteSum.congr
    intros A hA
    rw simpleTerms.apply with hA
    rw partitionTerms.apply with hA
    rw lintInfs.apply with hA
  have eqg : ennFiniteSum(simpleTerms(μ, lintInfs(g, Q), Q), Q) = lowerSum(μ, g, Q)
    unfold lowerSum
    apply ennFiniteSum.congr
    intros B hB
    rw simpleTerms.apply with hB
    rw partitionTerms.apply with hB
    rw lintInfs.apply with hB
  rw eqf at lsf
  rw eqg at lsg
  have onA : ∀ A ∈ P, ∀ x ∈ A, lintStepOn(P, lintInfs(f, P), MeasurableSpace.carrier(X))(x) = ennInfOn(f, A)
    intros A hA x hx
    have pa := MeasurablePartition.pieces with space, partitionP, hA
    rw lintStepOn.on_piece with partitionP, hA, hx, (pa.right with x, hx)
    exact lintInfs.apply with hA
  have onB : ∀ B ∈ Q, ∀ x ∈ B, lintStepOn(Q, lintInfs(g, Q), MeasurableSpace.carrier(X))(x) = ennInfOn(g, B)
    intros B hB x hx
    have pb := MeasurablePartition.pieces with space, partitionQ, hB
    rw lintStepOn.on_piece with partitionQ, hB, hx, (pb.right with x, hx)
    exact lintInfs.apply with hB
  have v1 : ∀ x ∈ MeasurableSpace.carrier(X), lintStepOn(P, lintInfs(f, P), MeasurableSpace.carrier(X))(x) ∈ ennreal
    intros x hx
    rw ← coverP at hx
    obtain ⟨A, hA, xA⟩ := union.membership.forward with hx
    rw onA with A, hA, x, xA
    have i := infF with A, hA
    exact i.left
  have v2 : ∀ x ∈ MeasurableSpace.carrier(X), lintStepOn(Q, lintInfs(g, Q), MeasurableSpace.carrier(X))(x) ∈ ennreal
    intros x hx
    rw ← coverQ at hx
    obtain ⟨B, hB, xB⟩ := union.membership.forward with hx
    rw onB with B, hB, x, xB
    have i := infG with B, hB
    exact i.left
  have add := lowerSum.lint_add with measure, refined, v1, v2
  rw [lsf, lsg] at add
  have r2 := refined
  obtain ⟨finW, subW, coverW, disjW⟩ := r2
  obtain ⟨sh, th⟩ := lowerSum.lint_member with measure, refined, vH
  have sumM : ∀ E ∈ ⋃(valuesOn(lintInterRows(P, Q), P)), lintSumTerms(μ, lintStepOn(P, lintInfs(f, P), MeasurableSpace.carrier(X)), lintStepOn(Q, lintInfs(g, Q), MeasurableSpace.carrier(X)), ⋃(valuesOn(lintInterRows(P, Q), P)))(E) ∈ ennreal
    intros E hE
    rw lintSumTerms.apply with hE
    have pE := MeasurablePartition.pieces with space, refined, hE
    have muE := Measure.member with measure, pE.left
    have a1 : ∀ y ∈ E, lintStepOn(P, lintInfs(f, P), MeasurableSpace.carrier(X))(y) ∈ ennreal
      intros y hy
      exact v1 with y, (pE.right with y, hy)
    have a2 : ∀ y ∈ E, lintStepOn(Q, lintInfs(g, Q), MeasurableSpace.carrier(X))(y) ∈ ennreal
      intros y hy
      exact v2 with y, (pE.right with y, hy)
    exact ennAdd.member with (ennMul.member with (ennInfOn.member with a1), muE), (ennMul.member with (ennInfOn.member with a2), muE)
  have term : ∀ E ∈ ⋃(valuesOn(lintInterRows(P, Q), P)), EnnLe(lintSumTerms(μ, lintStepOn(P, lintInfs(f, P), MeasurableSpace.carrier(X)), lintStepOn(Q, lintInfs(g, Q), MeasurableSpace.carrier(X)), ⋃(valuesOn(lintInterRows(P, Q), P)))(E), partitionTerms(μ, h, ⋃(valuesOn(lintInterRows(P, Q), P)))(E))
    intros E hE
    have tE := th with E, hE
    rw lintSumTerms.apply with hE
    rw partitionTerms.apply with hE
    rw partitionTerms.apply with hE at tE
    have pE := MeasurablePartition.pieces with space, refined, hE
    have muE := Measure.member with measure, pE.left
    have a1 : ∀ y ∈ E, lintStepOn(P, lintInfs(f, P), MeasurableSpace.carrier(X))(y) ∈ ennreal
      intros y hy
      exact v1 with y, (pE.right with y, hy)
    have a2 : ∀ y ∈ E, lintStepOn(Q, lintInfs(g, Q), MeasurableSpace.carrier(X))(y) ∈ ennreal
      intros y hy
      exact v2 with y, (pE.right with y, hy)
    have hE2 : ∀ y ∈ E, h(y) ∈ ennreal
      intros y hy
      exact vH with y, (pE.right with y, hy)
    have i1 := ennInfOn.member with a1
    have i2 := ennInfOn.member with a2
    by_cases ne : ∃ x, x ∈ E
    . obtain ⟨x0, x0E⟩ := ne
      obtain ⟨A, hA, B, hB, e⟩ := inW with E, hE
      have EA : E ⊆ A
        intros y hy
        rw e at hy
        obtain ⟨yB, yA⟩ := intersection.membership.forward with hy
        exact yA
      have EB : E ⊆ B
        intros y hy
        rw e at hy
        obtain ⟨yB, yA⟩ := intersection.membership.forward with hy
        exact yB
      obtain ⟨fA, fAle⟩ := infF with A, hA
      obtain ⟨gB, gBle⟩ := infG with B, hB
      have c1 : ∀ y ∈ E, lintStepOn(P, lintInfs(f, P), MeasurableSpace.carrier(X))(y) = ennInfOn(f, A)
        intros y hy
        exact onA with A, hA, y, (EA with y, hy)
      have c2 : ∀ y ∈ E, lintStepOn(Q, lintInfs(g, Q), MeasurableSpace.carrier(X))(y) = ennInfOn(g, B)
        intros y hy
        exact onB with B, hB, y, (EB with y, hy)
      rw ennInfOn.const with x0E, fA, c1
      rw ennInfOn.const with x0E, gB, c2
      have le : EnnLe(ennAdd(ennInfOn(f, A), ennInfOn(g, B)), ennInfOn(h, E))
        apply ennInfOn.ge with hE2, (ennAdd.member with fA, gB)
        intros y hy
        have yX := pE.right with y, hy
        rw sum with y, yX
        exact ennAdd.mono with (fAle with y, (EA with y, hy)), (gBle with y, (EB with y, hy))
      have le2 := ennMul.mono with le, (EnnLe.reflexive with muE)
      have dist : ennMul(ennAdd(ennInfOn(f, A), ennInfOn(g, B)), μ(E)) = ennAdd(ennMul(ennInfOn(f, A), μ(E)), ennMul(ennInfOn(g, B), μ(E)))
        rw ennMul.comm with (ennAdd.member with fA, gB), muE
        rw ennMul.add_right with muE, fA, gB
        rw ennMul.comm with muE, fA
        rw ennMul.comm with muE, gB
      rw ← dist
      exact le2
    . have Ee : E = ∅
        ext x
        constructor
        . intro hx
          exfalso
          exact ne with ⟨x, hx⟩
        . intro hx
          simp at hx
      have m0 : μ(E) = realZero
        rw Ee
        exact Measure.empty with measure
      rw ennMul.zero_right with i1, m0
      rw ennMul.zero_right with i2, m0
      rw ennAdd.zero with ennreal.zero_member
      exact EnnLe.zero with tE
  have mono := ennFiniteSum.mono_fun with finW, sumM, th, term
  rw add at mono
  have up := lintegral.upper at X, μ, h, ⋃(valuesOn(lintInterRows(P, Q), P)) with refined, sh
  unfold lowerSum at up
  exact EnnLe.transitive with mono, up

-- sup S + sup T ≤ v when every s + t is, for nonempty S and T.
theorem ennAdd.lint_sup_le (S T v : Set)
  requires insideS : S ⊆ ennreal
  requires insideT : T ⊆ ennreal
  requires member : v ∈ ennreal
  requires nonemptyS : ∃ s, s ∈ S
  requires nonemptyT : ∃ t, t ∈ T
  requires bound : ∀ s ∈ S, ∀ t ∈ T, EnnLe(ennAdd(s, t), v)
  shows EnnLe(ennAdd(ennSup(S), ennSup(T)), v)
proof
  obtain ⟨ubS, lstS⟩ := ennSup.least_upper with insideS
  obtain ⟨ubT, lstT⟩ := ennSup.least_upper with insideT
  obtain ⟨sSM, sSb⟩ := ubS
  obtain ⟨sTM, sTb⟩ := ubT
  by_cases vt : v = ennTop
  . rw vt
    exact EnnLe.top with (ennAdd.member with sSM, sTM)
  . obtain ⟨vR, v0⟩ := ennreal.finite with member, vt
    have vReal : Real(v) by exact vR
    obtain ⟨s0, s0S⟩ := nonemptyS
    obtain ⟨t0, t0T⟩ := nonemptyT
    have tFin : ∀ t ∈ T, t ∈ ℝ ∧ realZero ≤ t
      intros t ht
      have b := bound with s0, s0S, t, ht
      have tm := insideT with t, ht
      have sm := insideS with s0, s0S
      rw ennAdd.comm with sm, tm at b
      have l := EnnLe.transitive with (EnnLe.self_add with tm, sm), b
      obtain ⟨a1, a2, a3, a4, a5⟩ := EnnLe.lint_to_real with l, vt
      exact ⟨a2, a5⟩
    have sFin : ∀ s ∈ S, s ∈ ℝ ∧ realZero ≤ s
      intros s hs
      have b := bound with s, hs, t0, t0T
      have tm := insideT with t0, t0T
      have sm := insideS with s, hs
      have l := EnnLe.transitive with (EnnLe.self_add with sm, tm), b
      obtain ⟨a1, a2, a3, a4, a5⟩ := EnnLe.lint_to_real with l, vt
      exact ⟨a2, a5⟩
    have step : ∀ t ∈ T, EnnLe(ennSup(S), R[v - t]) ∧ R[v - t] ∈ ℝ
      intros t ht
      obtain ⟨tR, tN⟩ := tFin with t, ht
      have tReal : Real(t) by exact tR
      have dR : R[v - t] ∈ ℝ by typecheck
      have sm0 := insideS with s0, s0S
      have b0 := bound with s0, s0S, t, ht
      obtain ⟨s0R, s0N⟩ := sFin with s0, s0S
      have s0Real : Real(s0) by exact s0R
      rw ennAdd.finite with s0R, tR, s0N, tN at b0
      obtain ⟨c1, c2, c3, c4, c5⟩ := EnnLe.lint_to_real with b0, vt
      have d0 : realZero ≤ R[v - t] by linarith
      have dM := ennreal.of_real with dR, d0
      have le : EnnLe(ennSup(S), R[v - t])
        apply lstS
        unfold EnnUpperBound
        refine ⟨dM, ?_⟩
        intros s hs
        obtain ⟨sR, sN⟩ := sFin with s, hs
        have sReal : Real(s) by exact sR
        have b := bound with s, hs, t, ht
        rw ennAdd.finite with sR, tR, sN, tN at b
        obtain ⟨b1, b2, b3, b4, b5⟩ := EnnLe.lint_to_real with b, vt
        have le2 : (s:R) ≤ (R[v - t]:R) by linarith
        exact EnnLe.lint_of_real with sR, dR, sN, le2
      exact ⟨le, dR⟩
    obtain ⟨st0, d0R⟩ := step with t0, t0T
    obtain ⟨u1, aR, u3, u4, a0⟩ := EnnLe.lint_to_real with st0, (ennreal.not_top_of_real with d0R)
    have aReal : Real(ennSup(S)) by exact aR
    obtain ⟨t0R, t0N⟩ := tFin with t0, t0T
    have t0Real : Real(t0) by exact t0R
    have eR : R[v - ennSup(S)] ∈ ℝ by typecheck
    have e0 : realZero ≤ R[v - ennSup(S)] by linarith
    have eM := ennreal.of_real with eR, e0
    have stepT : EnnLe(ennSup(T), R[v - ennSup(S)])
      apply lstT
      unfold EnnUpperBound
      refine ⟨eM, ?_⟩
      intros t ht
      obtain ⟨tR, tN⟩ := tFin with t, ht
      have tReal : Real(t) by exact tR
      obtain ⟨st, dR⟩ := step with t, ht
      obtain ⟨w1, w2, w3, w4, w5⟩ := EnnLe.lint_to_real with st, (ennreal.not_top_of_real with dR)
      have le2 : (t:R) ≤ (R[v - ennSup(S)]:R) by linarith
      exact EnnLe.lint_of_real with tR, eR, tN, le2
    obtain ⟨y1, bR, y3, y4, b0⟩ := EnnLe.lint_to_real with stepT, (ennreal.not_top_of_real with eR)
    have bReal : Real(ennSup(T)) by exact bR
    rw ennAdd.finite with aR, bR, a0, b0
    have sumR : R[ennSup(S) + ennSup(T)] ∈ ℝ by typecheck
    have sum0 : realZero ≤ R[ennSup(S) + ennSup(T)] by linarith
    have le3 : (R[ennSup(S) + ennSup(T)]:R) ≤ (v:R) by linarith
    exact EnnLe.lint_of_real with sumR, vR, sum0, le3

-- Superadditivity of the lower integral (Mathlib's le_lintegral_add).
theorem lintegral.lint_add_ge (X μ f g h : Set)
  requires measure : Measure(X, μ)
  requires valuesF : EnnValued(X, f)
  requires valuesG : EnnValued(X, g)
  requires sum : ∀ x ∈ MeasurableSpace.carrier(X), h(x) = ennAdd(f(x), g(x))
  shows EnnLe(ennAdd(lintegral(X, μ, f), lintegral(X, μ, g)), lintegral(X, μ, h))
proof
  have space := Measure.space with measure
  have vF : ∀ x ∈ MeasurableSpace.carrier(X), f(x) ∈ ennreal
    unfold EnnValued at valuesF
    unfold MapsInto at valuesF
    exact valuesF
  have vG : ∀ x ∈ MeasurableSpace.carrier(X), g(x) ∈ ennreal
    unfold EnnValued at valuesG
    unfold MapsInto at valuesG
    exact valuesG
  have hM := lintegral.member at X, μ, h with measure
  have insideF : lowerSums(X, μ, f) ⊆ ennreal
    intros s hs
    obtain ⟨sM, rest⟩ := lowerSums.membership.forward with hs
    exact sM
  have insideG : lowerSums(X, μ, g) ⊆ ennreal
    intros s hs
    obtain ⟨sM, rest⟩ := lowerSums.membership.forward with hs
    exact sM
  have whole := MeasurablePartition.whole with space
  have w2 := whole
  obtain ⟨fin, sub, cover, disj⟩ := w2
  have PP := (powerset.membership_iff at {MeasurableSpace.carrier(X)}, MeasurableSpace.sets(X)).backward with sub
  obtain ⟨sf, tf⟩ := lowerSum.lint_member with measure, whole, vF
  obtain ⟨sg, tg⟩ := lowerSum.lint_member with measure, whole, vG
  have neF : ∃ s, s ∈ lowerSums(X, μ, f)
    have mem : lowerSum(μ, f, {MeasurableSpace.carrier(X)}) ∈ lowerSums(X, μ, f) := lowerSums.membership.backward with ⟨sf, {MeasurableSpace.carrier(X)}, PP, whole, rfl⟩
    exact ⟨lowerSum(μ, f, {MeasurableSpace.carrier(X)}), mem⟩
  have neG : ∃ s, s ∈ lowerSums(X, μ, g)
    have mem : lowerSum(μ, g, {MeasurableSpace.carrier(X)}) ∈ lowerSums(X, μ, g) := lowerSums.membership.backward with ⟨sg, {MeasurableSpace.carrier(X)}, PP, whole, rfl⟩
    exact ⟨lowerSum(μ, g, {MeasurableSpace.carrier(X)}), mem⟩
  have bound : ∀ s ∈ lowerSums(X, μ, f), ∀ t ∈ lowerSums(X, μ, g), EnnLe(ennAdd(s, t), lintegral(X, μ, h))
    intros s hs t ht
    obtain ⟨sM, P, PP2, partP, e⟩ := lowerSums.membership.forward with hs
    obtain ⟨tM, Q, QQ, partQ, e2⟩ := lowerSums.membership.forward with ht
    rw [e, e2]
    exact lintegral.lint_pair_lower with measure, vF, vG, sum, partP, partQ
  have r := ennAdd.lint_sup_le with insideF, insideG, hM, neF, neG, bound
  unfold lintegral at r
  unfold lintegral
  exact r

-- Section: Additivity
-- Mathlib's lintegral_add_left: additivity needs one summand measurable.
theorem lintegral.add (X μ f g : Set)
  requires measure : Measure(X, μ)
  requires measurable : Measurable(f, X, ennMeasurableSpace)
  requires values : EnnValued(X, g)
  shows lintegral(X, μ, ennAddOn(f, g, MeasurableSpace.carrier(X))) =
    ennAdd(lintegral(X, μ, f), lintegral(X, μ, g))
proof
  have valuesF : EnnValued(X, f)
    unfold EnnValued
    unfold MapsInto
    intros x hx
    have m := Measurable.maps with measurable, hx
    rw ennMeasurableSpace.carrier at m
    exact m
  have sum : ∀ x ∈ MeasurableSpace.carrier(X), ennAddOn(f, g, MeasurableSpace.carrier(X))(x) = ennAdd(f(x), g(x))
    intros x hx
    exact ennAddOn.lint_apply with hx
  have le := lintegral.lint_add_le with measure, measurable, values, sum
  have ge := lintegral.lint_add_ge with measure, valuesF, values, sum
  exact EnnLe.antisymmetric with le, ge

-- Mathlib's lintegral_const_mul (measurable f), lintegral_const_mul'
-- (finite constant), lintegral_const_mul_le, lintegral_mul_const.
theorem lintegral.const_mul (X μ c f : Set)
  requires measure : Measure(X, μ)
  requires member : c ∈ ennreal
  requires measurable : Measurable(f, X, ennMeasurableSpace)
  shows lintegral(X, μ, ennConstMulOn(c, f, MeasurableSpace.carrier(X))) =
    ennMul(c, lintegral(X, μ, f))
proof
  sorry

theorem lintegral.const_mul_finite (X μ c f : Set)
  requires measure : Measure(X, μ)
  requires member : c ∈ ennreal
  requires finite : c ≠ ennTop
  requires values : EnnValued(X, f)
  shows lintegral(X, μ, ennConstMulOn(c, f, MeasurableSpace.carrier(X))) =
    ennMul(c, lintegral(X, μ, f))
proof
  sorry

theorem lintegral.const_mul_le (X μ c f : Set)
  requires measure : Measure(X, μ)
  requires member : c ∈ ennreal
  requires values : EnnValued(X, f)
  shows EnnLe(ennMul(c, lintegral(X, μ, f)),
    lintegral(X, μ, ennConstMulOn(c, f, MeasurableSpace.carrier(X))))
proof
  sorry

-- Mathlib's lintegral_finsetSum.
theorem lintegral.finite_sum (X μ u F : Set)
  requires measure : Measure(X, μ)
  requires finite : Finite(F)
  requires measurable : ∀ i ∈ F, Measurable(u(i), X, ennMeasurableSpace)
  shows lintegral(X, μ, ennFiniteSumOn(u, F, MeasurableSpace.carrier(X))) =
    ennFiniteSum(lintegralFamily(X, μ, u, F), F)
proof
  sorry

-- Mathlib's lintegral_tsum: the integral of a countable sum of measurable
-- maps is the sum of the integrals.
theorem lintegral.tsum (X μ u : Set)
  requires measure : Measure(X, μ)
  requires measurable : ∀ n ∈ ℕ, Measurable(u(n), X, ennMeasurableSpace)
  shows lintegral(X, μ, ennTsumOn(u, MeasurableSpace.carrier(X))) =
    ennTsum(lintegralSequence(X, μ, u), ℕ)
proof
  sorry

-- Section: Convergence theorems
-- The monotone convergence theorem (Mathlib's lintegral_iSup).
theorem lintegral.monotone_convergence (X μ u : Set)
  requires measure : Measure(X, μ)
  requires measurable : ∀ n ∈ ℕ, Measurable(u(n), X, ennMeasurableSpace)
  requires increasing : ∀ m ∈ ℕ, ∀ n ∈ ℕ, m ⊆ n →
    ∀ x ∈ MeasurableSpace.carrier(X), EnnLe(u(m)(x), u(n)(x))
  shows lintegral(X, μ, ennSupSequenceOn(u, MeasurableSpace.carrier(X))) =
    ennSupOn(lintegralSequence(X, μ, u), ℕ)
proof
  have space := Measure.space with measure
  have vU : ∀ n ∈ ℕ, ∀ x ∈ MeasurableSpace.carrier(X), u(n)(x) ∈ ennreal
    intros n hn x hx
    have m := Measurable.maps with (measurable with n, hn), hx
    rw ennMeasurableSpace.carrier at m
    exact m
  have valuesN : ∀ n ∈ ℕ, EnnValued(X, u(n))
    intros n hn
    unfold EnnValued
    unfold MapsInto
    exact vU with n, hn
  have sup : ∀ x ∈ MeasurableSpace.carrier(X), ennSupSequenceOn(u, MeasurableSpace.carrier(X))(x) = ennSupOn(familyAt(u, ℕ, x), ℕ)
    intros x hx
    exact ennSupSequenceOn.lint_apply with hx
  have famv : ∀ x ∈ MeasurableSpace.carrier(X), ∀ n ∈ ℕ, familyAt(u, ℕ, x)(n) ∈ ennreal
    intros x hx n hn
    rw familyAt.apply with hn
    exact vU with n, hn, x, hx
  have vFx : ∀ x ∈ MeasurableSpace.carrier(X), ennSupSequenceOn(u, MeasurableSpace.carrier(X))(x) ∈ ennreal
    intros x hx
    rw sup with x, hx
    obtain ⟨m1, m2, m3⟩ := ennSupOn.lint_bounds with (famv with x, hx)
    exact m1
  have vF : EnnValued(X, ennSupSequenceOn(u, MeasurableSpace.carrier(X)))
    unfold EnnValued
    unfold MapsInto
    exact vFx
  have iv : ∀ n ∈ ℕ, lintegralSequence(X, μ, u)(n) ∈ ennreal
    intros n hn
    rw lintegralSequence.lint_apply with hn
    exact lintegral.member with measure
  obtain ⟨sM, sUp, sLeast⟩ := ennSupOn.lint_bounds with iv
  have iM := lintegral.member at X, μ, ennSupSequenceOn(u, MeasurableSpace.carrier(X)) with measure
  have ge : EnnLe(ennSupOn(lintegralSequence(X, μ, u), ℕ), lintegral(X, μ, ennSupSequenceOn(u, MeasurableSpace.carrier(X))))
    apply sLeast with iM
    intros n hn
    rw lintegralSequence.lint_apply with hn
    have le : ∀ x ∈ MeasurableSpace.carrier(X), EnnLe(u(n)(x), ennSupSequenceOn(u, MeasurableSpace.carrier(X))(x))
      intros x hx
      rw sup with x, hx
      obtain ⟨m1, m2, m3⟩ := ennSupOn.lint_bounds with (famv with x, hx)
      have l := m2 with n, hn
      rw familyAt.apply with hn at l
      exact l
    exact lintegral.mono with measure, (valuesN with n, hn), vF, le
  have le : EnnLe(lintegral(X, μ, ennSupSequenceOn(u, MeasurableSpace.carrier(X))), ennSupOn(lintegralSequence(X, μ, u), ℕ))
    apply lintegral.le_of_all with sM
    intros P partition
    have p2 := partition
    obtain ⟨fin, sub, cover, disj⟩ := p2
    have pieceX : ∀ C ∈ P, MeasurableSet(X, C) ∧ C ⊆ MeasurableSpace.carrier(X)
      intros C hC
      exact MeasurablePartition.pieces with space, partition, hC
    have cv : ∀ C ∈ P, ennInfOn(ennSupSequenceOn(u, MeasurableSpace.carrier(X)), C) ∈ ennreal
      intros C hC
      have pc := pieceX with C, hC
      have vC : ∀ x ∈ C, ennSupSequenceOn(u, MeasurableSpace.carrier(X))(x) ∈ ennreal
        intros x hx
        exact vFx with x, (pc.right with x, hx)
      exact ennInfOn.member with vC
    have Wv : ∀ k ∈ ℕ, ∀ C ∈ P, lintBetaSeq(μ, ennSupSequenceOn(u, MeasurableSpace.carrier(X)), P)(k)(C) ∈ ennreal
      intros k hk C hC
      rw lintBetaSeq.apply with hk
      rw simpleTerms.apply with hC
      rw lintBetas.apply with hC
      have f := lintApprox.facts with (cv with C, hC), hk
      have pc := pieceX with C, hC
      exact ennMul.member with f.left, (Measure.member with measure, pc.left)
    have Winc : ∀ k ∈ ℕ, ∀ n ∈ ℕ, k ⊆ n → ∀ C ∈ P, EnnLe(lintBetaSeq(μ, ennSupSequenceOn(u, MeasurableSpace.carrier(X)), P)(k)(C), lintBetaSeq(μ, ennSupSequenceOn(u, MeasurableSpace.carrier(X)), P)(n)(C))
      intros k hk n hn kn C hC
      rw lintBetaSeq.apply with hk
      rw lintBetaSeq.apply with hn
      rw simpleTerms.apply at μ, lintBetas(ennSupSequenceOn(u, MeasurableSpace.carrier(X)), P, k), P, C with hC
      rw simpleTerms.apply at μ, lintBetas(ennSupSequenceOn(u, MeasurableSpace.carrier(X)), P, n), P, C with hC
      rw lintBetas.apply at ennSupSequenceOn(u, MeasurableSpace.carrier(X)), P, k, C with hC
      rw lintBetas.apply at ennSupSequenceOn(u, MeasurableSpace.carrier(X)), P, n, C with hC
      have pc := pieceX with C, hC
      have mm := lintApprox.mono with (cv with C, hC), hk, hn, kn
      exact ennMul.mono with mm, (EnnLe.reflexive with (Measure.member with measure, pc.left))
    have keyk : ∀ k ∈ ℕ, EnnLe(lintFinSums(lintBetaSeq(μ, ennSupSequenceOn(u, MeasurableSpace.carrier(X)), P), P)(k), ennSupOn(lintegralSequence(X, μ, u), ℕ))
      intros k hk
      rw lintFinSums.apply with hk
      rw lintBetaSeq.apply with hk
      have bvalues : ∀ C ∈ P, lintBetas(ennSupSequenceOn(u, MeasurableSpace.carrier(X)), P, k)(C) ∈ ennreal
        intros C hC
        rw lintBetas.apply with hC
        have f := lintApprox.facts with (cv with C, hC), hk
        exact f.left
      have below : ∀ C ∈ P, lintBetas(ennSupSequenceOn(u, MeasurableSpace.carrier(X)), P, k)(C) = realZero ∨ EnnLt(lintBetas(ennSupSequenceOn(u, MeasurableSpace.carrier(X)), P, k)(C), ennInfOn(ennSupSequenceOn(u, MeasurableSpace.carrier(X)), C))
        intros C hC
        rw lintBetas.apply with hC
        have f := lintApprox.facts with (cv with C, hC), hk
        exact f.right
      exact lintegral.lint_mct_key with measure, measurable, increasing, partition, sup, bvalues, below
    have fsv : ∀ k ∈ ℕ, lintFinSums(lintBetaSeq(μ, ennSupSequenceOn(u, MeasurableSpace.carrier(X)), P), P)(k) ∈ ennreal
      intros k hk
      rw lintFinSums.apply with hk
      exact ennFiniteSum.member with fin, (Wv with k, hk)
    obtain ⟨tM, tUp, tLeast⟩ := ennSupOn.lint_bounds with fsv
    have tle := tLeast with ennSupOn(lintegralSequence(X, μ, u), ℕ), sM, keyk
    have sups : ∀ C ∈ P, ennPointwiseSup(lintBetaSeq(μ, ennSupSequenceOn(u, MeasurableSpace.carrier(X)), P), P)(C) = ennSupOn(familyAt(lintBetaSeq(μ, ennSupSequenceOn(u, MeasurableSpace.carrier(X)), P), ℕ, C), ℕ)
      intros C hC
      exact ennPointwiseSup.lint_apply with hC
    have e7 := ennFiniteSum.lint_le_sup with fin, Wv, Winc, sups
    have perC : ∀ C ∈ P, EnnLe(partitionTerms(μ, ennSupSequenceOn(u, MeasurableSpace.carrier(X)), P)(C), ennPointwiseSup(lintBetaSeq(μ, ennSupSequenceOn(u, MeasurableSpace.carrier(X)), P), P)(C))
      intros C hC
      rw partitionTerms.apply with hC
      rw ennPointwiseSup.lint_apply with hC
      have pc := pieceX with C, hC
      have muC := Measure.member with measure, pc.left
      have cC := cv with C, hC
      have approx : ∀ k ∈ ℕ, familyAt(lintBetaFam(ennSupSequenceOn(u, MeasurableSpace.carrier(X)), P), ℕ, C)(k) = lintApprox(ennInfOn(ennSupSequenceOn(u, MeasurableSpace.carrier(X)), C), k)
        intros k hk
        rw familyAt.apply with hk
        rw lintBetaFam.apply with hk
        rw lintBetas.apply with hC
      have bv : ∀ k ∈ ℕ, familyAt(lintBetaFam(ennSupSequenceOn(u, MeasurableSpace.carrier(X)), P), ℕ, C)(k) ∈ ennreal
        intros k hk
        rw approx with k, hk
        have f := lintApprox.facts with cC, hk
        exact f.left
      have asup := lintApprox.sup with cC, approx
      obtain ⟨bM, bUp, bLeast⟩ := ennSupOn.lint_bounds with bv
      have m1 := ennMul.mono with asup, (EnnLe.reflexive with muC)
      rw ennMul.comm with bM, muC at m1
      have prod : ∀ k ∈ ℕ, familyAt(lintBetaSeq(μ, ennSupSequenceOn(u, MeasurableSpace.carrier(X)), P), ℕ, C)(k) = ennMul(μ(C), familyAt(lintBetaFam(ennSupSequenceOn(u, MeasurableSpace.carrier(X)), P), ℕ, C)(k))
        intros k hk
        rw familyAt.apply at lintBetaSeq(μ, ennSupSequenceOn(u, MeasurableSpace.carrier(X)), P), ℕ, C, k with hk
        rw lintBetaSeq.apply with hk
        rw simpleTerms.apply with hC
        rw approx with k, hk
        rw lintBetas.apply with hC
        have f := lintApprox.facts with cC, hk
        exact ennMul.comm with f.left, muC
      have e5 := ennMul.lint_le_sup with muC, bv, prod
      exact EnnLe.transitive with m1, e5
    have ptv : ∀ C ∈ P, partitionTerms(μ, ennSupSequenceOn(u, MeasurableSpace.carrier(X)), P)(C) ∈ ennreal
      intros C hC
      rw partitionTerms.apply with hC
      have pc := pieceX with C, hC
      exact ennMul.member with (cv with C, hC), (Measure.member with measure, pc.left)
    have Lv : ∀ C ∈ P, ennPointwiseSup(lintBetaSeq(μ, ennSupSequenceOn(u, MeasurableSpace.carrier(X)), P), P)(C) ∈ ennreal
      intros C hC
      rw ennPointwiseSup.lint_apply with hC
      have fv : ∀ k ∈ ℕ, familyAt(lintBetaSeq(μ, ennSupSequenceOn(u, MeasurableSpace.carrier(X)), P), ℕ, C)(k) ∈ ennreal
        intros k hk
        rw familyAt.apply with hk
        exact Wv with k, hk, C, hC
      obtain ⟨fM, fUp, fLeast⟩ := ennSupOn.lint_bounds with fv
      exact fM
    have mono := ennFiniteSum.mono_fun with fin, ptv, Lv, perC
    have t1 := EnnLe.transitive with mono, e7
    unfold lowerSum
    exact EnnLe.transitive with t1, tle
  exact EnnLe.antisymmetric with le, ge

-- The sum of a sequence of suprema of increasing sequences is the
-- supremum of the sums (Mathlib's ENNReal.tsum_iSup... in the monotone
-- form used for monotone convergence).
theorem ennTsum.sup_increasing (u I : Set)
  requires values : ∀ n ∈ ℕ, ∀ i ∈ I, u(n)(i) ∈ ennreal
  requires increasing : ∀ m ∈ ℕ, ∀ n ∈ ℕ, m ≤ n → ∀ i ∈ I, EnnLe(u(m)(i), u(n)(i))
  shows ennTsum(ennPointwiseSup(u, I), I) = ennSupOn(ennSumsOf(u, ℕ, I), ℕ)
proof
  have famV : ∀ i ∈ I, ∀ n ∈ ℕ, familyAt(u, ℕ, i)(n) ∈ ennreal
    intros i hi n hn
    rw familyAt.apply with hn
    exact values with n, hn, i, hi
  have supV : ∀ i ∈ I, ennPointwiseSup(u, I)(i) ∈ ennreal
    intros i hi
    rw ennPointwiseSup.lint_apply with hi
    have b := ennSupOn.lint_bounds with (famV with i, hi)
    exact b.left
  have rowV : ∀ n ∈ ℕ, ∀ i ∈ I, u(n)(i) ∈ ennreal
    exact values
  have sumV : ∀ n ∈ ℕ, ennSumsOf(u, ℕ, I)(n) ∈ ennreal
    intros n hn
    rw ennSumsOf.apply with hn
    exact ennTsum.member with (rowV with n, hn)
  obtain ⟨sM, ub, lst⟩ := ennSupOn.lint_bounds with sumV
  have le : EnnLe(ennTsum(ennPointwiseSup(u, I), I), ennSupOn(ennSumsOf(u, ℕ, I), ℕ))
    apply ennTsum.least with supV, sM
    intros F hF
    obtain ⟨FP, finite⟩ := finiteSubsets.membership.forward with hF
    have FI := (powerset.membership_iff at F, I).forward with FP
    have vF : ∀ n ∈ ℕ, ∀ C ∈ F, u(n)(C) ∈ ennreal
      intros n hn C hC
      exact values with n, hn, C, (FI with C, hC)
    have incF : ∀ k ∈ ℕ, ∀ n ∈ ℕ, k ⊆ n → ∀ C ∈ F, EnnLe(u(k)(C), u(n)(C))
      intros k hk n hn kn C hC
      have kle := natural.lint_le_of_subset with hk, hn, kn
      exact increasing with k, hk, n, hn, kle, C, (FI with C, hC)
    have sups : ∀ C ∈ F, ennPointwiseSup(u, I)(C) = ennSupOn(familyAt(u, ℕ, C), ℕ)
      intros C hC
      exact ennPointwiseSup.lint_apply with (FI with C, hC)
    have l1 := ennFiniteSum.lint_le_sup with finite, vF, incF, sups
    have fsV : ∀ n ∈ ℕ, lintFinSums(u, F)(n) ∈ ennreal
      intros n hn
      rw lintFinSums.apply with hn
      exact ennFiniteSum.member with finite, (vF with n, hn)
    obtain ⟨fM, fub, flst⟩ := ennSupOn.lint_bounds with fsV
    have l2 : EnnLe(ennSupOn(lintFinSums(u, F), ℕ), ennSupOn(ennSumsOf(u, ℕ, I), ℕ))
      apply flst with sM
      intros n hn
      rw lintFinSums.apply with hn
      have t := ennTsum.upper with (rowV with n, hn), finite, FI
      have t2 := ub with n, hn
      rw ennSumsOf.apply with hn at t2
      exact EnnLe.transitive with t, t2
    exact EnnLe.transitive with l1, l2
  have ge : EnnLe(ennSupOn(ennSumsOf(u, ℕ, I), ℕ), ennTsum(ennPointwiseSup(u, I), I))
    apply lst with (ennTsum.member with supV)
    intros n hn
    rw ennSumsOf.apply with hn
    apply ennTsum.mono with (rowV with n, hn), supV
    intros i hi
    rw ennPointwiseSup.lint_apply with hi
    have b := ennSupOn.lint_bounds with (famV with i, hi)
    have l := b.right.left with n, hn
    rw familyAt.apply with hn at l
    exact l
  exact EnnLe.antisymmetric with le, ge

-- Mathlib's Measurable.iSup and Measurable.liminf: suprema and lim infs
-- of sequences of measurable maps into [0, ∞] are measurable (moved here
-- from Measure.Spaces).
def lintSupGt (u X t : Set) : Set := { (n, ennGtSet(u(n), MeasurableSpace.carrier(X), t)) | n ∈ ℕ }

theorem lintSupGt.apply (u X t n : Set)
  requires member : n ∈ ℕ
  shows lintSupGt(u, X, t)(n) = ennGtSet(u(n), MeasurableSpace.carrier(X), t)
proof
  have edge : (n, ennGtSet(u(n), MeasurableSpace.carrier(X), t)) ∈ lintSupGt(u, X, t)
    apply lintSupGt.membership.backward
    exact ⟨n, member, rfl⟩
  have pairs : ∀ p ∈ lintSupGt(u, X, t), ∃ a, ∃ b, p = (a, b)
    intros p hp
    obtain ⟨k0, hk, pEq⟩ := lintSupGt.membership.forward with hp
    rw ← pEq
    exact ⟨k0, ennGtSet(u(k0), MeasurableSpace.carrier(X), t), rfl⟩
  have functional : ∀ a, ∀ b, ∀ c, (a, b) ∈ lintSupGt(u, X, t) → (a, c) ∈ lintSupGt(u, X, t) → b = c
    intros a b c hb hc
    obtain ⟨k0, hk, bEq⟩ := lintSupGt.membership.forward with hb
    obtain ⟨m0, hm, cEq⟩ := lintSupGt.membership.forward with hc
    obtain ⟨ka, bb⟩ := orderedPair.injective with bEq
    obtain ⟨ma, cc⟩ := orderedPair.injective with cEq
    rw [← bb, ← cc, ka, ← ma]
  exact pairGraph.apply with pairs, functional, edge


theorem Measurable.enn_sup (u h X : Set)
  requires measurable : ∀ n ∈ ℕ, Measurable(u(n), X, ennMeasurableSpace)
  requires supremum : ∀ x ∈ MeasurableSpace.carrier(X),
    h(x) = ennSupOn(familyAt(u, ℕ, x), ℕ)
  shows Measurable(h, X, ennMeasurableSpace)
proof
  have space : MeasurableSpace(X)
    have z : realOne ∈ ℝ by typecheck
    have zp : realZero < realOne by linarith
    obtain ⟨n, hn, near⟩ := lintRatio.near with z, zp
    have m := measurable with n, hn
    unfold Measurable at m
    exact m.left
  have vU : ∀ n ∈ ℕ, ∀ x ∈ MeasurableSpace.carrier(X), u(n)(x) ∈ ennreal
    intros n hn x hx
    have m := Measurable.maps with (measurable with n, hn), hx
    rw ennMeasurableSpace.carrier at m
    exact m
  have famV : ∀ x ∈ MeasurableSpace.carrier(X), ∀ n ∈ ℕ, familyAt(u, ℕ, x)(n) ∈ ennreal
    intros x hx n hn
    rw familyAt.apply with hn
    exact vU with n, hn, x, hx
  have maps : MapsInto(h, MeasurableSpace.carrier(X), ennreal)
    unfold MapsInto
    intros x hx
    rw supremum with x, hx
    have b := ennSupOn.lint_bounds with (famV with x, hx)
    exact b.left
  apply Measurable.enn_of_rays with space, maps
  intros t ht
  have sets : ∀ n ∈ ℕ, MeasurableSet(X, lintSupGt(u, X, t)(n))
    intros n hn
    rw lintSupGt.apply with hn
    exact MeasurableSet.lint_gt with (measurable with n, hn), ht
  have same : sequenceUnion(lintSupGt(u, X, t)) = ennGtSet(h, MeasurableSpace.carrier(X), t)
    ext x
    constructor
    . intro hx
      unfold sequenceUnion at hx
      obtain ⟨D, hD, xD⟩ := union.membership.forward with hx
      obtain ⟨n, hn, e⟩ := valuesOn.membership.forward with hD
      rw ← e at xD
      rw lintSupGt.apply with hn at xD
      unfold ennGtSet at xD
      simp at xD
      obtain ⟨xX, nle⟩ := xD
      have b := ennSupOn.lint_bounds with (famV with x, xX)
      have un := b.right.left with n, hn
      rw familyAt.apply with hn at un
      have nh : ¬EnnLe(h(x), t)
        intro hle
        rw supremum with x, xX at hle
        exact nle with (EnnLe.transitive with un, hle)
      unfold ennGtSet
      simp [xX, nh]
    . intro hx
      unfold ennGtSet at hx
      simp at hx
      obtain ⟨xX, nh⟩ := hx
      have ex : ∃ n ∈ ℕ, ¬EnnLe(u(n)(x), t)
        by_contra none
        have all : ∀ n ∈ ℕ, EnnLe(familyAt(u, ℕ, x)(n), t)
          intros n hn
          rw familyAt.apply with hn
          by_contra nle
          exact none with ⟨n, hn, nle⟩
        have b := ennSupOn.lint_bounds with (famV with x, xX)
        have l := b.right.right with t, ht, all
        rw ← supremum with x, xX at l
        exact nh with l
      obtain ⟨n, hn, nle⟩ := ex
      have xn : x ∈ lintSupGt(u, X, t)(n)
        rw lintSupGt.apply with hn
        unfold ennGtSet
        simp [xX, nle]
      have inV : lintSupGt(u, X, t)(n) ∈ valuesOn(lintSupGt(u, X, t), ℕ) := valuesOn.membership.backward with ⟨n, hn, rfl⟩
      unfold sequenceUnion
      exact union.membership.backward with ⟨lintSupGt(u, X, t)(n), inV, xn⟩
  rw ← same
  exact MeasurableSet.sequence_union with space, sets

-- Section: Helpers for Fatou's lemma
-- The tail infima x ↦ inf_{k ≥ n} u(k)(x), the sets where u(k) ≥ t from
-- n on, and the sets {f ≥ t + 1/(k + 1)}.
def lintTailInfOn (u A n : Set) : Set := { (x, ennInfOn(familyAt(u, ℕ, x), tailFrom(n))) | x ∈ A }
def lintTailInfSeq (u A : Set) : Set := { (n, lintTailInfOn(u, A, n)) | n ∈ ℕ }
def lintTailGeSet (u X n t k : Set) : Set :=
  { x ∈ MeasurableSpace.carrier(X) | n ⊆ k → EnnLe(t, u(k)(x)) }
def lintTailGe (u X n t : Set) : Set := { (k, lintTailGeSet(u, X, n, t, k)) | k ∈ ℕ }
def lintUpSets (f X t : Set) : Set :=
  { (k, ennGeSet(f, MeasurableSpace.carrier(X), R[t + (realOne - lintRatio(k))])) | k ∈ ℕ }

theorem lintTailInfOn.apply (u A n x : Set)
  requires member : x ∈ A
  shows lintTailInfOn(u, A, n)(x) = ennInfOn(familyAt(u, ℕ, x), tailFrom(n))
proof
  have edge : (x, ennInfOn(familyAt(u, ℕ, x), tailFrom(n))) ∈ lintTailInfOn(u, A, n)
    apply lintTailInfOn.membership.backward
    exact ⟨x, member, rfl⟩
  have pairs : ∀ p ∈ lintTailInfOn(u, A, n), ∃ a, ∃ b, p = (a, b)
    intros p hp
    obtain ⟨k0, hk, pEq⟩ := lintTailInfOn.membership.forward with hp
    rw ← pEq
    exact ⟨k0, ennInfOn(familyAt(u, ℕ, k0), tailFrom(n)), rfl⟩
  have functional : ∀ a, ∀ b, ∀ c, (a, b) ∈ lintTailInfOn(u, A, n) → (a, c) ∈ lintTailInfOn(u, A, n) → b = c
    intros a b c hb hc
    obtain ⟨k0, hk, bEq⟩ := lintTailInfOn.membership.forward with hb
    obtain ⟨m0, hm, cEq⟩ := lintTailInfOn.membership.forward with hc
    obtain ⟨ka, bb⟩ := orderedPair.injective with bEq
    obtain ⟨ma, cc⟩ := orderedPair.injective with cEq
    rw [← bb, ← cc, ka, ← ma]
  exact pairGraph.apply with pairs, functional, edge

theorem lintTailInfSeq.apply (u A n : Set)
  requires member : n ∈ ℕ
  shows lintTailInfSeq(u, A)(n) = lintTailInfOn(u, A, n)
proof
  have edge : (n, lintTailInfOn(u, A, n)) ∈ lintTailInfSeq(u, A)
    apply lintTailInfSeq.membership.backward
    exact ⟨n, member, rfl⟩
  have pairs : ∀ p ∈ lintTailInfSeq(u, A), ∃ a, ∃ b, p = (a, b)
    intros p hp
    obtain ⟨k0, hk, pEq⟩ := lintTailInfSeq.membership.forward with hp
    rw ← pEq
    exact ⟨k0, lintTailInfOn(u, A, k0), rfl⟩
  have functional : ∀ a, ∀ b, ∀ c, (a, b) ∈ lintTailInfSeq(u, A) → (a, c) ∈ lintTailInfSeq(u, A) → b = c
    intros a b c hb hc
    obtain ⟨k0, hk, bEq⟩ := lintTailInfSeq.membership.forward with hb
    obtain ⟨m0, hm, cEq⟩ := lintTailInfSeq.membership.forward with hc
    obtain ⟨ka, bb⟩ := orderedPair.injective with bEq
    obtain ⟨ma, cc⟩ := orderedPair.injective with cEq
    rw [← bb, ← cc, ka, ← ma]
  exact pairGraph.apply with pairs, functional, edge

theorem lintTailGe.apply (u X n t k : Set)
  requires member : k ∈ ℕ
  shows lintTailGe(u, X, n, t)(k) = lintTailGeSet(u, X, n, t, k)
proof
  have edge : (k, lintTailGeSet(u, X, n, t, k)) ∈ lintTailGe(u, X, n, t)
    apply lintTailGe.membership.backward
    exact ⟨k, member, rfl⟩
  have pairs : ∀ p ∈ lintTailGe(u, X, n, t), ∃ a, ∃ b, p = (a, b)
    intros p hp
    obtain ⟨k0, hk, pEq⟩ := lintTailGe.membership.forward with hp
    rw ← pEq
    exact ⟨k0, lintTailGeSet(u, X, n, t, k0), rfl⟩
  have functional : ∀ a, ∀ b, ∀ c, (a, b) ∈ lintTailGe(u, X, n, t) → (a, c) ∈ lintTailGe(u, X, n, t) → b = c
    intros a b c hb hc
    obtain ⟨k0, hk, bEq⟩ := lintTailGe.membership.forward with hb
    obtain ⟨m0, hm, cEq⟩ := lintTailGe.membership.forward with hc
    obtain ⟨ka, bb⟩ := orderedPair.injective with bEq
    obtain ⟨ma, cc⟩ := orderedPair.injective with cEq
    rw [← bb, ← cc, ka, ← ma]
  exact pairGraph.apply with pairs, functional, edge

theorem lintUpSets.apply (f X t k : Set)
  requires member : k ∈ ℕ
  shows lintUpSets(f, X, t)(k) = ennGeSet(f, MeasurableSpace.carrier(X), R[t + (realOne - lintRatio(k))])
proof
  have edge : (k, ennGeSet(f, MeasurableSpace.carrier(X), R[t + (realOne - lintRatio(k))])) ∈ lintUpSets(f, X, t)
    apply lintUpSets.membership.backward
    exact ⟨k, member, rfl⟩
  have pairs : ∀ p ∈ lintUpSets(f, X, t), ∃ a, ∃ b, p = (a, b)
    intros p hp
    obtain ⟨k0, hk, pEq⟩ := lintUpSets.membership.forward with hp
    rw ← pEq
    exact ⟨k0, ennGeSet(f, MeasurableSpace.carrier(X), R[t + (realOne - lintRatio(k0))]), rfl⟩
  have functional : ∀ a, ∀ b, ∀ c, (a, b) ∈ lintUpSets(f, X, t) → (a, c) ∈ lintUpSets(f, X, t) → b = c
    intros a b c hb hc
    obtain ⟨k0, hk, bEq⟩ := lintUpSets.membership.forward with hb
    obtain ⟨m0, hm, cEq⟩ := lintUpSets.membership.forward with hc
    obtain ⟨ka, bb⟩ := orderedPair.injective with bEq
    obtain ⟨ma, cc⟩ := orderedPair.injective with cEq
    rw [← bb, ← cc, ka, ← ma]
  exact pairGraph.apply with pairs, functional, edge

theorem ennLiminfOn.lint_apply (u A x : Set)
  requires member : x ∈ A
  shows ennLiminfOn(u, A)(x) = ennLiminf(familyAt(u, ℕ, x))
proof
  have edge : (x, ennLiminf(familyAt(u, ℕ, x))) ∈ ennLiminfOn(u, A)
    apply ennLiminfOn.membership.backward
    exact ⟨x, member, rfl⟩
  have pairs : ∀ p ∈ ennLiminfOn(u, A), ∃ a, ∃ b, p = (a, b)
    intros p hp
    obtain ⟨k0, hk, pEq⟩ := ennLiminfOn.membership.forward with hp
    rw ← pEq
    exact ⟨k0, ennLiminf(familyAt(u, ℕ, k0)), rfl⟩
  have functional : ∀ a, ∀ b, ∀ c, (a, b) ∈ ennLiminfOn(u, A) → (a, c) ∈ ennLiminfOn(u, A) → b = c
    intros a b c hb hc
    obtain ⟨k0, hk, bEq⟩ := ennLiminfOn.membership.forward with hb
    obtain ⟨m0, hm, cEq⟩ := ennLiminfOn.membership.forward with hc
    obtain ⟨ka, bb⟩ := orderedPair.injective with bEq
    obtain ⟨ma, cc⟩ := orderedPair.injective with cEq
    rw [← bb, ← cc, ka, ← ma]
  exact pairGraph.apply with pairs, functional, edge

theorem ennTailInfs.lint_apply (f n : Set)
  requires member : n ∈ ℕ
  shows ennTailInfs(f)(n) = ennInfOn(f, tailFrom(n))
proof
  have edge : (n, ennInfOn(f, tailFrom(n))) ∈ ennTailInfs(f)
    apply ennTailInfs.membership.backward
    exact ⟨n, member, rfl⟩
  have pairs : ∀ p ∈ ennTailInfs(f), ∃ a, ∃ b, p = (a, b)
    intros p hp
    obtain ⟨k0, hk, pEq⟩ := ennTailInfs.membership.forward with hp
    rw ← pEq
    exact ⟨k0, ennInfOn(f, tailFrom(k0)), rfl⟩
  have functional : ∀ a, ∀ b, ∀ c, (a, b) ∈ ennTailInfs(f) → (a, c) ∈ ennTailInfs(f) → b = c
    intros a b c hb hc
    obtain ⟨k0, hk, bEq⟩ := ennTailInfs.membership.forward with hb
    obtain ⟨m0, hm, cEq⟩ := ennTailInfs.membership.forward with hc
    obtain ⟨ka, bb⟩ := orderedPair.injective with bEq
    obtain ⟨ma, cc⟩ := orderedPair.injective with cEq
    rw [← bb, ← cc, ka, ← ma]
  exact pairGraph.apply with pairs, functional, edge

theorem ennSupOn.lint_congr (a b : Set)
  requires agree : ∀ n ∈ ℕ, a(n) = b(n)
  shows ennSupOn(a, ℕ) = ennSupOn(b, ℕ)
proof
  have same : valuesOn(a, ℕ) = valuesOn(b, ℕ)
    ext v
    constructor
    . intro h
      obtain ⟨n, hn, e⟩ := valuesOn.membership.forward with h
      rw agree with n, hn at e
      exact valuesOn.membership.backward with ⟨n, hn, e⟩
    . intro h
      obtain ⟨n, hn, e⟩ := valuesOn.membership.forward with h
      rw ← agree with n, hn at e
      exact valuesOn.membership.backward with ⟨n, hn, e⟩
  unfold ennSupOn
  rw same

-- A map into [0, ∞] is measurable when the sets {f ≥ t} are.
theorem Measurable.lint_of_ge (f X : Set)
  requires space : MeasurableSpace(X)
  requires maps : MapsInto(f, MeasurableSpace.carrier(X), ennreal)
  requires ge : ∀ t ∈ ennreal, MeasurableSet(X, ennGeSet(f, MeasurableSpace.carrier(X), t))
  shows Measurable(f, X, ennMeasurableSpace)
proof
  have fv : ∀ x ∈ MeasurableSpace.carrier(X), f(x) ∈ ennreal
    unfold MapsInto at maps
    exact maps
  apply Measurable.enn_of_rays with space, maps
  intros t ht
  by_cases tt : t = ennTop
  . have same : ennGtSet(f, MeasurableSpace.carrier(X), t) = ∅
      ext x
      constructor
      . intro h
        unfold ennGtSet at h
        simp at h
        exfalso
        apply h.right
        rw tt
        exact EnnLe.top with (fv with x, h.left)
      . intro h
        simp at h
    rw same
    exact MeasurableSet.empty with space
  . obtain ⟨tR, tN⟩ := ennreal.finite with ht, tt
    have tReal : Real(t) by exact tR
    have um : ∀ k ∈ ℕ, MeasurableSet(X, lintUpSets(f, X, t)(k))
      intros k hk
      rw lintUpSets.apply with hk
      obtain ⟨rR, r0, r1, rM⟩ := lintRatio.facts with hk
      have rReal : Real(lintRatio(k)) by exact rR
      have cR : R[t + (realOne - lintRatio(k))] ∈ ℝ by typecheck
      have c0 : realZero ≤ R[t + (realOne - lintRatio(k))] by linarith
      exact ge with R[t + (realOne - lintRatio(k))], (ennreal.of_real with cR, c0)
    have same : sequenceUnion(lintUpSets(f, X, t)) = ennGtSet(f, MeasurableSpace.carrier(X), t)
      ext x
      constructor
      . intro hx
        unfold sequenceUnion at hx
        obtain ⟨D, hD, xD⟩ := union.membership.forward with hx
        obtain ⟨k, hk, e⟩ := valuesOn.membership.forward with hD
        rw ← e at xD
        rw lintUpSets.apply with hk at xD
        unfold ennGeSet at xD
        simp at xD
        obtain ⟨xX, cle⟩ := xD
        obtain ⟨rR, r0, r1, rM⟩ := lintRatio.facts with hk
        have rReal : Real(lintRatio(k)) by exact rR
        have nle : ¬EnnLe(f(x), t)
          intro fle
          have tr := EnnLe.transitive with cle, fle
          obtain ⟨a1, a2, a3, a4, a5⟩ := EnnLe.lint_to_real with tr, tt
          linarith
        unfold ennGtSet
        simp [xX, nle]
      . intro hx
        unfold ennGtSet at hx
        simp at hx
        obtain ⟨xX, nle⟩ := hx
        have fx := fv with x, xX
        have found : ∃ k ∈ ℕ, EnnLe(R[t + (realOne - lintRatio(k))], f(x))
          by_cases ft : f(x) = ennTop
          . have oneR : realOne ∈ ℝ by typecheck
            have onePos : realZero < realOne by linarith
            obtain ⟨k, hk, near⟩ := lintRatio.near with oneR, onePos
            obtain ⟨rR, r0, r1, rM⟩ := lintRatio.facts with hk
            have rReal : Real(lintRatio(k)) by exact rR
            have cR : R[t + (realOne - lintRatio(k))] ∈ ℝ by typecheck
            have c0 : realZero ≤ R[t + (realOne - lintRatio(k))] by linarith
            have cM := ennreal.of_real with cR, c0
            rw ft
            exact ⟨k, hk, (EnnLe.top with cM)⟩
          . obtain ⟨fR, fN⟩ := ennreal.finite with fx, ft
            have fReal : Real(f(x)) by exact fR
            have lt : (t:R) < (f(x):R)
              by_contra nlt
              have le2 : (f(x):R) ≤ (t:R) by linarith
              exact nle with (EnnLe.lint_of_real with fR, tR, fN, le2)
            have dR : R[f(x) - t] ∈ ℝ by typecheck
            have dP : realZero < R[f(x) - t] by linarith
            obtain ⟨k, hk, near⟩ := lintRatio.near with dR, dP
            obtain ⟨rR, r0, r1, rM⟩ := lintRatio.facts with hk
            have rReal : Real(lintRatio(k)) by exact rR
            have cR : R[t + (realOne - lintRatio(k))] ∈ ℝ by typecheck
            have c0 : realZero ≤ R[t + (realOne - lintRatio(k))] by linarith
            have cle : (R[t + (realOne - lintRatio(k))]:R) ≤ (f(x):R) by linarith
            exact ⟨k, hk, (EnnLe.lint_of_real with cR, fR, c0, cle)⟩
        obtain ⟨k, hk, cle⟩ := found
        have xk : x ∈ lintUpSets(f, X, t)(k)
          rw lintUpSets.apply with hk
          unfold ennGeSet
          simp [xX, cle]
        have inV : lintUpSets(f, X, t)(k) ∈ valuesOn(lintUpSets(f, X, t), ℕ) := valuesOn.membership.backward with ⟨k, hk, rfl⟩
        unfold sequenceUnion
        exact union.membership.backward with ⟨lintUpSets(f, X, t)(k), inV, xk⟩
    have m := MeasurableSet.sequence_union with space, um
    rw same at m
    exact m

-- The tail infima of a sequence of measurable maps are measurable.
theorem lintTailInfOn.measurable (X u n : Set)
  requires space : MeasurableSpace(X)
  requires measurable : ∀ k ∈ ℕ, Measurable(u(k), X, ennMeasurableSpace)
  requires member : n ∈ ℕ
  shows Measurable(lintTailInfOn(u, MeasurableSpace.carrier(X), n), X, ennMeasurableSpace)
proof
  have vU : ∀ k ∈ ℕ, ∀ x ∈ MeasurableSpace.carrier(X), u(k)(x) ∈ ennreal
    intros k hk x hx
    have m := Measurable.maps with (measurable with k, hk), hx
    rw ennMeasurableSpace.carrier at m
    exact m
  have tailNat : ∀ k ∈ tailFrom(n), k ∈ ℕ ∧ n ⊆ k
    intros k hk
    unfold tailFrom at hk
    simp at hk
    exact hk
  have fam : ∀ x ∈ MeasurableSpace.carrier(X), ∀ k ∈ tailFrom(n), familyAt(u, ℕ, x)(k) ∈ ennreal
    intros x hx k hk
    obtain ⟨kN, nk⟩ := tailNat with k, hk
    rw familyAt.apply with kN
    exact vU with k, kN, x, hx
  have maps : MapsInto(lintTailInfOn(u, MeasurableSpace.carrier(X), n), MeasurableSpace.carrier(X), ennreal)
    unfold MapsInto
    intros x hx
    rw lintTailInfOn.apply with hx
    exact ennInfOn.member with (fam with x, hx)
  apply Measurable.lint_of_ge with space, maps
  intros t ht
  have sets : ∀ k ∈ ℕ, MeasurableSet(X, lintTailGe(u, X, n, t)(k))
    intros k hk
    rw lintTailGe.apply with hk
    by_cases nk : n ⊆ k
    . have same : lintTailGeSet(u, X, n, t, k) = ennGeSet(u(k), MeasurableSpace.carrier(X), t)
        ext x
        unfold lintTailGeSet
        constructor
        . intro h
          simp at h
          have l := h.right with nk
          unfold ennGeSet
          simp [h.left, l]
        . intro h
          unfold ennGeSet at h
          simp at h
          simp [h]
      rw same
      exact MeasurableSet.lint_ge with (measurable with k, hk), ht
    . have same : lintTailGeSet(u, X, n, t, k) = MeasurableSpace.carrier(X)
        ext x
        unfold lintTailGeSet
        constructor
        . intro h
          simp at h
          exact h.left
        . intro h
          simp [h, nk]
      rw same
      exact MeasurableSet.univ with space
  have same : sequenceInter(MeasurableSpace.carrier(X), lintTailGe(u, X, n, t)) = ennGeSet(lintTailInfOn(u, MeasurableSpace.carrier(X), n), MeasurableSpace.carrier(X), t)
    ext x
    constructor
    . intro h
      unfold sequenceInter at h
      simp at h
      obtain ⟨xX, all⟩ := h
      have bound : ∀ k ∈ tailFrom(n), EnnLe(t, familyAt(u, ℕ, x)(k))
        intros k hk
        obtain ⟨kN, nk⟩ := tailNat with k, hk
        rw familyAt.apply with kN
        have xk := all with k, kN
        rw lintTailGe.apply with kN at xk
        unfold lintTailGeSet at xk
        simp at xk
        exact xk.right with nk
      have l := ennInfOn.ge with (fam with x, xX), ht, bound
      rw ← lintTailInfOn.apply with xX at l
      unfold ennGeSet
      simp [xX, l]
    . intro h
      unfold ennGeSet at h
      simp at h
      obtain ⟨xX, l⟩ := h
      rw lintTailInfOn.apply with xX at l
      have all : ∀ k ∈ ℕ, x ∈ lintTailGe(u, X, n, t)(k)
        intros k hk
        rw lintTailGe.apply with hk
        have imp : n ⊆ k → EnnLe(t, u(k)(x))
          intro nk
          have kt : k ∈ tailFrom(n)
            unfold tailFrom
            simp [hk, nk]
          have l2 := ennInfOn.le_value with (fam with x, xX), kt
          rw familyAt.apply with hk at l2
          exact EnnLe.transitive with l, l2
        unfold lintTailGeSet
        simp [xX, imp]
      unfold sequenceInter
      simp [xX, all]
  rw ← same
  exact MeasurableSet.sequence_inter with space, sets

theorem Measurable.enn_liminf (u h X : Set)
  requires measurable : ∀ n ∈ ℕ, Measurable(u(n), X, ennMeasurableSpace)
  requires lower : ∀ x ∈ MeasurableSpace.carrier(X),
    h(x) = ennLiminf(familyAt(u, ℕ, x))
  shows Measurable(h, X, ennMeasurableSpace)
proof
  have Gm : ∀ n ∈ ℕ, Measurable(lintTailInfSeq(u, MeasurableSpace.carrier(X))(n), X, ennMeasurableSpace)
    have space : MeasurableSpace(X)
      have z : realOne ∈ ℝ by typecheck
      have zp : realZero < realOne by linarith
      obtain ⟨n, hn, near⟩ := lintRatio.near with z, zp
      have m := measurable with n, hn
      unfold Measurable at m
      exact m.left
    intros n hn
    rw lintTailInfSeq.apply with hn
    exact lintTailInfOn.measurable with space, measurable, hn
  have sup : ∀ x ∈ MeasurableSpace.carrier(X), h(x) = ennSupOn(familyAt(lintTailInfSeq(u, MeasurableSpace.carrier(X)), ℕ, x), ℕ)
    intros x hx
    rw lower with x, hx
    unfold ennLiminf
    apply ennSupOn.lint_congr
    intros n hn
    rw ennTailInfs.lint_apply with hn
    rw familyAt.apply with hn
    rw lintTailInfSeq.apply with hn
    rw lintTailInfOn.apply with hx
  exact Measurable.enn_sup with Gm, sup

-- Fatou's lemma (Mathlib's lintegral_liminf_le).
theorem lintegral.fatou (X μ u : Set)
  requires measure : Measure(X, μ)
  requires measurable : ∀ n ∈ ℕ, Measurable(u(n), X, ennMeasurableSpace)
  shows EnnLe(lintegral(X, μ, ennLiminfOn(u, MeasurableSpace.carrier(X))),
    ennLiminf(lintegralSequence(X, μ, u)))
proof
  have space := Measure.space with measure
  have vU : ∀ n ∈ ℕ, ∀ x ∈ MeasurableSpace.carrier(X), u(n)(x) ∈ ennreal
    intros n hn x hx
    have m := Measurable.maps with (measurable with n, hn), hx
    rw ennMeasurableSpace.carrier at m
    exact m
  have valuesU : ∀ n ∈ ℕ, EnnValued(X, u(n))
    intros n hn
    unfold EnnValued
    unfold MapsInto
    exact vU with n, hn
  have tailNat : ∀ n, ∀ k ∈ tailFrom(n), k ∈ ℕ ∧ n ⊆ k
    intros n k hk
    unfold tailFrom at hk
    simp at hk
    exact hk
  have fam : ∀ x ∈ MeasurableSpace.carrier(X), ∀ n, ∀ k ∈ tailFrom(n), familyAt(u, ℕ, x)(k) ∈ ennreal
    intros x hx n k hk
    obtain ⟨kN, nk⟩ := tailNat with n, k, hk
    rw familyAt.apply with kN
    exact vU with k, kN, x, hx
  have Gv : ∀ n ∈ ℕ, ∀ x ∈ MeasurableSpace.carrier(X), lintTailInfSeq(u, MeasurableSpace.carrier(X))(n)(x) = ennInfOn(familyAt(u, ℕ, x), tailFrom(n))
    intros n hn x hx
    rw lintTailInfSeq.apply with hn
    exact lintTailInfOn.apply with hx
  have Gm : ∀ n ∈ ℕ, Measurable(lintTailInfSeq(u, MeasurableSpace.carrier(X))(n), X, ennMeasurableSpace)
    intros n hn
    rw lintTailInfSeq.apply with hn
    exact lintTailInfOn.measurable with space, measurable, hn
  have valuesG : ∀ n ∈ ℕ, EnnValued(X, lintTailInfSeq(u, MeasurableSpace.carrier(X))(n))
    intros n hn
    unfold EnnValued
    unfold MapsInto
    intros x hx
    rw Gv with n, hn, x, hx
    exact ennInfOn.member with (fam with x, hx, n)
  have Ginc : ∀ m ∈ ℕ, ∀ n ∈ ℕ, m ⊆ n → ∀ x ∈ MeasurableSpace.carrier(X), EnnLe(lintTailInfSeq(u, MeasurableSpace.carrier(X))(m)(x), lintTailInfSeq(u, MeasurableSpace.carrier(X))(n)(x))
    intros m hm n hn mn x hx
    rw Gv with m, hm, x, hx
    rw Gv with n, hn, x, hx
    apply ennInfOn.ge with (fam with x, hx, n), (ennInfOn.member with (fam with x, hx, m))
    intros k hk
    obtain ⟨kN, nk⟩ := tailNat with n, k, hk
    have mk := Subset.transitive with mn, nk
    have kt : k ∈ tailFrom(m)
      unfold tailFrom
      simp [kN, mk]
    exact ennInfOn.le_value with (fam with x, hx, m), kt
  have mct := lintegral.monotone_convergence with measure, Gm, Ginc
  have agree : ∀ x ∈ MeasurableSpace.carrier(X), ennLiminfOn(u, MeasurableSpace.carrier(X))(x) = ennSupSequenceOn(lintTailInfSeq(u, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X))(x)
    intros x hx
    rw ennLiminfOn.lint_apply with hx
    rw ennSupSequenceOn.lint_apply with hx
    unfold ennLiminf
    apply ennSupOn.lint_congr
    intros n hn
    rw ennTailInfs.lint_apply with hn
    rw familyAt.apply with hn
    rw Gv with n, hn, x, hx
  rw lintegral.congr with agree
  rw mct
  unfold ennLiminf
  have lfam : ∀ n, ∀ k ∈ tailFrom(n), lintegralSequence(X, μ, u)(k) ∈ ennreal
    intros n k hk
    obtain ⟨kN, nk⟩ := tailNat with n, k, hk
    rw lintegralSequence.lint_apply with kN
    exact lintegral.member_any
  have tv : ∀ n ∈ ℕ, ennTailInfs(lintegralSequence(X, μ, u))(n) ∈ ennreal
    intros n hn
    rw ennTailInfs.lint_apply with hn
    exact ennInfOn.member with (lfam with n)
  have gv : ∀ n ∈ ℕ, lintegralSequence(X, μ, lintTailInfSeq(u, MeasurableSpace.carrier(X)))(n) ∈ ennreal
    intros n hn
    rw lintegralSequence.lint_apply with hn
    exact lintegral.member_any at X, μ, lintTailInfSeq(u, MeasurableSpace.carrier(X))(n)
  obtain ⟨sM, ub, lst⟩ := ennSupOn.lint_bounds with tv
  obtain ⟨sG, ubG, lstG⟩ := ennSupOn.lint_bounds with gv
  apply lstG with sM
  intros n hn
  have step : EnnLe(lintegralSequence(X, μ, lintTailInfSeq(u, MeasurableSpace.carrier(X)))(n), ennTailInfs(lintegralSequence(X, μ, u))(n))
    rw lintegralSequence.lint_apply with hn
    rw ennTailInfs.lint_apply with hn
    apply ennInfOn.ge with (lfam with n), (lintegral.member_any at X, μ, lintTailInfSeq(u, MeasurableSpace.carrier(X))(n))
    intros k hk
    obtain ⟨kN, nk⟩ := tailNat with n, k, hk
    rw lintegralSequence.lint_apply with kN
    apply lintegral.mono with measure, (valuesG with n, hn), (valuesU with k, kN)
    intros x hx
    rw Gv with n, hn, x, hx
    have l := ennInfOn.le_value with (fam with x, hx, n), hk
    rw familyAt.apply with kN at l
    exact l
  exact EnnLe.transitive with step, (ub with n, hn)

-- Dominated convergence for lower integrals (Mathlib's
-- tendsto_lintegral_of_dominated_convergence): pointwise convergence
-- almost everywhere under an integrable bound.
theorem lintegral.dominated_convergence (X μ u f g : Set)
  requires measure : Measure(X, μ)
  requires measurable : ∀ n ∈ ℕ, Measurable(u(n), X, ennMeasurableSpace)
  requires values : EnnValued(X, f)
  requires bound : ∀ n ∈ ℕ, AlmostEverywhere(X, μ,
    ennLeSet(u(n), g, MeasurableSpace.carrier(X)))
  requires integrable : lintegral(X, μ, g) ≠ ennTop
  requires limit : AlmostEverywhere(X, μ,
    ennConvergenceSet(u, f, MeasurableSpace.carrier(X)))
  shows EnnConvergesTo(lintegralSequence(X, μ, u), lintegral(X, μ, f))
proof
  sorry

-- Markov's inequality (Mathlib's mul_meas_ge_le_lintegral₀ /
-- meas_le_lintegral₀).
theorem lintegral.markov (X μ f c : Set)
  requires measure : Measure(X, μ)
  requires measurable : Measurable(f, X, ennMeasurableSpace)
  requires member : c ∈ ennreal
  shows EnnLe(ennMul(c, μ(ennGeSet(f, MeasurableSpace.carrier(X), c))),
    lintegral(X, μ, f))
proof
  have space := Measure.space with measure
  have values : EnnValued(X, f)
    unfold EnnValued
    unfold MapsInto
    intros x hx
    have m := Measurable.maps with measurable, hx
    rw ennMeasurableSpace.carrier at m
    exact m
  have Em := MeasurableSet.lint_ge with measurable, member
  have whole := MeasurablePartition.whole with space
  have one : MeasurableSpace.carrier(X) ∈ {MeasurableSpace.carrier(X)} by simp
  have sets : ∀ C ∈ {MeasurableSpace.carrier(X)}, MeasurableSet(X, constantOn({MeasurableSpace.carrier(X)}, ennGeSet(f, MeasurableSpace.carrier(X), c))(C))
    intros C hC
    rw constantOn.apply with hC
    exact Em
  have inside : ∀ C ∈ {MeasurableSpace.carrier(X)}, constantOn({MeasurableSpace.carrier(X)}, ennGeSet(f, MeasurableSpace.carrier(X), c))(C) ⊆ C
    intros C hC x hx
    rw constantOn.apply with hC at hx
    simp at hC
    rw hC
    unfold ennGeSet at hx
    simp at hx
    exact hx.left
  have bvalues : ∀ C ∈ {MeasurableSpace.carrier(X)}, constantOn({MeasurableSpace.carrier(X)}, c)(C) ∈ ennreal
    intros C hC
    rw constantOn.apply with hC
    exact member
  have bound : ∀ C ∈ {MeasurableSpace.carrier(X)}, ∀ x ∈ constantOn({MeasurableSpace.carrier(X)}, ennGeSet(f, MeasurableSpace.carrier(X), c))(C), EnnLe(constantOn({MeasurableSpace.carrier(X)}, c)(C), f(x))
    intros C hC x hx
    rw constantOn.apply with hC at hx
    rw constantOn.apply with hC
    unfold ennGeSet at hx
    simp at hx
    exact hx.right
  have terms : ∀ C ∈ {MeasurableSpace.carrier(X)}, constantOn({MeasurableSpace.carrier(X)}, ennMul(c, μ(ennGeSet(f, MeasurableSpace.carrier(X), c))))(C) = ennMul(constantOn({MeasurableSpace.carrier(X)}, c)(C), μ(constantOn({MeasurableSpace.carrier(X)}, ennGeSet(f, MeasurableSpace.carrier(X), c))(C)))
    intros C hC
    rw constantOn.apply at {MeasurableSpace.carrier(X)}, ennMul(c, μ(ennGeSet(f, MeasurableSpace.carrier(X), c))), C with hC
    rw constantOn.apply at {MeasurableSpace.carrier(X)}, c, C with hC
    rw constantOn.apply at {MeasurableSpace.carrier(X)}, ennGeSet(f, MeasurableSpace.carrier(X), c), C with hC
  have gen := lintegral.lint_lower with measure, values, whole, sets, inside, bvalues, bound, terms
  have v := ennMul.member with member, (Measure.member with measure, Em)
  have cv : constantOn({MeasurableSpace.carrier(X)}, ennMul(c, μ(ennGeSet(f, MeasurableSpace.carrier(X), c))))(MeasurableSpace.carrier(X)) ∈ ennreal
    rw constantOn.apply with one
    exact v
  rw ennFiniteSum.singleton with cv at gen
  rw constantOn.apply with one at gen
  exact gen

-- Section: Vanishing and finiteness
-- Mathlib's lintegral_eq_zero_iff: for measurable f, ∫⁻ f = 0 exactly when
-- f = 0 almost everywhere.
theorem lintegral.eq_zero_iff (X μ f : Set)
  requires measure : Measure(X, μ)
  requires measurable : Measurable(f, X, ennMeasurableSpace)
  shows lintegral(X, μ, f) = realZero ↔
    AEEqual(X, μ, f, constantOn(MeasurableSpace.carrier(X), realZero))
proof
  have space := Measure.space with measure
  have vF : ∀ x ∈ MeasurableSpace.carrier(X), f(x) ∈ ennreal
    intros x hx
    have m := Measurable.maps with measurable, hx
    rw ennMeasurableSpace.carrier at m
    exact m
  have values : EnnValued(X, f)
    unfold EnnValued
    unfold MapsInto
    exact vF
  have zm := ennreal.zero_member
  have vZ : EnnValued(X, constantOn(MeasurableSpace.carrier(X), realZero))
    unfold EnnValued
    unfold MapsInto
    intros x hx
    rw constantOn.apply with hx
    exact zm
  constructor
  . intro hz
    have ck : ∀ k ∈ ℕ, R[realOne - lintRatio(k)] ∈ ℝ ∧ realZero < R[realOne - lintRatio(k)]
      intros k hk
      obtain ⟨rR, r0, r1, rM⟩ := lintRatio.facts with hk
      have cR : R[realOne - lintRatio(k)] ∈ ℝ by typecheck
      have cP : realZero < R[realOne - lintRatio(k)] by linarith
      exact ⟨cR, cP⟩
    have nullK : ∀ k ∈ ℕ, MeasurableSet(X, lintGeSets(f, X)(k)) ∧ μ(lintGeSets(f, X)(k)) = realZero
      intros k hk
      rw lintGeSets.apply with hk
      obtain ⟨cR, cP⟩ := ck with k, hk
      have c0 : realZero ≤ R[realOne - lintRatio(k)] by linarith
      have cM := ennreal.of_real with cR, c0
      have mk := lintegral.markov with measure, measurable, cM
      rw hz at mk
      have Em := MeasurableSet.lint_ge with measurable, cM
      have muM := Measure.member with measure, Em
      have pz := EnnLe.antisymmetric with mk, (EnnLe.zero with (ennMul.member with cM, muM))
      have mz : μ(ennGeSet(f, MeasurableSpace.carrier(X), R[realOne - lintRatio(k)])) = realZero
        by_contra nz
        have cne : R[realOne - lintRatio(k)] ≠ realZero
          intro e
          rw e at cP
          linarith
        have nn := ennMul.nonzero with cM, muM, cne, nz
        exact nn with pz
      exact ⟨Em, mz⟩
    have Km : ∀ k ∈ ℕ, MeasurableSet(X, lintGeSets(f, X)(k))
      intros k hk
      have nk := nullK with k, hk
      exact nk.left
    have um := MeasurableSet.sequence_union with space, Km
    have ule := Measure.sequence_union_le with measure, Km
    have zs : ∀ k ∈ ℕ, measureSequence(μ, lintGeSets(f, X))(k) = realZero
      intros k hk
      rw measureSequence.apply with hk
      have nk := nullK with k, hk
      exact nk.right
    rw ennTsum.zero with zs at ule
    have uz := EnnLe.antisymmetric with ule, (EnnLe.zero with (Measure.member with measure, um))
    have nu : NullSet(X, μ, sequenceUnion(lintGeSets(f, X)))
      unfold NullSet
      have um2 := um
      unfold MeasurableSet at um2
      refine ⟨sequenceUnion(lintGeSets(f, X)), um2, ?_, uz⟩
      intros x hx
      exact hx
    unfold AEEqual
    unfold AlmostEverywhere
    apply NullSet.subset with nu
    intros x hx
    obtain ⟨xX, notEq⟩ := difference.membership.forward with hx
    have fx := vF with x, xX
    have ne : f(x) ≠ realZero
      intro e
      apply notEq
      have c := constantOn.apply at MeasurableSpace.carrier(X), realZero, x with xX
      unfold equalizer
      simp [xX]
    have zN : ∅ ∈ ℕ by typecheck
    have pick : ∃ k ∈ ℕ, EnnLe(R[realOne - lintRatio(k)], f(x))
      by_cases ft : f(x) = ennTop
      . obtain ⟨cR, cP⟩ := ck with ∅, zN
        have c0 : realZero ≤ R[realOne - lintRatio(∅)] by linarith
        have cM := ennreal.of_real with cR, c0
        rw ft
        exact ⟨∅, zN, (EnnLe.top with cM)⟩
      . obtain ⟨fR, f0⟩ := ennreal.finite with fx, ft
        have fP : realZero < f(x)
          by_contra np
          apply ne
          linarith
        obtain ⟨n, hn, near⟩ := lintRatio.near with fR, fP
        obtain ⟨cR, cP⟩ := ck with n, hn
        have c0 : realZero ≤ R[realOne - lintRatio(n)] by linarith
        have l : R[realOne - lintRatio(n)] ≤ (f(x):R) by linarith
        exact ⟨n, hn, (EnnLe.lint_of_real with cR, fR, c0, l)⟩
    obtain ⟨k, hk, kle⟩ := pick
    have xk : x ∈ lintGeSets(f, X)(k)
      rw lintGeSets.apply with hk
      unfold ennGeSet
      simp [xX, kle]
    have inV : lintGeSets(f, X)(k) ∈ valuesOn(lintGeSets(f, X), ℕ) := valuesOn.membership.backward with ⟨k, hk, rfl⟩
    unfold sequenceUnion
    exact union.membership.backward with ⟨lintGeSets(f, X)(k), inV, xk⟩
  . intro ae
    have c := lintegral.congr_ae with measure, values, vZ, ae
    rw c
    exact lintegral.zero with measure

-- Mathlib's ae_lt_top: a measurable map of finite integral is finite
-- almost everywhere.
theorem lintegral.ae_finite (X μ f : Set)
  requires measure : Measure(X, μ)
  requires measurable : Measurable(f, X, ennMeasurableSpace)
  requires finite : lintegral(X, μ, f) ≠ ennTop
  shows NullSet(X, μ, ennTopSet(f, MeasurableSpace.carrier(X)))
proof
  have space := Measure.space with measure
  have top := ennreal.top_member
  have mk := lintegral.markov with measure, measurable, top
  have Em := MeasurableSet.lint_ge with measurable, top
  have same : ennTopSet(f, MeasurableSpace.carrier(X)) = ennGeSet(f, MeasurableSpace.carrier(X), ennTop)
    ext x
    constructor
    . intro h
      unfold ennTopSet at h
      simp at h
      have fx : f(x) ∈ ennreal
        rw h.right
        exact top
      have r := EnnLe.reflexive with fx
      rw h.right at r
      unfold ennGeSet
      simp [h.left, r]
    . intro h
      unfold ennGeSet at h
      simp at h
      have e := EnnLe.top_eq with h.right
      unfold ennTopSet
      simp [h.left, e]
  unfold NullSet
  rw same
  unfold MeasurableSet at Em
  refine ⟨ennGeSet(f, MeasurableSpace.carrier(X), ennTop), Em, ?_, ?_⟩
  . intros x hx
    exact hx
  . by_contra nz
    have Em2 : MeasurableSet(X, ennGeSet(f, MeasurableSpace.carrier(X), ennTop))
      unfold MeasurableSet
      exact Em
    have tz : ennTop = ennTop
      rfl
    rw ennMul.top_left with tz, nz at mk
    have e := EnnLe.top_eq with mk
    exact finite with e

-- Mathlib's exists_notMem_null_le_lintegral / the mean value bound: some
-- point outside any null set has f(x) ≤ ∫⁻ f / μ(X), stated for a
-- probability measure.
theorem lintegral.exists_le (X μ f N : Set)
  requires probability : ProbabilityMeasure(X, μ)
  requires measurable : Measurable(f, X, ennMeasurableSpace)
  requires null : NullSet(X, μ, N)
  shows ∃ x ∈ MeasurableSpace.carrier(X), x ∉ N ∧ EnnLe(f(x), lintegral(X, μ, f))
proof
  sorry

-- Section: Integrals over sets
theorem setLIntegral.whole (X μ f : Set)
  requires measure : Measure(X, μ)
  shows setLIntegral(X, μ, f, MeasurableSpace.carrier(X)) = lintegral(X, μ, f)
proof
  unfold setLIntegral
  rw restrictMeasure.whole with measure

-- Mathlib's setLIntegral_const and setLIntegral_one.
theorem setLIntegral.const (X μ A c : Set)
  requires measure : Measure(X, μ)
  requires set : MeasurableSet(X, A)
  requires member : c ∈ ennreal
  shows setLIntegral(X, μ, constantOn(MeasurableSpace.carrier(X), c), A) = ennMul(c, μ(A))
proof
  have space := Measure.space with measure
  have rm := restrictMeasure.measure with measure, set
  unfold setLIntegral
  rw lintegral.const with rm, member
  have u := MeasurableSet.univ with space
  rw restrictMeasure.apply with measure, set, u
  have AX := MeasurableSet.subset with space, set
  have same : MeasurableSpace.carrier(X) ∩ A = A
    ext x
    constructor
    . intro h
      obtain ⟨a, b⟩ := intersection.membership.forward with h
      exact b
    . intro h
      exact intersection.membership.backward with (AX with x, h), h
  rw same

-- Mathlib's setLIntegral_le_lintegral and lintegral_mono_set.
theorem setLIntegral.le_lintegral (X μ f A : Set)
  requires measure : Measure(X, μ)
  requires values : EnnValued(X, f)
  shows EnnLe(setLIntegral(X, μ, f, A), lintegral(X, μ, f))
proof
  have vF : ∀ x ∈ MeasurableSpace.carrier(X), f(x) ∈ ennreal
    unfold EnnValued at values
    unfold MapsInto at values
    exact values
  have vN : ∀ S ∈ MeasurableSpace.sets(X), restrictMeasure(X, μ, A)(S) ∈ ennreal
    intros S hS
    rw restrictMeasure.value with hS
    exact measureOf.member with measure
  have vM : ∀ S ∈ MeasurableSpace.sets(X), μ(S) ∈ ennreal
    intros S hS
    have mS : MeasurableSet(X, S)
      unfold MeasurableSet
      exact hS
    exact Measure.member with measure, mS
  have le : ∀ S ∈ MeasurableSpace.sets(X), EnnLe(restrictMeasure(X, μ, A)(S), μ(S))
    intros S hS
    rw restrictMeasure.value with hS
    have mS : MeasurableSet(X, S)
      unfold MeasurableSet
      exact hS
    have sub : S ∩ A ⊆ S
      intros x hx
      obtain ⟨a, b⟩ := intersection.membership.forward with hx
      exact a
    have m := measureOf.mono with measure, sub
    rw measureOf.eq_of_measurable with measure, mS at m
    exact m
  unfold setLIntegral
  exact lintegral.mono_measure with vF, vN, vM, le

theorem setLIntegral.mono_set (X μ f A B : Set)
  requires measure : Measure(X, μ)
  requires values : EnnValued(X, f)
  requires inside : A ⊆ B
  shows EnnLe(setLIntegral(X, μ, f, A), setLIntegral(X, μ, f, B))
proof
  have vF : ∀ x ∈ MeasurableSpace.carrier(X), f(x) ∈ ennreal
    unfold EnnValued at values
    unfold MapsInto at values
    exact values
  have vA : ∀ S ∈ MeasurableSpace.sets(X), restrictMeasure(X, μ, A)(S) ∈ ennreal
    intros S hS
    rw restrictMeasure.value with hS
    exact measureOf.member with measure
  have vB : ∀ S ∈ MeasurableSpace.sets(X), restrictMeasure(X, μ, B)(S) ∈ ennreal
    intros S hS
    rw restrictMeasure.value with hS
    exact measureOf.member with measure
  have le : ∀ S ∈ MeasurableSpace.sets(X), EnnLe(restrictMeasure(X, μ, A)(S), restrictMeasure(X, μ, B)(S))
    intros S hS
    rw restrictMeasure.value at X, μ, A, S with hS
    rw restrictMeasure.value at X, μ, B, S with hS
    have sub : S ∩ A ⊆ S ∩ B
      intros x hx
      obtain ⟨a, b⟩ := intersection.membership.forward with hx
      exact intersection.membership.backward with a, (inside with x, b)
    exact measureOf.mono with measure, sub
  unfold setLIntegral
  exact lintegral.mono_measure with vF, vA, vB, le

-- Mathlib's setLIntegral_congr_fun and setLIntegral_mono.
theorem setLIntegral.mono (X μ f g A : Set)
  requires measure : Measure(X, μ)
  requires set : MeasurableSet(X, A)
  requires valuesF : EnnValued(X, f)
  requires valuesG : EnnValued(X, g)
  requires le : ∀ x ∈ A, EnnLe(f(x), g(x))
  shows EnnLe(setLIntegral(X, μ, f, A), setLIntegral(X, μ, g, A))
proof
  have space := Measure.space with measure
  have rm := restrictMeasure.measure with measure, set
  have vF : ∀ x ∈ MeasurableSpace.carrier(X), f(x) ∈ ennreal
    unfold EnnValued at valuesF
    unfold MapsInto at valuesF
    exact valuesF
  unfold setLIntegral
  apply lintegral.le_of_all with (lintegral.member with rm)
  intros P partition
  have sets : ∀ C ∈ P, MeasurableSet(X, interWith(P, A)(C))
    intros C hC
    rw interWith.apply with hC
    have pc := MeasurablePartition.pieces with space, partition, hC
    exact MeasurableSet.inter with space, pc.left, set
  have inside : ∀ C ∈ P, interWith(P, A)(C) ⊆ C
    intros C hC x hx
    rw interWith.apply with hC at hx
    obtain ⟨a, b⟩ := intersection.membership.forward with hx
    exact a
  have bvalues : ∀ C ∈ P, lintInfs(f, P)(C) ∈ ennreal
    intros C hC
    rw lintInfs.apply with hC
    have pc := MeasurablePartition.pieces with space, partition, hC
    have vC : ∀ x ∈ C, f(x) ∈ ennreal
      intros x hx
      exact vF with x, (pc.right with x, hx)
    exact ennInfOn.member with vC
  have bound : ∀ C ∈ P, ∀ x ∈ interWith(P, A)(C), EnnLe(lintInfs(f, P)(C), g(x))
    intros C hC x hx
    rw interWith.apply with hC at hx
    rw lintInfs.apply with hC
    obtain ⟨xC, xA⟩ := intersection.membership.forward with hx
    have pc := MeasurablePartition.pieces with space, partition, hC
    have vC : ∀ y ∈ C, f(y) ∈ ennreal
      intros y hy
      exact vF with y, (pc.right with y, hy)
    have l1 := ennInfOn.le_value with vC, xC
    exact EnnLe.transitive with l1, (le with x, xA)
  have terms : ∀ C ∈ P, partitionTerms(restrictMeasure(X, μ, A), f, P)(C) = ennMul(lintInfs(f, P)(C), restrictMeasure(X, μ, A)(interWith(P, A)(C)))
    intros C hC
    rw partitionTerms.apply with hC
    rw lintInfs.apply with hC
    rw interWith.apply with hC
    have pc := MeasurablePartition.pieces with space, partition, hC
    have Cs := pc.left
    unfold MeasurableSet at Cs
    have CA := MeasurableSet.inter with space, pc.left, set
    unfold MeasurableSet at CA
    rw restrictMeasure.value at X, μ, A, C with Cs
    rw restrictMeasure.value at X, μ, A, C ∩ A with CA
    have same : C ∩ A ∩ A = C ∩ A
      ext x
      constructor
      . intro h
        simp at h
        simp [h]
      . intro h
        simp at h
        simp [h]
    rw same
  have gen := lintegral.lint_lower with rm, valuesG, partition, sets, inside, bvalues, bound, terms
  unfold lowerSum
  exact gen

theorem setLIntegral.congr_fun (X μ f g A : Set)
  requires measure : Measure(X, μ)
  requires set : MeasurableSet(X, A)
  requires valuesF : EnnValued(X, f)
  requires valuesG : EnnValued(X, g)
  requires agree : ∀ x ∈ A, f(x) = g(x)
  shows setLIntegral(X, μ, f, A) = setLIntegral(X, μ, g, A)
proof
  have le1 : ∀ x ∈ A, EnnLe(f(x), g(x))
    intros x hx
    rw agree with x, hx
    have space := Measure.space with measure
    have AX := MeasurableSet.subset with space, set
    unfold EnnValued at valuesG
    unfold MapsInto at valuesG
    exact EnnLe.reflexive with (valuesG with x, (AX with x, hx))
  have le2 : ∀ x ∈ A, EnnLe(g(x), f(x))
    intros x hx
    rw agree with x, hx
    have space := Measure.space with measure
    have AX := MeasurableSet.subset with space, set
    unfold EnnValued at valuesG
    unfold MapsInto at valuesG
    exact EnnLe.reflexive with (valuesG with x, (AX with x, hx))
  have m1 := setLIntegral.mono with measure, set, valuesF, valuesG, le1
  have m2 := setLIntegral.mono with measure, set, valuesG, valuesF, le2
  exact EnnLe.antisymmetric with m1, m2

-- Mathlib's lintegral_iUnion: over a disjoint sequence of measurable sets.
theorem setLIntegral.sequence_union (X μ f S : Set)
  requires measure : Measure(X, μ)
  requires values : EnnValued(X, f)
  requires sets : ∀ n ∈ ℕ, MeasurableSet(X, S(n))
  requires disjoint : PairwiseDisjointSequence(S)
  shows setLIntegral(X, μ, f, sequenceUnion(S)) =
    ennTsum(setLIntegralSequence(X, μ, f, S), ℕ)
proof
  sorry

-- Mathlib's lintegral_iUnion_le without disjointness.
theorem setLIntegral.sequence_union_le (X μ f S : Set)
  requires measure : Measure(X, μ)
  requires values : EnnValued(X, f)
  requires sets : ∀ n ∈ ℕ, MeasurableSet(X, S(n))
  shows EnnLe(setLIntegral(X, μ, f, sequenceUnion(S)),
    ennTsum(setLIntegralSequence(X, μ, f, S), ℕ))
proof
  sorry

-- Mathlib's lintegral_union and lintegral_add_compl.
theorem setLIntegral.union (X μ f A B : Set)
  requires measure : Measure(X, μ)
  requires values : EnnValued(X, f)
  requires setA : MeasurableSet(X, A)
  requires setB : MeasurableSet(X, B)
  requires disjoint : Disjoint(A, B)
  shows setLIntegral(X, μ, f, A ∪ B) =
    ennAdd(setLIntegral(X, μ, f, A), setLIntegral(X, μ, f, B))
proof
  sorry

theorem setLIntegral.add_compl (X μ f A : Set)
  requires measure : Measure(X, μ)
  requires values : EnnValued(X, f)
  requires set : MeasurableSet(X, A)
  shows ennAdd(setLIntegral(X, μ, f, A),
      setLIntegral(X, μ, f, MeasurableSpace.carrier(X) ∖ A)) = lintegral(X, μ, f)
proof
  sorry

-- Mathlib's setLIntegral_eq_of_support_subset.
theorem setLIntegral.eq_of_support (X μ f A : Set)
  requires measure : Measure(X, μ)
  requires values : EnnValued(X, f)
  requires set : MeasurableSet(X, A)
  requires vanishes : ∀ x ∈ MeasurableSpace.carrier(X) ∖ A, f(x) = realZero
  shows setLIntegral(X, μ, f, A) = lintegral(X, μ, f)
proof
  have space := Measure.space with measure
  have rm := restrictMeasure.measure with measure, set
  have vF : ∀ x ∈ MeasurableSpace.carrier(X), f(x) ∈ ennreal
    unfold EnnValued at values
    unfold MapsInto at values
    exact values
  have l1 := setLIntegral.le_lintegral at _, _, _, A with measure, values
  have l2 : EnnLe(lintegral(X, μ, f), setLIntegral(X, μ, f, A))
    unfold setLIntegral
    apply lintegral.le_of_all with (lintegral.member with rm)
    intros P partition
    have sets : ∀ C ∈ P, MeasurableSet(X, interWith(P, A)(C))
      intros C hC
      rw interWith.apply with hC
      have pc := MeasurablePartition.pieces with space, partition, hC
      exact MeasurableSet.inter with space, pc.left, set
    have inside : ∀ C ∈ P, interWith(P, A)(C) ⊆ C
      intros C hC x hx
      rw interWith.apply with hC at hx
      obtain ⟨a, b⟩ := intersection.membership.forward with hx
      exact a
    have bvalues : ∀ C ∈ P, lintInfs(f, P)(C) ∈ ennreal
      intros C hC
      rw lintInfs.apply with hC
      have pc := MeasurablePartition.pieces with space, partition, hC
      have vC : ∀ x ∈ C, f(x) ∈ ennreal
        intros x hx
        exact vF with x, (pc.right with x, hx)
      exact ennInfOn.member with vC
    have bound : ∀ C ∈ P, ∀ x ∈ interWith(P, A)(C), EnnLe(lintInfs(f, P)(C), f(x))
      intros C hC x hx
      rw interWith.apply with hC at hx
      rw lintInfs.apply with hC
      obtain ⟨xC, xA⟩ := intersection.membership.forward with hx
      have pc := MeasurablePartition.pieces with space, partition, hC
      have vC : ∀ y ∈ C, f(y) ∈ ennreal
        intros y hy
        exact vF with y, (pc.right with y, hy)
      exact ennInfOn.le_value with vC, xC
    have terms : ∀ C ∈ P, partitionTerms(μ, f, P)(C) = ennMul(lintInfs(f, P)(C), restrictMeasure(X, μ, A)(interWith(P, A)(C)))
      intros C hC
      rw partitionTerms.apply with hC
      rw lintInfs.apply with hC
      rw interWith.apply with hC
      have pc := MeasurablePartition.pieces with space, partition, hC
      have CA := MeasurableSet.inter with space, pc.left, set
      have CA2 := CA
      unfold MeasurableSet at CA2
      rw restrictMeasure.value at X, μ, A, C ∩ A with CA2
      have same : C ∩ A ∩ A = C ∩ A
        ext x
        constructor
        . intro h
          simp at h
          simp [h]
        . intro h
          simp at h
          simp [h]
      rw same
      rw measureOf.eq_of_measurable with measure, CA
      have vC : ∀ y ∈ C, f(y) ∈ ennreal
        intros y hy
        exact vF with y, (pc.right with y, hy)
      have iM := ennInfOn.member with vC
      by_cases sub : C ⊆ A
      . have same2 : C ∩ A = C
          ext x
          constructor
          . intro h
            simp at h
            exact h.left
          . intro h
            simp [h, (sub with x, h)]
        rw same2
      . have ex : ∃ x ∈ C, x ∉ A
          by_contra nex
          apply sub
          intros y hy
          by_contra nA
          apply nex
          exact ⟨y, hy, nA⟩
        obtain ⟨x, xC, xA⟩ := ex
        have xX := pc.right with x, xC
        have xd : x ∈ MeasurableSpace.carrier(X) ∖ A by simp [xX, xA]
        have z := vanishes with x, xd
        have l := ennInfOn.le_value with vC, xC
        rw z at l
        have i0 := EnnLe.antisymmetric with l, (EnnLe.zero with iM)
        rw ennMul.zero_left with i0, (Measure.member with measure, pc.left)
        rw ennMul.zero_left with i0, (Measure.member with measure, CA)
    have gen := lintegral.lint_lower with rm, values, partition, sets, inside, bvalues, bound, terms
    unfold lowerSum
    exact gen
  exact EnnLe.antisymmetric with l1, l2

-- Mathlib's setLIntegral_pos_iff: for measurable f, ∫⁻_A f > 0 exactly
-- when f is positive on a part of A of positive measure.
theorem setLIntegral.pos_iff (X μ f A : Set)
  requires measure : Measure(X, μ)
  requires measurable : Measurable(f, X, ennMeasurableSpace)
  requires set : MeasurableSet(X, A)
  shows setLIntegral(X, μ, f, A) ≠ realZero ↔
    μ(A ∩ ennGtSet(f, MeasurableSpace.carrier(X), realZero)) ≠ realZero
proof
  sorry

-- Section: Change of measure
-- Mathlib's lintegral_map: integrating against a push-forward.
theorem lintegral.map (g f X μ Y : Set)
  requires measure : Measure(X, μ)
  requires measurableF : Measurable(f, X, Y)
  requires measurableG : Measurable(g, Y, ennMeasurableSpace)
  shows lintegral(Y, mapMeasure(f, X, μ, Y), g) =
    lintegral(X, μ, composeOn(g, f, MeasurableSpace.carrier(X)))
proof
  sorry

-- Mathlib's lintegral_map_equiv: no measurability of g along an
-- equivalence; and MeasurePreserving.lintegral_comp_emb along an embedding.
theorem lintegral.map_equiv (g f X μ Y : Set)
  requires measure : Measure(X, μ)
  requires equivalence : MeasurableEquiv(f, X, Y)
  requires values : EnnValued(Y, g)
  shows lintegral(Y, mapMeasure(f, X, μ, Y), g) =
    lintegral(X, μ, composeOn(g, f, MeasurableSpace.carrier(X)))
proof
  sorry

-- Mathlib's MeasurePreserving.lintegral_comp and lintegral_comp_emb.
theorem MeasurePreserving.lintegral_comp (g f X μ Y ν : Set)
  requires preserving : MeasurePreserving(f, X, μ, Y, ν)
  requires measurable : Measurable(g, Y, ennMeasurableSpace)
  shows lintegral(X, μ, composeOn(g, f, MeasurableSpace.carrier(X))) = lintegral(Y, ν, g)
proof
  sorry

theorem MeasurePreserving.lintegral_comp_embedding (g f X μ Y ν : Set)
  requires preserving : MeasurePreserving(f, X, μ, Y, ν)
  requires embedding : MeasurableEmbedding(f, X, Y)
  requires values : EnnValued(Y, g)
  shows lintegral(X, μ, composeOn(g, f, MeasurableSpace.carrier(X))) = lintegral(Y, ν, g)
proof
  sorry

-- Mathlib's MeasurePreserving.setLIntegral_comp_preimage(_emb).
theorem MeasurePreserving.setLIntegral_comp_preimage (g f X μ Y ν B : Set)
  requires preserving : MeasurePreserving(f, X, μ, Y, ν)
  requires measurable : Measurable(g, Y, ennMeasurableSpace)
  requires set : MeasurableSet(Y, B)
  shows setLIntegral(X, μ, composeOn(g, f, MeasurableSpace.carrier(X)),
      functionPreimage(f, MeasurableSpace.carrier(X), B)) = setLIntegral(Y, ν, g, B)
proof
  sorry

-- Mathlib's lintegral_smul_measure and lintegral_sum_measure.
theorem lintegral.smul_measure (X μ c f : Set)
  requires measure : Measure(X, μ)
  requires member : c ∈ ennreal
  requires values : EnnValued(X, f)
  shows lintegral(X, smulMeasure(c, X, μ), f) = ennMul(c, lintegral(X, μ, f))
proof
  sorry

theorem lintegral.sum_measure (X m f : Set)
  requires measures : ∀ n ∈ ℕ, Measure(X, m(n))
  requires values : EnnValued(X, f)
  shows lintegral(X, sumMeasure(X, m), f) =
    ennTsum(lintegralOverMeasures(X, m, f), ℕ)
proof
  sorry

-- Mathlib's lintegral_dirac and lintegral_zero_measure.
theorem lintegral.dirac (X a f : Set)
  requires space : MeasurableSpace(X)
  requires member : a ∈ MeasurableSpace.carrier(X)
  requires measurable : Measurable(f, X, ennMeasurableSpace)
  shows lintegral(X, diracMeasure(X, a), f) = f(a)
proof
  sorry

theorem lintegral.zero_measure (X f : Set)
  requires space : MeasurableSpace(X)
  requires values : EnnValued(X, f)
  shows lintegral(X, zeroMeasure(X), f) = realZero
proof
  have zm := zeroMeasure.measure with space
  have u := MeasurableSet.univ with space
  unfold MeasurableSet at u
  have zX : zeroMeasure(X)(MeasurableSpace.carrier(X)) = realZero
    unfold zeroMeasure
    exact constGraph.apply at MeasurableSpace.sets(X), realZero, MeasurableSpace.carrier(X) with u
  have top := ennreal.top_member
  have vF : ∀ x ∈ MeasurableSpace.carrier(X), EnnLe(f(x), ennTop)
    intros x hx
    unfold EnnValued at values
    unfold MapsInto at values
    exact EnnLe.top with (values with x, hx)
  have le := lintegral.le_const with zm, values, top, vF
  rw zX at le
  have z0 : realZero = realZero
    rfl
  rw ennMul.zero_right with top, z0 at le
  have m := lintegral.member at _, _, f with zm
  exact EnnLe.antisymmetric with le, (EnnLe.zero with m)

-- Mathlib's lintegral_count: against the counting measure the integral
-- is the sum over the points, when singletons are measurable.
theorem lintegral.count (X f : Set)
  requires space : MeasurableSpace(X)
  requires singletons : ∀ x ∈ MeasurableSpace.carrier(X), MeasurableSet(X, {x})
  requires values : EnnValued(X, f)
  shows lintegral(X, countMeasure(X), f) = ennTsum(f, MeasurableSpace.carrier(X))
proof
  sorry

-- Mathlib's lintegral_restrict on a measurable set and
-- lintegral_subtype_comap: integrating over A against μ is integrating
-- over the subspace A against the restriction.
theorem setLIntegral.subspace (X μ f A : Set)
  requires measure : Measure(X, μ)
  requires set : MeasurableSet(X, A)
  requires values : EnnValued(X, f)
  shows setLIntegral(X, μ, f, A) = lintegral(measurableSubspace(X, A), restrictTo(μ, 𝒫(A)), f)
proof
  sorry

-- Section: Measures with density
theorem withDensity.measure (X μ f : Set)
  requires measure : Measure(X, μ)
  requires measurable : Measurable(f, X, ennMeasurableSpace)
  shows Measure(X, withDensity(X, μ, f))
proof
  sorry

-- Mathlib's withDensity_apply.
theorem withDensity.apply (X μ f A : Set)
  requires measure : Measure(X, μ)
  requires measurable : Measurable(f, X, ennMeasurableSpace)
  requires set : MeasurableSet(X, A)
  shows withDensity(X, μ, f)(A) = setLIntegral(X, μ, f, A)
proof
  sorry

-- Mathlib's lintegral_withDensity_eq_lintegral_mul.
theorem lintegral.withDensity (X μ f g : Set)
  requires measure : Measure(X, μ)
  requires measurableF : Measurable(f, X, ennMeasurableSpace)
  requires measurableG : Measurable(g, X, ennMeasurableSpace)
  shows lintegral(X, withDensity(X, μ, f), g) =
    lintegral(X, μ, ennMulOn(f, g, MeasurableSpace.carrier(X)))
proof
  sorry

-- Mathlib's withDensity_indicator_one... in the form: density 1_A is the
-- restriction to A.
theorem withDensity.indicator_one (X μ A : Set)
  requires measure : Measure(X, μ)
  requires set : MeasurableSet(X, A)
  shows withDensity(X, μ, indicatorOn(MeasurableSpace.carrier(X), A, realOne, realZero)) =
    restrictMeasure(X, μ, A)
proof
  sorry

-- Mathlib's isFiniteMeasure_withDensity.
theorem withDensity.finite (X μ f : Set)
  requires measure : Measure(X, μ)
  requires measurable : Measurable(f, X, ennMeasurableSpace)
  requires finite : lintegral(X, μ, f) ≠ ennTop
  shows FiniteMeasure(X, withDensity(X, μ, f))
proof
  sorry

-- Mathlib's ae_withDensity_iff: a null set for μ is null for f · μ.
theorem withDensity.absolutely_continuous (X μ f N : Set)
  requires measure : Measure(X, μ)
  requires measurable : Measurable(f, X, ennMeasurableSpace)
  requires null : NullSet(X, μ, N)
  shows NullSet(X, withDensity(X, μ, f), N)
proof
  sorry

-- Section: Determination by integrals
-- Mathlib's Measure.ext_of_lintegral.
theorem Measure.ext_of_lintegral (X μ ν : Set)
  requires first : Measure(X, μ)
  requires second : Measure(X, ν)
  requires agree : ∀ f, Measurable(f, X, ennMeasurableSpace) →
    lintegral(X, μ, f) = lintegral(X, ν, f)
  shows μ = ν
proof
  sorry

-- Mathlib's ae_eq_of_forall_setLIntegral_eq_of_sigmaFinite.
theorem AEEqual.of_setLIntegral (X μ f g : Set)
  requires sigma : SigmaFinite(X, μ)
  requires measurableF : Measurable(f, X, ennMeasurableSpace)
  requires measurableG : Measurable(g, X, ennMeasurableSpace)
  requires agree : ∀ A ∈ MeasurableSpace.sets(X), μ(A) ≠ ennTop →
    setLIntegral(X, μ, f, A) = setLIntegral(X, μ, g, A)
  shows AEEqual(X, μ, f, g)
proof
  sorry

-- Section: Inequalities
-- The Cauchy–Schwarz inequality for lower integrals (Mathlib's
-- ENNReal.lintegral_mul_le_Lp_mul_Lq at p = q = 2).
theorem lintegral.cauchy_schwarz (X μ f g : Set)
  requires measure : Measure(X, μ)
  requires measurableF : Measurable(f, X, ennMeasurableSpace)
  requires measurableG : Measurable(g, X, ennMeasurableSpace)
  shows EnnLe(
    ennMul(lintegral(X, μ, ennMulOn(f, g, MeasurableSpace.carrier(X))),
      lintegral(X, μ, ennMulOn(f, g, MeasurableSpace.carrier(X)))),
    ennMul(lintegral(X, μ, ennMulOn(f, f, MeasurableSpace.carrier(X))),
      lintegral(X, μ, ennMulOn(g, g, MeasurableSpace.carrier(X)))))
proof
  sorry

end LowerIntegral
