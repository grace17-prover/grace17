  sorry

theorem Measurable.complex_neg (f h X : Set)
  requires measurable : Measurable(f, X, complexMeasurableSpace)
  requires negation : ∀ x ∈ MeasurableSpace.carrier(X), h(x) = ℂ[-f(x)]
  shows Measurable(h, X, complexMeasurableSpace)
proof
  sorry

theorem Measurable.complex_conj (f h X : Set)
  requires measurable : Measurable(f, X, complexMeasurableSpace)
  requires conjugate : ∀ x ∈ MeasurableSpace.carrier(X), h(x) = complexConj(f(x))
  shows Measurable(h, X, complexMeasurableSpace)
proof
  sorry

theorem Measurable.complex_abs (f h X : Set)
  requires measurable : Measurable(f, X, complexMeasurableSpace)
  requires absolute : ∀ x ∈ MeasurableSpace.carrier(X), h(x) = complexAbs(f(x))
  shows Measurable(h, X, realMeasurableSpace)
proof
  sorry

theorem Measurable.complex_exp (f h X : Set)
  requires measurable : Measurable(f, X, complexMeasurableSpace)
  requires exponential : ∀ x ∈ MeasurableSpace.carrier(X), h(x) = complexExp(f(x))
  shows Measurable(h, X, complexMeasurableSpace)
proof
  sorry

theorem Measurable.complex_limit (u f X : Set)
  requires measurable : ∀ n ∈ ℕ, Measurable(u(n), X, complexMeasurableSpace)
  requires maps : MapsInto(f, MeasurableSpace.carrier(X), complexCarrier)
  requires limit : ∀ x ∈ MeasurableSpace.carrier(X),
    Tendsto(familyAt(u, ℕ, x), ℕ, natAtTop, nhds(complexSpace, f(x)))
  shows Measurable(f, X, complexMeasurableSpace)
proof
  sorry

-- A finite sum of measurable complex maps (Finset.measurable_sum).
theorem Measurable.complex_finite_sum (X F u h : Set)
  requires finite : Finite(F)
  requires measurable : ∀ i ∈ F, Measurable(u(i), X, complexMeasurableSpace)
  requires sum : ∀ x ∈ MeasurableSpace.carrier(X),
    h(x) = groupFiniteSum(complexAdditiveGroup, F, familyAt(u, F, x))
  shows Measurable(h, X, complexMeasurableSpace)
proof
  sorry

-- Section: The Borel sets of ℝⁿ
theorem euclideanMeasurableSpace.space (n : Nat)
  shows MeasurableSpace(euclideanMeasurableSpace(n))
proof
  unfold euclideanMeasurableSpace
  unfold piMeasurableSpace
  exact generatedSpace.space at functionSpace(n, MeasurableSpace.carrier(realMeasurableSpace)), cylinders(n, realMeasurableSpace)

theorem euclideanMeasurableSpace.carrier (n : Nat)
  shows MeasurableSpace.carrier(euclideanMeasurableSpace(n)) = functionSpace(n, ℝ)
proof
  unfold euclideanMeasurableSpace
  unfold piMeasurableSpace
  unfold generatedSpace
  rw MeasurableSpace.mk.carrier
  rw realMeasurableSpace.carrier

-- ℝⁿ has countably many coordinates, so the product σ-algebra is the Borel
-- σ-algebra of the Euclidean topology (Mathlib's
-- MeasureTheory.measurableSpace_pi_eq_borel / BorelSpace on Fin n → ℝ).
theorem euclideanMeasurableSpace.borel (n : Nat)
  shows euclideanMeasurableSpace(n) = borelSpace(euclideanTopology(n))
proof
  sorry

-- Mathlib's MeasurableSet.univ_pi: a box product of Borel sets of ℝ.
theorem MeasurableSet.pi (n : Nat, S : Set)
  requires measurable : ∀ i ∈ n, MeasurableSet(realMeasurableSpace, S(i))
  shows MeasurableSet(euclideanMeasurableSpace(n), piSet(n, ℝ, S))
proof
  sorry

-- The coordinates x ↦ x(i) are measurable (Mathlib's measurable_pi_apply).
theorem Measurable.coordinate (n : Nat, i : Set)
  requires member : i ∈ n
  shows Measurable(coordinateMap(functionSpace(n, ℝ), i),
    euclideanMeasurableSpace(n), realMeasurableSpace)
proof
  sorry

-- Mathlib's measurableSet_ball: open and closed balls of ℝⁿ are Borel.
theorem MeasurableSet.euclidean_ball (n : Nat, c : Set, r : Real)
  requires center : c ∈ functionSpace(n, ℝ)
  shows MeasurableSet(euclideanMeasurableSpace(n), euclideanBall(n, c, r))
proof
  sorry

-- Section: The measurable structure of [0, ∞]
theorem ennMeasurableSpace.space
  shows MeasurableSpace(ennMeasurableSpace)
proof
  unfold ennMeasurableSpace
  exact generatedSpace.space at ennreal, ennRays

theorem ennMeasurableSpace.carrier
  shows MeasurableSpace.carrier(ennMeasurableSpace) = ennreal
proof
  unfold ennMeasurableSpace
  unfold generatedSpace
  rw MeasurableSpace.mk.carrier

-- A map into [0, ∞] is measurable when the sets {f > t} are.
theorem Measurable.enn_of_rays (f X : Set)
  requires space : MeasurableSpace(X)
  requires maps : MapsInto(f, MeasurableSpace.carrier(X), ennreal)
  requires rays : ∀ t ∈ ennreal, MeasurableSet(X, ennGtSet(f, MeasurableSpace.carrier(X), t))
  shows Measurable(f, X, ennMeasurableSpace)
proof
  sorry

-- Mathlib's Measurable.ennreal_ofReal and measurable of a real map into
-- [0, ∞]: x ↦ ofReal(f(x)) is measurable.
theorem Measurable.enn_of_real (f h X : Set)
  requires measurable : Measurable(f, X, realMeasurableSpace)
  requires cast : ∀ x ∈ MeasurableSpace.carrier(X), h(x) = ennOfReal(f(x))
  shows Measurable(h, X, ennMeasurableSpace)
proof
  sorry

-- Mathlib's Measurable.ennreal_toReal.
theorem Measurable.enn_to_real (f h X : Set)
  requires measurable : Measurable(f, X, ennMeasurableSpace)
  requires cast : ∀ x ∈ MeasurableSpace.carrier(X), h(x) = ennToReal(f(x))
  shows Measurable(h, X, realMeasurableSpace)
proof
  sorry

theorem Measurable.enn_add (f g h X : Set)
  requires measurableF : Measurable(f, X, ennMeasurableSpace)
  requires measurableG : Measurable(g, X, ennMeasurableSpace)
  requires sum : ∀ x ∈ MeasurableSpace.carrier(X), h(x) = ennAdd(f(x), g(x))
  shows Measurable(h, X, ennMeasurableSpace)
proof
  sorry

theorem Measurable.enn_mul (f g h X : Set)
  requires measurableF : Measurable(f, X, ennMeasurableSpace)
  requires measurableG : Measurable(g, X, ennMeasurableSpace)
  requires product : ∀ x ∈ MeasurableSpace.carrier(X), h(x) = ennMul(f(x), g(x))
  shows Measurable(h, X, ennMeasurableSpace)
proof
  sorry

-- Mathlib's Measurable.iSup, Measurable.liminf, ENNReal.measurable of
-- countable sums: suprema, lim infs and sums of sequences of measurable
-- maps into [0, ∞] are measurable.
theorem Measurable.enn_sup (u h X : Set)
  requires measurable : ∀ n ∈ ℕ, Measurable(u(n), X, ennMeasurableSpace)
  requires supremum : ∀ x ∈ MeasurableSpace.carrier(X),
    h(x) = ennSupOn(familyAt(u, ℕ, x), ℕ)
  shows Measurable(h, X, ennMeasurableSpace)
proof
  sorry

theorem Measurable.enn_liminf (u h X : Set)
  requires measurable : ∀ n ∈ ℕ, Measurable(u(n), X, ennMeasurableSpace)
  requires lower : ∀ x ∈ MeasurableSpace.carrier(X),
    h(x) = ennLiminf(familyAt(u, ℕ, x))
  shows Measurable(h, X, ennMeasurableSpace)
proof
  sorry

theorem Measurable.enn_tsum (u h X : Set)
  requires measurable : ∀ n ∈ ℕ, Measurable(u(n), X, ennMeasurableSpace)
  requires sum : ∀ x ∈ MeasurableSpace.carrier(X),
    h(x) = ennTsum(familyAt(u, ℕ, x), ℕ)
  shows Measurable(h, X, ennMeasurableSpace)
proof
  sorry

-- Section: Helpers for [0, ∞]
theorem union.of_unique (F v : Set)
  requires member : v ∈ F
  requires unique : ∀ w ∈ F, w = v
  shows ⋃(F) = v
proof
  have e : F = {v}
    ext w
    constructor
    . intro h
      have wv := unique with w, h
      simp
    . intro h
      simp at h
      rw h
      exact member
  rw e
  exact union.singleton at v

theorem ennreal.cases (a : Set)
  requires member : a ∈ ennreal
  shows a = ennTop ∨ (a ∈ ℝ ∧ realZero ≤ a)
proof
  unfold ennreal at member
  simp at member
  cases member with fin | top
  . right
    exact fin
  . left
    exact top

theorem ennreal.not_top_of_real (a : Set)
  requires real : a ∈ ℝ
  shows a ≠ ennTop
proof
  intro e
  have bad := ennTop.not_real
  rw ← e at bad
  exact bad with real

theorem ennreal.of_real (a : Set)
  requires real : a ∈ ℝ
  requires nonneg : realZero ≤ a
  shows a ∈ ennreal
proof
  unfold ennreal
  simp

theorem ennreal.finite (a : Set)
  requires member : a ∈ ennreal
  requires finite : a ≠ ennTop
  shows a ∈ ℝ ∧ realZero ≤ a
proof
  have c := ennreal.cases with member
  cases c with top | fin
  . exfalso
    exact finite with top
  . exact fin

theorem ennreal.top_member
  shows ennTop ∈ ennreal
proof
  unfold ennreal
  simp

theorem ennAdd.finite (a b : Set)
  requires realA : a ∈ ℝ
  requires realB : b ∈ ℝ
  requires nonnegA : realZero ≤ a
  requires nonnegB : realZero ≤ b
  shows ennAdd(a, b) = R[a + b]
proof
  have na := ennreal.not_top_of_real with realA
  have nb := ennreal.not_top_of_real with realB
  have sumR : R[a + b] ∈ ℝ by typecheck
  have sumNn : realZero ≤ R[a + b] by linarith
  have sm := ennreal.of_real with sumR, sumNn
  unfold ennAdd
  apply union.of_unique
  . apply ennAdd.family.membership.backward
    refine ⟨sm, ?_⟩
    left
    exact ⟨na, nb, rfl⟩
  . intros w hw
    obtain ⟨wIn, alt⟩ := ennAdd.family.membership.forward with hw
    cases alt with fin | top
    . exact fin.right.right
    . exfalso
      obtain ⟨t, rest⟩ := top
      cases t with t1 | t2
      . exact na with t1
      . exact nb with t2

theorem ennAdd.top_left (a b : Set)
  requires top : a = ennTop
  shows ennAdd(a, b) = ennTop
proof
  have tm := ennreal.top_member
  unfold ennAdd
  apply union.of_unique
  . apply ennAdd.family.membership.backward
    refine ⟨tm, ?_⟩
    right
    refine ⟨?_, rfl⟩
    left
    exact top
  . intros w hw
    obtain ⟨wIn, alt⟩ := ennAdd.family.membership.forward with hw
    cases alt with fin | t
    . exfalso
      exact fin.left with top
    . exact t.right

theorem ennAdd.top_right (a b : Set)
  requires top : b = ennTop
  shows ennAdd(a, b) = ennTop
proof
  have tm := ennreal.top_member
  unfold ennAdd
  apply union.of_unique
  . apply ennAdd.family.membership.backward
    refine ⟨tm, ?_⟩
    right
    refine ⟨?_, rfl⟩
    right
    exact top
  . intros w hw
    obtain ⟨wIn, alt⟩ := ennAdd.family.membership.forward with hw
    cases alt with fin | t
    . exfalso
      exact fin.right.left with top
    . exact t.right

theorem ennMul.finite (a b : Set)
  requires realA : a ∈ ℝ
  requires realB : b ∈ ℝ
  requires nonnegA : realZero ≤ a
  requires nonnegB : realZero ≤ b
  shows ennMul(a, b) = R[a * b]
proof
  have na := ennreal.not_top_of_real with realA
  have nb := ennreal.not_top_of_real with realB
  have pR : R[a * b] ∈ ℝ by typecheck
  have pNn := realMulValue.nonnegative at a, b with nonnegA, nonnegB
  have sm := ennreal.of_real with pR, pNn
  unfold ennMul
  apply union.of_unique
  . apply ennMul.family.membership.backward
    refine ⟨sm, ?_⟩
    left
    exact ⟨na, nb, rfl⟩
  . intros w hw
    obtain ⟨wIn, alt⟩ := ennMul.family.membership.forward with hw
    rcases alt with fin | zero | top
    . exact fin.right.right
    . obtain ⟨z, wz⟩ := zero
      rw wz
      cases z with za | zb
      . rw za
        ring
      . rw zb
        ring
    . exfalso
      obtain ⟨t, rest⟩ := top
      cases t with t1 | t2
      . exact na with t1
      . exact nb with t2

theorem ennMul.zero_left (a b : Set)
  requires zero : a = realZero
  requires member : b ∈ ennreal
  shows ennMul(a, b) = realZero
proof
  have zR : realZero ∈ ℝ by typecheck
  have zNn : realZero ≤ realZero by linarith
  have zm := ennreal.of_real with zR, zNn
  unfold ennMul
  apply union.of_unique
  . apply ennMul.family.membership.backward
    refine ⟨zm, ?_⟩
    right
    left
    refine ⟨?_, rfl⟩
    left
    exact zero
  . intros w hw
    obtain ⟨wIn, alt⟩ := ennMul.family.membership.forward with hw
    rcases alt with fin | z | top
    . obtain ⟨na, nb, wv⟩ := fin
      have bf := ennreal.finite with member, nb
      have bR := bf.left
      rw [wv, zero]
      ring
    . exact z.right
    . exfalso
      exact top.right.left with zero

theorem ennMul.zero_right (a b : Set)
  requires member : a ∈ ennreal
  requires zero : b = realZero
  shows ennMul(a, b) = realZero
proof
  have zR : realZero ∈ ℝ by typecheck
  have zNn : realZero ≤ realZero by linarith
  have zm := ennreal.of_real with zR, zNn
  unfold ennMul
  apply union.of_unique
  . apply ennMul.family.membership.backward
    refine ⟨zm, ?_⟩
    right
    left
    refine ⟨?_, rfl⟩
    right
    exact zero
  . intros w hw
    obtain ⟨wIn, alt⟩ := ennMul.family.membership.forward with hw
    rcases alt with fin | z | top
    . obtain ⟨na, nb, wv⟩ := fin
      have af := ennreal.finite with member, na
      have aR := af.left
      rw [wv, zero]
      ring
    . exact z.right
    . exfalso
      exact top.right.right.left with zero

theorem ennMul.top_left (a b : Set)
  requires top : a = ennTop
  requires nonzero : b ≠ realZero
  shows ennMul(a, b) = ennTop
proof
  have tm := ennreal.top_member
  have aNz : a ≠ realZero
    intro e
    have zR : realZero ∈ ℝ by typecheck
    have bad := ennreal.not_top_of_real with zR
    rw [← e, top] at bad
    exact bad with rfl
  unfold ennMul
  apply union.of_unique
  . apply ennMul.family.membership.backward
    refine ⟨tm, ?_⟩
    right
    right
    refine ⟨?_, aNz, nonzero, rfl⟩
    left
    exact top
  . intros w hw
    obtain ⟨wIn, alt⟩ := ennMul.family.membership.forward with hw
    rcases alt with fin | z | t
    . exfalso
      exact fin.left with top
    . exfalso
      obtain ⟨zz, rest⟩ := z
      cases zz with za | zb
      . exact aNz with za
      . exact nonzero with zb
    . exact t.right.right.right

theorem ennMul.top_right (a b : Set)
  requires nonzero : a ≠ realZero
  requires top : b = ennTop
  shows ennMul(a, b) = ennTop
proof
  have tm := ennreal.top_member
  have bNz : b ≠ realZero
    intro e
    have zR : realZero ∈ ℝ by typecheck
    have bad := ennreal.not_top_of_real with zR
    rw [← e, top] at bad
    exact bad with rfl
  unfold ennMul
  apply union.of_unique
  . apply ennMul.family.membership.backward
    refine ⟨tm, ?_⟩
    right
    right
    refine ⟨?_, nonzero, bNz, rfl⟩
    right
    exact top
  . intros w hw
    obtain ⟨wIn, alt⟩ := ennMul.family.membership.forward with hw
    rcases alt with fin | z | t
    . exfalso
      exact fin.right.left with top
    . exfalso
      obtain ⟨zz, rest⟩ := z
      cases zz with za | zb
      . exact nonzero with za
      . exact bNz with zb
    . exact t.right.right.right

theorem ennOfReal.value_nonneg (X : Set)
  requires real : X ∈ ℝ
  requires nonneg : realZero ≤ X
  shows ennOfReal(X) = X
proof
  have m := ennreal.of_real with real, nonneg
  unfold ennOfReal
  apply union.of_unique
  . apply ennOfReal.family.membership.backward
    refine ⟨m, ?_⟩
    left
    exact ⟨nonneg, rfl⟩
  . intros w hw
    obtain ⟨wIn, alt⟩ := ennOfReal.family.membership.forward with hw
    cases alt with p | n
    . exact p.right
    . exfalso
      obtain ⟨neg, rest⟩ := n
      linarith

theorem ennOfReal.value_neg (X : Set)
  requires real : X ∈ ℝ
  requires negative : X < realZero
  shows ennOfReal(X) = realZero
proof
  have zR : realZero ∈ ℝ by typecheck
  have zNn : realZero ≤ realZero by linarith
  have m := ennreal.of_real with zR, zNn
  unfold ennOfReal
  apply union.of_unique
  . apply ennOfReal.family.membership.backward
    refine ⟨m, ?_⟩
    right
    exact ⟨negative, rfl⟩
  . intros w hw
    obtain ⟨wIn, alt⟩ := ennOfReal.family.membership.forward with hw
    cases alt with p | n
    . exfalso
      obtain ⟨nn, rest⟩ := p
      linarith
    . exact n.right

theorem ennreal.zero_member
  shows realZero ∈ ennreal
proof
  have zR : realZero ∈ ℝ by typecheck
  have zNn : realZero ≤ realZero by linarith
  exact ennreal.of_real with zR, zNn

theorem ennreal.zero_not_top
  shows realZero ≠ ennTop
proof
  have zR : realZero ∈ ℝ by typecheck
  exact ennreal.not_top_of_real with zR

theorem ennreal.top_ne_zero
  shows ennTop ≠ realZero
proof
  intro e
  have z := ennreal.zero_not_top
  symm at e
  exact z with e

theorem real.pos_of_nonzero (a : Set)
  requires real : a ∈ ℝ
  requires nonneg : realZero ≤ a
  requires nonzero : a ≠ realZero
  shows realZero < a
proof
  by_contra np
  have le : a ≤ realZero by linarith
  have e := realLe.antisymmetric at a, realZero with le, nonneg
  exact nonzero with e

theorem ennMul.nonzero (a b : Set)
  requires memberA : a ∈ ennreal
  requires memberB : b ∈ ennreal
  requires nonzeroA : a ≠ realZero
  requires nonzeroB : b ≠ realZero
  shows ennMul(a, b) ≠ realZero
proof
  have tz := ennreal.top_ne_zero
  have ca := ennreal.cases with memberA
  have cb := ennreal.cases with memberB
  cases ca with aT | afin
  . rw ennMul.top_left with aT, nonzeroB
    exact tz
  . cases cb with bT | bfin
    . rw ennMul.top_right with nonzeroA, bT
      exact tz
    . obtain ⟨aR, aNn⟩ := afin
      obtain ⟨bR, bNn⟩ := bfin
      rw ennMul.finite with aR, bR, aNn, bNn
      have ap := real.pos_of_nonzero with aR, aNn, nonzeroA
      have bp := real.pos_of_nonzero with bR, bNn, nonzeroB
      have p := realMulValue.positive at a, b with ap, bp
      intro e
      rw e at p
      linarith

theorem EnnLe.nonzero (a b : Set)
  requires le : EnnLe(a, b)
  requires nonzero : a ≠ realZero
  shows b ≠ realZero
proof
  obtain ⟨aM, bM, ab⟩ := le
  intro bZ
  cases ab with bT | afin
  . have tz := ennreal.top_ne_zero
    rw ← bT at tz
    exact tz with bZ
  . obtain ⟨na, ale⟩ := afin
    obtain ⟨aR, aNn⟩ := ennreal.finite with aM, na
    rw bZ at ale
    have e := realLe.antisymmetric at a, realZero with ale, aNn
    exact nonzero with e

-- Section: Arithmetic of [0, ∞]
theorem ennreal.real_member (X : Real)
  requires nonneg : realZero ≤ X
  shows X ∈ ennreal
proof
  have xR : X ∈ ℝ by typecheck
  exact ennreal.of_real with xR, nonneg

theorem ennTop.member
  shows ennTop ∈ ennreal
proof
  exact ennreal.top_member

theorem EnnLe.reflexive (a : Set)
  requires member : a ∈ ennreal
  shows EnnLe(a, a)
proof
  have c := ennreal.cases with member
  unfold EnnLe
  refine ⟨member, member, ?_⟩
  cases c with top | fin
  . left
    exact top
  . right
    obtain ⟨aR, aNn⟩ := fin
    have na := ennreal.not_top_of_real with aR
    refine ⟨na, ?_⟩
    linarith

theorem EnnLe.transitive (a b c : Set)
  requires first : EnnLe(a, b)
  requires second : EnnLe(b, c)
  shows EnnLe(a, c)
proof
  obtain ⟨aM, bM, ab⟩ := first
  obtain ⟨bM2, cM, bc⟩ := second
  unfold EnnLe
  refine ⟨aM, cM, ?_⟩
  by_cases ct : c = ennTop
  . left
    exact ct
  . cases bc with ct2 | bfin
    . exfalso
      exact ct with ct2
    . obtain ⟨nb, ble⟩ := bfin
      cases ab with bt | afin
      . exfalso
        exact nb with bt
      . obtain ⟨na, ale⟩ := afin
        right
        have af := ennreal.finite with aM, na
        have bf := ennreal.finite with bM, nb
        have cf := ennreal.finite with cM, ct
        have aR := af.left
        have bR := bf.left
        have cR := cf.left
        refine ⟨na, ?_⟩
        linarith

theorem EnnLe.antisymmetric (a b : Set)
  requires first : EnnLe(a, b)
  requires second : EnnLe(b, a)
  shows a = b
proof
  obtain ⟨aM, bM, ab⟩ := first
  obtain ⟨bM2, aM2, ba⟩ := second
  cases ab with bt | afin
  . cases ba with at | bfin
    . rw [at, bt]
    . exfalso
      exact bfin.left with bt
  . cases ba with at | bfin
    . exfalso
      exact afin.left with at
    . obtain ⟨na, ale⟩ := afin
      obtain ⟨nb, ble⟩ := bfin
      have af := ennreal.finite with aM, na
      have bf := ennreal.finite with bM, nb
      have aR := af.left
      have bR := bf.left
      exact realLe.antisymmetric at a, b with ale, ble

theorem EnnLe.total (a b : Set)
  requires memberA : a ∈ ennreal
  requires memberB : b ∈ ennreal
  shows EnnLe(a, b) ∨ EnnLe(b, a)
proof
  have ca := ennreal.cases with memberA
  have cb := ennreal.cases with memberB
  cases cb with bt | bfin
  . left
    unfold EnnLe
    refine ⟨memberA, memberB, ?_⟩
    left
    exact bt
  . cases ca with at | afin
    . right
      unfold EnnLe
      refine ⟨memberB, memberA, ?_⟩
      left
      exact at
    . obtain ⟨aR, aNn⟩ := afin
      obtain ⟨bR, bNn⟩ := bfin
      have na := ennreal.not_top_of_real with aR
      have nb := ennreal.not_top_of_real with bR
      by_cases le : a ≤ b
      . left
        unfold EnnLe
        refine ⟨memberA, memberB, ?_⟩
        right
        exact ⟨na, le⟩
      . right
        unfold EnnLe
        refine ⟨memberB, memberA, ?_⟩
        right
        refine ⟨nb, ?_⟩
        linarith

theorem EnnLe.zero (a : Set)
  requires member : a ∈ ennreal
  shows EnnLe(realZero, a)
proof
  have zm := ennreal.zero_member
  have zn := ennreal.zero_not_top
  have c := ennreal.cases with member
  unfold EnnLe
  refine ⟨zm, member, ?_⟩
  cases c with top | fin
  . left
    exact top
  . right
    obtain ⟨aR, aNn⟩ := fin
    exact ⟨zn, aNn⟩

theorem EnnLe.top (a : Set)
  requires member : a ∈ ennreal
  shows EnnLe(a, ennTop)
proof
  have tm := ennreal.top_member
  unfold EnnLe
  refine ⟨member, tm, ?_⟩
  left
  rfl

theorem ennOfReal.member (X : Real)
  shows ennOfReal(X) ∈ ennreal ∧ ennOfReal(X) ≠ ennTop
proof
  have xR : X ∈ ℝ by typecheck
  have zR : realZero ∈ ℝ by typecheck
  by_cases nn : realZero ≤ X
  . have e := ennOfReal.value_nonneg with xR, nn
    rw e
    have m := ennreal.of_real with xR, nn
    have n := ennreal.not_top_of_real with xR
    exact ⟨m, n⟩
  . have neg : X < realZero by linarith
    have e := ennOfReal.value_neg with xR, neg
    rw e
    have m := ennreal.zero_member
    have n := ennreal.zero_not_top
    exact ⟨m, n⟩

theorem ennOfReal.of_nonneg (X : Real)
  requires nonneg : realZero ≤ X
  shows ennOfReal(X) = X
proof
  have xR : X ∈ ℝ by typecheck
  exact ennOfReal.value_nonneg with xR, nonneg

theorem ennToReal.of_finite (a : Set)
  requires member : a ∈ ennreal
  requires finite : a ≠ ennTop
  shows ennToReal(a) = a ∧ realZero ≤ ennToReal(a)
proof
  have af := ennreal.finite with member, finite
  obtain ⟨aR, aNn⟩ := af
  have e : ennToReal(a) = a
    unfold ennToReal
    apply union.of_unique
    . apply ennToReal.family.membership.backward
      refine ⟨aR, ?_⟩
      left
      exact ⟨finite, rfl⟩
    . intros w hw
      obtain ⟨wIn, alt⟩ := ennToReal.family.membership.forward with hw
      cases alt with p | n
      . exact p.right
      . exfalso
        exact finite with n.left
  rw e
  exact ⟨rfl, aNn⟩

theorem ennAdd.member (a b : Set)
  requires memberA : a ∈ ennreal
  requires memberB : b ∈ ennreal
  shows ennAdd(a, b) ∈ ennreal
proof
  have ca := ennreal.cases with memberA
  have cb := ennreal.cases with memberB
  cases ca with aT | afin
  . rw ennAdd.top_left with aT
    exact ennreal.top_member
  . cases cb with bT | bfin
    . rw ennAdd.top_right with bT
      exact ennreal.top_member
    . obtain ⟨aR, aNn⟩ := afin
      obtain ⟨bR, bNn⟩ := bfin
      rw ennAdd.finite with aR, bR, aNn, bNn
      have sR : R[a + b] ∈ ℝ by typecheck
      have sNn : realZero ≤ R[a + b] by linarith
      exact ennreal.of_real with sR, sNn

theorem ennAdd.comm (a b : Set)
  requires memberA : a ∈ ennreal
  requires memberB : b ∈ ennreal
  shows ennAdd(a, b) = ennAdd(b, a)
proof
  have ca := ennreal.cases with memberA
  have cb := ennreal.cases with memberB
  cases ca with aT | afin
  . rw ennAdd.top_left with aT
    rw ennAdd.top_right with aT
  . cases cb with bT | bfin
    . rw ennAdd.top_right with bT
      rw ennAdd.top_left with bT
    . obtain ⟨aR, aNn⟩ := afin
      obtain ⟨bR, bNn⟩ := bfin
      rw ennAdd.finite with aR, bR, aNn, bNn
      rw ennAdd.finite with bR, aR, bNn, aNn
      ring

theorem ennAdd.assoc (a b c : Set)
  requires memberA : a ∈ ennreal
  requires memberB : b ∈ ennreal
  requires memberC : c ∈ ennreal
  shows ennAdd(ennAdd(a, b), c) = ennAdd(a, ennAdd(b, c))
proof
  have ca := ennreal.cases with memberA
  have cb := ennreal.cases with memberB
  have cc := ennreal.cases with memberC
  cases ca with aT | afin
  . have l := ennAdd.top_left at a, b with aT
    rw l
    rw ennAdd.top_left at ennTop, c with rfl
    rw ennAdd.top_left at a, ennAdd(b, c) with aT
  . cases cb with bT | bfin
    . have l := ennAdd.top_right at a, b with bT
      have r := ennAdd.top_left at b, c with bT
      rw l
      rw ennAdd.top_left at ennTop, c with rfl
      rw r
      rw ennAdd.top_right at a, ennTop with rfl
    . cases cc with cT | cfin
      . rw ennAdd.top_right at ennAdd(a, b), c with cT
        rw ennAdd.top_right at b, c with cT
        rw ennAdd.top_right at a, ennTop with rfl
      . obtain ⟨aR, aNn⟩ := afin
        obtain ⟨bR, bNn⟩ := bfin
        obtain ⟨cR, cNn⟩ := cfin
        have abR : R[a + b] ∈ ℝ by typecheck
        have abNn : realZero ≤ R[a + b] by linarith
        have bcR : R[b + c] ∈ ℝ by typecheck
        have bcNn : realZero ≤ R[b + c] by linarith
        rw ennAdd.finite with aR, bR, aNn, bNn
        rw ennAdd.finite with bR, cR, bNn, cNn
        rw ennAdd.finite with abR, cR, abNn, cNn
        rw ennAdd.finite with aR, bcR, aNn, bcNn
        ring

theorem ennAdd.zero (a : Set)
  requires member : a ∈ ennreal
  shows ennAdd(a, realZero) = a
proof
  have ca := ennreal.cases with member
  cases ca with aT | afin
  . rw ennAdd.top_left with aT
    rw aT
  . obtain ⟨aR, aNn⟩ := afin
    have zR : realZero ∈ ℝ by typecheck
    have zNn : realZero ≤ realZero by linarith
    rw ennAdd.finite with aR, zR, aNn, zNn
    ring

theorem ennAdd.mono (a b c d : Set)
  requires first : EnnLe(a, b)
  requires second : EnnLe(c, d)
  shows EnnLe(ennAdd(a, c), ennAdd(b, d))
proof
  obtain ⟨aM, bM, ab⟩ := first
  obtain ⟨cM, dM, cd⟩ := second
  have acM := ennAdd.member with aM, cM
  by_cases bT : b = ennTop
  . rw ennAdd.top_left at b, d with bT
    exact EnnLe.top with acM
  . by_cases dT : d = ennTop
    . rw ennAdd.top_right at b, d with dT
      exact EnnLe.top with acM
    . cases ab with bT2 | afin
      . exfalso
        exact bT with bT2
      . cases cd with dT2 | cfin
        . exfalso
          exact dT with dT2
        . obtain ⟨na, ale⟩ := afin
          obtain ⟨nc, cle⟩ := cfin
          obtain ⟨aR, aNn⟩ := ennreal.finite with aM, na
          obtain ⟨bR, bNn⟩ := ennreal.finite with bM, bT
          obtain ⟨cR, cNn⟩ := ennreal.finite with cM, nc
          obtain ⟨dR, dNn⟩ := ennreal.finite with dM, dT
          have bdM := ennAdd.member with bM, dM
          rw ennAdd.finite with aR, cR, aNn, cNn
          rw ennAdd.finite with bR, dR, bNn, dNn
          rw ennAdd.finite with aR, cR, aNn, cNn at acM
          rw ennAdd.finite with bR, dR, bNn, dNn at bdM
          have acR : R[a + c] ∈ ℝ by typecheck
          have n1 := ennreal.not_top_of_real with acR
          unfold EnnLe
          refine ⟨acM, bdM, ?_⟩
          right
          refine ⟨n1, ?_⟩
          linarith

theorem ennMul.member (a b : Set)
  requires memberA : a ∈ ennreal
  requires memberB : b ∈ ennreal
  shows ennMul(a, b) ∈ ennreal
proof
  have zm := ennreal.zero_member
  have tm := ennreal.top_member
  by_cases aZ : a = realZero
  . rw ennMul.zero_left with aZ, memberB
    exact zm
  . by_cases bZ : b = realZero
    . rw ennMul.zero_right with memberA, bZ
      exact zm
    . have ca := ennreal.cases with memberA
      have cb := ennreal.cases with memberB
      cases ca with aT | afin
      . rw ennMul.top_left with aT, bZ
        exact tm
      . cases cb with bT | bfin
        . rw ennMul.top_right with aZ, bT
          exact tm
        . obtain ⟨aR, aNn⟩ := afin
          obtain ⟨bR, bNn⟩ := bfin
          rw ennMul.finite with aR, bR, aNn, bNn
          have pR : R[a * b] ∈ ℝ by typecheck
          have pNn := realMulValue.nonnegative at a, b with aNn, bNn
          exact ennreal.of_real with pR, pNn

theorem ennMul.comm (a b : Set)
  requires memberA : a ∈ ennreal
  requires memberB : b ∈ ennreal
  shows ennMul(a, b) = ennMul(b, a)
proof
  by_cases aZ : a = realZero
  . rw ennMul.zero_left with aZ, memberB
    rw ennMul.zero_right with memberB, aZ
  . by_cases bZ : b = realZero
    . rw ennMul.zero_right with memberA, bZ
      rw ennMul.zero_left with bZ, memberA
    . have ca := ennreal.cases with memberA
      have cb := ennreal.cases with memberB
      cases ca with aT | afin
      . rw ennMul.top_left with aT, bZ
        rw ennMul.top_right with bZ, aT
      . cases cb with bT | bfin
        . rw ennMul.top_right with aZ, bT
          rw ennMul.top_left with bT, aZ
        . obtain ⟨aR, aNn⟩ := afin
          obtain ⟨bR, bNn⟩ := bfin
          rw ennMul.finite with aR, bR, aNn, bNn
          rw ennMul.finite with bR, aR, bNn, aNn
          ring

theorem ennMul.assoc (a b c : Set)
  requires memberA : a ∈ ennreal
  requires memberB : b ∈ ennreal
  requires memberC : c ∈ ennreal
  shows ennMul(ennMul(a, b), c) = ennMul(a, ennMul(b, c))
proof
  have zm := ennreal.zero_member
  have abM := ennMul.member with memberA, memberB
  have bcM := ennMul.member with memberB, memberC
  by_cases aZ : a = realZero
  . rw ennMul.zero_left at a, b with aZ, memberB
    rw ennMul.zero_left at realZero, c with rfl, memberC
    rw ennMul.zero_left at a, ennMul(b, c) with aZ, bcM
  . by_cases bZ : b = realZero
    . rw ennMul.zero_right at a, b with memberA, bZ
      rw ennMul.zero_left at realZero, c with rfl, memberC
      rw ennMul.zero_left at b, c with bZ, memberC
      rw ennMul.zero_right at a, realZero with memberA, rfl
    . by_cases cZ : c = realZero
      . rw ennMul.zero_right at ennMul(a, b), c with abM, cZ
        rw ennMul.zero_right at b, c with memberB, cZ
        rw ennMul.zero_right at a, realZero with memberA, rfl
      . have abZ := ennMul.nonzero with memberA, memberB, aZ, bZ
        have bcZ := ennMul.nonzero with memberB, memberC, bZ, cZ
        have ca := ennreal.cases with memberA
        have cb := ennreal.cases with memberB
        have cc := ennreal.cases with memberC
        cases ca with aT | afin
        . rw ennMul.top_left at a, b with aT, bZ
          rw ennMul.top_left at ennTop, c with rfl, cZ
          rw ennMul.top_left at a, ennMul(b, c) with aT, bcZ
        . cases cb with bT | bfin
          . rw ennMul.top_right at a, b with aZ, bT
            rw ennMul.top_left at ennTop, c with rfl, cZ
            rw ennMul.top_left at b, c with bT, cZ
            rw ennMul.top_right at a, ennTop with aZ, rfl
          . cases cc with cT | cfin
            . rw ennMul.top_right at ennMul(a, b), c with abZ, cT
              rw ennMul.top_right at b, c with bZ, cT
              rw ennMul.top_right at a, ennTop with aZ, rfl
            . obtain ⟨aR, aNn⟩ := afin
              obtain ⟨bR, bNn⟩ := bfin
              obtain ⟨cR, cNn⟩ := cfin
              have abR : R[a * b] ∈ ℝ by typecheck
              have abNn := realMulValue.nonnegative at a, b with aNn, bNn
              have bcR : R[b * c] ∈ ℝ by typecheck
              have bcNn := realMulValue.nonnegative at b, c with bNn, cNn
              rw ennMul.finite with aR, bR, aNn, bNn
              rw ennMul.finite with bR, cR, bNn, cNn
              rw ennMul.finite with abR, cR, abNn, cNn
              rw ennMul.finite with aR, bcR, aNn, bcNn
              ring

theorem ennMul.one (a : Set)
  requires member : a ∈ ennreal
  shows ennMul(realOne, a) = a
proof
  have oR : realOne ∈ ℝ by typecheck
  have oNn : realZero ≤ realOne by linarith
  have oZ : realOne ≠ realZero
    intro e
    have p : realZero < realOne by linarith
    rw e at p
    linarith
  have ca := ennreal.cases with member
  cases ca with aT | afin
  . rw ennMul.top_right with oZ, aT
    rw aT
  . obtain ⟨aR, aNn⟩ := afin
    rw ennMul.finite with oR, aR, oNn, aNn
    ring

theorem ennMul.zero (a : Set)
  requires member : a ∈ ennreal
  shows ennMul(realZero, a) = realZero
proof
  exact ennMul.zero_left with rfl, member

theorem ennMul.add_right (a b c : Set)
  requires memberA : a ∈ ennreal
  requires memberB : b ∈ ennreal
  requires memberC : c ∈ ennreal
  shows ennMul(a, ennAdd(b, c)) = ennAdd(ennMul(a, b), ennMul(a, c))
proof
  have zm := ennreal.zero_member
  have tm := ennreal.top_member
  have tz := ennreal.top_ne_zero
  have bcM := ennAdd.member with memberB, memberC
  have abM := ennMul.member with memberA, memberB
  have acM := ennMul.member with memberA, memberC
  by_cases aZ : a = realZero
  . rw ennMul.zero_left at a, ennAdd(b, c) with aZ, bcM
    rw ennMul.zero_left at a, b with aZ, memberB
    rw ennMul.zero_left at a, c with aZ, memberC
    rw ennAdd.zero at realZero with zm
  . by_cases bZ : b = realZero
    . rw ennMul.zero_right at a, b with memberA, bZ
      rw bZ
      rw ennAdd.comm at realZero, c with zm, memberC
      rw ennAdd.zero at c with memberC
      rw ennAdd.comm at realZero, ennMul(a, c) with zm, acM
      rw ennAdd.zero at ennMul(a, c) with acM
    . by_cases cZ : c = realZero
      . rw ennMul.zero_right at a, c with memberA, cZ
        rw cZ
        rw ennAdd.zero at b with memberB
        rw ennAdd.zero at ennMul(a, b) with abM
      . have abZ := ennMul.nonzero with memberA, memberB, aZ, bZ
        have acZ := ennMul.nonzero with memberA, memberC, aZ, cZ
        have bcZ : ennAdd(b, c) ≠ realZero
          have le : EnnLe(b, ennAdd(b, c))
            have bb := EnnLe.reflexive with memberB
            have zc := EnnLe.zero with memberC
            have m := ennAdd.mono with bb, zc
            rw ennAdd.zero at b with memberB at m
            exact m
          exact EnnLe.nonzero with le, bZ
        have ca := ennreal.cases with memberA
        cases ca with aT | afin
        . rw ennMul.top_left at a, ennAdd(b, c) with aT, bcZ
          rw ennMul.top_left at a, b with aT, bZ
          rw ennMul.top_left at a, c with aT, cZ
          rw ennAdd.top_left at ennTop, ennTop with rfl
        . have cb := ennreal.cases with memberB
          cases cb with bT | bfin
          . rw ennAdd.top_left at b, c with bT
            rw ennMul.top_right at a, ennTop with aZ, rfl
            rw ennMul.top_right at a, b with aZ, bT
            rw ennAdd.top_left at ennTop, ennMul(a, c) with rfl
          . have cc := ennreal.cases with memberC
            cases cc with cT | cfin
            . rw ennAdd.top_right at b, c with cT
              rw ennMul.top_right at a, ennTop with aZ, rfl
              rw ennMul.top_right at a, c with aZ, cT
              rw ennAdd.top_right at ennMul(a, b), ennTop with rfl
            . obtain ⟨aR, aNn⟩ := afin
              obtain ⟨bR, bNn⟩ := bfin
              obtain ⟨cR, cNn⟩ := cfin
              have bcR : R[b + c] ∈ ℝ by typecheck
              have bcNn : realZero ≤ R[b + c] by linarith
              have abR : R[a * b] ∈ ℝ by typecheck
              have abNn := realMulValue.nonnegative at a, b with aNn, bNn
              have acR : R[a * c] ∈ ℝ by typecheck
              have acNn := realMulValue.nonnegative at a, c with aNn, cNn
              rw ennAdd.finite with bR, cR, bNn, cNn
              rw ennMul.finite with aR, bcR, aNn, bcNn
              rw ennMul.finite with aR, bR, aNn, bNn
              rw ennMul.finite with aR, cR, aNn, cNn
              rw ennAdd.finite with abR, acR, abNn, acNn
              ring

theorem ennMul.mono (a b c d : Set)
  requires first : EnnLe(a, b)
  requires second : EnnLe(c, d)
  shows EnnLe(ennMul(a, c), ennMul(b, d))
proof
  have f1 := first
  have s1 := second
  obtain ⟨aM, bM, ab⟩ := f1
  obtain ⟨cM, dM, cd⟩ := s1
  have acM := ennMul.member with aM, cM
  have bdM := ennMul.member with bM, dM
  by_cases aZ : a = realZero
  . rw ennMul.zero_left at a, c with aZ, cM
    exact EnnLe.zero with bdM
  . by_cases cZ : c = realZero
    . rw ennMul.zero_right at a, c with aM, cZ
      exact EnnLe.zero with bdM
    . have bZ := EnnLe.nonzero with first, aZ
      have dZ := EnnLe.nonzero with second, cZ
      by_cases bT : b = ennTop
      . rw ennMul.top_left at b, d with bT, dZ
        exact EnnLe.top with acM
      . by_cases dT : d = ennTop
        . rw ennMul.top_right at b, d with bZ, dT
          exact EnnLe.top with acM
        . cases ab with bT2 | afin
          . exfalso
            exact bT with bT2
          . cases cd with dT2 | cfin
            . exfalso
              exact dT with dT2
            . obtain ⟨na, ale⟩ := afin
              obtain ⟨nc, cle⟩ := cfin
              obtain ⟨aR, aNn⟩ := ennreal.finite with aM, na
              obtain ⟨bR, bNn⟩ := ennreal.finite with bM, bT
              obtain ⟨cR, cNn⟩ := ennreal.finite with cM, nc
              obtain ⟨dR, dNn⟩ := ennreal.finite with dM, dT
              rw ennMul.finite with aR, cR, aNn, cNn
              rw ennMul.finite with bR, dR, bNn, dNn
              rw ennMul.finite with aR, cR, aNn, cNn at acM
              rw ennMul.finite with bR, dR, bNn, dNn at bdM
              have acR : R[a * c] ∈ ℝ by typecheck
              have n1 := ennreal.not_top_of_real with acR
              have l1 := realLe.mul_right_of_nonnegative at a, b, c with ale, cNn
              have l2 := realLe.mul_left_of_nonnegative at c, d, b with cle, bNn
              unfold EnnLe
              refine ⟨acM, bdM, ?_⟩
              right
              refine ⟨n1, ?_⟩
              linarith

-- ennMulReal of Topology/Sums is the product.
theorem ennMulReal.eq_ennMul (c a : Set)
  requires nonneg : c ∈ ennreal ∧ c ≠ ennTop
  requires member : a ∈ ennreal
  shows ennMulReal(c, a) = ennMul(c, a)
proof
  obtain ⟨cM, cT⟩ := nonneg
  obtain ⟨cR, cNn⟩ := ennreal.finite with cM, cT
  have ca := ennreal.cases with member
  cases ca with aT | afin
  . rw aT
    by_cases cZ : c = realZero
    . rw cZ
      rw ennMulReal.top_zero
      rw ennMul.zero_left at realZero, ennTop with rfl, ennreal.top_member
    . rw ennMulReal.top_pos with cZ
      rw ennMul.top_right at c, ennTop with cZ, rfl
  . obtain ⟨aR, aNn⟩ := afin
    rw ennMulReal.finite with aR, aNn, cR, cNn
    rw ennMul.finite with cR, aR, cNn, aNn

-- Helpers: completeness of [0, ∞].
theorem real.sup_exists (S : Set)
  requires inside : S ⊆ ℝ
  requires inhabited : ∃ x, x ∈ S
  requires bounded : ∃ B ∈ ℝ, ∀ x ∈ S, x ≤ B
  shows ∃ U ∈ ℝ, (∀ x ∈ S, x ≤ U) ∧ (∀ B ∈ ℝ, (∀ x ∈ S, x ≤ B) → U ≤ B)
proof
  obtain ⟨x0, x0S⟩ := inhabited
  have ne : Nonempty(S) := ⟨x0, x0S⟩
  obtain ⟨B, BR, Bb⟩ := bounded
  have realB : Real(B) by exact BR
  have upperB : RealUpperBound(S, B)
    refine ⟨realB, inside, ?_⟩
    intros x hx
    have xR := inside with x, hx
    have le := Bb with x, hx
    exact realLe.subset with le
  have bd : ∃ D, RealUpperBound(S, D) := ⟨B, upperB⟩
  obtain ⟨U, least⟩ := Real.least_upper_bound_property with ne, bd
  have upperU := least.left
  have minimal := least.right
  obtain ⟨realU, inReals, bounds⟩ := upperU
  have UR : U ∈ ℝ by simp [Real]
  refine ⟨U, UR, ?_, ?_⟩
  . intros x hx
    have xR := inside with x, hx
    have sub := bounds with x, hx
    exact realLe.of_subset with sub
  . intros C CR Cb
    have realC : Real(C) by exact CR
    have upperC : RealUpperBound(S, C)
      refine ⟨realC, inside, ?_⟩
      intros x hx
      have xR := inside with x, hx
      have le := Cb with x, hx
      exact realLe.subset with le
    have sub := minimal with C, upperC
    exact realLe.of_subset with sub

theorem ennSup.exists (S : Set)
  requires inside : S ⊆ ennreal
  shows ∃ b ∈ ennreal, EnnUpperBound(S, b) ∧ (∀ c, EnnUpperBound(S, c) → EnnLe(b, c))
proof
  have tm := ennreal.top_member
  have zm := ennreal.zero_member
  have topUpper : EnnUpperBound(S, ennTop)
    unfold EnnUpperBound
    refine ⟨tm, ?_⟩
    intros a ha
    have aM := inside with a, ha
    exact EnnLe.top with aM
  by_cases topIn : ennTop ∈ S
  . refine ⟨ennTop, tm, topUpper, ?_⟩
    intros c hc
    obtain ⟨cM, bounds⟩ := hc
    exact bounds with ennTop, topIn
  . have finiteS : ∀ a ∈ S, a ∈ ℝ ∧ realZero ≤ a
      intros a ha
      have aM := inside with a, ha
      have aT : a ≠ ennTop
        intro e
        rw e at ha
        exact topIn with ha
      exact ennreal.finite with aM, aT
    have SR : S ⊆ ℝ
      intros a ha
      have fa := finiteS with a, ha
      exact fa.left
    by_cases empty : ∃ x, x ∈ S
    . by_cases bounded : ∃ B ∈ ℝ, ∀ x ∈ S, x ≤ B
      . obtain ⟨U, UR, upper, least⟩ := real.sup_exists with SR, empty, bounded
        obtain ⟨x0, x0S⟩ := empty
        have fx0 := finiteS with x0, x0S
        have x0R := fx0.left
        have x0Nn := fx0.right
        have le0 := upper with x0, x0S
        have UNn : realZero ≤ U by linarith
        have UM := ennreal.of_real with UR, UNn
        have UT := ennreal.not_top_of_real with UR
        have Uupper : EnnUpperBound(S, U)
          unfold EnnUpperBound
          refine ⟨UM, ?_⟩
          intros a ha
          have aM := inside with a, ha
          have fa := finiteS with a, ha
          have aR := fa.left
          have aT := ennreal.not_top_of_real with aR
          have le := upper with a, ha
          unfold EnnLe
          refine ⟨aM, UM, ?_⟩
          right
          exact ⟨aT, le⟩
        refine ⟨U, UM, Uupper, ?_⟩
        intros c hc
        have hc2 := hc
        obtain ⟨cM, bounds⟩ := hc2
        by_cases cT : c = ennTop
        . rw cT
          exact EnnLe.top with UM
        . obtain ⟨cR, cNn⟩ := ennreal.finite with cM, cT
          have cb : ∀ x ∈ S, x ≤ c
            intros x hx
            have le := bounds with x, hx
            obtain ⟨xM, cM2, alt⟩ := le
            cases alt with cT2 | fin
            . exfalso
              exact cT with cT2
            . exact fin.right
          have Uc := least with c, cR, cb
          unfold EnnLe
          refine ⟨UM, cM, ?_⟩
          right
          exact ⟨UT, Uc⟩
      . refine ⟨ennTop, tm, topUpper, ?_⟩
        intros c hc
        have hc2 := hc
        obtain ⟨cM, bounds⟩ := hc2
        by_cases cT : c = ennTop
        . rw cT
          exact EnnLe.reflexive with tm
        . exfalso
          obtain ⟨cR, cNn⟩ := ennreal.finite with cM, cT
          apply bounded
          refine ⟨c, cR, ?_⟩
          intros x hx
          have le := bounds with x, hx
          obtain ⟨xM, cM2, alt⟩ := le
          cases alt with cT2 | fin
          . exfalso
            exact cT with cT2
          . exact fin.right
    . have zUpper : EnnUpperBound(S, realZero)
        unfold EnnUpperBound
        refine ⟨zm, ?_⟩
        intros a ha
        exfalso
        apply empty
        exact ⟨a, ha⟩
      refine ⟨realZero, zm, zUpper, ?_⟩
      intros c hc
      obtain ⟨cM, bounds⟩ := hc
      exact EnnLe.zero with cM

theorem ennSup.eq_of_lub (S b : Set)
  requires member : b ∈ ennreal
  requires upper : EnnUpperBound(S, b)
  requires least : ∀ c, EnnUpperBound(S, c) → EnnLe(b, c)
  shows ennSup(S) = b
proof
  unfold ennSup
  apply union.of_unique
  . apply ennSup.family.membership.backward
    exact ⟨member, upper, least⟩
  . intros w hw
    obtain ⟨wM, wUpper, wLeast⟩ := ennSup.family.membership.forward with hw
    have l1 := wLeast with b, upper
    have l2 := least with w, wUpper
    exact EnnLe.antisymmetric with l1, l2

theorem ennInf.eq_of_glb (S b : Set)
  requires member : b ∈ ennreal
  requires lower : EnnLowerBound(S, b)
  requires greatest : ∀ c, EnnLowerBound(S, c) → EnnLe(c, b)
  shows ennInf(S) = b
proof
  unfold ennInf
  apply union.of_unique
  . apply ennInf.family.membership.backward
    exact ⟨member, lower, greatest⟩
  . intros w hw
    obtain ⟨wM, wLower, wGreatest⟩ := ennInf.family.membership.forward with hw
    have l1 := wGreatest with b, lower
    have l2 := greatest with w, wLower
    exact EnnLe.antisymmetric with l2, l1

-- The lower bounds in [0, ∞] of a set.
def ennLowerBounds (S : Set) : Set := { b ∈ ennreal | EnnLowerBound(S, b) }

theorem EnnLe.of_not_lt (a b : Set)
  requires memberA : a ∈ ennreal
  requires memberB : b ∈ ennreal
  requires notLt : ¬EnnLt(a, b)
  shows EnnLe(b, a)
proof
  have t := EnnLe.total with memberA, memberB
  cases t with ab | ba
  . by_cases e : a = b
    . rw e
      exact EnnLe.reflexive with memberB
    . exfalso
      apply notLt
      unfold EnnLt
      exact ⟨ab, e⟩
  . exact ba

-- Every subset of [0, ∞] has a least upper bound and a greatest lower
-- bound (complete lattice).
theorem ennSup.least_upper (S : Set)
  requires inside : S ⊆ ennreal
  shows EnnUpperBound(S, ennSup(S)) ∧
    (∀ c, EnnUpperBound(S, c) → EnnLe(ennSup(S), c))
proof
  obtain ⟨b, bM, ub, least⟩ := ennSup.exists with inside
  have e := ennSup.eq_of_lub with bM, ub, least
  refine ⟨?_, ?_⟩
  . rw e
    exact ub
  . intros c hc
    rw e
    exact least with c, hc

theorem ennInf.greatest_lower (S : Set)
  requires inside : S ⊆ ennreal
  shows EnnLowerBound(S, ennInf(S)) ∧
    (∀ c, EnnLowerBound(S, c) → EnnLe(c, ennInf(S)))
proof
  have LM : ennLowerBounds(S) ⊆ ennreal
    intros b hb
    obtain ⟨bM, rest⟩ := hb
    exact bM
  obtain ⟨s, sM, ub, least⟩ := ennSup.exists with LM
  have lower : EnnLowerBound(S, s)
    unfold EnnLowerBound
    refine ⟨sM, ?_⟩
    intros a ha
    have aM := inside with a, ha
    have aUpper : EnnUpperBound(ennLowerBounds(S), a)
      unfold EnnUpperBound
      refine ⟨aM, ?_⟩
      intros b hb
      obtain ⟨bM, bLower⟩ := hb
      obtain ⟨bM2, bounds⟩ := bLower
      exact bounds with a, ha
    exact least with a, aUpper
  have greatest : ∀ c, EnnLowerBound(S, c) → EnnLe(c, s)
    intros c hc
    have hc2 := hc
    obtain ⟨cM, rest⟩ := hc2
    have cL : c ∈ ennLowerBounds(S)
      apply ennLowerBounds.membership.backward
      exact ⟨cM, hc⟩
    obtain ⟨sM2, bounds⟩ := ub
    exact bounds with c, cL
  have e := ennInf.eq_of_glb with sM, lower, greatest
  refine ⟨?_, ?_⟩
  . rw e
    exact lower
  . intros c hc
    rw e
    exact greatest with c, hc

theorem ennSup.empty
  shows ennSup(∅) = realZero
proof
  have zm := ennreal.zero_member
  have upper : EnnUpperBound(∅, realZero)
    unfold EnnUpperBound
    refine ⟨zm, ?_⟩
    intros a ha
    simp at ha
  have least : ∀ c, EnnUpperBound(∅, c) → EnnLe(realZero, c)
    intros c hc
    obtain ⟨cM, rest⟩ := hc
    exact EnnLe.zero with cM
  exact ennSup.eq_of_lub with zm, upper, least

theorem ennInf.empty
  shows ennInf(∅) = ennTop
proof
  have tm := ennreal.top_member
  have lower : EnnLowerBound(∅, ennTop)
    unfold EnnLowerBound
    refine ⟨tm, ?_⟩
    intros a ha
    simp at ha
  have greatest : ∀ c, EnnLowerBound(∅, c) → EnnLe(c, ennTop)
    intros c hc
    obtain ⟨cM, rest⟩ := hc
    exact EnnLe.top with cM
  exact ennInf.eq_of_glb with tm, lower, greatest

-- Mathlib's ENNReal.lt_iSup_iff / le_iSup.
theorem ennSup.lt_iff (S a : Set)
  requires inside : S ⊆ ennreal
  requires member : a ∈ ennreal
  shows EnnLt(a, ennSup(S)) ↔ (∃ b ∈ S, EnnLt(a, b))
proof
  have lu := ennSup.least_upper with inside
  obtain ⟨ub, least⟩ := lu
  have ub2 := ub
  obtain ⟨sM, bounds⟩ := ub2
  constructor
  . intro lt
    by_contra none
    have aUpper : EnnUpperBound(S, a)
      unfold EnnUpperBound
      refine ⟨member, ?_⟩
      intros b hb
      have bM := inside with b, hb
      have nl : ¬EnnLt(a, b)
        intro l
        apply none
        exact ⟨b, hb, l⟩
      exact EnnLe.of_not_lt with member, bM, nl
    have sa := least with a, aUpper
    obtain ⟨as, ne⟩ := lt
    have e := EnnLe.antisymmetric with as, sa
    exact ne with e
  . intro ex
    obtain ⟨b, bS, ab⟩ := ex
    obtain ⟨abLe, abNe⟩ := ab
    have bs := bounds with b, bS
    have as := EnnLe.transitive with abLe, bs
    unfold EnnLt
    refine ⟨as, ?_⟩
    intro e
    rw ← e at bs
    have e2 := EnnLe.antisymmetric with abLe, bs
    exact abNe with e2

-- Helpers: finite sums in [0, ∞].
theorem ennFiniteSum.finite_value (f F : Set)
  requires finite : Finite(F)
  requires values : ∀ i ∈ F, f(i) ∈ ennreal
  requires noTop : ∀ i ∈ F, f(i) ≠ ennTop
  shows ennFiniteSum(f, F) = realFiniteSum(f, F)
proof
  have real : ∀ i ∈ F, f(i) ∈ ℝ
    intros i hi
    have fi := ennreal.finite with (values with i, hi), (noTop with i, hi)
    exact fi.left
  have nonneg : ∀ i ∈ F, realZero ≤ f(i)
    intros i hi
    have fi := ennreal.finite with (values with i, hi), (noTop with i, hi)
    exact fi.right
  have sR := realFiniteSum.real with finite, real
  have sNn := realFiniteSum.nonneg with finite, real, nonneg
  have sM := ennreal.of_real with sR, sNn
  unfold ennFiniteSum
  apply union.of_unique
  . apply ennFiniteSum.family.membership.backward
    refine ⟨sM, ?_⟩
    left
    exact ⟨noTop, rfl⟩
  . intros w hw
    obtain ⟨wM, alt⟩ := ennFiniteSum.family.membership.forward with hw
    cases alt with fin | top
    . exact fin.right
    . exfalso
      obtain ⟨ex, rest⟩ := top
      obtain ⟨i, hi, fi⟩ := ex
      exact (noTop with i, hi) with fi

theorem ennFiniteSum.top_value (f F : Set)
  requires top : ∃ i ∈ F, f(i) = ennTop
  shows ennFiniteSum(f, F) = ennTop
proof
  have tm := ennreal.top_member
  unfold ennFiniteSum
  apply union.of_unique
  . apply ennFiniteSum.family.membership.backward
    refine ⟨tm, ?_⟩
    right
    exact ⟨top, rfl⟩
  . intros w hw
    obtain ⟨wM, alt⟩ := ennFiniteSum.family.membership.forward with hw
    cases alt with fin | t
    . exfalso
      obtain ⟨noTop, rest⟩ := fin
      obtain ⟨i, hi, fi⟩ := top
      exact (noTop with i, hi) with fi
    . exact t.right

theorem ennFiniteSum.member_helper (f F : Set)
  requires finite : Finite(F)
  requires values : ∀ i ∈ F, f(i) ∈ ennreal
  shows ennFiniteSum(f, F) ∈ ennreal
proof
  by_cases top : ∃ i ∈ F, f(i) = ennTop
  . rw ennFiniteSum.top_value with top
    exact ennreal.top_member
  . have noTop : ∀ i ∈ F, f(i) ≠ ennTop
      intros i hi e
      apply top
      exact ⟨i, hi, e⟩
    have real : ∀ i ∈ F, f(i) ∈ ℝ
      intros i hi
      have fi := ennreal.finite with (values with i, hi), (noTop with i, hi)
      exact fi.left
    have nonneg : ∀ i ∈ F, realZero ≤ f(i)
      intros i hi
      have fi := ennreal.finite with (values with i, hi), (noTop with i, hi)
      exact fi.right
    rw ennFiniteSum.finite_value with finite, values, noTop
    have sR := realFiniteSum.real with finite, real
    have sNn := realFiniteSum.nonneg with finite, real, nonneg
    exact ennreal.of_real with sR, sNn

theorem ennFiniteSum.mono_set (f E F : Set)
  requires finite : Finite(F)
  requires inside : E ⊆ F
  requires values : ∀ i ∈ F, f(i) ∈ ennreal
  shows EnnLe(ennFiniteSum(f, E), ennFiniteSum(f, F))
proof
  have finiteE := Finite.subset with finite, inside
  have valuesE : ∀ i ∈ E, f(i) ∈ ennreal
    intros i hi
    exact values with i, (inside with i, hi)
  have mE := ennFiniteSum.member_helper with finiteE, valuesE
  by_cases top : ∃ i ∈ F, f(i) = ennTop
  . rw ennFiniteSum.top_value at f, F with top
    exact EnnLe.top with mE
  . have noTop : ∀ i ∈ F, f(i) ≠ ennTop
      intros i hi e
      apply top
      exact ⟨i, hi, e⟩
    have noTopE : ∀ i ∈ E, f(i) ≠ ennTop
      intros i hi
      exact noTop with i, (inside with i, hi)
    have real : ∀ i ∈ F, f(i) ∈ ℝ
      intros i hi
      have fi := ennreal.finite with (values with i, hi), (noTop with i, hi)
      exact fi.left
    have nonneg : ∀ i ∈ F, realZero ≤ f(i)
      intros i hi
      have fi := ennreal.finite with (values with i, hi), (noTop with i, hi)
      exact fi.right
    have mF := ennFiniteSum.member_helper with finite, values
    rw ennFiniteSum.finite_value at f, E with finiteE, valuesE, noTopE
    rw ennFiniteSum.finite_value at f, F with finite, values, noTop
    rw ennFiniteSum.finite_value at f, E with finiteE, valuesE, noTopE at mE
    rw ennFiniteSum.finite_value at f, F with finite, values, noTop at mF
    have realE : ∀ i ∈ E, f(i) ∈ ℝ
      intros i hi
      exact real with i, (inside with i, hi)
    have eR := realFiniteSum.real with finiteE, realE
    have eT := ennreal.not_top_of_real with eR
    have le := realFiniteSum.mono_set with finite, inside, real, nonneg
    unfold EnnLe
    refine ⟨mE, mF, ?_⟩
    right
    exact ⟨eT, le⟩

theorem finiteSumsOf.inside (f I : Set)
  requires values : ∀ i ∈ I, f(i) ∈ ennreal
  shows finiteSumsOf(f, I) ⊆ ennreal
proof
  intros a ha
  obtain ⟨F, FIn, e⟩ := finiteSumsOf.membership.forward with ha
  obtain ⟨FP, finite⟩ := finiteSubsets.membership.forward with FIn
  have FI := (powerset.membership_iff at F, I).forward with FP
  have valuesF : ∀ i ∈ F, f(i) ∈ ennreal
    intros i hi
    exact values with i, (FI with i, hi)
  rw ← e
  exact ennFiniteSum.member_helper with finite, valuesF

theorem ennTsum.upper (f I F : Set)
  requires values : ∀ i ∈ I, f(i) ∈ ennreal
  requires finite : Finite(F)
  requires inside : F ⊆ I
  shows EnnLe(ennFiniteSum(f, F), ennTsum(f, I))
proof
  have sub := finiteSumsOf.inside with values
  have lu := ennSup.least_upper with sub
  obtain ⟨ub, least⟩ := lu
  obtain ⟨sM, bounds⟩ := ub
  have FP := (powerset.membership_iff at F, I).backward with inside
  have FIn : F ∈ finiteSubsets(I) := finiteSubsets.membership.backward with ⟨FP, finite⟩
  have mem : ennFiniteSum(f, F) ∈ finiteSumsOf(f, I) := finiteSumsOf.membership.backward with ⟨F, FIn, rfl⟩
  unfold ennTsum
  exact bounds with ennFiniteSum(f, F), mem

theorem ennTsum.least (f I c : Set)
  requires values : ∀ i ∈ I, f(i) ∈ ennreal
  requires member : c ∈ ennreal
  requires bound : ∀ F ∈ finiteSubsets(I), EnnLe(ennFiniteSum(f, F), c)
  shows EnnLe(ennTsum(f, I), c)
proof
  have sub := finiteSumsOf.inside with values
  have lu := ennSup.least_upper with sub
  obtain ⟨ub, least⟩ := lu
  have cUpper : EnnUpperBound(finiteSumsOf(f, I), c)
    unfold EnnUpperBound
    refine ⟨member, ?_⟩
    intros a ha
    obtain ⟨F, FIn, e⟩ := finiteSumsOf.membership.forward with ha
    rw ← e
    exact bound with F, FIn
  unfold ennTsum
  exact least with c, cUpper

theorem ennFiniteSum.congr (f g F : Set)
  requires agree : ∀ i ∈ F, f(i) = g(i)
  shows ennFiniteSum(f, F) = ennFiniteSum(g, F)
proof
  have rs : realFiniteSum(f, F) = realFiniteSum(g, F)
    unfold realFiniteSum
    exact groupFiniteSum.congr with agree
  have fam : ennFiniteSum.family(f, F) = ennFiniteSum.family(g, F)
    ext S
    constructor
    . intro h
      obtain ⟨SM, alt⟩ := ennFiniteSum.family.membership.forward with h
      apply ennFiniteSum.family.membership.backward
      refine ⟨SM, ?_⟩
      cases alt with fin | top
      . left
        obtain ⟨noTop, e⟩ := fin
        refine ⟨?_, ?_⟩
        . intros i hi
          rw ← agree with i, hi
          exact noTop with i, hi
        . rw e
          exact rs
      . right
        obtain ⟨ex, e⟩ := top
        obtain ⟨i, hi, fi⟩ := ex
        refine ⟨?_, e⟩
        refine ⟨i, hi, ?_⟩
        rw ← agree with i, hi
        exact fi
    . intro h
      obtain ⟨SM, alt⟩ := ennFiniteSum.family.membership.forward with h
      apply ennFiniteSum.family.membership.backward
      refine ⟨SM, ?_⟩
      cases alt with fin | top
      . left
        obtain ⟨noTop, e⟩ := fin
        refine ⟨?_, ?_⟩
        . intros i hi
          rw agree with i, hi
          exact noTop with i, hi
        . rw e
          symm
          exact rs
      . right
        obtain ⟨ex, e⟩ := top
        obtain ⟨i, hi, fi⟩ := ex
        refine ⟨?_, e⟩
        refine ⟨i, hi, ?_⟩
        rw agree with i, hi
        exact fi
  unfold ennFiniteSum
  rw fam

theorem ennFiniteSum.mono_fun (f g F : Set)
  requires finite : Finite(F)
  requires valuesF : ∀ i ∈ F, f(i) ∈ ennreal
  requires valuesG : ∀ i ∈ F, g(i) ∈ ennreal
  requires le : ∀ i ∈ F, EnnLe(f(i), g(i))
  shows EnnLe(ennFiniteSum(f, F), ennFiniteSum(g, F))
proof
  have mF := ennFiniteSum.member_helper with finite, valuesF
  have mG := ennFiniteSum.member_helper with finite, valuesG
  by_cases top : ∃ i ∈ F, g(i) = ennTop
  . rw ennFiniteSum.top_value at g, F with top
    exact EnnLe.top with mF
  . have noTopG : ∀ i ∈ F, g(i) ≠ ennTop
      intros i hi e
      apply top
      exact ⟨i, hi, e⟩
    have noTopF : ∀ i ∈ F, f(i) ≠ ennTop
      intros i hi
      have l := le with i, hi
      obtain ⟨fM, gM, alt⟩ := l
      cases alt with gT | fin
      . exfalso
        exact (noTopG with i, hi) with gT
      . exact fin.left
    have realF : ∀ i ∈ F, f(i) ∈ ℝ
      intros i hi
      have fi := ennreal.finite with (valuesF with i, hi), (noTopF with i, hi)
      exact fi.left
    have leR : ∀ i ∈ F, f(i) ≤ g(i)
      intros i hi
      have l := le with i, hi
      obtain ⟨fM, gM, alt⟩ := l
      cases alt with gT | fin
      . exfalso
        exact (noTopG with i, hi) with gT
      . exact fin.right
    rw ennFiniteSum.finite_value at f, F with finite, valuesF, noTopF
    rw ennFiniteSum.finite_value at g, F with finite, valuesG, noTopG
    rw ennFiniteSum.finite_value at f, F with finite, valuesF, noTopF at mF
    rw ennFiniteSum.finite_value at g, F with finite, valuesG, noTopG at mG
    have fR := realFiniteSum.real with finite, realF
    have fT := ennreal.not_top_of_real with fR
    have l2 := realFiniteSum.mono_fun with finite, leR
    unfold EnnLe
    refine ⟨mF, mG, ?_⟩
    right
    exact ⟨fT, l2⟩

theorem ennTsum.member_helper (f I : Set)
  requires values : ∀ i ∈ I, f(i) ∈ ennreal
  shows ennTsum(f, I) ∈ ennreal
proof
  have sub := finiteSumsOf.inside with values
  have lu := ennSup.least_upper with sub
  obtain ⟨ub, least⟩ := lu
  obtain ⟨sM, bounds⟩ := ub
  unfold ennTsum
  exact sM

theorem realFiniteSum.zero (f F : Set)
  requires finite : Finite(F)
  requires zero : ∀ i ∈ F, f(i) = realZero
  shows realFiniteSum(f, F) = realZero
proof
  obtain ⟨abelian, c, m, o⟩ := realAdditiveGroup.parts
  have zero2 : ∀ i ∈ F, f(i) = Group.one(realAdditiveGroup)
    rw o
    exact zero
  have z := groupFiniteSum.zero at realAdditiveGroup, F, f with abelian, finite, zero2
  rw o at z
  unfold realFiniteSum
  exact z

-- A sum in [0, ∞] whose terms vanish off a finite set F is the finite sum
-- over F.
theorem ennTsum.support (f I F : Set)
  requires values : ∀ i ∈ I, f(i) ∈ ennreal
  requires finite : Finite(F)
  requires inside : F ⊆ I
  requires zero : ∀ i ∈ I, i ∉ F → f(i) = realZero
  shows ennTsum(f, I) = ennFiniteSum(f, F)
proof
  have valuesF : ∀ i ∈ F, f(i) ∈ ennreal
    intros i hi
    exact values with i, (inside with i, hi)
  have mF := ennFiniteSum.member_helper with finite, valuesF
  have upper := ennTsum.upper with values, finite, inside
  have least : EnnLe(ennTsum(f, I), ennFiniteSum(f, F))
    apply ennTsum.least with values, mF
    intros E hE
    obtain ⟨EP, finiteE⟩ := finiteSubsets.membership.forward with hE
    have EI := (powerset.membership_iff at E, I).forward with EP
    have dsub : E ∖ F ⊆ E
      intros x hx
      obtain ⟨xE, rest⟩ := difference.membership.forward with hx
      exact xE
    have finiteD := Finite.subset with finiteE, dsub
    have finiteU := Finite.union with finite, finiteD
    have EU : E ⊆ F ∪ (E ∖ F)
      intros x hx
      by_cases xF : x ∈ F
      . simp
      . simp
    have UI : F ∪ (E ∖ F) ⊆ I
      intros x hx
      have split := union2.membership.forward with hx
      cases split with xF | xD
      . exact inside with x, xF
      . obtain ⟨xE, rest⟩ := difference.membership.forward with xD
        exact EI with x, xE
    have valuesU : ∀ i ∈ F ∪ (E ∖ F), f(i) ∈ ennreal
      intros i hi
      exact values with i, (UI with i, hi)
    have l1 := ennFiniteSum.mono_set with finiteU, EU, valuesU
    have same : ennFiniteSum(f, F ∪ (E ∖ F)) = ennFiniteSum(f, F)
      by_cases top : ∃ i ∈ F, f(i) = ennTop
      . obtain ⟨i, iF, iT⟩ := top
        have iU : i ∈ F ∪ (E ∖ F) by simp
        have ex1 : ∃ j ∈ F ∪ (E ∖ F), f(j) = ennTop := ⟨i, iU, iT⟩
        have ex2 : ∃ j ∈ F, f(j) = ennTop := ⟨i, iF, iT⟩
        rw ennFiniteSum.top_value at f, F ∪ (E ∖ F) with ex1
        rw ennFiniteSum.top_value at f, F with ex2
      . have noTopF : ∀ i ∈ F, f(i) ≠ ennTop
          intros i hi e
          apply top
          exact ⟨i, hi, e⟩
        have zeroD : ∀ i ∈ E ∖ F, f(i) = realZero
          intros i hi
          obtain ⟨iE, iF⟩ := difference.membership.forward with hi
          exact zero with i, (EI with i, iE), iF
        have zt := ennreal.zero_not_top
        have noTopU : ∀ i ∈ F ∪ (E ∖ F), f(i) ≠ ennTop
          intros i hi
          have split := union2.membership.forward with hi
          cases split with iF | iD
          . exact noTopF with i, iF
          . rw zeroD with i, iD
            exact zt
        have realU : ∀ i ∈ F ∪ (E ∖ F), f(i) ∈ ℝ
          intros i hi
          have fi := ennreal.finite with (valuesU with i, hi), (noTopU with i, hi)
          exact fi.left
        have disjoint : Disjoint(F, E ∖ F)
          unfold Disjoint
          ext x
          constructor
          . intro h
            obtain ⟨xF, xD⟩ := intersection.membership.forward with h
            obtain ⟨xE, xnF⟩ := difference.membership.forward with xD
            exfalso
            exact xnF with xF
          . intro h
            simp at h
        rw ennFiniteSum.finite_value at f, F ∪ (E ∖ F) with finiteU, valuesU, noTopU
        rw ennFiniteSum.finite_value at f, F with finite, valuesF, noTopF
        rw realFiniteSum.union with finite, finiteD, disjoint, realU
        rw realFiniteSum.zero at f, E ∖ F with finiteD, zeroD
        have realF : ∀ i ∈ F, f(i) ∈ ℝ
          intros i hi
          exact realU with i, (union2.left at i, F, E ∖ F with hi)
        have sR := realFiniteSum.real with finite, realF
        ring
    rw same at l1
    exact l1
  exact EnnLe.antisymmetric with least, upper

theorem ennFiniteSum.insert_helper (f F i : Set)
  requires finite : Finite(F)
  requires values : ∀ j ∈ F ∪ {i}, f(j) ∈ ennreal
  requires fresh : i ∉ F
  shows ennFiniteSum(f, F ∪ {i}) = ennAdd(ennFiniteSum(f, F), f(i))
proof
  have fs := Finite.singleton at i
  have finiteU := Finite.union with finite, fs
  have iIn : i ∈ F ∪ {i} by simp
  have valuesF : ∀ j ∈ F, f(j) ∈ ennreal
    intros j hj
    have jIn : j ∈ F ∪ {i} by simp
    exact values with j, jIn
  have fiM := values with i, iIn
  have mF := ennFiniteSum.member_helper with finite, valuesF
  by_cases iT : f(i) = ennTop
  . have ex : ∃ j ∈ F ∪ {i}, f(j) = ennTop := ⟨i, iIn, iT⟩
    rw ennFiniteSum.top_value at f, F ∪ {i} with ex
    rw ennAdd.top_right at ennFiniteSum(f, F), f(i) with iT
  . by_cases top : ∃ j ∈ F, f(j) = ennTop
    . obtain ⟨j, jF, jT⟩ := top
      have jIn : j ∈ F ∪ {i} by simp
      have ex : ∃ k ∈ F ∪ {i}, f(k) = ennTop := ⟨j, jIn, jT⟩
      have ex2 : ∃ k ∈ F, f(k) = ennTop := ⟨j, jF, jT⟩
      rw ennFiniteSum.top_value at f, F ∪ {i} with ex
      rw ennFiniteSum.top_value at f, F with ex2
      rw ennAdd.top_left at ennTop, f(i) with rfl
    . have noTopF : ∀ j ∈ F, f(j) ≠ ennTop
        intros j hj e
        apply top
        exact ⟨j, hj, e⟩
      have noTopU : ∀ j ∈ F ∪ {i}, f(j) ≠ ennTop
        intros j hj
        have split := union2.membership.forward with hj
        cases split with jF | jI
        . exact noTopF with j, jF
        . simp at jI
          rw jI
          exact iT
      have realF : ∀ j ∈ F, f(j) ∈ ℝ
        intros j hj
        have fj := ennreal.finite with (valuesF with j, hj), (noTopF with j, hj)
        exact fj.left
      have nonnegF : ∀ j ∈ F, realZero ≤ f(j)
        intros j hj
        have fj := ennreal.finite with (valuesF with j, hj), (noTopF with j, hj)
        exact fj.right
      obtain ⟨fiR, fiNn⟩ := ennreal.finite with fiM, iT
      have sR := realFiniteSum.real with finite, realF
      have sNn := realFiniteSum.nonneg with finite, realF, nonnegF
      rw ennFiniteSum.finite_value at f, F ∪ {i} with finiteU, values, noTopU
      rw ennFiniteSum.finite_value at f, F with finite, valuesF, noTopF
      rw ennAdd.finite with sR, fiR, sNn, fiNn
      exact realFiniteSum.insert with finite, realF, fiR, fresh

theorem ennFiniteSum.singleton (f a : Set)
  requires value : f(a) ∈ ennreal
  shows ennFiniteSum(f, {a}) = f(a)
proof
  have fe := Finite.empty
  have e : ∅ ∪ {a} = {a}
    ext x
    simp
  have values : ∀ i ∈ ∅ ∪ {a}, f(i) ∈ ennreal
    intros i hi
    simp at hi
    rw hi
    exact value
  have notIn : a ∉ ∅ by simp
  have ins := ennFiniteSum.insert_helper at f, ∅, a with fe, values, notIn
  rw e at ins
  rw ins
  have emp : ennFiniteSum(f, ∅) = realZero
    have noTop : ∀ i ∈ ∅, f(i) ≠ ennTop
      intros i hi
      simp at hi
    have valuesE : ∀ i ∈ ∅, f(i) ∈ ennreal
      intros i hi
      simp at hi
    rw ennFiniteSum.finite_value at f, ∅ with fe, valuesE, noTop
    exact realFiniteSum.empty at f
  rw emp
  have zm := ennreal.zero_member
  rw ennAdd.comm at realZero, f(a) with zm, value
  exact ennAdd.zero at f(a) with value

theorem ennFiniteSum.pair (f a b : Set)
  requires valueA : f(a) ∈ ennreal
  requires valueB : f(b) ∈ ennreal
  requires distinct : a ≠ b
  shows ennFiniteSum(f, {a, b}) = ennAdd(f(a), f(b))
proof
  have e : {a} ∪ {b} = {a, b}
    ext x
    simp
  have fa := Finite.singleton at a
  have values : ∀ i ∈ {a} ∪ {b}, f(i) ∈ ennreal
    intros i hi
    simp at hi
    cases hi with ia | ib
    . rw ia
      exact valueA
    . rw ib
      exact valueB
  have notIn : b ∉ {a}
    intro h
    simp at h
    symm at h
    exact distinct with h
  have ins := ennFiniteSum.insert_helper at f, {a}, b with fa, values, notIn
  rw e at ins
  rw ins
  rw ennFiniteSum.singleton at f, a with valueA

-- Section: Sums in [0, ∞]
theorem ennFiniteSum.member (f F : Set)
  requires finite : Finite(F)
  requires values : ∀ i ∈ F, f(i) ∈ ennreal
  shows ennFiniteSum(f, F) ∈ ennreal
proof
  exact ennFiniteSum.member_helper with finite, values

theorem ennFiniteSum.empty (f : Set)
  shows ennFiniteSum(f, ∅) = realZero
proof
  have fe := Finite.empty
  have values : ∀ i ∈ ∅, f(i) ∈ ennreal
    intros i hi
    simp at hi
  have noTop : ∀ i ∈ ∅, f(i) ≠ ennTop
    intros i hi
    simp at hi
  rw ennFiniteSum.finite_value with fe, values, noTop
  exact realFiniteSum.empty at f

theorem ennFiniteSum.insert (f F i : Set)
  requires finite : Finite(F)
  requires values : ∀ j ∈ F ∪ {i}, f(j) ∈ ennreal
  requires fresh : i ∉ F
  shows ennFiniteSum(f, F ∪ {i}) = ennAdd(ennFiniteSum(f, F), f(i))
proof
  exact ennFiniteSum.insert_helper with finite, values, fresh

theorem ennTsum.member (f I : Set)
  requires values : ∀ i ∈ I, f(i) ∈ ennreal
  shows ennTsum(f, I) ∈ ennreal
proof
  exact ennTsum.member_helper with values

-- The sum of finite values is Topology/Sums' ennSum.
theorem ennTsum.eq_ennSum (f I : Set)
  requires values : ∀ i ∈ I, f(i) ∈ ℝ
  requires nonneg : ∀ i ∈ I, realZero ≤ f(i)
  shows ennTsum(f, I) = ennSum(f, I)
proof
  have eM : ∀ i ∈ I, f(i) ∈ ennreal
    intros i hi
    exact ennreal.of_real with (values with i, hi), (nonneg with i, hi)
  have noTop : ∀ i ∈ I, f(i) ≠ ennTop
    intros i hi
    exact ennreal.not_top_of_real with (values with i, hi)
  have sM := ennSum.member with values, nonneg
  have tM := ennTsum.member_helper with eM
  have finSum : ∀ F ∈ finiteSubsets(I), ennFiniteSum(f, F) = realFiniteSum(f, F) ∧ realFiniteSum(f, F) ∈ ℝ ∧ realZero ≤ realFiniteSum(f, F)
    intros F hF
    obtain ⟨FP, finite⟩ := finiteSubsets.membership.forward with hF
    have FI := (powerset.membership_iff at F, I).forward with FP
    have vF : ∀ i ∈ F, f(i) ∈ ennreal
      intros i hi
      exact eM with i, (FI with i, hi)
    have nF : ∀ i ∈ F, f(i) ≠ ennTop
      intros i hi
      exact noTop with i, (FI with i, hi)
    have rF : ∀ i ∈ F, f(i) ∈ ℝ
      intros i hi
      exact values with i, (FI with i, hi)
    have nnF : ∀ i ∈ F, realZero ≤ f(i)
      intros i hi
      exact nonneg with i, (FI with i, hi)
    have e := ennFiniteSum.finite_value with finite, vF, nF
    have r := realFiniteSum.real with finite, rF
    have nn := realFiniteSum.nonneg with finite, rF, nnF
    exact ⟨e, r, nn⟩
  have upper : EnnLe(ennTsum(f, I), ennSum(f, I))
    apply ennTsum.least with eM, sM
    intros F hF
    obtain ⟨FP, finite⟩ := finiteSubsets.membership.forward with hF
    have FI := (powerset.membership_iff at F, I).forward with FP
    obtain ⟨e, r, nn⟩ := finSum with F, hF
    have fM := ennreal.of_real with r, nn
    have fT := ennreal.not_top_of_real with r
    rw e
    by_cases summable : RealSummable(f, I)
    . have eq := ennSum.of_summable with values, nonneg, summable
      have le := realTsum.finite_le with summable, nonneg, finite, FI
      rw eq at sM
      rw eq
      unfold EnnLe
      refine ⟨fM, sM, ?_⟩
      right
      exact ⟨fT, le⟩
    . have eq := ennSum.of_not_summable with values, nonneg, summable
      rw eq
      exact EnnLe.top with fM
  have lower : EnnLe(ennSum(f, I), ennTsum(f, I))
    by_cases tT : ennTsum(f, I) = ennTop
    . rw tT
      exact EnnLe.top with sM
    . obtain ⟨tR, tNn⟩ := ennreal.finite with tM, tT
      have bounded : ∀ F ∈ finiteSubsets(I), realFiniteSum(f, F) ≤ ennTsum(f, I)
        intros F hF
        obtain ⟨FP, finite⟩ := finiteSubsets.membership.forward with hF
        have FI := (powerset.membership_iff at F, I).forward with FP
        obtain ⟨e, r, nn⟩ := finSum with F, hF
        have up := ennTsum.upper with eM, finite, FI
        rw e at up
        obtain ⟨m1, m2, alt⟩ := up
        cases alt with t2 | fin
        . exfalso
          exact tT with t2
        . exact fin.right
      have iff := RealSummable.nonneg_iff with values, nonneg
      have summable : RealSummable(f, I)
        apply iff.backward
        exact ⟨ennTsum(f, I), tR, bounded⟩
      have eq := ennSum.of_summable with values, nonneg, summable
      have summable2 := summable
      unfold RealSummable at summable2
      obtain ⟨S, SIn, sum⟩ := summable2
      have sumR : RealHasSum(f, I, S)
        unfold RealHasSum
        exact sum
      have teq := RealHasSum.tsum_eq with sumR
      have SR := RealHasSum.real with sumR
      have SNn := RealHasSum.nonneg with values, nonneg, sumR
      have iff2 := RealHasSum.nonneg_iff at f, I, S with values, nonneg
      have char := iff2.forward with sumR
      obtain ⟨below, approx⟩ := char
      have Sle : S ≤ ennTsum(f, I)
        by_contra notLe
        have lt : ennTsum(f, I) < S by linarith
        obtain ⟨F, hF, big⟩ := approx with ennTsum(f, I), tR, lt
        have b := bounded with F, hF
        obtain ⟨e, r, nn⟩ := finSum with F, hF
        linarith
      rw eq
      rw teq
      have SM := ennreal.of_real with SR, SNn
      have ST := ennreal.not_top_of_real with SR
      unfold EnnLe
      refine ⟨SM, tM, ?_⟩
      right
      exact ⟨ST, Sle⟩
  exact EnnLe.antisymmetric with upper, lower

theorem ennTsum.finite (f F : Set)
  requires finite : Finite(F)
  requires values : ∀ i ∈ F, f(i) ∈ ennreal
  shows ennTsum(f, F) = ennFiniteSum(f, F)
proof
  have refl := Subset.reflexive at F
  have FP := (powerset.membership_iff at F, F).backward with refl
  have mF := ennFiniteSum.member_helper with finite, values
  have upper := ennTsum.upper with values, finite, refl
  have least : EnnLe(ennTsum(f, F), ennFiniteSum(f, F))
    apply ennTsum.least with values, mF
    intros E hE
    obtain ⟨EP, finiteE⟩ := finiteSubsets.membership.forward with hE
    have EF := (powerset.membership_iff at E, F).forward with EP
    exact ennFiniteSum.mono_set with finite, EF, values
  exact EnnLe.antisymmetric with least, upper

theorem ennTsum.congr (f g I : Set)
  requires agree : ∀ i ∈ I, f(i) = g(i)
  shows ennTsum(f, I) = ennTsum(g, I)
proof
  have same : finiteSumsOf(f, I) = finiteSumsOf(g, I)
    ext a
    constructor
    . intro h
      obtain ⟨F, FIn, e⟩ := finiteSumsOf.membership.forward with h
      obtain ⟨FP, finite⟩ := finiteSubsets.membership.forward with FIn
      have FI := (powerset.membership_iff at F, I).forward with FP
      have agreeF : ∀ i ∈ F, f(i) = g(i)
        intros i hi
        exact agree with i, (FI with i, hi)
      have c := ennFiniteSum.congr with agreeF
      rw c at e
      exact finiteSumsOf.membership.backward with ⟨F, FIn, e⟩
    . intro h
      obtain ⟨F, FIn, e⟩ := finiteSumsOf.membership.forward with h
      obtain ⟨FP, finite⟩ := finiteSubsets.membership.forward with FIn
      have FI := (powerset.membership_iff at F, I).forward with FP
      have agreeF : ∀ i ∈ F, f(i) = g(i)
        intros i hi
        exact agree with i, (FI with i, hi)
      have c := ennFiniteSum.congr with agreeF
      rw ← c at e
      exact finiteSumsOf.membership.backward with ⟨F, FIn, e⟩
  unfold ennTsum
  rw same

theorem ennTsum.term_le (f I j : Set)
  requires values : ∀ i ∈ I, f(i) ∈ ennreal
  requires member : j ∈ I
  shows EnnLe(f(j), ennTsum(f, I))
proof
  have fe := Finite.empty
  have fs := Finite.singleton at j
  have finiteU := Finite.union with fe, fs
  have notIn : j ∉ ∅ by simp
  have sub : ∅ ∪ {j} ⊆ I
    intros i hi
    simp at hi
    rw hi
    exact member
  have valuesU : ∀ i ∈ ∅ ∪ {j}, f(i) ∈ ennreal
    intros i hi
    exact values with i, (sub with i, hi)
  have upper := ennTsum.upper with values, finiteU, sub
  rw ennFiniteSum.insert with fe, valuesU, notIn at upper
  rw ennFiniteSum.empty at upper
  have fjM := values with j, member
  have zm := ennreal.zero_member
  rw ennAdd.comm at realZero, f(j) with zm, fjM at upper
  rw ennAdd.zero at f(j) with fjM at upper
  exact upper

theorem ennTsum.mono (f g I : Set)
  requires valuesF : ∀ i ∈ I, f(i) ∈ ennreal
  requires valuesG : ∀ i ∈ I, g(i) ∈ ennreal
  requires le : ∀ i ∈ I, EnnLe(f(i), g(i))
  shows EnnLe(ennTsum(f, I), ennTsum(g, I))
proof
  have gM := ennTsum.member_helper with valuesG
  apply ennTsum.least with valuesF, gM
  intros F hF
  obtain ⟨FP, finite⟩ := finiteSubsets.membership.forward with hF
  have FI := (powerset.membership_iff at F, I).forward with FP
  have vF : ∀ i ∈ F, f(i) ∈ ennreal
    intros i hi
    exact valuesF with i, (FI with i, hi)
  have vG : ∀ i ∈ F, g(i) ∈ ennreal
    intros i hi
    exact valuesG with i, (FI with i, hi)
  have lF : ∀ i ∈ F, EnnLe(f(i), g(i))
    intros i hi
    exact le with i, (FI with i, hi)
  have l1 := ennFiniteSum.mono_fun with finite, vF, vG, lF
  have l2 := ennTsum.upper with valuesG, finite, FI
  exact EnnLe.transitive with l1, l2

theorem ennTsum.add (f g h I : Set)
  requires valuesF : ∀ i ∈ I, f(i) ∈ ennreal
  requires valuesG : ∀ i ∈ I, g(i) ∈ ennreal
  requires sum : ∀ i ∈ I, h(i) = ennAdd(f(i), g(i))
  shows ennTsum(h, I) = ennAdd(ennTsum(f, I), ennTsum(g, I))
proof
  sorry

theorem ennTsum.mul_left (f h I c : Set)
  requires values : ∀ i ∈ I, f(i) ∈ ennreal
  requires member : c ∈ ennreal
  requires product : ∀ i ∈ I, h(i) = ennMul(c, f(i))
  shows ennTsum(h, I) = ennMul(c, ennTsum(f, I))
proof
  sorry

-- Reindexing along a bijection, and a subfamily.
theorem ennTsum.reindex (f e h I J : Set)
  requires values : ∀ j ∈ J, f(j) ∈ ennreal
  requires bijective : BijectiveBetween(e, I, J)
  requires composite : ∀ i ∈ I, h(i) = f(e(i))
  shows ennTsum(h, I) = ennTsum(f, J)
proof
  sorry

theorem ennTsum.subset_le (f I J : Set)
  requires values : ∀ i ∈ I, f(i) ∈ ennreal
  requires inside : J ⊆ I
  shows EnnLe(ennTsum(f, J), ennTsum(f, I))
proof
  have valuesJ : ∀ i ∈ J, f(i) ∈ ennreal
    intros i hi
    exact values with i, (inside with i, hi)
  have iM := ennTsum.member_helper with values
  apply ennTsum.least with valuesJ, iM
  intros F hF
  obtain ⟨FP, finite⟩ := finiteSubsets.membership.forward with hF
  have FJ := (powerset.membership_iff at F, J).forward with FP
  have FI := Subset.transitive with FJ, inside
  exact ennTsum.upper with values, finite, FI

-- A sum over a disjoint union.
theorem ennTsum.union (f I J : Set)
  requires values : ∀ i ∈ I ∪ J, f(i) ∈ ennreal
  requires disjoint : Disjoint(I, J)
  shows ennTsum(f, I ∪ J) = ennAdd(ennTsum(f, I), ennTsum(f, J))
proof
  sorry

-- Iterated sums over a product (Mathlib's ENNReal.tsum_prod and
-- ENNReal.tsum_comm).
theorem ennTsum.prod (f I J : Set)
  requires values : ∀ p ∈ I × J, f(p) ∈ ennreal
  shows ennTsum(f, I × J) =
    ennTsum(ennRowSums(f, I, J), I)
proof
  sorry

theorem ennTsum.comm (f I J : Set)
  requires values : ∀ i ∈ I, ∀ j ∈ J, f(i)(j) ∈ ennreal
  shows ennTsum(ennSumsOf(f, I, J), I) = ennTsum(ennColumnSums(f, I, J), J)
proof
  sorry

-- Over ℕ the sum is the supremum of the partial sums over {0, …, n − 1}.
theorem ennTsum.nat_eq_sup (f : Set)
  requires values : ∀ n ∈ ℕ, f(n) ∈ ennreal
  shows ennTsum(f, ℕ) = ennSupOn(ennPartialSums(f), ℕ)
proof
  sorry

-- The sum of a sequence of suprema of increasing sequences is the
-- supremum of the sums (Mathlib's ENNReal.tsum_iSup... in the monotone
-- form used for monotone convergence).
theorem ennTsum.sup_increasing (u I : Set)
  requires values : ∀ n ∈ ℕ, ∀ i ∈ I, u(n)(i) ∈ ennreal
  requires increasing : ∀ m ∈ ℕ, ∀ n ∈ ℕ, m ≤ n → ∀ i ∈ I, EnnLe(u(m)(i), u(n)(i))
  shows ennTsum(ennPointwiseSup(u, I), I) = ennSupOn(ennSumsOf(u, ℕ, I), ℕ)
proof
  sorry

-- A finite sum is finite exactly when every term is (Mathlib's
-- ENNReal.tsum_ne_top for finite sets / ENNReal.tsum_coe_ne_top_iff_summable).
theorem ennTsum.finite_iff_summable (f I : Set)
  requires values : ∀ i ∈ I, f(i) ∈ ℝ
  requires nonneg : ∀ i ∈ I, realZero ≤ f(i)
  shows ennTsum(f, I) ≠ ennTop ↔ RealSummable(f, I)
proof
  have eq := ennTsum.eq_ennSum with values, nonneg
  rw eq
  constructor
  . intro nt
    by_contra ns
    have e := ennSum.of_not_summable with values, nonneg, ns
    exact nt with e
  . intro s
    have e := ennSum.of_summable with values, nonneg, s
    have s2 := s
    unfold RealSummable at s2
    obtain ⟨S, SIn, sum⟩ := s2
    have sumR : RealHasSum(f, I, S)
      unfold RealHasSum
      exact sum
    have teq := RealHasSum.tsum_eq with sumR
    have SR := RealHasSum.real with sumR
    rw e
    rw teq
    exact ennreal.not_top_of_real with SR

end MeasurableSpaces
