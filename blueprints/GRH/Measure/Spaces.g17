-- Measurable spaces: σ-algebras on a set, bundled as a measurable space
-- of its carrier and its measurable sets; the σ-algebra generated by a
-- family, Dynkin's π-λ theorem; measurable maps, embeddings and
-- equivalences; the Borel σ-algebra of a topological space and the
-- measurable structures of ℝ, ℂ, ℝⁿ and [0, ∞]; products, finite powers,
-- subspaces and preimage σ-algebras; measurability of the arithmetic
-- operations, of continuous maps, of piecewise definitions and of
-- pointwise limits; and the arithmetic of [0, ∞] (sums, products, least
-- upper bounds, countable sums) that measures and lower integrals take
-- their values in.
-- Part of the GRH blueprint.
-- Planned home: MeasureTheory/MeasurableSpace.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Measure.Spaces
import GRH.Normed.InnerProduct
import Grace.Cumulus.Cardinal.Countable
import Grace.Cumulus.Geometry.Absorption.CountableUnion
import Grace.Cumulus.Topology.Real.RationalBase

section MeasurableSpaces
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)

-- Section: σ-algebras and measurable spaces
-- A σ-algebra on A: a family of subsets of A containing A, closed under
-- complements in A and under unions of countable subfamilies (Mathlib's
-- MeasurableSpace). A countable subfamily is a set of sets that injects
-- into ℕ, so a countable union needs no choice of enumeration.
predicate SigmaAlgebra (A M : Set) :=
  M ⊆ 𝒫(A) ∧ A ∈ M ∧ (∀ S ∈ M, A ∖ S ∈ M) ∧
  (∀ C, C ⊆ M → Countable(C) → ⋃(C) ∈ M)

-- A measurable space is a structure of its carrier and its σ-algebra,
-- built by MeasurableSpace.mk(A, M) and read back by the projections
-- MeasurableSpace.carrier and MeasurableSpace.sets.
structure MeasurableSpace
  | carrier : Set
  | sets : Set
  where
    sets_subsets : sets ⊆ 𝒫(carrier)
    carrier_measurable : carrier ∈ sets
    compl_measurable : ∀ S ∈ sets, carrier ∖ S ∈ sets
    union_measurable : ∀ C, C ⊆ sets → Countable(C) → ⋃(C) ∈ sets

-- S is a measurable set of X (Mathlib's MeasurableSet).
predicate MeasurableSet (X S : Set) := S ∈ MeasurableSpace.sets(X)

-- The σ-algebra on A generated by a family G of subsets of A: the sets
-- lying in every σ-algebra on A that contains G (Mathlib's
-- MeasurableSpace.generateFrom). The σ-algebras range over 𝒫(𝒫(A)), so
-- the definition is a separation and no choice is made.
def generatedSigma (A G : Set) : Set :=
  { S ∈ 𝒫(A) | ∀ M ∈ 𝒫(𝒫(A)), SigmaAlgebra(A, M) → G ∩ 𝒫(A) ⊆ M → S ∈ M }
def generatedSpace (A G : Set) : Set := MeasurableSpace.mk(A, generatedSigma(A, G))

-- A π-system is closed under binary intersections; a Dynkin system (a
-- λ-system) on A contains A and is closed under complements and under
-- unions of pairwise disjoint sequences.
predicate PiSystem (G : Set) := ∀ S ∈ G, ∀ T ∈ G, S ∩ T ∈ G
predicate PairwiseDisjointSequence (f : Set) :=
  ∀ m ∈ ℕ, ∀ n ∈ ℕ, m ≠ n → Disjoint(f(m), f(n))
def valuesOn (f A : Set) : Set := { f(x) | x ∈ A }
def sequenceUnion (f : Set) : Set := ⋃(valuesOn(f, ℕ))
def sequenceInter (A f : Set) : Set := { x ∈ A | ∀ n ∈ ℕ, x ∈ f(n) }
predicate DynkinSystem (A D : Set) :=
  D ⊆ 𝒫(A) ∧ A ∈ D ∧ (∀ S ∈ D, A ∖ S ∈ D) ∧
  (∀ f, (∀ n ∈ ℕ, f(n) ∈ D) → PairwiseDisjointSequence(f) →
    sequenceUnion(f) ∈ D)

-- Section: Measurable maps
-- f : X → Y is measurable when it maps the carrier of X into that of Y
-- and the preimage of every measurable set of Y is measurable in X. Only
-- the values of f on the carrier of X are read.
predicate MapsInto (f A B : Set) := ∀ x ∈ A, f(x) ∈ B
predicate Measurable (f X Y : Set) :=
  MeasurableSpace(X) ∧ MeasurableSpace(Y) ∧
  MapsInto(f, MeasurableSpace.carrier(X), MeasurableSpace.carrier(Y)) ∧
  (∀ B ∈ MeasurableSpace.sets(Y),
    functionPreimage(f, MeasurableSpace.carrier(X), B) ∈ MeasurableSpace.sets(X))

-- A measurable embedding: injective and measurable, carrying measurable
-- sets to measurable sets (Mathlib's MeasurableEmbedding). A measurable
-- equivalence: moreover onto (Mathlib's MeasurableEquiv, with the inverse
-- read off as the inverse relation).
predicate MeasurableEmbedding (f X Y : Set) :=
  Measurable(f, X, Y) ∧
  InjectiveBetween(f, MeasurableSpace.carrier(X), MeasurableSpace.carrier(Y)) ∧
  (∀ S ∈ MeasurableSpace.sets(X), valuesOn(f, S) ∈ MeasurableSpace.sets(Y))
predicate MeasurableEquiv (f X Y : Set) :=
  MeasurableEmbedding(f, X, Y) ∧
  BijectiveBetween(f, MeasurableSpace.carrier(X), MeasurableSpace.carrier(Y))

-- The preimage σ-algebra of the σ-algebra of Y along f : A → Y (Mathlib's
-- MeasurableSpace.comap) and the subspace σ-algebra on a subset A of the
-- carrier (the measurable space of a subtype).
def comapSigma (f A Y : Set) : Set :=
  { S ∈ 𝒫(A) | ∃ B ∈ MeasurableSpace.sets(Y), S = functionPreimage(f, A, B) }
def measurableSubspace (X A : Set) : Set :=
  MeasurableSpace.mk(A, { S ∈ 𝒫(A) | ∃ B ∈ MeasurableSpace.sets(X), S = B ∩ A })

-- The indicator of S with value c off 0: c on S, z off S, on the set A.
def indicatorOn (A S c z : Set) : Set :=
  { p ∈ A × ({c} ∪ {z}) | (fst(p) ∈ S ∧ snd(p) = c) ∨ (fst(p) ∉ S ∧ snd(p) = z) }

-- The map equal to f on S and to g off S, on A (Mathlib's Set.piecewise).
def piecewiseOn (A S f g : Set) : Set :=
  { p ∈ A × (valuesOn(f, A) ∪ valuesOn(g, A)) |
    (fst(p) ∈ S ∧ snd(p) = f(fst(p))) ∨ (fst(p) ∉ S ∧ snd(p) = g(fst(p))) }

-- Graphs built pointwise: the family i ↦ u(i)(x) over I; the coordinate
-- x ↦ x(i) on A; g ∘ f on A for a graph g; the real and imaginary parts
-- of a complex map on A.
def familyAt (u I x : Set) : Set := { (i, u(i)(x)) | i ∈ I }
def coordinateMap (A i : Set) : Set := { (x, x(i)) | x ∈ A }
def composeOn (g f A : Set) : Set := { (x, g(f(x))) | x ∈ A }
def realPartOn (f A : Set) : Set := { (x, complexRe(f(x))) | x ∈ A }
def imagPartOn (f A : Set) : Set := { (x, complexIm(f(x))) | x ∈ A }

-- Section: Borel σ-algebras
-- The Borel σ-algebra of a topological space X, generated by its open
-- sets, and the space it makes (Mathlib's borel); X carries the Borel
-- structure when its measurable sets are the Borel sets (BorelSpace).
def borelSigma (X : Set) : Set :=
  generatedSigma(TopologicalSpace.carrier(X), TopologicalSpace.opens(X))
def borelSpace (X : Set) : Set :=
  MeasurableSpace.mk(TopologicalSpace.carrier(X), borelSigma(X))
predicate BorelSpace (M X : Set) :=
  MeasurableSpace(M) ∧ TopologicalSpace(X) ∧
  MeasurableSpace.carrier(M) = TopologicalSpace.carrier(X) ∧
  MeasurableSpace.sets(M) = borelSigma(X)

-- The measurable structures of ℝ and of ℂ: their Borel σ-algebras.
def realMeasurableSpace : Set := borelSpace(realLine)
def complexMeasurableSpace : Set := borelSpace(complexSpace)

-- The intervals of ℝ.
def realIoi (A : Set) : Set := { X ∈ ℝ | A < X }
def realIci (A : Set) : Set := { X ∈ ℝ | A ≤ X }
def realIio (B : Set) : Set := { X ∈ ℝ | X < B }
def realIic (B : Set) : Set := { X ∈ ℝ | X ≤ B }
def realIcc (A B : Set) : Set := { X ∈ ℝ | A ≤ X ∧ X ≤ B }
def realIoo (A B : Set) : Set := { X ∈ ℝ | A < X ∧ X < B }
def realIoc (A B : Set) : Set := { X ∈ ℝ | A < X ∧ X ≤ B }
def realIco (A B : Set) : Set := { X ∈ ℝ | A ≤ X ∧ X < B }
def realLowerRays : Set := { E ∈ 𝒫(ℝ) | ∃ B ∈ ℝ, E = realIio(B) }

-- The points of A where a real map is at most C, and where it exceeds C.
def realLeSet (f A C : Set) : Set := { x ∈ A | f(x) ≤ C }
def realGtSet (f A C : Set) : Set := { x ∈ A | C < f(x) }

-- Section: Products and finite powers
-- The measurable rectangles S × T and the product σ-algebra they generate
-- (Mathlib's Prod.instMeasurableSpace).
def rectangles (X Y : Set) : Set :=
  { E ∈ 𝒫(MeasurableSpace.carrier(X) × MeasurableSpace.carrier(Y)) |
    ∃ S ∈ MeasurableSpace.sets(X), ∃ T ∈ MeasurableSpace.sets(Y), E = S × T }
def productMeasurableSpace (X Y : Set) : Set :=
  generatedSpace(MeasurableSpace.carrier(X) × MeasurableSpace.carrier(Y),
    rectangles(X, Y))

-- The finite power Xⁿ = functions n → X with the σ-algebra generated by
-- the cylinders {x | x(i) ∈ S} (Mathlib's MeasurableSpace.pi), for n a
-- natural number or any index set I.
def cylinder (I A i S : Set) : Set := { x ∈ functionSpace(I, A) | x(i) ∈ S }
def cylinders (I X : Set) : Set :=
  { E ∈ 𝒫(functionSpace(I, MeasurableSpace.carrier(X))) |
    ∃ i ∈ I, ∃ S ∈ MeasurableSpace.sets(X),
      E = cylinder(I, MeasurableSpace.carrier(X), i, S) }
def piMeasurableSpace (I X : Set) : Set :=
  generatedSpace(functionSpace(I, MeasurableSpace.carrier(X)), cylinders(I, X))

-- ℝⁿ as the functions n → ℝ with the product σ-algebra, and its box
-- product ∏ᵢ S(i) of sets.
def euclideanMeasurableSpace (n : Nat) : Set := piMeasurableSpace(n, realMeasurableSpace)
def piSet (I A S : Set) : Set := { x ∈ functionSpace(I, A) | ∀ i ∈ I, x(i) ∈ S(i) }

-- The topology of ℝⁿ from its Euclidean norm.
def euclideanTopology (n : Nat) : Set :=
  spaceTopology(euclideanModule(realRing, n), euclideanNorm(realRing, realAbs, n))

-- The Euclidean distance on ℝⁿ and the open ball of radius r about c.
def euclideanDistance (n : Nat, x y : Set) : Set :=
  euclideanNorm(realRing, realAbs, n)(Module.add(euclideanModule(realRing, n))(x,
    Module.neg(euclideanModule(realRing, n))(y)))
def euclideanBall (n : Nat, c r : Set) : Set :=
  { x ∈ functionSpace(n, ℝ) | (euclideanDistance(n, x, c):R) < r }

-- Section: The extended nonnegative reals
-- [0, ∞] is Topology/Sums' ennreal: the nonnegative reals with ∞ = ennTop.
-- Strict order; the real number of a value (∞ ↦ 0, Mathlib's toReal);
-- the value of a real (negative ↦ 0, Mathlib's ENNReal.ofReal).
predicate EnnLt (a b : Set) := EnnLe(a, b) ∧ a ≠ b
def ennToReal (a : Set) : Set :=
  ⋃({ S ∈ ℝ | (a ≠ ennTop ∧ S = a) ∨ (a = ennTop ∧ S = realZero) })
def ennOfReal (X : Set) : Set :=
  ⋃({ S ∈ ennreal | (realZero ≤ X ∧ S = X) ∨ (X < realZero ∧ S = realZero) })

-- a + b, with ∞ absorbing; a · b with 0 · ∞ = 0 (Mathlib's conventions).
def ennAdd (a b : Set) : Set :=
  ⋃({ S ∈ ennreal | (a ≠ ennTop ∧ b ≠ ennTop ∧ S = R[a + b]) ∨
    ((a = ennTop ∨ b = ennTop) ∧ S = ennTop) })
def ennMul (a b : Set) : Set :=
  ⋃({ S ∈ ennreal | (a ≠ ennTop ∧ b ≠ ennTop ∧ S = R[a * b]) ∨
    ((a = realZero ∨ b = realZero) ∧ S = realZero) ∨
    ((a = ennTop ∨ b = ennTop) ∧ a ≠ realZero ∧ b ≠ realZero ∧ S = ennTop) })

-- The least upper bound and the greatest lower bound in [0, ∞] of a set
-- of values; sup ∅ = 0 and inf ∅ = ∞. Every subset of [0, ∞] has both.
predicate EnnUpperBound (S b : Set) := b ∈ ennreal ∧ ∀ a ∈ S, EnnLe(a, b)
predicate EnnLowerBound (S b : Set) := b ∈ ennreal ∧ ∀ a ∈ S, EnnLe(b, a)
def ennSup (S : Set) : Set :=
  ⋃({ b ∈ ennreal | EnnUpperBound(S, b) ∧
    (∀ c, EnnUpperBound(S, c) → EnnLe(b, c)) })
def ennInf (S : Set) : Set :=
  ⋃({ b ∈ ennreal | EnnLowerBound(S, b) ∧
    (∀ c, EnnLowerBound(S, c) → EnnLe(c, b)) })

-- The supremum and infimum of f over A.
def ennSupOn (f A : Set) : Set := ennSup(valuesOn(f, A))
def ennInfOn (f A : Set) : Set := ennInf(valuesOn(f, A))

-- The sum of a family of values in [0, ∞] over a finite set (∞ when one
-- term is ∞), and over any index set: the supremum of the finite sums
-- (Mathlib's ENNReal tsum). No summability condition is needed.
def ennFiniteSum (f F : Set) : Set :=
  ⋃({ S ∈ ennreal | ((∀ i ∈ F, f(i) ≠ ennTop) ∧ S = realFiniteSum(f, F)) ∨
    ((∃ i ∈ F, f(i) = ennTop) ∧ S = ennTop) })
def finiteSumsOf (f I : Set) : Set := { ennFiniteSum(f, F) | F ∈ finiteSubsets(I) }
def ennTsum (f I : Set) : Set := ennSup(finiteSumsOf(f, I))

-- Families built from sums: the rows j ↦ f(i, j) of a family on I × J,
-- their sums, the sums of the families f(i) over J, the partial sums over
-- {0, …, n − 1}, and the pointwise supremum of a sequence of families.
def rowOf (f i J : Set) : Set := { (j, f((i, j))) | j ∈ J }
def ennRowSums (f I J : Set) : Set := { (i, ennTsum(rowOf(f, i, J), J)) | i ∈ I }
def ennSumsOf (f I J : Set) : Set := { (i, ennTsum(f(i), J)) | i ∈ I }
def ennColumnSums (f I J : Set) : Set :=
  { (j, ennTsum(familyAt(f, I, j), I)) | j ∈ J }
def ennPartialSums (f : Set) : Set := { (n, ennFiniteSum(f, n)) | n ∈ ℕ }
def ennPointwiseSup (u I : Set) : Set :=
  { (i, ennSupOn(familyAt(u, ℕ, i), ℕ)) | i ∈ I }

-- The lim inf and lim sup of a sequence in [0, ∞].
def tailFrom (n : Set) : Set := { k ∈ ℕ | n ⊆ k }
def ennTailInfs (f : Set) : Set := { (n, ennInfOn(f, tailFrom(n))) | n ∈ ℕ }
def ennLiminf (f : Set) : Set := ennSupOn(ennTailInfs(f), ℕ)
def ennTailSups (f : Set) : Set := { (n, ennSupOn(f, tailFrom(n))) | n ∈ ℕ }
def ennLimsup (f : Set) : Set := ennInfOn(ennTailSups(f), ℕ)

-- The measurable structure of [0, ∞]: generated by the rays (t, ∞], which
-- is its Borel σ-algebra for the order topology.
def ennIoi (t : Set) : Set := { a ∈ ennreal | ¬EnnLe(a, t) }
def ennRays : Set := { E ∈ 𝒫(ennreal) | ∃ t ∈ ennreal, E = ennIoi(t) }
def ennMeasurableSpace : Set := generatedSpace(ennreal, ennRays)
def ennGtSet (f A t : Set) : Set := { x ∈ A | ¬EnnLe(f(x), t) }

-- Section: Helpers
-- The graph x ↦ f(x) on I onto the values of f on I.
defgraph valuesMap (f I : Set) (x ∈ I) : valuesOn(f, I) := f(x)
proof
  exact valuesOn.membership.backward with ⟨x, member, rfl⟩

theorem valuesOn.countable (f I : Set)
  requires countable : Countable(I)
  shows Countable(valuesOn(f, I))
proof
  have fn := valuesMap.function at f, I
  have surj : SurjectiveBetween(valuesMap(f, I), I, valuesOn(f, I))
    unfold SurjectiveBetween
    refine ⟨fn, ?_⟩
    intros y hy
    obtain ⟨x, xI, e⟩ := hy
    refine ⟨x, xI, ?_⟩
    have r := valuesMap.relates at f, I, x with xI
    rw e at r
    exact r
  exact Countable.of_surjection with countable, surj

theorem Countable.pair_set (S T : Set)
  shows Countable({S, T})
proof
  have e : {S, T} = {S} ∪ {T}
    ext z
    simp
  have fa := Finite.singleton at S
  have fb := Finite.singleton at T
  have u := Finite.union with fa, fb
  rw e
  exact Countable.of_finite with u

theorem MeasurableSet.countable_union_helper (X C : Set)
  requires space : MeasurableSpace(X)
  requires countable : Countable(C)
  requires measurable : ∀ S ∈ C, MeasurableSet(X, S)
  shows MeasurableSet(X, ⋃(C))
proof
  obtain ⟨shape, sub, carr, compl, union⟩ := space
  have inside : C ⊆ MeasurableSpace.sets(X)
    intros S hS
    have m := measurable with S, hS
    unfold MeasurableSet at m
    exact m
  unfold MeasurableSet
  exact union with C, inside, countable

theorem MeasurableSet.indexed_union_helper (X I f : Set)
  requires space : MeasurableSpace(X)
  requires countable : Countable(I)
  requires measurable : ∀ i ∈ I, MeasurableSet(X, f(i))
  shows MeasurableSet(X, ⋃(valuesOn(f, I)))
proof
  have c := valuesOn.countable at f, I with countable
  have all : ∀ S ∈ valuesOn(f, I), MeasurableSet(X, S)
    intros S hS
    obtain ⟨i, iI, e⟩ := hS
    rw ← e
    exact measurable with i, iI
  exact MeasurableSet.countable_union_helper with space, c, all

-- The complements A ∖ f(n) of a sequence of sets.
defgraph complementSequence (A f : Set) (n ∈ ℕ) : 𝒫(A) := A ∖ f(n)
proof
  have sub : A ∖ f(n) ⊆ A
    intros x hx
    simp at hx
    exact hx.left
  exact (powerset.membership_iff at A ∖ f(n), A).backward with sub

-- The preimages along f of the members of C, as a graph on C.
defgraph preimageMap (f D C : Set) (B ∈ C) : 𝒫(D) := functionPreimage(f, D, B)
proof
  have sub : functionPreimage(f, D, B) ⊆ D
    intros x hx
    obtain ⟨xD, rest⟩ := hx
    exact xD
  exact (powerset.membership_iff at functionPreimage(f, D, B), D).backward with sub

-- The sets of A whose preimage along f is measurable in X: a σ-algebra
-- on A when f maps the carrier of X into A.
def pullbackSets (f X A : Set) : Set :=
  { B ∈ 𝒫(A) | functionPreimage(f, MeasurableSpace.carrier(X), B) ∈ MeasurableSpace.sets(X) }

theorem pullbackSets.sigma (f X A : Set)
  requires space : MeasurableSpace(X)
  requires maps : MapsInto(f, MeasurableSpace.carrier(X), A)
  shows SigmaAlgebra(A, pullbackSets(f, X, A))
proof
  have sp := space
  obtain ⟨shape, sub, carr, compl, unionClosed⟩ := space
  have refl := Subset.reflexive at A
  have pA := (powerset.membership_iff at A, A).backward with refl
  unfold SigmaAlgebra
  refine ⟨?_, ?_, ?_, ?_⟩
  . intros B hB
    obtain ⟨p, rest⟩ := hB
    exact p
  . have e : functionPreimage(f, MeasurableSpace.carrier(X), A) = MeasurableSpace.carrier(X)
      ext x
      constructor
      . intro h
        obtain ⟨a, rest⟩ := h
        exact a
      . intro h
        have fx := maps with x, h
        exact functionPreimage.membership.backward with ⟨h, fx⟩
    apply pullbackSets.membership.backward
    refine ⟨pA, ?_⟩
    rw e
    exact carr
  . intros B hB
    obtain ⟨p, pre⟩ := hB
    have e : functionPreimage(f, MeasurableSpace.carrier(X), A ∖ B) = MeasurableSpace.carrier(X) ∖ functionPreimage(f, MeasurableSpace.carrier(X), B)
      ext x
      constructor
      . intro h
        obtain ⟨xX, fx⟩ := h
        obtain ⟨fA, fnB⟩ := difference.membership.forward with fx
        have notPre : x ∉ functionPreimage(f, MeasurableSpace.carrier(X), B)
          intro hp
          obtain ⟨xX2, fB⟩ := hp
          exact fnB with fB
        exact difference.membership.backward with ⟨xX, notPre⟩
      . intro h
        obtain ⟨xX, notPre⟩ := difference.membership.forward with h
        have fx := maps with x, xX
        have fnB : f(x) ∉ B
          intro fB
          have pr := functionPreimage.membership.backward with ⟨xX, fB⟩
          exact notPre with pr
        have fd := difference.membership.backward with ⟨fx, fnB⟩
        exact functionPreimage.membership.backward with ⟨xX, fd⟩
    have sub2 : A ∖ B ⊆ A
      intros x hx
      simp at hx
      exact hx.left
    have pc := (powerset.membership_iff at A ∖ B, A).backward with sub2
    apply pullbackSets.membership.backward
    refine ⟨pc, ?_⟩
    rw e
    exact compl with functionPreimage(f, MeasurableSpace.carrier(X), B), pre
  . intros C CSub countable
    have all : ∀ B ∈ C, MeasurableSet(X, preimageMap(f, MeasurableSpace.carrier(X), C)(B))
      intros B BC
      have v := preimageMap.value at f, MeasurableSpace.carrier(X), C, B with BC
      have Bp := CSub with B, BC
      obtain ⟨p, pre⟩ := Bp
      rw v
      unfold MeasurableSet
      exact pre
    have u := MeasurableSet.indexed_union_helper with sp, countable, all
    have e : ⋃(valuesOn(preimageMap(f, MeasurableSpace.carrier(X), C), C)) = functionPreimage(f, MeasurableSpace.carrier(X), ⋃(C))
      ext x
      constructor
      . intro h
        obtain ⟨E, EIn, xE⟩ := union.membership.forward with h
        obtain ⟨B, BC, eB⟩ := EIn
        have v := preimageMap.value at f, MeasurableSpace.carrier(X), C, B with BC
        rw [← eB, v] at xE
        obtain ⟨xX, fx⟩ := xE
        have fu := union.membership.backward with ⟨B, BC, fx⟩
        exact functionPreimage.membership.backward with ⟨xX, fu⟩
      . intro h
        obtain ⟨xX, fx⟩ := h
        obtain ⟨B, BC, fB⟩ := union.membership.forward with fx
        have v := preimageMap.value at f, MeasurableSpace.carrier(X), C, B with BC
        have inV : preimageMap(f, MeasurableSpace.carrier(X), C)(B) ∈ valuesOn(preimageMap(f, MeasurableSpace.carrier(X), C), C)
          exact valuesOn.membership.backward with ⟨B, BC, rfl⟩
        have xE : x ∈ preimageMap(f, MeasurableSpace.carrier(X), C)(B)
          rw v
          exact functionPreimage.membership.backward with ⟨xX, fB⟩
        exact union.membership.backward with ⟨preimageMap(f, MeasurableSpace.carrier(X), C)(B), inV, xE⟩
    rw e at u
    unfold MeasurableSet at u
    have sub2 : ⋃(C) ⊆ A
      intros x hx
      obtain ⟨B, BC, xB⟩ := union.membership.forward with hx
      have Bp := CSub with B, BC
      obtain ⟨p, pre⟩ := Bp
      have BA := (powerset.membership_iff at B, A).forward with p
      exact BA with x, xB
    have pc := (powerset.membership_iff at ⋃(C), A).backward with sub2
    exact pullbackSets.membership.backward with ⟨pc, u⟩

-- Values of the graphs built pointwise.
theorem composeOn.apply (g f A x : Set)
  requires member : x ∈ A
  shows composeOn(g, f, A)(x) = g(f(x))
proof
  have edge : (x, g(f(x))) ∈ composeOn(g, f, A)
    apply composeOn.membership.backward
    exact ⟨x, member, rfl⟩
  have pairs : ∀ p ∈ composeOn(g, f, A), ∃ a, ∃ b, p = (a, b)
    intros p hp
    obtain ⟨k, hk, pEq⟩ := composeOn.membership.forward with hp
    rw ← pEq
    exact ⟨k, g(f(k)), rfl⟩
  have functional : ∀ a, ∀ b, ∀ c, (a, b) ∈ composeOn(g, f, A) → (a, c) ∈ composeOn(g, f, A) → b = c
    intros a b c hb hc
    obtain ⟨k, hk, bEq⟩ := composeOn.membership.forward with hb
    obtain ⟨m, hm, cEq⟩ := composeOn.membership.forward with hc
    obtain ⟨ka, bb⟩ := orderedPair.injective with bEq
    obtain ⟨ma, cc⟩ := orderedPair.injective with cEq
    rw [← bb, ← cc, ka, ← ma]
  exact pairGraph.apply with pairs, functional, edge

theorem familyAt.apply (u I x i : Set)
  requires member : i ∈ I
  shows familyAt(u, I, x)(i) = u(i)(x)
proof
  have edge : (i, u(i)(x)) ∈ familyAt(u, I, x)
    apply familyAt.membership.backward
    exact ⟨i, member, rfl⟩
  have pairs : ∀ p ∈ familyAt(u, I, x), ∃ a, ∃ b, p = (a, b)
    intros p hp
    obtain ⟨k, hk, pEq⟩ := familyAt.membership.forward with hp
    rw ← pEq
    exact ⟨k, u(k)(x), rfl⟩
  have functional : ∀ a, ∀ b, ∀ c, (a, b) ∈ familyAt(u, I, x) → (a, c) ∈ familyAt(u, I, x) → b = c
    intros a b c hb hc
    obtain ⟨k, hk, bEq⟩ := familyAt.membership.forward with hb
    obtain ⟨m, hm, cEq⟩ := familyAt.membership.forward with hc
    obtain ⟨ka, bb⟩ := orderedPair.injective with bEq
    obtain ⟨ma, cc⟩ := orderedPair.injective with cEq
    rw [← bb, ← cc, ka, ← ma]
  exact pairGraph.apply with pairs, functional, edge

theorem coordinateMap.apply (A i x : Set)
  requires member : x ∈ A
  shows coordinateMap(A, i)(x) = x(i)
proof
  have edge : (x, x(i)) ∈ coordinateMap(A, i)
    apply coordinateMap.membership.backward
    exact ⟨x, member, rfl⟩
  have pairs : ∀ p ∈ coordinateMap(A, i), ∃ a, ∃ b, p = (a, b)
    intros p hp
    obtain ⟨k, hk, pEq⟩ := coordinateMap.membership.forward with hp
    rw ← pEq
    exact ⟨k, k(i), rfl⟩
  have functional : ∀ a, ∀ b, ∀ c, (a, b) ∈ coordinateMap(A, i) → (a, c) ∈ coordinateMap(A, i) → b = c
    intros a b c hb hc
    obtain ⟨k, hk, bEq⟩ := coordinateMap.membership.forward with hb
    obtain ⟨m, hm, cEq⟩ := coordinateMap.membership.forward with hc
    obtain ⟨ka, bb⟩ := orderedPair.injective with bEq
    obtain ⟨ma, cc⟩ := orderedPair.injective with cEq
    rw [← bb, ← cc, ka, ← ma]
  exact pairGraph.apply with pairs, functional, edge

theorem realPartOn.apply (f A x : Set)
  requires member : x ∈ A
  shows realPartOn(f, A)(x) = complexRe(f(x))
proof
  have edge : (x, complexRe(f(x))) ∈ realPartOn(f, A)
    apply realPartOn.membership.backward
    exact ⟨x, member, rfl⟩
  have pairs : ∀ p ∈ realPartOn(f, A), ∃ a, ∃ b, p = (a, b)
    intros p hp
    obtain ⟨k, hk, pEq⟩ := realPartOn.membership.forward with hp
    rw ← pEq
    exact ⟨k, complexRe(f(k)), rfl⟩
  have functional : ∀ a, ∀ b, ∀ c, (a, b) ∈ realPartOn(f, A) → (a, c) ∈ realPartOn(f, A) → b = c
    intros a b c hb hc
    obtain ⟨k, hk, bEq⟩ := realPartOn.membership.forward with hb
    obtain ⟨m, hm, cEq⟩ := realPartOn.membership.forward with hc
    obtain ⟨ka, bb⟩ := orderedPair.injective with bEq
    obtain ⟨ma, cc⟩ := orderedPair.injective with cEq
    rw [← bb, ← cc, ka, ← ma]
  exact pairGraph.apply with pairs, functional, edge

theorem imagPartOn.apply (f A x : Set)
  requires member : x ∈ A
  shows imagPartOn(f, A)(x) = complexIm(f(x))
proof
  have edge : (x, complexIm(f(x))) ∈ imagPartOn(f, A)
    apply imagPartOn.membership.backward
    exact ⟨x, member, rfl⟩
  have pairs : ∀ p ∈ imagPartOn(f, A), ∃ a, ∃ b, p = (a, b)
    intros p hp
    obtain ⟨k, hk, pEq⟩ := imagPartOn.membership.forward with hp
    rw ← pEq
    exact ⟨k, complexIm(f(k)), rfl⟩
  have functional : ∀ a, ∀ b, ∀ c, (a, b) ∈ imagPartOn(f, A) → (a, c) ∈ imagPartOn(f, A) → b = c
    intros a b c hb hc
    obtain ⟨k, hk, bEq⟩ := imagPartOn.membership.forward with hb
    obtain ⟨m, hm, cEq⟩ := imagPartOn.membership.forward with hc
    obtain ⟨ka, bb⟩ := orderedPair.injective with bEq
    obtain ⟨ma, cc⟩ := orderedPair.injective with cEq
    rw [← bb, ← cc, ka, ← ma]
  exact pairGraph.apply with pairs, functional, edge

theorem piecewiseOn.functional (A S f g : Set)
  shows ∀ a, ∀ b, ∀ c, (a, b) ∈ piecewiseOn(A, S, f, g) → (a, c) ∈ piecewiseOn(A, S, f, g) → b = c
proof
  intros a b c hb hc
  obtain ⟨pb, altB⟩ := piecewiseOn.membership.forward with hb
  obtain ⟨pc, altC⟩ := piecewiseOn.membership.forward with hc
  simp [fst.pair, snd.pair] at altB
  simp [fst.pair, snd.pair] at altC
  cases altB with inB | outB
  . cases altC with inC | outC
    . rw [inB.right, inC.right]
    . exfalso
      exact outC.left with inB.left
  . cases altC with inC | outC
    . exfalso
      exact outB.left with inC.left
    . rw [outB.right, outC.right]

theorem piecewiseOn.pairs (A S f g : Set)
  shows ∀ p ∈ piecewiseOn(A, S, f, g), ∃ a, ∃ b, p = (a, b)
proof
  intros p hp
  obtain ⟨pIn, alt⟩ := piecewiseOn.membership.forward with hp
  obtain ⟨bound, a, ha, b, hb, pEq⟩ := product.membership.forward with pIn
  exact ⟨a, b, pEq⟩

theorem piecewiseOn.apply_in (A S f g x : Set)
  requires member : x ∈ A
  requires inS : x ∈ S
  shows piecewiseOn(A, S, f, g)(x) = f(x)
proof
  have fv : f(x) ∈ valuesOn(f, A) ∪ valuesOn(g, A)
    have v : f(x) ∈ valuesOn(f, A) := valuesOn.membership.backward with ⟨x, member, rfl⟩
    simp
  have pr := product.pair with member, fv
  have edge : (x, f(x)) ∈ piecewiseOn(A, S, f, g)
    apply piecewiseOn.membership.backward
    refine ⟨pr, ?_⟩
    left
    simp [fst.pair, snd.pair]
  have pairs := piecewiseOn.pairs at A, S, f, g
  have functional := piecewiseOn.functional at A, S, f, g
  exact pairGraph.apply with pairs, functional, edge

theorem piecewiseOn.apply_out (A S f g x : Set)
  requires member : x ∈ A
  requires outS : x ∉ S
  shows piecewiseOn(A, S, f, g)(x) = g(x)
proof
  have gv : g(x) ∈ valuesOn(f, A) ∪ valuesOn(g, A)
    have v : g(x) ∈ valuesOn(g, A) := valuesOn.membership.backward with ⟨x, member, rfl⟩
    simp
  have pr := product.pair with member, gv
  have edge : (x, g(x)) ∈ piecewiseOn(A, S, f, g)
    apply piecewiseOn.membership.backward
    refine ⟨pr, ?_⟩
    right
    simp [fst.pair, snd.pair]
  have pairs := piecewiseOn.pairs at A, S, f, g
  have functional := piecewiseOn.functional at A, S, f, g
  exact pairGraph.apply with pairs, functional, edge

-- A set of pairs over D with values in E, single-valued and total, is a
-- function D → E.
theorem FunctionBetween.of_graph (r D E : Set)
  requires shape : ∀ p ∈ r, ∃ x ∈ D, ∃ y ∈ E, p = (x, y)
  requires functional : ∀ a, ∀ b, ∀ c, (a, b) ∈ r → (a, c) ∈ r → b = c
  requires total : ∀ x ∈ D, ∃ y ∈ E, (x, y) ∈ r
  shows FunctionBetween(r, D, E)
proof
  unfold FunctionBetween
  refine ⟨?_, ?_, ?_⟩
  . unfold RelationBetween
    intros p hp
    obtain ⟨x, xD, y, yE, e⟩ := shape with p, hp
    rw e
    exact product.pair with xD, yE
  . unfold Functional
    intros x y hy z hz
    unfold relates at hy
    unfold relates at hz
    exact functional with x, y, z, hy, hz
  . intros x hx
    obtain ⟨y, yE, xy⟩ := total with x, hx
    refine ⟨y, yE, ?_⟩
    unfold relates
    exact xy

theorem functionPreimage.comp (f g h A B C : Set)
  requires maps : MapsInto(f, A, B)
  requires composite : ∀ x ∈ A, h(x) = g(f(x))
  shows functionPreimage(h, A, C) = functionPreimage(f, A, functionPreimage(g, B, C))
proof
  ext x
  constructor
  . intro hx
    obtain ⟨xA, hC⟩ := functionPreimage.membership.forward with hx
    rw composite with x, xA at hC
    have fx := maps with x, xA
    have inner := functionPreimage.membership.backward with ⟨fx, hC⟩
    exact functionPreimage.membership.backward with ⟨xA, inner⟩
  . intro hx
    obtain ⟨xA, inner⟩ := functionPreimage.membership.forward with hx
    obtain ⟨fx, gC⟩ := functionPreimage.membership.forward with inner
    have hv := composite with x, xA
    have hC : h(x) ∈ C
      rw hv
      exact gC
    exact functionPreimage.membership.backward with ⟨xA, hC⟩

theorem functionPreimage.whole (f A B : Set)
  requires maps : MapsInto(f, A, B)
  shows functionPreimage(f, A, B) = A
proof
  ext x
  constructor
  . intro hx
    obtain ⟨xA, rest⟩ := functionPreimage.membership.forward with hx
    exact xA
  . intro hx
    have fx := maps with x, hx
    exact functionPreimage.membership.backward with ⟨hx, fx⟩

-- Section: Laws of σ-algebras
theorem SigmaAlgebra.of_space (X : Set)
  requires space : MeasurableSpace(X)
  shows SigmaAlgebra(MeasurableSpace.carrier(X), MeasurableSpace.sets(X))
proof
  obtain ⟨shape, sub, carr, compl, union⟩ := space
  unfold SigmaAlgebra
  exact ⟨sub, carr, compl, union⟩

theorem MeasurableSpace.of_sigma (A M : Set)
  requires sigma : SigmaAlgebra(A, M)
  shows MeasurableSpace(MeasurableSpace.mk(A, M))
proof
  obtain ⟨sub, carr, compl, union⟩ := sigma
  exact MeasurableSpace.intro with sub, carr, compl, union

theorem MeasurableSet.subset (X S : Set)
  requires space : MeasurableSpace(X)
  requires measurable : MeasurableSet(X, S)
  shows S ⊆ MeasurableSpace.carrier(X)
proof
  obtain ⟨shape, sub, carr, compl, union⟩ := space
  have m : S ∈ MeasurableSpace.sets(X)
    unfold MeasurableSet at measurable
    exact measurable
  have p : S ∈ 𝒫(MeasurableSpace.carrier(X)) by exact sub with m
  have iff := powerset.membership_iff at S, MeasurableSpace.carrier(X)
  exact iff.forward with p

theorem MeasurableSet.empty (X : Set)
  requires space : MeasurableSpace(X)
  shows MeasurableSet(X, ∅)
proof
  obtain ⟨shape, sub, carr, compl, union⟩ := space
  have c := compl with MeasurableSpace.carrier(X), carr
  have e : MeasurableSpace.carrier(X) ∖ MeasurableSpace.carrier(X) = ∅
    ext x
    simp
    intro h
    obtain ⟨a, b⟩ := h
    exact b with a
  rw e at c
  unfold MeasurableSet
  exact c

theorem MeasurableSet.univ (X : Set)
  requires space : MeasurableSpace(X)
  shows MeasurableSet(X, MeasurableSpace.carrier(X))
proof
  obtain ⟨shape, sub, carr, compl, union⟩ := space
  unfold MeasurableSet
  exact carr

theorem MeasurableSet.compl (X S : Set)
  requires space : MeasurableSpace(X)
  requires measurable : MeasurableSet(X, S)
  shows MeasurableSet(X, MeasurableSpace.carrier(X) ∖ S)
proof
  obtain ⟨shape, sub, carr, compl, union⟩ := space
  unfold MeasurableSet at measurable
  unfold MeasurableSet
  exact compl with S, measurable

theorem MeasurableSet.union (X S T : Set)
  requires space : MeasurableSpace(X)
  requires measurableS : MeasurableSet(X, S)
  requires measurableT : MeasurableSet(X, T)
  shows MeasurableSet(X, S ∪ T)
proof
  have pc := Countable.pair_set at S, T
  have all : ∀ U ∈ {S, T}, MeasurableSet(X, U)
    intros U hU
    simp at hU
    cases hU with a | b
    . rw a
      exact measurableS
    . rw b
      exact measurableT
  have u := MeasurableSet.countable_union_helper with space, pc, all
  rw union.pair at u
  exact u

theorem MeasurableSet.inter (X S T : Set)
  requires space : MeasurableSpace(X)
  requires measurableS : MeasurableSet(X, S)
  requires measurableT : MeasurableSet(X, T)
  shows MeasurableSet(X, S ∩ T)
proof
  have sS := MeasurableSet.subset with space, measurableS
  have sT := MeasurableSet.subset with space, measurableT
  have cS := MeasurableSet.compl with space, measurableS
  have cT := MeasurableSet.compl with space, measurableT
  have u := MeasurableSet.union with space, cS, cT
  have c := MeasurableSet.compl with space, u
  have e : MeasurableSpace.carrier(X) ∖ ((MeasurableSpace.carrier(X) ∖ S) ∪ (MeasurableSpace.carrier(X) ∖ T)) = S ∩ T
    ext x
    simp
  rw e at c
  exact c

theorem MeasurableSet.diff (X S T : Set)
  requires space : MeasurableSpace(X)
  requires measurableS : MeasurableSet(X, S)
  requires measurableT : MeasurableSet(X, T)
  shows MeasurableSet(X, S ∖ T)
proof
  have sS := MeasurableSet.subset with space, measurableS
  have cT := MeasurableSet.compl with space, measurableT
  have i := MeasurableSet.inter with space, measurableS, cT
  have e : S ∩ (MeasurableSpace.carrier(X) ∖ T) = S ∖ T
    ext x
    simp
  rw e at i
  exact i

-- Mathlib's MeasurableSet.iUnion and MeasurableSet.iInter over ℕ.
theorem MeasurableSet.sequence_union (X f : Set)
  requires space : MeasurableSpace(X)
  requires measurable : ∀ n ∈ ℕ, MeasurableSet(X, f(n))
  shows MeasurableSet(X, sequenceUnion(f))
proof
  have c := naturals.countable
  have u := MeasurableSet.indexed_union_helper with space, c, measurable
  unfold sequenceUnion
  exact u

theorem MeasurableSet.sequence_inter (X f : Set)
  requires space : MeasurableSpace(X)
  requires measurable : ∀ n ∈ ℕ, MeasurableSet(X, f(n))
  shows MeasurableSet(X, sequenceInter(MeasurableSpace.carrier(X), f))
proof
  have cm : ∀ n ∈ ℕ, MeasurableSet(X, complementSequence(MeasurableSpace.carrier(X), f)(n))
    intros n hn
    have m := measurable with n, hn
    have v := complementSequence.value at MeasurableSpace.carrier(X), f, n with hn
    rw v
    exact MeasurableSet.compl with space, m
  have u := MeasurableSet.sequence_union with space, cm
  have c := MeasurableSet.compl with space, u
  have e : MeasurableSpace.carrier(X) ∖ sequenceUnion(complementSequence(MeasurableSpace.carrier(X), f)) = sequenceInter(MeasurableSpace.carrier(X), f)
    ext x
    unfold sequenceUnion
    unfold sequenceInter
    constructor
    . intro h
      obtain ⟨xA, notU⟩ := h
      refine ⟨xA, ?_⟩
      intros n hn
      by_contra out
      apply notU
      have v := complementSequence.value at MeasurableSpace.carrier(X), f, n with hn
      have inV : complementSequence(MeasurableSpace.carrier(X), f)(n) ∈ valuesOn(complementSequence(MeasurableSpace.carrier(X), f), ℕ)
        exact valuesOn.membership.backward with ⟨n, hn, rfl⟩
      have xIn : x ∈ complementSequence(MeasurableSpace.carrier(X), f)(n)
        rw v
        simp
      exact union.membership.backward with ⟨complementSequence(MeasurableSpace.carrier(X), f)(n), inV, xIn⟩
    . intro h
      obtain ⟨xA, all⟩ := h
      have notU : x ∉ ⋃(valuesOn(complementSequence(MeasurableSpace.carrier(X), f), ℕ))
        intro hU
        obtain ⟨S, SIn, xS⟩ := union.membership.forward with hU
        obtain ⟨n, hn, e⟩ := SIn
        have v := complementSequence.value at MeasurableSpace.carrier(X), f, n with hn
        rw [← e, v] at xS
        simp at xS
        have a := all with n, hn
        exact xS.right with a
      exact difference.membership.backward with ⟨xA, notU⟩
  rw e at c
  exact c

-- Mathlib's MeasurableSet.biUnion and Finset.measurableSet: a union over a
-- countable index set.
theorem MeasurableSet.countable_union (X C : Set)
  requires space : MeasurableSpace(X)
  requires countable : Countable(C)
  requires measurable : ∀ S ∈ C, MeasurableSet(X, S)
  shows MeasurableSet(X, ⋃(C))
proof
  exact MeasurableSet.countable_union_helper with space, countable, measurable

theorem MeasurableSet.indexed_union (X I f : Set)
  requires space : MeasurableSpace(X)
  requires countable : Countable(I)
  requires measurable : ∀ i ∈ I, MeasurableSet(X, f(i))
  shows MeasurableSet(X, ⋃(valuesOn(f, I)))
proof
  exact MeasurableSet.indexed_union_helper with space, countable, measurable

-- Section: Generated σ-algebras
theorem generatedSigma.sigma (A G : Set)
  shows SigmaAlgebra(A, generatedSigma(A, G))
proof
  have refl := Subset.reflexive at A
  have pA := (powerset.membership_iff at A, A).backward with refl
  unfold SigmaAlgebra
  refine ⟨?_, ?_, ?_, ?_⟩
  . intros S hS
    obtain ⟨p, rest⟩ := hS
    exact p
  . apply generatedSigma.membership.backward
    refine ⟨pA, ?_⟩
    intros M hM sigma gens
    obtain ⟨sub, carr, compl, unionClosed⟩ := sigma
    exact carr
  . intros S hS
    obtain ⟨p, all⟩ := hS
    have sub : A ∖ S ⊆ A
      intros x hx
      simp at hx
      exact hx.left
    have pc := (powerset.membership_iff at A ∖ S, A).backward with sub
    apply generatedSigma.membership.backward
    refine ⟨pc, ?_⟩
    intros M hM sigma gens
    have SM := all with M, hM, sigma, gens
    obtain ⟨sub2, carr, compl, unionClosed⟩ := sigma
    exact compl with S, SM
  . intros C CSub countable
    have sub : ⋃(C) ⊆ A
      intros x hx
      obtain ⟨S, SC, xS⟩ := union.membership.forward with hx
      have Sg := CSub with S, SC
      obtain ⟨p, all⟩ := Sg
      have SA := (powerset.membership_iff at S, A).forward with p
      exact SA with x, xS
    have pc := (powerset.membership_iff at ⋃(C), A).backward with sub
    apply generatedSigma.membership.backward
    refine ⟨pc, ?_⟩
    intros M hM sigma gens
    have CM : C ⊆ M
      intros S SC
      have Sg := CSub with S, SC
      obtain ⟨p, all⟩ := Sg
      exact all with M, hM, sigma, gens
    obtain ⟨sub2, carr, compl, unionClosed⟩ := sigma
    exact unionClosed with C, CM, countable

theorem generatedSpace.space (A G : Set)
  shows MeasurableSpace(generatedSpace(A, G))
proof
  have sigma := generatedSigma.sigma at A, G
  unfold generatedSpace
  exact MeasurableSpace.of_sigma with sigma

-- Mathlib's measurableSet_generateFrom.
theorem generatedSigma.generator (A G S : Set)
  requires member : S ∈ G
  requires inside : S ⊆ A
  shows S ∈ generatedSigma(A, G)
proof
  have pS := (powerset.membership_iff at S, A).backward with inside
  apply generatedSigma.membership.backward
  refine ⟨pS, ?_⟩
  intros M hM sigma gens
  have both : S ∈ G ∩ 𝒫(A)
    simp
  exact gens with S, both

-- Mathlib's generateFrom_le: the generated σ-algebra is the least one.
theorem generatedSigma.least (A G M : Set)
  requires sigma : SigmaAlgebra(A, M)
  requires generators : G ∩ 𝒫(A) ⊆ M
  shows generatedSigma(A, G) ⊆ M
proof
  intros S hS
  obtain ⟨p, all⟩ := hS
  have sig := sigma
  obtain ⟨sub, carr, compl, unionClosed⟩ := sig
  have hM := (powerset.membership_iff at M, 𝒫(A)).backward with sub
  exact all with M, hM, sigma, generators

theorem generatedSigma.mono (A G H : Set)
  requires inside : G ⊆ H
  shows generatedSigma(A, G) ⊆ generatedSigma(A, H)
proof
  intros S hS
  obtain ⟨p, all⟩ := hS
  apply generatedSigma.membership.backward
  refine ⟨p, ?_⟩
  intros M hM sigma gens
  have gensG : G ∩ 𝒫(A) ⊆ M
    intros T hT
    simp at hT
    have hT2 : T ∈ H ∩ 𝒫(A)
      have TH := inside with T, hT.left
      simp
    exact gens with T, hT2
  exact all with M, hM, sigma, gensG

-- A map into a generated σ-algebra is measurable when the preimages of the
-- generators are (Mathlib's measurable_generateFrom).
theorem Measurable.of_generators (f X A G : Set)
  requires space : MeasurableSpace(X)
  requires maps : MapsInto(f, MeasurableSpace.carrier(X), A)
  requires generators : ∀ S ∈ G, S ⊆ A →
    functionPreimage(f, MeasurableSpace.carrier(X), S) ∈ MeasurableSpace.sets(X)
  shows Measurable(f, X, generatedSpace(A, G))
proof
  have pull := pullbackSets.sigma with space, maps
  have gens : G ∩ 𝒫(A) ⊆ pullbackSets(f, X, A)
    intros S hS
    simp at hS
    have SA := (powerset.membership_iff at S, A).forward with hS.right
    have pre := generators with S, hS.left, SA
    exact pullbackSets.membership.backward with ⟨hS.right, pre⟩
  have least := generatedSigma.least with pull, gens
  have gsp := generatedSpace.space at A, G
  unfold Measurable
  refine ⟨space, gsp, ?_, ?_⟩
  . unfold generatedSpace
    rw MeasurableSpace.mk.carrier
    exact maps
  . intros B hB
    unfold generatedSpace at hB
    rw MeasurableSpace.mk.sets at hB
    have Bp := least with B, hB
    obtain ⟨p, pre⟩ := Bp
    exact pre

-- Dynkin's π-λ theorem: a Dynkin system containing a π-system contains the
-- σ-algebra it generates (Mathlib's MeasurableSpace.induction_on_inter).
theorem DynkinSystem.contains_generated (A G D : Set)
  requires pi : PiSystem(G)
  requires generators : G ⊆ D
  requires dynkin : DynkinSystem(A, D)
  shows generatedSigma(A, G) ⊆ D
proof
  sorry

theorem SigmaAlgebra.dynkin (A M : Set)
  requires sigma : SigmaAlgebra(A, M)
  shows DynkinSystem(A, M)
proof
  have sg := sigma
  obtain ⟨sub, carr, compl, un⟩ := sg
  unfold DynkinSystem
  refine ⟨sub, carr, compl, ?_⟩
  intros f hf disjoint
  have c := naturals.countable
  have vc := valuesOn.countable at f, ℕ with c
  have inside : valuesOn(f, ℕ) ⊆ M
    intros S hS
    obtain ⟨n, hn, e⟩ := hS
    rw ← e
    exact hf with n, hn
  unfold sequenceUnion
  exact un with valuesOn(f, ℕ), inside, vc

-- Section: Measurable maps
theorem Measurable.maps (f X Y x : Set)
  requires measurable : Measurable(f, X, Y)
  requires member : x ∈ MeasurableSpace.carrier(X)
  shows f(x) ∈ MeasurableSpace.carrier(Y)
proof
  obtain ⟨sX, sY, maps, pre⟩ := measurable
  exact maps with x, member

theorem Measurable.preimage (f X Y B : Set)
  requires measurable : Measurable(f, X, Y)
  requires set : MeasurableSet(Y, B)
  shows MeasurableSet(X, functionPreimage(f, MeasurableSpace.carrier(X), B))
proof
  obtain ⟨sX, sY, maps, pre⟩ := measurable
  unfold MeasurableSet at set
  unfold MeasurableSet
  exact pre with B, set

theorem Measurable.identity (X : Set)
  requires space : MeasurableSpace(X)
  shows Measurable(identity(MeasurableSpace.carrier(X)), X, X)
proof
  have sp := space
  obtain ⟨shape, sub, carr, compl, unionClosed⟩ := sp
  unfold Measurable
  refine ⟨space, space, ?_, ?_⟩
  . intros x hx
    rw identity.apply with hx
    exact hx
  . intros B hB
    have Bp := sub with B, hB
    have BX := (powerset.membership_iff at B, MeasurableSpace.carrier(X)).forward with Bp
    have e : functionPreimage(identity(MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X), B) = B
      ext x
      constructor
      . intro h
        obtain ⟨xX, fx⟩ := h
        rw identity.apply with xX at fx
        exact fx
      . intro h
        have xX := BX with x, h
        have v := identity.apply at x, MeasurableSpace.carrier(X) with xX
        have fx : identity(MeasurableSpace.carrier(X))(x) ∈ B
          rw v
          exact h
        exact functionPreimage.membership.backward with ⟨xX, fx⟩
    rw e
    exact hB

theorem Measurable.constant (f X Y c : Set)
  requires spaceX : MeasurableSpace(X)
  requires spaceY : MeasurableSpace(Y)
  requires member : c ∈ MeasurableSpace.carrier(Y)
  requires constant : ∀ x ∈ MeasurableSpace.carrier(X), f(x) = c
  shows Measurable(f, X, Y)
proof
  have sp := spaceX
  obtain ⟨shape, sub, carr, compl, unionClosed⟩ := sp
  unfold Measurable
  refine ⟨spaceX, spaceY, ?_, ?_⟩
  . intros x hx
    rw constant with x, hx
    exact member
  . intros B hB
    by_cases cB : c ∈ B
    . have e : functionPreimage(f, MeasurableSpace.carrier(X), B) = MeasurableSpace.carrier(X)
        ext x
        constructor
        . intro h
          obtain ⟨xX, fx⟩ := h
          exact xX
        . intro h
          have v := constant with x, h
          have fx : f(x) ∈ B
            rw v
            exact cB
          exact functionPreimage.membership.backward with ⟨h, fx⟩
      rw e
      exact carr
    . have e : functionPreimage(f, MeasurableSpace.carrier(X), B) = ∅
        ext x
        constructor
        . intro h
          obtain ⟨xX, fx⟩ := h
          have v := constant with x, xX
          rw v at fx
          exfalso
          exact cB with fx
        . intro h
          simp at h
      have em := MeasurableSet.empty with spaceX
      unfold MeasurableSet at em
      rw e
      exact em

theorem Measurable.comp (f g h X Y Z : Set)
  requires measurableF : Measurable(f, X, Y)
  requires measurableG : Measurable(g, Y, Z)
  requires composite : ∀ x ∈ MeasurableSpace.carrier(X), h(x) = g(f(x))
  shows Measurable(h, X, Z)
proof
  have mf := measurableF
  have mg := measurableG
  obtain ⟨sX, sY, mapsF, preF⟩ := mf
  obtain ⟨sY2, sZ, mapsG, preG⟩ := mg
  unfold Measurable
  refine ⟨sX, sZ, ?_, ?_⟩
  . intros x hx
    rw composite with x, hx
    have fx := mapsF with x, hx
    exact mapsG with f(x), fx
  . intros B hB
    have pg := preG with B, hB
    have pf := preF with functionPreimage(g, MeasurableSpace.carrier(Y), B), pg
    have e : functionPreimage(h, MeasurableSpace.carrier(X), B) = functionPreimage(f, MeasurableSpace.carrier(X), functionPreimage(g, MeasurableSpace.carrier(Y), B))
      ext x
      constructor
      . intro hx
        obtain ⟨xX, hB2⟩ := hx
        rw composite with x, xX at hB2
        have fx := mapsF with x, xX
        have inner := functionPreimage.membership.backward with ⟨fx, hB2⟩
        exact functionPreimage.membership.backward with ⟨xX, inner⟩
      . intro hx
        obtain ⟨xX, inner⟩ := hx
        obtain ⟨fx, gB⟩ := inner
        have hv := composite with x, xX
        have hB2 : h(x) ∈ B
          rw hv
          exact gB
        exact functionPreimage.membership.backward with ⟨xX, hB2⟩
    rw e
    exact pf

theorem Measurable.congr (f g X Y : Set)
  requires measurable : Measurable(f, X, Y)
  requires agree : ∀ x ∈ MeasurableSpace.carrier(X), f(x) = g(x)
  shows Measurable(g, X, Y)
proof
  obtain ⟨sX, sY, mapsF, preF⟩ := measurable
  unfold Measurable
  refine ⟨sX, sY, ?_, ?_⟩
  . intros x hx
    rw ← agree with x, hx
    exact mapsF with x, hx
  . intros B hB
    have pf := preF with B, hB
    have e : functionPreimage(g, MeasurableSpace.carrier(X), B) = functionPreimage(f, MeasurableSpace.carrier(X), B)
      ext x
      constructor
      . intro hx
        obtain ⟨xX, gB⟩ := hx
        rw ← agree with x, xX at gB
        exact functionPreimage.membership.backward with ⟨xX, gB⟩
      . intro hx
        obtain ⟨xX, fB⟩ := hx
        rw agree with x, xX at fB
        exact functionPreimage.membership.backward with ⟨xX, fB⟩
    rw e
    exact pf

-- Mathlib's Measurable.ite / Measurable.piecewise.
theorem Measurable.piecewise (f g X Y S : Set)
  requires set : MeasurableSet(X, S)
  requires measurableF : Measurable(f, X, Y)
  requires measurableG : Measurable(g, X, Y)
  shows Measurable(piecewiseOn(MeasurableSpace.carrier(X), S, f, g), X, Y)
proof
  have mf := measurableF
  have mg := measurableG
  obtain ⟨sX, sY, mapsF, preF⟩ := mf
  obtain ⟨sX2, sY2, mapsG, preG⟩ := mg
  have SX := MeasurableSet.subset with sX, set
  unfold Measurable
  refine ⟨sX, sY, ?_, ?_⟩
  . intros x hx
    by_cases xS : x ∈ S
    . rw piecewiseOn.apply_in with hx, xS
      exact mapsF with x, hx
    . rw piecewiseOn.apply_out with hx, xS
      exact mapsG with x, hx
  . intros B hB
    have pf := preF with B, hB
    have pg := preG with B, hB
    have mpf : MeasurableSet(X, functionPreimage(f, MeasurableSpace.carrier(X), B))
      unfold MeasurableSet
      exact pf
    have mpg : MeasurableSet(X, functionPreimage(g, MeasurableSpace.carrier(X), B))
      unfold MeasurableSet
      exact pg
    have i1 := MeasurableSet.inter with sX, set, mpf
    have d2 := MeasurableSet.diff with sX, mpg, set
    have u := MeasurableSet.union with sX, i1, d2
    have e : S ∩ functionPreimage(f, MeasurableSpace.carrier(X), B) ∪ (functionPreimage(g, MeasurableSpace.carrier(X), B) ∖ S) = functionPreimage(piecewiseOn(MeasurableSpace.carrier(X), S, f, g), MeasurableSpace.carrier(X), B)
      ext x
      constructor
      . intro h
        have h2 := union2.membership.forward with h
        cases h2 with l | r
        . obtain ⟨xS, pr⟩ := intersection.membership.forward with l
          obtain ⟨xX, fB⟩ := functionPreimage.membership.forward with pr
          have v := piecewiseOn.apply_in at MeasurableSpace.carrier(X), S, f, g, x with xX, xS
          have pB : piecewiseOn(MeasurableSpace.carrier(X), S, f, g)(x) ∈ B
            rw v
            exact fB
          exact functionPreimage.membership.backward with ⟨xX, pB⟩
        . obtain ⟨pr, xS⟩ := difference.membership.forward with r
          obtain ⟨xX, gB⟩ := functionPreimage.membership.forward with pr
          have v := piecewiseOn.apply_out at MeasurableSpace.carrier(X), S, f, g, x with xX, xS
          have pB : piecewiseOn(MeasurableSpace.carrier(X), S, f, g)(x) ∈ B
            rw v
            exact gB
          exact functionPreimage.membership.backward with ⟨xX, pB⟩
      . intro h
        obtain ⟨xX, pB⟩ := h
        by_cases xS : x ∈ S
        . rw piecewiseOn.apply_in with xX, xS at pB
          have pr := functionPreimage.membership.backward with ⟨xX, pB⟩
          simp
        . rw piecewiseOn.apply_out with xX, xS at pB
          have pr := functionPreimage.membership.backward with ⟨xX, pB⟩
          simp
    rw e at u
    unfold MeasurableSet at u
    exact u

-- The coordinate maps of a product and the pairing of two maps (Mathlib's
-- measurable_fst, measurable_snd, Measurable.prodMk).
theorem Measurable.fst (X Y : Set)
  requires spaceX : MeasurableSpace(X)
  requires spaceY : MeasurableSpace(Y)
  shows Measurable(firstProjection(MeasurableSpace.carrier(X), MeasurableSpace.carrier(Y)),
    productMeasurableSpace(X, Y), X)
proof
  have gsp := generatedSpace.space at MeasurableSpace.carrier(X) × MeasurableSpace.carrier(Y), rectangles(X, Y)
  have carrierP : MeasurableSpace.carrier(productMeasurableSpace(X, Y)) = MeasurableSpace.carrier(X) × MeasurableSpace.carrier(Y)
    unfold productMeasurableSpace
    unfold generatedSpace
    rw MeasurableSpace.mk.carrier
  have setsP : MeasurableSpace.sets(productMeasurableSpace(X, Y)) = generatedSigma(MeasurableSpace.carrier(X) × MeasurableSpace.carrier(Y), rectangles(X, Y))
    unfold productMeasurableSpace
    unfold generatedSpace
    rw MeasurableSpace.mk.sets
  have uX := MeasurableSet.univ with spaceX
  unfold MeasurableSet at uX
  have uY := MeasurableSet.univ with spaceY
  unfold MeasurableSet at uY
  have gsp2 : MeasurableSpace(productMeasurableSpace(X, Y))
    unfold productMeasurableSpace
    exact gsp
  unfold Measurable
  refine ⟨gsp2, spaceX, ?_, ?_⟩
  . unfold MapsInto
    rw carrierP
    intros p hp
    obtain ⟨bound, x, hx, y, hy, pEq⟩ := product.membership.forward with hp
    rw pEq
    rw firstProjection.pair with hx, hy
    exact hx
  . intros B hB
    rw [carrierP, setsP]
    have space2 := spaceX
    obtain ⟨shape, sub, carr, compl, unionClosed⟩ := space2
    have Bp := sub with B, hB
    have BC := (powerset.membership_iff at B, MeasurableSpace.carrier(X)).forward with Bp
    have pre : functionPreimage(firstProjection(MeasurableSpace.carrier(X), MeasurableSpace.carrier(Y)), MeasurableSpace.carrier(X) × MeasurableSpace.carrier(Y), B) = B × MeasurableSpace.carrier(Y)
      ext p
      constructor
      . intro h
        obtain ⟨pIn, val⟩ := functionPreimage.membership.forward with h
        obtain ⟨bound, x, hx, y, hy, pEq⟩ := product.membership.forward with pIn
        rw pEq at val
        rw firstProjection.pair with hx, hy at val
        rw pEq
        exact product.pair with val, hy
      . intro h
        obtain ⟨bound, x, hx, y, hy, pEq⟩ := product.membership.forward with h
        rw pEq
        have xX := BC with x, hx
        have pIn := product.pair with xX, hy
        have val : firstProjection(MeasurableSpace.carrier(X), MeasurableSpace.carrier(Y))((x, y)) ∈ B
          rw firstProjection.pair with xX, hy
          exact hx
        exact functionPreimage.membership.backward with ⟨pIn, val⟩
    rw pre
    apply generatedSigma.generator
    . apply rectangles.membership.backward
      have rsub : B × MeasurableSpace.carrier(Y) ⊆ MeasurableSpace.carrier(X) × MeasurableSpace.carrier(Y)
        intros p hp
        obtain ⟨bound, x, hx, y, hy, pEq⟩ := product.membership.forward with hp
        rw pEq
        exact product.pair with (BC with x, hx), hy
      have rp := (powerset.membership_iff at B × MeasurableSpace.carrier(Y), MeasurableSpace.carrier(X) × MeasurableSpace.carrier(Y)).backward with rsub
      exact ⟨rp, B, hB, MeasurableSpace.carrier(Y), uY, rfl⟩
    . intros p hp
      obtain ⟨bound, x, hx, y, hy, pEq⟩ := product.membership.forward with hp
      rw pEq
      exact product.pair with (BC with x, hx), hy

theorem Measurable.snd (X Y : Set)
  requires spaceX : MeasurableSpace(X)
  requires spaceY : MeasurableSpace(Y)
  shows Measurable(secondProjection(MeasurableSpace.carrier(X), MeasurableSpace.carrier(Y)),
    productMeasurableSpace(X, Y), Y)
proof
  have gsp := generatedSpace.space at MeasurableSpace.carrier(X) × MeasurableSpace.carrier(Y), rectangles(X, Y)
  have carrierP : MeasurableSpace.carrier(productMeasurableSpace(X, Y)) = MeasurableSpace.carrier(X) × MeasurableSpace.carrier(Y)
    unfold productMeasurableSpace
    unfold generatedSpace
    rw MeasurableSpace.mk.carrier
  have setsP : MeasurableSpace.sets(productMeasurableSpace(X, Y)) = generatedSigma(MeasurableSpace.carrier(X) × MeasurableSpace.carrier(Y), rectangles(X, Y))
    unfold productMeasurableSpace
    unfold generatedSpace
    rw MeasurableSpace.mk.sets
  have uX := MeasurableSet.univ with spaceX
  unfold MeasurableSet at uX
  have uY := MeasurableSet.univ with spaceY
  unfold MeasurableSet at uY
  have gsp2 : MeasurableSpace(productMeasurableSpace(X, Y))
    unfold productMeasurableSpace
    exact gsp
  unfold Measurable
  refine ⟨gsp2, spaceY, ?_, ?_⟩
  . unfold MapsInto
    rw carrierP
    intros p hp
    obtain ⟨bound, x, hx, y, hy, pEq⟩ := product.membership.forward with hp
    rw pEq
    rw secondProjection.pair with hx, hy
    exact hy
  . intros B hB
    rw [carrierP, setsP]
    have space2 := spaceY
    obtain ⟨shape, sub, carr, compl, unionClosed⟩ := space2
    have Bp := sub with B, hB
    have BC := (powerset.membership_iff at B, MeasurableSpace.carrier(Y)).forward with Bp
    have pre : functionPreimage(secondProjection(MeasurableSpace.carrier(X), MeasurableSpace.carrier(Y)), MeasurableSpace.carrier(X) × MeasurableSpace.carrier(Y), B) = MeasurableSpace.carrier(X) × B
      ext p
      constructor
      . intro h
        obtain ⟨pIn, val⟩ := functionPreimage.membership.forward with h
        obtain ⟨bound, x, hx, y, hy, pEq⟩ := product.membership.forward with pIn
        rw pEq at val
        rw secondProjection.pair with hx, hy at val
        rw pEq
        exact product.pair with hx, val
      . intro h
        obtain ⟨bound, x, hx, y, hy, pEq⟩ := product.membership.forward with h
        rw pEq
        have yY := BC with y, hy
        have pIn := product.pair with hx, yY
        have val : secondProjection(MeasurableSpace.carrier(X), MeasurableSpace.carrier(Y))((x, y)) ∈ B
          rw secondProjection.pair with hx, yY
          exact hy
        exact functionPreimage.membership.backward with ⟨pIn, val⟩
    rw pre
    apply generatedSigma.generator
    . apply rectangles.membership.backward
      have rsub : MeasurableSpace.carrier(X) × B ⊆ MeasurableSpace.carrier(X) × MeasurableSpace.carrier(Y)
        intros p hp
        obtain ⟨bound, x, hx, y, hy, pEq⟩ := product.membership.forward with hp
        rw pEq
        exact product.pair with hx, (BC with y, hy)
      have rp := (powerset.membership_iff at MeasurableSpace.carrier(X) × B, MeasurableSpace.carrier(X) × MeasurableSpace.carrier(Y)).backward with rsub
      exact ⟨rp, MeasurableSpace.carrier(X), uX, B, hB, rfl⟩
    . intros p hp
      obtain ⟨bound, x, hx, y, hy, pEq⟩ := product.membership.forward with hp
      rw pEq
      exact product.pair with hx, (BC with y, hy)

theorem Measurable.pair (f g h W X Y : Set)
  requires measurableF : Measurable(f, W, X)
  requires measurableG : Measurable(g, W, Y)
  requires pairing : ∀ w ∈ MeasurableSpace.carrier(W), h(w) = (f(w), g(w))
  shows Measurable(h, W, productMeasurableSpace(X, Y))
proof
  have mf := measurableF
  obtain ⟨spaceW, spaceX, mapsF, preF⟩ := mf
  have mg := measurableG
  obtain ⟨spaceW2, spaceY, mapsG, preG⟩ := mg
  have maps : MapsInto(h, MeasurableSpace.carrier(W), MeasurableSpace.carrier(X) × MeasurableSpace.carrier(Y))
    unfold MapsInto
    intros w hw
    rw pairing with w, hw
    exact product.pair with (mapsF with w, hw), (mapsG with w, hw)
  have generators : ∀ S ∈ rectangles(X, Y), S ⊆ MeasurableSpace.carrier(X) × MeasurableSpace.carrier(Y) → functionPreimage(h, MeasurableSpace.carrier(W), S) ∈ MeasurableSpace.sets(W)
    intros S hS sub
    obtain ⟨SP, A, hA, B, hB, e⟩ := rectangles.membership.forward with hS
    have mA : MeasurableSet(X, A)
      unfold MeasurableSet
      exact hA
    have mB : MeasurableSet(Y, B)
      unfold MeasurableSet
      exact hB
    have pA := Measurable.preimage with measurableF, mA
    have pB := Measurable.preimage with measurableG, mB
    have i := MeasurableSet.inter with spaceW, pA, pB
    have same : functionPreimage(h, MeasurableSpace.carrier(W), S) = functionPreimage(f, MeasurableSpace.carrier(W), A) ∩ functionPreimage(g, MeasurableSpace.carrier(W), B)
      rw e
      ext w
      constructor
      . intro hw
        obtain ⟨wW, hv⟩ := functionPreimage.membership.forward with hw
        rw pairing with w, wW at hv
        obtain ⟨fa, gb⟩ := product.pair_membership.forward with hv
        have p1 := functionPreimage.membership.backward with ⟨wW, fa⟩
        have p2 := functionPreimage.membership.backward with ⟨wW, gb⟩
        exact intersection.membership.backward with p1, p2
      . intro hw
        obtain ⟨p1, p2⟩ := intersection.membership.forward with hw
        obtain ⟨wW, fa⟩ := functionPreimage.membership.forward with p1
        obtain ⟨wW2, gb⟩ := functionPreimage.membership.forward with p2
        have hv : h(w) ∈ A × B
          rw pairing with w, wW
          exact product.pair with fa, gb
        exact functionPreimage.membership.backward with ⟨wW, hv⟩
    rw same
    unfold MeasurableSet at i
    exact i
  unfold productMeasurableSpace
  exact Measurable.of_generators with spaceW, maps, generators

-- Mathlib's measurable_prodMk_left: the section y ↦ (x, y) is measurable.
theorem Measurable.section_left (X Y x h : Set)
  requires spaceX : MeasurableSpace(X)
  requires spaceY : MeasurableSpace(Y)
  requires member : x ∈ MeasurableSpace.carrier(X)
  requires pairing : ∀ y ∈ MeasurableSpace.carrier(Y), h(y) = (x, y)
  shows Measurable(h, Y, productMeasurableSpace(X, Y))
proof
  have cst : ∀ y ∈ MeasurableSpace.carrier(Y), (MeasurableSpace.carrier(Y) × {x})(y) = x
    intros y hy
    exact constGraph.apply at MeasurableSpace.carrier(Y), x, y with hy
  have mc := Measurable.constant with spaceY, spaceX, member, cst
  have mi := Measurable.identity with spaceY
  have pairing2 : ∀ y ∈ MeasurableSpace.carrier(Y), h(y) = ((MeasurableSpace.carrier(Y) × {x})(y), identity(MeasurableSpace.carrier(Y))(y))
    intros y hy
    rw cst with y, hy
    rw identity.apply with hy
    exact pairing with y, hy
  exact Measurable.pair with mc, mi, pairing2

-- Mathlib's measurable_pi_iff and measurable_pi_lambda: a map into a
-- finite power is measurable when each coordinate is.
theorem Measurable.pi_iff (f W I X : Set)
  requires space : MeasurableSpace(W)
  requires spaceX : MeasurableSpace(X)
  requires maps : MapsInto(f, MeasurableSpace.carrier(W),
    functionSpace(I, MeasurableSpace.carrier(X)))
  shows Measurable(f, W, piMeasurableSpace(I, X)) ↔
    (∀ i ∈ I, Measurable(familyAt(f, MeasurableSpace.carrier(W), i), W, X))
proof
  sorry

-- Measurability of a map into a subspace, and of the inclusion (Mathlib's
-- measurable_subtype_coe, Measurable.measurable_comp_iff_restrict).
theorem Measurable.subspace_inclusion (X A : Set)
  requires space : MeasurableSpace(X)
  requires inside : A ⊆ MeasurableSpace.carrier(X)
  shows Measurable(identity(A), measurableSubspace(X, A), X)
proof
  sorry

theorem MeasurableEmbedding.subspace_inclusion (X A : Set)
  requires space : MeasurableSpace(X)
  requires set : MeasurableSet(X, A)
  shows MeasurableEmbedding(identity(A), measurableSubspace(X, A), X)
proof
  sorry

-- Mathlib's MeasurableEmbedding.measurableSet_range.
theorem MeasurableEmbedding.range (f X Y : Set)
  requires embedding : MeasurableEmbedding(f, X, Y)
  shows MeasurableSet(Y, valuesOn(f, MeasurableSpace.carrier(X)))
proof
  obtain ⟨m, inj, images⟩ := embedding
  have mm := m
  obtain ⟨sX, _⟩ := mm
  have u := MeasurableSet.univ with sX
  unfold MeasurableSet at u
  unfold MeasurableSet
  exact images with MeasurableSpace.carrier(X), u

-- Mathlib's measurable_comap_iff: a map into A with the preimage
-- σ-algebra of g is measurable exactly when g after it is.
theorem Measurable.comap_iff (f g W A Y : Set)
  requires spaceW : MeasurableSpace(W)
  requires spaceY : MeasurableSpace(Y)
  requires maps : MapsInto(f, MeasurableSpace.carrier(W), A)
  requires mapsG : MapsInto(g, A, MeasurableSpace.carrier(Y))
  shows Measurable(f, W, MeasurableSpace.mk(A, comapSigma(g, A, Y))) ↔
    Measurable(composeOn(g, f, MeasurableSpace.carrier(W)), W, Y)
proof
  sorry

theorem MeasurableEquiv.inverse (f X Y : Set)
  requires equivalence : MeasurableEquiv(f, X, Y)
  shows MeasurableEquiv(converse(f, MeasurableSpace.carrier(X),
    MeasurableSpace.carrier(Y)), Y, X)
proof
  sorry

-- Section: Borel sets
theorem borelSpace.space (X : Set)
  requires space : TopologicalSpace(X)
  shows MeasurableSpace(borelSpace(X))
proof
  unfold borelSpace
  unfold borelSigma
  have sigma := generatedSigma.sigma at TopologicalSpace.carrier(X), TopologicalSpace.opens(X)
  exact MeasurableSpace.of_sigma with sigma

theorem borelSpace.borel (X : Set)
  requires space : TopologicalSpace(X)
  shows BorelSpace(borelSpace(X), X)
proof
  have sp := borelSpace.space with space
  unfold BorelSpace
  refine ⟨sp, space, ?_, ?_⟩
  . unfold borelSpace
    rw MeasurableSpace.mk.carrier
  . unfold borelSpace
    rw MeasurableSpace.mk.sets

-- Mathlib's IsOpen.measurableSet, IsClosed.measurableSet,
-- measurableSet_closure.
theorem MeasurableSet.of_open (X U : Set)
  requires space : TopologicalSpace(X)
  requires open : U ∈ TopologicalSpace.opens(X)
  shows MeasurableSet(borelSpace(X), U)
proof
  have op : Open(X, U)
    unfold Open
    exact open
  have sub := Open.subset with space, op
  have g := generatedSigma.generator with open, sub
  unfold MeasurableSet
  unfold borelSpace
  rw MeasurableSpace.mk.sets
  unfold borelSigma
  exact g

theorem MeasurableSet.of_closed (X C : Set)
  requires space : TopologicalSpace(X)
  requires closed : Closed(X, C)
  shows MeasurableSet(borelSpace(X), C)
proof
  have sp := borelSpace.space with space
  have sub := Closed.subset with space, closed
  have op := Closed.compl_open with space, closed
  unfold Open at op
  unfold complement at op
  have m := MeasurableSet.of_open with space, op
  have c := MeasurableSet.compl with sp, m
  have e : MeasurableSpace.carrier(borelSpace(X)) ∖ (TopologicalSpace.carrier(X) ∖ C) = C
    unfold borelSpace
    rw MeasurableSpace.mk.carrier
    ext x
    simp
  rw e at c
  exact c

-- Compact sets are Borel in a Hausdorff space.
theorem MeasurableSet.of_compact (X K : Set)
  requires space : TopologicalSpace(X)
  requires hausdorff : Hausdorff(X)
  requires compact : Compact(X, K)
  requires inside : K ⊆ TopologicalSpace.carrier(X)
  shows MeasurableSet(borelSpace(X), K)
proof
  sorry

-- Mathlib's Continuous.measurable: a continuous map between topological
-- spaces is Borel measurable.
theorem Measurable.of_continuous (f X Y : Set)
  requires spaceX : TopologicalSpace(X)
  requires spaceY : TopologicalSpace(Y)
  requires continuous : f : X ⇒ Y
  shows Measurable(f, borelSpace(X), borelSpace(Y))
proof
  have spaceB := borelSpace.space with spaceX
  obtain ⟨_, _, map⟩ := continuous
  obtain ⟨function, preimages⟩ := map
  have carrierX : MeasurableSpace.carrier(borelSpace(X)) =
      TopologicalSpace.carrier(X)
    unfold borelSpace
    rw MeasurableSpace.mk.carrier
  have maps : MapsInto(f, MeasurableSpace.carrier(borelSpace(X)),
      TopologicalSpace.carrier(Y))
    unfold MapsInto
    intros x hx
    rw carrierX at hx
    exact FunctionBetween.apply_closed with function, hx
  have generators : ∀ S ∈ TopologicalSpace.opens(Y),
      S ⊆ TopologicalSpace.carrier(Y) →
      functionPreimage(f, MeasurableSpace.carrier(borelSpace(X)), S) ∈
        MeasurableSpace.sets(borelSpace(X))
    intros S hS _
    rw carrierX
    have preimageOpen := preimages with S, hS
    have measurableSet := MeasurableSet.of_open with spaceX, preimageOpen
    unfold MeasurableSet at measurableSet
    exact measurableSet
  have result := Measurable.of_generators with spaceB, maps, generators
  have same : borelSpace(Y) = generatedSpace(TopologicalSpace.carrier(Y),
      TopologicalSpace.opens(Y))
    unfold borelSpace
    unfold borelSigma
    unfold generatedSpace
    rfl
  rw same
  exact result

-- Mathlib's ContinuousOn.measurable_piecewise: a map continuous on a
-- Borel set S and on its complement, glued, is measurable.
theorem Measurable.of_continuous_on_pieces (f X Y S : Set)
  requires spaceX : TopologicalSpace(X)
  requires spaceY : TopologicalSpace(Y)
  requires set : MeasurableSet(borelSpace(X), S)
  requires onS : ∀ x ∈ S, ContinuousWithinAtPoint(f, X, Y, S, x)
  requires offS : ∀ x ∈ TopologicalSpace.carrier(X) ∖ S,
    ContinuousWithinAtPoint(f, X, Y, TopologicalSpace.carrier(X) ∖ S, x)
  requires maps : MapsInto(f, TopologicalSpace.carrier(X), TopologicalSpace.carrier(Y))
  shows Measurable(f, borelSpace(X), borelSpace(Y))
proof
  sorry

-- Section: The Borel sets of ℝ
theorem realMeasurableSpace.space
  shows MeasurableSpace(realMeasurableSpace)
proof
  have t := realLine.space
  unfold realMeasurableSpace
  exact borelSpace.space with t

theorem realMeasurableSpace.carrier
  shows MeasurableSpace.carrier(realMeasurableSpace) = ℝ
proof
  unfold realMeasurableSpace
  unfold borelSpace
  rw MeasurableSpace.mk.carrier
  exact realLine.carrier

def tkGRaySpace : Set := generatedSpace(ℝ, realLowerRays)

theorem tkGRaySpace.space
  shows MeasurableSpace(tkGRaySpace)
proof
  unfold tkGRaySpace
  exact generatedSpace.space at ℝ, realLowerRays

theorem tkGRaySpace.carrier
  shows MeasurableSpace.carrier(tkGRaySpace) = ℝ
proof
  unfold tkGRaySpace
  unfold generatedSpace
  rw MeasurableSpace.mk.carrier

theorem tkGRaySpace.sets
  shows MeasurableSpace.sets(tkGRaySpace) = generatedSigma(ℝ, realLowerRays)
proof
  unfold tkGRaySpace
  unfold generatedSpace
  rw MeasurableSpace.mk.sets

theorem tkGRaySpace.ray (B : Set)
  requires real : B ∈ ℝ
  shows MeasurableSet(tkGRaySpace, realIio(B))
proof
  have sub : realIio(B) ⊆ ℝ
    intros x hx
    simp at hx
    exact hx.left
  have pw := (powerset.membership_iff at realIio(B), ℝ).backward with sub
  have mem : realIio(B) ∈ realLowerRays
    apply realLowerRays.membership.backward
    exact ⟨pw, B, real, rfl⟩
  have g := generatedSigma.generator with mem, sub
  unfold MeasurableSet
  rw tkGRaySpace.sets
  exact g

theorem tkGRaySpace.ici (B : Set)
  requires real : B ∈ ℝ
  shows MeasurableSet(tkGRaySpace, ℝ ∖ realIio(B))
proof
  have sp := tkGRaySpace.space
  have r := tkGRaySpace.ray with real
  have c := MeasurableSet.compl with sp, r
  rw tkGRaySpace.carrier at c
  exact c

def tkGRayPieceSet (a b q : Set) : Set :=
  { x ∈ ℝ | (a:R) < rationalCut(q) ∧ rationalCut(q) ≤ (x:R) ∧ (x:R) < b }
defgraph tkGRayPiece (a b : Set) (q ∈ ℚ) : 𝒫(ℝ) := tkGRayPieceSet(a, b, q)
proof
  apply powerset.membership_iff.backward
  intros x hx
  have hx2 := tkGRayPieceSet.membership.forward with hx
  exact hx2.left

theorem tkGRaySpace.piece (a b q : Set)
  requires realA : a ∈ ℝ
  requires realB : b ∈ ℝ
  requires rational : q ∈ ℚ
  shows MeasurableSet(tkGRaySpace, tkGRayPieceSet(a, b, q))
proof
  have sp := tkGRaySpace.space
  have qR : rationalCut(q) ∈ ℝ
    have r := rationalCut.real at q with rational
    exact r
  by_cases above : (a:R) < rationalCut(q)
  . have e : tkGRayPieceSet(a, b, q) = (ℝ ∖ realIio(rationalCut(q))) ∩ realIio(b)
      ext x
      constructor
      . intro h
        have h2 := tkGRayPieceSet.membership.forward with h
        obtain ⟨xR, _, le, lt⟩ := h2
        constructor
        . constructor
          . exact xR
          . intro h3
            have h3b := realIio.membership.forward with h3
            obtain ⟨_, l⟩ := h3b
            have l2 : (x:R) < (x:R) by linarith
            have l3 := realLess.characterization.forward with l2
            exact RealLess.irreflexive with l3
        . simp
      . intro h
        obtain ⟨h4, h5⟩ := h
        obtain ⟨xR, h6⟩ := h4
        simp at h5
        apply tkGRayPieceSet.membership.backward
        refine ⟨xR, above, ?_, h5.right⟩
        by_contra h7
        have h8 : (x:R) < rationalCut(q) by linarith
        have h9 : x ∈ realIio(rationalCut(q))
          simp
        exact h6 with h9
    rw e
    have m1 := tkGRaySpace.ici with qR
    have m2 := tkGRaySpace.ray with realB
    exact MeasurableSet.inter with sp, m1, m2
  . have e : tkGRayPieceSet(a, b, q) = ∅
      ext x
      constructor
      . intro h
        have h2 := tkGRayPieceSet.membership.forward with h
        obtain ⟨xR, lt, _⟩ := h2
        exfalso
        exact above with lt
      . intro h
        simp at h
    rw e
    exact MeasurableSet.empty with sp

theorem tkGRaySpace.interval (a b : Real)
  shows MeasurableSet(tkGRaySpace, openInterval(a, b))
proof
  have sp := tkGRaySpace.space
  have aR : a ∈ ℝ by typecheck
  have bR : b ∈ ℝ by typecheck
  have qc := rationals.countable
  have all : ∀ q ∈ ℚ, MeasurableSet(tkGRaySpace, tkGRayPiece(a, b)(q))
    intros q hq
    have v := tkGRayPiece.value at a, b, q with hq
    rw v
    exact tkGRaySpace.piece with aR, bR, hq
  have u := MeasurableSet.indexed_union with sp, qc, all
  have e : ⋃(valuesOn(tkGRayPiece(a, b), ℚ)) = openInterval(a, b)
    ext x
    constructor
    . intro h
      obtain ⟨W, hW, xW⟩ := union.membership.forward with h
      obtain ⟨q, hq, eq⟩ := hW
      have v := tkGRayPiece.value at a, b, q with hq
      rw [← eq, v] at xW
      have h2 := tkGRayPieceSet.membership.forward with xW
      obtain ⟨xR, lt, le, lt2⟩ := h2
      apply openInterval.membership.backward
      refine ⟨xR, ?_, lt2⟩
      linarith
    . intro h
      obtain ⟨xR, lt, lt2⟩ := openInterval.membership.forward with h
      obtain ⟨q, hq, l1, l2⟩ := rationalCut.between at a, x with lt
      have v := tkGRayPiece.value at a, b, q with hq
      have mem : x ∈ tkGRayPiece(a, b)(q)
        rw v
        apply tkGRayPieceSet.membership.backward
        refine ⟨xR, l1, ?_, lt2⟩
        linarith
      have inV : tkGRayPiece(a, b)(q) ∈ valuesOn(tkGRayPiece(a, b), ℚ)
        exact valuesOn.membership.backward with ⟨q, hq, rfl⟩
      exact union.contains with inV, mem
  rw e at u
  exact u

theorem tkGRealIio.open (B : Set)
  requires real : B ∈ ℝ
  shows realIio(B) ∈ realTopology
proof
  have e : realIio(B) = cptBelow(B)
    ext x
    simp
  rw e
  exact cptBelow.open with real

theorem tkGIndicator.apply (A S c z x : Set)
  requires member : x ∈ A
  shows (x ∈ S → indicatorOn(A, S, c, z)(x) = c) ∧
    (x ∉ S → indicatorOn(A, S, c, z)(x) = z)
proof
  have pairs : ∀ p ∈ indicatorOn(A, S, c, z), ∃ a, ∃ b, p = (a, b)
    intros p hp
    obtain ⟨pIn, alt⟩ := indicatorOn.membership.forward with hp
    obtain ⟨bound, a, ha, b, hb, pEq⟩ := product.membership.forward with pIn
    exact ⟨a, b, pEq⟩
  have functional : ∀ a, ∀ b, ∀ d, (a, b) ∈ indicatorOn(A, S, c, z) → (a, d) ∈ indicatorOn(A, S, c, z) → b = d
    intros a b d hb hd
    obtain ⟨pb, altB⟩ := indicatorOn.membership.forward with hb
    obtain ⟨pd, altD⟩ := indicatorOn.membership.forward with hd
    simp [fst.pair, snd.pair] at altB
    simp [fst.pair, snd.pair] at altD
    cases altB with inB | outB
    . cases altD with inD | outD
      . rw [inB.right, inD.right]
      . exfalso
        exact outD.left with inB.left
    . cases altD with inD | outD
      . exfalso
        exact outB.left with inD.left
      . rw [outB.right, outD.right]
  constructor
  . intro xS
    have cIn : c ∈ {c} ∪ {z} by simp
    have pr := product.pair with member, cIn
    have edge : (x, c) ∈ indicatorOn(A, S, c, z)
      apply indicatorOn.membership.backward
      refine ⟨pr, ?_⟩
      left
      simp [fst.pair, snd.pair, xS]
    exact pairGraph.apply with pairs, functional, edge
  . intro xS
    have zIn : z ∈ {c} ∪ {z} by simp
    have pr := product.pair with member, zIn
    have edge : (x, z) ∈ indicatorOn(A, S, c, z)
      apply indicatorOn.membership.backward
      refine ⟨pr, ?_⟩
      right
      simp [fst.pair, snd.pair, xS]
    exact pairGraph.apply with pairs, functional, edge

theorem Measurable.indicator (X S c z : Set)
  requires space : MeasurableSpace(X)
  requires set : MeasurableSet(X, S)
  requires memberC : c ∈ ℝ
  requires memberZ : z ∈ ℝ
  shows Measurable(indicatorOn(MeasurableSpace.carrier(X), S, c, z), X,
    realMeasurableSpace)
proof
  have rs := realMeasurableSpace.space
  have cC : c ∈ MeasurableSpace.carrier(realMeasurableSpace)
    rw realMeasurableSpace.carrier
    exact memberC
  have zC : z ∈ MeasurableSpace.carrier(realMeasurableSpace)
    rw realMeasurableSpace.carrier
    exact memberZ
  have mc : Measurable(constantFunction(MeasurableSpace.carrier(X), ℝ, c), X, realMeasurableSpace)
    apply Measurable.constant with space, rs, cC
    intros x xA
    exact constantFunction.apply with xA, memberC
  have mz : Measurable(constantFunction(MeasurableSpace.carrier(X), ℝ, z), X, realMeasurableSpace)
    apply Measurable.constant with space, rs, zC
    intros x xA
    exact constantFunction.apply with xA, memberZ
  have p := Measurable.piecewise with set, mc, mz
  apply Measurable.congr with p
  intros x xA
  obtain ⟨inS, outS⟩ := tkGIndicator.apply at MeasurableSpace.carrier(X), S, c, z, x with xA
  by_cases h : x ∈ S
  . have a := piecewiseOn.apply_in at MeasurableSpace.carrier(X), S, constantFunction(MeasurableSpace.carrier(X), ℝ, c), constantFunction(MeasurableSpace.carrier(X), ℝ, z), x with xA, h
    have k := constantFunction.apply with xA, memberC
    rw [a, k, (inS with h)]
  . have a := piecewiseOn.apply_out at MeasurableSpace.carrier(X), S, constantFunction(MeasurableSpace.carrier(X), ℝ, c), constantFunction(MeasurableSpace.carrier(X), ℝ, z), x with xA, h
    have k := constantFunction.apply with xA, memberZ
    rw [a, k, (outS with h)]

-- Mathlib's borel_eq_generateFrom_Iio (with isPiSystem_Iio): the Borel
-- sets of ℝ are generated by the rays (−∞, b), a π-system.
theorem realMeasurableSpace.generated_by_rays
  shows MeasurableSpace.sets(realMeasurableSpace) =
    generatedSigma(ℝ, realLowerRays)
proof
  have setsEq : MeasurableSpace.sets(realMeasurableSpace) = generatedSigma(ℝ, realTopology)
    unfold realMeasurableSpace
    unfold borelSpace
    rw MeasurableSpace.mk.sets
    unfold borelSigma
    rw [realLine.carrier, realLine.opens]
  rw setsEq
  apply Subset.antisymmetric
  . have sig := generatedSigma.sigma at ℝ, realLowerRays
    apply generatedSigma.least with sig
    intros U hU
    simp at hU
    have basis := rationalIntervals.basis
    have e := Basis.open_union with basis, hU.left
    have cnt : Countable(basisBelow(rationalIntervals, U))
      have c := rationalIntervals.countable
      have sub : basisBelow(rationalIntervals, U) ⊆ rationalIntervals
        intros W hW
        have hW2 := basisBelow.membership.forward with hW
        exact hW2.left
      exact Countable.subset with c, sub
    have all : ∀ W ∈ basisBelow(rationalIntervals, U), MeasurableSet(tkGRaySpace, W)
      intros W hW
      have hW2 := basisBelow.membership.forward with hW
      have parts := rationalIntervals.membership.forward with hW2.left
      obtain ⟨p1, hp, q1, hq, less, shape⟩ := parts.right
      have realP := rationalCut.real at p1 with hp
      have realQ := rationalCut.real at q1 with hq
      rw shape
      exact tkGRaySpace.interval at rationalCut(p1), rationalCut(q1)
    have sp := tkGRaySpace.space
    have m := MeasurableSet.countable_union with sp, cnt, all
    rw ← e at m
    unfold MeasurableSet at m
    rw tkGRaySpace.sets at m
    exact m
  . have sig := generatedSigma.sigma at ℝ, realTopology
    apply generatedSigma.least with sig
    intros U hU
    simp at hU
    obtain ⟨hr, hp⟩ := hU
    have parts := realLowerRays.membership.forward with hr
    obtain ⟨_, B, hB, eq⟩ := parts
    have op : U ∈ realTopology
      rw eq
      exact tkGRealIio.open with hB
    have sub := (powerset.membership_iff at U, ℝ).forward with hp
    exact generatedSigma.generator with op, sub

theorem realIio.pi_system
  shows PiSystem(realLowerRays)
proof
  intros S hS T hT
  obtain ⟨pS, a, ha, eS⟩ := realLowerRays.membership.forward with hS
  obtain ⟨pT, b, hb, eT⟩ := realLowerRays.membership.forward with hT
  have sub : S ∩ T ⊆ ℝ
    intros x hx
    obtain ⟨xS, _⟩ := hx
    have sR := (powerset.membership_iff at S, ℝ).forward with pS
    exact sR with x, xS
  have pw := (powerset.membership_iff at S ∩ T, ℝ).backward with sub
  apply realLowerRays.membership.backward
  refine ⟨pw, ?_⟩
  by_cases le : (a:R) ≤ b
  . refine ⟨a, ha, ?_⟩
    rw [eS, eT]
    ext x
    constructor
    . intro h
      obtain ⟨h1, _⟩ := h
      exact h1
    . intro h
      obtain ⟨xR, lt⟩ := realIio.membership.forward with h
      constructor
      . exact h
      . apply realIio.membership.backward
        refine ⟨xR, ?_⟩
        linarith
  . refine ⟨b, hb, ?_⟩
    rw [eS, eT]
    ext x
    constructor
    . intro h
      obtain ⟨_, h2⟩ := h
      exact h2
    . intro h
      obtain ⟨xR, lt⟩ := realIio.membership.forward with h
      constructor
      . apply realIio.membership.backward
        refine ⟨xR, ?_⟩
        linarith
      . exact h

theorem tkGRealIoi.open (B : Set)
  requires real : B ∈ ℝ
  shows realIoi(B) ∈ realTopology
proof
  have e : realIoi(B) = cptAbove(B)
    ext x
    simp
  rw e
  exact cptAbove.open with real

theorem tkGReal.open_measurable (U : Set)
  requires open : U ∈ realTopology
  shows MeasurableSet(realMeasurableSpace, U)
proof
  have t := realLine.space
  have op : U ∈ TopologicalSpace.opens(realLine)
    rw realLine.opens
    exact open
  have m := MeasurableSet.of_open with t, op
  unfold realMeasurableSpace
  exact m

theorem tkGReal.ici_eq (A : Real)
  shows realIci(A) = ℝ ∖ realIio(A)
proof
  ext x
  constructor
  . intro h
    obtain ⟨xR, le⟩ := realIci.membership.forward with h
    constructor
    . exact xR
    . intro h2
      obtain ⟨_, lt⟩ := realIio.membership.forward with h2
      have l3 : (A:R) < (A:R) by linarith
      have l4 := realLess.characterization.forward with l3
      exact RealLess.irreflexive with l4
  . intro h
    obtain ⟨xR, n⟩ := h
    apply realIci.membership.backward
    refine ⟨xR, ?_⟩
    by_contra nle
    have lt : (x:R) < A by linarith
    exact n with (realIio.membership.backward with ⟨xR, lt⟩)

theorem tkGReal.iic_eq (B : Real)
  shows realIic(B) = ℝ ∖ realIoi(B)
proof
  ext x
  constructor
  . intro h
    obtain ⟨xR, le⟩ := realIic.membership.forward with h
    constructor
    . exact xR
    . intro h2
      obtain ⟨_, lt⟩ := realIoi.membership.forward with h2
      have l3 : (B:R) < (B:R) by linarith
      have l4 := realLess.characterization.forward with l3
      exact RealLess.irreflexive with l4
  . intro h
    obtain ⟨xR, n⟩ := h
    apply realIic.membership.backward
    refine ⟨xR, ?_⟩
    by_contra nle
    have lt : (B:R) < x by linarith
    exact n with (realIoi.membership.backward with ⟨xR, lt⟩)

theorem MeasurableSet.real_intervals (A B : Real)
  shows MeasurableSet(realMeasurableSpace, realIoi(A)) ∧
    MeasurableSet(realMeasurableSpace, realIci(A)) ∧
    MeasurableSet(realMeasurableSpace, realIio(B)) ∧
    MeasurableSet(realMeasurableSpace, realIic(B)) ∧
    MeasurableSet(realMeasurableSpace, realIcc(A, B)) ∧
    MeasurableSet(realMeasurableSpace, realIoo(A, B)) ∧
    MeasurableSet(realMeasurableSpace, realIoc(A, B)) ∧
    MeasurableSet(realMeasurableSpace, realIco(A, B))
proof
  have sp := realMeasurableSpace.space
  have aR : A ∈ ℝ by typecheck
  have bR : B ∈ ℝ by typecheck
  have ioi := tkGReal.open_measurable with (tkGRealIoi.open with aR)
  have iio := tkGReal.open_measurable with (tkGRealIio.open with bR)
  have ioiB := tkGReal.open_measurable with (tkGRealIoi.open with bR)
  have iioA := tkGReal.open_measurable with (tkGRealIio.open with aR)
  have ci := MeasurableSet.compl with sp, iioA
  rw realMeasurableSpace.carrier at ci
  have ici : MeasurableSet(realMeasurableSpace, realIci(A))
    rw (tkGReal.ici_eq at A)
    exact ci
  have cc := MeasurableSet.compl with sp, ioiB
  rw realMeasurableSpace.carrier at cc
  have iic : MeasurableSet(realMeasurableSpace, realIic(B))
    rw (tkGReal.iic_eq at B)
    exact cc
  have eIcc : realIcc(A, B) = realIci(A) ∩ realIic(B)
    ext x
    simp
  have eIoo : realIoo(A, B) = realIoi(A) ∩ realIio(B)
    ext x
    simp
  have eIoc : realIoc(A, B) = realIoi(A) ∩ realIic(B)
    ext x
    simp
  have eIco : realIco(A, B) = realIci(A) ∩ realIio(B)
    ext x
    simp
  refine ⟨ioi, ici, iio, iic, ?_, ?_, ?_, ?_⟩
  . rw eIcc
    exact MeasurableSet.inter with sp, ici, iic
  . rw eIoo
    exact MeasurableSet.inter with sp, ioi, iio
  . rw eIoc
    exact MeasurableSet.inter with sp, ioi, iic
  . rw eIco
    exact MeasurableSet.inter with sp, ici, iio

defgraph tkGSingletonMap (C : Set) (c ∈ C) : 𝒫(C) := {c}
proof
  apply powerset.membership_iff.backward
  intros x hx
  simp at hx
  rw hx
  exact member

-- Mathlib's Set.Countable.measurableSet in ℝ: countable sets, singletons
-- among them, are Borel.
theorem MeasurableSet.real_countable (C : Set)
  requires countable : Countable(C)
  requires inside : C ⊆ ℝ
  shows MeasurableSet(realMeasurableSpace, C)
proof
  have sp := realMeasurableSpace.space
  have all : ∀ c ∈ C, MeasurableSet(realMeasurableSpace, tkGSingletonMap(C)(c))
    intros c hc
    have v := tkGSingletonMap.value at C, c with hc
    rw v
    have cR := inside with c, hc
    have cR2 : Real(c) by typecheck
    obtain ⟨_, _, _, _, icc, _⟩ := MeasurableSet.real_intervals at c, c
    have e : realIcc(c, c) = {c}
      ext x
      constructor
      . intro h
        obtain ⟨xR, l1, l2⟩ := realIcc.membership.forward with h
        have eq : x = c by linarith
        simp
      . intro h
        simp at h
        rw h
        apply realIcc.membership.backward
        refine ⟨cR, ?_, ?_⟩
        . linarith
        . linarith
    rw ← e
    exact icc
  have u := MeasurableSet.indexed_union with sp, countable, all
  have e : ⋃(valuesOn(tkGSingletonMap(C), C)) = C
    ext x
    constructor
    . intro h
      obtain ⟨W, hW, xW⟩ := union.membership.forward with h
      obtain ⟨c, hc, eq⟩ := hW
      have v := tkGSingletonMap.value at C, c with hc
      rw [← eq, v] at xW
      simp at xW
      rw xW
      exact hc
    . intro h
      have v := tkGSingletonMap.value at C, x with h
      have inV : tkGSingletonMap(C)(x) ∈ valuesOn(tkGSingletonMap(C), C)
        exact valuesOn.membership.backward with ⟨x, h, rfl⟩
      have mem : x ∈ tkGSingletonMap(C)(x)
        rw v
        simp
      exact union.contains with inV, mem
  rw e at u
  exact u

theorem tkGMeasurable.open_preimage (f X U : Set)
  requires measurable : Measurable(f, X, realMeasurableSpace)
  requires open : U ∈ realTopology
  shows MeasurableSet(X, functionPreimage(f, MeasurableSpace.carrier(X), U))
proof
  have t := realLine.space
  have op : U ∈ TopologicalSpace.opens(realLine)
    rw realLine.opens
    exact open
  have m := MeasurableSet.of_open with t, op
  have m2 : MeasurableSet(realMeasurableSpace, U)
    unfold realMeasurableSpace
    exact m
  exact Measurable.preimage with measurable, m2

-- Mathlib's measurableSet_setOfPred for a set cut out of the carrier by a
-- measurable map to a two-point space is replaced by: a set cut out by a
-- measurable real map's comparison with a constant.
theorem MeasurableSet.real_lt_locus (X f : Set, C : Real)
  requires measurable : Measurable(f, X, realMeasurableSpace)
  shows MeasurableSet(X, realGtSet(f, MeasurableSpace.carrier(X), C))
proof
  have cR : C ∈ ℝ by typecheck
  have op := tkGRealIoi.open with cR
  have m := tkGMeasurable.open_preimage with measurable, op
  have e : functionPreimage(f, MeasurableSpace.carrier(X), realIoi(C)) = realGtSet(f, MeasurableSpace.carrier(X), C)
    ext x
    constructor
    . intro h
      simp at h
      simp
    . intro h
      obtain ⟨xA, lt⟩ := realGtSet.membership.forward with h
      have fx := Measurable.maps with measurable, xA
      rw realMeasurableSpace.carrier at fx
      apply functionPreimage.membership.backward
      refine ⟨xA, ?_⟩
      exact realIoi.membership.backward with ⟨fx, lt⟩
  rw e at m
  exact m

theorem MeasurableSet.real_le_locus (X f : Set, C : Real)
  requires measurable : Measurable(f, X, realMeasurableSpace)
  shows MeasurableSet(X, realLeSet(f, MeasurableSpace.carrier(X), C))
proof
  have mm := measurable
  obtain ⟨sX, _⟩ := mm
  have m := MeasurableSet.real_lt_locus with measurable
  have c := MeasurableSet.compl with sX, m
  have e : MeasurableSpace.carrier(X) ∖ realGtSet(f, MeasurableSpace.carrier(X), C) = realLeSet(f, MeasurableSpace.carrier(X), C)
    ext x
    constructor
    . intro h
      obtain ⟨xA, notGt⟩ := h
      have fx := Measurable.maps with measurable, xA
      rw realMeasurableSpace.carrier at fx
      apply realLeSet.membership.backward
      refine ⟨xA, ?_⟩
      by_contra nle
      have lt : (C:R) < f(x) by linarith
      have gt : x ∈ realGtSet(f, MeasurableSpace.carrier(X), C)
        exact realGtSet.membership.backward with ⟨xA, lt⟩
      exact notGt with gt
    . intro h
      obtain ⟨xA, le⟩ := realLeSet.membership.forward with h
      have fx := Measurable.maps with measurable, xA
      rw realMeasurableSpace.carrier at fx
      constructor
      . exact xA
      . intro gt
        obtain ⟨_, lt⟩ := realGtSet.membership.forward with gt
        have l2 : (C:R) < (C:R) by linarith
        have l3 := realLess.characterization.forward with l2
        exact RealLess.irreflexive with l3
  rw e at c
  exact c

theorem tkG.real_eq_ray_space
  shows realMeasurableSpace = tkGRaySpace
proof
  have g := realMeasurableSpace.generated_by_rays
  have b : borelSigma(realLine) = generatedSigma(ℝ, realLowerRays)
    unfold realMeasurableSpace at g
    unfold borelSpace at g
    rw MeasurableSpace.mk.sets at g
    exact g
  unfold realMeasurableSpace
  unfold borelSpace
  unfold tkGRaySpace
  unfold generatedSpace
  rw [realLine.carrier, b]

def tkGLePieceSet (f A B q : Set) : Set :=
  { x ∈ A | rationalCut(q) < (B:R) ∧ (f(x):R) ≤ rationalCut(q) }
defgraph tkGLePiece (f A B : Set) (q ∈ ℚ) : 𝒫(A) := tkGLePieceSet(f, A, B, q)
proof
  apply powerset.membership_iff.backward
  intros x hx
  have hx2 := tkGLePieceSet.membership.forward with hx
  exact hx2.left

theorem tkG.lt_preimage_of_rays (f X B : Set)
  requires space : MeasurableSpace(X)
  requires maps : MapsInto(f, MeasurableSpace.carrier(X), ℝ)
  requires rays : ∀ A ∈ ℝ, MeasurableSet(X, realGtSet(f, MeasurableSpace.carrier(X), A))
  requires real : B ∈ ℝ
  shows MeasurableSet(X, functionPreimage(f, MeasurableSpace.carrier(X), realIio(B)))
proof
  have qc := rationals.countable
  have all : ∀ q ∈ ℚ, MeasurableSet(X, tkGLePiece(f, MeasurableSpace.carrier(X), B)(q))
    intros q hq
    have v := tkGLePiece.value at f, MeasurableSpace.carrier(X), B, q with hq
    rw v
    have qR : rationalCut(q) ∈ ℝ
      have r := rationalCut.real at q with hq
      exact r
    by_cases below : rationalCut(q) < (B:R)
    . have e : tkGLePieceSet(f, MeasurableSpace.carrier(X), B, q) = MeasurableSpace.carrier(X) ∖ realGtSet(f, MeasurableSpace.carrier(X), rationalCut(q))
        ext x
        constructor
        . intro h
          obtain ⟨xA, _, le⟩ := tkGLePieceSet.membership.forward with h
          have fx := maps with x, xA
          constructor
          . exact xA
          . intro gt
            obtain ⟨_, lt⟩ := realGtSet.membership.forward with gt
            have l2 : (f(x):R) < (f(x):R) by linarith
            have l3 := realLess.characterization.forward with l2
            exact RealLess.irreflexive with l3
        . intro h
          obtain ⟨xA, notGt⟩ := h
          have fx := maps with x, xA
          apply tkGLePieceSet.membership.backward
          refine ⟨xA, below, ?_⟩
          by_contra nle
          have lt : rationalCut(q) < (f(x):R) by linarith
          have gt : x ∈ realGtSet(f, MeasurableSpace.carrier(X), rationalCut(q))
            exact realGtSet.membership.backward with ⟨xA, lt⟩
          exact notGt with gt
      rw e
      have r := rays with rationalCut(q), qR
      exact MeasurableSet.compl with space, r
    . have e : tkGLePieceSet(f, MeasurableSpace.carrier(X), B, q) = ∅
        ext x
        constructor
        . intro h
          obtain ⟨xA, lt, _⟩ := tkGLePieceSet.membership.forward with h
          exfalso
          exact below with lt
        . intro h
          simp at h
      rw e
      exact MeasurableSet.empty with space
  have u := MeasurableSet.indexed_union with space, qc, all
  have e : ⋃(valuesOn(tkGLePiece(f, MeasurableSpace.carrier(X), B), ℚ)) = functionPreimage(f, MeasurableSpace.carrier(X), realIio(B))
    ext x
    constructor
    . intro h
      obtain ⟨W, hW, xW⟩ := union.membership.forward with h
      obtain ⟨q, hq, eq⟩ := hW
      have v := tkGLePiece.value at f, MeasurableSpace.carrier(X), B, q with hq
      rw [← eq, v] at xW
      obtain ⟨xA, lt, le⟩ := tkGLePieceSet.membership.forward with xW
      have fx := maps with x, xA
      have qR : rationalCut(q) ∈ ℝ
        have r := rationalCut.real at q with hq
        exact r
      apply functionPreimage.membership.backward
      refine ⟨xA, ?_⟩
      apply realIio.membership.backward
      refine ⟨fx, ?_⟩
      linarith
    . intro h
      obtain ⟨xA, fxIn⟩ := functionPreimage.membership.forward with h
      obtain ⟨fx, lt⟩ := realIio.membership.forward with fxIn
      obtain ⟨q, hq, l1, l2⟩ := rationalCut.between at f(x), B with lt
      have v := tkGLePiece.value at f, MeasurableSpace.carrier(X), B, q with hq
      have mem : x ∈ tkGLePiece(f, MeasurableSpace.carrier(X), B)(q)
        rw v
        apply tkGLePieceSet.membership.backward
        refine ⟨xA, l2, ?_⟩
        linarith
      have inV : tkGLePiece(f, MeasurableSpace.carrier(X), B)(q) ∈ valuesOn(tkGLePiece(f, MeasurableSpace.carrier(X), B), ℚ)
        exact valuesOn.membership.backward with ⟨q, hq, rfl⟩
      exact union.contains with inV, mem
  rw e at u
  exact u

-- A real map is measurable when the preimages of the rays (A, ∞) are
-- (Mathlib's measurable_of_Ioi).
theorem Measurable.real_of_rays (f X : Set)
  requires space : MeasurableSpace(X)
  requires maps : MapsInto(f, MeasurableSpace.carrier(X), ℝ)
  requires rays : ∀ A ∈ ℝ, MeasurableSet(X, realGtSet(f, MeasurableSpace.carrier(X), A))
  shows Measurable(f, X, realMeasurableSpace)
proof
  have gens : ∀ S ∈ realLowerRays, S ⊆ ℝ → functionPreimage(f, MeasurableSpace.carrier(X), S) ∈ MeasurableSpace.sets(X)
    intros S hS sub
    have parts := realLowerRays.membership.forward with hS
    obtain ⟨_, B, hB, eq⟩ := parts
    rw eq
    have m := tkG.lt_preimage_of_rays with space, maps, rays, hB
    unfold MeasurableSet at m
    exact m
  have m := Measurable.of_generators at f, X, ℝ, realLowerRays with space, maps, gens
  rw tkG.real_eq_ray_space
  unfold tkGRaySpace
  exact m

def tkGAddPieceSet (f g A a q : Set) : Set :=
  realGtSet(f, A, rationalCut(q)) ∩ realGtSet(g, A, R[a - rationalCut(q)])
defgraph tkGAddPiece (f g A a : Set) (q ∈ ℚ) : 𝒫(A) := tkGAddPieceSet(f, g, A, a, q)
proof
  apply powerset.membership_iff.backward
  intros x hx
  unfold tkGAddPieceSet at hx
  obtain ⟨h1, _⟩ := hx
  have h2 := realGtSet.membership.forward with h1
  exact h2.left

-- Arithmetic of measurable real maps (Mathlib's Measurable.add,
-- Measurable.mul, measurable_const_mul, measurable_mul_const,
-- Measurable.neg, Measurable.sub, Measurable.abs, Measurable.inv).
theorem Measurable.real_add (f g h X : Set)
  requires measurableF : Measurable(f, X, realMeasurableSpace)
  requires measurableG : Measurable(g, X, realMeasurableSpace)
  requires sum : ∀ x ∈ MeasurableSpace.carrier(X), h(x) = R[f(x) + g(x)]
  shows Measurable(h, X, realMeasurableSpace)
proof
  have mm := measurableF
  obtain ⟨space, _⟩ := mm
  have maps : MapsInto(h, MeasurableSpace.carrier(X), ℝ)
    intros x xA
    have fx := Measurable.maps with measurableF, xA
    have gx := Measurable.maps with measurableG, xA
    rw realMeasurableSpace.carrier at fx
    rw realMeasurableSpace.carrier at gx
    have e := sum with x, xA
    rw e
    typecheck
  have qc := rationals.countable
  have rays : ∀ a ∈ ℝ, MeasurableSet(X, realGtSet(h, MeasurableSpace.carrier(X), a))
    intros a aR
    have all : ∀ q ∈ ℚ, MeasurableSet(X, tkGAddPiece(f, g, MeasurableSpace.carrier(X), a)(q))
      intros q hq
      have v := tkGAddPiece.value at f, g, MeasurableSpace.carrier(X), a, q with hq
      rw v
      have qR : rationalCut(q) ∈ ℝ
        have r := rationalCut.real at q with hq
        exact r
      have dR : R[a - rationalCut(q)] ∈ ℝ by typecheck
      have m1 := MeasurableSet.real_lt_locus at X, f, rationalCut(q) with measurableF
      have m2 := MeasurableSet.real_lt_locus at X, g, R[a - rationalCut(q)] with measurableG
      unfold tkGAddPieceSet
      exact MeasurableSet.inter with space, m1, m2
    have u := MeasurableSet.indexed_union with space, qc, all
    have e : ⋃(valuesOn(tkGAddPiece(f, g, MeasurableSpace.carrier(X), a), ℚ)) = realGtSet(h, MeasurableSpace.carrier(X), a)
      ext x
      constructor
      . intro hx
        obtain ⟨W, hW, xW⟩ := union.membership.forward with hx
        obtain ⟨q, hq, eq⟩ := hW
        have v := tkGAddPiece.value at f, g, MeasurableSpace.carrier(X), a, q with hq
        rw [← eq, v] at xW
        unfold tkGAddPieceSet at xW
        obtain ⟨w1, w2⟩ := xW
        obtain ⟨xA, l1⟩ := realGtSet.membership.forward with w1
        obtain ⟨_, l2⟩ := realGtSet.membership.forward with w2
        have fx := Measurable.maps with measurableF, xA
        have gx := Measurable.maps with measurableG, xA
        rw realMeasurableSpace.carrier at fx
        rw realMeasurableSpace.carrier at gx
        have qR : rationalCut(q) ∈ ℝ
          have r := rationalCut.real at q with hq
          exact r
        have e2 := sum with x, xA
        apply realGtSet.membership.backward
        refine ⟨xA, ?_⟩
        rw e2
        linarith
      . intro hx
        obtain ⟨xA, lt⟩ := realGtSet.membership.forward with hx
        have fx := Measurable.maps with measurableF, xA
        have gx := Measurable.maps with measurableG, xA
        rw realMeasurableSpace.carrier at fx
        rw realMeasurableSpace.carrier at gx
        have e2 := sum with x, xA
        rw e2 at lt
        have lt3 : R[a - g(x)] < f(x) by linarith
        obtain ⟨q, hq, l1, l2⟩ := rationalCut.between at R[a - g(x)], f(x) with lt3
        have qR : rationalCut(q) ∈ ℝ
          have r := rationalCut.real at q with hq
          exact r
        have v := tkGAddPiece.value at f, g, MeasurableSpace.carrier(X), a, q with hq
        have mem : x ∈ tkGAddPiece(f, g, MeasurableSpace.carrier(X), a)(q)
          rw v
          unfold tkGAddPieceSet
          have l3 : R[a - rationalCut(q)] < g(x) by linarith
          constructor
          . exact realGtSet.membership.backward with ⟨xA, l2⟩
          . exact realGtSet.membership.backward with ⟨xA, l3⟩
        have inV : tkGAddPiece(f, g, MeasurableSpace.carrier(X), a)(q) ∈ valuesOn(tkGAddPiece(f, g, MeasurableSpace.carrier(X), a), ℚ)
          exact valuesOn.membership.backward with ⟨q, hq, rfl⟩
        exact union.contains with inV, mem
    rw e at u
    exact u
  exact Measurable.real_of_rays with space, maps, rays

def tkGSumOn (f g A : Set) : Set := { (x, R[f(x) + g(x)]) | x ∈ A }

theorem tkGSumOn.apply (f g A x : Set)
  requires member : x ∈ A
  shows tkGSumOn(f, g, A)(x) = R[f(x) + g(x)]
proof
  have edge : (x, R[f(x) + g(x)]) ∈ tkGSumOn(f, g, A)
    apply tkGSumOn.membership.backward
    exact ⟨x, member, rfl⟩
  have pairs : ∀ p ∈ tkGSumOn(f, g, A), ∃ a, ∃ b, p = (a, b)
    intros p hp
    obtain ⟨k, hk, pEq⟩ := tkGSumOn.membership.forward with hp
    rw ← pEq
    exact ⟨k, R[f(k) + g(k)], rfl⟩
  have functional : ∀ a, ∀ b, ∀ c, (a, b) ∈ tkGSumOn(f, g, A) → (a, c) ∈ tkGSumOn(f, g, A) → b = c
    intros a b c hb hc
    obtain ⟨k, hk, bEq⟩ := tkGSumOn.membership.forward with hb
    obtain ⟨m, hm, cEq⟩ := tkGSumOn.membership.forward with hc
    obtain ⟨ka, bb⟩ := orderedPair.injective with bEq
    obtain ⟨ma, cc⟩ := orderedPair.injective with cEq
    rw [← bb, ← cc, ka, ← ma]
  exact pairGraph.apply with pairs, functional, edge

def tkGSquareScale (c : Set) : Set :=
  pointwiseMul(constantRealFunction(c), pointwiseMul(identity(ℝ), identity(ℝ)))

theorem tkGSquareScale.continuous (c : Real)
  shows Continuous(tkGSquareScale(c))
proof
  have k := constantRealFunction.continuous at c
  have i := identity.continuous
  have sq := Continuous.mul with i, i
  unfold tkGSquareScale
  exact Continuous.mul with k, sq

theorem tkGSquareScale.value (c y : Real)
  shows tkGSquareScale(c)(y) = c * (y * y)
proof
  have yR : y ∈ ℝ by typecheck
  have iF := identity.function at ℝ
  have iv := identity.apply with yR
  have iR : Real(identity(ℝ)(y))
    rw iv
    typecheck
  have sqF := pointwiseMul.function with iF, iF
  have sqv := pointwiseMul.value at identity(ℝ), identity(ℝ), y with iF, iF, iR, iR
  rw iv at sqv
  have sqR : Real(pointwiseMul(identity(ℝ), identity(ℝ))(y))
    rw sqv
    typecheck
  have kF := constantRealFunction.function at c
  have kv := constantRealFunction.value at c, y
  have kR : Real(constantRealFunction(c)(y))
    rw kv
    typecheck
  have v := pointwiseMul.value at constantRealFunction(c), pointwiseMul(identity(ℝ), identity(ℝ)), y with kF, sqF, kR, sqR
  unfold tkGSquareScale
  rw [v, kv, sqv]

theorem tkGMeasurable.comp_continuous (f φ h X : Set)
  requires measurable : Measurable(f, X, realMeasurableSpace)
  requires continuous : Continuous(φ)
  requires composite : ∀ x ∈ MeasurableSpace.carrier(X), h(x) = φ(f(x))
  shows Measurable(h, X, realMeasurableSpace)
proof
  have c := (Continuous.iff_real_line at φ).forward with continuous
  have t := realLine.space
  have m := Measurable.of_continuous with t, t, c
  have m2 : Measurable(φ, realMeasurableSpace, realMeasurableSpace)
    unfold realMeasurableSpace
    exact m
  exact Measurable.comp with measurable, m2, composite

theorem Measurable.real_mul (f g h X : Set)
  requires measurableF : Measurable(f, X, realMeasurableSpace)
  requires measurableG : Measurable(g, X, realMeasurableSpace)
  requires product : ∀ x ∈ MeasurableSpace.carrier(X), h(x) = R[f(x) * g(x)]
  shows Measurable(h, X, realMeasurableSpace)
proof
  have hR := half.real at (1:R)
  have c2 := half.add_self at (1:R)
  have nR : R[-half(1)] ∈ ℝ by typecheck
  have nR2 : Real(R[-half(1)]) by typecheck
  have hR2 : Real(half(1)) by typecheck
  have sm := Measurable.real_add at f, g, tkGSumOn(f, g, MeasurableSpace.carrier(X)), X with measurableF, measurableG, (tkGSumOn.apply at f, g, MeasurableSpace.carrier(X))
  have k1 := tkGSquareScale.continuous at half(1)
  have k2 := tkGSquareScale.continuous at R[-half(1)]
  have u1 := tkGMeasurable.comp_continuous at tkGSumOn(f, g, MeasurableSpace.carrier(X)), tkGSquareScale(half(1)), composeOn(tkGSquareScale(half(1)), tkGSumOn(f, g, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X)), X with sm, k1, (composeOn.apply at tkGSquareScale(half(1)), tkGSumOn(f, g, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X))
  have u2 := tkGMeasurable.comp_continuous at f, tkGSquareScale(R[-half(1)]), composeOn(tkGSquareScale(R[-half(1)]), f, MeasurableSpace.carrier(X)), X with measurableF, k2, (composeOn.apply at tkGSquareScale(R[-half(1)]), f, MeasurableSpace.carrier(X))
  have u3 := tkGMeasurable.comp_continuous at g, tkGSquareScale(R[-half(1)]), composeOn(tkGSquareScale(R[-half(1)]), g, MeasurableSpace.carrier(X)), X with measurableG, k2, (composeOn.apply at tkGSquareScale(R[-half(1)]), g, MeasurableSpace.carrier(X))
  have u12 := Measurable.real_add at composeOn(tkGSquareScale(half(1)), tkGSumOn(f, g, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X)), composeOn(tkGSquareScale(R[-half(1)]), f, MeasurableSpace.carrier(X)), tkGSumOn(composeOn(tkGSquareScale(half(1)), tkGSumOn(f, g, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X)), composeOn(tkGSquareScale(R[-half(1)]), f, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X)), X with u1, u2, (tkGSumOn.apply at composeOn(tkGSquareScale(half(1)), tkGSumOn(f, g, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X)), composeOn(tkGSquareScale(R[-half(1)]), f, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X))
  have eq : ∀ x ∈ MeasurableSpace.carrier(X), h(x) = R[tkGSumOn(composeOn(tkGSquareScale(half(1)), tkGSumOn(f, g, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X)), composeOn(tkGSquareScale(R[-half(1)]), f, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X))(x) + composeOn(tkGSquareScale(R[-half(1)]), g, MeasurableSpace.carrier(X))(x)]
    intros x xA
    have fx := Measurable.maps with measurableF, xA
    have gx := Measurable.maps with measurableG, xA
    rw realMeasurableSpace.carrier at fx
    rw realMeasurableSpace.carrier at gx
    have sR : R[f(x) + g(x)] ∈ ℝ by typecheck
    have a1 := tkGSumOn.apply at f, g, MeasurableSpace.carrier(X), x with xA
    have a2 := composeOn.apply at tkGSquareScale(half(1)), tkGSumOn(f, g, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X), x with xA
    have a3 := composeOn.apply at tkGSquareScale(R[-half(1)]), f, MeasurableSpace.carrier(X), x with xA
    have a4 := composeOn.apply at tkGSquareScale(R[-half(1)]), g, MeasurableSpace.carrier(X), x with xA
    have a5 := tkGSumOn.apply at composeOn(tkGSquareScale(half(1)), tkGSumOn(f, g, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X)), composeOn(tkGSquareScale(R[-half(1)]), f, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X), x with xA
    have v1 := tkGSquareScale.value at half(1), R[f(x) + g(x)]
    have v2 := tkGSquareScale.value at R[-half(1)], f(x)
    have v3 := tkGSquareScale.value at R[-half(1)], g(x)
    rw [a5, a2, a3, a4, a1, v1, v2, v3]
    have e := product with x, xA
    rw e
    symm
    linear_combination (f(x) * g(x)) * c2
  exact Measurable.real_add with u12, u3, eq

theorem Measurable.real_neg (f h X : Set)
  requires measurable : Measurable(f, X, realMeasurableSpace)
  requires negation : ∀ x ∈ MeasurableSpace.carrier(X), h(x) = R[-f(x)]
  shows Measurable(h, X, realMeasurableSpace)
proof
  have mm := measurable
  obtain ⟨space, _⟩ := mm
  have maps : MapsInto(h, MeasurableSpace.carrier(X), ℝ)
    intros x xA
    have fx := Measurable.maps with measurable, xA
    rw realMeasurableSpace.carrier at fx
    have e := negation with x, xA
    rw e
    typecheck
  have rays : ∀ a ∈ ℝ, MeasurableSet(X, realGtSet(h, MeasurableSpace.carrier(X), a))
    intros a aR
    have nR : R[-a] ∈ ℝ by typecheck
    have op := tkGRealIio.open with nR
    have m := tkGMeasurable.open_preimage with measurable, op
    have e : functionPreimage(f, MeasurableSpace.carrier(X), realIio(R[-a])) = realGtSet(h, MeasurableSpace.carrier(X), a)
      ext x
      constructor
      . intro hx
        obtain ⟨xA, fxIn⟩ := functionPreimage.membership.forward with hx
        obtain ⟨fx, lt⟩ := realIio.membership.forward with fxIn
        have e2 := negation with x, xA
        apply realGtSet.membership.backward
        refine ⟨xA, ?_⟩
        rw e2
        linarith
      . intro hx
        obtain ⟨xA, lt⟩ := realGtSet.membership.forward with hx
        have fx := Measurable.maps with measurable, xA
        rw realMeasurableSpace.carrier at fx
        have e2 := negation with x, xA
        rw e2 at lt
        apply functionPreimage.membership.backward
        refine ⟨xA, ?_⟩
        apply realIio.membership.backward
        refine ⟨fx, ?_⟩
        linarith
    rw e at m
    exact m
  exact Measurable.real_of_rays with space, maps, rays

theorem Measurable.real_abs (f h X : Set)
  requires measurable : Measurable(f, X, realMeasurableSpace)
  requires absolute : ∀ x ∈ MeasurableSpace.carrier(X), h(x) = abs(f(x))
  shows Measurable(h, X, realMeasurableSpace)
proof
  have mm := measurable
  obtain ⟨space, _⟩ := mm
  have maps : MapsInto(h, MeasurableSpace.carrier(X), ℝ)
    intros x xA
    have fx := Measurable.maps with measurable, xA
    rw realMeasurableSpace.carrier at fx
    have e := absolute with x, xA
    rw e
    exact abs.real at f(x) with fx
  have rays : ∀ a ∈ ℝ, MeasurableSet(X, realGtSet(h, MeasurableSpace.carrier(X), a))
    intros a aR
    have nR : R[-a] ∈ ℝ by typecheck
    have op := tkGRealIio.open with nR
    have m1 := tkGMeasurable.open_preimage with measurable, op
    have m2 := MeasurableSet.real_lt_locus at X, f, a with measurable
    have m := MeasurableSet.union with space, m2, m1
    have e : realGtSet(f, MeasurableSpace.carrier(X), a) ∪ functionPreimage(f, MeasurableSpace.carrier(X), realIio(R[-a])) = realGtSet(h, MeasurableSpace.carrier(X), a)
      ext x
      constructor
      . intro hx
        have e1 := union2.membership.forward with hx
        cases e1 with g1 | g2
        . obtain ⟨xA, lt⟩ := realGtSet.membership.forward with g1
          have fx := Measurable.maps with measurable, xA
          rw realMeasurableSpace.carrier at fx
          have e2 := absolute with x, xA
          have up := abs.upper at f(x) with fx
          have ar := abs.real at f(x) with fx
          apply realGtSet.membership.backward
          refine ⟨xA, ?_⟩
          rw e2
          linarith
        . obtain ⟨xA, fxIn⟩ := functionPreimage.membership.forward with g2
          obtain ⟨fx, lt⟩ := realIio.membership.forward with fxIn
          have e2 := absolute with x, xA
          have up := abs.upper_neg at f(x) with fx
          have ar := abs.real at f(x) with fx
          apply realGtSet.membership.backward
          refine ⟨xA, ?_⟩
          rw e2
          linarith
      . intro hx
        obtain ⟨xA, lt⟩ := realGtSet.membership.forward with hx
        have fx := Measurable.maps with measurable, xA
        rw realMeasurableSpace.carrier at fx
        have e2 := absolute with x, xA
        rw e2 at lt
        apply union2.membership.backward
        by_cases nn : (0:R) ≤ f(x)
        . have v := abs.of_nonnegative at f(x) with fx, nn
          rw v at lt
          left
          exact realGtSet.membership.backward with ⟨xA, lt⟩
        . have np : f(x) ≤ (0:R) by linarith
          have v := abs.of_nonpositive at f(x) with fx, np
          rw v at lt
          right
          apply functionPreimage.membership.backward
          refine ⟨xA, ?_⟩
          apply realIio.membership.backward
          refine ⟨fx, ?_⟩
          linarith
    rw e at m
    exact m
  exact Measurable.real_of_rays with space, maps, rays

theorem Measurable.real_inv (f h X : Set)
  requires measurable : Measurable(f, X, realMeasurableSpace)
  requires inverse : ∀ x ∈ MeasurableSpace.carrier(X), h(x) = realInvValue(f(x))
  shows Measurable(h, X, realMeasurableSpace)
proof
  sorry

theorem tkGFamilyAt.sequence (u A x : Set)
  requires values : ∀ n ∈ ℕ, u(n)(x) ∈ ℝ
  shows RealSequence(familyAt(u, ℕ, x))
proof
  unfold RealSequence
  apply FunctionBetween.of_graph
  . intros p hp
    obtain ⟨n, hn, pEq⟩ := familyAt.membership.forward with hp
    symm at pEq
    exact ⟨n, hn, u(n)(x), (values with n, hn), pEq⟩
  . intros a b c hb hc
    obtain ⟨k, hk, bEq⟩ := familyAt.membership.forward with hb
    obtain ⟨m, hm, cEq⟩ := familyAt.membership.forward with hc
    obtain ⟨ka, bb⟩ := orderedPair.injective with bEq
    obtain ⟨ma, cc⟩ := orderedPair.injective with cEq
    rw [← bb, ← cc, ka, ← ma]
  . intros n hn
    refine ⟨u(n)(x), (values with n, hn), ?_⟩
    apply familyAt.membership.backward
    exact ⟨n, hn, rfl⟩

theorem tkGLimit.eventually (u x L : Set, E : Real)
  requires values : ∀ n ∈ ℕ, u(n)(x) ∈ ℝ
  requires real : L ∈ ℝ
  requires limit : Tendsto(familyAt(u, ℕ, x), ℕ, natAtTop, nhds(realLine, L))
  requires positive : realZero < E
  shows ∃ N ∈ ℕ, ∀ n ∈ ℕ, N ≤ n → R[L - E] < u(n)(x) ∧ u(n)(x) < R[L + E]
proof
  have sq := tkGFamilyAt.sequence at u, ℕ, x with values
  have c := (ConvergesTo.iff_tendsto at familyAt(u, ℕ, x), L with sq, real).backward with limit
  obtain ⟨_, ev⟩ := c
  have eR : E ∈ ℝ by typecheck
  obtain ⟨N, hN, all⟩ := ev with E, eR, positive
  refine ⟨N, hN, ?_⟩
  intros n hn le
  have b := all with n, hn, le
  have a := familyAt.apply at u, ℕ, x, n with hn
  rw a at b
  have LR : Real(L) by typecheck
  have uR : Real(u(n)(x)) by exact values with n, hn
  obtain ⟨l1, l2⟩ := (openBall.order_characterization at u(n)(x), L, E).forward with b
  have uR2 := values with n, hn
  constructor
  . linarith
  . linarith

def tkGTailSet (u A c N n : Set) : Set := { x ∈ A | (N:N) ≤ (n:N) → (c:R) < u(n)(x) }
defgraph tkGTail (u A c N : Set) (n ∈ ℕ) : 𝒫(A) := tkGTailSet(u, A, c, N, n)
proof
  apply powerset.membership_iff.backward
  intros x hx
  have hx2 := tkGTailSet.membership.forward with hx
  exact hx2.left

def tkGLimPieceSet (u A a q N : Set) : Set :=
  { x ∈ A | (a:R) < rationalCut(q) ∧ (∀ n ∈ ℕ, (N:N) ≤ (n:N) → rationalCut(q) < u(n)(x)) }
defgraph tkGLimPiece (u A a : Set) (p ∈ ℚ × ℕ) : 𝒫(A) := tkGLimPieceSet(u, A, a, fst(p), snd(p))
proof
  apply powerset.membership_iff.backward
  intros x hx
  have hx2 := tkGLimPieceSet.membership.forward with hx
  exact hx2.left

theorem tkGLimit.piece (u X a q N : Set)
  requires measurable : ∀ n ∈ ℕ, Measurable(u(n), X, realMeasurableSpace)
  requires space : MeasurableSpace(X)
  requires rational : q ∈ ℚ
  requires natural : N ∈ ℕ
  shows MeasurableSet(X, tkGLimPieceSet(u, MeasurableSpace.carrier(X), a, q, N))
proof
  have qR : rationalCut(q) ∈ ℝ
    have r := rationalCut.real at q with rational
    exact r
  have qR2 : Real(rationalCut(q)) by typecheck
  by_cases above : (a:R) < rationalCut(q)
  . have tails : ∀ n ∈ ℕ, MeasurableSet(X, tkGTail(u, MeasurableSpace.carrier(X), rationalCut(q), N)(n))
      intros n hn
      have v := tkGTail.value at u, MeasurableSpace.carrier(X), rationalCut(q), N, n with hn
      rw v
      by_cases le : (N:N) ≤ (n:N)
      . have e : tkGTailSet(u, MeasurableSpace.carrier(X), rationalCut(q), N, n) = realGtSet(u(n), MeasurableSpace.carrier(X), rationalCut(q))
          ext x
          constructor
          . intro h
            obtain ⟨xA, imp⟩ := tkGTailSet.membership.forward with h
            exact realGtSet.membership.backward with ⟨xA, (imp with le)⟩
          . intro h
            obtain ⟨xA, lt⟩ := realGtSet.membership.forward with h
            apply tkGTailSet.membership.backward
            refine ⟨xA, ?_⟩
            intro _
            exact lt
        rw e
        exact MeasurableSet.real_lt_locus at X, u(n), rationalCut(q) with (measurable with n, hn)
      . have e : tkGTailSet(u, MeasurableSpace.carrier(X), rationalCut(q), N, n) = MeasurableSpace.carrier(X)
          ext x
          constructor
          . intro h
            have h2 := tkGTailSet.membership.forward with h
            exact h2.left
          . intro xA
            apply tkGTailSet.membership.backward
            refine ⟨xA, ?_⟩
            intro le2
            exfalso
            exact le with le2
        rw e
        exact MeasurableSet.univ with space
    have si := MeasurableSet.sequence_inter with space, tails
    have e : sequenceInter(MeasurableSpace.carrier(X), tkGTail(u, MeasurableSpace.carrier(X), rationalCut(q), N)) = tkGLimPieceSet(u, MeasurableSpace.carrier(X), a, q, N)
      ext x
      constructor
      . intro h
        obtain ⟨xA, all⟩ := sequenceInter.membership.forward with h
        apply tkGLimPieceSet.membership.backward
        refine ⟨xA, above, ?_⟩
        intros n hn le
        have t := all with n, hn
        have v := tkGTail.value at u, MeasurableSpace.carrier(X), rationalCut(q), N, n with hn
        rw v at t
        obtain ⟨_, imp⟩ := tkGTailSet.membership.forward with t
        exact imp with le
      . intro h
        obtain ⟨xA, _, all⟩ := tkGLimPieceSet.membership.forward with h
        apply sequenceInter.membership.backward
        refine ⟨xA, ?_⟩
        intros n hn
        have v := tkGTail.value at u, MeasurableSpace.carrier(X), rationalCut(q), N, n with hn
        rw v
        apply tkGTailSet.membership.backward
        refine ⟨xA, ?_⟩
        intro le
        exact all with n, hn, le
    rw e at si
    exact si
  . have e : tkGLimPieceSet(u, MeasurableSpace.carrier(X), a, q, N) = ∅
      ext x
      constructor
      . intro h
        obtain ⟨_, lt, _⟩ := tkGLimPieceSet.membership.forward with h
        exfalso
        exact above with lt
      . intro h
        simp at h
    rw e
    exact MeasurableSet.empty with space

-- The supremum and infimum of a sequence of measurable real maps, where
-- bounded, and a pointwise limit of measurable real maps (Mathlib's
-- measurable_of_tendsto_metrizable).
theorem Measurable.real_limit (u f X : Set)
  requires measurable : ∀ n ∈ ℕ, Measurable(u(n), X, realMeasurableSpace)
  requires maps : MapsInto(f, MeasurableSpace.carrier(X), ℝ)
  requires limit : ∀ x ∈ MeasurableSpace.carrier(X),
    Tendsto(familyAt(u, ℕ, x), ℕ, natAtTop, nhds(realLine, f(x)))
  shows Measurable(f, X, realMeasurableSpace)
proof
  have zN : ∅ ∈ ℕ by typecheck
  have m0 := measurable with ∅, zN
  have mm := m0
  obtain ⟨space, _⟩ := mm
  have vals : ∀ x ∈ MeasurableSpace.carrier(X), ∀ n ∈ ℕ, u(n)(x) ∈ ℝ
    intros x xA n hn
    have ux := Measurable.maps with (measurable with n, hn), xA
    rw realMeasurableSpace.carrier at ux
    exact ux
  have qc := rationals.countable
  have nc := naturals.countable
  have pc := Countable.product with qc, nc
  have rays : ∀ a ∈ ℝ, MeasurableSet(X, realGtSet(f, MeasurableSpace.carrier(X), a))
    intros a aR
    have all : ∀ p ∈ ℚ × ℕ, MeasurableSet(X, tkGLimPiece(u, MeasurableSpace.carrier(X), a)(p))
      intros p hp
      have v := tkGLimPiece.value at u, MeasurableSpace.carrier(X), a, p with hp
      rw v
      obtain ⟨bound, q, hq, N, hN, pEq⟩ := product.membership.forward with hp
      rw [pEq, fst.pair, snd.pair]
      exact tkGLimit.piece with measurable, space, hq, hN
    have un := MeasurableSet.indexed_union with space, pc, all
    have e : ⋃(valuesOn(tkGLimPiece(u, MeasurableSpace.carrier(X), a), ℚ × ℕ)) = realGtSet(f, MeasurableSpace.carrier(X), a)
      ext x
      constructor
      . intro h
        obtain ⟨W, hW, xW⟩ := union.membership.forward with h
        obtain ⟨p, hp, eq⟩ := hW
        have v := tkGLimPiece.value at u, MeasurableSpace.carrier(X), a, p with hp
        obtain ⟨bound, q, hq, N, hN, pEq⟩ := product.membership.forward with hp
        rw [← eq, v, pEq, fst.pair, snd.pair] at xW
        obtain ⟨xA, aq, tail⟩ := tkGLimPieceSet.membership.forward with xW
        have fx := maps with x, xA
        have qR : rationalCut(q) ∈ ℝ
          have r := rationalCut.real at q with hq
          exact r
        apply realGtSet.membership.backward
        refine ⟨xA, ?_⟩
        by_contra nlt
        have le : f(x) ≤ (a:R) by linarith
        have Epos : realZero < R[rationalCut(q) - f(x)] by linarith
        have ER : Real(R[rationalCut(q) - f(x)]) by typecheck
        obtain ⟨N2, hN2, ev⟩ := tkGLimit.eventually at u, x, f(x), R[rationalCut(q) - f(x)] with (vals with x, xA), fx, (limit with x, xA), Epos
        have NN : Nat(N) by exact hN
        have NN2 : Nat(N2) by exact hN2
        by_cases le2 : (N:N) ≤ (N2:N)
        . have t := tail with N2, hN2, le2
          have r2 : (N2:N) ≤ (N2:N) by arith
          obtain ⟨_, b2⟩ := ev with N2, hN2, r2
          have uR := vals with x, xA, N2, hN2
          have l3 : rationalCut(q) < rationalCut(q) by linarith
          have l4 := realLess.characterization.forward with l3
          exact RealLess.irreflexive with l4
        . have r1 : (N:N) ≤ (N:N) by arith
          have r2 : (N2:N) ≤ (N:N) by arith
          have t := tail with N, hN, r1
          obtain ⟨_, b2⟩ := ev with N, hN, r2
          have uR := vals with x, xA, N, hN
          have l3 : rationalCut(q) < rationalCut(q) by linarith
          have l4 := realLess.characterization.forward with l3
          exact RealLess.irreflexive with l4
      . intro h
        obtain ⟨xA, lt⟩ := realGtSet.membership.forward with h
        have fx := maps with x, xA
        obtain ⟨q, hq, l1, l2⟩ := rationalCut.between at a, f(x) with lt
        have qR : rationalCut(q) ∈ ℝ
          have r := rationalCut.real at q with hq
          exact r
        have Epos : realZero < R[f(x) - rationalCut(q)] by linarith
        have ER : Real(R[f(x) - rationalCut(q)]) by typecheck
        obtain ⟨N, hN, ev⟩ := tkGLimit.eventually at u, x, f(x), R[f(x) - rationalCut(q)] with (vals with x, xA), fx, (limit with x, xA), Epos
        have pIn := product.pair with hq, hN
        have v := tkGLimPiece.value at u, MeasurableSpace.carrier(X), a, (q, N) with pIn
        rw [fst.pair, snd.pair] at v
        have mem : x ∈ tkGLimPiece(u, MeasurableSpace.carrier(X), a)((q, N))
          rw v
          apply tkGLimPieceSet.membership.backward
          refine ⟨xA, l1, ?_⟩
          intros n hn le
          obtain ⟨b1, _⟩ := ev with n, hn, le
          have unR := vals with x, xA, n, hn
          linarith
        have inV : tkGLimPiece(u, MeasurableSpace.carrier(X), a)((q, N)) ∈ valuesOn(tkGLimPiece(u, MeasurableSpace.carrier(X), a), ℚ × ℕ)
          exact valuesOn.membership.backward with ⟨(q, N), pIn, rfl⟩
        exact union.contains with inV, mem
    rw e at un
    exact un
  exact Measurable.real_of_rays with space, maps, rays

-- Section: The Borel sets of ℂ
theorem complexMeasurableSpace.space
  shows MeasurableSpace(complexMeasurableSpace)
proof
  have ng := complexAdditiveGroup.normed
  have t := normTopology.space at complexAdditiveGroup, complexAbs with ng
  have t2 : TopologicalSpace(complexSpace)
    unfold complexSpace
    exact t
  unfold complexMeasurableSpace
  exact borelSpace.space with t2

theorem complexMeasurableSpace.carrier
  shows MeasurableSpace.carrier(complexMeasurableSpace) = complexCarrier
proof
  unfold complexMeasurableSpace
  unfold borelSpace
  rw MeasurableSpace.mk.carrier
  exact complexSpace.carrier

theorem tkGComplexFst.continuous
  shows firstProjection(ℝ, ℝ) : complexSpace ⇒ realLine
proof
  have ngC := complexAdditiveGroup.normed
  obtain ⟨c, m⟩ := complexAdditiveGroup.parts
  have abelianC := ngC.left
  have groupC := AbelianGroup.to_group with abelianC
  have ntf := NormedField.real
  have ngR := ntf.left.right.right.left.right.left
  rw ← realAdditiveGroup.ring_additive at ngR
  have abelianR := realAdditiveGroup.abelian
  have groupR := AbelianGroup.to_group with abelianR
  obtain ⟨abR, cR, mR, oR⟩ := realAdditiveGroup.parts
  have fn : firstProjection(ℝ, ℝ) : Group.carrier(complexAdditiveGroup) → Group.carrier(realAdditiveGroup)
    rw [c, cR]
    unfold complexCarrier
    exact firstProjection.function at ℝ, ℝ
  have hom : firstProjection(ℝ, ℝ) : complexAdditiveGroup →* realAdditiveGroup
    apply GroupHom.mk with groupC, groupR, fn
    intros x hx y hy
    rw c at hx
    rw c at hy
    rw [m, mR]
    have xy := FunctionBetween.apply_closed with complexAdd.function, (product.pair with hx, hy)
    have e1 := complexRe.projection with xy
    have e2 := complexRe.projection with hx
    have e3 := complexRe.projection with hy
    have ad := complexRe.add with hx, hy
    rw [e2, e3]
    have same : complexAdd(x, y) = complexAdd((x, y))
      unfold Algebra.call2
      rfl
    rw ← same at e1
    rw [e1, ad]
  have bound : ∀ z ∈ Group.carrier(complexAdditiveGroup), realAbs(firstProjection(ℝ, ℝ)(z)) ≤ complexAbs(z)
    intros z hz
    rw c at hz
    have e := complexRe.projection with hz
    rw e
    have le := complexAbs.re_le with hz
    unfold abs at le
    exact le
  have cont := normTopology.continuous_of_contraction at firstProjection(ℝ, ℝ), complexAdditiveGroup, complexAbs, realAdditiveGroup, realAbs with ngC, ngR, hom, bound
  rw [realAdditiveGroup.ring_additive, normTopology.real] at cont
  unfold complexSpace
  exact cont

theorem tkGComplexSnd.continuous
  shows secondProjection(ℝ, ℝ) : complexSpace ⇒ realLine
proof
  have ngC := complexAdditiveGroup.normed
  obtain ⟨c, m⟩ := complexAdditiveGroup.parts
  have abelianC := ngC.left
  have groupC := AbelianGroup.to_group with abelianC
  have ntf := NormedField.real
  have ngR := ntf.left.right.right.left.right.left
  rw ← realAdditiveGroup.ring_additive at ngR
  have abelianR := realAdditiveGroup.abelian
  have groupR := AbelianGroup.to_group with abelianR
  obtain ⟨abR, cR, mR, oR⟩ := realAdditiveGroup.parts
  have fn : secondProjection(ℝ, ℝ) : Group.carrier(complexAdditiveGroup) → Group.carrier(realAdditiveGroup)
    rw [c, cR]
    unfold complexCarrier
    exact secondProjection.function at ℝ, ℝ
  have hom : secondProjection(ℝ, ℝ) : complexAdditiveGroup →* realAdditiveGroup
    apply GroupHom.mk with groupC, groupR, fn
    intros x hx y hy
    rw c at hx
    rw c at hy
    rw [m, mR]
    have xy := FunctionBetween.apply_closed with complexAdd.function, (product.pair with hx, hy)
    have e1 := complexIm.projection with xy
    have e2 := complexIm.projection with hx
    have e3 := complexIm.projection with hy
    have ad := complexIm.add with hx, hy
    rw [e2, e3]
    have same : complexAdd(x, y) = complexAdd((x, y))
      unfold Algebra.call2
      rfl
    rw ← same at e1
    rw [e1, ad]
  have bound : ∀ z ∈ Group.carrier(complexAdditiveGroup), realAbs(secondProjection(ℝ, ℝ)(z)) ≤ complexAbs(z)
    intros z hz
    rw c at hz
    have e := complexIm.projection with hz
    rw e
    have le := complexAbs.im_le with hz
    unfold abs at le
    exact le
  have cont := normTopology.continuous_of_contraction at secondProjection(ℝ, ℝ), complexAdditiveGroup, complexAbs, realAdditiveGroup, realAbs with ngC, ngR, hom, bound
  rw [realAdditiveGroup.ring_additive, normTopology.real] at cont
  unfold complexSpace
  exact cont

theorem tkGComplexFst.measurable
  shows Measurable(firstProjection(ℝ, ℝ), complexMeasurableSpace, realMeasurableSpace)
proof
  have t1 := normTopology.space at complexAdditiveGroup, complexAbs with complexAdditiveGroup.normed
  have t2 : TopologicalSpace(complexSpace)
    unfold complexSpace
    exact t1
  have m := Measurable.of_continuous with t2, realLine.space, tkGComplexFst.continuous
  unfold complexMeasurableSpace
  unfold realMeasurableSpace
  exact m

theorem tkGComplexSnd.measurable
  shows Measurable(secondProjection(ℝ, ℝ), complexMeasurableSpace, realMeasurableSpace)
proof
  have t1 := normTopology.space at complexAdditiveGroup, complexAbs with complexAdditiveGroup.normed
  have t2 : TopologicalSpace(complexSpace)
    unfold complexSpace
    exact t1
  have m := Measurable.of_continuous with t2, realLine.space, tkGComplexSnd.continuous
  unfold complexMeasurableSpace
  unfold realMeasurableSpace
  exact m

theorem tkGComplex.rectangle (S T : Set)
  requires measurableS : MeasurableSet(realMeasurableSpace, S)
  requires measurableT : MeasurableSet(realMeasurableSpace, T)
  shows MeasurableSet(complexMeasurableSpace, S × T)
proof
  have sp := complexMeasurableSpace.space
  have r := realMeasurableSpace.space
  have subS := MeasurableSet.subset with r, measurableS
  have subT := MeasurableSet.subset with r, measurableT
  rw realMeasurableSpace.carrier at subS
  rw realMeasurableSpace.carrier at subT
  have m1 := Measurable.preimage with tkGComplexFst.measurable, measurableS
  have m2 := Measurable.preimage with tkGComplexSnd.measurable, measurableT
  have m := MeasurableSet.inter with sp, m1, m2
  rw complexMeasurableSpace.carrier at m
  have e : functionPreimage(firstProjection(ℝ, ℝ), complexCarrier, S) ∩ functionPreimage(secondProjection(ℝ, ℝ), complexCarrier, T) = S × T
    ext z
    constructor
    . intro h
      obtain ⟨h1, h2⟩ := h
      obtain ⟨zC, zS⟩ := functionPreimage.membership.forward with h1
      obtain ⟨_, zT⟩ := functionPreimage.membership.forward with h2
      have zC2 := zC
      unfold complexCarrier at zC2
      obtain ⟨bound, a, ha, b, hb, zEq⟩ := product.membership.forward with zC2
      have p1 := firstProjection.pair at ℝ, ℝ, a, b with ha, hb
      have p2 := secondProjection.pair at ℝ, ℝ, a, b with ha, hb
      rw zEq at zS
      rw zEq at zT
      rw p1 at zS
      rw p2 at zT
      rw zEq
      exact product.pair with zS, zT
    . intro h
      obtain ⟨bound, a, ha, b, hb, zEq⟩ := product.membership.forward with h
      have aR := subS with a, ha
      have bR := subT with b, hb
      have p1 := firstProjection.pair at ℝ, ℝ, a, b with aR, bR
      have p2 := secondProjection.pair at ℝ, ℝ, a, b with aR, bR
      have zC : z ∈ complexCarrier
        unfold complexCarrier
        rw zEq
        exact product.pair with aR, bR
      constructor
      . apply functionPreimage.membership.backward
        refine ⟨zC, ?_⟩
        rw [zEq, p1]
        exact ha
      . apply functionPreimage.membership.backward
        refine ⟨zC, ?_⟩
        rw [zEq, p2]
        exact hb
  rw e at m
  exact m

theorem tkGAbs.lt_of_bounds (x h : Set)
  requires realX : x ∈ ℝ
  requires realH : h ∈ ℝ
  requires lower : R[-h] < x
  requires upper : (x:R) < h
  shows abs(x) < h
proof
  by_cases nn : (0:R) ≤ x
  . have v := abs.of_nonnegative at x with realX, nn
    rw v
    exact upper
  . have np : (x:R) ≤ (0:R) by linarith
    have v := abs.of_nonpositive at x with realX, np
    rw v
    linarith

theorem tkGComplex.dist_pair (a b c d : Real)
  shows normDistance(complexAdditiveGroup, complexAbs)((c, d), (a, b)) ≤ R[abs(c - a) + abs(d - b)]
proof
  have ng := complexAdditiveGroup.normed
  obtain ⟨carr, mul⟩ := complexAdditiveGroup.parts
  have zC := complexCarrier.pair at c, d
  have wC := complexCarrier.pair at a, b
  have zG : (c, d) ∈ Group.carrier(complexAdditiveGroup)
    rw carr
    exact zC
  have wG : (a, b) ∈ Group.carrier(complexAdditiveGroup)
    rw carr
    exact wC
  have e := normDistance.apply at complexAdditiveGroup, complexAbs, (c, d), (a, b) with ng, zG, wG
  have inv : Group.inv(complexAdditiveGroup) = complexNeg
    unfold complexAdditiveGroup
    group_projections
  rw [e, mul, inv, complexNeg.pair, complexAdd.pair]
  have nC := complexCarrier.pair at R[c + -a], R[d + -b]
  have le := complexAbs.le_abs_parts with nC
  unfold complexRe at le
  unfold complexIm at le
  rw [fst.pair, snd.pair] at le
  exact le

theorem tkGComplex.dist_pair_real (a b c d : Real)
  shows normDistance(complexAdditiveGroup, complexAbs)((c, d), (a, b)) ∈ ℝ
proof
  have ng := complexAdditiveGroup.normed
  obtain ⟨carr, mul⟩ := complexAdditiveGroup.parts
  have zC := complexCarrier.pair at c, d
  have wC := complexCarrier.pair at a, b
  have zG : (c, d) ∈ Group.carrier(complexAdditiveGroup)
    rw carr
    exact zC
  have wG : (a, b) ∈ Group.carrier(complexAdditiveGroup)
    rw carr
    exact wC
  have e := normDistance.apply at complexAdditiveGroup, complexAbs, (c, d), (a, b) with ng, zG, wG
  have inv : Group.inv(complexAdditiveGroup) = complexNeg
    unfold complexAdditiveGroup
    group_projections
  rw [e, mul, inv, complexNeg.pair, complexAdd.pair]
  have nC := complexCarrier.pair at R[c + -a], R[d + -b]
  typecheck

theorem tkGRational.interval_around (c h : Set)
  requires realC : c ∈ ℝ
  requires realH : h ∈ ℝ
  requires positive : (0:R) < h
  shows ∃ I ∈ rationalIntervals, c ∈ I ∧ (∀ a ∈ I, a ∈ ℝ ∧ R[-h] < R[c - a] ∧ R[c - a] < h)
proof
  have l1 : R[c - h] < (c:R) by linarith
  have l2 : (c:R) < R[c + h] by linarith
  obtain ⟨p, hp, p1, p2⟩ := rationalCut.between at R[c - h], c with l1
  obtain ⟨q, hq, q1, q2⟩ := rationalCut.between at c, R[c + h] with l2
  have pR := rationalCut.real at p with hp
  have qR := rationalCut.real at q with hq
  have pq : rationalCut(p) < rationalCut(q) by linarith
  have pq2 := realLess.characterization.forward with pq
  have pqQ := rationalCut.lt_of_cut_lt at p, q with pq2
  have mem := openInterval.member_intervals at p, q with pqQ
  refine ⟨openInterval(rationalCut(p), rationalCut(q)), mem, ?_, ?_⟩
  . exact openInterval.membership.backward with ⟨realC, p2, q1⟩
  . intros a ha
    obtain ⟨aR, a1, a2⟩ := openInterval.membership.forward with ha
    refine ⟨aR, ?_, ?_⟩
    . linarith
    . linarith

theorem tkGComplex.box_in_ball (z : Set, r : Real)
  requires member : z ∈ complexCarrier
  requires positive : (0:R) < r
  shows ∃ I ∈ rationalIntervals, ∃ J ∈ rationalIntervals, z ∈ I × J ∧
    I × J ⊆ ball(complexCarrier, normDistance(complexAdditiveGroup, complexAbs), z, r)
proof
  have rR : r ∈ ℝ by typecheck
  obtain ⟨c, cR, d, dR, zShape⟩ := complexCarrier.cases with member
  have cR2 : c ∈ ℝ by typecheck
  have dR2 : d ∈ ℝ by typecheck
  have hR := half.real at r
  have hR2 : half(r) ∈ ℝ by typecheck
  have hp := half.positive at r with positive
  have hs := half.add_self at r
  obtain ⟨I, hI, cI, nearI⟩ := tkGRational.interval_around at c, half(r) with cR2, hR2, hp
  obtain ⟨J, hJ, dJ, nearJ⟩ := tkGRational.interval_around at d, half(r) with dR2, hR2, hp
  refine ⟨I, hI, J, hJ, ?_, ?_⟩
  . rw zShape
    exact product.pair with cI, dJ
  . intros y hy
    obtain ⟨bound, a, ha, b, hb, yEq⟩ := product.membership.forward with hy
    obtain ⟨aR, a1, a2⟩ := nearI with a, ha
    obtain ⟨bR, b1, b2⟩ := nearJ with b, hb
    have aR2 : Real(a) by typecheck
    have bR2 : Real(b) by typecheck
    have dist := tkGComplex.dist_pair at a, b, c, d
    have caR : R[c - a] ∈ ℝ by typecheck
    have dbR : R[d - b] ∈ ℝ by typecheck
    have abs1 := tkGAbs.lt_of_bounds at R[c - a], half(r) with caR, hR2, a1, a2
    have abs2 := tkGAbs.lt_of_bounds at R[d - b], half(r) with dbR, hR2, b1, b2
    have ar1 := abs.real at R[c - a] with caR
    have ar2 := abs.real at R[d - b] with dbR
    have yC : y ∈ complexCarrier
      rw yEq
      exact complexCarrier.pair at a, b
    have dReal : normDistance(complexAdditiveGroup, complexAbs)((c, d), (a, b)) ∈ ℝ
      exact tkGComplex.dist_pair_real at a, b, c, d
    have lt : normDistance(complexAdditiveGroup, complexAbs)((c, d), (a, b)) < r by linarith
    apply ball.membership.backward
    refine ⟨yC, ?_⟩
    rw [zShape, yEq]
    exact lt

defgraph tkGBoxMap (p ∈ rationalIntervals × rationalIntervals) : 𝒫(ℝ × ℝ) := fst(p) × snd(p)
proof
  obtain ⟨bound, I, hI, J, hJ, pEq⟩ := product.membership.forward with member
  rw [pEq, fst.pair, snd.pair]
  have i2 := rationalIntervals.membership.forward with hI
  have j2 := rationalIntervals.membership.forward with hJ
  have iS := (powerset.membership_iff at I, ℝ).forward with i2.left
  have jS := (powerset.membership_iff at J, ℝ).forward with j2.left
  have sub := product.monotone with iS, jS
  exact (powerset.membership_iff at I × J, ℝ × ℝ).backward with sub

theorem tkGRealProduct.sets
  shows MeasurableSpace.sets(productMeasurableSpace(realMeasurableSpace, realMeasurableSpace)) = generatedSigma(ℝ × ℝ, rectangles(realMeasurableSpace, realMeasurableSpace))
proof
  unfold productMeasurableSpace
  unfold generatedSpace
  rw [MeasurableSpace.mk.sets, realMeasurableSpace.carrier]

theorem tkGRealProduct.space
  shows MeasurableSpace(productMeasurableSpace(realMeasurableSpace, realMeasurableSpace))
proof
  unfold productMeasurableSpace
  exact generatedSpace.space at MeasurableSpace.carrier(realMeasurableSpace) × MeasurableSpace.carrier(realMeasurableSpace), rectangles(realMeasurableSpace, realMeasurableSpace)

theorem tkGRealProduct.box (I J : Set)
  requires firstI : I ∈ rationalIntervals
  requires secondJ : J ∈ rationalIntervals
  shows MeasurableSet(productMeasurableSpace(realMeasurableSpace, realMeasurableSpace), I × J)
proof
  have t := realLine.space
  have openI := rationalIntervals.open with I, firstI
  have openJ := rationalIntervals.open with J, secondJ
  have oI : I ∈ TopologicalSpace.opens(realLine)
    rw realLine.opens
    exact openI
  have oJ : J ∈ TopologicalSpace.opens(realLine)
    rw realLine.opens
    exact openJ
  have mI := MeasurableSet.of_open with t, oI
  have mJ := MeasurableSet.of_open with t, oJ
  unfold MeasurableSet at mI
  unfold MeasurableSet at mJ
  have i2 := rationalIntervals.membership.forward with firstI
  have j2 := rationalIntervals.membership.forward with secondJ
  have iS := (powerset.membership_iff at I, ℝ).forward with i2.left
  have jS := (powerset.membership_iff at J, ℝ).forward with j2.left
  have sub := product.monotone with iS, jS
  have pw : I × J ∈ 𝒫(MeasurableSpace.carrier(realMeasurableSpace) × MeasurableSpace.carrier(realMeasurableSpace))
    rw realMeasurableSpace.carrier
    exact (powerset.membership_iff at I × J, ℝ × ℝ).backward with sub
  have rect : I × J ∈ rectangles(realMeasurableSpace, realMeasurableSpace)
    apply rectangles.membership.backward
    refine ⟨pw, I, ?_, J, ?_, rfl⟩
    . unfold realMeasurableSpace
      exact mI
    . unfold realMeasurableSpace
      exact mJ
  have g := generatedSigma.generator with rect, sub
  unfold MeasurableSet
  rw tkGRealProduct.sets
  exact g

def tkGBoxesBelow (U : Set) : Set :=
  { E ∈ valuesOn(tkGBoxMap, rationalIntervals × rationalIntervals) | E ⊆ U }

theorem tkGComplex.open_in_product (U : Set)
  requires open : U ∈ TopologicalSpace.opens(complexSpace)
  shows MeasurableSet(productMeasurableSpace(realMeasurableSpace, realMeasurableSpace), U)
proof
  have ng := complexAdditiveGroup.normed
  have oe := normTopology.opens_eq at complexAdditiveGroup, complexAbs with ng
  obtain ⟨carr, mul⟩ := complexAdditiveGroup.parts
  have op2 : U ∈ metricTopology(complexCarrier, normDistance(complexAdditiveGroup, complexAbs))
    unfold complexSpace at open
    rw [oe, carr] at open
    exact open
  have op3 := metricTopology.membership.forward with op2
  obtain ⟨pw, balls⟩ := op3
  have sp := tkGRealProduct.space
  have riC := rationalIntervals.countable
  have ppC := Countable.product with riC, riC
  have vC := valuesOn.countable at tkGBoxMap, rationalIntervals × rationalIntervals with ppC
  have sub : tkGBoxesBelow(U) ⊆ valuesOn(tkGBoxMap, rationalIntervals × rationalIntervals)
    intros E hE
    have hE2 := tkGBoxesBelow.membership.forward with hE
    exact hE2.left
  have fC := Countable.subset with vC, sub
  have all : ∀ E ∈ tkGBoxesBelow(U), MeasurableSet(productMeasurableSpace(realMeasurableSpace, realMeasurableSpace), E)
    intros E hE
    obtain ⟨hv, _⟩ := tkGBoxesBelow.membership.forward with hE
    obtain ⟨p, hp, eq⟩ := hv
    obtain ⟨bound, I, hI, J, hJ, pEq⟩ := product.membership.forward with hp
    have v := tkGBoxMap.value at p with hp
    rw [← eq, v, pEq, fst.pair, snd.pair]
    exact tkGRealProduct.box with hI, hJ
  have m := MeasurableSet.countable_union with sp, fC, all
  have e : ⋃(tkGBoxesBelow(U)) = U
    ext z
    constructor
    . intro h
      obtain ⟨E, hE, zE⟩ := union.membership.forward with h
      have hE2 := tkGBoxesBelow.membership.forward with hE
      exact hE2.right with z, zE
    . intro h
      have zC := (powerset.membership_iff at U, complexCarrier).forward with pw
      have zC2 := zC with z, h
      obtain ⟨r, rR, rpos, inside⟩ := balls with z, h
      have rR2 : Real(r) by typecheck
      obtain ⟨I, hI, J, hJ, zIJ, boxIn⟩ := tkGComplex.box_in_ball at z, r with zC2, rpos
      have pIn := product.pair with hI, hJ
      have v := tkGBoxMap.value at (I, J) with pIn
      rw [fst.pair, snd.pair] at v
      have inV : I × J ∈ valuesOn(tkGBoxMap, rationalIntervals × rationalIntervals)
        apply valuesOn.membership.backward
        exact ⟨(I, J), pIn, v⟩
      have boxU := Subset.transitive with boxIn, inside
      have inF : I × J ∈ tkGBoxesBelow(U)
        exact tkGBoxesBelow.membership.backward with ⟨inV, boxU⟩
      exact union.contains with inF, zIJ
  rw e at m
  exact m

-- ℂ = ℝ × ℝ as sets, and its Borel σ-algebra is the product σ-algebra
-- (Mathlib's Complex.measurableEquivRealProd).
theorem complexMeasurableSpace.eq_product
  shows complexMeasurableSpace =
    productMeasurableSpace(realMeasurableSpace, realMeasurableSpace)
proof
  have cc : complexCarrier = ℝ × ℝ
    unfold complexCarrier
    rfl
  have csets : MeasurableSpace.sets(complexMeasurableSpace) = generatedSigma(ℝ × ℝ, TopologicalSpace.opens(complexSpace))
    unfold complexMeasurableSpace
    unfold borelSpace
    rw MeasurableSpace.mk.sets
    unfold borelSigma
    rw [complexSpace.carrier, cc]
  have setsEq : generatedSigma(ℝ × ℝ, TopologicalSpace.opens(complexSpace)) = generatedSigma(ℝ × ℝ, rectangles(realMeasurableSpace, realMeasurableSpace))
    apply Subset.antisymmetric
    . have sig := generatedSigma.sigma at ℝ × ℝ, rectangles(realMeasurableSpace, realMeasurableSpace)
      apply generatedSigma.least with sig
      intros U hU
      simp at hU
      have m := tkGComplex.open_in_product with hU.left
      unfold MeasurableSet at m
      rw tkGRealProduct.sets at m
      exact m
    . have sig := generatedSigma.sigma at ℝ × ℝ, TopologicalSpace.opens(complexSpace)
      apply generatedSigma.least with sig
      intros E hE
      simp at hE
      obtain ⟨hr, _⟩ := hE
      have parts := rectangles.membership.forward with hr
      obtain ⟨_, S, hS, T, hT, eq⟩ := parts
      have mS : MeasurableSet(realMeasurableSpace, S)
        unfold MeasurableSet
        exact hS
      have mT : MeasurableSet(realMeasurableSpace, T)
        unfold MeasurableSet
        exact hT
      have m := tkGComplex.rectangle with mS, mT
      unfold MeasurableSet at m
      rw csets at m
      rw eq
      exact m
  unfold complexMeasurableSpace
  unfold borelSpace
  unfold borelSigma
  unfold productMeasurableSpace
  unfold generatedSpace
  rw [complexSpace.carrier, cc, setsEq, realMeasurableSpace.carrier]

-- A complex map is measurable exactly when its real and imaginary parts
-- are (Mathlib's Complex.measurable_re, measurable_im, measurable_ofReal).
theorem Measurable.complex_iff (f X : Set)
  requires space : MeasurableSpace(X)
  requires maps : MapsInto(f, MeasurableSpace.carrier(X), complexCarrier)
  shows Measurable(f, X, complexMeasurableSpace) ↔
    (Measurable(realPartOn(f, MeasurableSpace.carrier(X)), X, realMeasurableSpace) ∧
      Measurable(imagPartOn(f, MeasurableSpace.carrier(X)), X, realMeasurableSpace))
proof
  constructor
  . intro m
    have re : ∀ x ∈ MeasurableSpace.carrier(X), realPartOn(f, MeasurableSpace.carrier(X))(x) = firstProjection(ℝ, ℝ)(f(x))
      intros x xA
      have fx := maps with x, xA
      have a := realPartOn.apply at f, MeasurableSpace.carrier(X), x with xA
      have p := complexRe.projection with fx
      rw [a, p]
    have im : ∀ x ∈ MeasurableSpace.carrier(X), imagPartOn(f, MeasurableSpace.carrier(X))(x) = secondProjection(ℝ, ℝ)(f(x))
      intros x xA
      have fx := maps with x, xA
      have a := imagPartOn.apply at f, MeasurableSpace.carrier(X), x with xA
      have p := complexIm.projection with fx
      rw [a, p]
    constructor
    . exact Measurable.comp with m, tkGComplexFst.measurable, re
    . exact Measurable.comp with m, tkGComplexSnd.measurable, im
  . intro both
    obtain ⟨mre, mim⟩ := both
    have pairing : ∀ x ∈ MeasurableSpace.carrier(X), f(x) = (realPartOn(f, MeasurableSpace.carrier(X))(x), imagPartOn(f, MeasurableSpace.carrier(X))(x))
      intros x xA
      have fx := maps with x, xA
      have a := realPartOn.apply at f, MeasurableSpace.carrier(X), x with xA
      have b := imagPartOn.apply at f, MeasurableSpace.carrier(X), x with xA
      rw [a, b]
      obtain ⟨c, cR, d, dR, shape⟩ := complexCarrier.cases with fx
      unfold complexRe
      unfold complexIm
      rw [shape, fst.pair, snd.pair]
    have m := Measurable.pair with mre, mim, pairing
    rw complexMeasurableSpace.eq_product
    exact m

theorem tkGComplex.parts (f X : Set)
  requires measurable : Measurable(f, X, complexMeasurableSpace)
  shows Measurable(realPartOn(f, MeasurableSpace.carrier(X)), X, realMeasurableSpace) ∧
    Measurable(imagPartOn(f, MeasurableSpace.carrier(X)), X, realMeasurableSpace)
proof
  have mm := measurable
  obtain ⟨space, _⟩ := mm
  have maps : MapsInto(f, MeasurableSpace.carrier(X), complexCarrier)
    intros x xA
    have fx := Measurable.maps with measurable, xA
    rw complexMeasurableSpace.carrier at fx
    exact fx
  have iff := Measurable.complex_iff with space, maps
  exact iff.forward with measurable

theorem tkGComplex.of_parts (h X : Set)
  requires space : MeasurableSpace(X)
  requires maps : MapsInto(h, MeasurableSpace.carrier(X), complexCarrier)
  requires re : Measurable(realPartOn(h, MeasurableSpace.carrier(X)), X, realMeasurableSpace)
  requires im : Measurable(imagPartOn(h, MeasurableSpace.carrier(X)), X, realMeasurableSpace)
  shows Measurable(h, X, complexMeasurableSpace)
proof
  have iff := Measurable.complex_iff with space, maps
  exact iff.backward with ⟨re, im⟩

theorem Measurable.complex_of_real (f h X : Set)
  requires measurable : Measurable(f, X, realMeasurableSpace)
  requires cast : ∀ x ∈ MeasurableSpace.carrier(X), h(x) = complexOfReal(f(x))
  shows Measurable(h, X, complexMeasurableSpace)
proof
  have mm := measurable
  obtain ⟨space, _⟩ := mm
  have maps : MapsInto(h, MeasurableSpace.carrier(X), complexCarrier)
    intros x xA
    have fx := Measurable.maps with measurable, xA
    rw realMeasurableSpace.carrier at fx
    have e := cast with x, xA
    rw e
    typecheck
  have re : Measurable(realPartOn(h, MeasurableSpace.carrier(X)), X, realMeasurableSpace)
    apply Measurable.congr with measurable
    intros x xA
    have fx := Measurable.maps with measurable, xA
    rw realMeasurableSpace.carrier at fx
    have a := realPartOn.apply at h, MeasurableSpace.carrier(X), x with xA
    have e := cast with x, xA
    have r := complexOfReal.re at f(x)
    rw [a, e, r]
  have zc : realZero ∈ MeasurableSpace.carrier(realMeasurableSpace)
    rw realMeasurableSpace.carrier
    typecheck
  have im : Measurable(imagPartOn(h, MeasurableSpace.carrier(X)), X, realMeasurableSpace)
    apply Measurable.constant with space, realMeasurableSpace.space, zc
    intros x xA
    have fx := Measurable.maps with measurable, xA
    rw realMeasurableSpace.carrier at fx
    have a := imagPartOn.apply at h, MeasurableSpace.carrier(X), x with xA
    have e := cast with x, xA
    have r := complexOfReal.im at f(x)
    rw [a, e, r]
  exact tkGComplex.of_parts with space, maps, re, im

theorem Measurable.complex_add (f g h X : Set)
  requires measurableF : Measurable(f, X, complexMeasurableSpace)
  requires measurableG : Measurable(g, X, complexMeasurableSpace)
  requires sum : ∀ x ∈ MeasurableSpace.carrier(X), h(x) = ℂ[f(x) + g(x)]
  shows Measurable(h, X, complexMeasurableSpace)
proof
  have mm := measurableF
  obtain ⟨space, _⟩ := mm
  obtain ⟨rf, imf⟩ := tkGComplex.parts with measurableF
  obtain ⟨rg, img⟩ := tkGComplex.parts with measurableG
  have maps : MapsInto(h, MeasurableSpace.carrier(X), complexCarrier)
    intros x xA
    have fx := Measurable.maps with measurableF, xA
    have gx := Measurable.maps with measurableG, xA
    rw complexMeasurableSpace.carrier at fx
    rw complexMeasurableSpace.carrier at gx
    have e := sum with x, xA
    rw e
    typecheck
  have reEq : ∀ x ∈ MeasurableSpace.carrier(X), realPartOn(h, MeasurableSpace.carrier(X))(x) = R[realPartOn(f, MeasurableSpace.carrier(X))(x) + realPartOn(g, MeasurableSpace.carrier(X))(x)]
    intros x xA
    have fx := Measurable.maps with measurableF, xA
    have gx := Measurable.maps with measurableG, xA
    rw complexMeasurableSpace.carrier at fx
    rw complexMeasurableSpace.carrier at gx
    have a := realPartOn.apply at h, MeasurableSpace.carrier(X), x with xA
    have b := realPartOn.apply at f, MeasurableSpace.carrier(X), x with xA
    have c := realPartOn.apply at g, MeasurableSpace.carrier(X), x with xA
    have e := sum with x, xA
    have r := complexRe.add with fx, gx
    rw [a, b, c, e, r]
  have imEq : ∀ x ∈ MeasurableSpace.carrier(X), imagPartOn(h, MeasurableSpace.carrier(X))(x) = R[imagPartOn(f, MeasurableSpace.carrier(X))(x) + imagPartOn(g, MeasurableSpace.carrier(X))(x)]
    intros x xA
    have fx := Measurable.maps with measurableF, xA
    have gx := Measurable.maps with measurableG, xA
    rw complexMeasurableSpace.carrier at fx
    rw complexMeasurableSpace.carrier at gx
    have a := imagPartOn.apply at h, MeasurableSpace.carrier(X), x with xA
    have b := imagPartOn.apply at f, MeasurableSpace.carrier(X), x with xA
    have c := imagPartOn.apply at g, MeasurableSpace.carrier(X), x with xA
    have e := sum with x, xA
    have r := complexIm.add with fx, gx
    rw [a, b, c, e, r]
  have re := Measurable.real_add with rf, rg, reEq
  have im := Measurable.real_add with imf, img, imEq
  exact tkGComplex.of_parts with space, maps, re, im

theorem tkGMeasurable.real_sub (f g h X : Set)
  requires measurableF : Measurable(f, X, realMeasurableSpace)
  requires measurableG : Measurable(g, X, realMeasurableSpace)
  requires difference : ∀ x ∈ MeasurableSpace.carrier(X), h(x) = R[f(x) - g(x)]
  shows Measurable(h, X, realMeasurableSpace)
proof
  have negEq : ∀ x ∈ MeasurableSpace.carrier(X), composeOn(realNeg, g, MeasurableSpace.carrier(X))(x) = R[-g(x)]
    intros x xA
    have a := composeOn.apply at realNeg, g, MeasurableSpace.carrier(X), x with xA
    rw a
    rfl
  have n := Measurable.real_neg with measurableG, negEq
  have sumEq : ∀ x ∈ MeasurableSpace.carrier(X), h(x) = R[f(x) + composeOn(realNeg, g, MeasurableSpace.carrier(X))(x)]
    intros x xA
    have e := difference with x, xA
    have a := negEq with x, xA
    rw [e, a]
  exact Measurable.real_add with measurableF, n, sumEq

def tkGMulOn (f g A : Set) : Set := { (x, R[f(x) * g(x)]) | x ∈ A }

theorem tkGMulOn.apply (f g A x : Set)
  requires member : x ∈ A
  shows tkGMulOn(f, g, A)(x) = R[f(x) * g(x)]
proof
  have edge : (x, R[f(x) * g(x)]) ∈ tkGMulOn(f, g, A)
    apply tkGMulOn.membership.backward
    exact ⟨x, member, rfl⟩
  have pairs : ∀ p ∈ tkGMulOn(f, g, A), ∃ a, ∃ b, p = (a, b)
    intros p hp
    obtain ⟨k, hk, pEq⟩ := tkGMulOn.membership.forward with hp
    rw ← pEq
    exact ⟨k, R[f(k) * g(k)], rfl⟩
  have functional : ∀ a, ∀ b, ∀ c, (a, b) ∈ tkGMulOn(f, g, A) → (a, c) ∈ tkGMulOn(f, g, A) → b = c
    intros a b c hb hc
    obtain ⟨k, hk, bEq⟩ := tkGMulOn.membership.forward with hb
    obtain ⟨m, hm, cEq⟩ := tkGMulOn.membership.forward with hc
    obtain ⟨ka, bb⟩ := orderedPair.injective with bEq
    obtain ⟨ma, cc⟩ := orderedPair.injective with cEq
    rw [← bb, ← cc, ka, ← ma]
  exact pairGraph.apply with pairs, functional, edge

theorem Measurable.complex_mul (f g h X : Set)
  requires measurableF : Measurable(f, X, complexMeasurableSpace)
  requires measurableG : Measurable(g, X, complexMeasurableSpace)
  requires product : ∀ x ∈ MeasurableSpace.carrier(X), h(x) = ℂ[f(x) * g(x)]
  shows Measurable(h, X, complexMeasurableSpace)
proof
  have mm := measurableF
  obtain ⟨space, _⟩ := mm
  obtain ⟨rf, imf⟩ := tkGComplex.parts with measurableF
  obtain ⟨rg, img⟩ := tkGComplex.parts with measurableG
  have maps : MapsInto(h, MeasurableSpace.carrier(X), complexCarrier)
    intros x xA
    have fx := Measurable.maps with measurableF, xA
    have gx := Measurable.maps with measurableG, xA
    rw complexMeasurableSpace.carrier at fx
    rw complexMeasurableSpace.carrier at gx
    have e := product with x, xA
    rw e
    typecheck
  have m1 := Measurable.real_mul with rf, rg, (tkGMulOn.apply at realPartOn(f, MeasurableSpace.carrier(X)), realPartOn(g, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X))
  have m2 := Measurable.real_mul with imf, img, (tkGMulOn.apply at imagPartOn(f, MeasurableSpace.carrier(X)), imagPartOn(g, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X))
  have m3 := Measurable.real_mul with rf, img, (tkGMulOn.apply at realPartOn(f, MeasurableSpace.carrier(X)), imagPartOn(g, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X))
  have m4 := Measurable.real_mul with imf, rg, (tkGMulOn.apply at imagPartOn(f, MeasurableSpace.carrier(X)), realPartOn(g, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X))
  have reEq : ∀ x ∈ MeasurableSpace.carrier(X), realPartOn(h, MeasurableSpace.carrier(X))(x) = R[tkGMulOn(realPartOn(f, MeasurableSpace.carrier(X)), realPartOn(g, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X))(x) - tkGMulOn(imagPartOn(f, MeasurableSpace.carrier(X)), imagPartOn(g, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X))(x)]
    intros x xA
    have fx := Measurable.maps with measurableF, xA
    have gx := Measurable.maps with measurableG, xA
    rw complexMeasurableSpace.carrier at fx
    rw complexMeasurableSpace.carrier at gx
    have a := realPartOn.apply at h, MeasurableSpace.carrier(X), x with xA
    have b1 := realPartOn.apply at f, MeasurableSpace.carrier(X), x with xA
    have b2 := realPartOn.apply at g, MeasurableSpace.carrier(X), x with xA
    have b3 := imagPartOn.apply at f, MeasurableSpace.carrier(X), x with xA
    have b4 := imagPartOn.apply at g, MeasurableSpace.carrier(X), x with xA
    have c1 := tkGMulOn.apply at realPartOn(f, MeasurableSpace.carrier(X)), realPartOn(g, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X), x with xA
    have c2 := tkGMulOn.apply at imagPartOn(f, MeasurableSpace.carrier(X)), imagPartOn(g, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X), x with xA
    have e := product with x, xA
    have r := complexRe.mul with fx, gx
    rw [a, c1, c2, b1, b2, b3, b4, e, r]
  have imEq : ∀ x ∈ MeasurableSpace.carrier(X), imagPartOn(h, MeasurableSpace.carrier(X))(x) = R[tkGMulOn(realPartOn(f, MeasurableSpace.carrier(X)), imagPartOn(g, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X))(x) + tkGMulOn(imagPartOn(f, MeasurableSpace.carrier(X)), realPartOn(g, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X))(x)]
    intros x xA
    have fx := Measurable.maps with measurableF, xA
    have gx := Measurable.maps with measurableG, xA
    rw complexMeasurableSpace.carrier at fx
    rw complexMeasurableSpace.carrier at gx
    have a := imagPartOn.apply at h, MeasurableSpace.carrier(X), x with xA
    have b1 := realPartOn.apply at f, MeasurableSpace.carrier(X), x with xA
    have b2 := realPartOn.apply at g, MeasurableSpace.carrier(X), x with xA
    have b3 := imagPartOn.apply at f, MeasurableSpace.carrier(X), x with xA
    have b4 := imagPartOn.apply at g, MeasurableSpace.carrier(X), x with xA
    have c1 := tkGMulOn.apply at realPartOn(f, MeasurableSpace.carrier(X)), imagPartOn(g, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X), x with xA
    have c2 := tkGMulOn.apply at imagPartOn(f, MeasurableSpace.carrier(X)), realPartOn(g, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X), x with xA
    have e := product with x, xA
    have r := complexIm.mul with fx, gx
    rw [a, c1, c2, b1, b2, b3, b4, e, r]
  have re := tkGMeasurable.real_sub with m1, m2, reEq
  have im := Measurable.real_add with m3, m4, imEq
  exact tkGComplex.of_parts with space, maps, re, im

def tkGDiffOn (f g A : Set) : Set := { (x, R[f(x) - g(x)]) | x ∈ A }

theorem tkGDiffOn.apply (f g A x : Set)
  requires member : x ∈ A
  shows tkGDiffOn(f, g, A)(x) = R[f(x) - g(x)]
proof
  have edge : (x, R[f(x) - g(x)]) ∈ tkGDiffOn(f, g, A)
    apply tkGDiffOn.membership.backward
    exact ⟨x, member, rfl⟩
  have pairs : ∀ p ∈ tkGDiffOn(f, g, A), ∃ a, ∃ b, p = (a, b)
    intros p hp
    obtain ⟨k, hk, pEq⟩ := tkGDiffOn.membership.forward with hp
    rw ← pEq
    exact ⟨k, R[f(k) - g(k)], rfl⟩
  have functional : ∀ a, ∀ b, ∀ c, (a, b) ∈ tkGDiffOn(f, g, A) → (a, c) ∈ tkGDiffOn(f, g, A) → b = c
    intros a b c hb hc
    obtain ⟨k, hk, bEq⟩ := tkGDiffOn.membership.forward with hb
    obtain ⟨m, hm, cEq⟩ := tkGDiffOn.membership.forward with hc
    obtain ⟨ka, bb⟩ := orderedPair.injective with bEq
    obtain ⟨ma, cc⟩ := orderedPair.injective with cEq
    rw [← bb, ← cc, ka, ← ma]
  exact pairGraph.apply with pairs, functional, edge

theorem MeasurableSet.le_locus (X f g : Set)
  requires measurableF : Measurable(f, X, realMeasurableSpace)
  requires measurableG : Measurable(g, X, realMeasurableSpace)
  shows MeasurableSet(X, realLeLocus(f, g, MeasurableSpace.carrier(X)))
proof
  have mm := measurableF
  obtain ⟨space, _⟩ := mm
  have d := tkGMeasurable.real_sub with measurableF, measurableG, (tkGDiffOn.apply at f, g, MeasurableSpace.carrier(X))
  have l := MeasurableSet.real_le_locus at X, tkGDiffOn(f, g, MeasurableSpace.carrier(X)), realZero with d
  have e : realLeSet(tkGDiffOn(f, g, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X), realZero) = realLeLocus(f, g, MeasurableSpace.carrier(X))
    ext x
    constructor
    . intro h
      obtain ⟨xA, le⟩ := realLeSet.membership.forward with h
      have fx := Measurable.maps with measurableF, xA
      have gx := Measurable.maps with measurableG, xA
      rw realMeasurableSpace.carrier at fx
      rw realMeasurableSpace.carrier at gx
      have a := tkGDiffOn.apply at f, g, MeasurableSpace.carrier(X), x with xA
      rw a at le
      apply realLeLocus.membership.backward
      refine ⟨xA, ?_⟩
      linarith
    . intro h
      obtain ⟨xA, le⟩ := realLeLocus.membership.forward with h
      have fx := Measurable.maps with measurableF, xA
      have gx := Measurable.maps with measurableG, xA
      rw realMeasurableSpace.carrier at fx
      rw realMeasurableSpace.carrier at gx
      have a := tkGDiffOn.apply at f, g, MeasurableSpace.carrier(X), x with xA
      apply realLeSet.membership.backward
      refine ⟨xA, ?_⟩
      rw a
      linarith
  rw e at l
  exact l

-- Where two measurable real maps agree, and where one is below the other.
theorem MeasurableSet.equalizer (X f g : Set)
  requires measurableF : Measurable(f, X, realMeasurableSpace)
  requires measurableG : Measurable(g, X, realMeasurableSpace)
  shows MeasurableSet(X, equalizer(f, g, MeasurableSpace.carrier(X)))
proof
  have mm := measurableF
  obtain ⟨space, _⟩ := mm
  have l1 := MeasurableSet.le_locus with measurableF, measurableG
  have l2 := MeasurableSet.le_locus with measurableG, measurableF
  have m := MeasurableSet.inter with space, l1, l2
  have e : realLeLocus(f, g, MeasurableSpace.carrier(X)) ∩ realLeLocus(g, f, MeasurableSpace.carrier(X)) = equalizer(f, g, MeasurableSpace.carrier(X))
    ext x
    constructor
    . intro h
      obtain ⟨h1, h2⟩ := h
      obtain ⟨xA, le1⟩ := realLeLocus.membership.forward with h1
      obtain ⟨_, le2⟩ := realLeLocus.membership.forward with h2
      have fx := Measurable.maps with measurableF, xA
      have gx := Measurable.maps with measurableG, xA
      rw realMeasurableSpace.carrier at fx
      rw realMeasurableSpace.carrier at gx
      apply equalizer.membership.backward
      refine ⟨xA, ?_⟩
      linarith
    . intro h
      obtain ⟨xA, eq⟩ := equalizer.membership.forward with h
      have fx := Measurable.maps with measurableF, xA
      have gx := Measurable.maps with measurableG, xA
      rw realMeasurableSpace.carrier at fx
      rw realMeasurableSpace.carrier at gx
      constructor
      . apply realLeLocus.membership.backward
        refine ⟨xA, ?_⟩
        linarith
      . apply realLeLocus.membership.backward
        refine ⟨xA, ?_⟩
        linarith
  rw e at m
  exact m

theorem Measurable.complex_neg (f h X : Set)
  requires measurable : Measurable(f, X, complexMeasurableSpace)
  requires negation : ∀ x ∈ MeasurableSpace.carrier(X), h(x) = ℂ[-f(x)]
  shows Measurable(h, X, complexMeasurableSpace)
proof
  have mm := measurable
  obtain ⟨space, _⟩ := mm
  obtain ⟨rf, imf⟩ := tkGComplex.parts with measurable
  have maps : MapsInto(h, MeasurableSpace.carrier(X), complexCarrier)
    intros x xA
    have fx := Measurable.maps with measurable, xA
    rw complexMeasurableSpace.carrier at fx
    have e := negation with x, xA
    rw e
    typecheck
  have reEq : ∀ x ∈ MeasurableSpace.carrier(X), realPartOn(h, MeasurableSpace.carrier(X))(x) = R[-realPartOn(f, MeasurableSpace.carrier(X))(x)]
    intros x xA
    have fx := Measurable.maps with measurable, xA
    rw complexMeasurableSpace.carrier at fx
    have a := realPartOn.apply at h, MeasurableSpace.carrier(X), x with xA
    have b := realPartOn.apply at f, MeasurableSpace.carrier(X), x with xA
    have e := negation with x, xA
    obtain ⟨u, uR, v, vR, shape⟩ := complexCarrier.cases with fx
    rw [a, b, e, shape, complexNeg.pair]
    unfold complexRe
    rw [fst.pair, fst.pair]
  have imEq : ∀ x ∈ MeasurableSpace.carrier(X), imagPartOn(h, MeasurableSpace.carrier(X))(x) = R[-imagPartOn(f, MeasurableSpace.carrier(X))(x)]
    intros x xA
    have fx := Measurable.maps with measurable, xA
    rw complexMeasurableSpace.carrier at fx
    have a := imagPartOn.apply at h, MeasurableSpace.carrier(X), x with xA
    have b := imagPartOn.apply at f, MeasurableSpace.carrier(X), x with xA
    have e := negation with x, xA
    obtain ⟨u, uR, v, vR, shape⟩ := complexCarrier.cases with fx
    rw [a, b, e, shape, complexNeg.pair]
    unfold complexIm
    rw [snd.pair, snd.pair]
  have re := Measurable.real_neg with rf, reEq
  have im := Measurable.real_neg with imf, imEq
  exact tkGComplex.of_parts with space, maps, re, im

theorem Measurable.complex_conj (f h X : Set)
  requires measurable : Measurable(f, X, complexMeasurableSpace)
  requires conjugate : ∀ x ∈ MeasurableSpace.carrier(X), h(x) = complexConj(f(x))
  shows Measurable(h, X, complexMeasurableSpace)
proof
  have mm := measurable
  obtain ⟨space, _⟩ := mm
  obtain ⟨rf, imf⟩ := tkGComplex.parts with measurable
  have maps : MapsInto(h, MeasurableSpace.carrier(X), complexCarrier)
    intros x xA
    have fx := Measurable.maps with measurable, xA
    rw complexMeasurableSpace.carrier at fx
    have e := conjugate with x, xA
    rw e
    typecheck
  have re : Measurable(realPartOn(h, MeasurableSpace.carrier(X)), X, realMeasurableSpace)
    apply Measurable.congr with rf
    intros x xA
    have fx := Measurable.maps with measurable, xA
    rw complexMeasurableSpace.carrier at fx
    have a := realPartOn.apply at h, MeasurableSpace.carrier(X), x with xA
    have b := realPartOn.apply at f, MeasurableSpace.carrier(X), x with xA
    have e := conjugate with x, xA
    have r := complexConj.re with fx
    rw [a, b, e, r]
  have imEq : ∀ x ∈ MeasurableSpace.carrier(X), imagPartOn(h, MeasurableSpace.carrier(X))(x) = R[-imagPartOn(f, MeasurableSpace.carrier(X))(x)]
    intros x xA
    have fx := Measurable.maps with measurable, xA
    rw complexMeasurableSpace.carrier at fx
    have a := imagPartOn.apply at h, MeasurableSpace.carrier(X), x with xA
    have b := imagPartOn.apply at f, MeasurableSpace.carrier(X), x with xA
    have e := conjugate with x, xA
    have r := complexConj.im with fx
    rw [a, b, e, r]
  have im := Measurable.real_neg with imf, imEq
  exact tkGComplex.of_parts with space, maps, re, im

theorem Measurable.complex_abs (f h X : Set)
  requires measurable : Measurable(f, X, complexMeasurableSpace)
  requires absolute : ∀ x ∈ MeasurableSpace.carrier(X), h(x) = complexAbs(f(x))
  shows Measurable(h, X, realMeasurableSpace)
proof
  have ng := complexAdditiveGroup.normed
  have c := normTopology.norm_continuous at complexAdditiveGroup, complexAbs with ng
  have t1 := normTopology.space at complexAdditiveGroup, complexAbs with ng
  have m := Measurable.of_continuous with t1, realLine.space, c
  have m2 : Measurable(complexAbs, complexMeasurableSpace, realMeasurableSpace)
    unfold complexMeasurableSpace
    unfold complexSpace
    unfold realMeasurableSpace
    exact m
  exact Measurable.comp with measurable, m2, absolute

theorem Measurable.complex_exp (f h X : Set)
  requires measurable : Measurable(f, X, complexMeasurableSpace)
  requires exponential : ∀ x ∈ MeasurableSpace.carrier(X), h(x) = complexExp(f(x))
  shows Measurable(h, X, complexMeasurableSpace)
proof
  sorry

theorem Measurable.complex_limit (u f X : Set)
  requires measurable : ∀ n ∈ ℕ, Measurable(u(n), X, complexMeasurableSpace)
  requires maps : MapsInto(f, MeasurableSpace.carrier(X), complexCarrier)
  requires limit : ∀ x ∈ MeasurableSpace.carrier(X),
    Tendsto(familyAt(u, ℕ, x), ℕ, natAtTop, nhds(complexSpace, f(x)))
  shows Measurable(f, X, complexMeasurableSpace)
proof
  sorry

-- A finite sum of measurable complex maps (Finset.measurable_sum).
theorem Measurable.complex_finite_sum (X F u h : Set)
  requires finite : Finite(F)
  requires measurable : ∀ i ∈ F, Measurable(u(i), X, complexMeasurableSpace)
  requires sum : ∀ x ∈ MeasurableSpace.carrier(X),
    h(x) = groupFiniteSum(complexAdditiveGroup, F, familyAt(u, F, x))
  shows Measurable(h, X, complexMeasurableSpace)
proof
  sorry

-- Section: The Borel sets of ℝⁿ
theorem euclideanMeasurableSpace.space (n : Nat)
  shows MeasurableSpace(euclideanMeasurableSpace(n))
proof
  unfold euclideanMeasurableSpace
  unfold piMeasurableSpace
  exact generatedSpace.space at functionSpace(n, MeasurableSpace.carrier(realMeasurableSpace)), cylinders(n, realMeasurableSpace)

theorem euclideanMeasurableSpace.carrier (n : Nat)
  shows MeasurableSpace.carrier(euclideanMeasurableSpace(n)) = functionSpace(n, ℝ)
proof
  unfold euclideanMeasurableSpace
  unfold piMeasurableSpace
  unfold generatedSpace
  rw MeasurableSpace.mk.carrier
  rw realMeasurableSpace.carrier

-- ℝⁿ has countably many coordinates, so the product σ-algebra is the Borel
-- σ-algebra of the Euclidean topology (Mathlib's
-- MeasureTheory.measurableSpace_pi_eq_borel / BorelSpace on Fin n → ℝ).
theorem euclideanMeasurableSpace.borel (n : Nat)
  shows euclideanMeasurableSpace(n) = borelSpace(euclideanTopology(n))
proof
  sorry

-- The coordinates x ↦ x(i) are measurable (Mathlib's measurable_pi_apply).
theorem Measurable.coordinate (n : Nat, i : Set)
  requires member : i ∈ n
  shows Measurable(coordinateMap(functionSpace(n, ℝ), i),
    euclideanMeasurableSpace(n), realMeasurableSpace)
proof
  have sp := euclideanMeasurableSpace.space at n
  have rs := realMeasurableSpace.space
  unfold Measurable
  refine ⟨sp, rs, ?_, ?_⟩
  . intros x hx
    rw euclideanMeasurableSpace.carrier at hx
    rw realMeasurableSpace.carrier
    have a := coordinateMap.apply at functionSpace(n, ℝ), i, x with hx
    rw a
    have fx := functionSpace.membership.forward with hx
    exact FunctionBetween.apply_closed with fx.right, member
  . intros B hB
    rw euclideanMeasurableSpace.carrier
    have e : functionPreimage(coordinateMap(functionSpace(n, ℝ), i), functionSpace(n, ℝ), B) = cylinder(n, ℝ, i, B)
      ext x
      constructor
      . intro h
        obtain ⟨xF, xB⟩ := functionPreimage.membership.forward with h
        have a := coordinateMap.apply at functionSpace(n, ℝ), i, x with xF
        rw a at xB
        exact cylinder.membership.backward with ⟨xF, xB⟩
      . intro h
        obtain ⟨xF, xB⟩ := cylinder.membership.forward with h
        have a := coordinateMap.apply at functionSpace(n, ℝ), i, x with xF
        apply functionPreimage.membership.backward
        refine ⟨xF, ?_⟩
        rw a
        exact xB
    rw e
    have sub : cylinder(n, ℝ, i, B) ⊆ functionSpace(n, ℝ)
      intros x hx
      have hx2 := cylinder.membership.forward with hx
      exact hx2.left
    have pw : cylinder(n, ℝ, i, B) ∈ 𝒫(functionSpace(n, MeasurableSpace.carrier(realMeasurableSpace)))
      rw realMeasurableSpace.carrier
      exact (powerset.membership_iff at cylinder(n, ℝ, i, B), functionSpace(n, ℝ)).backward with sub
    have cyl : cylinder(n, ℝ, i, B) ∈ cylinders(n, realMeasurableSpace)
      apply cylinders.membership.backward
      refine ⟨pw, i, member, B, hB, ?_⟩
      rw realMeasurableSpace.carrier
    have sub2 : cylinder(n, ℝ, i, B) ⊆ functionSpace(n, MeasurableSpace.carrier(realMeasurableSpace))
      rw realMeasurableSpace.carrier
      exact sub
    have g := generatedSigma.generator with cyl, sub2
    unfold euclideanMeasurableSpace
    unfold piMeasurableSpace
    unfold generatedSpace
    rw MeasurableSpace.mk.sets
    exact g

defgraph tkGCylinderCompl (n S : Set) (i ∈ n) : 𝒫(functionSpace(n, ℝ)) :=
  functionSpace(n, ℝ) ∖ cylinder(n, ℝ, i, S(i))
proof
  apply powerset.membership_iff.backward
  intros x hx
  obtain ⟨h1, _⟩ := hx
  exact h1

-- Mathlib's MeasurableSet.univ_pi: a box product of Borel sets of ℝ.
theorem MeasurableSet.pi (n : Nat, S : Set)
  requires measurable : ∀ i ∈ n, MeasurableSet(realMeasurableSpace, S(i))
  shows MeasurableSet(euclideanMeasurableSpace(n), piSet(n, ℝ, S))
proof
  have sp := euclideanMeasurableSpace.space at n
  have fin := Finite.natural at n
  have cn := Countable.of_finite with fin
  have all : ∀ i ∈ n, MeasurableSet(euclideanMeasurableSpace(n), tkGCylinderCompl(n, S)(i))
    intros i hi
    have v := tkGCylinderCompl.value at n, S, i with hi
    rw v
    have c := Measurable.coordinate at n, i with hi
    have pre := Measurable.preimage with c, (measurable with i, hi)
    rw euclideanMeasurableSpace.carrier at pre
    have e : functionPreimage(coordinateMap(functionSpace(n, ℝ), i), functionSpace(n, ℝ), S(i)) = cylinder(n, ℝ, i, S(i))
      ext x
      constructor
      . intro h
        obtain ⟨xF, xB⟩ := functionPreimage.membership.forward with h
        have a := coordinateMap.apply at functionSpace(n, ℝ), i, x with xF
        rw a at xB
        exact cylinder.membership.backward with ⟨xF, xB⟩
      . intro h
        obtain ⟨xF, xB⟩ := cylinder.membership.forward with h
        have a := coordinateMap.apply at functionSpace(n, ℝ), i, x with xF
        apply functionPreimage.membership.backward
        refine ⟨xF, ?_⟩
        rw a
        exact xB
    rw e at pre
    have cc := MeasurableSet.compl with sp, pre
    rw euclideanMeasurableSpace.carrier at cc
    exact cc
  have u := MeasurableSet.indexed_union with sp, cn, all
  have c := MeasurableSet.compl with sp, u
  rw euclideanMeasurableSpace.carrier at c
  have e : functionSpace(n, ℝ) ∖ ⋃(valuesOn(tkGCylinderCompl(n, S), n)) = piSet(n, ℝ, S)
    ext x
    constructor
    . intro h
      obtain ⟨xF, notIn⟩ := h
      apply piSet.membership.backward
      refine ⟨xF, ?_⟩
      intros i hi
      by_contra nx
      have v := tkGCylinderCompl.value at n, S, i with hi
      have mem : x ∈ tkGCylinderCompl(n, S)(i)
        rw v
        constructor
        . exact xF
        . intro cyl
          obtain ⟨_, xi⟩ := cylinder.membership.forward with cyl
          exact nx with xi
      have inV : tkGCylinderCompl(n, S)(i) ∈ valuesOn(tkGCylinderCompl(n, S), n)
        exact valuesOn.membership.backward with ⟨i, hi, rfl⟩
      exact notIn with (union.contains with inV, mem)
    . intro h
      obtain ⟨xF, all2⟩ := piSet.membership.forward with h
      constructor
      . exact xF
      . intro hu
        obtain ⟨W, hW, xW⟩ := union.membership.forward with hu
        obtain ⟨i, hi, eq⟩ := hW
        have v := tkGCylinderCompl.value at n, S, i with hi
        rw [← eq, v] at xW
        obtain ⟨_, ncyl⟩ := xW
        apply ncyl
        exact cylinder.membership.backward with ⟨xF, (all2 with i, hi)⟩
  rw e at c
  exact c

-- Mathlib's measurableSet_ball: open and closed balls of ℝⁿ are Borel.
theorem MeasurableSet.euclidean_ball (n : Nat, c : Set, r : Real)
  requires center : c ∈ functionSpace(n, ℝ)
  shows MeasurableSet(euclideanMeasurableSpace(n), euclideanBall(n, c, r))
proof
  sorry

-- Section: The measurable structure of [0, ∞]
theorem ennMeasurableSpace.space
  shows MeasurableSpace(ennMeasurableSpace)
proof
  unfold ennMeasurableSpace
  exact generatedSpace.space at ennreal, ennRays

theorem ennMeasurableSpace.carrier
  shows MeasurableSpace.carrier(ennMeasurableSpace) = ennreal
proof
  unfold ennMeasurableSpace
  unfold generatedSpace
  rw MeasurableSpace.mk.carrier

-- A map into [0, ∞] is measurable when the sets {f > t} are.
theorem Measurable.enn_of_rays (f X : Set)
  requires space : MeasurableSpace(X)
  requires maps : MapsInto(f, MeasurableSpace.carrier(X), ennreal)
  requires rays : ∀ t ∈ ennreal, MeasurableSet(X, ennGtSet(f, MeasurableSpace.carrier(X), t))
  shows Measurable(f, X, ennMeasurableSpace)
proof
  have gens : ∀ S ∈ ennRays, S ⊆ ennreal → functionPreimage(f, MeasurableSpace.carrier(X), S) ∈ MeasurableSpace.sets(X)
    intros S hS sub
    simp at hS
    obtain ⟨SP, t, ht, eq⟩ := hS
    have same : functionPreimage(f, MeasurableSpace.carrier(X), S) = ennGtSet(f, MeasurableSpace.carrier(X), t)
      rw eq
      ext x
      constructor
      . intro h
        simp at h
        simp
      . intro h
        unfold ennGtSet at h
        simp at h
        have fx : f(x) ∈ ennreal
          unfold MapsInto at maps
          exact maps with x, h.left
        unfold functionPreimage
        unfold ennIoi
        simp
    rw same
    have r := rays with t, ht
    unfold MeasurableSet at r
    exact r
  have m := Measurable.of_generators at f, X, ennreal, ennRays with space, maps, gens
  unfold ennMeasurableSpace
  exact m

-- Section: Helpers for [0, ∞]
theorem union.of_unique (F v : Set)
  requires member : v ∈ F
  requires unique : ∀ w ∈ F, w = v
  shows ⋃(F) = v
proof
  have e : F = {v}
    ext w
    constructor
    . intro h
      have wv := unique with w, h
      simp
    . intro h
      simp at h
      rw h
      exact member
  rw e
  exact union.singleton at v

theorem ennreal.cases (a : Set)
  requires member : a ∈ ennreal
  shows a = ennTop ∨ (a ∈ ℝ ∧ realZero ≤ a)
proof
  unfold ennreal at member
  simp at member
  cases member with fin | top
  . right
    exact fin
  . left
    exact top

theorem ennreal.not_top_of_real (a : Set)
  requires real : a ∈ ℝ
  shows a ≠ ennTop
proof
  intro e
  have bad := ennTop.not_real
  rw ← e at bad
  exact bad with real

theorem ennreal.of_real (a : Set)
  requires real : a ∈ ℝ
  requires nonneg : realZero ≤ a
  shows a ∈ ennreal
proof
  unfold ennreal
  simp

theorem ennreal.finite (a : Set)
  requires member : a ∈ ennreal
  requires finite : a ≠ ennTop
  shows a ∈ ℝ ∧ realZero ≤ a
proof
  have c := ennreal.cases with member
  cases c with top | fin
  . exfalso
    exact finite with top
  . exact fin

theorem ennreal.top_member
  shows ennTop ∈ ennreal
proof
  unfold ennreal
  simp

theorem ennAdd.finite (a b : Set)
  requires realA : a ∈ ℝ
  requires realB : b ∈ ℝ
  requires nonnegA : realZero ≤ a
  requires nonnegB : realZero ≤ b
  shows ennAdd(a, b) = R[a + b]
proof
  have na := ennreal.not_top_of_real with realA
  have nb := ennreal.not_top_of_real with realB
  have sumR : R[a + b] ∈ ℝ by typecheck
  have sumNn : realZero ≤ R[a + b] by linarith
  have sm := ennreal.of_real with sumR, sumNn
  unfold ennAdd
  apply union.of_unique
  . apply ennAdd.family.membership.backward
    refine ⟨sm, ?_⟩
    left
    exact ⟨na, nb, rfl⟩
  . intros w hw
    obtain ⟨wIn, alt⟩ := ennAdd.family.membership.forward with hw
    cases alt with fin | top
    . exact fin.right.right
    . exfalso
      obtain ⟨t, rest⟩ := top
      cases t with t1 | t2
      . exact na with t1
      . exact nb with t2

theorem ennAdd.top_left (a b : Set)
  requires top : a = ennTop
  shows ennAdd(a, b) = ennTop
proof
  have tm := ennreal.top_member
  unfold ennAdd
  apply union.of_unique
  . apply ennAdd.family.membership.backward
    refine ⟨tm, ?_⟩
    right
    refine ⟨?_, rfl⟩
    left
    exact top
  . intros w hw
    obtain ⟨wIn, alt⟩ := ennAdd.family.membership.forward with hw
    cases alt with fin | t
    . exfalso
      exact fin.left with top
    . exact t.right

theorem ennAdd.top_right (a b : Set)
  requires top : b = ennTop
  shows ennAdd(a, b) = ennTop
proof
  have tm := ennreal.top_member
  unfold ennAdd
  apply union.of_unique
  . apply ennAdd.family.membership.backward
    refine ⟨tm, ?_⟩
    right
    refine ⟨?_, rfl⟩
    right
    exact top
  . intros w hw
    obtain ⟨wIn, alt⟩ := ennAdd.family.membership.forward with hw
    cases alt with fin | t
    . exfalso
      exact fin.right.left with top
    . exact t.right

theorem ennMul.finite (a b : Set)
  requires realA : a ∈ ℝ
  requires realB : b ∈ ℝ
  requires nonnegA : realZero ≤ a
  requires nonnegB : realZero ≤ b
  shows ennMul(a, b) = R[a * b]
proof
  have na := ennreal.not_top_of_real with realA
  have nb := ennreal.not_top_of_real with realB
  have pR : R[a * b] ∈ ℝ by typecheck
  have pNn := realMulValue.nonnegative at a, b with nonnegA, nonnegB
  have sm := ennreal.of_real with pR, pNn
  unfold ennMul
  apply union.of_unique
  . apply ennMul.family.membership.backward
    refine ⟨sm, ?_⟩
    left
    exact ⟨na, nb, rfl⟩
  . intros w hw
    obtain ⟨wIn, alt⟩ := ennMul.family.membership.forward with hw
    rcases alt with fin | zero | top
    . exact fin.right.right
    . obtain ⟨z, wz⟩ := zero
      rw wz
      cases z with za | zb
      . rw za
        ring
      . rw zb
        ring
    . exfalso
      obtain ⟨t, rest⟩ := top
      cases t with t1 | t2
      . exact na with t1
      . exact nb with t2

theorem ennMul.zero_left (a b : Set)
  requires zero : a = realZero
  requires member : b ∈ ennreal
  shows ennMul(a, b) = realZero
proof
  have zR : realZero ∈ ℝ by typecheck
  have zNn : realZero ≤ realZero by linarith
  have zm := ennreal.of_real with zR, zNn
  unfold ennMul
  apply union.of_unique
  . apply ennMul.family.membership.backward
    refine ⟨zm, ?_⟩
    right
    left
    refine ⟨?_, rfl⟩
    left
    exact zero
  . intros w hw
    obtain ⟨wIn, alt⟩ := ennMul.family.membership.forward with hw
    rcases alt with fin | z | top
    . obtain ⟨na, nb, wv⟩ := fin
      have bf := ennreal.finite with member, nb
      have bR := bf.left
      rw [wv, zero]
      ring
    . exact z.right
    . exfalso
      exact top.right.left with zero

theorem ennMul.zero_right (a b : Set)
  requires member : a ∈ ennreal
  requires zero : b = realZero
  shows ennMul(a, b) = realZero
proof
  have zR : realZero ∈ ℝ by typecheck
  have zNn : realZero ≤ realZero by linarith
  have zm := ennreal.of_real with zR, zNn
  unfold ennMul
  apply union.of_unique
  . apply ennMul.family.membership.backward
    refine ⟨zm, ?_⟩
    right
    left
    refine ⟨?_, rfl⟩
    right
    exact zero
  . intros w hw
    obtain ⟨wIn, alt⟩ := ennMul.family.membership.forward with hw
    rcases alt with fin | z | top
    . obtain ⟨na, nb, wv⟩ := fin
      have af := ennreal.finite with member, na
      have aR := af.left
      rw [wv, zero]
      ring
    . exact z.right
    . exfalso
      exact top.right.right.left with zero

theorem ennMul.top_left (a b : Set)
  requires top : a = ennTop
  requires nonzero : b ≠ realZero
  shows ennMul(a, b) = ennTop
proof
  have tm := ennreal.top_member
  have aNz : a ≠ realZero
    intro e
    have zR : realZero ∈ ℝ by typecheck
    have bad := ennreal.not_top_of_real with zR
    rw [← e, top] at bad
    exact bad with rfl
  unfold ennMul
  apply union.of_unique
  . apply ennMul.family.membership.backward
    refine ⟨tm, ?_⟩
    right
    right
    refine ⟨?_, aNz, nonzero, rfl⟩
    left
    exact top
  . intros w hw
    obtain ⟨wIn, alt⟩ := ennMul.family.membership.forward with hw
    rcases alt with fin | z | t
    . exfalso
      exact fin.left with top
    . exfalso
      obtain ⟨zz, rest⟩ := z
      cases zz with za | zb
      . exact aNz with za
      . exact nonzero with zb
    . exact t.right.right.right

theorem ennMul.top_right (a b : Set)
  requires nonzero : a ≠ realZero
  requires top : b = ennTop
  shows ennMul(a, b) = ennTop
proof
  have tm := ennreal.top_member
  have bNz : b ≠ realZero
    intro e
    have zR : realZero ∈ ℝ by typecheck
    have bad := ennreal.not_top_of_real with zR
    rw [← e, top] at bad
    exact bad with rfl
  unfold ennMul
  apply union.of_unique
  . apply ennMul.family.membership.backward
    refine ⟨tm, ?_⟩
    right
    right
    refine ⟨?_, nonzero, bNz, rfl⟩
    right
    exact top
  . intros w hw
    obtain ⟨wIn, alt⟩ := ennMul.family.membership.forward with hw
    rcases alt with fin | z | t
    . exfalso
      exact fin.right.left with top
    . exfalso
      obtain ⟨zz, rest⟩ := z
      cases zz with za | zb
      . exact nonzero with za
      . exact bNz with zb
    . exact t.right.right.right

theorem ennOfReal.value_nonneg (X : Set)
  requires real : X ∈ ℝ
  requires nonneg : realZero ≤ X
  shows ennOfReal(X) = X
proof
  have m := ennreal.of_real with real, nonneg
  unfold ennOfReal
  apply union.of_unique
  . apply ennOfReal.family.membership.backward
    refine ⟨m, ?_⟩
    left
    exact ⟨nonneg, rfl⟩
  . intros w hw
    obtain ⟨wIn, alt⟩ := ennOfReal.family.membership.forward with hw
    cases alt with p | n
    . exact p.right
    . exfalso
      obtain ⟨neg, rest⟩ := n
      linarith

theorem ennOfReal.value_neg (X : Set)
  requires real : X ∈ ℝ
  requires negative : X < realZero
  shows ennOfReal(X) = realZero
proof
  have zR : realZero ∈ ℝ by typecheck
  have zNn : realZero ≤ realZero by linarith
  have m := ennreal.of_real with zR, zNn
  unfold ennOfReal
  apply union.of_unique
  . apply ennOfReal.family.membership.backward
    refine ⟨m, ?_⟩
    right
    exact ⟨negative, rfl⟩
  . intros w hw
    obtain ⟨wIn, alt⟩ := ennOfReal.family.membership.forward with hw
    cases alt with p | n
    . exfalso
      obtain ⟨nn, rest⟩ := p
      linarith
    . exact n.right

theorem ennreal.zero_member
  shows realZero ∈ ennreal
proof
  have zR : realZero ∈ ℝ by typecheck
  have zNn : realZero ≤ realZero by linarith
  exact ennreal.of_real with zR, zNn

theorem ennreal.zero_not_top
  shows realZero ≠ ennTop
proof
  have zR : realZero ∈ ℝ by typecheck
  exact ennreal.not_top_of_real with zR

theorem ennreal.top_ne_zero
  shows ennTop ≠ realZero
proof
  intro e
  have z := ennreal.zero_not_top
  symm at e
  exact z with e

theorem real.pos_of_nonzero (a : Set)
  requires real : a ∈ ℝ
  requires nonneg : realZero ≤ a
  requires nonzero : a ≠ realZero
  shows realZero < a
proof
  by_contra np
  have le : a ≤ realZero by linarith
  have e := realLe.antisymmetric at a, realZero with le, nonneg
  exact nonzero with e

theorem ennMul.nonzero (a b : Set)
  requires memberA : a ∈ ennreal
  requires memberB : b ∈ ennreal
  requires nonzeroA : a ≠ realZero
  requires nonzeroB : b ≠ realZero
  shows ennMul(a, b) ≠ realZero
proof
  have tz := ennreal.top_ne_zero
  have ca := ennreal.cases with memberA
  have cb := ennreal.cases with memberB
  cases ca with aT | afin
  . rw ennMul.top_left with aT, nonzeroB
    exact tz
  . cases cb with bT | bfin
    . rw ennMul.top_right with nonzeroA, bT
      exact tz
    . obtain ⟨aR, aNn⟩ := afin
      obtain ⟨bR, bNn⟩ := bfin
      rw ennMul.finite with aR, bR, aNn, bNn
      have ap := real.pos_of_nonzero with aR, aNn, nonzeroA
      have bp := real.pos_of_nonzero with bR, bNn, nonzeroB
      have p := realMulValue.positive at a, b with ap, bp
      intro e
      rw e at p
      linarith

theorem EnnLe.nonzero (a b : Set)
  requires le : EnnLe(a, b)
  requires nonzero : a ≠ realZero
  shows b ≠ realZero
proof
  obtain ⟨aM, bM, ab⟩ := le
  intro bZ
  cases ab with bT | afin
  . have tz := ennreal.top_ne_zero
    rw ← bT at tz
    exact tz with bZ
  . obtain ⟨na, ale⟩ := afin
    obtain ⟨aR, aNn⟩ := ennreal.finite with aM, na
    rw bZ at ale
    have e := realLe.antisymmetric at a, realZero with ale, aNn
    exact nonzero with e

-- Section: Arithmetic of [0, ∞]
theorem ennreal.real_member (X : Real)
  requires nonneg : realZero ≤ X
  shows X ∈ ennreal
proof
  have xR : X ∈ ℝ by typecheck
  exact ennreal.of_real with xR, nonneg

theorem ennTop.member
  shows ennTop ∈ ennreal
proof
  exact ennreal.top_member

theorem EnnLe.reflexive (a : Set)
  requires member : a ∈ ennreal
  shows EnnLe(a, a)
proof
  have c := ennreal.cases with member
  unfold EnnLe
  refine ⟨member, member, ?_⟩
  cases c with top | fin
  . left
    exact top
  . right
    obtain ⟨aR, aNn⟩ := fin
    have na := ennreal.not_top_of_real with aR
    refine ⟨na, ?_⟩
    linarith

theorem EnnLe.transitive (a b c : Set)
  requires first : EnnLe(a, b)
  requires second : EnnLe(b, c)
  shows EnnLe(a, c)
proof
  obtain ⟨aM, bM, ab⟩ := first
  obtain ⟨bM2, cM, bc⟩ := second
  unfold EnnLe
  refine ⟨aM, cM, ?_⟩
  by_cases ct : c = ennTop
  . left
    exact ct
  . cases bc with ct2 | bfin
    . exfalso
      exact ct with ct2
    . obtain ⟨nb, ble⟩ := bfin
      cases ab with bt | afin
      . exfalso
        exact nb with bt
      . obtain ⟨na, ale⟩ := afin
        right
        have af := ennreal.finite with aM, na
        have bf := ennreal.finite with bM, nb
        have cf := ennreal.finite with cM, ct
        have aR := af.left
        have bR := bf.left
        have cR := cf.left
        refine ⟨na, ?_⟩
        linarith

theorem EnnLe.antisymmetric (a b : Set)
  requires first : EnnLe(a, b)
  requires second : EnnLe(b, a)
  shows a = b
proof
  obtain ⟨aM, bM, ab⟩ := first
  obtain ⟨bM2, aM2, ba⟩ := second
  cases ab with bt | afin
  . cases ba with at | bfin
    . rw [at, bt]
    . exfalso
      exact bfin.left with bt
  . cases ba with at | bfin
    . exfalso
      exact afin.left with at
    . obtain ⟨na, ale⟩ := afin
      obtain ⟨nb, ble⟩ := bfin
      have af := ennreal.finite with aM, na
      have bf := ennreal.finite with bM, nb
      have aR := af.left
      have bR := bf.left
      exact realLe.antisymmetric at a, b with ale, ble

theorem EnnLe.total (a b : Set)
  requires memberA : a ∈ ennreal
  requires memberB : b ∈ ennreal
  shows EnnLe(a, b) ∨ EnnLe(b, a)
proof
  have ca := ennreal.cases with memberA
  have cb := ennreal.cases with memberB
  cases cb with bt | bfin
  . left
    unfold EnnLe
    refine ⟨memberA, memberB, ?_⟩
    left
    exact bt
  . cases ca with at | afin
    . right
      unfold EnnLe
      refine ⟨memberB, memberA, ?_⟩
      left
      exact at
    . obtain ⟨aR, aNn⟩ := afin
      obtain ⟨bR, bNn⟩ := bfin
      have na := ennreal.not_top_of_real with aR
      have nb := ennreal.not_top_of_real with bR
      by_cases le : a ≤ b
      . left
        unfold EnnLe
        refine ⟨memberA, memberB, ?_⟩
        right
        exact ⟨na, le⟩
      . right
        unfold EnnLe
        refine ⟨memberB, memberA, ?_⟩
        right
        refine ⟨nb, ?_⟩
        linarith

theorem EnnLe.zero (a : Set)
  requires member : a ∈ ennreal
  shows EnnLe(realZero, a)
proof
  have zm := ennreal.zero_member
  have zn := ennreal.zero_not_top
  have c := ennreal.cases with member
  unfold EnnLe
  refine ⟨zm, member, ?_⟩
  cases c with top | fin
  . left
    exact top
  . right
    obtain ⟨aR, aNn⟩ := fin
    exact ⟨zn, aNn⟩

theorem EnnLe.top (a : Set)
  requires member : a ∈ ennreal
  shows EnnLe(a, ennTop)
proof
  have tm := ennreal.top_member
  unfold EnnLe
  refine ⟨member, tm, ?_⟩
  left
  rfl

theorem ennOfReal.member (X : Real)
  shows ennOfReal(X) ∈ ennreal ∧ ennOfReal(X) ≠ ennTop
proof
  have xR : X ∈ ℝ by typecheck
  have zR : realZero ∈ ℝ by typecheck
  by_cases nn : realZero ≤ X
  . have e := ennOfReal.value_nonneg with xR, nn
    rw e
    have m := ennreal.of_real with xR, nn
    have n := ennreal.not_top_of_real with xR
    exact ⟨m, n⟩
  . have neg : X < realZero by linarith
    have e := ennOfReal.value_neg with xR, neg
    rw e
    have m := ennreal.zero_member
    have n := ennreal.zero_not_top
    exact ⟨m, n⟩

theorem ennOfReal.of_nonneg (X : Real)
  requires nonneg : realZero ≤ X
  shows ennOfReal(X) = X
proof
  have xR : X ∈ ℝ by typecheck
  exact ennOfReal.value_nonneg with xR, nonneg

theorem ennToReal.of_finite (a : Set)
  requires member : a ∈ ennreal
  requires finite : a ≠ ennTop
  shows ennToReal(a) = a ∧ realZero ≤ ennToReal(a)
proof
  have af := ennreal.finite with member, finite
  obtain ⟨aR, aNn⟩ := af
  have e : ennToReal(a) = a
    unfold ennToReal
    apply union.of_unique
    . apply ennToReal.family.membership.backward
      refine ⟨aR, ?_⟩
      left
      exact ⟨finite, rfl⟩
    . intros w hw
      obtain ⟨wIn, alt⟩ := ennToReal.family.membership.forward with hw
      cases alt with p | n
      . exact p.right
      . exfalso
        exact finite with n.left
  rw e
  exact ⟨rfl, aNn⟩

theorem ennAdd.member (a b : Set)
  requires memberA : a ∈ ennreal
  requires memberB : b ∈ ennreal
  shows ennAdd(a, b) ∈ ennreal
proof
  have ca := ennreal.cases with memberA
  have cb := ennreal.cases with memberB
  cases ca with aT | afin
  . rw ennAdd.top_left with aT
    exact ennreal.top_member
  . cases cb with bT | bfin
    . rw ennAdd.top_right with bT
      exact ennreal.top_member
    . obtain ⟨aR, aNn⟩ := afin
      obtain ⟨bR, bNn⟩ := bfin
      rw ennAdd.finite with aR, bR, aNn, bNn
      have sR : R[a + b] ∈ ℝ by typecheck
      have sNn : realZero ≤ R[a + b] by linarith
      exact ennreal.of_real with sR, sNn

theorem ennAdd.comm (a b : Set)
  requires memberA : a ∈ ennreal
  requires memberB : b ∈ ennreal
  shows ennAdd(a, b) = ennAdd(b, a)
proof
  have ca := ennreal.cases with memberA
  have cb := ennreal.cases with memberB
  cases ca with aT | afin
  . rw ennAdd.top_left with aT
    rw ennAdd.top_right with aT
  . cases cb with bT | bfin
    . rw ennAdd.top_right with bT
      rw ennAdd.top_left with bT
    . obtain ⟨aR, aNn⟩ := afin
      obtain ⟨bR, bNn⟩ := bfin
      rw ennAdd.finite with aR, bR, aNn, bNn
      rw ennAdd.finite with bR, aR, bNn, aNn
      ring

theorem ennAdd.assoc (a b c : Set)
  requires memberA : a ∈ ennreal
  requires memberB : b ∈ ennreal
  requires memberC : c ∈ ennreal
  shows ennAdd(ennAdd(a, b), c) = ennAdd(a, ennAdd(b, c))
proof
  have ca := ennreal.cases with memberA
  have cb := ennreal.cases with memberB
  have cc := ennreal.cases with memberC
  cases ca with aT | afin
  . have l := ennAdd.top_left at a, b with aT
    rw l
    rw ennAdd.top_left at ennTop, c with rfl
    rw ennAdd.top_left at a, ennAdd(b, c) with aT
  . cases cb with bT | bfin
    . have l := ennAdd.top_right at a, b with bT
      have r := ennAdd.top_left at b, c with bT
      rw l
      rw ennAdd.top_left at ennTop, c with rfl
      rw r
      rw ennAdd.top_right at a, ennTop with rfl
    . cases cc with cT | cfin
      . rw ennAdd.top_right at ennAdd(a, b), c with cT
        rw ennAdd.top_right at b, c with cT
        rw ennAdd.top_right at a, ennTop with rfl
      . obtain ⟨aR, aNn⟩ := afin
        obtain ⟨bR, bNn⟩ := bfin
        obtain ⟨cR, cNn⟩ := cfin
        have abR : R[a + b] ∈ ℝ by typecheck
        have abNn : realZero ≤ R[a + b] by linarith
        have bcR : R[b + c] ∈ ℝ by typecheck
        have bcNn : realZero ≤ R[b + c] by linarith
        rw ennAdd.finite with aR, bR, aNn, bNn
        rw ennAdd.finite with bR, cR, bNn, cNn
        rw ennAdd.finite with abR, cR, abNn, cNn
        rw ennAdd.finite with aR, bcR, aNn, bcNn
        ring

theorem ennAdd.zero (a : Set)
  requires member : a ∈ ennreal
  shows ennAdd(a, realZero) = a
proof
  have ca := ennreal.cases with member
  cases ca with aT | afin
  . rw ennAdd.top_left with aT
    rw aT
  . obtain ⟨aR, aNn⟩ := afin
    have zR : realZero ∈ ℝ by typecheck
    have zNn : realZero ≤ realZero by linarith
    rw ennAdd.finite with aR, zR, aNn, zNn
    ring

theorem ennAdd.mono (a b c d : Set)
  requires first : EnnLe(a, b)
  requires second : EnnLe(c, d)
  shows EnnLe(ennAdd(a, c), ennAdd(b, d))
proof
  obtain ⟨aM, bM, ab⟩ := first
  obtain ⟨cM, dM, cd⟩ := second
  have acM := ennAdd.member with aM, cM
  by_cases bT : b = ennTop
  . rw ennAdd.top_left at b, d with bT
    exact EnnLe.top with acM
  . by_cases dT : d = ennTop
    . rw ennAdd.top_right at b, d with dT
      exact EnnLe.top with acM
    . cases ab with bT2 | afin
      . exfalso
        exact bT with bT2
      . cases cd with dT2 | cfin
        . exfalso
          exact dT with dT2
        . obtain ⟨na, ale⟩ := afin
          obtain ⟨nc, cle⟩ := cfin
          obtain ⟨aR, aNn⟩ := ennreal.finite with aM, na
          obtain ⟨bR, bNn⟩ := ennreal.finite with bM, bT
          obtain ⟨cR, cNn⟩ := ennreal.finite with cM, nc
          obtain ⟨dR, dNn⟩ := ennreal.finite with dM, dT
          have bdM := ennAdd.member with bM, dM
          rw ennAdd.finite with aR, cR, aNn, cNn
          rw ennAdd.finite with bR, dR, bNn, dNn
          rw ennAdd.finite with aR, cR, aNn, cNn at acM
          rw ennAdd.finite with bR, dR, bNn, dNn at bdM
          have acR : R[a + c] ∈ ℝ by typecheck
          have n1 := ennreal.not_top_of_real with acR
          unfold EnnLe
          refine ⟨acM, bdM, ?_⟩
          right
          refine ⟨n1, ?_⟩
          linarith

theorem ennMul.member (a b : Set)
  requires memberA : a ∈ ennreal
  requires memberB : b ∈ ennreal
  shows ennMul(a, b) ∈ ennreal
proof
  have zm := ennreal.zero_member
  have tm := ennreal.top_member
  by_cases aZ : a = realZero
  . rw ennMul.zero_left with aZ, memberB
    exact zm
  . by_cases bZ : b = realZero
    . rw ennMul.zero_right with memberA, bZ
      exact zm
    . have ca := ennreal.cases with memberA
      have cb := ennreal.cases with memberB
      cases ca with aT | afin
      . rw ennMul.top_left with aT, bZ
        exact tm
      . cases cb with bT | bfin
        . rw ennMul.top_right with aZ, bT
          exact tm
        . obtain ⟨aR, aNn⟩ := afin
          obtain ⟨bR, bNn⟩ := bfin
          rw ennMul.finite with aR, bR, aNn, bNn
          have pR : R[a * b] ∈ ℝ by typecheck
          have pNn := realMulValue.nonnegative at a, b with aNn, bNn
          exact ennreal.of_real with pR, pNn

theorem ennMul.comm (a b : Set)
  requires memberA : a ∈ ennreal
  requires memberB : b ∈ ennreal
  shows ennMul(a, b) = ennMul(b, a)
proof
  by_cases aZ : a = realZero
  . rw ennMul.zero_left with aZ, memberB
    rw ennMul.zero_right with memberB, aZ
  . by_cases bZ : b = realZero
    . rw ennMul.zero_right with memberA, bZ
      rw ennMul.zero_left with bZ, memberA
    . have ca := ennreal.cases with memberA
      have cb := ennreal.cases with memberB
      cases ca with aT | afin
      . rw ennMul.top_left with aT, bZ
        rw ennMul.top_right with bZ, aT
      . cases cb with bT | bfin
        . rw ennMul.top_right with aZ, bT
          rw ennMul.top_left with bT, aZ
        . obtain ⟨aR, aNn⟩ := afin
          obtain ⟨bR, bNn⟩ := bfin
          rw ennMul.finite with aR, bR, aNn, bNn
          rw ennMul.finite with bR, aR, bNn, aNn
          ring

theorem ennMul.assoc (a b c : Set)
  requires memberA : a ∈ ennreal
  requires memberB : b ∈ ennreal
  requires memberC : c ∈ ennreal
  shows ennMul(ennMul(a, b), c) = ennMul(a, ennMul(b, c))
proof
  have zm := ennreal.zero_member
  have abM := ennMul.member with memberA, memberB
  have bcM := ennMul.member with memberB, memberC
  by_cases aZ : a = realZero
  . rw ennMul.zero_left at a, b with aZ, memberB
    rw ennMul.zero_left at realZero, c with rfl, memberC
    rw ennMul.zero_left at a, ennMul(b, c) with aZ, bcM
  . by_cases bZ : b = realZero
    . rw ennMul.zero_right at a, b with memberA, bZ
      rw ennMul.zero_left at realZero, c with rfl, memberC
      rw ennMul.zero_left at b, c with bZ, memberC
      rw ennMul.zero_right at a, realZero with memberA, rfl
    . by_cases cZ : c = realZero
      . rw ennMul.zero_right at ennMul(a, b), c with abM, cZ
        rw ennMul.zero_right at b, c with memberB, cZ
        rw ennMul.zero_right at a, realZero with memberA, rfl
      . have abZ := ennMul.nonzero with memberA, memberB, aZ, bZ
        have bcZ := ennMul.nonzero with memberB, memberC, bZ, cZ
        have ca := ennreal.cases with memberA
        have cb := ennreal.cases with memberB
        have cc := ennreal.cases with memberC
        cases ca with aT | afin
        . rw ennMul.top_left at a, b with aT, bZ
          rw ennMul.top_left at ennTop, c with rfl, cZ
          rw ennMul.top_left at a, ennMul(b, c) with aT, bcZ
        . cases cb with bT | bfin
          . rw ennMul.top_right at a, b with aZ, bT
            rw ennMul.top_left at ennTop, c with rfl, cZ
            rw ennMul.top_left at b, c with bT, cZ
            rw ennMul.top_right at a, ennTop with aZ, rfl
          . cases cc with cT | cfin
            . rw ennMul.top_right at ennMul(a, b), c with abZ, cT
              rw ennMul.top_right at b, c with bZ, cT
              rw ennMul.top_right at a, ennTop with aZ, rfl
            . obtain ⟨aR, aNn⟩ := afin
              obtain ⟨bR, bNn⟩ := bfin
              obtain ⟨cR, cNn⟩ := cfin
              have abR : R[a * b] ∈ ℝ by typecheck
              have abNn := realMulValue.nonnegative at a, b with aNn, bNn
              have bcR : R[b * c] ∈ ℝ by typecheck
              have bcNn := realMulValue.nonnegative at b, c with bNn, cNn
              rw ennMul.finite with aR, bR, aNn, bNn
              rw ennMul.finite with bR, cR, bNn, cNn
              rw ennMul.finite with abR, cR, abNn, cNn
              rw ennMul.finite with aR, bcR, aNn, bcNn
              ring

theorem ennMul.one (a : Set)
  requires member : a ∈ ennreal
  shows ennMul(realOne, a) = a
proof
  have oR : realOne ∈ ℝ by typecheck
  have oNn : realZero ≤ realOne by linarith
  have oZ : realOne ≠ realZero
    intro e
    have p : realZero < realOne by linarith
    rw e at p
    linarith
  have ca := ennreal.cases with member
  cases ca with aT | afin
  . rw ennMul.top_right with oZ, aT
    rw aT
  . obtain ⟨aR, aNn⟩ := afin
    rw ennMul.finite with oR, aR, oNn, aNn
    ring

theorem ennMul.zero (a : Set)
  requires member : a ∈ ennreal
  shows ennMul(realZero, a) = realZero
proof
  exact ennMul.zero_left with rfl, member

theorem ennMul.add_right (a b c : Set)
  requires memberA : a ∈ ennreal
  requires memberB : b ∈ ennreal
  requires memberC : c ∈ ennreal
  shows ennMul(a, ennAdd(b, c)) = ennAdd(ennMul(a, b), ennMul(a, c))
proof
  have zm := ennreal.zero_member
  have tm := ennreal.top_member
  have tz := ennreal.top_ne_zero
  have bcM := ennAdd.member with memberB, memberC
  have abM := ennMul.member with memberA, memberB
  have acM := ennMul.member with memberA, memberC
  by_cases aZ : a = realZero
  . rw ennMul.zero_left at a, ennAdd(b, c) with aZ, bcM
    rw ennMul.zero_left at a, b with aZ, memberB
    rw ennMul.zero_left at a, c with aZ, memberC
    rw ennAdd.zero at realZero with zm
  . by_cases bZ : b = realZero
    . rw ennMul.zero_right at a, b with memberA, bZ
      rw bZ
      rw ennAdd.comm at realZero, c with zm, memberC
      rw ennAdd.zero at c with memberC
      rw ennAdd.comm at realZero, ennMul(a, c) with zm, acM
      rw ennAdd.zero at ennMul(a, c) with acM
    . by_cases cZ : c = realZero
      . rw ennMul.zero_right at a, c with memberA, cZ
        rw cZ
        rw ennAdd.zero at b with memberB
        rw ennAdd.zero at ennMul(a, b) with abM
      . have abZ := ennMul.nonzero with memberA, memberB, aZ, bZ
        have acZ := ennMul.nonzero with memberA, memberC, aZ, cZ
        have bcZ : ennAdd(b, c) ≠ realZero
          have le : EnnLe(b, ennAdd(b, c))
            have bb := EnnLe.reflexive with memberB
            have zc := EnnLe.zero with memberC
            have m := ennAdd.mono with bb, zc
            rw ennAdd.zero at b with memberB at m
            exact m
          exact EnnLe.nonzero with le, bZ
        have ca := ennreal.cases with memberA
        cases ca with aT | afin
        . rw ennMul.top_left at a, ennAdd(b, c) with aT, bcZ
          rw ennMul.top_left at a, b with aT, bZ
          rw ennMul.top_left at a, c with aT, cZ
          rw ennAdd.top_left at ennTop, ennTop with rfl
        . have cb := ennreal.cases with memberB
          cases cb with bT | bfin
          . rw ennAdd.top_left at b, c with bT
            rw ennMul.top_right at a, ennTop with aZ, rfl
            rw ennMul.top_right at a, b with aZ, bT
            rw ennAdd.top_left at ennTop, ennMul(a, c) with rfl
          . have cc := ennreal.cases with memberC
            cases cc with cT | cfin
            . rw ennAdd.top_right at b, c with cT
              rw ennMul.top_right at a, ennTop with aZ, rfl
              rw ennMul.top_right at a, c with aZ, cT
              rw ennAdd.top_right at ennMul(a, b), ennTop with rfl
            . obtain ⟨aR, aNn⟩ := afin
              obtain ⟨bR, bNn⟩ := bfin
              obtain ⟨cR, cNn⟩ := cfin
              have bcR : R[b + c] ∈ ℝ by typecheck
              have bcNn : realZero ≤ R[b + c] by linarith
              have abR : R[a * b] ∈ ℝ by typecheck
              have abNn := realMulValue.nonnegative at a, b with aNn, bNn
              have acR : R[a * c] ∈ ℝ by typecheck
              have acNn := realMulValue.nonnegative at a, c with aNn, cNn
              rw ennAdd.finite with bR, cR, bNn, cNn
              rw ennMul.finite with aR, bcR, aNn, bcNn
              rw ennMul.finite with aR, bR, aNn, bNn
              rw ennMul.finite with aR, cR, aNn, cNn
              rw ennAdd.finite with abR, acR, abNn, acNn
              ring

theorem ennMul.mono (a b c d : Set)
  requires first : EnnLe(a, b)
  requires second : EnnLe(c, d)
  shows EnnLe(ennMul(a, c), ennMul(b, d))
proof
  have f1 := first
  have s1 := second
  obtain ⟨aM, bM, ab⟩ := f1
  obtain ⟨cM, dM, cd⟩ := s1
  have acM := ennMul.member with aM, cM
  have bdM := ennMul.member with bM, dM
  by_cases aZ : a = realZero
  . rw ennMul.zero_left at a, c with aZ, cM
    exact EnnLe.zero with bdM
  . by_cases cZ : c = realZero
    . rw ennMul.zero_right at a, c with aM, cZ
      exact EnnLe.zero with bdM
    . have bZ := EnnLe.nonzero with first, aZ
      have dZ := EnnLe.nonzero with second, cZ
      by_cases bT : b = ennTop
      . rw ennMul.top_left at b, d with bT, dZ
        exact EnnLe.top with acM
      . by_cases dT : d = ennTop
        . rw ennMul.top_right at b, d with bZ, dT
          exact EnnLe.top with acM
        . cases ab with bT2 | afin
          . exfalso
            exact bT with bT2
          . cases cd with dT2 | cfin
            . exfalso
              exact dT with dT2
            . obtain ⟨na, ale⟩ := afin
              obtain ⟨nc, cle⟩ := cfin
              obtain ⟨aR, aNn⟩ := ennreal.finite with aM, na
              obtain ⟨bR, bNn⟩ := ennreal.finite with bM, bT
              obtain ⟨cR, cNn⟩ := ennreal.finite with cM, nc
              obtain ⟨dR, dNn⟩ := ennreal.finite with dM, dT
              rw ennMul.finite with aR, cR, aNn, cNn
              rw ennMul.finite with bR, dR, bNn, dNn
              rw ennMul.finite with aR, cR, aNn, cNn at acM
              rw ennMul.finite with bR, dR, bNn, dNn at bdM
              have acR : R[a * c] ∈ ℝ by typecheck
              have n1 := ennreal.not_top_of_real with acR
              have l1 := realLe.mul_right_of_nonnegative at a, b, c with ale, cNn
              have l2 := realLe.mul_left_of_nonnegative at c, d, b with cle, bNn
              unfold EnnLe
              refine ⟨acM, bdM, ?_⟩
              right
              refine ⟨n1, ?_⟩
              linarith

-- ennMulReal of Topology/Sums is the product.
theorem ennMulReal.eq_ennMul (c a : Set)
  requires nonneg : c ∈ ennreal ∧ c ≠ ennTop
  requires member : a ∈ ennreal
  shows ennMulReal(c, a) = ennMul(c, a)
proof
  obtain ⟨cM, cT⟩ := nonneg
  obtain ⟨cR, cNn⟩ := ennreal.finite with cM, cT
  have ca := ennreal.cases with member
  cases ca with aT | afin
  . rw aT
    by_cases cZ : c = realZero
    . rw cZ
      rw ennMulReal.top_zero
      rw ennMul.zero_left at realZero, ennTop with rfl, ennreal.top_member
    . rw ennMulReal.top_pos with cZ
      rw ennMul.top_right at c, ennTop with cZ, rfl
  . obtain ⟨aR, aNn⟩ := afin
    rw ennMulReal.finite with aR, aNn, cR, cNn
    rw ennMul.finite with cR, aR, cNn, aNn

-- Helpers: completeness of [0, ∞].
theorem real.sup_exists (S : Set)
  requires inside : S ⊆ ℝ
  requires inhabited : ∃ x, x ∈ S
  requires bounded : ∃ B ∈ ℝ, ∀ x ∈ S, x ≤ B
  shows ∃ U ∈ ℝ, (∀ x ∈ S, x ≤ U) ∧ (∀ B ∈ ℝ, (∀ x ∈ S, x ≤ B) → U ≤ B)
proof
  obtain ⟨x0, x0S⟩ := inhabited
  have ne : Nonempty(S) := ⟨x0, x0S⟩
  obtain ⟨B, BR, Bb⟩ := bounded
  have realB : Real(B) by exact BR
  have upperB : RealUpperBound(S, B)
    refine ⟨realB, inside, ?_⟩
    intros x hx
    have xR := inside with x, hx
    have le := Bb with x, hx
    exact realLe.subset with le
  have bd : ∃ D, RealUpperBound(S, D) := ⟨B, upperB⟩
  obtain ⟨U, least⟩ := Real.least_upper_bound_property with ne, bd
  have upperU := least.left
  have minimal := least.right
  obtain ⟨realU, inReals, bounds⟩ := upperU
  have UR : U ∈ ℝ by simp [Real]
  refine ⟨U, UR, ?_, ?_⟩
  . intros x hx
    have xR := inside with x, hx
    have sub := bounds with x, hx
    exact realLe.of_subset with sub
  . intros C CR Cb
    have realC : Real(C) by exact CR
    have upperC : RealUpperBound(S, C)
      refine ⟨realC, inside, ?_⟩
      intros x hx
      have xR := inside with x, hx
      have le := Cb with x, hx
      exact realLe.subset with le
    have sub := minimal with C, upperC
    exact realLe.of_subset with sub

theorem ennSup.exists (S : Set)
  requires inside : S ⊆ ennreal
  shows ∃ b ∈ ennreal, EnnUpperBound(S, b) ∧ (∀ c, EnnUpperBound(S, c) → EnnLe(b, c))
proof
  have tm := ennreal.top_member
  have zm := ennreal.zero_member
  have topUpper : EnnUpperBound(S, ennTop)
    unfold EnnUpperBound
    refine ⟨tm, ?_⟩
    intros a ha
    have aM := inside with a, ha
    exact EnnLe.top with aM
  by_cases topIn : ennTop ∈ S
  . refine ⟨ennTop, tm, topUpper, ?_⟩
    intros c hc
    obtain ⟨cM, bounds⟩ := hc
    exact bounds with ennTop, topIn
  . have finiteS : ∀ a ∈ S, a ∈ ℝ ∧ realZero ≤ a
      intros a ha
      have aM := inside with a, ha
      have aT : a ≠ ennTop
        intro e
        rw e at ha
        exact topIn with ha
      exact ennreal.finite with aM, aT
    have SR : S ⊆ ℝ
      intros a ha
      have fa := finiteS with a, ha
      exact fa.left
    by_cases empty : ∃ x, x ∈ S
    . by_cases bounded : ∃ B ∈ ℝ, ∀ x ∈ S, x ≤ B
      . obtain ⟨U, UR, upper, least⟩ := real.sup_exists with SR, empty, bounded
        obtain ⟨x0, x0S⟩ := empty
        have fx0 := finiteS with x0, x0S
        have x0R := fx0.left
        have x0Nn := fx0.right
        have le0 := upper with x0, x0S
        have UNn : realZero ≤ U by linarith
        have UM := ennreal.of_real with UR, UNn
        have UT := ennreal.not_top_of_real with UR
        have Uupper : EnnUpperBound(S, U)
          unfold EnnUpperBound
          refine ⟨UM, ?_⟩
          intros a ha
          have aM := inside with a, ha
          have fa := finiteS with a, ha
          have aR := fa.left
          have aT := ennreal.not_top_of_real with aR
          have le := upper with a, ha
          unfold EnnLe
          refine ⟨aM, UM, ?_⟩
          right
          exact ⟨aT, le⟩
        refine ⟨U, UM, Uupper, ?_⟩
        intros c hc
        have hc2 := hc
        obtain ⟨cM, bounds⟩ := hc2
        by_cases cT : c = ennTop
        . rw cT
          exact EnnLe.top with UM
        . obtain ⟨cR, cNn⟩ := ennreal.finite with cM, cT
          have cb : ∀ x ∈ S, x ≤ c
            intros x hx
            have le := bounds with x, hx
            obtain ⟨xM, cM2, alt⟩ := le
            cases alt with cT2 | fin
            . exfalso
              exact cT with cT2
            . exact fin.right
          have Uc := least with c, cR, cb
          unfold EnnLe
          refine ⟨UM, cM, ?_⟩
          right
          exact ⟨UT, Uc⟩
      . refine ⟨ennTop, tm, topUpper, ?_⟩
        intros c hc
        have hc2 := hc
        obtain ⟨cM, bounds⟩ := hc2
        by_cases cT : c = ennTop
        . rw cT
          exact EnnLe.reflexive with tm
        . exfalso
          obtain ⟨cR, cNn⟩ := ennreal.finite with cM, cT
          apply bounded
          refine ⟨c, cR, ?_⟩
          intros x hx
          have le := bounds with x, hx
          obtain ⟨xM, cM2, alt⟩ := le
          cases alt with cT2 | fin
          . exfalso
            exact cT with cT2
          . exact fin.right
    . have zUpper : EnnUpperBound(S, realZero)
        unfold EnnUpperBound
        refine ⟨zm, ?_⟩
        intros a ha
        exfalso
        apply empty
        exact ⟨a, ha⟩
      refine ⟨realZero, zm, zUpper, ?_⟩
      intros c hc
      obtain ⟨cM, bounds⟩ := hc
      exact EnnLe.zero with cM

theorem ennSup.eq_of_lub (S b : Set)
  requires member : b ∈ ennreal
  requires upper : EnnUpperBound(S, b)
  requires least : ∀ c, EnnUpperBound(S, c) → EnnLe(b, c)
  shows ennSup(S) = b
proof
  unfold ennSup
  apply union.of_unique
  . apply ennSup.family.membership.backward
    exact ⟨member, upper, least⟩
  . intros w hw
    obtain ⟨wM, wUpper, wLeast⟩ := ennSup.family.membership.forward with hw
    have l1 := wLeast with b, upper
    have l2 := least with w, wUpper
    exact EnnLe.antisymmetric with l1, l2

theorem ennInf.eq_of_glb (S b : Set)
  requires member : b ∈ ennreal
  requires lower : EnnLowerBound(S, b)
  requires greatest : ∀ c, EnnLowerBound(S, c) → EnnLe(c, b)
  shows ennInf(S) = b
proof
  unfold ennInf
  apply union.of_unique
  . apply ennInf.family.membership.backward
    exact ⟨member, lower, greatest⟩
  . intros w hw
    obtain ⟨wM, wLower, wGreatest⟩ := ennInf.family.membership.forward with hw
    have l1 := wGreatest with b, lower
    have l2 := greatest with w, wLower
    exact EnnLe.antisymmetric with l2, l1

-- The lower bounds in [0, ∞] of a set.
def ennLowerBounds (S : Set) : Set := { b ∈ ennreal | EnnLowerBound(S, b) }

theorem EnnLe.of_not_lt (a b : Set)
  requires memberA : a ∈ ennreal
  requires memberB : b ∈ ennreal
  requires notLt : ¬EnnLt(a, b)
  shows EnnLe(b, a)
proof
  have t := EnnLe.total with memberA, memberB
  cases t with ab | ba
  . by_cases e : a = b
    . rw e
      exact EnnLe.reflexive with memberB
    . exfalso
      apply notLt
      unfold EnnLt
      exact ⟨ab, e⟩
  . exact ba

-- Every subset of [0, ∞] has a least upper bound and a greatest lower
-- bound (complete lattice).
theorem ennSup.least_upper (S : Set)
  requires inside : S ⊆ ennreal
  shows EnnUpperBound(S, ennSup(S)) ∧
    (∀ c, EnnUpperBound(S, c) → EnnLe(ennSup(S), c))
proof
  obtain ⟨b, bM, ub, least⟩ := ennSup.exists with inside
  have e := ennSup.eq_of_lub with bM, ub, least
  refine ⟨?_, ?_⟩
  . rw e
    exact ub
  . intros c hc
    rw e
    exact least with c, hc

theorem ennInf.greatest_lower (S : Set)
  requires inside : S ⊆ ennreal
  shows EnnLowerBound(S, ennInf(S)) ∧
    (∀ c, EnnLowerBound(S, c) → EnnLe(c, ennInf(S)))
proof
  have LM : ennLowerBounds(S) ⊆ ennreal
    intros b hb
    obtain ⟨bM, rest⟩ := hb
    exact bM
  obtain ⟨s, sM, ub, least⟩ := ennSup.exists with LM
  have lower : EnnLowerBound(S, s)
    unfold EnnLowerBound
    refine ⟨sM, ?_⟩
    intros a ha
    have aM := inside with a, ha
    have aUpper : EnnUpperBound(ennLowerBounds(S), a)
      unfold EnnUpperBound
      refine ⟨aM, ?_⟩
      intros b hb
      obtain ⟨bM, bLower⟩ := hb
      obtain ⟨bM2, bounds⟩ := bLower
      exact bounds with a, ha
    exact least with a, aUpper
  have greatest : ∀ c, EnnLowerBound(S, c) → EnnLe(c, s)
    intros c hc
    have hc2 := hc
    obtain ⟨cM, rest⟩ := hc2
    have cL : c ∈ ennLowerBounds(S)
      apply ennLowerBounds.membership.backward
      exact ⟨cM, hc⟩
    obtain ⟨sM2, bounds⟩ := ub
    exact bounds with c, cL
  have e := ennInf.eq_of_glb with sM, lower, greatest
  refine ⟨?_, ?_⟩
  . rw e
    exact lower
  . intros c hc
    rw e
    exact greatest with c, hc

theorem ennSup.empty
  shows ennSup(∅) = realZero
proof
  have zm := ennreal.zero_member
  have upper : EnnUpperBound(∅, realZero)
    unfold EnnUpperBound
    refine ⟨zm, ?_⟩
    intros a ha
    simp at ha
  have least : ∀ c, EnnUpperBound(∅, c) → EnnLe(realZero, c)
    intros c hc
    obtain ⟨cM, rest⟩ := hc
    exact EnnLe.zero with cM
  exact ennSup.eq_of_lub with zm, upper, least

theorem ennInf.empty
  shows ennInf(∅) = ennTop
proof
  have tm := ennreal.top_member
  have lower : EnnLowerBound(∅, ennTop)
    unfold EnnLowerBound
    refine ⟨tm, ?_⟩
    intros a ha
    simp at ha
  have greatest : ∀ c, EnnLowerBound(∅, c) → EnnLe(c, ennTop)
    intros c hc
    obtain ⟨cM, rest⟩ := hc
    exact EnnLe.top with cM
  exact ennInf.eq_of_glb with tm, lower, greatest

-- Mathlib's ENNReal.lt_iSup_iff / le_iSup.
theorem ennSup.lt_iff (S a : Set)
  requires inside : S ⊆ ennreal
  requires member : a ∈ ennreal
  shows EnnLt(a, ennSup(S)) ↔ (∃ b ∈ S, EnnLt(a, b))
proof
  have lu := ennSup.least_upper with inside
  obtain ⟨ub, least⟩ := lu
  have ub2 := ub
  obtain ⟨sM, bounds⟩ := ub2
  constructor
  . intro lt
    by_contra none
    have aUpper : EnnUpperBound(S, a)
      unfold EnnUpperBound
      refine ⟨member, ?_⟩
      intros b hb
      have bM := inside with b, hb
      have nl : ¬EnnLt(a, b)
        intro l
        apply none
        exact ⟨b, hb, l⟩
      exact EnnLe.of_not_lt with member, bM, nl
    have sa := least with a, aUpper
    obtain ⟨as, ne⟩ := lt
    have e := EnnLe.antisymmetric with as, sa
    exact ne with e
  . intro ex
    obtain ⟨b, bS, ab⟩ := ex
    obtain ⟨abLe, abNe⟩ := ab
    have bs := bounds with b, bS
    have as := EnnLe.transitive with abLe, bs
    unfold EnnLt
    refine ⟨as, ?_⟩
    intro e
    rw ← e at bs
    have e2 := EnnLe.antisymmetric with abLe, bs
    exact abNe with e2

-- Helpers: finite sums in [0, ∞].
theorem ennFiniteSum.finite_value (f F : Set)
  requires finite : Finite(F)
  requires values : ∀ i ∈ F, f(i) ∈ ennreal
  requires noTop : ∀ i ∈ F, f(i) ≠ ennTop
  shows ennFiniteSum(f, F) = realFiniteSum(f, F)
proof
  have real : ∀ i ∈ F, f(i) ∈ ℝ
    intros i hi
    have fi := ennreal.finite with (values with i, hi), (noTop with i, hi)
    exact fi.left
  have nonneg : ∀ i ∈ F, realZero ≤ f(i)
    intros i hi
    have fi := ennreal.finite with (values with i, hi), (noTop with i, hi)
    exact fi.right
  have sR := realFiniteSum.real with finite, real
  have sNn := realFiniteSum.nonneg with finite, real, nonneg
  have sM := ennreal.of_real with sR, sNn
  unfold ennFiniteSum
  apply union.of_unique
  . apply ennFiniteSum.family.membership.backward
    refine ⟨sM, ?_⟩
    left
    exact ⟨noTop, rfl⟩
  . intros w hw
    obtain ⟨wM, alt⟩ := ennFiniteSum.family.membership.forward with hw
    cases alt with fin | top
    . exact fin.right
    . exfalso
      obtain ⟨ex, rest⟩ := top
      obtain ⟨i, hi, fi⟩ := ex
      exact (noTop with i, hi) with fi

theorem ennFiniteSum.top_value (f F : Set)
  requires top : ∃ i ∈ F, f(i) = ennTop
  shows ennFiniteSum(f, F) = ennTop
proof
  have tm := ennreal.top_member
  unfold ennFiniteSum
  apply union.of_unique
  . apply ennFiniteSum.family.membership.backward
    refine ⟨tm, ?_⟩
    right
    exact ⟨top, rfl⟩
  . intros w hw
    obtain ⟨wM, alt⟩ := ennFiniteSum.family.membership.forward with hw
    cases alt with fin | t
    . exfalso
      obtain ⟨noTop, rest⟩ := fin
      obtain ⟨i, hi, fi⟩ := top
      exact (noTop with i, hi) with fi
    . exact t.right

theorem ennFiniteSum.member_helper (f F : Set)
  requires finite : Finite(F)
  requires values : ∀ i ∈ F, f(i) ∈ ennreal
  shows ennFiniteSum(f, F) ∈ ennreal
proof
  by_cases top : ∃ i ∈ F, f(i) = ennTop
  . rw ennFiniteSum.top_value with top
    exact ennreal.top_member
  . have noTop : ∀ i ∈ F, f(i) ≠ ennTop
      intros i hi e
      apply top
      exact ⟨i, hi, e⟩
    have real : ∀ i ∈ F, f(i) ∈ ℝ
      intros i hi
      have fi := ennreal.finite with (values with i, hi), (noTop with i, hi)
      exact fi.left
    have nonneg : ∀ i ∈ F, realZero ≤ f(i)
      intros i hi
      have fi := ennreal.finite with (values with i, hi), (noTop with i, hi)
      exact fi.right
    rw ennFiniteSum.finite_value with finite, values, noTop
    have sR := realFiniteSum.real with finite, real
    have sNn := realFiniteSum.nonneg with finite, real, nonneg
    exact ennreal.of_real with sR, sNn

theorem ennFiniteSum.mono_set (f E F : Set)
  requires finite : Finite(F)
  requires inside : E ⊆ F
  requires values : ∀ i ∈ F, f(i) ∈ ennreal
  shows EnnLe(ennFiniteSum(f, E), ennFiniteSum(f, F))
proof
  have finiteE := Finite.subset with finite, inside
  have valuesE : ∀ i ∈ E, f(i) ∈ ennreal
    intros i hi
    exact values with i, (inside with i, hi)
  have mE := ennFiniteSum.member_helper with finiteE, valuesE
  by_cases top : ∃ i ∈ F, f(i) = ennTop
  . rw ennFiniteSum.top_value at f, F with top
    exact EnnLe.top with mE
  . have noTop : ∀ i ∈ F, f(i) ≠ ennTop
      intros i hi e
      apply top
      exact ⟨i, hi, e⟩
    have noTopE : ∀ i ∈ E, f(i) ≠ ennTop
      intros i hi
      exact noTop with i, (inside with i, hi)
    have real : ∀ i ∈ F, f(i) ∈ ℝ
      intros i hi
      have fi := ennreal.finite with (values with i, hi), (noTop with i, hi)
      exact fi.left
    have nonneg : ∀ i ∈ F, realZero ≤ f(i)
      intros i hi
      have fi := ennreal.finite with (values with i, hi), (noTop with i, hi)
      exact fi.right
    have mF := ennFiniteSum.member_helper with finite, values
    rw ennFiniteSum.finite_value at f, E with finiteE, valuesE, noTopE
    rw ennFiniteSum.finite_value at f, F with finite, values, noTop
    rw ennFiniteSum.finite_value at f, E with finiteE, valuesE, noTopE at mE
    rw ennFiniteSum.finite_value at f, F with finite, values, noTop at mF
    have realE : ∀ i ∈ E, f(i) ∈ ℝ
      intros i hi
      exact real with i, (inside with i, hi)
    have eR := realFiniteSum.real with finiteE, realE
    have eT := ennreal.not_top_of_real with eR
    have le := realFiniteSum.mono_set with finite, inside, real, nonneg
    unfold EnnLe
    refine ⟨mE, mF, ?_⟩
    right
    exact ⟨eT, le⟩

theorem finiteSumsOf.inside (f I : Set)
  requires values : ∀ i ∈ I, f(i) ∈ ennreal
  shows finiteSumsOf(f, I) ⊆ ennreal
proof
  intros a ha
  obtain ⟨F, FIn, e⟩ := finiteSumsOf.membership.forward with ha
  obtain ⟨FP, finite⟩ := finiteSubsets.membership.forward with FIn
  have FI := (powerset.membership_iff at F, I).forward with FP
  have valuesF : ∀ i ∈ F, f(i) ∈ ennreal
    intros i hi
    exact values with i, (FI with i, hi)
  rw ← e
  exact ennFiniteSum.member_helper with finite, valuesF

theorem ennTsum.upper (f I F : Set)
  requires values : ∀ i ∈ I, f(i) ∈ ennreal
  requires finite : Finite(F)
  requires inside : F ⊆ I
  shows EnnLe(ennFiniteSum(f, F), ennTsum(f, I))
proof
  have sub := finiteSumsOf.inside with values
  have lu := ennSup.least_upper with sub
  obtain ⟨ub, least⟩ := lu
  obtain ⟨sM, bounds⟩ := ub
  have FP := (powerset.membership_iff at F, I).backward with inside
  have FIn : F ∈ finiteSubsets(I) := finiteSubsets.membership.backward with ⟨FP, finite⟩
  have mem : ennFiniteSum(f, F) ∈ finiteSumsOf(f, I) := finiteSumsOf.membership.backward with ⟨F, FIn, rfl⟩
  unfold ennTsum
  exact bounds with ennFiniteSum(f, F), mem

theorem ennTsum.least (f I c : Set)
  requires values : ∀ i ∈ I, f(i) ∈ ennreal
  requires member : c ∈ ennreal
  requires bound : ∀ F ∈ finiteSubsets(I), EnnLe(ennFiniteSum(f, F), c)
  shows EnnLe(ennTsum(f, I), c)
proof
  have sub := finiteSumsOf.inside with values
  have lu := ennSup.least_upper with sub
  obtain ⟨ub, least⟩ := lu
  have cUpper : EnnUpperBound(finiteSumsOf(f, I), c)
    unfold EnnUpperBound
    refine ⟨member, ?_⟩
    intros a ha
    obtain ⟨F, FIn, e⟩ := finiteSumsOf.membership.forward with ha
    rw ← e
    exact bound with F, FIn
  unfold ennTsum
  exact least with c, cUpper

theorem ennFiniteSum.congr (f g F : Set)
  requires agree : ∀ i ∈ F, f(i) = g(i)
  shows ennFiniteSum(f, F) = ennFiniteSum(g, F)
proof
  have rs : realFiniteSum(f, F) = realFiniteSum(g, F)
    unfold realFiniteSum
    exact groupFiniteSum.congr with agree
  have fam : ennFiniteSum.family(f, F) = ennFiniteSum.family(g, F)
    ext S
    constructor
    . intro h
      obtain ⟨SM, alt⟩ := ennFiniteSum.family.membership.forward with h
      apply ennFiniteSum.family.membership.backward
      refine ⟨SM, ?_⟩
      cases alt with fin | top
      . left
        obtain ⟨noTop, e⟩ := fin
        refine ⟨?_, ?_⟩
        . intros i hi
          rw ← agree with i, hi
          exact noTop with i, hi
        . rw e
          exact rs
      . right
        obtain ⟨ex, e⟩ := top
        obtain ⟨i, hi, fi⟩ := ex
        refine ⟨?_, e⟩
        refine ⟨i, hi, ?_⟩
        rw ← agree with i, hi
        exact fi
    . intro h
      obtain ⟨SM, alt⟩ := ennFiniteSum.family.membership.forward with h
      apply ennFiniteSum.family.membership.backward
      refine ⟨SM, ?_⟩
      cases alt with fin | top
      . left
        obtain ⟨noTop, e⟩ := fin
        refine ⟨?_, ?_⟩
        . intros i hi
          rw agree with i, hi
          exact noTop with i, hi
        . rw e
          symm
          exact rs
      . right
        obtain ⟨ex, e⟩ := top
        obtain ⟨i, hi, fi⟩ := ex
        refine ⟨?_, e⟩
        refine ⟨i, hi, ?_⟩
        rw agree with i, hi
        exact fi
  unfold ennFiniteSum
  rw fam

theorem ennFiniteSum.mono_fun (f g F : Set)
  requires finite : Finite(F)
  requires valuesF : ∀ i ∈ F, f(i) ∈ ennreal
  requires valuesG : ∀ i ∈ F, g(i) ∈ ennreal
  requires le : ∀ i ∈ F, EnnLe(f(i), g(i))
  shows EnnLe(ennFiniteSum(f, F), ennFiniteSum(g, F))
proof
  have mF := ennFiniteSum.member_helper with finite, valuesF
  have mG := ennFiniteSum.member_helper with finite, valuesG
  by_cases top : ∃ i ∈ F, g(i) = ennTop
  . rw ennFiniteSum.top_value at g, F with top
    exact EnnLe.top with mF
  . have noTopG : ∀ i ∈ F, g(i) ≠ ennTop
      intros i hi e
      apply top
      exact ⟨i, hi, e⟩
    have noTopF : ∀ i ∈ F, f(i) ≠ ennTop
      intros i hi
      have l := le with i, hi
      obtain ⟨fM, gM, alt⟩ := l
      cases alt with gT | fin
      . exfalso
        exact (noTopG with i, hi) with gT
      . exact fin.left
    have realF : ∀ i ∈ F, f(i) ∈ ℝ
      intros i hi
      have fi := ennreal.finite with (valuesF with i, hi), (noTopF with i, hi)
      exact fi.left
    have leR : ∀ i ∈ F, f(i) ≤ g(i)
      intros i hi
      have l := le with i, hi
      obtain ⟨fM, gM, alt⟩ := l
      cases alt with gT | fin
      . exfalso
        exact (noTopG with i, hi) with gT
      . exact fin.right
    rw ennFiniteSum.finite_value at f, F with finite, valuesF, noTopF
    rw ennFiniteSum.finite_value at g, F with finite, valuesG, noTopG
    rw ennFiniteSum.finite_value at f, F with finite, valuesF, noTopF at mF
    rw ennFiniteSum.finite_value at g, F with finite, valuesG, noTopG at mG
    have fR := realFiniteSum.real with finite, realF
    have fT := ennreal.not_top_of_real with fR
    have l2 := realFiniteSum.mono_fun with finite, leR
    unfold EnnLe
    refine ⟨mF, mG, ?_⟩
    right
    exact ⟨fT, l2⟩

theorem ennTsum.member_helper (f I : Set)
  requires values : ∀ i ∈ I, f(i) ∈ ennreal
  shows ennTsum(f, I) ∈ ennreal
proof
  have sub := finiteSumsOf.inside with values
  have lu := ennSup.least_upper with sub
  obtain ⟨ub, least⟩ := lu
  obtain ⟨sM, bounds⟩ := ub
  unfold ennTsum
  exact sM

theorem realFiniteSum.zero (f F : Set)
  requires finite : Finite(F)
  requires zero : ∀ i ∈ F, f(i) = realZero
  shows realFiniteSum(f, F) = realZero
proof
  obtain ⟨abelian, c, m, o⟩ := realAdditiveGroup.parts
  have zero2 : ∀ i ∈ F, f(i) = Group.one(realAdditiveGroup)
    rw o
    exact zero
  have z := groupFiniteSum.zero at realAdditiveGroup, F, f with abelian, finite, zero2
  rw o at z
  unfold realFiniteSum
  exact z

-- A sum in [0, ∞] whose terms vanish off a finite set F is the finite sum
-- over F.
theorem ennTsum.support (f I F : Set)
  requires values : ∀ i ∈ I, f(i) ∈ ennreal
  requires finite : Finite(F)
  requires inside : F ⊆ I
  requires zero : ∀ i ∈ I, i ∉ F → f(i) = realZero
  shows ennTsum(f, I) = ennFiniteSum(f, F)
proof
  have valuesF : ∀ i ∈ F, f(i) ∈ ennreal
    intros i hi
    exact values with i, (inside with i, hi)
  have mF := ennFiniteSum.member_helper with finite, valuesF
  have upper := ennTsum.upper with values, finite, inside
  have least : EnnLe(ennTsum(f, I), ennFiniteSum(f, F))
    apply ennTsum.least with values, mF
    intros E hE
    obtain ⟨EP, finiteE⟩ := finiteSubsets.membership.forward with hE
    have EI := (powerset.membership_iff at E, I).forward with EP
    have dsub : E ∖ F ⊆ E
      intros x hx
      obtain ⟨xE, rest⟩ := difference.membership.forward with hx
      exact xE
    have finiteD := Finite.subset with finiteE, dsub
    have finiteU := Finite.union with finite, finiteD
    have EU : E ⊆ F ∪ (E ∖ F)
      intros x hx
      by_cases xF : x ∈ F
      . simp
      . simp
    have UI : F ∪ (E ∖ F) ⊆ I
      intros x hx
      have split := union2.membership.forward with hx
      cases split with xF | xD
      . exact inside with x, xF
      . obtain ⟨xE, rest⟩ := difference.membership.forward with xD
        exact EI with x, xE
    have valuesU : ∀ i ∈ F ∪ (E ∖ F), f(i) ∈ ennreal
      intros i hi
      exact values with i, (UI with i, hi)
    have l1 := ennFiniteSum.mono_set with finiteU, EU, valuesU
    have same : ennFiniteSum(f, F ∪ (E ∖ F)) = ennFiniteSum(f, F)
      by_cases top : ∃ i ∈ F, f(i) = ennTop
      . obtain ⟨i, iF, iT⟩ := top
        have iU : i ∈ F ∪ (E ∖ F) by simp
        have ex1 : ∃ j ∈ F ∪ (E ∖ F), f(j) = ennTop := ⟨i, iU, iT⟩
        have ex2 : ∃ j ∈ F, f(j) = ennTop := ⟨i, iF, iT⟩
        rw ennFiniteSum.top_value at f, F ∪ (E ∖ F) with ex1
        rw ennFiniteSum.top_value at f, F with ex2
      . have noTopF : ∀ i ∈ F, f(i) ≠ ennTop
          intros i hi e
          apply top
          exact ⟨i, hi, e⟩
        have zeroD : ∀ i ∈ E ∖ F, f(i) = realZero
          intros i hi
          obtain ⟨iE, iF⟩ := difference.membership.forward with hi
          exact zero with i, (EI with i, iE), iF
        have zt := ennreal.zero_not_top
        have noTopU : ∀ i ∈ F ∪ (E ∖ F), f(i) ≠ ennTop
          intros i hi
          have split := union2.membership.forward with hi
          cases split with iF | iD
          . exact noTopF with i, iF
          . rw zeroD with i, iD
            exact zt
        have realU : ∀ i ∈ F ∪ (E ∖ F), f(i) ∈ ℝ
          intros i hi
          have fi := ennreal.finite with (valuesU with i, hi), (noTopU with i, hi)
          exact fi.left
        have disjoint : Disjoint(F, E ∖ F)
          unfold Disjoint
          ext x
          constructor
          . intro h
            obtain ⟨xF, xD⟩ := intersection.membership.forward with h
            obtain ⟨xE, xnF⟩ := difference.membership.forward with xD
            exfalso
            exact xnF with xF
          . intro h
            simp at h
        rw ennFiniteSum.finite_value at f, F ∪ (E ∖ F) with finiteU, valuesU, noTopU
        rw ennFiniteSum.finite_value at f, F with finite, valuesF, noTopF
        rw realFiniteSum.union with finite, finiteD, disjoint, realU
        rw realFiniteSum.zero at f, E ∖ F with finiteD, zeroD
        have realF : ∀ i ∈ F, f(i) ∈ ℝ
          intros i hi
          exact realU with i, (union2.left at i, F, E ∖ F with hi)
        have sR := realFiniteSum.real with finite, realF
        ring
    rw same at l1
    exact l1
  exact EnnLe.antisymmetric with least, upper

theorem ennFiniteSum.insert_helper (f F i : Set)
  requires finite : Finite(F)
  requires values : ∀ j ∈ F ∪ {i}, f(j) ∈ ennreal
  requires fresh : i ∉ F
  shows ennFiniteSum(f, F ∪ {i}) = ennAdd(ennFiniteSum(f, F), f(i))
proof
  have fs := Finite.singleton at i
  have finiteU := Finite.union with finite, fs
  have iIn : i ∈ F ∪ {i} by simp
  have valuesF : ∀ j ∈ F, f(j) ∈ ennreal
    intros j hj
    have jIn : j ∈ F ∪ {i} by simp
    exact values with j, jIn
  have fiM := values with i, iIn
  have mF := ennFiniteSum.member_helper with finite, valuesF
  by_cases iT : f(i) = ennTop
  . have ex : ∃ j ∈ F ∪ {i}, f(j) = ennTop := ⟨i, iIn, iT⟩
    rw ennFiniteSum.top_value at f, F ∪ {i} with ex
    rw ennAdd.top_right at ennFiniteSum(f, F), f(i) with iT
  . by_cases top : ∃ j ∈ F, f(j) = ennTop
    . obtain ⟨j, jF, jT⟩ := top
      have jIn : j ∈ F ∪ {i} by simp
      have ex : ∃ k ∈ F ∪ {i}, f(k) = ennTop := ⟨j, jIn, jT⟩
      have ex2 : ∃ k ∈ F, f(k) = ennTop := ⟨j, jF, jT⟩
      rw ennFiniteSum.top_value at f, F ∪ {i} with ex
      rw ennFiniteSum.top_value at f, F with ex2
      rw ennAdd.top_left at ennTop, f(i) with rfl
    . have noTopF : ∀ j ∈ F, f(j) ≠ ennTop
        intros j hj e
        apply top
        exact ⟨j, hj, e⟩
      have noTopU : ∀ j ∈ F ∪ {i}, f(j) ≠ ennTop
        intros j hj
        have split := union2.membership.forward with hj
        cases split with jF | jI
        . exact noTopF with j, jF
        . simp at jI
          rw jI
          exact iT
      have realF : ∀ j ∈ F, f(j) ∈ ℝ
        intros j hj
        have fj := ennreal.finite with (valuesF with j, hj), (noTopF with j, hj)
        exact fj.left
      have nonnegF : ∀ j ∈ F, realZero ≤ f(j)
        intros j hj
        have fj := ennreal.finite with (valuesF with j, hj), (noTopF with j, hj)
        exact fj.right
      obtain ⟨fiR, fiNn⟩ := ennreal.finite with fiM, iT
      have sR := realFiniteSum.real with finite, realF
      have sNn := realFiniteSum.nonneg with finite, realF, nonnegF
      rw ennFiniteSum.finite_value at f, F ∪ {i} with finiteU, values, noTopU
      rw ennFiniteSum.finite_value at f, F with finite, valuesF, noTopF
      rw ennAdd.finite with sR, fiR, sNn, fiNn
      exact realFiniteSum.insert with finite, realF, fiR, fresh

theorem ennFiniteSum.singleton (f a : Set)
  requires value : f(a) ∈ ennreal
  shows ennFiniteSum(f, {a}) = f(a)
proof
  have fe := Finite.empty
  have e : ∅ ∪ {a} = {a}
    ext x
    simp
  have values : ∀ i ∈ ∅ ∪ {a}, f(i) ∈ ennreal
    intros i hi
    simp at hi
    rw hi
    exact value
  have notIn : a ∉ ∅ by simp
  have ins := ennFiniteSum.insert_helper at f, ∅, a with fe, values, notIn
  rw e at ins
  rw ins
  have emp : ennFiniteSum(f, ∅) = realZero
    have noTop : ∀ i ∈ ∅, f(i) ≠ ennTop
      intros i hi
      simp at hi
    have valuesE : ∀ i ∈ ∅, f(i) ∈ ennreal
      intros i hi
      simp at hi
    rw ennFiniteSum.finite_value at f, ∅ with fe, valuesE, noTop
    exact realFiniteSum.empty at f
  rw emp
  have zm := ennreal.zero_member
  rw ennAdd.comm at realZero, f(a) with zm, value
  exact ennAdd.zero at f(a) with value

theorem ennFiniteSum.pair (f a b : Set)
  requires valueA : f(a) ∈ ennreal
  requires valueB : f(b) ∈ ennreal
  requires distinct : a ≠ b
  shows ennFiniteSum(f, {a, b}) = ennAdd(f(a), f(b))
proof
  have e : {a} ∪ {b} = {a, b}
    ext x
    simp
  have fa := Finite.singleton at a
  have values : ∀ i ∈ {a} ∪ {b}, f(i) ∈ ennreal
    intros i hi
    simp at hi
    cases hi with ia | ib
    . rw ia
      exact valueA
    . rw ib
      exact valueB
  have notIn : b ∉ {a}
    intro h
    simp at h
    symm at h
    exact distinct with h
  have ins := ennFiniteSum.insert_helper at f, {a}, b with fa, values, notIn
  rw e at ins
  rw ins
  rw ennFiniteSum.singleton at f, a with valueA

theorem Finite.pair_set (a b : Set)
  shows Finite({a, b})
proof
  have e : {a} ∪ {b} = {a, b}
    ext x
    simp
  have fa := Finite.singleton at a
  have fb := Finite.singleton at b
  have u := Finite.union with fa, fb
  rw e at u
  exact u

theorem ennToReal.top
  shows ennToReal(ennTop) = realZero
proof
  have zR : realZero ∈ ℝ by typecheck
  unfold ennToReal
  apply union.of_unique
  . apply ennToReal.family.membership.backward
    refine ⟨zR, ?_⟩
    right
    exact ⟨rfl, rfl⟩
  . intros w hw
    obtain ⟨wIn, alt⟩ := ennToReal.family.membership.forward with hw
    cases alt with p | n
    . exfalso
      exact p.left with rfl
    . exact n.right

theorem EnnLe.self_add (a b : Set)
  requires memberA : a ∈ ennreal
  requires memberB : b ∈ ennreal
  shows EnnLe(a, ennAdd(a, b))
proof
  have aa := EnnLe.reflexive with memberA
  have zb := EnnLe.zero with memberB
  have m := ennAdd.mono with aa, zb
  rw ennAdd.zero at a with memberA at m
  exact m

-- Section: Sums in [0, ∞]
theorem ennFiniteSum.member (f F : Set)
  requires finite : Finite(F)
  requires values : ∀ i ∈ F, f(i) ∈ ennreal
  shows ennFiniteSum(f, F) ∈ ennreal
proof
  exact ennFiniteSum.member_helper with finite, values

theorem ennFiniteSum.empty (f : Set)
  shows ennFiniteSum(f, ∅) = realZero
proof
  have fe := Finite.empty
  have values : ∀ i ∈ ∅, f(i) ∈ ennreal
    intros i hi
    simp at hi
  have noTop : ∀ i ∈ ∅, f(i) ≠ ennTop
    intros i hi
    simp at hi
  rw ennFiniteSum.finite_value with fe, values, noTop
  exact realFiniteSum.empty at f

theorem ennFiniteSum.insert (f F i : Set)
  requires finite : Finite(F)
  requires values : ∀ j ∈ F ∪ {i}, f(j) ∈ ennreal
  requires fresh : i ∉ F
  shows ennFiniteSum(f, F ∪ {i}) = ennAdd(ennFiniteSum(f, F), f(i))
proof
  exact ennFiniteSum.insert_helper with finite, values, fresh

theorem ennTsum.member (f I : Set)
  requires values : ∀ i ∈ I, f(i) ∈ ennreal
  shows ennTsum(f, I) ∈ ennreal
proof
  exact ennTsum.member_helper with values

-- The sum of finite values is Topology/Sums' ennSum.
theorem ennTsum.eq_ennSum (f I : Set)
  requires values : ∀ i ∈ I, f(i) ∈ ℝ
  requires nonneg : ∀ i ∈ I, realZero ≤ f(i)
  shows ennTsum(f, I) = ennSum(f, I)
proof
  have eM : ∀ i ∈ I, f(i) ∈ ennreal
    intros i hi
    exact ennreal.of_real with (values with i, hi), (nonneg with i, hi)
  have noTop : ∀ i ∈ I, f(i) ≠ ennTop
    intros i hi
    exact ennreal.not_top_of_real with (values with i, hi)
  have sM := ennSum.member with values, nonneg
  have tM := ennTsum.member_helper with eM
  have finSum : ∀ F ∈ finiteSubsets(I), ennFiniteSum(f, F) = realFiniteSum(f, F) ∧ realFiniteSum(f, F) ∈ ℝ ∧ realZero ≤ realFiniteSum(f, F)
    intros F hF
    obtain ⟨FP, finite⟩ := finiteSubsets.membership.forward with hF
    have FI := (powerset.membership_iff at F, I).forward with FP
    have vF : ∀ i ∈ F, f(i) ∈ ennreal
      intros i hi
      exact eM with i, (FI with i, hi)
    have nF : ∀ i ∈ F, f(i) ≠ ennTop
      intros i hi
      exact noTop with i, (FI with i, hi)
    have rF : ∀ i ∈ F, f(i) ∈ ℝ
      intros i hi
      exact values with i, (FI with i, hi)
    have nnF : ∀ i ∈ F, realZero ≤ f(i)
      intros i hi
      exact nonneg with i, (FI with i, hi)
    have e := ennFiniteSum.finite_value with finite, vF, nF
    have r := realFiniteSum.real with finite, rF
    have nn := realFiniteSum.nonneg with finite, rF, nnF
    exact ⟨e, r, nn⟩
  have upper : EnnLe(ennTsum(f, I), ennSum(f, I))
    apply ennTsum.least with eM, sM
    intros F hF
    obtain ⟨FP, finite⟩ := finiteSubsets.membership.forward with hF
    have FI := (powerset.membership_iff at F, I).forward with FP
    obtain ⟨e, r, nn⟩ := finSum with F, hF
    have fM := ennreal.of_real with r, nn
    have fT := ennreal.not_top_of_real with r
    rw e
    by_cases summable : RealSummable(f, I)
    . have eq := ennSum.of_summable with values, nonneg, summable
      have le := realTsum.finite_le with summable, nonneg, finite, FI
      rw eq at sM
      rw eq
      unfold EnnLe
      refine ⟨fM, sM, ?_⟩
      right
      exact ⟨fT, le⟩
    . have eq := ennSum.of_not_summable with values, nonneg, summable
      rw eq
      exact EnnLe.top with fM
  have lower : EnnLe(ennSum(f, I), ennTsum(f, I))
    by_cases tT : ennTsum(f, I) = ennTop
    . rw tT
      exact EnnLe.top with sM
    . obtain ⟨tR, tNn⟩ := ennreal.finite with tM, tT
      have bounded : ∀ F ∈ finiteSubsets(I), realFiniteSum(f, F) ≤ ennTsum(f, I)
        intros F hF
        obtain ⟨FP, finite⟩ := finiteSubsets.membership.forward with hF
        have FI := (powerset.membership_iff at F, I).forward with FP
        obtain ⟨e, r, nn⟩ := finSum with F, hF
        have up := ennTsum.upper with eM, finite, FI
        rw e at up
        obtain ⟨m1, m2, alt⟩ := up
        cases alt with t2 | fin
        . exfalso
          exact tT with t2
        . exact fin.right
      have iff := RealSummable.nonneg_iff with values, nonneg
      have summable : RealSummable(f, I)
        apply iff.backward
        exact ⟨ennTsum(f, I), tR, bounded⟩
      have eq := ennSum.of_summable with values, nonneg, summable
      have summable2 := summable
      unfold RealSummable at summable2
      obtain ⟨S, SIn, sum⟩ := summable2
      have sumR : RealHasSum(f, I, S)
        unfold RealHasSum
        exact sum
      have teq := RealHasSum.tsum_eq with sumR
      have SR := RealHasSum.real with sumR
      have SNn := RealHasSum.nonneg with values, nonneg, sumR
      have iff2 := RealHasSum.nonneg_iff at f, I, S with values, nonneg
      have char := iff2.forward with sumR
      obtain ⟨below, approx⟩ := char
      have Sle : S ≤ ennTsum(f, I)
        by_contra notLe
        have lt : ennTsum(f, I) < S by linarith
        obtain ⟨F, hF, big⟩ := approx with ennTsum(f, I), tR, lt
        have b := bounded with F, hF
        obtain ⟨e, r, nn⟩ := finSum with F, hF
        linarith
      rw eq
      rw teq
      have SM := ennreal.of_real with SR, SNn
      have ST := ennreal.not_top_of_real with SR
      unfold EnnLe
      refine ⟨SM, tM, ?_⟩
      right
      exact ⟨ST, Sle⟩
  exact EnnLe.antisymmetric with upper, lower

theorem ennTsum.finite (f F : Set)
  requires finite : Finite(F)
  requires values : ∀ i ∈ F, f(i) ∈ ennreal
  shows ennTsum(f, F) = ennFiniteSum(f, F)
proof
  have refl := Subset.reflexive at F
  have FP := (powerset.membership_iff at F, F).backward with refl
  have mF := ennFiniteSum.member_helper with finite, values
  have upper := ennTsum.upper with values, finite, refl
  have least : EnnLe(ennTsum(f, F), ennFiniteSum(f, F))
    apply ennTsum.least with values, mF
    intros E hE
    obtain ⟨EP, finiteE⟩ := finiteSubsets.membership.forward with hE
    have EF := (powerset.membership_iff at E, F).forward with EP
    exact ennFiniteSum.mono_set with finite, EF, values
  exact EnnLe.antisymmetric with least, upper

theorem ennTsum.congr (f g I : Set)
  requires agree : ∀ i ∈ I, f(i) = g(i)
  shows ennTsum(f, I) = ennTsum(g, I)
proof
  have same : finiteSumsOf(f, I) = finiteSumsOf(g, I)
    ext a
    constructor
    . intro h
      obtain ⟨F, FIn, e⟩ := finiteSumsOf.membership.forward with h
      obtain ⟨FP, finite⟩ := finiteSubsets.membership.forward with FIn
      have FI := (powerset.membership_iff at F, I).forward with FP
      have agreeF : ∀ i ∈ F, f(i) = g(i)
        intros i hi
        exact agree with i, (FI with i, hi)
      have c := ennFiniteSum.congr with agreeF
      rw c at e
      exact finiteSumsOf.membership.backward with ⟨F, FIn, e⟩
    . intro h
      obtain ⟨F, FIn, e⟩ := finiteSumsOf.membership.forward with h
      obtain ⟨FP, finite⟩ := finiteSubsets.membership.forward with FIn
      have FI := (powerset.membership_iff at F, I).forward with FP
      have agreeF : ∀ i ∈ F, f(i) = g(i)
        intros i hi
        exact agree with i, (FI with i, hi)
      have c := ennFiniteSum.congr with agreeF
      rw ← c at e
      exact finiteSumsOf.membership.backward with ⟨F, FIn, e⟩
  unfold ennTsum
  rw same

theorem ennTsum.term_le (f I j : Set)
  requires values : ∀ i ∈ I, f(i) ∈ ennreal
  requires member : j ∈ I
  shows EnnLe(f(j), ennTsum(f, I))
proof
  have fe := Finite.empty
  have fs := Finite.singleton at j
  have finiteU := Finite.union with fe, fs
  have notIn : j ∉ ∅ by simp
  have sub : ∅ ∪ {j} ⊆ I
    intros i hi
    simp at hi
    rw hi
    exact member
  have valuesU : ∀ i ∈ ∅ ∪ {j}, f(i) ∈ ennreal
    intros i hi
    exact values with i, (sub with i, hi)
  have upper := ennTsum.upper with values, finiteU, sub
  rw ennFiniteSum.insert with fe, valuesU, notIn at upper
  rw ennFiniteSum.empty at upper
  have fjM := values with j, member
  have zm := ennreal.zero_member
  rw ennAdd.comm at realZero, f(j) with zm, fjM at upper
  rw ennAdd.zero at f(j) with fjM at upper
  exact upper

theorem ennTsum.mono (f g I : Set)
  requires valuesF : ∀ i ∈ I, f(i) ∈ ennreal
  requires valuesG : ∀ i ∈ I, g(i) ∈ ennreal
  requires le : ∀ i ∈ I, EnnLe(f(i), g(i))
  shows EnnLe(ennTsum(f, I), ennTsum(g, I))
proof
  have gM := ennTsum.member_helper with valuesG
  apply ennTsum.least with valuesF, gM
  intros F hF
  obtain ⟨FP, finite⟩ := finiteSubsets.membership.forward with hF
  have FI := (powerset.membership_iff at F, I).forward with FP
  have vF : ∀ i ∈ F, f(i) ∈ ennreal
    intros i hi
    exact valuesF with i, (FI with i, hi)
  have vG : ∀ i ∈ F, g(i) ∈ ennreal
    intros i hi
    exact valuesG with i, (FI with i, hi)
  have lF : ∀ i ∈ F, EnnLe(f(i), g(i))
    intros i hi
    exact le with i, (FI with i, hi)
  have l1 := ennFiniteSum.mono_fun with finite, vF, vG, lF
  have l2 := ennTsum.upper with valuesG, finite, FI
  exact EnnLe.transitive with l1, l2

theorem EnnLe.top_eq (a : Set)
  requires le : EnnLe(ennTop, a)
  shows a = ennTop
proof
  obtain ⟨m1, m2, alt⟩ := le
  cases alt with t | fin
  . exact t
  . exfalso
    exact fin.left with rfl

theorem ennTsum.top_of_term (f I j : Set)
  requires values : ∀ i ∈ I, f(i) ∈ ennreal
  requires member : j ∈ I
  requires top : f(j) = ennTop
  shows ennTsum(f, I) = ennTop
proof
  have le := ennTsum.term_le with values, member
  rw top at le
  exact EnnLe.top_eq with le

theorem RealHasSum.add_real (f g h I S T : Set)
  requires valuesF : ∀ i ∈ I, f(i) ∈ ℝ
  requires valuesG : ∀ i ∈ I, g(i) ∈ ℝ
  requires sum : ∀ i ∈ I, h(i) = R[f(i) + g(i)]
  requires first : RealHasSum(f, I, S)
  requires second : RealHasSum(g, I, T)
  shows RealHasSum(h, I, R[S + T])
proof
  have top := realAdditiveGroup.topological
  have abelian := realAdditiveGroup.abelian
  obtain ⟨ab, c, m, o⟩ := realAdditiveGroup.parts
  have SR := RealHasSum.real with first
  have TR := RealHasSum.real with second
  have fvG : ∀ i ∈ I, f(i) ∈ Group.carrier(realAdditiveGroup)
    rw c
    exact valuesF
  have gvG : ∀ i ∈ I, g(i) ∈ Group.carrier(realAdditiveGroup)
    rw c
    exact valuesG
  have hsum : ∀ i ∈ I, h(i) = Group.mul(realAdditiveGroup)(f(i), g(i))
    intros i hi
    have fiR : Real(f(i)) by exact (valuesF with i, hi)
    have giR : Real(g(i)) by exact (valuesG with i, hi)
    have e := sum with i, hi
    rw [m, e]
    ring
  unfold RealHasSum at first
  unfold RealHasSum at second
  have s := HasSum.add at realAdditiveGroup, realLine, f, g, h, I, S, T with top, abelian, fvG, gvG, hsum, first, second
  have SR2 : Real(S) by exact SR
  have TR2 : Real(T) by exact TR
  have same : Group.mul(realAdditiveGroup)(S, T) = R[S + T]
    rw m
    ring
  rw same at s
  unfold RealHasSum
  exact s

theorem ennTsum.of_hasSum (f I S : Set)
  requires values : ∀ i ∈ I, f(i) ∈ ℝ
  requires nonneg : ∀ i ∈ I, realZero ≤ f(i)
  requires sum : RealHasSum(f, I, S)
  shows ennTsum(f, I) = S
proof
  have eq := ennTsum.eq_ennSum with values, nonneg
  have summable : RealSummable(f, I)
    have s2 := sum
    unfold RealHasSum at s2
    unfold RealSummable
    unfold SummableFamily
    exact ⟨S, s2.left, s2⟩
  have e2 := ennSum.of_summable with values, nonneg, summable
  have e3 := RealHasSum.tsum_eq with sum
  rw [eq, e2, e3]

theorem ennTsum.finite_parts (f I : Set)
  requires values : ∀ i ∈ I, f(i) ∈ ennreal
  requires finite : ennTsum(f, I) ≠ ennTop
  shows (∀ i ∈ I, f(i) ∈ ℝ ∧ realZero ≤ f(i)) ∧ RealHasSum(f, I, ennTsum(f, I))
proof
  have parts : ∀ i ∈ I, f(i) ∈ ℝ ∧ realZero ≤ f(i)
    intros i hi
    have fM := values with i, hi
    have nt : f(i) ≠ ennTop
      intro t
      have tt := ennTsum.top_of_term with values, hi, t
      exact finite with tt
    exact ennreal.finite with fM, nt
  have rv : ∀ i ∈ I, f(i) ∈ ℝ
    intros i hi
    exact (parts with i, hi).left
  have nn : ∀ i ∈ I, realZero ≤ f(i)
    intros i hi
    exact (parts with i, hi).right
  have eq := ennTsum.eq_ennSum with rv, nn
  have summable : RealSummable(f, I)
    by_contra ns
    have e := ennSum.of_not_summable with rv, nn, ns
    rw e at eq
    exact finite with eq
  have e2 := ennSum.of_summable with rv, nn, summable
  have s2 := summable
  unfold RealSummable at s2
  obtain ⟨S, SIn, sumS⟩ := s2
  have sumR : RealHasSum(f, I, S)
    unfold RealHasSum
    exact sumS
  have e3 := RealHasSum.tsum_eq with sumR
  rw [eq, e2, e3]
  exact ⟨parts, sumR⟩

theorem ennTsum.zero (h I : Set)
  requires zero : ∀ i ∈ I, h(i) = realZero
  shows ennTsum(h, I) = realZero
proof
  have top := realAdditiveGroup.topological
  have abelian := realAdditiveGroup.abelian
  obtain ⟨ab, c, m, o⟩ := realAdditiveGroup.parts
  have hz : ∀ i ∈ I, h(i) = Group.one(realAdditiveGroup)
    rw o
    exact zero
  have sumZ := HasSum.zero at realAdditiveGroup, realLine, h, I with top, abelian, hz
  rw o at sumZ
  have sumZR : RealHasSum(h, I, realZero)
    unfold RealHasSum
    exact sumZ
  have rv : ∀ i ∈ I, h(i) ∈ ℝ
    intros i hi
    rw zero with i, hi
    typecheck
  have nn : ∀ i ∈ I, realZero ≤ h(i)
    intros i hi
    rw zero with i, hi
    linarith
  exact ennTsum.of_hasSum with rv, nn, sumZR

theorem ennTsum.add (f g h I : Set)
  requires valuesF : ∀ i ∈ I, f(i) ∈ ennreal
  requires valuesG : ∀ i ∈ I, g(i) ∈ ennreal
  requires sum : ∀ i ∈ I, h(i) = ennAdd(f(i), g(i))
  shows ennTsum(h, I) = ennAdd(ennTsum(f, I), ennTsum(g, I))
proof
  have hM : ∀ i ∈ I, h(i) ∈ ennreal
    intros i hi
    rw sum with i, hi
    exact ennAdd.member with (valuesF with i, hi), (valuesG with i, hi)
  have leF : ∀ i ∈ I, EnnLe(f(i), h(i))
    intros i hi
    rw sum with i, hi
    exact EnnLe.self_add with (valuesF with i, hi), (valuesG with i, hi)
  have leG : ∀ i ∈ I, EnnLe(g(i), h(i))
    intros i hi
    have fM := valuesF with i, hi
    have gM := valuesG with i, hi
    rw sum with i, hi
    rw ennAdd.comm with fM, gM
    exact EnnLe.self_add with gM, fM
  have mf := ennTsum.mono with valuesF, hM, leF
  have mg := ennTsum.mono with valuesG, hM, leG
  by_cases tf : ennTsum(f, I) = ennTop
  . rw tf at mf
    have th := EnnLe.top_eq with mf
    rw [th, tf]
    rw ennAdd.top_left at ennTop, ennTsum(g, I) with rfl
  . by_cases tg : ennTsum(g, I) = ennTop
    . rw tg at mg
      have th := EnnLe.top_eq with mg
      rw [th, tg]
      rw ennAdd.top_right at ennTsum(f, I), ennTop with rfl
    . obtain ⟨pf, sf⟩ := ennTsum.finite_parts with valuesF, tf
      obtain ⟨pg, sg⟩ := ennTsum.finite_parts with valuesG, tg
      have rf : ∀ i ∈ I, f(i) ∈ ℝ
        intros i hi
        exact (pf with i, hi).left
      have rg : ∀ i ∈ I, g(i) ∈ ℝ
        intros i hi
        exact (pg with i, hi).left
      have hsum : ∀ i ∈ I, h(i) = R[f(i) + g(i)]
        intros i hi
        obtain ⟨a1, a2⟩ := pf with i, hi
        obtain ⟨b1, b2⟩ := pg with i, hi
        rw sum with i, hi
        exact ennAdd.finite with a1, b1, a2, b2
      have rh : ∀ i ∈ I, h(i) ∈ ℝ
        intros i hi
        obtain ⟨a1, a2⟩ := pf with i, hi
        obtain ⟨b1, b2⟩ := pg with i, hi
        have x : Real(f(i)) by exact a1
        have y : Real(g(i)) by exact b1
        rw hsum with i, hi
        typecheck
      have nh : ∀ i ∈ I, realZero ≤ h(i)
        intros i hi
        obtain ⟨a1, a2⟩ := pf with i, hi
        obtain ⟨b1, b2⟩ := pg with i, hi
        have x : Real(f(i)) by exact a1
        have y : Real(g(i)) by exact b1
        rw hsum with i, hi
        linarith
      have s := RealHasSum.add_real with rf, rg, hsum, sf, sg
      have e := ennTsum.of_hasSum with rh, nh, s
      have fM := ennTsum.member with valuesF
      have gM := ennTsum.member with valuesG
      obtain ⟨fR, fN⟩ := ennreal.finite with fM, tf
      obtain ⟨gR, gN⟩ := ennreal.finite with gM, tg
      rw e
      rw ennAdd.finite with fR, gR, fN, gN

theorem ennTsum.mul_left (f h I c : Set)
  requires values : ∀ i ∈ I, f(i) ∈ ennreal
  requires member : c ∈ ennreal
  requires product : ∀ i ∈ I, h(i) = ennMul(c, f(i))
  shows ennTsum(h, I) = ennMul(c, ennTsum(f, I))
proof
  have hM : ∀ i ∈ I, h(i) ∈ ennreal
    intros i hi
    rw product with i, hi
    exact ennMul.member with member, (values with i, hi)
  have fM := ennTsum.member with values
  by_cases cz : c = realZero
  . have hz : ∀ i ∈ I, h(i) = realZero
      intros i hi
      rw product with i, hi
      exact ennMul.zero_left with cz, (values with i, hi)
    rw ennTsum.zero with hz
    rw ennMul.zero_left with cz, fM
  . by_cases ex : ∃ j ∈ I, f(j) = ennTop
    . obtain ⟨j, hj, fj⟩ := ex
      have tf := ennTsum.top_of_term with values, hj, fj
      have hj2 : h(j) = ennTop
        rw product with j, hj
        exact ennMul.top_right with cz, fj
      have th := ennTsum.top_of_term with hM, hj, hj2
      rw [th, tf]
      rw ennMul.top_right with cz, rfl
    . have fin : ∀ i ∈ I, f(i) ∈ ℝ ∧ realZero ≤ f(i)
        intros i hi
        have nt : f(i) ≠ ennTop
          intro t
          exact ex with ⟨i, hi, t⟩
        exact ennreal.finite with (values with i, hi), nt
      have rf : ∀ i ∈ I, f(i) ∈ ℝ
        intros i hi
        exact (fin with i, hi).left
      have nf : ∀ i ∈ I, realZero ≤ f(i)
        intros i hi
        exact (fin with i, hi).right
      by_cases ct : c = ennTop
      . by_cases allZero : ∀ i ∈ I, f(i) = realZero
        . have hz : ∀ i ∈ I, h(i) = realZero
            intros i hi
            rw product with i, hi
            exact ennMul.zero_right with member, (allZero with i, hi)
          rw ennTsum.zero with hz
          rw ennTsum.zero with allZero
          rw ennMul.zero_right with member, rfl
        . have some : ∃ j ∈ I, f(j) ≠ realZero
            by_contra none
            apply allZero
            intros i hi
            by_contra ne
            exact none with ⟨i, hi, ne⟩
          obtain ⟨j, hj, fj⟩ := some
          have hj2 : h(j) = ennTop
            rw product with j, hj
            exact ennMul.top_left with ct, fj
          have th := ennTsum.top_of_term with hM, hj, hj2
          have le := ennTsum.term_le with values, hj
          have nz := EnnLe.nonzero with le, fj
          rw th
          rw ennMul.top_left with ct, nz
      . obtain ⟨cR, cN⟩ := ennreal.finite with member, ct
        have cReal : Real(c) by exact cR
        have hprod : ∀ i ∈ I, h(i) = R[c * f(i)]
          intros i hi
          rw product with i, hi
          exact ennMul.finite with cR, (rf with i, hi), cN, (nf with i, hi)
        have rh : ∀ i ∈ I, h(i) ∈ ℝ
          intros i hi
          have x : Real(f(i)) by exact (rf with i, hi)
          rw hprod with i, hi
          typecheck
        have nh : ∀ i ∈ I, realZero ≤ h(i)
          intros i hi
          have x : Real(f(i)) by exact (rf with i, hi)
          have y := nf with i, hi
          rw hprod with i, hi
          exact realMulValue.nonnegative at c, f(i) with cN, y
        have m := ennSum.mul_left at f, h, I, c with rf, nf, cN, hprod
        have eh := ennTsum.eq_ennSum with rh, nh
        have ef := ennTsum.eq_ennSum with rf, nf
        have sM := ennSum.member with rf, nf
        have em := ennMulReal.eq_ennMul with ⟨member, ct⟩, sM
        rw [eh, ef, m, em]

-- Reindexing along a bijection, and a subfamily.
theorem ennTsum.reindex (f e h I J : Set)
  requires values : ∀ j ∈ J, f(j) ∈ ennreal
  requires bijective : BijectiveBetween(e, I, J)
  requires composite : ∀ i ∈ I, h(i) = f(e(i))
  shows ennTsum(h, I) = ennTsum(f, J)
proof
  sorry

theorem ennTsum.subset_le (f I J : Set)
  requires values : ∀ i ∈ I, f(i) ∈ ennreal
  requires inside : J ⊆ I
  shows EnnLe(ennTsum(f, J), ennTsum(f, I))
proof
  have valuesJ : ∀ i ∈ J, f(i) ∈ ennreal
    intros i hi
    exact values with i, (inside with i, hi)
  have iM := ennTsum.member_helper with values
  apply ennTsum.least with valuesJ, iM
  intros F hF
  obtain ⟨FP, finite⟩ := finiteSubsets.membership.forward with hF
  have FJ := (powerset.membership_iff at F, J).forward with FP
  have FI := Subset.transitive with FJ, inside
  exact ennTsum.upper with values, finite, FI

-- A sum over a disjoint union.
theorem ennTsum.union (f I J : Set)
  requires values : ∀ i ∈ I ∪ J, f(i) ∈ ennreal
  requires disjoint : Disjoint(I, J)
  shows ennTsum(f, I ∪ J) = ennAdd(ennTsum(f, I), ennTsum(f, J))
proof
  sorry

-- Iterated sums over a product (Mathlib's ENNReal.tsum_prod and
-- ENNReal.tsum_comm).
theorem ennTsum.prod (f I J : Set)
  requires values : ∀ p ∈ I × J, f(p) ∈ ennreal
  shows ennTsum(f, I × J) =
    ennTsum(ennRowSums(f, I, J), I)
proof
  sorry

theorem ennSumsOf.apply (f I J i : Set)
  requires member : i ∈ I
  shows ennSumsOf(f, I, J)(i) = ennTsum(f(i), J)
proof
  have edge : (i, ennTsum(f(i), J)) ∈ ennSumsOf(f, I, J)
    apply ennSumsOf.membership.backward
    exact ⟨i, member, rfl⟩
  have pairs : ∀ p ∈ ennSumsOf(f, I, J), ∃ a, ∃ b, p = (a, b)
    intros p hp
    obtain ⟨k, hk, pEq⟩ := ennSumsOf.membership.forward with hp
    rw ← pEq
    exact ⟨k, ennTsum(f(k), J), rfl⟩
  have functional : ∀ a, ∀ b, ∀ c, (a, b) ∈ ennSumsOf(f, I, J) → (a, c) ∈ ennSumsOf(f, I, J) → b = c
    intros a b c hb hc
    obtain ⟨k, hk, bEq⟩ := ennSumsOf.membership.forward with hb
    obtain ⟨m, hm, cEq⟩ := ennSumsOf.membership.forward with hc
    obtain ⟨ka, bb⟩ := orderedPair.injective with bEq
    obtain ⟨ma, cc⟩ := orderedPair.injective with cEq
    rw [← bb, ← cc, ka, ← ma]
  exact pairGraph.apply with pairs, functional, edge

theorem ennColumnSums.apply (f I J j : Set)
  requires member : j ∈ J
  shows ennColumnSums(f, I, J)(j) = ennTsum(familyAt(f, I, j), I)
proof
  have edge : (j, ennTsum(familyAt(f, I, j), I)) ∈ ennColumnSums(f, I, J)
    apply ennColumnSums.membership.backward
    exact ⟨j, member, rfl⟩
  have pairs : ∀ p ∈ ennColumnSums(f, I, J), ∃ a, ∃ b, p = (a, b)
    intros p hp
    obtain ⟨k, hk, pEq⟩ := ennColumnSums.membership.forward with hp
    rw ← pEq
    exact ⟨k, ennTsum(familyAt(f, I, k), I), rfl⟩
  have functional : ∀ a, ∀ b, ∀ c, (a, b) ∈ ennColumnSums(f, I, J) → (a, c) ∈ ennColumnSums(f, I, J) → b = c
    intros a b c hb hc
    obtain ⟨k, hk, bEq⟩ := ennColumnSums.membership.forward with hb
    obtain ⟨m, hm, cEq⟩ := ennColumnSums.membership.forward with hc
    obtain ⟨ka, bb⟩ := orderedPair.injective with bEq
    obtain ⟨ma, cc⟩ := orderedPair.injective with cEq
    rw [← bb, ← cc, ka, ← ma]
  exact pairGraph.apply with pairs, functional, edge

def commSubfamilies (f I J : Set) : Set :=
  { F ∈ 𝒫(I) | ennFiniteSum(ennSumsOf(f, I, J), F) = ennTsum(ennColumnSums(f, F, J), J) }

-- Finite double sums in [0, ∞] can be taken in either order.
theorem ennTsum.comm_finite (f I J : Set)
  requires finiteI : Finite(I)
  requires values : ∀ i ∈ I, ∀ j ∈ J, f(i)(j) ∈ ennreal
  shows ennTsum(ennSumsOf(f, I, J), I) = ennTsum(ennColumnSums(f, I, J), J)
proof
  have rowM : ∀ i ∈ I, ennSumsOf(f, I, J)(i) ∈ ennreal
    intros i hi
    rw ennSumsOf.apply with hi
    exact ennTsum.member with (values with i, hi)
  have base : ∅ ∈ commSubfamilies(f, I, J)
    have eP : ∅ ∈ 𝒫(I)
      apply (powerset.membership_iff at ∅, I).backward
      intros x hx
      simp at hx
    apply commSubfamilies.membership.backward
    refine ⟨eP, ?_⟩
    rw ennFiniteSum.empty
    have z : ∀ j ∈ J, ennColumnSums(f, ∅, J)(j) = realZero
      intros j hj
      rw ennColumnSums.apply with hj
      have fe := Finite.empty
      have v : ∀ i ∈ ∅, familyAt(f, ∅, j)(i) ∈ ennreal
        intros i hi
        simp at hi
      rw ennTsum.finite with fe, v
      rw ennFiniteSum.empty
    rw ennTsum.zero with z
  have step : ∀ F ⊆ I, Finite(F) → ∀ a ∈ I, a ∉ F → F ∈ commSubfamilies(f, I, J) → F ∪ {a} ∈ commSubfamilies(f, I, J)
    intros F FI finite a aI aF FS
    obtain ⟨FP, eq⟩ := commSubfamilies.membership.forward with FS
    have UI : F ∪ {a} ⊆ I
      intros x hx
      have c := union2.membership.forward with hx
      cases c with xF | xa
      . exact FI with x, xF
      . simp at xa
        rw xa
        exact aI
    have UP := (powerset.membership_iff at F ∪ {a}, I).backward with UI
    apply commSubfamilies.membership.backward
    refine ⟨UP, ?_⟩
    have vU : ∀ i ∈ F ∪ {a}, ennSumsOf(f, I, J)(i) ∈ ennreal
      intros i hi
      exact rowM with i, (UI with i, hi)
    rw ennFiniteSum.insert with finite, vU, aF
    rw eq
    rw ennSumsOf.apply with aI
    have colF : ∀ j ∈ J, ennColumnSums(f, F, J)(j) ∈ ennreal
      intros j hj
      rw ennColumnSums.apply with hj
      have v : ∀ i ∈ F, familyAt(f, F, j)(i) ∈ ennreal
        intros i hi
        rw familyAt.apply with hi
        exact values with i, (FI with i, hi), j, hj
      exact ennTsum.member with v
    have va := values with a, aI
    have sum : ∀ j ∈ J, ennColumnSums(f, F ∪ {a}, J)(j) = ennAdd(ennColumnSums(f, F, J)(j), f(a)(j))
      intros j hj
      rw ennColumnSums.apply at f, F ∪ {a}, J, j with hj
      rw ennColumnSums.apply at f, F, J, j with hj
      have finU := Finite.union with finite, (Finite.singleton at a)
      have vU2 : ∀ i ∈ F ∪ {a}, familyAt(f, F ∪ {a}, j)(i) ∈ ennreal
        intros i hi
        rw familyAt.apply with hi
        exact values with i, (UI with i, hi), j, hj
      have vF2 : ∀ i ∈ F, familyAt(f, F, j)(i) ∈ ennreal
        intros i hi
        rw familyAt.apply with hi
        exact values with i, (FI with i, hi), j, hj
      have vF3 : ∀ i ∈ F, familyAt(f, F ∪ {a}, j)(i) ∈ ennreal
        intros i hi
        have iU : i ∈ F ∪ {a} by simp [hi]
        exact vU2 with i, iU
      rw ennTsum.finite with finU, vU2
      rw ennTsum.finite with finite, vF2
      rw ennFiniteSum.insert with finite, vU2, aF
      have agree : ∀ i ∈ F, familyAt(f, F ∪ {a}, j)(i) = familyAt(f, F, j)(i)
        intros i hi
        have iU : i ∈ F ∪ {a} by simp [hi]
        rw familyAt.apply with iU
        rw familyAt.apply with hi
      rw ennFiniteSum.congr with agree
      have aU : a ∈ F ∪ {a} by simp
      rw familyAt.apply with aU
    have add := ennTsum.add with colF, (va), sum
    rw add
  have all := Finite.induction at I, commSubfamilies(f, I, J) with base, step
  have refl : I ⊆ I
    intros x hx
    exact hx
  have m := all with I, refl, finiteI
  obtain ⟨IP, eq⟩ := commSubfamilies.membership.forward with m
  rw ennTsum.finite with finiteI, rowM
  exact eq

theorem tkGEnnTsum.comm_le (f I J : Set)
  requires values : ∀ i ∈ I, ∀ j ∈ J, f(i)(j) ∈ ennreal
  shows EnnLe(ennTsum(ennSumsOf(f, I, J), I), ennTsum(ennColumnSums(f, I, J), J))
proof
  have rowVals : ∀ i ∈ I, ∀ j ∈ J, f(i)(j) ∈ ennreal
    exact values
  have colFam : ∀ j ∈ J, ∀ i ∈ I, familyAt(f, I, j)(i) ∈ ennreal
    intros j hj i hi
    rw (familyAt.apply at f, I, j, i with hi)
    exact values with i, hi, j, hj
  have sVals : ∀ i ∈ I, ennSumsOf(f, I, J)(i) ∈ ennreal
    intros i hi
    rw (ennSumsOf.apply at f, I, J, i with hi)
    exact ennTsum.member with (values with i, hi)
  have cVals : ∀ j ∈ J, ennColumnSums(f, I, J)(j) ∈ ennreal
    intros j hj
    rw (ennColumnSums.apply at f, I, J, j with hj)
    exact ennTsum.member with (colFam with j, hj)
  have cm := ennTsum.member with cVals
  apply ennTsum.least with sVals, cm
  intros F hF
  obtain ⟨pF, finF⟩ := finiteSubsets.membership.forward with hF
  have FI := (powerset.membership_iff at F, I).forward with pF
  have valsF : ∀ i ∈ F, ∀ j ∈ J, f(i)(j) ∈ ennreal
    intros i hi j hj
    exact values with i, (FI with i, hi), j, hj
  have cf := ennTsum.comm_finite with finF, valsF
  have sFVals : ∀ i ∈ F, ennSumsOf(f, F, J)(i) ∈ ennreal
    intros i hi
    rw (ennSumsOf.apply at f, F, J, i with hi)
    exact ennTsum.member with (valsF with i, hi)
  have t1 := ennTsum.finite with finF, sFVals
  have c1 : ennFiniteSum(ennSumsOf(f, I, J), F) = ennFiniteSum(ennSumsOf(f, F, J), F)
    apply ennFiniteSum.congr
    intros i hi
    rw [(ennSumsOf.apply at f, I, J, i with (FI with i, hi)), (ennSumsOf.apply at f, F, J, i with hi)]
  rw [c1, ← t1, cf]
  have cFVals : ∀ j ∈ J, ennColumnSums(f, F, J)(j) ∈ ennreal
    intros j hj
    rw (ennColumnSums.apply at f, F, J, j with hj)
    apply ennTsum.member
    intros i hi
    rw (familyAt.apply at f, F, j, i with hi)
    exact valsF with i, hi, j, hj
  apply ennTsum.mono with cFVals, cVals
  intros j hj
  rw [(ennColumnSums.apply at f, F, J, j with hj), (ennColumnSums.apply at f, I, J, j with hj)]
  have c2 : ennTsum(familyAt(f, F, j), F) = ennTsum(familyAt(f, I, j), F)
    apply ennTsum.congr
    intros i hi
    rw [(familyAt.apply at f, F, j, i with hi), (familyAt.apply at f, I, j, i with (FI with i, hi))]
  rw c2
  exact ennTsum.subset_le with (colFam with j, hj), FI

def tkGTranspose (f I J : Set) : Set := { (j, familyAt(f, I, j)) | j ∈ J }

theorem tkGTranspose.apply (f I J j : Set)
  requires member : j ∈ J
  shows tkGTranspose(f, I, J)(j) = familyAt(f, I, j)
proof
  have edge : (j, familyAt(f, I, j)) ∈ tkGTranspose(f, I, J)
    apply tkGTranspose.membership.backward
    exact ⟨j, member, rfl⟩
  have pairs : ∀ p ∈ tkGTranspose(f, I, J), ∃ a, ∃ b, p = (a, b)
    intros p hp
    obtain ⟨k, hk, pEq⟩ := tkGTranspose.membership.forward with hp
    rw ← pEq
    exact ⟨k, familyAt(f, I, k), rfl⟩
  have functional : ∀ a, ∀ b, ∀ c, (a, b) ∈ tkGTranspose(f, I, J) → (a, c) ∈ tkGTranspose(f, I, J) → b = c
    intros a b c hb hc
    obtain ⟨k, hk, bEq⟩ := tkGTranspose.membership.forward with hb
    obtain ⟨m, hm, cEq⟩ := tkGTranspose.membership.forward with hc
    obtain ⟨ka, bb⟩ := orderedPair.injective with bEq
    obtain ⟨ma, cc⟩ := orderedPair.injective with cEq
    rw [← bb, ← cc, ka, ← ma]
  exact pairGraph.apply with pairs, functional, edge

theorem ennTsum.comm (f I J : Set)
  requires values : ∀ i ∈ I, ∀ j ∈ J, f(i)(j) ∈ ennreal
  shows ennTsum(ennSumsOf(f, I, J), I) = ennTsum(ennColumnSums(f, I, J), J)
proof
  have le1 := tkGEnnTsum.comm_le with values
  have tv : ∀ j ∈ J, ∀ i ∈ I, tkGTranspose(f, I, J)(j)(i) ∈ ennreal
    intros j hj i hi
    rw [(tkGTranspose.apply at f, I, J, j with hj), (familyAt.apply at f, I, j, i with hi)]
    exact values with i, hi, j, hj
  have le2 := tkGEnnTsum.comm_le with tv
  have e1 : ennTsum(ennSumsOf(tkGTranspose(f, I, J), J, I), J) = ennTsum(ennColumnSums(f, I, J), J)
    apply ennTsum.congr
    intros j hj
    rw [(ennSumsOf.apply at tkGTranspose(f, I, J), J, I, j with hj), (ennColumnSums.apply at f, I, J, j with hj), (tkGTranspose.apply at f, I, J, j with hj)]
  have e2 : ennTsum(ennColumnSums(tkGTranspose(f, I, J), J, I), I) = ennTsum(ennSumsOf(f, I, J), I)
    apply ennTsum.congr
    intros i hi
    rw [(ennColumnSums.apply at tkGTranspose(f, I, J), J, I, i with hi), (ennSumsOf.apply at f, I, J, i with hi)]
    apply ennTsum.congr
    intros j hj
    rw [(familyAt.apply at tkGTranspose(f, I, J), J, i, j with hj), (tkGTranspose.apply at f, I, J, j with hj), (familyAt.apply at f, I, j, i with hi)]
  rw [e1, e2] at le2
  exact EnnLe.antisymmetric with le1, le2

theorem ennPartialSums.apply (f n : Set)
  requires member : n ∈ ℕ
  shows ennPartialSums(f)(n) = ennFiniteSum(f, n)
proof
  have edge : (n, ennFiniteSum(f, n)) ∈ ennPartialSums(f)
    apply ennPartialSums.membership.backward
    exact ⟨n, member, rfl⟩
  have pairs : ∀ p ∈ ennPartialSums(f), ∃ a, ∃ b, p = (a, b)
    intros p hp
    obtain ⟨k, hk, pEq⟩ := ennPartialSums.membership.forward with hp
    rw ← pEq
    exact ⟨k, ennFiniteSum(f, k), rfl⟩
  have functional : ∀ a, ∀ b, ∀ c, (a, b) ∈ ennPartialSums(f) → (a, c) ∈ ennPartialSums(f) → b = c
    intros a b c hb hc
    obtain ⟨k, hk, bEq⟩ := ennPartialSums.membership.forward with hb
    obtain ⟨m, hm, cEq⟩ := ennPartialSums.membership.forward with hc
    obtain ⟨ka, bb⟩ := orderedPair.injective with bEq
    obtain ⟨ma, cc⟩ := orderedPair.injective with cEq
    rw [← bb, ← cc, ka, ← ma]
  exact pairGraph.apply with pairs, functional, edge

theorem natural.finite_subset (n : Set)
  requires member : n ∈ ℕ
  shows Finite(n) ∧ n ⊆ ℕ ∧ n ∈ finiteSubsets(ℕ)
proof
  have nN : Nat(n) by exact member
  have fin := Finite.natural at n
  have sub : n ⊆ ℕ
    intros i hi
    exact natural.member at n, i with hi
  have p := (powerset.membership_iff at n, ℕ).backward with sub
  have fs := finiteSubsets.membership.backward with ⟨p, fin⟩
  exact ⟨fin, sub, fs⟩

-- Over ℕ the sum is the supremum of the partial sums over {0, …, n − 1}.
theorem ennTsum.nat_eq_sup (f : Set)
  requires values : ∀ n ∈ ℕ, f(n) ∈ ennreal
  shows ennTsum(f, ℕ) = ennSupOn(ennPartialSums(f), ℕ)
proof
  have pM : ∀ n ∈ ℕ, ennFiniteSum(f, n) ∈ ennreal
    intros n hn
    obtain ⟨fin, sub, fs⟩ := natural.finite_subset with hn
    have vn : ∀ i ∈ n, f(i) ∈ ennreal
      intros i hi
      exact values with i, (sub with i, hi)
    exact ennFiniteSum.member with fin, vn
  have VM : valuesOn(ennPartialSums(f), ℕ) ⊆ ennreal
    intros a ha
    obtain ⟨n, hn, e⟩ := valuesOn.membership.forward with ha
    rw ← e
    rw ennPartialSums.apply with hn
    exact pM with n, hn
  obtain ⟨ub, least⟩ := ennSup.least_upper with VM
  have tM := ennTsum.member with values
  have sM := ub.left
  unfold ennSupOn
  have first : EnnLe(ennTsum(f, ℕ), ennSup(valuesOn(ennPartialSums(f), ℕ)))
    apply ennTsum.least with values, sM
    intros F hF
    obtain ⟨FP, finite⟩ := finiteSubsets.membership.forward with hF
    have FI := (powerset.membership_iff at F, ℕ).forward with FP
    obtain ⟨b, bN, bound⟩ := Finite.naturals_bounded with FI, finite
    have sbN : succ(b) ∈ ℕ by typecheck
    obtain ⟨fin, sub, fs⟩ := natural.finite_subset with sbN
    have vn : ∀ i ∈ succ(b), f(i) ∈ ennreal
      intros i hi
      exact values with i, (sub with i, hi)
    have FS : F ⊆ succ(b)
      intros y hy
      exact bound with y, hy
    have l1 := ennFiniteSum.mono_set with fin, FS, vn
    have inV : ennPartialSums(f)(succ(b)) ∈ valuesOn(ennPartialSums(f), ℕ) := valuesOn.membership.backward with ⟨succ(b), sbN, rfl⟩
    rw ennPartialSums.apply with sbN at inV
    have l2 := ub.right with ennFiniteSum(f, succ(b)), inV
    exact EnnLe.transitive with l1, l2
  have second : EnnLe(ennSup(valuesOn(ennPartialSums(f), ℕ)), ennTsum(f, ℕ))
    apply least
    unfold EnnUpperBound
    refine ⟨tM, ?_⟩
    intros a ha
    obtain ⟨n, hn, e⟩ := valuesOn.membership.forward with ha
    rw ← e
    rw ennPartialSums.apply with hn
    obtain ⟨fin, sub, fs⟩ := natural.finite_subset with hn
    exact ennTsum.upper with values, fin, sub
  exact EnnLe.antisymmetric with first, second

-- A finite sum is finite exactly when every term is (Mathlib's
-- ENNReal.tsum_ne_top for finite sets / ENNReal.tsum_coe_ne_top_iff_summable).
theorem ennTsum.finite_iff_summable (f I : Set)
  requires values : ∀ i ∈ I, f(i) ∈ ℝ
  requires nonneg : ∀ i ∈ I, realZero ≤ f(i)
  shows ennTsum(f, I) ≠ ennTop ↔ RealSummable(f, I)
proof
  have eq := ennTsum.eq_ennSum with values, nonneg
  rw eq
  constructor
  . intro nt
    by_contra ns
    have e := ennSum.of_not_summable with values, nonneg, ns
    exact nt with e
  . intro s
    have e := ennSum.of_summable with values, nonneg, s
    have s2 := s
    unfold RealSummable at s2
    obtain ⟨S, SIn, sum⟩ := s2
    have sumR : RealHasSum(f, I, S)
      unfold RealHasSum
      exact sum
    have teq := RealHasSum.tsum_eq with sumR
    have SR := RealHasSum.real with sumR
    rw e
    rw teq
    exact ennreal.not_top_of_real with SR

theorem tkGEnnLe.real_iff (a b : Set)
  requires realA : a ∈ ℝ
  requires realB : b ∈ ℝ
  requires nonnegA : realZero ≤ a
  requires nonnegB : realZero ≤ b
  shows EnnLe(a, b) ↔ (a:R) ≤ b
proof
  have ma := ennreal.of_real with realA, nonnegA
  have mb := ennreal.of_real with realB, nonnegB
  have na := ennreal.not_top_of_real with realA
  have nb := ennreal.not_top_of_real with realB
  constructor
  . intro le
    obtain ⟨_, _, c⟩ := le
    cases c with t | f
    . exfalso
      exact nb with t
    . exact f.right
  . intro le
    unfold EnnLe
    refine ⟨ma, mb, ?_⟩
    right
    exact ⟨na, le⟩

theorem tkGEnn.gt_measurable (f X t : Set)
  requires measurable : Measurable(f, X, ennMeasurableSpace)
  requires member : t ∈ ennreal
  shows MeasurableSet(X, ennGtSet(f, MeasurableSpace.carrier(X), t))
proof
  have sub : ennIoi(t) ⊆ ennreal
    intros a ha
    simp at ha
    exact ha.left
  have pw := (powerset.membership_iff at ennIoi(t), ennreal).backward with sub
  have ray : ennIoi(t) ∈ ennRays
    apply ennRays.membership.backward
    exact ⟨pw, t, member, rfl⟩
  have g := generatedSigma.generator with ray, sub
  have mS : MeasurableSet(ennMeasurableSpace, ennIoi(t))
    unfold MeasurableSet
    unfold ennMeasurableSpace
    unfold generatedSpace
    rw MeasurableSpace.mk.sets
    exact g
  have m := Measurable.preimage with measurable, mS
  have e : functionPreimage(f, MeasurableSpace.carrier(X), ennIoi(t)) = ennGtSet(f, MeasurableSpace.carrier(X), t)
    ext x
    constructor
    . intro h
      obtain ⟨xA, fxIn⟩ := functionPreimage.membership.forward with h
      obtain ⟨_, nle⟩ := ennIoi.membership.forward with fxIn
      exact ennGtSet.membership.backward with ⟨xA, nle⟩
    . intro h
      obtain ⟨xA, nle⟩ := ennGtSet.membership.forward with h
      have fx := Measurable.maps with measurable, xA
      rw ennMeasurableSpace.carrier at fx
      apply functionPreimage.membership.backward
      refine ⟨xA, ?_⟩
      exact ennIoi.membership.backward with ⟨fx, nle⟩
  rw e at m
  exact m

-- Mathlib's Measurable.ennreal_ofReal and measurable of a real map into
-- [0, ∞]: x ↦ ofReal(f(x)) is measurable.
theorem Measurable.enn_of_real (f h X : Set)
  requires measurable : Measurable(f, X, realMeasurableSpace)
  requires cast : ∀ x ∈ MeasurableSpace.carrier(X), h(x) = ennOfReal(f(x))
  shows Measurable(h, X, ennMeasurableSpace)
proof
  have mm := measurable
  obtain ⟨space, _⟩ := mm
  have maps : MapsInto(h, MeasurableSpace.carrier(X), ennreal)
    intros x xA
    have fx := Measurable.maps with measurable, xA
    rw realMeasurableSpace.carrier at fx
    have e := cast with x, xA
    rw e
    have m := ennOfReal.member at f(x)
    exact m.left
  have rays : ∀ t ∈ ennreal, MeasurableSet(X, ennGtSet(h, MeasurableSpace.carrier(X), t))
    intros t ht
    have c := ennreal.cases with ht
    cases c with top | fin
    . have e : ennGtSet(h, MeasurableSpace.carrier(X), t) = ∅
        ext x
        constructor
        . intro hx
          obtain ⟨xA, nle⟩ := ennGtSet.membership.forward with hx
          have hx2 := maps with x, xA
          have le := EnnLe.top with hx2
          rw ← top at le
          exfalso
          exact nle with le
        . intro hx
          simp at hx
      rw e
      exact MeasurableSet.empty with space
    . obtain ⟨tR, tnn⟩ := fin
      have tR2 : Real(t) by typecheck
      have m := MeasurableSet.real_lt_locus at X, f, t with measurable
      have e : realGtSet(f, MeasurableSpace.carrier(X), t) = ennGtSet(h, MeasurableSpace.carrier(X), t)
        ext x
        constructor
        . intro hx
          obtain ⟨xA, lt⟩ := realGtSet.membership.forward with hx
          have fx := Measurable.maps with measurable, xA
          rw realMeasurableSpace.carrier at fx
          have e2 := cast with x, xA
          have nn : realZero ≤ (f(x):R) by linarith
          have v := ennOfReal.of_nonneg at f(x) with nn
          apply ennGtSet.membership.backward
          refine ⟨xA, ?_⟩
          rw [e2, v]
          intro le
          have le2 := (tkGEnnLe.real_iff at f(x), t with fx, tR, nn, tnn).forward with le
          have l3 : (t:R) < (t:R) by linarith
          have l4 := realLess.characterization.forward with l3
          exact RealLess.irreflexive with l4
        . intro hx
          obtain ⟨xA, nle⟩ := ennGtSet.membership.forward with hx
          have fx := Measurable.maps with measurable, xA
          rw realMeasurableSpace.carrier at fx
          have e2 := cast with x, xA
          rw e2 at nle
          apply realGtSet.membership.backward
          refine ⟨xA, ?_⟩
          by_cases nn : realZero ≤ (f(x):R)
          . have v := ennOfReal.of_nonneg at f(x) with nn
            rw v at nle
            by_contra nlt
            have le : (f(x):R) ≤ t by linarith
            have le2 := (tkGEnnLe.real_iff at f(x), t with fx, tR, nn, tnn).backward with le
            exact nle with le2
          . have neg : (f(x):R) < realZero by linarith
            have v := ennOfReal.value_neg at f(x) with fx, neg
            rw v at nle
            exfalso
            exact nle with (EnnLe.zero at t with ht)
      rw ← e
      exact m
  exact Measurable.enn_of_rays with space, maps, rays

def tkGEnnLePieceSet (f A q : Set) : Set :=
  { x ∈ A | realZero ≤ rationalCut(q) ∧ EnnLe(f(x), rationalCut(q)) }
defgraph tkGEnnLePiece (f A : Set) (q ∈ ℚ) : 𝒫(A) := tkGEnnLePieceSet(f, A, q)
proof
  apply powerset.membership_iff.backward
  intros x hx
  have hx2 := tkGEnnLePieceSet.membership.forward with hx
  exact hx2.left

theorem tkGEnn.top_measurable (f X : Set)
  requires measurable : Measurable(f, X, ennMeasurableSpace)
  shows MeasurableSet(X, functionPreimage(f, MeasurableSpace.carrier(X), {ennTop}))
proof
  have mm := measurable
  obtain ⟨space, _⟩ := mm
  have qc := rationals.countable
  have all : ∀ q ∈ ℚ, MeasurableSet(X, tkGEnnLePiece(f, MeasurableSpace.carrier(X))(q))
    intros q hq
    have v := tkGEnnLePiece.value at f, MeasurableSpace.carrier(X), q with hq
    rw v
    have qR : rationalCut(q) ∈ ℝ
      have r := rationalCut.real at q with hq
      exact r
    by_cases nn : realZero ≤ rationalCut(q)
    . have qE := ennreal.of_real with qR, nn
      have e : tkGEnnLePieceSet(f, MeasurableSpace.carrier(X), q) = MeasurableSpace.carrier(X) ∖ ennGtSet(f, MeasurableSpace.carrier(X), rationalCut(q))
        ext x
        constructor
        . intro h
          obtain ⟨xA, _, le⟩ := tkGEnnLePieceSet.membership.forward with h
          constructor
          . exact xA
          . intro gt
            obtain ⟨_, nle⟩ := ennGtSet.membership.forward with gt
            exact nle with le
        . intro h
          obtain ⟨xA, ngt⟩ := h
          apply tkGEnnLePieceSet.membership.backward
          refine ⟨xA, nn, ?_⟩
          by_contra nle
          exact ngt with (ennGtSet.membership.backward with ⟨xA, nle⟩)
      rw e
      have g := tkGEnn.gt_measurable with measurable, qE
      exact MeasurableSet.compl with space, g
    . have e : tkGEnnLePieceSet(f, MeasurableSpace.carrier(X), q) = ∅
        ext x
        constructor
        . intro h
          obtain ⟨xA, z, _⟩ := tkGEnnLePieceSet.membership.forward with h
          exfalso
          exact nn with z
        . intro h
          simp at h
      rw e
      exact MeasurableSet.empty with space
  have u := MeasurableSet.indexed_union with space, qc, all
  have c := MeasurableSet.compl with space, u
  have e : MeasurableSpace.carrier(X) ∖ ⋃(valuesOn(tkGEnnLePiece(f, MeasurableSpace.carrier(X)), ℚ)) = functionPreimage(f, MeasurableSpace.carrier(X), {ennTop})
    ext x
    constructor
    . intro h
      obtain ⟨xA, notIn⟩ := h
      have fx := Measurable.maps with measurable, xA
      rw ennMeasurableSpace.carrier at fx
      apply functionPreimage.membership.backward
      refine ⟨xA, ?_⟩
      have cs := ennreal.cases with fx
      cases cs with top | fin
      . rw top
        simp
      . obtain ⟨fR, fnn⟩ := fin
        exfalso
        have l1 : (f(x):R) < R[f(x) + 1] by linarith
        obtain ⟨q, hq, q1, q2⟩ := rationalCut.between at f(x), R[f(x) + 1] with l1
        have qR : rationalCut(q) ∈ ℝ
          have r := rationalCut.real at q with hq
          exact r
        have qnn : realZero ≤ rationalCut(q) by linarith
        have le : (f(x):R) ≤ rationalCut(q) by linarith
        have le2 := (tkGEnnLe.real_iff at f(x), rationalCut(q) with fR, qR, fnn, qnn).backward with le
        have v := tkGEnnLePiece.value at f, MeasurableSpace.carrier(X), q with hq
        have mem : x ∈ tkGEnnLePiece(f, MeasurableSpace.carrier(X))(q)
          rw v
          exact tkGEnnLePieceSet.membership.backward with ⟨xA, qnn, le2⟩
        have inV : tkGEnnLePiece(f, MeasurableSpace.carrier(X))(q) ∈ valuesOn(tkGEnnLePiece(f, MeasurableSpace.carrier(X)), ℚ)
          exact valuesOn.membership.backward with ⟨q, hq, rfl⟩
        exact notIn with (union.contains with inV, mem)
    . intro h
      obtain ⟨xA, fxTop⟩ := functionPreimage.membership.forward with h
      simp at fxTop
      constructor
      . exact xA
      . intro hu
        obtain ⟨W, hW, xW⟩ := union.membership.forward with hu
        obtain ⟨q, hq, eq⟩ := hW
        have v := tkGEnnLePiece.value at f, MeasurableSpace.carrier(X), q with hq
        rw [← eq, v] at xW
        obtain ⟨_, _, le⟩ := tkGEnnLePieceSet.membership.forward with xW
        obtain ⟨_, _, cc⟩ := le
        have qR : rationalCut(q) ∈ ℝ
          have r := rationalCut.real at q with hq
          exact r
        have nt := ennreal.not_top_of_real with qR
        cases cc with t | fpart
        . exact nt with t
        . obtain ⟨ne, _⟩ := fpart
          exact ne with fxTop
  rw e at c
  exact c

theorem tkGEnn.to_real_nonneg (a : Set)
  requires member : a ∈ ennreal
  shows ennToReal(a) ∈ ℝ ∧ realZero ≤ ennToReal(a)
proof
  have cs := ennreal.cases with member
  cases cs with top | fin
  . rw [top, ennToReal.top]
    constructor
    . typecheck
    . have z : realZero ≤ realZero by linarith
      exact z
  . obtain ⟨aR, ann⟩ := fin
    have nt := ennreal.not_top_of_real with aR
    obtain ⟨v, _⟩ := ennToReal.of_finite with member, nt
    rw v
    exact ⟨aR, ann⟩

-- Mathlib's Measurable.ennreal_toReal.
theorem Measurable.enn_to_real (f h X : Set)
  requires measurable : Measurable(f, X, ennMeasurableSpace)
  requires cast : ∀ x ∈ MeasurableSpace.carrier(X), h(x) = ennToReal(f(x))
  shows Measurable(h, X, realMeasurableSpace)
proof
  have mm := measurable
  obtain ⟨space, _⟩ := mm
  have maps : MapsInto(h, MeasurableSpace.carrier(X), ℝ)
    intros x xA
    have fx := Measurable.maps with measurable, xA
    rw ennMeasurableSpace.carrier at fx
    have e := cast with x, xA
    rw e
    have nn := tkGEnn.to_real_nonneg with fx
    exact nn.left
  have rays : ∀ a ∈ ℝ, MeasurableSet(X, realGtSet(h, MeasurableSpace.carrier(X), a))
    intros a aR
    by_cases neg : (a:R) < realZero
    . have e : realGtSet(h, MeasurableSpace.carrier(X), a) = MeasurableSpace.carrier(X)
        ext x
        constructor
        . intro hx
          have hx2 := realGtSet.membership.forward with hx
          exact hx2.left
        . intro xA
          have fx := Measurable.maps with measurable, xA
          rw ennMeasurableSpace.carrier at fx
          have e2 := cast with x, xA
          obtain ⟨hR, hnn⟩ := tkGEnn.to_real_nonneg with fx
          apply realGtSet.membership.backward
          refine ⟨xA, ?_⟩
          rw e2
          linarith
      rw e
      exact MeasurableSet.univ with space
    . have ann : realZero ≤ (a:R) by linarith
      have aE := ennreal.of_real with aR, ann
      have g := tkGEnn.gt_measurable with measurable, aE
      have t := tkGEnn.top_measurable with measurable
      have d := MeasurableSet.diff with space, g, t
      have e : ennGtSet(f, MeasurableSpace.carrier(X), a) ∖ functionPreimage(f, MeasurableSpace.carrier(X), {ennTop}) = realGtSet(h, MeasurableSpace.carrier(X), a)
        ext x
        constructor
        . intro hx
          obtain ⟨g1, notTop⟩ := hx
          obtain ⟨xA, nle⟩ := ennGtSet.membership.forward with g1
          have fx := Measurable.maps with measurable, xA
          rw ennMeasurableSpace.carrier at fx
          have e2 := cast with x, xA
          have cs := ennreal.cases with fx
          cases cs with top | fin
          . exfalso
            apply notTop
            apply functionPreimage.membership.backward
            refine ⟨xA, ?_⟩
            rw top
            simp
          . obtain ⟨fR, fnn⟩ := fin
            have nt := ennreal.not_top_of_real with fR
            obtain ⟨v, _⟩ := ennToReal.of_finite with fx, nt
            apply realGtSet.membership.backward
            refine ⟨xA, ?_⟩
            rw [e2, v]
            by_contra nlt
            have le : (f(x):R) ≤ a by linarith
            have le2 := (tkGEnnLe.real_iff at f(x), a with fR, aR, fnn, ann).backward with le
            exact nle with le2
        . intro hx
          obtain ⟨xA, lt⟩ := realGtSet.membership.forward with hx
          have fx := Measurable.maps with measurable, xA
          rw ennMeasurableSpace.carrier at fx
          have e2 := cast with x, xA
          rw e2 at lt
          have cs := ennreal.cases with fx
          cases cs with top | fin
          . exfalso
            rw [top, ennToReal.top] at lt
            have l3 : (a:R) < (a:R) by linarith
            have l4 := realLess.characterization.forward with l3
            exact RealLess.irreflexive with l4
          . obtain ⟨fR, fnn⟩ := fin
            have nt := ennreal.not_top_of_real with fR
            obtain ⟨v, _⟩ := ennToReal.of_finite with fx, nt
            rw v at lt
            constructor
            . apply ennGtSet.membership.backward
              refine ⟨xA, ?_⟩
              intro le
              have le2 := (tkGEnnLe.real_iff at f(x), a with fR, aR, fnn, ann).forward with le
              have l3 : (a:R) < (a:R) by linarith
              have l4 := realLess.characterization.forward with l3
              exact RealLess.irreflexive with l4
            . intro inTop
              obtain ⟨_, ft⟩ := functionPreimage.membership.forward with inTop
              simp at ft
      rw e at d
      exact d
  exact Measurable.real_of_rays with space, maps, rays

def tkGToRealOn (f A : Set) : Set := { (x, ennToReal(f(x))) | x ∈ A }

theorem tkGToRealOn.apply (f A x : Set)
  requires member : x ∈ A
  shows tkGToRealOn(f, A)(x) = ennToReal(f(x))
proof
  have edge : (x, ennToReal(f(x))) ∈ tkGToRealOn(f, A)
    apply tkGToRealOn.membership.backward
    exact ⟨x, member, rfl⟩
  have pairs : ∀ p ∈ tkGToRealOn(f, A), ∃ a, ∃ b, p = (a, b)
    intros p hp
    obtain ⟨k, hk, pEq⟩ := tkGToRealOn.membership.forward with hp
    rw ← pEq
    exact ⟨k, ennToReal(f(k)), rfl⟩
  have functional : ∀ a, ∀ b, ∀ c, (a, b) ∈ tkGToRealOn(f, A) → (a, c) ∈ tkGToRealOn(f, A) → b = c
    intros a b c hb hc
    obtain ⟨k, hk, bEq⟩ := tkGToRealOn.membership.forward with hb
    obtain ⟨m, hm, cEq⟩ := tkGToRealOn.membership.forward with hc
    obtain ⟨ka, bb⟩ := orderedPair.injective with bEq
    obtain ⟨ma, cc⟩ := orderedPair.injective with cEq
    rw [← bb, ← cc, ka, ← ma]
  exact pairGraph.apply with pairs, functional, edge

theorem tkGEnnLe.top_not (t : Set)
  requires real : t ∈ ℝ
  shows ¬EnnLe(ennTop, t)
proof
  intro le
  obtain ⟨_, _, c⟩ := le
  have nt := ennreal.not_top_of_real with real
  cases c with t1 | t2
  . exact nt with t1
  . obtain ⟨ne, _⟩ := t2
    exact ne with rfl

theorem tkGEnn.zero_iff (a : Set)
  requires member : a ∈ ennreal
  shows EnnLe(a, realZero) ↔ a = realZero
proof
  have z := ennreal.zero_member
  constructor
  . intro le
    have le2 := EnnLe.zero with member
    exact EnnLe.antisymmetric with le, le2
  . intro e
    rw e
    exact EnnLe.reflexive with z

theorem Measurable.enn_mul (f g h X : Set)
  requires measurableF : Measurable(f, X, ennMeasurableSpace)
  requires measurableG : Measurable(g, X, ennMeasurableSpace)
  requires product : ∀ x ∈ MeasurableSpace.carrier(X), h(x) = ennMul(f(x), g(x))
  shows Measurable(h, X, ennMeasurableSpace)
proof
  have mm := measurableF
  obtain ⟨space, _⟩ := mm
  have z := ennreal.zero_member
  have maps : MapsInto(h, MeasurableSpace.carrier(X), ennreal)
    intros x xA
    have fx := Measurable.maps with measurableF, xA
    have gx := Measurable.maps with measurableG, xA
    rw ennMeasurableSpace.carrier at fx
    rw ennMeasurableSpace.carrier at gx
    have e := product with x, xA
    rw e
    exact ennMul.member with fx, gx
  have rf := Measurable.enn_to_real with measurableF, (tkGToRealOn.apply at f, MeasurableSpace.carrier(X))
  have rg := Measurable.enn_to_real with measurableG, (tkGToRealOn.apply at g, MeasurableSpace.carrier(X))
  have mp := Measurable.real_mul with rf, rg, (tkGMulOn.apply at tkGToRealOn(f, MeasurableSpace.carrier(X)), tkGToRealOn(g, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X))
  have tf := tkGEnn.top_measurable with measurableF
  have tg := tkGEnn.top_measurable with measurableG
  have tT := MeasurableSet.union with space, tf, tg
  have zf := tkGEnn.gt_measurable with measurableF, z
  have zg := tkGEnn.gt_measurable with measurableG, z
  have cf := MeasurableSet.compl with space, zf
  have cg := MeasurableSet.compl with space, zg
  have zZ := MeasurableSet.union with space, cf, cg
  have rays : ∀ t ∈ ennreal, MeasurableSet(X, ennGtSet(h, MeasurableSpace.carrier(X), t))
    intros t ht
    have c := ennreal.cases with ht
    cases c with top | fin
    . have e : ennGtSet(h, MeasurableSpace.carrier(X), t) = ∅
        ext x
        constructor
        . intro hx
          obtain ⟨xA, nle⟩ := ennGtSet.membership.forward with hx
          have hx2 := maps with x, xA
          have le := EnnLe.top with hx2
          rw ← top at le
          exfalso
          exact nle with le
        . intro hx
          simp at hx
      rw e
      exact MeasurableSet.empty with space
    . obtain ⟨tR, tnn⟩ := fin
      have tR2 : Real(t) by typecheck
      have gt := MeasurableSet.real_lt_locus at X, tkGMulOn(tkGToRealOn(f, MeasurableSpace.carrier(X)), tkGToRealOn(g, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X)), t with mp
      have ct := MeasurableSet.compl with space, tT
      have m1 := MeasurableSet.inter with space, ct, gt
      have m2 := MeasurableSet.diff with space, tT, zZ
      have m := MeasurableSet.union with space, m1, m2
      have e : ((MeasurableSpace.carrier(X) ∖ (functionPreimage(f, MeasurableSpace.carrier(X), {ennTop}) ∪ functionPreimage(g, MeasurableSpace.carrier(X), {ennTop}))) ∩ realGtSet(tkGMulOn(tkGToRealOn(f, MeasurableSpace.carrier(X)), tkGToRealOn(g, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X), t)) ∪ ((functionPreimage(f, MeasurableSpace.carrier(X), {ennTop}) ∪ functionPreimage(g, MeasurableSpace.carrier(X), {ennTop})) ∖ ((MeasurableSpace.carrier(X) ∖ ennGtSet(f, MeasurableSpace.carrier(X), realZero)) ∪ (MeasurableSpace.carrier(X) ∖ ennGtSet(g, MeasurableSpace.carrier(X), realZero)))) = ennGtSet(h, MeasurableSpace.carrier(X), t)
        ext x
        constructor
        . intro hx
          have hx1 := union2.membership.forward with hx
          cases hx1 with left | right
          . obtain ⟨notT, gtx⟩ := left
            obtain ⟨xA, nT⟩ := notT
            obtain ⟨_, lt⟩ := realGtSet.membership.forward with gtx
            have fx := Measurable.maps with measurableF, xA
            have gx := Measurable.maps with measurableG, xA
            rw ennMeasurableSpace.carrier at fx
            rw ennMeasurableSpace.carrier at gx
            have fnt : f(x) ≠ ennTop
              intro ft
              apply nT
              apply union2.membership.backward
              left
              apply functionPreimage.membership.backward
              refine ⟨xA, ?_⟩
              rw ft
              simp
            have gnt : g(x) ≠ ennTop
              intro gt2
              apply nT
              apply union2.membership.backward
              right
              apply functionPreimage.membership.backward
              refine ⟨xA, ?_⟩
              rw gt2
              simp
            obtain ⟨fR, fnn⟩ := ennreal.finite with fx, fnt
            obtain ⟨gR, gnn⟩ := ennreal.finite with gx, gnt
            obtain ⟨vf, _⟩ := ennToReal.of_finite with fx, fnt
            obtain ⟨vg, _⟩ := ennToReal.of_finite with gx, gnt
            have a1 := tkGMulOn.apply at tkGToRealOn(f, MeasurableSpace.carrier(X)), tkGToRealOn(g, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X), x with xA
            have a2 := tkGToRealOn.apply at f, MeasurableSpace.carrier(X), x with xA
            have a3 := tkGToRealOn.apply at g, MeasurableSpace.carrier(X), x with xA
            rw [a1, a2, a3, vf, vg] at lt
            have e2 := product with x, xA
            have v := ennMul.finite with fR, gR, fnn, gnn
            have pR : R[f(x) * g(x)] ∈ ℝ by typecheck
            have pnn : realZero ≤ R[f(x) * g(x)]
              have pp := realMulValue.nonnegative at f(x), g(x) with fnn, gnn
              exact pp
            apply ennGtSet.membership.backward
            refine ⟨xA, ?_⟩
            rw [e2, v]
            intro le
            have le2 := (tkGEnnLe.real_iff at R[f(x) * g(x)], t with pR, tR, pnn, tnn).forward with le
            have l3 : (t:R) < (t:R) by linarith
            have l4 := realLess.characterization.forward with l3
            exact RealLess.irreflexive with l4
          . obtain ⟨inT, notZ⟩ := right
            have xA : x ∈ MeasurableSpace.carrier(X)
              have i1 := union2.membership.forward with inT
              cases i1 with a | b
              . have a2 := functionPreimage.membership.forward with a
                exact a2.left
              . have b2 := functionPreimage.membership.forward with b
                exact b2.left
            have fx := Measurable.maps with measurableF, xA
            have gx := Measurable.maps with measurableG, xA
            rw ennMeasurableSpace.carrier at fx
            rw ennMeasurableSpace.carrier at gx
            have fnz : f(x) ≠ realZero
              intro fz
              apply notZ
              apply union2.membership.backward
              left
              constructor
              . exact xA
              . intro gtf
                obtain ⟨_, nle⟩ := ennGtSet.membership.forward with gtf
                apply nle
                exact (tkGEnn.zero_iff with fx).backward with fz
            have gnz : g(x) ≠ realZero
              intro gz
              apply notZ
              apply union2.membership.backward
              right
              constructor
              . exact xA
              . intro gtg
                obtain ⟨_, nle⟩ := ennGtSet.membership.forward with gtg
                apply nle
                exact (tkGEnn.zero_iff with gx).backward with gz
            have hTop : h(x) = ennTop
              have e2 := product with x, xA
              rw e2
              have i1 := union2.membership.forward with inT
              cases i1 with a | b
              . obtain ⟨_, ft⟩ := functionPreimage.membership.forward with a
                simp at ft
                exact ennMul.top_left with ft, gnz
              . obtain ⟨_, gt2⟩ := functionPreimage.membership.forward with b
                simp at gt2
                exact ennMul.top_right with fnz, gt2
            apply ennGtSet.membership.backward
            refine ⟨xA, ?_⟩
            rw hTop
            exact tkGEnnLe.top_not with tR
        . intro hx
          obtain ⟨xA, nle⟩ := ennGtSet.membership.forward with hx
          have fx := Measurable.maps with measurableF, xA
          have gx := Measurable.maps with measurableG, xA
          rw ennMeasurableSpace.carrier at fx
          rw ennMeasurableSpace.carrier at gx
          have e2 := product with x, xA
          rw e2 at nle
          apply union2.membership.backward
          by_cases fz : f(x) = realZero
          . exfalso
            have v := ennMul.zero_left with fz, gx
            rw v at nle
            exact nle with (EnnLe.zero with ht)
          . by_cases gz : g(x) = realZero
            . exfalso
              have v := ennMul.zero_right with fx, gz
              rw v at nle
              exact nle with (EnnLe.zero with ht)
            . have notZ : x ∉ (MeasurableSpace.carrier(X) ∖ ennGtSet(f, MeasurableSpace.carrier(X), realZero)) ∪ (MeasurableSpace.carrier(X) ∖ ennGtSet(g, MeasurableSpace.carrier(X), realZero))
                intro inZ
                have i1 := union2.membership.forward with inZ
                cases i1 with a | b
                . obtain ⟨_, ng⟩ := a
                  apply ng
                  apply ennGtSet.membership.backward
                  refine ⟨xA, ?_⟩
                  intro le
                  exact fz with ((tkGEnn.zero_iff with fx).forward with le)
                . obtain ⟨_, ng⟩ := b
                  apply ng
                  apply ennGtSet.membership.backward
                  refine ⟨xA, ?_⟩
                  intro le
                  exact gz with ((tkGEnn.zero_iff with gx).forward with le)
              by_cases ft : f(x) = ennTop
              . right
                constructor
                . apply union2.membership.backward
                  left
                  apply functionPreimage.membership.backward
                  refine ⟨xA, ?_⟩
                  rw ft
                  simp
                . exact notZ
              . by_cases gt2 : g(x) = ennTop
                . right
                  constructor
                  . apply union2.membership.backward
                    right
                    apply functionPreimage.membership.backward
                    refine ⟨xA, ?_⟩
                    rw gt2
                    simp
                  . exact notZ
                . left
                  obtain ⟨fR, fnn⟩ := ennreal.finite with fx, ft
                  obtain ⟨gR, gnn⟩ := ennreal.finite with gx, gt2
                  obtain ⟨vf, _⟩ := ennToReal.of_finite with fx, ft
                  obtain ⟨vg, _⟩ := ennToReal.of_finite with gx, gt2
                  have v := ennMul.finite with fR, gR, fnn, gnn
                  rw v at nle
                  have pR : R[f(x) * g(x)] ∈ ℝ by typecheck
                  have pnn : realZero ≤ R[f(x) * g(x)]
                    have pp := realMulValue.nonnegative at f(x), g(x) with fnn, gnn
                    exact pp
                  constructor
                  . constructor
                    . exact xA
                    . intro inT
                      have i1 := union2.membership.forward with inT
                      cases i1 with a | b
                      . obtain ⟨_, fta⟩ := functionPreimage.membership.forward with a
                        simp at fta
                      . obtain ⟨_, gtb⟩ := functionPreimage.membership.forward with b
                        simp at gtb
                  . have a1 := tkGMulOn.apply at tkGToRealOn(f, MeasurableSpace.carrier(X)), tkGToRealOn(g, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X), x with xA
                    have a2 := tkGToRealOn.apply at f, MeasurableSpace.carrier(X), x with xA
                    have a3 := tkGToRealOn.apply at g, MeasurableSpace.carrier(X), x with xA
                    apply realGtSet.membership.backward
                    refine ⟨xA, ?_⟩
                    rw [a1, a2, a3, vf, vg]
                    by_contra nlt
                    have le : R[f(x) * g(x)] ≤ (t:R) by linarith
                    have le2 := (tkGEnnLe.real_iff at R[f(x) * g(x)], t with pR, tR, pnn, tnn).backward with le
                    exact nle with le2
      rw e at m
      exact m
  exact Measurable.enn_of_rays with space, maps, rays

end MeasurableSpaces
