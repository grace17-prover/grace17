-- Product measures, Tonelli and Fubini: the product of two measures on
-- the product σ-algebra, defined by integrating the measures of the
-- sections, (μ × ν)(E) = ∫⁻ ν(E_x) dμ(x) (Mathlib's Measure.prod), with
-- its value on rectangles, its uniqueness, symmetry, associativity and
-- restrictions; null sets of a product; Tonelli's theorem for the lower
-- integral and Fubini's theorem for integrable complex maps, with the
-- integrability criterion; products of functions of separate variables;
-- Lebesgue measure on ℝⁿ⁺¹ and ℝᵐ⁺ⁿ as products, finite products of
-- one-variable integrands, and Lebesgue measure on ℂ = ℝ × ℝ.
-- Part of the GRH blueprint.
-- Planned home: MeasureTheory/Measure/Prod and MeasureTheory/Integral/Prod.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Measure.Product
import GRH.Measure.Bochner

section ProductMeasures
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- Section: Definitions
-- The sections E_x = {y ∈ B | (x, y) ∈ E} and E^y = {x ∈ A | (x, y) ∈ E}.
def sectionAt (E x B : Set) : Set := { y ∈ B | (x, y) ∈ E }
def sectionAtSecond (E y A : Set) : Set := { x ∈ A | (x, y) ∈ E }

-- x ↦ ν(E_x) on A, and y ↦ μ(E^y) on B.
def sectionMeasures (ν E A B : Set) : Set := { (x, ν(sectionAt(E, x, B))) | x ∈ A }
def sectionMeasuresSecond (μ E A B : Set) : Set :=
  { (y, μ(sectionAtSecond(E, y, A))) | y ∈ B }

-- The product measure (Mathlib's Measure.prod μ ν).
def productMeasure (X μ Y ν : Set) : Set :=
  { (E, lintegral(X, μ, sectionMeasures(ν, E, MeasurableSpace.carrier(X),
      MeasurableSpace.carrier(Y)))) |
    E ∈ MeasurableSpace.sets(productMeasurableSpace(X, Y)) }

-- The partial maps y ↦ f(x, y) and x ↦ f(x, y).
def curryAt (f x B : Set) : Set := { (y, f((x, y))) | y ∈ B }
def curryAtSecond (f y A : Set) : Set := { (x, f((x, y))) | x ∈ A }

-- The inner integrals x ↦ ∫⁻ f(x, y) dν(y) and y ↦ ∫⁻ f(x, y) dμ(x), and
-- their complex counterparts.
def innerLIntegrals (Y ν f A : Set) : Set :=
  { (x, lintegral(Y, ν, curryAt(f, x, MeasurableSpace.carrier(Y)))) | x ∈ A }
def innerLIntegralsSecond (X μ f B : Set) : Set :=
  { (y, lintegral(X, μ, curryAtSecond(f, y, MeasurableSpace.carrier(X)))) | y ∈ B }
def innerIntegrals (Y ν f A : Set) : Set :=
  { (x, complexMeasureIntegral(Y, ν, curryAt(f, x, MeasurableSpace.carrier(Y)))) | x ∈ A }
def innerIntegralsSecond (X μ f B : Set) : Set :=
  { (y, complexMeasureIntegral(X, μ, curryAtSecond(f, y, MeasurableSpace.carrier(X)))) |
    y ∈ B }
def innerAbsIntegrals (Y ν f A : Set) : Set :=
  { (x, realMeasureIntegral(Y, ν,
      complexAbsOn(curryAt(f, x, MeasurableSpace.carrier(Y)), MeasurableSpace.carrier(Y)))) |
    x ∈ A }

-- The points x whose section of f is integrable.
def integrableSections (Y ν f A : Set) : Set :=
  { x ∈ A | ComplexIntegrable(Y, ν, curryAt(f, x, MeasurableSpace.carrier(Y))) }

-- The points x whose section of E is null.
def nullSections (Y ν E A : Set) : Set :=
  { x ∈ A | ν(sectionAt(E, x, MeasurableSpace.carrier(Y))) = realZero }

-- The points x whose section of S holds almost everywhere.
def aeSections (Y ν S A : Set) : Set :=
  { x ∈ A | AlmostEverywhere(Y, ν, sectionAt(S, x, MeasurableSpace.carrier(Y))) }

-- The swap (x, y) ↦ (y, x), the reassociation ((x, y), z) ↦ (x, (y, z)),
-- and x ↦ (x, b).
def swapMap (A B : Set) : Set := { (p, (snd(p), fst(p))) | p ∈ A × B }
def assocMap (A B C : Set) : Set :=
  { (p, (fst(fst(p)), (snd(fst(p)), snd(p)))) | p ∈ (A × B) × C }
def pairRight (A b : Set) : Set := { (x, (x, b)) | x ∈ A }

-- (x, y) ↦ f(x) g(y), in ℂ and in [0, ∞].
def complexTensorOn (f g A B : Set) : Set := { (p, ℂ[f(fst(p)) * g(snd(p))]) | p ∈ A × B }
def ennTensorOn (f g A B : Set) : Set := { (p, ennMul(f(fst(p)), g(snd(p)))) | p ∈ A × B }

-- ℝⁿ⁺¹ = ℝⁿ × ℝ: x ↦ (x restricted to n, x(n)); and ℝᵐ⁺ⁿ = ℝᵐ × ℝⁿ:
-- x ↦ (x on m, i ↦ x(m + i)) (Mathlib's piFinSuccAbove and
-- sumPiEquivProdPi).
def vectorInit (x n : Set) : Set := { p ∈ x | fst(p) ∈ n }
def splitLast (n : Nat) : Set :=
  { (x, (vectorInit(x, n), x(n))) | x ∈ functionSpace(succ(n), ℝ) }
def vectorShift (x : Set, m n : Nat) : Set :=
  { p ∈ n × ℝ | ∃ i ∈ ℕ, fst(p) = i ∧ snd(p) = x(m + i) }
def splitBlocks (m n : Nat) : Set :=
  { (x, (vectorInit(x, m), vectorShift(x, m, n))) | x ∈ functionSpace(m + n, ℝ) }

-- The product ∏ᵢ f(i)(x(i)) of one-variable complex maps, on ℝⁿ.
def complexFiniteProduct (F w : Set) : Set :=
  finiteRingProduct(F, complexCarrier, complexAdd, complexZero, complexNeg, complexMul,
    complexOne, w)
def coordinateFactors (f n x : Set) : Set := { (i, f(i)(x(i))) | i ∈ n }
def productIntegrand (f : Set, n : Nat) : Set :=
  { (x, complexFiniteProduct(n, coordinateFactors(f, n, x))) | x ∈ functionSpace(n, ℝ) }
def factorIntegrals (f n : Set) : Set :=
  { (i, complexMeasureIntegral(realMeasurableSpace, realVolume, f(i))) | i ∈ n }

-- Lebesgue measure on ℂ = ℝ × ℝ, the product of Lebesgue measure on the
-- two coordinates (Mathlib's Complex.volume_preserving_equiv_real_prod),
-- and the map z ↦ (re z, im z) into ℝ² (Complex.volume_preserving_equiv_pi).
def complexVolume : Set :=
  productMeasure(realMeasurableSpace, realVolume, realMeasurableSpace, realVolume)
def complexToVector : Set := { (z, {(∅, fst(z)), ({∅}, snd(z))}) | z ∈ complexCarrier }
def complexTranslation (c : Set) : Set := { (z, ℂ[c + z]) | z ∈ complexCarrier }

-- The open disc of radius r about c in ℂ.
def complexDisc (c : Set, r : Real) : Set :=
  { z ∈ complexCarrier | complexAbs(ℂ[z - c]) < r }

-- Section: Product σ-algebras
theorem productMeasurableSpace.space (X Y : Set)
  requires spaceX : MeasurableSpace(X)
  requires spaceY : MeasurableSpace(Y)
  shows MeasurableSpace(productMeasurableSpace(X, Y)) ∧
    MeasurableSpace.carrier(productMeasurableSpace(X, Y)) =
      MeasurableSpace.carrier(X) × MeasurableSpace.carrier(Y)
proof
  sorry

theorem rectangles.pi_system (X Y : Set)
  requires spaceX : MeasurableSpace(X)
  requires spaceY : MeasurableSpace(Y)
  shows PiSystem(rectangles(X, Y))
proof
  sorry

theorem MeasurableSet.rectangle (X Y S T : Set)
  requires setS : MeasurableSet(X, S)
  requires setT : MeasurableSet(Y, T)
  requires spaceX : MeasurableSpace(X)
  requires spaceY : MeasurableSpace(Y)
  shows MeasurableSet(productMeasurableSpace(X, Y), S × T)
proof
  sorry

-- Sections of measurable sets are measurable (Mathlib's
-- measurable_prodMk_left).
theorem MeasurableSet.section (X Y E x : Set)
  requires spaceX : MeasurableSpace(X)
  requires spaceY : MeasurableSpace(Y)
  requires set : MeasurableSet(productMeasurableSpace(X, Y), E)
  requires member : x ∈ MeasurableSpace.carrier(X)
  shows MeasurableSet(Y, sectionAt(E, x, MeasurableSpace.carrier(Y)))
proof
  sorry

theorem Measurable.curry (X Y Z f x : Set)
  requires measurable : Measurable(f, productMeasurableSpace(X, Y), Z)
  requires member : x ∈ MeasurableSpace.carrier(X)
  shows Measurable(curryAt(f, x, MeasurableSpace.carrier(Y)), Y, Z)
proof
  sorry

-- Mathlib's measurable_measure_prodMk_left: x ↦ ν(E_x) is measurable for
-- an s-finite ν.
theorem Measurable.section_measures (X Y ν E : Set)
  requires spaceX : MeasurableSpace(X)
  requires finite : SFinite(Y, ν)
  requires set : MeasurableSet(productMeasurableSpace(X, Y), E)
  shows Measurable(sectionMeasures(ν, E, MeasurableSpace.carrier(X),
    MeasurableSpace.carrier(Y)), X, ennMeasurableSpace)
proof
  sorry

-- Mathlib's Measurable.lintegral_prod_right': x ↦ ∫⁻ f(x, y) dν is
-- measurable.
theorem Measurable.inner_lintegrals (X Y ν f : Set)
  requires spaceX : MeasurableSpace(X)
  requires finite : SFinite(Y, ν)
  requires measurable : Measurable(f, productMeasurableSpace(X, Y), ennMeasurableSpace)
  shows Measurable(innerLIntegrals(Y, ν, f, MeasurableSpace.carrier(X)), X, ennMeasurableSpace)
proof
  sorry

-- Section: Product measures
theorem productMeasure.measure (X μ Y ν : Set)
  requires first : SFinite(X, μ)
  requires second : SFinite(Y, ν)
  shows Measure(productMeasurableSpace(X, Y), productMeasure(X, μ, Y, ν))
proof
  sorry

-- Mathlib's Measure.prod_prod.
theorem productMeasure.rectangle (X μ Y ν S T : Set)
  requires first : SFinite(X, μ)
  requires second : SFinite(Y, ν)
  requires setS : MeasurableSet(X, S)
  requires setT : MeasurableSet(Y, T)
  shows productMeasure(X, μ, Y, ν)(S × T) = ennMul(μ(S), ν(T))
proof
  sorry

-- Mathlib's Measure.prod_apply and Measure.prod_apply_symm.
theorem productMeasure.apply (X μ Y ν E : Set)
  requires first : SFinite(X, μ)
  requires second : SFinite(Y, ν)
  requires set : MeasurableSet(productMeasurableSpace(X, Y), E)
  shows productMeasure(X, μ, Y, ν)(E) =
    lintegral(X, μ, sectionMeasures(ν, E, MeasurableSpace.carrier(X),
      MeasurableSpace.carrier(Y)))
proof
  sorry

theorem productMeasure.apply_symm (X μ Y ν E : Set)
  requires first : SFinite(X, μ)
  requires second : SFinite(Y, ν)
  requires set : MeasurableSet(productMeasurableSpace(X, Y), E)
  shows productMeasure(X, μ, Y, ν)(E) =
    lintegral(Y, ν, sectionMeasuresSecond(μ, E, MeasurableSpace.carrier(X),
      MeasurableSpace.carrier(Y)))
proof
  sorry

-- Uniqueness: a measure agreeing with μ × ν on rectangles is μ × ν, for
-- σ-finite μ and ν (Mathlib's Measure.prod_eq).
theorem productMeasure.unique (X μ Y ν ρ : Set)
  requires first : SigmaFinite(X, μ)
  requires second : SigmaFinite(Y, ν)
  requires measure : Measure(productMeasurableSpace(X, Y), ρ)
  requires rectangles : ∀ S ∈ MeasurableSpace.sets(X), ∀ T ∈ MeasurableSpace.sets(Y),
    ρ(S × T) = ennMul(μ(S), ν(T))
  shows ρ = productMeasure(X, μ, Y, ν)
proof
  sorry

theorem productMeasure.sigma_finite (X μ Y ν : Set)
  requires first : SigmaFinite(X, μ)
  requires second : SigmaFinite(Y, ν)
  shows SigmaFinite(productMeasurableSpace(X, Y), productMeasure(X, μ, Y, ν))
proof
  sorry

theorem productMeasure.s_finite (X μ Y ν : Set)
  requires first : SFinite(X, μ)
  requires second : SFinite(Y, ν)
  shows SFinite(productMeasurableSpace(X, Y), productMeasure(X, μ, Y, ν))
proof
  sorry

-- Mathlib's Measure.prod_swap and Measure.measurePreserving_swap.
theorem productMeasure.swap (X μ Y ν : Set)
  requires first : SFinite(X, μ)
  requires second : SFinite(Y, ν)
  shows MeasurePreserving(swapMap(MeasurableSpace.carrier(X), MeasurableSpace.carrier(Y)),
    productMeasurableSpace(X, Y), productMeasure(X, μ, Y, ν),
    productMeasurableSpace(Y, X), productMeasure(Y, ν, X, μ))
proof
  sorry

-- Mathlib's measurePreserving_prodAssoc.
theorem productMeasure.assoc (X μ Y ν Z ρ : Set)
  requires first : SFinite(X, μ)
  requires second : SFinite(Y, ν)
  requires third : SFinite(Z, ρ)
  shows MeasurePreserving(assocMap(MeasurableSpace.carrier(X), MeasurableSpace.carrier(Y),
      MeasurableSpace.carrier(Z)),
    productMeasurableSpace(productMeasurableSpace(X, Y), Z),
    productMeasure(productMeasurableSpace(X, Y), productMeasure(X, μ, Y, ν), Z, ρ),
    productMeasurableSpace(X, productMeasurableSpace(Y, Z)),
    productMeasure(X, μ, productMeasurableSpace(Y, Z), productMeasure(Y, ν, Z, ρ)))
proof
  sorry

-- Mathlib's Measure.prod_restrict.
theorem productMeasure.restrict (X μ Y ν S T : Set)
  requires first : SFinite(X, μ)
  requires second : SFinite(Y, ν)
  requires setS : MeasurableSet(X, S)
  requires setT : MeasurableSet(Y, T)
  shows productMeasure(X, restrictMeasure(X, μ, S), Y, restrictMeasure(Y, ν, T)) =
    restrictMeasure(productMeasurableSpace(X, Y), productMeasure(X, μ, Y, ν), S × T)
proof
  sorry

-- Mathlib's Measure.prod_dirac.
theorem productMeasure.dirac (X μ Y b : Set)
  requires first : SFinite(X, μ)
  requires spaceY : MeasurableSpace(Y)
  requires member : b ∈ MeasurableSpace.carrier(Y)
  shows productMeasure(X, μ, Y, diracMeasure(Y, b)) =
    mapMeasure(pairRight(MeasurableSpace.carrier(X), b), X, μ, productMeasurableSpace(X, Y))
proof
  sorry

-- Mathlib's Measure.prod_smul_left and prod_smul_right.
theorem productMeasure.smul (X μ Y ν c : Set)
  requires first : SFinite(X, μ)
  requires second : SFinite(Y, ν)
  requires member : c ∈ ennreal
  shows productMeasure(X, smulMeasure(c, X, μ), Y, ν) =
      smulMeasure(c, productMeasurableSpace(X, Y), productMeasure(X, μ, Y, ν)) ∧
    productMeasure(X, μ, Y, smulMeasure(c, Y, ν)) =
      smulMeasure(c, productMeasurableSpace(X, Y), productMeasure(X, μ, Y, ν))
proof
  sorry

-- Mathlib's MeasurePreserving.prod: products of measure-preserving maps.
theorem MeasurePreserving.product (f g h X μ Y ν X2 μ2 Y2 ν2 : Set)
  requires first : MeasurePreserving(f, X, μ, X2, μ2)
  requires second : MeasurePreserving(g, Y, ν, Y2, ν2)
  requires finite : SFinite(X, μ) ∧ SFinite(Y, ν) ∧ SFinite(X2, μ2) ∧ SFinite(Y2, ν2)
  requires product : ∀ p ∈ MeasurableSpace.carrier(X) × MeasurableSpace.carrier(Y),
    h(p) = (f(fst(p)), g(snd(p)))
  shows MeasurePreserving(h, productMeasurableSpace(X, Y), productMeasure(X, μ, Y, ν),
    productMeasurableSpace(X2, Y2), productMeasure(X2, μ2, Y2, ν2))
proof
  sorry

-- Section: Null sets of a product
-- Mathlib's Measure.measure_prod_null: a measurable set is null exactly
-- when almost every section is.
theorem productMeasure.null_iff (X μ Y ν E : Set)
  requires first : SFinite(X, μ)
  requires second : SFinite(Y, ν)
  requires set : MeasurableSet(productMeasurableSpace(X, Y), E)
  shows productMeasure(X, μ, Y, ν)(E) = realZero ↔
    AlmostEverywhere(X, μ, nullSections(Y, ν, E, MeasurableSpace.carrier(X)))
proof
  sorry

-- Mathlib's Measure.ae_prod_iff_ae_ae for a measurable property.
theorem productMeasure.ae_iff (X μ Y ν S : Set)
  requires first : SFinite(X, μ)
  requires second : SFinite(Y, ν)
  requires set : MeasurableSet(productMeasurableSpace(X, Y), S)
  shows AlmostEverywhere(productMeasurableSpace(X, Y), productMeasure(X, μ, Y, ν), S) ↔
    AlmostEverywhere(X, μ, aeSections(Y, ν, S, MeasurableSpace.carrier(X)))
proof
  sorry

-- Section: Tonelli's theorem
-- Mathlib's lintegral_prod: for measurable f into [0, ∞] the integral over
-- the product is the iterated integral, in either order
-- (lintegral_prod_symm, lintegral_lintegral_swap).
theorem lintegral.prod (X μ Y ν f : Set)
  requires first : SFinite(X, μ)
  requires second : SFinite(Y, ν)
  requires measurable : Measurable(f, productMeasurableSpace(X, Y), ennMeasurableSpace)
  shows lintegral(productMeasurableSpace(X, Y), productMeasure(X, μ, Y, ν), f) =
    lintegral(X, μ, innerLIntegrals(Y, ν, f, MeasurableSpace.carrier(X)))
proof
  sorry

theorem lintegral.prod_symm (X μ Y ν f : Set)
  requires first : SFinite(X, μ)
  requires second : SFinite(Y, ν)
  requires measurable : Measurable(f, productMeasurableSpace(X, Y), ennMeasurableSpace)
  shows lintegral(productMeasurableSpace(X, Y), productMeasure(X, μ, Y, ν), f) =
    lintegral(Y, ν, innerLIntegralsSecond(X, μ, f, MeasurableSpace.carrier(Y)))
proof
  sorry

theorem lintegral.lintegral_swap (X μ Y ν f : Set)
  requires first : SFinite(X, μ)
  requires second : SFinite(Y, ν)
  requires measurable : Measurable(f, productMeasurableSpace(X, Y), ennMeasurableSpace)
  shows lintegral(X, μ, innerLIntegrals(Y, ν, f, MeasurableSpace.carrier(X))) =
    lintegral(Y, ν, innerLIntegralsSecond(X, μ, f, MeasurableSpace.carrier(Y)))
proof
  sorry

-- Mathlib's lintegral_prod_le: without measurability the iterated
-- integral is at most the product integral.
theorem lintegral.prod_le (X μ Y ν f : Set)
  requires first : SFinite(X, μ)
  requires second : SFinite(Y, ν)
  requires values : EnnValued(productMeasurableSpace(X, Y), f)
  shows EnnLe(lintegral(X, μ, innerLIntegrals(Y, ν, f, MeasurableSpace.carrier(X))),
    lintegral(productMeasurableSpace(X, Y), productMeasure(X, μ, Y, ν), f))
proof
  sorry

-- Mathlib's lintegral_prod_mul.
theorem lintegral.prod_mul (X μ Y ν f g : Set)
  requires first : SFinite(X, μ)
  requires second : SFinite(Y, ν)
  requires measurableF : Measurable(f, X, ennMeasurableSpace)
  requires measurableG : Measurable(g, Y, ennMeasurableSpace)
  shows lintegral(productMeasurableSpace(X, Y), productMeasure(X, μ, Y, ν),
      ennTensorOn(f, g, MeasurableSpace.carrier(X), MeasurableSpace.carrier(Y))) =
    ennMul(lintegral(X, μ, f), lintegral(Y, ν, g))
proof
  sorry

-- Section: Fubini's theorem
-- Mathlib's integrable_prod_iff: f is integrable on the product exactly
-- when almost every section is integrable and x ↦ ∫ |f(x, ·)| is.
theorem ComplexIntegrable.prod_iff (X μ Y ν f : Set)
  requires first : SigmaFinite(X, μ)
  requires second : SigmaFinite(Y, ν)
  requires measurable : Measurable(f, productMeasurableSpace(X, Y), complexMeasurableSpace)
  shows ComplexIntegrable(productMeasurableSpace(X, Y), productMeasure(X, μ, Y, ν), f) ↔
    (AlmostEverywhere(X, μ, integrableSections(Y, ν, f, MeasurableSpace.carrier(X))) ∧
      RealIntegrable(X, μ, innerAbsIntegrals(Y, ν, f, MeasurableSpace.carrier(X))))
proof
  sorry

-- Mathlib's Integrable.prod_right_ae and Integrable.integral_prod_left.
theorem ComplexIntegrable.sections (X μ Y ν f : Set)
  requires first : SigmaFinite(X, μ)
  requires second : SigmaFinite(Y, ν)
  requires integrable : ComplexIntegrable(productMeasurableSpace(X, Y),
    productMeasure(X, μ, Y, ν), f)
  shows AlmostEverywhere(X, μ, integrableSections(Y, ν, f, MeasurableSpace.carrier(X))) ∧
    ComplexIntegrable(X, μ, innerIntegrals(Y, ν, f, MeasurableSpace.carrier(X)))
proof
  sorry

-- Fubini's theorem (Mathlib's integral_prod, integral_prod_symm,
-- integral_integral_swap).
theorem complexMeasureIntegral.prod (X μ Y ν f : Set)
  requires first : SigmaFinite(X, μ)
  requires second : SigmaFinite(Y, ν)
  requires integrable : ComplexIntegrable(productMeasurableSpace(X, Y),
    productMeasure(X, μ, Y, ν), f)
  shows complexMeasureIntegral(productMeasurableSpace(X, Y), productMeasure(X, μ, Y, ν), f) =
    complexMeasureIntegral(X, μ, innerIntegrals(Y, ν, f, MeasurableSpace.carrier(X)))
proof
  sorry

theorem complexMeasureIntegral.prod_symm (X μ Y ν f : Set)
  requires first : SigmaFinite(X, μ)
  requires second : SigmaFinite(Y, ν)
  requires integrable : ComplexIntegrable(productMeasurableSpace(X, Y),
    productMeasure(X, μ, Y, ν), f)
  shows complexMeasureIntegral(productMeasurableSpace(X, Y), productMeasure(X, μ, Y, ν), f) =
    complexMeasureIntegral(Y, ν, innerIntegralsSecond(X, μ, f, MeasurableSpace.carrier(Y)))
proof
  sorry

theorem complexMeasureIntegral.integral_swap (X μ Y ν f : Set)
  requires first : SigmaFinite(X, μ)
  requires second : SigmaFinite(Y, ν)
  requires integrable : ComplexIntegrable(productMeasurableSpace(X, Y),
    productMeasure(X, μ, Y, ν), f)
  shows complexMeasureIntegral(X, μ, innerIntegrals(Y, ν, f, MeasurableSpace.carrier(X))) =
    complexMeasureIntegral(Y, ν, innerIntegralsSecond(X, μ, f, MeasurableSpace.carrier(Y)))
proof
  sorry

-- Mathlib's Integrable.mul_prod and integral_prod_mul: f(x) g(y).
theorem ComplexIntegrable.tensor (X μ Y ν f g : Set)
  requires first : SigmaFinite(X, μ)
  requires second : SigmaFinite(Y, ν)
  requires integrableF : ComplexIntegrable(X, μ, f)
  requires integrableG : ComplexIntegrable(Y, ν, g)
  shows ComplexIntegrable(productMeasurableSpace(X, Y), productMeasure(X, μ, Y, ν),
    complexTensorOn(f, g, MeasurableSpace.carrier(X), MeasurableSpace.carrier(Y)))
proof
  sorry

theorem complexMeasureIntegral.tensor (X μ Y ν f g : Set)
  requires first : SigmaFinite(X, μ)
  requires second : SigmaFinite(Y, ν)
  requires valuesF : ∀ x ∈ MeasurableSpace.carrier(X), f(x) ∈ complexCarrier
  requires valuesG : ∀ y ∈ MeasurableSpace.carrier(Y), g(y) ∈ complexCarrier
  shows complexMeasureIntegral(productMeasurableSpace(X, Y), productMeasure(X, μ, Y, ν),
      complexTensorOn(f, g, MeasurableSpace.carrier(X), MeasurableSpace.carrier(Y))) =
    ℂ[complexMeasureIntegral(X, μ, f) * complexMeasureIntegral(Y, ν, g)]
proof
  sorry

-- Section: Lebesgue measure as a product
-- Mathlib's volume_preserving_piFinSuccAbove: ℝⁿ⁺¹ = ℝⁿ × ℝ.
theorem splitLast.measure_preserving (n : Nat)
  shows MeasurePreserving(splitLast(n), euclideanMeasurableSpace(succ(n)),
    euclideanVolume(succ(n)),
    productMeasurableSpace(euclideanMeasurableSpace(n), realMeasurableSpace),
    productMeasure(euclideanMeasurableSpace(n), euclideanVolume(n),
      realMeasurableSpace, realVolume)) ∧
    MeasurableEquiv(splitLast(n), euclideanMeasurableSpace(succ(n)),
      productMeasurableSpace(euclideanMeasurableSpace(n), realMeasurableSpace))
proof
  sorry

-- Mathlib's volume_measurePreserving_sumPiEquivProdPi: ℝᵐ⁺ⁿ = ℝᵐ × ℝⁿ.
theorem splitBlocks.measure_preserving (m n : Nat)
  shows MeasurePreserving(splitBlocks(m, n), euclideanMeasurableSpace(m + n),
    euclideanVolume(m + n),
    productMeasurableSpace(euclideanMeasurableSpace(m), euclideanMeasurableSpace(n)),
    productMeasure(euclideanMeasurableSpace(m), euclideanVolume(m),
      euclideanMeasurableSpace(n), euclideanVolume(n))) ∧
    MeasurableEquiv(splitBlocks(m, n), euclideanMeasurableSpace(m + n),
      productMeasurableSpace(euclideanMeasurableSpace(m), euclideanMeasurableSpace(n)))
proof
  sorry

-- Mathlib's integral_fintype_prod_volume_eq_prod and
-- Integrable.fintype_prod: ∫_{ℝⁿ} ∏ᵢ fᵢ(xᵢ) dx = ∏ᵢ ∫_ℝ fᵢ.
theorem productIntegrand.integrable (f : Set, n : Nat)
  requires integrable : ∀ i ∈ n, ComplexIntegrable(realMeasurableSpace, realVolume, f(i))
  shows ComplexIntegrable(euclideanMeasurableSpace(n), euclideanVolume(n),
    productIntegrand(f, n))
proof
  sorry

theorem productIntegrand.integral (f : Set, n : Nat)
  requires values : ∀ i ∈ n, ∀ X ∈ ℝ, f(i)(X) ∈ complexCarrier
  shows complexMeasureIntegral(euclideanMeasurableSpace(n), euclideanVolume(n),
      productIntegrand(f, n)) =
    complexFiniteProduct(n, factorIntegrals(f, n))
proof
  sorry

-- Section: Lebesgue measure on ℂ
theorem complexVolume.measure
  shows Measure(complexMeasurableSpace, complexVolume) ∧
    SigmaFinite(complexMeasurableSpace, complexVolume)
proof
  sorry

theorem complexToVector.measure_preserving
  shows MeasurePreserving(complexToVector, complexMeasurableSpace, complexVolume,
      euclideanMeasurableSpace(2), euclideanVolume(2)) ∧
    MeasurableEquiv(complexToVector, complexMeasurableSpace, euclideanMeasurableSpace(2))
proof
  sorry

-- Translation invariance and the area of a disc, π r².
theorem complexVolume.translate (S c : Set)
  requires set : MeasurableSet(complexMeasurableSpace, S)
  requires member : c ∈ complexCarrier
  shows complexVolume(valuesOn(complexTranslation(c), S)) = complexVolume(S)
proof
  sorry

theorem complexVolume.disc (c : Set, r : Real)
  requires member : c ∈ complexCarrier
  requires positive : realZero < r
  shows complexVolume(complexDisc(c, r)) = R[realPi * r * r]
proof
  sorry

end ProductMeasures
