theorem realOuterMeasure.outer
  shows OuterMeasure(ℝ, realOuterMeasure)
proof
  sorry

-- The Borel sets are Carathéodory measurable for the Lebesgue outer
-- measure, so Lebesgue measure is a measure.
theorem realOuterMeasure.borel_caratheodory
  shows MeasurableSpace.sets(realMeasurableSpace) ⊆
    caratheodorySets(ℝ, realOuterMeasure)
proof
  sorry

