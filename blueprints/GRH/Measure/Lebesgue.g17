-- The volume of a box is the product of its side lengths.
theorem euclideanVolume.box (n : Nat, a b : Set)
  requires lower : a ∈ functionSpace(n, ℝ)
  requires upper : b ∈ functionSpace(n, ℝ)
  shows euclideanVolume(n)(boxSet(n, a, b)) = boxVolume(n, a, b)
proof
  sorry

-- Mathlib's volume_pi_pi and Measure.pi_pi: the volume of a product of
-- Borel sets of ℝ is the product of their volumes, in [0, ∞].
theorem euclideanVolume.pi_set_null (n : Nat, S : Set)
  requires sets : ∀ i ∈ n, MeasurableSet(realMeasurableSpace, S(i))
  requires null : ∃ i ∈ n, realVolume(S(i)) = realZero
  shows euclideanVolume(n)(piSet(n, ℝ, S)) = realZero
proof
  sorry

theorem euclideanVolume.pi_set_finite (n : Nat, S : Set)
  requires sets : ∀ i ∈ n, MeasurableSet(realMeasurableSpace, S(i))
  requires finite : ∀ i ∈ n, realVolume(S(i)) ≠ ennTop
  shows euclideanVolume(n)(piSet(n, ℝ, S)) =
    finiteRingProduct(n, ℝ, realAdd, realZero, realNeg, realMul, realOne,
      measureSequence(realVolume, S))
proof
  sorry

-- Mathlib's Measure.pi_univ / volume_pi_eq_dirac: ℝ⁰ is one point of
-- mass 1.
theorem euclideanVolume.zero_dimension
  shows euclideanVolume(0)(functionSpace(0, ℝ)) = realOne
proof
  sorry

-- ℝ and ℝ¹ (Mathlib's volume_preserving_funUnique).
theorem realToVector.measure_preserving
  shows MeasurePreserving(realToVector, realMeasurableSpace, realVolume,
    euclideanMeasurableSpace(1), euclideanVolume(1))
proof
  sorry

theorem euclideanVolume.translate (n : Nat, S c : Set)
  requires set : MeasurableSet(euclideanMeasurableSpace(n), S)
  requires vector : c ∈ functionSpace(n, ℝ)
  shows euclideanVolume(n)(vectorTranslate(n, S, c)) = euclideanVolume(n)(S)
proof
  sorry

-- Mathlib's Measure.addHaar_smul: dilating by c multiplies volume by |c|ⁿ.
theorem euclideanVolume.dilate (n : Nat, S : Set, c : Real)
  requires set : MeasurableSet(euclideanMeasurableSpace(n), S)
  shows euclideanVolume(n)(vectorDilate(n, S, c)) =
    ennMul(abs(c) ^ n, euclideanVolume(n)(S))
proof
  sorry

theorem euclideanVolume.sigma_finite (n : Nat)
  shows SigmaFinite(euclideanMeasurableSpace(n), euclideanVolume(n))
proof
  sorry

theorem euclideanVolume.regular (n : Nat)
  shows RegularMeasure(euclideanTopology(n), euclideanVolume(n)) ∧
    OpenPositive(euclideanTopology(n), euclideanVolume(n))
proof
  sorry

-- Mathlib's Measure.ae_eval_ne: coordinate hyperplanes are null in ℝⁿ.
theorem euclideanVolume.hyperplane_null (n : Nat, i : Set, c : Real)
  requires member : i ∈ n
  shows euclideanVolume(n)(hyperplane(n, i, c)) = realZero
proof
  sorry

-- Countable sets are null in ℝⁿ for n ≥ 1.
theorem euclideanVolume.countable_null (n : Nat, C : Set)
  requires positive : 0 < n
  requires countable : Countable(C)
  requires inside : C ⊆ functionSpace(n, ℝ)
  shows NullSet(euclideanMeasurableSpace(n), euclideanVolume(n), C)
proof
  sorry

-- Balls (Mathlib's addHaar_ball_center, addHaar_ball_mul_of_pos,
-- measure_ball_pos, measure_ball_ne_top).
theorem euclideanVolume.ball_center (n : Nat, c : Set, r : Real)
  requires center : c ∈ functionSpace(n, ℝ)
  shows euclideanVolume(n)(euclideanBall(n, c, r)) =
    euclideanVolume(n)(euclideanBall(n, zeroVector(n), r))
proof
  sorry

theorem euclideanVolume.ball_scale (n : Nat, c : Set, r : Real)
  requires center : c ∈ functionSpace(n, ℝ)
  requires positive : realZero < r
  shows euclideanVolume(n)(euclideanBall(n, c, r)) =
    ennMul(r ^ n, euclideanVolume(n)(euclideanBall(n, zeroVector(n), realOne)))
proof
  sorry

theorem euclideanVolume.ball_positive_finite (n : Nat, c : Set, r : Real)
  requires center : c ∈ functionSpace(n, ℝ)
  requires positive : realZero < r
  shows euclideanVolume(n)(euclideanBall(n, c, r)) ≠ realZero ∧
    euclideanVolume(n)(euclideanBall(n, c, r)) ≠ ennTop
proof
  sorry

end Measures
