-- Mathlib's Real.volume_Icc, volume_Ioo, volume_Ioc, volume_Ico.
theorem realVolume.intervals (A B : Real)
  shows realVolume(realIcc(A, B)) = ennOfReal(R[B - A]) ∧
    realVolume(realIoo(A, B)) = ennOfReal(R[B - A]) ∧
    realVolume(realIoc(A, B)) = ennOfReal(R[B - A]) ∧
    realVolume(realIco(A, B)) = ennOfReal(R[B - A])
proof
  sorry

theorem realVolume.rays (A : Real)
  shows realVolume(realIoi(A)) = ennTop ∧ realVolume(realIic(A)) = ennTop
proof
  sorry

theorem realVolume.whole
  shows realVolume(ℝ) = ennTop
proof
  sorry

-- Mathlib's Set.Countable.measure_zero and Set.Countable.ae_notMem for
-- Lebesgue measure: countable sets are null.
theorem realVolume.countable_null (C : Set)
  requires countable : Countable(C)
  requires inside : C ⊆ ℝ
  shows realVolume(C) = realZero
proof
  sorry

-- Translation invariance and scaling (Mathlib's map_add_left_eq_self and
-- Real.volume_preimage_mul_left / Real.smul_map_volume_mul_left).
theorem realVolume.translate (S : Set, c : Real)
  requires set : MeasurableSet(realMeasurableSpace, S)
  shows realVolume(realTranslate(S, c)) = realVolume(S)
proof
  sorry

theorem realVolume.dilate (S : Set, c : Real)
  requires set : MeasurableSet(realMeasurableSpace, S)
  shows realVolume(realDilate(S, c)) = ennMul(abs(c), realVolume(S))
proof
  sorry

