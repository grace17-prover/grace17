-- Integrals of real-, complex- and Banach-valued maps against a measure.
-- A real map is integrable when it is measurable with finite lower
-- integral of |f|, and its integral is ∫⁻ f⁺ − ∫⁻ f⁻; a complex map is
-- integrated through its real and imaginary parts; a Banach-valued map is
-- integrated as the limit of the integrals of simple maps approximating
-- it in mean (Mathlib's Bochner integral, with its junk value 0 off the
-- integrable maps, defined directly rather than through the L¹ completion).
-- Linearity, conjugation, real and imaginary parts, the norm bound,
-- monotonicity, integrals over sets, push-forwards and measure-preserving
-- maps, Dirac and counting measures; integrability criteria; dominated
-- convergence, termwise integration of series, continuity of parametric
-- integrals; square-integrable maps and the Cauchy–Schwarz inequality;
-- and agreement with layer 1's Riemann and improper integrals, with the
-- fundamental theorem of calculus and the standard integrals over
-- half-lines.
-- Part of the GRH blueprint.
-- Planned home: MeasureTheory/Integral/Bochner.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Measure.Bochner
import GRH.Measure.LIntegral
import GRH.Integral

section Bochner
notation ring ℂ := (complexCarrier, complexAdd, complexZero, complexNeg,
  complexMul, complexOne)
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- Section: Integrals of real maps
-- f is integrable (Mathlib's Integrable for ℝ-valued maps, Borel
-- measurable being strongly measurable on ℝ).
predicate RealIntegrable (X μ f : Set) :=
  Measure(X, μ) ∧ Measurable(f, X, realMeasurableSpace) ∧
  lintegral(X, μ, realAbsOn(f, MeasurableSpace.carrier(X))) ≠ ennTop

-- −f on A, and the integral ∫⁻ f⁺ − ∫⁻ f⁻ of an integrable real map; the
-- integral is 0 when f is not integrable (Mathlib's integral_undef).
def realNegOn (f A : Set) : Set := { (x, R[-f(x)]) | x ∈ A }
def realIntegralValue (X μ f : Set) : Set :=
  R[ennToReal(lintegral(X, μ, ennOfRealOn(f, MeasurableSpace.carrier(X)))) -
    ennToReal(lintegral(X, μ,
      ennOfRealOn(realNegOn(f, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X))))]
def realMeasureIntegral (X μ f : Set) : Set :=
  ⋃({ I ∈ ℝ | (RealIntegrable(X, μ, f) ∧ I = realIntegralValue(X, μ, f)) ∨
    (¬RealIntegrable(X, μ, f) ∧ I = realZero) })

-- Section: Integrals of complex maps
predicate ComplexIntegrable (X μ f : Set) :=
  Measure(X, μ) ∧ Measurable(f, X, complexMeasurableSpace) ∧
  lintegral(X, μ, complexAbsOn(f, MeasurableSpace.carrier(X))) ≠ ennTop

-- ∫ f = ∫ re f + i ∫ im f for integrable f, and 0 otherwise (Mathlib's
-- integral for ℂ-valued maps).
def complexMeasureIntegral (X μ f : Set) : Set :=
  ⋃({ I ∈ complexCarrier | (ComplexIntegrable(X, μ, f) ∧
      I = (realMeasureIntegral(X, μ, realPartOn(f, MeasurableSpace.carrier(X))),
        realMeasureIntegral(X, μ, imagPartOn(f, MeasurableSpace.carrier(X))))) ∨
    (¬ComplexIntegrable(X, μ, f) ∧ I = complexZero) })

-- Integrability on a set and the integral over a set (Mathlib's
-- IntegrableOn and setIntegral, ∫ x in A, f x ∂μ).
predicate RealIntegrableOn (X μ f A : Set) := RealIntegrable(X, restrictMeasure(X, μ, A), f)
predicate ComplexIntegrableOn (X μ f A : Set) :=
  ComplexIntegrable(X, restrictMeasure(X, μ, A), f)
def realSetIntegral (X μ f A : Set) : Set :=
  realMeasureIntegral(X, restrictMeasure(X, μ, A), f)
def complexSetIntegral (X μ f A : Set) : Set :=
  complexMeasureIntegral(X, restrictMeasure(X, μ, A), f)

-- Pointwise constructions of complex maps on A: f + g, f − g, −f, c · f,
-- f · c, f / c, f · g, conj f, the real map f read in ℂ, and a finite sum.
def complexAddOn (f g A : Set) : Set := { (x, ℂ[f(x) + g(x)]) | x ∈ A }
def complexSubOn (f g A : Set) : Set := { (x, ℂ[f(x) - g(x)]) | x ∈ A }
def complexNegOn (f A : Set) : Set := { (x, ℂ[-f(x)]) | x ∈ A }
def complexConstMulOn (c f A : Set) : Set := { (x, ℂ[c * f(x)]) | x ∈ A }
def complexMulConstOn (f c A : Set) : Set := { (x, ℂ[f(x) * c]) | x ∈ A }
def complexDivConstOn (f c A : Set) : Set := { (x, complexDiv(f(x), c)) | x ∈ A }
def complexMulOn (f g A : Set) : Set := { (x, ℂ[f(x) * g(x)]) | x ∈ A }
def complexConjOn (f A : Set) : Set := { (x, complexConj(f(x))) | x ∈ A }
def complexOfRealOn (f A : Set) : Set := { (x, complexOfReal(f(x))) | x ∈ A }
def complexFiniteSumOn (u F A : Set) : Set :=
  { (x, groupFiniteSum(complexAdditiveGroup, F, familyAt(u, F, x))) | x ∈ A }
def complexIndicatorOn (A S f : Set) : Set :=
  piecewiseOn(A, S, f, constantOn(A, complexZero))

-- Families of integrals: n ↦ ∫ u(n), and i ↦ ∫ u(i) over a finite set.
def complexIntegralSequence (X μ u : Set) : Set :=
  { (n, complexMeasureIntegral(X, μ, u(n))) | n ∈ ℕ }
def complexIntegralFamily (X μ u F : Set) : Set :=
  { (i, complexMeasureIntegral(X, μ, u(i))) | i ∈ F }
def complexNormIntegralSequence (X μ u : Set) : Set :=
  { (n, realMeasureIntegral(X, μ, complexAbsOn(u(n), MeasurableSpace.carrier(X)))) | n ∈ ℕ }

-- The set where u(n)(x) → f(x) in ℂ, and where |f| ≤ g.
def complexConvergenceSet (u f A : Set) : Set :=
  { x ∈ A | Tendsto(familyAt(u, ℕ, x), ℕ, natAtTop, nhds(complexSpace, f(x))) }
def complexBoundSet (f g A : Set) : Set := { x ∈ A | complexAbs(f(x)) ≤ g(x) }
def realAbsBoundSet (f g A : Set) : Set := { x ∈ A | abs(f(x)) ≤ g(x) }

-- The integrals over a sequence of sets.
def complexSetIntegralSequence (X μ f S : Set) : Set :=
  { (n, complexSetIntegral(X, μ, f, S(n))) | n ∈ ℕ }

-- The points x at which t ↦ F(t)(x) is continuous on T.
def parameterContinuitySet (F T A : Set) : Set :=
  { x ∈ A | familyAt(F, TopologicalSpace.carrier(T), x) : T ⇒ complexSpace }

-- |f|² on A.
def complexAbsSquareOn (f A : Set) : Set :=
  { (x, R[complexAbs(f(x)) * complexAbs(f(x))]) | x ∈ A }

-- Standard integrands: e^(−x), e^(ax) for complex a, 1/(1 + x²).
def expNegFunction : Set := { (X, realExp(R[-X])) | X ∈ ℝ }
def complexExpLinear (a : Set) : Set := { (X, complexExp(ℂ[a * complexOfReal(X)])) | X ∈ ℝ }
def inverseOnePlusSquare : Set := { (X, R[1 / (1 + X * X)]) | X ∈ ℝ }

-- Section: Integrals of Banach-valued maps
-- A simple map into the module V: finitely many values, each taken on a
-- measurable set. A strongly measurable map: a pointwise limit of simple
-- maps in the norm (Mathlib's StronglyMeasurable).
predicate SimpleMap (X V s : Set) :=
  MapsInto(s, MeasurableSpace.carrier(X), Module.carrier(V)) ∧
  Finite(valuesOn(s, MeasurableSpace.carrier(X))) ∧
  (∀ v ∈ valuesOn(s, MeasurableSpace.carrier(X)),
    functionPreimage(s, MeasurableSpace.carrier(X), {v}) ∈ MeasurableSpace.sets(X))
predicate StronglyMeasurable (X V norm f : Set) :=
  MapsInto(f, MeasurableSpace.carrier(X), Module.carrier(V)) ∧
  ∃ s, (∀ n ∈ ℕ, SimpleMap(X, V, s(n))) ∧
    (∀ x ∈ MeasurableSpace.carrier(X), Tendsto(familyAt(s, ℕ, x), ℕ, natAtTop,
      nhds(spaceTopology(V, norm), f(x))))

-- ‖f(x)‖ and ‖f(x) − g(x)‖ on A.
def normOn (norm f A : Set) : Set := { (x, norm(f(x))) | x ∈ A }
def normDifferenceOn (V norm f g A : Set) : Set :=
  { (x, norm(Module.add(V)(f(x), Module.neg(V)(g(x))))) | x ∈ A }

-- f is Bochner integrable: strongly measurable with ∫⁻ ‖f‖ < ∞.
predicate BanachIntegrable (X μ V norm f : Set) :=
  Measure(X, μ) ∧ StronglyMeasurable(X, V, norm, f) ∧
  lintegral(X, μ, normOn(norm, f, MeasurableSpace.carrier(X))) ≠ ennTop

-- The integral of a simple map, Σ_v μ(s = v) · v, the scalar μ(s = v)
-- read in the scalar ring through ofReal : ℝ → K.
def simpleValueTerms (X μ V ofReal s : Set) : Set :=
  { (v, Module.smul(V)(ofReal(measureReal(μ,
      functionPreimage(s, MeasurableSpace.carrier(X), {v}))), v)) |
    v ∈ valuesOn(s, MeasurableSpace.carrier(X)) }
def simpleIntegral (X μ V ofReal s : Set) : Set :=
  groupFiniteSum(Module.additive(V), valuesOn(s, MeasurableSpace.carrier(X)),
    simpleValueTerms(X, μ, V, ofReal, s))
def simpleIntegralSequence (X μ V ofReal s : Set) : Set :=
  { (n, simpleIntegral(X, μ, V, ofReal, s(n))) | n ∈ ℕ }
def approximationErrors (X μ V norm s f : Set) : Set :=
  { (n, lintegral(X, μ, normDifferenceOn(V, norm, s(n), f, MeasurableSpace.carrier(X)))) |
    n ∈ ℕ }

-- v is the integral of f: integrable simple maps s(n) approximate f in
-- mean, ∫⁻ ‖s(n) − f‖ → 0, and their integrals tend to v; the integral is
-- that v, and 0 when f is not integrable (Mathlib's integral).
predicate HasBanachIntegral (X μ V ofReal norm f v : Set) :=
  BanachIntegrable(X, μ, V, norm, f) ∧ v ∈ Module.carrier(V) ∧
  ∃ s, (∀ n ∈ ℕ, SimpleMap(X, V, s(n)) ∧ BanachIntegrable(X, μ, V, norm, s(n))) ∧
    EnnConvergesTo(approximationErrors(X, μ, V, norm, s, f), realZero) ∧
    Tendsto(simpleIntegralSequence(X, μ, V, ofReal, s), ℕ, natAtTop,
      nhds(spaceTopology(V, norm), v))
def banachIntegral (X μ V ofReal norm f : Set) : Set :=
  ⋃({ v ∈ Module.carrier(V) | HasBanachIntegral(X, μ, V, ofReal, norm, f, v) ∨
    (¬BanachIntegrable(X, μ, V, norm, f) ∧ v = Module.zero(V)) })

-- The composite L ∘ f of a map with a linear map, on A.
def linearComposeOn (L f A : Set) : Set := { (x, L(f(x))) | x ∈ A }

-- Section: Square-integrable maps
-- f ∈ L²(μ) (Mathlib's MemLp f 2 μ), the L² inner product ∫ conj(f) g and
-- the essentially bounded maps (MemLp f ∞ μ).
predicate SquareIntegrable (X μ f : Set) :=
  Measure(X, μ) ∧ Measurable(f, X, complexMeasurableSpace) ∧
  lintegral(X, μ, complexAbsSquareOn(f, MeasurableSpace.carrier(X))) ≠ ennTop
def l2Inner (X μ f g : Set) : Set :=
  complexMeasureIntegral(X, μ,
    complexMulOn(complexConjOn(f, MeasurableSpace.carrier(X)), g, MeasurableSpace.carrier(X)))
predicate EssentiallyBounded (X μ f : Set) :=
  Measure(X, μ) ∧ Measurable(f, X, complexMeasurableSpace) ∧
  ∃ C ∈ ℝ, AlmostEverywhere(X, μ, realLeSet(complexAbsOn(f, MeasurableSpace.carrier(X)),
    MeasurableSpace.carrier(X), C))

-- The mean value (1/μ(X)) ∫ f of a complex map against a finite measure
-- (Mathlib's average, ⨍).
def complexAverage (X μ f : Set) : Set :=
  ℂ[complexOfReal(realInvValue(measureReal(μ, MeasurableSpace.carrier(X)))) *
    complexMeasureIntegral(X, μ, f)]

-- Section: Interval integrals
-- The oriented integral ∫_A^B f over Lebesgue measure: over (A, B] when
-- A ≤ B and minus the integral over (B, A] otherwise (Mathlib's
-- intervalIntegral); and integrability on [A, B].
def complexIntervalIntegral (f : Set, A B : Real) : Set :=
  ⋃({ I ∈ complexCarrier |
    (A ≤ B ∧ I = complexSetIntegral(realMeasurableSpace, realVolume, f, realIoc(A, B))) ∨
    (B < A ∧ I = ℂ[-complexSetIntegral(realMeasurableSpace, realVolume, f, realIoc(B, A))]) })
predicate ComplexIntervalIntegrable (f : Set, A B : Real) :=
  ComplexIntegrableOn(realMeasurableSpace, realVolume, f, realIcc(A, B)) ∧
  ComplexIntegrableOn(realMeasurableSpace, realVolume, f, realIcc(B, A))

-- Section: Helpers for the integral
theorem ennOfRealOn.boch_apply (f A x : Set)
  requires member : x ∈ A
  shows ennOfRealOn(f, A)(x) = ennOfReal(f(x))
proof
  have edge : (x, ennOfReal(f(x))) ∈ ennOfRealOn(f, A)
    apply ennOfRealOn.membership.backward
    exact ⟨x, member, rfl⟩
  have pairs : ∀ p ∈ ennOfRealOn(f, A), ∃ a, ∃ b, p = (a, b)
    intros p hp
    obtain ⟨k0, hk, pEq⟩ := ennOfRealOn.membership.forward with hp
    rw ← pEq
    exact ⟨k0, ennOfReal(f(k0)), rfl⟩
  have functional : ∀ a, ∀ b, ∀ c, (a, b) ∈ ennOfRealOn(f, A) → (a, c) ∈ ennOfRealOn(f, A) → b = c
    intros a b c hb hc
    obtain ⟨k0, hk, bEq⟩ := ennOfRealOn.membership.forward with hb
    obtain ⟨m0, hm, cEq⟩ := ennOfRealOn.membership.forward with hc
    obtain ⟨ka, bb⟩ := orderedPair.injective with bEq
    obtain ⟨ma, cc⟩ := orderedPair.injective with cEq
    rw [← bb, ← cc, ka, ← ma]
  exact pairGraph.apply with pairs, functional, edge

theorem realAbsOn.boch_apply (f A x : Set)
  requires member : x ∈ A
  shows realAbsOn(f, A)(x) = abs(f(x))
proof
  have edge : (x, abs(f(x))) ∈ realAbsOn(f, A)
    apply realAbsOn.membership.backward
    exact ⟨x, member, rfl⟩
  have pairs : ∀ p ∈ realAbsOn(f, A), ∃ a, ∃ b, p = (a, b)
    intros p hp
    obtain ⟨k0, hk, pEq⟩ := realAbsOn.membership.forward with hp
    rw ← pEq
    exact ⟨k0, abs(f(k0)), rfl⟩
  have functional : ∀ a, ∀ b, ∀ c, (a, b) ∈ realAbsOn(f, A) → (a, c) ∈ realAbsOn(f, A) → b = c
    intros a b c hb hc
    obtain ⟨k0, hk, bEq⟩ := realAbsOn.membership.forward with hb
    obtain ⟨m0, hm, cEq⟩ := realAbsOn.membership.forward with hc
    obtain ⟨ka, bb⟩ := orderedPair.injective with bEq
    obtain ⟨ma, cc⟩ := orderedPair.injective with cEq
    rw [← bb, ← cc, ka, ← ma]
  exact pairGraph.apply with pairs, functional, edge

theorem realNegOn.boch_apply (f A x : Set)
  requires member : x ∈ A
  shows realNegOn(f, A)(x) = R[-f(x)]
proof
  have edge : (x, R[-f(x)]) ∈ realNegOn(f, A)
    apply realNegOn.membership.backward
    exact ⟨x, member, rfl⟩
  have pairs : ∀ p ∈ realNegOn(f, A), ∃ a, ∃ b, p = (a, b)
    intros p hp
    obtain ⟨k0, hk, pEq⟩ := realNegOn.membership.forward with hp
    rw ← pEq
    exact ⟨k0, R[-f(k0)], rfl⟩
  have functional : ∀ a, ∀ b, ∀ c, (a, b) ∈ realNegOn(f, A) → (a, c) ∈ realNegOn(f, A) → b = c
    intros a b c hb hc
    obtain ⟨k0, hk, bEq⟩ := realNegOn.membership.forward with hb
    obtain ⟨m0, hm, cEq⟩ := realNegOn.membership.forward with hc
    obtain ⟨ka, bb⟩ := orderedPair.injective with bEq
    obtain ⟨ma, cc⟩ := orderedPair.injective with cEq
    rw [← bb, ← cc, ka, ← ma]
  exact pairGraph.apply with pairs, functional, edge

theorem complexAbsOn.boch_apply (f A x : Set)
  requires member : x ∈ A
  shows complexAbsOn(f, A)(x) = complexAbs(f(x))
proof
  have edge : (x, complexAbs(f(x))) ∈ complexAbsOn(f, A)
    apply complexAbsOn.membership.backward
    exact ⟨x, member, rfl⟩
  have pairs : ∀ p ∈ complexAbsOn(f, A), ∃ a, ∃ b, p = (a, b)
    intros p hp
    obtain ⟨k0, hk, pEq⟩ := complexAbsOn.membership.forward with hp
    rw ← pEq
    exact ⟨k0, complexAbs(f(k0)), rfl⟩
  have functional : ∀ a, ∀ b, ∀ c, (a, b) ∈ complexAbsOn(f, A) → (a, c) ∈ complexAbsOn(f, A) → b = c
    intros a b c hb hc
    obtain ⟨k0, hk, bEq⟩ := complexAbsOn.membership.forward with hb
    obtain ⟨m0, hm, cEq⟩ := complexAbsOn.membership.forward with hc
    obtain ⟨ka, bb⟩ := orderedPair.injective with bEq
    obtain ⟨ma, cc⟩ := orderedPair.injective with cEq
    rw [← bb, ← cc, ka, ← ma]
  exact pairGraph.apply with pairs, functional, edge

theorem complexAddOn.boch_apply (f g A x : Set)
  requires member : x ∈ A
  shows complexAddOn(f, g, A)(x) = ℂ[f(x) + g(x)]
proof
  have edge : (x, ℂ[f(x) + g(x)]) ∈ complexAddOn(f, g, A)
    apply complexAddOn.membership.backward
    exact ⟨x, member, rfl⟩
  have pairs : ∀ p ∈ complexAddOn(f, g, A), ∃ a, ∃ b, p = (a, b)
    intros p hp
    obtain ⟨k0, hk, pEq⟩ := complexAddOn.membership.forward with hp
    rw ← pEq
    exact ⟨k0, ℂ[f(k0) + g(k0)], rfl⟩
  have functional : ∀ a, ∀ b, ∀ c, (a, b) ∈ complexAddOn(f, g, A) → (a, c) ∈ complexAddOn(f, g, A) → b = c
    intros a b c hb hc
    obtain ⟨k0, hk, bEq⟩ := complexAddOn.membership.forward with hb
    obtain ⟨m0, hm, cEq⟩ := complexAddOn.membership.forward with hc
    obtain ⟨ka, bb⟩ := orderedPair.injective with bEq
    obtain ⟨ma, cc⟩ := orderedPair.injective with cEq
    rw [← bb, ← cc, ka, ← ma]
  exact pairGraph.apply with pairs, functional, edge

theorem complexSubOn.boch_apply (f g A x : Set)
  requires member : x ∈ A
  shows complexSubOn(f, g, A)(x) = ℂ[f(x) - g(x)]
proof
  have edge : (x, ℂ[f(x) - g(x)]) ∈ complexSubOn(f, g, A)
    apply complexSubOn.membership.backward
    exact ⟨x, member, rfl⟩
  have pairs : ∀ p ∈ complexSubOn(f, g, A), ∃ a, ∃ b, p = (a, b)
    intros p hp
    obtain ⟨k0, hk, pEq⟩ := complexSubOn.membership.forward with hp
    rw ← pEq
    exact ⟨k0, ℂ[f(k0) - g(k0)], rfl⟩
  have functional : ∀ a, ∀ b, ∀ c, (a, b) ∈ complexSubOn(f, g, A) → (a, c) ∈ complexSubOn(f, g, A) → b = c
    intros a b c hb hc
    obtain ⟨k0, hk, bEq⟩ := complexSubOn.membership.forward with hb
    obtain ⟨m0, hm, cEq⟩ := complexSubOn.membership.forward with hc
    obtain ⟨ka, bb⟩ := orderedPair.injective with bEq
    obtain ⟨ma, cc⟩ := orderedPair.injective with cEq
    rw [← bb, ← cc, ka, ← ma]
  exact pairGraph.apply with pairs, functional, edge

theorem complexNegOn.boch_apply (f A x : Set)
  requires member : x ∈ A
  shows complexNegOn(f, A)(x) = ℂ[-f(x)]
proof
  have edge : (x, ℂ[-f(x)]) ∈ complexNegOn(f, A)
    apply complexNegOn.membership.backward
    exact ⟨x, member, rfl⟩
  have pairs : ∀ p ∈ complexNegOn(f, A), ∃ a, ∃ b, p = (a, b)
    intros p hp
    obtain ⟨k0, hk, pEq⟩ := complexNegOn.membership.forward with hp
    rw ← pEq
    exact ⟨k0, ℂ[-f(k0)], rfl⟩
  have functional : ∀ a, ∀ b, ∀ c, (a, b) ∈ complexNegOn(f, A) → (a, c) ∈ complexNegOn(f, A) → b = c
    intros a b c hb hc
    obtain ⟨k0, hk, bEq⟩ := complexNegOn.membership.forward with hb
    obtain ⟨m0, hm, cEq⟩ := complexNegOn.membership.forward with hc
    obtain ⟨ka, bb⟩ := orderedPair.injective with bEq
    obtain ⟨ma, cc⟩ := orderedPair.injective with cEq
