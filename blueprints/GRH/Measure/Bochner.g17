theorem complexConstMulOn.boch_apply (c f A x : Set)
  requires member : x ∈ A
  shows complexConstMulOn(c, f, A)(x) = ℂ[c * f(x)]
proof
  have edge : (x, ℂ[c * f(x)]) ∈ complexConstMulOn(c, f, A)
    apply complexConstMulOn.membership.backward
    exact ⟨x, member, rfl⟩
  have pairs : ∀ p ∈ complexConstMulOn(c, f, A), ∃ a, ∃ b, p = (a, b)
    intros p hp
    obtain ⟨k0, hk, pEq⟩ := complexConstMulOn.membership.forward with hp
    rw ← pEq
    exact ⟨k0, ℂ[c * f(k0)], rfl⟩
  have functional : ∀ a, ∀ b, ∀ e, (a, b) ∈ complexConstMulOn(c, f, A) → (a, e) ∈ complexConstMulOn(c, f, A) → b = e
    intros a b e hb hc
    obtain ⟨k0, hk, bEq⟩ := complexConstMulOn.membership.forward with hb
    obtain ⟨m0, hm, cEq⟩ := complexConstMulOn.membership.forward with hc
    obtain ⟨ka, bb⟩ := orderedPair.injective with bEq
    obtain ⟨ma, ee⟩ := orderedPair.injective with cEq
    rw [← bb, ← ee, ka, ← ma]
  exact pairGraph.apply with pairs, functional, edge

theorem complexMulConstOn.boch_apply (f c A x : Set)
  requires member : x ∈ A
  shows complexMulConstOn(f, c, A)(x) = ℂ[f(x) * c]
proof
  have edge : (x, ℂ[f(x) * c]) ∈ complexMulConstOn(f, c, A)
    apply complexMulConstOn.membership.backward
    exact ⟨x, member, rfl⟩
  have pairs : ∀ p ∈ complexMulConstOn(f, c, A), ∃ a, ∃ b, p = (a, b)
    intros p hp
    obtain ⟨k0, hk, pEq⟩ := complexMulConstOn.membership.forward with hp
    rw ← pEq
    exact ⟨k0, ℂ[f(k0) * c], rfl⟩
  have functional : ∀ a, ∀ b, ∀ e, (a, b) ∈ complexMulConstOn(f, c, A) → (a, e) ∈ complexMulConstOn(f, c, A) → b = e
    intros a b e hb hc
    obtain ⟨k0, hk, bEq⟩ := complexMulConstOn.membership.forward with hb
    obtain ⟨m0, hm, cEq⟩ := complexMulConstOn.membership.forward with hc
    obtain ⟨ka, bb⟩ := orderedPair.injective with bEq
    obtain ⟨ma, ee⟩ := orderedPair.injective with cEq
    rw [← bb, ← ee, ka, ← ma]
  exact pairGraph.apply with pairs, functional, edge

theorem complexDivConstOn.boch_apply (f c A x : Set)
  requires member : x ∈ A
  shows complexDivConstOn(f, c, A)(x) = complexDiv(f(x), c)
proof
  have edge : (x, complexDiv(f(x), c)) ∈ complexDivConstOn(f, c, A)
    apply complexDivConstOn.membership.backward
    exact ⟨x, member, rfl⟩
  have pairs : ∀ p ∈ complexDivConstOn(f, c, A), ∃ a, ∃ b, p = (a, b)
    intros p hp
    obtain ⟨k0, hk, pEq⟩ := complexDivConstOn.membership.forward with hp
    rw ← pEq
    exact ⟨k0, complexDiv(f(k0), c), rfl⟩
  have functional : ∀ a, ∀ b, ∀ e, (a, b) ∈ complexDivConstOn(f, c, A) → (a, e) ∈ complexDivConstOn(f, c, A) → b = e
    intros a b e hb hc
    obtain ⟨k0, hk, bEq⟩ := complexDivConstOn.membership.forward with hb
    obtain ⟨m0, hm, cEq⟩ := complexDivConstOn.membership.forward with hc
    obtain ⟨ka, bb⟩ := orderedPair.injective with bEq
    obtain ⟨ma, ee⟩ := orderedPair.injective with cEq
    rw [← bb, ← ee, ka, ← ma]
  exact pairGraph.apply with pairs, functional, edge

theorem complexMulOn.boch_apply (f g A x : Set)
  requires member : x ∈ A
  shows complexMulOn(f, g, A)(x) = ℂ[f(x) * g(x)]
proof
  have edge : (x, ℂ[f(x) * g(x)]) ∈ complexMulOn(f, g, A)
    apply complexMulOn.membership.backward
    exact ⟨x, member, rfl⟩
  have pairs : ∀ p ∈ complexMulOn(f, g, A), ∃ a, ∃ b, p = (a, b)
    intros p hp
    obtain ⟨k0, hk, pEq⟩ := complexMulOn.membership.forward with hp
    rw ← pEq
    exact ⟨k0, ℂ[f(k0) * g(k0)], rfl⟩
  have functional : ∀ a, ∀ b, ∀ c, (a, b) ∈ complexMulOn(f, g, A) → (a, c) ∈ complexMulOn(f, g, A) → b = c
    intros a b c hb hc
    obtain ⟨k0, hk, bEq⟩ := complexMulOn.membership.forward with hb
    obtain ⟨m0, hm, cEq⟩ := complexMulOn.membership.forward with hc
    obtain ⟨ka, bb⟩ := orderedPair.injective with bEq
    obtain ⟨ma, cc⟩ := orderedPair.injective with cEq
    rw [← bb, ← cc, ka, ← ma]
  exact pairGraph.apply with pairs, functional, edge

theorem complexConjOn.boch_apply (f A x : Set)
  requires member : x ∈ A
  shows complexConjOn(f, A)(x) = complexConj(f(x))
proof
  have edge : (x, complexConj(f(x))) ∈ complexConjOn(f, A)
    apply complexConjOn.membership.backward
    exact ⟨x, member, rfl⟩
  have pairs : ∀ p ∈ complexConjOn(f, A), ∃ a, ∃ b, p = (a, b)
    intros p hp
    obtain ⟨k0, hk, pEq⟩ := complexConjOn.membership.forward with hp
    rw ← pEq
    exact ⟨k0, complexConj(f(k0)), rfl⟩
  have functional : ∀ a, ∀ b, ∀ c, (a, b) ∈ complexConjOn(f, A) → (a, c) ∈ complexConjOn(f, A) → b = c
    intros a b c hb hc
    obtain ⟨k0, hk, bEq⟩ := complexConjOn.membership.forward with hb
    obtain ⟨m0, hm, cEq⟩ := complexConjOn.membership.forward with hc
    obtain ⟨ka, bb⟩ := orderedPair.injective with bEq
    obtain ⟨ma, cc⟩ := orderedPair.injective with cEq
    rw [← bb, ← cc, ka, ← ma]
  exact pairGraph.apply with pairs, functional, edge

theorem complexOfRealOn.boch_apply (f A x : Set)
  requires member : x ∈ A
  shows complexOfRealOn(f, A)(x) = complexOfReal(f(x))
proof
  have edge : (x, complexOfReal(f(x))) ∈ complexOfRealOn(f, A)
    apply complexOfRealOn.membership.backward
    exact ⟨x, member, rfl⟩
  have pairs : ∀ p ∈ complexOfRealOn(f, A), ∃ a, ∃ b, p = (a, b)
    intros p hp
    obtain ⟨k0, hk, pEq⟩ := complexOfRealOn.membership.forward with hp
    rw ← pEq
    exact ⟨k0, complexOfReal(f(k0)), rfl⟩
  have functional : ∀ a, ∀ b, ∀ c, (a, b) ∈ complexOfRealOn(f, A) → (a, c) ∈ complexOfRealOn(f, A) → b = c
    intros a b c hb hc
    obtain ⟨k0, hk, bEq⟩ := complexOfRealOn.membership.forward with hb
    obtain ⟨m0, hm, cEq⟩ := complexOfRealOn.membership.forward with hc
    obtain ⟨ka, bb⟩ := orderedPair.injective with bEq
    obtain ⟨ma, cc⟩ := orderedPair.injective with cEq
    rw [← bb, ← cc, ka, ← ma]
  exact pairGraph.apply with pairs, functional, edge

theorem ennToReal.boch_member (a : Set)
  requires member : a ∈ ennreal
  shows ennToReal(a) ∈ ℝ
proof
  have c := ennreal.cases with member
  cases c with top | fin
  . rw top
    rw ennToReal.top
    typecheck
  . have nt := ennreal.not_top_of_real with fin.left
    have e := ennToReal.of_finite with member, nt
    rw e.left
    exact fin.left

theorem realIntegralValue.boch_member (X μ f : Set)
  shows realIntegralValue(X, μ, f) ∈ ℝ
proof
  have m1 := lintegral.member_any at X, μ, ennOfRealOn(f, MeasurableSpace.carrier(X))
  have m2 := lintegral.member_any at X, μ,
    ennOfRealOn(realNegOn(f, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X))
  have r1 := ennToReal.boch_member with m1
  have r2 := ennToReal.boch_member with m2
  unfold realIntegralValue
  typecheck

theorem realMeasureIntegral.boch_parts (X μ f : Set)
  requires integrable : RealIntegrable(X, μ, f)
  shows realMeasureIntegral(X, μ, f) = realIntegralValue(X, μ, f)
proof
  have vR := realIntegralValue.boch_member at X, μ, f
  unfold realMeasureIntegral
  apply union.of_unique
  . apply realMeasureIntegral.family.membership.backward
    refine ⟨vR, ?_⟩
    left
    exact ⟨integrable, rfl⟩
  . intros w hw
    obtain ⟨wIn, alt⟩ := realMeasureIntegral.family.membership.forward with hw
    cases alt with p | n
    . exact p.right
    . exfalso
      exact n.left with integrable

theorem realMeasureIntegral.boch_undef (X μ f : Set)
  requires absent : ¬RealIntegrable(X, μ, f)
  shows realMeasureIntegral(X, μ, f) = realZero
proof
  have zR : realZero ∈ ℝ by typecheck
  unfold realMeasureIntegral
  apply union.of_unique
  . apply realMeasureIntegral.family.membership.backward
    refine ⟨zR, ?_⟩
    right
    exact ⟨absent, rfl⟩
  . intros w hw
    obtain ⟨wIn, alt⟩ := realMeasureIntegral.family.membership.forward with hw
    cases alt with p | n
    . exfalso
      exact absent with p.left
    . exact n.right

theorem ennreal.boch_real (a : Set)
  requires member : a ∈ ennreal
  requires finite : a ≠ ennTop
  shows a ∈ ℝ ∧ realZero ≤ a ∧ ennToReal(a) = a
proof
  have f := ennreal.finite with member, finite
  have e := ennToReal.of_finite with member, finite
  exact ⟨f.left, f.right, e.left⟩

theorem EnnLe.boch_real (a b : Set)
  requires le : EnnLe(a, b)
  requires real : b ∈ ℝ
  shows (a:R) ≤ (b:R)
proof
  obtain ⟨aM, bM, alt⟩ := le
  have nt := ennreal.not_top_of_real with real
  cases alt with top | fin
  . exfalso
    exact nt with top
  . exact fin.right

theorem Measurable.boch_value (f X x : Set)
  requires measurable : Measurable(f, X, realMeasurableSpace)
  requires member : x ∈ MeasurableSpace.carrier(X)
  shows f(x) ∈ ℝ
proof
  have m := Measurable.maps with measurable, member
  rw realMeasurableSpace.carrier at m
  exact m

theorem ennOfReal.boch_le_abs (y : Set)
  requires real : y ∈ ℝ
  shows EnnLe(ennOfReal(y), abs(y)) ∧ EnnLe(ennOfReal(R[-y]), abs(y))
proof
  have aR : abs(y) ∈ ℝ by typecheck
  have an := abs.nonnegative at y
  have au := abs.upper at y
  have aun := abs.upper_neg at y
  have aM := ennreal.of_real with aR, an
  have nyR : R[-y] ∈ ℝ by typecheck
  have m1 := ennOfReal.member at y
  have m2 := ennOfReal.member at R[-y]
  constructor
  . unfold EnnLe
    refine ⟨m1.left, aM, ?_⟩
    right
    refine ⟨m1.right, ?_⟩
    by_cases nn : realZero ≤ y
    . rw ennOfReal.value_nonneg with real, nn
      exact au
    . have neg : y < realZero by linarith
      rw ennOfReal.value_neg with real, neg
      exact an
  . unfold EnnLe
    refine ⟨m2.left, aM, ?_⟩
    right
    refine ⟨m2.right, ?_⟩
    by_cases nn : realZero ≤ R[-y]
    . rw ennOfReal.value_nonneg with nyR, nn
      exact aun
    . have neg : R[-y] < realZero by linarith
      rw ennOfReal.value_neg with nyR, neg
      exact an

theorem realAbsOn.boch_values (X f : Set)
  requires measurable : Measurable(f, X, realMeasurableSpace)
  shows EnnValued(X, realAbsOn(f, MeasurableSpace.carrier(X)))
proof
  unfold EnnValued
  unfold MapsInto
  intros x hx
  rw realAbsOn.boch_apply with hx
  have fx := Measurable.boch_value with measurable, hx
  have aR : abs(f(x)) ∈ ℝ by typecheck
  have an := abs.nonnegative at f(x)
  exact ennreal.of_real with aR, an

theorem ennOfRealOn.boch_values (X f : Set)
  requires values : ∀ x ∈ MeasurableSpace.carrier(X), f(x) ∈ ℝ
  shows EnnValued(X, ennOfRealOn(f, MeasurableSpace.carrier(X)))
proof
  unfold EnnValued
  unfold MapsInto
  intros x hx
  rw ennOfRealOn.boch_apply with hx
  have fx := values with x, hx
  have m := ennOfReal.member at f(x)
  exact m.left

theorem realNegOn.boch_values (X f : Set)
  requires values : ∀ x ∈ MeasurableSpace.carrier(X), f(x) ∈ ℝ
  shows ∀ x ∈ MeasurableSpace.carrier(X), realNegOn(f, MeasurableSpace.carrier(X))(x) ∈ ℝ
proof
  intros x hx
  rw realNegOn.boch_apply with hx
  have fx := values with x, hx
  typecheck

theorem RealIntegrable.boch_finite (X μ f : Set)
  requires integrable : RealIntegrable(X, μ, f)
  shows lintegral(X, μ, ennOfRealOn(f, MeasurableSpace.carrier(X))) ≠ ennTop ∧
    lintegral(X, μ, ennOfRealOn(realNegOn(f, MeasurableSpace.carrier(X)),
      MeasurableSpace.carrier(X))) ≠ ennTop
proof
  obtain ⟨measure, measurable, finite⟩ := integrable
  have values : ∀ x ∈ MeasurableSpace.carrier(X), f(x) ∈ ℝ
    intros x hx
    exact Measurable.boch_value with measurable, hx
  have nvalues := realNegOn.boch_values with values
  have vA := realAbsOn.boch_values with measurable
  have vP := ennOfRealOn.boch_values with values
  have vN := ennOfRealOn.boch_values with nvalues
  have leP : ∀ x ∈ MeasurableSpace.carrier(X), EnnLe(ennOfRealOn(f, MeasurableSpace.carrier(X))(x),
      realAbsOn(f, MeasurableSpace.carrier(X))(x))
    intros x hx
    rw ennOfRealOn.boch_apply with hx
    rw realAbsOn.boch_apply with hx
    have b := ennOfReal.boch_le_abs with (values with x, hx)
    exact b.left
  have leN : ∀ x ∈ MeasurableSpace.carrier(X), EnnLe(ennOfRealOn(realNegOn(f, MeasurableSpace.carrier(X)),
      MeasurableSpace.carrier(X))(x), realAbsOn(f, MeasurableSpace.carrier(X))(x))
    intros x hx
    rw ennOfRealOn.boch_apply with hx
    rw realAbsOn.boch_apply with hx
    rw realNegOn.boch_apply with hx
    have b := ennOfReal.boch_le_abs with (values with x, hx)
    exact b.right
  have mP := lintegral.mono with measure, vP, vA, leP
  have mN := lintegral.mono with measure, vN, vA, leN
  constructor
  . intro top
    rw top at mP
    have t := EnnLe.top_eq with mP
    exact finite with t
  . intro top
    rw top at mN
    have t := EnnLe.top_eq with mN
    exact finite with t

theorem ennToReal.boch_nonneg (a : Set)
  requires member : a ∈ ennreal
  shows realZero ≤ ennToReal(a)
proof
  have c := ennreal.cases with member
  cases c with top | fin
  . rw top
    rw ennToReal.top
    have zR : realZero ∈ ℝ by typecheck
    linarith
  . have nt := ennreal.not_top_of_real with fin.left
    have e := ennToReal.of_finite with member, nt
    exact e.right

theorem ennToReal.boch_zero
  shows ennToReal(realZero) = realZero
proof
  have m := ennreal.zero_member
  have n := ennreal.zero_not_top
  have e := ennToReal.of_finite with m, n
  exact e.left

theorem ennOfReal.boch_nonpos (y : Set)
  requires real : y ∈ ℝ
  requires nonpos : y ≤ realZero
  shows ennOfReal(y) = realZero
proof
  by_cases neg : y < realZero
  . exact ennOfReal.value_neg with real, neg
  . have zero : y = realZero by linarith
    have zR : realZero ∈ ℝ by typecheck
    have zz : realZero ≤ realZero by linarith
    rw zero
    exact ennOfReal.value_nonneg with zR, zz

theorem realNegOn.boch_lint_zero (X μ f : Set)
  requires measure : Measure(X, μ)
  requires values : ∀ x ∈ MeasurableSpace.carrier(X), f(x) ∈ ℝ
  requires nonneg : ∀ x ∈ MeasurableSpace.carrier(X), realZero ≤ f(x)
  shows lintegral(X, μ, ennOfRealOn(realNegOn(f, MeasurableSpace.carrier(X)),
    MeasurableSpace.carrier(X))) = realZero
proof
  have agree : ∀ x ∈ MeasurableSpace.carrier(X),
      ennOfRealOn(realNegOn(f, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X))(x) =
      constantOn(MeasurableSpace.carrier(X), realZero)(x)
    intros x hx
    rw ennOfRealOn.boch_apply with hx
    rw realNegOn.boch_apply with hx
    rw constantOn.apply with hx
    have fx := values with x, hx
    have n := nonneg with x, hx
    have nR : R[-f(x)] ∈ ℝ by typecheck
    have np : R[-f(x)] ≤ realZero by linarith
    exact ennOfReal.boch_nonpos with nR, np
  rw lintegral.congr at X, μ with agree
  exact lintegral.zero with measure

theorem RealIntegrable.boch_congr (X μ f g : Set)
  requires integrable : RealIntegrable(X, μ, f)
  requires agree : ∀ x ∈ MeasurableSpace.carrier(X), f(x) = g(x)
  shows RealIntegrable(X, μ, g)
proof
  obtain ⟨measure, measurable, finite⟩ := integrable
  have mg := Measurable.congr with measurable, agree
  have absEq : ∀ x ∈ MeasurableSpace.carrier(X),
      realAbsOn(f, MeasurableSpace.carrier(X))(x) = realAbsOn(g, MeasurableSpace.carrier(X))(x)
    intros x hx
    rw realAbsOn.boch_apply at f, MeasurableSpace.carrier(X), x with hx
    rw realAbsOn.boch_apply at g, MeasurableSpace.carrier(X), x with hx
    rw agree with x, hx
  have e := lintegral.congr at X, μ with absEq
  rw e at finite
  exact ⟨measure, mg, finite⟩

theorem realMeasureIntegral.boch_congr (X μ f g : Set)
  requires agree : ∀ x ∈ MeasurableSpace.carrier(X), f(x) = g(x)
  shows realMeasureIntegral(X, μ, f) = realMeasureIntegral(X, μ, g)
proof
  have back : ∀ x ∈ MeasurableSpace.carrier(X), g(x) = f(x)
    intros x hx
    rw agree with x, hx
  by_cases i : RealIntegrable(X, μ, f)
  . have ig := RealIntegrable.boch_congr with i, agree
    rw realMeasureIntegral.boch_parts with i
    rw realMeasureIntegral.boch_parts with ig
    have pEq : ∀ x ∈ MeasurableSpace.carrier(X),
        ennOfRealOn(f, MeasurableSpace.carrier(X))(x) = ennOfRealOn(g, MeasurableSpace.carrier(X))(x)
      intros x hx
      rw ennOfRealOn.boch_apply at f, MeasurableSpace.carrier(X), x with hx
      rw ennOfRealOn.boch_apply at g, MeasurableSpace.carrier(X), x with hx
      rw agree with x, hx
    have nEq : ∀ x ∈ MeasurableSpace.carrier(X),
        ennOfRealOn(realNegOn(f, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X))(x) =
        ennOfRealOn(realNegOn(g, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X))(x)
      intros x hx
      rw ennOfRealOn.boch_apply at realNegOn(f, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X), x with hx
      rw ennOfRealOn.boch_apply at realNegOn(g, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X), x with hx
      rw realNegOn.boch_apply at f, MeasurableSpace.carrier(X), x with hx
      rw realNegOn.boch_apply at g, MeasurableSpace.carrier(X), x with hx
      rw agree with x, hx
    unfold realIntegralValue
    rw lintegral.congr at X, μ with pEq
    rw lintegral.congr at X, μ with nEq
  . have ng : ¬RealIntegrable(X, μ, g)
      intro ig
      exact i with (RealIntegrable.boch_congr with ig, back)
    rw realMeasureIntegral.boch_undef with i
    rw realMeasureIntegral.boch_undef with ng

-- Section: Laws of the real integral
theorem realMeasureIntegral.member (X μ f : Set)
  shows realMeasureIntegral(X, μ, f) ∈ ℝ
proof
  by_cases i : RealIntegrable(X, μ, f)
  . rw realMeasureIntegral.boch_parts with i
    exact realIntegralValue.boch_member at X, μ, f
  . rw realMeasureIntegral.boch_undef with i
    typecheck

theorem realMeasureIntegral.undef (X μ f : Set)
  requires absent : ¬RealIntegrable(X, μ, f)
  shows realMeasureIntegral(X, μ, f) = realZero
proof
  exact realMeasureIntegral.boch_undef with absent

-- Mathlib's Integrable.mono': a measurable map bounded by an integrable
-- one is integrable.
theorem RealIntegrable.of_bound (X μ f g : Set)
  requires measurable : Measurable(f, X, realMeasurableSpace)
  requires integrable : RealIntegrable(X, μ, g)
  requires bound : AlmostEverywhere(X, μ, realAbsBoundSet(f, g, MeasurableSpace.carrier(X)))
  shows RealIntegrable(X, μ, f)
proof
  sorry

theorem realMeasureIntegral.add (X μ f g h : Set)
  requires integrableF : RealIntegrable(X, μ, f)
  requires integrableG : RealIntegrable(X, μ, g)
  requires sum : ∀ x ∈ MeasurableSpace.carrier(X), h(x) = R[f(x) + g(x)]
  shows realMeasureIntegral(X, μ, h) =
    R[realMeasureIntegral(X, μ, f) + realMeasureIntegral(X, μ, g)]
proof
  sorry

theorem realMeasureIntegral.const_mul (X μ f h : Set, c : Real)
  requires product : ∀ x ∈ MeasurableSpace.carrier(X), h(x) = R[c * f(x)]
  requires values : ∀ x ∈ MeasurableSpace.carrier(X), f(x) ∈ ℝ
  shows realMeasureIntegral(X, μ, h) = R[c * realMeasureIntegral(X, μ, f)]
proof
  sorry

-- Mathlib's integral_mono and integral_mono_ae.
theorem realMeasureIntegral.mono (X μ f g : Set)
  requires integrableF : RealIntegrable(X, μ, f)
  requires integrableG : RealIntegrable(X, μ, g)
  requires le : AlmostEverywhere(X, μ, realLeLocus(f, g, MeasurableSpace.carrier(X)))
  shows (realMeasureIntegral(X, μ, f):R) ≤ (realMeasureIntegral(X, μ, g):R)
proof
  sorry

-- Mathlib's integral_nonneg (no integrability needed).
theorem realMeasureIntegral.nonneg (X μ f : Set)
  requires measure : Measure(X, μ)
  requires nonneg : ∀ x ∈ MeasurableSpace.carrier(X), realZero ≤ f(x)
  shows realZero ≤ realMeasureIntegral(X, μ, f)
proof
  by_cases i : RealIntegrable(X, μ, f)
  . have i2 := i
    obtain ⟨m, measurable, finite⟩ := i2
    have values : ∀ x ∈ MeasurableSpace.carrier(X), f(x) ∈ ℝ
      intros x hx
      exact Measurable.boch_value with measurable, hx
    rw realMeasureIntegral.boch_parts with i
    unfold realIntegralValue
    rw realNegOn.boch_lint_zero with measure, values, nonneg
    rw ennToReal.boch_zero
    have pM := lintegral.member_any at X, μ, ennOfRealOn(f, MeasurableSpace.carrier(X))
    have pR := ennToReal.boch_member with pM
    have pN := ennToReal.boch_nonneg with pM
    have zR : realZero ∈ ℝ by typecheck
    linarith
  . rw realMeasureIntegral.boch_undef with i
    have zR : realZero ∈ ℝ by typecheck
    linarith

-- Mathlib's integral_eq_lintegral_of_nonneg_ae and
-- ofReal_integral_eq_lintegral_ofReal: for a nonnegative measurable map
-- the integral is the real value of the lower integral.
theorem realMeasureIntegral.eq_lintegral (X μ f : Set)
  requires measure : Measure(X, μ)
  requires measurable : Measurable(f, X, realMeasurableSpace)
  requires nonneg : ∀ x ∈ MeasurableSpace.carrier(X), realZero ≤ f(x)
  shows realMeasureIntegral(X, μ, f) = ennToReal(lintegral(X, μ, f))
proof
  have values : ∀ x ∈ MeasurableSpace.carrier(X), f(x) ∈ ℝ
    intros x hx
    exact Measurable.boch_value with measurable, hx
  have posEq : ∀ x ∈ MeasurableSpace.carrier(X), ennOfRealOn(f, MeasurableSpace.carrier(X))(x) = f(x)
    intros x hx
    rw ennOfRealOn.boch_apply with hx
    exact ennOfReal.value_nonneg with (values with x, hx), (nonneg with x, hx)
  have absEq : ∀ x ∈ MeasurableSpace.carrier(X), realAbsOn(f, MeasurableSpace.carrier(X))(x) = f(x)
    intros x hx
    rw realAbsOn.boch_apply with hx
    have fx := values with x, hx
    have n := nonneg with x, hx
    exact abs.of_nonnegative at f(x) with n
  have lP := lintegral.congr at X, μ with posEq
  have lA := lintegral.congr at X, μ with absEq
  by_cases fin : lintegral(X, μ, f) = ennTop
  . have ni : ¬RealIntegrable(X, μ, f)
      intro i
      obtain ⟨m, mm, finite⟩ := i
      rw lA at finite
      exact finite with fin
    rw realMeasureIntegral.boch_undef with ni
    rw fin
    rw ennToReal.top
  . have i : RealIntegrable(X, μ, f)
      unfold RealIntegrable
      rw lA
      exact ⟨measure, measurable, fin⟩
    rw realMeasureIntegral.boch_parts with i
    unfold realIntegralValue
    rw realNegOn.boch_lint_zero with measure, values, nonneg
    rw ennToReal.boch_zero
    rw lP
    have pM := lintegral.member_any at X, μ, f
    have pR := ennToReal.boch_member with pM
    ring

theorem realMeasureIntegral.of_real_eq_lintegral (X μ f : Set)
  requires integrable : RealIntegrable(X, μ, f)
  requires nonneg : ∀ x ∈ MeasurableSpace.carrier(X), realZero ≤ f(x)
  shows ennOfReal(realMeasureIntegral(X, μ, f)) = lintegral(X, μ, f)
proof
  have i2 := integrable
  obtain ⟨measure, measurable, finite⟩ := i2
  rw realMeasureIntegral.eq_lintegral with measure, measurable, nonneg
  have absEq : ∀ x ∈ MeasurableSpace.carrier(X), realAbsOn(f, MeasurableSpace.carrier(X))(x) = f(x)
    intros x hx
    rw realAbsOn.boch_apply with hx
    have fx := Measurable.boch_value with measurable, hx
    have n := nonneg with x, hx
    exact abs.of_nonnegative at f(x) with n
  have lA := lintegral.congr at X, μ with absEq
  rw lA at finite
  have lM := lintegral.member at X, μ, f with measure
  have r := ennreal.boch_real with lM, finite
  obtain ⟨lR, lN, lE⟩ := r
  rw lE
  exact ennOfReal.value_nonneg with lR, lN

-- Mathlib's integral_eq_lintegral_pos_part_sub_lintegral_neg_part.
theorem realMeasureIntegral.eq_parts (X μ f : Set)
  requires integrable : RealIntegrable(X, μ, f)
  shows realMeasureIntegral(X, μ, f) = realIntegralValue(X, μ, f)
proof
  exact realMeasureIntegral.boch_parts with integrable

-- Mathlib's integral_eq_zero_iff_of_nonneg and
-- integral_pos_iff_support_of_nonneg.
theorem realMeasureIntegral.eq_zero_iff_of_nonneg (X μ f : Set)
  requires integrable : RealIntegrable(X, μ, f)
  requires nonneg : ∀ x ∈ MeasurableSpace.carrier(X), realZero ≤ f(x)
  shows realMeasureIntegral(X, μ, f) = realZero ↔
    AEEqual(X, μ, f, constantOn(MeasurableSpace.carrier(X), realZero))
proof
  sorry

theorem realMeasureIntegral.pos_iff_of_nonneg (X μ f : Set)
  requires integrable : RealIntegrable(X, μ, f)
  requires nonneg : ∀ x ∈ MeasurableSpace.carrier(X), realZero ≤ f(x)
  shows realZero < realMeasureIntegral(X, μ, f) ↔
    μ(realGtSet(f, MeasurableSpace.carrier(X), realZero)) ≠ realZero
proof
  sorry

-- Mathlib's integral_const: ∫ c = μ(X) c on a finite measure.
theorem realMeasureIntegral.const (X μ : Set, c : Real)
  requires finite : FiniteMeasure(X, μ)
  shows realMeasureIntegral(X, μ, constantOn(MeasurableSpace.carrier(X), c)) =
    R[measureReal(μ, MeasurableSpace.carrier(X)) * c]
proof
  sorry

-- Mathlib's Integrable.measure_le_integral / integral_indicator_one:
-- ∫ 1_A = μ(A).
theorem realMeasureIntegral.indicator_one (X μ A : Set)
  requires measure : Measure(X, μ)
  requires set : MeasurableSet(X, A)
  shows realMeasureIntegral(X, μ, indicatorOn(MeasurableSpace.carrier(X), A, realOne,
    realZero)) = measureReal(μ, A)
proof
  have space := Measure.space with measure
  have oR : realOne ∈ ℝ by typecheck
  have zR : realZero ∈ ℝ by typecheck
  have measurable := Measurable.indicator with space, set, oR, zR
  have nonneg : ∀ x ∈ MeasurableSpace.carrier(X),
      realZero ≤ indicatorOn(MeasurableSpace.carrier(X), A, realOne, realZero)(x)
    intros x hx
    have ap := indicatorOn.apply at MeasurableSpace.carrier(X), A, realOne, realZero, x with hx
    by_cases xA : x ∈ A
    . rw ap.left with xA
      linarith
    . rw ap.right with xA
      linarith
  rw realMeasureIntegral.eq_lintegral with measure, measurable, nonneg
  have oM : realOne ∈ ennreal
    have oN : realZero ≤ realOne by linarith
    exact ennreal.of_real with oR, oN
  rw lintegral.indicator_const with measure, set, oM
  have mA := Measure.member with measure, set
  rw ennMul.one with mA
  unfold measureReal
  rfl

-- Section: Laws of the complex integral
theorem complexMeasureIntegral.member (X μ f : Set)
  shows complexMeasureIntegral(X, μ, f) ∈ complexCarrier
proof
  sorry

theorem complexMeasureIntegral.undef (X μ f : Set)
  requires absent : ¬ComplexIntegrable(X, μ, f)
  shows complexMeasureIntegral(X, μ, f) = complexZero
proof
  sorry

-- Mathlib's integral_re, integral_im, integral_complex_ofReal,
-- integral_ofReal.
theorem complexMeasureIntegral.re (X μ f : Set)
  requires integrable : ComplexIntegrable(X, μ, f)
  shows complexRe(complexMeasureIntegral(X, μ, f)) =
    realMeasureIntegral(X, μ, realPartOn(f, MeasurableSpace.carrier(X)))
proof
  sorry

theorem complexMeasureIntegral.im (X μ f : Set)
  requires integrable : ComplexIntegrable(X, μ, f)
  shows complexIm(complexMeasureIntegral(X, μ, f)) =
    realMeasureIntegral(X, μ, imagPartOn(f, MeasurableSpace.carrier(X)))
proof
  sorry

theorem complexMeasureIntegral.of_real (X μ f : Set)
  requires values : ∀ x ∈ MeasurableSpace.carrier(X), f(x) ∈ ℝ
  shows complexMeasureIntegral(X, μ, complexOfRealOn(f, MeasurableSpace.carrier(X))) =
    complexOfReal(realMeasureIntegral(X, μ, f))
proof
  sorry

-- Mathlib's integral_conj.
theorem complexMeasureIntegral.conj (X μ f : Set)
  requires values : ∀ x ∈ MeasurableSpace.carrier(X), f(x) ∈ complexCarrier
  shows complexMeasureIntegral(X, μ, complexConjOn(f, MeasurableSpace.carrier(X))) =
    complexConj(complexMeasureIntegral(X, μ, f))
proof
  sorry

-- Mathlib's integral_add, integral_sub, integral_neg.
theorem complexMeasureIntegral.add (X μ f g : Set)
  requires integrableF : ComplexIntegrable(X, μ, f)
  requires integrableG : ComplexIntegrable(X, μ, g)
  shows complexMeasureIntegral(X, μ, complexAddOn(f, g, MeasurableSpace.carrier(X))) =
    ℂ[complexMeasureIntegral(X, μ, f) + complexMeasureIntegral(X, μ, g)]
proof
  sorry

theorem complexMeasureIntegral.sub (X μ f g : Set)
  requires integrableF : ComplexIntegrable(X, μ, f)
  requires integrableG : ComplexIntegrable(X, μ, g)
  shows complexMeasureIntegral(X, μ, complexSubOn(f, g, MeasurableSpace.carrier(X))) =
    ℂ[complexMeasureIntegral(X, μ, f) - complexMeasureIntegral(X, μ, g)]
proof
  sorry

theorem complexMeasureIntegral.neg (X μ f : Set)
  requires values : ∀ x ∈ MeasurableSpace.carrier(X), f(x) ∈ complexCarrier
  shows complexMeasureIntegral(X, μ, complexNegOn(f, MeasurableSpace.carrier(X))) =
    ℂ[-complexMeasureIntegral(X, μ, f)]
proof
  sorry

-- Mathlib's integral_const_mul, integral_mul_const, integral_div,
-- integral_smul: no integrability needed.
theorem complexMeasureIntegral.const_mul (X μ c f : Set)
  requires member : c ∈ complexCarrier
  requires values : ∀ x ∈ MeasurableSpace.carrier(X), f(x) ∈ complexCarrier
  shows complexMeasureIntegral(X, μ, complexConstMulOn(c, f, MeasurableSpace.carrier(X))) =
    ℂ[c * complexMeasureIntegral(X, μ, f)]
proof
  sorry

theorem complexMeasureIntegral.mul_const (X μ c f : Set)
  requires member : c ∈ complexCarrier
  requires values : ∀ x ∈ MeasurableSpace.carrier(X), f(x) ∈ complexCarrier
  shows complexMeasureIntegral(X, μ, complexMulConstOn(f, c, MeasurableSpace.carrier(X))) =
    ℂ[complexMeasureIntegral(X, μ, f) * c]
proof
  sorry

theorem complexMeasureIntegral.div_const (X μ c f : Set)
  requires member : c ∈ complexCarrier
  requires values : ∀ x ∈ MeasurableSpace.carrier(X), f(x) ∈ complexCarrier
  shows complexMeasureIntegral(X, μ, complexDivConstOn(f, c, MeasurableSpace.carrier(X))) =
    complexDiv(complexMeasureIntegral(X, μ, f), c)
proof
  sorry

-- Mathlib's integral_finsetSum.
theorem complexMeasureIntegral.finite_sum (X μ u F : Set)
  requires finite : Finite(F)
  requires integrable : ∀ i ∈ F, ComplexIntegrable(X, μ, u(i))
  shows complexMeasureIntegral(X, μ, complexFiniteSumOn(u, F, MeasurableSpace.carrier(X))) =
    groupFiniteSum(complexAdditiveGroup, F, complexIntegralFamily(X, μ, u, F))
proof
  sorry

-- Mathlib's integral_zero and integral_const.
theorem complexMeasureIntegral.zero (X μ : Set)
  shows complexMeasureIntegral(X, μ, constantOn(MeasurableSpace.carrier(X), complexZero)) =
    complexZero
proof
  sorry

theorem complexMeasureIntegral.const (X μ c : Set)
  requires finite : FiniteMeasure(X, μ)
  requires member : c ∈ complexCarrier
  shows complexMeasureIntegral(X, μ, constantOn(MeasurableSpace.carrier(X), c)) =
    ℂ[complexOfReal(measureReal(μ, MeasurableSpace.carrier(X))) * c]
proof
  sorry

-- Mathlib's integral_congr_ae.
theorem complexMeasureIntegral.congr_ae (X μ f g : Set)
  requires measure : Measure(X, μ)
  requires equal : AEEqual(X, μ, f, g)
  shows complexMeasureIntegral(X, μ, f) = complexMeasureIntegral(X, μ, g)
proof
  sorry

theorem complexMeasureIntegral.congr (X μ f g : Set)
  requires agree : ∀ x ∈ MeasurableSpace.carrier(X), f(x) = g(x)
  shows complexMeasureIntegral(X, μ, f) = complexMeasureIntegral(X, μ, g)
proof
  sorry

-- Mathlib's norm_integral_le_integral_norm and
-- enorm_integral_le_lintegral_enorm.
theorem complexMeasureIntegral.abs_le (X μ f : Set)
  requires measure : Measure(X, μ)
  requires values : ∀ x ∈ MeasurableSpace.carrier(X), f(x) ∈ complexCarrier
  shows complexAbs(complexMeasureIntegral(X, μ, f)) ≤
    realMeasureIntegral(X, μ, complexAbsOn(f, MeasurableSpace.carrier(X)))
proof
  sorry

theorem complexMeasureIntegral.abs_le_lintegral (X μ f : Set)
  requires measure : Measure(X, μ)
  requires values : ∀ x ∈ MeasurableSpace.carrier(X), f(x) ∈ complexCarrier
  shows EnnLe(complexAbs(complexMeasureIntegral(X, μ, f)),
    lintegral(X, μ, complexAbsOn(f, MeasurableSpace.carrier(X))))
proof
  sorry

-- Mathlib's ofReal_integral_norm_eq_lintegral_enorm.
theorem complexMeasureIntegral.norm_eq_lintegral (X μ f : Set)
  requires integrable : ComplexIntegrable(X, μ, f)
  shows realMeasureIntegral(X, μ, complexAbsOn(f, MeasurableSpace.carrier(X))) =
    ennToReal(lintegral(X, μ, complexAbsOn(f, MeasurableSpace.carrier(X))))
proof
  sorry

-- Mathlib's norm_integral_le_of_norm_le and
-- norm_integral_le_of_norm_le_const.
theorem complexMeasureIntegral.abs_le_of_bound (X μ f g : Set)
  requires integrable : RealIntegrable(X, μ, g)
  requires bound : AlmostEverywhere(X, μ, complexBoundSet(f, g, MeasurableSpace.carrier(X)))
  shows complexAbs(complexMeasureIntegral(X, μ, f)) ≤ realMeasureIntegral(X, μ, g)
proof
  sorry

theorem complexMeasureIntegral.abs_le_of_const (X μ f : Set, C : Real)
  requires finite : FiniteMeasure(X, μ)
  requires bound : AlmostEverywhere(X, μ,
    complexBoundSet(f, constantOn(MeasurableSpace.carrier(X), C), MeasurableSpace.carrier(X)))
  shows complexAbs(complexMeasureIntegral(X, μ, f)) ≤
    R[C * measureReal(μ, MeasurableSpace.carrier(X))]
proof
  sorry

-- Mathlib's exists_ne_zero_of_integral_ne_zero and
-- Integrable.of_integral_ne_zero.
theorem complexMeasureIntegral.ne_zero (X μ f : Set)
  requires nonzero : complexMeasureIntegral(X, μ, f) ≠ complexZero
  shows ComplexIntegrable(X, μ, f) ∧
    (∃ x ∈ MeasurableSpace.carrier(X), f(x) ≠ complexZero)
proof
  sorry

-- Section: Integrals over sets
theorem complexSetIntegral.whole (X μ f : Set)
  requires measure : Measure(X, μ)
  shows complexSetIntegral(X, μ, f, MeasurableSpace.carrier(X)) =
    complexMeasureIntegral(X, μ, f)
proof
  sorry

-- Mathlib's integral_indicator.
theorem complexMeasureIntegral.indicator (X μ f A : Set)
  requires measure : Measure(X, μ)
  requires set : MeasurableSet(X, A)
  shows complexMeasureIntegral(X, μ, complexIndicatorOn(MeasurableSpace.carrier(X), A, f)) =
    complexSetIntegral(X, μ, f, A)
proof
  sorry

-- Mathlib's setIntegral_congr_fun.
theorem complexSetIntegral.congr_fun (X μ f g A : Set)
  requires measure : Measure(X, μ)
  requires set : MeasurableSet(X, A)
  requires agree : ∀ x ∈ A, f(x) = g(x)
  shows complexSetIntegral(X, μ, f, A) = complexSetIntegral(X, μ, g, A)
proof
  sorry

-- Mathlib's integral_union, setIntegral_compl and integral_add_compl.
theorem complexSetIntegral.union (X μ f A B : Set)
  requires setA : MeasurableSet(X, A)
  requires setB : MeasurableSet(X, B)
  requires disjoint : Disjoint(A, B)
  requires integrableA : ComplexIntegrableOn(X, μ, f, A)
  requires integrableB : ComplexIntegrableOn(X, μ, f, B)
  shows complexSetIntegral(X, μ, f, A ∪ B) =
    ℂ[complexSetIntegral(X, μ, f, A) + complexSetIntegral(X, μ, f, B)]
proof
  sorry

theorem complexSetIntegral.add_compl (X μ f A : Set)
  requires set : MeasurableSet(X, A)
  requires integrable : ComplexIntegrable(X, μ, f)
  shows ℂ[complexSetIntegral(X, μ, f, A) +
      complexSetIntegral(X, μ, f, MeasurableSpace.carrier(X) ∖ A)] =
    complexMeasureIntegral(X, μ, f)
proof
  sorry

-- Mathlib's setIntegral_eq_integral_of_forall_compl_eq_zero and
-- setIntegral_eq_zero_of_forall_eq_zero.
theorem complexSetIntegral.eq_of_vanishing (X μ f A : Set)
  requires measure : Measure(X, μ)
  requires set : MeasurableSet(X, A)
  requires vanishes : ∀ x ∈ MeasurableSpace.carrier(X) ∖ A, f(x) = complexZero
  shows complexSetIntegral(X, μ, f, A) = complexMeasureIntegral(X, μ, f)
proof
  sorry

theorem complexSetIntegral.eq_zero (X μ f A : Set)
  requires measure : Measure(X, μ)
  requires set : MeasurableSet(X, A)
  requires vanishes : ∀ x ∈ A, f(x) = complexZero
  shows complexSetIntegral(X, μ, f, A) = complexZero
proof
  sorry

-- Mathlib's hasSum_integral_iUnion: over a disjoint sequence of sets.
theorem complexSetIntegral.sequence_union (X μ f S : Set)
  requires sets : ∀ n ∈ ℕ, MeasurableSet(X, S(n))
  requires disjoint : PairwiseDisjointSequence(S)
  requires integrable : ComplexIntegrableOn(X, μ, f, sequenceUnion(S))
  shows ComplexHasSum(complexSetIntegralSequence(X, μ, f, S), ℕ,
    complexSetIntegral(X, μ, f, sequenceUnion(S)))
proof
  sorry

-- Section: Change of measure
-- Mathlib's integral_map: for f measurable and g strongly measurable.
theorem complexMeasureIntegral.map (g f X μ Y : Set)
  requires measure : Measure(X, μ)
  requires measurableF : Measurable(f, X, Y)
  requires measurableG : Measurable(g, Y, complexMeasurableSpace)
  shows complexMeasureIntegral(Y, mapMeasure(f, X, μ, Y), g) =
    complexMeasureIntegral(X, μ, composeOn(g, f, MeasurableSpace.carrier(X)))
proof
  sorry

-- Mathlib's MeasurePreserving.integral_comp' and integral_map_equiv:
-- along a measure-preserving embedding no measurability of g is needed.
theorem MeasurePreserving.integral_comp (g f X μ Y ν : Set)
  requires preserving : MeasurePreserving(f, X, μ, Y, ν)
  requires embedding : MeasurableEmbedding(f, X, Y)
  shows complexMeasureIntegral(X, μ, composeOn(g, f, MeasurableSpace.carrier(X))) =
    complexMeasureIntegral(Y, ν, g)
proof
  sorry

theorem MeasurePreserving.integrable_comp (g f X μ Y ν : Set)
  requires preserving : MeasurePreserving(f, X, μ, Y, ν)
  requires integrable : ComplexIntegrable(Y, ν, g)
  shows ComplexIntegrable(X, μ, composeOn(g, f, MeasurableSpace.carrier(X)))
proof
  sorry

-- Mathlib's integral_smul_measure.
theorem complexMeasureIntegral.smul_measure (X μ f : Set, c : Real)
  requires measure : Measure(X, μ)
  requires nonneg : realZero ≤ c
  shows complexMeasureIntegral(X, smulMeasure(c, X, μ), f) =
    ℂ[complexOfReal(c) * complexMeasureIntegral(X, μ, f)]
proof
  sorry

-- Mathlib's integral_dirac for a measurable map.
theorem complexMeasureIntegral.dirac (X a f : Set)
  requires space : MeasurableSpace(X)
  requires member : a ∈ MeasurableSpace.carrier(X)
  requires measurable : Measurable(f, X, complexMeasurableSpace)
  shows complexMeasureIntegral(X, diracMeasure(X, a), f) = f(a)
proof
  sorry

-- Mathlib's integral_count / integral_fintype: against the counting
-- measure of a finite discrete space the integral is the finite sum.
theorem complexMeasureIntegral.count_finite (X f : Set)
  requires space : MeasurableSpace(X)
  requires discrete : MeasurableSpace.sets(X) = 𝒫(MeasurableSpace.carrier(X))
  requires finite : Finite(MeasurableSpace.carrier(X))
  requires values : ∀ x ∈ MeasurableSpace.carrier(X), f(x) ∈ complexCarrier
  shows complexMeasureIntegral(X, countMeasure(X), f) =
    groupFiniteSum(complexAdditiveGroup, MeasurableSpace.carrier(X), f)
proof
  sorry

-- Mathlib's integrable_count_iff: against the counting measure on a
-- discrete space integrable means absolutely summable, and the integral
-- is the sum.
theorem ComplexIntegrable.count_iff (X f : Set)
  requires space : MeasurableSpace(X)
  requires discrete : MeasurableSpace.sets(X) = 𝒫(MeasurableSpace.carrier(X))
  requires values : ∀ x ∈ MeasurableSpace.carrier(X), f(x) ∈ complexCarrier
  shows ComplexIntegrable(X, countMeasure(X), f) ↔
    RealSummable(complexAbsOn(f, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X))
proof
  sorry

theorem complexMeasureIntegral.count (X f : Set)
  requires space : MeasurableSpace(X)
  requires discrete : MeasurableSpace.sets(X) = 𝒫(MeasurableSpace.carrier(X))
  requires integrable : ComplexIntegrable(X, countMeasure(X), f)
  shows ComplexHasSum(f, MeasurableSpace.carrier(X),
    complexMeasureIntegral(X, countMeasure(X), f))
proof
  sorry

-- Section: Integrability
theorem ComplexIntegrable.measure (X μ f : Set)
  requires integrable : ComplexIntegrable(X, μ, f)
  shows Measure(X, μ)
proof
  sorry

-- Mathlib's Integrable.mono': a measurable map dominated almost everywhere
-- by an integrable real map is integrable.
theorem ComplexIntegrable.of_bound (X μ f g : Set)
  requires measurable : Measurable(f, X, complexMeasurableSpace)
  requires integrable : RealIntegrable(X, μ, g)
  requires bound : AlmostEverywhere(X, μ, complexBoundSet(f, g, MeasurableSpace.carrier(X)))
  shows ComplexIntegrable(X, μ, f)
proof
  sorry

-- Mathlib's Integrable.add, Integrable.const_mul, integrable_const_mul_iff,
-- integrable_mul_const_iff, integrable_finsetSum.
theorem ComplexIntegrable.add (X μ f g : Set)
  requires integrableF : ComplexIntegrable(X, μ, f)
  requires integrableG : ComplexIntegrable(X, μ, g)
  shows ComplexIntegrable(X, μ, complexAddOn(f, g, MeasurableSpace.carrier(X)))
proof
  sorry

theorem ComplexIntegrable.const_mul_iff (X μ c f : Set)
  requires member : c ∈ complexCarrier
  requires nonzero : c ≠ complexZero
  requires values : ∀ x ∈ MeasurableSpace.carrier(X), f(x) ∈ complexCarrier
  shows ComplexIntegrable(X, μ, complexConstMulOn(c, f, MeasurableSpace.carrier(X))) ↔
    ComplexIntegrable(X, μ, f)
proof
  sorry

theorem ComplexIntegrable.const_mul (X μ c f : Set)
  requires member : c ∈ complexCarrier
  requires integrable : ComplexIntegrable(X, μ, f)
  shows ComplexIntegrable(X, μ, complexConstMulOn(c, f, MeasurableSpace.carrier(X))) ∧
    ComplexIntegrable(X, μ, complexMulConstOn(f, c, MeasurableSpace.carrier(X)))
proof
  sorry

theorem ComplexIntegrable.finite_sum (X μ u F : Set)
  requires finite : Finite(F)
  requires integrable : ∀ i ∈ F, ComplexIntegrable(X, μ, u(i))
  shows ComplexIntegrable(X, μ, complexFiniteSumOn(u, F, MeasurableSpace.carrier(X)))
proof
  sorry

-- Mathlib's Integrable.bdd_mul and Integrable.mul_of_top_left: an
-- integrable map times a bounded measurable one.
theorem ComplexIntegrable.bounded_mul (X μ f g : Set, C : Real)
  requires integrable : ComplexIntegrable(X, μ, f)
  requires measurable : Measurable(g, X, complexMeasurableSpace)
  requires bound : ∀ x ∈ MeasurableSpace.carrier(X), complexAbs(g(x)) ≤ C
  shows ComplexIntegrable(X, μ, complexMulOn(g, f, MeasurableSpace.carrier(X)))
proof
  sorry

-- Mathlib's integrable_const on a finite measure, and a bounded
-- measurable map on a finite measure.
theorem ComplexIntegrable.bounded_of_finite (X μ f : Set, C : Real)
  requires finite : FiniteMeasure(X, μ)
  requires measurable : Measurable(f, X, complexMeasurableSpace)
  requires bound : ∀ x ∈ MeasurableSpace.carrier(X), complexAbs(f(x)) ≤ C
  shows ComplexIntegrable(X, μ, f)
proof
  sorry

-- Mathlib's integrable_congr, Integrable.norm, Integrable.re/im, conj.
theorem ComplexIntegrable.congr_ae (X μ f g : Set)
  requires integrable : ComplexIntegrable(X, μ, f)
  requires measurable : Measurable(g, X, complexMeasurableSpace)
  requires equal : AEEqual(X, μ, f, g)
  shows ComplexIntegrable(X, μ, g)
proof
  sorry

theorem ComplexIntegrable.parts (X μ f : Set)
  requires integrable : ComplexIntegrable(X, μ, f)
  shows RealIntegrable(X, μ, realPartOn(f, MeasurableSpace.carrier(X))) ∧
    RealIntegrable(X, μ, imagPartOn(f, MeasurableSpace.carrier(X))) ∧
    RealIntegrable(X, μ, complexAbsOn(f, MeasurableSpace.carrier(X))) ∧
    ComplexIntegrable(X, μ, complexConjOn(f, MeasurableSpace.carrier(X)))
proof
  sorry

theorem ComplexIntegrable.of_parts (X μ f : Set)
  requires values : ∀ x ∈ MeasurableSpace.carrier(X), f(x) ∈ complexCarrier
  requires re : RealIntegrable(X, μ, realPartOn(f, MeasurableSpace.carrier(X)))
  requires im : RealIntegrable(X, μ, imagPartOn(f, MeasurableSpace.carrier(X)))
  shows ComplexIntegrable(X, μ, f)
proof
  sorry

theorem ComplexIntegrable.of_real (X μ f : Set)
  requires integrable : RealIntegrable(X, μ, f)
  shows ComplexIntegrable(X, μ, complexOfRealOn(f, MeasurableSpace.carrier(X)))
proof
  sorry

-- Mathlib's integrable_indicator_iff and IntegrableOn.mono_set.
theorem ComplexIntegrable.indicator_iff (X μ f A : Set)
  requires set : MeasurableSet(X, A)
  requires measure : Measure(X, μ)
  shows ComplexIntegrable(X, μ, complexIndicatorOn(MeasurableSpace.carrier(X), A, f)) ↔
    ComplexIntegrableOn(X, μ, f, A)
proof
  sorry

theorem ComplexIntegrableOn.mono_set (X μ f A B : Set)
  requires integrable : ComplexIntegrableOn(X, μ, f, B)
  requires setA : MeasurableSet(X, A)
  requires inside : A ⊆ B
  shows ComplexIntegrableOn(X, μ, f, A)
proof
  sorry

theorem ComplexIntegrable.integrable_on (X μ f A : Set)
  requires integrable : ComplexIntegrable(X, μ, f)
  requires set : MeasurableSet(X, A)
  shows ComplexIntegrableOn(X, μ, f, A)
proof
  sorry

-- Continuous maps on compact sets, and continuous maps with compact
-- support, are integrable for a measure finite on compacts (Mathlib's
-- ContinuousOn.integrableOn_compact and
-- Continuous.integrable_of_hasCompactSupport).
theorem ComplexIntegrableOn.of_continuous_compact (T μ f K : Set)
  requires measure : Measure(borelSpace(T), μ)
  requires finite : FiniteOnCompacts(T, μ)
  requires hausdorff : Hausdorff(T)
  requires compact : Compact(T, K)
  requires inside : K ⊆ TopologicalSpace.carrier(T)
  requires continuous : f : T ⇒ complexSpace
  shows ComplexIntegrableOn(borelSpace(T), μ, f, K)
proof
  sorry

theorem ComplexIntegrable.of_compact_support (T μ f K : Set)
  requires measure : Measure(borelSpace(T), μ)
  requires finite : FiniteOnCompacts(T, μ)
  requires hausdorff : Hausdorff(T)
  requires compact : Compact(T, K)
  requires inside : K ⊆ TopologicalSpace.carrier(T)
  requires continuous : f : T ⇒ complexSpace
  requires support : ∀ x ∈ TopologicalSpace.carrier(T) ∖ K, f(x) = complexZero
  shows ComplexIntegrable(borelSpace(T), μ, f)
proof
  sorry

-- Mathlib's Continuous.integral_pos_of_hasCompactSupport_nonneg_nonzero:
-- a nonnegative continuous map, positive somewhere, has positive integral
-- against a measure positive on open sets.
theorem realMeasureIntegral.pos_of_continuous (T μ f x : Set)
  requires measure : Measure(borelSpace(T), μ)
  requires positive : OpenPositive(T, μ)
  requires integrable : RealIntegrable(borelSpace(T), μ, f)
  requires continuous : f : T ⇒ realLine
  requires nonneg : ∀ y ∈ TopologicalSpace.carrier(T), realZero ≤ f(y)
  requires member : x ∈ TopologicalSpace.carrier(T)
  requires somewhere : realZero < f(x)
  shows realZero < realMeasureIntegral(borelSpace(T), μ, f)
proof
  sorry

-- Section: Convergence theorems
-- The dominated convergence theorem (Mathlib's
-- tendsto_integral_of_dominated_convergence).
theorem complexMeasureIntegral.dominated_convergence (X μ u f g : Set)
  requires measurable : ∀ n ∈ ℕ, Measurable(u(n), X, complexMeasurableSpace)
  requires integrable : RealIntegrable(X, μ, g)
  requires bound : ∀ n ∈ ℕ, AlmostEverywhere(X, μ,
    complexBoundSet(u(n), g, MeasurableSpace.carrier(X)))
  requires limit : AlmostEverywhere(X, μ, complexConvergenceSet(u, f, MeasurableSpace.carrier(X)))
  requires values : ∀ x ∈ MeasurableSpace.carrier(X), f(x) ∈ complexCarrier
  shows Tendsto(complexIntegralSequence(X, μ, u), ℕ, natAtTop,
    nhds(complexSpace, complexMeasureIntegral(X, μ, f)))
proof
  sorry

-- Mathlib's hasSum_integral_of_dominated_convergence and
-- integral_tsum_of_summable_integral_norm: a series may be integrated
-- termwise when Σ ∫ |u(n)| converges.
theorem complexMeasureIntegral.tsum (X μ u f : Set)
  requires integrable : ∀ n ∈ ℕ, ComplexIntegrable(X, μ, u(n))
  requires summable : RealSummable(complexNormIntegralSequence(X, μ, u), ℕ)
  requires sum : ∀ x ∈ MeasurableSpace.carrier(X), ComplexHasSum(familyAt(u, ℕ, x), ℕ, f(x))
  shows ComplexIntegrable(X, μ, f) ∧
    ComplexHasSum(complexIntegralSequence(X, μ, u), ℕ, complexMeasureIntegral(X, μ, f))
proof
  sorry

-- Mathlib's continuous_of_dominated and continuousOn_of_dominated: an
-- integral depending on a parameter t in a topological space T is
-- continuous when the integrand is continuous in t for almost every x and
-- is dominated by one integrable map.
theorem complexMeasureIntegral.continuous_of_dominated (X μ T F g G : Set)
  requires space : TopologicalSpace(T)
  requires measurable : ∀ t ∈ TopologicalSpace.carrier(T),
    Measurable(F(t), X, complexMeasurableSpace)
  requires integrable : RealIntegrable(X, μ, g)
  requires bound : ∀ t ∈ TopologicalSpace.carrier(T), AlmostEverywhere(X, μ,
    complexBoundSet(F(t), g, MeasurableSpace.carrier(X)))
  requires continuous : AlmostEverywhere(X, μ,
    parameterContinuitySet(F, T, MeasurableSpace.carrier(X)))
  requires integral : ∀ t ∈ TopologicalSpace.carrier(T), G(t) = complexMeasureIntegral(X, μ, F(t))
  shows G : T ⇒ complexSpace
proof
  sorry

-- Section: Square-integrable maps
-- Mathlib's memLp_two_iff_integrable_sq_norm.
theorem SquareIntegrable.iff_integrable_sq (X μ f : Set)
  requires measure : Measure(X, μ)
  requires measurable : Measurable(f, X, complexMeasurableSpace)
  shows SquareIntegrable(X, μ, f) ↔
    RealIntegrable(X, μ, complexAbsSquareOn(f, MeasurableSpace.carrier(X)))
proof
  sorry

-- The product of two square-integrable maps is integrable, and
-- |⟨f, g⟩|² ≤ ⟨f, f⟩ ⟨g, g⟩ (Hölder at p = q = 2, Mathlib's
-- MemLp.integrable_mul and inner_mul_le_norm_mul_norm on L²).
theorem SquareIntegrable.mul (X μ f g : Set)
  requires first : SquareIntegrable(X, μ, f)
  requires second : SquareIntegrable(X, μ, g)
  shows ComplexIntegrable(X, μ, complexMulOn(complexConjOn(f, MeasurableSpace.carrier(X)),
    g, MeasurableSpace.carrier(X)))
proof
  sorry

theorem l2Inner.cauchy_schwarz (X μ f g : Set)
  requires first : SquareIntegrable(X, μ, f)
  requires second : SquareIntegrable(X, μ, g)
  shows R[complexAbs(l2Inner(X, μ, f, g)) * complexAbs(l2Inner(X, μ, f, g))] ≤
    R[complexRe(l2Inner(X, μ, f, f)) * complexRe(l2Inner(X, μ, g, g))]
proof
  sorry

-- ⟨f, f⟩ is the real number ∫ |f|².
theorem l2Inner.self (X μ f : Set)
  requires square : SquareIntegrable(X, μ, f)
  shows l2Inner(X, μ, f, f) = complexOfReal(ennToReal(lintegral(X, μ,
    complexAbsSquareOn(f, MeasurableSpace.carrier(X)))))
proof
  sorry

theorem SquareIntegrable.add (X μ f g : Set)
  requires first : SquareIntegrable(X, μ, f)
  requires second : SquareIntegrable(X, μ, g)
  shows SquareIntegrable(X, μ, complexAddOn(f, g, MeasurableSpace.carrier(X)))
proof
  sorry

-- On a finite measure, L² ⊆ L¹ and bounded measurable maps are in L²
-- (Mathlib's MemLp.mono_exponent, memLp_top_of_bound).
theorem SquareIntegrable.integrable_of_finite (X μ f : Set)
  requires finite : FiniteMeasure(X, μ)
  requires square : SquareIntegrable(X, μ, f)
  shows ComplexIntegrable(X, μ, f)
proof
  sorry

theorem EssentiallyBounded.square_integrable (X μ f : Set)
  requires finite : FiniteMeasure(X, μ)
  requires bounded : EssentiallyBounded(X, μ, f)
  shows SquareIntegrable(X, μ, f)
proof
  sorry

-- Mathlib's average_eq and average_const.
theorem complexAverage.const (X μ c : Set)
  requires finite : FiniteMeasure(X, μ)
  requires nonzero : μ(MeasurableSpace.carrier(X)) ≠ realZero
  requires member : c ∈ complexCarrier
  shows complexAverage(X, μ, constantOn(MeasurableSpace.carrier(X), c)) = c
proof
  sorry

-- Section: Banach-valued integrals
-- Over ℝ and ℂ as Banach spaces over themselves the integral is the real
-- and the complex integral (identification of the encodings).
theorem banachIntegral.real (X μ f : Set)
  requires measure : Measure(X, μ)
  shows banachIntegral(X, μ, realSelfModule, identity(ℝ), realAbs, f) =
    realMeasureIntegral(X, μ, f)
proof
  sorry

theorem banachIntegral.complex (X μ f : Set)
  requires measure : Measure(X, μ)
  shows banachIntegral(X, μ, complexSelfModule, complexOfReal, complexAbs, f) =
    complexMeasureIntegral(X, μ, f)
proof
  sorry

-- The integral is well defined: an integrable map has exactly one
-- integral.
theorem HasBanachIntegral.exists_unique (X μ V K absK conj ofReal norm f : Set)
  requires scalars : RCLike(K, absK, conj, ofReal)
  requires banach : BanachSpace(V, K, absK, norm)
  requires integrable : BanachIntegrable(X, μ, V, norm, f)
  shows HasBanachIntegral(X, μ, V, ofReal, norm, f, banachIntegral(X, μ, V, ofReal, norm, f)) ∧
    (∀ v, HasBanachIntegral(X, μ, V, ofReal, norm, f, v) → v = banachIntegral(X, μ, V, ofReal, norm, f))
proof
  sorry

-- Mathlib's integral_add and norm_integral_le_integral_norm for
-- Banach-valued maps.
theorem banachIntegral.add (X μ V K absK conj ofReal norm f g h : Set)
  requires scalars : RCLike(K, absK, conj, ofReal)
  requires banach : BanachSpace(V, K, absK, norm)
  requires integrableF : BanachIntegrable(X, μ, V, norm, f)
  requires integrableG : BanachIntegrable(X, μ, V, norm, g)
  requires sum : ∀ x ∈ MeasurableSpace.carrier(X), h(x) = Module.add(V)(f(x), g(x))
  shows banachIntegral(X, μ, V, ofReal, norm, h) =
    Module.add(V)(banachIntegral(X, μ, V, ofReal, norm, f),
      banachIntegral(X, μ, V, ofReal, norm, g))
proof
  sorry

theorem banachIntegral.norm_le (X μ V K absK conj ofReal norm f : Set)
  requires scalars : RCLike(K, absK, conj, ofReal)
  requires banach : BanachSpace(V, K, absK, norm)
  requires integrable : BanachIntegrable(X, μ, V, norm, f)
  shows norm(banachIntegral(X, μ, V, ofReal, norm, f)) ≤
    realMeasureIntegral(X, μ, normOn(norm, f, MeasurableSpace.carrier(X)))
proof
  sorry

-- Mathlib's ContinuousLinearMap.integral_comp_comm and integral_inner:
-- a continuous linear map passes through the integral.
theorem banachIntegral.linear_comp (X μ V W K absK conj ofReal normV normW L f : Set)
  requires scalars : RCLike(K, absK, conj, ofReal)
  requires banachV : BanachSpace(V, K, absK, normV)
  requires banachW : BanachSpace(W, K, absK, normW)
  requires linear : ContinuousLinearMap(L, V, normV, W, normW, K)
  requires integrable : BanachIntegrable(X, μ, V, normV, f)
  shows banachIntegral(X, μ, W, ofReal, normW, linearComposeOn(L, f, MeasurableSpace.carrier(X))) =
    L(banachIntegral(X, μ, V, ofReal, normV, f))
proof
  sorry

-- Mathlib's eval_integral_piLp: in Kⁿ the integral is taken coordinatewise.
theorem banachIntegral.coordinates (X μ K absK conj ofReal f : Set, n : Nat, i : Set)
  requires scalars : RCLike(K, absK, conj, ofReal)
  requires member : i ∈ n
  requires integrable : BanachIntegrable(X, μ, euclideanModule(K, n),
    euclideanNorm(K, absK, n), f)
  shows banachIntegral(X, μ, euclideanModule(K, n), ofReal, euclideanNorm(K, absK, n), f)(i) =
    banachIntegral(X, μ, selfModule(K), ofReal, absK, familyAt(f, MeasurableSpace.carrier(X), i))
proof
  sorry

-- Section: Riemann and improper integrals
-- A Borel measurable complex map Riemann integrable on [A, B] is
-- integrable there, and the integrals agree (Mathlib's
-- intervalIntegral.integral_of_le with layer 1's complexIntegral).
theorem complexIntervalIntegral.eq_riemann (g : Set, A B : Real)
  requires le : A ≤ B
  requires riemann : ComplexRiemannIntegrable(g, A, B)
  requires measurable : Measurable(g, realMeasurableSpace, complexMeasurableSpace)
  shows ComplexIntervalIntegrable(g, A, B) ∧
    complexIntervalIntegral(g, A, B) = complexIntegral(g, A, B)
proof
  sorry

theorem realSetIntegral.eq_riemann (G : Set, A B : Real)
  requires le : A ≤ B
  requires riemann : RiemannIntegrable(G, A, B)
  requires measurable : Measurable(G, realMeasurableSpace, realMeasurableSpace)
  shows RealIntegrableOn(realMeasurableSpace, realVolume, G, realIcc(A, B)) ∧
    realSetIntegral(realMeasurableSpace, realVolume, G, realIcc(A, B)) =
      riemannIntegral(G, A, B)
proof
  sorry

-- Continuous maps on compact intervals are integrable there (Mathlib's
-- Continuous.intervalIntegrable, ContinuousOn.intervalIntegrable).
theorem ComplexIntervalIntegrable.of_continuous (g : Set, A B : Real)
  requires continuous : g : realLine ⇒ complexSpace
  shows ComplexIntervalIntegrable(g, A, B)
proof
  sorry

-- Mathlib's MeasureTheory.integral_Icc_eq_integral_Ioc,
-- integral_Ioc_eq_integral_Ioo: endpoints do not matter.
theorem complexSetIntegral.endpoints (g : Set, A B : Real)
  shows complexSetIntegral(realMeasurableSpace, realVolume, g, realIcc(A, B)) =
      complexSetIntegral(realMeasurableSpace, realVolume, g, realIoc(A, B)) ∧
    complexSetIntegral(realMeasurableSpace, realVolume, g, realIoo(A, B)) =
      complexSetIntegral(realMeasurableSpace, realVolume, g, realIoc(A, B))
proof
  sorry

-- The fundamental theorem of calculus (Mathlib's
-- intervalIntegral.integral_eq_sub_of_hasDerivAt), for real maps.
theorem realSetIntegral.fundamental_theorem (F f : Set, A B : Real)
  requires le : A ≤ B
  requires derivative : ∀ X ∈ realIcc(A, B), HasDerivativeAt(F, f(X), X)
  requires integrable : RealIntegrableOn(realMeasurableSpace, realVolume, f, realIcc(A, B))
  shows realSetIntegral(realMeasurableSpace, realVolume, f, realIoc(A, B)) = R[F(B) - F(A)]
proof
  sorry

-- An integrable map on [A, ∞) has an improper integral there, equal to
-- its integral (Mathlib's intervalIntegral_tendsto_integral_Ioi with
-- layer 1's complexImproperIntegral).
theorem complexSetIntegral.eq_improper (g : Set, A : Real)
  requires integrable : ComplexIntegrableOn(realMeasurableSpace, realVolume, g, realIoi(A))
  requires riemann : ∀ T ∈ ℝ, A ≤ T → ComplexRiemannIntegrable(g, A, T)
  shows HasComplexImproperIntegral(g, A,
      complexSetIntegral(realMeasurableSpace, realVolume, g, realIoi(A))) ∧
    complexImproperIntegral(g, A) =
      complexSetIntegral(realMeasurableSpace, realVolume, g, realIoi(A))
proof
  sorry

-- Conversely, a measurable map whose modulus has an improper integral is
-- integrable on [A, ∞) (Mathlib's integrableOn_Ioi_of_intervalIntegral_norm_bounded).
theorem ComplexIntegrableOn.of_improper_abs (g : Set, A : Real)
  requires measurable : Measurable(g, realMeasurableSpace, complexMeasurableSpace)
  requires values : ComplexValuedOn(g, ℝ)
  requires absolute : ImproperIntegrable(complexAbsOn(g, ℝ), A)
  shows ComplexIntegrableOn(realMeasurableSpace, realVolume, g, realIoi(A))
proof
  sorry

-- Standard integrals over half-lines (Mathlib's integrableOn_Ioi_rpow_of_lt,
-- integral_Ioi_rpow_of_lt, integral_exp_neg_Ioi_zero,
-- integrableOn_exp_mul_complex_Ioi, integral_exp_mul_complex_Ioi).
theorem realSetIntegral.rpow_Ioi (S A : Real)
  requires exponent : S < R[-1]
  requires positive : realZero < A
  shows RealIntegrableOn(realMeasurableSpace, realVolume, rpowFunction(S), realIoi(A)) ∧
    realSetIntegral(realMeasurableSpace, realVolume, rpowFunction(S), realIoi(A)) =
      R[-(realRpow(A, R[S + 1]) / (S + 1))]
proof
  sorry

theorem realSetIntegral.exp_neg_Ioi
  shows realSetIntegral(realMeasurableSpace, realVolume,
    expNegFunction, realIoi(realZero)) = realOne
proof
  sorry

theorem complexSetIntegral.exp_mul_Ioi (a : Set)
  requires member : a ∈ complexCarrier
  requires decay : complexRe(a) < realZero
  shows ComplexIntegrableOn(realMeasurableSpace, realVolume,
      complexExpLinear(a), realIoi(realZero)) ∧
    complexSetIntegral(realMeasurableSpace, realVolume,
      complexExpLinear(a), realIoi(realZero)) =
      ℂ[-complexInv(a)]
proof
  sorry

-- Mathlib's integrable_inv_one_add_sq: x ↦ 1/(1 + x²) is integrable on ℝ.
theorem RealIntegrable.inv_one_add_sq
  shows RealIntegrable(realMeasurableSpace, realVolume,
    inverseOnePlusSquare)
proof
  sorry

end Bochner
