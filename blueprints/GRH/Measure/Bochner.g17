theorem complexConstMulOn.boch_apply (c f A x : Set)
  requires member : x ∈ A
  shows complexConstMulOn(c, f, A)(x) = ℂ[c * f(x)]
proof
  have edge : (x, ℂ[c * f(x)]) ∈ complexConstMulOn(c, f, A)
    apply complexConstMulOn.membership.backward
    exact ⟨x, member, rfl⟩
  have pairs : ∀ p ∈ complexConstMulOn(c, f, A), ∃ a, ∃ b, p = (a, b)
    intros p hp
    obtain ⟨k0, hk, pEq⟩ := complexConstMulOn.membership.forward with hp
    rw ← pEq
    exact ⟨k0, ℂ[c * f(k0)], rfl⟩
  have functional : ∀ a, ∀ b, ∀ e, (a, b) ∈ complexConstMulOn(c, f, A) → (a, e) ∈ complexConstMulOn(c, f, A) → b = e
    intros a b e hb hc
    obtain ⟨k0, hk, bEq⟩ := complexConstMulOn.membership.forward with hb
    obtain ⟨m0, hm, cEq⟩ := complexConstMulOn.membership.forward with hc
    obtain ⟨ka, bb⟩ := orderedPair.injective with bEq
    obtain ⟨ma, ee⟩ := orderedPair.injective with cEq
    rw [← bb, ← ee, ka, ← ma]
  exact pairGraph.apply with pairs, functional, edge

theorem complexMulConstOn.boch_apply (f c A x : Set)
  requires member : x ∈ A
  shows complexMulConstOn(f, c, A)(x) = ℂ[f(x) * c]
proof
  have edge : (x, ℂ[f(x) * c]) ∈ complexMulConstOn(f, c, A)
    apply complexMulConstOn.membership.backward
    exact ⟨x, member, rfl⟩
  have pairs : ∀ p ∈ complexMulConstOn(f, c, A), ∃ a, ∃ b, p = (a, b)
    intros p hp
    obtain ⟨k0, hk, pEq⟩ := complexMulConstOn.membership.forward with hp
    rw ← pEq
    exact ⟨k0, ℂ[f(k0) * c], rfl⟩
  have functional : ∀ a, ∀ b, ∀ e, (a, b) ∈ complexMulConstOn(f, c, A) → (a, e) ∈ complexMulConstOn(f, c, A) → b = e
    intros a b e hb hc
    obtain ⟨k0, hk, bEq⟩ := complexMulConstOn.membership.forward with hb
    obtain ⟨m0, hm, cEq⟩ := complexMulConstOn.membership.forward with hc
    obtain ⟨ka, bb⟩ := orderedPair.injective with bEq
    obtain ⟨ma, ee⟩ := orderedPair.injective with cEq
    rw [← bb, ← ee, ka, ← ma]
  exact pairGraph.apply with pairs, functional, edge

theorem complexDivConstOn.boch_apply (f c A x : Set)
  requires member : x ∈ A
  shows complexDivConstOn(f, c, A)(x) = complexDiv(f(x), c)
proof
  have edge : (x, complexDiv(f(x), c)) ∈ complexDivConstOn(f, c, A)
    apply complexDivConstOn.membership.backward
    exact ⟨x, member, rfl⟩
  have pairs : ∀ p ∈ complexDivConstOn(f, c, A), ∃ a, ∃ b, p = (a, b)
    intros p hp
    obtain ⟨k0, hk, pEq⟩ := complexDivConstOn.membership.forward with hp
    rw ← pEq
    exact ⟨k0, complexDiv(f(k0), c), rfl⟩
  have functional : ∀ a, ∀ b, ∀ e, (a, b) ∈ complexDivConstOn(f, c, A) → (a, e) ∈ complexDivConstOn(f, c, A) → b = e
    intros a b e hb hc
    obtain ⟨k0, hk, bEq⟩ := complexDivConstOn.membership.forward with hb
    obtain ⟨m0, hm, cEq⟩ := complexDivConstOn.membership.forward with hc
    obtain ⟨ka, bb⟩ := orderedPair.injective with bEq
    obtain ⟨ma, ee⟩ := orderedPair.injective with cEq
    rw [← bb, ← ee, ka, ← ma]
  exact pairGraph.apply with pairs, functional, edge

theorem complexMulOn.boch_apply (f g A x : Set)
  requires member : x ∈ A
  shows complexMulOn(f, g, A)(x) = ℂ[f(x) * g(x)]
proof
  have edge : (x, ℂ[f(x) * g(x)]) ∈ complexMulOn(f, g, A)
    apply complexMulOn.membership.backward
    exact ⟨x, member, rfl⟩
  have pairs : ∀ p ∈ complexMulOn(f, g, A), ∃ a, ∃ b, p = (a, b)
    intros p hp
    obtain ⟨k0, hk, pEq⟩ := complexMulOn.membership.forward with hp
    rw ← pEq
    exact ⟨k0, ℂ[f(k0) * g(k0)], rfl⟩
  have functional : ∀ a, ∀ b, ∀ c, (a, b) ∈ complexMulOn(f, g, A) → (a, c) ∈ complexMulOn(f, g, A) → b = c
    intros a b c hb hc
    obtain ⟨k0, hk, bEq⟩ := complexMulOn.membership.forward with hb
    obtain ⟨m0, hm, cEq⟩ := complexMulOn.membership.forward with hc
    obtain ⟨ka, bb⟩ := orderedPair.injective with bEq
    obtain ⟨ma, cc⟩ := orderedPair.injective with cEq
    rw [← bb, ← cc, ka, ← ma]
  exact pairGraph.apply with pairs, functional, edge

theorem complexConjOn.boch_apply (f A x : Set)
  requires member : x ∈ A
  shows complexConjOn(f, A)(x) = complexConj(f(x))
proof
  have edge : (x, complexConj(f(x))) ∈ complexConjOn(f, A)
    apply complexConjOn.membership.backward
    exact ⟨x, member, rfl⟩
  have pairs : ∀ p ∈ complexConjOn(f, A), ∃ a, ∃ b, p = (a, b)
    intros p hp
    obtain ⟨k0, hk, pEq⟩ := complexConjOn.membership.forward with hp
    rw ← pEq
    exact ⟨k0, complexConj(f(k0)), rfl⟩
  have functional : ∀ a, ∀ b, ∀ c, (a, b) ∈ complexConjOn(f, A) → (a, c) ∈ complexConjOn(f, A) → b = c
    intros a b c hb hc
    obtain ⟨k0, hk, bEq⟩ := complexConjOn.membership.forward with hb
    obtain ⟨m0, hm, cEq⟩ := complexConjOn.membership.forward with hc
    obtain ⟨ka, bb⟩ := orderedPair.injective with bEq
    obtain ⟨ma, cc⟩ := orderedPair.injective with cEq
    rw [← bb, ← cc, ka, ← ma]
  exact pairGraph.apply with pairs, functional, edge

theorem complexOfRealOn.boch_apply (f A x : Set)
  requires member : x ∈ A
  shows complexOfRealOn(f, A)(x) = complexOfReal(f(x))
proof
  have edge : (x, complexOfReal(f(x))) ∈ complexOfRealOn(f, A)
    apply complexOfRealOn.membership.backward
    exact ⟨x, member, rfl⟩
  have pairs : ∀ p ∈ complexOfRealOn(f, A), ∃ a, ∃ b, p = (a, b)
    intros p hp
    obtain ⟨k0, hk, pEq⟩ := complexOfRealOn.membership.forward with hp
    rw ← pEq
    exact ⟨k0, complexOfReal(f(k0)), rfl⟩
  have functional : ∀ a, ∀ b, ∀ c, (a, b) ∈ complexOfRealOn(f, A) → (a, c) ∈ complexOfRealOn(f, A) → b = c
    intros a b c hb hc
    obtain ⟨k0, hk, bEq⟩ := complexOfRealOn.membership.forward with hb
    obtain ⟨m0, hm, cEq⟩ := complexOfRealOn.membership.forward with hc
    obtain ⟨ka, bb⟩ := orderedPair.injective with bEq
    obtain ⟨ma, cc⟩ := orderedPair.injective with cEq
    rw [← bb, ← cc, ka, ← ma]
  exact pairGraph.apply with pairs, functional, edge

theorem ennToReal.boch_member (a : Set)
  requires member : a ∈ ennreal
  shows ennToReal(a) ∈ ℝ
proof
  have c := ennreal.cases with member
  cases c with top | fin
  . rw top
    rw ennToReal.top
    typecheck
  . have nt := ennreal.not_top_of_real with fin.left
    have e := ennToReal.of_finite with member, nt
    rw e.left
    exact fin.left

theorem realIntegralValue.boch_member (X μ f : Set)
  shows realIntegralValue(X, μ, f) ∈ ℝ
proof
  have m1 := lintegral.member_any at X, μ, ennOfRealOn(f, MeasurableSpace.carrier(X))
  have m2 := lintegral.member_any at X, μ,
    ennOfRealOn(realNegOn(f, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X))
  have r1 := ennToReal.boch_member with m1
  have r2 := ennToReal.boch_member with m2
  unfold realIntegralValue
  typecheck

theorem realMeasureIntegral.boch_parts (X μ f : Set)
  requires integrable : RealIntegrable(X, μ, f)
  shows realMeasureIntegral(X, μ, f) = realIntegralValue(X, μ, f)
proof
  have vR := realIntegralValue.boch_member at X, μ, f
  unfold realMeasureIntegral
  apply union.of_unique
  . apply realMeasureIntegral.family.membership.backward
    refine ⟨vR, ?_⟩
    left
    exact ⟨integrable, rfl⟩
  . intros w hw
    obtain ⟨wIn, alt⟩ := realMeasureIntegral.family.membership.forward with hw
    cases alt with p | n
    . exact p.right
    . exfalso
      exact n.left with integrable

theorem realMeasureIntegral.boch_undef (X μ f : Set)
  requires absent : ¬RealIntegrable(X, μ, f)
  shows realMeasureIntegral(X, μ, f) = realZero
proof
  have zR : realZero ∈ ℝ by typecheck
  unfold realMeasureIntegral
  apply union.of_unique
  . apply realMeasureIntegral.family.membership.backward
    refine ⟨zR, ?_⟩
    right
    exact ⟨absent, rfl⟩
  . intros w hw
    obtain ⟨wIn, alt⟩ := realMeasureIntegral.family.membership.forward with hw
    cases alt with p | n
    . exfalso
      exact absent with p.left
    . exact n.right

theorem ennreal.boch_real (a : Set)
  requires member : a ∈ ennreal
  requires finite : a ≠ ennTop
  shows a ∈ ℝ ∧ realZero ≤ a ∧ ennToReal(a) = a
proof
  have f := ennreal.finite with member, finite
  have e := ennToReal.of_finite with member, finite
  exact ⟨f.left, f.right, e.left⟩

theorem EnnLe.boch_real (a b : Set)
  requires le : EnnLe(a, b)
  requires real : b ∈ ℝ
  shows (a:R) ≤ (b:R)
proof
  obtain ⟨aM, bM, alt⟩ := le
  have nt := ennreal.not_top_of_real with real
  cases alt with top | fin
  . exfalso
    exact nt with top
  . exact fin.right

theorem Measurable.boch_value (f X x : Set)
  requires measurable : Measurable(f, X, realMeasurableSpace)
  requires member : x ∈ MeasurableSpace.carrier(X)
  shows f(x) ∈ ℝ
proof
  have m := Measurable.maps with measurable, member
  rw realMeasurableSpace.carrier at m
  exact m

theorem ennOfReal.boch_le_abs (y : Set)
  requires real : y ∈ ℝ
  shows EnnLe(ennOfReal(y), abs(y)) ∧ EnnLe(ennOfReal(R[-y]), abs(y))
proof
  have aR : abs(y) ∈ ℝ by typecheck
  have an := abs.nonnegative at y
  have au := abs.upper at y
  have aun := abs.upper_neg at y
  have aM := ennreal.of_real with aR, an
  have nyR : R[-y] ∈ ℝ by typecheck
  have m1 := ennOfReal.member at y
  have m2 := ennOfReal.member at R[-y]
  constructor
  . unfold EnnLe
    refine ⟨m1.left, aM, ?_⟩
    right
    refine ⟨m1.right, ?_⟩
    by_cases nn : realZero ≤ y
    . rw ennOfReal.value_nonneg with real, nn
      exact au
    . have neg : y < realZero by linarith
      rw ennOfReal.value_neg with real, neg
      exact an
  . unfold EnnLe
    refine ⟨m2.left, aM, ?_⟩
    right
    refine ⟨m2.right, ?_⟩
    by_cases nn : realZero ≤ R[-y]
    . rw ennOfReal.value_nonneg with nyR, nn
      exact aun
    . have neg : R[-y] < realZero by linarith
      rw ennOfReal.value_neg with nyR, neg
      exact an

theorem realAbsOn.boch_values (X f : Set)
  requires measurable : Measurable(f, X, realMeasurableSpace)
  shows EnnValued(X, realAbsOn(f, MeasurableSpace.carrier(X)))
proof
  unfold EnnValued
  unfold MapsInto
  intros x hx
  rw realAbsOn.boch_apply with hx
  have fx := Measurable.boch_value with measurable, hx
  have aR : abs(f(x)) ∈ ℝ by typecheck
  have an := abs.nonnegative at f(x)
  exact ennreal.of_real with aR, an

theorem ennOfRealOn.boch_values (X f : Set)
  requires values : ∀ x ∈ MeasurableSpace.carrier(X), f(x) ∈ ℝ
  shows EnnValued(X, ennOfRealOn(f, MeasurableSpace.carrier(X)))
proof
  unfold EnnValued
  unfold MapsInto
  intros x hx
  rw ennOfRealOn.boch_apply with hx
  have fx := values with x, hx
  have m := ennOfReal.member at f(x)
  exact m.left

theorem realNegOn.boch_values (X f : Set)
  requires values : ∀ x ∈ MeasurableSpace.carrier(X), f(x) ∈ ℝ
  shows ∀ x ∈ MeasurableSpace.carrier(X), realNegOn(f, MeasurableSpace.carrier(X))(x) ∈ ℝ
proof
  intros x hx
  rw realNegOn.boch_apply with hx
  have fx := values with x, hx
  typecheck

theorem RealIntegrable.boch_finite (X μ f : Set)
  requires integrable : RealIntegrable(X, μ, f)
  shows lintegral(X, μ, ennOfRealOn(f, MeasurableSpace.carrier(X))) ≠ ennTop ∧
    lintegral(X, μ, ennOfRealOn(realNegOn(f, MeasurableSpace.carrier(X)),
      MeasurableSpace.carrier(X))) ≠ ennTop
proof
  obtain ⟨measure, measurable, finite⟩ := integrable
  have values : ∀ x ∈ MeasurableSpace.carrier(X), f(x) ∈ ℝ
    intros x hx
    exact Measurable.boch_value with measurable, hx
  have nvalues := realNegOn.boch_values with values
  have vA := realAbsOn.boch_values with measurable
  have vP := ennOfRealOn.boch_values with values
  have vN := ennOfRealOn.boch_values with nvalues
  have leP : ∀ x ∈ MeasurableSpace.carrier(X), EnnLe(ennOfRealOn(f, MeasurableSpace.carrier(X))(x),
      realAbsOn(f, MeasurableSpace.carrier(X))(x))
    intros x hx
    rw ennOfRealOn.boch_apply with hx
    rw realAbsOn.boch_apply with hx
    have b := ennOfReal.boch_le_abs with (values with x, hx)
    exact b.left
  have leN : ∀ x ∈ MeasurableSpace.carrier(X), EnnLe(ennOfRealOn(realNegOn(f, MeasurableSpace.carrier(X)),
      MeasurableSpace.carrier(X))(x), realAbsOn(f, MeasurableSpace.carrier(X))(x))
    intros x hx
    rw ennOfRealOn.boch_apply with hx
    rw realAbsOn.boch_apply with hx
    rw realNegOn.boch_apply with hx
    have b := ennOfReal.boch_le_abs with (values with x, hx)
    exact b.right
  have mP := lintegral.mono with measure, vP, vA, leP
  have mN := lintegral.mono with measure, vN, vA, leN
  constructor
  . intro top
    rw top at mP
    have t := EnnLe.top_eq with mP
    exact finite with t
  . intro top
    rw top at mN
    have t := EnnLe.top_eq with mN
    exact finite with t

theorem ennToReal.boch_nonneg (a : Set)
  requires member : a ∈ ennreal
  shows realZero ≤ ennToReal(a)
proof
  have c := ennreal.cases with member
  cases c with top | fin
  . rw top
    rw ennToReal.top
    have zR : realZero ∈ ℝ by typecheck
    linarith
  . have nt := ennreal.not_top_of_real with fin.left
    have e := ennToReal.of_finite with member, nt
    exact e.right

theorem ennToReal.boch_zero
  shows ennToReal(realZero) = realZero
proof
  have m := ennreal.zero_member
  have n := ennreal.zero_not_top
  have e := ennToReal.of_finite with m, n
  exact e.left

theorem ennOfReal.boch_nonpos (y : Set)
  requires real : y ∈ ℝ
  requires nonpos : y ≤ realZero
  shows ennOfReal(y) = realZero
proof
  by_cases neg : y < realZero
  . exact ennOfReal.value_neg with real, neg
  . have zero : y = realZero by linarith
    have zR : realZero ∈ ℝ by typecheck
    have zz : realZero ≤ realZero by linarith
    rw zero
    exact ennOfReal.value_nonneg with zR, zz

theorem realNegOn.boch_lint_zero (X μ f : Set)
  requires measure : Measure(X, μ)
  requires values : ∀ x ∈ MeasurableSpace.carrier(X), f(x) ∈ ℝ
  requires nonneg : ∀ x ∈ MeasurableSpace.carrier(X), realZero ≤ f(x)
  shows lintegral(X, μ, ennOfRealOn(realNegOn(f, MeasurableSpace.carrier(X)),
    MeasurableSpace.carrier(X))) = realZero
proof
  have agree : ∀ x ∈ MeasurableSpace.carrier(X),
      ennOfRealOn(realNegOn(f, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X))(x) =
      constantOn(MeasurableSpace.carrier(X), realZero)(x)
    intros x hx
    rw ennOfRealOn.boch_apply with hx
    rw realNegOn.boch_apply with hx
    rw constantOn.apply with hx
    have fx := values with x, hx
    have n := nonneg with x, hx
    have nR : R[-f(x)] ∈ ℝ by typecheck
    have np : R[-f(x)] ≤ realZero by linarith
    exact ennOfReal.boch_nonpos with nR, np
  rw lintegral.congr at X, μ with agree
  exact lintegral.zero with measure

theorem RealIntegrable.boch_congr (X μ f g : Set)
  requires integrable : RealIntegrable(X, μ, f)
  requires agree : ∀ x ∈ MeasurableSpace.carrier(X), f(x) = g(x)
  shows RealIntegrable(X, μ, g)
proof
  obtain ⟨measure, measurable, finite⟩ := integrable
  have mg := Measurable.congr with measurable, agree
  have absEq : ∀ x ∈ MeasurableSpace.carrier(X),
      realAbsOn(f, MeasurableSpace.carrier(X))(x) = realAbsOn(g, MeasurableSpace.carrier(X))(x)
    intros x hx
    rw realAbsOn.boch_apply at f, MeasurableSpace.carrier(X), x with hx
    rw realAbsOn.boch_apply at g, MeasurableSpace.carrier(X), x with hx
    rw agree with x, hx
  have e := lintegral.congr at X, μ with absEq
  rw e at finite
  exact ⟨measure, mg, finite⟩

theorem realMeasureIntegral.boch_congr (X μ f g : Set)
  requires agree : ∀ x ∈ MeasurableSpace.carrier(X), f(x) = g(x)
  shows realMeasureIntegral(X, μ, f) = realMeasureIntegral(X, μ, g)
proof
  have back : ∀ x ∈ MeasurableSpace.carrier(X), g(x) = f(x)
    intros x hx
    rw agree with x, hx
  by_cases i : RealIntegrable(X, μ, f)
  . have ig := RealIntegrable.boch_congr with i, agree
    rw realMeasureIntegral.boch_parts with i
    rw realMeasureIntegral.boch_parts with ig
    have pEq : ∀ x ∈ MeasurableSpace.carrier(X),
        ennOfRealOn(f, MeasurableSpace.carrier(X))(x) = ennOfRealOn(g, MeasurableSpace.carrier(X))(x)
      intros x hx
      rw ennOfRealOn.boch_apply at f, MeasurableSpace.carrier(X), x with hx
      rw ennOfRealOn.boch_apply at g, MeasurableSpace.carrier(X), x with hx
      rw agree with x, hx
    have nEq : ∀ x ∈ MeasurableSpace.carrier(X),
        ennOfRealOn(realNegOn(f, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X))(x) =
        ennOfRealOn(realNegOn(g, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X))(x)
      intros x hx
      rw ennOfRealOn.boch_apply at realNegOn(f, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X), x with hx
      rw ennOfRealOn.boch_apply at realNegOn(g, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X), x with hx
      rw realNegOn.boch_apply at f, MeasurableSpace.carrier(X), x with hx
      rw realNegOn.boch_apply at g, MeasurableSpace.carrier(X), x with hx
      rw agree with x, hx
    unfold realIntegralValue
    rw lintegral.congr at X, μ with pEq
    rw lintegral.congr at X, μ with nEq
  . have ng : ¬RealIntegrable(X, μ, g)
      intro ig
      exact i with (RealIntegrable.boch_congr with ig, back)
    rw realMeasureIntegral.boch_undef with i
    rw realMeasureIntegral.boch_undef with ng

theorem ennAddOn.boch_apply (f g A x : Set)
  requires member : x ∈ A
  shows ennAddOn(f, g, A)(x) = ennAdd(f(x), g(x))
proof
  have edge : (x, ennAdd(f(x), g(x))) ∈ ennAddOn(f, g, A)
    apply ennAddOn.membership.backward
    exact ⟨x, member, rfl⟩
  have pairs : ∀ p ∈ ennAddOn(f, g, A), ∃ a, ∃ b, p = (a, b)
    intros p hp
    obtain ⟨k0, hk, pEq⟩ := ennAddOn.membership.forward with hp
    rw ← pEq
    exact ⟨k0, ennAdd(f(k0), g(k0)), rfl⟩
  have functional : ∀ a, ∀ b, ∀ c, (a, b) ∈ ennAddOn(f, g, A) → (a, c) ∈ ennAddOn(f, g, A) → b = c
    intros a b c hb hc
    obtain ⟨k0, hk, bEq⟩ := ennAddOn.membership.forward with hb
    obtain ⟨m0, hm, cEq⟩ := ennAddOn.membership.forward with hc
    obtain ⟨ka, bb⟩ := orderedPair.injective with bEq
    obtain ⟨ma, cc⟩ := orderedPair.injective with cEq
    rw [← bb, ← cc, ka, ← ma]
  exact pairGraph.apply with pairs, functional, edge

theorem EnnLe.boch_of_real (a b : Set)
  requires realA : a ∈ ℝ
  requires realB : b ∈ ℝ
  requires nonneg : realZero ≤ a
  requires le : (a:R) ≤ (b:R)
  shows EnnLe(a, b)
proof
  have nb : realZero ≤ b by linarith
  have aM := ennreal.of_real with realA, nonneg
  have bM := ennreal.of_real with realB, nb
  have nt := ennreal.not_top_of_real with realA
  unfold EnnLe
  refine ⟨aM, bM, ?_⟩
  right
  exact ⟨nt, le⟩

theorem ennOfReal.boch_diff (y : Set)
  requires real : y ∈ ℝ
  shows ennOfReal(y) ∈ ℝ ∧ ennOfReal(R[-y]) ∈ ℝ ∧ realZero ≤ ennOfReal(y) ∧
    realZero ≤ ennOfReal(R[-y]) ∧ R[ennOfReal(y) - ennOfReal(R[-y])] = y
proof
  have nyR : R[-y] ∈ ℝ by typecheck
  have zR : realZero ∈ ℝ by typecheck
  by_cases nn : realZero ≤ y
  . have np : R[-y] ≤ realZero by linarith
    rw ennOfReal.value_nonneg with real, nn
    rw ennOfReal.boch_nonpos with nyR, np
    have zz : realZero ≤ realZero by linarith
    refine ⟨real, zR, nn, zz, ?_⟩
    ring
  . have np : y ≤ realZero by linarith
    have nn2 : realZero ≤ R[-y] by linarith
    rw ennOfReal.boch_nonpos with real, np
    rw ennOfReal.value_nonneg with nyR, nn2
    have zz : realZero ≤ realZero by linarith
    refine ⟨zR, nyR, zz, nn2, ?_⟩
    ring

theorem ennAdd.boch_real3 (a b c : Set)
  requires realA : a ∈ ℝ
  requires realB : b ∈ ℝ
  requires realC : c ∈ ℝ
  requires nonnegA : realZero ≤ a
  requires nonnegB : realZero ≤ b
  requires nonnegC : realZero ≤ c
  shows ennAdd(a, ennAdd(b, c)) = R[a + (b + c)]
proof
  rw ennAdd.finite with realB, realC, nonnegB, nonnegC
  have sR : R[b + c] ∈ ℝ by typecheck
  have sN : realZero ≤ R[b + c] by linarith
  exact ennAdd.finite with realA, sR, nonnegA, sN

theorem realAbsOn.boch_measurable (X f : Set)
  requires measurable : Measurable(f, X, realMeasurableSpace)
  shows Measurable(realAbsOn(f, MeasurableSpace.carrier(X)), X, ennMeasurableSpace)
proof
  have absolute : ∀ x ∈ MeasurableSpace.carrier(X),
      realAbsOn(f, MeasurableSpace.carrier(X))(x) = abs(f(x))
    intros x hx
    exact realAbsOn.boch_apply with hx
  have mR := Measurable.real_abs with measurable, absolute
  have cast : ∀ x ∈ MeasurableSpace.carrier(X),
      realAbsOn(f, MeasurableSpace.carrier(X))(x) =
      ennOfReal(realAbsOn(f, MeasurableSpace.carrier(X))(x))
    intros x hx
    rw realAbsOn.boch_apply with hx
    have fx := Measurable.boch_value with measurable, hx
    have aR : abs(f(x)) ∈ ℝ by typecheck
    have an := abs.nonnegative at f(x)
    have e := ennOfReal.value_nonneg with aR, an
    rw e
  exact Measurable.enn_of_real with mR, cast

theorem ennOfRealOn.boch_measurable (X f : Set)
  requires measurable : Measurable(f, X, realMeasurableSpace)
  shows Measurable(ennOfRealOn(f, MeasurableSpace.carrier(X)), X, ennMeasurableSpace) ∧
    Measurable(ennOfRealOn(realNegOn(f, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X)),
      X, ennMeasurableSpace)
proof
  have castP : ∀ x ∈ MeasurableSpace.carrier(X),
      ennOfRealOn(f, MeasurableSpace.carrier(X))(x) = ennOfReal(f(x))
    intros x hx
    exact ennOfRealOn.boch_apply with hx
  have mP := Measurable.enn_of_real with measurable, castP
  have negEq : ∀ x ∈ MeasurableSpace.carrier(X),
      realNegOn(f, MeasurableSpace.carrier(X))(x) = R[-f(x)]
    intros x hx
    exact realNegOn.boch_apply with hx
  have mN0 := Measurable.real_neg with measurable, negEq
  have castN : ∀ x ∈ MeasurableSpace.carrier(X),
      ennOfRealOn(realNegOn(f, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X))(x) =
      ennOfReal(realNegOn(f, MeasurableSpace.carrier(X))(x))
    intros x hx
    exact ennOfRealOn.boch_apply with hx
  have mN := Measurable.enn_of_real with mN0, castN
  exact ⟨mP, mN⟩

theorem ennAddOn.boch_values (X f g : Set)
  requires valuesF : EnnValued(X, f)
  requires valuesG : EnnValued(X, g)
  shows EnnValued(X, ennAddOn(f, g, MeasurableSpace.carrier(X)))
proof
  unfold EnnValued at valuesF
  unfold MapsInto at valuesF
  unfold EnnValued at valuesG
  unfold MapsInto at valuesG
  unfold EnnValued
  unfold MapsInto
  intros x hx
  rw ennAddOn.lint_apply with hx
  exact ennAdd.member with (valuesF with x, hx), (valuesG with x, hx)

theorem ennAdd.boch_finite (a b : Set)
  requires memberA : a ∈ ennreal
  requires memberB : b ∈ ennreal
  requires finiteA : a ≠ ennTop
  requires finiteB : b ≠ ennTop
  shows ennAdd(a, b) ≠ ennTop
proof
  have ra := ennreal.boch_real with memberA, finiteA
  have rb := ennreal.boch_real with memberB, finiteB
  obtain ⟨aR, aN, aE⟩ := ra
  obtain ⟨bR, bN, bE⟩ := rb
  rw ennAdd.finite with aR, bR, aN, bN
  have sR : R[a + b] ∈ ℝ by typecheck
  exact ennreal.not_top_of_real with sR

theorem RealIntegrable.boch_add (X μ f g h : Set)
  requires integrableF : RealIntegrable(X, μ, f)
  requires integrableG : RealIntegrable(X, μ, g)
  requires sum : ∀ x ∈ MeasurableSpace.carrier(X), h(x) = R[f(x) + g(x)]
  shows RealIntegrable(X, μ, h)
proof
  have iF := integrableF
  obtain ⟨measure, mF, finF⟩ := iF
  have iG := integrableG
  obtain ⟨m2, mG, finG⟩ := iG
  have mH := Measurable.real_add with mF, mG, sum
  have aF := realAbsOn.boch_measurable with mF
  have vF := realAbsOn.boch_values with mF
  have vG := realAbsOn.boch_values with mG
  have vH := realAbsOn.boch_values with mH
  have vS := ennAddOn.boch_values with vF, vG
  have le : ∀ x ∈ MeasurableSpace.carrier(X), EnnLe(realAbsOn(h, MeasurableSpace.carrier(X))(x),
      ennAddOn(realAbsOn(f, MeasurableSpace.carrier(X)), realAbsOn(g, MeasurableSpace.carrier(X)),
        MeasurableSpace.carrier(X))(x))
    intros x hx
    rw ennAddOn.lint_apply with hx
    rw realAbsOn.boch_apply at h, MeasurableSpace.carrier(X), x with hx
    rw realAbsOn.boch_apply at f, MeasurableSpace.carrier(X), x with hx
    rw realAbsOn.boch_apply at g, MeasurableSpace.carrier(X), x with hx
    have fx := Measurable.boch_value with mF, hx
    have gx := Measurable.boch_value with mG, hx
    have afR : abs(f(x)) ∈ ℝ by typecheck
    have agR : abs(g(x)) ∈ ℝ by typecheck
    have afN := abs.nonnegative at f(x)
    have agN := abs.nonnegative at g(x)
    rw ennAdd.finite with afR, agR, afN, agN
    rw sum with x, hx
    have ahR : abs(R[f(x) + g(x)]) ∈ ℝ by typecheck
    have sR : R[abs(f(x)) + abs(g(x))] ∈ ℝ by typecheck
    have ahN := abs.nonnegative at R[f(x) + g(x)]
    have tri := abs.triangle at f(x), g(x)
    exact EnnLe.boch_of_real with ahR, sR, ahN, tri
  have mono := lintegral.mono with measure, vH, vS, le
  rw lintegral.add with measure, aF, vG at mono
  have lF := lintegral.member at X, μ, realAbsOn(f, MeasurableSpace.carrier(X)) with measure
  have lG := lintegral.member at X, μ, realAbsOn(g, MeasurableSpace.carrier(X)) with measure
  have fin := ennAdd.boch_finite with lF, lG, finF, finG
  unfold RealIntegrable
  refine ⟨measure, mH, ?_⟩
  intro top
  rw top at mono
  have t := EnnLe.top_eq with mono
  exact fin with t

theorem ennToReal.boch_of_real (a : Set)
  requires real : a ∈ ℝ
  requires nonneg : realZero ≤ a
  shows ennToReal(a) = a
proof
  have m := ennreal.of_real with real, nonneg
  have n := ennreal.not_top_of_real with real
  have e := ennToReal.of_finite with m, n
  exact e.left

theorem ennOfReal.boch_mul (c y z : Set)
  requires realC : c ∈ ℝ
  requires realY : y ∈ ℝ
  requires nonneg : realZero ≤ c
  requires product : z = R[c * y]
  shows ennOfReal(z) = ennMul(c, ennOfReal(y))
proof
  have cM := ennreal.of_real with realC, nonneg
  rw product
  by_cases ny : realZero ≤ y
  . rw ennOfReal.value_nonneg with realY, ny
    rw ennMul.finite with realC, realY, nonneg, ny
    have zR : R[c * y] ∈ ℝ by typecheck
    have p := realMulValue.nonnegative at c, y with nonneg, ny
    exact ennOfReal.value_nonneg with zR, p
  . have neg : y < realZero by linarith
    rw ennOfReal.value_neg with realY, neg
    rw ennMul.zero_right with cM
    have nyR : R[-y] ∈ ℝ by typecheck
    have nyN : realZero ≤ R[-y] by linarith
    have p := realMulValue.nonnegative at c, R[-y] with nonneg, nyN
    have e : R[c * R[-y]] = R[-R[c * y]] by ring
    have zR : R[c * y] ∈ ℝ by typecheck
    have np : R[c * y] ≤ realZero by linarith
    exact ennOfReal.boch_nonpos with zR, np

theorem ennOfReal.boch_mono (a b : Set)
  requires realA : a ∈ ℝ
  requires realB : b ∈ ℝ
  requires le : (a:R) ≤ (b:R)
  shows EnnLe(ennOfReal(a), ennOfReal(b))
proof
  have da := ennOfReal.boch_diff with realA
  have db := ennOfReal.boch_diff with realB
  obtain ⟨aPR, aNR, aPN, aNN, aE⟩ := da
  obtain ⟨bPR, bNR, bPN, bNN, bE⟩ := db
  have l : (ennOfReal(a):R) ≤ (ennOfReal(b):R)
    by_cases na : realZero ≤ a
    . have nb : realZero ≤ b by linarith
      rw ennOfReal.value_nonneg with realA, na
      rw ennOfReal.value_nonneg with realB, nb
      exact le
    . have np : a ≤ realZero by linarith
      rw ennOfReal.boch_nonpos with realA, np
      exact bPN
  exact EnnLe.boch_of_real with aPR, bPR, aPN, l

theorem RealIntegrable.boch_const_mul (X μ f h c : Set)
  requires integrable : RealIntegrable(X, μ, f)
  requires real : c ∈ ℝ
  requires product : ∀ x ∈ MeasurableSpace.carrier(X), h(x) = R[c * f(x)]
  shows RealIntegrable(X, μ, h) ∧
    realMeasureIntegral(X, μ, h) = R[c * realMeasureIntegral(X, μ, f)]
proof
  have fins := RealIntegrable.boch_finite with integrable
  obtain ⟨finFP, finFN⟩ := fins
  have i2 := integrable
  obtain ⟨measure, mF, aF⟩ := i2
  have vF : ∀ x ∈ MeasurableSpace.carrier(X), f(x) ∈ ℝ
    intros x hx
    exact Measurable.boch_value with mF, hx
  have space := Measure.space with measure
  have rs := realMeasurableSpace.space
  have cC : c ∈ MeasurableSpace.carrier(realMeasurableSpace)
    rw realMeasurableSpace.carrier
    exact real
  have constEq : ∀ x ∈ MeasurableSpace.carrier(X), constantOn(MeasurableSpace.carrier(X), c)(x) = c
    intros x hx
    exact constantOn.apply with hx
  have mC := Measurable.constant with space, rs, cC, constEq
  have prod2 : ∀ x ∈ MeasurableSpace.carrier(X),
      h(x) = R[constantOn(MeasurableSpace.carrier(X), c)(x) * f(x)]
    intros x hx
    rw constantOn.apply with hx
    exact product with x, hx
  have mH := Measurable.real_mul with mC, mF, prod2
  have acR : abs(c) ∈ ℝ by typecheck
  have acN := abs.nonnegative at c
  have acM := ennreal.of_real with acR, acN
  have acT := ennreal.not_top_of_real with acR
  have vA := realAbsOn.boch_values with mF
  have absEq : ∀ x ∈ MeasurableSpace.carrier(X), realAbsOn(h, MeasurableSpace.carrier(X))(x) =
      ennConstMulOn(abs(c), realAbsOn(f, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X))(x)
    intros x hx
    rw ennConstMulOn.apply with hx
    rw realAbsOn.boch_apply at h, MeasurableSpace.carrier(X), x with hx
    rw realAbsOn.boch_apply at f, MeasurableSpace.carrier(X), x with hx
    rw product with x, hx
    have fx := vF with x, hx
    have afR : abs(f(x)) ∈ ℝ by typecheck
    have afN := abs.nonnegative at f(x)
    rw ennMul.finite with acR, afR, acN, afN
    exact abs.mul at c, f(x)
  have lA := lintegral.congr at X, μ with absEq
  rw lintegral.const_mul_finite with measure, acM, acT, vA at lA
  have lAM := lintegral.member at X, μ, realAbsOn(f, MeasurableSpace.carrier(X)) with measure
  have rA := ennreal.boch_real with lAM, aF
  obtain ⟨rAR, rAN, rAE⟩ := rA
  rw ennMul.finite with acR, rAR, acN, rAN at lA
  have pR : R[abs(c) * lintegral(X, μ, realAbsOn(f, MeasurableSpace.carrier(X)))] ∈ ℝ by typecheck
  have finH : lintegral(X, μ, realAbsOn(h, MeasurableSpace.carrier(X))) ≠ ennTop
    rw lA
    exact ennreal.not_top_of_real with pR
  have iH : RealIntegrable(X, μ, h)
    unfold RealIntegrable
    exact ⟨measure, mH, finH⟩
  refine ⟨iH, ?_⟩
  have eFP := ennOfRealOn.boch_values with vF
  have eFN := ennOfRealOn.boch_values with (realNegOn.boch_values with vF)
  have xFP := lintegral.member at X, μ, ennOfRealOn(f, MeasurableSpace.carrier(X)) with measure
  have xFN := lintegral.member at X, μ,
    ennOfRealOn(realNegOn(f, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X)) with measure
  have rFP := ennreal.boch_real with xFP, finFP
  have rFN := ennreal.boch_real with xFN, finFN
  obtain ⟨aFP, bFP, cFP⟩ := rFP
  obtain ⟨aFN, bFN, cFN⟩ := rFN
  rw realMeasureIntegral.boch_parts with iH
  rw realMeasureIntegral.boch_parts with integrable
  unfold realIntegralValue
  rw [cFP, cFN]
  by_cases cn : realZero ≤ c
  . have cM := ennreal.of_real with real, cn
    have cT := ennreal.not_top_of_real with real
    have pEq : ∀ x ∈ MeasurableSpace.carrier(X), ennOfRealOn(h, MeasurableSpace.carrier(X))(x) =
        ennConstMulOn(c, ennOfRealOn(f, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X))(x)
      intros x hx
      rw ennConstMulOn.apply with hx
      rw ennOfRealOn.boch_apply at h, MeasurableSpace.carrier(X), x with hx
      rw ennOfRealOn.boch_apply at f, MeasurableSpace.carrier(X), x with hx
      exact ennOfReal.boch_mul with real, (vF with x, hx), cn, (product with x, hx)
    have nEq : ∀ x ∈ MeasurableSpace.carrier(X),
        ennOfRealOn(realNegOn(h, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X))(x) =
        ennConstMulOn(c, ennOfRealOn(realNegOn(f, MeasurableSpace.carrier(X)),
          MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X))(x)
      intros x hx
      rw ennConstMulOn.apply with hx
      rw ennOfRealOn.boch_apply at realNegOn(h, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X), x with hx
      rw ennOfRealOn.boch_apply at realNegOn(f, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X), x with hx
      rw realNegOn.boch_apply at h, MeasurableSpace.carrier(X), x with hx
      rw realNegOn.boch_apply at f, MeasurableSpace.carrier(X), x with hx
      have fx := vF with x, hx
      have nfR : R[-f(x)] ∈ ℝ by typecheck
      have e : R[-h(x)] = R[c * R[-f(x)]]
        rw product with x, hx
        ring
      exact ennOfReal.boch_mul with real, nfR, cn, e
    rw lintegral.congr at X, μ with pEq
    rw lintegral.congr at X, μ with nEq
    rw lintegral.const_mul_finite with measure, cM, cT, eFP
    rw lintegral.const_mul_finite with measure, cM, cT, eFN
    rw ennMul.finite with real, aFP, cn, bFP
    rw ennMul.finite with real, aFN, cn, bFN
    have p1 := realMulValue.nonnegative at c, lintegral(X, μ, ennOfRealOn(f, MeasurableSpace.carrier(X))) with cn, bFP
    have p2 := realMulValue.nonnegative at c, lintegral(X, μ, ennOfRealOn(realNegOn(f, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X))) with cn, bFN
    have q1R : R[c * lintegral(X, μ, ennOfRealOn(f, MeasurableSpace.carrier(X)))] ∈ ℝ by typecheck
    have q2R : R[c * lintegral(X, μ, ennOfRealOn(realNegOn(f, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X)))] ∈ ℝ by typecheck
    rw ennToReal.boch_of_real with q1R, p1
    rw ennToReal.boch_of_real with q2R, p2
    ring
  . have dR : R[-c] ∈ ℝ by typecheck
    have dn : realZero ≤ R[-c] by linarith
    have dM := ennreal.of_real with dR, dn
    have dT := ennreal.not_top_of_real with dR
    have pEq : ∀ x ∈ MeasurableSpace.carrier(X), ennOfRealOn(h, MeasurableSpace.carrier(X))(x) =
        ennConstMulOn(R[-c], ennOfRealOn(realNegOn(f, MeasurableSpace.carrier(X)),
          MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X))(x)
      intros x hx
      rw ennConstMulOn.apply with hx
      rw ennOfRealOn.boch_apply at h, MeasurableSpace.carrier(X), x with hx
      rw ennOfRealOn.boch_apply at realNegOn(f, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X), x with hx
      rw realNegOn.boch_apply at f, MeasurableSpace.carrier(X), x with hx
      have fx := vF with x, hx
      have nfR : R[-f(x)] ∈ ℝ by typecheck
      have e : h(x) = R[R[-c] * R[-f(x)]]
        rw product with x, hx
        ring
      exact ennOfReal.boch_mul with dR, nfR, dn, e
    have nEq : ∀ x ∈ MeasurableSpace.carrier(X),
        ennOfRealOn(realNegOn(h, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X))(x) =
        ennConstMulOn(R[-c], ennOfRealOn(f, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X))(x)
      intros x hx
      rw ennConstMulOn.apply with hx
      rw ennOfRealOn.boch_apply at realNegOn(h, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X), x with hx
      rw ennOfRealOn.boch_apply at f, MeasurableSpace.carrier(X), x with hx
      rw realNegOn.boch_apply at h, MeasurableSpace.carrier(X), x with hx
      have fx := vF with x, hx
      have e : R[-h(x)] = R[R[-c] * f(x)]
        rw product with x, hx
        ring
      exact ennOfReal.boch_mul with dR, fx, dn, e
    rw lintegral.congr at X, μ with pEq
    rw lintegral.congr at X, μ with nEq
    rw lintegral.const_mul_finite with measure, dM, dT, eFP
    rw lintegral.const_mul_finite with measure, dM, dT, eFN
    rw ennMul.finite with dR, aFP, dn, bFP
    rw ennMul.finite with dR, aFN, dn, bFN
    have p1 := realMulValue.nonnegative at R[-c], lintegral(X, μ, ennOfRealOn(f, MeasurableSpace.carrier(X))) with dn, bFP
    have p2 := realMulValue.nonnegative at R[-c], lintegral(X, μ, ennOfRealOn(realNegOn(f, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X))) with dn, bFN
    have q1R : R[R[-c] * lintegral(X, μ, ennOfRealOn(f, MeasurableSpace.carrier(X)))] ∈ ℝ by typecheck
    have q2R : R[R[-c] * lintegral(X, μ, ennOfRealOn(realNegOn(f, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X)))] ∈ ℝ by typecheck
    rw ennToReal.boch_of_real with q1R, p1
    rw ennToReal.boch_of_real with q2R, p2
    ring

theorem realMeasureIntegral.boch_nonneg_parts (X μ f : Set)
  requires integrable : RealIntegrable(X, μ, f)
  requires nonneg : ∀ x ∈ MeasurableSpace.carrier(X), realZero ≤ f(x)
  shows Measure(X, μ) ∧ Measurable(f, X, ennMeasurableSpace) ∧ lintegral(X, μ, f) ∈ ℝ ∧
    realZero ≤ lintegral(X, μ, f) ∧ ennToReal(lintegral(X, μ, f)) = lintegral(X, μ, f)
proof
  have i2 := integrable
  obtain ⟨measure, measurable, finite⟩ := i2
  have absEq : ∀ x ∈ MeasurableSpace.carrier(X), realAbsOn(f, MeasurableSpace.carrier(X))(x) = f(x)
    intros x hx
    rw realAbsOn.boch_apply with hx
    have fx := Measurable.boch_value with measurable, hx
    have n := nonneg with x, hx
    exact abs.of_nonnegative at f(x) with n
  have lA := lintegral.congr at X, μ with absEq
  rw lA at finite
  have lM := lintegral.member at X, μ, f with measure
  have r := ennreal.boch_real with lM, finite
  obtain ⟨lR, lN, lE⟩ := r
  have cast : ∀ x ∈ MeasurableSpace.carrier(X), f(x) = ennOfReal(f(x))
    intros x hx
    have fx := Measurable.boch_value with measurable, hx
    have n := nonneg with x, hx
    have e := ennOfReal.value_nonneg with fx, n
    rw e
  have mE := Measurable.enn_of_real with measurable, cast
  exact ⟨measure, mE, lR, lN, lE⟩

-- Section: Laws of the real integral
theorem realMeasureIntegral.member (X μ f : Set)
  shows realMeasureIntegral(X, μ, f) ∈ ℝ
proof
  by_cases i : RealIntegrable(X, μ, f)
  . rw realMeasureIntegral.boch_parts with i
    exact realIntegralValue.boch_member at X, μ, f
  . rw realMeasureIntegral.boch_undef with i
    typecheck

theorem realMeasureIntegral.undef (X μ f : Set)
  requires absent : ¬RealIntegrable(X, μ, f)
  shows realMeasureIntegral(X, μ, f) = realZero
proof
  exact realMeasureIntegral.boch_undef with absent

-- Mathlib's Integrable.mono': a measurable map bounded by an integrable
-- one is integrable.
theorem RealIntegrable.of_bound (X μ f g : Set)
  requires measurable : Measurable(f, X, realMeasurableSpace)
  requires integrable : RealIntegrable(X, μ, g)
  requires bound : AlmostEverywhere(X, μ, realAbsBoundSet(f, g, MeasurableSpace.carrier(X)))
  shows RealIntegrable(X, μ, f)
proof
  have i2 := integrable
  obtain ⟨measure, mG, aG⟩ := i2
  have vA := realAbsOn.boch_values with measurable
  have vB := realAbsOn.boch_values with mG
  have ae : AlmostEverywhere(X, μ, ennLeSet(realAbsOn(f, MeasurableSpace.carrier(X)),
      realAbsOn(g, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X)))
    apply AlmostEverywhere.mono with bound
    intros x hx
    obtain ⟨xL, xC⟩ := intersection.membership.forward with hx
    obtain ⟨xC2, fg⟩ := realAbsBoundSet.membership.forward with xL
    apply ennLeSet.membership.backward
    refine ⟨xC, ?_⟩
    rw realAbsOn.boch_apply at f, MeasurableSpace.carrier(X), x with xC
    rw realAbsOn.boch_apply at g, MeasurableSpace.carrier(X), x with xC
    have fx := Measurable.boch_value with measurable, xC
    have gx := Measurable.boch_value with mG, xC
    have afR : abs(f(x)) ∈ ℝ by typecheck
    have agR : abs(g(x)) ∈ ℝ by typecheck
    have afN := abs.nonnegative at f(x)
    have gu := abs.upper at g(x)
    have l : abs(f(x)) ≤ abs(g(x)) by linarith
    exact EnnLe.boch_of_real with afR, agR, afN, l
  have mono := lintegral.mono_ae with measure, vA, vB, ae
  unfold RealIntegrable
  refine ⟨measure, measurable, ?_⟩
  intro top
  rw top at mono
  have t := EnnLe.top_eq with mono
  exact aG with t

theorem realMeasureIntegral.add (X μ f g h : Set)
  requires integrableF : RealIntegrable(X, μ, f)
  requires integrableG : RealIntegrable(X, μ, g)
  requires sum : ∀ x ∈ MeasurableSpace.carrier(X), h(x) = R[f(x) + g(x)]
  shows realMeasureIntegral(X, μ, h) =
    R[realMeasureIntegral(X, μ, f) + realMeasureIntegral(X, μ, g)]
proof
  have iH := RealIntegrable.boch_add with integrableF, integrableG, sum
  have fin1 := RealIntegrable.boch_finite with integrableF
  have fin2 := RealIntegrable.boch_finite with integrableG
  have fin3 := RealIntegrable.boch_finite with iH
  obtain ⟨finFP, finFN⟩ := fin1
  obtain ⟨finGP, finGN⟩ := fin2
  obtain ⟨finHP, finHN⟩ := fin3
  have iF := integrableF
  obtain ⟨measure, mF, aF⟩ := iF
  have iG := integrableG
  obtain ⟨m2, mG, aG⟩ := iG
  have iH2 := iH
  obtain ⟨m3, mH, aH⟩ := iH2
  have pf := ennOfRealOn.boch_measurable with mF
  obtain ⟨mFP, mFN⟩ := pf
  have pg := ennOfRealOn.boch_measurable with mG
  obtain ⟨mGP, mGN⟩ := pg
  have ph := ennOfRealOn.boch_measurable with mH
  obtain ⟨mHP, mHN⟩ := ph
  have vF : ∀ x ∈ MeasurableSpace.carrier(X), f(x) ∈ ℝ
    intros x hx
    exact Measurable.boch_value with mF, hx
  have vG : ∀ x ∈ MeasurableSpace.carrier(X), g(x) ∈ ℝ
    intros x hx
    exact Measurable.boch_value with mG, hx
  have vH : ∀ x ∈ MeasurableSpace.carrier(X), h(x) ∈ ℝ
    intros x hx
    exact Measurable.boch_value with mH, hx
  have eFP := ennOfRealOn.boch_values with vF
  have eFN := ennOfRealOn.boch_values with (realNegOn.boch_values with vF)
  have eHP := ennOfRealOn.boch_values with vH
  have eHN := ennOfRealOn.boch_values with (realNegOn.boch_values with vH)
  have eL1 := ennAddOn.boch_values with eHP, eFN
  have eR1 := ennAddOn.boch_values with eHN, eFP
  have agree : ∀ x ∈ MeasurableSpace.carrier(X), ennAddOn(ennOfRealOn(realNegOn(g, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X)), ennAddOn(ennOfRealOn(h, MeasurableSpace.carrier(X)), ennOfRealOn(realNegOn(f, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X))(x) = ennAddOn(ennOfRealOn(g, MeasurableSpace.carrier(X)), ennAddOn(ennOfRealOn(realNegOn(h, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X)), ennOfRealOn(f, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X))(x)
    intros x hx
    rw ennAddOn.lint_apply at ennOfRealOn(realNegOn(g, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X)), ennAddOn(ennOfRealOn(h, MeasurableSpace.carrier(X)), ennOfRealOn(realNegOn(f, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X), x with hx
    rw ennAddOn.lint_apply at ennOfRealOn(g, MeasurableSpace.carrier(X)), ennAddOn(ennOfRealOn(realNegOn(h, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X)), ennOfRealOn(f, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X), x with hx
    rw ennAddOn.lint_apply at ennOfRealOn(h, MeasurableSpace.carrier(X)), ennOfRealOn(realNegOn(f, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X), x with hx
    rw ennAddOn.lint_apply at ennOfRealOn(realNegOn(h, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X)), ennOfRealOn(f, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X), x with hx
    rw ennOfRealOn.boch_apply at f, MeasurableSpace.carrier(X), x with hx
    rw ennOfRealOn.boch_apply at g, MeasurableSpace.carrier(X), x with hx
    rw ennOfRealOn.boch_apply at h, MeasurableSpace.carrier(X), x with hx
    rw ennOfRealOn.boch_apply at realNegOn(f, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X), x with hx
    rw ennOfRealOn.boch_apply at realNegOn(g, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X), x with hx
    rw ennOfRealOn.boch_apply at realNegOn(h, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X), x with hx
    rw realNegOn.boch_apply at f, MeasurableSpace.carrier(X), x with hx
    rw realNegOn.boch_apply at g, MeasurableSpace.carrier(X), x with hx
    rw realNegOn.boch_apply at h, MeasurableSpace.carrier(X), x with hx
    have df := ennOfReal.boch_diff with (vF with x, hx)
    have dg := ennOfReal.boch_diff with (vG with x, hx)
    have dh := ennOfReal.boch_diff with (vH with x, hx)
    obtain ⟨fPR, fNR, fPN, fNN, fE⟩ := df
    obtain ⟨gPR, gNR, gPN, gNN, gE⟩ := dg
    obtain ⟨hPR, hNR, hPN, hNN, hE⟩ := dh
    rw ennAdd.boch_real3 with gNR, hPR, fNR, gNN, hPN, fNN
    rw ennAdd.boch_real3 with gPR, hNR, fPR, gPN, hNN, fPN
    have s := sum with x, hx
    have fx := vF with x, hx
    have gx := vG with x, hx
    have hxR := vH with x, hx
    linarith
  have eq := lintegral.congr at X, μ with agree
  have lL := lintegral.add with measure, mGN, eL1
  have lL1 := lintegral.add with measure, mHP, eFN
  have lR := lintegral.add with measure, mGP, eR1
  have lR1 := lintegral.add with measure, mHN, eFP
  rw [lL, lL1, lR, lR1] at eq
  have xFP := lintegral.member at X, μ, ennOfRealOn(f, MeasurableSpace.carrier(X)) with measure
  have xFN := lintegral.member at X, μ, ennOfRealOn(realNegOn(f, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X)) with measure
  have xGP := lintegral.member at X, μ, ennOfRealOn(g, MeasurableSpace.carrier(X)) with measure
  have xGN := lintegral.member at X, μ, ennOfRealOn(realNegOn(g, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X)) with measure
  have xHP := lintegral.member at X, μ, ennOfRealOn(h, MeasurableSpace.carrier(X)) with measure
  have xHN := lintegral.member at X, μ, ennOfRealOn(realNegOn(h, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X)) with measure
  have rFP := ennreal.boch_real with xFP, finFP
  have rFN := ennreal.boch_real with xFN, finFN
  have rGP := ennreal.boch_real with xGP, finGP
  have rGN := ennreal.boch_real with xGN, finGN
  have rHP := ennreal.boch_real with xHP, finHP
  have rHN := ennreal.boch_real with xHN, finHN
  obtain ⟨aFP, bFP, cFP⟩ := rFP
  obtain ⟨aFN, bFN, cFN⟩ := rFN
  obtain ⟨aGP, bGP, cGP⟩ := rGP
  obtain ⟨aGN, bGN, cGN⟩ := rGN
  obtain ⟨aHP, bHP, cHP⟩ := rHP
  obtain ⟨aHN, bHN, cHN⟩ := rHN
  rw ennAdd.boch_real3 with aGN, aHP, aFN, bGN, bHP, bFN at eq
  rw ennAdd.boch_real3 with aGP, aHN, aFP, bGP, bHN, bFP at eq
  rw realMeasureIntegral.boch_parts with iH
  rw realMeasureIntegral.boch_parts with integrableF
  rw realMeasureIntegral.boch_parts with integrableG
  unfold realIntegralValue
  rw [cFP, cFN, cGP, cGN, cHP, cHN]
  linarith

theorem realMeasureIntegral.const_mul (X μ f h : Set, c : Real)
  requires product : ∀ x ∈ MeasurableSpace.carrier(X), h(x) = R[c * f(x)]
  requires values : ∀ x ∈ MeasurableSpace.carrier(X), f(x) ∈ ℝ
  shows realMeasureIntegral(X, μ, h) = R[c * realMeasureIntegral(X, μ, f)]
proof
  have cR : c ∈ ℝ by typecheck
  by_cases i : RealIntegrable(X, μ, f)
  . have r := RealIntegrable.boch_const_mul with i, cR, product
    exact r.right
  . rw realMeasureIntegral.boch_undef with i
    by_cases cz : c = realZero
    . have zR : realZero ∈ ℝ by typecheck
      have hz : ∀ x ∈ MeasurableSpace.carrier(X), h(x) = R[realZero * h(x)]
        intros x hx
        have fx := values with x, hx
        rw product with x, hx
        rw cz
        ring
      by_cases ih : RealIntegrable(X, μ, h)
      . have r := RealIntegrable.boch_const_mul with ih, zR, hz
        rw r.right
        have mR := realMeasureIntegral.member at X, μ, h
        ring
      . rw realMeasureIntegral.boch_undef with ih
        ring
    . have nh : ¬RealIntegrable(X, μ, h)
        intro ih
        have ciR : realInvValue(c) ∈ ℝ by typecheck
        have inv := realInvValue.mul_left at c with cz
        have back : ∀ x ∈ MeasurableSpace.carrier(X), f(x) = R[realInvValue(c) * h(x)]
          intros x hx
          have fx := values with x, hx
          rw product with x, hx
          have e : R[realInvValue(c) * R[c * f(x)]] = R[R[realInvValue(c) * c] * f(x)] by ring
          rw e
          rw inv
          ring
        have r := RealIntegrable.boch_const_mul with ih, ciR, back
        exact i with r.left
      rw realMeasureIntegral.boch_undef with nh
      ring

-- Mathlib's integral_mono and integral_mono_ae.
theorem realMeasureIntegral.mono (X μ f g : Set)
  requires integrableF : RealIntegrable(X, μ, f)
  requires integrableG : RealIntegrable(X, μ, g)
  requires le : AlmostEverywhere(X, μ, realLeLocus(f, g, MeasurableSpace.carrier(X)))
  shows (realMeasureIntegral(X, μ, f):R) ≤ (realMeasureIntegral(X, μ, g):R)
proof
  have fins1 := RealIntegrable.boch_finite with integrableF
  obtain ⟨finFP, finFN⟩ := fins1
  have fins2 := RealIntegrable.boch_finite with integrableG
  obtain ⟨finGP, finGN⟩ := fins2
  have i1 := integrableF
  obtain ⟨measure, mF, aF⟩ := i1
  have i2 := integrableG
  obtain ⟨m2, mG, aG⟩ := i2
  have vF : ∀ x ∈ MeasurableSpace.carrier(X), f(x) ∈ ℝ
    intros x hx
    exact Measurable.boch_value with mF, hx
  have vG : ∀ x ∈ MeasurableSpace.carrier(X), g(x) ∈ ℝ
    intros x hx
    exact Measurable.boch_value with mG, hx
  have eFP := ennOfRealOn.boch_values with vF
  have eFN := ennOfRealOn.boch_values with (realNegOn.boch_values with vF)
  have eGP := ennOfRealOn.boch_values with vG
  have eGN := ennOfRealOn.boch_values with (realNegOn.boch_values with vG)
  have aeP : AlmostEverywhere(X, μ, ennLeSet(ennOfRealOn(f, MeasurableSpace.carrier(X)),
      ennOfRealOn(g, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X)))
    apply AlmostEverywhere.mono with le
    intros x hx
    obtain ⟨xL, xC⟩ := intersection.membership.forward with hx
    obtain ⟨xC2, fg⟩ := realLeLocus.membership.forward with xL
    apply ennLeSet.membership.backward
    refine ⟨xC, ?_⟩
    rw ennOfRealOn.boch_apply at f, MeasurableSpace.carrier(X), x with xC
    rw ennOfRealOn.boch_apply at g, MeasurableSpace.carrier(X), x with xC
    exact ennOfReal.boch_mono with (vF with x, xC), (vG with x, xC), fg
  have aeN : AlmostEverywhere(X, μ, ennLeSet(
      ennOfRealOn(realNegOn(g, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X)),
      ennOfRealOn(realNegOn(f, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X)),
      MeasurableSpace.carrier(X)))
    apply AlmostEverywhere.mono with le
    intros x hx
    obtain ⟨xL, xC⟩ := intersection.membership.forward with hx
    obtain ⟨xC2, fg⟩ := realLeLocus.membership.forward with xL
    apply ennLeSet.membership.backward
    refine ⟨xC, ?_⟩
    rw ennOfRealOn.boch_apply at realNegOn(f, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X), x with xC
    rw ennOfRealOn.boch_apply at realNegOn(g, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X), x with xC
    rw realNegOn.boch_apply at f, MeasurableSpace.carrier(X), x with xC
    rw realNegOn.boch_apply at g, MeasurableSpace.carrier(X), x with xC
    have fx := vF with x, xC
    have gx := vG with x, xC
    have nfR : R[-f(x)] ∈ ℝ by typecheck
    have ngR : R[-g(x)] ∈ ℝ by typecheck
    have l : R[-g(x)] ≤ R[-f(x)] by linarith
    exact ennOfReal.boch_mono with ngR, nfR, l
  have lP := lintegral.mono_ae with measure, eFP, eGP, aeP
  have lN := lintegral.mono_ae with measure, eGN, eFN, aeN
  have xFP := lintegral.member at X, μ, ennOfRealOn(f, MeasurableSpace.carrier(X)) with measure
  have xFN := lintegral.member at X, μ,
    ennOfRealOn(realNegOn(f, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X)) with measure
  have xGP := lintegral.member at X, μ, ennOfRealOn(g, MeasurableSpace.carrier(X)) with measure
  have xGN := lintegral.member at X, μ,
    ennOfRealOn(realNegOn(g, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X)) with measure
  have rFP := ennreal.boch_real with xFP, finFP
  have rFN := ennreal.boch_real with xFN, finFN
  have rGP := ennreal.boch_real with xGP, finGP
  have rGN := ennreal.boch_real with xGN, finGN
  obtain ⟨aFP, bFP, cFP⟩ := rFP
  obtain ⟨aFN, bFN, cFN⟩ := rFN
  obtain ⟨aGP, bGP, cGP⟩ := rGP
  obtain ⟨aGN, bGN, cGN⟩ := rGN
  have l1 := EnnLe.boch_real with lP, aGP
  have l2 := EnnLe.boch_real with lN, aFN
  rw realMeasureIntegral.boch_parts with integrableF
  rw realMeasureIntegral.boch_parts with integrableG
  unfold realIntegralValue
  rw [cFP, cFN, cGP, cGN]
  linarith

-- Mathlib's integral_nonneg (no integrability needed).
theorem realMeasureIntegral.nonneg (X μ f : Set)
  requires measure : Measure(X, μ)
  requires nonneg : ∀ x ∈ MeasurableSpace.carrier(X), realZero ≤ f(x)
  shows realZero ≤ realMeasureIntegral(X, μ, f)
proof
  by_cases i : RealIntegrable(X, μ, f)
  . have i2 := i
    obtain ⟨m, measurable, finite⟩ := i2
    have values : ∀ x ∈ MeasurableSpace.carrier(X), f(x) ∈ ℝ
      intros x hx
      exact Measurable.boch_value with measurable, hx
    rw realMeasureIntegral.boch_parts with i
    unfold realIntegralValue
    rw realNegOn.boch_lint_zero with measure, values, nonneg
    rw ennToReal.boch_zero
    have pM := lintegral.member_any at X, μ, ennOfRealOn(f, MeasurableSpace.carrier(X))
    have pR := ennToReal.boch_member with pM
    have pN := ennToReal.boch_nonneg with pM
    have zR : realZero ∈ ℝ by typecheck
    linarith
  . rw realMeasureIntegral.boch_undef with i
    have zR : realZero ∈ ℝ by typecheck
    linarith

-- Mathlib's integral_eq_lintegral_of_nonneg_ae and
-- ofReal_integral_eq_lintegral_ofReal: for a nonnegative measurable map
-- the integral is the real value of the lower integral.
theorem realMeasureIntegral.eq_lintegral (X μ f : Set)
  requires measure : Measure(X, μ)
  requires measurable : Measurable(f, X, realMeasurableSpace)
  requires nonneg : ∀ x ∈ MeasurableSpace.carrier(X), realZero ≤ f(x)
  shows realMeasureIntegral(X, μ, f) = ennToReal(lintegral(X, μ, f))
proof
  have values : ∀ x ∈ MeasurableSpace.carrier(X), f(x) ∈ ℝ
    intros x hx
    exact Measurable.boch_value with measurable, hx
  have posEq : ∀ x ∈ MeasurableSpace.carrier(X), ennOfRealOn(f, MeasurableSpace.carrier(X))(x) = f(x)
    intros x hx
    rw ennOfRealOn.boch_apply with hx
    exact ennOfReal.value_nonneg with (values with x, hx), (nonneg with x, hx)
  have absEq : ∀ x ∈ MeasurableSpace.carrier(X), realAbsOn(f, MeasurableSpace.carrier(X))(x) = f(x)
    intros x hx
    rw realAbsOn.boch_apply with hx
    have fx := values with x, hx
    have n := nonneg with x, hx
    exact abs.of_nonnegative at f(x) with n
  have lP := lintegral.congr at X, μ with posEq
  have lA := lintegral.congr at X, μ with absEq
  by_cases fin : lintegral(X, μ, f) = ennTop
  . have ni : ¬RealIntegrable(X, μ, f)
      intro i
      obtain ⟨m, mm, finite⟩ := i
      rw lA at finite
      exact finite with fin
    rw realMeasureIntegral.boch_undef with ni
    rw fin
    rw ennToReal.top
  . have i : RealIntegrable(X, μ, f)
      unfold RealIntegrable
      rw lA
      exact ⟨measure, measurable, fin⟩
    rw realMeasureIntegral.boch_parts with i
    unfold realIntegralValue
    rw realNegOn.boch_lint_zero with measure, values, nonneg
    rw ennToReal.boch_zero
    rw lP
    have pM := lintegral.member_any at X, μ, f
    have pR := ennToReal.boch_member with pM
    ring

theorem realMeasureIntegral.of_real_eq_lintegral (X μ f : Set)
  requires integrable : RealIntegrable(X, μ, f)
  requires nonneg : ∀ x ∈ MeasurableSpace.carrier(X), realZero ≤ f(x)
  shows ennOfReal(realMeasureIntegral(X, μ, f)) = lintegral(X, μ, f)
proof
  have i2 := integrable
  obtain ⟨measure, measurable, finite⟩ := i2
  rw realMeasureIntegral.eq_lintegral with measure, measurable, nonneg
  have absEq : ∀ x ∈ MeasurableSpace.carrier(X), realAbsOn(f, MeasurableSpace.carrier(X))(x) = f(x)
    intros x hx
    rw realAbsOn.boch_apply with hx
    have fx := Measurable.boch_value with measurable, hx
    have n := nonneg with x, hx
    exact abs.of_nonnegative at f(x) with n
  have lA := lintegral.congr at X, μ with absEq
  rw lA at finite
  have lM := lintegral.member at X, μ, f with measure
  have r := ennreal.boch_real with lM, finite
  obtain ⟨lR, lN, lE⟩ := r
  rw lE
  exact ennOfReal.value_nonneg with lR, lN

-- Mathlib's integral_eq_lintegral_pos_part_sub_lintegral_neg_part.
theorem realMeasureIntegral.eq_parts (X μ f : Set)
  requires integrable : RealIntegrable(X, μ, f)
  shows realMeasureIntegral(X, μ, f) = realIntegralValue(X, μ, f)
proof
  exact realMeasureIntegral.boch_parts with integrable

-- Mathlib's integral_eq_zero_iff_of_nonneg and
-- integral_pos_iff_support_of_nonneg.
theorem realMeasureIntegral.eq_zero_iff_of_nonneg (X μ f : Set)
  requires integrable : RealIntegrable(X, μ, f)
  requires nonneg : ∀ x ∈ MeasurableSpace.carrier(X), realZero ≤ f(x)
  shows realMeasureIntegral(X, μ, f) = realZero ↔
    AEEqual(X, μ, f, constantOn(MeasurableSpace.carrier(X), realZero))
proof
  have r := realMeasureIntegral.boch_nonneg_parts with integrable, nonneg
  obtain ⟨measure, mE, lR, lN, lE⟩ := r
  have i2 := integrable
  obtain ⟨m2, measurable, finite⟩ := i2
  rw realMeasureIntegral.eq_lintegral with measure, measurable, nonneg
  rw lE
  exact lintegral.eq_zero_iff with measure, mE

theorem realMeasureIntegral.pos_iff_of_nonneg (X μ f : Set)
  requires integrable : RealIntegrable(X, μ, f)
  requires nonneg : ∀ x ∈ MeasurableSpace.carrier(X), realZero ≤ f(x)
  shows realZero < realMeasureIntegral(X, μ, f) ↔
    μ(realGtSet(f, MeasurableSpace.carrier(X), realZero)) ≠ realZero
proof
  have r := realMeasureIntegral.boch_nonneg_parts with integrable, nonneg
  obtain ⟨measure, mE, lR, lN, lE⟩ := r
  have i2 := integrable
  obtain ⟨m2, measurable, finite⟩ := i2
  rw realMeasureIntegral.eq_lintegral with measure, measurable, nonneg
  rw lE
  have iff := lintegral.eq_zero_iff with measure, mE
  have sS := MeasurableSet.real_lt_locus at X, f, realZero with measurable
  have setEq : MeasurableSpace.carrier(X) ∖ equalizer(f, constantOn(MeasurableSpace.carrier(X), realZero),
      MeasurableSpace.carrier(X)) = realGtSet(f, MeasurableSpace.carrier(X), realZero)
    ext x
    constructor
    . intro h
      obtain ⟨xC, xn⟩ := difference.membership.forward with h
      apply realGtSet.membership.backward
      refine ⟨xC, ?_⟩
      have fx := Measurable.boch_value with measurable, xC
      have n := nonneg with x, xC
      by_contra np
      have z : f(x) = realZero by linarith
      have xe : x ∈ equalizer(f, constantOn(MeasurableSpace.carrier(X), realZero), MeasurableSpace.carrier(X))
        apply equalizer.membership.backward
        refine ⟨xC, ?_⟩
        rw constantOn.apply with xC
        exact z
      exact xn with xe
    . intro h
      obtain ⟨xC, pos⟩ := realGtSet.membership.forward with h
      apply difference.membership.backward
      refine ⟨xC, ?_⟩
      intro xe
      obtain ⟨xC2, e⟩ := equalizer.membership.forward with xe
      rw constantOn.apply with xC at e
      rw e at pos
      linarith
  have key : AEEqual(X, μ, f, constantOn(MeasurableSpace.carrier(X), realZero)) ↔
      μ(realGtSet(f, MeasurableSpace.carrier(X), realZero)) = realZero
    unfold AEEqual
    unfold AlmostEverywhere
    rw setEq
    constructor
    . intro null
      obtain ⟨B, hB, sub, zero⟩ := null
      have sB : MeasurableSet(X, B)
        unfold MeasurableSet
        exact hB
      have mono := Measure.mono with measure, sS, sB, sub
      rw zero at mono
      have mS := Measure.member with measure, sS
      have z := EnnLe.zero with mS
      exact EnnLe.antisymmetric with mono, z
    . intro z
      unfold MeasurableSet at sS
      unfold NullSet
      have sub : realGtSet(f, MeasurableSpace.carrier(X), realZero) ⊆ realGtSet(f, MeasurableSpace.carrier(X), realZero)
        intros x hx
        exact hx
      exact ⟨realGtSet(f, MeasurableSpace.carrier(X), realZero), sS, sub, z⟩
  constructor
  . intro pos
    intro z
    have ae := key.backward with z
    have l0 := iff.backward with ae
    rw l0 at pos
    linarith
  . intro nz
    by_contra np
    have l0 : lintegral(X, μ, f) = realZero by linarith
    exact nz with (key.forward with (iff.forward with l0))

-- Mathlib's Integrable.measure_le_integral / integral_indicator_one:
-- ∫ 1_A = μ(A).
theorem realMeasureIntegral.indicator_one (X μ A : Set)
  requires measure : Measure(X, μ)
  requires set : MeasurableSet(X, A)
  shows realMeasureIntegral(X, μ, indicatorOn(MeasurableSpace.carrier(X), A, realOne,
    realZero)) = measureReal(μ, A)
proof
  have space := Measure.space with measure
  have oR : realOne ∈ ℝ by typecheck
  have zR : realZero ∈ ℝ by typecheck
  have measurable := Measurable.indicator with space, set, oR, zR
  have nonneg : ∀ x ∈ MeasurableSpace.carrier(X),
      realZero ≤ indicatorOn(MeasurableSpace.carrier(X), A, realOne, realZero)(x)
    intros x hx
    have ap := indicatorOn.apply at MeasurableSpace.carrier(X), A, realOne, realZero, x with hx
    by_cases xA : x ∈ A
    . rw ap.left with xA
      linarith
    . rw ap.right with xA
      linarith
  rw realMeasureIntegral.eq_lintegral with measure, measurable, nonneg
  have oM : realOne ∈ ennreal
    have oN : realZero ≤ realOne by linarith
    exact ennreal.of_real with oR, oN
  rw lintegral.indicator_const with measure, set, oM
  have mA := Measure.member with measure, set
  rw ennMul.one with mA
  unfold measureReal
  rfl

-- Mathlib's integral_const: ∫ c = μ(X) c on a finite measure.
theorem realMeasureIntegral.const (X μ : Set, c : Real)
  requires finite : FiniteMeasure(X, μ)
  shows realMeasureIntegral(X, μ, constantOn(MeasurableSpace.carrier(X), c)) =
    R[measureReal(μ, MeasurableSpace.carrier(X)) * c]
proof
  obtain ⟨measure, fin⟩ := finite
  have space := Measure.space with measure
  have whole := MeasurableSet.univ with space
  have one := realMeasureIntegral.indicator_one with measure, whole
  have agree : ∀ x ∈ MeasurableSpace.carrier(X),
      indicatorOn(MeasurableSpace.carrier(X), MeasurableSpace.carrier(X), realOne, realZero)(x) =
      constantOn(MeasurableSpace.carrier(X), realOne)(x)
    intros x hx
    have ap := indicatorOn.apply at MeasurableSpace.carrier(X), MeasurableSpace.carrier(X), realOne, realZero, x with hx
    rw ap.left with hx
    rw constantOn.apply with hx
  rw realMeasureIntegral.boch_congr with agree at one
  have product : ∀ x ∈ MeasurableSpace.carrier(X), constantOn(MeasurableSpace.carrier(X), c)(x) =
      R[c * constantOn(MeasurableSpace.carrier(X), realOne)(x)]
    intros x hx
    rw constantOn.apply at MeasurableSpace.carrier(X), c, x with hx
    rw constantOn.apply at MeasurableSpace.carrier(X), realOne, x with hx
    ring
  have values : ∀ x ∈ MeasurableSpace.carrier(X), constantOn(MeasurableSpace.carrier(X), realOne)(x) ∈ ℝ
    intros x hx
    rw constantOn.apply with hx
    typecheck
  rw realMeasureIntegral.const_mul with product, values
  rw one
  have mM := Measure.member with measure, whole
  unfold measureReal
  have mR := ennToReal.boch_member with mM
  ring

-- Section: Helpers for the complex integral
theorem Measurable.boch_cvalue (f X x : Set)
  requires measurable : Measurable(f, X, complexMeasurableSpace)
  requires member : x ∈ MeasurableSpace.carrier(X)
  shows f(x) ∈ complexCarrier
proof
  have m := Measurable.maps with measurable, member
  rw complexMeasurableSpace.carrier at m
  exact m

theorem complexAbsOn.boch_values (X f : Set)
  requires values : ∀ x ∈ MeasurableSpace.carrier(X), f(x) ∈ complexCarrier
  shows EnnValued(X, complexAbsOn(f, MeasurableSpace.carrier(X)))
proof
  unfold EnnValued
  unfold MapsInto
  intros x hx
  rw complexAbsOn.boch_apply with hx
  have fx := values with x, hx
  have aR : complexAbs(f(x)) ∈ ℝ by typecheck
  have aN := complexAbs.nonnegative with fx
  exact ennreal.of_real with aR, aN

theorem ComplexIntegrable.boch_parts (X μ f : Set)
  requires integrable : ComplexIntegrable(X, μ, f)
  shows RealIntegrable(X, μ, realPartOn(f, MeasurableSpace.carrier(X))) ∧
    RealIntegrable(X, μ, imagPartOn(f, MeasurableSpace.carrier(X)))
proof
  obtain ⟨measure, mF, aF⟩ := integrable
  have space := Measure.space with measure
  have vF : ∀ x ∈ MeasurableSpace.carrier(X), f(x) ∈ complexCarrier
    intros x hx
    exact Measurable.boch_cvalue with mF, hx
  have maps : MapsInto(f, MeasurableSpace.carrier(X), complexCarrier)
    unfold MapsInto
    exact vF
  have iff := Measurable.complex_iff with space, maps
  have mp := iff.forward with mF
  obtain ⟨mRe, mIm⟩ := mp
  have vC := complexAbsOn.boch_values with vF
  have vRe := realAbsOn.boch_values with mRe
  have vIm := realAbsOn.boch_values with mIm
  have leRe : ∀ x ∈ MeasurableSpace.carrier(X),
      EnnLe(realAbsOn(realPartOn(f, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X))(x),
        complexAbsOn(f, MeasurableSpace.carrier(X))(x))
    intros x hx
    rw realAbsOn.boch_apply with hx
    rw realPartOn.apply with hx
    rw complexAbsOn.boch_apply with hx
    have fx := vF with x, hx
    have reR := complexRe.real with fx
    have aR : abs(complexRe(f(x))) ∈ ℝ by typecheck
    have cR : complexAbs(f(x)) ∈ ℝ by typecheck
    have aN := abs.nonnegative at complexRe(f(x))
    have l := complexAbs.re_le with fx
    exact EnnLe.boch_of_real with aR, cR, aN, l
  have leIm : ∀ x ∈ MeasurableSpace.carrier(X),
      EnnLe(realAbsOn(imagPartOn(f, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X))(x),
        complexAbsOn(f, MeasurableSpace.carrier(X))(x))
    intros x hx
    rw realAbsOn.boch_apply with hx
    rw imagPartOn.apply with hx
    rw complexAbsOn.boch_apply with hx
    have fx := vF with x, hx
    have imR := complexIm.real with fx
    have aR : abs(complexIm(f(x))) ∈ ℝ by typecheck
    have cR : complexAbs(f(x)) ∈ ℝ by typecheck
    have aN := abs.nonnegative at complexIm(f(x))
    have l := complexAbs.im_le with fx
    exact EnnLe.boch_of_real with aR, cR, aN, l
  have lRe := lintegral.mono with measure, vRe, vC, leRe
  have lIm := lintegral.mono with measure, vIm, vC, leIm
  have finRe : lintegral(X, μ, realAbsOn(realPartOn(f, MeasurableSpace.carrier(X)),
      MeasurableSpace.carrier(X))) ≠ ennTop
    intro top
    rw top at lRe
    have t := EnnLe.top_eq with lRe
    exact aF with t
  have finIm : lintegral(X, μ, realAbsOn(imagPartOn(f, MeasurableSpace.carrier(X)),
      MeasurableSpace.carrier(X))) ≠ ennTop
    intro top
    rw top at lIm
    have t := EnnLe.top_eq with lIm
    exact aF with t
  have iRe : RealIntegrable(X, μ, realPartOn(f, MeasurableSpace.carrier(X)))
    unfold RealIntegrable
    exact ⟨measure, mRe, finRe⟩
  have iIm : RealIntegrable(X, μ, imagPartOn(f, MeasurableSpace.carrier(X)))
    unfold RealIntegrable
    exact ⟨measure, mIm, finIm⟩
  exact ⟨iRe, iIm⟩

theorem ComplexIntegrable.boch_of_parts (X μ f : Set)
  requires measure : Measure(X, μ)
  requires values : ∀ x ∈ MeasurableSpace.carrier(X), f(x) ∈ complexCarrier
  requires integrableRe : RealIntegrable(X, μ, realPartOn(f, MeasurableSpace.carrier(X)))
  requires integrableIm : RealIntegrable(X, μ, imagPartOn(f, MeasurableSpace.carrier(X)))
  shows ComplexIntegrable(X, μ, f)
proof
  have i1 := integrableRe
  obtain ⟨m1, mRe, aRe⟩ := i1
  have i2 := integrableIm
  obtain ⟨m2, mIm, aIm⟩ := i2
  have space := Measure.space with measure
  have maps : MapsInto(f, MeasurableSpace.carrier(X), complexCarrier)
    unfold MapsInto
    exact values
  have iff := Measurable.complex_iff with space, maps
  have mF := iff.backward with ⟨mRe, mIm⟩
  have vC := complexAbsOn.boch_values with values
  have vRe := realAbsOn.boch_values with mRe
  have vIm := realAbsOn.boch_values with mIm
  have vS := ennAddOn.boch_values with vRe, vIm
  have le : ∀ x ∈ MeasurableSpace.carrier(X), EnnLe(complexAbsOn(f, MeasurableSpace.carrier(X))(x),
      ennAddOn(realAbsOn(realPartOn(f, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X)),
        realAbsOn(imagPartOn(f, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X)),
        MeasurableSpace.carrier(X))(x))
    intros x hx
    rw ennAddOn.lint_apply with hx
    rw realAbsOn.boch_apply at realPartOn(f, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X), x with hx
    rw realAbsOn.boch_apply at imagPartOn(f, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X), x with hx
    rw realPartOn.apply with hx
    rw imagPartOn.apply with hx
    rw complexAbsOn.boch_apply with hx
    have fx := values with x, hx
    have reR := complexRe.real with fx
    have imR := complexIm.real with fx
    have aR : abs(complexRe(f(x))) ∈ ℝ by typecheck
    have bR : abs(complexIm(f(x))) ∈ ℝ by typecheck
    have aN := abs.nonnegative at complexRe(f(x))
    have bN := abs.nonnegative at complexIm(f(x))
    rw ennAdd.finite with aR, bR, aN, bN
    have cR : complexAbs(f(x)) ∈ ℝ by typecheck
    have sR : R[abs(complexRe(f(x))) + abs(complexIm(f(x)))] ∈ ℝ by typecheck
    have cN := complexAbs.nonnegative with fx
    have l := GRH.Holomorphic.complexAbs.le_parts with fx
    exact EnnLe.boch_of_real with cR, sR, cN, l
  have mono := lintegral.mono with measure, vC, vS, le
  have aM := realAbsOn.boch_measurable with mRe
  rw lintegral.add with measure, aM, vIm at mono
  have lA := lintegral.member at X, μ, realAbsOn(realPartOn(f, MeasurableSpace.carrier(X)),
    MeasurableSpace.carrier(X)) with measure
  have lB := lintegral.member at X, μ, realAbsOn(imagPartOn(f, MeasurableSpace.carrier(X)),
    MeasurableSpace.carrier(X)) with measure
  have fin := ennAdd.boch_finite with lA, lB, aRe, aIm
  unfold ComplexIntegrable
  refine ⟨measure, mF, ?_⟩
  intro top
  rw top at mono
  have t := EnnLe.top_eq with mono
  exact fin with t

theorem complexMeasureIntegral.boch_parts (X μ f : Set)
  requires integrable : ComplexIntegrable(X, μ, f)
  shows complexMeasureIntegral(X, μ, f) =
    (realMeasureIntegral(X, μ, realPartOn(f, MeasurableSpace.carrier(X))),
      realMeasureIntegral(X, μ, imagPartOn(f, MeasurableSpace.carrier(X))))
proof
  have aR := realMeasureIntegral.member at X, μ, realPartOn(f, MeasurableSpace.carrier(X))
  have bR := realMeasureIntegral.member at X, μ, imagPartOn(f, MeasurableSpace.carrier(X))
  have p := complexCarrier.pair at realMeasureIntegral(X, μ, realPartOn(f, MeasurableSpace.carrier(X))),
    realMeasureIntegral(X, μ, imagPartOn(f, MeasurableSpace.carrier(X)))
  unfold complexMeasureIntegral
  apply union.of_unique
  . apply complexMeasureIntegral.family.membership.backward
    refine ⟨p, ?_⟩
    left
    exact ⟨integrable, rfl⟩
  . intros w hw
    obtain ⟨wIn, alt⟩ := complexMeasureIntegral.family.membership.forward with hw
    cases alt with q | n
    . exact q.right
    . exfalso
      exact n.left with integrable

theorem complexMeasureIntegral.boch_undef (X μ f : Set)
  requires absent : ¬ComplexIntegrable(X, μ, f)
  shows complexMeasureIntegral(X, μ, f) = complexZero
proof
  have zR : realZero ∈ ℝ by typecheck
  have p := complexCarrier.pair at realZero, realZero
  have zM : complexZero ∈ complexCarrier
    unfold complexZero
    exact p
  unfold complexMeasureIntegral
  apply union.of_unique
  . apply complexMeasureIntegral.family.membership.backward
    refine ⟨zM, ?_⟩
    right
    exact ⟨absent, rfl⟩
  . intros w hw
    obtain ⟨wIn, alt⟩ := complexMeasureIntegral.family.membership.forward with hw
    cases alt with q | n
    . exfalso
      exact absent with q.left
    . exact n.right

-- c · f on A, for real c and f (a helper for linear combinations).
def bochScaleOn (c f A : Set) : Set := { (x, R[c * f(x)]) | x ∈ A }

theorem bochScaleOn.boch_apply (c f A x : Set)
  requires member : x ∈ A
  shows bochScaleOn(c, f, A)(x) = R[c * f(x)]
proof
  have edge : (x, R[c * f(x)]) ∈ bochScaleOn(c, f, A)
    apply bochScaleOn.membership.backward
    exact ⟨x, member, rfl⟩
  have pairs : ∀ p ∈ bochScaleOn(c, f, A), ∃ a, ∃ b, p = (a, b)
    intros p hp
    obtain ⟨k0, hk, pEq⟩ := bochScaleOn.membership.forward with hp
    rw ← pEq
    exact ⟨k0, R[c * f(k0)], rfl⟩
  have functional : ∀ a, ∀ b, ∀ e, (a, b) ∈ bochScaleOn(c, f, A) → (a, e) ∈ bochScaleOn(c, f, A) → b = e
    intros a b e hb hc
    obtain ⟨k0, hk, bEq⟩ := bochScaleOn.membership.forward with hb
    obtain ⟨m0, hm, cEq⟩ := bochScaleOn.membership.forward with hc
    obtain ⟨ka, bb⟩ := orderedPair.injective with bEq
    obtain ⟨ma, ee⟩ := orderedPair.injective with cEq
    rw [← bb, ← ee, ka, ← ma]
  exact pairGraph.apply with pairs, functional, edge


theorem RealIntegrable.boch_zero (X μ h : Set)
  requires measure : Measure(X, μ)
  requires zero : ∀ x ∈ MeasurableSpace.carrier(X), h(x) = realZero
  shows RealIntegrable(X, μ, h) ∧ realMeasureIntegral(X, μ, h) = realZero
proof
  have space := Measure.space with measure
  have rs := realMeasurableSpace.space
  have zR : realZero ∈ ℝ by typecheck
  have zC : realZero ∈ MeasurableSpace.carrier(realMeasurableSpace)
    rw realMeasurableSpace.carrier
    exact zR
  have mH := Measurable.constant with space, rs, zC, zero
  have absEq : ∀ x ∈ MeasurableSpace.carrier(X), realAbsOn(h, MeasurableSpace.carrier(X))(x) =
      constantOn(MeasurableSpace.carrier(X), realZero)(x)
    intros x hx
    rw realAbsOn.boch_apply with hx
    rw constantOn.apply with hx
    rw zero with x, hx
    exact abs.zero
  have lA := lintegral.congr at X, μ with absEq
  rw lintegral.zero with measure at lA
  have fin : lintegral(X, μ, realAbsOn(h, MeasurableSpace.carrier(X))) ≠ ennTop
    rw lA
    exact ennreal.zero_not_top
  have i : RealIntegrable(X, μ, h)
    unfold RealIntegrable
    exact ⟨measure, mH, fin⟩
  refine ⟨i, ?_⟩
  have prod : ∀ x ∈ MeasurableSpace.carrier(X), h(x) = R[realZero * h(x)]
    intros x hx
    rw zero with x, hx
    ring
  have r := RealIntegrable.boch_const_mul with i, zR, prod
  rw r.right
  have mR := realMeasureIntegral.member at X, μ, h
  ring

theorem complexMeasureIntegral.boch_ext (z A B : Set)
  requires member : z ∈ complexCarrier
  requires re : complexRe(z) = A
  requires im : complexIm(z) = B
  shows (A, B) = z
proof
  have e := complex.ext with member
  rw [← re, ← im]
  rw ← e

theorem ComplexIntegrable.boch_congr (X μ f g : Set)
  requires integrable : ComplexIntegrable(X, μ, f)
  requires agree : ∀ x ∈ MeasurableSpace.carrier(X), f(x) = g(x)
  shows ComplexIntegrable(X, μ, g)
proof
  obtain ⟨measure, measurable, finite⟩ := integrable
  have mg := Measurable.congr with measurable, agree
  have absEq : ∀ x ∈ MeasurableSpace.carrier(X),
      complexAbsOn(f, MeasurableSpace.carrier(X))(x) = complexAbsOn(g, MeasurableSpace.carrier(X))(x)
    intros x hx
    rw complexAbsOn.boch_apply at f, MeasurableSpace.carrier(X), x with hx
    rw complexAbsOn.boch_apply at g, MeasurableSpace.carrier(X), x with hx
    rw agree with x, hx
  have e := lintegral.congr at X, μ with absEq
  rw e at finite
  exact ⟨measure, mg, finite⟩

theorem complexMeasureIntegral.boch_congr (X μ f g : Set)
  requires agree : ∀ x ∈ MeasurableSpace.carrier(X), f(x) = g(x)
  shows complexMeasureIntegral(X, μ, f) = complexMeasureIntegral(X, μ, g)
proof
  have back : ∀ x ∈ MeasurableSpace.carrier(X), g(x) = f(x)
    intros x hx
    rw agree with x, hx
  by_cases i : ComplexIntegrable(X, μ, f)
  . have ig := ComplexIntegrable.boch_congr with i, agree
    rw complexMeasureIntegral.boch_parts with i
    rw complexMeasureIntegral.boch_parts with ig
    have reEq : ∀ x ∈ MeasurableSpace.carrier(X),
        realPartOn(f, MeasurableSpace.carrier(X))(x) = realPartOn(g, MeasurableSpace.carrier(X))(x)
      intros x hx
      rw realPartOn.apply at f, MeasurableSpace.carrier(X), x with hx
      rw realPartOn.apply at g, MeasurableSpace.carrier(X), x with hx
      rw agree with x, hx
    have imEq : ∀ x ∈ MeasurableSpace.carrier(X),
        imagPartOn(f, MeasurableSpace.carrier(X))(x) = imagPartOn(g, MeasurableSpace.carrier(X))(x)
      intros x hx
      rw imagPartOn.apply at f, MeasurableSpace.carrier(X), x with hx
      rw imagPartOn.apply at g, MeasurableSpace.carrier(X), x with hx
      rw agree with x, hx
    rw realMeasureIntegral.boch_congr at X, μ with reEq
    rw realMeasureIntegral.boch_congr at X, μ with imEq
  . have ng : ¬ComplexIntegrable(X, μ, g)
      intro ig
      exact i with (ComplexIntegrable.boch_congr with ig, back)
    rw complexMeasureIntegral.boch_undef with i
    rw complexMeasureIntegral.boch_undef with ng

-- Section: Laws of the complex integral
theorem complexMeasureIntegral.member (X μ f : Set)
  shows complexMeasureIntegral(X, μ, f) ∈ complexCarrier
proof
  by_cases i : ComplexIntegrable(X, μ, f)
  . rw complexMeasureIntegral.boch_parts with i
    have aR := realMeasureIntegral.member at X, μ, realPartOn(f, MeasurableSpace.carrier(X))
    have bR := realMeasureIntegral.member at X, μ, imagPartOn(f, MeasurableSpace.carrier(X))
    exact complexCarrier.pair at realMeasureIntegral(X, μ, realPartOn(f, MeasurableSpace.carrier(X))),
      realMeasureIntegral(X, μ, imagPartOn(f, MeasurableSpace.carrier(X)))
  . rw complexMeasureIntegral.boch_undef with i
    have zR : realZero ∈ ℝ by typecheck
    unfold complexZero
    exact complexCarrier.pair at realZero, realZero

theorem complexMeasureIntegral.undef (X μ f : Set)
  requires absent : ¬ComplexIntegrable(X, μ, f)
  shows complexMeasureIntegral(X, μ, f) = complexZero
proof
  exact complexMeasureIntegral.boch_undef with absent

-- Mathlib's integral_re, integral_im, integral_complex_ofReal,
-- integral_ofReal.
theorem complexMeasureIntegral.re (X μ f : Set)
  requires integrable : ComplexIntegrable(X, μ, f)
  shows complexRe(complexMeasureIntegral(X, μ, f)) =
    realMeasureIntegral(X, μ, realPartOn(f, MeasurableSpace.carrier(X)))
proof
  rw complexMeasureIntegral.boch_parts with integrable
  unfold complexRe
  rw fst.pair

theorem complexMeasureIntegral.im (X μ f : Set)
  requires integrable : ComplexIntegrable(X, μ, f)
  shows complexIm(complexMeasureIntegral(X, μ, f)) =
    realMeasureIntegral(X, μ, imagPartOn(f, MeasurableSpace.carrier(X)))
proof
  rw complexMeasureIntegral.boch_parts with integrable
  unfold complexIm
  rw snd.pair

-- Section: Helpers for linearity of the complex integral
theorem ComplexIntegrable.boch_const_mul (X μ f h c : Set)
  requires integrable : ComplexIntegrable(X, μ, f)
  requires member : c ∈ complexCarrier
  requires product : ∀ x ∈ MeasurableSpace.carrier(X), h(x) = ℂ[c * f(x)]
  shows ComplexIntegrable(X, μ, h) ∧
    complexMeasureIntegral(X, μ, h) = ℂ[c * complexMeasureIntegral(X, μ, f)]
proof
  have pf := ComplexIntegrable.boch_parts with integrable
  obtain ⟨rF, iF⟩ := pf
  have i2 := integrable
  obtain ⟨measure, mF, aF⟩ := i2
  have vF : ∀ x ∈ MeasurableSpace.carrier(X), f(x) ∈ complexCarrier
    intros x hx
    exact Measurable.boch_cvalue with mF, hx
  have aR := complexRe.real with member
  have bR := complexIm.real with member
  have nbR : R[-complexIm(c)] ∈ ℝ by typecheck
  have s1 : ∀ x ∈ MeasurableSpace.carrier(X),
      bochScaleOn(complexRe(c), realPartOn(f, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X))(x) =
      R[complexRe(c) * realPartOn(f, MeasurableSpace.carrier(X))(x)]
    intros x hx
    exact bochScaleOn.boch_apply with hx
  have s2 : ∀ x ∈ MeasurableSpace.carrier(X),
      bochScaleOn(R[-complexIm(c)], imagPartOn(f, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X))(x) =
      R[R[-complexIm(c)] * imagPartOn(f, MeasurableSpace.carrier(X))(x)]
    intros x hx
    exact bochScaleOn.boch_apply with hx
  have s3 : ∀ x ∈ MeasurableSpace.carrier(X),
      bochScaleOn(complexRe(c), imagPartOn(f, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X))(x) =
      R[complexRe(c) * imagPartOn(f, MeasurableSpace.carrier(X))(x)]
    intros x hx
    exact bochScaleOn.boch_apply with hx
  have s4 : ∀ x ∈ MeasurableSpace.carrier(X),
      bochScaleOn(complexIm(c), realPartOn(f, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X))(x) =
      R[complexIm(c) * realPartOn(f, MeasurableSpace.carrier(X))(x)]
    intros x hx
    exact bochScaleOn.boch_apply with hx
  have r1 := RealIntegrable.boch_const_mul with rF, aR, s1
  have r2 := RealIntegrable.boch_const_mul with iF, nbR, s2
  have r3 := RealIntegrable.boch_const_mul with iF, aR, s3
  have r4 := RealIntegrable.boch_const_mul with rF, bR, s4
  obtain ⟨j1, e1⟩ := r1
  obtain ⟨j2, e2⟩ := r2
  obtain ⟨j3, e3⟩ := r3
  obtain ⟨j4, e4⟩ := r4
  have reSum : ∀ x ∈ MeasurableSpace.carrier(X), realPartOn(h, MeasurableSpace.carrier(X))(x) =
      R[bochScaleOn(complexRe(c), realPartOn(f, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X))(x) +
        bochScaleOn(R[-complexIm(c)], imagPartOn(f, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X))(x)]
    intros x hx
    rw s1 with x, hx
    rw s2 with x, hx
    rw realPartOn.apply at h, MeasurableSpace.carrier(X), x with hx
    rw realPartOn.apply at f, MeasurableSpace.carrier(X), x with hx
    rw imagPartOn.apply at f, MeasurableSpace.carrier(X), x with hx
    rw product with x, hx
    have fx := vF with x, hx
    rw complexRe.mul with member, fx
    have p := complexRe.real with fx
    have q := complexIm.real with fx
    ring
  have imSum : ∀ x ∈ MeasurableSpace.carrier(X), imagPartOn(h, MeasurableSpace.carrier(X))(x) =
      R[bochScaleOn(complexRe(c), imagPartOn(f, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X))(x) +
        bochScaleOn(complexIm(c), realPartOn(f, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X))(x)]
    intros x hx
    rw s3 with x, hx
    rw s4 with x, hx
    rw imagPartOn.apply at h, MeasurableSpace.carrier(X), x with hx
    rw realPartOn.apply at f, MeasurableSpace.carrier(X), x with hx
    rw imagPartOn.apply at f, MeasurableSpace.carrier(X), x with hx
    rw product with x, hx
    have fx := vF with x, hx
    rw complexIm.mul with member, fx
    have p := complexRe.real with fx
    have q := complexIm.real with fx
    ring
  have rH := RealIntegrable.boch_add with j1, j2, reSum
  have iH := RealIntegrable.boch_add with j3, j4, imSum
  have vH : ∀ x ∈ MeasurableSpace.carrier(X), h(x) ∈ complexCarrier
    intros x hx
    rw product with x, hx
    have fx := vF with x, hx
    typecheck
  have intH := ComplexIntegrable.boch_of_parts with measure, vH, rH, iH
  refine ⟨intH, ?_⟩
  rw complexMeasureIntegral.boch_parts with intH
  rw realMeasureIntegral.add with j1, j2, reSum
  rw realMeasureIntegral.add with j3, j4, imSum
  rw [e1, e2, e3, e4]
  have IM := complexMeasureIntegral.member at X, μ, f
  have ReI := complexMeasureIntegral.re with integrable
  have ImI := complexMeasureIntegral.im with integrable
  apply complexMeasureIntegral.boch_ext
  . typecheck
  . rw complexRe.mul with member, IM
    rw [ReI, ImI]
    ring
  . rw complexIm.mul with member, IM
    rw [ReI, ImI]
    ring

theorem complexMeasureIntegral.boch_zero (X μ h : Set)
  requires zero : ∀ x ∈ MeasurableSpace.carrier(X), h(x) = complexZero
  shows complexMeasureIntegral(X, μ, h) = complexZero
proof
  by_cases i : ComplexIntegrable(X, μ, h)
  . have i2 := i
    obtain ⟨measure, mH, aH⟩ := i2
    have reZ : ∀ x ∈ MeasurableSpace.carrier(X), realPartOn(h, MeasurableSpace.carrier(X))(x) = realZero
      intros x hx
      rw realPartOn.apply with hx
      rw zero with x, hx
      unfold complexZero
      unfold complexRe
      rw fst.pair
    have imZ : ∀ x ∈ MeasurableSpace.carrier(X), imagPartOn(h, MeasurableSpace.carrier(X))(x) = realZero
      intros x hx
      rw imagPartOn.apply with hx
      rw zero with x, hx
      unfold complexZero
      unfold complexIm
      rw snd.pair
    have r1 := RealIntegrable.boch_zero with measure, reZ
    have r2 := RealIntegrable.boch_zero with measure, imZ
    rw complexMeasureIntegral.boch_parts with i
    rw [r1.right, r2.right]
    unfold complexZero
    rfl
  . exact complexMeasureIntegral.boch_undef with i

theorem ComplexIntegrable.boch_conj (X μ f h : Set)
  requires integrable : ComplexIntegrable(X, μ, f)
  requires conjugate : ∀ x ∈ MeasurableSpace.carrier(X), h(x) = complexConj(f(x))
  shows ComplexIntegrable(X, μ, h) ∧
    complexMeasureIntegral(X, μ, h) = complexConj(complexMeasureIntegral(X, μ, f))
proof
  have pf := ComplexIntegrable.boch_parts with integrable
  obtain ⟨rF, iF⟩ := pf
  have i2 := integrable
  obtain ⟨measure, mF, aF⟩ := i2
  have vF : ∀ x ∈ MeasurableSpace.carrier(X), f(x) ∈ complexCarrier
    intros x hx
    exact Measurable.boch_cvalue with mF, hx
  have reEq : ∀ x ∈ MeasurableSpace.carrier(X),
      realPartOn(f, MeasurableSpace.carrier(X))(x) = realPartOn(h, MeasurableSpace.carrier(X))(x)
    intros x hx
    rw realPartOn.apply at f, MeasurableSpace.carrier(X), x with hx
    rw realPartOn.apply at h, MeasurableSpace.carrier(X), x with hx
    rw conjugate with x, hx
    rw complexConj.re with (vF with x, hx)
  have m1R : R[-realOne] ∈ ℝ by typecheck
  have imEq : ∀ x ∈ MeasurableSpace.carrier(X),
      imagPartOn(h, MeasurableSpace.carrier(X))(x) = R[R[-realOne] * imagPartOn(f, MeasurableSpace.carrier(X))(x)]
    intros x hx
    rw imagPartOn.apply at f, MeasurableSpace.carrier(X), x with hx
    rw imagPartOn.apply at h, MeasurableSpace.carrier(X), x with hx
    rw conjugate with x, hx
    have fx := vF with x, hx
    rw complexConj.im with fx
    have q := complexIm.real with fx
    ring
  have rH := RealIntegrable.boch_congr with rF, reEq
  have r2 := RealIntegrable.boch_const_mul with iF, m1R, imEq
  obtain ⟨iH, eIm⟩ := r2
  have vH : ∀ x ∈ MeasurableSpace.carrier(X), h(x) ∈ complexCarrier
    intros x hx
    rw conjugate with x, hx
    have fx := vF with x, hx
    typecheck
  have intH := ComplexIntegrable.boch_of_parts with measure, vH, rH, iH
  refine ⟨intH, ?_⟩
  rw complexMeasureIntegral.boch_parts with intH
  rw eIm
  rw ← realMeasureIntegral.boch_congr at X, μ with reEq
  have IM := complexMeasureIntegral.member at X, μ, f
  have ReI := complexMeasureIntegral.re with integrable
  have ImI := complexMeasureIntegral.im with integrable
  apply complexMeasureIntegral.boch_ext
  . typecheck
  . rw complexConj.re with IM
    rw ReI
  . rw complexConj.im with IM
    rw ImI
    have q := realMeasureIntegral.member at X, μ, imagPartOn(f, MeasurableSpace.carrier(X))
    ring

theorem ComplexIntegrable.boch_add (X μ f g h : Set)
  requires integrableF : ComplexIntegrable(X, μ, f)
  requires integrableG : ComplexIntegrable(X, μ, g)
  requires sum : ∀ x ∈ MeasurableSpace.carrier(X), h(x) = ℂ[f(x) + g(x)]
  shows ComplexIntegrable(X, μ, h) ∧
    complexMeasureIntegral(X, μ, h) =
      ℂ[complexMeasureIntegral(X, μ, f) + complexMeasureIntegral(X, μ, g)]
proof
  have pf := ComplexIntegrable.boch_parts with integrableF
  obtain ⟨rF, iF⟩ := pf
  have pg := ComplexIntegrable.boch_parts with integrableG
  obtain ⟨rG, iG⟩ := pg
  have i2 := integrableF
  obtain ⟨measure, mF, aF⟩ := i2
  have i3 := integrableG
  obtain ⟨m3, mG, aG⟩ := i3
  have vF : ∀ x ∈ MeasurableSpace.carrier(X), f(x) ∈ complexCarrier
    intros x hx
    exact Measurable.boch_cvalue with mF, hx
  have vG : ∀ x ∈ MeasurableSpace.carrier(X), g(x) ∈ complexCarrier
    intros x hx
    exact Measurable.boch_cvalue with mG, hx
  have reSum : ∀ x ∈ MeasurableSpace.carrier(X), realPartOn(h, MeasurableSpace.carrier(X))(x) =
      R[realPartOn(f, MeasurableSpace.carrier(X))(x) + realPartOn(g, MeasurableSpace.carrier(X))(x)]
    intros x hx
    rw realPartOn.apply at h, MeasurableSpace.carrier(X), x with hx
    rw realPartOn.apply at f, MeasurableSpace.carrier(X), x with hx
    rw realPartOn.apply at g, MeasurableSpace.carrier(X), x with hx
    rw sum with x, hx
    exact complexRe.add with (vF with x, hx), (vG with x, hx)
  have imSum : ∀ x ∈ MeasurableSpace.carrier(X), imagPartOn(h, MeasurableSpace.carrier(X))(x) =
      R[imagPartOn(f, MeasurableSpace.carrier(X))(x) + imagPartOn(g, MeasurableSpace.carrier(X))(x)]
    intros x hx
    rw imagPartOn.apply at h, MeasurableSpace.carrier(X), x with hx
    rw imagPartOn.apply at f, MeasurableSpace.carrier(X), x with hx
    rw imagPartOn.apply at g, MeasurableSpace.carrier(X), x with hx
    rw sum with x, hx
    exact complexIm.add with (vF with x, hx), (vG with x, hx)
  have rH := RealIntegrable.boch_add with rF, rG, reSum
  have iH := RealIntegrable.boch_add with iF, iG, imSum
  have vH : ∀ x ∈ MeasurableSpace.carrier(X), h(x) ∈ complexCarrier
    intros x hx
    rw sum with x, hx
    have fx := vF with x, hx
    have gx := vG with x, hx
    typecheck
  have intH := ComplexIntegrable.boch_of_parts with measure, vH, rH, iH
  refine ⟨intH, ?_⟩
  rw complexMeasureIntegral.boch_parts with intH
  rw realMeasureIntegral.add with rF, rG, reSum
  rw realMeasureIntegral.add with iF, iG, imSum
  have FM := complexMeasureIntegral.member at X, μ, f
  have GM := complexMeasureIntegral.member at X, μ, g
  have ReF := complexMeasureIntegral.re with integrableF
  have ImF := complexMeasureIntegral.im with integrableF
  have ReG := complexMeasureIntegral.re with integrableG
  have ImG := complexMeasureIntegral.im with integrableG
  apply complexMeasureIntegral.boch_ext
  . typecheck
  . rw complexRe.add with FM, GM
    rw [ReF, ReG]
  . rw complexIm.add with FM, GM
    rw [ImF, ImG]

theorem ComplexIntegrable.boch_abs_real (X μ f : Set)
  requires integrable : ComplexIntegrable(X, μ, f)
  shows RealIntegrable(X, μ, complexAbsOn(f, MeasurableSpace.carrier(X)))
proof
  have i2 := integrable
  obtain ⟨measure, mF, aF⟩ := i2
  have absolute : ∀ x ∈ MeasurableSpace.carrier(X),
      complexAbsOn(f, MeasurableSpace.carrier(X))(x) = complexAbs(f(x))
    intros x hx
    exact complexAbsOn.boch_apply with hx
  have mA := Measurable.complex_abs with mF, absolute
  have agree : ∀ x ∈ MeasurableSpace.carrier(X),
      realAbsOn(complexAbsOn(f, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X))(x) =
      complexAbsOn(f, MeasurableSpace.carrier(X))(x)
    intros x hx
    rw realAbsOn.boch_apply with hx
    rw complexAbsOn.boch_apply with hx
    have fx := Measurable.boch_cvalue with mF, hx
    have aR : complexAbs(f(x)) ∈ ℝ by typecheck
    have aN := complexAbs.nonnegative with fx
    exact abs.of_nonnegative at complexAbs(f(x)) with aN
  have e := lintegral.congr at X, μ with agree
  unfold RealIntegrable
  rw e
  exact ⟨measure, mA, aF⟩

theorem complexMeasureIntegral.of_real (X μ f : Set)
  requires values : ∀ x ∈ MeasurableSpace.carrier(X), f(x) ∈ ℝ
  shows complexMeasureIntegral(X, μ, complexOfRealOn(f, MeasurableSpace.carrier(X))) =
    complexOfReal(realMeasureIntegral(X, μ, f))
proof
  have reEq : ∀ x ∈ MeasurableSpace.carrier(X),
      realPartOn(complexOfRealOn(f, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X))(x) = f(x)
    intros x hx
    rw realPartOn.apply with hx
    rw complexOfRealOn.boch_apply with hx
    have fx := values with x, hx
    exact complexOfReal.re at f(x)
  have back : ∀ x ∈ MeasurableSpace.carrier(X),
      f(x) = realPartOn(complexOfRealOn(f, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X))(x)
    intros x hx
    rw reEq with x, hx
  have imZ : ∀ x ∈ MeasurableSpace.carrier(X),
      imagPartOn(complexOfRealOn(f, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X))(x) = realZero
    intros x hx
    rw imagPartOn.apply with hx
    rw complexOfRealOn.boch_apply with hx
    have fx := values with x, hx
    exact complexOfReal.im at f(x)
  by_cases i : RealIntegrable(X, μ, f)
  . have i2 := i
    obtain ⟨measure, mF, aF⟩ := i2
    have rH := RealIntegrable.boch_congr with i, back
    have iH := RealIntegrable.boch_zero with measure, imZ
    have vH : ∀ x ∈ MeasurableSpace.carrier(X),
        complexOfRealOn(f, MeasurableSpace.carrier(X))(x) ∈ complexCarrier
      intros x hx
      rw complexOfRealOn.boch_apply with hx
      have fx := values with x, hx
      typecheck
    have intH := ComplexIntegrable.boch_of_parts with measure, vH, rH, iH.left
    rw complexMeasureIntegral.boch_parts with intH
    rw realMeasureIntegral.boch_congr at X, μ with reEq
    rw iH.right
    have mR := realMeasureIntegral.member at X, μ, f
    have e := complexOfReal.value at realMeasureIntegral(X, μ, f) with mR
    rw e
  . have nh : ¬ComplexIntegrable(X, μ, complexOfRealOn(f, MeasurableSpace.carrier(X)))
      intro ih
      have p := ComplexIntegrable.boch_parts with ih
      have r := RealIntegrable.boch_congr with p.left, reEq
      exact i with r
    rw complexMeasureIntegral.boch_undef with nh
    rw realMeasureIntegral.boch_undef with i
    rw complexOfReal.zero

-- Mathlib's integral_conj.
theorem complexMeasureIntegral.conj (X μ f : Set)
  requires values : ∀ x ∈ MeasurableSpace.carrier(X), f(x) ∈ complexCarrier
  shows complexMeasureIntegral(X, μ, complexConjOn(f, MeasurableSpace.carrier(X))) =
    complexConj(complexMeasureIntegral(X, μ, f))
proof
  have conjugate : ∀ x ∈ MeasurableSpace.carrier(X),
      complexConjOn(f, MeasurableSpace.carrier(X))(x) = complexConj(f(x))
    intros x hx
    exact complexConjOn.boch_apply with hx
  by_cases i : ComplexIntegrable(X, μ, f)
  . have r := ComplexIntegrable.boch_conj with i, conjugate
    exact r.right
  . have nh : ¬ComplexIntegrable(X, μ, complexConjOn(f, MeasurableSpace.carrier(X)))
      intro ih
      have back : ∀ x ∈ MeasurableSpace.carrier(X),
          f(x) = complexConj(complexConjOn(f, MeasurableSpace.carrier(X))(x))
        intros x hx
        rw conjugate with x, hx
        rw complexConj.involutive with (values with x, hx)
      have r := ComplexIntegrable.boch_conj with ih, back
      exact i with r.left
    rw complexMeasureIntegral.boch_undef with i
    rw complexMeasureIntegral.boch_undef with nh
    rw complexConj.zero

-- Mathlib's integral_add, integral_sub, integral_neg.
theorem complexMeasureIntegral.add (X μ f g : Set)
  requires integrableF : ComplexIntegrable(X, μ, f)
  requires integrableG : ComplexIntegrable(X, μ, g)
  shows complexMeasureIntegral(X, μ, complexAddOn(f, g, MeasurableSpace.carrier(X))) =
    ℂ[complexMeasureIntegral(X, μ, f) + complexMeasureIntegral(X, μ, g)]
proof
  have sum : ∀ x ∈ MeasurableSpace.carrier(X),
      complexAddOn(f, g, MeasurableSpace.carrier(X))(x) = ℂ[f(x) + g(x)]
    intros x hx
    exact complexAddOn.boch_apply with hx
  have r := ComplexIntegrable.boch_add with integrableF, integrableG, sum
  exact r.right

theorem complexMeasureIntegral.sub (X μ f g : Set)
  requires integrableF : ComplexIntegrable(X, μ, f)
  requires integrableG : ComplexIntegrable(X, μ, g)
  shows complexMeasureIntegral(X, μ, complexSubOn(f, g, MeasurableSpace.carrier(X))) =
    ℂ[complexMeasureIntegral(X, μ, f) - complexMeasureIntegral(X, μ, g)]
proof
  have i2 := integrableG
  obtain ⟨measure, mG, aG⟩ := i2
  have vG : ∀ x ∈ MeasurableSpace.carrier(X), g(x) ∈ complexCarrier
    intros x hx
    exact Measurable.boch_cvalue with mG, hx
  have m1 : ℂ[-1] ∈ complexCarrier by typecheck
  have prod : ∀ x ∈ MeasurableSpace.carrier(X),
      complexConstMulOn(ℂ[-1], g, MeasurableSpace.carrier(X))(x) = ℂ[ℂ[-1] * g(x)]
    intros x hx
    exact complexConstMulOn.boch_apply with hx
  have rn := ComplexIntegrable.boch_const_mul with integrableG, m1, prod
  obtain ⟨iN, eN⟩ := rn
  have sum : ∀ x ∈ MeasurableSpace.carrier(X), complexSubOn(f, g, MeasurableSpace.carrier(X))(x) =
      ℂ[f(x) + complexConstMulOn(ℂ[-1], g, MeasurableSpace.carrier(X))(x)]
    intros x hx
    rw complexSubOn.boch_apply with hx
    rw prod with x, hx
    have gx := vG with x, hx
    have fM := integrableF
    obtain ⟨m4, mF, aF⟩ := fM
    have fx := Measurable.boch_cvalue with mF, hx
    ring
  have r := ComplexIntegrable.boch_add with integrableF, iN, sum
  rw r.right
  rw eN
  have FM := complexMeasureIntegral.member at X, μ, f
  have GM := complexMeasureIntegral.member at X, μ, g
  ring

-- Mathlib's integral_const_mul, integral_mul_const, integral_div,
-- integral_smul: no integrability needed.
theorem complexMeasureIntegral.const_mul (X μ c f : Set)
  requires member : c ∈ complexCarrier
  requires values : ∀ x ∈ MeasurableSpace.carrier(X), f(x) ∈ complexCarrier
  shows complexMeasureIntegral(X, μ, complexConstMulOn(c, f, MeasurableSpace.carrier(X))) =
    ℂ[c * complexMeasureIntegral(X, μ, f)]
proof
  have product : ∀ x ∈ MeasurableSpace.carrier(X),
      complexConstMulOn(c, f, MeasurableSpace.carrier(X))(x) = ℂ[c * f(x)]
    intros x hx
    exact complexConstMulOn.boch_apply with hx
  by_cases i : ComplexIntegrable(X, μ, f)
  . have r := ComplexIntegrable.boch_const_mul with i, member, product
    exact r.right
  . rw complexMeasureIntegral.boch_undef with i
    by_cases cz : c = complexZero
    . have zero : ∀ x ∈ MeasurableSpace.carrier(X),
          complexConstMulOn(c, f, MeasurableSpace.carrier(X))(x) = complexZero
        intros x hx
        rw product with x, hx
        rw cz
        have fx := values with x, hx
        ring
      rw complexMeasureIntegral.boch_zero with zero
      rw cz
      ring
    . have nh : ¬ComplexIntegrable(X, μ, complexConstMulOn(c, f, MeasurableSpace.carrier(X)))
        intro ih
        have ciM := complexInv.member with member
        have cancel := complexInv.mul_cancel with member, cz
        have back : ∀ x ∈ MeasurableSpace.carrier(X),
            f(x) = ℂ[complexInv(c) * complexConstMulOn(c, f, MeasurableSpace.carrier(X))(x)]
          intros x hx
          rw product with x, hx
          have fx := values with x, hx
          have e : ℂ[complexInv(c) * ℂ[c * f(x)]] = ℂ[ℂ[c * complexInv(c)] * f(x)] by ring
          rw e
          rw cancel
          ring
        have r := ComplexIntegrable.boch_const_mul with ih, ciM, back
        exact i with r.left
      rw complexMeasureIntegral.boch_undef with nh
      ring

theorem complexMeasureIntegral.mul_const (X μ c f : Set)
  requires member : c ∈ complexCarrier
  requires values : ∀ x ∈ MeasurableSpace.carrier(X), f(x) ∈ complexCarrier
  shows complexMeasureIntegral(X, μ, complexMulConstOn(f, c, MeasurableSpace.carrier(X))) =
    ℂ[complexMeasureIntegral(X, μ, f) * c]
proof
  have agree : ∀ x ∈ MeasurableSpace.carrier(X), complexMulConstOn(f, c, MeasurableSpace.carrier(X))(x) =
      complexConstMulOn(c, f, MeasurableSpace.carrier(X))(x)
    intros x hx
    rw complexMulConstOn.boch_apply with hx
    rw complexConstMulOn.boch_apply with hx
    have fx := values with x, hx
    ring
  rw complexMeasureIntegral.boch_congr at X, μ with agree
  rw complexMeasureIntegral.const_mul with member, values
  have IM := complexMeasureIntegral.member at X, μ, f
  ring

theorem complexMeasureIntegral.div_const (X μ c f : Set)
  requires member : c ∈ complexCarrier
  requires values : ∀ x ∈ MeasurableSpace.carrier(X), f(x) ∈ complexCarrier
  shows complexMeasureIntegral(X, μ, complexDivConstOn(f, c, MeasurableSpace.carrier(X))) =
    complexDiv(complexMeasureIntegral(X, μ, f), c)
proof
  have ciM := complexInv.member with member
  have agree : ∀ x ∈ MeasurableSpace.carrier(X), complexDivConstOn(f, c, MeasurableSpace.carrier(X))(x) =
      complexConstMulOn(complexInv(c), f, MeasurableSpace.carrier(X))(x)
    intros x hx
    rw complexDivConstOn.boch_apply with hx
    rw complexConstMulOn.boch_apply with hx
    have fx := values with x, hx
    unfold complexDiv
    ring
  rw complexMeasureIntegral.boch_congr at X, μ with agree
  rw complexMeasureIntegral.const_mul with ciM, values
  have IM := complexMeasureIntegral.member at X, μ, f
  unfold complexDiv
  ring

theorem complexMeasureIntegral.neg (X μ f : Set)
  requires values : ∀ x ∈ MeasurableSpace.carrier(X), f(x) ∈ complexCarrier
  shows complexMeasureIntegral(X, μ, complexNegOn(f, MeasurableSpace.carrier(X))) =
    ℂ[-complexMeasureIntegral(X, μ, f)]
proof
  have m1 : ℂ[-1] ∈ complexCarrier by typecheck
  have agree : ∀ x ∈ MeasurableSpace.carrier(X), complexNegOn(f, MeasurableSpace.carrier(X))(x) =
      complexConstMulOn(ℂ[-1], f, MeasurableSpace.carrier(X))(x)
    intros x hx
    rw complexNegOn.boch_apply with hx
    rw complexConstMulOn.boch_apply with hx
    have fx := values with x, hx
    ring
  rw complexMeasureIntegral.boch_congr at X, μ with agree
  rw complexMeasureIntegral.const_mul with m1, values
  have IM := complexMeasureIntegral.member at X, μ, f
  ring

-- Mathlib's integral_finsetSum.
theorem complexMeasureIntegral.finite_sum (X μ u F : Set)
  requires finite : Finite(F)
  requires integrable : ∀ i ∈ F, ComplexIntegrable(X, μ, u(i))
  shows complexMeasureIntegral(X, μ, complexFiniteSumOn(u, F, MeasurableSpace.carrier(X))) =
    groupFiniteSum(complexAdditiveGroup, F, complexIntegralFamily(X, μ, u, F))
proof
  sorry

-- Mathlib's integral_zero and integral_const.
theorem complexMeasureIntegral.zero (X μ : Set)
  shows complexMeasureIntegral(X, μ, constantOn(MeasurableSpace.carrier(X), complexZero)) =
    complexZero
proof
  have zero : ∀ x ∈ MeasurableSpace.carrier(X),
      constantOn(MeasurableSpace.carrier(X), complexZero)(x) = complexZero
    intros x hx
    exact constantOn.apply with hx
  exact complexMeasureIntegral.boch_zero with zero

theorem complexMeasureIntegral.const (X μ c : Set)
  requires finite : FiniteMeasure(X, μ)
  requires member : c ∈ complexCarrier
  shows complexMeasureIntegral(X, μ, constantOn(MeasurableSpace.carrier(X), c)) =
    ℂ[complexOfReal(measureReal(μ, MeasurableSpace.carrier(X))) * c]
proof
  have fin2 := finite
  obtain ⟨measure, fin⟩ := fin2
  have ov : ∀ x ∈ MeasurableSpace.carrier(X), constantOn(MeasurableSpace.carrier(X), realOne)(x) ∈ ℝ
    intros x hx
    rw constantOn.apply with hx
    typecheck
  have agree : ∀ x ∈ MeasurableSpace.carrier(X), constantOn(MeasurableSpace.carrier(X), c)(x) =
      complexConstMulOn(c, complexOfRealOn(constantOn(MeasurableSpace.carrier(X), realOne),
        MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X))(x)
    intros x hx
    rw complexConstMulOn.boch_apply with hx
    rw complexOfRealOn.boch_apply with hx
    rw constantOn.apply at MeasurableSpace.carrier(X), c, x with hx
    rw constantOn.apply at MeasurableSpace.carrier(X), realOne, x with hx
    rw complexOfReal.one
    ring
  have vals : ∀ x ∈ MeasurableSpace.carrier(X), complexOfRealOn(constantOn(MeasurableSpace.carrier(X),
      realOne), MeasurableSpace.carrier(X))(x) ∈ complexCarrier
    intros x hx
    rw complexOfRealOn.boch_apply with hx
    rw constantOn.apply with hx
    typecheck
  rw complexMeasureIntegral.boch_congr at X, μ with agree
  rw complexMeasureIntegral.const_mul with member, vals
  rw complexMeasureIntegral.of_real with ov
  rw realMeasureIntegral.const with finite
  have space := Measure.space with measure
  have whole := MeasurableSet.univ with space
  have mM := Measure.member with measure, whole
  have mR : measureReal(μ, MeasurableSpace.carrier(X)) ∈ ℝ
    unfold measureReal
    exact ennToReal.boch_member with mM
  have e : R[measureReal(μ, MeasurableSpace.carrier(X)) * realOne] = measureReal(μ, MeasurableSpace.carrier(X)) by ring
  rw e
  have oM : complexOfReal(measureReal(μ, MeasurableSpace.carrier(X))) ∈ complexCarrier by typecheck
  ring

-- Mathlib's integral_congr_ae.
theorem complexMeasureIntegral.congr_ae (X μ f g : Set)
  requires measure : Measure(X, μ)
  requires equal : AEEqual(X, μ, f, g)
  shows complexMeasureIntegral(X, μ, f) = complexMeasureIntegral(X, μ, g)
proof
  sorry

theorem complexMeasureIntegral.congr (X μ f g : Set)
  requires agree : ∀ x ∈ MeasurableSpace.carrier(X), f(x) = g(x)
  shows complexMeasureIntegral(X, μ, f) = complexMeasureIntegral(X, μ, g)
proof
  exact complexMeasureIntegral.boch_congr with agree

-- Mathlib's norm_integral_le_integral_norm and
-- enorm_integral_le_lintegral_enorm.
theorem complexMeasureIntegral.abs_le (X μ f : Set)
  requires measure : Measure(X, μ)
  requires values : ∀ x ∈ MeasurableSpace.carrier(X), f(x) ∈ complexCarrier
  shows complexAbs(complexMeasureIntegral(X, μ, f)) ≤
    realMeasureIntegral(X, μ, complexAbsOn(f, MeasurableSpace.carrier(X)))
proof
  sorry

theorem complexMeasureIntegral.abs_le_lintegral (X μ f : Set)
  requires measure : Measure(X, μ)
  requires values : ∀ x ∈ MeasurableSpace.carrier(X), f(x) ∈ complexCarrier
  shows EnnLe(complexAbs(complexMeasureIntegral(X, μ, f)),
    lintegral(X, μ, complexAbsOn(f, MeasurableSpace.carrier(X))))
proof
  sorry

-- Mathlib's ofReal_integral_norm_eq_lintegral_enorm.
theorem complexMeasureIntegral.norm_eq_lintegral (X μ f : Set)
  requires integrable : ComplexIntegrable(X, μ, f)
  shows realMeasureIntegral(X, μ, complexAbsOn(f, MeasurableSpace.carrier(X))) =
    ennToReal(lintegral(X, μ, complexAbsOn(f, MeasurableSpace.carrier(X))))
proof
  have i2 := integrable
  obtain ⟨measure, mF, aF⟩ := i2
  have r := ComplexIntegrable.boch_abs_real with integrable
  obtain ⟨m3, mA, aA⟩ := r
  have nonneg : ∀ x ∈ MeasurableSpace.carrier(X), realZero ≤ complexAbsOn(f, MeasurableSpace.carrier(X))(x)
    intros x hx
    rw complexAbsOn.boch_apply with hx
    have fx := Measurable.boch_cvalue with mF, hx
    exact complexAbs.nonnegative with fx
  exact realMeasureIntegral.eq_lintegral with measure, mA, nonneg

-- Mathlib's norm_integral_le_of_norm_le and
-- norm_integral_le_of_norm_le_const.
theorem complexMeasureIntegral.abs_le_of_bound (X μ f g : Set)
  requires integrable : RealIntegrable(X, μ, g)
  requires bound : AlmostEverywhere(X, μ, complexBoundSet(f, g, MeasurableSpace.carrier(X)))
  shows complexAbs(complexMeasureIntegral(X, μ, f)) ≤ realMeasureIntegral(X, μ, g)
proof
  sorry

theorem complexMeasureIntegral.abs_le_of_const (X μ f : Set, C : Real)
  requires finite : FiniteMeasure(X, μ)
  requires bound : AlmostEverywhere(X, μ,
    complexBoundSet(f, constantOn(MeasurableSpace.carrier(X), C), MeasurableSpace.carrier(X)))
  shows complexAbs(complexMeasureIntegral(X, μ, f)) ≤
    R[C * measureReal(μ, MeasurableSpace.carrier(X))]
proof
  sorry

-- Mathlib's exists_ne_zero_of_integral_ne_zero and
-- Integrable.of_integral_ne_zero.
theorem complexMeasureIntegral.ne_zero (X μ f : Set)
  requires nonzero : complexMeasureIntegral(X, μ, f) ≠ complexZero
  shows ComplexIntegrable(X, μ, f) ∧
    (∃ x ∈ MeasurableSpace.carrier(X), f(x) ≠ complexZero)
proof
  have i : ComplexIntegrable(X, μ, f)
    by_contra ni
    exact nonzero with (complexMeasureIntegral.boch_undef with ni)
  refine ⟨i, ?_⟩
  by_contra none
  have zero : ∀ x ∈ MeasurableSpace.carrier(X), f(x) = complexZero
    intros x hx
    by_contra ne
    exact none with ⟨x, hx, ne⟩
  exact nonzero with (complexMeasureIntegral.boch_zero with zero)

-- Section: Integrals over sets
theorem complexSetIntegral.whole (X μ f : Set)
  requires measure : Measure(X, μ)
  shows complexSetIntegral(X, μ, f, MeasurableSpace.carrier(X)) =
    complexMeasureIntegral(X, μ, f)
proof
  sorry

-- Mathlib's integral_indicator.
theorem complexMeasureIntegral.indicator (X μ f A : Set)
  requires measure : Measure(X, μ)
  requires set : MeasurableSet(X, A)
  shows complexMeasureIntegral(X, μ, complexIndicatorOn(MeasurableSpace.carrier(X), A, f)) =
    complexSetIntegral(X, μ, f, A)
proof
  sorry

-- Mathlib's setIntegral_congr_fun.
theorem complexSetIntegral.congr_fun (X μ f g A : Set)
  requires measure : Measure(X, μ)
  requires set : MeasurableSet(X, A)
  requires agree : ∀ x ∈ A, f(x) = g(x)
  shows complexSetIntegral(X, μ, f, A) = complexSetIntegral(X, μ, g, A)
proof
  sorry

-- Mathlib's integral_union, setIntegral_compl and integral_add_compl.
theorem complexSetIntegral.union (X μ f A B : Set)
  requires setA : MeasurableSet(X, A)
  requires setB : MeasurableSet(X, B)
  requires disjoint : Disjoint(A, B)
  requires integrableA : ComplexIntegrableOn(X, μ, f, A)
  requires integrableB : ComplexIntegrableOn(X, μ, f, B)
  shows complexSetIntegral(X, μ, f, A ∪ B) =
    ℂ[complexSetIntegral(X, μ, f, A) + complexSetIntegral(X, μ, f, B)]
proof
  sorry

theorem complexSetIntegral.add_compl (X μ f A : Set)
  requires set : MeasurableSet(X, A)
  requires integrable : ComplexIntegrable(X, μ, f)
  shows ℂ[complexSetIntegral(X, μ, f, A) +
      complexSetIntegral(X, μ, f, MeasurableSpace.carrier(X) ∖ A)] =
    complexMeasureIntegral(X, μ, f)
proof
  sorry

-- Mathlib's setIntegral_eq_integral_of_forall_compl_eq_zero and
-- setIntegral_eq_zero_of_forall_eq_zero.
theorem complexSetIntegral.eq_of_vanishing (X μ f A : Set)
  requires measure : Measure(X, μ)
  requires set : MeasurableSet(X, A)
  requires vanishes : ∀ x ∈ MeasurableSpace.carrier(X) ∖ A, f(x) = complexZero
  shows complexSetIntegral(X, μ, f, A) = complexMeasureIntegral(X, μ, f)
proof
  sorry

theorem complexSetIntegral.eq_zero (X μ f A : Set)
  requires measure : Measure(X, μ)
  requires set : MeasurableSet(X, A)
  requires vanishes : ∀ x ∈ A, f(x) = complexZero
  shows complexSetIntegral(X, μ, f, A) = complexZero
proof
  sorry

-- Mathlib's hasSum_integral_iUnion: over a disjoint sequence of sets.
theorem complexSetIntegral.sequence_union (X μ f S : Set)
  requires sets : ∀ n ∈ ℕ, MeasurableSet(X, S(n))
  requires disjoint : PairwiseDisjointSequence(S)
  requires integrable : ComplexIntegrableOn(X, μ, f, sequenceUnion(S))
  shows ComplexHasSum(complexSetIntegralSequence(X, μ, f, S), ℕ,
    complexSetIntegral(X, μ, f, sequenceUnion(S)))
proof
  sorry

-- Section: Change of measure
-- Mathlib's integral_map: for f measurable and g strongly measurable.
theorem complexMeasureIntegral.map (g f X μ Y : Set)
  requires measure : Measure(X, μ)
  requires measurableF : Measurable(f, X, Y)
  requires measurableG : Measurable(g, Y, complexMeasurableSpace)
  shows complexMeasureIntegral(Y, mapMeasure(f, X, μ, Y), g) =
    complexMeasureIntegral(X, μ, composeOn(g, f, MeasurableSpace.carrier(X)))
proof
  sorry

-- Mathlib's MeasurePreserving.integral_comp' and integral_map_equiv:
-- along a measure-preserving embedding no measurability of g is needed.
theorem MeasurePreserving.integral_comp (g f X μ Y ν : Set)
  requires preserving : MeasurePreserving(f, X, μ, Y, ν)
  requires embedding : MeasurableEmbedding(f, X, Y)
  shows complexMeasureIntegral(X, μ, composeOn(g, f, MeasurableSpace.carrier(X))) =
    complexMeasureIntegral(Y, ν, g)
proof
  sorry

theorem MeasurePreserving.integrable_comp (g f X μ Y ν : Set)
  requires preserving : MeasurePreserving(f, X, μ, Y, ν)
  requires integrable : ComplexIntegrable(Y, ν, g)
  shows ComplexIntegrable(X, μ, composeOn(g, f, MeasurableSpace.carrier(X)))
proof
  sorry

-- Mathlib's integral_smul_measure.
theorem complexMeasureIntegral.smul_measure (X μ f : Set, c : Real)
  requires measure : Measure(X, μ)
  requires nonneg : realZero ≤ c
  shows complexMeasureIntegral(X, smulMeasure(c, X, μ), f) =
    ℂ[complexOfReal(c) * complexMeasureIntegral(X, μ, f)]
proof
  sorry

-- Mathlib's integral_dirac for a measurable map.
theorem complexMeasureIntegral.dirac (X a f : Set)
  requires space : MeasurableSpace(X)
  requires member : a ∈ MeasurableSpace.carrier(X)
  requires measurable : Measurable(f, X, complexMeasurableSpace)
  shows complexMeasureIntegral(X, diracMeasure(X, a), f) = f(a)
proof
  sorry

-- Mathlib's integral_count / integral_fintype: against the counting
-- measure of a finite discrete space the integral is the finite sum.
theorem complexMeasureIntegral.count_finite (X f : Set)
  requires space : MeasurableSpace(X)
  requires discrete : MeasurableSpace.sets(X) = 𝒫(MeasurableSpace.carrier(X))
  requires finite : Finite(MeasurableSpace.carrier(X))
  requires values : ∀ x ∈ MeasurableSpace.carrier(X), f(x) ∈ complexCarrier
  shows complexMeasureIntegral(X, countMeasure(X), f) =
    groupFiniteSum(complexAdditiveGroup, MeasurableSpace.carrier(X), f)
proof
  sorry

-- Mathlib's integrable_count_iff: against the counting measure on a
-- discrete space integrable means absolutely summable, and the integral
-- is the sum.
theorem ComplexIntegrable.count_iff (X f : Set)
  requires space : MeasurableSpace(X)
  requires discrete : MeasurableSpace.sets(X) = 𝒫(MeasurableSpace.carrier(X))
  requires values : ∀ x ∈ MeasurableSpace.carrier(X), f(x) ∈ complexCarrier
  shows ComplexIntegrable(X, countMeasure(X), f) ↔
    RealSummable(complexAbsOn(f, MeasurableSpace.carrier(X)), MeasurableSpace.carrier(X))
proof
  sorry

theorem complexMeasureIntegral.count (X f : Set)
  requires space : MeasurableSpace(X)
  requires discrete : MeasurableSpace.sets(X) = 𝒫(MeasurableSpace.carrier(X))
  requires integrable : ComplexIntegrable(X, countMeasure(X), f)
  shows ComplexHasSum(f, MeasurableSpace.carrier(X),
    complexMeasureIntegral(X, countMeasure(X), f))
proof
  sorry

-- Section: Integrability
theorem ComplexIntegrable.measure (X μ f : Set)
  requires integrable : ComplexIntegrable(X, μ, f)
  shows Measure(X, μ)
proof
  sorry

-- Mathlib's Integrable.mono': a measurable map dominated almost everywhere
-- by an integrable real map is integrable.
theorem ComplexIntegrable.of_bound (X μ f g : Set)
  requires measurable : Measurable(f, X, complexMeasurableSpace)
  requires integrable : RealIntegrable(X, μ, g)
  requires bound : AlmostEverywhere(X, μ, complexBoundSet(f, g, MeasurableSpace.carrier(X)))
  shows ComplexIntegrable(X, μ, f)
proof
  sorry

-- Mathlib's Integrable.add, Integrable.const_mul, integrable_const_mul_iff,
-- integrable_mul_const_iff, integrable_finsetSum.
theorem ComplexIntegrable.add (X μ f g : Set)
  requires integrableF : ComplexIntegrable(X, μ, f)
  requires integrableG : ComplexIntegrable(X, μ, g)
  shows ComplexIntegrable(X, μ, complexAddOn(f, g, MeasurableSpace.carrier(X)))
proof
  sorry

theorem ComplexIntegrable.const_mul_iff (X μ c f : Set)
  requires member : c ∈ complexCarrier
  requires nonzero : c ≠ complexZero
  requires values : ∀ x ∈ MeasurableSpace.carrier(X), f(x) ∈ complexCarrier
  shows ComplexIntegrable(X, μ, complexConstMulOn(c, f, MeasurableSpace.carrier(X))) ↔
    ComplexIntegrable(X, μ, f)
proof
  sorry

theorem ComplexIntegrable.const_mul (X μ c f : Set)
  requires member : c ∈ complexCarrier
  requires integrable : ComplexIntegrable(X, μ, f)
  shows ComplexIntegrable(X, μ, complexConstMulOn(c, f, MeasurableSpace.carrier(X))) ∧
    ComplexIntegrable(X, μ, complexMulConstOn(f, c, MeasurableSpace.carrier(X)))
proof
  sorry

theorem ComplexIntegrable.finite_sum (X μ u F : Set)
  requires finite : Finite(F)
  requires integrable : ∀ i ∈ F, ComplexIntegrable(X, μ, u(i))
  shows ComplexIntegrable(X, μ, complexFiniteSumOn(u, F, MeasurableSpace.carrier(X)))
proof
  sorry

-- Mathlib's Integrable.bdd_mul and Integrable.mul_of_top_left: an
-- integrable map times a bounded measurable one.
theorem ComplexIntegrable.bounded_mul (X μ f g : Set, C : Real)
  requires integrable : ComplexIntegrable(X, μ, f)
  requires measurable : Measurable(g, X, complexMeasurableSpace)
  requires bound : ∀ x ∈ MeasurableSpace.carrier(X), complexAbs(g(x)) ≤ C
  shows ComplexIntegrable(X, μ, complexMulOn(g, f, MeasurableSpace.carrier(X)))
proof
  sorry

-- Mathlib's integrable_const on a finite measure, and a bounded
-- measurable map on a finite measure.
theorem ComplexIntegrable.bounded_of_finite (X μ f : Set, C : Real)
  requires finite : FiniteMeasure(X, μ)
  requires measurable : Measurable(f, X, complexMeasurableSpace)
  requires bound : ∀ x ∈ MeasurableSpace.carrier(X), complexAbs(f(x)) ≤ C
  shows ComplexIntegrable(X, μ, f)
proof
  sorry

-- Mathlib's integrable_congr, Integrable.norm, Integrable.re/im, conj.
theorem ComplexIntegrable.congr_ae (X μ f g : Set)
  requires integrable : ComplexIntegrable(X, μ, f)
  requires measurable : Measurable(g, X, complexMeasurableSpace)
  requires equal : AEEqual(X, μ, f, g)
  shows ComplexIntegrable(X, μ, g)
proof
  sorry

theorem ComplexIntegrable.parts (X μ f : Set)
  requires integrable : ComplexIntegrable(X, μ, f)
  shows RealIntegrable(X, μ, realPartOn(f, MeasurableSpace.carrier(X))) ∧
    RealIntegrable(X, μ, imagPartOn(f, MeasurableSpace.carrier(X))) ∧
    RealIntegrable(X, μ, complexAbsOn(f, MeasurableSpace.carrier(X))) ∧
    ComplexIntegrable(X, μ, complexConjOn(f, MeasurableSpace.carrier(X)))
proof
  sorry

theorem ComplexIntegrable.of_parts (X μ f : Set)
  requires values : ∀ x ∈ MeasurableSpace.carrier(X), f(x) ∈ complexCarrier
  requires re : RealIntegrable(X, μ, realPartOn(f, MeasurableSpace.carrier(X)))
  requires im : RealIntegrable(X, μ, imagPartOn(f, MeasurableSpace.carrier(X)))
  shows ComplexIntegrable(X, μ, f)
proof
  sorry

theorem ComplexIntegrable.of_real (X μ f : Set)
  requires integrable : RealIntegrable(X, μ, f)
  shows ComplexIntegrable(X, μ, complexOfRealOn(f, MeasurableSpace.carrier(X)))
proof
  sorry

-- Mathlib's integrable_indicator_iff and IntegrableOn.mono_set.
theorem ComplexIntegrable.indicator_iff (X μ f A : Set)
  requires set : MeasurableSet(X, A)
  requires measure : Measure(X, μ)
  shows ComplexIntegrable(X, μ, complexIndicatorOn(MeasurableSpace.carrier(X), A, f)) ↔
    ComplexIntegrableOn(X, μ, f, A)
proof
  sorry

theorem ComplexIntegrableOn.mono_set (X μ f A B : Set)
  requires integrable : ComplexIntegrableOn(X, μ, f, B)
  requires setA : MeasurableSet(X, A)
  requires inside : A ⊆ B
  shows ComplexIntegrableOn(X, μ, f, A)
proof
  sorry

theorem ComplexIntegrable.integrable_on (X μ f A : Set)
  requires integrable : ComplexIntegrable(X, μ, f)
  requires set : MeasurableSet(X, A)
  shows ComplexIntegrableOn(X, μ, f, A)
proof
  sorry

-- Continuous maps on compact sets, and continuous maps with compact
-- support, are integrable for a measure finite on compacts (Mathlib's
-- ContinuousOn.integrableOn_compact and
-- Continuous.integrable_of_hasCompactSupport).
theorem ComplexIntegrableOn.of_continuous_compact (T μ f K : Set)
  requires measure : Measure(borelSpace(T), μ)
  requires finite : FiniteOnCompacts(T, μ)
  requires hausdorff : Hausdorff(T)
  requires compact : Compact(T, K)
  requires inside : K ⊆ TopologicalSpace.carrier(T)
  requires continuous : f : T ⇒ complexSpace
  shows ComplexIntegrableOn(borelSpace(T), μ, f, K)
proof
  sorry

theorem ComplexIntegrable.of_compact_support (T μ f K : Set)
  requires measure : Measure(borelSpace(T), μ)
  requires finite : FiniteOnCompacts(T, μ)
  requires hausdorff : Hausdorff(T)
  requires compact : Compact(T, K)
  requires inside : K ⊆ TopologicalSpace.carrier(T)
  requires continuous : f : T ⇒ complexSpace
  requires support : ∀ x ∈ TopologicalSpace.carrier(T) ∖ K, f(x) = complexZero
  shows ComplexIntegrable(borelSpace(T), μ, f)
proof
  sorry

-- Mathlib's Continuous.integral_pos_of_hasCompactSupport_nonneg_nonzero:
-- a nonnegative continuous map, positive somewhere, has positive integral
-- against a measure positive on open sets.
theorem realMeasureIntegral.pos_of_continuous (T μ f x : Set)
  requires measure : Measure(borelSpace(T), μ)
  requires positive : OpenPositive(T, μ)
  requires integrable : RealIntegrable(borelSpace(T), μ, f)
  requires continuous : f : T ⇒ realLine
  requires nonneg : ∀ y ∈ TopologicalSpace.carrier(T), realZero ≤ f(y)
  requires member : x ∈ TopologicalSpace.carrier(T)
  requires somewhere : realZero < f(x)
  shows realZero < realMeasureIntegral(borelSpace(T), μ, f)
proof
  sorry

-- Section: Convergence theorems
-- The dominated convergence theorem (Mathlib's
-- tendsto_integral_of_dominated_convergence).
theorem complexMeasureIntegral.dominated_convergence (X μ u f g : Set)
  requires measurable : ∀ n ∈ ℕ, Measurable(u(n), X, complexMeasurableSpace)
  requires integrable : RealIntegrable(X, μ, g)
  requires bound : ∀ n ∈ ℕ, AlmostEverywhere(X, μ,
    complexBoundSet(u(n), g, MeasurableSpace.carrier(X)))
  requires limit : AlmostEverywhere(X, μ, complexConvergenceSet(u, f, MeasurableSpace.carrier(X)))
  requires values : ∀ x ∈ MeasurableSpace.carrier(X), f(x) ∈ complexCarrier
  shows Tendsto(complexIntegralSequence(X, μ, u), ℕ, natAtTop,
    nhds(complexSpace, complexMeasureIntegral(X, μ, f)))
proof
  sorry

-- Mathlib's hasSum_integral_of_dominated_convergence and
-- integral_tsum_of_summable_integral_norm: a series may be integrated
-- termwise when Σ ∫ |u(n)| converges.
theorem complexMeasureIntegral.tsum (X μ u f : Set)
  requires integrable : ∀ n ∈ ℕ, ComplexIntegrable(X, μ, u(n))
  requires summable : RealSummable(complexNormIntegralSequence(X, μ, u), ℕ)
  requires sum : ∀ x ∈ MeasurableSpace.carrier(X), ComplexHasSum(familyAt(u, ℕ, x), ℕ, f(x))
  shows ComplexIntegrable(X, μ, f) ∧
    ComplexHasSum(complexIntegralSequence(X, μ, u), ℕ, complexMeasureIntegral(X, μ, f))
proof
  sorry

-- Mathlib's continuous_of_dominated and continuousOn_of_dominated: an
-- integral depending on a parameter t in a topological space T is
-- continuous when the integrand is continuous in t for almost every x and
-- is dominated by one integrable map.
theorem complexMeasureIntegral.continuous_of_dominated (X μ T F g G : Set)
  requires space : TopologicalSpace(T)
  requires measurable : ∀ t ∈ TopologicalSpace.carrier(T),
    Measurable(F(t), X, complexMeasurableSpace)
  requires integrable : RealIntegrable(X, μ, g)
  requires bound : ∀ t ∈ TopologicalSpace.carrier(T), AlmostEverywhere(X, μ,
    complexBoundSet(F(t), g, MeasurableSpace.carrier(X)))
  requires continuous : AlmostEverywhere(X, μ,
    parameterContinuitySet(F, T, MeasurableSpace.carrier(X)))
  requires integral : ∀ t ∈ TopologicalSpace.carrier(T), G(t) = complexMeasureIntegral(X, μ, F(t))
  shows G : T ⇒ complexSpace
proof
  sorry

-- Section: Square-integrable maps
-- Mathlib's memLp_two_iff_integrable_sq_norm.
theorem SquareIntegrable.iff_integrable_sq (X μ f : Set)
  requires measure : Measure(X, μ)
  requires measurable : Measurable(f, X, complexMeasurableSpace)
  shows SquareIntegrable(X, μ, f) ↔
    RealIntegrable(X, μ, complexAbsSquareOn(f, MeasurableSpace.carrier(X)))
proof
  sorry

-- The product of two square-integrable maps is integrable, and
-- |⟨f, g⟩|² ≤ ⟨f, f⟩ ⟨g, g⟩ (Hölder at p = q = 2, Mathlib's
-- MemLp.integrable_mul and inner_mul_le_norm_mul_norm on L²).
theorem SquareIntegrable.mul (X μ f g : Set)
  requires first : SquareIntegrable(X, μ, f)
  requires second : SquareIntegrable(X, μ, g)
  shows ComplexIntegrable(X, μ, complexMulOn(complexConjOn(f, MeasurableSpace.carrier(X)),
    g, MeasurableSpace.carrier(X)))
proof
  sorry

theorem l2Inner.cauchy_schwarz (X μ f g : Set)
  requires first : SquareIntegrable(X, μ, f)
  requires second : SquareIntegrable(X, μ, g)
  shows R[complexAbs(l2Inner(X, μ, f, g)) * complexAbs(l2Inner(X, μ, f, g))] ≤
    R[complexRe(l2Inner(X, μ, f, f)) * complexRe(l2Inner(X, μ, g, g))]
proof
  sorry

-- ⟨f, f⟩ is the real number ∫ |f|².
theorem l2Inner.self (X μ f : Set)
  requires square : SquareIntegrable(X, μ, f)
  shows l2Inner(X, μ, f, f) = complexOfReal(ennToReal(lintegral(X, μ,
    complexAbsSquareOn(f, MeasurableSpace.carrier(X)))))
proof
  sorry

theorem SquareIntegrable.add (X μ f g : Set)
  requires first : SquareIntegrable(X, μ, f)
  requires second : SquareIntegrable(X, μ, g)
  shows SquareIntegrable(X, μ, complexAddOn(f, g, MeasurableSpace.carrier(X)))
proof
  sorry

-- On a finite measure, L² ⊆ L¹ and bounded measurable maps are in L²
-- (Mathlib's MemLp.mono_exponent, memLp_top_of_bound).
theorem SquareIntegrable.integrable_of_finite (X μ f : Set)
  requires finite : FiniteMeasure(X, μ)
  requires square : SquareIntegrable(X, μ, f)
  shows ComplexIntegrable(X, μ, f)
proof
  sorry

theorem EssentiallyBounded.square_integrable (X μ f : Set)
  requires finite : FiniteMeasure(X, μ)
  requires bounded : EssentiallyBounded(X, μ, f)
  shows SquareIntegrable(X, μ, f)
proof
  sorry

-- Mathlib's average_eq and average_const.
theorem complexAverage.const (X μ c : Set)
  requires finite : FiniteMeasure(X, μ)
  requires nonzero : μ(MeasurableSpace.carrier(X)) ≠ realZero
  requires member : c ∈ complexCarrier
  shows complexAverage(X, μ, constantOn(MeasurableSpace.carrier(X), c)) = c
proof
  sorry

-- Section: Banach-valued integrals
-- Over ℝ and ℂ as Banach spaces over themselves the integral is the real
-- and the complex integral (identification of the encodings).
theorem banachIntegral.real (X μ f : Set)
  requires measure : Measure(X, μ)
  shows banachIntegral(X, μ, realSelfModule, identity(ℝ), realAbs, f) =
    realMeasureIntegral(X, μ, f)
proof
  sorry

theorem banachIntegral.complex (X μ f : Set)
  requires measure : Measure(X, μ)
  shows banachIntegral(X, μ, complexSelfModule, complexOfReal, complexAbs, f) =
    complexMeasureIntegral(X, μ, f)
proof
  sorry

-- The integral is well defined: an integrable map has exactly one
-- integral.
theorem HasBanachIntegral.exists_unique (X μ V K absK conj ofReal norm f : Set)
  requires scalars : RCLike(K, absK, conj, ofReal)
  requires banach : BanachSpace(V, K, absK, norm)
  requires integrable : BanachIntegrable(X, μ, V, norm, f)
  shows HasBanachIntegral(X, μ, V, ofReal, norm, f, banachIntegral(X, μ, V, ofReal, norm, f)) ∧
    (∀ v, HasBanachIntegral(X, μ, V, ofReal, norm, f, v) → v = banachIntegral(X, μ, V, ofReal, norm, f))
proof
  sorry

-- Mathlib's integral_add and norm_integral_le_integral_norm for
-- Banach-valued maps.
theorem banachIntegral.add (X μ V K absK conj ofReal norm f g h : Set)
  requires scalars : RCLike(K, absK, conj, ofReal)
  requires banach : BanachSpace(V, K, absK, norm)
  requires integrableF : BanachIntegrable(X, μ, V, norm, f)
  requires integrableG : BanachIntegrable(X, μ, V, norm, g)
  requires sum : ∀ x ∈ MeasurableSpace.carrier(X), h(x) = Module.add(V)(f(x), g(x))
  shows banachIntegral(X, μ, V, ofReal, norm, h) =
    Module.add(V)(banachIntegral(X, μ, V, ofReal, norm, f),
      banachIntegral(X, μ, V, ofReal, norm, g))
proof
  sorry

theorem banachIntegral.norm_le (X μ V K absK conj ofReal norm f : Set)
  requires scalars : RCLike(K, absK, conj, ofReal)
  requires banach : BanachSpace(V, K, absK, norm)
  requires integrable : BanachIntegrable(X, μ, V, norm, f)
  shows norm(banachIntegral(X, μ, V, ofReal, norm, f)) ≤
    realMeasureIntegral(X, μ, normOn(norm, f, MeasurableSpace.carrier(X)))
proof
  sorry

-- Mathlib's ContinuousLinearMap.integral_comp_comm and integral_inner:
-- a continuous linear map passes through the integral.
theorem banachIntegral.linear_comp (X μ V W K absK conj ofReal normV normW L f : Set)
  requires scalars : RCLike(K, absK, conj, ofReal)
  requires banachV : BanachSpace(V, K, absK, normV)
  requires banachW : BanachSpace(W, K, absK, normW)
  requires linear : ContinuousLinearMap(L, V, normV, W, normW, K)
  requires integrable : BanachIntegrable(X, μ, V, normV, f)
  shows banachIntegral(X, μ, W, ofReal, normW, linearComposeOn(L, f, MeasurableSpace.carrier(X))) =
    L(banachIntegral(X, μ, V, ofReal, normV, f))
proof
  sorry

-- Mathlib's eval_integral_piLp: in Kⁿ the integral is taken coordinatewise.
theorem banachIntegral.coordinates (X μ K absK conj ofReal f : Set, n : Nat, i : Set)
  requires scalars : RCLike(K, absK, conj, ofReal)
  requires member : i ∈ n
  requires integrable : BanachIntegrable(X, μ, euclideanModule(K, n),
    euclideanNorm(K, absK, n), f)
  shows banachIntegral(X, μ, euclideanModule(K, n), ofReal, euclideanNorm(K, absK, n), f)(i) =
    banachIntegral(X, μ, selfModule(K), ofReal, absK, familyAt(f, MeasurableSpace.carrier(X), i))
proof
  sorry

-- Section: Riemann and improper integrals
-- A Borel measurable complex map Riemann integrable on [A, B] is
-- integrable there, and the integrals agree (Mathlib's
-- intervalIntegral.integral_of_le with layer 1's complexIntegral).
theorem complexIntervalIntegral.eq_riemann (g : Set, A B : Real)
  requires le : A ≤ B
  requires riemann : ComplexRiemannIntegrable(g, A, B)
  requires measurable : Measurable(g, realMeasurableSpace, complexMeasurableSpace)
  shows ComplexIntervalIntegrable(g, A, B) ∧
    complexIntervalIntegral(g, A, B) = complexIntegral(g, A, B)
proof
  sorry

theorem realSetIntegral.eq_riemann (G : Set, A B : Real)
  requires le : A ≤ B
  requires riemann : RiemannIntegrable(G, A, B)
  requires measurable : Measurable(G, realMeasurableSpace, realMeasurableSpace)
  shows RealIntegrableOn(realMeasurableSpace, realVolume, G, realIcc(A, B)) ∧
    realSetIntegral(realMeasurableSpace, realVolume, G, realIcc(A, B)) =
      riemannIntegral(G, A, B)
proof
  sorry

-- Continuous maps on compact intervals are integrable there (Mathlib's
-- Continuous.intervalIntegrable, ContinuousOn.intervalIntegrable).
theorem ComplexIntervalIntegrable.of_continuous (g : Set, A B : Real)
  requires continuous : g : realLine ⇒ complexSpace
  shows ComplexIntervalIntegrable(g, A, B)
proof
  sorry

-- Mathlib's MeasureTheory.integral_Icc_eq_integral_Ioc,
-- integral_Ioc_eq_integral_Ioo: endpoints do not matter.
theorem complexSetIntegral.endpoints (g : Set, A B : Real)
  shows complexSetIntegral(realMeasurableSpace, realVolume, g, realIcc(A, B)) =
      complexSetIntegral(realMeasurableSpace, realVolume, g, realIoc(A, B)) ∧
    complexSetIntegral(realMeasurableSpace, realVolume, g, realIoo(A, B)) =
      complexSetIntegral(realMeasurableSpace, realVolume, g, realIoc(A, B))
proof
  sorry

-- The fundamental theorem of calculus (Mathlib's
-- intervalIntegral.integral_eq_sub_of_hasDerivAt), for real maps.
theorem realSetIntegral.fundamental_theorem (F f : Set, A B : Real)
  requires le : A ≤ B
  requires derivative : ∀ X ∈ realIcc(A, B), HasDerivativeAt(F, f(X), X)
  requires integrable : RealIntegrableOn(realMeasurableSpace, realVolume, f, realIcc(A, B))
  shows realSetIntegral(realMeasurableSpace, realVolume, f, realIoc(A, B)) = R[F(B) - F(A)]
proof
  sorry

-- An integrable map on [A, ∞) has an improper integral there, equal to
-- its integral (Mathlib's intervalIntegral_tendsto_integral_Ioi with
-- layer 1's complexImproperIntegral).
theorem complexSetIntegral.eq_improper (g : Set, A : Real)
  requires integrable : ComplexIntegrableOn(realMeasurableSpace, realVolume, g, realIoi(A))
  requires riemann : ∀ T ∈ ℝ, A ≤ T → ComplexRiemannIntegrable(g, A, T)
  shows HasComplexImproperIntegral(g, A,
      complexSetIntegral(realMeasurableSpace, realVolume, g, realIoi(A))) ∧
    complexImproperIntegral(g, A) =
      complexSetIntegral(realMeasurableSpace, realVolume, g, realIoi(A))
proof
  sorry

-- Conversely, a measurable map whose modulus has an improper integral is
-- integrable on [A, ∞) (Mathlib's integrableOn_Ioi_of_intervalIntegral_norm_bounded).
theorem ComplexIntegrableOn.of_improper_abs (g : Set, A : Real)
  requires measurable : Measurable(g, realMeasurableSpace, complexMeasurableSpace)
  requires values : ComplexValuedOn(g, ℝ)
  requires absolute : ImproperIntegrable(complexAbsOn(g, ℝ), A)
  shows ComplexIntegrableOn(realMeasurableSpace, realVolume, g, realIoi(A))
proof
  sorry

-- Standard integrals over half-lines (Mathlib's integrableOn_Ioi_rpow_of_lt,
-- integral_Ioi_rpow_of_lt, integral_exp_neg_Ioi_zero,
-- integrableOn_exp_mul_complex_Ioi, integral_exp_mul_complex_Ioi).
theorem realSetIntegral.rpow_Ioi (S A : Real)
  requires exponent : S < R[-1]
  requires positive : realZero < A
  shows RealIntegrableOn(realMeasurableSpace, realVolume, rpowFunction(S), realIoi(A)) ∧
    realSetIntegral(realMeasurableSpace, realVolume, rpowFunction(S), realIoi(A)) =
      R[-(realRpow(A, R[S + 1]) / (S + 1))]
proof
  sorry

theorem realSetIntegral.exp_neg_Ioi
  shows realSetIntegral(realMeasurableSpace, realVolume,
    expNegFunction, realIoi(realZero)) = realOne
proof
  sorry

theorem complexSetIntegral.exp_mul_Ioi (a : Set)
  requires member : a ∈ complexCarrier
  requires decay : complexRe(a) < realZero
  shows ComplexIntegrableOn(realMeasurableSpace, realVolume,
      complexExpLinear(a), realIoi(realZero)) ∧
    complexSetIntegral(realMeasurableSpace, realVolume,
      complexExpLinear(a), realIoi(realZero)) =
      ℂ[-complexInv(a)]
proof
  sorry

-- Mathlib's integrable_inv_one_add_sq: x ↦ 1/(1 + x²) is integrable on ℝ.
theorem RealIntegrable.inv_one_add_sq
  shows RealIntegrable(realMeasurableSpace, realVolume,
    inverseOnePlusSquare)
proof
  sorry

end Bochner
