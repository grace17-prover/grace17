-- Characteristic, Frobenius and finite fields: ℤ as a bundled ring and
-- ℤ/nℤ as its quotient (Mathlib's ZMod n), natural numbers in a ring,
-- the characteristic (CharP, ringChar), the binomial law (x + y)^p =
-- x^p + y^p, the Frobenius endomorphism and its iterates, perfect rings,
-- finite fields: their order p^n, x^q = x, cyclic unit groups, the
-- polynomial X^q − X, existence and uniqueness of the field with p^n
-- elements (GaloisField), and their extensions, Galois with cyclic group
-- generated by the Frobenius.
-- Part of the GRH blueprint.
-- Planned home: Algebra/Field/Finite (ZMod: NumberTheory/ZMod).
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Field.Finite
import GRH.Field.Galois
import GRH.Matrix.Groups
import Grace.Cumulus.NumberTheory.IntegerRemainder

-- Section: ℤ and ℤ/nℤ
-- ℤ as a bundled commutative ring (Mathlib's Int with its CommRing).
def integerRing : Set :=
  Ring.mk(ℤ, integerAdd, integerZero, integerNeg, integerMul, integerOne)

-- ZMod n = ℤ ⧸ (n), the classes of integers modulo n, with the cast
-- Int.cast : ℤ → ZMod n the quotient map. For n = 0 the classes are
-- singletons and ZMod 0 is isomorphic (not equal) to ℤ, where Mathlib
-- has ZMod 0 = ℤ; the proof uses ZMod n for n ≥ 1 (NeZero n).
def zmodIdeal (n : Nat) : Set := ringMultiples(integerRing, integerOfNat(n))

def zmod (n : Nat) : Set := quotientRing(integerRing, zmodIdeal(n))

def zmodCast (n : Nat) : Set := quotientMk(integerRing, zmodIdeal(n))

-- The natural number n in a ring R, n · 1 (Nat.cast).
def natCast (R : Set, n : Nat) : Set := ringNat(Ring.add(R), Ring.zero(R), Ring.one(R), n)

-- Helpers: ℤ as a bundled ring.
theorem tkJ.integerRing.carrier
  shows Ring.carrier(integerRing) = ℤ
proof
  simp [integerRing, Ring.mk.carrier]

theorem tkJ.integerRing.add
  shows Ring.add(integerRing) = integerAdd
proof
  simp [integerRing, Ring.mk.add]

theorem tkJ.integerRing.zero
  shows Ring.zero(integerRing) = integerZero
proof
  simp [integerRing, Ring.mk.zero]

theorem tkJ.integerRing.neg
  shows Ring.neg(integerRing) = integerNeg
proof
  simp [integerRing, Ring.mk.neg]

theorem tkJ.integerRing.mul
  shows Ring.mul(integerRing) = integerMul
proof
  simp [integerRing, Ring.mk.mul]

theorem tkJ.integerRing.one
  shows Ring.one(integerRing) = integerOne
proof
  simp [integerRing, Ring.mk.one]

theorem tkJ.integerRing.domain
  shows CommRing(integerRing) ∧ IntegralDomain(integerRing)
proof
  have comm : CommRing(integerRing)
    unfold integerRing
    exact CommRing.of_parts with integers.comm_ring
  have nt : Ring.zero(integerRing) ≠ Ring.one(integerRing)
    rw [tkJ.integerRing.zero, tkJ.integerRing.one]
    intro e
    symm at e
    exact integerOne.ne_zero with e
  have nzd : ∀ x y ∈ Ring.carrier(integerRing), call2(Ring.mul(integerRing), x, y) = Ring.zero(integerRing) → x = Ring.zero(integerRing) ∨ y = Ring.zero(integerRing)
    rw [tkJ.integerRing.carrier, tkJ.integerRing.mul, tkJ.integerRing.zero]
    intros x xIn y yIn e
    have xI : Integer(x) by settle with Integer
    have yI : Integer(y) by settle with Integer
    rw (integerMulValue.notation at x, y) at e
    exact integerMulValue.eq_zero at x, y with e
  exact ⟨comm, comm, nt, nzd⟩

theorem tkJ.integerRing.sub_value (a b : Set)
  requires first : a ∈ ℤ
  requires second : b ∈ ℤ
  shows Ring.sub(integerRing, a, b) = integerAddValue(a, integerNegValue(b))
proof
  have both := tkJ.integerRing.domain
  have ringZ := CommRing.to_ring with both.left
  have aI : Integer(a) by settle with Integer
  have bI : Integer(b) by settle with Integer
  have aIn : a ∈ Ring.carrier(integerRing)
    rw tkJ.integerRing.carrier
    exact first
  have bIn : b ∈ Ring.carrier(integerRing)
    rw tkJ.integerRing.carrier
    exact second
  rw (Ring.sub.value at integerRing, a, b with ringZ, aIn, bIn)
  rw [tkJ.integerRing.add, tkJ.integerRing.neg]
  rw (integerNegValue.notation at b)
  exact integerAddValue.notation at a, integerNegValue(b)

theorem tkJ.integerOfNat.ring_nat (a : Nat)
  shows ringNat(integerAdd, integerZero, integerOne, a) = integerOfNat(a)
proof
  induction a
  | zero =>
    rw [ringNat.zero, integerOfNat.zero]
  | succ(k) using ih =>
    rw ringNat.succ
    rw ih
    have shift := add.right_one at k with *
    rw ← shift
    rw (integerOfNat.add_one at k)
    rw ← integerOfNat.one
    exact integerAddValue.notation at integerOfNat(k), integerOfNat(1)

theorem tkJ.integerRing.natCast (a : Nat)
  shows natCast(integerRing, a) = integerOfNat(a)
proof
  have core := tkJ.integerOfNat.ring_nat at a
  unfold natCast
  rw [tkJ.integerRing.add, tkJ.integerRing.zero, tkJ.integerRing.one]
  exact core

theorem tkJ.integerRing.comm
  shows CommRing(integerRing)
proof
  have both := tkJ.integerRing.domain
  exact both.left

-- Helpers: ℤ/nℤ.
theorem tkJ.zmodIdeal.ideal (n : Nat)
  shows Ideal(integerRing, zmodIdeal(n))
proof
  have comm := tkJ.integerRing.comm
  have nIn : integerOfNat(n) ∈ Ring.carrier(integerRing)
    rw tkJ.integerRing.carrier
    typecheck
  unfold zmodIdeal
  exact ringMultiples.ideal at integerRing, integerOfNat(n) with comm, nIn

theorem tkJ.zmodIdeal.mem_iff (n : Nat) (x : Set)
  requires integer : x ∈ ℤ
  shows x ∈ zmodIdeal(n) ↔ IntegerDivides(integerOfNat(n), x)
proof
  have comm := tkJ.integerRing.comm
  have nIn : integerOfNat(n) ∈ Ring.carrier(integerRing)
    rw tkJ.integerRing.carrier
    typecheck
  have xIn : x ∈ Ring.carrier(integerRing)
    rw tkJ.integerRing.carrier
    exact integer
  have m := ringMultiples.mem_iff at integerRing, integerOfNat(n), x with comm, nIn, xIn
  unfold zmodIdeal
  rw m
  constructor
  . intro h
    obtain ⟨_, _, c, cIn, e⟩ := h
    rw tkJ.integerRing.carrier at cIn
    rw tkJ.integerRing.mul at e
    have cI : Integer(c) by settle with Integer
    rw (integerMulValue.notation at integerOfNat(n), c) at e
    symm at e
    unfold IntegerDivides
    witness c
    exact e
  . intro h
    obtain ⟨q, qI, e⟩ := h
    have qIn : q ∈ Ring.carrier(integerRing)
      rw tkJ.integerRing.carrier
      typecheck
    have e2 : x = call2(Ring.mul(integerRing), integerOfNat(n), q)
      rw [tkJ.integerRing.mul, (integerMulValue.notation at integerOfNat(n), q)]
      symm at e
      exact e
    exact ⟨nIn, xIn, q, qIn, e2⟩

theorem tkJ.zmod.comm_ring (n : Nat)
  shows CommRing(zmod(n)) ∧ (zmodCast(n) : integerRing →+* zmod(n)) ∧
    SurjectiveBetween(zmodCast(n), ℤ, Ring.carrier(zmod(n)))
proof
  have comm := tkJ.integerRing.comm
  have ideal := tkJ.zmodIdeal.ideal at n
  have c := quotientRing.comm_ring_of_ideal at integerRing, zmodIdeal(n) with comm, ideal
  have h := quotientMk.hom at integerRing, zmodIdeal(n) with comm, ideal
  have sj := quotientMk.surjective at integerRing, zmodIdeal(n) with comm, ideal
  rw tkJ.integerRing.carrier at sj
  unfold zmod
  unfold zmodCast
  exact ⟨c, h, sj⟩

theorem tkJ.zmodCast.eq_iff (n : Nat) (a b : Set)
  requires first : a ∈ ℤ
  requires second : b ∈ ℤ
  shows zmodCast(n)(a) = zmodCast(n)(b) ↔
    IntegerDivides(integerOfNat(n), integerAddValue(b, integerNegValue(a)))
proof
  have comm := tkJ.integerRing.comm
  have ideal := tkJ.zmodIdeal.ideal at n
  have aIn : a ∈ Ring.carrier(integerRing)
    rw tkJ.integerRing.carrier
    exact first
  have bIn : b ∈ Ring.carrier(integerRing)
    rw tkJ.integerRing.carrier
    exact second
  have e := quotientMk.eq_iff at integerRing, zmodIdeal(n), a, b with comm, ideal, aIn, bIn
  unfold zmodCast
  rw e
  have aI : Integer(a) by settle with Integer
  have bI : Integer(b) by settle with Integer
  have dIn : integerAddValue(a, integerNegValue(b)) ∈ ℤ by typecheck
  rw (tkJ.integerRing.sub_value at a, b with first, second)
  rw (tkJ.zmodIdeal.mem_iff at n, integerAddValue(a, integerNegValue(b)) with dIn)
  have flip : integerAddValue(b, integerNegValue(a)) = integerNegValue(integerAddValue(a, integerNegValue(b))) by ring
  rw flip
  have nr := IntegerDivides.neg_right_iff at integerOfNat(n), integerAddValue(a, integerNegValue(b))
  constructor
  . intro h
    exact nr.backward with h
  . intro h
    exact nr.forward with h

theorem tkJ.zmodCast.eq_zero_iff (n : Nat) (x : Set)
  requires integer : x ∈ ℤ
  shows zmodCast(n)(x) = Ring.zero(zmod(n)) ↔ IntegerDivides(integerOfNat(n), x)
proof
  have comm := tkJ.integerRing.comm
  have ideal := tkJ.zmodIdeal.ideal at n
  have xIn : x ∈ Ring.carrier(integerRing)
    rw tkJ.integerRing.carrier
    exact integer
  have e := quotientMk.eq_zero_iff at integerRing, zmodIdeal(n), x with comm, ideal, xIn
  unfold zmodCast
  unfold zmod
  rw e
  exact tkJ.zmodIdeal.mem_iff at n, x with integer

theorem tkJ.zmodCast.nat_eq_iff (n : Nat) (a b : Nat)
  requires positive : 0 < n
  shows zmodCast(n)(integerOfNat(a)) = zmodCast(n)(integerOfNat(b)) ↔
    integerMod(integerOfNat(a), n) = integerMod(integerOfNat(b), n)
proof
  have aIn : integerOfNat(a) ∈ ℤ by typecheck
  have bIn : integerOfNat(b) ∈ ℤ by typecheck
  rw (tkJ.zmodCast.eq_iff at n, integerOfNat(a), integerOfNat(b) with aIn, bIn)
  rw [(integerMod.ofNat at a, n with positive), (integerMod.ofNat at b, n with positive)]
  have flip : integerAddValue(integerOfNat(b), integerNegValue(integerOfNat(a))) = integerSubValue(integerOfNat(b), integerOfNat(a)) by ring
  rw flip
  have c := IntegerCongruent.ofNat_iff at n, b, a
  constructor
  . intro h
    have hc : IntegerCongruent(integerOfNat(n), integerOfNat(b), integerOfNat(a))
      unfold IntegerCongruent
      exact h
    have m := c.forward with hc
    unfold CongruentMod at m
    symm at m
    exact m
  . intro h
    symm at h
    have m : CongruentMod(b, a, n)
      unfold CongruentMod
      exact h
    have hc := c.backward with m
    unfold IntegerCongruent at hc
    exact hc

theorem tkJ.zmodCast.nat_add (n a b : Nat)
  shows call2(Ring.add(zmod(n)), zmodCast(n)(integerOfNat(a)), zmodCast(n)(integerOfNat(b))) =
    zmodCast(n)(integerOfNat(a + b))
proof
  have comm := tkJ.integerRing.comm
  have basics := tkJ.zmod.comm_ring at n
  obtain ⟨zc, hom, _⟩ := basics
  have aIn : integerOfNat(a) ∈ Ring.carrier(integerRing)
    rw tkJ.integerRing.carrier
    typecheck
  have bIn : integerOfNat(b) ∈ Ring.carrier(integerRing)
    rw tkJ.integerRing.carrier
    typecheck
  have m := RingHom.map_add at zmodCast(n), integerRing, zmod(n), integerOfNat(a), integerOfNat(b) with hom, aIn, bIn
  rw [tkJ.integerRing.add, integerAddValue.notation] at m
  rw ← (integerOfNat.add at a, b) at m
  symm at m
  exact m

theorem tkJ.zmodCast.nat_mul (n a b : Nat)
  shows call2(Ring.mul(zmod(n)), zmodCast(n)(integerOfNat(a)), zmodCast(n)(integerOfNat(b))) =
    zmodCast(n)(integerOfNat(a * b))
proof
  have comm := tkJ.integerRing.comm
  have basics := tkJ.zmod.comm_ring at n
  obtain ⟨zc, hom, _⟩ := basics
  have aIn : integerOfNat(a) ∈ Ring.carrier(integerRing)
    rw tkJ.integerRing.carrier
    typecheck
  have bIn : integerOfNat(b) ∈ Ring.carrier(integerRing)
    rw tkJ.integerRing.carrier
    typecheck
  have m := RingHom.map_mul at zmodCast(n), integerRing, zmod(n), integerOfNat(a), integerOfNat(b) with hom, aIn, bIn
  rw [tkJ.integerRing.mul, integerMulValue.notation] at m
  rw ← (integerOfNat.mul at a, b) at m
  symm at m
  exact m

theorem tkJ.zmodCast.mul (n : Nat) (x y : Set)
  requires first : x ∈ ℤ
  requires second : y ∈ ℤ
  shows zmodCast(n)(integerMulValue(x, y)) =
    call2(Ring.mul(zmod(n)), zmodCast(n)(x), zmodCast(n)(y))
proof
  have basics := tkJ.zmod.comm_ring at n
  obtain ⟨zc, hom, _⟩ := basics
  have xI : Integer(x) by settle with Integer
  have yI : Integer(y) by settle with Integer
  have xIn : x ∈ Ring.carrier(integerRing)
    rw tkJ.integerRing.carrier
    exact first
  have yIn : y ∈ Ring.carrier(integerRing)
    rw tkJ.integerRing.carrier
    exact second
  have m := RingHom.map_mul at zmodCast(n), integerRing, zmod(n), x, y with hom, xIn, yIn
  rw [tkJ.integerRing.mul, integerMulValue.notation] at m
  exact m

theorem tkJ.zmodCast.add (n : Nat) (x y : Set)
  requires first : x ∈ ℤ
  requires second : y ∈ ℤ
  shows zmodCast(n)(integerAddValue(x, y)) =
    call2(Ring.add(zmod(n)), zmodCast(n)(x), zmodCast(n)(y))
proof
  have basics := tkJ.zmod.comm_ring at n
  obtain ⟨zc, hom, _⟩ := basics
  have xI : Integer(x) by settle with Integer
  have yI : Integer(y) by settle with Integer
  have xIn : x ∈ Ring.carrier(integerRing)
    rw tkJ.integerRing.carrier
    exact first
  have yIn : y ∈ Ring.carrier(integerRing)
    rw tkJ.integerRing.carrier
    exact second
  have m := RingHom.map_add at zmodCast(n), integerRing, zmod(n), x, y with hom, xIn, yIn
  rw [tkJ.integerRing.add, integerAddValue.notation] at m
  exact m

theorem tkJ.zmodCast.one (n : Nat)
  shows zmodCast(n)(integerOne) = Ring.one(zmod(n))
proof
  have basics := tkJ.zmod.comm_ring at n
  obtain ⟨zc, hom, _⟩ := basics
  have m := RingHom.map_one with hom
  rw tkJ.integerRing.one at m
  exact m

-- ZMod.val: the representative in {0, …, n − 1} of a class, for n ≥ 1.
defunique zmodVal (n : Nat, a : Set) (k ∈ ℕ) :=
  k < n ∧ zmodCast(n)(integerOfNat(k)) = a
requires positive : 0 < n
requires member : a ∈ Ring.carrier(zmod(n))
proof
  have basics := tkJ.zmod.comm_ring at n
  obtain ⟨zc, hom, surj⟩ := basics
  obtain ⟨fun, onto⟩ := surj
  obtain ⟨x, xIn, xr⟩ := onto with a, member
  have xa := FunctionBetween.apply_value with fun, xIn, xr
  have xI : Integer(x) by settle with Integer
  have rNat := integerMod.natural at x, n with positive
  have rLt := integerMod.below at x, n with positive
  have cong := integerMod.congruent at x, n with positive
  unfold IntegerCongruent at cong
  have rIn : integerOfNat(integerMod(x, n)) ∈ ℤ by typecheck
  have e := tkJ.zmodCast.eq_iff at n, integerOfNat(integerMod(x, n)), x with rIn, xIn
  have flip : integerAddValue(x, integerNegValue(integerOfNat(integerMod(x, n)))) = integerSubValue(x, integerOfNat(integerMod(x, n))) by ring
  rw flip at e
  have same := e.backward with cong
  rw xa at same
  have rN : integerMod(x, n) ∈ ℕ by typecheck
  exact ⟨integerMod(x, n), rN, rLt, same⟩
uniqueness
  intros k kIn h1 l lIn h2
  obtain ⟨kLt, ka⟩ := h1
  obtain ⟨lLt, la⟩ := h2
  have kN : Nat(k) by typecheck
  have lN : Nat(l) by typecheck
  have same : zmodCast(n)(integerOfNat(k)) = zmodCast(n)(integerOfNat(l))
    rw [ka, la]
  have e := (tkJ.zmodCast.nat_eq_iff at n, k, l with positive).forward with same
  rw [(integerMod.ofNat at k, n with positive), (integerMod.ofNat at l, n with positive)] at e
  rw [(mod.of_less at n, k with kLt), (mod.of_less at n, l with lLt)] at e
  exact e

-- Helpers: a function from its graph, and the enumeration k ↦ [k] of ℤ/nℤ.
theorem tkJ.fin_graph_function (G A B : Set)
  requires bounded : ∀ u ∈ G, u ∈ A × B
  requires single : ∀ x, ∀ y, ∀ z, (x, y) ∈ G → (x, z) ∈ G → y = z
  requires total : ∀ x ∈ A, ∃ y ∈ B, (x, y) ∈ G
  shows G : A → B
proof
  constructor
    intros q mem
    exact bounded with q, mem
  . constructor
      intros x y hy z hz
      unfold relates at hy
      unfold relates at hz
      exact single with x, y, z, hy, hz
    . intros x hx
      obtain ⟨y, yIn, rel⟩ := total with x, hx
      refine ⟨y, yIn, ?_⟩
      unfold relates
      exact rel

-- The map [a] ↦ val(a) · 1 from ℤ/nℤ into a ring where n · 1 = 0.
def tkJZmodLift (n : Nat, R : Set) : Set :=
  { (a, natCast(R, zmodVal(n, a))) | a ∈ Ring.carrier(zmod(n)) }

def tkJZmodEnum (n : Nat) : Set := { (k, zmodCast(n)(integerOfNat(k))) | k ∈ n }

theorem tkJ.zmod.cast_mem (n : Nat) (x : Set)
  requires integer : x ∈ ℤ
  shows zmodCast(n)(x) ∈ Ring.carrier(zmod(n))
proof
  have basics := tkJ.zmod.comm_ring at n
  obtain ⟨zc, hom, _⟩ := basics
  have xZ : x ∈ Ring.carrier(integerRing)
    rw tkJ.integerRing.carrier
    exact integer
  exact RingHom.map_mem with hom, xZ

theorem tkJ.zmodEnum.pair (n : Nat) (x y : Set)
  requires member : (x, y) ∈ tkJZmodEnum(n)
  shows x ∈ n ∧ y = zmodCast(n)(integerOfNat(x))
proof
  obtain ⟨k, kIn, e⟩ := tkJZmodEnum.membership.forward with member
  obtain ⟨xk, yk⟩ := orderedPair.injective with e
  rw [← xk, ← yk]
  exact ⟨kIn, rfl⟩

theorem tkJ.zmodEnum.function (n : Nat)
  shows tkJZmodEnum(n) : n → Ring.carrier(zmod(n))
proof
  apply tkJ.fin_graph_function
  . intros u uIn
    obtain ⟨k, kIn, e⟩ := tkJZmodEnum.membership.forward with uIn
    have kN := natural.member at n with kIn
    have cIn : zmodCast(n)(integerOfNat(k)) ∈ Ring.carrier(zmod(n))
      have kZ : integerOfNat(k) ∈ ℤ by typecheck
      exact tkJ.zmod.cast_mem at n, integerOfNat(k) with kZ
    rw ← e
    exact product.pair with kIn, cIn
  . intros x y z hy hz
    obtain ⟨_, ey⟩ := tkJ.zmodEnum.pair with hy
    obtain ⟨_, ez⟩ := tkJ.zmodEnum.pair with hz
    rw [ey, ez]
  . intros k kIn
    have kN := natural.member at n with kIn
    have cIn : zmodCast(n)(integerOfNat(k)) ∈ Ring.carrier(zmod(n))
      have kZ : integerOfNat(k) ∈ ℤ by typecheck
      exact tkJ.zmod.cast_mem at n, integerOfNat(k) with kZ
    refine ⟨zmodCast(n)(integerOfNat(k)), cIn, ?_⟩
    apply tkJZmodEnum.membership.backward
    exact ⟨k, kIn, rfl⟩

theorem tkJ.zmod.card (n : Nat)
  requires positive : 0 < n
  shows HasCardinality(Ring.carrier(zmod(n)), n)
proof
  have fun := tkJ.zmodEnum.function at n
  have inj : InjectiveBetween(tkJZmodEnum(n), n, Ring.carrier(zmod(n)))
    refine ⟨fun, ?_⟩
    intros x xIn y yIn z zIn rx ry
    unfold relates at rx
    unfold relates at ry
    obtain ⟨_, ex⟩ := tkJ.zmodEnum.pair with rx
    obtain ⟨_, ey⟩ := tkJ.zmodEnum.pair with ry
    have xN := natural.member at n with xIn
    have yN := natural.member at n with yIn
    have xLt := Less.of_membership at x, n with xIn
    have yLt := Less.of_membership at y, n with yIn
    have same : zmodCast(n)(integerOfNat(x)) = zmodCast(n)(integerOfNat(y))
      rw [← ex, ← ey]
    have e := (tkJ.zmodCast.nat_eq_iff at n, x, y with positive).forward with same
    rw [(integerMod.ofNat at x, n with positive), (integerMod.ofNat at y, n with positive)] at e
    rw [(mod.of_less at n, x with xLt), (mod.of_less at n, y with yLt)] at e
    exact e
  have surj : SurjectiveBetween(tkJZmodEnum(n), n, Ring.carrier(zmod(n)))
    refine ⟨fun, ?_⟩
    intros a aIn
    have sel := zmodVal.selected at n, a with positive, aIn
    obtain ⟨vN, vLt, va⟩ := sel
    have vNat : Nat(zmodVal(n, a)) by typecheck
    have vIn := membership.of_Less at zmodVal(n, a), n with vNat, * 
    have vIn2 := vIn with vLt
    refine ⟨zmodVal(n, a), vIn2, ?_⟩
    unfold relates
    apply tkJZmodEnum.membership.backward
    refine ⟨zmodVal(n, a), vIn2, ?_⟩
    rw va
  have eq : Equipotent(n, Ring.carrier(zmod(n)))
    exact ⟨tkJZmodEnum(n), inj, surj⟩
  have nNat : Nat(n) by typecheck
  exact ⟨nNat, (Equipotent.symmetric with eq)⟩

-- Section: Characteristic
-- R has characteristic p: n · 1 = 0 exactly when p ∣ n (CharP R p).
predicate CharP (R : Set, p : Nat) :=
  Ring(R) ∧ (∀ n ∈ ℕ, natCast(R, n) = Ring.zero(R) ↔ p ∣ n)

-- Helpers: natural numbers in a ring.
theorem tkJ.natCast.mem (R : Set) (n : Nat)
  requires ring : Ring(R)
  shows natCast(R, n) ∈ Ring.carrier(R)
proof
  have parts := Ring.parts with ring
  unfold natCast
  exact IsRing.numeral_closed with parts

theorem tkJ.natCast.zero (R : Set)
  shows natCast(R, 0) = Ring.zero(R)
proof
  unfold natCast
  exact ringNat.zero

theorem tkJ.ringNat.add (R : Set) (m n : Nat)
  requires ring : Ring(R)
  shows ringNat(Ring.add(R), Ring.zero(R), Ring.one(R), m + n) =
    call2(Ring.add(R), ringNat(Ring.add(R), Ring.zero(R), Ring.one(R), m),
      ringNat(Ring.add(R), Ring.zero(R), Ring.one(R), n))
proof
  have parts := Ring.parts with ring
  have mIn := IsRing.numeral_closed at Ring.carrier(R), Ring.add(R), Ring.zero(R), Ring.neg(R), Ring.mul(R), Ring.one(R), m with parts
  induction n
  | zero =>
    rw [add.right_unit, ringNat.zero]
    have rid := IsRing.add_right_identity with parts, mIn
    rw rid
  | succ(k) using ih =>
    have kIn := IsRing.numeral_closed at Ring.carrier(R), Ring.add(R), Ring.zero(R), Ring.neg(R), Ring.mul(R), Ring.one(R), k with parts
    have oneIn : Ring.one(R) ∈ Ring.carrier(R) by typecheck
    rw [add.succ_right, ringNat.succ, ringNat.succ, ih]
    have assoc := IsRing.add_associative with parts
    exact Associative.law with assoc, mIn, kIn, oneIn

theorem tkJ.natCast.add (R : Set) (m n : Nat)
  requires ring : Ring(R)
  shows natCast(R, m + n) = call2(Ring.add(R), natCast(R, m), natCast(R, n))
proof
  unfold natCast
  exact tkJ.ringNat.add at R, m, n with ring

theorem tkJ.natCast.mul_vanish (R : Set) (p q : Nat)
  requires ring : Ring(R)
  requires vanishes : natCast(R, p) = Ring.zero(R)
  shows natCast(R, p * q) = Ring.zero(R)
proof
  have parts := Ring.parts with ring
  induction q
  | zero =>
    rw mul.right_zero
    exact tkJ.natCast.zero at R
  | succ(k) using ih =>
    rw mul.succ_right
    rw (tkJ.natCast.add at R, p, p * k with ring)
    rw [ih, vanishes]
    have zIn : Ring.zero(R) ∈ Ring.carrier(R) by typecheck
    exact IsRing.add_right_identity with parts, zIn

def tkJCharKillers (R : Set) : Set :=
  { k ∈ ℕ | 0 < k ∧ natCast(R, k) = Ring.zero(R) }

theorem tkJ.charP.exists (R : Set)
  requires ring : Ring(R)
  shows ∃ p ∈ ℕ, CharP(R, p)
proof
  have parts := Ring.parts with ring
  by_cases h : Nonempty(tkJCharKillers(R))
  . have sub : tkJCharKillers(R) ⊆ ℕ
      intros x xIn
      obtain ⟨xN, _⟩ := tkJCharKillers.membership.forward with xIn
      exact xN
    have pIn := leastNatural.member at tkJCharKillers(R) with h, sub
    obtain ⟨pN, pPos, pZero⟩ := tkJCharKillers.membership.forward with pIn
    have pNat : Nat(leastNatural(tkJCharKillers(R))) by typecheck
    have nonzero : leastNatural(tkJCharKillers(R)) ≠ 0 by arith
    have law : ∀ n ∈ ℕ, natCast(R, n) = Ring.zero(R) ↔ leastNatural(tkJCharKillers(R)) ∣ n
      intros n nIn
      have nNat : Nat(n) by typecheck
      constructor
      . intro z
        obtain ⟨q, qN, eq⟩ := mod.equation at n, leastNatural(tkJCharKillers(R)) with nonzero
        have split := tkJ.natCast.add at R, leastNatural(tkJCharKillers(R)) * q, n % leastNatural(tkJCharKillers(R)) with ring
        rw ← eq at split
        have mz := tkJ.natCast.mul_vanish at R, leastNatural(tkJCharKillers(R)), q with ring, pZero
        rw [z, mz] at split
        have rIn := tkJ.natCast.mem at R, n % leastNatural(tkJCharKillers(R)) with ring
        have lid := IsRing.add_left_identity with parts, rIn
        rw lid at split
        symm at split
        by_cases r0 : n % leastNatural(tkJCharKillers(R)) = 0
        . rw [r0, add.right_unit] at eq
          symm at eq
          exact ⟨q, qN, eq⟩
        . exfalso
          have rPos : 0 < n % leastNatural(tkJCharKillers(R)) by arith
          have rN : n % leastNatural(tkJCharKillers(R)) ∈ ℕ by typecheck
          have rS : n % leastNatural(tkJCharKillers(R)) ∈ tkJCharKillers(R)
            apply tkJCharKillers.membership.backward
            exact ⟨rN, rPos, split⟩
          have le := leastNatural.least at tkJCharKillers(R), n % leastNatural(tkJCharKillers(R)) with h, sub, rS
          have lt := mod.less at n, leastNatural(tkJCharKillers(R)) with nonzero
          arith
      . intro d
        obtain ⟨k, kN, e⟩ := d
        rw ← e
        exact tkJ.natCast.mul_vanish at R, leastNatural(tkJCharKillers(R)), k with ring, pZero
    exact ⟨leastNatural(tkJCharKillers(R)), pN, ring, law⟩
  . have zN : 0 ∈ ℕ by typecheck
    have law : ∀ n ∈ ℕ, natCast(R, n) = Ring.zero(R) ↔ 0 ∣ n
      intros n nIn
      have nNat : Nat(n) by typecheck
      constructor
      . intro z
        by_cases n0 : n = 0
        . rw n0
          exact divides.zero at 0
        . exfalso
          have nPos : 0 < n by arith
          have nS : n ∈ tkJCharKillers(R)
            apply tkJCharKillers.membership.backward
            exact ⟨nIn, nPos, z⟩
          have ne : Nonempty(tkJCharKillers(R))
            exact ⟨n, nS⟩
          exact h with ne
      . intro d
        have n0 := zero.divides_only_zero at n with d
        rw n0
        exact tkJ.natCast.zero at R
    exact ⟨0, zN, ring, law⟩

theorem tkJ.charP.unique (R : Set) (p q : Nat)
  requires first : CharP(R, p)
  requires second : CharP(R, q)
  shows p = q
proof
  obtain ⟨_, lp⟩ := first
  obtain ⟨_, lq⟩ := second
  have pN : p ∈ ℕ by typecheck
  have qN : q ∈ ℕ by typecheck
  have pz := (lp with p, pN).backward with (divides.reflexive at p)
  have qz := (lq with q, qN).backward with (divides.reflexive at q)
  have qp := (lq with p, pN).forward with pz
  have pq := (lp with q, qN).forward with qz
  exact divides.antisymmetric at p, q with pq, qp

-- The characteristic (ringChar R), unique by CharP.eq.
defunique ringChar (R : Set) (p ∈ ℕ) := CharP(R, p)
requires ring : Ring(R)
proof
  exact tkJ.charP.exists at R with ring
uniqueness
  intros p pIn hp q qIn hq
  have pNat : Nat(p) by typecheck
  have qNat : Nat(q) by typecheck
  exact tkJ.charP.unique at R, p, q with hp, hq

-- Section: Frobenius
-- x ↦ x^p and its n-th iterate x ↦ x^(p^n) (frobenius R p,
-- iterateFrobenius R p n).
def frobenius (R : Set, p : Nat) : Set :=
  { (x, Ring.pow(R, x, p)) | x ∈ Ring.carrier(R) }

def iterateFrobenius (R : Set, p n : Nat) : Set :=
  { (x, Ring.pow(R, x, p ^ n)) | x ∈ Ring.carrier(R) }

-- R is perfect of characteristic p: the Frobenius is bijective
-- (PerfectRing R p).
predicate PerfectRing (R : Set, p : Nat) :=
  CharP(R, p) ∧ BijectiveBetween(frobenius(R, p), Ring.carrier(R), Ring.carrier(R))

-- The inverse of the Frobenius of a perfect ring (frobeniusEquiv, its
-- symm), as the converse relation.
def frobeniusInverse (R : Set, p : Nat) : Set :=
  converse(frobenius(R, p), Ring.carrier(R), Ring.carrier(R))

-- The family v ↦ w(v)^m on V.
def familyPow (R V w : Set, m : Nat) : Set := { (v, Ring.pow(R, w(v), m)) | v ∈ V }

-- Section: Finite fields
-- A finite field (Mathlib's [Field K] [Fintype K]) and a cyclic group
-- (IsCyclic: every element is an integer power g^k of one g, k ∈ ℤ
-- written as g^n or (g^n)⁻¹ with n ∈ ℕ).
predicate FiniteField (K : Set) := Field(K) ∧ Finite(Ring.carrier(K))

predicate CyclicGroup (G : Set) :=
  Group(G) ∧ (∃ g ∈ Group.carrier(G), ∀ x ∈ Group.carrier(G), ∃ n ∈ ℕ,
    x = groupPow(G, g, n) ∨ x = Group.inv(G)(groupPow(G, g, n)))

-- The Frobenius x ↦ x^q of an extension L/K of finite fields with
-- |K| = q, a K-algebra automorphism of L (FiniteField.frobeniusAlgHom,
-- FiniteField.frobeniusAlgEquivOfAlgebraic).
def relativeFrobenius (E : Set) : Set :=
  { (x, Ring.pow(Algebra.ring(E), x, cardinality(Ring.carrier(Algebra.base(E))))) |
    x ∈ algebraCarrier(E) }

-- X^q − X over K (FiniteField.X_pow_card_sub_X).
def polyXPowSubX (K : Set, q : Nat) : Set :=
  Ring.sub(polynomialRing(K, {0}), Ring.pow(polynomialRing(K, {0}), polyX(K), q), polyX(K))

-- Helpers: homomorphisms, injective maps, and the Frobenius graphs.
theorem tkJ.hom_natCast (f R S : Set) (k : Nat)
  requires hom : f : R →+* S
  shows f(natCast(R, k)) = natCast(S, k)
proof
  have ringR := RingHom.source with hom
  induction k
  | zero =>
    rw [tkJ.natCast.zero, tkJ.natCast.zero]
    exact RingHom.map_zero with hom
  | succ(j) using ih =>
    have jIn := tkJ.natCast.mem at R, j with ringR
    have oneIn : Ring.one(R) ∈ Ring.carrier(R) by typecheck
    unfold natCast
    rw [ringNat.succ, ringNat.succ]
    have add := RingHom.map_add at f, R, S, natCast(R, j), Ring.one(R) with hom, jIn, oneIn
    unfold natCast at add
    unfold natCast at ih
    rw [add, ih]
    have one := RingHom.map_one with hom
    rw one

theorem tkJ.hom_pow (f R S a : Set) (n : Nat)
  requires hom : f : R →+* S
  requires member : a ∈ Ring.carrier(R)
  shows f(Ring.pow(R, a, n)) = Ring.pow(S, f(a), n)
proof
  have ringR := RingHom.source with hom
  have ringS := RingHom.target with hom
  have faIn : f(a) ∈ Ring.carrier(S) := RingHom.map_mem with hom, member
  induction n
  | zero =>
    have left := Ring.pow_zero at R, a with ringR, member
    have right := Ring.pow_zero at S, f(a) with ringS, faIn
    have one := RingHom.map_one with hom
    rw [left, right, one]
  | succ(k) using ih =>
    have shift := add.right_one at k with *
    rw ← shift
    have left := Ring.pow_succ at R, a, k with ringR, member
    have right := Ring.pow_succ at S, f(a), k with ringS, faIn
    have pIn : Ring.pow(R, a, k) ∈ Ring.carrier(R) := Ring.pow_mem at R, a, k with ringR, member
    have mul := RingHom.map_mul at f, R, S, Ring.pow(R, a, k), a with hom, pIn, member
    rw [left, right, mul, ih]

theorem tkJ.injective_apply (f A B x y : Set)
  requires injective : InjectiveBetween(f, A, B)
  requires first : x ∈ A
  requires second : y ∈ A
  requires same : f(x) = f(y)
  shows x = y
proof
  obtain ⟨fun, law⟩ := injective
  have rx := FunctionBetween.relates_apply with fun, first
  have ry := FunctionBetween.relates_apply with fun, second
  have fyIn := FunctionBetween.apply_closed with fun, second
  rw same at rx
  exact law with x, first, y, second, f(y), fyIn, rx, ry

theorem tkJ.frobenius.function (R : Set) (p : Nat)
  requires ring : Ring(R)
  shows frobenius(R, p) : Ring.carrier(R) → Ring.carrier(R)
proof
  apply tkJ.fin_graph_function
  . intros u uIn
    obtain ⟨x, xIn, e⟩ := frobenius.membership.forward with uIn
    have pIn : Ring.pow(R, x, p) ∈ Ring.carrier(R) := Ring.pow_mem at R, x, p with ring, xIn
    rw ← e
    exact product.pair with xIn, pIn
  . intros x y z hy hz
    obtain ⟨a, aIn, ea⟩ := frobenius.membership.forward with hy
    obtain ⟨b, bIn, eb⟩ := frobenius.membership.forward with hz
    obtain ⟨xa, ya⟩ := orderedPair.injective with ea
    obtain ⟨xb, zb⟩ := orderedPair.injective with eb
    rw [← ya, ← zb, xa, xb]
  . intros x xIn
    have pIn : Ring.pow(R, x, p) ∈ Ring.carrier(R) := Ring.pow_mem at R, x, p with ring, xIn
    refine ⟨Ring.pow(R, x, p), pIn, ?_⟩
    apply frobenius.membership.backward
    exact ⟨x, xIn, rfl⟩

theorem tkJ.frobenius.apply (R : Set) (p : Nat) (x : Set)
  requires ring : Ring(R)
  requires member : x ∈ Ring.carrier(R)
  shows frobenius(R, p)(x) = Ring.pow(R, x, p)
proof
  have fun := tkJ.frobenius.function at R, p with ring
  have rel : relates(frobenius(R, p), x, Ring.pow(R, x, p))
    unfold relates
    apply frobenius.membership.backward
    exact ⟨x, member, rfl⟩
  exact FunctionBetween.apply_value with fun, member, rel

theorem tkJ.iterateFrobenius.function (R : Set) (p n : Nat)
  requires ring : Ring(R)
  shows iterateFrobenius(R, p, n) : Ring.carrier(R) → Ring.carrier(R)
proof
  apply tkJ.fin_graph_function
  . intros u uIn
    obtain ⟨x, xIn, e⟩ := iterateFrobenius.membership.forward with uIn
    have pIn : Ring.pow(R, x, p ^ n) ∈ Ring.carrier(R) := Ring.pow_mem at R, x, p ^ n with ring, xIn
    rw ← e
    exact product.pair with xIn, pIn
  . intros x y z hy hz
    obtain ⟨a, aIn, ea⟩ := iterateFrobenius.membership.forward with hy
    obtain ⟨b, bIn, eb⟩ := iterateFrobenius.membership.forward with hz
    obtain ⟨xa, ya⟩ := orderedPair.injective with ea
    obtain ⟨xb, zb⟩ := orderedPair.injective with eb
    rw [← ya, ← zb, xa, xb]
  . intros x xIn
    have pIn : Ring.pow(R, x, p ^ n) ∈ Ring.carrier(R) := Ring.pow_mem at R, x, p ^ n with ring, xIn
    refine ⟨Ring.pow(R, x, p ^ n), pIn, ?_⟩
    apply iterateFrobenius.membership.backward
    exact ⟨x, xIn, rfl⟩

theorem tkJ.iterateFrobenius.apply (R : Set) (p n : Nat) (x : Set)
  requires ring : Ring(R)
  requires member : x ∈ Ring.carrier(R)
  shows iterateFrobenius(R, p, n)(x) = Ring.pow(R, x, p ^ n)
proof
  have fun := tkJ.iterateFrobenius.function at R, p, n with ring
  have rel : relates(iterateFrobenius(R, p, n), x, Ring.pow(R, x, p ^ n))
    unfold relates
    apply iterateFrobenius.membership.backward
    exact ⟨x, member, rfl⟩
  exact FunctionBetween.apply_value with fun, member, rel

-- Helpers: roots in a perfect ring.
theorem tkJ.perfect.root_exists (R : Set) (p i : Nat)
  requires perfect : PerfectRing(R, p)
  shows ∀ a ∈ Ring.carrier(R), ∃ y ∈ Ring.carrier(R), Ring.pow(R, y, p ^ i) = a
proof
  obtain ⟨char, bij⟩ := perfect
  obtain ⟨ring, _⟩ := char
  induction i
  | zero =>
    intros a aIn
    refine ⟨a, aIn, ?_⟩
    rw pow.zero
    exact Ring.pow_one at R, a with ring, aIn
  | succ(k) using ih =>
    intros a aIn
    have surj := bij.right
    obtain ⟨fun, onto⟩ := surj
    obtain ⟨b, bIn, br⟩ := onto with a, aIn
    have fb := FunctionBetween.apply_value with fun, bIn, br
    rw (tkJ.frobenius.apply at R, p, b with ring, bIn) at fb
    obtain ⟨y, yIn, yb⟩ := ih with b, bIn
    refine ⟨y, yIn, ?_⟩
    have shift := add.right_one at k with *
    rw ← shift
    rw (pow.succ_right at p, k)
    rw (Ring.pow_mul at R, y, p ^ k, p with ring, yIn)
    rw yb
    exact fb

theorem tkJ.perfect.root_unique (R : Set) (p i : Nat)
  requires perfect : PerfectRing(R, p)
  shows ∀ y ∈ Ring.carrier(R), ∀ z ∈ Ring.carrier(R),
    Ring.pow(R, y, p ^ i) = Ring.pow(R, z, p ^ i) → y = z
proof
  obtain ⟨char, bij⟩ := perfect
  obtain ⟨ring, _⟩ := char
  induction i
  | zero =>
    intros y yIn z zIn e
    rw pow.zero at e
    rw [(Ring.pow_one at R, y with ring, yIn), (Ring.pow_one at R, z with ring, zIn)] at e
    exact e
  | succ(k) using ih =>
    intros y yIn z zIn e
    have shift := add.right_one at k with *
    rw ← shift at e
    rw (pow.succ_right at p, k) at e
    rw [(Ring.pow_mul at R, y, p ^ k, p with ring, yIn), (Ring.pow_mul at R, z, p ^ k, p with ring, zIn)] at e
    have yk : Ring.pow(R, y, p ^ k) ∈ Ring.carrier(R) := Ring.pow_mem at R, y, p ^ k with ring, yIn
    have zk : Ring.pow(R, z, p ^ k) ∈ Ring.carrier(R) := Ring.pow_mem at R, z, p ^ k with ring, zIn
    rw [← (tkJ.frobenius.apply at R, p, Ring.pow(R, y, p ^ k) with ring, yk), ← (tkJ.frobenius.apply at R, p, Ring.pow(R, z, p ^ k) with ring, zk)] at e
    have inj := bij.left
    have same := tkJ.injective_apply with inj, yk, zk, e
    exact ih with y, yIn, z, zIn, same

-- Section: p-th roots in perfect rings
-- In a perfect ring of characteristic p, the unique y with y^(pⁱ) = a
-- (((frobeniusEquiv R p).symm)^[i] a).
defunique perfectRoot (R : Set, p i : Nat, a : Set) (y ∈ Ring.carrier(R)) :=
  Ring.pow(R, y, pow(p, i)) = a
requires perfect : PerfectRing(R, p)
requires comm : CommRing(R)
requires member : a ∈ Ring.carrier(R)
proof
  exact tkJ.perfect.root_exists at R, p, i with perfect, a, member
uniqueness
  intros y yIn e1 z zIn e2
  have same : Ring.pow(R, y, p ^ i) = Ring.pow(R, z, p ^ i)
    rw [e1, e2]
  exact tkJ.perfect.root_unique at R, p, i with perfect, y, yIn, z, zIn, same

theorem tkJ.natCast.mul (R : Set) (a b : Nat)
  requires comm : CommRing(R)
  shows natCast(R, a * b) = call2(Ring.mul(R), natCast(R, a), natCast(R, b))
proof
  have parts := CommRing.parts with comm
  unfold natCast
  exact IsCommRing.numeral_mul with parts

theorem tkJ.natCast.one (R : Set)
  requires ring : Ring(R)
  shows natCast(R, 1) = Ring.one(R)
proof
  have parts := Ring.parts with ring
  unfold natCast
  exact IsRing.numeral_one with parts

-- A domain of characteristic p ≠ 0 has p prime.
theorem tkJ.charP.prime (R : Set) (p : Nat)
  requires domain : IntegralDomain(R)
  requires char : CharP(R, p)
  requires nonzero : p ≠ 0
  shows Prime(p)
proof
  obtain ⟨comm, nt, nzd⟩ := domain
  have ring := CommRing.to_ring with comm
  obtain ⟨_, law⟩ := char
  have pN : p ∈ ℕ by typecheck
  have pz := (law with p, pN).backward with (divides.reflexive at p)
  have p1 : p ≠ 1
    intro e
    rw e at pz
    rw (tkJ.natCast.one at R with ring) at pz
    symm at pz
    exact nt with pz
  have gt : 1 < p by arith
  have oneIn := membership.of_Less at 1, p with *, gt
  refine ⟨oneIn, ?_⟩
  intros d dNat dIn dDiv
  have dLt := Less.of_membership at d, p with dIn
  obtain ⟨k, kNat, e⟩ := dDiv
  have kN : k ∈ ℕ by typecheck
  have dN : d ∈ ℕ by typecheck
  have m := tkJ.natCast.mul at R, d, k with comm
  have e2 : d * k = p by exact e
  rw [e2, pz] at m
  have dIn2 := tkJ.natCast.mem at R, d with ring
  have kIn2 := tkJ.natCast.mem at R, k with ring
  symm at m
  have d0 : d ≠ 0
    intro dz
    rw dz at e2
    rw mul.left_zero at e2
    symm at e2
    exact nonzero with e2
  have k0 : k ≠ 0
    intro kz
    rw kz at e2
    rw mul.right_zero at e2
    symm at e2
    exact nonzero with e2
  rcases nzd with natCast(R, d), dIn2, natCast(R, k), kIn2, m with a | b
  . exfalso
    have pd := (law with d, dN).forward with a
    have le := divides.le at p, d with pd, d0
    arith
  . have pk := (law with k, kN).forward with b
    have le := divides.le at p, k with pk, k0
    have kp : k ∣ p
      refine ⟨d, dNat, ?_⟩
      rw (mul.commutative at d, k)
      exact e2
    have le2 := divides.le at k, p with kp, nonzero
    have kp2 : k = p by arith
    rw kp2 at e2
    have e3 : p * d = p * 1
      rw [mul.right_unit, (mul.commutative at d, p)]
      exact e2
    exact mul.left_cancel_positive at d, 1, p with nonzero, e3

theorem tkJ.natCast.pow (R : Set) (a m : Nat)
  requires comm : CommRing(R)
  shows Ring.pow(R, natCast(R, a), m) = natCast(R, a ^ m)
proof
  have ring := CommRing.to_ring with comm
  have aIn := tkJ.natCast.mem at R, a with ring
  induction m
  | zero =>
    rw [(Ring.pow_zero at R, natCast(R, a) with ring, aIn), pow.zero]
    symm
    exact tkJ.natCast.one at R with ring
  | succ(k) using ih =>
    have shift := add.right_one at k with *
    rw ← shift
    rw (Ring.pow_succ at R, natCast(R, a), k with ring, aIn)
    rw ih
    rw ← (tkJ.natCast.mul at R, a ^ k, a with comm)
    rw (pow.succ_right at a, k)

-- Helper: a nontrivial commutative ring with inverses is a field.
theorem tkJ.field_of_inverses (K : Set)
  requires comm : CommRing(K)
  requires nontrivial : Ring.zero(K) ≠ Ring.one(K)
  requires inverses : ∀ x ∈ Ring.carrier(K), x ≠ Ring.zero(K) →
    (∃ y ∈ Ring.carrier(K), call2(Ring.mul(K), x, y) = Ring.one(K))
  shows Field(K)
proof
  have ringK := CommRing.to_ring with comm
  have parts := CommRing.parts at K with comm
  have zeroIn : Ring.zero(K) ∈ Ring.carrier(K) by typecheck
  have oneIn : Ring.one(K) ∈ Ring.carrier(K) by typecheck
  have inv2 : ∀ x ∈ Ring.carrier(K), x ≠ Ring.zero(K) → ∃ y, IsInverse(Ring.carrier(K), Ring.mul(K), Ring.one(K), x, y)
    intros x xIn xnz
    obtain ⟨y, yIn, xy⟩ := inverses with x, xIn, xnz
    have yx : y * x = Ring.one(K)
      rw ← xy
      ring
    unfold IsInverse
    exact ⟨y, xIn, yIn, yx, xy⟩
  have isField : IsField(Ring.carrier(K), Ring.add(K), Ring.zero(K), Ring.neg(K), Ring.mul(K), Ring.one(K))
    unfold IsField
    unfold Nontrivial
    exact ⟨parts, ⟨zeroIn, oneIn, nontrivial⟩, inv2⟩
  have eta := Ring.eta_of_ring at K with ringK
  rw eta
  exact Field.of_parts with isField

-- Helpers: the binomial theorem in a commutative ring, through the
-- partial sums Σ_{j<m} C(n, j) xʲ yⁿ⁻ʲ, and the binomial law in
-- prime characteristic.
def tkJBinomTerm (R x y : Set, n j : Nat) : Set :=
  call2(Ring.mul(R), call2(Ring.mul(R), natCast(R, choose(n, j)), Ring.pow(R, x, j)),
    Ring.pow(R, y, n - j))

def tkJBinomSum (R x y : Set, n m : Nat) → Set
  | R, x, y, n, zero => Ring.zero(R)
  | R, x, y, n, succ(j) => call2(Ring.add(R), tkJBinomSum(R, x, y, n, j), tkJBinomTerm(R, x, y, n, j))

theorem tkJ.choose.prime_middle (p j : Nat)
  requires prime : Prime(p)
  requires positive : 0 < j
  requires below : j < p
  shows p ∣ p choose j
proof
  obtain ⟨i, iNat, jShape⟩ := Less.exists_add_one with positive
  obtain ⟨n, nNat, pShape⟩ := Less.exists_add_one with below
  have zeroAdd : 0 + i + 1 = i + 1 by ring
  rw zeroAdd at jShape
  have absorbed := choose.absorption_at at j + n, i
  have rowShape : j + n + 1 = p
    rw pShape
    ring
  have row : (i + 1) * (p choose (i + 1)) = p * ((j + n) choose i)
    rw ← rowShape
    exact absorbed
  rw ← jShape at row
  have cNat := choose.natural at j + n, i
  have product : p ∣ j * (p choose j)
    witness (j + n) choose i
    rw row
    rfl
  have split := Prime.divides_mul with prime, product
  cases split with dividesJ | dividesEntry
  . exfalso
    have jNonzero : j ≠ 0
      intro zero
      rw zero at positive
      exact Less.irreflexive at 0 with positive
    have bound := divides.le with dividesJ, jNonzero
    have strict := LessEqual.transitive_Less with bound, below
    exact Less.irreflexive with strict
  . exact dividesEntry

section tkJBinomial
variable (R : Set)
hypothesis comm : CommRing(R)

theorem tkJ.binom.term_mem (x y : R) (n j : Nat)
  shows tkJBinomTerm(R, x, y, n, j) ∈ R.carrier
proof
  have ring := CommRing.to_ring with comm
  have cNat := choose.natural at n, j
  have cIn := tkJ.natCast.mem at R, choose(n, j) with ring
  unfold tkJBinomTerm
  typecheck

theorem tkJ.binom.sum_succ (x y : R) (n j : Nat)
  shows tkJBinomSum(R, x, y, n, j + 1) = tkJBinomSum(R, x, y, n, j) + tkJBinomTerm(R, x, y, n, j)
proof
  have shift := add.right_one at j with *
  rw shift
  simp [tkJBinomSum]

theorem tkJ.binom.sum_mem (x y : R) (n m : Nat)
  shows tkJBinomSum(R, x, y, n, m) ∈ R.carrier
proof
  induction m
  | zero =>
    simp [tkJBinomSum]
    typecheck
  | succ(k) using ih =>
    have shift := add.right_one at k with *
    rw ← shift
    rw (tkJ.binom.sum_succ at R, x, y, n, k with comm)
    have t := tkJ.binom.term_mem at R, x, y, n, k with comm
    typecheck

theorem tkJ.binom.term_zero (x y : R) (n : Nat)
  shows tkJBinomTerm(R, x, y, n, 0) = y ^ n
proof
  have ring := CommRing.to_ring with comm
  unfold tkJBinomTerm
  rw [choose.zero_right, (tkJ.natCast.one at R with ring), sub.zero_right]
  rw (Ring.pow_zero at R, x with ring)
  ring

theorem tkJ.binom.term_above (x y : R) (n : Nat)
  shows tkJBinomTerm(R, x, y, n, n + 1) = R[0]
proof
  have le : n ≤ n by arith
  have v := choose.vanishes at n, n with le
  have shift := add.right_one at n with *
  rw ← shift at v
  unfold tkJBinomTerm
  rw [v, tkJ.natCast.zero]
  ring

theorem tkJ.binom.term_succ (x y : R) (n j : Nat)
  shows tkJBinomTerm(R, x, y, n + 1, j + 1) =
    x * tkJBinomTerm(R, x, y, n, j) + y * tkJBinomTerm(R, x, y, n, j + 1)
proof
  have ring := CommRing.to_ring with comm
  have c1Nat := choose.natural at n, j
  have c2Nat := choose.natural at n, j + 1
  have cAdd : choose(n + 1, j + 1) = choose(n, j) + choose(n, j + 1)
    rw [(add.right_one at n), (add.right_one at j)]
    exact choose.succ_succ at n, j
  have subShift : (n + 1) - (j + 1) = n - j
    rw [(add.right_one at n), (add.right_one at j)]
    exact sub.succ_succ at n, j
  have xs := Ring.pow_succ at R, x, j with ring
  have c1In := tkJ.natCast.mem at R, choose(n, j) with ring
  have c2In := tkJ.natCast.mem at R, choose(n, j + 1) with ring
  unfold tkJBinomTerm
  rw [cAdd, subShift, (tkJ.natCast.add at R, choose(n, j), choose(n, j + 1) with ring), xs]
  by_cases below : j < n
  . have nNat : Nat(n) by typecheck
    have sh := sub.succ_of_Less at j
    have e1 := sh with n, nNat, below
    have e2 : n - j = (n - (j + 1)) + 1
      rw [e1, (add.right_one at j)]
      have sNat : Nat(n - succ(j)) by typecheck
      symm
      exact add.right_one at n - succ(j)
    rw e2
    rw (Ring.pow_succ at R, y, n - (j + 1) with ring)
    ring
  . have le : n ≤ j by arith
    have v := choose.vanishes at n, j with le
    rw (add.right_one at j)
    rw [v, tkJ.natCast.zero]
    ring

theorem tkJ.binom.pascal (x y : R) (n m : Nat)
  shows tkJBinomSum(R, x, y, n + 1, m + 1) =
    x * tkJBinomSum(R, x, y, n, m) + y * tkJBinomSum(R, x, y, n, m + 1)
proof
  have ring := CommRing.to_ring with comm
  induction m
  | zero =>
    rw [(tkJ.binom.sum_succ at R, x, y, n + 1, 0 with comm), (tkJ.binom.sum_succ at R, x, y, n, 0 with comm)]
    simp [tkJBinomSum]
    rw [(tkJ.binom.term_zero at R, x, y, n + 1 with comm), (tkJ.binom.term_zero at R, x, y, n with comm)]
    rw (Ring.pow_succ at R, y, n with ring)
    ring
  | succ(k) using ih =>
    have shift := add.right_one at k with *
    rw ← shift
    rw (tkJ.binom.sum_succ at R, x, y, n + 1, k + 1 with comm)
    rw ih
    rw (tkJ.binom.term_succ at R, x, y, n, k with comm)
    rw [(tkJ.binom.sum_succ at R, x, y, n, k + 1 with comm), (tkJ.binom.sum_succ at R, x, y, n, k with comm)]
    have s1 := tkJ.binom.sum_mem at R, x, y, n, k with comm
    have t1 := tkJ.binom.term_mem at R, x, y, n, k with comm
    have t2 := tkJ.binom.term_mem at R, x, y, n, k + 1 with comm
    ring

theorem tkJ.binom.theorem (x y : R) (n : Nat)
  shows (x + y) ^ n = tkJBinomSum(R, x, y, n, n + 1)
proof
  have ring := CommRing.to_ring with comm
  induction n
  | zero =>
    rw (Ring.pow_zero at R, x + y with ring)
    rw (tkJ.binom.sum_succ at R, x, y, 0, 0 with comm)
    rw (tkJ.binom.term_zero at R, x, y, 0 with comm)
    rw (Ring.pow_zero at R, y with ring)
    simp [tkJBinomSum]
    ring
  | succ(k) using ih =>
    have shift := add.right_one at k with *
    rw ← shift
    rw (Ring.pow_succ at R, x + y, k with ring)
    rw ih
    rw (tkJ.binom.pascal at R, x, y, k, k + 1 with comm)
    rw (tkJ.binom.sum_succ at R, x, y, k, k + 1 with comm)
    rw (tkJ.binom.term_above at R, x, y, k with comm)
    have s1 := tkJ.binom.sum_mem at R, x, y, k, k + 1 with comm
    ring

theorem tkJ.binom.prime_partial (x y : R) (p m : Nat)
  requires prime : Prime(p)
  requires vanishes : natCast(R, p) = R[0]
  shows 0 < m → m ≤ p → tkJBinomSum(R, x, y, p, m) = y ^ p
proof
  have ring := CommRing.to_ring with comm
  induction m
  | zero =>
    intros pos le
    exfalso
    arith
  | succ(k) using ih =>
    intros pos le
    have shift := add.right_one at k with *
    rw ← shift
    rw (tkJ.binom.sum_succ at R, x, y, p, k with comm)
    by_cases k0 : k = 0
    . rw k0
      simp [tkJBinomSum]
      rw (tkJ.binom.term_zero at R, x, y, p with comm)
      ring
    . have kPos : 0 < k by arith
      have kLe : k ≤ p by arith
      have kLt : k < p by arith
      rw (ih with kPos, kLe)
      have d := tkJ.choose.prime_middle at p, k with prime, kPos, kLt
      obtain ⟨c, cNat, ce⟩ := d
      have tz : tkJBinomTerm(R, x, y, p, k) = R[0]
        unfold tkJBinomTerm
        rw ← ce
        rw (tkJ.natCast.mul_vanish at R, p, c with ring, vanishes)
        ring
      rw tz
      ring

theorem tkJ.binom.freshman (x y : R) (p : Nat)
  requires prime : Prime(p)
  requires vanishes : natCast(R, p) = R[0]
  shows (x + y) ^ p = x ^ p + y ^ p
proof
  have ring := CommRing.to_ring with comm
  have gt := Prime.greater_than_one at p with prime
  have pPos : 0 < p by arith
  have pLe : p ≤ p by arith
  have pN : p ∈ ℕ by typecheck
  rw (tkJ.binom.theorem at R, x, y, p with comm)
  rw (tkJ.binom.sum_succ at R, x, y, p, p with comm)
  have part := tkJ.binom.prime_partial at R, x, y, p, p with comm, prime, vanishes
  rw (part with pPos, pLe)
  unfold tkJBinomTerm
  rw [choose.diagonal, (tkJ.natCast.one at R with ring), sub.self]
  rw (Ring.pow_zero at R, y with ring)
  ring

end tkJBinomial

-- Helpers: an injective self-map of a finite set is onto; a ring of
-- characteristic 0 is infinite; powers in a domain.
theorem tkJ.finite_injective_onto (f A : Set)
  requires finite : Finite(A)
  requires injective : InjectiveBetween(f, A, A)
  shows SurjectiveBetween(f, A, A)
proof
  have fun := Injective.function with injective
  have sub := functionImage.subset at f, A, A
  have self : A ⊆ A := Subset.reflexive at A
  have same := cardinality.injective_image at f, A, A, A with injective, self, finite
  have eq := cardinality.eq_subset at functionImage(f, A, A), A with finite, sub, same
  refine ⟨fun, ?_⟩
  intros y yIn
  rw ← eq at yIn
  obtain ⟨_, x, xIn, yx⟩ := functionImage.membership.forward with yIn
  refine ⟨x, xIn, ?_⟩
  rw yx
  exact FunctionBetween.relates_apply with fun, xIn

def tkJNatCastMap (R : Set) : Set := { (k, natCast(R, k)) | k ∈ ℕ }

theorem tkJ.natCastMap.function (R : Set)
  requires ring : Ring(R)
  shows tkJNatCastMap(R) : ℕ → Ring.carrier(R)
proof
  apply tkJ.fin_graph_function
  . intros u uIn
    obtain ⟨k, kIn, e⟩ := tkJNatCastMap.membership.forward with uIn
    have kNat : Nat(k) by typecheck
    have cIn := tkJ.natCast.mem at R, k with ring
    rw ← e
    exact product.pair with kIn, cIn
  . intros x y z hy hz
    obtain ⟨a, aIn, ea⟩ := tkJNatCastMap.membership.forward with hy
    obtain ⟨b, bIn, eb⟩ := tkJNatCastMap.membership.forward with hz
    obtain ⟨xa, ya⟩ := orderedPair.injective with ea
    obtain ⟨xb, zb⟩ := orderedPair.injective with eb
    rw [← ya, ← zb, xa, xb]
  . intros k kIn
    have kNat : Nat(k) by typecheck
    have cIn := tkJ.natCast.mem at R, k with ring
    refine ⟨natCast(R, k), cIn, ?_⟩
    apply tkJNatCastMap.membership.backward
    exact ⟨k, kIn, rfl⟩

theorem tkJ.charP.zero_infinite (R : Set)
  requires comm : CommRing(R)
  requires char : CharP(R, 0)
  shows ¬Finite(Ring.carrier(R))
proof
  have ring := CommRing.to_ring with comm
  have fun := tkJ.natCastMap.function at R with ring
  obtain ⟨_, law⟩ := char
  have apply : ∀ k ∈ ℕ, tkJNatCastMap(R)(k) = natCast(R, k)
    intros k kIn
    have rel : relates(tkJNatCastMap(R), k, natCast(R, k))
      unfold relates
      apply tkJNatCastMap.membership.backward
      exact ⟨k, kIn, rfl⟩
    exact FunctionBetween.apply_value with fun, kIn, rel
  have dir : ∀ a ∈ ℕ, ∀ b ∈ ℕ, a ≤ b → natCast(R, a) = natCast(R, b) → a = b
    intros a aIn b bIn le e
    obtain ⟨d, dNat, ad⟩ := le
    have dN : d ∈ ℕ by typecheck
    have aNat : Nat(a) by typecheck
    have sum := tkJ.natCast.add at R, a, d with ring
    have ad2 : a + d = b by exact ad
    rw [ad2, ← e] at sum
    have aIn2 := tkJ.natCast.mem at R, a with ring
    have dIn2 := tkJ.natCast.mem at R, d with ring
    have dz : natCast(R, d) = Ring.zero(R)
      have t : natCast(R, d) = (natCast(R, a) + natCast(R, d)) - natCast(R, a) by ring
      rw ← sum at t
      rw t
      ring
    have z := (law with d, dN).forward with dz
    have d0 := zero.divides_only_zero at d with z
    rw d0 at ad2
    rw add.right_unit at ad2
    exact ad2
  have inj : InjectiveBetween(tkJNatCastMap(R), ℕ, Ring.carrier(R))
    refine ⟨fun, ?_⟩
    intros a aIn b bIn z zIn ra rb
    have fa := FunctionBetween.apply_value with fun, aIn, ra
    have fb := FunctionBetween.apply_value with fun, bIn, rb
    rw (apply with a, aIn) at fa
    rw (apply with b, bIn) at fb
    rw ← fb at fa
    have aNat : Nat(a) by typecheck
    have bNat : Nat(b) by typecheck
    have tot := LessEqual.total at a, b
    cases tot with ab | ba
    . exact dir with a, aIn, b, bIn, ab, fa
    . symm at fa
      have r := dir with b, bIn, a, aIn, ba, fa
      symm at r
      exact r
  intro fin
  have dom := Dominated.of_injective with inj
  have nf := Finite.of_dominated with fin, dom
  exact omega.infinite with nf

-- In a domain, xⁿ = 0 forces x = 0.
theorem tkJ.domain.pow_eq_zero (R x : Set) (n : Nat)
  requires domain : IntegralDomain(R)
  requires member : x ∈ Ring.carrier(R)
  shows Ring.pow(R, x, n) = Ring.zero(R) → x = Ring.zero(R)
proof
  induction n
  | zero =>
    obtain ⟨comm, nt, nzd⟩ := domain
    have ring := CommRing.to_ring with comm
    intro e
    rw (Ring.pow_zero at R, x with ring, member) at e
    exfalso
    symm at e
    exact nt with e
  | succ(k) using ih =>
    obtain ⟨comm, nt, nzd⟩ := domain
    have ring := CommRing.to_ring with comm
    intro e
    have shift := add.right_one at k with *
    rw ← shift at e
    rw (Ring.pow_succ at R, x, k with ring, member) at e
    have pIn : Ring.pow(R, x, k) ∈ Ring.carrier(R) by typecheck
    rcases nzd with Ring.pow(R, x, k), pIn, x, member, e with a | b
    . exact ih with a
    . exact b

-- Helper: the family v ↦ w(v)^m as a function.
theorem tkJ.familyPow.function (R V w : Set) (m : Nat)
  requires ring : Ring(R)
  requires family : w : V → Ring.carrier(R)
  shows familyPow(R, V, w, m) : V → Ring.carrier(R)
proof
  apply tkJ.fin_graph_function
  . intros u uIn
    obtain ⟨v, vIn, e⟩ := familyPow.membership.forward with uIn
    have wv := FunctionBetween.apply_closed with family, vIn
    have pIn : Ring.pow(R, w(v), m) ∈ Ring.carrier(R) := Ring.pow_mem at R, w(v), m with ring, wv
    rw ← e
    exact product.pair with vIn, pIn
  . intros x y z hy hz
    obtain ⟨a, aIn, ea⟩ := familyPow.membership.forward with hy
    obtain ⟨b, bIn, eb⟩ := familyPow.membership.forward with hz
    obtain ⟨xa, ya⟩ := orderedPair.injective with ea
    obtain ⟨xb, zb⟩ := orderedPair.injective with eb
    rw [← ya, ← zb, xa, xb]
  . intros v vIn
    have wv := FunctionBetween.apply_closed with family, vIn
    have pIn : Ring.pow(R, w(v), m) ∈ Ring.carrier(R) := Ring.pow_mem at R, w(v), m with ring, wv
    refine ⟨Ring.pow(R, w(v), m), pIn, ?_⟩
    apply familyPow.membership.backward
    exact ⟨v, vIn, rfl⟩

theorem tkJ.familyPow.apply (R V w v : Set) (m : Nat)
  requires ring : Ring(R)
  requires family : w : V → Ring.carrier(R)
  requires point : v ∈ V
  shows familyPow(R, V, w, m)(v) = Ring.pow(R, w(v), m)
proof
  have fun := tkJ.familyPow.function at R, V, w, m with ring, family
  have rel : relates(familyPow(R, V, w, m), v, Ring.pow(R, w(v), m))
    unfold relates
    apply familyPow.membership.backward
    exact ⟨v, point, rfl⟩
  exact FunctionBetween.apply_value with fun, point, rel

-- Section: ℤ/nℤ
section ZModLaws
variable (n : Nat)

theorem integerRing.comm_ring
  shows CommRing(integerRing) ∧ IntegralDomain(integerRing)
proof
  exact tkJ.integerRing.domain

-- ZMod n is a commutative ring, and Int.cast a homomorphism onto it
-- (ZMod.commRing, Int.castRingHom, ZMod.intCast_surjective).
theorem zmod.comm_ring
  shows CommRing(zmod(n)) ∧ (zmodCast(n) : integerRing →+* zmod(n)) ∧
    SurjectiveBetween(zmodCast(n), ℤ, Ring.carrier(zmod(n)))
proof
  exact tkJ.zmod.comm_ring at n

-- ZMod.intCast_eq_intCast_iff_dvd_sub, ZMod.intCast_zmod_eq_zero_iff_dvd.
theorem zmodCast.eq_iff (a b : Set)
  requires first : a ∈ ℤ
  requires second : b ∈ ℤ
  shows zmodCast(n)(a) = zmodCast(n)(b) ↔
    IntegerDivides(integerOfNat(n), integerAddValue(b, integerNegValue(a)))
proof
  exact tkJ.zmodCast.eq_iff at n, a, b with first, second

-- ZMod.natCast_eq_natCast_iff (n ∣ a − b as a ≡ b [MOD n]) and
-- ZMod.natCast_self_eq_zero, ZMod.natCast_eq_zero_iff.
theorem zmodCast.nat_eq_zero_iff (a : Nat)
  shows zmodCast(n)(integerOfNat(a)) = Ring.zero(zmod(n)) ↔ n ∣ a
proof
  have aIn : integerOfNat(a) ∈ ℤ by typecheck
  rw (tkJ.zmodCast.eq_zero_iff at n, integerOfNat(a) with aIn)
  exact IntegerDivides.ofNat_iff at n, a

theorem zmodCast.nat_eq_iff (a b : Nat)
  requires positive : 0 < n
  shows zmodCast(n)(integerOfNat(a)) = zmodCast(n)(integerOfNat(b)) ↔
    integerMod(integerOfNat(a), n) = integerMod(integerOfNat(b), n)
proof
  exact tkJ.zmodCast.nat_eq_iff at n, a, b with positive

-- The cast of a natural number is its numeral in ZMod n.
theorem zmodCast.nat (a : Nat)
  shows zmodCast(n)(integerOfNat(a)) = natCast(zmod(n), a)
proof
  have comm := tkJ.integerRing.comm
  have basics := zmod.comm_ring at n
  obtain ⟨zc, hom, _⟩ := basics
  rw ← (tkJ.integerRing.natCast at a)
  unfold natCast
  exact RingHom.map_numeral at integerRing, zmod(n), zmodCast(n), a with comm, zc, hom

-- ZMod.card: |ZMod n| = n for n ≥ 1.
theorem zmod.card
  requires positive : 0 < n
  shows HasCardinality(Ring.carrier(zmod(n)), n)
proof
  exact tkJ.zmod.card at n with positive

-- ZMod.val_lt, ZMod.natCast_zmod_val (the value casts back),
-- ZMod.val_natCast (val of a cast natural is its remainder),
-- ZMod.val_injective.
theorem zmodVal.spec (a : Set)
  requires positive : 0 < n
  requires member : a ∈ Ring.carrier(zmod(n))
  shows zmodVal(n, a) < n ∧ zmodCast(n)(integerOfNat(zmodVal(n, a))) = a
proof
  have sel := zmodVal.selected at n, a with positive, member
  exact sel.right

theorem zmodVal.nat_cast (a : Nat)
  requires positive : 0 < n
  shows zmodVal(n, zmodCast(n)(integerOfNat(a))) = integerMod(integerOfNat(a), n)
proof
  have basics := tkJ.zmod.comm_ring at n
  obtain ⟨zc, hom, _⟩ := basics
  have aZ : integerOfNat(a) ∈ Ring.carrier(integerRing)
    rw tkJ.integerRing.carrier
    typecheck
  have member : zmodCast(n)(integerOfNat(a)) ∈ Ring.carrier(zmod(n)) := RingHom.map_mem with hom, aZ
  have sel := zmodVal.selected at n, zmodCast(n)(integerOfNat(a)) with positive, member
  have nonzero : n ≠ 0 by arith
  rw (integerMod.ofNat at a, n with positive)
  have rLt := mod.less at a, n with nonzero
  have rN : a % n ∈ ℕ by typecheck
  have back : zmodCast(n)(integerOfNat(a % n)) = zmodCast(n)(integerOfNat(a))
    rw (tkJ.zmodCast.nat_eq_iff at n, a % n, a with positive)
    rw [(integerMod.ofNat at a % n, n with positive), (integerMod.ofNat at a, n with positive)]
    exact mod.mod at n, a with nonzero
  have prop : a % n < n ∧ zmodCast(n)(integerOfNat(a % n)) = zmodCast(n)(integerOfNat(a))
    exact ⟨rLt, back⟩
  have k1 := sel.left
  have k2 := sel.right
  have nN : n ∈ ℕ by typecheck
  have u := zmodVal.unique at n, zmodCast(n)(integerOfNat(a)) with positive, member
  exact u with zmodVal(n, zmodCast(n)(integerOfNat(a))), k1, k2, a % n, rN, prop

theorem zmodVal.injective
  requires positive : 0 < n
  shows ∀ a ∈ Ring.carrier(zmod(n)), ∀ b ∈ Ring.carrier(zmod(n)),
    zmodVal(n, a) = zmodVal(n, b) → a = b
proof
  intros a aIn b bIn e
  have sa := zmodVal.spec at n, a with positive, aIn
  have sb := zmodVal.spec at n, b with positive, bIn
  obtain ⟨_, ea⟩ := sa
  obtain ⟨_, eb⟩ := sb
  rw e at ea
  rw ea at eb
  exact eb

-- ZMod.val_add, ZMod.val_mul: values add and multiply modulo n.
theorem zmodVal.add (a b : Set)
  requires positive : 0 < n
  requires first : a ∈ Ring.carrier(zmod(n))
  requires second : b ∈ Ring.carrier(zmod(n))
  shows zmodVal(n, call2(Ring.add(zmod(n)), a, b)) =
    integerMod(integerOfNat(zmodVal(n, a) + zmodVal(n, b)), n)
proof
  have sa := zmodVal.spec at n, a with positive, first
  have sb := zmodVal.spec at n, b with positive, second
  obtain ⟨_, ea⟩ := sa
  obtain ⟨_, eb⟩ := sb
  have va : Nat(zmodVal(n, a)) by typecheck
  have vb : Nat(zmodVal(n, b)) by typecheck
  have sum := tkJ.zmodCast.nat_add at n, zmodVal(n, a), zmodVal(n, b)
  rw [ea, eb] at sum
  rw sum
  exact zmodVal.nat_cast at n, zmodVal(n, a) + zmodVal(n, b) with positive

theorem zmodVal.mul (a b : Set)
  requires positive : 0 < n
  requires first : a ∈ Ring.carrier(zmod(n))
  requires second : b ∈ Ring.carrier(zmod(n))
  shows zmodVal(n, call2(Ring.mul(zmod(n)), a, b)) =
    integerMod(integerOfNat(zmodVal(n, a) * zmodVal(n, b)), n)
proof
  have sa := zmodVal.spec at n, a with positive, first
  have sb := zmodVal.spec at n, b with positive, second
  obtain ⟨_, ea⟩ := sa
  obtain ⟨_, eb⟩ := sb
  have va : Nat(zmodVal(n, a)) by typecheck
  have vb : Nat(zmodVal(n, b)) by typecheck
  have prod := tkJ.zmodCast.nat_mul at n, zmodVal(n, a), zmodVal(n, b)
  rw [ea, eb] at prod
  rw prod
  exact zmodVal.nat_cast at n, zmodVal(n, a) * zmodVal(n, b) with positive

-- Helpers: the lift ℤ/nℤ → R, [a] ↦ val(a) · 1, when n · 1 = 0 in R.
theorem tkJ.natCast.mod (R : Set) (m : Nat)
  requires ring : Ring(R)
  requires positive : 0 < n
  requires vanishes : natCast(R, n) = Ring.zero(R)
  shows natCast(R, m % n) = natCast(R, m)
proof
  have parts := Ring.parts with ring
  have n0 : n ≠ 0 by arith
  obtain ⟨q, qNat, eq⟩ := mod.equation at m, n with n0
  have split := tkJ.natCast.add at R, n * q, m % n with ring
  rw ← eq at split
  rw (tkJ.natCast.mul_vanish at R, n, q with ring, vanishes) at split
  have rIn := tkJ.natCast.mem at R, m % n with ring
  rw (IsRing.add_left_identity with parts, rIn) at split
  symm
  exact split

theorem tkJ.zmodLift.hom (R : Set)
  requires positive : 0 < n
  requires comm : CommRing(R)
  requires vanishes : natCast(R, n) = Ring.zero(R)
  shows tkJZmodLift(n, R) : zmod(n) →+* R
proof
  have ring := CommRing.to_ring with comm
  have basics := tkJ.zmod.comm_ring at n
  obtain ⟨zc, _, _⟩ := basics
  have fun : tkJZmodLift(n, R) : Ring.carrier(zmod(n)) → Ring.carrier(R)
    apply tkJ.fin_graph_function
    . intros u uIn
      obtain ⟨a, aIn, e⟩ := tkJZmodLift.membership.forward with uIn
      have vNat : Nat(zmodVal(n, a)) by typecheck
      have cIn := tkJ.natCast.mem at R, zmodVal(n, a) with ring
      rw ← e
      exact product.pair with aIn, cIn
    . intros x y z hy hz
      obtain ⟨a, aIn, ea⟩ := tkJZmodLift.membership.forward with hy
      obtain ⟨b, bIn, eb⟩ := tkJZmodLift.membership.forward with hz
      obtain ⟨xa, ya⟩ := orderedPair.injective with ea
      obtain ⟨xb, zb⟩ := orderedPair.injective with eb
      rw [← ya, ← zb, xa, xb]
    . intros a aIn
      have vNat : Nat(zmodVal(n, a)) by typecheck
      have cIn := tkJ.natCast.mem at R, zmodVal(n, a) with ring
      refine ⟨natCast(R, zmodVal(n, a)), cIn, ?_⟩
      apply tkJZmodLift.membership.backward
      exact ⟨a, aIn, rfl⟩
  have apply : ∀ a ∈ Ring.carrier(zmod(n)), tkJZmodLift(n, R)(a) = natCast(R, zmodVal(n, a))
    intros a aIn
    have rel : relates(tkJZmodLift(n, R), a, natCast(R, zmodVal(n, a)))
      unfold relates
      apply tkJZmodLift.membership.backward
      exact ⟨a, aIn, rfl⟩
    exact FunctionBetween.apply_value with fun, aIn, rel
  have additive : ∀ x y ∈ Ring.carrier(zmod(n)), tkJZmodLift(n, R)(x + y) = tkJZmodLift(n, R)(x) + tkJZmodLift(n, R)(y)
    intros x xIn y yIn
    have sIn : x + y ∈ Ring.carrier(zmod(n)) by typecheck
    rw [(apply with x + y, sIn), (apply with x, xIn), (apply with y, yIn)]
    rw (zmodVal.add at n, x, y with positive, xIn, yIn)
    have xv : Nat(zmodVal(n, x)) by typecheck
    have yv : Nat(zmodVal(n, y)) by typecheck
    rw (integerMod.ofNat at zmodVal(n, x) + zmodVal(n, y), n with positive)
    rw (tkJ.natCast.mod at n, R, zmodVal(n, x) + zmodVal(n, y) with ring, positive, vanishes)
    exact tkJ.natCast.add at R, zmodVal(n, x), zmodVal(n, y) with ring
  have multiplicative : ∀ x y ∈ Ring.carrier(zmod(n)), tkJZmodLift(n, R)(x * y) = tkJZmodLift(n, R)(x) * tkJZmodLift(n, R)(y)
    intros x xIn y yIn
    have sIn : x * y ∈ Ring.carrier(zmod(n)) by typecheck
    rw [(apply with x * y, sIn), (apply with x, xIn), (apply with y, yIn)]
    rw (zmodVal.mul at n, x, y with positive, xIn, yIn)
    have xv : Nat(zmodVal(n, x)) by typecheck
    have yv : Nat(zmodVal(n, y)) by typecheck
    rw (integerMod.ofNat at zmodVal(n, x) * zmodVal(n, y), n with positive)
    rw (tkJ.natCast.mod at n, R, zmodVal(n, x) * zmodVal(n, y) with ring, positive, vanishes)
    exact tkJ.natCast.mul at R, zmodVal(n, x), zmodVal(n, y) with comm
  have unital : tkJZmodLift(n, R)(Ring.one(zmod(n))) = Ring.one(R)
    have oIn : Ring.one(zmod(n)) ∈ Ring.carrier(zmod(n)) by typecheck
    rw (apply with Ring.one(zmod(n)), oIn)
    rw ← (tkJ.zmodCast.one at n)
    rw ← integerOfNat.one
    rw (zmodVal.nat_cast at n, 1 with positive)
    rw (integerMod.ofNat at 1, n with positive)
    rw (tkJ.natCast.mod at n, R, 1 with ring, positive, vanishes)
    exact tkJ.natCast.one at R with ring
  exact RingHom.mk at tkJZmodLift(n, R), zmod(n), R with zc, comm, fun, additive, multiplicative, unital

-- ZMod.charP: ZMod n has characteristic n; ZMod.ringChar_zmod_n.
theorem zmod.char
  shows CharP(zmod(n), n) ∧ ringChar(zmod(n)) = n
proof
  have basics := tkJ.zmod.comm_ring at n
  obtain ⟨zc, hom, _⟩ := basics
  have zr := CommRing.to_ring with zc
  have law : ∀ k ∈ ℕ, natCast(zmod(n), k) = Ring.zero(zmod(n)) ↔ n ∣ k
    intros k kIn
    have kNat : Nat(k) by typecheck
    rw ← (zmodCast.nat at n, k)
    exact zmodCast.nat_eq_zero_iff at n, k
  have cp : CharP(zmod(n), n)
    exact ⟨zr, law⟩
  have sel := ringChar.selected at zmod(n) with zr
  obtain ⟨cN, cc⟩ := sel
  have cNat : Nat(ringChar(zmod(n))) by typecheck
  have e := tkJ.charP.unique at zmod(n), ringChar(zmod(n)), n with cc, cp
  exact ⟨cp, e⟩

-- Helpers: every class is ±k for a natural k.
theorem tkJ.zmod.signed_rep (a : Set)
  requires member : a ∈ Ring.carrier(zmod(n))
  shows ∃ k ∈ ℕ, a = natCast(zmod(n), k) ∨
    a = apply(Ring.neg(zmod(n)), natCast(zmod(n), k))
proof
  have basics := tkJ.zmod.comm_ring at n
  obtain ⟨zc, hom, surj⟩ := basics
  obtain ⟨fun, onto⟩ := surj
  obtain ⟨x, xIn, xr⟩ := onto with a, member
  have xa := FunctionBetween.apply_value with fun, xIn, xr
  have xI : Integer(x) by settle with Integer
  obtain ⟨k, kNat, sign⟩ := Integer.signed_natural at x
  have kN : k ∈ ℕ by typecheck
  refine ⟨k, kN, ?_⟩
  cases sign with pos | neg
  . left
    rw [← xa, pos]
    exact zmodCast.nat at n, k
  . right
    rw [← xa, neg, (integerNegativeOfNat.eq_neg at k)]
    have kZ : integerOfNat(k) ∈ Ring.carrier(integerRing)
      rw tkJ.integerRing.carrier
      typecheck
    have m := RingHom.map_neg at zmodCast(n), integerRing, zmod(n), integerOfNat(k) with hom, kZ
    rw [tkJ.integerRing.neg, (integerNegValue.notation at integerOfNat(k))] at m
    rw m
    rw (zmodCast.nat at n, k)

-- Helpers: classes as natural numerals, and their equality.
theorem tkJ.zmod.nat_rep (a : Set)
  requires positive : 0 < n
  requires member : a ∈ Ring.carrier(zmod(n))
  shows a = natCast(zmod(n), zmodVal(n, a))
proof
  have sp := zmodVal.spec at n, a with positive, member
  obtain ⟨_, e⟩ := sp
  have vNat : Nat(zmodVal(n, a)) by typecheck
  rw ← (zmodCast.nat at n, zmodVal(n, a))
  symm
  exact e

theorem tkJ.zmod.natCast_eq_iff (a b : Nat)
  requires positive : 0 < n
  shows natCast(zmod(n), a) = natCast(zmod(n), b) ↔ a % n = b % n
proof
  rw [← (zmodCast.nat at n, a), ← (zmodCast.nat at n, b)]
  rw (zmodCast.nat_eq_iff at n, a, b with positive)
  rw [(integerMod.ofNat at a, n with positive), (integerMod.ofNat at b, n with positive)]

-- ZMod.isUnit_iff_coprime, ZMod.unitOfCoprime: the class of a is a unit
-- iff gcd(a, n) = 1.
theorem zmod.unit_iff_coprime (a : Set)
  requires integer : a ∈ ℤ
  shows RingUnit(zmod(n), zmodCast(n)(a)) ↔ IntegerCoprime(a, integerOfNat(n))
proof
  have basics := tkJ.zmod.comm_ring at n
  obtain ⟨zc, hom, surj⟩ := basics
  have aI : Integer(a) by settle with Integer
  have aIn := tkJ.zmod.cast_mem at n, a with integer
  have nZ : integerOfNat(n) ∈ ℤ by typecheck
  have nz : zmodCast(n)(integerOfNat(n)) = Ring.zero(zmod(n))
    exact (zmodCast.nat_eq_zero_iff at n, n).backward with (divides.reflexive at n)
  constructor
  . intro unit
    obtain ⟨_, b, bIn, ab, _⟩ := unit
    obtain ⟨fun, onto⟩ := surj
    obtain ⟨u, uIn, ur⟩ := onto with b, bIn
    have ub := FunctionBetween.apply_value with fun, uIn, ur
    have uI : Integer(u) by settle with Integer
    rw ← ub at ab
    rw ← (tkJ.zmodCast.mul at n, a, u with integer, uIn) at ab
    rw ← (tkJ.zmodCast.one at n) at ab
    have auZ : integerMulValue(a, u) ∈ ℤ by typecheck
    have oneZ : integerOne ∈ ℤ by typecheck
    have dv := (tkJ.zmodCast.eq_iff at n, integerMulValue(a, u), integerOne with auZ, oneZ).forward with ab
    obtain ⟨q, qI, qe⟩ := dv
    have bez : integerAddValue(integerMulValue(u, a), integerMulValue(q, integerOfNat(n))) = integerOne
      have t : integerAddValue(integerMulValue(u, a), integerMulValue(q, integerOfNat(n))) = integerAddValue(integerMulValue(a, u), integerMulValue(integerOfNat(n), q)) by ring
      rw [t, qe]
      ring
    exact IntegerCoprime.of_bezout at a, integerOfNat(n), u, q with bez
  . intro cop
    obtain ⟨u, uI, v, vI, e⟩ := IntegerCoprime.bezout at a, integerOfNat(n) with cop
    have uZ : u ∈ ℤ by typecheck
    have vZ : v ∈ ℤ by typecheck
    have uaZ : integerMulValue(u, a) ∈ ℤ by typecheck
    have vnZ : integerMulValue(v, integerOfNat(n)) ∈ ℤ by typecheck
    have c := tkJ.zmodCast.add at n, integerMulValue(u, a), integerMulValue(v, integerOfNat(n)) with uaZ, vnZ
    rw e at c
    rw (tkJ.zmodCast.one at n) at c
    rw [(tkJ.zmodCast.mul at n, u, a with uZ, integer), (tkJ.zmodCast.mul at n, v, integerOfNat(n) with vZ, nZ), nz] at c
    have uIn := tkJ.zmod.cast_mem at n, u with uZ
    have vIn := tkJ.zmod.cast_mem at n, v with vZ
    have prod : zmodCast(n)(a) * zmodCast(n)(u) = Ring.one(zmod(n))
      rw c
      ring
    exact RingUnit.of_product at zmod(n), zmodCast(n)(a), zmodCast(n)(u) with zc, aIn, uIn, prod

-- ZMod n is a field iff n is prime (ZMod.instField with Fact p.Prime).
theorem zmod.field_iff
  shows Field(zmod(n)) ↔ Prime(n)
proof
  have basics := tkJ.zmod.comm_ring at n
  obtain ⟨zc, _, _⟩ := basics
  have zr := CommRing.to_ring with zc
  have chZ := zmod.char at n
  obtain ⟨cz, _⟩ := chZ
  constructor
  . intro field
    have dom := Field.domain at zmod(n) with field
    by_cases n0 : n = 0
    . exfalso
      have twoN : 2 ∈ ℕ by typecheck
      have tIn := tkJ.natCast.mem at zmod(n), 2 with zr
      have tnz : natCast(zmod(n), 2) ≠ Ring.zero(zmod(n))
        intro e
        obtain ⟨_, lawZ⟩ := cz
        have d := (lawZ with 2, twoN).forward with e
        rw n0 at d
        have z := zero.divides_only_zero at 2 with d
        arith
      obtain ⟨y, yIn, ty⟩ := tkJ.field_inverse at zmod(n), natCast(zmod(n), 2) with field, tIn, tnz
      obtain ⟨k, kN, sign⟩ := tkJ.zmod.signed_rep at n, y with yIn
      have kNat : Nat(k) by typecheck
      have kIn := tkJ.natCast.mem at zmod(n), k with zr
      have m := tkJ.natCast.mul at zmod(n), 2, k with zc
      cases sign with pos | neg
      . rw pos at ty
        rw ← m at ty
        rw ← (tkJ.natCast.one at zmod(n) with zr) at ty
        rw [← (zmodCast.nat at n, 2 * k), ← (zmodCast.nat at n, 1)] at ty
        have aZ : integerOfNat(2 * k) ∈ ℤ by typecheck
        have bZ : integerOfNat(1) ∈ ℤ by typecheck
        have dv := (tkJ.zmodCast.eq_iff at n, integerOfNat(2 * k), integerOfNat(1) with aZ, bZ).forward with ty
        rw n0 at dv
        obtain ⟨q, qI, qe⟩ := dv
        rw integerOfNat.zero at qe
        have zq : integerMulValue(integerZero, q) = integerZero by ring
        rw zq at qe
        have same : integerOfNat(1) = integerOfNat(2 * k)
          have t : integerOfNat(1) = integerAddValue(integerAddValue(integerOfNat(1), integerNegValue(integerOfNat(2 * k))), integerOfNat(2 * k)) by ring
          rw ← qe at t
          rw t
          ring
        have nat := integerOfNat.injective at 1, 2 * k with same
        arith
      . rw neg at ty
        have t2 : natCast(zmod(n), 2) * natCast(zmod(n), k) + Ring.one(zmod(n)) = Ring.zero(zmod(n))
          have t3 : natCast(zmod(n), 2) * natCast(zmod(n), k) + Ring.one(zmod(n)) = Ring.one(zmod(n)) + (-(natCast(zmod(n), 2) * -natCast(zmod(n), k))) by ring
          rw t3
          rw ty
          ring
        rw ← m at t2
        rw ← (tkJ.natCast.one at zmod(n) with zr) at t2
        rw ← (tkJ.natCast.add at zmod(n), 2 * k, 1 with zr) at t2
        obtain ⟨_, lawZ⟩ := cz
        have sN : 2 * k + 1 ∈ ℕ by typecheck
        have d := (lawZ with 2 * k + 1, sN).forward with t2
        rw n0 at d
        have z := zero.divides_only_zero at 2 * k + 1 with d
        arith
    . exact tkJ.charP.prime at zmod(n), n with dom, cz, n0
  . intro prime
    have gt := Prime.greater_than_one at n with prime
    have positive : 0 < n by arith
    have n0 : n ≠ 0 by arith
    obtain ⟨_, lawZ⟩ := cz
    have oneIs := tkJ.natCast.one at zmod(n) with zr
    have nt : Ring.zero(zmod(n)) ≠ Ring.one(zmod(n))
      intro e
      symm at e
      rw ← oneIs at e
      have oneN : 1 ∈ ℕ by typecheck
      have d := (lawZ with 1, oneN).forward with e
      have le := divides.le at n, 1 with d, (one.ne_zero)
      arith
    have inverses : ∀ x ∈ Ring.carrier(zmod(n)), x ≠ Ring.zero(zmod(n)) → (∃ y ∈ Ring.carrier(zmod(n)), call2(Ring.mul(zmod(n)), x, y) = Ring.one(zmod(n)))
      intros x xIn xnz
      have rep := tkJ.zmod.nat_rep at n, x with positive, xIn
      have vNat : Nat(zmodVal(n, x)) by typecheck
      have vN : zmodVal(n, x) ∈ ℕ by typecheck
      have nd : ¬(n ∣ zmodVal(n, x))
        intro d
        have z := (lawZ with zmodVal(n, x), vN).backward with d
        rw ← rep at z
        exact xnz with z
      have cert := Prime.coprime_of_not_divides with prime, nd
      have g := gcd.unique with cert
      rw (gcd.commutative at n, zmodVal(n, x)) at g
      obtain ⟨b, bNat, bLt, bMod⟩ := coprime.inverse at zmodVal(n, x), n with gt, g
      have bIn := tkJ.natCast.mem at zmod(n), b with zr
      refine ⟨natCast(zmod(n), b), bIn, ?_⟩
      rw rep
      rw ← (tkJ.natCast.mul at zmod(n), zmodVal(n, x), b with zc)
      rw ← oneIs
      rw (tkJ.zmod.natCast_eq_iff at n, zmodVal(n, x) * b, 1 with positive)
      rw bMod
      symm
      exact mod.of_less at n, 1 with gt
    exact tkJ.field_of_inverses at zmod(n) with zc, nt, inverses

-- RingHom.ext_zmod, ZMod.castHom: there is exactly one ring homomorphism
-- ZMod n → R when R has characteristic dividing n (here, CharP R n).
theorem zmod.hom_unique (R f g : Set)
  requires first : f : zmod(n) →+* R
  requires second : g : zmod(n) →+* R
  shows f = g
proof
  obtain ⟨_, _, fFun, _⟩ := first
  obtain ⟨_, _, gFun, _⟩ := second
  have same : ∀ a ∈ Ring.carrier(zmod(n)), f(a) = g(a)
    intros a aIn
    obtain ⟨k, kN, sign⟩ := tkJ.zmod.signed_rep at n, a with aIn
    have kNat : Nat(k) by typecheck
    have fk := tkJ.hom_natCast at f, zmod(n), R, k with first
    have gk := tkJ.hom_natCast at g, zmod(n), R, k with second
    cases sign with pos | neg
    . rw [pos, fk, gk]
    . have zr := RingHom.source with first
      have kIn := tkJ.natCast.mem at zmod(n), k with zr
      rw neg
      rw [(RingHom.map_neg at f, zmod(n), R, natCast(zmod(n), k) with first, kIn), (RingHom.map_neg at g, zmod(n), R, natCast(zmod(n), k) with second, kIn)]
      rw [fk, gk]
  exact FunctionBetween.ext with fFun, gFun, same

theorem zmod.cast_hom_exists (R d : Set)
  requires char : CharP(R, d)
  requires divides : d ∣ n
  shows ∃ f, f : zmod(n) →+* R
proof
  sorry

-- ZMod.castHom_injective: the map ZMod n → R is injective in
-- characteristic n.
theorem zmod.cast_hom_injective (R f : Set)
  requires char : CharP(R, n)
  requires hom : f : zmod(n) →+* R
  shows InjectiveBetween(f, Ring.carrier(zmod(n)), Ring.carrier(R))
proof
  have basics := tkJ.zmod.comm_ring at n
  obtain ⟨zc, _, _⟩ := basics
  have zr := CommRing.to_ring with zc
  have ringR := RingHom.target with hom
  have chZ := zmod.char at n
  obtain ⟨cz, _⟩ := chZ
  obtain ⟨_, lawZ⟩ := cz
  obtain ⟨_, lawR⟩ := char
  -- a class killed by f is zero
  have kernel : ∀ c ∈ Ring.carrier(zmod(n)), f(c) = Ring.zero(R) → f(-c) = Ring.zero(R) → c = Ring.zero(zmod(n))
    intros c cIn fc fnc
    obtain ⟨k, kN, sign⟩ := tkJ.zmod.signed_rep at n, c with cIn
    have kNat : Nat(k) by typecheck
    have fk := tkJ.hom_natCast at f, zmod(n), R, k with hom
    have kIn := tkJ.natCast.mem at zmod(n), k with zr
    cases sign with pos | neg
    . rw pos at fc
      rw fk at fc
      have d := (lawR with k, kN).forward with fc
      rw pos
      exact (lawZ with k, kN).backward with d
    . have nc : -c = natCast(zmod(n), k)
        rw neg
        ring
      rw nc at fnc
      rw fk at fnc
      have d := (lawR with k, kN).forward with fnc
      have z := (lawZ with k, kN).backward with d
      rw neg
      rw z
      ring
  obtain ⟨_, _, fFun, _⟩ := hom
  refine ⟨fFun, ?_⟩
  intros a aIn b bIn z zIn ra rb
  have fa := FunctionBetween.apply_value with fFun, aIn, ra
  have fb := FunctionBetween.apply_value with fFun, bIn, rb
  have ab : a - b ∈ Ring.carrier(zmod(n)) by typecheck
  have nab : -(a - b) ∈ Ring.carrier(zmod(n)) by typecheck
  have s1 := RingHom.map_sub at f, zmod(n), R, a, b with hom, aIn, bIn
  have s2 := RingHom.map_neg at f, zmod(n), R, a - b with hom, ab
  rw [fa, fb] at s1
  have zIn2 : z ∈ Ring.carrier(R) by assumption
  have parts := Ring.parts with ringR
  have szz : Ring.sub(R, z, z) = Ring.zero(R)
    rw (Ring.sub.value at R, z, z with ringR, zIn2, zIn2)
    exact IsRing.add_inverse_right with parts, zIn2
  rw szz at s1
  rw s1 at s2
  have nz : apply(Ring.neg(R), Ring.zero(R)) = Ring.zero(R)
    have zIn3 : Ring.zero(R) ∈ Ring.carrier(R) by typecheck
    have nIn3 : apply(Ring.neg(R), Ring.zero(R)) ∈ Ring.carrier(R) by typecheck
    have inv := IsRing.add_inverse_right with parts, zIn3
    rw (IsRing.add_left_identity with parts, nIn3) at inv
    exact inv
  rw nz at s2
  have k := kernel with a - b, ab, s1, s2
  have final : a = (a - b) + b by ring
  rw k at final
  rw final
  ring

-- ZMod.pow_card (Fermat): x^p = x in ZMod p.
theorem zmod.pow_card (x : Set)
  requires prime : Prime(n)
  requires member : x ∈ Ring.carrier(zmod(n))
  shows Ring.pow(zmod(n), x, n) = x
proof
  have basics := tkJ.zmod.comm_ring at n
  obtain ⟨zc, _, _⟩ := basics
  have gt := Prime.greater_than_one at n with prime
  have positive : 0 < n by arith
  have n0 : n ≠ 0 by arith
  have rep := tkJ.zmod.nat_rep at n, x with positive, member
  have vNat : Nat(zmodVal(n, x)) by typecheck
  have core : Ring.pow(zmod(n), natCast(zmod(n), zmodVal(n, x)), n) = natCast(zmod(n), zmodVal(n, x))
    rw (tkJ.natCast.pow at zmod(n), zmodVal(n, x), n with zc)
    rw (tkJ.zmod.natCast_eq_iff at n, zmodVal(n, x) ^ n, zmodVal(n, x) with positive)
    have one : 1 ≤ n by arith
    have shift0 := sub.add_cancel at n, 1 with one
    have shift : n = (n - 1) + 1
      symm
      exact shift0
    have split : zmodVal(n, x) ^ n = zmodVal(n, x) ^ (n - 1) * zmodVal(n, x)
      have ps := pow.succ_right at zmodVal(n, x), n - 1
      rw ← shift at ps
      exact ps
    rw split
    by_cases d : n ∣ zmodVal(n, x)
    . have z1 := (mod.zero_iff at n, zmodVal(n, x) with n0).backward with d
      have d2 : n ∣ zmodVal(n, x) ^ (n - 1) * zmodVal(n, x)
        have m := divides.multiply_left at n, zmodVal(n, x), zmodVal(n, x) ^ (n - 1) with d
        exact m
      have z2 := (mod.zero_iff at n, zmodVal(n, x) ^ (n - 1) * zmodVal(n, x) with n0).backward with d2
      rw [z1, z2]
    . have f := fermat.little at zmodVal(n, x), n with prime, d
      rw (mod.mul at n, zmodVal(n, x) ^ (n - 1), zmodVal(n, x) with n0)
      rw f
      rw mul.left_unit
      exact mod.mod at n, zmodVal(n, x) with n0
  rw ← rep at core
  exact core

-- ZMod.isCyclic_units_prime, ZMod.isCyclic_units_of_prime_pow: (ℤ/p^k)ˣ
-- is cyclic for p an odd prime.
theorem zmod.units_cyclic_prime_pow (p k : Nat)
  requires prime : Prime(p)
  requires odd : p ≠ 2
  requires positive : 0 < k
  shows CyclicGroup(unitGroup(zmod(p ^ k)))
proof
  sorry

-- ZMod.neg_one_ne_one: −1 ≠ 1 in ZMod n for n > 2.
theorem zmod.neg_one_ne_one
  requires large : 2 < n
  shows apply(Ring.neg(zmod(n)), Ring.one(zmod(n))) ≠ Ring.one(zmod(n))
proof
  have basics := tkJ.zmod.comm_ring at n
  obtain ⟨zc, _, _⟩ := basics
  have zr := CommRing.to_ring with zc
  have chZ := zmod.char at n
  obtain ⟨cz, _⟩ := chZ
  obtain ⟨_, lawZ⟩ := cz
  intro e
  have two := tkJ.natCast.add at zmod(n), 1, 1 with zr
  rw (tkJ.natCast.one at zmod(n) with zr) at two
  have sum : call2(Ring.add(zmod(n)), Ring.one(zmod(n)), Ring.one(zmod(n))) = Ring.zero(zmod(n))
    have t : Ring.one(zmod(n)) + Ring.one(zmod(n)) = Ring.one(zmod(n)) + (-Ring.one(zmod(n))) by rw e
    rw t
    ring
  rw sum at two
  have twoN : 2 ∈ ℕ by typecheck
  have d := (lawZ with 2, twoN).forward with two
  have nz : 2 ≠ 0 by arith
  have le := divides.le at n, 2 with d, nz
  arith

-- ZMod.exists_sq_eq_neg_one_iff: −1 is a square mod a prime p iff
-- p mod 4 ≠ 3.
theorem zmod.exists_sq_eq_neg_one_iff (p : Nat)
  requires prime : Prime(p)
  shows (∃ y ∈ Ring.carrier(zmod(p)), call2(Ring.mul(zmod(p)), y, y) =
      apply(Ring.neg(zmod(p)), Ring.one(zmod(p)))) ↔
    integerMod(integerOfNat(p), 4) ≠ 3
proof
  sorry

end ZModLaws

-- Section: Characteristic
section Characteristic
variable (R : Set)
hypothesis comm : CommRing(R)

-- CharP.cast_eq_zero, CharP.cast_eq_zero_iff.
theorem CharP.cast_eq_zero (p : Nat)
  requires char : CharP(R, p)
  shows natCast(R, p) = Ring.zero(R)
proof
  obtain ⟨_, law⟩ := char
  have pN : p ∈ ℕ by typecheck
  exact (law with p, pN).backward with (divides.reflexive at p)

-- CharP.eq, ringChar.spec, ringChar.eq_iff, ringChar.dvd.
theorem CharP.unique (p q : Nat)
  requires first : CharP(R, p)
  requires second : CharP(R, q)
  shows p = q
proof
  exact tkJ.charP.unique at R, p, q with first, second

theorem ringChar.spec
  shows CharP(R, ringChar(R))
proof
  have ring := CommRing.to_ring with comm
  have sel := ringChar.selected at R with ring
  exact sel.right

theorem ringChar.eq_iff (p : Nat)
  shows ringChar(R) = p ↔ CharP(R, p)
proof
  have ring := CommRing.to_ring with comm
  have sel := ringChar.selected at R with ring
  obtain ⟨cN, cc⟩ := sel
  have cNat : Nat(ringChar(R)) by typecheck
  constructor
  . intro e
    rw ← e
    exact cc
  . intro h
    exact tkJ.charP.unique at R, ringChar(R), p with cc, h

theorem ringChar.dvd (n : Nat)
  requires vanishes : natCast(R, n) = Ring.zero(R)
  shows ringChar(R) ∣ n
proof
  have ring := CommRing.to_ring with comm
  have sel := ringChar.selected at R with ring
  obtain ⟨cN, cc⟩ := sel
  obtain ⟨_, law⟩ := cc
  have nN : n ∈ ℕ by typecheck
  exact (law with n, nN).forward with vanishes

-- CharP.char_is_prime_or_zero, CharP.prime_ringChar: a domain has
-- characteristic 0 or a prime; a finite field has prime characteristic.
theorem CharP.prime_or_zero (p : Nat)
  requires domain : IntegralDomain(R)
  requires char : CharP(R, p)
  shows Prime(p) ∨ p = 0
proof
  by_cases p0 : p = 0
  . right
    exact p0
  . left
    exact tkJ.charP.prime at R, p with domain, char, p0

theorem FiniteField.char_prime
  requires finite : FiniteField(R)
  shows Prime(ringChar(R)) ∧ CharP(R, ringChar(R))
proof
  obtain ⟨field, fin⟩ := finite
  have dom := Field.domain at R with field
  have spec := ringChar.spec at R with comm
  have cNat : Nat(ringChar(R)) by typecheck
  by_cases c0 : ringChar(R) = 0
  . exfalso
    rw c0 at spec
    have inf := tkJ.charP.zero_infinite at R with comm, spec
    exact inf with fin
  . have pr := tkJ.charP.prime at R, ringChar(R) with dom, spec, c0
    exact ⟨pr, spec⟩

-- CharP.charP_iff_prime_eq_zero: in a domain, CharP R p for a prime p
-- iff p · 1 = 0.
theorem CharP.iff_prime_eq_zero (p : Nat)
  requires domain : IntegralDomain(R)
  requires prime : Prime(p)
  shows CharP(R, p) ↔ natCast(R, p) = Ring.zero(R)
proof
  constructor
  . intro h
    exact CharP.cast_eq_zero at R, p with comm, h
  . intro h
    have spec := ringChar.spec at R with comm
    have cNat : Nat(ringChar(R)) by typecheck
    have dvd := ringChar.dvd at R, p with comm, h
    have pNat : Nat(p) by typecheck
    obtain ⟨_, nt, _⟩ := domain
    have ring := CommRing.to_ring with comm
    have c1 : ringChar(R) ≠ 1
      intro e
      rw e at spec
      have one := CharP.cast_eq_zero at R, 1 with comm, spec
      rw (tkJ.natCast.one at R with ring) at one
      symm at one
      exact nt with one
    have pPos := Prime.greater_than_one at p with prime
    have p0 : p ≠ 0 by arith
    have cle := divides.le at ringChar(R), p with dvd, p0
    by_cases same : ringChar(R) = p
    . rw ← same
      exact spec
    . exfalso
      have lt : ringChar(R) < p by arith
      have cIn := membership.of_Less at ringChar(R), p with *, lt
      have one := Prime.divisor at p, ringChar(R) with prime, cNat, cIn, dvd
      exact c1 with one

-- CharP.of_ringHom_of_ne_zero, charP_of_injective_ringHom: an injective
-- ring homomorphism, or any homomorphism from a field into a nonzero
-- ring, transports the characteristic.
theorem CharP.of_injective_hom (S f : Set) (p : Nat)
  requires char : CharP(R, p)
  requires hom : f : R →+* S
  requires injective : InjectiveBetween(f, Ring.carrier(R), Ring.carrier(S))
  shows CharP(S, p)
proof
  have ringR := RingHom.source with hom
  have ringS := RingHom.target with hom
  obtain ⟨_, law⟩ := char
  have law2 : ∀ n ∈ ℕ, natCast(S, n) = Ring.zero(S) ↔ p ∣ n
    intros n nIn
    have nNat : Nat(n) by typecheck
    rw ← (tkJ.hom_natCast at f, R, S, n with hom)
    rw ← (law with n, nIn)
    have z := RingHom.map_zero with hom
    have nCIn := tkJ.natCast.mem at R, n with ringR
    have zIn : Ring.zero(R) ∈ Ring.carrier(R) by typecheck
    constructor
    . intro e
      rw ← z at e
      exact tkJ.injective_apply with injective, nCIn, zIn, e
    . intro e
      rw [e, z]
  exact ⟨ringS, law2⟩

-- CharP.isUnit_natCast_iff: n · 1 is a unit in characteristic p prime
-- iff p ∤ n; CharP.cast_ne_zero_of_ne_of_prime.
theorem CharP.unit_natCast_iff (p n : Nat)
  requires field : Field(R)
  requires char : CharP(R, p)
  requires prime : Prime(p)
  shows RingUnit(R, natCast(R, n)) ↔ ¬(p ∣ n)
proof
  have ring := CommRing.to_ring with comm
  have nIn := tkJ.natCast.mem at R, n with ring
  rw (Field.unit_iff at R, natCast(R, n) with field, nIn)
  obtain ⟨_, law⟩ := char
  have nN : n ∈ ℕ by typecheck
  have l := law with n, nN
  constructor
  . intro h
    intro d
    exact h with (l.backward with d)
  . intro h
    intro e
    exact h with (l.forward with e)

-- CharP.quotient: R/I has characteristic p when R does and I is a
-- proper ideal of a ring of prime characteristic.
theorem CharP.quotient (I : Set) (p : Nat)
  requires char : CharP(R, p)
  requires prime : Prime(p)
  requires ideal : Ideal(R, I)
  requires proper : Ring.one(R) ∉ I
  shows CharP(quotientRing(R, I), p)
proof
  have ring := CommRing.to_ring with comm
  have qc := quotientRing.comm_ring_of_ideal at R, I with comm, ideal
  have qr := CommRing.to_ring with qc
  have hom := quotientMk.hom at R, I with comm, ideal
  obtain ⟨_, law⟩ := char
  have law2 : ∀ n ∈ ℕ, natCast(quotientRing(R, I), n) = Ring.zero(quotientRing(R, I)) ↔ p ∣ n
    intros n nN
    have nNat : Nat(n) by typecheck
    have nIn := tkJ.natCast.mem at R, n with ring
    rw ← (tkJ.hom_natCast at quotientMk(R, I), R, quotientRing(R, I), n with hom)
    rw (quotientMk.eq_zero_iff at R, I, natCast(R, n) with comm, ideal, nIn)
    constructor
    . intro mem
      by_contra nd
      have pNat : Nat(p) by typecheck
      have cert := Prime.coprime_of_not_divides with prime, nd
      have g := gcd.unique with cert
      rw (gcd.commutative at p, n) at g
      have gt := Prime.greater_than_one at p with prime
      obtain ⟨b, bNat, bLt, bMod⟩ := coprime.inverse at n, p with gt, g
      have p0 : p ≠ 0 by arith
      obtain ⟨q, qNat, eq⟩ := mod.equation at n * b, p with p0
      rw bMod at eq
      have m := tkJ.natCast.mul at R, n, b with comm
      have bIn := tkJ.natCast.mem at R, b with ring
      have prodI : call2(Ring.mul(R), natCast(R, n), natCast(R, b)) ∈ I := Ideal.mul_right_mem at R, I, natCast(R, b), natCast(R, n) with ring, ideal, bIn, mem
      rw ← m at prodI
      rw eq at prodI
      rw (tkJ.natCast.add at R, p * q, 1 with ring) at prodI
      have pz := (law with p, (Prime.natural at p with prime)).backward with (divides.reflexive at p)
      rw (tkJ.natCast.mul_vanish at R, p, q with ring, pz) at prodI
      rw (tkJ.natCast.one at R with ring) at prodI
      have oneIn : Ring.one(R) ∈ Ring.carrier(R) by typecheck
      have parts := Ring.parts with ring
      rw (IsRing.add_left_identity with parts, oneIn) at prodI
      exact proper with prodI
    . intro d
      have z := (law with n, nN).backward with d
      rw z
      exact Ideal.zero_mem at R, I with ideal
  exact ⟨qr, law2⟩

-- add_pow_char, sub_pow_char, add_pow_char_pow, sub_pow_char_pow:
-- (x ± y)^(p^n) = x^(p^n) ± y^(p^n) in characteristic p prime
-- (add_pow_prime_pow_eq in its consequence).
theorem CharP.add_pow (p n : Nat) (x y : Set)
  requires char : CharP(R, p)
  requires prime : Prime(p)
  requires first : x ∈ Ring.carrier(R)
  requires second : y ∈ Ring.carrier(R)
  shows Ring.pow(R, call2(Ring.add(R), x, y), p ^ n) =
    call2(Ring.add(R), Ring.pow(R, x, p ^ n), Ring.pow(R, y, p ^ n))
proof
  have ring := CommRing.to_ring with comm
  have vanishes := CharP.cast_eq_zero at R, p with comm, char
  induction n
  | zero =>
    rw pow.zero
    have sIn : call2(Ring.add(R), x, y) ∈ Ring.carrier(R) by typecheck
    rw [(Ring.pow_one at R, call2(Ring.add(R), x, y) with ring, sIn), (Ring.pow_one at R, x with ring, first), (Ring.pow_one at R, y with ring, second)]
  | succ(k) using ih =>
    have shift := add.right_one at k with *
    rw ← shift
    rw (pow.succ_right at p, k)
    have sIn : call2(Ring.add(R), x, y) ∈ Ring.carrier(R) by typecheck
    rw [(Ring.pow_mul at R, call2(Ring.add(R), x, y), p ^ k, p with ring, sIn), (Ring.pow_mul at R, x, p ^ k, p with ring, first), (Ring.pow_mul at R, y, p ^ k, p with ring, second)]
    rw ih
    have xk : Ring.pow(R, x, p ^ k) ∈ Ring.carrier(R) by typecheck
    have yk : Ring.pow(R, y, p ^ k) ∈ Ring.carrier(R) by typecheck
    exact tkJ.binom.freshman at R, Ring.pow(R, x, p ^ k), Ring.pow(R, y, p ^ k), p with comm, xk, yk, prime, vanishes

theorem CharP.sub_pow (p n : Nat) (x y : Set)
  requires char : CharP(R, p)
  requires prime : Prime(p)
  requires first : x ∈ Ring.carrier(R)
  requires second : y ∈ Ring.carrier(R)
  shows Ring.pow(R, Ring.sub(R, x, y), p ^ n) =
    Ring.sub(R, Ring.pow(R, x, p ^ n), Ring.pow(R, y, p ^ n))
proof
  have ring := CommRing.to_ring with comm
  have dIn : Ring.sub(R, x, y) ∈ Ring.carrier(R) by typecheck
  have e := CharP.add_pow at R, p, n, Ring.sub(R, x, y), y with comm, char, prime, dIn, second
  have back : call2(Ring.add(R), Ring.sub(R, x, y), y) = x by ring
  rw back at e
  have dq : Ring.pow(R, Ring.sub(R, x, y), p ^ n) ∈ Ring.carrier(R) by typecheck
  have yq : Ring.pow(R, y, p ^ n) ∈ Ring.carrier(R) by typecheck
  rw e
  ring

-- frobenius is a ring homomorphism (frobenius_def, RingHom frobenius),
-- iterated n times it is iterateFrobenius (iterate_frobenius,
-- iterateFrobenius_def), and it commutes with ring homomorphisms
-- (RingHom.iterateFrobenius_comm).
theorem frobenius.hom (p : Nat)
  requires char : CharP(R, p)
  requires prime : Prime(p)
  shows (frobenius(R, p) : R →+* R) ∧ (∀ n ∈ ℕ, iterateFrobenius(R, p, n) : R →+* R)
proof
  have ring := CommRing.to_ring with comm
  have it : ∀ n ∈ ℕ, iterateFrobenius(R, p, n) : R →+* R
    intros n nIn
    have nNat : Nat(n) by typecheck
    have fun := tkJ.iterateFrobenius.function at R, p, n with ring
    have additive : ∀ x y ∈ Ring.carrier(R), iterateFrobenius(R, p, n)(x + y) = iterateFrobenius(R, p, n)(x) + iterateFrobenius(R, p, n)(y)
      intros x xIn y yIn
      have sIn : x + y ∈ Ring.carrier(R) by typecheck
      rw [(tkJ.iterateFrobenius.apply at R, p, n, x + y with ring, sIn), (tkJ.iterateFrobenius.apply at R, p, n, x with ring, xIn), (tkJ.iterateFrobenius.apply at R, p, n, y with ring, yIn)]
      exact CharP.add_pow at R, p, n, x, y with comm, char, prime, xIn, yIn
    have multiplicative : ∀ x y ∈ Ring.carrier(R), iterateFrobenius(R, p, n)(x * y) = iterateFrobenius(R, p, n)(x) * iterateFrobenius(R, p, n)(y)
      intros x xIn y yIn
      have sIn : x * y ∈ Ring.carrier(R) by typecheck
      rw [(tkJ.iterateFrobenius.apply at R, p, n, x * y with ring, sIn), (tkJ.iterateFrobenius.apply at R, p, n, x with ring, xIn), (tkJ.iterateFrobenius.apply at R, p, n, y with ring, yIn)]
      exact Ring.mul_pow_comm at R, x, y, p ^ n with comm, xIn, yIn
    have unital : iterateFrobenius(R, p, n)(Ring.one(R)) = Ring.one(R)
      have oIn : Ring.one(R) ∈ Ring.carrier(R) by typecheck
      rw (tkJ.iterateFrobenius.apply at R, p, n, Ring.one(R) with ring, oIn)
      exact Ring.one_pow at R, p ^ n with ring
    exact RingHom.mk at iterateFrobenius(R, p, n), R, R with comm, comm, fun, additive, multiplicative, unital
  have fun := tkJ.frobenius.function at R, p with ring
  have additive : ∀ x y ∈ Ring.carrier(R), frobenius(R, p)(x + y) = frobenius(R, p)(x) + frobenius(R, p)(y)
    intros x xIn y yIn
    have sIn : x + y ∈ Ring.carrier(R) by typecheck
    rw [(tkJ.frobenius.apply at R, p, x + y with ring, sIn), (tkJ.frobenius.apply at R, p, x with ring, xIn), (tkJ.frobenius.apply at R, p, y with ring, yIn)]
    have e := CharP.add_pow at R, p, 1, x, y with comm, char, prime, xIn, yIn
    rw pow.one_right at e
    exact e
  have multiplicative : ∀ x y ∈ Ring.carrier(R), frobenius(R, p)(x * y) = frobenius(R, p)(x) * frobenius(R, p)(y)
    intros x xIn y yIn
    have sIn : x * y ∈ Ring.carrier(R) by typecheck
    rw [(tkJ.frobenius.apply at R, p, x * y with ring, sIn), (tkJ.frobenius.apply at R, p, x with ring, xIn), (tkJ.frobenius.apply at R, p, y with ring, yIn)]
    exact Ring.mul_pow_comm at R, x, y, p with comm, xIn, yIn
  have unital : frobenius(R, p)(Ring.one(R)) = Ring.one(R)
    have oIn : Ring.one(R) ∈ Ring.carrier(R) by typecheck
    rw (tkJ.frobenius.apply at R, p, Ring.one(R) with ring, oIn)
    exact Ring.one_pow at R, p with ring
  have h := RingHom.mk at frobenius(R, p), R, R with comm, comm, fun, additive, multiplicative, unital
  exact ⟨h, it⟩

-- sum_pow_char_pow: (Σ xᵢ)^(p^n) = Σ xᵢ^(p^n) over a finite index set.
theorem CharP.sum_pow (V w : Set) (p n : Nat)
  requires char : CharP(R, p)
  requires prime : Prime(p)
  requires finite : Finite(V)
  requires family : w : V → Ring.carrier(R)
  shows Ring.pow(R, finiteRingSum(V, Ring.carrier(R), Ring.add(R), Ring.zero(R),
      Ring.neg(R), Ring.mul(R), Ring.one(R), w), p ^ n) =
    finiteRingSum(V, Ring.carrier(R), Ring.add(R), Ring.zero(R), Ring.neg(R),
      Ring.mul(R), Ring.one(R), familyPow(R, V, w, p ^ n))
proof
  have ring := CommRing.to_ring with comm
  have parts := CommRing.parts with comm
  have homs := frobenius.hom at R, p with comm, char, prime
  obtain ⟨_, its⟩ := homs
  have nN : n ∈ ℕ by typecheck
  have h := its with n, nN
  have hp := RingHom.parts with h
  have fam := tkJ.familyPow.function at R, V, w, p ^ n with ring, family
  have entries : ∀ i ∈ V, familyPow(R, V, w, p ^ n)(i) = iterateFrobenius(R, p, n)(w(i))
    intros i iIn
    have wi := FunctionBetween.apply_closed with family, iIn
    rw (tkJ.familyPow.apply at R, V, w, i, p ^ n with ring, family, iIn)
    rw (tkJ.iterateFrobenius.apply at R, p, n, w(i) with ring, wi)
  have m := finiteRingSum.map at Ring.carrier(R), Ring.add(R), Ring.zero(R), Ring.neg(R), Ring.mul(R), Ring.one(R), Ring.carrier(R), Ring.add(R), Ring.zero(R), Ring.neg(R), Ring.mul(R), Ring.one(R), iterateFrobenius(R, p, n), V, w, familyPow(R, V, w, p ^ n) with parts, parts, hp, finite, family, fam, entries
  have sIn := finiteRingSum.closed at V, Ring.carrier(R), Ring.add(R), Ring.zero(R), Ring.neg(R), Ring.mul(R), Ring.one(R), w with parts, finite, family
  rw (tkJ.iterateFrobenius.apply at R, p, n, finiteRingSum(V, Ring.carrier(R), Ring.add(R), Ring.zero(R), Ring.neg(R), Ring.mul(R), Ring.one(R), w) with ring, sIn) at m
  exact m

theorem frobenius.apply (p : Nat) (x : Set)
  requires member : x ∈ Ring.carrier(R)
  shows frobenius(R, p)(x) = Ring.pow(R, x, p)
proof
  have ring := CommRing.to_ring with comm
  exact tkJ.frobenius.apply at R, p, x with ring, member

theorem iterateFrobenius.apply (p n : Nat) (x : Set)
  requires member : x ∈ Ring.carrier(R)
  shows iterateFrobenius(R, p, n)(x) = Ring.pow(R, x, p ^ n)
proof
  have ring := CommRing.to_ring with comm
  exact tkJ.iterateFrobenius.apply at R, p, n, x with ring, member

theorem iterateFrobenius.comm (S f : Set) (p n : Nat) (x : Set)
  requires hom : f : R →+* S
  requires member : x ∈ Ring.carrier(R)
  shows f(iterateFrobenius(R, p, n)(x)) = iterateFrobenius(S, p, n)(f(x))
proof
  have ring := CommRing.to_ring with comm
  have ringS := RingHom.target with hom
  have fxIn : f(x) ∈ Ring.carrier(S) := RingHom.map_mem with hom, member
  rw (tkJ.iterateFrobenius.apply at R, p, n, x with ring, member)
  rw (tkJ.iterateFrobenius.apply at S, p, n, f(x) with ringS, fxIn)
  exact tkJ.hom_pow at f, R, S, x, p ^ n with hom, member

-- The Frobenius of a reduced ring is injective; a finite field, and
-- more generally a finite reduced ring, is perfect (bijective_frobenius,
-- PerfectRing of a finite field).
theorem FiniteField.perfect (p : Nat)
  requires finite : FiniteField(R)
  requires char : CharP(R, p)
  shows PerfectRing(R, p)
proof
  have ring := CommRing.to_ring with comm
  have cp := FiniteField.char_prime at R with comm, finite
  obtain ⟨pr, spec⟩ := cp
  have cNat : Nat(ringChar(R)) by typecheck
  have same := tkJ.charP.unique at R, ringChar(R), p with spec, char
  rw same at pr
  obtain ⟨field, fin⟩ := finite
  have dom := Field.domain at R with field
  have fun := tkJ.frobenius.function at R, p with ring
  have inj : InjectiveBetween(frobenius(R, p), Ring.carrier(R), Ring.carrier(R))
    refine ⟨fun, ?_⟩
    intros x xIn y yIn z zIn rx ry
    have fx := FunctionBetween.apply_value with fun, xIn, rx
    have fy := FunctionBetween.apply_value with fun, yIn, ry
    rw (tkJ.frobenius.apply at R, p, x with ring, xIn) at fx
    rw (tkJ.frobenius.apply at R, p, y with ring, yIn) at fy
    have sp := CharP.sub_pow at R, p, 1, x, y with comm, char, pr, xIn, yIn
    rw pow.one_right at sp
    rw [fx, fy] at sp
    have zz : Ring.sub(R, z, z) = Ring.zero(R) by ring
    rw zz at sp
    have dIn : Ring.sub(R, x, y) ∈ Ring.carrier(R) by typecheck
    have d0 := tkJ.domain.pow_eq_zero at R, Ring.sub(R, x, y), p with dom, dIn
    have d1 := d0 with sp
    have t : x = Ring.sub(R, x, y) + y by ring
    rw d1 at t
    rw t
    ring
  have surj := tkJ.finite_injective_onto with fin, inj
  exact ⟨char, inj, surj⟩

-- frobeniusEquiv_symm_apply_frobenius and its converse: the inverse
-- Frobenius of a perfect ring.
theorem PerfectRing.inverse (p : Nat) (x : Set)
  requires perfect : PerfectRing(R, p)
  requires member : x ∈ Ring.carrier(R)
  shows frobeniusInverse(R, p)(x) ∈ Ring.carrier(R) ∧
    Ring.pow(R, frobeniusInverse(R, p)(x), p) = x ∧
    frobeniusInverse(R, p)(Ring.pow(R, x, p)) = x
proof
  have ring := CommRing.to_ring with comm
  obtain ⟨_, bij⟩ := perfect
  have inv := converse.function_of_bijective with bij
  have mem := FunctionBetween.apply_closed with inv, member
  unfold frobeniusInverse
  have back := Bijective.apply_inverse with bij, member
  rw (tkJ.frobenius.apply at R, p, converse(frobenius(R, p), Ring.carrier(R), Ring.carrier(R))(x) with ring, mem) at back
  have fwd := Bijective.inverse_apply with bij, member
  rw (tkJ.frobenius.apply at R, p, x with ring, member) at fwd
  exact ⟨mem, back, fwd⟩

end Characteristic

-- Helpers: x^(q−1) = 1 in a finite field, by comparing the product of
-- the nonzero elements with the product of their multiples by x.
def tkJMulMap (K a V : Set) : Set := { (y, call2(Ring.mul(K), a, y)) | y ∈ V }

def tkJConstMap (V c : Set) : Set := { (y, c) | y ∈ V }

theorem tkJ.mulMap.function (K a V : Set)
  requires ring : Ring(K)
  requires member : a ∈ Ring.carrier(K)
  requires subset : V ⊆ Ring.carrier(K)
  shows tkJMulMap(K, a, V) : V → Ring.carrier(K)
proof
  apply tkJ.fin_graph_function
  . intros u uIn
    obtain ⟨y, yIn, e⟩ := tkJMulMap.membership.forward with uIn
    have yK := subset with y, yIn
    have mIn : call2(Ring.mul(K), a, y) ∈ Ring.carrier(K) by typecheck
    rw ← e
    exact product.pair with yIn, mIn
  . intros x y z hy hz
    obtain ⟨a1, aIn1, ea⟩ := tkJMulMap.membership.forward with hy
    obtain ⟨b, bIn, eb⟩ := tkJMulMap.membership.forward with hz
    obtain ⟨xa, ya⟩ := orderedPair.injective with ea
    obtain ⟨xb, zb⟩ := orderedPair.injective with eb
    rw [← ya, ← zb, xa, xb]
  . intros y yIn
    have yK := subset with y, yIn
    have mIn : call2(Ring.mul(K), a, y) ∈ Ring.carrier(K) by typecheck
    refine ⟨call2(Ring.mul(K), a, y), mIn, ?_⟩
    apply tkJMulMap.membership.backward
    exact ⟨y, yIn, rfl⟩

theorem tkJ.mulMap.apply (K a V y : Set)
  requires ring : Ring(K)
  requires member : a ∈ Ring.carrier(K)
  requires subset : V ⊆ Ring.carrier(K)
  requires point : y ∈ V
  shows tkJMulMap(K, a, V)(y) = call2(Ring.mul(K), a, y)
proof
  have fun := tkJ.mulMap.function at K, a, V with ring, member, subset
  have rel : relates(tkJMulMap(K, a, V), y, call2(Ring.mul(K), a, y))
    unfold relates
    apply tkJMulMap.membership.backward
    exact ⟨y, point, rfl⟩
  exact FunctionBetween.apply_value with fun, point, rel

theorem tkJ.constMap.function (V c B : Set)
  requires member : c ∈ B
  shows tkJConstMap(V, c) : V → B
proof
  apply tkJ.fin_graph_function
  . intros u uIn
    obtain ⟨y, yIn, e⟩ := tkJConstMap.membership.forward with uIn
    rw ← e
    exact product.pair with yIn, member
  . intros x y z hy hz
    obtain ⟨a1, aIn1, ea⟩ := tkJConstMap.membership.forward with hy
    obtain ⟨b, bIn, eb⟩ := tkJConstMap.membership.forward with hz
    obtain ⟨xa, ya⟩ := orderedPair.injective with ea
    obtain ⟨xb, zb⟩ := orderedPair.injective with eb
    rw [← ya, ← zb]
  . intros y yIn
    refine ⟨c, member, ?_⟩
    apply tkJConstMap.membership.backward
    exact ⟨y, yIn, rfl⟩

theorem tkJ.constMap.apply (V c B y : Set)
  requires member : c ∈ B
  requires point : y ∈ V
  shows tkJConstMap(V, c)(y) = c
proof
  have fun := tkJ.constMap.function at V, c, B with member
  have rel : relates(tkJConstMap(V, c), y, c)
    unfold relates
    apply tkJConstMap.membership.backward
    exact ⟨y, point, rfl⟩
  exact FunctionBetween.apply_value with fun, point, rel

theorem tkJ.indexedProduct.const (K V c f : Set) (n : Nat)
  requires ring : Ring(K)
  requires member : c ∈ Ring.carrier(K)
  shows (∀ i ∈ n, f(i) ∈ V) →
    indexedRingProduct(tkJConstMap(V, c), f, Ring.mul(K), Ring.one(K), n) = Ring.pow(K, c, n)
proof
  induction n
  | zero =>
    intro values
    rw indexedRingProduct
    rw (Ring.pow_zero at K, c with ring, member)
  | succ(k) using ih =>
    intro values
    have prefix : ∀ i ∈ k, f(i) ∈ V
      intros i hi
      have next := membership.into_successor at i, k with *
      exact values with i, next
    have last := values with k, membership.self_successor at k with *
    have previous := ih with prefix
    rw indexedRingProduct
    rw previous
    rw (tkJ.constMap.apply at V, c, Ring.carrier(K), f(k) with member, last)
    have shift := add.right_one at k with *
    rw ← shift
    rw (Ring.pow_succ at K, c, k with ring, member)

theorem tkJ.indexedProduct.nonzero (K w f : Set) (n : Nat)
  requires domain : IntegralDomain(K)
  shows (∀ i ∈ n, w(f(i)) ∈ Ring.carrier(K) ∧ w(f(i)) ≠ Ring.zero(K)) →
    indexedRingProduct(w, f, Ring.mul(K), Ring.one(K), n) ∈ Ring.carrier(K) ∧
    indexedRingProduct(w, f, Ring.mul(K), Ring.one(K), n) ≠ Ring.zero(K)
proof
  induction n
  | zero =>
    obtain ⟨comm, nt, nzd⟩ := domain
    intro values
    rw indexedRingProduct
    have oIn : Ring.one(K) ∈ Ring.carrier(K) by typecheck
    refine ⟨oIn, ?_⟩
    intro e
    symm at e
    exact nt with e
  | succ(k) using ih =>
    obtain ⟨comm, nt, nzd⟩ := domain
    intro values
    have prefix : ∀ i ∈ k, w(f(i)) ∈ Ring.carrier(K) ∧ w(f(i)) ≠ Ring.zero(K)
      intros i hi
      have next := membership.into_successor at i, k with *
      exact values with i, next
    have last := values with k, membership.self_successor at k with *
    obtain ⟨lIn, lnz⟩ := last
    have previous := ih with prefix
    obtain ⟨pIn, pnz⟩ := previous
    rw indexedRingProduct
    have mIn : call2(Ring.mul(K), indexedRingProduct(w, f, Ring.mul(K), Ring.one(K), k), w(f(k))) ∈ Ring.carrier(K) by typecheck
    refine ⟨mIn, ?_⟩
    intro e
    rcases nzd with indexedRingProduct(w, f, Ring.mul(K), Ring.one(K), k), pIn, w(f(k)), lIn, e with a | b
    . exact pnz with a
    . exact lnz with b

theorem tkJ.finiteField.pow_card_sub_one (K x : Set)
  requires finite : FiniteField(K)
  requires member : x ∈ Ring.carrier(K)
  requires nonzero : x ≠ Ring.zero(K)
  shows Ring.pow(K, x, cardinality(Ring.carrier(K)) - 1) = Ring.one(K)
proof
  obtain ⟨field, fin⟩ := finite
  have comm := Field.to_comm_ring at K with field
  have ring := CommRing.to_ring with comm
  have dom := Field.domain at K with field
  have parts := CommRing.parts with comm
  have zIn : Ring.zero(K) ∈ Ring.carrier(K) by typecheck
  have oIn : Ring.one(K) ∈ Ring.carrier(K) by typecheck
  have sub := difference.subset_left at Ring.carrier(K), {Ring.zero(K)}
  have finV := Finite.subset with fin, sub
  have vMem : ∀ y ∈ Ring.carrier(K) ∖ {Ring.zero(K)}, y ∈ Ring.carrier(K) ∧ y ≠ Ring.zero(K)
    intros y yIn
    have yK := sub with y, yIn
    refine ⟨yK, ?_⟩
    intro e
    have sIn : y ∈ {Ring.zero(K)} := singleton.membership.backward with e
    have d := difference.membership.forward with yIn
    exact d.right with sIn
  have vIntro : ∀ y ∈ Ring.carrier(K), y ≠ Ring.zero(K) → y ∈ Ring.carrier(K) ∖ {Ring.zero(K)}
    intros y yIn ynz
    apply difference.membership.backward
    refine ⟨yIn, ?_⟩
    intro sIn
    exact ynz with (singleton.membership.forward with sIn)
  -- the maps y ↦ x y and y ↦ 1 y on the nonzero elements
  have funX := tkJ.mulMap.function at K, x, Ring.carrier(K) ∖ {Ring.zero(K)} with ring, member, sub
  have funOne := tkJ.mulMap.function at K, Ring.one(K), Ring.carrier(K) ∖ {Ring.zero(K)} with ring, oIn, sub
  have funC := tkJ.constMap.function at Ring.carrier(K) ∖ {Ring.zero(K)}, x, Ring.carrier(K) with member
  have intoV : ∀ y ∈ Ring.carrier(K) ∖ {Ring.zero(K)}, call2(Ring.mul(K), x, y) ∈ Ring.carrier(K) ∖ {Ring.zero(K)}
    intros y yIn
    obtain ⟨yK, ynz⟩ := vMem with y, yIn
    have mIn : call2(Ring.mul(K), x, y) ∈ Ring.carrier(K) by typecheck
    apply vIntro with call2(Ring.mul(K), x, y), mIn
    intro e
    obtain ⟨_, _, nzd⟩ := dom
    rcases nzd with x, member, y, yK, e with a | b
    . exact nonzero with a
    . exact ynz with b
  have funXV : tkJMulMap(K, x, Ring.carrier(K) ∖ {Ring.zero(K)}) : Ring.carrier(K) ∖ {Ring.zero(K)} → Ring.carrier(K) ∖ {Ring.zero(K)}
    have codomain := FunctionBetween.codomain_of_values at tkJMulMap(K, x, Ring.carrier(K) ∖ {Ring.zero(K)}), Ring.carrier(K) ∖ {Ring.zero(K)}, Ring.carrier(K), Ring.carrier(K) ∖ {Ring.zero(K)} with funX
    apply codomain
    intros y yIn
    rw (tkJ.mulMap.apply at K, x, Ring.carrier(K) ∖ {Ring.zero(K)}, y with ring, member, sub, yIn)
    exact intoV with y, yIn
  have injX : InjectiveBetween(tkJMulMap(K, x, Ring.carrier(K) ∖ {Ring.zero(K)}), Ring.carrier(K) ∖ {Ring.zero(K)}, Ring.carrier(K) ∖ {Ring.zero(K)})
    refine ⟨funXV, ?_⟩
    intros a aIn b bIn z zIn2 ra rb
    have fa := FunctionBetween.apply_value with funXV, aIn, ra
    have fb := FunctionBetween.apply_value with funXV, bIn, rb
    rw (tkJ.mulMap.apply at K, x, Ring.carrier(K) ∖ {Ring.zero(K)}, a with ring, member, sub, aIn) at fa
    rw (tkJ.mulMap.apply at K, x, Ring.carrier(K) ∖ {Ring.zero(K)}, b with ring, member, sub, bIn) at fb
    obtain ⟨aK, _⟩ := vMem with a, aIn
    obtain ⟨bK, _⟩ := vMem with b, bIn
    have dIn : a - b ∈ Ring.carrier(K) by typecheck
    have e : x * (a - b) = Ring.zero(K)
      have t : x * (a - b) = x * a - x * b by ring
      rw [t, fa, fb]
      ring
    obtain ⟨_, _, nzd⟩ := dom
    rcases nzd with x, member, a - b, dIn, e with c1 | c2
    . exfalso
      exact nonzero with c1
    . have t : a = (a - b) + b by ring
      rw c2 at t
      rw t
      ring
  have surjX := tkJ.finite_injective_onto with finV, injX
  have bijX : BijectiveBetween(tkJMulMap(K, x, Ring.carrier(K) ∖ {Ring.zero(K)}), Ring.carrier(K) ∖ {Ring.zero(K)}, Ring.carrier(K) ∖ {Ring.zero(K)})
    exact ⟨injX, surjX⟩
  have valuesR : ∀ d ∈ Ring.carrier(K) ∖ {Ring.zero(K)}, tkJMulMap(K, x, Ring.carrier(K) ∖ {Ring.zero(K)})(d) = tkJMulMap(K, Ring.one(K), Ring.carrier(K) ∖ {Ring.zero(K)})(tkJMulMap(K, x, Ring.carrier(K) ∖ {Ring.zero(K)})(d))
    intros d dIn
    have img := intoV with d, dIn
    rw (tkJ.mulMap.apply at K, x, Ring.carrier(K) ∖ {Ring.zero(K)}, d with ring, member, sub, dIn)
    rw (tkJ.mulMap.apply at K, Ring.one(K), Ring.carrier(K) ∖ {Ring.zero(K)}, call2(Ring.mul(K), x, d) with ring, oIn, sub, img)
    obtain ⟨dK, _⟩ := vMem with d, dIn
    ring
  have reidx := finiteRingProduct.reindex at Ring.carrier(K) ∖ {Ring.zero(K)}, Ring.carrier(K) ∖ {Ring.zero(K)}, Ring.carrier(K), Ring.add(K), Ring.zero(K), Ring.neg(K), Ring.mul(K), Ring.one(K), tkJMulMap(K, x, Ring.carrier(K) ∖ {Ring.zero(K)}), tkJMulMap(K, Ring.one(K), Ring.carrier(K) ∖ {Ring.zero(K)}), tkJMulMap(K, x, Ring.carrier(K) ∖ {Ring.zero(K)}) with parts, finV, funX, funOne, bijX, valuesR
  have equations : ∀ y ∈ Ring.carrier(K) ∖ {Ring.zero(K)}, tkJMulMap(K, x, Ring.carrier(K) ∖ {Ring.zero(K)})(y) = call2(Ring.mul(K), tkJConstMap(Ring.carrier(K) ∖ {Ring.zero(K)}, x)(y), tkJMulMap(K, Ring.one(K), Ring.carrier(K) ∖ {Ring.zero(K)})(y))
    intros y yIn
    rw (tkJ.mulMap.apply at K, x, Ring.carrier(K) ∖ {Ring.zero(K)}, y with ring, member, sub, yIn)
    rw (tkJ.mulMap.apply at K, Ring.one(K), Ring.carrier(K) ∖ {Ring.zero(K)}, y with ring, oIn, sub, yIn)
    rw (tkJ.constMap.apply at Ring.carrier(K) ∖ {Ring.zero(K)}, x, Ring.carrier(K), y with member, yIn)
    obtain ⟨yK, _⟩ := vMem with y, yIn
    ring
  have split := finiteRingProduct.mul at Ring.carrier(K) ∖ {Ring.zero(K)}, Ring.carrier(K), Ring.add(K), Ring.zero(K), Ring.neg(K), Ring.mul(K), Ring.one(K), tkJConstMap(Ring.carrier(K) ∖ {Ring.zero(K)}, x), tkJMulMap(K, Ring.one(K), Ring.carrier(K) ∖ {Ring.zero(K)}), tkJMulMap(K, x, Ring.carrier(K) ∖ {Ring.zero(K)}) with parts, finV, funC, funOne, funX, equations
  rw reidx at split
  -- an enumeration of the nonzero elements
  have hc := cardinality.correct with finV
  have mNat := cardinality.nat with finV
  obtain ⟨_, eqv⟩ := hc
  have eqv2 := Equipotent.symmetric with eqv
  obtain ⟨g, gBij⟩ := eqv2
  have gInj := Bijective.injective with gBij
  have gFun := Injective.function with gInj
  have gVals : ∀ i ∈ cardinality(Ring.carrier(K) ∖ {Ring.zero(K)}), g(i) ∈ Ring.carrier(K) ∖ {Ring.zero(K)}
    intros i iIn
    exact FunctionBetween.apply_closed with gFun, iIn
  have enumC := finiteRingProduct.enumeration at Ring.carrier(K) ∖ {Ring.zero(K)}, Ring.carrier(K), Ring.add(K), Ring.zero(K), Ring.neg(K), Ring.mul(K), Ring.one(K), tkJConstMap(Ring.carrier(K) ∖ {Ring.zero(K)}, x), g, cardinality(Ring.carrier(K) ∖ {Ring.zero(K)}) with parts, funC, gBij
  have constP := tkJ.indexedProduct.const at K, Ring.carrier(K) ∖ {Ring.zero(K)}, x, g, cardinality(Ring.carrier(K) ∖ {Ring.zero(K)}) with ring, member
  rw (constP with gVals) at enumC
  rw enumC at split
  have enumP := finiteRingProduct.enumeration at Ring.carrier(K) ∖ {Ring.zero(K)}, Ring.carrier(K), Ring.add(K), Ring.zero(K), Ring.neg(K), Ring.mul(K), Ring.one(K), tkJMulMap(K, Ring.one(K), Ring.carrier(K) ∖ {Ring.zero(K)}), g, cardinality(Ring.carrier(K) ∖ {Ring.zero(K)}) with parts, funOne, gBij
  have nzP := tkJ.indexedProduct.nonzero at K, tkJMulMap(K, Ring.one(K), Ring.carrier(K) ∖ {Ring.zero(K)}), g, cardinality(Ring.carrier(K) ∖ {Ring.zero(K)}) with dom
  have nzVals : ∀ i ∈ cardinality(Ring.carrier(K) ∖ {Ring.zero(K)}), tkJMulMap(K, Ring.one(K), Ring.carrier(K) ∖ {Ring.zero(K)})(g(i)) ∈ Ring.carrier(K) ∧ tkJMulMap(K, Ring.one(K), Ring.carrier(K) ∖ {Ring.zero(K)})(g(i)) ≠ Ring.zero(K)
    intros i iIn
    have gi := gVals with i, iIn
    rw (tkJ.mulMap.apply at K, Ring.one(K), Ring.carrier(K) ∖ {Ring.zero(K)}, g(i) with ring, oIn, sub, gi)
    obtain ⟨giK, ginz⟩ := vMem with g(i), gi
    have same : Ring.one(K) * g(i) = g(i) by ring
    rw same
    exact ⟨giK, ginz⟩
  obtain ⟨pIn, pnz⟩ := nzP with nzVals
  rw ← enumP at pIn
  rw ← enumP at pnz
  have xm : Ring.pow(K, x, cardinality(Ring.carrier(K) ∖ {Ring.zero(K)})) ∈ Ring.carrier(K) by typecheck
  have e : (Ring.pow(K, x, cardinality(Ring.carrier(K) ∖ {Ring.zero(K)})) - Ring.one(K)) * finiteRingProduct(Ring.carrier(K) ∖ {Ring.zero(K)}, Ring.carrier(K), Ring.add(K), Ring.zero(K), Ring.neg(K), Ring.mul(K), Ring.one(K), tkJMulMap(K, Ring.one(K), Ring.carrier(K) ∖ {Ring.zero(K)})) = Ring.zero(K)
    have t : (Ring.pow(K, x, cardinality(Ring.carrier(K) ∖ {Ring.zero(K)})) - Ring.one(K)) * finiteRingProduct(Ring.carrier(K) ∖ {Ring.zero(K)}, Ring.carrier(K), Ring.add(K), Ring.zero(K), Ring.neg(K), Ring.mul(K), Ring.one(K), tkJMulMap(K, Ring.one(K), Ring.carrier(K) ∖ {Ring.zero(K)})) = Ring.pow(K, x, cardinality(Ring.carrier(K) ∖ {Ring.zero(K)})) * finiteRingProduct(Ring.carrier(K) ∖ {Ring.zero(K)}, Ring.carrier(K), Ring.add(K), Ring.zero(K), Ring.neg(K), Ring.mul(K), Ring.one(K), tkJMulMap(K, Ring.one(K), Ring.carrier(K) ∖ {Ring.zero(K)})) - finiteRingProduct(Ring.carrier(K) ∖ {Ring.zero(K)}, Ring.carrier(K), Ring.add(K), Ring.zero(K), Ring.neg(K), Ring.mul(K), Ring.one(K), tkJMulMap(K, Ring.one(K), Ring.carrier(K) ∖ {Ring.zero(K)})) by ring
    rw [t, ← split]
    ring
  have dIn : Ring.pow(K, x, cardinality(Ring.carrier(K) ∖ {Ring.zero(K)})) - Ring.one(K) ∈ Ring.carrier(K) by typecheck
  obtain ⟨_, _, nzd⟩ := dom
  have zK : Ring.zero(K) ∈ Ring.carrier(K) by typecheck
  have cardEq := cardinality.remove at Ring.carrier(K), Ring.zero(K) with fin, zK
  have minus : cardinality(Ring.carrier(K)) - 1 = cardinality(Ring.carrier(K) ∖ {Ring.zero(K)})
    rw cardEq
    rw ← (add.right_one at cardinality(Ring.carrier(K) ∖ {Ring.zero(K)}))
    exact sub.add_right at cardinality(Ring.carrier(K) ∖ {Ring.zero(K)}), 1
  rw minus
  rcases nzd with Ring.pow(K, x, cardinality(Ring.carrier(K) ∖ {Ring.zero(K)})) - Ring.one(K), dIn, finiteRingProduct(Ring.carrier(K) ∖ {Ring.zero(K)}, Ring.carrier(K), Ring.add(K), Ring.zero(K), Ring.neg(K), Ring.mul(K), Ring.one(K), tkJMulMap(K, Ring.one(K), Ring.carrier(K) ∖ {Ring.zero(K)})), pIn, e with c1 | c2
  . have t : Ring.pow(K, x, cardinality(Ring.carrier(K) ∖ {Ring.zero(K)})) = (Ring.pow(K, x, cardinality(Ring.carrier(K) ∖ {Ring.zero(K)})) - Ring.one(K)) + Ring.one(K) by ring
    rw c1 at t
    rw t
    ring
  . exfalso
    exact pnz with c2

theorem tkJ.finiteField.pow_card_self (K x : Set)
  requires finite : FiniteField(K)
  requires member : x ∈ Ring.carrier(K)
  shows Ring.pow(K, x, cardinality(Ring.carrier(K))) = x
proof
  have fin := finite.right
  have field := finite.left
  have comm := Field.to_comm_ring at K with field
  have ring := CommRing.to_ring with comm
  have zK : Ring.zero(K) ∈ Ring.carrier(K) by typecheck
  have cardEq := cardinality.remove at Ring.carrier(K), Ring.zero(K) with fin, zK
  have finV := Finite.difference at Ring.carrier(K), {Ring.zero(K)} with fin
  have mNat := cardinality.nat with finV
  have minus : cardinality(Ring.carrier(K)) - 1 = cardinality(Ring.carrier(K) ∖ {Ring.zero(K)})
    rw cardEq
    rw ← (add.right_one at cardinality(Ring.carrier(K) ∖ {Ring.zero(K)}))
    exact sub.add_right at cardinality(Ring.carrier(K) ∖ {Ring.zero(K)}), 1
  rw cardEq
  rw ← (add.right_one at cardinality(Ring.carrier(K) ∖ {Ring.zero(K)}))
  rw (Ring.pow_succ at K, x, cardinality(Ring.carrier(K) ∖ {Ring.zero(K)}) with ring, member)
  by_cases x0 : x = Ring.zero(K)
  . rw x0
    ring
  . have one := tkJ.finiteField.pow_card_sub_one at K, x with finite, member, x0
    rw minus at one
    rw one
    ring

-- Helpers: |L| = |K|^[L:K] for finite fields, and |K| ≥ 2.
theorem tkJ.finiteField.card_extension (E : Set)
  requires extension : FieldExtension(E)
  requires finiteBase : FiniteField(Algebra.base(E))
  requires finiteTop : FiniteField(Algebra.ring(E))
  shows FiniteExtension(E) ∧ extensionDegree(E) ∈ ℕ ∧
    cardinality(algebraCarrier(E)) =
      cardinality(Ring.carrier(Algebra.base(E))) ^ extensionDegree(E)
proof
  have ext0 := extension
  obtain ⟨alg, baseField, topField⟩ := ext0
  have module := algebraModule.module_of at E with alg
  have comm := Field.to_comm_ring at Algebra.base(E) with baseField
  have ringK := CommRing.to_ring with comm
  have dom := Field.domain at Algebra.base(E) with baseField
  obtain ⟨_, nontrivial, _⟩ := dom
  have finTop : Finite(algebraCarrier(E))
    unfold algebraCarrier
    exact finiteTop.right
  have finK := finiteBase.right
  have carrierEq := algebraModule.carrier_eq at E
  have idFun : identity(algebraCarrier(E)) : algebraCarrier(E) → Module.carrier(algebraModule(E))
    rw carrierEq
    exact identity.function at algebraCarrier(E)
  have spans : SpansModule(algebraModule(E), Algebra.base(E), algebraCarrier(E), identity(algebraCarrier(E)))
    unfold SpansModule
    refine ⟨module, idFun, ?_⟩
    have self : algebraCarrier(E) ⊆ Module.carrier(algebraModule(E))
      rw carrierEq
      exact Subset.reflexive at algebraCarrier(E)
    rw (functionImage.identity at algebraCarrier(E), Module.carrier(algebraModule(E)) with self)
    apply Subset.antisymmetric
    . have sub := moduleSpan.submodule_of at Algebra.base(E), algebraModule(E), algebraCarrier(E) with ringK, module
      obtain ⟨_, inside, _⟩ := sub
      exact inside
    . rw carrierEq
      exact moduleSpan.subset_of at Algebra.base(E), algebraModule(E), algebraCarrier(E) with ringK, module, self
  have fdBoth := SpansModule.finrank_le_card at Algebra.base(E), algebraModule(E), algebraCarrier(E), identity(algebraCarrier(E)) with baseField, module, finTop, spans
  obtain ⟨fd, _⟩ := fdBoth
  have finExt : FiniteExtension(E)
    exact ⟨extension, fd⟩
  have free := FiniteDimensional.finite_free at Algebra.base(E), algebraModule(E) with baseField, module, fd
  obtain ⟨v, basis⟩ := finrank.basis_exists at Algebra.base(E), algebraModule(E) with comm, nontrivial, module, free
  have sel := finrank.selected at algebraModule(E), Algebra.base(E) with comm, nontrivial, free
  have dN := sel.left
  have degN : extensionDegree(E) ∈ ℕ
    unfold extensionDegree
    exact dN
  have dNat : Nat(finrank(algebraModule(E), Algebra.base(E))) by typecheck
  have finD := Finite.natural at finrank(algebraModule(E), Algebra.base(E))
  have eqv := ModuleBasis.combination_map_equiv at Algebra.base(E), algebraModule(E), finrank(algebraModule(E), Algebra.base(E)), v with comm, module, finD, basis
  obtain ⟨_, bij⟩ := eqv
  unfold coordinateModule at bij
  rw (functionModule.carrier_eq at Algebra.base(E), finrank(algebraModule(E), Algebra.base(E)), selfModule(Algebra.base(E))) at bij
  rw (selfModule.carrier_eq at Algebra.base(E)) at bij
  rw carrierEq at bij
  have finFS := functionSpace.finite at finrank(algebraModule(E), Algebra.base(E)), Ring.carrier(Algebra.base(E)) with finD, finK
  have same := cardinality.bijective with finFS, bij
  rw (functionSpace.count at finrank(algebraModule(E), Algebra.base(E)), Ring.carrier(Algebra.base(E)) with finD, finK) at same
  rw (cardinality.natural at finrank(algebraModule(E), Algebra.base(E))) at same
  refine ⟨finExt, degN, ?_⟩
  unfold extensionDegree
  symm
  exact same

theorem tkJ.finiteField.card_ge_two (K : Set)
  requires finite : FiniteField(K)
  shows 2 ≤ cardinality(Ring.carrier(K))
proof
  have fin := finite.right
  have field := finite.left
  have comm := Field.to_comm_ring at K with field
  have ring := CommRing.to_ring with comm
  have dom := Field.domain at K with field
  obtain ⟨_, nt, _⟩ := dom
  have zK : Ring.zero(K) ∈ Ring.carrier(K) by typecheck
  have oK : Ring.one(K) ∈ Ring.carrier(K) by typecheck
  have c1 := cardinality.remove at Ring.carrier(K), Ring.zero(K) with fin, zK
  have finV := Finite.difference at Ring.carrier(K), {Ring.zero(K)} with fin
  have oV : Ring.one(K) ∈ Ring.carrier(K) ∖ {Ring.zero(K)}
    apply difference.membership.backward
    refine ⟨oK, ?_⟩
    intro sIn
    have e := singleton.membership.forward with sIn
    symm at e
    exact nt with e
  have c2 := cardinality.remove at Ring.carrier(K) ∖ {Ring.zero(K)}, Ring.one(K) with finV, oV
  have finW := Finite.difference at Ring.carrier(K) ∖ {Ring.zero(K)}, {Ring.one(K)} with finV
  have wNat := cardinality.nat with finW
  have vNat := cardinality.nat with finV
  have qNat := cardinality.nat with fin
  rw c2 at c1
  arith

-- Section: Finite fields
section FiniteFields
variable (K : Set)
hypothesis finite : FiniteField(K)

-- FiniteField.card: |K| = p^n with p = char K and n ≥ 1.
theorem FiniteField.card
  shows ∃ n ∈ ℕ, 0 < n ∧
    HasCardinality(Ring.carrier(K), ringChar(K) ^ n)
proof
  have fin := finite.right
  have field := finite.left
  have comm := Field.to_comm_ring at K with field
  have ring := CommRing.to_ring with comm
  have cp := FiniteField.char_prime at K with comm, finite
  obtain ⟨pr, spec⟩ := cp
  have pNat : Nat(ringChar(K)) by typecheck
  have gt := Prime.greater_than_one at ringChar(K) with pr
  have positive : 0 < ringChar(K) by arith
  have vanishes := CharP.cast_eq_zero at K, ringChar(K) with comm, spec
  have hom := tkJ.zmodLift.hom at ringChar(K), K with positive, comm, vanishes
  have zfield := (zmod.field_iff at ringChar(K)).backward with pr
  have basics := tkJ.zmod.comm_ring at ringChar(K)
  obtain ⟨zc, _, _⟩ := basics
  have alg := Algebra.intro at zmod(ringChar(K)), K, tkJZmodLift(ringChar(K), K) with zc, comm, hom
  have eb : Algebra.base(Algebra.mk(zmod(ringChar(K)), K, tkJZmodLift(ringChar(K), K))) = zmod(ringChar(K))
    simp [Algebra.mk.base]
  have er : Algebra.ring(Algebra.mk(zmod(ringChar(K)), K, tkJZmodLift(ringChar(K), K))) = K
    simp [Algebra.mk.ring]
  have ext : FieldExtension(Algebra.mk(zmod(ringChar(K)), K, tkJZmodLift(ringChar(K), K)))
    unfold FieldExtension
    rw [eb, er]
    exact ⟨alg, zfield, field⟩
  have zcard := zmod.card at ringChar(K) with positive
  have zfin := Finite.from_cardinality with zcard
  have fb : FiniteField(Algebra.base(Algebra.mk(zmod(ringChar(K)), K, tkJZmodLift(ringChar(K), K))))
    rw eb
    exact ⟨zfield, zfin⟩
  have ft : FiniteField(Algebra.ring(Algebra.mk(zmod(ringChar(K)), K, tkJZmodLift(ringChar(K), K))))
    rw er
    exact finite
  have ce := tkJ.finiteField.card_extension at Algebra.mk(zmod(ringChar(K)), K, tkJZmodLift(ringChar(K), K)) with ext, fb, ft
  obtain ⟨_, degN, cardEq⟩ := ce
  unfold algebraCarrier at cardEq
  rw [eb, er] at cardEq
  rw (cardinality.eq_of_has with zcard) at cardEq
  have dNat : Nat(extensionDegree(Algebra.mk(zmod(ringChar(K)), K, tkJZmodLift(ringChar(K), K)))) by typecheck
  have two := tkJ.finiteField.card_ge_two at K with finite
  have dPos : 0 < extensionDegree(Algebra.mk(zmod(ringChar(K)), K, tkJZmodLift(ringChar(K), K)))
    by_contra d0
    have dz : extensionDegree(Algebra.mk(zmod(ringChar(K)), K, tkJZmodLift(ringChar(K), K))) = 0 by arith
    rw [dz, pow.zero] at cardEq
    arith
  have hc := cardinality.correct with fin
  rw cardEq at hc
  exact ⟨extensionDegree(Algebra.mk(zmod(ringChar(K)), K, tkJZmodLift(ringChar(K), K))), degN, dPos, hc⟩

-- FiniteField.pow_card, FiniteField.pow_card_pow: x^q = x and
-- x^(q^n) = x.
theorem FiniteField.pow_card (x : Set) (n : Nat)
  requires member : x ∈ Ring.carrier(K)
  shows Ring.pow(K, x, cardinality(Ring.carrier(K)) ^ n) = x
proof
  have fin := finite.right
  have field := finite.left
  have comm := Field.to_comm_ring at K with field
  have ring := CommRing.to_ring with comm
  have qNat := cardinality.nat with fin
  induction n
  | zero =>
    rw pow.zero
    exact Ring.pow_one at K, x with ring, member
  | succ(k) using ih =>
    have shift := add.right_one at k with *
    rw ← shift
    rw (pow.succ_right at cardinality(Ring.carrier(K)), k)
    rw (Ring.pow_mul at K, x, cardinality(Ring.carrier(K)) ^ k, cardinality(Ring.carrier(K)) with ring, member)
    rw ih
    exact tkJ.finiteField.pow_card_self at K, x with finite, member

-- FiniteField.pow_card_sub_one_eq_one: x^(q−1) = 1 for x ≠ 0.
theorem FiniteField.pow_card_sub_one (x : Set)
  requires member : x ∈ Ring.carrier(K)
  requires nonzero : x ≠ Ring.zero(K)
  shows Ring.pow(K, x, cardinality(Ring.carrier(K)) - 1) = Ring.one(K)
proof
  exact tkJ.finiteField.pow_card_sub_one at K, x with finite, member, nonzero

-- The units of a finite field form a cyclic group of order q − 1
-- (IsCyclic Kˣ, FiniteField.card_units).
theorem FiniteField.units_cyclic
  shows CyclicGroup(unitGroup(K)) ∧
    order(unitGroup(K)) = cardinality(Ring.carrier(K)) - 1
proof
  sorry

-- X^q − X is nonzero of degree q and is the product of X − a over
-- a ∈ K (FiniteField.X_pow_card_sub_X_ne_zero,
-- FiniteField.X_pow_card_sub_X_natDegree_eq, FiniteField.roots_X_pow_card_sub_X).
theorem FiniteField.X_pow_card_sub_X
  shows polyXPowSubX(K, cardinality(Ring.carrier(K))) ≠ Ring.zero(polynomialRing(K, {0})) ∧
    polyNatDegree(K, polyXPowSubX(K, cardinality(Ring.carrier(K)))) =
      cardinality(Ring.carrier(K)) ∧
    polyRootSet(K, polyXPowSubX(K, cardinality(Ring.carrier(K)))) = Ring.carrier(K)
proof
  have fin := finite.right
  have field := finite.left
  have comm := Field.to_comm_ring at K with field
  have ring := CommRing.to_ring with comm
  have polys := polynomialRing.comm_ring at K, {0} with comm
  have pr := CommRing.to_ring with polys
  have dom := Field.domain at K with field
  obtain ⟨_, nt, _⟩ := dom
  have zK : Ring.zero(K) ∈ Ring.carrier(K) by typecheck
  have oK : Ring.one(K) ∈ Ring.carrier(K) by typecheck
  -- q ≥ 2
  have c1 := cardinality.remove at Ring.carrier(K), Ring.zero(K) with fin, zK
  have finV := Finite.difference at Ring.carrier(K), {Ring.zero(K)} with fin
  have oV : Ring.one(K) ∈ Ring.carrier(K) ∖ {Ring.zero(K)}
    apply difference.membership.backward
    refine ⟨oK, ?_⟩
    intro sIn
    have e := singleton.membership.forward with sIn
    symm at e
    exact nt with e
  have c2 := cardinality.remove at Ring.carrier(K) ∖ {Ring.zero(K)}, Ring.one(K) with finV, oV
  have finW := Finite.difference at Ring.carrier(K) ∖ {Ring.zero(K)}, {Ring.one(K)} with finV
  have wNat := cardinality.nat with finW
  have vNat := cardinality.nat with finV
  have qNat := cardinality.nat with fin
  rw c2 at c1
  have q2 : 2 ≤ cardinality(Ring.carrier(K)) by arith
  have qN : cardinality(Ring.carrier(K)) ∈ ℕ by typecheck
  have xIn := polyX.mem at K with comm, polys
  have xq : Ring.pow(polynomialRing(K, {0}), polyX(K), cardinality(Ring.carrier(K))) ∈ Ring.carrier(polynomialRing(K, {0})) by typecheck
  have fIn : polyXPowSubX(K, cardinality(Ring.carrier(K))) ∈ Ring.carrier(polynomialRing(K, {0}))
    unfold polyXPowSubX
    typecheck
  have coeff : ∀ k ∈ ℕ, polyCoeff(polyXPowSubX(K, cardinality(Ring.carrier(K))), k) = polyCoeff(Ring.pow(polynomialRing(K, {0}), polyX(K), cardinality(Ring.carrier(K))), k) - polyCoeff(polyX(K), k)
    intros k hk
    have kNat := nat.omega.backward with hk
    unfold polyXPowSubX
    exact uni.coeff_sub at K, Ring.pow(polynomialRing(K, {0}), polyX(K), cardinality(Ring.carrier(K))), polyX(K), k with comm, polys, xq, xIn
  have top : polyCoeff(polyXPowSubX(K, cardinality(Ring.carrier(K))), cardinality(Ring.carrier(K))) = Ring.one(K)
    rw (coeff with cardinality(Ring.carrier(K)), qN)
    rw (uni.X_pow at K, cardinality(Ring.carrier(K)) with comm, polys)
    have en : cardinality(Ring.carrier(K)) = cardinality(Ring.carrier(K)) by rfl
    rw ((uni.term_coeff at K, Ring.one(K), cardinality(Ring.carrier(K)), cardinality(Ring.carrier(K)) with comm, polys, oK).left with en)
    have n1 : cardinality(Ring.carrier(K)) ≠ 1 by arith
    rw ((uni.X_coeff at K, cardinality(Ring.carrier(K)) with comm, polys).right with n1)
    ring
  have vanish : ∀ k ∈ ℕ, cardinality(Ring.carrier(K)) < k → polyCoeff(polyXPowSubX(K, cardinality(Ring.carrier(K))), k) = Ring.zero(K)
    intros k hk lt
    have kNat := nat.omega.backward with hk
    rw (coeff with k, hk)
    rw (uni.X_pow at K, cardinality(Ring.carrier(K)) with comm, polys)
    have kn : k ≠ cardinality(Ring.carrier(K)) by arith
    have k1 : k ≠ 1 by arith
    rw ((uni.term_coeff at K, Ring.one(K), cardinality(Ring.carrier(K)), k with comm, polys, oK).right with kn)
    rw ((uni.X_coeff at K, k with comm, polys).right with k1)
    ring
  have r := uni.monic_of at K, polyXPowSubX(K, cardinality(Ring.carrier(K))), cardinality(Ring.carrier(K)) with comm, polys, fIn, top, vanish
  obtain ⟨monic, degImp⟩ := r
  have deg := degImp with nt
  have nz := PolyMonic.ne_zero at K, polyXPowSubX(K, cardinality(Ring.carrier(K))) with comm, polys, fIn, nt, monic
  have roots : polyRootSet(K, polyXPowSubX(K, cardinality(Ring.carrier(K)))) = Ring.carrier(K)
    apply Subset.antisymmetric
    . intros a aIn
      obtain ⟨aK, _⟩ := polyRootSet.membership.forward with aIn
      exact aK
    . intros a aK
      apply polyRootSet.membership.backward
      refine ⟨aK, ?_⟩
      have h := polyEval.hom at K, a with comm, polys, aK
      have e1 := polyEval.X at K, a with comm, polys, aK
      unfold polyEval at e1
      unfold polyEval
      unfold polyXPowSubX
      rw (RingHom.map_sub at evaluationAt(K, {0}, constantFunction({0}, Ring.carrier(K), a)), polynomialRing(K, {0}), K, Ring.pow(polynomialRing(K, {0}), polyX(K), cardinality(Ring.carrier(K))), polyX(K) with h, xq, xIn)
      rw (tkJ.hom_pow at evaluationAt(K, {0}, constantFunction({0}, Ring.carrier(K), a)), polynomialRing(K, {0}), K, polyX(K), cardinality(Ring.carrier(K)) with h, xIn)
      rw e1
      rw (tkJ.finiteField.pow_card_self at K, a with finite, aK)
      ring
  exact ⟨nz, deg, roots⟩

-- FiniteField.isSquare_neg_one_iff: −1 is a square iff q mod 4 ≠ 3.
theorem FiniteField.square_neg_one_iff
  shows (∃ y ∈ Ring.carrier(K), call2(Ring.mul(K), y, y) = apply(Ring.neg(K), Ring.one(K))) ↔
    integerMod(integerOfNat(cardinality(Ring.carrier(K))), 4) ≠ 3
proof
  sorry

-- Finite fields of the same order are isomorphic
-- (FiniteField.ringEquivOfCardEq).
theorem FiniteField.iso_of_card (K2 : Set)
  requires second : FiniteField(K2)
  requires card : cardinality(Ring.carrier(K)) = cardinality(Ring.carrier(K2))
  shows ∃ f, f : K ≃+* K2
proof
  sorry

end FiniteFields

-- GaloisField p n: for p prime and n ≥ 1 there is a field with p^n
-- elements, a splitting field of X^(p^n) − X over ZMod p
-- (GaloisField.card, GaloisField.splits_zmod_X_pow_sub_X). Stated as an
-- existence theorem; no field is chosen.
theorem GaloisField.exists (p n : Nat)
  requires prime : Prime(p)
  requires positive : 0 < n
  shows ∃ E, Algebra.base(E) = zmod(p) ∧
    IsSplittingField(E, polyXPowSubX(zmod(p), p ^ n)) ∧
    FiniteField(Algebra.ring(E)) ∧ HasCardinality(algebraCarrier(E), p ^ n)
proof
  sorry

-- Helpers: the relative Frobenius x ↦ x^q is the iterated Frobenius
-- x ↦ x^(p^m) for |K| = p^m, and an automorphism of L over K.
theorem tkJ.relFrob.iterate (E : Set)
  requires extension : FieldExtension(E)
  requires finiteBase : FiniteField(Algebra.base(E))
  requires finiteTop : FiniteField(Algebra.ring(E))
  shows ∃ p ∈ ℕ, ∃ m ∈ ℕ, Prime(p) ∧ CharP(Algebra.ring(E), p) ∧
    cardinality(Ring.carrier(Algebra.base(E))) = p ^ m ∧
    relativeFrobenius(E) = iterateFrobenius(Algebra.ring(E), p, m)
proof
  have ext0 := extension
  obtain ⟨alg, baseField, topField⟩ := ext0
  have commK := Field.to_comm_ring at Algebra.base(E) with baseField
  have commL := Field.to_comm_ring at Algebra.ring(E) with topField
  have cp := FiniteField.char_prime at Algebra.base(E) with commK, finiteBase
  obtain ⟨pr, spec⟩ := cp
  have pNat : Nat(ringChar(Algebra.base(E))) by typecheck
  have pN : ringChar(Algebra.base(E)) ∈ ℕ by typecheck
  have hom := Algebra.structure_hom with alg
  have inj := FieldExtension.map_injective at E with extension
  unfold algebraCarrier at inj
  have charL := CharP.of_injective_hom at Algebra.base(E), Algebra.ring(E), Algebra.map(E), ringChar(Algebra.base(E)) with commK, spec, hom, inj
  have card := FiniteField.card at Algebra.base(E) with finiteBase
  obtain ⟨m, mN, _, hc⟩ := card
  have mNat : Nat(m) by typecheck
  have qEq := cardinality.eq_of_has with hc
  have frobEq : relativeFrobenius(E) = iterateFrobenius(Algebra.ring(E), ringChar(Algebra.base(E)), m)
    ext u
    constructor
    . intro h
      obtain ⟨x, xIn, e⟩ := relativeFrobenius.membership.forward with h
      apply iterateFrobenius.membership.backward
      unfold algebraCarrier at xIn
      rw qEq at e
      exact ⟨x, xIn, e⟩
    . intro h
      obtain ⟨x, xIn, e⟩ := iterateFrobenius.membership.forward with h
      apply relativeFrobenius.membership.backward
      have xIn2 : x ∈ algebraCarrier(E)
        unfold algebraCarrier
        exact xIn
      rw qEq
      exact ⟨x, xIn2, e⟩
  exact ⟨ringChar(Algebra.base(E)), pN, m, mN, pr, charL, qEq, frobEq⟩

theorem tkJ.relFrob.apply (E x : Set)
  requires extension : FieldExtension(E)
  requires point : x ∈ algebraCarrier(E)
  shows relativeFrobenius(E)(x) = Ring.pow(Algebra.ring(E), x, cardinality(Ring.carrier(Algebra.base(E))))
proof
  have ext0 := extension
  obtain ⟨alg, baseField, topField⟩ := ext0
  have commL := Field.to_comm_ring at Algebra.ring(E) with topField
  have ringL := CommRing.to_ring with commL
  have fun : relativeFrobenius(E) : algebraCarrier(E) → algebraCarrier(E)
    apply tkJ.fin_graph_function
    . intros u uIn
      obtain ⟨y, yIn, e⟩ := relativeFrobenius.membership.forward with uIn
      have yL : y ∈ Ring.carrier(Algebra.ring(E))
        unfold algebraCarrier at yIn
        exact yIn
      have pIn : Ring.pow(Algebra.ring(E), y, cardinality(Ring.carrier(Algebra.base(E)))) ∈ algebraCarrier(E)
        unfold algebraCarrier
        typecheck
      rw ← e
      exact product.pair with yIn, pIn
    . intros a b c hb hc
      obtain ⟨y, yIn, ey⟩ := relativeFrobenius.membership.forward with hb
      obtain ⟨z, zIn, ez⟩ := relativeFrobenius.membership.forward with hc
      obtain ⟨ay, by1⟩ := orderedPair.injective with ey
      obtain ⟨az, cz⟩ := orderedPair.injective with ez
      rw [← by1, ← cz, ay, az]
    . intros y yIn
      have yL : y ∈ Ring.carrier(Algebra.ring(E))
        unfold algebraCarrier at yIn
        exact yIn
      have pIn : Ring.pow(Algebra.ring(E), y, cardinality(Ring.carrier(Algebra.base(E)))) ∈ algebraCarrier(E)
        unfold algebraCarrier
        typecheck
      refine ⟨Ring.pow(Algebra.ring(E), y, cardinality(Ring.carrier(Algebra.base(E)))), pIn, ?_⟩
      apply relativeFrobenius.membership.backward
      exact ⟨y, yIn, rfl⟩
  have rel : relates(relativeFrobenius(E), x, Ring.pow(Algebra.ring(E), x, cardinality(Ring.carrier(Algebra.base(E)))))
    unfold relates
    apply relativeFrobenius.membership.backward
    exact ⟨x, point, rfl⟩
  exact FunctionBetween.apply_value with fun, point, rel

theorem tkJ.relFrob.mem (E : Set)
  requires extension : FieldExtension(E)
  requires finiteBase : FiniteField(Algebra.base(E))
  requires finiteTop : FiniteField(Algebra.ring(E))
  shows relativeFrobenius(E) ∈ algebraAutomorphisms(E)
proof
  have ext0 := extension
  obtain ⟨alg, baseField, topField⟩ := ext0
  have commK := Field.to_comm_ring at Algebra.base(E) with baseField
  have commL := Field.to_comm_ring at Algebra.ring(E) with topField
  have ringK := CommRing.to_ring with commK
  have ringL := CommRing.to_ring with commL
  have it := tkJ.relFrob.iterate at E with extension, finiteBase, finiteTop
  obtain ⟨p, pN, m, mN, pr, charL, qEq, frobEq⟩ := it
  have pNat : Nat(p) by typecheck
  have mNat : Nat(m) by typecheck
  have homs := frobenius.hom at Algebra.ring(E), p with commL, charL, pr
  obtain ⟨_, its⟩ := homs
  have rh := its with m, mN
  rw ← frobEq at rh
  have hom := Algebra.structure_hom with alg
  have fixes : ∀ a ∈ Ring.carrier(Algebra.base(E)), relativeFrobenius(E)(Algebra.map(E)(a)) = Algebra.map(E)(a)
    intros a aIn
    have maIn : Algebra.map(E)(a) ∈ algebraCarrier(E)
      unfold algebraCarrier
      exact RingHom.map_mem with hom, aIn
    rw (tkJ.relFrob.apply at E, Algebra.map(E)(a) with extension, maIn)
    rw ← (tkJ.hom_pow at Algebra.map(E), Algebra.base(E), Algebra.ring(E), a, cardinality(Ring.carrier(Algebra.base(E))) with hom, aIn)
    rw (tkJ.finiteField.pow_card_self at Algebra.base(E), a with finiteBase, aIn)
  have ahom : relativeFrobenius(E) : E →ₐ E
    unfold AlgebraHom
    exact ⟨alg, alg, rfl, rh, fixes⟩
  have perfect := FiniteField.perfect at Algebra.ring(E), p with commL, finiteTop, charL
  have uniq := tkJ.perfect.root_unique at Algebra.ring(E), p, m with perfect
  have fun := AlgebraHom.function with ahom
  have inj : InjectiveBetween(relativeFrobenius(E), algebraCarrier(E), algebraCarrier(E))
    refine ⟨fun, ?_⟩
    intros x xIn y yIn z zIn rx ry
    have fx := FunctionBetween.apply_value with fun, xIn, rx
    have fy := FunctionBetween.apply_value with fun, yIn, ry
    rw (tkJ.relFrob.apply at E, x with extension, xIn) at fx
    rw (tkJ.relFrob.apply at E, y with extension, yIn) at fy
    rw qEq at fx
    rw qEq at fy
    rw ← fy at fx
    have xL : x ∈ Ring.carrier(Algebra.ring(E))
      unfold algebraCarrier at xIn
      exact xIn
    have yL : y ∈ Ring.carrier(Algebra.ring(E))
      unfold algebraCarrier at yIn
      exact yIn
    exact uniq with x, xL, y, yL, fx
  have finL : Finite(algebraCarrier(E))
    unfold algebraCarrier
    exact finiteTop.right
  have surj := tkJ.finite_injective_onto with finL, inj
  have iso : relativeFrobenius(E) : E ≃ₐ E
    unfold AlgebraIso
    exact ⟨ahom, inj, surj⟩
  exact (tkJ.aut_member at E, relativeFrobenius(E)).backward with iso

theorem tkJ.relFrob.pow (E : Set) (i : Nat)
  requires extension : FieldExtension(E)
  requires finiteBase : FiniteField(Algebra.base(E))
  requires finiteTop : FiniteField(Algebra.ring(E))
  shows groupPow(galoisGroup(E), relativeFrobenius(E), i) ∈ algebraAutomorphisms(E) ∧
    (∀ x ∈ algebraCarrier(E), groupPow(galoisGroup(E), relativeFrobenius(E), i)(x) =
      Ring.pow(Algebra.ring(E), x, cardinality(Ring.carrier(Algebra.base(E))) ^ i))
proof
  have group := galoisGroup.group at E with extension
  have σIn := tkJ.relFrob.mem at E with extension, finiteBase, finiteTop
  have σG : relativeFrobenius(E) ∈ Group.carrier(galoisGroup(E))
    rw tkJ.galois_carrier
    exact σIn
  have finK := finiteBase.right
  have qNat := cardinality.nat with finK
  induction i
  | zero =>
    have z := pow_zero at galoisGroup(E), relativeFrobenius(E) with group, σG
    rw z
    have oneG : Group.one(galoisGroup(E)) ∈ Group.carrier(galoisGroup(E)) by typecheck
    rw tkJ.galois_carrier at oneG
    refine ⟨oneG, ?_⟩
    intros x xIn
    rw z
    rw (galoisGroup.one_apply at E, x with extension, xIn)
    rw pow.zero
    have ext0 := extension
    obtain ⟨_, _, topField⟩ := ext0
    have commL := Field.to_comm_ring at Algebra.ring(E) with topField
    have ringL := CommRing.to_ring with commL
    have xL : x ∈ Ring.carrier(Algebra.ring(E))
      unfold algebraCarrier at xIn
      exact xIn
    symm
    exact Ring.pow_one at Algebra.ring(E), x with ringL, xL
  | succ(k) using ih =>
    have shift := add.right_one at k with *
    rw ← shift
    obtain ⟨kIn, kApply⟩ := ih
    have kG : groupPow(galoisGroup(E), relativeFrobenius(E), k) ∈ Group.carrier(galoisGroup(E))
      rw tkJ.galois_carrier
      exact kIn
    rw (pow_succ at galoisGroup(E), relativeFrobenius(E), k with group, σG)
    have mIn : Group.mul(galoisGroup(E))(groupPow(galoisGroup(E), relativeFrobenius(E), k), relativeFrobenius(E)) ∈ Group.carrier(galoisGroup(E)) by typecheck
    rw tkJ.galois_carrier at mIn
    refine ⟨mIn, ?_⟩
    intros x xIn
    rw ← shift
    rw (pow_succ at galoisGroup(E), relativeFrobenius(E), k with group, σG)
    rw (galoisGroup.mul_apply at E, groupPow(galoisGroup(E), relativeFrobenius(E), k), relativeFrobenius(E), x with extension, kIn, σIn, xIn)
    have ext0 := extension
    obtain ⟨_, _, topField⟩ := ext0
    have commL := Field.to_comm_ring at Algebra.ring(E) with topField
    have ringL := CommRing.to_ring with commL
    have xL : x ∈ Ring.carrier(Algebra.ring(E))
      unfold algebraCarrier at xIn
      exact xIn
    rw (tkJ.relFrob.apply at E, x with extension, xIn)
    have pIn : Ring.pow(Algebra.ring(E), x, cardinality(Ring.carrier(Algebra.base(E)))) ∈ algebraCarrier(E)
      unfold algebraCarrier
      typecheck
    rw (kApply with Ring.pow(Algebra.ring(E), x, cardinality(Ring.carrier(Algebra.base(E)))), pIn)
    rw ← (Ring.pow_mul at Algebra.ring(E), x, cardinality(Ring.carrier(Algebra.base(E))), cardinality(Ring.carrier(Algebra.base(E))) ^ k with ringL, xL)
    rw (pow.add_one at cardinality(Ring.carrier(Algebra.base(E))), k)

-- Helper: X^N − X for N ≥ 2 is a nonzero polynomial of degree N whose
-- value at a is a^N − a.
theorem tkJ.xPowSubX.facts (K : Set) (N : Nat)
  requires field : Field(K)
  requires large : 2 ≤ N
  shows polyXPowSubX(K, N) ∈ Ring.carrier(polynomialRing(K, {0})) ∧
    polyXPowSubX(K, N) ≠ Ring.zero(polynomialRing(K, {0})) ∧
    polyNatDegree(K, polyXPowSubX(K, N)) = N ∧
    (∀ a ∈ Ring.carrier(K), polyEval(K, polyXPowSubX(K, N), a) =
      Ring.sub(K, Ring.pow(K, a, N), a))
proof
  have comm := Field.to_comm_ring at K with field
  have ring := CommRing.to_ring with comm
  have polys := polynomialRing.comm_ring at K, {0} with comm
  have pr := CommRing.to_ring with polys
  have dom := Field.domain at K with field
  obtain ⟨_, nt, _⟩ := dom
  have oK : Ring.one(K) ∈ Ring.carrier(K) by typecheck
  have nN : N ∈ ℕ by typecheck
  have xIn := polyX.mem at K with comm, polys
  have xq : Ring.pow(polynomialRing(K, {0}), polyX(K), N) ∈ Ring.carrier(polynomialRing(K, {0})) by typecheck
  have fIn : polyXPowSubX(K, N) ∈ Ring.carrier(polynomialRing(K, {0}))
    unfold polyXPowSubX
    typecheck
  have coeff : ∀ k ∈ ℕ, polyCoeff(polyXPowSubX(K, N), k) = polyCoeff(Ring.pow(polynomialRing(K, {0}), polyX(K), N), k) - polyCoeff(polyX(K), k)
    intros k hk
    have kNat := nat.omega.backward with hk
    unfold polyXPowSubX
    exact uni.coeff_sub at K, Ring.pow(polynomialRing(K, {0}), polyX(K), N), polyX(K), k with comm, polys, xq, xIn
  have top : polyCoeff(polyXPowSubX(K, N), N) = Ring.one(K)
    rw (coeff with N, nN)
    rw (uni.X_pow at K, N with comm, polys)
    have en : N = N by rfl
    rw ((uni.term_coeff at K, Ring.one(K), N, N with comm, polys, oK).left with en)
    have n1 : N ≠ 1 by arith
    rw ((uni.X_coeff at K, N with comm, polys).right with n1)
    ring
  have vanish : ∀ k ∈ ℕ, N < k → polyCoeff(polyXPowSubX(K, N), k) = Ring.zero(K)
    intros k hk lt
    have kNat := nat.omega.backward with hk
    rw (coeff with k, hk)
    rw (uni.X_pow at K, N with comm, polys)
    have kn : k ≠ N by arith
    have k1 : k ≠ 1 by arith
    rw ((uni.term_coeff at K, Ring.one(K), N, k with comm, polys, oK).right with kn)
    rw ((uni.X_coeff at K, k with comm, polys).right with k1)
    ring
  have r := uni.monic_of at K, polyXPowSubX(K, N), N with comm, polys, fIn, top, vanish
  obtain ⟨monic, degImp⟩ := r
  have deg := degImp with nt
  have nz := PolyMonic.ne_zero at K, polyXPowSubX(K, N) with comm, polys, fIn, nt, monic
  have ev : ∀ a ∈ Ring.carrier(K), polyEval(K, polyXPowSubX(K, N), a) = Ring.sub(K, Ring.pow(K, a, N), a)
    intros a aK
    have h := polyEval.hom at K, a with comm, polys, aK
    have e1 := polyEval.X at K, a with comm, polys, aK
    unfold polyEval at e1
    unfold polyEval
    unfold polyXPowSubX
    rw (RingHom.map_sub at evaluationAt(K, {0}, constantFunction({0}, Ring.carrier(K), a)), polynomialRing(K, {0}), K, Ring.pow(polynomialRing(K, {0}), polyX(K), N), polyX(K) with h, xq, xIn)
    rw (tkJ.hom_pow at evaluationAt(K, {0}, constantFunction({0}, Ring.carrier(K), a)), polynomialRing(K, {0}), K, polyX(K), N with h, xIn)
    rw e1
  exact ⟨fIn, nz, deg, ev⟩

-- Section: Extensions of finite fields
section FiniteExtensions
variable (E : Set)
hypothesis extension : FieldExtension(E)
hypothesis finiteBase : FiniteField(Algebra.base(E))
hypothesis finiteTop : FiniteField(Algebra.ring(E))

-- |L| = |K|^[L:K] (FiniteField.pow_finrank_eq_natCard, card_eq_pow_finrank).
theorem FiniteField.card_extension
  shows FiniteExtension(E) ∧
    cardinality(algebraCarrier(E)) =
      cardinality(Ring.carrier(Algebra.base(E))) ^ extensionDegree(E)
proof
  have ce := tkJ.finiteField.card_extension at E with extension, finiteBase, finiteTop
  obtain ⟨fe, _, eq⟩ := ce
  exact ⟨fe, eq⟩

-- An extension of finite fields is Galois (GaloisField.instIsGaloisOfFinite).
theorem FiniteField.galois
  shows GaloisExtension(E)
proof
  sorry

-- The relative Frobenius x ↦ x^q is a K-automorphism of L of order
-- [L : K], and Gal(L/K) consists of its powers
-- (FiniteField.frobeniusAlgEquivOfAlgebraic, orderOf_frobeniusAlgHom,
-- bijective_frobeniusAlgHom_pow, FiniteField.exists_forall_apply_eq_pow).
theorem relativeFrobenius.automorphism
  shows relativeFrobenius(E) ∈ algebraAutomorphisms(E) ∧
    groupPow(galoisGroup(E), relativeFrobenius(E), extensionDegree(E)) =
      Group.one(galoisGroup(E)) ∧
    (∀ i ∈ ℕ, 0 < i → i < extensionDegree(E) →
      groupPow(galoisGroup(E), relativeFrobenius(E), i) ≠ Group.one(galoisGroup(E)))
proof
  have ext0 := extension
  obtain ⟨alg, baseField, topField⟩ := ext0
  have commL := Field.to_comm_ring at Algebra.ring(E) with topField
  have ringL := CommRing.to_ring with commL
  have σIn := tkJ.relFrob.mem at E with extension, finiteBase, finiteTop
  have group := galoisGroup.group at E with extension
  have oneG : Group.one(galoisGroup(E)) ∈ Group.carrier(galoisGroup(E)) by typecheck
  rw tkJ.galois_carrier at oneG
  have ce := tkJ.finiteField.card_extension at E with extension, finiteBase, finiteTop
  obtain ⟨_, dN, cardEq⟩ := ce
  have dNat : Nat(extensionDegree(E)) by typecheck
  have finK := finiteBase.right
  have qNat := cardinality.nat with finK
  have q2 := tkJ.finiteField.card_ge_two at Algebra.base(E) with finiteBase
  have top : groupPow(galoisGroup(E), relativeFrobenius(E), extensionDegree(E)) = Group.one(galoisGroup(E))
    have pw := tkJ.relFrob.pow at E, extensionDegree(E) with extension, finiteBase, finiteTop
    obtain ⟨pIn, pApply⟩ := pw
    apply galoisGroup.ext at E with extension, pIn, oneG
    intros x xIn
    rw (pApply with x, xIn)
    rw (galoisGroup.one_apply at E, x with extension, xIn)
    rw ← cardEq
    have xL : x ∈ Ring.carrier(Algebra.ring(E))
      unfold algebraCarrier at xIn
      exact xIn
    have self := tkJ.finiteField.pow_card_self at Algebra.ring(E), x with finiteTop, xL
    unfold algebraCarrier
    exact self
  have proper : ∀ i ∈ ℕ, 0 < i → i < extensionDegree(E) → groupPow(galoisGroup(E), relativeFrobenius(E), i) ≠ Group.one(galoisGroup(E))
    intros i iN pos lt e
    have iNat : Nat(i) by typecheck
    have pw := tkJ.relFrob.pow at E, i with extension, finiteBase, finiteTop
    obtain ⟨pIn, pApply⟩ := pw
    have qi : 2 ≤ cardinality(Ring.carrier(Algebra.base(E))) ^ i
      have one : 1 ≤ cardinality(Ring.carrier(Algebra.base(E))) by arith
      obtain ⟨j, jNat, ij⟩ := Less.exists_add_one at 0, i with pos
      have ij2 : i = j + 1 by arith
      rw ij2
      have le := pow.le_self at cardinality(Ring.carrier(Algebra.base(E))), j with one
      arith
    have facts := tkJ.xPowSubX.facts at Algebra.ring(E), cardinality(Ring.carrier(Algebra.base(E))) ^ i with topField, qi
    obtain ⟨fIn, nz, deg, ev⟩ := facts
    have roots : Ring.carrier(Algebra.ring(E)) ⊆ polyRootSet(Algebra.ring(E), polyXPowSubX(Algebra.ring(E), cardinality(Ring.carrier(Algebra.base(E))) ^ i))
      intros x xL
      apply polyRootSet.membership.backward
      refine ⟨xL, ?_⟩
      rw (ev with x, xL)
      have xIn : x ∈ algebraCarrier(E)
        unfold algebraCarrier
        exact xL
      have fx := pApply with x, xIn
      rw e at fx
      rw (galoisGroup.one_apply at E, x with extension, xIn) at fx
      rw ← fx
      ring
    have dom := Field.domain at Algebra.ring(E) with topField
    have polys := polynomialRing.comm_ring at Algebra.ring(E), {0} with commL
    have finL := finiteTop.right
    have hc := cardinality.correct with finL
    have le := polyRootSet.card_le at Algebra.ring(E), polyXPowSubX(Algebra.ring(E), cardinality(Ring.carrier(Algebra.base(E))) ^ i), Ring.carrier(Algebra.ring(E)), cardinality(Ring.carrier(Algebra.ring(E))) with dom, polys, fIn, nz, roots, hc
    rw deg at le
    unfold algebraCarrier at cardEq
    rw cardEq at le
    have gt1 : 1 < cardinality(Ring.carrier(Algebra.base(E))) by arith
    have strict := pow.exponent_strict at cardinality(Ring.carrier(Algebra.base(E))), i, extensionDegree(E) with gt1, lt
    arith
  exact ⟨σIn, top, proper⟩

theorem relativeFrobenius.generates (σ : Set)
  requires automorphism : σ ∈ algebraAutomorphisms(E)
  shows ∃ i ∈ ℕ, i < extensionDegree(E) ∧
    σ = groupPow(galoisGroup(E), relativeFrobenius(E), i)
proof
  sorry

theorem relativeFrobenius.cyclic
  shows CyclicGroup(galoisGroup(E))
proof
  sorry

-- FiniteField.nonempty_algHom_of_finrank_dvd: a finite extension M of K
-- of degree dividing [L : K] embeds in L over K.
theorem FiniteField.embedding_of_degree_dvd (E2 : Set)
  requires second : FieldExtension(E2)
  requires sameBase : Algebra.base(E2) = Algebra.base(E)
  requires finiteSecond : FiniteExtension(E2)
  requires divides : extensionDegree(E2) ∣ extensionDegree(E)
  shows ∃ f, f : E2 →ₐ E
proof
  sorry

end FiniteExtensions
