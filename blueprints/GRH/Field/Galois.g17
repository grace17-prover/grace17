-- Finite Galois theory: field extensions as algebras between fields, the
-- degree [L : K], intermediate fields and adjunction, the minimal
-- polynomial, separable polynomials and extensions, splitting of
-- polynomials, normal and Galois extensions, the Galois group
-- Gal(L/K) = Aut_K(L), fixed fields and fixing subgroups, the fundamental
-- theorem, restriction to normal subextensions, primitive elements,
-- splitting fields, algebraically closed fields and algebraic closures.
-- Part of the GRH blueprint.
-- Planned home: Algebra/Field/Galois.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Field.Galois
import GRH.Algebra.Integral
import Grace.Cumulus.Algebra.Group.Lagrange
import Grace.Cumulus.Algebra.Group.Normal

-- Section: Field extensions
-- An extension L/K is a Cumulus Algebra E whose base K = Algebra.base(E)
-- and ring L = Algebra.ring(E) are fields; the structure map
-- Algebra.map(E) : K → L is Mathlib's algebraMap K L. Mathlib's
-- typeclass pair [Field K] [Field L] [Algebra K L] is this one set.
predicate FieldExtension (E : Set) :=
  Algebra(E) ∧ Field(Algebra.base(E)) ∧ Field(Algebra.ring(E))

-- The degree [L : K] (Module.finrank K L), meaningful when the extension
-- is finite; and finite and algebraic extensions (FiniteDimensional K L,
-- Algebra.IsAlgebraic K L).
def extensionDegree (E : Set) : Set := finrank(algebraModule(E), Algebra.base(E))

predicate FiniteExtension (E : Set) :=
  FieldExtension(E) ∧ FiniteDimensional(algebraModule(E), Algebra.base(E))

predicate AlgebraicExtension (E : Set) :=
  FieldExtension(E) ∧ AlgebraicAlgebra(E)

-- The polynomials K[X] over a ring, as a carrier.
def uniPolys (R : Set) : Set := Ring.carrier(polynomialRing(R, {0}))

-- Section: Intermediate fields
-- An intermediate field K ≤ F ≤ L (Mathlib's IntermediateField K L) is a
-- subset F of L that is a K-subalgebra closed under inverses.
predicate IntermediateField (E F : Set) :=
  FieldExtension(E) ∧ SubalgebraOf(E, F) ∧
  (∀ x ∈ F, x ≠ Ring.zero(Algebra.ring(E)) →
    (∃ y ∈ F, call2(Ring.mul(Algebra.ring(E)), x, y) = Ring.one(Algebra.ring(E))))

def intermediateFields (E : Set) : Set :=
  { F ∈ 𝒫(algebraCarrier(E)) | IntermediateField(E, F) }

-- ⊥ = the image of K (IntermediateField ⊥); ⊤ is algebraCarrier(E).
def bottomField (E : Set) : Set :=
  functionImage(Algebra.map(E), Ring.carrier(Algebra.base(E)), algebraCarrier(E))

-- K(S), the least intermediate field containing S (IntermediateField.adjoin);
-- the join F ⊔ G is fieldAdjoin(E, F ∪ G).
def fieldAdjoin (E S : Set) : Set :=
  { x ∈ algebraCarrier(E) | ∀ F ∈ intermediateFields(E), S ⊆ F → x ∈ F }

-- An intermediate field F as the extension F/K (Mathlib's coercion of F
-- to a field with its K-algebra structure), and L as the extension L/F
-- (the tower K ≤ F ≤ L, IsScalarTower K F L).
def subextension (E F : Set) : Set :=
  Algebra.mk(Algebra.base(E), subringRing(Algebra.ring(E), F), Algebra.map(E))

def overExtension (E F : Set) : Set :=
  Algebra.mk(subringRing(Algebra.ring(E), F), Algebra.ring(E), identity(F))

-- Section: The Galois group
-- Gal(L/K) = L ≃ₐ[K] L, the K-algebra automorphisms of L, under
-- composition: (σ τ)(x) = σ(τ(x)), as Mathlib's AlgEquiv.aut.
def algebraAutomorphisms (E : Set) : Set :=
  { σ ∈ functionSpace(algebraCarrier(E), algebraCarrier(E)) | AlgebraIso(σ, E, E) }

def autComposition (E : Set) : Set :=
  { p ∈ (algebraAutomorphisms(E) × algebraAutomorphisms(E)) × algebraAutomorphisms(E) |
    snd(p) = compose(fst(fst(p)), snd(fst(p)), algebraCarrier(E),
      algebraCarrier(E), algebraCarrier(E)) }

def autInverse (E : Set) : Set :=
  { p ∈ algebraAutomorphisms(E) × algebraAutomorphisms(E) |
    snd(p) = converse(fst(p), algebraCarrier(E), algebraCarrier(E)) }

def galoisGroup (E : Set) : Set :=
  Group.mk(algebraAutomorphisms(E), autComposition(E),
    identity(algebraCarrier(E)), autInverse(E))

-- The fixed field of a set H of automorphisms (IntermediateField.fixedField,
-- FixedPoints.intermediateField) and the fixing subgroup of a subset F
-- of L (IntermediateField.fixingSubgroup, fixingSubgroup).
def fixedField (E H : Set) : Set :=
  { x ∈ algebraCarrier(E) | ∀ σ ∈ H, σ(x) = x }

def fixingSubgroup (E F : Set) : Set :=
  { σ ∈ algebraAutomorphisms(E) | ∀ x ∈ F, σ(x) = x }

-- The image σ(F) of a subset (IntermediateField.map).
def autImage (E σ F : Set) : Set := functionImage(σ, F, algebraCarrier(E))

-- Restriction of automorphisms to a normal intermediate field F
-- (AlgEquiv.restrictNormalHom): σ ↦ σ|_F, an automorphism of F/K.
def galoisRestrict (E F : Set) : Set :=
  { p ∈ algebraAutomorphisms(E) × algebraAutomorphisms(subextension(E, F)) |
    ∃ σ ∈ algebraAutomorphisms(E), p = (σ, restrict(σ, F)) }

-- Section: Minimal polynomials, separability, splitting
-- The minimal polynomial of x ∈ L over K (minpoly K x): the monic
-- generator of the polynomials vanishing at x. Defined for x integral
-- over K; Mathlib's value 0 at a transcendental x is not part of the
-- definition.
-- Helpers: inverses in a field are unique.
theorem tkJ.field_inverse (R x : Set)
  requires field : Field(R)
  requires member : x ∈ Ring.carrier(R)
  requires nonzero : x ≠ Ring.zero(R)
  shows ∃ y ∈ Ring.carrier(R), call2(Ring.mul(R), x, y) = Ring.one(R)
proof
  have parts := Field.parts with field
  obtain ⟨y, inverse⟩ := IsField.inverse_exists with parts, member, nonzero
  obtain ⟨xIn, yIn, left, right⟩ := inverse
  exact ⟨y, yIn, right⟩

theorem tkJ.inverse_unique (R x y z : Set)
  requires comm : CommRing(R)
  requires xIn : x ∈ Ring.carrier(R)
  requires yIn : y ∈ Ring.carrier(R)
  requires zIn : z ∈ Ring.carrier(R)
  requires first : call2(Ring.mul(R), x, y) = Ring.one(R)
  requires second : call2(Ring.mul(R), x, z) = Ring.one(R)
  shows y = z
proof
  have e1 : y * (x * z) = (x * y) * z by ring
  have e2 : y * Ring.one(R) = y by ring
  have e3 : Ring.one(R) * z = z by ring
  rw [first, second] at e1
  cc

-- Helpers for the minimal polynomial: evaluation in an algebra as a ring
-- homomorphism, and the monic rescaling of a nonzero polynomial.
theorem tkJ.gal_aeval_hom (A x : Set)
  requires algebra : Algebra(A)
  requires point : x ∈ algebraCarrier(A)
  shows evaluationHom(Algebra.base(A), Algebra.ring(A), {0}, Algebra.map(A),
      constantFunction({0}, Ring.carrier(Algebra.ring(A)), x)) :
    polynomialRing(Algebra.base(A), {0}) →+* Algebra.ring(A)
proof
  have base := Algebra.base_comm_ring with algebra
  have polysK := polynomialRing.comm_ring at Algebra.base(A), {0} with base
  have ringA := Algebra.comm_ring with algebra
  have sh := Algebra.structure_hom with algebra
  have pt := point
  unfold algebraCarrier at pt
  exact polyEval2.hom at Algebra.base(A), Algebra.ring(A), Algebra.map(A), x with
    base, polysK, ringA, sh, pt

theorem tkJ.gal_aeval_mul (A x p q : Set)
  requires algebra : Algebra(A)
  requires point : x ∈ algebraCarrier(A)
  requires first : p ∈ uniPolys(Algebra.base(A))
  requires second : q ∈ uniPolys(Algebra.base(A))
  shows polyAeval(A, x, call2(Ring.mul(polynomialRing(Algebra.base(A), {0})), p, q)) =
    call2(Ring.mul(Algebra.ring(A)), polyAeval(A, x, p), polyAeval(A, x, q))
proof
  have hom := tkJ.gal_aeval_hom with algebra, point
  unfold uniPolys at first
  unfold uniPolys at second
  unfold polyAeval
  unfold polyEval2
  exact RingHom.map_mul with hom, first, second

theorem tkJ.gal_aeval_add (A x p q : Set)
  requires algebra : Algebra(A)
  requires point : x ∈ algebraCarrier(A)
  requires first : p ∈ uniPolys(Algebra.base(A))
  requires second : q ∈ uniPolys(Algebra.base(A))
  shows polyAeval(A, x, call2(Ring.add(polynomialRing(Algebra.base(A), {0})), p, q)) =
    call2(Ring.add(Algebra.ring(A)), polyAeval(A, x, p), polyAeval(A, x, q))
proof
  have hom := tkJ.gal_aeval_hom with algebra, point
  unfold uniPolys at first
  unfold uniPolys at second
  unfold polyAeval
  unfold polyEval2
  exact RingHom.map_add with hom, first, second

theorem tkJ.gal_aeval_mem (A x p : Set)
  requires algebra : Algebra(A)
  requires point : x ∈ algebraCarrier(A)
  requires member : p ∈ uniPolys(Algebra.base(A))
  shows polyAeval(A, x, p) ∈ Ring.carrier(Algebra.ring(A))
proof
  have hom := tkJ.gal_aeval_hom with algebra, point
  unfold uniPolys at member
  unfold polyAeval
  unfold polyEval2
  exact RingHom.map_mem with hom, member

theorem tkJ.gal_monic_rescale (K r : Set)
  requires field : Field(K)
  requires member : r ∈ uniPolys(K)
  requires nonzero : r ≠ Ring.zero(polynomialRing(K, {0}))
  shows ∃ c ∈ Ring.carrier(K),
    PolyMonic(K, call2(Ring.mul(polynomialRing(K, {0})), polyC(K, c), r)) ∧
    polyNatDegree(K, call2(Ring.mul(polynomialRing(K, {0})), polyC(K, c), r)) =
      polyNatDegree(K, r)
proof
  have comm := Field.to_comm_ring with field
  have polys := polynomialRing.comm_ring at K, {0} with comm
  have domain := Field.domain with field
  have rIn := member
  unfold uniPolys at rIn
  have spec := uni.deg_spec at K, r with comm, polys, rIn
  have leadNonzero := spec.right with nonzero
  have leadIn := uni.coeff_mem at K, r, polyNatDegree(K, r) with comm, rIn
  obtain ⟨c, cIn, product⟩ := tkJ.field_inverse with field, leadIn, leadNonzero
  have parts := Field.parts with field
  have nt := IsField.nontrivial with parts
  obtain ⟨_, _, distinct⟩ := nt
  have cNonzero : c ≠ Ring.zero(K)
    intro cz
    rw cz at product
    have z : polyCoeff(r, polyNatDegree(K, r)) * Ring.zero(K) = Ring.zero(K) by ring
    rw z at product
    exact distinct with product
  have cpIn := polyC.mem at K, c with comm, polys, cIn
  have cpNonzero : polyC(K, c) ≠ Ring.zero(polynomialRing(K, {0}))
    intro cz
    have zeroIn : Ring.zero(K) ∈ Ring.carrier(K) by typecheck
    have hom := polyC.hom at K with comm, polys
    have mz := RingHom.map_zero with hom
    have zz : polyC(K, Ring.zero(K)) = Ring.zero(polynomialRing(K, {0}))
      unfold polyC
      exact mz
    rw ← zz at cz
    have same := polyC.injective at K, c, Ring.zero(K) with comm, polys, cIn, zeroIn, cz
    exact cNonzero with same
  have degMul := polyNatDegree.mul at K, polyC(K, c), r with comm, polys, cpIn, rIn,
    domain, cpNonzero, nonzero
  have degC := polyNatDegree.C at K, c with comm, polys, cIn
  rw degC at degMul
  have leadMul := polyLeadingCoeff.mul at K, polyC(K, c), r with comm, polys, cpIn, rIn,
    domain
  have leadC : polyLeadingCoeff(K, polyC(K, c)) = c
    rw (uni.lead_eq at K, polyC(K, c) with comm, polys)
    rw degC
    have coefficient := polyC.coeff at K, c, 0 with comm, polys, cIn
    exact coefficient.left with rfl
  rw (uni.lead_eq at K, r with comm, polys) at leadMul
  rw leadC at leadMul
  have swap : c * polyCoeff(r, polyNatDegree(K, r)) =
    polyCoeff(r, polyNatDegree(K, r)) * c by ring
  rw [swap, product] at leadMul
  have mulIn : call2(Ring.mul(polynomialRing(K, {0})), polyC(K, c), r) ∈
    Ring.carrier(polynomialRing(K, {0})) by typecheck
  refine ⟨c, cIn, ?_, ?_⟩
  . unfold PolyMonic
    exact ⟨mulIn, leadMul⟩
  . rw degMul
    arith

-- The remainder of a root-vanishing division vanishes at x.
theorem tkJ.gal_aeval_decomp (A x q d p r : Set)
  requires algebra : Algebra(A)
  requires point : x ∈ algebraCarrier(A)
  requires qIn : q ∈ uniPolys(Algebra.base(A))
  requires dIn : d ∈ uniPolys(Algebra.base(A))
  requires pIn : p ∈ uniPolys(Algebra.base(A))
  requires rIn : r ∈ uniPolys(Algebra.base(A))
  requires decomp : q = call2(Ring.add(polynomialRing(Algebra.base(A), {0})),
    call2(Ring.mul(polynomialRing(Algebra.base(A), {0})), d, p), r)
  requires qRoot : polyAeval(A, x, q) = Ring.zero(Algebra.ring(A))
  requires pRoot : polyAeval(A, x, p) = Ring.zero(Algebra.ring(A))
  shows polyAeval(A, x, r) = Ring.zero(Algebra.ring(A))
proof
  have ringA := Algebra.comm_ring with algebra
  have base := Algebra.base_comm_ring with algebra
  have polys := polynomialRing.comm_ring at Algebra.base(A), {0} with base
  have dp : call2(Ring.mul(polynomialRing(Algebra.base(A), {0})), d, p) ∈
      uniPolys(Algebra.base(A))
    unfold uniPolys
    unfold uniPolys at dIn
    unfold uniPolys at pIn
    typecheck
  have sum := tkJ.gal_aeval_add with algebra, point, dp, rIn
  have product := tkJ.gal_aeval_mul with algebra, point, dIn, pIn
  have dL := tkJ.gal_aeval_mem with algebra, point, dIn
  have rL := tkJ.gal_aeval_mem with algebra, point, rIn
  rw [← decomp, qRoot, product, pRoot] at sum
  have z : polyAeval(A, x, d) * Ring.zero(Algebra.ring(A)) + polyAeval(A, x, r) =
    polyAeval(A, x, r) by ring
  rw z at sum
  symm
  exact sum

-- Monic polynomials dividing each other are equal.
theorem tkJ.gal_monic_dvd_antisymm (K p q : Set)
  requires field : Field(K)
  requires pMonic : PolyMonic(K, p)
  requires qMonic : PolyMonic(K, q)
  requires forward : RingDvd(polynomialRing(K, {0}), p, q)
  requires backward : RingDvd(polynomialRing(K, {0}), q, p)
  shows p = q
proof
  have comm := Field.to_comm_ring with field
  have polys := polynomialRing.comm_ring at K, {0} with comm
  have domain := Field.domain with field
  have parts := Field.parts with field
  have nt := IsField.nontrivial with parts
  obtain ⟨_, _, nontrivial⟩ := nt
  have pm := pMonic
  obtain ⟨pIn, pLead⟩ := pm
  have qm := qMonic
  obtain ⟨qIn, qLead⟩ := qm
  obtain ⟨_, _, c, cIn, qEq⟩ := forward
  obtain ⟨_, _, e, eIn, pEq⟩ := backward
  have pNonzero := PolyMonic.ne_zero at K, p with comm, polys, pIn, nontrivial, pMonic
  have qNonzero := PolyMonic.ne_zero at K, q with comm, polys, qIn, nontrivial, qMonic
  have le2 := uni.monic_dvd_le at K, q, e, p with comm, polys, qIn, eIn, pIn,
    nontrivial, qMonic, pEq, pNonzero
  have cNonzero : c ≠ Ring.zero(polynomialRing(K, {0}))
    intro cz
    rw cz at qEq
    have z : p * Ring.zero(polynomialRing(K, {0})) = Ring.zero(polynomialRing(K, {0})) by ring
    rw z at qEq
    exact qNonzero with qEq
  have degMul := polyNatDegree.mul at K, p, c with comm, polys, pIn, cIn, domain,
    pNonzero, cNonzero
  rw ← qEq at degMul
  have degC : polyNatDegree(K, c) = 0 by arith
  have leadMul := polyLeadingCoeff.mul at K, p, c with comm, polys, pIn, cIn, domain
  rw [← qEq, qLead, pLead] at leadMul
  rw (uni.lead_eq at K, c with comm, polys) at leadMul
  rw degC at leadMul
  have c0 := uni.coeff_mem at K, c, 0 with comm, cIn
  have one : Ring.one(K) * polyCoeff(c, 0) = polyCoeff(c, 0) by ring
  rw one at leadMul
  have cl : c ∈ polyDegreeLT(K, 1)
    unfold polyDegreeLT
    refine ⟨cIn, ?_⟩
    intros k hk
    have sc := uni.deg_spec at K, c with comm, polys, cIn
    unfold polyDegrees at hk
    obtain ⟨kN, nzk⟩ := hk
    have kNat := nat.omega.backward with kN
    have nz2 : polyCoeff(c, k) ≠ Ring.zero(K)
      unfold polyCoeff
      exact nzk
    have le := sc.left with k, kN, nz2
    arith
  have cc1 := uni.const_of_lt_one at K, c with comm, polys, cl
  rw ← leadMul at cc1
  rw ← (uni.one_eq at K with comm, polys) at cc1
  rw cc1 at qEq
  have unit : p * Ring.one(polynomialRing(K, {0})) = p by ring
  rw unit at qEq
  symm
  exact qEq

-- The degrees of the monic polynomials vanishing at x.
def tkJMonicRootDegrees (E x : Set) : Set :=
  { n ∈ ℕ | ∃ p ∈ uniPolys(Algebra.base(E)), PolyMonic(Algebra.base(E), p) ∧
    polyAeval(E, x, p) = Ring.zero(Algebra.ring(E)) ∧
    polyNatDegree(Algebra.base(E), p) = n }

defunique minpoly (E x : Set) (p ∈ uniPolys(Algebra.base(E))) :=
  PolyMonic(Algebra.base(E), p) ∧ polyAeval(E, x, p) = Ring.zero(Algebra.ring(E)) ∧
  (∀ q ∈ uniPolys(Algebra.base(E)), polyAeval(E, x, q) = Ring.zero(Algebra.ring(E)) →
    RingDvd(polynomialRing(Algebra.base(E), {0}), p, q))
requires extension : FieldExtension(E)
requires integral : IntegralElement(E, x)
proof
  have ext2 := extension
  obtain ⟨algebra, baseField, ringField⟩ := ext2
  have int2 := integral
  obtain ⟨_, xL, p0, p0Monic, p0Root⟩ := int2
  have comm := Field.to_comm_ring with baseField
  have polys := polynomialRing.comm_ring at Algebra.base(E), {0} with comm
  have baseParts := Field.parts with baseField
  have nt := IsField.nontrivial with baseParts
  obtain ⟨_, _, nontrivial⟩ := nt
  have pm0 := p0Monic
  obtain ⟨p0In, _⟩ := pm0
  have p0Uni : p0 ∈ uniPolys(Algebra.base(E))
    unfold uniPolys
    exact p0In
  have degN : polyNatDegree(Algebra.base(E), p0) ∈ ℕ by typecheck
  have inD : polyNatDegree(Algebra.base(E), p0) ∈ tkJMonicRootDegrees(E, x)
    apply tkJMonicRootDegrees.membership.backward
    exact ⟨degN, p0, p0Uni, p0Monic, p0Root, rfl⟩
  have nonempty : Nonempty(tkJMonicRootDegrees(E, x))
    unfold Nonempty
    exact ⟨polyNatDegree(Algebra.base(E), p0), inD⟩
  have naturals : tkJMonicRootDegrees(E, x) ⊆ ℕ
    intros n nIn
    obtain ⟨nN, _⟩ := tkJMonicRootDegrees.membership.forward with nIn
    exact nN
  have least := leastNatural.member with nonempty, naturals
  obtain ⟨_, p, pUni, pMonic, pRoot, pDeg⟩ :=
    tkJMonicRootDegrees.membership.forward with least
  refine ⟨p, pUni, pMonic, pRoot, ?_⟩
  intros q qUni qRoot
  have pIn := pUni
  unfold uniPolys at pIn
  have qIn := qUni
  unfold uniPolys at qIn
  have spec := polyDivision.spec at Algebra.base(E), q, p with comm, polys, qIn, pIn,
    nontrivial, pMonic
  obtain ⟨decomp, rLT⟩ := spec
  by_contra notDvd
  have rNonzero : polyModByMonic(Algebra.base(E), q, p) ≠
      Ring.zero(polynomialRing(Algebra.base(E), {0}))
    intro rz
    have dvd := (polyModByMonic.eq_zero_iff at Algebra.base(E), q, p with comm, polys,
      qIn, pIn, nontrivial, pMonic).forward with rz
    exact notDvd with dvd
  have rLT2 := rLT
  unfold polyDegreeLT at rLT2
  obtain ⟨rIn, rBelow⟩ := rLT2
  have rUni : polyModByMonic(Algebra.base(E), q, p) ∈ uniPolys(Algebra.base(E))
    unfold uniPolys
    exact rIn
  have sel := polyDivision.selected at Algebra.base(E), q, p with comm, nontrivial, qIn,
    pMonic
  obtain ⟨⟨_, d0, d0In, r0, r0In, shape⟩, _⟩ := sel
  have dUni : polyDivByMonic(Algebra.base(E), q, p) ∈ uniPolys(Algebra.base(E))
    unfold uniPolys
    unfold polyDivByMonic
    rw shape
    rw fst.pair
    exact d0In
  have rRoot := tkJ.gal_aeval_decomp with algebra, xL, qUni, dUni, pUni, rUni, decomp,
    qRoot, pRoot
  obtain ⟨c, cIn, scaledMonic, scaledDeg⟩ := tkJ.gal_monic_rescale with baseField, rUni,
    rNonzero
  have cpIn := polyC.mem at Algebra.base(E), c with comm, polys, cIn
  have cpUni : polyC(Algebra.base(E), c) ∈ uniPolys(Algebra.base(E))
    unfold uniPolys
    exact cpIn
  have scaledRoot := tkJ.gal_aeval_mul with algebra, xL, cpUni, rUni
  rw rRoot at scaledRoot
  have cL := tkJ.gal_aeval_mem with algebra, xL, cpUni
  have ringL := Algebra.comm_ring with algebra
  have z : polyAeval(E, x, polyC(Algebra.base(E), c)) * Ring.zero(Algebra.ring(E)) =
    Ring.zero(Algebra.ring(E)) by ring
  rw z at scaledRoot
  have scaledIn : call2(Ring.mul(polynomialRing(Algebra.base(E), {0})),
      polyC(Algebra.base(E), c), polyModByMonic(Algebra.base(E), q, p)) ∈
      uniPolys(Algebra.base(E))
    unfold uniPolys
    typecheck
  have rDegN : polyNatDegree(Algebra.base(E), polyModByMonic(Algebra.base(E), q, p)) ∈ ℕ
    by typecheck
  have scaledInD : polyNatDegree(Algebra.base(E), polyModByMonic(Algebra.base(E), q, p)) ∈
      tkJMonicRootDegrees(E, x)
    apply tkJMonicRootDegrees.membership.backward
    refine ⟨rDegN, call2(Ring.mul(polynomialRing(Algebra.base(E), {0})),
      polyC(Algebra.base(E), c), polyModByMonic(Algebra.base(E), q, p)), scaledIn,
      scaledMonic, scaledRoot, scaledDeg⟩
  have minimal := leastNatural.least at tkJMonicRootDegrees(E, x),
    polyNatDegree(Algebra.base(E), polyModByMonic(Algebra.base(E), q, p)) with nonempty,
    naturals, scaledInD
  rw ← pDeg at minimal
  have rSpec := uni.deg_spec at Algebra.base(E), polyModByMonic(Algebra.base(E), q, p)
    with comm, polys, rIn
  have topNonzero := rSpec.right with rNonzero
  have topIn : polyNatDegree(Algebra.base(E), polyModByMonic(Algebra.base(E), q, p)) ∈
      polyDegrees(Algebra.base(E), polyModByMonic(Algebra.base(E), q, p))
    unfold polyDegrees
    refine ⟨rDegN, ?_⟩
    unfold polyCoeff at topNonzero
    exact topNonzero
  have below := rBelow with polyNatDegree(Algebra.base(E),
    polyModByMonic(Algebra.base(E), q, p)), topIn
  arith
uniqueness
  have ext2 := extension
  obtain ⟨algebra, baseField, ringField⟩ := ext2
  intros p pUni pSpec p2 p2Uni p2Spec
  obtain ⟨pMonic, pRoot, pMin⟩ := pSpec
  obtain ⟨p2Monic, p2Root, p2Min⟩ := p2Spec
  have forward := pMin with p2, p2Uni, p2Root
  have backward := p2Min with p, pUni, pRoot
  exact tkJ.gal_monic_dvd_antisymm with baseField, pMonic, p2Monic, forward, backward

-- p is separable: p and its derivative are coprime, a p + b p' = 1
-- (Polynomial.Separable, IsCoprime p (derivative p)).
predicate PolySeparable (R p : Set) :=
  p ∈ uniPolys(R) ∧ (∃ a ∈ uniPolys(R), ∃ b ∈ uniPolys(R),
    call2(Ring.add(polynomialRing(R, {0})),
      call2(Ring.mul(polynomialRing(R, {0})), a, p),
      call2(Ring.mul(polynomialRing(R, {0})), b, polyDerivative(R)(p))) =
    Ring.one(polynomialRing(R, {0})))

-- p ∈ K[X] splits along f : K →+* L (Polynomial.Splits f p): its image
-- in L[X] is zero or a constant times a product of linear factors.
predicate PolySplits (K L f p : Set) :=
  p ∈ uniPolys(K) ∧ (polyMap(K, L, f)(p) = Ring.zero(polynomialRing(L, {0})) ∨
    (∃ n ∈ ℕ, ∃ a, FunctionBetween(a, n, Ring.carrier(L)) ∧
      polyMap(K, L, f)(p) = call2(Ring.mul(polynomialRing(L, {0})),
        polyC(L, polyLeadingCoeff(L, polyMap(K, L, f)(p))), polyLinearProduct(L, a, n))))

-- x is separable over K (IsSeparable K x); separable, normal and Galois
-- extensions (Algebra.IsSeparable, Normal, IsGalois).
predicate SeparableElement (E x : Set) :=
  IntegralElement(E, x) ∧ PolySeparable(Algebra.base(E), minpoly(E, x))

predicate SeparableExtension (E : Set) :=
  FieldExtension(E) ∧ (∀ x ∈ algebraCarrier(E), SeparableElement(E, x))

predicate NormalExtension (E : Set) :=
  AlgebraicExtension(E) ∧ (∀ x ∈ algebraCarrier(E),
    PolySplits(Algebra.base(E), Algebra.ring(E), Algebra.map(E), minpoly(E, x)))

predicate GaloisExtension (E : Set) := SeparableExtension(E) ∧ NormalExtension(E)

-- L is a splitting field of p over K (Polynomial.IsSplittingField): p
-- splits in L and L is generated by its roots; for p = 0, whose root set
-- Mathlib takes empty, L = K. Gal(L/K) of a splitting field is Mathlib's
-- Polynomial.Gal p, up to the isomorphism of splitting fields.
predicate IsSplittingField (E p : Set) :=
  FieldExtension(E) ∧ PolySplits(Algebra.base(E), Algebra.ring(E), Algebra.map(E), p) ∧
  (p ≠ Ring.zero(polynomialRing(Algebra.base(E), {0})) →
    fieldAdjoin(E, polyAlgebraRootSet(E, p)) = algebraCarrier(E)) ∧
  (p = Ring.zero(polynomialRing(Algebra.base(E), {0})) →
    bottomField(E) = algebraCarrier(E))

-- L is an algebraic closure of K (IsAlgClosure K L); algebraic
-- closedness of the field L is Cumulus's AlgebraicallyClosed (IsAlgClosed).
predicate IsAlgebraicClosure (E : Set) :=
  AlgebraicExtension(E) ∧ AlgebraicallyClosed(Algebra.ring(E))

-- Helpers for the Galois group: membership, and the composition and
-- inverse graphs as functions.
theorem tkJ.aut_member (E σ : Set)
  shows σ ∈ algebraAutomorphisms(E) ↔ σ : E ≃ₐ E
proof
  constructor
  . intro h
    obtain ⟨space, iso⟩ := algebraAutomorphisms.membership.forward with h
    exact iso
  . intro iso
    have iso2 := iso
    obtain ⟨hom, bijective⟩ := iso2
    have function := AlgebraHom.function with hom
    have space := (functionSpace.mem_iff at σ, algebraCarrier(E),
      algebraCarrier(E)).backward with function
    exact algebraAutomorphisms.membership.backward with ⟨space, iso⟩

theorem tkJ.aut_function (E σ : Set)
  requires member : σ ∈ algebraAutomorphisms(E)
  shows σ : algebraCarrier(E) → algebraCarrier(E)
proof
  have iso := (tkJ.aut_member at E, σ).forward with member
  obtain ⟨hom, bijective⟩ := iso
  exact AlgebraHom.function with hom

theorem tkJ.aut_bijective (E σ : Set)
  requires member : σ ∈ algebraAutomorphisms(E)
  shows BijectiveBetween(σ, algebraCarrier(E), algebraCarrier(E))
proof
  have iso := (tkJ.aut_member at E, σ).forward with member
  obtain ⟨hom, bijective⟩ := iso
  exact bijective

theorem tkJ.aut_compose_mem (E σ τ : Set)
  requires first : σ ∈ algebraAutomorphisms(E)
  requires second : τ ∈ algebraAutomorphisms(E)
  shows compose(σ, τ, algebraCarrier(E), algebraCarrier(E), algebraCarrier(E)) ∈
    algebraAutomorphisms(E)
proof
  have isoσ := (tkJ.aut_member at E, σ).forward with first
  have isoτ := (tkJ.aut_member at E, τ).forward with second
  have composite := AlgebraIso.compose with isoτ, isoσ
  exact (tkJ.aut_member at E, compose(σ, τ, algebraCarrier(E), algebraCarrier(E),
    algebraCarrier(E))).backward with composite

theorem tkJ.aut_converse_mem (E σ : Set)
  requires member : σ ∈ algebraAutomorphisms(E)
  shows converse(σ, algebraCarrier(E), algebraCarrier(E)) ∈ algebraAutomorphisms(E)
proof
  have iso := (tkJ.aut_member at E, σ).forward with member
  have inverse := AlgebraIso.inverse with iso
  exact (tkJ.aut_member at E, converse(σ, algebraCarrier(E),
    algebraCarrier(E))).backward with inverse

theorem tkJ.autComposition_relates (E σ τ : Set)
  requires first : σ ∈ algebraAutomorphisms(E)
  requires second : τ ∈ algebraAutomorphisms(E)
  shows relates(autComposition(E), (σ, τ),
    compose(σ, τ, algebraCarrier(E), algebraCarrier(E), algebraCarrier(E)))
proof
  have mem := tkJ.aut_compose_mem with first, second
  have pairIn := product.pair at σ, τ, algebraAutomorphisms(E),
    algebraAutomorphisms(E) with first, second
  have tripleIn := product.pair at (σ, τ), compose(σ, τ, algebraCarrier(E),
    algebraCarrier(E), algebraCarrier(E)),
    algebraAutomorphisms(E) × algebraAutomorphisms(E),
    algebraAutomorphisms(E) with pairIn, mem
  unfold relates
  apply autComposition.membership.backward
  refine ⟨tripleIn, ?_⟩
  simp [fst.pair, snd.pair]

theorem tkJ.autComposition_function (E : Set)
  shows autComposition(E) : algebraAutomorphisms(E) × algebraAutomorphisms(E) →
    algebraAutomorphisms(E)
proof
  constructor
  . intros p member
    obtain ⟨bounded, equation⟩ := autComposition.membership.forward with member
    exact bounded
  . constructor
    . intros x first xFirst second xSecond
      unfold relates at xFirst
      obtain ⟨_, e1⟩ := autComposition.membership.forward with xFirst
      unfold relates at xSecond
      obtain ⟨_, e2⟩ := autComposition.membership.forward with xSecond
      simp [fst.pair, snd.pair] at e1
      simp [fst.pair, snd.pair] at e2
      rw [e1, e2]
    . intros q qIn
      obtain ⟨bound, σ, σIn, τ, τIn, shape⟩ := product.membership.forward with qIn
      rw shape
      have mem := tkJ.aut_compose_mem with σIn, τIn
      have rel := tkJ.autComposition_relates with σIn, τIn
      exact ⟨compose(σ, τ, algebraCarrier(E), algebraCarrier(E), algebraCarrier(E)),
        mem, rel⟩

theorem tkJ.autComposition_apply (E σ τ : Set)
  requires first : σ ∈ algebraAutomorphisms(E)
  requires second : τ ∈ algebraAutomorphisms(E)
  shows autComposition(E)(σ, τ) =
    compose(σ, τ, algebraCarrier(E), algebraCarrier(E), algebraCarrier(E))
proof
  have function := tkJ.autComposition_function at E
  have pairIn := product.pair at σ, τ, algebraAutomorphisms(E),
    algebraAutomorphisms(E) with first, second
  have rel := tkJ.autComposition_relates with first, second
  have value := FunctionBetween.apply_value with function, pairIn, rel
  unfold call2
  exact value

theorem tkJ.autInverse_relates (E σ : Set)
  requires member : σ ∈ algebraAutomorphisms(E)
  shows relates(autInverse(E), σ, converse(σ, algebraCarrier(E), algebraCarrier(E)))
proof
  have mem := tkJ.aut_converse_mem with member
  have pairIn := product.pair at σ, converse(σ, algebraCarrier(E), algebraCarrier(E)),
    algebraAutomorphisms(E), algebraAutomorphisms(E) with member, mem
  unfold relates
  apply autInverse.membership.backward
  refine ⟨pairIn, ?_⟩
  simp [fst.pair, snd.pair]

theorem tkJ.autInverse_function (E : Set)
  shows autInverse(E) : algebraAutomorphisms(E) → algebraAutomorphisms(E)
proof
  constructor
  . intros p member
    obtain ⟨bounded, equation⟩ := autInverse.membership.forward with member
    exact bounded
  . constructor
    . intros x first xFirst second xSecond
      unfold relates at xFirst
      obtain ⟨_, e1⟩ := autInverse.membership.forward with xFirst
      unfold relates at xSecond
      obtain ⟨_, e2⟩ := autInverse.membership.forward with xSecond
      simp [fst.pair, snd.pair] at e1
      simp [fst.pair, snd.pair] at e2
      rw [e1, e2]
    . intros σ σIn
      have mem := tkJ.aut_converse_mem with σIn
      have rel := tkJ.autInverse_relates with σIn
      exact ⟨converse(σ, algebraCarrier(E), algebraCarrier(E)), mem, rel⟩

theorem tkJ.autInverse_apply (E σ : Set)
  requires member : σ ∈ algebraAutomorphisms(E)
  shows autInverse(E)(σ) = converse(σ, algebraCarrier(E), algebraCarrier(E))
proof
  have function := tkJ.autInverse_function at E
  have rel := tkJ.autInverse_relates with member
  exact FunctionBetween.apply_value with function, member, rel

-- Section: Extensions
section Extensions
variable (E : Set)
hypothesis extension : FieldExtension(E)

-- algebraMap K L is injective (RingHom.injective of a field).
theorem FieldExtension.map_injective
  shows InjectiveBetween(Algebra.map(E), Ring.carrier(Algebra.base(E)), algebraCarrier(E))
proof
  obtain ⟨algebra, baseField, ringField⟩ := extension
  have structureMap := Algebra.structure_hom with algebra
  have parts := RingHom.parts with structureMap
  have fieldParts := Field.parts with baseField
  have targetField := Field.parts with ringField
  have targetComm := IsField.comm_ring with targetField
  have nontrivial := IsField.nontrivial with targetField
  have injective := IsRingHom.field_injective with fieldParts, targetComm,
    nontrivial, parts
  unfold algebraCarrier
  exact injective

-- Module.finrank_pos and the degree one case (IntermediateField.finrank_eq_one_iff,
-- Algebra.finrank_eq_one_iff for ⊥ = ⊤).
theorem extensionDegree.pos
  requires finite : FiniteExtension(E)
  shows 0 < extensionDegree(E)
proof
  sorry

theorem extensionDegree.eq_one_iff
  requires finite : FiniteExtension(E)
  shows extensionDegree(E) = 1 ↔ bottomField(E) = algebraCarrier(E)
proof
  sorry

-- A finite extension is algebraic (Algebra.IsAlgebraic.of_finite).
theorem FiniteExtension.algebraic
  requires finite : FiniteExtension(E)
  shows AlgebraicExtension(E)
proof
  sorry

-- A finite extension has a finite Galois group (AlgEquiv.fintype), of
-- order at most the degree (AlgEquiv.card_le).
theorem FiniteExtension.galois_finite
  requires finite : FiniteExtension(E)
  shows Finite(algebraAutomorphisms(E)) ∧ order(galoisGroup(E)) ≤ extensionDegree(E)
proof
  sorry

theorem galoisGroup.group
  shows Group(galoisGroup(E))
proof
  obtain ⟨algebra, baseField, ringField⟩ := extension
  have mulF := tkJ.autComposition_function at E
  have invF := tkJ.autInverse_function at E
  have idIso := AlgebraIso.identity with algebra
  have oneIn := (tkJ.aut_member at E, identity(algebraCarrier(E))).backward with idIso
  unfold galoisGroup
  apply Group.intro
  . exact mulF
  . exact oneIn
  . exact invF
  . intros a aIn b bIn c cIn
    have ab := tkJ.aut_compose_mem with aIn, bIn
    have bc := tkJ.aut_compose_mem with bIn, cIn
    have fa := tkJ.aut_function with aIn
    have fb := tkJ.aut_function with bIn
    have fc := tkJ.aut_function with cIn
    have fab := tkJ.aut_function with ab
    have fbc := tkJ.aut_function with bc
    rw [(tkJ.autComposition_apply at E, a, b with aIn, bIn),
      (tkJ.autComposition_apply at E, b, c with bIn, cIn),
      (tkJ.autComposition_apply with ab, cIn),
      (tkJ.autComposition_apply with aIn, bc)]
    apply FunctionBetween.ext at _, _, algebraCarrier(E), algebraCarrier(E)
    . exact compose.function with fc, fab
    . exact compose.function with fbc, fa
    . intros x xIn
      have cx := FunctionBetween.apply_closed with fc, xIn
      have bcx := FunctionBetween.apply_closed with fb, cx
      rw [(compose.apply with fc, fab, xIn), (compose.apply with fb, fa, cx),
        (compose.apply with fbc, fa, xIn), (compose.apply with fc, fb, xIn)]
  . intros a aIn
    have fa := tkJ.aut_function with aIn
    rw tkJ.autComposition_apply with oneIn, aIn
    exact compose.identity_left with fa
  . intros a aIn
    have fa := tkJ.aut_function with aIn
    rw tkJ.autComposition_apply with aIn, oneIn
    exact compose.identity_right with fa
  . intros a aIn
    have inv := tkJ.aut_converse_mem with aIn
    have fa := tkJ.aut_function with aIn
    have finv := tkJ.aut_function with inv
    have bij := tkJ.aut_bijective with aIn
    rw [(tkJ.autInverse_apply with aIn), (tkJ.autComposition_apply with inv, aIn)]
    apply FunctionBetween.ext at _, _, algebraCarrier(E), algebraCarrier(E)
    . exact compose.function with fa, finv
    . exact identity.function
    . intros x xIn
      rw [(compose.apply with fa, finv, xIn), (identity.apply with xIn)]
      exact Bijective.inverse_apply with bij, xIn
  . intros a aIn
    have inv := tkJ.aut_converse_mem with aIn
    have fa := tkJ.aut_function with aIn
    have finv := tkJ.aut_function with inv
    have bij := tkJ.aut_bijective with aIn
    rw [(tkJ.autInverse_apply with aIn), (tkJ.autComposition_apply with aIn, inv)]
    apply FunctionBetween.ext at _, _, algebraCarrier(E), algebraCarrier(E)
    . exact compose.function with finv, fa
    . exact identity.function
    . intros x xIn
      rw [(compose.apply with finv, fa, xIn), (identity.apply with xIn)]
      exact Bijective.apply_inverse with bij, xIn

-- AlgEquiv.mul_apply, AlgEquiv.one_apply.
theorem galoisGroup.mul_apply (σ τ x : Set)
  requires first : σ ∈ algebraAutomorphisms(E)
  requires second : τ ∈ algebraAutomorphisms(E)
  requires point : x ∈ algebraCarrier(E)
  shows Group.mul(galoisGroup(E))(σ, τ)(x) = σ(τ(x))
proof
  have mulOf : Group.mul(galoisGroup(E)) = autComposition(E)
    simp [galoisGroup, Group.mk.mul]
  have fσ := tkJ.aut_function with first
  have fτ := tkJ.aut_function with second
  rw [mulOf, (tkJ.autComposition_apply with first, second)]
  exact compose.apply with fτ, fσ, point

theorem galoisGroup.one_apply (x : Set)
  requires point : x ∈ algebraCarrier(E)
  shows Group.one(galoisGroup(E))(x) = x
proof
  have oneOf : Group.one(galoisGroup(E)) = identity(algebraCarrier(E))
    simp [galoisGroup, Group.mk.one]
  rw oneOf
  exact identity.apply with point

-- An algebra endomorphism of an algebraic extension is an automorphism
-- (Algebra.IsAlgebraic.algHom_bijective; Normal.algHomEquivAut).
theorem AlgebraicExtension.endomorphism_bijective (f : Set)
  requires algebraic : AlgebraicExtension(E)
  requires hom : f : E →ₐ E
  shows f ∈ algebraAutomorphisms(E)
proof
  sorry

-- AlgEquiv.ext: automorphisms agreeing pointwise are equal.
theorem galoisGroup.ext (σ τ : Set)
  requires first : σ ∈ algebraAutomorphisms(E)
  requires second : τ ∈ algebraAutomorphisms(E)
  requires agree : ∀ x ∈ algebraCarrier(E), σ(x) = τ(x)
  shows σ = τ
proof
  have fσ := tkJ.aut_function with first
  have fτ := tkJ.aut_function with second
  exact FunctionBetween.ext with fσ, fτ, agree

end Extensions

-- The intermediate fields as members of intermediateFields(E), and the
-- subring and coefficient parts of an intermediate field.
theorem tkJ.intermediate_member (E F : Set)
  shows F ∈ intermediateFields(E) ↔ IntermediateField(E, F)
proof
  constructor
  . intro h
    obtain ⟨_, i⟩ := intermediateFields.membership.forward with h
    exact i
  . intro i
    have i2 := i
    obtain ⟨_, sub, _⟩ := i2
    obtain ⟨_, subalg⟩ := sub
    obtain ⟨subring, _⟩ := subalg
    have bounded := IsSubring.subset_carrier with subring
    have pw := (powerset.membership_iff at F, algebraCarrier(E)).backward with bounded
    exact intermediateFields.membership.backward with ⟨pw, i⟩

theorem tkJ.intermediate_subring (E F : Set)
  requires intermediate : IntermediateField(E, F)
  shows IsSubring(algebraCarrier(E), Ring.add(Algebra.ring(E)),
    Ring.zero(Algebra.ring(E)), Ring.neg(Algebra.ring(E)),
    Ring.mul(Algebra.ring(E)), Ring.one(Algebra.ring(E)), F)
proof
  obtain ⟨_, sub, _⟩ := intermediate
  obtain ⟨_, subalg⟩ := sub
  obtain ⟨subring, _⟩ := subalg
  exact subring

theorem tkJ.intermediate_bounded (E F : Set)
  requires intermediate : IntermediateField(E, F)
  shows F ⊆ algebraCarrier(E)
proof
  have subring := tkJ.intermediate_subring with intermediate
  exact IsSubring.subset_carrier with subring

-- An inverse in L of a nonzero element of F lies in F.
theorem tkJ.intermediate_inverse_mem (E F x y : Set)
  requires intermediate : IntermediateField(E, F)
  requires member : x ∈ F
  requires nonzero : x ≠ Ring.zero(Algebra.ring(E))
  requires point : y ∈ algebraCarrier(E)
  requires product : call2(Ring.mul(Algebra.ring(E)), x, y) = Ring.one(Algebra.ring(E))
  shows y ∈ F
proof
  have i2 := intermediate
  obtain ⟨extension, sub, inverses⟩ := i2
  obtain ⟨algebra, baseField, ringField⟩ := extension
  have comm := Algebra.comm_ring with algebra
  have bounded := tkJ.intermediate_bounded with intermediate
  obtain ⟨z, zIn, zProduct⟩ := inverses with x, member, nonzero
  have xL := bounded with x, member
  have zL := bounded with z, zIn
  unfold algebraCarrier at xL
  unfold algebraCarrier at zL
  unfold algebraCarrier at point
  have same := tkJ.inverse_unique with comm, xL, point, zL, product, zProduct
  rw same
  exact zIn

-- Membership in K(S): an element of L lying in every intermediate field
-- that contains S.
theorem tkJ.adjoin_in (E S x F : Set)
  requires member : x ∈ fieldAdjoin(E, S)
  requires intermediate : IntermediateField(E, F)
  requires contains : S ⊆ F
  shows x ∈ F
proof
  obtain ⟨xL, all⟩ := fieldAdjoin.membership.forward with member
  have Fmem := (tkJ.intermediate_member at E, F).backward with intermediate
  exact all with F, Fmem, contains

theorem tkJ.adjoin_intro (E S x : Set)
  requires point : x ∈ algebraCarrier(E)
  requires all : ∀ F, IntermediateField(E, F) → S ⊆ F → x ∈ F
  shows x ∈ fieldAdjoin(E, S)
proof
  apply fieldAdjoin.membership.backward
  refine ⟨point, ?_⟩
  intros F Fmem sF
  have inter := (tkJ.intermediate_member at E, F).forward with Fmem
  exact all with F, inter, sF

theorem tkJ.adjoin_bounded (E S : Set)
  shows fieldAdjoin(E, S) ⊆ algebraCarrier(E)
proof
  intros x xIn
  obtain ⟨xL, _⟩ := fieldAdjoin.membership.forward with xIn
  exact xL

-- An intermediate field is a field under the restricted operations, and
-- the extensions F/K and L/F are algebras.
theorem tkJ.intermediate_field (E F : Set)
  requires intermediate : IntermediateField(E, F)
  shows Field(subringRing(Algebra.ring(E), F))
proof
  have i2 := intermediate
  obtain ⟨extension, sub, inverses⟩ := i2
  obtain ⟨algebra, baseField, ringField⟩ := extension
  have comm := Algebra.comm_ring with algebra
  have subring := tkJ.intermediate_subring with intermediate
  unfold algebraCarrier at subring
  have ringParts := CommRing.parts with comm
  have commSub := IsSubring.comm_ring with ringParts, subring
  have fieldParts := Field.parts with ringField
  have nontrivialL := IsField.nontrivial with fieldParts
  obtain ⟨zL, oL, distinct⟩ := nontrivialL
  have zF := IsSubring.zero_closed with subring
  have oF := IsSubring.one_closed with subring
  have bounded := IsSubring.subset_carrier with subring
  have magma : IsMagma(Ring.carrier(Algebra.ring(E)), Ring.mul(Algebra.ring(E))) by
    simp [IsCommRing, IsRing, IsMonoid, IsSemigroup]
  have isField : IsField(F, restrict(Ring.add(Algebra.ring(E)), F × F),
      Ring.zero(Algebra.ring(E)), restrict(Ring.neg(Algebra.ring(E)), F),
      restrict(Ring.mul(Algebra.ring(E)), F × F), Ring.one(Algebra.ring(E)))
    unfold IsField
    refine ⟨commSub, ⟨zF, oF, distinct⟩, ?_⟩
    intros x xF nonzero
    obtain ⟨y, yF, product⟩ := inverses with x, xF, nonzero
    have xL := bounded with x, xF
    have yL := bounded with y, yF
    have swap : y * x = x * y by ring
    refine ⟨y, ?_⟩
    unfold IsInverse
    refine ⟨xF, yF, _, _⟩
    . rw (restrictBinary.value_on_subset with magma, bounded, yF, xF)
      rw swap
      exact product
    . rw (restrictBinary.value_on_subset with magma, bounded, xF, yF)
      exact product
  unfold subringRing
  exact Field.of_parts with isField

theorem tkJ.subextension_algebra (E F : Set)
  requires intermediate : IntermediateField(E, F)
  shows Algebra(subextension(E, F))
proof
  have i2 := intermediate
  obtain ⟨extension, sub, inverses⟩ := i2
  obtain ⟨algebra, subA⟩ := sub
  have ext2 := extension
  obtain ⟨_, baseField, ringField⟩ := ext2
  have baseB := Algebra.base_comm_ring at E with algebra
  have ringB := Algebra.comm_ring at E with algebra
  have subring := tkJ.intermediate_subring with intermediate
  unfold algebraCarrier at subring
  have bundled := Subring.of_projections with subring
  have commC := subringRing.comm_ring at Algebra.ring(E), F with ringB, bundled
  have bp := CommRing.parts with baseB
  have ap0 := CommRing.parts with ringB
  have ap : IsCommRing(algebraCarrier(E), Ring.add(Algebra.ring(E)),
      Ring.zero(Algebra.ring(E)), Ring.neg(Algebra.ring(E)),
      Ring.mul(Algebra.ring(E)), Ring.one(Algebra.ring(E)))
    unfold algebraCarrier
    exact ap0
  have sh := Algebra.structure_hom at E with algebra
  have hp0 := RingHom.parts with sh
  have hp : IsRingHom(Algebra.map(E), Ring.carrier(Algebra.base(E)),
      Ring.add(Algebra.base(E)), Ring.zero(Algebra.base(E)),
      Ring.neg(Algebra.base(E)), Ring.mul(Algebra.base(E)),
      Ring.one(Algebra.base(E)), algebraCarrier(E), Ring.add(Algebra.ring(E)),
      Ring.zero(Algebra.ring(E)), Ring.neg(Algebra.ring(E)),
      Ring.mul(Algebra.ring(E)), Ring.one(Algebra.ring(E)))
    unfold algebraCarrier
    exact hp0
  have rh := intHelp.restricted_hom at Ring.carrier(Algebra.base(E)),
    Ring.add(Algebra.base(E)), Ring.zero(Algebra.base(E)),
    Ring.neg(Algebra.base(E)), Ring.mul(Algebra.base(E)),
    Ring.one(Algebra.base(E)), algebraCarrier(E), Ring.add(Algebra.ring(E)),
    Ring.zero(Algebra.ring(E)), Ring.neg(Algebra.ring(E)),
    Ring.mul(Algebra.ring(E)), Ring.one(Algebra.ring(E)), Algebra.map(E), F
    with bp, ap, hp, subA
  have rh2 : IsRingHom(Algebra.map(E), Ring.carrier(Algebra.base(E)),
      Ring.add(Algebra.base(E)), Ring.zero(Algebra.base(E)),
      Ring.neg(Algebra.base(E)), Ring.mul(Algebra.base(E)),
      Ring.one(Algebra.base(E)), Ring.carrier(subringRing(Algebra.ring(E), F)),
      Ring.add(subringRing(Algebra.ring(E), F)),
      Ring.zero(subringRing(Algebra.ring(E), F)),
      Ring.neg(subringRing(Algebra.ring(E), F)),
      Ring.mul(subringRing(Algebra.ring(E), F)),
      Ring.one(subringRing(Algebra.ring(E), F)))
    unfold subringRing
    ring_projections
  have mapC := RingHom.of_projections with (CommRing.to_ring with baseB),
    (CommRing.to_ring with commC), rh2
  unfold subextension
  exact Algebra.intro at Algebra.base(E), subringRing(Algebra.ring(E), F),
    Algebra.map(E) with baseB, commC, mapC

theorem tkJ.overExtension_algebra (E F : Set)
  requires intermediate : IntermediateField(E, F)
  shows Algebra(overExtension(E, F))
proof
  have i2 := intermediate
  obtain ⟨extension, sub, inverses⟩ := i2
  obtain ⟨algebra, subA⟩ := sub
  have ringB := Algebra.comm_ring at E with algebra
  have subring := tkJ.intermediate_subring with intermediate
  unfold algebraCarrier at subring
  have bundled := Subring.of_projections with subring
  have commC := subringRing.comm_ring at Algebra.ring(E), F with ringB, bundled
  have incl := Subring.inclusion at Algebra.ring(E), F with ringB, bundled
  unfold overExtension
  exact Algebra.intro at subringRing(Algebra.ring(E), F), Algebra.ring(E),
    identity(F) with commC, ringB, incl

-- The projections of F/K and L/F.
theorem tkJ.over_ring (E F : Set)
  shows Algebra.ring(overExtension(E, F)) = Algebra.ring(E)
proof
  simp [overExtension, Algebra.mk.ring]

theorem tkJ.over_base (E F : Set)
  shows Algebra.base(overExtension(E, F)) = subringRing(Algebra.ring(E), F)
proof
  simp [overExtension, Algebra.mk.base]

theorem tkJ.over_map (E F : Set)
  shows Algebra.map(overExtension(E, F)) = identity(F)
proof
  simp [overExtension, Algebra.mk.map]

theorem tkJ.over_carrier (E F : Set)
  shows algebraCarrier(overExtension(E, F)) = algebraCarrier(E)
proof
  unfold algebraCarrier
  rw tkJ.over_ring

theorem tkJ.sub_ring (E F : Set)
  shows Algebra.ring(subextension(E, F)) = subringRing(Algebra.ring(E), F)
proof
  simp [subextension, Algebra.mk.ring]

theorem tkJ.sub_base (E F : Set)
  shows Algebra.base(subextension(E, F)) = Algebra.base(E)
proof
  simp [subextension, Algebra.mk.base]

theorem tkJ.sub_map (E F : Set)
  shows Algebra.map(subextension(E, F)) = Algebra.map(E)
proof
  simp [subextension, Algebra.mk.map]

theorem tkJ.sub_carrier (E F : Set)
  shows algebraCarrier(subextension(E, F)) = F
proof
  unfold algebraCarrier
  rw [tkJ.sub_ring, subringRing.carrierOf]

-- Section: Intermediate fields
section Intermediate
variable (E : Set)
hypothesis extension : FieldExtension(E)

theorem IntermediateField.bottom
  shows IntermediateField(E, bottomField(E))
proof
  have ext2 := extension
  obtain ⟨algebra, baseField, ringField⟩ := ext2
  have baseComm := Algebra.base_comm_ring with algebra
  have ringComm := Algebra.comm_ring with algebra
  have structureMap := Algebra.structure_hom with algebra
  have function := Algebra.map_function with algebra
  have bp := CommRing.parts with baseComm
  have ap := CommRing.parts with ringComm
  have hp := RingHom.parts with structureMap
  have subring := IsRingHom.image_subring with bp, ap, hp
  have reflexive := Subset.reflexive at bottomField(E)
  unfold IntermediateField
  refine ⟨extension, ?_, ?_⟩
  . unfold SubalgebraOf
    refine ⟨algebra, ?_⟩
    unfold Subalgebra
    unfold bottomField
    unfold algebraCarrier
    unfold bottomField at reflexive
    unfold algebraCarrier at reflexive
    exact ⟨subring, reflexive⟩
  . intros x xIn nonzero
    unfold bottomField at xIn
    obtain ⟨xL, a, aIn, xEq⟩ := functionImage.membership.forward with xIn
    have aNonzero : a ≠ Ring.zero(Algebra.base(E))
      intro aZero
      have mapZero := RingHom.map_zero with structureMap
      rw aZero at xEq
      rw mapZero at xEq
      exact nonzero with xEq
    obtain ⟨b, bIn, product⟩ := tkJ.field_inverse with baseField, aIn, aNonzero
    have image := functionImage.value with function, bIn
    have mapMul := RingHom.map_mul at Algebra.map(E), Algebra.base(E),
      Algebra.ring(E), a, b with structureMap, aIn, bIn
    have mapOne := RingHom.map_one with structureMap
    refine ⟨Algebra.map(E)(b), ?_, ?_⟩
    . unfold bottomField
      exact image
    . rw [xEq, ← mapMul, product, mapOne]

theorem IntermediateField.top
  shows IntermediateField(E, algebraCarrier(E))
proof
  have ext2 := extension
  obtain ⟨algebra, baseField, ringField⟩ := ext2
  have ringComm := Algebra.comm_ring with algebra
  have ring := CommRing.to_ring with ringComm
  have whole := Subring.whole with ring
  have parts := Subring.parts with whole
  have image := functionImage.subset at Algebra.map(E),
    Ring.carrier(Algebra.base(E)), algebraCarrier(E)
  unfold IntermediateField
  refine ⟨extension, ?_, ?_⟩
  . unfold SubalgebraOf
    refine ⟨algebra, ?_⟩
    unfold Subalgebra
    unfold algebraCarrier
    unfold algebraCarrier at image
    exact ⟨parts, image⟩
  . intros x xIn nonzero
    unfold algebraCarrier at xIn
    unfold algebraCarrier
    exact tkJ.field_inverse with ringField, xIn, nonzero

-- IntermediateField.algebraMap_mem: K ⊆ F.
theorem IntermediateField.bottom_subset (F : Set)
  requires intermediate : IntermediateField(E, F)
  shows bottomField(E) ⊆ F
proof
  obtain ⟨ext2, subalgebra, inverses⟩ := intermediate
  obtain ⟨algebra, sub⟩ := subalgebra
  obtain ⟨subring, image⟩ := sub
  unfold bottomField
  exact image

-- F/K and L/F are field extensions, and the tower law
-- [F : K] [L : F] = [L : K] (Module.finrank_mul_finrank).
theorem IntermediateField.subextension_field (F : Set)
  requires intermediate : IntermediateField(E, F)
  shows FieldExtension(subextension(E, F)) ∧ FieldExtension(overExtension(E, F))
proof
  have ext2 := extension
  obtain ⟨algebra, baseField, ringField⟩ := ext2
  have subField := tkJ.intermediate_field with intermediate
  have subAlg := tkJ.subextension_algebra with intermediate
  have overAlg := tkJ.overExtension_algebra with intermediate
  constructor
  . unfold FieldExtension
    refine ⟨subAlg, ?_, ?_⟩
    . unfold subextension
      rw Algebra.mk.base
      exact baseField
    . unfold subextension
      rw Algebra.mk.ring
      exact subField
  . unfold FieldExtension
    refine ⟨overAlg, ?_, ?_⟩
    . unfold overExtension
      rw Algebra.mk.base
      exact subField
    . unfold overExtension
      rw Algebra.mk.ring
      exact ringField

theorem extensionDegree.tower (F : Set)
  requires finite : FiniteExtension(E)
  requires intermediate : IntermediateField(E, F)
  shows FiniteExtension(subextension(E, F)) ∧ FiniteExtension(overExtension(E, F)) ∧
    extensionDegree(subextension(E, F)) * extensionDegree(overExtension(E, F)) =
      extensionDegree(E)
proof
  sorry

-- Transitivity of algebraicity in K ≤ F ≤ L (Algebra.IsAlgebraic.trans,
-- Algebra.IsAlgebraic.tower_top).
theorem AlgebraicExtension.trans (F : Set)
  requires intermediate : IntermediateField(E, F)
  requires lower : AlgebraicExtension(subextension(E, F))
  requires upper : AlgebraicExtension(overExtension(E, F))
  shows AlgebraicExtension(E)
proof
  sorry

theorem AlgebraicExtension.tower_top (F : Set)
  requires intermediate : IntermediateField(E, F)
  requires algebraic : AlgebraicExtension(E)
  shows AlgebraicExtension(overExtension(E, F)) ∧ AlgebraicExtension(subextension(E, F))
proof
  sorry

-- K(S) is an intermediate field containing S, the least one
-- (IntermediateField.subset_adjoin, adjoin_le_iff).
theorem fieldAdjoin.intermediate (S : Set)
  requires subset : S ⊆ algebraCarrier(E)
  shows IntermediateField(E, fieldAdjoin(E, S))
proof
  have ext2 := extension
  obtain ⟨algebra, baseField, ringField⟩ := ext2
  have bounded := tkJ.adjoin_bounded at E, S
  have top := IntermediateField.top with extension
  have whole := tkJ.intermediate_subring with top
  unfold IntermediateField
  refine ⟨extension, ?_, ?_⟩
  . unfold SubalgebraOf
    refine ⟨algebra, ?_⟩
    unfold Subalgebra
    constructor
    . unfold IsSubring
      refine ⟨bounded, _, _, _, _, _⟩
      . have zeroL := IsSubring.zero_closed with whole
        apply tkJ.adjoin_intro with zeroL
        intros F inter sF
        have sub := tkJ.intermediate_subring with inter
        exact IsSubring.zero_closed with sub
      . have oneL := IsSubring.one_closed with whole
        apply tkJ.adjoin_intro with oneL
        intros F inter sF
        have sub := tkJ.intermediate_subring with inter
        exact IsSubring.one_closed with sub
      . unfold ClosedUnary
        intros x xIn
        have xL := bounded with x, xIn
        have negL := IsSubring.neg_closed with whole
        have valueL := negL with x, xL
        apply tkJ.adjoin_intro with valueL
        intros F inter sF
        have sub := tkJ.intermediate_subring with inter
        have negF := IsSubring.neg_closed with sub
        have xF := tkJ.adjoin_in with xIn, inter, sF
        exact negF with x, xF
      . unfold ClosedBinary
        intros x xIn y yIn
        have xL := bounded with x, xIn
        have yL := bounded with y, yIn
        have addL := IsSubring.add_closed with whole
        have valueL := addL with x, xL, y, yL
        apply tkJ.adjoin_intro with valueL
        intros F inter sF
        have sub := tkJ.intermediate_subring with inter
        have addF := IsSubring.add_closed with sub
        have xF := tkJ.adjoin_in with xIn, inter, sF
        have yF := tkJ.adjoin_in with yIn, inter, sF
        exact addF with x, xF, y, yF
      . unfold ClosedBinary
        intros x xIn y yIn
        have xL := bounded with x, xIn
        have yL := bounded with y, yIn
        have mulL := IsSubring.mul_closed with whole
        have valueL := mulL with x, xL, y, yL
        apply tkJ.adjoin_intro with valueL
        intros F inter sF
        have sub := tkJ.intermediate_subring with inter
        have mulF := IsSubring.mul_closed with sub
        have xF := tkJ.adjoin_in with xIn, inter, sF
        have yF := tkJ.adjoin_in with yIn, inter, sF
        exact mulF with x, xF, y, yF
    . intros y yIn
      have imageL := functionImage.subset at Algebra.map(E),
        Ring.carrier(Algebra.base(E)), algebraCarrier(E)
      have yL := imageL with y, yIn
      apply tkJ.adjoin_intro with yL
      intros F inter sF
      have bottom := IntermediateField.bottom_subset with extension, inter
      unfold bottomField at bottom
      exact bottom with y, yIn
  . intros x xIn nonzero
    have xL := bounded with x, xIn
    unfold algebraCarrier at xL
    obtain ⟨y, yL, product⟩ := tkJ.field_inverse with ringField, xL, nonzero
    refine ⟨y, ?_, product⟩
    have yL2 : y ∈ algebraCarrier(E)
      unfold algebraCarrier
      exact yL
    apply tkJ.adjoin_intro with yL2
    intros F inter sF
    have xF := tkJ.adjoin_in with xIn, inter, sF
    exact tkJ.intermediate_inverse_mem with inter, xF, nonzero, yL2, product

theorem fieldAdjoin.subset_adjoin (S : Set)
  requires subset : S ⊆ algebraCarrier(E)
  shows S ⊆ fieldAdjoin(E, S)
proof
  intros x xS
  have xL := subset with x, xS
  apply tkJ.adjoin_intro with xL
  intros F inter sF
  exact sF with x, xS

theorem fieldAdjoin.le_iff (S F : Set)
  requires subset : S ⊆ algebraCarrier(E)
  requires intermediate : IntermediateField(E, F)
  shows fieldAdjoin(E, S) ⊆ F ↔ S ⊆ F
proof
  constructor
  . intro le
    have contains := fieldAdjoin.subset_adjoin with extension, subset
    exact Subset.transitive with contains, le
  . intro sF
    intros x xIn
    exact tkJ.adjoin_in with xIn, intermediate, sF

-- adjoin_union: K(S ∪ T) = K(S) ⊔ K(T).
theorem fieldAdjoin.union (S T : Set)
  requires first : S ⊆ algebraCarrier(E)
  requires second : T ⊆ algebraCarrier(E)
  shows fieldAdjoin(E, S ∪ T) = fieldAdjoin(E, fieldAdjoin(E, S) ∪ fieldAdjoin(E, T))
proof
  have bothBound := (Subset.union2_iff at S, T, algebraCarrier(E)).backward with
    ⟨first, second⟩
  have boundS := tkJ.adjoin_bounded at E, S
  have boundT := tkJ.adjoin_bounded at E, T
  have adjBound := (Subset.union2_iff at fieldAdjoin(E, S), fieldAdjoin(E, T),
    algebraCarrier(E)).backward with ⟨boundS, boundT⟩
  have interST := fieldAdjoin.intermediate with extension, bothBound
  have interOuter := fieldAdjoin.intermediate with extension, adjBound
  have sS := fieldAdjoin.subset_adjoin with extension, first
  have sT := fieldAdjoin.subset_adjoin with extension, second
  have sOuter := fieldAdjoin.subset_adjoin with extension, adjBound
  have sST := fieldAdjoin.subset_adjoin with extension, bothBound
  apply Subset.antisymmetric
  . have mono := union2.monotone with sS, sT
    have into := Subset.transitive with mono, sOuter
    exact (fieldAdjoin.le_iff with extension, bothBound, interOuter).backward with into
  . have left : S ⊆ fieldAdjoin(E, S ∪ T)
      intros x xS
      exact sST with x, (union2.left at x, S, T with xS)
    have right : T ⊆ fieldAdjoin(E, S ∪ T)
      intros x xT
      exact sST with x, (union2.right at x, S, T with xT)
    have leS := (fieldAdjoin.le_iff with extension, first, interST).backward with left
    have leT := (fieldAdjoin.le_iff with extension, second, interST).backward with right
    have both := (Subset.union2_iff at fieldAdjoin(E, S), fieldAdjoin(E, T),
      fieldAdjoin(E, S ∪ T)).backward with ⟨leS, leT⟩
    exact (fieldAdjoin.le_iff with extension, adjBound, interST).backward with both

-- IntermediateField.exists_finset_of_mem_adjoin.
theorem fieldAdjoin.finite_support (S x : Set)
  requires subset : S ⊆ algebraCarrier(E)
  requires member : x ∈ fieldAdjoin(E, S)
  shows ∃ T, T ⊆ S ∧ Finite(T) ∧ x ∈ fieldAdjoin(E, T)
proof
  sorry

-- For algebraic S the adjoined field is the adjoined algebra
-- (IntermediateField.adjoin_algebraic_toSubalgebra, adjoin_toSubalgebra).
theorem fieldAdjoin.eq_algebra_adjoin (S : Set)
  requires subset : S ⊆ algebraCarrier(E)
  requires algebraic : ∀ x ∈ S, IntegralElement(E, x)
  shows fieldAdjoin(E, S) = adjoinOf(E, S)
proof
  sorry

-- K(x) is finite of degree deg minpoly(x) (IntermediateField.adjoin.finiteDimensional,
-- IntermediateField.adjoin.finrank).
theorem fieldAdjoin.simple_finite (x : Set)
  requires integral : IntegralElement(E, x)
  shows FiniteExtension(subextension(E, fieldAdjoin(E, {x}))) ∧
    extensionDegree(subextension(E, fieldAdjoin(E, {x}))) =
      polyNatDegree(Algebra.base(E), minpoly(E, x))
proof
  sorry

-- The join of two finite intermediate fields is finite
-- (IntermediateField.finiteDimensional_sup), and K(S) for finite S of
-- integral elements is finite (IntermediateField.finiteDimensional_adjoin).
theorem fieldAdjoin.finite_of_finite (S : Set)
  requires subset : S ⊆ algebraCarrier(E)
  requires finite : Finite(S)
  requires integral : ∀ x ∈ S, IntegralElement(E, x)
  shows FiniteExtension(subextension(E, fieldAdjoin(E, S)))
proof
  sorry

theorem IntermediateField.sup_finite (F G : Set)
  requires first : IntermediateField(E, F)
  requires second : IntermediateField(E, G)
  requires firstFinite : FiniteExtension(subextension(E, F))
  requires secondFinite : FiniteExtension(subextension(E, G))
  shows FiniteExtension(subextension(E, fieldAdjoin(E, F ∪ G)))
proof
  sorry

-- The primitive element theorem (Field.exists_primitive_element,
-- Field.powerBasisOfFiniteOfSeparable).
theorem FiniteExtension.primitive_element
  requires finite : FiniteExtension(E)
  requires separable : SeparableExtension(E)
  shows ∃ x ∈ algebraCarrier(E), fieldAdjoin(E, {x}) = algebraCarrier(E)
proof
  sorry

end Intermediate

-- Helpers: the minimal polynomial is the polynomial with its defining
-- property, evaluation sends 1 to 1, and the structure map reflects zero.
theorem tkJ.gal_minpoly_eq (E x p : Set)
  requires extension : FieldExtension(E)
  requires integral : IntegralElement(E, x)
  requires member : p ∈ uniPolys(Algebra.base(E))
  requires monic : PolyMonic(Algebra.base(E), p)
  requires root : polyAeval(E, x, p) = Ring.zero(Algebra.ring(E))
  requires minimal : ∀ q ∈ uniPolys(Algebra.base(E)),
    polyAeval(E, x, q) = Ring.zero(Algebra.ring(E)) →
    RingDvd(polynomialRing(Algebra.base(E), {0}), p, q)
  shows minpoly(E, x) = p
proof
  have sel := minpoly.selected with extension, integral
  obtain ⟨mIn, mSpec⟩ := sel
  have pSpec : PolyMonic(Algebra.base(E), p) ∧
      polyAeval(E, x, p) = Ring.zero(Algebra.ring(E)) ∧
      (∀ q ∈ uniPolys(Algebra.base(E)), polyAeval(E, x, q) = Ring.zero(Algebra.ring(E)) →
        RingDvd(polynomialRing(Algebra.base(E), {0}), p, q))
    exact ⟨monic, root, minimal⟩
  have u := minpoly.unique
  exact u with E, x, extension, integral, minpoly(E, x), mIn, mSpec, p, member, pSpec

theorem tkJ.gal_aeval_one (A x : Set)
  requires algebra : Algebra(A)
  requires point : x ∈ algebraCarrier(A)
  shows polyAeval(A, x, Ring.one(polynomialRing(Algebra.base(A), {0}))) =
    Ring.one(Algebra.ring(A))
proof
  have hom := tkJ.gal_aeval_hom with algebra, point
  unfold polyAeval
  unfold polyEval2
  exact RingHom.map_one with hom

theorem tkJ.gal_map_reflects_zero (E b : Set)
  requires extension : FieldExtension(E)
  requires member : b ∈ Ring.carrier(Algebra.base(E))
  requires vanishes : Algebra.map(E)(b) = Ring.zero(Algebra.ring(E))
  shows b = Ring.zero(Algebra.base(E))
proof
  obtain ⟨algebra, baseField, ringField⟩ := extension
  have structureMap := Algebra.structure_hom with algebra
  have parts := RingHom.parts with structureMap
  have fieldParts := Field.parts with baseField
  have targetField := Field.parts with ringField
  have targetComm := IsField.comm_ring with targetField
  have nontrivial := IsField.nontrivial with targetField
  exact IsRingHom.field_reflects_zero with fieldParts, targetComm, nontrivial, parts,
    member, vanishes

-- Section: Minimal polynomials
section MinimalPolynomial
variable (E : Set)
hypothesis extension : FieldExtension(E)

-- minpoly.monic, minpoly.aeval, minpoly.ne_zero.
theorem minpoly.spec (x : Set)
  requires integral : IntegralElement(E, x)
  shows minpoly(E, x) ∈ uniPolys(Algebra.base(E)) ∧
    PolyMonic(Algebra.base(E), minpoly(E, x)) ∧
    polyAeval(E, x, minpoly(E, x)) = Ring.zero(Algebra.ring(E)) ∧
    minpoly(E, x) ≠ Ring.zero(polynomialRing(Algebra.base(E), {0}))
proof
  have ext2 := extension
  obtain ⟨algebra, baseField, ringField⟩ := ext2
  have comm := Field.to_comm_ring with baseField
  have polys := polynomialRing.comm_ring at Algebra.base(E), {0} with comm
  have baseParts := Field.parts with baseField
  have nt := IsField.nontrivial with baseParts
  obtain ⟨_, _, nontrivial⟩ := nt
  have sel := minpoly.selected with extension, integral
  obtain ⟨mIn, mMonic, mRoot, mMin⟩ := sel
  have mP := mIn
  unfold uniPolys at mP
  have nz := PolyMonic.ne_zero at Algebra.base(E), minpoly(E, x) with comm, polys, mP,
    nontrivial, mMonic
  exact ⟨mIn, mMonic, mRoot, nz⟩

-- minpoly.dvd_iff: q(x) = 0 iff minpoly(x) ∣ q.
theorem minpoly.dvd_iff (x q : Set)
  requires integral : IntegralElement(E, x)
  requires member : q ∈ uniPolys(Algebra.base(E))
  shows polyAeval(E, x, q) = Ring.zero(Algebra.ring(E)) ↔
    RingDvd(polynomialRing(Algebra.base(E), {0}), minpoly(E, x), q)
proof
  have ext2 := extension
  obtain ⟨algebra, baseField, ringField⟩ := ext2
  have ringL := Algebra.comm_ring with algebra
  have int2 := integral
  obtain ⟨_, xL, _⟩ := int2
  have sel := minpoly.selected with extension, integral
  obtain ⟨mIn, mMonic, mRoot, mMin⟩ := sel
  constructor
  . intro root
    exact mMin with q, member, root
  . intro dvd
    obtain ⟨_, _, c, cIn, qEq⟩ := dvd
    have cUni : c ∈ uniPolys(Algebra.base(E))
      unfold uniPolys
      exact cIn
    have prod := tkJ.gal_aeval_mul with algebra, xL, mIn, cUni
    rw [← qEq, mRoot] at prod
    have cL := tkJ.gal_aeval_mem with algebra, xL, cUni
    have z : Ring.zero(Algebra.ring(E)) * polyAeval(E, x, c) = Ring.zero(Algebra.ring(E))
      by ring
    rw z at prod
    exact prod

-- minpoly.irreducible.
theorem minpoly.irreducible (x : Set)
  requires integral : IntegralElement(E, x)
  shows RingIrreducible(polynomialRing(Algebra.base(E), {0}), minpoly(E, x))
proof
  sorry

-- minpoly.eq_of_irreducible_of_monic: a monic irreducible polynomial
-- vanishing at x is the minimal polynomial.
theorem minpoly.eq_of_irreducible_monic (x p : Set)
  requires integral : IntegralElement(E, x)
  requires irreducible : RingIrreducible(polynomialRing(Algebra.base(E), {0}), p)
  requires monic : PolyMonic(Algebra.base(E), p)
  requires root : polyAeval(E, x, p) = Ring.zero(Algebra.ring(E))
  shows minpoly(E, x) = p
proof
  sorry

-- minpoly.min: the minimal polynomial has least degree among the nonzero
-- polynomials vanishing at x.
theorem minpoly.degree_le (x p : Set)
  requires integral : IntegralElement(E, x)
  requires member : p ∈ uniPolys(Algebra.base(E))
  requires nonzero : p ≠ Ring.zero(polynomialRing(Algebra.base(E), {0}))
  requires root : polyAeval(E, x, p) = Ring.zero(Algebra.ring(E))
  shows polyNatDegree(Algebra.base(E), minpoly(E, x)) ≤ polyNatDegree(Algebra.base(E), p)
proof
  have ext2 := extension
  obtain ⟨algebra, baseField, ringField⟩ := ext2
  have comm := Field.to_comm_ring with baseField
  have polys := polynomialRing.comm_ring at Algebra.base(E), {0} with comm
  have baseParts := Field.parts with baseField
  have nt := IsField.nontrivial with baseParts
  obtain ⟨_, _, nontrivial⟩ := nt
  have sel := minpoly.selected with extension, integral
  obtain ⟨mIn, mMonic, mRoot, mMin⟩ := sel
  have mP := mIn
  unfold uniPolys at mP
  have pP := member
  unfold uniPolys at pP
  have dvd := mMin with p, member, root
  obtain ⟨_, _, c, cIn, pEq⟩ := dvd
  exact uni.monic_dvd_le at Algebra.base(E), minpoly(E, x), c, p with comm, polys, mP,
    cIn, pP, nontrivial, mMonic, pEq, nonzero

-- minpoly.natDegree_le: in a finite extension deg minpoly(x) ≤ [L : K];
-- minpoly.ne_zero_of_finite: every element is integral.
theorem minpoly.natDegree_le (x : Set)
  requires finite : FiniteExtension(E)
  requires point : x ∈ algebraCarrier(E)
  shows IntegralElement(E, x) ∧
    polyNatDegree(Algebra.base(E), minpoly(E, x)) ≤ extensionDegree(E)
proof
  sorry

-- minpoly.eq_X_sub_C: the minimal polynomial of a ∈ K is X − a.
theorem minpoly.algebra_map (a : Set)
  requires scalar : a ∈ Ring.carrier(Algebra.base(E))
  shows minpoly(E, Algebra.map(E)(a)) = polyXSubC(Algebra.base(E), a)
proof
  have ext2 := extension
  obtain ⟨algebra, baseField, ringField⟩ := ext2
  have comm := Field.to_comm_ring with baseField
  have polys := polynomialRing.comm_ring at Algebra.base(E), {0} with comm
  have structureMap := Algebra.structure_hom with algebra
  have pIn := uni.XsubC_mem at Algebra.base(E), a with comm, polys, scalar
  have pUni : polyXSubC(Algebra.base(E), a) ∈ uniPolys(Algebra.base(E))
    unfold uniPolys
    exact pIn
  have monic := PolyMonic.X_sub_C at Algebra.base(E), a with comm, polys, scalar
  have value := polyAeval.algebra_map at E, a, polyXSubC(Algebra.base(E), a) with
    algebra, scalar, pIn
  have evaluated := polyEval.X_sub_C at Algebra.base(E), a, a with comm, polys, scalar,
    scalar
  have self : a - a = Ring.zero(Algebra.base(E)) by ring
  rw [evaluated, self] at value
  rw (RingHom.map_zero with structureMap) at value
  have aL := Algebra.map_mem with algebra, scalar
  have aL2 : Algebra.map(E)(a) ∈ algebraCarrier(E)
    unfold algebraCarrier
    exact aL
  have integral : IntegralElement(E, Algebra.map(E)(a))
    unfold IntegralElement
    exact ⟨algebra, aL2, polyXSubC(Algebra.base(E), a), monic, value⟩
  apply tkJ.gal_minpoly_eq with extension, integral, pUni, monic, value
  intros q qUni qRoot
  have qIn := qUni
  unfold uniPolys at qIn
  have mapped := polyAeval.algebra_map at E, a, q with algebra, scalar, qIn
  rw qRoot at mapped
  have evalHom := polyEval.hom at Algebra.base(E), a with comm, polys, scalar
  have evalIn : polyEval(Algebra.base(E), q, a) ∈ Ring.carrier(Algebra.base(E))
    unfold polyEval
    exact RingHom.map_mem with evalHom, qIn
  have flipped : Algebra.map(E)(polyEval(Algebra.base(E), q, a)) = Ring.zero(Algebra.ring(E))
    symm
    exact mapped
  have zero := tkJ.gal_map_reflects_zero at E, polyEval(Algebra.base(E), q, a) with
    extension, evalIn, flipped
  have isRoot : PolyIsRoot(Algebra.base(E), q, a)
    unfold PolyIsRoot
    exact ⟨scalar, zero⟩
  exact (polyXSubC.dvd_iff_root at Algebra.base(E), q, a with comm, polys, qIn,
    scalar).backward with isRoot

-- minpoly.algHom_eq: an injective K-algebra map keeps minimal polynomials.
theorem minpoly.algebra_hom (E2 f x : Set)
  requires target : FieldExtension(E2)
  requires hom : f : E →ₐ E2
  requires integral : IntegralElement(E, x)
  shows minpoly(E2, f(x)) = minpoly(E, x)
proof
  sorry

-- minpoly.exists_algEquiv_of_root: in a normal extension the roots of
-- minpoly(x) are the conjugates σ(x).
theorem minpoly.conjugate_of_root (x y : Set)
  requires normal : NormalExtension(E)
  requires point : x ∈ algebraCarrier(E)
  requires target : y ∈ algebraCarrier(E)
  requires root : polyAeval(E, y, minpoly(E, x)) = Ring.zero(Algebra.ring(E))
  shows ∃ σ ∈ algebraAutomorphisms(E), σ(x) = y
proof
  sorry

-- Automorphisms send x to roots of minpoly(x) (minpoly.algHom_eq with
-- aeval_algHom_apply).
theorem minpoly.root_of_conjugate (x σ : Set)
  requires integral : IntegralElement(E, x)
  requires automorphism : σ ∈ algebraAutomorphisms(E)
  shows polyAeval(E, σ(x), minpoly(E, x)) = Ring.zero(Algebra.ring(E))
proof
  have ext2 := extension
  obtain ⟨algebra, baseField, ringField⟩ := ext2
  have int2 := integral
  obtain ⟨_, xL, _⟩ := int2
  have sel := minpoly.selected with extension, integral
  obtain ⟨mIn, mMonic, mRoot, mMin⟩ := sel
  have mP := mIn
  unfold uniPolys at mP
  have iso := (tkJ.aut_member at E, σ).forward with automorphism
  obtain ⟨hom, _⟩ := iso
  have ringHom := AlgebraHom.ring_hom with hom
  have applied := polyAeval.algebra_hom_apply at E, E, σ, x, minpoly(E, x) with algebra,
    hom, xL, mP
  rw mRoot at applied
  rw (RingHom.map_zero with ringHom) at applied
  symm
  exact applied

-- IsIntegral.mem_intermediateField_of_minpoly_splits: if minpoly(x)
-- splits in F then x ∈ F.
theorem minpoly.mem_of_splits (F x : Set)
  requires intermediate : IntermediateField(E, F)
  requires integral : IntegralElement(E, x)
  requires splits : PolySplits(Algebra.base(E), subringRing(Algebra.ring(E), F),
    Algebra.map(E), minpoly(E, x))
  shows x ∈ F
proof
  sorry

end MinimalPolynomial

-- Section: Separable polynomials
section Separable
variable (K : Set)
hypothesis field : Field(K)

-- Polynomial.separable_X_sub_C, Polynomial.Separable.ne_zero.
theorem PolySeparable.X_sub_C (a : Set)
  requires point : a ∈ Ring.carrier(K)
  shows PolySeparable(K, polyXSubC(K, a))
proof
  sorry

theorem PolySeparable.ne_zero (p : Set)
  requires separable : PolySeparable(K, p)
  shows p ≠ Ring.zero(polynomialRing(K, {0}))
proof
  sorry

-- Polynomial.separable_map: separability does not change along a field
-- homomorphism.
theorem PolySeparable.map_iff (L f p : Set)
  requires target : Field(L)
  requires hom : f : K →+* L
  requires member : p ∈ uniPolys(K)
  shows PolySeparable(L, polyMap(K, L, f)(p)) ↔ PolySeparable(K, p)
proof
  sorry

-- Polynomial.separable_prod_X_sub_C_iff: Π (X − aᵢ) is separable iff the
-- aᵢ are distinct.
theorem PolySeparable.linear_product_iff (a : Set) (n : Nat)
  requires points : a : n → Ring.carrier(K)
  shows PolySeparable(K, polyLinearProduct(K, a, n)) ↔
    InjectiveBetween(a, n, Ring.carrier(K))
proof
  sorry

-- Polynomial.nodup_roots, card_rootSet_eq_natDegree: a separable
-- polynomial that splits has deg p distinct roots.
theorem PolySeparable.card_roots (E p : Set)
  requires extension : FieldExtension(E)
  requires base : Algebra.base(E) = K
  requires separable : PolySeparable(K, p)
  requires splits : PolySplits(K, Algebra.ring(E), Algebra.map(E), p)
  shows HasCardinality(polyAlgebraRootSet(E, p), polyNatDegree(K, p))
proof
  sorry

-- An irreducible polynomial over a field of characteristic zero is
-- separable (Irreducible.separable with CharZero), stated as: if
-- n·1 ≠ 0 for every n ≥ 1.
theorem PolySeparable.of_irreducible_char_zero (p : Set)
  requires charZero : ∀ n ∈ ℕ, 0 < n →
    ringNat(Ring.add(K), Ring.zero(K), Ring.one(K), n) ≠ Ring.zero(K)
  requires irreducible : RingIrreducible(polynomialRing(K, {0}), p)
  shows PolySeparable(K, p)
proof
  sorry

end Separable

-- Helpers: projections of the Galois group and automorphisms as ring maps.
theorem tkJ.galois_carrier (E : Set)
  shows Group.carrier(galoisGroup(E)) = algebraAutomorphisms(E)
proof
  simp [galoisGroup, Group.mk.carrier]

theorem tkJ.galois_mul (E : Set)
  shows Group.mul(galoisGroup(E)) = autComposition(E)
proof
  simp [galoisGroup, Group.mk.mul]

theorem tkJ.galois_one (E : Set)
  shows Group.one(galoisGroup(E)) = identity(algebraCarrier(E))
proof
  simp [galoisGroup, Group.mk.one]

theorem tkJ.galois_inv (E : Set)
  shows Group.inv(galoisGroup(E)) = autInverse(E)
proof
  simp [galoisGroup, Group.mk.inv]

theorem tkJ.aut_ring_hom (E σ : Set)
  requires member : σ ∈ algebraAutomorphisms(E)
  shows σ : Algebra.ring(E) →+* Algebra.ring(E)
proof
  have iso := (tkJ.aut_member at E, σ).forward with member
  obtain ⟨hom, bijective⟩ := iso
  exact AlgebraHom.ring_hom with hom

theorem tkJ.aut_converse_fix (E σ x : Set)
  requires member : σ ∈ algebraAutomorphisms(E)
  requires point : x ∈ algebraCarrier(E)
  requires fixed : σ(x) = x
  shows converse(σ, algebraCarrier(E), algebraCarrier(E))(x) = x
proof
  have bij := tkJ.aut_bijective with member
  have back := Bijective.inverse_apply with bij, point
  rw fixed at back
  exact back

-- Section: Galois theory
section GaloisTheory
variable (E : Set)
hypothesis extension : FieldExtension(E)

-- The fixed field is an intermediate field; the fixing subgroup is a
-- subgroup (FixedPoints.intermediateField, IntermediateField.fixingSubgroup).
theorem fixedField.intermediate (H : Set)
  requires subset : H ⊆ algebraAutomorphisms(E)
  shows IntermediateField(E, fixedField(E, H))
proof
  have ext2 := extension
  obtain ⟨algebra, baseField, ringField⟩ := ext2
  have comm := Algebra.comm_ring with algebra
  have bounded : fixedField(E, H) ⊆ algebraCarrier(E)
    intros x xIn
    obtain ⟨xL, _⟩ := fixedField.membership.forward with xIn
    exact xL
  have fixes : ∀ x ∈ fixedField(E, H), ∀ σ ∈ H, σ(x) = x
    intros x xIn σ σH
    obtain ⟨xL, all⟩ := fixedField.membership.forward with xIn
    exact all with σ, σH
  have top := IntermediateField.top with extension
  have whole := tkJ.intermediate_subring with top
  unfold IntermediateField
  refine ⟨extension, ?_, ?_⟩
  . unfold SubalgebraOf
    refine ⟨algebra, ?_⟩
    unfold Subalgebra
    constructor
    . unfold IsSubring
      refine ⟨bounded, _, _, _, _, _⟩
      . have zeroL := IsSubring.zero_closed with whole
        apply fixedField.membership.backward
        refine ⟨zeroL, ?_⟩
        intros σ σH
        have σA := subset with σ, σH
        have hom := tkJ.aut_ring_hom with σA
        exact RingHom.map_zero with hom
      . have oneL := IsSubring.one_closed with whole
        apply fixedField.membership.backward
        refine ⟨oneL, ?_⟩
        intros σ σH
        have σA := subset with σ, σH
        have hom := tkJ.aut_ring_hom with σA
        exact RingHom.map_one with hom
      . unfold ClosedUnary
        intros x xIn
        have xL := bounded with x, xIn
        have negL := IsSubring.neg_closed with whole
        have valueL := negL with x, xL
        apply fixedField.membership.backward
        refine ⟨valueL, ?_⟩
        intros σ σH
        have σA := subset with σ, σH
        have hom := tkJ.aut_ring_hom with σA
        have fx := fixes with x, xIn, σ, σH
        unfold algebraCarrier at xL
        rw RingHom.map_neg at σ, Algebra.ring(E), Algebra.ring(E), x with hom, xL
        rw fx
      . unfold ClosedBinary
        intros x xIn y yIn
        have xL := bounded with x, xIn
        have yL := bounded with y, yIn
        have addL := IsSubring.add_closed with whole
        have valueL := addL with x, xL, y, yL
        apply fixedField.membership.backward
        refine ⟨valueL, ?_⟩
        intros σ σH
        have σA := subset with σ, σH
        have hom := tkJ.aut_ring_hom with σA
        have fx := fixes with x, xIn, σ, σH
        have fy := fixes with y, yIn, σ, σH
        unfold algebraCarrier at xL
        unfold algebraCarrier at yL
        rw RingHom.map_add at σ, Algebra.ring(E), Algebra.ring(E), x, y with hom, xL, yL
        rw [fx, fy]
      . unfold ClosedBinary
        intros x xIn y yIn
        have xL := bounded with x, xIn
        have yL := bounded with y, yIn
        have mulL := IsSubring.mul_closed with whole
        have valueL := mulL with x, xL, y, yL
        apply fixedField.membership.backward
        refine ⟨valueL, ?_⟩
        intros σ σH
        have σA := subset with σ, σH
        have hom := tkJ.aut_ring_hom with σA
        have fx := fixes with x, xIn, σ, σH
        have fy := fixes with y, yIn, σ, σH
        unfold algebraCarrier at xL
        unfold algebraCarrier at yL
        rw RingHom.map_mul at σ, Algebra.ring(E), Algebra.ring(E), x, y with hom, xL, yL
        rw [fx, fy]
    . intros y yIn
      have imageL := functionImage.subset at Algebra.map(E),
        Ring.carrier(Algebra.base(E)), algebraCarrier(E)
      have yL := imageL with y, yIn
      obtain ⟨_, a, aIn, yEq⟩ := functionImage.membership.forward with yIn
      apply fixedField.membership.backward
      refine ⟨yL, ?_⟩
      intros σ σH
      have σA := subset with σ, σH
      have iso := (tkJ.aut_member at E, σ).forward with σA
      obtain ⟨hom, bijective⟩ := iso
      rw yEq
      exact AlgebraHom.map_base with hom, aIn
  . intros x xIn nonzero
    have xL := bounded with x, xIn
    unfold algebraCarrier at xL
    obtain ⟨y, yL, product⟩ := tkJ.field_inverse with ringField, xL, nonzero
    refine ⟨y, ?_, product⟩
    have yL2 : y ∈ algebraCarrier(E)
      unfold algebraCarrier
      exact yL
    apply fixedField.membership.backward
    refine ⟨yL2, ?_⟩
    intros σ σH
    have σA := subset with σ, σH
    have hom := tkJ.aut_ring_hom with σA
    have fx := fixes with x, xIn, σ, σH
    have σyL := RingHom.map_mem at σ, Algebra.ring(E), Algebra.ring(E), y with hom, yL
    have mapped := RingHom.map_mul at σ, Algebra.ring(E), Algebra.ring(E), x, y with hom, xL, yL
    have one := RingHom.map_one with hom
    rw [product, one, fx] at mapped
    have flipped : call2(Ring.mul(Algebra.ring(E)), x, σ(y)) = Ring.one(Algebra.ring(E))
      rw mapped
    exact tkJ.inverse_unique with comm, xL, σyL, yL, flipped, product

theorem fixingSubgroup.subgroup (F : Set)
  requires subset : F ⊆ algebraCarrier(E)
  shows Subgroup(fixingSubgroup(E, F), galoisGroup(E))
proof
  have group := galoisGroup.group with extension
  have ext2 := extension
  obtain ⟨algebra, baseField, ringField⟩ := ext2
  have idIso := AlgebraIso.identity with algebra
  have oneIn := (tkJ.aut_member at E, identity(algebraCarrier(E))).backward with idIso
  have bounded : fixingSubgroup(E, F) ⊆ algebraAutomorphisms(E)
    intros σ σIn
    obtain ⟨σA, _⟩ := fixingSubgroup.membership.forward with σIn
    exact σA
  unfold Subgroup
  rw [tkJ.galois_carrier, tkJ.galois_one, tkJ.galois_mul, tkJ.galois_inv]
  refine ⟨group, bounded, _, _, _⟩
  . apply fixingSubgroup.membership.backward
    refine ⟨oneIn, ?_⟩
    intros x xF
    have xL := subset with x, xF
    exact identity.apply with xL
  . intros σ σIn τ τIn
    have σA := bounded with σ, σIn
    have τA := bounded with τ, τIn
    obtain ⟨_, σfix⟩ := fixingSubgroup.membership.forward with σIn
    obtain ⟨_, τfix⟩ := fixingSubgroup.membership.forward with τIn
    have mem := tkJ.aut_compose_mem with σA, τA
    rw (tkJ.autComposition_apply with σA, τA)
    apply fixingSubgroup.membership.backward
    refine ⟨mem, ?_⟩
    intros x xF
    have xL := subset with x, xF
    have fσ := tkJ.aut_function with σA
    have fτ := tkJ.aut_function with τA
    rw (compose.apply with fτ, fσ, xL)
    have tx := τfix with x, xF
    rw tx
    exact σfix with x, xF
  . intros σ σIn
    have σA := bounded with σ, σIn
    obtain ⟨_, σfix⟩ := fixingSubgroup.membership.forward with σIn
    have mem := tkJ.aut_converse_mem with σA
    rw (tkJ.autInverse_apply with σA)
    apply fixingSubgroup.membership.backward
    refine ⟨mem, ?_⟩
    intros x xF
    have xL := subset with x, xF
    have sx := σfix with x, xF
    exact tkJ.aut_converse_fix with σA, xL, sx

-- mem_fixingSubgroup_iff and the Galois connection
-- (IntermediateField.gc): F ⊆ fixedField(H) iff H ⊆ fixingSubgroup(F).
theorem fixingSubgroup.galois_connection (F H : Set)
  requires fieldSubset : F ⊆ algebraCarrier(E)
  requires groupSubset : H ⊆ algebraAutomorphisms(E)
  shows F ⊆ fixedField(E, H) ↔ H ⊆ fixingSubgroup(E, F)
proof
  constructor
  . intro le
    intros σ σH
    have σA := groupSubset with σ, σH
    apply fixingSubgroup.membership.backward
    refine ⟨σA, ?_⟩
    intros x xF
    have xFixed := le with x, xF
    obtain ⟨_, all⟩ := fixedField.membership.forward with xFixed
    exact all with σ, σH
  . intro le
    intros x xF
    have xL := fieldSubset with x, xF
    apply fixedField.membership.backward
    refine ⟨xL, ?_⟩
    intros σ σH
    have σFix := le with σ, σH
    obtain ⟨_, all⟩ := fixingSubgroup.membership.forward with σFix
    exact all with x, xF

-- IntermediateField.forall_mem_adjoin_smul_eq_self_iff: σ fixes K(S)
-- iff σ fixes S.
theorem fixingSubgroup.adjoin (S : Set)
  requires subset : S ⊆ algebraCarrier(E)
  shows fixingSubgroup(E, fieldAdjoin(E, S)) = fixingSubgroup(E, S)
proof
  have sS := fieldAdjoin.subset_adjoin with extension, subset
  apply Subset.antisymmetric
  . intros σ σIn
    obtain ⟨σA, all⟩ := fixingSubgroup.membership.forward with σIn
    apply fixingSubgroup.membership.backward
    refine ⟨σA, ?_⟩
    intros x xS
    exact all with x, (sS with x, xS)
  . intros σ σIn
    obtain ⟨σA, all⟩ := fixingSubgroup.membership.forward with σIn
    have single : {σ} ⊆ algebraAutomorphisms(E)
      intros τ τIn
      have same := singleton.membership.forward with τIn
      rw same
      exact σA
    have inter := fixedField.intermediate with extension, single
    have contains : S ⊆ fixedField(E, {σ})
      intros x xS
      have xL := subset with x, xS
      apply fixedField.membership.backward
      refine ⟨xL, ?_⟩
      intros τ τIn
      have same := singleton.membership.forward with τIn
      rw same
      exact all with x, xS
    have le := (fieldAdjoin.le_iff with extension, subset, inter).backward with contains
    apply fixingSubgroup.membership.backward
    refine ⟨σA, ?_⟩
    intros x xK
    have xFixed := le with x, xK
    obtain ⟨_, fixes⟩ := fixedField.membership.forward with xFixed
    have σσ := singleton.membership.backward at σ, σ with rfl
    exact fixes with σ, σσ

-- IsGalois.card_aut_eq_finrank: |Gal(L/K)| = [L : K] for a finite
-- Galois extension, and the converse (IsGalois.of_card_aut_eq_finrank).
theorem GaloisExtension.card_aut
  requires finite : FiniteExtension(E)
  requires galois : GaloisExtension(E)
  shows order(galoisGroup(E)) = extensionDegree(E)
proof
  sorry

theorem GaloisExtension.of_card_aut
  requires finite : FiniteExtension(E)
  requires card : order(galoisGroup(E)) = extensionDegree(E)
  shows GaloisExtension(E)
proof
  sorry

-- IsGalois.mem_bot_iff_fixed, IsGalois.fixedField_top: the elements
-- fixed by all of Gal(L/K) are those of K.
theorem GaloisExtension.fixed_iff_bottom (x : Set)
  requires galois : GaloisExtension(E)
  requires point : x ∈ algebraCarrier(E)
  shows x ∈ bottomField(E) ↔ (∀ σ ∈ algebraAutomorphisms(E), σ(x) = x)
proof
  sorry

-- The fundamental theorem for finite Galois extensions
-- (IsGalois.fixedField_fixingSubgroup, IsGalois.fixingSubgroup_fixedField,
-- IsGalois.intermediateFieldEquivSubgroup).
theorem GaloisExtension.fixedField_fixingSubgroup (F : Set)
  requires finite : FiniteExtension(E)
  requires galois : GaloisExtension(E)
  requires intermediate : IntermediateField(E, F)
  shows fixedField(E, fixingSubgroup(E, F)) = F
proof
  sorry

theorem GaloisExtension.fixingSubgroup_fixedField (H : Set)
  requires finite : FiniteExtension(E)
  requires galois : GaloisExtension(E)
  requires subgroup : Subgroup(H, galoisGroup(E))
  shows fixingSubgroup(E, fixedField(E, H)) = H
proof
  sorry

-- [F : K] = [Gal(L/K) : Gal(L/F)] (IntermediateField.finrank_eq_fixingSubgroup_index)
-- and [L : F] = |Gal(L/F)| (IntermediateField.finrank_fixedField_eq_card,
-- IsGalois.card_fixingSubgroup_eq_finrank).
theorem GaloisExtension.degree_eq_index (F : Set)
  requires finite : FiniteExtension(E)
  requires galois : GaloisExtension(E)
  requires intermediate : IntermediateField(E, F)
  shows extensionDegree(subextension(E, F)) =
      index(galoisGroup(E), fixingSubgroup(E, F)) ∧
    extensionDegree(overExtension(E, F)) =
      cardinality(fixingSubgroup(E, F))
proof
  sorry

-- Restricting scalars to F: Gal(L/F) is the fixing subgroup
-- (IntermediateField.fixingSubgroupEquiv), as sets of maps.
theorem fixingSubgroup.over_automorphisms (F : Set)
  requires intermediate : IntermediateField(E, F)
  shows algebraAutomorphisms(overExtension(E, F)) = fixingSubgroup(E, F)
proof
  have ext2 := extension
  obtain ⟨algebra, baseField, ringField⟩ := ext2
  have overAlg := tkJ.overExtension_algebra with intermediate
  have bottom := IntermediateField.bottom_subset with extension, intermediate
  have mapF := Algebra.map_function with algebra
  ext σ
  constructor
  . intro h
    obtain ⟨space, iso⟩ := algebraAutomorphisms.membership.forward with h
    obtain ⟨hom, bij⟩ := iso
    obtain ⟨_, _, _, ringHom, commute⟩ := hom
    rw tkJ.over_ring at ringHom
    rw tkJ.over_carrier at bij
    rw [tkJ.over_base, subringRing.carrierOf, tkJ.over_map] at commute
    have fixesF : ∀ x ∈ F, σ(x) = x
      intros x xF
      have c := commute with x, xF
      rw (identity.apply at x, F with xF) at c
      exact c
    have homE : σ : E →ₐ E
      unfold AlgebraHom
      refine ⟨algebra, algebra, rfl, ringHom, ?_⟩
      intros a aK
      have mapIn : Algebra.map(E)(a) ∈ bottomField(E)
        unfold bottomField
        exact functionImage.value with mapF, aK
      exact fixesF with Algebra.map(E)(a), (bottom with Algebra.map(E)(a), mapIn)
    have isoE : σ : E ≃ₐ E
      unfold AlgebraIso
      exact ⟨homE, bij⟩
    have σA := (tkJ.aut_member at E, σ).backward with isoE
    apply fixingSubgroup.membership.backward
    exact ⟨σA, fixesF⟩
  . intro h
    obtain ⟨σA, fixes⟩ := fixingSubgroup.membership.forward with h
    have isoE := (tkJ.aut_member at E, σ).forward with σA
    obtain ⟨homE, bij⟩ := isoE
    obtain ⟨_, _, _, ringHom, _⟩ := homE
    have homO : σ : overExtension(E, F) →ₐ overExtension(E, F)
      unfold AlgebraHom
      rw [tkJ.over_ring, tkJ.over_base, tkJ.over_map]
      refine ⟨overAlg, overAlg, rfl, ringHom, ?_⟩
      intros a aF
      rw [tkJ.over_base, subringRing.carrierOf] at aF
      rw (identity.apply at a, F with aF)
      exact fixes with a, aF
    have isoO : σ : overExtension(E, F) ≃ₐ overExtension(E, F)
      unfold AlgebraIso
      rw tkJ.over_carrier
      exact ⟨homO, bij⟩
    exact (tkJ.aut_member at overExtension(E, F), σ).backward with isoO

-- IsGalois.tower_top_of_isGalois, IsGalois.tower_top_intermediateField:
-- L/F is Galois when L/K is.
theorem GaloisExtension.tower_top (F : Set)
  requires galois : GaloisExtension(E)
  requires intermediate : IntermediateField(E, F)
  shows GaloisExtension(overExtension(E, F))
proof
  sorry

-- Artin's theorem (IsGalois.of_fixed_field, FixedPoints.finrank_eq_card):
-- for a finite group H of automorphisms, L is Galois over the fixed field
-- of degree |H|.
theorem GaloisExtension.of_fixed_field (H : Set)
  requires subgroup : Subgroup(H, galoisGroup(E))
  requires finiteGroup : Finite(H)
  shows GaloisExtension(overExtension(E, fixedField(E, H))) ∧
    FiniteExtension(overExtension(E, fixedField(E, H))) ∧
    extensionDegree(overExtension(E, fixedField(E, H))) = cardinality(H)
proof
  sorry

-- Normal intermediate fields: F/K is normal iff σ(F) ⊆ F for every σ
-- (IntermediateField.normal_iff_forall_map_le), iff Gal(L/F) is normal
-- in Gal(L/K) (IsGalois.normal_iff_fixingSubgroup_normal).
theorem GaloisExtension.normal_iff_stable (F : Set)
  requires galois : GaloisExtension(E)
  requires intermediate : IntermediateField(E, F)
  shows NormalExtension(subextension(E, F)) ↔
    (∀ σ ∈ algebraAutomorphisms(E), autImage(E, σ, F) ⊆ F)
proof
  sorry

theorem GaloisExtension.normal_iff_normal_subgroup (F : Set)
  requires finite : FiniteExtension(E)
  requires galois : GaloisExtension(E)
  requires intermediate : IntermediateField(E, F)
  shows NormalExtension(subextension(E, F)) ↔
    NormalSubgroup(fixingSubgroup(E, F), galoisGroup(E))
proof
  sorry

-- A normal subextension of a Galois extension is Galois
-- (IsGalois.tower_bot with Normal).
theorem GaloisExtension.of_normal_sub (F : Set)
  requires galois : GaloisExtension(E)
  requires intermediate : IntermediateField(E, F)
  requires normal : NormalExtension(subextension(E, F))
  shows GaloisExtension(subextension(E, F))
proof
  sorry

-- Restriction to a normal subextension (AlgEquiv.restrictNormalHom,
-- AlgHom.restrictNormal_commutes): a homomorphism Gal(L/K) → Gal(F/K)
-- agreeing with σ on F, surjective, with kernel Gal(L/F)
-- (AlgEquiv.restrictNormalHom_surjective, IsGalois.normalAutEquivQuotient).
theorem galoisRestrict.hom (F : Set)
  requires algebraic : AlgebraicExtension(E)
  requires intermediate : IntermediateField(E, F)
  requires normal : NormalExtension(subextension(E, F))
  shows GroupHom(galoisRestrict(E, F), galoisGroup(E), galoisGroup(subextension(E, F)))
proof
  sorry

theorem galoisRestrict.apply (F σ x : Set)
  requires algebraic : AlgebraicExtension(E)
  requires intermediate : IntermediateField(E, F)
  requires normal : NormalExtension(subextension(E, F))
  requires automorphism : σ ∈ algebraAutomorphisms(E)
  requires point : x ∈ F
  shows galoisRestrict(E, F)(σ)(x) = σ(x)
proof
  sorry

theorem galoisRestrict.surjective (F : Set)
  requires normal : NormalExtension(E)
  requires intermediate : IntermediateField(E, F)
  requires normalSub : NormalExtension(subextension(E, F))
  shows SurjectiveBetween(galoisRestrict(E, F), algebraAutomorphisms(E),
    algebraAutomorphisms(subextension(E, F)))
proof
  sorry

theorem galoisRestrict.kernel (F : Set)
  requires algebraic : AlgebraicExtension(E)
  requires intermediate : IntermediateField(E, F)
  requires normal : NormalExtension(subextension(E, F))
  shows kernel(galoisRestrict(E, F), galoisGroup(E), galoisGroup(subextension(E, F))) =
    fixingSubgroup(E, F)
proof
  sorry

end GaloisTheory

-- Section: Splitting fields and algebraic closures
section Closures
variable (K : Set)
hypothesis field : Field(K)

-- Polynomial.SplittingField with its IsSplittingField instance: every
-- polynomial has a splitting field (a theorem; no field is chosen).
theorem IsSplittingField.exists (p : Set)
  requires member : p ∈ uniPolys(K)
  shows ∃ E, Algebra.base(E) = K ∧ IsSplittingField(E, p)
proof
  sorry

-- A splitting field is finite and normal (IsSplittingField.finiteDimensional,
-- Normal.of_isSplittingField), Galois when p is separable
-- (IsGalois.of_separable_splitting_field), and unique up to K-isomorphism
-- (IsSplittingField.algEquiv).
theorem IsSplittingField.finite_normal (E p : Set)
  requires base : Algebra.base(E) = K
  requires splitting : IsSplittingField(E, p)
  shows FiniteExtension(E) ∧ NormalExtension(E)
proof
  sorry

theorem IsSplittingField.galois (E p : Set)
  requires base : Algebra.base(E) = K
  requires splitting : IsSplittingField(E, p)
  requires separable : PolySeparable(K, p)
  shows GaloisExtension(E)
proof
  sorry

theorem IsSplittingField.unique (E E2 p : Set)
  requires base : Algebra.base(E) = K
  requires baseTwo : Algebra.base(E2) = K
  requires first : IsSplittingField(E, p)
  requires second : IsSplittingField(E2, p)
  shows ∃ f, f : E ≃ₐ E2
proof
  sorry

-- IsAlgClosed.exists_root, IsAlgClosed.splits, IsAlgClosed.exists_pow_nat_eq.
theorem AlgebraicallyClosed.exists_root (p : Set)
  requires closed : AlgebraicallyClosed(K)
  requires member : p ∈ uniPolys(K)
  requires degree : polyNatDegree(K, p) ≠ 0
  shows ∃ a ∈ Ring.carrier(K), PolyIsRoot(K, p, a)
proof
  sorry

theorem AlgebraicallyClosed.splits (p : Set)
  requires closed : AlgebraicallyClosed(K)
  requires member : p ∈ uniPolys(K)
  shows PolySplits(K, K, identity(Ring.carrier(K)), p)
proof
  sorry

theorem AlgebraicallyClosed.exists_pow_eq (x : Set) (n : Nat)
  requires closed : AlgebraicallyClosed(K)
  requires point : x ∈ Ring.carrier(K)
  requires positive : 0 < n
  shows ∃ z ∈ Ring.carrier(K), Ring.pow(K, z, n) = x
proof
  sorry

-- An algebraically closed field has no proper algebraic extension
-- (IsAlgClosed.algebraMap_surjective_of_isIntegral).
theorem AlgebraicallyClosed.algebraic_surjective (E : Set)
  requires closed : AlgebraicallyClosed(K)
  requires base : Algebra.base(E) = K
  requires algebraic : AlgebraicExtension(E)
  shows bottomField(E) = algebraCarrier(E)
proof
  sorry

-- AlgebraicClosure K with IsAlgClosure: every field has an algebraic
-- closure (a theorem; no closure is chosen in a definition), unique up to
-- K-isomorphism (IsAlgClosure.equiv).
theorem IsAlgebraicClosure.exists
  shows ∃ E, Algebra.base(E) = K ∧ IsAlgebraicClosure(E)
proof
  sorry

theorem IsAlgebraicClosure.unique (E E2 : Set)
  requires base : Algebra.base(E) = K
  requires baseTwo : Algebra.base(E2) = K
  requires first : IsAlgebraicClosure(E)
  requires second : IsAlgebraicClosure(E2)
  shows ∃ f, f : E ≃ₐ E2
proof
  sorry

-- IsAlgClosed.lift: an algebraic extension of K embeds over K into any
-- algebraically closed extension of K.
theorem AlgebraicallyClosed.lift (E E2 : Set)
  requires base : Algebra.base(E) = K
  requires baseTwo : Algebra.base(E2) = K
  requires algebraic : AlgebraicExtension(E)
  requires target : FieldExtension(E2)
  requires closed : AlgebraicallyClosed(Algebra.ring(E2))
  shows ∃ f, f : E →ₐ E2
proof
  sorry

-- An algebraic closure is normal and, over a field where every
-- irreducible polynomial is separable, Galois; an algebraic extension
-- of K embeds into it with image an intermediate field.
theorem IsAlgebraicClosure.normal (E : Set)
  requires base : Algebra.base(E) = K
  requires closure : IsAlgebraicClosure(E)
  shows NormalExtension(E)
proof
  sorry

end Closures
