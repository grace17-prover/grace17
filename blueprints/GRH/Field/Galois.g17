-- Finite Galois theory: field extensions as algebras between fields, the
-- degree [L : K], intermediate fields and adjunction, the minimal
-- polynomial, separable polynomials and extensions, splitting of
-- polynomials, normal and Galois extensions, the Galois group
-- Gal(L/K) = Aut_K(L), fixed fields and fixing subgroups, the fundamental
-- theorem, restriction to normal subextensions, primitive elements,
-- splitting fields, algebraically closed fields and algebraic closures.
-- Part of the GRH blueprint.
-- Planned home: Algebra/Field/Galois.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Field.Galois
import GRH.Algebra.Integral
import Grace.Cumulus.Algebra.Group.Lagrange
import Grace.Cumulus.Algebra.Group.Normal

-- Section: Field extensions
-- An extension L/K is a Cumulus Algebra E whose base K = Algebra.base(E)
-- and ring L = Algebra.ring(E) are fields; the structure map
-- Algebra.map(E) : K → L is Mathlib's algebraMap K L. Mathlib's
-- typeclass pair [Field K] [Field L] [Algebra K L] is this one set.
predicate FieldExtension (E : Set) :=
  Algebra(E) ∧ Field(Algebra.base(E)) ∧ Field(Algebra.ring(E))

-- The degree [L : K] (Module.finrank K L), meaningful when the extension
-- is finite; and finite and algebraic extensions (FiniteDimensional K L,
-- Algebra.IsAlgebraic K L).
def extensionDegree (E : Set) : Set := finrank(algebraModule(E), Algebra.base(E))

predicate FiniteExtension (E : Set) :=
  FieldExtension(E) ∧ FiniteDimensional(algebraModule(E), Algebra.base(E))

predicate AlgebraicExtension (E : Set) :=
  FieldExtension(E) ∧ AlgebraicAlgebra(E)

-- The polynomials K[X] over a ring, as a carrier.
def uniPolys (R : Set) : Set := Ring.carrier(polynomialRing(R, {0}))

-- Section: Intermediate fields
-- An intermediate field K ≤ F ≤ L (Mathlib's IntermediateField K L) is a
-- subset F of L that is a K-subalgebra closed under inverses.
predicate IntermediateField (E F : Set) :=
  FieldExtension(E) ∧ SubalgebraOf(E, F) ∧
  (∀ x ∈ F, x ≠ Ring.zero(Algebra.ring(E)) →
    (∃ y ∈ F, call2(Ring.mul(Algebra.ring(E)), x, y) = Ring.one(Algebra.ring(E))))

def intermediateFields (E : Set) : Set :=
  { F ∈ 𝒫(algebraCarrier(E)) | IntermediateField(E, F) }

-- ⊥ = the image of K (IntermediateField ⊥); ⊤ is algebraCarrier(E).
def bottomField (E : Set) : Set :=
  functionImage(Algebra.map(E), Ring.carrier(Algebra.base(E)), algebraCarrier(E))

-- K(S), the least intermediate field containing S (IntermediateField.adjoin);
-- the join F ⊔ G is fieldAdjoin(E, F ∪ G).
def fieldAdjoin (E S : Set) : Set :=
  { x ∈ algebraCarrier(E) | ∀ F ∈ intermediateFields(E), S ⊆ F → x ∈ F }

-- An intermediate field F as the extension F/K (Mathlib's coercion of F
-- to a field with its K-algebra structure), and L as the extension L/F
-- (the tower K ≤ F ≤ L, IsScalarTower K F L).
def subextension (E F : Set) : Set :=
  Algebra.mk(Algebra.base(E), subringRing(Algebra.ring(E), F), Algebra.map(E))

def overExtension (E F : Set) : Set :=
  Algebra.mk(subringRing(Algebra.ring(E), F), Algebra.ring(E), identity(F))

-- Section: The Galois group
-- Gal(L/K) = L ≃ₐ[K] L, the K-algebra automorphisms of L, under
-- composition: (σ τ)(x) = σ(τ(x)), as Mathlib's AlgEquiv.aut.
def algebraAutomorphisms (E : Set) : Set :=
  { σ ∈ functionSpace(algebraCarrier(E), algebraCarrier(E)) | AlgebraIso(σ, E, E) }

def autComposition (E : Set) : Set :=
  { p ∈ (algebraAutomorphisms(E) × algebraAutomorphisms(E)) × algebraAutomorphisms(E) |
    snd(p) = compose(fst(fst(p)), snd(fst(p)), algebraCarrier(E),
      algebraCarrier(E), algebraCarrier(E)) }

def autInverse (E : Set) : Set :=
  { p ∈ algebraAutomorphisms(E) × algebraAutomorphisms(E) |
    snd(p) = converse(fst(p), algebraCarrier(E), algebraCarrier(E)) }

def galoisGroup (E : Set) : Set :=
  Group.mk(algebraAutomorphisms(E), autComposition(E),
    identity(algebraCarrier(E)), autInverse(E))

-- The fixed field of a set H of automorphisms (IntermediateField.fixedField,
-- FixedPoints.intermediateField) and the fixing subgroup of a subset F
-- of L (IntermediateField.fixingSubgroup, fixingSubgroup).
def fixedField (E H : Set) : Set :=
  { x ∈ algebraCarrier(E) | ∀ σ ∈ H, σ(x) = x }

def fixingSubgroup (E F : Set) : Set :=
  { σ ∈ algebraAutomorphisms(E) | ∀ x ∈ F, σ(x) = x }

-- The image σ(F) of a subset (IntermediateField.map).
def autImage (E σ F : Set) : Set := functionImage(σ, F, algebraCarrier(E))

-- Restriction of automorphisms to a normal intermediate field F
-- (AlgEquiv.restrictNormalHom): σ ↦ σ|_F, an automorphism of F/K.
def galoisRestrict (E F : Set) : Set :=
  { p ∈ algebraAutomorphisms(E) × algebraAutomorphisms(subextension(E, F)) |
    ∃ σ ∈ algebraAutomorphisms(E), p = (σ, restrict(σ, F)) }

-- Section: Minimal polynomials, separability, splitting
-- The minimal polynomial of x ∈ L over K (minpoly K x): the monic
-- generator of the polynomials vanishing at x. Defined for x integral
-- over K; Mathlib's value 0 at a transcendental x is not part of the
-- definition.
-- Helpers: inverses in a field are unique.
theorem tkJ.field_inverse (R x : Set)
  requires field : Field(R)
  requires member : x ∈ Ring.carrier(R)
  requires nonzero : x ≠ Ring.zero(R)
  shows ∃ y ∈ Ring.carrier(R), call2(Ring.mul(R), x, y) = Ring.one(R)
proof
  have parts := Field.parts with field
  obtain ⟨y, inverse⟩ := IsField.inverse_exists with parts, member, nonzero
  obtain ⟨xIn, yIn, left, right⟩ := inverse
  exact ⟨y, yIn, right⟩

theorem tkJ.inverse_unique (R x y z : Set)
  requires comm : CommRing(R)
  requires xIn : x ∈ Ring.carrier(R)
  requires yIn : y ∈ Ring.carrier(R)
  requires zIn : z ∈ Ring.carrier(R)
  requires first : call2(Ring.mul(R), x, y) = Ring.one(R)
  requires second : call2(Ring.mul(R), x, z) = Ring.one(R)
  shows y = z
proof
  have e1 : y * (x * z) = (x * y) * z by ring
  have e2 : y * Ring.one(R) = y by ring
  have e3 : Ring.one(R) * z = z by ring
  rw [first, second] at e1
  cc

-- Helpers for the minimal polynomial: evaluation in an algebra as a ring
-- homomorphism, and the monic rescaling of a nonzero polynomial.
theorem tkJ.gal_aeval_hom (A x : Set)
  requires algebra : Algebra(A)
  requires point : x ∈ algebraCarrier(A)
  shows evaluationHom(Algebra.base(A), Algebra.ring(A), {0}, Algebra.map(A),
      constantFunction({0}, Ring.carrier(Algebra.ring(A)), x)) :
    polynomialRing(Algebra.base(A), {0}) →+* Algebra.ring(A)
proof
  have base := Algebra.base_comm_ring with algebra
  have polysK := polynomialRing.comm_ring at Algebra.base(A), {0} with base
  have ringA := Algebra.comm_ring with algebra
  have sh := Algebra.structure_hom with algebra
  have pt := point
  unfold algebraCarrier at pt
  exact polyEval2.hom at Algebra.base(A), Algebra.ring(A), Algebra.map(A), x with
    base, polysK, ringA, sh, pt

theorem tkJ.gal_aeval_mul (A x p q : Set)
  requires algebra : Algebra(A)
  requires point : x ∈ algebraCarrier(A)
  requires first : p ∈ uniPolys(Algebra.base(A))
  requires second : q ∈ uniPolys(Algebra.base(A))
  shows polyAeval(A, x, call2(Ring.mul(polynomialRing(Algebra.base(A), {0})), p, q)) =
    call2(Ring.mul(Algebra.ring(A)), polyAeval(A, x, p), polyAeval(A, x, q))
proof
  have hom := tkJ.gal_aeval_hom with algebra, point
  unfold uniPolys at first
  unfold uniPolys at second
  unfold polyAeval
  unfold polyEval2
  exact RingHom.map_mul with hom, first, second

theorem tkJ.gal_aeval_add (A x p q : Set)
  requires algebra : Algebra(A)
  requires point : x ∈ algebraCarrier(A)
  requires first : p ∈ uniPolys(Algebra.base(A))
  requires second : q ∈ uniPolys(Algebra.base(A))
  shows polyAeval(A, x, call2(Ring.add(polynomialRing(Algebra.base(A), {0})), p, q)) =
    call2(Ring.add(Algebra.ring(A)), polyAeval(A, x, p), polyAeval(A, x, q))
proof
  have hom := tkJ.gal_aeval_hom with algebra, point
  unfold uniPolys at first
  unfold uniPolys at second
  unfold polyAeval
  unfold polyEval2
  exact RingHom.map_add with hom, first, second

theorem tkJ.gal_aeval_mem (A x p : Set)
  requires algebra : Algebra(A)
  requires point : x ∈ algebraCarrier(A)
  requires member : p ∈ uniPolys(Algebra.base(A))
  shows polyAeval(A, x, p) ∈ Ring.carrier(Algebra.ring(A))
proof
  have hom := tkJ.gal_aeval_hom with algebra, point
  unfold uniPolys at member
  unfold polyAeval
  unfold polyEval2
  exact RingHom.map_mem with hom, member

theorem tkJ.gal_monic_rescale (K r : Set)
  requires field : Field(K)
  requires member : r ∈ uniPolys(K)
  requires nonzero : r ≠ Ring.zero(polynomialRing(K, {0}))
  shows ∃ c ∈ Ring.carrier(K),
    PolyMonic(K, call2(Ring.mul(polynomialRing(K, {0})), polyC(K, c), r)) ∧
    polyNatDegree(K, call2(Ring.mul(polynomialRing(K, {0})), polyC(K, c), r)) =
      polyNatDegree(K, r)
proof
  have comm := Field.to_comm_ring with field
  have polys := polynomialRing.comm_ring at K, {0} with comm
  have domain := Field.domain with field
  have rIn := member
  unfold uniPolys at rIn
  have spec := uni.deg_spec at K, r with comm, polys, rIn
  have leadNonzero := spec.right with nonzero
  have leadIn := uni.coeff_mem at K, r, polyNatDegree(K, r) with comm, rIn
  obtain ⟨c, cIn, product⟩ := tkJ.field_inverse with field, leadIn, leadNonzero
  have parts := Field.parts with field
  have nt := IsField.nontrivial with parts
  obtain ⟨_, _, distinct⟩ := nt
  have cNonzero : c ≠ Ring.zero(K)
    intro cz
    rw cz at product
    have z : polyCoeff(r, polyNatDegree(K, r)) * Ring.zero(K) = Ring.zero(K) by ring
    rw z at product
    exact distinct with product
  have cpIn := polyC.mem at K, c with comm, polys, cIn
  have cpNonzero : polyC(K, c) ≠ Ring.zero(polynomialRing(K, {0}))
    intro cz
    have zeroIn : Ring.zero(K) ∈ Ring.carrier(K) by typecheck
    have hom := polyC.hom at K with comm, polys
    have mz := RingHom.map_zero with hom
    have zz : polyC(K, Ring.zero(K)) = Ring.zero(polynomialRing(K, {0}))
      unfold polyC
      exact mz
    rw ← zz at cz
    have same := polyC.injective at K, c, Ring.zero(K) with comm, polys, cIn, zeroIn, cz
    exact cNonzero with same
  have degMul := polyNatDegree.mul at K, polyC(K, c), r with comm, polys, cpIn, rIn,
    domain, cpNonzero, nonzero
  have degC := polyNatDegree.C at K, c with comm, polys, cIn
  rw degC at degMul
  have leadMul := polyLeadingCoeff.mul at K, polyC(K, c), r with comm, polys, cpIn, rIn,
    domain
  have leadC : polyLeadingCoeff(K, polyC(K, c)) = c
    rw (uni.lead_eq at K, polyC(K, c) with comm, polys)
    rw degC
    have coefficient := polyC.coeff at K, c, 0 with comm, polys, cIn
    exact coefficient.left with rfl
  rw (uni.lead_eq at K, r with comm, polys) at leadMul
  rw leadC at leadMul
  have swap : c * polyCoeff(r, polyNatDegree(K, r)) =
    polyCoeff(r, polyNatDegree(K, r)) * c by ring
  rw [swap, product] at leadMul
  have mulIn : call2(Ring.mul(polynomialRing(K, {0})), polyC(K, c), r) ∈
    Ring.carrier(polynomialRing(K, {0})) by typecheck
  refine ⟨c, cIn, ?_, ?_⟩
  . unfold PolyMonic
    exact ⟨mulIn, leadMul⟩
  . rw degMul
    arith

-- The remainder of a root-vanishing division vanishes at x.
theorem tkJ.gal_aeval_decomp (A x q d p r : Set)
  requires algebra : Algebra(A)
  requires point : x ∈ algebraCarrier(A)
  requires qIn : q ∈ uniPolys(Algebra.base(A))
  requires dIn : d ∈ uniPolys(Algebra.base(A))
  requires pIn : p ∈ uniPolys(Algebra.base(A))
  requires rIn : r ∈ uniPolys(Algebra.base(A))
  requires decomp : q = call2(Ring.add(polynomialRing(Algebra.base(A), {0})),
    call2(Ring.mul(polynomialRing(Algebra.base(A), {0})), d, p), r)
  requires qRoot : polyAeval(A, x, q) = Ring.zero(Algebra.ring(A))
  requires pRoot : polyAeval(A, x, p) = Ring.zero(Algebra.ring(A))
  shows polyAeval(A, x, r) = Ring.zero(Algebra.ring(A))
proof
  have ringA := Algebra.comm_ring with algebra
  have base := Algebra.base_comm_ring with algebra
  have polys := polynomialRing.comm_ring at Algebra.base(A), {0} with base
  have dp : call2(Ring.mul(polynomialRing(Algebra.base(A), {0})), d, p) ∈
      uniPolys(Algebra.base(A))
    unfold uniPolys
    unfold uniPolys at dIn
    unfold uniPolys at pIn
    typecheck
  have sum := tkJ.gal_aeval_add with algebra, point, dp, rIn
  have product := tkJ.gal_aeval_mul with algebra, point, dIn, pIn
  have dL := tkJ.gal_aeval_mem with algebra, point, dIn
  have rL := tkJ.gal_aeval_mem with algebra, point, rIn
  rw [← decomp, qRoot, product, pRoot] at sum
  have z : polyAeval(A, x, d) * Ring.zero(Algebra.ring(A)) + polyAeval(A, x, r) =
    polyAeval(A, x, r) by ring
  rw z at sum
  symm
  exact sum

-- Monic polynomials dividing each other are equal.
theorem tkJ.gal_monic_dvd_antisymm (K p q : Set)
  requires field : Field(K)
  requires pMonic : PolyMonic(K, p)
  requires qMonic : PolyMonic(K, q)
  requires forward : RingDvd(polynomialRing(K, {0}), p, q)
  requires backward : RingDvd(polynomialRing(K, {0}), q, p)
  shows p = q
proof
  have comm := Field.to_comm_ring with field
  have polys := polynomialRing.comm_ring at K, {0} with comm
  have domain := Field.domain with field
  have parts := Field.parts with field
  have nt := IsField.nontrivial with parts
  obtain ⟨_, _, nontrivial⟩ := nt
  have pm := pMonic
  obtain ⟨pIn, pLead⟩ := pm
  have qm := qMonic
  obtain ⟨qIn, qLead⟩ := qm
  obtain ⟨_, _, c, cIn, qEq⟩ := forward
  obtain ⟨_, _, e, eIn, pEq⟩ := backward
  have pNonzero := PolyMonic.ne_zero at K, p with comm, polys, pIn, nontrivial, pMonic
  have qNonzero := PolyMonic.ne_zero at K, q with comm, polys, qIn, nontrivial, qMonic
  have le2 := uni.monic_dvd_le at K, q, e, p with comm, polys, qIn, eIn, pIn,
    nontrivial, qMonic, pEq, pNonzero
  have cNonzero : c ≠ Ring.zero(polynomialRing(K, {0}))
    intro cz
    rw cz at qEq
    have z : p * Ring.zero(polynomialRing(K, {0})) = Ring.zero(polynomialRing(K, {0})) by ring
    rw z at qEq
    exact qNonzero with qEq
  have degMul := polyNatDegree.mul at K, p, c with comm, polys, pIn, cIn, domain,
    pNonzero, cNonzero
  rw ← qEq at degMul
  have degC : polyNatDegree(K, c) = 0 by arith
  have leadMul := polyLeadingCoeff.mul at K, p, c with comm, polys, pIn, cIn, domain
  rw [← qEq, qLead, pLead] at leadMul
  rw (uni.lead_eq at K, c with comm, polys) at leadMul
  rw degC at leadMul
  have c0 := uni.coeff_mem at K, c, 0 with comm, cIn
  have one : Ring.one(K) * polyCoeff(c, 0) = polyCoeff(c, 0) by ring
  rw one at leadMul
  have cl : c ∈ polyDegreeLT(K, 1)
    unfold polyDegreeLT
    refine ⟨cIn, ?_⟩
    intros k hk
    have sc := uni.deg_spec at K, c with comm, polys, cIn
    unfold polyDegrees at hk
    obtain ⟨kN, nzk⟩ := hk
    have kNat := nat.omega.backward with kN
    have nz2 : polyCoeff(c, k) ≠ Ring.zero(K)
      unfold polyCoeff
      exact nzk
    have le := sc.left with k, kN, nz2
    arith
  have cc1 := uni.const_of_lt_one at K, c with comm, polys, cl
  rw ← leadMul at cc1
  rw ← (uni.one_eq at K with comm, polys) at cc1
  rw cc1 at qEq
  have unit : p * Ring.one(polynomialRing(K, {0})) = p by ring
  rw unit at qEq
  symm
  exact qEq

-- The degrees of the monic polynomials vanishing at x.
def tkJMonicRootDegrees (E x : Set) : Set :=
  { n ∈ ℕ | ∃ p ∈ uniPolys(Algebra.base(E)), PolyMonic(Algebra.base(E), p) ∧
    polyAeval(E, x, p) = Ring.zero(Algebra.ring(E)) ∧
    polyNatDegree(Algebra.base(E), p) = n }

defunique minpoly (E x : Set) (p ∈ uniPolys(Algebra.base(E))) :=
  PolyMonic(Algebra.base(E), p) ∧ polyAeval(E, x, p) = Ring.zero(Algebra.ring(E)) ∧
  (∀ q ∈ uniPolys(Algebra.base(E)), polyAeval(E, x, q) = Ring.zero(Algebra.ring(E)) →
    RingDvd(polynomialRing(Algebra.base(E), {0}), p, q))
requires extension : FieldExtension(E)
requires integral : IntegralElement(E, x)
proof
  have ext2 := extension
  obtain ⟨algebra, baseField, ringField⟩ := ext2
  have int2 := integral
  obtain ⟨_, xL, p0, p0Monic, p0Root⟩ := int2
  have comm := Field.to_comm_ring with baseField
  have polys := polynomialRing.comm_ring at Algebra.base(E), {0} with comm
  have baseParts := Field.parts with baseField
  have nt := IsField.nontrivial with baseParts
  obtain ⟨_, _, nontrivial⟩ := nt
  have pm0 := p0Monic
  obtain ⟨p0In, _⟩ := pm0
  have p0Uni : p0 ∈ uniPolys(Algebra.base(E))
    unfold uniPolys
    exact p0In
  have degN : polyNatDegree(Algebra.base(E), p0) ∈ ℕ by typecheck
  have inD : polyNatDegree(Algebra.base(E), p0) ∈ tkJMonicRootDegrees(E, x)
    apply tkJMonicRootDegrees.membership.backward
    exact ⟨degN, p0, p0Uni, p0Monic, p0Root, rfl⟩
  have nonempty : Nonempty(tkJMonicRootDegrees(E, x))
    unfold Nonempty
    exact ⟨polyNatDegree(Algebra.base(E), p0), inD⟩
  have naturals : tkJMonicRootDegrees(E, x) ⊆ ℕ
    intros n nIn
    obtain ⟨nN, _⟩ := tkJMonicRootDegrees.membership.forward with nIn
    exact nN
  have least := leastNatural.member with nonempty, naturals
  obtain ⟨_, p, pUni, pMonic, pRoot, pDeg⟩ :=
    tkJMonicRootDegrees.membership.forward with least
  refine ⟨p, pUni, pMonic, pRoot, ?_⟩
  intros q qUni qRoot
  have pIn := pUni
  unfold uniPolys at pIn
  have qIn := qUni
  unfold uniPolys at qIn
  have spec := polyDivision.spec at Algebra.base(E), q, p with comm, polys, qIn, pIn,
    nontrivial, pMonic
  obtain ⟨decomp, rLT⟩ := spec
  by_contra notDvd
  have rNonzero : polyModByMonic(Algebra.base(E), q, p) ≠
      Ring.zero(polynomialRing(Algebra.base(E), {0}))
    intro rz
    have dvd := (polyModByMonic.eq_zero_iff at Algebra.base(E), q, p with comm, polys,
      qIn, pIn, nontrivial, pMonic).forward with rz
    exact notDvd with dvd
  have rLT2 := rLT
  unfold polyDegreeLT at rLT2
  obtain ⟨rIn, rBelow⟩ := rLT2
  have rUni : polyModByMonic(Algebra.base(E), q, p) ∈ uniPolys(Algebra.base(E))
    unfold uniPolys
    exact rIn
  have sel := polyDivision.selected at Algebra.base(E), q, p with comm, nontrivial, qIn,
    pMonic
  obtain ⟨⟨_, d0, d0In, r0, r0In, shape⟩, _⟩ := sel
  have dUni : polyDivByMonic(Algebra.base(E), q, p) ∈ uniPolys(Algebra.base(E))
    unfold uniPolys
    unfold polyDivByMonic
    rw shape
    rw fst.pair
    exact d0In
  have rRoot := tkJ.gal_aeval_decomp with algebra, xL, qUni, dUni, pUni, rUni, decomp,
    qRoot, pRoot
  obtain ⟨c, cIn, scaledMonic, scaledDeg⟩ := tkJ.gal_monic_rescale with baseField, rUni,
    rNonzero
  have cpIn := polyC.mem at Algebra.base(E), c with comm, polys, cIn
  have cpUni : polyC(Algebra.base(E), c) ∈ uniPolys(Algebra.base(E))
    unfold uniPolys
    exact cpIn
  have scaledRoot := tkJ.gal_aeval_mul with algebra, xL, cpUni, rUni
  rw rRoot at scaledRoot
  have cL := tkJ.gal_aeval_mem with algebra, xL, cpUni
  have ringL := Algebra.comm_ring with algebra
  have z : polyAeval(E, x, polyC(Algebra.base(E), c)) * Ring.zero(Algebra.ring(E)) =
    Ring.zero(Algebra.ring(E)) by ring
  rw z at scaledRoot
  have scaledIn : call2(Ring.mul(polynomialRing(Algebra.base(E), {0})),
      polyC(Algebra.base(E), c), polyModByMonic(Algebra.base(E), q, p)) ∈
      uniPolys(Algebra.base(E))
    unfold uniPolys
    typecheck
  have rDegN : polyNatDegree(Algebra.base(E), polyModByMonic(Algebra.base(E), q, p)) ∈ ℕ
    by typecheck
  have scaledInD : polyNatDegree(Algebra.base(E), polyModByMonic(Algebra.base(E), q, p)) ∈
      tkJMonicRootDegrees(E, x)
    apply tkJMonicRootDegrees.membership.backward
    refine ⟨rDegN, call2(Ring.mul(polynomialRing(Algebra.base(E), {0})),
      polyC(Algebra.base(E), c), polyModByMonic(Algebra.base(E), q, p)), scaledIn,
      scaledMonic, scaledRoot, scaledDeg⟩
  have minimal := leastNatural.least at tkJMonicRootDegrees(E, x),
    polyNatDegree(Algebra.base(E), polyModByMonic(Algebra.base(E), q, p)) with nonempty,
    naturals, scaledInD
  rw ← pDeg at minimal
  have rSpec := uni.deg_spec at Algebra.base(E), polyModByMonic(Algebra.base(E), q, p)
    with comm, polys, rIn
  have topNonzero := rSpec.right with rNonzero
  have topIn : polyNatDegree(Algebra.base(E), polyModByMonic(Algebra.base(E), q, p)) ∈
      polyDegrees(Algebra.base(E), polyModByMonic(Algebra.base(E), q, p))
    unfold polyDegrees
    refine ⟨rDegN, ?_⟩
    unfold polyCoeff at topNonzero
    exact topNonzero
  have below := rBelow with polyNatDegree(Algebra.base(E),
    polyModByMonic(Algebra.base(E), q, p)), topIn
  arith
uniqueness
  have ext2 := extension
  obtain ⟨algebra, baseField, ringField⟩ := ext2
  intros p pUni pSpec p2 p2Uni p2Spec
  obtain ⟨pMonic, pRoot, pMin⟩ := pSpec
  obtain ⟨p2Monic, p2Root, p2Min⟩ := p2Spec
  have forward := pMin with p2, p2Uni, p2Root
  have backward := p2Min with p, pUni, pRoot
  exact tkJ.gal_monic_dvd_antisymm with baseField, pMonic, p2Monic, forward, backward

-- p is separable: p and its derivative are coprime, a p + b p' = 1
-- (Polynomial.Separable, IsCoprime p (derivative p)).
predicate PolySeparable (R p : Set) :=
  p ∈ uniPolys(R) ∧ (∃ a ∈ uniPolys(R), ∃ b ∈ uniPolys(R),
    call2(Ring.add(polynomialRing(R, {0})),
      call2(Ring.mul(polynomialRing(R, {0})), a, p),
      call2(Ring.mul(polynomialRing(R, {0})), b, polyDerivative(R)(p))) =
    Ring.one(polynomialRing(R, {0})))

-- p ∈ K[X] splits along f : K →+* L (Polynomial.Splits f p): its image
-- in L[X] is zero or a constant times a product of linear factors.
predicate PolySplits (K L f p : Set) :=
  p ∈ uniPolys(K) ∧ (polyMap(K, L, f)(p) = Ring.zero(polynomialRing(L, {0})) ∨
    (∃ n ∈ ℕ, ∃ a, FunctionBetween(a, n, Ring.carrier(L)) ∧
      polyMap(K, L, f)(p) = call2(Ring.mul(polynomialRing(L, {0})),
        polyC(L, polyLeadingCoeff(L, polyMap(K, L, f)(p))), polyLinearProduct(L, a, n))))

-- x is separable over K (IsSeparable K x); separable, normal and Galois
-- extensions (Algebra.IsSeparable, Normal, IsGalois).
predicate SeparableElement (E x : Set) :=
  IntegralElement(E, x) ∧ PolySeparable(Algebra.base(E), minpoly(E, x))

predicate SeparableExtension (E : Set) :=
  FieldExtension(E) ∧ (∀ x ∈ algebraCarrier(E), SeparableElement(E, x))

predicate NormalExtension (E : Set) :=
  AlgebraicExtension(E) ∧ (∀ x ∈ algebraCarrier(E),
    PolySplits(Algebra.base(E), Algebra.ring(E), Algebra.map(E), minpoly(E, x)))

predicate GaloisExtension (E : Set) := SeparableExtension(E) ∧ NormalExtension(E)

-- L is a splitting field of p over K (Polynomial.IsSplittingField): p
-- splits in L and L is generated by its roots; for p = 0, whose root set
-- Mathlib takes empty, L = K. Gal(L/K) of a splitting field is Mathlib's
-- Polynomial.Gal p, up to the isomorphism of splitting fields.
predicate IsSplittingField (E p : Set) :=
  FieldExtension(E) ∧ PolySplits(Algebra.base(E), Algebra.ring(E), Algebra.map(E), p) ∧
  (p ≠ Ring.zero(polynomialRing(Algebra.base(E), {0})) →
    fieldAdjoin(E, polyAlgebraRootSet(E, p)) = algebraCarrier(E)) ∧
  (p = Ring.zero(polynomialRing(Algebra.base(E), {0})) →
    bottomField(E) = algebraCarrier(E))

-- L is an algebraic closure of K (IsAlgClosure K L); algebraic
-- closedness of the field L is Cumulus's AlgebraicallyClosed (IsAlgClosed).
predicate IsAlgebraicClosure (E : Set) :=
  AlgebraicExtension(E) ∧ AlgebraicallyClosed(Algebra.ring(E))

-- Helpers for the Galois group: membership, and the composition and
-- inverse graphs as functions.
theorem tkJ.aut_member (E σ : Set)
  shows σ ∈ algebraAutomorphisms(E) ↔ σ : E ≃ₐ E
proof
  constructor
  . intro h
    obtain ⟨space, iso⟩ := algebraAutomorphisms.membership.forward with h
    exact iso
  . intro iso
    have iso2 := iso
    obtain ⟨hom, bijective⟩ := iso2
    have function := AlgebraHom.function with hom
    have space := (functionSpace.mem_iff at σ, algebraCarrier(E),
      algebraCarrier(E)).backward with function
    exact algebraAutomorphisms.membership.backward with ⟨space, iso⟩

theorem tkJ.aut_function (E σ : Set)
  requires member : σ ∈ algebraAutomorphisms(E)
  shows σ : algebraCarrier(E) → algebraCarrier(E)
proof
  have iso := (tkJ.aut_member at E, σ).forward with member
  obtain ⟨hom, bijective⟩ := iso
  exact AlgebraHom.function with hom

theorem tkJ.aut_bijective (E σ : Set)
  requires member : σ ∈ algebraAutomorphisms(E)
  shows BijectiveBetween(σ, algebraCarrier(E), algebraCarrier(E))
proof
  have iso := (tkJ.aut_member at E, σ).forward with member
  obtain ⟨hom, bijective⟩ := iso
  exact bijective

theorem tkJ.aut_compose_mem (E σ τ : Set)
  requires first : σ ∈ algebraAutomorphisms(E)
  requires second : τ ∈ algebraAutomorphisms(E)
  shows compose(σ, τ, algebraCarrier(E), algebraCarrier(E), algebraCarrier(E)) ∈
    algebraAutomorphisms(E)
proof
  have isoσ := (tkJ.aut_member at E, σ).forward with first
  have isoτ := (tkJ.aut_member at E, τ).forward with second
  have composite := AlgebraIso.compose with isoτ, isoσ
  exact (tkJ.aut_member at E, compose(σ, τ, algebraCarrier(E), algebraCarrier(E),
    algebraCarrier(E))).backward with composite

theorem tkJ.aut_converse_mem (E σ : Set)
  requires member : σ ∈ algebraAutomorphisms(E)
  shows converse(σ, algebraCarrier(E), algebraCarrier(E)) ∈ algebraAutomorphisms(E)
proof
  have iso := (tkJ.aut_member at E, σ).forward with member
  have inverse := AlgebraIso.inverse with iso
  exact (tkJ.aut_member at E, converse(σ, algebraCarrier(E),
    algebraCarrier(E))).backward with inverse

theorem tkJ.autComposition_relates (E σ τ : Set)
  requires first : σ ∈ algebraAutomorphisms(E)
  requires second : τ ∈ algebraAutomorphisms(E)
  shows relates(autComposition(E), (σ, τ),
    compose(σ, τ, algebraCarrier(E), algebraCarrier(E), algebraCarrier(E)))
proof
  have mem := tkJ.aut_compose_mem with first, second
  have pairIn := product.pair at σ, τ, algebraAutomorphisms(E),
    algebraAutomorphisms(E) with first, second
  have tripleIn := product.pair at (σ, τ), compose(σ, τ, algebraCarrier(E),
    algebraCarrier(E), algebraCarrier(E)),
    algebraAutomorphisms(E) × algebraAutomorphisms(E),
    algebraAutomorphisms(E) with pairIn, mem
  unfold relates
  apply autComposition.membership.backward
  refine ⟨tripleIn, ?_⟩
  simp [fst.pair, snd.pair]

theorem tkJ.autComposition_function (E : Set)
  shows autComposition(E) : algebraAutomorphisms(E) × algebraAutomorphisms(E) →
    algebraAutomorphisms(E)
proof
  constructor
  . intros p member
    obtain ⟨bounded, equation⟩ := autComposition.membership.forward with member
    exact bounded
  . constructor
    . intros x first xFirst second xSecond
      unfold relates at xFirst
      obtain ⟨_, e1⟩ := autComposition.membership.forward with xFirst
      unfold relates at xSecond
      obtain ⟨_, e2⟩ := autComposition.membership.forward with xSecond
      simp [fst.pair, snd.pair] at e1
      simp [fst.pair, snd.pair] at e2
      rw [e1, e2]
    . intros q qIn
      obtain ⟨bound, σ, σIn, τ, τIn, shape⟩ := product.membership.forward with qIn
      rw shape
      have mem := tkJ.aut_compose_mem with σIn, τIn
      have rel := tkJ.autComposition_relates with σIn, τIn
      exact ⟨compose(σ, τ, algebraCarrier(E), algebraCarrier(E), algebraCarrier(E)),
        mem, rel⟩

theorem tkJ.autComposition_apply (E σ τ : Set)
  requires first : σ ∈ algebraAutomorphisms(E)
  requires second : τ ∈ algebraAutomorphisms(E)
  shows autComposition(E)(σ, τ) =
    compose(σ, τ, algebraCarrier(E), algebraCarrier(E), algebraCarrier(E))
proof
  have function := tkJ.autComposition_function at E
  have pairIn := product.pair at σ, τ, algebraAutomorphisms(E),
    algebraAutomorphisms(E) with first, second
  have rel := tkJ.autComposition_relates with first, second
  have value := FunctionBetween.apply_value with function, pairIn, rel
  unfold call2
  exact value

theorem tkJ.autInverse_relates (E σ : Set)
  requires member : σ ∈ algebraAutomorphisms(E)
  shows relates(autInverse(E), σ, converse(σ, algebraCarrier(E), algebraCarrier(E)))
proof
  have mem := tkJ.aut_converse_mem with member
  have pairIn := product.pair at σ, converse(σ, algebraCarrier(E), algebraCarrier(E)),
    algebraAutomorphisms(E), algebraAutomorphisms(E) with member, mem
  unfold relates
  apply autInverse.membership.backward
  refine ⟨pairIn, ?_⟩
  simp [fst.pair, snd.pair]

theorem tkJ.autInverse_function (E : Set)
  shows autInverse(E) : algebraAutomorphisms(E) → algebraAutomorphisms(E)
proof
  constructor
  . intros p member
    obtain ⟨bounded, equation⟩ := autInverse.membership.forward with member
    exact bounded
  . constructor
    . intros x first xFirst second xSecond
      unfold relates at xFirst
      obtain ⟨_, e1⟩ := autInverse.membership.forward with xFirst
      unfold relates at xSecond
      obtain ⟨_, e2⟩ := autInverse.membership.forward with xSecond
      simp [fst.pair, snd.pair] at e1
      simp [fst.pair, snd.pair] at e2
      rw [e1, e2]
    . intros σ σIn
      have mem := tkJ.aut_converse_mem with σIn
      have rel := tkJ.autInverse_relates with σIn
      exact ⟨converse(σ, algebraCarrier(E), algebraCarrier(E)), mem, rel⟩

theorem tkJ.autInverse_apply (E σ : Set)
  requires member : σ ∈ algebraAutomorphisms(E)
  shows autInverse(E)(σ) = converse(σ, algebraCarrier(E), algebraCarrier(E))
proof
  have function := tkJ.autInverse_function at E
  have rel := tkJ.autInverse_relates with member
  exact FunctionBetween.apply_value with function, member, rel

-- Section: Extensions
section Extensions
variable (E : Set)
hypothesis extension : FieldExtension(E)

-- algebraMap K L is injective (RingHom.injective of a field).
theorem FieldExtension.map_injective
  shows InjectiveBetween(Algebra.map(E), Ring.carrier(Algebra.base(E)), algebraCarrier(E))
proof
  obtain ⟨algebra, baseField, ringField⟩ := extension
  have structureMap := Algebra.structure_hom with algebra
  have parts := RingHom.parts with structureMap
  have fieldParts := Field.parts with baseField
  have targetField := Field.parts with ringField
  have targetComm := IsField.comm_ring with targetField
  have nontrivial := IsField.nontrivial with targetField
  have injective := IsRingHom.field_injective with fieldParts, targetComm,
    nontrivial, parts
  unfold algebraCarrier
  exact injective

-- Module.finrank_pos and the degree one case (IntermediateField.finrank_eq_one_iff,
-- Algebra.finrank_eq_one_iff for ⊥ = ⊤).
theorem extensionDegree.pos
  requires finite : FiniteExtension(E)
  shows 0 < extensionDegree(E)
proof
  have fin2 := finite
  obtain ⟨_, dimensional⟩ := fin2
  have ext2 := extension
  obtain ⟨algebra, baseField, ringField⟩ := ext2
  have module := algebraModule.module_of with algebra
  have ringParts := Field.parts with ringField
  have ntL := IsField.nontrivial with ringParts
  obtain ⟨zeroL, oneL, distinctL⟩ := ntL
  have zeroEq : Module.zero(algebraModule(E)) = Ring.zero(Algebra.ring(E))
    simp [algebraModule, Module.mk.zero]
  have nonzero : ∃ v ∈ Module.carrier(algebraModule(E)), v ≠ Module.zero(algebraModule(E))
    refine ⟨Ring.one(Algebra.ring(E)), ?_, ?_⟩
    . rw algebraModule.carrier_eq
      unfold algebraCarrier
      exact oneL
    . rw zeroEq
      intro same
      symm at same
      exact distinctL with same
  unfold extensionDegree
  exact finrank.pos at Algebra.base(E), algebraModule(E) with baseField, module,
    dimensional, nonzero

theorem extensionDegree.eq_one_iff
  requires finite : FiniteExtension(E)
  shows extensionDegree(E) = 1 ↔ bottomField(E) = algebraCarrier(E)
proof
  have fin2 := finite
  obtain ⟨_, dimensional⟩ := fin2
  have ext2 := extension
  obtain ⟨algebra, baseField, ringField⟩ := ext2
  have comm := Field.to_comm_ring with baseField
  have ringK := CommRing.to_ring with comm
  have ringL := Algebra.comm_ring with algebra
  have module := algebraModule.module_of with algebra
  have carrierEq := algebraModule.carrier_eq at E
  have baseParts := Field.parts with baseField
  have ntK := IsField.nontrivial with baseParts
  obtain ⟨zeroK, oneK, distinctK⟩ := ntK
  have ringParts := Field.parts with ringField
  have ntL := IsField.nontrivial with ringParts
  obtain ⟨_, oneL0, distinctL⟩ := ntL
  have oneL : Ring.one(Algebra.ring(E)) ∈ algebraCarrier(E)
    unfold algebraCarrier
    exact oneL0
  have mapF := Algebra.map_function with algebra
  have sh := Algebra.structure_hom with algebra
  have zeroIn1 : (0:Nat) ∈ 1 by simp
  have single : ∀ i ∈ 1, i = 0
    intros i hi
    rw membership.successor_set at hi
    cases hi with h0 | h1
    . exfalso
      rw nat.zero at h0
      exact empty.membership at i with h0
    . exact h1
  constructor
  . intro one
    have free := FiniteDimensional.finite_free at Algebra.base(E), algebraModule(E) with
      baseField, module, dimensional
    obtain ⟨v, basis⟩ := finrank.basis_exists at Algebra.base(E), algebraModule(E) with
      comm, distinctK, module, free
    unfold extensionDegree at one
    rw one at basis
    obtain ⟨_, spansV⟩ := basis
    obtain ⟨_, vF, spanEq⟩ := spansV
    have v0V := FunctionBetween.apply_closed with vF, zeroIn1
    have img : functionImage(v, 1, Module.carrier(algebraModule(E))) = {v(0)}
      ext y
      constructor
      . intro hy
        obtain ⟨_, i, iIn, yEq⟩ := functionImage.membership.forward with hy
        rw (single with i, iIn) at yEq
        rw yEq
        simp [singleton.membership]
      . intro hy
        rw singleton.membership at hy
        rw hy
        exact functionImage.value with vF, zeroIn1
    rw img at spanEq
    rw (moduleSpan.singleton at Algebra.base(E), algebraModule(E), v(0) with ringK, module,
      v0V) at spanEq
    have v0L := v0V
    rw carrierEq at v0L
    have v0L2 := v0L
    unfold algebraCarrier at v0L2
    apply Subset.antisymmetric
    . unfold bottomField
      exact functionImage.subset at Algebra.map(E), Ring.carrier(Algebra.base(E)),
        algebraCarrier(E)
    . intros y yL
      have yV : y ∈ Module.carrier(algebraModule(E))
        rw carrierEq
        exact yL
      rw ← spanEq at yV
      obtain ⟨_, r, rK, yEq⟩ := scalarMultiples.membership.forward with yV
      have oneV : Ring.one(Algebra.ring(E)) ∈ Module.carrier(algebraModule(E))
        rw carrierEq
        exact oneL
      rw ← spanEq at oneV
      obtain ⟨_, r1, r1K, oneEq⟩ := scalarMultiples.membership.forward with oneV
      rw (algebraModule.smul_value with algebra, rK, v0L) at yEq
      rw (algebraModule.smul_value with algebra, r1K, v0L) at oneEq
      have r1Nonzero : r1 ≠ Ring.zero(Algebra.base(E))
        intro rz
        rw [rz, (RingHom.map_zero with sh)] at oneEq
        have z : Ring.zero(Algebra.ring(E)) * v(0) = Ring.zero(Algebra.ring(E)) by ring
        rw z at oneEq
        symm at oneEq
        exact distinctL with oneEq
      obtain ⟨s, sK, rs⟩ := tkJ.field_inverse with baseField, r1K, r1Nonzero
      have mr := Algebra.map_mem with algebra, rK
      have mr1 := Algebra.map_mem with algebra, r1K
      have ms := Algebra.map_mem with algebra, sK
      have prod := RingHom.map_mul at Algebra.map(E), Algebra.base(E), Algebra.ring(E), r1,
        s with sh, r1K, sK
      rw [rs, (RingHom.map_one with sh)] at prod
      have v0Eq : v(0) = Algebra.map(E)(s)
        have t : Algebra.map(E)(s) * (Algebra.map(E)(r1) * v(0)) =
            (Algebra.map(E)(r1) * Algebra.map(E)(s)) * v(0) by ring
        rw [← oneEq, ← prod] at t
        have u1 : Algebra.map(E)(s) * Ring.one(Algebra.ring(E)) = Algebra.map(E)(s) by ring
        have u2 : Ring.one(Algebra.ring(E)) * v(0) = v(0) by ring
        rw [u1, u2] at t
        symm
        exact t
      rw v0Eq at yEq
      have rsK : r * s ∈ Ring.carrier(Algebra.base(E)) by typecheck
      have prod2 := RingHom.map_mul at Algebra.map(E), Algebra.base(E), Algebra.ring(E), r,
        s with sh, rK, sK
      rw ← prod2 at yEq
      unfold bottomField
      apply functionImage.membership.backward
      exact ⟨yL, r * s, rsK, yEq⟩
  . intro botEq
    have oneV : Ring.one(Algebra.ring(E)) ∈ Module.carrier(algebraModule(E))
      rw carrierEq
      exact oneL
    have vF := constantFunction.function at 1, Module.carrier(algebraModule(E)),
      Ring.one(Algebra.ring(E)) with oneV
    have img : functionImage(constantFunction(1, Module.carrier(algebraModule(E)),
        Ring.one(Algebra.ring(E))), 1, Module.carrier(algebraModule(E))) =
        {Ring.one(Algebra.ring(E))}
      ext y
      constructor
      . intro hy
        obtain ⟨_, i, iIn, yEq⟩ := functionImage.membership.forward with hy
        rw (constantFunction.apply with iIn, oneV) at yEq
        rw yEq
        simp [singleton.membership]
      . intro hy
        rw singleton.membership at hy
        rw hy
        have value := functionImage.value with vF, zeroIn1
        rw (constantFunction.apply with zeroIn1, oneV) at value
        exact value
    have spanEq : moduleSpan(algebraModule(E), Algebra.base(E),
        {Ring.one(Algebra.ring(E))}) = Module.carrier(algebraModule(E))
      rw (moduleSpan.singleton at Algebra.base(E), algebraModule(E),
        Ring.one(Algebra.ring(E)) with ringK, module, oneV)
      ext y
      constructor
      . intro hy
        obtain ⟨yV, _⟩ := scalarMultiples.membership.forward with hy
        exact yV
      . intro hy
        have yL := hy
        rw carrierEq at yL
        rw ← botEq at yL
        unfold bottomField at yL
        obtain ⟨_, a, aK, yEq⟩ := functionImage.membership.forward with yL
        apply scalarMultiples.membership.backward
        refine ⟨hy, a, aK, ?_⟩
        rw (algebraModule.smul_value with algebra, aK, oneL)
        have ma := Algebra.map_mem with algebra, aK
        have u : Algebra.map(E)(a) * Ring.one(Algebra.ring(E)) = Algebra.map(E)(a) by ring
        rw u
        exact yEq
    have spans : SpansModule(algebraModule(E), Algebra.base(E), 1,
        constantFunction(1, Module.carrier(algebraModule(E)), Ring.one(Algebra.ring(E))))
      unfold SpansModule
      rw img
      exact ⟨module, vF, spanEq⟩
    have fin1 := Finite.natural at 1
    have le := SpansModule.finrank_le_card at Algebra.base(E), algebraModule(E), 1,
      constantFunction(1, Module.carrier(algebraModule(E)), Ring.one(Algebra.ring(E))) with
      baseField, module, fin1, spans
    obtain ⟨_, bound⟩ := le
    rw (cardinality.natural at 1) at bound
    have pos := extensionDegree.pos with extension, finite
    unfold extensionDegree at pos
    unfold extensionDegree
    arith

-- A finite extension is algebraic (Algebra.IsAlgebraic.of_finite).
theorem FiniteExtension.algebraic
  requires finite : FiniteExtension(E)
  shows AlgebraicExtension(E)
proof
  obtain ⟨_, dimensional⟩ := finite
  obtain ⟨_, generated⟩ := dimensional
  have ext2 := extension
  obtain ⟨algebra, baseField, ringField⟩ := ext2
  have baseParts := Field.parts with baseField
  have nt := IsField.nontrivial with baseParts
  obtain ⟨_, _, nontrivial⟩ := nt
  have finiteAlgebra : FiniteAlgebra(E)
    unfold FiniteAlgebra
    exact ⟨algebra, generated⟩
  have integralAlgebra := IntegralAlgebra.of_finite with algebra, finiteAlgebra
  obtain ⟨_, integralAll⟩ := integralAlgebra
  unfold AlgebraicExtension
  refine ⟨extension, ?_⟩
  unfold AlgebraicAlgebra
  refine ⟨algebra, ?_⟩
  intros x xL
  have integral := integralAll with x, xL
  exact IntegralElement.algebraic with algebra, nontrivial, integral

theorem galoisGroup.group
  shows Group(galoisGroup(E))
proof
  obtain ⟨algebra, baseField, ringField⟩ := extension
  have mulF := tkJ.autComposition_function at E
  have invF := tkJ.autInverse_function at E
  have idIso := AlgebraIso.identity with algebra
  have oneIn := (tkJ.aut_member at E, identity(algebraCarrier(E))).backward with idIso
  unfold galoisGroup
  apply Group.intro
  . exact mulF
  . exact oneIn
  . exact invF
  . intros a aIn b bIn c cIn
    have ab := tkJ.aut_compose_mem with aIn, bIn
    have bc := tkJ.aut_compose_mem with bIn, cIn
    have fa := tkJ.aut_function with aIn
    have fb := tkJ.aut_function with bIn
    have fc := tkJ.aut_function with cIn
    have fab := tkJ.aut_function with ab
    have fbc := tkJ.aut_function with bc
    rw [(tkJ.autComposition_apply at E, a, b with aIn, bIn),
      (tkJ.autComposition_apply at E, b, c with bIn, cIn),
      (tkJ.autComposition_apply with ab, cIn),
      (tkJ.autComposition_apply with aIn, bc)]
    apply FunctionBetween.ext at _, _, algebraCarrier(E), algebraCarrier(E)
    . exact compose.function with fc, fab
    . exact compose.function with fbc, fa
    . intros x xIn
      have cx := FunctionBetween.apply_closed with fc, xIn
      have bcx := FunctionBetween.apply_closed with fb, cx
      rw [(compose.apply with fc, fab, xIn), (compose.apply with fb, fa, cx),
        (compose.apply with fbc, fa, xIn), (compose.apply with fc, fb, xIn)]
  . intros a aIn
    have fa := tkJ.aut_function with aIn
    rw tkJ.autComposition_apply with oneIn, aIn
    exact compose.identity_left with fa
  . intros a aIn
    have fa := tkJ.aut_function with aIn
    rw tkJ.autComposition_apply with aIn, oneIn
    exact compose.identity_right with fa
  . intros a aIn
    have inv := tkJ.aut_converse_mem with aIn
    have fa := tkJ.aut_function with aIn
    have finv := tkJ.aut_function with inv
    have bij := tkJ.aut_bijective with aIn
    rw [(tkJ.autInverse_apply with aIn), (tkJ.autComposition_apply with inv, aIn)]
    apply FunctionBetween.ext at _, _, algebraCarrier(E), algebraCarrier(E)
    . exact compose.function with fa, finv
    . exact identity.function
    . intros x xIn
      rw [(compose.apply with fa, finv, xIn), (identity.apply with xIn)]
      exact Bijective.inverse_apply with bij, xIn
  . intros a aIn
    have inv := tkJ.aut_converse_mem with aIn
    have fa := tkJ.aut_function with aIn
    have finv := tkJ.aut_function with inv
    have bij := tkJ.aut_bijective with aIn
    rw [(tkJ.autInverse_apply with aIn), (tkJ.autComposition_apply with aIn, inv)]
    apply FunctionBetween.ext at _, _, algebraCarrier(E), algebraCarrier(E)
    . exact compose.function with finv, fa
    . exact identity.function
    . intros x xIn
      rw [(compose.apply with finv, fa, xIn), (identity.apply with xIn)]
      exact Bijective.apply_inverse with bij, xIn

-- AlgEquiv.mul_apply, AlgEquiv.one_apply.
theorem galoisGroup.mul_apply (σ τ x : Set)
  requires first : σ ∈ algebraAutomorphisms(E)
  requires second : τ ∈ algebraAutomorphisms(E)
  requires point : x ∈ algebraCarrier(E)
  shows Group.mul(galoisGroup(E))(σ, τ)(x) = σ(τ(x))
proof
  have mulOf : Group.mul(galoisGroup(E)) = autComposition(E)
    simp [galoisGroup, Group.mk.mul]
  have fσ := tkJ.aut_function with first
  have fτ := tkJ.aut_function with second
  rw [mulOf, (tkJ.autComposition_apply with first, second)]
  exact compose.apply with fτ, fσ, point

theorem galoisGroup.one_apply (x : Set)
  requires point : x ∈ algebraCarrier(E)
  shows Group.one(galoisGroup(E))(x) = x
proof
  have oneOf : Group.one(galoisGroup(E)) = identity(algebraCarrier(E))
    simp [galoisGroup, Group.mk.one]
  rw oneOf
  exact identity.apply with point

-- An algebra endomorphism of an algebraic extension is an automorphism
-- (Algebra.IsAlgebraic.algHom_bijective; Normal.algHomEquivAut).
theorem AlgebraicExtension.endomorphism_bijective (f : Set)
  requires algebraic : AlgebraicExtension(E)
  requires hom : f : E →ₐ E
  shows f ∈ algebraAutomorphisms(E)
proof
  have ext2 := extension
  obtain ⟨algebra, baseField, ringField⟩ := ext2
  have alg2 := algebraic
  obtain ⟨_, algAlg⟩ := alg2
  obtain ⟨_, allAlg⟩ := algAlg
  have comm := Field.to_comm_ring with baseField
  have polys := polynomialRing.comm_ring at Algebra.base(E), {0} with comm
  have ringL := Algebra.comm_ring with algebra
  have polysL := polynomialRing.comm_ring at Algebra.ring(E), {0} with ringL
  have domainL := Field.domain with ringField
  have mapL := Algebra.structure_hom with algebra
  have ringParts := Field.parts with ringField
  have ntL := IsField.nontrivial with ringParts
  have ntL2 := ntL
  obtain ⟨_, _, distinctL⟩ := ntL2
  have targetComm := IsField.comm_ring with ringParts
  have fF := AlgebraHom.function with hom
  have ringHom := AlgebraHom.ring_hom with hom
  have homParts := RingHom.parts with ringHom
  have injective := IsRingHom.field_injective with ringParts, targetComm, ntL, homParts
  have injective2 : InjectiveBetween(f, algebraCarrier(E), algebraCarrier(E))
    unfold algebraCarrier
    exact injective
  have onto : ∀ y ∈ algebraCarrier(E), ∃ x ∈ algebraCarrier(E), relates(f, x, y)
    intros y yL
    have yAlg := allAlg with y, yL
    have yInt := (AlgebraicElement.iff_integral at E, y with algebra, baseField).forward
      with yAlg
    have sel := minpoly.selected with extension, yInt
    obtain ⟨mIn, mMonic, mRoot, _⟩ := sel
    have mP := mIn
    unfold uniPolys at mP
    have mapped := polyMap.monic at Algebra.base(E), Algebra.ring(E), Algebra.map(E),
      minpoly(E, y) with comm, polys, ringL, mapL, mMonic, distinctL
    obtain ⟨qMonic, _⟩ := mapped
    have qm := qMonic
    obtain ⟨qIn, _⟩ := qm
    have qNonzero := PolyMonic.ne_zero at Algebra.ring(E), polyMap(Algebra.base(E),
      Algebra.ring(E), Algebra.map(E))(minpoly(E, y)) with ringL, polysL, qIn, distinctL,
      qMonic
    have rootsFinite := polyRootSet.finite at Algebra.ring(E), polyMap(Algebra.base(E),
      Algebra.ring(E), Algebra.map(E))(minpoly(E, y)) with domainL, polysL, qIn, qNonzero
    have inRoots : polyAlgebraRootSet(E, minpoly(E, y)) ⊆ polyRootSet(Algebra.ring(E),
        polyMap(Algebra.base(E), Algebra.ring(E), Algebra.map(E))(minpoly(E, y)))
      intros a aIn
      obtain ⟨aL, aRoot⟩ := polyAlgebraRootSet.membership.forward with aIn
      have aL2 := aL
      unfold algebraCarrier at aL2
      have e := polyEval2.eq_eval_map at Algebra.base(E), Algebra.ring(E), Algebra.map(E),
        a, minpoly(E, y) with comm, polys, ringL, mapL, aL2, mP
      unfold polyAeval at aRoot
      rw aRoot at e
      apply polyRootSet.membership.backward
      refine ⟨aL2, ?_⟩
      symm
      exact e
    have finR := Finite.subset with rootsFinite, inRoots
    have rBound : polyAlgebraRootSet(E, minpoly(E, y)) ⊆ algebraCarrier(E)
      intros a aIn
      obtain ⟨aL, _⟩ := polyAlgebraRootSet.membership.forward with aIn
      exact aL
    have closed : ∀ a ∈ polyAlgebraRootSet(E, minpoly(E, y)),
        f(a) ∈ polyAlgebraRootSet(E, minpoly(E, y))
      intros a aIn
      obtain ⟨aL, aRoot⟩ := polyAlgebraRootSet.membership.forward with aIn
      have applied := polyAeval.algebra_hom_apply at E, E, f, a, minpoly(E, y) with
        algebra, hom, aL, mP
      rw aRoot at applied
      rw (RingHom.map_zero with ringHom) at applied
      have faL := FunctionBetween.apply_closed with fF, aL
      apply polyAlgebraRootSet.membership.backward
      refine ⟨faL, ?_⟩
      symm
      exact applied
    have rF := restrict.function with fF, rBound, closed
    have injR : InjectiveBetween(restrict(f, polyAlgebraRootSet(E, minpoly(E, y))),
        polyAlgebraRootSet(E, minpoly(E, y)), polyAlgebraRootSet(E, minpoly(E, y)))
      apply Injective.of_pointwise with rF
      intros a aIn b bIn same
      rw [(restrict.apply with fF, rBound, closed, aIn),
        (restrict.apply with fF, rBound, closed, bIn)] at same
      have aL := rBound with a, aIn
      have bL := rBound with b, bIn
      have fbL := FunctionBetween.apply_closed with fF, bL
      have relA := FunctionBetween.relates_apply with fF, aL
      have relB := FunctionBetween.relates_apply with fF, bL
      rw same at relA
      exact Injective.cancel with injective2, aL, bL, fbL, relA, relB
    have surjR := Finite.surjective_of_injective with injR, finR, rfl
    obtain ⟨_, ontoR⟩ := surjR
    have yR : y ∈ polyAlgebraRootSet(E, minpoly(E, y))
      apply polyAlgebraRootSet.membership.backward
      exact ⟨yL, mRoot⟩
    obtain ⟨x, xR, rel⟩ := ontoR with y, yR
    have both := (restrict.relates at f, polyAlgebraRootSet(E, minpoly(E, y)), x, y).forward
      with rel
    obtain ⟨_, relF⟩ := both
    exact ⟨x, (rBound with x, xR), relF⟩
  have surjective : SurjectiveBetween(f, algebraCarrier(E), algebraCarrier(E))
    unfold SurjectiveBetween
    exact ⟨fF, onto⟩
  have iso : f : E ≃ₐ E
    unfold AlgebraIso
    unfold BijectiveBetween
    exact ⟨hom, injective2, surjective⟩
  exact (tkJ.aut_member at E, f).backward with iso

-- AlgEquiv.ext: automorphisms agreeing pointwise are equal.
theorem galoisGroup.ext (σ τ : Set)
  requires first : σ ∈ algebraAutomorphisms(E)
  requires second : τ ∈ algebraAutomorphisms(E)
  requires agree : ∀ x ∈ algebraCarrier(E), σ(x) = τ(x)
  shows σ = τ
proof
  have fσ := tkJ.aut_function with first
  have fτ := tkJ.aut_function with second
  exact FunctionBetween.ext with fσ, fτ, agree

end Extensions

-- The intermediate fields as members of intermediateFields(E), and the
-- subring and coefficient parts of an intermediate field.
theorem tkJ.intermediate_member (E F : Set)
  shows F ∈ intermediateFields(E) ↔ IntermediateField(E, F)
proof
  constructor
  . intro h
    obtain ⟨_, i⟩ := intermediateFields.membership.forward with h
    exact i
  . intro i
    have i2 := i
    obtain ⟨_, sub, _⟩ := i2
    obtain ⟨_, subalg⟩ := sub
    obtain ⟨subring, _⟩ := subalg
    have bounded := IsSubring.subset_carrier with subring
    have pw := (powerset.membership_iff at F, algebraCarrier(E)).backward with bounded
    exact intermediateFields.membership.backward with ⟨pw, i⟩

theorem tkJ.intermediate_subring (E F : Set)
  requires intermediate : IntermediateField(E, F)
  shows IsSubring(algebraCarrier(E), Ring.add(Algebra.ring(E)),
    Ring.zero(Algebra.ring(E)), Ring.neg(Algebra.ring(E)),
    Ring.mul(Algebra.ring(E)), Ring.one(Algebra.ring(E)), F)
proof
  obtain ⟨_, sub, _⟩ := intermediate
  obtain ⟨_, subalg⟩ := sub
  obtain ⟨subring, _⟩ := subalg
  exact subring

theorem tkJ.intermediate_bounded (E F : Set)
  requires intermediate : IntermediateField(E, F)
  shows F ⊆ algebraCarrier(E)
proof
  have subring := tkJ.intermediate_subring with intermediate
  exact IsSubring.subset_carrier with subring

-- An inverse in L of a nonzero element of F lies in F.
theorem tkJ.intermediate_inverse_mem (E F x y : Set)
  requires intermediate : IntermediateField(E, F)
  requires member : x ∈ F
  requires nonzero : x ≠ Ring.zero(Algebra.ring(E))
  requires point : y ∈ algebraCarrier(E)
  requires product : call2(Ring.mul(Algebra.ring(E)), x, y) = Ring.one(Algebra.ring(E))
  shows y ∈ F
proof
  have i2 := intermediate
  obtain ⟨extension, sub, inverses⟩ := i2
  obtain ⟨algebra, baseField, ringField⟩ := extension
  have comm := Algebra.comm_ring with algebra
  have bounded := tkJ.intermediate_bounded with intermediate
  obtain ⟨z, zIn, zProduct⟩ := inverses with x, member, nonzero
  have xL := bounded with x, member
  have zL := bounded with z, zIn
  unfold algebraCarrier at xL
  unfold algebraCarrier at zL
  unfold algebraCarrier at point
  have same := tkJ.inverse_unique with comm, xL, point, zL, product, zProduct
  rw same
  exact zIn

-- Membership in K(S): an element of L lying in every intermediate field
-- that contains S.
theorem tkJ.adjoin_in (E S x F : Set)
  requires member : x ∈ fieldAdjoin(E, S)
  requires intermediate : IntermediateField(E, F)
  requires contains : S ⊆ F
  shows x ∈ F
proof
  obtain ⟨xL, all⟩ := fieldAdjoin.membership.forward with member
  have Fmem := (tkJ.intermediate_member at E, F).backward with intermediate
  exact all with F, Fmem, contains

theorem tkJ.adjoin_intro (E S x : Set)
  requires point : x ∈ algebraCarrier(E)
  requires all : ∀ F, IntermediateField(E, F) → S ⊆ F → x ∈ F
  shows x ∈ fieldAdjoin(E, S)
proof
  apply fieldAdjoin.membership.backward
  refine ⟨point, ?_⟩
  intros F Fmem sF
  have inter := (tkJ.intermediate_member at E, F).forward with Fmem
  exact all with F, inter, sF

theorem tkJ.adjoin_bounded (E S : Set)
  shows fieldAdjoin(E, S) ⊆ algebraCarrier(E)
proof
  intros x xIn
  obtain ⟨xL, _⟩ := fieldAdjoin.membership.forward with xIn
  exact xL

-- An intermediate field is a field under the restricted operations, and
-- the extensions F/K and L/F are algebras.
theorem tkJ.intermediate_field (E F : Set)
  requires intermediate : IntermediateField(E, F)
  shows Field(subringRing(Algebra.ring(E), F))
proof
  have i2 := intermediate
  obtain ⟨extension, sub, inverses⟩ := i2
  obtain ⟨algebra, baseField, ringField⟩ := extension
  have comm := Algebra.comm_ring with algebra
  have subring := tkJ.intermediate_subring with intermediate
  unfold algebraCarrier at subring
  have ringParts := CommRing.parts with comm
  have commSub := IsSubring.comm_ring with ringParts, subring
  have fieldParts := Field.parts with ringField
  have nontrivialL := IsField.nontrivial with fieldParts
  obtain ⟨zL, oL, distinct⟩ := nontrivialL
  have zF := IsSubring.zero_closed with subring
  have oF := IsSubring.one_closed with subring
  have bounded := IsSubring.subset_carrier with subring
  have magma : IsMagma(Ring.carrier(Algebra.ring(E)), Ring.mul(Algebra.ring(E))) by
    simp [IsCommRing, IsRing, IsMonoid, IsSemigroup]
  have isField : IsField(F, restrict(Ring.add(Algebra.ring(E)), F × F),
      Ring.zero(Algebra.ring(E)), restrict(Ring.neg(Algebra.ring(E)), F),
      restrict(Ring.mul(Algebra.ring(E)), F × F), Ring.one(Algebra.ring(E)))
    unfold IsField
    refine ⟨commSub, ⟨zF, oF, distinct⟩, ?_⟩
    intros x xF nonzero
    obtain ⟨y, yF, product⟩ := inverses with x, xF, nonzero
    have xL := bounded with x, xF
    have yL := bounded with y, yF
    have swap : y * x = x * y by ring
    refine ⟨y, ?_⟩
    unfold IsInverse
    refine ⟨xF, yF, _, _⟩
    . rw (restrictBinary.value_on_subset with magma, bounded, yF, xF)
      rw swap
      exact product
    . rw (restrictBinary.value_on_subset with magma, bounded, xF, yF)
      exact product
  unfold subringRing
  exact Field.of_parts with isField

theorem tkJ.subextension_algebra (E F : Set)
  requires intermediate : IntermediateField(E, F)
  shows Algebra(subextension(E, F))
proof
  have i2 := intermediate
  obtain ⟨extension, sub, inverses⟩ := i2
  obtain ⟨algebra, subA⟩ := sub
  have ext2 := extension
  obtain ⟨_, baseField, ringField⟩ := ext2
  have baseB := Algebra.base_comm_ring at E with algebra
  have ringB := Algebra.comm_ring at E with algebra
  have subring := tkJ.intermediate_subring with intermediate
  unfold algebraCarrier at subring
  have bundled := Subring.of_projections with subring
  have commC := subringRing.comm_ring at Algebra.ring(E), F with ringB, bundled
  have bp := CommRing.parts with baseB
  have ap0 := CommRing.parts with ringB
  have ap : IsCommRing(algebraCarrier(E), Ring.add(Algebra.ring(E)),
      Ring.zero(Algebra.ring(E)), Ring.neg(Algebra.ring(E)),
      Ring.mul(Algebra.ring(E)), Ring.one(Algebra.ring(E)))
    unfold algebraCarrier
    exact ap0
  have sh := Algebra.structure_hom at E with algebra
  have hp0 := RingHom.parts with sh
  have hp : IsRingHom(Algebra.map(E), Ring.carrier(Algebra.base(E)),
      Ring.add(Algebra.base(E)), Ring.zero(Algebra.base(E)),
      Ring.neg(Algebra.base(E)), Ring.mul(Algebra.base(E)),
      Ring.one(Algebra.base(E)), algebraCarrier(E), Ring.add(Algebra.ring(E)),
      Ring.zero(Algebra.ring(E)), Ring.neg(Algebra.ring(E)),
      Ring.mul(Algebra.ring(E)), Ring.one(Algebra.ring(E)))
    unfold algebraCarrier
    exact hp0
  have rh := intHelp.restricted_hom at Ring.carrier(Algebra.base(E)),
    Ring.add(Algebra.base(E)), Ring.zero(Algebra.base(E)),
    Ring.neg(Algebra.base(E)), Ring.mul(Algebra.base(E)),
    Ring.one(Algebra.base(E)), algebraCarrier(E), Ring.add(Algebra.ring(E)),
    Ring.zero(Algebra.ring(E)), Ring.neg(Algebra.ring(E)),
    Ring.mul(Algebra.ring(E)), Ring.one(Algebra.ring(E)), Algebra.map(E), F
    with bp, ap, hp, subA
  have rh2 : IsRingHom(Algebra.map(E), Ring.carrier(Algebra.base(E)),
      Ring.add(Algebra.base(E)), Ring.zero(Algebra.base(E)),
      Ring.neg(Algebra.base(E)), Ring.mul(Algebra.base(E)),
      Ring.one(Algebra.base(E)), Ring.carrier(subringRing(Algebra.ring(E), F)),
      Ring.add(subringRing(Algebra.ring(E), F)),
      Ring.zero(subringRing(Algebra.ring(E), F)),
      Ring.neg(subringRing(Algebra.ring(E), F)),
      Ring.mul(subringRing(Algebra.ring(E), F)),
      Ring.one(subringRing(Algebra.ring(E), F)))
    unfold subringRing
    ring_projections
  have mapC := RingHom.of_projections with (CommRing.to_ring with baseB),
    (CommRing.to_ring with commC), rh2
  unfold subextension
  exact Algebra.intro at Algebra.base(E), subringRing(Algebra.ring(E), F),
    Algebra.map(E) with baseB, commC, mapC

theorem tkJ.overExtension_algebra (E F : Set)
  requires intermediate : IntermediateField(E, F)
  shows Algebra(overExtension(E, F))
proof
  have i2 := intermediate
  obtain ⟨extension, sub, inverses⟩ := i2
  obtain ⟨algebra, subA⟩ := sub
  have ringB := Algebra.comm_ring at E with algebra
  have subring := tkJ.intermediate_subring with intermediate
  unfold algebraCarrier at subring
  have bundled := Subring.of_projections with subring
  have commC := subringRing.comm_ring at Algebra.ring(E), F with ringB, bundled
  have incl := Subring.inclusion at Algebra.ring(E), F with ringB, bundled
  unfold overExtension
  exact Algebra.intro at subringRing(Algebra.ring(E), F), Algebra.ring(E),
    identity(F) with commC, ringB, incl

-- The projections of F/K and L/F.
theorem tkJ.over_ring (E F : Set)
  shows Algebra.ring(overExtension(E, F)) = Algebra.ring(E)
proof
  simp [overExtension, Algebra.mk.ring]

theorem tkJ.over_base (E F : Set)
  shows Algebra.base(overExtension(E, F)) = subringRing(Algebra.ring(E), F)
proof
  simp [overExtension, Algebra.mk.base]

theorem tkJ.over_map (E F : Set)
  shows Algebra.map(overExtension(E, F)) = identity(F)
proof
  simp [overExtension, Algebra.mk.map]

theorem tkJ.over_carrier (E F : Set)
  shows algebraCarrier(overExtension(E, F)) = algebraCarrier(E)
proof
  unfold algebraCarrier
  rw tkJ.over_ring

theorem tkJ.sub_ring (E F : Set)
  shows Algebra.ring(subextension(E, F)) = subringRing(Algebra.ring(E), F)
proof
  simp [subextension, Algebra.mk.ring]

theorem tkJ.sub_base (E F : Set)
  shows Algebra.base(subextension(E, F)) = Algebra.base(E)
proof
  simp [subextension, Algebra.mk.base]

theorem tkJ.sub_map (E F : Set)
  shows Algebra.map(subextension(E, F)) = Algebra.map(E)
proof
  simp [subextension, Algebra.mk.map]

theorem tkJ.sub_carrier (E F : Set)
  shows algebraCarrier(subextension(E, F)) = F
proof
  unfold algebraCarrier
  rw [tkJ.sub_ring, subringRing.carrierOf]

-- A product of polynomials none of which vanishes at y along f does not
-- vanish at y, when the target is a domain.
theorem tkJ.gal_prod_eval2_ne (R S f y : Set) (n : Nat)
  requires comm : CommRing(R)
  requires domain : IntegralDomain(S)
  requires hom : f : R →+* S
  requires point : y ∈ Ring.carrier(S)
  shows ∀ w, (w : n → Ring.carrier(polynomialRing(R, {0}))) →
    (∀ i ∈ n, polyEval2(R, S, f, y, w(i)) ≠ Ring.zero(S)) →
    polyEval2(R, S, f, y, finiteRingProduct(n, Ring.carrier(polynomialRing(R, {0})),
      Ring.add(polynomialRing(R, {0})), Ring.zero(polynomialRing(R, {0})),
      Ring.neg(polynomialRing(R, {0})), Ring.mul(polynomialRing(R, {0})),
      Ring.one(polynomialRing(R, {0})), w)) ≠ Ring.zero(S)
proof
  have polys := polynomialRing.comm_ring at R, {0} with comm
  have d0 := domain
  obtain ⟨commS, nontrivialS, noZero⟩ := d0
  have evalHom := polyEval2.hom at R, S, f, y with comm, polys, commS, hom, point
  have parts := CommRing.parts with polys
  induction n
  | zero =>
    intros w wf vals
    have fin := Finite.natural at 0
    have values : ∀ x ∈ 0, w(x) = Ring.one(polynomialRing(R, {0}))
      intros x hx
      exfalso
      have xNat := natural.member at 0 with hx
      have lt := Less.of_membership at x, 0
      have l := lt with hx
      arith
    have e := finiteRingProduct.one at 0, Ring.carrier(polynomialRing(R, {0})),
      Ring.add(polynomialRing(R, {0})), Ring.zero(polynomialRing(R, {0})),
      Ring.neg(polynomialRing(R, {0})), Ring.mul(polynomialRing(R, {0})),
      Ring.one(polynomialRing(R, {0})), w with parts, fin, wf, values
    rw e
    unfold polyEval2
    rw (RingHom.map_one with evalHom)
    intro z
    symm at z
    exact nontrivialS with z
  | succ(m) using ih =>
    intros w wf vals
    have sub : m ⊆ succ(m)
      intros x hx
      exact membership.into_successor at x, m with hx
    have rf := restrict.domain_function at w, succ(m), Ring.carrier(polynomialRing(R, {0})),
      m with wf, sub
    have rvals : ∀ i ∈ m, polyEval2(R, S, f, y, restrict(w, m)(i)) ≠ Ring.zero(S)
      intros i hi
      rw (restrict.domain_apply at w, succ(m), Ring.carrier(polynomialRing(R, {0})), m, i
        with wf, sub, hi)
      exact vals with i, (sub with i, hi)
    have r := ih with restrict(w, m), rf, rvals
    rw (uni.prod_succ at R, w, m with comm, polys, wf)
    have mIn := membership.self_successor at m
    have wm := vals with m, mIn
    have wIn := FunctionBetween.apply_closed with wf, mIn
    have fin := Finite.natural at m
    have pIn := finiteRingProduct.closed at m, Ring.carrier(polynomialRing(R, {0})),
      Ring.add(polynomialRing(R, {0})), Ring.zero(polynomialRing(R, {0})),
      Ring.neg(polynomialRing(R, {0})), Ring.mul(polynomialRing(R, {0})),
      Ring.one(polynomialRing(R, {0})), restrict(w, m) with parts, fin, rf
    unfold polyEval2 at r
    unfold polyEval2 at wm
    unfold polyEval2
    rw (RingHom.map_mul with evalHom, pIn, wIn)
    have e1 := RingHom.map_mem with evalHom, pIn
    have e2 := RingHom.map_mem with evalHom, wIn
    intro z
    have alt := noZero with evaluationHom(R, S, {0}, f, constantFunction({0},
      Ring.carrier(S), y))(finiteRingProduct(m, Ring.carrier(polynomialRing(R, {0})),
      Ring.add(polynomialRing(R, {0})), Ring.zero(polynomialRing(R, {0})),
      Ring.neg(polynomialRing(R, {0})), Ring.mul(polynomialRing(R, {0})),
      Ring.one(polynomialRing(R, {0})), restrict(w, m))), e1,
      evaluationHom(R, S, {0}, f, constantFunction({0}, Ring.carrier(S), y))(w(m)), e2, z
    cases alt with x | x
    . exact r with x
    . exact wm with x

-- The elements adjoined by finite subsets of S.
def tkJFiniteAdjoins (E S : Set) : Set :=
  { y ∈ algebraCarrier(E) | ∃ T, T ⊆ S ∧ Finite(T) ∧ y ∈ fieldAdjoin(E, T) }

-- Section: Intermediate fields
section Intermediate
variable (E : Set)
hypothesis extension : FieldExtension(E)

theorem IntermediateField.bottom
  shows IntermediateField(E, bottomField(E))
proof
  have ext2 := extension
  obtain ⟨algebra, baseField, ringField⟩ := ext2
  have baseComm := Algebra.base_comm_ring with algebra
  have ringComm := Algebra.comm_ring with algebra
  have structureMap := Algebra.structure_hom with algebra
  have function := Algebra.map_function with algebra
  have bp := CommRing.parts with baseComm
  have ap := CommRing.parts with ringComm
  have hp := RingHom.parts with structureMap
  have subring := IsRingHom.image_subring with bp, ap, hp
  have reflexive := Subset.reflexive at bottomField(E)
  unfold IntermediateField
  refine ⟨extension, ?_, ?_⟩
  . unfold SubalgebraOf
    refine ⟨algebra, ?_⟩
    unfold Subalgebra
    unfold bottomField
    unfold algebraCarrier
    unfold bottomField at reflexive
    unfold algebraCarrier at reflexive
    exact ⟨subring, reflexive⟩
  . intros x xIn nonzero
    unfold bottomField at xIn
    obtain ⟨xL, a, aIn, xEq⟩ := functionImage.membership.forward with xIn
    have aNonzero : a ≠ Ring.zero(Algebra.base(E))
      intro aZero
      have mapZero := RingHom.map_zero with structureMap
      rw aZero at xEq
      rw mapZero at xEq
      exact nonzero with xEq
    obtain ⟨b, bIn, product⟩ := tkJ.field_inverse with baseField, aIn, aNonzero
    have image := functionImage.value with function, bIn
    have mapMul := RingHom.map_mul at Algebra.map(E), Algebra.base(E),
      Algebra.ring(E), a, b with structureMap, aIn, bIn
    have mapOne := RingHom.map_one with structureMap
    refine ⟨Algebra.map(E)(b), ?_, ?_⟩
    . unfold bottomField
      exact image
    . rw [xEq, ← mapMul, product, mapOne]

theorem IntermediateField.top
  shows IntermediateField(E, algebraCarrier(E))
proof
  have ext2 := extension
  obtain ⟨algebra, baseField, ringField⟩ := ext2
  have ringComm := Algebra.comm_ring with algebra
  have ring := CommRing.to_ring with ringComm
  have whole := Subring.whole with ring
  have parts := Subring.parts with whole
  have image := functionImage.subset at Algebra.map(E),
    Ring.carrier(Algebra.base(E)), algebraCarrier(E)
  unfold IntermediateField
  refine ⟨extension, ?_, ?_⟩
  . unfold SubalgebraOf
    refine ⟨algebra, ?_⟩
    unfold Subalgebra
    unfold algebraCarrier
    unfold algebraCarrier at image
    exact ⟨parts, image⟩
  . intros x xIn nonzero
    unfold algebraCarrier at xIn
    unfold algebraCarrier
    exact tkJ.field_inverse with ringField, xIn, nonzero

-- IntermediateField.algebraMap_mem: K ⊆ F.
theorem IntermediateField.bottom_subset (F : Set)
  requires intermediate : IntermediateField(E, F)
  shows bottomField(E) ⊆ F
proof
  obtain ⟨ext2, subalgebra, inverses⟩ := intermediate
  obtain ⟨algebra, sub⟩ := subalgebra
  obtain ⟨subring, image⟩ := sub
  unfold bottomField
  exact image

-- F/K and L/F are field extensions, and the tower law
-- [F : K] [L : F] = [L : K] (Module.finrank_mul_finrank).
theorem IntermediateField.subextension_field (F : Set)
  requires intermediate : IntermediateField(E, F)
  shows FieldExtension(subextension(E, F)) ∧ FieldExtension(overExtension(E, F))
proof
  have ext2 := extension
  obtain ⟨algebra, baseField, ringField⟩ := ext2
  have subField := tkJ.intermediate_field with intermediate
  have subAlg := tkJ.subextension_algebra with intermediate
  have overAlg := tkJ.overExtension_algebra with intermediate
  constructor
  . unfold FieldExtension
    refine ⟨subAlg, ?_, ?_⟩
    . unfold subextension
      rw Algebra.mk.base
      exact baseField
    . unfold subextension
      rw Algebra.mk.ring
      exact subField
  . unfold FieldExtension
    refine ⟨overAlg, ?_, ?_⟩
    . unfold overExtension
      rw Algebra.mk.base
      exact subField
    . unfold overExtension
      rw Algebra.mk.ring
      exact ringField

-- Helpers for the tower law: F is a K-subspace of L, and the K-module
-- F/K is that submodule of L/K.
theorem tkJ.alg_module_zero (A : Set)
  shows Module.zero(algebraModule(A)) = Ring.zero(Algebra.ring(A))
proof
  unfold algebraModule
  module_projections

theorem tkJ.alg_module_neg (A : Set)
  shows Module.neg(algebraModule(A)) = Ring.neg(Algebra.ring(A))
proof
  unfold algebraModule
  module_projections

theorem tkJ.tower_submodule (F : Set)
  requires intermediate : IntermediateField(E, F)
  shows SubmoduleOf(F, algebraModule(E), Algebra.base(E))
proof
  have ext2 := extension
  obtain ⟨algebra, _, _⟩ := ext2
  have module := algebraModule.module_of with algebra
  have subring := tkJ.intermediate_subring with intermediate
  have bounded := IsSubring.subset_carrier with subring
  have bottom := IntermediateField.bottom_subset with extension, intermediate
  have mapF := Algebra.map_function with algebra
  have carrierEq := algebraModule.carrier_eq at E
  unfold SubmoduleOf
  refine ⟨module, ?_, ?_, ?_, ?_⟩
  . rw carrierEq
    exact bounded
  . rw tkJ.alg_module_zero
    exact IsSubring.zero_closed with subring
  . intros v vF w wF
    rw algebraModule.add_eq
    have addF := IsSubring.add_closed with subring
    exact addF with v, vF, w, wF
  . intros r rK v vF
    have vL := bounded with v, vF
    rw (algebraModule.smul_value with algebra, rK, vL)
    have mapIn : Algebra.map(E)(r) ∈ bottomField(E)
      unfold bottomField
      exact functionImage.value with mapF, rK
    have mF := bottom with Algebra.map(E)(r), mapIn
    have mulF := IsSubring.mul_closed with subring
    exact mulF with Algebra.map(E)(r), mF, v, vF

theorem tkJ.tower_sub_module (F : Set)
  requires intermediate : IntermediateField(E, F)
  shows algebraModule(subextension(E, F)) =
    submoduleModule(algebraModule(E), Algebra.base(E), F)
proof
  have ext2 := extension
  obtain ⟨algebra, _, _⟩ := ext2
  have comm := Algebra.comm_ring with algebra
  have ringParts := CommRing.parts with comm
  have subring := tkJ.intermediate_subring with intermediate
  have bounded := IsSubring.subset_carrier with subring
  have bottom := IntermediateField.bottom_subset with extension, intermediate
  have mapF := Algebra.map_function with algebra
  have magma : IsMagma(Ring.carrier(Algebra.ring(E)), Ring.mul(Algebra.ring(E))) by
    simp [IsCommRing, IsRing, IsMonoid, IsSemigroup]
  have boundedR : F ⊆ Ring.carrier(Algebra.ring(E))
    unfold algebraCarrier at bounded
    exact bounded
  have mapInF : ∀ r ∈ Ring.carrier(Algebra.base(E)), Algebra.map(E)(r) ∈ F
    intros r rK
    have mapIn : Algebra.map(E)(r) ∈ bottomField(E)
      unfold bottomField
      exact functionImage.value with mapF, rK
    exact bottom with Algebra.map(E)(r), mapIn
  have mulF := IsSubring.mul_closed with subring
  have actionEq : algebraAction(subextension(E, F)) =
      restrict(algebraAction(E), Ring.carrier(Algebra.base(E)) × F)
    ext p
    constructor
    . intro hp
      obtain ⟨_, r, rK, a, aF, shape⟩ := algebraAction.membership.forward with hp
      rw [tkJ.sub_base] at rK
      rw [tkJ.sub_carrier] at aF
      rw [tkJ.sub_ring, tkJ.sub_map] at shape
      have mr := mapInF with r, rK
      have aL := bounded with a, aF
      unfold subringRing at shape
      rw Ring.mk.mul at shape
      rw (restrictBinary.value_on_subset with magma, boundedR, mr, aF) at shape
      have valueF := mulF with Algebra.map(E)(r), mr, a, aF
      have valueL := bounded with call2(Ring.mul(Algebra.ring(E)), Algebra.map(E)(r), a), valueF
      have pairL := product.pair at r, a, Ring.carrier(Algebra.base(E)), algebraCarrier(E) with rK, aL
      have pairF := product.pair at r, a, Ring.carrier(Algebra.base(E)), F with rK, aF
      have outer := product.pair at (r, a), call2(Ring.mul(Algebra.ring(E)), Algebra.map(E)(r), a), Ring.carrier(Algebra.base(E)) × algebraCarrier(E), algebraCarrier(E) with pairL, valueL
      have inE : p ∈ algebraAction(E)
        apply algebraAction.membership.backward
        refine ⟨?_, r, rK, a, aL, shape⟩
        rw shape
        exact outer
      apply restrict.membership.backward
      exact ⟨inE, (r, a), pairF, call2(Ring.mul(Algebra.ring(E)), Algebra.map(E)(r), a), shape⟩
    . intro hp
      obtain ⟨inE, x, xIn, y, shapeXY⟩ := restrict.membership.forward with hp
      obtain ⟨_, r, rK, a, aL, shape⟩ := algebraAction.membership.forward with inE
      rw shape at shapeXY
      obtain ⟨xEq, _⟩ := orderedPair.injective with shapeXY
      rw ← xEq at xIn
      obtain ⟨rK2, aF⟩ := (product.pair_membership at r, a, Ring.carrier(Algebra.base(E)), F).forward with xIn
      have mr := mapInF with r, rK
      have valueF := mulF with Algebra.map(E)(r), mr, a, aF
      have pairF := product.pair at r, a, Ring.carrier(Algebra.base(E)), F with rK, aF
      have outer := product.pair at (r, a), call2(Ring.mul(Algebra.ring(E)), Algebra.map(E)(r), a), Ring.carrier(Algebra.base(E)) × F, F with pairF, valueF
      apply algebraAction.membership.backward
      have sameValue : call2(Ring.mul(Algebra.ring(subextension(E, F))),
          Algebra.map(subextension(E, F))(r), a) =
          call2(Ring.mul(Algebra.ring(E)), Algebra.map(E)(r), a)
        rw [tkJ.sub_ring, tkJ.sub_map]
        unfold subringRing
        rw Ring.mk.mul
        exact restrictBinary.value_on_subset with magma, boundedR, mr, aF
      refine ⟨?_, r, ?_, a, ?_, ?_⟩
      . rw [tkJ.sub_base, tkJ.sub_carrier, shape]
        exact outer
      . rw tkJ.sub_base
        exact rK
      . rw tkJ.sub_carrier
        exact aF
      . rw sameValue
        exact shape
  unfold submoduleModule
  rw [algebraModule.add_eq, tkJ.alg_module_zero, tkJ.alg_module_neg,
    algebraModule.smul_eq]
  rw ← actionEq
  unfold algebraModule
  rw [tkJ.sub_carrier, tkJ.sub_ring]
  unfold subringRing
  rw [Ring.mk.add, Ring.mk.zero, Ring.mk.neg]

-- The action and the finite sums of L/F are those of L/K: F acts by
-- multiplication, and the additive structure is that of L.
theorem tkJ.over_module_smul (F f x : Set)
  requires intermediate : IntermediateField(E, F)
  requires coefficient : f ∈ F
  requires point : x ∈ algebraCarrier(E)
  shows call2(Module.smul(algebraModule(overExtension(E, F))), f, x) =
    call2(Ring.mul(Algebra.ring(E)), f, x)
proof
  have overAlg := tkJ.overExtension_algebra with intermediate
  have fB : f ∈ Ring.carrier(Algebra.base(overExtension(E, F)))
    rw [tkJ.over_base, subringRing.carrierOf]
    exact coefficient
  have xB : x ∈ algebraCarrier(overExtension(E, F))
    rw tkJ.over_carrier
    exact point
  rw (algebraModule.smul_value with overAlg, fB, xB)
  rw [tkJ.over_ring, tkJ.over_map, (identity.apply at f, F with coefficient)]

theorem tkJ.over_module_sum (F J w : Set)
  requires intermediate : IntermediateField(E, F)
  requires finite : Finite(J)
  requires values : w : J → algebraCarrier(E)
  shows moduleSum(algebraModule(overExtension(E, F)), J, w) =
    moduleSum(algebraModule(E), J, w)
proof
  have ext2 := extension
  obtain ⟨algebra, _, _⟩ := ext2
  have overAlg := tkJ.overExtension_algebra with intermediate
  have moduleV := algebraModule.module_of with algebra
  have moduleB := algebraModule.module_of with overAlg
  have commK := Algebra.base_comm_ring with algebra
  have ringK := CommRing.to_ring with commK
  have commF := Algebra.base_comm_ring with overAlg
  have ringF := CommRing.to_ring with commF
  obtain ⟨n, natural, e, enumeration⟩ := Finite.bijective_enumeration at
    Algebra.base(E), algebraModule(E), J with ringK, moduleV, finite
  have valuesV : w : J → Module.carrier(algebraModule(E))
    rw algebraModule.carrier_eq
    exact values
  have valuesB : w : J → Module.carrier(algebraModule(overExtension(E, F)))
    rw [algebraModule.carrier_eq, tkJ.over_carrier]
    exact values
  have sV := moduleSum.enumeration at Algebra.base(E), algebraModule(E), J, w, e, n with
    ringK, moduleV, valuesV, enumeration
  have sB := moduleSum.enumeration at Algebra.base(overExtension(E, F)),
    algebraModule(overExtension(E, F)), J, w, e, n with ringF, moduleB, valuesB, enumeration
  rw [sV, sB]
  rw [algebraModule.add_eq, algebraModule.add_eq, tkJ.alg_module_zero, tkJ.alg_module_zero,
    tkJ.over_ring]

-- Right multiplication x ↦ x y on L is K-linear.
defgraph tkJRightMul (y : Set) (x ∈ algebraCarrier(E)) : algebraCarrier(E) :=
    call2(Ring.mul(Algebra.ring(E)), x, y)
requires point : y ∈ algebraCarrier(E)
proof
  have ext2 := extension
  obtain ⟨algebra, _, _⟩ := ext2
  have comm := Algebra.comm_ring with algebra
  have ring := CommRing.to_ring with comm
  unfold algebraCarrier at point
  unfold algebraCarrier at member
  unfold algebraCarrier
  exact Ring.mul_mem at Algebra.ring(E), x, y with ring, member, point

theorem tkJ.right_mul_linear (y : Set)
  requires point : y ∈ algebraCarrier(E)
  shows LinearMap(tkJRightMul(E, y), algebraModule(E), Algebra.base(E), algebraModule(E))
proof
  have ext2 := extension
  obtain ⟨algebra, _, _⟩ := ext2
  have comm := Algebra.comm_ring with algebra
  have module := algebraModule.module_of with algebra
  have fun := tkJRightMul.function at E, y with extension, point
  have yR := point
  unfold algebraCarrier at yR
  apply LinearMap.of_laws with module, module
  . rw algebraModule.carrier_eq
    exact fun
  . rw algebraModule.carrier_eq
    intros v vL w wL
    have vR := vL
    unfold algebraCarrier at vR
    have wR := wL
    unfold algebraCarrier at wR
    have sumR : call2(Ring.add(Algebra.ring(E)), v, w) ∈ algebraCarrier(E)
      unfold algebraCarrier
      typecheck
    rw [algebraModule.add_eq, (tkJRightMul.value at E, y, v + w with extension, point, sumR),
      (tkJRightMul.value at E, y, v with extension, point, vL),
      (tkJRightMul.value at E, y, w with extension, point, wL)]
    ring
  . rw algebraModule.carrier_eq
    intros r rK v vL
    have vR := vL
    unfold algebraCarrier at vR
    have mr := Algebra.map_mem with algebra, rK
    have smulL : call2(Ring.mul(Algebra.ring(E)), Algebra.map(E)(r), v) ∈ algebraCarrier(E)
      unfold algebraCarrier
      typecheck
    rw [(algebraModule.smul_value with algebra, rK, vL),
      (tkJRightMul.value at E, y, call2(Ring.mul(Algebra.ring(E)), Algebra.map(E)(r), v) with
        extension, point, smulL),
      (tkJRightMul.value at E, y, v with extension, point, vL)]
    have prodL : call2(Ring.mul(Algebra.ring(E)), v, y) ∈ algebraCarrier(E)
      unfold algebraCarrier
      typecheck
    rw (algebraModule.smul_value with algebra, rK, prodL)
    ring

-- The products a(i) b(j) of a family of F and a family of L, and the
-- coefficients Σ_i d(j, i) a(i) ∈ F of a family d of scalars.
defgraph tkJTowerFamily (I J a b : Set) (k ∈ J × I) : algebraCarrier(E) :=
    call2(Ring.mul(Algebra.ring(E)), a(snd(k)), b(fst(k)))
requires aFam : a : I → algebraCarrier(E)
requires bFam : b : J → algebraCarrier(E)
proof
  have ext2 := extension
  obtain ⟨algebra, _, _⟩ := ext2
  have comm := Algebra.comm_ring with algebra
  have ring := CommRing.to_ring with comm
  obtain ⟨_, j, hj, i, hi, shape⟩ := product.membership.forward with member
  rw [shape, fst.pair, snd.pair]
  have ai := FunctionBetween.apply_closed with aFam, hi
  have bj := FunctionBetween.apply_closed with bFam, hj
  unfold algebraCarrier at ai
  unfold algebraCarrier at bj
  unfold algebraCarrier
  exact Ring.mul_mem at Algebra.ring(E), a(i), b(j) with ring, ai, bj

defgraph tkJTowerCoeffs (F I J a d : Set) (j ∈ J) : F :=
    moduleCombination(algebraModule(E), Algebra.base(E), I,
      familySlice(I, Ring.carrier(Algebra.base(E)), d, j), a)
requires intermediate : IntermediateField(E, F)
requires finiteI : Finite(I)
requires aFam : a : I → F
requires coefficients : d : J × I → Ring.carrier(Algebra.base(E))
proof
  have ext2 := extension
  obtain ⟨algebra, _, _⟩ := ext2
  have moduleV := algebraModule.module_of with algebra
  have commK := Algebra.base_comm_ring with algebra
  have ringK := CommRing.to_ring with commK
  have sub := tkJ.tower_submodule with extension, intermediate
  have slice : familySlice(I, Ring.carrier(Algebra.base(E)), d, j) : I →
      Ring.carrier(Algebra.base(E))
    apply familySlice.function
    intros i hi
    have pair := product.pair at j, i, J, I with member, hi
    exact FunctionBetween.apply_closed with coefficients, pair
  exact SubmoduleOf.combination_mem at Algebra.base(E), algebraModule(E), F, I,
    familySlice(I, Ring.carrier(Algebra.base(E)), d, j), a with ringK, moduleV, sub,
    finiteI, slice, aFam

-- Σ_{(j, i)} d(j, i) a(i) b(j) = Σ_j (Σ_i d(j, i) a(i)) b(j).
theorem tkJ.tower_combination (F I J a b d : Set)
  requires intermediate : IntermediateField(E, F)
  requires finiteI : Finite(I)
  requires finiteJ : Finite(J)
  requires first : a : I → F
  requires second : b : J → algebraCarrier(E)
  requires coefficients : d : J × I → Ring.carrier(Algebra.base(E))
  shows moduleCombination(algebraModule(E), Algebra.base(E), J × I, d,
      tkJTowerFamily(E, I, J, a, b)) =
    moduleCombination(algebraModule(overExtension(E, F)),
      Algebra.base(overExtension(E, F)), J, tkJTowerCoeffs(E, F, I, J, a, d), b)
proof
  have ext2 := extension
  obtain ⟨algebra, _, _⟩ := ext2
  have moduleV := algebraModule.module_of with algebra
  have commK := Algebra.base_comm_ring with algebra
  have ringK := CommRing.to_ring with commK
  have overAlg := tkJ.overExtension_algebra with intermediate
  have moduleB := algebraModule.module_of with overAlg
  have bounded := tkJ.intermediate_bounded with intermediate
  have carrierV := algebraModule.carrier_eq at E
  have aInL : ∀ i ∈ I, a(i) ∈ algebraCarrier(E)
    intros i hi
    have ai := FunctionBetween.apply_closed with first, hi
    exact bounded with a(i), ai
  have aL := FunctionBetween.codomain_of_values with first, aInL
  have aV : a : I → Module.carrier(algebraModule(E))
    rw carrierV
    exact aL
  have cL := tkJTowerFamily.function at E, I, J, a, b with extension, aL, second
  have cV : tkJTowerFamily(E, I, J, a, b) : J × I → Module.carrier(algebraModule(E))
    rw carrierV
    exact cL
  have fF := tkJTowerCoeffs.function at E, F, I, J, a, d with extension, intermediate,
    finiteI, first, coefficients
  have fB : tkJTowerCoeffs(E, F, I, J, a, d) : J →
      Ring.carrier(Algebra.base(overExtension(E, F)))
    rw [tkJ.over_base, subringRing.carrierOf]
    exact fF
  have bB : b : J → Module.carrier(algebraModule(overExtension(E, F)))
    rw [algebraModule.carrier_eq, tkJ.over_carrier]
    exact second
  have TV := combinationTerms.function at algebraModule(E), Algebra.base(E), J × I, d,
    tkJTowerFamily(E, I, J, a, b) with moduleV, coefficients, cV
  have SB := combinationTerms.function at algebraModule(overExtension(E, F)),
    Algebra.base(overExtension(E, F)), J, tkJTowerCoeffs(E, F, I, J, a, d), b with
    moduleB, fB, bB
  have SL : combinationTerms(algebraModule(overExtension(E, F)),
      Algebra.base(overExtension(E, F)), J, tkJTowerCoeffs(E, F, I, J, a, d), b) : J →
      algebraCarrier(E)
    rw [algebraModule.carrier_eq, tkJ.over_carrier] at SB
    exact SB
  have SV : combinationTerms(algebraModule(overExtension(E, F)),
      Algebra.base(overExtension(E, F)), J, tkJTowerCoeffs(E, F, I, J, a, d), b) : J →
      Module.carrier(algebraModule(E))
    rw carrierV
    exact SL
  unfold moduleCombination
  rw (tkJ.over_module_sum at E, F, J, combinationTerms(algebraModule(overExtension(E, F)),
    Algebra.base(overExtension(E, F)), J, tkJTowerCoeffs(E, F, I, J, a, d), b) with
    extension, intermediate, finiteJ, SL)
  obtain ⟨_, prod⟩ := moduleSum.product_of at Algebra.base(E), algebraModule(E), J, I with
    ringK, moduleV, finiteJ, finiteI
  rw (prod with combinationTerms(algebraModule(E), Algebra.base(E), J × I, d,
    tkJTowerFamily(E, I, J, a, b)), TV)
  have sliceF : ∀ j ∈ J, familySlice(I, Module.carrier(algebraModule(E)),
      combinationTerms(algebraModule(E), Algebra.base(E), J × I, d,
        tkJTowerFamily(E, I, J, a, b)), j) : I → Module.carrier(algebraModule(E))
    intros j hj
    apply familySlice.function
    intros i hi
    have pair := product.pair at j, i, J, I with hj, hi
    exact FunctionBetween.apply_closed with TV, pair
  have rowValues : ∀ j ∈ J, moduleSum(algebraModule(E), I, familySlice(I,
      Module.carrier(algebraModule(E)), combinationTerms(algebraModule(E), Algebra.base(E),
        J × I, d, tkJTowerFamily(E, I, J, a, b)), j)) ∈ Module.carrier(algebraModule(E))
    intros j hj
    have sj := sliceF with j, hj
    exact moduleSum.mem_of at Algebra.base(E), algebraModule(E), I, familySlice(I,
      Module.carrier(algebraModule(E)), combinationTerms(algebraModule(E), Algebra.base(E),
        J × I, d, tkJTowerFamily(E, I, J, a, b)), j) with ringK, moduleV, finiteI, sj
  have rowsF := familyRowSums.function at algebraModule(E), J, I,
    combinationTerms(algebraModule(E), Algebra.base(E), J × I, d,
      tkJTowerFamily(E, I, J, a, b)) with rowValues
  apply moduleSum.congr at Algebra.base(E), algebraModule(E), J,
    familyRowSums(algebraModule(E), J, I, combinationTerms(algebraModule(E),
      Algebra.base(E), J × I, d, tkJTowerFamily(E, I, J, a, b))),
    combinationTerms(algebraModule(overExtension(E, F)), Algebra.base(overExtension(E, F)),
      J, tkJTowerCoeffs(E, F, I, J, a, d), b) with ringK, moduleV, finiteJ, rowsF, SV
  intros j hj
  rw (familyRowSums.apply at algebraModule(E), J, I, combinationTerms(algebraModule(E),
    Algebra.base(E), J × I, d, tkJTowerFamily(E, I, J, a, b)), j with rowValues, hj)
  rw (combinationTerms.value at algebraModule(overExtension(E, F)),
    Algebra.base(overExtension(E, F)), J, tkJTowerCoeffs(E, F, I, J, a, d), b, j with
    moduleB, fB, bB, hj)
  have fjF := FunctionBetween.apply_closed with fF, hj
  have bjL := FunctionBetween.apply_closed with second, hj
  rw (tkJ.over_module_smul at E, F, tkJTowerCoeffs(E, F, I, J, a, d)(j), b(j) with
    extension, intermediate, fjF, bjL)
  rw (tkJTowerCoeffs.value at E, F, I, J, a, d, j with extension, intermediate, finiteI,
    first, coefficients, hj)
  have sdF : familySlice(I, Ring.carrier(Algebra.base(E)), d, j) : I →
      Ring.carrier(Algebra.base(E))
    apply familySlice.function
    intros i hi
    have pair := product.pair at j, i, J, I with hj, hi
    exact FunctionBetween.apply_closed with coefficients, pair
  have combV := moduleCombination.mem_of at Algebra.base(E), algebraModule(E), I,
    familySlice(I, Ring.carrier(Algebra.base(E)), d, j), a with ringK, moduleV, finiteI,
    sdF, aV
  have combL : moduleCombination(algebraModule(E), Algebra.base(E), I,
      familySlice(I, Ring.carrier(Algebra.base(E)), d, j), a) ∈ algebraCarrier(E)
    rw ← carrierV
    exact combV
  rw ← (tkJRightMul.value at E, b(j), moduleCombination(algebraModule(E), Algebra.base(E), I,
    familySlice(I, Ring.carrier(Algebra.base(E)), d, j), a) with extension, bjL, combL)
  have lin := tkJ.right_mul_linear at E, b(j) with extension, bjL
  rw (LinearMap.map_combination at Algebra.base(E), algebraModule(E), algebraModule(E),
    tkJRightMul(E, b(j)), I, familySlice(I, Ring.carrier(Algebra.base(E)), d, j), a with
    ringK, moduleV, moduleV, lin, finiteI, sdF, aV)
  have μL := tkJRightMul.function at E, b(j) with extension, bjL
  have μV : tkJRightMul(E, b(j)) : Module.carrier(algebraModule(E)) →
      Module.carrier(algebraModule(E))
    rw carrierV
    exact μL
  have composeF := compose.function at tkJRightMul(E, b(j)), a, I,
    Module.carrier(algebraModule(E)), Module.carrier(algebraModule(E)) with aV, μV
  have termsF := combinationTerms.function at algebraModule(E), Algebra.base(E), I,
    familySlice(I, Ring.carrier(Algebra.base(E)), d, j), compose(tkJRightMul(E, b(j)), a, I,
      Module.carrier(algebraModule(E)), Module.carrier(algebraModule(E))) with moduleV,
    sdF, composeF
  have sj := sliceF with j, hj
  have tValues : ∀ i ∈ I, combinationTerms(algebraModule(E), Algebra.base(E), J × I, d,
      tkJTowerFamily(E, I, J, a, b))((j, i)) ∈ Module.carrier(algebraModule(E))
    intros i hi
    have pair := product.pair at j, i, J, I with hj, hi
    exact FunctionBetween.apply_closed with TV, pair
  have dValues : ∀ i ∈ I, d((j, i)) ∈ Ring.carrier(Algebra.base(E))
    intros i hi
    have pair := product.pair at j, i, J, I with hj, hi
    exact FunctionBetween.apply_closed with coefficients, pair
  unfold moduleCombination
  apply moduleSum.congr at Algebra.base(E), algebraModule(E), I, familySlice(I,
    Module.carrier(algebraModule(E)), combinationTerms(algebraModule(E), Algebra.base(E),
      J × I, d, tkJTowerFamily(E, I, J, a, b)), j), combinationTerms(algebraModule(E),
    Algebra.base(E), I, familySlice(I, Ring.carrier(Algebra.base(E)), d, j),
    compose(tkJRightMul(E, b(j)), a, I, Module.carrier(algebraModule(E)),
      Module.carrier(algebraModule(E)))) with ringK, moduleV, finiteI, sj, termsF
  intros i hi
  have pair := product.pair at j, i, J, I with hj, hi
  have aiL := aInL with i, hi
  rw (familySlice.apply at I, Module.carrier(algebraModule(E)), combinationTerms(
    algebraModule(E), Algebra.base(E), J × I, d, tkJTowerFamily(E, I, J, a, b)), j, i with
    tValues, hi)
  rw (combinationTerms.value at algebraModule(E), Algebra.base(E), J × I, d,
    tkJTowerFamily(E, I, J, a, b), (j, i) with moduleV, coefficients, cV, pair)
  rw (combinationTerms.value at algebraModule(E), Algebra.base(E), I,
    familySlice(I, Ring.carrier(Algebra.base(E)), d, j), compose(tkJRightMul(E, b(j)), a, I,
      Module.carrier(algebraModule(E)), Module.carrier(algebraModule(E))), i with moduleV,
    sdF, composeF, hi)
  rw (familySlice.apply at I, Ring.carrier(Algebra.base(E)), d, j, i with dValues, hi)
  rw (compose.apply at tkJRightMul(E, b(j)), a, I, Module.carrier(algebraModule(E)),
    Module.carrier(algebraModule(E)), i with aV, μV, hi)
  rw (tkJRightMul.value at E, b(j), a(i) with extension, bjL, aiL)
  rw (tkJTowerFamily.value at E, I, J, a, b, (j, i) with extension, aL, second, pair)
  rw [fst.pair, snd.pair]

-- Combinations of a family of F are the same in F/K and in L/K.
theorem tkJ.tower_sub_combination (F I e a : Set)
  requires intermediate : IntermediateField(E, F)
  requires finiteI : Finite(I)
  requires coefficients : e : I → Ring.carrier(Algebra.base(E))
  requires family : a : I → F
  shows moduleCombination(submoduleModule(algebraModule(E), Algebra.base(E), F),
      Algebra.base(E), I, e, a) =
    moduleCombination(algebraModule(E), Algebra.base(E), I, e, a)
proof
  have ext2 := extension
  obtain ⟨algebra, _, _⟩ := ext2
  have moduleV := algebraModule.module_of with algebra
  have commK := Algebra.base_comm_ring with algebra
  have ringK := CommRing.to_ring with commK
  have sub := tkJ.tower_submodule with extension, intermediate
  have bounded := tkJ.intermediate_bounded with intermediate
  have moduleS := SubmoduleOf.submodule_module at Algebra.base(E), algebraModule(E), F with
    ringK, moduleV, sub
  have lin := SubmoduleOf.inclusion_linear at Algebra.base(E), algebraModule(E), F with
    ringK, moduleV, sub
  have carrierS := submoduleModule.carrier_eq at algebraModule(E), Algebra.base(E), F
  have aS : a : I → Module.carrier(submoduleModule(algebraModule(E), Algebra.base(E), F))
    rw carrierS
    exact family
  have m := LinearMap.map_combination at Algebra.base(E),
    submoduleModule(algebraModule(E), Algebra.base(E), F), algebraModule(E), identity(F), I,
    e, a with ringK, moduleS, moduleV, lin, finiteI, coefficients, aS
  have combS := moduleCombination.mem_of at Algebra.base(E),
    submoduleModule(algebraModule(E), Algebra.base(E), F), I, e, a with ringK, moduleS,
    finiteI, coefficients, aS
  rw carrierS at combS
  rw (identity.apply at moduleCombination(submoduleModule(algebraModule(E),
    Algebra.base(E), F), Algebra.base(E), I, e, a), F with combS) at m
  have boundedV : F ⊆ Module.carrier(algebraModule(E))
    rw algebraModule.carrier_eq
    exact bounded
  have idV := identity.inclusion with boundedV
  rw carrierS at m
  have aInV : ∀ i ∈ I, a(i) ∈ Module.carrier(algebraModule(E))
    intros i hi
    have ai := FunctionBetween.apply_closed with family, hi
    exact boundedV with a(i), ai
  have aV := FunctionBetween.codomain_of_values with family, aInV
  have compF := compose.function at identity(F), a, I, F, Module.carrier(algebraModule(E))
    with family, idV
  have same : compose(identity(F), a, I, F, Module.carrier(algebraModule(E))) = a
    apply FunctionBetween.ext with compF, aV
    intros i hi
    have ai := FunctionBetween.apply_closed with family, hi
    rw (compose.apply at identity(F), a, I, F, Module.carrier(algebraModule(E)), i with
      family, idV, hi)
    exact identity.apply at a(i), F with ai
  rw same at m
  exact m

-- An F-subspace of L/F is a K-subspace of L/K.
theorem tkJ.over_submodule (F N : Set)
  requires intermediate : IntermediateField(E, F)
  requires sub : SubmoduleOf(N, algebraModule(overExtension(E, F)),
    Algebra.base(overExtension(E, F)))
  shows SubmoduleOf(N, algebraModule(E), Algebra.base(E))
proof
  have ext2 := extension
  obtain ⟨algebra, _, _⟩ := ext2
  have moduleV := algebraModule.module_of with algebra
  have bottom := IntermediateField.bottom_subset with extension, intermediate
  have mapF := Algebra.map_function with algebra
  obtain ⟨_, bounded, zeroIn, addIn, smulIn⟩ := sub
  rw [algebraModule.carrier_eq, tkJ.over_carrier] at bounded
  rw [(tkJ.alg_module_zero at overExtension(E, F)), tkJ.over_ring] at zeroIn
  rw [(algebraModule.add_eq at overExtension(E, F)), tkJ.over_ring] at addIn
  unfold SubmoduleOf
  refine ⟨moduleV, ?_, ?_, ?_, ?_⟩
  . rw algebraModule.carrier_eq
    exact bounded
  . rw tkJ.alg_module_zero
    exact zeroIn
  . rw algebraModule.add_eq
    exact addIn
  . intros r rK v vN
    have vL := bounded with v, vN
    rw (algebraModule.smul_value with algebra, rK, vL)
    have mapIn : Algebra.map(E)(r) ∈ bottomField(E)
      unfold bottomField
      exact functionImage.value with mapF, rK
    have mF := bottom with Algebra.map(E)(r), mapIn
    have mB : Algebra.map(E)(r) ∈ Ring.carrier(Algebra.base(overExtension(E, F)))
      rw [tkJ.over_base, subringRing.carrierOf]
      exact mF
    have s := smulIn with Algebra.map(E)(r), mB, v, vN
    rw (tkJ.over_module_smul at E, F, Algebra.map(E)(r), v with extension, intermediate,
      mF, vL) at s
    exact s

-- The coordinates (j, i) ↦ the i-th coordinate of g(j) in a basis a of F/K.
defgraph tkJTowerCoords (F I J a g : Set) (k ∈ J × I) : Ring.carrier(Algebra.base(E)) :=
    basisCoordinates(submoduleModule(algebraModule(E), Algebra.base(E), F),
      Algebra.base(E), I, a, g(fst(k)))(snd(k))
requires basis : ModuleBasis(submoduleModule(algebraModule(E), Algebra.base(E), F),
  Algebra.base(E), I, a)
requires finiteI : Finite(I)
requires gFam : g : J → F
proof
  obtain ⟨_, j, hj, i, hi, shape⟩ := product.membership.forward with member
  rw [shape, fst.pair, snd.pair]
  have gj := FunctionBetween.apply_closed with gFam, hj
  have gS : g(j) ∈ Module.carrier(submoduleModule(algebraModule(E), Algebra.base(E), F))
    rw submoduleModule.carrier_eq
    exact gj
  have sel := basisCoordinates.selected at submoduleModule(algebraModule(E),
    Algebra.base(E), F), Algebra.base(E), I, a, g(j) with basis, finiteI, gS
  obtain ⟨space, _⟩ := sel
  have fn := functionSpace.mem_iff.forward with space
  exact FunctionBetween.apply_closed with fn, hi

theorem extensionDegree.tower (F : Set)
  requires finite : FiniteExtension(E)
  requires intermediate : IntermediateField(E, F)
  shows FiniteExtension(subextension(E, F)) ∧ FiniteExtension(overExtension(E, F)) ∧
    extensionDegree(subextension(E, F)) * extensionDegree(overExtension(E, F)) =
      extensionDegree(E)
proof
  have ext2 := extension
  obtain ⟨algebra, baseField, ringField⟩ := ext2
  have fin2 := finite
  obtain ⟨_, fdV⟩ := fin2
  have moduleV := algebraModule.module_of with algebra
  have commK := Algebra.base_comm_ring with algebra
  have ringK := CommRing.to_ring with commK
  have baseParts := Field.parts with baseField
  have ntK := IsField.nontrivial with baseParts
  obtain ⟨_, _, distinctK⟩ := ntK
  have fields := IntermediateField.subextension_field with extension, intermediate
  obtain ⟨subExt, overExt⟩ := fields
  have overAlg := tkJ.overExtension_algebra with intermediate
  have moduleB := algebraModule.module_of with overAlg
  have subField := tkJ.intermediate_field with intermediate
  have bounded := tkJ.intermediate_bounded with intermediate
  have sub := tkJ.tower_submodule with extension, intermediate
  have subEq := tkJ.tower_sub_module with extension, intermediate
  have moduleS := SubmoduleOf.submodule_module at Algebra.base(E), algebraModule(E), F with
    ringK, moduleV, sub
  have carrierS := submoduleModule.carrier_eq at algebraModule(E), Algebra.base(E), F
  have carrierV := algebraModule.carrier_eq at E
  -- F/K is finite
  have fdS := SubmoduleOf.finite_dimensional at Algebra.base(E), algebraModule(E), F with
    baseField, moduleV, fdV, sub
  obtain ⟨fdSub, _⟩ := fdS
  have finiteSub : FiniteExtension(subextension(E, F))
    unfold FiniteExtension
    rw [tkJ.sub_base, subEq]
    exact ⟨subExt, fdSub⟩
  -- L/F is finite: a finite K-spanning set spans over F
  have fdV2 := fdV
  obtain ⟨_, generated⟩ := fdV2
  obtain ⟨_, S, Ssub, finS, spanS⟩ := generated
  have baseFOver : Field(Algebra.base(overExtension(E, F)))
    rw tkJ.over_base
    exact subField
  have commF := Algebra.base_comm_ring with overAlg
  have ringF := CommRing.to_ring with commF
  have SB : S ⊆ Module.carrier(algebraModule(overExtension(E, F)))
    rw [algebraModule.carrier_eq, tkJ.over_carrier, ← carrierV]
    exact Ssub
  have spanB := moduleSpan.submodule_of at Algebra.base(overExtension(E, F)),
    algebraModule(overExtension(E, F)), S with ringF, moduleB
  have spanBV := tkJ.over_submodule at E, F, moduleSpan(algebraModule(overExtension(E, F)),
    Algebra.base(overExtension(E, F)), S) with extension, intermediate, spanB
  have SinSpan := moduleSpan.subset_of at Algebra.base(overExtension(E, F)),
    algebraModule(overExtension(E, F)), S with ringF, moduleB, SB
  have le := (moduleSpan.least_of at Algebra.base(E), algebraModule(E), S,
    moduleSpan(algebraModule(overExtension(E, F)), Algebra.base(overExtension(E, F)), S) with
    ringK, moduleV, Ssub, spanBV).backward with SinSpan
  rw spanS at le
  have spanB2 := spanB
  obtain ⟨_, spanBound, _⟩ := spanB2
  have spanEqB : moduleSpan(algebraModule(overExtension(E, F)),
      Algebra.base(overExtension(E, F)), S) = Module.carrier(algebraModule(overExtension(E, F)))
    apply Subset.antisymmetric
    . exact spanBound
    . rw [algebraModule.carrier_eq, tkJ.over_carrier, ← carrierV]
      exact le
  have fdB : FiniteDimensional(algebraModule(overExtension(E, F)),
      Algebra.base(overExtension(E, F)))
    unfold FiniteDimensional
    refine ⟨baseFOver, ?_⟩
    unfold FinitelyGeneratedModule
    exact ⟨moduleB, S, SB, finS, spanEqB⟩
  have finiteOver : FiniteExtension(overExtension(E, F))
    unfold FiniteExtension
    exact ⟨overExt, fdB⟩
  refine ⟨finiteSub, finiteOver, ?_⟩
  -- bases a of F/K and b of L/F
  have freeS := FiniteDimensional.finite_free at Algebra.base(E),
    submoduleModule(algebraModule(E), Algebra.base(E), F) with baseField, moduleS, fdSub
  obtain ⟨a, basisA⟩ := finrank.basis_exists at Algebra.base(E),
    submoduleModule(algebraModule(E), Algebra.base(E), F) with commK, distinctK, moduleS, freeS
  have fParts := Field.parts with baseFOver
  have ntF := IsField.nontrivial with fParts
  obtain ⟨_, _, distinctF⟩ := ntF
  have freeB := FiniteDimensional.finite_free at Algebra.base(overExtension(E, F)),
    algebraModule(overExtension(E, F)) with baseFOver, moduleB, fdB
  obtain ⟨b, basisB⟩ := finrank.basis_exists at Algebra.base(overExtension(E, F)),
    algebraModule(overExtension(E, F)) with commF, distinctF, moduleB, freeB
  have nA : Nat(finrank(submoduleModule(algebraModule(E), Algebra.base(E), F),
    Algebra.base(E))) by typecheck
  have nB : Nat(finrank(algebraModule(overExtension(E, F)),
    Algebra.base(overExtension(E, F)))) by typecheck
  have finA := Finite.natural at finrank(submoduleModule(algebraModule(E), Algebra.base(E),
    F), Algebra.base(E))
  have finB := Finite.natural at finrank(algebraModule(overExtension(E, F)),
    Algebra.base(overExtension(E, F)))
  have basisA2 := basisA
  obtain ⟨indA, _⟩ := basisA2
  have indA2 := indA
  obtain ⟨_, aS, _⟩ := indA2
  have aF : a : finrank(submoduleModule(algebraModule(E), Algebra.base(E), F),
      Algebra.base(E)) → F
    rw carrierS at aS
    exact aS
  have basisB2 := basisB
  obtain ⟨indB, _⟩ := basisB2
  have indB2 := indB
  obtain ⟨_, bB, _⟩ := indB2
  have bL : b : finrank(algebraModule(overExtension(E, F)),
      Algebra.base(overExtension(E, F))) → algebraCarrier(E)
    rw [algebraModule.carrier_eq, tkJ.over_carrier] at bB
    exact bB
  have aInL : ∀ i ∈ finrank(submoduleModule(algebraModule(E), Algebra.base(E), F),
      Algebra.base(E)), a(i) ∈ algebraCarrier(E)
    intros i hi
    have ai := FunctionBetween.apply_closed with aF, hi
    exact bounded with a(i), ai
  have aL := FunctionBetween.codomain_of_values with aF, aInL
  have cL := tkJTowerFamily.function at E, finrank(submoduleModule(algebraModule(E),
    Algebra.base(E), F), Algebra.base(E)), finrank(algebraModule(overExtension(E, F)),
    Algebra.base(overExtension(E, F))), a, b with extension, aL, bL
  have cV : tkJTowerFamily(E, finrank(submoduleModule(algebraModule(E), Algebra.base(E), F),
      Algebra.base(E)), finrank(algebraModule(overExtension(E, F)),
      Algebra.base(overExtension(E, F))), a, b) : finrank(algebraModule(overExtension(E, F)),
      Algebra.base(overExtension(E, F))) × finrank(submoduleModule(algebraModule(E),
      Algebra.base(E), F), Algebra.base(E)) → Module.carrier(algebraModule(E))
    rw carrierV
    exact cL
  have finProd := Finite.product with finB, finA
  have baseCarrierF : Ring.carrier(Algebra.base(overExtension(E, F))) = F
    rw [tkJ.over_base, subringRing.carrierOf]
  have baseZeroF : Ring.zero(Algebra.base(overExtension(E, F))) = Ring.zero(Algebra.ring(E))
    rw tkJ.over_base
    unfold subringRing
    rw Ring.mk.zero
  have indep : LinearIndependent(algebraModule(E), Algebra.base(E), finrank(algebraModule(overExtension(E, F)), Algebra.base(overExtension(E, F))) × finrank(submoduleModule(algebraModule(E), Algebra.base(E), F), Algebra.base(E)), tkJTowerFamily(E, finrank(submoduleModule(algebraModule(E), Algebra.base(E), F), Algebra.base(E)), finrank(algebraModule(overExtension(E, F)), Algebra.base(overExtension(E, F))), a, b))
    apply (LinearIndependent.finite_iff at Algebra.base(E), algebraModule(E), finrank(algebraModule(overExtension(E, F)), Algebra.base(overExtension(E, F))) × finrank(submoduleModule(algebraModule(E), Algebra.base(E), F), Algebra.base(E)), tkJTowerFamily(E, finrank(submoduleModule(algebraModule(E), Algebra.base(E), F), Algebra.base(E)), finrank(algebraModule(overExtension(E, F)), Algebra.base(overExtension(E, F))), a, b) with commK, moduleV,
      finProd, cV).backward
    intros d dF zero
    rw (tkJ.tower_combination at E, F, finrank(submoduleModule(algebraModule(E), Algebra.base(E), F), Algebra.base(E)), finrank(algebraModule(overExtension(E, F)), Algebra.base(overExtension(E, F))), a, b, d with extension, intermediate, finA,
      finB, aF, bL, dF) at zero
    have zeroB : moduleCombination(algebraModule(overExtension(E, F)), Algebra.base(overExtension(E, F)), finrank(algebraModule(overExtension(E, F)), Algebra.base(overExtension(E, F))), tkJTowerCoeffs(E, F, finrank(submoduleModule(algebraModule(E), Algebra.base(E), F), Algebra.base(E)), finrank(algebraModule(overExtension(E, F)), Algebra.base(overExtension(E, F))), a, d), b) =
        Module.zero(algebraModule(overExtension(E, F)))
      rw [(tkJ.alg_module_zero at overExtension(E, F)), tkJ.over_ring]
      rw (tkJ.alg_module_zero at E) at zero
      exact zero
    have fF := tkJTowerCoeffs.function at E, F, finrank(submoduleModule(algebraModule(E), Algebra.base(E), F), Algebra.base(E)), finrank(algebraModule(overExtension(E, F)), Algebra.base(overExtension(E, F))), a, d with extension, intermediate,
      finA, aF, dF
    have fB : tkJTowerCoeffs(E, F, finrank(submoduleModule(algebraModule(E), Algebra.base(E), F), Algebra.base(E)), finrank(algebraModule(overExtension(E, F)), Algebra.base(overExtension(E, F))), a, d) : finrank(algebraModule(overExtension(E, F)), Algebra.base(overExtension(E, F))) → Ring.carrier(Algebra.base(overExtension(E, F)))
      rw baseCarrierF
      exact fF
    have fZero := (LinearIndependent.finite_iff at Algebra.base(overExtension(E, F)), algebraModule(overExtension(E, F)), finrank(algebraModule(overExtension(E, F)), Algebra.base(overExtension(E, F))), b with commF, moduleB,
      finB, bB).forward with indB, tkJTowerCoeffs(E, F, finrank(submoduleModule(algebraModule(E), Algebra.base(E), F), Algebra.base(E)), finrank(algebraModule(overExtension(E, F)), Algebra.base(overExtension(E, F))), a, d), fB, zeroB
    intros k hk
    obtain ⟨_, j, hj, i, hi, shape⟩ := product.membership.forward with hk
    have fj := fZero with j, hj
    rw baseZeroF at fj
    rw (tkJTowerCoeffs.value at E, F, finrank(submoduleModule(algebraModule(E), Algebra.base(E), F), Algebra.base(E)), finrank(algebraModule(overExtension(E, F)), Algebra.base(overExtension(E, F))), a, d, j with extension, intermediate, finA,
      aF, dF, hj) at fj
    have dValues : ∀ i ∈ finrank(submoduleModule(algebraModule(E), Algebra.base(E), F), Algebra.base(E)), d((j, i)) ∈ Ring.carrier(Algebra.base(E))
      intros i2 hi2
      have pair := product.pair at j, i2, finrank(algebraModule(overExtension(E, F)), Algebra.base(overExtension(E, F))), finrank(submoduleModule(algebraModule(E), Algebra.base(E), F), Algebra.base(E)) with hj, hi2
      exact FunctionBetween.apply_closed with dF, pair
    have sdF := familySlice.function at finrank(submoduleModule(algebraModule(E), Algebra.base(E), F), Algebra.base(E)), Ring.carrier(Algebra.base(E)), d, j with dValues
    rw ← (tkJ.tower_sub_combination at E, F, finrank(submoduleModule(algebraModule(E), Algebra.base(E), F), Algebra.base(E)), familySlice(finrank(submoduleModule(algebraModule(E), Algebra.base(E), F), Algebra.base(E)), Ring.carrier(Algebra.base(E)), d, j),
      a with extension, intermediate, finA, sdF, aF) at fj
    have zS : moduleCombination(submoduleModule(algebraModule(E), Algebra.base(E), F), Algebra.base(E), finrank(submoduleModule(algebraModule(E), Algebra.base(E), F), Algebra.base(E)), familySlice(finrank(submoduleModule(algebraModule(E), Algebra.base(E), F), Algebra.base(E)), Ring.carrier(Algebra.base(E)), d, j), a) =
        Module.zero(submoduleModule(algebraModule(E), Algebra.base(E), F))
      rw [submoduleModule.zero_eq, tkJ.alg_module_zero]
      exact fj
    have sdZero := (LinearIndependent.finite_iff at Algebra.base(E), submoduleModule(algebraModule(E), Algebra.base(E), F), finrank(submoduleModule(algebraModule(E), Algebra.base(E), F), Algebra.base(E)), a with commK, moduleS,
      finA, aS).forward with indA, familySlice(finrank(submoduleModule(algebraModule(E), Algebra.base(E), F), Algebra.base(E)), Ring.carrier(Algebra.base(E)), d, j), sdF, zS
    have v := sdZero with i, hi
    rw (familySlice.apply at finrank(submoduleModule(algebraModule(E), Algebra.base(E), F), Algebra.base(E)), Ring.carrier(Algebra.base(E)), d, j, i with dValues, hi) at v
    rw shape
    exact v
  have spans : SpansModule(algebraModule(E), Algebra.base(E), finrank(algebraModule(overExtension(E, F)), Algebra.base(overExtension(E, F))) × finrank(submoduleModule(algebraModule(E), Algebra.base(E), F), Algebra.base(E)), tkJTowerFamily(E, finrank(submoduleModule(algebraModule(E), Algebra.base(E), F), Algebra.base(E)), finrank(algebraModule(overExtension(E, F)), Algebra.base(overExtension(E, F))), a, b))
    unfold SpansModule
    refine ⟨moduleV, cV, ?_⟩
    rw (moduleSpan.range_family_of at Algebra.base(E), algebraModule(E), finrank(algebraModule(overExtension(E, F)), Algebra.base(overExtension(E, F))) × finrank(submoduleModule(algebraModule(E), Algebra.base(E), F), Algebra.base(E)), tkJTowerFamily(E, finrank(submoduleModule(algebraModule(E), Algebra.base(E), F), Algebra.base(E)), finrank(algebraModule(overExtension(E, F)), Algebra.base(overExtension(E, F))), a, b) with ringK, moduleV, finProd, cV)
    apply Subset.antisymmetric
    . intros x hx
      obtain ⟨xIn, _⟩ := familyCombinations.membership.forward with hx
      exact xIn
    . intros x xV
      have xB : x ∈ Module.carrier(algebraModule(overExtension(E, F)))
        rw [algebraModule.carrier_eq, tkJ.over_carrier, ← carrierV]
        exact xV
      have selB := basisCoordinates.selected at algebraModule(overExtension(E, F)), Algebra.base(overExtension(E, F)), finrank(algebraModule(overExtension(E, F)), Algebra.base(overExtension(E, F))), b, x with basisB, finB, xB
      obtain ⟨gSpace, xEq⟩ := selB
      have gFP := functionSpace.mem_iff.forward with gSpace
      have gF : basisCoordinates(algebraModule(overExtension(E, F)), Algebra.base(overExtension(E, F)), finrank(algebraModule(overExtension(E, F)), Algebra.base(overExtension(E, F))), b, x) : finrank(algebraModule(overExtension(E, F)), Algebra.base(overExtension(E, F))) → F
        rw baseCarrierF at gFP
        exact gFP
      have dF := tkJTowerCoords.function at E, F, finrank(submoduleModule(algebraModule(E), Algebra.base(E), F), Algebra.base(E)), finrank(algebraModule(overExtension(E, F)), Algebra.base(overExtension(E, F))), a,
        basisCoordinates(algebraModule(overExtension(E, F)), Algebra.base(overExtension(E, F)), finrank(algebraModule(overExtension(E, F)), Algebra.base(overExtension(E, F))), b, x) with extension, basisA, finA, gF
      have fF := tkJTowerCoeffs.function at E, F, finrank(submoduleModule(algebraModule(E), Algebra.base(E), F), Algebra.base(E)), finrank(algebraModule(overExtension(E, F)), Algebra.base(overExtension(E, F))), a, tkJTowerCoords(E, F, finrank(submoduleModule(algebraModule(E), Algebra.base(E), F), Algebra.base(E)), finrank(algebraModule(overExtension(E, F)), Algebra.base(overExtension(E, F))),
        a, basisCoordinates(algebraModule(overExtension(E, F)), Algebra.base(overExtension(E, F)), finrank(algebraModule(overExtension(E, F)), Algebra.base(overExtension(E, F))), b, x)) with extension, intermediate, finA, aF, dF
      have coeffEq : tkJTowerCoeffs(E, F, finrank(submoduleModule(algebraModule(E), Algebra.base(E), F), Algebra.base(E)), finrank(algebraModule(overExtension(E, F)), Algebra.base(overExtension(E, F))), a, tkJTowerCoords(E, F, finrank(submoduleModule(algebraModule(E), Algebra.base(E), F), Algebra.base(E)), finrank(algebraModule(overExtension(E, F)), Algebra.base(overExtension(E, F))), a,
          basisCoordinates(algebraModule(overExtension(E, F)), Algebra.base(overExtension(E, F)), finrank(algebraModule(overExtension(E, F)), Algebra.base(overExtension(E, F))), b, x))) = basisCoordinates(algebraModule(overExtension(E, F)), Algebra.base(overExtension(E, F)), finrank(algebraModule(overExtension(E, F)), Algebra.base(overExtension(E, F))), b, x)
        apply FunctionBetween.ext with fF, gF
        intros j hj
        rw (tkJTowerCoeffs.value at E, F, finrank(submoduleModule(algebraModule(E), Algebra.base(E), F), Algebra.base(E)), finrank(algebraModule(overExtension(E, F)), Algebra.base(overExtension(E, F))), a, tkJTowerCoords(E, F, finrank(submoduleModule(algebraModule(E), Algebra.base(E), F), Algebra.base(E)), finrank(algebraModule(overExtension(E, F)), Algebra.base(overExtension(E, F))), a,
          basisCoordinates(algebraModule(overExtension(E, F)), Algebra.base(overExtension(E, F)), finrank(algebraModule(overExtension(E, F)), Algebra.base(overExtension(E, F))), b, x)), j with extension, intermediate, finA, aF, dF,
          hj)
        have gj := FunctionBetween.apply_closed with gF, hj
        have gS : basisCoordinates(algebraModule(overExtension(E, F)), Algebra.base(overExtension(E, F)), finrank(algebraModule(overExtension(E, F)), Algebra.base(overExtension(E, F))), b, x)(j) ∈ Module.carrier(submoduleModule(algebraModule(E), Algebra.base(E), F))
          rw carrierS
          exact gj
        have selA := basisCoordinates.selected at submoduleModule(algebraModule(E), Algebra.base(E), F), Algebra.base(E), finrank(submoduleModule(algebraModule(E), Algebra.base(E), F), Algebra.base(E)), a,
          basisCoordinates(algebraModule(overExtension(E, F)), Algebra.base(overExtension(E, F)), finrank(algebraModule(overExtension(E, F)), Algebra.base(overExtension(E, F))), b, x)(j) with basisA, finA, gS
        obtain ⟨hSpace, gjEq⟩ := selA
        have hF := functionSpace.mem_iff.forward with hSpace
        have dValues : ∀ i ∈ finrank(submoduleModule(algebraModule(E), Algebra.base(E), F), Algebra.base(E)), tkJTowerCoords(E, F, finrank(submoduleModule(algebraModule(E), Algebra.base(E), F), Algebra.base(E)), finrank(algebraModule(overExtension(E, F)), Algebra.base(overExtension(E, F))), a,
            basisCoordinates(algebraModule(overExtension(E, F)), Algebra.base(overExtension(E, F)), finrank(algebraModule(overExtension(E, F)), Algebra.base(overExtension(E, F))), b, x))((j, i)) ∈ Ring.carrier(Algebra.base(E))
          intros i hi
          have pair := product.pair at j, i, finrank(algebraModule(overExtension(E, F)), Algebra.base(overExtension(E, F))), finrank(submoduleModule(algebraModule(E), Algebra.base(E), F), Algebra.base(E)) with hj, hi
          exact FunctionBetween.apply_closed with dF, pair
        have sdF := familySlice.function at finrank(submoduleModule(algebraModule(E), Algebra.base(E), F), Algebra.base(E)), Ring.carrier(Algebra.base(E)), tkJTowerCoords(E, F, finrank(submoduleModule(algebraModule(E), Algebra.base(E), F), Algebra.base(E)),
          finrank(algebraModule(overExtension(E, F)), Algebra.base(overExtension(E, F))), a, basisCoordinates(algebraModule(overExtension(E, F)), Algebra.base(overExtension(E, F)), finrank(algebraModule(overExtension(E, F)), Algebra.base(overExtension(E, F))), b, x)), j with dValues
        have sliceEq : familySlice(finrank(submoduleModule(algebraModule(E), Algebra.base(E), F), Algebra.base(E)), Ring.carrier(Algebra.base(E)), tkJTowerCoords(E, F, finrank(submoduleModule(algebraModule(E), Algebra.base(E), F), Algebra.base(E)), finrank(algebraModule(overExtension(E, F)), Algebra.base(overExtension(E, F))), a,
            basisCoordinates(algebraModule(overExtension(E, F)), Algebra.base(overExtension(E, F)), finrank(algebraModule(overExtension(E, F)), Algebra.base(overExtension(E, F))), b, x)), j) = basisCoordinates(submoduleModule(algebraModule(E), Algebra.base(E), F), Algebra.base(E), finrank(submoduleModule(algebraModule(E), Algebra.base(E), F), Algebra.base(E)), a,
            basisCoordinates(algebraModule(overExtension(E, F)), Algebra.base(overExtension(E, F)), finrank(algebraModule(overExtension(E, F)), Algebra.base(overExtension(E, F))), b, x)(j))
          apply FunctionBetween.ext with sdF, hF
          intros i hi
          have pair := product.pair at j, i, finrank(algebraModule(overExtension(E, F)), Algebra.base(overExtension(E, F))), finrank(submoduleModule(algebraModule(E), Algebra.base(E), F), Algebra.base(E)) with hj, hi
          rw (familySlice.apply at finrank(submoduleModule(algebraModule(E), Algebra.base(E), F), Algebra.base(E)), Ring.carrier(Algebra.base(E)), tkJTowerCoords(E, F, finrank(submoduleModule(algebraModule(E), Algebra.base(E), F), Algebra.base(E)), finrank(algebraModule(overExtension(E, F)), Algebra.base(overExtension(E, F))), a,
            basisCoordinates(algebraModule(overExtension(E, F)), Algebra.base(overExtension(E, F)), finrank(algebraModule(overExtension(E, F)), Algebra.base(overExtension(E, F))), b, x)), j, i with dValues, hi)
          rw (tkJTowerCoords.value at E, F, finrank(submoduleModule(algebraModule(E), Algebra.base(E), F), Algebra.base(E)), finrank(algebraModule(overExtension(E, F)), Algebra.base(overExtension(E, F))), a, basisCoordinates(algebraModule(overExtension(E, F)), Algebra.base(overExtension(E, F)), finrank(algebraModule(overExtension(E, F)), Algebra.base(overExtension(E, F))), b, x),
            (j, i) with extension, basisA, finA, gF, pair)
          rw [fst.pair, snd.pair]
        rw sliceEq
        rw ← (tkJ.tower_sub_combination at E, F, finrank(submoduleModule(algebraModule(E), Algebra.base(E), F), Algebra.base(E)), basisCoordinates(submoduleModule(algebraModule(E), Algebra.base(E), F), Algebra.base(E), finrank(submoduleModule(algebraModule(E), Algebra.base(E), F), Algebra.base(E)), a,
          basisCoordinates(algebraModule(overExtension(E, F)), Algebra.base(overExtension(E, F)), finrank(algebraModule(overExtension(E, F)), Algebra.base(overExtension(E, F))), b, x)(j)), a with extension, intermediate, finA, hF,
          aF)
        symm
        exact gjEq
      have comb := tkJ.tower_combination at E, F, finrank(submoduleModule(algebraModule(E), Algebra.base(E), F), Algebra.base(E)), finrank(algebraModule(overExtension(E, F)), Algebra.base(overExtension(E, F))), a, b, tkJTowerCoords(E, F, finrank(submoduleModule(algebraModule(E), Algebra.base(E), F), Algebra.base(E)),
        finrank(algebraModule(overExtension(E, F)), Algebra.base(overExtension(E, F))), a, basisCoordinates(algebraModule(overExtension(E, F)), Algebra.base(overExtension(E, F)), finrank(algebraModule(overExtension(E, F)), Algebra.base(overExtension(E, F))), b, x)) with extension, intermediate, finA,
        finB, aF, bL, dF
      rw coeffEq at comb
      rw ← xEq at comb
      apply familyCombinations.membership.backward
      refine ⟨xV, tkJTowerCoords(E, F, finrank(submoduleModule(algebraModule(E), Algebra.base(E), F), Algebra.base(E)), finrank(algebraModule(overExtension(E, F)), Algebra.base(overExtension(E, F))), a, basisCoordinates(algebraModule(overExtension(E, F)), Algebra.base(overExtension(E, F)), finrank(algebraModule(overExtension(E, F)), Algebra.base(overExtension(E, F))), b, x)),
        dF, ?_⟩
      symm
      exact comb
  have basisC : ModuleBasis(algebraModule(E), Algebra.base(E), finrank(algebraModule(overExtension(E, F)), Algebra.base(overExtension(E, F))) × finrank(submoduleModule(algebraModule(E), Algebra.base(E), F), Algebra.base(E)), tkJTowerFamily(E, finrank(submoduleModule(algebraModule(E), Algebra.base(E), F), Algebra.base(E)), finrank(algebraModule(overExtension(E, F)), Algebra.base(overExtension(E, F))), a, b))
    unfold ModuleBasis
    exact ⟨indep, spans⟩
  have rank := finrank.of_basis at Algebra.base(E), algebraModule(E), finrank(algebraModule(overExtension(E, F)), Algebra.base(overExtension(E, F))) × finrank(submoduleModule(algebraModule(E), Algebra.base(E), F), Algebra.base(E)), tkJTowerFamily(E, finrank(submoduleModule(algebraModule(E), Algebra.base(E), F), Algebra.base(E)), finrank(algebraModule(overExtension(E, F)), Algebra.base(overExtension(E, F))), a, b) with commK, distinctK, moduleV,
    finProd, basisC
  have cardA := cardinality.correct with finA
  have cardB := cardinality.correct with finB
  have cardP := HasCardinality.product with cardB, cardA
  have count := cardinality.eq_of_has with cardP
  rw [(cardinality.natural at finrank(submoduleModule(algebraModule(E), Algebra.base(E), F), Algebra.base(E))), (cardinality.natural at finrank(algebraModule(overExtension(E, F)), Algebra.base(overExtension(E, F))))] at count
  unfold extensionDegree
  rw [tkJ.sub_base, subEq, rank, count]
  arith

-- Helpers for towers K ≤ F ≤ L: the inclusion F → L over K, evaluation in
-- F/K and in L/F, and the structure map of F/K.
theorem tkJ.sub_inclusion_hom (F : Set)
  requires intermediate : IntermediateField(E, F)
  shows identity(F) : subextension(E, F) →ₐ E
proof
  have ext2 := extension
  obtain ⟨algebra, baseField, ringField⟩ := ext2
  have ringB := Algebra.comm_ring at E with algebra
  have subring := tkJ.intermediate_subring with intermediate
  unfold algebraCarrier at subring
  have bundled := Subring.of_projections with subring
  have incl := Subring.inclusion at Algebra.ring(E), F with ringB, bundled
  have subAlg := tkJ.subextension_algebra with intermediate
  have bottom := IntermediateField.bottom_subset with extension, intermediate
  have mapF := Algebra.map_function with algebra
  unfold AlgebraHom
  rw [tkJ.sub_ring, tkJ.sub_base, tkJ.sub_map]
  refine ⟨subAlg, algebra, rfl, incl, ?_⟩
  intros a aK
  rw tkJ.sub_base at aK
  have mapIn : Algebra.map(E)(a) ∈ bottomField(E)
    unfold bottomField
    exact functionImage.value with mapF, aK
  have inF := bottom with Algebra.map(E)(a), mapIn
  exact identity.apply with inF

theorem tkJ.sub_structure_hom (F : Set)
  requires intermediate : IntermediateField(E, F)
  shows Algebra.map(E) : Algebra.base(E) →+* subringRing(Algebra.ring(E), F)
proof
  have subAlg := tkJ.subextension_algebra with intermediate
  have sh := Algebra.structure_hom with subAlg
  rw [tkJ.sub_map, tkJ.sub_base, tkJ.sub_ring] at sh
  exact sh

theorem tkJ.sub_aeval (F y p : Set)
  requires intermediate : IntermediateField(E, F)
  requires point : y ∈ F
  requires member : p ∈ uniPolys(Algebra.base(E))
  shows polyAeval(subextension(E, F), y, p) = polyAeval(E, y, p)
proof
  have subAlg := tkJ.subextension_algebra with intermediate
  have hom := tkJ.sub_inclusion_hom with intermediate
  have bounded := tkJ.intermediate_bounded with intermediate
  have ySub : y ∈ algebraCarrier(subextension(E, F))
    rw tkJ.sub_carrier
    exact point
  have pSub : p ∈ Ring.carrier(polynomialRing(Algebra.base(subextension(E, F)), {0}))
    rw tkJ.sub_base
    unfold uniPolys at member
    exact member
  have pSubUni : p ∈ uniPolys(Algebra.base(subextension(E, F)))
    unfold uniPolys
    exact pSub
  have applied := polyAeval.algebra_hom_apply at subextension(E, F), E, identity(F), y,
    p with subAlg, hom, ySub, pSub
  have valueIn := tkJ.gal_aeval_mem with subAlg, ySub, pSubUni
  rw [tkJ.sub_ring, subringRing.carrierOf] at valueIn
  rw [(identity.apply at polyAeval(subextension(E, F), y, p), F with valueIn),
    (identity.apply at y, F with point)] at applied
  exact applied

-- The structure map of E corestricted to F and followed by the inclusion.
theorem tkJ.compose_inclusion (F : Set)
  requires intermediate : IntermediateField(E, F)
  shows compose(identity(F), Algebra.map(E), Ring.carrier(Algebra.base(E)), F,
    algebraCarrier(E)) = Algebra.map(E)
proof
  have ext2 := extension
  obtain ⟨algebra, baseField, ringField⟩ := ext2
  have bottom := IntermediateField.bottom_subset with extension, intermediate
  have bounded := tkJ.intermediate_bounded with intermediate
  have mapF := Algebra.map_function with algebra
  have values : ∀ a ∈ Ring.carrier(Algebra.base(E)), Algebra.map(E)(a) ∈ F
    intros a aK
    have mapIn : Algebra.map(E)(a) ∈ bottomField(E)
      unfold bottomField
      exact functionImage.value with mapF, aK
    exact bottom with Algebra.map(E)(a), mapIn
  have intoF := FunctionBetween.codomain_of_values with mapF, values
  have inclusion := identity.inclusion with bounded
  have composite := compose.function with intoF, inclusion
  apply FunctionBetween.ext with composite, mapF
  intros a aK
  have inF := values with a, aK
  rw (compose.apply with intoF, inclusion, aK)
  exact identity.apply with inF

theorem tkJ.over_aeval (F y p : Set)
  requires intermediate : IntermediateField(E, F)
  requires point : y ∈ algebraCarrier(E)
  requires member : p ∈ uniPolys(Algebra.base(E))
  shows polyAeval(overExtension(E, F), y,
      polyMap(Algebra.base(E), subringRing(Algebra.ring(E), F), Algebra.map(E))(p)) =
    polyAeval(E, y, p)
proof
  have ext2 := extension
  obtain ⟨algebra, baseField, ringField⟩ := ext2
  have comm := Algebra.base_comm_ring with algebra
  have polys := polynomialRing.comm_ring at Algebra.base(E), {0} with comm
  have ringL := Algebra.comm_ring with algebra
  have subring := tkJ.intermediate_subring with intermediate
  unfold algebraCarrier at subring
  have bundled := Subring.of_projections with subring
  have commF := subringRing.comm_ring at Algebra.ring(E), F with ringL, bundled
  have polysF := polynomialRing.comm_ring at subringRing(Algebra.ring(E), F), {0} with
    commF
  have incl := Subring.inclusion at Algebra.ring(E), F with ringL, bundled
  have intoF := tkJ.sub_structure_hom with intermediate
  have mapL := Algebra.structure_hom with algebra
  have pIn := member
  unfold uniPolys at pIn
  have yL := point
  unfold algebraCarrier at yL
  have polyHom := polyMap.hom at Algebra.base(E), subringRing(Algebra.ring(E), F),
    Algebra.map(E) with comm, polys, commF, intoF
  have qIn := RingHom.map_mem with polyHom, pIn
  have e1 := polyEval2.eq_eval_map at subringRing(Algebra.ring(E), F), Algebra.ring(E),
    identity(F), y, polyMap(Algebra.base(E), subringRing(Algebra.ring(E), F),
    Algebra.map(E))(p) with commF, polysF, ringL, incl, yL, qIn
  have e2 := polyEval2.eq_eval_map at Algebra.base(E), Algebra.ring(E), Algebra.map(E),
    y, p with comm, polys, ringL, mapL, yL, pIn
  have e3 := polyMap.compose at Algebra.base(E), subringRing(Algebra.ring(E), F),
    Algebra.ring(E), Algebra.map(E), identity(F), p with comm, polys, commF, ringL,
    intoF, incl, pIn
  have composite := tkJ.compose_inclusion with intermediate
  rw subringRing.carrierOf at e3
  unfold algebraCarrier at composite
  rw composite at e3
  unfold polyAeval
  rw [tkJ.over_base, tkJ.over_ring, tkJ.over_map]
  rw [e1, e3, ← e2]

-- A root in L of a monic polynomial over K that splits in F lies in F.
theorem tkJ.gal_split_root (F p y : Set)
  requires intermediate : IntermediateField(E, F)
  requires member : p ∈ uniPolys(Algebra.base(E))
  requires monic : PolyMonic(Algebra.base(E), p)
  requires splits : PolySplits(Algebra.base(E), subringRing(Algebra.ring(E), F),
    Algebra.map(E), p)
  requires point : y ∈ algebraCarrier(E)
  requires root : polyAeval(E, y, p) = Ring.zero(Algebra.ring(E))
  shows y ∈ F
proof
  have ext2 := extension
  obtain ⟨algebra, baseField, ringField⟩ := ext2
  have comm := Algebra.base_comm_ring with algebra
  have polys := polynomialRing.comm_ring at Algebra.base(E), {0} with comm
  have ringL := Algebra.comm_ring with algebra
  have domainL := Field.domain with ringField
  have subring := tkJ.intermediate_subring with intermediate
  unfold algebraCarrier at subring
  have bundled := Subring.of_projections with subring
  have commF := subringRing.comm_ring at Algebra.ring(E), F with ringL, bundled
  have polysF := polynomialRing.comm_ring at subringRing(Algebra.ring(E), F), {0} with
    commF
  have incl := Subring.inclusion at Algebra.ring(E), F with ringL, bundled
  have intoF := tkJ.sub_structure_hom with intermediate
  have ringParts := Field.parts with ringField
  have ntL := IsField.nontrivial with ringParts
  obtain ⟨_, _, distinctL⟩ := ntL
  have zeroF : Ring.zero(subringRing(Algebra.ring(E), F)) = Ring.zero(Algebra.ring(E))
    simp [subringRing, Ring.mk.zero]
  have oneF : Ring.one(subringRing(Algebra.ring(E), F)) = Ring.one(Algebra.ring(E))
    simp [subringRing, Ring.mk.one]
  have ntF : Ring.zero(subringRing(Algebra.ring(E), F)) ≠
      Ring.one(subringRing(Algebra.ring(E), F))
    rw [zeroF, oneF]
    exact distinctL
  have mapped := polyMap.monic at Algebra.base(E), subringRing(Algebra.ring(E), F),
    Algebra.map(E), p with comm, polys, commF, intoF, monic, ntF
  obtain ⟨qMonic, _⟩ := mapped
  have qm := qMonic
  obtain ⟨qIn, qLead⟩ := qm
  have qNonzero := PolyMonic.ne_zero at subringRing(Algebra.ring(E), F),
    polyMap(Algebra.base(E), subringRing(Algebra.ring(E), F), Algebra.map(E))(p) with
    commF, polysF, qIn, ntF, qMonic
  have yL := point
  unfold algebraCarrier at yL
  have value := tkJ.over_aeval with intermediate, point, member
  rw root at value
  unfold polyAeval at value
  rw [tkJ.over_base, tkJ.over_ring, tkJ.over_map] at value
  obtain ⟨_, alt⟩ := splits
  cases alt with qz | product
  . exfalso
    exact qNonzero with qz
  . obtain ⟨n, nN, a, aF, qEq⟩ := product
    have nNat := nat.omega.backward with nN
    rw qLead at qEq
    rw ← (uni.one_eq at subringRing(Algebra.ring(E), F) with commF, polysF) at qEq
    have prodIn := (polyLinearProduct.monic at subringRing(Algebra.ring(E), F), a, n with
      commF, polysF, aF).left
    obtain ⟨prodP, _⟩ := prodIn
    have u : Ring.one(polynomialRing(subringRing(Algebra.ring(E), F), {0})) *
        polyLinearProduct(subringRing(Algebra.ring(E), F), a, n) =
        polyLinearProduct(subringRing(Algebra.ring(E), F), a, n) by ring
    rw u at qEq
    rw qEq at value
    unfold polyLinearProduct at value
    have wf := linearFactorFamily.function at subringRing(Algebra.ring(E), F), a, n with
      commF, aF
    have evalHom := polyEval2.hom at subringRing(Algebra.ring(E), F), Algebra.ring(E),
      identity(F), y with commF, polysF, ringL, incl, yL
    by_contra notIn
    have vals : ∀ i ∈ n, polyEval2(subringRing(Algebra.ring(E), F), Algebra.ring(E),
        identity(F), y, linearFactorFamily(subringRing(Algebra.ring(E), F), a, n)(i)) ≠
        Ring.zero(Algebra.ring(E))
      intros i hi
      rw (linearFactorFamily.value at subringRing(Algebra.ring(E), F), a, n, i with commF,
        aF, hi)
      have ai := FunctionBetween.apply_closed with aF, hi
      have xIn := polyX.mem at subringRing(Algebra.ring(E), F) with commF, polysF
      have cIn := polyC.mem at subringRing(Algebra.ring(E), F), a(i) with commF, polysF, ai
      unfold polyXSubC
      unfold polyEval2
      rw (RingHom.map_sub with evalHom, xIn, cIn)
      have eX := polyEval2.X at subringRing(Algebra.ring(E), F), Algebra.ring(E),
        identity(F), y with commF, polysF, ringL, incl, yL
      have eC := polyEval2.C at subringRing(Algebra.ring(E), F), Algebra.ring(E),
        identity(F), y, a(i) with commF, polysF, ringL, incl, yL, ai
      unfold polyEval2 at eX
      unfold polyEval2 at eC
      rw [eX, eC]
      rw subringRing.carrierOf at ai
      rw (identity.apply at a(i), F with ai)
      intro z
      have bounded := tkJ.intermediate_bounded with intermediate
      have aiL := bounded with a(i), ai
      unfold algebraCarrier at aiL
      have back : y = (y - a(i)) + a(i) by ring
      rw z at back
      have zz : Ring.zero(Algebra.ring(E)) + a(i) = a(i) by ring
      rw zz at back
      rw back at notIn
      exact notIn with ai
    have ne := tkJ.gal_prod_eval2_ne at subringRing(Algebra.ring(E), F),
      Algebra.ring(E), identity(F), y, n with commF, domainL, incl, yL
    have contra := ne with linearFactorFamily(subringRing(Algebra.ring(E), F), a, n), wf,
      vals
    exact contra with value

-- Transitivity of algebraicity in K ≤ F ≤ L (Algebra.IsAlgebraic.trans,
-- Algebra.IsAlgebraic.tower_top).
theorem AlgebraicExtension.trans (F : Set)
  requires intermediate : IntermediateField(E, F)
  requires lower : AlgebraicExtension(subextension(E, F))
  requires upper : AlgebraicExtension(overExtension(E, F))
  shows AlgebraicExtension(E)
proof
  have ext2 := extension
  obtain ⟨algebra, baseField, ringField⟩ := ext2
  have baseParts := Field.parts with baseField
  have nt := IsField.nontrivial with baseParts
  obtain ⟨_, _, nontrivial⟩ := nt
  have subAlg := tkJ.subextension_algebra with intermediate
  have overAlg := tkJ.overExtension_algebra with intermediate
  have fields := IntermediateField.subextension_field with extension, intermediate
  obtain ⟨subField, overField⟩ := fields
  obtain ⟨_, overBaseField, _⟩ := overField
  obtain ⟨_, lowerAlg⟩ := lower
  obtain ⟨_, lowerAll⟩ := lowerAlg
  obtain ⟨_, upperAlg⟩ := upper
  obtain ⟨_, upperAll⟩ := upperAlg
  have subBaseField : Field(Algebra.base(subextension(E, F)))
    rw tkJ.sub_base
    exact baseField
  have integralSub : IntegralAlgebra(subextension(E, F))
    unfold IntegralAlgebra
    refine ⟨subAlg, ?_⟩
    intros y yIn
    have yAlg := lowerAll with y, yIn
    exact (AlgebraicElement.iff_integral at subextension(E, F), y with subAlg,
      subBaseField).forward with yAlg
  have tower : Algebra.base(overExtension(E, F)) = Algebra.ring(subextension(E, F))
    rw [tkJ.over_base, tkJ.sub_ring]
  have composite := tkJ.compose_inclusion with intermediate
  have alg2 := algebra
  obtain ⟨shape, _⟩ := alg2
  have eta := Algebra.eta with shape
  unfold AlgebraicExtension
  refine ⟨extension, ?_⟩
  unfold AlgebraicAlgebra
  refine ⟨algebra, ?_⟩
  intros x xL
  have xOver : x ∈ algebraCarrier(overExtension(E, F))
    rw tkJ.over_carrier
    exact xL
  have xAlg := upperAll with x, xOver
  have xInt := (AlgebraicElement.iff_integral at overExtension(E, F), x with overAlg,
    overBaseField).forward with xAlg
  have result := IntegralElement.trans at subextension(E, F), overExtension(E, F), x with
    integralSub, overAlg, tower, xInt
  rw [tkJ.sub_base, tkJ.over_ring, tkJ.over_map, tkJ.sub_map, tkJ.sub_carrier,
    tkJ.over_carrier] at result
  rw composite at result
  rw ← eta at result
  exact IntegralElement.algebraic with algebra, nontrivial, result

theorem AlgebraicExtension.tower_top (F : Set)
  requires intermediate : IntermediateField(E, F)
  requires algebraic : AlgebraicExtension(E)
  shows AlgebraicExtension(overExtension(E, F)) ∧ AlgebraicExtension(subextension(E, F))
proof
  have ext2 := extension
  obtain ⟨algebra, baseField, ringField⟩ := ext2
  have comm := Algebra.base_comm_ring with algebra
  have polys := polynomialRing.comm_ring at Algebra.base(E), {0} with comm
  have ringL := Algebra.comm_ring with algebra
  have subring := tkJ.intermediate_subring with intermediate
  unfold algebraCarrier at subring
  have bundled := Subring.of_projections with subring
  have commF := subringRing.comm_ring at Algebra.ring(E), F with ringL, bundled
  have intoF := tkJ.sub_structure_hom with intermediate
  have fields := IntermediateField.subextension_field with extension, intermediate
  obtain ⟨subField, overField⟩ := fields
  have subAlg := tkJ.subextension_algebra with intermediate
  have overAlg := tkJ.overExtension_algebra with intermediate
  have alg2 := algebraic
  obtain ⟨_, algebraicAll⟩ := alg2
  obtain ⟨_, allElements⟩ := algebraicAll
  have ringParts := Field.parts with ringField
  have ntL := IsField.nontrivial with ringParts
  obtain ⟨_, _, distinctL⟩ := ntL
  have zeroF : Ring.zero(subringRing(Algebra.ring(E), F)) = Ring.zero(Algebra.ring(E))
    simp [subringRing, Ring.mk.zero]
  have oneF : Ring.one(subringRing(Algebra.ring(E), F)) = Ring.one(Algebra.ring(E))
    simp [subringRing, Ring.mk.one]
  have ntF : Ring.zero(subringRing(Algebra.ring(E), F)) ≠
      Ring.one(subringRing(Algebra.ring(E), F))
    rw [zeroF, oneF]
    exact distinctL
  constructor
  . unfold AlgebraicExtension
    refine ⟨overField, ?_⟩
    unfold AlgebraicAlgebra
    refine ⟨overAlg, ?_⟩
    intros y yOver
    have yL := yOver
    rw tkJ.over_carrier at yL
    have yAlg := allElements with y, yL
    have yInt := (AlgebraicElement.iff_integral at E, y with algebra, baseField).forward
      with yAlg
    obtain ⟨_, _, p, pMonic, root⟩ := yInt
    have pm := pMonic
    obtain ⟨pIn, _⟩ := pm
    have pUni : p ∈ uniPolys(Algebra.base(E))
      unfold uniPolys
      exact pIn
    have mapped := polyMap.monic at Algebra.base(E), subringRing(Algebra.ring(E), F),
      Algebra.map(E), p with comm, polys, commF, intoF, pMonic, ntF
    obtain ⟨qMonic, _⟩ := mapped
    have value := tkJ.over_aeval with intermediate, yL, pUni
    rw root at value
    have qMonic2 : PolyMonic(Algebra.base(overExtension(E, F)),
        polyMap(Algebra.base(E), subringRing(Algebra.ring(E), F), Algebra.map(E))(p))
      rw tkJ.over_base
      exact qMonic
    have value2 : polyAeval(overExtension(E, F), y,
        polyMap(Algebra.base(E), subringRing(Algebra.ring(E), F), Algebra.map(E))(p)) =
        Ring.zero(Algebra.ring(overExtension(E, F)))
      rw tkJ.over_ring
      exact value
    have integral : IntegralElement(overExtension(E, F), y)
      unfold IntegralElement
      exact ⟨overAlg, yOver, polyMap(Algebra.base(E), subringRing(Algebra.ring(E), F),
        Algebra.map(E))(p), qMonic2, value2⟩
    have ntBase : Ring.zero(Algebra.base(overExtension(E, F))) ≠
        Ring.one(Algebra.base(overExtension(E, F)))
      rw tkJ.over_base
      exact ntF
    exact IntegralElement.algebraic with overAlg, ntBase, integral
  . unfold AlgebraicExtension
    refine ⟨subField, ?_⟩
    unfold AlgebraicAlgebra
    refine ⟨subAlg, ?_⟩
    intros y ySub
    have yF := ySub
    rw tkJ.sub_carrier at yF
    have bounded := tkJ.intermediate_bounded with intermediate
    have yL := bounded with y, yF
    have yAlg := allElements with y, yL
    obtain ⟨_, _, p, pIn, pNonzero, root⟩ := yAlg
    have pUni : p ∈ uniPolys(Algebra.base(E))
      unfold uniPolys
      exact pIn
    have value := tkJ.sub_aeval with intermediate, yF, pUni
    rw root at value
    unfold AlgebraicElement
    refine ⟨subAlg, ySub, p, ?_, ?_, ?_⟩
    . rw tkJ.sub_base
      exact pIn
    . rw tkJ.sub_base
      exact pNonzero
    . rw [tkJ.sub_ring, zeroF]
      exact value

-- K(S) is an intermediate field containing S, the least one
-- (IntermediateField.subset_adjoin, adjoin_le_iff).
theorem fieldAdjoin.intermediate (S : Set)
  requires subset : S ⊆ algebraCarrier(E)
  shows IntermediateField(E, fieldAdjoin(E, S))
proof
  have ext2 := extension
  obtain ⟨algebra, baseField, ringField⟩ := ext2
  have bounded := tkJ.adjoin_bounded at E, S
  have top := IntermediateField.top with extension
  have whole := tkJ.intermediate_subring with top
  unfold IntermediateField
  refine ⟨extension, ?_, ?_⟩
  . unfold SubalgebraOf
    refine ⟨algebra, ?_⟩
    unfold Subalgebra
    constructor
    . unfold IsSubring
      refine ⟨bounded, _, _, _, _, _⟩
      . have zeroL := IsSubring.zero_closed with whole
        apply tkJ.adjoin_intro with zeroL
        intros F inter sF
        have sub := tkJ.intermediate_subring with inter
        exact IsSubring.zero_closed with sub
      . have oneL := IsSubring.one_closed with whole
        apply tkJ.adjoin_intro with oneL
        intros F inter sF
        have sub := tkJ.intermediate_subring with inter
        exact IsSubring.one_closed with sub
      . unfold ClosedUnary
        intros x xIn
        have xL := bounded with x, xIn
        have negL := IsSubring.neg_closed with whole
        have valueL := negL with x, xL
        apply tkJ.adjoin_intro with valueL
        intros F inter sF
        have sub := tkJ.intermediate_subring with inter
        have negF := IsSubring.neg_closed with sub
        have xF := tkJ.adjoin_in with xIn, inter, sF
        exact negF with x, xF
      . unfold ClosedBinary
        intros x xIn y yIn
        have xL := bounded with x, xIn
        have yL := bounded with y, yIn
        have addL := IsSubring.add_closed with whole
        have valueL := addL with x, xL, y, yL
        apply tkJ.adjoin_intro with valueL
        intros F inter sF
        have sub := tkJ.intermediate_subring with inter
        have addF := IsSubring.add_closed with sub
        have xF := tkJ.adjoin_in with xIn, inter, sF
        have yF := tkJ.adjoin_in with yIn, inter, sF
        exact addF with x, xF, y, yF
      . unfold ClosedBinary
        intros x xIn y yIn
        have xL := bounded with x, xIn
        have yL := bounded with y, yIn
        have mulL := IsSubring.mul_closed with whole
        have valueL := mulL with x, xL, y, yL
        apply tkJ.adjoin_intro with valueL
        intros F inter sF
        have sub := tkJ.intermediate_subring with inter
        have mulF := IsSubring.mul_closed with sub
        have xF := tkJ.adjoin_in with xIn, inter, sF
        have yF := tkJ.adjoin_in with yIn, inter, sF
        exact mulF with x, xF, y, yF
    . intros y yIn
      have imageL := functionImage.subset at Algebra.map(E),
        Ring.carrier(Algebra.base(E)), algebraCarrier(E)
      have yL := imageL with y, yIn
      apply tkJ.adjoin_intro with yL
      intros F inter sF
      have bottom := IntermediateField.bottom_subset with extension, inter
      unfold bottomField at bottom
      exact bottom with y, yIn
  . intros x xIn nonzero
    have xL := bounded with x, xIn
    unfold algebraCarrier at xL
    obtain ⟨y, yL, product⟩ := tkJ.field_inverse with ringField, xL, nonzero
    refine ⟨y, ?_, product⟩
    have yL2 : y ∈ algebraCarrier(E)
      unfold algebraCarrier
      exact yL
    apply tkJ.adjoin_intro with yL2
    intros F inter sF
    have xF := tkJ.adjoin_in with xIn, inter, sF
    exact tkJ.intermediate_inverse_mem with inter, xF, nonzero, yL2, product

theorem fieldAdjoin.subset_adjoin (S : Set)
  requires subset : S ⊆ algebraCarrier(E)
  shows S ⊆ fieldAdjoin(E, S)
proof
  intros x xS
  have xL := subset with x, xS
  apply tkJ.adjoin_intro with xL
  intros F inter sF
  exact sF with x, xS

theorem fieldAdjoin.le_iff (S F : Set)
  requires subset : S ⊆ algebraCarrier(E)
  requires intermediate : IntermediateField(E, F)
  shows fieldAdjoin(E, S) ⊆ F ↔ S ⊆ F
proof
  constructor
  . intro le
    have contains := fieldAdjoin.subset_adjoin with extension, subset
    exact Subset.transitive with contains, le
  . intro sF
    intros x xIn
    exact tkJ.adjoin_in with xIn, intermediate, sF

-- adjoin_union: K(S ∪ T) = K(S) ⊔ K(T).
theorem fieldAdjoin.union (S T : Set)
  requires first : S ⊆ algebraCarrier(E)
  requires second : T ⊆ algebraCarrier(E)
  shows fieldAdjoin(E, S ∪ T) = fieldAdjoin(E, fieldAdjoin(E, S) ∪ fieldAdjoin(E, T))
proof
  have bothBound := (Subset.union2_iff at S, T, algebraCarrier(E)).backward with
    ⟨first, second⟩
  have boundS := tkJ.adjoin_bounded at E, S
  have boundT := tkJ.adjoin_bounded at E, T
  have adjBound := (Subset.union2_iff at fieldAdjoin(E, S), fieldAdjoin(E, T),
    algebraCarrier(E)).backward with ⟨boundS, boundT⟩
  have interST := fieldAdjoin.intermediate with extension, bothBound
  have interOuter := fieldAdjoin.intermediate with extension, adjBound
  have sS := fieldAdjoin.subset_adjoin with extension, first
  have sT := fieldAdjoin.subset_adjoin with extension, second
  have sOuter := fieldAdjoin.subset_adjoin with extension, adjBound
  have sST := fieldAdjoin.subset_adjoin with extension, bothBound
  apply Subset.antisymmetric
  . have mono := union2.monotone with sS, sT
    have into := Subset.transitive with mono, sOuter
    exact (fieldAdjoin.le_iff with extension, bothBound, interOuter).backward with into
  . have left : S ⊆ fieldAdjoin(E, S ∪ T)
      intros x xS
      exact sST with x, (union2.left at x, S, T with xS)
    have right : T ⊆ fieldAdjoin(E, S ∪ T)
      intros x xT
      exact sST with x, (union2.right at x, S, T with xT)
    have leS := (fieldAdjoin.le_iff with extension, first, interST).backward with left
    have leT := (fieldAdjoin.le_iff with extension, second, interST).backward with right
    have both := (Subset.union2_iff at fieldAdjoin(E, S), fieldAdjoin(E, T),
      fieldAdjoin(E, S ∪ T)).backward with ⟨leS, leT⟩
    exact (fieldAdjoin.le_iff with extension, adjBound, interST).backward with both

-- Helpers: adjunction is monotone, and the elements adjoined by finite
-- subsets of S.
theorem tkJ.adjoin_mono (S T : Set)
  requires inclusion : S ⊆ T
  requires bounded : T ⊆ algebraCarrier(E)
  shows fieldAdjoin(E, S) ⊆ fieldAdjoin(E, T)
proof
  have sBound := Subset.transitive with inclusion, bounded
  have inter := fieldAdjoin.intermediate with extension, bounded
  have tT := fieldAdjoin.subset_adjoin with extension, bounded
  have sT := Subset.transitive with inclusion, tT
  exact (fieldAdjoin.le_iff with extension, sBound, inter).backward with sT

-- The union of two members of the family in one adjunction by a finite set.
theorem tkJ.finite_adjoin_pair (S T1 T2 y z : Set)
  requires subset : S ⊆ algebraCarrier(E)
  requires first : T1 ⊆ S
  requires second : T2 ⊆ S
  requires yIn : y ∈ fieldAdjoin(E, T1)
  requires zIn : z ∈ fieldAdjoin(E, T2)
  shows T1 ∪ T2 ⊆ S ∧ y ∈ fieldAdjoin(E, T1 ∪ T2) ∧ z ∈ fieldAdjoin(E, T1 ∪ T2)
proof
  have both := (Subset.union2_iff at T1, T2, S).backward with ⟨first, second⟩
  have bounded := Subset.transitive with both, subset
  have l : T1 ⊆ T1 ∪ T2
    intros w wIn
    exact union2.left at w, T1, T2 with wIn
  have r : T2 ⊆ T1 ∪ T2
    intros w wIn
    exact union2.right at w, T1, T2 with wIn
  have m1 := tkJ.adjoin_mono with extension, l, bounded
  have m2 := tkJ.adjoin_mono with extension, r, bounded
  exact ⟨both, (m1 with y, yIn), (m2 with z, zIn)⟩

-- IntermediateField.exists_finset_of_mem_adjoin.
theorem fieldAdjoin.finite_support (S x : Set)
  requires subset : S ⊆ algebraCarrier(E)
  requires member : x ∈ fieldAdjoin(E, S)
  shows ∃ T, T ⊆ S ∧ Finite(T) ∧ x ∈ fieldAdjoin(E, T)
proof
  have ext2 := extension
  obtain ⟨algebra, baseField, ringField⟩ := ext2
  have top := IntermediateField.top with extension
  have whole := tkJ.intermediate_subring with top
  have emptyS : ∅ ⊆ S
    intros w wIn
    exfalso
    exact empty.membership at w with wIn
  have emptyL := Subset.transitive with emptyS, subset
  have emptyFin := Finite.empty
  have interEmpty := fieldAdjoin.intermediate with extension, emptyL
  have subEmpty := tkJ.intermediate_subring with interEmpty
  have wBound : tkJFiniteAdjoins(E, S) ⊆ algebraCarrier(E)
    intros y yIn
    obtain ⟨yL, _⟩ := tkJFiniteAdjoins.membership.forward with yIn
    exact yL
  have interW : IntermediateField(E, tkJFiniteAdjoins(E, S))
    unfold IntermediateField
    refine ⟨extension, ?_, ?_⟩
    . unfold SubalgebraOf
      refine ⟨algebra, ?_⟩
      unfold Subalgebra
      constructor
      . unfold IsSubring
        refine ⟨wBound, _, _, _, _, _⟩
        . have zeroL := IsSubring.zero_closed with whole
          have zeroK := IsSubring.zero_closed with subEmpty
          apply tkJFiniteAdjoins.membership.backward
          exact ⟨zeroL, ∅, emptyS, emptyFin, zeroK⟩
        . have oneL := IsSubring.one_closed with whole
          have oneK := IsSubring.one_closed with subEmpty
          apply tkJFiniteAdjoins.membership.backward
          exact ⟨oneL, ∅, emptyS, emptyFin, oneK⟩
        . unfold ClosedUnary
          intros y yIn
          obtain ⟨yL, T, TS, TFin, yT⟩ := tkJFiniteAdjoins.membership.forward with yIn
          have TL := Subset.transitive with TS, subset
          have interT := fieldAdjoin.intermediate with extension, TL
          have subT := tkJ.intermediate_subring with interT
          have negT := IsSubring.neg_closed with subT
          have negL := IsSubring.neg_closed with whole
          apply tkJFiniteAdjoins.membership.backward
          exact ⟨(negL with y, yL), T, TS, TFin, (negT with y, yT)⟩
        . unfold ClosedBinary
          intros y yIn z zIn
          obtain ⟨yL, T1, T1S, T1Fin, yT⟩ := tkJFiniteAdjoins.membership.forward with yIn
          obtain ⟨zL, T2, T2S, T2Fin, zT⟩ := tkJFiniteAdjoins.membership.forward with zIn
          obtain ⟨TS, yU, zU⟩ := tkJ.finite_adjoin_pair with extension, subset, T1S, T2S,
            yT, zT
          have TFin := Finite.union with T1Fin, T2Fin
          have TL := Subset.transitive with TS, subset
          have interT := fieldAdjoin.intermediate with extension, TL
          have subT := tkJ.intermediate_subring with interT
          have addT := IsSubring.add_closed with subT
          have addL := IsSubring.add_closed with whole
          apply tkJFiniteAdjoins.membership.backward
          exact ⟨(addL with y, yL, z, zL), T1 ∪ T2, TS, TFin, (addT with y, yU, z, zU)⟩
        . unfold ClosedBinary
          intros y yIn z zIn
          obtain ⟨yL, T1, T1S, T1Fin, yT⟩ := tkJFiniteAdjoins.membership.forward with yIn
          obtain ⟨zL, T2, T2S, T2Fin, zT⟩ := tkJFiniteAdjoins.membership.forward with zIn
          obtain ⟨TS, yU, zU⟩ := tkJ.finite_adjoin_pair with extension, subset, T1S, T2S,
            yT, zT
          have TFin := Finite.union with T1Fin, T2Fin
          have TL := Subset.transitive with TS, subset
          have interT := fieldAdjoin.intermediate with extension, TL
          have subT := tkJ.intermediate_subring with interT
          have mulT := IsSubring.mul_closed with subT
          have mulL := IsSubring.mul_closed with whole
          apply tkJFiniteAdjoins.membership.backward
          exact ⟨(mulL with y, yL, z, zL), T1 ∪ T2, TS, TFin, (mulT with y, yU, z, zU)⟩
      . intros y yIn
        have bottom := IntermediateField.bottom_subset with extension, interEmpty
        have imageL := functionImage.subset at Algebra.map(E),
          Ring.carrier(Algebra.base(E)), algebraCarrier(E)
        have yB : y ∈ bottomField(E)
          unfold bottomField
          exact yIn
        apply tkJFiniteAdjoins.membership.backward
        exact ⟨(imageL with y, yIn), ∅, emptyS, emptyFin, (bottom with y, yB)⟩
    . intros y yIn nonzero
      obtain ⟨yL, T, TS, TFin, yT⟩ := tkJFiniteAdjoins.membership.forward with yIn
      have TL := Subset.transitive with TS, subset
      have interT := fieldAdjoin.intermediate with extension, TL
      have interT2 := interT
      obtain ⟨_, _, inverses⟩ := interT2
      obtain ⟨z, zT, product⟩ := inverses with y, yT, nonzero
      have zL := tkJ.adjoin_bounded at E, T
      have zW : z ∈ tkJFiniteAdjoins(E, S)
        apply tkJFiniteAdjoins.membership.backward
        exact ⟨(zL with z, zT), T, TS, TFin, zT⟩
      exact ⟨z, zW, product⟩
  have sW : S ⊆ tkJFiniteAdjoins(E, S)
    intros y yS
    have single : {y} ⊆ S
      intros w wIn
      rw singleton.membership at wIn
      rw wIn
      exact yS
    have singleL := Subset.transitive with single, subset
    have sy := fieldAdjoin.subset_adjoin with extension, singleL
    have yy : y ∈ {y} by simp [singleton.membership]
    apply tkJFiniteAdjoins.membership.backward
    exact ⟨(subset with y, yS), {y}, single, (Finite.singleton at y), (sy with y, yy)⟩
  have le := (fieldAdjoin.le_iff with extension, subset, interW).backward with sW
  have xW := le with x, member
  obtain ⟨_, T, TS, TFin, xT⟩ := tkJFiniteAdjoins.membership.forward with xW
  exact ⟨T, TS, TFin, xT⟩

-- For algebraic S the adjoined field is the adjoined algebra
-- (IntermediateField.adjoin_algebraic_toSubalgebra, adjoin_toSubalgebra).
theorem fieldAdjoin.eq_algebra_adjoin (S : Set)
  requires subset : S ⊆ algebraCarrier(E)
  requires algebraic : ∀ x ∈ S, IntegralElement(E, x)
  shows fieldAdjoin(E, S) = adjoinOf(E, S)
proof
  have ext2 := extension
  obtain ⟨algebra, baseField, ringField⟩ := ext2
  have both := adjoinOf.subalgebra at E, S with algebra, subset
  obtain ⟨subAdj, sAdj⟩ := both
  have closure := integralClosure.subalgebra at E with algebra
  have sClosure : S ⊆ integralClosure(E)
    intros y yS
    exact (intHelp.closure_mem at E, y).backward with (algebraic with y, yS)
  have adjClosure := (adjoinOf.least at E, S, integralClosure(E) with algebra, subset,
    closure).backward with sClosure
  have adjBound : adjoinOf(E, S) ⊆ algebraCarrier(E)
    intros y yIn
    have yC := adjClosure with y, yIn
    have yI := (intHelp.closure_mem at E, y).forward with yC
    obtain ⟨_, yL, _⟩ := yI
    exact yL
  have interAdj : IntermediateField(E, adjoinOf(E, S))
    unfold IntermediateField
    refine ⟨extension, subAdj, ?_⟩
    intros y yIn nonzero
    have yL := adjBound with y, yIn
    have yC := adjClosure with y, yIn
    have yI := (intHelp.closure_mem at E, y).forward with yC
    have yL2 := yL
    unfold algebraCarrier at yL2
    obtain ⟨z, zL, product⟩ := tkJ.field_inverse with ringField, yL2, nonzero
    have zL2 : z ∈ algebraCarrier(E)
      unfold algebraCarrier
      exact zL
    have zSingle := IntegralElement.inverse_mem_adjoin at E, y, z with algebra, baseField,
      yI, product, zL2
    have single : {y} ⊆ adjoinOf(E, S)
      intros w wIn
      rw singleton.membership at wIn
      rw wIn
      exact yIn
    have yBound : {y} ⊆ algebraCarrier(E)
      intros w wIn
      rw singleton.membership at wIn
      rw wIn
      exact yL
    have le := (adjoinOf.least at E, {y}, adjoinOf(E, S) with algebra, yBound,
      subAdj).backward with single
    exact ⟨z, (le with z, zSingle), product⟩
  have interField := fieldAdjoin.intermediate with extension, subset
  obtain ⟨_, subField, _⟩ := interField
  have sField := fieldAdjoin.subset_adjoin with extension, subset
  apply Subset.antisymmetric
  . exact (fieldAdjoin.le_iff with extension, subset, interAdj).backward with sAdj
  . exact (adjoinOf.least at E, S, fieldAdjoin(E, S) with algebra, subset,
      subField).backward with sField

-- Helpers for simple extensions: the value of a monomial, the powers of
-- x as a family, and a polynomial with prescribed coefficients below n,
-- whose value at x is the combination of the powers with those
-- coefficients.
theorem tkJ.aeval_zero (x : Set)
  requires point : x ∈ algebraCarrier(E)
  shows polyAeval(E, x, Ring.zero(polynomialRing(Algebra.base(E), {0}))) =
    Ring.zero(Algebra.ring(E))
proof
  have ext2 := extension
  obtain ⟨algebra, _, _⟩ := ext2
  have hom := tkJ.gal_aeval_hom with algebra, point
  unfold polyAeval
  unfold polyEval2
  exact RingHom.map_zero with hom

theorem tkJ.aeval_monomial (x a : Set) (n : Nat)
  requires point : x ∈ algebraCarrier(E)
  requires scalar : a ∈ Ring.carrier(Algebra.base(E))
  shows polyAeval(E, x, polyMonomial(Algebra.base(E), a, n)) =
    call2(Ring.mul(Algebra.ring(E)), Algebra.map(E)(a), Ring.pow(Algebra.ring(E), x, n))
proof
  have ext2 := extension
  obtain ⟨algebra, _, _⟩ := ext2
  have base := Algebra.base_comm_ring with algebra
  have polysK := polynomialRing.comm_ring at Algebra.base(E), {0} with base
  have ringA := Algebra.comm_ring with algebra
  have hom := tkJ.gal_aeval_hom with algebra, point
  have cIn := polyC.mem at Algebra.base(E), a with base, polysK, scalar
  have xIn := polyX.mem at Algebra.base(E) with base, polysK
  have cU : polyC(Algebra.base(E), a) ∈ uniPolys(Algebra.base(E))
    unfold uniPolys
    exact cIn
  have xpU : Ring.pow(polynomialRing(Algebra.base(E), {0}), polyX(Algebra.base(E)), n) ∈
      uniPolys(Algebra.base(E))
    unfold uniPolys
    typecheck
  unfold polyMonomial
  rw (tkJ.gal_aeval_mul with algebra, point, cU, xpU)
  rw (polyAeval.C at E, x, a with algebra, point, scalar)
  have pw : polyAeval(E, x, Ring.pow(polynomialRing(Algebra.base(E), {0}),
      polyX(Algebra.base(E)), n)) = Ring.pow(Algebra.ring(E), x, n)
    have px := polyAeval.X at E, x with algebra, point
    unfold polyAeval at px
    unfold polyEval2 at px
    unfold polyAeval
    unfold polyEval2
    rw (RingHom.map_pow at polynomialRing(Algebra.base(E), {0}), Algebra.ring(E),
      evaluationHom(Algebra.base(E), Algebra.ring(E), {0}, Algebra.map(E),
        constantFunction({0}, Ring.carrier(Algebra.ring(E)), x)), polyX(Algebra.base(E)), n
      with polysK, ringA, hom)
    rw px
  rw pw

defgraph tkJPowers (x : Set) (i ∈ ℕ) : algebraCarrier(E) :=
    Ring.pow(Algebra.ring(E), x, i)
requires point : x ∈ algebraCarrier(E)
proof
  have ext2 := extension
  obtain ⟨algebra, _, _⟩ := ext2
  have comm := Algebra.comm_ring with algebra
  have ring := CommRing.to_ring with comm
  have iNat := nat.omega.backward with member
  unfold algebraCarrier at point
  unfold algebraCarrier
  typecheck

theorem tkJ.power_poly (x : Set) (n : Nat)
  requires point : x ∈ algebraCarrier(E)
  shows ∀ c, (c : n → Ring.carrier(Algebra.base(E))) →
    ∃ p ∈ uniPolys(Algebra.base(E)), (∀ i ∈ n, polyCoeff(p, i) = c(i)) ∧
      (∀ k ∈ ℕ, n ≤ k → polyCoeff(p, k) = Ring.zero(Algebra.base(E))) ∧
      polyAeval(E, x, p) = moduleCombination(algebraModule(E), Algebra.base(E), n, c,
        restrict(tkJPowers(E, x), n))
proof
  have ext2 := extension
  obtain ⟨algebra, _, _⟩ := ext2
  have commK := Algebra.base_comm_ring with algebra
  have ringK := CommRing.to_ring with commK
  have polysK := polynomialRing.comm_ring at Algebra.base(E), {0} with commK
  have moduleV := algebraModule.module_of with algebra
  have carrierV := algebraModule.carrier_eq at E
  have powF := tkJPowers.function at E, x with extension, point
  have powV : tkJPowers(E, x) : ℕ → Module.carrier(algebraModule(E))
    rw carrierV
    exact powF
  induction n
  | zero =>
    intros c cF
    have zIn : Ring.zero(polynomialRing(Algebra.base(E), {0})) ∈ uniPolys(Algebra.base(E))
      unfold uniPolys
      typecheck
    refine ⟨Ring.zero(polynomialRing(Algebra.base(E), {0})), zIn, ?_, ?_, ?_⟩
    . intros i hi
      exfalso
      rw nat.zero at hi
      exact empty.membership at i with hi
    . intros k hk le
      have kNat := nat.omega.backward with hk
      exact uni.zero_coeff at Algebra.base(E), k with commK, polysK
    . rw (tkJ.aeval_zero at E, x with extension, point)
      have zSub : 0 ⊆ ℕ
        intros i hi
        exfalso
        rw nat.zero at hi
        exact empty.membership at i with hi
      have rF := restrict.domain_function at tkJPowers(E, x), ℕ,
        Module.carrier(algebraModule(E)), 0 with powV, zSub
      have tF := combinationTerms.function at algebraModule(E), Algebra.base(E), 0, c,
        restrict(tkJPowers(E, x), 0) with moduleV, cF, rF
      rw nat.zero at tF
      have e := moduleSum.empty_of at Algebra.base(E), algebraModule(E),
        combinationTerms(algebraModule(E), Algebra.base(E), ∅, c, restrict(tkJPowers(E, x), ∅))
        with ringK, moduleV, tF
      rw (tkJ.alg_module_zero at E) at e
      unfold moduleCombination
      rw nat.zero
      symm
      exact e
  | succ(m) using ih =>
    intros c cF
    have mN : m ∈ ℕ by typecheck
    have asInsert := natural.successor_as_insert at m
    have unfolded : insert(m, m) = {m} ∪ m
      unfold insert
      rfl
    have succEq : succ(m) = m ∪ {m}
      rw [asInsert, unfolded]
      exact union2.commutative
    have mIn : m ∈ succ(m)
      rw succEq
      exact union2.right at m, m, {m} with (singleton.self at m)
    have mSub : m ⊆ succ(m)
      intros i hi
      rw succEq
      exact union2.left at i, m, {m} with hi
    have succSub : succ(m) ⊆ ℕ
      intros i hi
      have iNat := natural.member at succ(m) with hi
      exact nat.omega.forward with iNat
    have cmF := restrict.domain_function at c, succ(m), Ring.carrier(Algebra.base(E)), m with
      cF, mSub
    obtain ⟨p, pU, coeffs, vanish, val⟩ := ih with restrict(c, m), cmF
    have cm := FunctionBetween.apply_closed with cF, mIn
    have pIn := pU
    unfold uniPolys at pIn
    have monoIn := rmEUni.monomial_mem at Algebra.base(E), c(m), m with commK, polysK, cm
    have qU : call2(Ring.add(polynomialRing(Algebra.base(E), {0})), p,
        polyMonomial(Algebra.base(E), c(m), m)) ∈ uniPolys(Algebra.base(E))
      unfold uniPolys
      typecheck
    have monoU : polyMonomial(Algebra.base(E), c(m), m) ∈ uniPolys(Algebra.base(E))
      unfold uniPolys
      exact monoIn
    refine ⟨call2(Ring.add(polynomialRing(Algebra.base(E), {0})), p,
      polyMonomial(Algebra.base(E), c(m), m)), qU, ?_, ?_, ?_⟩
    . intros i hi
      have iNat := natural.member at succ(m) with hi
      rw (polyCoeff.add at Algebra.base(E), p, polyMonomial(Algebra.base(E), c(m), m), i with
        commK, polysK, pIn, monoIn)
      by_cases im : i = m
      . rw im
        have le : m ≤ m by arith
        rw (vanish with m, mN, le)
        rw ((polyMonomial.coeff at Algebra.base(E), c(m), m, m with commK, polysK, cm).left
          with rfl)
        ring
      . have iM : i ∈ m
          rw succEq at hi
          rw union2.membership at hi
          cases hi with inM | inS
          . exact inM
          . exfalso
            rw singleton.membership at inS
            exact im with inS
        rw (coeffs with i, iM)
        rw (restrict.domain_apply at c, succ(m), Ring.carrier(Algebra.base(E)), m, i with cF,
          mSub, iM)
        rw ((polyMonomial.coeff at Algebra.base(E), c(m), m, i with commK, polysK, cm).right
          with im)
        have ci := FunctionBetween.apply_closed with cF, hi
        ring
    . intros k hk le
      have kNat := nat.omega.backward with hk
      have le2 : m ≤ k by arith
      have ne : k ≠ m by arith
      rw (polyCoeff.add at Algebra.base(E), p, polyMonomial(Algebra.base(E), c(m), m), k with
        commK, polysK, pIn, monoIn)
      rw (vanish with k, hk, le2)
      rw ((polyMonomial.coeff at Algebra.base(E), c(m), m, k with commK, polysK, cm).right
        with ne)
      ring
    . rw (tkJ.gal_aeval_add with algebra, point, pU, monoU)
      rw val
      rw (tkJ.aeval_monomial at E, x, c(m), m with extension, point, cm)
      have mNatSub : m ⊆ ℕ
        intros i hi
        have iNat := natural.member at m with hi
        exact nat.omega.forward with iNat
      have finM := Finite.natural at m
      have fresh := membership.irreflexive at m
      have rS := restrict.domain_function at tkJPowers(E, x), ℕ,
        Module.carrier(algebraModule(E)), succ(m) with powV, succSub
      have tS := combinationTerms.function at algebraModule(E), Algebra.base(E), succ(m), c,
        restrict(tkJPowers(E, x), succ(m)) with moduleV, cF, rS
      have rM := restrict.domain_function at tkJPowers(E, x), ℕ,
        Module.carrier(algebraModule(E)), m with powV, mNatSub
      have tM := combinationTerms.function at algebraModule(E), Algebra.base(E), m,
        restrict(c, m), restrict(tkJPowers(E, x), m) with moduleV, cmF, rM
      have tS2 : combinationTerms(algebraModule(E), Algebra.base(E), succ(m), c,
          restrict(tkJPowers(E, x), succ(m))) : m ∪ {m} → Module.carrier(algebraModule(E))
        rw ← succEq
        exact tS
      have ins := moduleSum.insert_of at Algebra.base(E), algebraModule(E), m,
        combinationTerms(algebraModule(E), Algebra.base(E), succ(m), c,
          restrict(tkJPowers(E, x), succ(m))), m with ringK, moduleV, finM, fresh, tS2
      rw ← succEq at ins
      have wR := restrict.domain_function at combinationTerms(algebraModule(E),
        Algebra.base(E), succ(m), c, restrict(tkJPowers(E, x), succ(m))), succ(m),
        Module.carrier(algebraModule(E)), m with tS, mSub
      have restrictEq : restrict(combinationTerms(algebraModule(E), Algebra.base(E), succ(m),
          c, restrict(tkJPowers(E, x), succ(m))), m) = combinationTerms(algebraModule(E),
          Algebra.base(E), m, restrict(c, m), restrict(tkJPowers(E, x), m))
        apply FunctionBetween.ext with wR, tM
        intros i hi
        have iS := mSub with i, hi
        have iN := mNatSub with i, hi
        rw (restrict.domain_apply at combinationTerms(algebraModule(E), Algebra.base(E),
          succ(m), c, restrict(tkJPowers(E, x), succ(m))), succ(m),
          Module.carrier(algebraModule(E)), m, i with tS, mSub, hi)
        rw (combinationTerms.value at algebraModule(E), Algebra.base(E), succ(m), c,
          restrict(tkJPowers(E, x), succ(m)), i with moduleV, cF, rS, iS)
        rw (combinationTerms.value at algebraModule(E), Algebra.base(E), m, restrict(c, m),
          restrict(tkJPowers(E, x), m), i with moduleV, cmF, rM, hi)
        rw (restrict.domain_apply at c, succ(m), Ring.carrier(Algebra.base(E)), m, i with cF,
          mSub, hi)
        rw (restrict.domain_apply at tkJPowers(E, x), ℕ, Module.carrier(algebraModule(E)),
          succ(m), i with powV, succSub, iS)
        rw (restrict.domain_apply at tkJPowers(E, x), ℕ, Module.carrier(algebraModule(E)),
          m, i with powV, mNatSub, hi)
      have powL := FunctionBetween.apply_closed with powF, mN
      have lastEq : combinationTerms(algebraModule(E), Algebra.base(E), succ(m), c,
          restrict(tkJPowers(E, x), succ(m)))(m) = call2(Ring.mul(Algebra.ring(E)),
          Algebra.map(E)(c(m)), Ring.pow(Algebra.ring(E), x, m))
        rw (combinationTerms.value at algebraModule(E), Algebra.base(E), succ(m), c,
          restrict(tkJPowers(E, x), succ(m)), m with moduleV, cF, rS, mIn)
        rw (restrict.domain_apply at tkJPowers(E, x), ℕ, Module.carrier(algebraModule(E)),
          succ(m), m with powV, succSub, mIn)
        rw (algebraModule.smul_value with algebra, cm, powL)
        rw (tkJPowers.value at E, x, m with extension, point, mN)
      unfold moduleCombination
      rw [ins, restrictEq, lastEq, algebraModule.add_eq]

-- The join of two finite intermediate fields is finite
-- (IntermediateField.finiteDimensional_sup), and K(S) for finite S of
-- integral elements is finite (IntermediateField.finiteDimensional_adjoin).
theorem fieldAdjoin.finite_of_finite (S : Set)
  requires subset : S ⊆ algebraCarrier(E)
  requires finite : Finite(S)
  requires integral : ∀ x ∈ S, IntegralElement(E, x)
  shows FiniteExtension(subextension(E, fieldAdjoin(E, S)))
proof
  sorry

theorem IntermediateField.sup_finite (F G : Set)
  requires first : IntermediateField(E, F)
  requires second : IntermediateField(E, G)
  requires firstFinite : FiniteExtension(subextension(E, F))
  requires secondFinite : FiniteExtension(subextension(E, G))
  shows FiniteExtension(subextension(E, fieldAdjoin(E, F ∪ G)))
proof
  sorry

-- The primitive element theorem (Field.exists_primitive_element,
-- Field.powerBasisOfFiniteOfSeparable).
theorem FiniteExtension.primitive_element
  requires finite : FiniteExtension(E)
  requires separable : SeparableExtension(E)
  shows ∃ x ∈ algebraCarrier(E), fieldAdjoin(E, {x}) = algebraCarrier(E)
proof
  sorry

-- Helpers for |Gal(L/K)| ≤ [L : K]: Dedekind's independence of the
-- automorphisms, phrased with the sums Σ_{σ ∈ H} c(σ) σ(y).
defgraph tkJCharTerms (H c y : Set) (σ ∈ H) : Ring.carrier(Algebra.ring(E)) :=
    call2(Ring.mul(Algebra.ring(E)), c(σ), σ(y))
requires auts : H ⊆ algebraAutomorphisms(E)
requires coeffs : c : H → Ring.carrier(Algebra.ring(E))
requires point : y ∈ algebraCarrier(E)
proof
  have ext2 := extension
  obtain ⟨algebra, _, _⟩ := ext2
  have comm := Algebra.comm_ring with algebra
  have ring := CommRing.to_ring with comm
  have σA := auts with σ, member
  have fσ := tkJ.aut_function with σA
  have σy := FunctionBetween.apply_closed with fσ, point
  unfold algebraCarrier at σy
  have cσ := FunctionBetween.apply_closed with coeffs, member
  exact Ring.mul_mem at Algebra.ring(E), c(σ), σ(y) with ring, cσ, σy

theorem tkJ.char_terms_restrict (G a c y : Set)
  requires auts : G ∪ {a} ⊆ algebraAutomorphisms(E)
  requires coeffs : c : G ∪ {a} → Ring.carrier(Algebra.ring(E))
  requires point : y ∈ algebraCarrier(E)
  shows restrict(tkJCharTerms(E, G ∪ {a}, c, y), G) =
    tkJCharTerms(E, G, restrict(c, G), y)
proof
  have sub : G ⊆ G ∪ {a}
    intros σ hσ
    exact union2.left at σ, G, {a} with hσ
  have autsG := Subset.transitive with sub, auts
  have cG := restrict.domain_function at c, G ∪ {a}, Ring.carrier(Algebra.ring(E)), G with
    coeffs, sub
  have tF := tkJCharTerms.function at E, G ∪ {a}, c, y with extension, auts, coeffs, point
  have tR := restrict.domain_function at tkJCharTerms(E, G ∪ {a}, c, y), G ∪ {a},
    Ring.carrier(Algebra.ring(E)), G with tF, sub
  have tG := tkJCharTerms.function at E, G, restrict(c, G), y with extension, autsG, cG, point
  apply FunctionBetween.ext with tR, tG
  intros σ hσ
  have σS := sub with σ, hσ
  rw (restrict.domain_apply at tkJCharTerms(E, G ∪ {a}, c, y), G ∪ {a},
    Ring.carrier(Algebra.ring(E)), G, σ with tF, sub, hσ)
  rw (tkJCharTerms.value at E, G ∪ {a}, c, y, σ with extension, auts, coeffs, point, σS)
  rw (tkJCharTerms.value at E, G, restrict(c, G), y, σ with extension, autsG, cG, point, hσ)
  rw (restrict.domain_apply at c, G ∪ {a}, Ring.carrier(Algebra.ring(E)), G, σ with coeffs,
    sub, hσ)

defgraph tkJDedCoeff (G c a z : Set) (σ ∈ G) : Ring.carrier(Algebra.ring(E)) :=
    call2(Ring.mul(Algebra.ring(E)), c(σ), call2(Ring.add(Algebra.ring(E)), σ(z),
      Ring.neg(Algebra.ring(E))(a(z))))
requires auts : G ⊆ algebraAutomorphisms(E)
requires coeffs : c : G → Ring.carrier(Algebra.ring(E))
requires other : a ∈ algebraAutomorphisms(E)
requires point : z ∈ algebraCarrier(E)
proof
  have ext2 := extension
  obtain ⟨algebra, _, _⟩ := ext2
  have comm := Algebra.comm_ring with algebra
  have ring := CommRing.to_ring with comm
  have σA := auts with σ, member
  have fσ := tkJ.aut_function with σA
  have σz := FunctionBetween.apply_closed with fσ, point
  unfold algebraCarrier at σz
  have fa := tkJ.aut_function with other
  have az := FunctionBetween.apply_closed with fa, point
  unfold algebraCarrier at az
  have cσ := FunctionBetween.apply_closed with coeffs, member
  typecheck

theorem tkJ.dedekind (H : Set)
  requires finite : Finite(H)
  shows H ⊆ algebraAutomorphisms(E) → ∀ c, (c : H → Ring.carrier(Algebra.ring(E))) →
    (∀ y ∈ algebraCarrier(E), moduleSum(selfModule(Algebra.ring(E)), H,
      tkJCharTerms(E, H, c, y)) = Ring.zero(Algebra.ring(E))) →
    ∀ σ ∈ H, c(σ) = Ring.zero(Algebra.ring(E))
proof
  induction finite with G a
  | empty =>
    intros auts c cF vanish σ hσ
    exfalso
    exact empty.membership with σ, hσ
  | insert using ih =>
    intros auts c cF vanish
    have ext2 := extension
    obtain ⟨algebra, _, ringField⟩ := ext2
    have comm := Algebra.comm_ring with algebra
    have ringL := CommRing.to_ring with comm
    have self := Ring.to_module at Algebra.ring(E) with ringL
    have selfCarrier := selfModule.carrier_eq at Algebra.ring(E)
    have sub : G ⊆ G ∪ {a}
      intros σ hσ
      exact union2.left at σ, G, {a} with hσ
    have aIn := union2.right at a, G, {a} with (singleton.self at a)
    have autsG := Subset.transitive with sub, auts
    have aA := auts with a, aIn
    have isoA := (tkJ.aut_member at E, a).forward with aA
    obtain ⟨homA, _⟩ := isoA
    have rhA := AlgebraHom.ring_hom with homA
    have fa := tkJ.aut_function with aA
    have cG := restrict.domain_function at c, G ∪ {a}, Ring.carrier(Algebra.ring(E)), G with
      cF, sub
    have ca := FunctionBetween.apply_closed with cF, aIn
    have termsSelf : ∀ d, (d : G → Ring.carrier(Algebra.ring(E))) → ∀ y ∈ algebraCarrier(E),
        tkJCharTerms(E, G, d, y) : G → Module.carrier(selfModule(Algebra.ring(E)))
      intros d dF y yL
      have tF := tkJCharTerms.function at E, G, d, y with extension, autsG, dF, yL
      rw selfCarrier
      exact tF
    have star : ∀ y ∈ algebraCarrier(E), call2(Ring.add(Algebra.ring(E)),
        moduleSum(selfModule(Algebra.ring(E)), G, tkJCharTerms(E, G, restrict(c, G), y)),
        call2(Ring.mul(Algebra.ring(E)), c(a), a(y))) = Ring.zero(Algebra.ring(E))
      intros y yL
      have v := vanish with y, yL
      have tF := tkJCharTerms.function at E, G ∪ {a}, c, y with extension, auts, cF, yL
      have tS : tkJCharTerms(E, G ∪ {a}, c, y) : G ∪ {a} →
          Module.carrier(selfModule(Algebra.ring(E)))
        rw selfCarrier
        exact tF
      have ins := moduleSum.insert_of at Algebra.ring(E), selfModule(Algebra.ring(E)), G,
        tkJCharTerms(E, G ∪ {a}, c, y), a with ringL, self, GFinite, aFresh, tS
      rw [ins, (tkJ.char_terms_restrict at E, G, a, c, y with extension, auts, cF, yL),
        (tkJCharTerms.value at E, G ∪ {a}, c, y, a with extension, auts, cF, yL, aIn),
        selfModule.add_eq] at v
      exact v
    have allG : ∀ s ∈ G, c(s) = Ring.zero(Algebra.ring(E))
      intros s sG
      have sA := autsG with s, sG
      have isoS := (tkJ.aut_member at E, s).forward with sA
      obtain ⟨homS, _⟩ := isoS
      have rhS := AlgebraHom.ring_hom with homS
      have fs := tkJ.aut_function with sA
      have ne : s ≠ a
        intro same
        rw same at sG
        exact aFresh with sG
      have exists : ∃ z ∈ algebraCarrier(E), s(z) ≠ a(z)
        by_contra none
        have agree : ∀ x ∈ algebraCarrier(E), s(x) = a(x)
          intros x xL
          by_contra differ
          exact none with ⟨x, xL, differ⟩
        exact ne with (galoisGroup.ext with extension, sA, aA, agree)
      obtain ⟨z, zL, differ⟩ := exists
      have dF := tkJDedCoeff.function at E, G, restrict(c, G), a, z with extension, autsG, cG,
        aA, zL
      have az := FunctionBetween.apply_closed with fa, zL
      have azR := az
      unfold algebraCarrier at azR
      have dVanish : ∀ y ∈ algebraCarrier(E), moduleSum(selfModule(Algebra.ring(E)), G,
          tkJCharTerms(E, G, tkJDedCoeff(E, G, restrict(c, G), a, z), y)) =
          Ring.zero(Algebra.ring(E))
        intros y yL
        have zR := zL
        unfold algebraCarrier at zR
        have yR := yL
        unfold algebraCarrier at yR
        have zyR : call2(Ring.mul(Algebra.ring(E)), z, y) ∈ Ring.carrier(Algebra.ring(E))
          by typecheck
        have zyL : call2(Ring.mul(Algebra.ring(E)), z, y) ∈ algebraCarrier(E)
          unfold algebraCarrier
          exact zyR
        have s1 := star with call2(Ring.mul(Algebra.ring(E)), z, y), zyL
        have s2 := star with y, yL
        rw (RingHom.map_mul at a, Algebra.ring(E), Algebra.ring(E), z, y with rhA, zR, yR) at s1
        have negIn : Ring.neg(Algebra.ring(E))(a(z)) ∈ Ring.carrier(Algebra.ring(E))
          by typecheck
        have t1 := termsSelf with restrict(c, G), cG, call2(Ring.mul(Algebra.ring(E)), z, y),
          zyL
        have t2 := termsSelf with restrict(c, G), cG, y, yL
        have t1S := functionSpace.mem_iff.backward with t1
        have t2S := functionSpace.mem_iff.backward with t2
        have psS := pointwiseSmul.space at Algebra.ring(E), G, selfModule(Algebra.ring(E)),
          Ring.neg(Algebra.ring(E))(a(z)), tkJCharTerms(E, G, restrict(c, G), y) with self,
          negIn, t2S
        have psF := functionSpace.mem_iff.forward with psS
        have pS := pointwiseSum.space at Algebra.ring(E), G, selfModule(Algebra.ring(E)),
          tkJCharTerms(E, G, restrict(c, G), call2(Ring.mul(Algebra.ring(E)), z, y)),
          pointwiseSmul(G, selfModule(Algebra.ring(E)), Ring.neg(Algebra.ring(E))(a(z)),
            tkJCharTerms(E, G, restrict(c, G), y)) with self, t1S, psS
        have pF := functionSpace.mem_iff.forward with pS
        have A := moduleSum.add_of at Algebra.ring(E), selfModule(Algebra.ring(E)), G,
          tkJCharTerms(E, G, restrict(c, G), call2(Ring.mul(Algebra.ring(E)), z, y)),
          pointwiseSmul(G, selfModule(Algebra.ring(E)), Ring.neg(Algebra.ring(E))(a(z)),
            tkJCharTerms(E, G, restrict(c, G), y)) with ringL, self, GFinite, t1, psF
        have B := moduleSum.smul_of at Algebra.ring(E), selfModule(Algebra.ring(E)), G,
          tkJCharTerms(E, G, restrict(c, G), y), Ring.neg(Algebra.ring(E))(a(z)) with ringL,
          self, GFinite, t2, negIn
        have tdF := termsSelf with tkJDedCoeff(E, G, restrict(c, G), a, z), dF, y, yL
        have agree : ∀ σ ∈ G, tkJCharTerms(E, G, tkJDedCoeff(E, G, restrict(c, G), a, z), y)(σ)
            = pointwiseSum(G, selfModule(Algebra.ring(E)), tkJCharTerms(E, G, restrict(c, G),
            call2(Ring.mul(Algebra.ring(E)), z, y)), pointwiseSmul(G,
            selfModule(Algebra.ring(E)), Ring.neg(Algebra.ring(E))(a(z)),
            tkJCharTerms(E, G, restrict(c, G), y)))(σ)
          intros σ hσ
          have σA := autsG with σ, hσ
          have isoσ := (tkJ.aut_member at E, σ).forward with σA
          obtain ⟨homσ, _⟩ := isoσ
          have rhσ := AlgebraHom.ring_hom with homσ
          have fσ := tkJ.aut_function with σA
          have σz := FunctionBetween.apply_closed with fσ, zL
          unfold algebraCarrier at σz
          have σy := FunctionBetween.apply_closed with fσ, yL
          unfold algebraCarrier at σy
          have cσ := FunctionBetween.apply_closed with cG, hσ
          rw (pointwiseSum.at at Algebra.ring(E), G, selfModule(Algebra.ring(E)),
            tkJCharTerms(E, G, restrict(c, G), call2(Ring.mul(Algebra.ring(E)), z, y)),
            pointwiseSmul(G, selfModule(Algebra.ring(E)), Ring.neg(Algebra.ring(E))(a(z)),
              tkJCharTerms(E, G, restrict(c, G), y)), σ with self, t1S, psS, hσ)
          rw (pointwiseSmul.at at Algebra.ring(E), G, selfModule(Algebra.ring(E)),
            Ring.neg(Algebra.ring(E))(a(z)), tkJCharTerms(E, G, restrict(c, G), y), σ with self,
            negIn, t2S, hσ)
          rw [selfModule.add_eq, selfModule.smul_eq]
          rw (tkJCharTerms.value at E, G, tkJDedCoeff(E, G, restrict(c, G), a, z), y, σ with
            extension, autsG, dF, yL, hσ)
          rw (tkJCharTerms.value at E, G, restrict(c, G), call2(Ring.mul(Algebra.ring(E)), z, y),
            σ with extension, autsG, cG, zyL, hσ)
          rw (tkJCharTerms.value at E, G, restrict(c, G), y, σ with extension, autsG, cG, yL, hσ)
          rw (tkJDedCoeff.value at E, G, restrict(c, G), a, z, σ with extension, autsG, cG, aA,
            zL, hσ)
          rw (RingHom.map_mul at σ, Algebra.ring(E), Algebra.ring(E), z, y with rhσ, zR, yR)
          ring
        have eq := moduleSum.congr at Algebra.ring(E), selfModule(Algebra.ring(E)), G,
          tkJCharTerms(E, G, tkJDedCoeff(E, G, restrict(c, G), a, z), y),
          pointwiseSum(G, selfModule(Algebra.ring(E)), tkJCharTerms(E, G, restrict(c, G),
            call2(Ring.mul(Algebra.ring(E)), z, y)), pointwiseSmul(G,
            selfModule(Algebra.ring(E)), Ring.neg(Algebra.ring(E))(a(z)),
            tkJCharTerms(E, G, restrict(c, G), y))) with ringL, self, GFinite, tdF, pF, agree
        rw [eq, ← A, ← B, selfModule.add_eq, selfModule.smul_eq]
        have S1 := moduleSum.mem_of at Algebra.ring(E), selfModule(Algebra.ring(E)), G,
          tkJCharTerms(E, G, restrict(c, G), call2(Ring.mul(Algebra.ring(E)), z, y)) with
          ringL, self, GFinite, t1
        rw selfCarrier at S1
        have S2 := moduleSum.mem_of at Algebra.ring(E), selfModule(Algebra.ring(E)), G,
          tkJCharTerms(E, G, restrict(c, G), y) with ringL, self, GFinite, t2
        rw selfCarrier at S2
        have ay := FunctionBetween.apply_closed with fa, yL
        unfold algebraCarrier at ay
        have split : call2(Ring.add(Algebra.ring(E)), moduleSum(selfModule(Algebra.ring(E)), G,
            tkJCharTerms(E, G, restrict(c, G), call2(Ring.mul(Algebra.ring(E)), z, y))),
            call2(Ring.mul(Algebra.ring(E)), Ring.neg(Algebra.ring(E))(a(z)),
            moduleSum(selfModule(Algebra.ring(E)), G, tkJCharTerms(E, G, restrict(c, G), y))))
            = call2(Ring.add(Algebra.ring(E)), call2(Ring.add(Algebra.ring(E)),
            moduleSum(selfModule(Algebra.ring(E)), G, tkJCharTerms(E, G, restrict(c, G),
            call2(Ring.mul(Algebra.ring(E)), z, y))), call2(Ring.mul(Algebra.ring(E)), c(a),
            call2(Ring.mul(Algebra.ring(E)), a(z), a(y)))), call2(Ring.mul(Algebra.ring(E)),
            Ring.neg(Algebra.ring(E))(a(z)), call2(Ring.add(Algebra.ring(E)),
            moduleSum(selfModule(Algebra.ring(E)), G, tkJCharTerms(E, G, restrict(c, G), y)),
            call2(Ring.mul(Algebra.ring(E)), c(a), a(y))))) by ring
        rw [split, s1, s2]
        ring
      have dZero := ih with autsG, tkJDedCoeff(E, G, restrict(c, G), a, z), dF, dVanish
      have ds := dZero with s, sG
      rw (tkJDedCoeff.value at E, G, restrict(c, G), a, z, s with extension, autsG, cG, aA,
        zL, sG) at ds
      rw (restrict.domain_apply at c, G ∪ {a}, Ring.carrier(Algebra.ring(E)), G, s with cF,
        sub, sG) at ds
      have sz := FunctionBetween.apply_closed with fs, zL
      unfold algebraCarrier at sz
      have cs := FunctionBetween.apply_closed with cG, sG
      rw (restrict.domain_apply at c, G ∪ {a}, Ring.carrier(Algebra.ring(E)), G, s with cF,
        sub, sG) at cs
      have diffNZ : call2(Ring.add(Algebra.ring(E)), s(z), Ring.neg(Algebra.ring(E))(a(z))) ≠
          Ring.zero(Algebra.ring(E))
        intro zero
        have back : s(z) = call2(Ring.add(Algebra.ring(E)), call2(Ring.add(Algebra.ring(E)),
            s(z), Ring.neg(Algebra.ring(E))(a(z))), a(z)) by ring
        rw zero at back
        have simp0 : call2(Ring.add(Algebra.ring(E)), Ring.zero(Algebra.ring(E)), a(z)) = a(z)
          by ring
        rw simp0 at back
        exact differ with back
      have diffIn : call2(Ring.add(Algebra.ring(E)), s(z), Ring.neg(Algebra.ring(E))(a(z))) ∈
          Ring.carrier(Algebra.ring(E)) by typecheck
      obtain ⟨w, wIn, inv⟩ := tkJ.field_inverse with ringField, diffIn, diffNZ
      have e : c(s) = call2(Ring.mul(Algebra.ring(E)), call2(Ring.mul(Algebra.ring(E)), c(s),
          call2(Ring.add(Algebra.ring(E)), s(z), Ring.neg(Algebra.ring(E))(a(z)))), w)
        have t : call2(Ring.mul(Algebra.ring(E)), call2(Ring.mul(Algebra.ring(E)), c(s),
            call2(Ring.add(Algebra.ring(E)), s(z), Ring.neg(Algebra.ring(E))(a(z)))), w) =
            call2(Ring.mul(Algebra.ring(E)), c(s), call2(Ring.mul(Algebra.ring(E)),
            call2(Ring.add(Algebra.ring(E)), s(z), Ring.neg(Algebra.ring(E))(a(z))), w)) by ring
        rw [t, inv]
        ring
      rw [e, ds]
      ring
    have oneR := Ring.one_mem at Algebra.ring(E) with ringL
    have oneL : Ring.one(Algebra.ring(E)) ∈ algebraCarrier(E)
      unfold algebraCarrier
      exact oneR
    have s1 := star with Ring.one(Algebra.ring(E)), oneL
    have zeroS := Module.zero_mem at Algebra.ring(E), selfModule(Algebra.ring(E)) with ringL,
      self
    have constF := constantFunction.function at G, Module.carrier(selfModule(Algebra.ring(E))),
      Module.zero(selfModule(Algebra.ring(E))) with zeroS
    have tS := termsSelf with restrict(c, G), cG, Ring.one(Algebra.ring(E)), oneL
    have zeroTerms : tkJCharTerms(E, G, restrict(c, G), Ring.one(Algebra.ring(E))) =
        constantFunction(G, Module.carrier(selfModule(Algebra.ring(E))),
          Module.zero(selfModule(Algebra.ring(E))))
      apply FunctionBetween.ext with tS, constF
      intros σ hσ
      rw (constantFunction.apply at G, Module.carrier(selfModule(Algebra.ring(E))), σ,
        Module.zero(selfModule(Algebra.ring(E))) with hσ, zeroS)
      rw (tkJCharTerms.value at E, G, restrict(c, G), Ring.one(Algebra.ring(E)), σ with
        extension, autsG, cG, oneL, hσ)
      rw (restrict.domain_apply at c, G ∪ {a}, Ring.carrier(Algebra.ring(E)), G, σ with cF,
        sub, hσ)
      rw (allG with σ, hσ)
      have σA := autsG with σ, hσ
      have fσ := tkJ.aut_function with σA
      have σ1 := FunctionBetween.apply_closed with fσ, oneL
      unfold algebraCarrier at σ1
      rw selfModule.zero_eq
      ring
    rw [zeroTerms, (moduleSum.zero_terms_of at Algebra.ring(E), selfModule(Algebra.ring(E)), G
      with ringL, self, GFinite), selfModule.zero_eq, (RingHom.map_one with rhA)] at s1
    have caZero : c(a) = Ring.zero(Algebra.ring(E))
      have t : c(a) = call2(Ring.add(Algebra.ring(E)), Ring.zero(Algebra.ring(E)),
          call2(Ring.mul(Algebra.ring(E)), c(a), Ring.one(Algebra.ring(E)))) by ring
      rw s1 at t
      exact t
    intros σ hσ
    rw union2.membership at hσ
    cases hσ with inG | inA
    . exact allG with σ, inG
    . rw singleton.membership at inA
      rw inA
      exact caZero

-- A finite extension has a finite Galois group (AlgEquiv.fintype), of
-- order at most the degree (AlgEquiv.card_le).
theorem FiniteExtension.galois_finite
  requires finite : FiniteExtension(E)
  shows Finite(algebraAutomorphisms(E)) ∧ order(galoisGroup(E)) ≤ extensionDegree(E)
proof
  sorry

end Intermediate

-- Helpers: the minimal polynomial is the polynomial with its defining
-- property, evaluation sends 1 to 1, and the structure map reflects zero.
theorem tkJ.gal_minpoly_eq (E x p : Set)
  requires extension : FieldExtension(E)
  requires integral : IntegralElement(E, x)
  requires member : p ∈ uniPolys(Algebra.base(E))
  requires monic : PolyMonic(Algebra.base(E), p)
  requires root : polyAeval(E, x, p) = Ring.zero(Algebra.ring(E))
  requires minimal : ∀ q ∈ uniPolys(Algebra.base(E)),
    polyAeval(E, x, q) = Ring.zero(Algebra.ring(E)) →
    RingDvd(polynomialRing(Algebra.base(E), {0}), p, q)
  shows minpoly(E, x) = p
proof
  have sel := minpoly.selected with extension, integral
  obtain ⟨mIn, mSpec⟩ := sel
  have pSpec : PolyMonic(Algebra.base(E), p) ∧
      polyAeval(E, x, p) = Ring.zero(Algebra.ring(E)) ∧
      (∀ q ∈ uniPolys(Algebra.base(E)), polyAeval(E, x, q) = Ring.zero(Algebra.ring(E)) →
        RingDvd(polynomialRing(Algebra.base(E), {0}), p, q))
    exact ⟨monic, root, minimal⟩
  have u := minpoly.unique
  exact u with E, x, extension, integral, minpoly(E, x), mIn, mSpec, p, member, pSpec

theorem tkJ.gal_aeval_one (A x : Set)
  requires algebra : Algebra(A)
  requires point : x ∈ algebraCarrier(A)
  shows polyAeval(A, x, Ring.one(polynomialRing(Algebra.base(A), {0}))) =
    Ring.one(Algebra.ring(A))
proof
  have hom := tkJ.gal_aeval_hom with algebra, point
  unfold polyAeval
  unfold polyEval2
  exact RingHom.map_one with hom

theorem tkJ.gal_map_reflects_zero (E b : Set)
  requires extension : FieldExtension(E)
  requires member : b ∈ Ring.carrier(Algebra.base(E))
  requires vanishes : Algebra.map(E)(b) = Ring.zero(Algebra.ring(E))
  shows b = Ring.zero(Algebra.base(E))
proof
  obtain ⟨algebra, baseField, ringField⟩ := extension
  have structureMap := Algebra.structure_hom with algebra
  have parts := RingHom.parts with structureMap
  have fieldParts := Field.parts with baseField
  have targetField := Field.parts with ringField
  have targetComm := IsField.comm_ring with targetField
  have nontrivial := IsField.nontrivial with targetField
  exact IsRingHom.field_reflects_zero with fieldParts, targetComm, nontrivial, parts,
    member, vanishes

-- Section: Minimal polynomials
section MinimalPolynomial
variable (E : Set)
hypothesis extension : FieldExtension(E)

-- minpoly.monic, minpoly.aeval, minpoly.ne_zero.
theorem minpoly.spec (x : Set)
  requires integral : IntegralElement(E, x)
  shows minpoly(E, x) ∈ uniPolys(Algebra.base(E)) ∧
    PolyMonic(Algebra.base(E), minpoly(E, x)) ∧
    polyAeval(E, x, minpoly(E, x)) = Ring.zero(Algebra.ring(E)) ∧
    minpoly(E, x) ≠ Ring.zero(polynomialRing(Algebra.base(E), {0}))
proof
  have ext2 := extension
  obtain ⟨algebra, baseField, ringField⟩ := ext2
  have comm := Field.to_comm_ring with baseField
  have polys := polynomialRing.comm_ring at Algebra.base(E), {0} with comm
  have baseParts := Field.parts with baseField
  have nt := IsField.nontrivial with baseParts
  obtain ⟨_, _, nontrivial⟩ := nt
  have sel := minpoly.selected with extension, integral
  obtain ⟨mIn, mMonic, mRoot, mMin⟩ := sel
  have mP := mIn
  unfold uniPolys at mP
  have nz := PolyMonic.ne_zero at Algebra.base(E), minpoly(E, x) with comm, polys, mP,
    nontrivial, mMonic
  exact ⟨mIn, mMonic, mRoot, nz⟩

-- minpoly.dvd_iff: q(x) = 0 iff minpoly(x) ∣ q.
theorem minpoly.dvd_iff (x q : Set)
  requires integral : IntegralElement(E, x)
  requires member : q ∈ uniPolys(Algebra.base(E))
  shows polyAeval(E, x, q) = Ring.zero(Algebra.ring(E)) ↔
    RingDvd(polynomialRing(Algebra.base(E), {0}), minpoly(E, x), q)
proof
  have ext2 := extension
  obtain ⟨algebra, baseField, ringField⟩ := ext2
  have ringL := Algebra.comm_ring with algebra
  have int2 := integral
  obtain ⟨_, xL, _⟩ := int2
  have sel := minpoly.selected with extension, integral
  obtain ⟨mIn, mMonic, mRoot, mMin⟩ := sel
  constructor
  . intro root
    exact mMin with q, member, root
  . intro dvd
    obtain ⟨_, _, c, cIn, qEq⟩ := dvd
    have cUni : c ∈ uniPolys(Algebra.base(E))
      unfold uniPolys
      exact cIn
    have prod := tkJ.gal_aeval_mul with algebra, xL, mIn, cUni
    rw [← qEq, mRoot] at prod
    have cL := tkJ.gal_aeval_mem with algebra, xL, cUni
    have z : Ring.zero(Algebra.ring(E)) * polyAeval(E, x, c) = Ring.zero(Algebra.ring(E))
      by ring
    rw z at prod
    exact prod

-- minpoly.irreducible.
theorem tkJ.gal_minpoly_not_unit (x : Set)
  requires integral : IntegralElement(E, x)
  shows ¬RingUnit(polynomialRing(Algebra.base(E), {0}), minpoly(E, x))
proof
  have ext2 := extension
  obtain ⟨algebra, baseField, ringField⟩ := ext2
  have ringL := Algebra.comm_ring with algebra
  have int2 := integral
  obtain ⟨_, xL, _⟩ := int2
  have sel := minpoly.selected with extension, integral
  obtain ⟨mIn, mMonic, mRoot, mMin⟩ := sel
  have ringParts := Field.parts with ringField
  have ntL := IsField.nontrivial with ringParts
  obtain ⟨_, _, distinctL⟩ := ntL
  intro unit
  obtain ⟨_, b, bIn, product, _⟩ := unit
  have bUni : b ∈ uniPolys(Algebra.base(E))
    unfold uniPolys
    exact bIn
  have ev := tkJ.gal_aeval_mul with algebra, xL, mIn, bUni
  rw [product, mRoot] at ev
  rw (tkJ.gal_aeval_one with algebra, xL) at ev
  have bL := tkJ.gal_aeval_mem with algebra, xL, bUni
  have z : Ring.zero(Algebra.ring(E)) * polyAeval(E, x, b) = Ring.zero(Algebra.ring(E))
    by ring
  rw z at ev
  symm at ev
  exact distinctL with ev

theorem minpoly.irreducible (x : Set)
  requires integral : IntegralElement(E, x)
  shows RingIrreducible(polynomialRing(Algebra.base(E), {0}), minpoly(E, x))
proof
  have ext2 := extension
  obtain ⟨algebra, baseField, ringField⟩ := ext2
  have comm := Field.to_comm_ring with baseField
  have polys := polynomialRing.comm_ring at Algebra.base(E), {0} with comm
  have domainK := Field.domain with baseField
  have domainP := polynomialRing.domain at Algebra.base(E) with comm, polys, domainK
  have ringL := Algebra.comm_ring with algebra
  have domainL := Field.domain with ringField
  have int2 := integral
  obtain ⟨_, xL, _⟩ := int2
  have sel := minpoly.selected with extension, integral
  obtain ⟨mIn, mMonic, mRoot, mMin⟩ := sel
  have mP := mIn
  unfold uniPolys at mP
  have baseParts := Field.parts with baseField
  have nt := IsField.nontrivial with baseParts
  obtain ⟨_, _, nontrivial⟩ := nt
  have nonzero := PolyMonic.ne_zero at Algebra.base(E), minpoly(E, x) with comm, polys,
    mP, nontrivial, mMonic
  have notUnit := tkJ.gal_minpoly_not_unit with extension, integral
  have oneP : Ring.one(polynomialRing(Algebra.base(E), {0})) ∈
    Ring.carrier(polynomialRing(Algebra.base(E), {0})) by typecheck
  unfold RingIrreducible
  refine ⟨mP, notUnit, ?_⟩
  intros a aIn b bIn mEq
  have aUni : a ∈ uniPolys(Algebra.base(E))
    unfold uniPolys
    exact aIn
  have bUni : b ∈ uniPolys(Algebra.base(E))
    unfold uniPolys
    exact bIn
  have ev := tkJ.gal_aeval_mul with algebra, xL, aUni, bUni
  rw [← mEq, mRoot] at ev
  have aL := tkJ.gal_aeval_mem with algebra, xL, aUni
  have bL := tkJ.gal_aeval_mem with algebra, xL, bUni
  symm at ev
  have zero := (IntegralDomain.mul_eq_zero at Algebra.ring(E), polyAeval(E, x, a),
    polyAeval(E, x, b) with domainL, aL, bL).forward with ev
  cases zero with az | bz
  . have dvd := mMin with a, aUni, az
    obtain ⟨_, _, c, cIn, aEq⟩ := dvd
    have t : minpoly(E, x) * (c * b) = (minpoly(E, x) * c) * b by ring
    rw ← aEq at t
    rw ← mEq at t
    have u : minpoly(E, x) * Ring.one(polynomialRing(Algebra.base(E), {0})) =
      minpoly(E, x) by ring
    have t2 : minpoly(E, x) * (c * b) =
        minpoly(E, x) * Ring.one(polynomialRing(Algebra.base(E), {0}))
      rw u
      exact t
    have cb : c * b ∈ Ring.carrier(polynomialRing(Algebra.base(E), {0})) by typecheck
    have cancel := IntegralDomain.mul_cancel at polynomialRing(Algebra.base(E), {0}),
      minpoly(E, x), c * b, Ring.one(polynomialRing(Algebra.base(E), {0})) with
      domainP, mP, cb, oneP, nonzero, t2
    have swap : b * c = c * b by ring
    right
    unfold RingUnit
    refine ⟨bIn, c, cIn, _, _⟩
    . rw swap
      exact cancel
    . exact cancel
  . have dvd := mMin with b, bUni, bz
    obtain ⟨_, _, c, cIn, bEq⟩ := dvd
    have t : minpoly(E, x) * (a * c) = a * (minpoly(E, x) * c) by ring
    rw ← bEq at t
    rw ← mEq at t
    have u : minpoly(E, x) * Ring.one(polynomialRing(Algebra.base(E), {0})) =
      minpoly(E, x) by ring
    have t2 : minpoly(E, x) * (a * c) =
        minpoly(E, x) * Ring.one(polynomialRing(Algebra.base(E), {0}))
      rw u
      exact t
    have ac : a * c ∈ Ring.carrier(polynomialRing(Algebra.base(E), {0})) by typecheck
    have cancel := IntegralDomain.mul_cancel at polynomialRing(Algebra.base(E), {0}),
      minpoly(E, x), a * c, Ring.one(polynomialRing(Algebra.base(E), {0})) with
      domainP, mP, ac, oneP, nonzero, t2
    have swap : c * a = a * c by ring
    left
    unfold RingUnit
    refine ⟨aIn, c, cIn, _, _⟩
    . exact cancel
    . rw swap
      exact cancel

-- minpoly.eq_of_irreducible_of_monic: a monic irreducible polynomial
-- vanishing at x is the minimal polynomial.
theorem minpoly.eq_of_irreducible_monic (x p : Set)
  requires integral : IntegralElement(E, x)
  requires irreducible : RingIrreducible(polynomialRing(Algebra.base(E), {0}), p)
  requires monic : PolyMonic(Algebra.base(E), p)
  requires root : polyAeval(E, x, p) = Ring.zero(Algebra.ring(E))
  shows minpoly(E, x) = p
proof
  have ext2 := extension
  obtain ⟨algebra, baseField, ringField⟩ := ext2
  have comm := Field.to_comm_ring with baseField
  have polys := polynomialRing.comm_ring at Algebra.base(E), {0} with comm
  have sel := minpoly.selected with extension, integral
  obtain ⟨mIn, mMonic, mRoot, mMin⟩ := sel
  have mP := mIn
  unfold uniPolys at mP
  have pm := monic
  obtain ⟨pIn, _⟩ := pm
  have pUni : p ∈ uniPolys(Algebra.base(E))
    unfold uniPolys
    exact pIn
  have notUnit := tkJ.gal_minpoly_not_unit with extension, integral
  have dvd := mMin with p, pUni, root
  have dvd2 := dvd
  obtain ⟨_, _, c, cIn, pEq⟩ := dvd2
  have irr := irreducible
  obtain ⟨_, _, factors⟩ := irr
  have alt := factors with minpoly(E, x), mP, c, cIn, pEq
  cases alt with mUnit | cUnit
  . exfalso
    exact notUnit with mUnit
  . obtain ⟨_, d, dIn, cd, _⟩ := cUnit
    have t : minpoly(E, x) * (c * d) = (minpoly(E, x) * c) * d by ring
    rw ← pEq at t
    rw cd at t
    have u : minpoly(E, x) * Ring.one(polynomialRing(Algebra.base(E), {0})) =
      minpoly(E, x) by ring
    rw u at t
    have back : RingDvd(polynomialRing(Algebra.base(E), {0}), p, minpoly(E, x))
      unfold RingDvd
      exact ⟨pIn, mP, d, dIn, t⟩
    exact tkJ.gal_monic_dvd_antisymm with baseField, mMonic, monic, dvd, back

-- minpoly.min: the minimal polynomial has least degree among the nonzero
-- polynomials vanishing at x.
theorem minpoly.degree_le (x p : Set)
  requires integral : IntegralElement(E, x)
  requires member : p ∈ uniPolys(Algebra.base(E))
  requires nonzero : p ≠ Ring.zero(polynomialRing(Algebra.base(E), {0}))
  requires root : polyAeval(E, x, p) = Ring.zero(Algebra.ring(E))
  shows polyNatDegree(Algebra.base(E), minpoly(E, x)) ≤ polyNatDegree(Algebra.base(E), p)
proof
  have ext2 := extension
  obtain ⟨algebra, baseField, ringField⟩ := ext2
  have comm := Field.to_comm_ring with baseField
  have polys := polynomialRing.comm_ring at Algebra.base(E), {0} with comm
  have baseParts := Field.parts with baseField
  have nt := IsField.nontrivial with baseParts
  obtain ⟨_, _, nontrivial⟩ := nt
  have sel := minpoly.selected with extension, integral
  obtain ⟨mIn, mMonic, mRoot, mMin⟩ := sel
  have mP := mIn
  unfold uniPolys at mP
  have pP := member
  unfold uniPolys at pP
  have dvd := mMin with p, member, root
  obtain ⟨_, _, c, cIn, pEq⟩ := dvd
  exact uni.monic_dvd_le at Algebra.base(E), minpoly(E, x), c, p with comm, polys, mP,
    cIn, pP, nontrivial, mMonic, pEq, nonzero

-- The powers 1, x, …, x^(d−1), d = deg minpoly(x), are linearly
-- independent over K.
theorem tkJ.powers_independent (x : Set)
  requires integral : IntegralElement(E, x)
  shows LinearIndependent(algebraModule(E), Algebra.base(E),
    polyNatDegree(Algebra.base(E), minpoly(E, x)),
    restrict(tkJPowers(E, x), polyNatDegree(Algebra.base(E), minpoly(E, x))))
proof
  have ext2 := extension
  obtain ⟨algebra, baseField, ringField⟩ := ext2
  have i2 := integral
  obtain ⟨_, point, _⟩ := i2
  have commK := Field.to_comm_ring with baseField
  have polysK := polynomialRing.comm_ring at Algebra.base(E), {0} with commK
  have moduleV := algebraModule.module_of with algebra
  have carrierV := algebraModule.carrier_eq at E
  have sp := minpoly.spec with extension, integral
  have mU := sp.left
  have mIn := mU
  unfold uniPolys at mIn
  have dNat : Nat(polyNatDegree(Algebra.base(E), minpoly(E, x))) by typecheck
  have finD := Finite.natural at polyNatDegree(Algebra.base(E), minpoly(E, x))
  have powF := tkJPowers.function at E, x with extension, point
  have powV : tkJPowers(E, x) : ℕ → Module.carrier(algebraModule(E))
    rw carrierV
    exact powF
  have dSub : polyNatDegree(Algebra.base(E), minpoly(E, x)) ⊆ ℕ
    intros i hi
    have iNat := natural.member at polyNatDegree(Algebra.base(E), minpoly(E, x)) with hi
    exact nat.omega.forward with iNat
  have famV := restrict.domain_function at tkJPowers(E, x), ℕ,
    Module.carrier(algebraModule(E)), polyNatDegree(Algebra.base(E), minpoly(E, x)) with
    powV, dSub
  apply (LinearIndependent.finite_iff at Algebra.base(E), algebraModule(E),
    polyNatDegree(Algebra.base(E), minpoly(E, x)), restrict(tkJPowers(E, x),
    polyNatDegree(Algebra.base(E), minpoly(E, x))) with commK, moduleV, finD,
    famV).backward
  intros c cF zero
  have built := tkJ.power_poly at E, x, polyNatDegree(Algebra.base(E), minpoly(E, x)) with
    extension, point
  obtain ⟨p, pU, coeffs, vanish, val⟩ := built with c, cF
  rw [zero, (tkJ.alg_module_zero at E)] at val
  have pIn := pU
  unfold uniPolys at pIn
  have pZero : p = Ring.zero(polynomialRing(Algebra.base(E), {0}))
    by_contra nonzero
    have le := minpoly.degree_le with extension, integral, pU, nonzero, val
    have degN : polyNatDegree(Algebra.base(E), p) ∈ ℕ by typecheck
    have top := (uni.deg_spec at Algebra.base(E), p with commK, polysK, pIn).right with
      nonzero
    have v := vanish with polyNatDegree(Algebra.base(E), p), degN, le
    exact top with v
  intros i hi
  have iNat := natural.member at polyNatDegree(Algebra.base(E), minpoly(E, x)) with hi
  have ci := coeffs with i, hi
  rw [pZero, (uni.zero_coeff at Algebra.base(E), i with commK, polysK)] at ci
  symm
  exact ci

-- minpoly.natDegree_le: in a finite extension deg minpoly(x) ≤ [L : K];
-- minpoly.ne_zero_of_finite: every element is integral.
theorem minpoly.natDegree_le (x : Set)
  requires finite : FiniteExtension(E)
  requires point : x ∈ algebraCarrier(E)
  shows IntegralElement(E, x) ∧
    polyNatDegree(Algebra.base(E), minpoly(E, x)) ≤ extensionDegree(E)
proof
  have ext2 := extension
  obtain ⟨algebra, baseField, ringField⟩ := ext2
  have fin2 := finite
  obtain ⟨_, fdV⟩ := fin2
  have fdV2 := fdV
  obtain ⟨_, generated⟩ := fdV2
  have baseParts := Field.parts with baseField
  have nt := IsField.nontrivial with baseParts
  obtain ⟨_, _, nontrivial⟩ := nt
  have finiteAlgebra : FiniteAlgebra(E)
    unfold FiniteAlgebra
    exact ⟨algebra, generated⟩
  have integralAlgebra := IntegralAlgebra.of_finite with algebra, finiteAlgebra
  obtain ⟨_, integralAll⟩ := integralAlgebra
  have integral := integralAll with x, point
  refine ⟨integral, ?_⟩
  have commK := Field.to_comm_ring with baseField
  have ringK := CommRing.to_ring with commK
  have polysK := polynomialRing.comm_ring at Algebra.base(E), {0} with commK
  have moduleV := algebraModule.module_of with algebra
  have carrierV := algebraModule.carrier_eq at E
  have sp := minpoly.spec with extension, integral
  have mU := sp.left
  have mIn := mU
  unfold uniPolys at mIn
  have dNat : Nat(polyNatDegree(Algebra.base(E), minpoly(E, x))) by typecheck
  have finD := Finite.natural at polyNatDegree(Algebra.base(E), minpoly(E, x))
  have powF := tkJPowers.function at E, x with extension, point
  have powV : tkJPowers(E, x) : ℕ → Module.carrier(algebraModule(E))
    rw carrierV
    exact powF
  have dSub : polyNatDegree(Algebra.base(E), minpoly(E, x)) ⊆ ℕ
    intros i hi
    have iNat := natural.member at polyNatDegree(Algebra.base(E), minpoly(E, x)) with hi
    exact nat.omega.forward with iNat
  have famV := restrict.domain_function at tkJPowers(E, x), ℕ,
    Module.carrier(algebraModule(E)), polyNatDegree(Algebra.base(E), minpoly(E, x)) with
    powV, dSub
  have indep := tkJ.powers_independent with extension, integral
  have bound := LinearIndependent.card_le_finrank at Algebra.base(E), algebraModule(E),
    polyNatDegree(Algebra.base(E), minpoly(E, x)), restrict(tkJPowers(E, x),
    polyNatDegree(Algebra.base(E), minpoly(E, x))) with baseField, moduleV, fdV, indep
  obtain ⟨_, le⟩ := bound
  rw (cardinality.natural at polyNatDegree(Algebra.base(E), minpoly(E, x))) at le
  unfold extensionDegree
  exact le

-- Helpers for K(x): its elements are values p(x), each the value of a
-- remainder of degree below deg minpoly(x), which is the combination of
-- the powers of x with the coefficients of the remainder.
def tkJPolyValues (x : Set) : Set :=
  { y ∈ algebraCarrier(E) | ∃ p ∈ uniPolys(Algebra.base(E)), y = polyAeval(E, x, p) }

theorem tkJ.adjoin_poly_values (x : Set)
  requires integral : IntegralElement(E, x)
  shows fieldAdjoin(E, {x}) ⊆ tkJPolyValues(E, x)
proof
  have ext2 := extension
  obtain ⟨algebra, baseField, _⟩ := ext2
  have i2 := integral
  obtain ⟨_, point, _⟩ := i2
  have commK := Field.to_comm_ring with baseField
  have polysK := polynomialRing.comm_ring at Algebra.base(E), {0} with commK
  have single : {x} ⊆ algebraCarrier(E)
    intros w wIn
    rw singleton.membership at wIn
    rw wIn
    exact point
  have allIntegral : ∀ y ∈ {x}, IntegralElement(E, y)
    intros y yIn
    rw singleton.membership at yIn
    rw yIn
    exact integral
  rw (fieldAdjoin.eq_algebra_adjoin with extension, single, allIntegral)
  apply adjoinOf.induction at E, {x}, tkJPolyValues(E, x) with algebra, single
  . intros w wIn
    rw singleton.membership at wIn
    rw wIn
    have xIn := polyX.mem at Algebra.base(E) with commK, polysK
    have xU : polyX(Algebra.base(E)) ∈ uniPolys(Algebra.base(E))
      unfold uniPolys
      exact xIn
    apply tkJPolyValues.membership.backward
    refine ⟨point, polyX(Algebra.base(E)), xU, ?_⟩
    symm
    exact polyAeval.X at E, x with algebra, point
  . intros r rK
    have mr := Algebra.map_mem with algebra, rK
    have cIn := polyC.mem at Algebra.base(E), r with commK, polysK, rK
    have cU : polyC(Algebra.base(E), r) ∈ uniPolys(Algebra.base(E))
      unfold uniPolys
      exact cIn
    have mrL : Algebra.map(E)(r) ∈ algebraCarrier(E)
      unfold algebraCarrier
      exact mr
    apply tkJPolyValues.membership.backward
    refine ⟨mrL, polyC(Algebra.base(E), r), cU, ?_⟩
    symm
    exact polyAeval.C at E, x, r with algebra, point, rK
  . intros y1 y1In y2 y2In
    obtain ⟨y1P, _⟩ := intersection.membership.forward with y1In
    obtain ⟨y2P, _⟩ := intersection.membership.forward with y2In
    obtain ⟨y1L, p1, p1U, e1⟩ := tkJPolyValues.membership.forward with y1P
    obtain ⟨y2L, p2, p2U, e2⟩ := tkJPolyValues.membership.forward with y2P
    have p1In := p1U
    unfold uniPolys at p1In
    have p2In := p2U
    unfold uniPolys at p2In
    have sU : call2(Ring.add(polynomialRing(Algebra.base(E), {0})), p1, p2) ∈
        uniPolys(Algebra.base(E))
      unfold uniPolys
      typecheck
    have v1 := tkJ.gal_aeval_mem with algebra, point, p1U
    have v2 := tkJ.gal_aeval_mem with algebra, point, p2U
    have sL : call2(Ring.add(Algebra.ring(E)), y1, y2) ∈ algebraCarrier(E)
      rw [e1, e2]
      unfold algebraCarrier
      typecheck
    apply tkJPolyValues.membership.backward
    refine ⟨sL, call2(Ring.add(polynomialRing(Algebra.base(E), {0})), p1, p2), sU, ?_⟩
    rw (tkJ.gal_aeval_add with algebra, point, p1U, p2U)
    rw [e1, e2]
  . intros y1 y1In y2 y2In
    obtain ⟨y1P, _⟩ := intersection.membership.forward with y1In
    obtain ⟨y2P, _⟩ := intersection.membership.forward with y2In
    obtain ⟨y1L, p1, p1U, e1⟩ := tkJPolyValues.membership.forward with y1P
    obtain ⟨y2L, p2, p2U, e2⟩ := tkJPolyValues.membership.forward with y2P
    have p1In := p1U
    unfold uniPolys at p1In
    have p2In := p2U
    unfold uniPolys at p2In
    have sU : call2(Ring.mul(polynomialRing(Algebra.base(E), {0})), p1, p2) ∈
        uniPolys(Algebra.base(E))
      unfold uniPolys
      typecheck
    have v1 := tkJ.gal_aeval_mem with algebra, point, p1U
    have v2 := tkJ.gal_aeval_mem with algebra, point, p2U
    have sL : call2(Ring.mul(Algebra.ring(E)), y1, y2) ∈ algebraCarrier(E)
      rw [e1, e2]
      unfold algebraCarrier
      typecheck
    apply tkJPolyValues.membership.backward
    refine ⟨sL, call2(Ring.mul(polynomialRing(Algebra.base(E), {0})), p1, p2), sU, ?_⟩
    rw (tkJ.gal_aeval_mul with algebra, point, p1U, p2U)
    rw [e1, e2]

theorem tkJ.reduce_minpoly (x p : Set)
  requires integral : IntegralElement(E, x)
  requires member : p ∈ uniPolys(Algebra.base(E))
  shows ∃ r ∈ uniPolys(Algebra.base(E)),
    r ∈ polyDegreeLT(Algebra.base(E), polyNatDegree(Algebra.base(E), minpoly(E, x))) ∧
    polyAeval(E, x, r) = polyAeval(E, x, p)
proof
  have ext2 := extension
  obtain ⟨algebra, baseField, _⟩ := ext2
  have i2 := integral
  obtain ⟨_, point, _⟩ := i2
  have commK := Field.to_comm_ring with baseField
  have polysK := polynomialRing.comm_ring at Algebra.base(E), {0} with commK
  have ringL := Algebra.comm_ring with algebra
  have sp := minpoly.spec with extension, integral
  obtain ⟨mU, mMonic, mRoot, _⟩ := sp
  have mIn := mU
  unfold uniPolys at mIn
  have pIn := member
  unfold uniPolys at pIn
  have degN : Nat(polyNatDegree(Algebra.base(E), p)) by typecheck
  have vanish : ∀ k ∈ ℕ, polyNatDegree(Algebra.base(E), p) + 1 ≤ k →
      polyCoeff(p, k) = Ring.zero(Algebra.base(E))
    intros k hk le
    have kNat := nat.omega.backward with hk
    have lt : polyNatDegree(Algebra.base(E), p) < k by arith
    exact (uni.vanish_deg at Algebra.base(E), p with commK, polysK, pIn) with k, hk, lt
  obtain ⟨q, qIn, r, rIn, split, low⟩ := uni.div_exists at Algebra.base(E),
    minpoly(E, x), polyNatDegree(Algebra.base(E), p) + 1 with mIn, commK, polysK, mMonic, p,
    pIn, vanish
  have qU : q ∈ uniPolys(Algebra.base(E))
    unfold uniPolys
    exact qIn
  have rU : r ∈ uniPolys(Algebra.base(E))
    unfold uniPolys
    exact rIn
  have qmU : call2(Ring.mul(polynomialRing(Algebra.base(E), {0})), q, minpoly(E, x)) ∈
      uniPolys(Algebra.base(E))
    unfold uniPolys
    typecheck
  refine ⟨r, rU, low, ?_⟩
  rw split
  rw (tkJ.gal_aeval_add with algebra, point, qmU, rU)
  rw (tkJ.gal_aeval_mul with algebra, point, qU, mU)
  rw mRoot
  have vq := tkJ.gal_aeval_mem with algebra, point, qU
  have vr := tkJ.gal_aeval_mem with algebra, point, rU
  ring

defgraph tkJCoeffs (r : Set) (i ∈ ℕ) : Ring.carrier(Algebra.base(E)) := polyCoeff(r, i)
requires polynomial : r ∈ uniPolys(Algebra.base(E))
proof
  have ext2 := extension
  obtain ⟨algebra, baseField, _⟩ := ext2
  have commK := Field.to_comm_ring with baseField
  have iNat := nat.omega.backward with member
  unfold uniPolys at polynomial
  exact uni.coeff_mem at Algebra.base(E), r, i with commK, polynomial

theorem tkJ.low_poly_value (x r : Set) (n : Nat)
  requires point : x ∈ algebraCarrier(E)
  requires polynomial : r ∈ uniPolys(Algebra.base(E))
  requires low : r ∈ polyDegreeLT(Algebra.base(E), n)
  shows polyAeval(E, x, r) = moduleCombination(algebraModule(E), Algebra.base(E), n,
    restrict(tkJCoeffs(E, r), n), restrict(tkJPowers(E, x), n))
proof
  have ext2 := extension
  obtain ⟨algebra, baseField, _⟩ := ext2
  have commK := Field.to_comm_ring with baseField
  have polysK := polynomialRing.comm_ring at Algebra.base(E), {0} with commK
  have rIn := polynomial
  unfold uniPolys at rIn
  have nSub : n ⊆ ℕ
    intros i hi
    have iNat := natural.member at n with hi
    exact nat.omega.forward with iNat
  have coeffF := tkJCoeffs.function at E, r with extension, polynomial
  have cF := restrict.domain_function at tkJCoeffs(E, r), ℕ, Ring.carrier(Algebra.base(E)), n
    with coeffF, nSub
  have built := tkJ.power_poly at E, x, n with extension, point
  obtain ⟨p, pU, coeffs, vanish, val⟩ := built with restrict(tkJCoeffs(E, r), n), cF
  have pIn := pU
  unfold uniPolys at pIn
  have same : p = r
    apply polynomial.ext at Algebra.base(E), p, r with commK, polysK, pIn, rIn
    intros k hk
    have kNat := nat.omega.backward with hk
    by_cases kn : k ∈ n
    . rw (coeffs with k, kn)
      rw (restrict.domain_apply at tkJCoeffs(E, r), ℕ, Ring.carrier(Algebra.base(E)), n, k with
        coeffF, nSub, kn)
      exact tkJCoeffs.value at E, r, k with extension, polynomial, hk
    . have le : n ≤ k
        by_contra notLe
        have lt : k < n by arith
        have nNat : Nat(n) by typecheck
        have mem := membership.of_Less at k, n with kNat, nNat
        have kIn := mem with lt
        exact kn with kIn
      rw (vanish with k, hk, le)
      by_contra nonzero
      have deg : k ∈ polyDegrees(Algebra.base(E), r)
        apply polyDegrees.membership.backward
        refine ⟨hk, ?_⟩
        intro z
        unfold polyCoeff at nonzero
        symm at z
        exact nonzero with z
      obtain ⟨_, below⟩ := polyDegreeLT.membership.forward with low
      have lt := below with k, deg
      arith
  rw same at val
  exact val

theorem tkJ.adjoin_pow_mem (x : Set) (n : Nat)
  requires point : x ∈ algebraCarrier(E)
  shows Ring.pow(Algebra.ring(E), x, n) ∈ fieldAdjoin(E, {x})
proof
  have ext2 := extension
  obtain ⟨algebra, _, _⟩ := ext2
  have commL := Algebra.comm_ring with algebra
  have ringL := CommRing.to_ring with commL
  have single : {x} ⊆ algebraCarrier(E)
    intros w wIn
    rw singleton.membership at wIn
    rw wIn
    exact point
  have inter := fieldAdjoin.intermediate with extension, single
  have xF := (fieldAdjoin.subset_adjoin with extension, single) with x, (singleton.self at x)
  have subring := tkJ.intermediate_subring with inter
  have oneF := IsSubring.one_closed with subring
  have mulF := IsSubring.mul_closed with subring
  have xR := point
  unfold algebraCarrier at xR
  induction n
  | zero =>
    rw (Ring.pow_zero at Algebra.ring(E), x with ringL, xR)
    exact oneF
  | succ(m) using ih =>
    have same : succ(m) = m + 1 by arith
    rw same
    rw (Ring.pow_succ at Algebra.ring(E), x, m with ringL, xR)
    exact mulF with Ring.pow(Algebra.ring(E), x, m), ih, x, xF

-- K(x) is finite of degree deg minpoly(x) (IntermediateField.adjoin.finiteDimensional,
-- IntermediateField.adjoin.finrank).
theorem fieldAdjoin.simple_finite (x : Set)
  requires integral : IntegralElement(E, x)
  shows FiniteExtension(subextension(E, fieldAdjoin(E, {x}))) ∧
    extensionDegree(subextension(E, fieldAdjoin(E, {x}))) =
      polyNatDegree(Algebra.base(E), minpoly(E, x))
proof
  have ext2 := extension
  obtain ⟨algebra, baseField, _⟩ := ext2
  have i2 := integral
  obtain ⟨_, point, _⟩ := i2
  have commK := Field.to_comm_ring with baseField
  have ringK := CommRing.to_ring with commK
  have baseParts := Field.parts with baseField
  have ntK := IsField.nontrivial with baseParts
  obtain ⟨_, _, distinctK⟩ := ntK
  have moduleV := algebraModule.module_of with algebra
  have carrierV := algebraModule.carrier_eq at E
  have single : {x} ⊆ algebraCarrier(E)
    intros w wIn
    rw singleton.membership at wIn
    rw wIn
    exact point
  have inter := fieldAdjoin.intermediate with extension, single
  have sub := tkJ.tower_submodule with extension, inter
  have subEq := tkJ.tower_sub_module with extension, inter
  have moduleS := SubmoduleOf.submodule_module at Algebra.base(E), algebraModule(E),
    fieldAdjoin(E, {x}) with ringK, moduleV, sub
  have carrierS := submoduleModule.carrier_eq at algebraModule(E), Algebra.base(E),
    fieldAdjoin(E, {x})
  have powIn : ∀ i ∈ ℕ, tkJPowers(E, x)(i) ∈ fieldAdjoin(E, {x})
    intros i hi
    have iNat := nat.omega.backward with hi
    rw (tkJPowers.value at E, x, i with extension, point, hi)
    exact tkJ.adjoin_pow_mem at E, x, i with extension, point
  have sp := minpoly.spec with extension, integral
  have mU := sp.left
  have mIn := mU
  unfold uniPolys at mIn
  have dNat : Nat(polyNatDegree(Algebra.base(E), minpoly(E, x))) by typecheck
  have finD := Finite.natural at polyNatDegree(Algebra.base(E), minpoly(E, x))
  have dSub : polyNatDegree(Algebra.base(E), minpoly(E, x)) ⊆ ℕ
    intros i hi
    have iNat := natural.member at polyNatDegree(Algebra.base(E), minpoly(E, x)) with hi
    exact nat.omega.forward with iNat
  have powF := tkJPowers.function at E, x with extension, point
  have famL := restrict.domain_function at tkJPowers(E, x), ℕ, algebraCarrier(E),
    polyNatDegree(Algebra.base(E), minpoly(E, x)) with powF, dSub
  have famInF : ∀ i ∈ polyNatDegree(Algebra.base(E), minpoly(E, x)),
      restrict(tkJPowers(E, x), polyNatDegree(Algebra.base(E), minpoly(E, x)))(i) ∈
        fieldAdjoin(E, {x})
    intros i hi
    have iN := dSub with i, hi
    rw (restrict.domain_apply at tkJPowers(E, x), ℕ, algebraCarrier(E),
      polyNatDegree(Algebra.base(E), minpoly(E, x)), i with powF, dSub, hi)
    exact powIn with i, iN
  have famF := FunctionBetween.codomain_of_values with famL, famInF
  have famS : restrict(tkJPowers(E, x), polyNatDegree(Algebra.base(E), minpoly(E, x))) :
      polyNatDegree(Algebra.base(E), minpoly(E, x)) →
      Module.carrier(submoduleModule(algebraModule(E), Algebra.base(E), fieldAdjoin(E, {x})))
    rw carrierS
    exact famF
  have famV : restrict(tkJPowers(E, x), polyNatDegree(Algebra.base(E), minpoly(E, x))) :
      polyNatDegree(Algebra.base(E), minpoly(E, x)) → Module.carrier(algebraModule(E))
    rw carrierV
    exact famL
  have indepV := tkJ.powers_independent with extension, integral
  have indepS : LinearIndependent(submoduleModule(algebraModule(E), Algebra.base(E),
      fieldAdjoin(E, {x})), Algebra.base(E), polyNatDegree(Algebra.base(E), minpoly(E, x)),
      restrict(tkJPowers(E, x), polyNatDegree(Algebra.base(E), minpoly(E, x))))
    apply (LinearIndependent.finite_iff at Algebra.base(E), submoduleModule(algebraModule(E),
      Algebra.base(E), fieldAdjoin(E, {x})), polyNatDegree(Algebra.base(E), minpoly(E, x)),
      restrict(tkJPowers(E, x), polyNatDegree(Algebra.base(E), minpoly(E, x))) with commK,
      moduleS, finD, famS).backward
    intros c cF zero
    rw (tkJ.tower_sub_combination at E, fieldAdjoin(E, {x}),
      polyNatDegree(Algebra.base(E), minpoly(E, x)), c, restrict(tkJPowers(E, x),
      polyNatDegree(Algebra.base(E), minpoly(E, x))) with extension, inter, finD, cF,
      famF) at zero
    rw submoduleModule.zero_eq at zero
    exact (LinearIndependent.finite_iff at Algebra.base(E), algebraModule(E),
      polyNatDegree(Algebra.base(E), minpoly(E, x)), restrict(tkJPowers(E, x),
      polyNatDegree(Algebra.base(E), minpoly(E, x))) with commK, moduleV, finD,
      famV).forward with indepV, c, cF, zero
  have spansS : SpansModule(submoduleModule(algebraModule(E), Algebra.base(E),
      fieldAdjoin(E, {x})), Algebra.base(E), polyNatDegree(Algebra.base(E), minpoly(E, x)),
      restrict(tkJPowers(E, x), polyNatDegree(Algebra.base(E), minpoly(E, x))))
    unfold SpansModule
    refine ⟨moduleS, famS, ?_⟩
    rw (moduleSpan.range_family_of at Algebra.base(E), submoduleModule(algebraModule(E),
      Algebra.base(E), fieldAdjoin(E, {x})), polyNatDegree(Algebra.base(E), minpoly(E, x)),
      restrict(tkJPowers(E, x), polyNatDegree(Algebra.base(E), minpoly(E, x))) with ringK,
      moduleS, finD, famS)
    apply Subset.antisymmetric
    . intros y hy
      obtain ⟨yIn, _⟩ := familyCombinations.membership.forward with hy
      exact yIn
    . intros y yS
      have yF := yS
      rw carrierS at yF
      have yP := (tkJ.adjoin_poly_values with extension, integral) with y, yF
      obtain ⟨_, p, pU, yEq⟩ := tkJPolyValues.membership.forward with yP
      obtain ⟨r, rU, low, rEq⟩ := tkJ.reduce_minpoly with extension, integral, pU
      have value := tkJ.low_poly_value at E, x, r, polyNatDegree(Algebra.base(E),
        minpoly(E, x)) with extension, point, rU, low
      have coeffF := tkJCoeffs.function at E, r with extension, rU
      have cF := restrict.domain_function at tkJCoeffs(E, r), ℕ,
        Ring.carrier(Algebra.base(E)), polyNatDegree(Algebra.base(E), minpoly(E, x)) with
        coeffF, dSub
      rw ← (tkJ.tower_sub_combination at E, fieldAdjoin(E, {x}),
        polyNatDegree(Algebra.base(E), minpoly(E, x)), restrict(tkJCoeffs(E, r),
        polyNatDegree(Algebra.base(E), minpoly(E, x))), restrict(tkJPowers(E, x),
        polyNatDegree(Algebra.base(E), minpoly(E, x))) with extension, inter, finD, cF,
        famF) at value
      rw [rEq, ← yEq] at value
      apply familyCombinations.membership.backward
      exact ⟨yS, restrict(tkJCoeffs(E, r), polyNatDegree(Algebra.base(E), minpoly(E, x))),
        cF, value⟩
  have basis : ModuleBasis(submoduleModule(algebraModule(E), Algebra.base(E),
      fieldAdjoin(E, {x})), Algebra.base(E), polyNatDegree(Algebra.base(E), minpoly(E, x)),
      restrict(tkJPowers(E, x), polyNatDegree(Algebra.base(E), minpoly(E, x))))
    unfold ModuleBasis
    exact ⟨indepS, spansS⟩
  have rank := finrank.of_basis at Algebra.base(E), submoduleModule(algebraModule(E),
    Algebra.base(E), fieldAdjoin(E, {x})), polyNatDegree(Algebra.base(E), minpoly(E, x)),
    restrict(tkJPowers(E, x), polyNatDegree(Algebra.base(E), minpoly(E, x))) with commK,
    distinctK, moduleS, finD, basis
  have free : FiniteFreeModule(submoduleModule(algebraModule(E), Algebra.base(E),
      fieldAdjoin(E, {x})), Algebra.base(E))
    unfold FiniteFreeModule
    exact ⟨polyNatDegree(Algebra.base(E), minpoly(E, x)), restrict(tkJPowers(E, x),
      polyNatDegree(Algebra.base(E), minpoly(E, x))), finD, basis⟩
  have fdS := FiniteDimensional.of_finite_free at Algebra.base(E),
    submoduleModule(algebraModule(E), Algebra.base(E), fieldAdjoin(E, {x})) with baseField,
    moduleS, free
  have fields := IntermediateField.subextension_field with extension, inter
  obtain ⟨subExt, _⟩ := fields
  constructor
  . unfold FiniteExtension
    rw [tkJ.sub_base, subEq]
    exact ⟨subExt, fdS⟩
  . unfold extensionDegree
    rw [tkJ.sub_base, subEq, rank]
    exact cardinality.natural at polyNatDegree(Algebra.base(E), minpoly(E, x))

-- minpoly.eq_X_sub_C: the minimal polynomial of a ∈ K is X − a.
theorem minpoly.algebra_map (a : Set)
  requires scalar : a ∈ Ring.carrier(Algebra.base(E))
  shows minpoly(E, Algebra.map(E)(a)) = polyXSubC(Algebra.base(E), a)
proof
  have ext2 := extension
  obtain ⟨algebra, baseField, ringField⟩ := ext2
  have comm := Field.to_comm_ring with baseField
  have polys := polynomialRing.comm_ring at Algebra.base(E), {0} with comm
  have structureMap := Algebra.structure_hom with algebra
  have pIn := uni.XsubC_mem at Algebra.base(E), a with comm, polys, scalar
  have pUni : polyXSubC(Algebra.base(E), a) ∈ uniPolys(Algebra.base(E))
    unfold uniPolys
    exact pIn
  have monic := PolyMonic.X_sub_C at Algebra.base(E), a with comm, polys, scalar
  have value := polyAeval.algebra_map at E, a, polyXSubC(Algebra.base(E), a) with
    algebra, scalar, pIn
  have evaluated := polyEval.X_sub_C at Algebra.base(E), a, a with comm, polys, scalar,
    scalar
  have self : a - a = Ring.zero(Algebra.base(E)) by ring
  rw [evaluated, self] at value
  rw (RingHom.map_zero with structureMap) at value
  have aL := Algebra.map_mem with algebra, scalar
  have aL2 : Algebra.map(E)(a) ∈ algebraCarrier(E)
    unfold algebraCarrier
    exact aL
  have integral : IntegralElement(E, Algebra.map(E)(a))
    unfold IntegralElement
    exact ⟨algebra, aL2, polyXSubC(Algebra.base(E), a), monic, value⟩
  apply tkJ.gal_minpoly_eq with extension, integral, pUni, monic, value
  intros q qUni qRoot
  have qIn := qUni
  unfold uniPolys at qIn
  have mapped := polyAeval.algebra_map at E, a, q with algebra, scalar, qIn
  rw qRoot at mapped
  have evalHom := polyEval.hom at Algebra.base(E), a with comm, polys, scalar
  have evalIn : polyEval(Algebra.base(E), q, a) ∈ Ring.carrier(Algebra.base(E))
    unfold polyEval
    exact RingHom.map_mem with evalHom, qIn
  have flipped : Algebra.map(E)(polyEval(Algebra.base(E), q, a)) = Ring.zero(Algebra.ring(E))
    symm
    exact mapped
  have zero := tkJ.gal_map_reflects_zero at E, polyEval(Algebra.base(E), q, a) with
    extension, evalIn, flipped
  have isRoot : PolyIsRoot(Algebra.base(E), q, a)
    unfold PolyIsRoot
    exact ⟨scalar, zero⟩
  exact (polyXSubC.dvd_iff_root at Algebra.base(E), q, a with comm, polys, qIn,
    scalar).backward with isRoot

-- minpoly.algHom_eq: an injective K-algebra map keeps minimal polynomials.
theorem minpoly.algebra_hom (E2 f x : Set)
  requires target : FieldExtension(E2)
  requires hom : f : E →ₐ E2
  requires integral : IntegralElement(E, x)
  shows minpoly(E2, f(x)) = minpoly(E, x)
proof
  have ext2 := extension
  obtain ⟨algebra, baseField, ringField⟩ := ext2
  have t2 := target
  obtain ⟨algebra2, baseField2, ringField2⟩ := t2
  have baseEq := AlgebraHom.base_eq with hom
  have fFun := AlgebraHom.function with hom
  have ringHom := AlgebraHom.ring_hom with hom
  have int2 := integral
  obtain ⟨_, xL, _⟩ := int2
  have fxL := FunctionBetween.apply_closed with fFun, xL
  have sel := minpoly.selected with extension, integral
  obtain ⟨mIn, mMonic, mRoot, mMin⟩ := sel
  have mP := mIn
  unfold uniPolys at mP
  have applied := polyAeval.algebra_hom_apply at E, E2, f, x, minpoly(E, x) with
    algebra, hom, xL, mP
  rw mRoot at applied
  rw (RingHom.map_zero with ringHom) at applied
  have root2 : polyAeval(E2, f(x), minpoly(E, x)) = Ring.zero(Algebra.ring(E2))
    symm
    exact applied
  have mIn2 : minpoly(E, x) ∈ uniPolys(Algebra.base(E2))
    rw ← baseEq
    exact mIn
  have mMonic2 : PolyMonic(Algebra.base(E2), minpoly(E, x))
    rw ← baseEq
    exact mMonic
  have integral2 : IntegralElement(E2, f(x))
    unfold IntegralElement
    exact ⟨algebra2, fxL, minpoly(E, x), mMonic2, root2⟩
  have ringParts := Field.parts with ringField
  have target2 := Field.parts with ringField2
  have targetComm := IsField.comm_ring with target2
  have nontrivial2 := IsField.nontrivial with target2
  have homParts := RingHom.parts with ringHom
  apply tkJ.gal_minpoly_eq with target, integral2, mIn2, mMonic2, root2
  intros q qUni2 qRoot2
  have qUni : q ∈ uniPolys(Algebra.base(E))
    rw baseEq
    exact qUni2
  have qP := qUni
  unfold uniPolys at qP
  have applied2 := polyAeval.algebra_hom_apply at E, E2, f, x, q with algebra, hom, xL,
    qP
  rw qRoot2 at applied2
  have qL := tkJ.gal_aeval_mem with algebra, xL, qUni
  have zero := IsRingHom.field_reflects_zero with ringParts, targetComm, nontrivial2,
    homParts, qL, applied2
  have dvd := mMin with q, qUni, zero
  rw baseEq at dvd
  exact dvd

-- minpoly.exists_algEquiv_of_root: in a normal extension the roots of
-- minpoly(x) are the conjugates σ(x).
theorem minpoly.conjugate_of_root (x y : Set)
  requires normal : NormalExtension(E)
  requires point : x ∈ algebraCarrier(E)
  requires target : y ∈ algebraCarrier(E)
  requires root : polyAeval(E, y, minpoly(E, x)) = Ring.zero(Algebra.ring(E))
  shows ∃ σ ∈ algebraAutomorphisms(E), σ(x) = y
proof
  sorry

-- Automorphisms send x to roots of minpoly(x) (minpoly.algHom_eq with
-- aeval_algHom_apply).
theorem minpoly.root_of_conjugate (x σ : Set)
  requires integral : IntegralElement(E, x)
  requires automorphism : σ ∈ algebraAutomorphisms(E)
  shows polyAeval(E, σ(x), minpoly(E, x)) = Ring.zero(Algebra.ring(E))
proof
  have ext2 := extension
  obtain ⟨algebra, baseField, ringField⟩ := ext2
  have int2 := integral
  obtain ⟨_, xL, _⟩ := int2
  have sel := minpoly.selected with extension, integral
  obtain ⟨mIn, mMonic, mRoot, mMin⟩ := sel
  have mP := mIn
  unfold uniPolys at mP
  have iso := (tkJ.aut_member at E, σ).forward with automorphism
  obtain ⟨hom, _⟩ := iso
  have ringHom := AlgebraHom.ring_hom with hom
  have applied := polyAeval.algebra_hom_apply at E, E, σ, x, minpoly(E, x) with algebra,
    hom, xL, mP
  rw mRoot at applied
  rw (RingHom.map_zero with ringHom) at applied
  symm
  exact applied

-- IsIntegral.mem_intermediateField_of_minpoly_splits: if minpoly(x)
-- splits in F then x ∈ F.
theorem minpoly.mem_of_splits (F x : Set)
  requires intermediate : IntermediateField(E, F)
  requires integral : IntegralElement(E, x)
  requires splits : PolySplits(Algebra.base(E), subringRing(Algebra.ring(E), F),
    Algebra.map(E), minpoly(E, x))
  shows x ∈ F
proof
  have int2 := integral
  obtain ⟨_, xL, _⟩ := int2
  have sel := minpoly.selected with extension, integral
  obtain ⟨mIn, mMonic, mRoot, mMin⟩ := sel
  exact tkJ.gal_split_root with extension, intermediate, mIn, mMonic, splits, xL, mRoot

end MinimalPolynomial

-- K[X] over a field is a principal ideal domain: a nonzero ideal is
-- generated by a monic element of least degree.
def tkJIdealDegrees (K I : Set) : Set :=
  { n ∈ ℕ | ∃ p ∈ I, p ≠ Ring.zero(polynomialRing(K, {0})) ∧ polyNatDegree(K, p) = n }

theorem tkJ.gal_poly_pid (K : Set)
  requires field : Field(K)
  shows PrincipalIdealDomain(polynomialRing(K, {0}))
proof
  have comm := Field.to_comm_ring with field
  have polys := polynomialRing.comm_ring at K, {0} with comm
  have domainK := Field.domain with field
  have domainP := polynomialRing.domain at K with comm, polys, domainK
  have parts := Field.parts with field
  have nt := IsField.nontrivial with parts
  obtain ⟨_, _, nontrivial⟩ := nt
  have pr := CommRing.to_ring with polys
  have zeroP : Ring.zero(polynomialRing(K, {0})) ∈ Ring.carrier(polynomialRing(K, {0}))
    by typecheck
  unfold PrincipalIdealDomain
  refine ⟨domainP, ?_⟩
  intros I ideal
  have bounded := Ideal.subset at polynomialRing(K, {0}), I with ideal
  have zeroI := Ideal.zero_mem at polynomialRing(K, {0}), I with ideal
  unfold PrincipalIdeal
  refine ⟨ideal, ?_⟩
  by_cases allZero : ∀ x ∈ I, x = Ring.zero(polynomialRing(K, {0}))
  . refine ⟨Ring.zero(polynomialRing(K, {0})), zeroP, ?_⟩
    ext x
    constructor
    . intro xI
      have z := allZero with x, xI
      apply ringMultiples.membership.backward
      refine ⟨(bounded with x, xI), Ring.zero(polynomialRing(K, {0})), zeroP, ?_⟩
      rw z
      ring
    . intro xm
      obtain ⟨xP, c, cP, xEq⟩ := ringMultiples.membership.forward with xm
      rw xEq
      have t : c * Ring.zero(polynomialRing(K, {0})) = Ring.zero(polynomialRing(K, {0}))
        by ring
      rw t
      exact zeroI
  . have some : ∃ x ∈ I, x ≠ Ring.zero(polynomialRing(K, {0}))
      by_contra none
      apply allZero
      intros x xI
      by_contra ne
      exact none with ⟨x, xI, ne⟩
    obtain ⟨x0, x0I, x0nz⟩ := some
    have x0P := bounded with x0, x0I
    have degN : polyNatDegree(K, x0) ∈ ℕ by typecheck
    have inD : polyNatDegree(K, x0) ∈ tkJIdealDegrees(K, I)
      apply tkJIdealDegrees.membership.backward
      exact ⟨degN, x0, x0I, x0nz, rfl⟩
    have nonempty : Nonempty(tkJIdealDegrees(K, I))
      unfold Nonempty
      exact ⟨polyNatDegree(K, x0), inD⟩
    have naturals : tkJIdealDegrees(K, I) ⊆ ℕ
      intros n nIn
      obtain ⟨nN, _⟩ := tkJIdealDegrees.membership.forward with nIn
      exact nN
    have least := leastNatural.member with nonempty, naturals
    obtain ⟨_, p, pI, pnz, pDeg⟩ := tkJIdealDegrees.membership.forward with least
    have pP := bounded with p, pI
    have pUni : p ∈ uniPolys(K)
      unfold uniPolys
      exact pP
    obtain ⟨c, cK, gMonic, gDeg⟩ := tkJ.gal_monic_rescale with field, pUni, pnz
    have cpIn := polyC.mem at K, c with comm, polys, cK
    have gI := Ideal.mul_left_mem at polynomialRing(K, {0}), I, polyC(K, c), p with pr,
      ideal, cpIn, pI
    have gm := gMonic
    obtain ⟨gP, _⟩ := gm
    refine ⟨call2(Ring.mul(polynomialRing(K, {0})), polyC(K, c), p), gP, ?_⟩
    ext x
    constructor
    . intro xI
      have xP := bounded with x, xI
      have spec := polyDivision.spec at K, x, call2(Ring.mul(polynomialRing(K, {0})),
        polyC(K, c), p) with comm, polys, xP, gP, nontrivial, gMonic
      obtain ⟨decomp, rLT⟩ := spec
      have sel := polyDivision.selected at K, x, call2(Ring.mul(polynomialRing(K, {0})),
        polyC(K, c), p) with comm, nontrivial, xP, gMonic
      obtain ⟨⟨_, d0, d0In, r0, r0In, shape⟩, _⟩ := sel
      have dP : polyDivByMonic(K, x, call2(Ring.mul(polynomialRing(K, {0})),
          polyC(K, c), p)) ∈ Ring.carrier(polynomialRing(K, {0}))
        unfold polyDivByMonic
        rw shape
        rw fst.pair
        exact d0In
      have rLT2 := rLT
      unfold polyDegreeLT at rLT2
      obtain ⟨rP, rBelow⟩ := rLT2
      by_contra notMult
      have rNonzero : polyModByMonic(K, x, call2(Ring.mul(polynomialRing(K, {0})),
          polyC(K, c), p)) ≠ Ring.zero(polynomialRing(K, {0}))
        intro rz
        apply notMult
        rw rz at decomp
        apply ringMultiples.membership.backward
        refine ⟨xP, polyDivByMonic(K, x, call2(Ring.mul(polynomialRing(K, {0})),
          polyC(K, c), p)), dP, ?_⟩
        have e : call2(Ring.add(polynomialRing(K, {0})),
            call2(Ring.mul(polynomialRing(K, {0})), polyDivByMonic(K, x,
              call2(Ring.mul(polynomialRing(K, {0})), polyC(K, c), p)),
              call2(Ring.mul(polynomialRing(K, {0})), polyC(K, c), p)),
            Ring.zero(polynomialRing(K, {0}))) =
            call2(Ring.mul(polynomialRing(K, {0})), polyDivByMonic(K, x,
              call2(Ring.mul(polynomialRing(K, {0})), polyC(K, c), p)),
              call2(Ring.mul(polynomialRing(K, {0})), polyC(K, c), p)) by ring
        rw e at decomp
        exact decomp
      have dg := Ideal.mul_left_mem at polynomialRing(K, {0}), I,
        polyDivByMonic(K, x, call2(Ring.mul(polynomialRing(K, {0})), polyC(K, c), p)),
        call2(Ring.mul(polynomialRing(K, {0})), polyC(K, c), p) with pr, ideal, dP, gI
      have ndg := Ideal.neg_mem at polynomialRing(K, {0}), I,
        call2(Ring.mul(polynomialRing(K, {0})), polyDivByMonic(K, x,
        call2(Ring.mul(polynomialRing(K, {0})), polyC(K, c), p)),
        call2(Ring.mul(polynomialRing(K, {0})), polyC(K, c), p)) with ideal, dg
      have sum := Ideal.add_mem at polynomialRing(K, {0}), I, x,
        apply(Ring.neg(polynomialRing(K, {0})), call2(Ring.mul(polynomialRing(K, {0})),
        polyDivByMonic(K, x, call2(Ring.mul(polynomialRing(K, {0})), polyC(K, c), p)),
        call2(Ring.mul(polynomialRing(K, {0})), polyC(K, c), p))) with ideal, xI, ndg
      have t : call2(Ring.add(polynomialRing(K, {0})),
          call2(Ring.add(polynomialRing(K, {0})),
            call2(Ring.mul(polynomialRing(K, {0})), polyDivByMonic(K, x,
              call2(Ring.mul(polynomialRing(K, {0})), polyC(K, c), p)),
              call2(Ring.mul(polynomialRing(K, {0})), polyC(K, c), p)),
            polyModByMonic(K, x, call2(Ring.mul(polynomialRing(K, {0})), polyC(K, c), p))),
          apply(Ring.neg(polynomialRing(K, {0})), call2(Ring.mul(polynomialRing(K, {0})),
            polyDivByMonic(K, x, call2(Ring.mul(polynomialRing(K, {0})), polyC(K, c), p)),
            call2(Ring.mul(polynomialRing(K, {0})), polyC(K, c), p)))) =
          polyModByMonic(K, x, call2(Ring.mul(polynomialRing(K, {0})), polyC(K, c), p))
        by ring
      rw ← decomp at t
      rw t at sum
      have rDegN : polyNatDegree(K, polyModByMonic(K, x,
          call2(Ring.mul(polynomialRing(K, {0})), polyC(K, c), p))) ∈ ℕ by typecheck
      have rInD : polyNatDegree(K, polyModByMonic(K, x,
          call2(Ring.mul(polynomialRing(K, {0})), polyC(K, c), p))) ∈
          tkJIdealDegrees(K, I)
        apply tkJIdealDegrees.membership.backward
        exact ⟨rDegN, polyModByMonic(K, x, call2(Ring.mul(polynomialRing(K, {0})),
          polyC(K, c), p)), sum, rNonzero, rfl⟩
      have minimal := leastNatural.least at tkJIdealDegrees(K, I),
        polyNatDegree(K, polyModByMonic(K, x, call2(Ring.mul(polynomialRing(K, {0})),
        polyC(K, c), p))) with nonempty, naturals, rInD
      rw ← pDeg at minimal
      rw gDeg at rBelow
      have rSpec := uni.deg_spec at K, polyModByMonic(K, x,
        call2(Ring.mul(polynomialRing(K, {0})), polyC(K, c), p)) with comm, polys, rP
      have topNonzero := rSpec.right with rNonzero
      have topIn : polyNatDegree(K, polyModByMonic(K, x,
          call2(Ring.mul(polynomialRing(K, {0})), polyC(K, c), p))) ∈
          polyDegrees(K, polyModByMonic(K, x, call2(Ring.mul(polynomialRing(K, {0})),
          polyC(K, c), p)))
        unfold polyDegrees
        refine ⟨rDegN, ?_⟩
        unfold polyCoeff at topNonzero
        exact topNonzero
      have below := rBelow with polyNatDegree(K, polyModByMonic(K, x,
        call2(Ring.mul(polynomialRing(K, {0})), polyC(K, c), p))), topIn
      arith
    . intro xm
      obtain ⟨xP, d, dP, xEq⟩ := ringMultiples.membership.forward with xm
      rw xEq
      exact Ideal.mul_left_mem at polynomialRing(K, {0}), I, d,
        call2(Ring.mul(polynomialRing(K, {0})), polyC(K, c), p) with pr, ideal, dP, gI

-- A nonzero constant polynomial over a field is a unit.
theorem tkJ.gal_const_unit (K d : Set)
  requires field : Field(K)
  requires member : d ∈ Ring.carrier(polynomialRing(K, {0}))
  requires nonzero : d ≠ Ring.zero(polynomialRing(K, {0}))
  requires degree : polyNatDegree(K, d) = 0
  shows RingUnit(polynomialRing(K, {0}), d)
proof
  have comm := Field.to_comm_ring with field
  have polys := polynomialRing.comm_ring at K, {0} with comm
  have domainK := Field.domain with field
  have cl : d ∈ polyDegreeLT(K, 1)
    unfold polyDegreeLT
    refine ⟨member, ?_⟩
    intros k hk
    have sc := uni.deg_spec at K, d with comm, polys, member
    unfold polyDegrees at hk
    obtain ⟨kN, nzk⟩ := hk
    have kNat := nat.omega.backward with kN
    have nz2 : polyCoeff(d, k) ≠ Ring.zero(K)
      unfold polyCoeff
      exact nzk
    have le := sc.left with k, kN, nz2
    arith
  have dc := uni.const_of_lt_one at K, d with comm, polys, cl
  have sc := uni.deg_spec at K, d with comm, polys, member
  have lead := sc.right with nonzero
  rw degree at lead
  have c0 := uni.coeff_mem at K, d, 0 with comm, member
  obtain ⟨cInv, cInvIn, cProd⟩ := tkJ.field_inverse with field, c0, lead
  have cUnit : RingUnit(K, polyCoeff(d, 0))
    unfold RingUnit
    have swap : cInv * polyCoeff(d, 0) = polyCoeff(d, 0) * cInv by ring
    refine ⟨c0, cInv, cInvIn, cProd, ?_⟩
    rw swap
    exact cProd
  have cu := ringUnits.mem_of_unit at K, polyCoeff(d, 0) with cUnit
  exact (polynomialRing.unit_iff at K, d with comm, polys, member, domainK).backward with
    ⟨polyCoeff(d, 0), cu, dc⟩

-- An injective coefficient map keeps the degree of a nonzero polynomial.
theorem tkJ.gal_polyMap_degree (K L f d : Set)
  requires comm : CommRing(K)
  requires target : CommRing(L)
  requires hom : f : K →+* L
  requires injective : InjectiveBetween(f, Ring.carrier(K), Ring.carrier(L))
  requires member : d ∈ Ring.carrier(polynomialRing(K, {0}))
  requires nonzero : d ≠ Ring.zero(polynomialRing(K, {0}))
  shows polyMap(K, L, f)(d) ≠ Ring.zero(polynomialRing(L, {0})) ∧
    polyNatDegree(L, polyMap(K, L, f)(d)) = polyNatDegree(K, d)
proof
  have polys := polynomialRing.comm_ring at K, {0} with comm
  have polysL := polynomialRing.comm_ring at L, {0} with target
  have mapHom := polyMap.hom at K, L, f with comm, polys, target, hom
  have mIn := RingHom.map_mem with mapHom, member
  have h2 := hom
  obtain ⟨_, _, fF, _⟩ := h2
  have reflects : ∀ x ∈ Ring.carrier(K), f(x) = Ring.zero(L) → x = Ring.zero(K)
    intros x xK fx
    have zK : Ring.zero(K) ∈ Ring.carrier(K) by typecheck
    have f0 := RingHom.map_zero with hom
    have zL : Ring.zero(L) ∈ Ring.carrier(L) by typecheck
    have r1 := FunctionBetween.relates_apply with fF, xK
    have r2 := FunctionBetween.relates_apply with fF, zK
    rw fx at r1
    rw f0 at r2
    exact Injective.cancel with injective, xK, zK, zL, r1, r2
  have spec := uni.deg_spec at K, d with comm, polys, member
  have top := spec.right with nonzero
  have topIn := uni.coeff_mem at K, d, polyNatDegree(K, d) with comm, member
  have mTop := polyMap.coeff at K, L, f, d, polyNatDegree(K, d) with comm, polys, target,
    hom, member
  have mTopNonzero : polyCoeff(polyMap(K, L, f)(d), polyNatDegree(K, d)) ≠ Ring.zero(L)
    rw mTop
    intro z
    exact top with (reflects with polyCoeff(d, polyNatDegree(K, d)), topIn, z)
  have mNonzero : polyMap(K, L, f)(d) ≠ Ring.zero(polynomialRing(L, {0}))
    intro z
    rw z at mTopNonzero
    rw (uni.zero_coeff at L, polyNatDegree(K, d) with target, polysL) at mTopNonzero
    exact mTopNonzero with rfl
  have mSpec := uni.deg_spec at L, polyMap(K, L, f)(d) with target, polysL, mIn
  have degN : polyNatDegree(K, d) ∈ ℕ by typecheck
  have le1 := mSpec.left with polyNatDegree(K, d), degN, mTopNonzero
  have mTop2 := mSpec.right with mNonzero
  have mDegN : polyNatDegree(L, polyMap(K, L, f)(d)) ∈ ℕ by typecheck
  have mDegNat := nat.omega.backward with mDegN
  have c2 := polyMap.coeff at K, L, f, d, polyNatDegree(L, polyMap(K, L, f)(d)) with comm,
    polys, target, hom, member
  rw c2 at mTop2
  have cIn := uni.coeff_mem at K, d, polyNatDegree(L, polyMap(K, L, f)(d)) with comm,
    member
  have dNonzero : polyCoeff(d, polyNatDegree(L, polyMap(K, L, f)(d))) ≠ Ring.zero(K)
    intro z
    rw z at mTop2
    exact mTop2 with (RingHom.map_zero with hom)
  have le2 := spec.left with polyNatDegree(L, polyMap(K, L, f)(d)), mDegN, dNonzero
  refine ⟨mNonzero, ?_⟩
  exact LessEqual.antisymmetric with le2, le1

-- Section: Separable polynomials
section Separable
variable (K : Set)
hypothesis field : Field(K)

-- Polynomial.separable_X_sub_C, Polynomial.Separable.ne_zero.
theorem PolySeparable.X_sub_C (a : Set)
  requires point : a ∈ Ring.carrier(K)
  shows PolySeparable(K, polyXSubC(K, a))
proof
  have comm := Field.to_comm_ring with field
  have polys := polynomialRing.comm_ring at K, {0} with comm
  have zero : 0 ∈ {0} by simp [singleton.membership]
  have xIn := polyX.mem at K with comm, polys
  have cIn := polyC.mem at K, a with comm, polys, point
  have pIn := uni.XsubC_mem at K, a with comm, polys, point
  have negIn : -polyC(K, a) ∈ Ring.carrier(polynomialRing(K, {0})) by typecheck
  have sum := polyDerivative.add at K, polyX(K), -polyC(K, a) with comm, polys, xIn,
    negIn
  have negD : polyDerivative(K)(-polyC(K, a)) =
      apply(Ring.neg(polynomialRing(K, {0})), polyDerivative(K)(polyC(K, a)))
    unfold polyDerivative
    exact partialDerivative.neg at K, {0}, 0, polyC(K, a) with comm, polys, zero, cIn
  rw [negD, (polyDerivative.X at K with comm, polys),
    (polyDerivative.C at K, a with comm, polys, point)] at sum
  have simplify : call2(Ring.add(polynomialRing(K, {0})), Ring.one(polynomialRing(K, {0})),
      apply(Ring.neg(polynomialRing(K, {0})), Ring.zero(polynomialRing(K, {0})))) =
      Ring.one(polynomialRing(K, {0})) by ring
  rw simplify at sum
  have deriv : polyDerivative(K)(polyXSubC(K, a)) = Ring.one(polynomialRing(K, {0}))
    unfold polyXSubC
    unfold Ring.sub
    exact sum
  have pUni : polyXSubC(K, a) ∈ uniPolys(K)
    unfold uniPolys
    exact pIn
  have zeroP : Ring.zero(polynomialRing(K, {0})) ∈ uniPolys(K)
    unfold uniPolys
    typecheck
  have oneP : Ring.one(polynomialRing(K, {0})) ∈ uniPolys(K)
    unfold uniPolys
    typecheck
  unfold PolySeparable
  refine ⟨pUni, Ring.zero(polynomialRing(K, {0})), zeroP,
    Ring.one(polynomialRing(K, {0})), oneP, ?_⟩
  rw deriv
  ring

theorem PolySeparable.ne_zero (p : Set)
  requires separable : PolySeparable(K, p)
  shows p ≠ Ring.zero(polynomialRing(K, {0}))
proof
  have comm := Field.to_comm_ring with field
  have polys := polynomialRing.comm_ring at K, {0} with comm
  have parts := Field.parts with field
  have nt := IsField.nontrivial with parts
  obtain ⟨zeroK, oneK, distinct⟩ := nt
  obtain ⟨pUni, a, aUni, b, bUni, eq⟩ := separable
  intro pz
  have hom := polyC.hom at K with comm, polys
  have mz := RingHom.map_zero with hom
  have cz : polyC(K, Ring.zero(K)) = Ring.zero(polynomialRing(K, {0}))
    unfold polyC
    exact mz
  have dz : polyDerivative(K)(Ring.zero(polynomialRing(K, {0}))) =
      Ring.zero(polynomialRing(K, {0}))
    have d0 := polyDerivative.C at K, Ring.zero(K) with comm, polys, zeroK
    rw cz at d0
    exact d0
  rw pz at eq
  rw dz at eq
  have aP := aUni
  unfold uniPolys at aP
  have bP := bUni
  unfold uniPolys at bP
  have z : a * Ring.zero(polynomialRing(K, {0})) + b * Ring.zero(polynomialRing(K, {0})) =
    Ring.zero(polynomialRing(K, {0})) by ring
  rw z at eq
  have one := uni.one_eq at K with comm, polys
  rw [← cz, one] at eq
  have same := polyC.injective at K, Ring.zero(K), Ring.one(K) with comm, polys, zeroK,
    oneK, eq
  exact distinct with same

-- Polynomial.separable_map: separability does not change along a field
-- homomorphism.
theorem PolySeparable.map_iff (L f p : Set)
  requires target : Field(L)
  requires hom : f : K →+* L
  requires member : p ∈ uniPolys(K)
  shows PolySeparable(L, polyMap(K, L, f)(p)) ↔ PolySeparable(K, p)
proof
  have comm := Field.to_comm_ring with field
  have polys := polynomialRing.comm_ring at K, {0} with comm
  have commL := Field.to_comm_ring with target
  have polysL := polynomialRing.comm_ring at L, {0} with commL
  have domainL := Field.domain with target
  have domainLP := polynomialRing.domain at L with commL, polysL, domainL
  have dLP := domainLP
  obtain ⟨_, ntLP, _⟩ := dLP
  have mapHom := polyMap.hom at K, L, f with comm, polys, commL, hom
  have pIn := member
  unfold uniPolys at pIn
  have zero0 : 0 ∈ {0} by simp [singleton.membership]
  have dIn : polyDerivative(K)(p) ∈ Ring.carrier(polynomialRing(K, {0}))
    unfold polyDerivative
    exact partialDerivative.map_mem at K, {0}, 0, p with comm, polys, zero0, pIn
  have mpIn := RingHom.map_mem with mapHom, pIn
  have derivMap := polyDerivative.map at K, L, f, p with comm, polys, commL, hom, pIn
  have fieldParts := Field.parts with field
  have targetParts := Field.parts with target
  have targetComm := IsField.comm_ring with targetParts
  have ntL := IsField.nontrivial with targetParts
  have homParts := RingHom.parts with hom
  have injective := IsRingHom.field_injective with fieldParts, targetComm, ntL, homParts
  constructor
  . intro sepL
    obtain ⟨_, A, AU, B, BU, bez⟩ := sepL
    have AIn := AU
    unfold uniPolys at AIn
    have BIn := BU
    unfold uniPolys at BIn
    have pid := tkJ.gal_poly_pid with field
    have noCommon : ∀ d ∈ Ring.carrier(polynomialRing(K, {0})),
        RingDvd(polynomialRing(K, {0}), d, p) →
        RingDvd(polynomialRing(K, {0}), d, polyDerivative(K)(p)) →
        RingUnit(polynomialRing(K, {0}), d)
      intros d dK dp dd
      obtain ⟨_, _, e, eIn, pEq⟩ := dp
      obtain ⟨_, _, h, hIn, dEq⟩ := dd
      have mdIn := RingHom.map_mem with mapHom, dK
      have meIn := RingHom.map_mem with mapHom, eIn
      have mhIn := RingHom.map_mem with mapHom, hIn
      have mp : polyMap(K, L, f)(p) = polyMap(K, L, f)(d) * polyMap(K, L, f)(e)
        rw pEq
        exact RingHom.map_mul with mapHom, dK, eIn
      have md : polyMap(K, L, f)(polyDerivative(K)(p)) =
          polyMap(K, L, f)(d) * polyMap(K, L, f)(h)
        rw dEq
        exact RingHom.map_mul with mapHom, dK, hIn
      rw derivMap at md
      rw [md, mp] at bez
      have rearr : A * (polyMap(K, L, f)(d) * polyMap(K, L, f)(e)) +
          B * (polyMap(K, L, f)(d) * polyMap(K, L, f)(h)) =
          polyMap(K, L, f)(d) * (A * polyMap(K, L, f)(e) + B * polyMap(K, L, f)(h)) by ring
      rw rearr at bez
      have wIn : A * polyMap(K, L, f)(e) + B * polyMap(K, L, f)(h) ∈
        Ring.carrier(polynomialRing(L, {0})) by typecheck
      have swap : (A * polyMap(K, L, f)(e) + B * polyMap(K, L, f)(h)) *
          polyMap(K, L, f)(d) =
          polyMap(K, L, f)(d) * (A * polyMap(K, L, f)(e) + B * polyMap(K, L, f)(h)) by ring
      have mdUnit : RingUnit(polynomialRing(L, {0}), polyMap(K, L, f)(d))
        unfold RingUnit
        refine ⟨mdIn, A * polyMap(K, L, f)(e) + B * polyMap(K, L, f)(h), wIn, bez, ?_⟩
        rw swap
        exact bez
      have dNonzero : d ≠ Ring.zero(polynomialRing(K, {0}))
        intro dz
        have m0 := RingHom.map_zero with mapHom
        rw [dz, m0] at bez
        have z : Ring.zero(polynomialRing(L, {0})) *
            (A * polyMap(K, L, f)(e) + B * polyMap(K, L, f)(h)) =
            Ring.zero(polynomialRing(L, {0})) by ring
        rw z at bez
        exact ntLP with bez
      have degs := tkJ.gal_polyMap_degree with comm, commL, hom, injective, dK, dNonzero
      obtain ⟨_, degEq⟩ := degs
      obtain ⟨u, uIn, uEq⟩ := (polynomialRing.unit_iff at L, polyMap(K, L, f)(d) with
        commL, polysL, mdIn, domainL).forward with mdUnit
      obtain ⟨uL, _⟩ := ringUnits.membership.forward with uIn
      have d0 := polyNatDegree.C at L, u with commL, polysL, uL
      rw ← uEq at d0
      rw degEq at d0
      exact tkJ.gal_const_unit with field, dK, dNonzero, d0
    have coprime := PrincipalIdealDomain.coprime_of_no_common_divisor at
      polynomialRing(K, {0}), p, polyDerivative(K)(p) with pid, pIn, dIn, noCommon
    obtain ⟨_, _, u, uIn, v, vIn, bezout⟩ := coprime
    have uUni : u ∈ uniPolys(K)
      unfold uniPolys
      exact uIn
    have vUni : v ∈ uniPolys(K)
      unfold uniPolys
      exact vIn
    unfold PolySeparable
    exact ⟨member, u, uUni, v, vUni, bezout⟩
  . intro sep
    obtain ⟨_, a, aU, b, bU, eq⟩ := sep
    have aIn := aU
    unfold uniPolys at aIn
    have bIn := bU
    unfold uniPolys at bIn
    have maIn := RingHom.map_mem with mapHom, aIn
    have mbIn := RingHom.map_mem with mapHom, bIn
    have apIn : a * p ∈ Ring.carrier(polynomialRing(K, {0})) by typecheck
    have bdIn : b * polyDerivative(K)(p) ∈ Ring.carrier(polynomialRing(K, {0}))
      by typecheck
    have mapped : polyMap(K, L, f)(a * p + b * polyDerivative(K)(p)) =
        polyMap(K, L, f)(Ring.one(polynomialRing(K, {0})))
      rw eq
    rw [(RingHom.map_add with mapHom, apIn, bdIn), (RingHom.map_mul with mapHom, aIn, pIn),
      (RingHom.map_mul with mapHom, bIn, dIn), (RingHom.map_one with mapHom),
      derivMap] at mapped
    have mpUni : polyMap(K, L, f)(p) ∈ uniPolys(L)
      unfold uniPolys
      exact mpIn
    have maUni : polyMap(K, L, f)(a) ∈ uniPolys(L)
      unfold uniPolys
      exact maIn
    have mbUni : polyMap(K, L, f)(b) ∈ uniPolys(L)
      unfold uniPolys
      exact mbIn
    unfold PolySeparable
    exact ⟨mpUni, polyMap(K, L, f)(a), maUni, polyMap(K, L, f)(b), mbUni, mapped⟩

-- Polynomial.separable_prod_X_sub_C_iff: Π (X − aᵢ) is separable iff the
-- aᵢ are distinct.
theorem PolySeparable.linear_product_iff (a : Set) (n : Nat)
  requires points : a : n → Ring.carrier(K)
  shows PolySeparable(K, polyLinearProduct(K, a, n)) ↔
    InjectiveBetween(a, n, Ring.carrier(K))
proof
  sorry

-- Polynomial.nodup_roots, card_rootSet_eq_natDegree: a separable
-- polynomial that splits has deg p distinct roots.
theorem PolySeparable.card_roots (E p : Set)
  requires extension : FieldExtension(E)
  requires base : Algebra.base(E) = K
  requires separable : PolySeparable(K, p)
  requires splits : PolySplits(K, Algebra.ring(E), Algebra.map(E), p)
  shows HasCardinality(polyAlgebraRootSet(E, p), polyNatDegree(K, p))
proof
  sorry

-- An irreducible polynomial over a field of characteristic zero is
-- separable (Irreducible.separable with CharZero), stated as: if
-- n·1 ≠ 0 for every n ≥ 1.
theorem PolySeparable.of_irreducible_char_zero (p : Set)
  requires charZero : ∀ n ∈ ℕ, 0 < n →
    ringNat(Ring.add(K), Ring.zero(K), Ring.one(K), n) ≠ Ring.zero(K)
  requires irreducible : RingIrreducible(polynomialRing(K, {0}), p)
  shows PolySeparable(K, p)
proof
  have comm := Field.to_comm_ring with field
  have polys := polynomialRing.comm_ring at K, {0} with comm
  have domainK := Field.domain with field
  have domainP := polynomialRing.domain at K with comm, polys, domainK
  have dP2 := domainP
  obtain ⟨_, ntP, _⟩ := dP2
  have dK2 := domainK
  obtain ⟨_, _, noZeroK⟩ := dK2
  have parts := Field.parts with field
  have nt := IsField.nontrivial with parts
  obtain ⟨zeroK, oneK, distinct⟩ := nt
  have pid := tkJ.gal_poly_pid with field
  have irr := irreducible
  obtain ⟨pIn, notUnit, factors⟩ := irr
  have zeroP : Ring.zero(polynomialRing(K, {0})) ∈ Ring.carrier(polynomialRing(K, {0}))
    by typecheck
  have oneP : Ring.one(polynomialRing(K, {0})) ∈ Ring.carrier(polynomialRing(K, {0}))
    by typecheck
  have pNonzero : p ≠ Ring.zero(polynomialRing(K, {0}))
    intro pz
    have z : p = Ring.zero(polynomialRing(K, {0})) * Ring.zero(polynomialRing(K, {0}))
      rw pz
      ring
    have alt := factors with Ring.zero(polynomialRing(K, {0})), zeroP,
      Ring.zero(polynomialRing(K, {0})), zeroP, z
    have u : RingUnit(polynomialRing(K, {0}), Ring.zero(polynomialRing(K, {0})))
      cases alt with u1 | u2
      . exact u1
      . exact u2
    obtain ⟨_, b, bIn, prod, _⟩ := u
    have zb : Ring.zero(polynomialRing(K, {0})) * b = Ring.zero(polynomialRing(K, {0}))
      by ring
    rw zb at prod
    exact ntP with prod
  -- the degree is positive
  have pDegPos : polyNatDegree(K, p) ≠ 0
    intro d0
    apply notUnit
    have cl : p ∈ polyDegreeLT(K, 1)
      unfold polyDegreeLT
      refine ⟨pIn, ?_⟩
      intros k hk
      have sc := uni.deg_spec at K, p with comm, polys, pIn
      unfold polyDegrees at hk
      obtain ⟨kN, nzk⟩ := hk
      have kNat := nat.omega.backward with kN
      have nz2 : polyCoeff(p, k) ≠ Ring.zero(K)
        unfold polyCoeff
        exact nzk
      have le := sc.left with k, kN, nz2
      arith
    have pc := uni.const_of_lt_one at K, p with comm, polys, cl
    have sc := uni.deg_spec at K, p with comm, polys, pIn
    have lead := sc.right with pNonzero
    rw d0 at lead
    have c0 := uni.coeff_mem at K, p, 0 with comm, pIn
    obtain ⟨cInv, cInvIn, cProd⟩ := tkJ.field_inverse with field, c0, lead
    have cUnit : RingUnit(K, polyCoeff(p, 0))
      unfold RingUnit
      have swap : cInv * polyCoeff(p, 0) = polyCoeff(p, 0) * cInv by ring
      refine ⟨c0, cInv, cInvIn, cProd, ?_⟩
      rw swap
      exact cProd
    have cu := ringUnits.mem_of_unit at K, polyCoeff(p, 0) with cUnit
    exact (polynomialRing.unit_iff at K, p with comm, polys, pIn, domainK).backward with
      ⟨polyCoeff(p, 0), cu, pc⟩
  -- the derivative is nonzero of smaller degree
  have zero0 : 0 ∈ {0} by simp [singleton.membership]
  have dIn : polyDerivative(K)(p) ∈ Ring.carrier(polynomialRing(K, {0}))
    unfold polyDerivative
    exact partialDerivative.map_mem at K, {0}, 0, p with comm, polys, zero0, pIn
  have degPos : 0 < polyNatDegree(K, p) by arith
  obtain ⟨j, jN, jEq⟩ := intHelp.pred at polyNatDegree(K, p) with degPos
  have jNat := nat.omega.backward with jN
  have spec := uni.deg_spec at K, p with comm, polys, pIn
  have leadNonzero := spec.right with pNonzero
  have topCoeff := polyDerivative.coeff at K, p, j with comm, polys, pIn
  have sj : succ(j) = j + 1 by arith
  rw [sj, ← jEq] at topCoeff
  have leadIn := uni.coeff_mem at K, p, polyNatDegree(K, p) with comm, pIn
  have degN : polyNatDegree(K, p) ∈ ℕ by typecheck
  have numeralNonzero := charZero with polyNatDegree(K, p), degN, degPos
  have numeralIn : ringNat(Ring.add(K), Ring.zero(K), Ring.one(K),
    polyNatDegree(K, p)) ∈ Ring.carrier(K) by typecheck
  have topNonzero : polyCoeff(polyDerivative(K)(p), j) ≠ Ring.zero(K)
    rw topCoeff
    intro z
    have alt := noZeroK with polyCoeff(p, polyNatDegree(K, p)), leadIn,
      ringNat(Ring.add(K), Ring.zero(K), Ring.one(K), polyNatDegree(K, p)), numeralIn, z
    cases alt with a | b
    . exact leadNonzero with a
    . exact numeralNonzero with b
  have dNonzero : polyDerivative(K)(p) ≠ Ring.zero(polynomialRing(K, {0}))
    intro dz
    rw dz at topNonzero
    rw (uni.zero_coeff at K, j with comm, polys) at topNonzero
    exact topNonzero with rfl
  have dDegLe : polyNatDegree(K, polyDerivative(K)(p)) ≤ j
    have dSpec := uni.deg_spec at K, polyDerivative(K)(p) with comm, polys, dIn
    have dTop := dSpec.right with dNonzero
    by_contra big
    have dNat : polyNatDegree(K, polyDerivative(K)(p)) ∈ ℕ by typecheck
    have dNat2 := nat.omega.backward with dNat
    have coeffD := polyDerivative.coeff at K, p, polyNatDegree(K, polyDerivative(K)(p))
      with comm, polys, pIn
    have vanish := uni.vanish_deg at K, p with comm, polys, pIn
    have sN : succ(polyNatDegree(K, polyDerivative(K)(p))) ∈ ℕ by typecheck
    have lt : polyNatDegree(K, p) < succ(polyNatDegree(K, polyDerivative(K)(p))) by arith
    have v := vanish with succ(polyNatDegree(K, polyDerivative(K)(p))), sN, lt
    rw v at coeffD
    have numIn : ringNat(Ring.add(K), Ring.zero(K), Ring.one(K),
      succ(polyNatDegree(K, polyDerivative(K)(p)))) ∈ Ring.carrier(K) by typecheck
    have z : Ring.zero(K) * ringNat(Ring.add(K), Ring.zero(K), Ring.one(K),
      succ(polyNatDegree(K, polyDerivative(K)(p)))) = Ring.zero(K) by ring
    rw z at coeffD
    exact dTop with coeffD
  -- p and its derivative have no common nonunit divisor
  have noCommon : ∀ d ∈ Ring.carrier(polynomialRing(K, {0})),
      RingDvd(polynomialRing(K, {0}), d, p) →
      RingDvd(polynomialRing(K, {0}), d, polyDerivative(K)(p)) →
      RingUnit(polynomialRing(K, {0}), d)
    intros d dIn2 dp dd
    obtain ⟨_, _, e, eIn, pEq⟩ := dp
    have alt := factors with d, dIn2, e, eIn, pEq
    cases alt with du | eu
    . exact du
    . exfalso
      obtain ⟨_, f, fIn, ef, _⟩ := eu
      obtain ⟨_, _, h, hIn, dEq⟩ := dd
      have t1 : p * f = d * (e * f)
        rw pEq
        ring
      rw ef at t1
      have u1 : d * Ring.one(polynomialRing(K, {0})) = d by ring
      rw u1 at t1
      have t2 : polyDerivative(K)(p) = p * (f * h)
        rw dEq
        rw ← t1
        ring
      have fh : f * h ∈ Ring.carrier(polynomialRing(K, {0})) by typecheck
      have fhNonzero : f * h ≠ Ring.zero(polynomialRing(K, {0}))
        intro z
        rw z at t2
        have zz : p * Ring.zero(polynomialRing(K, {0})) = Ring.zero(polynomialRing(K, {0}))
          by ring
        rw zz at t2
        exact dNonzero with t2
      have degMul := polyNatDegree.mul at K, p, f * h with comm, polys, pIn, fh, domainK,
        pNonzero, fhNonzero
      rw ← t2 at degMul
      arith
  have coprime := PrincipalIdealDomain.coprime_of_no_common_divisor at
    polynomialRing(K, {0}), p, polyDerivative(K)(p) with pid, pIn, dIn, noCommon
  obtain ⟨_, _, u, uIn, v, vIn, bezout⟩ := coprime
  have pUni : p ∈ uniPolys(K)
    unfold uniPolys
    exact pIn
  have uUni : u ∈ uniPolys(K)
    unfold uniPolys
    exact uIn
  have vUni : v ∈ uniPolys(K)
    unfold uniPolys
    exact vIn
  unfold PolySeparable
  exact ⟨pUni, u, uUni, v, vUni, bezout⟩

end Separable

-- Helpers: projections of the Galois group and automorphisms as ring maps.
theorem tkJ.galois_carrier (E : Set)
  shows Group.carrier(galoisGroup(E)) = algebraAutomorphisms(E)
proof
  simp [galoisGroup, Group.mk.carrier]

theorem tkJ.galois_mul (E : Set)
  shows Group.mul(galoisGroup(E)) = autComposition(E)
proof
  simp [galoisGroup, Group.mk.mul]

theorem tkJ.galois_one (E : Set)
  shows Group.one(galoisGroup(E)) = identity(algebraCarrier(E))
proof
  simp [galoisGroup, Group.mk.one]

theorem tkJ.galois_inv (E : Set)
  shows Group.inv(galoisGroup(E)) = autInverse(E)
proof
  simp [galoisGroup, Group.mk.inv]

theorem tkJ.aut_ring_hom (E σ : Set)
  requires member : σ ∈ algebraAutomorphisms(E)
  shows σ : Algebra.ring(E) →+* Algebra.ring(E)
proof
  have iso := (tkJ.aut_member at E, σ).forward with member
  obtain ⟨hom, bijective⟩ := iso
  exact AlgebraHom.ring_hom with hom

theorem tkJ.aut_converse_fix (E σ x : Set)
  requires member : σ ∈ algebraAutomorphisms(E)
  requires point : x ∈ algebraCarrier(E)
  requires fixed : σ(x) = x
  shows converse(σ, algebraCarrier(E), algebraCarrier(E))(x) = x
proof
  have bij := tkJ.aut_bijective with member
  have back := Bijective.inverse_apply with bij, point
  rw fixed at back
  exact back

-- A ring endomorphism stable on a subring restricts to the subring.
theorem tkJ.gal_restrict_ring_hom (R F σ : Set)
  requires comm : CommRing(R)
  requires subring : Subring(R, F)
  requires hom : σ : R →+* R
  requires stable : ∀ x ∈ F, σ(x) ∈ F
  shows restrict(σ, F) : subringRing(R, F) →+* subringRing(R, F)
proof
  have commF := subringRing.comm_ring with comm, subring
  have parts := Subring.parts with subring
  have ringParts := CommRing.parts with comm
  have bounded := IsSubring.subset_carrier with parts
  have h2 := hom
  obtain ⟨_, _, σF, _⟩ := h2
  have rF := restrict.function with σF, bounded, stable
  have addMagma : IsMagma(Ring.carrier(R), Ring.add(R)) by
    simp [IsCommRing, IsRing, IsAbelianGroup, IsGroup, IsMonoid, IsSemigroup]
  have mulMagma : IsMagma(Ring.carrier(R), Ring.mul(R)) by
    simp [IsCommRing, IsRing, IsMonoid, IsSemigroup]
  have addOf : Ring.add(subringRing(R, F)) = restrict(Ring.add(R), F × F)
    simp [subringRing, Ring.mk.add]
  have mulOf : Ring.mul(subringRing(R, F)) = restrict(Ring.mul(R), F × F)
    simp [subringRing, Ring.mk.mul]
  have oneOf : Ring.one(subringRing(R, F)) = Ring.one(R)
    simp [subringRing, Ring.mk.one]
  have addClosed := IsSubring.add_closed with parts
  have mulClosed := IsSubring.mul_closed with parts
  have oneF := IsSubring.one_closed with parts
  apply RingHom.mk with commF, commF
  . rw subringRing.carrierOf
    exact rF
  . intros x xIn y yIn
    rw subringRing.carrierOf at xIn
    rw subringRing.carrierOf at yIn
    have xy := addClosed with x, xIn, y, yIn
    have sx := stable with x, xIn
    have sy := stable with y, yIn
    have xL := bounded with x, xIn
    have yL := bounded with y, yIn
    rw [addOf, (restrictBinary.value_on_subset with addMagma, bounded, xIn, yIn),
      (restrict.apply with σF, bounded, stable, xy),
      (restrict.apply with σF, bounded, stable, xIn),
      (restrict.apply with σF, bounded, stable, yIn),
      (restrictBinary.value_on_subset with addMagma, bounded, sx, sy)]
    exact RingHom.map_add with hom, xL, yL
  . intros x xIn y yIn
    rw subringRing.carrierOf at xIn
    rw subringRing.carrierOf at yIn
    have xy := mulClosed with x, xIn, y, yIn
    have sx := stable with x, xIn
    have sy := stable with y, yIn
    have xL := bounded with x, xIn
    have yL := bounded with y, yIn
    rw [mulOf, (restrictBinary.value_on_subset with mulMagma, bounded, xIn, yIn),
      (restrict.apply with σF, bounded, stable, xy),
      (restrict.apply with σF, bounded, stable, xIn),
      (restrict.apply with σF, bounded, stable, yIn),
      (restrictBinary.value_on_subset with mulMagma, bounded, sx, sy)]
    exact RingHom.map_mul with hom, xL, yL
  . rw [oneOf, (restrict.apply with σF, bounded, stable, oneF)]
    exact RingHom.map_one with hom

-- The coefficient map sends a product of linear factors to the product of
-- the image factors.
theorem tkJ.gal_map_linear_product (R S f a b : Set) (n : Nat)
  requires comm : CommRing(R)
  requires target : CommRing(S)
  requires hom : f : R →+* S
  requires pointsA : a : n → Ring.carrier(R)
  requires pointsB : b : n → Ring.carrier(S)
  requires values : ∀ i ∈ n, b(i) = f(a(i))
  shows polyMap(R, S, f)(polyLinearProduct(R, a, n)) = polyLinearProduct(S, b, n)
proof
  have polys := polynomialRing.comm_ring at R, {0} with comm
  have polysS := polynomialRing.comm_ring at S, {0} with target
  have mapHom := polyMap.hom at R, S, f with comm, polys, target, hom
  have sourceParts := CommRing.parts with polys
  have targetParts := CommRing.parts with polysS
  have homParts := RingHom.parts with mapHom
  have fin := Finite.natural at n
  have wf := linearFactorFamily.function at R, a, n with comm, pointsA
  have vf := linearFactorFamily.function at S, b, n with target, pointsB
  have entries : ∀ i ∈ n, linearFactorFamily(S, b, n)(i) =
      polyMap(R, S, f)(linearFactorFamily(R, a, n)(i))
    intros i hi
    rw [(linearFactorFamily.value at S, b, n, i with target, pointsB, hi),
      (linearFactorFamily.value at R, a, n, i with comm, pointsA, hi)]
    have ai := FunctionBetween.apply_closed with pointsA, hi
    have xIn := polyX.mem at R with comm, polys
    have cIn := polyC.mem at R, a(i) with comm, polys, ai
    unfold polyXSubC
    rw (RingHom.map_sub with mapHom, xIn, cIn)
    rw [(polyMap.X at R, S, f with comm, polys, target, hom),
      (polyMap.C at R, S, f, a(i) with comm, polys, target, hom, ai), (values with i, hi)]
  unfold polyLinearProduct
  exact finiteRingProduct.map with sourceParts, targetParts, homParts, fin, wf, vf, entries

-- Section: Galois theory
section GaloisTheory
variable (E : Set)
hypothesis extension : FieldExtension(E)

-- The fixed field is an intermediate field; the fixing subgroup is a
-- subgroup (FixedPoints.intermediateField, IntermediateField.fixingSubgroup).
theorem fixedField.intermediate (H : Set)
  requires subset : H ⊆ algebraAutomorphisms(E)
  shows IntermediateField(E, fixedField(E, H))
proof
  have ext2 := extension
  obtain ⟨algebra, baseField, ringField⟩ := ext2
  have comm := Algebra.comm_ring with algebra
  have bounded : fixedField(E, H) ⊆ algebraCarrier(E)
    intros x xIn
    obtain ⟨xL, _⟩ := fixedField.membership.forward with xIn
    exact xL
  have fixes : ∀ x ∈ fixedField(E, H), ∀ σ ∈ H, σ(x) = x
    intros x xIn σ σH
    obtain ⟨xL, all⟩ := fixedField.membership.forward with xIn
    exact all with σ, σH
  have top := IntermediateField.top with extension
  have whole := tkJ.intermediate_subring with top
  unfold IntermediateField
  refine ⟨extension, ?_, ?_⟩
  . unfold SubalgebraOf
    refine ⟨algebra, ?_⟩
    unfold Subalgebra
    constructor
    . unfold IsSubring
      refine ⟨bounded, _, _, _, _, _⟩
      . have zeroL := IsSubring.zero_closed with whole
        apply fixedField.membership.backward
        refine ⟨zeroL, ?_⟩
        intros σ σH
        have σA := subset with σ, σH
        have hom := tkJ.aut_ring_hom with σA
        exact RingHom.map_zero with hom
      . have oneL := IsSubring.one_closed with whole
        apply fixedField.membership.backward
        refine ⟨oneL, ?_⟩
        intros σ σH
        have σA := subset with σ, σH
        have hom := tkJ.aut_ring_hom with σA
        exact RingHom.map_one with hom
      . unfold ClosedUnary
        intros x xIn
        have xL := bounded with x, xIn
        have negL := IsSubring.neg_closed with whole
        have valueL := negL with x, xL
        apply fixedField.membership.backward
        refine ⟨valueL, ?_⟩
        intros σ σH
        have σA := subset with σ, σH
        have hom := tkJ.aut_ring_hom with σA
        have fx := fixes with x, xIn, σ, σH
        unfold algebraCarrier at xL
        rw RingHom.map_neg at σ, Algebra.ring(E), Algebra.ring(E), x with hom, xL
        rw fx
      . unfold ClosedBinary
        intros x xIn y yIn
        have xL := bounded with x, xIn
        have yL := bounded with y, yIn
        have addL := IsSubring.add_closed with whole
        have valueL := addL with x, xL, y, yL
        apply fixedField.membership.backward
        refine ⟨valueL, ?_⟩
        intros σ σH
        have σA := subset with σ, σH
        have hom := tkJ.aut_ring_hom with σA
        have fx := fixes with x, xIn, σ, σH
        have fy := fixes with y, yIn, σ, σH
        unfold algebraCarrier at xL
        unfold algebraCarrier at yL
        rw RingHom.map_add at σ, Algebra.ring(E), Algebra.ring(E), x, y with hom, xL, yL
        rw [fx, fy]
      . unfold ClosedBinary
        intros x xIn y yIn
        have xL := bounded with x, xIn
        have yL := bounded with y, yIn
        have mulL := IsSubring.mul_closed with whole
        have valueL := mulL with x, xL, y, yL
        apply fixedField.membership.backward
        refine ⟨valueL, ?_⟩
        intros σ σH
        have σA := subset with σ, σH
        have hom := tkJ.aut_ring_hom with σA
        have fx := fixes with x, xIn, σ, σH
        have fy := fixes with y, yIn, σ, σH
        unfold algebraCarrier at xL
        unfold algebraCarrier at yL
        rw RingHom.map_mul at σ, Algebra.ring(E), Algebra.ring(E), x, y with hom, xL, yL
        rw [fx, fy]
    . intros y yIn
      have imageL := functionImage.subset at Algebra.map(E),
        Ring.carrier(Algebra.base(E)), algebraCarrier(E)
      have yL := imageL with y, yIn
      obtain ⟨_, a, aIn, yEq⟩ := functionImage.membership.forward with yIn
      apply fixedField.membership.backward
      refine ⟨yL, ?_⟩
      intros σ σH
      have σA := subset with σ, σH
      have iso := (tkJ.aut_member at E, σ).forward with σA
      obtain ⟨hom, bijective⟩ := iso
      rw yEq
      exact AlgebraHom.map_base with hom, aIn
  . intros x xIn nonzero
    have xL := bounded with x, xIn
    unfold algebraCarrier at xL
    obtain ⟨y, yL, product⟩ := tkJ.field_inverse with ringField, xL, nonzero
    refine ⟨y, ?_, product⟩
    have yL2 : y ∈ algebraCarrier(E)
      unfold algebraCarrier
      exact yL
    apply fixedField.membership.backward
    refine ⟨yL2, ?_⟩
    intros σ σH
    have σA := subset with σ, σH
    have hom := tkJ.aut_ring_hom with σA
    have fx := fixes with x, xIn, σ, σH
    have σyL := RingHom.map_mem at σ, Algebra.ring(E), Algebra.ring(E), y with hom, yL
    have mapped := RingHom.map_mul at σ, Algebra.ring(E), Algebra.ring(E), x, y with hom, xL, yL
    have one := RingHom.map_one with hom
    rw [product, one, fx] at mapped
    have flipped : call2(Ring.mul(Algebra.ring(E)), x, σ(y)) = Ring.one(Algebra.ring(E))
      rw mapped
    exact tkJ.inverse_unique with comm, xL, σyL, yL, flipped, product

theorem fixingSubgroup.subgroup (F : Set)
  requires subset : F ⊆ algebraCarrier(E)
  shows Subgroup(fixingSubgroup(E, F), galoisGroup(E))
proof
  have group := galoisGroup.group with extension
  have ext2 := extension
  obtain ⟨algebra, baseField, ringField⟩ := ext2
  have idIso := AlgebraIso.identity with algebra
  have oneIn := (tkJ.aut_member at E, identity(algebraCarrier(E))).backward with idIso
  have bounded : fixingSubgroup(E, F) ⊆ algebraAutomorphisms(E)
    intros σ σIn
    obtain ⟨σA, _⟩ := fixingSubgroup.membership.forward with σIn
    exact σA
  unfold Subgroup
  rw [tkJ.galois_carrier, tkJ.galois_one, tkJ.galois_mul, tkJ.galois_inv]
  refine ⟨group, bounded, _, _, _⟩
  . apply fixingSubgroup.membership.backward
    refine ⟨oneIn, ?_⟩
    intros x xF
    have xL := subset with x, xF
    exact identity.apply with xL
  . intros σ σIn τ τIn
    have σA := bounded with σ, σIn
    have τA := bounded with τ, τIn
    obtain ⟨_, σfix⟩ := fixingSubgroup.membership.forward with σIn
    obtain ⟨_, τfix⟩ := fixingSubgroup.membership.forward with τIn
    have mem := tkJ.aut_compose_mem with σA, τA
    rw (tkJ.autComposition_apply with σA, τA)
    apply fixingSubgroup.membership.backward
    refine ⟨mem, ?_⟩
    intros x xF
    have xL := subset with x, xF
    have fσ := tkJ.aut_function with σA
    have fτ := tkJ.aut_function with τA
    rw (compose.apply with fτ, fσ, xL)
    have tx := τfix with x, xF
    rw tx
    exact σfix with x, xF
  . intros σ σIn
    have σA := bounded with σ, σIn
    obtain ⟨_, σfix⟩ := fixingSubgroup.membership.forward with σIn
    have mem := tkJ.aut_converse_mem with σA
    rw (tkJ.autInverse_apply with σA)
    apply fixingSubgroup.membership.backward
    refine ⟨mem, ?_⟩
    intros x xF
    have xL := subset with x, xF
    have sx := σfix with x, xF
    exact tkJ.aut_converse_fix with σA, xL, sx

-- mem_fixingSubgroup_iff and the Galois connection
-- (IntermediateField.gc): F ⊆ fixedField(H) iff H ⊆ fixingSubgroup(F).
theorem fixingSubgroup.galois_connection (F H : Set)
  requires fieldSubset : F ⊆ algebraCarrier(E)
  requires groupSubset : H ⊆ algebraAutomorphisms(E)
  shows F ⊆ fixedField(E, H) ↔ H ⊆ fixingSubgroup(E, F)
proof
  constructor
  . intro le
    intros σ σH
    have σA := groupSubset with σ, σH
    apply fixingSubgroup.membership.backward
    refine ⟨σA, ?_⟩
    intros x xF
    have xFixed := le with x, xF
    obtain ⟨_, all⟩ := fixedField.membership.forward with xFixed
    exact all with σ, σH
  . intro le
    intros x xF
    have xL := fieldSubset with x, xF
    apply fixedField.membership.backward
    refine ⟨xL, ?_⟩
    intros σ σH
    have σFix := le with σ, σH
    obtain ⟨_, all⟩ := fixingSubgroup.membership.forward with σFix
    exact all with x, xF

-- IntermediateField.forall_mem_adjoin_smul_eq_self_iff: σ fixes K(S)
-- iff σ fixes S.
theorem fixingSubgroup.adjoin (S : Set)
  requires subset : S ⊆ algebraCarrier(E)
  shows fixingSubgroup(E, fieldAdjoin(E, S)) = fixingSubgroup(E, S)
proof
  have sS := fieldAdjoin.subset_adjoin with extension, subset
  apply Subset.antisymmetric
  . intros σ σIn
    obtain ⟨σA, all⟩ := fixingSubgroup.membership.forward with σIn
    apply fixingSubgroup.membership.backward
    refine ⟨σA, ?_⟩
    intros x xS
    exact all with x, (sS with x, xS)
  . intros σ σIn
    obtain ⟨σA, all⟩ := fixingSubgroup.membership.forward with σIn
    have single : {σ} ⊆ algebraAutomorphisms(E)
      intros τ τIn
      have same := singleton.membership.forward with τIn
      rw same
      exact σA
    have inter := fixedField.intermediate with extension, single
    have contains : S ⊆ fixedField(E, {σ})
      intros x xS
      have xL := subset with x, xS
      apply fixedField.membership.backward
      refine ⟨xL, ?_⟩
      intros τ τIn
      have same := singleton.membership.forward with τIn
      rw same
      exact all with x, xS
    have le := (fieldAdjoin.le_iff with extension, subset, inter).backward with contains
    apply fixingSubgroup.membership.backward
    refine ⟨σA, ?_⟩
    intros x xK
    have xFixed := le with x, xK
    obtain ⟨_, fixes⟩ := fixedField.membership.forward with xFixed
    have σσ := singleton.membership.backward at σ, σ with rfl
    exact fixes with σ, σσ

-- IsGalois.card_aut_eq_finrank: |Gal(L/K)| = [L : K] for a finite
-- Galois extension, and the converse (IsGalois.of_card_aut_eq_finrank).
theorem GaloisExtension.card_aut
  requires finite : FiniteExtension(E)
  requires galois : GaloisExtension(E)
  shows order(galoisGroup(E)) = extensionDegree(E)
proof
  sorry

theorem GaloisExtension.of_card_aut
  requires finite : FiniteExtension(E)
  requires card : order(galoisGroup(E)) = extensionDegree(E)
  shows GaloisExtension(E)
proof
  sorry

-- IsGalois.mem_bot_iff_fixed, IsGalois.fixedField_top: the elements
-- fixed by all of Gal(L/K) are those of K.
theorem GaloisExtension.fixed_iff_bottom (x : Set)
  requires galois : GaloisExtension(E)
  requires point : x ∈ algebraCarrier(E)
  shows x ∈ bottomField(E) ↔ (∀ σ ∈ algebraAutomorphisms(E), σ(x) = x)
proof
  sorry

-- The fundamental theorem for finite Galois extensions
-- (IsGalois.fixedField_fixingSubgroup, IsGalois.fixingSubgroup_fixedField,
-- IsGalois.intermediateFieldEquivSubgroup).
theorem GaloisExtension.fixedField_fixingSubgroup (F : Set)
  requires finite : FiniteExtension(E)
  requires galois : GaloisExtension(E)
  requires intermediate : IntermediateField(E, F)
  shows fixedField(E, fixingSubgroup(E, F)) = F
proof
  sorry

theorem GaloisExtension.fixingSubgroup_fixedField (H : Set)
  requires finite : FiniteExtension(E)
  requires galois : GaloisExtension(E)
  requires subgroup : Subgroup(H, galoisGroup(E))
  shows fixingSubgroup(E, fixedField(E, H)) = H
proof
  sorry

-- [F : K] = [Gal(L/K) : Gal(L/F)] (IntermediateField.finrank_eq_fixingSubgroup_index)
-- and [L : F] = |Gal(L/F)| (IntermediateField.finrank_fixedField_eq_card,
-- IsGalois.card_fixingSubgroup_eq_finrank).
theorem GaloisExtension.degree_eq_index (F : Set)
  requires finite : FiniteExtension(E)
  requires galois : GaloisExtension(E)
  requires intermediate : IntermediateField(E, F)
  shows extensionDegree(subextension(E, F)) =
      index(galoisGroup(E), fixingSubgroup(E, F)) ∧
    extensionDegree(overExtension(E, F)) =
      cardinality(fixingSubgroup(E, F))
proof
  sorry

-- Restricting scalars to F: Gal(L/F) is the fixing subgroup
-- (IntermediateField.fixingSubgroupEquiv), as sets of maps.
theorem fixingSubgroup.over_automorphisms (F : Set)
  requires intermediate : IntermediateField(E, F)
  shows algebraAutomorphisms(overExtension(E, F)) = fixingSubgroup(E, F)
proof
  have ext2 := extension
  obtain ⟨algebra, baseField, ringField⟩ := ext2
  have overAlg := tkJ.overExtension_algebra with intermediate
  have bottom := IntermediateField.bottom_subset with extension, intermediate
  have mapF := Algebra.map_function with algebra
  ext σ
  constructor
  . intro h
    obtain ⟨space, iso⟩ := algebraAutomorphisms.membership.forward with h
    obtain ⟨hom, bij⟩ := iso
    obtain ⟨_, _, _, ringHom, commute⟩ := hom
    rw tkJ.over_ring at ringHom
    rw tkJ.over_carrier at bij
    rw [tkJ.over_base, subringRing.carrierOf, tkJ.over_map] at commute
    have fixesF : ∀ x ∈ F, σ(x) = x
      intros x xF
      have c := commute with x, xF
      rw (identity.apply at x, F with xF) at c
      exact c
    have homE : σ : E →ₐ E
      unfold AlgebraHom
      refine ⟨algebra, algebra, rfl, ringHom, ?_⟩
      intros a aK
      have mapIn : Algebra.map(E)(a) ∈ bottomField(E)
        unfold bottomField
        exact functionImage.value with mapF, aK
      exact fixesF with Algebra.map(E)(a), (bottom with Algebra.map(E)(a), mapIn)
    have isoE : σ : E ≃ₐ E
      unfold AlgebraIso
      exact ⟨homE, bij⟩
    have σA := (tkJ.aut_member at E, σ).backward with isoE
    apply fixingSubgroup.membership.backward
    exact ⟨σA, fixesF⟩
  . intro h
    obtain ⟨σA, fixes⟩ := fixingSubgroup.membership.forward with h
    have isoE := (tkJ.aut_member at E, σ).forward with σA
    obtain ⟨homE, bij⟩ := isoE
    obtain ⟨_, _, _, ringHom, _⟩ := homE
    have homO : σ : overExtension(E, F) →ₐ overExtension(E, F)
      unfold AlgebraHom
      rw [tkJ.over_ring, tkJ.over_base, tkJ.over_map]
      refine ⟨overAlg, overAlg, rfl, ringHom, ?_⟩
      intros a aF
      rw [tkJ.over_base, subringRing.carrierOf] at aF
      rw (identity.apply at a, F with aF)
      exact fixes with a, aF
    have isoO : σ : overExtension(E, F) ≃ₐ overExtension(E, F)
      unfold AlgebraIso
      rw tkJ.over_carrier
      exact ⟨homO, bij⟩
    exact (tkJ.aut_member at overExtension(E, F), σ).backward with isoO

-- IsGalois.tower_top_of_isGalois, IsGalois.tower_top_intermediateField:
-- L/F is Galois when L/K is.
theorem GaloisExtension.tower_top (F : Set)
  requires galois : GaloisExtension(E)
  requires intermediate : IntermediateField(E, F)
  shows GaloisExtension(overExtension(E, F))
proof
  sorry

-- Artin's theorem (IsGalois.of_fixed_field, FixedPoints.finrank_eq_card):
-- for a finite group H of automorphisms, L is Galois over the fixed field
-- of degree |H|.
theorem GaloisExtension.of_fixed_field (H : Set)
  requires subgroup : Subgroup(H, galoisGroup(E))
  requires finiteGroup : Finite(H)
  shows GaloisExtension(overExtension(E, fixedField(E, H))) ∧
    FiniteExtension(overExtension(E, fixedField(E, H))) ∧
    extensionDegree(overExtension(E, fixedField(E, H))) = cardinality(H)
proof
  sorry

-- A normal subextension of a Galois extension is Galois
-- (IsGalois.tower_bot with Normal).
theorem GaloisExtension.of_normal_sub (F : Set)
  requires galois : GaloisExtension(E)
  requires intermediate : IntermediateField(E, F)
  requires normal : NormalExtension(subextension(E, F))
  shows GaloisExtension(subextension(E, F))
proof
  have fields := IntermediateField.subextension_field with extension, intermediate
  obtain ⟨subField, _⟩ := fields
  have sf2 := subField
  obtain ⟨subAlg, subBaseField, _⟩ := sf2
  have inclHom := tkJ.sub_inclusion_hom with extension, intermediate
  have normal2 := normal
  obtain ⟨subAlgebraic, _⟩ := normal2
  obtain ⟨_, subAlgAll⟩ := subAlgebraic
  obtain ⟨_, subAll⟩ := subAlgAll
  have galois2 := galois
  obtain ⟨separable, _⟩ := galois2
  obtain ⟨_, sepAll⟩ := separable
  unfold GaloisExtension
  refine ⟨?_, normal⟩
  unfold SeparableExtension
  refine ⟨subField, ?_⟩
  intros x xSub
  have xF := xSub
  rw tkJ.sub_carrier at xF
  have bounded := tkJ.intermediate_bounded with intermediate
  have xL := bounded with x, xF
  have xAlg := subAll with x, xSub
  have xInt := (AlgebraicElement.iff_integral at subextension(E, F), x with subAlg,
    subBaseField).forward with xAlg
  have same := minpoly.algebra_hom at subextension(E, F), E, identity(F), x with subField,
    extension, inclHom, xInt
  rw (identity.apply at x, F with xF) at same
  have xSep := sepAll with x, xL
  obtain ⟨_, polySep⟩ := xSep
  unfold SeparableElement
  refine ⟨xInt, ?_⟩
  rw [← same, tkJ.sub_base]
  exact polySep

-- Restriction to a normal subextension (AlgEquiv.restrictNormalHom,
-- AlgHom.restrictNormal_commutes): a homomorphism Gal(L/K) → Gal(F/K)
-- agreeing with σ on F, surjective, with kernel Gal(L/F)
-- (AlgEquiv.restrictNormalHom_surjective, IsGalois.normalAutEquivQuotient).
-- Automorphisms preserve a normal intermediate field, and restrict to
-- automorphisms of it; the restriction map is σ ↦ σ|_F.
theorem tkJ.gal_normal_stable (F σ x : Set)
  requires intermediate : IntermediateField(E, F)
  requires normal : NormalExtension(subextension(E, F))
  requires automorphism : σ ∈ algebraAutomorphisms(E)
  requires point : x ∈ F
  shows σ(x) ∈ F
proof
  have fields := IntermediateField.subextension_field with extension, intermediate
  obtain ⟨subField, _⟩ := fields
  have sf2 := subField
  obtain ⟨subAlg, subBaseField, _⟩ := sf2
  have inclHom := tkJ.sub_inclusion_hom with extension, intermediate
  have normal2 := normal
  obtain ⟨subAlgebraic, splitsAll⟩ := normal2
  obtain ⟨_, subAlgAll⟩ := subAlgebraic
  obtain ⟨_, subAll⟩ := subAlgAll
  have xSub : x ∈ algebraCarrier(subextension(E, F))
    rw tkJ.sub_carrier
    exact point
  have xAlg := subAll with x, xSub
  have xInt := (AlgebraicElement.iff_integral at subextension(E, F), x with subAlg,
    subBaseField).forward with xAlg
  have same := minpoly.algebra_hom at subextension(E, F), E, identity(F), x with subField,
    extension, inclHom, xInt
  rw (identity.apply at x, F with point) at same
  have xIntE := IntegralElement.map at subextension(E, F), E, identity(F), x with subAlg,
    inclHom, xInt
  rw (identity.apply at x, F with point) at xIntE
  have split := splitsAll with x, xSub
  rw [tkJ.sub_base, tkJ.sub_ring, tkJ.sub_map, ← same] at split
  have sel := minpoly.selected with extension, xIntE
  obtain ⟨mIn, mMonic, mRoot, _⟩ := sel
  have root := minpoly.root_of_conjugate with extension, xIntE, automorphism
  have fσ := tkJ.aut_function with automorphism
  have bounded := tkJ.intermediate_bounded with intermediate
  have xL := bounded with x, point
  have σxL := FunctionBetween.apply_closed with fσ, xL
  exact tkJ.gal_split_root with extension, intermediate, mIn, mMonic, split, σxL, root

theorem tkJ.gal_restrict_aut (F σ : Set)
  requires intermediate : IntermediateField(E, F)
  requires normal : NormalExtension(subextension(E, F))
  requires automorphism : σ ∈ algebraAutomorphisms(E)
  shows restrict(σ, F) ∈ algebraAutomorphisms(subextension(E, F))
proof
  have ext2 := extension
  obtain ⟨algebra, baseField, ringField⟩ := ext2
  have ringL := Algebra.comm_ring with algebra
  have subring := tkJ.intermediate_subring with intermediate
  unfold algebraCarrier at subring
  have bundled := Subring.of_projections with subring
  have bounded := tkJ.intermediate_bounded with intermediate
  have subAlg := tkJ.subextension_algebra with intermediate
  have bottom := IntermediateField.bottom_subset with extension, intermediate
  have mapF := Algebra.map_function with algebra
  have stable : ∀ x ∈ F, σ(x) ∈ F
    intros x xF
    exact tkJ.gal_normal_stable with intermediate, normal, automorphism, xF
  have inverse := tkJ.aut_converse_mem with automorphism
  have stableInv : ∀ x ∈ F,
      converse(σ, algebraCarrier(E), algebraCarrier(E))(x) ∈ F
    intros x xF
    exact tkJ.gal_normal_stable with intermediate, normal, inverse, xF
  have hom := tkJ.aut_ring_hom with automorphism
  have restricted := tkJ.gal_restrict_ring_hom with ringL, bundled, hom, stable
  have fσ := tkJ.aut_function with automorphism
  have fτ := tkJ.aut_function with inverse
  have bij := tkJ.aut_bijective with automorphism
  have rσ := restrict.function with fσ, bounded, stable
  have rτ := restrict.function with fτ, bounded, stableInv
  have iso := (tkJ.aut_member at E, σ).forward with automorphism
  obtain ⟨algHom, _⟩ := iso
  have bijective : BijectiveBetween(restrict(σ, F), F, F)
    apply Bijective.of_two_sided_inverse with rσ, rτ
    . intros x xF
      have sx := stable with x, xF
      have xL := bounded with x, xF
      rw [(restrict.apply with fσ, bounded, stable, xF),
        (restrict.apply with fτ, bounded, stableInv, sx)]
      exact Bijective.inverse_apply with bij, xL
    . intros y yF
      have ty := stableInv with y, yF
      have yL := bounded with y, yF
      rw [(restrict.apply with fτ, bounded, stableInv, yF),
        (restrict.apply with fσ, bounded, stable, ty)]
      exact Bijective.apply_inverse with bij, yL
  have homSub : restrict(σ, F) : subextension(E, F) →ₐ subextension(E, F)
    unfold AlgebraHom
    rw [tkJ.sub_ring, tkJ.sub_map]
    refine ⟨subAlg, subAlg, rfl, restricted, ?_⟩
    intros a aK
    rw tkJ.sub_base at aK
    have mapIn : Algebra.map(E)(a) ∈ bottomField(E)
      unfold bottomField
      exact functionImage.value with mapF, aK
    have inF := bottom with Algebra.map(E)(a), mapIn
    rw (restrict.apply with fσ, bounded, stable, inF)
    exact AlgebraHom.map_base with algHom, aK
  have isoSub : restrict(σ, F) : subextension(E, F) ≃ₐ subextension(E, F)
    unfold AlgebraIso
    rw tkJ.sub_carrier
    exact ⟨homSub, bijective⟩
  exact (tkJ.aut_member at subextension(E, F), restrict(σ, F)).backward with isoSub

theorem tkJ.gal_restrict_function (F : Set)
  requires intermediate : IntermediateField(E, F)
  requires normal : NormalExtension(subextension(E, F))
  shows galoisRestrict(E, F) : algebraAutomorphisms(E) →
    algebraAutomorphisms(subextension(E, F))
proof
  constructor
  . intros p pIn
    obtain ⟨bounded, _⟩ := galoisRestrict.membership.forward with pIn
    exact bounded
  . constructor
    . intros u z1 rel1 z2 rel2
      unfold relates at rel1
      obtain ⟨_, τ1, τ1In, e1⟩ := galoisRestrict.membership.forward with rel1
      unfold relates at rel2
      obtain ⟨_, τ2, τ2In, e2⟩ := galoisRestrict.membership.forward with rel2
      obtain ⟨u1, z1Eq⟩ := orderedPair.injective with e1
      obtain ⟨u2, z2Eq⟩ := orderedPair.injective with e2
      rw [z1Eq, z2Eq]
      rw ← u1
      rw ← u2
    . intros τ τIn
      have τMem := tkJ.gal_restrict_aut with intermediate, normal, τIn
      refine ⟨restrict(τ, F), τMem, ?_⟩
      unfold relates
      apply galoisRestrict.membership.backward
      have pairIn := product.pair at τ, restrict(τ, F), algebraAutomorphisms(E),
        algebraAutomorphisms(subextension(E, F)) with τIn, τMem
      exact ⟨pairIn, τ, τIn, rfl⟩

theorem tkJ.gal_restrict_value (F σ : Set)
  requires intermediate : IntermediateField(E, F)
  requires normal : NormalExtension(subextension(E, F))
  requires automorphism : σ ∈ algebraAutomorphisms(E)
  shows galoisRestrict(E, F)(σ) = restrict(σ, F)
proof
  have mem := tkJ.gal_restrict_aut with intermediate, normal, automorphism
  have function := tkJ.gal_restrict_function with intermediate, normal
  have rel : relates(galoisRestrict(E, F), σ, restrict(σ, F))
    unfold relates
    apply galoisRestrict.membership.backward
    have pairIn := product.pair at σ, restrict(σ, F), algebraAutomorphisms(E),
      algebraAutomorphisms(subextension(E, F)) with automorphism, mem
    exact ⟨pairIn, σ, automorphism, rfl⟩
  exact FunctionBetween.apply_value with function, automorphism, rel

theorem galoisRestrict.hom (F : Set)
  requires algebraic : AlgebraicExtension(E)
  requires intermediate : IntermediateField(E, F)
  requires normal : NormalExtension(subextension(E, F))
  shows GroupHom(galoisRestrict(E, F), galoisGroup(E), galoisGroup(subextension(E, F)))
proof
  have group := galoisGroup.group with extension
  have fields := IntermediateField.subextension_field with extension, intermediate
  obtain ⟨subField, _⟩ := fields
  have groupSub := galoisGroup.group at subextension(E, F) with subField
  have function := tkJ.gal_restrict_function with intermediate, normal
  have bounded := tkJ.intermediate_bounded with intermediate
  unfold GroupHom
  rw [tkJ.galois_carrier, tkJ.galois_carrier, tkJ.galois_mul, tkJ.galois_mul]
  refine ⟨group, groupSub, function, ?_⟩
  intros σ σIn τ τIn
  rw tkJ.galois_carrier at σIn
  rw tkJ.galois_carrier at τIn
  have στ := tkJ.aut_compose_mem with σIn, τIn
  have rσ := tkJ.gal_restrict_aut with intermediate, normal, σIn
  have rτ := tkJ.gal_restrict_aut with intermediate, normal, τIn
  have rστ := tkJ.gal_restrict_aut with intermediate, normal, στ
  have composite := tkJ.aut_compose_mem with rσ, rτ
  rw [(tkJ.autComposition_apply with σIn, τIn),
    (tkJ.gal_restrict_value with intermediate, normal, στ),
    (tkJ.gal_restrict_value with intermediate, normal, σIn),
    (tkJ.gal_restrict_value with intermediate, normal, τIn),
    (tkJ.autComposition_apply with rσ, rτ)]
  apply galoisGroup.ext with subField, rστ, composite
  intros x xSub
  have xF := xSub
  rw tkJ.sub_carrier at xF
  have xL := bounded with x, xF
  have fσ := tkJ.aut_function with σIn
  have fτ := tkJ.aut_function with τIn
  have fστ := tkJ.aut_function with στ
  have frσ := tkJ.aut_function with rσ
  have frτ := tkJ.aut_function with rτ
  have stableσ : ∀ y ∈ F, σ(y) ∈ F
    intros y yF
    exact tkJ.gal_normal_stable with intermediate, normal, σIn, yF
  have stableτ : ∀ y ∈ F, τ(y) ∈ F
    intros y yF
    exact tkJ.gal_normal_stable with intermediate, normal, τIn, yF
  have stableστ : ∀ y ∈ F, compose(σ, τ, algebraCarrier(E), algebraCarrier(E),
      algebraCarrier(E))(y) ∈ F
    intros y yF
    exact tkJ.gal_normal_stable with intermediate, normal, στ, yF
  have τx := stableτ with x, xF
  rw (compose.apply with frτ, frσ, xSub)
  rw [(restrict.apply with fστ, bounded, stableστ, xF),
    (compose.apply with fτ, fσ, xL), (restrict.apply with fτ, bounded, stableτ, xF),
    (restrict.apply with fσ, bounded, stableσ, τx)]

theorem galoisRestrict.apply (F σ x : Set)
  requires algebraic : AlgebraicExtension(E)
  requires intermediate : IntermediateField(E, F)
  requires normal : NormalExtension(subextension(E, F))
  requires automorphism : σ ∈ algebraAutomorphisms(E)
  requires point : x ∈ F
  shows galoisRestrict(E, F)(σ)(x) = σ(x)
proof
  have bounded := tkJ.intermediate_bounded with intermediate
  have fσ := tkJ.aut_function with automorphism
  have stable : ∀ y ∈ F, σ(y) ∈ F
    intros y yF
    exact tkJ.gal_normal_stable with intermediate, normal, automorphism, yF
  rw (tkJ.gal_restrict_value with intermediate, normal, automorphism)
  exact restrict.apply with fσ, bounded, stable, point

theorem galoisRestrict.surjective (F : Set)
  requires normal : NormalExtension(E)
  requires intermediate : IntermediateField(E, F)
  requires normalSub : NormalExtension(subextension(E, F))
  shows SurjectiveBetween(galoisRestrict(E, F), algebraAutomorphisms(E),
    algebraAutomorphisms(subextension(E, F)))
proof
  sorry

theorem galoisRestrict.kernel (F : Set)
  requires algebraic : AlgebraicExtension(E)
  requires intermediate : IntermediateField(E, F)
  requires normal : NormalExtension(subextension(E, F))
  shows kernel(galoisRestrict(E, F), galoisGroup(E), galoisGroup(subextension(E, F))) =
    fixingSubgroup(E, F)
proof
  have bounded := tkJ.intermediate_bounded with intermediate
  ext σ
  constructor
  . intro h
    obtain ⟨σIn, σOne⟩ := kernel.membership.forward with h
    rw tkJ.galois_carrier at σIn
    rw [tkJ.galois_one, tkJ.sub_carrier,
      (tkJ.gal_restrict_value with intermediate, normal, σIn)] at σOne
    have fσ := tkJ.aut_function with σIn
    have stable : ∀ y ∈ F, σ(y) ∈ F
      intros y yF
      exact tkJ.gal_normal_stable with intermediate, normal, σIn, yF
    apply fixingSubgroup.membership.backward
    refine ⟨σIn, ?_⟩
    intros x xF
    have value := restrict.apply with fσ, bounded, stable, xF
    rw [σOne, (identity.apply at x, F with xF)] at value
    symm
    exact value
  . intro h
    obtain ⟨σIn, fixes⟩ := fixingSubgroup.membership.forward with h
    have fσ := tkJ.aut_function with σIn
    have stable : ∀ y ∈ F, σ(y) ∈ F
      intros y yF
      exact tkJ.gal_normal_stable with intermediate, normal, σIn, yF
    have rF := restrict.function with fσ, bounded, stable
    have idF := identity.function at F
    apply kernel.membership.backward
    rw [tkJ.galois_carrier, tkJ.galois_one, tkJ.sub_carrier,
      (tkJ.gal_restrict_value with intermediate, normal, σIn)]
    refine ⟨σIn, ?_⟩
    apply FunctionBetween.ext with rF, idF
    intros x xF
    rw [(restrict.apply with fσ, bounded, stable, xF), (identity.apply at x, F with xF)]
    exact fixes with x, xF

-- Normal intermediate fields: F/K is normal iff σ(F) ⊆ F for every σ
-- (IntermediateField.normal_iff_forall_map_le), iff Gal(L/F) is normal
-- in Gal(L/K) (IsGalois.normal_iff_fixingSubgroup_normal).
theorem GaloisExtension.normal_iff_stable (F : Set)
  requires galois : GaloisExtension(E)
  requires intermediate : IntermediateField(E, F)
  shows NormalExtension(subextension(E, F)) ↔
    (∀ σ ∈ algebraAutomorphisms(E), autImage(E, σ, F) ⊆ F)
proof
  have ext2 := extension
  obtain ⟨algebra, baseField, ringField⟩ := ext2
  have galois2 := galois
  obtain ⟨_, normalE⟩ := galois2
  have ne2 := normalE
  obtain ⟨algebraicE, splitsE⟩ := ne2
  have bounded := tkJ.intermediate_bounded with intermediate
  constructor
  . intro normal
    intros σ σA y yIn
    unfold autImage at yIn
    obtain ⟨_, x, xF, yEq⟩ := functionImage.membership.forward with yIn
    rw yEq
    exact tkJ.gal_normal_stable with intermediate, normal, σA, xF
  . intro stable
    have towers := AlgebraicExtension.tower_top with extension, intermediate, algebraicE
    obtain ⟨_, subAlgebraic⟩ := towers
    have fields := IntermediateField.subextension_field with extension, intermediate
    obtain ⟨subField, _⟩ := fields
    have sf2 := subField
    obtain ⟨subAlg, subBaseField, _⟩ := sf2
    have inclHom := tkJ.sub_inclusion_hom with extension, intermediate
    have sa2 := subAlgebraic
    obtain ⟨_, subAlgAlg⟩ := sa2
    obtain ⟨_, subAll⟩ := subAlgAlg
    have comm := Algebra.base_comm_ring with algebra
    have polys := polynomialRing.comm_ring at Algebra.base(E), {0} with comm
    have ringL := Algebra.comm_ring with algebra
    have polysL := polynomialRing.comm_ring at Algebra.ring(E), {0} with ringL
    have mapL := Algebra.structure_hom with algebra
    have subring := tkJ.intermediate_subring with intermediate
    unfold algebraCarrier at subring
    have bundled := Subring.of_projections with subring
    have commF := subringRing.comm_ring at Algebra.ring(E), F with ringL, bundled
    have polysF := polynomialRing.comm_ring at subringRing(Algebra.ring(E), F), {0} with
      commF
    have incl := Subring.inclusion at Algebra.ring(E), F with ringL, bundled
    have intoF := tkJ.sub_structure_hom with extension, intermediate
    have ringParts := Field.parts with ringField
    have ntL := IsField.nontrivial with ringParts
    obtain ⟨_, _, distinctL⟩ := ntL
    have zeroF : Ring.zero(subringRing(Algebra.ring(E), F)) = Ring.zero(Algebra.ring(E))
      simp [subringRing, Ring.mk.zero]
    have oneF : Ring.one(subringRing(Algebra.ring(E), F)) = Ring.one(Algebra.ring(E))
      simp [subringRing, Ring.mk.one]
    have ntF : Ring.zero(subringRing(Algebra.ring(E), F)) ≠
        Ring.one(subringRing(Algebra.ring(E), F))
      rw [zeroF, oneF]
      exact distinctL
    unfold NormalExtension
    refine ⟨subAlgebraic, ?_⟩
    intros x xSub
    have xF := xSub
    rw tkJ.sub_carrier at xF
    have xL := bounded with x, xF
    have xAlg := subAll with x, xSub
    have xInt := (AlgebraicElement.iff_integral at subextension(E, F), x with subAlg,
      subBaseField).forward with xAlg
    have same := minpoly.algebra_hom at subextension(E, F), E, identity(F), x with
      subField, extension, inclHom, xInt
    rw (identity.apply at x, F with xF) at same
    have xIntE := IntegralElement.map at subextension(E, F), E, identity(F), x with subAlg,
      inclHom, xInt
    rw (identity.apply at x, F with xF) at xIntE
    rw [tkJ.sub_base, tkJ.sub_ring, tkJ.sub_map, ← same]
    have sel := minpoly.selected with extension, xIntE
    obtain ⟨mIn, mMonic, mRoot, _⟩ := sel
    have mP := mIn
    unfold uniPolys at mP
    have split := splitsE with x, xL
    obtain ⟨_, alt⟩ := split
    have mappedL := polyMap.monic at Algebra.base(E), Algebra.ring(E), Algebra.map(E),
      minpoly(E, x) with comm, polys, ringL, mapL, mMonic, distinctL
    obtain ⟨qLMonic, _⟩ := mappedL
    have qLm := qLMonic
    obtain ⟨qLIn, qLLead⟩ := qLm
    have qLNonzero := PolyMonic.ne_zero at Algebra.ring(E), polyMap(Algebra.base(E),
      Algebra.ring(E), Algebra.map(E))(minpoly(E, x)) with ringL, polysL, qLIn, distinctL,
      qLMonic
    cases alt with qz | product
    . exfalso
      exact qLNonzero with qz
    . obtain ⟨n, nN, a, aF, qEq⟩ := product
      have nNat := nat.omega.backward with nN
      rw qLLead at qEq
      rw ← (uni.one_eq at Algebra.ring(E) with ringL, polysL) at qEq
      have prodL := (polyLinearProduct.monic at Algebra.ring(E), a, n with ringL, polysL,
        aF).left
      obtain ⟨prodLIn, _⟩ := prodL
      have u : Ring.one(polynomialRing(Algebra.ring(E), {0})) *
          polyLinearProduct(Algebra.ring(E), a, n) =
          polyLinearProduct(Algebra.ring(E), a, n) by ring
      rw u at qEq
      have pparts := CommRing.parts with polysL
      have fin := Finite.natural at n
      have wf := linearFactorFamily.function at Algebra.ring(E), a, n with ringL, aF
      have rootsF : ∀ i ∈ n, a(i) ∈ F
        intros i hi
        have ai := FunctionBetween.apply_closed with aF, hi
        have aiL : a(i) ∈ algebraCarrier(E)
          unfold algebraCarrier
          exact ai
        have rem := finiteRingProduct.remove at n,
          Ring.carrier(polynomialRing(Algebra.ring(E), {0})),
          Ring.add(polynomialRing(Algebra.ring(E), {0})),
          Ring.zero(polynomialRing(Algebra.ring(E), {0})),
          Ring.neg(polynomialRing(Algebra.ring(E), {0})),
          Ring.mul(polynomialRing(Algebra.ring(E), {0})),
          Ring.one(polynomialRing(Algebra.ring(E), {0})),
          linearFactorFamily(Algebra.ring(E), a, n), i with pparts, fin, wf, hi
        have sub : n ∖ {i} ⊆ n by simp [Subset, difference.membership]
        have finSub := Finite.subset with fin, sub
        have rf := restrict.domain_function at linearFactorFamily(Algebra.ring(E), a, n), n,
          Ring.carrier(polynomialRing(Algebra.ring(E), {0})), n ∖ {i} with wf, sub
        have restIn := finiteRingProduct.closed at n ∖ {i},
          Ring.carrier(polynomialRing(Algebra.ring(E), {0})),
          Ring.add(polynomialRing(Algebra.ring(E), {0})),
          Ring.zero(polynomialRing(Algebra.ring(E), {0})),
          Ring.neg(polynomialRing(Algebra.ring(E), {0})),
          Ring.mul(polynomialRing(Algebra.ring(E), {0})),
          Ring.one(polynomialRing(Algebra.ring(E), {0})),
          restrict(linearFactorFamily(Algebra.ring(E), a, n), n ∖ {i}) with pparts, finSub,
          rf
        have wi := FunctionBetween.apply_closed with wf, hi
        have evalAt := polyEval.mul at Algebra.ring(E), finiteRingProduct(n ∖ {i},
          Ring.carrier(polynomialRing(Algebra.ring(E), {0})),
          Ring.add(polynomialRing(Algebra.ring(E), {0})),
          Ring.zero(polynomialRing(Algebra.ring(E), {0})),
          Ring.neg(polynomialRing(Algebra.ring(E), {0})),
          Ring.mul(polynomialRing(Algebra.ring(E), {0})),
          Ring.one(polynomialRing(Algebra.ring(E), {0})),
          restrict(linearFactorFamily(Algebra.ring(E), a, n), n ∖ {i})),
          linearFactorFamily(Algebra.ring(E), a, n)(i), a(i) with ringL, polysL, restIn,
          wi, ai
        have v : polyEval(Algebra.ring(E), linearFactorFamily(Algebra.ring(E), a, n)(i),
            a(i)) = Ring.zero(Algebra.ring(E))
          rw (linearFactorFamily.value at Algebra.ring(E), a, n, i with ringL, aF, hi)
          rw (polyEval.X_sub_C at Algebra.ring(E), a(i), a(i) with ringL, polysL, ai, ai)
          ring
        rw v at evalAt
        have evalHom := polyEval.hom at Algebra.ring(E), a(i) with ringL, polysL, ai
        have restVal : polyEval(Algebra.ring(E), finiteRingProduct(n ∖ {i},
            Ring.carrier(polynomialRing(Algebra.ring(E), {0})),
            Ring.add(polynomialRing(Algebra.ring(E), {0})),
            Ring.zero(polynomialRing(Algebra.ring(E), {0})),
            Ring.neg(polynomialRing(Algebra.ring(E), {0})),
            Ring.mul(polynomialRing(Algebra.ring(E), {0})),
            Ring.one(polynomialRing(Algebra.ring(E), {0})),
            restrict(linearFactorFamily(Algebra.ring(E), a, n), n ∖ {i})), a(i)) ∈
            Ring.carrier(Algebra.ring(E))
          unfold polyEval
          exact RingHom.map_mem with evalHom, restIn
        have zz : polyEval(Algebra.ring(E), finiteRingProduct(n ∖ {i},
            Ring.carrier(polynomialRing(Algebra.ring(E), {0})),
            Ring.add(polynomialRing(Algebra.ring(E), {0})),
            Ring.zero(polynomialRing(Algebra.ring(E), {0})),
            Ring.neg(polynomialRing(Algebra.ring(E), {0})),
            Ring.mul(polynomialRing(Algebra.ring(E), {0})),
            Ring.one(polynomialRing(Algebra.ring(E), {0})),
            restrict(linearFactorFamily(Algebra.ring(E), a, n), n ∖ {i})), a(i)) *
            Ring.zero(Algebra.ring(E)) = Ring.zero(Algebra.ring(E)) by ring
        rw zz at evalAt
        have prodZero : polyEval(Algebra.ring(E), polyLinearProduct(Algebra.ring(E), a, n),
            a(i)) = Ring.zero(Algebra.ring(E))
          unfold polyLinearProduct
          rw rem
          exact evalAt
        have e := polyEval2.eq_eval_map at Algebra.base(E), Algebra.ring(E), Algebra.map(E),
          a(i), minpoly(E, x) with comm, polys, ringL, mapL, ai, mP
        rw [qEq, prodZero] at e
        have root : polyAeval(E, a(i), minpoly(E, x)) = Ring.zero(Algebra.ring(E))
          unfold polyAeval
          exact e
        obtain ⟨σ, σA, σx⟩ := minpoly.conjugate_of_root with extension, normalE, xL, aiL,
          root
        have st := stable with σ, σA
        have fσ := tkJ.aut_function with σA
        have σxL := FunctionBetween.apply_closed with fσ, xL
        have imgIn : σ(x) ∈ autImage(E, σ, F)
          unfold autImage
          apply functionImage.membership.backward
          exact ⟨σxL, x, xF, rfl⟩
        rw ← σx
        exact st with σ(x), imgIn
      have aFF : a : n → Ring.carrier(subringRing(Algebra.ring(E), F))
        rw subringRing.carrierOf
        exact FunctionBetween.codomain_of_values with aF, rootsF
      have qF := polyMap.monic at Algebra.base(E), subringRing(Algebra.ring(E), F),
        Algebra.map(E), minpoly(E, x) with comm, polys, commF, intoF, mMonic, ntF
      obtain ⟨qFMonic, _⟩ := qF
      have qFm := qFMonic
      obtain ⟨qFIn, qFLead⟩ := qFm
      have e3 := polyMap.compose at Algebra.base(E), subringRing(Algebra.ring(E), F),
        Algebra.ring(E), Algebra.map(E), identity(F), minpoly(E, x) with comm, polys, commF,
        ringL, intoF, incl, mP
      have composite := tkJ.compose_inclusion with extension, intermediate
      rw subringRing.carrierOf at e3
      unfold algebraCarrier at composite
      rw composite at e3
      have idValues : ∀ i ∈ n, a(i) = identity(F)(a(i))
        intros i hi
        symm
        exact identity.apply with (rootsF with i, hi)
      have liftProd := tkJ.gal_map_linear_product at subringRing(Algebra.ring(E), F),
        Algebra.ring(E), identity(F), a, a, n with commF, ringL, incl, aFF, aF, idValues
      have boundedL := bounded
      unfold algebraCarrier at boundedL
      have idIncl := identity.inclusion with boundedL
      have cancel : ∀ u ∈ F, ∀ w ∈ F, identity(F)(u) = identity(F)(w) → u = w
        intros u uF w wF same0
        rw [(identity.apply at u, F with uF), (identity.apply at w, F with wF)] at same0
        exact same0
      have idInj0 := Injective.of_pointwise with idIncl, cancel
      have idInj : InjectiveBetween(identity(F),
          Ring.carrier(subringRing(Algebra.ring(E), F)), Ring.carrier(Algebra.ring(E)))
        rw subringRing.carrierOf
        exact idInj0
      have polyInj := polyMap.injective at subringRing(Algebra.ring(E), F), Algebra.ring(E),
        identity(F) with commF, polysF, ringL, incl, idInj
      have liftHom := polyMap.hom at subringRing(Algebra.ring(E), F), Algebra.ring(E),
        identity(F) with commF, polysF, ringL, incl
      have lh2 := liftHom
      obtain ⟨_, _, liftF, _⟩ := lh2
      have prodF := (polyLinearProduct.monic at subringRing(Algebra.ring(E), F), a, n with
        commF, polysF, aFF).left
      obtain ⟨prodFIn, _⟩ := prodF
      have r1 := FunctionBetween.relates_apply with liftF, qFIn
      have r2 := FunctionBetween.relates_apply with liftF, prodFIn
      rw [e3, qEq] at r1
      rw liftProd at r2
      have sameF := Injective.cancel with polyInj, qFIn, prodFIn, prodLIn, r1, r2
      unfold PolySplits
      refine ⟨mIn, ?_⟩
      right
      refine ⟨n, nN, a, aFF, ?_⟩
      rw qFLead
      rw ← (uni.one_eq at subringRing(Algebra.ring(E), F) with commF, polysF)
      have u2 : Ring.one(polynomialRing(subringRing(Algebra.ring(E), F), {0})) *
          polyLinearProduct(subringRing(Algebra.ring(E), F), a, n) =
          polyLinearProduct(subringRing(Algebra.ring(E), F), a, n) by ring
      rw u2
      exact sameF

theorem GaloisExtension.normal_iff_normal_subgroup (F : Set)
  requires finite : FiniteExtension(E)
  requires galois : GaloisExtension(E)
  requires intermediate : IntermediateField(E, F)
  shows NormalExtension(subextension(E, F)) ↔
    NormalSubgroup(fixingSubgroup(E, F), galoisGroup(E))
proof
  have algebraic := FiniteExtension.algebraic with extension, finite
  have bounded := tkJ.intermediate_bounded with intermediate
  constructor
  . intro normal
    have hom := galoisRestrict.hom with extension, algebraic, intermediate, normal
    have kernelEq := galoisRestrict.kernel with extension, algebraic, intermediate, normal
    have kn := GroupHom.kernel_normal with hom
    rw kernelEq at kn
    exact kn
  . intro normalSub
    have group := galoisGroup.group with extension
    have fixedEq := GaloisExtension.fixedField_fixingSubgroup with extension, finite,
      galois, intermediate
    apply (GaloisExtension.normal_iff_stable with extension, galois, intermediate).backward
    intros σ σA
    intros y yIn
    unfold autImage at yIn
    obtain ⟨_, x, xF, yEq⟩ := functionImage.membership.forward with yIn
    rw yEq
    have xL := bounded with x, xF
    have fσ := tkJ.aut_function with σA
    have σxL := FunctionBetween.apply_closed with fσ, xL
    have bij := tkJ.aut_bijective with σA
    have σInv := tkJ.aut_converse_mem with σA
    have σG : σ ∈ Group.carrier(galoisGroup(E))
      rw tkJ.galois_carrier
      exact σA
    rw ← fixedEq
    apply fixedField.membership.backward
    refine ⟨σxL, ?_⟩
    intros τ τIn
    obtain ⟨τA, _⟩ := fixingSubgroup.membership.forward with τIn
    have nn := normalSub
    obtain ⟨_, conj⟩ := nn
    have invG : Group.inv(galoisGroup(E))(σ) ∈ Group.carrier(galoisGroup(E)) by typecheck
    have c := conj with Group.inv(galoisGroup(E))(σ), invG, τ, τIn
    unfold conjugate at c
    rw (Group.inv_involutive at galoisGroup(E), σ with group, σG) at c
    rw [tkJ.galois_inv, (tkJ.autInverse_apply with σA), tkJ.galois_mul,
      (tkJ.autComposition_apply with σInv, τA)] at c
    have στ := tkJ.aut_compose_mem with σInv, τA
    rw (tkJ.autComposition_apply with στ, σA) at c
    obtain ⟨_, cFix⟩ := fixingSubgroup.membership.forward with c
    have value := cFix with x, xF
    have fInv := tkJ.aut_function with σInv
    have fτ := tkJ.aut_function with τA
    have fστ := tkJ.aut_function with στ
    rw [(compose.apply with fσ, fστ, xL), (compose.apply with fτ, fInv, σxL)] at value
    have τσxL := FunctionBetween.apply_closed with fτ, σxL
    have back := Bijective.apply_inverse with bij, τσxL
    rw value at back
    symm
    exact back

end GaloisTheory

-- A polynomial with coefficient c in degree n and none above has, at every
-- point, the value of one Cumulus monic list (intHelp.poly_list with the
-- list chosen before the point), nonempty when n is positive.
theorem tkJ.gal_poly_list (R S f c : Set) (n : Nat)
  requires comm : CommRing(R)
  requires target : CommRing(S)
  requires hom : f : R →+* S
  requires nontrivial : Ring.zero(R) ≠ Ring.one(R)
  shows ∀ p ∈ Ring.carrier(polynomialRing(R, {0})), polyCoeff(p, n) = c →
    (∀ k ∈ ℕ, n < k → polyCoeff(p, k) = Ring.zero(R)) →
    ∃ cs, List(Ring.carrier(R), cs) ∧ (0 < n → cs ≠ List.nil) ∧
      (∀ x ∈ Ring.carrier(S), polyEval2(R, S, f, x, p) =
        monicValue{Ring.carrier(R)}(f, Ring.add(S), Ring.mul(S), f(c), x, cs))
proof
  induction n
  | zero =>
    intros p pIn top vanish
    have polys := polynomialRing.comm_ring at R, {0} with comm
    have lt1 : p ∈ polyDegreeLT(R, 1)
      unfold polyDegreeLT
      refine ⟨pIn, ?_⟩
      intros k hk
      unfold polyDegrees at hk
      obtain ⟨kN, nz⟩ := hk
      have kNat := nat.omega.backward with kN
      by_contra ge
      have pos : 0 < k by arith
      have z := vanish with k, kN, pos
      unfold polyCoeff at z
      exact nz with z
    have pc := uni.const_of_lt_one at R, p with comm, polys, lt1
    have cR := uni.coeff_mem at R, p, 0 with comm, pIn
    rw top at pc
    rw top at cR
    have nilL : List(Ring.carrier(R), List.nil) by typecheck
    refine ⟨List.nil, nilL, _, _⟩
    . intro pos
      exfalso
      arith
    . intros x xIn
      rw pc
      rw monicValue
      exact polyEval2.C at R, S, f, x, c with comm, polys, target, hom, xIn, cR
  | succ(m) using ih =>
    intros p pIn top vanish
    have polys := polynomialRing.comm_ring at R, {0} with comm
    have pp := CommRing.parts with polys
    have xIn := polyX.mem at R with comm, polys
    have xm := PolyMonic.X at R with comm, polys
    have e1 : (1:Nat) = 1 by rfl
    have xtop := (uni.X_coeff at R, 1 with comm, polys).left with e1
    have xvanish : ∀ k ∈ ℕ, 1 < k → polyCoeff(polyX(R), k) = Ring.zero(R)
      intros k hk lt
      have kNat := nat.omega.backward with hk
      have n1 : k ≠ 1 by arith
      exact (uni.X_coeff at R, k with comm, polys).right with n1
    have xd := (uni.monic_of at R, polyX(R), 1 with comm, polys, xIn, xtop,
      xvanish).right with nontrivial
    have vanishN : ∀ k ∈ ℕ, succ(m) + 1 ≤ k → polyCoeff(p, k) = Ring.zero(R)
      intros k hk le
      have kNat := nat.omega.backward with hk
      have lt : succ(m) < k by arith
      exact vanish with k, hk, lt
    obtain ⟨q, qIn, r, rIn, split, small⟩ := uni.div_exists at R, polyX(R), succ(m) + 1
      with xIn, comm, polys, xm, p, pIn, vanishN
    rw xd at small
    have rc := uni.const_of_lt_one at R, r with comm, polys, small
    have r0 := uni.coeff_mem at R, r, 0 with comm, rIn
    have qx := IsCommRing.mul_comm with pp, qIn, xIn
    have xqIn : call2(Ring.mul(polynomialRing(R, {0})), polyX(R), q) ∈
      Ring.carrier(polynomialRing(R, {0})) by typecheck
    have cIn := polyC.mem at R, polyCoeff(r, 0) with comm, polys, r0
    rw [qx, rc] at split
    have ac := IsCommRing.add_comm with pp, xqIn, cIn
    rw ac at split
    have shifted : ∀ j ∈ ℕ, polyCoeff(q, j) = polyCoeff(p, j + 1)
      intros j hj
      have jNat := nat.omega.backward with hj
      rw split
      rw (intHelp.shift_coeff at R, q, polyCoeff(r, 0), j with comm, qIn, r0)
    have mN : m ∈ ℕ by typecheck
    have qtop : polyCoeff(q, m) = c
      rw (shifted with m, mN)
      have same : m + 1 = succ(m) by arith
      rw same
      exact top
    have qvanish : ∀ k ∈ ℕ, m < k → polyCoeff(q, k) = Ring.zero(R)
      intros k hk lt
      have kNat := nat.omega.backward with hk
      rw (shifted with k, hk)
      have k1 : k + 1 ∈ ℕ by typecheck
      have lt2 : succ(m) < k + 1 by arith
      exact vanish with k + 1, k1, lt2
    obtain ⟨cs, list, _, value⟩ := ih with q, qIn, qtop, qvanish
    have cons : List(Ring.carrier(R), List.cons(polyCoeff(r, 0), cs)) by typecheck
    refine ⟨List.cons(polyCoeff(r, 0), cs), cons, _, _⟩
    . intro pos
      intro equal
      symm at equal
      have distinct := List.inductive.disjoint.nil.cons at polyCoeff(r, 0), cs
      exact distinct with equal
    . intros x xS
      rw split
      rw (intHelp.shift_eval at R, S, f, x, q, polyCoeff(r, 0) with comm, target, hom,
        xS, qIn, r0)
      rw (value with x, xS)
      rw monicValue

-- Extending a family of roots by one more root multiplies the product of
-- linear factors by one more factor.
theorem tkJ.gal_linear_product_succ (R a c : Set) (n : Nat)
  requires comm : CommRing(R)
  requires points : a : n → Ring.carrier(R)
  requires point : c ∈ Ring.carrier(R)
  shows (adjoinMap(a, n, c) : succ(n) → Ring.carrier(R)) ∧
    polyLinearProduct(R, adjoinMap(a, n, c), succ(n)) =
      call2(Ring.mul(polynomialRing(R, {0})), polyLinearProduct(R, a, n),
        polyXSubC(R, c))
proof
  have polys := polynomialRing.comm_ring at R, {0} with comm
  have fresh := membership.irreflexive at n
  have raw := adjoinMap.function at a, n, Ring.carrier(R), n, c with points, fresh
  have dom : insert(n, n) = succ(n)
    ext x
    rw [insert.membership, membership.successor_set]
    constructor
    . intro h
      cases h with e | m
      . right
        exact e
      . left
        exact m
    . intro h
      cases h with m | e
      . right
        exact m
      . left
        exact e
  have cod : insert(c, Ring.carrier(R)) = Ring.carrier(R)
    ext x
    rw insert.membership
    constructor
    . intro h
      cases h with e | m
      . rw e
        exact point
      . exact m
    . intro h
      right
      exact h
  rw [dom, cod] at raw
  have nIn : n ∈ succ(n) := membership.self_successor at n
  have sub : n ⊆ succ(n)
    intros x hx
    exact membership.into_successor at x, n with hx
  have valueNew := FunctionBetween.apply_value with raw, nIn,
    (adjoinMap.relates_new at a, n, c)
  have valueOld : ∀ i ∈ n, adjoinMap(a, n, c)(i) = a(i)
    intros i hi
    have rel := FunctionBetween.relates_apply with points, hi
    have rel2 := adjoinMap.relates_old at a, n, c, i, a(i) with rel
    exact FunctionBetween.apply_value with raw, (sub with i, hi), rel2
  have wf := linearFactorFamily.function at R, adjoinMap(a, n, c), succ(n) with comm, raw
  have wfOld := linearFactorFamily.function at R, a, n with comm, points
  have rf := restrict.domain_function at linearFactorFamily(R, adjoinMap(a, n, c),
    succ(n)), succ(n), Ring.carrier(polynomialRing(R, {0})), n with wf, sub
  have same : restrict(linearFactorFamily(R, adjoinMap(a, n, c), succ(n)), n) =
      linearFactorFamily(R, a, n)
    apply FunctionBetween.ext with rf, wfOld
    intros i hi
    rw (restrict.domain_apply at linearFactorFamily(R, adjoinMap(a, n, c), succ(n)),
      succ(n), Ring.carrier(polynomialRing(R, {0})), n, i with wf, sub, hi)
    rw (linearFactorFamily.value at R, adjoinMap(a, n, c), succ(n), i with comm, raw,
      (sub with i, hi))
    rw (linearFactorFamily.value at R, a, n, i with comm, points, hi)
    rw (valueOld with i, hi)
  refine ⟨raw, ?_⟩
  unfold polyLinearProduct
  rw (uni.prod_succ at R, linearFactorFamily(R, adjoinMap(a, n, c), succ(n)), n with
    comm, polys, wf)
  rw same
  rw (linearFactorFamily.value at R, adjoinMap(a, n, c), succ(n), n with comm, raw, nIn)
  rw valueNew

-- The coefficient map along the identity is the identity.
theorem tkJ.gal_polyMap_id (R p : Set)
  requires comm : CommRing(R)
  requires member : p ∈ Ring.carrier(polynomialRing(R, {0}))
  shows polyMap(R, R, identity(Ring.carrier(R)))(p) = p
proof
  have polys := polynomialRing.comm_ring at R, {0} with comm
  have idHom := RingHom.id at R with comm
  have mapHom := polyMap.hom at R, R, identity(Ring.carrier(R)) with comm, polys, comm,
    idHom
  have mIn := RingHom.map_mem with mapHom, member
  apply polynomial.ext at R, polyMap(R, R, identity(Ring.carrier(R)))(p), p with comm,
    polys, mIn, member
  intros k hk
  have kNat := nat.omega.backward with hk
  rw (polyMap.coeff at R, R, identity(Ring.carrier(R)), p, k with comm, polys, comm,
    idHom, member)
  have ck := uni.coeff_mem at R, p, k with comm, member
  exact identity.apply with ck

-- Section: Splitting fields and algebraic closures
section Closures
variable (K : Set)
hypothesis field : Field(K)

-- Polynomial.SplittingField with its IsSplittingField instance: every
-- polynomial has a splitting field (a theorem; no field is chosen).
theorem IsSplittingField.exists (p : Set)
  requires member : p ∈ uniPolys(K)
  shows ∃ E, Algebra.base(E) = K ∧ IsSplittingField(E, p)
proof
  sorry

-- A splitting field is finite and normal (IsSplittingField.finiteDimensional,
-- Normal.of_isSplittingField), Galois when p is separable
-- (IsGalois.of_separable_splitting_field), and unique up to K-isomorphism
-- (IsSplittingField.algEquiv).
theorem IsSplittingField.finite_normal (E p : Set)
  requires base : Algebra.base(E) = K
  requires splitting : IsSplittingField(E, p)
  shows FiniteExtension(E) ∧ NormalExtension(E)
proof
  sorry

theorem IsSplittingField.galois (E p : Set)
  requires base : Algebra.base(E) = K
  requires splitting : IsSplittingField(E, p)
  requires separable : PolySeparable(K, p)
  shows GaloisExtension(E)
proof
  sorry

theorem IsSplittingField.unique (E E2 p : Set)
  requires base : Algebra.base(E) = K
  requires baseTwo : Algebra.base(E2) = K
  requires first : IsSplittingField(E, p)
  requires second : IsSplittingField(E2, p)
  shows ∃ f, f : E ≃ₐ E2
proof
  sorry

-- IsAlgClosed.exists_root, IsAlgClosed.splits, IsAlgClosed.exists_pow_nat_eq.
theorem AlgebraicallyClosed.exists_root (p : Set)
  requires closed : AlgebraicallyClosed(K)
  requires member : p ∈ uniPolys(K)
  requires degree : polyNatDegree(K, p) ≠ 0
  shows ∃ a ∈ Ring.carrier(K), PolyIsRoot(K, p, a)
proof
  have comm := Field.to_comm_ring with field
  have polys := polynomialRing.comm_ring at K, {0} with comm
  have domain := Field.domain with field
  have parts := Field.parts with field
  have nt := IsField.nontrivial with parts
  obtain ⟨zeroK, oneK, distinct⟩ := nt
  have pIn := member
  unfold uniPolys at pIn
  have hom := polyC.hom at K with comm, polys
  have mz := RingHom.map_zero with hom
  have cz : polyC(K, Ring.zero(K)) = Ring.zero(polynomialRing(K, {0}))
    unfold polyC
    exact mz
  have pNonzero : p ≠ Ring.zero(polynomialRing(K, {0}))
    intro pz
    have d0 := polyNatDegree.C at K, Ring.zero(K) with comm, polys, zeroK
    rw [cz, ← pz] at d0
    exact degree with d0
  obtain ⟨c, cIn, qMonic, qDeg⟩ := tkJ.gal_monic_rescale with field, member, pNonzero
  have qm := qMonic
  obtain ⟨qIn, qLead⟩ := qm
  rw (uni.lead_eq at K, call2(Ring.mul(polynomialRing(K, {0})), polyC(K, c), p) with
    comm, polys) at qLead
  rw qDeg at qLead
  have vanish := uni.vanish_deg at K, call2(Ring.mul(polynomialRing(K, {0})),
    polyC(K, c), p) with comm, polys, qIn
  rw qDeg at vanish
  have idHom := RingHom.id at K with comm
  have bridge := tkJ.gal_poly_list at K, K, identity(Ring.carrier(K)), Ring.one(K),
    polyNatDegree(K, p) with comm, comm, idHom, distinct
  obtain ⟨cs, csList, csNonempty, csValue⟩ := bridge with
    call2(Ring.mul(polynomialRing(K, {0})), polyC(K, c), p), qIn, qLead, vanish
  have pos : 0 < polyNatDegree(K, p) by arith
  have ne := csNonempty with pos
  have closedParts := AlgebraicallyClosed.parts with closed
  obtain ⟨_, rootsAll⟩ := closedParts
  obtain ⟨x, xK, root⟩ := rootsAll with cs, csList, ne
  have value := csValue with x, xK
  rw (identity.apply at Ring.one(K), Ring.carrier(K) with oneK) at value
  rw root at value
  have constant := constantFunction.function at {0}, Ring.carrier(K), x with xK
  have evalEq := evaluationAt.eq_evaluationHom at K, {0},
    constantFunction({0}, Ring.carrier(K), x) with comm, constant
  have qx : polyEval(K, call2(Ring.mul(polynomialRing(K, {0})), polyC(K, c), p), x) =
      Ring.zero(K)
    unfold polyEval
    rw evalEq
    unfold polyEval2 at value
    exact value
  have cpIn := polyC.mem at K, c with comm, polys, cIn
  rw [(polyEval.mul at K, polyC(K, c), p, x with comm, polys, cpIn, pIn, xK),
    (polyEval.C at K, c, x with comm, polys, cIn, xK)] at qx
  have pxIn : polyEval(K, p, x) ∈ Ring.carrier(K)
    have evalHom := polyEval.hom at K, x with comm, polys, xK
    unfold polyEval
    exact RingHom.map_mem with evalHom, pIn
  have alt := (IntegralDomain.mul_eq_zero at K, c, polyEval(K, p, x) with domain, cIn,
    pxIn).forward with qx
  cases alt with c0 | px
  . exfalso
    rw [c0, cz] at qLead
    have z : Ring.zero(polynomialRing(K, {0})) * p = Ring.zero(polynomialRing(K, {0}))
      by ring
    rw z at qLead
    rw (uni.zero_coeff at K, polyNatDegree(K, p) with comm, polys) at qLead
    exact distinct with qLead
  . refine ⟨x, xK, ?_⟩
    unfold PolyIsRoot
    exact ⟨xK, px⟩

-- Over an algebraically closed field a nonzero polynomial of degree n is
-- its leading coefficient times n linear factors.
theorem tkJ.gal_closed_factor (n : Nat)
  requires closed : AlgebraicallyClosed(K)
  shows ∀ p ∈ Ring.carrier(polynomialRing(K, {0})), polyNatDegree(K, p) = n →
    p ≠ Ring.zero(polynomialRing(K, {0})) →
    ∃ a, (a : n → Ring.carrier(K)) ∧
      p = call2(Ring.mul(polynomialRing(K, {0})), polyC(K, polyLeadingCoeff(K, p)),
        polyLinearProduct(K, a, n))
proof
  have comm := Field.to_comm_ring with field
  have polys := polynomialRing.comm_ring at K, {0} with comm
  have domain := Field.domain with field
  have parts := Field.parts with field
  have nt := IsField.nontrivial with parts
  obtain ⟨zeroK, oneK, distinct⟩ := nt
  have pparts := CommRing.parts with polys
  induction n
  | zero =>
    intros p pIn d0 nonzero
    have cl : p ∈ polyDegreeLT(K, 1)
      unfold polyDegreeLT
      refine ⟨pIn, ?_⟩
      intros k hk
      have sc := uni.deg_spec at K, p with comm, polys, pIn
      unfold polyDegrees at hk
      obtain ⟨kN, nzk⟩ := hk
      have kNat := nat.omega.backward with kN
      have nz2 : polyCoeff(p, k) ≠ Ring.zero(K)
        unfold polyCoeff
        exact nzk
      have le := sc.left with k, kN, nz2
      arith
    have pc := uni.const_of_lt_one at K, p with comm, polys, cl
    have lead : polyLeadingCoeff(K, p) = polyCoeff(p, 0)
      rw (uni.lead_eq at K, p with comm, polys)
      rw d0
    have emptyF : ∅ : 0 → Ring.carrier(K)
      rw nat.zero
      exact FunctionBetween.empty at Ring.carrier(K)
    refine ⟨∅, emptyF, ?_⟩
    have fin := Finite.natural at 0
    have wf := linearFactorFamily.function at K, ∅, 0 with comm, emptyF
    have values : ∀ x ∈ 0, linearFactorFamily(K, ∅, 0)(x) =
        Ring.one(polynomialRing(K, {0}))
      intros x hx
      exfalso
      have xNat := natural.member at 0 with hx
      have lt := Less.of_membership at x, 0
      have l := lt with hx
      arith
    have e := finiteRingProduct.one at 0, Ring.carrier(polynomialRing(K, {0})),
      Ring.add(polynomialRing(K, {0})), Ring.zero(polynomialRing(K, {0})),
      Ring.neg(polynomialRing(K, {0})), Ring.mul(polynomialRing(K, {0})),
      Ring.one(polynomialRing(K, {0})), linearFactorFamily(K, ∅, 0) with pparts, fin, wf,
      values
    unfold polyLinearProduct
    rw e
    rw lead
    have c0 := uni.coeff_mem at K, p, 0 with comm, pIn
    have cIn := polyC.mem at K, polyCoeff(p, 0) with comm, polys, c0
    have u : polyC(K, polyCoeff(p, 0)) * Ring.one(polynomialRing(K, {0})) =
      polyC(K, polyCoeff(p, 0)) by ring
    rw u
    exact pc
  | succ(m) using ih =>
    intros p pIn dp nonzero
    have dNonzero : polyNatDegree(K, p) ≠ 0
      rw dp
      arith
    have pUni : p ∈ uniPolys(K)
      unfold uniPolys
      exact pIn
    obtain ⟨c, cK, cRoot⟩ := AlgebraicallyClosed.exists_root with field, closed, pUni,
      dNonzero
    have dvd := (polyXSubC.dvd_iff_root at K, p, c with comm, polys, pIn, cK).backward
      with cRoot
    obtain ⟨xcIn, _, q, qIn, pEq⟩ := dvd
    have qNonzero : q ≠ Ring.zero(polynomialRing(K, {0}))
      intro qz
      rw qz at pEq
      have z : polyXSubC(K, c) * Ring.zero(polynomialRing(K, {0})) =
        Ring.zero(polynomialRing(K, {0})) by ring
      rw z at pEq
      exact nonzero with pEq
    have xcMonic := PolyMonic.X_sub_C at K, c with comm, polys, cK
    have xcNonzero := PolyMonic.ne_zero at K, polyXSubC(K, c) with comm, polys, xcIn,
      distinct, xcMonic
    have degMul := polyNatDegree.mul at K, polyXSubC(K, c), q with comm, polys, xcIn, qIn,
      domain, xcNonzero, qNonzero
    rw ← pEq at degMul
    rw dp at degMul
    rw (polyNatDegree.X_sub_C at K, c with comm, polys, cK, distinct) at degMul
    have dq : polyNatDegree(K, q) = m by arith
    obtain ⟨a, aF, qEq⟩ := ih with q, qIn, dq, qNonzero
    have leadMul := polyLeadingCoeff.mul at K, polyXSubC(K, c), q with comm, polys, xcIn,
      qIn, domain
    rw ← pEq at leadMul
    obtain ⟨_, xcLead⟩ := xcMonic
    rw xcLead at leadMul
    have lqIn : polyLeadingCoeff(K, q) ∈ Ring.carrier(K)
      rw (uni.lead_eq at K, q with comm, polys)
      exact uni.coeff_mem at K, q, polyNatDegree(K, q) with comm, qIn
    have one : Ring.one(K) * polyLeadingCoeff(K, q) = polyLeadingCoeff(K, q) by ring
    rw one at leadMul
    have extended := tkJ.gal_linear_product_succ at K, a, c, m with comm, aF, cK
    obtain ⟨extF, prodEq⟩ := extended
    refine ⟨adjoinMap(a, m, c), extF, ?_⟩
    rw [prodEq, leadMul]
    have prodIn := (polyLinearProduct.monic at K, a, m with comm, polys, aF).left
    obtain ⟨prodP, _⟩ := prodIn
    have cqIn := polyC.mem at K, polyLeadingCoeff(K, q) with comm, polys, lqIn
    have target : polyXSubC(K, c) *
        (polyC(K, polyLeadingCoeff(K, q)) * polyLinearProduct(K, a, m)) =
        polyC(K, polyLeadingCoeff(K, q)) *
        (polyLinearProduct(K, a, m) * polyXSubC(K, c)) by ring
    have t : polyXSubC(K, c) * q = polyXSubC(K, c) *
        (polyC(K, polyLeadingCoeff(K, q)) * polyLinearProduct(K, a, m))
      rw ← qEq
    rw pEq
    rw t
    exact target

theorem AlgebraicallyClosed.splits (p : Set)
  requires closed : AlgebraicallyClosed(K)
  requires member : p ∈ uniPolys(K)
  shows PolySplits(K, K, identity(Ring.carrier(K)), p)
proof
  have comm := Field.to_comm_ring with field
  have pIn := member
  unfold uniPolys at pIn
  have idMap := tkJ.gal_polyMap_id at K, p with comm, pIn
  unfold PolySplits
  refine ⟨member, ?_⟩
  rw idMap
  by_cases pz : p = Ring.zero(polynomialRing(K, {0}))
  . left
    exact pz
  . right
    have nN : polyNatDegree(K, p) ∈ ℕ by typecheck
    have factor := tkJ.gal_closed_factor at K, polyNatDegree(K, p) with field, closed
    obtain ⟨a, aF, pEq⟩ := factor with p, pIn, rfl, pz
    refine ⟨polyNatDegree(K, p), nN, a, aF, ?_⟩
    rw idMap
    exact pEq

theorem AlgebraicallyClosed.exists_pow_eq (x : Set) (n : Nat)
  requires closed : AlgebraicallyClosed(K)
  requires point : x ∈ Ring.carrier(K)
  requires positive : 0 < n
  shows ∃ z ∈ Ring.carrier(K), Ring.pow(K, z, n) = x
proof
  have comm := Field.to_comm_ring with field
  have polys := polynomialRing.comm_ring at K, {0} with comm
  have parts := Field.parts with field
  have nt := IsField.nontrivial with parts
  obtain ⟨zeroK, oneK, distinct⟩ := nt
  have pr := CommRing.to_ring with polys
  have xIn := polyX.mem at K with comm, polys
  have cIn := polyC.mem at K, x with comm, polys, point
  have xn : Ring.pow(polynomialRing(K, {0}), polyX(K), n) ∈
      Ring.carrier(polynomialRing(K, {0}))
    rw (uni.X_pow at K, n with comm, polys)
    exact uni.term_mem at K, Ring.one(K), n with comm, polys, oneK
  have m : Ring.sub(polynomialRing(K, {0}), Ring.pow(polynomialRing(K, {0}), polyX(K), n),
    polyC(K, x)) ∈ Ring.carrier(polynomialRing(K, {0})) := Ring.sub_mem with *
  have coeff : ∀ k ∈ ℕ, polyCoeff(Ring.sub(polynomialRing(K, {0}),
      Ring.pow(polynomialRing(K, {0}), polyX(K), n), polyC(K, x)), k) =
      polyCoeff(Ring.pow(polynomialRing(K, {0}), polyX(K), n), k) -
      polyCoeff(polyC(K, x), k)
    intros k hk
    have kNat := nat.omega.backward with hk
    exact uni.coeff_sub at K, Ring.pow(polynomialRing(K, {0}), polyX(K), n), polyC(K, x), k
      with comm, polys, xn, cIn
  have nN : n ∈ ℕ by typecheck
  have top : polyCoeff(Ring.sub(polynomialRing(K, {0}),
      Ring.pow(polynomialRing(K, {0}), polyX(K), n), polyC(K, x)), n) = Ring.one(K)
    rw (coeff with n, nN)
    rw (uni.X_pow at K, n with comm, polys)
    have en : n = n by rfl
    have n0 : n ≠ 0 by arith
    rw ((uni.term_coeff at K, Ring.one(K), n, n with comm, polys, oneK).left with en)
    rw ((polyC.coeff at K, x, n with comm, polys, point).right with n0)
    ring
  have vanish : ∀ k ∈ ℕ, n < k → polyCoeff(Ring.sub(polynomialRing(K, {0}),
      Ring.pow(polynomialRing(K, {0}), polyX(K), n), polyC(K, x)), k) = Ring.zero(K)
    intros k hk lt
    have kNat := nat.omega.backward with hk
    rw (coeff with k, hk)
    rw (uni.X_pow at K, n with comm, polys)
    have kn : k ≠ n by arith
    have k0 : k ≠ 0 by arith
    rw ((uni.term_coeff at K, Ring.one(K), n, k with comm, polys, oneK).right with kn)
    rw ((polyC.coeff at K, x, k with comm, polys, point).right with k0)
    ring
  have r := uni.monic_of at K, Ring.sub(polynomialRing(K, {0}),
    Ring.pow(polynomialRing(K, {0}), polyX(K), n), polyC(K, x)), n with comm, polys, m,
    top, vanish
  have deg := r.right with distinct
  have degNonzero : polyNatDegree(K, Ring.sub(polynomialRing(K, {0}),
      Ring.pow(polynomialRing(K, {0}), polyX(K), n), polyC(K, x))) ≠ 0
    rw deg
    arith
  have mUni : Ring.sub(polynomialRing(K, {0}),
      Ring.pow(polynomialRing(K, {0}), polyX(K), n), polyC(K, x)) ∈ uniPolys(K)
    unfold uniPolys
    exact m
  obtain ⟨z, zK, rootZ⟩ := AlgebraicallyClosed.exists_root with field, closed, mUni,
    degNonzero
  obtain ⟨_, value⟩ := rootZ
  have evalHom := polyEval.hom at K, z with comm, polys, zK
  unfold polyEval at value
  rw (RingHom.map_sub with evalHom, xn, cIn) at value
  rw (RingHom.map_pow with polys, comm, evalHom, xIn) at value
  have eX := polyEval.X at K, z with comm, polys, zK
  have eC := polyEval.C at K, x, z with comm, polys, point, zK
  unfold polyEval at eX
  unfold polyEval at eC
  rw [eX, eC] at value
  refine ⟨z, zK, ?_⟩
  have zn : Ring.pow(K, z, n) ∈ Ring.carrier(K) by typecheck
  have back : Ring.pow(K, z, n) = (Ring.pow(K, z, n) - x) + x by ring
  rw value at back
  have zz : Ring.zero(K) + x = x by ring
  rw zz at back
  exact back

-- An algebraically closed field has no proper algebraic extension
-- (IsAlgClosed.algebraMap_surjective_of_isIntegral).
theorem AlgebraicallyClosed.algebraic_surjective (E : Set)
  requires closed : AlgebraicallyClosed(K)
  requires base : Algebra.base(E) = K
  requires algebraic : AlgebraicExtension(E)
  shows bottomField(E) = algebraCarrier(E)
proof
  have closed2 := closed
  rw ← base at closed2
  have alg2 := algebraic
  obtain ⟨extension, algAlg⟩ := alg2
  have ext2 := extension
  obtain ⟨algebra, baseField, ringField⟩ := ext2
  obtain ⟨_, allAlg⟩ := algAlg
  have comm := Field.to_comm_ring with baseField
  have polys := polynomialRing.comm_ring at Algebra.base(E), {0} with comm
  have domainK := Field.domain with baseField
  have domainL := Field.domain with ringField
  have ringL := Algebra.comm_ring with algebra
  have ringParts := Field.parts with ringField
  have ntL := IsField.nontrivial with ringParts
  obtain ⟨_, _, distinctL⟩ := ntL
  have baseParts := Field.parts with baseField
  have ntK := IsField.nontrivial with baseParts
  obtain ⟨_, _, distinctK⟩ := ntK
  have mapF := Algebra.map_function with algebra
  apply Subset.antisymmetric
  . unfold bottomField
    exact functionImage.subset at Algebra.map(E), Ring.carrier(Algebra.base(E)),
      algebraCarrier(E)
  . intros x xL
    have xAlg := allAlg with x, xL
    have xInt := (AlgebraicElement.iff_integral at E, x with algebra, baseField).forward
      with xAlg
    have sel := minpoly.selected with extension, xInt
    obtain ⟨mIn, mMonic, mRoot, _⟩ := sel
    have mP := mIn
    unfold uniPolys at mP
    have irr := minpoly.irreducible with extension, xInt
    have notUnit := tkJ.gal_minpoly_not_unit with extension, xInt
    have degNonzero : polyNatDegree(Algebra.base(E), minpoly(E, x)) ≠ 0
      intro d0
      apply notUnit
      have cl : minpoly(E, x) ∈ polyDegreeLT(Algebra.base(E), 1)
        unfold polyDegreeLT
        refine ⟨mP, ?_⟩
        intros k hk
        have sc := uni.deg_spec at Algebra.base(E), minpoly(E, x) with comm, polys, mP
        unfold polyDegrees at hk
        obtain ⟨kN, nzk⟩ := hk
        have kNat := nat.omega.backward with kN
        have nz2 : polyCoeff(minpoly(E, x), k) ≠ Ring.zero(Algebra.base(E))
          unfold polyCoeff
          exact nzk
        have le := sc.left with k, kN, nz2
        arith
      have mc := uni.const_of_lt_one at Algebra.base(E), minpoly(E, x) with comm, polys, cl
      have mm := mMonic
      obtain ⟨_, lead⟩ := mm
      rw (uni.lead_eq at Algebra.base(E), minpoly(E, x) with comm, polys) at lead
      rw d0 at lead
      rw lead at mc
      rw ← (uni.one_eq at Algebra.base(E) with comm, polys) at mc
      rw mc
      exact RingUnit.one at polynomialRing(Algebra.base(E), {0}) with polys
    obtain ⟨a, aK, aRoot⟩ := AlgebraicallyClosed.exists_root at Algebra.base(E),
      minpoly(E, x) with baseField, closed2, mIn, degNonzero
    have dvd := (polyXSubC.dvd_iff_root at Algebra.base(E), minpoly(E, x), a with comm,
      polys, mP, aK).backward with aRoot
    obtain ⟨xaIn, _, c, cIn, mEq⟩ := dvd
    obtain ⟨_, _, factors⟩ := irr
    have alt := factors with polyXSubC(Algebra.base(E), a), xaIn, c, cIn, mEq
    cases alt with xaUnit | cUnit
    . exfalso
      obtain ⟨u, uIn, uEq⟩ := (polynomialRing.unit_iff at Algebra.base(E),
        polyXSubC(Algebra.base(E), a) with comm, polys, xaIn, domainK).forward with xaUnit
      have d1 := polyNatDegree.X_sub_C at Algebra.base(E), a with comm, polys, aK,
        distinctK
      obtain ⟨uK, _⟩ := ringUnits.membership.forward with uIn
      have d0 := polyNatDegree.C at Algebra.base(E), u with comm, polys, uK
      rw uEq at d1
      rw d0 at d1
      arith
    . obtain ⟨_, d, dIn, cd, _⟩ := cUnit
      have xaUni : polyXSubC(Algebra.base(E), a) ∈ uniPolys(Algebra.base(E))
        unfold uniPolys
        exact xaIn
      have cUni : c ∈ uniPolys(Algebra.base(E))
        unfold uniPolys
        exact cIn
      have dUni : d ∈ uniPolys(Algebra.base(E))
        unfold uniPolys
        exact dIn
      have ev := tkJ.gal_aeval_mul with algebra, xL, xaUni, cUni
      rw [← mEq, mRoot] at ev
      have evcd := tkJ.gal_aeval_mul with algebra, xL, cUni, dUni
      rw [cd, (tkJ.gal_aeval_one with algebra, xL)] at evcd
      have xaL := tkJ.gal_aeval_mem with algebra, xL, xaUni
      have cL := tkJ.gal_aeval_mem with algebra, xL, cUni
      have dL := tkJ.gal_aeval_mem with algebra, xL, dUni
      have cNonzero : polyAeval(E, x, c) ≠ Ring.zero(Algebra.ring(E))
        intro cz
        rw cz at evcd
        have z : Ring.zero(Algebra.ring(E)) * polyAeval(E, x, d) =
          Ring.zero(Algebra.ring(E)) by ring
        rw z at evcd
        symm at evcd
        exact distinctL with evcd
      symm at ev
      have alt2 := (IntegralDomain.mul_eq_zero at Algebra.ring(E),
        polyAeval(E, x, polyXSubC(Algebra.base(E), a)), polyAeval(E, x, c) with domainL,
        xaL, cL).forward with ev
      cases alt2 with xaZero | cZero
      . have aevalHom := tkJ.gal_aeval_hom with algebra, xL
        have xIn := polyX.mem at Algebra.base(E) with comm, polys
        have caIn := polyC.mem at Algebra.base(E), a with comm, polys, aK
        have eX := polyAeval.X at E, x with algebra, xL
        have eC := polyAeval.C at E, x, a with algebra, xL, aK
        unfold polyAeval at eX
        unfold polyEval2 at eX
        unfold polyAeval at eC
        unfold polyEval2 at eC
        unfold polyXSubC at xaZero
        unfold polyAeval at xaZero
        unfold polyEval2 at xaZero
        rw (RingHom.map_sub with aevalHom, xIn, caIn) at xaZero
        rw [eX, eC] at xaZero
        have xL2 := xL
        unfold algebraCarrier at xL2
        have maL := Algebra.map_mem with algebra, aK
        have back : x = (x - Algebra.map(E)(a)) + Algebra.map(E)(a) by ring
        rw xaZero at back
        have zz : Ring.zero(Algebra.ring(E)) + Algebra.map(E)(a) = Algebra.map(E)(a)
          by ring
        rw zz at back
        unfold bottomField
        apply functionImage.membership.backward
        exact ⟨xL, a, aK, back⟩
      . exfalso
        exact cNonzero with cZero

-- AlgebraicClosure K with IsAlgClosure: every field has an algebraic
-- closure (a theorem; no closure is chosen in a definition), unique up to
-- K-isomorphism (IsAlgClosure.equiv).
theorem IsAlgebraicClosure.exists
  shows ∃ E, Algebra.base(E) = K ∧ IsAlgebraicClosure(E)
proof
  sorry

theorem IsAlgebraicClosure.unique (E E2 : Set)
  requires base : Algebra.base(E) = K
  requires baseTwo : Algebra.base(E2) = K
  requires first : IsAlgebraicClosure(E)
  requires second : IsAlgebraicClosure(E2)
  shows ∃ f, f : E ≃ₐ E2
proof
  sorry

-- IsAlgClosed.lift: an algebraic extension of K embeds over K into any
-- algebraically closed extension of K.
theorem AlgebraicallyClosed.lift (E E2 : Set)
  requires base : Algebra.base(E) = K
  requires baseTwo : Algebra.base(E2) = K
  requires algebraic : AlgebraicExtension(E)
  requires target : FieldExtension(E2)
  requires closed : AlgebraicallyClosed(Algebra.ring(E2))
  shows ∃ f, f : E →ₐ E2
proof
  sorry

-- An algebraic closure is normal and, over a field where every
-- irreducible polynomial is separable, Galois; an algebraic extension
-- of K embeds into it with image an intermediate field.
theorem IsAlgebraicClosure.normal (E : Set)
  requires base : Algebra.base(E) = K
  requires closure : IsAlgebraicClosure(E)
  shows NormalExtension(E)
proof
  obtain ⟨algebraic, closedL⟩ := closure
  have alg2 := algebraic
  obtain ⟨extension, algAlg⟩ := alg2
  have ext2 := extension
  obtain ⟨algebra, baseField, ringField⟩ := ext2
  obtain ⟨_, allAlg⟩ := algAlg
  have comm := Field.to_comm_ring with baseField
  have polys := polynomialRing.comm_ring at Algebra.base(E), {0} with comm
  have ringL := Algebra.comm_ring with algebra
  have polysL := polynomialRing.comm_ring at Algebra.ring(E), {0} with ringL
  have mapL := Algebra.structure_hom with algebra
  unfold NormalExtension
  refine ⟨algebraic, ?_⟩
  intros x xL
  have xAlg := allAlg with x, xL
  have xInt := (AlgebraicElement.iff_integral at E, x with algebra, baseField).forward
    with xAlg
  have sel := minpoly.selected with extension, xInt
  obtain ⟨mIn, _, _, _⟩ := sel
  have mP := mIn
  unfold uniPolys at mP
  have mapHom := polyMap.hom at Algebra.base(E), Algebra.ring(E), Algebra.map(E) with
    comm, polys, ringL, mapL
  have qIn := RingHom.map_mem with mapHom, mP
  have qUni : polyMap(Algebra.base(E), Algebra.ring(E), Algebra.map(E))(minpoly(E, x)) ∈
      uniPolys(Algebra.ring(E))
    unfold uniPolys
    exact qIn
  have split := AlgebraicallyClosed.splits at Algebra.ring(E), polyMap(Algebra.base(E),
    Algebra.ring(E), Algebra.map(E))(minpoly(E, x)) with ringField, closedL, qUni
  have idMap := tkJ.gal_polyMap_id at Algebra.ring(E), polyMap(Algebra.base(E),
    Algebra.ring(E), Algebra.map(E))(minpoly(E, x)) with ringL, qIn
  obtain ⟨_, alt⟩ := split
  unfold PolySplits
  refine ⟨mIn, ?_⟩
  cases alt with qz | product
  . left
    rw idMap at qz
    exact qz
  . right
    obtain ⟨n, nN, a, aF, qEq⟩ := product
    rw idMap at qEq
    exact ⟨n, nN, a, aF, qEq⟩

end Closures
