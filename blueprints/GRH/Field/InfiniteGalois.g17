-- Infinite Galois theory: the Krull topology on Gal(L/K), with the
-- fixing subgroups of finite intermediate fields and their cosets as a
-- basis; Gal(L/K) as a profinite group for algebraic L/K; open and closed
-- fixing subgroups; the Galois correspondence between intermediate fields
-- and closed subgroups, finite ones and open subgroups, Galois ones and
-- closed normal subgroups; finite Galois intermediate fields and
-- restriction to them; and Galois groups of a ring extension given by a
-- faithful action with the right invariants (IsGaloisGroup).
-- Part of the GRH blueprint.
-- Planned home: Algebra/Field/InfiniteGalois.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Field.InfiniteGalois
import GRH.Field.Galois
import GRH.Topology.Groups
import Grace.Cumulus.Algebra.Group.Isomorphism

-- Section: The Krull topology
-- The finite intermediate fields, and the finite Galois ones
-- (FiniteGaloisIntermediateField K L).
def finiteSubfields (E : Set) : Set :=
  { F ∈ intermediateFields(E) | FiniteExtension(subextension(E, F)) }

predicate FiniteGaloisIntermediateField (E F : Set) :=
  IntermediateField(E, F) ∧ FiniteExtension(subextension(E, F)) ∧
  GaloisExtension(subextension(E, F))

-- The left coset σ H in Gal(L/K).
def autCoset (E σ H : Set) : Set := { Group.mul(galoisGroup(E))(σ, τ) | τ ∈ H }

-- The Krull topology (krullTopology K L): U is open when each σ ∈ U has a
-- neighbourhood σ Gal(L/F) ⊆ U for a finite intermediate field F. This is
-- the topology Mathlib generates from the group filter basis of the
-- subgroups Gal(L/F), F finite (galGroupBasis).
def krullOpens (E : Set) : Set :=
  { U ∈ 𝒫(algebraAutomorphisms(E)) | ∀ σ ∈ U, ∃ F ∈ finiteSubfields(E),
    autCoset(E, σ, fixingSubgroup(E, F)) ⊆ U }

def krullTopology (E : Set) : Set :=
  TopologicalSpace.mk(algebraAutomorphisms(E), krullOpens(E))

-- Section: Galois groups of ring extensions
-- G with ρ : G → Aut_A(B) is a Galois group of B/A (IsGaloisGroup G A B):
-- the action is faithful (ρ injective), A-linear (ρ lands in the
-- A-algebra automorphisms), and the invariants of B are the image of A
-- (Algebra.IsInvariant). Here E is any Cumulus algebra B over A, and
-- galoisGroup(E) is the group of its algebra automorphisms.
predicate IsGaloisGroup (G ρ E : Set) :=
  Algebra(E) ∧ GroupHom(ρ, G, galoisGroup(E)) ∧
  InjectiveBetween(ρ, Group.carrier(G), algebraAutomorphisms(E)) ∧
  fixedField(E, functionImage(ρ, Group.carrier(G), algebraAutomorphisms(E))) =
    bottomField(E)

-- Helpers: restricting a function to its whole domain changes nothing, so
-- L as an intermediate field of L/K gives back L/K.
theorem tkJ.restrict_whole (f A B : Set)
  requires function : f : A → B
  shows restrict(f, A) = f
proof
  ext p
  constructor
  . intro hp
    obtain ⟨original, _⟩ := restrict.membership.forward with hp
    exact original
  . intro hp
    obtain ⟨x, xA, y, yB, shape, _⟩ := FunctionBetween.member_shape with function, hp
    apply restrict.membership.backward
    exact ⟨hp, x, xA, y, shape⟩

theorem tkJ.subring_whole (R : Set)
  requires comm : CommRing(R)
  shows subringRing(R, Ring.carrier(R)) = R
proof
  have parts := CommRing.parts with comm
  have ring := CommRing.to_ring with comm
  have addition : IsMagma(Ring.carrier(R), Ring.add(R)) by
    simp [IsCommRing, IsRing, IsAbelianGroup, IsGroup, IsMonoid, IsSemigroup]
  have multiplication : IsMagma(Ring.carrier(R), Ring.mul(R)) by
    simp [IsCommRing, IsRing, IsMonoid, IsSemigroup]
  have negF : Ring.neg(R) : Ring.carrier(R) → Ring.carrier(R) by
    simp [IsCommRing, IsRing, IsAbelianGroup, IsGroup, Inverse]
  unfold IsMagma at addition
  unfold IsMagma at multiplication
  have eta := Ring.eta_of_ring with ring
  unfold subringRing
  rw [(tkJ.restrict_whole with addition), (tkJ.restrict_whole with multiplication),
    (tkJ.restrict_whole with negF)]
  symm
  exact eta

theorem tkJ.sub_top (E : Set)
  requires extension : FieldExtension(E)
  shows subextension(E, algebraCarrier(E)) = E
proof
  obtain ⟨algebra, _, _⟩ := extension
  have ringL := Algebra.comm_ring with algebra
  have whole := tkJ.subring_whole with ringL
  have alg2 := algebra
  obtain ⟨shape, _⟩ := alg2
  have eta := Algebra.eta with shape
  unfold subextension
  unfold algebraCarrier
  rw whole
  symm
  exact eta

section Krull
variable (E : Set)
hypothesis extension : FieldExtension(E)

-- Helpers for the Krull topology: membership in a coset σ Gal(L/S), the
-- finite subfields generated by finite sets of integral elements, and
-- the openness of cosets.
theorem tkJ.coset_iff (σ S ρ : Set)
  requires automorphism : σ ∈ algebraAutomorphisms(E)
  requires subset : S ⊆ algebraCarrier(E)
  shows ρ ∈ autCoset(E, σ, fixingSubgroup(E, S)) ↔
    ρ ∈ algebraAutomorphisms(E) ∧ (∀ s ∈ S, ρ(s) = σ(s))
proof
  have fσ := tkJ.aut_function with automorphism
  have bijσ := tkJ.aut_bijective with automorphism
  have σInv := tkJ.aut_converse_mem with automorphism
  have fInv := tkJ.aut_function with σInv
  constructor
  . intro hρ
    obtain ⟨τ, τIn, ρEq⟩ := autCoset.membership.forward with hρ
    obtain ⟨τA, τFix⟩ := fixingSubgroup.membership.forward with τIn
    rw [tkJ.galois_mul, (tkJ.autComposition_apply with automorphism, τA)] at ρEq
    have mem := tkJ.aut_compose_mem with automorphism, τA
    have fτ := tkJ.aut_function with τA
    rw ρEq at mem
    refine ⟨mem, ?_⟩
    intros s sS
    have sL := subset with s, sS
    rw ← ρEq
    rw (compose.apply with fτ, fσ, sL)
    rw (τFix with s, sS)
  . intro h
    obtain ⟨ρA, agree⟩ := h
    have fρ := tkJ.aut_function with ρA
    have τA := tkJ.aut_compose_mem with σInv, ρA
    have fτ := tkJ.aut_function with τA
    have τFix : compose(converse(σ, algebraCarrier(E), algebraCarrier(E)), ρ,
        algebraCarrier(E), algebraCarrier(E), algebraCarrier(E)) ∈ fixingSubgroup(E, S)
      apply fixingSubgroup.membership.backward
      refine ⟨τA, ?_⟩
      intros s sS
      have sL := subset with s, sS
      rw (compose.apply with fρ, fInv, sL)
      rw (agree with s, sS)
      exact Bijective.inverse_apply with bijσ, sL
    apply autCoset.membership.backward
    refine ⟨compose(converse(σ, algebraCarrier(E), algebraCarrier(E)), ρ,
      algebraCarrier(E), algebraCarrier(E), algebraCarrier(E)), τFix, ?_⟩
    rw [tkJ.galois_mul, (tkJ.autComposition_apply with automorphism, τA)]
    have cA := tkJ.aut_compose_mem with automorphism, τA
    apply galoisGroup.ext with extension, cA, ρA
    intros x xL
    rw (compose.apply with fτ, fσ, xL)
    rw (compose.apply with fρ, fInv, xL)
    have ρx := FunctionBetween.apply_closed with fρ, xL
    exact Bijective.apply_inverse with bijσ, ρx

theorem tkJ.adjoin_finite_subfield (S : Set)
  requires subset : S ⊆ algebraCarrier(E)
  requires finite : Finite(S)
  requires integral : ∀ x ∈ S, IntegralElement(E, x)
  shows fieldAdjoin(E, S) ∈ finiteSubfields(E) ∧
    fixingSubgroup(E, fieldAdjoin(E, S)) = fixingSubgroup(E, S)
proof
  have inter := fieldAdjoin.intermediate with extension, subset
  have fin := fieldAdjoin.finite_of_finite with extension, subset, finite, integral
  have pw := (tkJ.intermediate_member at E, fieldAdjoin(E, S)).backward with inter
  have mem : fieldAdjoin(E, S) ∈ finiteSubfields(E)
    apply finiteSubfields.membership.backward
    exact ⟨pw, fin⟩
  exact ⟨mem, (fixingSubgroup.adjoin with extension, subset)⟩

theorem tkJ.coset_open (σ F : Set)
  requires automorphism : σ ∈ algebraAutomorphisms(E)
  requires member : F ∈ finiteSubfields(E)
  shows autCoset(E, σ, fixingSubgroup(E, F)) ∈ krullOpens(E)
proof
  obtain ⟨inter, _⟩ := finiteSubfields.membership.forward with member
  have interF := (tkJ.intermediate_member at E, F).forward with inter
  have Fbound := tkJ.intermediate_bounded with interF
  have bounded : autCoset(E, σ, fixingSubgroup(E, F)) ⊆ algebraAutomorphisms(E)
    intros ρ hρ
    obtain ⟨ρA, _⟩ := (tkJ.coset_iff at E, σ, F, ρ with extension, automorphism,
      Fbound).forward with hρ
    exact ρA
  have pw := (powerset.membership_iff at autCoset(E, σ, fixingSubgroup(E, F)),
    algebraAutomorphisms(E)).backward with bounded
  apply krullOpens.membership.backward
  refine ⟨pw, ?_⟩
  intros ρ hρ
  obtain ⟨ρA, agreeρ⟩ := (tkJ.coset_iff at E, σ, F, ρ with extension, automorphism,
    Fbound).forward with hρ
  refine ⟨F, member, ?_⟩
  intros π hπ
  obtain ⟨πA, agreeπ⟩ := (tkJ.coset_iff at E, ρ, F, π with extension, ρA, Fbound).forward with
    hπ
  apply (tkJ.coset_iff at E, σ, F, π with extension, automorphism, Fbound).backward
  refine ⟨πA, ?_⟩
  intros s sF
  rw (agreeπ with s, sF)
  exact agreeρ with s, sF

theorem tkJ.finite_subfield_generators (F : Set)
  requires member : F ∈ finiteSubfields(E)
  shows ∃ T, T ⊆ F ∧ T ⊆ algebraCarrier(E) ∧ Finite(T) ∧
    (∀ t ∈ T, IntegralElement(E, t)) ∧ fixingSubgroup(E, T) = fixingSubgroup(E, F)
proof
  have ext2 := extension
  obtain ⟨algebra, baseField, _⟩ := ext2
  have commK := Field.to_comm_ring with baseField
  have ringK := CommRing.to_ring with commK
  have moduleV := algebraModule.module_of with algebra
  obtain ⟨inter, finF⟩ := finiteSubfields.membership.forward with member
  have interF := (tkJ.intermediate_member at E, F).forward with inter
  have Fbound := tkJ.intermediate_bounded with interF
  have fg := (tkJ.finite_iff_fg with extension, interF).forward with finF
  have fg2 := fg
  obtain ⟨_, T, TF, finT, spanT⟩ := fg2
  have i2 := interF
  obtain ⟨_, subAlg, _⟩ := i2
  have TL := Subset.transitive with TF, Fbound
  have integral : ∀ t ∈ T, IntegralElement(E, t)
    intros t tT
    have tF := TF with t, tT
    exact IntegralElement.of_mem_fg at E, F, t with algebra, subAlg, fg, tF
  refine ⟨T, TF, TL, finT, integral, ?_⟩
  have adj := tkJ.adjoin_finite_subfield with extension, TL, finT, integral
  obtain ⟨_, fixEq⟩ := adj
  have interT := fieldAdjoin.intermediate with extension, TL
  have subT := tkJ.tower_submodule with extension, interT
  have inAdj := fieldAdjoin.subset_adjoin with extension, TL
  have VL := algebraModule.carrier_eq at E
  have TV : T ⊆ Module.carrier(algebraModule(E))
    rw VL
    exact TL
  have le := (moduleSpan.least_of at Algebra.base(E), algebraModule(E), T, fieldAdjoin(E, T)
    with ringK, moduleV, TV, subT).backward with inAdj
  rw spanT at le
  have ge := (fieldAdjoin.le_iff with extension, TL, interF).backward with TF
  have same : fieldAdjoin(E, T) = F
    exact Subset.antisymmetric with ge, le
  rw ← fixEq
  rw same

-- krullTopology is a topology making Gal(L/K) a topological group
-- (krullTopology, IsTopologicalGroup (L ≃ₐ[K] L)).
theorem krullTopology.topological_group
  shows TopologicalSpace(krullTopology(E)) ∧
    TopologicalGroup(galoisGroup(E), krullTopology(E))
proof
  have carrierOf : TopologicalSpace.carrier(krullTopology(E)) = algebraAutomorphisms(E)
    simp [krullTopology, TopologicalSpace.mk.carrier]
  have opensOf : TopologicalSpace.opens(krullTopology(E)) = krullOpens(E)
    simp [krullTopology, TopologicalSpace.mk.opens]
  have ext2 := extension
  obtain ⟨algebra, _, _⟩ := ext2
  have emptyL : ∅ ⊆ algebraCarrier(E)
    intros x hx
    exfalso
    exact empty.membership at x with hx
  have emptyInt : ∀ x ∈ ∅, IntegralElement(E, x)
    intros x hx
    exfalso
    exact empty.membership at x with hx
  have bot := tkJ.adjoin_finite_subfield with extension, emptyL, Finite.empty, emptyInt
  obtain ⟨botMem, _⟩ := bot
  have subsets : krullOpens(E) ⊆ 𝒫(algebraAutomorphisms(E))
    intros U hU
    obtain ⟨pw, _⟩ := krullOpens.membership.forward with hU
    exact pw
  have whole : algebraAutomorphisms(E) ∈ krullOpens(E)
    have refl := Subset.reflexive at algebraAutomorphisms(E)
    have pw := (powerset.membership_iff at algebraAutomorphisms(E),
      algebraAutomorphisms(E)).backward with refl
    apply krullOpens.membership.backward
    refine ⟨pw, ?_⟩
    intros σ σA
    obtain ⟨inter, _⟩ := finiteSubfields.membership.forward with botMem
    have interF := (tkJ.intermediate_member at E, fieldAdjoin(E, ∅)).forward with inter
    have Fbound := tkJ.intermediate_bounded with interF
    refine ⟨fieldAdjoin(E, ∅), botMem, ?_⟩
    intros ρ hρ
    obtain ⟨ρA, _⟩ := (tkJ.coset_iff at E, σ, fieldAdjoin(E, ∅), ρ with extension, σA,
      Fbound).forward with hρ
    exact ρA
  have unions : ∀ S, S ⊆ krullOpens(E) → ⋃(S) ∈ krullOpens(E)
    intros S SK
    have bounded : ⋃(S) ⊆ algebraAutomorphisms(E)
      apply union.subset
      intros U US
      have UK := SK with U, US
      obtain ⟨pw, _⟩ := krullOpens.membership.forward with UK
      exact (powerset.membership_iff at U, algebraAutomorphisms(E)).forward with pw
    have pw := (powerset.membership_iff at ⋃(S), algebraAutomorphisms(E)).backward with bounded
    apply krullOpens.membership.backward
    refine ⟨pw, ?_⟩
    intros σ σIn
    obtain ⟨U, US, σU⟩ := (union.membership at σ, S).forward with σIn
    have UK := SK with U, US
    obtain ⟨_, cond⟩ := krullOpens.membership.forward with UK
    obtain ⟨F, Fin, coset⟩ := cond with σ, σU
    refine ⟨F, Fin, ?_⟩
    intros ρ hρ
    exact union.contains at ρ, U, S with US, (coset with ρ, hρ)
  have inters : ∀ U ∈ krullOpens(E), ∀ V ∈ krullOpens(E), U ∩ V ∈ krullOpens(E)
    intros U hU V hV
    obtain ⟨pwU, condU⟩ := krullOpens.membership.forward with hU
    obtain ⟨pwV, condV⟩ := krullOpens.membership.forward with hV
    have UA := (powerset.membership_iff at U, algebraAutomorphisms(E)).forward with pwU
    have bounded : U ∩ V ⊆ algebraAutomorphisms(E)
      intros σ σIn
      obtain ⟨σU, _⟩ := intersection.membership.forward with σIn
      exact UA with σ, σU
    have pw := (powerset.membership_iff at U ∩ V, algebraAutomorphisms(E)).backward with bounded
    apply krullOpens.membership.backward
    refine ⟨pw, ?_⟩
    intros σ σIn
    obtain ⟨σU, σV⟩ := intersection.membership.forward with σIn
    have σA := UA with σ, σU
    obtain ⟨F1, F1in, c1⟩ := condU with σ, σU
    obtain ⟨F2, F2in, c2⟩ := condV with σ, σV
    obtain ⟨inter1, fin1⟩ := finiteSubfields.membership.forward with F1in
    obtain ⟨inter2, fin2⟩ := finiteSubfields.membership.forward with F2in
    have i1 := (tkJ.intermediate_member at E, F1).forward with inter1
    have i2 := (tkJ.intermediate_member at E, F2).forward with inter2
    have b1 := tkJ.intermediate_bounded with i1
    have b2 := tkJ.intermediate_bounded with i2
    have F12 : F1 ∪ F2 ⊆ algebraCarrier(E)
      intros x hx
      rw union2.membership at hx
      cases hx with x1 | x2
      . exact b1 with x, x1
      . exact b2 with x, x2
    have i3 := fieldAdjoin.intermediate with extension, F12
    have fin3 := IntermediateField.sup_finite with extension, i1, i2, fin1, fin2
    have pw3 := (tkJ.intermediate_member at E, fieldAdjoin(E, F1 ∪ F2)).backward with i3
    have F3in : fieldAdjoin(E, F1 ∪ F2) ∈ finiteSubfields(E)
      apply finiteSubfields.membership.backward
      exact ⟨pw3, fin3⟩
    have b3 := tkJ.intermediate_bounded with i3
    have inAdj := fieldAdjoin.subset_adjoin with extension, F12
    refine ⟨fieldAdjoin(E, F1 ∪ F2), F3in, ?_⟩
    intros ρ hρ
    obtain ⟨ρA, agree⟩ := (tkJ.coset_iff at E, σ, fieldAdjoin(E, F1 ∪ F2), ρ with extension,
      σA, b3).forward with hρ
    have in1 : ρ ∈ autCoset(E, σ, fixingSubgroup(E, F1))
      apply (tkJ.coset_iff at E, σ, F1, ρ with extension, σA, b1).backward
      refine ⟨ρA, ?_⟩
      intros x xF
      have xU := union2.left at x, F1, F2 with xF
      exact agree with x, (inAdj with x, xU)
    have in2 : ρ ∈ autCoset(E, σ, fixingSubgroup(E, F2))
      apply (tkJ.coset_iff at E, σ, F2, ρ with extension, σA, b2).backward
      refine ⟨ρA, ?_⟩
      intros x xF
      have xU := union2.right at x, F1, F2 with xF
      exact agree with x, (inAdj with x, xU)
    exact intersection.membership.backward with ⟨(c1 with ρ, in1), (c2 with ρ, in2)⟩
  have topology : IsTopology(algebraAutomorphisms(E), krullOpens(E))
    unfold IsTopology
    exact ⟨subsets, whole, unions, inters⟩
  have space : TopologicalSpace(krullTopology(E))
    unfold krullTopology
    exact TopologicalSpace.of_parts with topology
  refine ⟨space, ?_⟩
  have group := galoisGroup.group with extension
  have topK : IsTopology(TopologicalSpace.carrier(krullTopology(E)),
      TopologicalSpace.opens(krullTopology(E)))
    rw [carrierOf, opensOf]
    exact topology
  have prodTop := productTopology.topology with topK, topK
  have prodSpace : TopologicalSpace(productSpace(krullTopology(E), krullTopology(E)))
    unfold productSpace
    exact TopologicalSpace.of_parts with prodTop
  -- the image of a finite set of integral elements under an automorphism
  have imageGen : ∀ τ ∈ algebraAutomorphisms(E), ∀ T, T ⊆ algebraCarrier(E) → Finite(T) →
      (∀ t ∈ T, IntegralElement(E, t)) →
      functionImage(τ, T, algebraCarrier(E)) ⊆ algebraCarrier(E) ∧
      Finite(functionImage(τ, T, algebraCarrier(E))) ∧
      (∀ y ∈ functionImage(τ, T, algebraCarrier(E)), IntegralElement(E, y))
    intros τ τA T TL finT intT
    have fτ := tkJ.aut_function with τA
    have isoτ := (tkJ.aut_member at E, τ).forward with τA
    obtain ⟨homτ, _⟩ := isoτ
    have sub := functionImage.subset at τ, T, algebraCarrier(E)
    have fin := Finite.function_image with fτ, finT, TL
    refine ⟨sub, fin, ?_⟩
    intros y yIn
    obtain ⟨_, t, tT, yEq⟩ := functionImage.membership.forward with yIn
    rw yEq
    exact IntegralElement.map at E, E, τ, t with homτ, (intT with t, tT)
  have mulCont : Group.mul(galoisGroup(E)) : productSpace(krullTopology(E), krullTopology(E))
      ⇒ krullTopology(E)
    apply Continuous.mk with prodSpace, space
    . rw [productSpace.carrier, carrierOf, tkJ.galois_mul]
      exact tkJ.autComposition_function at E
    . rw [productSpace.opens, productSpace.carrier, carrierOf, opensOf, tkJ.galois_mul]
      intros V hV
      obtain ⟨_, condV⟩ := krullOpens.membership.forward with hV
      have preSub := functionPreimage.subset at autComposition(E),
        algebraAutomorphisms(E) × algebraAutomorphisms(E), V
      have pw := (powerset.membership_iff at functionPreimage(autComposition(E),
        algebraAutomorphisms(E) × algebraAutomorphisms(E), V),
        algebraAutomorphisms(E) × algebraAutomorphisms(E)).backward with preSub
      apply productTopology.membership.backward
      refine ⟨pw, ?_⟩
      intros p hp
      obtain ⟨pIn, pV⟩ := functionPreimage.membership.forward with hp
      obtain ⟨_, σ, σA, τ, τA, pEq⟩ := product.membership.forward with pIn
      rw pEq at pV
      have r1 := tkJ.autComposition_apply with σA, τA
      unfold call2 at r1
      rw r1 at pV
      have στA := tkJ.aut_compose_mem with σA, τA
      obtain ⟨F, Fin, coset⟩ := condV with compose(σ, τ, algebraCarrier(E), algebraCarrier(E),
        algebraCarrier(E)), pV
      obtain ⟨T, TF, TL, finT, intT, fixEq⟩ := tkJ.finite_subfield_generators with extension,
        Fin
      obtain ⟨T2L, finT2, intT2⟩ := imageGen with τ, τA, T, TL, finT, intT
      have adj := tkJ.adjoin_finite_subfield with extension, T2L, finT2, intT2
      obtain ⟨F1in, _⟩ := adj
      obtain ⟨interF, _⟩ := finiteSubfields.membership.forward with Fin
      have iF := (tkJ.intermediate_member at E, F).forward with interF
      have bF := tkJ.intermediate_bounded with iF
      have iF1 := fieldAdjoin.intermediate with extension, T2L
      have bF1 := tkJ.intermediate_bounded with iF1
      have inAdj := fieldAdjoin.subset_adjoin with extension, T2L
      have open1 := tkJ.coset_open with extension, σA, F1in
      have open2 := tkJ.coset_open with extension, τA, Fin
      have fσ := tkJ.aut_function with σA
      have fτ := tkJ.aut_function with τA
      have σIn : σ ∈ autCoset(E, σ, fixingSubgroup(E, fieldAdjoin(E, functionImage(τ, T,
          algebraCarrier(E)))))
        apply (tkJ.coset_iff at E, σ, fieldAdjoin(E, functionImage(τ, T, algebraCarrier(E))), σ
          with extension, σA, bF1).backward
        refine ⟨σA, ?_⟩
        intros s sS
        rfl
      have τIn : τ ∈ autCoset(E, τ, fixingSubgroup(E, F))
        apply (tkJ.coset_iff at E, τ, F, τ with extension, τA, bF).backward
        refine ⟨τA, ?_⟩
        intros s sS
        rfl
      refine ⟨autCoset(E, σ, fixingSubgroup(E, fieldAdjoin(E, functionImage(τ, T,
        algebraCarrier(E))))), open1, autCoset(E, τ, fixingSubgroup(E, F)), open2, ?_, ?_⟩
      . rw pEq
        exact product.pair with σIn, τIn
      . intros q hq
        obtain ⟨_, σ2, σ2In, τ2, τ2In, qEq⟩ := product.membership.forward with hq
        obtain ⟨σ2A, agreeσ⟩ := (tkJ.coset_iff at E, σ, fieldAdjoin(E, functionImage(τ, T,
          algebraCarrier(E))), σ2 with extension, σA, bF1).forward with σ2In
        obtain ⟨τ2A, agreeτ⟩ := (tkJ.coset_iff at E, τ, F, τ2 with extension, τA, bF).forward
          with τ2In
        have qIn : q ∈ algebraAutomorphisms(E) × algebraAutomorphisms(E)
          rw qEq
          exact product.pair with σ2A, τ2A
        apply functionPreimage.membership.backward
        refine ⟨qIn, ?_⟩
        rw qEq
        have r2 := tkJ.autComposition_apply with σ2A, τ2A
        unfold call2 at r2
        rw r2
        have c2A := tkJ.aut_compose_mem with σ2A, τ2A
        have fσ2 := tkJ.aut_function with σ2A
        have fτ2 := tkJ.aut_function with τ2A
        have inT : compose(σ2, τ2, algebraCarrier(E), algebraCarrier(E), algebraCarrier(E)) ∈
            autCoset(E, compose(σ, τ, algebraCarrier(E), algebraCarrier(E), algebraCarrier(E)),
            fixingSubgroup(E, T))
          apply (tkJ.coset_iff at E, compose(σ, τ, algebraCarrier(E), algebraCarrier(E),
            algebraCarrier(E)), T, compose(σ2, τ2, algebraCarrier(E), algebraCarrier(E),
            algebraCarrier(E)) with extension, στA, TL).backward
          refine ⟨c2A, ?_⟩
          intros t tT
          have tL := TL with t, tT
          have tF := TF with t, tT
          rw [(compose.apply with fτ2, fσ2, tL), (compose.apply with fτ, fσ, tL)]
          rw (agreeτ with t, tF)
          have τtL := FunctionBetween.apply_closed with fτ, tL
          have τt : τ(t) ∈ functionImage(τ, T, algebraCarrier(E))
            apply functionImage.membership.backward
            exact ⟨τtL, t, tT, rfl⟩
          exact agreeσ with τ(t), (inAdj with τ(t), τt)
        rw fixEq at inT
        exact coset with compose(σ2, τ2, algebraCarrier(E), algebraCarrier(E),
          algebraCarrier(E)), inT
  have invCont : Group.inv(galoisGroup(E)) : krullTopology(E) ⇒ krullTopology(E)
    apply Continuous.mk with space, space
    . rw [carrierOf, tkJ.galois_inv]
      exact tkJ.autInverse_function at E
    . rw [carrierOf, opensOf, tkJ.galois_inv]
      intros V hV
      obtain ⟨_, condV⟩ := krullOpens.membership.forward with hV
      have preSub := functionPreimage.subset at autInverse(E), algebraAutomorphisms(E), V
      have pw := (powerset.membership_iff at functionPreimage(autInverse(E),
        algebraAutomorphisms(E), V), algebraAutomorphisms(E)).backward with preSub
      apply krullOpens.membership.backward
      refine ⟨pw, ?_⟩
      intros σ hσ
      obtain ⟨σA, σV⟩ := functionPreimage.membership.forward with hσ
      rw (tkJ.autInverse_apply with σA) at σV
      have σI := tkJ.aut_converse_mem with σA
      have bijσ := tkJ.aut_bijective with σA
      have fσ := tkJ.aut_function with σA
      have fσI := tkJ.aut_function with σI
      obtain ⟨F, Fin, coset⟩ := condV with converse(σ, algebraCarrier(E), algebraCarrier(E)), σV
      obtain ⟨T, TF, TL, finT, intT, fixEq⟩ := tkJ.finite_subfield_generators with extension,
        Fin
      obtain ⟨T2L, finT2, intT2⟩ := imageGen with converse(σ, algebraCarrier(E),
        algebraCarrier(E)), σI, T, TL, finT, intT
      have adj := tkJ.adjoin_finite_subfield with extension, T2L, finT2, intT2
      obtain ⟨F1in, _⟩ := adj
      have iF1 := fieldAdjoin.intermediate with extension, T2L
      have bF1 := tkJ.intermediate_bounded with iF1
      have inAdj := fieldAdjoin.subset_adjoin with extension, T2L
      refine ⟨fieldAdjoin(E, functionImage(converse(σ, algebraCarrier(E), algebraCarrier(E)), T,
        algebraCarrier(E))), F1in, ?_⟩
      intros ρ hρ
      obtain ⟨ρA, agree⟩ := (tkJ.coset_iff at E, σ, fieldAdjoin(E, functionImage(converse(σ,
        algebraCarrier(E), algebraCarrier(E)), T, algebraCarrier(E))), ρ with extension, σA,
        bF1).forward with hρ
      have ρI := tkJ.aut_converse_mem with ρA
      have bijρ := tkJ.aut_bijective with ρA
      apply functionPreimage.membership.backward
      refine ⟨ρA, ?_⟩
      rw (tkJ.autInverse_apply with ρA)
      have inT : converse(ρ, algebraCarrier(E), algebraCarrier(E)) ∈ autCoset(E,
          converse(σ, algebraCarrier(E), algebraCarrier(E)), fixingSubgroup(E, T))
        apply (tkJ.coset_iff at E, converse(σ, algebraCarrier(E), algebraCarrier(E)), T,
          converse(ρ, algebraCarrier(E), algebraCarrier(E)) with extension, σI, TL).backward
        refine ⟨ρI, ?_⟩
        intros t tT
        have tL := TL with t, tT
        have ut := FunctionBetween.apply_closed with fσI, tL
        have uIn : converse(σ, algebraCarrier(E), algebraCarrier(E))(t) ∈ functionImage(
            converse(σ, algebraCarrier(E), algebraCarrier(E)), T, algebraCarrier(E))
          apply functionImage.membership.backward
          exact ⟨ut, t, tT, rfl⟩
        have ρu := agree with converse(σ, algebraCarrier(E), algebraCarrier(E))(t),
          (inAdj with converse(σ, algebraCarrier(E), algebraCarrier(E))(t), uIn)
        rw (Bijective.apply_inverse with bijσ, tL) at ρu
        have back := Bijective.inverse_apply with bijρ, ut
        rw ρu at back
        exact back
      rw fixEq at inT
      exact coset with converse(ρ, algebraCarrier(E), algebraCarrier(E)), inT
  have carrierEq : TopologicalSpace.carrier(krullTopology(E)) = Group.carrier(galoisGroup(E))
    rw [carrierOf, tkJ.galois_carrier]
  unfold TopologicalGroup
  exact ⟨group, space, carrierEq, mulCont, invCont⟩

-- IntermediateField.fixingSubgroup_isOpen: Gal(L/F) is open for F finite.
theorem fixingSubgroup.open (F : Set)
  requires member : F ∈ finiteSubfields(E)
  shows fixingSubgroup(E, F) ∈ krullOpens(E)
proof
  have bounded : fixingSubgroup(E, F) ⊆ algebraAutomorphisms(E)
    intros σ σIn
    obtain ⟨σA, _⟩ := fixingSubgroup.membership.forward with σIn
    exact σA
  have pw := (powerset.membership_iff at fixingSubgroup(E, F),
    algebraAutomorphisms(E)).backward with bounded
  apply krullOpens.membership.backward
  refine ⟨pw, ?_⟩
  intros σ σIn
  refine ⟨F, member, ?_⟩
  intros y yIn
  obtain ⟨τ, τIn, yEq⟩ := autCoset.membership.forward with yIn
  obtain ⟨σA, σFix⟩ := fixingSubgroup.membership.forward with σIn
  obtain ⟨τA, τFix⟩ := fixingSubgroup.membership.forward with τIn
  rw [← yEq, tkJ.galois_mul, (tkJ.autComposition_apply with σA, τA)]
  have mem := tkJ.aut_compose_mem with σA, τA
  obtain ⟨inter, _⟩ := finiteSubfields.membership.forward with member
  have interF := (tkJ.intermediate_member at E, F).forward with inter
  have Fbound := tkJ.intermediate_bounded with interF
  have fσ := tkJ.aut_function with σA
  have fτ := tkJ.aut_function with τA
  apply fixingSubgroup.membership.backward
  refine ⟨mem, ?_⟩
  intros x xF
  have xL := Fbound with x, xF
  rw (compose.apply with fτ, fσ, xL)
  rw (τFix with x, xF)
  exact σFix with x, xF

-- IntermediateField.fixingSubgroup_isClosed: Gal(L/F) is closed for every
-- intermediate field F of an algebraic extension.
theorem fixingSubgroup.closed (F : Set)
  requires algebraic : AlgebraicExtension(E)
  requires intermediate : IntermediateField(E, F)
  shows Closed(krullTopology(E), fixingSubgroup(E, F))
proof
  have carrierOf : TopologicalSpace.carrier(krullTopology(E)) = algebraAutomorphisms(E)
    simp [krullTopology, TopologicalSpace.mk.carrier]
  have opensOf : TopologicalSpace.opens(krullTopology(E)) = krullOpens(E)
    simp [krullTopology, TopologicalSpace.mk.opens]
  have ext2 := extension
  obtain ⟨algebra, baseField, _⟩ := ext2
  have alg2 := algebraic
  obtain ⟨_, algAlg⟩ := alg2
  obtain ⟨_, allAlg⟩ := algAlg
  have Fbound := tkJ.intermediate_bounded with intermediate
  have bounded : fixingSubgroup(E, F) ⊆ algebraAutomorphisms(E)
    intros σ σIn
    obtain ⟨σA, _⟩ := fixingSubgroup.membership.forward with σIn
    exact σA
  have compBound := complement.subset at algebraAutomorphisms(E), fixingSubgroup(E, F)
  have pw := (powerset.membership_iff at complement(algebraAutomorphisms(E),
    fixingSubgroup(E, F)), algebraAutomorphisms(E)).backward with compBound
  unfold Closed
  unfold IsClosed
  rw [carrierOf, opensOf]
  refine ⟨bounded, ?_⟩
  apply krullOpens.membership.backward
  refine ⟨pw, ?_⟩
  intros σ σIn
  obtain ⟨σA, notFix⟩ := (complement.membership at σ, algebraAutomorphisms(E),
    fixingSubgroup(E, F)).forward with σIn
  have moved : ∃ x ∈ F, σ(x) ≠ x
    by_contra none
    apply notFix
    apply fixingSubgroup.membership.backward
    refine ⟨σA, ?_⟩
    intros x xF
    by_contra ne
    exact none with ⟨x, xF, ne⟩
  obtain ⟨x, xF, xMoved⟩ := moved
  have xL := Fbound with x, xF
  have xAlg := allAlg with x, xL
  have xInt := (AlgebraicElement.iff_integral at E, x with algebra, baseField).forward
    with xAlg
  have single : {x} ⊆ algebraCarrier(E)
    intros w wIn
    rw singleton.membership at wIn
    rw wIn
    exact xL
  have inter := fieldAdjoin.intermediate with extension, single
  have fin := fieldAdjoin.simple_finite with extension, xInt
  obtain ⟨finite, _⟩ := fin
  have pwF := (tkJ.intermediate_member at E, fieldAdjoin(E, {x})).backward with inter
  have mem : fieldAdjoin(E, {x}) ∈ finiteSubfields(E)
    apply finiteSubfields.membership.backward
    exact ⟨pwF, finite⟩
  have sx := fieldAdjoin.subset_adjoin with extension, single
  have xx : x ∈ {x} by simp [singleton.membership]
  have xK := sx with x, xx
  refine ⟨fieldAdjoin(E, {x}), mem, ?_⟩
  intros y yIn
  obtain ⟨τ, τIn, yEq⟩ := autCoset.membership.forward with yIn
  obtain ⟨τA, τFix⟩ := fixingSubgroup.membership.forward with τIn
  rw [← yEq, tkJ.galois_mul, (tkJ.autComposition_apply with σA, τA)]
  have compMem := tkJ.aut_compose_mem with σA, τA
  have fσ := tkJ.aut_function with σA
  have fτ := tkJ.aut_function with τA
  apply (complement.membership at compose(σ, τ, algebraCarrier(E), algebraCarrier(E),
    algebraCarrier(E)), algebraAutomorphisms(E), fixingSubgroup(E, F)).backward
  refine ⟨compMem, ?_⟩
  intro inFix
  obtain ⟨_, fixes⟩ := fixingSubgroup.membership.forward with inFix
  have value := fixes with x, xF
  rw (compose.apply with fτ, fσ, xL) at value
  rw (τFix with x, xK) at value
  exact xMoved with value

-- krullTopology_mem_nhds_one_iff: the neighbourhoods of 1 are the sets
-- containing some Gal(L/F) with F finite.
theorem krullTopology.nhds_one_iff (U : Set)
  requires subset : U ⊆ algebraAutomorphisms(E)
  shows U ∈ nhds(krullTopology(E), Group.one(galoisGroup(E))) ↔
    (∃ F ∈ finiteSubfields(E), fixingSubgroup(E, F) ⊆ U)
proof
  have carrierOf : TopologicalSpace.carrier(krullTopology(E)) = algebraAutomorphisms(E)
    simp [krullTopology, TopologicalSpace.mk.carrier]
  have opensOf : TopologicalSpace.opens(krullTopology(E)) = krullOpens(E)
    simp [krullTopology, TopologicalSpace.mk.opens]
  have ext2 := extension
  obtain ⟨algebra, _, _⟩ := ext2
  have idIso := AlgebraIso.identity with algebra
  have idIn := (tkJ.aut_member at E, identity(algebraCarrier(E))).backward with idIso
  constructor
  . intro h
    obtain ⟨_, V, VOpen, oneV, VU⟩ := nhds.membership.forward with h
    rw opensOf at VOpen
    rw tkJ.galois_one at oneV
    obtain ⟨_, cond⟩ := krullOpens.membership.forward with VOpen
    obtain ⟨F, Fin, coset⟩ := cond with identity(algebraCarrier(E)), oneV
    refine ⟨F, Fin, ?_⟩
    intros τ τIn
    obtain ⟨τA, _⟩ := fixingSubgroup.membership.forward with τIn
    have fτ := tkJ.aut_function with τA
    have inCoset : τ ∈ autCoset(E, identity(algebraCarrier(E)), fixingSubgroup(E, F))
      apply autCoset.membership.backward
      refine ⟨τ, τIn, ?_⟩
      rw [tkJ.galois_mul, (tkJ.autComposition_apply with idIn, τA)]
      exact compose.identity_left with fτ
    exact VU with τ, (coset with τ, inCoset)
  . intro h
    obtain ⟨F, Fin, sub⟩ := h
    obtain ⟨inter, _⟩ := finiteSubfields.membership.forward with Fin
    have interF := (tkJ.intermediate_member at E, F).forward with inter
    have Fbound := tkJ.intermediate_bounded with interF
    have open := fixingSubgroup.open with extension, Fin
    have pwU : U ∈ 𝒫(TopologicalSpace.carrier(krullTopology(E)))
      rw carrierOf
      exact (powerset.membership_iff at U, algebraAutomorphisms(E)).backward with subset
    have oneIn : Group.one(galoisGroup(E)) ∈ fixingSubgroup(E, F)
      rw tkJ.galois_one
      apply fixingSubgroup.membership.backward
      refine ⟨idIn, ?_⟩
      intros x xF
      exact identity.apply with (Fbound with x, xF)
    have openK : fixingSubgroup(E, F) ∈ TopologicalSpace.opens(krullTopology(E))
      rw opensOf
      exact open
    apply nhds.membership.backward
    exact ⟨pwU, fixingSubgroup(E, F), openK, oneIn, sub⟩

-- The stabilizer of a point is open (isOpen of the stabilizer, from
-- IntermediateField.adjoin.finiteDimensional): σ ↦ σ(x) is locally
-- constant on Gal(L/K) for x algebraic.
theorem krullTopology.stabilizer_open (x : Set)
  requires integral : IntegralElement(E, x)
  shows fixingSubgroup(E, {x}) ∈ krullOpens(E)
proof
  have int2 := integral
  obtain ⟨_, xL, _⟩ := int2
  have single : {x} ⊆ algebraCarrier(E)
    intros w wIn
    rw singleton.membership at wIn
    rw wIn
    exact xL
  have same := fixingSubgroup.adjoin with extension, single
  have inter := fieldAdjoin.intermediate with extension, single
  have fin := fieldAdjoin.simple_finite with extension, integral
  obtain ⟨finite, _⟩ := fin
  have pw := (tkJ.intermediate_member at E, fieldAdjoin(E, {x})).backward with inter
  have mem : fieldAdjoin(E, {x}) ∈ finiteSubfields(E)
    apply finiteSubfields.membership.backward
    exact ⟨pw, finite⟩
  rw ← same
  exact fixingSubgroup.open with extension, mem

-- krullTopology_t2, krullTopology_totallyDisconnected, and compactness
-- for integral extensions: Gal(L/K) is profinite.
theorem krullTopology.profinite
  requires algebraic : AlgebraicExtension(E)
  shows ProfiniteGroup(galoisGroup(E), krullTopology(E))
proof
  sorry

-- For a finite extension the Krull topology is discrete
-- (krullTopology discrete for FiniteDimensional K L).
theorem krullTopology.discrete_of_finite
  requires finite : FiniteExtension(E)
  shows DiscreteTopology(krullTopology(E))
proof
  have carrierOf : TopologicalSpace.carrier(krullTopology(E)) = algebraAutomorphisms(E)
    simp [krullTopology, TopologicalSpace.mk.carrier]
  have opensOf : TopologicalSpace.opens(krullTopology(E)) = krullOpens(E)
    simp [krullTopology, TopologicalSpace.mk.opens]
  have tg := krullTopology.topological_group with extension
  obtain ⟨space, _⟩ := tg
  have top := IntermediateField.top with extension
  have topMem := (tkJ.intermediate_member at E, algebraCarrier(E)).backward with top
  have subTop := tkJ.sub_top with extension
  have finTop : algebraCarrier(E) ∈ finiteSubfields(E)
    apply finiteSubfields.membership.backward
    rw subTop
    exact ⟨topMem, finite⟩
  unfold DiscreteTopology
  refine ⟨space, ?_⟩
  rw [opensOf, carrierOf]
  apply Subset.antisymmetric
  . intros U UIn
    obtain ⟨pw, _⟩ := krullOpens.membership.forward with UIn
    exact pw
  . intros U UIn
    apply krullOpens.membership.backward
    refine ⟨UIn, ?_⟩
    have UA := (powerset.membership_iff at U, algebraAutomorphisms(E)).forward with UIn
    intros σ σU
    refine ⟨algebraCarrier(E), finTop, ?_⟩
    intros y yIn
    obtain ⟨τ, τIn, yEq⟩ := autCoset.membership.forward with yIn
    obtain ⟨τA, τFix⟩ := fixingSubgroup.membership.forward with τIn
    have σA := UA with σ, σU
    have ext2 := extension
    obtain ⟨algebra, _, _⟩ := ext2
    have idIso := AlgebraIso.identity with algebra
    have idIn := (tkJ.aut_member at E, identity(algebraCarrier(E))).backward with idIso
    have τId : τ = identity(algebraCarrier(E))
      apply galoisGroup.ext with extension, τA, idIn
      intros x xL
      rw (identity.apply with xL)
      exact τFix with x, xL
    rw [← yEq, τId, tkJ.galois_mul, (tkJ.autComposition_apply with σA, idIn)]
    have fσ := tkJ.aut_function with σA
    rw (compose.identity_right with fσ)
    exact σU

-- Section: The infinite Galois correspondence
-- InfiniteGalois.fixedField_fixingSubgroup: F = L^{Gal(L/F)}.
theorem InfiniteGalois.fixedField_fixingSubgroup (F : Set)
  requires galois : GaloisExtension(E)
  requires intermediate : IntermediateField(E, F)
  shows fixedField(E, fixingSubgroup(E, F)) = F
proof
  sorry

-- InfiniteGalois.fixingSubgroup_fixedField: H = Gal(L/L^H) for H closed.
theorem InfiniteGalois.fixingSubgroup_fixedField (H : Set)
  requires galois : GaloisExtension(E)
  requires subgroup : ClosedSubgroup(H, galoisGroup(E), krullTopology(E))
  shows fixingSubgroup(E, fixedField(E, H)) = H
proof
  sorry

-- InfiniteGalois.isOpen_iff_finite: a closed subgroup is open iff its
-- fixed field is finite over K.
theorem InfiniteGalois.open_iff_finite (H : Set)
  requires galois : GaloisExtension(E)
  requires subgroup : ClosedSubgroup(H, galoisGroup(E), krullTopology(E))
  shows H ∈ krullOpens(E) ↔ FiniteExtension(subextension(E, fixedField(E, H)))
proof
  sorry

-- InfiniteGalois.normal_iff_isGalois: Gal(L/F) is normal iff F/K is
-- Galois.
theorem InfiniteGalois.normal_iff_galois (F : Set)
  requires galois : GaloisExtension(E)
  requires intermediate : IntermediateField(E, F)
  shows NormalSubgroup(fixingSubgroup(E, F), galoisGroup(E)) ↔
    GaloisExtension(subextension(E, F))
proof
  have galois2 := galois
  obtain ⟨_, normalE⟩ := galois2
  have ne2 := normalE
  obtain ⟨algebraic, _⟩ := ne2
  have bounded := tkJ.intermediate_bounded with intermediate
  constructor
  . intro normalSub
    have group := galoisGroup.group with extension
    have fixedEq := InfiniteGalois.fixedField_fixingSubgroup with extension, galois,
      intermediate
    have stable : ∀ σ ∈ algebraAutomorphisms(E), autImage(E, σ, F) ⊆ F
      intros σ σA
      intros y yIn
      unfold autImage at yIn
      obtain ⟨_, x, xF, yEq⟩ := functionImage.membership.forward with yIn
      rw yEq
      have xL := bounded with x, xF
      have fσ := tkJ.aut_function with σA
      have σxL := FunctionBetween.apply_closed with fσ, xL
      have bij := tkJ.aut_bijective with σA
      have σInv := tkJ.aut_converse_mem with σA
      have σG : σ ∈ Group.carrier(galoisGroup(E))
        rw tkJ.galois_carrier
        exact σA
      rw ← fixedEq
      apply fixedField.membership.backward
      refine ⟨σxL, ?_⟩
      intros τ τIn
      obtain ⟨τA, _⟩ := fixingSubgroup.membership.forward with τIn
      have nn := normalSub
      obtain ⟨_, conj⟩ := nn
      have invG : Group.inv(galoisGroup(E))(σ) ∈ Group.carrier(galoisGroup(E)) by typecheck
      have c := conj with Group.inv(galoisGroup(E))(σ), invG, τ, τIn
      unfold conjugate at c
      rw (Group.inv_involutive at galoisGroup(E), σ with group, σG) at c
      rw [tkJ.galois_inv, (tkJ.autInverse_apply with σA), tkJ.galois_mul,
        (tkJ.autComposition_apply with σInv, τA)] at c
      have στ := tkJ.aut_compose_mem with σInv, τA
      rw (tkJ.autComposition_apply with στ, σA) at c
      obtain ⟨_, cFix⟩ := fixingSubgroup.membership.forward with c
      have value := cFix with x, xF
      have fInv := tkJ.aut_function with σInv
      have fτ := tkJ.aut_function with τA
      have fστ := tkJ.aut_function with στ
      rw [(compose.apply with fσ, fστ, xL), (compose.apply with fτ, fInv, σxL)] at value
      have τσxL := FunctionBetween.apply_closed with fτ, σxL
      have back := Bijective.apply_inverse with bij, τσxL
      rw value at back
      symm
      exact back
    have normal := (GaloisExtension.normal_iff_stable with extension, galois,
      intermediate).backward with stable
    exact GaloisExtension.of_normal_sub with extension, galois, intermediate, normal
  . intro galoisSub
    obtain ⟨_, normal⟩ := galoisSub
    have hom := galoisRestrict.hom with extension, algebraic, intermediate, normal
    have kernelEq := galoisRestrict.kernel with extension, algebraic, intermediate, normal
    have kn := GroupHom.kernel_normal with hom
    rw kernelEq at kn
    exact kn

-- The index of an open fixing subgroup is the degree
-- (IntermediateField.finrank_eq_fixingSubgroup_index, infinite case).
theorem InfiniteGalois.degree_eq_index (F : Set)
  requires galois : GaloisExtension(E)
  requires member : F ∈ finiteSubfields(E)
  shows extensionDegree(subextension(E, F)) = index(galoisGroup(E), fixingSubgroup(E, F))
proof
  sorry

-- Section: Finite Galois intermediate fields
-- Every element lies in a finite Galois intermediate field
-- (FiniteGaloisIntermediateField.adjoin, IntermediateField.le_normalClosure),
-- and the join of two is one (FiniteGaloisIntermediateField sup).
theorem FiniteGaloisIntermediateField.exists_containing (S : Set)
  requires galois : GaloisExtension(E)
  requires subset : S ⊆ algebraCarrier(E)
  requires finite : Finite(S)
  shows ∃ F, FiniteGaloisIntermediateField(E, F) ∧ S ⊆ F
proof
  sorry

theorem FiniteGaloisIntermediateField.join (F G : Set)
  requires galois : GaloisExtension(E)
  requires first : FiniteGaloisIntermediateField(E, F)
  requires second : FiniteGaloisIntermediateField(E, G)
  shows FiniteGaloisIntermediateField(E, fieldAdjoin(E, F ∪ G))
proof
  sorry

-- Restriction Gal(L/K) → Gal(F/K) to a finite Galois F is continuous
-- into the discrete group and surjective (InfiniteGalois.proj,
-- AlgEquiv.restrictNormalHom_continuous).
theorem galoisRestrict.continuous (F : Set)
  requires galois : GaloisExtension(E)
  requires finite : FiniteGaloisIntermediateField(E, F)
  shows galoisRestrict(E, F) : krullTopology(E) ⇒
    discreteSpace(algebraAutomorphisms(subextension(E, F)))
proof
  have carrierOf : TopologicalSpace.carrier(krullTopology(E)) = algebraAutomorphisms(E)
    simp [krullTopology, TopologicalSpace.mk.carrier]
  have opensOf : TopologicalSpace.opens(krullTopology(E)) = krullOpens(E)
    simp [krullTopology, TopologicalSpace.mk.opens]
  have discOpens : TopologicalSpace.opens(discreteSpace(algebraAutomorphisms(
      subextension(E, F)))) = 𝒫(algebraAutomorphisms(subextension(E, F)))
    simp [discreteSpace, TopologicalSpace.mk.opens]
  have tg := krullTopology.topological_group with extension
  obtain ⟨space, _⟩ := tg
  have discSpace := discreteSpace.space at algebraAutomorphisms(subextension(E, F)),
    discreteSpace(algebraAutomorphisms(subextension(E, F))) with rfl
  have fg2 := finite
  obtain ⟨inter, finF, galF⟩ := fg2
  obtain ⟨_, normal⟩ := galF
  have function := tkJ.gal_restrict_function with extension, inter, normal
  have Fbound := tkJ.intermediate_bounded with inter
  have pwF := (tkJ.intermediate_member at E, F).backward with inter
  have Fmem : F ∈ finiteSubfields(E)
    apply finiteSubfields.membership.backward
    exact ⟨pwF, finF⟩
  unfold Continuous
  refine ⟨space, discSpace, ?_⟩
  unfold ContinuousMap
  rw [carrierOf, opensOf, discreteSpace.carrier, discOpens]
  refine ⟨function, ?_⟩
  intros V VIn
  rw carrierOf
  have preBound := functionPreimage.subset at galoisRestrict(E, F),
    algebraAutomorphisms(E), V
  have pw := (powerset.membership_iff at functionPreimage(galoisRestrict(E, F),
    algebraAutomorphisms(E), V), algebraAutomorphisms(E)).backward with preBound
  apply krullOpens.membership.backward
  refine ⟨pw, ?_⟩
  intros σ σIn
  obtain ⟨σA, σV⟩ := functionPreimage.membership.forward with σIn
  refine ⟨F, Fmem, ?_⟩
  intros y yIn
  obtain ⟨τ, τIn, yEq⟩ := autCoset.membership.forward with yIn
  obtain ⟨τA, τFix⟩ := fixingSubgroup.membership.forward with τIn
  rw [← yEq, tkJ.galois_mul, (tkJ.autComposition_apply with σA, τA)]
  have compMem := tkJ.aut_compose_mem with σA, τA
  have fσ := tkJ.aut_function with σA
  have fτ := tkJ.aut_function with τA
  have fστ := tkJ.aut_function with compMem
  have stableσ : ∀ z ∈ F, σ(z) ∈ F
    intros z zF
    exact tkJ.gal_normal_stable with extension, inter, normal, σA, zF
  have stableστ : ∀ z ∈ F, compose(σ, τ, algebraCarrier(E), algebraCarrier(E),
      algebraCarrier(E))(z) ∈ F
    intros z zF
    exact tkJ.gal_normal_stable with extension, inter, normal, compMem, zF
  have rσ := restrict.function with fσ, Fbound, stableσ
  have rστ := restrict.function with fστ, Fbound, stableστ
  have same : restrict(compose(σ, τ, algebraCarrier(E), algebraCarrier(E),
      algebraCarrier(E)), F) = restrict(σ, F)
    apply FunctionBetween.ext with rστ, rσ
    intros z zF
    have zL := Fbound with z, zF
    rw [(restrict.apply with fστ, Fbound, stableστ, zF),
      (restrict.apply with fσ, Fbound, stableσ, zF), (compose.apply with fτ, fσ, zL),
      (τFix with z, zF)]
  apply functionPreimage.membership.backward
  refine ⟨compMem, ?_⟩
  rw [(tkJ.gal_restrict_value with extension, inter, normal, compMem), same,
    ← (tkJ.gal_restrict_value with extension, inter, normal, σA)]
  exact σV

-- An automorphism is determined by its restrictions to the finite Galois
-- intermediate fields (the injectivity of InfiniteGalois.algEquivToLimit).
theorem galoisGroup.ext_of_finite_galois (σ τ : Set)
  requires galois : GaloisExtension(E)
  requires first : σ ∈ algebraAutomorphisms(E)
  requires second : τ ∈ algebraAutomorphisms(E)
  requires agree : ∀ F, FiniteGaloisIntermediateField(E, F) →
    galoisRestrict(E, F)(σ) = galoisRestrict(E, F)(τ)
  shows σ = τ
proof
  apply galoisGroup.ext with extension, first, second
  intros x xL
  have single : {x} ⊆ algebraCarrier(E)
    intros w wIn
    rw singleton.membership at wIn
    rw wIn
    exact xL
  have fin := Finite.singleton at x
  obtain ⟨F, fg, sub⟩ := FiniteGaloisIntermediateField.exists_containing with extension,
    galois, single, fin
  have fg2 := fg
  obtain ⟨inter, _, galF⟩ := fg2
  obtain ⟨_, normal⟩ := galF
  have eq := agree with F, fg
  rw [(tkJ.gal_restrict_value with extension, inter, normal, first),
    (tkJ.gal_restrict_value with extension, inter, normal, second)] at eq
  have xx : x ∈ {x} by simp [singleton.membership]
  have xF := sub with x, xx
  have bounded := tkJ.intermediate_bounded with inter
  have fσ := tkJ.aut_function with first
  have fτ := tkJ.aut_function with second
  have stableσ : ∀ y ∈ F, σ(y) ∈ F
    intros y yF
    exact tkJ.gal_normal_stable with extension, inter, normal, first, yF
  have stableτ : ∀ y ∈ F, τ(y) ∈ F
    intros y yF
    exact tkJ.gal_normal_stable with extension, inter, normal, second, yF
  have vσ := restrict.apply with fσ, bounded, stableσ, xF
  have vτ := restrict.apply with fτ, bounded, stableτ, xF
  rw eq at vσ
  rw vσ at vτ
  exact vτ

-- A compatible family of automorphisms of the finite Galois intermediate
-- fields comes from one automorphism of L (the surjectivity of
-- InfiniteGalois.algEquivToLimit).
theorem galoisGroup.of_compatible (c : Set)
  requires galois : GaloisExtension(E)
  requires family : ∀ F, FiniteGaloisIntermediateField(E, F) →
    c(F) ∈ algebraAutomorphisms(subextension(E, F))
  requires compatible : ∀ F, ∀ G, FiniteGaloisIntermediateField(E, F) →
    FiniteGaloisIntermediateField(E, G) → F ⊆ G →
    (∀ x ∈ F, c(G)(x) = c(F)(x))
  shows ∃ σ ∈ algebraAutomorphisms(E), ∀ F, FiniteGaloisIntermediateField(E, F) →
    galoisRestrict(E, F)(σ) = c(F)
proof
  sorry

-- Gal(L/K) of a Galois extension, acting on L, is a Galois group of L/K
-- (IsGaloisGroup for L ≃ₐ[K] L, from IsGalois).
theorem IsGaloisGroup.of_galois
  requires galois : GaloisExtension(E)
  shows IsGaloisGroup(galoisGroup(E), identity(algebraAutomorphisms(E)), E)
proof
  have ext2 := extension
  obtain ⟨algebra, _, _⟩ := ext2
  have group := galoisGroup.group with extension
  have idHom := GroupHom.id with group
  rw tkJ.galois_carrier at idHom
  have inj := identity.injective at algebraAutomorphisms(E)
  have refl := Subset.reflexive at algebraAutomorphisms(E)
  have img := functionImage.identity with refl
  have fixedEq : fixedField(E, algebraAutomorphisms(E)) = bottomField(E)
    ext y
    constructor
    . intro hy
      obtain ⟨yL, all⟩ := fixedField.membership.forward with hy
      exact (GaloisExtension.fixed_iff_bottom with extension, galois, yL).backward with all
    . intro hy
      have bound := functionImage.subset at Algebra.map(E), Ring.carrier(Algebra.base(E)),
        algebraCarrier(E)
      have hy2 := hy
      unfold bottomField at hy2
      have yL := bound with y, hy2
      have all := (GaloisExtension.fixed_iff_bottom with extension, galois, yL).forward
        with hy
      apply fixedField.membership.backward
      exact ⟨yL, all⟩
  unfold IsGaloisGroup
  rw [tkJ.galois_carrier, img, fixedEq]
  exact ⟨algebra, idHom, inj, rfl⟩

-- For fields, a finite Galois group of L/K has order [L : K] and makes
-- L/K Galois (IsGaloisGroup.card_eq_finrank, IsGaloisGroup.isGalois).
theorem IsGaloisGroup.card_eq_degree (G ρ : Set)
  requires galoisGroupOf : IsGaloisGroup(G, ρ, E)
  requires finite : Finite(Group.carrier(G))
  shows FiniteExtension(E) ∧ GaloisExtension(E) ∧
    order(G) = extensionDegree(E)
proof
  sorry

end Krull

-- Section: Galois groups given by actions
section Actions
variable (E : Set)
hypothesis algebra : Algebra(E)

-- IsGaloisGroup.of_mulEquiv: transport along an isomorphism of groups
-- that respects the actions.
theorem IsGaloisGroup.of_iso (G ρ H e : Set)
  requires galoisGroupOf : IsGaloisGroup(G, ρ, E)
  requires iso : GroupIso(e, H, G)
  shows IsGaloisGroup(H, compose(ρ, e, Group.carrier(H), Group.carrier(G),
    algebraAutomorphisms(E)), E)
proof
  have g2 := galoisGroupOf
  obtain ⟨_, ρHom, ρInj, fixedEq⟩ := g2
  have eHom := GroupIso.hom with iso
  have eBij := GroupIso.bijective with iso
  have eInj := Bijective.injective with eBij
  have eSurj := Bijective.surjective with eBij
  have eF := GroupIso.function with iso
  have ρF := GroupHom.function with ρHom
  rw tkJ.galois_carrier at ρF
  have hom := GroupHom.comp with eHom, ρHom
  rw tkJ.galois_carrier at hom
  have injective := compose.injective with eInj, ρInj
  have sameImage : functionImage(compose(ρ, e, Group.carrier(H), Group.carrier(G),
      algebraAutomorphisms(E)), Group.carrier(H), algebraAutomorphisms(E)) =
      functionImage(ρ, Group.carrier(G), algebraAutomorphisms(E))
    ext y
    constructor
    . intro hy
      obtain ⟨yA, h, hH, yEq⟩ := functionImage.membership.forward with hy
      rw (compose.apply with eF, ρF, hH) at yEq
      have ehG := FunctionBetween.apply_closed with eF, hH
      apply functionImage.membership.backward
      exact ⟨yA, e(h), ehG, yEq⟩
    . intro hy
      obtain ⟨yA, g, gG, yEq⟩ := functionImage.membership.forward with hy
      obtain ⟨_, onto⟩ := eSurj
      obtain ⟨h, hH, rel⟩ := onto with g, gG
      have eh := FunctionBetween.apply_value with eF, hH, rel
      apply functionImage.membership.backward
      refine ⟨yA, h, hH, ?_⟩
      rw (compose.apply with eF, ρF, hH)
      rw eh
      exact yEq
  unfold IsGaloisGroup
  rw sameImage
  exact ⟨algebra, hom, injective, fixedEq⟩

-- IsGaloisGroup.faithful: elements acting alike are equal.
theorem IsGaloisGroup.faithful (G ρ g h : Set)
  requires galoisGroupOf : IsGaloisGroup(G, ρ, E)
  requires first : g ∈ Group.carrier(G)
  requires second : h ∈ Group.carrier(G)
  requires agree : ∀ x ∈ algebraCarrier(E), ρ(g)(x) = ρ(h)(x)
  shows g = h
proof
  obtain ⟨_, ρHom, ρInj, _⟩ := galoisGroupOf
  have ρF := GroupHom.function with ρHom
  rw tkJ.galois_carrier at ρF
  have ρg := FunctionBetween.apply_closed with ρF, first
  have ρh := FunctionBetween.apply_closed with ρF, second
  have fg := tkJ.aut_function with ρg
  have fh := tkJ.aut_function with ρh
  have same := FunctionBetween.ext with fg, fh, agree
  have relG := FunctionBetween.relates_apply with ρF, first
  have relH := FunctionBetween.relates_apply with ρF, second
  rw ← same at relH
  exact Injective.cancel with ρInj, first, second, ρg, relG, relH

-- IsGaloisGroup.isInvariant: an element fixed by G comes from A.
theorem IsGaloisGroup.invariant (G ρ x : Set)
  requires galoisGroupOf : IsGaloisGroup(G, ρ, E)
  requires point : x ∈ algebraCarrier(E)
  requires fixed : ∀ g ∈ Group.carrier(G), ρ(g)(x) = x
  shows ∃ a ∈ Ring.carrier(Algebra.base(E)), Algebra.map(E)(a) = x
proof
  obtain ⟨_, _, _, fixedEq⟩ := galoisGroupOf
  have mem : x ∈ fixedField(E, functionImage(ρ, Group.carrier(G),
      algebraAutomorphisms(E)))
    apply fixedField.membership.backward
    refine ⟨point, ?_⟩
    intros σ σIn
    obtain ⟨_, g, gG, σEq⟩ := functionImage.membership.forward with σIn
    rw σEq
    exact fixed with g, gG
  rw fixedEq at mem
  unfold bottomField at mem
  obtain ⟨_, a, aK, xEq⟩ := functionImage.membership.forward with mem
  refine ⟨a, aK, ?_⟩
  symm
  exact xEq

end Actions
