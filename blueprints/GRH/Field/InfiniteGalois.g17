-- Infinite Galois theory: the Krull topology on Gal(L/K), with the
-- fixing subgroups of finite intermediate fields and their cosets as a
-- basis; Gal(L/K) as a profinite group for algebraic L/K; open and closed
-- fixing subgroups; the Galois correspondence between intermediate fields
-- and closed subgroups, finite ones and open subgroups, Galois ones and
-- closed normal subgroups; finite Galois intermediate fields and
-- restriction to them; and Galois groups of a ring extension given by a
-- faithful action with the right invariants (IsGaloisGroup).
-- Part of the GRH blueprint.
-- Planned home: Algebra/Field/InfiniteGalois.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Field.InfiniteGalois
import GRH.Field.Galois
import GRH.Topology.Groups
import Grace.Cumulus.Algebra.Group.Isomorphism

-- Section: The Krull topology
-- The finite intermediate fields, and the finite Galois ones
-- (FiniteGaloisIntermediateField K L).
def finiteSubfields (E : Set) : Set :=
  { F ∈ intermediateFields(E) | FiniteExtension(subextension(E, F)) }

predicate FiniteGaloisIntermediateField (E F : Set) :=
  IntermediateField(E, F) ∧ FiniteExtension(subextension(E, F)) ∧
  GaloisExtension(subextension(E, F))

-- The left coset σ H in Gal(L/K).
def autCoset (E σ H : Set) : Set := { Group.mul(galoisGroup(E))(σ, τ) | τ ∈ H }

-- The Krull topology (krullTopology K L): U is open when each σ ∈ U has a
-- neighbourhood σ Gal(L/F) ⊆ U for a finite intermediate field F. This is
-- the topology Mathlib generates from the group filter basis of the
-- subgroups Gal(L/F), F finite (galGroupBasis).
def krullOpens (E : Set) : Set :=
  { U ∈ 𝒫(algebraAutomorphisms(E)) | ∀ σ ∈ U, ∃ F ∈ finiteSubfields(E),
    autCoset(E, σ, fixingSubgroup(E, F)) ⊆ U }

def krullTopology (E : Set) : Set :=
  TopologicalSpace.mk(algebraAutomorphisms(E), krullOpens(E))

-- Section: Galois groups of ring extensions
-- G with ρ : G → Aut_A(B) is a Galois group of B/A (IsGaloisGroup G A B):
-- the action is faithful (ρ injective), A-linear (ρ lands in the
-- A-algebra automorphisms), and the invariants of B are the image of A
-- (Algebra.IsInvariant). Here E is any Cumulus algebra B over A, and
-- galoisGroup(E) is the group of its algebra automorphisms.
predicate IsGaloisGroup (G ρ E : Set) :=
  Algebra(E) ∧ GroupHom(ρ, G, galoisGroup(E)) ∧
  InjectiveBetween(ρ, Group.carrier(G), algebraAutomorphisms(E)) ∧
  fixedField(E, functionImage(ρ, Group.carrier(G), algebraAutomorphisms(E))) =
    bottomField(E)

section Krull
variable (E : Set)
hypothesis extension : FieldExtension(E)

-- krullTopology is a topology making Gal(L/K) a topological group
-- (krullTopology, IsTopologicalGroup (L ≃ₐ[K] L)).
theorem krullTopology.topological_group
  shows TopologicalSpace(krullTopology(E)) ∧
    TopologicalGroup(galoisGroup(E), krullTopology(E))
proof
  sorry

-- IntermediateField.fixingSubgroup_isOpen: Gal(L/F) is open for F finite.
theorem fixingSubgroup.open (F : Set)
  requires member : F ∈ finiteSubfields(E)
  shows fixingSubgroup(E, F) ∈ krullOpens(E)
proof
  sorry

-- IntermediateField.fixingSubgroup_isClosed: Gal(L/F) is closed for every
-- intermediate field F of an algebraic extension.
theorem fixingSubgroup.closed (F : Set)
  requires algebraic : AlgebraicExtension(E)
  requires intermediate : IntermediateField(E, F)
  shows Closed(krullTopology(E), fixingSubgroup(E, F))
proof
  sorry

-- krullTopology_mem_nhds_one_iff: the neighbourhoods of 1 are the sets
-- containing some Gal(L/F) with F finite.
theorem krullTopology.nhds_one_iff (U : Set)
  requires subset : U ⊆ algebraAutomorphisms(E)
  shows U ∈ nhds(krullTopology(E), Group.one(galoisGroup(E))) ↔
    (∃ F ∈ finiteSubfields(E), fixingSubgroup(E, F) ⊆ U)
proof
  sorry

-- The stabilizer of a point is open (isOpen of the stabilizer, from
-- IntermediateField.adjoin.finiteDimensional): σ ↦ σ(x) is locally
-- constant on Gal(L/K) for x algebraic.
theorem krullTopology.stabilizer_open (x : Set)
  requires integral : IntegralElement(E, x)
  shows fixingSubgroup(E, {x}) ∈ krullOpens(E)
proof
  sorry

-- krullTopology_t2, krullTopology_totallyDisconnected, and compactness
-- for integral extensions: Gal(L/K) is profinite.
theorem krullTopology.profinite
  requires algebraic : AlgebraicExtension(E)
  shows ProfiniteGroup(galoisGroup(E), krullTopology(E))
proof
  sorry

-- For a finite extension the Krull topology is discrete
-- (krullTopology discrete for FiniteDimensional K L).
theorem krullTopology.discrete_of_finite
  requires finite : FiniteExtension(E)
  shows DiscreteTopology(krullTopology(E))
proof
  sorry

-- Section: The infinite Galois correspondence
-- InfiniteGalois.fixedField_fixingSubgroup: F = L^{Gal(L/F)}.
theorem InfiniteGalois.fixedField_fixingSubgroup (F : Set)
  requires galois : GaloisExtension(E)
  requires intermediate : IntermediateField(E, F)
  shows fixedField(E, fixingSubgroup(E, F)) = F
proof
  sorry

-- InfiniteGalois.fixingSubgroup_fixedField: H = Gal(L/L^H) for H closed.
theorem InfiniteGalois.fixingSubgroup_fixedField (H : Set)
  requires galois : GaloisExtension(E)
  requires subgroup : ClosedSubgroup(H, galoisGroup(E), krullTopology(E))
  shows fixingSubgroup(E, fixedField(E, H)) = H
proof
  sorry

-- InfiniteGalois.isOpen_iff_finite: a closed subgroup is open iff its
-- fixed field is finite over K.
theorem InfiniteGalois.open_iff_finite (H : Set)
  requires galois : GaloisExtension(E)
  requires subgroup : ClosedSubgroup(H, galoisGroup(E), krullTopology(E))
  shows H ∈ krullOpens(E) ↔ FiniteExtension(subextension(E, fixedField(E, H)))
proof
  sorry

-- InfiniteGalois.normal_iff_isGalois: Gal(L/F) is normal iff F/K is
-- Galois.
theorem InfiniteGalois.normal_iff_galois (F : Set)
  requires galois : GaloisExtension(E)
  requires intermediate : IntermediateField(E, F)
  shows NormalSubgroup(fixingSubgroup(E, F), galoisGroup(E)) ↔
    GaloisExtension(subextension(E, F))
proof
  sorry

-- The index of an open fixing subgroup is the degree
-- (IntermediateField.finrank_eq_fixingSubgroup_index, infinite case).
theorem InfiniteGalois.degree_eq_index (F : Set)
  requires galois : GaloisExtension(E)
  requires member : F ∈ finiteSubfields(E)
  shows extensionDegree(subextension(E, F)) = index(galoisGroup(E), fixingSubgroup(E, F))
proof
  sorry

-- Section: Finite Galois intermediate fields
-- Every element lies in a finite Galois intermediate field
-- (FiniteGaloisIntermediateField.adjoin, IntermediateField.le_normalClosure),
-- and the join of two is one (FiniteGaloisIntermediateField sup).
theorem FiniteGaloisIntermediateField.exists_containing (S : Set)
  requires galois : GaloisExtension(E)
  requires subset : S ⊆ algebraCarrier(E)
  requires finite : Finite(S)
  shows ∃ F, FiniteGaloisIntermediateField(E, F) ∧ S ⊆ F
proof
  sorry

theorem FiniteGaloisIntermediateField.join (F G : Set)
  requires galois : GaloisExtension(E)
  requires first : FiniteGaloisIntermediateField(E, F)
  requires second : FiniteGaloisIntermediateField(E, G)
  shows FiniteGaloisIntermediateField(E, fieldAdjoin(E, F ∪ G))
proof
  sorry

-- Restriction Gal(L/K) → Gal(F/K) to a finite Galois F is continuous
-- into the discrete group and surjective (InfiniteGalois.proj,
-- AlgEquiv.restrictNormalHom_continuous).
theorem galoisRestrict.continuous (F : Set)
  requires galois : GaloisExtension(E)
  requires finite : FiniteGaloisIntermediateField(E, F)
  shows galoisRestrict(E, F) : krullTopology(E) ⇒
    discreteSpace(algebraAutomorphisms(subextension(E, F)))
proof
  sorry

-- An automorphism is determined by its restrictions to the finite Galois
-- intermediate fields (the injectivity of InfiniteGalois.algEquivToLimit).
theorem galoisGroup.ext_of_finite_galois (σ τ : Set)
  requires galois : GaloisExtension(E)
  requires first : σ ∈ algebraAutomorphisms(E)
  requires second : τ ∈ algebraAutomorphisms(E)
  requires agree : ∀ F, FiniteGaloisIntermediateField(E, F) →
    galoisRestrict(E, F)(σ) = galoisRestrict(E, F)(τ)
  shows σ = τ
proof
  sorry

-- A compatible family of automorphisms of the finite Galois intermediate
-- fields comes from one automorphism of L (the surjectivity of
-- InfiniteGalois.algEquivToLimit).
theorem galoisGroup.of_compatible (c : Set)
  requires galois : GaloisExtension(E)
  requires family : ∀ F, FiniteGaloisIntermediateField(E, F) →
    c(F) ∈ algebraAutomorphisms(subextension(E, F))
  requires compatible : ∀ F, ∀ G, FiniteGaloisIntermediateField(E, F) →
    FiniteGaloisIntermediateField(E, G) → F ⊆ G →
    (∀ x ∈ F, c(G)(x) = c(F)(x))
  shows ∃ σ ∈ algebraAutomorphisms(E), ∀ F, FiniteGaloisIntermediateField(E, F) →
    galoisRestrict(E, F)(σ) = c(F)
proof
  sorry

-- Gal(L/K) of a Galois extension, acting on L, is a Galois group of L/K
-- (IsGaloisGroup for L ≃ₐ[K] L, from IsGalois).
theorem IsGaloisGroup.of_galois
  requires galois : GaloisExtension(E)
  shows IsGaloisGroup(galoisGroup(E), identity(algebraAutomorphisms(E)), E)
proof
  sorry

-- For fields, a finite Galois group of L/K has order [L : K] and makes
-- L/K Galois (IsGaloisGroup.card_eq_finrank, IsGaloisGroup.isGalois).
theorem IsGaloisGroup.card_eq_degree (G ρ : Set)
  requires galoisGroupOf : IsGaloisGroup(G, ρ, E)
  requires finite : Finite(Group.carrier(G))
  shows FiniteExtension(E) ∧ GaloisExtension(E) ∧
    order(G) = extensionDegree(E)
proof
  sorry

end Krull

-- Section: Galois groups given by actions
section Actions
variable (E : Set)
hypothesis algebra : Algebra(E)

-- IsGaloisGroup.of_mulEquiv: transport along an isomorphism of groups
-- that respects the actions.
theorem IsGaloisGroup.of_iso (G ρ H e : Set)
  requires galoisGroupOf : IsGaloisGroup(G, ρ, E)
  requires iso : GroupIso(e, H, G)
  shows IsGaloisGroup(H, compose(ρ, e, Group.carrier(H), Group.carrier(G),
    algebraAutomorphisms(E)), E)
proof
  sorry

-- IsGaloisGroup.faithful: elements acting alike are equal.
theorem IsGaloisGroup.faithful (G ρ g h : Set)
  requires galoisGroupOf : IsGaloisGroup(G, ρ, E)
  requires first : g ∈ Group.carrier(G)
  requires second : h ∈ Group.carrier(G)
  requires agree : ∀ x ∈ algebraCarrier(E), ρ(g)(x) = ρ(h)(x)
  shows g = h
proof
  sorry

-- IsGaloisGroup.isInvariant: an element fixed by G comes from A.
theorem IsGaloisGroup.invariant (G ρ x : Set)
  requires galoisGroupOf : IsGaloisGroup(G, ρ, E)
  requires point : x ∈ algebraCarrier(E)
  requires fixed : ∀ g ∈ Group.carrier(G), ρ(g)(x) = x
  shows ∃ a ∈ Ring.carrier(Algebra.base(E)), Algebra.map(E)(a) = x
proof
  sorry

end Actions
