-- More of the elementary special functions, as the proof uses them: the
-- real power x^y on all of ℝ as Mathlib defines it and its laws; the
-- square root as a power; the laws of log and exp beyond layer 1; bounds
-- on π and log 2; factorials and Stirling's bounds for log n!; harmonic
-- numbers and their logarithmic bounds; and the sums Σ 1/n² = π²/6 and
-- Σ 1/n⁴ = π⁴/90.
-- Part of the GRH blueprint.
-- Planned home: Analysis/SpecialFunctions.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.SpecialFunctions.More
import GRH.Log
import GRH.Topology.Sums

section SpecialFunctions
notation ring R := (ℝ, realAdd, realZero, realNeg, realMul, realOne)

-- Section: Definitions
-- The real power x^y for every real x and y, as Mathlib's Real.rpow: for
-- x > 0 it is exp(y log x), layer 1's realRpow; 0^0 = 1 and 0^y = 0 for
-- y ≠ 0; for x < 0 it is exp(y log |x|) cos(π y), the real part of the
-- complex power. Layer 1's realRpow agrees with it for x > 0 only.
defunique rpow (X S : Real) (Y ∈ ℝ) :=
  (R[0] < X ∧ Y = realRpow(X, S)) ∨
  (X = R[0] ∧ S = R[0] ∧ Y = R[1]) ∨
  (X = R[0] ∧ S ≠ R[0] ∧ Y = R[0]) ∨
  (X < R[0] ∧ Y = R[realRpow(-X, S) * realCos(S * realPi)])
proof
  have zR : Real(R[0]) by typecheck
  by_cases pos : R[0] < X
  . have r := realRpow.real at X, S
    refine ⟨realRpow(X, S), r, ?_⟩
    left
    exact ⟨pos, rfl⟩
  . by_cases neg : X < R[0]
    . have r : R[realRpow(-X, S) * realCos(S * realPi)] ∈ ℝ by typecheck
      refine ⟨R[realRpow(-X, S) * realCos(S * realPi)], r, ?_⟩
      right
      right
      right
      exact ⟨neg, rfl⟩
    . have zero : X = R[0] by linarith
      by_cases s0 : S = R[0]
      . have r : R[1] ∈ ℝ by typecheck
        refine ⟨R[1], r, ?_⟩
        right
        left
        exact ⟨zero, s0, rfl⟩
      . have r : R[0] ∈ ℝ by typecheck
        refine ⟨R[0], r, ?_⟩
        right
        right
        left
        exact ⟨zero, s0, rfl⟩
uniqueness
  intros Y1 h1 d1 Y2 h2 d2
  rcases d1 with ⟨a1, e1⟩ | ⟨a1, b1, e1⟩ | ⟨a1, b1, e1⟩ | ⟨a1, e1⟩
  . rcases d2 with ⟨a2, e2⟩ | ⟨a2, b2, e2⟩ | ⟨a2, b2, e2⟩ | ⟨a2, e2⟩
    . rw [e1, e2]
    . exfalso
      linarith
    . exfalso
      linarith
    . exfalso
      linarith
  . rcases d2 with ⟨a2, e2⟩ | ⟨a2, b2, e2⟩ | ⟨a2, b2, e2⟩ | ⟨a2, e2⟩
    . exfalso
      linarith
    . rw [e1, e2]
    . exfalso
      exact b2 with b1
    . exfalso
      linarith
  . rcases d2 with ⟨a2, e2⟩ | ⟨a2, b2, e2⟩ | ⟨a2, b2, e2⟩ | ⟨a2, e2⟩
    . exfalso
      linarith
    . exfalso
      exact b1 with b2
    . rw [e1, e2]
    . exfalso
      linarith
  . rcases d2 with ⟨a2, e2⟩ | ⟨a2, b2, e2⟩ | ⟨a2, b2, e2⟩ | ⟨a2, e2⟩
    . exfalso
      linarith
    . exfalso
      linarith
    . exfalso
      linarith
    . rw [e1, e2]

-- The harmonic number Hₙ = Σ_{k=1}^{n} 1/k (Mathlib's harmonic, real-valued
-- here), as the partial sum of the terms 1/(k + 1).
def harmonicNumber (n : Nat) : Real := realPartialSum(harmonicTerms, n)

-- Stirling's sequence n! / (√(2n) (n/e)ⁿ) for n ≥ 1 (Mathlib's
-- Stirling.stirlingSeq at n); its value at 0 is not used.
def stirlingSeq (n : Nat) : Real :=
  R[realNat(n!) / (realSqrt(R[2 * realNat(n)]) *
    realExp(R[realNat(n) * realLog(realNat(n)) - realNat(n)]))]
proof
  unfold stirlingSeq
  have nR := realNat.real at n
  have fR := realNat.real at n!
  have nn := realNat.zero_le at n
  have twoN : (0:R) ≤ R[2 * realNat(n)] by linarith
  have sq := realSqrt.real at R[2 * realNat(n)] with twoN
  have lg := realLog.real at realNat(n)
  typecheck

-- The terms 1/(n + 1)² and 1/(n + 1)⁴, n ≥ 0.
defgraph inverseSquares (n ∈ ℕ) : ℝ := R[1 / ((realNat(n) + 1) * (realNat(n) + 1))]
proof
  have nR := realNat.real at n
  typecheck

defgraph inverseFourthPowers (n ∈ ℕ) : ℝ :=
  R[1 / ((realNat(n) + 1) ^ 4)]
proof
  have nR := realNat.real at n
  typecheck

-- The four branches of rpow, one at a time.
theorem rpow.zero_zero
  shows rpow(R[0], R[0]) = R[1]
proof
  have zR : Real(R[0]) by typecheck
  obtain ⟨_, d⟩ := rpow.selected at R[0], R[0]
  rcases d with ⟨a, e⟩ | ⟨a, b, e⟩ | ⟨a, b, e⟩ | ⟨a, e⟩
  . exfalso
    linarith
  . exact e
  . exfalso
    exact b with rfl
  . exfalso
    linarith

theorem rpow.of_neg (X S : Real)
  requires negative : X < R[0]
  shows rpow(X, S) = R[realRpow(-X, S) * realCos(S * realPi)]
proof
  obtain ⟨_, d⟩ := rpow.selected at X, S
  rcases d with ⟨a, e⟩ | ⟨a, b, e⟩ | ⟨a, b, e⟩ | ⟨a, e⟩
  . exfalso
    linarith
  . exfalso
    linarith
  . exfalso
    linarith
  . exact e

-- cos(nπ) = (−1)ⁿ.
theorem realCos.nat_pi (n : Nat)
  shows realCos(R[realNat(n) * realPi]) = R[(-1) ^ n]
proof
  induction n
  | zero =>
    have z : R[0 * realPi] = R[0] by ring
    rw [realNat.zero, z, realCos.zero, monoidPow.zero]
  | succ(k) using ih =>
    have kR := realNat.real at k
    have e : R[(realNat(k) + 1) * realPi] = R[realNat(k) * realPi + realPi] by ring
    have pR := realPow.real at R[-1], k
    unfold realPow at pR
    rw [realNat.succ_add, e, realCos.add_pi, ih, monoidPow.succ]
    ring

-- A product of nonzero reals is nonzero.
theorem rpow.mul_ne_zero (S T : Real)
  requires nonzeroS : S ≠ R[0]
  requires nonzeroT : T ≠ R[0]
  shows R[S * T] ≠ R[0]
proof
  intro z
  have o := realMulValue.eq_zero_or at S, T with z
  cases o with a | b
  . exact nonzeroS with a
  . exact nonzeroT with b

-- Section: The real power
theorem rpow.real (X S : Real)
  shows rpow(X, S) ∈ ℝ
proof
  obtain ⟨r, _⟩ := rpow.selected at X, S
  exact r

-- Mathlib's Real.rpow_def_of_pos.
theorem rpow.of_pos (X S : Real)
  requires positive : R[0] < X
  shows rpow(X, S) = realRpow(X, S)
proof
  obtain ⟨_, d⟩ := rpow.selected at X, S
  rcases d with ⟨a, e⟩ | ⟨a, b, e⟩ | ⟨a, b, e⟩ | ⟨a, e⟩
  . exact e
  . exfalso
    linarith
  . exfalso
    linarith
  . exfalso
    linarith

theorem rpow.zero_base (S : Real)
  requires nonzero : S ≠ R[0]
  shows rpow(R[0], S) = R[0]
proof
  have zR : Real(R[0]) by typecheck
  obtain ⟨_, d⟩ := rpow.selected at R[0], S
  rcases d with ⟨a, e⟩ | ⟨a, b, e⟩ | ⟨a, b, e⟩ | ⟨a, e⟩
  . exfalso
    linarith
  . exfalso
    exact nonzero with b
  . exact e
  . exfalso
    linarith

theorem rpow.zero_exponent (X : Real)
  shows rpow(X, R[0]) = R[1]
proof
  have zR : Real(R[0]) by typecheck
  by_cases pos : R[0] < X
  . rw (rpow.of_pos at X, R[0] with pos)
    exact realRpow.zero at X
  . by_cases neg : X < R[0]
    . rw (rpow.of_neg at X, R[0] with neg)
      have z : R[0 * realPi] = R[0] by ring
      rw [z, realCos.zero, realRpow.zero]
      ring
    . have x0 : X = R[0] by linarith
      rw x0
      exact rpow.zero_zero

theorem rpow.one_exponent (X : Real)
  shows rpow(X, R[1]) = X
proof
  have oR : Real(R[1]) by typecheck
  by_cases pos : R[0] < X
  . rw (rpow.of_pos at X, R[1] with pos)
    exact realRpow.one at X with pos
  . by_cases neg : X < R[0]
    . rw (rpow.of_neg at X, R[1] with neg)
      have nx : R[0] < R[-X] by linarith
      have o := realRpow.one at R[-X] with nx
      have z : R[1 * realPi] = realPi by ring
      rw [z, realCos.pi, o]
      ring
    . have x0 : X = R[0] by linarith
      have ne : R[1] ≠ R[0]
        intro bad
        linarith
      rw x0
      exact rpow.zero_base at R[1] with ne

theorem rpow.one_base (S : Real)
  shows rpow(R[1], S) = R[1]
proof
  have pos : R[0] < R[1] by linarith
  rw (rpow.of_pos at R[1], S with pos)
  exact realRpow.one_base at S

-- Mathlib's Real.rpow_pos_of_pos and Real.rpow_nonneg.
theorem rpow.positive (X S : Real)
  requires positive : R[0] < X
  shows R[0] < rpow(X, S)
proof
  rw (rpow.of_pos at X, S with positive)
  exact realRpow.positive at X, S

theorem rpow.nonneg (X S : Real)
  requires nonneg : R[0] ≤ X
  shows R[0] ≤ rpow(X, S)
proof
  by_cases pos : R[0] < X
  . have p := rpow.positive at X, S with pos
    linarith
  . have x0 : X = R[0] by linarith
    rw x0
    by_cases s0 : S = R[0]
    . rw [s0, rpow.zero_zero]
      linarith
    . rw (rpow.zero_base at S with s0)
      linarith

-- Mathlib's Real.rpow_add, rpow_sub, rpow_add_one, rpow_neg.
theorem rpow.add (X S T : Real)
  requires positive : R[0] < X
  shows rpow(X, R[S + T]) = R[rpow(X, S) * rpow(X, T)]
proof
  rw [(rpow.of_pos at X, R[S + T] with positive), (rpow.of_pos at X, S with positive), (rpow.of_pos at X, T with positive)]
  exact realRpow.add at X, S, T with positive

theorem rpow.sub (X S T : Real)
  requires positive : R[0] < X
  shows rpow(X, R[S - T]) = R[rpow(X, S) / rpow(X, T)]
proof
  rw [(rpow.of_pos at X, R[S - T] with positive), (rpow.of_pos at X, S with positive), (rpow.of_pos at X, T with positive)]
  rw [(realRpow.add at X, S, R[-T] with positive), (realRpow.neg at X, T with positive)]
  rw [realDiv.eq_mul_inv, realDiv.eq_mul_inv]
  ring

theorem rpow.add_one (X S : Real)
  requires nonzero : X ≠ R[0]
  shows rpow(X, R[S + 1]) = R[rpow(X, S) * X]
proof
  have oR : Real(R[1]) by typecheck
  by_cases pos : R[0] < X
  . rw [(rpow.of_pos at X, R[S + 1] with pos), (rpow.of_pos at X, S with pos)]
    rw [(realRpow.add at X, S, R[1] with pos), (realRpow.one at X with pos)]
  . have neg : X < R[0]
      by_contra nn
      have x0 : X = R[0] by linarith
      exact nonzero with x0
    have nx : R[0] < R[-X] by linarith
    rw [(rpow.of_neg at X, R[S + 1] with neg), (rpow.of_neg at X, S with neg)]
    rw [(realRpow.add at R[-X], S, R[1] with nx), (realRpow.one at R[-X] with nx)]
    have z : R[(S + 1) * realPi] = R[S * realPi + realPi] by ring
    rw [z, realCos.add_pi]
    ring

theorem rpow.neg (X S : Real)
  requires nonneg : R[0] ≤ X
  shows rpow(X, R[-S]) = R[1 / rpow(X, S)]
proof
  by_cases pos : R[0] < X
  . rw [(rpow.of_pos at X, R[-S] with pos), (rpow.of_pos at X, S with pos)]
    exact realRpow.neg at X, S with pos
  . have x0 : X = R[0] by linarith
    rw x0
    by_cases s0 : S = R[0]
    . have ns : R[-S] = R[0] by linarith
      rw [ns, s0, rpow.zero_zero]
      rw realDiv.eq_mul_inv
      have one := realInvValue.one
      rw one
      ring
    . have ns : R[-S] ≠ R[0]
        intro bad
        have b2 : S = R[0] by linarith
        exact s0 with b2
      rw [(rpow.zero_base at R[-S] with ns), (rpow.zero_base at S with s0)]
      rw [realDiv.eq_mul_inv, realInvValue.zero]
      ring

-- Mathlib's Real.rpow_mul for a nonnegative base: (x^s)^t = x^(st).
theorem rpow.mul (X S T : Real)
  requires nonneg : R[0] ≤ X
  shows rpow(X, R[S * T]) = rpow(rpow(X, S), T)
proof
  by_cases pos : R[0] < X
  . have p := rpow.positive at X, S with pos
    rw [(rpow.of_pos at X, R[S * T] with pos), (rpow.of_pos at X, S with pos)]
    have p2 := realRpow.positive at X, S
    rw (rpow.of_pos at realRpow(X, S), T with p2)
    rw (realRpow.mul_exponent at X, S, T with pos)
  . have x0 : X = R[0] by linarith
    rw x0
    by_cases s0 : S = R[0]
    . have st : R[S * T] = R[0]
        rw s0
        ring
      rw [st, s0, rpow.zero_zero, rpow.one_base]
    . rw (rpow.zero_base at S with s0)
      by_cases t0 : T = R[0]
      . have st : R[S * T] = R[0]
          rw t0
          ring
        rw [st, t0, rpow.zero_zero]
      . have st := rpow.mul_ne_zero at S, T with s0, t0
        rw [(rpow.zero_base at R[S * T] with st), (rpow.zero_base at T with t0)]

-- Mathlib's Real.mul_rpow and inv_rpow.
theorem rpow.mul_base (X Y S : Real)
  requires nonnegX : R[0] ≤ X
  requires nonnegY : R[0] ≤ Y
  shows rpow(R[X * Y], S) = R[rpow(X, S) * rpow(Y, S)]
proof
  by_cases px : R[0] < X
  . by_cases py : R[0] < Y
    . have pxy : R[0] < R[X * Y]
        have m := realLess.mul_right_of_positive at R[0], X, Y with px, py
        have z : R[0 * Y] = R[0] by ring
        rw z at m
        exact m
      rw [(rpow.of_pos at R[X * Y], S with pxy), (rpow.of_pos at X, S with px), (rpow.of_pos at Y, S with py)]
      exact realRpow.mul_base at X, Y, S with px, py
    . have y0 : Y = R[0] by linarith
      have z : R[X * 0] = R[0] by ring
      rw [y0, z]
      by_cases s0 : S = R[0]
      . rw [s0, rpow.zero_zero, rpow.zero_exponent]
        ring
      . rw (rpow.zero_base at S with s0)
        ring
  . have x0 : X = R[0] by linarith
    have z : R[0 * Y] = R[0] by ring
    rw [x0, z]
    by_cases s0 : S = R[0]
    . rw [s0, rpow.zero_zero, rpow.zero_exponent]
      ring
    . rw (rpow.zero_base at S with s0)
      ring

theorem rpow.inv_base (X S : Real)
  requires nonneg : R[0] ≤ X
  shows rpow(R[1 / X], S) = R[1 / rpow(X, S)]
proof
  by_cases pos : R[0] < X
  . have xne : X ≠ R[0]
      intro bad
      rw bad at pos
      linarith
    have ip : R[0] < R[1 / X]
      have m := realDiv.mul_right at R[1], X with xne
      by_contra np
      have le : R[1 / X] ≤ R[0] by linarith
      have xNn : R[0] ≤ X by linarith
      have mm := realLe.mul_right_of_nonnegative at R[1 / X], R[0], X with le, xNn
      rw m at mm
      have z : R[0 * X] = R[0] by ring
      rw z at mm
      linarith
    rw [(rpow.of_pos at R[1 / X], S with ip), (rpow.of_pos at X, S with pos)]
    have e : realRpow(R[1 / X], S) = realRpow(X, R[-S])
      unfold realRpow
      rw (realLog.inv at X with pos)
      have r : R[S * -realLog(X)] = R[-S * realLog(X)] by ring
      rw r
    rw e
    exact realRpow.neg at X, S with pos
  . have x0 : X = R[0] by linarith
    have iz : R[1 / 0] = R[0]
      rw [realDiv.eq_mul_inv, realInvValue.zero]
      ring
    rw [x0, iz]
    by_cases s0 : S = R[0]
    . rw [s0, rpow.zero_zero]
      rw realDiv.eq_mul_inv
      have one := realInvValue.one
      rw one
      ring
    . rw (rpow.zero_base at S with s0)
      rw iz

-- 0 to a natural power, through rpow.
theorem rpow.zero_nat (n : Nat)
  shows rpow(R[0], realNat(n)) = R[0 ^ n]
proof
  induction n
  | zero =>
    rw [realNat.zero, rpow.zero_zero, monoidPow.zero]
  | succ(k) using ih =>
    have p := realNat.positive_succ at k
    have ne : realNat(succ(k)) ≠ R[0]
      intro bad
      rw bad at p
      linarith
    rw (rpow.zero_base at realNat(succ(k)) with ne)
    have z := realPow.zero_succ at k
    unfold realPow at z
    rw z

-- Mathlib's Real.rpow_natCast, rpow_mul_natCast, rpow_natCast_mul,
-- rpow_inv_natCast_pow, rpow_pow_comm.
theorem rpow.nat (X : Real, n : Nat)
  shows rpow(X, realNat(n)) = R[X ^ n]
proof
  have nR := realNat.real at n
  by_cases pos : R[0] < X
  . rw (rpow.of_pos at X, realNat(n) with pos)
    exact realRpow.nat at X, n with pos
  . by_cases neg : X < R[0]
    . have nx : R[0] < R[-X] by linarith
      rw [(rpow.of_neg at X, realNat(n) with neg), (realRpow.nat at R[-X], n with nx), realCos.nat_pi]
      have m := realPow.mul at R[-X], R[-1], n
      unfold realPow at m
      rw ← m
      have e : R[-X * -1] = X by ring
      rw e
    . have x0 : X = R[0] by linarith
      rw x0
      exact rpow.zero_nat at n

theorem rpow.mul_nat (X S : Real, n : Nat)
  requires nonneg : R[0] ≤ X
  shows rpow(X, R[S * realNat(n)]) = R[rpow(X, S) ^ n]
proof
  have nR := realNat.real at n
  have r := rpow.real at X, S
  have rR : Real(rpow(X, S)) by exact r
  rw (rpow.mul at X, S, realNat(n) with nonneg)
  exact rpow.nat at rpow(X, S), n

theorem rpow.nat_mul (X S : Real, n : Nat)
  requires nonneg : R[0] ≤ X
  shows rpow(X, R[realNat(n) * S]) = R[rpow(X, S) ^ n]
proof
  have nR := realNat.real at n
  have e : R[realNat(n) * S] = R[S * realNat(n)] by ring
  rw e
  exact rpow.mul_nat at X, S, n with nonneg

theorem rpow.inv_nat_pow (X : Real, n : Nat)
  requires nonneg : R[0] ≤ X
  requires positive : 1 ≤ n
  shows R[rpow(X, R[1 / realNat(n)]) ^ n] = X
proof
  have nR := realNat.real at n
  have p0 : 0 < n by arith
  have nne := Less.ne_zero_of_positive at n with p0
  have ne := realNat.nonzero at n with nne
  have qR := realDiv.real at R[1], realNat(n)
  rw ← (rpow.mul_nat at X, R[1 / realNat(n)], n with nonneg)
  rw (realDiv.mul_right at R[1], realNat(n) with ne)
  exact rpow.one_exponent at X

theorem rpow.pow_comm (X S : Real, n : Nat)
  requires nonneg : R[0] ≤ X
  shows rpow(R[X ^ n], S) = R[rpow(X, S) ^ n]
proof
  have nR := realNat.real at n
  have xn := rpow.nat at X, n
  rw ← xn
  rw ← (rpow.mul at X, realNat(n), S with nonneg)
  exact rpow.nat_mul at X, S, n with nonneg

theorem rpow.lt_of_base (X Y S : Real)
  requires nonnegX : R[0] ≤ X
  requires less : X < Y
  requires positive : R[0] < S
  shows rpow(X, S) < rpow(Y, S)
proof
  have yPos : R[0] < Y by linarith
  rw (rpow.of_pos at Y, S with yPos)
  by_cases pos : R[0] < X
  . rw (rpow.of_pos at X, S with pos)
    exact realRpow.lt_of_base at X, Y, S with pos, less, positive
  . have x0 : X = R[0] by linarith
    have s0 : S ≠ R[0]
      intro bad
      rw bad at positive
      linarith
    rw [x0, (rpow.zero_base at S with s0)]
    exact realRpow.positive at Y, S

-- Monotonicity (Mathlib's rpow_le_rpow_iff, rpow_le_rpow_left_iff,
-- rpow_lt_rpow).
theorem rpow.le_iff_base (X Y S : Real)
  requires nonnegX : R[0] ≤ X
  requires nonnegY : R[0] ≤ Y
  requires positive : R[0] < S
  shows rpow(X, S) ≤ rpow(Y, S) ↔ X ≤ Y
proof
  have rx := rpow.real at X, S
  have ry := rpow.real at Y, S
  have rxR : Real(rpow(X, S)) by exact rx
  have ryR : Real(rpow(Y, S)) by exact ry
  constructor
  . intro h
    by_contra nl
    have lt : Y < X by linarith
    have c := rpow.lt_of_base at Y, X, S with nonnegY, lt, positive
    linarith
  . intro h
    by_cases eq : X = Y
    . rw eq
      linarith
    . have lt : X < Y
        by_contra nl
        have ge : Y ≤ X by linarith
        have e2 : X = Y by linarith
        exact eq with e2
      have c := rpow.lt_of_base at X, Y, S with nonnegX, lt, positive
      linarith

theorem rpow.le_iff_exponent (X S T : Real)
  requires large : R[1] < X
  shows rpow(X, S) ≤ rpow(X, T) ↔ S ≤ T
proof
  have pos : R[0] < X by linarith
  rw [(rpow.of_pos at X, S with pos), (rpow.of_pos at X, T with pos)]
  have rS := realRpow.real at X, S
  have rT := realRpow.real at X, T
  have rSR : Real(realRpow(X, S)) by exact rS
  have rTR : Real(realRpow(X, T)) by exact rT
  constructor
  . intro h
    by_contra nl
    have lt : T < S by linarith
    have c := realRpow.lt_of_exponent at X, T, S with large, lt
    linarith
  . intro h
    by_cases eq : S = T
    . rw eq
      linarith
    . have lt : S < T
        by_contra nl
        have e2 : S = T by linarith
        exact eq with e2
      have c := realRpow.lt_of_exponent at X, S, T with large, lt
      linarith

theorem rpow.le_one (X S : Real)
  requires nonneg : R[0] ≤ X
  requires small : X ≤ R[1]
  requires positive : R[0] ≤ S
  shows rpow(X, S) ≤ R[1]
proof
  by_cases s0 : S = R[0]
  . rw [s0, rpow.zero_exponent]
    linarith
  . have sPos : R[0] < S
      by_contra np
      have e : S = R[0] by linarith
      exact s0 with e
    by_cases x1 : X = R[1]
    . rw [x1, rpow.one_base]
      linarith
    . have lt : X < R[1]
        by_contra nl
        have e : X = R[1] by linarith
        exact x1 with e
      have c := rpow.lt_of_base at X, R[1], S with nonneg, lt, sPos
      rw rpow.one_base at c
      linarith

-- Mathlib's Real.sqrt_eq_rpow: √x = x^(1/2) for x ≥ 0.
theorem rpow.sqrt (X : Real)
  requires nonneg : R[0] ≤ X
  shows realSqrt(X) = rpow(X, R[1 / 2])
proof
  have twoNe : R[2] ≠ R[0]
    intro bad
    linarith
  have halfR := realDiv.real at R[1], R[2]
  have halfM := realDiv.mul_right at R[1], R[2] with twoNe
  have halfNe : R[1 / 2] ≠ R[0]
    intro bad
    rw bad at halfM
    have z : R[0 * 2] = R[0] by ring
    rw z at halfM
    linarith
  have sR := realSqrt.real at X with nonneg
  have sNn := realSqrt.nonneg at X with nonneg
  have sSq := realSqrt.square at X with nonneg
  by_cases pos : R[0] < X
  . have rp := rpow.positive at X, R[1 / 2] with pos
    have rR := rpow.real at X, R[1 / 2]
    have rRR : Real(rpow(X, R[1 / 2])) by exact rR
    have rNn : R[0] ≤ rpow(X, R[1 / 2]) by linarith
    have add := rpow.add at X, R[1 / 2], R[1 / 2] with pos
    have hh : R[1 / 2 + 1 / 2] = R[1]
      have e : R[1 / 2 + 1 / 2] = R[(1 / 2) * 2] by ring
      rw [e, halfM]
    rw [hh, rpow.one_exponent] at add
    have sq2 : R[realSqrt(X) * realSqrt(X)] = R[rpow(X, R[1 / 2]) * rpow(X, R[1 / 2])]
      rw sSq
      exact add
    exact realMulValue.eq_of_square_eq at realSqrt(X), rpow(X, R[1 / 2]) with sNn, rNn, sq2
  . have x0 : X = R[0] by linarith
    rw x0 at sSq
    rw x0
    have z := (realMulValue.square_eq_zero_iff at realSqrt(R[0])).forward with sSq
    rw [z, (rpow.zero_base at R[1 / 2] with halfNe)]

-- Mathlib's Real.log_rpow.
theorem rpow.log (X S : Real)
  requires positive : R[0] < X
  shows realLog(rpow(X, S)) = R[S * realLog(X)]
proof
  rw (rpow.of_pos at X, S with positive)
  exact realRpow.log at X, S with positive

-- The product Π_{i<k} u(i) along identity(n), one factor at a time.
theorem realProd.succ_step (u : Set, n k : Nat)
  requires member : k ∈ n
  shows indexedRingSum(u, identity(n), realMul, realOne, succ(k)) =
    R[indexedRingSum(u, identity(n), realMul, realOne, k) * u(k)]
proof
  have a := identity.apply at k, n with member
  rw indexedRingSum
  rw a
  rfl

theorem realProd.zero_step (u : Set, n : Nat)
  shows indexedRingSum(u, identity(n), realMul, realOne, 0) = R[1]
proof
  rw indexedRingSum
  rfl

-- Sums against products, over the prefixes of {0, …, n − 1}.
theorem realExp.sum_prefix (x u : Set, n k : Nat)
  requires values : ∀ i ∈ n, x(i) ∈ ℝ
  requires exps : ∀ i ∈ n, u(i) = realExp(x(i))
  shows (∀ i ∈ k, i ∈ n) → realPartialSum(x, k) ∈ ℝ ∧
    realExp(realPartialSum(x, k)) = indexedRingSum(u, identity(n), realMul, realOne, k)
proof
  induction k
  | zero =>
    intro sub
    rw [realPartialSum.zero, realProd.zero_step, realExp.zero]
    have z : R[0] ∈ ℝ by typecheck
    exact ⟨z, rfl⟩
  | succ(j) using ih =>
    intro sub
    have subJ : ∀ i ∈ j, i ∈ n
      intros i hi
      have m : i ∈ succ(j) by simp [hi]
      exact sub with i, m
    have jIn : j ∈ succ(j) by simp
    have jn := sub with j, jIn
    obtain ⟨sR, eq⟩ := ih with subJ
    have sRR : Real(realPartialSum(x, j)) by exact sR
    have xj := values with j, jn
    have xjR : Real(x(j)) by exact xj
    have same : realAddValue(realPartialSum(x, j), x(j)) = R[realPartialSum(x, j) + x(j)] by simp [realAddValue, call2]
    rw [realPartialSum.succ, same, (realProd.succ_step at u, n, j with jn), ← eq, (exps with j, jn)]
    have t : R[realPartialSum(x, j) + x(j)] ∈ ℝ by typecheck
    refine ⟨t, ?_⟩
    exact realExp.add at realPartialSum(x, j), x(j)

theorem realLog.prod_prefix (x u : Set, n k : Nat)
  requires positive : ∀ i ∈ n, x(i) ∈ ℝ ∧ R[0] < x(i)
  requires logs : ∀ i ∈ n, u(i) = realLog(x(i))
  shows (∀ i ∈ k, i ∈ n) →
    indexedRingSum(x, identity(n), realMul, realOne, k) ∈ ℝ ∧
    R[0] < indexedRingSum(x, identity(n), realMul, realOne, k) ∧
    realLog(indexedRingSum(x, identity(n), realMul, realOne, k)) = realPartialSum(u, k)
proof
  induction k
  | zero =>
    intro sub
    rw [realPartialSum.zero, realProd.zero_step, realLog.one]
    have z : R[1] ∈ ℝ by typecheck
    have p : R[0] < R[1] by linarith
    exact ⟨z, p, rfl⟩
  | succ(j) using ih =>
    intro sub
    have subJ : ∀ i ∈ j, i ∈ n
      intros i hi
      have m : i ∈ succ(j) by simp [hi]
      exact sub with i, m
    have jIn : j ∈ succ(j) by simp
    have jn := sub with j, jIn
    obtain ⟨pR, pPos, eq⟩ := ih with subJ
    have pRR : Real(indexedRingSum(x, identity(n), realMul, realOne, j)) by exact pR
    obtain ⟨xj, xjPos⟩ := positive with j, jn
    have xjR : Real(x(j)) by exact xj
    rw [(realProd.succ_step at x, n, j with jn), realPartialSum.succ, (logs with j, jn), ← eq]
    have t : R[indexedRingSum(x, identity(n), realMul, realOne, j) * x(j)] ∈ ℝ by typecheck
    have m := realLess.mul_right_of_positive at R[0], indexedRingSum(x, identity(n), realMul, realOne, j), x(j) with pPos, xjPos
    have z : R[0 * x(j)] = R[0] by ring
    rw z at m
    refine ⟨t, m, ?_⟩
    rw (realLog.mul at indexedRingSum(x, identity(n), realMul, realOne, j), x(j) with pPos, xjPos)
    have l1 := realLog.real at indexedRingSum(x, identity(n), realMul, realOne, j)
    have l1R : Real(realLog(indexedRingSum(x, identity(n), realMul, realOne, j))) by exact l1
    have l2 := realLog.real at x(j)
    have l2R : Real(realLog(x(j))) by exact l2
    simp [realAddValue, call2]

theorem rpow.sum_prefix (X : Real, s u : Set, n k : Nat)
  requires positive : R[0] < X
  requires exponents : ∀ i ∈ n, s(i) ∈ ℝ
  requires powers : ∀ i ∈ n, u(i) = rpow(X, s(i))
  shows (∀ i ∈ k, i ∈ n) → realPartialSum(s, k) ∈ ℝ ∧
    rpow(X, realPartialSum(s, k)) = indexedRingSum(u, identity(n), realMul, realOne, k)
proof
  induction k
  | zero =>
    intro sub
    rw [realPartialSum.zero, realProd.zero_step, rpow.zero_exponent]
    have z : R[0] ∈ ℝ by typecheck
    exact ⟨z, rfl⟩
  | succ(j) using ih =>
    intro sub
    have subJ : ∀ i ∈ j, i ∈ n
      intros i hi
      have m : i ∈ succ(j) by simp [hi]
      exact sub with i, m
    have jIn : j ∈ succ(j) by simp
    have jn := sub with j, jIn
    obtain ⟨sR, eq⟩ := ih with subJ
    have sRR : Real(realPartialSum(s, j)) by exact sR
    have sj := exponents with j, jn
    have sjR : Real(s(j)) by exact sj
    have same : realAddValue(realPartialSum(s, j), s(j)) = R[realPartialSum(s, j) + s(j)] by simp [realAddValue, call2]
    rw [realPartialSum.succ, same, (realProd.succ_step at u, n, j with jn), ← eq, (powers with j, jn)]
    have t : R[realPartialSum(s, j) + s(j)] ∈ ℝ by typecheck
    refine ⟨t, ?_⟩
    exact rpow.add at X, realPartialSum(s, j), s(j) with positive

-- Mathlib's Real.rpow_sum_of_pos: x^(Σ sᵢ) = Π x^sᵢ, over {0, …, n − 1}.
theorem rpow.sum (X : Real, s u : Set, n : Nat)
  requires positive : R[0] < X
  requires exponents : ∀ i ∈ n, s(i) ∈ ℝ
  requires powers : ∀ i ∈ n, u(i) = rpow(X, s(i))
  shows rpow(X, realPartialSum(s, n)) =
    indexedRingSum(u, identity(n), realMul, realOne, n)
proof
  have all : ∀ i ∈ n, i ∈ n
    intros i hi
    exact hi
  have r := rpow.sum_prefix at X, s, u, n, n with positive, exponents, powers
  have r2 := r with all
  exact r2.right

-- The complex power of a positive real base has modulus x^(re s)
-- (Mathlib's Complex.norm_cpow_eq_rpow_re_of_pos).
theorem realCpow.abs_rpow (X : Real, s : Set)
  requires positive : R[0] < X
  requires member : s ∈ complexCarrier
  shows complexAbs(realCpow(X, s)) = rpow(X, complexRe(s))
proof
  rw (rpow.of_pos at X, complexRe(s) with positive)
  exact realCpow.abs at X, s with positive, member

-- Squares are monotone on the nonnegative reals.
theorem realSqrt.square_le (A B : Real)
  requires nonneg : R[0] ≤ A
  requires le : A ≤ B
  shows R[A * A] ≤ R[B * B]
proof
  have bNn : R[0] ≤ B by linarith
  have m1 := realLe.mul_left_of_nonnegative at A, B, A with le, nonneg
  have m2 := realLe.mul_right_of_nonnegative at A, B, B with le, bNn
  linarith

theorem realSqrt.square_lt (A B : Real)
  requires nonneg : R[0] ≤ A
  requires lt : A < B
  shows R[A * A] < R[B * B]
proof
  have bPos : R[0] < B by linarith
  have le : A ≤ B by linarith
  have m1 := realLe.mul_left_of_nonnegative at A, B, A with le, nonneg
  have m2 := realLess.mul_right_of_positive at A, B, B with lt, bPos
  linarith

-- The square root of a square of a nonnegative real.
theorem realSqrt.of_square (Y : Real)
  requires nonneg : R[0] ≤ Y
  shows realSqrt(R[Y * Y]) = Y
proof
  have yy := realMulValue.nonnegative at Y, Y with nonneg, nonneg
  have r := realSqrt.real at R[Y * Y] with yy
  have n := realSqrt.nonneg at R[Y * Y] with yy
  have sq := realSqrt.square at R[Y * Y] with yy
  exact realMulValue.eq_of_square_eq at realSqrt(R[Y * Y]), Y with n, nonneg, sq

-- Section: The square root
theorem realSqrt.mul (X Y : Real)
  requires nonnegX : R[0] ≤ X
  requires nonnegY : R[0] ≤ Y
  shows realSqrt(R[X * Y]) = R[realSqrt(X) * realSqrt(Y)]
proof
  have xy := realMulValue.nonnegative at X, Y with nonnegX, nonnegY
  have r1 := realSqrt.real at X with nonnegX
  have r2 := realSqrt.real at Y with nonnegY
  have n1 := realSqrt.nonneg at X with nonnegX
  have n2 := realSqrt.nonneg at Y with nonnegY
  have s1 := realSqrt.square at X with nonnegX
  have s2 := realSqrt.square at Y with nonnegY
  have r3 := realSqrt.real at R[X * Y] with xy
  have n3 := realSqrt.nonneg at R[X * Y] with xy
  have s3 := realSqrt.square at R[X * Y] with xy
  have n12 := realMulValue.nonnegative at realSqrt(X), realSqrt(Y) with n1, n2
  have sq : R[realSqrt(R[X * Y]) * realSqrt(R[X * Y])] = R[(realSqrt(X) * realSqrt(Y)) * (realSqrt(X) * realSqrt(Y))]
    have e : R[(realSqrt(X) * realSqrt(Y)) * (realSqrt(X) * realSqrt(Y))] = R[(realSqrt(X) * realSqrt(X)) * (realSqrt(Y) * realSqrt(Y))] by ring
    rw [e, s1, s2, s3]
  exact realMulValue.eq_of_square_eq at realSqrt(R[X * Y]), R[realSqrt(X) * realSqrt(Y)] with n3, n12, sq

theorem realSqrt.eq_zero (X : Real)
  requires nonneg : R[0] ≤ X
  shows realSqrt(X) = R[0] ↔ X = R[0]
proof
  have r := realSqrt.real at X with nonneg
  have s := realSqrt.square at X with nonneg
  constructor
  . intro h
    rw h at s
    have z : R[0 * 0] = R[0] by ring
    rw z at s
    linarith
  . intro h
    rw h at s
    rw h
    exact (realMulValue.square_eq_zero_iff at realSqrt(R[0])).forward with s

theorem realSqrt.positive (X : Real)
  requires positive : R[0] < X
  shows R[0] < realSqrt(X)
proof
  have nn : R[0] ≤ X by linarith
  have r := realSqrt.real at X with nn
  have n := realSqrt.nonneg at X with nn
  have s := realSqrt.square at X with nn
  by_contra np
  have z : realSqrt(X) = R[0] by linarith
  rw z at s
  have zz : R[0 * 0] = R[0] by ring
  rw zz at s
  linarith

theorem realSqrt.le_iff (X Y : Real)
  requires nonnegX : R[0] ≤ X
  requires nonnegY : R[0] ≤ Y
  shows realSqrt(X) ≤ realSqrt(Y) ↔ X ≤ Y
proof
  have r1 := realSqrt.real at X with nonnegX
  have r2 := realSqrt.real at Y with nonnegY
  have n1 := realSqrt.nonneg at X with nonnegX
  have n2 := realSqrt.nonneg at Y with nonnegY
  have s1 := realSqrt.square at X with nonnegX
  have s2 := realSqrt.square at Y with nonnegY
  constructor
  . intro h
    have m := realSqrt.square_le at realSqrt(X), realSqrt(Y) with n1, h
    rw [s1, s2] at m
    exact m
  . intro h
    by_contra nl
    have lt : realSqrt(Y) < realSqrt(X) by linarith
    have m := realSqrt.square_lt at realSqrt(Y), realSqrt(X) with n2, lt
    rw [s1, s2] at m
    linarith

-- Mathlib's Real.sqrt_sq_eq_abs.
theorem realSqrt.square_abs (X : Real)
  shows realSqrt(R[X * X]) = abs(X)
proof
  have aR : Real(abs(X)) by typecheck
  have aNn := abs.nonnegative at X
  have sq : R[0] ≤ R[X * X]
    by_cases xn : R[0] ≤ X
    . exact realMulValue.nonnegative at X, X with xn, xn
    . have nx : R[0] ≤ R[-X] by linarith
      have m := realMulValue.nonnegative at R[-X], R[-X] with nx, nx
      have e : R[-X * -X] = R[X * X] by ring
      rw e at m
      exact m
  have am := abs.mul at X, X
  rw (abs.of_nonnegative at R[X * X] with sq) at am
  rw am
  exact realSqrt.of_square at abs(X) with aNn

-- Mathlib's Real.sqrt_le_left and sqrt_le_iff: √x ≤ y ↔ x ≤ y² for y ≥ 0.
theorem realSqrt.le_iff_square (X Y : Real)
  requires nonnegX : R[0] ≤ X
  requires nonnegY : R[0] ≤ Y
  shows realSqrt(X) ≤ Y ↔ X ≤ R[Y * Y]
proof
  have yy := realMulValue.nonnegative at Y, Y with nonnegY, nonnegY
  have l := realSqrt.le_iff at X, R[Y * Y] with nonnegX, yy
  rw (realSqrt.of_square at Y with nonnegY) at l
  exact l

-- Mathlib's Real.sqrt_div_self': √x / x = 1/√x.
theorem realSqrt.div_self (X : Real)
  requires positive : R[0] < X
  shows R[realSqrt(X) / X] = R[1 / realSqrt(X)]
proof
  have nn : R[0] ≤ X by linarith
  have r := realSqrt.real at X with nn
  have p := realSqrt.positive at X with positive
  have s := realSqrt.square at X with nn
  have xne : X ≠ R[0]
    intro bad
    rw bad at positive
    linarith
  have sne : realSqrt(X) ≠ R[0]
    intro bad
    rw bad at p
    linarith
  apply realDiv.eq_of_cross at realSqrt(X), X, R[1], realSqrt(X) with xne, sne
  rw s
  ring

-- Mathlib's Real.log_sqrt.
theorem realSqrt.log (X : Real)
  requires positive : R[0] < X
  shows realLog(realSqrt(X)) = R[realLog(X) / 2]
proof
  have nn : R[0] ≤ X by linarith
  have r := realSqrt.real at X with nn
  have p := realSqrt.positive at X with positive
  have s := realSqrt.square at X with nn
  have l := realLog.mul at realSqrt(X), realSqrt(X) with p, p
  rw s at l
  have lR := realLog.real at realSqrt(X)
  have lRR : Real(realLog(realSqrt(X))) by exact lR
  have d : R[realLog(realSqrt(X)) + realLog(realSqrt(X))] = realLog(X) by rw l
  exact realDiv.of_double_eq at realLog(realSqrt(X)), realLog(X) with d

-- Section: Logarithm and exponential
-- Mathlib's Real.log_le_log_iff and Real.log_le_log.
theorem realLog.le_iff (X Y : Real)
  requires positiveX : R[0] < X
  requires positiveY : R[0] < Y
  shows realLog(X) ≤ realLog(Y) ↔ X ≤ Y
proof
  have lx := realLog.real at X
  have ly := realLog.real at Y
  have lxR : Real(realLog(X)) by exact lx
  have lyR : Real(realLog(Y)) by exact ly
  constructor
  . intro h
    by_contra nl
    have lt : Y < X by linarith
    have c := realLog.strictly_increasing at Y, X with positiveY, lt
    linarith
  . intro h
    by_cases eq : X = Y
    . rw eq
      linarith
    . have lt : X < Y
        by_contra nl
        have e2 : X = Y by linarith
        exact eq with e2
      have c := realLog.strictly_increasing at X, Y with positiveX, lt
      linarith

-- Mathlib's Real.log_le_self: log x ≤ x for x ≥ 0.
theorem realLog.le_self (X : Real)
  requires nonneg : R[0] ≤ X
  shows realLog(X) ≤ X
proof
  have lx := realLog.real at X
  have lxR : Real(realLog(X)) by exact lx
  by_cases pos : R[0] < X
  . have b := realLog.le_sub_one at X with pos
    linarith
  . have x0 : X ≤ R[0] by linarith
    rw (realLog.nonpositive at X with x0)
    exact nonneg

-- Mathlib's Real.log_nonneg_iff.
theorem realLog.nonneg_iff (X : Real)
  requires positive : R[0] < X
  shows R[0] ≤ realLog(X) ↔ R[1] ≤ X
proof
  have lx := realLog.real at X
  have lxR : Real(realLog(X)) by exact lx
  constructor
  . intro h
    by_contra nl
    have lt : X < R[1] by linarith
    have c := realLog.strictly_increasing at X, R[1] with positive, lt
    rw realLog.one at c
    linarith
  . intro h
    exact realLog.nonnegative at X with h

theorem realLog.nat_nonneg (n : Nat)
  shows R[0] ≤ realLog(realNat(n))
proof
  induction n
  | zero =>
    have z : realNat(0) ≤ R[0]
      rw realNat.zero
      linarith
    rw (realLog.nonpositive at realNat(0) with z)
    linarith
  | succ(k) using ih =>
    have kN := realNat.zero_le at k
    have kR := realNat.real at k
    have one : R[1] ≤ realNat(succ(k))
      rw realNat.succ_add
      linarith
    exact realLog.nonnegative at realNat(succ(k)) with one

-- Mathlib's Real.log_prod, over {0, …, n − 1}.
theorem realLog.prod (x u : Set, n : Nat)
  requires positive : ∀ i ∈ n, x(i) ∈ ℝ ∧ R[0] < x(i)
  requires logs : ∀ i ∈ n, u(i) = realLog(x(i))
  shows realLog(indexedRingSum(x, identity(n), realMul, realOne, n)) =
    realPartialSum(u, n)
proof
  have all : ∀ i ∈ n, i ∈ n
    intros i hi
    exact hi
  have r := realLog.prod_prefix at x, u, n, n with positive, logs
  obtain ⟨_, _, e⟩ := r with all
  exact e

-- Mathlib's Real.log_two_gt_d9 and log_two_lt_d9.
theorem realLog.two_bounds
  shows R[6931471803 / 10000000000] < realLog(R[2]) ∧
    realLog(R[2]) < R[6931471808 / 10000000000]
proof
  sorry

-- log y = 2 log √y for y > 0.
theorem realSqrt.log_double (Y : Real)
  requires positive : R[0] < Y
  shows realLog(Y) = R[2 * realLog(realSqrt(Y))]
proof
  have l := realSqrt.log at Y with positive
  have twoNe : R[2] ≠ R[0]
    intro bad
    linarith
  have m := realDiv.mul_right at realLog(Y), R[2] with twoNe
  rw l
  have qR := realDiv.real at realLog(Y), R[2]
  have e : R[2 * (realLog(Y) / 2)] = R[(realLog(Y) / 2) * 2] by ring
  rw [e, m]

-- log x < √x for x > 0.
theorem realLog.le_sqrt (X : Real)
  requires positive : R[0] < X
  shows realLog(X) < realSqrt(X)
proof
  have xNn : R[0] ≤ X by linarith
  have aP := realSqrt.positive at X with positive
  have aR := realSqrt.real at X with xNn
  have aNn : R[0] ≤ realSqrt(X) by linarith
  have bP := realSqrt.positive at realSqrt(X) with aP
  have bR := realSqrt.real at realSqrt(X) with aNn
  have bNn : R[0] ≤ realSqrt(realSqrt(X)) by linarith
  have cP := realSqrt.positive at realSqrt(realSqrt(X)) with bP
  have cR := realSqrt.real at realSqrt(realSqrt(X)) with bNn
  have aSq := realSqrt.square at realSqrt(X) with aNn
  have bSq := realSqrt.square at realSqrt(realSqrt(X)) with bNn
  have l1 := realSqrt.log_double at X with positive
  have l2 := realSqrt.log_double at realSqrt(X) with aP
  have l3 := realSqrt.log_double at realSqrt(realSqrt(X)) with bP
  have lc := realLog.le_sub_one at realSqrt(realSqrt(realSqrt(X))) with cP
  have L0 := realLog.real at X
  have L1 := realLog.real at realSqrt(X)
  have L2 := realLog.real at realSqrt(realSqrt(X))
  have L3 := realLog.real at realSqrt(realSqrt(realSqrt(X)))
  have L0R : Real(realLog(X)) by exact L0
  have L1R : Real(realLog(realSqrt(X))) by exact L1
  have L2R : Real(realLog(realSqrt(realSqrt(X)))) by exact L2
  have L3R : Real(realLog(realSqrt(realSqrt(realSqrt(X))))) by exact L3
  have id : R[realSqrt(realSqrt(realSqrt(X))) * realSqrt(realSqrt(realSqrt(X))) * (realSqrt(realSqrt(realSqrt(X))) * realSqrt(realSqrt(realSqrt(X)))) - 8 * realSqrt(realSqrt(realSqrt(X))) + 8] = R[(realSqrt(realSqrt(realSqrt(X))) * realSqrt(realSqrt(realSqrt(X))) - 2) * (realSqrt(realSqrt(realSqrt(X))) * realSqrt(realSqrt(realSqrt(X))) - 2) + 4 * ((realSqrt(realSqrt(realSqrt(X))) - 1) * (realSqrt(realSqrt(realSqrt(X))) - 1))] by ring
  have c4 : R[realSqrt(realSqrt(realSqrt(X))) * realSqrt(realSqrt(realSqrt(X))) * (realSqrt(realSqrt(realSqrt(X))) * realSqrt(realSqrt(realSqrt(X))))] = realSqrt(X)
    rw [bSq, aSq]
  have s1R : Real(R[realSqrt(realSqrt(realSqrt(X))) * realSqrt(realSqrt(realSqrt(X))) - 2]) by typecheck
  have sq1 : R[0] ≤ R[(realSqrt(realSqrt(realSqrt(X))) * realSqrt(realSqrt(realSqrt(X))) - 2) * (realSqrt(realSqrt(realSqrt(X))) * realSqrt(realSqrt(realSqrt(X))) - 2)]
    by_cases nn : R[0] ≤ R[realSqrt(realSqrt(realSqrt(X))) * realSqrt(realSqrt(realSqrt(X))) - 2]
    . exact realMulValue.nonnegative with nn, nn
    . have nn2 : R[0] ≤ R[-(realSqrt(realSqrt(realSqrt(X))) * realSqrt(realSqrt(realSqrt(X))) - 2)] by linarith
      have m := realMulValue.nonnegative with nn2, nn2
      have e : R[-(realSqrt(realSqrt(realSqrt(X))) * realSqrt(realSqrt(realSqrt(X))) - 2) * -(realSqrt(realSqrt(realSqrt(X))) * realSqrt(realSqrt(realSqrt(X))) - 2)] = R[(realSqrt(realSqrt(realSqrt(X))) * realSqrt(realSqrt(realSqrt(X))) - 2) * (realSqrt(realSqrt(realSqrt(X))) * realSqrt(realSqrt(realSqrt(X))) - 2)] by ring
      rw e at m
      exact m
  by_cases c1 : realSqrt(realSqrt(realSqrt(X))) = R[1]
  . rw c1 at l3
    rw realLog.one at l3
    have z : R[2 * 0] = R[0] by ring
    rw z at l3
    linarith
  . have ne : R[realSqrt(realSqrt(realSqrt(X))) - 1] ≠ R[0]
      intro bad
      have e : realSqrt(realSqrt(realSqrt(X))) = R[1] by linarith
      exact c1 with e
    have sq2 := realMulValue.square_positive at R[realSqrt(realSqrt(realSqrt(X))) - 1] with ne
    linarith

-- Mathlib's Real.exp_sum and Real.exp_nat_mul.
theorem realExp.sum (x u : Set, n : Nat)
  requires values : ∀ i ∈ n, x(i) ∈ ℝ
  requires exps : ∀ i ∈ n, u(i) = realExp(x(i))
  shows realExp(realPartialSum(x, n)) =
    indexedRingSum(u, identity(n), realMul, realOne, n)
proof
  have all : ∀ i ∈ n, i ∈ n
    intros i hi
    exact hi
  have r := realExp.sum_prefix at x, u, n, n with values, exps
  have r2 := r with all
  exact r2.right

-- Mathlib's Real.add_one_le_exp and Real.le_exp_of_log_le.
theorem realExp.le_of_log_le (X Y : Real)
  requires positive : R[0] < X
  requires le : realLog(X) ≤ Y
  shows X ≤ realExp(Y)
proof
  have e := realLog.exp at X with positive
  have m := (realExp.le_iff at realLog(X), Y).backward with le
  rw e at m
  exact m

theorem realExp.half (X : Real)
  shows realExp(R[X / 2]) = realSqrt(realExp(X))
proof
  have twoNe : R[2] ≠ R[0]
    intro bad
    linarith
  have h := realDiv.real at X, R[2]
  have d := realDiv.mul_right at X, R[2] with twoNe
  have p := realExp.positive at R[X / 2]
  have ep := realExp.positive at X
  have eR : Real(realExp(R[X / 2])) by typecheck
  have eNn : R[0] ≤ realExp(R[X / 2]) by linarith
  have xNn : R[0] ≤ realExp(X) by linarith
  have s := realExp.add at R[X / 2], R[X / 2]
  have hh : R[X / 2 + X / 2] = X
    have e : R[X / 2 + X / 2] = R[(X / 2) * 2] by ring
    rw [e, d]
  rw hh at s
  have sR := realSqrt.real at realExp(X) with xNn
  have sNn := realSqrt.nonneg at realExp(X) with xNn
  have sSq := realSqrt.square at realExp(X) with xNn
  have sq : R[realExp(R[X / 2]) * realExp(R[X / 2])] = R[realSqrt(realExp(X)) * realSqrt(realExp(X))]
    rw [sSq, s]
  exact realMulValue.eq_of_square_eq at realExp(R[X / 2]), realSqrt(realExp(X)) with eNn, sNn, sq

-- Section: π
-- Mathlib's Real.pi_gt_three, two_le_pi, pi_le_four, pi_ne_zero.
theorem realPi.gt_three
  shows R[3] < realPi
proof
  have b := realPi.bounds
  exact b.left

theorem realPi.le_four
  shows realPi ≤ R[4]
proof
  have b := realPi.bounds
  have r := b.right
  have pR := realPi.real
  linarith

theorem realPi.two_le
  shows R[2] ≤ realPi
proof
  have b := realPi.bounds
  have l := b.left
  have pR := realPi.real
  linarith

theorem realPi.decimal_bounds
  shows R[314 / 100] < realPi ∧ realPi < R[315 / 100]
proof
  sorry

-- Section: Factorials and Stirling
-- Factorials grow: n! ≤ (n + 1)! and m! ≤ (m + d)!.
theorem moreFactorial.step (n : Nat)
  shows n! ≤ (n + (1:N))!
proof
  rw factorial.succ
  have closed := factorial.closed at n
  have expand : (n + (1:N)) * n! = n * n! + n! by ring
  rw expand
  have productNat : Nat(n * n!) by typecheck
  arith

theorem moreFactorial.le_add (m d : Nat)
  shows m! ≤ (m + d)!
proof
  induction d
  | zero =>
    have shape : m + (0:N) = m by ring
    rw shape
    have closed := factorial.closed at m
    exact LessEqual.reflexive at m!
  | j + 1 using ih =>
    have shape : m + (j + (1:N)) = (m + j) + (1:N) by ring
    rw shape
    have step := moreFactorial.step at m + j
    have closedM := factorial.closed at m
    have closedJ := factorial.closed at m + j
    have closedTop := factorial.closed at m + j + (1:N)
    exact LessEqual.transitive with ih, step

-- Nᴺ / N! is one term of the series of exp(N): Nᴺ ≤ N! e^N.
theorem moreFactorial.pow_le_exp (N : Nat)
  shows R[realNat(N) ^ N] ≤ R[realNat(N!) * realExp(realNat(N))]
proof
  have xR := realNat.real at N
  have xNn := realNat.zero_le at N
  have nn : NonnegativeTerms(realExpTerms(realNat(N)))
    unfold NonnegativeTerms
    intros i hi
    have iN := nat.omega.backward with hi
    rw (realExpTerms.value at realNat(N), i)
    have pw := realPow.nonnegative at realNat(N), i with xNn
    unfold realPow at pw
    have pwR := realPow.real at realNat(N), i
    unfold realPow at pwR
    have fp := realNat.factorial_positive at i
    have fne := realNat.factorial_nonzero at i
    have fR := realNat.real at i!
    have m := realDiv.mul_right at R[realNat(N) ^ i], realNat(i!) with fne
    have qR := realDiv.real at R[realNat(N) ^ i], realNat(i!)
    have goal : R[0] ≤ R[realNat(N) ^ i / realNat(i!)]
      by_contra np
      have neg : R[realNat(N) ^ i / realNat(i!)] < R[0] by linarith
      have mm := realLess.mul_right_of_positive at R[realNat(N) ^ i / realNat(i!)], R[0], realNat(i!) with neg, fp
      rw m at mm
      have z : R[0 * realNat(i!)] = R[0] by ring
      rw z at mm
      linarith
    exact (realLe.characterization at R[0], R[realNat(N) ^ i / realNat(i!)]).forward with goal
  have sums := realExp.sums at realNat(N)
  have seq := SumsTo.sequence at realExpTerms(realNat(N)), realExp(realNat(N)) with sums
  have pl := SumsTo.partial_le at realExpTerms(realNat(N)), realExp(realNat(N)), succ(N) with sums, nn
  rw realPartialSum.succ at pl
  have pre : ∀ k ∈ N, R[0] ≤ realExpTerms(realNat(N))(k)
    intros k hk
    have kN := natural.member at N with hk
    have kIn : k ∈ ℕ by typecheck
    have nk := nn
    unfold NonnegativeTerms at nk
    have r := nk with k, kIn
    exact (realLe.characterization at R[0], realExpTerms(realNat(N))(k)).backward with r
  have p0 := realPartialSum.nonnegative_prefix at realExpTerms(realNat(N)), N with seq
  have p1 := p0 with pre
  have psR := realPartialSum.real at realExpTerms(realNat(N)), N with seq
  rw (realExpTerms.value at realNat(N), N) at pl
  have pwR := realPow.real at realNat(N), N
  unfold realPow at pwR
  have fp := realNat.factorial_positive at N
  have fne := realNat.factorial_nonzero at N
  have fR := realNat.real at N!
  have qR := realDiv.real at R[realNat(N) ^ N], realNat(N!)
  have eR : Real(realExp(realNat(N))) by typecheck
  have tle : R[realNat(N) ^ N / realNat(N!)] ≤ realExp(realNat(N)) by linarith
  have m := realDiv.mul_right at R[realNat(N) ^ N], realNat(N!) with fne
  have fNn : R[0] ≤ realNat(N!) by linarith
  have mm := realLe.mul_right_of_nonnegative at R[realNat(N) ^ N / realNat(N!)], realExp(realNat(N)), realNat(N!) with tle, fNn
  rw m at mm
  have sw : R[realExp(realNat(N)) * realNat(N!)] = R[realNat(N!) * realExp(realNat(N))] by ring
  rw sw at mm
  exact mm

-- Mathlib's Nat.factorial_le_pow: n! ≤ nⁿ.
theorem factorial.le_pow (n : Nat)
  shows n! ≤ pow(n, n)
proof
  induction n
  | zero =>
    rw [factorial, pow]
    arith
  | k + 1 using ih =>
    rw [factorial.succ, pow.add_one]
    have kk : k ≤ k + (1:N) by arith
    have b := pow.base_monotone at k, k + (1:N), k with kk
    have c1 := factorial.closed at k
    have c2 := pow.closed at k, k
    have c3 := pow.closed at k + (1:N), k
    have t := LessEqual.transitive with ih, b
    exact LessEqual.mul_left at k!, pow(k + (1:N), k), k + (1:N) with t

-- Mathlib's Nat.factorial_mul_ascFactorial and Nat.factorial_le: for
-- m ≤ n, m! ≤ n!, and n! (n + 1)⋯(n + k) = (n + k)!.
theorem factorial.mono (m n : Nat)
  requires le : m ≤ n
  shows m! ≤ n!
proof
  obtain ⟨d, dNat, eq⟩ := LessEqual.exists_add at m, n with le
  rw eq
  exact moreFactorial.le_add at m, d

theorem factorial.lower_pow (n : Nat)
  shows realExp(R[realNat(n) * realLog(realNat(n)) - realNat(n)]) ≤ realNat(n!)
proof
  have xR := realNat.real at n
  have fR := realNat.real at n!
  have fp := realNat.factorial_positive at n
  have lR := realLog.real at realNat(n)
  have lRR : Real(realLog(realNat(n))) by exact lR
  by_cases n0 : n = (0:N)
  . rw n0
    rw [realNat.zero]
    have z : R[0 * realLog(0) - 0] = R[0] by ring
    rw [z, realExp.zero]
    rw n0 at fp
    have fR0 := realNat.real at (0:N)!
    have one : (0:N)! = (1:N)
      rw factorial
    rw [one, realNat.one]
    linarith
  . have np := realNat.positive at n with n0
    have b := moreFactorial.pow_le_exp at n
    have pw := realExp.nat_mul at realLog(realNat(n)), n
    rw (realLog.exp at realNat(n) with np) at pw
    rw ← pw at b
    have ad := realExp.add at R[realNat(n) * realLog(realNat(n)) - realNat(n)], realNat(n)
    have e : R[realNat(n) * realLog(realNat(n)) - realNat(n) + realNat(n)] = R[realNat(n) * realLog(realNat(n))] by ring
    rw e at ad
    rw ad at b
    have ep := realExp.positive at realNat(n)
    have aR : Real(realExp(R[realNat(n) * realLog(realNat(n)) - realNat(n)])) by typecheck
    have eR : Real(realExp(realNat(n))) by typecheck
    by_contra nl
    have lt : realNat(n!) < realExp(R[realNat(n) * realLog(realNat(n)) - realNat(n)]) by linarith
    have mm := realLess.mul_right_of_positive at realNat(n!), realExp(R[realNat(n) * realLog(realNat(n)) - realNat(n)]), realExp(realNat(n)) with lt, ep
    linarith

-- 2ʲ ≤ (j + 1)!.
theorem cldBMore.pow_two_le_factorial (j : Nat)
  shows R[2 ^ j] ≤ realNat(succ(j)!)
proof
  have cases := natural.zero_or_successor at j
  cases cases with zero | step
  . rw [zero, monoidPow.zero]
    exact realNat.factorial_ge_one at succ((0:N))
  obtain ⟨k, kNat, shape⟩ := step
  rw shape
  exact realNat.factorial_power_bound at k

-- (1/2)ʲ 2ʲ = 1.
theorem cldBMore.half_pow_mul (j : Nat)
  shows R[(1 / 2) ^ j * 2 ^ j] = R[1]
proof
  induction j
  | zero =>
    rw [monoidPow.zero, monoidPow.zero]
    ring
  | succ(i) using ih =>
    have twoNonzero : R[2] ≠ R[0] by linarith
    have cancel := realDiv.mul_right at R[1], R[2] with twoNonzero
    rw [monoidPow.succ, monoidPow.succ]
    have halfR : R[1 / 2] ∈ ℝ by typecheck
    have p1 := realPow.real at R[1 / 2], i
    unfold realPow at p1
    have p2 := realPow.real at R[2], i
    unfold realPow at p2
    have regroup : R[(1 / 2 * (1 / 2) ^ i) * (2 * 2 ^ i)] =
      R[((1 / 2) * 2) * ((1 / 2) ^ i * 2 ^ i)] by ring
    rw [regroup, cancel, ih]
    ring

-- (A B)ⁿ = Aⁿ Bⁿ in ℝ.
theorem cldBMore.mul_pow (A B : Real, n : Nat)
  shows R[(A * B) ^ n] = R[A ^ n * B ^ n]
proof
  induction n
  | zero =>
    rw [monoidPow.zero, monoidPow.zero, monoidPow.zero]
    ring
  | succ(k) using ih =>
    have p1 := realPow.real at A, k
    unfold realPow at p1
    have p2 := realPow.real at B, k
    unfold realPow at p2
    rw [monoidPow.succ, monoidPow.succ, monoidPow.succ, ih]
    ring

-- eᵀ ≤ (2 + T)/(2 − T) = 2/(1 − T/2) − 1 for 0 ≤ T < 2, by comparing
-- Tⁿ/n! with 2 (T/2)ⁿ termwise.
theorem cldBMore.exp_pade (T : Real)
  requires nonnegative : R[0] ≤ T
  requires small : T < R[2]
  shows realExp(T) ≤ R[2 * (1 / (1 - T * (1 / 2))) - 1 / (1 - 0)]
proof
  have halfR : R[1 / 2] ∈ ℝ by typecheck
  have twoNonzero : R[2] ≠ R[0] by linarith
  have cancel := realDiv.mul_right at R[1], R[2] with twoNonzero
  have qR : R[T * (1 / 2)] ∈ ℝ by typecheck
  have qTyped : Real(R[T * (1 / 2)]) by exact qR
  have halfPositive : R[0] < R[1 / 2]
    by_contra bad
    have le : R[1 / 2] ≤ R[0] by linarith
    have two : R[0] ≤ R[2] by linarith
    have scaled := realLe.mul_right_of_nonnegative with le, two
    have z : R[0 * 2] = R[0] by ring
    linarith
  have qNonnegative := realMulValue.nonnegative at T, R[1 / 2] with
    nonnegative, (realLess.implies_le with halfPositive)
  have qSmall : R[T * (1 / 2)] < R[1]
    have scaled := realLess.mul_right_of_positive with small, halfPositive
    linarith
  have absQ := abs.of_nonnegative at R[T * (1 / 2)] with qNonnegative
  have absSmallQ : abs(R[T * (1 / 2)]) < R[1] by linarith
  have zeroR : R[0] ∈ ℝ by typecheck
  have absZero := abs.of_nonnegative at R[0] with (realLe.reflexive at R[0])
  have absSmallZero : abs(R[0]) < R[1] by linarith
  have geometricQ := geometricSeries.sums_to at R[T * (1 / 2)] with absSmallQ
  have geometricZero := geometricSeries.sums_to at R[0] with absSmallZero
  unfold realSubValue at geometricQ
  unfold realSubValue at geometricZero
  have scaledQ := SumsTo.scale at geometricTerms(R[T * (1 / 2)]),
    R[1 / (1 - T * (1 / 2))], R[2] with geometricQ
  have difference := SumsTo.sub with scaledQ, geometricZero
  have sums := realExp.sums at T
  have seqQ := geometricTerms.sequence at R[T * (1 / 2)]
  have seqZero := geometricTerms.sequence at R[0]
  have seqTwo := constantSequence.sequence at R[2]
  have seqM := mulSequence.sequence with seqTwo, seqQ
  have pointwise : PointwiseLE(realExpTerms(T),
      subSequence(mulSequence(constantSequence(R[2]),
        geometricTerms(R[T * (1 / 2)])), geometricTerms(R[0])))
    intros n nIn
    have nNat := nat.omega.backward at n with nIn
    apply realLe.characterization.forward
    have gq := geometricTerms.value at R[T * (1 / 2)], n with nIn
    have gz := geometricTerms.value at R[0], n with nIn
    have pq := realPow.real at R[T * (1 / 2)], n
    have pz := realPow.real at R[0], n
    have c2 := constantSequence.value at R[2], n
    have gqR : Real(geometricTerms(R[T * (1 / 2)])(n))
      rw gq
      exact pq
    have gzR : Real(geometricTerms(R[0])(n))
      rw gz
      exact pz
    have c2R : Real(constantSequence(R[2])(n))
      rw c2
      typecheck
    have mv := mulSequence.value at constantSequence(R[2]),
      geometricTerms(R[T * (1 / 2)]), n with seqTwo, seqQ, c2R, gqR
    have mR : Real(mulSequence(constantSequence(R[2]),
        geometricTerms(R[T * (1 / 2)]))(n))
      rw [mv, c2, gq]
      unfold realPow
      have pq2 := pq
      unfold realPow at pq2
      typecheck
    have sv := subSequence.value at mulSequence(constantSequence(R[2]),
      geometricTerms(R[T * (1 / 2)])), geometricTerms(R[0]), n with seqM,
      seqZero, mR, gzR
    rw [sv, mv, c2, gq, gz, (realExpTerms.value at T, n with nIn)]
    unfold realPow
    have cases := natural.zero_or_successor at n
    cases cases with zero | step
    . rw [zero, monoidPow.zero, monoidPow.zero, monoidPow.zero]
      have f0 : (0:N)! = (1:N) by rw factorial
      rw [f0, realNat.one]
      have one : R[1] ≠ R[0] by linarith
      rw (realDiv.self with one)
      unfold realSubValue
      linarith
    obtain ⟨j, jNat, shape⟩ := step
    rw shape
    rw cldBMore.mul_pow
    have aR := realPow.real at T, succ(j)
    unfold realPow at aR
    have hR := realPow.real at R[1 / 2], j
    unfold realPow at hR
    have zR := realPow.real at R[0], j
    unfold realPow at zR
    have tR := realPow.real at R[2], j
    unfold realPow at tR
    have aN := realPow.nonnegative at T, succ(j) with nonnegative
    unfold realPow at aN
    have hN := realPow.nonnegative at R[1 / 2], j with
      (realLess.implies_le with halfPositive)
    unfold realPow at hN
    have big := cldBMore.pow_two_le_factorial at j
    have one := cldBMore.half_pow_mul at j
    have fPositive := realNat.factorial_pos at succ(j)
    have fNonzero : realNat(succ(j)!) ≠ R[0] by linarith
    have cancelF := realDiv.mul_right at R[T ^ succ(j)], realNat(succ(j)!)
      with fNonzero
    have s1 : R[(1 / 2) ^ succ(j)] = R[1 / 2 * (1 / 2) ^ j]
      rw monoidPow.succ
    have s0 : R[0 ^ succ(j)] = R[0]
      rw monoidPow.succ
      ring
    rw [s1, s0]
    have rhs : R[2 * (T ^ succ(j) * (1 / 2 * (1 / 2) ^ j)) - 0] =
        R[T ^ succ(j) * (1 / 2) ^ j]
      have e1 : R[2 * (T ^ succ(j) * (1 / 2 * (1 / 2) ^ j)) - 0] =
        R[((1 / 2) * 2) * (T ^ succ(j) * (1 / 2) ^ j)] by ring
      rw [e1, cancel]
      ring
    unfold realSubValue
    rw rhs
    have quotR : R[T ^ succ(j) / realNat(succ(j)!)] ∈ ℝ by typecheck
    have hBig := realLe.mul_left_of_nonnegative with big, hN
    have prodN := realMulValue.nonnegative at R[T ^ succ(j)], R[(1 / 2) ^ j]
      with aN, hN
    have scaled := realLe.mul_left_of_nonnegative with hBig, aN
    by_contra wrong
    have lt : R[T ^ succ(j) * (1 / 2) ^ j] < R[T ^ succ(j) / realNat(succ(j)!)]
      by linarith
    have mm := realLess.mul_right_of_positive with lt, fPositive
    have e2 : R[T ^ succ(j) * ((1 / 2) ^ j * realNat(succ(j)!))] =
      R[(T ^ succ(j) * (1 / 2) ^ j) * realNat(succ(j)!)] by ring
    have e3 : R[T ^ succ(j) * ((1 / 2) ^ j * 2 ^ j)] = R[T ^ succ(j)]
      rw one
      ring
    linarith
  have compared := SumsTo.le_of_le_terms with sums, difference, pointwise
  unfold realSubValue at compared
  exact compared

-- log(X + 1) − log X ≥ 2/(2X + 1) for X > 0.
theorem cldBMore.log_succ_lower (X : Real)
  requires positive : R[0] < X
  shows R[2 * (1 / (2 * X + 1))] ≤ R[realLog(R[X + 1]) - realLog(X)]
proof
  have dPositive : R[0] < R[2 * X + 1] by linarith
  have dNonzero : R[2 * X + 1] ≠ R[0] by linarith
  have xNonzero : X ≠ R[0] by linarith
  have twoNonzero : R[2] ≠ R[0] by linarith
  have cancelD := realDiv.mul_right at R[1], R[2 * X + 1] with dNonzero
  have cancel2 := realDiv.mul_right at R[1], R[2] with twoNonzero
  have invD : R[1 / (2 * X + 1)] ∈ ℝ by typecheck
  have invPositive : R[0] < R[1 / (2 * X + 1)]
    by_contra bad
    have le : R[1 / (2 * X + 1)] ≤ R[0] by linarith
    have scaled := realLe.mul_right_of_nonnegative with le,
      (realLess.implies_le with dPositive)
    have z : R[0 * (2 * X + 1)] = R[0] by ring
    linarith
  have tNonnegative : R[0] ≤ R[2 * (1 / (2 * X + 1))] by linarith
  have invBelow : R[1 / (2 * X + 1)] < R[1]
    by_contra bad
    have le : R[1] ≤ R[1 / (2 * X + 1)] by linarith
    have scaled := realLe.mul_right_of_nonnegative with le,
      (realLess.implies_le with dPositive)
    have e : R[1 * (2 * X + 1)] = R[2 * X + 1] by ring
    linarith
  have tSmall : R[2 * (1 / (2 * X + 1))] < R[2] by linarith
  have bound := cldBMore.exp_pade at R[2 * (1 / (2 * X + 1))] with
    tNonnegative, tSmall
  have uEq : R[1 - 2 * (1 / (2 * X + 1)) * (1 / 2)] =
      R[1 - 1 / (2 * X + 1)]
    have e : R[2 * (1 / (2 * X + 1)) * (1 / 2)] =
      R[((1 / 2) * 2) * (1 / (2 * X + 1))] by ring
    rw [e, cancel2]
    ring
  rw uEq at bound
  have one10 : R[1 - 0] = R[1] by ring
  rw one10 at bound
  have oneNonzero : R[1] ≠ R[0] by linarith
  rw (realDiv.self with oneNonzero) at bound
  have uPositive : R[0] < R[1 - 1 / (2 * X + 1)] by linarith
  have uNonzero : R[1 - 1 / (2 * X + 1)] ≠ R[0] by linarith
  have cancelU := realDiv.mul_right at R[1], R[1 - 1 / (2 * X + 1)] with
    uNonzero
  have uD : R[(1 - 1 / (2 * X + 1)) * (2 * X + 1)] = R[2 * X]
    have e : R[(1 - 1 / (2 * X + 1)) * (2 * X + 1)] =
      R[(2 * X + 1) - (1 / (2 * X + 1)) * (2 * X + 1)] by ring
    rw [e, cancelD]
    ring
  have vR : R[1 / (1 - 1 / (2 * X + 1))] ∈ ℝ by typecheck
  have v2X : R[(1 / (1 - 1 / (2 * X + 1))) * (2 * X)] = R[2 * X + 1]
    have e : R[(1 / (1 - 1 / (2 * X + 1))) * ((1 - 1 / (2 * X + 1)) *
      (2 * X + 1))] = R[((1 / (1 - 1 / (2 * X + 1))) * (1 - 1 / (2 * X + 1)))
      * (2 * X + 1)] by ring
    rw [cancelU, uD] at e
    have f : R[1 * (2 * X + 1)] = R[2 * X + 1] by ring
    rw f at e
    exact e
  have wR : R[(X + 1) / X] ∈ ℝ by typecheck
  have cancelX := realDiv.mul_right at R[X + 1], X with xNonzero
  have rhsLe : R[2 * (1 / (1 - 1 / (2 * X + 1))) - 1] ≤ R[(X + 1) / X]
    by_contra bad
    have lt : R[(X + 1) / X] < R[2 * (1 / (1 - 1 / (2 * X + 1))) - 1]
      by linarith
    have mm := realLess.mul_right_of_positive with lt, positive
    have e : R[(2 * (1 / (1 - 1 / (2 * X + 1))) - 1) * X] =
      R[(1 / (1 - 1 / (2 * X + 1))) * (2 * X) - X] by ring
    rw [e, v2X, cancelX] at mm
    linarith
  have wPositive : R[0] < R[(X + 1) / X]
    by_contra bad
    have le : R[(X + 1) / X] ≤ R[0] by linarith
    have scaled := realLe.mul_right_of_nonnegative with le,
      (realLess.implies_le with positive)
    rw cancelX at scaled
    have z : R[0 * X] = R[0] by ring
    linarith
  have expLe : realExp(R[2 * (1 / (2 * X + 1))]) ≤ R[(X + 1) / X] by
    linarith
  have expPositive := realExp.positive at R[2 * (1 / (2 * X + 1))]
  have logs := (realLog.le_iff at realExp(R[2 * (1 / (2 * X + 1))]),
    R[(X + 1) / X] with expPositive, wPositive).backward with expLe
  have x1Positive : R[0] < R[X + 1] by linarith
  rw [realLog.of_exp, (realLog.div with x1Positive, positive)] at logs
  exact logs

-- The Stirling gap log n! − n log n + n − (log n)/2.
def cldBStirlingGap (n : Nat) : Real :=
  R[realLog(realNat(n!)) - realNat(n) * realLog(realNat(n)) + realNat(n) -
    realLog(realNat(n)) / 2]
proof
  unfold cldBStirlingGap
  have nR := realNat.real at n
  have fR := realNat.real at n!
  have l1 := realLog.real at realNat(n!)
  have l2 := realLog.real at realNat(n)
  typecheck

-- The gap does not increase from n ≥ 1 to n + 1.
theorem cldBStirlingGap.step (n : Nat)
  requires positive : 1 ≤ n
  shows cldBStirlingGap(succ(n)) ≤ cldBStirlingGap(n)
proof
  unfold cldBStirlingGap
  have xR := realNat.real at n
  have one := realNat.le_of_natural_le at (1:N), n with positive
  rw realNat.one at one
  have xPositive : R[0] < realNat(n) by linarith
  have x1Positive : R[0] < R[realNat(n) + 1] by linarith
  have fPositive := realNat.factorial_pos at n
  rw [realNat.factorial_successor, realNat.succ_add]
  rw (realLog.mul at R[realNat(n) + 1], realNat(n!) with x1Positive, fPositive)
  have lower := cldBMore.log_succ_lower at realNat(n) with xPositive
  have l0 := realLog.real at realNat(n)
  have l1 := realLog.real at R[realNat(n) + 1]
  have lf := realLog.real at realNat(n!)
  have dPositive : R[0] < R[2 * realNat(n) + 1] by linarith
  have dNonzero : R[2 * realNat(n) + 1] ≠ R[0] by linarith
  have cancelD := realDiv.mul_right at R[1], R[2 * realNat(n) + 1] with
    dNonzero
  have scaled := realLe.mul_right_of_nonnegative with lower,
    (realLess.implies_le with dPositive)
  have e1 : R[2 * (1 / (2 * realNat(n) + 1)) * (2 * realNat(n) + 1)] =
    R[2 * ((1 / (2 * realNat(n) + 1)) * (2 * realNat(n) + 1))] by ring
  rw [e1, cancelD] at scaled
  have e2 : R[(realLog(R[realNat(n) + 1]) - realLog(realNat(n))) *
      (2 * realNat(n) + 1)] =
    R[2 * (realNat(n) * realLog(R[realNat(n) + 1])) -
      2 * (realNat(n) * realLog(realNat(n))) + realLog(R[realNat(n) + 1]) -
      realLog(realNat(n))] by ring
  rw e2 at scaled
  have twoNonzero : R[2] ≠ R[0] by linarith
  have h0 := realDiv.mul_right at realLog(realNat(n)), R[2] with twoNonzero
  have h1 := realDiv.mul_right at realLog(R[realNat(n) + 1]), R[2] with
    twoNonzero
  have q0 : R[realLog(realNat(n)) / 2] ∈ ℝ by typecheck
  have q1 : R[realLog(R[realNat(n) + 1]) / 2] ∈ ℝ by typecheck
  have e3 : R[(realNat(n) + 1) * realLog(R[realNat(n) + 1])] =
    R[realNat(n) * realLog(R[realNat(n) + 1]) + realLog(R[realNat(n) + 1])]
    by ring
  rw e3
  linarith

theorem cldBStirlingGap.mono (m d : Nat)
  requires positive : 1 ≤ m
  shows cldBStirlingGap(d + m) ≤ cldBStirlingGap(m)
proof
  induction d
  | zero =>
    rw add.left_unit
    have r : cldBStirlingGap(m) ∈ ℝ by typecheck
    exact realLe.reflexive at cldBStirlingGap(m)
  | succ(k) using ih =>
    rw add
    have large : 1 ≤ k + m by arith
    have step := cldBStirlingGap.step at k + m with large
    have r1 : cldBStirlingGap(succ(k + m)) ∈ ℝ by typecheck
    have r2 : cldBStirlingGap(k + m) ∈ ℝ by typecheck
    have r3 : cldBStirlingGap(m) ∈ ℝ by typecheck
    linarith

theorem cldBStirlingGap.one
  shows cldBStirlingGap(1) = R[1]
proof
  unfold cldBStirlingGap
  have f1 : (1:N)! = (1:N) by simp [factorial]
  rw [f1, realNat.one, realLog.one]
  have z : R[0 / 2] = R[0]
    have twoR : R[2] ∈ ℝ by typecheck
    exact realDiv.zero_left at R[2]
  rw z
  ring

-- log stirlingSeq(n) = gap(n) − (log 2)/2 for n ≥ 1.
theorem cldBStirlingSeq.log (n : Nat)
  requires positive : 1 ≤ n
  shows R[0] < stirlingSeq(n) ∧
    realLog(stirlingSeq(n)) = R[cldBStirlingGap(n) - realLog(R[2]) / 2]
proof
  have xR := realNat.real at n
  have one := realNat.le_of_natural_le at (1:N), n with positive
  rw realNat.one at one
  have xPositive : R[0] < realNat(n) by linarith
  have twoX : R[0] < R[2 * realNat(n)] by linarith
  have twoPositive : R[0] < R[2] by linarith
  have fPositive := realNat.factorial_pos at n
  have sPositive := realSqrt.positive at R[2 * realNat(n)] with twoX
  have ePositive := realExp.positive at
    R[realNat(n) * realLog(realNat(n)) - realNat(n)]
  have pPositive := realMulValue.positive at realSqrt(R[2 * realNat(n)]),
    realExp(R[realNat(n) * realLog(realNat(n)) - realNat(n)]) with sPositive,
    ePositive
  have pNonzero : R[realSqrt(R[2 * realNat(n)]) *
    realExp(R[realNat(n) * realLog(realNat(n)) - realNat(n)])] ≠ R[0] by
    linarith
  have cancel := realDiv.mul_right at realNat(n!), R[realSqrt(R[2 *
    realNat(n)]) * realExp(R[realNat(n) * realLog(realNat(n)) - realNat(n)])]
    with pNonzero
  have qPositive : R[0] < R[realNat(n!) / (realSqrt(R[2 * realNat(n)]) *
      realExp(R[realNat(n) * realLog(realNat(n)) - realNat(n)]))]
    by_contra bad
    have le : R[realNat(n!) / (realSqrt(R[2 * realNat(n)]) *
      realExp(R[realNat(n) * realLog(realNat(n)) - realNat(n)]))] ≤ R[0] by
      linarith
    have scaled := realLe.mul_right_of_nonnegative with le,
      (realLess.implies_le with pPositive)
    rw cancel at scaled
    have z : R[0 * (realSqrt(R[2 * realNat(n)]) *
      realExp(R[realNat(n) * realLog(realNat(n)) - realNat(n)]))] = R[0] by
      ring
    linarith
  unfold stirlingSeq
  refine ⟨qPositive, ?_⟩
  rw [(realLog.div with fPositive, pPositive), (realLog.mul with sPositive,
    ePositive), (realSqrt.log with twoX), realLog.of_exp,
    (realLog.mul with twoPositive, xPositive)]
  unfold cldBStirlingGap
  have twoNonzero : R[2] ≠ R[0] by linarith
  have l2 := realLog.real at R[2]
  have l0 := realLog.real at realNat(n)
  have lf := realLog.real at realNat(n!)
  have h0 := realDiv.mul_right at realLog(realNat(n)), R[2] with twoNonzero
  have h1 := realDiv.mul_right at realLog(R[2]), R[2] with twoNonzero
  have h2 := realDiv.mul_right at R[realLog(R[2]) + realLog(realNat(n))], R[2]
    with twoNonzero
  have q0 : R[realLog(realNat(n)) / 2] ∈ ℝ by typecheck
  have q1 : R[realLog(R[2]) / 2] ∈ ℝ by typecheck
  have q2 : R[(realLog(R[2]) + realLog(realNat(n))) / 2] ∈ ℝ by typecheck
  linarith

-- Stirling's upper bound in the form the source uses
-- (New/Endgame/ShortAndEnough.lean, from log_stirlingSeq'_antitone):
-- log n! ≤ n log n − n + 1 + (log n)/2 for n ≥ 1.
theorem factorial.log_upper (n : Nat)
  requires positive : 1 ≤ n
  shows realLog(realNat(n!)) ≤
    R[realNat(n) * realLog(realNat(n)) - realNat(n) + 1 + realLog(realNat(n)) / 2]
proof
  have le : (1:N) ≤ n by arith
  obtain ⟨d, dNat, shape⟩ := LessEqual.exists_add with le
  have oneLe : (1:N) ≤ (1:N) by arith
  have mono := cldBStirlingGap.mono at (1:N), d with oneLe
  have swap : d + (1:N) = n
    rw shape
    arith
  rw [swap, cldBStirlingGap.one] at mono
  unfold cldBStirlingGap at mono
  have nR := realNat.real at n
  have l0 := realLog.real at realNat(n)
  have lf := realLog.real at realNat(n!)
  have q0 : R[realLog(realNat(n)) / 2] ∈ ℝ by typecheck
  linarith

-- And the lower bound log n! ≥ n log n − n.
theorem factorial.log_lower (n : Nat)
  requires positive : 1 ≤ n
  shows R[realNat(n) * realLog(realNat(n)) - realNat(n)] ≤ realLog(realNat(n!))
proof
  have lp := factorial.lower_pow at n
  have fp := realNat.factorial_positive at n
  have ep := realExp.positive at R[realNat(n) * realLog(realNat(n)) - realNat(n)]
  have l := (realLog.le_iff at realExp(R[realNat(n) * realLog(realNat(n)) - realNat(n)]), realNat(n!) with ep, fp).backward with lp
  rw realLog.of_exp at l
  exact l

-- Mathlib's Stirling.stirlingSeq: decreasing from n = 1 and tending to √π.
theorem stirlingSeq.antitone (m n : Nat)
  requires positive : 1 ≤ m
  requires le : m ≤ n
  shows stirlingSeq(n) ≤ stirlingSeq(m)
proof
  have positiveN : 1 ≤ n by arith
  obtain ⟨d, dNat, shape⟩ := LessEqual.exists_add with le
  have mono := cldBStirlingGap.mono at m, d with positive
  have swap : d + m = n
    rw shape
    arith
  rw swap at mono
  obtain ⟨pm, lm⟩ := cldBStirlingSeq.log at m with positive
  obtain ⟨pn, ln⟩ := cldBStirlingSeq.log at n with positiveN
  have l2 := realLog.real at R[2]
  have q1 : R[realLog(R[2]) / 2] ∈ ℝ by typecheck
  have gm : cldBStirlingGap(m) ∈ ℝ by typecheck
  have gn : cldBStirlingGap(n) ∈ ℝ by typecheck
  have logs : realLog(stirlingSeq(n)) ≤ realLog(stirlingSeq(m)) by linarith
  exact (realLog.le_iff at stirlingSeq(n), stirlingSeq(m) with pn, pm).forward
    with logs

theorem stirlingSeq.limit (u : Set)
  requires function : u : ℕ → ℝ
  requires values : ∀ n ∈ ℕ, u(n) = stirlingSeq(n + 1)
  shows Tendsto(u, ℕ, natAtTop, nhds(realLine, realSqrt(realPi)))
proof
  sorry

theorem stirlingSeq.lower (n : Nat)
  requires positive : 1 ≤ n
  shows realSqrt(realPi) ≤ stirlingSeq(n)
proof
  sorry

-- Section: Harmonic numbers
theorem harmonicNumber.zero
  shows harmonicNumber(0) = R[0]
proof
  unfold harmonicNumber
  exact realPartialSum.zero at harmonicTerms

theorem harmonicNumber.succ (n : Nat)
  shows harmonicNumber(n + 1) = R[harmonicNumber(n) + 1 / (realNat(n) + 1)]
proof
  unfold harmonicNumber
  have v := harmonicTerms.value at n
  have nR := realNat.real at n
  have e : n + 1 = succ(n) by arith
  rw [e, realPartialSum.succ, v, realDiv.eq_mul_inv]
  have hR := realPartialSum.real at harmonicTerms, n with harmonicTerms.sequence
  have hRR : Real(realPartialSum(harmonicTerms, n)) by exact hR
  have iR := realInvValue.real at R[realNat(n) + 1]
  have one : R[1 * realInvValue(R[realNat(n) + 1])] = realInvValue(R[realNat(n) + 1]) by ring
  rw one
  simp [realAddValue, call2]

-- The recursion at a successor.
theorem harmonicNumber.succ_eq (k : Nat)
  shows harmonicNumber(succ(k)) = R[harmonicNumber(k) + 1 / (realNat(k) + 1)]
proof
  have e : k + 1 = succ(k) by arith
  have hs := harmonicNumber.succ at k
  rw e at hs
  exact hs

-- The upper bound from n = 1 on, indexed by k = n − 1.
theorem harmonicNumber.succ_le_log (k : Nat)
  shows harmonicNumber(succ(k)) ≤ R[1 + realLog(realNat(succ(k)))]
proof
  induction k
  | zero =>
    have hs := harmonicNumber.succ_eq at (0:N)
    rw [hs, harmonicNumber.zero, realNat.succ_add, realNat.zero]
    have z : R[0 + 1] = R[1] by ring
    rw [z, realLog.one, realDiv.eq_mul_inv, realInvValue.one]
    have r : R[0 + 1 * 1] = R[1] by ring
    rw r
    linarith
  | succ(j) using ih =>
    have hs := harmonicNumber.succ_eq at succ(j)
    rw hs
    have jR := realNat.real at succ(j)
    have jP := realNat.positive_succ at j
    have s1 : R[0] < R[realNat(succ(j)) + 1] by linarith
    have b := realLog.increment_bounds at realNat(succ(j)), R[1] with jP, s1
    have lo := b.left
    have l1 := realLog.real at realNat(succ(j))
    have l1R : Real(realLog(realNat(succ(j)))) by exact l1
    have l2 := realLog.real at R[realNat(succ(j)) + 1]
    have l2R : Real(realLog(R[realNat(succ(j)) + 1])) by exact l2
    have qR := realDiv.real at R[1], R[realNat(succ(j)) + 1]
    have m : R[1 * (1 / (realNat(succ(j)) + 1))] = R[1 / (realNat(succ(j)) + 1)] by ring
    rw m at lo
    rw (realNat.succ_add at succ(j))
    linarith

-- Mathlib's harmonic_le_one_add_log and log_add_one_le_harmonic.
theorem harmonicNumber.le_one_add_log (n : Nat)
  requires positive : 1 ≤ n
  shows harmonicNumber(n) ≤ R[1 + realLog(realNat(n))]
proof
  have p0 : 0 < n by arith
  have pc := predecessor.closed at n
  have pe := predecessor.add_one_of_positive at n with p0
  have e : predecessor(n) + 1 = succ(predecessor(n)) by arith
  rw e at pe
  rw ← pe
  exact harmonicNumber.succ_le_log at predecessor(n)

theorem harmonicNumber.log_le (n : Nat)
  shows realLog(R[realNat(n) + 1]) ≤ harmonicNumber(n)
proof
  induction n
  | zero =>
    have z : R[realNat(0) + 1] = R[1]
      rw realNat.zero
      ring
    rw [z, realLog.one, harmonicNumber.zero]
    linarith
  | succ(k) using ih =>
    have e : k + 1 = succ(k) by arith
    have hs := harmonicNumber.succ at k
    rw e at hs
    rw hs
    have kR := realNat.real at k
    have kN := realNat.zero_le at k
    have p1 : R[0] < R[realNat(k) + 1] by linarith
    have p2 : R[0] < R[realNat(k) + 1 + 1] by linarith
    have b := realLog.increment_bounds at R[realNat(k) + 1], R[1] with p1, p2
    have hi := b.right
    have l1 := realLog.real at R[realNat(k) + 1]
    have l1R : Real(realLog(R[realNat(k) + 1])) by exact l1
    have l2 := realLog.real at R[realNat(k) + 1 + 1]
    have l2R : Real(realLog(R[realNat(k) + 1 + 1])) by exact l2
    have qR := realDiv.real at R[1], R[realNat(k) + 1]
    have m : R[1 * (1 / (realNat(k) + 1))] = R[1 / (realNat(k) + 1)] by ring
    rw m at hi
    rw (realNat.succ_add at k)
    linarith

-- Mathlib's harmonic_floor_le_one_add_log: H_⌊x⌋ ≤ 1 + log x for x ≥ 1.
theorem harmonicNumber.floor_le (X : Real)
  requires large : R[1] ≤ X
  shows harmonicNumber(realFloor(X)) ≤ R[1 + realLog(X)]
proof
  have xNn : R[0] ≤ X by linarith
  have mN := realFloor.natural at X with xNn
  have lo := realFloor.le at X with xNn
  have hi := realFloor.lt at X with xNn
  have mR := realNat.real at realFloor(X)
  have ne : realFloor(X) ≠ (0:N)
    intro bad
    rw [bad, realNat.zero] at hi
    linarith
  have p0 := (Less.positive_iff at realFloor(X)).backward with ne
  have one : 1 ≤ realFloor(X) by arith
  have hb := harmonicNumber.le_one_add_log at realFloor(X) with one
  have mp := realNat.positive at realFloor(X) with ne
  have xp : R[0] < X by linarith
  have lm := (realLog.le_iff at realNat(realFloor(X)), X with mp, xp).backward with lo
  have l1 := realLog.real at realNat(realFloor(X))
  have l1R : Real(realLog(realNat(realFloor(X)))) by exact l1
  have l2 := realLog.real at X
  have l2R : Real(realLog(X)) by exact l2
  linarith

-- Mathlib's harmonic_eq_sum_Icc: Hₙ = Σ_{1 ≤ k ≤ n} 1/k.
theorem harmonicNumber.eq_sum (n : Nat, u : Set)
  requires values : ∀ k ∈ ℕ, u(k) = R[1 / realNat(k)]
  requires function : u : ℕ → ℝ
  shows harmonicNumber(n) = realPartialSum(shiftedRealSequence(u, 1), n)
proof
  have seq : RealSequence(u) by exact function
  induction n
  | zero =>
    rw [harmonicNumber.zero, realPartialSum.zero]
  | succ(k) using ih =>
    rw [harmonicNumber.succ_eq, realPartialSum.succ, ih]
    have sv := shiftedRealSequence.value at u, (1:N), k with seq
    rw sv
    have e : (1:N) + k = succ(k) by arith
    rw e
    have kIn : succ(k) ∈ ℕ by typecheck
    rw (values with succ(k), kIn)
    rw realNat.succ_add
    have sR := realPartialSum.real at shiftedRealSequence(u, (1:N)), k with (shiftedRealSequence.sequence at u, (1:N) with seq)
    have sRR : Real(realPartialSum(shiftedRealSequence(u, (1:N)), k)) by exact sR
    have kR := realNat.real at k
    have qR := realDiv.real at R[1], R[realNat(k) + 1]
    simp [realAddValue, call2]

-- Section: ζ(2) and ζ(4)
-- Mathlib's hasSum_zeta_two and hasSum_zeta_four: Σ_{n ≥ 1} 1/n² = π²/6 and
-- Σ_{n ≥ 1} 1/n⁴ = π⁴/90. The values of layer 1's ζ at 2 and 4 follow from
-- these through zeta.series (layer 2, track D).
theorem inverseSquares.hasSum
  shows RealHasSum(inverseSquares, ℕ, R[realPi * realPi / 6])
proof
  sorry

theorem inverseFourthPowers.hasSum
  shows RealHasSum(inverseFourthPowers, ℕ, R[realPi ^ 4 / 90])
proof
  sorry

theorem inverseSquares.sums_to
  shows SumsTo(inverseSquares, R[realPi * realPi / 6])
proof
  have sum := inverseSquares.hasSum
  have sequence : RealSequence(inverseSquares) by
    exact inverseSquares.function
  exact RealHasSum.sums_to with sequence, sum

-- 1/(a + 1)² ≤ 1/a − 1/(a + 1) for a ≥ 1.
theorem cldBReal.inv_sq_le (A : Real)
  requires large : R[1] ≤ A
  shows R[1 / ((A + 1) * (A + 1))] ≤ R[1 / A - 1 / (A + 1)]
proof
  have aPositive : R[0] < A by linarith
  have bPositive : R[0] < R[A + 1] by linarith
  have aNonzero : A ≠ R[0] by linarith
  have bNonzero : R[A + 1] ≠ R[0] by linarith
  have bbPositive := realMulValue.positive at R[A + 1], R[A + 1] with
    bPositive, bPositive
  have bbNonzero : R[(A + 1) * (A + 1)] ≠ R[0] by linarith
  have p := realDiv.mul_right at R[1], R[(A + 1) * (A + 1)] with bbNonzero
  have q := realDiv.mul_right at R[1], A with aNonzero
  have r := realDiv.mul_right at R[1], R[A + 1] with bNonzero
  have pR : R[1 / ((A + 1) * (A + 1))] ∈ ℝ by typecheck
  have qR : R[1 / A] ∈ ℝ by typecheck
  have rR : R[1 / (A + 1)] ∈ ℝ by typecheck
  have abbPositive := realMulValue.positive at A, R[(A + 1) * (A + 1)] with
    aPositive, bbPositive
  by_contra big
  have lt : R[1 / A - 1 / (A + 1)] < R[1 / ((A + 1) * (A + 1))] by linarith
  have scaled := realLess.mul_right_of_positive with lt, abbPositive
  have left : R[(1 / A - 1 / (A + 1)) * (A * ((A + 1) * (A + 1)))] =
      R[((1 / A) * A) * ((A + 1) * (A + 1)) - ((1 / (A + 1)) * (A + 1)) *
        (A * (A + 1))] by ring
  have right : R[(1 / ((A + 1) * (A + 1))) * (A * ((A + 1) * (A + 1)))] =
      R[((1 / ((A + 1) * (A + 1))) * ((A + 1) * (A + 1))) * A] by ring
  rw [left, right, p, q, r] at scaled
  have e1 : R[1 * ((A + 1) * (A + 1)) - 1 * (A * (A + 1))] = R[A + 1] by ring
  have e2 : R[1 * A] = A by ring
  rw [e1, e2] at scaled
  linarith

-- The partial sums of the tail stay below 1/(N − 1) − 1/(K + N − 1).
theorem cldBInverseSquares.partial (N K : Nat, u : Set)
  requires large : 2 ≤ N
  requires values : ∀ n ∈ ℕ, u(n) = R[1 / ((realNat(n) + realNat(N)) * (realNat(n) + realNat(N)))]
  requires function : u : ℕ → ℝ
  shows realPartialSum(u, K) ≤
    R[1 / (realNat(N) - 1) - 1 / (realNat(K) + realNat(N) - 1)]
proof
  induction K
  | zero =>
    rw [realPartialSum.zero, realNat.zero]
    have e : R[0 + realNat(N) - 1] = R[realNat(N) - 1] by ring
    rw e
    have dR : R[1 / (realNat(N) - 1)] ∈ ℝ by typecheck
    have z : R[1 / (realNat(N) - 1) - 1 / (realNat(N) - 1)] = R[0] by ring
    rw z
    exact realLe.reflexive at R[0]
  | succ(k) using ih =>
    have kR := realNat.real at k
    have kNonnegative := realNat.zero_le at k
    have kIn : k ∈ ℕ by typecheck
    have twoLe := realNat.le_of_natural_le at (2:N), N with large
    rw realNat.two at twoLe
    rw [realPartialSum.succ, (values with k, kIn), realNat.succ_add]
    have aLarge : R[1] ≤ R[realNat(k) + realNat(N) - 1] by linarith
    have step := cldBReal.inv_sq_le at R[realNat(k) + realNat(N) - 1] with
      aLarge
    have e : R[realNat(k) + realNat(N) - 1 + 1] = R[realNat(k) + realNat(N)]
      by ring
    rw e at step
    have e2 : R[realNat(k) + 1 + realNat(N) - 1] = R[realNat(k) + realNat(N)]
      by ring
    rw e2
    have sequence : RealSequence(u) by exact function
    have sR := realPartialSum.real at u, k with sequence
    have sRR : Real(realPartialSum(u, k)) by exact sR
    have aR : R[1 / (realNat(k) + realNat(N) - 1)] ∈ ℝ by typecheck
    have bR : R[1 / (realNat(k) + realNat(N))] ∈ ℝ by typecheck
    have cR : R[1 / ((realNat(k) + realNat(N)) * (realNat(k) + realNat(N)))]
      ∈ ℝ by typecheck
    have dR : R[1 / (realNat(N) - 1)] ∈ ℝ by typecheck
    linarith

-- The bound Σ_{n ≥ N} 1/n² ≤ 1/(N − 1) used for tails, N ≥ 2, in the form
-- Σ_{n ≥ 0} 1/(n + N)² ≤ 1/(N − 1).
theorem inverseSquares.tail (N : Nat, u : Set)
  requires large : 2 ≤ N
  requires values : ∀ n ∈ ℕ, u(n) = R[1 / ((realNat(n) + realNat(N)) * (realNat(n) + realNat(N)))]
  requires function : u : ℕ → ℝ
  shows RealSummable(u, ℕ) ∧ (realTsum(u, ℕ):R) ≤ R[1 / (realNat(N) - 1)]
proof
  have sequence : RealSequence(u) by exact function
  have twoLe := realNat.le_of_natural_le at (2:N), N with large
  rw realNat.two at twoLe
  have bR : R[1 / (realNat(N) - 1)] ∈ ℝ by typecheck
  have bTyped : Real(R[1 / (realNat(N) - 1)]) by exact bR
  have nonnegative : ∀ n ∈ ℕ, realZero ≤ u(n)
    intros n hn
    have nNat := nat.omega.backward with hn
    have nNonnegative := realNat.zero_le at n
    have dPositive : R[0] < R[realNat(n) + realNat(N)] by linarith
    have ddPositive := realMulValue.positive at R[realNat(n) + realNat(N)],
      R[realNat(n) + realNat(N)] with dPositive, dPositive
    have ddNonzero : R[(realNat(n) + realNat(N)) * (realNat(n) + realNat(N))]
      ≠ R[0] by linarith
    have cancel := realDiv.mul_right at R[1],
      R[(realNat(n) + realNat(N)) * (realNat(n) + realNat(N))] with ddNonzero
    rw (values with n, hn)
    by_contra negative
    have below : R[1 / ((realNat(n) + realNat(N)) * (realNat(n) + realNat(N)))]
      < R[0] by linarith
    have scaled := realLess.mul_right_of_positive with below, ddPositive
    have zero : R[0 * ((realNat(n) + realNat(N)) * (realNat(n) + realNat(N)))]
      = R[0] by ring
    linarith
  have terms : NonnegativeTerms(u)
    intros n hn
    apply realLe.characterization.forward
    exact nonnegative with n, hn
  have bounded : BoundedAboveBy(prefixSums(u), R[1 / (realNat(N) - 1)])
    intros n hn
    have nNat := nat.omega.backward with hn
    apply realLe.characterization.forward
    rw (prefixSums.value with sequence, hn)
    have partial := cldBInverseSquares.partial at N, n, u with large, values,
      function
    have nNonnegative := realNat.zero_le at n
    have dPositive : R[0] < R[realNat(n) + realNat(N) - 1] by linarith
    have dNonzero : R[realNat(n) + realNat(N) - 1] ≠ R[0] by linarith
    have cancel := realDiv.mul_right at R[1], R[realNat(n) + realNat(N) - 1]
      with dNonzero
    have invNonnegative : R[0] ≤ R[1 / (realNat(n) + realNat(N) - 1)]
      by_contra negative
      have below : R[1 / (realNat(n) + realNat(N) - 1)] < R[0] by linarith
      have scaled := realLess.mul_right_of_positive with below, dPositive
      have zero : R[0 * (realNat(n) + realNat(N) - 1)] = R[0] by ring
      linarith
    have sR := realPartialSum.real at u, n with sequence
    have sRR : Real(realPartialSum(u, n)) by exact sR
    linarith
  have prefixSequence := prefixSums.sequence with sequence
  have increasing := prefixSums.nondecreasing with sequence, terms
  have converges := boundedNondecreasingSequence.converges with
    prefixSequence, increasing, bounded
  have inhabited := RealSequence.range_nonempty with prefixSequence
  have rangeUpper := BoundedAboveBy.range_upper_bound with prefixSequence,
    bounded
  have least := realSup.least_upper_bound with inhabited, rangeUpper
  have supUpper : RealUpperBound(range(prefixSums(u)),
    realSup(range(prefixSums(u)))) by simp [RealLeastUpperBound]
  obtain ⟨supReal, _, _⟩ := supUpper
  have typedSup : Real(realSup(range(prefixSums(u)))) by exact supReal
  have below := ConvergesTo.le_constant with converges, bounded
  have sums : SumsTo(u, realSup(range(prefixSums(u))))
    unfold SumsTo
    exact ⟨sequence, converges⟩
  have has := RealHasSum.of_nonneg_sums_to with sequence, nonnegative, sums
  have tsum := RealHasSum.tsum_eq with has
  have sIn := RealHasSum.real with has
  refine ⟨?_, ?_⟩
  . unfold RealSummable
    unfold SummableFamily
    have carrier := realAdditiveGroup.carrier
    have sG : realSup(range(prefixSums(u))) ∈ Group.carrier(realAdditiveGroup)
      rw carrier
      exact sIn
    have hasG := has
    unfold RealHasSum at hasG
    exact ⟨realSup(range(prefixSums(u))), sG, hasG⟩
  . rw tsum
    exact below

end SpecialFunctions
