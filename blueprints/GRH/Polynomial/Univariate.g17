-- Polynomials in one variable over a commutative ring R, as Cumulus's
-- polynomialRing(R, {0}) with the variable X = X_0 (the representation of
-- GRH.Matrix.Spectral, whose polyCoeff and polyEval are the coefficient
-- and the value): the constants and monomials, the degree and the leading
-- coefficient, monic polynomials, evaluation along a ring homomorphism
-- and in an algebra (Mathlib's Polynomial.eval₂ and Polynomial.aeval),
-- composition, the coefficient map (Polynomial.map), the derivative,
-- division by a monic polynomial, roots and their multiplicities, the
-- factor theorem (Polynomial.dvd_iff_isRoot), and the bound on the number
-- of roots over a domain.
-- Part of the GRH blueprint.
-- Planned home: Algebra/Polynomial/Univariate.
-- Copyright (c) 2026 Grant Passmore.
-- Released under the Apache License 2.0. See LICENSE in the repository root.
-- Authors: Grant Passmore

module GRH.Polynomial.Univariate
import GRH.Matrix.Spectral
import GRH.Algebra.Divisibility
import Grace.Cumulus.Algebra.Polynomial.Algebra
import Grace.Cumulus.Algebra.Polynomial.Derivative
import Grace.Cumulus.Combinatorics.ErdosSzekeres

-- Section: Constants, the variable, monomials
-- R[X] is polynomialRing(R, {0}); a polynomial is a finitely supported map
-- from the exponent maps {0} → ℕ to R, and polyCoeff(p, k) = p({(0, k)}).
-- The constant a (Polynomial.C), the variable X, and the monomial a Xⁿ
-- (Polynomial.monomial).
def polyC (R a : Set) : Set := polynomialConstant(R, {0})(a)

def polyX (R : Set) : Set := X(R, {0}, 0)

def polyMonomial (R a : Set, n : Nat) : Set :=
  call2(Ring.mul(polynomialRing(R, {0})), polyC(R, a),
    Ring.pow(polynomialRing(R, {0}), polyX(R), n))

-- X − a (Polynomial.X_sub_C).
def polyXSubC (R a : Set) : Set :=
  Ring.sub(polynomialRing(R, {0}), polyX(R), polyC(R, a))

-- Helpers: univariate monomials are the sets {(0, k)}, k ∈ ℕ.
theorem uni.monomial_value (k : Nat)
  shows {(0, k)}(0) = k
proof
  have kN : k ∈ ℕ by typecheck
  have same := constantFunction.univariate at ℕ, k with kN
  have zero : 0 ∈ {0} by simp [singleton.membership]
  have v := constantFunction.apply at {0}, ℕ, 0, k with zero, kN
  rw same at v
  exact v

theorem uni.monomial_shape (m : Set)
  requires member : m ∈ monomials({0})
  shows Nat(m(0)) ∧ m = {(0, m(0))}
proof
  have zero : 0 ∈ {0} by simp [singleton.membership]
  have e := monomials.exponent at {0}, m, 0 with member, zero
  have single := monomials.univariate at m(0)
  have eq : m = {(0, m(0))}
    apply monomials.ext at {0}, m, {(0, m(0))} with member, single
    intros i hi
    rw singleton.membership at hi
    rw hi
    rw (uni.monomial_value at m(0))
  exact ⟨e, eq⟩

theorem uni.monomial_inj (j k : Nat)
  requires equal : {(0, j)} = {(0, k)}
  shows j = k
proof
  have a := uni.monomial_value at j
  have b := uni.monomial_value at k
  rw equal at a
  cc

theorem uni.monomial_mul (j k : Nat)
  shows monomialProduct({0}, {(0, j)}, {(0, k)}) = {(0, j + k)}
proof
  have mj := monomials.univariate at j
  have mk := monomials.univariate at k
  have mjk := monomials.univariate at j + k
  have prod := monomialProduct.member at {0}, {(0, j)}, {(0, k)} with mj, mk
  apply monomials.ext at {0}, monomialProduct({0}, {(0, j)}, {(0, k)}), {(0, j + k)} with prod, mjk
  intros i hi
  have v := monomialProduct.value at {0}, {(0, j)}, {(0, k)}, i with mj, mk, hi
  rw v
  rw singleton.membership at hi
  rw hi
  rw [(uni.monomial_value at j), (uni.monomial_value at k), (uni.monomial_value at j + k)]

theorem uni.coeff_mem (R p : Set) (k : Nat)
  requires comm : CommRing(R)
  requires member : p ∈ Ring.carrier(polynomialRing(R, {0}))
  shows polyCoeff(p, k) ∈ R.carrier
proof
  have pc := polynomialRing.comm_ring at R, {0} with comm
  have mk := monomials.univariate at k
  unfold polyCoeff
  exact polynomialRing.coefficient_mem at R, {0}, p, {(0, k)} with comm, pc, member, mk

theorem uni.degrees_finite (R p : Set)
  requires comm : CommRing(R)
  requires member : p ∈ Ring.carrier(polynomialRing(R, {0}))
  shows Finite(polyDegrees(R, p)) ∧ polyDegrees(R, p) ⊆ ℕ
proof
  have pc := polynomialRing.comm_ring at R, {0} with comm
  have parts := polynomialRing.member_parts at R, {0}, p with comm, pc, member
  have finite := polynomials.finite_support with parts
  have domain := functionSupport.subset at p, monomials({0}), R.zero
  have zero : 0 ∈ {0} by simp [singleton.membership]
  have exponents := monomialExponent.function at {0}, 0 with zero
  have imageFinite := Finite.function_image with exponents, finite, domain
  have sub : polyDegrees(R, p) ⊆ functionImage(monomialExponent({0}, 0), functionSupport(p, monomials({0}), R.zero), ℕ)
    intros k hk
    unfold polyDegrees at hk
    obtain ⟨kN, nz⟩ := hk
    have kNat := nat.omega.backward with kN
    have mk := monomials.univariate at k
    have supp : {(0, k)} ∈ functionSupport(p, monomials({0}), R.zero)
      exact functionSupport.membership.backward with ⟨mk, nz⟩
    have ev := monomialExponent.value at {0}, 0, {(0, k)} with zero, mk
    rw (uni.monomial_value at k) at ev
    apply functionImage.membership.backward
    refine ⟨kN, {(0, k)}, supp, ?_⟩
    rw ev
  have nat : polyDegrees(R, p) ⊆ ℕ
    intros k hk
    unfold polyDegrees at hk
    exact hk.left
  have fs := Finite.subset with imageFinite, sub
  exact ⟨fs, nat⟩

-- Section: Degree and leading coefficient
-- The natural degree: the largest k with a nonzero coefficient, and 0 for
-- the zero polynomial (Polynomial.natDegree).
defunique polyNatDegree (R p : Set) (d ∈ ℕ) :=
  (polyDegrees(R, p) = ∅ ∧ d = 0) ∨
  (d ∈ polyDegrees(R, p) ∧ (∀ k ∈ polyDegrees(R, p), k ≤ d))
requires ring : CommRing(R)
requires member : p ∈ Ring.carrier(polynomialRing(R, {0}))
proof
  have fin := uni.degrees_finite at R, p with ring, member
  obtain ⟨finite, naturals⟩ := fin
  by_cases empty : polyDegrees(R, p) = ∅
  . witness 0
    have zN : (0:Nat) ∈ ℕ by typecheck
    refine ⟨zN, ?_⟩
    left
    exact ⟨empty, rfl⟩
  . have inhabited := Nonempty.of_ne_empty with empty
    obtain ⟨n, nN, nIn, below⟩ := Finite.greatest_natural with inhabited, naturals, finite
    witness n
    refine ⟨nN, ?_⟩
    right
    refine ⟨nIn, ?_⟩
    intros k hk
    have nNat := nat.omega.backward with nN
    have kNat := nat.omega.backward with (naturals with k, hk)
    have kIn := below with k, hk
    have kLess := Less.of_membership at k, succ(n)
    have lt := kLess with kIn
    exact Less.successor_upper with lt
uniqueness
  intros u hu first v hv second
  have uNat := nat.omega.backward with hu
  have vNat := nat.omega.backward with hv
  cases first with fe | fm
  . cases second with se | sm
    . have a := fe.right
      have b := se.right
      cc
    . have e := fe.left
      have m := sm.left
      rw e at m
      have no := empty.membership at v
      exfalso
      exact no with m
  . cases second with se | sm
    . have e := se.left
      have m := fm.left
      rw e at m
      have no := empty.membership at u
      exfalso
      exact no with m
    . have a := fm.right with v, sm.left
      have b := sm.right with u, fm.left
      exact LessEqual.antisymmetric with b, a

-- The leading coefficient (Polynomial.leadingCoeff) and monic polynomials
-- (Polynomial.Monic).
def polyLeadingCoeff (R p : Set) : Set := p({(0, polyNatDegree(R, p))})

predicate PolyMonic (R p : Set) :=
  p ∈ Ring.carrier(polynomialRing(R, {0})) ∧ polyLeadingCoeff(R, p) = Ring.one(R)

-- p has degree at most n: every coefficient beyond n vanishes
-- (Polynomial.degree_le, natDegree_le_iff_coeff_eq_zero), and the
-- polynomials of degree below n (Polynomial.degreeLT).
predicate PolyDegreeLE (R p : Set, n : Nat) :=
  p ∈ Ring.carrier(polynomialRing(R, {0})) ∧ (∀ k ∈ polyDegrees(R, p), k ≤ n)

def polyDegreeLT (R : Set, n : Nat) : Set :=
  { p ∈ Ring.carrier(polynomialRing(R, {0})) | ∀ k ∈ polyDegrees(R, p), k < n }

-- Section: Evaluation, composition, coefficient maps
-- Evaluation along f : R →+* S at x ∈ S (Polynomial.eval₂), in an
-- R-algebra A at x ∈ A (Polynomial.aeval), and the composition p(q)
-- (Polynomial.comp).
def polyEval2 (R S f x p : Set) : Set :=
  evaluationHom(R, S, {0}, f, constantFunction({0}, Ring.carrier(S), x))(p)

def polyAeval (A x p : Set) : Set :=
  polyEval2(Algebra.base(A), Algebra.ring(A), Algebra.map(A), x, p)

-- The evaluation homomorphism R[X] → A at x (Polynomial.aeval as an
-- algebra homomorphism).
def polyAevalHom (A x : Set) : Set :=
  evaluationHom(Algebra.base(A), Algebra.ring(A), {0}, Algebra.map(A),
    constantFunction({0}, algebraCarrier(A), x))

def polyComp (R p q : Set) : Set :=
  polyEval2(R, polynomialRing(R, {0}), polynomialConstant(R, {0}), q, p)

-- The coefficientwise image under f : R → S (Polynomial.map).
def polyMap (R S f : Set) : Set :=
  polynomialMap({0}, Ring.carrier(R), Ring.zero(R), Ring.carrier(S),
    Ring.zero(S), f)

-- Roots: p(a) = 0 (Polynomial.IsRoot), the roots of p in R, and the roots
-- of p in an R-algebra A (Polynomial.rootSet, the support of
-- Polynomial.aroots).
predicate PolyIsRoot (R p a : Set) :=
  a ∈ Ring.carrier(R) ∧ polyEval(R, p, a) = Ring.zero(R)

def polyRootSet (R p : Set) : Set :=
  { a ∈ Ring.carrier(R) | polyEval(R, p, a) = Ring.zero(R) }

def polyAlgebraRootSet (A p : Set) : Set :=
  { a ∈ algebraCarrier(A) | polyAeval(A, a, p) = Ring.zero(Algebra.ring(A)) }

-- The derivative d/dX (Polynomial.derivative).
def polyDerivative (R : Set) : Set := partialDerivative(R, {0}, 0)

-- The product Π_{i ∈ n} (X − a(i)) of linear factors (Finset.prod of
-- Polynomial.X_sub_C).
defgraph linearFactorFamily (R a n : Set) (i ∈ n) :
    Ring.carrier(polynomialRing(R, {0})) :=
  polyXSubC(R, a(i))
requires ring : CommRing(R)
requires points : a : n → Ring.carrier(R)
proof
  have ai := FunctionBetween.apply_closed with points, member
  have pc := polynomialRing.comm_ring at R, {0} with ring
  have pr := CommRing.to_ring with pc
  have xIn := X.mem at R, {0}, 0 with ring
  have cIn := polynomialConstant.mem at R, {0}, a(i) with ring, ai
  unfold polyXSubC
  unfold polyX
  unfold polyC
  exact Ring.sub_mem with *

def polyLinearProduct (R a n : Set) : Set :=
  finiteRingProduct(n, Ring.carrier(polynomialRing(R, {0})),
    Ring.add(polynomialRing(R, {0})), Ring.zero(polynomialRing(R, {0})),
    Ring.neg(polynomialRing(R, {0})), Ring.mul(polynomialRing(R, {0})),
    Ring.one(polynomialRing(R, {0})), linearFactorFamily(R, a, n))

-- Families used to write sums: the pairs (i, j) with i + j = k, the terms
-- pᵢ q_j of the k-th coefficient of a product, the monomials pᵢ Xⁱ of p,
-- the terms pᵢ bⁱ of its value at b and f(pᵢ) xⁱ of its value in an
-- algebra, the values of a family of polynomials, and the factors
-- (X − a(i))^{m(i)} at distinct roots.
def antidiagonal (k : Nat) : Set :=
  { t ∈ ℕ × ℕ | ∃ i ∈ ℕ, ∃ j ∈ ℕ, t = (i, j) ∧ i + j = k }

def polyProductTerms (R p q : Set, k : Nat) : Set :=
  { u ∈ antidiagonal(k) × Ring.carrier(R) | ∃ i ∈ ℕ, ∃ j ∈ ℕ,
    u = ((i, j), call2(Ring.mul(R), p({(0, i)}), q({(0, j)}))) }

def polyMonomialTerms (R p : Set) : Set :=
  { u ∈ ℕ × Ring.carrier(polynomialRing(R, {0})) | ∃ i ∈ ℕ,
    u = (i, polyMonomial(R, p({(0, i)}), i)) }

def polyValueTerms (R p b : Set) : Set :=
  { u ∈ ℕ × Ring.carrier(R) | ∃ i ∈ ℕ,
    u = (i, call2(Ring.mul(R), p({(0, i)}), Ring.pow(R, b, i))) }

def aevalTerms (A x p : Set) : Set :=
  { u ∈ ℕ × algebraCarrier(A) | ∃ i ∈ ℕ, u = (i,
    call2(Ring.mul(Algebra.ring(A)), Algebra.map(A)(p({(0, i)})),
      Ring.pow(Algebra.ring(A), x, i))) }

def polyFamilyValues (R n w b : Set) : Set :=
  { u ∈ n × Ring.carrier(R) | ∃ i ∈ n, u = (i, polyEval(R, w(i), b)) }

-- Helpers: the antidiagonal {(i, j) | i + j = k} is finite, and the map
-- (i, j) ↦ ({(0, i)}, {(0, j)}) on it is injective.
def tkJAntidiagonalMonomials (k : Nat) : Set :=
  { u ∈ antidiagonal(k) × (monomials({0}) × monomials({0})) | ∃ i ∈ ℕ, ∃ j ∈ ℕ,
    u = ((i, j), ({(0, i)}, {(0, j)})) }

theorem tkJ.uni_graph_function (G A B : Set)
  requires bounded : ∀ u ∈ G, u ∈ A × B
  requires single : ∀ x, ∀ y, ∀ z, (x, y) ∈ G → (x, z) ∈ G → y = z
  requires total : ∀ x ∈ A, ∃ y ∈ B, (x, y) ∈ G
  shows G : A → B
proof
  constructor
    intros q mem
    exact bounded with q, mem
  . constructor
      intros x y hy z hz
      unfold relates at hy
      unfold relates at hz
      exact single with x, y, z, hy, hz
    . intros x hx
      obtain ⟨y, yIn, rel⟩ := total with x, hx
      refine ⟨y, yIn, ?_⟩
      unfold relates
      exact rel

theorem tkJ.antidiagonal_pair (k i j : Nat)
  shows (i, j) ∈ antidiagonal(k) ↔ i + j = k
proof
  have iN : i ∈ ℕ by typecheck
  have jN : j ∈ ℕ by typecheck
  constructor
  . intro h
    obtain ⟨_, a, aIn, b, bIn, e, s⟩ := antidiagonal.membership.forward with h
    obtain ⟨ia, jb⟩ := orderedPair.injective with e
    rw [ia, jb]
    exact s
  . intro h
    apply antidiagonal.membership.backward
    refine ⟨(product.pair with iN, jN), i, iN, j, jN, rfl, h⟩

theorem tkJ.antidiagonal_finite (k : Nat)
  shows Finite(antidiagonal(k))
proof
  have sub : antidiagonal(k) ⊆ succ(k) × succ(k)
    intros t ht
    obtain ⟨_, i, iN, j, jN, e, s⟩ := antidiagonal.membership.forward with ht
    have iNat := nat.omega.backward with iN
    have jNat := nat.omega.backward with jN
    have il : i ≤ k by arith
    have jl : j ≤ k by arith
    have im := membership.successor_of_LessEqual at i, k with il
    have jm := membership.successor_of_LessEqual at j, k with jl
    rw e
    exact product.pair with im, jm
  have fk := Finite.natural at succ(k)
  have fp := Finite.product with fk, fk
  exact Finite.subset with fp, sub

theorem tkJ.antidiagonal_monomials (k : Nat)
  shows (tkJAntidiagonalMonomials(k) : antidiagonal(k) →
      monomials({0}) × monomials({0})) ∧
    (∀ i ∈ ℕ, ∀ j ∈ ℕ, i + j = k →
      tkJAntidiagonalMonomials(k)((i, j)) = ({(0, i)}, {(0, j)})) ∧
    (∀ x ∈ antidiagonal(k), ∀ y ∈ antidiagonal(k),
      tkJAntidiagonalMonomials(k)(x) = tkJAntidiagonalMonomials(k)(y) → x = y)
proof
  have rel : ∀ i ∈ ℕ, ∀ j ∈ ℕ, i + j = k → ((i, j), ({(0, i)}, {(0, j)})) ∈ tkJAntidiagonalMonomials(k) ∧ (i, j) ∈ antidiagonal(k)
    intros i iN j jN s
    have iNat := nat.omega.backward with iN
    have jNat := nat.omega.backward with jN
    have mi := monomials.univariate at i
    have mj := monomials.univariate at j
    have v := product.pair with mi, mj
    have ad := (tkJ.antidiagonal_pair at k, i, j).backward with s
    have m : ((i, j), ({(0, i)}, {(0, j)})) ∈ tkJAntidiagonalMonomials(k)
      apply tkJAntidiagonalMonomials.membership.backward
      refine ⟨(product.pair with ad, v), i, iN, j, jN, rfl⟩
    exact ⟨m, ad⟩
  have fn : tkJAntidiagonalMonomials(k) : antidiagonal(k) → monomials({0}) × monomials({0})
    apply tkJ.uni_graph_function
    . intros u hu
      exact (tkJAntidiagonalMonomials.membership.forward with hu).left
    . intros x y z hy hz
      obtain ⟨_, a, aIn, b, bIn, ea⟩ := tkJAntidiagonalMonomials.membership.forward with hy
      obtain ⟨_, c, cIn, d, dIn, eb⟩ := tkJAntidiagonalMonomials.membership.forward with hz
      obtain ⟨xa, ya⟩ := orderedPair.injective with ea
      obtain ⟨xb, yb⟩ := orderedPair.injective with eb
      have same : (a, b) = (c, d) by cc
      obtain ⟨ac, bd⟩ := orderedPair.injective with same
      rw [ya, yb, ac, bd]
    . intros x hx
      obtain ⟨_, i, iN, j, jN, e, s⟩ := antidiagonal.membership.forward with hx
      obtain ⟨m, ad⟩ := rel with i, iN, j, jN, s
      have iNat := nat.omega.backward with iN
      have jNat := nat.omega.backward with jN
      have mi := monomials.univariate at i
      have mj := monomials.univariate at j
      have v := product.pair with mi, mj
      rw e
      exact ⟨({(0, i)}, {(0, j)}), v, m⟩
  have values : ∀ i ∈ ℕ, ∀ j ∈ ℕ, i + j = k → tkJAntidiagonalMonomials(k)((i, j)) = ({(0, i)}, {(0, j)})
    intros i iN j jN s
    obtain ⟨m, ad⟩ := rel with i, iN, j, jN, s
    exact FunctionBetween.apply_value with fn, ad, m
  refine ⟨fn, values, ?_⟩
  intros x hx y hy e
  obtain ⟨_, i, iN, j, jN, ex, sx⟩ := antidiagonal.membership.forward with hx
  obtain ⟨_, a, aN, b, bN, ey, sy⟩ := antidiagonal.membership.forward with hy
  have iNat := nat.omega.backward with iN
  have jNat := nat.omega.backward with jN
  have aNat := nat.omega.backward with aN
  have bNat := nat.omega.backward with bN
  have vx := values with i, iN, j, jN, sx
  have vy := values with a, aN, b, bN, sy
  rw [ex, ey] at e
  rw [vx, vy] at e
  obtain ⟨e1, e2⟩ := orderedPair.injective with e
  have ia := uni.monomial_inj at i, a with e1
  have jb := uni.monomial_inj at j, b with e2
  rw [ex, ey, ia, jb]

-- Section: Laws
section Laws
variable (R : Set)
hypothesis comm : CommRing(R)
hypothesis polys : CommRing(polynomialRing(R, {0}))

-- Helpers: terms a·X^n as sparse polynomials and their coefficients.
theorem uni.term_coeff (a : R) (n k : Nat)
  shows (k = n → polyCoeff(polynomialTerm({0}, R.carrier, R.zero, a, {(0, n)}), k) = a) ∧
    (k ≠ n → polyCoeff(polynomialTerm({0}, R.carrier, R.zero, a, {(0, n)}), k) = R[0])
proof
  have zeroIn : R.zero ∈ R.carrier by typecheck
  have aIn : a ∈ R.carrier by typecheck
  have mn := monomials.univariate at n
  have mk := monomials.univariate at k
  unfold polyCoeff
  constructor
  . intro e
    rw e
    exact polynomialTerm.same at {0}, R.carrier, R.zero, a, {(0, n)} with zeroIn, aIn, mn
  . intro ne
    have diff : {(0, k)} ≠ {(0, n)}
      intro eq
      apply ne
      exact uni.monomial_inj at k, n with eq
    exact polynomialTerm.other at {0}, R.carrier, R.zero, a, {(0, n)}, {(0, k)} with zeroIn, aIn, mk, diff

theorem uni.term_mem (a : R) (n : Nat)
  shows polynomialTerm({0}, R.carrier, R.zero, a, {(0, n)}) ∈ Ring.carrier(polynomialRing(R, {0}))
proof
  have zeroIn : R.zero ∈ R.carrier by typecheck
  have aIn : a ∈ R.carrier by typecheck
  have t := polynomialTerm.member at {0}, R.carrier, R.zero, a, {(0, n)} with zeroIn, aIn
  exact polynomialRing.member_of_parts at R, {0}, polynomialTerm({0}, R.carrier, R.zero, a, {(0, n)}) with comm, polys, t

theorem uni.variable_monomial
  shows monomialVariable({0}, 0) = {(0, 1)}
proof
  have zero : 0 ∈ {0} by simp [singleton.membership]
  have mv := monomialVariable.member at {0}, 0
  have m1 := monomials.univariate at 1
  apply monomials.ext at {0}, monomialVariable({0}, 0), {(0, 1)} with mv, m1
  intros i hi
  rw singleton.membership at hi
  rw hi
  rw (monomialVariable.same at {0}, 0 with zero)
  rw (uni.monomial_value at 1)

theorem uni.X_term
  shows polyX(R) = polynomialTerm({0}, R.carrier, R.zero, R.one, {(0, 1)})
proof
  unfold polyX
  rw X.value
  unfold polynomialVariable
  rw uni.variable_monomial

theorem uni.X_pow (n : Nat)
  shows Ring.pow(polynomialRing(R, {0}), polyX(R), n) =
    polynomialTerm({0}, R.carrier, R.zero, R.one, {(0, n)})
proof
  induction n
  | zero =>
    have pr := CommRing.to_ring with polys
    have xIn : polyX(R) ∈ Ring.carrier(polynomialRing(R, {0}))
      unfold polyX
      exact X.mem at R, {0}, 0 with comm
    have oneIn : R.one ∈ R.carrier by typecheck
    rw (Ring.pow_zero at polynomialRing(R, {0}), polyX(R) with pr, xIn)
    rw (polynomialRing.oneOf at R, {0})
    unfold polynomialConstant
    rw monomialOne.univariate
  | succ(m) using ih =>
    have pr := CommRing.to_ring with polys
    have xIn : polyX(R) ∈ Ring.carrier(polynomialRing(R, {0}))
      unfold polyX
      exact X.mem at R, {0}, 0 with comm
    have oneIn : R.one ∈ R.carrier by typecheck
    have step := Ring.pow_succ at polynomialRing(R, {0}), polyX(R), m with pr, xIn
    have sn : succ(m) = m + 1 by arith
    rw sn
    rw step
    rw ih
    rw (uni.X_term at R with comm, polys)
    have t1 := uni.term_mem at R, R.one, m with comm, polys, oneIn
    have t2 := uni.term_mem at R, R.one, 1 with comm, polys, oneIn
    rw (polynomialRing.mul_apply at R, {0}, polynomialTerm({0}, R.carrier, R.zero, R.one, {(0, m)}), polynomialTerm({0}, R.carrier, R.zero, R.one, {(0, 1)}) with comm, polys, t1, t2)
    have parts := CommRing.parts with comm
    have mn := monomials.univariate at m
    have m1 := monomials.univariate at 1
    have e := polynomialProduct.terms at {0}, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, R.one, R.one, {(0, m)}, {(0, 1)} with parts, oneIn, oneIn, mn, m1
    have oo := IsCommRing.one_left at R.carrier, R.add, R.zero, R.neg, R.mul, R.one, R.one with parts, oneIn
    rw (uni.monomial_mul at m, 1) at e
    rw oo at e
    exact e

-- The constants form a homomorphism (Polynomial.C, C_1, C_mul, C_add),
-- injective (Polynomial.C_injective), with coefficients a at 0 and 0
-- elsewhere (Polynomial.coeff_C).
theorem polyC.hom
  shows polynomialConstant(R, {0}) : R →+* polynomialRing(R, {0})
proof
  exact polynomialConstant.hom at R, {0} with comm

theorem polyC.mem (a : R)
  shows polyC(R, a) ∈ Ring.carrier(polynomialRing(R, {0}))
proof
  unfold polyC
  exact polynomialConstant.mem at R, {0}, a with comm

theorem polyC.coeff (a : R) (k : Nat)
  shows (k = 0 → polyCoeff(polyC(R, a), k) = a) ∧
    (k ≠ 0 → polyCoeff(polyC(R, a), k) = R[0])
proof
  have zeroIn : R.zero ∈ R.carrier by typecheck
  have aIn : a ∈ R.carrier by typecheck
  have mk := monomials.univariate at k
  unfold polyC
  rw (polynomialConstant.apply at R, {0}, a with comm)
  unfold polyCoeff
  constructor
  . intro e
    rw e
    rw ← monomialOne.univariate
    unfold polynomialConstant
    have m1 := monomialOne.member at {0}
    exact polynomialTerm.same at {0}, R.carrier, R.zero, a, monomialOne({0}) with zeroIn, aIn, m1
  . intro ne
    have diff : {(0, k)} ≠ monomialOne({0})
      rw monomialOne.univariate
      intro eq
      apply ne
      exact uni.monomial_inj at k, 0 with eq
    unfold polynomialConstant
    exact polynomialTerm.other at {0}, R.carrier, R.zero, a, monomialOne({0}), {(0, k)} with zeroIn, aIn, mk, diff

theorem polyC.injective (a b : R)
  requires equal : polyC(R, a) = polyC(R, b)
  shows a = b
proof
  unfold polyC at equal
  exact polynomialConstant.inj at R, {0}, a, b with comm, equal

-- Polynomial.coeff_X_pow, coeff_monomial.
theorem polyMonomial.coeff (a : R) (n k : Nat)
  shows (k = n → polyCoeff(polyMonomial(R, a, n), k) = a) ∧
    (k ≠ n → polyCoeff(polyMonomial(R, a, n), k) = R[0])
proof
  have oneIn : R.one ∈ R.carrier by typecheck
  have zeroIn : R.zero ∈ R.carrier by typecheck
  have t := uni.term_mem at R, R.one, n with comm, polys, oneIn
  have mk := monomials.univariate at k
  have tc := uni.term_coeff at R, R.one, n, k with comm, polys, oneIn
  unfold polyMonomial
  rw (uni.X_pow at R, n with comm, polys)
  unfold polyC
  have cm := polynomialRing.constant_mul at R, {0}, a, polynomialTerm({0}, R.carrier, R.zero, R.one, {(0, n)}), {(0, k)} with comm, polys, t, mk
  unfold polyCoeff at tc
  unfold polyCoeff
  rw cm
  constructor
  . intro e
    rw (tc.left with e)
    ring
  . intro ne
    rw (tc.right with ne)
    ring

theorem polyX.mem
  shows polyX(R) ∈ Ring.carrier(polynomialRing(R, {0}))
proof
  unfold polyX
  exact X.mem at R, {0}, 0 with comm

-- Polynomial.ext and Polynomial.ext_iff: polynomials with equal
-- coefficients are equal.
theorem polynomial.ext (p q : polynomialRing(R, {0}))
  requires agree : ∀ k ∈ ℕ, polyCoeff(p, k) = polyCoeff(q, k)
  shows p = q
proof
  apply polynomialRing.ext at R, {0}, p, q with comm, polys
  intros m hm
  obtain ⟨kNat, shape⟩ := uni.monomial_shape at m with hm
  have kN := nat.omega.forward with kNat
  have e := agree with m(0), kN
  unfold polyCoeff at e
  rw shape
  exact e

-- Coefficients of sums, of a constant multiple (Polynomial.coeff_C_mul),
-- of X times p (coeff_X_mul), and of a product (Polynomial.coeff_mul) as a
-- finite sum over i + j = k.
theorem polyCoeff.add (p q : polynomialRing(R, {0})) (k : Nat)
  shows polyCoeff(p + q, k) = call2(R.add, polyCoeff(p, k), polyCoeff(q, k))
proof
  have mk := monomials.univariate at k
  unfold polyCoeff
  exact polynomialRing.coefficient_add at R, {0}, p, q, {(0, k)} with comm, polys, mk

theorem polyCoeff.C_mul (a : R) (p : polynomialRing(R, {0})) (k : Nat)
  shows polyCoeff(polyC(R, a) * p, k) = call2(R.mul, a, polyCoeff(p, k))
proof
  have mk := monomials.univariate at k
  unfold polyC
  unfold polyCoeff
  exact polynomialRing.constant_mul at R, {0}, a, p, {(0, k)} with comm, polys, mk

theorem polyCoeff.X_pow_mul (p : polynomialRing(R, {0})) (n k : Nat)
  shows polyCoeff(Ring.pow(polynomialRing(R, {0}), polyX(R), n) * p, k + n) =
    polyCoeff(p, k)
proof
  have oneIn : R.one ∈ R.carrier by typecheck
  have parts := CommRing.parts with comm
  have t := uni.term_mem at R, R.one, n with comm, polys, oneIn
  have mn := monomials.univariate at n
  have mk := monomials.univariate at k
  rw (uni.X_pow at R, n with comm, polys)
  rw (polynomialRing.mul_apply at R, {0}, polynomialTerm({0}, R.carrier, R.zero, R.one, {(0, n)}), p with comm, polys, t)
  have pp := polynomialRing.member_parts at R, {0}, p with comm, polys
  have shift := polynomialProduct.monomial_shift at {0}, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, {(0, n)}, {(0, k)}, p with parts, mn, mk, pp
  rw (uni.monomial_mul at n, k) at shift
  have c : k + n = n + k by arith
  unfold polyCoeff
  rw c
  exact shift

-- Helper: the terms pᵢ q_j of the k-th coefficient of a product.
theorem tkJ.product_terms (p q : polynomialRing(R, {0})) (k : Nat)
  shows (polyProductTerms(R, p, q, k) : antidiagonal(k) → R.carrier) ∧
    (∀ i ∈ ℕ, ∀ j ∈ ℕ, i + j = k → polyProductTerms(R, p, q, k)((i, j)) =
      call2(R.mul, p({(0, i)}), q({(0, j)})))
proof
  have pIn : p ∈ Ring.carrier(polynomialRing(R, {0})) by assumption
  have qIn : q ∈ Ring.carrier(polynomialRing(R, {0})) by assumption
  have rel : ∀ i ∈ ℕ, ∀ j ∈ ℕ, i + j = k → ((i, j), call2(R.mul, p({(0, i)}), q({(0, j)}))) ∈ polyProductTerms(R, p, q, k) ∧ (i, j) ∈ antidiagonal(k) ∧ call2(R.mul, p({(0, i)}), q({(0, j)})) ∈ R.carrier
    intros i iN j jN s
    have iNat := nat.omega.backward with iN
    have jNat := nat.omega.backward with jN
    have mi := monomials.univariate at i
    have mj := monomials.univariate at j
    have pi := polynomialRing.coefficient_mem at R, {0}, p, {(0, i)} with comm, polys, pIn, mi
    have qj := polynomialRing.coefficient_mem at R, {0}, q, {(0, j)} with comm, polys, qIn, mj
    have v : call2(R.mul, p({(0, i)}), q({(0, j)})) ∈ R.carrier by typecheck
    have ad := (tkJ.antidiagonal_pair at k, i, j).backward with s
    have m : ((i, j), call2(R.mul, p({(0, i)}), q({(0, j)}))) ∈ polyProductTerms(R, p, q, k)
      apply polyProductTerms.membership.backward
      refine ⟨(product.pair with ad, v), i, iN, j, jN, rfl⟩
    exact ⟨m, ad, v⟩
  have fn : polyProductTerms(R, p, q, k) : antidiagonal(k) → R.carrier
    apply tkJ.uni_graph_function
    . intros u hu
      exact (polyProductTerms.membership.forward with hu).left
    . intros x y z hy hz
      obtain ⟨_, a, aIn, b, bIn, ea⟩ := polyProductTerms.membership.forward with hy
      obtain ⟨_, c, cIn, d, dIn, eb⟩ := polyProductTerms.membership.forward with hz
      obtain ⟨xa, ya⟩ := orderedPair.injective with ea
      obtain ⟨xb, yb⟩ := orderedPair.injective with eb
      have same : (a, b) = (c, d) by cc
      obtain ⟨ac, bd⟩ := orderedPair.injective with same
      rw [ya, yb, ac, bd]
    . intros x hx
      obtain ⟨_, i, iN, j, jN, e, s⟩ := antidiagonal.membership.forward with hx
      obtain ⟨m, ad, v⟩ := rel with i, iN, j, jN, s
      rw e
      exact ⟨call2(R.mul, p({(0, i)}), q({(0, j)})), v, m⟩
  refine ⟨fn, ?_⟩
  intros i iN j jN s
  obtain ⟨m, ad, v⟩ := rel with i, iN, j, jN, s
  exact FunctionBetween.apply_value with fn, ad, m

-- Helper: the convolution at {(0, k)} over a bound containing the pairs
-- ({(0, i)}, {(0, j)}) with i + j = k is the antidiagonal sum.
theorem tkJ.product_coeff_on_domain (p q D : Set) (k : Nat)
  requires pIn : p ∈ Ring.carrier(polynomialRing(R, {0}))
  requires qIn : q ∈ Ring.carrier(polynomialRing(R, {0}))
  requires finite : Finite(D)
  requires domain : D ⊆ monomials({0}) × monomials({0})
  requires fiber : functionImage(tkJAntidiagonalMonomials(k), antidiagonal(k),
    monomials({0}) × monomials({0})) ⊆ D
  shows finitePushforward(D, monomials({0}), R.carrier, R.add, R.zero, R.neg,
      R.mul, R.one, monomialMul({0}), boundedConvolutionWeights({0}, D, R.carrier,
      R.add, R.zero, R.neg, R.mul, R.one, p, q))({(0, k)}) =
    finiteRingSum(antidiagonal(k), R.carrier, R.add, R.zero, R.neg, R.mul, R.one,
      polyProductTerms(R, p, q, k))
proof
  have parts := CommRing.parts with comm
  have zeroIn : R.zero ∈ R.carrier by typecheck
  have pp := polynomialRing.member_parts at R, {0}, p with comm, polys, pIn
  have qp := polynomialRing.member_parts at R, {0}, q with comm, polys, qIn
  have mk := monomials.univariate at k
  obtain ⟨phiF, phiV, phiInj⟩ := tkJ.antidiagonal_monomials at k
  obtain ⟨termsF, termsV⟩ := tkJ.product_terms at R, p, q, k with comm, polys, pIn, qIn
  have adFin := tkJ.antidiagonal_finite at k
  have bw := boundedConvolutionWeights.function at {0}, D, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, p, q with parts, pp, qp, domain
  have pwF := pushforwardWeights.function at D, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, monomialMul({0}), boundedConvolutionWeights({0}, D, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, p, q), {(0, k)} with parts, bw
  have value := finitePushforward.value at D, monomials({0}), R.carrier, R.add, R.zero, R.neg, R.mul, R.one, monomialMul({0}), boundedConvolutionWeights({0}, D, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, p, q), {(0, k)} with parts, finite, bw, mk
  have bij : BijectiveBetween(tkJAntidiagonalMonomials(k), antidiagonal(k), functionImage(tkJAntidiagonalMonomials(k), antidiagonal(k), monomials({0}) × monomials({0})))
    have surj := functionImage.surjective with phiF
    have corestricted := functionImage.corestrict with phiF
    unfold BijectiveBetween
    refine ⟨?_, surj⟩
    unfold InjectiveBetween
    refine ⟨corestricted, ?_⟩
    intros x hx y hy z hz rx ry
    have ex := FunctionBetween.apply_value with phiF, hx, rx
    have ey := FunctionBetween.apply_value with phiF, hy, ry
    have e : tkJAntidiagonalMonomials(k)(x) = tkJAntidiagonalMonomials(k)(y)
      rw [ex, ey]
    exact phiInj with x, hx, y, hy, e
  have closed : ∀ x ∈ functionImage(tkJAntidiagonalMonomials(k), antidiagonal(k), monomials({0}) × monomials({0})), pushforwardWeights(D, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, monomialMul({0}), boundedConvolutionWeights({0}, D, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, p, q), {(0, k)})(x) ∈ R.carrier
    intros x hx
    have xD := fiber with x, hx
    exact FunctionBetween.apply_closed with pwF, xD
  have resF := restrict.function at pushforwardWeights(D, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, monomialMul({0}), boundedConvolutionWeights({0}, D, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, p, q), {(0, k)}), D, R.carrier, functionImage(tkJAntidiagonalMonomials(k), antidiagonal(k), monomials({0}) × monomials({0})), R.carrier with pwF, fiber, closed
  have agreement : ∀ s ∈ functionImage(tkJAntidiagonalMonomials(k), antidiagonal(k), monomials({0}) × monomials({0})), pushforwardWeights(D, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, monomialMul({0}), boundedConvolutionWeights({0}, D, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, p, q), {(0, k)})(s) = restrict(pushforwardWeights(D, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, monomialMul({0}), boundedConvolutionWeights({0}, D, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, p, q), {(0, k)}), functionImage(tkJAntidiagonalMonomials(k), antidiagonal(k), monomials({0}) × monomials({0})))(s)
    intros s hs
    have r := restrict.apply at pushforwardWeights(D, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, monomialMul({0}), boundedConvolutionWeights({0}, D, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, p, q), {(0, k)}), D, R.carrier, functionImage(tkJAntidiagonalMonomials(k), antidiagonal(k), monomials({0}) × monomials({0})), R.carrier, s with pwF, fiber, closed, hs
    rw r
  have vanishes : ∀ d ∈ D, ¬(d ∈ functionImage(tkJAntidiagonalMonomials(k), antidiagonal(k), monomials({0}) × monomials({0}))) → pushforwardWeights(D, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, monomialMul({0}), boundedConvolutionWeights({0}, D, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, p, q), {(0, k)})(d) = R.zero
    intros d hd out
    have dP := domain with d, hd
    obtain ⟨_, a, aIn, b, bIn, shape⟩ := product.membership.forward with dP
    have wd := FunctionBetween.apply_closed with bw, hd
    have pwv := pushforwardWeights.value at D, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, monomialMul({0}), boundedConvolutionWeights({0}, D, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, p, q), {(0, k)}, d with parts, bw, hd
    rw pwv
    apply singleValue.other with zeroIn, wd
    intro same
    obtain ⟨aNat, aShape⟩ := uni.monomial_shape at a with aIn
    obtain ⟨bNat, bShape⟩ := uni.monomial_shape at b with bIn
    have hv := monomialMul.apply at {0}, a, b with aIn, bIn
    rw shape at same
    unfold call2 at hv
    rw hv at same
    rw [aShape, bShape] at same
    rw (uni.monomial_mul at a(0), b(0)) at same
    have sum := uni.monomial_inj at k, a(0) + b(0) with same
    have a0N := nat.omega.forward with aNat
    have b0N := nat.omega.forward with bNat
    have sk : a(0) + b(0) = k
      rw sum
    have ad := (tkJ.antidiagonal_pair at k, a(0), b(0)).backward with sk
    have img := functionImage.value with phiF, ad
    rw (phiV with a(0), a0N, b(0), b0N, sk) at img
    rw [← aShape, ← bShape, ← shape] at img
    exact out with img
  have extended := finiteRingSum.zero_extension at D, functionImage(tkJAntidiagonalMonomials(k), antidiagonal(k), monomials({0}) × monomials({0})), R.carrier, R.add, R.zero, R.neg, R.mul, R.one, pushforwardWeights(D, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, monomialMul({0}), boundedConvolutionWeights({0}, D, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, p, q), {(0, k)}), restrict(pushforwardWeights(D, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, monomialMul({0}), boundedConvolutionWeights({0}, D, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, p, q), {(0, k)}), functionImage(tkJAntidiagonalMonomials(k), antidiagonal(k), monomials({0}) × monomials({0}))) with parts, finite, pwF, resF, fiber, agreement, vanishes
  have values : ∀ d ∈ antidiagonal(k), polyProductTerms(R, p, q, k)(d) = restrict(pushforwardWeights(D, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, monomialMul({0}), boundedConvolutionWeights({0}, D, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, p, q), {(0, k)}), functionImage(tkJAntidiagonalMonomials(k), antidiagonal(k), monomials({0}) × monomials({0})))(tkJAntidiagonalMonomials(k)(d))
    intros d hd
    obtain ⟨_, i, iN, j, jN, e, s⟩ := antidiagonal.membership.forward with hd
    have iNat := nat.omega.backward with iN
    have jNat := nat.omega.backward with jN
    have mi := monomials.univariate at i
    have mj := monomials.univariate at j
    have img := functionImage.value with phiF, hd
    have r := restrict.apply at pushforwardWeights(D, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, monomialMul({0}), boundedConvolutionWeights({0}, D, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, p, q), {(0, k)}), D, R.carrier, functionImage(tkJAntidiagonalMonomials(k), antidiagonal(k), monomials({0}) × monomials({0})), R.carrier, tkJAntidiagonalMonomials(k)(d) with pwF, fiber, closed, img
    rw r
    have imgD := fiber with tkJAntidiagonalMonomials(k)(d), img
    rw e
    rw e at imgD
    rw (phiV with i, iN, j, jN, s)
    rw (phiV with i, iN, j, jN, s) at imgD
    have wd := FunctionBetween.apply_closed with bw, imgD
    have pwv := pushforwardWeights.value at D, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, monomialMul({0}), boundedConvolutionWeights({0}, D, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, p, q), {(0, k)}, ({(0, i)}, {(0, j)}) with parts, bw, imgD
    rw pwv
    have hv := monomialMul.apply at {0}, {(0, i)}, {(0, j)} with mi, mj
    unfold call2 at hv
    rw hv
    rw (uni.monomial_mul at i, j)
    rw s
    rw (singleValue.same at R.carrier, R.zero, boundedConvolutionWeights({0}, D, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, p, q)(({(0, i)}, {(0, j)})), {(0, k)}, {(0, k)} with zeroIn, wd)
    rw (termsV with i, iN, j, jN, s)
    rw (boundedConvolutionWeights.pair at {0}, D, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, p, q, {(0, i)}, {(0, j)} with parts, pp, qp, domain, imgD, mi, mj)
  have reindexed := finiteRingSum.reindex at antidiagonal(k), functionImage(tkJAntidiagonalMonomials(k), antidiagonal(k), monomials({0}) × monomials({0})), R.carrier, R.add, R.zero, R.neg, R.mul, R.one, polyProductTerms(R, p, q, k), restrict(pushforwardWeights(D, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, monomialMul({0}), boundedConvolutionWeights({0}, D, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, p, q), {(0, k)}), functionImage(tkJAntidiagonalMonomials(k), antidiagonal(k), monomials({0}) × monomials({0}))), tkJAntidiagonalMonomials(k) with parts, adFin, termsF, resF, bij, values
  rw [value, extended, reindexed]

theorem polyCoeff.mul (p q : polynomialRing(R, {0})) (k : Nat)
  shows polyCoeff(p * q, k) = finiteRingSum(antidiagonal(k), R.carrier, R.add,
    R.zero, R.neg, R.mul, R.one, polyProductTerms(R, p, q, k))
proof
  have parts := CommRing.parts with comm
  have pIn : p ∈ Ring.carrier(polynomialRing(R, {0})) by assumption
  have qIn : q ∈ Ring.carrier(polynomialRing(R, {0})) by assumption
  have pp := polynomialRing.member_parts at R, {0}, p with comm, polys, pIn
  have qp := polynomialRing.member_parts at R, {0}, q with comm, polys, qIn
  obtain ⟨phiF, _, _⟩ := tkJ.antidiagonal_monomials at k
  have adFin := tkJ.antidiagonal_finite at k
  have adSub : antidiagonal(k) ⊆ antidiagonal(k)
    intros t ht
    exact ht
  have imgFin := Finite.function_image with phiF, adFin, adSub
  have convFin := convolutionPairs.finite with pp, qp
  have dFin := Finite.union with convFin, imgFin
  have convSub := convolutionPairs.subset at {0}, R.zero, p, q
  have imgSub := functionImage.subset at tkJAntidiagonalMonomials(k), antidiagonal(k), monomials({0}) × monomials({0})
  have dSub := union2.subset with convSub, imgSub
  have covers := union2.subset_left at convolutionPairs({0}, R.zero, p, q), functionImage(tkJAntidiagonalMonomials(k), antidiagonal(k), monomials({0}) × monomials({0}))
  have fiberSub := union2.subset_right at convolutionPairs({0}, R.zero, p, q), functionImage(tkJAntidiagonalMonomials(k), antidiagonal(k), monomials({0}) × monomials({0}))
  have onDomain := polynomialProduct.on_domain at {0}, convolutionPairs({0}, R.zero, p, q) ∪ functionImage(tkJAntidiagonalMonomials(k), antidiagonal(k), monomials({0}) × monomials({0})), R.carrier, R.add, R.zero, R.neg, R.mul, R.one, p, q with parts, pp, qp, dSub, dFin, covers
  have sum := tkJ.product_coeff_on_domain at R, p, q, convolutionPairs({0}, R.zero, p, q) ∪ functionImage(tkJAntidiagonalMonomials(k), antidiagonal(k), monomials({0}) × monomials({0})), k with comm, polys, pIn, qIn, dFin, dSub, fiberSub
  rw onDomain at sum
  rw (polynomialRing.mul_apply at R, {0}, p, q with comm, polys, pIn, qIn)
  unfold polyCoeff
  exact sum


-- Helpers: coefficients of zero and of differences, and the defining
-- properties of the natural degree.
theorem uni.zero_coeff (k : Nat)
  shows polyCoeff(Ring.zero(polynomialRing(R, {0})), k) = R[0]
proof
  have mk := monomials.univariate at k
  unfold polyCoeff
  exact polynomialRing.coefficient_zero at R, {0}, {(0, k)} with comm, polys, mk

theorem uni.coeff_sub (p q : polynomialRing(R, {0})) (k : Nat)
  shows polyCoeff(p - q, k) = polyCoeff(p, k) - polyCoeff(q, k)
proof
  have pr := CommRing.to_ring with polys
  have mk := monomials.univariate at k
  have nq : -q ∈ Ring.carrier(polynomialRing(R, {0})) := Ring.neg_mem with *
  rw (Ring.sub.value at polynomialRing(R, {0}), p, q)
  rw (polyCoeff.add at R, p, -q, k with comm, polys)
  have n := polynomialRing.coefficient_neg at R, {0}, q, {(0, k)} with comm, polys, mk
  unfold polyCoeff
  rw n
  rw (Ring.sub.value at R, p({(0, k)}), q({(0, k)}))

theorem uni.deg_spec (p : polynomialRing(R, {0}))
  shows (∀ k ∈ ℕ, polyCoeff(p, k) ≠ R[0] → k ≤ polyNatDegree(R, p)) ∧
    (p ≠ Ring.zero(polynomialRing(R, {0})) → polyCoeff(p, polyNatDegree(R, p)) ≠ R[0])
proof
  have pIn : p ∈ Ring.carrier(polynomialRing(R, {0})) by assumption
  have sel := polyNatDegree.selected at R, p with comm, pIn
  obtain ⟨dN, spec⟩ := sel
  constructor
  . intros k hk nz
    have kd : k ∈ polyDegrees(R, p)
      unfold polyDegrees
      unfold polyCoeff at nz
      exact ⟨hk, nz⟩
    cases spec with e | m
    . have no := empty.membership at k
      rw e.left at kd
      exfalso
      exact no with kd
    . exact m.right with k, kd
  . intro nonzero
    cases spec with e | m
    . exfalso
      apply nonzero
      have pr := CommRing.to_ring with polys
      have z : Ring.zero(polynomialRing(R, {0})) ∈ Ring.carrier(polynomialRing(R, {0})) := Ring.zero_mem with *
      apply polynomial.ext at R, p, Ring.zero(polynomialRing(R, {0})) with comm, polys, pIn, z
      intros k hk
      have kNat := nat.omega.backward with hk
      rw (uni.zero_coeff at R, k with comm, polys)
      by_contra nz
      have kd : k ∈ polyDegrees(R, p)
        unfold polyDegrees
        unfold polyCoeff at nz
        exact ⟨hk, nz⟩
      have no := empty.membership at k
      rw e.left at kd
      exact no with kd
    . have d := m.left
      unfold polyDegrees at d
      unfold polyCoeff
      exact d.right

theorem uni.deg_le (p : polynomialRing(R, {0})) (n : Nat)
  requires vanish : ∀ k ∈ ℕ, n < k → polyCoeff(p, k) = R[0]
  shows polyNatDegree(R, p) ≤ n
proof
  have pIn : p ∈ Ring.carrier(polynomialRing(R, {0})) by assumption
  have sel := polyNatDegree.selected at R, p with comm, pIn
  obtain ⟨dN, spec⟩ := sel
  have dNat := nat.omega.backward with dN
  cases spec with e | m
  . rw e.right
    arith
  . have d := m.left
    unfold polyDegrees at d
    obtain ⟨_, nz⟩ := d
    by_contra big
    have lt : n < polyNatDegree(R, p) by arith
    have z := vanish with polyNatDegree(R, p), dN, lt
    unfold polyCoeff at z
    apply nz
    exact z

-- Helpers: a product's coefficients vanish above the sum of degree bounds,
-- and its coefficient at that sum is the product of the top coefficients.
theorem uni.mul_vanish (p q : polynomialRing(R, {0})) (m n : Nat)
  requires first : ∀ k ∈ ℕ, m < k → polyCoeff(p, k) = R[0]
  requires second : ∀ k ∈ ℕ, n < k → polyCoeff(q, k) = R[0]
  shows ∀ k ∈ ℕ, m + n < k → polyCoeff(p * q, k) = R[0]
proof
  intros k hk big
  have kNat := nat.omega.backward with hk
  have parts := CommRing.parts with comm
  have pIn : p ∈ Ring.carrier(polynomialRing(R, {0})) by assumption
  have qIn : q ∈ Ring.carrier(polynomialRing(R, {0})) by assumption
  have pp := polynomialRing.member_parts at R, {0}, p with comm, polys, pIn
  have qq := polynomialRing.member_parts at R, {0}, q with comm, polys, qIn
  rw (polynomialRing.mul_apply at R, {0}, p, q with comm, polys)
  unfold polyCoeff
  by_contra nz
  have mk := monomials.univariate at k
  have supp : {(0, k)} ∈ functionSupport(polynomialProduct({0}, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, p, q), monomials({0}), R.zero)
    exact functionSupport.membership.backward with ⟨mk, nz⟩
  obtain ⟨u, hu, v, hv, eq⟩ := polynomialProduct.support_factor at {0}, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, p, q, {(0, k)} with parts, pp, qq, supp
  obtain ⟨uIn, uz⟩ := functionSupport.membership.forward with hu
  obtain ⟨vIn, vz⟩ := functionSupport.membership.forward with hv
  obtain ⟨iNat, ushape⟩ := uni.monomial_shape at u with uIn
  obtain ⟨jNat, vshape⟩ := uni.monomial_shape at v with vIn
  have iN := nat.omega.forward with iNat
  have jN := nat.omega.forward with jNat
  rw [ushape, vshape] at eq
  rw (uni.monomial_mul at u(0), v(0)) at eq
  have keq := uni.monomial_inj at k, u(0) + v(0) with eq
  have ile : u(0) ≤ m
    by_contra gt
    have lt : m < u(0) by arith
    have z := first with u(0), iN, lt
    unfold polyCoeff at z
    rw ← ushape at z
    apply uz
    exact z
  have jle : v(0) ≤ n
    by_contra gt
    have lt : n < v(0) by arith
    have z := second with v(0), jN, lt
    unfold polyCoeff at z
    rw ← vshape at z
    apply vz
    exact z
  arith

theorem uni.mul_top (p q : polynomialRing(R, {0})) (m n : Nat)
  requires first : ∀ k ∈ ℕ, m < k → polyCoeff(p, k) = R[0]
  requires second : ∀ k ∈ ℕ, n < k → polyCoeff(q, k) = R[0]
  shows polyCoeff(p * q, m + n) = polyCoeff(p, m) * polyCoeff(q, n)
proof
  have parts := CommRing.parts with comm
  have pIn : p ∈ Ring.carrier(polynomialRing(R, {0})) by assumption
  have qIn : q ∈ Ring.carrier(polynomialRing(R, {0})) by assumption
  have pp := polynomialRing.member_parts at R, {0}, p with comm, polys, pIn
  have qq := polynomialRing.member_parts at R, {0}, q with comm, polys, qIn
  have fin := convolutionPairs.finite at {0}, R.carrier, R.zero, p, q with pp, qq
  have wfn := convolutionWeights.function at {0}, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, p, q with parts, pp, qq
  have fiber : ∀ e ∈ convolutionPairs({0}, R.zero, p, q), monomialMul({0})(e) = {(0, m + n)} → e = ({(0, m)}, {(0, n)}) ∧ p({(0, m)}) ≠ R.zero ∧ q({(0, n)}) ≠ R.zero
    intros e he img
    have he2 := he
    unfold convolutionPairs at he2
    obtain ⟨bounded, u, hu, v, hv, shape⟩ := product.membership.forward with he2
    obtain ⟨uIn, uz⟩ := functionSupport.membership.forward with hu
    obtain ⟨vIn, vz⟩ := functionSupport.membership.forward with hv
    have value := monomialMul.apply at {0}, u, v with uIn, vIn
    unfold call2 at value
    rw shape at img
    rw value at img
    obtain ⟨iNat, ushape⟩ := uni.monomial_shape at u with uIn
    obtain ⟨jNat, vshape⟩ := uni.monomial_shape at v with vIn
    have iN := nat.omega.forward with iNat
    have jN := nat.omega.forward with jNat
    rw [ushape, vshape] at img
    rw (uni.monomial_mul at u(0), v(0)) at img
    have keq := uni.monomial_inj at u(0) + v(0), m + n with img
    have ile : u(0) ≤ m
      by_contra gt
      have lt : m < u(0) by arith
      have z := first with u(0), iN, lt
      unfold polyCoeff at z
      rw ← ushape at z
      apply uz
      exact z
    have jle : v(0) ≤ n
      by_contra gt
      have lt : n < v(0) by arith
      have z := second with v(0), jN, lt
      unfold polyCoeff at z
      rw ← vshape at z
      apply vz
      exact z
    have ieq : u(0) = m by arith
    have jeq : v(0) = n by arith
    rw ieq at ushape
    rw jeq at vshape
    refine ⟨?_, ?_, ?_⟩
    . rw [shape, ushape, vshape]
    . rw ← ushape
      exact uz
    . rw ← vshape
      exact vz
  have mmn := monomials.univariate at m + n
  have mm := monomials.univariate at m
  have mn := monomials.univariate at n
  rw (polynomialRing.mul_apply at R, {0}, p, q with comm, polys)
  unfold polynomialProduct
  unfold polyCoeff
  by_cases both : p({(0, m)}) ≠ R.zero ∧ q({(0, n)}) ≠ R.zero
  . obtain ⟨pz, qz⟩ := both
    have hu : {(0, m)} ∈ functionSupport(p, monomials({0}), R.zero)
      exact functionSupport.membership.backward with ⟨mm, pz⟩
    have hv : {(0, n)} ∈ functionSupport(q, monomials({0}), R.zero)
      exact functionSupport.membership.backward with ⟨mn, qz⟩
    have dIn : ({(0, m)}, {(0, n)}) ∈ convolutionPairs({0}, R.zero, p, q)
      unfold convolutionPairs
      exact product.pair at {(0, m)}, {(0, n)}, functionSupport(p, monomials({0}), R.zero), functionSupport(q, monomials({0}), R.zero) with hu, hv
    have value := monomialMul.apply at {0}, {(0, m)}, {(0, n)} with mm, mn
    unfold call2 at value
    rw (uni.monomial_mul at m, n) at value
    have unique : ∀ e ∈ convolutionPairs({0}, R.zero, p, q), monomialMul({0})(e) = {(0, m + n)} → e = ({(0, m)}, {(0, n)})
      intros e he img
      have f := fiber with e, he, img
      exact f.left
    have uf := finitePushforward.unique_fiber at convolutionPairs({0}, R.zero, p, q), monomials({0}), R.carrier, R.add, R.zero, R.neg, R.mul, R.one, monomialMul({0}), convolutionWeights({0}, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, p, q), ({(0, m)}, {(0, n)}), {(0, m + n)} with parts, fin, wfn, dIn, mmn, value, unique
    rw uf
    exact convolutionWeights.pair at {0}, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, p, q, {(0, m)}, {(0, n)} with parts, pp, qq, hu, hv
  . have absent : ¬({(0, m + n)} ∈ functionImage(monomialMul({0}), convolutionPairs({0}, R.zero, p, q), monomials({0})))
      intro img
      obtain ⟨_, e, he, eq⟩ := functionImage.membership.forward with img
      have eq2 : monomialMul({0})(e) = {(0, m + n)}
        rw eq
      have f := fiber with e, he, eq2
      apply both
      exact ⟨f.right.left, f.right.right⟩
    have out := finitePushforward.outside at convolutionPairs({0}, R.zero, p, q), monomials({0}), R.carrier, R.add, R.zero, R.neg, R.mul, R.one, monomialMul({0}), convolutionWeights({0}, R.carrier, R.add, R.zero, R.neg, R.mul, R.one, p, q), {(0, m + n)} with parts, fin, wfn, mmn, absent
    rw out
    have pm := polynomialRing.coefficient_mem at R, {0}, p, {(0, m)} with comm, polys, pIn, mm
    have qn := polynomialRing.coefficient_mem at R, {0}, q, {(0, n)} with comm, polys, qIn, mn
    by_cases pz : p({(0, m)}) = R.zero
    . rw pz
      ring
    . have qz : q({(0, n)}) = R.zero
        by_contra qnz
        apply both
        exact ⟨pz, qnz⟩
      rw qz
      ring

-- Helpers: coefficients of X and of one, leading coefficients, and the
-- trivial ring.
theorem uni.X_coeff (k : Nat)
  shows (k = 1 → polyCoeff(polyX(R), k) = R[1]) ∧
    (k ≠ 1 → polyCoeff(polyX(R), k) = R[0])
proof
  have oneIn : R.one ∈ R.carrier by typecheck
  rw (uni.X_term at R with comm, polys)
  exact uni.term_coeff at R, R.one, 1, k with comm, polys, oneIn

theorem uni.one_eq
  shows Ring.one(polynomialRing(R, {0})) = polyC(R, R[1])
proof
  have oneIn : R.one ∈ R.carrier by typecheck
  unfold polyC
  rw (polynomialConstant.apply at R, {0}, R.one with comm, oneIn)
  rw polynomialRing.oneOf

theorem uni.lead_eq (p : Set)
  shows polyLeadingCoeff(R, p) = polyCoeff(p, polyNatDegree(R, p))
proof
  unfold polyLeadingCoeff
  unfold polyCoeff
  rfl

theorem uni.trivial_eq (x : R)
  requires trivial : R[0] = R[1]
  shows x = R[0]
proof
  have e : x = x * R[1] by ring
  rw ← trivial at e
  have z : x * R[0] = R[0] by ring
  rw z at e
  exact e

theorem uni.trivial_deg (p : polynomialRing(R, {0}))
  requires trivial : R[0] = R[1]
  shows polyNatDegree(R, p) = 0
proof
  have pIn : p ∈ Ring.carrier(polynomialRing(R, {0})) by assumption
  have le := uni.deg_le at R, p, 0 with comm, polys
  have bound : polyNatDegree(R, p) ≤ 0
    apply le
    intros k hk lt
    have kNat := nat.omega.backward with hk
    have c := uni.coeff_mem at R, p, k with comm, pIn
    exact uni.trivial_eq at R, polyCoeff(p, k) with comm, polys, c, trivial
  arith

theorem uni.vanish_deg (p : polynomialRing(R, {0}))
  shows ∀ k ∈ ℕ, polyNatDegree(R, p) < k → polyCoeff(p, k) = R[0]
proof
  have spec := uni.deg_spec at R, p with comm, polys
  intros k hk lt
  have kNat := nat.omega.backward with hk
  by_contra nz
  have le := spec.left with k, hk, nz
  arith

theorem uni.vanish_of_le (p : Set) (n : Nat)
  requires bound : PolyDegreeLE(R, p, n)
  shows ∀ k ∈ ℕ, n < k → polyCoeff(p, k) = R[0]
proof
  obtain ⟨pIn, below⟩ := bound
  intros k hk lt
  have kNat := nat.omega.backward with hk
  by_contra nz
  have kd : k ∈ polyDegrees(R, p)
    unfold polyDegrees
    unfold polyCoeff at nz
    exact ⟨hk, nz⟩
  have l := below with k, kd
  arith

-- Helpers: the leading coefficient of zero, and a monicity criterion from
-- the coefficients.
theorem uni.lead_zero
  shows polyLeadingCoeff(R, Ring.zero(polynomialRing(R, {0}))) = R[0]
proof
  rw (uni.lead_eq at R, Ring.zero(polynomialRing(R, {0})) with comm, polys)
  have pr := CommRing.to_ring with polys
  have z : Ring.zero(polynomialRing(R, {0})) ∈ Ring.carrier(polynomialRing(R, {0})) := Ring.zero_mem with *
  have dN : polyNatDegree(R, Ring.zero(polynomialRing(R, {0}))) ∈ ℕ
    have sel := polyNatDegree.selected at R, Ring.zero(polynomialRing(R, {0})) with comm, z
    exact sel.left
  have dNat := nat.omega.backward with dN
  exact uni.zero_coeff at R, polyNatDegree(R, Ring.zero(polynomialRing(R, {0}))) with comm, polys

theorem uni.monic_of (p : polynomialRing(R, {0})) (n : Nat)
  requires top : polyCoeff(p, n) = R[1]
  requires vanish : ∀ k ∈ ℕ, n < k → polyCoeff(p, k) = R[0]
  shows PolyMonic(R, p) ∧ (R[0] ≠ R[1] → polyNatDegree(R, p) = n)
proof
  have pIn : p ∈ Ring.carrier(polynomialRing(R, {0})) by assumption
  have upper := uni.deg_le at R, p, n with comm, polys, pIn, vanish
  have spec := uni.deg_spec at R, p with comm, polys, pIn
  have nN : n ∈ ℕ by typecheck
  have degEq : R[0] ≠ R[1] → polyNatDegree(R, p) = n
    intro nontrivial
    have nz : polyCoeff(p, n) ≠ R[0]
      rw top
      intro e
      apply nontrivial
      rw e
    have lower := spec.left with n, nN, nz
    arith
  unfold PolyMonic
  refine ⟨⟨pIn, ?_⟩, degEq⟩
  rw (uni.lead_eq at R, p with comm, polys)
  by_cases nontrivial : R[0] ≠ R[1]
  . rw (degEq with nontrivial)
    exact top
  . have triv : R[0] = R[1] by tauto
    have dN : polyNatDegree(R, p) ∈ ℕ
      have sel := polyNatDegree.selected at R, p with comm, pIn
      exact sel.left
    have dNat := nat.omega.backward with dN
    have c := uni.coeff_mem at R, p, polyNatDegree(R, p) with comm, pIn
    have e := uni.trivial_eq at R, polyCoeff(p, polyNatDegree(R, p)) with comm, polys, c, triv
    rw e
    exact triv

theorem uni.XsubC_coeff (a : R)
  shows polyCoeff(polyXSubC(R, a), 1) = R[1] ∧
    (∀ k ∈ ℕ, 1 < k → polyCoeff(polyXSubC(R, a), k) = R[0])
proof
  have xIn := polyX.mem at R with comm, polys
  have cIn := polyC.mem at R, a with comm, polys
  have coeff : ∀ k ∈ ℕ, polyCoeff(polyXSubC(R, a), k) = polyCoeff(polyX(R), k) - polyCoeff(polyC(R, a), k)
    intros k hk
    have kNat := nat.omega.backward with hk
    unfold polyXSubC
    exact uni.coeff_sub at R, polyX(R), polyC(R, a), k with comm, polys, xIn, cIn
  have oneN : (1:Nat) ∈ ℕ by typecheck
  constructor
  . rw (coeff with 1, oneN)
    have e1 : (1:Nat) = 1 by rfl
    have n0 : (1:Nat) ≠ 0 by arith
    rw ((uni.X_coeff at R, 1 with comm, polys).left with e1)
    rw ((polyC.coeff at R, a, 1 with comm, polys).right with n0)
    ring
  . intros k hk lt
    have kNat := nat.omega.backward with hk
    rw (coeff with k, hk)
    have n1 : k ≠ 1 by arith
    have n0 : k ≠ 0 by arith
    rw ((uni.X_coeff at R, k with comm, polys).right with n1)
    rw ((polyC.coeff at R, a, k with comm, polys).right with n0)
    ring

theorem uni.XsubC_mem (a : R)
  shows polyXSubC(R, a) ∈ Ring.carrier(polynomialRing(R, {0}))
proof
  have xIn := polyX.mem at R with comm, polys
  have cIn := polyC.mem at R, a with comm, polys
  have pr := CommRing.to_ring with polys
  unfold polyXSubC
  exact Ring.sub_mem with *

-- Degrees: Polynomial.coeff_eq_zero_of_natDegree_lt,
-- natDegree_le_iff_coeff_eq_zero, natDegree_C, natDegree_X_sub_C,
-- natDegree_add_le, natDegree_mul_le, natDegree_mul over a domain,
-- natDegree_pow over a domain.
theorem polyNatDegree.coeff_zero_of_lt (p : polynomialRing(R, {0})) (k : Nat)
  requires above : polyNatDegree(R, p) < k
  shows polyCoeff(p, k) = R[0]
proof
  have spec := uni.deg_spec at R, p with comm, polys
  have kN : k ∈ ℕ by typecheck
  by_contra nz
  have le := spec.left with k, kN, nz
  arith

-- Helpers for the monomial expansion: monomials are polynomials, a sum
-- over succ(m) splits off its last term, and the monomial terms of p form
-- a function on ℕ whose partial sums have the expected coefficients.
theorem rmEUni.monomial_mem (a : R) (n : Nat)
  shows polyMonomial(R, a, n) ∈ Ring.carrier(polynomialRing(R, {0}))
proof
  have c := polyC.mem at R, a with comm, polys
  have x := polyX.mem at R with comm, polys
  unfold polyMonomial
  typecheck

theorem rmEUni.sum_succ (w : Set) (m : Nat)
  requires terms : w : succ(m) → Ring.carrier(polynomialRing(R, {0}))
  shows finiteRingSum(succ(m), Ring.carrier(polynomialRing(R, {0})), Ring.add(polynomialRing(R, {0})), Ring.zero(polynomialRing(R, {0})), Ring.neg(polynomialRing(R, {0})), Ring.mul(polynomialRing(R, {0})), Ring.one(polynomialRing(R, {0})), w) = call2(Ring.add(polynomialRing(R, {0})), finiteRingSum(m, Ring.carrier(polynomialRing(R, {0})), Ring.add(polynomialRing(R, {0})), Ring.zero(polynomialRing(R, {0})), Ring.neg(polynomialRing(R, {0})), Ring.mul(polynomialRing(R, {0})), Ring.one(polynomialRing(R, {0})), restrict(w, m)), w(m))
proof
  have parts := CommRing.parts with polys
  have fin := Finite.natural at m
  have fresh := membership.irreflexive at m
  have si := natural.successor_as_insert at m
  have wf := terms
  rw si at wf
  have e := finiteRingSum.insert at m, Ring.carrier(polynomialRing(R, {0})), Ring.add(polynomialRing(R, {0})), Ring.zero(polynomialRing(R, {0})), Ring.neg(polynomialRing(R, {0})), Ring.mul(polynomialRing(R, {0})), Ring.one(polynomialRing(R, {0})), w, m with parts, fin, wf, fresh
  rw ← si at e
  exact e

theorem rmEUni.terms_function (p : polynomialRing(R, {0}))
  shows (polyMonomialTerms(R, p) : ℕ → Ring.carrier(polynomialRing(R, {0}))) ∧ (∀ i ∈ ℕ, polyMonomialTerms(R, p)(i) = polyMonomial(R, p({(0, i)}), i))
proof
  have pIn : p ∈ Ring.carrier(polynomialRing(R, {0})) by assumption
  have fn : polyMonomialTerms(R, p) : ℕ → Ring.carrier(polynomialRing(R, {0}))
    unfold FunctionBetween
    refine ⟨?_, ?_, ?_⟩
    . unfold RelationBetween
      intros q hq
      exact (polyMonomialTerms.membership.forward at R, p, q with hq).left
    . unfold Functional
      intros x y hxy z hxz
      unfold relates at hxy
      unfold relates at hxz
      obtain ⟨_, a, aIn, e1⟩ := polyMonomialTerms.membership.forward at R, p, (x, y) with hxy
      obtain ⟨_, c, cIn, e2⟩ := polyMonomialTerms.membership.forward at R, p, (x, z) with hxz
      obtain ⟨x1, y1⟩ := orderedPair.injective with e1
      obtain ⟨x2, z2⟩ := orderedPair.injective with e2
      have ac : a = c
        rw [← x1, ← x2]
      rw [y1, z2, ac]
    . intros i iIn
      have iNat := nat.omega.backward with iIn
      have cIn := uni.coeff_mem at R, p, i with comm, pIn
      unfold polyCoeff at cIn
      have out := rmEUni.monomial_mem at R, p({(0, i)}), i with comm, polys, cIn
      have pq := product.pair at i, polyMonomial(R, p({(0, i)}), i), ℕ, Ring.carrier(polynomialRing(R, {0})) with iIn, out
      have m := polyMonomialTerms.membership.backward at R, p, (i, polyMonomial(R, p({(0, i)}), i)) with ⟨pq, i, iIn, rfl⟩
      witness polyMonomial(R, p({(0, i)}), i)
      unfold relates
      exact ⟨out, m⟩
  have val : ∀ i ∈ ℕ, polyMonomialTerms(R, p)(i) = polyMonomial(R, p({(0, i)}), i)
    intros i iIn
    have iNat := nat.omega.backward with iIn
    have cIn := uni.coeff_mem at R, p, i with comm, pIn
    unfold polyCoeff at cIn
    have out := rmEUni.monomial_mem at R, p({(0, i)}), i with comm, polys, cIn
    have pq := product.pair at i, polyMonomial(R, p({(0, i)}), i), ℕ, Ring.carrier(polynomialRing(R, {0})) with iIn, out
    have m := polyMonomialTerms.membership.backward at R, p, (i, polyMonomial(R, p({(0, i)}), i)) with ⟨pq, i, iIn, rfl⟩
    have rel : relates(polyMonomialTerms(R, p), i, polyMonomial(R, p({(0, i)}), i))
      unfold relates
      exact m
    exact FunctionBetween.apply_value with fn, iIn, rel
  exact ⟨fn, val⟩

theorem rmEUni.partial_sum (p : polynomialRing(R, {0})) (m : Nat)
  shows ∀ k ∈ ℕ, (k ∈ m → polyCoeff(finiteRingSum(m, Ring.carrier(polynomialRing(R, {0})), Ring.add(polynomialRing(R, {0})), Ring.zero(polynomialRing(R, {0})), Ring.neg(polynomialRing(R, {0})), Ring.mul(polynomialRing(R, {0})), Ring.one(polynomialRing(R, {0})), restrict(polyMonomialTerms(R, p), m)), k) = polyCoeff(p, k)) ∧
    (k ∉ m → polyCoeff(finiteRingSum(m, Ring.carrier(polynomialRing(R, {0})), Ring.add(polynomialRing(R, {0})), Ring.zero(polynomialRing(R, {0})), Ring.neg(polynomialRing(R, {0})), Ring.mul(polynomialRing(R, {0})), Ring.one(polynomialRing(R, {0})), restrict(polyMonomialTerms(R, p), m)), k) = R[0])
proof
  have pIn : p ∈ Ring.carrier(polynomialRing(R, {0})) by assumption
  induction m
  | zero =>
    intros k kIn
    have kNat := nat.omega.backward with kIn
    have parts := CommRing.parts with polys
    obtain ⟨fn, val⟩ := rmEUni.terms_function at R, p with comm, polys, pIn
    have sub0 : 0 ⊆ ℕ
      intros x hx
      exfalso
      have xNat := natural.member at 0 with hx
      have lt := Less.of_membership at x, 0
      have l := lt with hx
      arith
    have rf := restrict.domain_function at polyMonomialTerms(R, p), ℕ, Ring.carrier(polynomialRing(R, {0})), 0 with fn, sub0
    have fin := Finite.natural at 0
    have values : ∀ x ∈ 0, restrict(polyMonomialTerms(R, p), 0)(x) = Ring.zero(polynomialRing(R, {0}))
      intros x hx
      exfalso
      have xNat := natural.member at 0 with hx
      have lt := Less.of_membership at x, 0
      have l := lt with hx
      arith
    have e := finiteRingSum.zero at 0, Ring.carrier(polynomialRing(R, {0})), Ring.add(polynomialRing(R, {0})), Ring.zero(polynomialRing(R, {0})), Ring.neg(polynomialRing(R, {0})), Ring.mul(polynomialRing(R, {0})), Ring.one(polynomialRing(R, {0})), restrict(polyMonomialTerms(R, p), 0) with parts, fin, rf, values
    rw e
    have z := uni.zero_coeff at R, k with comm, polys
    constructor
    . intro k0
      exfalso
      have lt := Less.of_membership at k, 0
      have l := lt with k0
      arith
    . intro _
      exact z
  | succ(j) using ih =>
    intros k kIn
    have kNat := nat.omega.backward with kIn
    obtain ⟨fn, val⟩ := rmEUni.terms_function at R, p with comm, polys, pIn
    have subS : succ(j) ⊆ ℕ
      intros x hx
      have xNat := natural.member at succ(j) with hx
      exact nat.omega.forward with xNat
    have subJ : j ⊆ succ(j)
      intros x hx
      exact membership.into_successor at x, j with hx
    have subJN : j ⊆ ℕ
      intros x hx
      exact subS with (subJ with hx)
    have rf := restrict.domain_function at polyMonomialTerms(R, p), ℕ, Ring.carrier(polynomialRing(R, {0})), succ(j) with fn, subS
    have rj := restrict.domain_function at polyMonomialTerms(R, p), ℕ, Ring.carrier(polynomialRing(R, {0})), j with fn, subJN
    have rrj := restrict.domain_function at restrict(polyMonomialTerms(R, p), succ(j)), succ(j), Ring.carrier(polynomialRing(R, {0})), j with rf, subJ
    have parts := CommRing.parts with polys
    have fin := Finite.natural at j
    have agree : ∀ x ∈ j, restrict(restrict(polyMonomialTerms(R, p), succ(j)), j)(x) = restrict(polyMonomialTerms(R, p), j)(x)
      intros x hx
      rw [(restrict.domain_apply at restrict(polyMonomialTerms(R, p), succ(j)), succ(j), Ring.carrier(polynomialRing(R, {0})), j, x with rf, subJ, hx), (restrict.domain_apply at polyMonomialTerms(R, p), ℕ, Ring.carrier(polynomialRing(R, {0})), succ(j), x with fn, subS, (subJ with hx)), (restrict.domain_apply at polyMonomialTerms(R, p), ℕ, Ring.carrier(polynomialRing(R, {0})), j, x with fn, subJN, hx)]
    have same := finiteRingSum.congr at j, Ring.carrier(polynomialRing(R, {0})), Ring.add(polynomialRing(R, {0})), Ring.zero(polynomialRing(R, {0})), Ring.neg(polynomialRing(R, {0})), Ring.mul(polynomialRing(R, {0})), Ring.one(polynomialRing(R, {0})), restrict(restrict(polyMonomialTerms(R, p), succ(j)), j), restrict(polyMonomialTerms(R, p), j) with parts, fin, rrj, rj, agree
    have split := rmEUni.sum_succ at R, restrict(polyMonomialTerms(R, p), succ(j)), j with comm, polys, rf
    rw same at split
    have jIn := membership.self_successor at j
    have jN := subS with jIn
    have last : restrict(polyMonomialTerms(R, p), succ(j))(j) = polyMonomial(R, p({(0, j)}), j)
      rw [(restrict.domain_apply at polyMonomialTerms(R, p), ℕ, Ring.carrier(polynomialRing(R, {0})), succ(j), j with fn, subS, jIn), (val with j, jN)]
    rw last at split
    rw split
    have sIn := finiteRingSum.closed at j, Ring.carrier(polynomialRing(R, {0})), Ring.add(polynomialRing(R, {0})), Ring.zero(polynomialRing(R, {0})), Ring.neg(polynomialRing(R, {0})), Ring.mul(polynomialRing(R, {0})), Ring.one(polynomialRing(R, {0})), restrict(polyMonomialTerms(R, p), j) with parts, fin, rj
    have cjIn := uni.coeff_mem at R, p, j with comm, pIn
    unfold polyCoeff at cjIn
    have mIn := rmEUni.monomial_mem at R, p({(0, j)}), j with comm, polys, cjIn
    have add := polyCoeff.add at R, finiteRingSum(j, Ring.carrier(polynomialRing(R, {0})), Ring.add(polynomialRing(R, {0})), Ring.zero(polynomialRing(R, {0})), Ring.neg(polynomialRing(R, {0})), Ring.mul(polynomialRing(R, {0})), Ring.one(polynomialRing(R, {0})), restrict(polyMonomialTerms(R, p), j)), polyMonomial(R, p({(0, j)}), j), k with comm, polys, sIn, mIn
    rw add
    obtain ⟨inj, outj⟩ := ih with k, kIn
    have mc := polyMonomial.coeff at R, p({(0, j)}), j, k with comm, polys, cjIn
    have pkIn := uni.coeff_mem at R, p, k with comm, pIn
    have zeroIn : R[0] ∈ R.carrier by typecheck
    constructor
    . intro kS
      have si := natural.successor_as_insert at j
      rw si at kS
      rcases (insert.membership at k, j, j).forward with kS with kj | kInJ
      . have kOut : k ∉ j
          rw kj
          exact membership.irreflexive at j
        rw [(outj with kOut), (mc.left with kj)]
        unfold polyCoeff
        rw kj
        ring
      . have kne : k ≠ j
          intro kj
          rw kj at kInJ
          exact (membership.irreflexive at j) with kInJ
        rw [(inj with kInJ), (mc.right with kne)]
        ring
    . intro kOut
      have kOutJ : k ∉ j
        intro kInJ
        exact kOut with (subJ with kInJ)
      have kne : k ≠ j
        intro kj
        rw kj at kOut
        exact kOut with jIn
      rw [(outj with kOutJ), (mc.right with kne)]
      ring

-- Every polynomial is the sum of its monomials up to its degree
-- (Polynomial.as_sum_range).
theorem polynomial.as_sum (p : polynomialRing(R, {0}))
  shows p = finiteRingSum(succ(polyNatDegree(R, p)),
    Ring.carrier(polynomialRing(R, {0})), Ring.add(polynomialRing(R, {0})),
    Ring.zero(polynomialRing(R, {0})), Ring.neg(polynomialRing(R, {0})),
    Ring.mul(polynomialRing(R, {0})), Ring.one(polynomialRing(R, {0})),
    restrict(polyMonomialTerms(R, p), succ(polyNatDegree(R, p))))
proof
  have pIn : p ∈ Ring.carrier(polynomialRing(R, {0})) by assumption
  have ps := rmEUni.partial_sum at R, p, succ(polyNatDegree(R, p)) with comm, polys, pIn
  have sIn : finiteRingSum(succ(polyNatDegree(R, p)), Ring.carrier(polynomialRing(R, {0})), Ring.add(polynomialRing(R, {0})), Ring.zero(polynomialRing(R, {0})), Ring.neg(polynomialRing(R, {0})), Ring.mul(polynomialRing(R, {0})), Ring.one(polynomialRing(R, {0})), restrict(polyMonomialTerms(R, p), succ(polyNatDegree(R, p)))) ∈ Ring.carrier(polynomialRing(R, {0}))
    have parts := CommRing.parts with polys
    obtain ⟨fn, _⟩ := rmEUni.terms_function at R, p with comm, polys, pIn
    have subS : succ(polyNatDegree(R, p)) ⊆ ℕ
      intros x hx
      have xNat := natural.member at succ(polyNatDegree(R, p)) with hx
      exact nat.omega.forward with xNat
    have rf := restrict.domain_function at polyMonomialTerms(R, p), ℕ, Ring.carrier(polynomialRing(R, {0})), succ(polyNatDegree(R, p)) with fn, subS
    have fin := Finite.natural at succ(polyNatDegree(R, p))
    exact finiteRingSum.closed at succ(polyNatDegree(R, p)), Ring.carrier(polynomialRing(R, {0})), Ring.add(polynomialRing(R, {0})), Ring.zero(polynomialRing(R, {0})), Ring.neg(polynomialRing(R, {0})), Ring.mul(polynomialRing(R, {0})), Ring.one(polynomialRing(R, {0})), restrict(polyMonomialTerms(R, p), succ(polyNatDegree(R, p))) with parts, fin, rf
  apply polynomial.ext at R, p, finiteRingSum(succ(polyNatDegree(R, p)), Ring.carrier(polynomialRing(R, {0})), Ring.add(polynomialRing(R, {0})), Ring.zero(polynomialRing(R, {0})), Ring.neg(polynomialRing(R, {0})), Ring.mul(polynomialRing(R, {0})), Ring.one(polynomialRing(R, {0})), restrict(polyMonomialTerms(R, p), succ(polyNatDegree(R, p)))) with comm, polys, pIn, sIn
  intros k kIn
  have kNat := nat.omega.backward with kIn
  obtain ⟨inS, outS⟩ := ps with k, kIn
  by_cases kS : k ∈ succ(polyNatDegree(R, p))
  . rw (inS with kS)
  . rw (outS with kS)
    have lt : polyNatDegree(R, p) < k
      by_contra nlt
      have le : k ≤ polyNatDegree(R, p) by arith
      exact kS with (membership.successor_of_LessEqual at k, polyNatDegree(R, p) with le)
    exact polyNatDegree.coeff_zero_of_lt at R, p, k with comm, polys, pIn, lt

theorem polyNatDegree.le_iff (p : polynomialRing(R, {0})) (n : Nat)
  shows polyNatDegree(R, p) ≤ n ↔ PolyDegreeLE(R, p, n)
proof
  have pIn : p ∈ Ring.carrier(polynomialRing(R, {0})) by assumption
  have spec := uni.deg_spec at R, p with comm, polys
  constructor
  . intro le
    unfold PolyDegreeLE
    refine ⟨pIn, ?_⟩
    intros k hk
    unfold polyDegrees at hk
    obtain ⟨kN, nz⟩ := hk
    have kNat := nat.omega.backward with kN
    have nz2 : polyCoeff(p, k) ≠ R[0]
      unfold polyCoeff
      exact nz
    have l := spec.left with k, kN, nz2
    arith
  . intro bound
    obtain ⟨_, below⟩ := bound
    apply uni.deg_le at R, p, n with comm, polys
    intros k hk lt
    have kNat := nat.omega.backward with hk
    by_contra nz
    have kd : k ∈ polyDegrees(R, p)
      unfold polyDegrees
      unfold polyCoeff at nz
      exact ⟨hk, nz⟩
    have l := below with k, kd
    arith

theorem polyNatDegree.C (a : R)
  shows polyNatDegree(R, polyC(R, a)) = 0
proof
  have cIn := polyC.mem at R, a with comm, polys
  have le := uni.deg_le at R, polyC(R, a), 0 with comm, polys
  have bound : polyNatDegree(R, polyC(R, a)) ≤ 0
    apply le
    intros k hk lt
    have kNat := nat.omega.backward with hk
    have ne : k ≠ 0 by arith
    have c := polyC.coeff at R, a, k with comm, polys
    exact c.right with ne
  arith

theorem polyNatDegree.X_sub_C (a : R)
  requires nontrivial : R[0] ≠ R[1]
  shows polyNatDegree(R, polyXSubC(R, a)) = 1
proof
  have xIn := polyX.mem at R with comm, polys
  have cIn := polyC.mem at R, a with comm, polys
  have pr := CommRing.to_ring with polys
  have dIn : polyXSubC(R, a) ∈ Ring.carrier(polynomialRing(R, {0}))
    unfold polyXSubC
    exact Ring.sub_mem with *
  have coeff : ∀ k ∈ ℕ, polyCoeff(polyXSubC(R, a), k) = polyCoeff(polyX(R), k) - polyCoeff(polyC(R, a), k)
    intros k hk
    have kNat := nat.omega.backward with hk
    unfold polyXSubC
    exact uni.coeff_sub at R, polyX(R), polyC(R, a), k with comm, polys, xIn, cIn
  have le := uni.deg_le at R, polyXSubC(R, a), 1 with comm, polys, dIn
  have upper : polyNatDegree(R, polyXSubC(R, a)) ≤ 1
    apply le
    intros k hk lt
    have kNat := nat.omega.backward with hk
    rw (coeff with k, hk)
    have n1 : k ≠ 1 by arith
    have n0 : k ≠ 0 by arith
    rw ((uni.X_coeff at R, k with comm, polys).right with n1)
    rw ((polyC.coeff at R, a, k with comm, polys).right with n0)
    ring
  have spec := uni.deg_spec at R, polyXSubC(R, a) with comm, polys, dIn
  have oneN : (1:Nat) ∈ ℕ by typecheck
  have c1 : polyCoeff(polyXSubC(R, a), 1) = R[1]
    rw (coeff with 1, oneN)
    have e1 : (1:Nat) = 1 by rfl
    have n0 : (1:Nat) ≠ 0 by arith
    rw ((uni.X_coeff at R, 1 with comm, polys).left with e1)
    rw ((polyC.coeff at R, a, 1 with comm, polys).right with n0)
    ring
  have nz : polyCoeff(polyXSubC(R, a), 1) ≠ R[0]
    rw c1
    intro e
    apply nontrivial
    rw e
  have lower := spec.left with 1, oneN, nz
  arith

theorem polyNatDegree.add_le (p q : polynomialRing(R, {0})) (n : Nat)
  requires first : PolyDegreeLE(R, p, n)
  requires second : PolyDegreeLE(R, q, n)
  shows PolyDegreeLE(R, p + q, n)
proof
  have pr := CommRing.to_ring with polys
  have sIn : p + q ∈ Ring.carrier(polynomialRing(R, {0})) := Ring.add_mem with *
  have vp := uni.vanish_of_le at R, p, n with comm, polys, first
  have vq := uni.vanish_of_le at R, q, n with comm, polys, second
  unfold PolyDegreeLE
  refine ⟨sIn, ?_⟩
  intros k hk
  unfold polyDegrees at hk
  obtain ⟨kN, nz⟩ := hk
  have kNat := nat.omega.backward with kN
  by_contra big
  have lt : n < k by arith
  have e := polyCoeff.add at R, p, q, k with comm, polys
  rw [(vp with k, kN, lt), (vq with k, kN, lt)] at e
  have z : R[0] + R[0] = R[0] by ring
  rw z at e
  unfold polyCoeff at e
  apply nz
  exact e

theorem polyNatDegree.mul_le (p q : polynomialRing(R, {0})) (m n : Nat)
  requires first : PolyDegreeLE(R, p, m)
  requires second : PolyDegreeLE(R, q, n)
  shows PolyDegreeLE(R, p * q, m + n)
proof
  have pr := CommRing.to_ring with polys
  have sIn : p * q ∈ Ring.carrier(polynomialRing(R, {0})) := Ring.mul_mem with *
  have vp := uni.vanish_of_le at R, p, m with comm, polys, first
  have vq := uni.vanish_of_le at R, q, n with comm, polys, second
  have v := uni.mul_vanish at R, p, q, m, n with comm, polys, vp, vq
  unfold PolyDegreeLE
  refine ⟨sIn, ?_⟩
  intros k hk
  unfold polyDegrees at hk
  obtain ⟨kN, nz⟩ := hk
  have kNat := nat.omega.backward with kN
  by_contra big
  have lt : m + n < k by arith
  have e := v with k, kN, lt
  unfold polyCoeff at e
  apply nz
  exact e

theorem polyNatDegree.mul (p q : polynomialRing(R, {0}))
  requires domain : IntegralDomain(R)
  requires firstNonzero : p ≠ Ring.zero(polynomialRing(R, {0}))
  requires secondNonzero : q ≠ Ring.zero(polynomialRing(R, {0}))
  shows polyNatDegree(R, p * q) = polyNatDegree(R, p) + polyNatDegree(R, q)
proof
  have pr := CommRing.to_ring with polys
  have sIn : p * q ∈ Ring.carrier(polynomialRing(R, {0})) := Ring.mul_mem with *
  obtain ⟨_, _, noZero⟩ := domain
  have sp := uni.deg_spec at R, p with comm, polys
  have sq := uni.deg_spec at R, q with comm, polys
  have vp := uni.vanish_deg at R, p with comm, polys
  have vq := uni.vanish_deg at R, q with comm, polys
  have top := uni.mul_top at R, p, q, polyNatDegree(R, p), polyNatDegree(R, q) with comm, polys, vp, vq
  have v := uni.mul_vanish at R, p, q, polyNatDegree(R, p), polyNatDegree(R, q) with comm, polys, vp, vq
  have upper := uni.deg_le at R, p * q, polyNatDegree(R, p) + polyNatDegree(R, q) with comm, polys, sIn, v
  have lp := sp.right with firstNonzero
  have lq := sq.right with secondNonzero
  have pIn : p ∈ Ring.carrier(polynomialRing(R, {0})) by assumption
  have qIn : q ∈ Ring.carrier(polynomialRing(R, {0})) by assumption
  have cp := uni.coeff_mem at R, p, polyNatDegree(R, p) with comm, pIn
  have cq := uni.coeff_mem at R, q, polyNatDegree(R, q) with comm, qIn
  have prodNz : polyCoeff(p * q, polyNatDegree(R, p) + polyNatDegree(R, q)) ≠ R[0]
    rw top
    intro z
    have alt := noZero with polyCoeff(p, polyNatDegree(R, p)), cp, polyCoeff(q, polyNatDegree(R, q)), cq, z
    cases alt with a | b
    . apply lp
      exact a
    . apply lq
      exact b
  have spq := uni.deg_spec at R, p * q with comm, polys, sIn
  have sumN : polyNatDegree(R, p) + polyNatDegree(R, q) ∈ ℕ by typecheck
  have lower := spq.left with polyNatDegree(R, p) + polyNatDegree(R, q), sumN, prodNz
  arith

-- Leading coefficients multiply over a domain (Polynomial.leadingCoeff_mul),
-- and R[X] is a domain when R is (Polynomial.instIsDomain).
theorem polyLeadingCoeff.mul (p q : polynomialRing(R, {0}))
  requires domain : IntegralDomain(R)
  shows polyLeadingCoeff(R, p * q) =
    call2(R.mul, polyLeadingCoeff(R, p), polyLeadingCoeff(R, q))
proof
  have pIn : p ∈ Ring.carrier(polynomialRing(R, {0})) by assumption
  have qIn : q ∈ Ring.carrier(polynomialRing(R, {0})) by assumption
  have dp : polyNatDegree(R, p) ∈ ℕ
    have sel := polyNatDegree.selected at R, p with comm, pIn
    exact sel.left
  have dq : polyNatDegree(R, q) ∈ ℕ
    have sel := polyNatDegree.selected at R, q with comm, qIn
    exact sel.left
  have dpN := nat.omega.backward with dp
  have dqN := nat.omega.backward with dq
  have cp := uni.coeff_mem at R, p, polyNatDegree(R, p) with comm, pIn
  have cq := uni.coeff_mem at R, q, polyNatDegree(R, q) with comm, qIn
  rw [(uni.lead_eq at R, p with comm, polys), (uni.lead_eq at R, q with comm, polys)]
  by_cases pz : p = Ring.zero(polynomialRing(R, {0}))
  . have e : p * q = Ring.zero(polynomialRing(R, {0}))
      rw pz
      ring
    rw e
    rw (uni.lead_zero at R with comm, polys)
    rw pz at cp
    rw pz
    rw (uni.zero_coeff at R, polyNatDegree(R, Ring.zero(polynomialRing(R, {0}))) with comm, polys)
    ring
  . by_cases qz : q = Ring.zero(polynomialRing(R, {0}))
    . have e : p * q = Ring.zero(polynomialRing(R, {0}))
        rw qz
        ring
      rw e
      rw (uni.lead_zero at R with comm, polys)
      rw qz at cq
      rw qz
      rw (uni.zero_coeff at R, polyNatDegree(R, Ring.zero(polynomialRing(R, {0}))) with comm, polys)
      ring
    . have deg := polyNatDegree.mul at R, p, q with comm, polys, pIn, qIn, domain, pz, qz
      rw (uni.lead_eq at R, p * q with comm, polys)
      rw deg
      have vp := uni.vanish_deg at R, p with comm, polys, pIn
      have vq := uni.vanish_deg at R, q with comm, polys, qIn
      exact uni.mul_top at R, p, q, polyNatDegree(R, p), polyNatDegree(R, q) with comm, polys, pIn, qIn, vp, vq

theorem polynomialRing.domain
  requires domain : IntegralDomain(R)
  shows IntegralDomain(polynomialRing(R, {0}))
proof
  have dom := domain
  obtain ⟨_, nontrivial, _⟩ := dom
  have pr := CommRing.to_ring with polys
  unfold IntegralDomain
  refine ⟨polys, ?_, ?_⟩
  . intro e
    apply nontrivial
    have z := uni.zero_coeff at R, 0 with comm, polys
    rw e at z
    rw (uni.one_eq at R with comm, polys) at z
    have oneIn : R[1] ∈ R.carrier by typecheck
    have c := polyC.coeff at R, R[1], 0 with comm, polys, oneIn
    have e0 : (0:Nat) = 0 by rfl
    rw (c.left with e0) at z
    rw z
  . intros x hx y hy prod
    by_contra both
    have xz : x ≠ Ring.zero(polynomialRing(R, {0})) by tauto
    have yz : y ≠ Ring.zero(polynomialRing(R, {0})) by tauto
    have l := polyLeadingCoeff.mul at R, x, y with comm, polys, hx, hy, domain
    rw prod at l
    rw (uni.lead_zero at R with comm, polys) at l
    have sx := uni.deg_spec at R, x with comm, polys, hx
    have sy := uni.deg_spec at R, y with comm, polys, hy
    have lx := sx.right with xz
    have ly := sy.right with yz
    rw (uni.lead_eq at R, x with comm, polys) at l
    rw (uni.lead_eq at R, y with comm, polys) at l
    obtain ⟨_, _, noZero⟩ := domain
    have dx : polyNatDegree(R, x) ∈ ℕ
      have sel := polyNatDegree.selected at R, x with comm, hx
      exact sel.left
    have dy : polyNatDegree(R, y) ∈ ℕ
      have sel := polyNatDegree.selected at R, y with comm, hy
      exact sel.left
    have dxN := nat.omega.backward with dx
    have dyN := nat.omega.backward with dy
    have cx := uni.coeff_mem at R, x, polyNatDegree(R, x) with comm, hx
    have cy := uni.coeff_mem at R, y, polyNatDegree(R, y) with comm, hy
    have l2 : polyCoeff(x, polyNatDegree(R, x)) * polyCoeff(y, polyNatDegree(R, y)) = R.zero
      rw ← l
    have alt := noZero with polyCoeff(x, polyNatDegree(R, x)), cx, polyCoeff(y, polyNatDegree(R, y)), cy, l2
    cases alt with a | b
    . apply lx
      exact a
    . apply ly
      exact b

-- Monic polynomials: X − a and Xⁿ − a are monic (Polynomial.monic_X_sub_C,
-- monic_X_pow_sub_C, monic_X), products and powers of monic polynomials
-- are monic with additive degree (Monic.mul, Monic.pow,
-- natDegree_mul' for monic), and a monic polynomial over a nontrivial ring
-- is nonzero (Monic.ne_zero).
theorem PolyMonic.X_sub_C (a : R)
  shows PolyMonic(R, polyXSubC(R, a))
proof
  have c := uni.XsubC_coeff at R, a with comm, polys
  have m := uni.XsubC_mem at R, a with comm, polys
  have r := uni.monic_of at R, polyXSubC(R, a), 1 with comm, polys, m, c.left, c.right
  exact r.left

theorem PolyMonic.X
  shows PolyMonic(R, polyX(R))
proof
  have xIn := polyX.mem at R with comm, polys
  have e1 : (1:Nat) = 1 by rfl
  have top := (uni.X_coeff at R, 1 with comm, polys).left with e1
  have vanish : ∀ k ∈ ℕ, 1 < k → polyCoeff(polyX(R), k) = R[0]
    intros k hk lt
    have kNat := nat.omega.backward with hk
    have n1 : k ≠ 1 by arith
    exact (uni.X_coeff at R, k with comm, polys).right with n1
  have r := uni.monic_of at R, polyX(R), 1 with comm, polys, xIn, top, vanish
  exact r.left

theorem PolyMonic.X_pow_sub_C (a : R) (n : Nat)
  requires positive : 0 < n
  shows PolyMonic(R, Ring.sub(polynomialRing(R, {0}),
    Ring.pow(polynomialRing(R, {0}), polyX(R), n), polyC(R, a)))
proof
  have pr := CommRing.to_ring with polys
  have oneIn : R.one ∈ R.carrier by typecheck
  have xIn := polyX.mem at R with comm, polys
  have cIn := polyC.mem at R, a with comm, polys
  have xn : Ring.pow(polynomialRing(R, {0}), polyX(R), n) ∈ Ring.carrier(polynomialRing(R, {0}))
    rw (uni.X_pow at R, n with comm, polys)
    exact uni.term_mem at R, R.one, n with comm, polys, oneIn
  have m : Ring.sub(polynomialRing(R, {0}), Ring.pow(polynomialRing(R, {0}), polyX(R), n), polyC(R, a)) ∈ Ring.carrier(polynomialRing(R, {0})) := Ring.sub_mem with *
  have coeff : ∀ k ∈ ℕ, polyCoeff(Ring.sub(polynomialRing(R, {0}), Ring.pow(polynomialRing(R, {0}), polyX(R), n), polyC(R, a)), k) = polyCoeff(Ring.pow(polynomialRing(R, {0}), polyX(R), n), k) - polyCoeff(polyC(R, a), k)
    intros k hk
    have kNat := nat.omega.backward with hk
    exact uni.coeff_sub at R, Ring.pow(polynomialRing(R, {0}), polyX(R), n), polyC(R, a), k with comm, polys, xn, cIn
  have nN : n ∈ ℕ by typecheck
  have top : polyCoeff(Ring.sub(polynomialRing(R, {0}), Ring.pow(polynomialRing(R, {0}), polyX(R), n), polyC(R, a)), n) = R[1]
    rw (coeff with n, nN)
    rw (uni.X_pow at R, n with comm, polys)
    have en : n = n by rfl
    have n0 : n ≠ 0 by arith
    rw ((uni.term_coeff at R, R.one, n, n with comm, polys, oneIn).left with en)
    rw ((polyC.coeff at R, a, n with comm, polys).right with n0)
    ring
  have vanish : ∀ k ∈ ℕ, n < k → polyCoeff(Ring.sub(polynomialRing(R, {0}), Ring.pow(polynomialRing(R, {0}), polyX(R), n), polyC(R, a)), k) = R[0]
    intros k hk lt
    have kNat := nat.omega.backward with hk
    rw (coeff with k, hk)
    rw (uni.X_pow at R, n with comm, polys)
    have kn : k ≠ n by arith
    have k0 : k ≠ 0 by arith
    rw ((uni.term_coeff at R, R.one, n, k with comm, polys, oneIn).right with kn)
    rw ((polyC.coeff at R, a, k with comm, polys).right with k0)
    ring
  have r := uni.monic_of at R, Ring.sub(polynomialRing(R, {0}), Ring.pow(polynomialRing(R, {0}), polyX(R), n), polyC(R, a)), n with comm, polys, m, top, vanish
  exact r.left

theorem PolyMonic.mul (p q : polynomialRing(R, {0}))
  requires first : PolyMonic(R, p)
  requires second : PolyMonic(R, q)
  shows PolyMonic(R, p * q) ∧
    polyNatDegree(R, p * q) = polyNatDegree(R, p) + polyNatDegree(R, q)
proof
  have pr := CommRing.to_ring with polys
  have pIn : p ∈ Ring.carrier(polynomialRing(R, {0})) by assumption
  have qIn : q ∈ Ring.carrier(polynomialRing(R, {0})) by assumption
  have sIn : p * q ∈ Ring.carrier(polynomialRing(R, {0})) := Ring.mul_mem with *
  have dp : polyNatDegree(R, p) ∈ ℕ
    have sel := polyNatDegree.selected at R, p with comm, pIn
    exact sel.left
  have dq : polyNatDegree(R, q) ∈ ℕ
    have sel := polyNatDegree.selected at R, q with comm, qIn
    exact sel.left
  have dpN := nat.omega.backward with dp
  have dqN := nat.omega.backward with dq
  have vp := uni.vanish_deg at R, p with comm, polys, pIn
  have vq := uni.vanish_deg at R, q with comm, polys, qIn
  have topEq := uni.mul_top at R, p, q, polyNatDegree(R, p), polyNatDegree(R, q) with comm, polys, pIn, qIn, vp, vq
  have v := uni.mul_vanish at R, p, q, polyNatDegree(R, p), polyNatDegree(R, q) with comm, polys, pIn, qIn, vp, vq
  have lp := first.right
  have lq := second.right
  rw (uni.lead_eq at R, p with comm, polys) at lp
  rw (uni.lead_eq at R, q with comm, polys) at lq
  rw [lp, lq] at topEq
  have one : R[1] * R[1] = R[1] by ring
  rw one at topEq
  have r := uni.monic_of at R, p * q, polyNatDegree(R, p) + polyNatDegree(R, q) with comm, polys, sIn, topEq, v
  refine ⟨r.left, ?_⟩
  by_cases nontrivial : R[0] ≠ R[1]
  . exact r.right with nontrivial
  . have triv : R[0] = R[1] by tauto
    rw [(uni.trivial_deg at R, p * q with comm, polys, sIn, triv), (uni.trivial_deg at R, p with comm, polys, pIn, triv), (uni.trivial_deg at R, q with comm, polys, qIn, triv)]
    arith

theorem PolyMonic.pow (p : polynomialRing(R, {0})) (n : Nat)
  requires monic : PolyMonic(R, p)
  shows PolyMonic(R, p ^ n)
proof
  induction n
  | zero =>
    have pr := CommRing.to_ring with polys
    have pIn : p ∈ Ring.carrier(polynomialRing(R, {0})) by assumption
    rw (Ring.pow_zero at polynomialRing(R, {0}), p with pr, pIn)
    rw (uni.one_eq at R with comm, polys)
    have oneIn : R[1] ∈ R.carrier by typecheck
    have cIn := polyC.mem at R, R[1] with comm, polys, oneIn
    have e0 : (0:Nat) = 0 by rfl
    have top := (polyC.coeff at R, R[1], 0 with comm, polys, oneIn).left with e0
    have vanish : ∀ k ∈ ℕ, 0 < k → polyCoeff(polyC(R, R[1]), k) = R[0]
      intros k hk lt
      have kNat := nat.omega.backward with hk
      have k0 : k ≠ 0 by arith
      exact (polyC.coeff at R, R[1], k with comm, polys, oneIn).right with k0
    have r := uni.monic_of at R, polyC(R, R[1]), 0 with comm, polys, cIn, top, vanish
    exact r.left
  | succ(m) using ih =>
    have pr := CommRing.to_ring with polys
    have pIn : p ∈ Ring.carrier(polynomialRing(R, {0})) by assumption
    have sm : succ(m) = m + 1 by arith
    rw sm
    rw (Ring.pow_succ at polynomialRing(R, {0}), p, m with pr, pIn)
    have pm : p ^ m ∈ Ring.carrier(polynomialRing(R, {0})) by typecheck
    have r := PolyMonic.mul at R, p ^ m, p with comm, polys, pm, pIn, ih, monic
    exact r.left

theorem PolyMonic.ne_zero (p : polynomialRing(R, {0}))
  requires nontrivial : R[0] ≠ R[1]
  requires monic : PolyMonic(R, p)
  shows p ≠ Ring.zero(polynomialRing(R, {0}))
proof
  have l := monic.right
  intro z
  rw z at l
  rw (uni.lead_zero at R with comm, polys) at l
  apply nontrivial
  exact l

-- Evaluation: polyEval is a ring homomorphism R[X] → R
-- (Polynomial.eval_add, eval_mul, eval_pow, eval_C, eval_X), and so
-- is eval₂ along f : R →+* S (Polynomial.eval₂RingHom), with
-- eval₂ f x (C a) = f a, eval₂ f x X = x (Polynomial.eval₂_C, eval₂_X).
theorem polyEval.hom (a : R)
  shows RingHom(evaluationAt(R, {0}, constantFunction({0}, R.carrier, a)),
    polynomialRing(R, {0}), R)
proof
  have zero : 0 ∈ {0} by simp [singleton.membership]
  have v := constantFunction.function at {0}, R.carrier, a with *
  exact evaluationAt.hom at R, {0}, constantFunction({0}, R.carrier, a) with comm, v

theorem polyEval.mul (p q : polynomialRing(R, {0})) (a : R)
  shows polyEval(R, p * q, a) = call2(R.mul, polyEval(R, p, a), polyEval(R, q, a))
proof
  have h := polyEval.hom at R, a with comm, polys
  unfold polyEval
  exact RingHom.map_mul at evaluationAt(R, {0}, constantFunction({0}, R.carrier, a)), polynomialRing(R, {0}), R, p, q with h

theorem polyEval.add (p q : polynomialRing(R, {0})) (a : R)
  shows polyEval(R, p + q, a) = call2(R.add, polyEval(R, p, a), polyEval(R, q, a))
proof
  have h := polyEval.hom at R, a with comm, polys
  unfold polyEval
  exact RingHom.map_add at evaluationAt(R, {0}, constantFunction({0}, R.carrier, a)), polynomialRing(R, {0}), R, p, q with h

theorem polyEval.C (a b : R)
  shows polyEval(R, polyC(R, a), b) = a
proof
  have v := constantFunction.function at {0}, R.carrier, b with *
  unfold polyEval
  unfold polyC
  exact evaluationAt.map_constant at R, {0}, constantFunction({0}, R.carrier, b), a with comm, v

theorem polyEval.X (b : R)
  shows polyEval(R, polyX(R), b) = b
proof
  have zero : 0 ∈ {0} by simp [singleton.membership]
  have bIn : b ∈ R.carrier by typecheck
  have v := constantFunction.function at {0}, R.carrier, b with *
  unfold polyEval
  unfold polyX
  rw (evaluationAt.map_X at R, {0}, constantFunction({0}, R.carrier, b), 0 with comm, v, zero)
  exact constantFunction.apply at {0}, R.carrier, 0, b with zero, bIn

theorem polyEval.X_sub_C (a b : R)
  shows polyEval(R, polyXSubC(R, a), b) = b - a
proof
  have h := polyEval.hom at R, b with comm, polys
  have xIn := polyX.mem at R with comm, polys
  have cIn := polyC.mem at R, a with comm, polys
  have e1 := polyEval.X at R, b with comm, polys
  have e2 := polyEval.C at R, a, b with comm, polys
  unfold polyEval at e1
  unfold polyEval at e2
  unfold polyXSubC
  unfold polyEval
  rw (RingHom.map_sub at evaluationAt(R, {0}, constantFunction({0}, R.carrier, b)), polynomialRing(R, {0}), R, polyX(R), polyC(R, a) with h)
  rw [e1, e2]

-- Helper: the value terms of p at b form a function on ℕ.
theorem rmEUni.value_terms (p b : Set)
  requires pIn : p ∈ Ring.carrier(polynomialRing(R, {0}))
  requires bIn : b ∈ R.carrier
  shows (polyValueTerms(R, p, b) : ℕ → R.carrier) ∧ (∀ i ∈ ℕ, polyValueTerms(R, p, b)(i) = call2(Ring.mul(R), p({(0, i)}), Ring.pow(R, b, i)))
proof
  have fn : polyValueTerms(R, p, b) : ℕ → R.carrier
    unfold FunctionBetween
    refine ⟨?_, ?_, ?_⟩
    . unfold RelationBetween
      intros q hq
      exact (polyValueTerms.membership.forward at R, p, b, q with hq).left
    . unfold Functional
      intros x y hxy z hxz
      unfold relates at hxy
      unfold relates at hxz
      obtain ⟨_, a, aIn, e1⟩ := polyValueTerms.membership.forward at R, p, b, (x, y) with hxy
      obtain ⟨_, c, cIn, e2⟩ := polyValueTerms.membership.forward at R, p, b, (x, z) with hxz
      obtain ⟨x1, y1⟩ := orderedPair.injective with e1
      obtain ⟨x2, z2⟩ := orderedPair.injective with e2
      have ac : a = c
        rw [← x1, ← x2]
      rw [y1, z2, ac]
    . intros i iIn
      have iNat := nat.omega.backward with iIn
      have cIn := uni.coeff_mem at R, p, i with comm, pIn
      unfold polyCoeff at cIn
      have out : call2(Ring.mul(R), p({(0, i)}), Ring.pow(R, b, i)) ∈ R.carrier by typecheck
      have pq := product.pair at i, call2(Ring.mul(R), p({(0, i)}), Ring.pow(R, b, i)), ℕ, R.carrier with iIn, out
      have m := polyValueTerms.membership.backward at R, p, b, (i, call2(Ring.mul(R), p({(0, i)}), Ring.pow(R, b, i))) with ⟨pq, i, iIn, rfl⟩
      witness call2(Ring.mul(R), p({(0, i)}), Ring.pow(R, b, i))
      unfold relates
      exact ⟨out, m⟩
  have val : ∀ i ∈ ℕ, polyValueTerms(R, p, b)(i) = call2(Ring.mul(R), p({(0, i)}), Ring.pow(R, b, i))
    intros i iIn
    have iNat := nat.omega.backward with iIn
    have cIn := uni.coeff_mem at R, p, i with comm, pIn
    unfold polyCoeff at cIn
    have out : call2(Ring.mul(R), p({(0, i)}), Ring.pow(R, b, i)) ∈ R.carrier by typecheck
    have pq := product.pair at i, call2(Ring.mul(R), p({(0, i)}), Ring.pow(R, b, i)), ℕ, R.carrier with iIn, out
    have m := polyValueTerms.membership.backward at R, p, b, (i, call2(Ring.mul(R), p({(0, i)}), Ring.pow(R, b, i))) with ⟨pq, i, iIn, rfl⟩
    have rel : relates(polyValueTerms(R, p, b), i, call2(Ring.mul(R), p({(0, i)}), Ring.pow(R, b, i)))
      unfold relates
      exact m
    exact FunctionBetween.apply_value with fn, iIn, rel
  exact ⟨fn, val⟩

-- Polynomial.eval_eq_sum_range and coeff_zero_eq_eval_zero.
theorem polyEval.as_sum (p : polynomialRing(R, {0})) (b : R)
  shows polyEval(R, p, b) = finiteRingSum(succ(polyNatDegree(R, p)), R.carrier,
    R.add, R.zero, R.neg, R.mul, R.one,
    restrict(polyValueTerms(R, p, b), succ(polyNatDegree(R, p))))
proof
  have pIn : p ∈ Ring.carrier(polynomialRing(R, {0})) by assumption
  have bIn : b ∈ R.carrier by assumption
  have h := polyEval.hom at R, b with comm, polys
  have hp := RingHom.parts with h
  have sP := CommRing.parts with polys
  have sR := CommRing.parts with comm
  have expand := polynomial.as_sum at R, p with comm, polys, pIn
  obtain ⟨fn, val⟩ := rmEUni.terms_function at R, p with comm, polys, pIn
  obtain ⟨vfn, vval⟩ := rmEUni.value_terms at R, p, b with comm, polys, pIn, bIn
  have subS : succ(polyNatDegree(R, p)) ⊆ ℕ
    intros x hx
    have xNat := natural.member at succ(polyNatDegree(R, p)) with hx
    exact nat.omega.forward with xNat
  have rf := restrict.domain_function at polyMonomialTerms(R, p), ℕ, Ring.carrier(polynomialRing(R, {0})), succ(polyNatDegree(R, p)) with fn, subS
  have rv := restrict.domain_function at polyValueTerms(R, p, b), ℕ, R.carrier, succ(polyNatDegree(R, p)) with vfn, subS
  have fin := Finite.natural at succ(polyNatDegree(R, p))
  have entries : ∀ i ∈ succ(polyNatDegree(R, p)), restrict(polyValueTerms(R, p, b), succ(polyNatDegree(R, p)))(i) = evaluationAt(R, {0}, constantFunction({0}, R.carrier, b))(restrict(polyMonomialTerms(R, p), succ(polyNatDegree(R, p)))(i))
    intros i iS
    have iN := subS with iS
    have iNat := nat.omega.backward with iN
    rw [(restrict.domain_apply at polyValueTerms(R, p, b), ℕ, R.carrier, succ(polyNatDegree(R, p)), i with vfn, subS, iS), (restrict.domain_apply at polyMonomialTerms(R, p), ℕ, Ring.carrier(polynomialRing(R, {0})), succ(polyNatDegree(R, p)), i with fn, subS, iS), (vval with i, iN), (val with i, iN)]
    have cIn := uni.coeff_mem at R, p, i with comm, pIn
    unfold polyCoeff at cIn
    have cP := polyC.mem at R, p({(0, i)}) with comm, polys, cIn
    have xP := polyX.mem at R with comm, polys
    have xpP : Ring.pow(polynomialRing(R, {0}), polyX(R), i) ∈ Ring.carrier(polynomialRing(R, {0})) by typecheck
    unfold polyMonomial
    have m := polyEval.mul at R, polyC(R, p({(0, i)})), Ring.pow(polynomialRing(R, {0}), polyX(R), i), b with comm, polys, cP, xpP, bIn
    unfold polyEval at m
    rw m
    have ec := polyEval.C at R, p({(0, i)}), b with comm, polys, cIn, bIn
    unfold polyEval at ec
    rw ec
    rw (RingHom.map_pow at polynomialRing(R, {0}), R, evaluationAt(R, {0}, constantFunction({0}, R.carrier, b)), polyX(R), i with polys, comm, h)
    have ex := polyEval.X at R, b with comm, polys, bIn
    unfold polyEval at ex
    rw ex
  have m := finiteRingSum.map at Ring.carrier(polynomialRing(R, {0})), Ring.add(polynomialRing(R, {0})), Ring.zero(polynomialRing(R, {0})), Ring.neg(polynomialRing(R, {0})), Ring.mul(polynomialRing(R, {0})), Ring.one(polynomialRing(R, {0})), R.carrier, R.add, R.zero, R.neg, R.mul, R.one, evaluationAt(R, {0}, constantFunction({0}, R.carrier, b)), succ(polyNatDegree(R, p)), restrict(polyMonomialTerms(R, p), succ(polyNatDegree(R, p))), restrict(polyValueTerms(R, p, b), succ(polyNatDegree(R, p))) with sP, sR, hp, fin, rf, rv, entries
  have pe : polyEval(R, p, b) = polyEval(R, finiteRingSum(succ(polyNatDegree(R, p)), Ring.carrier(polynomialRing(R, {0})), Ring.add(polynomialRing(R, {0})), Ring.zero(polynomialRing(R, {0})), Ring.neg(polynomialRing(R, {0})), Ring.mul(polynomialRing(R, {0})), Ring.one(polynomialRing(R, {0})), restrict(polyMonomialTerms(R, p), succ(polyNatDegree(R, p)))), b)
    cc [expand]
  rw pe
  unfold polyEval
  exact m

theorem polyEval.zero_point (p : polynomialRing(R, {0}))
  shows polyEval(R, p, R[0]) = polyCoeff(p, 0)
proof
  have zero : 0 ∈ {0} by simp [singleton.membership]
  have pIn : p ∈ Ring.carrier(polynomialRing(R, {0})) by assumption
  have zIn : R[0] ∈ R.carrier by typecheck
  have v0 := constantFunction.function at {0}, R.carrier, R[0] with *
  have eh := evaluationAt.hom at R, {0}, constantFunction({0}, R.carrier, R[0]) with comm, v0
  have oh := polynomialAtOrigin.bundled_hom at R with comm
  have eq : polynomialAtOrigin({0}, R.carrier, R.zero) = evaluationAt(R, {0}, constantFunction({0}, R.carrier, R[0]))
    apply polynomialRing.hom_ext at R, {0}, R, polynomialAtOrigin({0}, R.carrier, R.zero), evaluationAt(R, {0}, constantFunction({0}, R.carrier, R[0])) with comm, oh, eh
    . intros a ha
      have cIn := polynomialConstant.mem at R, {0}, a with comm, ha
      rw ← (polyCoeff.zero_origin at R, polynomialConstant(R, {0})(a) with cIn)
      rw (evaluationAt.map_constant at R, {0}, constantFunction({0}, R.carrier, R[0]), a with comm, v0, ha)
      have c := polyC.coeff at R, a, 0 with comm, polys, ha
      unfold polyC at c
      have e0 : (0:Nat) = 0 by rfl
      exact c.left with e0
    . intros j hj
      have xIn := X.mem at R, {0}, j with comm
      rw ← (polyCoeff.zero_origin at R, X(R, {0}, j) with xIn)
      rw (evaluationAt.map_X at R, {0}, constantFunction({0}, R.carrier, R[0]), j with comm, v0, hj)
      rw singleton.membership at hj
      rw hj
      rw (constantFunction.apply at {0}, R.carrier, 0, R[0] with zero, zIn)
      have c := uni.X_coeff at R, 0 with comm, polys
      unfold polyX at c
      have n1 : (0:Nat) ≠ 1 by arith
      exact c.right with n1
  rw (polyCoeff.zero_origin at R, p with pIn)
  rw eq
  unfold polyEval
  rfl

-- Helper: the family of values i ↦ w(i)(b) is a function on n.
theorem uni.family_values (n w b : Set)
  requires values : ∀ i ∈ n, polyEval(R, w(i), b) ∈ R.carrier
  shows (polyFamilyValues(R, n, w, b) : n → R.carrier) ∧
    (∀ i ∈ n, polyFamilyValues(R, n, w, b)(i) = polyEval(R, w(i), b))
proof
  have rel : ∀ i ∈ n, relates(polyFamilyValues(R, n, w, b), i, polyEval(R, w(i), b))
    intros i hi
    have vIn := values with i, hi
    unfold relates
    apply polyFamilyValues.membership.backward
    refine ⟨(product.pair at i, polyEval(R, w(i), b), n, R.carrier with hi, vIn), i, hi, rfl⟩
  have fn : polyFamilyValues(R, n, w, b) : n → R.carrier
    constructor
      intros q0 mem
      obtain ⟨bounded, _⟩ := polyFamilyValues.membership.forward with mem
      exact bounded
    . constructor
        intros z0 first xFirst second xSecond
        unfold relates at xFirst
        obtain ⟨_, a1, a1In, firstShape⟩ := polyFamilyValues.membership.forward with xFirst
        unfold relates at xSecond
        obtain ⟨_, a2, a2In, secondShape⟩ := polyFamilyValues.membership.forward with xSecond
        obtain ⟨xi, firstEqual⟩ := orderedPair.injective with firstShape
        obtain ⟨xj, secondEqual⟩ := orderedPair.injective with secondShape
        rw [firstEqual, secondEqual]
        cc
      . intros i xIn
        have vIn := values with i, xIn
        refine ⟨polyEval(R, w(i), b), vIn, (rel with i, xIn)⟩
  refine ⟨fn, ?_⟩
  intros i hi
  exact FunctionBetween.apply_value with fn, hi, (rel with i, hi)

-- Polynomial.eval_prod over a finite index set.
theorem polyEval.prod (n w : Set) (b : R)
  requires natural : Nat(n)
  requires factors : w : n → Ring.carrier(polynomialRing(R, {0}))
  shows polyEval(R, finiteRingProduct(n, Ring.carrier(polynomialRing(R, {0})),
      Ring.add(polynomialRing(R, {0})), Ring.zero(polynomialRing(R, {0})),
      Ring.neg(polynomialRing(R, {0})), Ring.mul(polynomialRing(R, {0})),
      Ring.one(polynomialRing(R, {0})), w), b) =
    finiteRingProduct(n, R.carrier, R.add, R.zero, R.neg, R.mul, R.one,
      polyFamilyValues(R, n, w, b))
proof
  have bIn : b ∈ R.carrier by assumption
  have h := polyEval.hom at R, b with comm, polys, bIn
  have hp := RingHom.parts with h
  have sp := CommRing.parts with polys
  have rp := CommRing.parts with comm
  have values : ∀ i ∈ n, polyEval(R, w(i), b) ∈ R.carrier
    intros i hi
    have wi := FunctionBetween.apply_closed with factors, hi
    unfold polyEval
    exact RingHom.map_mem at evaluationAt(R, {0}, constantFunction({0}, R.carrier, b)), polynomialRing(R, {0}), R, w(i) with h, wi
  have fv := uni.family_values at R, n, w, b with comm, polys, values
  obtain ⟨vf, vv⟩ := fv
  have fin := Finite.subset with (Finite.natural at n), (Subset.reflexive at n)
  have entries : ∀ i ∈ n, polyFamilyValues(R, n, w, b)(i) = evaluationAt(R, {0}, constantFunction({0}, R.carrier, b))(w(i))
    intros i hi
    rw (vv with i, hi)
    unfold polyEval
    rfl
  unfold polyEval
  exact finiteRingProduct.map at Ring.carrier(polynomialRing(R, {0})), Ring.add(polynomialRing(R, {0})), Ring.zero(polynomialRing(R, {0})), Ring.neg(polynomialRing(R, {0})), Ring.mul(polynomialRing(R, {0})), Ring.one(polynomialRing(R, {0})), R.carrier, R.add, R.zero, R.neg, R.mul, R.one, evaluationAt(R, {0}, constantFunction({0}, R.carrier, b)), n, w, polyFamilyValues(R, n, w, b) with sp, rp, hp, fin, factors, vf, entries

theorem polyEval2.hom (S f x : Set)
  requires target : CommRing(S)
  requires hom : f : R →+* S
  requires point : x ∈ S.carrier
  shows RingHom(evaluationHom(R, S, {0}, f, constantFunction({0}, S.carrier, x)),
    polynomialRing(R, {0}), S)
proof
  have v := constantFunction.function at {0}, S.carrier, x with *
  exact evaluationHom.hom at R, S, {0}, f, constantFunction({0}, S.carrier, x) with comm, target, hom, v

theorem polyEval2.C (S f x a : Set)
  requires target : CommRing(S)
  requires hom : f : R →+* S
  requires point : x ∈ S.carrier
  requires scalar : a ∈ R.carrier
  shows polyEval2(R, S, f, x, polyC(R, a)) = f(a)
proof
  have v := constantFunction.function at {0}, S.carrier, x with *
  unfold polyEval2
  unfold polyC
  exact evaluationHom.map_constant at R, S, {0}, f, constantFunction({0}, S.carrier, x), a with comm, target, hom, v, scalar

theorem polyEval2.X (S f x : Set)
  requires target : CommRing(S)
  requires hom : f : R →+* S
  requires point : x ∈ S.carrier
  shows polyEval2(R, S, f, x, polyX(R)) = x
proof
  have zero : 0 ∈ {0} by simp [singleton.membership]
  have v := constantFunction.function at {0}, S.carrier, x with *
  unfold polyEval2
  unfold polyX
  rw (evaluationHom.map_X at R, S, {0}, f, constantFunction({0}, S.carrier, x), 0 with comm, target, hom, v, zero)
  exact constantFunction.apply at {0}, S.carrier, 0, x with zero, point

-- Polynomial.eval₂ is the unique homomorphism R[X] → S extending f with
-- X ↦ x (Polynomial.ringHom_ext).
theorem polyEval2.unique (S f x g : Set)
  requires target : CommRing(S)
  requires hom : f : R →+* S
  requires map : g : polynomialRing(R, {0}) →+* S
  requires constants : ∀ a ∈ R.carrier, g(polyC(R, a)) = f(a)
  requires variable : g(polyX(R)) = x
  shows g = evaluationHom(R, S, {0}, f, constantFunction({0}, S.carrier, x))
proof
  have zero : 0 ∈ {0} by simp [singleton.membership]
  have xIn := polyX.mem at R with comm, polys
  have point : x ∈ S.carrier
    rw ← variable
    exact RingHom.map_mem at g, polynomialRing(R, {0}), S, polyX(R) with map, xIn
  have v := constantFunction.function at {0}, S.carrier, x with *
  apply evaluationHom.unique at R, S, {0}, f, constantFunction({0}, S.carrier, x), g with comm, target, hom, v, map
  . intros a ha
    have c := constants with a, ha
    unfold polyC at c
    exact c
  . intros j hj
    rw singleton.membership at hj
    rw hj
    have cv := constantFunction.apply at {0}, S.carrier, 0, x with zero, point
    rw cv
    unfold polyX at variable
    exact variable

-- Polynomial.hom_eval₂: composing evaluation with a homomorphism.
theorem polyEval2.compose (S T f g x p : Set)
  requires targetS : CommRing(S)
  requires targetT : CommRing(T)
  requires first : f : R →+* S
  requires second : g : S →+* T
  requires point : x ∈ S.carrier
  requires member : p ∈ Ring.carrier(polynomialRing(R, {0}))
  shows g(polyEval2(R, S, f, x, p)) =
    polyEval2(R, T, compose(g, f, R.carrier, S.carrier, T.carrier), g(x), p)
proof
  have zero : 0 ∈ {0} by simp [singleton.membership]
  have gx := RingHom.map_mem at g, S, T, x with second, point
  have vS := constantFunction.function at {0}, S.carrier, x with *
  have vT := constantFunction.function at {0}, T.carrier, g(x) with *
  have e1 := evaluationHom.hom at R, S, {0}, f, constantFunction({0}, S.carrier, x) with comm, targetS, first, vS
  have gf := RingHom.comp at f, g, R, S, T with comm, first, second
  have c := RingHom.comp at evaluationHom(R, S, {0}, f, constantFunction({0}, S.carrier, x)), g, polynomialRing(R, {0}), S, T with polys, e1, second
  have e10 := e1
  obtain ⟨_, _, e1fn, _⟩ := e10
  have g0 := second
  obtain ⟨_, _, gfn, _⟩ := g0
  have f0 := first
  obtain ⟨_, _, ffn, _⟩ := f0
  have u := evaluationHom.unique at R, T, {0}, compose(g, f, R.carrier, S.carrier, T.carrier), constantFunction({0}, T.carrier, g(x)), compose(g, evaluationHom(R, S, {0}, f, constantFunction({0}, S.carrier, x)), Ring.carrier(polynomialRing(R, {0})), S.carrier, T.carrier) with comm, targetT, gf, vT, c
  have eq : compose(g, evaluationHom(R, S, {0}, f, constantFunction({0}, S.carrier, x)), Ring.carrier(polynomialRing(R, {0})), S.carrier, T.carrier) = evaluationHom(R, T, {0}, compose(g, f, R.carrier, S.carrier, T.carrier), constantFunction({0}, T.carrier, g(x)))
    apply u
    . intros a ha
      have cIn := polynomialConstant.mem at R, {0}, a with comm, ha
      rw (compose.apply at g, evaluationHom(R, S, {0}, f, constantFunction({0}, S.carrier, x)), Ring.carrier(polynomialRing(R, {0})), S.carrier, T.carrier, polynomialConstant(R, {0})(a) with e1fn, gfn, cIn)
      rw (evaluationHom.map_constant at R, S, {0}, f, constantFunction({0}, S.carrier, x), a with comm, targetS, first, vS, ha)
      rw (compose.apply at g, f, R.carrier, S.carrier, T.carrier, a with ffn, gfn, ha)
    . intros j hj
      rw singleton.membership at hj
      rw hj
      have xIn := X.mem at R, {0}, 0 with comm
      rw (compose.apply at g, evaluationHom(R, S, {0}, f, constantFunction({0}, S.carrier, x)), Ring.carrier(polynomialRing(R, {0})), S.carrier, T.carrier, X(R, {0}, 0) with e1fn, gfn, xIn)
      rw (evaluationHom.map_X at R, S, {0}, f, constantFunction({0}, S.carrier, x), 0 with comm, targetS, first, vS, zero)
      rw (constantFunction.apply at {0}, S.carrier, 0, x with zero, point)
      rw (constantFunction.apply at {0}, T.carrier, 0, g(x) with zero, gx)
  unfold polyEval2
  rw ← eq
  rw (compose.apply at g, evaluationHom(R, S, {0}, f, constantFunction({0}, S.carrier, x)), Ring.carrier(polynomialRing(R, {0})), S.carrier, T.carrier, p with e1fn, gfn, member)

-- Polynomial.map: a ring homomorphism R[X] → S[X] (mapRingHom) acting on
-- coefficients (coeff_map), sending X to X and C a to C (f a), preserving
-- monic polynomials and their degree (Monic.map, natDegree_map of monic),
-- functorial (Polynomial.map_map), injective for injective f
-- (Polynomial.map_injective).
theorem polyMap.hom (S f : Set)
  requires target : CommRing(S)
  requires hom : f : R →+* S
  shows polyMap(R, S, f) : polynomialRing(R, {0}) →+* polynomialRing(S, {0})
proof
  unfold polyMap
  exact polynomialMap.bundled_hom at R, S, f with comm, target, hom

theorem polyMap.coeff (S f p : Set) (k : Nat)
  requires target : CommRing(S)
  requires hom : f : R →+* S
  requires member : p ∈ Ring.carrier(polynomialRing(R, {0}))
  shows polyCoeff(polyMap(R, S, f)(p), k) = f(polyCoeff(p, k))
proof
  unfold polyMap
  exact polyCoeff.polynomialMap at R, S, f, p, k with comm, target, hom, member

theorem polyMap.X (S f : Set)
  requires target : CommRing(S)
  requires hom : f : R →+* S
  shows polyMap(R, S, f)(polyX(R)) = polyX(S)
proof
  have pcS := polynomialRing.comm_ring at S, {0} with target
  have mh := polyMap.hom at R, S, f with comm, polys, target, hom
  have xR := polyX.mem at R with comm, polys
  have xS := polyX.mem at S with target, pcS
  have lm := RingHom.map_mem at polyMap(R, S, f), polynomialRing(R, {0}), polynomialRing(S, {0}), polyX(R) with mh, xR
  apply polynomial.ext at S, polyMap(R, S, f)(polyX(R)), polyX(S) with target, pcS, lm, xS
  intros k hk
  have kNat := nat.omega.backward with hk
  rw (polyMap.coeff at R, S, f, polyX(R), k with comm, polys, target, hom, xR)
  rw (uni.X_term at R with comm, polys)
  rw (uni.X_term at S with target, pcS)
  have oneR : R.one ∈ R.carrier by typecheck
  have oneS : S.one ∈ S.carrier by typecheck
  have tR := uni.term_coeff at R, R.one, 1, k with comm, polys, oneR
  have tS := uni.term_coeff at S, S.one, 1, k with target, pcS, oneS
  by_cases e : k = 1
  . rw [(tR.left with e), (tS.left with e)]
    exact RingHom.map_one at f, R, S with hom
  . rw [(tR.right with e), (tS.right with e)]
    exact RingHom.map_zero at f, R, S with hom

theorem polyMap.C (S f a : Set)
  requires target : CommRing(S)
  requires hom : f : R →+* S
  requires scalar : a ∈ R.carrier
  shows polyMap(R, S, f)(polyC(R, a)) = polyC(S, f(a))
proof
  have pcS := polynomialRing.comm_ring at S, {0} with target
  have mh := polyMap.hom at R, S, f with comm, polys, target, hom
  have cR := polyC.mem at R, a with comm, polys, scalar
  have fa := RingHom.map_mem at f, R, S, a with hom, scalar
  have cS := polyC.mem at S, f(a) with target, pcS, fa
  have lm := RingHom.map_mem at polyMap(R, S, f), polynomialRing(R, {0}), polynomialRing(S, {0}), polyC(R, a) with mh, cR
  apply polynomial.ext at S, polyMap(R, S, f)(polyC(R, a)), polyC(S, f(a)) with target, pcS, lm, cS
  intros k hk
  have kNat := nat.omega.backward with hk
  rw (polyMap.coeff at R, S, f, polyC(R, a), k with comm, polys, target, hom, cR)
  have tR := polyC.coeff at R, a, k with comm, polys, scalar
  have tS := polyC.coeff at S, f(a), k with target, pcS, fa
  by_cases e : k = 0
  . rw [(tR.left with e), (tS.left with e)]
  . rw [(tR.right with e), (tS.right with e)]
    exact RingHom.map_zero at f, R, S with hom

theorem polyMap.monic (S f p : Set)
  requires target : CommRing(S)
  requires hom : f : R →+* S
  requires monic : PolyMonic(R, p)
  requires nontrivial : Ring.zero(S) ≠ Ring.one(S)
  shows PolyMonic(S, polyMap(R, S, f)(p)) ∧
    polyNatDegree(S, polyMap(R, S, f)(p)) = polyNatDegree(R, p)
proof
  have pcS := polynomialRing.comm_ring at S, {0} with target
  have mh := polyMap.hom at R, S, f with comm, polys, target, hom
  have pIn := monic.left
  have lm := RingHom.map_mem at polyMap(R, S, f), polynomialRing(R, {0}), polynomialRing(S, {0}), p with mh, pIn
  have dN : polyNatDegree(R, p) ∈ ℕ
    have sel := polyNatDegree.selected at R, p with comm, pIn
    exact sel.left
  have dNat := nat.omega.backward with dN
  have lead := monic.right
  rw (uni.lead_eq at R, p with comm, polys) at lead
  have top : polyCoeff(polyMap(R, S, f)(p), polyNatDegree(R, p)) = S[1]
    rw (polyMap.coeff at R, S, f, p, polyNatDegree(R, p) with comm, polys, target, hom, pIn)
    rw lead
    exact RingHom.map_one at f, R, S with hom
  have vp := uni.vanish_deg at R, p with comm, polys, pIn
  have vanish : ∀ k ∈ ℕ, polyNatDegree(R, p) < k → polyCoeff(polyMap(R, S, f)(p), k) = S[0]
    intros k hk lt
    have kNat := nat.omega.backward with hk
    rw (polyMap.coeff at R, S, f, p, k with comm, polys, target, hom, pIn)
    rw (vp with k, hk, lt)
    exact RingHom.map_zero at f, R, S with hom
  have r := uni.monic_of at S, polyMap(R, S, f)(p), polyNatDegree(R, p) with target, pcS, lm, top, vanish
  exact ⟨r.left, r.right with nontrivial⟩

theorem polyMap.compose (S T f g p : Set)
  requires targetS : CommRing(S)
  requires targetT : CommRing(T)
  requires first : f : R →+* S
  requires second : g : S →+* T
  requires member : p ∈ Ring.carrier(polynomialRing(R, {0}))
  shows polyMap(S, T, g)(polyMap(R, S, f)(p)) =
    polyMap(R, T, compose(g, f, R.carrier, S.carrier, T.carrier))(p)
proof
  have pcS := polynomialRing.comm_ring at S, {0} with targetS
  have pcT := polynomialRing.comm_ring at T, {0} with targetT
  have gf := RingHom.comp at f, g, R, S, T with comm, first, second
  have mf := polyMap.hom at R, S, f with comm, polys, targetS, first
  have mg := polyMap.hom at S, T, g with targetS, pcS, targetT, second
  have mgf := polyMap.hom at R, T, compose(g, f, R.carrier, S.carrier, T.carrier) with comm, polys, targetT, gf
  have l1 := RingHom.map_mem at polyMap(R, S, f), polynomialRing(R, {0}), polynomialRing(S, {0}), p with mf, member
  have l2 := RingHom.map_mem at polyMap(S, T, g), polynomialRing(S, {0}), polynomialRing(T, {0}), polyMap(R, S, f)(p) with mg, l1
  have l3 := RingHom.map_mem at polyMap(R, T, compose(g, f, R.carrier, S.carrier, T.carrier)), polynomialRing(R, {0}), polynomialRing(T, {0}), p with mgf, member
  apply polynomial.ext at T, polyMap(S, T, g)(polyMap(R, S, f)(p)), polyMap(R, T, compose(g, f, R.carrier, S.carrier, T.carrier))(p) with targetT, pcT, l2, l3
  intros k hk
  have kNat := nat.omega.backward with hk
  rw (polyMap.coeff at S, T, g, polyMap(R, S, f)(p), k with targetS, pcS, targetT, second, l1)
  rw (polyMap.coeff at R, S, f, p, k with comm, polys, targetS, first, member)
  rw (polyMap.coeff at R, T, compose(g, f, R.carrier, S.carrier, T.carrier), p, k with comm, polys, targetT, gf, member)
  have f0 := first
  obtain ⟨_, _, ffn, _⟩ := f0
  have g0 := second
  obtain ⟨_, _, gfn, _⟩ := g0
  have ck := uni.coeff_mem at R, p, k with comm, member
  rw (compose.apply at g, f, R.carrier, S.carrier, T.carrier, polyCoeff(p, k) with ffn, gfn, ck)

theorem polyMap.injective (S f : Set)
  requires target : CommRing(S)
  requires hom : f : R →+* S
  requires injective : InjectiveBetween(f, R.carrier, S.carrier)
  shows InjectiveBetween(polyMap(R, S, f), Ring.carrier(polynomialRing(R, {0})),
    Ring.carrier(polynomialRing(S, {0})))
proof
  have pcS := polynomialRing.comm_ring at S, {0} with target
  have mh := polyMap.hom at R, S, f with comm, polys, target, hom
  have m0 := mh
  obtain ⟨_, _, mfn, _⟩ := m0
  apply Injective.of_pointwise with mfn
  intros p hp q hq same
  apply polynomial.ext at R, p, q with comm, polys, hp, hq
  intros k hk
  have kNat := nat.omega.backward with hk
  have cp := polyMap.coeff at R, S, f, p, k with comm, polys, target, hom, hp
  have cq := polyMap.coeff at R, S, f, q, k with comm, polys, target, hom, hq
  rw same at cp
  rw cp at cq
  have pk := uni.coeff_mem at R, p, k with comm, hp
  have qk := uni.coeff_mem at R, q, k with comm, hq
  have fn := Injective.function with injective
  have fp := FunctionBetween.apply_closed with fn, pk
  have r1 := FunctionBetween.relates_apply with fn, pk
  have r2 := FunctionBetween.relates_apply with fn, qk
  rw ← cq at r2
  exact Injective.cancel at f, R.carrier, S.carrier, polyCoeff(p, k), polyCoeff(q, k), f(polyCoeff(p, k)) with injective, pk, qk, fp, r1, r2

-- Polynomial.eval₂_eq_eval_map, eval_map: eval₂ along f is evaluation of
-- the mapped polynomial.
theorem polyEval2.eq_eval_map (S f x p : Set)
  requires target : CommRing(S)
  requires hom : f : R →+* S
  requires point : x ∈ S.carrier
  requires member : p ∈ Ring.carrier(polynomialRing(R, {0}))
  shows polyEval2(R, S, f, x, p) = polyEval(S, polyMap(R, S, f)(p), x)
proof
  have pcS := polynomialRing.comm_ring at S, {0} with target
  have zero : 0 ∈ {0} by simp [singleton.membership]
  have vS := constantFunction.function at {0}, S.carrier, x with *
  have eh := evaluationAt.hom at S, {0}, constantFunction({0}, S.carrier, x) with target, vS
  have mh := polyMap.hom at R, S, f with comm, polys, target, hom
  have c := RingHom.comp at polyMap(R, S, f), evaluationAt(S, {0}, constantFunction({0}, S.carrier, x)), polynomialRing(R, {0}), polynomialRing(S, {0}), S with polys, mh, eh
  have m0 := mh
  obtain ⟨_, _, mfn, _⟩ := m0
  have e0 := eh
  obtain ⟨_, _, efn, _⟩ := e0
  have u := evaluationHom.unique at R, S, {0}, f, constantFunction({0}, S.carrier, x), compose(evaluationAt(S, {0}, constantFunction({0}, S.carrier, x)), polyMap(R, S, f), Ring.carrier(polynomialRing(R, {0})), Ring.carrier(polynomialRing(S, {0})), S.carrier) with comm, target, hom, vS, c
  have eq : compose(evaluationAt(S, {0}, constantFunction({0}, S.carrier, x)), polyMap(R, S, f), Ring.carrier(polynomialRing(R, {0})), Ring.carrier(polynomialRing(S, {0})), S.carrier) = evaluationHom(R, S, {0}, f, constantFunction({0}, S.carrier, x))
    apply u
    . intros a ha
      have cIn := polynomialConstant.mem at R, {0}, a with comm, ha
      rw (compose.apply at evaluationAt(S, {0}, constantFunction({0}, S.carrier, x)), polyMap(R, S, f), Ring.carrier(polynomialRing(R, {0})), Ring.carrier(polynomialRing(S, {0})), S.carrier, polynomialConstant(R, {0})(a) with mfn, efn, cIn)
      have mc := polyMap.C at R, S, f, a with comm, polys, target, hom, ha
      unfold polyC at mc
      rw mc
      have fa := RingHom.map_mem at f, R, S, a with hom, ha
      exact evaluationAt.map_constant at S, {0}, constantFunction({0}, S.carrier, x), f(a) with target, vS, fa
    . intros j hj
      have xIn := X.mem at R, {0}, j with comm
      rw (compose.apply at evaluationAt(S, {0}, constantFunction({0}, S.carrier, x)), polyMap(R, S, f), Ring.carrier(polynomialRing(R, {0})), Ring.carrier(polynomialRing(S, {0})), S.carrier, X(R, {0}, j) with mfn, efn, xIn)
      rw singleton.membership at hj
      rw hj
      have mx := polyMap.X at R, S, f with comm, polys, target, hom
      unfold polyX at mx
      rw mx
      exact evaluationAt.map_X at S, {0}, constantFunction({0}, S.carrier, x), 0 with target, vS, zero
  unfold polyEval2
  unfold polyEval
  rw ← eq
  rw (compose.apply at evaluationAt(S, {0}, constantFunction({0}, S.carrier, x)), polyMap(R, S, f), Ring.carrier(polynomialRing(R, {0})), Ring.carrier(polynomialRing(S, {0})), S.carrier, p with mfn, efn, member)

-- Composition (Polynomial.comp): eval of a composite
-- (Polynomial.eval_comp), and comp as aeval (comp_eq_aeval).
theorem polyComp.eval (p q : polynomialRing(R, {0})) (b : R)
  shows polyEval(R, polyComp(R, p, q), b) = polyEval(R, p, polyEval(R, q, b))
proof
  have zero : 0 ∈ {0} by simp [singleton.membership]
  have pIn : p ∈ Ring.carrier(polynomialRing(R, {0})) by assumption
  have qIn : q ∈ Ring.carrier(polynomialRing(R, {0})) by assumption
  have bIn : b ∈ R.carrier by assumption
  have vb := constantFunction.function at {0}, R.carrier, b with *
  have eh := evaluationAt.hom at R, {0}, constantFunction({0}, R.carrier, b) with comm, vb
  have ch := polyC.hom at R with comm, polys
  have pe := polyEval2.compose at R, polynomialRing(R, {0}), R, polynomialConstant(R, {0}), evaluationAt(R, {0}, constantFunction({0}, R.carrier, b)), q, p with comm, polys, polys, comm, ch, eh, qIn, pIn
  have c0 := ch
  obtain ⟨_, _, cfn, _⟩ := c0
  have e0 := eh
  obtain ⟨_, _, efn, _⟩ := e0
  have cf := compose.function at evaluationAt(R, {0}, constantFunction({0}, R.carrier, b)), polynomialConstant(R, {0}), R.carrier, Ring.carrier(polynomialRing(R, {0})), R.carrier with cfn, efn
  have idf := identity.function at R.carrier
  have idEq : compose(evaluationAt(R, {0}, constantFunction({0}, R.carrier, b)), polynomialConstant(R, {0}), R.carrier, Ring.carrier(polynomialRing(R, {0})), R.carrier) = identity(R.carrier)
    apply FunctionBetween.ext with cf, idf
    intros a ha
    rw (compose.apply at evaluationAt(R, {0}, constantFunction({0}, R.carrier, b)), polynomialConstant(R, {0}), R.carrier, Ring.carrier(polynomialRing(R, {0})), R.carrier, a with cfn, efn, ha)
    rw (evaluationAt.map_constant at R, {0}, constantFunction({0}, R.carrier, b), a with comm, vb, ha)
    rw (identity.apply at a, R.carrier with ha)
  rw idEq at pe
  have ev := RingHom.map_mem at evaluationAt(R, {0}, constantFunction({0}, R.carrier, b)), polynomialRing(R, {0}), R, q with eh, qIn
  have vq := constantFunction.function at {0}, R.carrier, evaluationAt(R, {0}, constantFunction({0}, R.carrier, b))(q) with *
  have ee := evaluationAt.eq_evaluationHom at R, {0}, constantFunction({0}, R.carrier, evaluationAt(R, {0}, constantFunction({0}, R.carrier, b))(q)) with comm, vq
  unfold polyEval2 at pe
  rw ← ee at pe
  unfold polyComp
  unfold polyEval
  unfold polyEval2
  exact pe

theorem polyComp.X (p : polynomialRing(R, {0}))
  shows polyComp(R, p, polyX(R)) = p
proof
  have pr := CommRing.to_ring with polys
  have zero : 0 ∈ {0} by simp [singleton.membership]
  have xIn := polyX.mem at R with comm, polys
  have ch := polyC.hom at R with comm, polys
  have v := constantFunction.function at {0}, Ring.carrier(polynomialRing(R, {0})), polyX(R) with *
  have idh := RingHom.id at polynomialRing(R, {0}) with polys
  have u := evaluationHom.unique at R, polynomialRing(R, {0}), {0}, polynomialConstant(R, {0}), constantFunction({0}, Ring.carrier(polynomialRing(R, {0})), polyX(R)), identity(Ring.carrier(polynomialRing(R, {0}))) with comm, polys, ch, v, idh
  have eq : identity(Ring.carrier(polynomialRing(R, {0}))) = evaluationHom(R, polynomialRing(R, {0}), {0}, polynomialConstant(R, {0}), constantFunction({0}, Ring.carrier(polynomialRing(R, {0})), polyX(R)))
    apply u
    . intros a ha
      have cIn := polynomialConstant.mem at R, {0}, a with comm, ha
      exact identity.apply at polynomialConstant(R, {0})(a), Ring.carrier(polynomialRing(R, {0})) with cIn
    . intros j hj
      rw singleton.membership at hj
      rw hj
      rw (constantFunction.apply at {0}, Ring.carrier(polynomialRing(R, {0})), 0, polyX(R) with zero, xIn)
      unfold polyX at xIn
      unfold polyX
      exact identity.apply at X(R, {0}, 0), Ring.carrier(polynomialRing(R, {0})) with xIn
  unfold polyComp
  unfold polyEval2
  rw ← eq
  have pIn : p ∈ Ring.carrier(polynomialRing(R, {0})) by assumption
  exact identity.apply at p, Ring.carrier(polynomialRing(R, {0})) with pIn

-- The derivative: R-linear, Leibniz, d(Xⁿ) = n Xⁿ⁻¹
-- (Polynomial.derivative_mul, derivative_pow, derivative_X_pow), its
-- coefficients (Polynomial.coeff_derivative), compatible with map
-- (Polynomial.derivative_map).
theorem polyDerivative.add (p q : polynomialRing(R, {0}))
  shows polyDerivative(R)(p + q) = call2(Ring.add(polynomialRing(R, {0})),
    polyDerivative(R)(p), polyDerivative(R)(q))
proof
  have zero : 0 ∈ {0} by simp [singleton.membership]
  unfold polyDerivative
  exact partialDerivative.add at R, {0}, 0, p, q with comm, polys, zero

theorem polyDerivative.mul (p q : polynomialRing(R, {0}))
  shows polyDerivative(R)(p * q) = call2(Ring.add(polynomialRing(R, {0})),
    call2(Ring.mul(polynomialRing(R, {0})), polyDerivative(R)(p), q),
    call2(Ring.mul(polynomialRing(R, {0})), p, polyDerivative(R)(q)))
proof
  have zero : 0 ∈ {0} by simp [singleton.membership]
  unfold polyDerivative
  exact partialDerivative.mul at R, {0}, 0, p, q with comm, polys, zero

theorem polyDerivative.coeff (p : polynomialRing(R, {0})) (k : Nat)
  shows polyCoeff(polyDerivative(R)(p), k) =
    call2(R.mul, polyCoeff(p, succ(k)), ringNat(R.add, R.zero, R.one, succ(k)))
proof
  have zero : 0 ∈ {0} by simp [singleton.membership]
  have pIn : p ∈ Ring.carrier(polynomialRing(R, {0})) by assumption
  have mk := monomials.univariate at k
  have msk := monomials.univariate at succ(k)
  unfold polyDerivative
  have c := partialDerivative.coefficient at R, {0}, 0, p, {(0, k)} with comm, polys, zero, mk
  rw (uni.monomial_value at k) at c
  have sh : shiftMonomial({0}, {(0, k)}, 0) = {(0, succ(k))}
    have sm := shiftMonomial.member at {0}, 0, {(0, k)} with zero, mk
    apply monomials.ext at {0}, shiftMonomial({0}, {(0, k)}, 0), {(0, succ(k))} with sm, msk
    intros i hi
    rw singleton.membership at hi
    rw hi
    rw (shiftMonomial.same at {0}, 0, {(0, k)} with zero, mk)
    rw (uni.monomial_value at k)
    rw (uni.monomial_value at succ(k))
  rw sh at c
  unfold polyCoeff
  rw c
  have pk := polynomialRing.coefficient_mem at R, {0}, p, {(0, succ(k))} with comm, polys, pIn, msk
  have nk : ringNat(R.add, R.zero, R.one, succ(k)) ∈ R.carrier by typecheck
  ring

theorem polyDerivative.C (a : R)
  shows polyDerivative(R)(polyC(R, a)) = Ring.zero(polynomialRing(R, {0}))
proof
  have zero : 0 ∈ {0} by simp [singleton.membership]
  unfold polyDerivative
  unfold polyC
  exact partialDerivative.constant at R, {0}, 0, a with comm, polys, zero

theorem polyDerivative.X
  shows polyDerivative(R)(polyX(R)) = Ring.one(polynomialRing(R, {0}))
proof
  have zero : 0 ∈ {0} by simp [singleton.membership]
  unfold polyDerivative
  unfold polyX
  exact partialDerivative.X_self at R, {0}, 0 with comm, polys, zero

theorem polyDerivative.pow (p : polynomialRing(R, {0})) (n : Nat)
  shows polyDerivative(R)(p ^ succ(n)) = call2(Ring.mul(polynomialRing(R, {0})),
    call2(Ring.mul(polynomialRing(R, {0})), polyC(R, ringNat(R.add, R.zero, R.one, succ(n))), p ^ n),
    polyDerivative(R)(p))
proof
  have zero : 0 ∈ {0} by simp [singleton.membership]
  have s : succ(n) = n + 1 by arith
  rw s
  unfold polyDerivative
  rw (partialDerivative.pow at R, {0}, 0, p, n with comm, polys, zero)
  have ch := polyC.hom at R with comm, polys
  have m := RingHom.map_numeral at R, polynomialRing(R, {0}), polynomialConstant(R, {0}), n + 1 with comm, polys, ch
  unfold polyC
  rw m

theorem polyDerivative.map (S f p : Set)
  requires target : CommRing(S)
  requires hom : f : R →+* S
  requires member : p ∈ Ring.carrier(polynomialRing(R, {0}))
  shows polyMap(R, S, f)(polyDerivative(R)(p)) =
    polyDerivative(S)(polyMap(R, S, f)(p))
proof
  have pcS := polynomialRing.comm_ring at S, {0} with target
  have zero : 0 ∈ {0} by simp [singleton.membership]
  have mh := polyMap.hom at R, S, f with comm, polys, target, hom
  have dIn : polyDerivative(R)(p) ∈ Ring.carrier(polynomialRing(R, {0}))
    unfold polyDerivative
    exact partialDerivative.map_mem at R, {0}, 0, p with comm, polys, zero, member
  have l1 := RingHom.map_mem at polyMap(R, S, f), polynomialRing(R, {0}), polynomialRing(S, {0}), polyDerivative(R)(p) with mh, dIn
  have l2 := RingHom.map_mem at polyMap(R, S, f), polynomialRing(R, {0}), polynomialRing(S, {0}), p with mh, member
  have l3 : polyDerivative(S)(polyMap(R, S, f)(p)) ∈ Ring.carrier(polynomialRing(S, {0}))
    unfold polyDerivative
    exact partialDerivative.map_mem at S, {0}, 0, polyMap(R, S, f)(p) with target, pcS, zero, l2
  apply polynomial.ext at S, polyMap(R, S, f)(polyDerivative(R)(p)), polyDerivative(S)(polyMap(R, S, f)(p)) with target, pcS, l1, l3
  intros k hk
  have kNat := nat.omega.backward with hk
  rw (polyMap.coeff at R, S, f, polyDerivative(R)(p), k with comm, polys, target, hom, dIn)
  rw (polyDerivative.coeff at R, p, k with comm, polys, member)
  rw (polyDerivative.coeff at S, polyMap(R, S, f)(p), k with target, pcS, l2)
  rw (polyMap.coeff at R, S, f, p, succ(k) with comm, polys, target, hom, member)
  have pk := uni.coeff_mem at R, p, succ(k) with comm, member
  have nk : ringNat(R.add, R.zero, R.one, succ(k)) ∈ R.carrier by typecheck
  rw (RingHom.map_mul at f, R, S, polyCoeff(p, succ(k)), ringNat(R.add, R.zero, R.one, succ(k)) with hom, pk, nk)
  rw (RingHom.map_numeral at R, S, f, succ(k) with comm, target, hom)

-- Helper: division with remainder by a monic polynomial, by induction on a
-- bound for the dividend's degree.
theorem uni.div_exists (g : polynomialRing(R, {0})) (N : Nat)
  requires monic : PolyMonic(R, g)
  shows ∀ p ∈ Ring.carrier(polynomialRing(R, {0})),
    (∀ k ∈ ℕ, N ≤ k → polyCoeff(p, k) = R[0]) →
    ∃ q ∈ Ring.carrier(polynomialRing(R, {0})),
      ∃ r ∈ Ring.carrier(polynomialRing(R, {0})),
        p = q * g + r ∧ r ∈ polyDegreeLT(R, polyNatDegree(R, g))
proof
  induction N
  | zero =>
    intros p hp vanish
    have pr := CommRing.to_ring with polys
    have z : Ring.zero(polynomialRing(R, {0})) ∈ Ring.carrier(polynomialRing(R, {0})) := Ring.zero_mem with *
    have gIn : g ∈ Ring.carrier(polynomialRing(R, {0})) by assumption
    have pz : p = Ring.zero(polynomialRing(R, {0}))
      apply polynomial.ext at R, p, Ring.zero(polynomialRing(R, {0})) with comm, polys, hp, z
      intros k hk
      have kNat := nat.omega.backward with hk
      have le : 0 ≤ k by arith
      rw (vanish with k, hk, le)
      rw (uni.zero_coeff at R, k with comm, polys)
    refine ⟨Ring.zero(polynomialRing(R, {0})), z, Ring.zero(polynomialRing(R, {0})), z, ?_, ?_⟩
    . rw pz
      ring
    . unfold polyDegreeLT
      refine ⟨z, ?_⟩
      intros k hk
      unfold polyDegrees at hk
      obtain ⟨kN, nz⟩ := hk
      have kNat := nat.omega.backward with kN
      have c := uni.zero_coeff at R, k with comm, polys
      unfold polyCoeff at c
      exfalso
      apply nz
      exact c
  | succ(M) using ih =>
    intros p hp vanish
    have pr := CommRing.to_ring with polys
    have z : Ring.zero(polynomialRing(R, {0})) ∈ Ring.carrier(polynomialRing(R, {0})) := Ring.zero_mem with *
    have gIn : g ∈ Ring.carrier(polynomialRing(R, {0})) by assumption
    have dN : polyNatDegree(R, g) ∈ ℕ
      have sel := polyNatDegree.selected at R, g with comm, gIn
      exact sel.left
    have dNat := nat.omega.backward with dN
    by_cases small : M < polyNatDegree(R, g)
    . refine ⟨Ring.zero(polynomialRing(R, {0})), z, p, hp, ?_, ?_⟩
      . ring
      . unfold polyDegreeLT
        refine ⟨hp, ?_⟩
        intros k hk
        unfold polyDegrees at hk
        obtain ⟨kN, nz⟩ := hk
        have kNat := nat.omega.backward with kN
        by_contra big
        have le : succ(M) ≤ k by arith
        have c := vanish with k, kN, le
        unfold polyCoeff at c
        apply nz
        exact c
    . have le : polyNatDegree(R, g) ≤ M by arith
      obtain ⟨e, eNat, Meq⟩ := LessEqual.exists_add at polyNatDegree(R, g), M with le
      have cIn := uni.coeff_mem at R, p, M with comm, hp
      have xe : Ring.pow(polynomialRing(R, {0}), polyX(R), e) ∈ Ring.carrier(polynomialRing(R, {0}))
        have oneIn : R.one ∈ R.carrier by typecheck
        rw (uni.X_pow at R, e with comm, polys)
        exact uni.term_mem at R, R.one, e with comm, polys, oneIn
      have ccIn := polyC.mem at R, polyCoeff(p, M) with comm, polys, cIn
      have tIn : polyMonomial(R, polyCoeff(p, M), e) ∈ Ring.carrier(polynomialRing(R, {0}))
        unfold polyMonomial
        exact Ring.mul_mem with *
      have tv : ∀ k ∈ ℕ, e < k → polyCoeff(polyMonomial(R, polyCoeff(p, M), e), k) = R[0]
        intros k hk lt
        have kNat := nat.omega.backward with hk
        have ne : k ≠ e by arith
        have tck := polyMonomial.coeff at R, polyCoeff(p, M), e, k with comm, polys, cIn
        exact tck.right with ne
      have gv := uni.vanish_deg at R, g with comm, polys, gIn
      have top := uni.mul_top at R, polyMonomial(R, polyCoeff(p, M), e), g, e, polyNatDegree(R, g) with comm, polys, tIn, gIn, tv, gv
      have mv := uni.mul_vanish at R, polyMonomial(R, polyCoeff(p, M), e), g, e, polyNatDegree(R, g) with comm, polys, tIn, gIn, tv, gv
      have ee : e = e by rfl
      have tce := polyMonomial.coeff at R, polyCoeff(p, M), e, e with comm, polys, cIn
      rw (tce.left with ee) at top
      have lead := monic.right
      rw (uni.lead_eq at R, g with comm, polys) at lead
      rw lead at top
      have c1 : polyCoeff(p, M) * R[1] = polyCoeff(p, M) by ring
      rw c1 at top
      have tg : polyMonomial(R, polyCoeff(p, M), e) * g ∈ Ring.carrier(polynomialRing(R, {0})) := Ring.mul_mem with *
      have pp : p - polyMonomial(R, polyCoeff(p, M), e) * g ∈ Ring.carrier(polynomialRing(R, {0})) := Ring.sub_mem with *
      have vanish2 : ∀ k ∈ ℕ, M ≤ k → polyCoeff(p - polyMonomial(R, polyCoeff(p, M), e) * g, k) = R[0]
        intros k hk lek
        have kNat := nat.omega.backward with hk
        rw (uni.coeff_sub at R, p, polyMonomial(R, polyCoeff(p, M), e) * g, k with comm, polys, hp, tg)
        by_cases eqk : k = M
        . rw eqk
          have em : e + polyNatDegree(R, g) = M by arith
          rw em at top
          rw top
          ring
        . have big : succ(M) ≤ k by arith
          rw (vanish with k, hk, big)
          have big2 : e + polyNatDegree(R, g) < k by arith
          rw (mv with k, hk, big2)
          ring
      obtain ⟨q, qIn, r, rIn, eq, deg⟩ := ih with p - polyMonomial(R, polyCoeff(p, M), e) * g, pp, vanish2
      have sIn : q + polyMonomial(R, polyCoeff(p, M), e) ∈ Ring.carrier(polynomialRing(R, {0})) := Ring.add_mem with *
      refine ⟨q + polyMonomial(R, polyCoeff(p, M), e), sIn, r, rIn, ?_, deg⟩
      have h : p = (p - polyMonomial(R, polyCoeff(p, M), e) * g) + polyMonomial(R, polyCoeff(p, M), e) * g by ring
      have h2 : (p - polyMonomial(R, polyCoeff(p, M), e) * g) + polyMonomial(R, polyCoeff(p, M), e) * g = (q + polyMonomial(R, polyCoeff(p, M), e)) * g + r
        rw eq
        ring
      cc [h, h2]

-- Helpers: remainders vanish from the divisor's degree on, quotient and
-- remainder are unique, and a monic divisor of a nonzero polynomial has at
-- most its degree.
theorem uni.vanish_of_lt (r : Set) (d : Nat)
  requires bound : r ∈ polyDegreeLT(R, d)
  shows ∀ k ∈ ℕ, d ≤ k → polyCoeff(r, k) = R[0]
proof
  unfold polyDegreeLT at bound
  obtain ⟨rIn, below⟩ := bound
  intros k hk le
  have kNat := nat.omega.backward with hk
  by_contra nz
  have kd : k ∈ polyDegrees(R, r)
    unfold polyDegrees
    unfold polyCoeff at nz
    exact ⟨hk, nz⟩
  have l := below with k, kd
  arith

theorem uni.div_unique (g q1 r1 q2 r2 : polynomialRing(R, {0}))
  requires nontrivial : R[0] ≠ R[1]
  requires monic : PolyMonic(R, g)
  requires first : r1 ∈ polyDegreeLT(R, polyNatDegree(R, g))
  requires second : r2 ∈ polyDegreeLT(R, polyNatDegree(R, g))
  requires same : q1 * g + r1 = q2 * g + r2
  shows q1 = q2 ∧ r1 = r2
proof
  have pr := CommRing.to_ring with polys
  have gIn : g ∈ Ring.carrier(polynomialRing(R, {0})) by assumption
  have q1In : q1 ∈ Ring.carrier(polynomialRing(R, {0})) by assumption
  have q2In : q2 ∈ Ring.carrier(polynomialRing(R, {0})) by assumption
  have r1In : r1 ∈ Ring.carrier(polynomialRing(R, {0})) by assumption
  have r2In : r2 ∈ Ring.carrier(polynomialRing(R, {0})) by assumption
  have hIn : q1 - q2 ∈ Ring.carrier(polynomialRing(R, {0})) := Ring.sub_mem with *
  have dIn : r2 - r1 ∈ Ring.carrier(polynomialRing(R, {0})) := Ring.sub_mem with *
  have e1 : (q1 - q2) * g = (q1 * g + r1) - (q2 * g + r2) + (r2 - r1) by ring
  rw same at e1
  have e2 : (q2 * g + r2) - (q2 * g + r2) + (r2 - r1) = r2 - r1 by ring
  have hg : (q1 - q2) * g = r2 - r1 by cc [e1, e2]
  have dN : polyNatDegree(R, g) ∈ ℕ
    have sel := polyNatDegree.selected at R, g with comm, gIn
    exact sel.left
  have dNat := nat.omega.backward with dN
  have hz : q1 - q2 = Ring.zero(polynomialRing(R, {0}))
    by_contra nz
    have hN : polyNatDegree(R, q1 - q2) ∈ ℕ
      have sel := polyNatDegree.selected at R, q1 - q2 with comm, hIn
      exact sel.left
    have hNat := nat.omega.backward with hN
    have vh := uni.vanish_deg at R, q1 - q2 with comm, polys, hIn
    have vg := uni.vanish_deg at R, g with comm, polys, gIn
    have top := uni.mul_top at R, q1 - q2, g, polyNatDegree(R, q1 - q2), polyNatDegree(R, g) with comm, polys, hIn, gIn, vh, vg
    have lead := monic.right
    rw (uni.lead_eq at R, g with comm, polys) at lead
    rw lead at top
    rw hg at top
    have kN : polyNatDegree(R, q1 - q2) + polyNatDegree(R, g) ∈ ℕ by typecheck
    rw (uni.coeff_sub at R, r2, r1, polyNatDegree(R, q1 - q2) + polyNatDegree(R, g) with comm, polys, r2In, r1In) at top
    have le : polyNatDegree(R, g) ≤ polyNatDegree(R, q1 - q2) + polyNatDegree(R, g) by arith
    have v1 := uni.vanish_of_lt at R, r1, polyNatDegree(R, g) with comm, polys, first
    have v2 := uni.vanish_of_lt at R, r2, polyNatDegree(R, g) with comm, polys, second
    rw [(v1 with polyNatDegree(R, q1 - q2) + polyNatDegree(R, g), kN, le), (v2 with polyNatDegree(R, q1 - q2) + polyNatDegree(R, g), kN, le)] at top
    have ch := uni.coeff_mem at R, q1 - q2, polyNatDegree(R, q1 - q2) with comm, hIn
    have c1 : polyCoeff(q1 - q2, polyNatDegree(R, q1 - q2)) * R[1] = polyCoeff(q1 - q2, polyNatDegree(R, q1 - q2)) by ring
    have c0 : R[0] - R[0] = R[0] by ring
    rw [c1, c0] at top
    have spec := uni.deg_spec at R, q1 - q2 with comm, polys, hIn
    have ne := spec.right with nz
    apply ne
    rw top
  have qe : q1 = q2
    have e3 : q1 = (q1 - q2) + q2 by ring
    rw hz at e3
    have e4 : Ring.zero(polynomialRing(R, {0})) + q2 = q2 by ring
    cc [e3, e4]
  refine ⟨qe, ?_⟩
  rw qe at same
  have e5 : r1 = (q2 * g + r1) - q2 * g by ring
  have e6 : r2 = (q2 * g + r2) - q2 * g by ring
  rw same at e5
  cc [e5, e6]

theorem uni.monic_dvd_le (g c p : polynomialRing(R, {0}))
  requires nontrivial : R[0] ≠ R[1]
  requires monic : PolyMonic(R, g)
  requires product : p = g * c
  requires nonzero : p ≠ Ring.zero(polynomialRing(R, {0}))
  shows polyNatDegree(R, g) ≤ polyNatDegree(R, p)
proof
  have pr := CommRing.to_ring with polys
  have gIn : g ∈ Ring.carrier(polynomialRing(R, {0})) by assumption
  have cIn : c ∈ Ring.carrier(polynomialRing(R, {0})) by assumption
  have pIn : p ∈ Ring.carrier(polynomialRing(R, {0})) by assumption
  have cz : c ≠ Ring.zero(polynomialRing(R, {0}))
    intro e
    apply nonzero
    rw product
    rw e
    ring
  have dg : polyNatDegree(R, g) ∈ ℕ
    have sel := polyNatDegree.selected at R, g with comm, gIn
    exact sel.left
  have dc : polyNatDegree(R, c) ∈ ℕ
    have sel := polyNatDegree.selected at R, c with comm, cIn
    exact sel.left
  have dgN := nat.omega.backward with dg
  have dcN := nat.omega.backward with dc
  have vg := uni.vanish_deg at R, g with comm, polys, gIn
  have vc := uni.vanish_deg at R, c with comm, polys, cIn
  have top := uni.mul_top at R, g, c, polyNatDegree(R, g), polyNatDegree(R, c) with comm, polys, gIn, cIn, vg, vc
  have lead := monic.right
  rw (uni.lead_eq at R, g with comm, polys) at lead
  rw lead at top
  have cc0 := uni.coeff_mem at R, c, polyNatDegree(R, c) with comm, cIn
  have one : R[1] * polyCoeff(c, polyNatDegree(R, c)) = polyCoeff(c, polyNatDegree(R, c)) by ring
  rw one at top
  rw ← product at top
  have sc := uni.deg_spec at R, c with comm, polys, cIn
  have lc := sc.right with cz
  have nz : polyCoeff(p, polyNatDegree(R, g) + polyNatDegree(R, c)) ≠ R[0]
    rw top
    exact lc
  have sp := uni.deg_spec at R, p with comm, polys, pIn
  have kN : polyNatDegree(R, g) + polyNatDegree(R, c) ∈ ℕ by typecheck
  have le := sp.left with polyNatDegree(R, g) + polyNatDegree(R, c), kN, nz
  arith

-- Helpers: powers of X − a are monic of the expected degree, and lower
-- powers divide higher ones.
theorem uni.XsubC_pow (a : R) (k : Nat)
  shows PolyMonic(R, Ring.pow(polynomialRing(R, {0}), polyXSubC(R, a), k)) ∧
    (R[0] ≠ R[1] → polyNatDegree(R, Ring.pow(polynomialRing(R, {0}), polyXSubC(R, a), k)) = k)
proof
  induction k
  | zero =>
    have pr := CommRing.to_ring with polys
    have xa := uni.XsubC_mem at R, a with comm, polys
    rw (Ring.pow_zero at polynomialRing(R, {0}), polyXSubC(R, a) with pr, xa)
    rw (uni.one_eq at R with comm, polys)
    have oneIn : R[1] ∈ R.carrier by typecheck
    have cIn := polyC.mem at R, R[1] with comm, polys, oneIn
    have e0 : (0:Nat) = 0 by rfl
    have top := (polyC.coeff at R, R[1], 0 with comm, polys, oneIn).left with e0
    have vanish : ∀ k ∈ ℕ, 0 < k → polyCoeff(polyC(R, R[1]), k) = R[0]
      intros k hk lt
      have kNat := nat.omega.backward with hk
      have k0 : k ≠ 0 by arith
      exact (polyC.coeff at R, R[1], k with comm, polys, oneIn).right with k0
    exact uni.monic_of at R, polyC(R, R[1]), 0 with comm, polys, cIn, top, vanish
  | succ(m) using ih =>
    have pr := CommRing.to_ring with polys
    have xa := uni.XsubC_mem at R, a with comm, polys
    have sm : succ(m) = m + 1 by arith
    rw sm
    rw (Ring.pow_succ at polynomialRing(R, {0}), polyXSubC(R, a), m with pr, xa)
    have pm : Ring.pow(polynomialRing(R, {0}), polyXSubC(R, a), m) ∈ Ring.carrier(polynomialRing(R, {0})) by typecheck
    have mx := PolyMonic.X_sub_C at R, a with comm, polys
    have r := PolyMonic.mul at R, Ring.pow(polynomialRing(R, {0}), polyXSubC(R, a), m), polyXSubC(R, a) with comm, polys, pm, xa, ih.left, mx
    refine ⟨r.left, ?_⟩
    intro nontrivial
    rw r.right
    rw (ih.right with nontrivial)
    rw (polyNatDegree.X_sub_C at R, a with comm, polys, nontrivial)

theorem uni.pow_dvd_pow (x : polynomialRing(R, {0})) (m e : Nat)
  shows RingDvd(polynomialRing(R, {0}), Ring.pow(polynomialRing(R, {0}), x, m),
    Ring.pow(polynomialRing(R, {0}), x, m + e))
proof
  have pr := CommRing.to_ring with polys
  have xIn : x ∈ Ring.carrier(polynomialRing(R, {0})) by assumption
  have law := Ring.pow_add at polynomialRing(R, {0}), x, m, e with pr, xIn
  have pm : Ring.pow(polynomialRing(R, {0}), x, m) ∈ Ring.carrier(polynomialRing(R, {0})) by typecheck
  have pe : Ring.pow(polynomialRing(R, {0}), x, e) ∈ Ring.carrier(polynomialRing(R, {0})) by typecheck
  have pme : Ring.pow(polynomialRing(R, {0}), x, m + e) ∈ Ring.carrier(polynomialRing(R, {0})) by typecheck
  exact RingDvd.intro at polynomialRing(R, {0}), Ring.pow(polynomialRing(R, {0}), x, m), Ring.pow(polynomialRing(R, {0}), x, m + e), Ring.pow(polynomialRing(R, {0}), x, e) with polys, pm, pme, pe, law

end Laws

-- Section: Root multiplicities and division by monic polynomials
-- Helper: the exponents k with (X − a)ᵏ ∣ p.
def dividingPowers (R p a : Set) : Set :=
  { k ∈ ℕ | RingDvd(polynomialRing(R, {0}),
    Ring.pow(polynomialRing(R, {0}), polyXSubC(R, a), k), p) }

-- The multiplicity of a as a root of p ≠ 0: the largest k with
-- (X − a)ᵏ ∣ p (Polynomial.rootMultiplicity; Mathlib's value 0 at p = 0
-- is not part of the definition). The multiset Polynomial.roots is the
-- function a ↦ polyRootMultiplicity(R, p, a) on polyRootSet(R, p).
defunique polyRootMultiplicity (R p a : Set) (k ∈ ℕ) :=
  RingDvd(polynomialRing(R, {0}),
    Ring.pow(polynomialRing(R, {0}), polyXSubC(R, a), k), p) ∧
  ¬RingDvd(polynomialRing(R, {0}),
    Ring.pow(polynomialRing(R, {0}), polyXSubC(R, a), succ(k)), p)
requires ring : CommRing(R)
requires nontrivial : Ring.zero(R) ≠ Ring.one(R)
requires member : p ∈ Ring.carrier(polynomialRing(R, {0}))
requires nonzero : p ≠ Ring.zero(polynomialRing(R, {0}))
requires point : a ∈ Ring.carrier(R)
proof
  have polys := polynomialRing.comm_ring at R, {0} with ring
  have pr := CommRing.to_ring with polys
  have xa := uni.XsubC_mem at R, a with ring, polys, point
  have sel := polyNatDegree.selected at R, p with ring, member
  have pN := sel.left
  have pNat := nat.omega.backward with pN
  have bound : dividingPowers(R, p, a) ⊆ succ(polyNatDegree(R, p))
    intros k hk
    unfold dividingPowers at hk
    obtain ⟨kN, dvd⟩ := hk
    have kNat := nat.omega.backward with kN
    obtain ⟨_, _, c, cIn, eq⟩ := dvd
    have pw := uni.XsubC_pow at R, a, k with ring, polys, point
    have pk : Ring.pow(polynomialRing(R, {0}), polyXSubC(R, a), k) ∈ Ring.carrier(polynomialRing(R, {0})) by typecheck
    have le := uni.monic_dvd_le at R, Ring.pow(polynomialRing(R, {0}), polyXSubC(R, a), k), c, p with ring, polys, pk, cIn, member, nontrivial, pw.left, eq, nonzero
    rw (pw.right with nontrivial) at le
    exact membership.successor_of_LessEqual at k, polyNatDegree(R, p) with le
  have zeroIn : 0 ∈ dividingPowers(R, p, a)
    unfold dividingPowers
    have zN : (0:Nat) ∈ ℕ by typecheck
    refine ⟨zN, ?_⟩
    rw (Ring.pow_zero at polynomialRing(R, {0}), polyXSubC(R, a) with pr, xa)
    exact RingDvd.one at polynomialRing(R, {0}), p with polys, member
  have inhabited : Nonempty(dividingPowers(R, p, a)) := ⟨0, zeroIn⟩
  have naturals : dividingPowers(R, p, a) ⊆ ℕ
    intros k hk
    unfold dividingPowers at hk
    exact hk.left
  have finite := Finite.subset with (Finite.natural at succ(polyNatDegree(R, p))), bound
  obtain ⟨n, nN, nIn, below⟩ := Finite.greatest_natural with inhabited, naturals, finite
  have nNat := nat.omega.backward with nN
  witness n
  unfold dividingPowers at nIn
  refine ⟨nN, nIn.right, ?_⟩
  intro d
  have sIn : succ(n) ∈ dividingPowers(R, p, a)
    unfold dividingPowers
    have sN : succ(n) ∈ ℕ by typecheck
    exact ⟨sN, d⟩
  have bad := below with succ(n), sIn
  have no := membership.irreflexive at succ(n)
  exact no with bad
uniqueness
  intros u hu first v hv second
  have polys := polynomialRing.comm_ring at R, {0} with ring
  have pr := CommRing.to_ring with polys
  have xa := uni.XsubC_mem at R, a with ring, polys, point
  have uNat := nat.omega.backward with hu
  have vNat := nat.omega.backward with hv
  have du := first.left
  have dv := second.left
  have nu := first.right
  have nv := second.right
  have ule : u ≤ v
    by_contra gt
    have le : succ(v) ≤ u by arith
    obtain ⟨e, eNat, ueq⟩ := LessEqual.exists_add at succ(v), u with le
    have d := uni.pow_dvd_pow at R, polyXSubC(R, a), succ(v), e with ring, polys, xa
    rw ← ueq at d
    have t := RingDvd.trans at polynomialRing(R, {0}), Ring.pow(polynomialRing(R, {0}), polyXSubC(R, a), succ(v)), Ring.pow(polynomialRing(R, {0}), polyXSubC(R, a), u), p with polys, d, du
    apply nv
    exact t
  have vle : v ≤ u
    by_contra gt
    have le : succ(u) ≤ v by arith
    obtain ⟨e, eNat, veq⟩ := LessEqual.exists_add at succ(u), v with le
    have d := uni.pow_dvd_pow at R, polyXSubC(R, a), succ(u), e with ring, polys, xa
    rw ← veq at d
    have t := RingDvd.trans at polynomialRing(R, {0}), Ring.pow(polynomialRing(R, {0}), polyXSubC(R, a), succ(u)), Ring.pow(polynomialRing(R, {0}), polyXSubC(R, a), v), p with polys, d, dv
    apply nu
    exact t
  arith

-- Division with remainder by a monic g: the unique (q, r) with
-- p = q g + r and deg r < deg g (Polynomial.divByMonic, modByMonic).
defunique polyDivision (R p g : Set)
    (qr ∈ Ring.carrier(polynomialRing(R, {0})) ×
      Ring.carrier(polynomialRing(R, {0}))) :=
  p = call2(Ring.add(polynomialRing(R, {0})),
    call2(Ring.mul(polynomialRing(R, {0})), fst(qr), g), snd(qr)) ∧
  snd(qr) ∈ polyDegreeLT(R, polyNatDegree(R, g))
requires ring : CommRing(R)
requires nontrivial : Ring.zero(R) ≠ Ring.one(R)
requires member : p ∈ Ring.carrier(polynomialRing(R, {0}))
requires monic : PolyMonic(R, g)
proof
  have polys := polynomialRing.comm_ring at R, {0} with ring
  have pr := CommRing.to_ring with polys
  have gIn := monic.left
  have sel := polyNatDegree.selected at R, p with ring, member
  have pN := sel.left
  have pNat := nat.omega.backward with pN
  have vp := uni.vanish_deg at R, p with ring, polys, member
  have v : ∀ k ∈ ℕ, succ(polyNatDegree(R, p)) ≤ k → polyCoeff(p, k) = R[0]
    intros k hk le
    have kNat := nat.omega.backward with hk
    have lt : polyNatDegree(R, p) < k by arith
    exact vp with k, hk, lt
  have de : ∀ x ∈ Ring.carrier(polynomialRing(R, {0})), (∀ k ∈ ℕ, succ(polyNatDegree(R, p)) ≤ k → polyCoeff(x, k) = R[0]) → ∃ q ∈ Ring.carrier(polynomialRing(R, {0})), ∃ r ∈ Ring.carrier(polynomialRing(R, {0})), x = q * g + r ∧ r ∈ polyDegreeLT(R, polyNatDegree(R, g))
    exact uni.div_exists at R, g, succ(polyNatDegree(R, p)) with ring, polys, monic
  obtain ⟨q, qIn, r, rIn, eq, deg⟩ := de with p, member, v
  have pairIn := product.pair at q, r, Ring.carrier(polynomialRing(R, {0})), Ring.carrier(polynomialRing(R, {0})) with qIn, rIn
  witness (q, r)
  refine ⟨pairIn, ?_⟩
  rw [fst.pair, snd.pair]
  exact ⟨eq, deg⟩
uniqueness
  intros u hu first v hv second
  have polys := polynomialRing.comm_ring at R, {0} with ring
  have gIn := monic.left
  obtain ⟨_, q1, q1In, r1, r1In, ushape⟩ := product.membership.forward with hu
  obtain ⟨_, q2, q2In, r2, r2In, vshape⟩ := product.membership.forward with hv
  rw ushape at first
  rw vshape at second
  rw [fst.pair, snd.pair] at first
  rw [fst.pair, snd.pair] at second
  obtain ⟨e1, d1⟩ := first
  obtain ⟨e2, d2⟩ := second
  have same : call2(Ring.add(polynomialRing(R, {0})), call2(Ring.mul(polynomialRing(R, {0})), q1, g), r1) = call2(Ring.add(polynomialRing(R, {0})), call2(Ring.mul(polynomialRing(R, {0})), q2, g), r2) by cc [e1, e2]
  obtain ⟨qe, re⟩ := uni.div_unique at R, g, q1, r1, q2, r2 with ring, polys, gIn, q1In, r1In, q2In, r2In, nontrivial, monic, d1, d2, same
  rw [ushape, vshape, qe, re]

def polyDivByMonic (R p g : Set) : Set := fst(polyDivision(R, p, g))

def polyModByMonic (R p g : Set) : Set := snd(polyDivision(R, p, g))

def multiplicityFactors (R p a n : Set) : Set :=
  { u ∈ n × Ring.carrier(polynomialRing(R, {0})) | ∃ i ∈ n, ∃ m ∈ ℕ,
    m = polyRootMultiplicity(R, p, a(i)) ∧
    u = (i, Ring.pow(polynomialRing(R, {0}), polyXSubC(R, a(i)), m)) }

section LawsDivision
variable (R : Set)
hypothesis comm : CommRing(R)
hypothesis polys : CommRing(polynomialRing(R, {0}))

-- Helpers: a polynomial of degree below one is a constant, and over the
-- zero ring every polynomial is zero.
theorem uni.const_of_lt_one (r : Set)
  requires bound : r ∈ polyDegreeLT(R, 1)
  shows r = polyC(R, polyCoeff(r, 0))
proof
  have b0 := bound
  unfold polyDegreeLT at b0
  obtain ⟨rIn, _⟩ := b0
  have c0 := uni.coeff_mem at R, r, 0 with comm, rIn
  have cIn := polyC.mem at R, polyCoeff(r, 0) with comm, polys, c0
  have v := uni.vanish_of_lt at R, r, 1 with comm, polys, bound
  apply polynomial.ext at R, r, polyC(R, polyCoeff(r, 0)) with comm, polys, rIn, cIn
  intros k hk
  have kNat := nat.omega.backward with hk
  have c := polyC.coeff at R, polyCoeff(r, 0), k with comm, polys, c0
  by_cases k0 : k = 0
  . rw (c.left with k0)
    rw k0
  . rw (c.right with k0)
    have le : 1 ≤ k by arith
    exact v with k, hk, le

theorem uni.trivial_zero (p : polynomialRing(R, {0}))
  requires trivial : R[0] = R[1]
  shows p = Ring.zero(polynomialRing(R, {0}))
proof
  have pr := CommRing.to_ring with polys
  have pIn : p ∈ Ring.carrier(polynomialRing(R, {0})) by assumption
  have z : Ring.zero(polynomialRing(R, {0})) ∈ Ring.carrier(polynomialRing(R, {0})) := Ring.zero_mem with *
  apply polynomial.ext at R, p, Ring.zero(polynomialRing(R, {0})) with comm, polys, pIn, z
  intros k hk
  have kNat := nat.omega.backward with hk
  rw (uni.zero_coeff at R, k with comm, polys)
  have c := uni.coeff_mem at R, p, k with comm, pIn
  exact uni.trivial_eq at R, polyCoeff(p, k) with comm, polys, c, trivial

-- The units of R[X] over a domain are the constant units
-- (Polynomial.isUnit_iff).
theorem polynomialRing.unit_iff (p : polynomialRing(R, {0}))
  requires domain : IntegralDomain(R)
  shows RingUnit(polynomialRing(R, {0}), p) ↔
    (∃ a ∈ ringUnits(R), p = polyC(R, a))
proof
  have pr := CommRing.to_ring with polys
  have pIn : p ∈ Ring.carrier(polynomialRing(R, {0})) by assumption
  have ch := polyC.hom at R with comm, polys
  have dom := domain
  obtain ⟨_, nontrivial, _⟩ := dom
  have pdom := polynomialRing.domain at R with comm, polys, domain
  have pdom2 := pdom
  obtain ⟨_, pnontrivial, _⟩ := pdom2
  have oneIn : R[1] ∈ R.carrier by typecheck
  have c1 : polyC(R, R[1]) = Ring.one(polynomialRing(R, {0}))
    unfold polyC
    exact RingHom.map_one at polynomialConstant(R, {0}), R, polynomialRing(R, {0}) with ch
  constructor
  . intro unit
    obtain ⟨_, b, bIn, pb, bp⟩ := unit
    have pz : p ≠ Ring.zero(polynomialRing(R, {0}))
      intro e
      rw e at pb
      have z : Ring.zero(polynomialRing(R, {0})) * b = Ring.zero(polynomialRing(R, {0})) by ring
      rw z at pb
      apply pnontrivial
      exact pb
    have bz : b ≠ Ring.zero(polynomialRing(R, {0}))
      intro e
      rw e at pb
      have z : p * Ring.zero(polynomialRing(R, {0})) = Ring.zero(polynomialRing(R, {0})) by ring
      rw z at pb
      apply pnontrivial
      exact pb
    have deg := polyNatDegree.mul at R, p, b with comm, polys, pIn, bIn, domain, pz, bz
    rw pb at deg
    rw ← c1 at deg
    rw (polyNatDegree.C at R, R[1] with comm, polys, oneIn) at deg
    have dp : polyNatDegree(R, p) ∈ ℕ
      have sel := polyNatDegree.selected at R, p with comm, pIn
      exact sel.left
    have db : polyNatDegree(R, b) ∈ ℕ
      have sel := polyNatDegree.selected at R, b with comm, bIn
      exact sel.left
    have dpN := nat.omega.backward with dp
    have dbN := nat.omega.backward with db
    have dp0 : polyNatDegree(R, p) = 0 by arith
    have db0 : polyNatDegree(R, b) = 0 by arith
    have pl : p ∈ polyDegreeLT(R, 1)
      unfold polyDegreeLT
      refine ⟨pIn, ?_⟩
      intros k hk
      have sp := uni.deg_spec at R, p with comm, polys, pIn
      unfold polyDegrees at hk
      obtain ⟨kN, nz⟩ := hk
      have kNat := nat.omega.backward with kN
      have nz2 : polyCoeff(p, k) ≠ R[0]
        unfold polyCoeff
        exact nz
      have le := sp.left with k, kN, nz2
      arith
    have bl : b ∈ polyDegreeLT(R, 1)
      unfold polyDegreeLT
      refine ⟨bIn, ?_⟩
      intros k hk
      have sb := uni.deg_spec at R, b with comm, polys, bIn
      unfold polyDegrees at hk
      obtain ⟨kN, nz⟩ := hk
      have kNat := nat.omega.backward with kN
      have nz2 : polyCoeff(b, k) ≠ R[0]
        unfold polyCoeff
        exact nz
      have le := sb.left with k, kN, nz2
      arith
    have pc := uni.const_of_lt_one at R, p with comm, polys, pl
    have bc := uni.const_of_lt_one at R, b with comm, polys, bl
    have p0 := uni.coeff_mem at R, p, 0 with comm, pIn
    have b0 := uni.coeff_mem at R, b, 0 with comm, bIn
    have m1 := RingHom.map_mul at polynomialConstant(R, {0}), R, polynomialRing(R, {0}), polyCoeff(p, 0), polyCoeff(b, 0) with ch, p0, b0
    have pb0 : polyC(R, polyCoeff(p, 0) * polyCoeff(b, 0)) = polyC(R, R[1])
      unfold polyC
      unfold polyC at pc
      unfold polyC at bc
      unfold polyC at c1
      rw m1
      rw ← pc
      rw ← bc
      rw c1
      exact pb
    have pbIn : polyCoeff(p, 0) * polyCoeff(b, 0) ∈ R.carrier by typecheck
    have i1 := polyC.injective at R, polyCoeff(p, 0) * polyCoeff(b, 0), R[1] with comm, polys, pbIn, oneIn, pb0
    have i2 : polyCoeff(b, 0) * polyCoeff(p, 0) = R[1]
      rw ← i1
      ring
    have u : polyCoeff(p, 0) ∈ ringUnits(R)
      unfold ringUnits
      refine ⟨p0, ?_⟩
      unfold RingUnit
      exact ⟨p0, polyCoeff(b, 0), b0, i1, i2⟩
    exact ⟨polyCoeff(p, 0), u, pc⟩
  . intro ex
    obtain ⟨a, au, pa⟩ := ex
    unfold ringUnits at au
    obtain ⟨aIn, unitA⟩ := au
    obtain ⟨_, c, cIn, ac, ca⟩ := unitA
    have cpIn := polyC.mem at R, c with comm, polys, cIn
    have m1 := RingHom.map_mul at polynomialConstant(R, {0}), R, polynomialRing(R, {0}), a, c with ch, aIn, cIn
    have m2 := RingHom.map_mul at polynomialConstant(R, {0}), R, polynomialRing(R, {0}), c, a with ch, cIn, aIn
    rw ac at m1
    rw ca at m2
    unfold polyC at c1
    unfold RingUnit
    refine ⟨pIn, polyC(R, c), cpIn, ?_, ?_⟩
    . rw pa
      unfold polyC
      rw ← m1
      exact c1
    . rw pa
      unfold polyC
      rw ← m2
      exact c1

-- Helpers: one is monic, the last factor of a product over succ(m), and
-- products of monic linear factors.
theorem uni.one_monic
  shows PolyMonic(R, Ring.one(polynomialRing(R, {0}))) ∧
    polyNatDegree(R, Ring.one(polynomialRing(R, {0}))) = 0
proof
  rw (uni.one_eq at R with comm, polys)
  have oneIn : R[1] ∈ R.carrier by typecheck
  have cIn := polyC.mem at R, R[1] with comm, polys, oneIn
  have e0 : (0:Nat) = 0 by rfl
  have top := (polyC.coeff at R, R[1], 0 with comm, polys, oneIn).left with e0
  have vanish : ∀ k ∈ ℕ, 0 < k → polyCoeff(polyC(R, R[1]), k) = R[0]
    intros k hk lt
    have kNat := nat.omega.backward with hk
    have k0 : k ≠ 0 by arith
    exact (polyC.coeff at R, R[1], k with comm, polys, oneIn).right with k0
  have r := uni.monic_of at R, polyC(R, R[1]), 0 with comm, polys, cIn, top, vanish
  have dC := polyNatDegree.C at R, R[1] with comm, polys, oneIn
  exact ⟨r.left, dC⟩

theorem uni.prod_succ (w : Set) (m : Nat)
  requires factors : w : succ(m) → Ring.carrier(polynomialRing(R, {0}))
  shows finiteRingProduct(succ(m), Ring.carrier(polynomialRing(R, {0})),
      Ring.add(polynomialRing(R, {0})), Ring.zero(polynomialRing(R, {0})),
      Ring.neg(polynomialRing(R, {0})), Ring.mul(polynomialRing(R, {0})),
      Ring.one(polynomialRing(R, {0})), w) =
    finiteRingProduct(m, Ring.carrier(polynomialRing(R, {0})),
      Ring.add(polynomialRing(R, {0})), Ring.zero(polynomialRing(R, {0})),
      Ring.neg(polynomialRing(R, {0})), Ring.mul(polynomialRing(R, {0})),
      Ring.one(polynomialRing(R, {0})), restrict(w, m)) * w(m)
proof
  have parts := CommRing.parts with polys
  have fin := Finite.natural at m
  have fresh := membership.irreflexive at m
  have si := natural.successor_as_insert at m
  have wf := factors
  rw si at wf
  have e := finiteRingProduct.insert at m, Ring.carrier(polynomialRing(R, {0})), Ring.add(polynomialRing(R, {0})), Ring.zero(polynomialRing(R, {0})), Ring.neg(polynomialRing(R, {0})), Ring.mul(polynomialRing(R, {0})), Ring.one(polynomialRing(R, {0})), w, m with parts, fin, wf, fresh
  rw ← si at e
  exact e

theorem uni.prod_monic (n : Nat)
  shows ∀ w, (w : n → Ring.carrier(polynomialRing(R, {0}))) →
    (∀ i ∈ n, PolyMonic(R, w(i)) ∧ (R[0] ≠ R[1] → polyNatDegree(R, w(i)) = 1)) →
    PolyMonic(R, finiteRingProduct(n, Ring.carrier(polynomialRing(R, {0})),
      Ring.add(polynomialRing(R, {0})), Ring.zero(polynomialRing(R, {0})),
      Ring.neg(polynomialRing(R, {0})), Ring.mul(polynomialRing(R, {0})),
      Ring.one(polynomialRing(R, {0})), w)) ∧
    (R[0] ≠ R[1] → polyNatDegree(R, finiteRingProduct(n, Ring.carrier(polynomialRing(R, {0})),
      Ring.add(polynomialRing(R, {0})), Ring.zero(polynomialRing(R, {0})),
      Ring.neg(polynomialRing(R, {0})), Ring.mul(polynomialRing(R, {0})),
      Ring.one(polynomialRing(R, {0})), w)) = n)
proof
  induction n
  | zero =>
    intros w wf vals
    have parts := CommRing.parts with polys
    have fin := Finite.natural at 0
    have values : ∀ x ∈ 0, w(x) = Ring.one(polynomialRing(R, {0}))
      intros x hx
      exfalso
      have xNat := natural.member at 0 with hx
      have lt := Less.of_membership at x, 0
      have l := lt with hx
      arith
    have e := finiteRingProduct.one at 0, Ring.carrier(polynomialRing(R, {0})), Ring.add(polynomialRing(R, {0})), Ring.zero(polynomialRing(R, {0})), Ring.neg(polynomialRing(R, {0})), Ring.mul(polynomialRing(R, {0})), Ring.one(polynomialRing(R, {0})), w with parts, fin, wf, values
    rw e
    have o := uni.one_monic at R with comm, polys
    refine ⟨o.left, ?_⟩
    intro nt
    exact o.right
  | succ(m) using ih =>
    intros w wf vals
    have pr := CommRing.to_ring with polys
    have sub : m ⊆ succ(m)
      intros x hx
      exact membership.into_successor at x, m with hx
    have rf := restrict.domain_function at w, succ(m), Ring.carrier(polynomialRing(R, {0})), m with wf, sub
    have rvals : ∀ i ∈ m, PolyMonic(R, restrict(w, m)(i)) ∧ (R[0] ≠ R[1] → polyNatDegree(R, restrict(w, m)(i)) = 1)
      intros i hi
      rw (restrict.domain_apply at w, succ(m), Ring.carrier(polynomialRing(R, {0})), m, i with wf, sub, hi)
      exact vals with i, (sub with i, hi)
    have r := ih with restrict(w, m), rf, rvals
    rw (uni.prod_succ at R, w, m with comm, polys, wf)
    have mIn := membership.self_successor at m
    have wm := vals with m, mIn
    have pIn : finiteRingProduct(m, Ring.carrier(polynomialRing(R, {0})), Ring.add(polynomialRing(R, {0})), Ring.zero(polynomialRing(R, {0})), Ring.neg(polynomialRing(R, {0})), Ring.mul(polynomialRing(R, {0})), Ring.one(polynomialRing(R, {0})), restrict(w, m)) ∈ Ring.carrier(polynomialRing(R, {0}))
      exact r.left.left
    have wIn := FunctionBetween.apply_closed with wf, mIn
    have mm := PolyMonic.mul at R, finiteRingProduct(m, Ring.carrier(polynomialRing(R, {0})), Ring.add(polynomialRing(R, {0})), Ring.zero(polynomialRing(R, {0})), Ring.neg(polynomialRing(R, {0})), Ring.mul(polynomialRing(R, {0})), Ring.one(polynomialRing(R, {0})), restrict(w, m)), w(m) with comm, polys, pIn, wIn, r.left, wm.left
    refine ⟨mm.left, ?_⟩
    intro nt
    rw mm.right
    rw (r.right with nt)
    rw (wm.right with nt)
    arith

-- Polynomial.monic_prod_X_sub_C, with natDegree the number of factors.
theorem polyLinearProduct.monic (a : Set) (n : Nat)
  requires points : a : n → R.carrier
  shows PolyMonic(R, polyLinearProduct(R, a, n)) ∧
    (R[0] ≠ R[1] → polyNatDegree(R, polyLinearProduct(R, a, n)) = n)
proof
  have wf := linearFactorFamily.function at R, a, n with comm, points
  have vals : ∀ i ∈ n, PolyMonic(R, linearFactorFamily(R, a, n)(i)) ∧ (R[0] ≠ R[1] → polyNatDegree(R, linearFactorFamily(R, a, n)(i)) = 1)
    intros i hi
    have ai := FunctionBetween.apply_closed with points, hi
    rw (linearFactorFamily.value at R, a, n, i with comm, points, hi)
    have mx := PolyMonic.X_sub_C at R, a(i) with comm, polys, ai
    refine ⟨mx, ?_⟩
    intro nt
    exact polyNatDegree.X_sub_C at R, a(i) with comm, polys, ai, nt
  have r := uni.prod_monic at R, n with comm, polys
  unfold polyLinearProduct
  exact r with linearFactorFamily(R, a, n), wf, vals

-- Division by a monic polynomial (Polynomial.modByMonic_add_div,
-- degree_modByMonic_lt, modByMonic_eq_zero_iff_dvd).
theorem polyDivision.spec (p g : polynomialRing(R, {0}))
  requires nontrivial : R[0] ≠ R[1]
  requires monic : PolyMonic(R, g)
  shows p = call2(Ring.add(polynomialRing(R, {0})), call2(Ring.mul(polynomialRing(R, {0})),
      polyDivByMonic(R, p, g), g), polyModByMonic(R, p, g)) ∧
    polyModByMonic(R, p, g) ∈ polyDegreeLT(R, polyNatDegree(R, g))
proof
  have pIn : p ∈ Ring.carrier(polynomialRing(R, {0})) by assumption
  have sel := polyDivision.selected at R, p, g with comm, nontrivial, pIn, monic
  unfold polyDivByMonic
  unfold polyModByMonic
  exact sel.right

theorem polyModByMonic.eq_zero_iff (p g : polynomialRing(R, {0}))
  requires nontrivial : R[0] ≠ R[1]
  requires monic : PolyMonic(R, g)
  shows polyModByMonic(R, p, g) = Ring.zero(polynomialRing(R, {0})) ↔
    RingDvd(polynomialRing(R, {0}), g, p)
proof
  have pr := CommRing.to_ring with polys
  have pIn : p ∈ Ring.carrier(polynomialRing(R, {0})) by assumption
  have gIn : g ∈ Ring.carrier(polynomialRing(R, {0})) by assumption
  have spec := polyDivision.spec at R, p, g with comm, polys, pIn, gIn, nontrivial, monic
  obtain ⟨eq, deg⟩ := spec
  have sel := polyDivision.selected at R, p, g with comm, nontrivial, pIn, monic
  obtain ⟨⟨_, q0, qIn, r0, rIn, shape⟩, _⟩ := sel
  have qd : polyDivByMonic(R, p, g) ∈ Ring.carrier(polynomialRing(R, {0}))
    unfold polyDivByMonic
    rw shape
    rw fst.pair
    exact qIn
  have z : Ring.zero(polynomialRing(R, {0})) ∈ Ring.carrier(polynomialRing(R, {0})) := Ring.zero_mem with *
  constructor
  . intro mz
    rw mz at eq
    have e1 : polyDivByMonic(R, p, g) * g + Ring.zero(polynomialRing(R, {0})) = g * polyDivByMonic(R, p, g) by ring
    have law : p = g * polyDivByMonic(R, p, g) by cc [eq, e1]
    exact RingDvd.intro at polynomialRing(R, {0}), g, p, polyDivByMonic(R, p, g) with polys, gIn, pIn, qd, law
  . intro d
    obtain ⟨_, _, c, cIn, pc⟩ := d
    have zdeg : Ring.zero(polynomialRing(R, {0})) ∈ polyDegreeLT(R, polyNatDegree(R, g))
      unfold polyDegreeLT
      refine ⟨z, ?_⟩
      intros k hk
      unfold polyDegrees at hk
      obtain ⟨kN, nz⟩ := hk
      have kNat := nat.omega.backward with kN
      have c0 := uni.zero_coeff at R, k with comm, polys
      unfold polyCoeff at c0
      exfalso
      apply nz
      exact c0
    have mIn : polyModByMonic(R, p, g) ∈ Ring.carrier(polynomialRing(R, {0}))
      unfold polyDegreeLT at deg
      exact deg.left
    have same : polyDivByMonic(R, p, g) * g + polyModByMonic(R, p, g) = c * g + Ring.zero(polynomialRing(R, {0}))
      have e1 : c * g + Ring.zero(polynomialRing(R, {0})) = g * c by ring
      cc [eq, pc, e1]
    have u := uni.div_unique at R, g, polyDivByMonic(R, p, g), polyModByMonic(R, p, g), c, Ring.zero(polynomialRing(R, {0})) with comm, polys, gIn, qd, mIn, cIn, z, nontrivial, monic, deg, zdeg, same
    exact u.right

-- The remainder and factor theorems: p mod (X − a) = C (p(a))
-- (Polynomial.modByMonic_X_sub_C_eq_C_eval), and X − a ∣ p iff a is a root
-- (Polynomial.dvd_iff_isRoot, mul_divByMonic_eq_iff_isRoot).
theorem polyModByMonic.X_sub_C (p : polynomialRing(R, {0})) (a : R)
  requires nontrivial : R[0] ≠ R[1]
  shows polyModByMonic(R, p, polyXSubC(R, a)) = polyC(R, polyEval(R, p, a))
proof
  have pr := CommRing.to_ring with polys
  have pIn : p ∈ Ring.carrier(polynomialRing(R, {0})) by assumption
  have aIn : a ∈ R.carrier by assumption
  have xa := uni.XsubC_mem at R, a with comm, polys
  have mx := PolyMonic.X_sub_C at R, a with comm, polys
  have spec := polyDivision.spec at R, p, polyXSubC(R, a) with comm, polys, pIn, xa, nontrivial, mx
  obtain ⟨eq, deg⟩ := spec
  rw (polyNatDegree.X_sub_C at R, a with comm, polys, nontrivial) at deg
  have rc := uni.const_of_lt_one at R, polyModByMonic(R, p, polyXSubC(R, a)) with comm, polys, deg
  have sel := polyDivision.selected at R, p, polyXSubC(R, a) with comm, nontrivial, pIn, mx
  obtain ⟨⟨_, q0, qIn, r0, rIn, shape⟩, _⟩ := sel
  have qd : polyDivByMonic(R, p, polyXSubC(R, a)) ∈ Ring.carrier(polynomialRing(R, {0}))
    unfold polyDivByMonic
    rw shape
    rw fst.pair
    exact qIn
  have mIn : polyModByMonic(R, p, polyXSubC(R, a)) ∈ Ring.carrier(polynomialRing(R, {0}))
    unfold polyDegreeLT at deg
    exact deg.left
  have e0 : polyEval(R, p, a) = polyEval(R, polyDivByMonic(R, p, polyXSubC(R, a)) * polyXSubC(R, a) + polyModByMonic(R, p, polyXSubC(R, a)), a) by cc [eq]
  have prodIn : polyDivByMonic(R, p, polyXSubC(R, a)) * polyXSubC(R, a) ∈ Ring.carrier(polynomialRing(R, {0})) := Ring.mul_mem with *
  rw (polyEval.add at R, polyDivByMonic(R, p, polyXSubC(R, a)) * polyXSubC(R, a), polyModByMonic(R, p, polyXSubC(R, a)), a with comm, polys, prodIn, mIn, aIn) at e0
  rw (polyEval.mul at R, polyDivByMonic(R, p, polyXSubC(R, a)), polyXSubC(R, a), a with comm, polys, qd, xa, aIn) at e0
  rw (polyEval.X_sub_C at R, a, a with comm, polys, aIn) at e0
  have c0 := uni.coeff_mem at R, polyModByMonic(R, p, polyXSubC(R, a)), 0 with comm, mIn
  have ev2 := polyEval.C at R, polyCoeff(polyModByMonic(R, p, polyXSubC(R, a)), 0), a with comm, polys, c0, aIn
  rw ← rc at ev2
  rw ev2 at e0
  have h := polyEval.hom at R, a with comm, polys, aIn
  have qa : polyEval(R, polyDivByMonic(R, p, polyXSubC(R, a)), a) ∈ R.carrier
    unfold polyEval
    exact RingHom.map_mem at evaluationAt(R, {0}, constantFunction({0}, R.carrier, a)), polynomialRing(R, {0}), R, polyDivByMonic(R, p, polyXSubC(R, a)) with h, qd
  have simp0 : polyEval(R, polyDivByMonic(R, p, polyXSubC(R, a)), a) * (a - a) + polyCoeff(polyModByMonic(R, p, polyXSubC(R, a)), 0) = polyCoeff(polyModByMonic(R, p, polyXSubC(R, a)), 0) by ring
  rw simp0 at e0
  cc [rc, e0]

-- Polynomial.eval_dvd: divisibility passes to values.
theorem polyEval.dvd (p q : polynomialRing(R, {0})) (b : R)
  requires dvd : RingDvd(polynomialRing(R, {0}), p, q)
  shows RingDvd(R, polyEval(R, p, b), polyEval(R, q, b))
proof
  obtain ⟨pIn, qIn, c, cIn, eq⟩ := dvd
  have h := polyEval.hom at R, b with comm, polys
  have e := polyEval.mul at R, p, c, b with comm, polys, pIn, cIn
  have v1 : polyEval(R, p, b) ∈ R.carrier
    unfold polyEval
    exact RingHom.map_mem at evaluationAt(R, {0}, constantFunction({0}, R.carrier, b)), polynomialRing(R, {0}), R, p with h, pIn
  have v2 : polyEval(R, q, b) ∈ R.carrier
    unfold polyEval
    exact RingHom.map_mem at evaluationAt(R, {0}, constantFunction({0}, R.carrier, b)), polynomialRing(R, {0}), R, q with h, qIn
  have v3 : polyEval(R, c, b) ∈ R.carrier
    unfold polyEval
    exact RingHom.map_mem at evaluationAt(R, {0}, constantFunction({0}, R.carrier, b)), polynomialRing(R, {0}), R, c with h, cIn
  unfold RingDvd
  refine ⟨v1, v2, polyEval(R, c, b), v3, ?_⟩
  rw eq
  exact e

theorem polyXSubC.dvd_iff_root (p : polynomialRing(R, {0})) (a : R)
  shows RingDvd(polynomialRing(R, {0}), polyXSubC(R, a), p) ↔ PolyIsRoot(R, p, a)
proof
  have pr := CommRing.to_ring with polys
  have pIn : p ∈ Ring.carrier(polynomialRing(R, {0})) by assumption
  have aIn : a ∈ R.carrier by assumption
  have xa := uni.XsubC_mem at R, a with comm, polys
  constructor
  . intro d
    have ed := polyEval.dvd at R, polyXSubC(R, a), p, a with comm, polys, xa, pIn, aIn, d
    rw (polyEval.X_sub_C at R, a, a with comm, polys, aIn) at ed
    obtain ⟨_, _, c, cIn, eq⟩ := ed
    have z : a - a = R[0] by ring
    rw z at eq
    have z2 : R[0] * c = R[0] by ring
    rw z2 at eq
    unfold PolyIsRoot
    exact ⟨aIn, eq⟩
  . intro root
    obtain ⟨_, ev⟩ := root
    by_cases nontrivial : R[0] ≠ R[1]
    . have mx := PolyMonic.X_sub_C at R, a with comm, polys, aIn
      have m := polyModByMonic.X_sub_C at R, p, a with comm, polys, pIn, aIn, nontrivial
      rw ev at m
      have c0 : polyC(R, R[0]) = Ring.zero(polynomialRing(R, {0}))
        have ch := polyC.hom at R with comm, polys
        unfold polyC
        exact RingHom.map_zero at polynomialConstant(R, {0}), R, polynomialRing(R, {0}) with ch
      rw c0 at m
      exact (polyModByMonic.eq_zero_iff at R, p, polyXSubC(R, a) with comm, polys, pIn, xa, nontrivial, mx).forward with m
    . have triv : R[0] = R[1] by tauto
      have pz := uni.trivial_zero at R, p with comm, polys, pIn, triv
      rw pz
      exact RingDvd.zero at polynomialRing(R, {0}), polyXSubC(R, a) with polys, xa

-- Root multiplicities (Polynomial.rootMultiplicity_pos,
-- pow_rootMultiplicity_dvd, rootMultiplicity_X_sub_C_self).
theorem polyRootMultiplicity.pos_iff (p : polynomialRing(R, {0})) (a : R)
  requires nontrivial : R[0] ≠ R[1]
  requires nonzero : p ≠ Ring.zero(polynomialRing(R, {0}))
  shows 0 < polyRootMultiplicity(R, p, a) ↔ PolyIsRoot(R, p, a)
proof
  have pr := CommRing.to_ring with polys
  have pIn : p ∈ Ring.carrier(polynomialRing(R, {0})) by assumption
  have aIn : a ∈ R.carrier by assumption
  have xa := uni.XsubC_mem at R, a with comm, polys
  have sel := polyRootMultiplicity.selected at R, p, a with comm, nontrivial, pIn, nonzero, aIn
  obtain ⟨kN, dk, ndk⟩ := sel
  have kNat := nat.omega.backward with kN
  have one := Ring.pow_one at polynomialRing(R, {0}), polyXSubC(R, a) with pr, xa
  constructor
  . intro pos
    have le : 1 ≤ polyRootMultiplicity(R, p, a) by arith
    obtain ⟨e, eNat, keq⟩ := LessEqual.exists_add at 1, polyRootMultiplicity(R, p, a) with le
    have d := uni.pow_dvd_pow at R, polyXSubC(R, a), 1, e with comm, polys, xa
    rw ← keq at d
    rw one at d
    have t := RingDvd.trans at polynomialRing(R, {0}), polyXSubC(R, a), Ring.pow(polynomialRing(R, {0}), polyXSubC(R, a), polyRootMultiplicity(R, p, a)), p with polys, d, dk
    exact (polyXSubC.dvd_iff_root at R, p, a with comm, polys, pIn, aIn).forward with t
  . intro root
    have d := (polyXSubC.dvd_iff_root at R, p, a with comm, polys, pIn, aIn).backward with root
    by_contra npos
    have k0 : polyRootMultiplicity(R, p, a) = 0 by arith
    rw k0 at ndk
    have s1 : succ(0) = 1 by arith
    rw s1 at ndk
    rw one at ndk
    exact ndk with d

theorem polyRootMultiplicity.X_sub_C (a : R)
  requires nontrivial : R[0] ≠ R[1]
  shows polyRootMultiplicity(R, polyXSubC(R, a), a) = 1
proof
  have pr := CommRing.to_ring with polys
  have aIn : a ∈ R.carrier by assumption
  have xa := uni.XsubC_mem at R, a with comm, polys
  have mx := PolyMonic.X_sub_C at R, a with comm, polys, aIn
  have nz := PolyMonic.ne_zero at R, polyXSubC(R, a) with comm, polys, xa, nontrivial, mx
  have root : PolyIsRoot(R, polyXSubC(R, a), a)
    unfold PolyIsRoot
    refine ⟨aIn, ?_⟩
    rw (polyEval.X_sub_C at R, a, a with comm, polys, aIn)
    ring
  have pos := (polyRootMultiplicity.pos_iff at R, polyXSubC(R, a), a with comm, polys, xa, aIn, nontrivial, nz).backward with root
  have sel := polyRootMultiplicity.selected at R, polyXSubC(R, a), a with comm, nontrivial, xa, nz, aIn
  obtain ⟨kN, dk, ndk⟩ := sel
  have kNat := nat.omega.backward with kN
  obtain ⟨_, _, c, cIn, eq⟩ := dk
  have pw := uni.XsubC_pow at R, a, polyRootMultiplicity(R, polyXSubC(R, a), a) with comm, polys, aIn
  have pk : Ring.pow(polynomialRing(R, {0}), polyXSubC(R, a), polyRootMultiplicity(R, polyXSubC(R, a), a)) ∈ Ring.carrier(polynomialRing(R, {0})) by typecheck
  have le := uni.monic_dvd_le at R, Ring.pow(polynomialRing(R, {0}), polyXSubC(R, a), polyRootMultiplicity(R, polyXSubC(R, a), a)), c, polyXSubC(R, a) with comm, polys, pk, cIn, xa, nontrivial, pw.left, eq, nz
  rw (pw.right with nontrivial) at le
  rw (polyNatDegree.X_sub_C at R, a with comm, polys, aIn, nontrivial) at le
  arith

end LawsDivision

-- Section: Roots over a domain
section DomainRoots
variable (R : Set)
hypothesis domain : IntegralDomain(R)
hypothesis polys : CommRing(polynomialRing(R, {0}))

-- Helpers: over a domain, a product of polynomials nonvanishing at b is
-- nonvanishing at b, distinct roots give a dividing product of linear
-- factors, and a nonzero polynomial has finitely many roots.
theorem uni.prod_eval_ne (b : Set) (n : Nat)
  requires point : b ∈ R.carrier
  shows ∀ w, (w : n → Ring.carrier(polynomialRing(R, {0}))) →
    (∀ i ∈ n, polyEval(R, w(i), b) ≠ R[0]) →
    polyEval(R, finiteRingProduct(n, Ring.carrier(polynomialRing(R, {0})),
      Ring.add(polynomialRing(R, {0})), Ring.zero(polynomialRing(R, {0})),
      Ring.neg(polynomialRing(R, {0})), Ring.mul(polynomialRing(R, {0})),
      Ring.one(polynomialRing(R, {0})), w), b) ≠ R[0]
proof
  induction n
  | zero =>
    intros w wf vals
    have d0 := domain
    obtain ⟨comm, nontrivial, _⟩ := d0
    have parts := CommRing.parts with polys
    have fin := Finite.natural at 0
    have values : ∀ x ∈ 0, w(x) = Ring.one(polynomialRing(R, {0}))
      intros x hx
      exfalso
      have xNat := natural.member at 0 with hx
      have lt := Less.of_membership at x, 0
      have l := lt with hx
      arith
    have e := finiteRingProduct.one at 0, Ring.carrier(polynomialRing(R, {0})), Ring.add(polynomialRing(R, {0})), Ring.zero(polynomialRing(R, {0})), Ring.neg(polynomialRing(R, {0})), Ring.mul(polynomialRing(R, {0})), Ring.one(polynomialRing(R, {0})), w with parts, fin, wf, values
    rw e
    rw (uni.one_eq at R with comm, polys)
    have oneIn : R[1] ∈ R.carrier by typecheck
    rw (polyEval.C at R, R[1], b with comm, polys, oneIn)
    intro z
    apply nontrivial
    rw z
  | succ(m) using ih =>
    intros w wf vals
    have d0 := domain
    obtain ⟨comm, nontrivial, noZero⟩ := d0
    have pr := CommRing.to_ring with polys
    have bIn : b ∈ R.carrier by assumption
    have sub : m ⊆ succ(m)
      intros x hx
      exact membership.into_successor at x, m with hx
    have rf := restrict.domain_function at w, succ(m), Ring.carrier(polynomialRing(R, {0})), m with wf, sub
    have rvals : ∀ i ∈ m, polyEval(R, restrict(w, m)(i), b) ≠ R[0]
      intros i hi
      rw (restrict.domain_apply at w, succ(m), Ring.carrier(polynomialRing(R, {0})), m, i with wf, sub, hi)
      exact vals with i, (sub with i, hi)
    have r := ih with restrict(w, m), rf, rvals
    rw (uni.prod_succ at R, w, m with comm, polys, wf)
    have mIn := membership.self_successor at m
    have wm := vals with m, mIn
    have wIn := FunctionBetween.apply_closed with wf, mIn
    have parts := CommRing.parts with polys
    have fin := Finite.natural at m
    have pIn := finiteRingProduct.closed at m, Ring.carrier(polynomialRing(R, {0})), Ring.add(polynomialRing(R, {0})), Ring.zero(polynomialRing(R, {0})), Ring.neg(polynomialRing(R, {0})), Ring.mul(polynomialRing(R, {0})), Ring.one(polynomialRing(R, {0})), restrict(w, m) with parts, fin, rf
    rw (polyEval.mul at R, finiteRingProduct(m, Ring.carrier(polynomialRing(R, {0})), Ring.add(polynomialRing(R, {0})), Ring.zero(polynomialRing(R, {0})), Ring.neg(polynomialRing(R, {0})), Ring.mul(polynomialRing(R, {0})), Ring.one(polynomialRing(R, {0})), restrict(w, m)), w(m), b with comm, polys, pIn, wIn, bIn)
    have h := polyEval.hom at R, b with comm, polys, bIn
    have e1 : polyEval(R, finiteRingProduct(m, Ring.carrier(polynomialRing(R, {0})), Ring.add(polynomialRing(R, {0})), Ring.zero(polynomialRing(R, {0})), Ring.neg(polynomialRing(R, {0})), Ring.mul(polynomialRing(R, {0})), Ring.one(polynomialRing(R, {0})), restrict(w, m)), b) ∈ R.carrier
      unfold polyEval
      exact RingHom.map_mem at evaluationAt(R, {0}, constantFunction({0}, R.carrier, b)), polynomialRing(R, {0}), R, finiteRingProduct(m, Ring.carrier(polynomialRing(R, {0})), Ring.add(polynomialRing(R, {0})), Ring.zero(polynomialRing(R, {0})), Ring.neg(polynomialRing(R, {0})), Ring.mul(polynomialRing(R, {0})), Ring.one(polynomialRing(R, {0})), restrict(w, m)) with h, pIn
    have e2 : polyEval(R, w(m), b) ∈ R.carrier
      unfold polyEval
      exact RingHom.map_mem at evaluationAt(R, {0}, constantFunction({0}, R.carrier, b)), polynomialRing(R, {0}), R, w(m) with h, wIn
    intro z
    have alt := noZero with polyEval(R, finiteRingProduct(m, Ring.carrier(polynomialRing(R, {0})), Ring.add(polynomialRing(R, {0})), Ring.zero(polynomialRing(R, {0})), Ring.neg(polynomialRing(R, {0})), Ring.mul(polynomialRing(R, {0})), Ring.one(polynomialRing(R, {0})), restrict(w, m)), b), e1, polyEval(R, w(m), b), e2, z
    cases alt with x | y
    . apply r
      exact x
    . apply wm
      exact y

theorem uni.prod_dvd (p a : Set) (n : Nat)
  requires member : p ∈ Ring.carrier(polynomialRing(R, {0}))
  shows ∀ w, (w : n → Ring.carrier(polynomialRing(R, {0}))) →
    (∀ i ∈ n, a(i) ∈ R.carrier ∧ w(i) = polyXSubC(R, a(i)) ∧ PolyIsRoot(R, p, a(i))) →
    (∀ i ∈ n, ∀ j ∈ n, a(i) = a(j) → i = j) →
    RingDvd(polynomialRing(R, {0}), finiteRingProduct(n, Ring.carrier(polynomialRing(R, {0})),
      Ring.add(polynomialRing(R, {0})), Ring.zero(polynomialRing(R, {0})),
      Ring.neg(polynomialRing(R, {0})), Ring.mul(polynomialRing(R, {0})),
      Ring.one(polynomialRing(R, {0})), w), p)
proof
  induction n
  | zero =>
    intros w wf vals dist
    have d0 := domain
    obtain ⟨comm, _, _⟩ := d0
    have parts := CommRing.parts with polys
    have fin := Finite.natural at 0
    have values : ∀ x ∈ 0, w(x) = Ring.one(polynomialRing(R, {0}))
      intros x hx
      exfalso
      have xNat := natural.member at 0 with hx
      have lt := Less.of_membership at x, 0
      have l := lt with hx
      arith
    have e := finiteRingProduct.one at 0, Ring.carrier(polynomialRing(R, {0})), Ring.add(polynomialRing(R, {0})), Ring.zero(polynomialRing(R, {0})), Ring.neg(polynomialRing(R, {0})), Ring.mul(polynomialRing(R, {0})), Ring.one(polynomialRing(R, {0})), w with parts, fin, wf, values
    rw e
    exact RingDvd.one at polynomialRing(R, {0}), p with polys, member
  | succ(m) using ih =>
    intros w wf vals dist
    have d0 := domain
    obtain ⟨comm, nontrivial, noZero⟩ := d0
    have pr := CommRing.to_ring with polys
    have sub : m ⊆ succ(m)
      intros x hx
      exact membership.into_successor at x, m with hx
    have rf := restrict.domain_function at w, succ(m), Ring.carrier(polynomialRing(R, {0})), m with wf, sub
    have rvals : ∀ i ∈ m, a(i) ∈ R.carrier ∧ restrict(w, m)(i) = polyXSubC(R, a(i)) ∧ PolyIsRoot(R, p, a(i))
      intros i hi
      rw (restrict.domain_apply at w, succ(m), Ring.carrier(polynomialRing(R, {0})), m, i with wf, sub, hi)
      exact vals with i, (sub with i, hi)
    have rdist : ∀ i ∈ m, ∀ j ∈ m, a(i) = a(j) → i = j
      intros i hi j hj e
      exact dist with i, (sub with i, hi), j, (sub with j, hj), e
    have d := ih with restrict(w, m), rf, rvals, rdist
    obtain ⟨_, _, c, cIn, pc⟩ := d
    have mIn := membership.self_successor at m
    obtain ⟨amIn, wmEq, amRoot⟩ := vals with m, mIn
    have ne : ∀ i ∈ m, polyEval(R, restrict(w, m)(i), a(m)) ≠ R[0]
      intros i hi
      obtain ⟨aiIn, wiEq, _⟩ := rvals with i, hi
      rw wiEq
      rw (polyEval.X_sub_C at R, a(i), a(m) with comm, polys, aiIn, amIn)
      intro z
      have e1 : a(m) = (a(m) - a(i)) + a(i) by ring
      rw z at e1
      have e2 : R[0] + a(i) = a(i) by ring
      rw e2 at e1
      have ij := dist with m, mIn, i, (sub with i, hi), e1
      have no := membership.irreflexive at m
      rw ← ij at hi
      exact no with hi
    have pne := uni.prod_eval_ne at R, a(m), m with domain, polys, amIn
    have pe := pne with restrict(w, m), rf, ne
    have parts := CommRing.parts with polys
    have fin := Finite.natural at m
    have pIn := finiteRingProduct.closed at m, Ring.carrier(polynomialRing(R, {0})), Ring.add(polynomialRing(R, {0})), Ring.zero(polynomialRing(R, {0})), Ring.neg(polynomialRing(R, {0})), Ring.mul(polynomialRing(R, {0})), Ring.one(polynomialRing(R, {0})), restrict(w, m) with parts, fin, rf
    obtain ⟨_, ev⟩ := amRoot
    have e0 : polyEval(R, p, a(m)) = polyEval(R, finiteRingProduct(m, Ring.carrier(polynomialRing(R, {0})), Ring.add(polynomialRing(R, {0})), Ring.zero(polynomialRing(R, {0})), Ring.neg(polynomialRing(R, {0})), Ring.mul(polynomialRing(R, {0})), Ring.one(polynomialRing(R, {0})), restrict(w, m)) * c, a(m)) by cc [pc]
    rw (polyEval.mul at R, finiteRingProduct(m, Ring.carrier(polynomialRing(R, {0})), Ring.add(polynomialRing(R, {0})), Ring.zero(polynomialRing(R, {0})), Ring.neg(polynomialRing(R, {0})), Ring.mul(polynomialRing(R, {0})), Ring.one(polynomialRing(R, {0})), restrict(w, m)), c, a(m) with comm, polys, pIn, cIn, amIn) at e0
    rw ev at e0
    have h := polyEval.hom at R, a(m) with comm, polys, amIn
    have e1 : polyEval(R, finiteRingProduct(m, Ring.carrier(polynomialRing(R, {0})), Ring.add(polynomialRing(R, {0})), Ring.zero(polynomialRing(R, {0})), Ring.neg(polynomialRing(R, {0})), Ring.mul(polynomialRing(R, {0})), Ring.one(polynomialRing(R, {0})), restrict(w, m)), a(m)) ∈ R.carrier
      unfold polyEval
      exact RingHom.map_mem at evaluationAt(R, {0}, constantFunction({0}, R.carrier, a(m))), polynomialRing(R, {0}), R, finiteRingProduct(m, Ring.carrier(polynomialRing(R, {0})), Ring.add(polynomialRing(R, {0})), Ring.zero(polynomialRing(R, {0})), Ring.neg(polynomialRing(R, {0})), Ring.mul(polynomialRing(R, {0})), Ring.one(polynomialRing(R, {0})), restrict(w, m)) with h, pIn
    have e2 : polyEval(R, c, a(m)) ∈ R.carrier
      unfold polyEval
      exact RingHom.map_mem at evaluationAt(R, {0}, constantFunction({0}, R.carrier, a(m))), polynomialRing(R, {0}), R, c with h, cIn
    have z : polyEval(R, finiteRingProduct(m, Ring.carrier(polynomialRing(R, {0})), Ring.add(polynomialRing(R, {0})), Ring.zero(polynomialRing(R, {0})), Ring.neg(polynomialRing(R, {0})), Ring.mul(polynomialRing(R, {0})), Ring.one(polynomialRing(R, {0})), restrict(w, m)), a(m)) * polyEval(R, c, a(m)) = R[0]
      rw ← e0
    have alt := noZero with polyEval(R, finiteRingProduct(m, Ring.carrier(polynomialRing(R, {0})), Ring.add(polynomialRing(R, {0})), Ring.zero(polynomialRing(R, {0})), Ring.neg(polynomialRing(R, {0})), Ring.mul(polynomialRing(R, {0})), Ring.one(polynomialRing(R, {0})), restrict(w, m)), a(m)), e1, polyEval(R, c, a(m)), e2, z
    have cz : polyEval(R, c, a(m)) = R[0]
      cases alt with x | y
      . exfalso
        apply pe
        exact x
      . exact y
    have croot : PolyIsRoot(R, c, a(m))
      unfold PolyIsRoot
      exact ⟨amIn, cz⟩
    have cd := (polyXSubC.dvd_iff_root at R, c, a(m) with comm, polys, cIn, amIn).backward with croot
    obtain ⟨_, _, c2, c2In, cc2⟩ := cd
    rw (uni.prod_succ at R, w, m with comm, polys, wf)
    rw wmEq
    have xa := uni.XsubC_mem at R, a(m) with comm, polys, amIn
    have law : p = finiteRingProduct(m, Ring.carrier(polynomialRing(R, {0})), Ring.add(polynomialRing(R, {0})), Ring.zero(polynomialRing(R, {0})), Ring.neg(polynomialRing(R, {0})), Ring.mul(polynomialRing(R, {0})), Ring.one(polynomialRing(R, {0})), restrict(w, m)) * polyXSubC(R, a(m)) * c2
      have e3 : finiteRingProduct(m, Ring.carrier(polynomialRing(R, {0})), Ring.add(polynomialRing(R, {0})), Ring.zero(polynomialRing(R, {0})), Ring.neg(polynomialRing(R, {0})), Ring.mul(polynomialRing(R, {0})), Ring.one(polynomialRing(R, {0})), restrict(w, m)) * (polyXSubC(R, a(m)) * c2) = finiteRingProduct(m, Ring.carrier(polynomialRing(R, {0})), Ring.add(polynomialRing(R, {0})), Ring.zero(polynomialRing(R, {0})), Ring.neg(polynomialRing(R, {0})), Ring.mul(polynomialRing(R, {0})), Ring.one(polynomialRing(R, {0})), restrict(w, m)) * polyXSubC(R, a(m)) * c2 by ring
      rw cc2 at pc
      cc [pc, e3]
    have lIn : finiteRingProduct(m, Ring.carrier(polynomialRing(R, {0})), Ring.add(polynomialRing(R, {0})), Ring.zero(polynomialRing(R, {0})), Ring.neg(polynomialRing(R, {0})), Ring.mul(polynomialRing(R, {0})), Ring.one(polynomialRing(R, {0})), restrict(w, m)) * polyXSubC(R, a(m)) ∈ Ring.carrier(polynomialRing(R, {0})) := Ring.mul_mem with *
    exact RingDvd.intro at polynomialRing(R, {0}), finiteRingProduct(m, Ring.carrier(polynomialRing(R, {0})), Ring.add(polynomialRing(R, {0})), Ring.zero(polynomialRing(R, {0})), Ring.neg(polynomialRing(R, {0})), Ring.mul(polynomialRing(R, {0})), Ring.one(polynomialRing(R, {0})), restrict(w, m)) * polyXSubC(R, a(m)), p, c2 with polys, lIn, member, c2In, law

-- Helper: a nonzero polynomial over a domain has finitely many roots, by
-- induction on a bound for its degree.
theorem uni.roots_finite (N : Nat)
  shows ∀ p ∈ Ring.carrier(polynomialRing(R, {0})),
    p ≠ Ring.zero(polynomialRing(R, {0})) → polyNatDegree(R, p) ≤ N →
    Finite(polyRootSet(R, p))
proof
  induction N
  | zero =>
    intros p hp nz le
    have d0 := domain
    obtain ⟨comm, nontrivial, noZero⟩ := d0
    have pr := CommRing.to_ring with polys
    have sub : polyRootSet(R, p) ⊆ ∅
      intros b hb
      unfold polyRootSet at hb
      obtain ⟨bIn, ev⟩ := hb
      exfalso
      have root : PolyIsRoot(R, p, b)
        unfold PolyIsRoot
        exact ⟨bIn, ev⟩
      have d := (polyXSubC.dvd_iff_root at R, p, b with comm, polys, hp, bIn).backward with root
      obtain ⟨_, _, q, qIn, pq⟩ := d
      have xa := uni.XsubC_mem at R, b with comm, polys, bIn
      have mx := PolyMonic.X_sub_C at R, b with comm, polys, bIn
      have xz := PolyMonic.ne_zero at R, polyXSubC(R, b) with comm, polys, xa, nontrivial, mx
      have dl := uni.monic_dvd_le at R, polyXSubC(R, b), q, p with comm, polys, xa, qIn, hp, nontrivial, mx, pq, nz
      rw (polyNatDegree.X_sub_C at R, b with comm, polys, bIn, nontrivial) at dl
      arith
    exact Finite.subset with Finite.empty, sub
  | succ(M) using ih =>
    intros p hp nz le
    have d0 := domain
    obtain ⟨comm, nontrivial, noZero⟩ := d0
    have pr := CommRing.to_ring with polys
    by_cases some : ∃ a ∈ polyRootSet(R, p), a = a
    . obtain ⟨a, ha, _⟩ := some
      have ha2 := ha
      unfold polyRootSet at ha2
      obtain ⟨aIn, ev⟩ := ha2
      have root : PolyIsRoot(R, p, a)
        unfold PolyIsRoot
        exact ⟨aIn, ev⟩
      have d := (polyXSubC.dvd_iff_root at R, p, a with comm, polys, hp, aIn).backward with root
      obtain ⟨_, _, q, qIn, pq⟩ := d
      have xa := uni.XsubC_mem at R, a with comm, polys, aIn
      have qz : q ≠ Ring.zero(polynomialRing(R, {0}))
        intro e
        apply nz
        rw pq
        rw e
        ring
      have mx := PolyMonic.X_sub_C at R, a with comm, polys, aIn
      have xz := PolyMonic.ne_zero at R, polyXSubC(R, a) with comm, polys, xa, nontrivial, mx
      have deg := polyNatDegree.mul at R, polyXSubC(R, a), q with comm, polys, xa, qIn, domain, xz, qz
      rw ← pq at deg
      rw (polyNatDegree.X_sub_C at R, a with comm, polys, aIn, nontrivial) at deg
      have dq : polyNatDegree(R, q) ∈ ℕ
        have sel := polyNatDegree.selected at R, q with comm, qIn
        exact sel.left
      have dqN := nat.omega.backward with dq
      have qle : polyNatDegree(R, q) ≤ M by arith
      have fq := ih with q, qIn, qz, qle
      have sub : polyRootSet(R, p) ⊆ {a} ∪ polyRootSet(R, q)
        intros b hb
        unfold polyRootSet at hb
        obtain ⟨bIn, evb⟩ := hb
        have e0 : polyEval(R, p, b) = polyEval(R, polyXSubC(R, a) * q, b) by cc [pq]
        rw (polyEval.mul at R, polyXSubC(R, a), q, b with comm, polys, xa, qIn, bIn) at e0
        rw (polyEval.X_sub_C at R, a, b with comm, polys, aIn, bIn) at e0
        rw evb at e0
        have h := polyEval.hom at R, b with comm, polys, bIn
        have qb : polyEval(R, q, b) ∈ R.carrier
          unfold polyEval
          exact RingHom.map_mem at evaluationAt(R, {0}, constantFunction({0}, R.carrier, b)), polynomialRing(R, {0}), R, q with h, qIn
        have ba : b - a ∈ R.carrier by typecheck
        have z : (b - a) * polyEval(R, q, b) = R[0]
          rw ← e0
        have alt := noZero with b - a, ba, polyEval(R, q, b), qb, z
        apply (union2.membership at b, {a}, polyRootSet(R, q)).backward
        cases alt with x | y
        . left
          have e1 : b = (b - a) + a by ring
          rw x at e1
          have e2 : R[0] + a = a by ring
          rw e2 at e1
          rw singleton.membership
          exact e1
        . right
          unfold polyRootSet
          exact ⟨bIn, y⟩
      have fu := Finite.union with (Finite.singleton at a), fq
      exact Finite.subset with fu, sub
    . have sub : polyRootSet(R, p) ⊆ ∅
        intros b hb
        exfalso
        apply some
        refine ⟨b, hb, ?_⟩
        rfl
      exact Finite.subset with Finite.empty, sub

-- Distinct roots give a dividing product of linear factors
-- (Polynomial.prod_multiset_X_sub_C_dvd), so a nonzero polynomial has at
-- most natDegree roots (Polynomial.card_roots', card_le_degree_of_subset_roots).
theorem polyLinearProduct.dvd_of_roots (p a : Set) (n : Nat)
  requires member : p ∈ Ring.carrier(polynomialRing(R, {0}))
  requires points : a : n → R.carrier
  requires distinct : InjectiveBetween(a, n, R.carrier)
  requires roots : ∀ i ∈ n, PolyIsRoot(R, p, a(i))
  shows RingDvd(polynomialRing(R, {0}), polyLinearProduct(R, a, n), p)
proof
  have d0 := domain
  obtain ⟨comm, nontrivial, _⟩ := d0
  have wf := linearFactorFamily.function at R, a, n with comm, points
  have vals : ∀ i ∈ n, a(i) ∈ R.carrier ∧ linearFactorFamily(R, a, n)(i) = polyXSubC(R, a(i)) ∧ PolyIsRoot(R, p, a(i))
    intros i hi
    have ai := FunctionBetween.apply_closed with points, hi
    have v := linearFactorFamily.value at R, a, n, i with comm, points, hi
    have r := roots with i, hi
    exact ⟨ai, v, r⟩
  have dist : ∀ i ∈ n, ∀ j ∈ n, a(i) = a(j) → i = j
    intros i hi j hj e
    have ai := FunctionBetween.apply_closed with points, hi
    have r1 := FunctionBetween.relates_apply with points, hi
    have r2 := FunctionBetween.relates_apply with points, hj
    rw ← e at r2
    exact Injective.cancel at a, n, R.carrier, i, j, a(i) with distinct, hi, hj, ai, r1, r2
  have r := uni.prod_dvd at R, p, a, n with domain, polys, member
  unfold polyLinearProduct
  exact r with linearFactorFamily(R, a, n), wf, vals, dist

theorem polyRootSet.card_le (p V : Set) (n : Nat)
  requires member : p ∈ Ring.carrier(polynomialRing(R, {0}))
  requires nonzero : p ≠ Ring.zero(polynomialRing(R, {0}))
  requires roots : V ⊆ polyRootSet(R, p)
  requires count : HasCardinality(V, n)
  shows n ≤ polyNatDegree(R, p)
proof
  have d0 := domain
  obtain ⟨comm, nontrivial, _⟩ := d0
  have c0 := count
  obtain ⟨_, eqp⟩ := c0
  obtain ⟨f, bij⟩ := eqp
  have af := converse.function_of_bijective with bij
  have ai := converse.injective_of_bijective with bij
  have inR : ∀ i ∈ n, converse(f, V, n)(i) ∈ R.carrier
    intros i hi
    have v := FunctionBetween.apply_closed with af, hi
    have r := roots with converse(f, V, n)(i), v
    unfold polyRootSet at r
    exact r.left
  have ac := FunctionBetween.codomain_of_values with af, inR
  have rts : ∀ i ∈ n, PolyIsRoot(R, p, converse(f, V, n)(i))
    intros i hi
    have v := FunctionBetween.apply_closed with af, hi
    have r := roots with converse(f, V, n)(i), v
    unfold polyRootSet at r
    unfold PolyIsRoot
    exact r
  have inj : InjectiveBetween(converse(f, V, n), n, R.carrier)
    apply Injective.of_pointwise with ac
    intros i hi j hj e
    have v := FunctionBetween.apply_closed with af, hi
    have r1 := FunctionBetween.relates_apply with af, hi
    have r2 := FunctionBetween.relates_apply with af, hj
    rw ← e at r2
    exact Injective.cancel at converse(f, V, n), n, V, i, j, converse(f, V, n)(i) with ai, hi, hj, v, r1, r2
  have d := polyLinearProduct.dvd_of_roots at R, p, converse(f, V, n), n with domain, polys, member, ac, inj, rts
  obtain ⟨lIn, _, c, cIn, pc⟩ := d
  have lm := polyLinearProduct.monic at R, converse(f, V, n), n with comm, polys, ac
  have le := uni.monic_dvd_le at R, polyLinearProduct(R, converse(f, V, n), n), c, p with comm, polys, lIn, cIn, member, nontrivial, lm.left, pc, nonzero
  rw (lm.right with nontrivial) at le
  exact le

-- The root set of a nonzero polynomial is finite.
theorem polyRootSet.finite (p : Set)
  requires member : p ∈ Ring.carrier(polynomialRing(R, {0}))
  requires nonzero : p ≠ Ring.zero(polynomialRing(R, {0}))
  shows Finite(polyRootSet(R, p))
proof
  have d0 := domain
  obtain ⟨comm, _, _⟩ := d0
  have sel := polyNatDegree.selected at R, p with comm, member
  have dN := sel.left
  have dNat := nat.omega.backward with dN
  have r := uni.roots_finite at R, polyNatDegree(R, p) with domain, polys
  have le : polyNatDegree(R, p) ≤ polyNatDegree(R, p) by arith
  exact r with p, member, nonzero, le

-- With multiplicities: Π (X − a)^{m(a)} over finitely many distinct roots
-- divides p, so the multiplicities add up to at most natDegree
-- (Polynomial.card_roots').
theorem polyRootMultiplicity.sum_le (p a : Set) (n : Nat)
  requires member : p ∈ Ring.carrier(polynomialRing(R, {0}))
  requires nonzero : p ≠ Ring.zero(polynomialRing(R, {0}))
  requires points : a : n → R.carrier
  requires distinct : InjectiveBetween(a, n, R.carrier)
  shows RingDvd(polynomialRing(R, {0}),
    finiteRingProduct(n, Ring.carrier(polynomialRing(R, {0})),
      Ring.add(polynomialRing(R, {0})), Ring.zero(polynomialRing(R, {0})),
      Ring.neg(polynomialRing(R, {0})), Ring.mul(polynomialRing(R, {0})),
      Ring.one(polynomialRing(R, {0})), multiplicityFactors(R, p, a, n)), p)
proof
  sorry

-- Two polynomials of degree at most n agreeing at more than n points are
-- equal (Polynomial.eq_of_degree_sub_lt_of_eval_finset_eq).
theorem polynomial.eq_of_agree (p q V : Set) (n : Nat)
  requires first : PolyDegreeLE(R, p, n)
  requires second : PolyDegreeLE(R, q, n)
  requires points : V ⊆ R.carrier
  requires many : HasCardinality(V, succ(n))
  requires agree : ∀ b ∈ V, polyEval(R, p, b) = polyEval(R, q, b)
  shows p = q
proof
  have d0 := domain
  obtain ⟨comm, nontrivial, _⟩ := d0
  have pr := CommRing.to_ring with polys
  have pIn := first.left
  have qIn := second.left
  have rIn : p - q ∈ Ring.carrier(polynomialRing(R, {0})) := Ring.sub_mem with *
  have vp := uni.vanish_of_le at R, p, n with comm, polys, first
  have vq := uni.vanish_of_le at R, q, n with comm, polys, second
  have vr : ∀ k ∈ ℕ, n < k → polyCoeff(p - q, k) = R[0]
    intros k hk lt
    have kNat := nat.omega.backward with hk
    rw (uni.coeff_sub at R, p, q, k with comm, polys, pIn, qIn)
    rw [(vp with k, hk, lt), (vq with k, hk, lt)]
    ring
  have dr := uni.deg_le at R, p - q, n with comm, polys, rIn, vr
  have rz : p - q = Ring.zero(polynomialRing(R, {0}))
    by_contra nz
    have sub : V ⊆ polyRootSet(R, p - q)
      intros b hb
      have bIn := points with b, hb
      have h := polyEval.hom at R, b with comm, polys, bIn
      unfold polyRootSet
      refine ⟨bIn, ?_⟩
      unfold polyEval
      rw (RingHom.map_sub at evaluationAt(R, {0}, constantFunction({0}, R.carrier, b)), polynomialRing(R, {0}), R, p, q with h, pIn, qIn)
      have ag := agree with b, hb
      unfold polyEval at ag
      rw ag
      have qb : evaluationAt(R, {0}, constantFunction({0}, R.carrier, b))(q) ∈ R.carrier
        exact RingHom.map_mem at evaluationAt(R, {0}, constantFunction({0}, R.carrier, b)), polynomialRing(R, {0}), R, q with h, qIn
      ring
    have cl := polyRootSet.card_le at R, p - q, V, succ(n) with domain, polys, rIn, nz, sub, many
    arith
  have e1 : p = (p - q) + q by ring
  rw rz at e1
  have e2 : Ring.zero(polynomialRing(R, {0})) + q = q by ring
  cc [e1, e2]

-- Over an infinite domain, polynomials with the same values are equal
-- (Polynomial.funext).
theorem polynomial.funext (p q : Set)
  requires infinite : ¬Finite(R.carrier)
  requires first : p ∈ Ring.carrier(polynomialRing(R, {0}))
  requires second : q ∈ Ring.carrier(polynomialRing(R, {0}))
  requires agree : ∀ b ∈ R.carrier, polyEval(R, p, b) = polyEval(R, q, b)
  shows p = q
proof
  have d0 := domain
  obtain ⟨comm, nontrivial, _⟩ := d0
  have pr := CommRing.to_ring with polys
  have rIn : p - q ∈ Ring.carrier(polynomialRing(R, {0})) := Ring.sub_mem with *
  have rz : p - q = Ring.zero(polynomialRing(R, {0}))
    by_contra nz
    have fin := polyRootSet.finite at R, p - q with domain, polys, rIn, nz
    have sub : R.carrier ⊆ polyRootSet(R, p - q)
      intros b bIn
      have h := polyEval.hom at R, b with comm, polys, bIn
      unfold polyRootSet
      refine ⟨bIn, ?_⟩
      unfold polyEval
      rw (RingHom.map_sub at evaluationAt(R, {0}, constantFunction({0}, R.carrier, b)), polynomialRing(R, {0}), R, p, q with h, first, second)
      have ag := agree with b, bIn
      unfold polyEval at ag
      rw ag
      have qb : evaluationAt(R, {0}, constantFunction({0}, R.carrier, b))(q) ∈ R.carrier
        exact RingHom.map_mem at evaluationAt(R, {0}, constantFunction({0}, R.carrier, b)), polynomialRing(R, {0}), R, q with h, second
      ring
    apply infinite
    exact Finite.subset with fin, sub
  have e1 : p = (p - q) + q by ring
  rw rz at e1
  have e2 : Ring.zero(polynomialRing(R, {0})) + q = q by ring
  cc [e1, e2]

-- A monic polynomial with n distinct roots of degree n is the product of
-- its linear factors (Polynomial.eq_prod_roots_of_monic_of_splits_id in
-- the distinct-root form).
theorem PolyMonic.eq_linear_product (p a : Set) (n : Nat)
  requires monic : PolyMonic(R, p)
  requires degree : polyNatDegree(R, p) = n
  requires points : a : n → R.carrier
  requires distinct : InjectiveBetween(a, n, R.carrier)
  requires roots : ∀ i ∈ n, PolyIsRoot(R, p, a(i))
  shows p = polyLinearProduct(R, a, n)
proof
  have d0 := domain
  obtain ⟨comm, nontrivial, _⟩ := d0
  have pr := CommRing.to_ring with polys
  have pIn := monic.left
  have d := polyLinearProduct.dvd_of_roots at R, p, a, n with domain, polys, pIn, points, distinct, roots
  obtain ⟨lIn, _, c, cIn, pc⟩ := d
  have lm := polyLinearProduct.monic at R, a, n with comm, polys, points
  have pz := PolyMonic.ne_zero at R, p with comm, polys, pIn, nontrivial, monic
  have lz := PolyMonic.ne_zero at R, polyLinearProduct(R, a, n) with comm, polys, lIn, nontrivial, lm.left
  have cz : c ≠ Ring.zero(polynomialRing(R, {0}))
    intro e
    apply pz
    rw pc
    rw e
    ring
  have deg := polyNatDegree.mul at R, polyLinearProduct(R, a, n), c with comm, polys, lIn, cIn, domain, lz, cz
  rw ← pc at deg
  rw degree at deg
  rw (lm.right with nontrivial) at deg
  have dc : polyNatDegree(R, c) ∈ ℕ
    have sel := polyNatDegree.selected at R, c with comm, cIn
    exact sel.left
  have dcN := nat.omega.backward with dc
  have dc0 : polyNatDegree(R, c) = 0 by arith
  have lead := polyLeadingCoeff.mul at R, polyLinearProduct(R, a, n), c with comm, polys, lIn, cIn, domain
  rw ← pc at lead
  rw monic.right at lead
  rw lm.left.right at lead
  rw (uni.lead_eq at R, c with comm, polys) at lead
  rw dc0 at lead
  have c0 := uni.coeff_mem at R, c, 0 with comm, cIn
  have one : R[1] * polyCoeff(c, 0) = polyCoeff(c, 0) by ring
  rw one at lead
  have cl : c ∈ polyDegreeLT(R, 1)
    unfold polyDegreeLT
    refine ⟨cIn, ?_⟩
    intros k hk
    have sc := uni.deg_spec at R, c with comm, polys, cIn
    unfold polyDegrees at hk
    obtain ⟨kN, nzk⟩ := hk
    have kNat := nat.omega.backward with kN
    have nz2 : polyCoeff(c, k) ≠ R[0]
      unfold polyCoeff
      exact nzk
    have le := sc.left with k, kN, nz2
    arith
  have cc1 := uni.const_of_lt_one at R, c with comm, polys, cl
  rw ← lead at cc1
  rw ← (uni.one_eq at R with comm, polys) at cc1
  rw cc1 at pc
  have e : polyLinearProduct(R, a, n) * Ring.one(polynomialRing(R, {0})) = polyLinearProduct(R, a, n) by ring
  cc [pc, e]

end DomainRoots

-- Section: Evaluation in an algebra
section AlgebraEvaluation
variable (A : Set)
hypothesis algebra : Algebra(A)

-- Polynomial.aeval: an algebra homomorphism R[X] → A with X ↦ x
-- (aeval_X, aeval_C, aeval_def), the only one (Polynomial.algHom_ext).
theorem polyAevalHom.algebra_hom (x : Set)
  requires point : x ∈ algebraCarrier(A)
  shows AlgebraHom(polyAevalHom(A, x), polynomialAlgebra(Algebra.base(A), {0}), A)
proof
  have base := Algebra.base_comm_ring at A with algebra
  have v := constantFunction.function at {0}, algebraCarrier(A), x with *
  have over : Algebra.base(A) = Algebra.base(A) by rfl
  unfold polyAevalHom
  exact evaluationHom.algebra_hom at Algebra.base(A), {0}, A, constantFunction({0}, algebraCarrier(A), x) with base, algebra, over, v

theorem polyAeval.X (x : Set)
  requires point : x ∈ algebraCarrier(A)
  shows polyAeval(A, x, polyX(Algebra.base(A))) = x
proof
  have base := Algebra.base_comm_ring at A with algebra
  have polysK := polynomialRing.comm_ring at Algebra.base(A), {0} with base
  have ringA := Algebra.comm_ring at A with algebra
  have sh := Algebra.structure_hom at A with algebra
  have pt := point
  unfold algebraCarrier at pt
  unfold polyAeval
  exact polyEval2.X at Algebra.base(A), Algebra.ring(A), Algebra.map(A), x with base, polysK, ringA, sh, pt

theorem polyAeval.C (x a : Set)
  requires point : x ∈ algebraCarrier(A)
  requires scalar : a ∈ Ring.carrier(Algebra.base(A))
  shows polyAeval(A, x, polyC(Algebra.base(A), a)) = Algebra.map(A)(a)
proof
  have base := Algebra.base_comm_ring at A with algebra
  have polysK := polynomialRing.comm_ring at Algebra.base(A), {0} with base
  have ringA := Algebra.comm_ring at A with algebra
  have sh := Algebra.structure_hom at A with algebra
  have pt := point
  unfold algebraCarrier at pt
  unfold polyAeval
  exact polyEval2.C at Algebra.base(A), Algebra.ring(A), Algebra.map(A), x, a with base, polysK, ringA, sh, pt, scalar

theorem polyAevalHom.unique (x f : Set)
  requires point : x ∈ algebraCarrier(A)
  requires hom : AlgebraHom(f, polynomialAlgebra(Algebra.base(A), {0}), A)
  requires variable : f(polyX(Algebra.base(A))) = x
  shows f = polyAevalHom(A, x)
proof
  have base := Algebra.base_comm_ring at A with algebra
  have g := polyAevalHom.algebra_hom at A, x with algebra, point
  apply AlgebraHom.polynomial_ext at Algebra.base(A), {0}, A, f, polyAevalHom(A, x) with base, hom, g
  intros j hj
  have v := constantFunction.function at {0}, algebraCarrier(A), x with *
  have over : Algebra.base(A) = Algebra.base(A) by rfl
  unfold polyAevalHom
  rw (evaluationHom.algebra_X at Algebra.base(A), {0}, A, constantFunction({0}, algebraCarrier(A), x), j with base, algebra, over, v, hj)
  rw singleton.membership at hj
  rw hj
  have zero : 0 ∈ {0} by simp [singleton.membership]
  rw (constantFunction.apply at {0}, algebraCarrier(A), 0, x with zero, point)
  unfold polyX at variable
  exact variable

-- Polynomial.aeval_algHom_apply: algebra homomorphisms commute with aeval.
theorem polyAeval.algebra_hom_apply (B φ x p : Set)
  requires hom : φ : A →ₐ B
  requires point : x ∈ algebraCarrier(A)
  requires member : p ∈ Ring.carrier(polynomialRing(Algebra.base(A), {0}))
  shows φ(polyAeval(A, x, p)) = polyAeval(B, φ(x), p)
proof
  have base := Algebra.base_comm_ring at A with algebra
  have polysK := polynomialRing.comm_ring at Algebra.base(A), {0} with base
  have ringA := Algebra.comm_ring at A with algebra
  have algB := AlgebraHom.target at φ, A, B with hom
  have ringB := Algebra.comm_ring at B with algB
  have sh := Algebra.structure_hom at A with algebra
  have rh := AlgebraHom.ring_hom at φ, A, B with hom
  have bEq := AlgebraHom.base_eq at φ, A, B with hom
  have pt := point
  unfold algebraCarrier at pt
  have pc := polyEval2.compose at Algebra.base(A), Algebra.ring(A), Algebra.ring(B), Algebra.map(A), φ, x, p with base, polysK, ringA, ringB, sh, rh, pt, member
  have mfA := Algebra.map_function at A with algebra
  unfold algebraCarrier at mfA
  have mfB := Algebra.map_function at B with algB
  unfold algebraCarrier at mfB
  rw ← bEq at mfB
  have r0 := rh
  obtain ⟨_, _, φfn, _⟩ := r0
  have cf := compose.function at φ, Algebra.map(A), Ring.carrier(Algebra.base(A)), Ring.carrier(Algebra.ring(A)), Ring.carrier(Algebra.ring(B)) with mfA, φfn
  have ce : compose(φ, Algebra.map(A), Ring.carrier(Algebra.base(A)), Ring.carrier(Algebra.ring(A)), Ring.carrier(Algebra.ring(B))) = Algebra.map(B)
    apply FunctionBetween.ext with cf, mfB
    intros c hc
    rw (compose.apply at φ, Algebra.map(A), Ring.carrier(Algebra.base(A)), Ring.carrier(Algebra.ring(A)), Ring.carrier(Algebra.ring(B)), c with mfA, φfn, hc)
    exact AlgebraHom.map_base at φ, A, B, c with hom, hc
  rw ce at pc
  unfold polyAeval
  rw ← bEq
  exact pc

-- Helper: the terms of the value of p at x in A form a function on ℕ.
theorem rmEUni.aeval_terms (x p : Set)
  requires point : x ∈ algebraCarrier(A)
  requires member : p ∈ Ring.carrier(polynomialRing(Algebra.base(A), {0}))
  shows (aevalTerms(A, x, p) : ℕ → algebraCarrier(A)) ∧ (∀ i ∈ ℕ, aevalTerms(A, x, p)(i) = call2(Ring.mul(Algebra.ring(A)), Algebra.map(A)(p({(0, i)})), Ring.pow(Algebra.ring(A), x, i)))
proof
  have cR := Algebra.base_comm_ring at A with algebra
  have cS := Algebra.comm_ring at A with algebra
  have fh := Algebra.structure_hom at A with algebra
  have polys := polynomialRing.comm_ring at Algebra.base(A), {0} with cR
  have xS : x ∈ Ring.carrier(Algebra.ring(A))
    unfold algebraCarrier at point
    exact point
  have fn : aevalTerms(A, x, p) : ℕ → algebraCarrier(A)
    unfold FunctionBetween
    refine ⟨?_, ?_, ?_⟩
    . unfold RelationBetween
      intros q hq
      exact (aevalTerms.membership.forward at A, x, p, q with hq).left
    . unfold Functional
      intros y z hyz w hyw
      unfold relates at hyz
      unfold relates at hyw
      obtain ⟨_, a, aIn, e1⟩ := aevalTerms.membership.forward at A, x, p, (y, z) with hyz
      obtain ⟨_, c, cIn, e2⟩ := aevalTerms.membership.forward at A, x, p, (y, w) with hyw
      obtain ⟨x1, y1⟩ := orderedPair.injective with e1
      obtain ⟨x2, z2⟩ := orderedPair.injective with e2
      have ac : a = c
        rw [← x1, ← x2]
      rw [y1, z2, ac]
    . intros i iIn
      have iNat := nat.omega.backward with iIn
      have cIn := uni.coeff_mem at Algebra.base(A), p, i with cR, member
      unfold polyCoeff at cIn
      have out0 : call2(Ring.mul(Algebra.ring(A)), Algebra.map(A)(p({(0, i)})), Ring.pow(Algebra.ring(A), x, i)) ∈ Ring.carrier(Algebra.ring(A)) by typecheck
      have out : call2(Ring.mul(Algebra.ring(A)), Algebra.map(A)(p({(0, i)})), Ring.pow(Algebra.ring(A), x, i)) ∈ algebraCarrier(A)
        unfold algebraCarrier
        exact out0
      have pq := product.pair at i, call2(Ring.mul(Algebra.ring(A)), Algebra.map(A)(p({(0, i)})), Ring.pow(Algebra.ring(A), x, i)), ℕ, algebraCarrier(A) with iIn, out
      have m := aevalTerms.membership.backward at A, x, p, (i, call2(Ring.mul(Algebra.ring(A)), Algebra.map(A)(p({(0, i)})), Ring.pow(Algebra.ring(A), x, i))) with ⟨pq, i, iIn, rfl⟩
      witness call2(Ring.mul(Algebra.ring(A)), Algebra.map(A)(p({(0, i)})), Ring.pow(Algebra.ring(A), x, i))
      unfold relates
      exact ⟨out, m⟩
  have val : ∀ i ∈ ℕ, aevalTerms(A, x, p)(i) = call2(Ring.mul(Algebra.ring(A)), Algebra.map(A)(p({(0, i)})), Ring.pow(Algebra.ring(A), x, i))
    intros i iIn
    have iNat := nat.omega.backward with iIn
    have cIn := uni.coeff_mem at Algebra.base(A), p, i with cR, member
    unfold polyCoeff at cIn
    have out0 : call2(Ring.mul(Algebra.ring(A)), Algebra.map(A)(p({(0, i)})), Ring.pow(Algebra.ring(A), x, i)) ∈ Ring.carrier(Algebra.ring(A)) by typecheck
    have out : call2(Ring.mul(Algebra.ring(A)), Algebra.map(A)(p({(0, i)})), Ring.pow(Algebra.ring(A), x, i)) ∈ algebraCarrier(A)
      unfold algebraCarrier
      exact out0
    have pq := product.pair at i, call2(Ring.mul(Algebra.ring(A)), Algebra.map(A)(p({(0, i)})), Ring.pow(Algebra.ring(A), x, i)), ℕ, algebraCarrier(A) with iIn, out
    have m := aevalTerms.membership.backward at A, x, p, (i, call2(Ring.mul(Algebra.ring(A)), Algebra.map(A)(p({(0, i)})), Ring.pow(Algebra.ring(A), x, i))) with ⟨pq, i, iIn, rfl⟩
    have rel : relates(aevalTerms(A, x, p), i, call2(Ring.mul(Algebra.ring(A)), Algebra.map(A)(p({(0, i)})), Ring.pow(Algebra.ring(A), x, i)))
      unfold relates
      exact m
    exact FunctionBetween.apply_value with fn, iIn, rel
  exact ⟨fn, val⟩

-- Polynomial.aeval_eq_sum_range: aeval x p = Σ_{i ≤ natDegree p} pᵢ xⁱ.
theorem polyAeval.as_sum (x p : Set)
  requires point : x ∈ algebraCarrier(A)
  requires member : p ∈ Ring.carrier(polynomialRing(Algebra.base(A), {0}))
  shows polyAeval(A, x, p) = finiteRingSum(succ(polyNatDegree(Algebra.base(A), p)),
    algebraCarrier(A), Ring.add(Algebra.ring(A)), Ring.zero(Algebra.ring(A)),
    Ring.neg(Algebra.ring(A)), Ring.mul(Algebra.ring(A)), Ring.one(Algebra.ring(A)),
    restrict(aevalTerms(A, x, p), succ(polyNatDegree(Algebra.base(A), p))))
proof
  have cR := Algebra.base_comm_ring at A with algebra
  have cS := Algebra.comm_ring at A with algebra
  have fh := Algebra.structure_hom at A with algebra
  have polys := polynomialRing.comm_ring at Algebra.base(A), {0} with cR
  have xS : x ∈ Ring.carrier(Algebra.ring(A))
    unfold algebraCarrier at point
    exact point
  have h := polyEval2.hom at Algebra.base(A), Algebra.ring(A), Algebra.map(A), x with cR, polys, cS, fh, xS
  have hp := RingHom.parts with h
  have sP := CommRing.parts with polys
  have sS := CommRing.parts with cS
  have expand := polynomial.as_sum at Algebra.base(A), p with cR, polys, member
  obtain ⟨fn, val⟩ := rmEUni.terms_function at Algebra.base(A), p with cR, polys, member
  obtain ⟨afn, aval⟩ := rmEUni.aeval_terms at A, x, p with algebra, point, member
  have afn2 : aevalTerms(A, x, p) : ℕ → Ring.carrier(Algebra.ring(A))
    unfold algebraCarrier at afn
    exact afn
  have subS : succ(polyNatDegree(Algebra.base(A), p)) ⊆ ℕ
    intros y hy
    have yNat := natural.member at succ(polyNatDegree(Algebra.base(A), p)) with hy
    exact nat.omega.forward with yNat
  have rf := restrict.domain_function at polyMonomialTerms(Algebra.base(A), p), ℕ, Ring.carrier(polynomialRing(Algebra.base(A), {0})), succ(polyNatDegree(Algebra.base(A), p)) with fn, subS
  have rv := restrict.domain_function at aevalTerms(A, x, p), ℕ, Ring.carrier(Algebra.ring(A)), succ(polyNatDegree(Algebra.base(A), p)) with afn2, subS
  have fin := Finite.natural at succ(polyNatDegree(Algebra.base(A), p))
  have entries : ∀ i ∈ succ(polyNatDegree(Algebra.base(A), p)), restrict(aevalTerms(A, x, p), succ(polyNatDegree(Algebra.base(A), p)))(i) = evaluationHom(Algebra.base(A), Algebra.ring(A), {0}, Algebra.map(A), constantFunction({0}, Ring.carrier(Algebra.ring(A)), x))(restrict(polyMonomialTerms(Algebra.base(A), p), succ(polyNatDegree(Algebra.base(A), p)))(i))
    intros i iS
    have iN := subS with iS
    have iNat := nat.omega.backward with iN
    rw [(restrict.domain_apply at aevalTerms(A, x, p), ℕ, Ring.carrier(Algebra.ring(A)), succ(polyNatDegree(Algebra.base(A), p)), i with afn2, subS, iS), (restrict.domain_apply at polyMonomialTerms(Algebra.base(A), p), ℕ, Ring.carrier(polynomialRing(Algebra.base(A), {0})), succ(polyNatDegree(Algebra.base(A), p)), i with fn, subS, iS), (aval with i, iN), (val with i, iN)]
    have cIn := uni.coeff_mem at Algebra.base(A), p, i with cR, member
    unfold polyCoeff at cIn
    have cP := polyC.mem at Algebra.base(A), p({(0, i)}) with cR, polys, cIn
    have xP := polyX.mem at Algebra.base(A) with cR, polys
    have xpP : Ring.pow(polynomialRing(Algebra.base(A), {0}), polyX(Algebra.base(A)), i) ∈ Ring.carrier(polynomialRing(Algebra.base(A), {0})) by typecheck
    unfold polyMonomial
    rw (RingHom.map_mul at evaluationHom(Algebra.base(A), Algebra.ring(A), {0}, Algebra.map(A), constantFunction({0}, Ring.carrier(Algebra.ring(A)), x)), polynomialRing(Algebra.base(A), {0}), Algebra.ring(A), polyC(Algebra.base(A), p({(0, i)})), Ring.pow(polynomialRing(Algebra.base(A), {0}), polyX(Algebra.base(A)), i) with h, cP, xpP)
    have ec := polyEval2.C at Algebra.base(A), Algebra.ring(A), Algebra.map(A), x, p({(0, i)}) with cR, polys, cS, fh, xS, cIn
    unfold polyEval2 at ec
    rw ec
    rw (RingHom.map_pow at polynomialRing(Algebra.base(A), {0}), Algebra.ring(A), evaluationHom(Algebra.base(A), Algebra.ring(A), {0}, Algebra.map(A), constantFunction({0}, Ring.carrier(Algebra.ring(A)), x)), polyX(Algebra.base(A)), i with polys, cS, h)
    have ex := polyEval2.X at Algebra.base(A), Algebra.ring(A), Algebra.map(A), x with cR, polys, cS, fh, xS
    unfold polyEval2 at ex
    rw ex
  have m := finiteRingSum.map at Ring.carrier(polynomialRing(Algebra.base(A), {0})), Ring.add(polynomialRing(Algebra.base(A), {0})), Ring.zero(polynomialRing(Algebra.base(A), {0})), Ring.neg(polynomialRing(Algebra.base(A), {0})), Ring.mul(polynomialRing(Algebra.base(A), {0})), Ring.one(polynomialRing(Algebra.base(A), {0})), Ring.carrier(Algebra.ring(A)), Ring.add(Algebra.ring(A)), Ring.zero(Algebra.ring(A)), Ring.neg(Algebra.ring(A)), Ring.mul(Algebra.ring(A)), Ring.one(Algebra.ring(A)), evaluationHom(Algebra.base(A), Algebra.ring(A), {0}, Algebra.map(A), constantFunction({0}, Ring.carrier(Algebra.ring(A)), x)), succ(polyNatDegree(Algebra.base(A), p)), restrict(polyMonomialTerms(Algebra.base(A), p), succ(polyNatDegree(Algebra.base(A), p))), restrict(aevalTerms(A, x, p), succ(polyNatDegree(Algebra.base(A), p))) with sP, sS, hp, fin, rf, rv, entries
  have pe : polyAeval(A, x, p) = polyAeval(A, x, finiteRingSum(succ(polyNatDegree(Algebra.base(A), p)), Ring.carrier(polynomialRing(Algebra.base(A), {0})), Ring.add(polynomialRing(Algebra.base(A), {0})), Ring.zero(polynomialRing(Algebra.base(A), {0})), Ring.neg(polynomialRing(Algebra.base(A), {0})), Ring.mul(polynomialRing(Algebra.base(A), {0})), Ring.one(polynomialRing(Algebra.base(A), {0})), restrict(polyMonomialTerms(Algebra.base(A), p), succ(polyNatDegree(Algebra.base(A), p)))))
    cc [expand]
  rw pe
  unfold polyAeval
  unfold polyEval2
  unfold algebraCarrier
  exact m

-- Polynomial.aeval_algebraMap_apply: evaluating at the image of a ∈ R is
-- the image of p(a).
theorem polyAeval.algebra_map (a p : Set)
  requires scalar : a ∈ Ring.carrier(Algebra.base(A))
  requires member : p ∈ Ring.carrier(polynomialRing(Algebra.base(A), {0}))
  shows polyAeval(A, Algebra.map(A)(a), p) = Algebra.map(A)(polyEval(Algebra.base(A), p, a))
proof
  have base := Algebra.base_comm_ring at A with algebra
  have polysK := polynomialRing.comm_ring at Algebra.base(A), {0} with base
  have ringA := Algebra.comm_ring at A with algebra
  have sh := Algebra.structure_hom at A with algebra
  have idh := RingHom.id at Algebra.base(A) with base
  have ma := Algebra.map_mem at A, a with algebra, scalar
  have pc := polyEval2.compose at Algebra.base(A), Algebra.base(A), Algebra.ring(A), identity(Ring.carrier(Algebra.base(A))), Algebra.map(A), a, p with base, polysK, base, ringA, idh, sh, scalar, member
  have mf := Algebra.map_function at A with algebra
  unfold algebraCarrier at mf
  have idf := identity.function at Ring.carrier(Algebra.base(A))
  have cf := compose.function at Algebra.map(A), identity(Ring.carrier(Algebra.base(A))), Ring.carrier(Algebra.base(A)), Ring.carrier(Algebra.base(A)), Ring.carrier(Algebra.ring(A)) with idf, mf
  have ce : compose(Algebra.map(A), identity(Ring.carrier(Algebra.base(A))), Ring.carrier(Algebra.base(A)), Ring.carrier(Algebra.base(A)), Ring.carrier(Algebra.ring(A))) = Algebra.map(A)
    apply FunctionBetween.ext with cf, mf
    intros b hb
    rw (compose.apply at Algebra.map(A), identity(Ring.carrier(Algebra.base(A))), Ring.carrier(Algebra.base(A)), Ring.carrier(Algebra.base(A)), Ring.carrier(Algebra.ring(A)), b with idf, mf, hb)
    rw (identity.apply at b, Ring.carrier(Algebra.base(A)) with hb)
  rw ce at pc
  have va := constantFunction.function at {0}, Ring.carrier(Algebra.base(A)), a with *
  have ee := evaluationAt.eq_evaluationHom at Algebra.base(A), {0}, constantFunction({0}, Ring.carrier(Algebra.base(A)), a) with base, va
  unfold polyEval2 at pc
  rw ← ee at pc
  unfold polyAeval
  unfold polyEval
  unfold polyEval2
  rw ← pc

-- Polynomial.aeval_comp.
theorem polyAeval.comp (x p q : Set)
  requires point : x ∈ algebraCarrier(A)
  requires first : p ∈ Ring.carrier(polynomialRing(Algebra.base(A), {0}))
  requires second : q ∈ Ring.carrier(polynomialRing(Algebra.base(A), {0}))
  shows polyAeval(A, x, polyComp(Algebra.base(A), p, q)) =
    polyAeval(A, polyAeval(A, x, q), p)
proof
  have base := Algebra.base_comm_ring at A with algebra
  have polysK := polynomialRing.comm_ring at Algebra.base(A), {0} with base
  have ringA := Algebra.comm_ring at A with algebra
  have sh := Algebra.structure_hom at A with algebra
  have ch := polyC.hom at Algebra.base(A) with base, polysK
  have pt := point
  unfold algebraCarrier at pt
  have eh := polyEval2.hom at Algebra.base(A), Algebra.ring(A), Algebra.map(A), x with base, polysK, ringA, sh, pt
  have pc := polyEval2.compose at Algebra.base(A), polynomialRing(Algebra.base(A), {0}), Algebra.ring(A), polynomialConstant(Algebra.base(A), {0}), evaluationHom(Algebra.base(A), Algebra.ring(A), {0}, Algebra.map(A), constantFunction({0}, Ring.carrier(Algebra.ring(A)), x)), q, p with base, polysK, polysK, ringA, ch, eh, second, first
  have c0 := ch
  obtain ⟨_, _, cfn, _⟩ := c0
  have e0 := eh
  obtain ⟨_, _, efn, _⟩ := e0
  have mf := Algebra.map_function at A with algebra
  unfold algebraCarrier at mf
  have cf := compose.function at evaluationHom(Algebra.base(A), Algebra.ring(A), {0}, Algebra.map(A), constantFunction({0}, Ring.carrier(Algebra.ring(A)), x)), polynomialConstant(Algebra.base(A), {0}), Ring.carrier(Algebra.base(A)), Ring.carrier(polynomialRing(Algebra.base(A), {0})), Ring.carrier(Algebra.ring(A)) with cfn, efn
  have ce : compose(evaluationHom(Algebra.base(A), Algebra.ring(A), {0}, Algebra.map(A), constantFunction({0}, Ring.carrier(Algebra.ring(A)), x)), polynomialConstant(Algebra.base(A), {0}), Ring.carrier(Algebra.base(A)), Ring.carrier(polynomialRing(Algebra.base(A), {0})), Ring.carrier(Algebra.ring(A))) = Algebra.map(A)
    apply FunctionBetween.ext with cf, mf
    intros b hb
    rw (compose.apply at evaluationHom(Algebra.base(A), Algebra.ring(A), {0}, Algebra.map(A), constantFunction({0}, Ring.carrier(Algebra.ring(A)), x)), polynomialConstant(Algebra.base(A), {0}), Ring.carrier(Algebra.base(A)), Ring.carrier(polynomialRing(Algebra.base(A), {0})), Ring.carrier(Algebra.ring(A)), b with cfn, efn, hb)
    have c := polyEval2.C at Algebra.base(A), Algebra.ring(A), Algebra.map(A), x, b with base, polysK, ringA, sh, pt, hb
    unfold polyEval2 at c
    unfold polyC at c
    exact c
  rw ce at pc
  unfold polyAeval
  unfold polyComp
  unfold polyEval2
  unfold polyEval2 at pc
  exact pc

-- The roots of p in A are the a with X − a dividing the image of p in A[X]
-- (Polynomial.mem_aroots, Polynomial.mem_rootSet).
theorem polyAlgebraRootSet.mem_iff (p a : Set)
  requires member : p ∈ Ring.carrier(polynomialRing(Algebra.base(A), {0}))
  requires point : a ∈ algebraCarrier(A)
  shows a ∈ polyAlgebraRootSet(A, p) ↔
    PolyIsRoot(Algebra.ring(A), polyMap(Algebra.base(A), Algebra.ring(A),
      Algebra.map(A))(p), a)
proof
  have base := Algebra.base_comm_ring at A with algebra
  have polysK := polynomialRing.comm_ring at Algebra.base(A), {0} with base
  have ringA := Algebra.comm_ring at A with algebra
  have sh := Algebra.structure_hom at A with algebra
  have pt := point
  unfold algebraCarrier at pt
  have em := polyEval2.eq_eval_map at Algebra.base(A), Algebra.ring(A), Algebra.map(A), a, p with base, polysK, ringA, sh, pt, member
  constructor
  . intro h
    unfold polyAlgebraRootSet at h
    obtain ⟨_, ev⟩ := h
    unfold polyAeval at ev
    rw em at ev
    unfold PolyIsRoot
    exact ⟨pt, ev⟩
  . intro h
    obtain ⟨_, ev⟩ := h
    unfold polyAlgebraRootSet
    refine ⟨point, ?_⟩
    unfold polyAeval
    rw em
    exact ev

end AlgebraEvaluation
